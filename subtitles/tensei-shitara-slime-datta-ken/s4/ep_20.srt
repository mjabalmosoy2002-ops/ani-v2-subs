1
00:00:10,030 --> 00:00:11,150
...هذا

2
00:00:14,680 --> 00:00:16,480
!افعلها أيضاً يا أبي

3
00:00:16,480 --> 00:00:18,490
هل هذه... أنا؟

4
00:00:19,290 --> 00:00:22,050
كان عمله مُزدهراً آنذاك

5
00:00:24,810 --> 00:00:26,230
تذكّرتُ الآن

6
00:00:27,050 --> 00:00:31,780
،عندما كنتُ صغيرة بهذا السنّ
كان أبي يلعب معي

7
00:00:36,500 --> 00:00:37,910
كنتُ قد نسيت

8
00:00:42,960 --> 00:00:45,750
لم أعلم كم كان يُعاني

9
00:00:46,600 --> 00:00:50,110
آنذاك، لم أكن أستطيع حتّى
تخيُّل حجم المُعاناة

10
00:00:52,960 --> 00:00:57,350
،كنتُ مُقتنعة بأنّه لو كان أبي شخصاً صالحاً

11
00:00:58,490 --> 00:01:00,090
ما كانت أمِّي لتغضب

12
00:01:02,150 --> 00:01:05,170
لذا كرهتُه وضمرتُ ضغينة تجاهه

13
00:01:05,730 --> 00:01:09,080
حاولتُ التّظاهر بأنّ حقيقتنا البائسة
ليست موجودة

14
00:01:10,590 --> 00:01:13,320
...ولتبرير طريقة التّفكير تلك

15
00:01:18,020 --> 00:01:19,960
أدنتُه

16
00:01:21,810 --> 00:01:24,520
،رُبّما لو كنّا قد ساندنا بعضنا الآخر

17
00:01:24,520 --> 00:01:27,860
لعاشت عائلتُنا بطريقة مُختلفة

18
00:01:32,300 --> 00:01:36,710
.ولكنتُ أنشر الموعِظة عن العدالة
كم هذا مُثير للسّخرية

19
00:01:39,180 --> 00:01:45,270
رُبّما... كنتُ أحاول إسقاط رؤيتي
عن الأب المثاليّ عليه

20
00:01:46,000 --> 00:01:49,650
يقطن ظلامٌ في قلبكِ، أليس كذلك؟

21
00:01:50,080 --> 00:01:52,260
كان غرانفيلي على حقّ

22
00:01:53,990 --> 00:01:58,080
اعتبرتُ نفسي شخصاً لا يُغتفَر

23
00:01:58,780 --> 00:02:01,290
،وبأنّه حتّى لو عدتُ إلى عالمي القديم

24
00:02:01,290 --> 00:02:03,190
لن يكون أحدٌ سعيداً برؤيتي

25
00:02:05,020 --> 00:02:09,790
لهذا السّبب أردتُ أن أكون مُفيدة
لشخص في هذا العالم

26
00:02:10,490 --> 00:02:13,610
أردتُ إنقاذ أكبر قدر مُمكن من النّاس

27
00:02:15,900 --> 00:02:16,810
...لكن

28
00:02:17,930 --> 00:02:20,090
أنا مُرهَقة للغاية

29
00:02:22,540 --> 00:02:24,470
!أختي الكُبرى هيناتا

30
00:02:24,470 --> 00:02:27,910
!أختي الكُبرى هيناتا! لا تنامي

31
00:02:29,360 --> 00:02:31,690
هل كانت تلك... كلوي؟

32
00:02:31,690 --> 00:02:33,230
وأين أنا؟

33
00:02:34,180 --> 00:02:37,170
صحيح. كان غرانفيلي

34
00:02:37,860 --> 00:02:39,340
لستُ ميّتة؟

35
00:02:40,410 --> 00:02:42,370
كلوي، هل أنتِ بخير؟

36
00:02:42,880 --> 00:02:44,180
ماذا عن لوميناس-ساما؟

37
00:02:44,180 --> 00:02:45,950
وماذا حدث لغرانفيلي؟

38
00:02:46,330 --> 00:02:48,110
سأشرح كُلّ شيء

39
00:02:48,110 --> 00:02:50,410
فقط استمرّي في الحِفاظ على وعيكِ

40
00:02:50,410 --> 00:02:53,940
وأيضاً، أريدكِ أن تتزامني معي

41
00:02:53,940 --> 00:02:54,960
أتزامن؟

42
00:02:55,400 --> 00:03:00,360
أجل. أنتِ بداخلي الآن

43
00:03:00,360 --> 00:03:01,290
ماذا؟

44
00:03:01,290 --> 00:03:03,180
يمكنكِ رؤية ضوء، أليس كذلك؟

45
00:03:03,180 --> 00:03:04,660
...ضوء

46
00:03:04,660 --> 00:03:06,830
!أجل. صِلي إليه

47
00:03:14,570 --> 00:03:15,840
هل استيقظتِ الآن؟

48
00:03:16,450 --> 00:03:17,350
...أجل

49
00:03:18,010 --> 00:03:23,200
لكن يُراودني شعور غريب... وكأنّني
لستُ بجسدي

50
00:03:23,200 --> 00:03:25,200
ليس "وكأنّكِ" لستِ بجسدكِ

51
00:03:25,200 --> 00:03:31,210
أنتِ بداخل مهارتي، السّجن غير المحدود

52
00:03:31,210 --> 00:03:32,260
ماذا؟

53
00:03:32,260 --> 00:03:37,300
لو نمتِ، لكنتِ قد اختفيتِ للأبد

54
00:03:37,300 --> 00:03:40,040
لستُ أفهم تماماً

55
00:03:40,040 --> 00:03:42,720
لكن على أيّ حال، أنقذتِني، صحيح؟

56
00:03:42,980 --> 00:03:47,230
...لم أنقذكِ بالمعنى الحرفيّ
لكن شيء من هذا القبيل

57
00:03:47,230 --> 00:03:50,110
وأين نحن الآن؟

58
00:03:50,110 --> 00:03:53,590
حسناً يا أختي الكُبرى هيناتا، أنتِ وأنا

59
00:03:53,590 --> 00:03:55,040
ناديني هيناتا فحسب

60
00:03:55,040 --> 00:03:56,950
حسناً، سأفعل

61
00:03:56,950 --> 00:04:00,910
إذاً يا هيناتا... ابقي هادئة وأصغي
فحسب، اتّفقنا؟

62
00:04:01,860 --> 00:04:04,330
هذا قبل ألفَي عام

63
00:04:04,330 --> 00:04:05,210
ماذا؟

64
00:04:05,210 --> 00:04:07,740
انظري. أترين ذلك الجبل؟

65
00:04:07,740 --> 00:04:08,710
...أجل

66
00:04:09,310 --> 00:04:13,620
لحظة، أليست هذه هي القمّة
المُقدّسة لجبال ريولا؟

67
00:04:13,620 --> 00:04:14,960
...إذاً هذا

68
00:04:14,960 --> 00:04:20,050
أجل. إنّها حيث ستكون عاصمة
لوبيليوس يوماً ما

69
00:04:22,820 --> 00:04:26,430
كيف لكِ أن تكوني مُتيقّنة بأنّ هذا
قبل 2000 عام في الماضي؟

70
00:04:27,210 --> 00:04:31,470
لأنّها ليست المرّة الأولى الّتي
أتواجد فيها هنا

71
00:04:32,720 --> 00:04:35,330
ستشرحين هذا بتفصيل أكبر، صحيح؟

72
00:04:38,400 --> 00:04:40,530
أجل، بالطّبع

73
00:04:47,260 --> 00:04:48,850
يمكنكِ العودة إلى الماضي

74
00:04:49,320 --> 00:04:50,180
أجل

75
00:04:50,180 --> 00:04:56,290
يبدو أنّه عندما تتفعّل مهارة السّفر عبر
الزّمن خاصّتي، أستطيع العودة إلى الماضي

76
00:04:56,290 --> 00:04:57,620
يبدو"؟"

77
00:04:57,620 --> 00:05:00,220
...الشّرح صعبٌ بعض الشّيء

78
00:05:00,220 --> 00:05:02,850
،لكن عندما يُحفّز شيءٌ المهارةَ للتّفعيل

79
00:05:02,850 --> 00:05:06,560
فإنّني أستطيع السّفر عبر الزّمن إلى الماضي

80
00:05:06,560 --> 00:05:09,870
متى اكتسبتِ مهارةً كهذه؟

81
00:05:10,430 --> 00:05:15,670
في الواقع... كان ذلك عندما أخذَنا ريمورو
إلى مسكن الأرواح

82
00:05:15,980 --> 00:05:21,920
ما دخلَ جسدي هناك كان سُلطة
ذاتي المُستقبليّة

83
00:05:22,430 --> 00:05:26,660
،كُلّما متُّ في المُستقبل، يعود إلى داخلي

84
00:05:26,660 --> 00:05:29,180
وكانت تلك الدّورة تتكرّر طوال هذا الوقت

85
00:05:30,860 --> 00:05:33,890
إذاً... مررتِ بنفس التّجربة مراراً وتكراراً؟

86
00:05:34,300 --> 00:05:37,650
أجل. هذا ما تفعله المهارة على ما يبدو

87
00:05:38,010 --> 00:05:42,710
لكن لا أتذكّر أبداً تقريباً اللّحظة
،الّتي عدتُ فيها إلى الماضي

88
00:05:43,240 --> 00:05:47,660
والحلقة الزّمنيّة الوحيدة الّتي أتذكّرها
بالتّفصيل هي الأخيرة

89
00:05:48,580 --> 00:05:49,650
...هكذا إذاً

90
00:05:50,240 --> 00:05:53,980
،إذا تذكّرتْ كافّة الذّكريات الّتي كانت تُكرّرها

91
00:05:53,980 --> 00:05:56,220
فستكون الحياة جحيميّة

92
00:05:57,500 --> 00:06:01,800
لكن لم أرجع إلى ما قبل ذلك أبداً

93
00:06:01,800 --> 00:06:05,610
هذه النّقطة في الماضي قد تكون
حدود المهارة

94
00:06:06,140 --> 00:06:09,600
قلتِ بأنّ ذلك يحدث عندما يُحفّز شيءٌ المهارة

95
00:06:09,920 --> 00:06:11,430
ما هو الحافز؟

96
00:06:13,930 --> 00:06:19,490
في الواقع... إنّها تتفعّل كُلّما مُتِّ

97
00:06:20,460 --> 00:06:24,400
فهمت. إذاً أنا ميّتة بالفعل

98
00:06:26,120 --> 00:06:28,260
،أنتِ لا تتذكّرين ذلك

99
00:06:28,260 --> 00:06:31,230
لكنّكِ عدتِ إلى الماضي عدّة مرّات

100
00:06:31,230 --> 00:06:34,620
وكنتُ أموت دوماً بنفس الطّريقة؟

101
00:06:36,100 --> 00:06:39,920
في الحلقة الزمنيّة الأخيرة، بعد
،عودتنا من مسكن الأرواح

102
00:06:39,920 --> 00:06:43,420
عاد ريمورو إلى تيمبيست مُباشرة

103
00:06:43,420 --> 00:06:46,540
يبدو أنّني لم ألتقِ بكِ فعليّاً في هذه المرّة

104
00:06:48,540 --> 00:06:52,640
لهذا تمكّن ريمورو من إنقاذ تيمبيست

105
00:06:52,640 --> 00:06:55,480
وإبراز قوّته للدُّول المُجاورة

106
00:06:56,720 --> 00:07:01,650
وسعى جاهداً بعد ذلك لبناء علاقة مع البشر

107
00:07:02,950 --> 00:07:06,460
الأطفال الآخرون وأنا انتقلنا
إلى مدرسة في تيمبيست

108
00:07:06,460 --> 00:07:09,950
ودرسنا مع الأطفال الوحوش

109
00:07:11,040 --> 00:07:12,450
...لكن

110
00:07:12,450 --> 00:07:17,090
،ظنَّ مجلسُ الغرب بأنّ ريمورو خطير

111
00:07:17,090 --> 00:07:20,210
لذا أرسلوا قوّات إلى تيمبيست للقضاء عليه

112
00:07:20,640 --> 00:07:22,960
...وهل كانت تلك القوّات

113
00:07:22,960 --> 00:07:25,970
أجل. القوّات الّتي قدتِها أنتِ

114
00:07:26,450 --> 00:07:28,710
كنتِ مُخيفة آنذاك

115
00:07:28,710 --> 00:07:30,050
هذا ما أعتقده

116
00:07:30,940 --> 00:07:33,720
،لكن تمكّنتُم من عقد اتّفاقيّة سلام

117
00:07:34,030 --> 00:07:37,350
وعندما أدركتِ بأنّ مملكة فالموث
،كانت تخدعكِ

118
00:07:37,840 --> 00:07:40,310
أصبحتِ وريمورو صديقين فوراً

119
00:07:41,110 --> 00:07:45,120
لذا ريمورو في الحلقة الزّمنيّة السّابقة
لم يُصبح سيّد شياطين أبداً

120
00:07:46,430 --> 00:07:50,920
لكن مع ذلك كان مشغولاً دوماً، قائلاً
بأنّه سيجعل تيمبيست بلداً عظيماً

121
00:07:52,830 --> 00:07:55,390
...ثمّ بعد خمس سنوات

122
00:07:59,820 --> 00:08:03,670
جيش الوحوش السّحريّة التّابع للإمبراطوريّة
الشّرقيّة شنَّ هجوماً

123
00:08:04,190 --> 00:08:08,520
قاتلَ الجميع ببسالة، لكن لم يتمكّنوا
من التصدّي للغزو

124
00:08:09,140 --> 00:08:13,840
كان الشّخص الوحيد الّذي بقي
للاعتماد عليه هو ريمورو

125
00:08:15,790 --> 00:08:18,810
وكان يعلم ذلك

126
00:08:19,920 --> 00:08:24,520
في تلك الفترة، كنتُ قد أحببتُ
ريمورو بالفعل

127
00:08:25,420 --> 00:08:26,270
...لذا

128
00:08:26,630 --> 00:08:30,440
توسّلتُ إليه بأنانيّة ألّا يذهب إلى القتال

129
00:08:31,930 --> 00:08:33,030
استرخي

130
00:08:33,640 --> 00:08:35,530
دعي هذا الأمر لي فحسب

131
00:08:39,290 --> 00:08:42,770
...في النّهاية، لم يعُد إلى الدّيار أبداً

132
00:08:43,950 --> 00:08:46,740
وسرعان ما سقطتْ تيمبيست

133
00:08:52,300 --> 00:08:53,630
...بالنّسبة لريمورو

134
00:09:00,820 --> 00:09:04,480
بعد ذلك، عاد فيلدورا فجأة

135
00:09:04,480 --> 00:09:06,860
ودمّرَ جيش الإمبراطوريّة الشّرقيّة

136
00:09:06,860 --> 00:09:10,570
،لكن حينها كان قد ثارَ وخرج عن السّيطرة
ولم يستطع أحدٌ إيقافه

137
00:09:11,420 --> 00:09:14,530
...بذلنا قصارى جهدنا لفعل ذلك، لكن

138
00:09:15,340 --> 00:09:18,540
في خضمّ كُلّ هذا، قتلَكِ أحدُهم

139
00:09:21,500 --> 00:09:24,960
ثمّ عدتُ إلى الماضي

140
00:09:28,850 --> 00:09:31,690
هذا يُلخّص ما حدث في الحلقة
الزمنيّة الماضية

141
00:09:31,690 --> 00:09:33,480
ريمورو مات؟

142
00:09:34,010 --> 00:09:36,310
لكن من قتله؟ وكيف؟

143
00:09:36,960 --> 00:09:39,810
كان يُقتَل في كُلّ مرّة

144
00:09:41,110 --> 00:09:43,410
لكن أتعلمين؟

145
00:09:43,410 --> 00:09:48,050
كانت هذه هي المرّة الأولى الّتي يبقى
فيها على قيد الحياة عندما تُقتَلين

146
00:09:49,760 --> 00:09:53,900
هذا مُذهل حقّاً... ومُميّز

147
00:09:54,810 --> 00:09:57,320
حدثت كثير من الأمور الجديدة في هذه
الحلقة الزمنيّة أيضاً

148
00:09:57,920 --> 00:10:02,200
مثلاً أن يصبح ريمورو سيّد شياطين
ومُصادقته لكم جميعاً

149
00:10:02,640 --> 00:10:05,680
...ارتأيتُ رُبّما، أقول رُبّما، بأن يتمكّن هذه المرّة

150
00:10:06,950 --> 00:10:10,040
صحيح، يبدو أنّه يستطيع فعل
شيء حيال الأمر

151
00:10:10,040 --> 00:10:11,340
!حقّاً؟

152
00:10:11,340 --> 00:10:14,820
!إذاً في هذه المرّة، سننجو جميعاً

153
00:10:14,820 --> 00:10:19,830
ويجب علينا اكتشاف من قتلكِ
!وريمورو في المُستقبل

154
00:10:19,830 --> 00:10:23,340
لكن لماذا هذا الزّمن مُختلف عن الأزمان الأُخرى؟

155
00:10:24,140 --> 00:10:25,270
...في الحقيقة

156
00:10:25,270 --> 00:10:31,280
في مسكن الأرواح، تذكّرتُ فقط بضعة
من ذكرياتي من المُستقبل

157
00:10:31,610 --> 00:10:38,360
لهذا السّبب أصبحتُ أنانيّة مع ريمورو في إنغراشيا
وحاولتُ منعه من المُغادرة

158
00:10:38,360 --> 00:10:40,910
ثمّ أعطاني هذا

159
00:10:41,980 --> 00:10:44,850
...هذا لشيزوي-سينسي

160
00:10:44,850 --> 00:10:46,760
أجل، صحيح

161
00:10:46,760 --> 00:10:50,590
إنّه أيضاً القِناع الّذي أعطيتُه لشيزو-سينسي

162
00:10:51,160 --> 00:10:53,320
كلوي أعطى هذا لشيزو-سينسي؟

163
00:10:54,330 --> 00:10:58,340
فهمت. إذاً كلوي كانت البطلة

164
00:10:58,340 --> 00:11:01,470
...سنرى ريمورو ثانية و

165
00:11:01,470 --> 00:11:02,330
أجل

166
00:11:02,330 --> 00:11:04,420
لن نفشل في تغيير المُستقبل

167
00:11:05,490 --> 00:11:08,950
وأيضاً... ثمّة شيء ينبغي أن أذكره

168
00:11:08,950 --> 00:11:10,980
ما هو؟

169
00:11:11,540 --> 00:11:16,320
أحبّكِ كثيراً... لكن لن أدعكِ
!تحصلين على ريمورو

170
00:11:16,320 --> 00:11:17,390
ماذا؟

171
00:11:17,390 --> 00:11:20,880
النّساء لديهن أشياء مُعيّنة لا يستطعن
!الاستسلام فيها

172
00:11:20,880 --> 00:11:22,750
!هذا ما قالته آليس

173
00:11:23,600 --> 00:11:25,430
لا تزال طفلة حقّاً

174
00:11:26,060 --> 00:11:29,500
أنا، أسرق ريمورو؟ لن يحدث هذا أبداً

175
00:11:29,500 --> 00:11:31,560
لكن ألم تكوني مُرتبِكة قبل لحظات؟

176
00:11:31,560 --> 00:11:33,000
!لم أكن كذلك

177
00:11:34,510 --> 00:11:37,910
على أيّ حال، يجدر بنا أن نبدأ حالاً

178
00:11:37,910 --> 00:11:38,760
أجل

179
00:11:46,970 --> 00:11:51,900
أعتقد بأنّ الدُّول الغربيّة في هذا العصر
ليست الأنسب للعيش بالنّسبة للبشر

180
00:11:51,900 --> 00:11:54,280
،أجل. هناك بضع مُستوطنات

181
00:11:54,280 --> 00:11:57,540
لكن لن تتوحّد معاً كدُول إلّا في وقت لاحق

182
00:11:57,540 --> 00:12:00,400
حسناً، إلى أين سنذهب؟

183
00:12:00,400 --> 00:12:02,240
إلى لوميناس

184
00:12:02,240 --> 00:12:05,180
لوميناس-ساما؟ لماذا؟

185
00:12:05,180 --> 00:12:07,000
،تقريباً في كُلّ مرّة أعود فيها إلى الماضي

186
00:12:07,000 --> 00:12:10,750
فيلدورا يُهاجم نايتروز فوراً

187
00:12:11,300 --> 00:12:16,380
لم أكن هناك في المرّة السّابقة، لكن في هذه
المرّة، آمل أن أصل إلى هناك بسرعة

188
00:12:16,380 --> 00:12:19,130
ماذا ستفعلين عندما ترين لوميناس-ساما؟

189
00:12:19,540 --> 00:12:23,640
أنوي إخراج الجميع من المدينة
قبل أن يبدأ فيلدورا بهيَجانه

190
00:12:23,640 --> 00:12:26,840
هل تعتقدين بأنّها ستصغي لكِ
بهذه البساطة فحسب؟

191
00:12:26,840 --> 00:12:29,560
ستكون الأمور بخير. لوميناس صديقتي

192
00:12:30,110 --> 00:12:31,820
ماذا؟ صديقتكِ؟

193
00:12:31,820 --> 00:12:32,760
أجل

194
00:12:32,760 --> 00:12:34,690
...هـ-هكذا إذاً

195
00:12:34,690 --> 00:12:36,690
لكن كيف ستُنقذينهم؟

196
00:12:36,690 --> 00:12:38,400
نحن نتكلّم عن فيلدورا هنا

197
00:12:38,400 --> 00:12:42,910
لا تقلقي! أنا البطلة الّتي ختمتْ
!على فيلدورا أيضاً

198
00:12:44,260 --> 00:12:45,410
...صحيح

199
00:12:45,410 --> 00:12:47,410
!انظري، يمكنك رؤيتها الآن

200
00:12:47,890 --> 00:12:49,160
!نايتروز

201
00:12:55,620 --> 00:12:56,790
توقّفي أيّتها البشريّة

202
00:12:57,370 --> 00:12:59,940
هل تعرفين من المسؤول عن هذا القطّاع؟

203
00:12:59,940 --> 00:13:01,000
!أجل

204
00:13:01,000 --> 00:13:02,730
!أتيتُ لرؤية لوميناس

205
00:13:03,730 --> 00:13:06,510
مهلاً! لا يجوز أن تستخدمي اسمها
!بهذه العفويّة هنا

206
00:13:06,510 --> 00:13:08,440
!ماذا قلتِ للتو؟

207
00:13:08,440 --> 00:13:11,430
فيلدورا سيُهاجم هذا المكان قريباً

208
00:13:11,430 --> 00:13:13,510
!لذا أرجوكما، دعاني أقابل لوميناس

209
00:13:13,510 --> 00:13:14,850
!قلتُ توقّفي

210
00:13:15,470 --> 00:13:18,110
على رسلكِ! ماذا تريدينني
أن أفعل إذاً؟

211
00:13:19,110 --> 00:13:23,450
التقيتِ بلوميناس-ساما كثيراً في ذاكرتكِ

212
00:13:23,450 --> 00:13:26,180
لدرجة أنّكِ لم تعودي تُوقّرينها

213
00:13:26,180 --> 00:13:28,160
حسناً. استمعي لي

214
00:13:29,530 --> 00:13:32,120
أجل. فهمت

215
00:13:33,880 --> 00:13:36,250
أعتذر من أعماق قلبي

216
00:13:36,250 --> 00:13:42,070
أتيتُ إلى هنا بعد أن تلقّيتُ نبأ بأنّ
،فيلدورا، تنّين الشّرّ

217
00:13:42,070 --> 00:13:43,630
سيُهاجم نايتروز قريباً

218
00:13:43,940 --> 00:13:47,860
أطلب منكما رجاء بأن تنقلا هذه
الرّسالة إلى لوميناس-ساما

219
00:13:47,860 --> 00:13:50,770
رأيتِ؟ يمكنكِ فعلها عندما تُحاولين

220
00:14:07,680 --> 00:14:11,970
هل صحيح بأنّ فيلدورا سيُهاجم
نايت روز قريباً؟

221
00:14:12,440 --> 00:14:14,140
ويجب أن أُصدِّقكِ؟

222
00:14:14,710 --> 00:14:17,930
،صدّقيني. أعلم بأنّكِ قويّة يا لوميناس

223
00:14:17,930 --> 00:14:20,030
لكن لا يمكنكِ هزيمة فيلدورا

224
00:14:20,940 --> 00:14:22,840
ستُدمَّر هذه القلعة أيضاً

225
00:14:22,840 --> 00:14:24,170
من فضلكم أخلوها بسرعة

226
00:14:25,630 --> 00:14:29,820
لا أعرفكِ بما يكفي لأُصدِّق كلامكِ

227
00:14:30,180 --> 00:14:32,470
ما أساس ادّعاءكِ؟

228
00:14:32,470 --> 00:14:35,080
متى سيُهاجم هذه البلاد؟

229
00:14:35,080 --> 00:14:36,750
بعد حوالي نصف شهر

230
00:14:36,750 --> 00:14:39,830
قبل نهاية الخريف، بكلّ تأكيد

231
00:14:41,000 --> 00:14:43,960
هكذا إذاً. سأقوم بالتّحضيرات

232
00:14:45,070 --> 00:14:46,460
...لكن

233
00:14:47,220 --> 00:14:50,220
...إن كنتِ تكذبين عليّ

234
00:14:50,970 --> 00:14:53,970
فتعرفين ما سيحدث، صحيح؟

235
00:14:56,970 --> 00:15:00,040
هل ستُصدّقينها؟

236
00:15:00,040 --> 00:15:01,970
أرى ذلك مُسلّياً

237
00:15:02,990 --> 00:15:05,400
،فقد نادَتْني باسمي فقط

238
00:15:05,400 --> 00:15:09,040
ثمّ تجرّأت على القول بأنّني
لا أستطيع هزيمة فيلدورا

239
00:15:09,040 --> 00:15:12,990
وحتّى أنّها زعمتْ بأنّ مدينتنا الجميلة
نايتروز ستُدمَّر

240
00:15:13,380 --> 00:15:16,490
أتلهّف لرؤية إلى أين سنصل بعد نصف شهر

241
00:15:17,550 --> 00:15:18,740
أخبرتُكِ

242
00:15:19,130 --> 00:15:21,500
،قد تعتبرينها صديقة

243
00:15:21,500 --> 00:15:25,420
،لكن بالنّسبة للوميناس-ساما
لا تزالين مُجرّد غريبة

244
00:15:25,860 --> 00:15:26,940
...لكن

245
00:15:26,940 --> 00:15:29,460
مع الأسف، كُلّ ما يمكننا فعله
الآن هو الانتظار

246
00:15:30,970 --> 00:15:35,130
رغم ذلك، أمامنا نصف شهر
قبل أن يأتي فيلدورا إلى هنا

247
00:15:35,130 --> 00:15:36,810
ماذا سنفعل ريثما يحين ذلك؟

248
00:15:36,810 --> 00:15:38,120
...في الواقع

249
00:15:38,120 --> 00:15:41,490
...لا أستطيع قطعاً الابتعاد من هنا

250
00:15:41,490 --> 00:15:45,630
!وجدتُها! سآخذكِ في جولة حول نايتروز

251
00:16:59,790 --> 00:17:00,900
!إنّه قادم

252
00:17:01,950 --> 00:17:03,120
!لوميناس-ساما

253
00:17:03,430 --> 00:17:05,050
!تراجعوا جميعاً

254
00:17:05,050 --> 00:17:07,860
!ستحمون شعبي وهذه المدينة

255
00:17:07,860 --> 00:17:08,590
!حاضر

256
00:17:20,510 --> 00:17:22,560
!تبّاً لك يا تنّين الشّرّ

257
00:17:27,630 --> 00:17:30,080
!سلِّيني أكثر

258
00:17:35,590 --> 00:17:37,970
!بسرعة! اذهبوا إلى خلف القلعة

259
00:17:37,970 --> 00:17:40,720
!هل من جرحى؟

260
00:17:51,090 --> 00:17:53,920
!كيف تجرؤ على تدمير مدينتي؟

261
00:17:54,650 --> 00:17:56,190
!يجب عليّ مُساعدتها

262
00:17:56,190 --> 00:17:57,080
!لا يمكنكِ

263
00:17:57,080 --> 00:17:58,310
!لِمَ لا؟

264
00:17:58,310 --> 00:18:02,130
لم تُقاتلي فيلدورا في هذه المرحلة
من الحلقة الزمنيّة السّابقة، صحيح؟

265
00:18:02,130 --> 00:18:07,160
أكثر ما يهمّ الآن هو الوصول إلى مُستقبل
حيث لا يزال ريمورو حيّاً، كما المرّة الماضية

266
00:18:07,160 --> 00:18:11,120
إن تدخّلتِ الآن، فقد يُغيّر هذا المُستقبل

267
00:18:11,120 --> 00:18:13,640
...لكن إن لم أفعل، لوميناس سوف

268
00:18:13,640 --> 00:18:14,750
ستكون بخير

269
00:18:14,750 --> 00:18:19,310
كانت حيّة تُرزَق في المُستقبل حيث
تعرفينها أنتِ وأنا، أليس كذلك؟

270
00:18:26,610 --> 00:18:28,250
أنت بخير الآن

271
00:18:30,020 --> 00:18:32,960
يمكنني على الأقلّ مُساعدة سكّان
المدينة، أليس كذلك؟

272
00:18:32,960 --> 00:18:36,170
أجل. لنُقلّص عدد الضّحايا قدر المُستطاع

273
00:18:38,910 --> 00:18:42,810
لذا... أنا آسفة يا لوميناس-ساما

274
00:18:43,790 --> 00:18:45,140
اصمدي رجاء

275
00:19:12,790 --> 00:19:13,860
...لوميناس

276
00:19:18,300 --> 00:19:19,690
أنا آسفة

277
00:19:20,470 --> 00:19:22,230
أعتذر كذلك

278
00:19:22,230 --> 00:19:24,450
كنتِ مُحقّة

279
00:19:32,170 --> 00:19:34,710
أنتِ مُنقذتنا

280
00:19:36,020 --> 00:19:37,210
...لكن

281
00:19:37,670 --> 00:19:39,710
لماذا أنتِ حزينةٌ جدّاً؟

282
00:19:40,150 --> 00:19:44,190
بفضلكِ، لا نزال جميعنا أحياء

283
00:19:44,800 --> 00:19:46,720
هيّا، ألقي نظرة

284
00:19:49,720 --> 00:19:51,870
!شكراً لكِ يا أختي

285
00:19:52,270 --> 00:19:56,400
شكراً لكِ

286
00:19:58,120 --> 00:20:01,900
بالمناسبة، لم تخبريني باسمكِ بعد

287
00:20:02,660 --> 00:20:05,040
هل تُمانعين إخباري؟

288
00:20:07,230 --> 00:20:12,310
!كلوي. اسمي كلوي يا لوميناس

289
00:20:15,780 --> 00:20:20,810
إذاً تقولين بأنّكِ عشتِ الوقت نفسه
مراراً وتكراراً؟

290
00:20:20,810 --> 00:20:25,640
أجل. تمتدّ ذكرياتي عبر 2000 عام تقريباً

291
00:20:25,640 --> 00:20:27,110
هل يمكنني أن أحدّثكِ عنها؟

292
00:20:27,110 --> 00:20:29,820
بالطّبع. أخبريني

293
00:20:30,890 --> 00:20:35,190
حقّاً؟ مدينة حيث يتعايش
البشر والوحوش؟

294
00:20:35,690 --> 00:20:39,400
وهي محكومة بواسطة هُلام؟

295
00:20:39,400 --> 00:20:42,910
يبدو ريمورو هذا شخصاً مُثيراً للاهتمام

296
00:20:42,910 --> 00:20:46,320
أجل. أنا متأكّدةٌ بأنّكِ وهو تستطيعان
أن تُصبحا صديقين

297
00:20:47,010 --> 00:20:51,400
وثمّة شخص آخر سيكون صديقكِ

298
00:20:51,400 --> 00:20:55,660
اسمها هيناتا، وسوف تأتي
إلى هنا من عالم آخر

299
00:20:55,660 --> 00:20:58,370
صديقة من عالم آخر؟

300
00:20:58,370 --> 00:21:00,000
يبدو هذا لطيفاً

301
00:21:00,000 --> 00:21:03,200
رُبّما لديّ سبب لأتطلّع بلهفة
لعَيش حياة مديدة

302
00:21:04,850 --> 00:21:06,610
أتقولين حرباً؟

303
00:21:06,610 --> 00:21:10,430
،أجل. لذا ستشنُّ الإمبراطوريّةُ الشّرقيّة هجوماً

304
00:21:10,430 --> 00:21:12,930
وسيموت ريمورو

305
00:21:13,270 --> 00:21:15,950
ستموت هيناتا في المعركة أيضاً

306
00:21:15,950 --> 00:21:18,560
ماذا؟ حتّى هيناتا؟

307
00:21:18,860 --> 00:21:20,920
...لكن من

308
00:21:20,920 --> 00:21:25,330
لا أعرف من يقتل ريمورو وهيناتا

309
00:21:25,330 --> 00:21:28,030
...لكن أريد

310
00:21:28,030 --> 00:21:30,530
تغيير المُستقبل، صحيح؟

311
00:21:30,530 --> 00:21:34,650
لا. أريد الحِفاظ على التّاريخ نفسه
كما هو، بشتّى الوسائل

312
00:21:34,650 --> 00:21:38,160
كان ريمورو لا يزال حيّاً في الحلقة
الزمنيّة الأخيرة

313
00:21:38,160 --> 00:21:40,370
لا أريد أن أُغيّر ذلك المُستقبل

314
00:21:41,130 --> 00:21:44,710
فهمت. أتعهّد بتقديم التّعاون

315
00:21:45,400 --> 00:21:49,970
لا أستطيع السّماح لصديقتي هيناتا
أن تموت، حتّى لو ترتّب عليّ اللّقاء بها

316
00:21:50,890 --> 00:21:52,330
...لوميناس-ساما

317
00:21:53,990 --> 00:21:55,150
شكراً لكِ

318
00:22:03,430 --> 00:22:05,870
إنّها فارغةٌ حقّاً

319
00:22:05,870 --> 00:22:08,840
...ليتني استطعتُ المُساعدة، لكن

320
00:22:08,840 --> 00:22:10,430
لا تقلقي

321
00:22:10,430 --> 00:22:14,030
الزّمن هو الشّيء الوحيد المُتاح لنا بغزارة

322
00:22:14,030 --> 00:22:19,710
ذات يوم، سأبني مدينةً عاصمةً هنا
تُوازي نايتروز بحدّ ذاتها

323
00:22:19,710 --> 00:22:22,340
أجل. لا أطيق الانتظار

324
00:22:26,340 --> 00:22:28,350
حان وقت الوداع حاليّاً

325
00:22:28,350 --> 00:22:30,180
ماذا ستفعلين من الآن فصاعداً؟

326
00:22:30,760 --> 00:22:35,560
ما أفعله دوماً: أن أكون بطلة
!وأُساعد المحتاجين

327
00:22:35,950 --> 00:22:38,410
هكذا إذاً. هذا مُثير للاهتمام

328
00:22:38,990 --> 00:22:44,560
يُراودني فضول لأرى إلى أين
سيقودكِ مصيركِ

329
00:22:44,560 --> 00:22:47,610
مع ذلك، ما الاسم الّذي ستعتمدينه؟

330
00:22:47,610 --> 00:22:50,000
،إن كنتِ تتقفّين أثر تاريخ المُستقبل

331
00:22:50,000 --> 00:22:52,800
"فأنتِ لا تريدين اسم "كلوي
في السجلّات، صحيح؟

332
00:22:53,560 --> 00:22:56,160
!يا للهول! لم يخطر هذا على ذهني

333
00:22:56,160 --> 00:22:59,100
"بالفعل لا نريد أن ينتشر اسم "كلوي

334
00:22:59,100 --> 00:23:02,410
أجل. إذا أتى أخي ليون إلى هذا العالم

335
00:23:02,410 --> 00:23:04,370
فسوف يكتشف حتماً

336
00:23:04,370 --> 00:23:06,570
ليون؟ تقصدين سيّد الشّياطين؟

337
00:23:07,340 --> 00:23:08,270
...لا

338
00:23:08,270 --> 00:23:10,550
لم يعُد هناك ما يُفاجئني

339
00:23:10,550 --> 00:23:13,420
على أيّ حال، ماذا تفعلين عادةً؟

340
00:23:13,420 --> 00:23:18,160
،في الواقع... في مُعظم الأوقات
لا أذكر اسمي أبداً

341
00:23:18,160 --> 00:23:22,530
لهذا السّبب بقي اسمُ البطل
مجهولاً في المُستقبل

342
00:23:23,870 --> 00:23:25,040
...لنرَ

343
00:23:25,880 --> 00:23:29,230
كرونوا. ما رأيكِ بكرونوا؟

344
00:23:30,170 --> 00:23:32,960
،إنّه مزيجٌ بين مهارتكِ الفريدة

345
00:23:32,960 --> 00:23:36,530
،السّفر عبر الزّمن، مع كرونوس
إله الزّمن

346
00:23:38,630 --> 00:23:40,010
...كرونوا

347
00:23:40,520 --> 00:23:42,900
!أجل! إنّه يروقني

348
00:23:43,330 --> 00:23:46,670
!ابتداء من اليوم، سأُعرَف بكرونوا البطلة

349
00:23:47,090 --> 00:23:48,740
كرونوا؟

350
00:23:49,260 --> 00:23:50,550
اسم جميل

351
00:23:51,360 --> 00:23:52,250
!أجل

352
00:23:55,050 --> 00:23:58,840
"الحلقة القادمة، "كرونوا البطلة، الجزء 2