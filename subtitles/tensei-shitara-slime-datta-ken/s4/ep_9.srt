1
00:00:12,570 --> 00:00:15,560
،إن واجهتُم أي إزعاج أثناء إقامتكم

2
00:00:15,560 --> 00:00:17,620
فلا تتردّدوا عن إبلاغنا رجاء

3
00:00:17,890 --> 00:00:19,490
شكراً لكِ

4
00:00:25,090 --> 00:00:29,760
كان هذا المكان قلعة سيّد
الشّياطين كلايمان، صحيح؟

5
00:00:29,760 --> 00:00:30,760
...أجل

6
00:00:30,760 --> 00:00:34,630
ريمورو-ساما، هل الأطلال داخل القلعة؟

7
00:00:34,630 --> 00:00:38,640
بالطّبع لا. هناك مدخلٌ في الجانب
الآخر من القلعة

8
00:00:39,050 --> 00:00:43,740
شُيِّدَتْ قلعة كلايمان على قمّة
أطلال أمريتا القديمة

9
00:00:46,420 --> 00:00:48,440
!يا لها من إطلالة

10
00:00:48,440 --> 00:00:50,440
!أليس هذا مُشوِّقاً يا ريمورو؟

11
00:00:50,440 --> 00:00:53,690
—انظري أمامكِ! وإلّا أذيتِ نفسـ

12
00:00:55,610 --> 00:00:57,200
...بئساً

13
00:00:59,700 --> 00:01:04,330
هذا هو المدخل إلى أطلال
العاصمة أمريتا تحت الارض

14
00:01:04,330 --> 00:01:06,130
!وصلنا إلى هنا أخيراً

15
00:01:06,130 --> 00:01:06,960
أجل

16
00:01:29,100 --> 00:01:31,360
!رائع

17
00:01:33,860 --> 00:01:37,150
هذه هي مدينة أمريتا القديمة إذاً؟

18
00:01:39,440 --> 00:01:42,790
صُمِّمَتْ أمريتا تيمُّناً بمدينة أُخرى

19
00:01:47,520 --> 00:01:49,650
دولة الشّعوذة العظيمة سوما

20
00:01:50,310 --> 00:01:56,630
دولة قديمة ازدهرتْ في السّابق
كجنّة الإيلفيّين

21
00:01:57,670 --> 00:01:58,750
...لكن حينها

22
00:02:00,310 --> 00:02:05,220
تصرُّفات خرقاء لحفنة منهم أثارتْ
،غضبَ الأميرة التنّينة

23
00:02:05,980 --> 00:02:08,700
وتحوّلت الجنّةُ إلى أنقاض
بين ليلةٍ وضُحاها

24
00:02:12,290 --> 00:02:16,290
الحمقى الّذين جلَبوا الدّمارَ
،لدولتهم قد لُعِنوا

25
00:02:16,290 --> 00:02:18,800
،ليُصبحوا الإيلف الظّلاميّين

26
00:02:18,800 --> 00:02:22,740
وغادروا هرباً من الأميرة التنّينة
بحثاً عن بلاد جديدة

27
00:02:23,540 --> 00:02:26,750
وكنتُ أنا قديماً من بينهم

28
00:02:27,420 --> 00:02:29,680
،في الأرض الجديدة الّتي هربنا إليها

29
00:02:29,680 --> 00:02:32,250
بنينا مدينةً عاصمة

30
00:02:32,690 --> 00:02:35,330
للحرص على ألّا تضيع التّكنولوجيا الإيلفيّة

31
00:02:35,330 --> 00:02:38,140
وأن تبقى مُستمرّة بشكلٍ محسوس

32
00:02:39,660 --> 00:02:41,760
...وحينئذ كانت ولادة

33
00:02:42,070 --> 00:02:45,800
،أمريتا، عاصمة دولة الدُّمى المُتحرِّكة جيستاف

34
00:02:46,410 --> 00:02:50,460
والشّكل الحقيقيّ للأطلال القديمة
المعروفة باسم أمريتا

35
00:04:25,490 --> 00:04:27,450
...لا تبدو لي أطلالاً

36
00:04:27,450 --> 00:04:29,370
بل أقرب إلى بلدة...

37
00:04:30,260 --> 00:04:32,840
لا أُصدّق بأنّ النّاس ما زالوا يعيشون هنا

38
00:04:32,840 --> 00:04:35,620
!أليس كذلك؟ لم أتخيّل هذا أبداً

39
00:04:35,620 --> 00:04:38,130
الجزء الدّاخليّ من الأطلال ينقسم
إلى ثلاثة طوابق

40
00:04:38,530 --> 00:04:43,880
نستخدم الطّابق الأعلى هنا
كحيّ سكنيّ لنا

41
00:04:43,880 --> 00:04:46,770
المعذرة... ظننتُ بأنّ هذه الأطلال
كانت تحت الأرض

42
00:04:46,770 --> 00:04:48,140
من أين ينبعث ذاك الضّوء؟

43
00:04:48,720 --> 00:04:50,480
إنّه نتاج سحر

44
00:04:51,520 --> 00:04:54,390
إنّه مُرتبط بحركات الشّمس

45
00:04:54,390 --> 00:04:59,120
مُبهر! السّحر القديم ما زال
!يُستخدَم كما كان من قبل؟

46
00:04:59,120 --> 00:05:01,150
!ذلك لوحده اكتشاف مُهمّ

47
00:05:03,140 --> 00:05:07,600
،ميليم، حالما ينتهي هذا التّحقيق
،سيكون هذا جزءاً من نطاقكِ

48
00:05:07,600 --> 00:05:11,660
لكن هل تُمانعين السّماح لهؤلاء
النّاس بالاستمرار في العيش هنا؟

49
00:05:13,600 --> 00:05:15,410
!حسناً، سأفعل

50
00:05:15,940 --> 00:05:19,170
شكراً لكِ يا سيّدة الشّياطين ميليم

51
00:05:19,170 --> 00:05:23,200
العفو! أنتم رعايا لي في نهاية المطاف

52
00:05:23,200 --> 00:05:26,680
،ما دمتُم تؤدّون دوركم جميعاً
!فكلّ شيء على ما يُرام

53
00:05:30,480 --> 00:05:33,680
هذا هو الباب المُؤدّي إلى الطّابق الأوسط

54
00:05:39,340 --> 00:05:42,320
هل أُجريَت التّحقيقات فيما بعد
الطّابق الأوسط؟

55
00:05:42,320 --> 00:05:43,410
لا

56
00:05:43,410 --> 00:05:47,320
،سمعتُ بأنّ هناك قبوراً في الطّابق الأسفل

57
00:05:47,990 --> 00:05:53,580
لكن الشّخص الوحيد الّذي استطاع
فتح هذا الباب كان كلايمان-ساما

58
00:05:53,580 --> 00:05:57,660
،ماذا؟ إن لم يستطع أحدٌ فتحه
فكيف سوف نُكمل تحرّياتنا؟

59
00:05:59,050 --> 00:06:00,850
!يا لسذاجتك يا غوبتا

60
00:06:00,850 --> 00:06:01,590
!شيون

61
00:06:01,590 --> 00:06:03,240
!اعتمدي عليّ

62
00:06:03,240 --> 00:06:05,800
!سأقطعه بضربة واحدة بالسّيف

63
00:06:05,800 --> 00:06:07,590
!لا تُفكّري في ذلك حتّى

64
00:06:07,590 --> 00:06:09,720
هكذا إذاً

65
00:06:10,840 --> 00:06:13,450
هذا صنيع السّحر القديم

66
00:06:13,450 --> 00:06:18,480
مُحاولة فتحه بالقوّة سوف يُوقظ
الميكانيكيّة الدّفاعيّة الخاصّة بالمدينة

67
00:06:19,180 --> 00:06:21,720
إذاً إنّه فخّ لإبعاد الغُزاة؟

68
00:06:21,720 --> 00:06:23,960
من الجيّد أنّكِ لم تقطعيه

69
00:06:23,960 --> 00:06:27,170
حـ-حسناً، إنّها مُجرّد ميكانيكيّة قديمة، صحيح؟

70
00:06:27,170 --> 00:06:30,990
صحيح! لا أصدّق بأنّ الفخّ
!ما زالَ نشطاً إلى يومنا هذا

71
00:06:31,360 --> 00:06:33,220
أظنّه كذلك

72
00:06:33,220 --> 00:06:36,500
فسحر الضّوء ذلك ما زال يعمل
بعد ألف عام

73
00:06:38,800 --> 00:06:42,000
هل نبدأ بتحليلنا للباب إذاً؟

74
00:06:45,840 --> 00:06:47,920
لم أرَ هذه التّعويذة من قبل

75
00:06:47,920 --> 00:06:49,380
ماذا لو جمعنا هذه الأجزاء معاً؟

76
00:06:49,380 --> 00:06:51,350
أجل. لنُجرّب ذلك

77
00:06:51,350 --> 00:06:55,320
إذاً كان كلايمان قادراً على الوصول
إلى الطّابق الأوسط، صحيح؟

78
00:06:55,320 --> 00:06:58,210
هل كان لديه ارتباط ما مع الأطلال؟

79
00:06:58,210 --> 00:07:02,480
في الواقع، زيادة نفوذه حدثتْ مُؤخّراً نسبيّاً

80
00:07:02,480 --> 00:07:05,770
لا أظنّ أنّ لديه ارتباط بأيّ أطلال قديمة

81
00:07:05,770 --> 00:07:09,860
لا بُدّ أنّه أبطلَ التّعويذة عن هذا الباب

82
00:07:09,860 --> 00:07:13,910
أتذكّر بأنّ كلايمان كان سيّد شياطين
مُختصّاً بمثل هذه الأمور

83
00:07:13,910 --> 00:07:17,910
على ذكر الأمر، ما نوع القُدرات
الّتي كان يمتلكها؟

84
00:07:18,240 --> 00:07:19,040
إجابة

85
00:07:19,040 --> 00:07:21,830
كان يمتلك مهارةً فريدة تُدعى المُتحكِّم

86
00:07:21,830 --> 00:07:25,670
كانت تُتيح له قراءة خطوط لاي
والتحكُّم بتدفُّقها وجريانها

87
00:07:25,670 --> 00:07:29,550
،لحظة، لذا... بما أنّني التهمتُه
هل أستطيع فعل ذلك أيضاً؟

88
00:07:29,550 --> 00:07:31,430
بالطّبع، أجل

89
00:07:31,430 --> 00:07:34,020
سيستغرق هذا وقتاً

90
00:07:34,020 --> 00:07:37,020
يمكننا فعل ذلك برويّة

91
00:07:37,020 --> 00:07:40,180
هل يمكنني إلقاء نظرة أيضاً؟

92
00:07:40,480 --> 00:07:42,190
سيّد الشّياطين؟

93
00:07:46,570 --> 00:07:48,250
فهمت

94
00:07:48,250 --> 00:07:52,070
كافّة التّعويذات السّحريّة الموضوعة فوقها
تجعل الأمر يبدو أكثر تعقيداً حتّى

95
00:07:52,400 --> 00:07:55,980
عموماً، هناك ثلاثة تعويذات سحريّة
:على هذا الباب

96
00:07:55,980 --> 00:07:58,240
،واحدة استُخدِمَتْ للختم على الباب

97
00:07:58,240 --> 00:08:02,600
وأُخرى تُرسِل الطّاقةَ المُتدفِّقة من خطوط
لاي عبر الجدار

98
00:08:02,600 --> 00:08:05,830
وتعويذة عِبارة عن فخّ لمنع الباب
من الفتح عن طريق الخطأ

99
00:08:07,840 --> 00:08:10,160
هذا الفخّ هو المُشكلة

100
00:08:10,160 --> 00:08:12,750
إذا تفعّل، فإنّ الطّاقة من خطوط
،لاي سوف تُقطَع

101
00:08:12,750 --> 00:08:15,090
والضّوء المُسلَّط على هذا الطّابق سيُطفَأ

102
00:08:15,500 --> 00:08:19,970
ثمّ حالما يُخيّم الظّلام تماماً، تُحوَّل
كلّ تلك الطّاقة لاستئصال الدّخيل

103
00:08:19,970 --> 00:08:23,200
وهذه هي التّعويذة السّحريّة
الأحدث المُستخدَمة عليها

104
00:08:24,360 --> 00:08:27,820
ماذا؟ ثمّة شيء موضوع هنا لا ينتمي للباب

105
00:08:31,770 --> 00:08:34,350
،بمُفردي، ما كنتُ لأحلم بفهم هذا

106
00:08:34,350 --> 00:08:38,660
،لكن بمُساعدة رافاييل-سينسي
فهذا أشبه بحلّ لغز

107
00:08:39,010 --> 00:08:42,950
إذا أزلتُ هذه ووضعتُ تعويذة
...السّحر الصّحيحة هناك

108
00:08:44,160 --> 00:08:45,620
!نجحَ الأمر

109
00:08:45,620 --> 00:08:47,420
علينا فقط تكرار ذلك بضع مرّات
...إضافيّة، وأيضاً

110
00:08:50,540 --> 00:08:53,420
!بئساً

111
00:08:53,730 --> 00:08:57,680
ينبغي لهذا أن يكون عمل الفريق، لكن
...كنتُ مُستمتعاً جدّاً لدرجة لم أستطع التوقُّف

112
00:08:57,680 --> 00:08:59,560
!مُبهر كعادتك، ريمورو-ساما

113
00:08:59,560 --> 00:09:02,640
أجل، أنت تتصرّف بهذه الطّريقة أحياناً

114
00:09:02,640 --> 00:09:05,440
!تبّاً! حتّى غوبتا انتقدني

115
00:09:05,440 --> 00:09:07,220
هذا مُذهل

116
00:09:07,220 --> 00:09:10,690
،أجل... تعويذة سحريّة مُعقّدة كهذه
...بينما هو

117
00:09:10,690 --> 00:09:14,680
آسف بشأن هذا. لم أقصد
...سرقة بريقكم

118
00:09:14,680 --> 00:09:16,080
!عمّاذا تتكلّم؟

119
00:09:16,080 --> 00:09:16,480
!أجل

120
00:09:16,480 --> 00:09:19,640
ما المانع أن تسرق بريقَنا
!إذا كان بريقك أروع؟

121
00:09:19,640 --> 00:09:20,200
!أجل! أجل

122
00:09:20,200 --> 00:09:22,580
!حسناً، كيف حلّلتَ ذلك؟

123
00:09:22,580 --> 00:09:24,960
!أخبرنا أرجوك يا سيّد الشّياطين العظيم

124
00:09:27,710 --> 00:09:30,300
إذاً هذا الشّكل هنا كان يُعيق ذلك؟

125
00:09:30,300 --> 00:09:32,060
!فهمت! هذا ما في الأمر إذاً

126
00:09:32,060 --> 00:09:33,600
إنّهم مُحترفون حقّاً

127
00:09:33,600 --> 00:09:37,380
يُفضّلون حُبّ الاستطلاع وتعطّشهم
للمعرفة على كبريائهم

128
00:09:37,380 --> 00:09:41,180
،علّمتُهم الحدَّ الأدنى فحسب
وكان استيعابهم سريعاً

129
00:09:48,230 --> 00:09:49,860
!فُتِحَتْ جميعها

130
00:09:49,860 --> 00:09:52,360
!حسناً، هيّا! لننطلق يا ريمورو

131
00:09:52,360 --> 00:09:53,720
أجل

132
00:09:53,720 --> 00:09:55,610
...على الأقلّ، هذا ما كنتُ أودّ قوله

133
00:09:55,610 --> 00:09:57,610
لكن الظّلام يُخيّم بالفعل

134
00:09:58,000 --> 00:10:00,860
لنُؤجّل التحرّيات الحقيقيّة إلى يوم غد

135
00:10:09,370 --> 00:10:12,570
إنّه مُتّصل بالسّطح فعلاً

136
00:10:13,750 --> 00:10:17,380
ما رأيكِ يا ميليم؟ هل كان أحد
في الفريق يتصرّف بشكل مُريب؟

137
00:10:17,970 --> 00:10:20,510
لا، لم ألحظ شيئاً

138
00:10:20,510 --> 00:10:22,480
ماذا عن كاغالي-سان؟

139
00:10:22,480 --> 00:10:24,700
هل حاولتْ إجراء اتّصال خارجيّ أو ما شابه؟

140
00:10:24,700 --> 00:10:25,890
لا

141
00:10:25,890 --> 00:10:29,770
لو استخدمَتِ اتّصالاً فكريّاً، أو
اتّصالاً سحريّاً، لكنتُ قد عرفت

142
00:10:30,180 --> 00:10:34,270
إذاً أعتقد بأنّ كافّة الأشخاص
في الفريق موثوقون

143
00:10:34,270 --> 00:10:35,410
إشعار

144
00:10:35,410 --> 00:10:37,190
لا يمكن الجزم في ذلك

145
00:10:37,190 --> 00:10:39,350
،إذا كانت ممرّاتهم الرّوحيّة تربطهم

146
00:10:39,350 --> 00:10:42,180
فيمكنهم صنع خطوط سرّيّة من الاتّصالات

147
00:10:42,180 --> 00:10:44,610
أعتقد لا يمكننا الاسترخاء تماماً بعد

148
00:10:45,460 --> 00:10:47,760
حسناً، على أيّ حال، أعتقد
حان وقت النّوم

149
00:10:47,760 --> 00:10:52,010
،ماذا؟! لكنّني مُتحمّسة ليوم غد
!لدرجة لن أنام أبداً

150
00:10:52,010 --> 00:10:53,920
!أتعتقدينها رحلة ميدانيّة؟

151
00:11:07,640 --> 00:11:10,060
نجح الأمر

152
00:11:10,060 --> 00:11:11,400
!أحسنتِ صنعاً

153
00:11:19,900 --> 00:11:22,780
يبدو الهواء هنا خانقاً جدّاً فجأة

154
00:11:22,780 --> 00:11:26,080
يُشبه الشّعور في الدّيماس في تيمبيست

155
00:11:29,760 --> 00:11:33,470
،أتحقّق باستمرار بالحسّ السّحريّ
لكن هذا أشبه بمتاهة

156
00:11:33,470 --> 00:11:37,800
رُبّما الطّابق الأوسط بحدّ ذاته
هو ميكانيكيّة لطرد الدُّخلاء

157
00:11:43,580 --> 00:11:44,550
!مُذهل

158
00:11:46,960 --> 00:11:50,650
يبدو أنّ هذه الجداريّة تُصوّر
حياة النّاس في ذلك الوقت

159
00:11:50,650 --> 00:11:52,380
إنّها بحالةٍ مُمتازة

160
00:11:52,380 --> 00:11:54,940
هذه بحدّ ذاتها لها قيمة كعمل فنّي

161
00:11:56,000 --> 00:11:57,820
هذا يدفعنا للتأمُّل، أليس كذلك؟

162
00:11:58,210 --> 00:12:02,050
نحن نتواصل مع حضارة قديمة ما

163
00:12:02,050 --> 00:12:04,550
لم نسمع بها إلّا في القصص الخُرافيّة

164
00:12:07,240 --> 00:12:08,830
...عندما تُعبّر عنها بهذه الطّريقة

165
00:12:09,420 --> 00:12:13,330
فإنّها تُذكّرني بالماضي قليلاً

166
00:12:14,940 --> 00:12:15,830
هذا صحيح

167
00:12:16,530 --> 00:12:21,380
استيقظَتْ ميليم كسيّدة شياطين بعد
مقتل صديقها التنّين الرّضيع

168
00:12:22,010 --> 00:12:25,920
بالنّسبة لنا، مضتْ فترة طويلة جدّاً
،لدرجة اعتقدنا بأنّها قصّة خُرافيّة

169
00:12:25,920 --> 00:12:28,900
لكن بالنّسبة لميليم، إنّها ذِكرى حقيقيّة

170
00:12:30,050 --> 00:12:30,990
ميليم

171
00:12:31,790 --> 00:12:34,480
ألستِ جائعة؟ لنتناول الغداء

172
00:12:36,100 --> 00:12:37,860
!هيّا بنا

173
00:12:40,160 --> 00:12:41,690
حسناً، لنأكل

174
00:12:42,040 --> 00:12:44,320
لكن كيف سنوقد ناراً؟

175
00:12:44,320 --> 00:12:45,740
...في الواقع

176
00:12:45,740 --> 00:12:47,740
...إذا أردتُم غداء

177
00:12:49,920 --> 00:12:54,500
طلبتُ من شيخ الإيلف الظّلاميّين
!حزم الغداء لنا

178
00:12:54,500 --> 00:12:57,980
!مهلاً! هذا الحساء ساخن جدّاً

179
00:12:57,980 --> 00:12:59,750
!هذا ليس لحماً مُجفّفاً

180
00:12:59,750 --> 00:13:02,010
!إنّه شهيّ

181
00:13:02,480 --> 00:13:05,320
لكن... أين كنت تحمل كلّ هذا؟

182
00:13:05,320 --> 00:13:07,640
لا تقلقوا بشأن ذلك

183
00:13:07,640 --> 00:13:10,000
...كنتُ قد خزّنتُه في معدتي

184
00:13:10,000 --> 00:13:13,890
،لكن إذا أخبرتُهم بذلك وأساؤوا الفهم
سوف يفقدون شهيّتهم

185
00:13:14,400 --> 00:13:18,900
لم أتخيّل أبداً أن أتمكّن من أكل
طعام لذيذ كهذا داخل هذه الأطلال

186
00:13:18,900 --> 00:13:23,650
الحقيقة هي أنّني لم أُرِد استخدام النّار هنا

187
00:13:23,940 --> 00:13:26,150
لِمَ لا؟

188
00:13:26,540 --> 00:13:29,480
،بالإضافة إلى جانب الأمان

189
00:13:29,480 --> 00:13:33,200
لم أُرِد تلويث تُراث الشّعب القديم بالسُّخام

190
00:13:33,200 --> 00:13:36,920
أريد أن أصوت هذا قدر المُستطاع

191
00:13:37,850 --> 00:13:39,420
...هكذا إذاً

192
00:13:40,240 --> 00:13:42,480
أتمنّى أن أتّخذك قدوة

193
00:13:44,440 --> 00:13:49,430
بعد ذلك، شرعنا في تحقيق شامل
للطّابق الأوسط

194
00:13:49,430 --> 00:13:53,310
فريق التّحقيق هو مجموعة فضوليّة حقّاً

195
00:13:54,150 --> 00:13:56,370
عندما تكلّمتُ معهم حول

196
00:13:56,370 --> 00:13:59,760
مُخطَّط المتاهة الّذي يتكوّن منه الطّابق
،الأوسط وإستراتيجيّات غزو ديماسنا

197
00:13:59,760 --> 00:14:01,820
فهِموا بشكل جيّد

198
00:14:02,170 --> 00:14:05,050
،بفضل ذلك، تمكنّا من رسم خريطة للمنطقة

199
00:14:05,050 --> 00:14:08,570
وكان إكمال عبورنا للطّابق الأوسط سهلاً للغاية

200
00:14:08,570 --> 00:14:11,070
،ثمّ في اليوم الثّالث من تحقيقاتنا

201
00:14:11,070 --> 00:14:15,100
وصلنا إلى الباب المُؤدّي إلى الطّابق السُّفليّ

202
00:14:16,430 --> 00:14:19,200
إنّها نفس الميكانيكيّة الخاصّة بالباب
،الّذي في الطّابق العلويّ

203
00:14:19,200 --> 00:14:21,710
لكن تعويذتَي السّحر مُختلفتان

204
00:14:22,320 --> 00:14:24,920
لا أريد تحفيز فخّ بعد أن قطعنا هذا الشّوط

205
00:14:24,920 --> 00:14:26,590
لنستغرق وقتنا في التحرّي حوله

206
00:14:27,280 --> 00:14:30,340
جميعكم، ما رأيكم باستراحة قصيرة؟

207
00:14:30,340 --> 00:14:33,100
!شكراً لكِ

208
00:14:33,100 --> 00:14:35,390
وصلنا إلى الطّابق السّفليّ أخيراً

209
00:14:35,390 --> 00:14:38,290
لا، بحسب طريقة نشر تلك
...التّعويذات السّحريّة

210
00:14:38,290 --> 00:14:42,100
بقيتُ يقِظاً تحسُّباً فقط، لكن
لم يبدُ أحدٌ مشبوهاً

211
00:14:42,100 --> 00:14:45,150
،لو أراد شخصٌ أن يُقدِم على شيء
...لكان قد فعلها فوراً

212
00:14:45,520 --> 00:14:48,860
رُبّما يمتنع عن ذلك لأنّ ميليم هنا؟

213
00:15:04,010 --> 00:15:06,220
هل ستفعلين هذا حقّاً؟

214
00:15:06,220 --> 00:15:08,860
لا وقت لنكون نيّقين بشأن الطّريقة

215
00:15:11,360 --> 00:15:12,890
كافّة الخُطوات الضّروريّة للحدّ

216
00:15:12,890 --> 00:15:15,580
من قوّة سيّد الشّياطين ريمورو قد اتُخِذَتْ

217
00:15:24,460 --> 00:15:27,800
،كان قد خُتِمَ عليها منذ زمنٍ بعيد

218
00:15:27,800 --> 00:15:30,990
ومع ذلك لا تزال تفيض بالكراهيّة حتّى يومنا هذا

219
00:15:31,680 --> 00:15:33,060
...في هذه الحالة

220
00:15:47,630 --> 00:15:49,130
!ما-ما هذا؟

221
00:15:49,130 --> 00:15:51,010
هل هو زلزال؟

222
00:15:51,710 --> 00:15:53,640
...لا، هذا

223
00:15:58,520 --> 00:16:02,770
والآن، دع جشعك يدفعك للهيَجان

224
00:16:19,830 --> 00:16:21,550
ما يمكن أن يكون هذا؟

225
00:16:21,550 --> 00:16:24,330
...يُراودني إحساس سيّئ حيال هذا

226
00:16:24,620 --> 00:16:28,590
بدا وكأنّ استجابة طاقة هائلة
قد دوتْ في كلّ أرجاء السّطح

227
00:16:30,040 --> 00:16:35,390
تمّ رصد دُخلاء في أمريتا

228
00:16:32,120 --> 00:16:33,220
استئصال

229
00:16:35,390 --> 00:16:36,730
استئصال

230
00:16:36,730 --> 00:16:38,300
!فعّلَتِ الميكانيكيّةُ الدّفاعيّة نفسها؟

231
00:16:38,660 --> 00:16:39,600
إشعار

232
00:16:39,600 --> 00:16:41,760
تمّ رصد استجابة عدوانيّة

233
00:16:41,760 --> 00:16:43,550
هناك دخيل في الأطلال

234
00:16:43,550 --> 00:16:45,850
!إذاً كانوا ينتظرون اللّحظة المُناسبة فعلاً

235
00:16:46,230 --> 00:16:47,830
—ميليم، هل تشعرين بأي

236
00:16:49,660 --> 00:16:50,620
ميليم؟

237
00:16:53,290 --> 00:16:55,490
ريمورو، أنا آسفة

238
00:16:56,060 --> 00:16:57,740
حدثَ أمرٌ للتو

239
00:16:59,100 --> 00:16:59,990
!ميليم

240
00:17:00,850 --> 00:17:02,430
...ما الّذي

241
00:17:19,000 --> 00:17:20,810
...مهلاً لحظة! هذا

242
00:17:21,180 --> 00:17:22,000
إشعار

243
00:17:22,000 --> 00:17:25,160
إنّه التنّين القديم الّذي ختمَتْ عليه
،سيّدةُ الشّيطان ميليم منذ زمن بعيد

244
00:17:25,160 --> 00:17:26,560
تنّين الفوضى

245
00:17:27,780 --> 00:17:29,060
!ريمورو-ساما

246
00:17:29,060 --> 00:17:30,230
!الغوليم

247
00:17:33,650 --> 00:17:35,610
!دعنا نتولّى هؤلاء

248
00:17:35,610 --> 00:17:36,880
!رانغا

249
00:17:36,880 --> 00:17:37,730
!حسناً

250
00:17:50,920 --> 00:17:53,300
!لن نصل إلى نتيجة هكذا

251
00:18:07,160 --> 00:18:08,690
!إلى الدّاخل جميعاً! بسرعة

252
00:18:08,690 --> 00:18:10,190
...حدث ذلك بسرعة

253
00:18:10,190 --> 00:18:12,330
!تراجعوا حاليّاً جميعاً

254
00:18:12,330 --> 00:18:13,820
!عُلِم

255
00:18:16,460 --> 00:18:19,820
...إذاً هذا هو... الطّابق الأدنى

256
00:18:22,360 --> 00:18:23,580
!ريمورو-ساما

257
00:18:23,580 --> 00:18:25,580
!إنّهم يُطاردوننا

258
00:18:29,960 --> 00:18:31,650
!تعمّقوا للدّاخل أكثر

259
00:18:32,710 --> 00:18:35,710
لم أكن أتوقّع منهم استدعاء تنّين الفوضى

260
00:18:36,570 --> 00:18:38,160
!تنّين الفوضى؟

261
00:18:38,160 --> 00:18:40,220
!ذلك المُستبدّ، في عصرنا هذا؟

262
00:18:40,220 --> 00:18:43,970
أجل. أعتقد بأنّ ميليم ذهبت
لتُحاول إيقافه

263
00:18:44,450 --> 00:18:49,230
هل يُحاولون عزلي على حساب
إثارة غضب ميليم؟

264
00:18:49,530 --> 00:18:53,010
أعتقد هُم مُستعدّون لفعل أيّ شيء

265
00:18:53,700 --> 00:18:55,820
آسف لأنّني ورّطتُكِ في هذا

266
00:18:56,290 --> 00:18:59,030
يبدو أنّ لديك كثير من الأعداء يا ريمورو-ساما

267
00:18:59,390 --> 00:19:02,030
لكن هذا ليس ما أردتُه بالتّأكيد

268
00:19:02,410 --> 00:19:07,290
مملكة فالموث، سيّد الشّياطين
...كلايمان، القدّيسة هيناتا

269
00:19:07,290 --> 00:19:10,460
الطّرف الآخر هو من يستهدفني دوماً

270
00:19:10,460 --> 00:19:12,880
كلّ ما فعلتُه كان التّماشي مع ذلك

271
00:19:13,450 --> 00:19:15,730
هل هناك حلٌ لا يعتمد على القوّة العسكريّة؟

272
00:19:15,730 --> 00:19:19,130
هذا مُمكن إذا تراجع أحد الطّرفين

273
00:19:19,440 --> 00:19:22,890
لكن أنا متأكّد بأنّ لديهم سببهم
،الّذي يدفعهم للقتال

274
00:19:23,410 --> 00:19:25,390
ولا أستطيع التّراجع أيضاً

275
00:19:25,840 --> 00:19:28,220
ما يعني توريط أصدقائي من تيمبيست معي

276
00:19:32,100 --> 00:19:34,610
يبدو أنّنا قضينا عليهم جميعاً

277
00:19:35,690 --> 00:19:40,380
،لكن إذا بحثنا عن طريقة لتحسين العلاقات
...فرُبّما يمكننا تجنُّب القتال

278
00:19:40,380 --> 00:19:41,460
هذا مُستحيل

279
00:19:42,420 --> 00:19:43,760
مُستحيل فحسب

280
00:19:45,330 --> 00:19:47,920
جشع الإنسان لا حدود له

281
00:19:47,920 --> 00:19:51,620
إذا استسلمَ خصمُه، فإنّ طلباته ستزيد فحسب

282
00:19:52,070 --> 00:19:54,050
هذه هي طبيعة البشر

283
00:19:54,980 --> 00:19:58,630
يبدو أنّ تفكيرنا واحد. أنا سيّد الشّياطين ريمورو

284
00:19:59,000 --> 00:20:02,550
سررتُ بلقائك يا سيّد الشّياطين ريمورو

285
00:20:02,550 --> 00:20:06,640
أنا ماريبيل روتزو، عدوّتك

286
00:20:06,950 --> 00:20:08,450
عدوّتي؟

287
00:20:09,180 --> 00:20:12,520
.ثمّة شيء واحد أريد تجربته
هل هذا مقبول؟

288
00:20:12,800 --> 00:20:14,400
ما هو هذا الشّيء؟

289
00:20:15,040 --> 00:20:16,880
اعملي لصالحي

290
00:20:16,880 --> 00:20:19,900
افعلي هذا لنتجنّب أي قتال لا ضرورة له

291
00:20:20,240 --> 00:20:22,480
هذا بالضّبط ما ينبغي أن أقوله لك

292
00:20:23,060 --> 00:20:25,910
أنت من ينبغي أن تعمل لصالحي

293
00:20:26,530 --> 00:20:29,560
سياساتكِ وسياساتي ليست مُتوافقة

294
00:20:29,560 --> 00:20:33,470
طريقتُكِ تعني التسبُّب بمُعاناة
الكثير من شعبكِ

295
00:20:33,470 --> 00:20:36,670
من أجل حماية قلّة

296
00:20:37,090 --> 00:20:40,540
طبيعة الحياة تقتضي أن يجفّ دماء الضّعفاء

297
00:20:40,540 --> 00:20:43,170
أليس البقاء للأقوى قانونٌ
ينتهجه الوحوش أيضاً؟

298
00:20:44,010 --> 00:20:45,670
صحيح

299
00:20:45,670 --> 00:20:49,050
لكن في حقيقة الأمر، أكره هذه الفكرة

300
00:20:49,600 --> 00:20:53,730
بالتّأكيد، قد يكون هناك البعض مِمّن
فُقِدَ الأمل من حالتهم

301
00:20:53,730 --> 00:20:58,000
لكن لا بُدّ من وجود شخص ذي قيمة
لا يجوز التخلُّص منه بهذه السّهولة

302
00:20:58,000 --> 00:21:00,770
النّاس يمتلكون إمكانيّات غير محدودة

303
00:21:00,770 --> 00:21:06,320
لكن أسلوبكِ في التصرُّف لا تمنحهم
ولو فُرصة واحدة

304
00:21:06,320 --> 00:21:09,330
ألا تعتقدين بأنّ هذا إسراف؟

305
00:21:10,790 --> 00:21:14,080
هذا سخيف. سخيف ليس إلّا

306
00:21:14,870 --> 00:21:17,840
هناك اختلافات بين النّاس منذ ولادتهم

307
00:21:17,840 --> 00:21:20,660
هذه مسألة بديهيّة تماماً

308
00:21:20,660 --> 00:21:25,280
فكرة أن يكون الجميع سواسية
هي مثاليّات طفوليّة

309
00:21:25,280 --> 00:21:27,590
أو أماني أولئك الّذين لا يملكون شيئاً

310
00:21:27,590 --> 00:21:31,100
لم أتخيّل أن يكون سيّد شياطين
حالِماً إلى هذه الدّرجة

311
00:21:32,000 --> 00:21:34,600
دعني أُعلّمك معنى الحقيقة

312
00:21:37,200 --> 00:21:38,350
!الرّئيس يوكي؟

313
00:21:38,350 --> 00:21:40,860
غير ممكن... لكن لماذا؟

314
00:21:40,860 --> 00:21:44,550
!الرّئيس يوكي! هل خنتنا؟

315
00:21:47,740 --> 00:21:52,010
لا أملك خياراً الآن. لنُقرّر بشكل
نهائيّ مَن مِنّا على حقّ

316
00:21:52,010 --> 00:21:53,060
رافاييل

317
00:21:53,060 --> 00:21:53,870
عُلِم

318
00:21:53,870 --> 00:21:56,540
الانتقال إلى نمط القتال الشّامل

319
00:22:01,920 --> 00:22:06,670
ربّما لن يأتي اليوم الّذي يفهم
فيه النّاس بعضهم الآخر

320
00:22:08,190 --> 00:22:12,560
لكن هذا بحدِّ ذاته دليل على أنّ
هناك تفاوُت واختلافات بين البشر

321
00:22:13,650 --> 00:22:17,060
نحن كائنات نُناقض أنفسنا كجزء من التطوُّر

322
00:22:17,520 --> 00:22:19,530
وحده الشّخص الّذي يربح هنا

323
00:22:19,530 --> 00:22:23,180
هو القادر على تحديد ما هو صحيح

324
00:23:55,330 --> 00:23:58,140
"الحلقة القادمة، "سيّد الجشع