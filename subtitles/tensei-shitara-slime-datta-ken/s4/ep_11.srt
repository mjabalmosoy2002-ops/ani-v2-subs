1
00:00:04,920 --> 00:00:07,360
،منذ زمن بعيد جدّاً

2
00:00:08,170 --> 00:00:11,540
كان يوجد أربعة تنانين حقيقيّين
فقط في هذا العالم

3
00:00:13,390 --> 00:00:18,120
الأوّل كان قد أنجب طفلاً من امرأة بشريّة

4
00:00:21,250 --> 00:00:25,150
،بعد منح مُعظم قوّته لطفلة

5
00:00:25,150 --> 00:00:27,940
،وحّدَ قوّته المُتبقّية داخل كريستالة

6
00:00:27,940 --> 00:00:32,770
،ليُنشئ كياناً أُشيرَ إليه كـ بديل له
التنّين العنصريّ

7
00:00:35,110 --> 00:00:38,600
الأميرة التنّينة كَبُرَتْ وترعرعت دون
،أن ترى أو تعرف والديها

8
00:00:38,600 --> 00:00:44,550
لكن التنّين الرّضيع الّذي كان والدها
قد منحها إيّاه بجانبها دوماً

9
00:00:52,260 --> 00:00:53,360
!شكراً

10
00:00:53,800 --> 00:00:55,900
!على الرّحب

11
00:00:57,830 --> 00:00:59,720
إنّه ظريفٌ جدّاً

12
00:00:59,720 --> 00:01:01,540
ما اسمه؟

13
00:01:02,170 --> 00:01:03,440
اسم؟

14
00:01:05,200 --> 00:01:06,540
!لا يملك اسماً

15
00:01:06,780 --> 00:01:07,530
ماذا؟

16
00:01:07,530 --> 00:01:10,160
!ثـ-ثمّة اسم في ذهني له

17
00:01:10,160 --> 00:01:15,730
لكن... يبدو أنّني قويّة جدّاً لدرجة
أنّني لا ينبغي أن أسمّي الأشياء

18
00:01:16,970 --> 00:01:17,800
هذا غريب

19
00:01:18,290 --> 00:01:21,920
!سواء كان لديه اسم أو لا، فهو صديقي

20
00:01:21,920 --> 00:01:23,340
!هذا كُلّ ما يهمّ

21
00:01:30,980 --> 00:01:33,020
!انتظر

22
00:01:34,220 --> 00:01:36,550
!انتظر! انتظر

23
00:01:37,440 --> 00:01:38,950
!انتظر

24
00:01:40,250 --> 00:01:44,200
كانا يعتقدان بأنّ تلك الأيّام
الدّافئة ستستمرّ للأبد

25
00:01:46,010 --> 00:01:47,210
...لكن حينها

26
00:01:48,230 --> 00:01:51,110
،دولة الشّعوذة العظيمة، في قمّة ازدهارها

27
00:01:51,110 --> 00:01:56,050
قتلت التنّين الرّضيع في مُؤامرة للسّيطرة
على الأميرة التنّينة

28
00:01:57,220 --> 00:02:00,470
...الأميرة التنّينة قد غُمِرت بالحزن

29
00:02:00,470 --> 00:02:02,990
ثمّ جُنّ جنونها وأصبحت تشتعل
ناراً هائجة من شدّة الغضب

30
00:02:04,560 --> 00:02:07,790
وعندما عادتْ إلى رشدها بفضل

31
00:02:07,790 --> 00:02:10,060
،أميرة الأرواح وأحد أسياد الشّياطين

32
00:02:11,310 --> 00:02:15,700
أمسى ازدهار دولة الشّعوذة العظيمة
شيئاً من الماضي

33
00:02:18,780 --> 00:02:22,640
عشرات آلاف الأرواح الّتي فُقِدت نتيجة
ثوَرانها جعلَ الأميرة التنّينة

34
00:02:22,640 --> 00:02:24,380
تصحو كسيّدة شياطين

35
00:02:25,400 --> 00:02:28,210
:ثمّ حدثت مُعجزة

36
00:02:28,210 --> 00:02:30,030
عاد التنّينُ الرّضيع إلى الحياة

37
00:02:31,670 --> 00:02:36,060
،لكن لأنّ الموت قد أدّى إلى فقدان روحه

38
00:02:36,640 --> 00:02:39,020
،تحوّلَ إلى تنّين الفوضى

39
00:02:39,020 --> 00:02:41,760
كائن شرّير بلا إرادة أو هدف

40
00:02:45,080 --> 00:02:47,260
سواء كان بدافع الغضب نتيجة مقتله

41
00:02:47,260 --> 00:02:49,690
،أو بدافع الحزن نتيجة حزن صديقته

42
00:02:50,460 --> 00:02:56,630
ملأت الكراهيةُ تنّينَ الفوضى
ودمّر كُلّ شيء في دربه

43
00:02:59,630 --> 00:03:01,010
...هكذا إذاً

44
00:03:01,830 --> 00:03:05,320
...صديقي لم يعُد

45
00:03:07,600 --> 00:03:12,720
لذا قامت الأميرة التنّينة بالختم
على صديقها بعيداً بنفسها

46
00:03:20,240 --> 00:03:25,030
كانت تلك أوّل مهمّة للأميرة التنّينة
،كسيّدة شياطين

47
00:03:27,230 --> 00:03:32,260
والقصّة الأصليّة لسُلالة الشّعوذة ساريون

48
00:05:59,240 --> 00:06:00,000
!ميليم

49
00:06:01,440 --> 00:06:02,750
هل أنتِ بخير؟

50
00:06:03,040 --> 00:06:04,760
...أ-أجل

51
00:06:06,160 --> 00:06:08,380
لا تقلقي. ستفلح الأمور

52
00:06:08,940 --> 00:06:10,010
...ريمورو

53
00:06:19,440 --> 00:06:22,820
...إنّه ضخم. هذا هو تنّين الفوضى إذاً

54
00:06:23,470 --> 00:06:27,760
التنّين العنصريّ السّابق الّذي ختمتْ
ميليم عليه منذ مدّة طويلة

55
00:06:30,360 --> 00:06:32,270
صديق ميليم إذاً؟

56
00:06:32,720 --> 00:06:35,580
ريمورو، ما الّذي نستطيع فعله بالضّبط؟

57
00:06:35,910 --> 00:06:40,190
إنّه يلتهم كلّ الجزيئات السّحريّة
في المنطقة وينمو بلا توقُّف

58
00:06:40,190 --> 00:06:43,110
!إنّه ضخمٌ بما يكفي بالفعل لنختم عليه

59
00:06:44,960 --> 00:06:46,170
وهو فاسد بشدّة

60
00:06:46,730 --> 00:06:50,010
لا يمكننا عِلاجه. لقد هيمنَ عليه الجشع

61
00:06:51,430 --> 00:06:52,510
...رغم ذلك

62
00:06:52,870 --> 00:06:57,640
!رغم ذلك... لا أستطيع قتل صديقي

63
00:06:58,420 --> 00:06:59,770
...ميليم

64
00:07:24,650 --> 00:07:26,040
...يا لها من قوّة

65
00:07:49,400 --> 00:07:50,360
!ميليم

66
00:07:58,320 --> 00:07:59,350
!القلعة

67
00:08:00,580 --> 00:08:03,170
!شيون! غوبتا! هل أنتما بخير؟

68
00:08:03,170 --> 00:08:04,260
!ريمورو-ساما

69
00:08:04,260 --> 00:08:05,840
كُلّ شيء على ما يُرام هنا

70
00:08:05,840 --> 00:08:08,210
!يجب علينا العودة إلى الطّابق العلويّ

71
00:08:08,210 --> 00:08:10,800
!الشّيخ يُخلي الجميع

72
00:08:10,800 --> 00:08:12,600
!ابقوا هادئين رجاء

73
00:08:12,600 --> 00:08:14,300
!ستكونون بأمان داخل البرج

74
00:08:14,300 --> 00:08:16,650
!ساعدوهم في الإخلاء

75
00:08:16,650 --> 00:08:19,210
سأُبقي هجمات تنّين الفوضى
!مُركَّزة على هذا الاتِّجاه

76
00:08:19,210 --> 00:08:20,090
!عُلِم

77
00:08:20,090 --> 00:08:21,310
!يمكنك الاعتماد علينا

78
00:08:23,120 --> 00:08:25,810
مُجرّد قتله سيكون سهلاً بما يكفي
،بالنّسبة لميليم

79
00:08:26,120 --> 00:08:28,940
لكن لا أريد جعلها تفعل ذلك لصديقها

80
00:08:35,390 --> 00:08:37,060
لا بُدّ من وجود طريقة

81
00:08:37,060 --> 00:08:38,740
...أحتاج للتّفكير فحسب

82
00:08:40,270 --> 00:08:42,540
ما هذا الضّوء؟

83
00:08:42,540 --> 00:08:43,740
إجابة

84
00:08:43,740 --> 00:08:46,670
إنّها غالباً روح التنّين العنصريّ

85
00:08:46,670 --> 00:08:48,340
ماذا؟ روحه؟

86
00:08:48,340 --> 00:08:51,460
ألم يتحوّل إلى تنّين الفوضى لأنّه فقدها؟

87
00:08:51,920 --> 00:08:52,630
أجل

88
00:08:52,630 --> 00:08:55,620
،لكن، بعد تقييم الكائن نفسه

89
00:08:55,620 --> 00:08:59,970
،تأكّدتُ من وجود الرُّوح ومُضيفها
الجسد النّجميّ

90
00:09:00,330 --> 00:09:02,630
،لم يبقَ إلّا جزء من الرُّوح

91
00:09:02,630 --> 00:09:06,520
ولم تعُد روحاً طاهرة بسبب الفساد

92
00:09:06,520 --> 00:09:09,860
يمكن لروحه الأصليّة أن تُعَدّ تائهة

93
00:09:11,000 --> 00:09:12,640
فهمت

94
00:09:12,640 --> 00:09:16,680
لكن رغم ذلك، من الواضح أنّه لم يفقد نورَه

95
00:09:18,670 --> 00:09:19,620
!ميليم

96
00:09:21,910 --> 00:09:24,790
ميليم، أريدك أن تُهاجمي تنّين الفوضى

97
00:09:26,200 --> 00:09:28,240
الأمر مُماثل للكاريبديس

98
00:09:28,240 --> 00:09:31,080
يمكنكِ مُهاجمته دون تدمير نُواته، صحيح؟

99
00:09:31,080 --> 00:09:34,130
!بينما تفعلين ذلك، سأُمسِك بروحه

100
00:09:34,540 --> 00:09:39,150
لـ-لكن جسداً بهذا الحجم لن يشعر بأيّ هجمة
!ما لم أستخدم قوّتي الكاملة

101
00:09:39,150 --> 00:09:42,250
!هفوة واحدة قد تجعلني أُدمّر كُلّ شيء

102
00:09:43,790 --> 00:09:46,140
تعلّمتِ التحفُّظ، أليس كذلك؟

103
00:09:48,690 --> 00:09:50,880
يبذل صديقكِ قصارى جهده أيضاً

104
00:09:50,880 --> 00:09:52,650
أظهري ما يمكنكِ فعله

105
00:10:11,760 --> 00:10:13,140
حسناً

106
00:10:14,480 --> 00:10:16,760
سأثق بك يا ريمورو

107
00:10:18,090 --> 00:10:19,890
!أجل! دعي الأمر لي

108
00:10:30,960 --> 00:10:32,810
،قلتُ ذلك بثقة تامّة

109
00:10:32,810 --> 00:10:35,100
لكن لا أضمن بأنّ هذا سينجح

110
00:10:35,100 --> 00:10:37,050
،الآن بعد أن منحتُها الأمل

111
00:10:37,050 --> 00:10:40,260
إذا أخطأتُ في هذا، فسوف يفطر
ذلك قلبها أكثر فأكثر

112
00:10:41,210 --> 00:10:42,490
...لكن رغم ذلك

113
00:10:44,330 --> 00:10:46,040
!لا توجد طريقة أُخرى

114
00:11:00,500 --> 00:11:02,260
!ها أنا ذي يا صديقي

115
00:11:02,260 --> 00:11:05,900
!دع بريق النُّجوم يملأ عينيك

116
00:11:05,900 --> 00:11:08,390
!قاهر التنّين

117
00:11:23,280 --> 00:11:25,030
!لديه قرون مُثبّتة! إمّا الآن أو فلا

118
00:11:25,350 --> 00:11:26,790
!افعلها يا رافاييل

119
00:11:27,100 --> 00:11:29,540
عُلِم. أمرك مولايّ

120
00:11:36,040 --> 00:11:37,280
...هذا ثقيل جدّاً

121
00:11:37,760 --> 00:11:39,690
هذا جنون

122
00:11:39,690 --> 00:11:42,220
...أستطيع الشّعور بنقصان جُزيئاتي السّحريّة

123
00:11:42,760 --> 00:11:43,800
..لكن

124
00:11:45,850 --> 00:11:47,000
!ها هي ذي

125
00:11:48,700 --> 00:11:50,770
لا بُدّ أنّها جشع ماريبيل

126
00:11:50,770 --> 00:11:54,410
إن لم يكن هناك أيّ خبث، فسيكون
...من السّهل تطهيرها، لكن

127
00:12:00,380 --> 00:12:01,390
!اختفت؟

128
00:12:01,390 --> 00:12:02,390
إجابة

129
00:12:02,390 --> 00:12:04,660
يبدو أنّ الفرد المدعو يوكي كاغورازاكا

130
00:12:04,660 --> 00:12:07,670
هزمَ الفرد المدعوّة ماريبيل روتزو

131
00:12:07,670 --> 00:12:09,910
!الآن؟! أيُعقَل هذا؟

132
00:12:21,130 --> 00:12:22,300
!حسناً

133
00:12:22,800 --> 00:12:23,800
...بقي فقط

134
00:12:26,590 --> 00:12:29,480
ميليم! هل يمكنكِ طاقة الخَرج؟

135
00:12:29,480 --> 00:12:30,390
...لكن

136
00:12:32,480 --> 00:12:33,690
لا تقلقي

137
00:12:34,060 --> 00:12:36,690
لديّ نُواة التنّين العنصريّ

138
00:12:37,720 --> 00:12:39,770
!لنُنهِ هذا دُفعة واحدة

139
00:12:40,360 --> 00:12:42,820
!حسناً. سأدع الأمر لك

140
00:12:51,330 --> 00:12:54,080
!دراغو-نوفا

141
00:12:58,490 --> 00:13:00,190
،أعلم بأنّني طلبتُ منها فعل ذلك

142
00:13:00,190 --> 00:13:03,340
لكن من الجنون أن تتمكّن من تعزيز طاقة الخَرج
خاصّتها أكثر من ذلك حتّى

143
00:13:24,380 --> 00:13:26,320
تمّ تدمير الجسم المادّي

144
00:13:29,380 --> 00:13:31,830
تمّ تدمير الجسم الرّوحيّ

145
00:13:32,160 --> 00:13:36,330
تمّ تأكيد بقايا مانا وروحيّة
خلف الجسم النّجميّ

146
00:13:37,900 --> 00:13:39,080
ها نحن أولاء

147
00:13:50,710 --> 00:13:52,080
!ماذا تحاول أن تفعل؟

148
00:13:52,080 --> 00:13:53,720
!إنّه على وشك الانفجار

149
00:13:53,720 --> 00:13:55,810
!سأتولّى الباقي

150
00:13:58,810 --> 00:14:01,690
!التهِم كُلّ شيء، يا بيلزبوب

151
00:14:28,320 --> 00:14:31,260
هل انتهى... الأمر؟

152
00:14:32,000 --> 00:14:33,760
لا، ليس بعد

153
00:14:34,220 --> 00:14:37,770
ما زلنا بحاجة فعل شيء بشأن صديقك

154
00:14:38,960 --> 00:14:40,460
!روح مُزيَّفة

155
00:14:48,010 --> 00:14:50,280
...إذاً... في داخلها

156
00:14:50,280 --> 00:14:53,970
أجل. نقلتُ روحَ التنّين العنصريّ إلى داخلها

157
00:14:55,730 --> 00:14:57,810
لكن لا توجد استجابة منها

158
00:14:57,810 --> 00:15:00,360
لا بُدّ من التوصُّل إلى القلب

159
00:15:01,490 --> 00:15:05,210
!يا للهول! كيف أخرج من هذا؟

160
00:15:06,310 --> 00:15:07,650
صحيح! ما اسمه؟

161
00:15:07,650 --> 00:15:08,510
ماذا؟

162
00:15:08,510 --> 00:15:12,090
أفضل طريقة لمُساعدة شخص في هذه
الحالة هي مُناداته باسمه

163
00:15:12,090 --> 00:15:16,350
!عليكِ أن... تجذبي قلبه

164
00:15:16,870 --> 00:15:19,600
هذا ما يقولونه دوماً في الدراما على أيّ حال

165
00:15:21,460 --> 00:15:22,600
...اسمه

166
00:15:24,720 --> 00:15:28,980
.كان ذلك منذ زمن بعيد جدّاً
لقد نسيتُ كُلّ شيء

167
00:15:29,680 --> 00:15:33,370
لكن... هناك اسم لطالما أردتُ أن أناديه به

168
00:15:34,530 --> 00:15:39,040
لكن مُستوى تحكُّمي يجعل
الأمر محفوفاً بالمخاطر

169
00:15:39,760 --> 00:15:42,530
قيل لي بأنّ تسميته قد تُعرّض حياته لخطر

170
00:15:44,040 --> 00:15:45,540
رافاييل-سينسي

171
00:15:45,540 --> 00:15:46,380
عُلِم

172
00:15:47,700 --> 00:15:50,380
لا مُشكلة. قوليه فحسب

173
00:15:59,580 --> 00:16:00,660
إنّه غايا

174
00:16:02,190 --> 00:16:05,860
!غايا! اسمك غايا

175
00:16:06,670 --> 00:16:08,680
هذا اسم رائع

176
00:16:08,680 --> 00:16:10,900
أسمعتِ؟ اسمكِ هو غايا

177
00:16:11,530 --> 00:16:13,410
،ألا ينبغي أن تستيقظ الآن

178
00:16:13,410 --> 00:16:16,280
قبل أن تبدأ صديقتك بالبُكاء؟

179
00:16:30,020 --> 00:16:31,500
نجح الأمر

180
00:16:32,250 --> 00:16:36,550
لكن لا يزال بيضة، لذا أعتقد سيمضي بعض
الوقت قبل أن تتمكّنا من اللِّقاء

181
00:16:43,740 --> 00:16:45,420
...إنّها دافئة

182
00:16:49,200 --> 00:16:50,820
شكراً لك

183
00:16:51,280 --> 00:16:53,290
!شكراً لك يا ريمورو

184
00:16:53,290 --> 00:16:57,660
!كُلّ شيء ينجح دوماً عندما أعتمد عليك

185
00:16:57,660 --> 00:16:59,840
أنا مسرور فقط لأنّكِ سعيدة

186
00:17:00,700 --> 00:17:02,800
حسناً، هل نعود؟

187
00:17:02,800 --> 00:17:04,830
أنا متأكّد بأنّ الجميع قلقون

188
00:17:05,150 --> 00:17:08,210
!أجل! أنا جائعة أيضاً

189
00:17:09,150 --> 00:17:12,290
وبهذا انتهت القضيّة

190
00:17:12,290 --> 00:17:15,000
لا أطيق انتظار العودة والاحتفال
بشرب بعض البيرة

191
00:17:24,300 --> 00:17:26,900
ليتك استشرتني منذ البداية

192
00:17:28,960 --> 00:17:31,320
أتكلّم عن الهجوم على أمريتا

193
00:17:31,320 --> 00:17:34,400
كان من الصّعب جدّاً خِداع أعضاء
فريق التّحقيق

194
00:17:34,970 --> 00:17:37,710
لكن نجح الأمر، لذا ما المُشكلة؟

195
00:17:37,710 --> 00:17:40,410
فضلاً عن ذلك، كنتُ قد آمنتُ بكِ

196
00:17:40,760 --> 00:17:44,490
أنت رجلٌ مجنونٌ حقّاً

197
00:17:44,490 --> 00:17:47,170
ويبدو أنّك سرقتَ مهارة شخص آخر

198
00:17:47,470 --> 00:17:52,530
إن كنتِ تقصدين الجشع، فإنّ
،المهارة قد اختارتني

199
00:17:52,530 --> 00:17:55,420
لكن ما زلتُ لستُ ندّاً لريمورو-سان

200
00:17:55,840 --> 00:17:59,980
لكن قبل كلّ ذلك، كان هدفي قتل ماريبيل

201
00:18:00,540 --> 00:18:04,430
برحيلها، أستطيع فعل ما أريده
،دون إثارة الشّكوك

202
00:18:04,760 --> 00:18:09,380
ناهيكِ عن أنّني أستطيع إلقاء لوم
كلّ تلك الأفعال الشّرّيرة عليها

203
00:18:09,380 --> 00:18:12,480
!وبهذا، أكون قد بُرِّئتُ تماماً

204
00:18:12,480 --> 00:18:14,620
أنت رجلٌ فظيع

205
00:18:15,240 --> 00:18:16,070
...رغم ذلك

206
00:18:16,750 --> 00:18:21,200
بدا كُلّ ما حدث ناجم عن بُعد
نظر من جهتها

207
00:18:21,810 --> 00:18:24,000
،لو قتلتْ سيّدَ الشّياطين ريمورو

208
00:18:24,000 --> 00:18:26,470
،لكان تنّين العاصفة قد ثار

209
00:18:26,470 --> 00:18:31,030
ولكانت السّيطرة على تنّين الفوضى
لتُثير غضب سيّدة الشّياطين ميليم

210
00:18:31,030 --> 00:18:32,720
ألم يكن هذا تعسُّفيّاً؟

211
00:18:33,510 --> 00:18:34,530
...بخصوص ذلك

212
00:18:35,590 --> 00:18:37,220
ما الّذي يجعلكِ تعتقدين ذلك؟

213
00:18:38,720 --> 00:18:40,760
حماية الإلَهة لوميناس؟

214
00:18:41,200 --> 00:18:43,260
هل أنت جادّ؟

215
00:18:43,680 --> 00:18:45,190
بكلّ تأكيد

216
00:18:45,190 --> 00:18:48,000
ما كانت ماريبيل لتلجأ لإجراءات مُتطرِّفة كهذه

217
00:18:48,000 --> 00:18:50,900
لو لم تكن تعرف كم قد يُسبّب ذلك من أضرار

218
00:18:50,900 --> 00:18:55,480
فوق كُلّ ذلك، أصرّتْ على أنّه "لا حاجة
"للقلق بشأن ذلك

219
00:18:56,120 --> 00:19:00,610
هذا لأنّها كانت تعلم بأنّ الدُّول الغربيّة
كانت محميّة بواسطة لوميناس

220
00:19:01,030 --> 00:19:04,700
ظنّتْ إذاً بأنّه حتّى لو هاجَ تنّينُ
،العاصفة وسيّدة الشّياطين ميليم

221
00:19:04,700 --> 00:19:07,740
سيكون من المُمكن رغم ذلك
التّعافي من الأضرار النّاجمة؟

222
00:19:07,740 --> 00:19:08,980
تماماً

223
00:19:11,200 --> 00:19:12,800
حسناً، دععيني أسألكِ

224
00:19:12,800 --> 00:19:16,590
من الّذي هزمَه لابلاس في الأرض
المُقدّسة في لوبيليوس؟

225
00:19:17,370 --> 00:19:21,090
سيّد الشّياطين فالينتاين... المُتنكّر
بهيئة الإمبراطور المُنعزل؟

226
00:19:22,090 --> 00:19:23,390
!أجل

227
00:19:23,390 --> 00:19:27,350
ومع ذلك بقي سيّدُ الشّياطين فالينتاين
في أوكتاغرام

228
00:19:27,720 --> 00:19:31,980
بصيغة أُخرى، سيّدُ الشّياطين الّذي
قتلَه لابلاس كان زائفاً

229
00:19:32,320 --> 00:19:35,810
وما الشّخص الّذي يعلو الإمبراطور المُنعزل رتبة

230
00:19:35,810 --> 00:19:38,280
ويتمركز في مقرّ النّورانيّة؟

231
00:19:39,820 --> 00:19:43,280
...الإلَهة وسيّدة الشّياطين، لوميناس فالينتاين

232
00:19:43,540 --> 00:19:45,090
أصبتِ

233
00:19:45,090 --> 00:19:46,280
...بالإضافة إلى ذلك

234
00:19:46,280 --> 00:19:50,020
استخدمَ ظلُّ الدّماء سحراً مُقدَّساً في أمريتا

235
00:19:51,700 --> 00:19:53,520
—بصيغة أُخرى، عائلة روتزو

236
00:19:53,520 --> 00:19:55,500
—أو على الأقلّ، غرانفيلي روتزو

237
00:19:55,500 --> 00:19:57,800
لديه ارتباطات بلوميناس

238
00:19:58,850 --> 00:20:00,290
...غرافنيلي

239
00:20:00,290 --> 00:20:05,800
غران، البطل السّابق، الّذي قاتلَ في السّابق
سيّدةَ الشّياطين لوميناس كعدوّته اللّدودة

240
00:20:06,280 --> 00:20:09,240
يبدو أنّ الرّابط ازداد عمقاً

241
00:20:11,110 --> 00:20:15,850
لذا يجدر بنا غالباً أن نبقي بعيدين
عن عائلة روتزو

242
00:20:15,850 --> 00:20:19,350
لعلّنا ينبغي أن ننقل قاعدتنا
نحو الشّرق لبعض الوقت

243
00:20:19,350 --> 00:20:21,950
...أجل، لكن أوّلاً

244
00:20:22,640 --> 00:20:24,950
سأقترح اجتماعاً مع غرانفيلي

245
00:20:25,240 --> 00:20:26,200
ماذا؟

246
00:20:26,540 --> 00:20:30,480
.كنتُ تحت سيطرة ماريبيل في نهاية المطاف
هذا يجعلني ضحيّة

247
00:20:30,480 --> 00:20:34,710
أودُّ لقاءه ومُناقشة كيفيّة تنظيف آثار أفعالها

248
00:20:36,190 --> 00:20:38,840
أرى بأنّك لا تنوي التّواري عن الأنظار البتّة

249
00:20:39,400 --> 00:20:40,990
بكلّ تأكيد

250
00:20:40,990 --> 00:20:44,770
إذ أنّني سأصبح ملِك هذا العالم

251
00:20:57,650 --> 00:21:01,310
،تقرّر بأن نستعيد أطلال أمريتا

252
00:21:01,310 --> 00:21:03,860
حيث وقعت المعركة، والقلعة في جيستاف

253
00:21:04,540 --> 00:21:07,700
آمل أن أحوّلها في نهاية المطاف إلى مِتحف

254
00:21:07,700 --> 00:21:09,500
وأعرض بعض المصنوعات والآثار

255
00:21:10,480 --> 00:21:14,400
لكن تشغيل القطار السّحريّ هناك
وتجهيزه للسّياحة

256
00:21:14,400 --> 00:21:16,660
ما زال هدفاً بعيداً

257
00:21:17,820 --> 00:21:19,870
أخبرنا يوكي بأنّ الطّابق السُّفليّ

258
00:21:19,870 --> 00:21:24,470
حيث توجد القبور قد دُمِّرَ بانفجار ماريبيل

259
00:21:24,970 --> 00:21:28,790
يبدو أنّها كانت تأمل بأن يطالني الانفجار

260
00:21:29,520 --> 00:21:31,290
أشعر بالمرارة حيال ذلك

261
00:21:32,320 --> 00:21:36,530
حسناً، على أيّ حال، أنا مسرور
لأنّ دائرة الشكّ زالت عن يوكي

262
00:21:36,530 --> 00:21:38,740
—الآن يمكننا بناء علاقات تعاونيّة دون

263
00:21:38,740 --> 00:21:41,380
كلّا. هناك شكّ بالفعل

264
00:21:41,380 --> 00:21:41,980
!ماذا؟

265
00:21:42,410 --> 00:21:43,690
!ماذا تقصد؟

266
00:21:43,690 --> 00:21:45,870
،الفرد المدعو يوكي كاغورازاكا كان

267
00:21:45,870 --> 00:21:48,650
من دون شكّ، يتصرّف من تلقاء نفسه

268
00:21:48,650 --> 00:21:49,820
!ماذا؟

269
00:21:49,820 --> 00:21:53,120
!لحظة، لماذا لم تُخبرني إذاً؟

270
00:21:53,540 --> 00:21:54,560
إجابة

271
00:21:54,560 --> 00:21:56,270
المبادئ الّتي تحكم سلوكَ المرء بسيطة

272
00:21:56,270 --> 00:21:58,240
كان بمقدوره استخدامها ضدّك

273
00:22:00,220 --> 00:22:04,920
فهمت. التزم رافاييل-سان الصّمت من أجلي

274
00:22:06,560 --> 00:22:08,930
ما كنتُ لأستطيع قتل ماريبيل

275
00:22:09,880 --> 00:22:11,630
كان هذا حُكمك، صحيح؟

276
00:22:12,640 --> 00:22:16,680
صحيح. هذا ما تحقّقتُ من أنّه ضروريّ

277
00:22:18,580 --> 00:22:20,230
أنا مُثيرٌ للشّفقة

278
00:22:20,800 --> 00:22:24,020
أقلقتُك كثيراً لأنّه لا يمكن الاعتماد عليّ

279
00:22:24,710 --> 00:22:27,450
كلّا. هذا غير صحيح

280
00:22:27,450 --> 00:22:30,520
أما ببساطة لم أُرِد أن أُشعرك بتوتُّر

281
00:22:30,520 --> 00:22:33,360
يسرّني أنّ هذا الشّعور قد راودك، لكن
هذا ليس جيّداً بما يكفي

282
00:22:33,920 --> 00:22:37,820
يجب أن أتقبّله وأتّخذ قرارات من تلقاء نفسي

283
00:22:39,070 --> 00:22:41,820
من الآن فصاعداً، أبلغني بالتّفاصيل الكاملة
دون إخفاء شيء

284
00:22:41,820 --> 00:22:44,320
عُلِم. أمرك

285
00:22:48,730 --> 00:22:51,300
،مهما كان يُخطّط له يوكي

286
00:22:51,300 --> 00:22:53,450
سأسحق طموحاته

287
00:22:54,300 --> 00:22:56,280
لستُ لوحدي

288
00:22:56,280 --> 00:22:59,770
لديّ كُلّ أصدقائي وشريك أستطيع
دوماً الاعتماد عليه

289
00:23:00,580 --> 00:23:02,300
،ما دام لديّ رافاييل

290
00:23:02,300 --> 00:23:05,080
يمكنني المضيّ قُدماً باستمرار

291
00:23:05,970 --> 00:23:07,780
أليس كذلك يا شريكي؟

292
00:23:13,820 --> 00:23:15,280
هل كنتُ أتوهّم ذلك؟

293
00:23:15,970 --> 00:23:19,620
شعرتُ وكأنّ رافاييل ضحك قليلاً للتو

294
00:23:27,080 --> 00:23:28,750
...ماريبيل

295
00:23:41,300 --> 00:23:45,890
تُصرّ على انتزاع كُلّ شيء منّي ثانية؟

296
00:23:49,040 --> 00:23:53,720
دُمِّر أمل البشريّة

297
00:23:55,140 --> 00:23:57,930
"الحلقة القادمة، "تيمبيست تتطوّر