1
00:00:06,840 --> 00:00:08,910
...تبدو مألوفة بعض الشّيء

2
00:00:09,600 --> 00:00:14,080
سأأتمنك على الكنز الّذي
تُخفيه لوميناس-ساما

3
00:00:14,550 --> 00:00:19,300
السّلاح الأعظم الّذي تمّ استخدامه
للختم على فيلدورا بحدِّ ذاته

4
00:00:20,180 --> 00:00:22,840
أيّ مزحة هي هذه حقّاً؟

5
00:00:23,180 --> 00:00:26,840
أعني، سيّدة شياطين، من بين كُلّ شيء، تحميكِ؟

6
00:00:28,850 --> 00:00:33,600
لماذا كنتِ نائمة داخل التّابوت المُقدّس؟

7
00:02:12,180 --> 00:02:15,130
لماذا يدفعني غرانفيلي أنا وليون
لمُقاتلة بعضنا الآخر؟

8
00:02:15,130 --> 00:02:17,070
ما هو هدفه بالضّبط؟

9
00:02:18,090 --> 00:02:20,820
لديّ فكرة عمّا قد يكون دافعه

10
00:02:21,330 --> 00:02:23,290
يوكي كاغورازاكا

11
00:02:23,810 --> 00:02:27,330
يبدو أنّه شكّلَ حلفاً ما مع غرانفيلي

12
00:02:31,160 --> 00:02:33,370
،لا مانع لديّ أن أتظاهر بالقتال

13
00:02:33,370 --> 00:02:35,840
لكنّه يفهم ما أسعى له هنا، صحيح؟

14
00:02:36,090 --> 00:02:36,830
إجابة

15
00:02:36,830 --> 00:02:38,330
لا توجد مُشكلة

16
00:02:38,330 --> 00:02:41,800
تُجارَى مُخطّطاتك بفضل التنبّؤ بالهجوم المُستقبليّ

17
00:02:42,050 --> 00:02:45,790
إذاً سأضبط القتال على الوضع الآليّ

18
00:02:45,790 --> 00:02:47,810
!وأكتشف نوايا غرانفيلي

19
00:02:56,830 --> 00:02:58,150
!لا يمكن تقييمه؟

20
00:02:59,760 --> 00:03:03,520
ما معنى هذا؟ "مُنتزِع" لا تفلح

21
00:03:03,520 --> 00:03:06,570
لِمَ لا تنجح مهارةٌ وهي مُخصَّصة للاستخدام
ضدّ خصوم رفيعي المرتبة؟

22
00:03:07,480 --> 00:03:12,580
مُنتزِع" هي السّلطة الّتي تسمح لي"
بسرقة مهارة واحدة أو فنّ لكلّ خصم

23
00:03:12,580 --> 00:03:16,770
لهذا السّبب تحفّظتُ عن سرقة
واحدة أثناء الاختبار

24
00:03:16,770 --> 00:03:19,050
واستخدمتُ نسخةً بدلاً من ذلك

25
00:03:20,920 --> 00:03:23,550
هل أنتِ مُشوّشة لأنّكِ لا تستطيعين
سرقة فنوني منّي؟

26
00:03:25,830 --> 00:03:27,570
ما الّذي يُفاجئكِ إلى هذا الحدّ؟

27
00:03:27,570 --> 00:03:31,810
هل خلتِ بأنّني غير مُدرك لسرّكِ؟

28
00:03:32,290 --> 00:03:35,820
سرقتِ قدرةً منّي بالفعل

29
00:03:35,820 --> 00:03:39,570
لن يفلح ذلك ضدّي مرّة ثانية

30
00:03:39,570 --> 00:03:41,710
—لا! أنا متأكّدة بأنّني لم

31
00:03:44,180 --> 00:03:46,030
توقّعتُ هذا

32
00:03:46,030 --> 00:03:49,080
هيناتا، أنتِ ماكرة

33
00:03:49,080 --> 00:03:52,750
لهذا أنتِ من بين أكثر تلاميذي موهبةً

34
00:03:53,400 --> 00:03:59,090
،حتّى بين فُرسان الماضي المُقدّسين
قلّة منهم فاقوا مُستواكِ

35
00:03:59,090 --> 00:04:03,710
لكنّكِ غير معتادة على مُقاتلة
!شخص نظير لكِ من حيث القوّة

36
00:04:04,770 --> 00:04:06,090
!اصمت

37
00:04:06,370 --> 00:04:09,600
!إذا كان كذلك، فسألعب بورقتي الرّابحة

38
00:04:14,030 --> 00:04:19,170
يستطيع الاستحواذ بالقوّة سرقة مهارة
بغضّ النّظر عن مُستوى الخصم

39
00:04:19,170 --> 00:04:22,530
سأجرّده من خياراته واحدة تِلو الأخرى
!إلى أن أستطيع إنهاء هذا

40
00:04:25,820 --> 00:04:30,150
مُستحيل! أنا متأكّدة بأنّني استطعتُ
!سرِقة مهارته

41
00:04:30,150 --> 00:04:34,120
هل جهّزَ نسخة احتياطيّة قبل
!أن يتنبّأ بسرِقتي لواحدة؟

42
00:04:34,120 --> 00:04:36,380
ما الأمر يا هيناتا؟

43
00:04:36,380 --> 00:04:40,840
!تبدين وكأنّكِ لا تملكين فكرة عمّا أفعل

44
00:04:40,840 --> 00:04:45,650
هل اعتقدتِ بأنّني لم أحضِّر إجراءات
مُضادّة سلفاً لكِ؟

45
00:04:51,580 --> 00:04:53,520
ما الّذي يجري؟

46
00:04:53,520 --> 00:04:55,260
...وهذا الإعياء

47
00:04:55,260 --> 00:04:58,270
إنّه شديدٌ جدّاً على أن يكون من آثار
!الاستحواذ بالقوّة

48
00:04:58,270 --> 00:05:00,590
تبدين مُرتبِكة

49
00:05:00,590 --> 00:05:02,990
لكن هذا بسيطٌ جدّاً

50
00:05:03,430 --> 00:05:07,900
أتصرّف بطريقة محسوبة لدفعكِ
نحو أقصى حدودكِ

51
00:05:09,250 --> 00:05:12,880
هل فهمتِ؟ عندما تُواجهين خصماً
،نظيراً لمُستواكِ

52
00:05:12,880 --> 00:05:16,200
فإنّ الشّخص الّذي يُرهِق الآخر
أوّلاً هو من يربح

53
00:05:16,200 --> 00:05:19,730
يضعف تركيزه، وتزداد ثغراته

54
00:05:20,280 --> 00:05:24,850
!أنتِ تمرّين بذلك جسديّاً الآن

55
00:05:24,850 --> 00:05:27,420
أجل... هذا صحيح

56
00:05:27,830 --> 00:05:31,180
إنّه أقوى منّي بالفعل

57
00:05:31,590 --> 00:05:35,080
حتّى لو استطاعت "مُنتزِع" سرِقة
،مهارة أو فنّ منه

58
00:05:35,080 --> 00:05:38,480
لا أستطيع انتزاع الموهِبة الّتي
جمعَها على مدى العمر

59
00:05:38,810 --> 00:05:44,010
إذاً هذا هو الفرق في المُستوى الّذي
ينبع من امتلاك خبرة أكبر

60
00:05:44,890 --> 00:05:46,660
استنتاج ممتاز

61
00:05:46,660 --> 00:05:50,580
يبدو أنّني لا أملك خياراً
سوى مُقاتلتك بجدّية

62
00:06:03,970 --> 00:06:06,590
هذا صحيح. قاتليني بجدّية

63
00:06:06,590 --> 00:06:11,510
وإلّا فمُباغتتي لا تعدو كونها
حُلماً بعيد المنال

64
00:06:12,160 --> 00:06:13,760
!ها أنا ذي يا غرانفيلي

65
00:06:14,020 --> 00:06:17,230
!صدري مفتوح لكِ يا هيناتا

66
00:06:28,860 --> 00:06:32,990
لا تُتعب نفسك. لا يمكنك هزيمتي
يا أخا روي

67
00:06:32,990 --> 00:06:34,750
أحقّاً ذلك؟

68
00:06:34,750 --> 00:06:38,310
وأيضاً، لديّ اسم: لوي

69
00:06:38,310 --> 00:06:40,580
،أنا توأم روي جوهريّاً

70
00:06:40,580 --> 00:06:43,420
!لكن حبّذا ألّا تُناديني بأخيه

71
00:06:43,820 --> 00:06:45,790
أقول لك، لا جدوى

72
00:06:52,960 --> 00:06:54,550
!ما تلك القوّة بالضّبط؟

73
00:06:54,890 --> 00:06:57,450
بدأتُ أفهم أخيراً فحوى الأمور

74
00:06:57,450 --> 00:07:00,370
"كان ذلك تطبيقاً لـ"شُعاع الدّم

75
00:07:00,370 --> 00:07:04,980
،بالطّبع، الآن بعد أن أريتُك ذلك مرّة
أشكُّ في أنّه سينجح ثانية

76
00:07:05,320 --> 00:07:09,570
هذا سيّئ. ما غايته على أيّ حال؟

77
00:07:09,840 --> 00:07:13,820
!لذا يمكنك أن تموت هنا والآن

78
00:07:17,890 --> 00:07:19,580
لسوء حظّك

79
00:07:20,300 --> 00:07:23,990
روي وأنا لسنا توأمين. نحن جزءٌ واحد

80
00:07:23,990 --> 00:07:30,000
أجل، عندما مات روي، استرجعتُ قوّتي الأصليّة

81
00:07:30,370 --> 00:07:34,900
كنتُ أُعرف في السّابق بالحاكم الدّمويّ

82
00:07:34,900 --> 00:07:39,080
،لوميناس-ساما هزمَتْني وجعلَتْني تابعها

83
00:07:39,080 --> 00:07:41,610
،لكن كنتُ همجيّاً جدّاً بالنّسبة لها

84
00:07:41,610 --> 00:07:45,120
لذا استخدمَتْ قِواها لتقسيمي إلى اثنين

85
00:07:45,610 --> 00:07:50,860
ثمّ جعلَتْني الإمبراطورَ المُنعزل
وجعلَتْ روي سيّد شياطين

86
00:07:51,850 --> 00:07:54,980
—ولهذا السّبب أستطيع هزيمتك

87
00:07:55,820 --> 00:07:59,190
كان ذلك خطيراً حقّاً

88
00:07:59,190 --> 00:08:00,080
!مُستحيل

89
00:08:00,080 --> 00:08:01,580
!سنخرج من هنا يا فوتمان

90
00:08:02,380 --> 00:08:05,220
!ستموت إذا استمرّ هذا

91
00:08:06,840 --> 00:08:10,030
!يؤسفني الاعتراف بذلك، لكن لعلّك على حقّ

92
00:08:11,570 --> 00:08:12,460
!لن تهرب

93
00:08:12,460 --> 00:08:15,320
!غونتر، اعتنِ بلوميناس-ساما

94
00:08:15,320 --> 00:08:18,050
كانا مُجرّد وسيلة إلهاء إذاً؟

95
00:08:18,050 --> 00:08:21,430
...ما يعني بأنّ... هدفهم هو

96
00:08:22,760 --> 00:08:26,650
أعلم بأنّ هذا المخلوق لم يعُد ماريا

97
00:08:29,700 --> 00:08:32,230
...لكن ما زلتُ أشعر بها

98
00:08:33,100 --> 00:08:38,450
حوّلَ غران المرأة الّتي أحبَّها حُبّاً جمّاً
إلى خادمة وأرسلَها لمُقاتلتي

99
00:08:39,530 --> 00:08:42,910
أرى الآن مدى عزيمة غران
تجاه هذه المعركة

100
00:08:44,450 --> 00:08:46,710
!لكن هذا ليس كافياً

101
00:08:56,710 --> 00:09:01,400
من المُؤكَّد أنّ غران لم يعتقد
بأنّ ماريا تستطيع هزيمتي

102
00:09:02,120 --> 00:09:04,890
...لذا لا بُدّ أنّ هدفه هو

103
00:09:10,350 --> 00:09:11,560
!لوميناس-ساما

104
00:09:11,980 --> 00:09:14,270
مع الأسف، هربَ الدّخيلان

105
00:09:14,270 --> 00:09:18,120
...لوي يُطاردهما حاليّاً، وأنا أيضاً سوف

106
00:09:29,940 --> 00:09:33,420
!ليس هذا... أيّ شيء عدا هذا

107
00:09:35,270 --> 00:09:36,760
!لوميناس-ساما

108
00:09:36,760 --> 00:09:39,510
!اللّعنة عليك يا غرانفيلي

109
00:09:50,150 --> 00:09:53,360
!أتتمادى إلى هذا الحدّ يا غران؟

110
00:09:55,940 --> 00:09:57,190
!غونتر

111
00:09:57,650 --> 00:10:01,200
!جِدهم! جِد الدُّخلاء بأيّ ثمن

112
00:10:01,670 --> 00:10:02,750
!عُلِم

113
00:10:04,270 --> 00:10:06,700
من يقِف وراء هذا يا تُرى؟

114
00:10:07,120 --> 00:10:11,710
شخص واحد فقط بمُستوايّ يستطيع
!تنفيذ هذا هنا

115
00:10:12,080 --> 00:10:14,830
...شخص ائتمنَه غرانفيلي على هدفه الحقيقيّ

116
00:10:16,970 --> 00:10:19,650
،إن لم يُحمَ ريثما يحين الوقت

117
00:10:19,650 --> 00:10:22,300
!قد يُدمَّر العالم

118
00:10:23,870 --> 00:10:26,140
!لن أسمح بذلك

119
00:10:35,310 --> 00:10:36,510
!ما هذا؟

120
00:10:40,200 --> 00:10:41,360
...هذا الضّوء

121
00:10:53,200 --> 00:10:55,170
هـ-هل سنكون بخير؟

122
00:10:55,560 --> 00:10:58,350
...ريمورو-سينسي... أختي الكُبرى هيناتا

123
00:10:59,380 --> 00:11:00,090
!كلوي

124
00:11:00,490 --> 00:11:01,680
!انتظري

125
00:11:05,720 --> 00:11:07,660
!اللّعنة

126
00:11:12,470 --> 00:11:13,810
!قلتُ انتظري

127
00:11:19,370 --> 00:11:20,720
...ريمورو-سينسي

128
00:11:24,310 --> 00:11:26,570
أخي الكبير ليون؟

129
00:11:33,650 --> 00:11:34,830
...لوميناس

130
00:11:35,430 --> 00:11:36,830
...لوميناس-ساما

131
00:11:39,410 --> 00:11:40,960
غرانفيلي

132
00:11:41,530 --> 00:11:46,720
يبدو أنّك اتّخذتَ القرار فعلاً لتكون عدوّي

133
00:11:49,210 --> 00:11:51,470
مُدهش يا لوميناس-ساما

134
00:11:52,720 --> 00:11:57,150
يبدو أنّه حتّى خادمتي لم تكن كافية لعرقلتكِ

135
00:11:57,750 --> 00:11:59,490
!أيّها الأحمق

136
00:11:59,490 --> 00:12:02,370
،مهما منحتها من قوّة مُزيّفة

137
00:12:02,370 --> 00:12:05,240
!دُمية بلا إرادة ليست ندّة لبشريّ حقيقيّ

138
00:12:05,240 --> 00:12:08,990
!يجدر بك أن تكون مُدركاً لذلك

139
00:12:08,990 --> 00:12:12,240
أنا مُدرك بالطّبع

140
00:12:12,240 --> 00:12:13,750
!لماذا إذاً؟

141
00:12:15,570 --> 00:12:18,090
لأنّ ذلك كان ضروريّاً

142
00:12:18,090 --> 00:12:22,360
كُلّ ما فعلتُه كان لأجل هذه اللّحظة

143
00:12:24,430 --> 00:12:25,530
...ما الّذي

144
00:12:47,340 --> 00:12:48,490
...هذا مُستحيل

145
00:12:49,700 --> 00:12:51,990
...هذا أنت إذاً... أنت

146
00:12:52,450 --> 00:12:57,790
وضعتَ كُلّ طاقة الحُبّ الّتي منحتُك
!إيّاها داخل ماريا

147
00:13:02,450 --> 00:13:06,390
الآن بعد أن ماتت ماريبيل، أمل
،البشريّة جمعاء

148
00:13:06,390 --> 00:13:08,730
فُقِدَ أملي

149
00:13:10,280 --> 00:13:13,860
!لكن لا يمكنني التوقُّف عن الأمل ببساطة

150
00:13:13,860 --> 00:13:15,150
!أيُّها الوغد

151
00:13:15,150 --> 00:13:16,250
!لا تستخفّ بنا

152
00:13:16,250 --> 00:13:18,380
هذا صحيح يا هيناتا

153
00:13:18,380 --> 00:13:21,330
لم أنتهِ من توجيه التّعليمات لكِ

154
00:13:24,340 --> 00:13:25,040
!هيناتا

155
00:13:28,250 --> 00:13:30,880
...الضّربة المُمزِّقة المُذيبة؟ مُستحيل

156
00:13:30,880 --> 00:13:34,260
تحكّمتَ بالذرّات الرّوحيّة لاستخدامها
!من دون تعويذ؟

157
00:13:34,840 --> 00:13:36,060
...إنّه

158
00:13:36,060 --> 00:13:39,260
!أجل. إنّه وحشٌ أقوى ممّا اعتقدنا

159
00:13:39,260 --> 00:13:40,970
هيناتا

160
00:13:40,970 --> 00:13:46,220
لم أستوعب سبب عجزكِ عن أن تُصبحي بطلة

161
00:13:46,820 --> 00:13:49,690
الموهبة والجهد وحدهما لا يكفيان
لجعل المرء بطلاً

162
00:13:50,440 --> 00:13:55,320
الشّخص غير المحبوب بواسطة الأرواح
لا يستطيع كسب الحقّ في أن يكون بطلاً

163
00:13:55,630 --> 00:13:59,320
لكنّكِ محبوبة بواسطة الأرواح

164
00:13:59,990 --> 00:14:01,890
آسفة لتخييب آمالك

165
00:14:01,890 --> 00:14:04,960
.لم أستطع أن أُصبح بطلة فحسب
هذا كُلّ ما في الأأمر

166
00:14:05,520 --> 00:14:09,500
هيناتا، يقطن ظلامٌ في قلبكِ، أليس كذلك؟

167
00:14:10,420 --> 00:14:13,120
هل قتلتِ شخصاً مُقرّباً منكِ؟

168
00:14:13,600 --> 00:14:17,020
—رُبّما صديقاً أو شقيقاً، أو حتّى شريـ

169
00:14:17,020 --> 00:14:18,010
!اصمت

170
00:14:26,740 --> 00:14:29,480
!أيُعقَل هذا؟ الفارق بينهما شاسع

171
00:14:30,100 --> 00:14:33,580
لم تقبلي روح النُّور

172
00:14:33,580 --> 00:14:35,430
تغلّبي على ذلك

173
00:14:35,430 --> 00:14:40,690
الظّلام لا يعدو كونه وهماً
رسمَه عقل المرء

174
00:14:40,690 --> 00:14:42,160
...اصمت

175
00:14:42,160 --> 00:14:47,020
اقبلي ماضيكِ واعتزّي بهويّتكِ اليوم

176
00:14:47,020 --> 00:14:48,920
—حينئذ النُّور سوف

177
00:14:48,920 --> 00:14:50,590
!قلتُ لك اصمت

178
00:14:51,820 --> 00:14:54,350
!يا للخسارة يا هيناتا

179
00:14:54,350 --> 00:14:58,630
بمزيد من الوقت، أستطيع منحكِ
الهِداية الّتي احتجتِها

180
00:14:59,170 --> 00:15:02,050
إن كنتِ لا تستطيعين استيعاب ذلك، فمن
الأفضل أن تُجرّبيه جسديّاً

181
00:15:02,050 --> 00:15:05,150
إن لم تستطيعي حماية الّذين
،تتمنّين حمايتهم

182
00:15:05,150 --> 00:15:09,270
فكيف تتأمّلين أن تنقذي العالمَ كُلّه؟

183
00:15:10,350 --> 00:15:11,320
إشعار

184
00:15:11,320 --> 00:15:14,670
،وفقاً للتنبُّؤ بالهجوم المُستقبليّ
...إنّه يُصوِّب نحو

185
00:15:14,670 --> 00:15:17,070
الفرد المدعو كلوي أوبيرت

186
00:15:18,900 --> 00:15:20,160
!كلوي

187
00:15:20,160 --> 00:15:21,240
!هل قلت "كلوي"؟

188
00:15:41,640 --> 00:15:43,140
...مُؤلم

189
00:15:48,010 --> 00:15:49,200
...هيناتا

190
00:15:51,850 --> 00:15:53,560
!أختي الكُبرى هيناتا؟

191
00:15:55,800 --> 00:15:56,770
!فينوم

192
00:15:56,770 --> 00:15:58,110
!حاضر

193
00:15:59,700 --> 00:16:01,190
...هذا مُؤلم

194
00:16:01,190 --> 00:16:02,740
كلوي! هل أنتِ بخير؟

195
00:16:03,610 --> 00:16:05,120
...هل أختي الكُبرى هيناتا

196
00:16:05,120 --> 00:16:07,870
!هيناتا! تماسكي يا هيناتا

197
00:16:08,600 --> 00:16:10,900
...لا... سوف تموت

198
00:16:10,900 --> 00:16:13,960
!أختي الكُبرى هيناتا، لا تموتي

199
00:16:13,960 --> 00:16:16,530
!تحتاج جرعات! اهتمّ ببقيّة الأطفال

200
00:16:16,530 --> 00:16:17,380
!عُلِم

201
00:16:19,300 --> 00:16:20,620
—لوميناس

202
00:16:20,620 --> 00:16:24,050
!اصمت! الذرّات الرّوحيّة تتحرّك بسرعة
!بسرعة فائقة

203
00:16:24,050 --> 00:16:25,110
إشعار

204
00:16:25,110 --> 00:16:27,310
الذرّات الرّوحيّة دمّرَتِ الجسدَ الرّوحيّ

205
00:16:27,310 --> 00:16:29,430
للفرد المدعو هيناتا ساكاغوتشي

206
00:16:29,430 --> 00:16:32,580
ستجتاح قريباً جسدَها النّجميّ كذلك

207
00:16:32,580 --> 00:16:35,310
...لكن حينها... ستبقى "هيناتا"، لكن

208
00:16:42,700 --> 00:16:43,780
!هيناتا

209
00:16:43,780 --> 00:16:45,190
!أختي الكُبرى هيناتا

210
00:16:45,190 --> 00:16:49,040
!أجل! هكذا يا هيناتا! احتفظي بوعيكِ

211
00:16:50,240 --> 00:16:53,360
...لوميناس-ساما... أنا

212
00:16:54,040 --> 00:16:55,970
!لا تتكلّمي

213
00:17:00,100 --> 00:17:01,160
...كلوي

214
00:17:02,010 --> 00:17:04,220
يسرّني أنّكِ بخير

215
00:17:06,990 --> 00:17:11,660
كلوي... هذا... لكِ

216
00:17:13,130 --> 00:17:15,440
...لم أستطع فعل شيء لأجلكِ

217
00:17:16,370 --> 00:17:19,380
...يجعلني أستحقّ أن أكون مُعلّمتكِ

218
00:17:20,710 --> 00:17:23,230
...لكن أعلم

219
00:17:24,610 --> 00:17:26,070
بأنّكِ ستتمكّنين من التفوُّق عليّ

220
00:17:26,900 --> 00:17:29,530
...أختي الكُبرى هيناتا

221
00:17:42,170 --> 00:17:43,320
...ماذا

222
00:17:45,710 --> 00:17:46,890
...لا

223
00:17:47,700 --> 00:17:48,740
لماذا؟

224
00:17:51,270 --> 00:17:54,300
...لا أعلم... لا أعلم ما يكون هذا

225
00:17:56,300 --> 00:17:58,330
مهلاً... كلوي؟

226
00:17:58,330 --> 00:18:01,130
!لماذا؟! هذا مُبكّرٌ جدّاً

227
00:18:10,770 --> 00:18:12,120
ماذا كان ذلك؟

228
00:18:12,120 --> 00:18:12,860
!مهلاً

229
00:18:13,500 --> 00:18:16,790
!أين كلوي؟! ماذا فعلتَ لها؟

230
00:18:17,100 --> 00:18:18,840
!لا أعلم أيضاً

231
00:18:18,840 --> 00:18:21,170
غير واضح. هذه نتيجة غير مُتوقَّعة

232
00:18:21,170 --> 00:18:24,040
لا أستطيع إيجاد شرح كامل لما حدث

233
00:18:24,040 --> 00:18:25,940
للفرد المدعو كلوي أوبيرت

234
00:18:25,940 --> 00:18:26,490
ماذا؟

235
00:18:26,490 --> 00:18:27,780
!انبعاث

236
00:18:33,630 --> 00:18:35,000
لماذا؟

237
00:18:35,000 --> 00:18:38,010
!لم يمضِ وقت طويل منذ وفاتها

238
00:18:38,010 --> 00:18:39,860
!لماذا لا ينجح الانبعاث؟

239
00:18:40,260 --> 00:18:41,510
...مُستحيل

240
00:18:41,510 --> 00:18:42,440
إجابة

241
00:18:42,440 --> 00:18:45,940
روح الفرد المدعو هيناتا ساكاغوتشي قد اختفت

242
00:18:46,310 --> 00:18:51,450
مهما كانت الطّريقة، من غير المُمكن استعادة
جُزيئات جوهوشي المفقودة

243
00:18:52,380 --> 00:18:58,710
...هيناتا... أنا آسفة لحدوث هذا تحت أنظاري

244
00:18:58,710 --> 00:19:00,710
كفى بُكاء

245
00:19:00,710 --> 00:19:03,350
سار كُلُّ هذا وفق خطّتي

246
00:19:03,970 --> 00:19:08,040
المراحل الأخيرة تسير بشكل مثاليّ يا لوميناس

247
00:19:08,840 --> 00:19:10,170
لن يدوم هذا

248
00:19:11,140 --> 00:19:13,050
!سأدعك تندم على هذا

249
00:19:13,940 --> 00:19:16,770
!سأمزِّقك إرباً إرباً

250
00:19:17,100 --> 00:19:18,620
تمّ التّأكيد

251
00:19:18,620 --> 00:19:20,560
استوفيَت الشُّروط

252
00:19:20,560 --> 00:19:26,280
المهارة الفريدة شهوة قد تطوّرَتْ
إلى المهارة النّهائيّة أسموديوس

253
00:19:26,280 --> 00:19:28,740
!هذا لا يعني شيئاً الآن

254
00:19:28,740 --> 00:19:34,030
القدرة الّتي تفشل عندما نكون بأمسّ
!الحاجة لها لا تعنيني شيئاً

255
00:19:34,470 --> 00:19:37,040
إنّها نهاية تريدها، أليس كذلك؟

256
00:19:37,040 --> 00:19:40,400
!سأرسلك إلى الحياة الآخِرة يا غرانفيلي

257
00:19:52,980 --> 00:19:54,760
!ما هذه الطّاقة؟

258
00:19:55,640 --> 00:19:56,770
!هل الجميع بخير؟

259
00:19:58,270 --> 00:20:00,020
!أجل، نحن بخير

260
00:20:00,020 --> 00:20:01,810
!لا مشاكل هنا أيضاً

261
00:20:03,560 --> 00:20:05,850
ما الّذي أخّرَك كثيراً يا ريمورو-ساما؟

262
00:20:05,850 --> 00:20:08,650
!ديابلو؟ يسرّني أنّك عدتَ في الوقت

263
00:20:08,650 --> 00:20:10,600
!اهتمّ بالآخرين

264
00:20:10,600 --> 00:20:12,320
عُلِم

265
00:20:14,630 --> 00:20:15,830
...هذا مُستحيل

266
00:20:27,330 --> 00:20:29,850
ما هذه الهالة؟

267
00:20:29,850 --> 00:20:30,700
إشعار

268
00:20:30,700 --> 00:20:32,840
هذا الشّيء هو جسدٌ مادّي

269
00:20:33,290 --> 00:20:35,540
تمّ رصد مُستويات طاقة غير طبيعيّة

270
00:20:35,540 --> 00:20:38,660
حدُّها الأعلى يُوازي مُستويات
طاقة الفرد المدعو فيلدورا

271
00:20:38,660 --> 00:20:39,350
—ما

272
00:20:39,350 --> 00:20:40,720
كان أنت؟

273
00:20:41,100 --> 00:20:44,350
!أنت من كسرَ تابوتي المُقدَّس؟

274
00:20:45,460 --> 00:20:46,650
...يوكي

275
00:20:46,650 --> 00:20:48,440
هل أنتِ لوميناس؟

276
00:20:48,440 --> 00:20:50,490
أنا يوكي كاغورازاكا

277
00:20:50,490 --> 00:20:51,740
هذا شرفٌ عظيمٌ لي

278
00:20:51,740 --> 00:20:52,760
!اصمت

279
00:20:52,760 --> 00:20:55,060
!ما هو هدفك بالضّبط؟

280
00:20:55,060 --> 00:20:58,660
كيف تمكّنتَ من إلغاء ختم قوّة الرُّوح
!المُقدّسة وإيقاظ كرونوا؟

281
00:20:59,650 --> 00:21:00,660
كرونوا؟

282
00:21:00,660 --> 00:21:03,840
اسمها هو كرونوا إذاً؟

283
00:21:03,840 --> 00:21:07,040
عجباً، تفاجأتُ حقّاً عندما سمعتُ
بذلك أوّل مرّة

284
00:21:07,420 --> 00:21:11,100
لم أصدِّق بأنّ الكنزَ الّذي كانت سيّدة
الشّياطين تُخفيه

285
00:21:11,100 --> 00:21:14,930
هو البطلة الّتي ختمتْ على تنّين
العاصفة بحدّ ذاتها

286
00:21:15,230 --> 00:21:16,180
البطلة؟

287
00:21:16,820 --> 00:21:19,180
إذاً تلك الفتاة الصّغيرة هي بطلة؟

288
00:21:19,180 --> 00:21:22,510
إنّها بطلة، لكن ليست ببطلة

289
00:21:22,510 --> 00:21:27,440
إنّها الآن تجسيدٌ للدّمار باسمِ كرونوا

290
00:21:29,470 --> 00:21:32,110
أحسنت صنعاً يا يوكي

291
00:21:32,110 --> 00:21:36,830
لم أستطع كسر ختم قوّة الرُّوح
،المُقدّسة في التّابوت المُقدّس

292
00:21:36,830 --> 00:21:40,080
لهذا السّبب استخدمتُك

293
00:21:40,460 --> 00:21:43,860
بئس الأمر! أعتقد بأنّ الثّعلب
قد هُزِمَ بالدّهاء

294
00:21:43,860 --> 00:21:45,580
غلبتَني في ذلك

295
00:21:46,040 --> 00:21:48,910
...ما يعني بأنّ هدف غرانفيلي هو

296
00:21:49,790 --> 00:21:52,600
،الآن بعد أن تحرّرتْ من الختم

297
00:21:52,600 --> 00:21:55,090
لا يمكن هزيمتها

298
00:21:55,370 --> 00:21:59,120
...يا أسياد الشّياطين، يا كائنات الشّرّ

299
00:21:59,120 --> 00:22:02,870
!جميعكم ستموتون هنا

300
00:23:42,910 --> 00:23:45,320
أظنّني عدتُ إلى هنا من جديد

301
00:23:46,410 --> 00:23:48,680
...لكن هذه المرّة

302
00:23:55,220 --> 00:23:58,910
"الحلقة القادمة، "كرونوا البطلة