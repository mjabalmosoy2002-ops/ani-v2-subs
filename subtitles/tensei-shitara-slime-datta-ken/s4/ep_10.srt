1
00:00:01,270 --> 00:00:04,980
لم أتخيّل أبداً أن يكون سيّد
الشّياطين حالماً هكذا

2
00:00:05,920 --> 00:00:08,230
دعني أعلّمك ماهيّة الحقيقيّة

3
00:00:08,790 --> 00:00:12,740
لا خيار الآن. لنُقرّر بشكل نهائيّ
مَن مِنّا على حقّ

4
00:00:18,760 --> 00:00:21,000
أنا من سيكون خصمكِ

5
00:00:21,000 --> 00:00:23,200
ماذا؟ كم هذا مُسلٍّ

6
00:00:23,200 --> 00:00:26,190
أيّ ضعيف يخضع لسيطرة شخص آخر

7
00:00:26,190 --> 00:00:28,510
!ليس نِدّاً لي

8
00:00:31,120 --> 00:00:32,990
!تحوّل

9
00:00:35,960 --> 00:00:37,970
!أنا أحد النّخبة الأربعة أيضاً

10
00:00:37,970 --> 00:00:40,470
—رانغا وأنا كنّا نتدرّب لأجل

11
00:00:42,890 --> 00:00:45,200
أيّها المُستذئب البغيض الّذي يقف
!مع سيّد شياطين حقير

12
00:00:45,200 --> 00:00:47,150
!خصمُك هو أنا

13
00:00:47,910 --> 00:00:49,770
!مهلاً، ما زلتُ أتكلّم

14
00:00:52,310 --> 00:00:55,150
سيّد الشّياطين ريمورو، ستذوق الثّأر

15
00:00:55,890 --> 00:00:58,660
هل ذلك الفارس يضمر ضغينةً ضدّي؟

16
00:01:00,430 --> 00:01:05,160
والآن تستخدم ماريبيل شهوته للثّأر
لتجعله يُطيع أوامرها؟

17
00:01:06,240 --> 00:01:07,750
هيّا يا غايي

18
00:01:07,750 --> 00:01:10,280
أسقِط سيّد الشّياطين ريمورو

19
00:01:14,670 --> 00:01:15,590
غايي؟

20
00:01:16,050 --> 00:01:18,720
الرّجل الّذي كان مُغترّاً جدّاً بنفسه؟

21
00:01:20,510 --> 00:01:22,850
...فهمت. إنّه بالفعل

22
00:01:28,530 --> 00:01:30,890
أردت مُقاتلتي، أليس كذلك؟

23
00:01:31,360 --> 00:01:35,110
كم من اللّطيف أن تتحقّق أُمنيتك
قبل مماتك

24
00:01:35,640 --> 00:01:38,980
مُستحيل... ما هذه القوّة بالضّبط؟

25
00:01:38,980 --> 00:01:40,450
ماذا تقصدين؟

26
00:01:40,450 --> 00:01:43,740
ألا تعرفين حتّى مَن جعلتِه عدوّاً لكِ للتوّ؟

27
00:01:47,750 --> 00:01:51,500
أنتِ التّالية يا ماريبيل روتزو

28
00:01:52,300 --> 00:01:54,860
ستكونين غِذائي

29
00:03:32,420 --> 00:03:35,290
كيف يُسقَط غايي بهذه السّهولة؟

30
00:03:36,170 --> 00:03:40,580
حرقتُ روحَه بالكامل لتحقيق التّعزيز الأقصى

31
00:03:40,580 --> 00:03:44,510
ظننتُ بأنّ ذلك سيُكسبني وقتاً ريثما
،أتمكّن من التحكُّم بسيّد الشّياطين

32
00:03:44,510 --> 00:03:46,200
لكن كنتُ ساذجة

33
00:03:47,180 --> 00:03:48,330
...رغم ذلك

34
00:03:50,800 --> 00:03:51,670
إشعار

35
00:03:51,670 --> 00:03:56,450
الفرد المدعو ماريبيل روتزو
أطلقتْ نداءً سحريّاً

36
00:03:56,450 --> 00:03:58,500
أستنتج بأنّها أصدرتْ أوامرَ
على شخص في الخارج

37
00:04:00,330 --> 00:04:02,800
!أ-أشعر بثِقَل في جسدي

38
00:04:04,380 --> 00:04:07,220
أتذكّر... هذا الإحساس

39
00:04:07,550 --> 00:04:09,260
مجال مُقدّس؟

40
00:04:09,260 --> 00:04:11,960
صحيح. صحيح بالفعل

41
00:04:11,960 --> 00:04:17,730
أعرف جيّداً بأنّنا لا نملك فُرصة
ضدّك في قتال مُباشر

42
00:04:18,120 --> 00:04:22,020
لكن من الواضح الآن أنّك بالغت
،في تقدير قوّتك

43
00:04:22,020 --> 00:04:25,240
وأنت تقف أمامي عاجزاً

44
00:04:25,800 --> 00:04:28,020
سيُكلّفك هذا حياتك

45
00:04:29,040 --> 00:04:32,450
عليك أن أن تُميّز الفرق في الذّكاء
بين البشر والوحوش

46
00:04:32,840 --> 00:04:34,330
كنتُ مُحقّاً

47
00:04:36,600 --> 00:04:38,710
عرفتُ بأنّكِ ستُجرّبين هذا

48
00:04:39,470 --> 00:04:40,840
ونعرف سلفاً بأنّ غرانفيلي

49
00:04:40,840 --> 00:04:43,800
كان أحد رجال دين الأيّام السّبعة التّابعين
للكنيسة المُقدّسة الغربيّة

50
00:04:44,280 --> 00:04:47,050
أنا متأكّد بأنّكِ تحسبين أنّكِ
،أوقعتِني في فخّكِ

51
00:04:47,050 --> 00:04:49,050
لكن فعلتُ المثل

52
00:04:49,050 --> 00:04:53,180
قدّمتُ نفسي كطعم لأستدرجكِ إلى هنا

53
00:04:53,180 --> 00:04:54,960
،عرفتُ بأنّكِ إذا أردتِ التحكُّم بي

54
00:04:54,960 --> 00:04:57,940
فإنّكِ سيترتّب عليكِ المجيء إليّ بنفسكِ

55
00:05:00,080 --> 00:05:03,040
فهمت. هكذا هو الأمر إذاً

56
00:05:03,040 --> 00:05:06,570
الشّخص الّذي بالغَ في تقدير
قوّته كان أنا

57
00:05:07,050 --> 00:05:10,780
فكرة أن أستطيع التحكُّم بسيّد
شياطين كانت حلماً بعيد المنال

58
00:05:11,260 --> 00:05:12,860
،رغم أنّني أكره قول ذلك

59
00:05:12,860 --> 00:05:16,580
سيكون ترك مخلوق خطير كهذا
طليقاً ضرباً من الطّيش

60
00:05:16,920 --> 00:05:18,580
لذا لا أملك خياراً

61
00:05:19,680 --> 00:05:21,470
لن أتردّد

62
00:05:21,470 --> 00:05:24,590
سأكرّس كُلَّ ما لديّ لقتلك

63
00:05:25,040 --> 00:05:28,590
جيّد. سأبذل كُلّ ما لديّ أيضاً

64
00:05:35,520 --> 00:05:37,610
!تلهَّفْ للموت

65
00:05:37,610 --> 00:05:39,400
!الإنتروبيا المفقودة

66
00:05:43,470 --> 00:05:44,280
!ريمورو-ساما

67
00:05:44,280 --> 00:05:46,740
هل لديكِ الوقت للقلق على شخصٍ آخر؟

68
00:05:50,760 --> 00:05:52,480
كم هذا مُخيِّب

69
00:05:52,480 --> 00:05:55,750
لا أحد، مهما كان قويّاً، يستطيع
التخلِّي عن رغبته للعيش

70
00:05:56,170 --> 00:05:58,830
هذا ما يجعلني لا أُقهَر

71
00:05:59,120 --> 00:06:01,740
لا يوجد شيء أقوى من جشعي

72
00:06:02,620 --> 00:06:04,080
فهمت

73
00:06:05,160 --> 00:06:09,830
تمتلك كافّة الكائنات الحيّة
،غريزة الرّغبة في العيش

74
00:06:09,830 --> 00:06:11,980
ومهارتكِ تعكس ذلك

75
00:06:12,550 --> 00:06:15,060
إنّها أقوى مهارة موجودة بالفعل

76
00:06:15,410 --> 00:06:16,850
...مُستحيل

77
00:06:17,250 --> 00:06:21,860
لكنّها الأقوى فقط ضمن
نِطاق المهارات الفريدة

78
00:06:21,860 --> 00:06:26,830
،تأكيد. إنّها غير فعّالة ضدّ سيّدي
الّذي اكتسبَ مهارات نهائيّة

79
00:06:26,830 --> 00:06:29,320
إنّها مسألة قوّة روح المرء

80
00:06:29,320 --> 00:06:34,620
لذلك، الفرد المدعو ماريبيل روتزو
لديها فُرصة فوز معدومة

81
00:06:35,370 --> 00:06:38,900
مع الأسف. اكتملَ تحليلي

82
00:06:38,900 --> 00:06:42,000
قِواكِ لن تفلح معي الآن

83
00:06:43,320 --> 00:06:45,830
إلى أيّ درجة أنت مجنون؟

84
00:06:47,320 --> 00:06:49,490
استسلمي يا ماريبيل

85
00:06:49,490 --> 00:06:51,640
هذا هو تحذيري الأخير لكِ

86
00:06:52,270 --> 00:06:56,090
إذا أردتِ الاستمرار في العيش
كفتاة عاديّة، فلن أقتلكِ

87
00:06:58,690 --> 00:07:01,200
لا أقبل بالخسارة

88
00:07:01,200 --> 00:07:05,650
لا سبيل آخر لي سوى هزيمة
سيّد الشّياطين ريمورو

89
00:07:05,650 --> 00:07:10,730
،الدُّول الغربيّة، والعالم بأسرِه
!ينتمي لي وحدي

90
00:07:12,320 --> 00:07:14,910
!المزيد. المزيد

91
00:07:18,500 --> 00:07:21,080
،حتّى لو استهلكَ هذا كُلّ ما لديّ

92
00:07:21,080 --> 00:07:23,460
!سيكون النّصر حليفي

93
00:07:24,470 --> 00:07:28,510
فهمتُ الآن. هكذا عزّزتْ غايي

94
00:07:29,080 --> 00:07:29,880
...لا

95
00:07:30,160 --> 00:07:31,070
إشعار

96
00:07:31,070 --> 00:07:34,230
القدرة الجسديّة الخاصّة بالفرد
المدعو ماريبيل روتزو

97
00:07:34,230 --> 00:07:38,390
تتزايد مع مع ازدياد قوّة مهارتها
الفريدة جشع

98
00:07:38,390 --> 00:07:40,770
إنّها تُعزِّز قوّة مهارتها؟

99
00:07:40,770 --> 00:07:43,600
!مُت يا سيّد الشّياطين ريمورو

100
00:07:57,940 --> 00:08:00,540
أخبرتُكِ، هجماتكِ لن تفلح معي

101
00:08:08,610 --> 00:08:10,760
سأمنحكِ موتاً بلا ألم

102
00:08:11,200 --> 00:08:13,280
فكّري فيما اقترفَتْه يداكِ
أثناء وجودكِ بداخلي

103
00:08:21,480 --> 00:08:22,530
!شيون

104
00:08:29,990 --> 00:08:31,530
!الرّئيس يوكي

105
00:08:36,600 --> 00:08:37,950
يوكي

106
00:08:44,000 --> 00:08:45,870
استهنتُ بك

107
00:08:45,870 --> 00:08:48,790
قلّلتُ من قيمتك يا سيّد الشّياطين ريمورو

108
00:08:48,790 --> 00:08:52,340
لم أتوقّعك أن تدفعني إلى هذا الحدّ

109
00:08:52,620 --> 00:08:53,570
إشعار

110
00:08:53,570 --> 00:08:57,180
قوّة الفرد يوكي كاغورازاكا
قد ازدادت بشكل بليغ

111
00:08:57,180 --> 00:09:01,880
،من خلال مهارتها الفريدة جشع
الفرد المدعو ماريبيل روتزو

112
00:09:01,880 --> 00:09:03,980
نقلَتْ قوّتها إليه

113
00:09:04,340 --> 00:09:05,980
!تبّاً، كم هذا مُزعج

114
00:09:06,410 --> 00:09:09,150
سأعتبر هذا مديحاً

115
00:09:19,660 --> 00:09:21,870
من الجرأة أن تستغرق وقتك
في النّظر حولك

116
00:09:21,870 --> 00:09:23,290
سأتّخذ هذا الأمر بجدّية

117
00:09:27,640 --> 00:09:28,570
صدمة

118
00:09:28,570 --> 00:09:31,130
تمّ كسر حاجز أورييل الكونيّ

119
00:09:31,820 --> 00:09:33,550
!أيُعقَل هذا؟

120
00:09:33,550 --> 00:09:35,870
أستنتج بأنّ الفرد المدعو يوكي كاغورازاكا

121
00:09:35,870 --> 00:09:39,430
يمتلك التّكوين الخاصّ والمعروف
بـ مُضادّ المهارات

122
00:09:40,550 --> 00:09:44,220
بصيغة أُخرى، لا يقتصر الأمر على فشل
،دِفاعي المُطلَق فحسب

123
00:09:44,220 --> 00:09:47,440
!بل يستطيع إبطال كافّة هجماتي أيضاً؟

124
00:09:47,440 --> 00:09:51,010
تأكيد. مُضادّ المهارات هي تركيبة روحيّة

125
00:09:51,010 --> 00:09:53,010
تُبطِل السّحر والمهارات

126
00:09:53,010 --> 00:09:55,620
هل هذا يعني بأنّ الفنون
ما زالت تعمل؟

127
00:09:55,620 --> 00:09:58,820
أيضاً، كيف يُعقَل أن يتمكّن
!من إبطال مهارة نهائيّة؟

128
00:09:59,170 --> 00:10:04,080
ظننتُ بأنّك قلت بأنّك لا تمتلك
أي مهارة فريدة أو قِوى خاصّة

129
00:10:04,430 --> 00:10:06,460
لم أكن أكذب

130
00:10:06,460 --> 00:10:10,080
أخبرتُك بأنّ قدراتي الجسديّة
استثنائيّة، أليس كذلك؟

131
00:10:10,520 --> 00:10:11,500
...أيُّها

132
00:10:15,160 --> 00:10:19,300
أفضّل عدم قتلك إذا كنتَ تخضع
،لسيطرة شخص آخر فحسب

133
00:10:19,300 --> 00:10:20,620
لكن لا أملك خياراً

134
00:10:25,810 --> 00:10:29,090
!يا له من سيف مُبهر

135
00:10:29,090 --> 00:10:31,520
لا تحقد عليّ إن مُتَّ

136
00:10:34,520 --> 00:10:37,030
هذا ما ينبغي أن أقوله أنا لك

137
00:10:44,490 --> 00:10:46,740
...لهذا السّبب الرّئيس

138
00:10:46,740 --> 00:10:49,860
بدا أنّه يُطيع تلك الفتاة الصّغيرة

139
00:10:49,860 --> 00:10:51,840
هل كان يتمّ استغلالنا؟

140
00:10:51,840 --> 00:10:52,630
!هذا مُستحيل

141
00:10:53,210 --> 00:10:56,000
!مُحال أن يخوننا الرّئيس يوكي

142
00:10:56,640 --> 00:10:59,510
أنا متأكّدة من وجود سبب وراء هذا

143
00:10:59,900 --> 00:11:04,230
أ-أجل! لا بُدّ من وجود سبب
!لا يستطيع إخبارنا به

144
00:11:04,840 --> 00:11:06,260
...صحيح

145
00:11:23,620 --> 00:11:25,530
حسناً، ماذا أفعل الآن؟

146
00:11:25,530 --> 00:11:28,330
سيكون من الرّائع لو أستطيع إلغاء
...التدخُّل العقليّ الّذي يخضع له

147
00:11:28,630 --> 00:11:29,520
إشعار

148
00:11:29,520 --> 00:11:32,920
تمّ صدّ التدخُّل بواسطة مُضادّ المهارات

149
00:11:33,460 --> 00:11:34,420
أجل، توقّعت

150
00:11:38,680 --> 00:11:42,380
في حالتي، عندما أُهاجم بالضّرب
فقط، فإنّ مهاراتي تؤثّر به

151
00:11:43,640 --> 00:11:46,050
هذا يعني بأنّ هجماتي لن تنجح معه

152
00:11:46,050 --> 00:11:47,260
...على الأقلّ، لا ينبغي لها ذلك

153
00:11:50,110 --> 00:11:54,100
هل يستخدم المُراوغة أو الأسلحة
للتّعامل مع هجمات سيفي؟

154
00:11:54,100 --> 00:11:55,030
إشعار

155
00:11:55,030 --> 00:11:57,990
مُضادّ المهارات لا ينطبق على الأسلحة

156
00:11:57,990 --> 00:11:58,980
!كنتُ مُحقّاً إذاً

157
00:11:59,370 --> 00:12:02,070
هجمات جسديّة مع أسلحة
!ينبغي أن تفلح

158
00:12:02,070 --> 00:12:04,990
...ما يعني بأنّ أي هجمات بالسّلاح منه

159
00:12:08,910 --> 00:12:11,000
أرخيتَ دِفاعك يا ريمورو-سان

160
00:12:17,920 --> 00:12:21,970
مع الأسف. كنتُ لأتألّم أكثر
لو ضربتَني بيدك

161
00:12:21,970 --> 00:12:24,230
!مُستحيل! كان ذلك مُتعمَّداً؟

162
00:12:24,230 --> 00:12:25,590
!هذا يفوق الجنون

163
00:12:28,440 --> 00:12:33,480
أسلحة يوكي لا تستطيع اختراق
!دِفاعي المُطلَق

164
00:12:33,480 --> 00:12:35,350
!كسر العاصفة

165
00:12:54,250 --> 00:12:56,680
كان ذلك اندماجاً لهجمة سيف

166
00:12:56,680 --> 00:13:00,360
وسحر العاصفة من مهارتي
النّهائيّة فيلدورا

167
00:13:00,360 --> 00:13:01,330
إشعار

168
00:13:01,330 --> 00:13:06,130
بعض التّأثيرات من الفنّ المُطبَّق قد تمّ
إبطالها بواسطة مُضادّ المهارات

169
00:13:06,570 --> 00:13:09,660
لا مُشكلة. فأنا لا أريد قتله

170
00:13:14,320 --> 00:13:20,400
سحر العاصفة يُدمِّر النّسيج الجسديّ من خلال
الجروح المفتوحة، ما يُسبّب تآكُل الجسد

171
00:13:21,080 --> 00:13:26,070
،لكن بما أنّك تمتلك مُضادّ المهارات
فهذا ليس خطيراً على حياتك

172
00:13:27,870 --> 00:13:29,320
تقييم

173
00:13:31,910 --> 00:13:35,830
أجل، إنّه مُلوَّث حتّى النّخاع
بجشع ماريبيل

174
00:13:35,830 --> 00:13:38,710
لا أستطيع إلغاء التدخُّل العقليّ

175
00:13:39,210 --> 00:13:40,940
...الخيار المُتبقّي الوحيد هو

176
00:13:45,030 --> 00:13:47,760
ابقَ نائماً ريثما أقضي على ماريبيل

177
00:13:47,760 --> 00:13:49,280
سيترتّب عليّ استعمال القسوة قليلاً

178
00:13:49,280 --> 00:13:51,160
لا تفهم الأمر بطريقة خاطئة

179
00:13:50,010 --> 00:13:51,160
!انتظر

180
00:13:52,240 --> 00:13:55,770
!من فضلك اعفُ عن حياة الرّئيس يوكي

181
00:13:55,770 --> 00:13:58,900
!هذا خطير كما تعلمين
!إنّه خاضع للتحكُّم

182
00:13:59,190 --> 00:14:00,380
!لا

183
00:14:00,380 --> 00:14:04,900
مُحال للرّئيس يوكي أن يخسر أمام
!فتاة صغيرة في الثّبات العقليّ

184
00:14:05,200 --> 00:14:08,360
!الرّئيس يوكي، من فضلك تمالك نفسك

185
00:14:08,360 --> 00:14:11,700
أعلم بأنّك لستَ من النّوع
!الّذي يُطيع شخصاً آخر

186
00:14:12,020 --> 00:14:13,540
...كاغالي

187
00:14:13,830 --> 00:14:16,480
!هذا صحيح! كما قالت كاغالي

188
00:14:16,480 --> 00:14:17,290
!أجل

189
00:14:17,290 --> 00:14:20,290
!رئيسنا ليس بذلك الضّعف

190
00:14:18,020 --> 00:14:19,230
!حضرة الرّئيس

191
00:14:18,020 --> 00:14:19,230
!الرّئيس يوكي

192
00:14:19,230 --> 00:14:21,040
!تماسك

193
00:14:21,040 --> 00:14:23,380
ماذا؟

194
00:14:23,380 --> 00:14:26,300
...هذا يجعلني أبدو كشخص شرّير

195
00:14:26,800 --> 00:14:28,720
...أ-أنتم

196
00:14:30,230 --> 00:14:31,720
!الرّئيس يوكي

197
00:14:33,100 --> 00:14:37,730
لا أريد أن أدع نفسي أبدو أكثر
إثارة للشّفقة بعد كلّ ما قلتموه

198
00:14:38,990 --> 00:14:39,700
ماذا؟

199
00:14:40,530 --> 00:14:43,060
!حضرة الرّئيس! هل عدتَ إلى رشدك؟

200
00:14:43,400 --> 00:14:48,540
أجل. يبدو أنّ أصواتكم أرجعتْ وعيي

201
00:14:48,540 --> 00:14:49,400
شكراً

202
00:14:49,400 --> 00:14:51,200
!حضرة الرّئيس

203
00:14:51,200 --> 00:14:52,780
!هذا مُطمئن! صدقاً

204
00:14:53,160 --> 00:14:54,870
!كنتُ مُؤمناً منذ البداية

205
00:14:55,410 --> 00:14:56,300
إشعار

206
00:14:56,300 --> 00:14:59,830
تحقّقتُ من تغيُّر طرأ على الفرد
المدعو يوكي كاغورازاكا

207
00:14:59,830 --> 00:15:03,380
يبدو أنّ التدخُّل العقليّ للجشع
قد تمّ إلغاؤه

208
00:15:03,380 --> 00:15:06,380
!أيّ نِزاع ينتهي بهذه السّلاسة؟

209
00:15:07,870 --> 00:15:12,550
إذا لم يكن يوكي عدوّاً، فهذا ينطبق
أيضاً على الفارس المُتبقّي

210
00:15:12,550 --> 00:15:14,960
،عندما أزلتُ تدخّلَه العقليّ

211
00:15:14,960 --> 00:15:19,850
كشفَ بأنّ الشّخص الّذي أراد
الثأر له كانت غليندا

212
00:15:20,160 --> 00:15:23,070
كان أحد حُكماء القتال الثّلاثة على ما يبدو

213
00:15:23,070 --> 00:15:25,430
،عندما حلّتْ غليندا مكانه

214
00:15:25,430 --> 00:15:28,190
يبدو أنّها سرقتْ قلبَه إلى جانب ذلك

215
00:15:28,190 --> 00:15:31,490
ليتك أخبرتني من قبل بأنّ
غليندا كانت لا تزال حيّة

216
00:15:31,490 --> 00:15:33,240
!أخبرتُك كثيراً

217
00:15:33,710 --> 00:15:36,910
وشُفيَتْ جروح يوكي

218
00:15:36,910 --> 00:15:41,010
يبدو أنّه يستطيع تشغيل مُضادّ
المهارات وتعطيله بنفسه

219
00:15:41,010 --> 00:15:44,270
.سبّبتُ كثيراً من المتاعب على ما يبدو
آسف بشأن ذلك

220
00:15:44,270 --> 00:15:45,920
!لكن أنقذتني

221
00:15:47,780 --> 00:15:49,510
هذا لا يُصدَّق حقّاً

222
00:15:54,120 --> 00:15:55,510
ريمورو-سان

223
00:15:55,990 --> 00:15:58,810
هلّا سمحت لي بتعقُّب ماريبيل؟

224
00:15:59,270 --> 00:16:00,780
هل يمكنك هزيمتها؟

225
00:16:00,780 --> 00:16:03,340
سيكون ذلك سهلاً ما دمتُ يقظاً

226
00:16:03,340 --> 00:16:06,620
فضلاً عن ذلك، تحكّمتْ بي بينما
كنتُ قد عطّلتُ مُضادّ المهارات

227
00:16:06,620 --> 00:16:09,570
كبريائي لن يسمح بمرور ذلك

228
00:16:09,570 --> 00:16:10,700
معك حقّ

229
00:16:11,460 --> 00:16:12,700
إنّها تُخطِّط غالباً

230
00:16:13,040 --> 00:16:16,260
بجعل مصدر القوّة في الطّابق الأدنى تهيج

231
00:16:16,260 --> 00:16:18,450
لتطالك عقب ذلك

232
00:16:18,810 --> 00:16:20,710
مصدر القوّة؟

233
00:16:20,710 --> 00:16:24,330
إذا خرجت القوّةُ عن السّيطرة، فسوف
يلتهم الانفجار أكثر من مُجرّد أطلال

234
00:16:24,930 --> 00:16:27,490
اسمح لي بمُرافقتك رجاء

235
00:16:27,490 --> 00:16:32,200
تعلّمتُ كلّ ما يمكن تعلُّمه حول
هذه الأطلال بعبور سوما

236
00:16:32,200 --> 00:16:35,800
،إذا حدث ما هو غير مُتوقَّع
فيمكنني إيقافه

237
00:16:36,590 --> 00:16:40,420
تعابير جادّة في وجه حسناء
...مثلها تُصيب الوتر الحسّاس

238
00:16:41,200 --> 00:16:43,560
حسناً إذاً. أعتمد عليكِ

239
00:16:44,640 --> 00:16:46,230
!شيون! غوبتا

240
00:16:46,230 --> 00:16:49,680
!قودا الآخرين في الانضمام للإيلف الظّلاميّين

241
00:16:49,680 --> 00:16:50,730
!حافظوا على سلامتهم

242
00:16:51,220 --> 00:16:52,250
!عُلِم

243
00:16:52,250 --> 00:16:53,650
إلى أين ستذهب؟

244
00:16:54,150 --> 00:16:56,410
!سأُساعد ميليم

245
00:17:03,400 --> 00:17:08,170
لا أستطيع القضاء على سيّد الشّياطين
ما لم أُباغته

246
00:17:08,750 --> 00:17:12,080
...إنّه سحرٌ خطيرٌ سيقضي عليّ معه

247
00:17:13,560 --> 00:17:16,680
!لكن لا يسعني التّفكير في ذلك بعد الآن

248
00:17:20,380 --> 00:17:21,430
ماذا؟

249
00:17:27,330 --> 00:17:28,840
لا يوجد شيء هنا؟

250
00:17:30,620 --> 00:17:31,990
هذا غير مُمكن

251
00:17:33,500 --> 00:17:34,940
ما الّذي يجري؟

252
00:17:37,740 --> 00:17:41,740
لا يوجد مفاعل طاقة يتمّ التحكُّم به
سحريّاً في هذه الأطلال

253
00:17:42,240 --> 00:17:45,750
وعلى ذِكر الأمر، لم يكن هناك
مفاعل في سوما أيضاً

254
00:17:47,520 --> 00:17:49,000
أهذا أنت يا يوكي؟

255
00:17:49,520 --> 00:17:52,000
أجل، بالتّأكيد

256
00:17:52,400 --> 00:17:55,590
ألم يكن من المُفترض أن تُقاتل
سيّدَ الشّياطين ريمورو؟

257
00:17:55,590 --> 00:17:56,840
انتهى ذلك

258
00:17:57,240 --> 00:18:00,880
،استخدمتُ كُلّ ما بحيلتي ضدّه
لكن كان ذلك عقيماً

259
00:18:00,880 --> 00:18:04,100
كنتُ سأقتله حالما بدا النّصر
وشيكاً جدّاً أيضاً

260
00:18:04,880 --> 00:18:07,520
جعلَني ذلك أقف على أعصابي حقّاً

261
00:18:07,520 --> 00:18:11,360
لكن أكثر ما أغاظَني هو فكرة أنّك خنتَنا حقّاً

262
00:18:12,230 --> 00:18:13,870
آسف بشأن ذلك

263
00:18:13,870 --> 00:18:17,360
ارتأيتُ بأنّ ذلك سيبدو أكثر واقعيّة
إذا كتمتُ ذلك سرّاً عنكم

264
00:18:18,110 --> 00:18:20,060
...هذا غير مُمكن

265
00:18:20,060 --> 00:18:22,210
لكن لا أستطيع نكران الأمر

266
00:18:22,730 --> 00:18:26,710
عدم تأثير الجشع على يوكي إطلاقاً
بات حقيقة الآن

267
00:18:28,540 --> 00:18:32,880
يوكي، هل تقصد بأنّك اخترقتَ قوّتي؟

268
00:18:33,280 --> 00:18:35,960
!كيف؟ منذ متى؟

269
00:18:35,960 --> 00:18:37,170
أتريدين أن تعرفي؟

270
00:18:37,170 --> 00:18:39,380
!أخبرني حالاً فحسب

271
00:18:39,800 --> 00:18:42,100
حسناً إذاً، سأُريكِ

272
00:18:44,790 --> 00:18:46,430
...هذا مُستحيل

273
00:18:46,430 --> 00:18:49,390
!أنت تكذب. لا بُدّ أنّك تكذب

274
00:18:52,290 --> 00:18:56,400
كنتَ تتظاهر فقط بأنّك خاضع
!لسيطرتي منذ البداية؟

275
00:18:57,480 --> 00:18:58,280
!أجل

276
00:18:58,860 --> 00:19:01,370
!الجواب هو: كان مُجرّد تمثيل

277
00:19:01,370 --> 00:19:03,830
ما رأيكِ؟ كان تمثيلي مُبهراً، صحيح؟

278
00:19:03,830 --> 00:19:04,980
!مُستحيل

279
00:19:04,980 --> 00:19:10,170
كلّما كان الجشع أعظم، قلّت
!قوّة مُقاومة صاحبه لي

280
00:19:10,170 --> 00:19:13,080
لا سيّما عندما يتعلّق الأمر
!بشخص جشع مثلك

281
00:19:13,080 --> 00:19:18,320
،مهارتي هي القوّة العظمى
!والمُتجذِّرة في العاطفة الّتي تُدعى جشع

282
00:19:18,320 --> 00:19:20,340
!لا يمكن هزيمتها

283
00:19:21,290 --> 00:19:22,720
صحيح

284
00:19:23,080 --> 00:19:27,020
،لكن بعد مجيئي إلى هذا العالم مُباشرة

285
00:19:27,020 --> 00:19:29,230
أنشأتُ مُضادّ المهارات

286
00:19:30,610 --> 00:19:32,230
أنشأت؟

287
00:19:32,570 --> 00:19:37,730
أجل، لإبطال كافّة الأشياء العدائيّة
المُوجَّهة نحوي

288
00:19:38,080 --> 00:19:41,220
لكن هذا لا يعني شيئاً حقّاً

289
00:19:41,220 --> 00:19:42,280
...فأساساً

290
00:19:42,880 --> 00:19:47,660
جشعي أعظم من جشعكِ بكثير

291
00:19:48,380 --> 00:19:53,490
،حتّى لو لم أكن أملك مُضادّ المهارات
جشعكِ لن ينجح معي

292
00:19:54,510 --> 00:19:57,380
هذا العالم هو ملعبي

293
00:20:06,620 --> 00:20:10,700
طموحي هو أن أُصبح ملِك هذا العالم

294
00:20:12,300 --> 00:20:16,400
...لا تستهن بي! أنا... ماريبيل

295
00:20:18,700 --> 00:20:21,120
!ماريبيل الجشع

296
00:20:22,160 --> 00:20:25,820
!وأنت لست ندّاً لي

297
00:20:26,260 --> 00:20:27,720
لا جدوى

298
00:20:28,220 --> 00:20:31,660
طموح ضئيل كهذا لن يخدمكِ في هزيمتي

299
00:20:34,480 --> 00:20:36,710
...هذا... مُستحيل

300
00:20:36,710 --> 00:20:38,710
...موجات الجشع

301
00:20:38,710 --> 00:20:40,840
...أنت... قوّتي

302
00:20:41,300 --> 00:20:42,590
أصبتِ

303
00:20:42,930 --> 00:20:45,770
...لا يمكنك... فعل ذلك

304
00:20:46,960 --> 00:20:48,060
بل يمكنني

305
00:20:48,780 --> 00:20:52,050
لأنّني أنقلها فقط إلى شخص أكثر قيمة

306
00:20:57,340 --> 00:21:02,000
،لو وُلِدتِ قبل ميلادكِ بعشر سنوات فقط

307
00:21:02,000 --> 00:21:04,870
لرُبّما حكمتِ العالم

308
00:21:10,600 --> 00:21:12,480
لم يُحالفكِ الحظُّ فحسب

309
00:21:12,970 --> 00:21:17,500
أنا واثق بأنّكِ لم تستطيعي إتقان
مهارتكِ بجسدٍ صغير كهذا

310
00:21:19,870 --> 00:21:21,500
ألا تستطيعين سماعي بعد الآن؟

311
00:21:28,630 --> 00:21:30,940
قلتِها بلسانكِ

312
00:21:31,430 --> 00:21:34,450
طموحي كبيرٌ جدّاً فحسب

313
00:21:42,370 --> 00:21:44,190
تُصبحين على خير يا ماريبيل

314
00:21:44,930 --> 00:21:48,660
اطمئنّي، سأحمل جشعكِ عنكِ

315
00:21:54,640 --> 00:21:57,460
،كانت ماريبيل قد عاشتْ في زمن مُضطرب

316
00:21:57,460 --> 00:22:00,690
لكن هكذا أنهتْ حياتها القصيرة
في هذا العالم

317
00:22:02,360 --> 00:22:05,060
:تبقى حقيقة هذا العالم

318
00:22:05,670 --> 00:22:08,390
أولئك الّذين لا يملكون قوّة
مُقدَّر لهم الخسارة

319
00:23:55,210 --> 00:23:58,100
"الحلقة القادمة، "صديق ميليم