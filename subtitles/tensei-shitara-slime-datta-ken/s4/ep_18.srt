1
00:00:01,230 --> 00:00:03,230
توقّعتُ أنّك هنا أيضاً

2
00:00:03,400 --> 00:00:08,060
روج... لا بل أعتقد بأنّك
غي كريمزن الآن

3
00:00:08,060 --> 00:00:11,400
لم أرك منذ وقت طويل يا نوار

4
00:00:11,830 --> 00:00:14,780
وما الّذي جاء بك إلى هنا؟ مللت فحسب؟

5
00:00:14,780 --> 00:00:17,910
على رسلِك، يا لها من طريقة
لإلقاء السّلام

6
00:00:17,910 --> 00:00:19,590
...الأهمّ

7
00:00:19,590 --> 00:00:23,580
كنتَ تعلم بأنّ تلك كانت نسخة بديلة
من جسد راين، ميست، أليس كذلك؟

8
00:00:23,970 --> 00:00:27,000
فلماذا نفّذتَ حركةً خطيرةً كهذه؟

9
00:00:27,240 --> 00:00:29,120
هل أنت جادّ؟

10
00:00:29,120 --> 00:00:33,260
كلانا نعلم بأنّ مُزاحاً كهذا ليس
كافياً للقضاء على أصليّ

11
00:00:33,260 --> 00:00:37,140
لكن كانت ضربة مُباشرة لتُخلِّف أثراً

12
00:00:37,140 --> 00:00:39,800
...حتّى أنا كنتُ لأُباد

13
00:00:39,800 --> 00:00:42,390
لو تلقّيتُ إصابة مُباشرة

14
00:00:54,210 --> 00:00:57,910
على أيّ حال، أظنُّك تطوّرت حقّاً، صحيح؟

15
00:00:57,910 --> 00:01:00,660
في الواقع، لماذا لم تفعلها قبلاً؟

16
00:01:00,660 --> 00:01:01,950
،غي

17
00:01:01,950 --> 00:01:05,410
هل يوجد شيء في هذا العالم أقوى منّا؟

18
00:01:05,410 --> 00:01:07,260
لا

19
00:01:07,260 --> 00:01:09,420
،رُبّما التّنانين الحقيقيّة على أقلّ تقدير

20
00:01:09,420 --> 00:01:11,790
لكنّهم أقرب إلى ظاهرة طبيعيّة

21
00:01:12,310 --> 00:01:15,300
بالفعل. نحن الأقوى

22
00:01:15,300 --> 00:01:21,550
لذا إذا تطوّرنا، تُصبح المعارك من طرف
واحد تماماً. أليس هذا مُملّاً؟

23
00:01:21,550 --> 00:01:23,550
أجل، أفهمك

24
00:01:23,550 --> 00:01:26,230
ومع ذلك تطوّرتَ على أيّ حال

25
00:01:26,230 --> 00:01:27,850
بسبب ذلك الهُلام؟

26
00:01:27,850 --> 00:01:29,440
اسمه هو ريمورو-ساما

27
00:01:30,970 --> 00:01:36,170
إذاً ريمورو هذا هو سبب تطوّرك؟

28
00:01:36,670 --> 00:01:38,530
أجل، هذا صحيح

29
00:01:38,810 --> 00:01:40,200
...لأنّني

30
00:01:40,200 --> 00:01:43,390
!مُنبهر بنموّ ريمورو-ساما

31
00:01:43,390 --> 00:01:46,250
!أن أدعوه "تطوُّر" لَهو مُبرَّر تماماً

32
00:01:46,250 --> 00:01:49,830
!إنّه ظريف، وروحه تفيض بالوقار

33
00:01:49,830 --> 00:01:51,820
هل سيستغرق هذا وقتاً؟

34
00:01:51,820 --> 00:01:52,510
بئساً

35
00:01:52,510 --> 00:01:53,460
!عفواً؟

36
00:01:54,300 --> 00:01:55,780
...على أيّ حال

37
00:01:55,780 --> 00:01:59,840
شُركاء ريمورو-ساما يستمرّون في النموّ
والتحسُّن يوماً بعد يوم كذلك

38
00:02:00,230 --> 00:02:04,100
حتّى أنا سأتخلّف عن الرّكب إن استهترت

39
00:02:04,420 --> 00:02:06,880
،لأنّني أعيش ظروفاً مُدهشة كهذه الآن

40
00:02:06,880 --> 00:02:10,320
فلا أملك سبباً لرسم حدود لنموّيّ

41
00:02:10,840 --> 00:02:15,380
...حقّاً؟ كنتَ في السّابق مُكافئاً لي حتّى

42
00:02:15,380 --> 00:02:17,120
!لكن يا للخسارة

43
00:02:17,120 --> 00:02:21,490
ثمّة شيء لن يُعجب هذا الفتى المدعو
ريمورو على وشك أن يحدث

44
00:02:23,000 --> 00:02:29,000
فبعض رجالي سيُسبّبون فوضى لرجاله
في الدُّول الغربيّة

45
00:02:30,160 --> 00:02:32,540
أنت تشعر بالملل فحسب

46
00:02:32,540 --> 00:02:34,380
ما هو هدفك؟

47
00:02:34,640 --> 00:02:38,740
أتعامل بقسوة مع البشر فحسب
لأنّني أستطيع ذلك

48
00:02:38,740 --> 00:02:39,630
ماذا؟

49
00:02:39,630 --> 00:02:43,420
،وبما أنّ ريمورو يحاول مُصادقة البشر

50
00:02:43,420 --> 00:02:45,690
فأشكُّ في أنّه سيتمكّن من تجاهُل هذا

51
00:02:46,690 --> 00:02:50,890
إذاً لا تشعر بإهانة إلّا عندما
يخصُّ الأمر ريمورو؟

52
00:02:52,030 --> 00:02:55,370
حسناً، قد لا نحتاج حتّى لفعل شيء

53
00:02:55,370 --> 00:02:58,400
فالبشر يبلون حسناً بإثارة
فوضى من تلقاء أنفسهم

54
00:03:01,380 --> 00:03:02,730
...إذا استمرَّ هذا

55
00:03:06,920 --> 00:03:10,990
!تبّاً... ما الّذي يفعله مارغريف شيدري؟

56
00:03:20,820 --> 00:03:22,840
لماذا يأتي الشّياطين إلى هنا؟

57
00:03:23,350 --> 00:03:25,100
!احموا الحاجزَ حتّى آخر لحظة

58
00:03:28,060 --> 00:03:30,480
!سيدخلون العاصمة على هذا المُعدَّل

59
00:03:30,480 --> 00:03:32,310
!أين التّعزيزات؟

60
00:03:32,310 --> 00:03:34,980
!يجب علينا حماية الحاجز مهما كلّف الأمر

61
00:03:35,630 --> 00:03:39,050
لا بُدَّ أنَّ الدُّول الغربيّة في فوضى الآن

62
00:03:39,730 --> 00:03:43,380
سيغرقون فيما يُشبه الجحيم قريباً

63
00:05:23,330 --> 00:05:24,240
لا تتأخّروا

64
00:05:24,240 --> 00:05:24,970
حاضر

65
00:05:29,300 --> 00:05:31,290
...لا أُصدِّق بأنّ هذا يحدث

66
00:05:31,290 --> 00:05:33,740
هل لدى أحدكم فكرة عمّا يمكننا فعله؟

67
00:05:33,740 --> 00:05:35,770
،يجب أن نتصرّف بسُرعة
!قبل أن يفوت الأوان

68
00:05:36,510 --> 00:05:39,900
حان الوقت. كُلّ شيء في مكانه

69
00:05:40,370 --> 00:05:44,030
،قد ينطفئ قدر عائلة روتزو
لكن ليس فخرها

70
00:05:44,030 --> 00:05:47,660
لأجل غرانفيلي-ساما، يجب أن أُكمل
!هذه المهمّة حتّى النّهاية

71
00:05:49,470 --> 00:05:51,910
!اصمتوا جميعاً

72
00:05:51,910 --> 00:05:57,420
ينبغي أن تكون أولويّتنا هي جمع
جيش تحالُف

73
00:05:57,790 --> 00:06:01,010
،قيل لي بأنّ مُفوَّضة ريمورو-ساما، تيستاروسّا

74
00:06:01,010 --> 00:06:03,170
عليمة بالشّؤون العسكريّة كذلك

75
00:06:03,570 --> 00:06:06,920
ينبغي ألّا يكون هناك اعتراض على
تعيينها مسؤولة عن جيش التّحالُف

76
00:06:07,390 --> 00:06:08,890
هل هذا حكيم بما يكفي؟

77
00:06:08,890 --> 00:06:11,510
هل تفهم حقّاً في الشّؤون العسكريّة؟

78
00:06:11,510 --> 00:06:13,260
لا تقلقوا

79
00:06:15,000 --> 00:06:18,780
نشرتُ بالفعل أتباعي في أرجاء البلاد

80
00:06:18,780 --> 00:06:19,400
موس

81
00:06:19,400 --> 00:06:20,450
حاضر

82
00:06:22,190 --> 00:06:23,860
فلتشهدوا

83
00:06:28,490 --> 00:06:31,370
وضعنا أتباع تيستاروسّا-ساما للتو

84
00:06:31,370 --> 00:06:33,940
حول الحاجز فوق العاصمة

85
00:06:35,240 --> 00:06:37,600
وأيضاً، تمّ إبلاغنا بأنّ

86
00:06:37,600 --> 00:06:41,330
الماغوس الخاصّون بساريون في
طريقهم إلى المناطق الحدوديّة

87
00:06:41,330 --> 00:06:44,040
الشّياطين الّتي تثور في ساحة المعركة الآن

88
00:06:44,040 --> 00:06:49,240
ليست شيئاً تستطيع قوّات شين ولا تلك
الإيلف الرّفيعة إبادته

89
00:06:50,260 --> 00:06:51,640
موس

90
00:06:51,640 --> 00:06:57,070
،لا يجدر بك أن تُسمّي الصّديقة العزيزة لريمورو-ساما
"الإمبراطورة إيلميشيا، بـ"تلك الإيلف الرّفيعة

91
00:06:57,740 --> 00:07:00,440
!أ-أعتذر بشدّة

92
00:07:00,440 --> 00:07:01,900
المُهمّ أنّك فهمت

93
00:07:02,500 --> 00:07:04,850
—بسرعة! صِلوا إلى الحاجز و

94
00:07:05,780 --> 00:07:07,690
سيّد يوهان روستيا

95
00:07:08,530 --> 00:07:10,580
ما-ما الأمر؟

96
00:07:10,580 --> 00:07:16,040
من كنتَ تُرسل له نداءً سحريّاً؟

97
00:07:16,040 --> 00:07:16,830
—ما

98
00:07:17,410 --> 00:07:20,860
لماذا أمرتهم بتدمير حاجز هذا البلد؟

99
00:07:21,470 --> 00:07:23,460
!ما معنى هذا يا يوهان؟

100
00:07:23,460 --> 00:07:25,170
!برِّر موقفك

101
00:07:42,370 --> 00:07:43,400
...الحاجز

102
00:07:48,440 --> 00:07:50,090
!لماذا فيرت هنا؟

103
00:07:50,090 --> 00:07:51,490
!ما الّذي يجري؟

104
00:07:51,810 --> 00:07:54,490
!يوهان! خنتنا؟

105
00:07:54,490 --> 00:07:56,280
خنتُكم؟

106
00:07:56,800 --> 00:07:58,890
،كنتُم أنتم من خان روتزو

107
00:07:58,890 --> 00:08:00,690
،الّذين بذلوا قصارى جهدهم لأجل البشريّة

108
00:08:00,690 --> 00:08:03,080
!بالإذعان بِطَيش لدولة وحوش

109
00:08:04,460 --> 00:08:06,350
!حان وقت تسديد الحساب

110
00:08:07,300 --> 00:08:10,150
هذا المجلس الّذي تغنّى بهدفه
وهو خدمة حماية البشريّة

111
00:08:10,150 --> 00:08:12,970
!هو مكانٌ مُلائم لثوَران الجحيم

112
00:08:13,240 --> 00:08:17,970
غيرارد، حان الوقت الآن لتُحقّق
أنت ورجالك طموحاتكم

113
00:08:18,370 --> 00:08:19,850
أشكرك على تعاونك

114
00:08:22,350 --> 00:08:24,670
!أستدعي هاهنا إلَهتنا

115
00:08:24,670 --> 00:08:28,480
سيُدمَّر كُلُّ شيء، وسيغرق
!العالم في فوضى الحرب

116
00:08:28,480 --> 00:08:29,980
!أجل

117
00:08:32,430 --> 00:08:33,070
!آين

118
00:08:33,070 --> 00:08:35,330
أجل، أعمل على ذلك

119
00:08:35,330 --> 00:08:37,350
!هذا هو وقتنا

120
00:08:37,350 --> 00:08:39,700
،يا أيّتها الإلَهة الخضراء في منبعنا

121
00:08:42,590 --> 00:08:47,670
!تجلِّي أمامي بقوّة الدّمار الّتي أرغبها

122
00:09:04,440 --> 00:09:06,290
...ميزيري-ساما

123
00:09:06,290 --> 00:09:10,880
!إلَهتنا وشيطانتنا الأصليّة، ميزيري-ساما

124
00:09:10,880 --> 00:09:12,690
!هل قلتَ "أصليّة"؟

125
00:09:16,130 --> 00:09:17,340
...هذا

126
00:09:18,370 --> 00:09:20,440
...وفي وقت كهذا

127
00:09:20,440 --> 00:09:22,080
!كم هذا مثاليّ

128
00:09:22,080 --> 00:09:24,210
!يا أيّتها الإلَهة

129
00:09:24,210 --> 00:09:26,740
!نهِبُكِ شعب هذه الدّولة بالكامل

130
00:09:26,740 --> 00:09:29,090
!اسمحي لنا بالرّكوع بين قدميكِ

131
00:09:29,460 --> 00:09:31,760
أتممتُ واجبي الأخير

132
00:09:31,760 --> 00:09:34,930
والآن سأتمكّن من الوقوف
أمام غرانفيلي-ساما

133
00:09:35,410 --> 00:09:39,030
قد تكون مملكة روستيا مُطوَّقة
،بواسطة ألسنة نيران الحرب

134
00:09:39,030 --> 00:09:41,600
لكن أستطيع الاعتذار منهم جميعاً
في الحياة الأُخرى

135
00:09:41,600 --> 00:09:43,250
!آنسة تيستاروسّا

136
00:09:43,250 --> 00:09:45,130
!ستُباد هذه الدّولة

137
00:09:45,130 --> 00:09:47,390
!من فضلكِ أبلغي ريمورو-ساما حالاً

138
00:09:47,820 --> 00:09:49,610
لا، لا يا حضرة الرّئيس

139
00:09:49,610 --> 00:09:51,650
أنا هنا، أليس كذلك؟

140
00:09:52,460 --> 00:09:54,540
ماذا تقصدين؟

141
00:09:54,540 --> 00:09:58,660
أقصد بأنَّه سيتمّ تولِّي كُلّ شيء

142
00:09:59,340 --> 00:10:03,370
بلان؟ لماذا تُخفين ظهوركِ
للاختباء بين البشر؟

143
00:10:03,370 --> 00:10:04,080
...لحظة

144
00:10:05,080 --> 00:10:06,370
تجسّدتِ؟

145
00:10:06,900 --> 00:10:09,520
بلان، لماذا؟

146
00:10:09,520 --> 00:10:12,000
يُحزنني سماع هذا الاسم

147
00:10:12,290 --> 00:10:17,010
.تلقّيتُ اسماً رائعاً: تيستاروسّا
هذا ما أعتمده الآن

148
00:10:17,010 --> 00:10:18,590
اسم؟

149
00:10:18,590 --> 00:10:24,350
لذا يؤسفني قول هذا بعد قطعك
...كلّ هذه المسافة لإلقاء السّلام

150
00:10:24,730 --> 00:10:26,350
،لكن إذا اعترضتِ طريقي

151
00:10:26,350 --> 00:10:31,230
فسأمنحكِ هديّة نوم لألف عام يا ميزيري

152
00:10:35,480 --> 00:10:37,500
...لكن تواجدتْ بيضاء هنا

153
00:10:38,540 --> 00:10:41,750
لا مكسب لي من مُقاتلتها الآن

154
00:10:41,750 --> 00:10:43,480
...أولويّتي هي

155
00:10:44,130 --> 00:10:47,000
لن أدعكِ تستفزّينني يا تيستاروسّا

156
00:10:47,380 --> 00:10:50,200
لستِ مَن أتيتُ لأجله

157
00:10:50,200 --> 00:10:52,610
!كم هذا مُملّ

158
00:10:52,610 --> 00:10:56,670
تريدين الإبلاغ عنّا لروج في أسرع
وقت مُمكن، أليس كذلك؟

159
00:10:57,880 --> 00:11:02,410
على أيّ حال، أليس من الرّائع
أن يكون لديك سيّد؟

160
00:11:02,410 --> 00:11:05,390
أتفهّم شعوركِ الآن

161
00:11:05,390 --> 00:11:10,850
إذاً لا بُدّ أنّكِ تعلمين بأنّ كُلّ ما يهمّني
هو أن أكون مُفيدة لغي-ساما

162
00:11:12,990 --> 00:11:16,210
من الأفضل لكِ أن تعتادي على
هذا الجسد بسرعة

163
00:11:16,210 --> 00:11:19,400
لن أقبل ذلك عذراً عندما تخسرين

164
00:11:21,220 --> 00:11:24,990
غادرتْ... هل نحن بأمان الآن؟

165
00:11:24,990 --> 00:11:28,410
غادرت الإلَهة؟ لكن لماذا؟

166
00:11:28,410 --> 00:11:32,040
وبلان... كما في الأصليّين؟

167
00:11:32,040 --> 00:11:34,250
!لا، هذا غير مُمكن

168
00:11:35,170 --> 00:11:39,090
!حسناً، بهذا أُزيح أكبر خطر من أمامنا

169
00:11:39,820 --> 00:11:41,660
!لا أُصدِّق ذلك

170
00:11:41,660 --> 00:11:43,840
!أرفُض تصديق ذلك

171
00:11:54,270 --> 00:11:56,190
...ما-ما الّذي

172
00:11:58,360 --> 00:12:00,150
لا للقتل الآن

173
00:12:00,530 --> 00:12:03,160
هذا ينطبق على يوهان أيضاً

174
00:12:03,160 --> 00:12:06,430
—لكن هؤلاء الأشخاص كانوا وقحين معي

175
00:12:07,800 --> 00:12:11,040
موس، هل ستدعني أكرِّر كلامي؟

176
00:12:11,310 --> 00:12:13,050
!قطعاً لا

177
00:12:13,050 --> 00:12:16,790
كانت غطرسة منّي أن أحاول
!فرض رأيي عليكِ

178
00:12:17,170 --> 00:12:20,590
إن كنت قد فهمت، فسأدعك
تفلت هذه المرّة

179
00:12:20,590 --> 00:12:24,180
!يا لي من شخص سمِح

180
00:12:24,910 --> 00:12:30,890
أنتِ حقّاً... الأصليّة... بلان؟

181
00:12:33,130 --> 00:12:36,170
هـ-هل ارتكبتُ خطأ؟

182
00:12:36,690 --> 00:12:40,690
أجل، فشلتَ في إنجاز شيء

183
00:12:41,570 --> 00:12:44,530
!كان لينجح الأمر لولاكِ

184
00:12:44,530 --> 00:12:45,880
!أفلتاني

185
00:12:45,880 --> 00:12:48,400
!لن تتحمّل مملكتي هذه الوقاحة

186
00:12:48,400 --> 00:12:50,120
!ستتسبّبين بوقوع حادثة دُوليّة

187
00:12:50,410 --> 00:12:53,890
ماذا؟ هل نسيتَ القانون الدُّوليّ؟

188
00:12:54,500 --> 00:12:59,410
تعريض وجود دولة لخطر، جريمة التّخريب

189
00:12:59,410 --> 00:13:02,170
،واستخدام القوّة العسكريّة لدولة أُخرى

190
00:13:02,170 --> 00:13:04,490
جريمة التّحريض على اعتداء خارجيّ

191
00:13:04,490 --> 00:13:10,580
بالنّسبة للمجلس، هذا العصيان
الّذي يرتكبه يوهان روستيا

192
00:13:10,580 --> 00:13:14,270
يُخضعه لسلطة محكمة مملكة إنغراشيا

193
00:13:14,270 --> 00:13:16,950
،لا تهمّ قوانين بلدك الأُمّ

194
00:13:16,950 --> 00:13:20,770
الأولويّة دوماً للقانون الدّوليّ مع الأسف

195
00:13:22,170 --> 00:13:23,780
!كم هذا مُطمئن

196
00:13:25,200 --> 00:13:30,250
ساعدتَني في النّجاح في أسر
قلوب الجميع في المجلس

197
00:13:30,250 --> 00:13:31,200
شكراً لك

198
00:13:31,200 --> 00:13:32,450
!اللّعنة

199
00:13:32,450 --> 00:13:35,910
!أيّتها الشّيطانة اللّعينة
!فلتذهبي إلى الجحيم

200
00:13:35,910 --> 00:13:38,820
البُكاء والصُّراخ لن ينفعانك

201
00:13:36,950 --> 00:13:38,820
!أيّتها الشّيطانة اللّعينة! تبّاً لكِ

202
00:13:38,820 --> 00:13:41,360
يجب أن تدفع ثمن جرائمك

203
00:13:41,360 --> 00:13:43,670
آنسة تيستاروسّا! هل تأذّيتِ؟

204
00:13:44,020 --> 00:13:45,550
أنا بخير تماماً

205
00:13:45,550 --> 00:13:48,800
لكن لم أتوقّع حدوث كُلّ هذا

206
00:13:48,800 --> 00:13:50,850
معكِ حقّ

207
00:13:50,850 --> 00:13:54,390
لا أستطيع أن أتخيّل ما الّذي كان ليحدث
لو لم تكوني هنا

208
00:13:54,390 --> 00:13:56,560
!يعجز لساني عن شكركِ

209
00:13:57,230 --> 00:13:59,330
لا حاجة للشّكر

210
00:13:59,330 --> 00:14:00,900
فحماية دُولنا الأعضاء

211
00:14:00,900 --> 00:14:04,320
هو واجب ثمين ائتمنَني عليه ريمورو-ساما

212
00:14:04,320 --> 00:14:09,070
!لا يوجد خطر يُهدِّد تيمبيست

213
00:14:20,250 --> 00:14:21,210
غي-ساما

214
00:14:22,680 --> 00:14:25,080
ماذا؟! ماذا تقولين؟

215
00:14:25,080 --> 00:14:28,060
تجلّتْ بلان ولديها اسم حتّى؟

216
00:14:28,060 --> 00:14:30,220
كنتَ تعلم هذا، أليس كذلك؟

217
00:14:30,220 --> 00:14:31,950
بالطّبع

218
00:14:31,950 --> 00:14:34,630
يسير كُلّ شيء وفق خطّة ريمورو-ساما

219
00:14:34,630 --> 00:14:38,730
هذا يعني بأنّك من بين الأشخاص
الّذين تمّ استغلالهم يا غي

220
00:14:39,080 --> 00:14:41,310
أحقّاً ذلك؟

221
00:14:41,310 --> 00:14:45,140
لكن إذا خرجتْ من ذلك الطّريق
،المسدود ثُلاثي العُقَد

222
00:14:45,140 --> 00:14:47,200
فماذا حدث للأُخرَتين؟

223
00:14:47,200 --> 00:14:49,150
تقصد أولتيما وكاريرا؟

224
00:14:49,150 --> 00:14:49,880
ماذا؟

225
00:14:50,960 --> 00:14:54,330
كان ريمورو-ساما قد وفّرَ لهما أعمالاً أُخرى

226
00:14:54,330 --> 00:14:56,760
—وكانتا مسرورتين للغاية ورحّبتا

227
00:14:56,760 --> 00:14:58,870
!مهلاً! انتظر لحظة فحسب

228
00:14:58,870 --> 00:15:01,080
...هل أولتيما وكاريرا

229
00:15:01,390 --> 00:15:04,350
أجل. فيوليت وجونو

230
00:15:04,350 --> 00:15:07,490
والشّخص الّذي منح اسماً
...لهُنّ هُنّ الثّلاثة كان

231
00:15:07,490 --> 00:15:09,680
ريمورو-ساما بالطّبع

232
00:15:10,370 --> 00:15:12,320
ما الّذي يجري بالطّبع؟

233
00:15:12,320 --> 00:15:16,480
لا يوجد سيّد شياطين عاديّ قويّ
بما يكفي لتسمية أصليّ

234
00:15:16,480 --> 00:15:21,110
!والأصليّون لا يُطيعون أحداً لا يعترفون بموهبته

235
00:15:21,110 --> 00:15:23,940
رغم أنّني كنتُ أنا من جنّدهن

236
00:15:23,940 --> 00:15:25,940
!أنت من يقف وراء هذا؟

237
00:15:25,940 --> 00:15:29,400
،منحتُهن شرف خدمة ريمورو-ساما

238
00:15:29,400 --> 00:15:34,320
ومع ذلك كُنّ جميعاً وقِحات عندما
التقينَ به لأوّل مرّة

239
00:15:34,320 --> 00:15:36,840
لا أُخفيك بأنّني فكّرتُ في قتلهن

240
00:15:35,600 --> 00:15:40,080
نوار غريب أطوار، لذا لا أستغرب قراره
،بخدمة شخص عن نزوة

241
00:15:36,840 --> 00:15:39,620
لكن أولئك الثّلاثة لسنَ غبيّات

242
00:15:39,620 --> 00:15:42,120
لكن سرعانَ ما أدركنَ حماقتهن

243
00:15:40,080 --> 00:15:43,460
لكن فيوليت وجونو؟ هذا ليس طريفاً

244
00:15:42,120 --> 00:15:43,460
هذا ما ينبغي لهُن فعله

245
00:15:43,460 --> 00:15:47,930
بدا ريمورو-ساما جليلاً بينما كان
يُسمّيهن. كان يتألّق كإله

246
00:15:44,160 --> 00:15:48,680
وبلان، الأكثر فخراً بين الأصليّين؟

247
00:15:47,930 --> 00:15:52,700
مظهره المعتاد ظريف، لكن روحه
تفيض بالوقار

248
00:15:49,220 --> 00:15:52,700
ما الّذي يفكِّر فيه الفتى ريمورو هذا بالضّبط؟

249
00:15:52,700 --> 00:15:55,010
!وذكاؤه لا نظير له

250
00:15:53,260 --> 00:15:56,600
بئساً. أعتقد سيترتّب عليّ
التكلُّم معه شخصيّاً

251
00:15:55,010 --> 00:15:58,430
وصوته! يمكنك الشُّعور بالحُبّ
—بكُلّ كلمة يقـ

252
00:15:56,600 --> 00:15:58,430
حسناً إذاً

253
00:15:58,430 --> 00:16:01,190
سأذهب لزيارة ريمورو في وقت قريب

254
00:16:01,190 --> 00:16:02,200
ماذا؟

255
00:16:02,200 --> 00:16:04,770
حبّذا ألّا تفعل. سيخلق ذلك
مزيداً من المتاعب

256
00:16:05,730 --> 00:16:07,640
...هذا الوضيع

257
00:16:08,220 --> 00:16:09,530
...اسمع يا رجل

258
00:16:09,970 --> 00:16:14,650
سمعتُ إشاعات كيف أنّ الأراضي
الّتي تحت سيطرته تزدهر

259
00:16:14,650 --> 00:16:17,010
أريد أن أذهب وأتحقّق بنفسي فحسب

260
00:16:17,010 --> 00:16:18,790
هل فهمت يا ديابلو؟

261
00:16:19,900 --> 00:16:21,540
حسناً إذاً

262
00:16:21,540 --> 00:16:24,070
،إذا كانت هذه هي رغبتك
فأُرحِّب بذهابك

263
00:16:24,070 --> 00:16:26,680
أنا متأكّدٌ بأنّ ريمورو-ساما سيكون مسروراً

264
00:16:26,680 --> 00:16:30,710
،حسناً إذاً. بما أنّكم ستكونون هناك
فسوف أذهب

265
00:16:30,710 --> 00:16:33,510
،بالطّبع. مهما كان قد يحدث هنا

266
00:16:33,510 --> 00:16:35,680
سيتولّى ريمورو-ساما أمره

267
00:16:35,680 --> 00:16:38,810
حقّاً؟ حسناً، بلّغه تحيّاتي

268
00:16:39,140 --> 00:16:40,080
حسناً

269
00:16:40,080 --> 00:16:41,560
إلى اللِّقاء إذاً

270
00:16:45,890 --> 00:16:48,450
أظنّني تجاوزتُ ذلك

271
00:16:48,450 --> 00:16:50,610
،لو اعترضَ غي طريقنا الآن

272
00:16:50,610 --> 00:16:53,590
فلا أحد يعلم كيف ستتغيّر الأمور

273
00:16:55,820 --> 00:16:59,410
حتّى أنا كنتُ لأُعاني ضدّ غي
في نهاية المطاف

274
00:16:59,410 --> 00:17:02,110
ما زلتُ بحاجة لأصبح أقوى بكثير

275
00:17:03,020 --> 00:17:06,290
ريمورو-ساما، يا له من تخطيط ذكيّ

276
00:17:06,960 --> 00:17:11,550
من الواضح أنّك أرسلتَني إلى هنا لأنّك
تنبّأتَ بتبدُّل الأحداث هذا

277
00:17:12,090 --> 00:17:15,800
يمتلك ريمورو-ساما كُلّ شيء
في راحة يده

278
00:17:16,090 --> 00:17:20,810
يجب علينا جمع قوّة أكبر وذلك كي نتمكّن
من الارتقاء لتوقُّعاته

279
00:17:22,260 --> 00:17:23,560
...ريمورو-ساما

280
00:17:24,110 --> 00:17:27,930
أنا متأكّدة بأنّ أشياء فظيعة تحدث
في لوبيليوس كذلك

281
00:17:27,930 --> 00:17:30,320
الرّجاء اسمح لنا بتولِّي الأمور هنا

282
00:17:30,320 --> 00:17:34,710
وركّز على معركتك دون تحفُّظات

283
00:17:42,510 --> 00:17:44,870
إنّهم ضُعفاء جدّاً بالنّسبة لكونهم
قادمين من عالم آخر

284
00:17:45,200 --> 00:17:49,000
هل أفلتَ هؤلاء عليّ لكسب الوقت فقط؟

285
00:17:49,000 --> 00:17:52,700
ما يعني بأنّ الثّأر لماريبيل ليس هدفه؟

286
00:17:53,890 --> 00:17:56,070
إذاً ما غاية غرانفيلي؟

287
00:17:59,580 --> 00:18:01,100
...لماذا ليون

288
00:18:01,990 --> 00:18:05,730
وصلتَ أخيراً يا سيّد الشّياطين ليون

289
00:18:07,040 --> 00:18:10,210
تتكلّم وكأنّك تعرفني. من تكون؟

290
00:18:10,210 --> 00:18:12,980
أعتقد هذه هي أوّل مرّة
نلتقي فيها شخصيّاً

291
00:18:12,980 --> 00:18:15,990
أعتذر لاقتطاعي من وقتك
للمجيء إلى هنا

292
00:18:15,990 --> 00:18:19,080
—عمّاذا تتكلّم؟ أتيتُ إلى هنا كي

293
00:18:19,080 --> 00:18:23,570
الأطفال الّذين أظهرتَ لهم مثل هذا
الولَع من خلال أولئك التُجَّار

294
00:18:23,570 --> 00:18:26,000
هم أطفال جمعتُهم معاً

295
00:18:27,750 --> 00:18:31,950
استخدمتُ التقنيّةَ الّتي تعلّمتُها
منك لاستدعاء أطفال

296
00:18:31,950 --> 00:18:34,630
وبيعهم كبِضاعة

297
00:18:35,060 --> 00:18:38,240
فعلتَها كي تتمكّن من الحصول على
مزيد من العنصريّين، صحيح؟

298
00:18:38,240 --> 00:18:41,430
مُحاربين أقوى مثل شيزوي إيزاوا؟

299
00:18:42,260 --> 00:18:43,280
ماذا؟

300
00:18:43,280 --> 00:18:44,120
إشعار

301
00:18:44,120 --> 00:18:47,030
أنت في خطر. الشّخص المدعو
غرانفيلي روتزو

302
00:18:47,030 --> 00:18:50,520
يحاول إشعال فتنة بينك وبين
ليون من خلال الخِداع

303
00:18:50,520 --> 00:18:52,710
أجل، أعلم

304
00:18:52,710 --> 00:18:57,820
هل يمكنك أن تُخمِّن كم مرّةً فشلتُ
قبل استدعاء الشّخص الّذي أردتَه؟

305
00:18:58,140 --> 00:19:01,070
أولئك الأشخاص هناك هُم النّتيجة

306
00:19:02,200 --> 00:19:03,210
إشعار

307
00:19:03,210 --> 00:19:05,020
هذا تحريضٌ واضح

308
00:19:05,020 --> 00:19:07,330
...أعلم... لكن

309
00:19:07,330 --> 00:19:08,610
!أنت

310
00:19:09,380 --> 00:19:11,410
!أهذا صحيح حقّاً؟

311
00:19:11,410 --> 00:19:13,100
بكلّ تأكيد

312
00:19:13,100 --> 00:19:17,800
نحن التُجَّار نُقدِّم أيّ شيء كبِضاعة
إن كانت هناك طلبات عليها

313
00:19:17,800 --> 00:19:19,300
!أنا لا أتكلّم معك

314
00:19:20,780 --> 00:19:25,120
استدعيتَ أطفالاً آخرين، ليس شيزو-سان فقط؟

315
00:19:25,660 --> 00:19:26,350
أجل

316
00:19:26,350 --> 00:19:28,970
هل فعلتَ ذلك وأنت على علم بأنّ
الأطفال الّذين يُجلَبون إلى هنا

317
00:19:28,970 --> 00:19:31,350
!من خلال استدعاء ناقص لا يعيشون طويلاً؟

318
00:19:31,350 --> 00:19:32,020
—هذا

319
00:19:32,020 --> 00:19:34,110
لن أدعك تدّعي بأنّك لم تكن تعلم ذلك

320
00:19:34,630 --> 00:19:39,740
طلبُك كان أطفالاً من عالم آخر
دون سنّ العاشرة

321
00:19:39,740 --> 00:19:45,380
أنا واثق بأنّك أردتَ الاحتفاظ بالاستدعاء
النّاقص كي تتمكّن من استخدامهم كأسلحة

322
00:19:46,240 --> 00:19:50,140
لهذا السّبب شعرتُ بأرواح داخل
...أتباع ليون الّذين كانوا في الخارج

323
00:19:51,250 --> 00:19:52,320
إشعار

324
00:19:52,320 --> 00:19:53,500
هذا فخّ

325
00:19:53,500 --> 00:19:59,450
ما زلتُ أجري طقوسَ استدعاء حول
العالم في هذه اللّحظة

326
00:20:00,600 --> 00:20:03,680
هل... كُلّ هذا صحيح؟

327
00:20:03,680 --> 00:20:06,520
—أجل، لكن لديّ سبب لـ

328
00:20:06,520 --> 00:20:08,060
!اصمت

329
00:20:08,060 --> 00:20:11,480
!كنتَ من يقف وراء كُلّ هذا إذاً؟

330
00:20:19,820 --> 00:20:22,950
كان ينبغي أن أعلم

331
00:20:22,950 --> 00:20:25,800
،بدا هادئاً وقاسياً في البداية

332
00:20:25,800 --> 00:20:27,580
لكنّه ليس كذلك ضمنيّاً

333
00:20:27,960 --> 00:20:30,950
،عندما وضع إيفريت بداخل شيزو-سان

334
00:20:30,950 --> 00:20:32,960
،عندما درّبَها لتُصبح قويّة

335
00:20:33,400 --> 00:20:35,210
...عندما تركَنا في القلعة

336
00:20:35,880 --> 00:20:38,340
...كان كُلّ ذلك طريقته في

337
00:20:39,960 --> 00:20:42,710
كان هناك شيء أردتُ اكتشافه منه

338
00:20:45,120 --> 00:20:47,970
كنتُ قادراً أخيراً على الوفاء

339
00:20:47,970 --> 00:20:51,910
بوعدي الأخير لنقل مشاعر
شيزو-سان إليه

340
00:20:59,720 --> 00:21:01,800
ليون ليس عدوّي

341
00:21:01,800 --> 00:21:07,990
لكن لماذا استدعاه غرانفيلي إلى هنا
وحاول جعله يُقاتلني؟

342
00:21:07,990 --> 00:21:09,150
إشعار

343
00:21:09,150 --> 00:21:12,390
لا توجد معلومات كافية لتحديد هدف

344
00:21:12,390 --> 00:21:14,370
الشّخص المدعو غرانفيلي روتزو

345
00:21:15,000 --> 00:21:16,370
...في هذه الحالة

346
00:21:16,660 --> 00:21:18,120
هل رضيت؟

347
00:21:18,120 --> 00:21:19,560
لا، ليس بعد

348
00:21:19,560 --> 00:21:23,380
،نقلتُ مشاعرَ شيزو-سان إليك
لكن ليس مشاعري

349
00:21:23,960 --> 00:21:26,130
آمل أن يُسايرني فحسب

350
00:21:27,660 --> 00:21:30,640
ما رأيك أن "نُعالج الأمور بالحوار"؟

351
00:21:30,930 --> 00:21:32,310
هكذا إذاً

352
00:21:32,310 --> 00:21:36,040
بحسب تصرُّفاته، ريمورو بريء بالفعل

353
00:21:36,040 --> 00:21:38,510
غرانفيلي هو من يقف وراء كُلّ هذا

354
00:21:38,510 --> 00:21:39,580
...في هذه الحالة

355
00:21:48,680 --> 00:21:50,870
يبدو أنّه فهمَ الفكرة

356
00:21:51,450 --> 00:21:55,620
،كانت شجاعة منه أن يثق بي أنا
الرّجل الّذي لا يعرف عنه شيئاً

357
00:21:56,210 --> 00:21:57,620
هل نفعل؟

358
00:22:01,170 --> 00:22:03,880
إنّه يتظاهر بوقوعه في فخّ غرانفيلي

359
00:22:03,880 --> 00:22:06,380
!سأكتشف هدفَه لاحقاً

360
00:22:08,090 --> 00:22:12,390
حالما أعرف ذلك، ينبغي أن أتمكّن
!من التفوُّق على غرانفيلي

361
00:22:12,890 --> 00:22:16,820
لكن... لماذا أشعر وكأنّه يفوتني شيء؟

362
00:22:21,360 --> 00:22:24,610
ما هو هدف غرانفيلي بالضّبط؟

363
00:23:55,750 --> 00:23:58,360
"الحلقة القادمة، "موت وخسران