1
00:00:00,520 --> 00:00:03,980
!ابتداء من اليوم، سأُعرَف بالبطلة كرونوا

2
00:00:06,750 --> 00:00:07,740
ما هذا؟

3
00:00:12,380 --> 00:00:14,530
...مهارتي الفريدة للتو

4
00:00:15,530 --> 00:00:17,170
كرونوا

5
00:00:17,170 --> 00:00:18,500
اسم جميل

6
00:00:18,500 --> 00:00:19,740
!أجل

7
00:00:24,190 --> 00:00:26,120
وداعاً إذاً يا كرونوا

8
00:00:26,120 --> 00:00:28,400
تعالي وزوريني في أيّ وقت

9
00:00:28,400 --> 00:00:30,230
شكراً يا لوميناس

10
00:00:30,230 --> 00:00:34,040
،في المرّة المُقبلة الّتي يهيج فيها فيلدورا
سأفعل شيئاً حيال الأمر

11
00:00:34,040 --> 00:00:36,760
ماذا؟ ستُواجهين تلك السّحليّة البغيضة؟

12
00:00:37,290 --> 00:00:40,140
أجل. هذا ما سيحدث في المُستقبل

13
00:00:42,360 --> 00:00:45,900
فهمت. إذاً ذلك المُستقبل محتوم

14
00:00:46,390 --> 00:00:47,190
أجل

15
00:00:54,070 --> 00:00:55,420
هل من مُشكلة؟

16
00:00:55,420 --> 00:00:57,440
،"عندما تبنّيتِ اسم "كرونوا

17
00:00:57,440 --> 00:00:59,720
مهارة المُنتزِع خاصّتي اختفت

18
00:01:00,210 --> 00:01:03,850
،هذا... لا أفهم المنطِق وراء ذلك حقّاً

19
00:01:03,850 --> 00:01:08,750
لكن قِواكِ دائماً ما تندمج معي في النّهاية

20
00:01:09,360 --> 00:01:13,040
ما يعني... بأنّني سأختفي هنا
في نهاية المطاف؟

21
00:01:14,990 --> 00:01:16,260
حسناً، لا مُشكلة

22
00:01:16,730 --> 00:01:19,990
لكن أخذ قِوى من الآخرين من خلال التّسمية؟

23
00:01:19,990 --> 00:01:23,000
أنتِ وحشٌ فعلاً، أليس كذلك يا كرونوا؟

24
00:01:23,000 --> 00:01:24,180
!مهلاً

25
00:01:24,180 --> 00:01:27,450
!لديكِ لِسان سليط جدّاً

26
00:01:27,450 --> 00:01:30,410
!لن يحبّكِ أحدٌ هكذا، رغم جمالكِ

27
00:01:30,410 --> 00:01:33,230
هذا لا يهمّ. فأنا ميّتة بالفعل

28
00:01:35,790 --> 00:01:37,930
حسناً، هل أنتِ جاهزة للانطلاق يا هيناتا؟

29
00:01:37,930 --> 00:01:40,540
أجل، هيّا بنا يا كلوي

30
00:01:49,820 --> 00:01:51,130
!بسرعة! من هنا

31
00:01:51,130 --> 00:01:52,640
!اهربوا! بسرعة

32
00:02:04,740 --> 00:02:06,950
!كلوي، أنتِ تتقدّمين بسرعة أكبر من اللّازم

33
00:02:06,950 --> 00:02:08,020
!اخترقي من الجوانب

34
00:02:08,020 --> 00:02:10,560
!لكن سيكون الأوان قد فات كثيراً

35
00:02:26,660 --> 00:02:28,660
هل نجونا؟

36
00:02:28,660 --> 00:02:29,500
...البطلة

37
00:02:29,920 --> 00:02:31,190
!إنّها البطلة

38
00:02:31,190 --> 00:02:33,730
!شكراً لكِ أيّتها البطلة

39
00:02:33,730 --> 00:02:34,730
...المعذرة

40
00:02:35,700 --> 00:02:37,720
هلّا عرفتُ اسمكِ؟

41
00:02:38,220 --> 00:02:41,020
أنا كرونوا البطلة

42
00:02:45,000 --> 00:02:48,360
...كرونوا البطلة

43
00:02:50,560 --> 00:02:57,320
كلوي وأنا سافرنا حول الأقاليم لنُنقذ
النّاس النّاس بصِفة كرونوا البطلة

44
00:03:02,820 --> 00:03:07,750
وبعض النّاس طلبوا منّا العيش بينهم
،أو حتّى حكمهم

45
00:03:08,650 --> 00:03:11,120
لكن استأنفنا رحلتنا

46
00:03:26,460 --> 00:03:27,470
...ثمّ

47
00:03:30,610 --> 00:03:33,770
...بعد مئة عام من بدئنا السّفر

48
00:03:35,770 --> 00:03:38,280
!من أنتِ بالضّبط؟

49
00:03:40,190 --> 00:03:43,200
التّقطيع المُطلَق طاغٍ حقّاً

50
00:03:43,200 --> 00:03:46,330
إلى أيّ درجة ستُصبح هذه الفتاة قويّة؟

51
00:03:46,330 --> 00:03:48,150
هيناتا، هل تريدين التّجربة؟

52
00:03:49,280 --> 00:03:53,810
،أعتقد بأنّني إذا منحتُكِ السّيطرة
فسيطفو وعيكِ على السّطح

53
00:03:53,810 --> 00:03:57,630
بصراحة، أتمنّى ذلك، لكن هل ستكونين بخير؟

54
00:03:59,130 --> 00:03:59,820
أجل

55
00:04:02,150 --> 00:04:04,140
أعتقد عليّ أن أعتاد على ذلك

56
00:04:04,550 --> 00:04:06,390
ماذا؟ هل قلتِ شيئاً؟

57
00:04:06,710 --> 00:04:07,570
لا

58
00:04:08,060 --> 00:04:11,410
هيّا، لنُبلغ النّاس في أسفل الجبل

59
00:04:11,410 --> 00:04:13,330
علينا إعادة كنزهم

60
00:04:26,210 --> 00:04:27,540
لا تمتعض منّي

61
00:04:28,170 --> 00:04:32,420
ما كان هذا ليحدث لو لم تطلب قُرباناً

62
00:04:32,420 --> 00:04:36,300
!مُذهل! يا هيناتا! أتقنتِ جسَدي تماماً

63
00:04:36,300 --> 00:04:38,880
جسدكِ مُذهل

64
00:04:38,880 --> 00:04:42,030
لديه قوّة وسرعة أكبر ممّا لدى جسدي

65
00:04:43,950 --> 00:04:46,000
هذه هي ماهيّة البطل الحقيقيّ

66
00:04:46,600 --> 00:04:50,120
إنّه جسدٌ أعظم من أن أتحمّله بكثير

67
00:04:53,110 --> 00:04:55,820
،ماذا؟ إذاً يا كلوي

68
00:04:55,820 --> 00:05:01,600
،تقصدين بأنّ صديقتي المُستقبليّة، هيناتا
موجودة بداخلكِ؟

69
00:05:01,600 --> 00:05:02,710
أجل

70
00:05:02,710 --> 00:05:08,710
أجل، أشعر بالفعل بروح ثانية بداخلكِ

71
00:05:09,100 --> 00:05:12,960
إذاً سأتمكّن من التكلُّم مع هيناتا
من الآن فصاعداً؟

72
00:05:13,410 --> 00:05:15,990
أتطلّع بلهفة لذلك يا هيناتا

73
00:05:15,990 --> 00:05:16,710
حسناً

74
00:05:21,160 --> 00:05:25,570
سافرتُ أنا وكلوي من مكان لآخر
لمدّة طويلة جدّاً

75
00:05:29,330 --> 00:05:31,060
،بعد قرون عديدة

76
00:05:31,060 --> 00:05:34,160
انتشرت إشاعات حول أيّ جيل
،تنحدر منه كرونوا

77
00:05:34,160 --> 00:05:36,280
وبأنّها قد لا تكون بشريّة حتّى

78
00:05:36,750 --> 00:05:41,980
وبهذا تمّ ترقية كرونوا البطلة
إلى درجة الأسطوريّة

79
00:05:45,910 --> 00:05:49,520
أصبح رديئة قليلاً عندما لا أُقاتل
لمدّة من الزّمن

80
00:05:49,520 --> 00:05:52,540
كنّا نستطيع التّبادُل فيما بيننا كثيراً

81
00:05:53,240 --> 00:05:56,840
أنا أحجز مساحةً للمعيشة داخل جسدكِ

82
00:06:00,780 --> 00:06:03,470
كلوي مُذهلة حقّاً

83
00:06:03,840 --> 00:06:07,180
كغصن شجرة صفصاف، ليّنة ولا تنكسر

84
00:06:07,180 --> 00:06:12,730
ولديها التحمُّل العقليّ لتكرار هذه الحلقة
الزمنيّة ذات الـ2000 عام للأبد

85
00:06:15,190 --> 00:06:17,150
ما كنتُ لأتحمّل ذلك

86
00:06:18,250 --> 00:06:21,320
لا عجب في أنّني لم أصبح بطلة أبداً

87
00:06:25,050 --> 00:06:28,620
،وشارفنا على بلوغ العام الألف في رحلتنا

88
00:06:28,620 --> 00:06:32,840
البطل السّابق، غرانفيلي، أسّسَ
مجلسَ الغرب

89
00:06:33,370 --> 00:06:35,890
تُرفَع الُقبّعة للمجلس

90
00:06:35,890 --> 00:06:38,560
رغم ذلك، بما أنّه تمّ تأسيس الكثير
،من البلاد الجديدة

91
00:06:38,560 --> 00:06:41,780
صاروا يتحاربون بلا توقُّف في السّنوات
القليلة الماضية

92
00:06:41,780 --> 00:06:46,210
!بالنّسبة لتُجّار مثلنا، هذه فُرصة لجني ثروة

93
00:06:46,210 --> 00:06:49,570
يبدو أنّ المجلس سيتدخّل لمُحاولة
تحقيق توازن

94
00:06:49,570 --> 00:06:53,230
كُلّ بلد يريد دوماً إيجاد أيّ سبب للقتال

95
00:06:53,730 --> 00:06:57,480
لهذا يزداد نفوذ المجلس عاماً بعد عام

96
00:06:58,310 --> 00:07:03,160
وغرانفيلي يعمل أيضاً ككاهن الأحد
في الكنيسة الغربيّة المُقدّسة

97
00:07:04,590 --> 00:07:09,450
وهدفه هو نفسه هدفنا، أليس كذلك؟

98
00:07:15,880 --> 00:07:18,810
أشعر بأنّنا أنقذنا الكثير من الأشخاص
،في هذه الرّحلة

99
00:07:18,810 --> 00:07:20,710
وأنا فخورةٌ بذلك

100
00:07:21,550 --> 00:07:25,890
رأينا أيضاً العديد من الأشياء أيضاً والّتي
جعلَتْني أرغب في الإشاحة بنظري

101
00:07:27,740 --> 00:07:30,060
،حتّى بعد كُلّ ما مررتُ به

102
00:07:30,060 --> 00:07:33,060
لا أشعر بأنّني تغيّرتُ من الدّاخل إطلاقاً

103
00:07:35,120 --> 00:07:37,310
كلوي، يمكنكِ استعادته

104
00:07:37,310 --> 00:07:38,870
ماذا؟ حسناً

105
00:07:42,190 --> 00:07:43,810
...أخبريني يا كلوي

106
00:07:43,810 --> 00:07:44,670
ماذا؟

107
00:07:45,260 --> 00:07:47,270
ألفا عام هي مدّة طويلة، أليس كذلك؟

108
00:07:48,010 --> 00:07:51,360
ما الأمر؟ لا تبدين فاترة الهمّة هكذا عادةً

109
00:07:51,360 --> 00:07:56,210
المسألة ليست كذلك. هذه
مُجرّد فكرة راودَتْني

110
00:07:57,020 --> 00:07:59,460
أجل، أعتقد بأنّها طويلة

111
00:08:01,660 --> 00:08:04,960
!لا أطيق انتظار اللّقاء بريمورو

112
00:08:04,960 --> 00:08:07,470
أنتِ لا تتغيّرين حقّاً، أليس كذلك؟

113
00:08:08,630 --> 00:08:10,340
إنّها قويّةٌ بالفعل

114
00:08:11,260 --> 00:08:14,540
يسرّني أن أستضيفكِ كشريكة
لي في هذه الرّحلة

115
00:08:14,540 --> 00:08:16,730
إنّ الشّيء الوحيد الّذي يُبقيني عاقلة

116
00:08:17,790 --> 00:08:19,710
...هيناتا

117
00:08:19,710 --> 00:08:20,520
ماذا؟

118
00:08:21,690 --> 00:08:23,650
لا شيء. انسي الأمر

119
00:08:24,150 --> 00:08:29,830
أجل... أظنّني سأتمكّن من بذل قصارى
جهدي لأنّني معكِ

120
00:08:30,410 --> 00:08:35,410
إذا كنتُ بطلة هذا العالم، فأنتِ بطلتي إذاً

121
00:08:35,410 --> 00:08:37,920
أ-ألا يحرجكِ قول ذلك؟

122
00:08:38,380 --> 00:08:40,710
!كم أنتِ خجولة

123
00:08:40,710 --> 00:08:42,020
!لستُ كذلك

124
00:08:46,440 --> 00:08:47,510
ما الأمر؟

125
00:08:48,000 --> 00:08:52,270
تلك السّحليّة البغيضة تُسبّب فوضى
في غابة جورا العظيمة

126
00:08:52,270 --> 00:08:53,540
حقّاً؟

127
00:08:54,040 --> 00:08:56,770
حسناً. سأختم على فيلدورا بعيداً

128
00:08:56,770 --> 00:08:58,100
ماذا؟

129
00:08:58,100 --> 00:09:02,040
رغم ذلك، قلتِ شيئاً من هذا
...القبيل قبل مدّة طويلة

130
00:09:02,040 --> 00:09:03,280
هل ستتمكّنين من ذلك؟

131
00:09:03,660 --> 00:09:06,220
هيناتا معي

132
00:09:06,220 --> 00:09:09,960
لا تقلقي. سأتولّى أمر فيلدورا

133
00:09:11,980 --> 00:09:13,170
ما الأمر؟

134
00:09:13,520 --> 00:09:17,670
قاتلتُ فيلدورا مرّةً من قبل

135
00:09:19,790 --> 00:09:21,300
!ضعيفة! ضعيفة للغاية

136
00:09:21,300 --> 00:09:23,560
وتعتبرين نفسكِ حامية البشريّة؟

137
00:09:23,560 --> 00:09:25,090
!لا تُثيريني على الضّحك

138
00:09:25,090 --> 00:09:28,470
عجباً لأمرك. من الواضح أنّكِ
تريدين تذوُّق الهزيمة

139
00:09:28,470 --> 00:09:32,320
!والآن، حان وقت إنهاء هذا

140
00:09:32,320 --> 00:09:35,160
!لديّ أمور أُخرى أملأ بها وقتي

141
00:09:39,070 --> 00:09:43,320
تقول هيناتا بأنّها لن تتحسّن
ما لم تسحقه سحقاً مُبيناً

142
00:09:43,320 --> 00:09:45,380
أتفهّمها

143
00:09:45,380 --> 00:09:49,510
أنا أيضاً تعتريني رغبةٌ بإبكاء
تلك السّحليّة اللّعينة

144
00:09:49,510 --> 00:09:51,080
!افعليها يا هيناتا

145
00:09:52,580 --> 00:09:56,940
آنذاك، نجحتُ في جعله يكشف كافّة أوراقه

146
00:09:56,940 --> 00:09:59,380
والآن لديّ هذا الجسد. لا يمكنني الخسارة

147
00:09:59,790 --> 00:10:01,510
لا تُبالغي كثيراً، اتّفقنا؟

148
00:10:01,510 --> 00:10:05,840
!فيلدورا شخصٌ لطيفٌ في الواقع

149
00:10:10,100 --> 00:10:12,310
!ضعيفة للغاية

150
00:10:14,940 --> 00:10:17,270
!عرفتُ بأنّك ستفعل ذلك

151
00:10:20,480 --> 00:10:21,150
!ماذا؟

152
00:10:23,320 --> 00:10:25,150
!جهد مهدور

153
00:10:25,150 --> 00:10:26,780
أهو كذلك حقّاً؟

154
00:10:29,330 --> 00:10:30,410
!أنت مكشوف

155
00:10:35,910 --> 00:10:39,260
!ا-اللّعنة

156
00:10:44,230 --> 00:10:45,290
تستحقُّ هذا

157
00:10:50,000 --> 00:10:52,800
عرفتُ بأنّكِ ستُبالغين في ذلك

158
00:10:53,890 --> 00:10:56,190
!هيناتا! أحسنتِ صنعاً

159
00:10:56,190 --> 00:10:58,960
!لم أشعر براحة كهذه من قبل

160
00:10:58,960 --> 00:11:01,900
هيناتا سعيدة بسعادتكِ

161
00:11:01,900 --> 00:11:05,000
!هيناتا، كم أنتِ رائعة

162
00:11:05,000 --> 00:11:07,650
!أجل! اليوم، سنشرب حتّى تشبع قلوبنا

163
00:11:07,650 --> 00:11:11,240
!مهلاً يا لوميناس! ليس وكأنّكِ تثملين

164
00:11:13,420 --> 00:11:17,160
طوّرتُ طريقةً للشّعور بالنّشوة
في مُناسبات كهذه

165
00:11:20,130 --> 00:11:22,580
!سوف أثمل اليوم

166
00:11:22,580 --> 00:11:24,900
!هيّا يا كرونوا! يجب أن تشربي أيضاً

167
00:11:24,900 --> 00:11:27,670
!ليس إلى هذا الحدّ

168
00:11:32,700 --> 00:11:35,230
،حسناً يا كلوي وهيناتا

169
00:11:35,230 --> 00:11:37,200
سأُرتّب حفلاً لمُناسبة الذّكرى السّنويّة

170
00:11:37,200 --> 00:11:39,270
لهزيمة تلك السّحليّة البغيضة
...في المرّة المُقبلة الّتي

171
00:11:40,800 --> 00:11:41,880
...المعذرة

172
00:11:42,830 --> 00:11:45,290
،لم أذكر هذا من قبل

173
00:11:45,290 --> 00:11:47,860
لكن أعتقد بأنّني سأختفي قريباً

174
00:11:47,860 --> 00:11:48,990
ماذا؟

175
00:11:48,990 --> 00:11:52,240
كلوي؟ ماذا تقولين؟

176
00:11:52,240 --> 00:11:55,170
حسناً، "اختفاء" قد تكون مُبالغة

177
00:11:55,170 --> 00:11:57,450
الأقرب هو أنّني سأنام

178
00:11:57,450 --> 00:11:59,520
،لكن ستبقى هيناتا فترة أطول قليلاً

179
00:11:59,520 --> 00:12:02,140
لذا اعتبريه تبادُلاً بيننا فحسب

180
00:12:02,140 --> 00:12:03,250
تبادُل؟

181
00:12:03,250 --> 00:12:04,630
ما معنى هذا؟

182
00:12:05,340 --> 00:12:10,260
أنا وأخي الكبير ليون سوف نُنقَل
،إلى هذا العالم قريباً

183
00:12:10,260 --> 00:12:13,240
وعندما يحدث ذلك، سأفقد الوعي

184
00:12:13,240 --> 00:12:17,520
لا يمكن لاثنين منّي أن يتواجدا
في نفس العصر في نهاية المطاف

185
00:12:17,520 --> 00:12:22,250
وماذا سيحدث لكِ حالما تفقدين الوعي؟

186
00:12:22,250 --> 00:12:25,330
هل ستتحوّلين إلى كلوي الجديدة هذه؟

187
00:12:25,330 --> 00:12:30,530
أنا الّتي عدتُ إلى هذا العصر ستُرسَل
إلى المُستقبل، جسديّاً وما إلى هنالك

188
00:12:30,530 --> 00:12:33,830
بالطّبع. خِلاف ذلك، لن يكون من المنطقيّ

189
00:12:33,830 --> 00:12:37,290
أن يكون أوّل مكان ألتقي
فيه بكِ هو المدرسة

190
00:12:37,290 --> 00:12:42,680
ردّة فعل سببها اثنان من نفس
...الكائن يتواجدان في آن واحد

191
00:12:43,660 --> 00:12:46,170
ما الّذي سيحدث لجسدكِ الّذي تتركينه؟

192
00:12:46,900 --> 00:12:50,740
إنّه مُجرّد تخمين بما أنّني لا أملك
،أي ذكرى عقب تلك النّقطة

193
00:12:50,740 --> 00:12:56,430
لكن أعتقد بأنّ هيناتا ستتولّى السّيطرة
وتؤدّي دور البطلة

194
00:12:56,430 --> 00:13:00,110
"فهمت. هذا ما قصدتِه إذاً بـ"السّيطرة

195
00:13:01,590 --> 00:13:02,600
!انتظري لحظة

196
00:13:03,090 --> 00:13:07,210
هل هذا يعني بأنّ البطلة الّتي
تُنقذ شيزوي-سينسي هي أنا؟

197
00:13:08,140 --> 00:13:10,860
أجل. هذا ما أعتقده

198
00:13:11,250 --> 00:13:13,130
...يا له من مُنعطَف أحداث

199
00:13:13,980 --> 00:13:16,870
كلوي، دعيني أستخدم جسدَكِ قليلاً

200
00:13:18,460 --> 00:13:23,610
كنتُ قد تساءلتُ ما الّذي كان ليحدث
،للعالم بعد أن نبدأ من جديد

201
00:13:23,610 --> 00:13:28,880
وما إن كان العصر الّذي نسعى له
سيكون العالم الّذي عرفناه

202
00:13:29,280 --> 00:13:33,630
إنّه مفهوم وحدها كرونوا، الشّخص الّذي
يمتلِك "السّفر عبر الزّمن"، تستطيع التّفكير فيه

203
00:13:34,060 --> 00:13:36,910
،لكن استناداً إلى ما قالته كلوي

204
00:13:36,910 --> 00:13:39,530
يبدو وكأنّ العالم قد أُعيد بناؤه

205
00:13:40,070 --> 00:13:47,150
خِلاف ذلك، لا يوجد سبب يدفع العالم لرفض
وجود اثنين من نفس الكائن في آن واحد

206
00:13:47,150 --> 00:13:49,490
هذا مُعقّدٌ جدّاً

207
00:13:49,490 --> 00:13:52,530
هذا يعني أنّه يوجد واحدٌ فقط
من هذا العالم إذاً

208
00:13:52,530 --> 00:13:55,450
لكن هذه هي الأنباء السّارّة

209
00:13:56,280 --> 00:13:59,900
حقيقة أنّه يوجد واحدٌ فقط من هذا العالم

210
00:13:59,900 --> 00:14:05,870
تجعل استماتتك للوصول إلى زمنكِ
الأصليّ جديراً بالاستحقاق

211
00:14:05,870 --> 00:14:06,540
أليس كذلك؟

212
00:14:09,020 --> 00:14:11,800
عجباً، احترتُ معكِ

213
00:14:13,800 --> 00:14:19,300
لكن معنى هذا بأنّني أستطيع أن أكون
،نشِطة في السّنوات الثّلاثمئة المُقبلة فقط

214
00:14:19,300 --> 00:14:21,560
إلى أن تظهر "أنا" الّتي لا تعرف شيئاً
عن هذا، صحيح؟

215
00:14:22,280 --> 00:14:24,860
أجل، هذا صحيح

216
00:14:24,860 --> 00:14:28,770
ماذا سيحدث إذا نام وعيكِ كذلك؟

217
00:14:29,800 --> 00:14:31,990
...الشّيء الوحيد الّذي أتذكّره بصعوبة هو

218
00:14:31,990 --> 00:14:34,530
أعتقد دخلتُ في حالة هيَجان

219
00:14:35,300 --> 00:14:39,790
وأنا متأكِّدة بأنّ تلك كانت شخصيّة
مُختلفة، لستُ أنا

220
00:14:39,790 --> 00:14:42,660
حقّاً؟ هناك واحدة أُخرى منكِ؟

221
00:14:42,660 --> 00:14:44,910
كم أنتِ مشؤومة

222
00:14:45,830 --> 00:14:50,240
تقصدين الشّخصيّة الّتي أخذتْ قوّتي
عندما منحتِ نفسكِ اسماً

223
00:14:50,240 --> 00:14:52,970
قد تكونين وحشاً بكُل معنى الكلمة فعلاً

224
00:14:53,760 --> 00:14:57,080
كرونوا هي تجسيد نيّة التّدمير

225
00:14:57,080 --> 00:14:59,210
لا أستطيع أن أدعها تتولّى السّيطرة

226
00:15:00,220 --> 00:15:02,920
لوميناس، هلّا طلبتُ منكِ معروفاً؟

227
00:15:02,920 --> 00:15:04,430
...عندما يحين ذلك الوقت

228
00:15:04,430 --> 00:15:06,520
دعي الأمر لي

229
00:15:06,520 --> 00:15:09,570
إذا صنعتُ تابوتاً مُقدّساً بختم
،قوّة الرُّوح المُقدّسة

230
00:15:09,570 --> 00:15:12,290
فينبغي لهذا أن يعزلكِ عن العالم الحاضر

231
00:15:12,290 --> 00:15:15,550
أعِدُكِ بأن أجد روحَيكِ في المُستقبل

232
00:15:15,550 --> 00:15:19,450
وأكسر الختم عندما تتّخذين هيئتكِ الكاملة

233
00:15:21,580 --> 00:15:22,960
أعتمد عليكِ

234
00:15:37,390 --> 00:15:38,990
أعتقد بأنّ الوقت قد حان

235
00:15:40,310 --> 00:15:42,360
سوف أفتقدكِ

236
00:15:45,330 --> 00:15:47,210
شكراً على كُلّ شيء

237
00:15:47,760 --> 00:15:50,160
آسفة لأنّني أثقلتُ عليكِ بالطّلبات

238
00:15:50,780 --> 00:15:52,900
لا تقولي كلاماً كهذا

239
00:15:52,900 --> 00:15:55,120
سوف نلتقي ثانية في المُستقبل

240
00:15:55,120 --> 00:15:55,870
أجل

241
00:15:58,180 --> 00:16:00,900
هيناتا، أدع الباقي عليكِ

242
00:16:00,900 --> 00:16:03,820
أجل. يمكنكِ الاعتماد عليّ

243
00:16:03,820 --> 00:16:07,030
،أعرفكِ جيّداً، لذلك لستُ قلقة

244
00:16:07,030 --> 00:16:09,490
!لكن بالتّوفيق يا هيناتا البطلة

245
00:16:25,430 --> 00:16:28,220
...لم أكن أتوقّع كُلَّ هذا

246
00:16:37,740 --> 00:16:42,540
ويجب عليّ الاستمرار في احتواء كُلّ هذا
لوحدي في السّنوات الـ 300 المُقبلة؟

247
00:16:45,190 --> 00:16:48,430
إلى متى سيدوم هذا العِناق يا لوميناس؟

248
00:16:50,570 --> 00:16:53,380
أرى بأنّكِ تولّيتِ السّيطرة يا هيناتا

249
00:16:53,380 --> 00:16:55,380
،ستكونين بمفردكِ من الآن فصاعداً

250
00:16:55,380 --> 00:16:57,870
لكن ابذلي قصارى جهدكِ كبطلة

251
00:16:57,870 --> 00:16:58,670
حسناً

252
00:16:59,300 --> 00:17:03,840
سأعمل بطريقة لا تُلطّخ سمعة كرونوا البطلة

253
00:17:28,940 --> 00:17:31,600
!أحسني... السُّلوك

254
00:17:35,500 --> 00:17:39,430
أستطيع فعلها. رأيتُ كلوي تحتوي
هذا طوال الوقت

255
00:17:40,390 --> 00:17:41,450
...فضلاً عن ذلك

256
00:17:42,770 --> 00:17:45,940
حملتُ شيئاً أكثر إزعاجاً من كرونوا

257
00:17:45,940 --> 00:17:48,050
منذ نقلي إلى هنا

258
00:17:50,270 --> 00:17:52,810
كلوي، لن يمضي وقتٌ طويل الآن

259
00:17:53,120 --> 00:18:00,440
هذه المرّة، حان دوري في هذا العالم
لإنقاذ الشّخص الّذي أنقذني دوماً

260
00:18:28,940 --> 00:18:31,120
...جُزيئاتي السّحريّة

261
00:18:31,650 --> 00:18:32,840
لا أستطيع هزيمتكِ

262
00:18:35,570 --> 00:18:36,890
أتشعرين براحة؟

263
00:18:38,320 --> 00:18:41,950
ماذا تفعل فتاةٌ صغيرةٌ مثلكِ
في قلعة سيّد شياطين؟

264
00:18:42,860 --> 00:18:45,990
أنا... قادمة من عالم آخر

265
00:18:46,450 --> 00:18:49,990
هلّا أخبرتِني كيف كانت حياتكِ
قبل المجيء إلى هنا؟

266
00:18:51,700 --> 00:18:55,980
نشبتْ حربٌ في العالم الّذي عشتُ فيه

267
00:18:56,900 --> 00:18:58,500
...كانت هناك إغارة جويّة

268
00:18:59,160 --> 00:19:01,320
أمطرتْ علينا نيرانٌ من السّماء

269
00:19:01,850 --> 00:19:02,780
هكذا إذاً

270
00:19:12,750 --> 00:19:17,810
تبقى طاقة حياتكِ ثابتة من خلال
الاندماج مع إيفريت

271
00:19:18,350 --> 00:19:19,750
لم أكن أملك خياراً

272
00:19:20,370 --> 00:19:22,770
لا أستطيع النّجاة بأيّ وسيلة أُخرى

273
00:19:24,320 --> 00:19:28,110
لدى هذا تأثير تعزيز المُقاومة السّحريّة

274
00:19:28,880 --> 00:19:31,910
سيُبقي إيفريت مقموعاً بداخلكِ

275
00:19:37,020 --> 00:19:38,090
كيف هو شعوركِ؟

276
00:19:38,560 --> 00:19:42,280
...أجل... أشعر بأنّ إرادة إيفريت أضعف بكثير

277
00:19:42,870 --> 00:19:46,970
لكن... ماذا؟ لِمَ يُراودني هذا الشُّعور؟

278
00:19:59,350 --> 00:20:00,930
لا داعي للقلق

279
00:20:01,720 --> 00:20:04,030
قاتلتِ بأقصى ما لديكِ لفترة طويلة

280
00:20:04,030 --> 00:20:05,940
ابكي قدر ما تحتاجين

281
00:20:25,420 --> 00:20:28,940
هيّا يا شيزوي. يجب أن تلقي التّحيّة عليه

282
00:20:28,940 --> 00:20:33,260
لا تقلقي. هذا هاينز-سان، الرّجل المسؤول هنا

283
00:20:33,260 --> 00:20:34,980
بالرّغم من مظهره، إنّه لطيف

284
00:20:34,980 --> 00:20:38,970
ستأخذين هذه الفتاة الصّغيرة معكِ؟
هل هذا تصرُّف حكيم؟

285
00:20:38,970 --> 00:20:41,350
ألا ينبغي أن تتركيها؟

286
00:20:41,350 --> 00:20:44,350
ستكون بخير. إنّها قويّة

287
00:20:59,900 --> 00:21:02,250
!تبّاً! أنتِ مُجرّد بشريّة

288
00:21:08,300 --> 00:21:10,540
نضجتِ كثيراً

289
00:21:11,550 --> 00:21:15,040
،عجيب، عندما أُحضِرتِ أوّل مرّة إلى هنا

290
00:21:15,040 --> 00:21:16,810
لم أعرف ماذا أقول

291
00:21:16,810 --> 00:21:21,310
ماذا؟ إذاً حتّى حاكمة اللّهب مرّتْ بذلك؟

292
00:21:21,310 --> 00:21:25,690
من فضلك توقّف عن الحديث حول قصص
قديمة كهذه يا هاينز-سان

293
00:21:25,690 --> 00:21:30,630
،لكن بوجود كرونوا البطلة وحاكمة اللّعب معاً

294
00:21:30,630 --> 00:21:31,820
،انسَ فئة الفاجعة

295
00:21:31,820 --> 00:21:35,450
أنا واثقٌ أنّه حتّى فئة الكارثة لن يملك فُرصة

296
00:21:35,450 --> 00:21:36,750
!معك حقّ

297
00:21:41,790 --> 00:21:43,580
هذا مُقلق

298
00:21:43,580 --> 00:21:47,150
وعي كرونوا الهائج يزداد قوّةً في كلّ عام

299
00:21:49,570 --> 00:21:53,380
أنا" الأُخرى ستصل إلى هذا العالم قريباً"

300
00:21:54,450 --> 00:21:56,690
...أردتُ قضاء مزيد من الوقت معاً

301
00:21:59,220 --> 00:21:59,870
ماذا؟

302
00:22:00,380 --> 00:22:03,340
أصبحتِ أقوى، جسديّاً وعقليّاً

303
00:22:03,340 --> 00:22:05,230
حان الوقت لتعيشي بمفردكِ

304
00:22:05,230 --> 00:22:08,400
لا تقلقي. أنا متأكّدة بأنّنا سنلتقي ثانية

305
00:22:11,400 --> 00:22:12,290
حسناً

306
00:22:27,860 --> 00:22:29,350
شكراً لكِ على كُلّ شيء

307
00:22:30,130 --> 00:22:33,830
وأتطلّع بشوق للقائكِ ثانية يا لوميناس

308
00:22:35,150 --> 00:22:38,390
أنتِ صديقتي. لا حاجة للشّكر

309
00:22:38,390 --> 00:22:41,800
رغم ذلك... أنتِ جميلة للغاية

310
00:22:41,800 --> 00:22:44,170
ليتَ تستطيع كلوي سماع ذلك

311
00:22:44,950 --> 00:22:47,440
أستطيع تصوُّر وجهها السّاخط

312
00:22:50,640 --> 00:22:54,780
أنا آسفة. دفعتُ بوقتي لأقصى حدّ

313
00:22:56,220 --> 00:22:57,260
...من فضلكِ

314
00:22:59,830 --> 00:23:01,090
عُلِم

315
00:23:05,350 --> 00:23:08,910
طوال هذا الوقت، ظننتُ بأنّني
،لا يمكن أن أحظى بالمغفرة

316
00:23:09,500 --> 00:23:11,010
لكن هذا غير صحيح

317
00:23:11,810 --> 00:23:14,440
لم أستطع مُسامحة نفسي ببساطة

318
00:23:15,520 --> 00:23:17,600
لكن الأمور بخير

319
00:23:17,600 --> 00:23:19,690
لا حاجة لذلك

320
00:23:19,690 --> 00:23:22,570
سأحمل هذا العبء بينما أمضي قُدماً

321
00:23:22,570 --> 00:23:25,420
لذا لا يوجد سببٌ للتردُّد

322
00:23:29,440 --> 00:23:32,590
لا أعرف ماذا سيحدث لي حالما
أخلد إلى النّوم

323
00:23:33,670 --> 00:23:36,110
،عندما أستيقظ في المرّة المُقبلة
فسيكون ذلك بصفة كرونوا

324
00:23:38,710 --> 00:23:41,840
...لكن... لكن رغم ذلك

325
00:23:44,130 --> 00:23:50,040
أؤمن بأنّك ستهتمّ بكُلّ شيء يا ريمورو

326
00:23:54,920 --> 00:23:58,080
"الحلقة القادمة، "حيث تقطن الرُّوح