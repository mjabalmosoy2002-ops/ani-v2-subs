1
00:00:02,790 --> 00:00:05,890
!جميعكم يا من سخرتُم منّي

2
00:00:05,890 --> 00:00:08,230
!ستقبلون جزائي

3
00:00:20,920 --> 00:00:21,810
إشعار

4
00:00:21,810 --> 00:00:25,460
يفكّر كلايمان بالهرب غالباً

5
00:00:25,460 --> 00:00:26,700
توقّعت

6
00:00:27,250 --> 00:00:29,000
انتهى أمرك بالفعل

7
00:00:29,000 --> 00:00:32,340
استسلم وأخبرني من يعطيك الأوامر فحسب

8
00:00:32,340 --> 00:00:34,980
!لا حدود لوقاحتك حقّاً

9
00:00:35,580 --> 00:00:38,090
...في اللّحظة التي تتجنّب فيها هذه

10
00:00:38,090 --> 00:00:41,760
يخطّط لتفجيرها في الهواء وانتهاز
تلك الفرصة للهرب

11
00:00:41,760 --> 00:00:43,010
!لكن مع الأسف

12
00:00:43,010 --> 00:00:44,260
!بيلزيبوب

13
00:00:47,900 --> 00:00:50,940
ما الذي قلتُه للتو؟ انتهى أمرك بالفعل

14
00:00:55,030 --> 00:00:57,700
سرقَ تقنيّة الحاجز الخاصّة بي؟

15
00:00:57,700 --> 00:00:59,700
يا للصّفاقة

16
00:01:02,280 --> 00:01:03,160
أنت

17
00:01:03,760 --> 00:01:05,830
إن كنت ستتّخذ هذا الأمر على محمل
الجدّ، فيمكنك البدء بسرعة

18
00:01:09,340 --> 00:01:13,480
أنت قويّ بالفعل. أقرّ لك بذلك

19
00:01:13,480 --> 00:01:18,080
لكنّك لم ترَ بعد بداية ما أنا بقادر عليه

20
00:01:19,590 --> 00:01:22,930
!أتظنّ أنّك تستطيع تحمّل هذا؟

21
00:01:24,640 --> 00:01:28,400
!تذوّق تقنيّتي العُظمى

22
00:01:28,960 --> 00:01:31,820
!الناسف الشيطاني

23
00:01:31,820 --> 00:01:33,820
!ابتلعها يا بيلزيبوب

24
00:01:44,410 --> 00:01:47,420
!مستحيل! هذا غير ممكن

25
00:01:47,420 --> 00:01:51,620
!كانت تلك... كانت تقنيّتي العظمى

26
00:01:51,620 --> 00:01:54,920
لا جدوى يا كلايمان. أنت أضعف منّي

27
00:01:54,920 --> 00:01:58,100
،إذا أخبرتني بكلّ ما تعرفه فحسب

28
00:01:58,100 --> 00:02:00,050
سأدعك تموت بلا ألم

29
00:02:02,300 --> 00:02:04,260
!أنا رجُل موت

30
00:02:04,260 --> 00:02:06,360
،حتّى لو قتلتني، سأعود إلى الحياة

31
00:02:06,360 --> 00:02:08,060
—وعاجلاً أم آجلاً، سأحرص على

32
00:02:21,700 --> 00:02:24,790
استخدمَ التسارع الفكريّ على كلايمان؟

33
00:02:24,790 --> 00:02:26,620
حسناً، لا ألومه على ذلك

34
00:02:26,620 --> 00:02:29,330
!يستحقّ كلايمان ذلك

35
00:02:37,570 --> 00:02:38,760
...كلايمان

36
00:02:39,130 --> 00:02:41,480
سأسألك مرّة أخيرة

37
00:02:41,480 --> 00:02:43,140
من يقف وراء كلّ هذا؟

38
00:02:43,140 --> 00:02:45,080
لا تسخر منّي

39
00:02:45,080 --> 00:02:50,850
لن أخون صديقاً أبداً ناهيك عن عميل

40
00:02:50,850 --> 00:02:51,900
...هذه

41
00:02:51,900 --> 00:02:56,900
!هذه قاعدة مُطلقة من قواعد حلف المُهرّجين المُعتدل

42
00:02:57,390 --> 00:02:58,630
هكذا إذاً

43
00:02:58,630 --> 00:03:02,410
وأيضاً، لمعلوماتك فقط، لا يمكنك العودة للحياة

44
00:03:02,410 --> 00:03:04,660
ما-ماذا؟

45
00:03:04,660 --> 00:03:06,540
أنت رجل موت

46
00:03:06,540 --> 00:03:10,200
تخطّط للانفصال عن جسدِك النجميّ والهرب

47
00:03:10,200 --> 00:03:11,100
هل أنا مخطئ؟

48
00:03:11,100 --> 00:03:12,480
!ا-انتظر

49
00:03:12,480 --> 00:03:14,790
،لا يبدو أنّه سيخبرني بأي شيء آخر

50
00:03:14,790 --> 00:03:16,610
لذا سوف أعدم كلايمان

51
00:03:18,490 --> 00:03:20,510
هل يعارضني أحد؟

52
00:03:20,510 --> 00:03:22,340
من يعارض، سأواجهه

53
00:03:22,700 --> 00:03:24,020
افعل ما تشاء

54
00:03:24,430 --> 00:03:25,600
!نَل منه

55
00:03:30,720 --> 00:03:32,270
!لا تفعل! أنت

56
00:03:32,630 --> 00:03:34,070
!توقّف

57
00:03:35,260 --> 00:03:37,480
لا تخلْ أنّ الموت سيكون بلا ألم

58
00:03:37,980 --> 00:03:42,010
اللّحظة القصيرة التي تعيشها قبل
موت روحك ستشعر وكأنّها خالدة

59
00:03:42,010 --> 00:03:44,090
استفد من ذلك الوقت للتفكير بما فعلتَه

60
00:03:44,090 --> 00:03:45,240
!لا

61
00:03:45,240 --> 00:03:47,900
!لا تفعل! لا تفعل ذلك

62
00:03:48,280 --> 00:03:49,490
!اعفُ عنّي

63
00:03:49,490 --> 00:03:53,460
...فوتمان، ساعدني... تير

64
00:03:53,460 --> 00:03:55,560
!لا أريد الموت بعد

65
00:03:55,560 --> 00:03:57,540
!ليس هنا

66
00:03:58,790 --> 00:04:03,040
!سـ-ساعدني يا كازاليم-ساما

67
00:04:04,150 --> 00:04:05,550
بيلزيبوب

68
00:04:09,180 --> 00:04:12,230
لابلاس... كنتَ مُحقّاً

69
00:04:12,600 --> 00:04:15,520
يبدو أنّني تماديتُ كثيراً

70
00:04:16,020 --> 00:04:20,110
كان يجدر بي أن أبقى متخفّياً كما أخبرتني

71
00:04:21,500 --> 00:04:25,450
...صحيح، أنت دائماً على حقّ

72
00:04:39,770 --> 00:04:41,080
أحسنت صنعاً

73
00:04:41,080 --> 00:04:44,520
اعتباراً من هذا اليوم، أعترف بك كسيّد شيطان

74
00:04:44,520 --> 00:04:46,300
هل هناك من يعترض؟

75
00:04:46,300 --> 00:04:49,100
!عرفتُ أنّ ريمورو يستطيع فعلها مثلما يستطيع الآخرون

76
00:04:51,180 --> 00:04:54,560
!لا أمانع أن أعتبرك تابعي إذا أردت

77
00:04:54,560 --> 00:04:57,520
لا داعي لذلك. ابحثي عن شخص آخر ليكون تابعكِ

78
00:04:57,520 --> 00:04:58,360
!لماذا؟

79
00:04:58,360 --> 00:05:01,650
!ألا توافق على أن تكون تابعي فحسب؟

80
00:05:03,120 --> 00:05:05,540
!ريمورو هو صديقي الحميم سلفاً

81
00:05:05,540 --> 00:05:07,790
!لا يريد أن يكون صديقكِ

82
00:05:07,790 --> 00:05:09,480
!ماذا؟! أكاذيب

83
00:05:09,480 --> 00:05:11,530
!ريمورو! إنّها تكذب، صحيح؟

84
00:05:11,530 --> 00:05:14,330
!لستِ جزءاً من المجموعة يا راميريس

85
00:05:14,330 --> 00:05:15,960
!ماذا؟

86
00:05:20,640 --> 00:05:22,420
لا مانع لديّ

87
00:05:23,480 --> 00:05:26,200
لا أكترث من يصبح سيّد شيطان

88
00:05:26,200 --> 00:05:27,300
يستطيع فعل ما يحلو له

89
00:05:28,240 --> 00:05:32,510
شخصيّاً، يُغيظني حتماً الاعتراف
...بهُلام وضيع كسيّد شيـ

90
00:05:34,050 --> 00:05:36,810
أتجرؤ على إهانتي أيّها المُضحك؟

91
00:05:37,390 --> 00:05:38,480
!ميليس

92
00:05:38,480 --> 00:05:40,680
!مُرافقكِ هنا غير مُنضبط جيّداً

93
00:05:40,680 --> 00:05:42,230
هل ألقّنه درساً؟

94
00:05:42,230 --> 00:05:44,740
!بئساً! ماذا يفعل هذا العجوز؟

95
00:05:44,740 --> 00:05:46,690
عمّاذا تتكلّم؟

96
00:05:46,690 --> 00:05:50,490
انا الخادمة المُوالية لسيّدة الشّيطان فالنتاين

97
00:05:51,360 --> 00:05:52,890
!توقّف

98
00:05:52,890 --> 00:05:56,440
!فالنتاين مُتنكّرة كخادمة لإخفاء هويّتها

99
00:05:56,440 --> 00:05:58,750
!فيلدورا، لا يجوز أن تقول كلاماً كهذا

100
00:05:58,750 --> 00:06:00,830
!قالتها للتو

101
00:06:08,810 --> 00:06:11,850
تبّاً. تنّينة شرّيرة لعينة

102
00:06:12,360 --> 00:06:14,100
هل نسيت اسمي كذلك؟

103
00:06:14,100 --> 00:06:16,070
ليس ميليس؟

104
00:06:16,070 --> 00:06:19,440
سميث؟ أم كان إيلس؟

105
00:06:19,440 --> 00:06:23,270
أنت حقّاً خبير في الاستفزاز

106
00:06:23,270 --> 00:06:27,480
!يكفي! ستناديني فالنتاين

107
00:06:30,930 --> 00:06:32,150
...إذاً

108
00:06:32,150 --> 00:06:35,070
كانت هذه الخادمة سيّدة الشّيطان الفعليّة؟

109
00:06:35,630 --> 00:06:38,210
روي، يمكنك أن تسبقني في العودة

110
00:06:38,500 --> 00:06:40,310
...لكن يا لوميناس-ساما

111
00:06:41,670 --> 00:06:45,060
،الآن بعد أن انكشفت هويّتي لكلّ هؤلاء

112
00:06:45,060 --> 00:06:47,300
لا جدوى من إخفائها فترة أطول

113
00:06:48,050 --> 00:06:51,800
حسناً، إنّها ليست غلطتي. لم أكن أعلم

114
00:06:51,800 --> 00:06:55,230
وأيضاً، كان "لومينوس". صحيح، صحيح

115
00:06:53,430 --> 00:06:55,810
وأيضاً، ثمّة أمر يُثير فضولي

116
00:06:56,160 --> 00:07:00,060
عندما نظرَ كلايمان إليك، تجمّد مكانه لبُرهة

117
00:07:01,150 --> 00:07:03,520
لعلّ لديه علاقة

118
00:07:03,520 --> 00:07:05,830
بالحشرة الّذي حاول دخول مجالي مؤخّراً

119
00:07:05,830 --> 00:07:08,440
عُد وأخبرهم أن يعزّزوا الحراسة

120
00:07:08,790 --> 00:07:09,920
عُلِم

121
00:07:11,890 --> 00:07:15,290
عرفتُ أنّ اسم "كازاليم" بدا مألوفاً

122
00:07:15,290 --> 00:07:16,980
إنّه سيّد الشيطان الّذي قتلتُه

123
00:07:17,790 --> 00:07:19,200
!تعرفه يا ليون؟

124
00:07:19,200 --> 00:07:21,540
أنا مندهش أكثر من أنّكِ لا تعرفينه

125
00:07:22,040 --> 00:07:24,420
وما قصّة كازاليم؟

126
00:07:24,420 --> 00:07:25,230
إجابة

127
00:07:25,230 --> 00:07:29,650
أحد الأسماء التي ناداها كلايمان عند
"توسّل المساعدة كان "كازاليم

128
00:07:29,650 --> 00:07:33,510
ما علاقة كازاليم هذا بكلايمان؟

129
00:07:33,510 --> 00:07:35,830
كازاليم هو سيّد اللّعنة

130
00:07:35,830 --> 00:07:37,270
سيّد اللّعنة؟

131
00:07:37,270 --> 00:07:38,020
ميليم

132
00:07:38,820 --> 00:07:42,680
أنتِ وكازاليم أوصيتما بي كسيّد شيطان، أتتذكّرين؟

133
00:07:47,110 --> 00:07:49,120
!ذاك من قصدت

134
00:07:49,990 --> 00:07:51,840
!أتذكّر سيّد اللّعنة

135
00:07:51,840 --> 00:07:55,030
!هذا صحيح! كان سيّد الشيطان الّذي قتلتَه يا ليون

136
00:07:55,030 --> 00:07:57,530
من ينسى ذلك؟

137
00:07:57,530 --> 00:08:02,470
أجل. حسبما أذكر، كان كازاليم أيضاً
سيّد موت مثل كلايمان تماماً

138
00:08:02,470 --> 00:08:04,960
أنا متأكّد أنّهما كانا مرتبطين بطريقة ما
وراء الكواليس

139
00:08:04,960 --> 00:08:07,710
،إذا كان كازاليم رجل موت أيضاً

140
00:08:07,710 --> 00:08:11,630
فمن المُمكن أنّه تظاهر بأنّه قُتِل بواسطة
ليون وراح ليختبئ في مكان ما؟

141
00:08:11,630 --> 00:08:13,160
هذا مُمكن

142
00:08:13,160 --> 00:08:17,370
كان أذكى وأكثر يقظة بكثير من كلايمان

143
00:08:17,370 --> 00:08:20,240
لا أحبّذ أن تتكلّموا كما لو أنّني سمحتُ له بالإفلات

144
00:08:21,070 --> 00:08:24,260
كلّ ما فعلتُه كان هزيمته وأخذ مكانه

145
00:08:24,260 --> 00:08:28,480
سواء كان لا يزال حيّاً أم لا ليس أمراً يعنيني

146
00:08:28,480 --> 00:08:32,690
سلوكك هذا هو ما دفع كلايمان لكرهك غالباً

147
00:08:33,810 --> 00:08:35,070
لا أبالي

148
00:08:35,450 --> 00:08:39,460
بعض رفاق كلايمان كانوا مجموعة تُدعى
حلف المُهرّجين المُعتدل

149
00:08:39,460 --> 00:08:43,480
لمّحوا إلى أنّ بعض الناس الّذين
،يساعدونهم كانوا بشراً

150
00:08:43,480 --> 00:08:45,870
لذا هناك احتمال أن يكون كازاليم قد عاد

151
00:08:45,870 --> 00:08:48,320
وتملّك بشريّاً ليتنكّر

152
00:08:48,760 --> 00:08:50,840
قد يكون ذلك صحيحاً

153
00:08:51,610 --> 00:08:55,060
هجمات ليون تدمّر العقل وكذلك الجسد

154
00:08:55,060 --> 00:08:58,600
قد يكون حتّى من الجدير الإطراء على كازاليم
لتمكّنه من النجاة من ذلك

155
00:08:58,600 --> 00:09:01,940
فضلاً عن ذلك، كان انبعاثاً سريعاً جدّاً

156
00:09:02,750 --> 00:09:06,020
تقصد أنّ شخصاً ساعده على الأرجح؟

157
00:09:06,020 --> 00:09:07,890
هذا ما أعنيه

158
00:09:09,460 --> 00:09:14,320
حسناً على أي حال، سأفترض أنّ كازاليم
عاد وبقي مُتيقّظاً

159
00:09:14,320 --> 00:09:17,320
سيُخفي ضغينة تجاهي غالباً لأنّني قتلتُ كلايمان

160
00:09:20,360 --> 00:09:23,080
،ريمورو، أنت أقوى بكثير منه الآن

161
00:09:23,080 --> 00:09:25,820
!لذا ليس لديك ما تقلق بشأنه

162
00:09:26,480 --> 00:09:29,330
!هذا النّوع من الرّضا عن النّفس هو ما يقود للهزيمة

163
00:09:30,400 --> 00:09:32,970
هذا صحيح. لا يجوز أن أقتنع بنفسي

164
00:09:33,700 --> 00:09:35,610
،ستكون مسألة مختلفة لو كنتُ بمفردي

165
00:09:35,950 --> 00:09:39,640
لكن لديّ أصدقاء عليّ حمايتهم الآن

166
00:09:48,110 --> 00:09:50,740
حسناً، كانت مواضيع هذا الاجتماع

167
00:09:50,740 --> 00:09:55,060
،خيانة كاريون ونهوض ريمورو هنا

168
00:09:55,060 --> 00:09:57,060
لكن حُلّت هذه المسائل الآن

169
00:09:57,060 --> 00:10:00,450
هل يودّ أحدكم إضافة شيء آخر؟

170
00:10:03,500 --> 00:10:04,660
هل يمكنني؟

171
00:10:04,660 --> 00:10:07,750
لكن هذا ليس اقتراحاً إنّما طلب

172
00:10:07,750 --> 00:10:09,140
تفضّلي

173
00:10:09,780 --> 00:10:13,280
قرّرتُ للتو أن أخدم ميليم

174
00:10:14,960 --> 00:10:17,830
ماذا؟

175
00:10:17,830 --> 00:10:21,350
بالتالي أتنازل عن مركزي كسيّدة شيطان

176
00:10:21,350 --> 00:10:23,370
هذا مفاجئ جدّاً في الواقع

177
00:10:23,370 --> 00:10:26,730
!انتظري يا فري! هذه أوّل مرّة أسمع فيها ذلك

178
00:10:26,730 --> 00:10:29,230
أجل، لأنّني لم أخبركِ

179
00:10:30,060 --> 00:10:32,990
حسناً، لديّ عدّة أسباب

180
00:10:33,420 --> 00:10:38,110
لكن السّبب الأهمّ هو أنّني أعتقد أنّني
ضعيفة جدّاً على أن أكون سيّدة شيطان

181
00:10:40,610 --> 00:10:43,890
مُشاهدة المعركة اليوم أقنعتني بذلك

182
00:10:43,890 --> 00:10:46,910
لو قاتلتُ كلايمان، لكنّا مُتعادلين على أقلّ تقدير

183
00:10:47,280 --> 00:10:51,570
أمام كلايمان صاحٍ، ما كنتُ لأملك فرصة

184
00:10:51,570 --> 00:10:57,360
لكن يا فري، أليست المعارك فائقة
السّرعة في الهواء هي اختصاصك؟

185
00:10:57,360 --> 00:11:00,650
لا أرى سبباً يدفعكِ للتقليلِ من قيمتكِ إلى هذه الدّرجة

186
00:11:00,650 --> 00:11:03,680
،لو كنتُ أقاتل شخصاً في الهواء، لامتلكتُ الأفضليّة

187
00:11:03,680 --> 00:11:07,940
لكن تعلّمتُ اليوم أنّ امتلاك الأفضليّة
ببساطة ليس كافياً دوماً

188
00:11:10,030 --> 00:11:14,270
ويا ميليم، لا يجوز لكِ أن تستمرّي في
طلب طلبات أنانيّة للأبد، صحيح؟

189
00:11:15,050 --> 00:11:18,980
ألا يجدر بكِ البدء بالتفكير في كيفيّة
إدارة مجالكِ الخاص؟

190
00:11:18,980 --> 00:11:22,160
حسناً؟ هل تقبلين عرضي؟

191
00:11:22,790 --> 00:11:26,040
...لـ-لكن... ليس أسلوبي أن أضع النّاس تحت حكمي

192
00:11:26,040 --> 00:11:28,850
...لستُ متأكّدة أنّ هذا

193
00:11:27,610 --> 00:11:29,280
مهلاً لحظة

194
00:11:29,280 --> 00:11:32,290
إن كان هذا ما نتحدّث عنه، فهناك
ما أريد إضافته أيضاً

195
00:11:32,290 --> 00:11:35,980
أنا أيضاً قاتلتُ ميليم في معركة فرديّة وخسرت

196
00:11:35,980 --> 00:11:38,920
لذا أعتقد ينبغي لي أن أرضخ لها كلّياً

197
00:11:38,920 --> 00:11:40,070
!ماذا؟

198
00:11:41,170 --> 00:11:44,890
بناء على ذلك، أنا تابعكِ اعتباراً من اليوم

199
00:11:44,890 --> 00:11:46,710
!أعتمد عليكِ يا زعيمة

200
00:11:47,220 --> 00:11:48,840
!انتظر لحظة يا كاريون

201
00:11:48,840 --> 00:11:51,850
!قاتلتُك فقط لأنّني كنتُ خاضعة للسيطرة

202
00:11:51,850 --> 00:11:54,980
!لا أعرف شيئاً عن الأمر! لا شيء

203
00:11:53,350 --> 00:11:54,980
!لا تدّعي الحماقة

204
00:11:54,980 --> 00:11:56,210
،قلتِها بنفسكِ للتو

205
00:11:56,210 --> 00:11:59,280
"أظننتَ حقّاً أنّه يمكن التحكّم بي بشيء كهذا؟"

206
00:11:59,280 --> 00:12:01,820
!جميعنا سمعناكِ بوضوح

207
00:12:02,190 --> 00:12:03,860
...كـ-كان ذلك

208
00:12:03,860 --> 00:12:07,440
،حسناً، لا أكترث لمفتول العضلات الأبله هذا

209
00:12:07,440 --> 00:12:09,120
لكن ستقبلينني أنا، أليس كذلك يا ميليم؟

210
00:12:10,110 --> 00:12:14,110
هـ-هل تقولين هذا لتحاولي خداعي أم ماذا؟

211
00:12:14,110 --> 00:12:15,130
خداعك؟

212
00:12:15,130 --> 00:12:17,420
،أعني إذا صرتِ تابعتي

213
00:12:17,420 --> 00:12:20,020
فلن تتكلّمي معي كصديقة بعد الآن، أليس كذلك؟

214
00:12:20,020 --> 00:12:23,880
ولن تلعبي معي أو ترسمي مخطّطات
شقيّة معي بعد الآن

215
00:12:23,880 --> 00:12:27,190
،لا، سأتمكّن من البقاء معكِ طوال الوقت

216
00:12:27,190 --> 00:12:29,890
حيث نستطيع فعل أشياء ممتعة أكثر حتّى معاً

217
00:12:31,290 --> 00:12:32,730
...فضلاً عن ذلك

218
00:12:32,730 --> 00:12:36,240
يحدث هذا لأنّكِ دمّرتِ مملكتنا

219
00:12:36,240 --> 00:12:39,110
أنتِ مُلزمة بالاهتمام بنا الآن

220
00:12:44,600 --> 00:12:48,660
!موافقة! افعلا ما تشاءان

221
00:12:48,660 --> 00:12:49,670
جيّد

222
00:12:50,380 --> 00:12:52,620
هل أنت متأكّد أنّ هذا ما تريده؟

223
00:12:52,620 --> 00:12:55,390
فكّرتُ في هذا الأمر مليّاً

224
00:12:55,390 --> 00:12:58,820
بالطبع، لا أقول أنّني لن أكون ملك مملكة الحيوان

225
00:12:58,820 --> 00:13:02,330
أريد فقط أن أبني نظاماً جديداً يضعها في القمّة

226
00:13:02,330 --> 00:13:03,770
...مهلاً

227
00:13:03,770 --> 00:13:06,410
نلتَ إعجابي حقّاً

228
00:13:06,410 --> 00:13:10,890
كنتُ أعلّق آمالاً كبيرة بأنّك ستستيقظ
بعد بضعة قرون إضافيّة

229
00:13:12,050 --> 00:13:13,640
عظيم

230
00:13:13,640 --> 00:13:17,110
اعتباراً من هذه اللّحظة، فري وكاريون
لم يعودا سيّدي شيطان

231
00:13:17,110 --> 00:13:20,900
بناء على رغبتكما، ستخدمان ميليم

232
00:13:34,550 --> 00:13:36,440
...معنى هذا

233
00:13:36,440 --> 00:13:39,770
أسياد الشّيطان العظماء العشرة صاروا
أسياد الشّيطان العظماء الثّمانية، صحيح؟

234
00:13:41,420 --> 00:13:43,180
!يا للبؤس

235
00:13:43,180 --> 00:13:47,930
لأجل الوقار، سيتوجّب علينا البحث عن اسم جديد

236
00:13:47,930 --> 00:13:51,910
لحسن حظّنا، ما زلنا في وسط والبورغيس

237
00:13:51,910 --> 00:13:53,970
،كلّ أسياد الشيطان حاضرون

238
00:13:53,970 --> 00:13:56,310
لذا أنا متأكّدة أنّنا يمكننا إيجاد اسم مناسب

239
00:13:56,310 --> 00:13:59,160
عانينا كثيراً في المرّة السّابقة

240
00:13:59,160 --> 00:14:03,730
ترتّب علينا عقد والبورغيس مراراً لنحدّد اسماً

241
00:14:03,730 --> 00:14:08,120
عقدتُم والبورغيس لأجل أمر روتيني كهذا؟

242
00:14:08,440 --> 00:14:10,240
أليس لدى أسياد الشّيطان شيء أفضل يفعلونه؟

243
00:14:10,240 --> 00:14:12,610
تتحدّثون عن التسمية؟

244
00:14:12,610 --> 00:14:15,500
إن كان كذلك، فصديقي ريمورو خبير

245
00:14:16,000 --> 00:14:19,880
!هذا صحيح! ابتكر اسم بيريتّا خلال وقت قصير

246
00:14:19,880 --> 00:14:23,210
!بالفعل. ريمورو-ساما ممتاز في التسمية

247
00:14:24,920 --> 00:14:26,340
!أنتم

248
00:14:27,340 --> 00:14:30,730
ريمورو، أنت تقف أمامنا اليوم كسيّد شيطان جديد

249
00:14:30,730 --> 00:14:33,350
أرغب في منحك هذا الامتياز العظيم

250
00:14:33,350 --> 00:14:35,390
لستُ بحاجة لذلك. شكراً على أي حال

251
00:14:44,860 --> 00:14:46,460
بكلّ تأكيد

252
00:14:46,460 --> 00:14:51,160
أمنحك الحقّ في تعيين اسم جديد لنا

253
00:14:53,660 --> 00:14:56,550
هذا شرف هائل

254
00:14:56,550 --> 00:14:59,330
ستقبله بالطبع، أليس كذلك؟

255
00:14:59,960 --> 00:15:01,350
،ودعني أذكّرك

256
00:15:01,350 --> 00:15:06,140
بسببك قلّ عدد أسياد الشّيطان لدينا الآن

257
00:15:06,420 --> 00:15:10,680
ستتحمّل مسؤوليّة إيجاد اسم لنا بالطبع، صحيح؟

258
00:15:12,160 --> 00:15:15,650
...حـ-حسناً، حسناً. تبّاً

259
00:15:15,650 --> 00:15:18,020
ولا تلوموني إن لم يُعجبكم

260
00:15:18,390 --> 00:15:19,520
جيّد

261
00:15:29,140 --> 00:15:33,860
هناك ثمانية منهم، لذا ألا يمكن أن يكون
أسياد الشّيطان العظماء الثّمانية فحسب؟

262
00:15:34,250 --> 00:15:36,920
لا، أعتقد هذا بدائيّ جدّاً

263
00:15:40,230 --> 00:15:41,680
...نجوم

264
00:15:41,680 --> 00:15:44,780
...أسياد الشّيطان الثمانية... ثمانية

265
00:15:44,780 --> 00:15:46,880
...النجوم الثمانية

266
00:15:46,880 --> 00:15:48,600
نجم ثُماني؟

267
00:15:50,080 --> 00:15:53,090
النجم الثّماني هو أوكتاغرام، صحيح؟

268
00:15:56,460 --> 00:16:00,930
ما رأيكم بـ"أوكتاغرام" والّذي يعني
أسياد شيطان النجم الثّماني؟

269
00:16:09,690 --> 00:16:10,630
!يروقني

270
00:16:10,630 --> 00:16:14,280
!أؤيّده! إنّه يمثّل دخولنا في عصر جديد

271
00:16:14,280 --> 00:16:18,410
!توقّعت! عرفتُ أنّ ريمورو يستطيع فعلها

272
00:16:18,410 --> 00:16:22,250
الآن فهمتُ سبب توصية فيلدورا بك

273
00:16:22,250 --> 00:16:24,380
أعتقد سيفي هذا بالغرض

274
00:16:24,380 --> 00:16:26,500
سأمنحك قليلاً من الاعتراف

275
00:16:26,500 --> 00:16:28,680
مذهل، كان ذلك سريعاً

276
00:16:28,680 --> 00:16:31,630
لماذا تكبّدنا عناء كبيراً في المرّة الماضية؟

277
00:16:31,940 --> 00:16:33,590
لا إطراء منّي

278
00:16:35,350 --> 00:16:36,850
عظيم

279
00:16:36,850 --> 00:16:39,850
فليكُن "أوكتاغرام: أسياد شيطان النجم الثّماني" إذاً

280
00:16:47,390 --> 00:16:53,280
إذاً سوف أعرّف عن أوكتاغرام، أسياد
شيطان النّجم الثّماني من جديد

281
00:16:54,070 --> 00:16:58,740
شيطان، سيّد الظلام: غي كريمزون

282
00:16:59,560 --> 00:17:03,120
جنّية، المتاهة: راميريس

283
00:17:03,850 --> 00:17:08,000
بشريّة تنّينة، المُدمّرة: ميليم نافا

284
00:17:08,500 --> 00:17:12,720
عملاق، الزلزال: داغرول

285
00:17:13,830 --> 00:17:18,850
مصّاصة الدماء، ملكة الكوابيس: لومينوس فالنتاين

286
00:17:19,960 --> 00:17:23,900
المُنزّل، الحاكم النّائم: دينو

287
00:17:25,110 --> 00:17:30,230
البشريّ الشّيطان، الحُسام البلاتيني: ليون كرومويل

288
00:17:31,240 --> 00:17:35,780
هُلام، الجديد: ريمورو تيمبيست

289
00:17:36,610 --> 00:17:38,110
بهذا نختتم التّعريف

290
00:17:43,500 --> 00:17:46,120
تهانينا يا أوكتاغرام

291
00:17:46,450 --> 00:17:47,870
تهانينا

292
00:17:47,870 --> 00:17:50,630
!تهانينا يا ريمورو-ساما

293
00:17:53,030 --> 00:17:57,730
وهكذا أصبحتُ جزءاً من أوكتاغرام، أسياد الشيطان الثمانية

294
00:17:58,720 --> 00:18:03,290
في ذلك اليوم، رُفِع السّتار عن عصر
جديد لأسياد الشيطان

295
00:18:10,660 --> 00:18:13,940
سيّدة الشيطان فالنتاين في الخارج تحضر والبورغيس

296
00:18:13,940 --> 00:18:17,000
حان الوقت الآن للكشف عن الإمبراطور المعزول

297
00:18:22,400 --> 00:18:24,620
الـ... الإمبراطور المعزول؟

298
00:18:26,480 --> 00:18:29,120
!لا... هيناتا ساكاغوتشي؟

299
00:18:29,120 --> 00:18:32,190
كيف تجرؤ على دخول هذا المكان المُقدّس؟

300
00:18:32,190 --> 00:18:34,630
أكره الحشرات حقّاً

301
00:18:34,630 --> 00:18:36,790
!مهلاً! ما خطبكِ بالضبط؟

302
00:18:36,790 --> 00:18:40,070
يا رئيس، ألم يكن من المُفترض أن تستدرج
!هيناتا إلى خارج هذا المكان؟

303
00:18:40,070 --> 00:18:41,590
!ليس هذا ما وعدت به

304
00:18:47,270 --> 00:18:52,060
غادر سيّد الشيطان فالنتاين، لكن ما الفائدة
!إذا كانت تلك المرأة هنا؟

305
00:18:52,060 --> 00:18:54,690
!مُحال أن أتمكّن من هزيمة تلك المتوحّشة

306
00:18:58,070 --> 00:19:00,400
!مهلاً! أيُعقل هذا؟

307
00:19:00,400 --> 00:19:02,410
تبّاً... لا أستطيع التعامل مع هذا

308
00:19:04,080 --> 00:19:05,780
!أيّها الحشرة

309
00:19:06,410 --> 00:19:09,140
أتكشف عن وجهك أمامي ثانية؟

310
00:19:09,140 --> 00:19:10,260
...سيّد الشيطان

311
00:19:10,260 --> 00:19:13,000
كلّ الحشرات سواسية

312
00:19:13,000 --> 00:19:15,360
هل تستمتع بالهرب إلى هذه الدّرجة؟

313
00:19:15,360 --> 00:19:16,420
عمّاذا تتكلّم؟

314
00:19:16,420 --> 00:19:19,920
مات كلايمان قبل دقائق

315
00:19:21,710 --> 00:19:23,010
ماذا؟

316
00:19:23,010 --> 00:19:28,060
حاول ذاك الحشرة المُخادع الأحمق الهرب مثلك تماماً

317
00:19:28,060 --> 00:19:30,560
وأخذ يصيح طوال الوقت

318
00:19:33,790 --> 00:19:37,110
لماذا أنت غاضب جدّاً؟ لا علاقة للأمر بك

319
00:19:37,110 --> 00:19:38,500
!اصمت

320
00:19:38,500 --> 00:19:42,090
أجبني... هل مات كلايمان حقّاً؟

321
00:19:43,590 --> 00:19:46,120
!لقد زلّ لسانك عن السرّ يا حشرة

322
00:19:46,120 --> 00:19:48,980
كنتما تتعاونان معاً، أليس كذلك؟

323
00:19:48,980 --> 00:19:51,620
!كلّ شيء يسير بمشيئة الإله لومينوس

324
00:19:52,100 --> 00:19:54,920
!لماذا تضحك أيّها الغبيّ؟

325
00:19:54,920 --> 00:19:56,440
—من تظنّ أنّك

326
00:19:57,210 --> 00:19:58,460
!أيّها الأخرق

327
00:19:58,460 --> 00:20:03,620
!أقول لك ألّا تضحك على صديقي

328
00:20:08,390 --> 00:20:12,310
!لا تغترّ بنفسك يا حشرة

329
00:20:14,290 --> 00:20:16,540
!مُت! الشّعاع الدمويّ

330
00:20:18,900 --> 00:20:20,330
!لم ينجح؟

331
00:20:20,330 --> 00:20:23,490
لا جدوى. فقد متَّ بالفعل

332
00:20:31,750 --> 00:20:34,750
أجل. هذه نُواتك

333
00:20:36,460 --> 00:20:39,800
استغرقتَ وقتاً طويلاً حتّى أدركت ذلك

334
00:20:40,170 --> 00:20:43,500
هذا صحيح. أنا قويّ

335
00:20:55,210 --> 00:20:58,370
أجل، سيغضب فوتمان

336
00:20:58,930 --> 00:21:01,730
أجل، ستبكي تير

337
00:21:02,060 --> 00:21:04,990
لهذا أضحك

338
00:21:07,180 --> 00:21:11,970
كلايمان، كنتَ غبيّاً بالفعل

339
00:21:53,720 --> 00:21:54,950
انتهى الأمر

340
00:21:55,250 --> 00:21:57,210
!أجل. أبليتَ بلاء رائعاً

341
00:21:57,210 --> 00:21:59,850
كم أنا مُتعبة

342
00:21:59,850 --> 00:22:01,210
مُتعبة للغاية

343
00:22:01,210 --> 00:22:03,760
لم تفعلي شيئاً حتّى

344
00:22:04,090 --> 00:22:05,130
!ريمورو

345
00:22:05,130 --> 00:22:12,140
...بسرعة، الجديد... الأحدث... الـ

346
00:22:05,960 --> 00:22:09,170
!أجل، المُجلّد الأحدث! أعلم، أعلم

347
00:22:09,170 --> 00:22:12,830
تبّاً، لا أصدّق عدم مُبالاتكم

348
00:22:13,210 --> 00:22:17,820
!ريمورو-ساما

349
00:22:17,820 --> 00:22:20,700
!أهلاً بعودتك

350
00:22:23,640 --> 00:22:25,760
!ريمورو-ساما

351
00:22:34,580 --> 00:22:36,360
الجميع ينتظرون

352
00:22:36,360 --> 00:22:40,490
هيّا يا ريمورو-ساما، راميريس-ساما. لنذهب

353
00:22:51,850 --> 00:22:55,930
كان من المُفترض أن أعيش حياة عاديّة هادئة تماماً

354
00:22:55,930 --> 00:22:57,720
،لكن قُتِلتُ بطعنٍ عشوائيّ

355
00:22:57,720 --> 00:23:00,440
،وخُلِقت من جديد في عالم آخر كهُلام

356
00:23:00,730 --> 00:23:02,980
وبنيتُ دولة وحوش

357
00:23:11,290 --> 00:23:14,620
،أنقذتُ أصدقائي وهزمتُ أعدائي

358
00:23:15,190 --> 00:23:20,120
وفي النّهاية، انضممتُ لأوكتاغرام كأحد
أسياد الشيطان الثمانية

359
00:23:21,320 --> 00:23:23,500
،اسمي هو ريمورو تيمبيست

360
00:23:24,050 --> 00:23:26,880
وأنا هُلام