1
00:00:04,010 --> 00:00:06,650
،بانتهاءِ رحلتي القصيرة إلى دوارغون

2
00:00:06,650 --> 00:00:08,690
عدتُ إلى إنغراشّيا

3
00:00:09,460 --> 00:00:12,700
سأعلن الآن عن نتائج امتحاناتكم الأخيرة

4
00:00:19,280 --> 00:00:20,300
!ماذا؟

5
00:00:20,300 --> 00:00:20,830
...تقصد

6
00:00:21,020 --> 00:00:22,790
سـ-سيّئة إلى هذا الحدّ؟

7
00:00:23,100 --> 00:00:25,040
...أنا آسف، لكن جميعكم

8
00:00:27,020 --> 00:00:28,800
!نجحتم...

9
00:00:31,440 --> 00:00:33,260
!أنت، لا تخفنا هكذا

10
00:00:33,260 --> 00:00:35,430
ارتأيتُ أنّنا بحاجة للمفاجآت بين الحين والآخر

11
00:00:36,020 --> 00:00:37,830
هذا مُطمئن

12
00:00:37,830 --> 00:00:40,810
لـ-لم أكن قلقة من أي شيء

13
00:00:41,040 --> 00:00:43,060
سنتقدّم جميعاً للصفّ التالي إذاً

14
00:00:43,270 --> 00:00:45,110
سنكون معاً من جديد

15
00:00:45,110 --> 00:00:46,690
!أجل! يسرّني ذلك

16
00:00:47,170 --> 00:00:49,350
جميعكم أبليتم حسناً

17
00:00:49,350 --> 00:00:53,450
وهذا يُنهي عملي كمعلّم لكم أيضاً

18
00:00:53,750 --> 00:00:57,520
حالما ينتهي هذا الفصل، ستتولّى
تيس-سينسي عنّي

19
00:00:57,520 --> 00:00:58,950
وسأعود إلى دياري تيمبيست

20
00:01:00,020 --> 00:01:01,200
...سينسي

21
00:01:01,350 --> 00:01:03,520
مهلاً، لا تحزنوا

22
00:01:03,520 --> 00:01:05,210
،سأبقى هنا لبضعة أيّام إضافيّة

23
00:01:05,210 --> 00:01:06,540
!لذا ودّعوني والبسمة في وجوهكم

24
00:01:07,040 --> 00:01:08,820
،حتّى بعد عودتي إلى الدّيار

25
00:01:08,820 --> 00:01:13,170
،آليس، كلوي، ريوتا، كينيا، غيل

26
00:01:13,570 --> 00:01:16,130
ستبقون جميعاً تلاميذي الأعزّاء

27
00:01:16,410 --> 00:01:17,210
حسناً

28
00:01:17,470 --> 00:01:18,930
...سينسي

29
00:01:19,960 --> 00:01:22,680
!لا تنسَ أن تلتزم بوعدك، اتّفقنا؟

30
00:01:22,880 --> 00:01:24,030
وعد؟

31
00:01:24,030 --> 00:01:24,940
!أجل

32
00:01:24,940 --> 00:01:28,940
قلتَ أنّنا إذا حافظنا على علاماتنا عالية
فإنّك ستُقرئنا بقيّة تلك المانغا

33
00:01:29,140 --> 00:01:31,190
أجل، أعلم، أعلم

34
00:01:31,390 --> 00:01:34,380
"سأجهّز لكم كلّ مجلّد من مجلّدات "الطُفيليّ

35
00:01:34,380 --> 00:01:35,740
!مرحى

36
00:01:39,700 --> 00:01:43,500
تيس-سينسي، جميعهم يحرزون تقدُّماً بفضلكِ

37
00:01:43,650 --> 00:01:47,000
لم أكن أنا. إنّما عملهم الدّؤوب

38
00:01:47,000 --> 00:01:50,500
أعلم أنّي أستطيع الوثوق باهتمامكِ بهم
اعتباراً من الفصل التّالي

39
00:01:50,950 --> 00:01:53,220
اعتني بهم لأجلي

40
00:01:53,220 --> 00:01:54,090
!حسناً

41
00:02:02,750 --> 00:02:04,930
حسناً يا ميولان، لقد وصلنا

42
00:02:07,440 --> 00:02:09,220
،تِلك دولة الوحوش

43
00:02:09,220 --> 00:02:11,340
اتّحاد جورا تيمبيست

44
00:03:49,910 --> 00:03:53,540
هذه حليفتُنا الجديدة، ميولان. إنّها ساحرة

45
00:03:53,820 --> 00:03:56,950
مرحباً. سررتُ بلقائك

46
00:03:56,950 --> 00:03:57,970
كذلك أنا

47
00:03:57,970 --> 00:04:00,170
اعتبري نفسكِ في دياركِ

48
00:04:00,540 --> 00:04:05,800
ستكون ميولان مُستشارتنا وناصحتنا العسكريّة
لتساعدنا في محاربة السّحر

49
00:04:05,800 --> 00:04:08,370
!لا بدّ وأنّكِ قويّة إذاً

50
00:04:08,370 --> 00:04:10,650
...ليس إلى هذه الدّرجة

51
00:04:22,160 --> 00:04:23,810
هل يُقام مهرجان؟

52
00:04:23,810 --> 00:04:27,910
لا، سيُعلَن عن عودة ريمورو-ساما
الرسميّة عمّا قريب

53
00:04:28,100 --> 00:04:30,280
نستعدّ للاحتفالِ بذلك

54
00:04:31,930 --> 00:04:35,420
حسناً، ما زالت هناك أمور علينا فعلها

55
00:04:35,420 --> 00:04:36,630
المعذرة

56
00:04:37,340 --> 00:04:40,130
ولا تنسي زيارة النّبع السّاخن لاحقاً

57
00:04:40,480 --> 00:04:41,620
نبع ساخن؟

58
00:04:41,620 --> 00:04:44,140
!ستشعرين براحة كبيرة بعد عمل شاقّ

59
00:04:45,030 --> 00:04:46,620
...شكراً لكِ

60
00:04:54,050 --> 00:04:55,440
...هؤلاء هم الكيجين إذاً

61
00:04:55,840 --> 00:04:58,650
يتمتّع كلٌ منهم بقوّة هائلة

62
00:04:59,240 --> 00:05:02,650
حسناً يا ميولان، دعيني آخذكِ في جولة
تعريفيّة حول تيمبيست

63
00:05:09,740 --> 00:05:11,410
هذه ورشة الحدّادين

64
00:05:11,840 --> 00:05:15,540
هذان الاثنان يصنعان أفضل الأسلحة
والدّروع على الإطلاق

65
00:05:19,620 --> 00:05:20,940
هذه صالة الاستقبال

66
00:05:20,940 --> 00:05:22,210
فاخرة جدّاً، صحيح؟

67
00:05:23,140 --> 00:05:23,970
...أجل

68
00:05:27,460 --> 00:05:29,010
!مرحباً

69
00:05:30,060 --> 00:05:32,020
شكراً على قدومكم

70
00:05:32,200 --> 00:05:34,680
أحضرنا مخزوناً من جرعات الشّفاء لهذا الأسبوع

71
00:05:39,110 --> 00:05:40,440
أجل، جميعها هنا

72
00:05:40,840 --> 00:05:43,110
!وقّع هنا، لو سمحت

73
00:05:43,730 --> 00:05:45,340
شكراً لكم

74
00:05:45,340 --> 00:05:48,780
قد نحتاج لزيادة طلباتنا ابتداءً من الشّهر المقبل

75
00:05:48,780 --> 00:05:51,280
سآتي لمناقشة ذلك قريباً

76
00:05:51,280 --> 00:05:53,740
أبلغ غابيرو بذلك لو سمحت

77
00:05:53,740 --> 00:05:55,540
!عُلِم

78
00:05:57,870 --> 00:06:01,130
يُنتجون هذا العدد الكبير من جرعات الشّفاء؟

79
00:06:01,880 --> 00:06:04,340
قوّتهم العسكريّة وتقنيّاتهم

80
00:06:04,890 --> 00:06:07,740
تجعل هذا المكان خطراً واضحاً على الدُّول الأخرى

81
00:06:07,740 --> 00:06:09,390
ما الأمر؟

82
00:06:10,390 --> 00:06:12,350
لا شيء

83
00:06:12,500 --> 00:06:14,650
أرض التّدريب أمامنا هناك

84
00:06:26,580 --> 00:06:28,410
إنّه ساذج حقّاً

85
00:06:29,040 --> 00:06:32,490
أنا هنا فقط بأمر من كلايمان-ساما

86
00:06:32,940 --> 00:06:34,990
للتحقيق حول دولة الوحوش هذه

87
00:06:35,390 --> 00:06:38,570
أنا أستغلّك فقط يا يوم

88
00:06:40,230 --> 00:06:41,420
يا لك من أحمق

89
00:06:41,960 --> 00:06:45,880
وهو حتّى لا يشكّ بأنّي ماجين على الأرجح

90
00:06:47,160 --> 00:06:48,880
حسناً، حان وقت الاستراحة

91
00:06:57,810 --> 00:06:59,570
...مؤلم

92
00:06:59,570 --> 00:07:02,980
...كان العجوز جادّاً تماماً اليوم

93
00:07:03,280 --> 00:07:05,360
أنا مسحوق

94
00:07:05,640 --> 00:07:08,940
—غـ-غوبتا، هل ذاك الغول

95
00:07:08,940 --> 00:07:12,910
أعني، هل السيّد هاكورو هكذا دوماً؟

96
00:07:13,200 --> 00:07:15,010
بالتأكيد

97
00:07:15,010 --> 00:07:16,450
أنا مسحوق

98
00:07:16,700 --> 00:07:19,460
!تبّاً... هذا ليس هزلاً

99
00:07:20,400 --> 00:07:23,080
هيّا يا شباب. انهضوا

100
00:07:24,100 --> 00:07:25,960
الأمر هكذا... في كلّ مرّة؟

101
00:07:27,960 --> 00:07:32,840
المُدهش أكثر حتّى أنّكم ما زلتم على قيدِ الحياة

102
00:07:33,250 --> 00:07:36,090
أتمنّى لو نستطيع ضمّكم إلى مملكة الحيوان

103
00:07:36,090 --> 00:07:37,870
غريشيس

104
00:07:38,620 --> 00:07:40,200
هذا أنت يا يوم

105
00:07:42,940 --> 00:07:44,690
تبّاً، أنت في حالةٍ يُرثى لها

106
00:07:44,690 --> 00:07:45,880
!اصمت

107
00:07:46,380 --> 00:07:47,240
من هي؟

108
00:07:47,240 --> 00:07:51,320
هذه ميولان، أكثر عضو موهوب لدينا

109
00:07:51,320 --> 00:07:53,640
حتّى أنت لن تصمد أمامها

110
00:07:53,640 --> 00:07:54,720
أكثر عضو موهوب لديكم؟

111
00:07:54,720 --> 00:07:59,000
إذاً يا يوم، أتريد أن تقول لي أنّ هذه الفتاة
الصّغيرة الهزيلة هزمتك؟

112
00:07:59,260 --> 00:08:01,560
سيتوجّب عليك مقاتلتها بنفسك وترى

113
00:08:01,560 --> 00:08:05,680
إن تمكّنت من هزيمتها، سأدعوك "زعيم" من الآن فصاعداً

114
00:08:05,680 --> 00:08:08,730
،موافق! وإن هزمتني الفتاة

115
00:08:08,730 --> 00:08:10,510
!سأصبح تابعك

116
00:08:12,260 --> 00:08:15,850
بخلاف يوم، لن أتساهل معكِ لكونكِ فتاة

117
00:08:17,930 --> 00:08:19,040
!ها أنا قادم

118
00:08:25,530 --> 00:08:27,610
هذا ممتع يا ميولان. ينبغي أن نستدعي مزيداً من النّاس

119
00:08:27,610 --> 00:08:30,240
!وتعتبر نفسك بطلاً؟! تعال وساعدني

120
00:08:32,160 --> 00:08:33,270
أنتِ

121
00:08:33,960 --> 00:08:35,350
ربحتِ

122
00:08:35,890 --> 00:08:37,370
تعترف بذلك؟

123
00:08:37,520 --> 00:08:39,090
لا أملك خياراً الآن

124
00:08:39,090 --> 00:08:41,750
أنتِ قويّة جدّاً. أنا مُندهش

125
00:08:41,910 --> 00:08:42,840
رأيت؟

126
00:08:43,620 --> 00:08:46,480
...حسناً يا غريشيس، بشأن ما وعدتَ به

127
00:08:46,480 --> 00:08:49,420
أجل، بالتأكيد. يمكنك أن تكون الزعيم

128
00:08:49,420 --> 00:08:51,740
...لا، كنتُ أمزح بشأن ذلك

129
00:08:51,740 --> 00:08:53,720
يبقى الوعد وعداً

130
00:08:53,720 --> 00:08:55,560
لكن سأكون صادقاً

131
00:08:56,250 --> 00:08:59,620
،إذا أمرني كاريون-ساما بقتلك

132
00:09:00,070 --> 00:09:02,700
فلن أتردّد في فعل ذلك

133
00:09:02,700 --> 00:09:06,730
آسف، لكن هذه قاعدة حديديّة بالنسبة لي

134
00:09:07,370 --> 00:09:10,230
فهمت. سأتذكّر ذلك

135
00:09:14,940 --> 00:09:17,910
وسأنضمّ إلى حزبك

136
00:09:17,910 --> 00:09:19,830
أريد رؤية بعض الدّول الأخرى على أي حال

137
00:09:19,830 --> 00:09:22,830
لا مانع لديّ... لكن هل أنت متأكّد؟

138
00:09:22,960 --> 00:09:25,350
،مهمّتي هي توسيع آفاقي

139
00:09:25,350 --> 00:09:26,870
لذا سأفعل ما أرغب في فعله فحسب

140
00:09:27,350 --> 00:09:30,630
كانت تلك المعركة مدهشة حقّاً

141
00:09:30,630 --> 00:09:31,800
غوبتا؟

142
00:09:31,800 --> 00:09:33,990
أنا مُقتنع الآن

143
00:09:33,990 --> 00:09:35,810
،بسحر الآنسة

144
00:09:35,810 --> 00:09:37,680
!بمقدورنا هزيمة العجوز

145
00:09:37,870 --> 00:09:40,790
مهلاً، مهلاً! هل تقصد السيّد هاكورو؟

146
00:09:40,790 --> 00:09:42,270
هل لديك خطّة أو ما شابه؟

147
00:09:44,180 --> 00:09:47,950
...اسمعا. أولاً، سنستخدم سحر ميولان كي

148
00:09:48,610 --> 00:09:51,910
ماذا أفعلُ بالضبط؟

149
00:09:52,570 --> 00:09:55,070
معركة صوريّة؟

150
00:09:55,240 --> 00:09:58,330
!اليوم هو اليوم الذي سنجعلك فيه تصيح ألماً

151
00:09:58,330 --> 00:10:01,730
!آمل أن تكون مستعدّاً يا عجو... يا معلّم

152
00:10:01,730 --> 00:10:04,160
يبقى الاستفزاز استفزازاً

153
00:10:04,160 --> 00:10:05,800
أثني على معنويّاتك العالية

154
00:10:05,800 --> 00:10:09,170
حان الوقت لأمنحكم تدريباً حقيقيّاً من جديد

155
00:10:09,360 --> 00:10:12,000
دائرتنا السحريّة المُعدّة مُسبَقاً في مكانها

156
00:10:12,000 --> 00:10:14,420
...إذا اقتدناه إليها فحسب

157
00:10:15,510 --> 00:10:17,930
حسناً، هل نبدأ؟

158
00:10:19,890 --> 00:10:22,060
!عرفتُ أنّه سيهجم عليّ بشكل مُباشر

159
00:10:22,770 --> 00:10:23,940
تسييل

160
00:10:26,770 --> 00:10:28,940
—أمسكنا به! والآن جميعنا سنهاجم

161
00:10:30,210 --> 00:10:30,690
!ماذا؟

162
00:10:30,850 --> 00:10:32,610
أين اختفى العجوز؟

163
00:10:34,580 --> 00:10:36,320
!أتقول "عجوز"؟

164
00:10:37,070 --> 00:10:39,070
—مـ-مـ-مـ-مهلاً

165
00:10:39,070 --> 00:10:40,100
!مؤلم

166
00:10:41,570 --> 00:10:42,680
!مستحيل

167
00:10:42,680 --> 00:10:44,590
!كيف تمكّن من الحركة؟

168
00:10:44,590 --> 00:10:47,660
خطوة الوميض. علّمتُك إيّاها، أليس كذلك؟

169
00:10:58,100 --> 00:11:01,060
والآن، دعوني أستمع إلى مبرّراتكم

170
00:11:01,060 --> 00:11:05,180
ما الذي دفعكم لمُحاولة الإيقاع بي في فخّ؟

171
00:11:08,560 --> 00:11:09,310
...المعذرة

172
00:11:09,310 --> 00:11:12,050
لا داعي لتقولي شيئاً أيّتها الشابّة

173
00:11:12,050 --> 00:11:15,820
أنا متأكّدٌ أنّ هؤلاء الحمقى هم من أقحموكِ في هذا

174
00:11:16,080 --> 00:11:17,300
حسناً

175
00:11:17,690 --> 00:11:20,890
،في حال احتجتم لأي تذكير

176
00:11:20,890 --> 00:11:24,990
إيّاكم والتّفكير في محاولة اختبار ريمورو-ساما
ولو بشكلٍ عرَضيّ حتّى

177
00:11:24,990 --> 00:11:29,500
أتظنّ أنّنا بحاجةٍ لتذكير؟ نعلم أنّنا لسنا ندّاً لريمورو-ساما

178
00:11:29,650 --> 00:11:34,420
حقّاً؟ ينتابني إحساس بأنّه كان لينخدع بسهولة

179
00:11:35,260 --> 00:11:37,420
ما الأمر؟ أصبتَ بنزلة برد؟

180
00:11:37,620 --> 00:11:40,360
لا، أحدهم يتكلّم عنّي غالباً

181
00:11:40,360 --> 00:11:42,720
بالطبع، فأنت ذو شعبيّة كبيرة

182
00:11:43,400 --> 00:11:44,990
ما رأيك بالمزيد؟

183
00:11:44,990 --> 00:11:46,950
بالتأكيد، أقبل بذلك

184
00:11:51,020 --> 00:11:53,190
أشعر بالانتعاش من جديد

185
00:11:53,610 --> 00:11:56,730
لا أعتقد أنّ ذلك العجوز كان ليموت ولو قتلناه

186
00:11:56,730 --> 00:12:02,530
غوبتا، أنصحك بنسيان فكرة مُحاولة مُباغتة السيّد هاكورو

187
00:12:02,530 --> 00:12:05,080
!سأردّ له الاعتبار يوماً ما

188
00:12:05,080 --> 00:12:07,300
عزيمتك عجيبة

189
00:12:07,300 --> 00:12:11,410
!على أي حال، تلك الآنسة السحريّة مذهلة

190
00:12:12,210 --> 00:12:14,760
أليس كذلك؟ إنّها جذّابة جدّاً أيضاً

191
00:12:14,760 --> 00:12:16,050
لا جدل حول هذا

192
00:12:16,050 --> 00:12:17,860
...أتساءل ما إن كانت ستحمل ابني

193
00:12:17,860 --> 00:12:20,180
!مهلاً! لن يحدث هذا أبداً

194
00:12:20,180 --> 00:12:21,840
!فهي تعمل لصالحي

195
00:12:22,390 --> 00:12:25,220
كلّ شيء مُباح في الحبّ. والغنائم
تكون من نصيب الأسرع

196
00:12:25,220 --> 00:12:27,770
!الغنائم من نصيب الأسرع؟! فهمت

197
00:12:27,770 --> 00:12:29,720
!حتّى أنت أيضاً

198
00:12:33,700 --> 00:12:35,560
أمر أولئك الفتيان عجيب

199
00:12:36,210 --> 00:12:37,980
!لا تقلقي يا أميرة شونا

200
00:12:37,980 --> 00:12:41,900
!سأقوّم سلوكهم بضربهم حتّى البُكاء

201
00:12:41,900 --> 00:12:43,910
سأساعدكِ في ذلك

202
00:12:59,170 --> 00:13:01,360
!اقرأ أسرع

203
00:13:01,360 --> 00:13:03,800
تمهّلي. وصلتُ للجزء الممتع للتو

204
00:13:03,800 --> 00:13:05,910
...لم أتوقّع حدوث هذا

205
00:13:05,910 --> 00:13:07,430
أنا متفاجئ حقّاً

206
00:13:12,090 --> 00:13:14,620
حسناً، ما أخبار العمل؟

207
00:13:14,620 --> 00:13:18,440
بفضلك، جرعات الشّفاء عالية الجودة خاصّتنا
جذبت اهتمام الكثير من الزبائن

208
00:13:18,780 --> 00:13:21,820
،حرصنا على نشر الأنباء في الأقاليم الغربيّة

209
00:13:21,820 --> 00:13:24,700
لذا ينبغي أن نحصل على كثير من الطلبات
من الآن فصاعداً

210
00:13:24,700 --> 00:13:27,450
وستحقّق ثروة كبيرة، صحيح؟

211
00:13:27,450 --> 00:13:31,450
بالطبع. فهذه هي طبيعة عملي

212
00:13:31,450 --> 00:13:33,310
!لكن لا تقلق

213
00:13:33,310 --> 00:13:37,440
!سأسدّد لتيمبيست حصّتها بعدل

214
00:13:37,440 --> 00:13:39,540
لم أكن قلقاً بشأن ذلك

215
00:13:40,110 --> 00:13:43,050
!سأسدّد بشأن اليوم أيضاً بالطبع

216
00:13:43,050 --> 00:13:47,300
لأشكرك على العمل ولأقيم لك حفلة وداع بسيطة

217
00:13:47,600 --> 00:13:49,800
سيكون هذا من دواعي سروري

218
00:13:51,510 --> 00:13:54,670
كان البارون فيريارد ممتنّاً لك أيضاً

219
00:13:54,670 --> 00:13:56,510
،حالما تُطرح جرعات الشّفاء تلك في السّوق

220
00:13:56,510 --> 00:13:59,190
ستحقّق مملكة بلوموند أرباحاً أيضاً

221
00:13:59,940 --> 00:14:01,800
فيريارد؟

222
00:14:05,440 --> 00:14:10,760
من الرّائع أن توقّع تيمبيست ومملكة بلوموند
...معاهدة دفاع مُشترك، لكن

223
00:14:12,910 --> 00:14:14,660
خدعوني حقّاً

224
00:14:14,660 --> 00:14:18,600
،إذا قامت دولة أخرى بغزو بلوموند عبر الغابة

225
00:14:18,600 --> 00:14:21,460
ستكون تيمبيست بمثابة الحاجز

226
00:14:21,460 --> 00:14:24,180
هكذا هي السّياسة

227
00:14:24,180 --> 00:14:28,470
،لكن إذا حاولت دولة أخرى غزو تيمبيست

228
00:14:28,470 --> 00:14:31,020
ستقاتل بلوموند في صفّك على الأرجح

229
00:14:31,020 --> 00:14:33,470
إنّها مصلحة مُتبادَلة

230
00:14:33,640 --> 00:14:36,000
...لكن لا يمكن لتيمبيست أن يتمّ غزوها

231
00:14:36,000 --> 00:14:39,770
لا أحد يعلم ما قد يحدث

232
00:14:40,360 --> 00:14:46,010
أتوقّع أنّ تيمبيست في طريقها لتصبح
مركزاً تجاريّاً رئيسيّاً

233
00:14:46,010 --> 00:14:48,490
قال دورف-سان كلاماً من هذا القبيل أيضاً

234
00:14:48,640 --> 00:14:50,500
،وإن حدث هذا

235
00:14:50,500 --> 00:14:53,690
فإنّ بعض البلدان ستعتبر تيمبيست مصدر إزعاج

236
00:14:53,690 --> 00:14:57,620
مثلاً... مملكة فالموث على سبيل المثال

237
00:15:00,850 --> 00:15:04,730
حسناً، لا سبب لتوقّع حدوث أي شيء
بشكل فوريّ

238
00:15:04,730 --> 00:15:07,630
!أقول فقط أنّه لا ضير من توخّي الحذر

239
00:15:08,240 --> 00:15:10,160
أجل، معك حقّ

240
00:15:11,190 --> 00:15:13,190
...مملكة فالموث

241
00:15:13,850 --> 00:15:18,090
قال الملك غازيل أنّه لم يحبّ ملكهم

242
00:15:18,090 --> 00:15:20,510
...قال أنّه طمّاع جدّاً أو ما شابه

243
00:15:25,690 --> 00:15:27,780
أتقول يوم البطل؟

244
00:15:28,040 --> 00:15:30,480
أجل. يُشاع أنّ حزبه

245
00:15:30,480 --> 00:15:34,530
هزمَ سيّد الأورك وجيشه

246
00:15:35,880 --> 00:15:38,790
مع أنّه من السّخيف تسميته بالبطل حتّى

247
00:15:38,790 --> 00:15:43,540
أبلغ اتِّحادُ الحرّية بتقرير أنّ سيّد
الأورك كان قد ظهر

248
00:15:43,740 --> 00:15:47,640
...ما يعني أنّه لا يمكن نكران هذه الحقيقة تماماً

249
00:15:47,960 --> 00:15:50,200
...وبالنسبة ليوم البطل

250
00:15:50,200 --> 00:15:52,970
يبدو أنّه أقام في تيمبيست

251
00:15:54,310 --> 00:15:58,220
تيمبيست... دولة الوحوش؟

252
00:15:58,450 --> 00:16:01,180
،أجل، منذ تأسيسها

253
00:16:01,180 --> 00:16:04,630
،انحسر تدفّق التُجّار إلى مملكة فالموث

254
00:16:04,630 --> 00:16:06,980
ووضعها الماليّ اتّخذ منحى للأسوأ

255
00:16:07,250 --> 00:16:12,560
هذا لأنّهم يستطيعون العبور بأمان إلى دوارغون
دون العبور من هنا

256
00:16:13,730 --> 00:16:17,850
هذه مسألة حياة وموت بالنسبة لمملكةِ فالموث

257
00:16:17,850 --> 00:16:20,320
،إن استمرّت دولة الوحوش هذه دون رادع

258
00:16:20,320 --> 00:16:23,040
،ستصبح معروفة في الأقاليم الغربيّة كذلك

259
00:16:23,040 --> 00:16:25,530
وسيُمسي أي تصرّف ضدّها غير مقبول

260
00:16:25,970 --> 00:16:27,630
وقت الهجوم يجب أن يكون الآن

261
00:16:27,830 --> 00:16:30,700
لكن سيكون الوحوش المُتطوّرون مشكلة

262
00:16:31,130 --> 00:16:33,360
،يتمتّعون بذكاء نظراً لهيئاتهم البشريّة

263
00:16:33,360 --> 00:16:35,930
ما سيجعلهم خصوماً عتيدين جدّاً

264
00:16:35,930 --> 00:16:40,280
كم عدد الرّجال الذين نستطيع حشدهم بشكلٍ فوريّ؟

265
00:16:40,280 --> 00:16:42,330
حوالي 17.000

266
00:16:42,770 --> 00:16:44,060
هذا لا يكفي

267
00:16:46,060 --> 00:16:48,690
لا تقلق يا جلالة الملك

268
00:16:50,600 --> 00:16:52,940
رئيس الأساقفة ريهيم

269
00:16:52,940 --> 00:16:56,320
هل لدى الكنيسة المُقدّسة الغربيّة خطّة ما؟

270
00:16:56,540 --> 00:16:58,330
أجل، أجل

271
00:16:58,330 --> 00:17:02,010
مقرّ الكنيسة المُقدّسة الغربيّة يخطّط
لإخضاع دولة الوحوش

272
00:17:02,010 --> 00:17:07,460
بصفتها دولة عدوّة معارضة للإله

273
00:17:07,810 --> 00:17:09,210
ماذا؟

274
00:17:09,210 --> 00:17:13,760
!الكنيسة اعتبرت تلك الدّولة عدوّاً لإلهنا؟

275
00:17:16,760 --> 00:17:20,120
غير أنّه لم يقع أي ضرر بعد

276
00:17:20,120 --> 00:17:24,940
لذا إذا استطعنا طلب مساعدة من بلد
...آخر ما لإخضاعهم

277
00:17:26,340 --> 00:17:29,160
مساعدة من بلد؟

278
00:17:32,060 --> 00:17:34,510
...لنفترض جدلاً

279
00:17:35,490 --> 00:17:39,200
،إذا تعرّض مواطنٌ من بلدنا لأذى بواسطة تيمبيست

280
00:17:39,200 --> 00:17:41,450
ماذا سيحدث برأيك؟

281
00:17:41,770 --> 00:17:43,550
أجل، أجل

282
00:17:43,550 --> 00:17:45,920
إذا حدث ذلك، فإنّ الكنيسة المُقدّسة الغربيّة

283
00:17:45,920 --> 00:17:50,590
ستتبنّى مسؤوليّة إرسال فُرسان المعبد
لإنقاذ المؤمنين

284
00:17:50,590 --> 00:17:52,740
هذا مُطمئن جدّاً

285
00:17:52,740 --> 00:17:57,590
إذاً بمقدورنا أن نشرع في إخضاعِ الوحوش بكلّ جرأة

286
00:17:57,590 --> 00:17:58,740
حسناً

287
00:17:59,370 --> 00:18:01,780
!ستكون هذه المعركة حرباً مُقدّسة

288
00:18:01,780 --> 00:18:05,350
!ابدأوا بإرسال فرقة مُتقدِّمة لإحداث جلبة

289
00:18:05,530 --> 00:18:09,070
،جلالة الملك، لنستعرض لهم قوّتنا

290
00:18:09,070 --> 00:18:12,860
أرى أنّنا ينبغي أن أرسل أولئك الأُخروّيين

291
00:18:13,010 --> 00:18:14,760
هكذا إذاً

292
00:18:14,760 --> 00:18:18,230
أولئك الشّنيعون قد يكونون نافعين حقّاً

293
00:18:18,230 --> 00:18:21,070
لكن يجب أن نبقى يقظين

294
00:18:21,070 --> 00:18:22,870
،من باب الحيطة والحذر

295
00:18:22,980 --> 00:18:26,500
سنأمرهم بالعودة بعد فترة قصيرة من الهيَجان

296
00:18:26,740 --> 00:18:32,470
جلالة الملك، إذا كان هذا يرضيك، هلّي
باختبار فنّي السرّي؟

297
00:18:32,470 --> 00:18:34,270
فنّك السرّي؟

298
00:18:34,670 --> 00:18:36,090
المعذرة

299
00:18:50,400 --> 00:18:52,290
!يبدو ذلك مُثيراً للاهتمام

300
00:18:52,290 --> 00:18:55,070
عظيم. سأسمح بذلك يا ريهيم

301
00:18:55,220 --> 00:18:57,000
شكراً جزيلاً لك

302
00:18:57,000 --> 00:19:01,240
أعِدك أنّي سأستخدمه لأجل مجد جلالتك

303
00:19:11,190 --> 00:19:13,630
دولة يحكمها هُلام؟

304
00:19:14,930 --> 00:19:16,510
!أتسخر منّي؟

305
00:19:16,680 --> 00:19:18,950
شوغو، اهدأ

306
00:19:18,950 --> 00:19:20,840
دعني أكمل كلامي

307
00:19:20,840 --> 00:19:22,670
!الهُلاميّات وحوش ضعيفة

308
00:19:22,670 --> 00:19:24,810
!كيف لهُلام أن يصبح حاكم الغابة؟

309
00:19:24,970 --> 00:19:27,860
لا يقصد شوغو-سان أي إهانة

310
00:19:27,860 --> 00:19:32,520
في عالمنا، الهُلاميّات معروفة بكونها وحوشاً ضعيفة

311
00:19:32,520 --> 00:19:35,890
بغضّ النظر، أريدكم أنتم الثّلاثة
أن تذهبوا إلى تيمبيست

312
00:19:35,890 --> 00:19:39,670
رفقة 100 فارس كفرقة مُتقدِّمة

313
00:19:39,670 --> 00:19:40,670
مفهوم؟

314
00:19:46,170 --> 00:19:49,410
!مذهل، مضتْ فترة منذ خرجنا في رحلة

315
00:19:49,410 --> 00:19:50,910
!أي مهزلة هي هذه؟

316
00:19:50,910 --> 00:19:53,460
أيحشدون جيشاً لمجرّد هُلام حقّاً؟

317
00:19:53,620 --> 00:19:56,850
حسناً، عندما يتحكّم ذلك الهُلام بجيش
،من عشرات الآلاف

318
00:19:56,850 --> 00:19:59,470
فمن الطبيعيّ جدّاً حينئذ أن يُعدّ خطراً

319
00:19:59,760 --> 00:20:01,180
لا أدري بشأن ذلك

320
00:20:01,180 --> 00:20:04,760
فالبشر في هذا العالم ضُعفاء جدّاً

321
00:20:06,040 --> 00:20:08,810
بل قُل أنّك أنت القويّ زيادة عن اللُّزوم يا شوغو

322
00:20:08,940 --> 00:20:12,820
المهارات الفريدة من نوعها المُخصّصة للقتال
...عشوائيّة جدّاً فحسب، أليس كذلك

323
00:20:12,820 --> 00:20:14,680
أيّها المسعور؟

324
00:20:14,680 --> 00:20:18,320
لا، إن سألتِني، أقول أنّ مهاراتكِ مخيفة أكثر يا كيرارا

325
00:20:18,640 --> 00:20:22,290
بالفعل. حتّى أنا أعتقد أنّ مهاراتكِ أخطر

326
00:20:24,990 --> 00:20:27,290
!لكن اللّعنة على ذلك العجوز الوغد

327
00:20:27,290 --> 00:20:29,540
!يظنّ نفسه أنّه يستطيع أن يأمرنا؟

328
00:20:29,750 --> 00:20:31,770
بالفعل، إنّه مزعج للغاية

329
00:20:31,770 --> 00:20:33,790
أقسم أنّي سأقتله يوماً ما

330
00:20:33,940 --> 00:20:36,280
مهلاً، لا تقولي ذلك

331
00:20:36,280 --> 00:20:38,460
،إذا فعلنا ما يُمليه علينا على الأقلّ

332
00:20:38,460 --> 00:20:42,260
فسيمنحنا أفضل الطعام واللّباس والمسكن
في هذا العالم

333
00:20:42,260 --> 00:20:44,840
ماذا؟ لكن ألا ينبغي أن يكون هذا أمراً بديهيّاً؟

334
00:20:44,840 --> 00:20:47,050
"إنّ "أفضل ما في هذا العالم

335
00:20:47,050 --> 00:20:49,890
يبقى قمامة مقارنةً بما يوجد في عالمنا

336
00:20:49,890 --> 00:20:51,540
معك حقّ

337
00:20:51,540 --> 00:20:53,740
لا متاجر أزياء أو مُستحضرات تجميل هنا

338
00:20:53,740 --> 00:20:56,440
!لا تلفزيون وإنترنت أو حتّى هواتف ذكيّة هنا

339
00:20:56,440 --> 00:21:01,940
فليسقط مثل هذا العالم المُملّ والمضجر

340
00:21:06,010 --> 00:21:08,640
،شوغو وكيرارا لا يبدوان سعيدين بذلك

341
00:21:08,640 --> 00:21:10,950
لكن أرى هذه فُرصة

342
00:21:11,520 --> 00:21:16,010
إذا اندلعت حرب، يمكننا قتل من يتحكّم بنا

343
00:21:16,010 --> 00:21:18,750
ونحظى بفرصة تحرير أنفسنا

344
00:21:37,070 --> 00:21:39,400
في ذلك الوقت، لم أكن أملك أدنى فكرة

345
00:21:40,040 --> 00:21:43,780
عن أنّ كارثة كانت على وشك أن تحلّ على تيمبيست

346
00:23:35,880 --> 00:23:38,960
"الحلقة القادمة، "تمهيد للكارثة