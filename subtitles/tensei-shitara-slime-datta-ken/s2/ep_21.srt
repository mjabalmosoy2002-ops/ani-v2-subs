1
00:00:02,610 --> 00:00:06,200
،عندما كان بينيمارو والآخرون يواجهون قوّات كلايمان

2
00:00:06,910 --> 00:00:10,920
كنّا نحن نستعدّ لحضور والبورغيس

3
00:00:11,370 --> 00:00:13,970
!تبدو رائعاً يا ريمورو-ساما

4
00:00:13,970 --> 00:00:15,870
!أجل! رائع للغاية

5
00:00:15,870 --> 00:00:19,430
!هذا المظهر الوقور! إنّه يلائمك بشكل مثالي يا مولايّ

6
00:00:20,880 --> 00:00:22,220
حـ-حقّاً؟

7
00:00:22,220 --> 00:00:25,060
!الأميرة شونا، تبدين جميلة أيضاً

8
00:00:27,470 --> 00:00:28,680
شكراً لكِ

9
00:00:29,680 --> 00:00:32,380
حسناً إذاً، سأنصرف الآن

10
00:00:34,130 --> 00:00:34,760
!الأميرة شونا

11
00:00:35,220 --> 00:00:38,490
!اذهبي وأوسعي أتباع كلايمان ضرباً

12
00:00:38,490 --> 00:00:39,680
!لأجلنا كذلك

13
00:00:40,380 --> 00:00:41,170
سأفعل

14
00:00:41,890 --> 00:00:43,330
كوني حذرة

15
00:00:43,330 --> 00:00:45,110
سأفعل. وأنت كذلك يا ريمورو-ساما

16
00:00:58,180 --> 00:01:02,490
...اقترب وقت الانطلاق ويبدون مسترخين تماماً

17
00:01:03,110 --> 00:01:06,500
إذاً هناك عشرة أسياد شيطان، صحيح؟

18
00:01:06,500 --> 00:01:11,030
...هناك ميليم وراميريس وليون وكاريون وفري وكلايمان

19
00:01:11,030 --> 00:01:13,170
ماذا عن الأربعة الآخرين؟

20
00:01:13,410 --> 00:01:16,630
لستُ مهتمّاً بضعفاء

21
00:01:16,630 --> 00:01:21,930
لكن قبل ألفي أو ثلاثة آلاف عام، قاتلتُ
سيدة شيطان مصّاصة دماء

22
00:01:21,930 --> 00:01:23,180
سيّدة شيطان؟

23
00:01:23,460 --> 00:01:25,890
كانت امرأة لا تعرف المزاح

24
00:01:25,890 --> 00:01:28,820
أحرقتُ مدينتهم فاستشاطوا غضباً

25
00:01:28,820 --> 00:01:31,380
!من الطبيعي أن يُغضبهم ذلك

26
00:01:31,380 --> 00:01:32,650
...صـ-صحيح

27
00:01:32,650 --> 00:01:36,320
باستذكار الأمر الآن، ينتابني شعور
بالندم قليلاً على ذلك

28
00:01:36,540 --> 00:01:38,320
قليلاً؟

29
00:01:38,320 --> 00:01:40,970
...أعتقد أنّ اسمها كان... لو

30
00:01:40,970 --> 00:01:44,440
لوروس؟ لا، أعتقد كان ميليس

31
00:01:44,440 --> 00:01:48,330
لم أكن آخذ الأمر بجدّية، لكنّها كانت قويّة
بما يكفي لتكون رفيقة لي

32
00:01:48,330 --> 00:01:50,460
لذا حريّ بك أن تكون حذراً

33
00:01:50,610 --> 00:01:56,220
وأمسى رجلٌ يُدعى روي فالنتاين سيّد شيطان
تلك الدّولة منذ 1.500 سنة إلى الآن

34
00:01:56,360 --> 00:01:57,940
تولّى زمام الأمور عنها إذاً؟

35
00:01:58,730 --> 00:01:59,510
!ماذا؟

36
00:01:59,650 --> 00:02:02,400
!لا أصدّق أنّ عدوّاً جديداً يظهر الآن

37
00:02:02,400 --> 00:02:04,270
!يا لها من نهاية مُشوّقة لهذا العدد

38
00:02:04,530 --> 00:02:07,200
!اتّخذ الأمر بجدّية وإلّا أحرقت الأحداث عليك

39
00:02:07,200 --> 00:02:09,370
لا داعي لتكون حسّاساً هكذا

40
00:02:09,370 --> 00:02:12,520
هناك أيضاً سيّد شيطان عملاق اسمه داغرول

41
00:02:12,720 --> 00:02:15,770
قاتلتُه بضع مرّات، لكن دون وجود مُنتصر

42
00:02:16,480 --> 00:02:20,660
بما أنّك تتذكّر اسمه، فلا بدّ أنّه قويّ جدّاً

43
00:02:20,660 --> 00:02:23,410
لا، إذا قاتلتُه الآن فسأفوز

44
00:02:23,610 --> 00:02:26,170
،وأيضاً، مع أنّني لم أقاتله

45
00:02:26,170 --> 00:02:29,290
لكن هناك سيّد شيطان هو في واقع الأمر
شيطان ويُدعى غي كريمزون

46
00:02:29,290 --> 00:02:31,060
لم تقاتله؟

47
00:02:31,060 --> 00:02:33,420
يعيش في الأعالي في أقصى الشّمال

48
00:02:33,420 --> 00:02:38,870
لا حاجة لشخص عظيم مثلي أن يغامر
!بالذهاب إلى أرض بعيدة كهذه

49
00:02:40,430 --> 00:02:43,550
هذا صحيح. غي قويّ جدّاً

50
00:02:43,930 --> 00:02:47,490
غي وميليم وأنا الأقدم من بين أسياد الشّيطان

51
00:02:48,360 --> 00:02:50,600
هكذا إذاً

52
00:02:50,600 --> 00:02:52,280
ومن الأخير؟

53
00:02:53,140 --> 00:02:55,900
لا أعلم

54
00:02:55,900 --> 00:02:57,400
إنّه دينو

55
00:02:57,400 --> 00:03:00,910
لا يفعل شيئاً سوى النّوم ويعشق
!التّكاسل حتّى أكثر منّي

56
00:03:01,120 --> 00:03:03,510
هناك آخر مثلكِ؟

57
00:03:03,990 --> 00:03:05,320
!لا تقل أنّه مثلي

58
00:03:06,090 --> 00:03:07,900
...إذاً صاروا عشرة

59
00:03:09,050 --> 00:03:10,680
يبدو أنّ الوقت قد حان

60
00:03:10,680 --> 00:03:12,420
!وصلت وسيلة نقلنا

61
00:03:17,530 --> 00:03:19,090
ما هذا التصميم؟

62
00:03:19,440 --> 00:03:21,320
إنّه مُعقّد جداً

63
00:03:26,050 --> 00:03:28,600
أتيتُ لأقلكِ يا راميريس

64
00:03:29,010 --> 00:03:30,140
...هذه الخادمة

65
00:03:30,530 --> 00:03:32,720
مُخيفة بقدر ديابلو

66
00:03:33,200 --> 00:03:35,960
إنها شيطانة إذاً، وبمرتبة رفيعة كذلك

67
00:03:35,960 --> 00:03:39,900
لم أركِ منذ وقت يا ميزاري! كيف حال شريكتك راين؟

68
00:03:40,150 --> 00:03:41,960
بخير كالعادة. شكراً لسؤالك

69
00:03:42,480 --> 00:03:44,320
أنت ريمورو-ساما؟

70
00:03:45,360 --> 00:03:49,250
حدّثني مولايّ غي-ساما عنك

71
00:03:49,250 --> 00:03:52,080
إنّها تخدم غي، أحد أقدم أسياد الشّيطان؟

72
00:03:52,230 --> 00:03:53,970
تفضّلوا بالدخول

73
00:03:53,970 --> 00:03:56,900
!حسناً، هيّا بنا يا بيريتّا وتريني

74
00:03:56,900 --> 00:03:58,690
أمرك يا راميريس-ساما

75
00:03:58,690 --> 00:04:00,210
سأرافقك

76
00:04:00,210 --> 00:04:02,340
توخّي الحذر من فضلك يا راميريس-ساما

77
00:04:04,260 --> 00:04:06,100
من ينتظر وراء هذا الباب

78
00:04:06,340 --> 00:04:08,480
...الأشخاص الذين يسيطرون على هذا العالم

79
00:04:09,180 --> 00:04:12,280
،لكن الآن بعد أن قرّرتُ أن أصبح سيّد شيطان

80
00:04:12,280 --> 00:04:14,340
لن أخاف

81
00:04:15,030 --> 00:04:15,870
هيّا بنا

82
00:04:16,490 --> 00:04:17,260
!حاضر

83
00:04:23,350 --> 00:04:24,770
،ريمورو-ساما

84
00:04:24,770 --> 00:04:27,490
والبقيّة، توخّوا الحذر

85
00:04:27,490 --> 00:04:30,740
!إذا حدث أي شيء، يمكنك استدعائي فوراً

86
00:06:11,540 --> 00:06:14,030
أين قلعة كلايمان؟

87
00:06:14,030 --> 00:06:18,190
هذا الضباب يحجب الكشف السّحري الخاص بي

88
00:06:18,600 --> 00:06:22,190
يبدو أنّ عدوّنا يستخدم الضباب للحصول على معلومات

89
00:06:31,960 --> 00:06:35,080
أرى أنّنا دخلنا فخّاً

90
00:06:35,080 --> 00:06:36,470
فخّ؟

91
00:06:36,470 --> 00:06:38,510
...لا أشعر بوجود أي عدوّ

92
00:06:38,510 --> 00:06:39,330
!ماذا؟

93
00:06:44,100 --> 00:06:45,110
...كيف

94
00:06:45,590 --> 00:06:49,970
هناك عدد كبير. أين اختبأوا حتّى لم نشعر بحضورهم؟

95
00:06:50,180 --> 00:06:52,680
لم يكن العدوّ يختبئ

96
00:06:52,680 --> 00:06:54,720
...استدرجونا

97
00:06:55,780 --> 00:06:57,430
إلى عقر دارهم

98
00:06:57,730 --> 00:07:01,440
بتعطّل الكشف السحريّ، لا سبيل لدينا لمعرفة أعدادهم

99
00:07:01,620 --> 00:07:04,190
...لكن إذا كانت أعدادهم هي أفضليّتهم الوحيدة

100
00:07:04,820 --> 00:07:07,420
الأميرة شونا، سوف أخترقهم

101
00:07:07,420 --> 00:07:08,920
—بينما أفعل، أنتِ والمعلّم هاكورو

102
00:07:08,920 --> 00:07:10,240
لا يا سوي

103
00:07:11,210 --> 00:07:14,030
لا يبدو أنّهم سيسمحون بالأمر بتلك البساطة

104
00:07:18,990 --> 00:07:21,150
...يا لها من قوّة سحريّة هائلة

105
00:07:21,150 --> 00:07:23,080
...هكذا إذاً. أنت

106
00:07:23,420 --> 00:07:25,810
...أحد الأصابع الخمسة التي تخدم كلايمان

107
00:07:25,810 --> 00:07:27,970
أدالمان، السّبابة

108
00:07:27,970 --> 00:07:31,120
،بالفعل. أنا أدالمان

109
00:07:31,120 --> 00:07:34,600
الملك الأبيض الّذي يقود حشوداً من الموتى الأحياء

110
00:07:34,920 --> 00:07:37,930
،خادم لسيّد الشيطان العظيم كلايمان

111
00:07:37,930 --> 00:07:40,600
والشّخص الّذي أمره أن يحمي هذا البلد

112
00:07:40,790 --> 00:07:46,270
أيّها الدّخلاء الوضيعون، سلّموا حياتكم بهدوء

113
00:07:46,850 --> 00:07:48,790
نحن مُحاصرون تماماً

114
00:07:50,520 --> 00:07:52,910
الهرب باستخدام الانتقال المكانيّ غير وارد

115
00:07:53,200 --> 00:07:54,660
المخرج الوحيد من هذا هو

116
00:07:55,040 --> 00:07:57,080
هزيمة أدالمان

117
00:07:57,080 --> 00:07:58,590
لنفعل ذلك في الحال إذاً

118
00:07:58,590 --> 00:07:59,590
أتّفق

119
00:07:59,590 --> 00:08:02,210
تستطيع هجمتي قتل حتّى الموتى

120
00:08:03,620 --> 00:08:05,830
!لا أحد منكم يدرك حجمه

121
00:08:05,830 --> 00:08:07,380
!أنتم حمقى

122
00:08:11,720 --> 00:08:13,860
أنت مثير للإعجاب. توقّعتَ تحرّكاتي

123
00:08:13,860 --> 00:08:18,060
إذاً حتّى كجثّة عفِنة، تبقى سيّافاً

124
00:08:24,240 --> 00:08:26,230
غير ممكن... زومبي تنّين؟

125
00:08:26,230 --> 00:08:28,270
!هذا الخصم ليس سهلاً

126
00:08:29,040 --> 00:08:32,150
!إنّه الأقوى من بين كلّ الوحوش الموتى، تنّين الموت

127
00:08:34,070 --> 00:08:37,120
مخلوق ميّت؟ فلتمُت إذاً

128
00:08:40,700 --> 00:08:43,000
!قيود الخيط السرّية المُبهمة

129
00:08:48,280 --> 00:08:49,270
نلتُ منك

130
00:08:57,010 --> 00:09:00,740
هكذا إذاً. لديه مناعة للموت

131
00:09:00,740 --> 00:09:04,730
إذاً لن أدمّر جسدك فحسب، بل روحك كذلك

132
00:09:04,950 --> 00:09:06,480
سوي، لا تتحرّك

133
00:09:06,800 --> 00:09:09,490
يستطيع عقلك الهادئ بالتأكيد أن يرى مخرجاً من هذا

134
00:09:10,270 --> 00:09:11,650
روح هذا التنّين

135
00:09:12,120 --> 00:09:14,250
موجودة داخل أدالمان

136
00:09:15,030 --> 00:09:18,100
لذا عليك ألّا تقلق بشأني

137
00:09:18,100 --> 00:09:20,560
ركّز على إيقاف ذلك التنّين

138
00:09:20,560 --> 00:09:22,540
سوف أهزم أدالمان

139
00:09:22,540 --> 00:09:23,790
هذا خطير جدّاً

140
00:09:24,450 --> 00:09:25,710
لا يا سوي

141
00:09:26,300 --> 00:09:29,590
فكما ترى... أنا غاضبة

142
00:09:31,170 --> 00:09:32,090
...حسناً

143
00:09:32,780 --> 00:09:34,460
حالما هربنا من قرية الغيلان

144
00:09:35,030 --> 00:09:37,360
،والتقينا بريمورو-ساما أوّل مرّة

145
00:09:37,870 --> 00:09:41,800
لم تعد الأميرة شونا أميرة بحاجة لحماية

146
00:09:42,530 --> 00:09:45,100
عُلم. بالتوفيق لكِ يا شونا-ساما

147
00:09:45,380 --> 00:09:46,550
كذلك أنت

148
00:09:47,250 --> 00:09:49,190
أعتمد عليك في تولّي أمر هذا التنّين

149
00:09:57,760 --> 00:09:59,620
...سلوك الأُخرويّين

150
00:10:00,060 --> 00:10:02,120
...الغزو بواسطة مملكة فالموث

151
00:10:02,650 --> 00:10:04,620
وكلايمان، العقل المُدبّر لكلّ ذلك

152
00:10:05,100 --> 00:10:08,180
لم نأتِ إلى هنا لقضاء رحلة مُسلّية

153
00:10:08,860 --> 00:10:12,620
وماذا تنوين أن تفعلي أيّتها الآنسة الصّغيرة؟

154
00:10:12,620 --> 00:10:16,130
ما الّذي يمكنكِ فعله دون الاعتماد على حارسيكِ؟

155
00:10:17,140 --> 00:10:18,760
لستُ بحاجة لقلقك

156
00:10:19,250 --> 00:10:20,880
!مجال التّراصُف

157
00:10:34,120 --> 00:10:36,030
لا يستطيع أحد مقاطعتنا الآن

158
00:10:36,170 --> 00:10:38,190
،إذا هزمتُك

159
00:10:38,190 --> 00:10:41,780
فيمكنني تدمير الآليّة الدفاعيّة المُتمحورة حولك

160
00:10:41,780 --> 00:10:43,280
والتي تغطّي هذه المنطقة، صحيح؟

161
00:10:43,460 --> 00:10:45,280
أحسنتِ صنعاً

162
00:10:45,280 --> 00:10:48,450
أنا مندهش من اكتشافكِ سرّي كذلك

163
00:10:48,450 --> 00:10:50,420
ما اسمكِ يا فتاة؟

164
00:10:50,420 --> 00:10:52,720
اسمي شونا

165
00:10:52,720 --> 00:10:55,160
شونا... الآنسة شونا

166
00:10:55,640 --> 00:10:58,410
إذاً دعينا نبدأ قتالنا

167
00:10:58,410 --> 00:11:02,400
إذا هزمتِني، فسأحقّق أمنيتكم

168
00:11:02,400 --> 00:11:05,290
عرضك هذا هو لطف منك

169
00:11:05,290 --> 00:11:09,810
لكن أمنيتنا الوحيدة هي سقوط سيّد الشيطان كلايمان

170
00:11:09,810 --> 00:11:11,600
،إذا وافقت على عدم التدخّل

171
00:11:11,600 --> 00:11:14,440
فسوف نسمح لك بالاستمرار في التّواجد في هذا البلد

172
00:11:16,260 --> 00:11:19,440
أعتقد أنّ هذا سيكون مستحيلاً

173
00:11:19,440 --> 00:11:20,660
هكذا إذاً

174
00:11:21,180 --> 00:11:24,520
،خلتُك ستتمكّن من كسر تعويذة الرّبط هذه

175
00:11:24,520 --> 00:11:26,580
لكن ربّما كنتُ مخطئة

176
00:11:27,580 --> 00:11:31,460
لو كنتُ أستطيع كسر تعويذة الرّبط، لفعلتُ ذلك الآن

177
00:11:31,460 --> 00:11:34,130
تجعلين الأمر يبدو وكأنّه مسألة بسيطة

178
00:11:34,360 --> 00:11:35,870
...إذاً، كما خطّطنا

179
00:11:36,900 --> 00:11:38,880
سوف أهزمك

180
00:11:41,510 --> 00:11:45,220
!إذاً قاتليني بكلّ ما أوتيتِ من قوّة

181
00:11:48,570 --> 00:11:51,130
!حلِّل وأتلِف كلّ شيء

182
00:11:51,130 --> 00:11:52,770
!القذيفة الحمضيّة

183
00:11:55,440 --> 00:11:56,940
!جدار اللّهب

184
00:11:58,620 --> 00:12:00,610
!ما رأيك بهذه إذاً؟

185
00:12:00,960 --> 00:12:02,200
،يا أيّها الميّت الّذي يحمل ضغينة عميقة

186
00:12:02,200 --> 00:12:04,060
!قدّم قرباناً

187
00:12:04,060 --> 00:12:05,950
!قيود اللّعنة

188
00:12:07,460 --> 00:12:08,500
الجرس المُقدّس

189
00:12:16,430 --> 00:12:19,610
!مستحيل! معجزة إلهيّة؟

190
00:12:20,110 --> 00:12:24,620
!كيف؟ كيف لوحش أن يستخدم سحراً مُقدّساً؟

191
00:12:24,620 --> 00:12:26,040
أتجد ذلك غريباً؟

192
00:12:26,040 --> 00:12:28,470
هذا فقط لأنّ لديك رأس مُتعنّت

193
00:12:28,820 --> 00:12:32,730
يستجيب السّحر المُقدّس لقوّة أُمنية

194
00:12:32,730 --> 00:12:35,980
أي شخص يؤمن بالمعجزات ويتمنّاها

195
00:12:35,980 --> 00:12:38,260
!ماذا... قلتِ؟

196
00:12:39,010 --> 00:12:43,270
خانني كبار القادة اللّومينوسيّين

197
00:12:43,270 --> 00:12:46,280
وفقدتُ إيماني بالإله لومينوس

198
00:12:46,590 --> 00:12:48,790
،عندما رُدِدتُ إلى هذه الهيئة

199
00:12:48,790 --> 00:12:52,290
ظننتُ أنّني لن أتمكّن أبداً من استخدام
...السّحر المُقدّس ثانية

200
00:12:52,650 --> 00:12:55,540
!أتقولين لي أنّ الأمر ليس كذلك؟

201
00:12:56,160 --> 00:12:57,580
لماذا؟

202
00:12:57,580 --> 00:13:00,980
لماذا اعتقدتِ أنّني مُستخدم سحر مُقدّس؟

203
00:13:01,500 --> 00:13:03,050
مظهرك

204
00:13:03,330 --> 00:13:07,790
هذه العباءات البيضاء النّاصعة لا يرتديها إلّا
كبار أعضاء رجال الدّين

205
00:13:08,380 --> 00:13:11,430
سحرك مُتطوّر بما يكفي ليجعلك تكتسب
،حقّ ارتداء هذه العباءة

206
00:13:11,790 --> 00:13:15,190
مع ذلك أنت ضعيف جدّاً لتندب عجزك
عن كسر تعويذة الرّبط الأساسيّة هذه

207
00:13:16,640 --> 00:13:20,270
إذا كنتَ ترتدي هذه العباءة فقط لأنّك
،تفتقد لامتلاك السّحر المُقدّس

208
00:13:20,270 --> 00:13:22,690
فما كان ينبغي أن أتوخّى الحذر منك ربّما

209
00:13:24,950 --> 00:13:27,960
!لن أسمع المزيد منكِ

210
00:13:30,940 --> 00:13:34,500
!امنحني قوّة الرّوح القدس

211
00:13:36,940 --> 00:13:39,990
!أتوسّل إليك: استجب لأمنيتي

212
00:13:40,470 --> 00:13:41,600
بالطبع

213
00:13:41,600 --> 00:13:43,760
كانت عزيمتي غير كافية

214
00:13:44,130 --> 00:13:47,920
،عندما أصبح زملائي الّذين أعجِبوا بي أحياء موتى

215
00:13:47,920 --> 00:13:50,580
لم أستطع أن أموت أوّلاً وتخلّيتُ عنهم

216
00:13:50,580 --> 00:13:51,920
!كنتُ ساذجاً

217
00:13:51,920 --> 00:13:54,270
...لو توسّلتُ بصدق أن تتحقّق أمنيتي

218
00:13:54,880 --> 00:13:57,490
لا أكنّ ضغينة تجاه هذه الفتاة التي تدعى شونا

219
00:13:57,490 --> 00:14:02,150
في الواقع، أنا ممتنّ لها لأنّها أيقظتني

220
00:14:02,330 --> 00:14:05,910
،لكن بسبب لعنة الرّجل الّذي يقيّدني هنا

221
00:14:05,910 --> 00:14:09,950
!سيّد الشّيطان كازاليم، لا أستطيع زهق روحي

222
00:14:10,140 --> 00:14:12,080
سامحيني يا آنسة شونا

223
00:14:12,080 --> 00:14:13,950
!سوف أضطرّ لأخذكِ معي

224
00:14:14,470 --> 00:14:16,280
!أنهِ كلّ شيء

225
00:14:16,280 --> 00:14:18,370
!تفسُّخ

226
00:14:18,370 --> 00:14:20,000
كنتُ أنتظر هذا

227
00:14:21,250 --> 00:14:22,750
!أوفر درايف

228
00:14:30,910 --> 00:14:32,010
!ما-ماذا؟

229
00:14:32,410 --> 00:14:35,520
!محت سحري بسحرها؟

230
00:14:35,520 --> 00:14:37,120
أبليتَ حسناً

231
00:14:37,120 --> 00:14:41,030
كمكافأة، سأحرّرك من هذا البلد

232
00:15:12,540 --> 00:15:14,300
عمل مُتقن يا أميرة شونا

233
00:15:15,380 --> 00:15:16,970
انتهى الأمر الآن

234
00:15:16,970 --> 00:15:21,880
يا للهول، كان فُرسان الموت أقوى ممّا توقّعت

235
00:15:21,880 --> 00:15:24,310
أنقذتِني حقّاً يا أميرة شونا

236
00:15:24,310 --> 00:15:27,080
لا، كان أنت من أنقذني يا هاكورو

237
00:15:27,080 --> 00:15:28,320
وأنت يا سوي

238
00:15:28,570 --> 00:15:32,640
أحسنتُما في إكسابي الوقت ضد تنّين الموت ذاك

239
00:15:32,640 --> 00:15:36,320
لا، أنا خجل من أنّني عجزتُ عن هزيمته

240
00:15:38,770 --> 00:15:43,580
يبدو أنّني بالغتُ قليلاً بغضبي

241
00:15:43,740 --> 00:15:45,270
أجل، بالفعل

242
00:15:45,270 --> 00:15:49,590
يبدو أنّ بلوغنا لقوّة عظيمة جعلتنا متغطرسين

243
00:15:49,590 --> 00:15:54,630
كان قلق ريمورو-ساما في محلّه، لا أحد
يعلم ما قد يحدث في الحروب

244
00:15:54,630 --> 00:15:57,630
كان يجدر بي أن أجمع معلومات أكثر

245
00:16:01,540 --> 00:16:02,460
...حسناً

246
00:16:03,330 --> 00:16:06,140
لنسيطر على قلعة كلايمان الآن

247
00:16:07,130 --> 00:16:08,610
انتظروا رجاء

248
00:16:10,370 --> 00:16:12,110
أما زلت حيّاً؟

249
00:16:12,110 --> 00:16:13,810
هل أنت بحاجة لضربة قاضية؟

250
00:16:13,810 --> 00:16:15,240
مهلاً يا هاكورو

251
00:16:15,510 --> 00:16:18,740
لم تعد لديه الرّغبة في القتال

252
00:16:19,250 --> 00:16:20,580
...شونا-ساما

253
00:16:22,100 --> 00:16:22,870
ساما"؟"

254
00:16:26,650 --> 00:16:28,730
،شكراً على سحركِ يا شونا-ساما

255
00:16:28,730 --> 00:16:32,680
تحرّرنا جميعاً من اللّعنة التي تقيّدنا بهذا البلد

256
00:16:32,680 --> 00:16:35,210
وبالتأكيد هذا يعني أنّه كان هناك سبباً
وراء عجزنا عن الرّقود بسلام

257
00:16:35,210 --> 00:16:38,180
!أريد أن أطلب معروفاً منكِ

258
00:16:38,960 --> 00:16:40,390
ما هو؟

259
00:16:40,570 --> 00:16:44,610
أريد أن ألتقي بالشخص الّذي آمنتِ به

260
00:16:44,610 --> 00:16:49,190
بإيماني المفقود، أفتقر للقوّة التي كنتُ
أستمتع بها في ذروتي

261
00:16:49,190 --> 00:16:52,450
إيماني بالإله لومينوس قد مات

262
00:16:52,450 --> 00:16:55,910
لذلك، أريد أن أكسب إلهاً جديداً

263
00:16:56,220 --> 00:16:58,820
...في الواقع... إنّه ليس إلهاً بالمعنى الحرفيّ

264
00:16:58,820 --> 00:17:03,790
نحن نُبجّل ريمورو-ساما، لكنّنا لا نعبده

265
00:17:04,010 --> 00:17:06,980
!اسمه ريمورو-ساما إذاً

266
00:17:06,980 --> 00:17:11,300
!يا له من اسم رائع يلائم إلهنا الجديد

267
00:17:12,730 --> 00:17:16,110
،لكنّني لستُ سوى حيّ ميّت ضعيف

268
00:17:16,110 --> 00:17:19,180
لكن أملي المُتواضع هو أن أكون مفيداً له رغم ذلك

269
00:17:19,520 --> 00:17:23,500
هل أزعجكم إذا طلبتُ منكم تعريفنا
على سيّدكم ريمورو-ساما؟

270
00:17:33,970 --> 00:17:35,870
حسناً، لمَ لا؟

271
00:17:35,870 --> 00:17:40,340
حالما يلتقي بريمورو-ساما، قد ينسى الفكرة تماماً

272
00:17:40,790 --> 00:17:41,870
موافقة

273
00:17:43,100 --> 00:17:44,750
!شكراً لكِ

274
00:17:44,910 --> 00:17:46,860
...لكن أولاً

275
00:17:46,860 --> 00:17:50,530
ثمّة أمر نحن بحاجة له

276
00:17:52,220 --> 00:17:53,130
هكذا إذاً

277
00:17:53,600 --> 00:17:55,370
إذاً اسمحوا لي بإرشادكم

278
00:17:55,890 --> 00:17:58,240
اتبعوني رجاء

279
00:18:01,460 --> 00:18:02,470
!تعالوا، تعالوا

280
00:18:12,720 --> 00:18:14,140
من هنا لو سمحت

281
00:18:14,140 --> 00:18:14,480
...حسناً

282
00:18:26,280 --> 00:18:27,500
...يا للهول

283
00:18:28,100 --> 00:18:29,990
إنّه مخيف

284
00:18:30,760 --> 00:18:32,720
من الواضح أنه بمستوى مختلف

285
00:18:32,720 --> 00:18:36,260
إذاً هذا هو أقدم أسياد الشيطان، غي كريمزون

286
00:18:46,730 --> 00:18:47,930
...هذا الجسد الهائل

287
00:18:48,580 --> 00:18:50,270
...وهذا المقدار العجيب من الطاقة

288
00:18:50,500 --> 00:18:53,270
إنّه سيّد الشيطان العملاق داغرول

289
00:19:04,520 --> 00:19:05,990
...هذه الأنياب

290
00:19:05,990 --> 00:19:07,730
هل هو مصّاص دماء؟

291
00:19:07,730 --> 00:19:09,900
...أي أنّه سيّد الشيطان فالنتاين

292
00:19:13,450 --> 00:19:16,670
...مهلاً لحظة... مرافقته

293
00:19:16,670 --> 00:19:17,500
إجابة

294
00:19:17,500 --> 00:19:20,480
يشير التّقييم إلى أنّ الفرد الذي تسأل عنه

295
00:19:20,480 --> 00:19:24,430
قد يمتلك طاقة أعلى حتّى من طاقة
سيّد الشيطان فالنتاين

296
00:19:24,700 --> 00:19:26,280
توقغتُ هذا

297
00:19:26,280 --> 00:19:29,240
قد تكون هذه الخادمة هي سيّدة الشيطان الحقيقيّة

298
00:19:29,240 --> 00:19:32,120
...التي تدعى لوروس أو ميليس أو أيّاً يكن

299
00:19:32,120 --> 00:19:34,440
آمل ألّا يكتشف أحد ارتباطي بفيلدورا

300
00:19:35,000 --> 00:19:36,320
،وإن اكتشفوا

301
00:19:36,320 --> 00:19:39,030
...آمل ألّا أضطرّ لإزالة المُخلّفات

302
00:19:43,550 --> 00:19:46,940
أنتِ. لا تزالين ضئيلة هكذا؟

303
00:19:47,410 --> 00:19:48,940
هل تحاول أن تفتعل شجاراً؟

304
00:19:48,940 --> 00:19:51,260
!كم أنت وقح يا دينو

305
00:19:51,260 --> 00:19:54,950
عجباً. ولمَ أفتعل شجاراً وأنا أعلم أنّني سأفوز؟

306
00:19:55,560 --> 00:19:57,420
!هل لديك أمنية قبل الموت؟

307
00:19:57,750 --> 00:20:00,260
!لمعلوماتك أنا بأحسن حالاتي اليوم

308
00:20:00,260 --> 00:20:03,810
مستحيل. أنتِ أصغر حتّى من آخر مرّة رأيتكِ فيها

309
00:20:03,810 --> 00:20:07,430
حسناً، ليس باليد حيلة! وُلدت من جديد
!منذ مدّة ليست ببعيدة

310
00:20:07,430 --> 00:20:10,650
ما الّذي تفعله وحيدة مثلكِ مع مرافقين؟

311
00:20:10,650 --> 00:20:12,440
تجعلينني أبدو سخيفاً لمجيئي بمفردي

312
00:20:13,210 --> 00:20:14,180
...في الواقع

313
00:20:14,180 --> 00:20:19,040
هذه طريقتي في الردّ على أي شخص
"ينعتني بـ"ضئيلة" أو "وحيدة

314
00:20:19,040 --> 00:20:20,640
!بعبارة أخرى، أنت

315
00:20:20,070 --> 00:20:24,440
في الحقيقة، هذان مذهلان، أليسا كذلك؟

316
00:20:20,640 --> 00:20:24,440
!فلتُدرك ضعفك أمامهما

317
00:20:24,440 --> 00:20:26,070
بعد إمعان النّظر بهما، يبدوان قويّين جداً

318
00:20:26,070 --> 00:20:28,080
صحيح؟ أليسا كذلك؟

319
00:20:28,260 --> 00:20:31,280
هذا سيجعل كلّ ما أقوله أكثر إقناعاً، صحيح؟

320
00:20:31,280 --> 00:20:33,990
ما رأيك؟ هل تغار؟

321
00:20:32,030 --> 00:20:34,290
نعم. فهمتُ الفحوى

322
00:20:33,990 --> 00:20:35,920
حسناً، رائع

323
00:20:35,920 --> 00:20:38,800
!أنت! لم أنتهِ من الكلام معك

324
00:20:50,180 --> 00:20:54,750
لا بدّ أنها فري، المرأة الطّائرة وسيّدة الشيطان
التي تحدّث عنها الفرسان الوحوش الثّلاثة

325
00:20:54,750 --> 00:20:58,950
!يا لها... يا لها من إثارة جنسيّة فائضة

326
00:20:59,190 --> 00:21:02,520
يمكنني القول وبكلّ ثقة أنّها الأفضل، صحيح؟

327
00:21:02,520 --> 00:21:03,460
ريمورو-ساما

328
00:21:03,970 --> 00:21:05,490
!ما-ما-ما الأمر يا شيون؟

329
00:21:05,490 --> 00:21:07,300
!تبّاً! سوف تقتلني

330
00:21:07,300 --> 00:21:08,990
...المُرافق الذي خلفها

331
00:21:09,140 --> 00:21:10,820
ألا يثير فضولك؟

332
00:21:13,110 --> 00:21:14,320
معها حقّ

333
00:21:14,320 --> 00:21:18,850
لديه كثير من الجزيئات السحريّة، لكن ليس
بنفس مقدار ما يمتلكه الآخرون

334
00:21:19,330 --> 00:21:20,740
...هل هذا يعني

335
00:21:20,740 --> 00:21:21,610
إشعار

336
00:21:21,610 --> 00:21:23,450
...يشير التّقييم إلى

337
00:21:23,450 --> 00:21:25,860
،لا، حتّى لو كان ذلك كاريون

338
00:21:25,860 --> 00:21:29,100
لا يمكن أن يكشف عن وجوده هنا بهذا
الوضوح. ليس هو

339
00:21:31,020 --> 00:21:31,970
—رافائيل-سان؟ هل

340
00:21:31,970 --> 00:21:33,220
أنت ريمورو إذاً؟

341
00:21:35,920 --> 00:21:37,230
هذا صحيح

342
00:21:39,300 --> 00:21:42,080
هكذا إذاً. أنت ليون

343
00:21:42,540 --> 00:21:44,310
أتريد شيئاً منّي؟

344
00:21:45,010 --> 00:21:45,990
لا

345
00:21:48,810 --> 00:21:52,660
كلّ ما في الأمر أنّ مظهرك بدا مألوفاً لي

346
00:21:52,660 --> 00:21:55,580
ليون، شيزو-سان قد ماتت

347
00:21:55,810 --> 00:21:57,240
أعلم

348
00:21:57,240 --> 00:21:58,960
من الطبيعي أن تموت

349
00:21:59,080 --> 00:22:01,970
،فأساساً، لم تقبل إيفريت أبداً

350
00:22:01,970 --> 00:22:04,210
وقاومت أن تصبح ماجين

351
00:22:05,160 --> 00:22:07,470
...أنا لا أقول هذا لأنّها طلبت منّي ذلك

352
00:22:08,090 --> 00:22:09,760
لكن دعني أضربك ولو لمرّة

353
00:22:09,760 --> 00:22:10,900
أرفض

354
00:22:10,900 --> 00:22:15,320
منحتُ شيزو فرصة اختيار حياتها الخاصّة

355
00:22:15,880 --> 00:22:18,680
أرادت أن تعيش كبشريّة

356
00:22:19,190 --> 00:22:21,440
قدّمتُ لها إيفريت كهدية فُراق

357
00:22:21,680 --> 00:22:23,690
لا أرى سبباً يجعلني أستحقّ الضرب

358
00:22:24,430 --> 00:22:27,340
لكنّني مهتمّ بك بعض الشيء

359
00:22:27,340 --> 00:22:31,450
سأدعوك إلى قلعتي. إذا كانت لديك
مشكلة معي. فتعال والتقِ بي هناك

360
00:22:31,690 --> 00:22:34,970
إن كنت تعتقد أنّه فخّ، لك حرّية الرفض

361
00:22:37,450 --> 00:22:41,530
حسناً. أرسل لي دعوة وسأحضر

362
00:22:41,530 --> 00:22:44,340
...سأفعل ذلك. بالطبع

363
00:22:44,730 --> 00:22:47,840
هذا إذا غادرت هذا المكان حيّاً

364
00:22:51,530 --> 00:22:52,350
!ميليم

365
00:22:54,450 --> 00:22:57,600
جيّد. تبدو بخير على الأقلّ

366
00:22:58,000 --> 00:23:01,040
بغياب كاريون، صاروا ثمانية

367
00:23:01,040 --> 00:23:03,470
...ما يعني أنّ الرّجل المغرور الّذي بجانبها هو

368
00:23:03,470 --> 00:23:05,980
!أسرعي أكثر أيّتها البلهاء

369
00:23:11,890 --> 00:23:15,380
يا جماعة، شكراً على الانتظار

370
00:23:24,000 --> 00:23:25,230
...كلايمان

371
00:23:25,960 --> 00:23:30,300
سأحرص على أن أدفعك الثّمن لضربك صديقتي

372
00:23:31,180 --> 00:23:33,520
لا تتوقّع موتاً خالياً من الألم

