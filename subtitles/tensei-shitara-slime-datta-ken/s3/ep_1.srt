1
00:00:05,850 --> 00:00:07,980
،عندما شاركتُ في والبورغيس

2
00:00:08,270 --> 00:00:11,980
هزمتُ كلايمان، وتمّ الاعتراف بي
،رسميّاً كسيّد شيطان

3
00:00:12,420 --> 00:00:15,900
وأصبحتُ جزءاً من أوكتاغرام، أسياد
شيطان النّجم الثُّماني

4
00:00:25,740 --> 00:00:28,590
انتهى عملي هنا. سأغادر

5
00:00:29,210 --> 00:00:34,120
ليون وفالانتاين غادرا حالما انتهى المؤتمر

6
00:00:34,720 --> 00:00:38,720
بعد ذلك، أقام غاي حفلة عشاء
...لأولئك الّذين ظلّوا

7
00:00:39,100 --> 00:00:41,720
هذا نمر أسود الفراء مطبوخ

8
00:00:44,480 --> 00:00:45,240
!لذيذ

9
00:00:45,240 --> 00:00:48,610
،اللّحم يتفتّت على لساني
...والصّلصة المدهونة به

10
00:00:48,610 --> 00:00:49,950
!رافايل-سينسي

11
00:00:49,950 --> 00:00:52,600
عُلِم. جاري تحليل الوصفة

12
00:00:53,500 --> 00:00:56,280
يبدو أنّنا لسنا بحاجة للقلق
بشأن آداب السُّلوك هنا

13
00:00:57,270 --> 00:00:59,350
!ميليم! هذه كحول

14
00:00:59,940 --> 00:01:01,770
ما المشكلة؟

15
00:01:01,770 --> 00:01:04,410
!هذه مُكافأتي على التّظاهر بأنّني خاضعة للتحكُّم

16
00:01:04,740 --> 00:01:08,410
لكن أما كان بمقدوركِ التوقُّف
عن التّظاهر في وقت أسبق؟

17
00:01:08,410 --> 00:01:11,540
لم يكن كلايمان صريحاً بشأن
من كان العقل المُدبِّر

18
00:01:11,540 --> 00:01:15,680
!بالفعل! لكن كانت فرصة ترحيب بمقاتلة ريمورو

19
00:01:15,680 --> 00:01:16,300
!أنتِ

20
00:01:16,300 --> 00:01:18,040
!لا يمكنكِ تناول هذا بعد

21
00:01:18,040 --> 00:01:20,280
!لئيم

22
00:01:20,280 --> 00:01:23,460
أنا سيّدة الشّيطان الأكبر سنّاً
!بعكس ما يوحي به مظهري

23
00:01:21,880 --> 00:01:24,110
إنّه خمر ذو جودة عالية

24
00:01:23,460 --> 00:01:27,030
!لا يهمّ إن كان كحولاً أم لا! هذا لا يعنيني شيئاً

25
00:01:24,600 --> 00:01:27,020
هل هو مصنوع من العنب من يورازانيا؟

26
00:01:27,020 --> 00:01:28,660
أنا مندهش من أنّك عرفت

27
00:01:28,660 --> 00:01:32,520
يمكننا أخيراً صنعه بشكل دائم الآن
بفضل الفاكهة الّتي نستوردها منهم

28
00:01:32,850 --> 00:01:35,510
!حسناً إذاً، سأشرب المزيد

29
00:01:36,190 --> 00:01:38,410
!عليك أن تتعلّم معنى الحدود

30
00:01:38,410 --> 00:01:40,410
...هذا حادٌّ جدّاً

31
00:01:40,770 --> 00:01:43,680
!يا مثير الشّفقة! راقب هذا فحسب

32
00:01:44,920 --> 00:01:49,920
!كانت فالانتاين لتحبّ هذا حتماً. يا للخسارة

33
00:01:47,680 --> 00:01:49,240
!أريد آخر

34
00:01:50,100 --> 00:01:51,880
فالانتاين؟

35
00:01:51,880 --> 00:01:54,560
هناك كثير من الأمور الّتي
...أردتُ سؤالها عنها

36
00:01:54,560 --> 00:01:55,800
حسناً

37
00:01:55,800 --> 00:01:56,570
إشعار

38
00:01:56,570 --> 00:01:58,480
اكتمل التّحليل

39
00:01:58,480 --> 00:02:01,270
أمسى من الممكن الآن إعادة
صنع مجموعة العشاء الكاملة

40
00:02:01,270 --> 00:02:04,800
،لديّ بعض أفضل الوصفات في العالم

41
00:02:04,800 --> 00:02:07,090
وفعلتُها من خلال والبورغيس

42
00:02:05,350 --> 00:02:06,580
...راميريس-ساما

43
00:02:06,580 --> 00:02:08,690
...يجب أن نخبرها حول ذلك

44
00:02:09,930 --> 00:02:13,040
والآن، عدتُ إلى دياري تيمبيست

45
00:03:46,500 --> 00:03:48,500
!افتتحنا اليوم

46
00:03:51,200 --> 00:03:52,990
!انتظرا

47
00:03:59,630 --> 00:04:00,670
ماذا؟

48
00:04:03,700 --> 00:04:05,640
ما كلّ هذا؟

49
00:04:06,560 --> 00:04:09,350
متى تمرّنتُم على هذا؟

50
00:04:09,350 --> 00:04:11,960
!ريمورو-ساما

51
00:04:13,190 --> 00:04:15,440
!أهلاً بعودتك يا ريمورو-ساما

52
00:04:15,790 --> 00:04:20,460
أهنّئك من أعماق قلبي على نجاحك في أوكتاغرام

53
00:04:20,460 --> 00:04:22,210
شكراً

54
00:04:22,210 --> 00:04:25,690
والأهمّ من كلّ شيء، يسرّني
أنّك عدتَ بالسّلامة

55
00:04:25,910 --> 00:04:29,030
لحظة يا ديابلو، ماذا تفعل هنا؟

56
00:04:29,200 --> 00:04:32,250
حسناً، حسناً. لا بدّ أنّك مُرهَق

57
00:04:32,250 --> 00:04:35,540
حاليّاً، استغرِق وقتك في استرداد طاقتك فحسب

58
00:04:40,930 --> 00:04:41,970
تفضّل

59
00:04:41,970 --> 00:04:43,220
المعذرة

60
00:04:49,560 --> 00:04:52,300
هل هذه ماتشا بودينغ؟

61
00:04:52,300 --> 00:04:53,340
أجل

62
00:04:53,340 --> 00:04:55,440
،لستُ بمثل مهارة الأميرة شونا بعد

63
00:04:55,440 --> 00:04:57,440
لكن تحسّنتُ في الطّبخ

64
00:04:57,440 --> 00:05:00,780
ماذا؟ أفترض بأنّكِ أحضرتِ بعضاً لي أيضاً؟

65
00:05:00,780 --> 00:05:03,080
بالطّبع يا فيلدورا-ساما

66
00:05:03,890 --> 00:05:05,340
فيلدورا-ساما

67
00:05:05,730 --> 00:05:09,040
هذه حصّتك الموعودة، الأولى

68
00:05:11,070 --> 00:05:14,800
ديابلو، تبدو رجلاً ذا إحساس قويّ بالواجب

69
00:05:14,800 --> 00:05:17,790
ديابلو، ألن تأكل منه؟

70
00:05:17,790 --> 00:05:21,130
هذه دُفعتي له مقابل معلومات

71
00:05:21,130 --> 00:05:23,160
لا حاجة لتقلق بشأني

72
00:05:23,520 --> 00:05:25,000
معلومات؟

73
00:05:29,000 --> 00:05:33,760
تساءلتُ كيف عرف ديابلو بشأن
القرارات الّتي اتُّخِذَتْ في والبورغيس

74
00:05:33,760 --> 00:05:35,440
كم حلوى بعته مقابل ذلك؟

75
00:05:35,740 --> 00:05:38,500
واحدة؟ اثنتان؟ ثلاثة؟

76
00:05:38,500 --> 00:05:39,360
أجل، ثلاثة

77
00:05:39,760 --> 00:05:43,980
لكن يا فيلدورا، أنت لا تحتاج للأكل حتّى

78
00:05:43,980 --> 00:05:46,690
!ما-ما هذا الكلام الغبيّ يا ريمورو؟

79
00:05:46,690 --> 00:05:49,940
!ليست مسألة فيما إذا كنتُ أحتاج للأكل أم لا

80
00:05:49,940 --> 00:05:52,280
!آكل لأنّني أريد أن آكل

81
00:05:52,280 --> 00:05:55,970
!وأنت أيضاً لست بحاجة للأكل، أليس كذلك؟

82
00:06:00,610 --> 00:06:03,800
رافقتِ ريمورو-ساما كما ينبغي على ما أفترض؟

83
00:06:03,800 --> 00:06:05,300
بالطّبع

84
00:06:05,300 --> 00:06:09,200
أثبتُّ بأنّه لا يحتاجك ما دمتُ معه

85
00:06:09,560 --> 00:06:10,680
،لكن بصرف النّظر عن ذلك

86
00:06:10,680 --> 00:06:14,340
ماذا حدث للمهمّة الّتي كلّفَك بها ريمورو-ساما؟

87
00:06:16,370 --> 00:06:18,350
أُنجِزَتْ بصورة مثاليّة

88
00:06:18,350 --> 00:06:21,850
لكن لا أفهم كيف وقتَّ عودتك
بهذا الشّكل المثاليّ

89
00:06:22,040 --> 00:06:24,160
،كنتُ أتولّى بعض المسائل الأخرى

90
00:06:24,160 --> 00:06:27,360
لكن تواصل معي فيلدورا-ساما ونصحني بالعودة

91
00:06:28,320 --> 00:06:31,540
...تـ-تذكّرتُ للتوّ شيئاً أحتاج لفعله

92
00:06:32,850 --> 00:06:35,680
اِبقَ مكانك فحسب يا فيلدورا-كن

93
00:06:35,680 --> 00:06:38,100
...ا-انتظر... ستفهم عندما أشرح

94
00:06:38,100 --> 00:06:41,040
!هذا مُحال! لا تتدخّل في أعمال الآخرين

95
00:06:41,380 --> 00:06:42,670
!لا بودينغ لك

96
00:06:42,900 --> 00:06:46,170
هارونا-سان، لا تعطي فيلدورا
أي أكلات خفيفة لمدّة من الزّمن

97
00:06:46,170 --> 00:06:49,920
!ماذا؟! هذا قاسٍ! هذا قاسٍ جدّاً يا ريمورو

98
00:06:50,170 --> 00:06:51,930
لم أعد أبالي

99
00:06:52,250 --> 00:06:55,930
على أيّ حال، هل يجدر بك إضاعة الوقت هنا؟

100
00:06:55,930 --> 00:06:58,050
هل كلّ شيء على ما يُرام مع فالموث؟

101
00:06:59,120 --> 00:07:02,100
خادم الشّاي حريّ به أن يقدّم الشّاي

102
00:07:02,320 --> 00:07:04,980
اسمح لي أن أتوّى هذه المسألة

103
00:07:05,200 --> 00:07:07,640
لن تكون هناك حاجة لذلك

104
00:07:07,640 --> 00:07:12,410
بوجود مُخبِري في العمل، كلّ شيء
يسير وفق ما هو مُخطَّط

105
00:07:13,340 --> 00:07:14,400
حقّاً؟

106
00:07:14,400 --> 00:07:15,420
أجل

107
00:07:15,420 --> 00:07:19,290
مبدئيّاً، أعدتُهم جميعاً إلى أشكالهم الأصليّة

108
00:07:19,740 --> 00:07:22,530
كان من غير الملائم تركهم ككتل لحميّة

109
00:07:22,530 --> 00:07:23,930
كتل لحميّة؟

110
00:07:23,930 --> 00:07:26,540
فهمت

111
00:07:26,960 --> 00:07:28,400
يا إلهي

112
00:07:28,400 --> 00:07:31,210
الآنسة شيون مُشاغبة

113
00:07:33,960 --> 00:07:35,500
!كم هذا مُجهِد

114
00:07:36,850 --> 00:07:40,440
سحر الشّفاء لا يؤثّر بك حتّى

115
00:07:40,440 --> 00:07:45,850
أيّ مهارة تثني كلّ القواعد إلى هذا الحدّ؟

116
00:07:47,690 --> 00:07:51,360
.أحتاج لاتّخاذ بعض الإجراءات المُشدَّدة
حاول أن تتحمّل ذلك

117
00:07:56,720 --> 00:08:01,290
أتعتقدان بأنّ الثّلاثة في تلك العربة
سيصلون إلى فالموث سليمين؟

118
00:08:01,290 --> 00:08:04,000
لستُ أدري ما إن كان بمقدورك
القول بأنّهم سليمون الآن

119
00:08:06,050 --> 00:08:07,260
!شكراً لك

120
00:08:07,260 --> 00:08:10,050
!شكراً لك يا سيّد ديابلو

121
00:08:10,050 --> 00:08:11,760
اصمت أيُّها القمامة

122
00:08:12,040 --> 00:08:14,130
حسناً، من التّالي؟

123
00:08:15,610 --> 00:08:18,140
...استرجع الملِك قبلي

124
00:08:18,140 --> 00:08:20,350
...أعده إلى هيئته الأصليّة

125
00:08:20,350 --> 00:08:24,590
أجل. كدتُ أنسى بأنّك كنت أحد الأسرى

126
00:08:24,590 --> 00:08:27,850
كان اسمك رامين... أقصد، رازين، صحيح؟

127
00:08:28,240 --> 00:08:30,760
أنت تعي بالطّبع

128
00:08:30,760 --> 00:08:35,480
بأنّ طلب معروف منّي يصحبه
ثمن باهظ جدّاً، صحيح؟

129
00:08:35,480 --> 00:08:37,870
...هذا صحيح... هذا الرّجل

130
00:08:38,250 --> 00:08:42,240
إنّه نوير، أحد الشّياطين الأصليّة السّبعة

131
00:08:42,790 --> 00:08:44,920
...لكن ما هو مُرعِب حقّاً

132
00:08:44,920 --> 00:08:49,050
!أنّ هناك شخصاً يخدمه هذا الشّيطان

133
00:08:49,770 --> 00:08:52,040
شيون، لا تبالغي في القيام بذلك

134
00:08:52,840 --> 00:08:57,760
سيّد شيطان يمتلك قوّةً خفيّة، في حين
أنّها عابرة، تفوق الخيال

135
00:08:57,760 --> 00:08:59,810
عرفتُ في تلك اللّحظة

136
00:08:59,810 --> 00:09:04,120
أنَّ مملكة فالموث أيقظَتْ أسداً نائماً

137
00:09:08,620 --> 00:09:10,900
...خذني... لا

138
00:09:11,080 --> 00:09:15,200
من فضلك اقبلني كخادمك الأدنى مرتبة

139
00:09:15,450 --> 00:09:19,050
سأكرّس كلّ جزء من حياتي لخدمتك

140
00:09:19,050 --> 00:09:22,770
لذا أرجوك، ارحم الملِك إدماريس

141
00:09:24,340 --> 00:09:25,840
حسناً إذاً

142
00:09:26,140 --> 00:09:30,760
غير أنّني لن أتحمّل مزيداً من تقليل
الاحترام بحقّ ريمورو-ساما

143
00:09:31,040 --> 00:09:35,140
إذا كشفتُ أي نوايا خبيثة، لن يكون
الملِك الشّخص الوحيد الّذي يموت

144
00:09:35,140 --> 00:09:39,510
يمكنك أن تتوقّع أن تختفي أنفاس
الحياة عن أرض فالموث بحدِّ ذاتها

145
00:09:39,510 --> 00:09:43,760
بالطّبع، ولائي هو مُلكك وحدك

146
00:09:43,760 --> 00:09:45,730
!أ-أنا أيضاً

147
00:09:46,220 --> 00:09:49,320
!أنا رئيس أساقفة الكنيسة المُقدّسة الغربيّة

148
00:09:49,320 --> 00:09:51,360
!يمكنني أن أكون نافعاً لك بكلِّ تأكيد

149
00:09:53,150 --> 00:09:56,690
ساحر ملَكيّ خدمَ العائلة الملكيّة لفترة طويلة

150
00:09:56,690 --> 00:10:00,370
أدارَ ظهره أخيراً لمملكة فالموث

151
00:10:01,470 --> 00:10:06,870
!لوّثتَ يدَي ريمورو-ساما الجميلتين بدماء البشر

152
00:10:07,670 --> 00:10:11,330
هذا هو القدر الّذي يجب علينا تحمّله

153
00:10:11,960 --> 00:10:16,840
أنا متأكّدٌ بأنّ قرار رازين كان صائباً

154
00:10:17,980 --> 00:10:22,090
...بصِفتي الملِك الأخير لفالموث

155
00:10:22,560 --> 00:10:31,080
أقسم بالتّعاون بأيّ شكل ترغبه يا سيّد ديابلو

156
00:10:32,100 --> 00:10:33,830
لا تقلق

157
00:10:33,830 --> 00:10:37,610
ما دمتم تطيعونني، سأعاملكم معاملة حسنة

158
00:10:41,630 --> 00:10:45,360
،بمهارتي الفريدة مُغوي

159
00:10:45,620 --> 00:10:48,370
منع الخيانة مسألة بسيطة

160
00:10:50,090 --> 00:10:52,460
!ديابلو

161
00:10:52,460 --> 00:10:54,670
الأسرى أحياء، صحيح؟

162
00:10:54,670 --> 00:10:56,960
لا تقلق يا سيّد يوم

163
00:10:57,270 --> 00:10:59,480
سنصل قريباً إلى عاصمة فالموث

164
00:10:59,480 --> 00:11:01,130
إنّ السّيطرة على بلد أمر تافه

165
00:11:01,130 --> 00:11:03,430
لنُنهِ الأمر بسرعة

166
00:11:03,430 --> 00:11:04,680
حـ-حسناً

167
00:11:13,440 --> 00:11:15,600
،مهما كان السّحر الّذي نستخدمه

168
00:11:15,600 --> 00:11:17,980
...لن يعود إلى هيئته الأصليّة

169
00:11:17,980 --> 00:11:21,380
شوغو، ما معنى هذا؟

170
00:11:21,380 --> 00:11:25,370
أين الآخران؟ ماذا حدث للجيش الملكيّ؟

171
00:11:25,370 --> 00:11:28,200
اهدؤوا. أنا رازين

172
00:11:28,200 --> 00:11:32,620
لحماية الملك، تعاونتُ مع النّصير للهرب

173
00:11:32,620 --> 00:11:37,000
ماذا؟ أتقصد بأنّك لست شوغو؟

174
00:11:37,000 --> 00:11:40,000
وتقول بأنّ جيش فالموث قد انهزم؟

175
00:11:40,000 --> 00:11:42,260
،لا تقل لي بأنّك فشلت في إخضاع الوحوش

176
00:11:42,260 --> 00:11:45,040
!وتجرأت على العودة إلى الدّيار والعار يُلبسك؟

177
00:11:45,040 --> 00:11:45,680
!ماذا؟

178
00:11:45,680 --> 00:11:46,930
!كلّا بكلِّ تأكيد

179
00:11:46,930 --> 00:11:47,930
!ما معنى هذا؟

180
00:11:47,930 --> 00:11:50,360
اهدؤوا يا سادة

181
00:11:50,360 --> 00:11:53,750
لنستمع إلى ما لدى السيّد رازين ليقوله أوّلاً

182
00:11:57,640 --> 00:12:00,720
جميعهم فُقِدوا؟ أحقّاً ذلك؟

183
00:12:00,720 --> 00:12:01,830
أجل

184
00:12:02,280 --> 00:12:04,910
معركة جيشنا مع الوحوش

185
00:12:04,910 --> 00:12:07,910
أيقظَتْ تنّيناً كان نائماً في هذه الأرض

186
00:12:08,200 --> 00:12:12,910
لكن قالت الكنيسة المُقدّسة الغربيّة
!بأنّ التنّين قد دُمِّر

187
00:12:12,910 --> 00:12:15,350
،لقد دُمِّر بالفعل

188
00:12:15,350 --> 00:12:17,970
لكن عنصر التنّين لا يموت

189
00:12:17,970 --> 00:12:20,920
سيُولَد التنّين ببساطة من جديد
في مكان آخر في العالم

190
00:12:21,570 --> 00:12:24,600
،لم نتوقّعه أن يعود بهذه السّرعة فحسب

191
00:12:24,600 --> 00:12:28,180
أو في مكان قريب جدّاً منّا

192
00:12:28,180 --> 00:12:30,210
،مع عودة فيلدورا

193
00:12:30,210 --> 00:12:33,440
كافّة الفرسان والوحوش في تلك المنطقة اختفوا

194
00:12:33,840 --> 00:12:35,810
كنّا المتبقّيين الوحيدين

195
00:12:35,810 --> 00:12:36,710
!مستحيل

196
00:12:36,710 --> 00:12:37,720
...هذا غير ممكن

197
00:12:40,860 --> 00:12:42,660
آسف لتأخُّري

198
00:12:45,920 --> 00:12:49,360
تمكّنتُ من إقناع ذلك الشّخص

199
00:12:52,200 --> 00:12:53,770
!من تعتقد نفسك؟

200
00:12:53,770 --> 00:12:55,670
كيف تجرؤ مجموعة من العوام
!على اقتحام هذا المكان؟

201
00:12:55,670 --> 00:12:57,830
تمهّل لحظة من فضلك يا سيّد كارلوس

202
00:12:57,830 --> 00:13:00,840
إنّهم من أنقذونا

203
00:13:00,840 --> 00:13:03,880
أتقول أنقذوكم؟

204
00:13:03,880 --> 00:13:06,080
ماذا تعني بذلك؟

205
00:13:06,080 --> 00:13:09,090
اسمحوا لي بالإجابة عن ذلك

206
00:13:09,340 --> 00:13:10,930
!رئيس الأساقفة ريهيم

207
00:13:14,050 --> 00:13:16,730
،عندما اشتبك الجيشان في ساحة المعركة

208
00:13:16,730 --> 00:13:19,440
كانت المعركة الّتي اندلعَتْ حامية

209
00:13:19,600 --> 00:13:22,480
،كانت لدينا الأفضليّة العدديّة

210
00:13:22,480 --> 00:13:25,000
،لكن لم نكن ندّاً لمعرفة الوحوش بالتّضاريس

211
00:13:25,000 --> 00:13:27,200
وفقدنا كثيراً من رجالنا

212
00:13:28,360 --> 00:13:32,730
لا بدّ أنّ الفوضى الّتي نشأت كانت
المفتاح الّذي أدّى إلى انبعاثه

213
00:13:32,730 --> 00:13:35,250
،بظهور فيلدورا المفاجئ

214
00:13:35,250 --> 00:13:36,960
،الجميع هناك، صديقاً كان أم خصماً

215
00:13:37,380 --> 00:13:41,960
عزموا على الموت أمام تنّين العاصفة

216
00:13:41,960 --> 00:13:43,550
،لكن حينئذ

217
00:13:43,550 --> 00:13:46,000
!وقفَ شخصٌ بيننا وبين التنّين

218
00:13:47,410 --> 00:13:51,960
كان ذلك الشّخص قائد الوحوش، ريمورو-ساما

219
00:13:51,960 --> 00:13:55,520
كان رئيس الأساقفة ريهيم وأنا مستعدّين للموت

220
00:13:55,520 --> 00:14:00,520
لكن ريمورو-ساما أقنع فيلدورا بالسّماح لنا بالعيش

221
00:14:02,270 --> 00:14:04,110
!كان قادراً على التكلّم معه؟

222
00:14:04,110 --> 00:14:07,810
لكن مجرّد الاحتكاك مع الجُزيئات
السّحريّة الكثيفة لتنّين الشرّ

223
00:14:07,810 --> 00:14:10,390
!يعني الموت الفوريّ لمُعظم الكائنات الحيّة

224
00:14:10,390 --> 00:14:12,240
...لذا كيف

225
00:14:12,640 --> 00:14:14,970
من المؤكّد أنّكم معظمون تعلمون

226
00:14:14,970 --> 00:14:20,000
بأنّ قائد الوحوش هو أيضاً حاكم
غابة جورا العظيمة

227
00:14:20,310 --> 00:14:23,370
لم يكن يسمّي نفسه بتلك التّسمية فحسب؟

228
00:14:24,840 --> 00:14:27,140
!على الأغلب لا

229
00:14:27,140 --> 00:14:29,410
،رأيتُ مدينة الوحوش بأمّ عيني

230
00:14:29,410 --> 00:14:32,760
كانت تستحقّ حقّاً أن تُلقَّب بعاصمة دولة

231
00:14:33,030 --> 00:14:38,600
حتّى حوريّات الغابة، حاميات غابة
!جورا العظيمة، يخدمنه

232
00:14:38,950 --> 00:14:44,110
كان من خلال حوريّات الغابة تفاوضَ
ريمورو-ساما مع فيلدورا

233
00:14:44,370 --> 00:14:45,920
حوريّات الغابة؟

234
00:14:45,920 --> 00:14:49,440
إنّهن وحوش قويّات يحمين الأرض
أثناء نوم فيلدورا

235
00:14:49,440 --> 00:14:51,860
يتحكّم حتّى بكائنات قويّة أمثالهن؟

236
00:14:52,210 --> 00:14:55,360
بما أنّ ريمورو استطاع التّفاوض
،مع تنّين الشرّ

237
00:14:55,360 --> 00:15:00,130
فنحن حتماً لا نرغب في مُعاداته

238
00:15:01,160 --> 00:15:05,120
مهلاً يا جماعة. ليس عليكم القلق بشأن ذلك

239
00:15:05,430 --> 00:15:10,790
تعاونتُ مع ريمورو عندما هزمتُ سيّد الأورك

240
00:15:11,250 --> 00:15:13,320
،إنّه ودود أكثر ممّا تتوقّعون

241
00:15:13,320 --> 00:15:15,840
ويريد أن نعيش بانسجام مع البشر

242
00:15:16,110 --> 00:15:21,500
إذاً يمكنك أن تؤدّي دور الوسيط
الّذي ينقل مطالبنا له

243
00:15:21,500 --> 00:15:24,340
سأخبرك عنها في وقت لاحق

244
00:15:24,340 --> 00:15:25,860
انتظروا في غرفة أخرى حاليّاً

245
00:15:26,500 --> 00:15:28,480
تمهّل لحظة

246
00:15:28,480 --> 00:15:32,520
إنّه ودود في الظّروف العاديّة، لكن ليس الآن

247
00:15:32,520 --> 00:15:35,360
وأنا متأكّد بأنّك تعرف السّبب

248
00:15:35,570 --> 00:15:36,870
!ماذا؟

249
00:15:36,870 --> 00:15:41,140
أنتم من أعلنتُم الحرب على دولة
ريمورو، أليس كذلك؟

250
00:15:41,140 --> 00:15:42,620
كانت تلك فكرة سيّئة

251
00:15:43,120 --> 00:15:46,370
توفّي بعض أصدقاء ريمورو بسبب ذلك

252
00:15:46,370 --> 00:15:48,680
إنّه غاضبٌ جدّاً الآن

253
00:15:49,300 --> 00:15:51,640
!صُن لسانك أيّها العامّي

254
00:15:51,640 --> 00:15:54,640
،إذا كان لديك تأثير على ريمورو
!فهذا يصبّ في صالحنا

255
00:15:54,640 --> 00:15:57,080
!من واجبك كنصير أن تكون وسيطاً بيننا

256
00:15:57,080 --> 00:15:58,270
!لذا افعل شيئاً

257
00:15:59,020 --> 00:16:00,890
!سيّد كارلوس، أخفِض صوتك

258
00:16:00,890 --> 00:16:04,400
حسناً، قبل كلّ شيء، اسمعوني

259
00:16:04,400 --> 00:16:07,600
أرسلتُم عابرين من عالم آخر
للعيث فساداً في دولته

260
00:16:07,600 --> 00:16:10,520
دون إرسال رُسُل أو إعلان حرب أوّلاً، صحيح؟

261
00:16:10,950 --> 00:16:13,520
،ذهبتُ إلى هناك لمحاولة نشر السّلام

262
00:16:13,520 --> 00:16:16,320
لكن بعدها سمعتُ بذلك، وانصدمت

263
00:16:16,730 --> 00:16:20,630
رغم ذلك، وُلِدتُ هنا في مملكة فالموث

264
00:16:20,630 --> 00:16:23,280
،لم أرد رؤية موطني يُدمَّر

265
00:16:23,280 --> 00:16:26,330
لذا توسّلتُه أن يبرم صفقة ما

266
00:16:26,590 --> 00:16:30,670
!لا يحقّ لعامّي أن يتكلّم باسم مملكتنا

267
00:16:30,670 --> 00:16:32,400
—اسمع يا هذا! أرفض أن

268
00:16:32,400 --> 00:16:33,800
!قلتُ لك اهدأ

269
00:16:33,800 --> 00:16:36,040
!أيّها الأحمق

270
00:16:37,550 --> 00:16:40,430
!لا تملك فكرة عمّا حدث، لذا لا تتدخّل فحسب

271
00:16:45,480 --> 00:16:49,610
اسمعوني جميعاً. ما يقوله السيّد يوم صحيح

272
00:16:50,000 --> 00:16:52,010
هُزِمنا

273
00:16:52,010 --> 00:16:54,610
كان النّاجون الوحيدين رئيس الأساقفة
،ريهيم، وأنا

274
00:16:54,610 --> 00:16:57,320
والملِك إدماريس الّذي تحوّل إلى هذا الشّكل

275
00:16:57,320 --> 00:17:01,120
بعد احتكاكه بالجزيئات السّحريّة
الخاصّة بتنّين العاصفة

276
00:17:01,290 --> 00:17:02,960
،تمّ أسرنا

277
00:17:02,960 --> 00:17:06,960
وكان السيّد يوم هو من أوصى بتحريرنا

278
00:17:07,280 --> 00:17:11,560
مملكة فالموث العظيمة، تهزمها دولةُ وحوش؟

279
00:17:11,960 --> 00:17:14,100
مع ذلك لا نملك خياراً

280
00:17:14,100 --> 00:17:17,860
هل تنوي مُعاداة تنّين العاصفة؟

281
00:17:17,860 --> 00:17:19,090
...في الواقع، أنا

282
00:17:19,430 --> 00:17:24,000
علينا أن نقبل عرضه، أليس كذلك يا سادة؟

283
00:17:28,560 --> 00:17:30,740
قرار حكيم

284
00:17:30,740 --> 00:17:35,780
والآن، كما وعدتُ، سأحرِّر ملِك هذه الدّولة

285
00:17:35,780 --> 00:17:36,630
!من أنت؟

286
00:17:36,630 --> 00:17:38,110
—متى قد

287
00:17:38,850 --> 00:17:42,080
أعتذر، لكن كنتُم مكشوفين

288
00:17:43,040 --> 00:17:45,200
اسمي ديابلو

289
00:17:45,200 --> 00:17:50,630
أنا الخادِم الموالي لملِكي ريمورو-ساما

290
00:17:53,370 --> 00:17:54,380
!جلالتك

291
00:17:54,380 --> 00:17:55,880
ما-ما هذا الدّواء؟

292
00:17:56,990 --> 00:18:00,320
جرعة كاملة، اختصاص محلّي لدولتنا

293
00:18:00,320 --> 00:18:02,800
أفضل دواء شافٍ

294
00:18:04,270 --> 00:18:06,500
كيف حالك؟

295
00:18:08,810 --> 00:18:11,560
أنقذتني. شكراً

296
00:18:11,760 --> 00:18:13,960
،والآن يا ملِك فالموث

297
00:18:13,960 --> 00:18:18,070
لديّ رسالة لك من ملِكي ريمورو-ساما

298
00:18:18,830 --> 00:18:22,570
تكلّم أيُّها الرّسول القادم من دولة الوحوش

299
00:18:23,070 --> 00:18:25,540
حسناً. سأفعل

300
00:18:25,830 --> 00:18:27,560
،بعد أسبوع من الآن"

301
00:18:27,560 --> 00:18:31,550
مُمثّلون من دولتينا سيلتقون
في هذه الأرض لمناقشة السّلام

302
00:18:31,840 --> 00:18:34,540
"سوف أمنحكم خيارات

303
00:18:34,540 --> 00:18:36,300
خيارات؟

304
00:18:36,300 --> 00:18:40,950
الخيار الأوّل: يتخلّى ملِكُكم عن العرش"
ويدفع تعويضات لنا

305
00:18:40,950 --> 00:18:45,300
الخيار الثّاني: تستسلمون لدولتنا
وتصبحون دولة تابعة

306
00:18:45,630 --> 00:18:48,640
"الخيار الثّالث: تستمرّ الحرب

307
00:18:49,540 --> 00:18:51,060
...إنّه مجنون

308
00:18:51,060 --> 00:18:52,980
هذه هي خياراتكم"

309
00:18:52,980 --> 00:18:57,120
"من فضلكم جهّزوا إجابتكم في غضون أسبوع

310
00:18:58,070 --> 00:19:00,780
!انتظر لحظة! هذا ليس وقتاً كافياً

311
00:19:00,780 --> 00:19:02,150
اصمت

312
00:19:02,150 --> 00:19:04,530
أنا سريع الغضب

313
00:19:04,530 --> 00:19:07,630
...لكن يجب أن نستدعي النُّبلاء من كافّة المناطق

314
00:19:08,590 --> 00:19:10,540
قلتُ لكم اصمتوا

315
00:19:11,920 --> 00:19:15,830
ما تريدونه لا يعني شيئاً بالنّسبة لريمورو-ساما

316
00:19:15,830 --> 00:19:17,040
مفهوم؟

317
00:19:17,040 --> 00:19:20,560
لذا إيّاكم والتّفكير في القيام بأي حيلة رخيصة

318
00:19:20,900 --> 00:19:23,880
لن يُسمَح لكم بتأخير إجابتكم

319
00:19:24,670 --> 00:19:26,950
،إذا لم تقدّموا جواباً في غضون أسبوع

320
00:19:26,950 --> 00:19:29,640
سوف نفترض بأنّكم نويتم الاستمرار في الحرب

321
00:19:29,640 --> 00:19:31,020
هل هذا واضح؟

322
00:19:31,290 --> 00:19:35,520
حسناً إذاً، فكّروا مليّاً بشأن إجابتكم

323
00:19:40,450 --> 00:19:43,580
وهذا ما فعلتُه فاختلّ توازنهم

324
00:19:43,580 --> 00:19:45,370
أريتهم ذلك؟

325
00:19:45,370 --> 00:19:46,080
أجل

326
00:19:46,260 --> 00:19:49,830
ارتأيتُ أنّها كانت الطّريقة المثلى
لدبّ الرّعب في قلوبهم

327
00:19:50,640 --> 00:19:53,080
لم يكن يمدحكِ يا شيون

328
00:19:53,420 --> 00:19:56,090
...والآن بالنّسبة لشروط السّلام

329
00:19:56,090 --> 00:20:00,130
طالبتُ بعشرة آلاف قطعة ذهبيّة
نجميّة كنوع من التّعويض

330
00:20:01,130 --> 00:20:02,850
...لا جدوى

331
00:20:01,130 --> 00:20:02,850
!عشرة آلاف قطعة ذهبيّة نجميّة؟

332
00:20:02,850 --> 00:20:04,880
...لم تبقَ لي آمال أو أحلام

333
00:20:02,850 --> 00:20:04,880
...هذا

334
00:20:05,160 --> 00:20:07,030
،إذا ما حوّلناه للين اليابانيّ

335
00:20:07,030 --> 00:20:09,150
القيمة التّقريبيّة هي تريليون

336
00:20:09,150 --> 00:20:10,120
!ماذا؟

337
00:20:10,120 --> 00:20:12,560
ألا تلاحظ بأنّ هذا غير منطقيّ؟

338
00:20:12,810 --> 00:20:14,540
لا مشكلة

339
00:20:14,540 --> 00:20:16,790
،أعطيتُهم ثلاث خيارات

340
00:20:16,790 --> 00:20:18,900
لكن هناك إجابة صحيحة واحدة

341
00:20:19,230 --> 00:20:23,720
إنَّ استمرار الحرب مستحيل
بعد تدمير جيشهم

342
00:20:23,720 --> 00:20:28,320
ومن الواضح أنّ نبلاءهم سيُعارضون
فكرة أن تصبح دولة تابعة

343
00:20:28,320 --> 00:20:31,910
ما يعني أنّهم سيختارون الخيار
الأوّل، وهو التّعويضات

344
00:20:31,910 --> 00:20:35,410
وسيبذلون قصارى جهدهم للتّفاوض

345
00:20:35,630 --> 00:20:39,920
مثل تخفيض المبلغ أو السّماح لهم
بدفع أقساط على مدى عشر سنوات؟

346
00:20:40,150 --> 00:20:42,080
لن نقبل بتخفيض المبلغ

347
00:20:42,080 --> 00:20:45,290
لن تملك مملكةُ فالموث خياراً سوى
القبول بشروطنا

348
00:20:45,290 --> 00:20:51,290
على الأرجح سوف يلتفّون حول الأمر
بفرض المسؤوليّات على طرف ثالث

349
00:20:51,290 --> 00:20:53,310
وماذا سيحدث حينها؟

350
00:20:53,310 --> 00:20:54,960
ما خطّطتُه تماماً

351
00:20:54,960 --> 00:20:58,940
يجدر بنا أن نتمكّن من جمع عشرة آلاف
قطعة ذهبيّة نجميّة على الأقلّ

352
00:20:58,940 --> 00:21:00,410
ما أدراك؟

353
00:21:00,410 --> 00:21:01,900
المسألة بسيطة

354
00:21:02,270 --> 00:21:05,830
،القطع الذّهبيّة النّجميّة قيّمة جدّاً
لدرجة يصعب استخدامها

355
00:21:05,830 --> 00:21:08,400
على الأرجح لن يقبلها أحدٌ كدُفعة

356
00:21:08,400 --> 00:21:09,680
فهمت

357
00:21:09,680 --> 00:21:12,740
لن نملك وسيلة لاستخدامها، لذا
سوف نضطرّ لادّخارها

358
00:21:12,740 --> 00:21:15,490
وماذا تخطِّط غير ذلك أيضاً؟

359
00:21:17,230 --> 00:21:23,080
اختيار الخيار الأوّل يعني أن يدفعوا
تعويضات ويتنازل ملِكُهم

360
00:21:23,080 --> 00:21:26,270
بعد التّنازل، سيخسر إدماريس
،أساس نفوذه وسيطرته

361
00:21:26,510 --> 00:21:30,810
وسوف يُجبَر على تحمُّل المسؤوليّة

362
00:21:30,810 --> 00:21:36,020
إذاً هو الطّرف الثّالث الّذي سوف
يفرض النُّبلاء المسؤوليّة عليه

363
00:21:36,020 --> 00:21:38,140
،الآن بعد رحيل فُرسانهم الملكيّين

364
00:21:38,680 --> 00:21:43,670
مُعارضة النُّبلاء يعني الموت
بالنّسبة للملِك إدماريس

365
00:21:43,670 --> 00:21:45,950
لن يجد خياراً سوى فعل ما يملونه عليه

366
00:21:46,230 --> 00:21:50,600
...لكن سيكون هذا ظاهريّاً فقط. خلف الكواليس

367
00:21:50,600 --> 00:21:54,340
من دون جيش، تخسر جماعة
الملِك أمام جماعة النُّبلاء

368
00:21:54,340 --> 00:21:55,960
...ولتحاشي ذلك

369
00:21:56,200 --> 00:21:57,030
جواب

370
00:21:57,030 --> 00:21:59,720
الطّريقة المثاليّة هي تبنّي جماعة يوم

371
00:21:59,720 --> 00:22:02,400
والحِفاظ على شراكة تعاونيّة

372
00:22:02,400 --> 00:22:03,710
...بالقيام بذلك

373
00:22:03,710 --> 00:22:05,910
...سيضطرّ الملِك إدماريس للتّحالف مع يوم

374
00:22:05,910 --> 00:22:09,340
أو بعبارة أخرى، التّحالف معنا جميعاً

375
00:22:09,680 --> 00:22:12,190
بالضّبط. هذا مُبهر

376
00:22:12,190 --> 00:22:15,680
إذاً جُلّ ما نحتاجه هو مدّ يوم
ببعض قوّاتنا، صحيح؟

377
00:22:15,910 --> 00:22:16,800
أجل

378
00:22:16,800 --> 00:22:20,200
أتوقّع من رازين أن يتواصل معي قريباً

379
00:22:20,410 --> 00:22:22,440
هل سيكون ذلك كافياً كي نفوز؟

380
00:22:22,440 --> 00:22:25,160
ما تعابير الوجه الّتي يُفترَض بي

381
00:22:22,760 --> 00:22:25,160
ملكُهم التّالي لن يشكّل حلفاً

382
00:22:25,160 --> 00:22:26,460
أن أُظهرها الآن؟

383
00:22:25,160 --> 00:22:27,440
مع الدُّول المُحيطة؟

384
00:22:27,440 --> 00:22:31,450
السيّد فيوز والملِك غازيل وجيرانهم
يستخدمون نفوذهم

385
00:22:31,450 --> 00:22:33,440
لتشكيل ضغط على جيرانهم الآخرين

386
00:22:33,440 --> 00:22:37,240
،لذا فُرص ذلك ضئيلة

387
00:22:38,210 --> 00:22:42,180
لكن إذا حدث ذلك، فسوف أتعامل معه شخصيّاً

388
00:22:42,180 --> 00:22:43,720
ليس عليك القلق

389
00:22:43,720 --> 00:22:45,670
حسناً، سأعتمد عليك

390
00:22:45,670 --> 00:22:47,720
تواصل معي إذا استجدّ أي شيء

391
00:22:47,720 --> 00:22:51,720
بالطّبع. دع كلّ شيء على عاتقي يا ملِكي

392
00:24:25,300 --> 00:24:28,320
"الحلقة القادمة، "نوايا القدّيس