1
00:01:31,350 --> 00:01:32,980
تقرير عن الوضع

2
00:01:33,320 --> 00:01:35,830
مجموعة من خمسة، بمن فيهم قائدة
،الفُرسان المُقدّسين هيناتا

3
00:01:35,830 --> 00:01:37,540
متوجِّهون إلى تيمبيست

4
00:01:37,770 --> 00:01:39,440
،يبدو أنّهم يمتلكون قدرات عالية

5
00:01:39,440 --> 00:01:41,790
بما أنّهم تمكّنوا من تجنُّب تعقُّب سوكا

6
00:01:41,790 --> 00:01:43,490
!ماذا؟

7
00:01:43,670 --> 00:01:47,460
فُرسان المعبد من الدُّول المُحيطة
يتوجّهون نحو فالموث

8
00:01:47,770 --> 00:01:50,020
أعدادهم تفوق الـ 30،000 بالمُجمل

9
00:01:50,440 --> 00:01:53,750
هدفهم هو قتل الشّيطان الّذي قتلَ رئيس الأساقفة

10
00:01:53,750 --> 00:01:57,920
والشّيطان الّذي يوفّر الدّعم للسيّد يوم
هو نفس ذلك القاتل

11
00:01:57,920 --> 00:01:59,920
،فما دام هذا هو الفهم الشّائع للأمور

12
00:01:59,920 --> 00:02:03,600
لا يمكننا أن نتأمّل مساعدة من الدُّول
الأخرى أو من نُبلاء فالموث المؤثّرين

13
00:02:04,400 --> 00:02:08,640
كنتُ مخطئاً بإرسال ريهيم كمبعوث

14
00:02:08,830 --> 00:02:09,970
!هذا صحيح

15
00:02:09,970 --> 00:02:12,020
!هذه غلطتك يا ديابلو

16
00:02:12,020 --> 00:02:16,860
بصفتي أعلى منك، يبدو أنّني سأضطرّ
لتولّي القيادة عنك

17
00:02:16,860 --> 00:02:20,940
وماذا ستفعلين بالضّبط يا شيون؟

18
00:02:20,940 --> 00:02:25,200
—بالطّبع، سأقود جيشاً لقتل ملكيّينهم ونبلائهم

19
00:02:25,200 --> 00:02:26,940
!لا، لن تفعلي

20
00:02:29,080 --> 00:02:31,860
ديابلو، لا أحد معصوم عن الخطأ

21
00:02:31,860 --> 00:02:35,900
إنّ كشف هويّتك ليس بالمشكلة الكبيرة، صحيح؟

22
00:02:35,900 --> 00:02:37,500
...ماذا؟ لكن

23
00:02:37,750 --> 00:02:41,510
،إذا تسرّبتْ معلومات بأنّ شيطاناً متورّط في الأمر
—فلن أتمكّن من الاستمرار

24
00:02:41,720 --> 00:02:44,030
،اسمعني. عندما تخطئ

25
00:02:44,030 --> 00:02:46,800
فالمهمّ هو كيف تعوّض الخطأ

26
00:02:47,150 --> 00:02:51,320
.يستطيع أيّ شخص تحمُّل المسؤوليّة والاعتزال
هذا هو المخرج السّهل

27
00:02:51,320 --> 00:02:55,320
هذا صحيح. أنت خادم ريمورو-ساما

28
00:02:55,550 --> 00:02:58,570
لا يجوز أن تفقد العزيمة لأسباب تافهة كهذه

29
00:02:58,880 --> 00:03:00,900
أجل، كما قالت

30
00:03:01,260 --> 00:03:05,000
إذاً هل أستمرّ في تنفيذ خطّتنا؟

31
00:03:05,210 --> 00:03:06,660
بالطّبع

32
00:03:06,820 --> 00:03:09,880
يجب عليك إكمال هذا حتّى النّهاية

33
00:03:10,080 --> 00:03:11,790
أم أنّك تعتقد بأنّك لا تستطيع فعلها؟

34
00:03:12,120 --> 00:03:14,560
!لا، بالتّأكيد لا

35
00:03:15,280 --> 00:03:17,760
،الآن بعد أن ائتمنتني على هذه المهمّة

36
00:03:18,000 --> 00:03:20,700
اسمح لي أن أكملها حتّى النّهاية

37
00:03:21,050 --> 00:03:24,090
جيّد. انطلق وأصلح الأمور

38
00:03:25,620 --> 00:03:26,960
بكلِّ تأكيد

39
00:03:27,280 --> 00:03:30,720
...ريمورو-ساما، فيما يخصُّ الكنيسة المُقدّسة الغربيّة

40
00:03:30,990 --> 00:03:35,350
ما رأيك أن نتكلّم مع أدالمان، بما أنّه كان
كاهناً رفيع المستوى في طائفة المستنيرين؟

41
00:03:35,560 --> 00:03:38,220
أدالمان؟ من هو هذا؟

42
00:03:38,220 --> 00:03:39,050
إجابة

43
00:03:39,050 --> 00:03:41,610
كان يحمي قلعة كلايمان

44
00:03:41,610 --> 00:03:45,610
تذكّرت! الميّت الحيّ الّذي حوّلَتْه
شونا إلى صديق؟

45
00:03:46,360 --> 00:03:49,620
يعمل أدالمان حاليّاً في الكهف المختوم

46
00:03:49,830 --> 00:03:52,900
سأستخدم التّواصُل الفكريّ لاستدعائه
إلى هنا فوراً

47
00:03:52,900 --> 00:03:53,800
شكراً

48
00:03:55,070 --> 00:03:56,840
!هذه نعمة إلهيّة حقّاً

49
00:03:57,090 --> 00:03:58,840
!أنا مسرور للغاية

50
00:03:58,840 --> 00:04:00,680
لا يمكن أن أكون أكثر امتناناً

51
00:04:00,680 --> 00:04:05,260
!على نعمة اللّقاء المُوقَّر بحضرتك

52
00:04:05,260 --> 00:04:06,540
!طالت هذه التحيّة كثيراً

53
00:04:06,550 --> 00:04:09,180
يشرّفني إطراؤك هذا

54
00:04:09,180 --> 00:04:10,390
!لم يكن إطراء

55
00:04:10,390 --> 00:04:12,160
!لديك الإمكانيّة

56
00:04:12,160 --> 00:04:13,290
أتّفق

57
00:04:13,780 --> 00:04:14,770
أدالمان

58
00:04:15,090 --> 00:04:18,040
الوقت يُداهمنا، لذا لندخل صلبَ الموضوع

59
00:04:18,040 --> 00:04:19,900
!حـ-حاضر

60
00:04:20,170 --> 00:04:26,030
عملتُ في السّابق ككاردينال في الكنيسة
المُقدّسة الغربيّة

61
00:04:26,300 --> 00:04:29,540
كاردينال؟ أليست هذه الرّتبة العليا؟

62
00:04:31,190 --> 00:04:33,820
إمبراطوريّة لوبيليوس المُقدّسة

63
00:04:33,820 --> 00:04:37,790
هي دولةٌ دينيّة جعلّتْ لوميناس إلاهاً لها

64
00:04:37,790 --> 00:04:42,210
،إمبراطورها المُنعزِل هو صوت الإله
لكن هويّته مجهولة

65
00:04:42,210 --> 00:04:46,300
تُدار الدّولة بواسطة مجموعة تُسمّى
الوكالة الإمبراطوريّة

66
00:04:46,480 --> 00:04:49,680
عندما كنتُ هناك، لم تكن الكنيسة
المُقدّسة الغربيّة

67
00:04:49,680 --> 00:04:52,680
أكثر من مجرّد فرع من الوكالة الإمبراطوريّة

68
00:04:53,300 --> 00:04:58,410
كان الهدف الوحيد للكنيسة المُقدّسة الغربيّة
،هو مُمارسة دين المُستنيرين

69
00:04:58,410 --> 00:05:01,690
وبالتّالي، لم تكن تمتلك جيشاً عسكريّاً

70
00:05:02,090 --> 00:05:05,440
ثمّ لحماية المؤمنين من التّهديد
،الّذي يشكّله الوحوش

71
00:05:05,440 --> 00:05:11,470
تمّ تأسيس فُرسان المعبد، والّذين
تمّ التّرحيب بهم بواسطة كافّة الدُّول

72
00:05:11,700 --> 00:05:17,380
لكن بعدها بدأ شرخٌ يتوسّع بين
لوبيليوس وبلدان أخرى

73
00:05:17,380 --> 00:05:21,620
:أدّى هذا إلى خلق الحرَس الشّخصيّ للإمبراطور

74
00:05:21,900 --> 00:05:23,740
الحصون الإمبراطوريّة

75
00:05:24,200 --> 00:05:28,750
بالقوّة الاستثنائيّة والسّلطة لإصدار
،الأوامر على فُرسان المعبد

76
00:05:28,750 --> 00:05:32,290
حتّى القناصل، السّلطة العليا
،في الوكالة الإمبراطوريّة

77
00:05:32,290 --> 00:05:36,040
لا يسعهم فعل شيء سوى تقديم طلبات منهم

78
00:05:36,690 --> 00:05:38,610
عقب ذلك، تغيّر الوضع في لوبيليوس

79
00:05:38,610 --> 00:05:41,000
اكتسبوا جيشاً عسكريّاً جديداً
،يُدعى بالصّليبيّين

80
00:05:41,000 --> 00:05:44,290
وازدادت قوّةُ الكنيسة بشكل جذريّ

81
00:05:44,570 --> 00:05:46,070
لماذا؟

82
00:05:46,290 --> 00:05:52,490
في الواقع، أعتقد بأنّ السّبب كان مجموعة من الأشخاص
الّذين يُعرَفون باسم الأجرام السّبعة

83
00:05:52,790 --> 00:05:58,110
عندما كنتُ هناك، كانت سلطتهم هي الثّانية
،بعد سلطة الإمبراطور المُنعزِل

84
00:05:58,110 --> 00:06:01,090
لكنّهم كانوا مجموعة مُريبة جدّاً

85
00:06:01,690 --> 00:06:04,860
أمست الكنيسةُ المُقدّسة الغربيّة
فاسدة حتّى النّخاع

86
00:06:04,860 --> 00:06:08,500
...نصبوا فخّاً لي، وفي النّهاية

87
00:06:08,500 --> 00:06:10,650
تكبّدتَ معاناة كبيرة إذاً؟

88
00:06:11,030 --> 00:06:14,660
،على أيّ حال، أصبح الصّليبيّون مجرّد واجهة

89
00:06:14,660 --> 00:06:18,100
وأعادت هيناتا ساكاغوتشي بناءهم ليصبحوا
الفرسان الأقوى على الإطلاق

90
00:06:18,100 --> 00:06:20,440
—وبالتّالي اكتسبتْ لوبيليوس قوّتَين حاكمتين

91
00:06:20,440 --> 00:06:23,380
الصّليبيّون والحصون الإمبراطوريّة

92
00:06:23,660 --> 00:06:25,880
من فضلك توخّ الحذر من لوبيليوس

93
00:06:25,880 --> 00:06:31,260
،لديهم القدّيسون العُظماء العشرة
وهم الفئة المُتنوِّرة

94
00:06:31,260 --> 00:06:34,140
القدّيسون العظماء العشرة... من الفئة المُتنوِّرة؟

95
00:06:34,600 --> 00:06:35,460
إجابة

96
00:06:35,460 --> 00:06:39,580
هذه الحالة هي الّتي يتطوّر إليها البشر
بعد الخضوع لاختبارات صارمة عديدة

97
00:06:39,580 --> 00:06:41,450
هذا مُشابه لعامِل سيّد الشّيطان

98
00:06:41,790 --> 00:06:46,350
إنّهم أعضاء في الحصون الإمبراطوريّة
ويُطلَق عليهم بحُكماء القتال الثّلاثة

99
00:06:46,650 --> 00:06:49,200
ويشمل ذلك قادة الصّليبيّين الستّة

100
00:06:49,200 --> 00:06:51,040
وهيناتا ساكاغوتشي

101
00:06:51,760 --> 00:06:55,940
إذاً... من الأشخاص الأربعة الّذين
يرافقون هيناتا هنا؟

102
00:06:55,940 --> 00:06:58,710
غالباً هم أعضاء من القدّيسين العظماء العشرة

103
00:06:58,710 --> 00:07:01,270
،إذا تحرّك فُرسان المعبد

104
00:07:01,270 --> 00:07:03,370
فهذا يعني تحرُّك الحصون الإمبراطوريّة
وحكماء القتال الثّلاثة أيضاً

105
00:07:03,980 --> 00:07:05,520
،يا إلهي

106
00:07:05,520 --> 00:07:11,360
ككاردينال سابق، اسمح لي أن أعترض
على هذه المرأة الّتي تُدعى هيناتا

107
00:07:11,730 --> 00:07:15,220
—يمكننا إقناعها للتحوّل من عقيدتها إلى عقيدتـ

108
00:07:15,220 --> 00:07:16,680
مهلاً لحظة

109
00:07:16,680 --> 00:07:20,160
لستُ بحاجة ذلك. يمكنك الانصراف الآن

110
00:07:20,160 --> 00:07:20,810
ماذا؟

111
00:07:22,950 --> 00:07:25,600
فهمت. هذه إحدى الطّرُق بالفعل

112
00:07:25,600 --> 00:07:27,340
فكرة مُبهرة

113
00:07:27,340 --> 00:07:28,840
!عمّاذا تتكلّمون؟

114
00:07:28,840 --> 00:07:30,970
!أنتم تعقّدون المسألة أكثر ممّا هي مُعقّدة

115
00:07:32,960 --> 00:07:34,720
حصلنا على كافّة المعلومات الآن

116
00:07:34,720 --> 00:07:37,390
أعتقد حان وقت البدء برسم خطّة مُضادّة

117
00:07:38,760 --> 00:07:40,310
يبدو أنّ دوري قد حان

118
00:07:40,310 --> 00:07:43,890
لا، سأدعك مسؤولاً عن خطّ دفاعنا الأخير

119
00:07:43,890 --> 00:07:44,690
!ماذا؟

120
00:07:44,880 --> 00:07:46,680
يبدو هذا رائعاً، صحيح؟

121
00:07:46,680 --> 00:07:49,090
!خطّ دفاعنا الأخير

122
00:07:50,010 --> 00:07:53,780
أعتقد حقّاً بأنّك الشّخص الوحيد الّذي
...يمكنني الاعتماد عليه في فعل ذلك

123
00:07:53,780 --> 00:07:57,460
!بكلِّ تأكيد! كنتُ أفكِّر في الشّيء ذاته بنفسي

124
00:07:57,460 --> 00:08:00,250
جيّد. هذا سيمنعه من الهيَجان

125
00:08:00,840 --> 00:08:04,250
سأعلن الآن عن قائمة تعزيزات السيّد يوم

126
00:08:04,420 --> 00:08:07,810
سائسو الغوبلن المئة، بقيادة غوبتا

127
00:08:08,110 --> 00:08:12,610
،الأرقام الخضراء وعددهم 4000
بقيادة الـ 100 كوريناي

128
00:08:12,800 --> 00:08:16,010
وأخيراً، الـ 100 هيريو، بقيادة غابيرو

129
00:08:16,010 --> 00:08:19,010
الجيش المُكوَّن من 4300 هذا يمثّل التّعزيزات

130
00:08:19,010 --> 00:08:20,700
هل من تعليقات؟

131
00:08:20,700 --> 00:08:22,570
!لحظة، أنا؟

132
00:08:22,870 --> 00:08:23,940
هل هناك مشكلة؟

133
00:08:24,200 --> 00:08:26,940
لا... لا مشكلة

134
00:08:28,010 --> 00:08:30,090
هاكورو سيقود التّعزيزات

135
00:08:30,090 --> 00:08:32,940
إن وقع أي مكروه، فسوف أنطلق فوراً لمساندته

136
00:08:32,940 --> 00:08:34,680
يمكنكم الاعتماد عليّ

137
00:08:34,680 --> 00:08:36,060
عُلِم

138
00:08:36,310 --> 00:08:37,970
رانغا، هل أنت مستيقظ؟

139
00:08:38,180 --> 00:08:40,240
مولايّ، هل سننطلق؟

140
00:08:40,240 --> 00:08:43,260
تحتاج لتمرين بين الحين والآخر
أيضاً، أليس كذلك؟

141
00:08:43,260 --> 00:08:45,180
ابقَ مع غوبتا وحافِظ على سلامته

142
00:08:45,180 --> 00:08:48,250
أشعر براحة أكبر وأنا على علم
!بأنّ رانغا سيكون معي

143
00:08:48,250 --> 00:08:49,410
!اعتبِر الأمر قد أُنجِز

144
00:08:49,410 --> 00:08:52,420
علّمَتْني الآنسة شيون كيف
!أتمرّن على ضبط النّفس

145
00:08:53,470 --> 00:08:55,010
...حـ-حسناً

146
00:08:55,010 --> 00:08:58,220
حـ-حسناً يا ديابلو، ماذا ستفعل بشأن خطّتك؟

147
00:08:58,740 --> 00:09:01,720
لم أكن أتوقّع وجود 30،000 من التّعزيزات

148
00:09:01,720 --> 00:09:05,000
رسمتُ خطّتي على أساس أنّ
جيش الملك الجديد

149
00:09:05,000 --> 00:09:08,270
...سيبلغ تعداده حوالي 10،000 كحدٍّ أقصى

150
00:09:08,770 --> 00:09:13,060
،أوّلاً، حالما قامَ الملِكُ إدوارد بتعبئة القوّات

151
00:09:13,060 --> 00:09:16,430
طلبتُ من إيدماريس أن يرسل
رسالةً يسأل فيها عن السّبب

152
00:09:17,200 --> 00:09:21,830
لن يكون الملكُ الجديد مُلزَماً
،بإمضاء عقدٍ أنشأه إيدماريس

153
00:09:21,830 --> 00:09:25,670
لذا سوف يعدم إيدماريس ويؤكّد
على إبطال قسَمه

154
00:09:25,920 --> 00:09:28,890
،ثمّ إذا غضِبنا واتّخذنا إجراء عسكريّاً

155
00:09:28,890 --> 00:09:32,890
ستتوحّد الأقاليم الغربيّة معاً للردّ

156
00:09:33,250 --> 00:09:36,360
،يلتجئ إيدماريس حاليّاً في إقليم نيدول

157
00:09:36,360 --> 00:09:38,860
تحت حماية السيّد يوم

158
00:09:39,750 --> 00:09:42,430
لدى إقليم نيدول 5000 جنديّ

159
00:09:42,430 --> 00:09:45,160
كانت الخطّة هي أن تستخدم
سحرَ الانتقال الآنيّ

160
00:09:45,160 --> 00:09:49,150
لإرسال جيشنا المُكوّن من 4،300
...إلى هناك كذلك

161
00:09:49,440 --> 00:09:53,460
،لكن إذا كان سيزحف جيشٌ قوامه 30،000
فلن يكون ذلك كافياً

162
00:09:53,780 --> 00:09:57,360
أقصد، في أسوأ الحالات، لدينا
خيار الاستسلام هذه المرّة

163
00:09:57,360 --> 00:10:00,870
،إذا تنازلتُ عن ديونهم المتبقّية
فيمكننا تجنُّب حرب، صحيح؟

164
00:10:00,870 --> 00:10:05,240
يجب ألّا تفعل! فهذا سيؤدّي
!إلى استخفافهم بك

165
00:10:06,560 --> 00:10:08,960
يجب ألّا نستسلم مهما كانت الظّروف

166
00:10:09,280 --> 00:10:12,850
ريمورو-ساما، هلّا سمحت لي بمُعالجة هذا الأمر؟

167
00:10:12,850 --> 00:10:17,970
أجل، لكن... لا أريد أذيّة أحد لا صِلة له بالأمر

168
00:10:18,150 --> 00:10:19,990
لن تكون هذه مشكلة

169
00:10:19,990 --> 00:10:22,630
،إذا كانت هذه هي رغبة ملِكي

170
00:10:22,630 --> 00:10:26,460
فمن واجبي كخادِمك أن أكمل
المهمّة حتّى نهايتها

171
00:10:26,460 --> 00:10:27,980
ماذا ستفعل؟

172
00:10:28,640 --> 00:10:30,640
سوف أبحث عن القاتل

173
00:10:30,640 --> 00:10:34,960
الشّخص الّذي حاول إلباسي تهمة
ارتكاب جريمة كهذه

174
00:10:35,160 --> 00:10:37,990
يا للهول! إنّه غاضبٌ جدّاً

175
00:10:38,320 --> 00:10:43,560
ربّما يكون هناك البعض من بين الـ 30،000
الّذين لديهم ارتباطات بالقاتل

176
00:10:43,560 --> 00:10:46,500
سوف أجري تحقيقاً لطيفاً

177
00:10:46,500 --> 00:10:51,280
!بئساً! لا أشعر بذرّة لطف فيه الآن

178
00:10:51,640 --> 00:10:53,890
إذا كنتَ ستذهب، فليس لدينا ما نقلق بشأنه

179
00:10:53,890 --> 00:10:54,840
هاكورو

180
00:10:55,070 --> 00:10:58,660
هل يمكنك إخضاع قوّات الملِك
الجديد دون خسارة أحد؟

181
00:10:58,990 --> 00:11:01,150
ينبغي أن يكون هذا سهلاً

182
00:11:01,150 --> 00:11:01,720
ماذا؟

183
00:11:01,720 --> 00:11:04,740
سيكون من الأسهل القضاء عليه
،دُفعة واحدة بكمين

184
00:11:04,740 --> 00:11:07,430
لكن لن يكون هذا بمثابة تدريب لقوّاتنا

185
00:11:07,430 --> 00:11:08,080
لحظة، ماذا؟

186
00:11:08,080 --> 00:11:08,940
صحيح

187
00:11:09,160 --> 00:11:11,980
غابيرو، جهِّز الكثير من جرعات الشّفاء

188
00:11:11,460 --> 00:11:12,500
ماذا الآن؟

189
00:11:11,980 --> 00:11:14,360
!عُلِم! يمكنك الاعتماد عليّ

190
00:11:14,520 --> 00:11:18,360
...تسير كافّة الأمور من دوني

191
00:11:18,610 --> 00:11:21,030
ريمورو-ساما، يبدو أنّه ليس علينا القلق

192
00:11:21,030 --> 00:11:22,990
بشأن غزو مملكة فالموث

193
00:11:22,990 --> 00:11:25,430
أ-أجل، هذا ما أعتقده

194
00:11:25,620 --> 00:11:27,280
أتمنّى التّوفيق لكم جميعاً

195
00:11:27,280 --> 00:11:28,500
!أجل

196
00:11:32,960 --> 00:11:37,000
الآن يبقى فقط مسألة مَن سيتعامل
مع هيناتا وطاقمها

197
00:11:37,220 --> 00:11:39,610
ريمورو-ساما، أنباء عاجلة

198
00:11:39,610 --> 00:11:41,560
رُصِدَتْ تحرُّكات بين الصّليبيّين

199
00:11:41,560 --> 00:11:43,260
حدث شيء ما لمجموعة هيناتا؟

200
00:11:43,260 --> 00:11:44,080
لا

201
00:11:44,300 --> 00:11:47,710
،هوكوسو، والّذي كان يراقب مملكةَ إنغراشيا

202
00:11:47,710 --> 00:11:50,070
أبلغ عن مغادرة 100 جنديّ راجل للتوّ

203
00:11:50,070 --> 00:11:51,310
!ماذا؟

204
00:11:53,140 --> 00:11:56,160
يبدو أنّه من المؤكّد أنّهم في طريقهم إلى هنا

205
00:11:59,120 --> 00:12:01,250
هل سينضمّون لهيناتا؟

206
00:12:01,250 --> 00:12:02,280
هذا غير واضح

207
00:12:02,530 --> 00:12:06,070
من المُقدَّر أن تصِل هيناتا إلى هنا
،في غضون أسبوعين كأقرب وقت

208
00:12:06,070 --> 00:12:09,340
والقوّة الّتي تتبعها سوف تصل
في نفس الوقت تقريباً

209
00:12:09,340 --> 00:12:12,990
،إذاً إن كنتُ سأتعامل مع هيناتا بنفسي

210
00:12:12,990 --> 00:12:15,200
فماذا سنفعل بشأن الأربعة الآخرين؟

211
00:12:15,430 --> 00:12:16,270
إجابة

212
00:12:16,270 --> 00:12:19,710
الشّخص الوحيد الّذي يتطلّب يقظة
هو هيناتا ساكاغوتشي بنفسها

213
00:12:19,710 --> 00:12:21,790
أجل، لهذا أواجه صعوبة في الأمر

214
00:12:21,790 --> 00:12:22,970
هل أنت بخير؟

215
00:12:22,970 --> 00:12:26,060
أشعر بأنّك كنت أفضل كحكيم عظيم

216
00:12:28,850 --> 00:12:30,810
!حسناً! دع الأمر لي

217
00:12:30,810 --> 00:12:34,560
ماذا لو أردتُ اختبار نفخة التنّين خاصّتي؟

218
00:12:34,800 --> 00:12:36,790
!يمكنك القول بأنّها كانت طلقة عرَضيّة

219
00:12:36,790 --> 00:12:38,070
!اصمت أنت

220
00:12:38,070 --> 00:12:41,570
،الخطّ الدّفاعي الأخير يظهر في الأخير
!في آخر لحظة

221
00:12:41,950 --> 00:12:45,920
إذا فعلَ ذلك، وتبيّن بأنّ هيناتا
...أردت التّفاوض فقط

222
00:12:45,920 --> 00:12:46,690
إشعار

223
00:12:46,690 --> 00:12:49,090
احتماليّة أن يكون الأمر كذلك عالية

224
00:12:49,090 --> 00:12:49,770
ماذا؟

225
00:12:50,300 --> 00:12:54,700
إذاً ربّما لا تزال هناك فُرصة
...لتسوية الأمور سلميّاً

226
00:12:55,560 --> 00:12:59,070
كانت شيزو-سان قلقة بشأن ما انتهت
إليه هيناتا أيضاً

227
00:12:59,840 --> 00:13:02,650
لا أريد أن نبدأ بقتل بعضنا الآخر
فحسب دون طرح أسئلة

228
00:13:04,890 --> 00:13:08,160
...إذا انهارت المُفاوضات، حينها

229
00:13:09,850 --> 00:13:11,260
حسناً، لقد قرّرت

230
00:13:11,490 --> 00:13:15,240
لنبذل قصارى جهدنا بتجنّب وقوع ضحايا
بين الفُرسان المُقدّسين أيضاً

231
00:13:19,020 --> 00:13:20,300
،بصيغة أخرى

232
00:13:20,300 --> 00:13:23,300
لا بأس من تقطيعهم وتنويمهم، صحيح؟

233
00:13:23,520 --> 00:13:25,860
!أ-أمزح فحسب

234
00:13:26,270 --> 00:13:27,100
أحم

235
00:13:27,310 --> 00:13:29,940
بعبارة أخرى، نتجنّب قتل أي فارس مُقدّس

236
00:13:29,940 --> 00:13:33,120
مع منع مقتل أي أحدّ منّا في نفس الوقت

237
00:13:33,120 --> 00:13:36,970
وريمورو-ساما سيهزم قائدَ العدوّ
في هذه الأثناء، صحيح؟

238
00:13:36,970 --> 00:13:40,270
أجل، أصبتِ. يسرّني أنّكِ تفهمين الخطّة

239
00:13:40,270 --> 00:13:42,420
!في هذه الحالة، فلديّ خطّة

240
00:13:42,420 --> 00:13:43,130
!ماذا؟

241
00:13:43,130 --> 00:13:44,450
إليّ بها

242
00:13:44,450 --> 00:13:45,450
!حسناً

243
00:13:45,450 --> 00:13:48,060
يتكوّن فريقي يوميغايري من 100 عضو

244
00:13:48,060 --> 00:13:50,060
!مُكافئ للصّليبيّين

245
00:13:50,060 --> 00:13:52,360
أعتقد ينبغي أن نواجههم

246
00:13:52,430 --> 00:13:53,400
!هل فقدتِ صوابكِ؟

247
00:13:53,400 --> 00:13:56,430
رتبة أعضاء يوميغايري من حيث
!المهارة هي ج فقط

248
00:13:56,600 --> 00:13:59,280
!لن تكون مُكافِئة على الإطلاق

249
00:13:59,280 --> 00:14:02,320
لا، أعتقد بأنّ فكرتها قد تفلح

250
00:14:02,320 --> 00:14:02,930
ماذا؟

251
00:14:03,070 --> 00:14:08,030
أعضاء يوميغايري لديهم المهارتان الإضافيّتان
ذاكرة كاملة والتجدُّد الذّاتيّ

252
00:14:08,530 --> 00:14:10,860
،من غير المرجّح أن تقتلهم أي هجمة عاديّة

253
00:14:10,860 --> 00:14:14,260
لذا ضعفهم قد يشكّل طعماً للفُرسان المُقدّسين
الّذين سيشعرون بالرِّضا واللّامُبالاة

254
00:14:14,830 --> 00:14:16,390
يمكننا الاستفادة من ذلك

255
00:14:16,620 --> 00:14:19,440
تقصد بأنّهم مثاليّون لإكسابنا الوقت؟

256
00:14:19,780 --> 00:14:21,160
!تماماً

257
00:14:21,440 --> 00:14:25,380
ريمورو-ساما، إن لزم الأمر، سيأتي
الكوريناي الخاصّون بي لإعانتهم

258
00:14:26,140 --> 00:14:27,760
غوبوا، هل هذا مناسب؟

259
00:14:27,990 --> 00:14:28,640
أجل

260
00:14:29,010 --> 00:14:31,380
هذه قائدة الكوريناي، غوبوا

261
00:14:31,930 --> 00:14:35,660
درّبتُ رجالي تدريباً يوازي التّدريب
الّذي منحَتْه شيون-ساما لرجالها

262
00:14:35,940 --> 00:14:40,650
من فضلك اسمح لنا بالاستفادة من تلك
القوّة لمساعدتك الآن يا ريمورو-ساما

263
00:14:40,650 --> 00:14:43,540
حسناً إذاً. سأعتمد عليكِ يا شيون

264
00:14:43,540 --> 00:14:44,360
!حاضرة

265
00:14:44,660 --> 00:14:47,420
غوبوا، صحيح؟ أعتمد عليكِ في دعمها

266
00:14:47,420 --> 00:14:50,550
بالطّبع. سوف أرتقي لثِقتك يا ريمورو-ساما

267
00:14:50,870 --> 00:14:54,930
يبقى فقط الأشخاص الأربعة الّذين يُرافِقون هيناتا

268
00:14:54,930 --> 00:14:58,340
الوحيدون القادرون على مواجهة
...المُتنوّرين الآن هم

269
00:15:00,640 --> 00:15:02,850
أنا سأتعامل مع هيناتا

270
00:15:02,850 --> 00:15:06,140
فيلدورا مُستبعَد. غيلد مُعلَّق

271
00:15:06,140 --> 00:15:11,820
ديابلو ورانغا وهاكورو وغابيرو عليهم
التّركيز على مملكة فالموث

272
00:15:11,820 --> 00:15:13,470
...ما يعني

273
00:15:14,100 --> 00:15:18,330
بينيمارو وشيون وسوي الوحيدون
الّذين سيكونون متفرّغين للتحرّك

274
00:15:18,330 --> 00:15:20,140
سأذهب بالطّبع

275
00:15:20,480 --> 00:15:23,460
يمكنني استخدام نسخي الجسديّة لجمع معلومات

276
00:15:23,460 --> 00:15:26,840
سوكا وشركاؤها أثبتوا نفعهم كذلك

277
00:15:26,840 --> 00:15:30,300
!وأنا، بصِفتي سكرتيرتك، سأبقى بجانبك دوماً

278
00:15:30,560 --> 00:15:31,480
إشعار

279
00:15:31,670 --> 00:15:35,200
نظراً إلى احتماليّة أن يكون لديهم
،متنوّرون في قوّتهم المنفصِلة

280
00:15:35,200 --> 00:15:37,980
فسيكون من الحكمة إرسال بعض
الجنود إلى هناك كذلك

281
00:15:38,520 --> 00:15:41,080
أجل، أعتقد هذه مشكلة مُحتمَلة أخرى

282
00:15:41,590 --> 00:15:42,780
انتظر يا سوي

283
00:15:42,780 --> 00:15:45,260
هل هناك أحدٌ بين الفُرسان المُقدّسين يسافرون

284
00:15:45,260 --> 00:15:47,150
بمعزل عن هيناتا يبدو خطيراً؟

285
00:15:49,500 --> 00:15:52,760
،أنا متأكّد بأنّ جميعهم رتبتهم أعلى من أ

286
00:15:53,020 --> 00:15:55,670
لكن لا يبدو أنّ أيّاً منهم يمتلك حضوراً هائلاً

287
00:15:56,260 --> 00:16:00,340
لكن الأشخاص الأقوى هم الأبرع
في إخفاء حضورهم

288
00:16:00,870 --> 00:16:03,650
شيون، أريدكِ أن تستمرّي في مراقبة
قوّتهم المُنفصِلة أيضاً

289
00:16:03,890 --> 00:16:06,660
وسيكون الكوريناي تحت قيادة شيون

290
00:16:06,660 --> 00:16:08,350
أما من مانع يا بينيمارو؟

291
00:16:08,350 --> 00:16:13,610
سوي وأنا نستطيع مواجهة اثنين
من مُرافقي القدّيسة هيناتا

292
00:16:14,080 --> 00:16:18,150
انتظر لحظة يا ريمورو-ساما! أعتقد
!هنا سوف تكون بحاجتي

293
00:16:18,150 --> 00:16:18,620
ماذا؟

294
00:16:18,620 --> 00:16:21,020
إذا كنّا نتكلّم عن استخدامه، فلديك أنا أيضاً

295
00:16:21,020 --> 00:16:21,660
!ماذا؟

296
00:16:21,660 --> 00:16:24,410
لديك أنا كذلك! لن أدع غوبتا
!يحظى بالمجد كلّه

297
00:16:24,410 --> 00:16:25,960
!حسناً، تمهّلوا قليلاً

298
00:16:26,120 --> 00:16:29,040
أعتقد بأنّ الأمر خطير عليكم

299
00:16:29,040 --> 00:16:31,670
!ما-ما الأمر؟ نحن نعقد اجتماعاً الآن

300
00:16:31,670 --> 00:16:35,040
!أجل، ونريد أن نشارك في اجتماعكم أيضاً

301
00:16:35,040 --> 00:16:35,930
مهلاً يا صوفيا

302
00:16:35,930 --> 00:16:38,270
لا تدخلي بهذا الشّكل العنيف

303
00:16:38,510 --> 00:16:40,320
أنت، لقد أتينا

304
00:16:40,560 --> 00:16:43,730
اسمح لنا بمساعدتك أيضاً يا ريمورو-ساما

305
00:16:43,940 --> 00:16:49,970
سيّد الشّيطان ريمورو، من فضلك امنحنا
الفُرصة لردّ دَيننا لك

306
00:16:50,220 --> 00:16:51,990
ستساعداننا؟

307
00:16:51,990 --> 00:16:52,880
أجل

308
00:16:52,880 --> 00:16:56,870
لن تسنح فُرصة أفضل لنردّ الجميل

309
00:16:57,020 --> 00:17:01,320
لكن لا يمكنكما القيام بأيّ تصرُّف
دون إذن كاريون، صحيح؟

310
00:17:01,320 --> 00:17:05,840
بل المُرجَّح بأنّه سيوبّخنا إذا
لم نفعل شيئاً الآن

311
00:17:06,170 --> 00:17:08,320
يمكننا الوثوق بهما

312
00:17:08,900 --> 00:17:09,920
هل يمكنني الاعتماد عليكما؟

313
00:17:10,210 --> 00:17:11,160
من فضلك

314
00:17:11,160 --> 00:17:13,260
نحن ممتنّتان لسؤالك هذا

315
00:17:16,160 --> 00:17:17,730
دعوني أقول كلمة أخيرة

316
00:17:18,390 --> 00:17:22,390
إذا تحوّل الأمر إلى معركة وأمسى الحِفاظ
،على وضعنا الرّاهن صعباً

317
00:17:22,390 --> 00:17:25,330
حوّلوا تركيزكم فوراً إلى إبادة خصومكم

318
00:17:25,720 --> 00:17:28,120
الأولويّة لأرواح أصدقائنا

319
00:17:28,360 --> 00:17:32,370
فلتعلموا بأنّ كلّ هذا لا جدوى منه
إذا مات واحد منكم

320
00:17:33,030 --> 00:17:35,800
أتأمّل أن نتجاوز جميعُنا هذا
!كما في المرّة الماضية

321
00:17:35,800 --> 00:17:36,870
!هذا كلّ شيء

322
00:17:36,870 --> 00:17:38,120
!عُلِم

323
00:17:46,360 --> 00:17:48,120
كما هو مُخطّط، صحيح؟

324
00:17:48,350 --> 00:17:50,630
لم يكتشفوا ما نفعله

325
00:17:52,080 --> 00:17:57,490
سمعتُ أنّ تلك السّاحرة ذكيّة، لكنّها
لم ترتقِ لتوقّعاتي

326
00:17:57,490 --> 00:18:00,390
رغم ذلك، لا يمكننا أن نرخي دفاعنا

327
00:18:00,390 --> 00:18:01,610
بالفعل

328
00:18:01,610 --> 00:18:06,520
المُخطّطات الطّائشة ضعيفة
في وجه القوّة العسكريّة الصّرفة

329
00:18:06,900 --> 00:18:12,420
رغم ذلك يا دامرادا، يبدو أنّهم كشفوا أكاذيبك

330
00:18:14,560 --> 00:18:16,000
لا مشكلة

331
00:18:16,000 --> 00:18:18,110
اكتسبنا شيئاً بالمقابل رغم ذلك

332
00:18:18,450 --> 00:18:21,850
أقصد ثِقتك، يا غرانبيل المُوقَّر

333
00:18:22,600 --> 00:18:23,840
مُضحِك

334
00:18:24,090 --> 00:18:29,290
أعلم بأنّ هدف الشّرق هو خلق فوضى
في الغرب وذلك كي تتمكّنوا من بيع أسلحة

335
00:18:29,290 --> 00:18:33,810
ثمّ تعبئة الإمبراطوريّة حالما نُستنزَف

336
00:18:34,140 --> 00:18:38,010
كشفتَ الأمر. مُبهر يا غرانبيل المُوقَّر

337
00:18:39,150 --> 00:18:41,900
أيّاً يكن. لندخل صلبَ الموضوع

338
00:18:42,560 --> 00:18:45,900
إنَّ القضاء على هيناتا هو هدف يتشاركه كِلانا

339
00:18:46,150 --> 00:18:48,130
هل كلامي صحيح؟

340
00:18:48,130 --> 00:18:49,520
أجل، بالطّبع

341
00:18:49,880 --> 00:18:52,480
،العقبة الكبرى في طريقنا، تنّين الشرّ

342
00:18:52,480 --> 00:18:56,400
يمكن التّفاوض معه الآن، بعد أن تمّت
تهدئته بواسطة سيّد الشّيطان ريمورو

343
00:18:56,400 --> 00:18:59,170
هذا يعني أنّ لدينا خيارات

344
00:18:59,420 --> 00:19:03,280
التحدّي التّالي الّذي نواجهه هو تهديد
الكنيسة المُقدّسة الغربيّة

345
00:19:03,470 --> 00:19:06,610
ماذا؟ أولسنا نُعتبَر تهديداً أيضاً؟

346
00:19:06,610 --> 00:19:08,000
بالطّبع لا

347
00:19:08,000 --> 00:19:11,750
الشّيوخ العظماء الخمسة فطِنون جدّاً

348
00:19:12,190 --> 00:19:14,800
،بعد أن تسيطر الإمبراطوريّة على الغرب

349
00:19:14,800 --> 00:19:18,280
لِمَ لا نتحكّم باقتصادها معاً؟

350
00:19:18,280 --> 00:19:21,260
معاً؟ لا تُثِرني على الضّحك

351
00:19:22,480 --> 00:19:26,160
هل ستُعادينا إذاً؟

352
00:19:27,070 --> 00:19:29,140
كيف لتاجر أسلحة صاغر

353
00:19:29,140 --> 00:19:32,280
أن يتكلّم بهذه الطّريقة مع المُوقَّر غرانبيل؟

354
00:19:32,620 --> 00:19:34,480
سِلاح ناريّ؟

355
00:19:34,770 --> 00:19:38,200
أنا متفاجئ من رؤيتها تُوزَّع في الغرب

356
00:19:38,200 --> 00:19:40,860
ماذا؟ أتعرف ما يكون هذا؟

357
00:19:41,060 --> 00:19:43,050
تراجعي يا غليندا

358
00:19:44,270 --> 00:19:48,370
لا نريد أن نمنح الأفضليّة لإنغراشيا أو فالموث

359
00:19:48,750 --> 00:19:52,080
لا يمكننا أن ندع بلادنا تقع
في قبضة سيّد شيطان

360
00:19:52,840 --> 00:19:55,000
ولا تروقنا أيضاً فكرة

361
00:19:55,000 --> 00:19:59,840
أن تُنتزَع منّا قناة مبيعاتنا عبر مملكة الأقزام

362
00:19:59,840 --> 00:20:04,470
سيّد الشّيطان كلايمان، شريك تجاريّ
جيّد، قد تُوفِّي

363
00:20:04,470 --> 00:20:07,230
لدينا ردّ اعتبار من سيّد الشّيطان ريمورو

364
00:20:07,490 --> 00:20:10,560
—بالطّبع، سوف نتعاون معك. لذا

365
00:20:10,560 --> 00:20:12,780
لقد تكفّلنا بمسألة هيناتا

366
00:20:12,780 --> 00:20:15,040
أجل، لا شكّ في ذلك

367
00:20:15,040 --> 00:20:17,590
هيناتا متوجّهة نحو تيمبيست

368
00:20:17,590 --> 00:20:20,860
كما هو مُخطّط إذاً، سوف أقضي
على الشّيطان الّذي يعمل

369
00:20:20,860 --> 00:20:23,690
خلف الكواليس في مملكة فالموث

370
00:20:23,690 --> 00:20:24,760
أجل

371
00:20:24,760 --> 00:20:29,200
غليندا، ساعدي إدوارد في محاصرة إيدماريس

372
00:20:29,200 --> 00:20:30,620
أجل، أعلم

373
00:20:30,920 --> 00:20:33,730
،حالما يعلم بأنّ هيناتا في طريقها لقتله

374
00:20:33,730 --> 00:20:36,380
لن يستعجل سيّدُ الشّيطان في القيام بأي تحرُّك

375
00:20:36,380 --> 00:20:43,130
لكن إذا نجحَتْ هيناتا ساكاغوتشي
...في هزيمة سيّد الشّيطان ريمورو

376
00:20:43,130 --> 00:20:44,770
استرخِ

377
00:20:45,220 --> 00:20:48,890
ريمورو ليس كأسياد الشّيطان الآخرين

378
00:20:49,230 --> 00:20:52,410
،إنّه خطرٌ يجب القضاء عليه في نهاية المطاف

379
00:20:52,410 --> 00:20:54,520
لكن اتّخذنا الإجراءات اللّازمة

380
00:20:57,500 --> 00:20:59,940
سأدع الأمر لك إذاً

381
00:21:02,010 --> 00:21:03,840
!ذلك الوغد المُغيظ

382
00:21:03,840 --> 00:21:05,740
كيف يجرؤ على الاستخفاف بنا هكذا؟

383
00:21:06,350 --> 00:21:08,120
لا تقولي هذا يا غليندا

384
00:21:08,540 --> 00:21:14,240
إنّهم المجتمع السرّي الّذي يحكم
:العالمَ السّفليّ في الشّرق

385
00:21:15,260 --> 00:21:17,990
كيربيروس دون سِواهم

386
00:21:17,990 --> 00:21:20,040
وهو أحد قادتهم، دامرادا الذّهب

387
00:21:20,240 --> 00:21:21,170
...رغم ذلك

388
00:21:21,520 --> 00:21:24,110
قد لا يكون الأمر سهلاً بالنّسبة لهم

389
00:21:24,110 --> 00:21:29,780
فالشّيطان الّذي يواجهونه ليس
مجرّد شيطان رئيسيّ في النّهاية

390
00:21:29,780 --> 00:21:31,560
—عندما يتطلّب الأمر، أنا

391
00:21:31,850 --> 00:21:34,320
أنا متأكّدٌ بأنّ هذه ليست
،مُشكلة بالنّسبة لكِ

392
00:21:34,320 --> 00:21:38,340
لكن حكيمي القِتال الآخرَين مشمولان
أيضاً، من باب الحيطة فقط

393
00:21:38,820 --> 00:21:42,590
من المهمّ أن نقلّص عدد البيادق الّذين
بمتناول سيّد الشّيطان ريمورو

394
00:21:42,590 --> 00:21:44,920
،وحتّى لو كان ذلك غير ممكن

395
00:21:44,920 --> 00:21:48,200
هذا سيجعل النّصر للقوّات المُتحالفة حتميّاً

396
00:21:48,480 --> 00:21:53,450
غليندا، استخدمي كيربيروس لإيقاف
تحرُّكات الشّيطان

397
00:21:53,450 --> 00:21:55,300
أجل، عُلِم

398
00:21:55,300 --> 00:21:59,480
أنا، غليندا آتلي، أقبل بهذه المهمّة

399
00:21:59,480 --> 00:22:01,630
لقد طلبتُ من ظلّ الدّماء يجرون مُناورات

400
00:22:01,840 --> 00:22:04,400
للدّفع بساري وغريغوري للتحرُّك

401
00:22:04,400 --> 00:22:07,880
...عُلِم. كلّ هذا لأجل لعائلة روتزو

402
00:22:07,880 --> 00:22:11,350
ولأجل حرّيتي

403
00:22:14,340 --> 00:22:16,680
هذا سيَفي بالغرض، أليس كذلك يا ماريبيل؟

404
00:22:16,680 --> 00:22:20,160
أجل. أجل يا جدّي

405
00:22:20,160 --> 00:22:23,940
سيّد الشّيطان ريمورو مشغول بالقدّيسة هيناتا

406
00:22:24,320 --> 00:22:27,450
سننتهز هذه الفُرصة لإخماد الحرب
الأهليّة في فالموث

407
00:22:27,450 --> 00:22:29,800
عن طريق تدخُّل الأقاليم الغربيّة

408
00:22:30,250 --> 00:22:32,950
باسم الملِك الجديد، إدوارد

409
00:22:33,440 --> 00:22:37,520
ثمّ سيكون إدوارد مَديناً لك

410
00:22:38,260 --> 00:22:41,600
بالفعل. هذا صحيح يا ماريبيل

411
00:22:41,960 --> 00:22:47,420
لا يُسمَح لأحد بالتدخُّل في الحديقة
الّتي تتحكّم بها روتزو

412
00:22:48,820 --> 00:22:53,750
!وُجِدَ العالم لخدمة روتزو

413
00:24:25,420 --> 00:24:28,030
"الحلقة القادمة، "صِراع القدّيس والشّيطان