1
00:00:00,500 --> 00:00:04,320
هناك شكوك بسيطة بأنّ هذه الأرض
ستكون في عين العاصفة

2
00:00:05,020 --> 00:00:07,480
النّصير يوم والملِك السّابق إدماريس"

3
00:00:07,740 --> 00:00:10,720
"اختلسا التّعويضات لصالح سيّد الشّيطان ريمورو

4
00:00:11,300 --> 00:00:14,760
أغضبَ هذا الإعلان النّخبة
العليا من مُجتمع فالموث

5
00:00:15,500 --> 00:00:18,160
،هتفَ النّاس مُطالبين بقتل إدماريس

6
00:00:18,460 --> 00:00:21,400
لذا حشدَ الملكُ الجديدُ جيشاً

7
00:00:23,130 --> 00:00:29,000
لكن يوم وإدماريس مُحال أن يقبلا
بإعلان مُزيّف كهذا كحقيقة

8
00:00:29,770 --> 00:00:30,900
،بالإضافة إلى ذلك

9
00:00:30,900 --> 00:00:34,600
التّعزيزات المُرسَلة بواسطة سيّد الشّيطان
ريمورو قد وصلَتْ إلى يوم وإدماريس

10
00:00:35,310 --> 00:00:38,790
كان من الحتميّ أن تندلع حربٌ هنا

11
00:00:40,120 --> 00:00:44,530
أعتقد أنّ سيّد الشّيطان ريمورو لم يتخلّ
عن النّصير يوم في نهاية المطاف

12
00:00:44,530 --> 00:00:46,650
كانت تلك الفكرة ساذجة. ساذجة جدّاً

13
00:00:47,220 --> 00:00:49,880
هناك احتمال جيّد أن تكون الكذبة قد انكشفت

14
00:00:50,690 --> 00:00:53,520
،كنتُ لأتمنّى التخلّص من هيناتا هنا

15
00:00:53,520 --> 00:00:55,760
لكن ربّما حان الوقت لإنهاء الأمر الآن

16
00:00:56,190 --> 00:00:59,920
ليس وكأنّنا فشلنا في تنفيذ أوامرنا

17
00:00:59,920 --> 00:01:01,410
حسنٌ إذاً

18
00:01:02,280 --> 00:01:04,720
المُشكلة الوحيدة الآن هي ما بقي من عملنا

19
00:01:05,120 --> 00:01:08,920
تقصد إخضاع الشّيطان الّذي قتل
رئيس الأساقفة ريهيم؟

20
00:01:08,920 --> 00:01:10,800
الشّيوخ العظماء الخمسة يُثقِلون علينا

21
00:01:12,200 --> 00:01:13,220
دامرادا-ساما؟

22
00:01:13,500 --> 00:01:15,580
تلقّيتُ معلومات غريبة

23
00:01:15,930 --> 00:01:19,760
تزعم بأنّ الماجِن رازين مُوالٍ للشّيطان المذكور

24
00:01:20,970 --> 00:01:24,040
إذا كان هذا الشّيطان قويّاً بما يكفي
،لهزيمة رازين

25
00:01:24,040 --> 00:01:26,400
فهو أعلى من شيطان رئيسيّ

26
00:01:27,000 --> 00:01:31,070
،هل تمّ إحياء شيطان أقدم حتّى
شيطان من فئة كارثة؟

27
00:01:31,810 --> 00:01:33,040
لا نملك خياراً

28
00:01:33,040 --> 00:01:36,160
سنترك مُراقِباً ونغادر فالموث

29
00:01:36,160 --> 00:01:36,910
حاضرة

30
00:01:37,210 --> 00:01:41,030
وماذا سنفعل بشأن صيّادي الشّياطين
الّذين أرسلهم بلدنا؟

31
00:01:41,360 --> 00:01:43,910
اتركيهم كهدايا للملِك الجديد

32
00:01:44,090 --> 00:01:47,680
بصيغة أخرى، ندع التّعامل
مع الشّيطان لإدوارد؟

33
00:01:48,000 --> 00:01:49,280
عُلِم

34
00:01:56,770 --> 00:02:01,750
أعتقد سأرتّب هديّة أخرى للملِك الجديد

35
00:03:37,950 --> 00:03:42,990
تساءلتُ ماذا سيحدث بعد أن يصطفّ
سيّد الشّيطان ريمورو مع يوم

36
00:03:43,080 --> 00:03:46,310
بوجود حُكماء القتال الثّلاثة من الحصون
،الإمبراطوريّة من لوبيليوس

37
00:03:46,310 --> 00:03:50,500
أولئك الأبطال العُظماء، القوّة الثّانية
...بعد القدّيسة هيناتا، في صفّنا

38
00:03:50,500 --> 00:03:54,680
وسمعتُ أيضاً بأنّ هيناتا قد انطلقَتْ
لقتل سيّد الشّيطان ريمورو

39
00:03:54,680 --> 00:03:57,500
!يبدو أنّ السّماء لم تتخلّ عنّي

40
00:03:58,050 --> 00:04:02,290
المُشكلة المُتبقّية الوحيدة كانت
،تبريرنا لغزو إقليم نيدول

41
00:04:02,840 --> 00:04:06,110
لكن بطلب التّعزيزات هذا من الكونت نيدول

42
00:04:06,110 --> 00:04:09,660
...الّذي قدّمَه لي تُجّار الشّرق

43
00:04:09,660 --> 00:04:16,190
بالإضافة إلى ذلك، جمعَ فريقاً مُختصّاً
!في مُقاتلة الشّياطين لأجلي

44
00:04:16,820 --> 00:04:19,650
!تمّ تبديد كافّة همومي

45
00:04:20,480 --> 00:04:23,430
نُعلِن هاهنا عن شنّ هجوم
!استباقيّ على العدوّ

46
00:04:23,430 --> 00:04:26,720
!هدفنا: الخائن يوم في إقليم نيدول

47
00:04:27,240 --> 00:04:28,160
!غاستون

48
00:04:28,350 --> 00:04:29,120
حاضر؟

49
00:04:29,120 --> 00:04:33,790
ستقود فريقاً مُتقدِّماً من 5000 في هجوم
!على البلدة الّتي يتقوقع فيها يوم

50
00:04:33,790 --> 00:04:35,290
!حـ-حاضر

51
00:04:35,640 --> 00:04:38,910
سأرسِل يدي اليُمنى غريغوري معه

52
00:04:38,910 --> 00:04:43,370
مملكة فالموث قد خسرت الكثير من الرّجال
في المعركة ضدّ سيّد الشّيطان ريمورو

53
00:04:43,600 --> 00:04:46,080
أنا متأكّد بأنّه سيكون نافعاً لقوّاتك

54
00:04:46,080 --> 00:04:48,720
!هذا مُطمئن جدّاً

55
00:04:48,720 --> 00:04:51,660
!أشكرك جزيل الشّكر يا سيّد ساري

56
00:04:53,520 --> 00:04:57,560
ساري. أتريدني أن أرعى هؤلاء الحمقى؟

57
00:04:57,560 --> 00:04:59,440
إنّها مجرّد واجهة بالطّبع

58
00:04:59,440 --> 00:05:02,390
فريستُك هي الشّيطان الّذي قتلَ ريهيم

59
00:05:02,390 --> 00:05:03,110
ماذا؟

60
00:05:03,310 --> 00:05:06,570
تُفيد الإشاعة بأنّه مع يوم كجزء من تعزيزاته

61
00:05:06,880 --> 00:05:08,580
ستذهب إلى هناك وتستدرجه للخروج

62
00:05:08,920 --> 00:05:11,640
لكن إذا تبيّن بأنّنا مُخطئون، عُد فوراً

63
00:05:12,650 --> 00:05:14,750
!فهمت! سأفعل ذلك

64
00:05:28,590 --> 00:05:31,130
إذاً دامرادا قد هرب؟

65
00:05:32,140 --> 00:05:35,090
وصيّادو الشّياطين هؤلاء دُفِعَ لهم؟

66
00:05:35,640 --> 00:05:38,850
حسناً، أعتقد بأنّهم سيُشكِّلون
بيادقَ قُربانيّة جيّدة

67
00:05:45,870 --> 00:05:51,200
سأدعكم تندمون على إذلالي أمام ريمورو-ساما

68
00:05:51,200 --> 00:05:54,360
،إذا انتُزِعَ منّي أي عمل

69
00:05:54,360 --> 00:05:57,680
وقال لي ريمورو-ساما، "يمكنك
..."العودة إلى المنزل

70
00:05:58,160 --> 00:06:00,420
فمُجرّد التّفكير في الأمر يجعلني أرتجف

71
00:06:01,560 --> 00:06:06,680
سأحرص على أن تدفعوا ثمناً باهظاً لأنّكم
دببتُم رُعباً كهذا في قلبي

72
00:06:10,900 --> 00:06:14,130
...ها هُم. الملِك الجديد إدوارد و

73
00:06:14,130 --> 00:06:17,800
يجلس مع بعض الشّخصيّات الهامّة

74
00:06:19,790 --> 00:06:22,050
القدّيسون العظماء العشرة"، صحيح؟"

75
00:06:23,280 --> 00:06:24,400
هاكورو

76
00:06:24,590 --> 00:06:28,370
شخصيّة هامّة جدّاً مُتوجِّهة صوبك

77
00:06:28,370 --> 00:06:31,410
ينبغي لهذا أن يكون مثاليّاً لتخفيف ضجر رانغا

78
00:06:31,700 --> 00:06:34,870
فهمت. لا ينبغي أن أقتلهم إذاً؟

79
00:06:34,870 --> 00:06:35,790
صحيح

80
00:06:36,060 --> 00:06:39,300
أعتقد بأنّه مُرتبط بلوبيليوس، مصدر الإشاعات

81
00:06:39,300 --> 00:06:42,210
أعتقد ينبغي أن نقبض عليه
ونستخدمه كورقة مُساومة

82
00:06:42,510 --> 00:06:44,900
عُلِم. سأنقل هذه الرّسالة

83
00:06:45,210 --> 00:06:49,280
وأيضاً، يقود جيشاً قوامه 5000

84
00:06:49,280 --> 00:06:52,800
ممتاز. سأرسل غوبتا وغابيرو خلفهم

85
00:06:53,640 --> 00:06:57,500
أنا مستعدّ، لذا يمكنك أن تفعل ما تراه مُناسباً

86
00:06:57,840 --> 00:06:59,960
حاول فقط ألّا تُبالغ كثيراً

87
00:07:00,390 --> 00:07:01,910
بالطّبع

88
00:07:10,680 --> 00:07:12,680
سُرِرتُ بلقائكم جميعاً

89
00:07:12,680 --> 00:07:15,160
اسمي ديابلو

90
00:07:15,160 --> 00:07:19,080
الملِك إدوارد، لم نلتقِ منذ مُعاهدة
السّلام، أليس كذلك؟

91
00:07:19,220 --> 00:07:20,560
!حالة تأهُّب

92
00:07:20,560 --> 00:07:22,210
!احموا الملِك إدوارد

93
00:07:22,430 --> 00:07:23,760
...أليس هذا

94
00:07:23,760 --> 00:07:24,840
!هجوم من العدوّ؟

95
00:07:26,220 --> 00:07:29,510
صحفيّون من دُول أخرى؟

96
00:07:30,960 --> 00:07:34,050
لا أرغب في أذيّة أحد منكم

97
00:07:34,050 --> 00:07:36,470
ابقوا مكانكم وراقبوا بهدوء

98
00:07:36,470 --> 00:07:38,000
آسف يا غريغوري

99
00:07:38,000 --> 00:07:40,600
انتهى المطاف بمجيء فريستك إلى هنا

100
00:07:40,600 --> 00:07:43,960
حسناً، حسناً! مبعوث سيّد الشّيطان
!ريمورو قد جاء

101
00:07:43,960 --> 00:07:46,730
ما الّذي تريدونه اليوم؟

102
00:07:48,320 --> 00:07:50,400
توجيه تحذير فقط

103
00:07:50,400 --> 00:07:54,160
اسحب قوّاتك حالاً وتصالح مع يوم

104
00:07:54,650 --> 00:07:59,200
افعل ذلك وستُعفَى من رُعب لا ضرورة له

105
00:08:01,080 --> 00:08:03,350
!يا له من كلام طريف

106
00:08:03,350 --> 00:08:08,500
هذه مُشكلة مملكتي. لا يجوز
لشيطان أن يتدخّل

107
00:08:08,500 --> 00:08:11,010
لقد تمّ خِداعي

108
00:08:11,550 --> 00:08:13,010
بواسطة مَن؟

109
00:08:13,010 --> 00:08:14,040
!وقِح

110
00:08:14,040 --> 00:08:18,010
تآمرتُم مع أخي... بل مع إدماريس
ورجاله المحتالين

111
00:08:18,010 --> 00:08:21,840
لسرقة ضعفَي مقدار التّعويضات، أليس كذلك؟

112
00:08:21,840 --> 00:08:24,730
!كشفتُ كلّ مخطّطاتكم الصّفيقة

113
00:08:26,240 --> 00:08:27,960
هل انعقد لِسانُك؟

114
00:08:27,960 --> 00:08:31,930
،صحيح أنّه يُدعى سيّد شيطان الآن
لكن أعرف كلّ شيء عن ريمورو هذا

115
00:08:31,930 --> 00:08:35,740
إنّه مُخطِّط مُتعطِّش للمال يحاول
!حصد بذور الحرب في كلّ مكان

116
00:08:37,990 --> 00:08:40,080
لكن لسوء حظّك

117
00:08:40,080 --> 00:08:42,830
،من الواضح بأنّك قتلت ريهيم لإسكاته

118
00:08:42,830 --> 00:08:46,380
!لكن سجّلتُ كلّ أفعالكم الشرّيرة هنا

119
00:08:49,610 --> 00:08:51,910
!لم أنوِ خيانتك أبداً

120
00:08:51,910 --> 00:08:54,830
!أرجوك... أرجوك سامحني

121
00:08:56,570 --> 00:08:59,640
وما الّذي يُثبته هذا بالضّبط؟

122
00:08:59,960 --> 00:09:01,460
ألا تفهم؟

123
00:09:01,460 --> 00:09:05,600
تلك الآنسة هناك، غليندا، هي
من أحضرَتْ لي هذا

124
00:09:06,040 --> 00:09:10,780
تسلّلتُم إلى داخل لوبيليوس وقتلتُم ريهيم، صحيح؟

125
00:09:10,780 --> 00:09:13,590
أنا واثقٌ بأنّكم شعرتُم بطمأنينة
،بعد تهديده

126
00:09:13,590 --> 00:09:17,950
لكن إيمانه كان أقوى من أيّ خوف
!زرعتموه في صدرِه

127
00:09:20,450 --> 00:09:22,330
أوليس هذا رائعاً؟

128
00:09:22,330 --> 00:09:26,450
مُجرّد بشريّ تمكّن من قمع خوفه منّي؟

129
00:09:26,450 --> 00:09:28,880
يا لها من نكتة مُسلّية

130
00:09:28,880 --> 00:09:30,250
!لا تدّعِ الحماقة

131
00:09:30,250 --> 00:09:32,410
!لديّ دليلٌ لا يقبل الجدل هنا

132
00:09:32,410 --> 00:09:33,090
—لا يمكنكم الإفلات

133
00:09:33,230 --> 00:09:35,340
يكفي. اصمُت

134
00:09:36,060 --> 00:09:37,590
سئمتُ من هذه المهزلة

135
00:09:37,590 --> 00:09:41,480
لا متعة في معركة ذكاء مع شخص
يفتقر للذّكاء مثلك

136
00:09:42,550 --> 00:09:46,740
حسناً. سوف أختبرك

137
00:09:46,740 --> 00:09:51,040
دعنا نرى فيما إذا كان يستطيع بشريّ
حقّاً أن يقمع خوفه منّي

138
00:09:51,340 --> 00:09:53,530
!عـ-عمّاذا تتحدّث؟

139
00:09:53,530 --> 00:09:58,340
إذا كان يوجد شخص واحد هنا يستطيع
،قمع خوفه منّي

140
00:09:58,340 --> 00:10:00,440
فسوف أعترف بالهزيمة

141
00:10:01,280 --> 00:10:03,770
:لكن دعوني أحذّركم

142
00:10:03,770 --> 00:10:07,760
لم أذق الهزيمة في حياتي كلّها

143
00:10:08,090 --> 00:10:12,220
استعدّوا لمواجهة عواقب إهانة ريمورو-ساما

144
00:10:13,880 --> 00:10:17,380
!افعلوها! اقتلوه يا صيّادو الشّياطين

145
00:10:18,390 --> 00:10:21,430
!قمع الخوف؟ كم هذا مُضحِك

146
00:10:21,430 --> 00:10:24,840
!نُجيد التّعامل جيّداً مع الشّياطين الرّئيسيّين

147
00:10:26,990 --> 00:10:30,630
دُرِسَ القتال ضدّ الشّياطين ومُورِس
!حتّى الكمال في الشّرق

148
00:10:30,630 --> 00:10:32,430
!لا تستهِن بالبشر

149
00:10:32,800 --> 00:10:34,680
هل انتهيتُم من تحضيراتكم؟

150
00:10:35,270 --> 00:10:39,070
إذاً من فضلكم أعطوني إشارة
عندما تكونون جاهزين للبدء

151
00:10:39,240 --> 00:10:40,060
ماذا؟

152
00:10:40,060 --> 00:10:42,450
هل تقصد بأنّكم ستسمح لنا بالقبض
عليك دون أن تُقاوم حتّى؟

153
00:10:42,690 --> 00:10:44,650
أجل، بالطّبع أسمح لكم

154
00:10:45,030 --> 00:10:47,950
فأنتم مُقبِلون على بذل مجهود كبير جدّاً

155
00:10:47,950 --> 00:10:49,170
!أيُّها الشّيطان اللّعين

156
00:10:49,170 --> 00:10:52,250
اقضِ وقتك في العالم الآخر وأنت
!تتحسّر على كبريائك

157
00:10:52,250 --> 00:10:53,230
!فلتمُت

158
00:10:53,230 --> 00:10:55,270
!الصّاعقة

159
00:11:00,250 --> 00:11:04,690
ما هو شعورك بعد أن ذقتَ برقاً
!طبيعيّاً خالياً من جُزيئات سحريّة؟

160
00:11:04,690 --> 00:11:08,730
حالما ندمِّر جسدَك المادّي، فسوف
!تكون عاجزاً تماماً

161
00:11:08,730 --> 00:11:12,920
!مُبهِر! إنّهم حقّاً أبطال الشّرق

162
00:11:12,920 --> 00:11:16,230
سأحرص على مُكافأة أولئك التُجّار

163
00:11:16,640 --> 00:11:19,140
سيكون عاجزاً؟

164
00:11:19,140 --> 00:11:21,150
هل سيكون كذلك حقّاً؟

165
00:11:23,550 --> 00:11:26,590
!ضُعفاء! ضُعفاء ببساطة

166
00:11:29,300 --> 00:11:31,580
!لكن حقّقنا إصابة مُباشرة

167
00:11:34,940 --> 00:11:36,550
!كم هذا مُخيِّب

168
00:11:37,360 --> 00:11:39,880
!لماذا لم يفلح البرق عليك؟

169
00:11:40,470 --> 00:11:42,260
لأنّه ضعيفٌ جدّاً

170
00:11:42,260 --> 00:11:46,640
لديّ مُقاومة شديدة للمؤثِّرات الطبيعيّة

171
00:11:46,640 --> 00:11:48,810
!أ-أيّها الوغد

172
00:11:49,270 --> 00:11:52,600
والآن، هل نبدأ الاختبار؟

173
00:12:01,360 --> 00:12:04,150
!ابتعد! توقّف! ابتعد

174
00:12:04,150 --> 00:12:05,570
...ا-النّجدة

175
00:12:05,790 --> 00:12:06,680
ما الّذي يجري؟

176
00:12:06,680 --> 00:12:09,450
لا يبدو أنّ الشّيطان يفعل شيئاً

177
00:12:09,450 --> 00:12:12,720
!ا-اللّعنة! ما هذه الهالة المُرعِبة؟

178
00:12:12,720 --> 00:12:14,010
!عجيب

179
00:12:14,010 --> 00:12:17,360
فقط ثلاثة منكم نجحوا في الاختبار؟

180
00:12:17,570 --> 00:12:18,340
!ماذا؟

181
00:12:18,850 --> 00:12:22,790
...إنّهما من حُكماء القتال! بوجودهما هنا

182
00:12:23,220 --> 00:12:25,660
برأيي، تستحقُّون الإطراء

183
00:12:25,960 --> 00:12:30,310
تحمّلتُم حضور سيّد شيطان، حتّى
ولو كنتُ أقنِّنها

184
00:12:31,330 --> 00:12:33,810
!الحِيَل لن تفلح ضدّنا أيّها الشّيطان

185
00:12:34,290 --> 00:12:35,970
أتقول حيلة؟

186
00:12:35,970 --> 00:12:40,070
وحدهم أولئك الّذين أصبحوا أساسَ سيّد شيطان
!يستطيعون إطلاق هالة سيّد شيطان

187
00:12:40,070 --> 00:12:42,840
بما أنّ التطوّر الأعلى لشيطان هو
،شيطان رئيسيّ فقط

188
00:12:42,840 --> 00:12:45,160
!فلا يمكنهم بلوغ مستوى أساس سيّد شيطان

189
00:12:45,830 --> 00:12:51,230
أعترف بأنّنا نحن الشّياطين نمتلك
سِعة طاقة محدودة فقط

190
00:12:51,880 --> 00:12:55,600
...لكن من الممكن لنا أن نتطوّر أكثر

191
00:12:56,320 --> 00:12:58,840
باستيفاء شروط مُحدّدة

192
00:12:58,840 --> 00:12:59,840
ماذا؟

193
00:12:59,840 --> 00:13:02,440
ألم تسمع أنت وجماعتك

194
00:13:02,890 --> 00:13:05,620
بسيّد الشّيطان المدعو روج؟

195
00:13:07,900 --> 00:13:11,860
وأيضاً كسب الحقّ في أن يصبح الواحد
منّا شيطان بحدّ ذاته بسيط

196
00:13:12,390 --> 00:13:14,620
يحتاج فقط لجمع سِعته القصوى من القوّة

197
00:13:14,620 --> 00:13:17,990
ثمّ العيش أكثر من 2000 عام

198
00:13:17,990 --> 00:13:20,240
هذا لا يتطلّب جهداً كبيراً إطلاقاً

199
00:13:21,120 --> 00:13:26,390
ربّما، بالنّسبة لكم، تلك الّتي تُدعى
بلانك معروفة أكثر؟

200
00:13:26,630 --> 00:13:30,870
شهدتُ على هالتها كسيّد شيطان مؤخّراً

201
00:13:31,050 --> 00:13:33,620
!هل تتحدّث عن ضفّة بُحيرة المصبوغة بالقرمزيّ؟

202
00:13:35,940 --> 00:13:38,170
!هـ-هذا لا يُصدّق

203
00:13:38,170 --> 00:13:43,050
شيطان مُتدنّي الرّتبة مُحال أن يُشير
إلى شياطين رفيعة الرّتبة

204
00:13:43,050 --> 00:13:44,940
!باسم "روج" و "بلانك" بهذه البساطة

205
00:13:45,550 --> 00:13:49,000
...لا بدّ أنّ هذا يعني بأنّه

206
00:13:49,330 --> 00:13:52,360
!لا! مستحيل... مستحيل! غير ممكن

207
00:13:52,360 --> 00:13:55,000
!لا يمكن أن يكون هذا مُمكناً

208
00:13:55,000 --> 00:13:58,400
!لا أستطيع الفوز

209
00:13:59,660 --> 00:14:02,800
!اعفُ عن حياتي! أتوسّل إليك

210
00:14:03,560 --> 00:14:06,890
لكن تمكّنتَ من النّجاح في الاختبار

211
00:14:06,890 --> 00:14:08,680
ينبغي أن تستمتع بهذا

212
00:14:08,680 --> 00:14:12,280
!ا-اعفُ عنّي أرجوك! كنتُ مُجرّد مُقاتل مأجور

213
00:14:12,280 --> 00:14:14,110
!لا تقتلني فحسب! أرجوك

214
00:14:14,620 --> 00:14:16,730
يمكنك التّراجع إذاً

215
00:14:16,730 --> 00:14:18,490
تخلّص من هؤلاء المزعجين

216
00:14:18,490 --> 00:14:19,910
!حـ-حالاً

217
00:14:20,790 --> 00:14:23,710
أنت بارع جدّاً

218
00:14:32,830 --> 00:14:36,930
ما كنتُ لأتوقّع أن تكون مجرّد شيطان
رئيسيّ من فئة كارثة

219
00:14:37,600 --> 00:14:39,870
لن تهربا؟

220
00:14:39,870 --> 00:14:42,480
نهرب؟ أنت مُضحِك

221
00:14:45,730 --> 00:14:47,570
اسمي ساري

222
00:14:47,570 --> 00:14:49,680
،أنا أحد الحصون الإمبراطوريّة الخاصّة بلوبيليوس

223
00:14:49,680 --> 00:14:52,530
القدّيسين العُظماء العشرة، وأحد
حُكماء القتال الثّلاثة

224
00:14:54,080 --> 00:14:57,320
من تكون بالضّبط على أيّ حال؟

225
00:14:57,320 --> 00:14:59,200
اسمي ديابلو

226
00:14:59,200 --> 00:15:03,400
أنا الخادم المُوالي لملِكي ريمورو-ساما

227
00:15:03,400 --> 00:15:06,340
ما زلتَ ترفض الكشف عن هويّتك الحقيقيّة؟

228
00:15:07,650 --> 00:15:10,460
!سأدعك تندم على الاستخفاف بي

229
00:15:11,230 --> 00:15:13,850
!لا تفترِض بأنّني مثل أولئك المدنيّين

230
00:15:13,850 --> 00:15:17,420
من ائتُمِنَ على حماية الإله
!لوميناس مختلِف تماماً

231
00:15:20,940 --> 00:15:24,940
لِمَ ينبغي أن أخاف في الوقت الّذي تتفوّه
!به بأسماء مثل روج وبلانك؟

232
00:15:25,440 --> 00:15:29,390
إن لم تخبرني من تكون، فسوف
!أفضح هويّتك بالمهارة الخالِصة

233
00:15:37,570 --> 00:15:39,520
أتقول هويّتي؟

234
00:15:39,520 --> 00:15:44,410
أعترف بأنّني لستُ شيطاناً رئيسيّاً كما قلت

235
00:15:44,410 --> 00:15:47,110
تطوّرتُ إلى سيّد روح شيطانيّة

236
00:15:47,110 --> 00:15:51,170
الفرق ليس كبيراً، لكن من فضلك
لا تُخطئ بينهما

237
00:15:52,680 --> 00:15:54,480
!سيّد روح شيطانيّة؟

238
00:15:58,640 --> 00:16:00,260
سيّد روح شيطانيّة؟

239
00:16:00,520 --> 00:16:04,230
الكائنات الأسطوريّة الّتي يمكنها أن تتفوّق
!على أسياد شيطان؟

240
00:16:05,100 --> 00:16:07,840
!هذا ما في الأمر إذاً

241
00:16:08,260 --> 00:16:12,040
اللّعنة! ما الّذي يفكّر فيه سيّدُ
!الشّيطان ريمورو بالضّبط؟

242
00:16:12,040 --> 00:16:14,440
!كيف تمكّن من إعطاء كائن كهذا اسماً؟

243
00:16:14,440 --> 00:16:15,970
لِمَ أنت واقف مكانك مذهولاً؟

244
00:16:15,970 --> 00:16:17,420
!يجب أن نقضي عليه يا ساري

245
00:16:17,420 --> 00:16:19,370
—انتظري يا غليندا! إنّه في الواقع

246
00:16:21,380 --> 00:16:23,460
!كلامك أكبر من حجمك

247
00:16:25,610 --> 00:16:29,040
صحيح. نسيتُ ذِكر هذا

248
00:16:29,040 --> 00:16:31,940
الهجمات الجسديّة لا تؤثِّر بي

249
00:16:34,200 --> 00:16:35,470
!لا أملك خياراً الآن

250
00:16:47,510 --> 00:16:50,710
،اللّعنة! هذا سلاحي الفريد
!قاتل الشّياطين

251
00:16:50,710 --> 00:16:52,380
!غليندا، أكسبيني بعض الوقت

252
00:16:52,380 --> 00:16:54,630
—سأستخدم سحراً مُقدّساً كي

253
00:16:54,630 --> 00:16:56,570
غليندا؟

254
00:16:57,560 --> 00:17:00,040
إن كنتَ تقصد صديقتك، فهي هناك

255
00:17:00,040 --> 00:17:00,760
!ماذا؟

256
00:17:01,310 --> 00:17:03,910
!غليندا

257
00:17:03,910 --> 00:17:06,120
!سأفعلها! سوف أفعلها

258
00:17:06,120 --> 00:17:09,000
!سأكسب الوقت حتّى عودة غريغوري

259
00:17:25,940 --> 00:17:27,550
!ما-ما هذا؟

260
00:17:27,550 --> 00:17:29,770
!سيّد غريغوري، ماذا نفعل؟

261
00:17:30,210 --> 00:17:34,480
يبدو أنّنا لا نملك وقتاً للتّفكير بشأن
قتل الشّيطان بعد الآن

262
00:17:40,000 --> 00:17:41,930
!ذ-ذئب يطير؟

263
00:17:41,930 --> 00:17:44,480
!سـ-سيّد غريغوري، ماذا سنفعل؟

264
00:17:44,480 --> 00:17:45,620
!لا أدري

265
00:17:45,620 --> 00:17:46,280
ماذا؟

266
00:17:46,280 --> 00:17:50,500
القائد غاستون، واجه القوّات القادمة هناك

267
00:17:50,720 --> 00:17:53,040
يمكنك رؤيتهم وهم مُتّجهون إلى هنا، صحيح؟

268
00:17:53,850 --> 00:17:55,560
!عُـ-عُلِم

269
00:17:55,560 --> 00:17:57,760
ماذا ستفعل أنت يا سيّد غريغوري؟

270
00:18:00,040 --> 00:18:02,260
!سأواجه هذا

271
00:18:02,400 --> 00:18:06,020
!بايثون، غارشيا، احميا القائد

272
00:18:08,360 --> 00:18:09,370
!اللّعنة

273
00:18:18,600 --> 00:18:20,420
!أيّها الكلب اللّعين

274
00:18:22,580 --> 00:18:26,340
!إنّه قادم! سـ-سيّد غريغوري، ماذا نفعل؟

275
00:18:27,360 --> 00:18:29,330
!راسخ

276
00:18:31,700 --> 00:18:33,960
يعمل رانغا ذاك بصورة فائقة السّرعة

277
00:18:33,960 --> 00:18:37,960
بالفعل. على هذا المُعدّل، لن يبقى
لنا أي شيء نفعله

278
00:18:37,960 --> 00:18:41,300
أخي، كُفّ عن الشّكوى والحق به بسرعة

279
00:18:41,540 --> 00:18:43,400
حسناً، سأسبقكم

280
00:18:43,400 --> 00:18:44,650
!عُلِم

281
00:18:55,190 --> 00:18:55,880
ماذا؟

282
00:18:57,930 --> 00:19:00,170
...سـ-سيّد غريغوري

283
00:19:00,680 --> 00:19:02,210
!مهلاً

284
00:19:02,210 --> 00:19:05,790
عليك أن تتوقّف يا رانغا! إذا استمررت
!على هذا المُعدّل فسيموت

285
00:19:05,790 --> 00:19:07,910
!يا للهول! يجب أن نُعالجه

286
00:19:08,120 --> 00:19:11,710
ماذا؟ لكن ألا يريد أن يلعب أكثر؟

287
00:19:11,710 --> 00:19:14,170
!لا، لا، لا، لا! هذا مُحال

288
00:19:14,170 --> 00:19:15,520
!هذا صحيح

289
00:19:15,520 --> 00:19:18,640
من الأفضل أن تتوقّف وإلّا استشاط
!ريمورو-ساما غضباً

290
00:19:19,350 --> 00:19:20,890
...سيكون ذلك سيّئاً

291
00:19:23,010 --> 00:19:25,680
إذا سحبت قوّاتك الآن، فلن نُطاردكم

292
00:19:25,680 --> 00:19:26,660
ما قرارك؟

293
00:19:28,360 --> 00:19:31,000
!انسحبوا! سوف ننسحب

294
00:19:32,480 --> 00:19:36,310
!لا يمكننا هزيمتهم! لا يوجد أمل

295
00:19:42,000 --> 00:19:45,360
!بسرعة! عُد إلى هنا بسرعة يا غريغوري

296
00:19:49,280 --> 00:19:51,460
!لا أستطيع مواجهة هذا الشّخص بمفردي

297
00:19:53,300 --> 00:19:56,570
!ابذل جهداً أكبر وأرِني حركة أكثر إثارة

298
00:19:56,570 --> 00:19:57,530
!اللّعنة

299
00:20:00,660 --> 00:20:03,680
ضربة جارحة قاضية تضيف سحراً
من أضعف عنصر

300
00:20:03,680 --> 00:20:06,510
...لعدوّك إلى روحك القتاليّة

301
00:20:12,620 --> 00:20:18,750
لكن إذا قرأتُ وفكّكتُ تركيبتها قبل حتّى
...من أن تتمكّن من تفعيل التّعويذة

302
00:20:26,280 --> 00:20:28,340
لن تحدث مُعجزة

303
00:20:29,520 --> 00:20:30,620
!كفى هُراء

304
00:20:37,340 --> 00:20:38,990
لقد فهمت

305
00:20:38,990 --> 00:20:42,660
بوسعه قتلي في أيّ لحظة

306
00:20:42,660 --> 00:20:44,720
حقيقة أنّه لا يفعل تعني بأنّه
لا ينوي فعل ذلك

307
00:20:45,070 --> 00:20:47,910
وحش أقوى حتّى من سيّد الشّيطان فالينتاين

308
00:20:47,900 --> 00:20:50,830
لا يملك سبباً لقتل ريهيم

309
00:20:50,830 --> 00:20:53,420
ما يعني بأنّ هذا الشّيطان ليس
!القاتل الحقيقيّ

310
00:20:54,440 --> 00:20:59,710
فهمت. لم تُرِدنا هيناتا المُشاركة
،في هذا كلّه

311
00:21:02,830 --> 00:21:04,110
...ما يعني

312
00:21:05,800 --> 00:21:07,980
...قاتل ريهيم كان

313
00:21:07,980 --> 00:21:10,990
ساري. أتينا لتشجيعك

314
00:21:11,130 --> 00:21:14,870
كُن مُمتنّاً. لنُدمِّر هذا الشّيطان معاً

315
00:21:16,720 --> 00:21:19,230
!ر-رجال دين الأيّام السّبعة

316
00:21:20,040 --> 00:21:22,120
...ماذا؟ إذاً هؤلاء

317
00:21:22,530 --> 00:21:26,730
ثبّته مكانه. سوف نقضي عليه بسحرنا

318
00:21:27,850 --> 00:21:28,870
...ماذا

319
00:21:28,870 --> 00:21:31,350
دفن الدّليل؟

320
00:21:34,100 --> 00:21:37,040
!تبّاً! اهربوا

321
00:21:52,080 --> 00:21:53,670
!هل أنتِ بخير؟

322
00:22:05,170 --> 00:22:07,140
!الجرعة الكاملة لا تنجح

323
00:22:07,520 --> 00:22:08,260
إجابة

324
00:22:08,260 --> 00:22:10,140
هذه الشّخصيّة الّتي تُدعى هيناتا ساكاغوتشي

325
00:22:10,140 --> 00:22:13,040
يبدو أنّ لديها مُقاومة عالية للسّحر

326
00:22:13,270 --> 00:22:16,770
إنّها تُفكِّك جُزيئات الجرعة السّحريّة
تلقائيّاً لإبطال تأثيرها

327
00:22:16,990 --> 00:22:20,940
لـ-لا ينجح على هيناتا-ساما إلّا السّحر المُقدّس

328
00:22:20,940 --> 00:22:23,190
!ماذا؟! إذاً لا تقف مكانك فحسب

329
00:22:23,190 --> 00:22:24,920
!أطلِق شيئاً ناجعاً ما! على الفور

330
00:22:25,190 --> 00:22:26,780
!ريتوس! سحر الشّفاء

331
00:22:26,780 --> 00:22:28,000
!حـ-حاضرة

332
00:22:34,110 --> 00:22:38,080
سيّد الشّيطان ريمورو. سُرِرتُ بالتعرُّف عليك

333
00:22:38,480 --> 00:22:41,900
نُعرَف برجال دين الأيّام السّبعة

334
00:22:44,730 --> 00:22:51,760
أتينا للقضاء على هيناتا ساكاغوتشي
لانتهاكها القوانين

335
00:24:25,440 --> 00:24:27,840
"الحلقة القادمة، "إله وسيّد شيطان