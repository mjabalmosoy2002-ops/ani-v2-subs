1
00:00:02,160 --> 00:00:04,480
أنت بغيض حقّاً، أتعلم ذلك؟

2
00:00:05,250 --> 00:00:07,960
كدتَ تقتلني كذلك

3
00:00:08,320 --> 00:00:09,690
اعذرني

4
00:00:10,020 --> 00:00:13,740
سمعتُ بأنّك هربت قبل أن يطالك ذلك

5
00:00:13,740 --> 00:00:15,880
وهل كان لديّ خيار آخر؟

6
00:00:15,880 --> 00:00:18,370
تلقّيت التّقرير، أليس كذلك؟

7
00:00:18,910 --> 00:00:23,050
كان ذلك الشّيطان أقوى بكثير ممّا توقّعت

8
00:00:23,690 --> 00:00:24,750
...الأهمّ

9
00:00:25,200 --> 00:00:27,560
،لم تفشل في القضاء على هيناتا فحسب

10
00:00:27,560 --> 00:00:32,380
بل يبدو أنّك عزّزت روابطها
بسيّد الشّيطان ريمورو

11
00:00:32,830 --> 00:00:34,930
أعتقد لا يمكنني نكران ذلك

12
00:00:35,500 --> 00:00:37,960
،ستسقط دولة فالموث التّاريخيّة

13
00:00:37,960 --> 00:00:40,260
وستُولَد دولة جديدة

14
00:00:40,610 --> 00:00:44,260
،هذا يتماشى مع خطط سيّد الشّيطان ريمورو

15
00:00:44,260 --> 00:00:46,770
ويجعل مخطّطاتكم مضيعة للوقت

16
00:00:47,560 --> 00:00:52,560
يسعى سيّد الشّيطان ريمورو لجعل
غابة جورا العظيمة محوراً اقتصاديّاً

17
00:00:53,150 --> 00:00:55,780
هذا احتمال لا نقبله قطعيّاً

18
00:00:57,150 --> 00:00:59,830
سيكون من غير الحكمة التصرُّف
على الملأ الآن

19
00:00:59,830 --> 00:01:02,920
ألا ينطبق هذا على جماعتك كذلك؟

20
00:01:05,020 --> 00:01:09,800
لا جدوى من تحميل بعضنا الآخر لوم الفشل

21
00:01:10,120 --> 00:01:12,360
يسرّني أنّك سريع الاستيعاب

22
00:01:12,360 --> 00:01:16,610
لنتعاون معاً لإيقاف ولادة ميدان
اقتصاديّ جديد في هذه البلاد

23
00:01:16,610 --> 00:01:18,220
مهلاً، انتظر لحظة فحسب

24
00:01:19,300 --> 00:01:23,080
رغبتي في الحِفاظ على علاقة
،ودّية هي رغبة حقيقيّة

25
00:01:23,080 --> 00:01:28,060
لكن شعبي، على الأقلّ، لا سبب يدفعه
لمُعاداة سيّد الشّيطان ريمورو

26
00:01:28,330 --> 00:01:29,460
...أنت

27
00:01:31,250 --> 00:01:34,240
،وعلى أيّ حال، الآن بعد أن عَلِمَتْ هيناتا بأمري

28
00:01:34,240 --> 00:01:37,070
سيكون من العسير عليّ فعل شيء
في الأقاليم الغربيّة

29
00:01:37,290 --> 00:01:40,830
سأعود إلى موطني وأرسل شخصاً
آخر بالنّيابة عنّي

30
00:01:43,320 --> 00:01:45,200
يبقى اتّفاقنا بلا تغيير

31
00:01:46,890 --> 00:01:49,960
سأجعل هذه المسألة برمّتها شيئاً من الماضي

32
00:01:50,360 --> 00:01:51,720
عظيم

33
00:01:51,720 --> 00:01:54,630
المهمّ ألّا تعترِضوا طريقنا

34
00:01:55,040 --> 00:01:56,830
بكلِّ تأكيد

35
00:02:01,520 --> 00:02:05,270
هذا القمامة. كيف يجرؤ على استغلالي؟

36
00:02:06,210 --> 00:02:10,350
حالما ينتهي كلّ هذا، سيحين دوركم جميعاً

37
00:03:44,620 --> 00:03:46,520
لوي، إمبراطور لوبيليوس المُنعزِل

38
00:03:47,240 --> 00:03:50,630
،كان سيّد الشّيطان فالينتاين أخاه الأصغر، روي

39
00:03:50,630 --> 00:03:53,710
والّذي قُتِلَ بواسطة لابلاس
من حلف المهرّجين المعتدل

40
00:03:55,450 --> 00:03:58,000
اعتذرت هيناتا من الصّليبيّين لأنّها لم تخبرهم

41
00:03:58,320 --> 00:04:00,420
عن حقيقة لوميناس

42
00:04:00,720 --> 00:04:03,000
!نؤمن بكِ يا هيناتا-ساما

43
00:04:03,000 --> 00:04:07,110
!أجل! نتبعكِ أنتِ، لا الإلهة لوميناس

44
00:04:08,530 --> 00:04:11,440
فهمت... حسناً إذاً

45
00:04:11,980 --> 00:04:17,650
والآن سنجري جلسة نقاش حول
مستقبل تيمبيست ولوبيليوس

46
00:04:18,070 --> 00:04:22,280
الكنيسة المُقدّسة الغربيّة لا تستطيع
الاعتراف بدولة وحوش

47
00:04:22,780 --> 00:04:26,530
،لذا تقدّم رئيس الأساقفة ريهيم باقتراح

48
00:04:26,530 --> 00:04:28,920
لهذا السّبب وافقتُ عى تعبئة فُرسان المعبد

49
00:04:29,720 --> 00:04:33,410
لم أستطع الاعتراف بكم شخصيّاً أيضاً

50
00:04:33,840 --> 00:04:36,010
هل تقصدين بسبب شيزو-سان؟

51
00:04:36,010 --> 00:04:36,710
أجل

52
00:04:37,030 --> 00:04:40,430
رغم أنّه بتذكُّر الماضي، يبدو
أنّني استُغلِلتُ أيضاً

53
00:04:41,010 --> 00:04:44,170
استُغلِلتِ؟ بواسطة من؟

54
00:04:44,950 --> 00:04:47,180
تُجّار الإمبراطوريّة الشّرقيّة

55
00:04:47,800 --> 00:04:51,900
كان هناك تُجّار زاروا سيّد الشّيطان
كلايمان بشكل متكرّر أيضاً

56
00:04:51,900 --> 00:04:54,440
كانوا التُجَّار الشّرقيّين إذاً

57
00:04:54,760 --> 00:04:55,530
أجل

58
00:04:55,800 --> 00:04:59,940
...أخبروني بأنّك قتلتَ شيزو-سان

59
00:05:00,440 --> 00:05:04,450
وبأنّك تُقيم في مملكة إنغراشيا في ذلك الوقت

60
00:05:09,970 --> 00:05:12,600
مُجرّد تذكّره يُغيظني

61
00:05:17,380 --> 00:05:20,340
كُفّ عن مُحاولة ترهيبنا أيّها المبتدئ الصّاعد

62
00:05:20,420 --> 00:05:22,630
آ-آسف

63
00:05:25,450 --> 00:05:29,510
على أيّ حال، أعتقد من الآمن القول بأنّ أولئك
التُجَّار الشّرقيّين هُم من دبّروا كلّ هذا

64
00:05:29,970 --> 00:05:33,270
كانوا غالباً الأشخاص الّذين حرّضوا إدماريس أيضاً

65
00:05:33,690 --> 00:05:35,070
لا شكّ في ذلك

66
00:05:35,520 --> 00:05:39,020
تحقيقنا مع ريهيم وضّح ذلك

67
00:05:39,280 --> 00:05:43,290
كان سيّد الشّيطان كلايمان يتحكّم
بمملكة فالموث من خلف الكواليس

68
00:05:44,010 --> 00:05:47,240
وكان الوسيط هم تُجّار الشّرق؟

69
00:05:47,400 --> 00:05:48,170
أجل

70
00:05:48,530 --> 00:05:52,040
كان كلايمان يحاول أن يصحو
كسيّد شيطان حقيقيّ

71
00:05:52,040 --> 00:05:55,400
كانت مملكة فالموث تحاول
السّيطرة على هذه الدّولة

72
00:05:56,160 --> 00:05:58,830
ولَعِبَ التُجَّار الشّرقيّون دور الوسيط

73
00:05:59,440 --> 00:06:03,650
وكان هناك شخص يتحكّم بالأمور في الظِّلال

74
00:06:04,230 --> 00:06:08,590
تقصد الشّخص الّذي تحدّث عنه كلايمان

75
00:06:08,590 --> 00:06:11,430
لـ-لكن استخدمتُ حجر التحكُّم
!بالعقول الّذي أعطاني إيّاه

76
00:06:11,430 --> 00:06:14,430
!كـ-كان ينبغي أن تقع تحت سيطرة قوّتي تماماً

77
00:06:14,770 --> 00:06:17,920
كان من المُبهِر أن يتمكّن ضعيفٌ مثله

78
00:06:17,920 --> 00:06:21,000
من تجنُّب ذكر اسمه حتّى آخر لحظة

79
00:06:21,440 --> 00:06:23,980
هل يُعقَل أنّه كان يقصد الأيّام السّبعة؟

80
00:06:24,400 --> 00:06:25,670
ماذا؟

81
00:06:25,670 --> 00:06:30,240
هل تلمّح إلى أنَّ الأيّام السّبعة
كانوا يتصرّفون دون علمي؟

82
00:06:30,690 --> 00:06:33,050
لا يمكننا إنكار هذا الاحتمال

83
00:06:33,050 --> 00:06:35,840
لوي، أتتفوّه بهذا الهراء أيضاً؟

84
00:06:35,840 --> 00:06:39,760
تاقوا لنَيل استحسانكِ يا لوميناس-ساما

85
00:06:39,760 --> 00:06:41,380
عمّاذا تتكلّم؟

86
00:06:41,600 --> 00:06:44,570
استحسانكِ، بصيغة أخرى، طاقة حبّكِ

87
00:06:44,570 --> 00:06:47,130
مضى أكثر من قرن منذ إقامة الطُّقوس السّابقة

88
00:06:47,400 --> 00:06:49,630
!طاقة الحبّ؟! ما هي هذه بالضّبط؟

89
00:06:49,890 --> 00:06:52,490
كانوا في الأصل بشراً

90
00:06:52,860 --> 00:06:56,890
أعتقد أنّه من المحتوم أن يشيخوا
إذا لم أمنحهم الطّاقة

91
00:06:57,180 --> 00:07:01,690
كانوا مستميتين لمنعكِ من تفضيل المزيد

92
00:07:02,210 --> 00:07:06,110
أتقصد بأنَّ الأيّام السّبعة حاولوا
قتلي بسبب ذلك؟

93
00:07:06,580 --> 00:07:07,800
هذا ما أخشاه

94
00:07:07,840 --> 00:07:11,990
أرادوا غالباً أن يصحو كلايمان
ثمّ إرساله لمقاتلتكِ

95
00:07:12,240 --> 00:07:16,910
وعندما مات كلايمان، وضعوا ريمورو
في وجهي للتخلُّص منّي؟

96
00:07:17,200 --> 00:07:19,410
هل أنت متأكّد من ذلك؟

97
00:07:19,800 --> 00:07:24,290
كان رجال دين الأيّام السّبعة من عرّفونا
على التُجّار الشّرقيّين

98
00:07:24,650 --> 00:07:28,600
..."مهلاً... إذا كانوا يُدعَون بـ"الأيّام السّبعة

99
00:07:29,180 --> 00:07:31,090
فهناك شخص آخر في مكانٍ ما؟

100
00:07:31,440 --> 00:07:33,250
هذه ليست بمُشكلة

101
00:07:33,250 --> 00:07:35,450
كاردينال من موطني أبلغني مؤخّراً بأنّ

102
00:07:35,450 --> 00:07:39,600
الأخير، غران كاهن الأحد، قد قُتِل

103
00:07:39,850 --> 00:07:41,600
كاردينال؟

104
00:07:41,600 --> 00:07:45,230
تقصدين نيكولاوس، الّذي كان مُعجباً جدّاً بكِ؟

105
00:07:45,540 --> 00:07:49,110
كيف تمكّن من هزيمة غرانفيل؟

106
00:07:49,110 --> 00:07:51,950
لستُ أدري ما إن كان يستحقّ
الأمر الإطراء

107
00:07:52,260 --> 00:07:55,620
باغتَه بواسطة تفكيك مُفعَّل

108
00:07:56,280 --> 00:07:58,830
شاخَ غرانفيل حقّاً

109
00:07:58,830 --> 00:08:01,040
عجيب أن يقع في فخٍّ كهذا

110
00:08:01,520 --> 00:08:05,670
عندما تقولين "غرانفيل"، فهل تقصدين
غران، كاهن الأحد؟

111
00:08:06,010 --> 00:08:07,920
إنّه اسمه الحقيقيّ

112
00:08:07,920 --> 00:08:13,180
بما أنّه كان بطل الضَوء، تقاتلتُ وإيّاه في السّابق

113
00:08:13,590 --> 00:08:17,620
لكن القدر دائماً ما ينعكس ضدّ أولئك
الّذين يزعمون بأنّهم أبطال

114
00:08:18,270 --> 00:08:23,790
ربّما في أعماقه، يضمر ضغينة
تجاهي لذلك السّبب

115
00:08:24,870 --> 00:08:27,560
على أيّ حال، أعتقد يمكننا أن نتمتّع
براحة الذّهن في الوقت الحالي

116
00:08:28,900 --> 00:08:31,920
لو لم نعلم بأنّ أولئك التُجَّار كانوا
،يتحكّمون بزِمام الأمور في الظِّلال

117
00:08:31,920 --> 00:08:35,610
لشككتُ بيوكي كعقل مُدبِّر

118
00:08:36,130 --> 00:08:39,870
يوكي؟ تقصد الأستاذ الكبير
يوكي كاغورازاكا؟

119
00:08:40,080 --> 00:08:44,070
،أجل. إذا وضعنا كلّ الأمور بعين الاعتبار
،بدا أنّه الأكثر شبهة

120
00:08:44,070 --> 00:08:47,000
لكن ليس لديه أيّ سبب يجعلنا
أنا وهيناتا نتقاتل

121
00:08:47,480 --> 00:08:49,620
يوكي كعقلٍ مُدبِّر؟

122
00:08:50,150 --> 00:08:52,460
لا يمكنني أن أجزم بأنّه ليس هو

123
00:08:53,070 --> 00:08:55,640
لحظة، أتُشكِّكين بشخص أتى
من نفس عالمنا؟

124
00:08:55,890 --> 00:08:59,850
أنا أضع كافّة الاحتمالات بعين الاعتبار فحسب

125
00:09:00,560 --> 00:09:05,270
وأيضاً، أعتقد من المُبكِّر الافتراض
بأنّ العقل المُدبِّر قد انهزم

126
00:09:05,880 --> 00:09:08,900
معكِ حقّ. لا يمكننا أن نتفاءل كثيراً

127
00:09:09,110 --> 00:09:11,470
ينبغي أن نُبلِغ الآخرين

128
00:09:11,470 --> 00:09:12,380
أجل

129
00:09:12,380 --> 00:09:16,080
يجدر بنا أن نبقى متأهِّبين ما دامت
هذه الفوضى مُستمرّة

130
00:09:17,540 --> 00:09:20,770
طعام اليوم الخفيف هو قُرَيصة وبطاطا مقليّة

131
00:09:20,770 --> 00:09:21,830
استمتعوا

132
00:09:24,960 --> 00:09:28,170
...والآن مع توطيد العلاقة بين بلدينا

133
00:09:28,830 --> 00:09:32,000
ثمّة أمر أريد أن أتحقّق منه أوّلاً

134
00:09:32,330 --> 00:09:36,170
قبلت اعتذارنا بشأن هذه المسألة، صحيح؟

135
00:09:36,490 --> 00:09:37,310
أجل

136
00:09:37,610 --> 00:09:41,050
لا ينوي شعبُنا إطالة أمد هذه الحرب

137
00:09:41,210 --> 00:09:42,310
هذا لا يفي بالغرض

138
00:09:42,310 --> 00:09:45,070
جزء من اللّوم في هذه المسألة
يقع على عاتقنا بشكلٍ واضح

139
00:09:45,070 --> 00:09:47,700
سنبحث عن طريقة للتّعويض لكم

140
00:09:47,700 --> 00:09:49,440
ثمّ ستتليها المُصالحة

141
00:09:51,370 --> 00:09:55,480
أيضاً لا أستطيع إنهاء هذا وأنا على علم
بالمُشكلة الكبيرة الّتي سبّبتُها

142
00:09:55,830 --> 00:09:57,990
أريد إظهار حسن نيّتي بأي طريقة ممكنة

143
00:09:58,520 --> 00:10:00,320
تعويض؟

144
00:10:00,740 --> 00:10:04,140
ما رأيكِ باعترافكم رسميّاً بنا كدولة

145
00:10:04,140 --> 00:10:05,870
والدّخول في علاقات دبلوماسيّة معنا؟

146
00:10:06,130 --> 00:10:07,120
لا مشكلة لديّ

147
00:10:07,490 --> 00:10:09,440
،لكن لا أنوي أن أكون ودودة

148
00:10:09,440 --> 00:10:13,130
وسأعاقب تلك السّحليّة يوماً ما

149
00:10:13,370 --> 00:10:17,260
في أسوأ الحالات، قد لا يكون
تقديم فيلدورا كهِبة فكرة سيّئة

150
00:10:17,260 --> 00:10:19,000
!انتظر لحظة فحسب يا ريمورو

151
00:10:19,000 --> 00:10:21,760
!كنتَ تفكّر في شيء لئيم للتو، أليس كذلك؟

152
00:10:23,280 --> 00:10:25,600
!أنت تتخيّل فحسب يا فيلدورا-كن

153
00:10:25,600 --> 00:10:28,510
،لا، لحظة! عندما تضيف "كن" إلى اسمي

154
00:10:28,510 --> 00:10:31,230
!فهذا يعني أنّ لديك فكرة شنيعة في ذهنك

155
00:10:31,230 --> 00:10:33,470
!كُفّ عن الصُّراخ! انتبه لنفسك

156
00:10:33,470 --> 00:10:34,730
...هـ-هذه ليست غلطتي

157
00:10:35,200 --> 00:10:38,130
لنعقد هدنة مؤقّتة حاليّاً

158
00:10:38,130 --> 00:10:40,990
سندخل في علاقات دبلوماسيّة خلال مئة عام

159
00:10:41,480 --> 00:10:43,850
اعتبر هذا رمز اعتذار منّي

160
00:10:43,850 --> 00:10:44,950
ماذا؟ حقّاً؟

161
00:10:45,180 --> 00:10:47,490
،كنتُ لأتفهّم الخِلاف المُتبادَل

162
00:10:47,490 --> 00:10:49,610
لكن أتصرّحين بأنّكِ ستؤسّسين علاقات؟

163
00:10:49,610 --> 00:10:52,460
...علاقات دبلوماسيّة؟ لكن سيكون ذلك

164
00:10:52,860 --> 00:10:55,840
!يكفي! هذا قراري

165
00:10:56,360 --> 00:10:57,930
يبدو مناسباً بالنّسبة لي

166
00:10:57,930 --> 00:11:00,720
،لو كان ريمورو كائناً شرّيراً

167
00:11:00,720 --> 00:11:02,950
لكنّا في عداد الموتى بالفعل

168
00:11:03,980 --> 00:11:05,160
معك حقّ

169
00:11:05,160 --> 00:11:07,240
يمكننا الوثوق بريمورو وشعبه

170
00:11:07,520 --> 00:11:09,770
ينبغي أن ننبذ رؤيتنا المُتحيّزة عنه كوحش

171
00:11:10,180 --> 00:11:11,680
أتّفق

172
00:11:12,330 --> 00:11:15,440
كان السيّد سوي رجلاً نبيلاً حقّاً

173
00:11:17,220 --> 00:11:19,170
لكن ثمّة مشكلة

174
00:11:19,170 --> 00:11:21,700
ماذا ينبغي أن نفعل بشأن مذهبنا؟

175
00:11:21,700 --> 00:11:26,330
ستهتزّ الثِّقة بالكنيسة المُقدّسة الغربيّة
إذا سلكنا النّهج الخطأ

176
00:11:26,500 --> 00:11:27,820
كلام عبثيّ

177
00:11:27,820 --> 00:11:30,080
،حتّى لو لم يتمّ الالتزام بالمذهب بصرامة

178
00:11:30,080 --> 00:11:32,420
لا أعتبرها خيانة

179
00:11:32,920 --> 00:11:36,800
إنّه ليس أكثر من مجرّد قاعدة نصّها
القائدُ في ذلك الزّمان على أيّ حال

180
00:11:37,730 --> 00:11:40,340
...ماذا؟ لم أكن مُدرِكة لهذا

181
00:11:40,760 --> 00:11:43,770
،من خلال حمايتنا لشعبِنا البريء

182
00:11:43,770 --> 00:11:46,220
يستطيعون عيش حياة مُبارَكة

183
00:11:47,380 --> 00:11:51,880
أكثر ما يهمّني ليس مذهباً ما، إنّما
الإخلاص بحدِّ ذاته

184
00:11:51,880 --> 00:11:55,230
هذا ما يصوغ عقدنا، وهو القاعدة المُطلَقة

185
00:11:55,820 --> 00:12:00,320
جميعكم قادرون على استخدام سحر
مُقدّس لأنّكم تؤمنون بي، صحيح؟

186
00:12:01,640 --> 00:12:07,360
لكن المُشكلة هي أنّنا عشنا بناء
على ذلك المذهب طوال الوقت

187
00:12:07,920 --> 00:12:10,080
...إذا كان نبذه سهلاً إلى هذه الدّرجة

188
00:12:10,530 --> 00:12:11,960
يجب علينا ذلك

189
00:12:12,260 --> 00:12:16,690
لو تمّ تعبئة مئة صليبيّ، فستعلم
الدُّول الأخرى بالأمر

190
00:12:17,210 --> 00:12:20,990
وشَهِدَ أولئك الصّحفيّون هزيمة
حُكماء القتال الثّلاثة، صحيح؟

191
00:12:21,640 --> 00:12:24,530
إذا اكتشفوا بأنّ هيناتا والصّليبيّين
،قد مُنِيوا بهزيمة كذلك

192
00:12:24,860 --> 00:12:26,850
فستعمُّ الفوضى

193
00:12:27,080 --> 00:12:31,350
إذاً لِمَ لا نقول بأنّ النِّزال بين
هيناتا وبيني انتهى بالتّعادُل؟

194
00:12:31,730 --> 00:12:33,350
لا مانع لديك؟

195
00:12:33,620 --> 00:12:35,060
أبداً، لا مُشكلة على الإطلاق

196
00:12:35,320 --> 00:12:39,460
في الواقع، هناك حالات قليلة سّجلَها التّاريخ

197
00:12:39,460 --> 00:12:42,360
تمكّن فيها بشريٌّ من هزيمة سيّد شيطان

198
00:12:42,440 --> 00:12:44,360
!مـ-معها حقّ

199
00:12:44,360 --> 00:12:46,860
أصبحتَ سيّد شيطان مؤخّراً فحسب

200
00:12:46,860 --> 00:12:49,740
إذا منحت القِوى الأخرى سبباً للاستخفاف
...بك في الوقت الحالي

201
00:12:52,250 --> 00:12:56,680
بينيمارو، هل هناك أي قوّة من الممكن
أن تحاول التدخُّل وعرقلة هذا البلد؟

202
00:12:56,680 --> 00:12:57,670
لا يوجد

203
00:12:58,190 --> 00:13:00,610
،وإذا وُجِدَ أحدٌ طائش كهذا

204
00:13:00,610 --> 00:13:02,610
فسوف أسحقه لأجلك

205
00:13:03,670 --> 00:13:05,240
يا لها من ثِقة

206
00:13:05,790 --> 00:13:08,430
في هذه الحالة، فلا اعتراض لديّ

207
00:13:08,600 --> 00:13:11,810
أقبل باقتراحك بكلِّ سرور

208
00:13:11,810 --> 00:13:13,280
،في نفس الوقت

209
00:13:13,280 --> 00:13:16,940
يمكننا أن نعلن للجميع بأنّ شعب
!هذا البلد ليسوا أشراراً

210
00:13:17,260 --> 00:13:20,380
بالفعل. إنّهم أشخاص طيّبو القلب

211
00:13:20,750 --> 00:13:25,260
جرَتْ جِدالات من قبل حول ما إذا كان
،يمكن اعتبار أنصاف البشر وحوشاً

212
00:13:25,260 --> 00:13:28,950
لكن يبدو أنّ هذا تمييز نشأ
من التّحامل والانحياز

213
00:13:29,580 --> 00:13:31,870
هذا رأيي على الأقلّ

214
00:13:31,870 --> 00:13:35,640
أنصاف البشر العدائيّون تجاه
،البشر مُشكلة فعلاً

215
00:13:35,640 --> 00:13:38,960
لكن برأيي ينبغي للأقزام أن يُعَدّوا
بشراً دونما شكّ

216
00:13:39,380 --> 00:13:41,700
إذاً لِمَ لا نُشرِك الملك غازيل في الأمر

217
00:13:41,700 --> 00:13:44,280
ونلتزم بمئة عام من الصّداقة؟

218
00:13:44,680 --> 00:13:47,460
إذا حصلوا على ضمانة بعدم
،مُهاجمتنا للبشر

219
00:13:47,460 --> 00:13:49,390
فينبغي أن يثِقوا بنا قليلاً على الأقلّ، صحيح؟

220
00:13:49,860 --> 00:13:50,670
صحيح

221
00:13:50,970 --> 00:13:54,160
ووجود الثِّقة سيجعل من الأسهل إقناعهم

222
00:13:54,160 --> 00:13:55,480
،لتسريع توطيد العلاقات

223
00:13:55,910 --> 00:13:58,850
سندع آرنود وباكّوس يبقيان هنا في تيمبيست

224
00:14:00,310 --> 00:14:03,870
حسناً إذاً، سوف نُشيّد كنيسة هنا
لأجل الكنيسة المُقدّسة الغربيّة

225
00:14:08,510 --> 00:14:09,660
...بالمناسبة يا هيناتا

226
00:14:12,950 --> 00:14:14,160
ما هذا؟

227
00:14:17,600 --> 00:14:20,530
مِغوَلكِ، المِغوَل الّذي ابتلعتُه في المرّة السّابقة

228
00:14:20,810 --> 00:14:22,540
أصلحتُه وحسّنتُه

229
00:14:23,120 --> 00:14:25,760
من المؤكّد أنّه أفضل من الاستعمال اليوميّ

230
00:14:25,760 --> 00:14:28,090
لسلاح بدرجة أسطورة كضوء القمر
الّذي أعطيتُكِ إيّاه

231
00:14:28,580 --> 00:14:30,260
شكراً لك يا ريمورو

232
00:14:33,350 --> 00:14:36,640
أعتقد أنّ التصرُّف الدّبلوماسيّ الأنسب
كان مُحاولة إيقافها

233
00:14:37,300 --> 00:14:39,550
تأخّر الوقت بالفعل

234
00:14:39,550 --> 00:14:41,610
ما رأيكِ أن تغادري غداً؟

235
00:14:41,960 --> 00:14:44,110
على ذكرِ ذلك، ماذا لديكم
في قائمة طعام اليوم؟

236
00:14:44,110 --> 00:14:45,930
المعذرة... سوكياكي؟

237
00:14:46,590 --> 00:14:48,900
حسناً، بدا النّبع السّاخن لطيفاً

238
00:14:48,900 --> 00:14:50,730
أتطلّع قُدماً لبعض السوكياكي

239
00:14:51,110 --> 00:14:52,990
ماذا؟ حُسِمَ الأمر؟

240
00:14:53,940 --> 00:14:55,790
...ماذا

241
00:14:59,190 --> 00:15:02,380
كما ترون، الطّبق المُقدَّم في مأدبة
!اليوم هو سوكياكي

242
00:15:04,330 --> 00:15:07,210
!نخب بمناسبة تأسيس علاقات ودّية بيننا

243
00:15:07,210 --> 00:15:09,060
!بصحّتكم

244
00:15:15,660 --> 00:15:19,700
!من الرّائع أن يثمل المرء

245
00:15:20,310 --> 00:15:21,960
...في عشاء الأمس

246
00:15:24,660 --> 00:15:27,570
.عليكِ أن تخفّفي من شرب هذه الأشياء
سيفيد ذلك صحّتكِ

247
00:15:27,740 --> 00:15:28,930
أحمق

248
00:15:28,930 --> 00:15:30,590
حتّى السُّموم لا تؤثِّر بي

249
00:15:30,590 --> 00:15:33,000
لن يتغلّب عليّ مجرّد خمر

250
00:15:34,890 --> 00:15:36,700
في الواقع، كرّستُ قلبي وروحي

251
00:15:36,700 --> 00:15:40,290
في إضعاف إبطال السُّموم الخاصّ بي
وذلك كي أثمل

252
00:15:40,430 --> 00:15:43,480
إ-إبطال السّموم؟ يمكنكِ فعل ذلك؟

253
00:15:43,480 --> 00:15:44,690
بالطّبع

254
00:15:44,690 --> 00:15:46,130
!عـ-علّميني حالاً

255
00:15:46,130 --> 00:15:48,160
!أقصد... علّميني أرجوكِ

256
00:15:56,000 --> 00:15:58,430
لحظة، أرزّ أبيض؟

257
00:15:58,430 --> 00:16:01,100
ألا تعتقد بأنّك تبالغ قليلاً هنا؟

258
00:16:01,100 --> 00:16:04,900
،إذا كان لديكِ اعتراض على ذلك
فأعيدي الأرزّ فحسب

259
00:16:04,900 --> 00:16:07,440
!ليس هذا ما أقصده إطلاقاً

260
00:16:08,080 --> 00:16:12,950
لكن أن أرى طعام عالمنا القديم
...يُعاد صنعه بإتقان هكذا

261
00:16:12,950 --> 00:16:14,950
أنا مغتاظة أكثر من كوني متفاجئة

262
00:16:15,420 --> 00:16:20,040
لا أصدِّق بأنّك بنيت مثل هذا المكان
المُريح للعيش في عامين فقط

263
00:16:20,040 --> 00:16:22,330
هيّا، استمرّي في مديحي

264
00:16:22,540 --> 00:16:23,760
كفاك عبثاً

265
00:16:24,080 --> 00:16:27,590
سمعتُ الإشاعات من يوكي، لكن
تلقّيتُها بنوع من التّشكيك

266
00:16:28,070 --> 00:16:30,290
لا، لم نحقّق ذلك بعد

267
00:16:30,290 --> 00:16:31,990
،توزيع البضاعة بطيء

268
00:16:31,990 --> 00:16:34,340
ولن نتكلّم حتّى عن نقل معلومات

269
00:16:34,690 --> 00:16:36,580
هذه ليست إعادة صنع كافية

270
00:16:36,580 --> 00:16:41,060
أريد وضع حجر الأساس لصنع
أشياء مثل المانغا

271
00:16:41,060 --> 00:16:44,460
إعادة صنع؟ في عالمٍ قاسٍ كهذا؟

272
00:16:44,460 --> 00:16:47,110
عندما يفعل مُعظم النّاس ما بوسعهم
من أجل النّجاة؟

273
00:16:47,110 --> 00:16:50,610
حسماً، سنستأصل خطر الوحوش وما شابه

274
00:16:53,380 --> 00:16:55,730
لا جدوى من إخفاء هذا الأمر، لذا
سأقولها بصراحة

275
00:16:55,730 --> 00:16:59,020
،أخطِّط لتعيين يوم كملِك، وتأسيس دولة جديدة

276
00:16:59,020 --> 00:17:02,540
وأجعلها مؤثِّرة بين الأقاليم الغربيّة

277
00:17:02,880 --> 00:17:05,040
وماذا ستفعل؟

278
00:17:05,040 --> 00:17:09,550
قبل كلّ شيء، سوف أضمن الاعتراف
بنا في المجتمع البشريّ

279
00:17:09,550 --> 00:17:12,550
لكن ما زلتُ في منتصف الطّريق
لتحقيق هذا الهدف

280
00:17:12,550 --> 00:17:16,760
كثير من كِبار الشّخصيّات من مُختلف
،البلدان يعلمون بأمرنا الآن

281
00:17:16,760 --> 00:17:19,980
والتُجَّار والمُغامِرون ينشرون إشاعات عنّا

282
00:17:20,400 --> 00:17:22,260
ثمّ هناك بناء الطّرُقات

283
00:17:22,260 --> 00:17:25,170
نعمل على بِناء طريق تجاريّ مستقرّ وآمن

284
00:17:25,620 --> 00:17:28,150
وأخيراً، نقل المعلومات

285
00:17:28,150 --> 00:17:32,980
بلّورات الاتِّصال لا يمكن استخدامها
إلّا بواسطة أشخاص يُجيدون السّحر

286
00:17:32,980 --> 00:17:36,740
لذا نركِّز على الخيوط الفولاذيّة
!اللّاصقة والفولاذ السّحريّ

287
00:17:36,740 --> 00:17:38,530
...أجرينا تجربة و

288
00:17:38,530 --> 00:17:42,080
نقلَ الخيط الفولاذيّ اللّاصق أفكاري
!بمُعدّل مُبهِر

289
00:17:42,080 --> 00:17:43,580
،بما أنّ للجُزيئات السّحريّة علاقة

290
00:17:43,580 --> 00:17:46,080
سيكون من المُمكن إجراء اتّصالات واضحة

291
00:17:46,600 --> 00:17:48,840
نجحَ الأمر بنفس الطّريقة تقريباً
مع الفولاذ السّحريّ

292
00:17:49,360 --> 00:17:50,750
،إذا استخدمنا هذه

293
00:17:50,750 --> 00:17:55,380
فقد يكون من المُمكن بناء شبكة
!تربط الكثير من البلاد والقرى

294
00:17:57,800 --> 00:17:58,830
ما رأيكم؟

295
00:17:58,830 --> 00:18:01,890
سيكون هذا نافعاً جدّاً عندما يُنجَز بالكامل

296
00:18:02,040 --> 00:18:07,140
مهلاً... إنّ مثل هذه الأشياء تُعَدّ
...في العادة كأسرار دولة

297
00:18:07,230 --> 00:18:08,980
أجل، معكِ حقّ

298
00:18:08,980 --> 00:18:11,400
أظنّني تحمّستُ وأفشيتُ الكثير

299
00:18:11,400 --> 00:18:12,770
لا بدّ أنّه مفعول الخمر

300
00:18:12,920 --> 00:18:13,800
إشعار

301
00:18:13,800 --> 00:18:16,350
إعادة تفعيل إبطال علّة الحالة

302
00:18:16,420 --> 00:18:21,280
أيضاً، الطّلبات بإعاقة هذه المُقاومة
لن تُلبّى ثانية لبعض الوقت

303
00:18:21,280 --> 00:18:22,200
!ماذا؟

304
00:18:23,230 --> 00:18:26,120
...هنا يتوقّف حماسي

305
00:18:26,400 --> 00:18:30,880
،فضلاً عن ذلك، إذا بالغتَ كثيراً
فسوف تُهاجَمون بواسطة الملائكة

306
00:18:31,320 --> 00:18:32,380
الملائكة؟

307
00:18:32,560 --> 00:18:37,010
إنّها كائنات تهاجم مدينة عندما
تتطوّر إلى ما بعد مرحلة معيّنة

308
00:18:37,010 --> 00:18:38,830
تلك الحشرات اللّعينة

309
00:18:38,830 --> 00:18:41,090
،كنتُ لأتمنّى القضاء عليها بنفسي

310
00:18:41,090 --> 00:18:43,760
لكن إذا فعلتُ ذلك، ستنكشف هويّتي

311
00:18:44,110 --> 00:18:48,150
بالطّبع، انكشفَتْ بالفعل للصّليبيّين
بسبب تلك السّحليّة

312
00:18:48,150 --> 00:18:49,270
ليست غلطتي

313
00:18:49,750 --> 00:18:51,150
ملائكة إذاً؟

314
00:18:51,630 --> 00:18:54,760
إذا هاجمونا، فسوف نقاوم فحسب

315
00:18:56,380 --> 00:18:58,520
توقّعتُ أن تقول ذلك

316
00:18:58,520 --> 00:19:01,910
قد نقاتل بجانبكم عندما تفعلون ذلك

317
00:19:02,330 --> 00:19:06,770
ولن أسمح لهم بتدمير مدينتي ثانية

318
00:19:06,770 --> 00:19:09,650
لا الحشرات ولا تلك السّحلية هناك

319
00:19:09,650 --> 00:19:10,520
ليست غلطتي

320
00:19:10,520 --> 00:19:14,710
مهلاً! يمكننا الحديث عن كلّ هذه
!الأمور المُعقّدة لاحقاً

321
00:19:14,710 --> 00:19:18,360
هيناتا-ساما، إن كنتِ لا تُريدين
!قطعة اللّحم هذه، فسآخذها

322
00:19:19,520 --> 00:19:22,800
فريتز، هل لديك وصيّة قبل أن تموت؟

323
00:19:23,260 --> 00:19:27,390
...هـ-هيناتا-ساما، عيناكِ خطيرتان

324
00:19:30,640 --> 00:19:35,300
عقب ذلك، سرعان ما أعلنَتْ إمبراطوريّة
لوبيليوس المُقدّسة باعترافها

325
00:19:35,300 --> 00:19:40,320
بمملكة الأقزام كدولة للبشر
مع احتماليّة أن تصبح حليفة

326
00:19:40,820 --> 00:19:43,280
ثمّ صرّحوا عن تأسيسهم علاقات

327
00:19:43,280 --> 00:19:45,600
،دبلوماسيّة مع اتِّحاد جورا تيمبيست

328
00:19:46,010 --> 00:19:48,480
،ورغم أنّ ذلك كان ضمن وقت مُحدّد

329
00:19:48,480 --> 00:19:51,170
أعلنوا أيضاً عن توقيع ميثاق عدم اعتداء

330
00:19:52,760 --> 00:19:56,920
يمكننا الآن استخدام نافذة مُفاوضاتنا
مع الشّيوخ العظماء الخمسة

331
00:19:57,230 --> 00:19:58,300
صحيح

332
00:19:58,570 --> 00:20:03,680
بوضع ذلك جانباً، لا أصدِّق بأنّ أولئك
الأوغاد فرضوا وحشاً كهذا عليّ

333
00:20:05,220 --> 00:20:06,500
لا بدّ أنّ ذلك كان قاسياً

334
00:20:06,790 --> 00:20:08,080
أجل، كان كذلك

335
00:20:08,900 --> 00:20:10,780
كان اسمه ديابلو، أليس كذلك؟

336
00:20:11,210 --> 00:20:14,290
إنّه شيطان مُرعِب بما يكفي ليُعَدّ
،نظيراً لبلانك

337
00:20:14,290 --> 00:20:15,690
الشّخص الّذي هدّدَ الإمبراطوريّة

338
00:20:16,310 --> 00:20:21,070
بصراحة، سيكون من الغباء مُواجهة
قوّة كهذه بشكل مُباشر

339
00:20:21,410 --> 00:20:24,060
،لن أقول بأنّه لا يُهزَم

340
00:20:24,060 --> 00:20:26,480
لكن كان كيربيروس ليُباد على الأرجح

341
00:20:26,910 --> 00:20:30,030
،استخدمتُ هيناتا للردّ عليه بطريقة ما

342
00:20:30,030 --> 00:20:31,950
لكن فَشِلَ ذلك أيضاً

343
00:20:31,950 --> 00:20:34,280
لنبقى مُتواريين عن الأنظار لبعض الوقت

344
00:20:34,640 --> 00:20:38,260
رغم ذلك، الشّيوخ العظماء الخمسة
ليسوا بتلك القوّة الّتي سمعتُ عنها

345
00:20:38,260 --> 00:20:39,760
توقّعتُ هذا

346
00:20:40,150 --> 00:20:44,550
.سيّد الشّيطان ريمورو رحيم
عرفتُ بأنّه لن يقتل هيناتا

347
00:20:44,960 --> 00:20:50,560
كنتُ قد تمنّيتُ أن يكون هو من يسقط

348
00:20:50,980 --> 00:20:53,360
،لولا رسالتك

349
00:20:53,360 --> 00:20:58,190
لكنتُ قد تواجهتُ وجهاً لوجه مع هيناتا
القدّيسة أمام سيّد الشّيطان ريمورو

350
00:20:58,480 --> 00:21:00,350
،ولو خسرتُك أيضاً

351
00:21:00,350 --> 00:21:04,200
لحادَتْ خطّتي عن مسارِها دون خلاص

352
00:21:04,510 --> 00:21:08,700
،لو وصلت الأمور إلى هذه النّقطة
لكنتُ قد هربتُ على الأقلّ

353
00:21:10,590 --> 00:21:12,630
لكن لا تتّخذ موقفاً حازماً بعد

354
00:21:13,110 --> 00:21:16,460
أريد أن أراقب الأمور فترة أطول
وأستمتع بكيفيّة مسار المُفاوضات

355
00:21:16,720 --> 00:21:20,520
في هذه الحالة، أرى أن أعود إلى موطني

356
00:21:20,950 --> 00:21:22,960
أستطيع إرسال ميشا بالنّيابة عنّي

357
00:21:23,240 --> 00:21:24,940
صحيح. افعل  ذلك من فضلك

358
00:21:25,470 --> 00:21:27,110
سأفعل

359
00:21:27,480 --> 00:21:32,120
والآن بالنّسبة لتجارة العبيد
...الّتي كنّا نعمل عليها هنا

360
00:21:32,120 --> 00:21:33,730
كيف أستأنفها؟

361
00:21:34,580 --> 00:21:36,190
تذكّرت، هناك هذه أيضاً

362
00:21:36,500 --> 00:21:39,360
لا أريد التّعامل مع أورتروس. لنسحقهم فحسب

363
00:21:39,580 --> 00:21:42,860
هل ينبغي أن نحرِّر الوحوش النّادرين
الّذين كنّا نُرسلهم إلى إيكيدنا؟

364
00:21:43,510 --> 00:21:47,360
لا، تعامل مع التّصنيفات المُميّزة
من السّلع كالعادة

365
00:21:47,360 --> 00:21:50,300
ما زال لدينا نافذتنا مع عائلة
روتزو في نهاية المطاف

366
00:21:51,130 --> 00:21:54,220
عُلِم. اسمح لي بتولّي التّرتيبات

367
00:22:00,520 --> 00:22:02,920
سمعتِ، أليس كذلك يا كازاليم؟

368
00:22:03,310 --> 00:22:04,440
أجل يا زعيم

369
00:22:04,910 --> 00:22:08,180
حسناً، ما الّذي جعل تقرِّر سحق أورتروس؟

370
00:22:08,480 --> 00:22:09,600
الجواب سهل

371
00:22:09,890 --> 00:22:13,080
ارتأيتُ فقط أن أمنح فُرصة لتحقيق شيء

372
00:22:13,540 --> 00:22:15,680
...بذلك تعني

373
00:22:15,840 --> 00:22:17,700
أجل. هو

374
00:22:18,040 --> 00:22:20,940
أفكارك نيّرة دوماً يا زعيم

375
00:22:21,380 --> 00:22:22,240
أليس كذلك؟

376
00:22:22,530 --> 00:22:24,690
هل يمكنني الاعتماد عليكِ في تحقيق ذلك؟

377
00:22:25,000 --> 00:22:25,880
أجل

378
00:22:26,310 --> 00:22:28,250
...أيضاً ولو كان هذا خارج الموضوع

379
00:22:28,640 --> 00:22:31,070
أفضِّل أن تناديني كاغالي

380
00:22:31,740 --> 00:22:35,040
ماذا؟ اتّخذتِ قراركِ أخيراً؟

381
00:22:35,480 --> 00:22:39,400
أجل. اتّخذتُ قراري عندما مات كلايمان

382
00:22:40,030 --> 00:22:44,750
اسم سيّدة الشّيطان كازاليم سيبقى
مختوماً حتّى يكتمل انتقامي من ليون

383
00:22:44,940 --> 00:22:46,270
مفهوم

384
00:22:46,270 --> 00:22:49,760
في هذه الحالة يا كاغالي، الوقت
يُداهمنا. أعتمد عليكِ

385
00:22:50,130 --> 00:22:52,010
اعتمد عليّ يا زعيم

386
00:24:25,740 --> 00:24:28,000
"الحلقة القادمة، "تحضيرات مهرجان