1
00:00:17,570 --> 00:00:18,990
...حسناً

2
00:00:18,990 --> 00:00:22,380
شكراً لكم جميعاً على حضور
حفل عشيّة المهرجان

3
00:00:23,810 --> 00:00:27,620
اسمي ريمورو، وقد أصبحتُ
سيّد شيطان مؤخّراً

4
00:00:27,620 --> 00:00:30,280
لكن سأعفيكم من كلّ التّفاصيل المُعقّدة اليوم

5
00:00:30,280 --> 00:00:34,640
وأدعوكم جميعاً لمطعم بلدنا القيّم

6
00:00:34,880 --> 00:00:36,880
...لستُ جيّداً في الخِطابات الطّويلة، لذا

7
00:00:37,450 --> 00:00:39,400
!لنتطرّق إلى صلب الموضوع

8
00:00:39,580 --> 00:00:42,010
!بصحّتكم

9
00:02:17,520 --> 00:02:20,280
لذيذ! عرفتُ بأنّ شونا ويوشيدا-سان
!تستطيعان فعلها

10
00:02:20,860 --> 00:02:24,700
.يبدو أنّ ضيوفنا راضون أيضاً
هذا مُطمئن

11
00:02:30,680 --> 00:02:32,480
ما هذا يا سيّدي؟

12
00:02:32,480 --> 00:02:34,000
!ها نحن أولاء

13
00:02:37,350 --> 00:02:38,920
!أي نوع من السّمك هو هذا؟

14
00:02:39,130 --> 00:02:41,120
!يبدو مُرعِباً

15
00:03:02,240 --> 00:03:04,700
!يبدو لذيذاً

16
00:03:05,010 --> 00:03:05,670
...لكن

17
00:03:06,530 --> 00:03:08,780
لن يأكله احد

18
00:03:09,090 --> 00:03:13,160
ليس من العادات أكل سمك نيّئ
في هذا العالم في النّهاية

19
00:03:13,160 --> 00:03:16,220
آسف يا سيّدي، لكن لا أعتقد
بأنّني أستطيع أيضاً

20
00:03:16,220 --> 00:03:19,450
أعتقد يعتقدون أنّه من الغريب أكله

21
00:03:19,450 --> 00:03:20,220
حسناً

22
00:03:24,340 --> 00:03:25,300
سآكل منه

23
00:03:25,640 --> 00:03:29,400
في هذه الحالة، جرّب هذا

24
00:03:39,230 --> 00:03:41,270
!هذا مُذهل يا هاكورو

25
00:03:41,270 --> 00:03:42,650
بكلِّ تأكيد

26
00:03:42,850 --> 00:03:45,910
كنتُ أخشى ألّا يبقى شيء
،لنا من هذا السّمك الشّهيّ

27
00:03:45,910 --> 00:03:49,800
لكن يبدو أنّه لا حاجة للقلق

28
00:03:50,400 --> 00:03:53,280
لا أطيق انتظار الاستمتاع
بمشروب لذيذ عقب هذا

29
00:03:54,490 --> 00:03:58,040
هل أُعِدَّ سوشي التّونا الدّسِم
هذا من دون واسابي؟

30
00:03:59,800 --> 00:04:01,330
هل أنتِ طفلة؟

31
00:04:01,330 --> 00:04:05,370
اصمت. لا أحبّ إحساس الحرقة في أنفي

32
00:04:05,600 --> 00:04:06,800
...وأيضاً

33
00:04:07,050 --> 00:04:08,840
سيكون من اللّطيف أكل طعام مُتنوِّع

34
00:04:09,140 --> 00:04:10,880
أتنقصكِ الخبرة؟

35
00:04:10,880 --> 00:04:14,270
الخبير الحقيقيّ يستمتع بالسّوشي
مع النّكهة المُضافة من الواسابي

36
00:04:14,270 --> 00:04:17,460
خبير؟ لا أكترث لذلك

37
00:04:17,460 --> 00:04:19,080
همّي الوحيد هو أن يكون مذاقه لذيذاً

38
00:04:19,080 --> 00:04:20,530
!تفضّلي

39
00:04:27,430 --> 00:04:29,570
إنّه مُذهل حقّاً

40
00:04:29,880 --> 00:04:33,900
رغم كرهي لقول ذلك، أنا مُعجبة
بك يا ريمورو

41
00:04:34,400 --> 00:04:37,330
حسناً إذاً، سأتناول واحدة أيضاً

42
00:04:37,710 --> 00:04:41,220
وأنا لستُ طفلاً، لذا أريد
خاصّتي مع واسابي

43
00:04:45,210 --> 00:04:48,070
!مذهل! ذابت فوراً على لساني

44
00:04:49,130 --> 00:04:53,590
لم أتصوّر أبداً أن أتمكّن من أكل سوشي
!لذيذ كهذا هنا. أنا مُتحفِّز للغاية

45
00:04:54,170 --> 00:04:57,090
إنّه مختلف عن سمك المياه العذبة تماماً

46
00:04:57,090 --> 00:05:00,040
،طلبتُ من الاتِّحاد الحُرّ بعضاً منه
،لكنّهم رفضوا

47
00:05:00,040 --> 00:05:02,810
ولا يمكن نقله بالسّحر، لذا كنتُ
قد استسلمتُ من الحصول عليه

48
00:05:03,130 --> 00:05:05,480
لكن لديّ الآن شيء جديد
أتطلّع قُدماً إليه

49
00:05:05,840 --> 00:05:07,360
هل يمكنكِ لومنا؟

50
00:05:07,360 --> 00:05:11,410
المُحيط الشّماليّ خطير جدّاً بسبب
،الأصناف الضّخمة الّتي تعيش فيه

51
00:05:11,740 --> 00:05:14,590
والمُحيط الجنوبيّ بعيد جدّاً
على استيراد السّمك منه

52
00:05:15,150 --> 00:05:19,280
ومجرّد نقل سمك مُصطاد
في بُحيرات ليس مُربِحاً

53
00:05:19,930 --> 00:05:24,440
أعتقد بأنّ هذا العالم ما زال يواجه
بعض المُشكلات في التّوزيع

54
00:05:24,440 --> 00:05:26,000
هذا ما أردتُه بالضّبط

55
00:05:26,280 --> 00:05:30,380
حالما يكتشف النّاسُ بأنّ هناك طعاماً
...لذيذاً يمكنهم إيجاده فقط في تيمبيست

56
00:05:31,400 --> 00:05:32,470
ريمورو-ساما

57
00:05:33,170 --> 00:05:35,530
هل يمكننا تناول القليل من هذا أيضاً؟

58
00:05:37,900 --> 00:05:39,360
أجل، بالطّبع

59
00:05:43,270 --> 00:05:44,400
!توقّعتُ هذا

60
00:05:45,140 --> 00:05:46,450
!ما أطيبه

61
00:05:46,840 --> 00:05:49,950
من كان يتوقّع أنّ سمكةً مُتوحِّشة كهذه
ستكون بهذا المذاق اللّذيذ؟

62
00:05:49,950 --> 00:05:54,040
ظننتُ أنّ السّمك هو شيء
كان يُؤكَل مطبوخاً دوماً

63
00:05:54,450 --> 00:05:57,080
إذا كان مذاقه لذيذاً، فمن يأبه؟

64
00:05:58,640 --> 00:06:00,880
!أنا أيضاً! أريد بعضاً أيضاً

65
00:06:00,880 --> 00:06:02,200
!وأنا لو سمحت

66
00:06:02,200 --> 00:06:03,200
!أنا أيضاً

67
00:06:05,920 --> 00:06:07,130
!ثمّة مُشكلة

68
00:06:07,400 --> 00:06:09,130
ما الأمر؟ هل حدث شيء؟

69
00:06:09,360 --> 00:06:12,770
!ظهرَ شيء طائر كبير خارج البلدة فحسب

70
00:06:13,760 --> 00:06:15,290
شيء طائر؟

71
00:06:19,580 --> 00:06:20,600
!تقرير

72
00:06:20,600 --> 00:06:25,170
ملِك التنّين الحارس من سُلالة
!الشّعوذة ساريون قد جاء

73
00:06:26,180 --> 00:06:27,480
!هذه مُصيبة

74
00:06:27,480 --> 00:06:31,580
جلالتها إيلميشيا إيل رو ساريون
!قد هبطت إلى هذه الأرض

75
00:06:31,930 --> 00:06:36,320
حاشية جلالتها إيلميشيا قادمون
!سيراً إلى هنا الآن

76
00:06:36,830 --> 00:06:38,670
لقد أثاروا قلقي

77
00:06:38,670 --> 00:06:40,330
هذا ما يجري إذاً

78
00:06:40,820 --> 00:06:44,200
لا تزال جاهلاً بآليّة سَير هذا العالم

79
00:06:44,380 --> 00:06:47,110
إذا كانت الإمبراطورة السّماويّة إيلميشيا
،السّماويّة قد غادرت موطنها

80
00:06:47,110 --> 00:06:49,090
فلا عجب في أن يفزع النّاس

81
00:06:49,480 --> 00:06:50,830
ماذا تقصد؟

82
00:06:51,500 --> 00:06:53,910
سُلالة الشّعوذة ساريون دولة ضخمة

83
00:06:54,390 --> 00:06:58,340
تمتلك قوّةً كبيرةً مُكافئة لقوّة
،دولتي المُسلَّحة دوارغون

84
00:06:58,340 --> 00:07:02,760
مع ذلك إنّها دولة مُستقلّة، وليست
جزءاً من مجلس الغرب

85
00:07:03,640 --> 00:07:06,120
،"وكما يُشير اسمها "سلالة

86
00:07:06,120 --> 00:07:09,110
إنّها دولةٌ تشكّلَتْ بواسطة حلف
مُكوَّن من ثلاثة عشر عائلة ملكيّة

87
00:07:09,890 --> 00:07:13,330
،تُعتبَر الإمبراطورة إيلميشيا سليلة الإله

88
00:07:13,330 --> 00:07:17,670
وهي قويّة جدّاً لدرجة أنّها نصّبتْ
نفسها الإمبراطورة السّماويّة

89
00:07:18,080 --> 00:07:20,040
...تتمتّع دوارغون بتاريخ عمره ألف عام

90
00:07:20,040 --> 00:07:23,910
،لكن يعود تاريخ ساريون إلى ألفَي عام
أو هذا ما يقولونه

91
00:07:25,150 --> 00:07:29,100
،حتّى أنا لستُ ندّاً لها

92
00:07:29,100 --> 00:07:32,160
ناهيك عن أيّ بشريّ بدورة عمره القصيرة

93
00:07:32,160 --> 00:07:34,430
لا أحد يحلم حتّى بفُرصة لقائها

94
00:07:35,030 --> 00:07:36,430
هكذا إذاً

95
00:07:36,430 --> 00:07:39,180
،كنتُ أنوي دعوة الأرشيدوق إيرالد إلى هنا

96
00:07:39,180 --> 00:07:42,150
لكن أعتقد أنّ شخصيّةً رئيسيّةً هامّة
قد جاءت معه

97
00:07:43,240 --> 00:07:45,430
يبدو أنّهم وصلوا

98
00:07:47,250 --> 00:07:48,980
لا تُرخِ دفاعك يا ريمورو

99
00:07:50,540 --> 00:07:53,770
أقترح أن تعتبرها خصماً ماكراً ومتيناً

100
00:07:59,360 --> 00:08:02,430
أشكرك على الدّعوة

101
00:08:03,080 --> 00:08:04,960
كان من دواعي سروري تلقّيها

102
00:08:08,360 --> 00:08:11,510
...وسروري أيضاً. شرف لي أن ألتقيكِ... يا

103
00:08:12,610 --> 00:08:13,440
إشعار

104
00:08:13,440 --> 00:08:15,230
تمّ رصد تدخُّل ذهنيّ

105
00:08:15,230 --> 00:08:16,470
حظر

106
00:08:16,800 --> 00:08:21,230
إنّه ليس هجوماً، لكنّه تأثيراً طبيعيّاً
يُسبّبه حضورُها البطوليّ

107
00:08:21,230 --> 00:08:22,600
!يا للهول

108
00:08:22,600 --> 00:08:26,480
لديه حضور بطوليّ وبمستوى أعلى
!حتّى من غازيل

109
00:08:26,760 --> 00:08:29,470
لا أتمنّى أبداً أن أُعاديها

110
00:08:29,820 --> 00:08:33,480
آمل أن تستمتعي باحتفالات هذا المساء

111
00:08:33,730 --> 00:08:34,450
أجل

112
00:08:35,000 --> 00:08:37,960
أتطلّع قُدماً لبدء المهرجان غداً

113
00:08:37,960 --> 00:08:40,490
من فضلك افعل ما بوسعك لتسليتي

114
00:08:41,300 --> 00:08:42,230
...وأيضاً

115
00:08:43,120 --> 00:08:46,510
.اقتطِع من وقتك للتكلُّم معي
لا حاجة ليكون اليوم

116
00:08:47,360 --> 00:08:49,000
،ثمّة أمر أرغب في مناقشته معك بصراحة

117
00:08:49,000 --> 00:08:51,250
بعيداً عن هذه الرّسميّات

118
00:08:52,950 --> 00:08:55,760
حسناً. سأتواصل معكِ حالما يتمّ
تحديد التّاريخ والوقت

119
00:09:01,910 --> 00:09:03,880
كم أنا مُرهَق

120
00:09:04,580 --> 00:09:07,300
كاد أن يتمّ ابتلاعك منذ البداية

121
00:09:07,300 --> 00:09:09,770
،حريّ بك أن تُحافظ على رشدك
—وإلّا فتلك الشّمطاء

122
00:09:13,260 --> 00:09:16,390
.يتمتّع الإيلف بآذان حادّة
ينبغي أن أتوخّى الحذر أيضاً

123
00:09:16,980 --> 00:09:18,400
!ريمورو-ساما

124
00:09:18,720 --> 00:09:21,820
ميولمايل-كن. كيف تسير التّحضيرات؟

125
00:09:21,820 --> 00:09:23,900
كلّ شيء جاهز

126
00:09:24,160 --> 00:09:27,310
والنّاس أحبّوا أولئك التُجّار الجدُد

127
00:09:27,790 --> 00:09:30,410
أعتقد أنّه ستنشأ علاقات جديدة
ومتينة جرّاء هذا

128
00:09:30,410 --> 00:09:32,040
يبدو أنّه لا مشاكل هناك

129
00:09:32,040 --> 00:09:35,420
...أجل، كلّ شيء على ما يُرام. باستثناء

130
00:09:35,420 --> 00:09:38,600
لا، في الواقع، كلّ شيء بخير

131
00:09:39,530 --> 00:09:40,460
ما الأمر؟

132
00:09:40,460 --> 00:09:43,660
،في الواقع... أنا واثقٌ بأنّني أتوهّم

133
00:09:43,660 --> 00:09:46,790
لكن لا أُميّز معظم تجّار البيع
بالتّجزئة الصّغار

134
00:09:46,790 --> 00:09:49,810
،الّذين أتوا رفقة التجّار الكبار

135
00:09:49,810 --> 00:09:54,320
فأثار هذا فضولي، لذا تحرّيتُ
...حول الأمر قليلاً، و

136
00:09:55,650 --> 00:09:58,440
أجل، كما يظهر، كلّ شيء على ما يُرام

137
00:09:59,050 --> 00:10:02,520
أعتقد بأنّ ائتماني على عمل ضخم كهذا

138
00:10:02,520 --> 00:10:04,950
جعلَني مُتوتّراً قليلاً

139
00:10:04,950 --> 00:10:06,920
...حسناً، ينبغي لي

140
00:10:06,920 --> 00:10:08,440
ألن تأكل أوّلاً؟

141
00:10:08,610 --> 00:10:11,560
بما أنّ بطولة الفنون القتاليّة
،سوف تبدأ غداً

142
00:10:11,560 --> 00:10:13,740
فلا أرغب في الرّاحة بعد. وداعاً الآن

143
00:10:14,020 --> 00:10:16,590
ميولمايل-كن عامل مُجِدّ حقّاً

144
00:10:17,090 --> 00:10:17,900
...مهلاً

145
00:10:17,900 --> 00:10:18,510
!انظروا

146
00:10:21,040 --> 00:10:23,230
يبدو أنّهم وصلوا أخيراً

147
00:10:23,230 --> 00:10:23,960
أجل

148
00:10:24,210 --> 00:10:26,260
كنتُ قلقاً بعض الشّيء بما أنّهم تأخّروا

149
00:10:26,610 --> 00:10:28,330
آسف، سأخرج لبعض الوقت

150
00:10:28,550 --> 00:10:30,600
إنّها ميليم

151
00:10:30,600 --> 00:10:32,920
من المُؤكَّد أنّها تأنّقت اليوم

152
00:10:36,210 --> 00:10:38,480
أرى أنّ أسياد الشّيطان قد وصلوا

153
00:10:48,420 --> 00:10:49,700
لا واسابي

154
00:10:51,330 --> 00:10:52,800
أريد خاصّتي بلا واسابي

155
00:10:55,580 --> 00:10:57,470
!ريمورو

156
00:10:58,240 --> 00:11:00,210
!جاء اليوم أخيراً إذاً

157
00:11:00,440 --> 00:11:04,610
،أتطلّع قُدماً للطّعام اللّذيذ
!الّذي سيُفجّر عقل ميدراي

158
00:11:05,180 --> 00:11:07,400
أجل، أضمن لكِ ذلك

159
00:11:07,650 --> 00:11:10,600
الأهمّ، لم تقعي في ورطة، أليس كذلك؟

160
00:11:10,600 --> 00:11:12,180
!لـ-لا تقلق

161
00:11:12,180 --> 00:11:14,690
،أنا مُدرِكة تماماً لدوري كحاكمة الآن

162
00:11:14,690 --> 00:11:18,610
لذا شدّدتُ على أنّني كنتُ أحمي
قطّاعي وأقنعتُ فراي بتصديقي

163
00:11:18,610 --> 00:11:22,270
.لم يكن قطّاعكِ الّذي كنتِ تحمينه
كان المتاهة

164
00:11:23,920 --> 00:11:26,160
...ويبدو أنّها تعلم

165
00:11:26,700 --> 00:11:29,710
شكراً لك على دعوتي إلى هنا اليوم

166
00:11:29,980 --> 00:11:33,320
أعتذر حقّاً عن وصولي المُتأخِّر

167
00:11:33,320 --> 00:11:37,540
مولاتي الجديدة، ميليم-ساما، فُقِدَتْ
...لفترة طويلة من الزّمن

168
00:11:37,960 --> 00:11:41,560
لذا لم أكن قادرة على تحضير ملابس
مُناسبة حتّى قُبيل المُغادرة

169
00:11:43,060 --> 00:11:47,530
،لا أمانع إطلاقاً. من فضلك
استمتعي بوقتكِ هنا

170
00:11:47,760 --> 00:11:49,180
...هكذا إذاً

171
00:11:49,560 --> 00:11:53,880
،وصل الأمر بك إلى بناء مدينة جديدة لنا

172
00:11:53,880 --> 00:11:57,110
والآن دعيتنا إلى هذا الحدث حتّى

173
00:11:57,110 --> 00:11:59,480
أنا مُمتنّة من أعماق قلبي

174
00:11:59,480 --> 00:12:03,360
لا عليكِ. آمل فقط أنّ يُعجبكم الطّعام

175
00:12:03,360 --> 00:12:06,880
بالمناسبة. هل كانت هناك
أي أطعمة تكرهونها؟

176
00:12:06,880 --> 00:12:09,380
،نحن نقدّم بعض أطباق الدّواجن
—آمل أن يكون هذا

177
00:12:11,290 --> 00:12:14,840
أتقول... دواجن؟

178
00:12:16,460 --> 00:12:18,620
!تبّاً

179
00:12:19,710 --> 00:12:24,740
ريمورو-ساما، هل تلمّح إلى أنّني
لستُ أفضل من الدّواجن؟

180
00:12:25,300 --> 00:12:27,560
...المعذرة، ليس هذا ما

181
00:12:28,290 --> 00:12:30,680
!ارتكبتُ خطأ فادحاً

182
00:12:34,090 --> 00:12:36,960
!كان ذلك مذهلاً يا ريمورو

183
00:12:36,960 --> 00:12:39,490
!"أن تنعت فراي بـ"الدّواجن

184
00:12:39,490 --> 00:12:40,740
!كان ذلك ذكيّاً

185
00:12:40,740 --> 00:12:43,310
بالفعل. مُحال أن أتمكّن من مُجاراته

186
00:12:43,310 --> 00:12:47,120
وما الّذي تريانه مُضحِكاً في ذلك
يا كاريون وميليم؟

187
00:12:48,520 --> 00:12:51,620
لا، أعتذر. ما كان ينبغي أن أقول ذلك

188
00:12:52,100 --> 00:12:53,960
طرحتُ سؤالاً ما كان يُفترَض أن أطرحه

189
00:12:54,920 --> 00:12:56,480
آمل أن تسامحيني

190
00:13:04,640 --> 00:13:06,370
هذا هو ريمورو-ساما الّذي عهِدناه

191
00:13:06,720 --> 00:13:10,240
أدركتُ بأنّه لم تكن نيّتك إهانتي

192
00:13:10,240 --> 00:13:12,390
كنتُ أختبرك قليلاً فحسب

193
00:13:12,950 --> 00:13:14,610
لكن فهمتُ الآن

194
00:13:15,440 --> 00:13:19,250
بأنّ ميليم-ساما قد نضجت بحذوّ حذوّك

195
00:13:24,130 --> 00:13:25,080
...على أيّ حال

196
00:13:26,160 --> 00:13:28,480
كاريون؟

197
00:13:28,480 --> 00:13:28,980
ماذا؟

198
00:13:28,980 --> 00:13:31,370
ما الّذي يُضحكك في ذلك؟

199
00:13:31,370 --> 00:13:35,200
هلّا شرحت لي بوضوح بحيث
أستطيع أن أفهم؟

200
00:13:35,200 --> 00:13:38,200
!مـ-مهلاً! هـ-هـ-هذا مؤلم

201
00:13:38,200 --> 00:13:40,340
!هذا مؤلم فعلاً! صدّقيني

202
00:13:40,340 --> 00:13:41,800
ميليم، هل رأيتِ ذلك؟

203
00:13:41,990 --> 00:13:45,830
.عندما ترتكبين خطأ، تعتذرين
هذا هو الخيار الصّائب

204
00:13:46,080 --> 00:13:47,620
أجل، فهمت

205
00:13:47,620 --> 00:13:50,300
سأحرص على ألّا أُغضِب فراي كثيراً

206
00:13:50,300 --> 00:13:53,750
!كفى تجاهُلاً وساعدوني

207
00:13:53,750 --> 00:13:54,430
!أنتم

208
00:13:54,430 --> 00:13:57,730
!لا تتجاهلوني! هذا مؤلم

209
00:13:58,130 --> 00:13:58,840
...والآن

210
00:13:59,920 --> 00:14:01,690
!الوجبة جاهزة

211
00:14:07,700 --> 00:14:09,560
أعتمد عليكِ اليوم

212
00:14:09,880 --> 00:14:12,300
ميدراي هو شخصٌ مُتصلِّب الرّأي

213
00:14:12,560 --> 00:14:16,340
أتوقّع أن يكون هذا الطّعام لذيذاً
!لدرجة تُفجّر عقله من اللّقمة الأولى

214
00:14:17,210 --> 00:14:19,580
قُبِلت المهمّة يا ميليم-ساما

215
00:14:20,160 --> 00:14:22,120
أرجو أن تستمتعوا بوجبتكم

216
00:14:22,600 --> 00:14:26,460
لستُ مُنبهِراً يا ريمورو-ساما

217
00:14:26,730 --> 00:14:32,220
لا نسمح لك بتعليم مولاتنا ميليم
مثل هذه التصرُّفات اللّعينة

218
00:14:32,220 --> 00:14:34,480
ماذا تقصد بـ"لعينة"؟

219
00:14:34,480 --> 00:14:40,310
إنَّ الاستمتاع بالطّعام كما شاءت
الطّبيعة أن يكون

220
00:14:40,310 --> 00:14:44,400
هو المُمارسة الّتي اعتبرناها سليمة
وصائبة منذ العصور القديمة

221
00:14:44,400 --> 00:14:46,230
!مع ذلك، انظر إلى كلّ هذا

222
00:14:46,480 --> 00:14:48,110
،لا أمانع طبخ الطّعام

223
00:14:48,110 --> 00:14:53,190
لكنّك تُلوّثه بهذه المادّة السّائلة
!غير المعروفة

224
00:14:53,190 --> 00:14:54,450
!كم هذا بائس

225
00:14:54,950 --> 00:14:57,900
كيف تجرؤ على مُعاملة خيرات الطّبيعة
!بمثل هذه الوقاحة؟

226
00:14:57,900 --> 00:15:01,780
يحقّ لك أن تفعل ما تشاء
،ضمن قطّاعك الخاصّ

227
00:15:01,780 --> 00:15:05,640
لكن أن تُقحِم ميليم-ساما في عربدتك
!لَهو أمر مشين

228
00:15:06,000 --> 00:15:07,800
...أن قطعاً

229
00:15:08,160 --> 00:15:12,300
!لن أوافق على هذه الشّعوذة المُزيّفة

230
00:15:12,640 --> 00:15:18,600
طلبتْ منّي ميليم أن أدع ميدراي يعترف
...بأنّ الطّعام المطبوخ والمُحضَّر لذيذ

231
00:15:20,410 --> 00:15:22,420
لكن لن يكون هذا سهلاً

232
00:15:23,200 --> 00:15:27,400
ريمورو، لم أكن أدرك بأنّ ميدراي
بهذا العِناد الشّديد

233
00:15:27,790 --> 00:15:31,050
هل أدعه ينسحب إلى غرفة أخرى؟

234
00:15:31,050 --> 00:15:33,630
أنا آسف بشأن رئيس كهنتنا

235
00:15:33,630 --> 00:15:35,820
إنّه ليس شخصاً سيّئاً صدّقني

236
00:15:36,050 --> 00:15:38,410
...لم أتوقّعه أبداً أن يفقد صوابه هكذا

237
00:15:38,590 --> 00:15:39,940
...أجل

238
00:15:39,940 --> 00:15:44,290
كان من السّذاجة منّي أن أعتقد
بأنّه سيفهم حالما يأكل بعضاً

239
00:15:44,290 --> 00:15:47,570
ولا أريد أن أجبره. أعتقد هكذا
يجب أن يكون الأمر

240
00:15:56,460 --> 00:15:58,480
—ما-ما الّذي

241
00:15:58,480 --> 00:15:59,450
اصمت

242
00:16:00,390 --> 00:16:04,020
هل ترى كلّ المُكوِّنات في هذا الحساء؟

243
00:16:05,040 --> 00:16:08,530
هذا هو الشّكل المثاليّ الّذي
يرغبه ريمورو-ساما

244
00:16:08,840 --> 00:16:10,900
ماذا؟ ماذا يعني هذا؟

245
00:16:11,130 --> 00:16:15,200
لدى ميليم-ساما الآن المُستوحشون والمُجنَّحون

246
00:16:15,200 --> 00:16:17,460
،والماجين الّذين كانوا أتباع كلايمان

247
00:16:17,790 --> 00:16:20,390
وأنتم الدراغونيت الّذين تخدمونها

248
00:16:20,960 --> 00:16:25,710
أيّ عِرق من هذه الأعراق يمتلك
قوّةً هائلةً بحدّ ذاته

249
00:16:26,120 --> 00:16:28,810
،لكن عندما تجتمع كلّ نقاط قوّتهم معاً

250
00:16:28,810 --> 00:16:31,760
يتضافرون لإنشاء قوّة أعظم حتّى

251
00:16:33,880 --> 00:16:36,940
كُله وستفهم. من فضلك، لقمة واحدة فقط

252
00:16:37,240 --> 00:16:39,090
...حـ-حسناً

253
00:16:48,310 --> 00:16:50,920
!ما-ما هذا؟

254
00:16:51,640 --> 00:16:54,030
هذا ما يُدعى بالتّناغُم الحقيقيّ

255
00:16:54,270 --> 00:16:57,380
لا يُبرِز كلّ مُكوّن على حِدة
مذاقه الخاصّ بشكل كبير

256
00:16:57,380 --> 00:17:00,080
وذلك من أجل خلق النّكهة الإجماليّة المثاليّة

257
00:17:00,780 --> 00:17:04,640
هذه هي الأمنية الّتي أُشبِعَ بها هذا الحساء

258
00:17:05,140 --> 00:17:06,960
حـ-حقّاً؟

259
00:17:08,580 --> 00:17:09,680
إنّه شهيّ

260
00:17:09,680 --> 00:17:12,880
هذه المِلعقة لوحدها مليئة بالنّكهات

261
00:17:12,880 --> 00:17:16,050
أكثر من أيّ خضار أكلتُه في حياتي

262
00:17:16,260 --> 00:17:17,970
أجل، هذا ما أتوقّعه

263
00:17:17,970 --> 00:17:21,550
لا يمكن مُقارنة الخضار
غير المطبوخ بطبخ شونا

264
00:17:21,550 --> 00:17:24,650
من فضلك لا تنظر إليه بمثل هذه الشّفقة

265
00:17:25,460 --> 00:17:27,440
إذا لم تتذكّر شيئاً آخر، فتذكّر هذا

266
00:17:27,760 --> 00:17:31,540
إنَّ "الطّبخ" لا يتألّف من هذا الطّبق وحده

267
00:17:31,970 --> 00:17:33,610
ماذا تقصدين؟

268
00:17:34,130 --> 00:17:38,660
إذا كان هذا الحساء هو الدّولة الجديدة
،الّتي تحكمها ميليم-ساما

269
00:17:38,660 --> 00:17:41,180
،فهذا الخبز هو مملكة بلوموند

270
00:17:41,180 --> 00:17:44,240
وشريحة اللّحم هذه هي مملكة فالمينانس

271
00:17:44,800 --> 00:17:47,960
وإذا كان كبد الإوز بالفخّار هذا
،هو مملكة الأقزام

272
00:17:47,960 --> 00:17:50,710
فطبق الطّعام البحريّ هذا هو
سُلالة الشّعوذة ساريون

273
00:17:51,460 --> 00:17:55,090
طبق واحد من تلقاء نفسه
"لا يمكن أن يُدعى "طبخ

274
00:17:55,440 --> 00:17:57,530
نفس الأمر ينطبق على الدُّول

275
00:17:58,030 --> 00:18:02,390
،كلّما كانت علاقتهم أعمق وأوسع
كانوا أكثر إشباعاً وإرضاء

276
00:18:03,600 --> 00:18:04,720
...هذا هو

277
00:18:06,040 --> 00:18:08,340
العالم الّذي يرغبه ريمورو-ساما

278
00:18:09,370 --> 00:18:10,900
حـ-حقّاً؟

279
00:18:11,200 --> 00:18:14,860
العلاقات بين الدُّول هامّة بكلِّ تأكيد

280
00:18:15,290 --> 00:18:19,440
طبق واحد يمكن أن يُفسَد إذا احتوى
على المقدار الخاطئ من الملح

281
00:18:19,440 --> 00:18:22,070
لكن التّناغُم الّذي يخلقه عندما
يُقدَّم مع أطباق أخرى

282
00:18:22,070 --> 00:18:24,620
هو ما يُطلَق عليه بالوجبة الكاملة

283
00:18:24,820 --> 00:18:28,450
...في الواقع، لم أفكّر في الأمر بهذه الطّريقة

284
00:18:28,800 --> 00:18:29,620
...لكن

285
00:18:29,620 --> 00:18:32,120
...هكذا إذاً

286
00:18:32,430 --> 00:18:36,740
لكن هذا لا يعني أنّه يمكننا خلط
أيّ شيء معاً

287
00:18:36,740 --> 00:18:38,880
الرّجاء الحذر بشأن ذلك

288
00:18:40,450 --> 00:18:41,130
!حسناً إذاً

289
00:18:41,640 --> 00:18:43,880
،يبدو أنّك توافقنا أخيراً

290
00:18:43,880 --> 00:18:46,260
ومُعظم الأطباق تكون أشهى
!بينما هي دافئة

291
00:18:46,480 --> 00:18:49,550
!تعالوا جميعاً، قبل أن يبرد

292
00:18:50,880 --> 00:18:53,040
!لا أمانع إذا فعلت

293
00:18:57,870 --> 00:19:00,520
!إنّه لذيذٌ جدّاً

294
00:19:00,730 --> 00:19:01,510
...هكذا إذاً

295
00:19:01,920 --> 00:19:06,240
...كنتِ تنتظرينني حتّى أدرك خطئي

296
00:19:06,480 --> 00:19:08,280
مهلاً الآن أيُّها الأب ميدراي

297
00:19:08,280 --> 00:19:11,690
ستزعج الجميع إذا بقيت كئيباً هكذا

298
00:19:11,690 --> 00:19:13,370
لنأكل قبل أن يبرد الطّعام

299
00:19:14,460 --> 00:19:16,480
...أ-أيّها

300
00:19:16,480 --> 00:19:19,800
لـ-لمَ يبدو رأسك كبطّيخة؟

301
00:19:21,480 --> 00:19:23,570
ما المُشكلة، ميدراي؟

302
00:19:23,570 --> 00:19:27,920
من الأفضل أن تأكل الآن كما قال
!هيرميس، قبل أن آكله كلَّه

303
00:19:27,920 --> 00:19:31,120
ستعيش يوماً آخر يا هيرميس

304
00:19:31,120 --> 00:19:34,650
،احتراماً لميليم-ساما وهذا الطّبخ المُدهش

305
00:19:34,650 --> 00:19:37,030
سأتجاهل وقاحتك اليوم

306
00:19:37,030 --> 00:19:38,810
!ميدراي، هذا شهيّ أيضاً

307
00:19:38,810 --> 00:19:41,030
!وهذا باهرٌ أيضاً يا ميليم-ساما

308
00:19:41,400 --> 00:19:44,370
بينيمارو، أختك الصّغيرة رهيبة حقّاً

309
00:19:44,370 --> 00:19:46,800
أليست كذلك؟ أنا فخور بها

310
00:19:49,160 --> 00:19:51,440
،حدثت بعض الأمور لم أتوقّعها

311
00:19:51,760 --> 00:19:54,560
...لكن انتهت أُمسيتنا المهرجانيّة بنجاح

312
00:19:57,570 --> 00:19:58,390
،وأخيراً

313
00:19:59,330 --> 00:20:01,640
كان الوقت قد حان لمهرجان افتتاح دولتنا

314
00:20:11,060 --> 00:20:12,800
—رِفاق، أنا

315
00:20:12,800 --> 00:20:15,620
أقصد أيّها النّاس... أنا سيّد الشّيطان ريمورو

316
00:20:15,930 --> 00:20:18,340
لا... أنا ريمورو، سيّد الشّيطان

317
00:20:22,100 --> 00:20:24,560
أنا سيّد الشّيطان ريمورو. سُرِرتُ بلقائكم

318
00:20:25,800 --> 00:20:30,080
أنا مسرورٌ حقّاً لأنّكم قبلتُم هذه
الدّعوة إلى بلدي

319
00:20:30,630 --> 00:20:33,560
لا أنوي إثارة عداوة البشر

320
00:20:33,950 --> 00:20:37,240
أريد بناء دولة حيث يستطيع الجميع
أن يعيشوا معاً كأصدقاء

321
00:20:38,040 --> 00:20:42,230
إذا استطاع البشرُ والوحوشُ العمل
معاً أكثر من القتال

322
00:20:42,230 --> 00:20:44,890
فأؤمن تماماً بأنّ مستقبلاً مُشرِقاً ينتظرنا جميعاً

323
00:20:45,720 --> 00:20:49,640
أنا متأكّدٌ بأنّ هناك بينكم من تُساوره
شكوك تجاهي

324
00:20:50,040 --> 00:20:51,800
،هذا طبيعيّ

325
00:20:52,250 --> 00:20:55,310
لكن سيُسعدني حقّاً أن تثقوا بي

326
00:20:56,080 --> 00:20:58,290
لكن الثِّقة لا تُولَد بين ليلةٍ وضُحاها

327
00:20:58,590 --> 00:21:02,540
إنّها شيء نكسبه من خلال
،العلاقات الّتي نبنيها معاً

328
00:21:02,540 --> 00:21:04,810
لذا لا أتوقّع منكم أن تُقرِّروا فوراً

329
00:21:06,350 --> 00:21:08,450
آمل منكم جميعاً أيُّها النُّبلاء
الّذين أتيتُم إلى هنا

330
00:21:08,730 --> 00:21:12,510
أن تُشاركوا ما رأيتموه هنا مع أبناء
وطنكم في الدّيار

331
00:21:13,540 --> 00:21:16,810
بعضكم يُمثِّل دُولاً شكّلَتْ
صداقةً معنا بالفعل

332
00:21:17,330 --> 00:21:19,320
،حتّى لو كنتُم لا تثِقون بدولتنا

333
00:21:19,320 --> 00:21:22,560
يمكنكم بالتّأكيد أن تثِقوا بالّذين يثِقون بنا، صحيح؟

334
00:21:23,660 --> 00:21:26,710
آمل أن تتخلّوا عن أيّ تحامُل لديكم

335
00:21:26,710 --> 00:21:28,850
على كوني هُلاماً ووحشاً

336
00:21:29,450 --> 00:21:34,840
لن أخيّركم بين تشكيل صداقة
معنا وخوض حرب

337
00:21:35,150 --> 00:21:39,420
لكن إذا عاملتمونا بشكلٍ غير مُنصِف
فقط لأنّنا وحوش

338
00:21:39,420 --> 00:21:42,560
أو جلبتُم الحرب إلى دولتنا
،باسمِ صيد الوحوش

339
00:21:42,560 --> 00:21:44,260
فلن أكون رحيماً

340
00:21:46,800 --> 00:21:48,720
...لذا هذا ما أشعر به حقّاً

341
00:21:52,600 --> 00:21:55,490
لكن إلى كافّة التجّار والمُغامرين
،المُتجمّعين هنا

342
00:21:55,490 --> 00:21:58,730
وكذلك النّاس العاديّين الّذين
،يعملون في الحقول

343
00:21:59,180 --> 00:22:01,690
أقسم بأنّني لن أتهجّم عليكم

344
00:22:02,790 --> 00:22:04,920
،بلدي تنقصه الأيدي العاملة

345
00:22:05,370 --> 00:22:08,660
لذا إن كنتُم تبحثون عن عمل، فآمل
أن تُفكِّروا في الانتقال إلى هنا

346
00:22:09,490 --> 00:22:13,590
بشكلٍ عام، يحقُّ لكم أن تُعبِّروا
،عن أيّ رأي في هذه الدّولة

347
00:22:13,590 --> 00:22:15,710
،ونعترف بحرّية كلامكم

348
00:22:15,710 --> 00:22:18,440
وكذلك حرّيتكم في اختيار مهنتكم الخاصّة

349
00:22:19,160 --> 00:22:23,420
اِعلَموا فقط بأنّكم ستتحمّلون مسؤوليّة
ما تختارون قوله وفعله

350
00:22:24,420 --> 00:22:28,510
بمعرِفة ذلك، إذا وجدتُم أنفسكم
،مهتمّين ببلدنا

351
00:22:28,510 --> 00:22:31,660
فمن فضلكم ضعوا كلَّ ما قلتُه
للتو بعين الاعتبار

352
00:22:32,550 --> 00:22:36,620
ننوي إقامة المزيد من الفعاليّات
والاحتفالات المُماثِلة مُستقبلاً

353
00:22:37,320 --> 00:22:39,710
إنَّ المهرجان الّذي يبدأ اليوم
للإعلان عن افتتاح تيمبيست

354
00:22:39,710 --> 00:22:42,620
قد خُطِّطَ ليكون مرحلة أولى

355
00:22:44,780 --> 00:22:49,320
والآن آمل أن تستمتعوا جميعاً
!بمهرجان افتتاح تيمبيست

356
00:24:25,280 --> 00:24:27,490
"الحلقة القادمة، "مهرجان افتتاح الدّولة