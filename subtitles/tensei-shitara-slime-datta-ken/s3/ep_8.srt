1
00:00:06,420 --> 00:00:08,060
...كم هذا جميل

2
00:00:19,840 --> 00:00:20,950
لوميناس-ساما

3
00:00:24,230 --> 00:00:26,090
ما الأمر يا لوي؟

4
00:00:26,090 --> 00:00:27,730
أعتذر

5
00:00:27,730 --> 00:00:30,520
هناك مسألة أودّ أن ألفت انتباهكِ لها

6
00:00:30,520 --> 00:00:32,320
ماذا حدث؟

7
00:00:32,320 --> 00:00:37,260
اتّخذت هيناتا إجراء غير مُخوّل لقطع جذور
المشكلة مع سيّد الشّيطان ريمورو

8
00:00:38,000 --> 00:00:43,350
لكن يبدو أنّ رجال دين الأيّام السّبعة
لهم يد في هذا الأمر على الأغلب

9
00:00:43,670 --> 00:00:47,280
تبّاً لهيناتا تلك. حذّرتُها من التصرُّف بطَيش

10
00:00:47,280 --> 00:00:50,860
لا تزعج لوميناس-ساما بهذه المسائل التّافهة

11
00:00:51,210 --> 00:00:54,860
اِلزَم حدودك. ألا تراعي مشاعر الآخرين؟

12
00:00:55,130 --> 00:00:56,960
،أعتذر يا غونتر

13
00:00:57,320 --> 00:01:01,620
لكن قد نخسر هيناتا إذا لم نفعل
شيئاً حيال لهذا الأمر

14
00:01:01,620 --> 00:01:06,370
من غير المنطقيّ أن نتكبّد عناءً
بسبب حماقة البشر

15
00:01:06,690 --> 00:01:10,680
أتريد إشعال عداوات مع سيّد الشّيطان
ريمورو، الشّخص الّذي نسعى لتجنّبه؟

16
00:01:10,680 --> 00:01:14,760
لهذا السّبب وطأت قدمايّ منطقتكم
لطلب النّصح والمشورة

17
00:01:15,210 --> 00:01:17,080
—إذا قُتِلَتْ هيناتا، فإنّ لوميناس-ساما سوف

18
00:01:17,080 --> 00:01:19,120
اصمت يا لوي

19
00:01:19,550 --> 00:01:21,230
كذلك أنت يا غونتر

20
00:01:22,140 --> 00:01:23,020
حاضر

21
00:01:23,720 --> 00:01:25,200
أستميحك عذراً

22
00:01:25,540 --> 00:01:30,030
هذان الاثنان وشِجارهما الدّائم يُزعجني حقّاً

23
00:01:30,500 --> 00:01:35,310
الآن بعد أن خسرنا روي، أعتقد بأنّه
سيترتّب علينا إعادة توزيع الأدوار

24
00:01:39,840 --> 00:01:42,810
لا يمكننا أن نقف مكتوفي الأيدي الآن

25
00:01:43,310 --> 00:01:45,480
كلاكما، تعالا معي

26
00:01:45,480 --> 00:01:46,350
حالاً

27
00:01:55,350 --> 00:01:56,690
انتظريني، حسناً؟

28
00:03:45,340 --> 00:03:47,080
إنّها قويّة

29
00:03:47,920 --> 00:03:49,280
—سيّد الشّيطان ريمورو

30
00:03:49,280 --> 00:03:53,480
ليس هو حتّى، بل أحد أتباعه
يبعث هالة كهذه؟

31
00:03:54,160 --> 00:03:55,630
،أنا شيون

32
00:03:56,170 --> 00:03:58,750
السّكرتيرة الأولى لريمورو-ساما

33
00:03:59,960 --> 00:04:03,900
اسمعوا جميعاً الآن، هذه هي كلمات
:ريمورو-ساما

34
00:04:04,310 --> 00:04:06,840
"اختاروا بين الاستسلام والموت"

35
00:04:07,680 --> 00:04:11,360
إذا كنتم تفهمون معنى هذا، فارموا أسلحتكم

36
00:04:11,360 --> 00:04:13,480
واستسلموا لي حالاً

37
00:04:15,640 --> 00:04:17,080
نفهم معنى هذا

38
00:04:17,370 --> 00:04:19,200
وبوضع ذلك في الحسبان، هذا هو جوابنا

39
00:04:19,680 --> 00:04:20,540
!تفرّقوا

40
00:04:21,240 --> 00:04:24,730
!فعّلوا المجال المُقدّس على الهدف

41
00:04:32,520 --> 00:04:36,170
المجال المُقدّس. أهذا اختصاصهم حقّاً؟

42
00:04:37,340 --> 00:04:40,680
،هيناتا، أنتم هائجون وتستمتعون بوقتكم هنا

43
00:04:40,680 --> 00:04:43,040
لكن لستُ بحاجة لتذكيركم بأنّ هذه منطقتي

44
00:04:43,600 --> 00:04:45,600
،حالما تتّخذون إجراء عسكريّاً هنا

45
00:04:45,600 --> 00:04:48,310
يمكنني أن أستخلص بأنّكم أعداء

46
00:04:48,310 --> 00:04:51,990
وأنا لستُ لطيفاً جدّاً لأدعكم
تُبادِرون بالهجمة الأولى

47
00:04:52,690 --> 00:04:54,520
كلامك منطقيّ على ما أعتقد

48
00:04:55,090 --> 00:05:01,670
لكن أيضاً لا أملك فكرة لماذا نائبي
رينارد عصى أوامري

49
00:05:01,670 --> 00:05:07,280
كلام جريء من الأشخاص الّذين قتلوا
ريهيم وحاولوا إلباسنا تهمة ذلك

50
00:05:08,080 --> 00:05:08,880
ريهيم؟

51
00:05:09,420 --> 00:05:10,310
أجل

52
00:05:10,310 --> 00:05:13,700
رئيس الأساقفة من فالموث الّذي استدعيتموه

53
00:05:14,020 --> 00:05:16,300
مات؟ تمّ قتله؟

54
00:05:17,160 --> 00:05:19,710
فهمت. هذا ما يجري إذاً

55
00:05:20,080 --> 00:05:23,170
أفترض بأنّكِ تلقّيتِ رسالتي؟

56
00:05:23,170 --> 00:05:23,840
أجل

57
00:05:24,640 --> 00:05:26,410
وهذه هي إجابتك؟

58
00:05:27,220 --> 00:05:28,490
...في الواقع، ليس تماماً

59
00:05:29,130 --> 00:05:33,230
لكن هل ستصدّقني إذا قلتُ
لك أنّها ليست كذلك؟

60
00:05:33,230 --> 00:05:34,740
قد أصدّقك

61
00:05:35,240 --> 00:05:39,730
لكن فقط إذا أوقفتِهم وأعدتِهم
إلى الدّيار أوّلاً

62
00:05:40,320 --> 00:05:40,960
—هذا

63
00:05:40,960 --> 00:05:42,160
!ماذا تقول؟

64
00:05:42,160 --> 00:05:46,320
إذا أوقفنا قوّاتنا الآن، فماذا سيحدث
لهيناتا-ساما؟

65
00:05:46,320 --> 00:05:48,980
!أنت من استدعاها إلى هنا

66
00:05:48,980 --> 00:05:50,660
!من يضمن بأنّك لن تؤذيها؟

67
00:05:52,320 --> 00:05:56,800
الوحيدان اللّذان يُسمَح لهما بالكلام الآن
هما ريمورو-ساما وهيناتا ساكاغوتشي

68
00:05:57,170 --> 00:05:59,790
أولئك غير المدعوّين للنّقاش ينبغي
أن يلتزموا الصّمت

69
00:05:59,950 --> 00:06:01,040
ماذا؟

70
00:06:01,330 --> 00:06:02,950
!أحقّاً ما تقول؟

71
00:06:06,410 --> 00:06:09,710
لم أرِد مُقاطعة مُفاوضات هيناتا-ساما

72
00:06:09,710 --> 00:06:12,890
أردتُ فقط تهديدكم قليلاً. لم أتوقّع
منك أن تستجيب

73
00:06:13,160 --> 00:06:15,640
نحن مُتّفِقان على عدم الرّغبة في التدخُّل

74
00:06:16,400 --> 00:06:18,070
إذا أردتَ أن نتكلّم، فلنفعل ذلك في مكانٍ آخر

75
00:06:18,430 --> 00:06:19,560
لا مانع لديّ

76
00:06:19,560 --> 00:06:20,480
!آرنود

77
00:06:20,610 --> 00:06:22,230
توقّفوا مكانكم

78
00:06:22,480 --> 00:06:24,590
لا بدّ أنّكم تشعرون بالملل

79
00:06:24,590 --> 00:06:27,490
أتعتقدون أنّ لديكم الوقت الكافي للقلق
على زملائكم الآن؟

80
00:06:27,490 --> 00:06:30,740
!الفُرسان الوحوش؟! ماذا تفعلان هنا؟

81
00:06:30,880 --> 00:06:34,180
سوف نكون في صحبتكم في الوقت الحالي

82
00:06:34,180 --> 00:06:35,120
أجل

83
00:06:35,120 --> 00:06:38,250
أرونا ما الّذي يستطيع القدّيسون
!العُظماء العشرة فعله

84
00:06:39,010 --> 00:06:40,650
يبدو أنّنا لا نملك خياراً آخر

85
00:06:49,600 --> 00:06:50,470
هل نفعل؟

86
00:06:51,450 --> 00:06:52,040
أجل

87
00:06:56,150 --> 00:06:58,520
والآن، هل نبدأ؟

88
00:07:00,490 --> 00:07:01,450
سنبدأ

89
00:07:09,870 --> 00:07:12,140
أتقولين "الاستسلام أم الموت"؟

90
00:07:12,590 --> 00:07:17,130
كيجين... لا، تطوُّر أعلى حتّى... أوني؟

91
00:07:18,020 --> 00:07:20,580
لا يحقّ لوحش مثلكِ أن تكون له طلبات

92
00:07:21,280 --> 00:07:23,580
...إنّ الأوني هو كارثة على أقلّ تقدير

93
00:07:23,580 --> 00:07:26,620
لا بل أقرب إلى إله محلّي

94
00:07:26,620 --> 00:07:28,800
شخص بوسعه حتّى أن يصبح سيّد شيطان

95
00:07:28,800 --> 00:07:32,360
اقتربت، لكن ليس تماماً

96
00:07:33,680 --> 00:07:37,350
بينيمارو والآخرون الّذين يقاتلون
،رفاقكم هم أوني

97
00:07:37,890 --> 00:07:41,430
لكن أنا تطوّرتُ باتّجاه مختلف قليلاً

98
00:07:43,450 --> 00:07:45,720
أنا أوني

99
00:07:46,020 --> 00:07:48,740
...لذا مهما اعتقدتموني لطيفة

100
00:07:49,380 --> 00:07:50,930
فأنا لستُ كذلك

101
00:07:51,780 --> 00:07:54,880
وحش قذر شرّير

102
00:07:54,880 --> 00:07:57,280
أفكاركِ الغبيّة هي إهانة للإله

103
00:07:57,770 --> 00:08:00,800
!سوف أمسحها من هذا العالم، وأنتِ معهم

104
00:08:01,240 --> 00:08:02,540
!المدفع المُقدّس

105
00:08:14,590 --> 00:08:17,710
!مستحيل! المدفع المُقدّس يفكّك الجزيئات السّحريّة

106
00:08:17,710 --> 00:08:20,770
!يُفترَض أن يكون قاتلاً للوحوش بشكلٍ فوريّ

107
00:08:20,770 --> 00:08:24,350
لن أستغرب لو تفادَتْه، لكن ردّتْه أيضاً؟

108
00:08:24,350 --> 00:08:28,320
سألتُكم من قبل أن تختاروا
بين الاستسلام أو الموت

109
00:08:29,460 --> 00:08:30,860
هل هذا هو جوابك؟

110
00:08:39,000 --> 00:08:41,980
تحسّنتَ بشكل هائل خلال
فترة قصيرة كهذه

111
00:08:41,980 --> 00:08:45,370
في آخر لقاء بيننا، كنتَ صيداً
سهلاً بالنّسبة لمُنتزِع

112
00:08:49,610 --> 00:08:51,950
،أجل... بصيغة أخرى

113
00:08:51,950 --> 00:08:55,890
هذا يعني بأنّك بلغتَ نفس مستويات
لوميناس-ساما

114
00:08:56,220 --> 00:08:58,600
كنتُ لأفضّل ألّا أقاتلك، لأسباب عديدة

115
00:09:01,790 --> 00:09:03,330
تستسلم فجأة؟

116
00:09:10,430 --> 00:09:11,640
!ما هذا بالضّبط؟

117
00:09:12,210 --> 00:09:12,990
إجابة

118
00:09:12,990 --> 00:09:15,590
تأكيد تبلوُر القوّة الرّوحيّة

119
00:09:15,570 --> 00:09:18,520
هذا غالباً من عتاد الخاصّية المُقدّسة
والمُخصّص ضدّ الوحوش

120
00:09:30,280 --> 00:09:34,060
والآن يعتمد الأمر كلّه على قوّتك
الخامّة ضدّ قوّتي الخامّة

121
00:09:34,740 --> 00:09:37,260
يجب أن نواجه بعضنا الآخر بكلّ ما لدينا

122
00:09:41,060 --> 00:09:44,360
سألني ريمورو قبل قليل ما إن تلقّيتُ رسالته

123
00:09:44,800 --> 00:09:48,960
كانت تلك دعوته إلى معركة فرديّة
واحد ضدّ واحد لحسم الأمر بيننا

124
00:09:48,960 --> 00:09:52,790
من خلال النّصر، يمكنني التّكفير
عن غلطتي الماضية

125
00:09:54,540 --> 00:09:55,530
...هذا السّيف

126
00:09:56,240 --> 00:09:59,830
من الواضح بأنّه صُنِعَ لأداء أفضل
من أيّ سلاح آخر رأيتُه

127
00:10:01,150 --> 00:10:03,020
،يمكنني الاستخلاص إلى أنّه بدرجة أسطوريّة

128
00:10:03,020 --> 00:10:05,050
فئة مختلفة عن درجة الفريد

129
00:10:05,400 --> 00:10:06,660
توقّعتُ هذا

130
00:10:06,660 --> 00:10:09,430
كالعادة، هذه المرأة لا تترك
أي ثغرة فيها حقّاً

131
00:10:09,430 --> 00:10:13,850
لو كنتُ أعلم بأنّها ستفعل هذا، لطلبتُ
من كوروبي أن يصنع لي سيفاً خاصّاً

132
00:10:16,060 --> 00:10:18,160
،سيفي هو بديل، لذا لستُ متأكّداً من ذلك

133
00:10:18,160 --> 00:10:19,380
لكنّني جاهز

134
00:10:30,160 --> 00:10:32,870
هل أنتم متأكّدون من هذا؟

135
00:10:32,870 --> 00:10:37,240
استسلموا لي فحسب بينما ما زلتُ لطيفة

136
00:10:37,550 --> 00:10:38,500
!حمقاء

137
00:10:38,500 --> 00:10:41,890
أتعتقدين بأنّ لديكِ الأفضليّة فقط
!لأنّكِ صددتِ هجمة واحدة؟

138
00:10:48,560 --> 00:10:49,840
حسناً، اسمع

139
00:10:49,840 --> 00:10:53,300
هذا هو الأمر الّذي أصدره عليّ
:ريمورو-ساما في الواقع

140
00:10:53,680 --> 00:10:56,740
أن أتجنّب قتلكم قدر المستطاع

141
00:10:56,740 --> 00:10:59,360
إذا استسلمتم الآن، ستتجنّبون
تلقّي أي ضربات

142
00:10:59,360 --> 00:11:02,880
وحتّى أنّني سأدعوكم لتناول
طبخي كخدمة خاصّة

143
00:11:02,880 --> 00:11:03,680
ما رأيكم؟

144
00:11:04,190 --> 00:11:05,160
طبخها؟

145
00:11:06,040 --> 00:11:09,430
الفُرسان المُقدّسون لا يتفاوضون مع وحوش

146
00:11:09,600 --> 00:11:10,960
والآن اسمع فحسب

147
00:11:10,960 --> 00:11:15,480
أريد أن أدعكم تستسلمون بإثبات الفجوة
بين قوّتي وقوّتكم دون قتلكم

148
00:11:15,480 --> 00:11:18,320
أنتم، من النّاحية الأخرى، تريدون قتلي

149
00:11:18,320 --> 00:11:20,200
—لذا لديّ اقتراح

150
00:11:20,200 --> 00:11:23,090
—لا تدعها تُضلّلك! لا تعر انتباهاً لهذيان

151
00:11:30,380 --> 00:11:33,830
لا جدوى من أذن لا تصغي

152
00:11:34,480 --> 00:11:36,280
!كيف تجرئين؟

153
00:11:37,080 --> 00:11:39,280
استهدفَتْ أُذنَه بالتّحديد؟

154
00:11:40,400 --> 00:11:43,070
لنستمع إلى اقتراحكِ إذاً

155
00:11:44,720 --> 00:11:45,610
اسمع

156
00:11:45,610 --> 00:11:49,800
سأدعكم تضربونني بأقوى هجمة لديكم

157
00:11:50,290 --> 00:11:52,320
،إذا تحمّلتُها، فسأفوز

158
00:11:52,320 --> 00:11:55,410
وستستسلمون لنا بسلام

159
00:11:55,410 --> 00:11:56,230
ما قولك؟

160
00:11:56,420 --> 00:11:57,200
ماذا؟

161
00:11:57,590 --> 00:12:00,610
هل هي جادّة بشأن عدم الرّغبة في قتلنا؟

162
00:12:01,780 --> 00:12:04,740
!حسناً! نقبل بهذا التحدّي

163
00:12:05,530 --> 00:12:07,400
—ا-انتظر يا غاردي! ينبغي أن نتكلّم

164
00:12:07,400 --> 00:12:10,120
!اصمت! سوف نفعل هذا جميعاً

165
00:12:10,120 --> 00:12:12,120
!اجعلوا قوّتكم الرّوحيّة تتراصف مع قوّتي

166
00:12:12,280 --> 00:12:13,070
!حاضر

167
00:12:13,070 --> 00:12:15,380
رينارد، سأترك التحكُّم لك

168
00:12:16,500 --> 00:12:17,480
أظنّه على حقّ

169
00:12:17,480 --> 00:12:20,380
في وسط المعركة، لا وقت للتردُّد

170
00:12:21,000 --> 00:12:24,690
،بغضّ النّظر عن نوايا هذه الأوني
إنّها خطيرة

171
00:12:25,280 --> 00:12:28,620
إذا ترتّب علينا مواجهة وحش، فالنّصر
!سوف ينحاز للحقّ

172
00:12:39,840 --> 00:12:43,210
!خذي هذه! لهب الجحيم

173
00:12:45,760 --> 00:12:46,970
!لا اعتراض لديّ هنا

174
00:12:49,380 --> 00:12:53,330
!لا توجد طريقة أسرع لتحطيم معنويّات خصم

175
00:13:00,400 --> 00:13:01,650
...لا أصدِّق ذلك

176
00:13:02,440 --> 00:13:04,720
،والآن، كما وعدتم

177
00:13:05,480 --> 00:13:07,890
استسلموا لنا

178
00:13:08,950 --> 00:13:11,880
خسرنا. الفجوة بين قوّتينا هائلة

179
00:13:12,400 --> 00:13:13,830
...إذا استمررنا في القتال

180
00:13:13,830 --> 00:13:16,320
!كـ-كفاك غروراً أيّها الوحش

181
00:13:16,320 --> 00:13:19,680
،ما دام لدينا الحقل المُقدّس
!لا يمكنكِ فعل شيء

182
00:13:20,080 --> 00:13:23,690
ليس هذا ما ردتُه، لكن ما رأيكِ
أن نبدأ بحرب استنزاف؟

183
00:13:23,690 --> 00:13:25,910
ما زلت لا تعترف بالحقيقة؟

184
00:13:27,160 --> 00:13:29,410
لن تترك خياراً لي سوى قتلك

185
00:13:31,240 --> 00:13:32,430
توقّف يا غاردي

186
00:13:32,430 --> 00:13:35,410
لا تستفزّها أكثر من ذلك. سنموت جميعاً

187
00:13:35,410 --> 00:13:36,360
!أحمق

188
00:13:36,360 --> 00:13:38,680
!نحن الفُرسان المُقدّسون! الهزيمة مُستبعَدة

189
00:13:38,680 --> 00:13:40,840
!هل نسيت ذلك أيضاً؟

190
00:13:41,500 --> 00:13:44,020
ثمّة مُشكلة. ما هذا؟

191
00:13:44,900 --> 00:13:47,340
غاردي عصبيّ بطبعه، لكنّه رجل وقور

192
00:13:47,920 --> 00:13:49,050
...لماذا هو

193
00:13:55,870 --> 00:13:57,560
!مـ-مستحيل

194
00:13:57,840 --> 00:14:00,560
هل هذا حلم؟ هل أنا أحلم؟

195
00:14:00,560 --> 00:14:05,570
وحش... وحش حطّمَ حاجزنا المُقدّس؟

196
00:14:06,920 --> 00:14:11,200
كما توقّعت، كان مجرّد حاجز مُخصَّص
عبثَ بالقوانين قليلاً

197
00:14:11,200 --> 00:14:14,300
العبث بالقوانين هو موطِن قوّتي

198
00:14:15,490 --> 00:14:18,350
!وأكثر ما أبرع فيه هو الطّبخ

199
00:14:18,940 --> 00:14:22,180
،أيُعقَل... المهارة الّتي تعدّل الأحداث

200
00:14:22,180 --> 00:14:23,590
!نتيجة معيّنة؟

201
00:14:23,590 --> 00:14:25,160
...هذا لا يُصدَّق

202
00:14:25,740 --> 00:14:28,090
!يمكنها خلق أي نتيجة تريدها؟

203
00:14:28,780 --> 00:14:32,620
...مستحيل... كيف يستطيع وحش كهذا

204
00:14:34,000 --> 00:14:35,070
نستسلم

205
00:14:35,610 --> 00:14:38,470
نتوسّل إليكِ أن تتساهلي مع رجالنا

206
00:14:38,990 --> 00:14:40,670
لا داعي للقلق عليهم

207
00:14:40,670 --> 00:14:42,850
فريمورو-ساما لطيف جدّاً

208
00:14:43,360 --> 00:14:48,860
لهذا السّبب كلّ ما أراد فعله مع قائدتكم
...هو الكلام، ومع ذلك

209
00:14:56,440 --> 00:14:59,230
...هيناتا-ساما وسيّد الشّيطان ريمورو

210
00:14:59,920 --> 00:15:02,120
اقتل سيّد الشّيطان ريمورو

211
00:15:02,120 --> 00:15:05,470
هيناتا تحاول نيل استحسان
سيّد الشّيطان ريمورو

212
00:15:05,470 --> 00:15:10,910
إن كان هذا صحيحاً، فستبذل كلّ قوّتها لإيقافك

213
00:15:11,290 --> 00:15:16,200
لا... لو كانت هيناتا-ساما تحاول
،استحسانه فعلاً

214
00:15:16,200 --> 00:15:18,040
فلا سبب يدفعهما للقتال إذاً

215
00:15:19,050 --> 00:15:22,070
فلماذا يتقاتلان؟

216
00:15:22,700 --> 00:15:25,360
عمّاذا تثرثر؟

217
00:15:25,360 --> 00:15:29,920
لم يملك خياراً لأنّكم قدتُم جيشاً
إلى هنا لمواجهته

218
00:15:31,440 --> 00:15:37,290
قدتُ الصّليبيّين إلى هنا من أجل
...إثبات براءة... هيناتا

219
00:15:37,700 --> 00:15:41,280
هل تقول أنّ هذه المعركة ما كانت
!لتندلع لو لم أفعل ذلك؟

220
00:15:42,240 --> 00:15:44,400
!لـ-لا! هيناتا-ساما

221
00:15:46,150 --> 00:15:48,240
!ستفشل مُفاوضاتها بسببي

222
00:15:55,380 --> 00:15:57,810
حتّى بمساعدة رافاييل، الأمر بهذه الصّعوبة؟

223
00:15:57,810 --> 00:16:01,560
بصراحة، ظننتُ بأنّني سأظفر
...بهذه المعركة بسهولة

224
00:16:03,190 --> 00:16:05,480
لقد تحسّنَ كثيراً حقّاً

225
00:16:06,050 --> 00:16:09,300
،لكن هذا ينطبِق فقط على قدراته الجسديّة

226
00:16:09,300 --> 00:16:11,560
لا موهبته

227
00:16:12,350 --> 00:16:14,680
أمام المهارات الّتي قضيتُ عشر
...سنوات وأنا أصقلها

228
00:16:20,660 --> 00:16:22,410
،رغم أنّها كانت فترة قصيرة

229
00:16:23,610 --> 00:16:25,840
كانت المرّة الوحيدة الّتي أرتاح فيها لشخص

230
00:16:26,520 --> 00:16:29,400
،تعلّمتُ كلّ تقنيّات شيزو-سينسي

231
00:16:29,400 --> 00:16:31,640
ثمّ تركتُها

232
00:16:32,820 --> 00:16:34,820
لأنّني كنتُ خائفة من فقدانها

233
00:16:36,520 --> 00:16:40,640
لم أستطع حتّى شكرها لأنّني مُحرَجة جدّاً

234
00:16:41,600 --> 00:16:46,040
لكن الخبرة الّتي اكتسبتُها من خلال
!خِلافة شيزو-سينسي منحَتْني الأفضليّة

235
00:16:50,840 --> 00:16:53,880
!مهلاً، هذه ليست مزحة
...لو أصابتني تلك الضّربة

236
00:16:54,530 --> 00:16:55,190
إجابة

237
00:16:55,360 --> 00:16:59,740
لن تكون قاتلة، لكن كانت ستُنقِص
طاقتك بشكل شديد

238
00:16:59,740 --> 00:17:00,740
!أجل، توقّعت

239
00:17:05,160 --> 00:17:07,150
،يسرّني أنّها ليست بالقاتلة

240
00:17:07,150 --> 00:17:09,680
،لكن إذا أصابَتْني في المكان الخطأ
فسوف أتلقّى ضرراً حتماً

241
00:17:10,040 --> 00:17:12,010
إنَّ تلقّي الكثير من هذه الهجمات
هو مُجازفة كبيرة

242
00:17:12,970 --> 00:17:17,020
يمتلك سيفُها أيضاً طول موجة فريد
يعمل على تعديل القوانين

243
00:17:17,020 --> 00:17:19,850
سيكسر الحاجز مُتعدِّد الطّبقات

244
00:17:20,050 --> 00:17:23,810
بجدّية؟ أقصد، إذا كانت سينسي تقول
...ذلك، فلا بدّ أنّه صحيح، لكن

245
00:17:25,260 --> 00:17:26,690
ماذا؟ هل من جديد؟

246
00:17:26,690 --> 00:17:28,560
إشعار. الهجمة التّالية قادمة

247
00:17:31,640 --> 00:17:35,800
سيكون هذا مُملّاً، لكن من الأفضل غالباً
الانتظار حتّى تُرهَق

248
00:17:35,800 --> 00:17:38,790
!ليس وكأنّني سوف أُرهَق في نهاية المطاف

249
00:17:41,520 --> 00:17:42,950
سرعة سيفها قد ازدادتْ؟

250
00:17:45,040 --> 00:17:46,830
...لا، لحظة! هذا

251
00:17:46,830 --> 00:17:47,670
إشعار

252
00:17:47,670 --> 00:17:50,170
إنّها تستدرجك نحو نقاط من المُتوقَّع
أن تُصيبها الهجمات

253
00:17:50,170 --> 00:17:51,380
!تبّاً! سينسي

254
00:17:51,380 --> 00:17:52,800
!رافاييل-سينسي

255
00:17:52,800 --> 00:17:54,120
!هل من شيء أستطيع فعله؟

256
00:17:54,120 --> 00:17:56,630
!فكّري في شيء في أسرع وقت ممكن

257
00:17:56,730 --> 00:17:57,480
إشعار

258
00:17:57,480 --> 00:18:00,020
"اكتساب "التنبُّؤ بهجمة مستقبليّة

259
00:18:00,020 --> 00:18:01,020
استخدام المهارة؟

260
00:18:01,320 --> 00:18:02,580
!هذه هي سينسي الّتي أعرفها

261
00:18:02,580 --> 00:18:04,390
!لا أعرف ما تقوم به، لكن أجل، من فضلك

262
00:18:15,360 --> 00:18:19,410
إذاً هذا يستعرض جوهريّاً أين
ستكون شطحات سيفها

263
00:18:19,640 --> 00:18:22,820
التّظاهر بأنّني كنتُ أقرأ حركاتها
!لم يعُد حيلة بعد الآن

264
00:18:22,820 --> 00:18:24,120
!لقد ربحتُ هذه المعركة

265
00:18:29,450 --> 00:18:31,580
تغيّر شيء منذ لحظة

266
00:18:31,960 --> 00:18:33,880
لم تعُد حركاته متردّدة

267
00:18:34,370 --> 00:18:37,140
...بدا وكأنّه كان يعرف أين سأوجِّه سيفي

268
00:18:37,740 --> 00:18:40,440
صدفة؟ لا، لم يكن كذلك

269
00:18:41,030 --> 00:18:44,550
،هذا أدقّ حتّى من حِساباتي التنبُّؤيّة

270
00:18:44,550 --> 00:18:46,660
...وكأنّه يقرأ أفكاري

271
00:18:57,160 --> 00:18:59,210
يبدو أنّ النّتيجة الإجماليّة قد حُسِمَتْ

272
00:19:00,180 --> 00:19:01,080
...حسناً إذاً

273
00:19:02,460 --> 00:19:03,240
ريمورو

274
00:19:04,360 --> 00:19:05,220
ماذا؟

275
00:19:05,920 --> 00:19:09,530
لنُنهِ معركتنا الفرديّة في الجولة المقبلة هذه

276
00:19:10,630 --> 00:19:12,500
لكن دعني أحذّرك أوّلاً

277
00:19:12,880 --> 00:19:15,050
هذه التقنيّة خطيرة جدّاً

278
00:19:15,520 --> 00:19:18,390
هل ما زلت ستقبل اقتراحي؟

279
00:19:18,800 --> 00:19:19,510
إجابة

280
00:19:19,800 --> 00:19:23,600
لا أشعر برغبة من هيناتا ساكاغوتشي لقتلك

281
00:19:23,960 --> 00:19:27,160
فهمت. لهذا حذّرَتْني إذاً

282
00:19:27,160 --> 00:19:31,060
لحظة، لكن ألم تأتِ هيناتا إلى هنا لقتلي؟

283
00:19:31,620 --> 00:19:35,650
...لا، شعرتُ بغرابة في الأمر في البداية

284
00:19:35,650 --> 00:19:37,200
فات الأوان الآن على ما أعتقد

285
00:19:38,040 --> 00:19:42,320
وإذا صمدتُ أمام هجومكِ، أربح. اتّفقنا؟

286
00:19:43,940 --> 00:19:46,330
توقّعتُك أن تقول ذلك

287
00:19:48,280 --> 00:19:50,900
لكن الامتعاض غير مسموح مهما كانت النّتيجة

288
00:19:51,290 --> 00:19:55,340
عِديني بأنّكم لن تعبثوا بهذا البلد
ثانية إذا خسرتِ

289
00:19:56,910 --> 00:19:59,040
حسناً. أعِدُك

290
00:19:59,430 --> 00:20:03,320
فقد وافقتُ على هذه المعركة الفرديّة
بناء على طلبك فقط

291
00:20:03,320 --> 00:20:06,200
كنتُ آمل أن أجري نقاشاً حول
مستقبلنا بحدِّ ذاتي فحسب

292
00:20:06,200 --> 00:20:07,100
لحظة، ماذا؟

293
00:20:07,320 --> 00:20:09,990
أنا طلبتُ معركة فرديّة بيني وبينكِ؟

294
00:20:09,990 --> 00:20:13,300
أجل. تلقّيتُ رسالتك

295
00:20:13,880 --> 00:20:15,970
...أذكر أنّ محتوى رسالتي كان

296
00:20:16,940 --> 00:20:19,080
،أريدكِ أن توافقي على التّفاوض معي

297
00:20:19,080 --> 00:20:21,710
لكن إذا كنتِ غير راضية بذلك، فسوف أواجهكِ

298
00:20:22,280 --> 00:20:27,590
سوف نُبقي الأمر بيني وبينكِ، في معركة
فرديّة، وذلك كي لا نزعج أحداً آخر

299
00:20:28,510 --> 00:20:31,660
لكن إن أمكن، أحبّذ إنهاء هذا الأمر بنقاش

300
00:20:32,300 --> 00:20:35,500
أنا في انتظار ردّ إيجابيّ. فكّري
في الأمر مليّاً، اتّفقنا؟

301
00:20:36,050 --> 00:20:37,600
أراكِ قريباً

302
00:20:38,890 --> 00:20:41,720
شيء من هذا القبيل...

303
00:20:41,720 --> 00:20:44,410
معركة واحد ضدّ واحد ليست ما أردتُه إطلاقاً

304
00:20:44,870 --> 00:20:46,120
ها أنا ذي

305
00:20:49,540 --> 00:20:50,350
لحظة

306
00:20:50,350 --> 00:20:55,550
كنتُ في العادة لأحضّر نفسي لاستخدام هذه
الحركة القاتلة قبل أن يلاحظ خصمي

307
00:20:50,600 --> 00:20:54,770
أرغب قوّة الرُّوح المُقدّسة

308
00:20:54,770 --> 00:20:57,480
أتوسّل إليك: لبِّ أمنيتي

309
00:20:55,770 --> 00:21:00,200
لم أرِد أن أريك إيّاها لأنّني كنتُ
أخشى أن تنسخها بسهولة

310
00:21:01,760 --> 00:21:03,790
...لكن لهذا السّبب بالتّحديد

311
00:21:04,310 --> 00:21:05,710
!هذه ستُنهي الأمر

312
00:21:06,180 --> 00:21:07,710
!الضّربة المُمزِّقة المُذيبة

313
00:21:08,670 --> 00:21:09,470
!إشعار

314
00:21:09,470 --> 00:21:11,310
!لا يمكن الدّفاع ضدّها! لا يمكن تجنّبها

315
00:21:11,310 --> 00:21:15,500
أنصح بالتّضحية بمهارتك النّهائيّة
!بيلزيبوب مقابل هجومها

316
00:21:15,720 --> 00:21:17,640
لا وقت للتّفكير في الأمر على ما أعتقد

317
00:21:34,600 --> 00:21:36,840
أقسم بأنّه مستعدّ لأيّ شيء

318
00:21:38,750 --> 00:21:40,600
هذا هو قائدنا

319
00:21:42,960 --> 00:21:44,780
...مستحيل

320
00:21:53,630 --> 00:21:55,270
!أنت مذهل

321
00:21:55,880 --> 00:21:58,080
تلقّيتَ هذه الهجمة عمداً، أليس كذلك؟

322
00:21:59,650 --> 00:22:01,720
ماذا؟ عمّاذا تتكلّم؟

323
00:22:01,720 --> 00:22:05,130
أي أحمق يسمح لهذه الهجمة
بأن تُصيبه عمداً؟

324
00:22:05,800 --> 00:22:08,840
ماذا؟ لحظة... رافاييل-سينسي؟

325
00:22:10,380 --> 00:22:15,020
يراودني إحساس عميق جدّاً بأنّك
تُخفين شيئاً عنّي

326
00:22:15,290 --> 00:22:18,970
،بما أنّك صمدتَ أمام هذه الهجمة
فقد خسرت

327
00:22:19,370 --> 00:22:21,680
لا أستطيع الاستمرار في القتال على أيّ حال

328
00:22:22,360 --> 00:22:23,680
...هيناتا-ساما

329
00:22:28,270 --> 00:22:29,460
هذا ما أعتقده

330
00:22:30,150 --> 00:22:32,530
سنتّفق على أنّني ربحتُ إذاً

331
00:22:34,460 --> 00:22:35,400
إشعار

332
00:22:35,400 --> 00:22:38,900
تمّ تأكيد فيض طاقة خارج عن السّيطرة
وتدخُّل فكريّ

333
00:22:38,900 --> 00:22:39,960
ثمّة انفجار وشيك

334
00:22:39,960 --> 00:22:40,880
!ماذا؟

335
00:22:41,400 --> 00:22:44,530
!تبّاً! ألِهذا الحدّ تماديتُم أيُّها الأيّام السّبعة؟

336
00:24:25,380 --> 00:24:27,930
"الحلقة القادمة، "مكيدة الأيّام السّبعة