1
00:00:02,850 --> 00:00:06,120
!ماذا تفعلين هنا يا ميليم؟

2
00:00:09,520 --> 00:00:12,680
بدا أنّك كنت تنوي فعل شيء مُثير للاهتمام

3
00:00:12,680 --> 00:00:13,880
!لذا أتيتُ لأتحقّق

4
00:00:14,280 --> 00:00:16,160
وحاولت استبعادي من الأمر؟

5
00:00:16,360 --> 00:00:18,280
!كيف تجرؤ يا ريمورو؟

6
00:00:18,280 --> 00:00:19,360
—اسمعي

7
00:00:19,360 --> 00:00:20,620
ميليم؟

8
00:00:20,920 --> 00:00:22,840
بالطّبع، طفلة مثلكِ

9
00:00:22,840 --> 00:00:26,900
لا تستطيع استيعاب الطّبيعة السّامية للعمل
الّذي نقوم به نحن البالغون

10
00:00:26,900 --> 00:00:30,040
!هذه ليست لُعبة. لا تحاولي التدخُّل

11
00:00:30,040 --> 00:00:31,880
!كما قال المُعلِّم

12
00:00:31,880 --> 00:00:34,280
،نحن نعمل هنا

13
00:00:34,280 --> 00:00:36,860
!وليس لديكِ ما تفعلينه، لذا انقلعي

14
00:00:38,250 --> 00:00:40,880
أي "شيء مُثير للاهتمام" تتحدّثين عنه؟

15
00:00:41,370 --> 00:00:45,940
أخطِّط لهذا المهرجان الضّخم بسبب
الرِّسالة الّتي أرسلتِها لي

16
00:00:45,940 --> 00:00:46,850
ماذا؟

17
00:00:46,850 --> 00:00:50,270
لم تتجاهل رسالتي إذاً؟

18
00:00:50,270 --> 00:00:52,020
بالطّبع لا

19
00:00:52,020 --> 00:00:55,590
سوف ندعو أسياد الشّيطان إلى هذا المهرجان

20
00:00:55,590 --> 00:00:57,280
نريد أن نُحضّر له جيّداً

21
00:00:57,470 --> 00:01:00,280
!المعذرة يا ريمورو! أنا سيّدة شيطان أيضاً

22
00:01:00,460 --> 00:01:03,470
!أنا جزء من الأوكتاغرام مثلك ومثل ميليم

23
00:01:03,470 --> 00:01:07,150
أجل، لكنّكِ انتقلتِ إلى هنا قبل
أن تسنح لي فُرصة لدعوتكِ

24
00:01:07,960 --> 00:01:08,830
!ماذا؟

25
00:01:08,830 --> 00:01:11,000
!ماذا تقصد بأنّها "انتقلت"؟

26
00:01:11,000 --> 00:01:14,210
هل يُعقَل أنّكِ ستعيشين مع ريمورو
!الآن يا راميريس؟

27
00:01:14,210 --> 00:01:14,920
ماذا؟

28
00:01:15,140 --> 00:01:20,040
!هذا صحيح! لم أحتج لدعوة حتّى

29
00:01:20,040 --> 00:01:23,720
تخرّجتُ من حياة العُزلة، والآن
!أعيش مع ريمورو

30
00:01:27,860 --> 00:01:29,990
!ليس عدلاً! هذا ليس عدلاً

31
00:01:29,990 --> 00:01:31,930
!أريد العيش معك أيضاً

32
00:01:31,930 --> 00:01:34,760
!لمعلوماتكِ! أنا أعمل هنا

33
00:01:34,760 --> 00:01:36,320
،أساعد ريمورو

34
00:01:36,320 --> 00:01:39,590
!ولستُ مجرّد زائرة مُزعجة مثلكِ

35
00:01:39,590 --> 00:01:40,480
!ماذا تقولين؟

36
00:01:40,480 --> 00:01:42,950
!كيف تجرؤين على قول كلام كهذا لي؟

37
00:01:46,370 --> 00:01:47,370
هذا يكفي

38
00:01:48,610 --> 00:01:51,710
أي شخص يتشاجر لن يحصل
على أكلات خفيفة

39
00:01:53,140 --> 00:01:55,200
نـ-نحن أعزّ صديقتين

40
00:01:55,200 --> 00:01:56,460
صحيح؟

41
00:02:01,890 --> 00:02:03,080
أحسنتِ صنعاً يا شونا

42
00:03:34,390 --> 00:03:36,850
!كلّفني بعمل أقوم به أيضاً

43
00:03:36,850 --> 00:03:39,750
لكن هل أتباعكِ موافقون على هذا؟

44
00:03:39,750 --> 00:03:43,300
حصلتِ على إذن من كاريون-سان
أو فري-سان، صحيح؟

45
00:03:44,680 --> 00:03:46,080
...أجل، في الواقع

46
00:03:46,080 --> 00:03:48,840
أقصد بأنّني لامِعة الذّكاء

47
00:03:48,840 --> 00:03:52,120
ليس وكأنّني هربتُ لأنّني
!لا أريد الدِّراسة

48
00:03:52,120 --> 00:03:53,500
...تحديق

49
00:03:53,500 --> 00:03:54,480
!لا

50
00:03:54,480 --> 00:03:56,560
!سأكون جزءاً من هذا، ولا يمكنك إيقافي

51
00:03:56,560 --> 00:03:57,260
حسناً

52
00:03:57,260 --> 00:04:00,620
،أنتِ من سيُوبَّخ بسبب ذلك
لذا لنضع ذلك جانباً

53
00:04:01,210 --> 00:04:02,720
!تنانين! نحتاج تنانين

54
00:04:03,160 --> 00:04:05,270
،عودةً إلى ما قلتِه قبل قليل

55
00:04:05,270 --> 00:04:08,370
يمكنكِ القبض على بعض التّنانين
وإحضارهم إلى هنا لأجلنا، صحيح؟

56
00:04:08,370 --> 00:04:10,520
هل يمكنكِ فعل ذلك حقّاً؟

57
00:04:11,620 --> 00:04:13,770
هل سيتمّ توبيخي فعلاً؟

58
00:04:13,770 --> 00:04:15,660
!لا، ليس باليد حيلة

59
00:04:15,660 --> 00:04:18,570
الخطر هو جزء من المُغامرة في نهاية المطاف

60
00:04:18,800 --> 00:04:20,360
تنانين، صحيح؟

61
00:04:20,360 --> 00:04:22,270
أستطيع القبض عليهم بالتّأكيد

62
00:04:22,520 --> 00:04:25,000
ما الّذي يمنعني من الذّهاب
والقبض عليهم بنفسي؟

63
00:04:25,000 --> 00:04:28,480
لذا كلّفتُ ميليم بمهمّة القبض على تنانين لأجلنا

64
00:04:28,980 --> 00:04:30,090
،تنّين أرضيّ

65
00:04:30,500 --> 00:04:31,640
،تنّين رياح

66
00:04:32,040 --> 00:04:33,190
،تنّين جليديّ

67
00:04:33,520 --> 00:04:34,580
وتنّين ناريّ

68
00:04:35,040 --> 00:04:38,420
قبضنا على أربعة تنانين بالمُجمَل
وحرّرناهم في الدّيماس

69
00:04:39,180 --> 00:04:41,490
،بفضل الجُزيئات السّحريّة الّتي أطلقَ عنانها فيلدورا

70
00:04:41,490 --> 00:04:44,040
،بدأ الدِّيماس يُولِّد وحوشه الخاصّة

71
00:04:44,410 --> 00:04:46,840
وأحرزنا تقدُّماً جيّداً في نصب الفِخاخ

72
00:04:50,680 --> 00:04:51,990
والآن انتقلي إلى التّالي

73
00:04:51,990 --> 00:04:53,620
!حسناً

74
00:04:59,680 --> 00:05:01,820
!ريمورو-ساما

75
00:05:01,820 --> 00:05:03,420
!آسف لتأخُّري

76
00:05:03,420 --> 00:05:05,450
!يسرُّني العمل معك اعتباراً من اليوم

77
00:05:05,450 --> 00:05:07,620
ريغورد، تسرّني رؤيتك من جديد أيضاً

78
00:05:07,620 --> 00:05:10,720
ميولمايل-كن! يسرُّني وجودك هنا

79
00:05:11,890 --> 00:05:14,960
يبدو أنَّ التّحضيرات تجري على قدمٍ وساق

80
00:05:15,720 --> 00:05:19,130
أرى بعض الأشخاص الّذين أتوا
من بلاد أخرى أيضاً

81
00:05:19,130 --> 00:05:21,000
لحسن الحظّ، أجل

82
00:05:21,000 --> 00:05:24,890
!هذا مُلفِت حقّاً

83
00:05:24,890 --> 00:05:27,300
كما ترى، أحرزنا تقدُّماً

84
00:05:27,660 --> 00:05:31,930
من المُطمئن حقّاً جعل ميولمايل
يُشارك في مخطّطنا

85
00:05:31,930 --> 00:05:33,040
صحيح؟

86
00:05:33,040 --> 00:05:35,460
،حالما تنتهي هذه المِحنة برمّتها بنجاح باهر

87
00:05:35,460 --> 00:05:39,120
سأعيّنه مسؤولاً عن إدارة أموالنا

88
00:05:39,120 --> 00:05:41,160
!هذه فكرة مُتألّقة

89
00:05:41,160 --> 00:05:43,800
!مهلاً، مهلاً، مهلاً! لستُ جاهزاً لهذا

90
00:05:44,270 --> 00:05:49,080
رغم ذلك، سأبذل قصارى جهدي
في تنفيذ المهمّة

91
00:05:59,240 --> 00:06:02,710
!لا يُصدَّق... هذا لا يُصدَّق ببساطة

92
00:06:02,710 --> 00:06:06,310
!حتّى مُقارنة بأفخر النُّزُل في مملكة إنغراشيا

93
00:06:06,310 --> 00:06:09,990
!هذا المنزل فارِه أكثر منه بمراحل

94
00:06:09,990 --> 00:06:12,330
شكراً على إحضاره إلى هنا يا غوبويمون

95
00:06:12,330 --> 00:06:14,300
هل واجهتُم أي صعوبة في الوصول إلى هنا؟

96
00:06:14,300 --> 00:06:16,440
...في الحقيقة

97
00:06:16,440 --> 00:06:20,130
!أنا ممتنٌّ لك لإرسالك مُرافق لأجلي يا ريمورو

98
00:06:20,130 --> 00:06:21,440
...الّذي حدث

99
00:06:30,100 --> 00:06:31,740
كان وحشاً مُخيفاً

100
00:06:32,050 --> 00:06:36,190
قد يكون هذا من صنيع الفيكونت كازاك البغيض

101
00:06:38,200 --> 00:06:42,290
غوبويمون، استمرّ في مُرافقة ميولمايل-كن
في الوقت الرّاهن

102
00:06:42,600 --> 00:06:44,420
عُلِم، جلالتك ريمورو

103
00:06:44,790 --> 00:06:46,350
هذا مُناسب، أليس كذلك يا ميولمايل-كن؟

104
00:06:46,350 --> 00:06:48,350
!لا أمانع بالتّأكيد

105
00:06:48,350 --> 00:06:51,900
!كنتُ لأطلب منه ذلك لو لم تفعل أصلاً

106
00:06:53,820 --> 00:06:55,600
مُهاجِمون؟

107
00:06:56,160 --> 00:06:58,870
،لدينا حاجز شونا هنا في البلدة

108
00:06:59,370 --> 00:07:02,160
لكن ينبغي أن أضع الطّريق
تحت المُراقبة الحثيثة

109
00:07:04,150 --> 00:07:08,400
حسناً، لندعكم جميعاً تُقدِّمون تقريركم
عن التقدُّم في مشاريعكم

110
00:07:09,350 --> 00:07:12,330
ريمورو-ساما، ثمّة أمر أرغب في مُناقشته

111
00:07:13,240 --> 00:07:14,740
ما هو يا ريغورد؟

112
00:07:14,990 --> 00:07:18,170
إنَّ مُمثِّلي كافّة أنواع الكائنات الحيّة
في غابة ريمورو العظيمة

113
00:07:18,170 --> 00:07:20,610
قد بدؤوا بالفعل في التجمُّع في المدينة

114
00:07:20,610 --> 00:07:23,140
...يريدون تهنئتك على تعيينك كسيّد شيطان

115
00:07:23,140 --> 00:07:26,000
أو ربّما لرؤية قوّتك بأنفسهم

116
00:07:26,480 --> 00:07:28,810
هدفهم هو القسَم بولائهم

117
00:07:28,810 --> 00:07:31,510
لسيّد شيطان وكسب حمايته

118
00:07:31,880 --> 00:07:34,680
لكن إذا قرّروا أنَّ سيّد الشّيطان
،آنِف الذّكر يفتقر للقوّة

119
00:07:34,680 --> 00:07:37,880
فسوف يُكشِّرون عن أنيابهم فوراً
ويُصبِحون قُوّة مُتمرِّدة

120
00:07:39,350 --> 00:07:41,240
حتّى الآن، كانت غابة جورا آمنة

121
00:07:41,240 --> 00:07:44,590
،بفضل حماية فيلدورا-ساما الإلَهيّة

122
00:07:44,990 --> 00:07:49,840
والآن تبنّى سيّدٌ شيطانٌ جديد السّيطرة
على قطّاعهم المنيع

123
00:07:49,840 --> 00:07:50,960
فهمت

124
00:07:50,960 --> 00:07:52,770
،سيّد الشّيطان الجديد هو صاعد

125
00:07:52,770 --> 00:07:54,720
ولا يعرفون عنه شيئاً

126
00:07:54,720 --> 00:07:56,680
من الطبيعيّ أن يشعروا بالقلق بسبب ذلك

127
00:07:57,520 --> 00:08:02,040
لهذا كنّا نأمل أن تُوافق على مُقابلة
رسميّة معهم

128
00:08:02,220 --> 00:08:03,720
مُقابلة رسميّة؟

129
00:08:07,920 --> 00:08:09,880
!هذا يلائمك يا ريمورو-ساما

130
00:08:09,880 --> 00:08:14,130
ستُعقَد المُقابلة خلال الأيّام الثّلاثة
المُقبِلة ابتداء من ظهيرة اليوم

131
00:08:14,130 --> 00:08:15,760
!ابذل قصارى جهدك

132
00:08:15,760 --> 00:08:20,200
،ديابلو وهاكورو لم يعودا بعد من فالموث

133
00:08:20,200 --> 00:08:24,230
وكانا ساخطين من فكرة أن يفوّتا
!فكرة رؤيتك في أسمى حالاتك

134
00:08:24,850 --> 00:08:28,080
!صحيح، عليهما حضور تتويج يوم

135
00:08:29,080 --> 00:08:30,980
،"سيُمحى اسم "فالموث

136
00:08:30,980 --> 00:08:33,140
وستتأسّس دولةٌ جديدة

137
00:08:33,640 --> 00:08:36,080
سينشغلون كثيراً في تجهيز الأمور

138
00:08:37,560 --> 00:08:40,760
لستُ الوحيد الّذي يتعامل
مع أمور كثيرة الآن

139
00:08:40,760 --> 00:08:43,270
هذا مُحرِج، لكن سيترتّب عليّ
بذل قصارى جهدي

140
00:09:03,020 --> 00:09:05,040
...أجل، هذا مُحرِجٌ حتماً

141
00:09:06,950 --> 00:09:09,680
!ستبدأ المُقابلة الرّسميّة في هذه اللّحظة

142
00:09:12,440 --> 00:09:15,200
!إنّه أبيرو

143
00:09:15,200 --> 00:09:17,880
من دواعي سروري أن أراك يا ريمورو-ساما

144
00:09:17,880 --> 00:09:21,260
،أنا سعيد جدّاً.... لا

145
00:09:21,260 --> 00:09:24,320
أنا مُبتهج للغاية لحضوري هذه المُناسبة التّاريخيّة

146
00:09:24,580 --> 00:09:26,950
لا حاجة لتكون رسميّاً هكذا

147
00:09:26,950 --> 00:09:29,760
!أنت قائد زميل في اتِّحادنا

148
00:09:29,760 --> 00:09:31,840
أتطلّع قُدماً لعلاقتنا المُستديمة

149
00:09:31,840 --> 00:09:34,100
لن يكون هذا لائقاً

150
00:09:34,100 --> 00:09:37,100
على الإطلاق. كان غابيرو يُبلي
بلاء عظيماً لأجلي

151
00:09:37,100 --> 00:09:39,760
عيّنتُه مسؤولاً عن التّطوير الآن

152
00:09:39,760 --> 00:09:40,880
أليس كذلك يا غابيرو؟

153
00:09:40,880 --> 00:09:41,840
!ماذا؟

154
00:09:43,730 --> 00:09:45,100
!أجل

155
00:09:46,760 --> 00:09:48,360
...ابني الأحمق

156
00:09:51,100 --> 00:09:52,720
...غابيرو-ساما

157
00:09:52,720 --> 00:09:54,400
!يسرّني أنّه سامحه

158
00:09:54,400 --> 00:09:55,350
!بالفعل

159
00:09:56,680 --> 00:09:58,650
هذه آخر مجموعة لهذا اليوم

160
00:09:59,360 --> 00:10:01,400
ترايا-سان ودوريس-سان؟

161
00:10:01,400 --> 00:10:02,910
لم أركما منذ وقت طويل! كيف حالكما؟

162
00:10:03,260 --> 00:10:04,250
...ريمورو-ساما

163
00:10:04,250 --> 00:10:06,160
لدينا مسألة هامّة لنُناقشها

164
00:10:10,370 --> 00:10:13,280
!راميريس-ساما، أنتِ جميلة حقّاً

165
00:10:13,280 --> 00:10:16,630
حسناء كعادتكِ، مع هالة من الوقار

166
00:10:16,950 --> 00:10:19,650
تستحقّين أن تكوني سيّدتنا حقّاً

167
00:10:20,560 --> 00:10:21,520
أسمعت؟

168
00:10:21,520 --> 00:10:23,640
!سمعتَ ذلك، صحيح؟

169
00:10:23,880 --> 00:10:26,730
!تنظر إليّ من منظور مختلف الآن، أليس كذلك؟

170
00:10:27,040 --> 00:10:28,620
ماذا ستفعلين يا راميريس؟

171
00:10:28,870 --> 00:10:33,650
ليس هاتين الاثنتين فحسب. كافّة
التّورينتو يُرِدن خدمتكِ

172
00:10:38,780 --> 00:10:39,810
...لكن

173
00:10:40,210 --> 00:10:42,840
لِمَ لا تدعيهن ينتقِلن إلى متاهتكِ؟

174
00:10:43,840 --> 00:10:44,780
!حقّاً؟

175
00:10:44,780 --> 00:10:46,950
!سأكون جاهزة غداً إذاً

176
00:10:46,950 --> 00:10:50,510
،كان توسيع المتاهة سهلاً بمساعدة المُعلّم

177
00:10:50,510 --> 00:10:53,120
!وأشعر وكأنّ قِوايّ أمستْ أقوى أيضاً

178
00:10:53,120 --> 00:10:56,760
لدينا بعض الطّوابق الشّاغرة، لذا
!ربّما بوسعنا صنع طابق أدغال

179
00:10:57,060 --> 00:11:00,830
،لكن كمُقيمين في غابة جورا العظيمة

180
00:11:00,830 --> 00:11:03,130
ألا ينبغي أن يخضعوا لحكم ريمورو-ساما؟

181
00:11:03,130 --> 00:11:06,120
في الواقع، ما بداخل المتاهة
يخضع لحكم راميريس

182
00:11:06,340 --> 00:11:08,690
إنّها خارج حدود منطِقتي، لذا لا أمانع

183
00:11:11,780 --> 00:11:13,920
،نحن، التّورينتو وحوريّات الغابة

184
00:11:13,920 --> 00:11:16,630
نتمنّى أن نكون تحت خدمة راميريس-ساما

185
00:11:16,630 --> 00:11:18,240
،نعي بأنّه طلب أنانيّ

186
00:11:18,240 --> 00:11:20,240
لكن هلّا حصلنا على إذنك؟

187
00:11:20,600 --> 00:11:22,480
أكيد. أمنحكن الإذن

188
00:11:25,010 --> 00:11:26,600
!مرحى

189
00:11:28,240 --> 00:11:30,950
،بِبناء جنّة جميلة كهذه خصِّيصاً لنا

190
00:11:30,950 --> 00:11:33,820
أنا متأكِّدة بأنّ شعبنا سيعيش
حياةً رغيدة هنا

191
00:11:34,400 --> 00:11:36,450
اسمح لنا من فضلك بردِّ هذا المعروف

192
00:11:36,720 --> 00:11:41,080
حسناً إذاً، هل يمكنني أن أطلب من حوريات
الغابة مُساعدتي في المتاهة؟

193
00:11:41,080 --> 00:11:42,470
!سيكون هذا سهلاً

194
00:11:42,880 --> 00:11:43,410
!عظيم

195
00:11:51,480 --> 00:11:53,860
!اخرجوا من هنا

196
00:11:53,860 --> 00:11:57,600
أنا مُندهش من إحضار جماعتك القبيحة
لمُقابلة الملك

197
00:12:05,700 --> 00:12:07,160
!يا سيّد الشّيطان

198
00:12:07,480 --> 00:12:10,430
!سنكون أكثر نفعاً لك في المعركة

199
00:12:10,430 --> 00:12:12,440
،بوجودنا نحن فصيلة البقريّات في صفّك

200
00:12:12,440 --> 00:12:14,830
!سوف تفرض سيطرة كاملة على الغابة

201
00:12:14,830 --> 00:12:17,350
،إذا قضينا على الخيليّات الضُّعفاء

202
00:12:17,350 --> 00:12:20,550
فلن تكون هناك فصيلة أخرى في هذه
!الغابة تتفوّق علينا

203
00:12:20,820 --> 00:12:24,230
بضعة منهم برتبة-أ

204
00:12:24,230 --> 00:12:25,880
،من حيث القوّة القتاليّة الصّرفة

205
00:12:25,880 --> 00:12:28,640
قد يكونون الأقوى في غابة جورا العظيمة

206
00:12:28,790 --> 00:12:30,240
!أيُّها الأحمق

207
00:12:30,580 --> 00:12:32,990
إنّه سيّد شيطان. يتمتّع برجاحة عقل
أفضل من ذلك

208
00:12:33,320 --> 00:12:36,390
ليس عليك التردُّد! تحالف
!معنا نحن الخيليّات

209
00:12:36,390 --> 00:12:40,760
،لن نُبيد هؤلاء البقريّات فحسب
!بل كلّ من يحاول عصيانك

210
00:12:41,700 --> 00:12:45,750
هؤلاء يُشبهون المينوتاور من الميثيلوجيا الإغريقيّة

211
00:12:46,020 --> 00:12:48,820
وعند التّفكير بمينوتاور، سرعان
...ما تخطر المتاهة على الأذهان

212
00:12:49,460 --> 00:12:52,880
!قد يكونون مثاليّين لتعيينهم كزُعماء ديماس

213
00:12:53,160 --> 00:12:58,040
لكن من الواضح بأنّ كلّ طرف يريد
استخدامي للقضاء على الطّرف الآخر

214
00:12:58,040 --> 00:13:01,000
حسناً، هنا يحين الوقت لاستخدام
حضوري كسيّد شيطان

215
00:13:05,410 --> 00:13:05,930
ماذا؟

216
00:13:07,710 --> 00:13:08,700
!أنتما

217
00:13:08,700 --> 00:13:12,180
كيف تجرؤان على التصرُّف بوقاحة
!في حضرة ملِكنا؟

218
00:13:12,180 --> 00:13:15,140
!أنا، ريغورد، سأذكّركما بمكانتيكما

219
00:13:15,500 --> 00:13:18,410
أيحقُّ لضابط مدنيّ أن يتكلّم معنا بهذه الطّريقة؟

220
00:13:22,160 --> 00:13:24,560
إنّهما لا يشعران بحضور سيّد الشّيطان حتّى؟

221
00:13:24,560 --> 00:13:29,420
إنّهما سريعا الانفعال لدرجة أنّ قدرتهما
على تحليل الأجواء معدومة

222
00:13:33,190 --> 00:13:35,120
انكسر حاجز شونا؟

223
00:13:36,480 --> 00:13:37,070
...هل هذا

224
00:13:37,310 --> 00:13:39,600
حسنٌ. قد يكون هذا مُزعِجاً

225
00:13:40,430 --> 00:13:42,880
لا أرى أي مشكلة

226
00:13:43,100 --> 00:13:45,240
أشعر بطاقة هائلة

227
00:13:45,240 --> 00:13:46,550
هل هو ماجين؟

228
00:13:46,550 --> 00:13:49,450
إنّه ليس حضور شخص يريد أن يكون صديقاً

229
00:13:51,930 --> 00:13:54,090
...يـ-يا لها من قوّة مُبهِرة

230
00:13:55,020 --> 00:13:56,860
!يـ-يا سيّد الشّيطان

231
00:13:56,860 --> 00:13:59,480
!هل هناك سيّد شيطان آخر يهاجمنا؟

232
00:14:01,040 --> 00:14:01,730
!هيّا بنا

233
00:14:01,730 --> 00:14:02,410
!حسناً

234
00:14:09,440 --> 00:14:10,280
!غوبزو

235
00:14:11,080 --> 00:14:12,800
...ر-ريمورو-ساما

236
00:14:13,910 --> 00:14:15,460
من أنتم؟

237
00:14:15,460 --> 00:14:18,920
هل تُدرِكون بأنّ هذا قطّاع خاصّ
بسيّد الشّيطان ريمورو؟

238
00:14:22,450 --> 00:14:23,640
ابتعدوا عن الطّريق

239
00:14:23,640 --> 00:14:25,460
لستُ مهتمّاً بصاغِرين

240
00:14:25,740 --> 00:14:29,260
كنتُ سأقتل كلايمان وأنتزع
،منه العرش كسيِّد شيطان

241
00:14:29,260 --> 00:14:31,680
لكن اعترضتَ طريقي، وهذا ما أثار غضبي

242
00:14:32,100 --> 00:14:33,970
،لن أقتل أحداً بلا ضرورة

243
00:14:33,970 --> 00:14:37,080
!لكن من يعترض طريقي، فلن أرحمه

244
00:14:40,400 --> 00:14:41,340
معه حقّ

245
00:14:41,870 --> 00:14:45,580
،رغم أنّه يمتلك طاقة هائلة
إلّا أنّه يمتلك طاقة هائلة

246
00:14:46,180 --> 00:14:49,520
يبدو أنّه يقول الحقيقة بشأن
عدم حاجته للقتل

247
00:14:49,780 --> 00:14:53,010
لكن هذا لا يعني أن أدعه يفلت بفعلتِه

248
00:14:54,610 --> 00:14:56,850
ريمورو-ساما، انتظر من فضلك

249
00:14:57,520 --> 00:14:59,120
سأتولّى هذا

250
00:14:59,120 --> 00:14:59,620
!ماذا؟

251
00:15:01,740 --> 00:15:03,880
هل أنتِ مُساعدة سيّد الشّيطان ريمورو؟

252
00:15:04,390 --> 00:15:08,500
.أنتِ المرأة الكيجين الّتي ذكرها والدي
المرأة الّتي أسقطت كلايمان

253
00:15:08,500 --> 00:15:09,620
مُثير

254
00:15:09,620 --> 00:15:11,840
ستكونين بمثابة إحماء جيّد

255
00:15:11,840 --> 00:15:13,600
انتظر يا أخي

256
00:15:13,600 --> 00:15:17,090
.يمكنك تولّي أمر سيّد الشّيطان
اترك لنا المُساعِدة

257
00:15:18,000 --> 00:15:19,480
أجل، كما قال

258
00:15:19,480 --> 00:15:23,200
أنا جائع، لذا دع لي واحداً أيضاً

259
00:15:23,400 --> 00:15:25,140
هل هؤلاء أخوة؟

260
00:15:25,480 --> 00:15:29,170
كلّ واحد منهم يمتلك طاقة كبيرة
كطاقة كلايمان قبل صحوته

261
00:15:29,850 --> 00:15:32,240
...لا بدّ أنّ والدهم سيّد شيطان

262
00:15:32,890 --> 00:15:34,110
لكن من يكون؟

263
00:15:34,990 --> 00:15:35,820
!أنتم الثّلاثة

264
00:15:37,240 --> 00:15:39,860
نحن مشغولون الآن بالمُقابلة الرّسميّة
الخاصّة بريمورو-ساما الآن

265
00:15:40,150 --> 00:15:43,830
لا يمكننا إضاعة الوقت، لذا
سأواجهكم جميعاً معاً

266
00:15:44,700 --> 00:15:47,220
مهلاً، مهلاً، أتعتقديننا فريسة سهلة؟

267
00:15:47,600 --> 00:15:50,920
لا تحسبي أنّني سأتساهل معكِ
فقط لأنّكِ امرأة

268
00:15:51,170 --> 00:15:54,090
سأدعكِ تبكين. أعِدُكِ بأنّني سأفعل

269
00:15:55,260 --> 00:15:58,040
!تصدر أصوات قرقرة من معدتي

270
00:15:58,040 --> 00:16:00,680
يبدو أنّني سأملئ معدتي بالكامل
!لأوّل مرّة منذ زمن بعيد

271
00:16:01,080 --> 00:16:06,070
هذا جنون. ستقاتل ثلاثة أشخاص
أقوى منها دُفعة واحدة؟

272
00:16:06,280 --> 00:16:07,600
بـ-بينيمارو-كن؟

273
00:16:07,600 --> 00:16:09,060
دعها تفعل ما تُريد

274
00:16:09,560 --> 00:16:12,920
إنّها أفضل منّي في الحدِّ
من قوّتها على أيّ حال

275
00:16:12,920 --> 00:16:13,730
!ماذا؟

276
00:16:14,980 --> 00:16:16,950
...أظنّني سأدعها تفعلها

277
00:16:17,590 --> 00:16:18,760
!مهلاً لحظة

278
00:16:19,050 --> 00:16:21,580
ليس في هذا المكان. لننتقل
إلى مكان آخر

279
00:16:34,770 --> 00:16:35,930
!يا امرأة

280
00:16:36,300 --> 00:16:37,760
،بما أنّكِ جسورة

281
00:16:37,760 --> 00:16:40,720
سأمنحكِ فُرصة واحدة للتّراجع عن كلامكِ

282
00:16:40,980 --> 00:16:45,720
سأثبِت لكم بأنّ الطّاقة الأكبر
ليست ما يُحدِّد نتيجة معركة

283
00:17:20,750 --> 00:17:23,480
...بـ-بينيمارو-كن؟ هل شيون

284
00:17:23,480 --> 00:17:25,260
أجل، إنّها مُفاجأة

285
00:17:25,610 --> 00:17:27,330
تحسّنَتْ في كبح جماح قوّتها

286
00:17:27,330 --> 00:17:28,910
!ليس بيت القصيد هنا

287
00:17:28,910 --> 00:17:30,820
!لنضع المُزاح جانباً، إنّها مُبهِرة

288
00:17:30,820 --> 00:17:32,570
ألا تعتقد بأنّها تطوّرتْ زيادة عن اللّزوم؟

289
00:17:33,920 --> 00:17:36,300
أنا آسفة! لم يكن ذلك كافياً؟

290
00:17:37,790 --> 00:17:39,820
!لا، لا! كان ذلك كافياً

291
00:17:41,930 --> 00:17:45,410
إذا تعلّمتُم درسكم، فلا تُسبِّبوا
المتاعب لنا ثانية

292
00:17:45,670 --> 00:17:48,440
،وتذكّروا أنّ أسياد الشّياطين الآخرين أكثر جنوناً

293
00:17:48,440 --> 00:17:50,120
لذا لا تُقدِموا على أيّ تصرُّف طائش

294
00:17:50,820 --> 00:17:53,760
إنّها أقوى حتّى ممّا ذكر أبي

295
00:17:54,840 --> 00:17:57,620
أخي، هل هذا يعني أنَّ سيّد
...الشّيطان ريمورو

296
00:17:57,870 --> 00:18:00,880
أجل. إنّه أقوى حتّى

297
00:18:02,620 --> 00:18:04,640
أنا جائع بالفعل

298
00:18:04,860 --> 00:18:07,720
حسناً، من دفعكم إلى ذلك؟

299
00:18:08,810 --> 00:18:09,550
!حسناً

300
00:18:09,550 --> 00:18:12,650
نحن أبناء سيّد الشّيطان داغرول

301
00:18:13,090 --> 00:18:15,160
أنا الأكبر، داغرا

302
00:18:15,600 --> 00:18:17,320
وأنا الأوسط، ليورا

303
00:18:17,870 --> 00:18:19,950
وأنا الأصغر تشونكرا

304
00:18:24,840 --> 00:18:26,400
...إنّهم أبناء داغرول

305
00:18:28,670 --> 00:18:32,420
،لحظة، اعترفتُم بذلك بسهولة
هل كانت فكرة سديدة؟

306
00:18:32,660 --> 00:18:33,520
أجل

307
00:18:33,520 --> 00:18:38,300
في الحقيقة، أمرنا والدنا بأن نتدرّب
تحت جناحك

308
00:18:38,300 --> 00:18:42,440
أصبحنا عنيفين قليلاً، فاستشاط غضباً علينا

309
00:18:42,900 --> 00:18:44,440
وقام بطردنا

310
00:18:45,080 --> 00:18:48,680
،لا يستطيع التحكُّم بأبنائه
فيرميهم عليّ؟

311
00:18:48,680 --> 00:18:52,200
هذا تصرُّف غير لائق. لسنا أصدقاء حتّى

312
00:18:52,700 --> 00:18:56,560
رغم ذلك، ليست فكرة سيّئة
أن أدعه مَديناً لي

313
00:18:57,150 --> 00:18:57,920
حسناً، مُوافق

314
00:18:58,300 --> 00:19:01,470
ستتدرّبون تحت جناح شيون
من الآن فصاعداً

315
00:19:02,400 --> 00:19:05,350
...شيون، آسف لفرض هذا الإزعاج عليكِ

316
00:19:08,220 --> 00:19:11,680
أنا شيون، المرأة الّتي عيّنها
!للتوّ ريمورو-ساما

317
00:19:11,680 --> 00:19:13,920
سأدرِّب حتّى مجموعة من الضُّعفاء أمثالكم

318
00:19:13,920 --> 00:19:16,590
!لأجعل منكم نخبة المُحاربين

319
00:19:17,130 --> 00:19:18,800
!اطمئنّوا واتبعوني فحسب

320
00:19:19,100 --> 00:19:21,240
!حاضر! هذا ما أتمنّاه

321
00:19:21,240 --> 00:19:22,000
!عُلِم

322
00:19:22,000 --> 00:19:25,860
سوف أبذل قصارى جهدي في الالتزام
!بتعليماتكِ اعتباراً من الآن

323
00:19:25,860 --> 00:19:27,110
!ينطبِق نفس الأمر على نفسي

324
00:19:27,110 --> 00:19:29,800
لكن أوّلاً، هلّا أحضرتِ لي شيئاً آكله؟

325
00:19:29,800 --> 00:19:30,440
!بالتّأكيد

326
00:19:30,440 --> 00:19:33,650
!احرصوا على الالتزام بتعليماتي حرفيّاً

327
00:19:34,790 --> 00:19:36,160
هل أنت متأكّد من هذا؟

328
00:19:36,160 --> 00:19:37,920
دعيها تفعل ما تشاء

329
00:19:38,960 --> 00:19:41,400
!ا-انتظرنا عودتك

330
00:19:41,400 --> 00:19:45,320
!نُقسِم هاهنا بولائنا لسيّد الشّيطان ريمورو

331
00:19:45,690 --> 00:19:47,700
!نحن كذلك

332
00:19:48,040 --> 00:19:48,910
ماذا؟

333
00:19:49,130 --> 00:19:51,910
أعتقد كانوا يشاهدون تلك الجلبة

334
00:19:54,790 --> 00:19:58,470
سار ما تبقّى من المُقابلة الرّسميّة بسلاسة

335
00:20:01,790 --> 00:20:06,880
يُقال بأنّ الإيلف يعيشون لـ 500
إلى 800 عام، صحيح؟

336
00:20:06,880 --> 00:20:10,180
قد تكون شيخاً، لكن تبدو كشابّ

337
00:20:10,510 --> 00:20:13,360
شرف لي أن ألتقي بك

338
00:20:13,690 --> 00:20:15,440
لقد أتينا اليوم

339
00:20:15,440 --> 00:20:17,870
لنُهنِّئك ونشكرك في نفس الوقت

340
00:20:17,870 --> 00:20:18,780
تشكرونني؟

341
00:20:18,780 --> 00:20:21,530
...لكن لا أعتقد بأنّني التقيتُ بكم من قبل

342
00:20:22,040 --> 00:20:23,950
أقصد البقريّات والخيليّات

343
00:20:24,640 --> 00:20:27,720
،خاضوا حرباً دامت أكثر من قرن

344
00:20:27,720 --> 00:20:30,660
وعانت الغابة الّتي نقطن فيها بسببها

345
00:20:31,430 --> 00:20:33,960
،لاذت حيوانات ووحوش الغابة بالفرار

346
00:20:34,330 --> 00:20:36,440
ولا يمكننا زرع أي محصول

347
00:20:36,440 --> 00:20:39,380
وحتّى أنّ بعضنا غادر للعمل في دوارغون

348
00:20:39,380 --> 00:20:40,710
حقّاً؟

349
00:20:40,960 --> 00:20:43,980
لم يبقَ لنا خيار سوى التّفكير
،في ا لهجرة

350
00:20:43,980 --> 00:20:46,600
،لكن بالرُّغم من مساحة غابة جورا الكبيرة

351
00:20:46,600 --> 00:20:49,720
إيجاد مكان للهجرة إليه ليس أمراً بسيطاً

352
00:20:49,720 --> 00:20:51,720
هكذا إذاً

353
00:20:51,720 --> 00:20:58,020
لذا قرّرنا أن نُقدِّم عريضة لك
لتفعل شيئاً بشأن أولئك الأشقياء

354
00:20:58,020 --> 00:21:01,730
لكنّك أنزلتَ حكمك قبل أن نفعل ذلك حتّى

355
00:21:02,160 --> 00:21:05,480
...والآن، إذا استطعنا إيجاد مكان ننتقل إليه فقط

356
00:21:05,760 --> 00:21:07,740
...ماذا؟ انتظر لحظة

357
00:21:10,910 --> 00:21:12,680
كم عددكم هناك؟

358
00:21:12,680 --> 00:21:14,330
حوالي 300

359
00:21:14,650 --> 00:21:18,400
أيُّها الشّيخ، لديّ فكرة عن مكان
تنتقلون إليه

360
00:21:18,400 --> 00:21:21,370
!أحقّاً، جلالتك ريمورو؟

361
00:21:21,370 --> 00:21:24,080
أجل. يمكننا نقلكم جميعاً

362
00:21:24,080 --> 00:21:25,720
!شكراً جزيلاً لك

363
00:21:25,720 --> 00:21:27,050
،إذاً، حالما أعود إلى بَني جلدتي

364
00:21:27,050 --> 00:21:29,600
سوف أحضرهم إلى هنا أجمعين

365
00:21:30,000 --> 00:21:32,230
لكن أريدكم أن تتولّوا بضعة أعمال لأجلي

366
00:21:32,610 --> 00:21:33,960
!بكلِّ تأكيد

367
00:21:34,290 --> 00:21:38,230
إذا كانت القِوى الّتي نمتلكها
،نحن الإيلف نافعة لك

368
00:21:38,230 --> 00:21:40,170
!فلا يوجد ما يُبهجنا أكثر من ذلك

369
00:21:41,120 --> 00:21:46,160
والآن جُلّ ما أتمنّاه هو أن يعود
...أولئك الّذين تركونا قريباً

370
00:21:46,800 --> 00:21:48,070
تركوكم؟

371
00:21:48,390 --> 00:21:49,110
أجل

372
00:21:49,550 --> 00:21:52,880
،غادر بعض جماعتنا لكسب المال
لكن لم يعودوا بعدها أبداً

373
00:21:53,640 --> 00:21:55,810
نحن عِرق يُقدِّر التّضامُن

374
00:21:56,100 --> 00:21:58,750
لا أتحمّل فكرة تخلّيهم عن موطنهم

375
00:22:02,010 --> 00:22:04,760
اتِّخاذ إيلف كعبيد؟

376
00:22:04,760 --> 00:22:07,420
بعض النّاس لديهم أفكار قاسية جدّاً

377
00:22:09,580 --> 00:22:10,550
،سوي

378
00:22:10,800 --> 00:22:13,850
تحرَّ حول شخص يُدعى الفيكونت
كازاك في بلوموند

379
00:22:14,200 --> 00:22:14,750
عُلِم

380
00:22:19,760 --> 00:22:23,070
في اليوم الثّالث. شارف
...على الانتهاء أخيراً

381
00:22:23,070 --> 00:22:25,320
غيلد، هل عاد ديابلو أيضاً؟

382
00:22:25,320 --> 00:22:27,850
،أجل. حَظي باستراحة

383
00:22:27,850 --> 00:22:30,400
لذا سيتمكّن من رؤيتك في أسمى حالاتك

384
00:22:30,660 --> 00:22:31,730
!ريمورو-ساما

385
00:22:32,110 --> 00:22:34,500
!كالعادة، حضورك مليء بالوقار

386
00:22:34,500 --> 00:22:39,510
،أنا مُبتهج جدّاً لرؤيتك ثانية
!لدرجة أشعر أنَّ صدري سينفجر

387
00:22:39,510 --> 00:22:42,800
أردتُ أن أسمع تقريرك حول
...ما يجري في فالموث

388
00:22:43,220 --> 00:22:46,760
لكن يبدو أنّ مُقابلة اليوم قد تكون الأصعب

389
00:22:47,170 --> 00:22:50,530
...أقصد، إنّها مع

390
00:22:51,420 --> 00:22:53,150
عشيرة التّينغو

391
00:24:25,260 --> 00:24:27,650
"الحلقة القادمة، "مِحنة بينيمارو