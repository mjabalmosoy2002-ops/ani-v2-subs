1
00:00:03,280 --> 00:00:04,990
،"عندما قالوا "تينغو

2
00:00:04,990 --> 00:00:08,270
...كنتُ أتخيّل شيئاً كهذا

3
00:00:09,720 --> 00:00:11,640
"تينغو" تُكتَب بالكانجيّة لتعني "سماء" أو "كلب"

4
00:00:11,640 --> 00:00:15,490
لذا يُفترَض أن يكون عِرقاً هجينيّاً
وُلِدَ من ملائكة وذئاب

5
00:00:15,950 --> 00:00:16,990
إشعار

6
00:00:17,000 --> 00:00:19,480
على وجه التّحديد، إنّهم ليسوا عِرقاً هجينيّاً

7
00:00:19,480 --> 00:00:23,000
التّينغو هو تجسيد لملاك وجسد ذئب

8
00:00:23,290 --> 00:00:26,030
أجل، أجل. إنّهم عِرق تجسيديّ

9
00:00:26,030 --> 00:00:29,130
إشعار. بدقيق العبارة، إنّهم ليسوا عِرقاً

10
00:00:29,320 --> 00:00:32,870
،ملاك مُجسَّد بين عوام الأفراد

11
00:00:32,870 --> 00:00:35,130
مثل الفرد المعروف برانغا

12
00:00:35,560 --> 00:00:38,920
،الّتي أمامي الآن هي ابنة كبيرة التّينغو

13
00:00:38,920 --> 00:00:41,280
والمعروفة بإله الجبل

14
00:00:41,600 --> 00:00:43,800
تحيّاتي يا سيّد الشّيطان ريمورو

15
00:00:44,160 --> 00:00:46,700
أتيتُ بالنّيابة عن قائد التّينغو

16
00:00:46,700 --> 00:00:48,070
اسمي موميجي

17
00:00:48,490 --> 00:00:50,520
سررتُ بلقائك

18
00:02:28,760 --> 00:02:31,500
،بُعيد تأسيسنا السّلام مع هيناتا وطاقمها

19
00:02:31,500 --> 00:02:34,720
أرسلتُ فريقاً بقيادة بينيمارو إلى قرية
التّينغو في جبال كوشا

20
00:02:34,720 --> 00:02:39,290
للحصول على إذن لبناء طريق إلى ساريون

21
00:02:41,120 --> 00:02:42,040
لا بدّ أنّه هذا

22
00:02:46,370 --> 00:02:48,290
يبدو أنّه يوجد حاجز نُصِبَ حوله

23
00:02:49,430 --> 00:02:50,300
توقّف

24
00:02:53,160 --> 00:02:54,980
أشعر بإلمام بالفنون القتاليّة هنا

25
00:02:55,690 --> 00:02:58,590
بعد هذا المكان تقع قرية التّينغو المخفيّة

26
00:02:58,590 --> 00:02:59,870
ماذا تريدون؟

27
00:03:00,120 --> 00:03:03,360
أتيتُ كوسيط لسيّد الشّيطان
ريمورو من تيمبيست

28
00:03:05,640 --> 00:03:07,360
يمكنكما العبور

29
00:03:21,240 --> 00:03:22,360
...يا للهول

30
00:03:25,300 --> 00:03:27,710
إذاً "قريتهم المخفيّة" كانت في بُعد آخر؟

31
00:03:28,130 --> 00:03:29,720
لهذا لا يمكن العثور عليها

32
00:03:30,110 --> 00:03:30,860
من هنا

33
00:03:35,940 --> 00:03:37,280
يجب أن نبقى يقظين

34
00:03:37,780 --> 00:03:41,800
إنّهم بقدرة كاريون، إن لم يكن أفضل

35
00:03:42,740 --> 00:03:45,830
حسناً أيُّها المبعوث، ما شأنك هنا؟

36
00:03:46,290 --> 00:03:48,620
هل تسعون للسّيطرة على هذه البلد؟

37
00:03:50,200 --> 00:03:52,080
ليست نيّتنا كذلك

38
00:03:52,080 --> 00:03:55,370
نطلب فقط الإذن بالعبور من جبال كوشا

39
00:03:55,670 --> 00:03:59,440
وإن أمكن، نرغب بالحصول على إذن
لبناء نفق من خلالها

40
00:04:00,850 --> 00:04:03,580
ليست لديكم طموحات إقليميّة إذاً؟

41
00:04:04,040 --> 00:04:06,380
،إذا أردتم العبور، لا تحتاجون إذناً

42
00:04:07,290 --> 00:04:08,890
لكن ما هذا "النّفق" ألّذي تتحدّث عنه؟

43
00:04:09,360 --> 00:04:10,890
،لستُ متيقّناً بحدِّ ذاتي

44
00:04:10,890 --> 00:04:14,650
لكن قيل لي بأنّه سوف تُحفَر حفرة
عبر الجبال لتؤدّي إلى الطّرف الآخر

45
00:04:15,480 --> 00:04:16,300
انتظر

46
00:04:16,670 --> 00:04:18,280
حفر حفرة عبر الجبال؟

47
00:04:18,280 --> 00:04:19,730
هل أنت جادّ؟

48
00:04:19,980 --> 00:04:22,400
أجل، هذا ما أشارت إليه الخطّة

49
00:04:22,400 --> 00:04:25,200
لكن هذا لا صِلة له بالطّريق
الّذي ننوي السّفر عبره اليوم

50
00:04:25,200 --> 00:04:28,960
أردنا فقط التحقُّق من طُرُق السّفر المستقبليّة

51
00:04:29,270 --> 00:04:31,040
إن عارضتُم، فلن نفرض الأمر

52
00:04:31,350 --> 00:04:33,560
حفر حفرة في جبالنا المُقدّسة؟

53
00:04:33,560 --> 00:04:35,280
هل هذا مقبول حقّاً؟

54
00:04:35,280 --> 00:04:37,150
أنت تثير استيائي

55
00:04:37,150 --> 00:04:39,260
،حتّى لو أصبح الهُلام سيّد شيطان

56
00:04:39,260 --> 00:04:42,800
أردنا أن ندعه يفعل ما يشاء
ما دام يدعنا وشأننا

57
00:04:42,800 --> 00:04:47,540
وكنّا حتّى سنتجاهل تلك الأفعى
الّتي تفوح منها رائحة التوحُّش

58
00:04:48,040 --> 00:04:52,730
لكن لا يمكننا الجلوس مكتوفي الأيدي بينما
تُدنِّسون جبالنا المُقدّسة

59
00:04:52,980 --> 00:04:55,640
،"بـ"الأفعى الّتي تفوح منها رائحة التوحُّش
هل تقصدينني أنا؟

60
00:04:55,910 --> 00:04:56,940
—مهلاً، أنتِ

61
00:05:01,420 --> 00:05:03,030
خدعة عقيمة

62
00:05:03,520 --> 00:05:08,080
مثل هذه السّلوكيّات لا تؤثِّر
على ابنة كبيرة التّينغو

63
00:05:19,810 --> 00:05:21,010
هل انتهيتِ؟

64
00:05:21,400 --> 00:05:24,080
أعتقد أنّ الفرسان الوحوش الثّلاثة
ليسوا بالأمر الجلل في نهاية المطاف

65
00:05:24,450 --> 00:05:27,630
لا أنصحكِ بالاستهانة بي أيّتها المُتخلِّفة

66
00:05:27,630 --> 00:05:30,420
،تساهلتُ معكِ لأنّنا نحاول التّفاوض معكِ

67
00:05:30,420 --> 00:05:32,720
لكن ربّما لا حاجة لذلك؟

68
00:05:32,720 --> 00:05:35,520
تساهُل؟ أنا من ينبغي أن يقول لكِ ذلك

69
00:05:35,520 --> 00:05:38,840
أحرص بصراحة على عدم قتل مجرّد مبعوثة

70
00:05:39,430 --> 00:05:41,600
تحوّل الأمر إلى فوضى حقيقيّة

71
00:05:52,450 --> 00:05:53,770
هذا يكفي

72
00:05:54,320 --> 00:05:56,960
،أعتذر لأنّنا سبّبنا لكم الامتعاض

73
00:05:57,360 --> 00:05:59,620
لكن لا أسمح لكِ بقتل شريكتي

74
00:05:59,620 --> 00:06:03,030
!بـ-بينيمارو-ساما؟ هل تقصد بأنّني خسرت؟

75
00:06:03,030 --> 00:06:03,720
أجل

76
00:06:04,120 --> 00:06:06,880
لو لم أوقفها، لقطعتكِ إلى نصفين

77
00:06:06,880 --> 00:06:09,590
!هـ-هذا كذِب! تحفّظت

78
00:06:09,590 --> 00:06:12,260
لا، لم تتقني التحكُّم بهالتكِ

79
00:06:12,680 --> 00:06:14,520
بذلتِ قوّةً كبيرةً في هجمتكِ

80
00:06:14,520 --> 00:06:16,720
...لـ-لا

81
00:06:16,720 --> 00:06:19,040
كنتُ... لأخسر؟

82
00:06:19,560 --> 00:06:21,040
!أيّتها الفتاة الحمقاء

83
00:06:21,880 --> 00:06:24,020
!أ-أمّي؟

84
00:06:24,780 --> 00:06:27,110
اسمي كايدي

85
00:06:27,750 --> 00:06:30,080
سررتُ بلقائك يا سيّد بينيمارو

86
00:06:33,560 --> 00:06:35,840
يا كبيرة التّينغو، لا داعي لتُتعبي نفسكِ

87
00:06:35,840 --> 00:06:37,360
أردنا فقط إلقاء التّحيّة

88
00:06:38,940 --> 00:06:40,760
لا تقلق أيّها الشّابّ

89
00:06:41,220 --> 00:06:44,370
بغضّ النّظر عن ذلك، مهاراتك بالمُبارزة
بالسّيف كانت مُبهرة

90
00:06:44,820 --> 00:06:45,880
أسلوب السّديم؟

91
00:06:46,170 --> 00:06:46,990
...كيف

92
00:06:47,620 --> 00:06:49,660
لا، توقّعتُ هذا

93
00:06:50,000 --> 00:06:53,150
رقص الآنسة موميجي يُشبه حركات أسلوبي

94
00:06:53,600 --> 00:06:54,400
...هل كان ذلك

95
00:06:54,840 --> 00:06:55,780
أجل

96
00:06:56,040 --> 00:06:58,640
...تعلّمتُ أسلوب السّديم كذلك

97
00:06:58,640 --> 00:07:01,650
من مُعلّمي، بياكاويا أراكي

98
00:07:04,640 --> 00:07:06,680
،قبل أكثر من ثلاثمئة عام بقليل

99
00:07:07,280 --> 00:07:12,020
كنتُ أقيم في قرية الأوغر
لصقل مهاراتي بالسّيف

100
00:07:12,790 --> 00:07:15,370
كان لدى مُعلّمي، بياكويا، حفيد

101
00:07:16,160 --> 00:07:18,420
والّذي كان زميلي الأقدم في التّدريب

102
00:07:24,500 --> 00:07:27,910
كان ابن السّيف الّذي لا يمكن
وصفه إلّا بالأعجوبة

103
00:07:34,210 --> 00:07:38,360
لا شيء يزعجني أكثر من عدم"
"القدرة على منحك اسماً

104
00:07:38,780 --> 00:07:40,680
تِلك كانت الكلمات الّتي كان
يُردِّدها معلّمي بشكل متكرِّر

105
00:07:42,210 --> 00:07:44,480
لكن كان بياكويا أراكي بشريّاً

106
00:07:45,000 --> 00:07:47,170
إذا منح اسماً لعضو من عِرق
،الوحوش باستهتار

107
00:07:47,170 --> 00:07:49,510
فقد يفقد حياته

108
00:07:50,750 --> 00:07:53,370
في نهاية المطاف، تُوفِّي بياكويا
،عن عمر كبير

109
00:07:53,370 --> 00:07:57,440
والحفيد الّذي تركه قبل أن يرحل
صار يُعرَف بحكيم السّيف

110
00:07:58,130 --> 00:07:58,960
حكيم السّيف؟

111
00:08:02,040 --> 00:08:04,760
أعجبتُ بمهاراته بالسّيف

112
00:08:16,960 --> 00:08:18,920
مهلاً لحظة

113
00:08:18,920 --> 00:08:20,840
هل تقصدين هاكورو؟

114
00:08:21,220 --> 00:08:23,670
أتقول هاكورو؟

115
00:08:24,150 --> 00:08:24,960
هكذا إذاً

116
00:08:25,280 --> 00:08:27,600
إذاً حكيم السّيف حصل على اسم أخيراً

117
00:08:28,450 --> 00:08:30,020
...لا، المفاجأة الكبرى

118
00:08:31,080 --> 00:08:33,980
هي أنّه لا يزال على قيد الحياة

119
00:08:39,120 --> 00:08:42,720
مـ-مهلاً! هل يعلم هاكورو بهذا؟

120
00:08:45,640 --> 00:08:47,970
لكن طمأنني هذا

121
00:08:48,750 --> 00:08:51,670
لأنّ رجلاً وسيماً ربّاه السيّد هاكورو

122
00:08:51,670 --> 00:08:54,180
سيصبح زوج ابنتي

123
00:08:55,680 --> 00:08:57,560
!ا-انتظري يا أمّي

124
00:08:57,870 --> 00:08:59,730
حسناً يا سيّد بينيمارو

125
00:08:59,730 --> 00:09:02,750
سأقبل بكلّ جزء من مقترحك السّابق

126
00:09:03,000 --> 00:09:07,310
نرغب بضمّ أيدينا ليد سيّد الشّيطان ريمورو كذلك

127
00:09:07,800 --> 00:09:12,400
لكن فقط إذا وافقت على الزّواج من ابنتي

128
00:09:13,320 --> 00:09:14,350
!لحظة

129
00:09:14,350 --> 00:09:17,320
،أتفهّم بأنّكِ وافقتِ على هذا الرّجل

130
00:09:17,320 --> 00:09:19,660
!لكن لم أوافق عليه بعد

131
00:09:22,100 --> 00:09:25,250
...صحيح، يبدو أقوى منّي

132
00:09:25,740 --> 00:09:27,240
،لكن مع ذلك

133
00:09:27,240 --> 00:09:29,800
لا أريده أن يتزوّجني لأنّكِ أجبرتِه على ذلك

134
00:09:29,800 --> 00:09:32,270
!أريده أن يحبّني من تلقاء نفسه

135
00:09:33,550 --> 00:09:36,270
المرأة الجيّدة هي الّتي تجعل الرّجل
!الّذي تحبّه ينظر إليها

136
00:09:36,520 --> 00:09:38,270
هذا ما تقولينه دوماً، أليس كذلك؟

137
00:09:47,050 --> 00:09:48,860
أنا آسف لعدم قدرتي على إعطاء
إجابة مباشرة

138
00:09:49,220 --> 00:09:52,600
من فضلكِ اسمحي لي بالعودة
إلى المنزل والتّفكير باقتراحكِ

139
00:09:52,600 --> 00:09:55,430
أجل، استغرق وقتك في التّفكير

140
00:09:55,880 --> 00:09:58,940
لا تزال في الخامسة عشر من العمر

141
00:09:59,320 --> 00:10:00,990
في الوقت الرّاهن، أريد

142
00:10:00,990 --> 00:10:05,120
أن تكون العلاقة بين سيّد الشّيطان ريمورو
والتّينغو علاقة إيجابيّة

143
00:10:06,040 --> 00:10:10,370
رغم ما أبدو عليه، كلّ ما ينتظرني هو الموت

144
00:10:15,380 --> 00:10:18,240
لم أدرك بأنّ الكبيرة كايدي سقيمة

145
00:10:18,880 --> 00:10:21,130
لم تبدُ كذلك بصراحة

146
00:10:21,450 --> 00:10:23,070
لا أظنُّه مرضاً

147
00:10:24,510 --> 00:10:27,360
حملت موميجي في رحمها لفترة طويلة

148
00:10:27,360 --> 00:10:29,030
ومنحتها معظم قوّتها

149
00:10:29,660 --> 00:10:32,400
أنجبتها قبل خمسة عشر عاماً وسمّتها

150
00:10:32,720 --> 00:10:36,000
بعد كلّ ذلك، غالباً فقدت كافّة
الجُزيئات السّحريّتي الّتي أكسبتها

151
00:10:36,000 --> 00:10:37,650
"لقب "إله الجبل

152
00:10:38,020 --> 00:10:39,130
...هكذا إذاً

153
00:10:42,840 --> 00:10:44,070
...عزيزي

154
00:10:44,920 --> 00:10:49,520
ذلك الشّاب هو آخر بصيص
أمل منحتني إيّاه

155
00:10:50,270 --> 00:10:54,720
،آمل أن يصبح سنداً لابنتي قليلة الخبرة

156
00:10:55,320 --> 00:10:57,910
لكن إذا رفضَ ذلك، فليكُن

157
00:10:58,480 --> 00:11:02,460
أنت مع سيّد الشّيطان ريمورو الآن، صحيح؟

158
00:11:03,740 --> 00:11:07,030
ظننتُك ستموت قبلي

159
00:11:07,900 --> 00:11:09,730
كم أنا سعيدة لأنّني كنتُ مخطئة

160
00:11:14,250 --> 00:11:15,920
،عندما تنظر إليها

161
00:11:15,920 --> 00:11:19,610
هل ستتذكّر تلك الأيّام كذلك؟

162
00:11:21,650 --> 00:11:23,560
وهذا ما أوصلنا إلى اليوم

163
00:11:24,340 --> 00:11:26,980
أنا ريمورو، وأصبحتُ سيّد شيطان مؤخّراً

164
00:11:26,980 --> 00:11:29,180
،أنا من دُعاة السّلام

165
00:11:29,180 --> 00:11:31,500
،لذا إذا واجهتم أي مُشكلة
يمكنكم اللُّجوء إليّ

166
00:11:31,800 --> 00:11:34,120
لا ضرورة لهذا

167
00:11:34,120 --> 00:11:36,860
أتوقّع منك أن تكون حاكم
هذه الغابة مُعترفاً به

168
00:11:36,860 --> 00:11:39,270
وتصبح جاراً جيّداً لنا

169
00:11:39,720 --> 00:11:42,720
لكن لن نسمح لك بالتدخُّل في شؤوننا

170
00:11:43,740 --> 00:11:44,720
...بئس الأمر

171
00:11:46,520 --> 00:11:48,940
!لا تفعلي! بجدّية، توقّفي

172
00:11:51,840 --> 00:11:54,620
بئساً. تعلّمتْ شيون أن تكبح نفسها

173
00:11:55,120 --> 00:11:56,870
...لكن يبدو هذا مُخيفاً

174
00:12:01,310 --> 00:12:04,440
يبدو وكأنّها بالكاد تردع نفسها أيضاً

175
00:12:04,440 --> 00:12:07,550
حالما يستهين شخصٌ بقائد قليل
الخبرة، ينتهي أمره

176
00:12:08,000 --> 00:12:10,380
أتفهم هذا الشُّعور

177
00:12:11,000 --> 00:12:13,550
حسناً. لقد وضّحتِ موقفكِ

178
00:12:14,020 --> 00:12:15,160
،للتأكُّد فقط

179
00:12:15,160 --> 00:12:19,630
هل تعترفين أيضاً بالأورك الرّفيعين
الّذين هاجروا بالفعل إلى الجبال؟

180
00:12:19,630 --> 00:12:22,150
أجل، هذه ليست بمُشكلة

181
00:12:22,520 --> 00:12:25,600
،نحن لا نحتكر الحقّ باستخدام خيرات الجبل

182
00:12:25,600 --> 00:12:27,890
ويمكنهم فعل ما يشاؤون بالخام
الّذي يعثرون عليه

183
00:12:28,620 --> 00:12:31,920
نحن نمقت التدخُّل لا أكثر ولا أقلّ

184
00:12:32,310 --> 00:12:35,320
ما الّذي هي محتاطة منه إذاً؟

185
00:12:35,320 --> 00:12:39,640
في الواقع، لا ننوي إشعال أي حرب معكم

186
00:12:39,640 --> 00:12:41,440
وتريدني أن أُصدِّق ذلك؟

187
00:12:41,750 --> 00:12:42,400
أجل

188
00:12:42,630 --> 00:12:47,360
هل هناك سبب يجعلكِ تعتقدين
بأنّنا لدينا طموحات إقليميّة؟

189
00:12:48,160 --> 00:12:52,960
أنت وشعبك أصدقاء لتلك المرأة
الطّائر الماكرة فراي

190
00:12:52,960 --> 00:12:56,320
هذا هو الدّليل الوحيد الّذي لدينا
بأنّكم تريدون منطقتنا

191
00:12:56,320 --> 00:12:57,340
!وقت مستقطع

192
00:12:58,160 --> 00:12:59,300
ماذا يعني ذلك؟

193
00:12:59,300 --> 00:13:02,000
!أقصد امنحيني مهلة لاستشارة أعواني

194
00:13:04,520 --> 00:13:06,210
حسناً... ما رأيكم؟

195
00:13:06,210 --> 00:13:10,780
الإقليم الخاصّ بسيّدة الشّيطان السّابقة
فراي مرتبط بجبال كوشا

196
00:13:11,170 --> 00:13:14,800
لن يكون من المفاجئ أن يحدث
شرخ بينها وبين التّينغو

197
00:13:15,040 --> 00:13:16,240
هذا صحيح

198
00:13:16,240 --> 00:13:18,900
من المحتمل أنّها هاجمتهم

199
00:13:18,900 --> 00:13:21,480
لكن ما الهدف؟

200
00:13:21,730 --> 00:13:24,280
تفضِّل فراي-ساما الأماكن المرتفعة

201
00:13:24,280 --> 00:13:26,970
ربّما لهذا أرادت القاعدة الرّئيسيّة للتّينغو؟

202
00:13:26,970 --> 00:13:30,900
لا، لن تهاجمهم لأجل ذلك السّبب فقط

203
00:13:30,900 --> 00:13:33,800
قريتهم المخفيّة في بُعد آخر
على أيّ حال، أليس كذلك؟

204
00:13:33,800 --> 00:13:34,650
أجل

205
00:13:35,560 --> 00:13:39,000
!المعذرة! هلّا توقّفتم عن تجاهلي؟

206
00:13:39,880 --> 00:13:43,730
أقول بأنّ سيّدة الشّيطان فراي كانت
!تستهدف سُلالة الشّعوذة ساريون

207
00:13:44,120 --> 00:13:48,680
كانت تخطِّط لاستخدامنا كموطئ
!قدم لتحقيق ذلك

208
00:13:48,880 --> 00:13:49,300
ماذا؟

209
00:13:49,540 --> 00:13:51,670
ولماذا تطمع فراي-سان بساريون؟

210
00:13:52,270 --> 00:13:56,120
،لأنّ ساريون هي موطِن لمدينة في السّماء
في شجرة عملاقة

211
00:13:56,630 --> 00:14:00,940
كملِكة السّماء، كانت فراي مستميتة
للحصول عليها كقاعدة

212
00:14:01,310 --> 00:14:03,940
!ماذا؟ إذاً كان غيلد على حقّ؟

213
00:14:04,840 --> 00:14:08,300
يبدو أنّ سيّدة الشّيطان فراي
وساريون وقرية التّينغو

214
00:14:08,300 --> 00:14:11,300
وصلوا إلى طريق مسدود ثلاثي
الأطراف بشكل دائم

215
00:14:11,970 --> 00:14:15,570
،ثمّ اندلعت المعركة بيني وبين كلايمان

216
00:14:15,570 --> 00:14:20,650
وفجأة، أصبح كاريون وفراي
أتباع سيّدة الشّيطان ميليم

217
00:14:21,080 --> 00:14:23,180
كانت ولادة قوّة هائلة جديدة

218
00:14:23,960 --> 00:14:27,260
كان من المستحيل على التّينغو
،أن يواجهوا تلك القوّة بمفردهم

219
00:14:27,260 --> 00:14:30,760
لذا قضوا كلّ يوم يناقشون مسألة
كيف ينبغي لهم أن يتقدّموا

220
00:14:31,230 --> 00:14:33,980
تزامن ذلك مع ظهور بينيمارو
على عتبة بابهم

221
00:14:34,730 --> 00:14:37,970
كانت فكرة سيّئة إرسال آلبيس
من الفُرسان الوحوش الثّلاثة معه

222
00:14:38,650 --> 00:14:43,100
لا بدَّ أنّ موميجي أساءت الفهم وظنّت
أنّ هذا نوعاً من الضّغط الصّامت

223
00:14:43,770 --> 00:14:46,200
ما الّذي تخطِّط له فراي-سان الآن؟

224
00:14:46,200 --> 00:14:52,440
في الواقع، كانت فراي-ساما مسرورة جدّاً
بسبب مُخطّطاتك للمدينة العاصمة الجديدة

225
00:14:52,760 --> 00:14:54,060
هكذا إذاً

226
00:14:54,060 --> 00:14:58,400
لذا غالباً فقدت كلّ الاهتمام
بساريون وقرية التّينغو

227
00:14:58,400 --> 00:14:59,600
هذا ما أعتقده

228
00:14:59,880 --> 00:15:01,600
حسناً، كما سمعتِ

229
00:15:01,600 --> 00:15:04,300
بتِّ تفهمين الآن بأنّكِ كنتِ مُخطئة؟

230
00:15:05,280 --> 00:15:08,960
لا أصدِّق بأنّني كنتُ تحت
...الانطباع الخاطئ منذ البداية

231
00:15:13,960 --> 00:15:15,840
،بعد توضيح الالتباس

232
00:15:15,840 --> 00:15:18,040
انتهى نقاشنا بسرعة

233
00:15:18,370 --> 00:15:22,520
وافقنا على مساعدة بعضنا الآخر
في حال وقع أيّ الطرفين في مشكلة

234
00:15:23,100 --> 00:15:25,640
حسناً، أعتقد بأنّنا انتهينا هنا

235
00:15:25,640 --> 00:15:26,360
أجل

236
00:15:26,940 --> 00:15:32,110
نحن ممتنّون لك لأنّك جعلت
هذه المُفاوضات تصبّ في صالحنا

237
00:15:33,240 --> 00:15:36,920
وأيضاً، هذه من قائدتنا، الكبيرة كايدي

238
00:15:37,230 --> 00:15:39,480
رسالة لجلالته ريمورو

239
00:15:43,680 --> 00:15:44,790
تحيّاتي"

240
00:15:44,790 --> 00:15:51,090
آمل أن يمنحك طقس الرّبيع الجميل
مزيداً من الصّحة والازدهار

241
00:15:51,400 --> 00:15:54,030
حسناً، أكتفي بهذه المُقدّمة

242
00:15:54,030 --> 00:15:59,140
يسرّني أن أسمع بأنّك حيّ تُرزَق

243
00:16:01,530 --> 00:16:05,270
لا أستطيع المجيء لرؤيتك، لأنّني
،على فِراش المرض

244
00:16:05,270 --> 00:16:07,420
لذا أرسلتُ ابنتي بدلاً عنّي

245
00:16:07,420 --> 00:16:11,320
،يبدو أنّ سوء فهمها عقّد الأمور بالنّسبة لها

246
00:16:11,320 --> 00:16:13,590
"لكن أطلب منك أن تعاملها بلطف

247
00:16:13,590 --> 00:16:15,770
لحظة، هل هذه الرّسالة لي حقّاً؟

248
00:16:15,770 --> 00:16:17,570
!من الواضح أنّها ليست كذلك، صحيح؟

249
00:16:17,800 --> 00:16:23,800
وأيضاً تبجّحت بأنّها سوف تجعل"
"—السيّد بينيمارو يلتفت إليها، لذا هو

250
00:16:23,800 --> 00:16:25,480
!مـ-مهلاً يا أمّي

251
00:16:25,730 --> 00:16:27,840
!توقّعت! هناك رسالتان

252
00:16:27,840 --> 00:16:30,970
...أنتِ مستهترة جدّاً يا أمّي

253
00:16:30,970 --> 00:16:36,070
فهمت، تركت الرّسالة المُوجَّهة لهاكورو
في نفس ظرف الرّسالة المُوجّهة لي

254
00:16:31,920 --> 00:16:32,830
!مولاتي

255
00:16:32,840 --> 00:16:35,060
تمالكي نفسكِ! هل أنتِ بخير؟

256
00:16:35,060 --> 00:16:36,950
!مولاتي

257
00:16:38,320 --> 00:16:40,040
هذا هو طبعها

258
00:16:41,480 --> 00:16:42,480
!هاكورو

259
00:16:43,280 --> 00:16:47,230
عدتُ للتو من مملكة فالموث

260
00:16:52,770 --> 00:16:54,990
هكذا إذاً

261
00:16:55,240 --> 00:16:58,640
،لا أنكر بأنّ قوّتها عظيمة"

262
00:16:58,640 --> 00:17:00,750
لكن ما زالت تفتقر للمهارات

263
00:17:00,750 --> 00:17:04,440
،بصفتك زميلي الأقدم في التّدريب
،وبصفتك والدها

264
00:17:04,440 --> 00:17:09,750
"حكيم السّيف هاكورو، علّمها وأرشدها ودرّبها

265
00:17:10,490 --> 00:17:14,480
...إلى زوجي الحبيب، من كايدي". فهمت

266
00:17:15,270 --> 00:17:19,360
إذاً تلك المرأة الغبيّة لا تزال تحبّني؟

267
00:17:19,760 --> 00:17:22,750
وتريدني أن ألتقي بابنتي؟

268
00:17:23,960 --> 00:17:26,520
يسرّني أنّني عشتُ عمراً مديداً

269
00:17:27,080 --> 00:17:31,110
أ-أنت... أبي؟

270
00:17:31,390 --> 00:17:32,760
هذا صحيح

271
00:17:33,360 --> 00:17:37,030
أنا أبوكِ، هاكورو

272
00:17:40,280 --> 00:17:44,040
!أ-أبي

273
00:17:44,410 --> 00:17:48,200
موميجي، تدريبي قاسٍ جدّاً

274
00:17:48,720 --> 00:17:49,650
!حسناً

275
00:17:50,040 --> 00:17:53,090
لكن أتوقّع منكِ أن تتجاوزيه

276
00:17:53,090 --> 00:17:55,370
!وتكسبي قلب مولانا الشّابّ

277
00:17:55,370 --> 00:17:55,900
!سأفعل

278
00:17:55,900 --> 00:17:57,550
!ماذا؟

279
00:17:57,800 --> 00:17:59,940
!هاكورو! انتظر لحظة

280
00:17:59,940 --> 00:18:02,020
—لديّ مركزي لأضعه بعين الاعتبار هنا

281
00:18:02,020 --> 00:18:03,170
ما هذا؟

282
00:18:03,170 --> 00:18:06,160
لا تحبّ ابنتي يا مولايّ الصّغير؟

283
00:18:06,160 --> 00:18:08,310
!ليس هذا ما أقصده

284
00:18:08,310 --> 00:18:10,860
!أنت لا تعلم حتّى متى وُلِدت

285
00:18:10,860 --> 00:18:12,820
!لِمَ تتصرّف كأبٍ حنون الآن؟

286
00:18:12,820 --> 00:18:17,560
،الآن بعد أن علمتُ بأمرها
أنا المسؤول عنها

287
00:18:17,560 --> 00:18:19,460
إلى أين ستؤول هذه الأمور؟

288
00:18:19,460 --> 00:18:21,410
...لهذا السّبب

289
00:18:22,240 --> 00:18:25,380
أخي، أحمل رسالة من الآنسة آلبيس

290
00:18:25,380 --> 00:18:27,280
ما-ما الأمر؟

291
00:18:29,060 --> 00:18:32,740
بينيمارو-ساما، لقد اتّخذتُ قراري"

292
00:18:32,960 --> 00:18:37,140
أنوي الفوز على الآنسة موميجي
وأحظى بدور زوجتك الشّرعيّة

293
00:18:37,380 --> 00:18:41,370
أو في أسوأ الحالات، يمكنني دوماً
أن أكون محظيّتك

294
00:18:41,870 --> 00:18:44,920
"لن أستسلم، لذا حضّر نفسك

295
00:18:45,250 --> 00:18:47,360
بينيمارو، هل ستكون بخير؟

296
00:18:48,970 --> 00:18:51,030
!لـ-لقد مات

297
00:18:51,320 --> 00:18:55,020
من كان يتوقّع أن يكون لدى السيّد
بينيمارو نقطة ضعف كهذه؟

298
00:18:55,200 --> 00:18:59,070
من الصّعب حقّاً أن يكون المرء
محبوباً بواسطة كلّ الفتيات

299
00:18:59,070 --> 00:19:01,940
ريمورو-ساما، هل أنت جادّ؟

300
00:19:02,260 --> 00:19:04,280
لا أعتقد بأنّه يحقُّ لك أن تقول ذلك

301
00:19:04,280 --> 00:19:04,990
ماذا؟

302
00:19:07,390 --> 00:19:09,900
عيناي لا تريان سوى ريمورو-ساما

303
00:19:09,900 --> 00:19:12,030
لا نوايا عاطفيّة لديّ

304
00:19:12,030 --> 00:19:13,750
لم يسألك أحد

305
00:19:13,750 --> 00:19:16,850
بالفعل، السيّد بينيمارو ذو شعبيّة واسعة

306
00:19:17,340 --> 00:19:20,700
إحدى مُتدرِّبات أختي تضع
،نُصب عينيها عليه أيضاً

307
00:19:20,700 --> 00:19:25,260
لكن ستواجه وقتاً عصيباً في تجاوز
الآنستين موميجي وآلبيس

308
00:19:25,470 --> 00:19:26,710
تقصد توك؟

309
00:19:26,960 --> 00:19:30,600
لا، ليست توكا فقط. هناك سايكا كذلك

310
00:19:30,810 --> 00:19:31,960
!هذا صحيح

311
00:19:31,960 --> 00:19:36,600
سمعتُ بأنّ كلتيهما تخلّيتا عنك
من باب الاحترام لسوكا

312
00:19:36,600 --> 00:19:38,170
لا داعي للكلام الفارغ

313
00:19:38,170 --> 00:19:39,960
!لا، إنّها الحقيقة

314
00:19:39,960 --> 00:19:41,480
على مبدأ تعدُّد الزّوجات إذاً؟

315
00:19:41,480 --> 00:19:41,870
بالفعل

316
00:19:42,610 --> 00:19:43,970
...على ذكر ذلك

317
00:19:44,680 --> 00:19:47,340
آلبيس-سان هي الأخت الكبرى
المؤتمنة الحسناء

318
00:19:47,630 --> 00:19:50,970
موميجي هي الأخت الصّغرى الظّريفة اللّعوبة

319
00:19:51,350 --> 00:19:54,330
وكلّ الفتيات الأخريات اللّواتي
...يطمعن ببينيمارو

320
00:19:54,550 --> 00:19:56,330
!أشعر بغيرة شديدة

321
00:19:56,330 --> 00:19:59,490
!تعدُّد زوجات! كم أحسده

322
00:19:59,490 --> 00:20:01,320
ليس تماماً

323
00:20:01,610 --> 00:20:03,890
قد لا يبدو كذلك، لكن بينيمارو متأخِّر النّضج

324
00:20:03,890 --> 00:20:06,040
التّعامل مع النّساء ليس اختصاصه

325
00:20:06,040 --> 00:20:10,080
،يحاول دوماً أن يبدو الشّخص الرّزين
لكن أنا واثق بأنّه مُنبهِر تماماً

326
00:20:10,080 --> 00:20:12,150
،نظراً لمدى رجولة السيّد بينيمارو

327
00:20:12,150 --> 00:20:14,980
من الطبيعيّ أن تُعجَب به سيّدات البلدة

328
00:20:14,980 --> 00:20:17,230
بوسعي تعلُّم الكثير منه

329
00:20:17,230 --> 00:20:19,790
!لا، لا، الأفضل أن تبقى كما أنت يا سيّد غيلد

330
00:20:19,790 --> 00:20:23,060
كما كنتُ أقول من قبل، توكا وسايكا
لن تنظرا في وجهي حتّى

331
00:20:23,060 --> 00:20:26,120
!يبدو ظهر السيّد غابيرو قوياً ورجوليّاً

332
00:20:26,120 --> 00:20:28,580
!بالفعل! إنّه رجل بكل معنى الكلمة

333
00:20:29,050 --> 00:20:31,480
!سوف نتبعك دوماً يا قائد

334
00:20:31,480 --> 00:20:40,080
!غابيرو! غابيرو! غابيرو

335
00:20:33,910 --> 00:20:37,320
لسبب ما، كلّ أتباعي المُعجبين هم رجال

336
00:20:37,320 --> 00:20:40,240
هذا يعني أنّك لن تلتقي بأحد جديد أبداً

337
00:20:40,240 --> 00:20:42,360
أتفهّم هذا الشُّعور

338
00:20:42,360 --> 00:20:43,360
لا

339
00:20:43,360 --> 00:20:47,160
هناك طبيبات قزمات حيث أعمل

340
00:20:47,160 --> 00:20:49,100
!إذاً لا ينبغي أن تكون لديك مشكلة

341
00:20:49,100 --> 00:20:51,430
عمّاذا يتكلّمون حتّى؟

342
00:20:50,100 --> 00:20:51,860
لديّ مشكلات كثيرة في الواقع

343
00:20:51,860 --> 00:20:53,320
،دائماً ما يقلن

344
00:20:53,320 --> 00:20:56,760
!لا يمكنني أن أعيش مع سحليّة"
"!هذا مستحيل جسديّاً

345
00:20:56,760 --> 00:20:58,240
...هكذا إذاً

346
00:20:58,240 --> 00:21:00,440
...جدار النّوع سامٍ ورفيع

347
00:21:00,440 --> 00:21:04,260
ومع ذلك نانسو وهوكوسو يقومان
بدعوتهما للخروج

348
00:21:04,260 --> 00:21:08,610
على العشاء أو موعد غراميّ
في الغابة طوال الوقت

349
00:21:08,610 --> 00:21:10,210
!لا أتحمّل ذلك

350
00:21:10,210 --> 00:21:12,290
!جدار النّوع قد انهار

351
00:21:12,290 --> 00:21:14,710
...لـ-لا أعلم كيف أردّ على ذلك

352
00:21:14,710 --> 00:21:15,630
كلام فارغ

353
00:21:15,630 --> 00:21:17,950
أنت لا تُقدِم على أي تحرُّك بحدِّ ذاتك

354
00:21:17,950 --> 00:21:19,420
!سوي-كن، أصبت

355
00:21:19,420 --> 00:21:21,660
!أجل، سوي على حقّ

356
00:21:21,840 --> 00:21:25,580
فضلاً عن ذلك، النّساء يسهل
جذبهن أكثر ممّا تعتقد

357
00:21:25,580 --> 00:21:27,210
!ما-ماذا قلت؟

358
00:21:29,310 --> 00:21:31,360
كتلك الفارسة الّتي التقينا
بها في المرّة السّابقة

359
00:21:32,040 --> 00:21:33,600
!ماذا؟! ماذا؟
!ماذا تقول؟

360
00:21:33,600 --> 00:21:35,220
!هذا مُثير جدّاً للاهتمام

361
00:21:35,220 --> 00:21:37,210
!تفاصيل

362
00:21:37,210 --> 00:21:38,120
!أحم

363
00:21:39,350 --> 00:21:41,880
ريمورو-ساما، كفى مُزاحاً

364
00:21:41,880 --> 00:21:44,720
نحن نتحدّث عن أخي الآن

365
00:21:44,720 --> 00:21:45,600
...أجل

366
00:21:46,160 --> 00:21:49,610
بينيمارو، كيف هو شعورك حيال كلّ هذا؟

367
00:21:49,880 --> 00:21:51,520
...بصراحة

368
00:21:51,860 --> 00:21:54,410
أشعر بأنّه من المبكِّر جدّاً
،اتّخاذ قرار كهذا

369
00:21:54,410 --> 00:21:56,090
:لكن يمكنني أن أقول

370
00:21:56,630 --> 00:21:58,750
أحتاج زوجة واحدة فقط

371
00:21:59,760 --> 00:22:02,080
أعتقد لا تعدُّد زوجات إذاً

372
00:22:02,400 --> 00:22:03,650
!عُلِم

373
00:22:03,650 --> 00:22:08,620
!سأقبل بتحدِّي آلبيس وأحظى بدور زوجتك

374
00:22:10,010 --> 00:22:10,880
...شونا

375
00:22:11,490 --> 00:22:13,970
ريمورو-ساما، ماذا نفعل؟

376
00:22:13,970 --> 00:22:15,480
ما المانع؟

377
00:22:15,480 --> 00:22:17,670
لا أستطيع أن أدعهما تتنافسان
،في نِزال فرديّ

378
00:22:17,670 --> 00:22:21,150
لكن مجرّد بذل جهد لجعل من حبّ
...يلتفت نحوها ويعيرها اهتماما

379
00:22:21,680 --> 00:22:24,910
!فهمت! سيتمّ ذلك إذاً

380
00:22:25,280 --> 00:22:28,040
...لحظة، ماذا؟ يراودني إحساس سيّئ

381
00:22:31,550 --> 00:22:33,910
لن أخسر أيّتها الأميرة شونا

382
00:22:33,910 --> 00:22:36,790
هذا ما أريده تماماً يا شيون

383
00:22:37,440 --> 00:22:41,210
لا أعرف ما يجري، لكن أعتقد
!يجدر بي... الهرب

384
00:22:42,580 --> 00:22:45,040
،كما في ذلك اليوم في دولة الوحوش

385
00:22:45,040 --> 00:22:47,570
نشأ عرفٌ جديدٌ غريبٌ يسعى فيه المرء

386
00:22:47,570 --> 00:22:49,870
لجعل من يحبّ يلتفت نحوه

387
00:22:49,870 --> 00:22:53,000
"أمسى ذلك يُعرَف بـ"حُبّ وقتال

388
00:24:25,240 --> 00:24:27,670
"الحلقة القادمة، "بطل سرعة الضّوء