1
00:01:30,340 --> 00:01:33,980
ماذا تظنّ نفسك تفعل بأحد أتباع
!أعزّ أصدقائي؟

2
00:01:46,950 --> 00:01:49,140
!اللّعنة! ستدفع ثمنَ ذلك

3
00:01:51,480 --> 00:01:53,840
من تعتقدني بالضبط؟

4
00:01:53,840 --> 00:01:56,050
!أنا ناب الفهد الأسود فوبيو

5
00:01:56,470 --> 00:02:00,080
الأمر خارج سيطرتنا بوجودِ سيّدة الشيطان ميليم

6
00:02:00,430 --> 00:02:02,720
حتّى بالنسبة لسيّد الشيطان كاريون

7
00:02:02,880 --> 00:02:04,070
!أيّها الأحمق

8
00:02:04,070 --> 00:02:07,340
!ما كان كاريون-ساما ليذلّ نفسه هكذا

9
00:02:07,890 --> 00:02:09,940
أنا الذي لم يكن قويّاً فحسب

10
00:02:10,740 --> 00:02:15,990
لكن كبريائي لا يسمح لي بالعودةِ خالي الوفاض

11
00:02:17,430 --> 00:02:21,280
بنى أولئك بلدةً من تلقاء أنفسهم

12
00:02:21,920 --> 00:02:24,430
،اعتبرتُهم مجرّد وحوش وضيعة فقط

13
00:02:24,660 --> 00:02:27,690
لكن يمتلكون مهارات وتقنيّات حتّى نحن نفتقر لها

14
00:02:28,310 --> 00:02:29,740
هذا واضح

15
00:02:29,740 --> 00:02:31,860
،بدلاً من أمرِهم لخدمتِنا

16
00:02:31,860 --> 00:02:35,550
أودّ رؤية يورازانيا تؤسّس علاقات دبلوماسيّة معهم

17
00:02:35,850 --> 00:02:39,090
،نعم. حتّى لو لم تتدخّل سيّدة الشيطان ميليم

18
00:02:39,540 --> 00:02:41,680
يبقى تصرُّفي خاطئاً

19
00:02:42,160 --> 00:02:46,930
لم أكن لأستطيع كسب ثِقتهم من خلال السّيطرة
عليهم دون أن أتكلّم معهم أولاً

20
00:02:47,770 --> 00:02:49,320
لكن فات الأوان الآن

21
00:02:49,790 --> 00:02:53,890
قد تُشفى جروحي، لكن هذا الإذلال لن يزول

22
00:02:53,890 --> 00:02:56,560
،أريد الانتقام بطريقةٍ ما

23
00:02:56,560 --> 00:02:59,240
بحيث لا أسبّب المتاعب لكاريون-ساما

24
00:02:59,640 --> 00:03:03,530
...الكلام سهل، لكن الانتقام صعب

25
00:03:03,530 --> 00:03:06,660
!أعلم ذلك! أعلم تماماً أنّ ذلك لن يفلح

26
00:03:08,540 --> 00:03:11,330
!مع ذلك، لا أستطيع استيعاب ما حصل

27
00:03:15,820 --> 00:03:17,000
!مَن هناك؟

28
00:03:23,280 --> 00:03:30,100
!أتفهّم تماماً طبيعة الاِمتعاض الذي تشعر به

29
00:03:30,920 --> 00:03:32,860
!تحيّاتي أيُّها الناس الطيّبين

30
00:03:32,860 --> 00:03:35,480
اسمي فوتمان

31
00:03:35,940 --> 00:03:37,110
فوتمان؟

32
00:03:37,280 --> 00:03:39,530
،أنا عضو في حلف المهرّجين المعتدل

33
00:03:39,530 --> 00:03:43,420
ويطلقون عليّ المهرّج الإيمائي الغاضب فوتمان

34
00:03:43,890 --> 00:03:45,820
!من دواعي سروري أن أتعرّف عليكم

35
00:03:47,670 --> 00:03:50,080
لا تكونوا متّسمين بالحذر كثيراً

36
00:03:50,960 --> 00:03:54,290
!أنا تير، ولستُ عدوّتكم

37
00:03:54,750 --> 00:03:55,970
ماذا تريدان؟

38
00:03:58,320 --> 00:04:03,470
دُعيتُ إلى هنا بواسطة غضبك وكراهيّتك

39
00:04:03,910 --> 00:04:05,900
غضب وكراهيّة؟

40
00:04:06,440 --> 00:04:09,270
شعرتُ بعددٍ من موجاتِ الغضب

41
00:04:10,480 --> 00:04:14,680
من فضلِك أخبرني ما الذي أغضبك إلى هذا الحدّ

42
00:04:15,570 --> 00:04:18,760
أنا متيقّنٌ أنني أستطيع أن أخدمك

43
00:04:21,440 --> 00:04:26,140
سيّد فوبيو، لا حاجة للاستماع إلى هذين الشخصين

44
00:04:26,140 --> 00:04:27,660
هل أبعدهما عن وجهك؟

45
00:04:28,860 --> 00:04:32,700
نحن فُرسان الوحوش التابعون لملِك الوحوش
ونخدم سيّد الشيطان كاريون

46
00:04:32,700 --> 00:04:36,180
أوتظنُّ أنّ ماجين متجوّلاً نِدٌّ لأي شخصٍ منّا؟

47
00:04:36,640 --> 00:04:39,080
ترغبون في القوّة، أليس كذلك؟

48
00:04:39,080 --> 00:04:43,120
نحن نمتلكها... قوّة لم تشهدوا لها من قبل

49
00:04:44,180 --> 00:04:46,820
غير أنّ ذلك مصحوب بخطورة كبيرة بالطبع

50
00:04:46,820 --> 00:04:49,920
،لكن إذا اجتزتُم تلك الخطورة

51
00:04:49,920 --> 00:04:52,140
فالقوّة التي ستكتسبونها هائلة

52
00:04:53,160 --> 00:04:54,020
ماذا؟

53
00:04:54,370 --> 00:04:55,270
!سيّد فوبيو

54
00:04:55,800 --> 00:04:58,730
تريدون هزيمة سيّدة الشيطان ميليم، صحيح؟

55
00:04:58,730 --> 00:05:02,150
إذاً كلّ ما عليك هو أن تصبِح سيّد
!شيطان بحدِّ ذاتك

56
00:05:02,300 --> 00:05:04,530
!سيّد... شيطان؟

57
00:05:09,760 --> 00:05:14,160
سيّد شيطان؟ أتعتقدان أنّكما تستطيعان
خِداعي بهُراءٍ كهذا؟

58
00:05:14,450 --> 00:05:15,290
كاريبديس

59
00:05:19,970 --> 00:05:21,810
هل سبقَ وسمِعتَ به؟

60
00:05:22,380 --> 00:05:24,920
هل قلتَ... كاريبديس؟

61
00:05:26,680 --> 00:05:30,710
أجل، إذا امتلكتَ قوّةَ السّمكة الوحشيّة العملاقة
،الشرّيرة تلك

62
00:05:30,710 --> 00:05:33,220
...ستكون مُكافئاً لسيّد شيطان

63
00:05:33,220 --> 00:05:36,020
لكن إذا كنتَ لا تريدها فسوف نبحث
!عن شخصٍ ما يريدها

64
00:05:38,000 --> 00:05:39,560
!هيّا، لنذهب

65
00:05:40,950 --> 00:05:42,480
كم هذا مؤسف

66
00:05:42,760 --> 00:05:43,570
!انتظرا

67
00:05:45,570 --> 00:05:47,720
!سيّد فوبيو، لا ينبغي أن تفعل

68
00:05:48,120 --> 00:05:50,940
لم يرقْني كلّ هذا منذ البداية

69
00:05:50,940 --> 00:05:55,250
لماذا يتمُّ اختيار سيّد أورك فاشِل ليكون
سيّد شيطان؟

70
00:05:55,430 --> 00:05:56,810
!هذا هُراء

71
00:05:56,810 --> 00:06:00,340
...إذا احتاجوا سيّدَ شيطان جديد فأنا سوف

72
00:06:00,630 --> 00:06:05,340
سوف أصبح أقوى! حينئذ حتّى كاريون-ساما
!سيُسامحني بكلّ سرور

73
00:06:05,340 --> 00:06:06,830
...سيّد فوبيو

74
00:06:07,230 --> 00:06:08,470
!أخبراني بالمزيد

75
00:06:08,720 --> 00:06:11,860
توقّعتُ أن يتفهّم السيّد فوبيو الأمر

76
00:06:11,860 --> 00:06:16,600
!نعم، بالطبع! لا أحد أنسب منك ليكون سيّد شيطان

77
00:06:16,600 --> 00:06:20,350
من الخطأ فحسب أن يصبِح شخصٌ غير قويّ
سيّد شيطان، أليس كذلك؟

78
00:06:20,350 --> 00:06:22,060
!هذا ما أشعر به أيضاً

79
00:06:22,060 --> 00:06:24,730
!وبما أنّ الأمر كذلك فأنت مثاليّ للعمل

80
00:06:28,610 --> 00:06:31,920
وماذا تستفيدان من هذه الصّفقة؟

81
00:06:32,410 --> 00:06:33,650
ما هدفكما؟

82
00:06:33,650 --> 00:06:37,340
نريدك فقط أن تمنحنا معاملةً خاصّة حالما
!تصبح سيّد شيطان

83
00:06:37,340 --> 00:06:40,420
!نريدك أن تصنع لنا معروفاً أو اِثنين أيضاً

84
00:06:42,240 --> 00:06:46,440
فأساساً لا يمكننا إخضاع كاريبديس بمفردنا

85
00:06:46,440 --> 00:06:49,430
،تمكّنّا من إيجاد المكان الذي خُتِمَ فيه

86
00:06:49,430 --> 00:06:51,800
لكن يمكن القول أنّ الفرصة أمامنا ثمينة
ولا بدّ من اغتنامها

87
00:06:51,950 --> 00:06:55,180
!وقد صدفَ ووجدناك في الوقتِ الأنسب

88
00:06:56,180 --> 00:06:57,560
هكذا إذاً

89
00:06:57,560 --> 00:07:01,940
لكن لا أعلم فيما إن كنتُ قادراً على إخضاع
...كاريبديس أم لا

90
00:07:03,790 --> 00:07:06,810
إن كان هناك مَن يستطيع فعلها فهو
أنت يا سيّد فوبيو العظيم

91
00:07:06,810 --> 00:07:08,400
!ستكون بخير

92
00:07:09,380 --> 00:07:11,290
،إذاً عندما أصبح سيّد شيطان

93
00:07:11,290 --> 00:07:15,650
يريدان أن يكونا الشّخصين اللّذين يحظيان
!بالمجدِ كونهما أكثر مَن ساعداني؟

94
00:07:18,200 --> 00:07:21,130
حسناً، أقبل بعرضكما

95
00:07:26,240 --> 00:07:27,460
يمكنكم العودة

96
00:07:27,630 --> 00:07:29,030
!سيّد فوبيو

97
00:07:29,030 --> 00:07:31,090
أبلغوا عن كلّ ما حدث

98
00:07:31,400 --> 00:07:32,380
...لكن

99
00:07:32,860 --> 00:07:35,410
لا أستطيع تسبيب المتاعِب لكاريون-ساما

100
00:07:35,410 --> 00:07:39,390
قولوا له أنّني أستقيل من منصبي في فرسان
الوحوش وتركتُ الخدمة

101
00:07:40,170 --> 00:07:42,700
شكراً لكم على كلّ ما فعلتموه لأجلي

102
00:07:43,090 --> 00:07:44,650
...سيّد فوبيو

103
00:07:45,080 --> 00:07:49,900
سأصبِح مجزرة بحدِّ ذاتها وأجبر سيّدة الشيطان
ميليم على الاعترافِ بقوّتي

104
00:07:51,860 --> 00:07:53,160
عظيم

105
00:07:53,960 --> 00:07:56,390
سأبلغ كاريون-ساما

106
00:07:56,390 --> 00:07:59,650
لكن درجة قوّة كاريبديس مجهولة

107
00:07:59,650 --> 00:08:01,870
توخّ أقصى درجات الحذر

108
00:08:10,810 --> 00:08:13,200
سيّد فوبيو ليس أحمق

109
00:08:13,630 --> 00:08:16,320
،حتّى لو كان كاريبديس هناك

110
00:08:16,320 --> 00:08:18,500
أنا متأكّد أنّه يستطيع إخضاعه

111
00:08:23,710 --> 00:08:25,900
فلنمضِ في طريقِنا الآن

112
00:08:26,540 --> 00:08:30,520
،نعم. بتضافُر قوّتي وقوّة الكاريبديس معاً

113
00:08:30,520 --> 00:08:35,280
أراهن على أنني أستطيع تمريغ أنف
سيّدة الشيطان ميليم في التراب

114
00:08:36,690 --> 00:08:37,790
!هكذا هي المعنويات

115
00:08:37,790 --> 00:08:40,350
!نعم! سأشجِّعك

116
00:08:52,440 --> 00:08:54,680
!ما رأيكما بذلك؟! لقد ربِحت

117
00:08:54,680 --> 00:08:57,550
!أستطيع البقاء تحت الماء فترة أطول منكما

118
00:08:57,750 --> 00:08:59,850
لا، كنتُ أنا من ربح

119
00:09:00,010 --> 00:09:03,930
لا، كان ذلك بفارِق بسيط فقط لكن أنا من ربِح

120
00:09:04,130 --> 00:09:07,840
!ليس عدلاً ألّا تعترفا بالهزيمة يا شيون وشونا

121
00:09:07,840 --> 00:09:11,440
!حسناً إذاً، سنعيد الكرّة! لنحسم النتيجة

122
00:09:11,730 --> 00:09:13,780
موافقة. مرّة أخرى

123
00:09:13,780 --> 00:09:18,110
ليست فكرة سديدة أن نبقى تحت الماء
في الحمّام، لكن سنفعلها

124
00:09:18,110 --> 00:09:19,660
!استعداد... هيّا

125
00:09:22,130 --> 00:09:24,210
يبدو أنّهن يستمتعن

126
00:09:24,210 --> 00:09:26,930
ربّما كان ينبغي أن أذهب إلى ذلك الطّرف

127
00:09:26,930 --> 00:09:28,210
...لأنّه هنا لا يوجد سوى

128
00:09:29,060 --> 00:09:30,280
عجوز

129
00:09:31,510 --> 00:09:34,840
أنت، كم تنوي أن تبقى في هذه البلدة؟

130
00:09:34,840 --> 00:09:37,930
أما زلت غير مُقتنِع بأنّنا غير مؤذيين؟

131
00:09:38,120 --> 00:09:40,610
...ماذا؟ لا

132
00:09:40,610 --> 00:09:44,310
شكوكي بك قد ولّتْ منذ زمن طويل

133
00:09:44,480 --> 00:09:46,010
لماذا إذاً؟

134
00:09:46,010 --> 00:09:50,270
في الواقع، هذا المكان مريحٌ جداً فحسب

135
00:09:50,940 --> 00:09:53,160
لم أنل راحةً حقيقيّةً كهذه منذ زمن

136
00:09:53,160 --> 00:09:56,650
شعرتُ أنه سيكون من الجيّد التمهُّل والاسترخاء

137
00:09:56,900 --> 00:09:58,890
...يا رجُل

138
00:09:58,890 --> 00:10:05,020
سأرى بنفسي فيما إذا كنت حقّاً"
"حليفاً للبشر أم لا

139
00:10:05,460 --> 00:10:08,040
...تقول ذلك مُتظاهِراً بالرّوعة

140
00:10:08,900 --> 00:10:10,290
!إنّه لا يسمعني حتّى

141
00:10:10,480 --> 00:10:11,140
!أنت

142
00:10:11,140 --> 00:10:11,830
ماذا؟

143
00:10:12,200 --> 00:10:14,920
ماذا يجري مع يومو ورجاله على أي حال؟

144
00:10:15,250 --> 00:10:19,550
وعدتَ أن تساهم في جعلِهم يظهرون
كأبطال بالنيابة عنّي

145
00:10:19,910 --> 00:10:21,050
...آه

146
00:10:21,050 --> 00:10:22,850
!آه" ليست إجابة"

147
00:10:22,850 --> 00:10:25,020
!فقد غادر أولئك الأشخاص

148
00:10:25,370 --> 00:10:28,640
يريدون تكوين سمعة كأبطال في كلّ مكان

149
00:10:28,930 --> 00:10:30,920
لن تكون تلك مشكلة

150
00:10:31,290 --> 00:10:33,620
فقد انتهيتُ من ترتيب الأمور بالفعل

151
00:10:33,620 --> 00:10:34,780
حقّاً؟

152
00:10:34,780 --> 00:10:36,110
أجل

153
00:10:36,110 --> 00:10:40,160
فقد مهّدتُ الأساس لنشرِ الأنباء عن أنّهم

154
00:10:40,160 --> 00:10:42,030
،الأبطال الذين هزموا سيّد الأورك

155
00:10:42,290 --> 00:10:49,560
ونشر الإشاعة بأنّك وجماعتك وحوش غير مؤذيين
وقد ساعدتموهم

156
00:10:50,930 --> 00:10:53,250
حسناً. جيّد إذاً

157
00:10:54,000 --> 00:10:57,140
لعلّه يتراخى لكن أظنّه قد أنجز دوره

158
00:10:57,640 --> 00:11:00,180
حسناً، سأعود الآن

159
00:11:00,440 --> 00:11:01,720
كدتُ أنسى

160
00:11:01,720 --> 00:11:06,190
أودّ تهيئة طريق من هنا إلى مملكتك بروموند

161
00:11:07,340 --> 00:11:09,520
...ماذا؟ في الحقيقة

162
00:11:09,710 --> 00:11:11,900
،أشكرك على ذلك طبعاً

163
00:11:11,900 --> 00:11:14,150
لكن يُعَدّ هذا مشروعاً وطنيّاً على نِطاق واسع

164
00:11:14,580 --> 00:11:16,080
ستكون الميزانيّة هائلة

165
00:11:16,080 --> 00:11:17,530
!تماماً يا فيوز-كن

166
00:11:17,670 --> 00:11:19,370
كـ-كن؟

167
00:11:19,370 --> 00:11:23,910
سماعُك تناديني هكذا يُشعرني بالقلق بعض الشيء

168
00:11:24,130 --> 00:11:26,520
!لا تقلق بشأن ذلك يا فيوز-كن

169
00:11:26,970 --> 00:11:30,160
وجود طريق سيُسهِّل علينا أداء
العمل، أليس كذلك؟

170
00:11:30,490 --> 00:11:33,880
وبالطبع، سنتولّى العمل الجسديّ

171
00:11:34,450 --> 00:11:35,500
...لكن

172
00:11:35,500 --> 00:11:36,670
لكن؟

173
00:11:37,380 --> 00:11:40,990
،أريد بيع بضاعتنا لبلاد أخرى

174
00:11:40,990 --> 00:11:44,500
لذا أودُّ منك أن تعرّفني على شخص
يستطيع أن ينصحني بما أحتاجه

175
00:11:45,000 --> 00:11:47,770
!فهمت. هذه مسألة بسيطة

176
00:11:47,770 --> 00:11:49,000
جيّد، جيّد

177
00:11:51,780 --> 00:11:54,430
...ربّما كان ينبغي أن أذهب إلى هناك فعلاً

178
00:11:58,330 --> 00:11:59,380
أهو هنا؟

179
00:11:59,380 --> 00:12:00,440
!أجل

180
00:12:01,010 --> 00:12:05,730
إنّه غير حيّ بعد، لكن تعطّشه للدمار هائل

181
00:12:06,610 --> 00:12:10,100
مثل هذه العواطِف هي الطعام المُفضّل
المُطلَق لنا

182
00:12:10,100 --> 00:12:12,220
هكذا تمكّنا من إيجاده

183
00:12:13,000 --> 00:12:16,910
معك حقّ... يمكنني الشّعور بهالةٍ غريبة

184
00:12:18,530 --> 00:12:19,820
...كاريبديس

185
00:12:23,470 --> 00:12:25,840
،في الظروف العاديّة

186
00:12:25,840 --> 00:12:28,490
يتطلّب إحياء كاريبديس كثيراً من الجثث

187
00:12:28,490 --> 00:12:29,350
جثث؟

188
00:12:29,650 --> 00:12:33,640
كاريبديس هو كائن حيّ روحيّ

189
00:12:33,640 --> 00:12:36,400
،لاستخدام قوّته في هذا العالم

190
00:12:36,400 --> 00:12:39,150
على المرء أن يمنحه جسداً ملموساً

191
00:12:39,360 --> 00:12:41,490
فهمت. وبعد؟

192
00:12:41,970 --> 00:12:44,030
...دورك في كلّ هذا هو

193
00:12:46,360 --> 00:12:48,870
...لحظة، هل تقصد

194
00:12:49,390 --> 00:12:54,210
بـ"الإخضاع" نقصد أن تدُخل كاريبديس في جسدِك

195
00:12:54,450 --> 00:12:58,080
!وتتوحّد معه في كيان واحد

196
00:12:58,950 --> 00:13:00,610
في جسدي؟

197
00:13:01,110 --> 00:13:03,160
!وإن أردت الانسحاب فهذه فرصتك

198
00:13:03,620 --> 00:13:04,680
...لكن

199
00:13:04,680 --> 00:13:05,470
لكن؟

200
00:13:05,770 --> 00:13:09,220
قد لا يصمد هذا الختم فترة أطول

201
00:13:10,310 --> 00:13:12,390
وإن لم يصمد فماذا بعد؟

202
00:13:12,630 --> 00:13:16,060
سيُحيا في نهاية المطاف من تلقاء نفسه... ربّما؟

203
00:13:16,060 --> 00:13:17,850
لكنّه بحاجةٍ لجثث، صحيح؟

204
00:13:17,850 --> 00:13:20,330
،أجل، لكن رغم أنّه مختوم

205
00:13:20,330 --> 00:13:25,530
أنا متأكّدة أنّه قد يحصل على الجثثِ اللّازمة
لإحيائه من تلقاء نفسه

206
00:13:25,980 --> 00:13:29,550
!وإن فعل، فقد نموت فحسب

207
00:13:29,550 --> 00:13:30,910
!نعم، هذا صحيح

208
00:13:31,440 --> 00:13:35,160
إذا أحيا نفسه بنفسه فسيكون خارج
السّيطرة تماماً

209
00:13:35,340 --> 00:13:40,060
وبرغبةٍ خالِصة للتدمير، لن يتلقّى
الأوامر من أحد

210
00:13:40,780 --> 00:13:43,450
لهذا علينا أن نكسر الختم قبل أن يحيي نفسه

211
00:13:43,450 --> 00:13:46,260
ونحتكر قوّته لأنفسنا أوّلاً؟

212
00:13:47,320 --> 00:13:49,790
!نـ-نعم! تماماً

213
00:13:49,790 --> 00:13:51,110
!كم أنت بصير

214
00:13:51,720 --> 00:13:52,720
مُوافق

215
00:13:53,160 --> 00:13:56,680
ساجعل قوّة كاريبديس لي

216
00:14:04,990 --> 00:14:06,430
سأفعلها

217
00:14:07,040 --> 00:14:10,030
سأخضِع كاريبديس داخل جسدي

218
00:14:11,190 --> 00:14:14,320
!وأري سيّدة الشيطان الوقِحة ميليم تلك

219
00:14:18,850 --> 00:14:20,350
ها قد دخَل

220
00:14:20,350 --> 00:14:21,740
بالتأكيد

221
00:14:21,740 --> 00:14:26,100
إنه حقّاً تابع من أتباع كاريون، يمتلك
القوّة ويفتقر للعقل

222
00:14:26,100 --> 00:14:28,060
!أجل، كان ذلك سهلاً

223
00:14:30,980 --> 00:14:32,680
هل أنجِز هذا العمل الآن؟

224
00:14:33,100 --> 00:14:39,000
لم يطلب منّي كلايمان سوى إحياء كاريبديس
وإرساله نحو ميليم

225
00:14:40,490 --> 00:14:44,880
أعتقد لسنا بحاجةٍ لجثثِ التنّين الأدنى
التي جمعتُها بعد الآن

226
00:14:44,880 --> 00:14:49,460
لكن ما دمنا مستعدِّين، ليس هناك
!ما يدعو للقلق

227
00:14:56,750 --> 00:14:58,530
...ثقيل للغاية

228
00:15:00,990 --> 00:15:02,830
!صَيد وفير اليوم أيضاً

229
00:15:04,420 --> 00:15:06,550
!ميليم مذهلة حقّاً

230
00:15:06,550 --> 00:15:11,260
تستطيع تحديد مواقع الوحوش فوراً، لذا
!كان الصّيد سهلاً

231
00:15:12,460 --> 00:15:15,160
!كشف الوحوش أسهل شيء على الإطلاق

232
00:15:15,160 --> 00:15:16,770
!لدينا وليمة أخرى اللّيلة

233
00:15:17,030 --> 00:15:19,720
نعم، أحسنتِ صنعاً، أحسنتِ صنعاً

234
00:15:19,720 --> 00:15:21,900
في الواقع، كان عملاً مُجهِداً

235
00:15:22,300 --> 00:15:24,400
من يريد حمّاماً ومشروباً؟

236
00:15:24,610 --> 00:15:26,330
!أنا سأشرب

237
00:15:28,690 --> 00:15:29,820
!ميليم-ساما

238
00:15:31,410 --> 00:15:32,450
!مَن هناك؟

239
00:15:32,750 --> 00:15:33,690
!مهلاً

240
00:15:33,690 --> 00:15:35,080
!أمسكت بك

241
00:15:35,470 --> 00:15:36,410
...هذا الحضور

242
00:15:43,080 --> 00:15:44,520
تريني-سان؟

243
00:15:45,030 --> 00:15:46,960
...لا، ليست نفسها تماماً

244
00:15:47,160 --> 00:15:49,340
!إ-إنها حوريّة غابة

245
00:15:49,340 --> 00:15:50,980
...لم أرَ واحدة من قبل

246
00:15:52,640 --> 00:15:55,570
،أنا حوريّة الغابة ترايا

247
00:15:55,570 --> 00:15:57,350
أخت تريني الصّغرى

248
00:15:57,350 --> 00:15:59,020
!لديها أخت صغرى؟

249
00:15:59,020 --> 00:16:02,660
على أي حال، ما هذا الشّكل والهالة الخطيرة؟

250
00:16:03,290 --> 00:16:05,280
ثمّة أمر طارئ

251
00:16:05,640 --> 00:16:07,570
الكارثة تقترب

252
00:16:07,570 --> 00:16:08,690
كارثة؟

253
00:16:09,570 --> 00:16:13,360
لقد أُحيا وحش من فئة كارثة يُدعى كاريبديس

254
00:16:13,640 --> 00:16:14,860
كاريبديس؟

255
00:16:17,000 --> 00:16:19,660
عنفُه مُكافئ لعنف سيّد شيطان

256
00:16:20,150 --> 00:16:24,310
أخواتي وبمن فيهن تريني قد خرجن
،لعرقلةِ تقدّمه

257
00:16:24,310 --> 00:16:26,000
لكنّهن لسن ندّاً له

258
00:16:26,580 --> 00:16:29,660
ويبدو أنّ كاريبديس متوجّه

259
00:16:30,140 --> 00:16:31,550
إلى هذه البلاد

260
00:16:31,550 --> 00:16:32,170
!ماذا؟

261
00:16:34,920 --> 00:16:40,150
،شنّ حرب برّية مع كاريبيدس، حاكم السّماوات
هو أمر لا جدوى منه

262
00:16:40,760 --> 00:16:43,480
أتيتُ لأنصحكم بأن تدعِّموا خطوطكم الدفاعيّة

263
00:16:43,480 --> 00:16:47,410
وتحضّروا جيشاً قتاليّاً جويّاً في أسرع وقت مُمكن

264
00:16:50,640 --> 00:16:53,570
،وُلِد كاريبديس منذ زمنٍ بعيد جداً

265
00:16:54,080 --> 00:16:56,750
وقد مات وعاش مرّات عديدة

266
00:16:56,750 --> 00:16:59,330
،إنّه حاكِم سماوات عنيف

267
00:16:59,780 --> 00:17:02,940
هذا ما هو مُتوقَّع من ابن

268
00:17:03,300 --> 00:17:06,830
فيلدورا، حاكم الغابة وراعيها

269
00:17:07,100 --> 00:17:08,840
ابن فيلدورا؟

270
00:17:09,160 --> 00:17:14,840
نشأ كاريبديس من غيمةٍ من جزيئات
فيلدورا السحريّة

271
00:17:15,670 --> 00:17:19,360
هل يعني هذا أنّ كاريبديس وأنا أخوان تقريباً؟

272
00:17:19,990 --> 00:17:24,260
إذاً هو قادمٌ إلى هنا لأنّه يستهدفني؟

273
00:17:24,260 --> 00:17:28,140
...لعلّه اكتشف بأنّ فيلدورا داخلي

274
00:17:28,930 --> 00:17:33,550
عندما يُحيا كاريبديس فاعلم أنّه خطر
أعظم من خطر سيّد شيطان

275
00:17:33,980 --> 00:17:38,280
بخلافِ سيّد شيطان، هذا ليس خصماً
يمكننا الحديث عنه

276
00:17:38,520 --> 00:17:41,030
يمكن أن نطلق عليه وحشاً بلا عقل كذلك

277
00:17:41,410 --> 00:17:46,410
قيل بأنّه يستدعي وحوشاً شبيهة بالقرش
تُدعى ميغالودون

278
00:17:46,410 --> 00:17:50,670
من عالمِ الرُّوح لتنضمّ إليه في ثورانه

279
00:17:50,920 --> 00:17:54,670
...ماذا؟ يبدو هذا أسوأ من سيّد الأورك

280
00:17:54,980 --> 00:17:56,680
الوضع غاية في السّوء

281
00:17:57,040 --> 00:17:59,080
الميغالودون المُستدعاة خاصّته قد استخدمت

282
00:17:59,080 --> 00:18:03,430
جثثَ تنانين أدنى كانت قريبة لسبب مجهول ما

283
00:18:03,600 --> 00:18:04,430
ماذا؟

284
00:18:04,720 --> 00:18:06,450
عددهم ثلاثة عشر

285
00:18:06,870 --> 00:18:09,020
،إذاً هناك وحش واحد بسوء سيّد شيطان

286
00:18:09,020 --> 00:18:11,940
وثلاثة عشر قرش طائر استدعاهم؟

287
00:18:12,470 --> 00:18:14,830
أي مزحة هي هذه بالضبط؟

288
00:18:15,340 --> 00:18:17,450
ريمورو العظيم، ماذا نفعل؟

289
00:18:17,680 --> 00:18:19,110
...ماذا نفعل؟ أعني

290
00:18:21,120 --> 00:18:24,210
ألم تنسَ شيئاً هامّاً؟

291
00:18:24,210 --> 00:18:26,040
...ذلك الكاريبيدس الأحمق

292
00:18:27,040 --> 00:18:28,830
!ليس ندّاً لي

293
00:18:29,190 --> 00:18:30,750
!سأسحق مؤخّرته خلال وقت قصير

294
00:18:30,930 --> 00:18:32,710
!نعم! هذه إحدى الطُرُق

295
00:18:32,710 --> 00:18:35,430
لا يمكننا فعل ذلك

296
00:18:35,430 --> 00:18:37,630
هذه مشكلة تخصُّ بلدتنا

297
00:18:37,780 --> 00:18:40,010
!أيّتها السكرتيرة! لا ترفضيها لأجلي

298
00:18:40,170 --> 00:18:42,680
—ماذا؟ لكن أنا أعزّ

299
00:18:42,680 --> 00:18:43,810
معها حقّ

300
00:18:44,210 --> 00:18:47,230
من الخطأ الاعتماد عليكِ في كلّ شيء
فقط لكونكِ صديقة

301
00:18:47,870 --> 00:18:50,590
،عندما يكون ريمورو العظيم بأمسّ الحاجة لمُساعدة

302
00:18:50,590 --> 00:18:53,480
سنقدّر حتماً مساعدتكِ حينئذ

303
00:18:53,480 --> 00:18:55,920
!أنا بأمسّ الحاجة الآن فعلاً

304
00:18:57,840 --> 00:18:59,390
معهما حقّ يا ميليم

305
00:18:59,390 --> 00:19:01,370
ثِقي بي فحسب

306
00:19:03,070 --> 00:19:08,330
...وأنا التي ظننتُ... أنّني حظيتُ بفرصتي لأتألّق أخيراً

307
00:19:08,560 --> 00:19:11,040
بالفعل، يبدو أنّه يستهدفني

308
00:19:11,040 --> 00:19:13,560
لا أستطيع الاعتماد على ميليم كثيراً

309
00:19:15,900 --> 00:19:18,460
!ابدأوا التّحضير لهزيمةِ كاريبديس

310
00:19:18,710 --> 00:19:19,720
!حاضر

311
00:19:20,020 --> 00:19:25,580
أردتُ أن أري أعزّ صديق لي ما يمكنني فعله

312
00:19:21,610 --> 00:19:23,250
تهزمه؟

313
00:19:23,850 --> 00:19:26,300
هل أنت متأكّد أنّك فهِمت الأمر؟

314
00:19:26,850 --> 00:19:30,850
أنت تواجه وحشاً حتّى حوريّات الغابة
لم يستطعن إيقافه

315
00:19:31,590 --> 00:19:35,110
يمكننا الاعتماد على الدّعم من الملِك غازيل
بما أنّنا وقّعنا تلك المُعاهدة

316
00:19:35,110 --> 00:19:36,860
سنفعل كلّ ما يمكننا فعله فقط

317
00:19:37,950 --> 00:19:39,400
لن تهرب؟

318
00:19:39,800 --> 00:19:41,420
وما الفائدة؟

319
00:19:41,420 --> 00:19:43,760
أنا الأقوى في هذا البلد

320
00:19:45,660 --> 00:19:50,370
إذا بدا أنّني لا أقدر عليه فسأهرب
،وأفكّر في خطّة جديدة

321
00:19:50,370 --> 00:19:55,170
لكن خِلاف ذلك، ينبغي أن أرى قوّته
بأمّ عيني، صحيح؟

322
00:19:57,250 --> 00:19:58,680
هكذا إذاً

323
00:19:58,680 --> 00:20:01,220
أنت فعلاً قائد الوحوش

324
00:20:01,560 --> 00:20:06,110
لسنا كالبشر الذين ينتهي أمرهم حالما
يخسرون ملكَهم

325
00:20:06,690 --> 00:20:08,350
لكن أتعلم؟

326
00:20:08,720 --> 00:20:13,470
أنت تفكّر مثلما نفكّر نحن البشر

327
00:20:13,470 --> 00:20:15,860
من الصّعب اعتِبارك وحشاً

328
00:20:16,070 --> 00:20:18,940
...ربّما

329
00:20:18,940 --> 00:20:23,860
قد يكون من الصّعب التصديق، لكن كنتُ
في الواقع بشريّاً

330
00:20:24,330 --> 00:20:26,410
تعرف أمرَ شيزو-سان، صحيح؟

331
00:20:26,680 --> 00:20:30,120
أنا من عالمٍ آخر مثلما كانت هي تماماً

332
00:20:30,870 --> 00:20:32,460
...متُّ في عالمي

333
00:20:34,750 --> 00:20:38,000
ووُلِدتُ من جديد كهُلام

334
00:20:39,760 --> 00:20:40,840
...شيزو

335
00:20:42,460 --> 00:20:47,170
ائتمنتني شيزو-سان على كلّ شيء
كشخصٍ من نفس الوطن

336
00:20:47,790 --> 00:20:51,800
واكتسبتُ هذا الشكل بالمُقابِل بعد أن ورثت إرادتها

337
00:20:54,130 --> 00:20:58,060
لا يجوز أن أرتكب أخطاء سخيفة بهيئة
شيزو-سان، صحيح؟

338
00:20:58,820 --> 00:21:00,150
...هكذا إذاً

339
00:21:00,150 --> 00:21:03,280
إذاً ريمورو هو حقّاً شخص يمكننا الوثوق به

340
00:21:05,100 --> 00:21:07,360
فضلاً عن أنّني قطعتُ وعداً لها

341
00:21:07,360 --> 00:21:08,620
وعد؟

342
00:21:08,920 --> 00:21:13,090
بأنّني سأتخلّص من المشاعر التي تقيّد قلبَها

343
00:21:15,480 --> 00:21:17,880
فريستي هي سيّد الشيطان ليون

344
00:21:18,110 --> 00:21:19,380
!سيّد الشيطان ليون؟

345
00:21:19,380 --> 00:21:21,120
!هـ-هو؟

346
00:21:21,120 --> 00:21:24,620
لا يمكنك أن تطلق على شخصيّة بارزة
"مثله بـ"الفريسة

347
00:21:24,620 --> 00:21:27,390
،مُقارنة بسيّد الشيطان ليون

348
00:21:27,390 --> 00:21:30,890
أعتقد أنّ مُواجهة كاريبديس أسهل... ربّما؟

349
00:21:31,100 --> 00:21:32,090
أجل

350
00:21:32,090 --> 00:21:33,930
فسيّد الشيطان ليون يأتي بعده

351
00:21:34,580 --> 00:21:36,520
الأولويّة لكاريبديس

352
00:21:38,280 --> 00:21:40,520
كانت معركة على وشك أن تبدأ

353
00:21:42,100 --> 00:21:44,360
،عاصمة اتّحاد جورا تيمبيست

354
00:21:44,360 --> 00:21:46,050
،مدينة ريمورو

355
00:21:46,050 --> 00:21:48,760
ودولة دوارغون المُسلّحة

356
00:21:49,410 --> 00:21:50,120
...الخصم هو

357
00:21:59,990 --> 00:22:02,320
كاريبديس من فئة كارِثة

358
00:23:35,860 --> 00:23:38,500
"الحلقة القادمة، "كاريبديس