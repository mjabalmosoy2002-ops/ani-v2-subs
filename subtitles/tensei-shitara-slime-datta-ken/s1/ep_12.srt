1
00:00:01,040 --> 00:00:05,940
يا حاكِم الوحوش، وكلّ المُوالين له

2
00:00:05,940 --> 00:00:08,480
سامحوني على هذه الزيارة المُفاجِئة

3
00:00:08,800 --> 00:00:12,340
اسمي تريني، حورية غابة

4
00:00:12,800 --> 00:00:14,670
سُرِرتُ بلقائكم

5
00:00:15,460 --> 00:00:19,420
ريمورو تيمبيست، يا حاكِم الوحوش، أودُّ منك

6
00:00:19,420 --> 00:00:23,420
أن تهزم سيّد الأورك

7
00:02:03,760 --> 00:02:05,720
أهزم سيّد الأورك؟

8
00:02:06,240 --> 00:02:08,980
المعذرة... تطلبين منّي أنا؟

9
00:02:09,700 --> 00:02:11,480
أجل، هذا صحيح

10
00:02:12,150 --> 00:02:16,050
هذا طلبٌ أنانيٌّ جدّاً من شخص
،ظهرت فجأة

11
00:02:16,640 --> 00:02:18,650
حوريّة الغابة تريني

12
00:02:19,660 --> 00:02:21,280
لماذا أتيتِ إلى هنا؟

13
00:02:21,700 --> 00:02:24,160
هناك أجناس أقوى بكثير من الغوبلن

14
00:02:25,730 --> 00:02:27,290
أجل، هذا صحيح

15
00:02:27,840 --> 00:02:30,060
،لو كان موطِن الغيلان بكامل قوّته

16
00:02:30,060 --> 00:02:31,980
لكنتُ قد ذهبتُ إلى هناك ربّما

17
00:02:32,890 --> 00:02:35,880
،لكن حتّى لو كنتُ قد فعلتُ ذلك

18
00:02:35,880 --> 00:02:39,600
فهذا لن يمنعني من تجاهُل وجود
هذا الشّخص

19
00:02:41,430 --> 00:02:44,480
،فلو هوجِمَتْ مستوطنتنا بواسطة سيّد الأورك

20
00:02:44,910 --> 00:02:47,320
فلا أمل لحوريّات الغابة بمُقاتلته بمُفردهن

21
00:02:47,950 --> 00:02:52,240
لهذا السّبب أتيتُ لأطلب المُساعدة
من شخصٍ قويّ

22
00:02:52,240 --> 00:02:57,730
الفكرة هي أنّ وجود سيّد الأورك بحدّ
...ذاته ما زال نظريّة بالنسبة لنا

23
00:02:58,650 --> 00:03:02,990
لدى حوريّات الغابة معرِفة بكل ما يجري
جوهريّاً في هذه الغابة

24
00:03:03,650 --> 00:03:05,870
سيّد الأورك موجود

25
00:03:10,360 --> 00:03:12,460
...بما أنّ حوريّة غابة أكّدت ذلك

26
00:03:12,460 --> 00:03:14,790
فلا بدّ وأنّه صحيح إذاً

27
00:03:21,330 --> 00:03:23,090
أمهليني بعضاً من الوقتِ لأجيب

28
00:03:23,440 --> 00:03:25,290
،سأسانِد الكيجين

29
00:03:25,290 --> 00:03:28,050
لكن لا أريد أن أثير الأمور بلا سبب

30
00:03:28,050 --> 00:03:30,770
دعيني أفكّر بما يتوفّر لدينا من معلومات
قبل أن أجيب

31
00:03:31,050 --> 00:03:33,650
رغم أنّ مظهري لا يوحي بذلك، أنا القائد هنا

32
00:03:45,650 --> 00:03:47,330
لنتابع المُؤتمر

33
00:03:47,860 --> 00:03:52,060
هل من أحد لديه أفكار بشأن هدف الأورك؟

34
00:03:54,340 --> 00:03:57,310
...ثمّة شيء واحد يخطر على البال

35
00:03:57,310 --> 00:03:58,030
حسناً

36
00:03:58,990 --> 00:04:03,610
سوي، هل تحرّيتَ في قريتنا؟

37
00:04:04,180 --> 00:04:04,950
أجل

38
00:04:05,950 --> 00:04:10,300
بحسبِ ردّة فعلك، أظنّك لم تجد شيئاً؟

39
00:04:10,680 --> 00:04:11,400
صحيح

40
00:04:12,260 --> 00:04:16,410
ولا واحد ينتمي لبَني جلدتنا أو للأورك

41
00:04:18,060 --> 00:04:19,150
ولا واحد ماذا؟

42
00:04:19,730 --> 00:04:20,650
جثّة

43
00:04:22,550 --> 00:04:25,740
لم نفهم كيف كانوا يؤمّنون المؤن اللّازمة

44
00:04:26,040 --> 00:04:28,770
لإطعامِ جيش قوامه 200.000

45
00:04:29,670 --> 00:04:31,610
...هل تعني

46
00:04:32,440 --> 00:04:33,750
...المهارة الفريدة

47
00:04:34,350 --> 00:04:35,600
مُجوَّع

48
00:04:36,820 --> 00:04:38,200
مُجوَّع؟

49
00:04:40,740 --> 00:04:43,500
،إنّها مهارةٌ يُولَد بها سيّد الأورك

50
00:04:43,920 --> 00:04:47,220
والذي هو كارِثة تجلب الفوضى للعالم

51
00:04:47,660 --> 00:04:51,310
،يطالُ تأثيرها كلّ من يخدمون تحت جناحه

52
00:04:48,430 --> 00:04:54,690
!اِدعسوا كلّ شيء! اِدعسوا كلّ شيء! اِدعسوا كلّ شيء

53
00:04:51,730 --> 00:04:54,380
لتجعلهم يلتهمون كلّ شيء مثل الجراد

54
00:04:55,200 --> 00:04:58,440
وفي ذاتِ الوقت، يلتهمون قوّة
،وقدرات الضحيّة

55
00:04:59,060 --> 00:05:01,070
ليجعلوها غذاءً لهم

56
00:05:01,070 --> 00:05:04,320
!قوّة هذا الزميل الذي نأكله هي لنا الآن

57
00:05:04,700 --> 00:05:08,070
!قوّة هذه الفريسة التي نأكلها هي لنا الآن

58
00:05:10,820 --> 00:05:13,330
إنّها شبيهة جدّاً بمهارة المُفترِس خاصّتك

59
00:05:16,150 --> 00:05:18,090
،مُقابِل اكتسابهم مهارة مُجوَّع

60
00:05:18,090 --> 00:05:20,210
يشعرون بجوعٍ شديد ودائم

61
00:05:20,640 --> 00:05:23,300
يستمرّ الأورك بالتقدُّم بلا هدف آخر

62
00:05:23,660 --> 00:05:26,250
سوى إشباع جوعهم الأبديّ واكتساب
مزيد من القوّة

63
00:05:26,860 --> 00:05:30,390
هذه هي أمنيةُ ملكهم الوحيدة

64
00:05:34,950 --> 00:05:38,260
إذاً هدف الأورك ليس القضاء

65
00:05:38,260 --> 00:05:41,330
على أجناس الغابة الأقوى، الغيلان
،ورجال السّحالي

66
00:05:41,330 --> 00:05:44,570
إنّما سرقة قِواهم؟

67
00:05:49,820 --> 00:05:52,140
،حسناً، إن كان الأمر كذلك

68
00:05:52,140 --> 00:05:54,580
فلا يمكنني القول أنّنا بمأمن

69
00:05:54,790 --> 00:05:57,970
لدينا ذِئاب العاصفة والكيجين والهوبغوبلن

70
00:05:57,970 --> 00:06:02,500
وبغضّ النّظر عن النَّكهات، كلّها وجبات
ذات قوى يقتل الأورك لأجلها

71
00:06:03,140 --> 00:06:06,760
ألمَ تنسَ أهمّ وجبة سوف تجذبهم؟

72
00:06:07,880 --> 00:06:10,440
لدينا الهُلام الأقوى هنا، أتذكر؟

73
00:06:10,440 --> 00:06:11,600
أين؟

74
00:06:15,780 --> 00:06:16,590
ماذا؟

75
00:06:18,660 --> 00:06:22,280
بالإضافةِ إلى ذلك، تأكّدنا من أنّ
ماجين ما

76
00:06:22,280 --> 00:06:24,820
هو المسؤول عن ظهورِ سيّد الأورك

77
00:06:25,510 --> 00:06:28,600
أظنُّه شخصاً لا تتمنّى تجاهله

78
00:06:29,910 --> 00:06:31,440
ماجين؟

79
00:06:32,320 --> 00:06:35,060
فهو تابِع لسيّد شياطين في نهايةِ المطاف

80
00:06:39,130 --> 00:06:43,020
لديهم معرفة بكلّ ما يجري في الغابة إذاً؟

81
00:06:43,460 --> 00:06:45,050
هذه الآنسة فطِنة

82
00:06:51,850 --> 00:06:53,550
ريمورو تيمبيست المُوقَّر

83
00:06:56,380 --> 00:06:59,440
أطلب منك ثانيةً أن تهزم سيّد الأورك

84
00:06:59,880 --> 00:07:02,490
بصفتِك الشّخص الذي تلقّى حِماية
،تنِّين العاصِفة فيلدورا

85
00:07:02,490 --> 00:07:06,570
،وأخضع الذّئاب الجائعة، وأصبح داعِم الكيجين

86
00:07:06,890 --> 00:07:09,500
فأنت حتماً ندٌّ وأكثر لسيّد الأورك

87
00:07:12,160 --> 00:07:15,580
ما رأيك أيُّها الحكيم العظيم؟
أيمكنني الوثوق بها؟

88
00:07:15,850 --> 00:07:19,050
حوريّات الغابة هُنّ راعيّات
غابة جورا العظيمة

89
00:07:19,050 --> 00:07:22,490
يُقال بأنّهن اللّواتي يطبِّقن العدالة
السماويّة على الأشرار

90
00:07:22,490 --> 00:07:24,920
وعلى أي شخص يحاول أن يضرّ الغابة

91
00:07:25,890 --> 00:07:28,100
العدالة السماويّة؟

92
00:07:28,500 --> 00:07:30,840
لكن هناك 200.000 منهم

93
00:07:31,400 --> 00:07:32,940
!سيفعل بالطبع

94
00:07:32,940 --> 00:07:36,140
!سيّد الأورك ذاك ليس ندّاً لريمورو العظيم

95
00:07:36,360 --> 00:07:38,890
تتّفقين معي إذاً؟

96
00:07:38,890 --> 00:07:39,770
!أجل

97
00:07:39,770 --> 00:07:42,310
...معقول؟ هل قامتْ للتو

98
00:07:47,860 --> 00:07:51,640
حسناً. سأقبل بطلب هزيمة سيّد الأورك هذا

99
00:07:51,640 --> 00:07:53,240
جميعكم معي في هذا الأمر

100
00:07:53,690 --> 00:07:56,530
!بالطبع يا ريمورو العظيم

101
00:07:56,780 --> 00:07:58,910
كانت تلك خطّتنا من البداية

102
00:07:59,430 --> 00:08:02,960
نؤمن بك ونحن معك. هذا كل ما نحتاجه

103
00:08:02,960 --> 00:08:04,670
!تماماً

104
00:08:04,670 --> 00:08:07,210
!لنرِهم كم نحن أقوياء

105
00:08:07,560 --> 00:08:08,800
!نعم

106
00:08:13,370 --> 00:08:17,100
تصرّفت بعنجهيّة، لكن ماذا لو خسرنا؟

107
00:08:24,040 --> 00:08:27,360
،إن كنّا سنواجه جيشاً قوامه 200.000 أورك

108
00:08:27,510 --> 00:08:31,490
فأشعر وكأنّنا ينبغي أن نفكّر بحلف
،مع رجال السّحالي

109
00:08:31,490 --> 00:08:33,990
...لكن نظراً للشخص الذي أرسلوه ليمثّلهم

110
00:08:34,320 --> 00:08:36,780
!أنا غابيرو

111
00:08:38,600 --> 00:08:41,980
...أودُّ أن أتكلّم مع شخص مستعدّ للإصغاء

112
00:08:42,460 --> 00:08:43,440
ريمورو العظيم

113
00:08:44,420 --> 00:08:48,100
هل تمانع أن أتكلّم شخصيّاً مع
زعيم الرّجال السّحالي؟

114
00:08:48,100 --> 00:08:50,380
سوي؟ يمكنك فعل ذلك؟

115
00:08:50,380 --> 00:08:51,170
أجل

116
00:08:52,420 --> 00:08:55,130
!يا إلهي كم هو واثِق! يا له من جذّاب

117
00:08:56,140 --> 00:08:57,560
حـ-حسناً إذاً

118
00:08:57,560 --> 00:09:00,640
سنتحالفُ مع الرّجال السّحالي ونهاجم الأورك

119
00:09:00,840 --> 00:09:01,590
!حاضر

120
00:09:02,640 --> 00:09:06,620
ستجري هذه المعركة على الأرجح في
المُستنقعات التي يقطنها الرّجال السَّحالي

121
00:09:07,180 --> 00:09:10,960
سيكون تعاون الرّجال السّحالي أساسيّاً
لعملٍ كهذا

122
00:09:10,960 --> 00:09:12,610
أعتمد عليك يا سوي

123
00:09:12,950 --> 00:09:14,000
سيتمّ ذلك

124
00:09:16,350 --> 00:09:20,920
...آمل ألّا يكون زعيمهم غبيّاً مثل غابيرو

125
00:09:29,630 --> 00:09:31,300
!سيّد غابيرو

126
00:09:32,770 --> 00:09:33,490
هل استيقظت الآن؟

127
00:09:33,490 --> 00:09:35,010
...سيّد غابيرو

128
00:09:35,300 --> 00:09:36,880
أ-أين نحن؟

129
00:09:36,180 --> 00:09:38,180
...حمداً لله

130
00:09:40,550 --> 00:09:43,100
...هـ-هذا صحيح! لقد

131
00:09:43,250 --> 00:09:45,660
انهزمتُ بواسطة ذلك الفتى صاحب
الوجه المُضحك

132
00:09:46,150 --> 00:09:48,780
من الواضح أنّهم خدعونا

133
00:09:48,780 --> 00:09:50,360
ماذا تعني؟

134
00:09:51,120 --> 00:09:52,780
المسألة بسيطة

135
00:09:53,410 --> 00:09:55,610
واضح أنّ الفتى الذي هزمني

136
00:09:55,770 --> 00:09:58,740
!هو السيّد الحقيقيّ لتلك الغابة

137
00:09:59,880 --> 00:10:01,170
!حقّاً؟

138
00:10:01,520 --> 00:10:02,340
ذلك الفتى؟

139
00:10:02,340 --> 00:10:05,030
لا بدّ وأنّه كذلك وإلّا لما خسر السيّد غابيرو

140
00:10:05,030 --> 00:10:05,760
بالفعل

141
00:10:05,760 --> 00:10:09,220
يا لها من خدعة قذرة! إرخاء دِفاع
!السيّد غابيرو بأكاذيب كهذه

142
00:10:09,220 --> 00:10:10,030
!جُبناء

143
00:10:10,030 --> 00:10:10,740
!كيف يجرؤون؟

144
00:10:10,740 --> 00:10:12,560
اهدأوا

145
00:10:12,560 --> 00:10:14,880
هذه حكمةُ الضّعفاء

146
00:10:17,440 --> 00:10:19,580
!يا لك من رجُل عظيم! عظيم كجبل

147
00:10:19,580 --> 00:10:21,160
!هذا هو سيّدنا غابيرو

148
00:10:21,160 --> 00:10:22,910
!أجل! زعيمنا المُقبِل

149
00:10:22,910 --> 00:10:25,850
!أنت الأفضل يا غابيرو

150
00:10:26,050 --> 00:10:29,230
—لا، لا، أنا حقّاً لستُ إلى هذه

151
00:10:29,230 --> 00:10:30,270
!لحظة، من؟! ماذا؟

152
00:10:30,580 --> 00:10:32,320
كان هنا طوال هذا الوقت

153
00:10:32,320 --> 00:10:35,400
!أنت عظيمٌ كما سمِعت

154
00:10:36,110 --> 00:10:38,800
اسمي لابلاس

155
00:10:38,800 --> 00:10:40,140
لابلاس؟

156
00:10:40,880 --> 00:10:45,160
لقد أتيتُ كخادِم لغيلمود-ساما لأحذّرك

157
00:10:45,160 --> 00:10:47,290
!غيلمود-ساما

158
00:10:47,480 --> 00:10:49,160
من غيلمود-ساما؟

159
00:10:49,160 --> 00:10:52,710
هو من منح السيّدَ غابيرو اسمه

160
00:10:52,890 --> 00:10:54,840
!شكراً لتكبّدك العناء للمجيء

161
00:10:55,070 --> 00:10:58,030
حسناً، ما هو تحذير غيلمود-ساما؟

162
00:10:58,030 --> 00:11:01,720
!نحن في موقفٍ صعبٍ الآن

163
00:11:04,260 --> 00:11:06,400
يبدو أنّ جيش الأورك

164
00:11:06,400 --> 00:11:10,350
يقوده سيّد أورك بالفعل

165
00:11:10,610 --> 00:11:12,350
!سيّد أورك؟

166
00:11:14,870 --> 00:11:18,260
،زعيم الرّجال السّحالي هو رجلٌ قويّ بلا شكّ

167
00:11:18,260 --> 00:11:20,860
!لكن مضى على ترأسه سنوات كما تعلم

168
00:11:21,240 --> 00:11:23,080
...بصريحِ العبارة

169
00:11:23,080 --> 00:11:25,800
ألا تعتقد أنّ هذا الأمر أثقل من
أن يتحمّله والدك؟

170
00:11:30,450 --> 00:11:35,180
كنتُ قد خطّطتُ بتولِّي الأمور كزعيم
،بعد أن ندحر الأورك

171
00:11:35,180 --> 00:11:37,500
!لكن يبدو أنّ الأوان سيكون قد فات

172
00:11:37,720 --> 00:11:39,130
!بالضبط

173
00:11:43,770 --> 00:11:47,140
—لابلاس، سامحني على المُغادرة فجأة، لكنّنا

174
00:11:47,140 --> 00:11:48,650
!لا عليك، لا عليك

175
00:11:48,650 --> 00:11:50,980
ستعودون إلى المُستنقعات، صحيح؟

176
00:11:50,980 --> 00:11:52,840
!ينبغي أن تسرعوا

177
00:11:52,840 --> 00:11:54,180
شكراً لك

178
00:11:55,090 --> 00:11:56,630
!فلنذهب

179
00:11:56,630 --> 00:11:57,770
!نعم

180
00:12:06,540 --> 00:12:09,640
ابذل قصارى جهدك يا غابيرو

181
00:12:10,600 --> 00:12:29,810
!اِدعسوا كلّ شيء! اِدعسوا كلّ شيء! اِدعسوا كلّ شيء

182
00:12:35,410 --> 00:12:37,830
زعيم، ماذا نفعل؟

183
00:12:38,410 --> 00:12:40,410
جيش الأورك يقترب

184
00:12:41,620 --> 00:12:43,950
ما الذي يمكننا فعله سوى البقاء هنا؟

185
00:12:44,320 --> 00:12:47,970
لا سبيل لدينا لمُقاتلة جيش قوامه
مئتا ألف أورك

186
00:12:47,970 --> 00:12:48,610
نعم سيّدي

187
00:12:48,610 --> 00:12:50,420
!زعيم

188
00:12:50,830 --> 00:12:52,580
!زعيم! جاءنا دخيل

189
00:12:53,730 --> 00:12:55,580
!يُطالِب بلقائك

190
00:12:58,110 --> 00:13:00,900
حسناً. إليّ به

191
00:13:01,500 --> 00:13:03,590
زعيم، أليس هذا خطيراً؟

192
00:13:04,060 --> 00:13:07,480
يمكنك الشّعور بهالته كذلك؟

193
00:13:07,480 --> 00:13:10,470
أجل. هذا ليس دخيلاً عاديّاً

194
00:13:10,470 --> 00:13:11,350
...عند مُواجهته

195
00:13:11,700 --> 00:13:15,350
فحتّى مئة من أقوى الرّجال السّحالي
لن تكون لديهم فرصة

196
00:13:26,690 --> 00:13:30,210
سامحني، أنا مشغولٌ في الوقت الحالي

197
00:13:30,210 --> 00:13:32,160
لا أستطيع توفير أي ضيافة

198
00:13:32,610 --> 00:13:34,320
لا داعي لإتعابِ نفسك

199
00:13:35,600 --> 00:13:41,180
أنا مُجرّد رسول أتيتُ لأنقل إليك
رسالة مولايّ

200
00:13:45,840 --> 00:13:48,050
وما هي رسالتك؟

201
00:13:48,250 --> 00:13:52,150
يرغب مولايّ في التّحالف مع الرّجال السّحالي

202
00:13:52,660 --> 00:13:53,800
تحالف؟

203
00:13:54,440 --> 00:13:59,050
لكن لا أعرف شيئاً عن مولاك

204
00:13:59,680 --> 00:14:02,730
مولايّ هو ريمورو تيمبيست العظيم

205
00:14:03,260 --> 00:14:05,820
،لدى تلقّيه طلباً شخصيّاً من حوريّات الغابة

206
00:14:05,820 --> 00:14:08,320
أقسمَ أن يهزم جيشَ الأورك المُقترِب

207
00:14:09,790 --> 00:14:13,080
طلَب شخصيّ من راعيّات الغابة؟

208
00:14:13,380 --> 00:14:17,000
أبلغَتْنا بأنّ جيش الأورك يقوده
سيّد أورك

209
00:14:17,000 --> 00:14:18,460
!سيّد أورك؟

210
00:14:18,680 --> 00:14:22,280
ضع في الحسبانِ ما يعنيه هذا وأنت
تفكّر في عرضِنا

211
00:14:26,680 --> 00:14:29,150
!تقول ريمورو؟ لم أسمع به أبداً

212
00:14:29,580 --> 00:14:34,160
على الأرجح جاءنا باكياً لأنّه يخشى
!سيّد الأورك

213
00:14:34,160 --> 00:14:36,510
...لو اكتفى فقط بطلبِ المُساعدة منّا

214
00:14:36,510 --> 00:14:37,520
يكفي

215
00:14:38,520 --> 00:14:40,020
ابقَ صامِتاً

216
00:14:40,220 --> 00:14:43,510
—ز-زعيم! هذه القناعة ستؤدّي بالآخرين للتقليل

217
00:14:44,780 --> 00:14:46,030
ما-ما هذا؟

218
00:14:49,150 --> 00:14:50,100
انتظر

219
00:14:50,560 --> 00:14:53,030
أعتذِر عن وقاحة رسولي

220
00:14:54,630 --> 00:14:57,030
هلّا عفوتَ عنه من فضلك؟

221
00:14:57,540 --> 00:15:00,250
هذا العرض ينفعنا كِلينا بالتّساوي، أليس كذلك؟

222
00:15:04,600 --> 00:15:05,610
سامحني

223
00:15:05,610 --> 00:15:07,630
،لم تكن نيّتي تهديده

224
00:15:07,890 --> 00:15:10,370
لكن لن أتحمّل مثل هذه السخريّة
من مولايّ

225
00:15:10,990 --> 00:15:12,490
...كلام شديد

226
00:15:12,490 --> 00:15:15,690
لو لم أوقفْه لقطعَ رأسه بلمحِ البصر

227
00:15:16,750 --> 00:15:21,900
بحسبِ هالتك، يبدو أنّك غول من الجنوب الغربي

228
00:15:22,130 --> 00:15:23,530
ليس بعد الآن

229
00:15:23,530 --> 00:15:27,400
مولايّ منحني اسم "سوي" وأصبحتُ كيجين

230
00:15:27,620 --> 00:15:28,650
كيجين؟

231
00:15:28,650 --> 00:15:32,410
الجنس الأعلى مرتبة والذي نادراً
ما يُولَد بين الغِيلان؟

232
00:15:32,690 --> 00:15:37,030
...إن صحَّ هذا، فإنّه يعني أنّ مولاك

233
00:15:37,030 --> 00:15:40,520
...من جنسٍ أعلى مرتبة حتّى من الكيجين

234
00:15:41,790 --> 00:15:43,690
عرض لدخول حلف

235
00:15:44,290 --> 00:15:49,030
...بعد ظهور سيّد الأورك مباشرة

236
00:15:49,530 --> 00:15:51,170
لا يوجد سببٌ يدفعني للرفض

237
00:15:52,250 --> 00:15:53,260
...لكن

238
00:15:54,660 --> 00:15:58,110
سوي، صحيح؟ لديّ شرط واحد

239
00:15:58,780 --> 00:15:59,610
ما هو؟

240
00:16:00,020 --> 00:16:04,190
أودّ أن ألتقي بمولاك، ريمورو تيمبيست

241
00:16:05,450 --> 00:16:06,410
عُلِم

242
00:16:06,960 --> 00:16:09,640
إذاً سنبدأ بالتّحضيرات

243
00:16:09,980 --> 00:16:12,070
ونلتقيكم هنا بعد سبعة أيّام

244
00:16:12,440 --> 00:16:15,480
سوف تراه حينئذ

245
00:16:16,710 --> 00:16:21,050
احرصوا على ألّا تخوضوا معركةً قبل ذلك الحين

246
00:16:21,500 --> 00:16:22,840
مفهوم

247
00:16:23,300 --> 00:16:24,120
سوف أنصرِف إذاً

248
00:16:31,270 --> 00:16:32,370
!زعيم

249
00:16:34,830 --> 00:16:38,650
أشعر وكأنّني رأيتُ بصيصَ الأمل

250
00:16:40,490 --> 00:16:42,150
احشدي الجميع معاً

251
00:16:45,040 --> 00:16:50,650
لقد اقترب جيشُ الأورك من كهف
تحت الأرض هذا

252
00:16:50,650 --> 00:16:53,270
لكن لا يوجد ما يدعو للخوف

253
00:16:53,820 --> 00:16:57,420
بعد سبعة أيّام، ستنضمّ إلينا تعزيزات قويّة

254
00:16:57,420 --> 00:17:02,660
إلى ذلك الحين، سنبقى هنا وندّخر
قوّتنا للمعركة

255
00:17:03,720 --> 00:17:07,390
لا تفكّروا، ولو لوهلة، في المُبادرة بهجوم

256
00:17:07,390 --> 00:17:12,120
ومن يموت في المعركة سيؤكَل بواسطة العدوّ
!ويغدو قوّة لهم

257
00:17:12,120 --> 00:17:16,440
هذا ما يعنيه أن تقاتلوا سيّد الأورك

258
00:17:18,250 --> 00:17:21,820
حالما تنضمُّ إلينا تعزيزات، سوف نشنّ
هجوماً مُضادّاً

259
00:17:22,260 --> 00:17:24,130
!قاوِموا إلى ذلك الحين

260
00:17:24,650 --> 00:17:27,440
!لن أتحمّل موت أحد من رجالي

261
00:17:32,410 --> 00:17:34,060
!حسناً! حاصِروه

262
00:17:39,400 --> 00:17:41,860
أهذا أورك حقّاً؟

263
00:17:41,860 --> 00:17:44,580
...أشعر وكأنّني قاتلتُ غولاً

264
00:17:44,840 --> 00:17:48,980
من المرعِب التّفكير بوجود 200.000
من هؤلاء

265
00:17:48,980 --> 00:17:51,990
هذا دلالةٌ على قوّة سيّد الأورك

266
00:17:53,020 --> 00:17:55,530
هل يمكننا الدّفاع عن هذا المكان
لثلاثة أيّام أخرى؟

267
00:17:55,530 --> 00:17:58,260
،إن كان كلّ ما نفعله هو الدّفاع
!فسوف تُستنزَف قوّتنا

268
00:18:00,350 --> 00:18:01,480
...أنت

269
00:18:04,950 --> 00:18:06,150
!أبي

270
00:18:07,160 --> 00:18:09,400
لقد عُدت

271
00:18:09,620 --> 00:18:10,450
حسناً؟

272
00:18:10,840 --> 00:18:14,790
هل نجحتَ في تجنيدِ الغوبلن لمساعدتنا؟

273
00:18:14,790 --> 00:18:15,540
!نعم سيّدي

274
00:18:16,240 --> 00:18:18,370
عددهم 7.000 بالمُجمل

275
00:18:18,370 --> 00:18:19,950
إنّهم متأهِّبون

276
00:18:21,140 --> 00:18:21,950
...لكن

277
00:18:22,270 --> 00:18:25,520
لمَ علينا البقاء هنا في وجه هجوم أورك؟

278
00:18:26,040 --> 00:18:30,470
ما اعتاد جنسُ الرّجال السّحالي المُعتزّون
أن يقاتِلوا هكذا

279
00:18:31,210 --> 00:18:35,940
في غيابِك، عُرِضَ علينا حِلف

280
00:18:35,940 --> 00:18:41,340
إلى أن ينضمّوا إلينا، خيارُنا الأمثل
هو التّركيز على الدّفاع

281
00:18:43,810 --> 00:18:45,600
لقد كبرتَ يا أبي

282
00:18:45,790 --> 00:18:46,850
ماذا؟

283
00:18:53,230 --> 00:18:58,230
استغلال هذه المتاهة الطبيعيّة قد يكون
استراتيجيّة حكيمة ضدّ جيش ضخم

284
00:18:58,230 --> 00:19:02,950
،لكن الممرّات المنفصِلة الكثيرة تقسِّم قوّاتَنا

285
00:19:02,950 --> 00:19:05,450
!ما يمنعنا من مُلاقاة العدوّ بكامل قوّتنا

286
00:19:06,680 --> 00:19:09,580
غـ-غابيرو، ما معنى هذا؟

287
00:19:09,580 --> 00:19:12,010
اهدأ يا قائد الحرس

288
00:19:12,010 --> 00:19:13,880
لا أنوي أذيّتك

289
00:19:14,110 --> 00:19:15,170
...لكن

290
00:19:16,320 --> 00:19:19,510
سأعتذر لاحقاً عن اللّجوء للعنف

291
00:19:19,960 --> 00:19:22,030
،قد تشعر بعدمِ الرّاحة أثناء تقييدك

292
00:19:22,030 --> 00:19:25,010
لكن تحمّل ذلك إلى أن أهزم سيّد الأورك

293
00:19:26,870 --> 00:19:30,140
!بُني! لن أسمح لك بفعل هذا

294
00:19:30,300 --> 00:19:32,600
!غابيرو... لا، أخي

295
00:19:32,600 --> 00:19:33,950
!أرجوك، عُد إلى رشدك

296
00:19:33,950 --> 00:19:38,100
!فكّوا قيدي! !قلتُ فكّوا قيدي

297
00:19:38,100 --> 00:19:40,240
!فكّوا قيدي حالاً! لن أقبل بهذا

298
00:19:42,710 --> 00:19:44,860
سيّد غابيرو، تفضّل

299
00:19:45,860 --> 00:19:47,250
...هذا لأبي

300
00:19:56,630 --> 00:19:58,560
...هـ-هذه القوّة

301
00:19:59,170 --> 00:20:03,500
رمح الدوّامة، أتعترف بي كقائد؟

302
00:20:06,960 --> 00:20:09,780
لقد سيطرنا على قائد كلّ عشيرة

303
00:20:09,780 --> 00:20:14,670
كان هناك الكثير من الشّباب الذين
لم يوافقوا على هذه المعركة الدفاعيّة

304
00:20:15,800 --> 00:20:16,850
هكذا إذاً

305
00:20:18,570 --> 00:20:20,700
جميعنا خلفك

306
00:20:20,700 --> 00:20:22,320
نعتمد عليك يا سيّد غابيرو

307
00:20:24,180 --> 00:20:25,200
بالطبع

308
00:20:25,620 --> 00:20:30,120
!سأريكم كيف يُقاتل رجُل السّحالي الحقيقي

309
00:20:30,120 --> 00:20:31,700
!لقد حان الوقت

310
00:20:34,460 --> 00:20:38,960
!غابيرو! غابيرو! غابيرو

311
00:20:39,520 --> 00:20:46,020
!اِدعسوا كلّ شيء! اِدعسوا كلّ شيء! اِدعسوا كلّ شيء

312
00:20:46,020 --> 00:20:49,350
جيش الأورك ملأ المُستقنعات

313
00:20:49,670 --> 00:20:52,340
في زاوية ما من زوايا صفوفهم، اندلعَتْ فوضى

314
00:20:56,320 --> 00:20:59,520
لا حاجة لخشية هؤلاء الخنازير بعد الآن

315
00:20:59,860 --> 00:21:02,240
!هذه المُستقنعات هي موطننا

316
00:21:02,240 --> 00:21:05,480
!سنُربِك الأورك ونحيّرهم برشاقتِنا

317
00:21:06,490 --> 00:21:09,740
لن نخسر أمام هؤلاء المغفّلين الذين علِقَتْ
!أقدامهم بالوحل

318
00:21:09,930 --> 00:21:10,880
!مرحى

319
00:21:10,880 --> 00:21:12,220
!هجومنا يفلح

320
00:21:12,220 --> 00:21:13,180
بالفعل

321
00:21:13,180 --> 00:21:16,400
!مجرّد أورك ليسوا ندّاً لنا نحن رجال السّحالي

322
00:21:16,860 --> 00:21:19,000
!حسناً! انسحِبوا حاليّاً

323
00:21:19,810 --> 00:21:23,550
أقرّ رجالُ غابيرو بمواهبه

324
00:21:26,200 --> 00:21:27,260
ما الذي يجري؟

325
00:21:29,330 --> 00:21:31,700
،إن كان هناك ما لم يحسبوا له

326
00:21:32,320 --> 00:21:34,020
...فهو أنّ غابيرو لم يكن يعلم

327
00:21:34,940 --> 00:21:36,760
كم أنّ سيّد الأورك مُرعِب

328
00:21:37,140 --> 00:21:40,650
الأورك... يأكلون الأورك الآخرين؟

329
00:21:42,440 --> 00:21:46,650
بينما كان الزعيم يعرف رعبَ سيّد الأورك

330
00:21:47,830 --> 00:21:50,940
هذا الفارِق بين الاثنين بات الآن

331
00:21:51,270 --> 00:21:52,950
يكشّر عن أنيابه على غابيرو

332
00:21:53,540 --> 00:21:57,790
!اِدعسوا كلّ شيء! اِدعسوا كلّ شيء! اِدعسوا كلّ شيء

333
00:21:58,280 --> 00:22:01,500
!قوّة هذا الزميل الذي نأكله هي لنا الآن

334
00:22:01,500 --> 00:22:05,050
!قوّة هذه الفريسة التي نأكلها هي لنا الآن

335
00:23:35,980 --> 00:23:38,460
"الحلقة القادمة، "الصِّراع العظيم