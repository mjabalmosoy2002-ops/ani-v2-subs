1
00:00:03,280 --> 00:00:05,600
حلّ موسم المطر على تاجيمي أيضاً

2
00:00:05,600 --> 00:00:08,690
وتتوالى الأمطار والعبوس يوماً تلو الآخر

3
00:00:10,680 --> 00:00:13,980
لكنّي أنهيتُ عدّة قطّع

4
00:00:13,980 --> 00:00:15,760
بدأتُ أشعر بالحماس

5
00:00:15,760 --> 00:00:21,200
أو كنت كذلك، حتّى وقعت حادثة صغيرة هائلة

6
00:00:33,720 --> 00:00:36,100
...وعائي

7
00:00:36,100 --> 00:00:37,680
!آ-آسفة

8
00:00:41,240 --> 00:00:44,540
انتبهي، هل جرحتِ ساقك؟

9
00:00:45,200 --> 00:00:46,470
أنا بخير

10
00:00:46,930 --> 00:00:48,560
سأذهب لجلب المكنسة الآليّة

11
00:00:48,560 --> 00:00:49,490
لا تتحرّكي

12
00:00:50,110 --> 00:00:52,850
كلّ شيء بشكل محتومٌ عليه التحطّم

13
00:00:53,270 --> 00:00:55,030
كلّ الأحياء تلقى الموت

14
00:00:55,030 --> 00:00:56,540
وكلّ لقاء مصيره الفراق

15
00:02:36,550 --> 00:02:43,920
ولذلك، أريدّ إهداء أبي
وعاءً صنعتُه بنفسي

16
00:02:43,920 --> 00:02:46,010
صنعتِه بنفسك؟ أنت؟

17
00:02:46,460 --> 00:02:47,560
لمَ لا؟

18
00:02:47,560 --> 00:02:49,060
فهذا نادي الفخّار

19
00:02:49,060 --> 00:02:50,410
!إنّها فكرةٌ رائعة

20
00:02:50,410 --> 00:02:52,050
رغم أنّ مستوى الصعوبة مرتفع

21
00:02:52,050 --> 00:02:54,010
ألن يكون شراء واحد أسرع لك؟

22
00:02:54,280 --> 00:02:58,600
معكِ حقّ، لكن كان ذلك وعاء أبي المفضّل

23
00:02:58,600 --> 00:03:00,440
وظلّ يستخدمه لفترة طويلة

24
00:03:00,440 --> 00:03:01,640
طويل؟

25
00:03:01,640 --> 00:03:02,020
أجل

26
00:03:02,830 --> 00:03:05,400
مُذ كنت في المتوسّطة

27
00:03:06,840 --> 00:03:07,820
لحظة

28
00:03:07,820 --> 00:03:09,430
ربما قبل ذلك حتّى

29
00:03:10,550 --> 00:03:13,180
كان بحوزته قدرما تأخذني الذاكرة

30
00:03:13,180 --> 00:03:15,320
يا للرابطة

31
00:03:15,320 --> 00:03:18,770
لذا كنتُ آمل صنع وعاء يماثله

32
00:03:18,770 --> 00:03:20,530
كيف كان الوعاء؟

33
00:03:20,530 --> 00:03:22,750
وعاء أوتشازوكي

34
00:03:22,750 --> 00:03:24,680
لمَ لا ننظر للقطّع المحطّمة وحسب؟

35
00:03:25,230 --> 00:03:26,930
الوعاء المحطّم؟

36
00:03:27,330 --> 00:03:30,240
أجل، كانت الشظايا خطرة فرميته

37
00:03:30,240 --> 00:03:32,650
لحظّنا، كان اليوم هو موعد جمع
قطع الزجاج المحطّمة

38
00:03:32,650 --> 00:03:35,190
والخزافيّات، ويحلّ مرّةً كلّ ثلاثة أشهر

39
00:03:35,970 --> 00:03:38,500
لمَ اليوم بالذات؟

40
00:03:40,670 --> 00:03:42,680
أكان شيئاً من هذا القبيل؟

41
00:03:43,110 --> 00:03:45,790
يميل لليسار كثيراً

42
00:03:46,100 --> 00:03:48,030
كلا، هذه الرسمة فقط

43
00:03:48,030 --> 00:03:50,970
يُفترض أنّي رأيتُه يومياً

44
00:03:50,970 --> 00:03:52,700
تريدين أن نبحث عن واحد مشابه؟

45
00:04:08,960 --> 00:04:11,240
كان لونه مقارباً لهذا

46
00:04:11,640 --> 00:04:13,970
والشكل يذكّرني بهذا

47
00:04:14,700 --> 00:04:17,510
يفضّل والدكِ التصميم المتواضع إذاً

48
00:04:17,510 --> 00:04:18,360
صحيح

49
00:04:21,120 --> 00:04:23,780
سأحاول صنعه وأنا أرسمه بذهني

50
00:04:30,320 --> 00:04:32,910
أوتشازوكي ببقايا إسقمريّ بالسمسم

51
00:04:33,650 --> 00:04:35,910
!سيكون لذيذاً بلا شكّ

52
00:04:35,910 --> 00:04:37,730
!ساخن

53
00:04:41,780 --> 00:04:43,480
نتيجة بحثي

54
00:04:43,930 --> 00:04:46,980
!أعتقد أنّه كان بسماكة وعمق هذا

55
00:04:47,350 --> 00:04:49,970
يحبّ إضافة الكثير من الشاي له

56
00:04:49,970 --> 00:04:52,560
ألن يكون وعاءٌ بهذه السماكة والعمق

57
00:04:52,560 --> 00:04:54,800
ثقيلاً عند ملئه بالأوتشازوكي؟

58
00:04:54,800 --> 00:04:56,720
ربما أخطأت التقدير إذاً

59
00:04:56,970 --> 00:04:59,020
إذا كان سيكون ثقيلاً، فلمَ لا تضيفي ممسكاً؟

60
00:04:59,020 --> 00:05:01,370
ثمّ يمكنه استعمال ملعقة
خشبيّة عند الأكل

61
00:05:01,370 --> 00:05:03,720
لم تعد لهذا علاقة بالوعاء المحطّم

62
00:05:05,040 --> 00:05:05,750
ربما

63
00:05:06,330 --> 00:05:09,710
حتّى إذا لم يكن مطابقاً للوعاء السابق

64
00:05:09,710 --> 00:05:12,970
أرى أنّ عليكِ صنع وعاء ترينه

65
00:05:12,970 --> 00:05:14,740
سيكون مثالياً لأبيك فقط

66
00:05:14,930 --> 00:05:16,240
هكذا إذاً

67
00:05:16,600 --> 00:05:18,210
معكِ حقّ

68
00:05:27,010 --> 00:05:29,030
ماذا؟ أصبحت السادسة بهذه السرعة؟

69
00:05:29,030 --> 00:05:31,590
من الصعب الإحساس بالوقت
أثناء موسم المطر

70
00:05:31,590 --> 00:05:34,090
حسناً، انتهينا لليوم

71
00:05:34,090 --> 00:05:35,010
!أجل

72
00:05:58,370 --> 00:06:00,000
اشتريتُ لك شراباً

73
00:06:00,000 --> 00:06:01,890
لحظة، ماذا؟

74
00:06:01,890 --> 00:06:03,900
أنتِ هنا أيضاً يا سينباي؟

75
00:06:03,900 --> 00:06:07,870
بما أنّكِ أخبرتني أنّك ستجلسين هنا
للعمل على التصميم صباح اليوم

76
00:06:07,870 --> 00:06:09,610
جلبتُها معي

77
00:06:09,610 --> 00:06:11,860
إذاً؟ هل وصلتِ لتصميم جيّد؟

78
00:06:11,860 --> 00:06:13,670
ليس بعد، لكنّي أحاول

79
00:06:14,410 --> 00:06:16,680
في الواقع، أردتُ إعطاءكِ هذه

80
00:06:19,250 --> 00:06:21,040
إنّه خوخ مخلل

81
00:06:21,040 --> 00:06:24,050
ظننتُ أنّه سينال إعجاب
أبيك مع الأوتشازوكي

82
00:06:24,470 --> 00:06:27,000
!مذهل! شكراً لك

83
00:06:27,000 --> 00:06:28,420
وأيضاً، وأيضاً

84
00:06:28,420 --> 00:06:32,610
حتّى انتهاء وعائك، رأيتُ أنّ هذا
سيصلح ليكون بديلاً

85
00:06:32,610 --> 00:06:33,710
!مفاجأة

86
00:06:34,300 --> 00:06:35,620
إنّه جميل

87
00:06:35,620 --> 00:06:39,430
أليس متقناً؟ صنعته سينباي العام الفائت

88
00:06:39,430 --> 00:06:41,740
العام الفائت؟ مذهل

89
00:06:41,740 --> 00:06:44,780
أتت ميكا-تشان لمنزلي فجأةً واخترته

90
00:06:44,780 --> 00:06:46,230
آمل أنّنا لا نضايقك

91
00:06:46,630 --> 00:06:48,690
!أنا ممتنة جدّاً

92
00:06:48,690 --> 00:06:50,160
!سأستعمله

93
00:06:51,940 --> 00:06:53,210
من آوكي-سان؟

94
00:06:53,210 --> 00:06:57,290
أجل، قالت أنّ بإمكاننا استعارته
حتّى تجد ما قد ينال إعجابك

95
00:06:57,290 --> 00:07:00,240
إنّها قطعة جميلة بالفعل

96
00:07:00,240 --> 00:07:02,110
جرّب حملها يا توكي-كن

97
00:07:02,110 --> 00:07:03,600
...لنرَ

98
00:07:06,110 --> 00:07:07,200
...إنّه

99
00:07:07,200 --> 00:07:08,970
أجل، جميل

100
00:07:11,930 --> 00:07:13,300
!يبدو لذيذاً

101
00:07:13,300 --> 00:07:16,730
بساطة الوعاء تظهر لمعان الخوخ المخلل

102
00:07:16,730 --> 00:07:18,010
وقت الأكل

103
00:07:29,730 --> 00:07:30,850
ما هذا؟

104
00:07:34,210 --> 00:07:36,200
دفعةً واحدة؟

105
00:07:36,200 --> 00:07:39,350
لا تثقل على نفسك يا توكي-كن

106
00:07:39,900 --> 00:07:41,270
شكراً على الطعام

107
00:07:49,030 --> 00:07:51,320
كنتُ أفكّر بشيءٍ كهذا

108
00:07:52,230 --> 00:07:54,930
أوتشازوكي السلمون هو المفضّل لدى أبي

109
00:07:54,930 --> 00:07:57,130
لذا كنت أفكّر بصنع
شيء يكمل السلمون

110
00:07:57,130 --> 00:07:58,570
دائماً ما يغمر وعائه

111
00:07:58,570 --> 00:08:01,540
فأرى أنّ المكوّنات تستطيع بلوغ
هذه النقطة بأقصى الحدود

112
00:08:02,740 --> 00:08:05,710
!تفيضين حبّاً لأبيك يا هيمي-تشان

113
00:08:05,710 --> 00:08:07,460
أجل، أرى هذا جميلاً

114
00:08:07,460 --> 00:08:10,990
إنّه مصدر طاقة كبير
عند صنع هذه الأشياء

115
00:08:10,990 --> 00:08:11,930
أجل

116
00:08:11,930 --> 00:08:14,290
!ستنجحين حتماً

117
00:08:38,510 --> 00:08:41,070
سأستطيع طلاءها غداً أخيراً

118
00:08:41,600 --> 00:08:44,530
آمل أنّ الحرق الأوليّ
تمّ على ما يرام

119
00:08:47,010 --> 00:08:50,420
بدأتُ أشعر بالأسف لاضطراري
لإعادة هذا الوعاء

120
00:08:50,690 --> 00:08:53,420
أهو ملائم لذاك الحدّ للأوتشازوكي؟

121
00:08:53,610 --> 00:08:57,230
يشبه القديم كثيراً عندما أحمله

122
00:08:57,230 --> 00:08:59,330
مثل ملمسه الرقيق

123
00:08:59,330 --> 00:09:00,600
حقّاً؟

124
00:09:00,900 --> 00:09:04,430
من المذهل أنّها صنعته في عامها
الأوّل في الثانويّة

125
00:09:04,970 --> 00:09:08,440
ألم يُصنع الآخر في قرابة
تلك الفترة أيضاً؟

126
00:09:08,860 --> 00:09:12,430
بلى، كان عام هيمينا الأوّل في الثانويّة

127
00:09:13,340 --> 00:09:17,320
كانت تعطيني فخّاريات غريبة باستمرار بدايةً

128
00:09:17,320 --> 00:09:18,980
كما لو كان مقلباً

129
00:09:18,980 --> 00:09:21,940
فأخبرتها أن تعطيني شيئاً
قد أستطيع استعماله حقّاً

130
00:09:22,360 --> 00:09:25,730
فصنعت لي ذاك

131
00:09:26,860 --> 00:09:30,710
عاش طويلاً، 30 عاماً

132
00:09:31,080 --> 00:09:33,410
كُشط قاعه منذ فترة طويلة

133
00:09:33,410 --> 00:09:35,380
وكانت به تشقّقات

134
00:09:35,380 --> 00:09:37,210
فكان لا مفرّ من الأمر فعلاً

135
00:09:40,080 --> 00:09:43,550
المستوى أعلى بكثير الآن

136
00:09:49,030 --> 00:09:50,720
لكن عليّ فعلها

137
00:09:53,460 --> 00:09:55,360
مضى أسبوعان مُذ آنذاك

138
00:09:55,930 --> 00:09:59,800
كنتُ أركّز على ذاك الوعاء
ولا شيء غيره

139
00:10:00,800 --> 00:10:03,570
شعور الإثارة عند الانتهاء منه

140
00:10:03,570 --> 00:10:05,740
والخوف المكافئ الذي يصاحبه

141
00:10:06,120 --> 00:10:09,820
قد يتجاوزان مشاعري عند التحاقي بالثانويّة حتّى

142
00:10:16,840 --> 00:10:18,620
حسناً، سأفتحه

143
00:10:18,930 --> 00:10:20,270
...استعداد

144
00:10:22,850 --> 00:10:23,760
!انتهى

145
00:10:23,950 --> 00:10:26,620
آمل أن ينال إعجاب أبيك

146
00:10:26,620 --> 00:10:27,310
أ!جل

147
00:10:27,310 --> 00:10:29,360
!عليكِ إخبارنا بردّة فعله

148
00:10:29,360 --> 00:10:30,050
حسناً

149
00:10:31,350 --> 00:10:32,690
ما رأيك بأوتشازوكي؟

150
00:10:32,690 --> 00:10:33,940
لدينا سلمون

151
00:10:33,940 --> 00:10:35,250
أجل، يبدو حسناً

152
00:10:35,250 --> 00:10:36,270
سأتناوله

153
00:10:51,570 --> 00:10:54,230
هل صنعتِ هذا الوعاء؟

154
00:10:54,230 --> 00:10:57,550
أ-أجل، لكنّه ليس منمّقاً

155
00:10:57,550 --> 00:11:01,130
فهمت، صنعتِه لي

156
00:11:09,330 --> 00:11:10,860
وقت الأكل

157
00:11:17,320 --> 00:11:19,130
إنّه رائع

158
00:11:19,130 --> 00:11:20,860
الحجم مناسب تماماً

159
00:11:20,860 --> 00:11:22,250
أمتأكّد أنّه جيّد؟

160
00:11:22,250 --> 00:11:23,950
والحوت عليه ظريفٌ أيضاً

161
00:11:24,170 --> 00:11:25,650
إنّه سلمون

162
00:11:27,350 --> 00:11:29,800
صحيح، سلمون

163
00:11:30,940 --> 00:11:32,390
شكراً لك

164
00:11:32,390 --> 00:11:35,340
هذه أكثر هديّة قد تسعدني

165
00:11:35,340 --> 00:11:36,830
يسرّني ذلك

166
00:11:36,830 --> 00:11:38,750
تولَّ التنظيف عند انتهائك رجاءً

167
00:11:38,750 --> 00:11:39,910
عمتَ مساءً

168
00:11:56,480 --> 00:12:00,530
لا مشكلة
!كافحي

169
00:11:56,480 --> 00:12:04,870
!سأذهب الآن
شكراً يا رفاق
قال أنّها أكثر
هديّة قد تسعده

170
