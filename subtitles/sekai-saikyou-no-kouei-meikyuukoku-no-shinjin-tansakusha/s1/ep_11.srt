1
00:00:02,770 --> 00:00:03,860
!هذا هو الحلّ

2
00:00:05,140 --> 00:00:07,650
.لن ينجح أيّ شيء تحاولونه

3
00:00:08,800 --> 00:00:11,140
!تعالَيْن يا أنصاف الهاربي

4
00:00:21,090 --> 00:00:23,080
!أريد منكنّ أن تبدأن الغناء

5
00:00:39,540 --> 00:00:41,400
!نسيتُ أنّ لدينا هذا الخيار

6
00:00:41,400 --> 00:00:43,250
...حسنًا، سيكون ذلك

7
00:00:48,390 --> 00:00:50,520
لماذا لا تنام؟

8
00:00:50,520 --> 00:00:52,770
هل تمنحها عُدّتُها مقاومةً ما؟

9
00:00:52,770 --> 00:00:54,230
.لا، الأمر ليس كذلك

10
00:00:57,320 --> 00:01:01,910
!هذا لأنّها الأكثر تأثّرًا بمحرّك الدّمى بينهم

11
00:02:44,520 --> 00:02:47,740
.إنّ أيّ هجوم مباشر سيؤذيها

12
00:02:47,740 --> 00:02:50,190
.علينا إيجاد طريقة لإيقافها عن الحركة

13
00:02:50,190 --> 00:02:54,150
،كم أنتم أشخاص سيّئون
.إذ تتدخلون بهذه الطّريقة

14
00:02:55,640 --> 00:03:00,960
،إن امتصصتُه أوّلاً
فهل ستفعل بقيّتكنّ ما أقوله تمامًا؟

15
00:03:14,790 --> 00:03:16,770
،إن استدرتُ للتّعامل مع هذا

16
00:03:16,770 --> 00:03:18,910
!فإنّ دعمي الدّفاعي لن يساعدهنّ

17
00:03:18,910 --> 00:03:20,050
ماذا أفعل؟

18
00:03:22,250 --> 00:03:25,200
كلّ سواط الكرمة تنمو من ظهرها؟

19
00:03:25,840 --> 00:03:27,310
!التّمركز الخلفيّ

20
00:03:29,770 --> 00:03:31,510
!هذا هو جسد الوحش الحقيقيّ

21
00:03:44,160 --> 00:03:45,950
!يا رفيقات! خلفكنّ

22
00:03:51,210 --> 00:03:53,270
!هذه فرصتنا الوحيدة لهزيمته

23
00:03:56,140 --> 00:03:57,760
!الصّاعقة الصّاعدة

24
00:03:58,270 --> 00:03:59,800
!الهجوم المزدوج

25
00:04:05,980 --> 00:04:07,210
!أصب الهدف رجاءً

26
00:04:07,210 --> 00:04:09,110
!حظّ السّبعة

27
00:04:10,710 --> 00:04:12,140
!سيف الزّهور

28
00:04:28,400 --> 00:04:30,290
.أعتقد أنّنا نجحنا

29
00:04:34,170 --> 00:04:38,240
يقشعرّ بدني لمجرّد التّفكير فيما كان
.سيحدث لو لم تكن لدينا نصف الهاربي

30
00:04:38,760 --> 00:04:40,450
،بالمناسبة يا أتوبي

31
00:04:40,450 --> 00:04:42,810
هل أعطيتهنّ أسماءً؟

32
00:04:42,810 --> 00:04:46,210
...أنا... لا أجيد كثيرًا منح الأسماء

33
00:04:46,210 --> 00:04:48,160
،بما أنّهنّ فتيات بأجنحة

34
00:04:48,160 --> 00:04:50,180
ما رأيكم باسم أسوكا؟

35
00:04:50,410 --> 00:04:51,700
...أسوكا

36
00:04:51,700 --> 00:04:54,710
،في تلك الحالة
ما رأيكم بيايوي كاسم لهذه؟

37
00:04:55,320 --> 00:04:59,640
...أمّا بالنّسبة للثّالثة
فما رأيكم باسم هيميكو؟

38
00:04:59,640 --> 00:05:01,510
.أعتقد أنّ الأسماء أعجبتهنّ

39
00:05:01,510 --> 00:05:02,950
.اتّفقنا إذًا

40
00:05:02,950 --> 00:05:05,400
.شكرًا لكنّ. أبليتنّ حسنًا

41
00:05:11,390 --> 00:05:12,560
ما هذا؟

42
00:05:12,560 --> 00:05:15,010
...مكافأة نادرة على شكل صندوق كنز أسود

43
00:05:15,010 --> 00:05:17,510
!أعتقد أنّ مهارتي ما زالت تعمل

44
00:05:25,400 --> 00:05:27,520
هل أنتم فرقة نجم الشّمال؟

45
00:05:27,520 --> 00:05:29,520
.نحن فرقة مختلفة

46
00:05:29,520 --> 00:05:32,720
.قتلنا للتّوّ الوحش الّذي هاجم نجم الشّمال

47
00:05:32,720 --> 00:05:33,930
ولكن من أنتم؟

48
00:05:34,200 --> 00:05:38,150
.نحن منقذو النّقابة
.أتيتا نزولاً لطلب مساعدة

49
00:05:40,040 --> 00:05:43,500
.شكرًا لقيامكم بهذه المهمّة بدلاً منّا

50
00:05:43,500 --> 00:05:46,630
،ولكن ابتداءً من الآن
،لا تواجهوا وحوشًا عالية المستوى

51
00:05:46,630 --> 00:05:49,400
.حتّى إن كان ذلك بنيّة مساعدة أحد ما

52
00:05:49,400 --> 00:05:50,960
أيمكنكم أن تعدوني بهذا؟

53
00:05:50,960 --> 00:05:54,160
.ذلك... يعتمد على الوضع

54
00:05:54,410 --> 00:05:56,020
.لا يمكنني تقديم أيّة وعود

55
00:05:57,080 --> 00:05:59,730
.لا أطلب هذا لتردّ بشكل دفاعيّ هكذا

56
00:05:59,730 --> 00:06:03,950
نحن ببساطة لا نريد أن يفقد
المزيد من الباحثين حياتهم

57
00:06:04,330 --> 00:06:06,340
.قبل أن يتمكّنوا من تحقيق أهدافهم

58
00:06:06,670 --> 00:06:08,250
.سأتذكّر ذلك جيّدًا

59
00:06:10,510 --> 00:06:14,890
.سننقل أعضاء نجم الشّمال إلى المدينة

60
00:06:16,270 --> 00:06:19,880
،إن كانت فرقتكم تودّ الانسحاب أيضًا
.فسننقلكم أنتم كذلك

61
00:06:22,260 --> 00:06:23,440
.نعتمد عليكم

62
00:06:24,550 --> 00:06:26,360
.وشكرًا لكم

63
00:06:26,360 --> 00:06:29,920
.لم أقدّم نفسي بعد. اسمي أتوبي

64
00:06:29,920 --> 00:06:31,450
.أريهيتو أتوبي

65
00:06:31,760 --> 00:06:35,580
.حظيَ اسمك باهتمام أكبر ممّا تدرك

66
00:06:37,790 --> 00:06:40,750
.أنا سيرافينا إدلبرت

67
00:06:48,380 --> 00:06:52,400
أريهيتو، من الجيّد أنّ منقذي
النّقابة قد أتوا، صحيح؟

68
00:06:52,400 --> 00:06:54,760
.نعم، ولعدّة أسباب

69
00:06:54,760 --> 00:06:56,800
.أردتُ الخروج من هناك بسرعة

70
00:06:57,040 --> 00:07:00,190
!كما... حصلنا على هذا

71
00:07:01,510 --> 00:07:05,410
هل تملك غابة الصّراخ طابقًا خفيًّا أيضًا؟

72
00:07:05,410 --> 00:07:08,190
لا يمكن الحصول على الصّناديق
.السّوداء بالبحث عنها

73
00:07:08,190 --> 00:07:10,760
إن كان لدينا الفرصة لاكتساب
،الحقّ لدخول طابق خفيّ

74
00:07:10,760 --> 00:07:13,080
.لا أعتقد أنّ علينا توفيتها

75
00:07:14,920 --> 00:07:19,800
،أوافقك الرّأي. إن وُجد مفتاح في الدّاخل
.فسنتّجه إلى الطّابق الخفيّ

76
00:07:20,760 --> 00:07:23,690
.سنطلب من السّيّدة فالما فتح الصّندوق غدًا

77
00:07:23,690 --> 00:07:26,590
.سأبلّغ عن تقدّمنا للآنسة لويزا

78
00:07:26,590 --> 00:07:28,310
.بإمكانكنّ الذّهاب للمنزل للرّاحة

79
00:07:28,310 --> 00:07:29,300
.حسنًا

80
00:07:34,420 --> 00:07:36,630
ماذا؟ أتريدين الذّهاب معي؟

81
00:07:37,980 --> 00:07:40,520
لكن عليك الذّهاب والاستراحة
...بعد ما حدث اليوم

82
00:07:49,230 --> 00:07:51,770
أتحاول تقليد تلك المصافحة؟

83
00:07:53,230 --> 00:07:57,420
ماذا؟ مهلاً، أتغارين من الآنسة سيرافينا؟

84
00:08:02,170 --> 00:08:05,760
لكان من الفظاظة أن أرفض
.مصافحة يدها في ذلك الوضع

85
00:08:05,760 --> 00:08:08,830
!لم يكن لذلك أيّ معنى خاصّ لأيّ منّا

86
00:08:16,820 --> 00:08:20,350
.سنسبقكما ونعود للمنزل
.يمكنكما أنتما الذّهاب

87
00:08:23,090 --> 00:08:24,060
.حسنًا

88
00:08:38,280 --> 00:08:42,660
أنقذتَهم قبل أن يصل منقذو
...النّقابة إلى هناك

89
00:08:42,660 --> 00:08:44,870
.نقاط مساهمتكم لا تُصدّق

90
00:08:45,330 --> 00:08:48,890
لم تكونوا بحاجة حتّى لاجتياز
،امتحان التّرقية

91
00:08:48,890 --> 00:08:51,750
.لكنّكم نجحتم فيه نجاحًا باهرًا أيضًا

92
00:08:52,030 --> 00:08:55,160
،من المؤسف أنّنا لم نختبر التّخييم

93
00:08:55,160 --> 00:08:58,720
لكنّي مسرور لأنّنا استطعنا
.مساعدة أعضاء نجم الشّمال

94
00:08:58,720 --> 00:09:01,840
.ستتلقّون مكافآت لقاءَ إنقاذهم

95
00:09:03,640 --> 00:09:07,090
أرجو أن تسخّريها لنفقات علاج
.غيورغ ورفاق فرقته

96
00:09:07,090 --> 00:09:08,860
هل أنت واثق؟

97
00:09:08,860 --> 00:09:11,140
.إنّنا نتشارك نفس المسكن

98
00:09:11,140 --> 00:09:13,680
.أريد مساعدتهم بقدر المستطاع

99
00:09:13,680 --> 00:09:17,310
أنت ترغب في مساعدة أكبر
عدد ممكن من الباحثين

100
00:09:17,310 --> 00:09:20,900
على البقاء نشطين لأطول
فترة ممكنة، أليس كذلك؟

101
00:09:21,110 --> 00:09:25,470
،ربّما تكون بيننا منافسة متواصلة
،لكن إن تشاركنا جميعًا نفس الهدف

102
00:09:25,470 --> 00:09:29,130
أعتقد أنّنا سنكون قادرين على
.مساعدة بعضنا عند الحاجة

103
00:09:29,130 --> 00:09:30,840
.مفهوم

104
00:09:30,840 --> 00:09:33,880
.سأقوم بالتّرتيبات اللاّزمة بمكافأتكم الماليّة

105
00:09:34,110 --> 00:09:35,690
.نعتمد عليك

106
00:09:35,690 --> 00:09:38,600
أودّ زيارتهم الآن. أين أجدهم؟

107
00:09:39,730 --> 00:09:43,330
تمّ أخذ أعضاء نجم الشّمال
،إلى مصحّة المعالج

108
00:09:43,330 --> 00:09:45,560
.حيث يخضعون الآن إلى العلاج المطلوب

109
00:09:46,810 --> 00:09:49,240
أريهيتو، هل أتيت لرؤيتنا؟

110
00:09:49,720 --> 00:09:53,360
.واجهتم وقتًا عصيبًا
—لو أنّنا وصلنا أبكر

111
00:09:54,690 --> 00:09:57,430
.لم أكن تحت سيطرة ذلك الوحش

112
00:09:57,430 --> 00:10:00,250
كنتُ مصابًا، لكن كان
.بإمكاني مواصلة القتال

113
00:10:00,750 --> 00:10:03,460
.ومع ذلك، رفضتْ ساقاي أن تتحرّكا

114
00:10:04,040 --> 00:10:05,500
أمر يدعو للسّخرية، صحيح؟

115
00:10:06,950 --> 00:10:10,920
،بوجود قائد مثير للشّفقة مثلي
.على الأرجح أنّ فرقتي جاهزة للاستسلام

116
00:10:11,590 --> 00:10:14,590
.لكنّكم عدتم جميعًا على قيد الحياة

117
00:10:14,820 --> 00:10:16,590
.بإمكانكم البدء من جديد

118
00:10:17,670 --> 00:10:21,090
قد يبدو من غير المسؤول منّي قول
...ذلك وكأنّ الأمر بسيط للغاية، ولكن

119
00:10:21,630 --> 00:10:24,460
.لا، أنا أقدّر تشجيعك

120
00:10:24,950 --> 00:10:28,440
لكن هناك سبب آخر قد يؤدّي
.إلى نهاية فريقنا

121
00:10:29,890 --> 00:10:32,110
هل تمانع زيارة صوفي نيابةً عنّي؟

122
00:10:32,490 --> 00:10:34,550
...ربّما يمكنك

123
00:10:36,490 --> 00:10:37,990
هل هي فاقدة للوعي؟

124
00:10:37,990 --> 00:10:41,470
،نعم. أمّا الآخرون فهم نائمون فقط

125
00:10:41,470 --> 00:10:43,450
.وقد استيقظوا مرّة واحدة على الأقلّ

126
00:10:43,720 --> 00:10:47,760
لكنّ هذه المريضة، ورغم أنّ عينيها
.مفتوحتان، إلاّ أنّها ليست واعية

127
00:10:48,090 --> 00:10:49,940
ما الّذي يسبّب ذلك؟

128
00:10:49,940 --> 00:10:55,140
إنّ التّواصل مع عقل الوحش
.يضع عبئًا هائلاً على البشر

129
00:10:55,470 --> 00:10:58,910
.والكثير منهم لا يتعافون تمامًا أبدًا

130
00:10:59,320 --> 00:11:00,640
...هل هناك

131
00:11:00,640 --> 00:11:03,090
هل هناك أيّ شيء يمكنني فعله من أجلها؟

132
00:11:03,470 --> 00:11:08,370
حتّى بالنّسبة للمعالجين المتخصّصين مثلنا، فإنّ
.أقصى ما يمكننا فعله هو إبقاؤها على قيد الحياة

133
00:11:08,770 --> 00:11:10,560
.وخلاف ذلك، لا يسعنا سوى الدّعاء

134
00:11:29,450 --> 00:11:33,640
ألا توجد طريقة لإعادتها إلى طبيعتها؟

135
00:11:35,090 --> 00:11:38,520
...لا أستطيع التّفكير في أيّ شيء
...ولكن إذا استمرّ الوضع هكذا

136
00:11:41,680 --> 00:11:42,800
.أنا آسف

137
00:11:43,050 --> 00:11:45,050
...جلستُ وبدأت أفكّر، ثمّ

138
00:11:45,050 --> 00:11:46,610
.أظنّ أنّ الإرهاق بدأ يسيطر عليّ

139
00:12:04,800 --> 00:12:05,880
ما هذا؟

140
00:12:06,530 --> 00:12:09,310
...يبدو أنّنا متنا جميعًا

141
00:12:09,880 --> 00:12:12,950
.لكن مجرّد وجودك هنا يشعرني بتحسّن

142
00:12:13,280 --> 00:12:14,160
ماذا؟

143
00:12:14,530 --> 00:12:18,110
.أمّا الآن، أحتاج منك أن تسجّل نفسك كباحث

144
00:12:18,110 --> 00:12:20,160
.يرجى كتابة مهنتك في النّموذج

145
00:12:20,160 --> 00:12:23,520
...لكن... أنا متأكّد تمامًا أنّني جئت فقط لزيارة

146
00:12:25,370 --> 00:12:29,690
.ذكرياتك مشوّشة لأنّك عدت للحياة للتّوّ

147
00:12:29,690 --> 00:12:34,680
،إذا كان عقلك مشوّشًا للغاية
.فسأختار المهنة المناسبة لك

148
00:12:37,260 --> 00:12:37,870
ماذا؟

149
00:12:37,870 --> 00:12:41,650
.تهانينا يا سيّد أتوبي. لقد قُبل طلبك

150
00:12:41,650 --> 00:12:45,110
!أنت الآن بطل أرض المتاهات

151
00:12:50,820 --> 00:12:56,110
إذًا يبدو أنّك ستبدأ حياة جديدة
هنا بصفتك بطلاً، أليس كذلك؟

152
00:12:57,450 --> 00:13:02,420
،شكّل فرقة معي. بوجود بطل في صفّنا
.لن يكون لدينا ما نخشاه

153
00:13:02,420 --> 00:13:04,340
!انضم إليّ أنا أيضًا

154
00:13:04,340 --> 00:13:07,140
!أنا محظوظة جدًّا لأنّني التقيت ببطل حقيقيّ

155
00:13:07,140 --> 00:13:09,260
!أرجوك، اسمح لي بالانضمام إلى فرقتك

156
00:13:09,500 --> 00:13:13,140
...مـ-مهلاً... كلّ هذا مفاجئ للغاية

157
00:13:13,340 --> 00:13:16,880
!بالطّبع لا نمانع الأمر
!لقد تشكّلت فرقة البطل

158
00:13:16,880 --> 00:13:17,860
ماذا؟

159
00:13:17,860 --> 00:13:19,860
!مرحى! كم أنا سعيدة

160
00:13:19,860 --> 00:13:21,820
!شكرًا جزيلاً لكم

161
00:13:22,060 --> 00:13:25,440
...حـ-حسنًا، إن كان ذلك سيسعدكنّ جميعًا

162
00:13:26,220 --> 00:13:27,080
!أجل

163
00:13:27,080 --> 00:13:28,610
!هذا هو بطلنا

164
00:13:28,610 --> 00:13:30,870
!قوّة البطل لا تضاهى

165
00:13:30,870 --> 00:13:32,530
!ليتني أستطيع أن أكون مثله

166
00:13:32,530 --> 00:13:35,420
!أخي البطل رائع جدًّا

167
00:13:35,810 --> 00:13:38,310
...لم أتخيّل يومًا أنّني قد أصبح بطلاً

168
00:13:38,310 --> 00:13:41,040
ربّما لم تكن فكرة الولادة
.من جديد سيّئة للغاية

169
00:13:50,830 --> 00:13:52,230
!لنذهب ونقدّم المساعدة

170
00:13:52,230 --> 00:13:53,350
لماذا؟

171
00:13:53,350 --> 00:13:54,130
ماذا؟

172
00:13:54,130 --> 00:13:57,030
لماذا تريد مساعدة الغرباء؟

173
00:13:57,030 --> 00:14:00,980
.لن يلومك أحد إن لم تساعدهم

174
00:14:01,300 --> 00:14:03,610
...لكن علينا فعل ذلك، وإلاّ فإنّهم

175
00:14:03,610 --> 00:14:08,280
هل من الضّروريّ حقًّا أن تتحمّل
المسؤوليّة كلّما مات شخص عابر؟

176
00:14:08,610 --> 00:14:10,070
أليس كذلك؟

177
00:14:10,070 --> 00:14:12,320
!علينا أن نأخذ الأمور ببساطة أكبر

178
00:14:12,620 --> 00:14:13,440
...لكن

179
00:14:13,440 --> 00:14:16,830
.لم يطلب منك أحد المساعدة، على أيّة حال

180
00:14:18,610 --> 00:14:20,000
.معك حقّ

181
00:14:20,690 --> 00:14:24,850
من الحماقة أن أخاطر بحياتي
.من أجل شخص لم يطلب منّي ذلك

182
00:14:25,790 --> 00:14:28,060
.هذا... صحيح

183
00:14:36,970 --> 00:14:37,770
.لا

184
00:14:39,470 --> 00:14:40,700
.لا

185
00:14:41,870 --> 00:14:42,880
...أنا

186
00:14:44,130 --> 00:14:45,390
...ما زلتُ

187
00:14:47,360 --> 00:14:50,130
...أريد المساعدة. أريد

188
00:14:51,370 --> 00:14:53,090
!مساعدة النّاس

189
00:14:57,960 --> 00:15:02,490
،بدوتَ أكثر فائدةً من الفتاة
.لذا قرّرتُ استبدالها

190
00:15:02,490 --> 00:15:05,090
!الكرمة محرّكة الدّمى؟ ألا تزالين حيّة؟

191
00:15:05,090 --> 00:15:09,770
أنت داخل عقلي. والّطريقة
.الوحيدة للنّجاة هي بهزيمتي

192
00:15:09,770 --> 00:15:11,930
.وليس لديك أيّ وسيلة لفعل ذلك

193
00:15:14,630 --> 00:15:19,790
،اخترتَ بحماقةٍ الخضوعَ لسيطرتي
.حتّى بعد أن مُنحتِ السّعادة

194
00:15:19,790 --> 00:15:21,630
.لذا، كلّ ما عليّ فعله هو تحطيمك

195
00:15:22,600 --> 00:15:25,670
.بمجرّد أن يتحطّم عقلك، سيموت جسدك

196
00:15:25,670 --> 00:15:28,690
.هذه فرصتك الأخيرة لتطيعني

197
00:15:28,980 --> 00:15:30,400
!أرفض ذلك

198
00:15:30,400 --> 00:15:32,350
!إذًا... مت

199
00:15:37,770 --> 00:15:40,750
...تيريزيا؟ كيف

200
00:15:40,750 --> 00:15:42,510
...عبدة

201
00:15:42,510 --> 00:15:44,680
هل تتبّعتِ الرّابط بينك وبينه عبر الختم؟

202
00:15:45,370 --> 00:15:48,060
هل جئتِ... لإنقاذي؟

203
00:15:48,630 --> 00:15:50,400
.هذا عبث

204
00:15:50,400 --> 00:15:52,740
.لا يمكن إدخال الأسلحة إلى هنا

205
00:15:52,740 --> 00:15:55,100
!لا توجد أيّ طريقة لتنتصري

206
00:15:56,520 --> 00:15:58,270
!تيريزيا! سأدعمك

207
00:15:59,530 --> 00:16:00,630
!يمكننا فعلها

208
00:16:00,630 --> 00:16:03,640
!دعم الهجوم! انطلقي يا تيريزيا

209
00:16:24,700 --> 00:16:26,030
...تيريزيا

210
00:16:26,880 --> 00:16:29,780
.شكرًا لك. لقد أنقذتنا

211
00:16:33,660 --> 00:16:36,250
.أعتذر لأنّني أقلقتك

212
00:16:37,980 --> 00:16:42,660
ظننتُ خطأً أنّ بإمكاني
.حماية كلّ شيء بمفردي

213
00:16:44,050 --> 00:16:49,050
وبوظيفة لا تتيح لي مساعدة سوى
...الأشخاص الموجودين أمامي مباشرة

214
00:16:58,580 --> 00:17:00,220
أسقط الوحش مكافأة؟

215
00:17:00,220 --> 00:17:02,750
.لا، هذه بذرة ذلك الوحش

216
00:17:03,080 --> 00:17:04,750
...إذًا، لا يزال حيًّا

217
00:17:05,490 --> 00:17:06,970
!لا، مهلاً

218
00:17:06,970 --> 00:17:10,070
إذا تمكّنّا من تدريبه، فسيكون
.عونًا كبيرًا في المعركة

219
00:17:10,070 --> 00:17:12,290
.لنأخذها إلى مزرعة الوحوش

220
00:17:19,470 --> 00:17:21,420
آنسة صوفي؟

221
00:17:22,050 --> 00:17:26,260
.كنتُ أحلم... حلمًا سيّئًا

222
00:17:26,740 --> 00:17:30,220
.أظنّ أنّكم أنهيتم ذلك الحلم من أجلي

223
00:17:30,620 --> 00:17:31,950
.يا له من شعور بالرّاحة

224
00:17:33,850 --> 00:17:35,690
...لعنة أنصاف البشر

225
00:17:36,050 --> 00:17:40,460
...لولا ذلك، لكنتِ حقًّا

226
00:17:44,990 --> 00:17:47,790
كانت على وشك قول
شيء ما، أليس كذلك؟

227
00:17:48,120 --> 00:17:52,120
عند التّفكير في الأمر، لم تكوني
.ترتدين قناعك هناك

228
00:17:53,200 --> 00:17:55,990
،لم أستطع رؤية ذلك لأنّني كنتُ خلفكِ

229
00:17:55,990 --> 00:17:58,090
لكن أظنّ أنّ الآنسة صوفي
.استطاعت رؤية كلّ شيء

230
00:17:58,090 --> 00:18:00,780
.ربّما كان ذلك ما أرادت قوله

231
00:18:01,940 --> 00:18:03,680
...ليتني تمكّنتُ من رؤية ذلك أيضًا

232
00:18:03,680 --> 00:18:06,940
لكنّني أظنّ أنّ قول ذلك ليس
مفيدًا لك، أليس كذلك؟

233
00:18:11,740 --> 00:18:15,430
،عـ-على مهلك، حتّى عندما تقتربين
.لا أستطيع رؤيته أنا أيضًا، كما تعلمين

234
00:18:21,450 --> 00:18:23,970
.لا أصدّق أنّ ذلك الوحش كان لا يزال حيًّا

235
00:18:23,970 --> 00:18:25,940
.أنا مسرورة لأنّكما بخير

236
00:18:25,940 --> 00:18:29,450
،كان الأمر مخيفًا بعض الشّيء
.لكنّنا تمكّنّا من تجاوزه

237
00:18:29,710 --> 00:18:32,320
.وقد خرجنا بشيء مفيد من التّجربة أيضًا

238
00:18:32,320 --> 00:18:34,390
.آمل أن يكون بالإمكان تدريبه فعلاً

239
00:18:34,390 --> 00:18:36,810
.لا ضير في أخذه إلى هناك ورؤية الأمر

240
00:18:36,810 --> 00:18:39,760
ميليسا، إنّ موادّ شَجريّ الخوف
...ينبغي أن تكون

241
00:18:39,760 --> 00:18:40,840
.لقد حصلتُ عليها

242
00:18:40,840 --> 00:18:43,710
.يمكنني صنع مجموعة من العتاد الخشبيّ منها

243
00:18:43,710 --> 00:18:46,680
.أو يمكنني بيعها كما هي مقابل المال

244
00:18:46,680 --> 00:18:48,320
.سأطلب تقديرًا لقيمتها

245
00:18:48,320 --> 00:18:50,420
.شكرًا لك. نعتمد عليك

246
00:18:52,030 --> 00:18:53,280
ما هذا الصّوت؟

247
00:18:53,280 --> 00:18:56,230
.مهلاً... يبدو أنّها رخصتي

248
00:18:58,030 --> 00:19:00,230
رسالة من أريادني؟

249
00:19:00,630 --> 00:19:04,570
.ربّما تحاول إخبارنا بشيء ما

250
00:19:06,440 --> 00:19:09,680
سوزونا، لِمَ لا تجرّبين استخدام الوسيط؟

251
00:19:09,680 --> 00:19:10,900
.حسنًا

252
00:19:12,140 --> 00:19:17,570
ادخلي في هذا الوعاء
.ودعي العالم يسمع صوتك

253
00:19:22,430 --> 00:19:25,300
هل هذا حارس الصّفوف الخلفيّة؟

254
00:19:25,300 --> 00:19:27,210
.نعم، إنّه أنا

255
00:19:27,210 --> 00:19:29,890
.شكرًا لمساعدتك أثناء تدافع الوحوش

256
00:19:29,890 --> 00:19:34,000
.من شيم الآلهة الخفيّة أن تمنح الحماية لأتباعها

257
00:19:34,000 --> 00:19:35,490
.لا داعي للشّكر

258
00:19:35,490 --> 00:19:38,890
.حسنًا. لكنّك كنت عونًا كبيرًا حقًّا

259
00:19:38,890 --> 00:19:42,320
على أيّة حال، هل كان هناك
شيء تودّين إخبارنا به؟

260
00:19:42,520 --> 00:19:47,780
جئتُ لأحذّركم بشأن صندوق الكنز
.الأسود الّذي حصلتم عليه للتّوّ

261
00:19:48,790 --> 00:19:50,320
تقصدين هذا؟

262
00:19:50,320 --> 00:19:52,250
هل ينطوي على أيّ خطر؟

263
00:19:52,650 --> 00:19:56,580
يحتوي صندوق الكنز الأسود
.ذاك على التّسليح

264
00:19:56,580 --> 00:19:58,190
التّسليح؟

265
00:19:58,190 --> 00:20:01,370
."اسمه الرّسميّ هو "الملحق المدرّع

266
00:20:01,660 --> 00:20:05,140
.إنّه أحد الأجزاء الّتي أفتقدها
.أو بتعبير آخر، أثر مقدّس

267
00:20:05,510 --> 00:20:08,700
،بمجرّد الحصول عليه، ستتحسّن مهاراتي

268
00:20:08,700 --> 00:20:11,610
.وستقترب لحظة هروبي من هذا الطّابق

269
00:20:11,610 --> 00:20:14,010
.إذًا، علينا أن نفتحه فورًا

270
00:20:14,010 --> 00:20:17,460
.كلاّ. ترفض الآثار المقدّسة أن يستحوذ عليها أحد

271
00:20:17,460 --> 00:20:20,070
.ستشنّ قتالاً عنيفًا دفاعًا عن نفسها

272
00:20:20,070 --> 00:20:24,810
ومن الوارد جدًّا أن يفقد من
.يحاول الحصول عليها حياته

273
00:20:24,810 --> 00:20:26,840
.هذا ليس مطمئنًا

274
00:20:27,320 --> 00:20:30,450
ألا يمكنك صدّه باستخدام
ذراع الحراسة خاصّتك؟

275
00:20:30,450 --> 00:20:35,000
كلّ ما يمكنني قوله هو أنّها قد تكون قادرة
.على صدّه إذا توافرت الشّروط المناسبة

276
00:20:37,110 --> 00:20:39,460
.أريد فتح الصّندوق

277
00:20:39,460 --> 00:20:41,740
.حتّى لو كان ذلك سيعرّض حياتي للخطر

278
00:20:43,280 --> 00:20:46,690
،إذا كان ذلك سيمنحك القوّة ويُتيح لك الهرب

279
00:20:46,690 --> 00:20:48,810
فستكونين عونًا لنا في السّعي
.نحو أهداف أسمى

280
00:20:49,250 --> 00:20:53,500
يمكنك مساعدتنا في إعادة تيريزيا
.إلى هيئتها البشريّة وإنقاذ صديقة إليتيا

281
00:20:54,070 --> 00:20:57,380
وأعلم أنّ بإمكانك أيضًا تمكيننا
.من مساعدة المزيد من النّاس

282
00:20:57,730 --> 00:21:00,660
.لكنّني لا أستطيع فعل أيّ شيء بمفردي

283
00:21:01,380 --> 00:21:05,450
.أريدكنّ جميعًا مشاركتي في هذا الأمر
.أعدكنّ بأنّني سأحميكنّ

284
00:21:06,400 --> 00:21:10,240
.لا يمكن لأيّ منّا إنجاز الأمر بمفرده

285
00:21:10,240 --> 00:21:11,840
.هذه رغبتنا أيضًا

286
00:21:12,900 --> 00:21:14,920
.وتوافق كاهنة المعبد أيضًا

287
00:21:14,920 --> 00:21:19,410
.سأوفّر كلّ الحماية الممكنة عندما تفتح الصّندوق

288
00:21:19,410 --> 00:21:21,630
.سأكون ممتنًّا جدًّا لذلك

289
00:21:21,630 --> 00:21:23,210
.مفهوم

290
00:21:25,470 --> 00:21:26,710
...يا رفيقات

291
00:21:29,940 --> 00:21:31,050
.شكرًا لكنّ

292
00:21:35,440 --> 00:21:37,500
حسنًا، هل نبدأ؟

293
00:21:39,140 --> 00:21:41,230
!إنّهم غيورغ والبقيّة

294
00:21:41,490 --> 00:21:43,060
هل أنتم بخير الآن؟

295
00:21:43,060 --> 00:21:44,120
.أجل

296
00:21:44,900 --> 00:21:47,780
.شكرًا جزيلاً لك على كلّ شيء

297
00:21:48,060 --> 00:21:49,740
ماذا ستفعلون بعد الآن؟

298
00:21:50,150 --> 00:21:51,390
.سأواصل طريقي

299
00:21:52,050 --> 00:21:55,270
.سأظلّ باحثًا، وسأبقى مع هذه الفرقة

300
00:21:55,930 --> 00:21:57,730
.والفضل في ذلك يعود إليك

301
00:21:57,730 --> 00:22:01,080
أنت تشبه تمامًا السّاموراي
.الّذي طالما نظرتُ إليه بإعجاب

302
00:22:01,330 --> 00:22:04,040
.لديك المهارات والقلب القويّ

303
00:22:05,780 --> 00:22:08,840
.لا... أنا مجرّد حارس صفوف خلفيّة