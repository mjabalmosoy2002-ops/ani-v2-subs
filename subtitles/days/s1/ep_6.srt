289
00:17:41,870 --> 00:17:47,620
!تسوكاموتو يتحدّث إلى كيميشيتا-سينباي كشخصٍ عادي

290
00:17:47,620 --> 00:17:53,710
.وأظنّ أيضًا أنّي نسيتُ أحذيتي بمتجرك

291
00:17:54,420 --> 00:17:55,950
!ها هي ذي

292
00:17:55,950 --> 00:17:56,890
.تسوكاموتو

293
00:17:56,890 --> 00:17:57,580
نعم؟

294
00:17:58,110 --> 00:17:59,640
هل عائلتك فقيرة؟

295
00:17:59,640 --> 00:18:00,670
...أيّ

296
00:18:00,670 --> 00:18:01,530
...سؤالٍ...

297
00:18:01,530 --> 00:18:02,890
هذا؟...

298
00:18:03,320 --> 00:18:06,350
،حسنٌ، أمّي تهتمّ بي لوحدها لذا ما كنتُ لأقول أننا أثرياء

299
00:18:06,350 --> 00:18:08,390
!لكني أحظى بحياةٍ سعيدة

300
00:18:10,730 --> 00:18:12,280
.يبدو هذا كمنزلي

301
00:18:16,970 --> 00:18:17,940
.آسف

302
00:18:17,940 --> 00:18:19,350
.شكرًا جزيلًا

303
00:18:19,350 --> 00:18:22,130
.سأقتلك إن نسيتها مجدّدًا

304
00:18:22,130 --> 00:18:22,960
!حاضر

305
00:18:32,840 --> 00:18:34,190
ما الذي يجري؟

306
00:18:34,190 --> 00:18:36,760
!إنها تبدو جديدةً تمامًا

307
00:18:37,260 --> 00:18:40,500
...وبها أربطة جديدة

308
00:18:40,500 --> 00:18:42,260
.وقد تمّ ترميم كل الثقوب والشقوق

309
00:18:42,260 --> 00:18:44,760
.اخرس وأخرج الكرات

310
00:18:44,760 --> 00:18:45,950
!أعدّوا كلّ شيء

311
00:18:45,950 --> 00:18:47,420
!حاضر

312
00:18:48,250 --> 00:18:49,640
.لقد كانت رثّة

313
00:18:49,640 --> 00:18:50,640
عذرًا؟

314
00:18:50,640 --> 00:18:52,270
.لكنها جيدة وناعمة

315
00:18:52,590 --> 00:18:53,430
ماذا؟

316
00:18:53,430 --> 00:18:56,280
