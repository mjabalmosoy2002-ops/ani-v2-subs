1
00:00:50,000 --> 00:00:50,790
هنا-
!دوري، دوري-

2
00:00:50,800 --> 00:00:51,500
هذه لك

3
00:00:52,040 --> 00:00:53,040
!عُد غداً

4
00:00:53,870 --> 00:00:54,790
حسناً-
!سأترك هذا الصّندوق هنا-

5
00:00:55,750 --> 00:00:56,790
حسناً، شكراً

6
00:00:57,620 --> 00:00:59,790
نحن على وشك أن نكسر رقماً
قياسيّاً آخر في المبيعات اليوم

7
00:01:01,290 --> 00:01:01,870
بالتّأكيد

8
00:01:02,980 --> 00:01:04,130
،بعد هذه الأيّام القليلة من التّدريب

9
00:01:04,250 --> 00:01:06,290
أشعر بأنّ عضلات فخذي قويّة الآن

10
00:01:09,040 --> 00:01:09,850
دعني

11
00:01:10,390 --> 00:01:12,140
الملك لي، أنت تعمل بجهدٍ حثيث
في كلّ ليلة

12
00:01:12,600 --> 00:01:13,720
استرح أثناء النّهار فحسب

13
00:01:13,970 --> 00:01:15,350
...أنا بخير. إنّه ليس

14
00:01:15,850 --> 00:01:16,140
ثقيلاً

15
00:01:16,970 --> 00:01:18,270
لا تضغط على نفسك

16
00:01:18,720 --> 00:01:20,970
انظر إلى نفسك. تبدو مُرهقاً
لدرجة تُغمغم بالكلام

17
00:01:21,020 --> 00:01:22,390
شـ-شكراً لك

18
00:01:24,470 --> 00:01:25,850
قلت بأنّك تستطيع تحمُّل الخمر

19
00:01:25,970 --> 00:01:28,890
،مع كلّ تلك الحازوقات المُستمرّة
ربّما ينبغي أن تتوقّف عن الشّرب

20
00:01:29,100 --> 00:01:33,100
،الملك لي، أنت قائدٌ حقيقيّ
مع ذلك من السّهل التقرُّب منك

21
00:01:33,720 --> 00:01:34,970
أمام الآخرين، نادِني مياو فحسب

22
00:01:36,350 --> 00:01:37,600
هذه مُجاملة مُبالغ بها

23
00:01:38,020 --> 00:01:41,970
لم أقصد الكثير آنذاك، رغم
ذلك أثّر في قلبه بشدّة

24
00:01:42,100 --> 00:01:42,890
!يا للعجب

25
00:01:43,350 --> 00:01:44,600
أنت لا تُصدِّق ذلك، صحيح؟

26
00:01:45,720 --> 00:01:48,350
يا فتى، أنت لا تفهم الولاء بعد

27
00:01:48,470 --> 00:01:49,220
اقترب الظّهر

28
00:01:49,890 --> 00:01:51,100
لم يأتِ إليّ ذلك الثّريّ بعد

29
00:01:51,970 --> 00:01:53,970
العلاقات المبنيّة على الرّبح هشّة

30
00:01:54,770 --> 00:02:00,220
،حصلتُ على حصّة كبيرة من عمله
وعرضتُ التّعاون معاً

31
00:02:01,270 --> 00:02:02,850
لديه كُلّ سبب للاستمرار في التّفاوض

32
00:02:07,100 --> 00:02:09,390
يوم مُزدحم، أكثر إرهاقاً من التّمارين

33
00:02:10,970 --> 00:02:13,770
با، إلى أين ذهبت للتمرُّن اليوم؟

34
00:02:14,770 --> 00:02:15,350
تقرير حضرة القائد

35
00:02:15,970 --> 00:02:18,100
تفقّدتُ حُرّاس الأمن بالقرب
من حدود الحيّ 10

36
00:02:19,270 --> 00:02:22,600
هل مررت أيضاً بعربة تلك المجموعة
ومددت لهم يد العون؟

37
00:02:23,100 --> 00:02:23,600
لا

38
00:02:24,140 --> 00:02:25,470
أنا لا أنسجم مع أولئك الباعة

39
00:02:25,720 --> 00:02:29,390
قضيتُ طوال الأمس وأنا أنقل
مخزوناً من مُستودع المطبخ المركزيّ

40
00:02:29,850 --> 00:02:31,470
ووجدتُ أنّ الكثير من المُكوّنات مفقودة

41
00:02:32,100 --> 00:02:33,350
هل تعرف أين اختفت؟

42
00:02:34,850 --> 00:02:38,970
يبدو أنّ هجوم الآفة السّابق كان
أنت بالفعل مَن أعانهم

43
00:02:39,720 --> 00:02:41,220
ينبغي أن تعرف القوانين

44
00:02:41,890 --> 00:02:45,140
مصير الخائن هو الموت

45
00:02:50,520 --> 00:02:53,390
،بالطّبع، إذا أردت التخفِّي

46
00:02:53,470 --> 00:02:54,850
فيمكنني أن أختصر عليك الطّريق

47
00:02:59,220 --> 00:02:59,850
آسف يا حضرة القائد

48
00:03:00,100 --> 00:03:01,220
لديّ مهمّة أهمّ

49
00:03:01,470 --> 00:03:03,720
يبدو أنّهم يدفعون لك أجراً جيّداً

50
00:03:15,720 --> 00:03:16,770
المسألة لا تتعلّق بما يدفعونه

51
00:03:17,020 --> 00:03:18,350
بل بما أنا مَدين لهم بالكثير

52
00:03:18,470 --> 00:03:21,220
سأمنحك فُرصة أخيرة للاختيار

53
00:03:23,100 --> 00:03:23,850
لا حاجة

54
00:03:34,470 --> 00:03:35,100
أنباء سارّة

55
00:03:35,600 --> 00:03:36,850
!دخل اليوم كسرَ حاجز الـ 10000. تهانينا

56
00:03:37,470 --> 00:03:40,350
أيّها الشّابّ، كيف نُوسّع سياسة
مصالح النّاس؟

57
00:03:40,470 --> 00:03:41,850
حسناً، إنّه المساء بالفعل

58
00:03:42,600 --> 00:03:43,970
أيّ شخص يريد التّعاون في العمل
يجب أن يأتي الآن

59
00:03:44,220 --> 00:03:45,600
لن يحدث شيء اليوم على ما أعتقد

60
00:03:46,470 --> 00:03:47,270
هذا غريب

61
00:03:48,100 --> 00:03:48,720
...أيُّها الشّابّ

62
00:03:49,850 --> 00:03:50,970
آسف، شردت

63
00:03:51,770 --> 00:03:55,770
إلى متى سنستمرّ في بيع خبز رخيص
لجذب هؤلاء السكّان المحلّيّين لصفّنا؟

64
00:03:55,970 --> 00:03:59,020
،وأيضاً، كلّ هذا المال الّذي كنت تكسبه
ماذا تنوي أن تفعل به؟

65
00:04:04,470 --> 00:04:05,100
حسناً، حسناً

66
00:04:05,520 --> 00:04:08,470
أنتم تُؤسّسون طاقماً لأنفسكم

67
00:04:08,640 --> 00:04:11,270
يبدو أنّني تداركتُ الوقت

68
00:04:13,390 --> 00:04:13,970
هل أنتِ بخير؟

69
00:04:15,720 --> 00:04:17,470
...أنا بخير، لكن

70
00:04:18,100 --> 00:04:19,890
لِمَ يستهدفنا قائد الحرس؟

71
00:04:20,020 --> 00:04:20,600
وهل من حاجة للسّؤال؟

72
00:04:21,100 --> 00:04:23,220
ذلك الهجوم قبل أيّام... كان هو أيضاً

73
00:04:23,600 --> 00:04:24,720
لي، ابقَ هادئاً

74
00:04:25,470 --> 00:04:26,520
أعلم، أعلم

75
00:04:26,890 --> 00:04:28,270
في السّابق، كنّا نتعامل مع مُجرم خطير

76
00:04:28,640 --> 00:04:29,470
لم يكترث أحدٌ له

77
00:04:30,220 --> 00:04:31,520
لكنّنا نتعامل هنا مع قائد الحرس

78
00:04:32,220 --> 00:04:34,600
إن أصابه مكروه، فسيُهاجمنا
الحيّ 9 بأكمله

79
00:04:35,350 --> 00:04:36,600
حتّى ذلك المحتال

80
00:04:37,600 --> 00:04:38,470
لكن إليك ما سأقوله

81
00:04:39,270 --> 00:04:43,470
حتّى ببصيرتك بعيدة المدى، ستبقى
أحمق في الوقت الرّاهن

82
00:04:44,140 --> 00:04:46,600
لأنّ الآن، ثمّة شخص عليّ حمايته

83
00:04:47,140 --> 00:04:50,140
،عوضاً عن كسب القلوب بالرّبح
تهمّني المشاعر أكثر

84
00:04:50,270 --> 00:04:52,470
أنا مُجرّد مُتوحّش يتّبع قانون جيانغو

85
00:04:52,770 --> 00:04:57,350
وبسبب ذلك، لم أعرف حتّى بأنّ النّاس
هنا كانوا يعيشون حياة ظالمة

86
00:04:57,770 --> 00:04:59,970
لذا، هذه المرّة، سأصغي لك

87
00:05:07,220 --> 00:05:10,220
بالمناسبة، قال أحدٌ بأنّه مَدين لكم بشيء

88
00:05:10,470 --> 00:05:11,640
وطلب منّي إحضاره

89
00:05:22,220 --> 00:05:25,350
هذه الحياة، أُعيدها إليكم

90
00:05:25,550 --> 00:05:35,850
با، هل قرّرت ما ستفعله؟

91
00:05:37,970 --> 00:05:42,220
كهديّة ردّ، بخصوص وفاة رئيس
،الطبّاخين ودافعك الحقيقيّ

92
00:05:42,720 --> 00:05:44,720
هل يمكنك أن تشرح لي الآن؟

93
00:05:53,720 --> 00:05:55,100
هلّا امتنعت عن التكلّم بالقرب منّي؟

94
00:05:55,600 --> 00:05:57,100
حتّى حازوقتي خافت منك

95
00:05:58,020 --> 00:05:59,720
ما السّحر الّذي استخدمتَه للتو؟

96
00:06:00,390 --> 00:06:01,600
عرفتُ بأنّ هناك مُشكلة ما

97
00:06:01,850 --> 00:06:05,600
بما أنّك رفضت التّعاون، فستذوق طعم الألم

98
00:06:09,100 --> 00:06:09,970
فكّرتُ في الأمر مليّاً

99
00:06:10,970 --> 00:06:11,520
أريده ميّتاً

100
00:06:13,350 --> 00:06:14,350
كما تشاء

101
00:06:53,850 --> 00:06:56,390
أنت... ما خطبك؟

102
00:07:04,520 --> 00:07:06,100
أيّها الحمقاوان عديما الجدوى

103
00:07:06,470 --> 00:07:07,720
انهضا

104
00:07:25,970 --> 00:07:27,890
يستطيع استخدام تعويذات التّعزيز

105
00:08:43,640 --> 00:08:46,720
،بما أنّك تريد اللّعب بالأنصال
فلن أتحفّظ

106
00:08:56,350 --> 00:08:59,350
فأسان برأسي كلب لا يمكنهما
هزيمة سكّين مطبخيّ

107
00:09:11,220 --> 00:09:13,020
قلتَ بأنّك قرّرت أن يموت

108
00:09:13,270 --> 00:09:13,890
ماذا تقصد؟

109
00:09:15,270 --> 00:09:17,720
لأنّ بموته فقط سيكون مُفيداً

110
00:09:18,520 --> 00:09:20,770
،من "تمرّن أكثر إن كنت سيّئاً في ذلك
"فنّ مُحرَّم

111
00:09:21,100 --> 00:09:22,470
اكتشفتُ سحراً خاصّاً

112
00:09:22,850 --> 00:09:25,520
إذا استخدمتُه، فسيضمن ذلك موت
قائد الحرس دون أن يشعر أد

113
00:09:25,970 --> 00:09:28,100
ويُسرّع مُخطّطاتنا

114
00:09:35,100 --> 00:09:36,850
يوجد سحرٌ كهذا بالفعل

115
00:09:45,640 --> 00:09:47,350
أهذا هو الفنّ المُحرَّم الّذي ذكرتَه؟

116
00:09:49,470 --> 00:09:50,140
تماماً

117
00:09:51,020 --> 00:09:52,740
فنّ إعادة تحريك الجثّة