1
00:00:49,830 --> 00:00:51,580
تسليح الجميع في الحيّ 10

2
00:00:52,120 --> 00:00:54,500
النّاس هنا بالكاد لديهم ما يكفي
للأكل، ناهيك عن القتال

3
00:00:55,200 --> 00:00:56,700
من قال بأنّني سأُسلّحهم بالقوّة؟

4
00:00:58,450 --> 00:01:01,330
أجسادهم هزيلة. سنتولّى الأمر بالسُّبُل
غير التّقليديّة، السّحر

5
00:01:02,330 --> 00:01:03,080
ماذا؟

6
00:01:03,500 --> 00:01:05,330
ستُروّج للسّحر في الحيّ 10 برمّته؟

7
00:01:06,620 --> 00:01:07,080
تماماً

8
00:01:07,830 --> 00:01:09,250
،يستغرق التّطوير الاقتصاديّ وقتاً

9
00:01:09,580 --> 00:01:11,870
وهذا هو الوقت المثاليّ لنشر السّحر

10
00:01:12,200 --> 00:01:14,200
سنسعى خلف الأمرين بحماس مُكافئ

11
00:01:14,700 --> 00:01:17,580
إن وثقت بي، فاترك الاقتصاد على عاتقي

12
00:01:17,950 --> 00:01:20,950
بهذه الطّريقة يمكنك توفير طاقة إضافيّة
لتدريب فيلق السّحر

13
00:01:22,200 --> 00:01:24,620
لديّ علاقات عمل كثيرة في الحيّ 9

14
00:01:25,000 --> 00:01:25,950
سأتواصل معهم

15
00:01:26,080 --> 00:01:27,700
ينبغي لهذا أن يُساهم في جذب
الاستثمارات بشكل أسرع

16
00:01:28,200 --> 00:01:29,220
ما رأيك بذلك؟

17
00:01:30,250 --> 00:01:32,580
قبل أيّام، كان يضمر كراهيّة
عميقة تجاهنا

18
00:01:33,000 --> 00:01:35,000
والآن يتصرّف بولاء وإخلاص

19
00:01:35,580 --> 00:01:36,580
لستُ أفهم ذلك

20
00:01:40,620 --> 00:01:42,250
حسناً، أعتمد عليك

21
00:01:42,700 --> 00:01:44,000
تكون يقِظاً جدّاً في العادة

22
00:01:44,200 --> 00:01:45,580
لِمَ هذا الاستهتار اليوم؟

23
00:01:46,330 --> 00:01:50,500
لأنّني أعتقد بأنّ ما يجعل الشّراكة
صلبة هو المنفعة المُتبادلة دوماً

24
00:01:51,330 --> 00:01:52,620
حسناً، لنُغادر

25
00:01:53,000 --> 00:01:54,080
انتظر أخباري السّارّة غداً

26
00:01:55,080 --> 00:01:55,830
كبير السّحرة لي وان

27
00:01:57,580 --> 00:02:00,200
،إذا جمعنا كافّة العُلماء وقمتَ بتوبيخ الجميع

28
00:02:00,700 --> 00:02:01,950
فكم يستغرق من وقت
حتّى يأخذ ذلك مفعوله؟

29
00:02:03,500 --> 00:02:05,700
،أيّها الشّابّ، لا أريد إفساد بهجتك

30
00:02:06,000 --> 00:02:07,700
لكنّك أهملت الشّيء الأهمّ

31
00:02:08,370 --> 00:02:09,950
،وُلِد بعض الأشخاص بقوّة سحريّة غزيرة

32
00:02:10,200 --> 00:02:12,950
لكن البعض لا يستطيعون استخدام
السّحر على الإطلاق

33
00:02:13,620 --> 00:02:16,500
يعتمد تعلُّم السّحر على الموهبة

34
00:02:19,000 --> 00:02:19,870
لا تقلق بشأن ذلك

35
00:02:20,700 --> 00:02:22,250
في اللّيلة الماضية، وأثناء
،دراسة كتاب مُحرَّم

36
00:02:22,450 --> 00:02:23,330
عثرتُ على طريقة

37
00:02:30,950 --> 00:02:32,950
فنّ مُحرَّم: انصهار السّحر

38
00:02:33,200 --> 00:02:35,080
إنّه يُخوّلني منح الآخرين قوّتي السّحريّة

39
00:02:35,830 --> 00:02:36,580
ماذا؟

40
00:02:36,950 --> 00:02:38,700
يوجد فنٌّ كهذا فعلاً؟

41
00:02:39,200 --> 00:02:41,080
إذاً أيّ شخص يستطيع أن يصبح ساحراً

42
00:02:41,950 --> 00:02:45,330
من فضلك اذهب مع لان والآنسة هوانغ
لتسجيل النّاس لإجراء مُقابلات

43
00:02:45,500 --> 00:02:46,500
حسناً

44
00:02:46,870 --> 00:02:48,830
لم أتوقّع أبداً أن يعود السّحر بهذه السّرعة

45
00:02:50,370 --> 00:02:51,250
لِمَ نحتاج مُقابلات؟

46
00:02:52,950 --> 00:02:55,700
،إذا كانت القوّة السّحريّة ستُشارك
فينبغي للجميع أن يحظوا بفُرصة عادلة

47
00:02:57,330 --> 00:03:00,080
،إذا كسب الجميع قوّةً سحريّة
فقد يجلب ذلك فوضى بدلاً من ذلك

48
00:03:00,830 --> 00:03:03,080
لذا يجب أن يتعلّمه أشخاص
مُختارون قلّة في البداية

49
00:03:04,500 --> 00:03:06,200
أنت لا تختلف عن ذلك المُستبدّ

50
00:03:07,080 --> 00:03:09,620
كان هدفي إسقاط النّظام الفئويّ
الّذي بناه السّحر

51
00:03:11,620 --> 00:03:13,700
كان نظاماً بدائيّاً يعتمد على الموهبة

52
00:03:14,250 --> 00:03:16,950
استطاع المُجرمون الترقّي من خلاله

53
00:03:17,700 --> 00:03:21,120
لكنّني الآن أعطي الأولويّة للتّدريب
والتّربية والاستقامة

54
00:03:22,580 --> 00:03:24,080
...لكن، ماذا لو

55
00:03:28,200 --> 00:03:28,870
حسناً

56
00:03:29,330 --> 00:03:30,500
لنُجرّب ذلك على طريقتك إذاً

57
00:03:32,500 --> 00:03:36,200
،لم أتوقّع بعد كلّ هذه الأيّام معاً
أن يتعلّم احترام رأي الآخرين

58
00:03:37,080 --> 00:03:38,580
شقَّ طريقه نحو العرش

59
00:03:38,950 --> 00:03:40,200
أعتقد لديه أسبابه

60
00:03:44,950 --> 00:03:46,950
حسناً. لنشرع في العمل

61
00:03:48,750 --> 00:03:50,450
كيف تستخدم انصهار السّحر هذا؟

62
00:03:53,450 --> 00:03:54,950
هذا ليس غشّاً، صحيح؟

63
00:03:55,950 --> 00:03:57,330
هناك ثلاثة أسئلة في المُقابلة

64
00:03:58,080 --> 00:03:59,700
فليصطفّ الجميع في طابور واحد

65
00:04:00,750 --> 00:04:01,450
مرحباً سيّدي

66
00:04:02,080 --> 00:04:03,870
إن كنتَ جاهزاً، فلن أتردّد

67
00:04:04,330 --> 00:04:05,080
كذلك أنا

68
00:04:05,450 --> 00:04:06,080
اطرحي السّؤال رجاء

69
00:04:06,830 --> 00:04:08,370
طائران صفراويّان يُغرّدان
وسط الصّفصاف الخضراء

70
00:04:09,250 --> 00:04:10,830
طابور من البلشون الأبيض
يصعد السّماء الزّرقاء

71
00:04:12,330 --> 00:04:14,080
يبدو أنّ الكثير في الحيّ 10 مُثقّفون

72
00:04:14,500 --> 00:04:16,370
حسناً، لا مزيد من المُضايقات

73
00:04:16,830 --> 00:04:18,120
أخبرنا، كيف تفعل هذا؟

74
00:04:20,950 --> 00:04:24,080
أوّلاً، تنقل القوّة السّحريّة
إلى رؤوس أصابعك

75
00:04:24,450 --> 00:04:25,450
ثمّ تُرتّل التّعويذة

76
00:04:27,330 --> 00:04:30,620
القوّة السّحريّة الّتي تسطع في رؤوس أصابعك
هي إيمانك الرّاسخ

77
00:04:32,830 --> 00:04:35,450
انظر. هذه القوّة السّحريّة
قد استُخرِجت

78
00:04:35,580 --> 00:04:37,500
هل هذا كثير أم قليل؟
كيف نُميّز؟

79
00:04:38,200 --> 00:04:38,950
أستطيع الشُّعور بها

80
00:04:39,080 --> 00:04:41,080
قوّتك السّحريّة هي أشبه بمُحيط واسع

81
00:04:41,200 --> 00:04:43,200
وأخذتُ ما يملأ ملعقة منه فقط

82
00:04:43,450 --> 00:04:45,950
بالنّسبة للعاديّين، ينبغي
لهذا أن يُرضيهم

83
00:04:49,370 --> 00:04:50,330
لحظة، ثمّة شيء غريب

84
00:04:50,500 --> 00:04:52,500
استخرجت التّعويذةُ القوّةَ السّحريّة

85
00:04:52,830 --> 00:04:54,080
لكن لا توجد خطوة انصهار

86
00:04:55,000 --> 00:04:55,500
تهانينا

87
00:04:55,620 --> 00:04:59,200
.نجحت في ثلاث مراحل على التّوالي
سيّدي، ادخل كي تتعمّد سحريّاً

88
00:04:59,830 --> 00:05:01,250
شكراً لكِ. أنا مُمتنّ

89
00:05:03,250 --> 00:05:03,870
!رائع

90
00:05:04,370 --> 00:05:06,450
أوّل من نجح في الاختبار كان
المُعلّم في الأمس

91
00:05:07,080 --> 00:05:09,580
إذاً رئيس الحيّ الجديد كان
مُتخفّياً في الأمس

92
00:05:10,250 --> 00:05:11,080
أنت لطيف جدّاً

93
00:05:11,580 --> 00:05:13,450
سيّدي، لنبدأ

94
00:05:13,870 --> 00:05:15,080
حسناً. آسف على الإزعاج

95
00:05:16,870 --> 00:05:21,700
انصهار... السّحر

96
00:05:29,870 --> 00:05:31,250
لماذا لم ينجح ذلك؟

97
00:05:31,450 --> 00:05:33,200
كنتَ شديداً جدّاً

98
00:05:33,450 --> 00:05:35,500
لم يذكر الكتابُ المُحرَّم أين في أيّ
جزء من الجسد يجب وضعه

99
00:05:36,080 --> 00:05:37,950
ألم يكن من المُفترض أن تمنحنا السّحر؟

100
00:05:38,120 --> 00:05:40,000
أرى أنّه يتمّ نقله إلى المشفى

101
00:05:40,580 --> 00:05:41,330
لا تقلقوا جميعاً

102
00:05:41,580 --> 00:05:43,450
ارتطمَ رأسه بينما كان ينحني للسّيّد

103
00:05:44,700 --> 00:05:46,950
إن لم يكن بين الحاجبين، فأين
يُفترض أن يكون؟

104
00:05:48,450 --> 00:05:50,330
كيف أمكنَك فعل ذلك على جبين شخص؟

105
00:05:50,700 --> 00:05:52,450
من الطّبيعيّ أن تحتاج فتحة

106
00:05:55,580 --> 00:05:57,200
تهانينا، نجحت في الاختبار

107
00:05:57,580 --> 00:05:59,250
انصهار السّحر

108
00:06:04,950 --> 00:06:05,620
لا تقلقوا جميعاً

109
00:06:05,830 --> 00:06:07,620
إنّه مُجرّد نزيف أنف من الطّقس الجافّ

110
00:06:07,830 --> 00:06:08,500
تهانينا

111
00:06:08,750 --> 00:06:09,620
تفضّل بالدّخول

112
00:06:10,120 --> 00:06:11,870
هل يمكنني الوثوق بك؟

113
00:06:12,250 --> 00:06:13,580
انظر إليّ بعينين واسعتين

114
00:06:14,000 --> 00:06:14,950
بالطّبع

115
00:06:22,950 --> 00:06:24,700
كنتُ أعمى تماماً

116
00:06:25,370 --> 00:06:26,750
!عيناي

117
00:06:27,200 --> 00:06:27,950
لا تقلقوا جميعاً

118
00:06:28,120 --> 00:06:30,080
مُجرّد إجهاد في العين نتيجة
الدّراسة الحثيثة

119
00:06:31,450 --> 00:06:32,500
انصهار السّحر

120
00:06:33,580 --> 00:06:35,120
لا تقلقوا جميعاً

121
00:06:35,370 --> 00:06:36,950
انصهار السّحر

122
00:06:37,330 --> 00:06:37,870
تهانينا

123
00:06:38,750 --> 00:06:40,330
انصهار السّحر

124
00:06:40,750 --> 00:06:41,830
مهلاً يا فتى

125
00:06:42,000 --> 00:06:42,950
عُد ما دمتَ تستطيع

126
00:06:43,120 --> 00:06:45,950
البوّابة نحو عالم السّحر فُتِحَتْ لك

127
00:06:48,620 --> 00:06:50,080
سيّدي، كُفّ عن الصُّراخ

128
00:06:50,580 --> 00:06:53,120
هذه هي بوّابة السّحر، وباب الموت

129
00:06:55,200 --> 00:06:57,080
فنُّك المُحرَّم لا يخدم أحداً

130
00:06:57,330 --> 00:06:59,000
على العكس، إنّه يؤذي الآخرين

131
00:06:59,700 --> 00:07:00,870
حسناً، كُفّ عن التّلويح بيديك

132
00:07:01,080 --> 00:07:02,080
أخفتَ الجميع

133
00:07:03,950 --> 00:07:05,330
امنحني القوّة رجاء

134
00:07:07,450 --> 00:07:08,080
خبير آخر؟

135
00:07:08,950 --> 00:07:11,870
سمعتُ اليوم، بأنّ حكومة الحيّ
ستعقد اجتماع منح السّحر

136
00:07:12,950 --> 00:07:14,080
أرغب في تجربة ذلك

137
00:07:14,450 --> 00:07:16,080
أيّها الشّابّ، شجاعتك جديرة بالثّناء

138
00:07:17,000 --> 00:07:18,330
هلّا سألتُ عن اسمك؟

139
00:07:18,700 --> 00:07:19,450
أنا داتوي

140
00:07:19,750 --> 00:07:21,200
داتوي يعني فخذ

141
00:07:21,700 --> 00:07:23,000
أخيراً، شخص عاديّ

142
00:07:24,330 --> 00:07:25,950
يبدو هذا الاسم موثوقاً

143
00:07:29,750 --> 00:07:31,200
قَلبُ نبات الدُّخن تحت شمس
مُنتصف النّهار

144
00:07:31,830 --> 00:07:32,950
أعشق ناناكو

145
00:07:35,330 --> 00:07:36,370
هل يعبث معي؟

146
00:07:37,000 --> 00:07:38,120
آنسة هوانغ، اهدئي

147
00:07:38,200 --> 00:07:39,370
لم يبقَ غيره الآن

148
00:07:39,580 --> 00:07:41,080
جرّبي سؤالاً أبسط

149
00:07:42,750 --> 00:07:43,370
!صحيح

150
00:07:43,830 --> 00:07:44,450
السّؤال التّالي

151
00:07:45,580 --> 00:07:46,580
الشّمس تشرق عالياً

152
00:07:47,250 --> 00:07:48,620
أعشق ناناكو

153
00:07:48,870 --> 00:07:50,830
هذا... صحيح ثانية

154
00:07:51,120 --> 00:07:51,950
السّؤال التّالي

155
00:07:52,080 --> 00:07:53,870
اشرح بإيجاز سبب رغبتك
في تعلُّم السّحر

156
00:07:54,200 --> 00:07:55,950
قلتُها مرّتين بالفعل

157
00:07:56,450 --> 00:08:01,080
لأنّني... أعشق ناناكو

158
00:08:02,450 --> 00:08:03,450
إنّها آيدول بالنّسبة لي

159
00:08:03,950 --> 00:08:05,580
لكن الفرق شاسع بيننا

160
00:08:06,080 --> 00:08:07,250
إنّها تؤدّي في الحيّ 1 فقط

161
00:08:07,830 --> 00:08:11,700
لذا حلمي الأبديّ هو مُشاهدتها
تُؤدّي بشكل مُباشر يوماً ما

162
00:08:12,250 --> 00:08:14,580
أنت تتعلّم السّحر فقط لتُقدّس نجمة؟

163
00:08:14,950 --> 00:08:15,830
لا أستطيع قبولك

164
00:08:17,200 --> 00:08:17,620
آسف

165
00:08:18,330 --> 00:08:20,950
يجب أن يكون مُرشّح انصهار السّحر وطنيّاً

166
00:08:21,750 --> 00:08:23,620
إعادة إعمار الحيّ 10 هو هدفنا

167
00:08:23,950 --> 00:08:24,870
كلام فارغ

168
00:08:29,370 --> 00:08:29,950
لم أتوقّع ذلك

169
00:08:30,120 --> 00:08:31,330
لديه قوّة هائلة

170
00:08:31,450 --> 00:08:33,330
لا أكترث للعواطف أو الإعمار

171
00:08:33,580 --> 00:08:35,330
كُلّ ما أعرفه هو ما أسعى له

172
00:08:35,580 --> 00:08:37,870
وأن أعمل بلا توقُّف لأجل ذلك

173
00:08:38,000 --> 00:08:41,200
،إن لم تستخدم الانصهار معي
فسوف أشجّعها حتّى الممات

174
00:08:43,830 --> 00:08:45,700
أيّها الشّابّ، انتبه لآداب سلوكك

175
00:08:47,080 --> 00:08:47,450
آداب السّلوك؟

176
00:08:50,620 --> 00:08:51,830
هذا مُثير للاهتمام

177
00:08:52,580 --> 00:08:54,950
لم أرَ حركة قدمين وتقنيّة
جسد كهذه من قبل

178
00:08:55,700 --> 00:08:57,450
لنرَ كم حركة يمكنك أن تؤدّي

179
00:08:57,620 --> 00:08:58,950
قيِّد قوّتك

180
00:09:33,450 --> 00:09:34,200
!كان شعوراً رائعاً

181
00:09:34,750 --> 00:09:37,450
لم أتوقّع مهووس فنون قتاليّة
في الحيّ 10

182
00:09:43,580 --> 00:09:44,580
لماذا قاطعتني؟

183
00:09:45,580 --> 00:09:46,580
أتّفق مع ما قلت

184
00:09:47,830 --> 00:09:48,950
إنّه عبقريّ مهووس فعلاً

185
00:09:49,450 --> 00:09:53,580
كان رصد العيوب في حركاته ما قادني
إلى طريق انصهار السّحر الصّحيح

186
00:09:54,250 --> 00:09:57,370
القوّة السّحريّة الّتي تسطع في رؤوس
أصابعي هي إيمانك الرّاسخ

187
00:10:00,450 --> 00:10:02,080
يجب أن أصبح أقوى

188
00:10:02,500 --> 00:10:04,950
سأرى ناناكو

189
00:10:05,120 --> 00:10:08,500
!انصهار السّحر -
!أعشق ناناكو -

190
00:10:29,950 --> 00:10:32,580
أخيراً، نجح الانصهار

191
00:10:38,830 --> 00:10:39,450
هل أنت بخير؟

192
00:10:39,870 --> 00:10:40,330
كيف تشعر؟

193
00:10:40,580 --> 00:10:42,000
هل تشعر بأي قوّة سحريّة تدخل إليك؟

194
00:10:46,000 --> 00:10:47,250
ماذا حدث للتو؟

195
00:10:47,830 --> 00:10:49,200
شعرتُ بإحساس دافئ فحسب

196
00:10:51,750 --> 00:10:53,250
ما مُشكلة صوتي؟

197
00:10:55,120 --> 00:10:56,200
استرخِ أيُّها الشّابّ

198
00:10:56,500 --> 00:10:59,870
الانصهار مع قوّة سحريّة كبيرة دُفعة
واحدة يمكن أن يصدم نِظامك

199
00:11:00,000 --> 00:11:01,580
تحقّق ثانية. هل تشعر بشيء غريب آخر؟

200
00:11:05,370 --> 00:11:06,830
هل تحوّل إلى فتاة سحريّة حقّاً؟

201
00:11:08,870 --> 00:11:11,080
وجدتُ الطّريقةَ الصّحيحة لاستعماله أخيراً

202
00:11:11,580 --> 00:11:12,500
كما هو مُتوقَّع من فنٍّ مُحرَّم

203
00:11:13,000 --> 00:11:14,120
فريد من نوعه

204
00:11:21,700 --> 00:11:24,200
،يا زملائي في الوطن
،لأجل حُبّ الدّيار... والبلد

205
00:11:24,370 --> 00:11:25,500
تعالوا وتلقّوا الانصهار

206
00:11:25,700 --> 00:11:27,330
...سلِّحوا أنفسكم