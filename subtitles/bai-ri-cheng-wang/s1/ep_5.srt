1
00:00:50,170 --> 00:00:50,830
تبّاً

2
00:00:51,040 --> 00:00:52,170
كيف نمتُ كلّ هذه المدّة الطّويلة؟

3
00:00:52,710 --> 00:00:53,540
اقتربَت فترة الظّهر

4
00:00:53,540 --> 00:00:54,170
تخلّفتُ عن جدول المواعيد

5
00:00:55,170 --> 00:00:55,790
،لكن لحسن الحظّ

6
00:00:55,920 --> 00:00:57,460
خطّطتُ بالفعل للخطوة التّالية
في اللّيلة الماضية

7
00:00:57,460 --> 00:00:59,170
هل نمتَ طويلاً حتّى تيبّس عنقُك؟

8
00:00:59,540 --> 00:01:01,670
لماذا يُؤلمني عنقي أصلاً؟

9
00:01:05,290 --> 00:01:07,960
في المرّة المُقبلة، نبّهني أوّلاً

10
00:01:08,460 --> 00:01:09,920
ألا تشعر بألم؟

11
00:01:10,290 --> 00:01:11,540
يبدو أنّ تحريكها ينفع قليلاً

12
00:01:13,540 --> 00:01:14,790
تمهّل قليلاً

13
00:01:14,920 --> 00:01:16,170
أنت على وشك أن تلوي عنقي

14
00:01:19,170 --> 00:01:20,040
إنّها فترة الظّهر

15
00:01:20,290 --> 00:01:21,540
لماذا لم يستيقظ ذلك الشّابّ؟

16
00:01:22,210 --> 00:01:22,710
بالمُناسبة يا لان

17
00:01:23,330 --> 00:01:24,710
ماذا قال اسمه في ذلك اليوم؟

18
00:01:24,920 --> 00:01:25,210
مياو

19
00:01:33,080 --> 00:01:35,290
هل... يسترق النّظرات إليّ؟

20
00:01:37,040 --> 00:01:39,420
إذاً الحُبّ يجعل الشّخص طفوليّاً فعلاً

21
00:01:43,080 --> 00:01:43,830
هل رأيت ذلك؟

22
00:01:44,170 --> 00:01:45,170
تلك النّظرة من لان

23
00:01:45,330 --> 00:01:46,080
ماكرة جدّاً

24
00:01:46,330 --> 00:01:47,920
هل كشفت الأمر بالفعل؟

25
00:01:47,920 --> 00:01:48,480
حقّاً؟

26
00:01:48,790 --> 00:01:50,420
أظنّها لا تُحبّ أسلوبك فحسب

27
00:01:50,830 --> 00:01:52,540
ألا يُقال بأنّ النّساء غيّورات جدّاً؟

28
00:01:53,170 --> 00:01:53,920
مخلوقات مُخيفة

29
00:01:56,670 --> 00:01:57,420
توقّف

30
00:01:57,420 --> 00:01:58,670
كُفّ عن ليّها

31
00:02:02,290 --> 00:02:02,920
،أيُّها الشّابّ

32
00:02:03,040 --> 00:02:03,920
لماذا لا تأكل؟

33
00:02:04,290 --> 00:02:05,540
هذه كلّ الأطباق المُميّزة الخاصّة بلان

34
00:02:05,670 --> 00:02:06,330
ألا تُعجبك؟

35
00:02:06,920 --> 00:02:08,080
في الأمس، كنتُ آكل الكتُب بنهم

36
00:02:08,210 --> 00:02:09,080
ما زلتُ شبعاناً قليلاً

37
00:02:09,170 --> 00:02:11,670
ألا يستطيع أحدٌ هنا طبخ شيء صالح للأكل؟

38
00:02:12,790 --> 00:02:13,170
على ذكر الأمر

39
00:02:13,290 --> 00:02:14,540
كنتُ مُتحمّساً في الأمس فنسيتُ سؤالك

40
00:02:14,960 --> 00:02:17,420
كيف غادرتَ المطبخ المركزيّ
بعد تلك الجلبة الضّخمة؟

41
00:02:17,790 --> 00:02:18,960
كانت هناك فتاة تُدعى هوانغ

42
00:02:19,170 --> 00:02:19,960
كانت مُديرة المطبخ

43
00:02:20,330 --> 00:02:22,540
لحسن الحظّ، جاءت وبرّأت اسمي

44
00:02:22,710 --> 00:02:23,580
،وبعد الحادثة

45
00:02:23,790 --> 00:02:24,790
تحمّلتْ مسؤوليّات رئيس الطبّاخين

46
00:02:24,920 --> 00:02:25,420
ووافقتْ على إطلاق سراحي

47
00:02:25,540 --> 00:02:26,580
يبدو أنّه حالفك الحظّ

48
00:02:27,040 --> 00:02:27,920
اللّقاء بفتاة جميلة

49
00:02:31,920 --> 00:02:33,420
،بقدر ما أتمنّى أن يكون ذلك صحيحاً

50
00:02:33,710 --> 00:02:36,290
لكنّك تزعم بأنّك حفظت كُلّ فنّ
مُحرّم في الكتاب القديم؟

51
00:02:36,670 --> 00:02:37,710
أجد صعوبة حقّاً في تصديق ذلك

52
00:02:37,830 --> 00:02:39,540
،أعلم بأنّ ذلك لا يُصدَّق

53
00:02:39,920 --> 00:02:40,960
لكن يمكننا إجراء اختبار

54
00:02:40,960 --> 00:02:41,920
لتبديد شكوكك

55
00:02:45,920 --> 00:02:48,670
دعني أختار واحداً غير ضارّ لتجربته

56
00:02:49,460 --> 00:02:49,920
ليس هذا

57
00:02:50,170 --> 00:02:51,040
الجميع هنا سيموتون

58
00:02:51,420 --> 00:02:52,290
...هذا بعض الشيء

59
00:02:52,290 --> 00:02:52,920
من الفظيع النّظر إليه

60
00:02:53,080 --> 00:02:54,170
غير أخلاقيّ إطلاقاً

61
00:02:54,540 --> 00:02:55,420
هذا مُبالغ به

62
00:02:55,420 --> 00:02:56,290
للبالغين فقط

63
00:02:56,580 --> 00:02:57,420
هذا؟

64
00:02:57,960 --> 00:02:59,290
ضغط حاسوبيّ

65
00:02:59,920 --> 00:03:00,420
وجدتُه

66
00:03:00,920 --> 00:03:03,330
النّصوص القديمة تذكر
تعويذة تُدعى بالضّغط الحاسوبيّ

67
00:03:03,580 --> 00:03:04,920
لا أستطيع وصفها الآن

68
00:03:05,290 --> 00:03:06,330
الضّغط الحاسوبيّ؟

69
00:03:06,790 --> 00:03:08,710
،خلال كافّة سنواتي في هذا المجال
لم أسمع بشيء كهذا

70
00:03:11,210 --> 00:03:11,920
،كبير السّحرة لي وان

71
00:03:12,170 --> 00:03:14,330
هل يمكنك أوّلاً أن تُعلّمني
ترتيلة التّعويذة الأطول؟

72
00:03:14,710 --> 00:03:15,830
...دعني أُفكّر

73
00:03:16,460 --> 00:03:17,460
هناك تعويذة قديمة جدّاً

74
00:03:17,790 --> 00:03:18,460
سألقيها لأجلك

75
00:03:18,960 --> 00:03:20,040
انتظر يا مُعلّم

76
00:03:20,330 --> 00:03:21,960
لم تلقِ تلك التّعويذة بشكل صحيح

77
00:03:22,920 --> 00:03:24,670
إصلاح الأخطاء بشكل مُتكرّر
يهدر الكثير من الوقت

78
00:03:25,170 --> 00:03:26,460
لندعه يطّلع على دفتر مُلاحظاتي

79
00:03:28,170 --> 00:03:29,920
هذه الصّفحة هي التّعويذة الّتي
يُريد مُعلّمي إلقاءها

80
00:03:30,920 --> 00:03:31,710
دعني أراها

81
00:03:32,040 --> 00:03:33,290
يا إلهي

82
00:03:33,290 --> 00:03:34,540
صفحة كاملة مليئة بها

83
00:03:34,790 --> 00:03:35,670
إنّها طويلةٌ جدّاً

84
00:03:35,920 --> 00:03:37,290
حسناً، فهمتُها

85
00:03:38,460 --> 00:03:39,580
لماذا تُمزِّق الصّفحة من دفتري؟

86
00:03:40,330 --> 00:03:42,920
إنّ تمزيقها سوف يُفسد مرجعيّتي للإلقاء

87
00:03:43,080 --> 00:03:43,710
آسف

88
00:03:43,920 --> 00:03:45,540
سأستعرض فقط آليّة عمل الفنّ المُحرَّم

89
00:03:46,420 --> 00:03:46,790
انظر

90
00:03:47,170 --> 00:03:48,170
صفحة كاملة من تعزيم التّعويذة

91
00:03:48,420 --> 00:03:49,460
ألفّها إلى كُرة صغيرة

92
00:03:50,330 --> 00:03:52,210
هذا هو جوهر الضّغط الحاسوبيّ

93
00:03:52,290 --> 00:03:53,830
تحويل وقت التّرتيل المطلوب للإطلاق

94
00:03:54,040 --> 00:03:54,830
إلى إطلاق فوريّ

95
00:03:54,960 --> 00:03:56,170
ضغط تعزيمات التّعويذة الطّويلة

96
00:03:56,420 --> 00:03:57,540
ضمن حركة واحدة

97
00:03:57,540 --> 00:03:58,790
لذا حتّى أعقد التّعويذات

98
00:03:58,920 --> 00:04:00,040
تحتاج فقط لإعداد حركة واحدة

99
00:04:00,290 --> 00:04:01,170
كما الزرّ

100
00:04:01,170 --> 00:04:02,170
عمليّة وسريعة الاستعمال

101
00:04:03,420 --> 00:04:06,420
والآن سوف أحاول ضغط التّعزيم
الطّويل الّذي حفظتُه

102
00:04:12,540 --> 00:04:13,790
في نقطة واحدة

103
00:04:14,080 --> 00:04:16,210
سأحوّلها إلى حركة بسيطة ورائعة

104
00:04:28,920 --> 00:04:29,420
،مُعلّم

105
00:04:29,790 --> 00:04:30,670
لماذا تركع؟

106
00:04:30,710 --> 00:04:32,330
هذا... ليس ركوعاً

107
00:04:32,790 --> 00:04:33,960
إنّها الهالة الاضطهاديّة

108
00:04:35,170 --> 00:04:39,460
أطلقَ التّعزيمَ الطّويل الّذي علّمناه
إيّاه مُؤخّراً دون بذل جهد يُذكَر

109
00:04:40,540 --> 00:04:41,130
لحظة

110
00:04:41,420 --> 00:04:42,960
ماذا كانت تلك الحركة الّتي أُعِدَّتْ؟

111
00:04:43,210 --> 00:04:44,790
لماذا هي عبارة عن إمالة عنق؟

112
00:04:45,040 --> 00:04:46,330
أخبرتُك ألّا تلويها بعد الآن

113
00:04:46,330 --> 00:04:47,040
كُفّ عن ليّها

114
00:04:47,210 --> 00:04:48,490
انظر إلى هذه التّعويذة الهامّة

115
00:04:48,490 --> 00:04:49,960
الحافز هو في الواقع رقبة مائلة

116
00:04:50,080 --> 00:04:51,420
كلّ هذا لأنّك طلبت منّي ألّا أتحرّك

117
00:04:51,540 --> 00:04:53,460
كان الألم لا يُحتمَل فحسب

118
00:04:54,040 --> 00:04:54,330
انتظر

119
00:04:56,960 --> 00:04:57,790
تبدو الآن

120
00:04:57,920 --> 00:04:59,290
عالِقة بميلانها

121
00:05:01,460 --> 00:05:03,460
إذاً هناك فعلاً قصّة خفيّة حولك

122
00:05:03,790 --> 00:05:04,290
...هذا الصّوت

123
00:05:04,830 --> 00:05:05,330
...أيُعقَل

124
00:05:05,960 --> 00:05:06,710
المُديرة هوانغ؟

125
00:05:06,830 --> 00:05:08,670
استقلتُ من المطبخ المركزيّ اليوم أيضاً

126
00:05:08,830 --> 00:05:10,170
لذا لا تُنادِني بالمُديرة بعد الآن

127
00:05:11,290 --> 00:05:12,790
هل تدرسون السّحر؟

128
00:05:13,830 --> 00:05:14,310
لا

129
00:05:14,540 --> 00:05:15,330
لا يوجد سحر

130
00:05:15,710 --> 00:05:16,580
إذاً ما مُشكلته؟

131
00:05:17,420 --> 00:05:18,920
كنتُ أطلب منه بعض أداء بعض التّمارين

132
00:05:19,080 --> 00:05:19,790
انظر إلى تمرين القرفصاء هذا

133
00:05:19,920 --> 00:05:20,710
هل هي عميقة بما يكفي؟

134
00:05:20,920 --> 00:05:23,080
!بسرعة، أبطِل الضّغط

135
00:05:23,290 --> 00:05:25,540
عنقي عالِقة. لا أستطيع تقويمها

136
00:05:25,920 --> 00:05:26,920
إنّها هي إذاً

137
00:05:28,830 --> 00:05:29,790
لا تخفِ عنّي بعد الآن

138
00:05:30,040 --> 00:05:31,170
كنتُ أنتظر منذ مدّة

139
00:05:31,580 --> 00:05:32,170
لا داعي للقلق

140
00:05:32,670 --> 00:05:34,540
أتيتُ لإيجادك، لا للّحاق بك

141
00:05:35,080 --> 00:05:36,540
ثأرت لأبي لأجلي

142
00:05:36,670 --> 00:05:39,210
لم يبقَ لي شيء أسعى له في هذا العالم

143
00:05:39,540 --> 00:05:40,830
لذا سأذهب مع مُنقذي

144
00:05:41,080 --> 00:05:43,210
مهما فعل، سوف أُساعده

145
00:05:43,540 --> 00:05:44,710
هذا هو سببي في الحياة

146
00:05:45,040 --> 00:05:46,170
لا شيء يأتي بالمجّان

147
00:05:46,540 --> 00:05:47,830
وفتاة مثاليّة لن تسقط هكذا
من السّماء فحسب

148
00:05:48,210 --> 00:05:49,170
لا بُدّ أنّ هناك شيئاً مُريباً يجري

149
00:05:49,170 --> 00:05:50,210
تكلّمتْ بصدق واضح

150
00:05:50,670 --> 00:05:51,670
ألا يمكنك رؤية ذلك؟

151
00:05:52,040 --> 00:05:53,510
بالطّبع، يجدر بنا أن نُوافق على
السّماح لها بالانضمام

152
00:05:53,530 --> 00:05:54,540
وملِك عظيم فوق ذلك

153
00:05:54,790 --> 00:05:56,210
كيف لك أن تكون طائشاً وعاطفيّاً هكذا؟

154
00:05:56,210 --> 00:05:58,080
عرفتُ بأنّكما مُتواطئان

155
00:05:58,920 --> 00:05:59,790
مَن هنا الآن؟

156
00:06:00,170 --> 00:06:01,790
في الأمس، دعمتِه وتركتُه يذهب

157
00:06:02,040 --> 00:06:03,330
واليوم، تستقيلين

158
00:06:04,040 --> 00:06:06,290
أنتما تُنسِّقان بشكل سافر

159
00:06:06,670 --> 00:06:08,290
با، الأمر ليس كما تعتقد

160
00:06:08,290 --> 00:06:10,420
هل موت رئيس الطبّاخين مُرتبط بكِ أيضاً؟

161
00:06:11,210 --> 00:06:13,290
هل لفّقتِ قصّة مثاليّة؟

162
00:06:13,290 --> 00:06:14,460
كُلّ ما قلتُه صحيح

163
00:06:14,830 --> 00:06:15,790
نالَ رئيسُ الطبّاخين ما استحقَّه

164
00:06:15,790 --> 00:06:17,170
،كضابط لفريق الحرس

165
00:06:17,710 --> 00:06:19,170
لديّ الصّلاحيّة لاعتقالكم جميعاً

166
00:06:19,580 --> 00:06:20,830
سننتظر القائد حتّى يستجوبك

167
00:06:22,960 --> 00:06:23,420
مياو

168
00:06:25,670 --> 00:06:27,170
!كابيبارا لاكا بوكا

169
00:06:40,290 --> 00:06:41,040
مُحاولة جيّدة

170
00:06:41,460 --> 00:06:42,990
كيف تجرئين على استخدام السّحر؟

171
00:06:43,080 --> 00:06:43,840
دعها

172
00:06:43,960 --> 00:06:44,920
جميعهم أبرياء

173
00:06:45,040 --> 00:06:45,460
أبرياء؟

174
00:06:46,290 --> 00:06:47,330
انظري إليه فحسب

175
00:06:47,540 --> 00:06:48,460
هل يبدو بريئاً في نظركِ؟

176
00:06:48,790 --> 00:06:49,960
أما زلت تجرؤ على استفزازي؟

177
00:06:50,210 --> 00:06:50,920
أنت مُخطئ

178
00:06:50,920 --> 00:06:51,960
نمتُ على عنقي بشكل خاطئ
في اللّيلة الماضية

179
00:07:06,920 --> 00:07:08,080
لم أتوقّعه أن يكون بهذه القوّة

180
00:07:13,040 --> 00:07:14,460
كيف لحارس صغير أن يكون قويّاً؟

181
00:07:14,710 --> 00:07:16,170
،لو لم يكن عنقي عالقاً وعديم الجدوى

182
00:07:16,170 --> 00:07:17,420
لكنتُ قد قضيتُ عليه بلكمة واحدة

183
00:07:17,920 --> 00:07:18,290
مياو

184
00:07:23,170 --> 00:07:23,580
!يا للهول

185
00:07:28,920 --> 00:07:30,420
أخيراً، هذا أفضل

186
00:07:32,290 --> 00:07:33,790
لكن لا تستخدم كامل قوّتك

187
00:07:34,790 --> 00:07:36,540
إذاً لندعه ينام لمدّة أسبوع

188
00:07:36,790 --> 00:07:37,920
ما رأيك بهذا؟

189
00:07:40,210 --> 00:07:40,790
...ماذا

190
00:07:56,540 --> 00:07:57,420
يا إلهي

191
00:07:57,830 --> 00:07:58,920
أخيراً استطعتُ الوقوف بشكل مُنتصب

192
00:07:59,540 --> 00:08:01,290
ركبتايّ لا تستطيعان مُجاراتكم أنتم الشّباب

193
00:08:01,670 --> 00:08:03,670
لو جثمتُ لفترة أطول، لاحتجتُ لبتر غالباً

194
00:08:08,540 --> 00:08:10,040
،توقّفتَ للتو عن قمعي

195
00:08:10,290 --> 00:08:11,210
والآن تفعلها له

196
00:08:11,540 --> 00:08:12,460
لم أُمِل رأسي

197
00:08:13,040 --> 00:08:14,170
،وبعد أن قوّمتُ رأسي

198
00:08:14,420 --> 00:08:15,460
أشعر بأنّ عنقي بحالٍ أفضل بكثير

199
00:08:16,210 --> 00:08:17,040
يبدو أنّه يبكي

200
00:08:18,540 --> 00:08:19,170
يبكي؟

201
00:08:24,580 --> 00:08:25,710
قلتُ لك ألّا تستخدم كامل قوّتك

202
00:08:25,960 --> 00:08:27,040
مع أنّك لم تضربه حتّى بعد

203
00:08:27,170 --> 00:08:28,540
لكمتك جعلَتْه يدوخ

204
00:08:29,040 --> 00:08:29,920
الملك لي

205
00:08:31,670 --> 00:08:33,290
هل أنت الملك لي؟