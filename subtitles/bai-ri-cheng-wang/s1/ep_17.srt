1
00:00:49,790 --> 00:00:53,290
أجل. اسحب السّحر من الدّاخل ببطء

2
00:00:53,540 --> 00:00:55,290
ركّزه حيث تريد استخدامه

3
00:00:55,580 --> 00:00:58,040
ثمّ صِغه بالتّعويذة الصّحيحة

4
00:01:00,080 --> 00:01:03,040
بطّارية الهاتف تنفد، عشر خسائر
في اللّعبة، لا حزمة

5
00:01:03,540 --> 00:01:07,160
،جي.بي.أس، جي.بي.أس
طريق خاطئ من جديد

6
00:01:07,910 --> 00:01:09,950
وشيك جدّاً. يا للخسارة

7
00:01:10,700 --> 00:01:13,290
تذكّرتُ الآن. جي.بي.آس بلا إشارة

8
00:01:13,540 --> 00:01:15,160
كان ذلك وشيكاً، لكن مع ذلك أخطأت

9
00:01:16,040 --> 00:01:17,410
لا بأس. واظب على ذلك

10
00:01:17,580 --> 00:01:19,660
سيّدي، أنت أسرع مُتعلِّم هنا

11
00:01:19,910 --> 00:01:21,160
أجل، أجل. يمكنك فعلها

12
00:01:23,950 --> 00:01:25,290
عاد مياو إلى الحيّ 9 قبل يومين

13
00:01:25,540 --> 00:01:26,580
لماذا لن نسمع شيئاً؟

14
00:01:26,910 --> 00:01:28,910
ربّما يخطّط لشيء مع السّيّد ليانغ

15
00:01:29,410 --> 00:01:31,410
مُفاوضات العمل ليست مثل صَهر السّحر

16
00:01:31,700 --> 00:01:32,660
لا تحدث بين ليلة وضُحاها

17
00:01:38,290 --> 00:01:40,580
بطّارية الهاتف تنفد، عشر خسائر في اللّعبة

18
00:01:40,910 --> 00:01:42,950
لا حزمة، وجي.بي.أس بلا إشارة

19
00:01:43,290 --> 00:01:43,660
اشتعل

20
00:01:43,910 --> 00:01:45,160
!ها هي. إنّها تشتعل فعلاً

21
00:01:45,950 --> 00:01:47,180
!نجح ذلك

22
00:01:48,160 --> 00:01:50,660
.عد إلى المنزل وسيدفعونكم نحو الزّواج
بعد ذلك، سيدفعونك نحو الأطفال

23
00:01:50,790 --> 00:01:51,700
النّار تزداد حجماً

24
00:01:51,790 --> 00:01:52,790
استمرّ. امنحها المزيد

25
00:01:54,290 --> 00:01:56,830
.أنجب أطفالاً ولا يُساعدك أحدٌ في رعايتهم
أحضر قطّة ولا أحد يُغلق الباب

26
00:01:57,830 --> 00:02:00,580
انتهيت. إنّها ساخنة مُتّقدة

27
00:02:02,040 --> 00:02:03,450
لا عجب في أنّك مُعلّم

28
00:02:03,790 --> 00:02:04,790
أنت سريع التعلُّم

29
00:02:05,290 --> 00:02:08,160
نجحتَ في تعويذة تأجيج النّار بسرعة

30
00:02:09,450 --> 00:02:10,580
كانت التّعويذة مكتوبة بإتقان فحسب

31
00:02:10,830 --> 00:02:11,950
كانت مفهومة تماماً

32
00:02:12,160 --> 00:02:13,410
فتحَتْ إمكانيّاتي الخفيّة

33
00:02:20,160 --> 00:02:20,910
!مُعلّم

34
00:02:25,160 --> 00:02:25,910
قِفي مكانكِ

35
00:02:33,290 --> 00:02:35,040
أيّتها الشّابة، من تكونين بالضّبط؟

36
00:02:35,660 --> 00:02:38,290
لِمَ تقتلين مدنيّين عُزّلاً؟

37
00:02:39,040 --> 00:02:40,660
من الواضح أنّهم كانوا غوغاء عنيفين

38
00:02:41,330 --> 00:02:43,200
كنتُ أحافظ على السّلام

39
00:02:47,830 --> 00:02:49,290
اجتمعوا لدراسة السّحر إذاً

40
00:02:49,790 --> 00:02:52,700
ثمّة شيء يُطبَخ هناك على نار هادئة

41
00:02:53,040 --> 00:02:55,040
لكن أُرسلَ لونغ أو للتّحقيق

42
00:02:55,290 --> 00:02:57,580
لماذا لم يُرسل أيّ تقرير؟

43
00:03:03,200 --> 00:03:03,660
لونغ أو

44
00:03:06,330 --> 00:03:09,080
أرسلَك الملك لي إلى الحيّ 9 للتحرّي
حول وفاة ذلك الطبّاخ

45
00:03:09,330 --> 00:03:10,660
هل تريدني أن أذهب وأتفقّد ذلك معك؟

46
00:03:11,200 --> 00:03:12,410
إنّها مسألة تافهة

47
00:03:12,790 --> 00:03:14,660
لا أريد إزعاجك يا تشين تيان

48
00:03:14,950 --> 00:03:16,910
لا تتكلّم بسخرية

49
00:03:17,450 --> 00:03:20,540
تلك الفتاة الّتي أحضرها الملِك لي
هي من الحيّ 9 أيضاً، صحيح؟

50
00:03:20,950 --> 00:03:22,160
طلبَ منّي الملِك لي أن أحتفظ بذلك سرّاً

51
00:03:22,700 --> 00:03:24,790
اسأله بنفسك إن كانت لديك أسئلة

52
00:03:28,290 --> 00:03:31,540
يبدو أنّه عثر على سرٍّ خطير

53
00:03:32,160 --> 00:03:35,200
ابدأ بأولئك المُحرّضين على تعلُّم السّحر إذاً

54
00:03:36,200 --> 00:03:37,790
يجب أن تقضي على قائدهم أوّلاً

55
00:03:39,580 --> 00:03:41,310
الجنرالات والجنود السّماويّون

56
00:04:05,950 --> 00:04:08,040
.اهبطوا وطهّروا كُلّ الخطايا
يمتلك هذا الجسد المعرفة

57
00:04:08,290 --> 00:04:10,830
.هذا الأمر هو الحُكم النّهائي
أولئك الّذين يعصونه سيسقطون في هلاك أبديّ

58
00:04:11,290 --> 00:04:12,660
أولئك الّذين يُطيعون يُواجهون
الحُكم المُقدّس معاً

59
00:04:22,540 --> 00:04:24,040
كيف تحوّل واحدٌ إلى ثلاثة؟

60
00:04:25,700 --> 00:04:28,040
كبير السّحرة لي وان، ما السّحر
الّذي تستخدمه؟

61
00:04:28,410 --> 00:04:29,700
ناديتني بكبير السّحرة

62
00:04:30,040 --> 00:04:31,330
لذا تراجعي وراقبيني بينما أعمل

63
00:04:31,660 --> 00:04:33,040
لديّ طريقة للتّعامل معها

64
00:04:42,700 --> 00:04:44,910
الّذين تمّ استدعاؤهم ضُعفاء جدّاً

65
00:04:45,410 --> 00:04:47,040
ينبغي أن تتوقّف عن المُقاومة

66
00:04:47,540 --> 00:04:49,160
لنتحدّث عن رؤيتك للأمور

67
00:04:50,410 --> 00:04:52,290
يا قمر الدّماء، غطِّ السّماء. يا بوّابة
عالم الآخرة، افتحي

68
00:04:52,580 --> 00:04:53,290
يتمخّض المُستنقع

69
00:04:53,580 --> 00:04:54,540
الماء الفاسد يبتلع السّماء

70
00:04:55,950 --> 00:04:57,200
رحلَ حقّاً؟

71
00:05:00,660 --> 00:05:01,950
لا. ما زالت هناك طريقة

72
00:05:02,410 --> 00:05:04,790
جرّبتَ كُلّ خدعة غريبة. ماذا
عساك تفعل غير ذلك؟

73
00:05:05,660 --> 00:05:07,160
أعدتُ للتو قراءة الكِتاب المُحرّم في عقلي

74
00:05:07,830 --> 00:05:10,410
،لم أجد تعويذةً لإعادته
لكن لا يمكننا فقدان الأمل

75
00:05:11,450 --> 00:05:15,950
كان بالكاد صامداً. كانت كُلّ مُحاولاتك
المُتفائلة ما دفعه نحو الحافّة

76
00:05:16,790 --> 00:05:18,200
استيقظ

77
00:05:21,950 --> 00:05:24,040
هذه المرّة، العلاج بالكهرباء

78
00:05:25,040 --> 00:05:26,410
نشبك مع الأطراف الإيجابيّة والسّلبيّة

79
00:05:27,080 --> 00:05:28,790
ثمّ نُشغّل الطّاقة. واحد، اثنان، ثلاثة

80
00:05:29,040 --> 00:05:30,870
تفريغ. واحد، اثنان، ثلاثة-
هذا سيّئ-

81
00:05:30,910 --> 00:05:33,290
تفريغ-
بِكَم يُدين له السّيّد ليانغ؟-

82
00:05:33,790 --> 00:05:34,910
لِمَ يُعذّبه هكذا؟

83
00:05:35,290 --> 00:05:36,410
هذا قاسٍ جدّاً

84
00:05:36,450 --> 00:05:38,160
لا بُدّ أنّه أغضبه-
حتّى بعد رحيله، لا يجد الرّاحة-

85
00:05:38,790 --> 00:05:39,910
!يا للخسارة. يا للخسارة

86
00:05:40,790 --> 00:05:43,290
واحد، اثنان، ثلاثة. تفريغ

87
00:05:44,040 --> 00:05:45,160
صدمة. تفريغ

88
00:05:46,160 --> 00:05:46,910
أما من شيء يمكننا فعله؟

89
00:05:47,410 --> 00:05:48,040
،سيّد ليانغ

90
00:05:48,580 --> 00:05:50,040
كيف لك أن ترحل فحسب؟

91
00:05:50,080 --> 00:05:52,580
كيف يحدث هذا؟
تركتَنا بعمر صغير

92
00:05:53,410 --> 00:05:56,450
كان ليانغ محبوباً جدّاً

93
00:05:57,200 --> 00:06:00,080
نحن رجال أعمال. يتمحور عملنا حول
تشكيل صداقات وبناء علاقات جيّدة

94
00:06:00,450 --> 00:06:03,410
مع الأسف. أردتُ إحياء كلا الحيّين معه

95
00:06:04,160 --> 00:06:08,200
!لا يا ليانغ! لا يمكنك الموت

96
00:06:09,160 --> 00:06:10,790
!ما زلت مَديناً لي بكثير من القروض

97
00:06:11,160 --> 00:06:12,040
!استيقظ

98
00:06:12,330 --> 00:06:14,950
!لم تُوقِّع على نقل متجري بعد

99
00:06:15,410 --> 00:06:18,040
!أعِد لي استثماري والفوائد

100
00:06:18,910 --> 00:06:22,290
!لا يمكنك الموت-
ماذا سنفعل إن مُتّ؟-
لم تكن علاقات جيّدة إذاً-

101
00:06:22,660 --> 00:06:24,080
كانت ديوناً غير مُسدَّدة

102
00:06:26,540 --> 00:06:28,700
،حسناً؟ هل ستأتي وتُطهّر نفسك

103
00:06:29,160 --> 00:06:30,200
أم أنّ عليّ دفعك لذلك؟

104
00:06:31,950 --> 00:06:33,660
حالما يُصدَر هذا الأمر، سيفنى كلُّ شيء

105
00:06:34,160 --> 00:06:35,580
حيث لا يصل المدُّ العفِن، لا شيء ينمو

106
00:06:36,160 --> 00:06:37,410
آنسة هوانغ، لا تُقدِمي على أيّ تصرُّف طائش

107
00:06:38,790 --> 00:06:40,540
التّعويذة التّالية تأخذ مفعولها بالفعل

108
00:06:41,040 --> 00:06:42,580
ما الّذي تهمس بشأنه؟

109
00:06:43,040 --> 00:06:45,040
قُلها بصوتٍ عالٍ كي أسمع

110
00:06:50,410 --> 00:06:53,040
قلتُ بأنّ شروط استدعاء الحاجز قد استُوفيتْ

111
00:06:53,330 --> 00:06:54,410
إنّها تتّخذ مفعولها

112
00:06:55,200 --> 00:06:55,790
ماذا؟

113
00:07:01,830 --> 00:07:02,540
ماذا تفعل؟

114
00:07:08,160 --> 00:07:09,290
ما كلّ هذا؟

115
00:07:09,910 --> 00:07:11,660
عرفتُ بأنّ الحُرّاس لن يستطيعوا هزيمتكِ

116
00:07:12,040 --> 00:07:14,410
لكنّها تُشغِّل مجالَ الموت

117
00:07:15,040 --> 00:07:18,410
بتقديمهم قرابين فقط يمكنني
حبسكِ في هذا الحاجز

118
00:07:20,160 --> 00:07:21,290
تجرأتَ على العبث معي؟

119
00:07:23,950 --> 00:07:25,290
داتوي، حان دورك الآن

120
00:07:34,200 --> 00:07:34,910
من أنت الآن؟

121
00:07:40,830 --> 00:07:43,330
أنا المُعجَب الأكبر للجنّية أقحوان، داتوي

122
00:07:43,910 --> 00:07:45,830
دا في داتوي، وتوي في داتوي

123
00:08:44,790 --> 00:08:49,660
بعد انصهار السّحر، كُلّ هتاف يُشبه معركة

124
00:08:51,830 --> 00:08:52,790
تهانينا أيّها الشّابّ

125
00:08:53,080 --> 00:08:55,290
أخيراً شعرتَ بإثارة السّحر

126
00:08:55,410 --> 00:08:56,540
داتوي قويٌّ إلى حدّ جنونيّ

127
00:08:56,910 --> 00:08:58,830
بدعم السّحر لنا، قوّتنا تُحلِّق في العلالي

128
00:08:59,410 --> 00:09:00,540
يجب أن أتعلّم السّحر أيضاً

129
00:09:00,910 --> 00:09:02,540
ربّما يمكننا إنهاء هذه القاعدة القاسية

130
00:09:02,790 --> 00:09:04,410
واستعادة موطننا المُسالم

131
00:09:14,790 --> 00:09:17,200
هذا أسوأ ممّا توقّعت

132
00:09:18,910 --> 00:09:20,330
كبير السّحرة لي وان، علّمني

133
00:09:20,660 --> 00:09:21,160
علّمني أوّلاً

134
00:09:21,290 --> 00:09:22,290
علّمني أوّلاً يا كبير السّحرة

135
00:09:23,200 --> 00:09:24,200
حسناً، حسناً. لا تستعجلوا

136
00:09:24,660 --> 00:09:25,660
سأعلّمكم جميعاً معاً

137
00:09:30,410 --> 00:09:33,450
من أرسلها لمُهاجمتنا فجأة؟

138
00:09:34,700 --> 00:09:39,660
ربّما مياو والآخرون نبّهوا رئيس الحيّ 9
أو حتّى رؤسائه

139
00:09:40,450 --> 00:09:40,910
آنسة هوانغ

140
00:09:43,040 --> 00:09:43,540
مياو

141
00:09:46,910 --> 00:09:49,250
سنعتمد عليك... في إنقاذه