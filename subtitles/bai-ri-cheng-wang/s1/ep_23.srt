1
00:00:41,910 --> 00:00:44,580
(مُتوّج بعد مئة يوم)

2
00:00:44,580 --> 00:00:46,580
.كافّة العناصر خياليّة .لا تُحاول التّقليد

3
00:00:50,620 --> 00:00:53,250
دعني أدوّن الأرقام في هذه الصّفقة-
مهلاً-

4
00:00:53,620 --> 00:00:54,500
لا يجوز أن تقتحم هذا المكان

5
00:00:56,500 --> 00:00:57,250
من أنت؟

6
00:01:00,410 --> 00:01:01,370
اسمي لونغ أو

7
00:01:03,660 --> 00:01:04,870
هذا أنت يا رئيس المُضيفين

8
00:01:05,120 --> 00:01:06,870
ما الّذي جاء بك إلى الحيّ 9؟

9
00:01:07,000 --> 00:01:09,790
حضورك هو شرفٌ لهذا المنزل المُتواضع حقّاً

10
00:01:09,910 --> 00:01:11,120
اعفِني من الدّردشة

11
00:01:11,500 --> 00:01:13,040
،مُشكلة السّحر في الحيّ 9

12
00:01:13,370 --> 00:01:15,000
أعتقد بأنّك سمعت بها

13
00:01:16,040 --> 00:01:16,870
بصيرتك حادّة يا سيّدي

14
00:01:17,160 --> 00:01:19,870
هناك مجموعة تُتاجر بالخبز المصنوع بالسّحر

15
00:01:20,160 --> 00:01:22,370
هل بدأ المسؤولون الكبار باتّخاذ
إجراءات صارمة؟

16
00:01:23,370 --> 00:01:26,540
...تلك الصّفقة الّتي ذكرتَها للتو
لا تقل لي بأنّك مُرتبط بها

17
00:01:27,540 --> 00:01:31,040
عملي مُتنوّع. الصّفقة الجيّدة تنفع الجميع

18
00:01:31,290 --> 00:01:33,370
هل لفتَ شيء انتباهك يا سيّدي؟

19
00:01:35,250 --> 00:01:36,430
ذكيّ

20
00:01:36,750 --> 00:01:38,500
لديّ صفقة مضمونة هنا

21
00:01:38,790 --> 00:01:39,660
كُلّ ما عليك فعله هو المُوافقة

22
00:01:39,870 --> 00:01:44,120
لن يُعزّز ذلك مسيرتك المهنيّة، لكن
ستحصل على مُكافأة جيّدة حالما يُنجَز

23
00:01:44,620 --> 00:01:47,910
حسبما أرى، جِنرالات النّمر الثّمانية عديمو الرّحمة

24
00:01:48,160 --> 00:01:49,750
إذا تعمّقوا أكثر، فسأقع في ورطة

25
00:01:50,290 --> 00:01:51,750
كُلّ هذا مُجرّد عمل، على أيّ حال

26
00:01:52,120 --> 00:01:55,290
،إذا فتحَ المسؤولون الكبار تحقيقاً
فسيكون لديّ كبش فداء

27
00:01:58,040 --> 00:01:59,540
حسناً. مُوافق

28
00:01:59,870 --> 00:02:01,040
حسناً، ما الّذي تضع نُصب عينيك عليه يا سيّدي؟

29
00:02:01,250 --> 00:02:02,870
مال؟ أم عقارات؟

30
00:02:07,750 --> 00:02:08,910
هويّتك

31
00:02:12,910 --> 00:02:14,790
لستَ رجل أعمال مُريباً. من تكون حقّاً؟

32
00:02:16,750 --> 00:02:18,370
كنتَ هنا منذ البداية

33
00:02:20,290 --> 00:02:21,250
لونغ أو

34
00:02:26,410 --> 00:02:28,870
ما زلت حادّ اللّسان كعادتك يا تشين تيان

35
00:02:29,120 --> 00:02:30,660
إنّ السّكوت يُلائمك أكثر

36
00:02:33,660 --> 00:02:34,500
يعرفان بعضهما الآخر؟

37
00:02:34,910 --> 00:02:36,250
لماذا يحمينا؟

38
00:02:37,620 --> 00:02:40,540
أرسلَك الملِك لي للتقصّي حول
الحيّ 10. لا أنباء بعد

39
00:02:40,870 --> 00:02:44,750
لماذا تأوي هؤلاء الخونة الّذين يواجهون
عقوبة الإعدام؟

40
00:02:45,000 --> 00:02:46,790
هذه مُهمّة مُكلَّفة بواسطة الملِك لي

41
00:02:47,120 --> 00:02:48,410
سوف أكمل إنجازها بنفسي

42
00:02:48,790 --> 00:02:50,040
هذا ليس من شأنك

43
00:02:50,660 --> 00:02:54,160
آنسة هوانغ، قبل نهوض ذلك الرّجل
الضّخم، يجب أن تُغادري

44
00:02:54,410 --> 00:02:55,870
اعتبري هذا ردّ معروف

45
00:03:01,500 --> 00:03:02,000
احذر

46
00:03:07,410 --> 00:03:09,620
أحمق بما يكفي للتّواطؤ مع هؤلاء الخدَم

47
00:03:10,120 --> 00:03:13,250
أشكّ في أنّك ستُحافظ حتّى على موقعك
كذيَيل لجِنرالات النّمر الثّمانية

48
00:03:13,750 --> 00:03:16,500
اليوم، سأعاقبك بالنّيابة عن الملِك لي

49
00:03:17,040 --> 00:03:18,870
سنرى من هو الذّيل الحقيقيّ هنا

50
00:03:20,160 --> 00:03:21,290
أنت فقط؟

51
00:03:41,250 --> 00:03:42,370
مَسكة السّيكادا في مهبّ الرّيح

52
00:03:46,910 --> 00:03:48,000
مجسّ عرين الثُّعبان

53
00:03:57,500 --> 00:03:58,500
زئير النّمر

54
00:03:58,870 --> 00:03:59,750
تدفُّق الرّياح

55
00:04:07,790 --> 00:04:09,000
!كم هذا مُملّ

56
00:04:10,120 --> 00:04:12,910
إذا اعترفت الآن وكشفت سبب
،تخطيطك للخيانة

57
00:04:13,250 --> 00:04:15,540
يمكنني أن أطلب من الملِك
لي تخفيف عقوبتك

58
00:04:16,120 --> 00:04:18,870
،إذا تمكّنت من تسليتي أكثر
فقد أعفو عن حياتك

59
00:04:19,250 --> 00:04:21,000
لذا أخبرني، ماذا قدّموا لك؟

60
00:04:21,370 --> 00:04:24,410
هل كان المال، أم النّفوذ، أم القوّة؟

61
00:04:24,500 --> 00:04:27,000
لم تتغيّر البتّة بعد كُلّ هذه السّنوات

62
00:04:27,250 --> 00:04:28,500
أنت تُثير اشمئزازي

63
00:04:29,290 --> 00:04:31,500
أتعتقد بأنّ بضع دُمى رديئة تستطيع هزيمتي؟

64
00:04:32,040 --> 00:04:33,500
كنتُ أنتظرهم حتّى يظهروا فحسب

65
00:04:56,870 --> 00:04:57,410
يد الغيمة

66
00:05:00,000 --> 00:05:00,910
قبضة المِطرقة

67
00:05:13,870 --> 00:05:15,000
زئير النّمر

68
00:05:15,750 --> 00:05:16,620
مُلتهِم الأمواج

69
00:05:23,000 --> 00:05:24,750
لا بُدّ أنّ توجيه اللّكمات والرّكلات مُرهق

70
00:05:25,500 --> 00:05:27,500
ما تريده حقّاً هو فنون السّحر
المُحرَّمة، أليس كذلك؟

71
00:05:28,000 --> 00:05:30,660
بالنّسبة لشخص عاديّ وعديم الجدوى مثلك

72
00:05:30,750 --> 00:05:32,500
هذا أكثر إغراء من الاثنين الآخرين

73
00:05:34,160 --> 00:05:35,160
أنا لستُ مثلك

74
00:05:35,370 --> 00:05:38,370
تقتات على فُتاتات في كلّ مكان
حتّى تملأ الدُّهون وجهك طمعاً

75
00:05:39,000 --> 00:05:41,790
أتعرف لماذا تركتُ أولئك الأتباع يُراقبون؟

76
00:05:42,250 --> 00:05:45,120
،لأنّه عوضاً عن القضاء على الضّعفاء بسهولة

77
00:05:45,660 --> 00:05:48,250
أفضّل أكثر رؤية النّظرة في وجوههم

78
00:05:48,910 --> 00:05:52,000
حالما يُدركون الفارق بعد هزيمتك
بشكل مُثير للشّفقة

79
00:05:52,660 --> 00:05:53,620
وفِّر أنفاسك

80
00:05:53,870 --> 00:05:55,290
كنتُ أرغب في إصلاح هذا الوجه الجامد

81
00:06:10,790 --> 00:06:12,250
جبل النّمر الهائج السّاحق

82
00:06:15,500 --> 00:06:16,540
المِنجل كسّار العِظام

83
00:06:21,870 --> 00:06:22,620
لا أستطيع التحرُّر

84
00:06:22,870 --> 00:06:24,370
هل فقدت الحماس؟

85
00:06:24,750 --> 00:06:26,290
هذه هي قدرته الخفيّة إذاً؟

86
00:06:26,790 --> 00:06:28,870
تدريب الفنون القتاليّة يدعك تتلقّى
،بضع ضربات

87
00:06:29,370 --> 00:06:32,750
لكن فنونك القتاليّة المُثيرة للشّفقة
لا يمكنها حتّى لمسي

88
00:06:34,620 --> 00:06:36,540
إن خسرتَ، فسوف تتوسّل ذليلاً

89
00:06:49,790 --> 00:06:50,500
ما رأيك بذلك؟

90
00:06:51,040 --> 00:06:52,910
أما زلت تعتقد بأنّ لديك المُقوّمات؟

91
00:07:08,870 --> 00:07:10,660
ماذا نفعل؟ علينا التّفكير في شيء

92
00:07:11,540 --> 00:07:13,620
هذا القفص مصنوع من أسلاك يتحكّم بها

93
00:07:13,750 --> 00:07:14,410
هوانغ موجودة هنا أيضاً

94
00:07:14,870 --> 00:07:16,000
،إذا شعرَ بأي تحرُّكات

95
00:07:16,370 --> 00:07:17,750
فأشكُّ في أنّنا نستطيع إنقاذ
أنفسنا هذه المرّة

96
00:07:20,620 --> 00:07:24,160
أو، ستنزف حتّى الموت هكذا

97
00:07:25,000 --> 00:07:26,000
قولي لونغ أو

98
00:07:26,250 --> 00:07:27,620
سأردّ الجميل دوماً

99
00:07:27,870 --> 00:07:28,790
أنقذتِ حياتي من قبل

100
00:07:30,000 --> 00:07:33,290
لذا، مهما حدث، يجب أن أردّ الجميل

101
00:07:41,870 --> 00:07:47,290
لو لم يشفق الملك لي عليك ويمنحك
،لقباً في يوم التّوحيد

102
00:07:47,790 --> 00:07:51,500
لكنتَ أقلّ من كلب في نظر جِنرالات النّمر الثّمانية

103
00:07:52,250 --> 00:07:56,040
لونغ أو، أتعرف سبب انتهاء المطاف
بك كرئيس لوجستيّات فقط

104
00:07:56,370 --> 00:07:58,250
بعد كُلّ هذا القتال كأصدقاء؟

105
00:07:59,870 --> 00:08:01,870
لأنّ مهاراتك ناقصة ببساطة

106
00:08:02,250 --> 00:08:05,250
إبقاؤك بجانبي والسّماح لك بحمل
لقب جِنرالات النّمر الثّمانية

107
00:08:05,410 --> 00:08:06,790
هو بدافع الولاء القديم حصراً

108
00:08:08,750 --> 00:08:12,250
الموهبة والجدارن يُحدّدان مَن في القمّة

109
00:08:12,500 --> 00:08:14,000
ومن هو في الأسفل

110
00:08:14,540 --> 00:08:17,500
اختبار بسيط يكشف كافّة العيوب

111
00:08:17,620 --> 00:08:19,620
لا، هذا خطأ

112
00:08:20,000 --> 00:08:21,040
...ما زال بإمكاني

113
00:08:21,250 --> 00:08:23,500
ماتوا جميعهم بسببك

114
00:08:24,540 --> 00:08:26,910
كُلّ هذا بسبب غطرستك العمياء

115
00:08:27,040 --> 00:08:29,160
سمحت لهم بالموت كحشرات

116
00:08:29,540 --> 00:08:30,790
خذلتَهم

117
00:08:31,120 --> 00:08:33,660
لا، لا، هذا غير صحيح-
خذلتَ عائلاتهم-

118
00:08:34,620 --> 00:08:39,040
وانغ شياومينغ، أليس لديك الجرأة حتّى
على القيام بقسَم الخنصر؟

119
00:08:39,790 --> 00:08:40,160
...أنا

120
00:08:41,160 --> 00:08:41,790
...هل من أحد

121
00:08:42,120 --> 00:08:42,620
...هل من أحد

122
00:08:43,000 --> 00:08:44,000
هل من أحد ما زال حيّاً؟

123
00:08:44,500 --> 00:08:48,250
كُلّ هذا نتيجة عجزك الطّائش

124
00:08:48,500 --> 00:08:50,540
هذا مُثيرٌ للشّفقة والضّحك

125
00:08:51,370 --> 00:08:55,250
حتّى الآن، أنت من كان يقود
الأمور لا يستطيع الاعتراف بذلك

126
00:08:55,500 --> 00:08:57,540
!يا للسّخرية

127
00:08:57,620 --> 00:08:58,660
...تلك النّبرة

128
00:09:00,410 --> 00:09:01,000
...أنت

129
00:09:01,540 --> 00:09:02,290
مو لي

130
00:09:05,290 --> 00:09:08,660
دُمية مُبهرة تُضيء حتّى من دون خيوط

131
00:09:09,160 --> 00:09:13,250
لكنّها تعيسة، فمهما كان من يسحب
الخيوط، تبقى خرقاء

132
00:09:13,750 --> 00:09:15,540
مثل فنونك القتاليّة المُثيرة للضّحك

133
00:09:16,120 --> 00:09:17,410
كُلّها بهرَجة، بلا مضمون

134
00:09:18,620 --> 00:09:21,290
لذا لا تكُن عاجزاً وعاديّاً

135
00:09:21,660 --> 00:09:23,250
وفي نفس الوقت جاهلاً لذلك

136
00:09:24,370 --> 00:09:27,620
في تلك المرحلة، أنا خير من يفهم ذلك

137
00:09:30,870 --> 00:09:32,500
كلب عديم الجدوى ما زال ينبح

138
00:09:32,870 --> 00:09:33,870
أتعتقد بأنّك رهيب؟

139
00:09:34,000 --> 00:09:36,000
توقّفا. كِسرة الخبز هذه لها

140
00:09:37,370 --> 00:09:40,370
ماذا؟ أتحاول تدليك ظهري بهاتين
القبضتين الضّعيفتين؟

141
00:09:43,370 --> 00:09:44,410
أنت تبذل جهداً كبيراً

142
00:09:46,120 --> 00:09:48,790
،ليتني وُلدتُ أضخم وأقوى

143
00:09:49,370 --> 00:09:50,750
ما كان أحد ليهزمني

144
00:09:51,750 --> 00:09:52,410
أما زلت تريدها؟

145
00:09:52,870 --> 00:09:53,870
دعني أساعدك إذاً

146
00:09:54,370 --> 00:09:58,000
لا تدعها تُهدَر. هذا ما تستحقّه على تطفّلك

147
00:09:59,500 --> 00:10:02,290
اعتباراً من ذلك اليوم، أردتُ تغيير كُلّ شيء

148
00:10:03,620 --> 00:10:05,120
لن أسقط بسهولة ثانية

149
00:10:05,750 --> 00:10:08,620
بالإصرار، ذات يوم سوف أصبح أقوى

150
00:10:09,750 --> 00:10:10,620
!فريق اللّوجستيّات، تحرّك أسرع

151
00:10:10,870 --> 00:10:12,120
!لا تقل لي بأنّك لا تستطيع أن تسبق كلباً

152
00:10:13,120 --> 00:10:14,000
!انقلع

153
00:10:14,410 --> 00:10:17,250
أما زلت تحلم بأن تصبح قويّاً وتبتلع
الجنود والجِنرالات أمثال لي؟ حلم أخرق

154
00:10:17,620 --> 00:10:19,000
وتسحق جنوداً وجِنرالات مثل لي؟
إنّه حلم الحمقى

155
00:10:19,870 --> 00:10:23,500
أعلم... بأنّه عليّ مُضاعفة جهودي

156
00:10:27,750 --> 00:10:28,750
تذكّرتُ الآن

157
00:10:29,370 --> 00:10:31,250
في تلك اللّيلة، فقدتُ كافّة زملائي

158
00:10:32,120 --> 00:10:33,500
كان كُلّ ذلك غلطتي

159
00:10:34,870 --> 00:10:36,250
ليتني كنتُ أقوى قليلاً

160
00:10:37,370 --> 00:10:38,540
ما كان لينتهي الأمر هكذا

161
00:10:43,870 --> 00:10:47,120
تشين تيان، في الحقيقة، لطالما حسدتُك

162
00:10:47,750 --> 00:10:51,040
يافع جدّاً ومع ذلك مُفضَّل بواسطة الملِك
لي، بإنجازات مُبهرة

163
00:10:52,250 --> 00:10:53,540
،لكن الأهمّ من ذلك

164
00:10:54,040 --> 00:10:57,120
أكره غطرستك وتعاليك

165
00:10:58,040 --> 00:11:00,540
هذا هو ثمن تحدِّي السّحر

166
00:11:00,750 --> 00:11:02,370
خسارة كافّة أتباعك

167
00:11:02,540 --> 00:11:05,540
جهلُك قتلَهم-
كلّ هذا غلطتي-

168
00:11:05,540 --> 00:11:08,500
،أولئك العوام عديمو القيمة، الأدنى من كِلاب

169
00:11:08,870 --> 00:11:10,250
مهما أرشدتهم

170
00:11:10,370 --> 00:11:12,910
سيموتون موتاً عديم المعنى رغم ذلك

171
00:11:14,660 --> 00:11:16,370
وماذا لو كانوا من العوام؟

172
00:11:16,870 --> 00:11:18,750
وماذا لو كانوا عاديّين وضعفاء؟

173
00:11:23,370 --> 00:11:28,620
ما زلتُ أقف هنا اليوم، ليس بسبب
الموهبة، وليس السّحر بالتّاكيد

174
00:11:29,250 --> 00:11:31,620
لي، أنت هو هدفي

175
00:11:32,120 --> 00:11:33,370
أنت تحمل آمال الجميع

176
00:11:34,370 --> 00:11:36,540
كيف أمكنك أن تسقط قبلي؟

177
00:11:43,870 --> 00:11:44,620
تماماً

178
00:11:45,660 --> 00:11:46,370
أجل

179
00:11:47,540 --> 00:11:51,040
القتال حتّى هذا اليوم يُثبت
بأنّ السّحر ليس شيئاً لا يُقهَر

180
00:11:52,000 --> 00:11:53,870
،ما أنجزتَه في أسبوع واحد

181
00:11:54,410 --> 00:11:57,290
أستطيع إنجازه في شهر، أو نصف
عام، أو ثلاث سنوات

182
00:11:57,620 --> 00:11:59,790
،لذا حتّى لو أصبحنا عظاماً وغُباراً

183
00:12:00,120 --> 00:12:02,120
،حتّى لو لم نستطع الفوز عدّة مرّات

184
00:12:02,120 --> 00:12:04,870
ما دامت شرارة الحياة في قلوب
،النّاس موجودة

185
00:12:05,250 --> 00:12:07,620
...ما داموا لا يريدون فقدان حياتهم كُلّها

186
00:12:11,040 --> 00:12:11,790
ماذا؟

187
00:12:16,620 --> 00:12:19,250
ستأتي نار المروج يوماً ما

188
00:12:25,370 --> 00:12:26,290
هذا سخيف

189
00:12:26,750 --> 00:12:28,160
لم يبقَ لك شيء

190
00:12:37,790 --> 00:12:41,000
عبر الجبل، ضرب الثّور

191
00:12:46,160 --> 00:12:47,370
...كيف تجرؤ

192
00:12:58,750 --> 00:13:01,250
رِفاق، تأخّرت

193
00:13:06,250 --> 00:13:08,120
‏78 يوم