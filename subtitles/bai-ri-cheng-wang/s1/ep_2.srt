1
00:00:48,370 --> 00:00:51,370
في وقت كهذا، أعددت الفطور رغم ذلك؟

2
00:00:51,830 --> 00:00:54,500
لطالما قالت أمّي بأنّ الصّباح يُعدّل المزاج

3
00:00:54,620 --> 00:00:56,700
للهيمنة على اليوم، غذِّ نفسك أوّلاً

4
00:00:57,330 --> 00:01:00,330
فضلاً عن ذلك، سنبدأ اليوم بشيء مُهمّ

5
00:01:00,750 --> 00:01:02,700
لم تذكر أباك أبداً

6
00:01:03,370 --> 00:01:03,870
أين هو؟

7
00:01:05,870 --> 00:01:07,200
،قبل إسقاطك للملك القديم

8
00:01:07,450 --> 00:01:09,330
كان قد أُخِذَ للأشغال الشّاقّة ومات

9
00:01:11,870 --> 00:01:12,330
،الملك لي

10
00:01:12,450 --> 00:01:15,000
قالت السّيّدة ساحرة بأنّ شخصاً
أخذ جسدك في اللّيلة الماضية

11
00:01:15,200 --> 00:01:16,080
ماذا حدث بالضّبط؟

12
00:01:16,750 --> 00:01:18,620
في تلك اللّيلة، كنتُ في دورة مياه القاعة

13
00:01:18,950 --> 00:01:20,580
بطريقة ما، غلبني النُّعاس

14
00:01:21,080 --> 00:01:21,830
،عندما فتحتُ عينَي

15
00:01:22,200 --> 00:01:23,750
وجدتُ نفسي قد أصبحتُ روحاً

16
00:01:24,500 --> 00:01:25,950
في البداية، ظننتُه حلماً

17
00:01:26,580 --> 00:01:30,450
ثمّ رأيتُ ذلك المُزيّف يمسح مُؤخّرتي

18
00:01:30,750 --> 00:01:31,330
،الملك لي

19
00:01:31,330 --> 00:01:32,580
لا داعي للتطرُّق لمثل هذه التّفاصيل

20
00:01:32,830 --> 00:01:34,080
طبّقتَ نظام حظر السّحر

21
00:01:34,200 --> 00:01:34,830
من كان يتوقّع

22
00:01:34,950 --> 00:01:36,330
بأن يكون الشّخص الّذي استخدم
سحراً لأذيّتك

23
00:01:36,450 --> 00:01:37,500
داخل القصر الملكيّ مُباشرة

24
00:01:38,700 --> 00:01:40,450
والآن أنا أُقيم داخل جسدك

25
00:01:40,580 --> 00:01:42,120
هذا يجعلنا أخوين نتشارك جسداً واحداً

26
00:01:42,330 --> 00:01:43,330
لذا لا تُنادِني بالملك لي

27
00:01:43,580 --> 00:01:44,330
نادِني بـ لي فحسب

28
00:01:44,580 --> 00:01:45,330
حسناً يا لي

29
00:01:45,450 --> 00:01:45,830
ثمّة أمر آخر

30
00:01:45,950 --> 00:01:47,700
ما هو نِظام حظر السّحر الّذي ذكرتَه؟

31
00:01:47,830 --> 00:01:49,330
متى أصدرتُ مثل هذا القرار؟

32
00:01:50,080 --> 00:01:50,750
ألا تعلم؟

33
00:01:51,080 --> 00:01:53,450
تمّ تطبيقه منذ تولّيك للعرش

34
00:01:53,750 --> 00:01:54,950
لا يستطيع النّاس دِراسة السّحر بعد الآن

35
00:01:55,200 --> 00:01:56,500
ولا يستطيعون استخدام السّحر أيضاً

36
00:01:56,830 --> 00:02:00,120
العديد من المِهَن الّتي تعمل بالسّحر
الآن تستخدم عملاً يدويّاً

37
00:02:00,500 --> 00:02:02,580
وسحَرة سابقون مثل السّيّدة ساحرة

38
00:02:02,700 --> 00:02:04,830
أُرسِلوا إلى أماكن نائية كالحيّ 9

39
00:02:08,370 --> 00:02:09,080
هذا غير منطقيّ

40
00:02:09,580 --> 00:02:11,950
كيف لي ألّا أتذكّر شيئاً هامّاً كهذا؟

41
00:02:12,870 --> 00:02:13,250
لحظة

42
00:02:13,700 --> 00:02:14,580
ماذا حدث للتو؟

43
00:02:15,080 --> 00:02:15,580
ما الأمر؟

44
00:02:16,000 --> 00:02:16,830
ماذا فعلت؟

45
00:02:16,950 --> 00:02:18,080
لوهلة، شعرتُ

46
00:02:18,580 --> 00:02:20,580
باندفاعٍ لم يُراودني من قبل

47
00:02:21,200 --> 00:02:21,620
...أنا

48
00:02:22,200 --> 00:02:23,700
قمتُ برشف عصيدة فقط

49
00:02:24,080 --> 00:02:24,450
هل يُعقَل

50
00:02:24,620 --> 00:02:26,080
أنّك تستطيع تذوُّق الطّعام الّذي آكله؟

51
00:02:27,200 --> 00:02:29,080
إذاً كانت برَكة الشّعور بالشّبع

52
00:02:29,700 --> 00:02:32,330
لكن ذلك المذاق الفظيع جعلَ ذلك مُحيّراً جدّاً

53
00:02:32,500 --> 00:02:33,080
كيف هو مذاقه؟

54
00:02:33,580 --> 00:02:35,080
علّمَني عمّي بنفسه

55
00:02:35,620 --> 00:02:38,700
هل تُدير مطعماً أو صيدليّة؟

56
00:02:38,870 --> 00:02:40,200
إذا كان هذا يمنحك شعوراً لطيفاً، فسأستمرّ

57
00:02:40,200 --> 00:02:40,450
لا تفعل

58
00:02:40,830 --> 00:02:41,200
انتظر

59
00:02:49,250 --> 00:02:50,080
تمّت التّغذية بنجاح

60
00:02:50,250 --> 00:02:51,080
كُلّ العتاد جاهز

61
00:02:51,370 --> 00:02:53,700
الأيّام المئة المُقبلة ستكون شديدة

62
00:02:53,830 --> 00:02:55,450
هل أنت جاهز لمُواجهة العاصفة؟

63
00:02:55,580 --> 00:02:56,950
قلبي من حجر

64
00:02:57,080 --> 00:02:58,620
،حتّى لو كان الطّريق مليئاً بالخنادق

65
00:02:58,750 --> 00:03:00,000
سأملؤها في طريقي

66
00:03:00,250 --> 00:03:01,450
هل أنت شياومينغ؟

67
00:03:07,700 --> 00:03:09,700
آسفة، ظننتُك شخصاً آخر

68
00:03:10,330 --> 00:03:10,870
بالمُناسبة

69
00:03:11,330 --> 00:03:12,450
هل رأيت طفلاً

70
00:03:12,700 --> 00:03:14,200
في مثل سنّك؟

71
00:03:14,580 --> 00:03:15,830
اسمه وانغ شياومينغ

72
00:03:16,200 --> 00:03:17,330
كان يرتدي الأبيض

73
00:03:17,830 --> 00:03:19,450
ورُبّما يوجد دمٌ عليه

74
00:03:21,080 --> 00:03:23,620
بعد الاندماج الرُّوحيّ، أُعيد بناء حياتك

75
00:03:24,250 --> 00:03:25,450
لن يعرفك أحدٌ الآن

76
00:03:26,450 --> 00:03:26,870
إذاً؟

77
00:03:27,620 --> 00:03:28,950
هل ستُخبر أمّك بالحقيقة؟

78
00:03:31,450 --> 00:03:32,250
أنا آسف يا سيّدتي

79
00:03:32,830 --> 00:03:34,080
لم أرَ الشّخصَ الّذي ذكرتِه

80
00:03:35,000 --> 00:03:35,950
آسفة لإزعاجك

81
00:03:37,120 --> 00:03:37,700
شكراً لك

82
00:03:38,330 --> 00:03:40,700
معرفة المزيد سوف يُعرّضكِ للخطر

83
00:03:40,950 --> 00:03:41,200
،أمّي

84
00:03:41,500 --> 00:03:41,870
انتظريني

85
00:03:42,120 --> 00:03:44,620
بعد 100 يوم، سأعيد شياوهونغ إلى المنزل

86
00:03:45,000 --> 00:03:46,000
شياومينغ

87
00:03:46,450 --> 00:03:47,450
هل أنت هناك؟

88
00:03:48,080 --> 00:03:50,000
هل عدت يا شياومينغ؟

89
00:03:53,450 --> 00:03:54,950
هذا هو الحيّ 9 إذاً

90
00:03:55,580 --> 00:03:56,700
كيف أصبح مُتقوِّضاً هكذا؟

91
00:03:56,830 --> 00:03:59,000
أنت لا تعرف شيئاً عن نِظام حظر السّحر

92
00:03:59,120 --> 00:04:01,500
وبالكاد تعرف الوضع الحاليّ
في الحيّ 9 الآن

93
00:04:02,080 --> 00:04:04,120
كملِك للدّولة، كيف لك أن تجهل شيئاً كهذا؟

94
00:04:04,250 --> 00:04:05,580
مهلاً، لا تنتقدني

95
00:04:06,120 --> 00:04:07,830
لا يكون المرء خبيراً في البداية
عندما يصبح ملِكاً

96
00:04:09,120 --> 00:04:10,500
،هل تعلم بأنّني عندما تبوّأتُ العرش أوّل مرّة

97
00:04:10,750 --> 00:04:12,080
كم من الأمور كان عليّ مُعالجتها كُلّ يوم؟

98
00:04:12,370 --> 00:04:14,000
الدّولة بأكملها مُكوّنة من عشرة أحياء

99
00:04:14,250 --> 00:04:17,830
تظهر المشاكل في كلّ حيّ بشكل يوميّ

100
00:04:18,200 --> 00:04:21,620
يُرسلون تقاريرَ إليّ حولها

101
00:04:21,750 --> 00:04:22,580
ويُطلَب إعطاء رأيي

102
00:04:22,750 --> 00:04:24,080
أنا جيّد في القتال

103
00:04:24,080 --> 00:04:26,330
لكن في القراءة؟ بالكاد أستطيع فهم جملة

104
00:04:26,580 --> 00:04:28,080
ويريدونني أن أقرأ أكواماً بشكل يوميّ

105
00:04:28,330 --> 00:04:30,370
هذا أشبه بوضعنا في سرير توأم واحد

106
00:04:30,830 --> 00:04:32,120
المُشكلة تلو الأُخرى

107
00:04:32,700 --> 00:04:33,450
لذا ماذا عسانا نفعل؟

108
00:04:33,830 --> 00:04:35,750
هذه المسائل ضروريّة للدّولة

109
00:04:35,950 --> 00:04:37,080
،إن كنت لا تستطيع مُجاراة عملك
هذا لا يمنع أن تقرأ

110
00:04:38,080 --> 00:04:39,580
النّاس يتعلّمون ويكبرون، صحيح؟

111
00:04:40,580 --> 00:04:42,450
لا يمكن للدّولة أن تعتمد على عقلي وحده

112
00:04:42,870 --> 00:04:44,950
لذا لاحقاً، بدأتُ باستخدام طُرُق إداريّة

113
00:04:45,080 --> 00:04:46,620
لنشر الفائض اليوميّ للعمل

114
00:04:46,870 --> 00:04:48,330
عيّنتُ رئيسَ حيّ في كلّ حيّ

115
00:04:48,700 --> 00:04:50,620
ثمّ يُرسل رئيسُ الحيّ تقريره اليوميّ

116
00:04:51,080 --> 00:04:53,500
إلى رئيس الشّؤون الدّاخليّة

117
00:04:53,620 --> 00:04:54,200
ويُبلغونني بأبرز المشاكل فقط

118
00:04:54,580 --> 00:04:56,700
بهذه الطّريقة، أحكُم فقط على ما هو أهمّ

119
00:04:57,080 --> 00:04:58,080
أتعتبر هذه إدارة؟

120
00:04:58,080 --> 00:04:59,250
إنّه مُجرّد كسل في الحكم

121
00:04:59,700 --> 00:05:00,950
الكلام أسهل من الفعل

122
00:05:01,200 --> 00:05:02,450
هل لديك خطّة أفضل؟ لنستمع إليها

123
00:05:03,830 --> 00:05:04,120
انتظر

124
00:05:04,580 --> 00:05:05,080
أوّلاً، أخبرني

125
00:05:05,200 --> 00:05:07,200
ما خطّتك في مهمّة الانتقام العظيم هذا؟

126
00:05:07,330 --> 00:05:08,120
أي خطّة؟

127
00:05:10,000 --> 00:05:11,700
أتمزح معي؟

128
00:05:12,000 --> 00:05:13,950
أنا القوّة الأعظم في هذه الدّولة

129
00:05:14,120 --> 00:05:15,950
جيش من رجُل واحد

130
00:05:16,200 --> 00:05:18,450
سأشقُّ طريقي إلى داخل القصر الملكيّ مُباشرة

131
00:05:18,580 --> 00:05:19,700
لنرَ من يجرؤ على إيقافي

132
00:05:19,950 --> 00:05:22,120
سأدمِّر أيّ شخص يعترض طريقي

133
00:05:22,250 --> 00:05:24,330
عارضني وستفنى. أطعني وستفلح

134
00:05:24,450 --> 00:05:25,950
،حالما أمسك بذلك القمامة

135
00:05:26,200 --> 00:05:27,870
سوف أقطع رأسه

136
00:05:28,200 --> 00:05:30,250
أقطع رأسي، أُسقِط نفسي

137
00:05:30,450 --> 00:05:31,870
عبقريّ. عبقريّ فعلاً

138
00:05:32,080 --> 00:05:33,120
ها أنت ذا من جديد. مُجرّد كلام

139
00:05:33,330 --> 00:05:34,500
إذاً أعطِني خطّة أفضل

140
00:05:35,700 --> 00:05:38,080
إحضارك إلى هنا هو جزء من خطّتي

141
00:05:38,080 --> 00:05:38,830
...هذا

142
00:05:39,700 --> 00:05:41,500
مسرح الأطفال الخاصّ بليلي-تشان

143
00:05:41,700 --> 00:05:42,700
ليلي-تشان؟

144
00:05:43,700 --> 00:05:46,830
هذا الاسم لمسرح الأطفال؟ حقّاً؟

145
00:05:47,250 --> 00:05:47,700
،لي

146
00:05:48,250 --> 00:05:50,080
أيّها الأحمق الطّائش عديم الجدوى

147
00:05:50,620 --> 00:05:54,450
دُمِّرَ قرنٌ من السّحر بواسطتك

148
00:05:54,950 --> 00:05:56,500
!واجه العقوبة الإلهيّة

149
00:05:57,200 --> 00:05:59,200
!خمس صعقات بالسّهم الرّعديّ

150
00:05:59,830 --> 00:06:01,080
!ممتاز

151
00:06:01,580 --> 00:06:04,450
كيف للأطفال أن يحضروا مشاهدَ قاسية كهذه؟

152
00:06:05,000 --> 00:06:06,370
،حالما أستعيد جسدي

153
00:06:06,700 --> 00:06:08,700
أوّل شيء سأفعله هو إغلاق هذا المكان

154
00:06:09,450 --> 00:06:12,080
لماذا تُحضرني إلى هذا برنامج
الأطفال المُهين هذا؟

155
00:06:12,700 --> 00:06:13,620
أنا لستُ هنا لأجل البرنامج

156
00:06:13,750 --> 00:06:14,830
أنا هنا للبحث عن شخص

157
00:06:16,120 --> 00:06:17,870
،كبير السّحرة لي وان

158
00:06:18,250 --> 00:06:19,450
أنا من أشدّ المُعجبين بك

159
00:06:19,750 --> 00:06:23,330
من فضلك عُد وأسقط هذا المُستبدّ

160
00:06:23,750 --> 00:06:24,450
لي وان؟

161
00:06:24,700 --> 00:06:26,700
كبير السّحرة الّذي أسقطتُه
ذات مرّة بلكمة واحدة

162
00:06:28,620 --> 00:06:29,200
،أيُّها الشّاب

163
00:06:29,580 --> 00:06:30,830
هل تعي ما تقوله؟

164
00:06:31,000 --> 00:06:33,330
الكلام الخطير قد يقودك إلى الإعدام

165
00:06:34,620 --> 00:06:35,750
أعي بالطّبع

166
00:06:35,870 --> 00:06:37,200
كنتَ تُمثّل الجالية السّحريّة

167
00:06:37,330 --> 00:06:39,080
وقاتلتَ الملك لي لثلاثة أيّام

168
00:06:39,330 --> 00:06:40,330
في النّهاية، خسرتَ بفارق طفيف

169
00:06:40,450 --> 00:06:42,830
أريد أن أُساعدك في إصلاح ذلك -
ثلاثة أيّام؟ -

170
00:06:43,000 --> 00:06:44,200
أنهيتُ الأمر بلكمة واحدة

171
00:06:44,330 --> 00:06:45,200
لكمة واحدة

172
00:06:45,700 --> 00:06:46,450
،أيُّها الشّابّ

173
00:06:46,830 --> 00:06:47,870
دعني أُذكّرك

174
00:06:48,000 --> 00:06:49,330
لم تكن ثلاثة أيّام

175
00:06:49,580 --> 00:06:50,950
كانت سبعة أيّام بلياليها

176
00:06:51,450 --> 00:06:54,450
إذاً أنت تعلم كم أنّ إسقاطه صعب

177
00:06:54,700 --> 00:06:57,580
شاهدتُ البرامجَ منذ ليلة الافتتاح

178
00:06:57,700 --> 00:07:00,580
عصيانك لنِظام حظر السّحر أثّرَ بي بعمق

179
00:07:00,700 --> 00:07:02,250
أصبح دليلي في الحياة

180
00:07:02,700 --> 00:07:04,950
أخبرني، هل نويتَ للقيام بانتفاضة حقّاً؟

181
00:07:05,080 --> 00:07:06,620
إذاً افتتاح مسرح أطفال

182
00:07:06,870 --> 00:07:08,870
لتعليم المُقاومة عن عمر صغير

183
00:07:09,200 --> 00:07:10,200
أثمرَ فعلاً

184
00:07:10,450 --> 00:07:11,200
،أيُّها الشّابّ

185
00:07:11,330 --> 00:07:12,700
أنا مُعجب بشجاعتك

186
00:07:12,830 --> 00:07:14,080
،لكن لإصلاح العالم

187
00:07:14,200 --> 00:07:16,700
القوّة غير كافية. الموهبة مُهمّة أيضاً

188
00:07:16,830 --> 00:07:18,330
كان لي قادراً على أن يصبح ملِكاً

189
00:07:18,330 --> 00:07:20,330
لأنّه كان يمتلك قوّةً لا نظير له

190
00:07:20,450 --> 00:07:21,700
قدرتك على بلوغ ذلك

191
00:07:21,830 --> 00:07:24,250
تعتمد على فُرصتك في السّحر

192
00:07:24,450 --> 00:07:26,750
لذا دعني أختبرك اختباراً بسيطاً

193
00:07:28,080 --> 00:07:30,580
هل ستطلب منّي لمس حجر لتحديد رتبتي

194
00:07:31,000 --> 00:07:32,000
لا تكُن غبيّاً

195
00:07:32,080 --> 00:07:33,750
مُحال أن أستخدم شيئاً مُبالَغاً به كهذا

196
00:07:34,330 --> 00:07:36,200
دع تلميذتي تُريك الطّريقة

197
00:07:39,120 --> 00:07:40,250
حاضرة

198
00:07:42,370 --> 00:07:44,950
ينبغي لهذه التّجربة أن تكون سهلة
بالنّسبة لك، صحيح؟

199
00:07:45,580 --> 00:07:47,620
لكن لا أعرف شيئاً عن التّعويذات

200
00:07:51,950 --> 00:07:52,450
،شياولان

201
00:07:52,950 --> 00:07:53,500
لنبدأ

202
00:07:54,580 --> 00:07:58,200
ماكاباكا كابيبالا دالابينغبا
،ميلابالا شيليهوالا

203
00:07:58,330 --> 00:08:00,700
ساسيميا تشيغيشي بابالابالا

204
00:08:02,120 --> 00:08:02,330
بيو

205
00:08:10,250 --> 00:08:13,620
أطلقتْ شياولان للتو صاروخَ أركان أساسيّاً

206
00:08:14,200 --> 00:08:14,830
،أيُّها الشّابّ

207
00:08:15,120 --> 00:08:16,200
جرّب ذلك الآن

208
00:08:17,370 --> 00:08:19,000
أتذكّر الحركات

209
00:08:19,500 --> 00:08:20,700
الحركات ليست الجزء الصّعب

210
00:08:20,830 --> 00:08:22,700
يكمن المفتاح في جعل الصّاروخ يظهر

211
00:08:23,080 --> 00:08:24,450
،ملِك دولة عظيم

212
00:08:24,580 --> 00:08:25,830
ولا يمكنك استخراج حتّى قطرة مانا؟

213
00:08:26,750 --> 00:08:27,250
انسَ الأمر

214
00:08:27,750 --> 00:08:29,830
جرّبتُ عدّة مرّات، دون جدوى

215
00:08:30,450 --> 00:08:32,200
لولا ذلك، ما كان ليتمّ إسقاطي

216
00:08:32,450 --> 00:08:34,500
وما كنتُ لأتمكّن من إسقاط الملِك القديم

217
00:08:35,870 --> 00:08:37,580
رُبّما السّماء تُحافظ على التّوازن

218
00:08:37,580 --> 00:08:40,120
تمنح قوّةً إلهيّة

219
00:08:40,120 --> 00:08:41,330
لكن ختمتْ في المُقابل على المانا خاصّتي

220
00:08:41,580 --> 00:08:43,700
جُعِلتُ أعمى للسّحر

221
00:08:44,450 --> 00:08:45,000
ما باليد حيلة

222
00:08:45,120 --> 00:08:47,200
في هذه الحالة، يجب عليّ المُخاطرة

223
00:08:48,620 --> 00:08:49,370
،آنسة شياولان

224
00:08:49,700 --> 00:08:51,830
هلّا علّمتِني التّعويذة عينها؟

225
00:08:52,250 --> 00:08:55,830
ماكاباكا كابيبالا دالابينغبا
،ميالبالا شيليهوالا

226
00:08:55,830 --> 00:08:58,080
ساسيميا تشيغيشي بابالابالا

227
00:08:58,500 --> 00:08:58,870
حسناً

228
00:08:59,330 --> 00:08:59,950
فهمتُها

229
00:09:01,330 --> 00:09:03,120
لم أفهم أيّ كلمة من تمتمتها

230
00:09:03,250 --> 00:09:04,200
حفظتَها بعد مُحاولة أُولى؟

231
00:09:04,370 --> 00:09:05,200
،أيُّها الشّابّ

232
00:09:05,830 --> 00:09:07,000
،الثِّقة جيّدة

233
00:09:07,330 --> 00:09:08,620
لكن الغرور لن يقودك إلى مكان

234
00:09:09,750 --> 00:09:13,250
ماكاباكا كابيبالا دالابينغبا
،ميالبالا شيليهوالا

235
00:09:13,250 --> 00:09:15,580
ساسيميا تشيغيشي بابالابالا

236
00:09:18,000 --> 00:09:18,950
حفظَها فعلاً

237
00:09:19,200 --> 00:09:20,330
كيف فعلت ذلك؟

238
00:09:20,870 --> 00:09:21,950
صنعتُ كُرةً في الواقع

239
00:09:22,330 --> 00:09:23,200
...لا أعلم، هذه

240
00:09:23,330 --> 00:09:23,580
...إنّها

241
00:09:23,700 --> 00:09:24,580
ظهرتْ من تلقاء نفسها

242
00:09:26,000 --> 00:09:27,200
لكن هذا الشّيء كبير جدّاً

243
00:09:27,620 --> 00:09:29,080
!وما زال يتوسّع

244
00:09:29,830 --> 00:09:30,830
!أيُّها الشّابّ، أطلقها

245
00:09:30,950 --> 00:09:31,870
!اقذفها بعيداً

246
00:09:32,080 --> 00:09:33,700
إذا انفجرت هنا، سنحترق جميعاً

247
00:09:33,950 --> 00:09:36,330
تلوتُ التّعويذة كلمة كلمة

248
00:09:36,500 --> 00:09:38,200
لكن لا يوجد أمرٌ لإطلاقها

249
00:09:38,950 --> 00:09:39,370
!بئساً

250
00:09:39,950 --> 00:09:40,620
نسيتُ تعليمك ذلك

251
00:09:40,950 --> 00:09:43,000
كيف لكِ أن تبقي هادئة الآن؟

252
00:09:43,200 --> 00:09:43,370
بيو

253
00:09:43,830 --> 00:09:44,120
،بسرعة

254
00:09:44,330 --> 00:09:44,830
،أيُّها الشّابّ

255
00:09:44,870 --> 00:09:45,450
!أطلقها

256
00:09:48,330 --> 00:09:48,580
بيو

257
00:10:04,330 --> 00:10:05,450
كان ذلك وشيكاً

258
00:10:06,330 --> 00:10:07,080
،كبير السّحرة لي وان

259
00:10:07,370 --> 00:10:08,580
تمّ إطلاق صاروخ أركان بنجاح

260
00:10:08,750 --> 00:10:10,330
نجحتُ في الاختبار إذاً، صحيح؟

261
00:10:10,330 --> 00:10:11,080
،أيُّها الشّابّ

262
00:10:11,250 --> 00:10:12,120
ليس تماماً

263
00:10:13,000 --> 00:10:14,830
وضّحتْ تلميذتي كيفيّة ضرب طيور

264
00:10:15,700 --> 00:10:16,450
تأمّل حالك

265
00:10:16,830 --> 00:10:17,830
أطلقتَ الكثير

266
00:10:18,120 --> 00:10:19,500
لكن لم تُصِب أيّ طائر

267
00:10:20,620 --> 00:10:22,330
هذا العجوز ماكر جدّاً

268
00:10:22,450 --> 00:10:24,080
كيف لك أن تُغيّر القواعد الآن؟

269
00:10:24,330 --> 00:10:24,620
،لي

270
00:10:24,950 --> 00:10:26,620
من أين أتت تلك المانا؟

271
00:10:28,080 --> 00:10:29,700
هكذا تُرنَّم التّعويذة إذاً

272
00:10:30,200 --> 00:10:31,700
لم أقلها من قبل

273
00:10:31,700 --> 00:10:32,370
ماذا؟

274
00:10:32,700 --> 00:10:36,200
لم تكن أعمى للسّحر فحسب، كُنتَ أُمّيّاً

275
00:10:38,200 --> 00:10:38,750
،إذاً

276
00:10:39,200 --> 00:10:40,870
صاروخ أركان الضّخم ذاك للتو

277
00:10:41,120 --> 00:10:43,200
يعني أنّ نقاط المانا خاصّتك أعلى
من المُتوسّط بكثير

278
00:10:43,870 --> 00:10:45,830
تبدو السّماء غريبة قليلاً

279
00:10:47,000 --> 00:10:47,950
ماذا حدث للتو؟

280
00:11:04,500 --> 00:11:05,500
ذلك الصّاروخ للتو

281
00:11:05,700 --> 00:11:07,700
حطّمَ النّجومَ في السّماء

282
00:11:09,950 --> 00:11:11,580
من قال أنّ السّماء عادلة؟

283
00:11:11,830 --> 00:11:13,580
أنت في الواقع تمتلك القوّة العُظمى

284
00:11:13,830 --> 00:11:15,700
ومانا مُدهشة معها

285
00:11:20,330 --> 00:11:23,450
لماذا فجّرَ النّجومَ لتتّخذ شكلَ قلب؟
هل كان ذلك اعترافاً؟

286
00:11:24,080 --> 00:11:24,450
ما رأيك؟

287
00:11:24,620 --> 00:11:25,450
،كبير السّحرة لي وان

288
00:11:25,750 --> 00:11:27,120
هل يُعدّ هذا نجاحاً في الاختبار؟

289
00:11:28,200 --> 00:11:28,950
،أيُّها الشّابّ

290
00:11:29,200 --> 00:11:29,870
،اعتباراً من هذه اللّحظة

291
00:11:30,080 --> 00:11:31,200
اعتبرني أشدّ المُعجبين بك

292
00:11:31,450 --> 00:11:34,580
أطلب منك هنا المُساعدة في إسقاط
حُكم الطّاغية

293
00:11:36,250 --> 00:11:37,200
إذاً علينا أن نُسرع

294
00:11:37,950 --> 00:11:39,500
بقي 99 يوم فقط

295
00:11:52,080 --> 00:11:53,330
السّماء تُرينا إشارة

296
00:11:53,950 --> 00:11:55,950
هذا يعني بأنّ السّماء تُبارك بهذا الهدف

297
00:11:57,250 --> 00:11:59,370
انظري، النّجوم تُشكّل قلباً

298
00:12:00,330 --> 00:12:03,000
ألا يعني هذا بأنّنا مُتوافِقان
بمشيئة السّماء؟

299
00:12:03,370 --> 00:12:03,950
لا تلمسني

300
00:12:06,330 --> 00:12:07,330
اهدئي

301
00:12:07,830 --> 00:12:10,250
لن ألمسكِ ما لم تصبحي بالغة

302
00:12:10,950 --> 00:12:12,950
مُحال أن أفعل أيّ شيء

303
00:12:13,200 --> 00:12:14,120
عديم الذّوق والأخلاق

304
00:12:14,580 --> 00:12:16,200
،في يوم بلوغكِ

305
00:12:16,620 --> 00:12:19,000
سأتزوّجكِ لتصبحي عقيلتي الأميرة

306
00:12:20,830 --> 00:12:22,830
مينغ، هل أنتم بخير؟

307
00:12:23,580 --> 00:12:26,580
آمل أنّكم ترون نفس السّماء الّتي أراها الآن

308
00:12:27,330 --> 00:12:28,750
من خلالها، أنقل

309
00:12:29,330 --> 00:12:30,450
مشاعري