1
00:00:50,660 --> 00:00:52,910
لي، الطبّاخ الّذي عثرنا عليه في الحيّ 9

2
00:00:53,160 --> 00:00:54,160
قتلَ نفسه فجأة بلا سبب

3
00:00:54,160 --> 00:00:58,290
ما يعني بأنّه لا أحد يستطيع إعداد
الطّبق الّذي استمتعت به حبيبتي؟

4
00:00:58,700 --> 00:00:59,910
...أنا... أنا

5
00:01:00,700 --> 00:01:01,660
ما زلتُ أبحث عن حلّ

6
00:01:02,040 --> 00:01:02,660
أمهلني بعض الوقت

7
00:01:03,040 --> 00:01:04,160
سأُعيد إنشاءه حتماً

8
00:01:06,330 --> 00:01:06,950
،لونغ أو

9
00:01:07,450 --> 00:01:09,790
،هل تعرف لماذا، بعد أن قاتلنا معاً

10
00:01:10,410 --> 00:01:12,040
انتهى المطاف بك رئيساً للّوجستيّات؟

11
00:01:12,830 --> 00:01:14,790
لأنّ مهاراتك ضعيفة جدّاً

12
00:01:15,200 --> 00:01:18,200
الاحتفاظ بك هنا بلقب جِنرال النّمر الثّامن

13
00:01:18,410 --> 00:01:19,540
هو لأنّني ما زلتُ أحترم ماضينا فقط

14
00:01:20,450 --> 00:01:24,450
لكن لم أتوقّع أبداً بأن تنحدر إلى الحدّ
الّذي تعجز فيه عن مُعالجة هذا حتّى

15
00:01:25,290 --> 00:01:28,910
إذا فقدت ملِكتي المُستقبليّة شهيّتها
،وفسدت صحّتُها بسبب هذا

16
00:01:29,290 --> 00:01:32,040
فأخبرني، ماذا يجدر بي أن أفعل بك؟

17
00:01:34,790 --> 00:01:37,830
،لكن لحسن الحظّ بعد تذوُّق ذلك الطّبق
عادت شهيّتها

18
00:01:38,200 --> 00:01:40,160
سموّك، كُلي على مهل رجاء

19
00:01:44,450 --> 00:01:46,040
رغم أنّ شهيّتها قد تحسّنت

20
00:01:46,410 --> 00:01:50,200
إلّا أنّه ما زال عليك التّحقيق بشموليّة
حول وصفة الطبّاخ السّرّية تلك ووفاته

21
00:01:50,540 --> 00:01:53,040
الحيّ 9 دائماً ما يُقلقني

22
00:01:54,910 --> 00:01:55,160
بالمناسبة

23
00:01:55,910 --> 00:01:56,700
ثمّة أمر آخر

24
00:01:57,290 --> 00:01:58,580
لا تُنادني بـ لي بعد الآن

25
00:01:59,160 --> 00:02:01,910
لا أريد من الآخرين أن يعتقدوا
بأنّني مُتحيّز لأشخاص مُعيّنين

26
00:02:02,290 --> 00:02:03,910
وعيّنتُك كمسؤول رفيع فقط لذلك السّبب

27
00:02:04,410 --> 00:02:06,040
نادِني بالملك لي كما الجميع فحسب

28
00:02:15,200 --> 00:02:16,790
!أيُّها الفظّ الأحمق العاجز

29
00:02:17,160 --> 00:02:18,410
!أتجرؤ على الكذب عليّ؟

30
00:02:18,790 --> 00:02:19,700
!فلتمُت

31
00:02:20,080 --> 00:02:21,540
!هجمات الرّعد الخمس

32
00:02:21,540 --> 00:02:22,450
!اهدأ

33
00:02:25,080 --> 00:02:26,540
،إن كانت لديك الجرأة
!فلا تستخدم فنّاً مُحرّماً

34
00:02:26,790 --> 00:02:28,200
ألا تُحبّ القتال اليدويّ؟

35
00:02:28,540 --> 00:02:28,910
!هيّا

36
00:02:29,290 --> 00:02:31,200
!قاتلني لسبعة أيّام إضافيّة بلياليها

37
00:02:31,660 --> 00:02:32,410
،كبير السّحرة لي وان

38
00:02:32,910 --> 00:02:34,410
كنتُ أشرح منذ البارحة

39
00:02:34,580 --> 00:02:36,290
إنّه سوء فهم. سوء فهم

40
00:02:36,540 --> 00:02:39,160
لا أصدّق بأنّ ذلك الحارس
با قد كشفَ الأمر

41
00:02:39,290 --> 00:02:40,160
الملك لي

42
00:02:40,790 --> 00:02:42,410
هل أنت الملك لي

43
00:02:45,450 --> 00:02:46,540
عمّاذا تتكلّم؟

44
00:02:46,790 --> 00:02:47,580
اسمي مياو

45
00:02:47,910 --> 00:02:49,290
لا يوجد ملِك لي هنا

46
00:02:50,040 --> 00:02:51,450
كيف شعر بوجودي؟

47
00:02:51,910 --> 00:02:53,790
يمكنك أن تُخفي وجهك، وصوتك

48
00:02:54,040 --> 00:02:54,950
أو حتّى شخصيّتك

49
00:02:55,660 --> 00:02:58,040
لكن لا يستطيع أحدٌ تزييف عاداته

50
00:02:58,290 --> 00:02:59,540
،تلك اللّكمة الّتي وجّهتها للتو

51
00:02:59,790 --> 00:03:03,700
تدفّقها وشكلها، كلّ حركة محفورة
بعمق في ذاكرتي

52
00:03:03,830 --> 00:03:05,040
،آنذاك في سنوات الحرب الفوضويّة تلك

53
00:03:05,160 --> 00:03:07,160
هُجّرَتْ عائلتي وتشرّدت

54
00:03:07,330 --> 00:03:08,660
وهمنا في مناطق عديدة

55
00:03:08,790 --> 00:03:10,450
فصادفنا قُطّاع طُرُق ذات يوم

56
00:03:10,580 --> 00:03:14,200
كانوا بلا ضمير، يسرقون اللّاجئين
وينهبون كُلّ ما بقي لدينا

57
00:03:14,790 --> 00:03:16,410
،وعندما كنّا تحت رحمتهم

58
00:03:16,700 --> 00:03:19,950
ظهرتَ كآخر قطعة من مناديل دورة المياه

59
00:03:20,290 --> 00:03:22,910
أنت وقادتك الشّرسون هزمتموهم

60
00:03:23,290 --> 00:03:27,830
،وفي تلك اللّحظة رأيتُ لكمتك بوضوح
أوّل وآخر مرّة

61
00:03:28,540 --> 00:03:30,660
،لطالما أُعجبتُ بقصصك الأسطوريّة

62
00:03:31,200 --> 00:03:33,080
وتمنّيتُ دوماً أن أصبح بطلاً مثلك

63
00:03:33,290 --> 00:03:36,950
لذا كُلّ لكمة وجّهتَها بدت كقرن
،يعبر من أمام أنظاري

64
00:03:37,410 --> 00:03:40,790
وأكرّر ذلك المشهد في عقلي
مرّات لا تُحصى في كلّ يوم

65
00:03:41,160 --> 00:03:45,160
أخيرا، اليوم، عشتُ ذلك الحلم من جديد

66
00:03:45,700 --> 00:03:47,040
هل ما قاله صحيح؟

67
00:03:47,160 --> 00:03:48,660
،أثناء الانتفاضة

68
00:03:48,660 --> 00:03:50,290
كان هناك اقتتالاً في كلّ يوم تقريباً

69
00:03:50,540 --> 00:03:52,080
كيف لي أن أتذكّر هزيمة بضعة
رجال عصابة؟

70
00:03:52,790 --> 00:03:56,290
لكن لم أتخيّل أن يُشكّل تصرّفٌ عفويّ
تأثيراً ضخماً كهذا على شابّ

71
00:03:56,450 --> 00:03:57,450
على ذكر الأمر، لهذا مغزى في نهاية المطاف

72
00:03:57,540 --> 00:04:00,700
رغم أنّني لا أعلم لماذا أصبحت
...ضعيفاً جدّاً الآن أيّها الملك لي

73
00:04:01,660 --> 00:04:02,450
قُل ذلك ثانية

74
00:04:02,700 --> 00:04:04,410
وسأدعك تتذوّق تلك اللّكمة مُجدّداً

75
00:04:04,410 --> 00:04:05,540
لا بُدّ أنّ لديك أسبابك

76
00:04:06,040 --> 00:04:06,540
لا تقلق

77
00:04:06,950 --> 00:04:08,040
سأتكتّم على هذا السرّ

78
00:04:08,290 --> 00:04:09,160
لن أخبر أحداً

79
00:04:09,330 --> 00:04:12,160
في الواقع، وجدتُ تعويذة تُدعى تقنيّة
صيد العقول في الكِتاب المُحرّم

80
00:04:12,410 --> 00:04:14,160
لذا اعتبرَني في قلبه آيدول

81
00:04:14,290 --> 00:04:15,410
وشعرَ بشغفٍ غير مُبرَّر تجاهي

82
00:04:16,080 --> 00:04:16,660
،بهذا

83
00:04:16,790 --> 00:04:20,290
أصبح جاسوساً مُوالياً في فريق
الأمن التّابع للحيّ 9

84
00:04:20,580 --> 00:04:22,540
أنت تكذب بشكل واضح

85
00:04:22,790 --> 00:04:23,410
تقنيّة صيد العقول؟

86
00:04:23,950 --> 00:04:25,160
لماذا لم يستخدمها عليّ؟

87
00:04:25,410 --> 00:04:27,200
لم أكن من أنصار حلّ المشاكل بالقوّة

88
00:04:27,540 --> 00:04:28,830
،إذا استطعنا أسر قلوب النّاس

89
00:04:29,080 --> 00:04:32,540
فيمكننا حينها ومن دون جهد يُذكر
تحقيق هدف إسقاط الملك المُستبدّ

90
00:04:33,910 --> 00:04:35,910
كنتُ أعتقد بأنّ هذا يحتاج تخطيطاً
طويل الأمد

91
00:04:36,410 --> 00:04:39,200
والآن بتقنيّة صيد العقول وسحرك
،الغير قابل للفهم

92
00:04:39,660 --> 00:04:42,660
لنأسر قلوبَ الجميع في هذه الدّولة

93
00:04:42,950 --> 00:04:44,330
،عندما يقف وحيداً تماماً

94
00:04:44,700 --> 00:04:47,330
فإنّ صيد رأسه سيكون مسألة وقت فقط

95
00:04:49,910 --> 00:04:52,040
أيّها الشّابّ، ما الّذي ما زلت تنتظره؟

96
00:04:52,330 --> 00:04:54,040
،لنسافر إلى كلّ أنحاء البلاد الواسعة

97
00:04:54,330 --> 00:04:58,160
في كلّ شارع وزقاق، لكسب قلوب
الرّجال والنّساء، الصّغار منهم والشّيوخ

98
00:04:58,660 --> 00:05:00,660
لا أعتقد بأنّ هدفه الحقيقيّ
هو إحياء البلد

99
00:05:00,790 --> 00:05:01,790
يريد فقط مُغازلة فتاة ما

100
00:05:02,160 --> 00:05:03,540
لكن تقنيّة صيد العقول لا يمكن
استخدامها إلّا على شخص واحد

101
00:05:05,910 --> 00:05:06,410
ماذا؟

102
00:05:06,540 --> 00:05:09,700
مثل هذه الفُرصة الثّمينة، وأهدرتها
على شخص ضعيف؟

103
00:05:10,290 --> 00:05:12,290
ياو، هل لديك خطّة أُخرى في بالك؟

104
00:05:12,410 --> 00:05:12,830
هذا صحيح

105
00:05:13,410 --> 00:05:15,040
حتّى لو استطعنا استخدام هذا
،الفنّ المُحرّم على الجميع

106
00:05:15,330 --> 00:05:17,540
لا يمكننا الاعتماد على سحر كهذا
للتحكّم بالنّاس للأبد

107
00:05:17,790 --> 00:05:19,540
يجب أن نكسب قلوبَهم الحقيقيّة
بعطف حقيقيّ

108
00:05:19,790 --> 00:05:20,790
(الخطّة ظاهريّا)
،قبل كلّ شيء، ما بين النّاس

109
00:05:20,950 --> 00:05:22,410
لماذا يمكن للثّقة والنّوايا الحسنة أن تنمو؟

110
00:05:22,830 --> 00:05:24,540
هذا لأنّك تستطيع كسب
،شيء من الشّخص الآخر

111
00:05:24,910 --> 00:05:26,700
سواء كان ماليّاً أو عاطفيّاً

112
00:05:27,290 --> 00:05:28,160
والآن لنُحلّل أكثر

113
00:05:28,540 --> 00:05:30,330
القيمة العاطفيّة هي أصعب
شيء يمكن توفيره

114
00:05:30,580 --> 00:05:31,580
يستغرق وقتاً لتنميته

115
00:05:31,950 --> 00:05:34,450
لكن المنافع من الثّروة هي الأسرع
والأكثر مُباشَرةً

116
00:05:34,790 --> 00:05:37,160
شراء الولاء بالمال. إنّه خدعة
شائعة للنّخبة ذوي النّفوذ

117
00:05:37,410 --> 00:05:39,040
،إذا أردنا إسقاط هذا المُستبدّ

118
00:05:39,200 --> 00:05:40,790
يجب علينا أن ننتهج تبادُل المصالح المُباشر

119
00:05:41,040 --> 00:05:43,330
لبناء قوّة مُخلصة لنا وتثق بنا

120
00:05:44,540 --> 00:05:45,660
لِمَ لا تجلس وتتكلّم؟

121
00:05:46,160 --> 00:05:47,910
بوقوفك طويلاً، أشعر بتيبُّس في الجسد

122
00:05:48,290 --> 00:05:49,910
لكن... أين يمكننا الحصول على المال؟

123
00:05:50,410 --> 00:05:52,790
الفنّ المُحرّم ليس لديه تعويذة
طبع عملة بالفعل

124
00:05:52,910 --> 00:05:54,160
لكن يمكنه توفير شيء أفضل من المال

125
00:05:54,540 --> 00:05:56,290
،في الأحياء الحاليّة، كلّما استُهلِكت

126
00:05:56,410 --> 00:05:57,160
ازدادت الموارد ندرة

127
00:05:57,450 --> 00:05:59,660
،قد يتمكّن الحيّ 9 من تدبُّر أمره
،لكن في الحيّ 10

128
00:05:59,790 --> 00:06:01,410
إنّهم يعانون تحت خطّ الفقر

129
00:06:01,790 --> 00:06:03,410
،النّاس هنا لا يملكون طعاماً كافياً حتّى

130
00:06:03,660 --> 00:06:04,910
ناهيك عن حاجتهم للمال

131
00:06:05,040 --> 00:06:08,290
أثناء حفظ الفنون المُحرّمة، صادفتُ
،هذه التّعويذة

132
00:06:16,040 --> 00:06:17,290
تقنيّة استحضار الطّعام

133
00:06:17,910 --> 00:06:19,160
يمكنها توفير بعض الخبز بالسّحر

134
00:06:19,410 --> 00:06:21,330
بهذا الشّكل، يمكنني بناء
قاعدة في الحيّ 10 أوّلاً

135
00:06:21,450 --> 00:06:22,450
،مع الضّغط الحاسوبيّ

136
00:06:34,040 --> 00:06:35,160
ساقايّ تخدّرتا بالفعل من الوقوف

137
00:06:36,910 --> 00:06:38,830
هل كنت تستمع لي أصلاً؟

138
00:06:39,160 --> 00:06:42,160
لِمَ تقوم بحركة غريبة كهذه
في هذه اللّحظة الحرجة؟

139
00:06:42,580 --> 00:06:43,910
ألم تقل بأنّك تستطيع استحضار الخبز؟

140
00:06:45,330 --> 00:06:46,290
!لقد ظهرَ في الواقع

141
00:06:48,790 --> 00:06:49,200
!عديم الجدوى

142
00:06:49,910 --> 00:06:51,790
كيف تسمح لفريق أساسيّ كهذا يفلت؟

143
00:06:52,040 --> 00:06:54,200
والآن لا يمكن إثبات موت رئيس
الطبّاخين بعد الآن

144
00:06:54,200 --> 00:06:55,790
رفاقي وأنا رأينا ذلك بشكل مُباشر

145
00:06:55,790 --> 00:06:56,660
أما زالت لديك الجرأة لنكران ذلك؟

146
00:06:57,040 --> 00:06:58,160
،عندما يأتي المسؤولون الكبار عن الأمر

147
00:06:58,290 --> 00:06:59,040
فإنّك ستتحمّل المسؤوليّة

148
00:06:59,040 --> 00:06:59,660
لا حاجة

149
00:06:59,790 --> 00:07:00,290
من؟

150
00:07:02,950 --> 00:07:03,790
سمعتُ كُلّ شيء

151
00:07:04,160 --> 00:07:05,830
كُفّ عن مُحاولة خداعي بعد الآن

152
00:07:06,410 --> 00:07:08,040
سيّد لونغ أو، الأمر ليس كما تعتقد

153
00:07:08,540 --> 00:07:10,290
كنتُ أحاول فحسب تحميل هذا
الفتى المسؤوليّة الكاملة

154
00:07:10,540 --> 00:07:12,580
سمعتُ بأنّ رئيس الطبّاخين كان
،يُسيئ استعمال منصبه

155
00:07:12,790 --> 00:07:14,910
ليجمع مقداراً كبيراً من المال
في المطبخ المركزيّ

156
00:07:15,290 --> 00:07:17,290
ثمّ قتلَ نفسه فجأة أمام الجميع

157
00:07:17,580 --> 00:07:19,040
مُدّعياً بأنّ ذلك نابع من تأنيب
الضّمير؟ لا أصدّق ذلك فحسب

158
00:07:19,330 --> 00:07:21,700
كيف لشخص ماكر جشِع كهذا
أن يجرؤ على قتل نفسه؟

159
00:07:22,160 --> 00:07:24,910
ألا تشعران بأنّ هناك ما هو مُريب؟

160
00:07:25,540 --> 00:07:27,580
سأمنحكما ثلاثة أيّام لاكتشاف الحقيقة

161
00:07:27,830 --> 00:07:30,660
خِلاف ذلك، يمكنكما الذّهاب وسؤال رئيس
الطبّاخين شخصيّاً في العالم السُّفليّ

162
00:07:32,290 --> 00:07:32,660
حاضر

163
00:07:33,040 --> 00:07:34,410
سنبذل قصارى جهدنا

164
00:07:35,410 --> 00:07:36,080
لا تتدافعوا

165
00:07:36,410 --> 00:07:37,910
هناك ما يكفي للجميع هنا. هناك الكثير

166
00:07:37,910 --> 00:07:38,660
!أريد بعضاً

167
00:07:40,160 --> 00:07:41,040
!أعطني كيساً من فضلك

168
00:07:41,540 --> 00:07:42,290
كنتُ هنا قبلاً

169
00:07:42,290 --> 00:07:42,910
شكراً لك -
كنتُ هنا قبلاً. أعطني -

170
00:07:43,540 --> 00:07:43,950
لا تستعجلوا

171
00:07:44,330 --> 00:07:45,450
اليوم، إنّها مُجرّد تجربة

172
00:07:45,790 --> 00:07:46,700
سيكون عرضاً يوميّاً من الآن فصاعداً

173
00:07:47,160 --> 00:07:48,410
لان، اذهبي وتفقّدي مياو

174
00:07:48,790 --> 00:07:49,910
الخبز هنا كاد ينفد

175
00:07:50,290 --> 00:07:51,450
شكراً جزيلاً

176
00:07:53,410 --> 00:07:55,290
مياو، يكاد الخبز ينفد لدينا. استحضره بسرعة

177
00:07:55,410 --> 00:07:56,790
لم أتوقّف عن ذلك أبداً

178
00:07:57,040 --> 00:08:00,330
تبّاً! ساقايّ ترتجفان من القرفصة
لفترة طويلة

179
00:08:01,790 --> 00:08:02,910
سآخذ هذه الآن-
حسناً-

180
00:08:03,450 --> 00:08:04,450
دعيني آخذ استراحة

181
00:08:07,660 --> 00:08:08,540
بعد الرّاحة، استمرّ في القرفصة حالاً

182
00:08:08,540 --> 00:08:09,560
عُلِم

183
00:08:11,950 --> 00:08:13,700
هذه الفتاة باردة جدّاً وقاسية

184
00:08:13,910 --> 00:08:14,410
لا تروقني

185
00:08:15,160 --> 00:08:16,450
انظروا من يتكلّم

186
00:08:16,700 --> 00:08:20,040
كان كلّ ذلك لأنّك قمت بحركة
خاطئة في التّوقيت الخاطئ

187
00:08:20,910 --> 00:08:22,290
ألم تقل بأنّ عليك استحضار بعض الخبز؟

188
00:08:23,290 --> 00:08:24,160
!ظهرَ بالفعل

189
00:08:24,830 --> 00:08:27,910
كما خطّطتُ في الأصل، سأجعل
تقنيّة استحضار الطّعام سريعة

190
00:08:28,040 --> 00:08:29,290
لا حاجة للمُعاناة هكذا

191
00:08:29,910 --> 00:08:30,330
مياو

192
00:08:30,540 --> 00:08:32,700
درستُ جميعَ من أتوا لأجل الخبز اليوم

193
00:08:32,830 --> 00:08:36,290
بهذه المعلومات، يمكن المُساهمة
في رسم سياسات مُستقبليّة لهم

194
00:08:36,410 --> 00:08:37,790
هذا نموذجيّ منكِ يا آنسة هوانغ

195
00:08:38,040 --> 00:08:39,330
عقل حريص كالعادة. هادئة وثابتة

196
00:08:39,450 --> 00:08:40,160
مُراعية للمشاعر وحنونة

197
00:08:40,790 --> 00:08:43,200
منذ البداية، تقتُ لإيجاد فتاة كهذه

198
00:08:43,790 --> 00:08:45,040
هل هذا هو شعور الحُبّ الأوّل؟

199
00:08:45,580 --> 00:08:46,330
الحُبّ الأوّل

200
00:08:46,660 --> 00:08:49,080
كملِك، لم تُواعد فتاة من قبل؟

201
00:08:49,290 --> 00:08:50,410
قِدر الفطر مُذهل؟

202
00:08:50,910 --> 00:08:51,790
هل هذا طبقٌ من نوع جديد؟

203
00:08:52,040 --> 00:08:52,410
!أنت

204
00:08:52,830 --> 00:08:54,830
هل ذلك الفتى الّذي يبيع خبزاً
رخيصاً هو شريكك؟

205
00:08:55,040 --> 00:08:56,040
من هذا السّافل هنا؟

206
00:08:56,410 --> 00:08:57,540
أتحاولين التّلاعب بالأسعار هنا؟

207
00:08:57,950 --> 00:08:59,330
سلسلة مخزون الطّعام في الحيّ 9

208
00:08:59,540 --> 00:09:01,160
يخضع لسيطرة السّيد ليانغ بشكل كامل

209
00:09:01,290 --> 00:09:03,200
المبيعات للحيّ 10 هي قرارنا كذلك

210
00:09:04,540 --> 00:09:05,700
هذا هو خبزهم

211
00:09:06,700 --> 00:09:09,040
سيّد ليانغ، إنّه أحد أبرز الأثرياء
في الحيّ 9

212
00:09:09,330 --> 00:09:10,580
لم أتوقّع أن يصلهم النّبأ بهذه السّرعة

213
00:09:10,700 --> 00:09:11,040
،لي

214
00:09:11,290 --> 00:09:12,290
لا تُقدِم على أيّ عمل طائش، من فضلك

215
00:09:13,660 --> 00:09:16,580
كيف تجرؤ على مسّ حُبّي الأوّل؟
هذه وقاحة

216
00:09:16,580 --> 00:09:18,660
إنّها لا تقصد بهذه الطّريقة. لا تتّخذ
الأمر بجدّية

217
00:09:20,700 --> 00:09:21,540
ما هذه الأشياء بالتّحديد؟

218
00:09:21,700 --> 00:09:22,290
مذاقها فظيع

219
00:09:22,410 --> 00:09:24,790
يبصق ذلك الوغد على وجه حُبّي الأوّل؟

220
00:09:25,160 --> 00:09:27,580
هذا أشبه بصبّ الكتشب على كنزتي
البيضاء النّقيّة خاصّتي

221
00:09:27,790 --> 00:09:29,410
لماذا أصبحت رسميّاً بإفراط فجأة؟

222
00:09:29,580 --> 00:09:30,660
تستخدم صورة مجازيّة الآن

223
00:09:32,790 --> 00:09:33,080
ماذا؟

224
00:09:33,660 --> 00:09:34,200
هل لديك مُشكلة؟

225
00:09:35,290 --> 00:09:37,290
اهدأ. حُبّي الأوّل حُلوة لكنّها مُرّة

226
00:09:37,410 --> 00:09:39,790
التقلُّبات المُفاجئة والعقبات ليست إلّا
حصى في طريق الحياة

227
00:09:40,040 --> 00:09:41,910
لا تدع رحلة العاطفة تُعرقلك هنا

228
00:09:42,160 --> 00:09:42,830
الحُبّ الأوّل؟

229
00:09:43,290 --> 00:09:44,660
لا تزال أعزب تعيساً؟

230
00:09:45,040 --> 00:09:47,040
رأيت؟ إنّه يُهينني من جديد

231
00:09:52,330 --> 00:09:52,580
!أنت

232
00:09:52,790 --> 00:09:54,660
!كيف تجرؤ على ادّعاء التقيُّؤ عليّ؟

233
00:09:55,160 --> 00:09:56,410
!جميعكم، اقبضوا عليه

234
00:09:56,540 --> 00:10:01,040
حُبّ البلد، حُبّ أكبر للجمال -
اتّخذ خطوة للخلف وانظر للصّورة الأشمل -

235
00:10:01,160 --> 00:10:03,200
سيغزو الحُبُّ الحقيقيّ الجميع

236
00:10:03,330 --> 00:10:05,290
!في العجلة النّدامة

237
00:10:14,580 --> 00:10:16,450
جدّي، ماذا تفعل هنا؟

238
00:10:16,450 --> 00:10:18,410
حفيدي العزيز، أنا من ينبغي
أن أسألك ذلك

239
00:10:18,580 --> 00:10:20,910
أنت صغير جدّاً. هل ارتكبتَ جرماً ما

240
00:10:21,160 --> 00:10:22,950
أدّى بك إلى انضمامك لي هنا سلفاً؟

241
00:10:23,160 --> 00:10:26,660
جدّتي، إنّي أراكِ أخيراً. اشتقتُ لكِ

242
00:10:26,660 --> 00:10:29,580
اشتقتُ لك أيضاً. أردتُ إعداد الفطائر لك

243
00:10:29,790 --> 00:10:30,540
والدة جدّي

244
00:10:30,910 --> 00:10:31,700
والد جدّي

245
00:10:32,290 --> 00:10:33,830
أنا عاقّ للوالدين، وما زلتُ أعزب

246
00:10:34,080 --> 00:10:35,830
ولم أمنحكما ابن حفيد

247
00:10:36,790 --> 00:10:38,540
!يا لها من وصمة عار

248
00:10:38,790 --> 00:10:39,450
لماذا؟

249
00:10:40,040 --> 00:10:43,540
،رأيتُ والد جدّي يُلوّح بيده
فانهمرت دموعي

250
00:10:51,580 --> 00:10:52,540
ما الّذي يجري؟

251
00:10:54,040 --> 00:10:55,160
،بالإضافة إلى استحضار الخبز

252
00:10:55,580 --> 00:10:56,660
يستطيع مياو الآن استحضار أُناس كذلك؟

253
00:11:01,080 --> 00:11:02,540
!تمالك نفسك

254
00:11:03,290 --> 00:11:04,910
مياو، ماذا تفعل؟

255
00:11:05,790 --> 00:11:06,950
والآن سأضع بعض القواعد الأساسيّة معك

256
00:11:07,410 --> 00:11:10,200
لا حركات طائشة من دون مُوافقتي

257
00:11:14,160 --> 00:11:16,290
سيّد ليانغ، لا أعرف ما السّحر
،الّذي استخدموه

258
00:11:16,410 --> 00:11:19,080
لكن في الواقع رأيتُ والدا جدّي
المُتوفّيين منذ زمن بعيد

259
00:11:20,580 --> 00:11:23,040
ألم يُخبروك بأنّك لن تنجو اللّيل بطوله؟

260
00:11:23,540 --> 00:11:24,160
!الرّحمة يا سيّد ليانغ

261
00:11:24,330 --> 00:11:25,410
!الرّحمة يا سيّد ليانغ، أرجوك

262
00:11:25,660 --> 00:11:27,790
أنا حقّاً لا أعرف من أين أتى
أولئك الأشخاص

263
00:11:28,040 --> 00:11:29,790
أيّ شخص يجرؤ على اعتراض
،طريقي في العمل

264
00:11:30,200 --> 00:11:33,620
!بشريّاً كان أو شبحاً، سأمتصّ دمَه حتّى يجفّ