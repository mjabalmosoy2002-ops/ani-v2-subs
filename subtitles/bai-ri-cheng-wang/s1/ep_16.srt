1
00:01:03,250 --> 00:01:07,290
أنتِ الفتاة الّتي تبنّاها كبير
السّحرة لي وان؟

2
00:01:07,750 --> 00:01:10,750
كان ينبغي أن نقضي عليك
تماماً في ذلك الوقت

3
00:01:16,620 --> 00:01:18,410
لقد أبدتُم عائلتي بالكامل

4
00:01:18,790 --> 00:01:20,160
ألم يكن ذلك كافياً؟

5
00:01:51,660 --> 00:01:56,000
سحر من دون قتال جسديّ
هو مُجرّد زيف

6
00:01:56,410 --> 00:01:57,870
عديم القيمة تماماً

7
00:03:14,370 --> 00:03:15,790
من... من أنت؟

8
00:03:16,750 --> 00:03:18,120
أين تحتجزون السّيّد ليانغ؟

9
00:03:18,540 --> 00:03:20,120
أخبرني... أخبرني

10
00:03:20,910 --> 00:03:24,540
كحارس، سأموت وأنا أحمي
أسرار رئيس الحيّ

11
00:03:32,250 --> 00:03:33,660
هل هدأت الآن؟

12
00:03:34,410 --> 00:03:35,660
هل يمكننا التكلُّم كما ينبغي؟

13
00:03:36,370 --> 00:03:39,120
أرجوك. إذا تكلّمت، فإنّ
...رئيس الحيّ سوف

14
00:03:42,250 --> 00:03:44,750
الأشخاص عديمو القيمة يثرثرون حقّاً

15
00:03:46,500 --> 00:03:49,750
أنت من يحيك الخطط مع ليانغ، صحيح؟

16
00:03:50,750 --> 00:03:52,660
،احتفظ بسرِّك حتّى النّهاية

17
00:03:53,120 --> 00:03:54,000
وقتلته بسبب ذلك

18
00:03:54,660 --> 00:03:56,870
لنبدأ بعقوبة صغيرة

19
00:04:03,120 --> 00:04:06,120
رأيتُك للتو تستخدم سحراً
على ذلك الحارس

20
00:04:06,540 --> 00:04:09,750
،لكن يؤسفني إفساد الأمر عليك
السّحر لا يفلح ضدّي

21
00:04:11,040 --> 00:04:14,500
أتعتقد بأنّني سمحتُ للسّحرة البقاء
في الحيّ 9 عن عبث؟

22
00:04:15,040 --> 00:04:18,290
لأنّني استخدمتُهم لتطوير جرعة
سحر خاصّة

23
00:04:18,750 --> 00:04:20,910
جرعة تقمع السّحر

24
00:04:21,500 --> 00:04:25,120
نفركها على الجلد فقط، لتُصبح
منيعاً تماماً ضدّ السّحر

25
00:04:25,750 --> 00:04:30,000
بالطّبع، هكذا اشتهرتُ بصيّاد السّحر

26
00:04:30,120 --> 00:04:32,620
واكتسبتُ جرعةَ رئيس الحيّ

27
00:04:33,500 --> 00:04:34,870
،لولا سحرك الّذي يدعمك

28
00:04:35,250 --> 00:04:36,870
أنت ضعيف تماماً

29
00:04:42,500 --> 00:04:44,120
إذاً ما رأيك أن تُحاول تلقّي
هذه اللّكمة؟

30
00:04:52,910 --> 00:04:53,750
هل كانت تلك أفضل مُحاولاتك؟

31
00:04:54,410 --> 00:04:55,250
،لم أكن أستخدم القوّة الكاملة

32
00:04:55,790 --> 00:04:58,250
لكن كان ينبغي لهذا أن
يُحدِث بعض الضّرر

33
00:04:58,620 --> 00:05:00,500
نسيتُ أن أُخبرك

34
00:05:01,000 --> 00:05:02,870
،بالإضافة إلى تعلُّم صدّ السّحر

35
00:05:03,370 --> 00:05:07,040
درستُ طُرُقاً لمُقاومة الضّرر الجسديّ

36
00:05:09,870 --> 00:05:15,500
السّحرة صنعوا جرعة السّحر
الخاصّة بالحاجز الدّفاعيّ هذه

37
00:05:16,410 --> 00:05:18,660
لا أُصدِّق بأنّني أهدرتُ وقتاً طويلاً عليه

38
00:05:51,910 --> 00:05:53,040
بقي اثنتان فقط

39
00:05:53,910 --> 00:05:56,120
حال نفادهما، كيف ستُقاتلينني؟

40
00:06:47,500 --> 00:06:48,870
...هذا الحاجز... هل يُعقَل

41
00:06:49,290 --> 00:06:50,500
فهمتُ الآن

42
00:06:51,250 --> 00:06:53,750
صانِعا الجرعة السّحريّة هما والداكِ؟

43
00:06:54,250 --> 00:06:54,750
بسرعة

44
00:06:55,160 --> 00:06:56,370
اصنعا جرعة السّحر حالاً

45
00:06:57,120 --> 00:06:59,000
وإلّا فلن تريا ابنتكما ثانية

46
00:07:00,870 --> 00:07:04,370
عفونا عن حياتكِ لأجل خدمة
والديكِ الفاضلة

47
00:07:04,870 --> 00:07:08,410
.لكن رعاية نمر يستدعي كارثة
أنتِ تقودين النّاس للثّوران ضدّنا

48
00:07:13,870 --> 00:07:16,000
لان. لا تخافي. نحن معكِ

49
00:07:17,790 --> 00:07:21,750
كُلّ السّحر الّذي علّمناكِ إيّاه يحميكِ

50
00:07:28,410 --> 00:07:29,870
ماذا يجدر بي أن أفعل الآن؟

51
00:07:30,540 --> 00:07:32,370
أتتذكّرين تلك التّعويذة الطّويلة؟

52
00:07:32,910 --> 00:07:33,660
أجل

53
00:07:34,370 --> 00:07:36,500
نور فجر الفوضى البدائيّة

54
00:07:37,000 --> 00:07:38,540
أشرقَ عند نهوض الفوضى أوّل مرّة

55
00:07:39,540 --> 00:07:41,370
لبِّ ندائي. استجب لرجائي

56
00:07:41,910 --> 00:07:43,500
اعبر الفراغ من العالم الرّوحانيّ

57
00:08:17,120 --> 00:08:18,870
سأعزِّز القوّة وضربة واحدة ستَفي بالغرض

58
00:08:21,870 --> 00:08:24,250
لا يستطيع تدريبي مُجاراة قوّتك

59
00:08:24,750 --> 00:08:27,000
لكمة واحدة منّي قد تضرّني
بقدر ما تضرّ العدوّ

60
00:08:27,870 --> 00:08:31,410
إذا هزمتُك، أستطيع السّيطرة
على الحيّ 10 أيضاً

61
00:08:31,910 --> 00:08:33,000
ينبغي أن تكون هناك طريقة أُخرى

62
00:08:33,500 --> 00:08:35,250
ذلك السّيف القدسيّ ذو قوّة التّطهير

63
00:08:35,870 --> 00:08:37,540
يحتوي نصله على كلمات مُقدّسة قديمة

64
00:08:37,660 --> 00:08:38,600
فهمت

65
00:08:41,790 --> 00:08:43,870
أنت سوف... تمنحه انصهار السّحر

66
00:08:48,500 --> 00:08:49,250
!تألّق

67
00:08:50,250 --> 00:08:51,500
،انصهار السّهر

68
00:08:51,750 --> 00:08:53,540
النّسخة المُزدوجة الخارقة

69
00:08:53,620 --> 00:08:55,660
بريق الحُبّ والأمل

70
00:08:58,540 --> 00:09:00,370
حتّى القبضات لا تستطيع كسر حاجزي

71
00:09:00,750 --> 00:09:02,410
وتعتقد بأنّ إصبعيك يمكنهما فعل ذلك؟

72
00:09:02,620 --> 00:09:04,540
غرس إبرة. ستكون كافية

73
00:09:12,000 --> 00:09:12,620
ماذا؟

74
00:09:17,500 --> 00:09:19,620
!أتجرئين على خدش وجهي؟

75
00:09:20,290 --> 00:09:21,660
اقلق على وجهك لاحقاً

76
00:09:21,750 --> 00:09:23,250
أوّلاً، اقلق على حياتك

77
00:09:36,620 --> 00:09:39,750
والآن، هل أنت جاهز لمعركة حقيقيّة؟

78
00:09:59,870 --> 00:10:03,290
،كرئيس حيّ، خرقتَ القانون

79
00:10:04,370 --> 00:10:07,250
بتخمير الكثير من جرعات التّعويذ سرّاً

80
00:10:07,620 --> 00:10:09,750
لم أكن أعلم بأنّ انصهار السّحر
يمكن استعماله هكذا

81
00:10:10,160 --> 00:10:10,500
هنا

82
00:10:13,120 --> 00:10:14,370
لان، هل أنتِ بخير؟

83
00:10:15,870 --> 00:10:17,910
كيف جرت الأمور؟

84
00:10:18,250 --> 00:10:19,870
تمّ التخلُّص من ذلك المُزعج

85
00:10:31,250 --> 00:10:32,250
لنبحث عن السّيّد ليانغ بسرعة

86
00:10:33,910 --> 00:10:34,790
يبدو أنّ هذا هو المكان

87
00:10:35,160 --> 00:10:36,160
أين رئيس الحيّ؟

88
00:10:37,120 --> 00:10:38,000
لا تقلقوا جميعاً

89
00:10:38,120 --> 00:10:39,250
رئيس الحيّ 9 قد رحل

90
00:10:39,660 --> 00:10:42,790
لنجعل الحيّين 9 و 10 يزدهران معاً

91
00:10:43,040 --> 00:10:44,120
لا أريد مزيداً من المتاعب-
لحظة-

92
00:10:44,870 --> 00:10:45,910
بالمُناسبة، أين السّيّد ليانغ؟

93
00:10:46,660 --> 00:10:48,370
...سيّد ليانغ، إنّه

94
00:10:49,250 --> 00:10:51,160
نزفَ حتّى الموت