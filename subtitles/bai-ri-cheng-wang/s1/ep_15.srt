1
00:00:41,910 --> 00:00:44,580
(مُتوّج بعد مئة يوم)

2
00:00:44,580 --> 00:00:46,580
.كافّة العناصر خياليّة
.لا تُحاول التّقليد

3
00:00:57,500 --> 00:00:58,750
!انهضي، انهضي

4
00:00:58,750 --> 00:01:00,040
!استيقظي

5
00:01:00,040 --> 00:01:02,370
الضّيوف جميعهم ينتظرون-
!مُزعج-

6
00:01:02,620 --> 00:01:05,040
قال أبي في الأمس بأنّ اليوم إجازة

7
00:01:05,160 --> 00:01:06,250
لا يمكنك خداعي

8
00:01:07,370 --> 00:01:08,500
من يخدعكِ؟

9
00:01:10,040 --> 00:01:11,750
أنت. كيف دخلت؟

10
00:01:12,410 --> 00:01:13,500
هذه أرضي

11
00:01:13,870 --> 00:01:15,750
من الطبيعيّ أن آتي وأذهب متى شئت

12
00:01:17,750 --> 00:01:18,910
اخرج-
لا تخافي-

13
00:01:19,160 --> 00:01:20,870
سأفي بوعدي لكِ

14
00:01:21,410 --> 00:01:24,000
لن أمسّكِ قبل أن نتزوّج

15
00:01:24,370 --> 00:01:26,540
لذا، أتيتُ للاطمئنان عليكِ فحسب

16
00:01:27,120 --> 00:01:28,250
لأرى ما إن نمتِ جيّداً

17
00:01:29,120 --> 00:01:30,750
ربّما حان وقت تغيير الشّراشف

18
00:01:33,000 --> 00:01:34,790
يا لها من رائحة عطِرة

19
00:01:35,790 --> 00:01:38,000
!قلتُ اخرج

20
00:01:42,000 --> 00:01:43,250
اذهبي واغتسلي وتجهّزي

21
00:01:43,790 --> 00:01:45,000
سيجهز الفطور هنا قريباً

22
00:01:46,620 --> 00:01:47,120
الملك لي

23
00:01:49,120 --> 00:01:50,250
متى وصلت إلى هنا؟

24
00:01:51,000 --> 00:01:52,290
سمعت كُلّ شيء قلناه؟

25
00:01:52,870 --> 00:01:54,160
ألم تطلب منّي المجيء؟

26
00:01:54,410 --> 00:01:55,120
...بلى

27
00:01:55,870 --> 00:01:58,410
في الواقع... أرسلتُ لونغ أو
،إلى الحيّ 9

28
00:01:58,910 --> 00:02:00,750
لكن ما زال لم يبلغني بشيء بعد

29
00:02:01,410 --> 00:02:02,250
بدأتُ أقلق

30
00:02:03,500 --> 00:02:04,250
تعرف طبعه

31
00:02:04,750 --> 00:02:06,500
يريد أن يرتقي أكثر منكم أنتم الثّمانية

32
00:02:07,000 --> 00:02:12,540
إذا وجد طريقةً لقلب الموازين، فأنت
قد ينتهي المطاف بسقوطك

33
00:02:14,620 --> 00:02:15,750
تصنيف الفتى ثمانية في نهاية المطاف

34
00:02:16,290 --> 00:02:19,000
هذا مُناسب جدّاً. سأسمّيكم بقادة
النّمور الثّمانية

35
00:02:19,540 --> 00:02:20,500
ألا يبدو هذا رائعاً؟

36
00:02:21,000 --> 00:02:21,870
النّمر الأوّل، الحاكم المُطلَق

37
00:02:22,000 --> 00:02:22,910
النّمر الثّاني، المُهلِك

38
00:02:23,120 --> 00:02:24,870
،النّمر الثّالث، راكب البحر، النّمر الرّابع
شاحن الرّعد

39
00:02:25,040 --> 00:02:27,040
.النّمر الخامس، حارس الجبل
النّمر السّادس، جامع النّجوم

40
00:02:27,120 --> 00:02:29,000
،النّمر السّابع، مُحلّق السّماء
والنّمر الثّامن، السّبّاح التنّين

41
00:02:29,660 --> 00:02:30,250
مثاليّ

42
00:02:31,410 --> 00:02:33,500
تشين تيان، بما أنت شارد؟ تابع

43
00:02:34,370 --> 00:02:38,290
يبدو أنّه في هذه الحياة، أستطيع
أخيراً صنع اسم لنفسي

44
00:02:43,870 --> 00:02:47,120
في حياتي السّابقة، كنتُ أمتلك كافّة المهارات

45
00:02:48,370 --> 00:02:50,500
لكن انتهى الأمر بي بعدم امتلاك شيء

46
00:02:55,290 --> 00:02:57,000
قبل أن أموت، ظللتُ أُصلِّي

47
00:02:58,370 --> 00:03:00,370
أُصلِّي لفُرصة ثانية في الحياة

48
00:03:09,910 --> 00:03:13,870
يبدو أنّ السّماوات استجابت لأُمنيتي

49
00:03:14,620 --> 00:03:15,290
،لذا

50
00:03:16,040 --> 00:03:17,750
يجب أن أُطلق عناني

51
00:03:23,540 --> 00:03:25,120
!تعالوا حالاً ولا تُفوّتوا هذا

52
00:03:25,370 --> 00:03:26,870
انصهار واحد يغيّر كُلّ شيء

53
00:03:27,120 --> 00:03:28,370
رئيس الحيّ مُعلّمكم شخصيّاً

54
00:03:28,500 --> 00:03:30,540
استخدام السّحر لإخراج الحيّ 10 من المأزق

55
00:03:30,660 --> 00:03:32,500
لا، شكراً. لنذهب بسرعة

56
00:03:32,660 --> 00:03:34,250
!هذا ليس انصهاراً. هذه حقنة شرجيّة

57
00:03:36,660 --> 00:03:37,370
،صديقي

58
00:03:37,620 --> 00:03:39,370
أرى بأنّك موهوب ورصين

59
00:03:39,500 --> 00:03:41,000
لا بُدّ أنّك ركن من أركان حيّنا

60
00:03:41,120 --> 00:03:42,500
لستُ جديراً على الإطلاق

61
00:03:42,660 --> 00:03:44,120
أنا مُجرّد مُنظِّف مراحيض

62
00:03:44,620 --> 00:03:45,910
!تنظيف المراحيض رائع

63
00:03:46,160 --> 00:03:47,870
كما يُقال، تدفُّق مُستمرّ

64
00:03:48,120 --> 00:03:50,500
هذا يصِف عبقريّاً نادراً مثلك

65
00:03:50,790 --> 00:03:52,160
كُفّي عن مُجاملتي

66
00:03:52,290 --> 00:03:54,370
،لستُ عبقريّاً نادراً. وإذا أخذتِني

67
00:03:54,620 --> 00:03:55,790
فسوف تنقرض سُلالتنا

68
00:03:56,120 --> 00:03:58,750
ماذا تقول؟ من الّذي تلعنه؟

69
00:03:59,040 --> 00:04:00,500
تبّاً، كما توقّعتُ فحسب

70
00:04:00,620 --> 00:04:02,120
!يا للهول

71
00:04:02,540 --> 00:04:03,370
مهلاً لحظة

72
00:04:04,790 --> 00:04:06,500
آسف، لم يكن الأمر بيدي

73
00:04:07,870 --> 00:04:09,040
هذه ليست غلطتك بالطّبع

74
00:04:09,040 --> 00:04:11,000
من كان يعلم بأنّ انصهار السّهر
لديه آثار جانبيّة كهذه؟

75
00:04:11,000 --> 00:04:12,870
أفلتني! لن أذهب

76
00:04:13,120 --> 00:04:15,620
!هذا احتيال! أنت تختطفني

77
00:04:16,250 --> 00:04:18,120
وعدتُم بجائزة كُبرى بعد ثلاث إجابات صحيحة

78
00:04:18,370 --> 00:04:20,620
أهذه عمليّة نصب وقحة؟

79
00:04:24,370 --> 00:04:25,870
المال مُجرّد سلعة دنيويّة

80
00:04:26,500 --> 00:04:27,540
ما نعطيك إيّاه الآن

81
00:04:27,660 --> 00:04:29,620
هو شيء جيّد، مُنصهر في جسدك للأبد

82
00:04:30,250 --> 00:04:32,000
أليس هذا مُفاجئاً؟

83
00:04:35,160 --> 00:04:37,870
!لا أريدكم أن تدمجوا شيئاً غريباً في داخلي

84
00:04:38,370 --> 00:04:41,500
!دعني أذهب! انسَ الجائزة الكُبرى

85
00:04:42,160 --> 00:04:44,370
!لا! النّجدة

86
00:04:44,540 --> 00:04:47,000
أريد العودة إلى المنزل

87
00:04:47,120 --> 00:04:48,370
تمّ صَهر الكثير دُفعة واحدة

88
00:04:48,750 --> 00:04:49,620
أشعر بخدر في أصابعي

89
00:04:49,750 --> 00:04:50,790
هذا ليس مؤلماً إلى ذلك الحدّ، صحيح؟

90
00:04:51,750 --> 00:04:52,870
هيّا، اتبعني من هنا

91
00:04:56,370 --> 00:04:57,120
واحد آخر

92
00:04:57,370 --> 00:04:58,500
إنّهم لا يمنحوننا راحة حتّى

93
00:04:58,870 --> 00:04:59,410
سأذهب إذاً

94
00:05:00,000 --> 00:05:00,500
انسَ الأمر

95
00:05:00,870 --> 00:05:01,910
الوقت قصير، والعمل كثير

96
00:05:02,160 --> 00:05:03,040
سندمج أكبر عدد مُمكن

97
00:05:04,500 --> 00:05:07,000
تغيّر الجميع كثيراً بعد كسب السّحر

98
00:05:07,540 --> 00:05:09,500
انظر. إنّهم يتمرّنون على السّحر

99
00:05:09,660 --> 00:05:10,620
إنّهم مُستمتعون، صحيح؟

100
00:05:11,370 --> 00:05:12,620
رحّبوا بالتّلميذ الجديد

101
00:05:14,750 --> 00:05:17,870
!مرحباً! مرحباً بك بحرارة

102
00:05:17,870 --> 00:05:19,620
مرحباً جميعاً-
التّغيير هائل-

103
00:05:24,910 --> 00:05:25,370
حسناً

104
00:05:25,540 --> 00:05:26,620
تهانينا التغلُّب على نفسك

105
00:05:26,660 --> 00:05:28,120
أهذا مُناسب حقّاً؟

106
00:05:29,160 --> 00:05:31,540
أعلم. المُهمّ أنّ النّتيجة تروقهم

107
00:05:31,910 --> 00:05:33,040
يخشون العمليّة فحسب

108
00:05:33,620 --> 00:05:36,500
لذا أحياناً، التّحفيز البسيط ضروريّ

109
00:05:36,750 --> 00:05:40,910
بالمناسبة، ذلك الرّجل الّذي ذهب إلى الحيّ 9
بداعي العمل لم يعُد بعد

110
00:05:41,120 --> 00:05:42,870
صحيح. لا نبأ عنه طوال اليوم

111
00:05:43,500 --> 00:05:44,370
هل واجه مُشكلة؟

112
00:05:47,290 --> 00:05:50,540
ذلك المهووس بالمال، لم أثق به البتّة

113
00:05:52,120 --> 00:05:53,250
،منذ مجيئه إليك من تلقاء نفسه

114
00:05:53,790 --> 00:05:57,870
،بالإضافة إلى سلوكه الغريب
كان كلّ ذلك جزءاً من خطّته غالباً

115
00:05:59,120 --> 00:06:00,870
التّخمين بشكل عشوائيّ لن ينفع

116
00:06:01,160 --> 00:06:02,250
لنتفقّد في الحيّ 9

117
00:06:03,040 --> 00:06:04,500
هذا كبير السّحرة لي وان

118
00:06:04,750 --> 00:06:06,000
إنّه مُعلِّمي في السّحر أيضاً

119
00:06:06,910 --> 00:06:11,500
مرحباً جميعاً. سوف أدرّسكم تعويذات
أكثر تقدُّماً من الآن فصاعداً

120
00:06:11,910 --> 00:06:12,370
في الوقت المثاليّ

121
00:06:17,160 --> 00:06:18,910
سأترك هذا المكان لك يا كبير
السّحرة لي وان

122
00:06:21,120 --> 00:06:23,750
إنّه يستخدم عذر العمل الرّسميّ لمُواعدتي؟

123
00:06:25,370 --> 00:06:26,120
غريب

124
00:06:26,870 --> 00:06:28,370
لماذا الشّارع فارغ تماماً؟

125
00:06:28,620 --> 00:06:30,160
هل يُعقَل أنّه يخطِّط لمُفاجأة؟

126
00:06:30,370 --> 00:06:32,910
ألهذا السّبب يدّعي الجهل
ويتكلّم مع نفسه فحسب؟

127
00:06:33,750 --> 00:06:34,290
هذا سخيف جدّاً

128
00:06:35,870 --> 00:06:36,370
حسناً

129
00:06:36,790 --> 00:06:37,870
سوف أُسايره إذاً

130
00:06:39,620 --> 00:06:41,370
أجل، غريب جدّاً، أليس كذلك؟

131
00:06:44,370 --> 00:06:45,370
لم تلحظي حقّاً؟

132
00:06:45,870 --> 00:06:48,250
أعلم بالطّبع أنّ شخصاً يُراقبنا

133
00:06:50,540 --> 00:06:52,660
بطل ينقذ الجمال. يا لها
من حبكة مُبتذلة

134
00:06:57,290 --> 00:06:58,500
يستطيع أن يصبح خفيّاً إذاً

135
00:07:35,160 --> 00:07:35,620
شياومينغ

136
00:07:57,790 --> 00:08:00,120
لحماية لان، حركاتك محدودة

137
00:08:00,910 --> 00:08:02,120
أعلم بالطّبع

138
00:08:04,120 --> 00:08:05,250
إذاً ما رأيك بهذه؟

139
00:08:25,870 --> 00:08:26,910
إنّه مُنغمس في هذا حقّاً

140
00:08:28,620 --> 00:08:30,870
هذا مُبتذل جدّاً، لكن لا بُدّ أن أسأل

141
00:08:31,750 --> 00:08:34,250
أخبراني، من أرسلكما؟

142
00:08:34,660 --> 00:08:37,500
إنّها... أوامر رئيس الحيّ

143
00:08:38,540 --> 00:08:42,290
تقصد رئيس الحيّ 9؟

144
00:08:43,370 --> 00:08:45,120
رئيس الحيّ، كنّا مُخطئين

145
00:08:45,410 --> 00:08:47,370
!اعفُ عنّا أرجوك

146
00:08:48,500 --> 00:08:49,870
لم نقصد مُمارسة التّجارة معه

147
00:08:50,120 --> 00:08:52,620
هو من تقرّب منّا من تلقاء نفسه-
سيّد ليانغ-

148
00:08:53,000 --> 00:08:55,370
أنت تُدير عملاً مُزدهراً في الحيّ 9

149
00:08:55,620 --> 00:08:57,290
ألم أعاملك مُعاملة حسنة دوماً؟

150
00:08:58,120 --> 00:09:01,000
لمَ تنقلب ضدّي وتعضّ اليد
الّتي مُدّت لك؟

151
00:09:01,750 --> 00:09:03,120
لِمَ برأيك؟

152
00:09:03,750 --> 00:09:05,250
لأجل المال بالطّبع

153
00:09:05,750 --> 00:09:08,500
أتعتقد بأنّه يمكن خداعي بسهولة؟

154
00:09:08,870 --> 00:09:11,120
من لا يعرف الوضع في الحيّ 10؟

155
00:09:11,370 --> 00:09:13,000
أتتخلّى عن الخيرات في الحيّ 9

156
00:09:13,000 --> 00:09:15,000
وتذهب لتطوير أرض مُقفَرة معزولة؟

157
00:09:15,290 --> 00:09:16,540
تقول لأجل المال فقط

158
00:09:16,750 --> 00:09:18,160
كيف لي أن أُصدِّق هذا؟

159
00:09:19,370 --> 00:09:20,370
بالطّبع

160
00:09:21,000 --> 00:09:23,120
بعد كلّ ذلك الاستجواب، لم أتوصّل
إلى الحقيقة بعد

161
00:09:23,250 --> 00:09:25,620
سئمتُ من إضاعة الوقت معك-
!أطلق سراحي إذاً-

162
00:09:31,540 --> 00:09:35,000
قبل أن ينفد دمك، سأمنحك وقتاً
للتّفكير في الأمر

163
00:09:35,370 --> 00:09:37,620
هل ستستمرّ في العمل معي أم لا؟

164
00:09:44,000 --> 00:09:44,500
!توقّفا

165
00:09:44,910 --> 00:09:46,410
هذه منطقة محظورة تابعة لحكومة
!الحيّ. ابتعدوا

166
00:09:50,290 --> 00:09:51,160
أتسمعانني؟

167
00:09:57,750 --> 00:09:59,120
لماذا لمست مؤخّرتي؟

168
00:10:00,160 --> 00:10:01,500
...أنا-
لم أكن أنا-

169
00:10:01,870 --> 00:10:02,790
ولِمَ ألمس مُؤخّرتك؟

170
00:10:06,540 --> 00:10:09,120
قبضتُ على مُتواطئ يُنقذ شخصاً

171
00:10:10,870 --> 00:10:11,870
عظيم

172
00:10:12,120 --> 00:10:14,620
سأقيّدك وأُسلّمك للرّئيس

173
00:10:15,540 --> 00:10:17,410
أنت من لعقَ مؤخّرتي إذاً

174
00:10:17,790 --> 00:10:18,620
لم تكن لمسة

175
00:10:18,620 --> 00:10:21,160
كفى كلاماً. تعال معي

176
00:10:25,620 --> 00:10:26,870
!يا للهول! زلِق جدّاً

177
00:10:27,120 --> 00:10:28,660
!تذوّق لساني

178
00:10:35,500 --> 00:10:37,160
لان، أيّ نوع من السّحر و هذا؟

179
00:10:37,660 --> 00:10:39,620
اذهب وأنقذهم. سأتعامل معهم

180
00:10:40,620 --> 00:10:43,410
أكثر من كرهتُهم في حياتي
هم الحمقى

181
00:10:50,950 --> 00:10:52,700
‏86 يوم