1
00:00:41,910 --> 00:00:44,580
(مُتوّج بعد مئة يوم)

2
00:00:44,580 --> 00:00:46,580
.كافّة العناصر خياليّة .لا تُحاول التّقليد

3
00:00:47,790 --> 00:00:48,160
مينغ

4
00:00:49,040 --> 00:00:49,700
شياومينغ

5
00:00:50,660 --> 00:00:51,330
شياومينغ

6
00:00:52,450 --> 00:00:53,080
شياومينغ

7
00:01:01,790 --> 00:01:02,580
وانغ شياومينغ

8
00:01:06,410 --> 00:01:07,950
يبدو أنّني ضغطتُ عليك كثيراً

9
00:01:08,580 --> 00:01:10,540
أعتقد لم نكن مُتقاربين كما توقّعت

10
00:01:10,950 --> 00:01:12,160
لـ-لا، الأمر ليس كذلك

11
00:01:14,700 --> 00:01:18,160
شياوهونغ، لم أنسَ وعدي لكِ أبداً

12
00:01:18,950 --> 00:01:21,910
أتمنّى أن نستطيع دوماً تأمُّل
الزُّهور وغروب الشّمس هكذا معاً

13
00:01:22,540 --> 00:01:23,950
ونُدير المتجر مع أمِّي وعمّي

14
00:01:24,830 --> 00:01:26,540
سأعدّ لكِ تحليةً جديدة كُلّ أسبوع

15
00:01:27,080 --> 00:01:28,080
هانئون وسُعداء دوماً

16
00:01:31,450 --> 00:01:32,660
ألا نفعل ذلك الآن؟

17
00:01:34,700 --> 00:01:35,910
لكن هناك أشخاص ينتظرونني

18
00:01:38,830 --> 00:01:40,910
هل أولئك الأشخاص أهمّ منّي؟

19
00:01:42,950 --> 00:01:44,410
إنّهم أشخاص عشتُ المُرَّ معهم

20
00:01:45,200 --> 00:01:46,660
خاطروا بأرواحهم معي

21
00:01:46,910 --> 00:01:47,910
للقتال لأجل مُستقبل معاً

22
00:01:48,790 --> 00:01:52,660
فقط عندما نُنجز هذا الهدف، سأكون جديراً
فعلاً بأن أكون صهر عمّي

23
00:01:53,330 --> 00:01:54,080
وأبقى معكِ

24
00:01:55,660 --> 00:01:57,410
شكراً لكِ، يا هونغ

25
00:01:59,660 --> 00:02:02,410
أنت... عنيدٌ حقّاً

26
00:02:21,290 --> 00:02:24,580
التّفكير بالوعد الّذي قطعناه
أخرجَني من حلم جميل

27
00:02:25,660 --> 00:02:28,410
الانتفاضة الّتي بدأتُها تُكلّف
الكثير من أرواح الأبرياء

28
00:02:29,290 --> 00:02:30,410
هل تعتقد بأنّ الأمر كان جديراً؟

29
00:02:32,160 --> 00:02:35,660
كان جديراً. فقد أسقطتَ
النّظامَ الطّبقيّ البالي

30
00:02:36,410 --> 00:02:37,950
لا تزال بطلاً في عينَي

31
00:02:38,660 --> 00:02:40,660
كُلّ موت يُرافقه وِلادة جديدة

32
00:02:41,290 --> 00:02:42,540
الموت بحدِّ ذاته ليس خطأ

33
00:02:43,290 --> 00:02:44,910
الخطأ هو نسيان سبب قتالنا

34
00:02:46,080 --> 00:02:48,410
وهذه المرّة، سأكون بجانبك

35
00:02:49,410 --> 00:02:52,660
سأقف معك لحماية كُلّ حياة تستحقُّ الإنقاذ

36
00:03:11,950 --> 00:03:14,910
حان الوقت... للردّ

37
00:03:24,830 --> 00:03:25,660
هذا مُستحيل

38
00:03:27,830 --> 00:03:30,040
رِفاق، لقد تأخّرت

39
00:03:32,790 --> 00:03:33,450
إنّه مياو

40
00:03:34,080 --> 00:03:35,410
هل كان مختوماً عليه من قبل؟

41
00:03:40,410 --> 00:03:41,700
كيف للونغ أو أن يكون هنا؟

42
00:03:42,290 --> 00:03:43,160
ما الّذي يجري؟

43
00:03:43,910 --> 00:03:44,790
لنُنقذهم أوّلاً، ثمّ سنتكلّم

44
00:03:45,830 --> 00:03:47,450
حطّمتَ سحر غو الخاصّ بي

45
00:03:48,040 --> 00:03:49,950
أنت هو العقل المُدبِّر إذاً

46
00:04:07,410 --> 00:04:09,160
السّحر عالي المُستوى الفوريّ

47
00:04:09,660 --> 00:04:11,290
هذه قوّة لا يملكها سوى الكاهن الأعلى

48
00:04:11,410 --> 00:04:12,160
...كيف يستطيع

49
00:04:14,200 --> 00:04:14,790
هل أنتم بخير؟

50
00:04:15,830 --> 00:04:16,950
لونغ أو حمانا

51
00:04:17,950 --> 00:04:19,040
كان يتنكّر تحت غطاء رجل ثريّ

52
00:04:19,410 --> 00:04:20,580
كان خفيّاً طوال هذه المدّة

53
00:04:24,790 --> 00:04:26,540
هذا أكثر تعقيداً ممّا توقّعت

54
00:04:27,410 --> 00:04:28,410
سنتكلّم لاحقاً

55
00:04:28,830 --> 00:04:29,830
أوّلاً، أوصلوه إلى مكانٍ آمن

56
00:04:30,790 --> 00:04:32,290
خيوط الدّم الّتي يتحكّم بها حادّة للغاية

57
00:04:32,540 --> 00:04:33,290
هذا مُعقّدٌ حقّاً

58
00:04:34,160 --> 00:04:36,040
مياو، ما زلتُ أستطيع دعمك بالشِّفاء

59
00:04:36,700 --> 00:04:38,200
أصبح شعرها أبيض تماماً

60
00:04:39,160 --> 00:04:39,700
...هل يُعقَل أنّ

61
00:04:43,330 --> 00:04:45,950
مضى وقتٌ منذ واجهتُ خصماً جديراً

62
00:04:47,080 --> 00:04:48,700
آنسة هوانغ، استريحي لبعض الوقت

63
00:04:49,200 --> 00:04:50,540
دعي الباقي لي

64
00:04:53,700 --> 00:04:54,950
كان تابعك في السّابق

65
00:04:55,410 --> 00:04:56,540
لا تتساهل معه

66
00:04:57,330 --> 00:04:59,660
لستَ بحاجة لقول ذلك. سأطبِّق العدالة

67
00:05:07,040 --> 00:05:08,540
لم أرَه يستخدم هذه التقنيّة من قبل

68
00:05:09,080 --> 00:05:10,040
الاختباء لن يحلّ شيئاً

69
00:05:10,450 --> 00:05:14,160
توقّعت. أنت مُجرّد ريفيّ وضيع بمهارات هُواة

70
00:05:16,540 --> 00:05:18,540
استولِ على الجسد. أكسِبني بعض الوقت

71
00:05:18,910 --> 00:05:20,660
سأجد حلّاً في الكِتاب المُحرَّم-
حسناً-

72
00:05:21,080 --> 00:05:22,540
لن تحظى بفُرصة

73
00:05:22,910 --> 00:05:25,410
ستصبح جثّة هامدة

74
00:05:31,290 --> 00:05:32,040
التّقشير الدّقيق

75
00:05:32,410 --> 00:05:33,160
الإذابة المُستديمة-
مياو-

76
00:05:33,700 --> 00:05:34,450
إعادة القولبة الانسيابيّة النّاعمة

77
00:05:34,790 --> 00:05:35,540
لفّ أمواج القمح

78
00:05:36,160 --> 00:05:37,040
شلّال الألف خيط

79
00:05:37,450 --> 00:05:41,410
دفء رقيق بين الأصابع. معكرونة
لانزو المشدودة باليد

80
00:05:41,660 --> 00:05:42,290
الشّكل الأوّل

81
00:05:43,540 --> 00:05:44,410
إيقاظ العجينة

82
00:05:47,540 --> 00:05:48,330
أيُعقَل هذا؟

83
00:05:48,540 --> 00:05:50,410
هذا فنٌّ سرّيٌ درستُه لزمنٍ طويل

84
00:05:52,160 --> 00:05:53,410
خيوط دمويّة إلى أنصال

85
00:05:56,540 --> 00:05:57,410
معكرونة لانزو المشدودة باليد

86
00:05:57,580 --> 00:05:58,290
الشّكل الثّاني

87
00:05:58,790 --> 00:05:59,410
تدليك العجينة

88
00:06:05,410 --> 00:06:10,040
كيف لشخص يمتلك سحراً قويّاً
ومهارات قتاليّة كهذه؟

89
00:06:11,330 --> 00:06:13,790
لا. لا يمكن أن أخسر

90
00:06:14,700 --> 00:06:17,040
أنا الأكثر موهبة

91
00:06:21,200 --> 00:06:22,330
هذا النّحت الخشبيّ هو نسخةٌ طبق الأصل

92
00:06:22,540 --> 00:06:23,830
إنّها بجودة الأصليّة

93
00:06:24,040 --> 00:06:25,160
لديك موهبةٌ حقيقيّة

94
00:06:25,790 --> 00:06:27,540
هل علّمَك أبوك هذا؟

95
00:06:27,910 --> 00:06:28,910
ما الّذي تقوله؟

96
00:06:29,330 --> 00:06:32,540
ذلك العجوز عديم الجدوى لا يستطيع حتّى
تثبيت سكّين. ما الّذي يستطيع فعله؟

97
00:06:34,290 --> 00:06:34,830
معك حقّ

98
00:06:35,540 --> 00:06:38,450
.تيان، لديّ أكلات خفيفة دوماً بعد الظّهر
وتعال واستمتع بوقتك أكثر

99
00:06:38,790 --> 00:06:41,160
في وقت لاحق، قد أتمكّن من توفير
بعض الأعمال الجانبيّة لك

100
00:06:44,700 --> 00:06:46,540
سيكون هذا رائعاً. شكراً يا عمّ

101
00:06:46,910 --> 00:06:49,290
عرفتُ بأنّني كنتُ مُختلفاً وأنا طفل

102
00:06:50,450 --> 00:06:52,910
لأنّني استطعتُ رؤية ذلك في عيونهم

103
00:07:09,660 --> 00:07:13,450
من أين حصلت على المال؟ هل أقنعك أولئك
الرّيفيّون بأنّك عبقريّ؟

104
00:07:16,410 --> 00:07:18,790
لا تقضم أكثر ممّا يمكنك أن تمضغ

105
00:07:19,160 --> 00:07:21,160
استخدم الخشبَ المُناسب للنّحت المُناسب

106
00:07:21,660 --> 00:07:23,910
الكبرياء سوف يُفسد حِرفتَك ليس إلّا

107
00:07:24,200 --> 00:07:26,330
ذات يوم، سيؤدّي ذلك إلى سقوطك

108
00:07:30,540 --> 00:07:31,160
سوف أفعلها

109
00:07:32,160 --> 00:07:34,200
ما دمت تدفع لي المبلغ الّذي اتّفقنا عليه

110
00:07:36,450 --> 00:07:37,910
تيان، هل أنت متأكّد من أنّ هذا مُناسب؟

111
00:07:38,450 --> 00:07:39,290
...أبوك

112
00:07:40,450 --> 00:07:41,540
نحن نقوم بعملٍ صالح

113
00:07:42,040 --> 00:07:45,160
إذا نجح هذا، فرُبّما يستطيع
الهرب من ذلك الفاشل

114
00:07:45,950 --> 00:07:47,080
يعرض مُشترٍ سعراً مُرتفعاً

115
00:07:47,290 --> 00:07:49,080
يريد نحتاً خشبيّاً لنفس التّمثال المُقدّس

116
00:07:49,660 --> 00:07:51,830
لكن الخشب الأصليّ نادر جدّاً ومُكلف

117
00:07:52,160 --> 00:07:53,410
لا يمكننا تسليمه في أيّ وقت قريب

118
00:07:53,950 --> 00:07:57,040
لذا عثرنا على خشب يُشبه الأصليّ
تقريباً بعد النّحت

119
00:07:57,540 --> 00:07:59,450
،بمهارتك وطريقة تقديمنا

120
00:07:59,660 --> 00:08:01,100
سيكون خالياً من العيوب

121
00:08:01,160 --> 00:08:03,410
تيان، آمن بأنّك عبقريّ

122
00:08:04,580 --> 00:08:05,950
أعلم بأنّ توبيخ وضربات أبي

123
00:08:06,290 --> 00:08:07,660
هي بدافع الغيرة

124
00:08:08,540 --> 00:08:11,660
لأنّه مُقارنة بطفل، لا يستطيع الاعتراف

125
00:08:12,160 --> 00:08:14,410
بقدرته العاديّة وعجزه

126
00:08:15,290 --> 00:08:17,950
لنحت تمثال مُقدّس، يجب عليك
أن تؤمن بالألوهيّة

127
00:08:18,660 --> 00:08:20,080
في تلك اللّحظة، شعرتُ بذلك

128
00:08:20,790 --> 00:08:22,660
رُبّما منحتْني الآلهة فُرصة

129
00:08:22,910 --> 00:08:27,200
للهرب من ماضيّي، ولإيجاد الأشخاص
،الّذين يُقدّرونني حقّاً

130
00:08:27,700 --> 00:08:29,160
ولاحتضان حياة جديدة

131
00:08:30,200 --> 00:08:30,830
...لكن

132
00:08:31,160 --> 00:08:33,790
كان أنت أيّها الطّفل الشّقي
مَن باعنا القطع المُزيّفة

133
00:08:37,700 --> 00:08:38,910
لديّ موهبة

134
00:08:39,040 --> 00:08:39,950
لديّ موهبة

135
00:08:40,410 --> 00:08:43,200
لا أريد... لا أريد أن ينتهي الأمر هنا

136
00:08:47,410 --> 00:08:49,660
ألم تكن أحد جِنرالات النّمر الثّمانية
الّذين أقسموا للملِك لي؟

137
00:08:50,330 --> 00:08:51,160
لماذا خنتَه؟

138
00:08:52,290 --> 00:08:54,040
خنتُه

139
00:08:55,290 --> 00:08:57,080
لكنّك مُخطئ بشأن أمر واحد

140
00:08:59,160 --> 00:09:05,660
أنا، أبداً، لم أعترف به كملِك لي

141
00:09:09,160 --> 00:09:10,950
إذاً كنتَ أنت صاحب القلب الخائن منذ البداية

142
00:09:11,080 --> 00:09:11,790
كلام فارغ

143
00:09:12,040 --> 00:09:14,660
كنتُ ثالث شخص ينضمّ لصفوفه
في بداية الانتفاضة

144
00:09:15,160 --> 00:09:18,540
كان الجيش غالباً ما يفقد معنويّاته
عندما يُواجه جيشاً أقوى بكثير

145
00:09:18,830 --> 00:09:22,790
أعددتُ الإستراتيجيّة، وحافظتُ
على المعنويّات عالية، وربحت

146
00:09:23,160 --> 00:09:26,910
،أثناء كمين، حوّلتُ فخَّهم ضدّهم واقتحمت

147
00:09:27,160 --> 00:09:29,200
وسيطرتُ على الأرض، وقلبتُ الموازين

148
00:09:29,450 --> 00:09:32,540
في المرحلة الأخيرة، تآمر مُشعوذٌ
مع أشخاص من الدّاخل للتمرُّد

149
00:09:32,660 --> 00:09:35,910
كشفتُ الخائن، واستأصلتُ ذلك التّهديد

150
00:09:37,290 --> 00:09:41,290
حتّى بعد كُلّ ذلك، تمّ تصنيفي السّابع
بين جِنرالات النّمر الثّمانية

151
00:09:41,790 --> 00:09:44,290
،رجل لا يستطيع حتّى أن يُكافئ بعدل

152
00:09:44,540 --> 00:09:45,910
يُعَدّ نكرة

153
00:09:46,790 --> 00:09:48,410
روح السّماء، روح الأرض، درع الأرض

154
00:09:52,540 --> 00:09:53,410
هل ما قاله صحيح؟

155
00:09:54,160 --> 00:09:55,660
،عندما استوليتُ على المملكة أوّل مرّة

156
00:09:55,950 --> 00:09:57,160
كنتُ مُستهتراً

157
00:09:57,910 --> 00:09:59,830
لكن حاولت تلبية كُلّ طلب من أبطالنا

158
00:10:00,910 --> 00:10:02,830
لكن هو... إنّه مُتكتّم جدّاً

159
00:10:03,540 --> 00:10:04,790
حتّى عندما كنتُ أسأل، لا يتكلّم أبداً

160
00:10:05,410 --> 00:10:07,910
لكن لا أعتقد بأنّه سيخونني بسبب مُكافآت

161
00:10:08,160 --> 00:10:09,450
ماذا عن الخِلافات السّياسيّة؟

162
00:10:10,830 --> 00:10:12,700
كانت هناك الكثير من القرارات
الّتي لم نستطع الاتّفاق عليها

163
00:10:13,160 --> 00:10:14,580
،لكن بوجود كثير من الأشخاص والآراء

164
00:10:15,160 --> 00:10:16,910
اخترتُ فقط الطّريقَ الّذي آمنتُ فيه

165
00:10:17,830 --> 00:10:20,830
،نقطة بدايتك، من البداية حتّى النّهاية

166
00:10:21,450 --> 00:10:23,580
كانت دائماً لإثبات نفسك

167
00:10:24,540 --> 00:10:25,450
لم تكن لأجل مُستقبل هذا البلد

168
00:10:26,040 --> 00:10:31,700
لذلك السّبب وحده، لستَ جديراً
بتحدِّي سُلطته

169
00:10:31,950 --> 00:10:33,160
سُلطة؟

170
00:10:33,660 --> 00:10:36,660
أيّ سُلطة قد بقيت؟

171
00:10:38,160 --> 00:10:39,450
ذلك الفظّ الّذي ذكرتَه قد ولّى

172
00:10:39,700 --> 00:10:41,660
أتعلم بأمر الاستحواذ الجسديّ
الخاصّ بالملِك لي؟

173
00:10:42,160 --> 00:10:43,160
يبدو أنّك تعرف الكثير

174
00:10:43,540 --> 00:10:46,080
في هذه الحالة، لا أستطيع أن أدعك
أو أدع أيّ شخص حيّاً هنا

175
00:10:55,410 --> 00:10:59,830
مياتشي غيسي بابالا بالا

176
00:11:04,040 --> 00:11:04,540
ماذا؟

177
00:11:09,540 --> 00:11:12,540
من يقف وراء المُؤامرة لاستبدال الملِك لي؟

178
00:11:16,080 --> 00:11:18,160
كُفّ عن مُناداته بالملِك لي طوال الوقت

179
00:11:18,410 --> 00:11:20,660
لا يحقّ له أن يحكم هذا البلد

180
00:11:21,790 --> 00:11:24,660
،التّخطيط العسكريّ، ومشاريع التّجارة
...وسياسات الحكومة

181
00:11:24,790 --> 00:11:26,540
مارستُها جميعها

182
00:11:27,160 --> 00:11:29,450
...مُخطَّط الأحياء العشرة تحت السّماء

183
00:11:29,580 --> 00:11:30,790
كنتُ أنا من رسمه

184
00:11:31,580 --> 00:11:34,830
في البداية، ظننتُ بأنّه سيفهم ويُقدّرني

185
00:11:36,200 --> 00:11:37,450
،أولئك الأشخاص خارج الحيّ 8

186
00:11:37,790 --> 00:11:39,410
دعهم يُناضلون بمُفردهم

187
00:11:39,790 --> 00:11:41,540
ينبغي أن نُركِّز على بناء الأحياء
المحوريّة أوّلاً

188
00:11:42,330 --> 00:11:46,450
لا. تكافؤ الثّروات يؤدّي دوماً
إلى فقر مُتكافئ

189
00:11:47,290 --> 00:11:49,290
وفجوات الثّروة ستخلق دوماً انقسامات طبقيّة

190
00:11:50,080 --> 00:11:52,660
إذا فعلنا ذلك، فما الّذي يجعلنا
مُختلفين عن الّذين أسقطناهم؟

191
00:11:53,160 --> 00:11:55,160
أنا لا أحاول هجرهم أو استغلالهم

192
00:11:55,450 --> 00:11:56,790
أنا أطلب منهم الانتظار فحسب

193
00:11:56,910 --> 00:11:59,700
لكن لِمَ ينبغي لهم ذلك بدلاً عنك أو عنّي؟

194
00:12:00,450 --> 00:12:01,830
الجميع قد انتظروا فترة طويلة بما يكفي

195
00:12:02,330 --> 00:12:04,790
أريد من الجميع أن يحظوا بصفقة عادلة

196
00:12:06,200 --> 00:12:06,950
تبّاً

197
00:12:07,580 --> 00:12:10,040
التكلُّم مع أحمق غير مُثقَّف مُرهِق

198
00:12:12,950 --> 00:12:14,040
!أيُّها الحيوان

199
00:12:14,700 --> 00:12:17,080
كم مرّة أخبرتُك أن تُحسن السّلوك؟

200
00:12:17,950 --> 00:12:18,950
!لا تلمس أغراضي

201
00:12:23,040 --> 00:12:23,950
!توقّف حالاً

202
00:12:24,580 --> 00:12:25,200
!انقلع

203
00:12:27,040 --> 00:12:28,160
!توقّف

204
00:12:38,290 --> 00:12:39,410
!توقّف

205
00:12:45,290 --> 00:12:47,910
يا للخسارة. مثل هذه القطعة المُزيّفة
أمستْ ملعونة الآن

206
00:12:48,410 --> 00:12:50,290
يتمتّع هذا الطّفل بموهبة في السّرقة

207
00:12:50,790 --> 00:12:51,720
هيّا بنا

208
00:12:52,950 --> 00:12:56,540
بعد ذلك اليوم، شعرتُ وكأنّ
الآلهة قد تخلّتْ عنّي

209
00:12:57,160 --> 00:13:01,700
مهما نحتُّ بإتقان، لم يعُد أحدٌ
يشتري خشبي ثانية

210
00:13:02,580 --> 00:13:04,660
بينما كنتُ أمتلك موهبةً كبيرةً بوضوح

211
00:13:04,910 --> 00:13:07,790
كُلّ ذلك أفسدَه ذلك العالة عديم الجدوى

212
00:13:09,160 --> 00:13:11,410
جميعكم قمامة غير مُثقّفة

213
00:13:11,950 --> 00:13:14,080
لن أرتكب نفس الخطأ ثانية

214
00:13:15,160 --> 00:13:16,790
،تكلّمتُ حتّى بُحّ صوتي

215
00:13:17,160 --> 00:13:18,950
لكن لم يكن يصغي لأيّ كلمة

216
00:13:19,410 --> 00:13:21,910
لم يستوعب حتّى أساسيّات الاقتصاد

217
00:13:22,450 --> 00:13:25,410
سوف يُوصل هذا البلد للانهيار
عاجلاً أم آجلاً

218
00:13:25,910 --> 00:13:27,290
ما أفعله الآن

219
00:13:27,450 --> 00:13:28,910
،يُخلّص العالمَ من تهديد

220
00:13:29,290 --> 00:13:31,540
ليمنح الجميع مُستقبلاً أكثر إشراقاً

221
00:13:31,830 --> 00:13:34,580
اذهب إلى القبر مع ذلك الفاشل

222
00:13:38,540 --> 00:13:39,660
!إنّه مجنون! مجنون حرفيّاً

223
00:13:40,200 --> 00:13:41,830
هل يحاول تسوية المنطقة بأكملها؟

224
00:13:46,790 --> 00:13:48,080
حان الوقت يا لي

225
00:14:18,700 --> 00:14:19,830
يا إلهي العزيز

226
00:14:20,790 --> 00:14:21,660
،في هذه الحياة

227
00:14:22,660 --> 00:14:25,160
لماذا لا تزال تُعذّبني؟

228
00:14:35,660 --> 00:14:37,540
تعافيتَ للتو. ينبغي أن ترتاح أوّلاً

229
00:14:37,950 --> 00:14:38,790
أنا بخير

230
00:14:41,910 --> 00:14:42,830
أيّ نوع من السّحر كان ذلك؟

231
00:14:43,200 --> 00:14:44,160
كان مُدهشاً حقّاً

232
00:14:44,790 --> 00:14:47,450
،أن تقهر وتهزم تشين تيان
...أحد جِنرالات النّمر الثّمانية فعلاً

233
00:14:48,950 --> 00:14:49,540
أنت تُحرجني

234
00:14:50,160 --> 00:14:51,660
بعض الخدع الّتي تعلّمتُها من مدارس جانبيّة

235
00:14:52,200 --> 00:14:52,910
أحقّاً ذلك؟

236
00:14:53,660 --> 00:14:55,830
أنا لا آلف تلك التّقنيّات الغامضة حقّاً

237
00:14:56,160 --> 00:14:59,290
ولا أعرف أحداً في الحيّ 10
يمتلك مهارةً كهذه

238
00:14:59,790 --> 00:15:04,330
لكن أعرف الأسلوب والقوّة اللّتين
أظهرتهما عند هزيمة تشين تيان

239
00:15:04,660 --> 00:15:07,540
إنّه أسلوب ينتمي لقائد اعتقدتُه ميّتاً

240
00:15:08,450 --> 00:15:09,540
من أنت بالضّبط؟

241
00:15:19,580 --> 00:15:20,330
،بعد كُلّ هذه السّنين

242
00:15:21,080 --> 00:15:22,830
لا تزال بصيرتك حادّة جدّاً

243
00:15:23,790 --> 00:15:24,790
أو باما

244
00:15:25,540 --> 00:15:26,160
...أنت

245
00:15:29,540 --> 00:15:30,040
الملِك لي

246
00:15:31,040 --> 00:15:31,830
!الملِك لي

247
00:15:32,290 --> 00:15:33,700
لا عجب في أنّه كان دوماً يُتمتم مع نفسه

248
00:15:33,910 --> 00:15:35,660
هل يُعقل أنّ روح الملِك لي تستحوذ عليه؟

249
00:15:36,790 --> 00:15:38,040
إنّه الملِك لي الحقيقيّ

250
00:15:39,330 --> 00:15:40,580
تحيّاتي يا جلالة الملِك لي

251
00:15:41,290 --> 00:15:42,660
لا، لا داعي. اسمي هو مينغ

252
00:15:42,830 --> 00:15:45,410
تسكن روح الملِك لي هذا الجسد

253
00:15:45,660 --> 00:15:49,410
الشّخص الّذي في القصر الآن استخدم
تعويذةً للاستحواذ على جسدِ الملِك لي

254
00:15:49,660 --> 00:15:50,790
لذا احتفظوا بهذا سرّاً رجاء

255
00:15:50,950 --> 00:15:52,040
لا تدعوا المُنتحِل ينتبه لذلك

256
00:15:53,200 --> 00:15:55,580
لكن موت تشين تيان سيجذب الأنظار

257
00:15:56,040 --> 00:15:59,200
،يجب أن تكون حركاتنا التّالية أكثر حذراً
ويجب علينا تسريع الأمور

258
00:15:59,540 --> 00:16:00,910
أمرك، جلالة الملِك لي

259
00:16:02,200 --> 00:16:03,790
أهلاً بك يا مولايّ لونغ أو

260
00:16:04,660 --> 00:16:05,410
"لا تُناديني بـ"مولايّ

261
00:16:05,790 --> 00:16:07,330
شكراً على إنقاذي مرّتين

262
00:16:08,540 --> 00:16:09,830
،بين أولئك المُتّصلين بتشين تيان

263
00:16:10,540 --> 00:16:12,330
هل لديك فكرة عن العقل المُدبّر؟

264
00:16:14,160 --> 00:16:17,120
ذلك الفظّ الّذي ذكرتَه قد ولّى

265
00:16:30,120 --> 00:16:31,950
‏77 يوم