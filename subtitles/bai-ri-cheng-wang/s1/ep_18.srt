1
00:00:54,830 --> 00:00:56,330
هل أنتِ متأكّدة بأنّه في
حالة صدمة فقط؟

2
00:00:56,830 --> 00:00:59,080
أعتقد أيضاً بأنّ السّيّد ليانغ يبدو غريباً

3
00:01:01,950 --> 00:01:02,750
غريباً من أيّ ناحية؟

4
00:01:04,120 --> 00:01:05,330
لا، لا شيء

5
00:01:05,620 --> 00:01:07,330
ربّما خانَتْني الذّاكرة

6
00:01:08,700 --> 00:01:11,870
بنزيف الدّم الشّديد ذاك، يمكن
للصّدمة أن تدوم لفترة طويلة

7
00:01:12,450 --> 00:01:14,330
،إن سارت الأمور بشكل سيّئ
قد لا يستيقظ أبداً

8
00:01:15,620 --> 00:01:17,950
لحسن الحظّ، إنّه حيّ حاليّاً

9
00:01:18,700 --> 00:01:21,370
لكن بهذا الوضع، لا يمكن لمهارة
شِفاء أن تُعالج هذا

10
00:01:21,750 --> 00:01:22,950
،إذا نقلناه إلى مشفى في الحيّ 9

11
00:01:23,120 --> 00:01:24,620
فقد يجذب ذلك انتباهاً غير مرغوب فيه

12
00:01:25,080 --> 00:01:26,450
لكن لا يوجد عيادات حقيقيّة في الحيّ 10

13
00:01:29,000 --> 00:01:31,200
هل كانت عضلاته بهذا الحجم عندما غادر؟

14
00:01:31,330 --> 00:01:33,830
لاحظت. ابقَ صامتاً. لِمَ تلمسه؟

15
00:01:35,330 --> 00:01:37,450
رُبّما بالغتُ في علاج الصّدمة

16
00:01:38,370 --> 00:01:40,330
هل يمكن للصّدمة أن تجعل عضلات
الصّدر بهذا الحجم؟

17
00:01:40,620 --> 00:01:41,830
كم يتطلّب ذلك من طاقة؟

18
00:01:42,080 --> 00:01:44,080
أما من طريقة أفضل لإنقاذه؟

19
00:01:44,700 --> 00:01:46,330
،جرّبتُ كُلَّ طريقة جسديّة مُمكنة

20
00:01:46,830 --> 00:01:48,580
لكن لان وأنا لا نعرف تعويذات شِفائيّة

21
00:01:48,750 --> 00:01:50,200
بحثتُ في الكِتاب المُحرَّم في عقلي

22
00:01:50,580 --> 00:01:53,000
وجدتُ تعويذةً واحدة: لمسة الشِّفاء

23
00:01:53,200 --> 00:01:55,250
ينبغي أن تُعيد المرء إلى الحياة

24
00:01:57,450 --> 00:01:58,700
لماذا لم تستعملها عليه؟

25
00:01:59,580 --> 00:02:02,080
لا أعرف السّبب، لكن هذه التّعويذة
تُحدِّد مَن يستطيع استعمالها

26
00:02:02,450 --> 00:02:04,700
لا بُدّ أن يكون صاعداً لا يعرف
أي تعويذات سابقة

27
00:02:06,580 --> 00:02:08,580
لِمَ توجد قاعدة تعلُّم غريبة كهذه؟

28
00:02:09,620 --> 00:02:12,870
وفقاً للكتاب المُحرَّم، يتطلّب
سحر الشّفاء تركيزاً عالياً

29
00:02:13,330 --> 00:02:16,750
،إذا مزجها المُتعلّمُ مع سحرٍ آخر
فسوف يُلطِّخ السّحر الآخر

30
00:02:17,700 --> 00:02:20,700
لذا لان، الّذي يعرف السّحر، مُستبعَد أيضاً

31
00:02:22,250 --> 00:02:23,950
،لكن قبل أن أُعلّمكِ هذه التّعويذة المُحرَّمة

32
00:02:24,250 --> 00:02:25,750
يجب أن أصهركِ مع المانا أوّلاً

33
00:02:27,700 --> 00:02:28,200
انتظر

34
00:02:28,500 --> 00:02:29,700
...تقصد

35
00:02:31,200 --> 00:02:32,620
انصهار السّحر؟

36
00:02:33,080 --> 00:02:35,000
لن أستخدم شيئاً بهذه الغرابة

37
00:02:35,500 --> 00:02:37,500
انتظر. لا بُدّ من وجود طريقة أُخرى

38
00:02:39,330 --> 00:02:41,700
كبير السّحرة لي وان، فكِّر في شيء

39
00:02:41,700 --> 00:02:43,500
كُفّي عن مُقاومة ذلك. لا أريد
فعل هذا لكِ

40
00:02:43,700 --> 00:02:45,830
لإنقاذ السّيّد ليانغ، تحمّلي ذلك فحسب

41
00:02:46,370 --> 00:02:47,370
توقّف يا مياو

42
00:02:47,870 --> 00:02:50,200
الآنسة هوانغ هي فتاة مُوقَّرة

43
00:02:50,580 --> 00:02:52,450
انصهار السّحر مُهينٌ جدّاً لها

44
00:02:52,950 --> 00:02:54,330
أعلم ذلك بالطّبع

45
00:02:54,580 --> 00:02:57,080
.لكن ثمّة حياة على المحكّ
يمكن غضّ النّظر عن الإهانة

46
00:02:57,330 --> 00:02:59,120
يكفي. كفى مُزاحاً

47
00:03:01,580 --> 00:03:02,580
كنتُ أُحاول إخافتها فحسب

48
00:03:04,200 --> 00:03:06,200
لكن جرّبنا طُرُقاً أُخرى في المرّة السّابقة

49
00:03:06,250 --> 00:03:07,080
رأيت ما حدث

50
00:03:07,330 --> 00:03:08,370
جروح فقط أو أسوأ

51
00:03:09,500 --> 00:03:10,870
ليس وكأنّنا جرّبنا كُلَّ شيء

52
00:03:11,700 --> 00:03:14,830
ما زالت هناك طُرُقاً أُخرى لم نُجرّبها

53
00:03:18,000 --> 00:03:19,120
!توقّف، توقّف

54
00:03:19,450 --> 00:03:20,830
هذه الفكرة أكثر من فاضحة

55
00:03:20,870 --> 00:03:21,700
إنّها مُقرفة حرفيّاً

56
00:03:22,000 --> 00:03:23,330
قبلتي الأولى هي لشياوهونغ فقط

57
00:03:23,500 --> 00:03:24,200
لا تُفكِّر فيها حتّى

58
00:03:24,450 --> 00:03:25,330
تماماً

59
00:03:25,580 --> 00:03:27,200
أنت هو المُستفيد هنا

60
00:03:27,330 --> 00:03:28,700
كيف نسيتُ ذلك؟

61
00:03:29,370 --> 00:03:31,250
أما من طريقة طبيعيّة للقيام بهذا؟

62
00:03:31,330 --> 00:03:32,830
،لنقل السّحر إلى داخل جسدك

63
00:03:33,200 --> 00:03:34,870
هناك نقاط دخول قليلة فقط

64
00:03:36,830 --> 00:03:38,080
نقاط الدُّخول

65
00:03:39,830 --> 00:03:40,500
!وجدتُها

66
00:03:41,000 --> 00:03:42,370
يُقال بأنّ المرض يدخل من الفم

67
00:03:42,950 --> 00:03:45,830
أكل شيء غير نظيف يُدخل
الجراثيم إلى الجسد

68
00:03:46,200 --> 00:03:49,580
لذا بهذا المنطق، ماذا لو تعاملنا
مع السّحر كطعام وابتلعناه؟

69
00:03:49,750 --> 00:03:50,580
أليس هذا نفس المبدأ؟

70
00:03:51,500 --> 00:03:53,580
لكن كيف تُدخِل سحراً إلى بطنها؟

71
00:03:53,830 --> 00:03:54,750
هل نسيت؟

72
00:03:55,080 --> 00:03:57,080
يمكنني استحضار الطّعام بالسّحر

73
00:03:57,450 --> 00:03:59,830
يمكنني أيضاً خلط الطّعام مع السّحر

74
00:04:06,580 --> 00:04:07,330
!مُذهل

75
00:04:07,830 --> 00:04:08,750
إنّها مُختلفة حقّاً

76
00:04:09,950 --> 00:04:10,870
...هذه

77
00:04:12,330 --> 00:04:13,620
كعكة

78
00:04:15,950 --> 00:04:17,250
السّحر في الكريمة

79
00:04:17,620 --> 00:04:19,080
هذه كعكةٌ سحريّةٌ خاصّة

80
00:04:19,500 --> 00:04:20,250
...لكن رغم ذلك

81
00:04:21,200 --> 00:04:22,750
هناك كمّية فائضة

82
00:04:23,450 --> 00:04:26,200
حسناً، أردتُ منح الآنسة هوانغ
مزيداً من السّحر

83
00:04:26,330 --> 00:04:28,000
فقدتُ السّيطرة وتحمّستُ زيادة عن اللّزوم

84
00:04:29,120 --> 00:04:34,330
هذا سحر، ليس حُريرات

85
00:04:41,950 --> 00:04:43,200
كُفّا عن الحركة

86
00:04:43,580 --> 00:04:44,850
أنتما تُشعرانني بدُوار

87
00:04:46,200 --> 00:04:47,120
رئيس الحيّ قد مات

88
00:04:47,250 --> 00:04:48,250
والسّيّد ليانغ مُصاب بجروح بليغة

89
00:04:48,450 --> 00:04:50,830
قال بأنّنا سنبني إمبراطوريّة أعمال
خاصّة بالحيّ 9 معاً

90
00:04:50,950 --> 00:04:52,500
والآن لا نملك فريقاً حتّى

91
00:04:52,620 --> 00:04:53,750
فكيف لنا ألّا نقلق؟

92
00:04:54,830 --> 00:04:56,620
مياو سيُعيد السّيّد ليانغ قريباً

93
00:04:57,370 --> 00:04:59,080
قريباً، قريباً، هذا كُلّ ما سنسمعه

94
00:04:59,250 --> 00:05:00,200
مضى يوم كامل

95
00:05:00,450 --> 00:05:01,450
مكتب الحيّ مُغلَق

96
00:05:01,580 --> 00:05:02,950
سيبدأ النّاس بطرح أسئلة

97
00:05:06,250 --> 00:05:09,700
أيضاً، لا ينبغي لأحد أن يُزعجنا
في هذه الأيّام

98
00:05:12,000 --> 00:05:13,120
هل سمعت بأنّ لدينا عطلة اليوم؟

99
00:05:13,450 --> 00:05:15,250
لا، لكن اللّافتة مرفوعة بالفعل

100
00:05:15,580 --> 00:05:16,120
صحيح

101
00:05:16,200 --> 00:05:18,330
هيّا. لا ضير من إجازة، صحيح؟

102
00:05:18,950 --> 00:05:19,200
هيّا بنا

103
00:05:19,330 --> 00:05:22,120
هذا سيُعتّم على الأمر لفترة طويلة فقط

104
00:05:22,250 --> 00:05:24,580
نحتاج خطّة، ثمّ تصريحاً رسميّاً

105
00:05:25,200 --> 00:05:25,700
هذا سيّئ

106
00:05:26,000 --> 00:05:26,870
ظهرَ غريبٌ ما

107
00:05:26,950 --> 00:05:27,950
أصرَّ على الدّخول

108
00:05:32,450 --> 00:05:33,500
الشّخص في الأمس

109
00:05:33,580 --> 00:05:35,120
قد شُوِّهَ بواسطة داتوي

110
00:05:35,580 --> 00:05:36,950
ما زلنا لا نعلم من يكون

111
00:05:37,580 --> 00:05:39,120
،اعتقدنا بأنّك تعرّضت لمُشكلة في الحيّ 9

112
00:05:39,330 --> 00:05:40,580
لذا أرسلوا شخصاً للتحقُّق

113
00:05:41,450 --> 00:05:43,580
لكن يبدو أنّ لا علاقة لذلك بالحيّ 9

114
00:05:44,200 --> 00:05:46,580
اسأل عن شكلها. تفاصيل

115
00:05:47,500 --> 00:05:49,500
هل يمكنك وصفها ثانية؟

116
00:05:50,450 --> 00:05:52,250
قصيرة جدّاً، وبشعر قصير

117
00:05:53,000 --> 00:05:55,200
كان وجهها مطليّاً أو مُقنَّعاً

118
00:05:55,450 --> 00:05:56,370
لم أستطع تمييز وجهها

119
00:05:56,830 --> 00:05:59,500
تستطيع إعادة تشكيل نفسها كما الوحل

120
00:06:00,200 --> 00:06:01,870
لا تبدو أيّاً من جِنرالات النّمر الثّمانية

121
00:06:02,200 --> 00:06:04,250
لكن لا يوجد شخص آخر بهذه المُواصفات

122
00:06:07,080 --> 00:06:08,200
أخيراً انتهيتُ من الأكل

123
00:06:08,580 --> 00:06:09,580
شبعت

124
00:06:09,580 --> 00:06:10,580
كيف حالكِ الآن؟

125
00:06:10,950 --> 00:06:12,830
هل تشعرين بالسّحر يتدفّق في داخلكِ؟

126
00:06:14,450 --> 00:06:18,080
أشعر بموجة تتصاعد من معدتي

127
00:06:20,870 --> 00:06:21,700
هذه هي

128
00:06:21,830 --> 00:06:25,330
هذا التجشّؤ يعني بأنّ سحركِ كامل

129
00:06:27,950 --> 00:06:29,200
لنبدأ إذاً. اتبعيني

130
00:06:35,950 --> 00:06:36,580
كرّري ورائي

131
00:06:37,250 --> 00:06:41,200
.لا يمكن أن تبقى الحياة مُتوقِّفة
انهض وافعلها بحماس

132
00:06:45,580 --> 00:06:47,250
لا يمكن أن تبقى الحياة مُتوقِّفة

133
00:06:47,950 --> 00:06:49,580
انهض وافعلها بحماس

134
00:06:59,700 --> 00:07:00,620
!نجح ذلك

135
00:07:00,830 --> 00:07:01,580
لقد نهض

136
00:07:11,700 --> 00:07:12,870
كانت تلك الضّربة قويّة

137
00:07:13,330 --> 00:07:14,580
هل أُغمي عليه للتو؟

138
00:07:14,830 --> 00:07:16,000
لم أقصد ذلك

139
00:07:17,250 --> 00:07:17,750
ساقاه

140
00:07:18,080 --> 00:07:19,080
ما زال يرتعش

141
00:07:19,580 --> 00:07:20,370
لا يزال حيّاً

142
00:07:20,500 --> 00:07:21,700
!بسرعة، لنسحبه للأسفل

143
00:07:22,500 --> 00:07:23,620
لا تسحب سرواله

144
00:07:23,620 --> 00:07:25,080
أعلم. قليلاً فقط

145
00:07:33,330 --> 00:07:34,370
أين أنا؟

146
00:07:34,500 --> 00:07:35,700
حملَك مياو عائداً بك إلى الحيّ 10

147
00:07:35,950 --> 00:07:37,250
هل تتذكّر ما حدث؟

148
00:07:37,870 --> 00:07:40,830
جرحَني رئيس الحيّ 9 لسحب دماء

149
00:07:42,000 --> 00:07:44,500
لكن لماذا رأسي يؤلمني وليس صدري؟

150
00:07:45,950 --> 00:07:48,200
رُبّما تعرّضت لبرد شديد بينما
كنتَ غائباً عن الوعي

151
00:07:48,580 --> 00:07:49,700
أو رُبّما نمتَ بوضعيّة خاطئة

152
00:07:51,450 --> 00:07:53,000
ماذا عن صدري؟

153
00:07:57,000 --> 00:07:58,080
لماذا أصبح شاحباً؟

154
00:07:59,620 --> 00:08:01,330
يبدو أنّ الشّفاء يحتاج أكثر من سحر

155
00:08:01,700 --> 00:08:03,000
إنّه يستهلك أيضاً طاقة حياة الشّخص

156
00:08:04,450 --> 00:08:06,620
لن أدعها تؤذي نفسها ثانية

157
00:08:07,950 --> 00:08:09,330
كان للهجوم هدف واضح

158
00:08:09,750 --> 00:08:11,000
لعلّنا تحت المُراقبة بالفعل

159
00:08:11,830 --> 00:08:13,620
إذاً علينا أن نُسرِّع عمليّة التّدريب

160
00:08:14,080 --> 00:08:15,830
ونوفّر دعماً في كلا الحيّين قريباً

161
00:08:16,080 --> 00:08:18,370
إن لزم الأمر، يمكن فصل كلا الحيّين

162
00:08:19,330 --> 00:08:21,500
بالمُناسبة، هل لان بخير لوحدها في الحيّ 9؟

163
00:08:22,200 --> 00:08:24,080
ينبغي أن يكون التجّار الّذين
تُرِكوا هناك بخير

164
00:08:25,200 --> 00:08:26,620
لكن أريد العودة قريباً

165
00:08:36,370 --> 00:08:37,200
من أنت؟

166
00:08:38,000 --> 00:08:40,200
،كسبت قلوب النّاس بخبز رخيص

167
00:08:40,370 --> 00:08:41,950
ثمّ استخدمتَ رئيس الحيّ لتبرئتنا

168
00:08:42,500 --> 00:08:44,000
كنتَ جاهزاً للسّيطرة على الحيّ 10

169
00:08:44,580 --> 00:08:46,250
لكن كان موت رئيس الحيّ 9 حادِثاً عرَضيّاً

170
00:08:46,620 --> 00:08:48,950
كيف يمكنك أن تحلّ مكانه بنجاح؟

171
00:08:50,500 --> 00:08:51,620
هل يمكننا استخدام نفس الخدعة مرّتين؟

172
00:08:53,200 --> 00:08:55,450
ليس هذه المرّة. تماديتُ كثيراً

173
00:08:56,830 --> 00:09:00,330
لذا، هل أنت جاهز لتلقّي هذا
بشكل مُباشر؟

174
00:09:14,000 --> 00:09:15,700
لم أترك منه أثراً

175
00:09:16,080 --> 00:09:19,080
اعترفتُ بالخطأ علناً، لكن يبقى
هذا يقع على عاتقك أنت

176
00:09:19,080 --> 00:09:20,330
كانت الأمور مُحتدِمة

177
00:09:20,580 --> 00:09:21,450
لا أحد يستطيع التحفُّظ

178
00:09:21,950 --> 00:09:24,120
بالمُناسبة، لديّ طريقة أُخرى

179
00:09:24,620 --> 00:09:25,830
هناك تعويذة تُدعى تنكُّر

180
00:09:26,200 --> 00:09:27,370
يمكنها أن تجعلك تبدو كأيّ شخص

181
00:09:27,450 --> 00:09:28,700
هناك سحر بهذه الجودة؟

182
00:09:29,200 --> 00:09:31,120
كبير السّحرة لي وان، لماذا
لم تقل ذلك من قبل؟

183
00:09:31,500 --> 00:09:33,080
ما الّذي ننتظره؟ علّمني

184
00:09:33,370 --> 00:09:35,580
سأصبح رئيس الحيّ 9 لمُساعدة لان

185
00:09:35,750 --> 00:09:37,200
لكن هذه التّعويذة مُتطلِّبة جدّاً

186
00:09:37,580 --> 00:09:40,830
تحتاج مخزوناً سحريّاً كبيراً، وهي
تختبر ذوقك أكثر فأكثر

187
00:09:41,450 --> 00:09:42,500
فهمت. يجب عليك فعل هذا

188
00:09:44,580 --> 00:09:46,450
حسناً. هذا سهلٌ جدّاً

189
00:09:46,700 --> 00:09:48,700
انظروا. ظهرَ طيفُ المرآة الآن

190
00:09:48,950 --> 00:09:50,080
في هذه اللّحظة، لستُ نفسي

191
00:09:50,330 --> 00:09:51,700
الشّكل المُغيَّر يصبح النّفس الحقيقيّة

192
00:09:52,080 --> 00:09:54,620
تحوّل الآن، فلتولَد من جديد من القوقعة

193
00:10:01,830 --> 00:10:02,450
من هذه؟

194
00:10:03,080 --> 00:10:03,950
أهذه أنا؟

195
00:10:04,200 --> 00:10:05,520
هذا ما أعتقده

196
00:10:05,620 --> 00:10:07,080
لماذا آلَ الأمر إلى هذا؟

197
00:10:07,450 --> 00:10:09,800
هل كنتَ تُفكِّر في شيء غريب؟

198
00:10:09,800 --> 00:10:11,910
وما أدراني بأنّ الأفكار تؤثّر
على التّعويذات؟

199
00:10:11,910 --> 00:10:13,580
أرجعني حالاً

200
00:10:14,080 --> 00:10:16,080
لستُ نفسي. الشّكل المُغيَّر يُصبح
النّفس الحقيقيّ

201
00:10:16,200 --> 00:10:21,870
تحوّل الآن، فلتولَد من جديد من القوقعة

202
00:10:24,950 --> 00:10:27,200
يفتقر الشّباب للذّوق الجيّد حقّاً

203
00:10:27,330 --> 00:10:29,080
يبدو أنّه يجب عليّ التدخُّل

204
00:10:29,700 --> 00:10:31,250
لحظة. كبير السّحرة لي وان، ماذا تفعل؟

205
00:10:31,330 --> 00:10:32,870
عليّ فقط تركيزي أفكاري

206
00:10:32,870 --> 00:10:34,040
لا أحتاج مُساعدتك-
اثبت مكانك-

207
00:10:34,250 --> 00:10:35,700
دعني أعيد ترتيب وجهك-
!يا للهول-

208
00:10:36,500 --> 00:10:36,870
لا، لا

209
00:10:37,500 --> 00:10:38,450
هوِّن عليّ

210
00:10:44,750 --> 00:10:46,080
من أنت بالضّبط؟

211
00:10:47,250 --> 00:10:48,450
أين رئيس حيّكم؟

212
00:10:49,830 --> 00:10:51,250
أخبريه بأن يخرج إلى هنا حالاً