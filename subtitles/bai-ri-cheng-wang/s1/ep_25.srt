1
00:00:41,910 --> 00:00:44,580
(مُتوّج بعد مئة يوم)

2
00:00:44,580 --> 00:00:46,580
.كافّة العناصر خياليّة .لا تُحاول التّقليد

3
00:00:58,540 --> 00:01:00,500
الملِك لي، لقد عُدت

4
00:01:01,790 --> 00:01:03,000
تأخّرت كثيراً

5
00:01:03,540 --> 00:01:04,910
هل توصّلت إلى أيّ شيء بتحرّياتك؟

6
00:01:05,790 --> 00:01:06,500
أين تشين تيان؟

7
00:01:07,120 --> 00:01:08,370
أرسلتُه للبحث عنك

8
00:01:11,500 --> 00:01:12,370
سامحني يا جلالة الملِك لي

9
00:01:12,750 --> 00:01:13,870
الوضع مُعقَّد

10
00:01:14,750 --> 00:01:16,500
ويشمل تشين تيان بشكل مُباشر

11
00:01:16,870 --> 00:01:18,000
لذا استغرق ذلك بعض الوقت

12
00:01:18,500 --> 00:01:20,040
يشمل تشين تيان؟

13
00:01:21,000 --> 00:01:23,250
رئيس الطبّاخين من الحيّ 9 كان من رجاله

14
00:01:23,500 --> 00:01:26,620
أرادَه تشين تيان في المدينة الملكيّة
أن يُسمّمك أنت والملِكة

15
00:01:26,870 --> 00:01:29,910
عندما رفض، زيّفَ تشين تيان انتحاره

16
00:01:30,000 --> 00:01:31,370
...هل تقصد

17
00:01:32,160 --> 00:01:34,750
بأنّ تشين تيان حاول قتلي؟

18
00:01:35,870 --> 00:01:36,910
أين هو الآن؟

19
00:01:37,620 --> 00:01:40,250
بعد أن اكتشفتُ الحقيقة، حاولَ إسكاتي

20
00:01:40,500 --> 00:01:41,870
أدّى ذلك إلى صِراع بيننا

21
00:01:42,370 --> 00:01:44,790
في النّهاية، تعاملتُ معه شخصيّاً

22
00:01:45,500 --> 00:01:46,120
ماذا؟

23
00:01:46,620 --> 00:01:47,620
قتلته؟

24
00:01:48,000 --> 00:01:49,750
،لم أكشف مُخطّطه ضدّك فقط

25
00:01:50,040 --> 00:01:52,500
اكتشفتُ أيضاً بأنّه يتحكّم بالحيّ 9 و 10 سرّاً

26
00:01:52,750 --> 00:01:54,660
جعلَ فساده الحياة بائسة بالنّسبة للمحلّيّين

27
00:01:58,620 --> 00:01:59,620
لم أتصوّر أبداً

28
00:01:59,870 --> 00:02:01,750
أن يفعل شيئاً كهذا

29
00:02:04,160 --> 00:02:05,120
اتركني حالياً

30
00:02:05,870 --> 00:02:07,000
أحتاج بضع لحظات بمُفردي

31
00:02:16,120 --> 00:02:18,040
يبدو أنّنا أخّرنا ذلك الملِك المُزيّف لي حاليّاً

32
00:02:18,500 --> 00:02:20,620
عليّ أن أصل إلى الحيّ 9 وألتقي بهم

33
00:02:25,160 --> 00:02:26,750
هل عدن للتو من الحيّ 9؟

34
00:02:28,000 --> 00:02:31,250
أنتِ... الفتاة الّتي أخذها لي من الحيّ 9

35
00:02:33,750 --> 00:02:36,370
هل رأيت شخصاً يُدعى وانغ شياومينغ؟

36
00:02:38,790 --> 00:02:40,620
أتساءل كيف حال أولئك التجّار الآن

37
00:02:41,290 --> 00:02:43,370
رجال الأعمال لا يهتمّون سوى بالأرباح

38
00:02:43,620 --> 00:02:44,750
لا أحد منهم موثوق

39
00:02:45,750 --> 00:02:46,790
،هذا صحيح

40
00:02:47,120 --> 00:02:49,750
لكن المنفعة المُتبادلة تجعل الشّراكة تستمرّ

41
00:02:50,370 --> 00:02:52,750
سيكون ذلك هو المفتاح لتجديد الحيّ 9 و 10

42
00:02:52,870 --> 00:02:55,120
لكن الأولويّة للشّخصيّة مع ذلك

43
00:02:55,160 --> 00:02:57,370
إذاً، هل ينبغي أن نُناقش السّعر
بالنّسبة لصفقتنا؟

44
00:02:57,540 --> 00:02:58,870
أتكلّم عن العمل فحسب

45
00:02:59,120 --> 00:03:00,750
لا نريد خلط الأمر مع المشاعر الشّخصيّة

46
00:03:01,750 --> 00:03:02,870
المشاعر الشّخصيّة؟

47
00:03:03,040 --> 00:03:04,750
اختيار مُثير للكلمات

48
00:03:05,620 --> 00:03:07,750
دعوته للخروج يجعل الأمور غريبة

49
00:03:09,620 --> 00:03:11,870
هل لدينا مشاعر شخصيّة أيضاً؟

50
00:03:12,540 --> 00:03:13,660
انتبه لآداب سلوكك

51
00:03:13,870 --> 00:03:16,540
كيف يختلف هذا عن مُفترس عامّ؟

52
00:03:20,250 --> 00:03:21,540
مياو، ما الخطب؟

53
00:03:22,500 --> 00:03:23,500
هل تعرّضتَ لتعويذة تجميد جسد؟

54
00:03:24,500 --> 00:03:25,500
ما الّذي تنظر إليه؟

55
00:03:33,910 --> 00:03:35,790
مياو، هل أنت بخير؟

56
00:03:37,370 --> 00:03:38,410
لا، لا شيء

57
00:03:39,120 --> 00:03:40,120
أريد الذّهاب لشراء شيء

58
00:03:40,660 --> 00:03:41,750
عودوا جميعاً إلى مكتب الحيّ الحكوميّ أوّلاً

59
00:03:43,120 --> 00:03:43,910
شراء ماذا؟

60
00:03:44,500 --> 00:03:45,040
هيّا بنا

61
00:03:45,250 --> 00:03:46,000
سنعود أوّلاً

62
00:03:47,660 --> 00:03:48,500
يتصرّف بشكل غامض

63
00:04:05,120 --> 00:04:07,620
شياوهونغ، أين طلبي؟ تأخّر كثيراً

64
00:04:08,250 --> 00:04:09,000
سيجهز حالاً

65
00:04:09,250 --> 00:04:10,040
انتظر لحظة فحسب

66
00:04:11,120 --> 00:04:13,290
هل لديك وقت لتجرّع بيرة؟

67
00:04:13,410 --> 00:04:14,870
ينفد صبر الزّبون -
أبي -

68
00:04:15,410 --> 00:04:16,750
أجل، أجل، أعلم

69
00:04:31,120 --> 00:04:32,120
!مرحباً

70
00:04:34,790 --> 00:04:35,250
بئساً

71
00:04:35,870 --> 00:04:37,000
أنا آسفة جدّاً

72
00:04:37,370 --> 00:04:39,620
كنتُ أُحضّر في المطبخ ولم أرك تدخل

73
00:04:40,370 --> 00:04:41,000
تفضّل

74
00:04:41,290 --> 00:04:42,540
كان العمل بطيئاً جدّاً مؤخراً

75
00:04:42,790 --> 00:04:44,000
اجلس أينما شئت فحسب

76
00:04:47,750 --> 00:04:48,790
ماذا تريد أن تأكل؟

77
00:04:49,540 --> 00:04:50,410
مرقة صافية

78
00:04:51,910 --> 00:04:53,370
ما أدراك بهذا الطّبق؟

79
00:04:54,620 --> 00:04:54,910
...أنا

80
00:04:55,370 --> 00:04:57,290
حدّثني صديق عنه منذ مدّة

81
00:04:57,540 --> 00:04:58,870
قال بأنّه الطّعام السّرّي هنا

82
00:04:59,250 --> 00:05:01,160
لذا مررتُ أثناء رحلة عملي

83
00:05:02,410 --> 00:05:04,620
لا بُدّ أنّ شياومينغ يتبجّح ثانية

84
00:05:06,500 --> 00:05:08,250
لكن قد يكون هذا الطّبق بسيطاً

85
00:05:08,790 --> 00:05:10,620
إن لم تُمانع، سأذهب لتحضيره

86
00:05:12,120 --> 00:05:13,000
أتمنّى تجربته حقّاً

87
00:05:13,790 --> 00:05:15,370
حسناً، اجلس لبعض الوقت

88
00:05:20,750 --> 00:05:23,160
شعر داكن، بهذا الطّول تقريباً

89
00:05:23,790 --> 00:05:25,660
واثق تماماً وحادّ الذّكاء

90
00:05:26,370 --> 00:05:27,540
،على ذكركِ للأمر

91
00:05:28,120 --> 00:05:30,410
أظنّني رأيتُ شخصاً كهذا

92
00:05:31,410 --> 00:05:31,910
حقّاً؟

93
00:05:32,410 --> 00:05:33,290
كيف حاله الآن؟

94
00:05:33,540 --> 00:05:34,160
هل هو بخير؟

95
00:05:39,500 --> 00:05:40,370
!قادمة، قادمة

96
00:05:41,250 --> 00:05:42,750
آسفة لو تأخّرت

97
00:05:43,290 --> 00:05:43,870
شكراً

98
00:05:45,120 --> 00:05:46,620
لم أعدّ هذا الطّبق منذ مدّة طويلة

99
00:05:47,120 --> 00:05:48,250
لا أدري كيف سيكون مُستواه

100
00:05:48,620 --> 00:05:49,500
آمل أن يُعجبك

101
00:05:54,290 --> 00:05:56,160
لم أكن أعلم بأنّ هذا الطّبق
بهذه الجودة

102
00:06:00,870 --> 00:06:02,370
على مهل. رويداً رويداً

103
00:06:02,750 --> 00:06:03,620
أنت تختنق

104
00:06:04,290 --> 00:06:06,500
هل كنت تتضوّر جوعاً؟ أكلت بسرعة

105
00:06:07,620 --> 00:06:09,040
دعني أحضر لك فوطة مائدة

106
00:06:20,120 --> 00:06:21,750
لا تقلقي. إنّه بخير

107
00:06:22,750 --> 00:06:23,660
يسرّني سماع ذلك

108
00:06:28,040 --> 00:06:30,040
تفضّل. انتهيت، امسح فمك

109
00:06:32,870 --> 00:06:33,790
أين هو؟

110
00:06:41,620 --> 00:06:42,620
تراجعوا. لقد عادوا

111
00:06:43,000 --> 00:06:44,160
يبدو أنّ كُلّ شيء قد تمّت مُعالجته

112
00:06:44,870 --> 00:06:45,870
أين تشين تيان؟

113
00:06:46,160 --> 00:06:48,620
هل ما زال سيستهدفنا؟ -
لن يهدّدكم ثانية أبداً -

114
00:06:49,370 --> 00:06:52,910
فضلاً عن ذلك، ستتولّى الآنسة هوانغ منصباً
في مكتب الحيّ الحكوميّ

115
00:06:54,410 --> 00:06:56,370
آنسة هوانغ؟ بالطّبع، نعرفها خير معرفة

116
00:06:56,870 --> 00:06:59,910
إذاً تقصدين بالقول بأنّ السّيّد تشين
تين قد انهزم؟

117
00:07:00,370 --> 00:07:02,870
هل هذا يعني بأنّ الحيّ 9 يستطيع
أخيراً أن يكون مُستقلّاً؟

118
00:07:03,620 --> 00:07:06,040
!بجدّية؟ لان، أخبرينا بما حدث

119
00:07:06,410 --> 00:07:08,370
أجل! أين ذلك الفتى، مياو؟

120
00:07:08,540 --> 00:07:10,040
هل كان هو من أسقطَ تشين تيان؟

121
00:07:18,370 --> 00:07:19,660
إنّه الملِك لي

122
00:07:20,870 --> 00:07:25,500
.الملِك لي! تحيّاتي يا جلالة الملِك لي
نُقدّم أسمى احترامنا

123
00:07:29,620 --> 00:07:33,120
ذلك الطّفل لونغ أو كان يُخفي
شيئاً في نهاية المطاف

124
00:07:34,370 --> 00:07:37,120
لماذا... الملِك لي هنا؟

125
00:07:37,660 --> 00:07:41,120
أخبرني، ماذا حدث هنا بالضّبط؟

126
00:07:41,870 --> 00:07:43,620
أين رئيس الحيّ 9؟

127
00:07:44,790 --> 00:07:47,620
قُتِل بواسطة تشين تيان

128
00:07:48,910 --> 00:07:50,000
من أنت؟

129
00:07:50,540 --> 00:07:55,040
جلالة الملِك لي، أنا رئيس الحيّ 10

130
00:07:55,370 --> 00:07:58,620
لطالما كنّا عبئاً. شكراً على صبرك

131
00:07:59,040 --> 00:08:03,500
لكن يجب أن تفهم، كان كُلّ ذلك بسبب تشين تيان
وذلك القمامة من الحيّ 9

132
00:08:03,540 --> 00:08:04,620
،كبير السّحرة لي وان

133
00:08:05,000 --> 00:08:06,000
ما مُشكلتك؟

134
00:08:06,120 --> 00:08:07,870
ضغطوا على سكّان كِلا الحيّين

135
00:08:08,040 --> 00:08:11,000
ثمّ قبل بضعة أيّام، قاتلوا ومات واحد

136
00:08:11,290 --> 00:08:14,250
والآخر قُبِض عليه بواسطة السّيّد لونغ أو

137
00:08:14,290 --> 00:08:15,540
وأُعدِمَ فوراً

138
00:08:19,160 --> 00:08:22,250
آسف، تملّكني غضبٌ مُبرَّر

139
00:08:23,500 --> 00:08:24,620
كلام فارغ تماماً

140
00:08:25,870 --> 00:08:26,750
،مُجرّد رئيس حيّ

141
00:08:27,250 --> 00:08:29,370
كيف يجرؤ على تحدِّي تشين تيان؟

142
00:08:31,250 --> 00:08:33,370
لأنّ لديهما طفل

143
00:08:34,000 --> 00:08:34,870
هذا هو

144
00:08:38,000 --> 00:08:41,120
تقصد بأنّ رئيس الحيّ 9 وتشين
تيان تجمعها علاقة

145
00:08:41,370 --> 00:08:42,620
وهو ابنهما؟

146
00:08:43,500 --> 00:08:44,120
أجل، أجل، تماماً

147
00:08:44,500 --> 00:08:45,250
يمكننا أن نشهد على ذلك

148
00:08:45,500 --> 00:08:47,250
الجميع في الحيّ 9 يعلمون

149
00:08:47,500 --> 00:08:49,910
هذا أمرٌ معروف، وليس سرّاً

150
00:08:50,120 --> 00:08:51,870
كبير السّحرة لي وان، أنت رهيب

151
00:08:52,250 --> 00:08:54,500
تختلق والدَين لي بشكل مُفاجئ

152
00:09:05,120 --> 00:09:08,290
لماذا نظرتك مليئة بهذه الكراهية؟

153
00:09:08,870 --> 00:09:10,870
تخلّى عنّا ذلك الرّجل حالما وُلِدتُ

154
00:09:11,870 --> 00:09:14,870
والآن، سأستعيد كُلَّ ما فقدتُه

155
00:09:15,540 --> 00:09:17,500
تريد تولّي زمام الأمر كرئيس حيّ؟

156
00:09:18,000 --> 00:09:19,120
ما الّذي يجعلك مُؤهّلاً؟

157
00:09:20,370 --> 00:09:21,870
رأيتُ هذا الشّابّ يكبر وينضج

158
00:09:22,000 --> 00:09:24,500
إنّه قويّ. التّلميذ تفوّق على المُعلّم

159
00:09:32,750 --> 00:09:35,790
أريد حقّاً القضاء عليه بلكمة واحدة

160
00:09:36,540 --> 00:09:37,120
ابقَ هادئاً

161
00:09:57,660 --> 00:09:59,620
شعرتُ بنيّة القتل منك

162
00:10:00,120 --> 00:10:00,790
جيّد

163
00:10:01,750 --> 00:10:05,660
في هذه الحالة، سأمنحك فُرصة لإثبات نفسك

164
00:10:05,910 --> 00:10:08,500
غداً، ادخل تقييم رئيس الحيّ؟

165
00:10:10,790 --> 00:10:12,040
تقييم رئيس الحيّ؟

166
00:10:16,290 --> 00:10:17,160
ما رأيك؟

167
00:10:17,750 --> 00:10:19,450
هل اتّخذت قرارك؟

168
00:10:29,540 --> 00:10:31,370
‏75 يوم