1
00:00:43,470 --> 00:00:45,220
،بعد يومين

2
00:00:45,220 --> 00:00:48,750
لإيجادِ المُنشأة باستخدامِ الذكريات
،من أحلامي

3
00:00:48,750 --> 00:00:51,560
ذهبنا إلى أكاديميّة هيكيهو

4
00:00:51,910 --> 00:00:53,960
لم نجد أحداً هناك

5
00:00:54,370 --> 00:00:56,660
قال المحقِّق أنّه سيتولّى أمر ذلك

6
00:00:57,390 --> 00:01:00,410
خرجَ مياشيرو إلى العلنِ كما لو أنّه
ينتمي إلى هذا المكان

7
00:01:00,410 --> 00:01:02,140
وأغضبني هذا كثيراً

8
00:01:04,250 --> 00:01:08,620
لماذا حاولَ قتل نونو كوروسو بعد
زهق روح أخته؟

9
00:01:08,620 --> 00:01:10,070
سألتُه ذلك

10
00:01:10,820 --> 00:01:13,530
لكنّه لم يُجبني

11
00:01:14,450 --> 00:01:18,180
بدأتُ أشعر أنّ معلوماتي عنه تقلّ
شيئاً فشيئاً

12
00:01:21,640 --> 00:01:25,500
أخبرَتْني كونوساتو-سان أنّ مرضى
مُتلازِمة طفل الفوضى

13
00:01:25,500 --> 00:01:29,400
كانوا تحت تأثير شيء يُدعى
تزامُن الوهم

14
00:01:31,360 --> 00:01:36,110
خلَقوا حاسّةَ بصر وسمع وحتّى لمس مُزيّفة

15
00:01:36,110 --> 00:01:39,820
تشاركوها ليغمسوا أنفسهم
في عالمٍ من الأوهام

16
00:01:41,280 --> 00:01:45,540
وكان مياشيرو الشّخص الوحيد الذي عاد
من ذلك

17
00:01:45,950 --> 00:01:50,730
موجاته الدماغيّة قد أثّرَتْ بأولئك القريبين منه

18
00:01:51,420 --> 00:01:56,180
وجعلَهم يُدرِكون أنَّ التوتُّر الذي سبّبَه
الزلزال قد سرّعَ في شيخوخةِ أجسادهم

19
00:01:57,880 --> 00:02:02,760
نتيجة ذلك، وضعَتْهم الفجوةُ بين الحقيقةِ
وأوهامهم في غيبوبة

20
00:02:02,760 --> 00:02:06,350
لكن وصفَتْها كونوساتو-سان بفترةٍ
ضروريّةٍ للراحة

21
00:02:09,200 --> 00:02:13,790
وهكذا قرّرَتْ هي وفريقُها أنّه كان هُناك‏
أمل لهذا السّبب

22
00:02:13,790 --> 00:02:15,900
قرّروا أن يستخدموا موجات مياشيرو الدماغيّة

23
00:02:15,900 --> 00:02:22,840
للكشفِ عن الحقيقةِ لكافّة المرضى في شيبويا‏
والغارِقين في أوهامهم

24
00:02:22,840 --> 00:02:26,160
وإجبارهم على الخضوعِ لفترةٍ من الرَّاحة‏
قبل العودةِ إلى المُجتمع

25
00:02:26,540 --> 00:02:28,940
كان ذلك الخيار الذي اتّخذوه

26
00:02:29,740 --> 00:02:33,550
اعتقدتُ أنّ هذا سيُساعد أصدقائي

27
00:02:33,550 --> 00:02:37,340
يجب منعه من النّومِ بسببِ العقار
،المُوازِن لموجاته الدماغيّة

28
00:02:37,340 --> 00:02:40,420
لهذا وافقتُ بتردّد على مُراقبتِه

29
00:02:43,100 --> 00:02:43,930
ماذا؟

30
00:02:44,220 --> 00:02:45,490
لا شيء

31
00:02:45,490 --> 00:02:48,180
طُلِبَ منّي أن أستمرّ في التكلُّمِ معك
كي لا تنام

32
00:02:49,380 --> 00:02:51,120
ما هذه الآلة؟

33
00:02:51,120 --> 00:02:53,080
ماذا ستفعل بها؟

34
00:02:56,280 --> 00:02:57,390
لا تقلقي

35
00:02:57,390 --> 00:02:59,570
لقد بدأ المسح للتو

36
00:03:00,190 --> 00:03:04,580
سيستخدمونها ليأخذوا موجاتي الدماغيّة
وينشئوا صورةً بها

37
00:03:05,870 --> 00:03:07,830
ما هذه الصّورة؟

38
00:03:08,090 --> 00:03:12,290
يُزعَم أنَّ الفرق بيني وبين المرضى الآخرين
يكمن في أشكالِ موجتنا الدماغيّة

39
00:03:12,890 --> 00:03:15,510
وهذا هو سبب تمكُّني من العودة

40
00:03:16,240 --> 00:03:21,450
هنالك صورةٌ خاصّةٌ تجعلُ المرضى يمرضون
عندما يرونها

41
00:03:22,220 --> 00:03:25,510
كونوساتو-سان وأنا أخذنا الفكرةَ من ذلك

42
00:03:26,030 --> 00:03:29,520
اعتقدنا أنّ بمقدورِنا إنشاء صورة
بحيث إن رأوها

43
00:03:30,120 --> 00:03:32,900
سيُولِّدون نفس الموجات الدماغيّة
التي أولّدها أنا

44
00:03:33,450 --> 00:03:35,210
،إن استخدمناها

45
00:03:35,210 --> 00:03:39,290
بمقدورِنا تغيير موجات المرضى الدماغيّة
لتُصبِح كموجاتي

46
00:03:39,790 --> 00:03:42,910
ينبغي لهذا أن يُعيدهم إلى الحقيقة

47
00:03:43,220 --> 00:03:45,780
أهذا مُمكنٌ حقّاً؟

48
00:03:46,230 --> 00:03:47,740
أجل

49
00:03:47,740 --> 00:03:50,540
البيانات وبرامِج الحاسوب التي نحتاجُها موجودةٌ هنا

50
00:03:51,170 --> 00:03:54,660
،إن كنتَ تمتلِكُ هذه الموجات الدماغيّة الخاصّة

51
00:03:54,660 --> 00:03:57,170
فكيفَ أصبحتَ مريضاً في الأساس؟

52
00:03:57,640 --> 00:04:00,410
في البداية، لم أكن أمتلكها

53
00:04:00,790 --> 00:04:04,640
أنشأتُها بعدَ الاستسلامِ للمُتلازِمة

54
00:04:05,040 --> 00:04:06,140
لماذا؟

55
00:04:06,470 --> 00:04:10,790
لأنّ كافّة مرضى مُتلازِمة طفل الفوضى

56
00:04:10,790 --> 00:04:14,880
خضعوا لمشهدٍ جحيميّ أثناء زلزال شيبويا

57
00:04:15,380 --> 00:04:17,130
ولم يتوقّع أحدٌ أن يكون حقيقيّاً

58
00:04:18,470 --> 00:04:20,810
"لا يُمكِن لهذا أن يكون حقيقيّاً"

59
00:04:21,310 --> 00:04:24,920
.مُحال أن أمرّ بشيء كهذا"
"لا بدّ وأنّه خطأ ما

60
00:04:24,920 --> 00:04:27,330
وتفاعلَ ذلك مع الضوء الأبيض

61
00:04:27,330 --> 00:04:28,910
الضوء الأبيض؟

62
00:04:29,210 --> 00:04:34,940
من بينهم، أولئك الذين تعرّضوا لصدمةٍ قويّة
أو توتّر شديد اكتسبوا قوى خاصّة

63
00:04:35,810 --> 00:04:38,440
،لم ينالوا الرّضا من الهربِ إلى أوهامهم

64
00:04:38,440 --> 00:04:41,420
فحاولوا تعديلَ حقيقتهم المُؤلِمة بحدِّ ذاتها

65
00:04:41,990 --> 00:04:44,400
لهذا اكتسبوا قِواهم

66
00:04:45,320 --> 00:04:47,110
أي قوى؟

67
00:04:47,110 --> 00:04:48,350
عمّاذا يتكلّم؟

68
00:04:48,620 --> 00:04:52,810
كنتُ الأكثر جبناً من بين كافّة أصحاب القِوى

69
00:04:53,080 --> 00:04:54,480
،كانت الحقيقة مُؤلمة للغاية

70
00:04:54,980 --> 00:04:57,320
لدرجة أنّني أخذتُ الشّخص
...الذي كان بجانبي دوماً

71
00:05:04,590 --> 00:05:06,110
ما-ما الخطب؟

72
00:05:08,080 --> 00:05:09,050
آسف

73
00:05:09,050 --> 00:05:09,830
لا شيء

74
00:05:15,790 --> 00:05:16,790
وبعد؟

75
00:05:17,760 --> 00:05:18,980
تابع

76
00:05:18,980 --> 00:05:21,340
من كان دوماً إلى جانبِك؟

77
00:05:24,420 --> 00:05:25,720
أعزّ صديقة لي

78
00:05:26,140 --> 00:05:31,100
إذاً حتّى قاتلاً مثلك كان لديه صديقة عزيزة؟

79
00:05:31,860 --> 00:05:32,910
أجل

80
00:05:32,910 --> 00:05:35,490
بفضلِها، أدركتُ في النّهاية

81
00:05:36,020 --> 00:05:40,180
أنّ الحقيقة المُزيّفة ستنهار دوماً
في نهايةِ المطاف

82
00:05:41,040 --> 00:05:47,090
لكن لهذا السّبب كنتُ قادراً على الهرب
من الأوهامِ التي أحاطَتْ بي

83
00:05:47,700 --> 00:05:52,800
المرضى الآخرون لا يملكون صديقاً
يُساعدهم على تحقيقِ ذلك

84
00:05:53,880 --> 00:05:56,370
لا تملُك الحقَّ لقولِ ذلك، صحيح؟

85
00:05:56,640 --> 00:06:00,080
...الأشخاص الذين قتلتَهم كان لديهم أصدقاء

86
00:06:02,580 --> 00:06:04,690
حصلتُ على البياناتِ التي أحتاجُها

87
00:06:04,690 --> 00:06:06,050
أظنّها نجحَتْ

88
00:06:06,790 --> 00:06:07,860
حقّاً؟

89
00:06:11,130 --> 00:06:12,260
!ا-انتظر

90
00:06:12,610 --> 00:06:16,760
هل كانَتْ صديقتك مريضة أخرى؟

91
00:06:16,760 --> 00:06:18,390
ماذا تفعلُ الآن؟

92
00:06:19,330 --> 00:06:21,890
لا، إنّها شخصٌ عاديّ

93
00:06:22,620 --> 00:06:24,360
لكنّها رحلَت الآن

94
00:06:25,980 --> 00:06:29,240
إنّها مفقودةٌ تماماً عن هذا العالم

95
00:06:33,840 --> 00:06:36,790
أيمكنك إصلاح المُتلازِمة الآن؟

96
00:06:37,910 --> 00:06:38,990
كونوساتو-سان؟

97
00:06:43,740 --> 00:06:45,120
أهذه هي إذاً؟

98
00:06:45,120 --> 00:06:46,460
حسناً، يمكننا استخدامها

99
00:06:47,760 --> 00:06:49,180
ماذا؟

100
00:06:49,180 --> 00:06:50,480
...فهِمت

101
00:06:50,480 --> 00:06:51,790
!سرعة مصراع الكاميرا

102
00:06:51,790 --> 00:06:52,460
أجل

103
00:06:52,820 --> 00:06:54,830
،لا تستطيعُ العينُ رؤيتها

104
00:06:54,830 --> 00:06:55,970
لكن يستطيع العقلُ الشُّعور بها

105
00:06:56,150 --> 00:06:57,470
هكذا إذاً

106
00:06:57,470 --> 00:07:00,250
،حتّى لو فوّتَ بعضُ المرضى هذا الفيديو

107
00:07:00,250 --> 00:07:02,850
يمكنُ وضعه ببساطةٍ داخل آخرين

108
00:07:02,850 --> 00:07:04,360
أي فيديو؟

109
00:07:04,360 --> 00:07:06,690
إعلانه عن نيّته بارتكابِ جريمةٍ أخرى

110
00:07:07,990 --> 00:07:12,220
الرّجل الذي ارتكبَ كلّ جرائم القتل تِلك
يُعلِن عن نيّتِه لخرقِ القانون مجدّداً

111
00:07:12,220 --> 00:07:13,780
سيُسارِع مُعظم الناس لمُشاهدته

112
00:07:14,570 --> 00:07:15,500
أجل

113
00:07:16,530 --> 00:07:17,450
،أنتم

114
00:07:17,810 --> 00:07:21,750
ألم تتعلّموا يوماً أنّه لا ينبغي لكم
أن تسرقوا ملكيّات الآخرين؟

115
00:07:23,900 --> 00:07:24,930
كيف؟

116
00:07:26,810 --> 00:07:28,050
أتريد شيئاً؟

117
00:07:28,750 --> 00:07:31,760
أنتِ جريئةٌ أيّتها السّارقة

118
00:07:33,730 --> 00:07:38,060
لمَ لا تبدؤون جميعاً بالجلوس؟

119
00:07:38,060 --> 00:07:39,330
تبدون متوتّرين

120
00:07:41,780 --> 00:07:43,500
هكذا إذاً

121
00:07:43,500 --> 00:07:46,730
أريدكم حتماً أن تعرضوا ذلك على كافّة المرضى

122
00:07:47,090 --> 00:07:48,190
ماذا؟

123
00:07:48,560 --> 00:07:53,170
أوامر اللّجنة تقتضي بالتخلُّص من كافّة
الأشياء الشاذّة

124
00:07:53,170 --> 00:07:55,030
التي تجلَّتْ في شيبويا قبل ستّ سنوات

125
00:07:56,000 --> 00:08:00,250
لذا لا أملُك سبباً لاعتراضِ طريقكم

126
00:08:01,250 --> 00:08:03,300
وماذا كنتَ تفعلُ إلى الآن؟

127
00:08:03,660 --> 00:08:05,110
أجري تجربة

128
00:08:05,110 --> 00:08:08,630
لقد طلبتُ من المسؤولين الكِبار في اللّجنة
أن يعلِّقوا عمليّة تطهير شيبويا الكبيرة

129
00:08:11,020 --> 00:08:13,880
أسمعتِ يوماً بنظامِ العالم الواحد؟

130
00:08:14,800 --> 00:08:17,010
حكومة عالميّة مُوحَّدة

131
00:08:18,060 --> 00:08:22,100
استخدمَ مرضى مُتلازِمة طفل الفوضى
تزامُن الأوهام

132
00:08:22,100 --> 00:08:25,980
ليخلقوا لأنفُسِهم شيبويا مثاليّة مُسالِمة، صحيح؟

133
00:08:26,730 --> 00:08:30,900
كان نسخة مُصغَّرة من نِظامِ العالمِ
الواحد الذي أتصوّره

134
00:08:31,410 --> 00:08:34,670
،مُتجاهلين حقيقةَ شيخوختهم

135
00:08:34,670 --> 00:08:38,840
كلّ هؤلاء النّاس الطيّبون والأغبياء
تخيّلوا أنفسهم سُعداء

136
00:08:39,210 --> 00:08:43,640
أليس هذا تماماً ما يرغبه المرء في طبقةٍ‏
من النّاسِ سوف يحكمها؟

137
00:08:45,060 --> 00:08:49,590
كم من التوتُّر النّاجم عن الاضطهاد والسّرقة
بواسطةِ الطبقة الحاكِمة

138
00:08:49,590 --> 00:08:51,230
يمكن أن تتحمّله الطبقة المحكومة؟

139
00:08:51,230 --> 00:08:54,370
إلى متى يُمكنهم البقاء طيّبين وأغبياء؟

140
00:08:55,230 --> 00:09:00,350
كنتُ سأستخدم الحديقةَ المُسوَّرة والتي هي شيبويا
لإجراءِ تِلك التّجربة

141
00:09:01,880 --> 00:09:04,980
لكن كما تعلمون، لم يكن هُناك ما أفعله

142
00:09:05,790 --> 00:09:09,520
،وقعَتْ عودةُ جنون الجيل الجديد

143
00:09:09,520 --> 00:09:11,510
وانتشرت الفوضى العارِمة في شيبويا

144
00:09:12,250 --> 00:09:17,350
،لكن بالرّغمِ من كلِّ الفوضى في شيبويا المُسالِمة

145
00:09:17,350 --> 00:09:21,540
لم يُحدِث هذا أدنى صدع في أوهامهم المُشترَكة

146
00:09:22,320 --> 00:09:24,530
ومن ثمّ أدركتُ

147
00:09:24,530 --> 00:09:28,990
أنّك إذا أردت سرِقة شجاعة التمرُّد
،من الطبقةِ المحكومة

148
00:09:28,990 --> 00:09:33,420
ما عليك إلّا أن تمنحهم طبقةً أدنى كطعمٍ فقط

149
00:09:33,420 --> 00:09:36,840
وإن فعلت ذلك، يُصبِح الحكّام الحقيقيّون
في دائرةِ الأمان

150
00:09:37,230 --> 00:09:40,510
من السَّهل السّيطرة على النّاس

151
00:09:41,770 --> 00:09:44,210
،وكما ترون

152
00:09:44,210 --> 00:09:48,660
تمكّنتُ من إظهار نتائج حقيقيّة لِلّجنة

153
00:09:49,990 --> 00:09:55,440
لكن يا مياشيرو-كن، أفسدتَ كلّ شيء

154
00:09:58,060 --> 00:10:01,700
لماذا اخترتَ العودة إلى الحقيقة؟

155
00:10:02,190 --> 00:10:05,410
هل يمكنك إعطائي إجابة أقبلُها؟

156
00:10:08,200 --> 00:10:10,180
لا إجابة، صحيح؟

157
00:10:10,180 --> 00:10:13,170
!إذاً سأعيدُك بالقوّةِ إلى أوهامك الآن

158
00:10:16,420 --> 00:10:17,170
ماذا؟

159
00:10:17,370 --> 00:10:18,180
أين؟

160
00:10:18,470 --> 00:10:19,470
من؟

161
00:10:20,150 --> 00:10:21,430
...لا

162
00:10:21,430 --> 00:10:22,760
أعرف كلّ هذا

163
00:10:23,260 --> 00:10:24,350
!هذا غير حقيقيّ

164
00:10:24,640 --> 00:10:25,640
...إنّه

165
00:10:26,080 --> 00:10:28,520
لأنّني رأيتُه

166
00:10:28,910 --> 00:10:30,860
ما أنا؟

167
00:10:32,330 --> 00:10:33,350
توقّف

168
00:10:33,910 --> 00:10:36,320
هلّا ابتعدت عن طريقي؟

169
00:10:39,110 --> 00:10:40,740
أ-أونوي، هل أنت بخير؟

170
00:10:40,740 --> 00:10:42,200
أ-أجل

171
00:10:42,370 --> 00:10:44,610
هذا أصعب ممّا توقّعت

172
00:10:44,610 --> 00:10:47,610
،كانت لديك القوّة للقيامِ بكلّ هذا

173
00:10:47,610 --> 00:10:49,670
فلماذا تخلّيتَ عنها؟

174
00:10:50,710 --> 00:10:55,050
لأنّها كانت الطريقة الوحيدة كي أعوّضها

175
00:10:55,950 --> 00:10:59,350
لا يمكننا التغيُّر أبداً سويةً

176
00:10:59,870 --> 00:11:03,680
لكن لأنّنا مفترِقان، هي وأنا لن نرتكب
تِلك الأخطاء ثانية

177
00:11:04,300 --> 00:11:07,430
أمّا ما عدا ذلك فسوف يبدأ
كلّ شيء من الصّفر مجدّداً

178
00:11:07,760 --> 00:11:09,580
فلندعه يبدأ من الصّفر مجدّداً

179
00:11:09,580 --> 00:11:11,210
أين المُشكلة في ذلك؟

180
00:11:11,210 --> 00:11:16,690
لا يجوز للرجُل أن يعيش حياتَه
!مُتشبِّثاً بالفتاةِ التي يحبُّها

181
00:11:17,600 --> 00:11:18,940
أهذا هو سببُك إذاً؟

182
00:11:19,260 --> 00:11:21,340
أليس هذا سبباً وجيهاً بما يكفي؟

183
00:11:21,340 --> 00:11:23,490
،تعتقدون أنفسكم آلهة

184
00:11:23,490 --> 00:11:25,660
لهذا لا يمكنكم فهم مشاعِر النّاس
!هذا كُل ما في الأمر

185
00:11:25,900 --> 00:11:29,100
أنتَ غريبٌ حقّاً يا مياشيرو-كن

186
00:11:29,100 --> 00:11:31,290
...تتخلّى عن قوّتِك

187
00:11:31,480 --> 00:11:33,250
جرّبني إذاً

188
00:11:35,480 --> 00:11:36,250
أجرّبك؟

189
00:11:36,800 --> 00:11:40,730
كان بمقدورِك قتلي في أي وقتٍ أردت

190
00:11:41,160 --> 00:11:43,890
فلِمَ لا تجرّبني أكثر قليلاً؟

191
00:11:44,670 --> 00:11:46,700
،إذا كان ما تقوله صحيحاً

192
00:11:46,700 --> 00:11:48,890
فسوف أعود يوماً ما، صحيح؟

193
00:11:49,410 --> 00:11:53,400
لكن إن كنتُ مُحِقّاً فلن أعود أبداً

194
00:11:53,940 --> 00:11:56,760
لمَ لا تجرّبني؟

195
00:11:59,600 --> 00:12:02,950
،إذا عدتُ إلى كوني غيغالومانياك

196
00:12:02,950 --> 00:12:05,160
فسأساعدك قدرَ ما تشاء

197
00:12:05,580 --> 00:12:07,580
يمكنُك أن تنالَ المجدَ كلّه لنفسِك

198
00:12:07,910 --> 00:12:11,540
تريدُ إذاً أن تلعبَ لعبةً معي‏
مُقدِّماً نفسك كجائزة؟

199
00:12:11,810 --> 00:12:12,970
أجل

200
00:12:12,970 --> 00:12:15,090
لكن بالطبع، لن أخسر

201
00:12:15,600 --> 00:12:18,420
لن أعتمد على قوّتي ثانية

202
00:12:18,920 --> 00:12:20,500
لن أضطرّ لذلك

203
00:12:21,780 --> 00:12:23,170
،مياشيرو-كن

204
00:12:23,170 --> 00:12:25,280
أنت مثيرٌ للاهتمام

205
00:12:25,280 --> 00:12:26,500
عُلِم

206
00:12:26,500 --> 00:12:29,480
سألعب لُعبتك

207
00:12:29,480 --> 00:12:31,900
لنبدأها حالاً

208
00:12:34,510 --> 00:12:35,790
...أونوي-سان

209
00:12:35,790 --> 00:12:37,250
ما-ماذا؟

210
00:12:37,710 --> 00:12:39,110
شكراً لإيضاحكِ لنا هنا

211
00:12:39,610 --> 00:12:41,490
آسف لإخافتكِ

212
00:12:41,930 --> 00:12:43,270
أنتِ بخير الآن

213
00:12:44,840 --> 00:12:46,330
...لكن

214
00:12:46,760 --> 00:12:49,060
هذا عملُنا الآن

215
00:12:50,180 --> 00:12:50,860
...لذا

216
00:13:14,720 --> 00:13:17,060
...اليوم

217
00:13:17,400 --> 00:13:20,650
!أكره أمثالك

218
00:14:15,380 --> 00:14:17,830
...في هذا المكان أنا

219
00:14:22,670 --> 00:14:23,750
...توقّف

220
00:14:24,350 --> 00:14:25,510
...تاكو

221
00:14:25,830 --> 00:14:27,230
لن أقتلكِ

222
00:14:27,680 --> 00:14:28,860
هذا واضحٌ لديكِ، صحيح؟

223
00:14:29,220 --> 00:14:31,010
!أفضّل أن تفعل

224
00:14:32,040 --> 00:14:34,390
لماذا تقولين هذا؟

225
00:14:34,680 --> 00:14:37,440
!لا! لا أريد أن أكون مثلهم

226
00:14:39,560 --> 00:14:42,530
!لا تتذرّع بسببي للعيشِ بعيداً

227
00:14:42,530 --> 00:14:45,560
لقد قرأتُ عقولَ كثير من النّاس
!منذُ وِلادتي

228
00:14:45,560 --> 00:14:47,480
!كلّهم حائرون وقلِقون

229
00:14:47,480 --> 00:14:50,030
!لا أصدّق أنّهم يعيشون بهذا الشّكل

230
00:14:50,270 --> 00:14:52,110
كيف لهم أن يبتسموا؟

231
00:14:52,110 --> 00:14:55,600
!لا يعلمون حتّى لماذا يفعلون ذلك

232
00:14:55,600 --> 00:15:01,380
!لا أريد... لا أريد أن أكون طبيعيّة

233
00:15:03,840 --> 00:15:04,670
لا

234
00:15:05,030 --> 00:15:07,360
ستكونين فتاة طبيعيّة

235
00:15:07,760 --> 00:15:10,700
...توقّف... أرجوك

236
00:15:11,470 --> 00:15:13,340
...أرجوك

237
00:15:13,340 --> 00:15:16,010
...دعني

238
00:15:16,760 --> 00:15:19,520
!دعني أساعدك للأبد

239
00:15:21,870 --> 00:15:24,530
حان الوقت. وداعاً

240
00:15:24,890 --> 00:15:28,590
!تاكو

241
00:15:30,760 --> 00:15:35,020
لأنّها كانت الطريقة الوحيدة كي أعوّضها

242
00:15:36,080 --> 00:15:39,330
لا يمكننا التغيُّر أبداً سويةً

243
00:15:39,940 --> 00:15:44,080
لكن لأنّنا مفترِقان، هي وأنا لن نرتكب
تِلك الأخطاء ثانية

244
00:15:44,080 --> 00:15:49,380
لا يجوز للرجُل أن يعيش حياتَه
!مُتشبِّثاً بالفتاةِ التي يحبُّها

245
00:15:53,510 --> 00:15:55,390
لا أتحسّر على شيء

246
00:15:56,300 --> 00:15:59,610
لا أتحسّر على ما فعلت

247
00:16:00,270 --> 00:16:01,730
أنا راضٍ

248
00:16:02,830 --> 00:16:03,940
صديقتي الأعزّ

249
00:16:05,260 --> 00:16:07,790
لا، كانَتْ فتاة طبيعيّة

250
00:16:08,480 --> 00:16:10,030
لكنّها رحلَت الآن

251
00:16:11,190 --> 00:16:14,230
إنّها مفقودةٌ تماماً عن هذا العالم

252
00:16:51,990 --> 00:16:55,440
!شكراً على الطعام

253
00:16:55,440 --> 00:16:56,570
شكراً على الطعام

254
00:16:57,930 --> 00:17:00,640
صوتكِ جميلٌ جدّاً يا هانا

255
00:17:00,640 --> 00:17:03,680
كان ينبغي أن تُسمعينا إيّاه مُسبقاً

256
00:17:03,680 --> 00:17:05,880
بارفية شوكولاتة حجم كبير جدّاً

257
00:17:06,770 --> 00:17:08,920
هذه عدوّة الفتيات في كلّ مكان

258
00:17:08,920 --> 00:17:10,880
آمل أن يقدّموها هنا

259
00:17:10,880 --> 00:17:14,730
،حتّى لو لم يكن أحد آخر هنا
لا ينبغي أن تتكلّمي عن هذا

260
00:17:16,300 --> 00:17:19,850
على أي حال، شكراً على قبولِ حقيقتي

261
00:17:22,400 --> 00:17:24,670
عمّاذا تتكلّمين يا سينباي؟

262
00:17:25,160 --> 00:17:27,400
أين يو اليوم؟

263
00:17:27,590 --> 00:17:31,860
ذهبَ إلى المكتبةِ مع أصدقائه
بعد امتحانه الدوريّ

264
00:17:32,940 --> 00:17:35,410
المكتبة؟ في يوم إجازته؟

265
00:17:35,410 --> 00:17:37,320
!لا أستطيع تخيُّله بعد بضع سنوات

266
00:17:37,850 --> 00:17:41,290
يقول أنّه سيصبح محامياً عندما يكبر

267
00:17:41,950 --> 00:17:45,400
...مُحامٍ؟ بالنسبة لفتى، هذه مُبالغة

268
00:17:45,400 --> 00:17:49,350
أين إيتو-سينباي ومياشيرو-سينباي؟

269
00:17:55,030 --> 00:17:57,130
المعذرة... هل قرأت ذلك؟

270
00:17:57,560 --> 00:17:58,690
أجل

271
00:17:58,690 --> 00:18:02,430
أين يعثر الإعلامُ على كلّ هذا؟

272
00:18:02,430 --> 00:18:03,970
إنّه اليوم، أليس كذلك؟

273
00:18:03,970 --> 00:18:06,350
سيُزَجُّ في السّجن

274
00:18:07,060 --> 00:18:07,810
أجل

275
00:18:08,270 --> 00:18:12,190
...حتّى آخر لحظة، إنّه حقّاً

276
00:18:12,490 --> 00:18:15,430
،طالما بقيَتْ سيريكا بعيدة عنكِ

277
00:18:15,430 --> 00:18:17,510
أريدكِ أن تبتعدي عنها

278
00:18:17,990 --> 00:18:22,970
فإن فعلَتْ، هلّا سامحتِها من فضلِك

279
00:18:23,430 --> 00:18:25,920
وأصبحتِ صديقتها؟

280
00:18:28,720 --> 00:18:32,800
ولا تخبريها أبداً عن ماضيها وماضيّي

281
00:18:34,980 --> 00:18:38,270
لكنّها لم تأتِ إلينا أبداً

282
00:18:38,760 --> 00:18:41,280
ما الذي تفعله الآن يا ترى؟

283
00:18:41,280 --> 00:18:43,080
أتساءل حقّاً

284
00:18:43,080 --> 00:18:44,390
...من يدري

285
00:18:45,850 --> 00:18:47,750
لنذهب

286
00:19:02,830 --> 00:19:04,910
لنذهب ونحضر فيلماً

287
00:19:07,590 --> 00:19:08,870
!لا

288
00:19:08,870 --> 00:19:13,290
كنتُ أحاول أن أحرص على ألّا
تغدو الأجواء هكذا اليوم

289
00:19:13,290 --> 00:19:15,410
كنتِ؟

290
00:19:15,410 --> 00:19:20,060
وإلّا ما كنتُ لأمسك بيدكِ، أنتِ
لستِ حبيبي حتّى

291
00:19:20,060 --> 00:19:22,370
تقول هذا الكلام الفتاة التي تظلّ تُمسِك
بيدي مؤخّراً

292
00:19:22,370 --> 00:19:24,780
!لا أعلم عمَّن تتحدّثين

293
00:19:24,780 --> 00:19:26,130
حسناً، حسناً

294
00:19:26,130 --> 00:19:28,390
ستأتين معي لحضورِ الفيلم، صحيح؟

295
00:19:29,450 --> 00:19:30,850
!بالتأكيد

296
00:19:31,320 --> 00:19:32,430
ماذا عنكِ يا أوكي؟

297
00:19:32,430 --> 00:19:34,510
أنتِ متفرِّغة الآن، صحيح؟

298
00:19:34,990 --> 00:19:36,170
...أ-أجل

299
00:19:36,170 --> 00:19:38,010
لنذهب، حسناً؟

300
00:19:38,350 --> 00:19:40,860
لحضورِ فيلم مُمتِع إن أمكننا

301
00:19:40,860 --> 00:19:43,090
أريد كِتابة رِسالة لتاكورو

302
00:19:43,090 --> 00:19:45,820
وأخبره أنّنا جميعنا حضرنا فيلماً مُمتعاً

303
00:19:46,220 --> 00:19:47,450
!أنا أيضاً

304
00:19:47,450 --> 00:19:49,110
!سأكتب له رسالةً كلّ يوم

305
00:19:49,110 --> 00:19:50,340
كلّ يوم؟

306
00:19:50,720 --> 00:19:52,580
أظنُّني أفضّل كِتابة رسالة
كلّ يوم أيضاً

307
00:19:53,380 --> 00:19:55,210
أنتما تحبّان أخاكما حقّاً

308
00:19:55,400 --> 00:19:56,380
وهل هذا خطأ؟

309
00:19:56,380 --> 00:19:57,970
أنا فخورةٌ جدّاً بأخي الصّغير

310
00:19:57,970 --> 00:19:59,550
أنا فخورةٌ جدّاً بأخي الكبير

311
00:20:00,560 --> 00:20:01,840
!بسرعة

312
00:20:02,050 --> 00:20:03,220
وإلّا سبقتُكن

313
00:20:09,370 --> 00:20:10,970
!انتظري

314
00:20:10,970 --> 00:20:13,400
...ثمّة فيلم أوصيكن به

315
00:20:13,400 --> 00:20:14,250
ما هو؟

316
00:20:14,250 --> 00:20:18,660
خيارات هانا غبيّة دوماً

317
00:20:18,660 --> 00:20:21,240
!لكن أريد رؤية فيلم مُمتع

318
00:20:22,910 --> 00:20:23,790
تفضّل

319
00:20:27,020 --> 00:20:27,990
حان وقتُ الذهاب

320
00:20:31,530 --> 00:20:33,670
شكراً لكما على كلّ شيء

321
00:20:33,670 --> 00:20:35,330
وآسف على الإزعاج

322
00:20:36,180 --> 00:20:40,290
لا، هذا لا شيء مُقارنة بما مررتَ به

323
00:20:41,640 --> 00:20:44,130
اعتنيا بالجميع

324
00:20:44,540 --> 00:20:45,240
حسناً

325
00:20:45,600 --> 00:20:46,510
أراك ثانية

326
00:20:50,550 --> 00:20:51,430
...مياشيرو

327
00:20:52,160 --> 00:20:54,820
...الأمر ليس بتلك الأهمّية لكن

328
00:20:56,030 --> 00:20:58,030
اسمها وسنّها

329
00:20:58,360 --> 00:21:00,900
لماذا كانَتْ سيريكا أونوي؟

330
00:21:01,460 --> 00:21:03,740
هل كان هُناك معنى وراء سنّها؟

331
00:21:05,220 --> 00:21:09,400
كان اسمُها جِناساً لاسميْ والِديّ

332
00:21:10,140 --> 00:21:14,960
أعتقد أنّني كنتُ فيها أبحثُ عمّا عجزتُ
عن الحصولِ عليه من والديّ

333
00:21:15,280 --> 00:21:18,450
،لكن إن أردتَها أن تكون والدتك

334
00:21:18,890 --> 00:21:20,920
فكان ينبغي أن تكون أكبر منك، صحيح؟

335
00:21:21,380 --> 00:21:25,810
لم أرد أن أعترف أنّني احتجتُ لوالدين

336
00:21:26,960 --> 00:21:31,770
لهذا كان لِزاماً أن تكون فتاة أصغر
أستطيع حِمايتها

337
00:21:33,490 --> 00:21:36,750
كبرياء طفوليّة سخيفة، صحيح؟

338
00:21:39,000 --> 00:21:40,330
هكذا إذاً

339
00:21:40,330 --> 00:21:43,080
لكنّك حميتَها

340
00:21:43,080 --> 00:21:45,400
لم تعُد سخيفة

341
00:22:35,450 --> 00:22:37,930
سيريكا؟

342
00:22:38,880 --> 00:22:40,150
!سيريكا

343
00:22:41,650 --> 00:22:42,500
ماذا؟

344
00:22:46,010 --> 00:22:47,870
ما الخطب؟

345
00:22:47,870 --> 00:22:48,780
من هذا؟

346
00:22:48,780 --> 00:22:49,760
هل تعرفينه؟

347
00:22:54,920 --> 00:22:55,970
لا

348
00:22:56,940 --> 00:22:58,370
لا أعرفه

349
00:23:03,090 --> 00:23:06,340
أجل، لا أعرفكِ أيضاً

350
00:23:08,530 --> 00:23:12,120
لمعَ الضوءُ في عينيّ عندما
نظرتُ نحو السّماء

351
00:23:12,820 --> 00:23:15,810
نظرتُ للأعلى وذلك كي لا تذرف
الدّموعُ في عينيّ

352
00:23:16,680 --> 00:23:18,260
كانَتْ تِلك دموع السّعادة

353
00:23:18,790 --> 00:23:20,450
هذا ما اعتقدتُه

354
00:23:20,450 --> 00:23:22,120
هذا ما كان عليّ أن أعتقده

355
00:23:22,860 --> 00:23:25,750
كان كلّ شيء للأفضل

356
00:23:27,130 --> 00:23:30,010
لم ألتفِت لها

357
00:23:30,430 --> 00:23:32,060
لن نرى بعضنا الآخر مجدّداً

358
00:23:32,520 --> 00:23:34,970
سنسلك طريقَين لا يتقاطعان أبداً

359
00:23:35,810 --> 00:23:39,480
وهكذا سنعيشُ حياتَنا معاً