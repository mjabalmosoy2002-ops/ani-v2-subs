1
00:00:12,420 --> 00:00:14,490
!كنّا بانتظاركم يا حِدآن كاغا السّوداء

2
00:00:14,490 --> 00:00:16,990
!أجل، أنتم أعظم مكافحي الحرائق في إيدو

3
00:01:59,250 --> 00:02:00,180
ورق؟

4
00:02:00,180 --> 00:02:04,000
إنّهم شمال معبد يوتسويا
.سوفوكوجي، وجنوب أيزن-إن

5
00:02:04,000 --> 00:02:06,900
.إنّها متاجر بائعي ورق يتعاملون مع المعابد

6
00:02:06,900 --> 00:02:09,480
.هنالك العديد من المعابد المشهورة هنا

7
00:02:09,480 --> 00:02:13,640
،وإن بدأت النّار عند متجر الورق
.فسيتحوّل إلى حريق ضخم

8
00:02:13,640 --> 00:02:18,290
لكنّ قضاة المعبد لا يسمحون
.لمكافحي الحرائق بدخول أراضيها

9
00:02:18,290 --> 00:02:21,790
.سندخل حتّى لو استخدمنا القوّة

10
00:02:22,070 --> 00:02:25,780
.يقولون أنّ الحريق كان مفتعلاً على الأرجح

11
00:02:26,070 --> 00:02:28,290
.قد يكون ثعلب النّار

12
00:02:30,720 --> 00:02:35,420
.تهبّ رياح خفيفة نحو الجنوب الغربيّ
.لن يتغيّر اتّجاهها إلاّ بعد 2 توكي

13
00:02:35,420 --> 00:02:39,760
تقع القلعة شرقًا، لكنّ الدّايميو
.في ميتسوكي سيحولون دون اقترابها

14
00:02:39,760 --> 00:02:43,360
أرى أن نتقدّم من جهة الجنوب
.ونعترض مصدر الحريق في يوتسويا

15
00:02:43,560 --> 00:02:46,350
أتقنتَ فنون مكافحة الحرائق
.إتقانًا تامًّا سلفًا

16
00:02:46,760 --> 00:02:47,780
.لنسرع

17
00:02:48,050 --> 00:02:49,740
!حاضر

18
00:02:55,280 --> 00:02:57,580
!الزموا أماكنكم! رشّوا الماء على النّار

19
00:03:09,080 --> 00:03:12,070
.ثمّة شخص ما هنا سلفًا
!إنّهم حِدآن كاغا السّوداء

20
00:03:23,580 --> 00:03:25,740
هل من خطب ما أيّها القائد؟

21
00:03:25,740 --> 00:03:27,340
.لا، لا بأس

22
00:03:27,340 --> 00:03:28,430
.سندخل أيضًا

23
00:03:28,430 --> 00:03:29,350
.حاضر

24
00:03:30,120 --> 00:03:31,360
.سنساعد

25
00:03:31,840 --> 00:03:33,680
الحِدآن الرّثّة؟

26
00:03:34,050 --> 00:03:37,430
سمعتُ بعودتك. أعتقد أنّ مستوى
.قاتل النّار قد تدنّى كثيرًا

27
00:03:37,430 --> 00:03:40,110
...إذا وحّدنا جهودنا، فسرعان ما

28
00:03:40,110 --> 00:03:43,710
هل أنت أعمى؟
.انظر كيف نُبلي حسنًا سلفًا

29
00:03:43,710 --> 00:03:45,990
.لا نريد أن تربكوا إيقاعنا

30
00:03:45,990 --> 00:03:47,780
.لا تحكم علينا بمظهرنا فحسب

31
00:03:47,780 --> 00:03:49,490
وماذا بإمكانكم فعله؟

32
00:03:49,490 --> 00:03:51,990
أراهن أنّكم ستسمحون للمعابد
.والأضرحة بأن تحترق

33
00:03:52,270 --> 00:03:54,370
ماذا قلت؟

34
00:04:00,630 --> 00:04:05,080
تمنح الأولويّة للمعابد والأضرحة؟
ما الّذي احترق غير ذلك؟

35
00:04:05,080 --> 00:04:07,630
—حتّى الآن، جدران ميوكوجي

36
00:04:07,630 --> 00:04:10,130
ليس هذا ما أعنيه! هل تأذّى أيّ أحد؟

37
00:04:10,130 --> 00:04:15,460
تأذّى العديد من النّاس القريبون
.من متجر الورق حيث بدأ الحريق

38
00:04:15,460 --> 00:04:20,650
أيّ مكافح حرائق يعطي الأولويّة للمعابد
.على حساب الأرواح؟ واجبنا هو إنقاذ النّاس

39
00:04:20,650 --> 00:04:22,270
.نحن ساموراي

40
00:04:22,270 --> 00:04:25,910
إنّنا نتصدّى لهذه الحرائق دفاعًا
.عن هيبة الإقطاعيّة وكرامتها

41
00:04:25,910 --> 00:04:29,150
.لدينا قضيّة أعظم لحمايتها على عكسكم أنتم

42
00:04:29,150 --> 00:04:32,210
.لا شيء أكثر أهمّيّة من أرواح النّاس

43
00:04:32,210 --> 00:04:35,670
أين الشّرف في حماية المعابد
بينما يموت النّاس؟

44
00:04:35,670 --> 00:04:39,300
.إنّنا نحمي المعابد وننقد الأرواح قدر المستطاع

45
00:04:39,300 --> 00:04:41,160
.إنّنا لا نقلّل من شأن أرواح النّاس أبدًا

46
00:04:41,980 --> 00:04:43,770
.أولويّتنا هي إنقاذ النّاس

47
00:04:44,070 --> 00:04:48,180
.تجاهلوا كلّ ما يقوله قضاة المعبد
.إن وُجد ما يجب هدمه، فاهدموه

48
00:04:48,180 --> 00:04:48,930
!حاضر

49
00:04:48,930 --> 00:04:52,980
،إذا كانت أولويّتهم هي المعابد
.فأولويّتنا نحن هي المنازل والنّاس

50
00:04:52,980 --> 00:04:54,720
.لا تسمحوا لأيّ أحد بإيقافنا

51
00:04:54,720 --> 00:04:55,710
.سيجورو

52
00:04:58,580 --> 00:05:01,440
.نحن في اليوم 10 من الشّهر 12
.التّوكي الرّابعة والنّصف

53
00:05:05,950 --> 00:05:08,200
.بدأ الحريق في متجر واكويا للورق

54
00:05:08,920 --> 00:05:12,700
.تهبّ الرّياح برفق من الجنوب الشّرقيّ
.انتشر الحريق في كلّ الاتّجاهات

55
00:05:13,100 --> 00:05:16,200
تتولّى عشيرة ياناغيساوا الأمور
.في الجانب الغربيّ ضعيف الحراسة

56
00:05:16,510 --> 00:05:20,460
سنصدّ الحريق من مركز اندلاعه
.لإيقاف تقدّمه جنوبًا

57
00:05:20,460 --> 00:05:22,020
!هيّا بنا. هيكويا

58
00:05:22,460 --> 00:05:24,710
.مهلاً لحظة

59
00:05:38,670 --> 00:05:39,680
!تورا

60
00:05:46,490 --> 00:05:48,350
!هيّا بنا

61
00:06:01,900 --> 00:06:05,140
.ستُشوّه خسارتنا أمام الحِدآن الرّثّة سمعتنا

62
00:06:05,140 --> 00:06:07,010
.أروهم فرق المستوى الّذي بيننا

63
00:06:12,300 --> 00:06:13,960
.بإمكاننا النّجاح

64
00:06:13,960 --> 00:06:18,280
ساورتني شكوك حيال وجود مشاكل
.في التّسلسل القياديّ

65
00:06:18,890 --> 00:06:22,650
لا يوجد هنا إلاّ حِدآن كاغا
،السّوداء وهم من نُخبة إيدو

66
00:06:22,650 --> 00:06:25,400
.والحِدآن الرّثّة الّذين هم الأدنى

67
00:06:25,400 --> 00:06:28,500
لكنّنا لا نختلف عنهم أبدًا
.في الجهد الّذي نبذله

68
00:06:28,500 --> 00:06:32,270
،إذا واصلنا العمل معهم
.فيمكننا حماية المعابد أيضًا

69
00:06:32,270 --> 00:06:36,150
،لكن يجب هدم ذلك الجانب من المعبد

70
00:06:36,150 --> 00:06:38,360
.وإلاّ فستنتشر النّيران أكثر

71
00:06:40,280 --> 00:06:42,130
.أحضر حبلاً وتعال معي

72
00:06:48,920 --> 00:06:50,600
!حسنًا. اسحبوا

73
00:07:03,600 --> 00:07:05,200
.واصلوا

74
00:07:08,940 --> 00:07:12,010
أيّها القائد، يتطاير الورق من
.مكان اندلاع الحريق ثانية

75
00:07:14,800 --> 00:07:18,290
علينا هدم متجر الورق
.وإلاّ فلن ينتهي هذا

76
00:07:18,720 --> 00:07:23,700
،ولكن كيف؟ إنّه يحترق بشدّة
.لا يمكننا إخماد النّار

77
00:07:24,810 --> 00:07:27,010
.لديّ اقتراح

78
00:07:27,010 --> 00:07:29,790
..."قد لا يكون كافيًا ليُسمّى "خطّة

79
00:07:29,790 --> 00:07:30,750
ما هو؟

80
00:07:35,600 --> 00:07:37,020
.يبدو هذا ممتعًا

81
00:07:41,310 --> 00:07:43,470
.مستعدّون للانطلاق في أيّ وقت

82
00:07:48,490 --> 00:07:50,400
.حسنًا، سيفي ذلك بالأمر

83
00:07:50,800 --> 00:07:52,490
.نحن جاهزون أيضًا

84
00:07:54,280 --> 00:07:56,490
إلى أيّ اتّجاه يا سينسي؟

85
00:07:56,720 --> 00:07:58,670
.انتظر قليلاً بعد

86
00:08:05,410 --> 00:08:07,500
.هذا الاتّجاه. ادفع بكلّ قوّتك

87
00:08:07,500 --> 00:08:08,610
.مفهوم

88
00:08:12,750 --> 00:08:15,380
!النّجدة أيّها السّاموراي

89
00:08:16,510 --> 00:08:20,880
!ابنتي... إنّ ابنتي أوشيتشي ما زالت هناك

90
00:08:21,290 --> 00:08:24,710
!ماذا؟ لكنّ الجرس يتدحرج سلفًا

91
00:08:24,710 --> 00:08:27,170
!أنقذوها رجاءً

92
00:08:27,170 --> 00:08:28,520
!رجاءً

93
00:08:29,150 --> 00:08:30,370
.مفهوم

94
00:08:30,910 --> 00:08:33,760
.شينّوسكي، أنت المسؤول

95
00:08:33,760 --> 00:08:35,920
.سأدخل لإنقاذ الفتاة

96
00:08:39,130 --> 00:08:40,410
.لكنّ هذا جنونيّ

97
00:08:40,410 --> 00:08:44,350
!الدّخول إلى هناك أشبه بالانتحار

98
00:08:58,240 --> 00:08:59,940
!سألتهم هذه النّيران

99
00:09:04,430 --> 00:09:05,500
!أيّها القائد

100
00:09:05,980 --> 00:09:07,740
!سُحقًا

101
00:09:11,740 --> 00:09:12,890
!أوشيتشي

102
00:09:18,950 --> 00:09:21,260
.لن تلتهميني

103
00:09:21,260 --> 00:09:22,740
.أنا قاتل النّار

104
00:09:22,740 --> 00:09:24,550
!أنا من سيلتهمك

105
00:09:34,970 --> 00:09:38,340
!أوشيتشي

106
00:09:36,120 --> 00:09:37,270
!أنا هنا لإنقاذك

107
00:09:39,070 --> 00:09:40,930
.النّجدة

108
00:09:42,600 --> 00:09:44,990
!إنّه قادم! استعدّوا

109
00:09:50,990 --> 00:09:52,440
.أنت بخير الآن

110
00:09:56,480 --> 00:09:59,240
!لا تدعه يسحقك

111
00:10:08,380 --> 00:10:09,740
...المتجر

112
00:10:10,200 --> 00:10:12,330
!أيّها القائد

113
00:10:15,670 --> 00:10:18,560
.لا أصدّق أنّه دخل إلى هناك

114
00:10:18,560 --> 00:10:20,680
...لا بدّ أنّ القائد

115
00:10:24,710 --> 00:10:25,670
!هناك

116
00:10:29,460 --> 00:10:32,800
،لو كان الجرس أكبر
.لكان مريحًا أكثر من هذا

117
00:10:33,270 --> 00:10:34,970
.لكن لا داعي للتّذمّر الآن

118
00:10:39,800 --> 00:10:42,200
!أيّها القائد! أنت بخير؟

119
00:10:42,200 --> 00:10:45,200
.نعم. خذوها إلى طبيب في الحال

120
00:10:51,350 --> 00:10:52,820
هل أنت بخير؟

121
00:10:52,820 --> 00:10:54,860
.نعم. شكرًا لك

122
00:11:00,020 --> 00:11:02,270
!بقي القليل فقط يا رفاق

123
00:11:02,270 --> 00:11:04,470
!التهموا كلّ النّيران المتبقّية

124
00:11:20,140 --> 00:11:21,220
.أيّها القائد

125
00:11:21,860 --> 00:11:25,700
لماذا قمتَ بفعل متهوّر كهذا؟
أتريد الموت هباءً؟

126
00:11:26,180 --> 00:11:27,750
.شينّوسكي

127
00:11:28,020 --> 00:11:31,810
.يمكنك إنقاذ الأرواح إن كنتَ حيًّا فحسب

128
00:11:31,810 --> 00:11:37,000
،إن متّ وأنت تحاول إنقاذ شخص ما
.فلا فائدة من كونك مكافح حرائق

129
00:11:38,030 --> 00:11:40,560
.لا يموت مكافح الحرائق هباءً أبدًا

130
00:11:40,560 --> 00:11:45,630
،مهما كان سبب موته
.فقد مات محاولاً إنقاذ الآخرين

131
00:11:45,630 --> 00:11:46,600
...لكن

132
00:11:46,600 --> 00:11:48,400
.اسمع يا شينّوسكي

133
00:11:48,400 --> 00:11:51,770
واجب مكافح الحرائق هو إنقاذ
.الأرواح. ذلك كلّ شيء ببساطة

134
00:11:51,990 --> 00:11:54,760
ولا يهمّ حياة من تكون؟

135
00:11:54,760 --> 00:11:55,630
.نعم

136
00:11:56,000 --> 00:11:59,780
حتّى إن عرفت أنّك ستموت خلال ذلك؟

137
00:12:00,080 --> 00:12:01,250
.هذا صحيح

138
00:12:03,980 --> 00:12:07,290
هل أحكي لك قصّة قديمة؟

139
00:12:07,920 --> 00:12:09,490
قصّة قديمة؟

140
00:12:10,270 --> 00:12:13,750
.إنّها عن والدي وكيف توفّي

141
00:12:17,630 --> 00:12:22,450
.كان ذلك في حريق قبل 15 سنة
.كان مفتعله مكافح حرائق

142
00:12:22,890 --> 00:12:24,780
.كان اسمه إيغامي جينبي

143
00:12:24,780 --> 00:12:28,480
،كان أفضل مكافح حرائق في إيدو آنذاك
.وكان مثلي الأعلى أيضًا

144
00:12:28,920 --> 00:12:32,490
،لكن مهما كانت الأسباب
.فقد افتعل حريقًا

145
00:12:32,490 --> 00:12:34,430
.ولا مبرّر لذلك أبدًا

146
00:12:35,340 --> 00:12:36,240
.نعم

147
00:12:36,670 --> 00:12:41,330
.مات والدي محاولاً إنقاذه

148
00:12:43,660 --> 00:12:47,940
.شهدتُ على آخر لحظاته بأمّ عينيّ

149
00:12:51,270 --> 00:12:54,450
.غِنغو، خذ المصابين واهرب

150
00:12:54,450 --> 00:12:56,620
.سأنقذه

151
00:12:58,450 --> 00:13:02,360
،ماتسوناغا-دونو
.ما عدت أكنّ حيالك أيّ كراهية

152
00:13:02,360 --> 00:13:05,010
.خذ غِنغو وغادرا المكان. رجاءً

153
00:13:05,010 --> 00:13:06,960
.لا، ليس بعد

154
00:13:06,960 --> 00:13:09,840
.ما عدتُ رفيقك

155
00:13:10,310 --> 00:13:13,970
لست بحاجة للمخاطرة بحياتك
.لإنقاذ شخص شرّير مثلي

156
00:13:13,970 --> 00:13:17,510
واجب مكافح الحرائق
.هو إنقاذ كلّ الأرواح

157
00:13:17,510 --> 00:13:22,980
.حتّى إن كانت لمجرم
.وحتّى إن عنى ذلك موتي أثناء ذلك

158
00:13:25,480 --> 00:13:28,080
.لا يوجد وقت. غادر بسرعة

159
00:13:28,480 --> 00:13:31,990
.آسف لتركك وحدك

160
00:13:34,490 --> 00:13:37,760
.غِنغو، أنت لا تشبهني

161
00:13:37,760 --> 00:13:39,500
.أنقذ الكثير من النّاس

162
00:13:39,500 --> 00:13:41,680
.لا. قل أنّي أشبهك

163
00:13:42,150 --> 00:13:43,650
.أنا ضعيف

164
00:13:45,580 --> 00:13:49,190
.تأتي قوّة المرء من معرفته بضعفه

165
00:13:49,190 --> 00:13:52,010
.ويمكنك أن تصير أقوى إن التهمتها فحسب

166
00:14:09,900 --> 00:14:11,200
.أبي

167
00:14:12,410 --> 00:14:14,590
.غِنغو، لا تستسلم أبدًا

168
00:14:22,180 --> 00:14:23,550
.التهم النّار

169
00:14:41,570 --> 00:14:45,730
لم يكن والدي مكافح الحرائق
.المثاليّ في نظر أيّ أحد

170
00:14:46,180 --> 00:14:49,870
.كان النّاس يسبّونه أحيانًا

171
00:14:50,690 --> 00:14:54,470
.ووقتها، كنت أشعر بالخجل منه

172
00:14:57,530 --> 00:14:59,710
.لكنّي كنتُ مخطئًا

173
00:15:00,570 --> 00:15:05,840
كان والدي مكافح حرائق
.حقيقيّ حتّى النّهاية

174
00:15:07,030 --> 00:15:12,230
،ومنذ موته، كلّما رأيتُ النّيران أمامي

175
00:15:12,230 --> 00:15:14,640
،أرى رؤى عن الأرواح الّتي عجزت عن إنقاذها

176
00:15:15,070 --> 00:15:17,730
.وأدركتُ كم أنّني ضعيف

177
00:15:19,720 --> 00:15:22,830
،وكما قال تمامًا

178
00:15:22,830 --> 00:15:26,020
.تأتي قوّة المرء من معرفته بضعفه

179
00:15:26,430 --> 00:15:29,770
النّاس ليسوا ضعفاء لدرجة
.أن يظلّوا في مكان واحد للأبد

180
00:15:30,350 --> 00:15:34,430
،حتّى إن متّ وأنا أنقذ أحدًا ما

181
00:15:34,910 --> 00:15:39,230
.سيواصل أحد آخر عملي

182
00:15:39,600 --> 00:15:43,260
.لذلك لن أموت هباءً أبدًا

183
00:15:43,750 --> 00:15:48,380
.آسف لأنّي تجاوزت حدودي

184
00:15:48,380 --> 00:15:50,520
.سأبذل جهدي لتذكّر ما قلتَه

185
00:15:50,520 --> 00:15:53,500
.حسنًا. لنعد للعمل إذًا

186
00:15:54,340 --> 00:15:55,260
.حاضر

187
00:15:58,510 --> 00:16:02,330
.لن أقبل بك أبدًا يا قاتل النّار

188
00:16:06,260 --> 00:16:08,910
.انظروا إليهم. إنّهم قذرون

189
00:16:08,910 --> 00:16:10,370
.لا أسلوب لديهم على الإطلاق

190
00:16:10,370 --> 00:16:11,620
لحساب من يعملون؟

191
00:16:11,620 --> 00:16:13,230
.عشيرة توزاوا حسبما سمعت

192
00:16:13,230 --> 00:16:14,790
.مجرّد قرويّين إذًا

193
00:16:14,790 --> 00:16:17,960
سمعتُ أنّهم يُنعتون بالحِدآن
.الرّثّة، لكنّ ذلك مشؤوم

194
00:16:17,960 --> 00:16:22,490
حتّى ملابسي الدّاخليّة أكثر
.نظافة من ملابسهم

195
00:16:23,790 --> 00:16:26,030
!إنّهم الحِدآن الرّثّة

196
00:16:34,780 --> 00:16:37,800
أعلم أنّه لا يمكنني إخباركم
.ألاّ تدعو ذلك يزعجكم

197
00:16:37,800 --> 00:16:41,050
.لكنّ واجب مكافحي الحرائق هو إنقاذ الأرواح

198
00:16:41,050 --> 00:16:43,440
أليست مهاراتنا هي مصدر فخرنا؟

199
00:16:43,750 --> 00:16:47,260
لطالما كان هنالك أشخاص
،يعاملون مكافحي الحرائق كمشاهير

200
00:16:47,260 --> 00:16:49,450
.ويجتمعون حول كلّ حريق بفرح وحماسة

201
00:16:50,060 --> 00:16:52,090
،ثمّة مكافحو حرائق يسعون خلف ذلك

202
00:16:52,090 --> 00:16:54,820
،ويقلقون بشأن أمور تافهة
.مثل مظهرهم

203
00:16:56,940 --> 00:16:59,240
.لكنّ ذلك ليس ما نحن عليه

204
00:16:59,240 --> 00:17:02,590
سأرتدي أوسخ الخِرق إن ساعد
.ذلك على إنقاذ أرواح أكثر

205
00:17:11,080 --> 00:17:12,170
ما الأمر؟

206
00:17:12,660 --> 00:17:15,450
يريد صديقنا كبير المسؤولين
.أن نكون محبوبين

207
00:17:15,450 --> 00:17:16,730
أيمكنك القيام بشيء مبهر؟

208
00:17:16,730 --> 00:17:19,650
.بالطّبع. هذا عملي في النّهاية

209
00:17:20,020 --> 00:17:23,420
.لكن مهما حدث، لا تشتكِ بعد ذلك

210
00:17:24,350 --> 00:17:25,480
.افعل ما يحلو لك

211
00:17:29,720 --> 00:17:31,500
.انتبهوا جميعًا

212
00:17:31,500 --> 00:17:34,370
عدنا نحن مكافحو الحرائق
لدى توزاوا كوجيرو للتّوّ

213
00:17:34,370 --> 00:17:37,860
.من إخماد حريق في متجر الورق

214
00:17:37,860 --> 00:17:39,680
أقلتم أنّنا قذرون؟

215
00:17:39,680 --> 00:17:46,420
بالطّبع، كنّا نكافح النّيران منذ لحظات قليلة
.فحسب. من الطّبيعيّ أن يغطّينا السّخام

216
00:17:46,420 --> 00:17:49,000
ماذا؟ هذا ليس ما تقصدونه؟

217
00:17:51,120 --> 00:17:55,690
،نحن طيور الحِدآن السّوداء لشينجو
.لسنا حِدآنًا عاديّين

218
00:17:55,690 --> 00:17:58,240
.ابدؤوا بمشاهدتي أنا هيكويا

219
00:18:07,010 --> 00:18:11,380
.يصفونني بالصّدى. أنا بهلوانيّ محترف

220
00:18:11,380 --> 00:18:15,310
.أطلب منكم تذكّري وتذكّر ملامحي الوسيمة

221
00:18:17,200 --> 00:18:19,170
أترون الرّجل الضّخم هناك؟

222
00:18:24,680 --> 00:18:26,770
.اسمه توراجيرو

223
00:18:26,770 --> 00:18:28,680
،لقد تقاعد بسبب إصابة

224
00:18:28,680 --> 00:18:33,500
لكنّه مصارع سومو من أعلى مستوى
.واجه داتيغاسيكي الشّهير

225
00:18:33,500 --> 00:18:34,520
!تورا

226
00:18:34,520 --> 00:18:37,110
!يمكنك أن تنزل يدك الآن

227
00:18:38,950 --> 00:18:42,030
.ثمّة أشخاص غريبون حتّى بين السّاموراي

228
00:18:42,030 --> 00:18:45,460
خذوا حكيمنا العظيم كاجي سيجورو
.على سبيل المثال

229
00:18:47,480 --> 00:18:49,580
أترون شعره الأحمر؟

230
00:18:49,580 --> 00:18:53,650
إنّها علامة على أنّه مُنح قوى
.من الآلهة منذ سنّ صغيرة

231
00:18:53,650 --> 00:18:57,830
.تنبؤاته لحركة السّماء لا تخطئ أبدًا

232
00:18:57,830 --> 00:19:01,450
.إنّه عالِم الفلك المثاليّ لعشيرة توزاوا

233
00:19:01,990 --> 00:19:05,370
.والتّالي هو نائب قائدنا

234
00:19:07,100 --> 00:19:09,870
.في الحقيقة، يمكننا تجاوز هذا الرّجل

235
00:19:13,720 --> 00:19:17,240
.إنّه يافع ولا يزال يتعلّم

236
00:19:17,240 --> 00:19:20,360
.لكنّه فتى وسيم وطيّب

237
00:19:20,360 --> 00:19:23,370
.لن تندموا أبدًا إن راقبتموه من الآن

238
00:19:27,530 --> 00:19:30,770
.يبدو أنّ الكلاب تحبّه سلفًا

239
00:19:32,890 --> 00:19:36,770
.كلّ ما نتمنّاه الآن هو تحبّوه أيضًا

240
00:19:37,170 --> 00:19:41,520
.وذات يوم، سيكون أعظم مكافح حرائق
.إنّه توريغوي شينّوسكي

241
00:19:45,530 --> 00:19:47,870
.يا سيّدتي الّتي تحمل فجلاً

242
00:19:47,870 --> 00:19:51,030
.حان وقت الجزء التّالي من العرض

243
00:19:52,670 --> 00:19:55,550
كان هنالك مكافح حرائق شهير
،يُلقّب بقاتل النّار

244
00:19:55,550 --> 00:19:58,440
.أنقذ مدينة إيدو مرّات عدّة

245
00:19:58,440 --> 00:20:02,660
.ولكنّه اختفى قبل ستّ سنوات

246
00:20:03,860 --> 00:20:09,590
لكنّه عاد الآن لحماية
.سكّان إيدو مرّة أخرى

247
00:20:09,910 --> 00:20:14,050
،إنّه قائد فرقتنا لمكافحة الحرائق
!ماتسوناغا غِنغو

248
00:20:22,550 --> 00:20:27,250
اقترب الوقت الّذي قضيناه
.معكم جميعًا من نهايته

249
00:20:27,250 --> 00:20:33,400
كنتُ أودّ منكم أن تتذكّروا أسماء أعضاء
.فرقتنا، لكن ربّما في مناسبة أخرى

250
00:20:36,640 --> 00:20:40,960
ثمّة حرائق لا تُحصى
.كلّ سنة في مدينة إيدو

251
00:20:40,960 --> 00:20:45,560
واثق أنّ هنالك منكم من فقدوا
.أفراد عائلاتهم وأقاربهم

252
00:20:45,560 --> 00:20:47,930
.وقد يكون بينكم من يكرهون النّار

253
00:20:49,810 --> 00:20:54,020
لكنّ النّار جزء لا غنى عنه
.في الحياة اليوميّة

254
00:20:54,020 --> 00:20:56,970
لا يمكن للأمّ إعداد طعام
.ساخن لعائلتها بدونها

255
00:20:56,970 --> 00:21:00,530
لا يمكن للأب السّير في الشّارع
.ليلاً بدون نورها

256
00:21:00,530 --> 00:21:02,940
ولا يمكن حتّى تدفئة ماء
.حمّام أطفالكم بدونها

257
00:21:04,440 --> 00:21:10,390
نحن لا نحمي إيدو فقط، بل نحمي
.النّاس الّذين يعيشون فيها أيضًا

258
00:21:10,390 --> 00:21:13,480
.وللقيام بذلك، لا تهمّنا مظاهرنا أبدًا

259
00:21:13,480 --> 00:21:16,320
،حتّى إن كنّا قذرين ورثّي المظهر

260
00:21:16,320 --> 00:21:18,840
.واجب مكافح الحرائق هو حماية النّاس

261
00:21:18,840 --> 00:21:24,200
اسمعوا، يمكنكم مناداتنا بما تشاؤون
.ما دام ذلك سيساعدكم على تذكّرنا

262
00:21:24,500 --> 00:21:27,500
.قد تكون ملابسنا رثّة، لكنّ قلوبنا نقيّة

263
00:21:27,500 --> 00:21:30,300
.وشجاعتنا لا نظير لها

264
00:21:30,500 --> 00:21:31,840
!أيّها القائد

265
00:21:31,840 --> 00:21:34,450
!ردّد اسمنا بفخر وصوت عالٍ

266
00:21:37,050 --> 00:21:40,320
!نحن طيور حِدآن أوشو الرّثّة

267
00:21:43,670 --> 00:21:45,590
.ماتسوناغا غِنغو-دونو

268
00:21:45,990 --> 00:21:47,430
نعم، ماذا هنالك؟

269
00:21:48,270 --> 00:21:52,800
.انبهرتُ بشجاعتك أثناء الحريق

270
00:21:52,800 --> 00:21:55,630
.لديّ ابنة صغيرة أيضًا

271
00:21:55,630 --> 00:21:58,570
.أتطلّع قُدمًا لمساعيك المستقبليّة

272
00:21:58,820 --> 00:22:00,960
.حقًّا؟ شكرًا لك