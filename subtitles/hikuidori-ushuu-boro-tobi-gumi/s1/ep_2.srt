1
00:00:12,850 --> 00:00:14,670
احتفظتِ به؟

2
00:00:15,530 --> 00:00:18,280
.قلتُ لنفسي أنّك ستحتاجه يومًا ما

3
00:00:19,180 --> 00:00:21,120
.ما عدتُ أحتاجه

4
00:00:21,880 --> 00:00:24,920
.لن يكون من الصّائب ارتداؤه

5
00:00:26,150 --> 00:00:27,670
.فهمت

6
00:01:59,630 --> 00:02:04,570
أوّلاً، سنحتاج لكاسر عوائق
.وحامل راية ومتنبّئ بالرّياح

7
00:02:04,570 --> 00:02:10,610
عفوًا، أنا لا أعرف ما هذه
.الأدوار الثّلاثة بالضّبط

8
00:02:11,180 --> 00:02:13,520
ما نوع الأشخاص الّذين نبحث عنهم؟

9
00:02:13,520 --> 00:02:16,120
لا تعرف حتّى ذلك؟

10
00:02:17,050 --> 00:02:21,170
على الأرجح أنّ كاسر العوائق
.سيكون أسهل دور نشغله

11
00:02:21,170 --> 00:02:23,860
مهمّة كاسر العوائق
،هي هدم المباني بالأدوات

12
00:02:24,150 --> 00:02:26,790
.لذلك فسنحتاج لشخص قويّ البنية

13
00:02:26,790 --> 00:02:29,000
.حسنًا. قويّ البنية

14
00:02:29,420 --> 00:02:32,120
.ولدينا بعد ذلك حامل الرّاية

15
00:02:32,700 --> 00:02:38,790
مهمّة حامل الرّاية هي الرّكض على
.الأسطح والإشارة لأماكن الحرائق

16
00:02:38,790 --> 00:02:41,290
.نحتاج لشخص رشيق ولا يخشى النّار

17
00:02:42,250 --> 00:02:43,480
.فهمت

18
00:02:43,960 --> 00:02:47,500
.ودور المتنبّئ بالرّياح ضروريّ أيضًا

19
00:02:48,190 --> 00:02:50,760
.تُغيّر الرّياح في إيدو اتّجاهها باستمرار

20
00:02:50,760 --> 00:02:52,990
دور المتنبّئ بالرّياح
.هو تنبّؤ اتّجاهها التّالي

21
00:02:52,990 --> 00:02:56,120
بإمكانك وصفه بالاستراتيجيّ
.في مكافحة الحرائق

22
00:02:58,580 --> 00:03:01,990
،أعرف شخصًا بإمكانه شغل هذا الدّور
.لذلك لندعه لوقت لاحق

23
00:03:02,370 --> 00:03:05,660
حسنًا، هل نبدأ بكاسر العوائق إذًا؟

24
00:03:05,920 --> 00:03:07,320
.بكلّ تأكيد

25
00:03:07,320 --> 00:03:09,160
.لننفصل ونبدأ بالبحث

26
00:03:09,540 --> 00:03:10,460
.حاضر

27
00:03:23,810 --> 00:03:26,800
.أعتقد أنّ الأمر لن يكون سهلاً

28
00:03:26,800 --> 00:03:28,370
!إنّه داتيغاسيكي

29
00:03:28,370 --> 00:03:30,240
!داتيغاسيكي

30
00:03:30,550 --> 00:03:31,710
!مذهل

31
00:03:34,830 --> 00:03:36,450
!رائع

32
00:03:38,110 --> 00:03:41,690
.مصارع سومو؟ لم أره من قبل

33
00:03:41,690 --> 00:03:47,210
لم تره من قبل؟ داتيغاسيكي مورييمون
.هو مصارع السّومو الأقرب للقب أوزيكي

34
00:03:53,020 --> 00:03:55,710
.رأيتُ ذلك الرّجل في مكان ما من قبل

35
00:03:56,770 --> 00:04:00,930
.لديّ نزال في شيباجينغو غدًا
.تعال لمشاهدتي

36
00:04:00,930 --> 00:04:01,960
.مرحبًا

37
00:04:02,430 --> 00:04:07,080
.رأيتُ نزالك الأوّل مع أحد مصارعينا البارحة

38
00:04:07,870 --> 00:04:12,600
.آسف. ربّما أكون قد قسوتُ عليه قليلاً

39
00:04:12,600 --> 00:04:16,950
ألا تمانع الفوز بنفس ضربة راحة
اليد كالأغبياء في كلّ مرّة؟

40
00:04:17,370 --> 00:04:18,770
ماذا قلت؟

41
00:04:18,770 --> 00:04:20,400
!توقّف

42
00:04:21,660 --> 00:04:25,860
.بإمكانكما حلّ هذا في نزال الغد

43
00:04:26,420 --> 00:04:30,880
.أنقذك كوجينياما ثانية

44
00:04:30,880 --> 00:04:32,380
...يا لك من

45
00:04:33,020 --> 00:04:34,620
.لا بأس، هذا يكفي

46
00:04:35,980 --> 00:04:37,010
...عيون الجميع

47
00:04:38,550 --> 00:04:40,010
.عليك الآن

48
00:04:40,560 --> 00:04:41,890
...إنّه

49
00:04:41,890 --> 00:04:43,770
ما كلّ هذه الحدّة؟

50
00:04:44,510 --> 00:04:49,140
!تطلّعوا لنزال الغد أيّها الحضور

51
00:04:47,650 --> 00:04:50,390
.ربّما من الأفضل أن تتوقّف الآن

52
00:05:01,070 --> 00:05:02,430
.تذكّرت

53
00:05:03,150 --> 00:05:04,530
.كوجينياما توراجيرو

54
00:05:07,530 --> 00:05:12,250
ألن يكون مصارع سومو أفضل
خيار لدور كاسر العوائق؟

55
00:05:12,250 --> 00:05:14,100
.توقّعتُ أن تقول ذلك

56
00:05:14,790 --> 00:05:17,130
لا يوجد مصارع سومو قد يرغب
.في أن يصير مكافح حرائق

57
00:05:17,570 --> 00:05:21,230
.إنّ راتبهم مرتفع جدًّا

58
00:05:22,970 --> 00:05:26,830
إذًا لا فائدة من الذّهاب
إلى شيباجينغو غدًا؟

59
00:05:26,830 --> 00:05:28,750
.لا، بإمكانك الذّهاب إن أردت

60
00:05:28,750 --> 00:05:30,550
.ماذا؟ هذا مفاجئ

61
00:05:30,550 --> 00:05:34,050
أتريد الذّهاب لمشاهدة نزال
داتيغاسيكي أيضًا؟

62
00:05:34,260 --> 00:05:35,440
.لا

63
00:05:35,890 --> 00:05:38,400
.أنا مهتمّ أكثر بكوجينياما

64
00:05:38,400 --> 00:05:41,820
كوجينياما؟ الرّجل الّذي أوقف الشّجار؟

65
00:05:42,130 --> 00:05:45,790
.رأيتُه يقاتل من قبل

66
00:05:51,650 --> 00:05:54,170
.بدا كشخص مختلف تمامًا

67
00:05:55,570 --> 00:05:59,260
.ولكن، كان ذلك منذ ثماني سنوات

68
00:05:59,260 --> 00:06:00,690
.أفترض أنّ الكثير قد تغيّر

69
00:06:01,530 --> 00:06:03,310
.كنتُ مكافح حرائق

70
00:06:04,080 --> 00:06:07,600
عفوًا، لماذا توقّفت؟

71
00:06:08,070 --> 00:06:13,700
أعتقد أنّ سبب توقّفي أقلّ
.أهمّيّة من سبب بدايتك

72
00:06:14,590 --> 00:06:16,070
.أعتقد ذلك

73
00:06:18,040 --> 00:06:21,910
.حسنًا. لديّ أمر عليّ تولّيه
.لذلك أستأذن بالذّهاب

74
00:06:21,910 --> 00:06:22,910
.هكذا إذًا

75
00:06:23,300 --> 00:06:24,960
.لا تذهب إلى أيّ أماكن غريبة

76
00:06:24,960 --> 00:06:26,370
!لن أقوم بذلك أبدًا

77
00:06:34,100 --> 00:06:35,910
.من الأفضل ألاّ ترى

78
00:06:42,700 --> 00:06:44,260
...أبي

79
00:06:46,860 --> 00:06:48,930
كيف حدث هذا؟

80
00:06:54,860 --> 00:06:59,410
لم أرد أبدًا أن أصير مكافح
.حرائق بسبب مصير والدي

81
00:07:00,630 --> 00:07:05,860
لذلك لماذا أريد أن أصير واحدًا الآن؟

82
00:07:14,350 --> 00:07:16,890
!ها هو كوجينياما

83
00:07:18,270 --> 00:07:21,810
.ماذا؟ إنّ خصمه أصغر حجمًا

84
00:07:23,310 --> 00:07:24,700
...ركبته اليسرى

85
00:07:26,250 --> 00:07:28,550
هل هو مصاب؟

86
00:07:28,550 --> 00:07:33,040
لكن ما زالت الأفضليّة
.لكوجينياما في هذا النّزال

87
00:07:33,440 --> 00:07:35,920
.إنّه أعلى مرتبة أيضًا

88
00:07:37,410 --> 00:07:39,990
!استعداد. اشتباك

89
00:07:40,840 --> 00:07:42,440
!هيّا! هيّا

90
00:07:44,410 --> 00:07:46,040
!انتهى النّزال

91
00:07:48,510 --> 00:07:50,150
!مستحيل

92
00:07:50,150 --> 00:07:52,940
لماذا اندفع نحو مصارع أصغر حجمًا؟

93
00:07:55,800 --> 00:08:00,620
،حين تكون حظوظك سيّئة
.يبدو أنّ كلّ شيء يسير بشكل خاطئ

94
00:08:05,710 --> 00:08:07,960
!هذا هو داتيغاسيكي

95
00:08:11,160 --> 00:08:13,180
إنّهما متنافِسان، صحيح؟

96
00:08:13,180 --> 00:08:17,500
.إينوتاني قويّ، لكنّه ليس بقوّة داتيغاسيكي

97
00:08:17,500 --> 00:08:21,830
إنّه يشتهر بضربات راحة يده
.القويّة الّتي لا تصدّق

98
00:08:21,830 --> 00:08:24,890
.سيكون كاسرَ العوائق المثاليّ لفرقتنا

99
00:08:24,890 --> 00:08:27,240
تفكّر في تجنيد داتيغاسيكي؟

100
00:08:27,240 --> 00:08:29,190
.بكلّ تأكيد

101
00:08:32,300 --> 00:08:33,110
.استعداد

102
00:08:34,080 --> 00:08:35,120
!اشتباك

103
00:08:39,120 --> 00:08:41,440
!هيّا! هيّا! هيّا

104
00:08:41,440 --> 00:08:42,680
!هيّا! هيّا

105
00:08:46,380 --> 00:08:47,970
.كانت ضربة يمناه مجرّد خدعة

106
00:08:47,970 --> 00:08:49,370
.لقد ضرب بيده اليسرى

107
00:08:56,140 --> 00:08:57,990
.كان ذلك نزالاً عنيفًا

108
00:08:57,990 --> 00:09:00,890
.طبيعته العنيفة هي سبب شعبيّته الكبيرة

109
00:09:01,200 --> 00:09:04,900
إنّه مصارع سومو من النّوع
.الّذي وُلد ليكون مكافح حرائق

110
00:09:04,900 --> 00:09:06,850
!والآن، لنذهب

111
00:09:06,850 --> 00:09:08,400
ولكن إلى أين؟

112
00:09:15,800 --> 00:09:18,760
ما كان ذلك؟

113
00:09:18,760 --> 00:09:21,600
ماذا لو تأذّى إينوتاني؟

114
00:09:21,910 --> 00:09:24,520
.لقد استفزّني البارحة

115
00:09:24,520 --> 00:09:26,400
.لذلك تحمّستُ قليلاً

116
00:09:26,620 --> 00:09:28,840
.لن أخبرك ألاّ تستعمل ضربات راحة اليد تلك

117
00:09:29,270 --> 00:09:32,360
.لكنّ هذه فترة حاسمة بالنّسبة لك

118
00:09:32,830 --> 00:09:36,010
من الأفضل لك وللجميع
—ألا تكتسب أيّ أعداء

119
00:09:36,010 --> 00:09:37,670
!ذلك صحيح بالنّسبة لك أيضًا

120
00:09:38,020 --> 00:09:42,280
.أنت مُعرّض لخسارة رتبتك
!عليك أن تحسّن أداءك

121
00:09:43,550 --> 00:09:45,060
.معك حقّ

122
00:09:46,010 --> 00:09:49,330
.لا يحقّ لي أن أحاضرك

123
00:09:51,190 --> 00:09:52,470
من أنتما؟

124
00:09:52,470 --> 00:09:54,060
.رأيتُك البارحة

125
00:09:55,260 --> 00:10:01,330
أنا توريغوي شينّوسكي، نائب قائد
.مكافحي حرائق إقطاعيّة شينجو

126
00:10:01,910 --> 00:10:06,410
.أنا القائد، ماتسوناغا غِنغو

127
00:10:07,440 --> 00:10:10,710
أنتما مكافحا حرائق؟ كيف يمكنني المساعدة؟

128
00:10:10,710 --> 00:10:16,200
حسنًا، أعلم أنّك مشغول، لكنّي كنتُ آمل
.الحصول على بصمة يد من داتيغاسيكي

129
00:10:16,200 --> 00:10:18,820
.يتمّ القيام بذلك بعد النّزالات في العادة

130
00:10:18,820 --> 00:10:21,090
—بالطّبع، ولكن

131
00:10:21,090 --> 00:10:23,230
.لا بأس. أدخلهما

132
00:10:23,520 --> 00:10:26,230
!أجل! شكرًا جزيلاً لك

133
00:10:26,570 --> 00:10:28,850
...حسنًا يا داتيغاسيكي

134
00:10:29,930 --> 00:10:31,770
.أردتُ أن أطلب منك خدمة

135
00:10:35,230 --> 00:10:38,200
.وهكذا، كنّا نأمل أن تصير مكافح حرائق

136
00:10:38,200 --> 00:10:39,230
.أنا أرفض

137
00:10:39,230 --> 00:10:41,170
.هذا طبيعيّ

138
00:10:41,170 --> 00:10:44,730
لا يوجد سبب قد يدفع مصارع
.سومو ليصير مكافح حرائق

139
00:10:45,120 --> 00:10:47,340
لماذا أنت مكافح حرائق؟

140
00:10:47,340 --> 00:10:49,740
هناك مجالات أخرى يمكنك
.استعمال مواهبك فيها

141
00:10:50,240 --> 00:10:52,850
تقصد موهبتي في الثّرثرة؟

142
00:10:52,850 --> 00:10:54,250
.لا

143
00:10:54,700 --> 00:10:56,120
.لا تهتمّ

144
00:10:56,120 --> 00:11:01,750
لكنّ كوجينياما قد يعتزل
.مصارعة السّومو

145
00:11:01,750 --> 00:11:03,140
لأنّه ضعيف؟

146
00:11:03,140 --> 00:11:04,900
هل عليّ استرجاع بصمة اليد تلك منك؟

147
00:11:06,700 --> 00:11:08,840
.إنّه ليس ضعيفًا

148
00:11:08,840 --> 00:11:13,310
.كان قويًّا كالغيلان من قبل
.أقوى حتّى منّي

149
00:11:13,950 --> 00:11:18,050
.ما زلتُ أعتبره مصارع سومو حقيقيًّا

150
00:11:18,050 --> 00:11:19,770
لماذا إذًا؟

151
00:11:20,430 --> 00:11:24,370
.كسر ركبته قبل سنتين

152
00:11:24,800 --> 00:11:26,530
.أثناء قتال مكافح حرائق

153
00:11:27,280 --> 00:11:28,670
مكافح حرائق؟

154
00:11:29,290 --> 00:11:33,270
دخلتُ في جدال مع بعض
.مكافحي حرائق جو وحاول إيقافه

155
00:11:33,270 --> 00:11:36,800
،تلقّى ضربة في ركبته اليسرى
.وصارت حركاته محدودة الآن

156
00:11:37,710 --> 00:11:42,260
سينزل إلى رتبة ماكوشيتا
.إن خسر في نزاله غدًا

157
00:11:43,030 --> 00:11:44,330
...وإن حدث ذلك

158
00:11:45,680 --> 00:11:47,470
.قال أنّه سيتقاعد

159
00:11:48,240 --> 00:11:51,020
...وسيكون خصمه

160
00:11:52,490 --> 00:11:53,640
.هو أنا

161
00:12:08,700 --> 00:12:11,200
تريدني أن أصير مكافح حرائق؟

162
00:12:11,200 --> 00:12:15,630
!ستكون كاسر عوائق رائعًا بقوّتك هذه

163
00:12:16,710 --> 00:12:22,710
واثق أنّ داتيغاسيكي أخبركما
.أنّي كسرت ركبتي

164
00:12:23,040 --> 00:12:24,550
.نعم

165
00:12:24,550 --> 00:12:28,090
.ولكنّي لا أخطّط للتّقاعد في كلّ الأحوال

166
00:12:28,460 --> 00:12:31,020
.قطعتُ وعدًا لوالدتي

167
00:12:34,050 --> 00:12:37,780
.وُلدتُ في قرية فقيرة في أومي

168
00:12:37,780 --> 00:12:42,190
،فقدتُ والدي في سنّ صغيرة
.وعشنا وحدنا أنا ووالدتي

169
00:12:42,190 --> 00:12:47,750
ولكن بما أنّي كنتُ أكبر من بقيّة
.الأطفال، كانوا يتنمّرون لي

170
00:12:47,750 --> 00:12:50,010
!اقتلوا الوحش

171
00:12:50,550 --> 00:12:52,460
.عد إلى الجبال أيّها الطّفل الوحش

172
00:12:52,460 --> 00:12:54,080
!ارحل! ارحل

173
00:12:54,080 --> 00:12:58,320
.وكانت أمّي تحميني في كلّ مرّة

174
00:12:58,320 --> 00:13:00,130
.اسمع يا تورا

175
00:13:00,510 --> 00:13:06,700
منحتك الآلهة جسدك الكبير
.هذا لحماية الضّعفاء

176
00:13:07,890 --> 00:13:13,140
.تعلم أمّك أنّك أكثر طيبة من أيّ أحد آخر

177
00:13:13,490 --> 00:13:18,540
لذلك عليك أن تكبر وتصير قويًّا
.ومذهلاً مثل جبل كوجينياما

178
00:13:19,430 --> 00:13:20,430
.حاضر

179
00:13:24,990 --> 00:13:29,250
كانت تلك الكلمات هي ما
.جعلني أصير مصارع سومو

180
00:13:29,250 --> 00:13:31,920
.وأقسمتُ أن أصل إلى رتبة أوزيكي

181
00:13:32,400 --> 00:13:36,990
.لذلك لن أتقاعد حتّى أحقّق ذلك الوعد

182
00:13:36,990 --> 00:13:41,640
،وإن أصبحتُ مجرّد مكافح حرائق
.فلن أنال احترام والدتي أبدًا

183
00:13:43,110 --> 00:13:47,960
توراجيرو-سان، لا أعتقد
.أنّ ذلك ما قصدته والدتك

184
00:13:48,930 --> 00:13:50,450
ماذا؟

185
00:13:50,880 --> 00:13:52,870
!يا-يا سيّدي

186
00:13:52,870 --> 00:13:58,440
أعتقد أنّك رجل طيّب وقويّ
.مثلما أرادت والدتك سلفًا

187
00:13:59,190 --> 00:14:01,280
لكن ما لا يمكنني مسامحته

188
00:14:01,280 --> 00:14:04,940
هو قولك أنّك ما زلت مصارع
.سومو من أجل والدتك

189
00:14:05,630 --> 00:14:08,950
لماذا لا يمكنك قول أنّك لا تريد
التّخلّي عن حلمك فحسب؟

190
00:14:09,460 --> 00:14:12,010
!قلها بكلّ جرأة إن كنت رجلاً

191
00:14:12,450 --> 00:14:14,200
.ذلك صحيح

192
00:14:14,200 --> 00:14:16,660
.أنا أحبّ مصارعة السّومو

193
00:14:16,660 --> 00:14:18,920
.لا يمكنني التّخلّي عن حلمي بأن أصير أوزيكي

194
00:14:18,920 --> 00:14:21,200
.أريد أن تراني والدتي أصير كذلك

195
00:14:21,200 --> 00:14:24,660
ولكن مذ أن أصبت، ما عدتُ
.قادرًا على مجاراة الآخرين

196
00:14:24,660 --> 00:14:27,200
.عندما أشتبك مع أحد ما، تخونني قوّتي

197
00:14:27,200 --> 00:14:32,720
أتدري كم من المحبط ألاّ تكون
قادرًا على القيام بما تحبّ؟

198
00:14:32,720 --> 00:14:33,850
.أنا أدري

199
00:14:34,550 --> 00:14:37,070
.اعتزلتُ مكافحة الحرائق مرّة

200
00:14:37,520 --> 00:14:38,860
.هربت

201
00:14:39,300 --> 00:14:43,060
كنتُ أؤمن أنّ بإمكاني مكافحة
.أيّ حريق، مهما كان سيّئًا

202
00:14:43,060 --> 00:14:45,240
.كنتُ أؤمن أنّه العمل الّذي قُدّر لي أن أقوم به

203
00:14:45,940 --> 00:14:47,890
.لكنّي كنتُ مخطئًا

204
00:14:48,530 --> 00:14:50,810
.خسرتُ في وقت كان حاسمًا جدًّا

205
00:14:51,660 --> 00:14:54,210
كانت تلك عقوبتي لأنّي صدّقت الجميع

206
00:14:54,210 --> 00:14:56,230
.عندما قالوا أنّي مميّز

207
00:14:57,110 --> 00:15:00,160
،أنا خائف جدًّا من النّيران
.وما زالت تراودني الكوابيس

208
00:15:01,000 --> 00:15:04,420
.لكنّي ما زلتُ أحبّ كوني مكافح حرائق

209
00:15:04,740 --> 00:15:08,590
،وبعد أن عدتُ كذلك الآن
.سأفعل كلّ ما باستطاعتي

210
00:15:13,010 --> 00:15:15,850
.أنا أحبّ الأشخاص الّذين لا يستسلمون

211
00:15:16,300 --> 00:15:18,840
.سآتي لمشاهدة نزالك، لذلك لا تخسر

212
00:15:29,020 --> 00:15:35,620
.في الجهة الشّرقيّة: كوجينياما

213
00:15:36,040 --> 00:15:43,280
.في الجهة الغربيّة: داتيغاسيكي

214
00:15:43,280 --> 00:15:45,520
هل يستطيع توراجيرو-سان الفوز؟

215
00:15:45,860 --> 00:15:47,240
.لا فكرة لديّ

216
00:15:52,290 --> 00:15:53,270
.حريق

217
00:15:54,670 --> 00:15:56,510
أيرن الجرس؟

218
00:15:56,510 --> 00:15:58,710
.نعم. في الجنوب الشّرقيّ

219
00:15:59,180 --> 00:16:00,670
.قرب هاماماتسوتشو

220
00:16:01,310 --> 00:16:04,680
ممّ صُنعت أذناك يا ترى؟

221
00:16:04,680 --> 00:16:07,510
.النّيران قريبة. علينا إخلاء هذا المكان

222
00:16:07,510 --> 00:16:08,310
!حالاً

223
00:16:11,600 --> 00:16:13,820
!اسمعوا جميعًا

224
00:16:14,330 --> 00:16:18,400
أنا ماتسوناغا غِنغو من مكافحي
.حرائق إقطاعيّة شينجو

225
00:16:18,970 --> 00:16:21,070
.هنالك حريق في الجنوب

226
00:16:21,350 --> 00:16:22,780
—النّيران قريبة

227
00:16:23,110 --> 00:16:25,270
.النّيران بعيدة عنّا

228
00:16:25,270 --> 00:16:29,510
،لا أعتقد أنّها ستصل إلى هنا
.لكن علينا المغادرة من باب الحيطة

229
00:16:31,340 --> 00:16:34,600
غادروا بانتظام من المخرج الغربيّ
.واتّجهوا إلى زوجوجي

230
00:16:34,990 --> 00:16:37,760
.ثمّ اتّجهوا نحو القلعة

231
00:16:39,600 --> 00:16:43,100
عليك الحفاظ على هدوء الجميع
.عند إخلاء مكان ما

232
00:16:43,100 --> 00:16:45,730
.إنّ الحشود المرتعبة أخطر من النّار

233
00:16:45,730 --> 00:16:47,200
.أنا آسف

234
00:16:48,590 --> 00:16:53,970
،أنا أوتاني سوكينوجو
.واحد من أتباع نيوا ساكيودايو

235
00:16:54,600 --> 00:16:55,970
!اسمعوا جميعًا

236
00:16:55,970 --> 00:16:58,110
!تقترب النّيران من هنا

237
00:16:58,110 --> 00:17:01,570
!غادروا من المخرج الغربيّ في الحال

238
00:17:04,860 --> 00:17:06,570
.ذلك المغفّل

239
00:17:06,870 --> 00:17:09,870
!أسرعوا! إلى المخرج الغربيّ

240
00:17:09,870 --> 00:17:11,270
أين الحريق؟

241
00:17:12,220 --> 00:17:14,310
.الحدود الجنوبيّة لهاماماتسوتشو

242
00:17:14,310 --> 00:17:17,660
.انفجر مخزن أحد التّجّار
.النّار في طريقها إلى هنا

243
00:17:17,660 --> 00:17:18,770
مخزن؟

244
00:17:18,770 --> 00:17:20,520
أهذا من صنيع ثعلب النّار؟

245
00:17:20,520 --> 00:17:24,400
.لا أدري، لكن يبدو أنّه كان هنالك لهيب مرتدّ

246
00:17:24,710 --> 00:17:25,920
لهيب مرتدّ؟

247
00:17:25,920 --> 00:17:27,850
شينّوسكي، أنحن جاهزون للذّهاب؟

248
00:17:28,990 --> 00:17:31,480
أنا أسألك إن كان بإمكاننا
.إرسال مكافحي حرائقنا

249
00:17:31,480 --> 00:17:37,160
،نعم! لدينا كلّ الأدوات
.وأعتقد أنّ بإمكاننا المساعدة ولو قليلاً

250
00:17:37,160 --> 00:17:39,970
.حسنًا. سأطلب هذا منك مرّة أخرى

251
00:17:41,400 --> 00:17:44,090
لأيّ سبب صرتَ مكافح حرائق؟

252
00:17:44,950 --> 00:17:49,620
.لديّ خبرة قليلة، ولا أحبّ كوني مكافح حرائق

253
00:17:49,620 --> 00:17:53,420
لكنّي أريد أن أعرف ما يعنيه
.أن أعيش كمكافح حرائق

254
00:17:53,920 --> 00:17:56,040
أليس هذا كافيًا؟

255
00:17:57,660 --> 00:18:01,690
.حسنًا. جهّز الرّجال واتّجه إلى قصر نيوا

256
00:18:02,170 --> 00:18:04,180
.سأذهب بمجرّد إخلاء هذا المكان

257
00:18:04,180 --> 00:18:05,200
!حاضر

258
00:18:05,200 --> 00:18:06,340
!أوتاني-دونو

259
00:18:06,920 --> 00:18:10,620
.اعتن بمكافحي حرائقنا رجاءً

260
00:18:11,120 --> 00:18:12,180
.مفهوم

261
00:18:17,200 --> 00:18:19,200
.الزموا الهدوء جميعًا

262
00:18:19,570 --> 00:18:21,610
.لم تصل النّيران إلى هنا بعد

263
00:18:34,420 --> 00:18:37,150
.اعتزلتُ مكافحة الحرائق مرّة

264
00:18:37,150 --> 00:18:38,460
.هربت

265
00:18:38,910 --> 00:18:43,980
.تعلم أمّك أنّك أكثر طيبة من أيّ أحد آخر

266
00:19:09,740 --> 00:19:12,620
.حسنًا، تمّ إخلاء المكان من النّاس

267
00:19:12,620 --> 00:19:13,750
...عليكما أن

268
00:19:14,180 --> 00:19:16,250
أنت! ما الّذي تفعله؟

269
00:19:16,250 --> 00:19:22,140
تذكر القواعد أنّه عند إلغاء
،نزال بسبب كارثة طبيعيّة

270
00:19:22,140 --> 00:19:26,260
.فلن تتمّ إقامته ثانية

271
00:19:26,710 --> 00:19:30,270
.هذه فرصتنا الوحيدة

272
00:19:43,060 --> 00:19:44,770
.يبدو هذا ممتعًا

273
00:19:44,770 --> 00:19:46,750
.ستحتاجان إلى حكم

274
00:19:47,540 --> 00:19:49,180
أيمكنك القيام بذلك؟

275
00:19:49,180 --> 00:19:51,300
.سأقلّد ما رأيتُه فحسب، ولكن نعم

276
00:19:52,010 --> 00:19:53,530
.قم بذلك إذًا

277
00:19:53,870 --> 00:19:55,710
.حسنًا. لنبدأ

278
00:19:56,450 --> 00:19:57,640
.استعداد

279
00:19:58,040 --> 00:19:59,350
!اشتباك

280
00:20:29,010 --> 00:20:30,660
!انتهى النّزال

281
00:20:33,050 --> 00:20:36,460
.شكرًا على كلّ شيء

282
00:20:37,280 --> 00:20:39,790
.أنا مسرور أنّ كلاكما بخير

283
00:20:40,470 --> 00:20:44,270
.لكن خاب أملي لأنّي لم أستطع مشاهدة النّزال

284
00:20:44,270 --> 00:20:46,970
.نعم، لم يكن نزالاً يُفوّت

285
00:20:48,290 --> 00:20:50,490
.ماتسوناغا-ساما

286
00:20:50,490 --> 00:20:53,980
بفضلك، استطعتُ إنهاء
.يومي هذا بلا أيّ ندم

287
00:20:54,250 --> 00:20:57,490
.ما هذا؟ هذا ليس من طباعك

288
00:20:57,490 --> 00:21:01,630
،بينما نحن بصدد هذا
.لدى كوجينياما طلب لك

289
00:21:05,020 --> 00:21:09,500
،ماتسوناغا-دونو
.قرّرت اعتزال مصارعة السّومو

290
00:21:11,230 --> 00:21:14,130
...لذلك يا ماتسوناغا-دونو

291
00:21:14,130 --> 00:21:18,350
!لا، أيّها القائد... اسمح لي بالبقاء معكم

292
00:21:19,150 --> 00:21:22,050
...هل أنت واثق؟ ذلك النّزال

293
00:21:30,780 --> 00:21:32,510
!انتهى النّزال

294
00:21:39,680 --> 00:21:44,770
استطعتُ النّجاح حينها فقط
.لأنّي كنت أعلم أنّه نزالي الأخير

295
00:21:45,310 --> 00:21:47,960
.لم يعد لديّ ما أندم عليه الآن

296
00:21:47,960 --> 00:21:50,790
وعندما رأيتُك حينها، عرفتُ ما
.هو مكافح الحرائق الحقيقيّ

297
00:21:51,280 --> 00:21:54,660
.لذلك اسمح لي بالانضمام لكم رجاءً

298
00:21:56,650 --> 00:21:59,130
.حسنًا. سررت بانضمامك

299
00:22:00,390 --> 00:22:02,440
.وأنا سررتُ من أجلك

300
00:22:03,070 --> 00:22:04,170
.نعم