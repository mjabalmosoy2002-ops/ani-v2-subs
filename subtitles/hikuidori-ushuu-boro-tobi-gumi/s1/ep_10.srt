1
00:00:03,130 --> 00:00:04,650
!غِنغو

2
00:00:08,280 --> 00:00:10,070
.إنّه شينّوسكي

3
00:00:11,030 --> 00:00:12,540
!لقد مات

4
00:00:18,600 --> 00:00:20,540
شينّوسكي مات؟

5
00:00:20,830 --> 00:00:22,420
كيف؟ متى؟

6
00:00:22,420 --> 00:00:23,910
!ماذا حدث؟

7
00:00:24,740 --> 00:00:26,990
...حدث ذلك قبل قليل

8
00:00:38,820 --> 00:00:40,800
.سأذهب الآن

9
00:00:40,800 --> 00:00:43,560
.حسنًا. بالتّوفيق في عملك

10
00:00:44,110 --> 00:00:44,960
.شكرًا

11
00:01:26,640 --> 00:01:29,080
.مرّ وقت طويل يا أبي

12
00:01:29,750 --> 00:01:33,590
.قرأتُ يوميّاتك البارحة

13
00:01:34,130 --> 00:01:39,390
ما فعلتَ كلّ يوم والحرائق
.الّتي أخمدتَها وماذا أكلت

14
00:01:39,810 --> 00:01:44,130
.دوّنتَ كلّ شيء، وهذا من طبعك في رأيي

15
00:01:44,990 --> 00:01:49,160
.أخذتَ عملك كمكافح حرائق بشكل جدّيّ

16
00:01:50,020 --> 00:01:53,630
.لكن كان فيها أجزاء جعلتني أبكي أيضًا

17
00:01:55,130 --> 00:01:58,440
.يا إلهي منك
.كان عليك قول ما تشعر به

18
00:01:58,440 --> 00:02:03,470
،لو أنّك تحدّثتَ كثيرًا مثلي
.لكنّا قد فهمنا بعضنا أكثر

19
00:02:04,010 --> 00:02:07,040
.أردتُ سماع الكثير منك مباشرة

20
00:02:07,040 --> 00:02:10,250
.وعمّا كان مهمًّا لك كمكافح حرائق

21
00:02:10,250 --> 00:02:13,900
.وكم أنّك أردتَ منّي أن أصير مكافح حرائق

22
00:02:14,580 --> 00:02:17,220
...ليتنا تحدّثنا أكثر

23
00:02:18,170 --> 00:02:22,450
،لكن عندما يصبح الأمر مهمًّا فعلاً
.أعجز أيضًا عن التّعبير عمّا يهمّني

24
00:02:22,450 --> 00:02:25,030
ربّما ورثتُ ذلك منك؟

25
00:02:28,890 --> 00:02:30,410
.عليّ الذّهاب

26
00:02:30,410 --> 00:02:33,420
سأعود ثانية. وسأحضر أمّي
.معي في المرّة القادمة

27
00:02:33,920 --> 00:02:37,300
.سأخبر القائد عمّا قلتَه

28
00:02:42,930 --> 00:02:43,860
حريق؟

29
00:02:48,310 --> 00:02:51,310
.إنّه ليس بعيدًا جدًّا
شيناغاوا؟

30
00:02:51,310 --> 00:02:53,100
لا، ربّما في ميغورو؟

31
00:03:01,490 --> 00:03:02,530
...ذلك

32
00:03:05,710 --> 00:03:07,020
!هيديسكي

33
00:03:13,990 --> 00:03:16,880
.أظنّني الآن لا أملك خيارًا آخرًا

34
00:03:27,830 --> 00:03:29,920
.ذلك الدّخان غامق جدًّا

35
00:03:29,920 --> 00:03:32,190
.إنّه لا يشبه دخان حريق عاديّ

36
00:03:34,820 --> 00:03:38,230
المعذرة. أتدري أين بدأ الحريق؟

37
00:03:39,270 --> 00:03:42,150
.في معبد دايينجي على تلّة غيونينزاكا

38
00:03:42,150 --> 00:03:43,990
.ويقولون أنّه كان مفتعلاً

39
00:03:45,360 --> 00:03:46,520
حريق مفتعل؟

40
00:03:47,040 --> 00:03:50,980
إنّ تلّة غيونينزاكا تكون مليئة
.بزوّار معبد ميغورو فودو

41
00:03:51,380 --> 00:03:53,580
.قد يموت الكثير من النّاس

42
00:03:54,380 --> 00:03:56,870
أ-أيمكنني الذّهاب الآن؟

43
00:03:56,870 --> 00:03:57,880
.نعم

44
00:03:58,500 --> 00:03:59,680
...ولكن أوّلاً

45
00:04:00,620 --> 00:04:04,620
.أنا توريغوي شينّوسكي من إقطاعيّة شينجو

46
00:04:04,620 --> 00:04:09,390
خذ هذا المال واذهب إلى قصرنا واطلب
.منهم إرسال كلّ مكافحي الحرائق

47
00:04:09,390 --> 00:04:12,370
أ-أنت مع الحِدآن الرّثّة؟

48
00:04:12,370 --> 00:04:14,390
أنت من افتعل هذا الحريق أيضًا، صحيح؟

49
00:04:14,390 --> 00:04:18,020
!لم نفتعل أيّ حرائق أبدًا

50
00:04:21,030 --> 00:04:22,160
.أنا أرجوك

51
00:04:22,600 --> 00:04:25,040
.أخبرهم أن يحضروا الجميع رجاءً

52
00:04:28,040 --> 00:04:30,480
!لكن... مهلاً! انتظر

53
00:04:37,050 --> 00:04:38,640
مكافحو حرائق نيوا؟

54
00:04:40,130 --> 00:04:41,550
!أوتاني-دونو

55
00:04:41,550 --> 00:04:43,290
.هذا أنت يا توريغوي-دونو

56
00:04:43,290 --> 00:04:45,060
.سأساعدكم أيضًا

57
00:04:46,600 --> 00:04:48,990
.شكرًا لك. أعلم أنّ الوضع صعب عليكم الآن

58
00:04:49,560 --> 00:04:53,070
،اتّجه رجالنا إلى المعبد

59
00:04:53,070 --> 00:04:56,030
هل يمكنك المجيء معي إلى مكان آخر؟

60
00:04:56,030 --> 00:04:57,950
.حاضر، بالطّبع

61
00:04:58,200 --> 00:05:02,290
قيل لنا أنّ دخانًا أسودًا يتصاعد
،من شجرة خشب كافور

62
00:05:02,290 --> 00:05:05,050
.بجانب مخزن في كاميوزاكي

63
00:05:05,050 --> 00:05:07,080
.لكن لا يمكننا إيجاد مصدر الحريق

64
00:05:08,460 --> 00:05:12,510
.المنطقة المحيطة بالمخزن ساخنة جدًّا أيضًا

65
00:05:12,510 --> 00:05:14,450
.ثمّة شيء غريب حيال هذا

66
00:05:14,450 --> 00:05:16,220
.سأذهب في الحال

67
00:06:53,360 --> 00:06:55,360
.هناك الكثير من الأشخاص حولها

68
00:06:58,120 --> 00:07:00,700
!اسمعوا جميعًا! ابتعدوا من الشّجرة

69
00:07:00,700 --> 00:07:02,620
!لا ندري ما الخطب بعد

70
00:07:03,230 --> 00:07:05,740
ومن تكون لتخبرنا ماذا نفعل؟

71
00:07:06,830 --> 00:07:08,850
...عفوًا، أنا

72
00:07:11,510 --> 00:07:14,570
!إنّه واحد من مكافحي حرائقنا. ابتعدوا

73
00:07:34,250 --> 00:07:36,430
أثمّة شيء ما داخلها يحترق؟

74
00:07:36,840 --> 00:07:41,220
،إن لم نُخمد النّار
.فستنتشر إلى المباني المجاورة هنا

75
00:07:41,910 --> 00:07:42,860
!أحضروا الماء

76
00:07:49,300 --> 00:07:51,800
لكن ما الّذي يحدث؟

77
00:07:53,630 --> 00:07:55,690
ما الّذي تفعله هنا؟

78
00:07:57,550 --> 00:08:00,100
ما الخطب؟ أهنالك شيء ما بداخله؟

79
00:08:07,910 --> 00:08:09,290
!إنّه ساخن

80
00:08:09,290 --> 00:08:12,460
أهذا لهيب مرتدّ يتكوّن في الدّاخل؟

81
00:08:13,710 --> 00:08:15,540
لهيب مرتدّ؟

82
00:08:15,540 --> 00:08:19,460
.نعم. تمّ ختم الباب بالميسو والطّين

83
00:08:20,050 --> 00:08:21,780
.كلاّ

84
00:08:21,780 --> 00:08:24,560
أهذا من صنيع ثعلب النّار؟

85
00:08:32,580 --> 00:08:35,590
هذا النّباح... أهي كلاب؟

86
00:08:36,820 --> 00:08:39,820
تريدنا أن ننقذ أصدقاءك؟

87
00:08:41,570 --> 00:08:43,310
ثمّة كلاب في الدّاخل؟

88
00:08:43,700 --> 00:08:45,320
.ذلك ما يبدو

89
00:08:46,880 --> 00:08:49,290
!اسمعوا جميعًا! المكان خطير هنا

90
00:08:49,290 --> 00:08:50,890
!غادروا المكان رجاءً

91
00:08:57,600 --> 00:09:00,990
توريغوي-دونو، أخمدنا الحريق
.الّذي في الشّجرة

92
00:09:00,990 --> 00:09:03,350
.علينا المغادرة نحن أيضًا

93
00:09:03,830 --> 00:09:06,510
.لا، لا يمكننا ترك تلك الكلاب

94
00:09:06,510 --> 00:09:08,380
لكن ماذا عن اللّهيب المرتدّ؟

95
00:09:08,380 --> 00:09:10,600
.علينا الانتظار حتّى يحترق بالكامل

96
00:09:10,600 --> 00:09:13,370
.لكنّ الكلاب ستموت إن انتظرنا

97
00:09:13,370 --> 00:09:15,860
هل ستقوم بفتح الباب بالفعل؟

98
00:09:16,330 --> 00:09:17,210
.نعم

99
00:09:18,900 --> 00:09:21,160
.سأنقذهم، فلا تقلق

100
00:09:21,160 --> 00:09:23,620
.هل جننت؟ إنّها مجرّد كلاب

101
00:09:23,620 --> 00:09:25,970
.إن فتحت ذلك الباب، فستموت

102
00:09:26,870 --> 00:09:29,220
وماذا في ذلك؟

103
00:09:29,220 --> 00:09:33,620
حتّى هذا الكلب يحاول
.مواجهة النّار لإنقاذ رفاقه

104
00:09:33,620 --> 00:09:36,380
.لا يمكنني التّخلّي عن أحد هكذا

105
00:09:36,380 --> 00:09:40,420
.ومن واجب مكافحي الحرائق إنقاذ الأرواح

106
00:09:40,420 --> 00:09:43,800
.كلّ الأرواح. حتّى إن كلّفهم ذلك حياتهم

107
00:09:44,270 --> 00:09:46,880
.هذا ما علّمني إيّاه القائد

108
00:09:46,880 --> 00:09:49,650
!لكن من الواضح أنّ هذا فخّ

109
00:09:49,650 --> 00:09:51,210
.لا بأس

110
00:09:51,210 --> 00:09:54,560
.تعاملتُ مع اللّهيب المرتدّ من قبل

111
00:09:54,560 --> 00:09:57,590
.لذلك سأقوم بالأمر وحدي

112
00:09:57,590 --> 00:10:00,410
،أخلوا أنتم المنطقة

113
00:10:00,410 --> 00:10:04,040
واستعدّوا لإنقاذ الكلاب بمجرّد
.تبدّد اللّهيب المرتدّ

114
00:10:04,330 --> 00:10:06,410
.وأنت أيضًا عليك المغادرة

115
00:10:09,320 --> 00:10:10,740
.توريغوي-دونو

116
00:10:14,850 --> 00:10:18,470
.إن فتحت الباب، سنموت أنا والكلاب

117
00:10:18,470 --> 00:10:21,920
.تعلّمتُ ما يكفي لمعرفة ذلك

118
00:10:24,430 --> 00:10:26,520
.لذلك لا يمكنني فتح الباب

119
00:10:27,060 --> 00:10:29,530
هل هنالك مكان آخر يمكن للنّار
أن تخرج منه؟

120
00:10:37,040 --> 00:10:38,540
.تلك النّافذة الصّغيرة

121
00:10:44,800 --> 00:10:46,320
!سأستعير هذا

122
00:10:58,610 --> 00:10:59,850
.سُحقًا

123
00:11:07,400 --> 00:11:08,700
أبي؟

124
00:11:19,600 --> 00:11:23,760
.أبي، لقد كنتُ أبغضك

125
00:11:24,170 --> 00:11:28,100
كرهتُ الطّريقة الّتي متَّ بها وتخلّيتَ
.عن عائلتك لإنقاذ تلك الكلاب

126
00:11:28,580 --> 00:11:34,790
وكيف بدوتَ وكأنّك أردتَ دائمًا
.قول شيء لي، لكنّك لم تقله

127
00:11:52,680 --> 00:11:57,960
.تقول أمّي أحيانًا أنّي أشبهك

128
00:11:57,960 --> 00:12:00,230
.لم أفهم أبدًا لماذا من قبل

129
00:12:00,840 --> 00:12:03,400
.لكنّي أفهم الآن

130
00:12:04,090 --> 00:12:08,340
لدى السّاموراي ومكافحي الحرائق
.نفس الواجب، إنقاذ النّاس

131
00:12:08,340 --> 00:12:13,280
لذلك أريده أن يختار أن يكون"
".مكافح حرائق مثلي

132
00:12:13,640 --> 00:12:18,040
.وقد اتّضح أنّي مثلك تمامًا

133
00:12:30,060 --> 00:12:33,050
.سأقوم بإنقاذكم بكلّ تأكيد

134
00:12:44,140 --> 00:12:45,460
مات وهو ينقذ كلابًا؟

135
00:12:46,120 --> 00:12:48,480
.مثل كورانوسكي-دونو تمامًا

136
00:12:50,010 --> 00:12:51,350
.إنّها غلطتي

137
00:12:51,910 --> 00:12:54,820
...لو لم أقل تلك الأشياء له

138
00:12:55,320 --> 00:12:57,580
.لا يموت مكافح الحرائق هباءً أبدًا

139
00:12:57,960 --> 00:13:01,290
واجب مكافح الحرائق هو إنقاذ
.الأرواح. ذلك كلّ شيء ببساطة

140
00:13:01,290 --> 00:13:04,300
ولا يهمّ حياة من تكون؟

141
00:13:04,300 --> 00:13:07,680
حتّى إن عرفت أنّك ستموت خلال ذلك؟

142
00:13:08,340 --> 00:13:09,450
.هذا صحيح

143
00:13:10,220 --> 00:13:13,230
!لا! لم تكن غلطتك

144
00:13:13,230 --> 00:13:17,310
يقع اللّوم على الرّجل الّذي تسبّب
!باللّهيب المرتدّ وحبس تلك الكلاب

145
00:13:25,690 --> 00:13:29,120
.إنّ كلّ من يتقرّب منّي ينتهي به الأمر ميتًا

146
00:13:30,230 --> 00:13:33,490
.لم يعد بوسعي أن أكون مكافح حرائق بعد الآن

147
00:13:34,960 --> 00:13:36,450
!هذه سخافة

148
00:13:36,450 --> 00:13:39,100
،إن لم تذهب إلى الحرائق
فمن سينقذ تلك الأرواح؟

149
00:13:39,100 --> 00:13:43,000
وحدهم مكافحو حرائق شينجو من
.يهتمّون بإنقاذ الأرواح قبل كلّ شيء آخر

150
00:13:44,790 --> 00:13:47,580
.لا تزال النّيران تشتعل حول المدينة بأكملها

151
00:13:47,580 --> 00:13:50,670
لكن ستتحوّل قريبًا إلى حريق
.هائل وستنتشر في كلّ إيدو

152
00:13:50,670 --> 00:13:53,680
.ووصولها إلى هنا مسألة وقت حسب

153
00:13:53,680 --> 00:13:59,260
سأحرّرك من هنا، حتّى لو اضطررتُ
!لشقّ بطني تكفيرًا عن ذلك

154
00:13:59,850 --> 00:14:02,130
!ليس لديك هذه السّلطة

155
00:14:12,120 --> 00:14:13,330
.لا يمكنني القيام بهذا

156
00:14:13,330 --> 00:14:14,780
.لم يعد بإمكاني مكافحة الحرائق

157
00:14:14,780 --> 00:14:16,370
!اخرس

158
00:14:16,370 --> 00:14:18,530
!سأخرجك من هنا بأيّ وسيلة كانت

159
00:14:20,790 --> 00:14:22,630
!هيّا، اخرج يا غِنغو

160
00:14:22,630 --> 00:14:27,050
.أنا جاهز لأنهي حياتي من أجل هذا
!لذلك عليك أيضًا أنّ تتّخذ قرارك

161
00:14:31,540 --> 00:14:35,060
هل تتذكّر حريق إيداماتشي قبل 14 سنة؟

162
00:14:36,050 --> 00:14:37,330
إيداماتشي؟

163
00:14:37,940 --> 00:14:41,180
كنتُ هناك حين كنت
.في التّاسعة عشرة من عمري

164
00:14:41,180 --> 00:14:45,610
كان محلّ القناديل يحترق
.وعلى وشك الانهيار

165
00:14:45,900 --> 00:14:50,730
قال الجميع أنّ طفلة كانت
.في الدّاخل لن تنجو أبدًا

166
00:14:51,190 --> 00:14:52,980
!الأميرة

167
00:14:52,980 --> 00:14:56,420
!ليُنقذ أحد ما الأميرة

168
00:14:56,970 --> 00:15:02,780
لكنّ شابًّا شجاعًا لا يكبرني
.إلاّ بالقليل اندفع إلى الدّاخل

169
00:15:03,800 --> 00:15:05,420
من كان؟

170
00:15:14,360 --> 00:15:17,860
.ثمّة مصارع سومو مصاب تحطّمت أحلامه

171
00:15:17,860 --> 00:15:21,310
وبهلوانيّ قام بخيارات خاطئة
.من أجل الحبّ

172
00:15:21,310 --> 00:15:25,030
وأكاديميّ حبس نفسه
.في قوقعته الوحيدة

173
00:15:25,030 --> 00:15:29,890
ومكافح حرائق رفضَ والدَه
.لكنّه سار على خُطاه

174
00:15:31,280 --> 00:15:33,680
.يستطيع النّاس الوقوف ثانية دائمًا

175
00:15:33,680 --> 00:15:36,990
من علّمنا ذلك يا قاتل النّار؟

176
00:15:39,010 --> 00:15:43,260
.أيّها القائد

177
00:15:43,880 --> 00:15:45,080
!أيّها القائد

178
00:15:51,450 --> 00:15:53,550
.شينّوسكي لم يمت

179
00:15:56,890 --> 00:15:59,380
!إنّ قلبه معي

180
00:16:03,600 --> 00:16:05,430
أين ميوكي؟

181
00:16:05,430 --> 00:16:09,210
.فرّت إلى فوكاغاوا مع بقيّة إقطاعيّة شينجو

182
00:16:09,210 --> 00:16:13,820
.وعدتُها أنّي سأحرّرك من هنا بكلّ تأكيد

183
00:16:16,830 --> 00:16:19,070
مهلاً. ما الّذي تفعله؟

184
00:16:19,800 --> 00:16:24,220
أتعتقد أنّ ما فعلته سيمرّ بدون عقاب؟

185
00:16:24,220 --> 00:16:26,710
.أنا مستعدّ لشقّ بطني مقابل هذا

186
00:16:27,610 --> 00:16:30,460
تعتقد أنّ حياتك كافية للتّكفير عن هذا؟

187
00:16:32,780 --> 00:16:36,730
.نقطع بطوننا. نقطع الآخرين
.نقطع روابطنا

188
00:16:37,230 --> 00:16:41,930
،من الصّعب أن يكون المرء ساموراي
أليس كذلك يا ماتسوناغا؟

189
00:16:44,800 --> 00:16:51,120
أنت ساموراي أيضًا، لذلك أنا
.واثق أنّك تعرف ما دورك الآن

190
00:16:51,530 --> 00:16:54,510
.نعم. "قطع" هذه النّار

191
00:16:54,860 --> 00:16:57,860
.حسنًا! انطلق واقطع هذه النّار

192
00:16:59,240 --> 00:17:03,620
،لكن إن لم تعد بعد إخماد النّار
.فستكون عقوبتك الإعدام

193
00:17:03,620 --> 00:17:06,000
.لا تجعلني أقطع بطني من أجلك

194
00:17:06,310 --> 00:17:07,080
!حاضر

195
00:17:14,590 --> 00:17:16,840
!غِنغو، اتّجِه إلى إيتايباشي

196
00:17:16,840 --> 00:17:19,320
.ستجد هناك توراجيرو وسيجورو والبقيّة

197
00:17:47,240 --> 00:17:48,480
...هذا

198
00:17:59,550 --> 00:18:00,390
!مهلاً

199
00:18:19,150 --> 00:18:21,670
!الزموا الهدوء! لا تهلعوا

200
00:18:23,660 --> 00:18:26,390
.ثمّة الكثير من النّاس

201
00:18:27,160 --> 00:18:30,370
.إن استمرّ الوضع هكذا، سينهار الجسر

202
00:18:33,020 --> 00:18:34,100
.فهمت الآن

203
00:18:36,420 --> 00:18:39,470
!اهدؤوا جميعًا

204
00:18:36,840 --> 00:18:39,450
!توراجيرو-سان، سأترك هذا لك

205
00:18:41,400 --> 00:18:42,690
سينسي؟

206
00:18:42,690 --> 00:18:44,430
!أنت هناك! انتظر

207
00:18:47,430 --> 00:18:48,430
.سُحقًا

208
00:19:01,300 --> 00:19:02,370
ميوكي؟

209
00:19:12,330 --> 00:19:13,380
!ميوكي

210
00:19:14,460 --> 00:19:15,880
زوجي؟

211
00:19:22,740 --> 00:19:23,880
!ميوكي

212
00:19:25,370 --> 00:19:26,510
.زوجي

213
00:19:27,160 --> 00:19:28,350
!زوجي

214
00:19:34,350 --> 00:19:35,600
.ميوكي

215
00:19:43,670 --> 00:19:45,360
.زوجي

216
00:19:47,860 --> 00:19:50,060
.آسف لأنّي جعلتك تقلقين

217
00:19:50,630 --> 00:19:52,160
.أنا بخير كما ترين

218
00:19:54,250 --> 00:19:56,760
.أحمد الله لأنّك بخير

219
00:20:07,630 --> 00:20:10,100
.ثمّة شيء أردتُ إعطاءك إيّاه

220
00:20:16,520 --> 00:20:18,770
.إنّه سيف والدي

221
00:20:21,230 --> 00:20:22,650
سيف أوزِن-دونو؟

222
00:20:23,150 --> 00:20:29,200
سأعهد لك بسيفي والدي لتحميك
.روحه في حالة حدوث أيّ طارئ

223
00:20:29,630 --> 00:20:30,400
...وأيضًا

224
00:20:34,160 --> 00:20:35,540
...هذا

225
00:20:35,920 --> 00:20:38,550
أعتقد أنّه لا بأس من ارتدائه الآن، صحيح؟

226
00:20:39,810 --> 00:20:41,000
...لكن

227
00:20:41,950 --> 00:20:46,690
هل تذكر الحريق في محلّ القناديل
في إيداماتشي قبل 14 سنة؟

228
00:20:47,290 --> 00:20:50,680
.نعم. ذكّرني به سامون أيضًا

229
00:20:50,680 --> 00:20:54,860
.هكذا إذًا. كان سامون-سان هناك أيضًا

230
00:20:55,490 --> 00:20:58,200
.ربّما كلّ هذا من صنيع القدر

231
00:21:01,360 --> 00:21:04,440
.اِلتهم ذلك الخوف

232
00:21:06,450 --> 00:21:07,850
...سوف

233
00:21:08,690 --> 00:21:10,140
!ألتهم خوفك

234
00:21:15,050 --> 00:21:18,290
مهلاً، هل كنتِ تلك الفتاة؟

235
00:21:22,830 --> 00:21:25,230
.كان عليك قول شيء ما من قبل

236
00:21:31,120 --> 00:21:37,610
أعتقد أنّ الرّجل الّذي أوقف
.ذلك الحريق، سيقوف هذا أيضًا

237
00:21:38,660 --> 00:21:42,430
.أرِ آلهة النّار ما هي قوّة البشر

238
00:21:42,830 --> 00:21:43,950
.حاضر