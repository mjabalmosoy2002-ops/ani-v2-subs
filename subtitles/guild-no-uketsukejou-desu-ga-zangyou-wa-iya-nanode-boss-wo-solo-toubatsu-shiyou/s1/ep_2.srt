1
00:00:03,480 --> 00:00:06,440
!أعطني مهمة! مهمة سرية

2
00:00:06,440 --> 00:00:08,150
!قلتُ أعطني واحدة

3
00:00:08,650 --> 00:00:12,030
...لـ-لكن حتّى لو أخبرتني بهذا

4
00:00:12,030 --> 00:00:14,470
،كما أخبرتكَ هذه الآنسة الشابة

5
00:00:15,240 --> 00:00:18,500
.لا نتعامل مع أيّ نوع من المهام السرية هنا

6
00:00:18,500 --> 00:00:21,050
.كفّي عن ترديد نفس الجملة المعتادة

7
00:00:21,050 --> 00:00:23,000
!أعلم أنّكم تخبئونها

8
00:00:23,000 --> 00:00:26,400
!يا موظفة الاستقبال المغرورة

9
00:00:26,400 --> 00:00:28,540
!لا أستطيع تعيين واحدة لك بكل وضوح

10
00:00:28,540 --> 00:00:32,750
!المهام السرية مجرد شائعة انتشرت بين المغامرين

11
00:00:32,750 --> 00:00:35,000
!لا وجود لها في الواقع

12
00:00:35,910 --> 00:00:39,600
تُعرَض كلّ المهام التي نقدّمها هنا
.بشكل علني في النقابة

13
00:00:40,140 --> 00:00:42,180
!لا ترُدّي عليّ

14
00:00:42,720 --> 00:00:46,310
.حسنًا، ربّما عليّ لكم هذا الرجل بقوة

15
00:00:46,310 --> 00:00:47,840
...يا حقيرة

16
00:00:48,310 --> 00:00:51,650
أهذه نظرة ترمقين بها
مغامرًا، أحد زبائنكم؟

17
00:00:52,220 --> 00:00:54,750
.أفلِتها يا سلاي

18
00:00:56,030 --> 00:00:57,750
السيف الفضي إذًا؟

19
00:01:00,170 --> 00:01:02,200
أتحاول التصرف بروعة أمام الفتاة؟

20
00:01:02,470 --> 00:01:04,660
!أيّها الرجل اللعوب

21
00:01:08,930 --> 00:01:11,170
!أفلتني

22
00:01:11,170 --> 00:01:12,700
...إن مددت يدك على ألينـ

23
00:01:13,010 --> 00:01:17,180
،موظفة الاستقبال هذه مجددًا
لن أدعك تفلت بهذا القدر فقط، فهمت؟

24
00:01:18,070 --> 00:01:19,090
!اللعنة

25
00:01:19,650 --> 00:01:21,060
!سأتذكر هذا

26
00:01:26,560 --> 00:01:30,200
!شكرًا على حمايتي يا آنسة ألينا

27
00:01:30,200 --> 00:01:33,320
لا بأس. أبلغيني فقط إن حدث أيّ شيء آخر

28
00:01:33,750 --> 00:01:35,640
هل أنت بخير يا ألينا؟

29
00:01:35,640 --> 00:01:39,390
.نعم. شكرًا على مساعدتك

30
00:01:39,390 --> 00:01:41,870
.يوجد بعض الأشخاص الخطيرين في الأرجاء

31
00:01:41,870 --> 00:01:44,200
.حاولي ألّا تستفزيهم كثيرًا

32
00:01:44,710 --> 00:01:47,830
.أنت محق. سأتوخى الحذر أكثر في المستقبل

33
00:01:48,970 --> 00:01:50,840
...بالمناسبة يا عضو السيف الفضي

34
00:01:50,840 --> 00:01:53,840
ما الذي أتى بك إلى هنا اليوم؟

35
00:01:53,840 --> 00:01:55,660
...حسنًا

36
00:01:55,970 --> 00:01:58,880
أيعقل أنّك أتيت بلا سبب؟

37
00:01:58,880 --> 00:02:01,300
.صادف أنّي كنتُ مارًا من هنا

38
00:02:01,300 --> 00:02:03,940
!لـ-لذا أعتقد أنّي سأذهب الآن

39
00:02:03,940 --> 00:02:05,990
.حسنًا، هذا مؤسف

40
00:02:05,990 --> 00:02:09,520
.أرجو أن تزور إيفول كاونتر مجددًا

41
00:02:21,090 --> 00:02:23,530
.لذا أعلم أنّني رأيتُ وجهها جيدًا

42
00:02:23,750 --> 00:02:25,390
...ألينا كلوفر

43
00:02:31,080 --> 00:02:33,160
.اكتُشِف أمري

44
00:02:34,130 --> 00:02:38,340
ربّما عليّ أن أقسو عليه قليلًا
!لأحرص على التزامه بالصمت

45
00:02:38,690 --> 00:02:43,250
لكن بعد التفكير، إنّه شخص ذو شأن
.في النقابة رغم مظهره

46
00:02:44,200 --> 00:02:47,810
.لذا سأُطرَد على أيّ حال إن فعلتُ له أيّ شيء

47
00:02:49,230 --> 00:02:51,610
!هذا سيئ

48
00:02:51,610 --> 00:02:55,100
!لا أريد فعل شيء
!أريد الهرب من الواقع فقط

49
00:02:55,100 --> 00:02:57,820
!لا أريد الخروج

50
00:03:00,540 --> 00:03:03,220
.أريد الاستلقاء في المنزل للأبد

51
00:03:05,360 --> 00:03:09,150
لكنّني استطعت رهن هذا المنزل

52
00:03:09,150 --> 00:03:12,110
لأنّ لدي وظيفة مستقرة وآمنة
.كموظفة استقبال في النقابة

53
00:03:17,340 --> 00:03:20,290
!موظفة استقبال النقابة هي أفضل وظيفة حقًا

54
00:03:20,630 --> 00:03:23,110
!لن أدعهم يطردوني

55
00:04:58,810 --> 00:05:02,310
ما خطب ذلك الشخص على أيّ حال؟

56
00:05:03,110 --> 00:05:07,320
!لا يمكنكم البقاء بعداد المهام للأبد

57
00:05:07,320 --> 00:05:09,280
أيّ تنمر هذا؟

58
00:05:09,810 --> 00:05:12,240
هذا مكان جميل

59
00:05:12,710 --> 00:05:14,610
إنّه هادئ ولا يوجد أشخاص

60
00:05:15,130 --> 00:05:17,580
لم أكن أعلم بوجود مكان كهذا في إيفول

61
00:05:18,170 --> 00:05:19,700
تفعيل المهارة

62
00:05:21,170 --> 00:05:23,590
!مهلًا! لم أفعل أيّ شيء

63
00:05:23,590 --> 00:05:27,340
اخرس! استراحة الغداء هي فرصتي
!الوحيدة للانفراد بنفسي

64
00:05:27,650 --> 00:05:32,060
أخبريني يا ألينا... متى استيقظت
مهارة ضيا لأول مرة؟

65
00:05:37,490 --> 00:05:38,560
.لن أخبرك

66
00:05:39,020 --> 00:05:42,470
.لا تزال شروط استيقاظ المهارات مجهولة

67
00:05:42,470 --> 00:05:44,650
.يعتمد الأمر بالكامل على الحظّ

68
00:05:44,650 --> 00:05:46,650
.مع ذلك استيقظت مهاراتك

69
00:05:46,650 --> 00:05:49,870
أليس العيش كموظفة استقبال
بنقابة مضيعة لها؟

70
00:05:50,540 --> 00:05:54,120
على أيّ حال، لن يفيدك
.البقاء في مكان عملي بشيء

71
00:05:54,610 --> 00:05:57,870
!لن أنضم إلى السيف الفضي أبدًا

72
00:06:01,740 --> 00:06:06,600
لِم سمح الأرباب لموظفة استقبال
بامتلاك هذه المهارة؟

73
00:06:12,810 --> 00:06:14,380
...قبل سنتين، في الصيف

74
00:06:17,490 --> 00:06:21,680
أُقِيم المهرجان المئوي السنوي لإيفول

75
00:06:21,680 --> 00:06:24,020
لمدة ثلاثة أيّام وثلاث ليالي كالعادة

76
00:06:25,730 --> 00:06:29,240
لكن بذلك الوقت كنتُ قد صرت
موظفة استقبال نقابة مؤخرًا

77
00:06:29,240 --> 00:06:32,600
لم أعتد على العمل بعد لذا كنتُ
.أعمل لساعات إضافية يوميًا

78
00:06:34,600 --> 00:06:35,990
.أريد العودة للمنزل

79
00:06:36,600 --> 00:06:38,460
.أريد الذهاب إلى المهرجان

80
00:06:41,320 --> 00:06:42,620
.لا أستطيع فعل هذا

81
00:06:44,060 --> 00:06:48,370
يقال أنّ أكثر شخص يتمنى
بشدة خلال المهرجان المئوي

82
00:06:48,370 --> 00:06:51,000
يُمنح بركة ضيا، صحيح؟

83
00:06:52,780 --> 00:06:55,750
!أتوسل إليك يا ربّي

84
00:06:56,160 --> 00:06:58,640
!أعفني من العمل لوقت إضافي

85
00:07:07,940 --> 00:07:11,110
!انتهيتُ أخيرًا! أستطيع مشاهدة المهرجان قليلًا

86
00:07:26,950 --> 00:07:28,230
.انتهى

87
00:07:32,440 --> 00:07:35,170
.لكنّني بذلت قصارى جهدي

88
00:07:36,420 --> 00:07:38,520
لِم أنا الوحيدة؟

89
00:07:39,490 --> 00:07:41,580
،النقابة التي تدفع مكافآت

90
00:07:42,020 --> 00:07:45,000
المغامرون عديمو الفائدة الذين يعجزون
،حتّى على هزيمة زعيم

91
00:07:45,000 --> 00:07:46,840
...الزعماء الذين يأبون الموت

92
00:07:46,840 --> 00:07:49,570
.أكره كلّ ما يجعلني أعمل لوقت إضافي

93
00:07:52,490 --> 00:07:53,760
.سأقبل أيّ شيء

94
00:07:54,920 --> 00:07:57,950
.أيّ شيء يخلّصني من العمل لوقت إضافي

95
00:07:58,630 --> 00:08:01,030
.أريد قوة كبيرة

96
00:08:01,580 --> 00:08:06,060
!سأتخلص منهم كلهم! كلهم

97
00:08:10,680 --> 00:08:12,340
ما هذا؟

98
00:08:17,520 --> 00:08:18,720
!اللعنة

99
00:08:18,960 --> 00:08:23,220
لن أشعر بتحسن حتّى أبرح
موظفة الاستقبال تلك ضربًا

100
00:08:23,670 --> 00:08:25,990
!لا أصدّق أنّكم أحضرتم واحدًا

101
00:08:25,990 --> 00:08:28,500
!زعيم غارة؟ مثير للإعجاب

102
00:08:28,500 --> 00:08:29,580
.نعم على ما أظن

103
00:08:33,720 --> 00:08:37,320
كيف أجعل ألينا تعيرني اهتمامًا؟

104
00:08:37,770 --> 00:08:41,570
.لا أقصد... تنضم إلى السيف الفضي

105
00:08:44,210 --> 00:08:45,070
ما هذا؟

106
00:08:59,390 --> 00:09:00,450
...هذا

107
00:09:05,350 --> 00:09:06,350
!هاستور

108
00:09:11,790 --> 00:09:12,990
!حسنًا، جذبت انتباهه

109
00:09:13,230 --> 00:09:16,070
!احتموا أثناء تركيزه عليَّ

110
00:09:16,070 --> 00:09:17,990
!لا يمكنك التعامل معه بمفردك

111
00:09:17,990 --> 00:09:19,530
!هذا زعيم غارة لعلمك

112
00:09:19,530 --> 00:09:20,590
!ماذا؟

113
00:09:20,590 --> 00:09:23,340
جعلناه ينام حتّى نستطيع إعادته
،للحصول على المواد

114
00:09:23,340 --> 00:09:25,350
!لكنّه جُنَّ فجأة بعدها

115
00:09:27,500 --> 00:09:29,320
!ها أنت ذا أيّها السيف الفضي

116
00:09:29,320 --> 00:09:30,300
!سلاي

117
00:09:30,300 --> 00:09:32,630
ما رأيك بمهارتي؟

118
00:09:32,630 --> 00:09:34,530
!أنا أتحكم فيه

119
00:09:35,050 --> 00:09:37,630
!إنّه هائج في نومه

120
00:09:37,630 --> 00:09:43,360
سأسحق هذه المدينة بأسرها بما فيها
!أنت وموظفة الاستقبال المزعجة تلك

121
00:09:45,100 --> 00:09:46,600
!هذه سحقة الموت

122
00:09:46,600 --> 00:09:48,100
!اهربوا من هنا رجاء

123
00:09:48,540 --> 00:09:50,250
.عليّ إيقاف هذا الشيء

124
00:09:52,070 --> 00:09:53,600
!تفعيل المهارة

125
00:09:53,600 --> 00:09:55,320
!جدار سيغورث

126
00:09:58,980 --> 00:10:02,530
!سأتلقى كلّ هجماته

127
00:10:03,090 --> 00:10:06,160
!رئيسي اللعين

128
00:10:06,160 --> 00:10:10,420
!"ماذا يقصد بقول "تكفّلي بكل تقارير الدعاوي هذه

129
00:10:10,420 --> 00:10:14,610
لا تعبث معي! سأعلق في العمل
!لوقت إضافي مجددًا

130
00:10:19,220 --> 00:10:20,800
!هيّا

131
00:10:21,170 --> 00:10:23,310
ما كلّ هذه الضجة؟

132
00:10:24,290 --> 00:10:25,810
هل هو المسؤول؟

133
00:10:26,360 --> 00:10:29,230
.حسنًا، إنّه من النوع الذي لا يستمع للشكوى

134
00:10:29,230 --> 00:10:31,490
.لن يفاجئني أيّ شيء قد يفعله

135
00:10:34,190 --> 00:10:36,700
...مهلًا! طار ذلك نحو

136
00:10:37,150 --> 00:10:39,240
!محال! محال! محال! محال

137
00:10:39,530 --> 00:10:41,820
!لا! لا! لا! لا! لا! لا! لا

138
00:10:41,820 --> 00:10:43,330
!لا يعقل

139
00:10:43,330 --> 00:10:45,620
!لا يعقل! لا يعقل

140
00:10:51,820 --> 00:10:54,920
.منزلي

141
00:10:55,500 --> 00:10:56,730
...لا يزال لديَّ

142
00:10:59,350 --> 00:11:02,400
.ثلاثون سنة متبقية على الرهن العقاري

143
00:11:13,860 --> 00:11:18,180
!ذلك المُتذمر الحقير

144
00:11:22,270 --> 00:11:23,360
!سأقتله

145
00:11:27,740 --> 00:11:31,370
!لا يهم كم تجمّع منكم يا ضعفاء

146
00:11:33,380 --> 00:11:35,410
!لا نملك ما يكفي من المقاتلين

147
00:11:35,820 --> 00:11:36,830
ما العمل؟

148
00:11:47,700 --> 00:11:48,310
...ألـ

149
00:11:49,040 --> 00:11:50,180
!الجلّادة

150
00:11:50,550 --> 00:11:54,440
!النقابة بحالة فوضى في محاولة إيجادك

151
00:11:54,440 --> 00:11:58,670
!أراهن أنّهم سيغضبون جدًا إن قتلتك

152
00:12:00,160 --> 00:12:02,680
.كيف تجرؤ على سلب راحتي منّي

153
00:12:04,330 --> 00:12:10,010
كان ذلك المنزل راحتي الوحيدة التي
.حظيتُ بها عندما أرهق من العمل

154
00:12:10,490 --> 00:12:13,170
.واحتي في المجتمع الحديث

155
00:12:14,110 --> 00:12:16,630
.كانت نعيمي الشخصي

156
00:12:18,850 --> 00:12:20,010
!سأقتلك

157
00:12:21,000 --> 00:12:25,050
!سيكون الموت مكافأتك على تدمير نعيمي

158
00:12:25,080 --> 00:12:27,430
!اذهب إلى الجحيم

159
00:12:27,430 --> 00:12:30,970
!أسقطها يا غول الطين

160
00:12:30,970 --> 00:12:34,980
!اهلك معتذرًا أيّها الأحمق العملاق

161
00:12:45,450 --> 00:12:47,450
.محال

162
00:12:50,740 --> 00:12:52,290
!لـ-لا تقتربي

163
00:12:52,290 --> 00:12:53,900
!أيتها الوحش

164
00:12:54,370 --> 00:12:58,670
ألم تتعلّم من قبل

165
00:12:59,000 --> 00:13:01,170
أنّه لا ينبغي أن تكسر أشياء الآخرين؟

166
00:13:01,400 --> 00:13:06,300
!أيها المتذمر الحقير

167
00:13:14,980 --> 00:13:18,270
.خرّب منزلك فعلًا

168
00:13:18,270 --> 00:13:20,780
.هذا كثير جدًا

169
00:13:22,280 --> 00:13:25,520
كيف لي أن أعيش؟

170
00:13:26,540 --> 00:13:28,240
...أ-ألينا

171
00:13:30,290 --> 00:13:32,040
...هـ-هل تودّين

172
00:13:32,610 --> 00:13:34,290
!المكوث في منزلي الليلة؟

173
00:13:34,290 --> 00:13:36,510
هلّا تكف عن المزاح الآن؟

174
00:13:36,510 --> 00:13:38,790
.سأمكث في نزل بكل وضوح

175
00:13:39,520 --> 00:13:43,990
عليّ العمل لوقت إضافي الآن
.بسبب ذلك المُتذمّر الحقير

176
00:13:44,480 --> 00:13:46,040
.انقلع فقط

177
00:13:49,700 --> 00:13:52,680
ظهرت الجلادة في هذا المكان إذًا؟

178
00:13:52,920 --> 00:13:55,470
.نعم، هذا ما سمعته

179
00:13:55,470 --> 00:13:58,940
،أنا ممتن أنّ الجلادة حمت إيفول

180
00:13:58,940 --> 00:14:01,940
.لكن قدومها إلى هنا كان خطأ فادحًا

181
00:14:02,180 --> 00:14:03,900
.تفعيل المهارة

182
00:14:05,190 --> 00:14:07,420
!سيغورث كرونوس

183
00:14:12,950 --> 00:14:16,530
تدمّر منزلي وأنا عالقة في
.العمل الإضافي على أيّ حال

184
00:14:16,530 --> 00:14:19,750
!سألعن ذلك المتذمّر الحقير وكلّ أحفاده

185
00:14:19,750 --> 00:14:22,670
...لا... أعرف حقًا ماذا أقول ولكن

186
00:14:23,660 --> 00:14:25,420
.ابتهجي يا ألينا

187
00:14:25,660 --> 00:14:30,010
.أخبرتك أن تنقلع
لِم أنت هنا على أيّ حال؟

188
00:14:30,270 --> 00:14:33,470
...بعد ما حدث اليوم
فقط من باب الاحتياط

189
00:14:36,980 --> 00:14:40,180
.حسنًا، إنّه عضو رفيع المستوى في النقابة

190
00:14:40,180 --> 00:14:42,760
.إنّه يملك الحق في التواجد بالمكتب

191
00:14:43,140 --> 00:14:48,490
ألا تظنين أنّ هذا وقت مناسب للتوقف اليوم؟

192
00:14:48,940 --> 00:14:50,310
.صحيح

193
00:14:50,310 --> 00:14:52,190
،مرّت عليّ أوقات لم أكن فيها بمزاج للعمل

194
00:14:52,190 --> 00:14:56,080
لذا فكرتُ في تأجيله
.ليوم أكون متحفزة فيه أكثر

195
00:14:56,960 --> 00:14:59,330
...لكنّني أدركتُ بعدها

196
00:14:59,330 --> 00:15:02,860
على ألينا من الغد التعامل
!مع كسل ألينا من اليوم

197
00:15:02,860 --> 00:15:05,550
وعلاوة على ذلك، من سابع
المستحيلات أن أتحفز

198
00:15:05,550 --> 00:15:08,970
!للعمل لوقت إضافي

199
00:15:08,970 --> 00:15:11,180
لذا سأنهيه كلّه اليوم

200
00:15:11,180 --> 00:15:15,810
!وأخرج في الوقت المحدد غدًا

201
00:15:13,610 --> 00:15:17,700
.لا أدري إن كنتِ متحمسة أم لا

202
00:15:18,880 --> 00:15:21,180
.حسنًا، أكملتُ هذه الاستمارات

203
00:15:21,180 --> 00:15:22,670
ماذا؟ بالفعل؟

204
00:15:23,220 --> 00:15:26,290
كانت هناك بعض الأخطاء والخانات
.الفارغة لذا أصلحتُها

205
00:15:28,530 --> 00:15:30,500
.أعدّها كلّها بشكل صحيح

206
00:15:30,500 --> 00:15:32,400
.كما أنّها مرتبة أيضًا

207
00:15:33,300 --> 00:15:38,910
أهُو من النوع القادر على فعل أيّ شيء
بشكل صحيح من أول مرة بأقل قدر من التعليمات؟

208
00:15:38,910 --> 00:15:44,960
وأنا من النّوع الأخرق الذي عليه أن يخطو
على كلّ لغم وارتكاب كلّ خطأ

209
00:15:44,960 --> 00:15:46,490
.قبل أن يتعلم أيّ شيء

210
00:15:49,120 --> 00:15:50,040
.أنت تغضبني

211
00:15:52,050 --> 00:15:53,260
!أنت تغضبني

212
00:15:53,260 --> 00:15:55,600
.قضيتُ ثلاث سنوات أتحمل الألم باكية

213
00:15:55,880 --> 00:15:58,140
.وتظهر فجأة وتتخطى كلّ الصعاب وكأنّها لا شيء

214
00:15:58,140 --> 00:16:00,100
الأشخاص من أمثالك

215
00:16:00,450 --> 00:16:03,980
!هُم أكثر ما يغضبني

216
00:16:06,300 --> 00:16:09,700
لِم العالم ظالم لهذا الحد؟

217
00:16:09,700 --> 00:16:14,660
!حسنًا... هذا بسبب تعليمك الجيد فقط

218
00:16:15,860 --> 00:16:18,990
.يُولَد البشر غير متساوين

219
00:16:19,280 --> 00:16:22,310
.حسنًا، اتركي البقية لي

220
00:16:22,310 --> 00:16:24,010
.سأنهي كلّ شيء

221
00:16:24,010 --> 00:16:28,650
لن يسمح لي كبريائي كموظفة
!استقبال بالإفلات من هذا

222
00:16:28,650 --> 00:16:31,910
.فكرة. الحلويات تنفع دائمًا عندما تكون متعبًا

223
00:16:33,310 --> 00:16:34,260
...هذا

224
00:16:35,230 --> 00:16:38,010
.الشيء الذي حطمته ذلك اليوم

225
00:16:38,980 --> 00:16:40,510
الأثر؟

226
00:16:40,510 --> 00:16:41,980
.مكتوب عليها شيء ما

227
00:16:42,290 --> 00:16:45,020
نظام... مهمة"؟"

228
00:16:46,360 --> 00:16:47,200
!تراجعي

229
00:16:52,880 --> 00:16:54,820
ما هذا؟

230
00:16:58,640 --> 00:17:03,030
"شروط الإكمال: هزيمة كلّ زعماء الطوابق"

231
00:17:03,030 --> 00:17:06,830
قبول هذه المهمة معترف به"
"وفقًا للشروط الموضحة أعلاه

232
00:17:10,710 --> 00:17:13,100
أكانت هذه استمارة مهمة؟

233
00:17:13,620 --> 00:17:14,840
.صحيح

234
00:17:15,190 --> 00:17:16,940
...برج الطباشير

235
00:17:17,710 --> 00:17:19,310
.لم أسمع به من قبل

236
00:17:19,310 --> 00:17:21,500
.نعم، كم هذا غريب

237
00:17:22,030 --> 00:17:24,580
.حسنًا، سأدع ذلك الأثر الغريب لك

238
00:17:24,580 --> 00:17:26,980
.يمكنك أنت والسيف الفضي التعامل معه

239
00:17:27,390 --> 00:17:32,150
ألينا... أنت تحاولين التظاهر
أنّك لم تري ذلك، صحيح؟

240
00:17:32,150 --> 00:17:33,430
!بالطبع

241
00:17:33,430 --> 00:17:37,280
.هذا صداع لا علاقة لي بي

242
00:17:37,500 --> 00:17:39,570
.نعم، أظنك محقة

243
00:17:40,610 --> 00:17:41,740
...حسنًا، حاليًا

244
00:17:42,360 --> 00:17:43,840
.أظنني سأبحث في الأمر

245
00:17:48,410 --> 00:17:50,920
لِم يحدث هذا دائمًا؟

246
00:17:50,920 --> 00:17:55,130
ألم يكن ما فعله الجلّاد مذهلًا؟

247
00:17:55,130 --> 00:17:58,170
!الخبر منتشر في كلّ الصحف

248
00:17:58,700 --> 00:18:00,050
.صحيح

249
00:18:02,430 --> 00:18:06,180
...آنسة ألينا، أيعقل أنّك

250
00:18:09,190 --> 00:18:14,650
معجبة بالجلاد؟

251
00:18:14,650 --> 00:18:19,810
هيّا! أنا أقصد ما إن كنتِ معجبة
بـ جايد أو بالجلّاد

252
00:18:19,810 --> 00:18:25,350
!يحظى الجلّاد بشعبية مثل شعبية جايد الآن

253
00:18:26,430 --> 00:18:30,720
!أنا من معجبي الجلّاد

254
00:18:30,720 --> 00:18:32,340
رغم أنّك لا تستطيعين حتّى رؤية وجهه؟

255
00:18:32,340 --> 00:18:35,520
!لا بدّ أنّ هناك رجلًا وسيمًا تحت تلك القلنسوة

256
00:18:35,520 --> 00:18:37,760
!هذه حقيقة ثابتة

257
00:18:37,760 --> 00:18:41,200
!إنّه البطل الذي أنقذ إيفول

258
00:18:41,200 --> 00:18:45,060
ولا يكشف عن نفسه أبدًا حتّى
!مع وجود مكافأة للمطالبة بها

259
00:18:45,860 --> 00:18:47,930
!إنّه رائع جدًا

260
00:18:47,930 --> 00:18:51,560
...آمل أن يضربني بتلك المطرقة الكبيرة

261
00:18:53,340 --> 00:18:55,400
!أقصد يحميني

262
00:18:55,640 --> 00:18:59,540
!كما أنّه قاتل إلى جانب جايد العظيم

263
00:18:59,540 --> 00:19:03,280
أقوى وأوسم مدافع
!وأقوى وأوسم مهاجم

264
00:19:03,280 --> 00:19:07,000
!هذا يجعل خيالي يفيض

265
00:19:07,340 --> 00:19:10,950
.صحيح. لا بأس ما دمت سعيدة

266
00:19:25,520 --> 00:19:28,310
رئيس النقابة، غلين غاريا؟

267
00:19:28,910 --> 00:19:33,530
.سمعتُ أنّ المدعو بالجلاد حقق الكثير

268
00:19:33,530 --> 00:19:36,360
.أثار الأمر فضولي

269
00:19:38,280 --> 00:19:41,440
لـ-لِم يتجه إليّ؟

270
00:19:42,380 --> 00:19:46,410
كيف تسير الأمور يا موظفة الاستقبال الظريفة؟

271
00:19:46,410 --> 00:19:48,800
.بـ-بلا مشاكل في معظم الأحيان

272
00:19:48,800 --> 00:19:51,830
.أهذا صحيح؟ يسرني سماع هذا

273
00:19:51,830 --> 00:19:55,590
بالمناسبة، هل تعرفين مهارتي؟

274
00:19:55,590 --> 00:19:57,140
.بالطبع

275
00:20:00,520 --> 00:20:03,180
.تسمح لك بمراقبة أحدث الماضي

276
00:20:05,270 --> 00:20:06,780
!صحيح

277
00:20:06,780 --> 00:20:09,140
.كما هو متوقع من موظفة استقبال

278
00:20:10,250 --> 00:20:13,690
يستطيع إذًا إعادة الزمن للخلف
في ساحة البلدة

279
00:20:13,690 --> 00:20:15,690
.ويرى وجه الجلاد

280
00:20:17,940 --> 00:20:21,900
.لا ينبغي أن نتحدث هنا
.تعالي إلى مقر النقابة

281
00:20:28,960 --> 00:20:30,130
...إنّه يعرف

282
00:20:30,500 --> 00:20:32,910
.يعرف. يعرف. يعرف

283
00:20:32,910 --> 00:20:36,460
.كنتُ أعلم أن أمري سيُكتَشف في النهاية وقد حدث ذلك بالفعل

284
00:20:36,720 --> 00:20:38,390
.سأُطرَد

285
00:20:38,390 --> 00:20:40,860
،أعلم أنّ رئيس النقابة يبدو صارمًا

286
00:20:40,860 --> 00:20:42,990
.لكنّه سيتفهم إن تحدثتِ معه

287
00:20:42,990 --> 00:20:44,360
.اخرس أيّها الواشي

288
00:20:44,360 --> 00:20:46,930
!لم أشي بك! عليك أن تصدّقيني

289
00:20:46,930 --> 00:20:51,640
أكرهك. آمل أن تضرب خنصر قدمك
.بخزانة ملابس وتموت

290
00:20:53,520 --> 00:20:55,490
...تـ-تكرهينني

291
00:20:55,880 --> 00:20:59,190
،نعتتني بالحقارة وأخبرتني أن أموت وأنقلع

292
00:20:59,190 --> 00:21:03,410
لكنّ فكرة أنّها لم تكرهني كانت
.النقطة المنقذة بالنسبة لي

293
00:21:04,150 --> 00:21:07,920
...يبدو أنّها كانت تكرهك بالفعل منذ البداية

294
00:21:08,900 --> 00:21:12,580
.لا تحطمي رجلًا أثناء إحباطه

295
00:21:13,410 --> 00:21:15,120
!لكنّها الحقيقة

296
00:21:15,120 --> 00:21:17,540
.الرجال العاشقون كائنات حساسة

297
00:21:18,130 --> 00:21:20,360
جايد واقع في الحب إذًا؟

298
00:21:20,670 --> 00:21:25,470
جايد الذي لم يلتفت لأيّ فتاة ظريفة تأتي إليه؟

299
00:21:25,470 --> 00:21:29,280
...أريد تشجيعه لكن لا يبدو أنّ لديه فرصة

300
00:21:30,100 --> 00:21:32,930
يا لولولي؟

301
00:21:32,930 --> 00:21:35,680
...إن كان خنصر مصاب كافيًا لقتلي

302
00:21:34,900 --> 00:21:36,310
...على أيّ حال

303
00:21:36,310 --> 00:21:39,850
هل أنت متأكد أنّ هذه الفتاة هي الجلّاد؟

304
00:21:39,850 --> 00:21:42,810
.لا تبدو لي سوى موظفة استقبال

305
00:21:49,370 --> 00:21:52,370
.أعتذر لجعلك تأتين إلى هنا

306
00:21:54,820 --> 00:21:56,830
ما الذي تريد مناقشته معي؟

307
00:21:58,070 --> 00:22:01,090
كلّما نظرتُ إليك أكثر، لا تبدين
.لي سوى كموظفة استقبال عادية

308
00:22:01,570 --> 00:22:06,590
هل لديك فكرة عن الصدمة التي شعرتُ بها
عندما أرتني مهارتي وجه الجلاد؟

309
00:22:07,060 --> 00:22:10,220
هل استدعيتني لتقول لي هذا الكلام؟

310
00:22:15,200 --> 00:22:18,240
!أتحداك في مبارزة يا جلّادة

311
00:23:53,290 --> 00:23:54,240
،الحلقة القادمة

312
00:23:54,240 --> 00:23:58,190
قد أكون مدافع السيف الفضي"
"لكنّني أريد مواجهة ديماس صعب جدًا