1
00:00:05,850 --> 00:00:07,220
.المشعوذة السّوداء لونا

2
00:00:08,710 --> 00:00:10,500
.كانت قدري

3
00:00:12,190 --> 00:00:14,270
.أعزّ عليّ من أيّ أحد

4
00:00:16,190 --> 00:00:17,930
.شخص لن أنساه أبدًا

5
00:00:19,480 --> 00:00:20,840
.محبوبتي

6
00:01:36,240 --> 00:01:45,410
مشعوذة الفطر

7
00:01:52,770 --> 00:01:59,070
الحلقة 3
الطّفل الملعون

8
00:02:00,840 --> 00:02:03,830
.لونا، جرف النّهر شخصًا ما

9
00:02:09,730 --> 00:02:11,240
.يبدو مصابًا

10
00:02:11,770 --> 00:02:14,100
.إنّه ينزف كثيرًا

11
00:02:15,990 --> 00:02:17,320
.أتساءل ما الّذي حدث له

12
00:02:17,320 --> 00:02:19,820
.ربّما وقع من الجرف هناك

13
00:02:20,200 --> 00:02:22,540
.يقع النّاس منه أحيانًا

14
00:02:23,830 --> 00:02:27,130
.لكن إن كان قد وقع، لكان ميتًا

15
00:02:28,670 --> 00:02:33,240
!انظروا! هناك من طعنه بسكّين

16
00:02:33,570 --> 00:02:38,530
ماذا؟ إذًا هل يعني هذا أنّ وقوعه
في النّهر لم يكن حادثًا؟

17
00:02:39,080 --> 00:02:41,090
...لكنّه ما زال يتنفّس

18
00:02:41,510 --> 00:02:43,190
.أعتقد أنّه ولد أيضًا

19
00:02:43,190 --> 00:02:44,890
ما الّذي ستفعلينه يا لونا؟

20
00:02:48,030 --> 00:02:49,170
لونا؟

21
00:02:51,340 --> 00:02:53,610
،عندما أخبرتني عن هذا اليوم لاحقًا

22
00:02:53,950 --> 00:02:58,630
قالت المشعوذة أنّي بدوت
.جميلاً جمالَ دمية بالنّسبة لها

23
00:03:00,100 --> 00:03:01,610
،كانت قلقة من أنّها إن لمستني

24
00:03:02,150 --> 00:03:07,270
فإنّ سمّها سيُذيب كلّ ذلك الجمال في الحال

25
00:03:07,900 --> 00:03:14,620
.أو قد يحوّله بالكامل ويجعلني شيئًا آخر تمامًا

26
00:03:15,570 --> 00:03:20,380
،قالت أنّها عندما فكّرت في ذلك
.صارت عاجزة عن الحركة

27
00:03:24,670 --> 00:03:27,270
"مرحبًا! مرّ وقت طويل، صحيح؟"

28
00:03:30,140 --> 00:03:32,380
ثمّ عمّ نتحدّث بعد ذلك؟

29
00:03:35,160 --> 00:03:38,150
فكّرتُ في المرور لزيارتك رغم"
".بشاعتك من باب التّغيير

30
00:03:38,990 --> 00:03:41,230
.لا. لا يبدو ذلك صائبًا أيضًا

31
00:03:41,990 --> 00:03:47,770
أحتاج لشيء ربّما يكون طبيعيًّا أكثر؟
.نعم، هذا هو

32
00:03:49,070 --> 00:03:52,030
"أتعرفين أيّ فطر يصلح للرّيش اللاّمع؟"

33
00:03:52,730 --> 00:03:54,660
.نعم. سأختار هذا

34
00:04:01,170 --> 00:04:02,040
.مرحبًا

35
00:04:03,000 --> 00:04:04,500
ما الّذي تفعلونه؟

36
00:04:05,050 --> 00:04:06,690
!كلود

37
00:04:07,950 --> 00:04:10,760
.أتيت في الوقت المناسب يا كلود

38
00:04:10,760 --> 00:04:13,670
.نحتاج لحمل هذا الولد معنا للمنزل

39
00:04:15,390 --> 00:04:17,410
...مهلاً. أهذا

40
00:04:19,940 --> 00:04:23,820
يطفو كينوبيو على الماء ولا يمكنه
.الوقوف بشكل مستقيم

41
00:04:27,290 --> 00:04:31,500
.هيّا ساعدنا! لا تستطيع لونا لمسه أيضًا

42
00:04:30,580 --> 00:04:34,120
.ذلك الوجه... واثق أنّي رأيته من قبل

43
00:04:31,500 --> 00:04:33,910
!لكن علينا مساعدته بسرعة وإلاّ فات الأوان

44
00:04:35,580 --> 00:04:39,030
.إن لم نسرع، فسيموت بكلّ تأكيد

45
00:04:44,090 --> 00:04:45,090
!كلود

46
00:04:49,580 --> 00:04:50,600
.رجاءً

47
00:04:50,950 --> 00:04:53,960
ماذا؟ لماذا عليّ حمله؟

48
00:04:55,260 --> 00:04:57,970
.أخبرك دائمًا أن تبتعدي عن المشاكل

49
00:04:57,970 --> 00:05:01,620
.كنتُ أريد تقديم شيء ما لك

50
00:05:02,140 --> 00:05:04,790
.عثرتُ على حجارة جميلة في النّهر

51
00:05:11,190 --> 00:05:14,340
.بذلت لونا الكثير من الجهد في البحث عنها

52
00:05:17,650 --> 00:05:21,380
...ماذا؟ أتعتقدين فعلاً أنّي
...سأقع ضحيّةً

53
00:05:22,010 --> 00:05:23,530
لخدعة كهذه؟

54
00:05:34,360 --> 00:05:36,080
.شكرًا لك يا كلود

55
00:05:36,080 --> 00:05:39,340
ينجذب الغربان للأشياء اللاّمعة
.كما تنجذب القطط للنّعناع البرّيّ

56
00:05:39,340 --> 00:05:42,300
!اخرسي أيّتها البقرة! سأحوّلك للحم مشويّ

57
00:05:42,300 --> 00:05:43,650
!هذا مخيف

58
00:05:45,410 --> 00:05:47,650
ماذا الآن؟

59
00:05:47,970 --> 00:05:53,160
فقد الكثير من الدّماء سلفًا. أشكّ
...في أنّ بوسعك فعل شيء لإنقاذه

60
00:05:53,650 --> 00:05:54,600
.الآن

61
00:05:55,910 --> 00:05:59,920
.كانت تفوح منه رائحة سمّ مذ وجدتُه

62
00:05:59,920 --> 00:06:01,050
سمّ؟

63
00:06:02,530 --> 00:06:03,920
ما معنى ذلك؟

64
00:06:04,470 --> 00:06:09,430
.لستُ واثقة، لكن ربّما طُلي السّكّين بالسّمّ

65
00:06:09,430 --> 00:06:12,430
.على أيّ حال، عليّ أن أحاول سحبه

66
00:06:26,460 --> 00:06:27,690
!إنّه فطر ملعون

67
00:06:29,200 --> 00:06:32,200
هل لُعن السّكّين بذلك؟

68
00:06:37,900 --> 00:06:38,990
.لا، مهلاً

69
00:06:40,440 --> 00:06:41,710
.ثمّة المزيد

70
00:06:48,220 --> 00:06:52,220
مهلاً يا لونا، ما الّذي يحدث؟

71
00:07:01,220 --> 00:07:02,230
ما هذا الشّيء؟

72
00:07:02,640 --> 00:07:06,500
،إنّه يخنق الهواء ويشوّه صفاءه فورًا

73
00:07:07,230 --> 00:07:09,740
.كأنّه نذير شؤم لا يوصف

74
00:07:12,620 --> 00:07:14,240
.أنا أعرفه

75
00:07:14,650 --> 00:07:18,750
.أعرف أيّ نوع من الفطر يكون هذا

76
00:07:21,290 --> 00:07:22,210
!تراجعا

77
00:07:26,120 --> 00:07:29,900
!لونا

78
00:07:45,710 --> 00:07:46,400
!لونا

79
00:07:47,610 --> 00:07:48,740
!هل أنت بخير؟

80
00:07:48,740 --> 00:07:51,900
!لا تقتربوا كثيرًا... منّي

81
00:07:53,050 --> 00:07:54,130
أأنت بخير؟

82
00:07:56,900 --> 00:07:59,910
ما كلّ هذا الشّيء الّذي حولك؟ وبالة؟

83
00:08:00,300 --> 00:08:02,920
...هل ذلك الشّيء

84
00:08:05,190 --> 00:08:08,670
!لونا؟ لونا

85
00:08:36,510 --> 00:08:37,950
.عجبًا

86
00:08:39,670 --> 00:08:40,830
.مرحبًا يا لونا

87
00:08:41,750 --> 00:08:42,870
.سيّدي

88
00:08:43,870 --> 00:08:48,840
انظري لحالك. هل امتصصت
سمًّا لا يمكنك تحمّله يا ترى؟

89
00:08:50,940 --> 00:08:52,550
.فهمت

90
00:08:53,340 --> 00:08:56,000
إذًا فقد قابلتِ أخيرًا

91
00:08:56,000 --> 00:08:59,540
،"ذلك الّذي قُدّر له أن يكون "نهاية كلّ شيء

92
00:08:59,540 --> 00:09:01,520
.الطّفل الملعون

93
00:09:01,850 --> 00:09:02,950
!الطّفل الملعون

94
00:09:04,090 --> 00:09:09,060
.اقتربي يا لونا
.اتركي كلّ سمّك المتدفّق معي

95
00:09:10,780 --> 00:09:16,260
"إنّ السّمّ من "نهاية كلّ شيء
.كثير حتّى عليك أنت

96
00:09:19,640 --> 00:09:23,170
.كان الفتى في غاية الجمال

97
00:09:24,650 --> 00:09:28,860
كان بإمكاني الشّعور بذلك
.من الفطر الّذي سحبتُ منه

98
00:09:29,700 --> 00:09:31,740
.كأنّ روحه كانت في غاية الصّفاء

99
00:09:32,870 --> 00:09:38,820
وقد يكون ذلك بالضّبط ما
."يجعله يصير "نهاية كلّ شيء

100
00:09:42,390 --> 00:09:43,610
...لونا

101
00:09:44,780 --> 00:09:47,770
.كما هو، كذلك أنت أيضًا

102
00:09:52,030 --> 00:09:56,530
،بخصوص ذلك الطّفل
.بإمكانك أن تفعلي ما تشائين به

103
00:09:58,670 --> 00:10:04,440
.سأظلّ هنا، أرعى كلاكما حتّى أذبل وأتلاشى

104
00:10:06,210 --> 00:10:13,720
!لونا

105
00:10:09,430 --> 00:10:12,380
سُحقًا. أين هي؟

106
00:10:13,720 --> 00:10:15,510
.لا يمكنني العثور عليها

107
00:10:15,510 --> 00:10:17,880
أتعتقد أنّها بخير؟

108
00:10:28,850 --> 00:10:30,400
!لونا

109
00:10:30,940 --> 00:10:35,150
!لونا! أين ذهبت؟ قلقنا كثيرًا عليك

110
00:10:35,600 --> 00:10:38,150
!مرحى! اختفى كلّ ذلك السّواد عنك

111
00:10:38,630 --> 00:10:39,740
.أنا آسفة

112
00:10:40,200 --> 00:10:45,660
لا بأس! كان عليّ البقاء برفقة
!كلود وحدي. كان عملاً صعبًا

113
00:10:46,370 --> 00:10:49,410
بل بالأحرى، ظللت تلاحقيني
.ولم تكفّي عن الكلام

114
00:10:50,610 --> 00:10:52,770
!توقّف أيّها الغراب القاسي

115
00:10:52,770 --> 00:10:56,730
.كان كلود يراقب الفتى

116
00:10:52,770 --> 00:10:57,010
فعلاً أيّتها البقرة؟! واصلي هذا
!وسأحوّلك للحم مشويّ بالفعل

117
00:10:56,730 --> 00:11:00,430
!توقّف! ضعني أرضًا

118
00:10:57,010 --> 00:11:00,430
أتفضّلين أن تصيري شريحة؟
أو ربّمّا سأحوّلك للحم مفروم؟

119
00:10:59,420 --> 00:11:00,430
.كلود

120
00:11:00,690 --> 00:11:02,430
!يكفي

121
00:11:01,320 --> 00:11:02,430
.شكرًا لك

122
00:11:04,330 --> 00:11:06,950
.ما زال الفتى على قيد الحياة

123
00:11:07,810 --> 00:11:10,590
.لكن هنالك ما يبدو غريبًا

124
00:11:13,870 --> 00:11:16,040
.صار جسده أصغر

125
00:11:16,430 --> 00:11:17,960
أرأيت؟ هذا غريب، صحيح؟

126
00:11:18,690 --> 00:11:22,160
عندما وجدناه، كان يبدو
.وكأنّه في الخامسة عشرة

127
00:11:22,160 --> 00:11:24,790
.أمّا الآن، يبدو كأنّه في السّادسة

128
00:11:25,640 --> 00:11:28,530
حدث ذلك بعد أن أخرجتِ
.ذلك الفطر المخيف منه

129
00:11:28,530 --> 00:11:30,880
.لكن لا يمكنني الجزم متى

130
00:11:30,880 --> 00:11:36,750
،لونا، عندما سحبت ذلك الفطر منه
هل استعملت تعويذة شباب عليه؟

131
00:11:38,070 --> 00:11:41,220
.لكن لم يكن لديها وقت لذلك

132
00:11:41,660 --> 00:11:42,490
.اسمعي

133
00:11:42,810 --> 00:11:46,190
لديّ فكرة عن المكان
.الّذي أتى منه بالنّظر لملابسه

134
00:11:46,510 --> 00:11:49,180
إن كنتُ محقًّا، فإنّ التّورّط
—مع هذا الفتى قد

135
00:11:49,180 --> 00:11:50,180
!كلود

136
00:11:51,340 --> 00:11:55,270
.أنا أرجوك، لا تخبر أيّ أحد عنه

137
00:11:55,940 --> 00:11:56,720
ماذا؟

138
00:11:56,720 --> 00:11:58,910
.أو عن الفطر الّذي رأيناه اليوم

139
00:11:59,580 --> 00:12:02,920
عمّ تتحدّثين؟
!لا يمكنني الاحتفاظ بهذا السّرّ

140
00:12:02,920 --> 00:12:03,900
!أرجوك

141
00:12:04,320 --> 00:12:08,650
قولي ما لديك إذًا! إنّك تتصرّفين
بغرابة فجأة. ماذا حدث؟

142
00:12:10,920 --> 00:12:12,280
...في الحقيقة

143
00:12:13,070 --> 00:12:14,580
.يا مشعوذة الفطر

144
00:12:18,650 --> 00:12:19,800
،اعتبارًا من هذه اللّحظة

145
00:12:19,800 --> 00:12:23,760
سنعقد اجتماعًا طارئًا للمشعوذين السّود

146
00:12:24,260 --> 00:12:29,260
للبتّ في الحكم الّذي تستحقّينه على
.المخالفة الجسيمة الّتي ارتكبتها لتوّك

147
00:12:29,540 --> 00:12:34,020
،تدركين تمامًا أيّ مخالفة أعني
أليس كذلك يا لونا؟

148
00:12:34,620 --> 00:12:35,910
!لقد عرفوا

149
00:12:37,810 --> 00:12:43,610
نظرًا لأنّك اخترت هذا التّوقيت
،لارتكاب مخالفة بهذه الخطورة

150
00:12:44,070 --> 00:12:49,120
فقد قرّرنا عقد اجتماع طارئ
.لمجلس المشعوذين السّود

151
00:12:49,550 --> 00:12:52,670
مجلس المشعوذين السّود؟
!هذا غير معقول

152
00:12:53,120 --> 00:12:57,360
عندما يودّ المشعوذون السّود
،اتّخاذ قرار مهمّ

153
00:12:57,360 --> 00:13:00,630
فإنّهم يجمعون الأعضاء الأعلى
.رتبة لإقامة اجتماع كهذا

154
00:13:00,630 --> 00:13:04,280
لكن لماذا يسعون خلف مشعوذة
صغيرة الشّأن مثل لونا؟

155
00:13:08,300 --> 00:13:09,150
.لونا

156
00:13:10,100 --> 00:13:12,640
.لا، يا مشعوذة الفطر

157
00:13:13,070 --> 00:13:16,770
لا بدّ أنّك تدركين مدى الخطر
الجسيم الّذي سيتعرّض له العالم

158
00:13:16,770 --> 00:13:18,530
.لو أنّك أويتِ ذلك الكائن

159
00:13:19,930 --> 00:13:22,340
أكنت تظنّين أنّ بإمكانك خداعنا؟

160
00:13:23,140 --> 00:13:26,270
عرفتُ هذا. ذلك الشّقيّ
.هو أساس كلّ هذه المشاكل

161
00:13:28,050 --> 00:13:30,370
.رأيتُ لوحة له من قبل

162
00:13:31,010 --> 00:13:34,700
وفي هذه البلاد، وحدهم العائلة
.الملكيّة من تُرسم لهم لوحات كتلك

163
00:13:35,750 --> 00:13:40,710
ونظرًا لملابسه، أراهن أنّه نبيل من مستوى
.رفيع من سلالة مشعوذة بيضاء

164
00:13:40,710 --> 00:13:43,630
.وأنّه على الأرجح وريث العرش

165
00:13:44,740 --> 00:13:50,340
،إن سلّمته لنا في الحال
،فسنسامحك على خيانتك

166
00:13:50,340 --> 00:13:52,750
.وسنعتبر الأمر مجرّد سوء تقدير

167
00:13:53,530 --> 00:13:57,500
.تدافع مشعوذة الماء عن هذا بشدّة
.ينبغي أن تكوني ممتنّة

168
00:13:58,810 --> 00:14:04,170
يا إلهي. أيمكنك ألاّ تفسد الأمر بالكامل؟

169
00:14:11,340 --> 00:14:12,900
.اسمعي يا لونا

170
00:14:13,710 --> 00:14:19,080
.يمكن لأيّ أحد أن يسيء الحكم
—قد يكون هذا صعبًا، لكن عليك

171
00:14:19,490 --> 00:14:24,920
،استعملتُ فطرًا لسحب كلّ السّمّ من جسده

172
00:14:24,920 --> 00:14:26,980
.وقد تمّ تحييده سلفًا

173
00:14:29,020 --> 00:14:29,750
ماذا؟

174
00:14:30,860 --> 00:14:35,220
إنّ الفتى لا يشكّل أيّ خطر
.على العالم على الإطلاق الآن

175
00:14:35,220 --> 00:14:36,100
!أرجوكم

176
00:14:37,030 --> 00:14:39,100
خطر على العالم؟

177
00:14:39,590 --> 00:14:40,580
.مهلاً لحظة

178
00:14:41,100 --> 00:14:42,610
...هل تقول

179
00:14:42,610 --> 00:14:46,040
أنّها قامت بتحييد السّمّ من ذلك الفطر

180
00:14:46,040 --> 00:14:48,770
الفظيع الّذي يفوق التّصوّر بهذه السّرعة؟

181
00:14:50,110 --> 00:14:53,980
،أعرف أنّها مشعوذة سمّ
لكن هل من السّهل حقًّا فعل ذلك؟

182
00:14:54,590 --> 00:14:59,900
وكيف كان قادرًا على حمل سمّ
فظيع كهذا بداخله في كلّ الأحوال؟

183
00:14:59,900 --> 00:15:01,400
ما معنى كلّ هذا؟

184
00:15:03,030 --> 00:15:04,120
فعلاً؟

185
00:15:04,120 --> 00:15:07,670
...كنتُ أشاهدها عندما أزالت الفطر، لكن

186
00:15:08,340 --> 00:15:10,380
تمّ تطهيره سلفًا؟

187
00:15:10,380 --> 00:15:12,960
.ربّما يكون كلّ هذا مجرّد كذبة يائسة

188
00:15:12,960 --> 00:15:16,470
.مذهل. كم أنتم سريعو الشّكّ

189
00:15:16,890 --> 00:15:19,980
.واضح أنّكم تستخفّون بلونا كثيرًا

190
00:15:20,740 --> 00:15:25,380
،أمّا أنا من جهة أخرى
.كنتُ أعرف دائمًا أنّها فتاة موهوبة

191
00:15:25,380 --> 00:15:28,530
إنّ تفاخرك هذا صفة لا تدعو
.للحسد على الإطلاق

192
00:15:29,070 --> 00:15:34,160
.لا يبدو هذا المجلس رسميًّا كثيرًا
.والسّبب هو السّمكة على الأغلب

193
00:15:35,230 --> 00:15:36,660
.لكنّ ذلك ليس مهمًّا هنا

194
00:15:36,660 --> 00:15:38,720
،تبدو أجساد المشعوذين السّود حقيقيّة

195
00:15:38,720 --> 00:15:41,750
لكنّ هذه كلّها مجرّد إسقاطات روحيّة، صحيح؟

196
00:15:42,170 --> 00:15:47,170
إنّ تلك المهارة وحدها تعني
.أنّ قواهم السّحريّة تفوق التّصوّر

197
00:15:47,170 --> 00:15:52,520
ماذا الآن يا لونا؟ لن تستطيعي
.التّخلّص من هذا بسهولة

198
00:15:53,610 --> 00:15:57,330
لا أهتمّ بالتّفاخر، لكن ربّما
.ليس عليك التّساهل عليها كثيرًا

199
00:15:57,930 --> 00:16:03,300
هل من الخطأ إظهارُ قليلٍ من الرّحمة
بينما ما تزال أمامها حياة كاملة؟

200
00:16:03,950 --> 00:16:06,680
.إنّكم تعاملونها جميعًا بشكل قاسٍ

201
00:16:07,370 --> 00:16:10,560
.لا، بل أنت من تتساهلين كثيرًا معها
.ولا تأخذين الأمر على محمل الجدّ

202
00:16:10,560 --> 00:16:12,740
!ماذا؟ مستحيل

203
00:16:12,740 --> 00:16:15,080
ما قصّة القناع إذًا؟

204
00:16:15,740 --> 00:16:20,200
يرتدون الأقنعة لصدّ سحر المشعوذين
،البيض لذلك لا أعرف وجوههم

205
00:16:21,060 --> 00:16:24,600
لكنّ سيّدي أخبرني مرّة
.من يكون أعضاء المجلس

206
00:16:25,070 --> 00:16:28,020
.أفترض أنّ ذلك هو مشعوذ اللّهب

207
00:16:28,020 --> 00:16:29,790
.إنّ ذلك يشتّت انتباهنا عن العمل

208
00:16:28,020 --> 00:16:35,720
مشعوذ اللّهب

209
00:16:30,330 --> 00:16:33,950
.نعم، من المزعج النّظر له بكلّ تأكيد

210
00:16:34,580 --> 00:16:36,820
لماذا لا ترتدين قناعك القديم؟

211
00:16:36,820 --> 00:16:40,730
تلك الّتي تتصرّف بودّ مع لونا
.هي مشعوذة الماء

212
00:16:36,820 --> 00:16:42,480
مشعوذة الماء

213
00:16:40,730 --> 00:16:42,480
ومعهم حقّ، ما قصّة ذلك القناع؟

214
00:16:43,500 --> 00:16:46,180
وعلى الأرجح أنّ مشعوذ الوحوش
.هو الواقف خلفها

215
00:16:45,210 --> 00:16:48,980
مشعوذ الوحوش

216
00:16:47,070 --> 00:16:48,980
.يا لهب. انتبه لكلامك

217
00:16:49,440 --> 00:16:53,020
.ولا بدّ أنّ ذاك هو مشعوذ الحشرات

218
00:16:51,800 --> 00:16:56,990
مشعوذ الحشرات

219
00:16:53,020 --> 00:16:56,620
سمعتُ أنّه شخص ضخم يقف
.إلى جانب مشعوذ الوحوش دائمًا

220
00:16:57,700 --> 00:17:00,200
.وهذا يعني أنّ ذاك هو مشعوذ الزّهور

221
00:16:59,720 --> 00:17:03,500
مشعوذ الزّهور

222
00:17:00,200 --> 00:17:03,070
.لكنّنا لن تستمع أبدًا ما لم نكن صريحين معها

223
00:17:03,960 --> 00:17:07,390
.وهتان هما مشعوذة البلّور والمشعوذة الشّرقيّة

224
00:17:05,350 --> 00:17:08,000
مشعوذة البلّور

225
00:17:05,350 --> 00:17:08,000
المشعوذة الشّرقيّة

226
00:17:08,000 --> 00:17:09,500
...وأخيرًا

227
00:17:11,460 --> 00:17:14,860
.سيّدي، مشعوذ الطّيور

228
00:17:14,860 --> 00:17:21,890
مشعوذ الطّيور

229
00:17:15,550 --> 00:17:20,420
كلود. أفترض أنّك هنا اليوم
فقط لمراقبة لونا، صحيح؟

230
00:17:20,420 --> 00:17:21,410
.أقدّر لك ذلك

231
00:17:22,270 --> 00:17:23,260
.سيّدي الطّائر

232
00:17:24,090 --> 00:17:28,540
إنّه وبكلّ وضوح الشّخص الجدير
.بقيادة مجلس المشعوذين

233
00:17:29,650 --> 00:17:34,650
هلاّ قمت بمشاركة ما تعرفه عن الوضع معنا؟

234
00:17:35,480 --> 00:17:38,450
إذًا فهذا الغراب هو أليفك؟

235
00:17:39,720 --> 00:17:43,330
اسمع. هل تقول مشعوذة الفطر الحقيقة؟

236
00:17:44,920 --> 00:17:45,670
.نعم

237
00:17:46,180 --> 00:17:47,920
كيف لي أن أعرف؟

238
00:17:48,190 --> 00:17:49,560
...كلود

239
00:17:53,110 --> 00:17:53,920
.تبًّا

240
00:17:56,290 --> 00:18:01,090
بغضّ النّظر عن ذلك، لا يمكنني
.السّماح لك بإيواء ذلك الشّخص

241
00:18:02,030 --> 00:18:04,930
ما قصّته؟ لماذا سأل من الأساس إذًا؟

242
00:18:05,330 --> 00:18:07,440
.سأقدّم لك تحذيرًا أخيرًا

243
00:18:08,030 --> 00:18:11,780
.سلّمينا ذلك الطّفل الملعون بكلّ هدوء

244
00:18:12,190 --> 00:18:16,530
،ارفضي، وسيتمّ اعتقالك بتهمة الخيانة

245
00:18:16,530 --> 00:18:18,860
.وستبدأ المداولات بتحديد عقوبتك بعدها

246
00:18:20,490 --> 00:18:23,240
."إنّه بذرة "نهاية كلّ شيء

247
00:18:23,240 --> 00:18:26,100
إعدامه فور العثور عليه
.قانون صارم لا يقبل الجدل

248
00:18:28,210 --> 00:18:32,990
إن انتظرنا حتّى يكبر ويصير "نهاية
.كلّ شيء"، فسيكون الأوان قد فات

249
00:18:32,990 --> 00:18:35,710
.لذلك تخلّي عن عاطفتك السّاذجة

250
00:18:35,960 --> 00:18:37,470
هل قال الطّفل الملعون؟

251
00:18:38,470 --> 00:18:39,410
.لونا

252
00:18:39,970 --> 00:18:44,220
،أنا أفهم ما تشعرين به
لكن عليك أيضًا أن تفهمي

253
00:18:44,220 --> 00:18:47,980
المعاناة الّتي قد يُطلقها
.نهاية كلّ شيء" على العالم"

254
00:18:48,530 --> 00:18:50,980
،إن كنّا نريد درء كارثة

255
00:18:51,930 --> 00:18:54,980
،فحتّى لو كان هذا الطّفل الملعون بريئًا

256
00:18:55,290 --> 00:19:00,190
لا يمكننا السّماح لاضطراباتنا العاطفيّة
.الشّخصيّة بالتّحكّم بأفعالنا

257
00:19:00,990 --> 00:19:03,010
.حاولي أن تفهمي يا لونا

258
00:19:04,700 --> 00:19:06,230
...يا مشعوذة الماء

259
00:19:06,710 --> 00:19:09,770
اخترتِ تلك اللّحظة لتغيير قناعك؟

260
00:19:10,750 --> 00:19:14,770
الطّفل الملعون هو بذرة "نهاية كلّ شيء"؟

261
00:19:16,300 --> 00:19:21,880
،وُلد من تلوّث هذا العالم
.وهو وحش شيطانيّ سامّ

262
00:19:24,450 --> 00:19:27,780
كلّ القبح والرّعب والشّرور في هذا العالم

263
00:19:27,780 --> 00:19:33,250
مضغوطة ومركّزة في كتلة واحدة
.سامّة تمشي على الأرض

264
00:19:34,010 --> 00:19:38,160
،عندما يلامس كائنات حيّة
،تموت بشكل فظيع

265
00:19:38,160 --> 00:19:40,400
،وتتعفّن وتتحلّل في ألم لا يُوصف

266
00:19:40,400 --> 00:19:46,410
.وتصبح كلّ أرض يمرّ بها جرداء تمامًا لسنوات

267
00:19:46,940 --> 00:19:51,210
،حين بدأ بالظّهور لأوّل مرّة
لم يكن أحد يعرف

268
00:19:51,210 --> 00:19:54,910
.كيف حصل على ذلك الاسم أو كيف وُلد

269
00:19:55,870 --> 00:19:59,660
،إنّه يظهر بلا أيّ نمط أو سبب
،ولكن بقوّة قادرة على تدمير أمم

270
00:19:59,660 --> 00:20:01,950
.ثمّ يختفي تمامًا كما ظهر

271
00:20:02,880 --> 00:20:07,140
حتّى التّعرّض للهجوم والتّعفّن
،حتّى الموت يظلّ بديلاً أفضل

272
00:20:07,140 --> 00:20:11,570
لأنّه يقوم بامتصاص البشر إلى داخله
،أيضًا. ومع كلّ جسد يبتلعه

273
00:20:11,570 --> 00:20:13,700
.يصير "نهاية كلّ شيء" أكبر وأكبر

274
00:20:14,470 --> 00:20:16,660
،ومع عدم وجود أيّ مفرّ
سقطت أمم في يأس

275
00:20:18,020 --> 00:20:21,990
واستسلمت له كما قد تفعل
.أمام كوارث طبيعيّة

276
00:20:22,470 --> 00:20:27,620
الوحيدون القادرون على تطهير
،تلك السّموم من الأرض والهواء

277
00:20:27,620 --> 00:20:32,450
وكشف تلوّث هذا العالم
"وقتل "نهاية كلّ شيء

278
00:20:33,090 --> 00:20:37,260
بسحرهم القويّ، هم أولئك
.المعروفين بمشعوذي السّمّ

279
00:20:42,570 --> 00:20:46,680
قلتم "بذرة". هل يعني ذلك أنّ هذا
،الفتى الّذي تصفونه بالطّفل الملعون

280
00:20:46,680 --> 00:20:48,610
سيصير في النّهاية "نهاية كلّ شيء"؟

281
00:20:49,400 --> 00:20:53,020
"أيعني هذا أنّ "نهاية كلّ شيء
ينمو من كائن بشريّ؟

282
00:20:53,020 --> 00:20:54,230
.كلود

283
00:20:54,230 --> 00:20:57,720
.لم أكن أعرف على الإطلاق

284
00:20:58,990 --> 00:21:02,340
.إنّه سرّ محفوظ بعناية يعرفه المشعوذون فقط

285
00:21:02,340 --> 00:21:06,530
إن خرج للعلن، فقد يتسبّب
.بارتباك واضطراب غير ضروريّ

286
00:21:06,750 --> 00:21:11,660
من الأفضل ألاّ تخبريني أنّك كنت تعرفين
.سلفًا أنّه الطّفل الملعون يا لونا

287
00:21:12,290 --> 00:21:16,190
كنت تعرفين ومع ذلك أقنعتني بإنقاذه؟

288
00:21:19,130 --> 00:21:21,080
!لا أصدّق هذا

289
00:21:21,080 --> 00:21:22,550
كلود؟

290
00:21:22,550 --> 00:21:24,310
!سلّميهم الفتى فحسب

291
00:21:24,920 --> 00:21:30,560
إن سمحت له بالعيش، قد يصير
!نهاية كلّ شيء" في أيّ وقت"

292
00:21:30,860 --> 00:21:31,800
!سُحقًا

293
00:21:32,150 --> 00:21:34,060
ما الّذي كنت تفكّرين فيه؟

294
00:21:34,060 --> 00:21:37,160
!إنّه نسل وحش قادر على تدمير العالم

295
00:21:37,160 --> 00:21:38,810
!لماذا تحاولين حمايته؟

296
00:21:38,810 --> 00:21:39,940
...كلاّ

297
00:21:40,930 --> 00:21:43,300
!لن يدعوك تفلتين من العقاب أيضًا

298
00:21:45,070 --> 00:21:49,200
!لا بأس! سُحقًا لهذا! لا أفهمك على الإطلاق

299
00:22:00,110 --> 00:22:01,340
...أيّتها الـ

300
00:22:01,970 --> 00:22:04,810
لن تختبئي داخل حصن
!من الفطر للأبد فحسب

301
00:22:06,500 --> 00:22:12,750
فهمت. ربما كانت الفتاة غير
.جديرة بالثّقة من البداية

302
00:22:12,750 --> 00:22:15,000
.عجبًا، ما كنتُ لأقول ذلك

303
00:22:15,000 --> 00:22:16,830
.كان حريًّا بنا أن نعرف

304
00:22:16,830 --> 00:22:20,300
فقبل كلّ شيء، ليس من الصّعب فهم

305
00:22:20,300 --> 00:22:22,090
.لماذا قد ترفض التّخلّي عن الفتى

306
00:22:22,900 --> 00:22:24,980
ماذا؟ ما معنى هذا؟

307
00:22:24,980 --> 00:22:30,280
إنّها تسمّي نفسها مشعوذة
الفطر الآن، لكنّ تلك الفتاة

308
00:22:30,700 --> 00:22:32,980
.كانت طفلة ملعونة في السّابق أيضًا

309
00:24:06,690 --> 00:24:10,250
الحلقة القادمة
مجلس المشعوذين السّود