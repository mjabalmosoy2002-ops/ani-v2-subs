1
00:00:24,450 --> 00:00:25,590
.حسنًا

2
00:00:39,430 --> 00:00:40,350
.أجل

3
00:00:45,900 --> 00:00:47,310
!هذه هي

4
00:02:18,460 --> 00:02:22,440
."فهمت الآن. هكذا تُكتب كلمة "فطر

5
00:02:18,550 --> 00:02:24,010
الحلقة 6
اليوم الأوّل

6
00:02:22,830 --> 00:02:26,770
.مرحبًا. أنا تلميذ مشعوذة
.اسمي ليزِل

7
00:02:26,770 --> 00:02:28,000
ليزي؟

8
00:02:28,830 --> 00:02:30,220
!نعم

9
00:02:30,950 --> 00:02:33,010
.يا ويحي! بل إنّه ليزي

10
00:02:34,970 --> 00:02:37,380
.اسمي ليزي

11
00:02:37,710 --> 00:02:42,260
اسمي الأصلي هو ليزِل، لكنّ ذلك
،"هو ما يسمّى "الاسم الحقيقيّ

12
00:02:42,260 --> 00:02:46,020
.وليس مسموحًا لي بإخباره للآخرين

13
00:02:46,300 --> 00:02:51,780
إنّه مفتاح تحرير سحري، لذلك عليّ
.البوح به في ذهني فحسب الآن

14
00:02:55,220 --> 00:02:57,780
.حرّك ما في ذلك القِدر لو سمحت

15
00:02:57,780 --> 00:02:58,900
.حاضر

16
00:03:01,390 --> 00:03:03,790
.لكن استعمل سحرك لذلك

17
00:03:04,170 --> 00:03:05,330
.حاضر

18
00:03:05,330 --> 00:03:09,080
.هذه هي معلّمتي، المشعوذة السّوداء لونا

19
00:03:09,430 --> 00:03:13,040
.تبدو دائمًا منزعجة منّي نوعًا ما

20
00:03:16,300 --> 00:03:18,680
ما الّذي كنت تفعله بعيدًا عن هنا؟

21
00:03:19,780 --> 00:03:24,680
كنتُ أكتب يوميّاتي كما طلبتِ
.منّي يا سيّدتي المشعوذة

22
00:03:24,680 --> 00:03:29,810
،لم أكن أفهم لغة السّحر
،لذلك كنتُ متوتّرًا قليلاً في البداية

23
00:03:29,810 --> 00:03:33,340
لكن بعد أن صار بإمكاني كتابة
،ما أفكّر به الآن عن طريق كتابة الأفكار

24
00:03:33,340 --> 00:03:36,450
أستمتع بوقتي كثيرًا وأنا أخمّن ما
.الحروف الّتي تحتويها بعض الكلمات

25
00:03:36,450 --> 00:03:38,480
.بدأت أستمتع بذلك كثيرًا

26
00:03:38,480 --> 00:03:42,020
أنا أتعلّم الكثير، لذلك
!أنا مسرور لأنّي بدأت بذلك

27
00:03:44,860 --> 00:03:46,840
!ماذا؟ مهلاً! هذا ساخن

28
00:03:46,840 --> 00:03:49,740
...ولكن سيّدتي المشعوذة

29
00:03:51,580 --> 00:03:55,300
.لا يبدو أنّها تجيد البقاء منزعجة

30
00:03:56,900 --> 00:04:02,220
عفوًا، ليس عليك القيام
.بكلّ هذا. سأكون بخير

31
00:04:02,450 --> 00:04:05,220
ماذا؟ ما الّذي تعنيه؟

32
00:04:07,980 --> 00:04:12,620
،لا أدري ما السّبب
.لكنّها تبدو مشغولة دائمًا

33
00:04:13,850 --> 00:04:16,240
.بإمكاني القيام بذلك

34
00:04:16,470 --> 00:04:19,670
.لا. قرّرتُ القيام بذلك بنفسي

35
00:04:24,870 --> 00:04:31,240
،يبدو اسم ليزي كاسم فتيات
.لذلك لا أحبّه كثيرًا في الحقيقة

36
00:04:32,950 --> 00:04:39,790
لكنّه الاسم الّذي منحتني إيّاه سيّدتي
...المشعوذة، لذلك فهو عزيز عليّ

37
00:04:40,470 --> 00:04:43,430
مع أنّها حذفت حرف اللاّم الأخير
من اسمك الأصليّ فحسب؟

38
00:04:43,430 --> 00:04:46,580
ما العزيز فيه؟
.كهذا مجرّد كسل في رأيي

39
00:04:47,350 --> 00:04:48,770
.مرحبًا

40
00:04:50,650 --> 00:04:53,400
.اسم هذا الرّجل العابس هو كلود

41
00:04:53,400 --> 00:04:55,450
إنّه يتدخّل بوقاحة دائمًا

42
00:04:55,450 --> 00:04:59,110
في حياتي مع المشعوذة
.رغم أنّه لم يدعُه أيّ أحد

43
00:04:59,110 --> 00:05:00,400
.يحشر أنفه بشكل مزعج

44
00:05:00,400 --> 00:05:03,440
كلاّ، بما أنّه غراب، فسأقول
.يحشر منقاره بشكل مزعج

45
00:05:03,870 --> 00:05:06,910
...مع أنّه يملك شخصيّة مقرفة، لذلك

46
00:05:08,070 --> 00:05:08,910
ماذا؟

47
00:05:08,910 --> 00:05:11,170
.إنّه شخص مزعج بالفعل

48
00:05:11,170 --> 00:05:12,990
!سأوسعك ضربًا أيّها الشّقيّ الصّغير

49
00:05:13,460 --> 00:05:15,420
ما الخطب يا كلود؟

50
00:05:15,420 --> 00:05:17,920
!سل نفسك ذلك أيّها الشّقيّ

51
00:05:17,920 --> 00:05:19,460
.يا كلود

52
00:05:19,830 --> 00:05:22,760
.من الفظاظة قراءة يوميّات شخص آخر

53
00:05:23,190 --> 00:05:26,380
متى ستتعلّم كيف تنتبه لتصرّفاتك تلك؟

54
00:05:26,750 --> 00:05:28,270
.ما بيدي حيلة

55
00:05:28,270 --> 00:05:33,270
كانت سيّدتي المشعوذة واضحة جدًّا
،أنّه إن أزعجني شيء ما أو أحزنني

56
00:05:33,270 --> 00:05:37,910
،فعليّ كتابته في يوميّاتي بدل كبته بداخلي

57
00:05:37,910 --> 00:05:40,380
.وذلك كي لا تتعفّن القذارة داخل قلبي

58
00:05:40,990 --> 00:05:43,780
إذًا فأنت تصفني بالقذارة المتعفّنة الآن؟

59
00:05:46,690 --> 00:05:51,160
!لونا! ما الّذي كنت تعلّمينه لهذا الشّقيّ؟

60
00:05:51,650 --> 00:05:54,480
!لا تغضب من سيّدتي المشعوذة رجاءً

61
00:05:54,480 --> 00:05:57,540
،لا بأس! أشعر بتحسّن بعد كتابة مشاعري

62
00:05:57,540 --> 00:06:00,820
لذلك لستُ مشمئزًّا من وجودك
.بقدر ما كنتُ قبل دقيقة

63
00:06:00,820 --> 00:06:03,680
إنّك تزداد وقاحة فوق وقاحتك
!السّابقة يا ولد

64
00:06:04,370 --> 00:06:09,140
.ما بيده حيلة يا كلود
.ليزي طفل ملعون قبل كلّ شيء

65
00:06:09,140 --> 00:06:12,580
.لا يجدر به كبت مشاعره السّامّة الآن

66
00:06:12,580 --> 00:06:15,190
حتّى الأشياء الصّغيرة يمكنها
.أن تتراكم مع الوقت إن لم يكن حذرًا

67
00:06:15,470 --> 00:06:20,440
لا أريد أن تضطرّ لونا لتُنبت واحدًا
.آخر من ذلك الفطر الأسود الضّخم

68
00:06:24,750 --> 00:06:26,410
.لا بأس، فهمت

69
00:06:26,410 --> 00:06:28,870
هل فهمت بالفعل؟

70
00:06:28,870 --> 00:06:32,290
إنّك تتذمّر دائمًا
.وتصبّ غضبك على الجميع

71
00:06:32,290 --> 00:06:37,810
علينا جميعًا أن نكون قدوة جيّدة كي
"لا يتحوّل ليزي إلى "نهاية كلّ شيء

72
00:06:37,810 --> 00:06:39,550
.بما أنّه لا يفهم كلّ هذا بعد

73
00:06:39,770 --> 00:06:45,310
الطّفل الملعون الّذي قُدّر له
.أن يصير "نهاية كلّ شيء". نعم

74
00:06:45,930 --> 00:06:48,720
أحضرتِ كومة مشاكل حقيقيّة
.معك للمنزل هذه المرّة

75
00:06:50,230 --> 00:06:54,160
هل أنت مدركة للفوضى
الّتي ورّطتِنا جميعًا فيها؟

76
00:06:55,870 --> 00:06:58,710
،لا أهتمّ بتاتًا لما قد يحدث لذلك الشّقيّ

77
00:06:59,130 --> 00:07:03,720
.لكنّ هذا كان خيارك، لذلك فهو مسؤوليّتك

78
00:07:05,750 --> 00:07:10,450
كلود، عليك فعل شيء ما حيال
.سلوكك السّيّئ هذا

79
00:07:10,450 --> 00:07:12,940
.إنّك لا تُلهم أيّ ثقة الآن

80
00:07:13,580 --> 00:07:17,680
،أعلم ذلك! وعلى العشاء اللّيلة
!سأتناول لحم بقر مشويّ

81
00:07:17,680 --> 00:07:20,320
.أعتقد أنّ فطيرة غربان ستكون خيارًا أفضل

82
00:07:27,220 --> 00:07:34,400
.أنقذني هؤلاء الأشخاص ذات يوم
.ولا أملك أيّ ذكريات قبل ذلك

83
00:07:35,100 --> 00:07:40,100
.لا أعرف من أكون وإلى أين أنا ذاهب

84
00:07:40,100 --> 00:07:45,460
لا أعرف حتّى السّبب الحقيقيّ
.وراء كتابة يوميّاتي

85
00:07:46,020 --> 00:07:47,610
.أخبرنا باسمك

86
00:07:48,360 --> 00:07:49,600
.إنّه ليزِل

87
00:07:58,780 --> 00:07:59,900
ما كان ذلك؟

88
00:08:00,690 --> 00:08:06,520
هل شعرتِ بهبّة رياح صدرت منه
في اللّحظة الّتي ذكر فيها اسمه؟

89
00:08:15,660 --> 00:08:19,000
اسمع يا هذا. هل استعملتَ سحرًا ما؟

90
00:08:19,460 --> 00:08:22,160
...أنا... لم

91
00:08:22,900 --> 00:08:26,460
.ليس عليك استعمال ذلك الاسم بعد الآن

92
00:08:26,460 --> 00:08:27,460
لونا؟

93
00:08:28,180 --> 00:08:32,700
،لا أعرف ما الّذي حدث له
لكن يراودني شعور

94
00:08:32,700 --> 00:08:35,680
.بأنّه ليس عليه استعمال ذلك الاسم

95
00:08:36,200 --> 00:08:37,790
اسمه الحقيقيّ؟

96
00:08:38,220 --> 00:08:39,150
.على الأرجح

97
00:08:40,380 --> 00:08:43,440
،أعرف أنّه على عكس المشعوذين السّود

98
00:08:44,210 --> 00:08:46,680
وبما أنّ للمشعوذين البيض
،قوى سحريّة أضعف

99
00:08:46,680 --> 00:08:50,340
.يعتمد على عقود وتعويذات لاستعمال السّحر

100
00:08:50,940 --> 00:08:54,370
،وبما أنّهم أيضًا مرتبطون بتلك التّعاويذ

101
00:08:54,370 --> 00:08:56,940
فإنّ "أسماءهم الحقيقيّة" هي
.مفاتيح تحرير تلك القوّة

102
00:08:57,610 --> 00:09:00,140
.أسماؤهم الحقيقيّة هي أشبه بنقاط ضعفهم

103
00:09:00,670 --> 00:09:03,530
والكشف عنها سيجعلهم عرضة
.ليكونوا أهدافًا للعنات

104
00:09:03,530 --> 00:09:07,320
ماذا؟ عمّ يتحدّثان؟

105
00:09:07,320 --> 00:09:10,530
لا بدّ أنّ إفصاحه لنا عنه بتلك العفويّة

106
00:09:10,530 --> 00:09:13,230
.يعني أنّه في حالة ارتباك شديد

107
00:09:14,320 --> 00:09:16,050
هل يتكلّمان عنّي؟

108
00:09:16,050 --> 00:09:17,000
...عفوًا

109
00:09:17,370 --> 00:09:21,080
.أنت من كان ينبغي ألاّ يولد أصلاً

110
00:09:28,050 --> 00:09:31,100
ما هذا المكان؟

111
00:09:31,690 --> 00:09:34,000
من أنتما؟

112
00:09:34,970 --> 00:09:37,680
لماذا أنا هنا؟

113
00:09:38,930 --> 00:09:40,070
...كيف

114
00:09:41,990 --> 00:09:42,920
...أنا

115
00:09:44,820 --> 00:09:47,390
من أكون أنا؟

116
00:09:51,020 --> 00:09:54,160
...عفوًا، أعتقد أنّي

117
00:09:55,010 --> 00:09:56,700
.مدين لكما

118
00:09:56,700 --> 00:10:00,230
.يبدو أنّكما قد أنقذتماني

119
00:10:00,230 --> 00:10:02,740
...شكرًا جزيلاً لكما. أنا

120
00:10:03,770 --> 00:10:09,620
عليّ الذّهاب. أتمنّى لو كان
.لديّ ما أقدّمه لكما لشكركما

121
00:10:13,920 --> 00:10:16,680
أرأيت؟ ما الّذي أخبرتك به؟

122
00:10:19,160 --> 00:10:20,120
أنا مصاب؟

123
00:10:25,960 --> 00:10:30,690
ماذا؟ دمية... فطر؟

124
00:10:40,130 --> 00:10:41,600
دمية نقل؟

125
00:10:42,360 --> 00:10:45,560
.تحسّن جرحي

126
00:10:46,520 --> 00:10:48,730
لا، بل انتقل؟

127
00:10:50,190 --> 00:10:51,530
من هذا؟

128
00:10:52,380 --> 00:10:56,140
،عليك الآن أن تعتني بهذا بكلّ تفانٍ

129
00:10:56,140 --> 00:10:58,970
حتّى يتعافى من الإصابة
.الّتي قبل بها بدلاً منك

130
00:10:59,550 --> 00:11:00,340
ماذا؟

131
00:11:00,970 --> 00:11:03,580
.ستكون هذه أوّل مسؤوليّاتك

132
00:11:04,410 --> 00:11:05,890
.لا تتهاوني معه أبدًا

133
00:11:06,200 --> 00:11:08,780
...إن كنت ستحوّلينه إلى مشعوذ

134
00:11:10,330 --> 00:11:12,240
،ومنعه من أن يصير وحشًا

135
00:11:13,340 --> 00:11:14,860
.فعليك وضع مشاعرك جانبًا

136
00:11:14,860 --> 00:11:16,610
.هذه الغابة السّوداء

137
00:11:17,550 --> 00:11:19,090
.أنت اخترت هذا

138
00:11:19,600 --> 00:11:22,960
.وبدءًا من اليوم، ستعيش في هذا المنزل

139
00:11:23,420 --> 00:11:27,620
ليس مسموحًا لك بمغادرة
.هذا المنزل لأيّ سبب

140
00:11:28,250 --> 00:11:30,630
...بمجرّد أن صرت معلّمة الفتى

141
00:11:30,860 --> 00:11:33,720
.أنا مشعوذة الفطر. اسمي لونا

142
00:11:34,160 --> 00:11:39,260
وأنت تلميذي الّذي ستتعلّم
—منّي السّحر يا ليز

143
00:11:41,870 --> 00:11:43,390
!لا تستعملي اسمه الحقيقيّ

144
00:11:44,270 --> 00:11:46,170
...حسنًا، ليز

145
00:11:46,840 --> 00:11:50,770
ليزِلا؟ ليزِلو؟

146
00:11:50,770 --> 00:11:52,260
.ليزيت

147
00:11:52,260 --> 00:11:54,290
أليس ذلك اسم فتيات؟

148
00:11:55,030 --> 00:11:56,190
.ليزوتو

149
00:11:56,190 --> 00:11:57,530
.يبدو ذلك كطعام

150
00:12:00,530 --> 00:12:02,320
أليس ليزي كافيًا؟

151
00:12:02,320 --> 00:12:03,130
.نعم

152
00:12:03,450 --> 00:12:06,040
.هيّا يا لونا. حظًّا سعيدًا

153
00:12:09,540 --> 00:12:15,840
عـ-عفوًا... اسمك هو ليزي الآن
!و-وبلا سبب معيّن! هذا كلّ شيء

154
00:12:22,160 --> 00:12:25,930
،هذا صحيح. كما قال الغراب

155
00:12:26,210 --> 00:12:32,190
،اُختير هذا الاسم في رمشة عين
.ويحمل انطباعًا لا يمكن إنكاره

156
00:12:33,530 --> 00:12:35,940
،لكن بعد أن دوّنتُه في يوميّاتي

157
00:12:35,940 --> 00:12:39,450
.نسيت تمامًا كيف كان شعوري آنذاك

158
00:12:39,450 --> 00:12:43,980
.على أيّ حال، لا تستعمل اسمك القديم ثانية

159
00:12:44,450 --> 00:12:48,140
.وانتبه، إيّاك أن تفكّر في الهرب

160
00:12:48,590 --> 00:12:50,480
.إن هربت، سأقتلك

161
00:12:53,890 --> 00:12:57,650
إذًا فأنا تلميذُ مشعوذة؟

162
00:12:57,970 --> 00:13:00,120
مشعوذة الفطر؟

163
00:13:00,920 --> 00:13:03,960
.كان ذلك يومي الأوّل كتلميذ مشعوذة

164
00:13:04,550 --> 00:13:09,330
في تلك اللّيلة، كنتُ لا أزال
.متوتّرًا ويغمرني الشّكّ

165
00:13:12,250 --> 00:13:13,630
...الغابة السّوداء

166
00:13:14,050 --> 00:13:18,130
هي مكان حيث تعيش الأرواح الشّرّيرة
.والمجرمون والوحوش السّامّة

167
00:13:18,130 --> 00:13:19,730
.إنّه مريب ومليء بالشّؤم

168
00:13:21,870 --> 00:13:23,000
...المشعوذة السّوداء

169
00:13:23,550 --> 00:13:27,480
،هي مشعوذة تمتلك سحرًا قويًّا
،وترفض التّكيّف مع الآخرين

170
00:13:27,480 --> 00:13:31,660
وتستعمل السّمّ لتجسيد
.وحوش والتّحكّم بها

171
00:13:31,660 --> 00:13:35,110
تُلقي تصرّفاتها الفظيعة
.بالمجتمعات والبلدان في الفوضى

172
00:13:35,110 --> 00:13:36,960
.مشعوذة فظيعة

173
00:13:42,170 --> 00:13:44,320
.صباح الخير

174
00:13:47,880 --> 00:13:49,660
استغرقتُ في النّوم؟

175
00:13:50,160 --> 00:13:51,450
!أنا آسف

176
00:13:51,980 --> 00:13:55,730
،سنذهب لجمع مكوّنات للفطور
.لذلك غيّر ملابسك

177
00:13:55,730 --> 00:13:56,820
.حاضر

178
00:13:58,130 --> 00:14:01,460
،مع أنّي لا أذكر أيّ شيء عمّن أكون

179
00:14:01,800 --> 00:14:04,110
يبدو أنّي ما زلتُ أذكر بعض الأشياء

180
00:14:04,700 --> 00:14:08,370
.الّتي ليست مرتبطة بهويّتي

181
00:14:08,370 --> 00:14:13,120
.شـ-شكرًا على المساعدة

182
00:14:16,130 --> 00:14:20,220
وذلك يتضمّن إشاعات سمعتها
.عن مشعوذة الفطر

183
00:14:20,550 --> 00:14:23,330
.حسنًا. تناسبني الملابس تمامًا

184
00:14:26,030 --> 00:14:27,730
.شكرًا جزيلاً لك

185
00:14:31,140 --> 00:14:34,960
سمعتُ أنّها مشعوذة تبدو مظلمة
،وقبيحة مثل شخصيّتها

186
00:14:34,960 --> 00:14:38,000
،وتنبعث منها روائح بشعة وسامّة

187
00:14:38,000 --> 00:14:40,810
،وتُنبت خلفها فطرًا سامًّا بشدّة حول البلدة

188
00:14:40,810 --> 00:14:42,830
.ما سبّب بالمشاكل للجميع

189
00:14:42,830 --> 00:14:44,960
ماذا؟ أهذا فطر آخر؟

190
00:14:44,960 --> 00:14:46,410
.نعم، ذلك صحيح

191
00:14:46,410 --> 00:14:47,730
ولا مانع من قطفه؟

192
00:14:47,730 --> 00:14:48,900
.بالطّبع

193
00:14:51,370 --> 00:14:55,620
أريد تقشير ذلك الفطر
،وتقطيعه لأجزاء صغيرة

194
00:14:55,620 --> 00:14:57,670
.ثمّ سنقوم بهرسه بلُطف

195
00:14:57,670 --> 00:15:02,810
كان لهذا رائحة نظيفة ومنعشة
مثل ندى الصّباح والعشب الأخضر

196
00:15:02,810 --> 00:15:05,080
.والزّهور في مزيج واحد

197
00:15:05,480 --> 00:15:07,430
.ربّما لم تكن تلك الشّائعات صحيحة تمامًا

198
00:15:10,430 --> 00:15:13,430
"...تقشير"

199
00:15:16,440 --> 00:15:21,440
"...تقطيع، تقطيع"

200
00:15:16,880 --> 00:15:18,090
.حسنًا

201
00:15:26,720 --> 00:15:31,060
عـ-عليك أن تبذل جهدًا أكثر
.للقياك بواجباتك بالسّحر

202
00:15:31,450 --> 00:15:33,450
!وستبدأ في الحال

203
00:15:33,690 --> 00:15:35,620
.أنا آسف

204
00:15:35,620 --> 00:15:38,530
كما أنّه ممنوع عليك حمل سكّين
.في الوقت الحاليّ

205
00:15:39,120 --> 00:15:40,590
!نظّف نفسك الآن

206
00:15:41,810 --> 00:15:46,860
كم هذا مزعج. أشعر وكأنّي لستُ
معتادًا على هذا الجسم، ولكن لماذا؟

207
00:15:47,220 --> 00:15:53,470
أعتقد أنّه لا يزال صغيرًا
.على تقشير الأشياء بسكّين

208
00:15:54,480 --> 00:15:55,450
.نعم

209
00:15:58,080 --> 00:16:01,380
،كم هذا محرج. أشعر بأنّي غير ناضج

210
00:16:01,380 --> 00:16:04,760
وما زلتُ لا أعرف شيئًا
.عن استخدام السّحر بعد

211
00:16:04,760 --> 00:16:08,490
كيف انتهى بي المطاف تلميذًا للمشعوذة؟

212
00:16:09,660 --> 00:16:13,240
...عـ-عفوًا. بعض الفطر المهروس

213
00:16:13,760 --> 00:16:14,860
.عالق بشعرك

214
00:16:16,280 --> 00:16:17,750
!لا تلمسني

215
00:16:19,990 --> 00:16:22,580
.ليس عليك لمسي على الإطلاق

216
00:16:23,000 --> 00:16:25,740
.حا-حاضر

217
00:16:25,740 --> 00:16:27,540
.أنا آسف

218
00:16:28,400 --> 00:16:31,400
.ستقتلني إن هربت. مشعوذة فظيعة

219
00:16:35,520 --> 00:16:37,520
!حان وقت الأكل

220
00:16:37,520 --> 00:16:38,980
!هذا مذهل

221
00:16:39,320 --> 00:16:40,770
!يبدو لذيذًا جدًّا

222
00:16:42,770 --> 00:16:48,780
"وصفة كعك مقلاة بفطر الشّيتاكي"

223
00:16:52,780 --> 00:16:56,790
"المكوّن الرّئيسيّ: المشاعر"

224
00:16:56,790 --> 00:17:02,790
"...انتفاخ، انتفاخ"

225
00:17:07,030 --> 00:17:09,080
!شكرًا على الطّعام

226
00:17:11,750 --> 00:17:17,320
بعد التّفكير في الأمر، لم آكل أيّ
.شيء منذ أن استيقظتُ البارحة

227
00:17:20,310 --> 00:17:24,460
ربّما لم أكن بحاجة لأخذ تلك
.الشّائعات الغريبة على محمل الجدّ

228
00:17:26,320 --> 00:17:28,330
!كم هذا لذيذ

229
00:17:28,330 --> 00:17:29,450
!نعم

230
00:17:36,540 --> 00:17:38,480
!لونا، هذا رائع

231
00:17:38,480 --> 00:17:41,330
!مثل كعك المقلاة الّذي يُعدّونه في الكتب

232
00:17:41,330 --> 00:17:47,340
،ربّما إن كنت بقرة أو خروفًا
.كنتُ سأجد هذا لذيذًا أيضًا

233
00:17:50,340 --> 00:17:52,030
.هذا رأيي حيال الطّعام

234
00:17:53,500 --> 00:17:55,380
!هذا لذيذ جدًّا

235
00:17:55,850 --> 00:17:59,240
.قلتُ تلك الكذبة بسهولة شرب الماء

236
00:17:59,790 --> 00:18:05,400
لكنّ سيّدتي المشعوذة عملت بجدّ
.لإعداده من أجلي. عليّ إنهاؤه

237
00:18:07,550 --> 00:18:10,860
مهلاً. ماذا تظنّين أنّك فاعلة يا لونا؟

238
00:18:11,370 --> 00:18:16,710
ظننتُ أنّك وعدتِ أن تجعلي الفتى
يستعمل السّحر في مهامه اليوميّة

239
00:18:16,710 --> 00:18:20,090
لمساعدته على التّقدّم بسرعة، أليس كذلك؟

240
00:18:22,050 --> 00:18:23,100
ما هذا؟

241
00:18:23,620 --> 00:18:25,060
.لا أصدّق

242
00:18:25,580 --> 00:18:27,810
هل أعددت ذلك له؟

243
00:18:28,490 --> 00:18:31,590
...أ-أنا... ذلك

244
00:18:31,590 --> 00:18:35,210
!عليك أن تجعليه يقوم بالطّبخ بسحره

245
00:18:35,210 --> 00:18:37,420
!ليس مسموحًا لك بمساعدته

246
00:18:37,830 --> 00:18:40,160
.لكنّ ليزي لا يجيد ذلك بعد

247
00:18:40,160 --> 00:18:44,100
لا يمكنه استعمال السّحر على
!الإطلاق بعد. سنتضوّر جوعًا

248
00:18:44,100 --> 00:18:45,610
!ذلك هو الهدف يا بغل

249
00:18:45,610 --> 00:18:46,860
.أنا خروف

250
00:18:47,350 --> 00:18:50,820
لا تظهَر المواهب الجديدة
!إلاّ عندما يُحاصر المرء

251
00:18:51,420 --> 00:18:55,360
ووعدتِ أنّ الأمور ستسير
.على هذا الحال يا لونا

252
00:18:57,870 --> 00:19:00,180
ومع ذلك بدأتِ بهذا من الآن؟

253
00:19:00,540 --> 00:19:02,620
.إنّك لا تُلهمين أيّ ثقة الآن

254
00:19:05,850 --> 00:19:07,720
هل تفهمين من الأساس

255
00:19:08,050 --> 00:19:11,120
مقدار المسؤوليّة الّتي مُنحنا إيّاها هنا؟

256
00:19:11,630 --> 00:19:13,400
.ضباب أسود

257
00:19:14,010 --> 00:19:16,630
.ثمّة ضباب أسود ينبعث من الكائنات الحيّة

258
00:19:17,060 --> 00:19:20,850
.يراودني شعور بأنّي كنتُ أراه كثيرًا

259
00:19:21,390 --> 00:19:25,140
توتّر وحزن ومعاناة

260
00:19:25,520 --> 00:19:28,780
ومرض ولعنات وكراهية

261
00:19:29,090 --> 00:19:32,530
.وجنون وخُبث وإثم

262
00:19:33,180 --> 00:19:38,240
ثمّة العديد من المشاعر السّامّة الّتي بإمكانها
.أن تنبعث من الكائنات الحيّة وثمّ تلتهمهم

263
00:19:38,240 --> 00:19:43,170
.لكنّ هذه أوّل مرّة أراه هنا
.لكنّه لا يزال خفيفًا

264
00:19:44,910 --> 00:19:49,920
أعرف أنّ أشياء سيّئة حدثت في الأماكن
.الّتي يكون فيها هذا الضّباب كثيفًا

265
00:19:54,170 --> 00:19:56,570
...لذلك من الأفضل أن

266
00:20:02,830 --> 00:20:04,820
أنت. ما الّذي فعلته لي؟

267
00:20:05,180 --> 00:20:11,190
...ماذا؟ أ-أنا... كان هنالك ضباب أسود

268
00:20:19,420 --> 00:20:23,630
عفوًا... هل فعلتُ شيئًا ما؟

269
00:20:24,200 --> 00:20:28,030
هل قلتَ "ضبابًا أسودًا" للتّوّ؟

270
00:20:28,950 --> 00:20:30,960
،لا تقترب من ذلك الضّباب الأسود

271
00:20:30,960 --> 00:20:34,630
!ولا تحاول لمسي أبدًا... أو لمس لونا

272
00:20:37,630 --> 00:20:40,640
من أنا؟

273
00:20:40,640 --> 00:20:45,890
لماذا أنا هنا؟ لماذا لا أعرف من أكون؟

274
00:20:46,220 --> 00:20:48,860
وما هذه الكلمات الخافتة
الّتي أسمعها في رأسي؟

275
00:20:49,660 --> 00:20:53,610
.أنت من كان ينبغي ألاّ يولد أصلاً

276
00:20:53,610 --> 00:20:56,400
.ليس عليك نسيان ما اسمك أبدًا

277
00:20:56,400 --> 00:21:00,670
صوت من هذا؟
وما كان ذلك الضّباب الأسود؟

278
00:21:00,670 --> 00:21:05,050
كيف أعرف بشأنه من الأساس؟ ما أنا؟

279
00:21:05,950 --> 00:21:07,850
.ذلك الفتى كارثة

280
00:21:08,640 --> 00:21:12,040
أشكّ أنّه يدرك أنّه يمتصّ السّموم
.من الأشخاص والأشياء من الأساس

281
00:21:12,720 --> 00:21:18,480
على هذا المعدّل، سينفد منه
.الوقت بشكل أسرع ممّا توقّعنا

282
00:21:19,490 --> 00:21:21,970
.لكنّ ذلك ليس خطأه

283
00:21:24,190 --> 00:21:27,620
علينا إجباره على تعلّم سحر ما
للتّعامل مع هذا

284
00:21:28,010 --> 00:21:31,180
قبل أن يمتصّ جسده سمومًا
.أكثر ممّا يمكنه تحمّله

285
00:21:31,690 --> 00:21:35,040
عمّ يتحدّثان؟

286
00:21:35,590 --> 00:21:37,090
عنّي أنا؟

287
00:21:38,210 --> 00:21:40,650
.ذلك الفتى وحش سامّ

288
00:21:41,190 --> 00:21:43,280
،في اللّحظة الّتي تحدّد أنّه قضيّة خاسرة

289
00:21:43,910 --> 00:21:45,760
.فلن تكون لدينا أيّ خيارات إلاّ قتله

290
00:21:49,930 --> 00:21:51,710
أهذا ما تريدينه يا لونا؟

291
00:21:52,230 --> 00:21:55,570
،إن واصلتِ التّساهل معه
.فذلك بالضّبط ما سيحدث

292
00:21:58,720 --> 00:22:03,030
لكن إن استطعتُ استعمال الفطر
،لامتصاص السّمّ الّذي يجمعه في جسده

293
00:22:03,030 --> 00:22:05,970
فلن نكون مضطرّين للاستعجال
.في اتّخاذ ذلك القرار

294
00:22:05,970 --> 00:22:09,290
نعم، لكنّنا تحدّثنا سلفًا عن
—المخاطرة الكبيرة الّتي

295
00:22:16,590 --> 00:22:18,480
ليزي، إلى أين تذهب؟

296
00:24:06,610 --> 00:24:10,250
الحلقة القادمة
يوميّات السّحر