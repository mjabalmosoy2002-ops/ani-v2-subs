1
00:01:30,580 --> 00:01:36,970
الحلقة 12
ليزي، تلميذ المشعوذة السّوداء

2
00:01:33,640 --> 00:01:35,030
.هذه مفاجأة

3
00:01:35,270 --> 00:01:38,360
لم أتوقّع أن يأتي هنري
.برفقة لونا وأصدقائها

4
00:01:39,080 --> 00:01:40,700
.أعتذر بشدّة

5
00:01:40,930 --> 00:01:44,030
لكنّ هذا هو المكان الآمن الواحد
.الّذي استطعتُ التّفكير فيه

6
00:01:44,340 --> 00:01:48,430
لا أمانع. نحن محميّون
.بحاجز قويّ جدًّا هنا

7
00:01:48,840 --> 00:01:49,910
حتّى أفراد العائلة الملكيّة

8
00:01:49,910 --> 00:01:53,960
.لا يمكنهم الدّخول أو التّواصل من دوني إذني

9
00:01:54,510 --> 00:01:59,610
.اتّخذت القرار الأمثل لحمايتهم
.أنا أشكرك على ذلك

10
00:01:59,610 --> 00:02:01,390
.العفو. شرّفتني بهذا

11
00:02:01,610 --> 00:02:03,310
...بالمناسبة يا سيّد طائر

12
00:02:03,310 --> 00:02:08,150
بشأن هذا... الموظّف؟
هذا المشعوذ نصف الأبيض؟

13
00:02:08,150 --> 00:02:09,650
كيف تعرفه؟

14
00:02:09,650 --> 00:02:12,130
.إنّه من سلالتي

15
00:02:12,500 --> 00:02:16,120
تجري في عروقنا نفس دماء
،المشعوذين البيض

16
00:02:16,120 --> 00:02:20,160
لكنّه وافق على أداء بعض المهامّ
.من أجل المشعوذين السّود

17
00:02:22,410 --> 00:02:26,910
إنّه يساعدني بطُرق مختلفة بينما
أعيش كمشعوذ أسود في السّرّ

18
00:02:26,910 --> 00:02:29,420
.داخل قصر المشعوذة البيضاء الملكيّ

19
00:02:30,170 --> 00:02:34,930
،كلانا في موقف شديد الخطورة
.لكنّه يقوم بعمله على أحسن وجه

20
00:02:36,070 --> 00:02:37,230
...هنري

21
00:02:37,850 --> 00:02:42,970
،بما أنّي لا أستطيع استعمال السّحر
.لا أظنّ أنّي كنتُ مفيدًا جدًّا

22
00:02:42,970 --> 00:02:45,390
،لا أستطيع فهم السّبب بالتّحديد

23
00:02:45,800 --> 00:02:49,660
لكن يراودني شعور مُلحّ بأنّي لا أستطيع
.تجاهل معاناة المشعوذين السّود

24
00:02:50,280 --> 00:02:54,130
أريد القيام بما أستطيعه لمساعدتهم حتّى
.إن كان ذلك سيشكّل خطرًا على حياتي

25
00:02:55,730 --> 00:02:58,650
.هكذا هو الأمر إذًا

26
00:02:58,650 --> 00:03:02,670
بما أنّ السّيّد طائر بنفسه شخص
،خارج المقاييس كمشعوذ أبيض

27
00:03:02,670 --> 00:03:04,910
.لذلك أعتقد أنّ هذا ليس غريبًا جدًّا

28
00:03:05,460 --> 00:03:09,660
.هذا الرّابط بينهما يخنقني

29
00:03:10,390 --> 00:03:13,230
،حتّى إن حاولت أن أشيح بنظري
.فلا يسعني إلاّ أن أراه

30
00:03:13,640 --> 00:03:16,290
،أمّا أنا، على العكس من ذلك
.فضعيف بما يكفي لأختفي

31
00:03:16,680 --> 00:03:22,180
...لكنّي أشعر بخيط القدر الواضح بينهما
.لم أعد أريد رؤية هذا بعد الآن

32
00:03:23,150 --> 00:03:27,090
بالمناسبة يا رياح، هل استطعت
القيام بمهمّتك بخصوص

33
00:03:27,090 --> 00:03:29,550
نهاية كلّ شيء" بدون أيّ حوادث؟"

34
00:03:29,870 --> 00:03:30,310
ماذا؟

35
00:03:35,810 --> 00:03:40,080
فهمت! مزّقتَ جلده السّامّ لأشلاء صغيرة

36
00:03:36,170 --> 00:03:38,840
!هذا مؤلم! مؤلم! مؤلم

37
00:03:40,080 --> 00:03:41,550
.وجعلتها تنتشر في كلّ مكان

38
00:03:40,630 --> 00:03:44,090
!لم يكن بوسعي فعل أيّ شيء آخر

39
00:03:44,500 --> 00:03:48,370
،كان جثّة تقريبًا على أيّ حال
فما الضّرر من ذلك؟

40
00:03:49,170 --> 00:03:52,330
.ماذا؟ لا تنظروا إليّ هكذا

41
00:03:52,330 --> 00:03:56,470
فهمت. أي أنّك نشرت بذور
.نهاية كلّ شيء" أكثر"

42
00:03:56,470 --> 00:03:58,360
.يا لها من كارثة بكلّ المقاييس

43
00:03:58,870 --> 00:04:03,480
لا بدّ أنّ استنشاق ذلك الهواء
.قد أثّر على ليزي أيضًا

44
00:04:05,000 --> 00:04:06,860
!لم ينتشر إلاّ قليلاً

45
00:04:06,860 --> 00:04:11,450
حرصتُ على إرسال الباقي منه
!إلى لهب وحجر بانتقالِ الرّيح

46
00:04:09,160 --> 00:04:13,100
"فريق تنظيف السّمّ (نهاية كلّ شيء)"
"مشعوذ اللّعب" "مشعوذة البلّور"

47
00:04:11,450 --> 00:04:14,630
!لقد طلبتم منّي الكثير في كل الأحوال

48
00:04:14,630 --> 00:04:18,620
آنسة لونا، هلاّ توقّفتِ عن النّظر إليّ
!بنظرات مخفية مختلفة في كلّ مرّة رجاءً؟

49
00:04:18,620 --> 00:04:23,740
قابلتُ اليوم لأوّل مرّة مشعوذين
،سود غير سيّدتي المشعوذة

50
00:04:23,740 --> 00:04:25,700
...لكنّ مشعوذ الرّياح هذا

51
00:04:23,740 --> 00:04:26,310
!مهلاً! تنظرون إليّ مثلها جميعًا الآن

52
00:04:25,700 --> 00:04:29,990
يبدو أنّه لا يجد أيّ مشكلة على
.الإطلاق في التّباهي بالمعايير الأخلاقيّة

53
00:04:26,310 --> 00:04:29,990
.بربّكم يا رفاق
!قولوا شيئًا ما على الأقلّ

54
00:04:29,990 --> 00:04:35,120
هيّا! لماذا تضايقونني هكذا؟
أتعرفون ما مررتُ به؟

55
00:04:35,120 --> 00:04:39,130
الأمر ليس كما لو أنّ الآنسة لونا والسّيّد طائر
.يقومان بجمع السّموم وتنظيفها أيضًا

56
00:04:39,130 --> 00:04:41,880
قتل "نهاية كلّ شيء" ونقل كلّ ذلك السّمّ

57
00:04:41,880 --> 00:04:44,510
!عمل شاقّ للغاية ومخيف ومجهد حقًّا

58
00:04:41,920 --> 00:04:44,510
"متمرّد بلا سبب"

59
00:04:43,630 --> 00:04:44,510
"لا يفهم الكبار هذا فحسب"

60
00:04:44,800 --> 00:04:48,130
وضعتُ حياتي على المحكّ مقاتِلاً وحشًا
وتريدون منّي أن أكون حسّاسًا في ذلك؟

61
00:04:48,130 --> 00:04:49,250
!هذا غير منطقيّ

62
00:04:49,250 --> 00:04:51,630
هنالك أشياء في الحياة لا يمكن
!القيام بها بشكل مثاليّ

63
00:04:51,630 --> 00:04:56,910
لكنّكم تقفون هناك وتحكمون عليّ
!من مسافة آمنة كأنّكم أفضل منّي

64
00:04:56,910 --> 00:04:59,230
.لكنّ هذا ليس سبب اشمئزازنا

65
00:04:59,230 --> 00:05:03,690
ألديكم الحقّ للهجوم عليّ
لأنّي أقوم بالأمور بشكل مختلف بقليل؟

66
00:05:03,690 --> 00:05:05,450
.أفترض أنّ ذلك صحيح

67
00:05:05,450 --> 00:05:09,470
.رياح محقّ فيما قال
ربّما علينا ترك الانتقاد

68
00:05:09,470 --> 00:05:13,620
للشّخصين المسؤولين عن التّخلّص
.من "نهاية كلّ شيء" بدل ذلك

69
00:05:09,830 --> 00:05:11,770
.تعنيف عاطفيّ

70
00:05:13,620 --> 00:05:15,490
.تعنيف عاطفيّ

71
00:05:13,620 --> 00:05:16,270
.واثق أنّهم في وضع أفضل للحكم عليك منّا نحن

72
00:05:17,050 --> 00:05:18,830
.تعنيف عاطفيّ

73
00:05:22,010 --> 00:05:26,670
لم أدرك أنّ المشعوذين السّود
.لديهم أدوار مختلفة هكذا

74
00:05:27,000 --> 00:05:28,970
..."مثل قتل "نهاية كلّ شيء

75
00:05:31,580 --> 00:05:35,980
.يا سيّد طائر، سأغادر الآن
.لا بدّ أنّ مشرفي يبحث عنّي

76
00:05:35,980 --> 00:05:39,610
.حسنًا. شكرًا على كلّ شيء. كن حذرًا

77
00:05:39,900 --> 00:05:43,550
ومن باب الحيطة، سألقي درعًا
.مزيّفًا على ذكرياتك

78
00:05:43,550 --> 00:05:44,890
.شكرًا جزيلاً لك

79
00:05:46,540 --> 00:05:48,430
،والآن يا لونا

80
00:05:49,060 --> 00:05:50,180
.مع السّلامة

81
00:05:51,860 --> 00:05:54,620
.استمتعتُ بلقائك كثيرًا

82
00:05:55,050 --> 00:05:59,380
،آمل أن أجدك ثانية يومًا ما
.سعيدة وفي أحسن حال

83
00:06:02,620 --> 00:06:03,880
.آنسة لونا

84
00:06:05,770 --> 00:06:10,010
أنا آسف جدًّا على تصرّفاتي الفظّة
...قبل قليل. لكن هل تظنّين أنّ

85
00:06:10,550 --> 00:06:12,490
بإمكانك ربّما القيام بما تقومين عليّ أيضًا؟

86
00:06:14,770 --> 00:06:16,170
.بطبيعة الحال

87
00:06:20,310 --> 00:06:24,070
،كنتُ مشغولاً جدًّا ولم أستطع زيارتك مؤخّرًا

88
00:06:24,070 --> 00:06:26,620
لذلك أنا آسف لأنّي جعلتُ
.الأمر يسوء لهذا الحدّ

89
00:06:28,840 --> 00:06:30,420
.لا مشكلة على الإطلاق

90
00:06:46,770 --> 00:06:49,960
لا بدّ أنّك عانيت كثيرًا ما دمت
.قد راكمتَ كلّ هذا القدر

91
00:06:51,780 --> 00:06:53,510
يتمتّع مشعوذو السّمّ

92
00:06:53,510 --> 00:06:58,310
بقدرة أكبر على تحمّل السّموم
،والتّعايش معها مقارنة بمعظم النّاس

93
00:06:58,310 --> 00:07:01,730
لكنّ هذا لا يعني
.أنّ لديهم سيطرة كاملة عليها

94
00:07:03,190 --> 00:07:05,650
.لكنّ لونا استثناء

95
00:07:06,070 --> 00:07:09,660
على البقيّة القيام بواجباتهم
.وهم ملوَّثون بالسّموم

96
00:07:11,030 --> 00:07:15,670
الفطر المسموم من كلّ الأحجام
والألوان المختلفة

97
00:07:16,020 --> 00:07:19,580
،يبدو مثل مهد يحمي رياح

98
00:07:20,180 --> 00:07:23,150
.وبدا جميلاً جدًّا لوهلة

99
00:07:24,170 --> 00:07:27,810
.آسفة على تعاملي بتعالٍ قبل قليل

100
00:07:27,810 --> 00:07:29,970
.أنا ممتنّة فعلاً على كلّ ما فعلت

101
00:07:30,470 --> 00:07:31,990
...وأيضًا

102
00:07:31,990 --> 00:07:36,440
كما لو كان يراقب رياح وهو نائم
،في غابة من الفطر العظيم

103
00:07:36,910 --> 00:07:40,860
.طفا ذلك الفطر برفق في الهواء ثمّ اختفى

104
00:07:42,490 --> 00:07:45,230
!أجل! كأنّي وُلدت من جديد

105
00:07:45,730 --> 00:07:49,140
!صار جسدي خفيفًا جدًّا
!أشعر وكأنّه صار لي أجنحة

106
00:07:49,140 --> 00:07:50,990
!شكرًا يا آنسة لونا

107
00:07:50,990 --> 00:07:53,990
.سرّني كثيرًا أنّي استطعتُ مساعدتك

108
00:07:56,250 --> 00:08:02,040
مهلاً، مهلاً. كلّما ابتسمت الآنسة لونا
.في وجهي أشعر بدفء بداخلي

109
00:08:02,040 --> 00:08:05,250
يا سيّدتي المشعوذة، أيمكنك
علاج أيّ نوع من الأمراض

110
00:08:05,250 --> 00:08:08,090
بتحويلها إلى فطر ثمّ إزالتها؟

111
00:08:08,570 --> 00:08:11,960
،أحيانًا، تكون الأمراض مرتبطة بمصير الشّخص

112
00:08:12,370 --> 00:08:16,040
لذلك لا يمكنني تحويل أيّ شيء
.إلى فطر وإزالته ببساطة

113
00:08:16,040 --> 00:08:21,100
في تلك الحالات، إمّا أتركها كأمراض

114
00:08:21,500 --> 00:08:25,850
،أو أحاول إخراجها بالقوّة
.لكن يكون لذلك ثمن باهظ

115
00:08:26,340 --> 00:08:27,640
ثمن؟

116
00:08:29,110 --> 00:08:34,110
بعد مغادرة ذلك الشّخص الآن وصرنا نعرف
،أنّ قوى الآنسة لونا قد عادت لطبيعتها

117
00:08:34,340 --> 00:08:37,230
لماذا لا نتحدّث معًا قليلاً؟

118
00:08:38,340 --> 00:08:40,820
.ثمّ سأتّخذ قراري

119
00:08:41,250 --> 00:08:45,460
هذا هو الاختبار الأخير لتحديد
.ما إذا كنتَ قد فشلت أم نجحت

120
00:08:48,760 --> 00:08:52,150
،أعتقد أنّك تعرف هذا الآن
لكنّ الطّفل الملعون أشبه ببيضة

121
00:08:52,150 --> 00:08:53,890
.تكبر لتصير "نهاية كلّ شيء" لاحقًا

122
00:08:54,490 --> 00:08:58,260
،لذلك يا ليزي، إن استمرّ هذا
.فستتحوّل إلى "نهاية كلّ شيء" أيضًا

123
00:09:15,730 --> 00:09:18,530
!ليزي؟ ليزي

124
00:09:20,740 --> 00:09:26,160
أعتقد أنّ نظرة الصّدمة على وجهك
تعني أنّ لا أحد أخبرك بأيّ شيء، صحيح؟

125
00:09:26,460 --> 00:09:31,010
واثق أنّ لديهم أسبابهم لعدم
،إخبارك بالحقيقة حيال كلّ هذا

126
00:09:31,500 --> 00:09:34,440
،لكنّنا لن نحرز أيّ تقدّم إن لم تعرف أيّ شيء

127
00:09:34,440 --> 00:09:37,260
.لذلك قرّرتُ إخبارك بنفسي

128
00:09:37,560 --> 00:09:44,020
لطالما شككتُ في الأمر. لكنّي
.لم أرِد تصديق أنّ ذلك حقيقة

129
00:09:44,380 --> 00:09:48,410
مُقدّر لطفل ملعون أن يصير
..."نهاية كلّ شيء"

130
00:09:48,410 --> 00:09:52,850
.أنت من كان ينبغي ألاّ يولد أصلاً

131
00:09:54,810 --> 00:09:55,560
ماذا؟

132
00:09:56,270 --> 00:09:56,990
...عفوًا

133
00:09:57,790 --> 00:09:58,630
ماذا؟

134
00:09:59,130 --> 00:10:02,850
.إنّك تغرق في الظّلمة دائمًا
.كم هذا مزعج

135
00:10:04,120 --> 00:10:06,530
هلاّ أخرجت نفسك من متاهة
الشّعور بالشّفقة على نفسك هكذا؟

136
00:10:06,530 --> 00:10:07,770
.لديّ عمل عليّ إنهاؤه

137
00:10:08,670 --> 00:10:12,670
إنّه يفتقر إلى التّعاطف والرّحمة
.لدرجة تكاد تكون صادمة

138
00:10:12,670 --> 00:10:13,670
ماذا هنالك؟

139
00:10:14,010 --> 00:10:15,030
.لا شيء

140
00:10:15,030 --> 00:10:18,670
.ولكن الآن، أعتقد أنّ ذلك ما أحتاجه بالضّبط

141
00:10:16,600 --> 00:10:18,170
.اسمع يا ليزي

142
00:10:18,670 --> 00:10:21,790
إنّك غارق بشكل كبير في حبّ
الآنسة لونا، صحيح؟

143
00:10:21,790 --> 00:10:23,770
.نعم. وعديم الإحساس أيضًا

144
00:10:23,770 --> 00:10:26,180
مهلاً. هل ظننتَ أنّ لا أحد لاحظ ذلك؟

145
00:10:26,180 --> 00:10:29,820
إنّ افتتانك بها واضح وضوح
.الشّمس حتّى لأغبى الأغبياء

146
00:10:30,310 --> 00:10:35,070
هذا سيّئ. لا يمكنني قضاء كلّ
.وقتي في سرد عيوب الآخرين

147
00:10:35,070 --> 00:10:39,540
هل أدركتَ أيضًا ما الوضع
الّذي وضعتَ فيه الآنسة لونا؟

148
00:10:40,020 --> 00:10:43,330
.لا أتحمّل. الحديث معه محبط للغاية

149
00:10:43,330 --> 00:10:47,450
إنّك عنيد بما يكفي لتصير
.مشعوذًا أبيض يا فتى

150
00:10:47,450 --> 00:10:52,040
ولكن اسمع، عليك التّخلّص
.من ذلك الإعجاب في الحال

151
00:10:52,580 --> 00:10:54,950
.لن يصل إلى أيّ مكان في كلّ الأحوال

152
00:10:55,340 --> 00:10:59,260
.أريدك أن تنهي هذا وهو في بدايته
هل تفهم قصدي؟

153
00:10:59,260 --> 00:11:04,140
،بالنّسبة للمشعوذين السّود
.الحبّ سمّ يُضعف سحرهم

154
00:11:05,340 --> 00:11:09,180
،لكن كما قلتَ للتّوّ
أليس من جانب واحد فقط؟

155
00:11:09,180 --> 00:11:10,590
.هذا صحيح

156
00:11:10,980 --> 00:11:15,520
،إن كان إعجابك بها السّبب في معاناتها

157
00:11:15,520 --> 00:11:18,900
،فسواء كان هنالك اختبار أم لا
.كنتُ لأقتلك على الفور

158
00:11:19,170 --> 00:11:23,160
،لكن اتّضح أنّ السّبب شخص آخر
.لذلك فقد نجوتَ من ذلك

159
00:11:23,260 --> 00:11:29,060
"كآبة"

160
00:11:24,070 --> 00:11:26,440
ماذا؟ أهذا أمر يجعلك تكتئب من أجله؟

161
00:11:26,440 --> 00:11:28,930
!إنّك تحبّ الغرق في الكآبة بالفعل

162
00:11:29,650 --> 00:11:34,670
،ومع ذلك، حتّى لو كان الثّمن حياتي
.كنتُ أتمنّى لو أنّه كان أنا

163
00:11:34,670 --> 00:11:39,460
ولكن بصراحة، هنالك سبب آخر
.منعني من قتلك ببساطة

164
00:11:34,670 --> 00:11:40,610
"كآبة"

165
00:11:39,940 --> 00:11:43,870
،على أيّ حال، إن كنت لا تريد الموت
عليك أن تقوّي سحرك

166
00:11:43,870 --> 00:11:45,580
.وتتعلّم كيف تقف على قدميك بنفسك

167
00:11:46,140 --> 00:11:50,500
هذا إن كنت تريد الهرب من مصيريك
.كطفل ملعون، كما فعلت الآنسة لونا

168
00:11:51,100 --> 00:11:54,260
.ربّما بدأ هذا يدفعني للجنون

169
00:11:55,170 --> 00:12:00,990
عندما عرفتُ أنّها كانت طفلة ملعونة
.مثلي، ظننتُ أنّنا نتشارك قدَرًا متشابهًا

170
00:12:00,990 --> 00:12:05,450
صارت هذه الفرحة الّتي شعرتُ
.بها سرًّا بصيصَ أمل لي

171
00:12:05,870 --> 00:12:11,100
صارت هذه الوحدة الّتي لا يمكنها
تشاركها أبدًا ما أنقذني

172
00:12:11,100 --> 00:12:12,790
.وما حطّمني أيضًا بطريقة ما

173
00:12:13,160 --> 00:12:16,840
حتّى بعد معرفتي أنّ الحبّ سمّ
،لسيّدتي المشعوذة

174
00:12:16,840 --> 00:12:19,850
تمنّيتُ بشدّة أن أصير من يحميها

175
00:12:20,180 --> 00:12:24,550
.ويشفي الجراح الّتي تحملها
.أريد أن أكون ذلك الشّخص

176
00:12:24,890 --> 00:12:29,100
،حتّى لو عجزتُ عن لمسها
.أريد البقاء إلى جانبها دائمًا

177
00:12:29,100 --> 00:12:33,230
!وحتّى الآن، لا يمكن تغيير كيف أشعر

178
00:12:33,230 --> 00:12:35,230
!المشعوذون البيض مقرفون

179
00:12:35,230 --> 00:12:39,380
حتّى بعد كلّ ما قُلته، ما زلت تتلذّذ
بكتابة قصائد حبّك التّافهة المقزّزة؟

180
00:12:39,380 --> 00:12:43,410
...هذا أنانيّ بشكل مقزّز
.رائحته تزكُم الأنوف

181
00:12:46,150 --> 00:12:49,590
.ما كان شخص مثلك ليفهم أبدًا

182
00:12:49,960 --> 00:12:54,180
ما كان مشعوذ أسود لم يحبّ
أيّ أحد آخر من قبل

183
00:12:54,180 --> 00:12:58,040
.أن يفهم أيّ شيء عن فرحة وألم الحبّ

184
00:12:58,410 --> 00:13:00,720
،تحشر مشاعر النّاس في تصنيفاتك السّطحيّة

185
00:13:00,720 --> 00:13:03,550
ثمّ تحاول تحطيمها والسّخرية
.منها واحدة تلو الأخرى

186
00:13:04,010 --> 00:13:08,450
كفّ عن التّصرّف
!وكأنّك تعرفني عن ظهر قلب

187
00:13:09,720 --> 00:13:13,180
.لم تفهم المقصود أبدًا
هل أنت بخير يا فتى؟

188
00:13:13,610 --> 00:13:17,900
لكن يبدو أنّك تحبّ الثّرثرة، ولكن لا بأس
.إن ساعدك ذلك على تفريغ بعض السّمّ

189
00:13:19,590 --> 00:13:21,730
.هنالك شيء واحد أودّ أن أسألك عنه

190
00:13:22,750 --> 00:13:25,950
هل تعتقد فعلاً أنّ حياةً
بلا حبّ سيّئة لهذه الدّرجة؟

191
00:13:26,490 --> 00:13:27,450
ماذا؟

192
00:13:27,450 --> 00:13:33,060
أسيجعلك ذلك تشعر أنّك ناقص
كشخص؟ أهو شيء يُشعرك بالخجل؟

193
00:13:33,400 --> 00:13:34,450
...ما

194
00:13:34,700 --> 00:13:38,590
وهل الأشخاص الّذين لم يقعوا
في الحبّ يومًا بلا قيمة في نظرك؟

195
00:13:39,400 --> 00:13:40,920
.لا أعرف الجواب على ذلك

196
00:13:41,530 --> 00:13:44,080
،لكنّي لستُ بحاجة لأسمعك بالتّحديد

197
00:13:44,080 --> 00:13:45,720
،طفل يقضي كلّ يوم مع الآنسة لونا

198
00:13:46,260 --> 00:13:49,660
وأنت تتحدّث بالسّوء عن النّاس
.الّذين لا يعرفون الحبّ

199
00:13:51,610 --> 00:13:55,290
إنّها غير قادرة على الحبّ
.لأسباب خارج سيطرتها بالكامل

200
00:13:55,290 --> 00:14:00,720
لذلك فإنّ ما تفعله يشبه
محاصرتها بأنانيّة في زاوية

201
00:14:00,720 --> 00:14:04,900
وإجبارها على قبول باقة زهور
.شوكيّة ستجرح يدها

202
00:14:10,260 --> 00:14:12,400
هذا ما جعلك تبكي؟

203
00:14:12,400 --> 00:14:13,910
!مهلاً، خرج شيء ما من دبّوسك

204
00:14:14,460 --> 00:14:17,590
عندما تكون مقيّدة بسلاسل كثيرة

205
00:14:17,590 --> 00:14:20,630
،تُلزمها بمصير لا يُتيح لها الحرّيّة من الأساس

206
00:14:21,630 --> 00:14:26,340
.لا أستطيع أن أتمسّك بحبّي لها كطفل أنانيّ

207
00:14:26,340 --> 00:14:28,170
.لا أملك الحقّ لأكون معها

208
00:14:29,580 --> 00:14:30,950
.أنا آسف

209
00:14:32,620 --> 00:14:34,090
!أنا آسف

210
00:14:48,540 --> 00:14:51,370
،أتعلم؟ منذ وقت طويل

211
00:14:51,370 --> 00:14:55,120
كان هنالك شخص يمكنك القول
.أنّي كنت معجبًا به

212
00:14:55,590 --> 00:14:56,310
ماذا؟

213
00:14:56,680 --> 00:14:58,620
هل فاجأك هذا لهذا الحدّ؟

214
00:14:59,310 --> 00:15:01,810
،كنتُ ممزّقًا بين مشاعري وواجباتي

215
00:15:02,200 --> 00:15:04,130
.وبالطّبع أثّر ذلك على سحري

216
00:15:05,190 --> 00:15:07,380
.لا تضحك عليّ يا هذا

217
00:15:07,380 --> 00:15:09,250
!ذلك فظّ جدًّا

218
00:15:09,250 --> 00:15:12,390
على أيّ حال، اشتدّت حيرتي لدرجة
،أنّي فكّرتُ في ألاّ أكون مشعوذًا أسود

219
00:15:12,900 --> 00:15:16,770
لكنّها لم تكن شخصًا يمكنني
.الاستغناء عنه بسهولة على أيّ حال

220
00:15:16,930 --> 00:15:22,630
لذلك قرّرتُ إلقاء تعويذة رياح
.على مشاعري ونثرتها مع الرّياح

221
00:15:23,340 --> 00:15:26,520
بحلول ذلك الوقت، كنتُ قد بعثرت
،الكثير من الأشياء الأخرى مع الرّيح

222
00:15:27,300 --> 00:15:30,670
،ورأيتُ كلّ تلك الأمور وهي تبتعد عنّي

223
00:15:38,520 --> 00:15:43,850
.لكن لم يكن أيّ منها جميلاً مثل هذا الشّيء

224
00:15:46,860 --> 00:15:51,090
جعلتني مشاهدة ذلك وهو
،يطفو بعيدًا أشعر بالحزن قليلاً

225
00:15:51,090 --> 00:15:54,970
لكنّها جعلتني أيضًا أدرك أنّني
.في الحقيقة أحمل شيئًا جميلاً بداخلي

226
00:15:56,630 --> 00:16:00,670
ظننتُ أنّي تشوّهتُ بسبب
،الأمور الرّهيبة الّتي شهدتها

227
00:16:00,670 --> 00:16:03,140
.لكنّني أدركتُ أنّه ربّما لا يزال هنالك أمل لي

228
00:16:03,420 --> 00:16:08,130
جعلني أدرك أنّ كلّ النّاس الّذين
.يحبّون يمتلكون شيئًا جميلاً بداخلهم

229
00:16:08,570 --> 00:16:10,530
وفجأة، اختفى كلّ الاستياء

230
00:16:10,530 --> 00:16:15,160
الّذي تمسّكتُ به بسبب اضطراري للقيام
.بعمل شاقّ بلا شكر لحماية الآخرين

231
00:16:15,570 --> 00:16:17,160
،فقدتُ حُبّي

232
00:16:17,740 --> 00:16:22,530
.لكن بقي لي في مكانه قلب أكبر قليلاً

233
00:16:23,430 --> 00:16:26,170
حسنًا، أكبر ممّا كان عليه
.من قبل على الأقلّ

234
00:16:28,110 --> 00:16:29,480
...والآن

235
00:16:30,470 --> 00:16:33,230
إيّاك أن تتجرّأ على رواية هذه القصّة
للمشعوذين السّود الآخرين، مفهوم؟

236
00:16:36,740 --> 00:16:37,600
.هذا صحيح

237
00:16:37,930 --> 00:16:42,530
أعتقد أنّ هذا يعني
.أنّنا الآن شركاء في الجريمة

238
00:16:47,610 --> 00:16:52,570
حان الوقت لأختم هذا الحبّ
.على طريقتي

239
00:16:52,570 --> 00:16:54,760
.بطريقة مناسبة لي

240
00:16:56,850 --> 00:17:00,140
.لقد تجاوز الاختبار، ولكن بشروط

241
00:17:00,490 --> 00:17:02,920
.المعذرة، لكنّني سبق وجعلته ينام

242
00:17:03,420 --> 00:17:07,750
يبدو أنّه يعرف سلفًا الكثير من الطُّرق
،للتّعامل مع السّمّ بداخله

243
00:17:07,750 --> 00:17:09,560
.لكنّها لا تعمل جيّدًا بما يكفي بعد

244
00:17:11,540 --> 00:17:15,060
حسب تقدير الآنسة لونا، يجب عليها
.سحب السّمّ منه عند الضّرورة

245
00:17:15,420 --> 00:17:20,510
،على الرّغم من السّلبيّات
.وافق بالفعل على ذلك الشّرط

246
00:17:20,770 --> 00:17:22,800
،رغم أنّني لن أكون قريبًا

247
00:17:22,800 --> 00:17:27,410
سأستمرّ في المساهمة بما أستطيع
.لمساعدته على تنمية قواه السّحريّة

248
00:17:28,210 --> 00:17:30,860
،لقد غيّرتُ ولائي لدعمه
.لذلك يجب عليّ تحمّل المسؤوليّة

249
00:17:31,820 --> 00:17:35,200
.شكرًا على حُكمك يا مشعوذ الرّياح

250
00:17:35,200 --> 00:17:38,280
.أنا مسرور بالفعل لأنّك كنت الحَكَم الأوّل

251
00:17:38,570 --> 00:17:41,710
.لديك حسّ فكاهة مضطرب يا سيّد طائر

252
00:17:41,710 --> 00:17:44,630
.ويا لقسوتك. كأنّ لديك أيّ فكرة عمّا مررتُ به

253
00:17:46,060 --> 00:17:46,790
فعلاً؟

254
00:17:47,470 --> 00:17:49,340
...عـ-عفوًا

255
00:17:50,670 --> 00:17:52,310
!شكرًا جزيلاً

256
00:17:53,220 --> 00:17:59,990
أنا أيضًا ممتنّة أنّك من قام بهذا
.يا مشعوذ الرّياح

257
00:18:01,500 --> 00:18:03,010
.اسمي غوس

258
00:18:03,240 --> 00:18:08,290
،لا تناديني بمشعوذ الرّياح
.اسمي هو غوستاف

259
00:18:08,290 --> 00:18:12,960
هيّا، كم مرّة عليّ إخبارك
أن تناديني غوس يا آنسة لونا؟

260
00:18:10,340 --> 00:18:12,960
ما-ماذا؟

261
00:18:12,960 --> 00:18:14,940
—غـ... غو

262
00:18:14,940 --> 00:18:15,970
واغيو؟

263
00:18:16,900 --> 00:18:20,030
.لا يهمّ. سأبقى على اتّصال

264
00:18:20,680 --> 00:18:25,170
سأغادر الآن. لا أزال شخصًا ذو شعبيّة
.كبيرة بالكثير من الأشياء للقيام بها

265
00:18:25,170 --> 00:18:28,440
...عـ-عفوًا يا غـ-غو

266
00:18:29,590 --> 00:18:30,870
.اعتن بنفسك

267
00:18:31,180 --> 00:18:32,540
.لقد استسلمتْ

268
00:18:33,220 --> 00:18:38,190
آنسة لونا، سأراك وليزي قريبًا
.عندما أمتلئ سمًّا ثانية

269
00:18:38,190 --> 00:18:39,590
استعملي فطرك عليّ حينها، موافقة؟

270
00:18:39,870 --> 00:18:44,850
أحبّ الفطر الّذي تجعلينه ينمو
!بشدّة يا آنسة لونا

271
00:18:44,850 --> 00:18:46,190
!سلام

272
00:18:47,740 --> 00:18:51,600
.سأنتظرك يا غوستاف

273
00:18:52,020 --> 00:18:55,090
.كان عليك قول ذلك بينما كان لا يزال قريبًا

274
00:18:56,070 --> 00:18:59,610
.لا بأس، أعتقد أنّه سمعها

275
00:19:01,940 --> 00:19:02,730
أرأيت؟

276
00:19:54,300 --> 00:19:57,150
.لا تبكي يا سيّدتي المشعوذة

277
00:19:57,670 --> 00:19:58,990
.لا بأس

278
00:19:59,380 --> 00:20:05,180
ما عدتُ سأتعلّق بأشياء فقدتها
.وسأكفّ عن إغراق نفسي في الحزن

279
00:20:05,890 --> 00:20:11,670
سأتسامح مع صِعابي هنا
،في غابة الفطر اللّطيف

280
00:20:12,140 --> 00:20:13,930
.حيث تحمينني

281
00:20:14,690 --> 00:20:19,930
.وأعلم أنّي سأجد الحبّ يومًا ما في المستقبل

282
00:20:22,210 --> 00:20:24,010
.صباح الخير

283
00:20:24,010 --> 00:20:25,740
سيّدتي المشعوذة؟

284
00:20:26,990 --> 00:20:30,520
.يبدو أنّ ملابسي قد صارت أكبر منّي

285
00:20:30,520 --> 00:20:32,380
...عفوًا، أنا

286
00:20:37,730 --> 00:20:41,260
!إنّها تناسبني الآن! شكرًا جزيلاً

287
00:20:44,190 --> 00:20:48,720
،لا يهمّ كم مرّة ستُمحى ذكرياتي
،ما زلتُ أتذكّر سرًّا

288
00:20:49,810 --> 00:20:52,600
،وبمساعدة صديقي الفطر الصّغير الوفيّ

289
00:20:53,010 --> 00:20:56,170
.مشاعري تُجاهها الّتي أتحدّث عنها كلّ ليلة

290
00:20:56,980 --> 00:21:00,980
يستعيد لي صديقي الصّغير المتحوّل

291
00:21:00,980 --> 00:21:06,240
كلّ تلك الذّكريات الّتي أفلتت
.من بين أصابعي عبر التّخاطر

292
00:21:12,450 --> 00:21:15,030
.لا أهتمّ إن كان هذا الحبّ لن يكتمل أبدًا

293
00:21:15,730 --> 00:21:17,690
.سأحملها بداخلي دائمًا

294
00:21:18,370 --> 00:21:21,990
.الحبّ هو مصدر قوّة سحر المشعوذين البيض

295
00:21:22,330 --> 00:21:27,150
.أريد حمايتها. أريد أن أصير مشعوذًا قويًّا

296
00:21:27,530 --> 00:21:30,820
ولتحقيق ذلك، سيظلّ هذا سرًّا
.ومصدرًا لا غنى عنه للقوّة

297
00:21:31,430 --> 00:21:36,450
لا يوجد أيّ نوع من السّحر أو تقلّبٍ
.في القدر يمكنهما أن يسلباني هذا

298
00:21:37,400 --> 00:21:39,400
.سأتقبّل خسارة بعض الأشياء

299
00:21:39,790 --> 00:21:42,260
.وعندما أتعب وأضعف، سأشدّد عزيمتي

300
00:21:40,140 --> 00:21:41,990
!مرحبًا! هنا، هنا

301
00:21:42,810 --> 00:21:47,530
،سأقدّر هذه اللّحظات
.حتّى إن نسيتها في نهاية المطاف

302
00:21:43,310 --> 00:21:45,460
.لا تعترضي طريقي يا بقرة

303
00:21:47,870 --> 00:21:51,530
لعلّ الذّكريات الّتي أفلتت
من بين يديّ ستجد يومًا ما

304
00:21:48,170 --> 00:21:50,140
هل أعلّق بعضها؟

305
00:21:51,530 --> 00:21:54,050
حياة جديدة وتظلّ متألّقة
.في قلب شخص آخر

306
00:21:54,580 --> 00:21:56,670
إنّ الأصداء المتبقّية اللّحظات الهادئة

307
00:21:56,670 --> 00:22:00,470
،وما رعته من مشاعر وروابط صداقة

308
00:22:00,470 --> 00:22:02,550
.تمدّني بالقوّة لأستمرّ

309
00:22:03,130 --> 00:22:07,570
لذلك مهما اضطررتُ إلى البدء من
.جديد ولمرّات عديدة، فلن أستسلم

310
00:22:08,330 --> 00:22:11,710
وبينما أعيش مع المشعوذة
،الّتي لن تحبّني أبدًا

311
00:22:12,980 --> 00:22:16,970
.سأواصل شقّ طريقي لأصير بالغًا