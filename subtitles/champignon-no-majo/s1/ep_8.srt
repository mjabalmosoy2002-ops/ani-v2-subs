1
00:01:31,080 --> 00:01:35,260
.إنّه الصّباح. عليّ أكل شيء ما

2
00:01:36,760 --> 00:01:39,120
نحيف

3
00:01:37,060 --> 00:01:39,120
.صباح الخير

4
00:01:41,070 --> 00:01:42,870
.يبدو أنّه فقد بعض الوزن

5
00:01:43,220 --> 00:01:46,890
.لا يحبّ ليزي أكل الكثير من الأشياء

6
00:01:49,130 --> 00:01:52,630
.حتّى أنّه تظاهر بالمرض من قبل

7
00:01:53,690 --> 00:01:57,010
لا يمكنني
...الأكل

8
00:01:54,040 --> 00:01:56,440
.لكنّ لونا اكتشفت كذبه في الحال

9
00:01:57,240 --> 00:01:59,970
.أتساءل إن كان لا يحبّ طعام لونا فحسب

10
00:02:02,010 --> 00:02:04,060
!سأعود لاحقًا

11
00:02:02,280 --> 00:02:05,580
مُنح بعض الوقت
لقطف الفراولة

12
00:02:07,020 --> 00:02:11,020
هل قال ليزي حقًّا أنّه يكره طبخك؟

13
00:02:07,660 --> 00:02:13,040
الحلقة 7
المشعوذة البيضاء والمشعوذة السّوداء

14
00:02:11,240 --> 00:02:16,030
.إنّه من العائلة الملكيّة قبل كلّ شيء
.لعلّه صعب الإرضاء بشان طعامه

15
00:02:18,530 --> 00:02:23,150
لكن ألا يصلح هذا للأكل فعلاً؟
.اقرصيه إن اضطررتِ، أجبريه على تناوله

16
00:02:24,940 --> 00:02:31,320
على أيّ حال، لسنا مضطرّين نحن
،المشعوذون السّود على الأكل مثل البشر

17
00:02:31,320 --> 00:02:34,000
.لذلك لا نفهم كيف يتمّ ذلك حقًّا

18
00:02:38,440 --> 00:02:41,140
.يا سيّدَ الفطر، شكرًا على لقائي

19
00:02:42,460 --> 00:02:44,010
،بعد التّفكير في الأمر

20
00:02:44,010 --> 00:02:48,940
سمعتُ أنّ آكلي الطّاقة الطّبيعيّة يتذوّقون
.الأشياء بطريقة مختلفة عن البشر

21
00:02:46,790 --> 00:02:50,520
بعد أن لاحظ أنّ لونا والبقيّة يتصرّفون
بغرابة، خطّط ليزي للحديث
مع الفطر المتكلّم سرًّا ثانية

22
00:02:48,940 --> 00:02:51,070
ماذا؟ فعلاً؟

23
00:02:51,070 --> 00:02:53,520
آكلو الطّاقة الطّبيعيّة؟

24
00:02:53,520 --> 00:02:56,380
،يمكننا الاكتفاء بالطّاقة الطّبيعيّة وحدها

25
00:02:56,380 --> 00:02:59,220
لكن بما أنّه أقرب إلى البشر
،ويتمتّع ببنية مشعوذ أبيض

26
00:02:59,220 --> 00:03:00,850
.فالأمر ليس بتلك السّهولة

27
00:03:00,850 --> 00:03:05,430
يا سيّدَ الفطر، ما معنى
آكلي الطّاقة الطّبيعيّة"؟"

28
00:03:06,040 --> 00:03:07,690
.حسنًا

29
00:03:07,690 --> 00:03:13,190
لا يستمدّ المشعوذون السّود مثل
،لونا غداءهنّ من تناول الطّعام

30
00:03:13,190 --> 00:03:18,550
بل يستخلصون السّحر وقوّة الحياة
.مباشرة من الطّبيعة نفسها

31
00:03:18,930 --> 00:03:21,690
،إنّ المشعوذون السّود
،بما يمتلكون من سحر قويّ

32
00:03:21,690 --> 00:03:26,000
،تتدفّق في أجسامهم طاقة متجدّدة دائمًا

33
00:03:26,000 --> 00:03:29,060
.لذا فإنّهم لا يشيخون كما يفعل البشر

34
00:03:29,670 --> 00:03:35,430
لم يكن لديهم أيّ حاجة لتقاليد
.المطبخ الّتي طوّرها البشر

35
00:03:35,850 --> 00:03:41,460
ومع ذلك، لونا مهتمّة جدًّا
،بثقافة وعادات البشر

36
00:03:41,460 --> 00:03:45,300
وربّما كانت تحاول تقليد
.ما عرفته عن الطّهي

37
00:03:45,660 --> 00:03:50,330
ربما أرادت أن تتذوّق تجربة
.العيش في عالم البشر

38
00:03:51,170 --> 00:03:56,750
ومع ذلك، يبدو أنّ الملاحظة
والكتب وحدها لم تكفيا لتعلّمها

39
00:03:56,750 --> 00:03:58,980
.كيف ينبغي أن يكون طعم شيء ما

40
00:03:58,980 --> 00:04:00,610
...سيّدتي المشعوذة المسكينة

41
00:04:01,290 --> 00:04:05,390
أتذكرين تلك المرّة الّتي قلتِ فيها
أنّك خبزتِ كعكة أرزّ جيّدة

42
00:04:05,390 --> 00:04:08,010
وقرّرتِ إرسالها إلى مشعوذ
آخر كعربون شكر؟

43
00:04:09,770 --> 00:04:13,300
.تلك الكعكة! لقد كانت لذيذة جدًّا

44
00:04:13,650 --> 00:04:17,160
.كانت لسيّد الطّيور وأنا من أخذها إليه

45
00:04:17,160 --> 00:04:18,820
...تذوّقها وقال

46
00:04:18,820 --> 00:04:23,320
أهذا عقار تجريبيّ من نوع ما؟

47
00:04:24,730 --> 00:04:30,080
لذلك ربّما سيكون عليك جعل
صديق بشريّ يتذوّق طبخك

48
00:04:30,080 --> 00:04:32,420
.والحصول على نصائح

49
00:04:34,830 --> 00:04:37,990
أهذا دواء على شكل فطيرة؟

50
00:04:37,330 --> 00:04:45,340
صيدليّة

51
00:04:37,990 --> 00:04:44,130
بصراحة، أعتقد أنّ الأقراص
.والجرعات المعتادة أسهل للهضم

52
00:04:47,340 --> 00:04:52,850
مشعوذ الفئران

53
00:04:47,820 --> 00:04:48,860
.عجبًا

54
00:04:48,860 --> 00:04:51,330
.لا يشبه هذا أيّ طعام على الإطلاق، نعم

55
00:04:52,850 --> 00:04:55,990
.حتّى الخنازير ما كانت لتأكل هذا

56
00:04:56,350 --> 00:05:00,360
أمير الخنازير لانسلوت

57
00:04:56,600 --> 00:04:58,770
.ربّما سيكون أفضل كطعام للأبقار

58
00:05:01,030 --> 00:05:04,610
.عفوًا. لستُ بحاجة لأكل أيّ منه
.بإمكاني الشّعور بهالته

59
00:05:04,610 --> 00:05:07,610
اكتشاف تهديدات

60
00:05:04,610 --> 00:05:07,610
صاحب متجر الكتب

61
00:05:04,610 --> 00:05:07,610
.لكن تفضّلي كتاب طبخ أعتقد أنّ عليك قراءته

62
00:05:09,060 --> 00:05:13,890
هكذا إذًا. هنالك طفل بشريّ
.تحاولين الطّبخ له

63
00:05:14,250 --> 00:05:16,870
أتستعملين مكوّنات جيّدة؟

64
00:05:17,100 --> 00:05:20,880
،إن لم أستطع توفير شيء ما
.لا أستعمله أو أستبدله بشيء آخر

65
00:05:20,880 --> 00:05:25,660
،إن كان ذلك كلّ ما تفعلينه
.لا ينبغي أن تكون النّتيجة بهذا السّوء

66
00:05:25,660 --> 00:05:27,630
.لا تقلقي يا لونا

67
00:05:29,390 --> 00:05:32,140
أيمكنك التّفكير في أيّ سبب آخر لهذا؟

68
00:05:32,140 --> 00:05:35,810
،أستعمل سحر العكس لإزال السّمّ من الفطر

69
00:05:35,810 --> 00:05:40,850
وأغشّ أحيانًا باستعمال السّحر
.لجعل الطّعام يبدو كالحقيقيّ أكثر

70
00:05:40,850 --> 00:05:42,150
.هذا هو السّبب

71
00:05:48,340 --> 00:05:49,250
...عفوًا

72
00:05:49,250 --> 00:05:50,660
.مرحبًا، تفضّلي

73
00:05:50,660 --> 00:05:52,390
—أريد قالب جبن و

74
00:05:52,390 --> 00:05:56,150
كلاّ! إنّها مشعوذة الفطر السّامّ
!الّتي يتحدّث عنها الجميع

75
00:05:56,150 --> 00:06:01,670
هلاّ غادرتِ رجاءً؟ لا تجعلي
.أيّ فطر ينمو على منتجاتي رجاءً

76
00:06:01,670 --> 00:06:04,100
!كلاّ! ابتعدي عن متجري

77
00:06:04,100 --> 00:06:07,510
ما الّذي ستفعلينه
إن أفسدت كلّ بضائعي؟

78
00:06:11,180 --> 00:06:12,610
!لا تقتربي منّي

79
00:06:12,610 --> 00:06:15,060
!غادري بلدتنا في الحال

80
00:06:30,430 --> 00:06:31,200
ماذا؟

81
00:06:31,200 --> 00:06:34,180
ما هذا؟ تريدين منّا بيعك خضروات؟

82
00:06:37,430 --> 00:06:40,260
.إنّ هذا يضعنا في وضع سيّئ جدًّا

83
00:06:40,260 --> 00:06:43,980
أنت مشعوذة السّمّ من
الغابة السّوداء، أليس كذلك؟

84
00:06:48,180 --> 00:06:52,720
إن عرف النّاس أنّي بعتك كلّ هذا
.الحليب، فسأكون في مشكلة كبيرة

85
00:06:53,030 --> 00:06:57,250
أنا آسف، لكن عليّ أن أطلب منك
.ضعف سعر السّوق وإلاّ فلن أبيعك

86
00:06:59,470 --> 00:07:04,870
هكذا إذًا. أعتقد أنّ بإمكاني بيعك
.بعضها بثلاثة أضعاف سعر السّوق

87
00:07:20,430 --> 00:07:21,540
.يا فتى

88
00:07:21,950 --> 00:07:23,020
يا فتى؟

89
00:07:23,500 --> 00:07:27,290
.إنّ حزنك يتحوّل إلى ركود وبدأ يتدفّق منك

90
00:07:28,510 --> 00:07:33,510
هل عليّ فعلاً الكتابة عن هذا
الشّعور في يوميّاتي؟

91
00:07:34,110 --> 00:07:37,990
إن دوّنته، فسيكون الأمر
.وكأنّي لم أشعر به أبدًا

92
00:07:37,990 --> 00:07:43,410
سأعود إلى نقطة لا أعرف فيها أيّ شيء
.عن كيف تشعر سيّدتي المشعوذة

93
00:07:43,720 --> 00:07:49,460
أعلم أنّ الرّكود الّذي يتراكم داخلي
،يخلق مشاكل كبيرة للجميع

94
00:07:49,900 --> 00:07:53,030
لكنّ فكرة مواصلة العيش
بلا أيّ ذكرى عن ألمها

95
00:07:54,010 --> 00:07:56,410
.تخيفني أكثر

96
00:07:56,850 --> 00:08:00,890
هل هنالك أيّ طريقة للاحتفاظ بهذه المشاعر؟

97
00:08:01,290 --> 00:08:04,290
،بالنّسبة إليّ، حتّى وإن كنت ملعونًا

98
00:08:05,010 --> 00:08:08,690
،فهذا الألم ثمين جدًّا
.بل لا يمكن تعويضه أبدًا

99
00:08:09,550 --> 00:08:12,380
،حتّى إن قالوا أنّ هذه المشاعر سامّة

100
00:08:14,450 --> 00:08:16,550
.لا أريد التّخلّي عنها

101
00:08:17,830 --> 00:08:20,710
.لونا، عاد ليزي للمنزل للتّوّ

102
00:08:21,060 --> 00:08:22,540
.مرحبًا بك

103
00:08:22,540 --> 00:08:25,310
هل قطفت الكثير
من توت العلّيق وما شابه؟

104
00:08:26,330 --> 00:08:28,670
.لا، لم أفعل ذلك

105
00:08:29,080 --> 00:08:31,890
.كم أنت أخرق يا ليزي

106
00:08:31,890 --> 00:08:36,540
.لا يمكنك فعل أيّ شيء بدوني
.سأذهب معك في المرّة القادمة لمساعدتك

107
00:08:36,540 --> 00:08:39,720
.العشاء جاهز. تفضّل بالجلوس

108
00:08:46,730 --> 00:08:47,890
!هذا مذهل

109
00:08:48,340 --> 00:08:49,940
!رائحته زكيّة

110
00:08:49,940 --> 00:08:51,340
!يبدو لذيذًا

111
00:08:51,340 --> 00:08:55,090
.إنّه حساء يقطين وحليب مع الخبز

112
00:08:55,090 --> 00:08:57,590
.عفوًا، لكنّي لم أعدّ الكثير

113
00:09:00,580 --> 00:09:03,100
!شكرًا على الطّعام

114
00:09:09,100 --> 00:09:10,610
!هذا لذيذ

115
00:09:13,610 --> 00:09:18,200
يا ليزي، أنا من وجدتُ الرّجل
.الّذي يبيع هذا الحليب

116
00:09:18,200 --> 00:09:20,630
!وخبزتُ الخبز بنفسي

117
00:09:20,630 --> 00:09:21,960
!هذا كذب

118
00:09:21,960 --> 00:09:23,910
!صحيح، كنتُ أكذب

119
00:09:23,910 --> 00:09:27,170
يا بنيّ، يجب أن تعمّق فهمك

120
00:09:27,170 --> 00:09:30,500
.وتفتح قلبك على وسعه قدر الإمكان

121
00:09:30,500 --> 00:09:34,720
أي أنّ عليك اختبار قدر هائل
من الفرح والسّرور

122
00:09:34,720 --> 00:09:38,070
حتّى يغطّي ذلك على الرّكود
.الّذي تحمله بداخلك

123
00:09:39,510 --> 00:09:44,730
،ولكن لكي تجد السّعادة
.يجب أن تنظر إلى قلبك أنت

124
00:09:45,100 --> 00:09:49,250
لذا يا بنيّ، اسعَ وراء أكبر قدر
.ممكن من البهجة

125
00:09:49,740 --> 00:09:55,240
إن فعلت ذلك، حتّى أشدّ أنواع
.الرّكود ستضطرّ إلى الفرار في النّهاية

126
00:09:59,500 --> 00:10:05,250
،في ذلك اليوم، بينما قلبي وبطني ممتلئان
.لم أكتب أيّ شيء في يوميّاتي

127
00:10:06,410 --> 00:10:12,460
في اليوم التّالي، سألتُ سيّدتي المشعوذة
.وسيّد الفطر عن كيفية إنشاء حديقة

128
00:10:12,460 --> 00:10:16,970
أخبرتني سيّدتي المشعوذة أنّ لديّ
،موهبة طبيعيّة في زرع الخضروات

129
00:10:16,970 --> 00:10:22,720
وذهبت إلى البلدة لتجلب لي
.كتابًا عن البستنة

130
00:10:22,940 --> 00:10:25,810
قالت أنّها ستسمح لي بدراسة البستنة

131
00:10:25,810 --> 00:10:28,450
.ما دمت لا أهمل تدريبي على السّحر

132
00:10:28,450 --> 00:10:30,730
.بدأتُ حقًّا أحبّ هذا

133
00:10:31,190 --> 00:10:35,770
عندما كنت أدرس، كانت الأمور الصّغيرة
.الّتي كانت تزعجني تختفي تمامًا

134
00:10:36,970 --> 00:10:40,950
،كنتُ أتخيّل أيّام الحراثة
،وأيّام مشاهدة النّباتات وهي تنمو

135
00:10:40,950 --> 00:10:45,120
،وأيّام شكر الشّمس والأرض والأمطار

136
00:10:45,120 --> 00:10:48,880
،وأيّام مشاهدة نباتاتي تنمو
.وأيّام الحصاد

137
00:10:48,880 --> 00:10:55,470
،كلّما تخيّلت تلك الأيّام القادمة
.يمتلئ قلبي بالفرح

138
00:10:58,510 --> 00:11:00,190
.حسنًا، قم بذلك ثانية

139
00:11:00,670 --> 00:11:01,640
.حاضر

140
00:11:07,880 --> 00:11:10,130
!لا تشتّت انتباهك أيّها الغبيّ

141
00:11:11,140 --> 00:11:12,600
.أنا آسف

142
00:11:12,600 --> 00:11:13,860
.يا إلهي

143
00:11:13,860 --> 00:11:17,700
يا لجرأتك! تتكاسل وأنت أصلاً
.لا يمكنك تعلّم أيّ شيء يُذكر

144
00:11:22,330 --> 00:11:27,370
لاحظتُ أنّي أفكّر بسيّدتي
.المشعوذة طوال الوقت مؤخّرًا

145
00:11:28,030 --> 00:11:32,370
.ولكن ليس عن كونها مشعوذة سمّ
.بل عن مدى جمالها

146
00:11:32,930 --> 00:11:37,860
أتساءل لماذا. أشعر وكأنّ
،كلّ خليّة في داخلي

147
00:11:37,860 --> 00:11:40,880
من أعلى رأسي حتّى أطراف
.أصابع قدمي، تنجذب إليها

148
00:11:42,880 --> 00:11:44,850
هل تستمع لي من الأساس؟

149
00:11:44,850 --> 00:11:46,890
.عليّ التّركيز على تدريبي

150
00:11:46,890 --> 00:11:48,530
.هذا ليس جيّدًا بما يكفي

151
00:11:46,890 --> 00:11:52,390
!نعيب! غيااه! صراخ

152
00:11:48,530 --> 00:11:52,080
:كما أُعاقَب بأقبح التّعابير في هذا العالم

153
00:11:49,400 --> 00:11:51,080
.تعنيف عاطفيّ

154
00:11:52,080 --> 00:11:54,380
.وجه الغراب البشع

155
00:11:52,850 --> 00:11:54,680
.تعنيف عاطفيّ

156
00:11:54,680 --> 00:11:55,800
!عليّ بذل جهد أكبر

157
00:11:56,680 --> 00:11:57,900
.تعنيف عاطفيّ

158
00:11:56,680 --> 00:11:57,900
.كلاّ

159
00:11:58,140 --> 00:12:01,570
،يقول الغراب أنّه يراقب ليزي
.لكنّ ذلك مجرّد عذر للتّنمّر عليه

160
00:12:03,140 --> 00:12:05,410
!هذا ليس تنمّرًا بل تدريبًا

161
00:12:06,140 --> 00:12:11,300
سحر العكس وسحر الوقت
...وسحر المكان وسحر التّحوّل

162
00:12:07,560 --> 00:12:09,500
.تعنيف عاطفيّ

163
00:12:11,300 --> 00:12:13,170
.تعنيف عاطفيّ

164
00:12:11,300 --> 00:12:14,420
ثمّة أنواع عديد من السّحر
.يفترض بي تعلّمها

165
00:12:14,420 --> 00:12:16,420
.الخطوة التّالية تفّاحة. جرّب ذلك

166
00:12:14,850 --> 00:12:16,420
.تعنيف عاطفيّ

167
00:12:17,090 --> 00:12:20,170
.أنا أتدرّب الآن على سحر التّجسيد

168
00:12:20,910 --> 00:12:26,630
عليّ استعمال شيء ما من جسدي
.وتجسيد شيء آخر موجود سلفًا

169
00:12:28,890 --> 00:12:32,930
بإمكانك تجسيد ورقة شجر
واحدة من خصلة شعرك تلك؟

170
00:12:32,930 --> 00:12:37,170
على هذا المعدّل، سينتهي بك المطاف
.أصلعًا قبل أن تجسّد تفّاحة واحدة

171
00:12:37,170 --> 00:12:38,580
!كا، كا، كا

172
00:12:39,440 --> 00:12:42,120
مهما جرّبت، الشّيء الوحيد الّذي أتحسّن فيه

173
00:12:42,120 --> 00:12:44,450
.هو حجب أيّ شيء يقوله لي الغراب

174
00:12:44,450 --> 00:12:47,900
.يا لونا. أريه كيف يقوم بذلك ثانية

175
00:12:53,630 --> 00:12:59,190
بالنّسبة للمشعوذين الموهوبين، حتّى
شعرة واحد... لا، بل قطرة عرق واحدة

176
00:12:59,190 --> 00:13:01,950
.كافية لتجسيد شيء ما لم يكن موجودًا

177
00:13:02,710 --> 00:13:06,730
.أتقنت لونا هذا السّحر في رمشة عين

178
00:13:06,720 --> 00:13:09,720
في رمشة عين

179
00:13:07,980 --> 00:13:12,280
.بدأت أدرك أنّي قد أكون فاشلاً كبيرًا

180
00:13:12,280 --> 00:13:16,830
لـ-لكن على الأرجح أنّ التّفّاح
.الّذي أجسّده سيّئ المذاق

181
00:13:16,830 --> 00:13:21,140
أعتقد أنّ ذلك مطمئن، لكنّي
.لستُ واثقًا كيف أردّ على ذلك

182
00:13:22,020 --> 00:13:23,260
.يمكنك أكل هذه

183
00:13:23,570 --> 00:13:26,090
تقدّمين لي تفّاحة سيّئة؟

184
00:13:26,090 --> 00:13:27,740
...لا-لا يفترض أن

185
00:13:28,070 --> 00:13:29,740
.لا تفعلي ذلك يا لونا

186
00:13:29,970 --> 00:13:32,740
...لـ-لكن على الأرّجح... أنّها ليست

187
00:13:32,740 --> 00:13:38,750
.ما زلتُ لا أعرف ما هدفي في الحياة
.أنا أجهل الكثير من الأمور

188
00:13:39,580 --> 00:13:40,940
!نجحت

189
00:13:40,940 --> 00:13:43,810
!مذهل، هذا رائع يا ليزي

190
00:13:41,970 --> 00:13:44,760
لكنّي أريد الارتقاء لتطلّعات
.سيّدتي المشعوذة

191
00:13:44,760 --> 00:13:50,390
وبتلك الفكرة كمرشد لي، أظنّ أنّي
.قادر على تحمّل أيّ تدريب شاقّ

192
00:13:51,690 --> 00:13:53,770
.عليك أن تكفّي عن تدليله

193
00:13:57,270 --> 00:14:03,280
.سيأتي أعضاء المجلس قريبًا لاختباره
.قد يحدث ذلك في أيّ يوم الآن

194
00:14:04,450 --> 00:14:07,060
لذلك ما السّحر الّذي تعلّمه حتّى الآن؟

195
00:14:07,380 --> 00:14:09,780
.كـ-كيفية استعمال يوميّاته

196
00:14:10,180 --> 00:14:11,930
!ذلك لا يُحتسب أصلاً

197
00:14:12,830 --> 00:14:16,170
.تعلّم سحر الجاذبيّة والشّفاء والتّجسيد

198
00:14:16,170 --> 00:14:18,290
.بالكاد يستطيع تنفيذ أيّ من هذا

199
00:14:21,010 --> 00:14:22,490
!وهذا كلّ شيء؟

200
00:14:22,490 --> 00:14:28,170
لكنّ سيدَ الفطر قال أنّ ليزي بإمكانه
.أن يجعل النّباتات تنمو بسرعة كبيرة

201
00:14:28,170 --> 00:14:29,800
—شيء ما عن الحضر

202
00:14:28,900 --> 00:14:31,690
.أيّتها البقرة. يكفي كلامًا عن هذا

203
00:14:34,810 --> 00:14:38,310
،أدركتُ مذ بدأتُ الزّراعة

204
00:14:39,170 --> 00:14:44,220
أنّي حتّى لو لم تكن لديّ بذور، أستطيع
.جعل النّباتات الّتي أتخيّلها تنبت

205
00:14:44,220 --> 00:14:47,770
.هذا ليس بالأمر السّهل بالنّسبة لمعظم النّاس

206
00:14:48,320 --> 00:14:53,050
،هذا ما قالته سيّدتي المشعوذة
لكنّ الجميع يتصرّف بشيء من التّوجّس

207
00:14:53,050 --> 00:14:55,750
.حيال هذه القوّة الّتي لديّ

208
00:14:57,410 --> 00:14:58,650
...على أيّ حال

209
00:15:00,180 --> 00:15:02,850
.ليزي، كل بقدر ما تشاء

210
00:15:02,850 --> 00:15:04,920
.واكبر لتصير فتى كبيرًا

211
00:15:04,920 --> 00:15:08,840
الأولاد الّذين يتدلّلون في طعامهم
.لن يكبروا ويصيروا أقوياء

212
00:15:10,930 --> 00:15:13,750
ماذا؟ ما سبب كآبته؟

213
00:15:14,170 --> 00:15:15,490
.لا أدري

214
00:15:17,390 --> 00:15:18,430
لماذا؟

215
00:15:18,920 --> 00:15:23,440
لماذا جسدي أصغر بكثير
من جسد سيّدتي المشعوذة؟

216
00:15:23,850 --> 00:15:30,270
.الأمر أشبه بكوني طفلاً وهي راشدة
.لسنا مناسبين لبعض على الإطلاق

217
00:15:30,610 --> 00:15:34,700
لكن يراودني شعور أنّ جسدي
.لم يكن يفترض أن يكون هكذا

218
00:15:35,310 --> 00:15:39,700
شعور بأنّه كان ينبغي أن أكون
.الحامي، وليس من يتمّ حمايته

219
00:15:40,470 --> 00:15:44,930
عليّ أن أركّز على تدريبي
،على السّحر الآن

220
00:15:44,930 --> 00:15:47,380
لكن أشعر بالإرهاق من أمور
لا يمكنني السّيطرة عليها

221
00:15:47,380 --> 00:15:49,880
.وأتشتّتُ بأفكار غير منطقيّة

222
00:15:50,780 --> 00:15:54,790
أواجه مشاكل بالإفصاح
.عن هذا الارتباك في يوميّاتي

223
00:15:55,260 --> 00:15:57,090
.أو ربّما لا أريد ذلك

224
00:15:57,700 --> 00:16:01,090
.لا أريد تبرير كلّ شيء

225
00:16:06,440 --> 00:16:08,980
.عرفتُ هذا، ليس أمامه أيّ فرصة

226
00:16:09,530 --> 00:16:10,370
فعلاً؟

227
00:16:10,990 --> 00:16:14,130
،بعد كلّ ذلك التّدريب على السّحر الأسود

228
00:16:14,130 --> 00:16:17,190
على الأرجح أنّه يمتلك عُشر
.القدرات الّتي يفترض أن يمتلكها الآن

229
00:16:18,370 --> 00:16:19,740
...مستحيل

230
00:16:19,740 --> 00:16:22,000
.لا بدّ أنّك اكتشفت الأمر الآن يا لونا

231
00:16:22,600 --> 00:16:25,720
.إنّه سليل مشعوذين بيض بكلّ تأكيد

232
00:16:27,710 --> 00:16:32,040
ويبدو أنّ لديهم طريقتهم
.الخاصّة لإيقاظ قدراتهم

233
00:16:32,730 --> 00:16:35,980
.سيكون عليه أن يكتشف ما ذلك بنفسه

234
00:16:37,260 --> 00:16:42,020
،لكن بالنّسبة لنا نحن المشعوذين السّود
.ذلك شيء ربّما علينا تفاديه

235
00:16:46,020 --> 00:16:48,520
،بذلت جهدًا جيّدًا في تدريبك اليوم
.مع أنّك تقوم بذلك بطريقة خاطئة

236
00:16:48,750 --> 00:16:53,780
.من الأفضل أن تتوقّف عن ذلك
.يا له من إهدار لشعر جميل

237
00:16:54,660 --> 00:16:55,780
من هناك؟

238
00:16:55,780 --> 00:16:58,510
أيمكنك سماعنا؟

239
00:16:58,510 --> 00:17:00,790
.بدأت قواه السّحريّة تنمو

240
00:17:01,080 --> 00:17:03,950
.نحن هنا تمامًا. انظر للأسفل

241
00:17:03,950 --> 00:17:06,250
.لا، بل خلفك

242
00:17:12,050 --> 00:17:14,010
!لاحظ وجودنا أخيرًا

243
00:17:14,010 --> 00:17:15,940
.سررت بلقائك يا ليزي

244
00:17:15,940 --> 00:17:18,100
.مرحبًا بك في عالم الأرواح

245
00:17:19,030 --> 00:17:20,490
أرواح؟

246
00:17:20,490 --> 00:17:22,310
!انظرا كم هو متفاجئ

247
00:17:22,620 --> 00:17:26,270
يا إلهي، لم تلاحظ
.وجودنا طوال هذا الوقت

248
00:17:26,270 --> 00:17:28,760
.لكن ما زال يبدو ظريفًا حتّى وهو مرتبك

249
00:17:28,760 --> 00:17:33,010
.طاب يومك يا ليزي
.أنا روح الفاصولياء الّتي أنشأتَها

250
00:17:33,010 --> 00:17:34,660
.لديّ ما أخبرك به

251
00:17:35,580 --> 00:17:41,050
حتّى إن فعلتَ ما تطلبه منك المشعوذة
.السّوداء، فلن تصير مثلها أبدًا

252
00:17:41,050 --> 00:17:41,740
ماذا؟

253
00:17:41,740 --> 00:17:43,760
.أنا روح الشّوك

254
00:17:43,760 --> 00:17:47,180
.ليزي، شكرًا لاعتنائك جيّدًا بنا

255
00:17:47,180 --> 00:17:51,710
للمنحدرين من سلالة المشعوذين البيض
.بنية جسديّة مختلفة عن المشعوذين السّود

256
00:17:51,710 --> 00:17:52,820
بنية جسديّة؟

257
00:17:52,820 --> 00:17:56,140
،تحمل بذور هذا الطّفل سحرًا أكبر ممّا يجب

258
00:17:56,140 --> 00:17:58,590
.والأرواح الخضراء كلّها في حالة ارتباك

259
00:17:58,590 --> 00:18:02,600
.اصمتي يا روح الماء
.لا تكوني مزعجة طوال الوقت

260
00:18:02,600 --> 00:18:04,230
ماذا يحدث؟

261
00:18:07,670 --> 00:18:12,390
.مرحبًا يا ليزي. أنا روح الرّيح
لا تفهم أيّ شيء من هذا، صحيح؟

262
00:18:13,110 --> 00:18:15,430
."المشعوذون البيض هم "تعاويذ آسرة

263
00:18:15,430 --> 00:18:19,370
بتعبير آخر، تسمح جاذبيّتك بأسر
.قوّة الأرواح أو الشّياطين

264
00:18:19,370 --> 00:18:20,520
تعاويذ آسرة"؟"

265
00:18:20,910 --> 00:18:24,650
يستمدّ المشعوذون البيض قوّتهم السّحريّة
.وطول عمرهم من تلك الطّاقات

266
00:18:25,000 --> 00:18:28,540
أرأيت؟ لذل فإنّ المشعوذين
.البيض والسّود مختلفون تمامًا

267
00:18:29,650 --> 00:18:32,010
،قد تبدو قوى المشعوذين البيض تافهة

268
00:18:32,010 --> 00:18:36,580
لكنّ قوّة تعاويذهم الآسرة هي نقطة
.ضعف للمشعوذين السّود في الحقيقة

269
00:18:37,580 --> 00:18:41,820
.يا إلهي. كينوبيو منزعج جدًّا
.ربّما قلنا أكثر ممّا ينبغي قوله

270
00:18:44,390 --> 00:18:47,750
اسمع يا ليزي، عليك إتقان تعاويذك الآسرة

271
00:18:47,750 --> 00:18:50,410
.واستعمال تلك القوّة للتّرفيه عنّا

272
00:18:50,410 --> 00:18:55,390
.إن فعلت ذلك، فسنستطيع مساعدتك
.هكذا تعمل قوى المشعوذين البيض

273
00:18:56,140 --> 00:18:59,900
.لكنّي ما زلت أجهل ما كلّ هذا

274
00:19:00,320 --> 00:19:03,550
.صحيح، لكنّك بدأت ترى سلفًا

275
00:19:03,550 --> 00:19:05,430
.غنّ لنا أغنية يا ليزي

276
00:19:05,430 --> 00:19:09,900
.أغنية؟ لم أغنّي من قبل
.لا يمكنني حتّى التّفكير في أغنية

277
00:19:11,150 --> 00:19:16,700
يمكنك ذلك. خذ مشاعرك
.وغنّها على أيّ لحن تتخيّله

278
00:19:17,130 --> 00:19:19,850
.هذا تدريبك كمشعوذ أبيض

279
00:19:19,850 --> 00:19:21,360
تدريب؟

280
00:19:21,360 --> 00:19:23,140
.جرّب ذلك يا ليزي

281
00:19:55,170 --> 00:19:57,890
ما ذلك الغناء؟ أذلك هو؟

282
00:19:59,390 --> 00:20:02,130
.هذه لغة أرواح بكلّ تأكيد

283
00:20:02,680 --> 00:20:03,990
!يا سيّدَ الفطر

284
00:20:05,140 --> 00:20:09,530
.على الأرجح أنّه يحمل تلك اللّغة في خلاياه

285
00:20:10,180 --> 00:20:14,420
أتعرفان معنى ما يغنّيه يا لونا وكلود؟

286
00:20:14,850 --> 00:20:18,650
وكيف لي أن أعرف؟
.لكن يمكنني أن أحزر نوعًا ما

287
00:20:19,670 --> 00:20:21,650
أتفهمها أنت يا سيّدَ الفطر؟

288
00:20:21,650 --> 00:20:24,160
.نعم، بكلّ تأكيد

289
00:20:27,430 --> 00:20:31,060
،ليزي، عندما تقع في الحبّ يومًا ما

290
00:20:31,930 --> 00:20:37,170
سيصبح الغناء هو عزاءك
.وقوّتك ومرشدك

291
00:20:38,670 --> 00:20:41,670
صوت من هذا؟

292
00:20:41,670 --> 00:20:46,180
قوّة الحبّ هي ما توقظ
تعاويذ المشعوذين البيض الآسرة

293
00:20:47,390 --> 00:20:49,330
.وتضاعفها

294
00:20:57,690 --> 00:21:00,260
!مذهل! أنت رائع يا ليزي

295
00:21:00,260 --> 00:21:03,000
!كم هذا ظريف! أؤيّد هذا تمامًا

296
00:21:03,000 --> 00:21:07,810
.ليزي، سأقدّم لك بركة الأشجار

297
00:21:12,200 --> 00:21:15,560
.وسنقدّم لك نحن حماية الماء

298
00:21:16,430 --> 00:21:19,740
.وسنهديك نحن بذور الأماني

299
00:21:25,110 --> 00:21:27,290
أفهمت الآن يا ليزي؟

300
00:21:27,970 --> 00:21:31,030
إنّ صقل تعاويذك الآسرة بقوّة الحبّ

301
00:21:31,030 --> 00:21:33,470
هو مفتاح النّجاح في تدريب
.سحر المشعوذين البيض

302
00:21:33,470 --> 00:21:36,490
ثمّة الكثير من أنواع المشعوذين
،البيض المختلفين

303
00:21:36,490 --> 00:21:39,090
!لكنّ غناءك جميل بشكل خاصّ

304
00:21:39,480 --> 00:21:42,490
،قد يكون الحبّ سمًّا للمشعوذين السّود

305
00:21:42,490 --> 00:21:44,840
.لكنّه مصدر قوّة للمشعوذين البيض

306
00:21:45,150 --> 00:21:46,490
ماذا؟ سمّ؟

307
00:21:46,490 --> 00:21:51,990
.غنّ ثانية يا ليزي
.غنّ لتنال بركاتٍ حتّى من السّماء

308
00:21:52,210 --> 00:21:54,000
!غنّ حتّى يظهر قوس قزح

309
00:21:56,520 --> 00:22:00,230
،في تلك اللّحظة
.كنتُ لا أزال لا أفهم أيّ شيء

310
00:22:01,220 --> 00:22:04,010
.يبدو أنّ حدسي ذاك كان في محلّه

311
00:22:04,010 --> 00:22:05,560
،إنّ هذا يثير غثياني

312
00:22:06,010 --> 00:22:09,620
لكن إن ساعده، فلن أشتكي
.بشأن كيفية قيامه بذلك

313
00:22:11,180 --> 00:22:14,240
.ما دام ذلك لا يضعها في خطر

314
00:22:14,240 --> 00:22:17,540
لم أكن أعرف أنّ هذا الشّعور
،الّذي أيقظ سحري

315
00:22:17,870 --> 00:22:20,330
،هذا الحبّ الّذي يأتي مرّة في العمر

316
00:22:25,180 --> 00:22:29,460
.قد يحاصرك يا لونا

317
00:24:06,650 --> 00:24:10,250
الحلقة القادمة
المنزل في الغابة السّوداء