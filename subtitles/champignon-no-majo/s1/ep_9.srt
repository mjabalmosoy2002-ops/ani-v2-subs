1
00:00:03,350 --> 00:00:06,030
جي" من المشعوذة الخضراء"

2
00:00:06,030 --> 00:00:09,110
.الّتي تذبل تحت أشعة الشمس الحارقة

3
00:00:09,110 --> 00:00:11,660
دابليو" من مشعوذة الماء"

4
00:00:11,660 --> 00:00:14,510
.الّتي تغلي من تعذيب النّار

5
00:00:14,510 --> 00:00:17,160
إس" من أجل مشعوذة الصّخر"

6
00:00:17,160 --> 00:00:20,290
.الّتي تحطّمت لقطع صغيرة

7
00:00:20,290 --> 00:00:22,800
إي" من أجل مشعوذة الشّرق"

8
00:00:22,800 --> 00:00:25,920
.الّتي وقعت في حفرة وودّعناها

9
00:00:25,920 --> 00:00:28,480
بي" من أجل مشعوذة الوحوش"

10
00:00:28,480 --> 00:00:31,340
.الّتي ارتعبت يومًا بسبب رمح حادّ

11
00:00:31,340 --> 00:00:34,360
سي" من أجل مشعوذة الفطر"

12
00:00:34,360 --> 00:00:35,890
.الّتي لا يُزعجها سمّها

13
00:00:35,890 --> 00:00:37,250
،إنّها الأكثر إخافة بينهنّ

14
00:00:37,250 --> 00:00:39,930
.لذلك ستجلب نهاية كلّ شيء

15
00:00:39,930 --> 00:00:43,830
...ثمّ الكثير من الشّياطين
!لنطردهم جميعًا في الحال

16
00:00:43,830 --> 00:00:46,150
!أجل! لقد فزت

17
00:00:45,000 --> 00:00:51,550
الحلقة 9
المنزل في الغابة السّوداء

18
00:00:47,230 --> 00:00:52,030
.إنّهم أطفال من القرية
،يُحذّرهم الكبار من الاقتراب

19
00:00:52,030 --> 00:00:56,620
لكنّهم يأتون أحيانًا للّعب قرب
.الغابة هكذا على أيّ حال

20
00:00:57,030 --> 00:01:00,280
.ليزي، لنذهب

21
00:01:02,130 --> 00:01:04,000
نهاية كلّ شيء؟

22
00:01:04,460 --> 00:01:06,810
.لا تدع تلك الأمور تؤثّر عليك

23
00:02:42,140 --> 00:02:45,780
،قيل لي أنّ عليّ العثور على سعادة كبيرة

24
00:02:46,500 --> 00:02:49,270
لكنّي أجد نفسي غارقًا
،في هذا الحزن الشّديد أحيانًا

25
00:02:49,660 --> 00:02:51,810
.ولا أستطيع تدوينه في يوميّاتي

26
00:02:56,690 --> 00:02:59,410
كيف تتعاملين مع شيء كهذا
يا سيّدتي المشعوذة؟

27
00:03:00,180 --> 00:03:04,280
،أعرف أنّ ذلك بدا غير ناضج ومبتذل
.لكنّي استجمعتُ الشّجاعة لأسألها

28
00:03:14,150 --> 00:03:18,820
أحاول تذكّر شيء محزن، احتفظتُ
،به عميقًا في داخلي وأبكي على ذلك

29
00:03:19,140 --> 00:03:22,300
وأستعمل تلك الدّموع كأساس
.لأجعل المزيد من الفطر ينمو

30
00:03:22,790 --> 00:03:25,360
،ثمّ أعدّ الشّاي من فطر الدّموع ذاك

31
00:03:25,360 --> 00:03:28,820
.ثمّ أشربه وأبكي أكثر للتّخلّص من السّموم

32
00:03:29,930 --> 00:03:32,010
.إنّ ذلك يساعدني كثيرًا بالفعل

33
00:03:32,650 --> 00:03:35,400
ثم أستعمل الدّموع الّتي ذرفتُها
.للحصول على فطر أكثر

34
00:03:35,910 --> 00:03:39,940
أجابت بإجابة غير تقليديّة
.ولكنّها عمليّة للغاية

35
00:03:40,360 --> 00:03:42,570
.لا تقلق. إنّها خالية من الكافيين

36
00:03:43,070 --> 00:03:45,320
.تلك ليست مشكلتي بالضّبط

37
00:03:45,660 --> 00:03:48,200
أتودّ مشاهدتي أعدّ بعض الشّاي؟

38
00:03:48,200 --> 00:03:51,430
،لا أدري لماذا بدت متحمّسة فجأة

39
00:03:51,830 --> 00:03:55,260
.لكنّي شعرتُ بشدّة أنّه لا ينبغي لي الرّفض

40
00:04:09,460 --> 00:04:12,250
!مذهل! رائحته زكيّة

41
00:04:14,460 --> 00:04:18,360
.لكنّي لم أشمّ أيّ شيء كهذا من قبل
.يا لها من رائحة فريدة

42
00:04:18,780 --> 00:04:24,130
كانت غنيّة ولكن رقيقة، وجعلتني
.أتخيّل نفسي أطفو في محيط دافئ

43
00:04:24,130 --> 00:04:25,330
.رائحة ناعمة للغاية

44
00:04:26,190 --> 00:04:27,370
...عفوًا

45
00:04:27,770 --> 00:04:30,270
،لم أستخرج كلّ السّمّ

46
00:04:30,270 --> 00:04:33,120
لكن لا ترغم نفسك على شربه
.إن وجدته مقرفًا

47
00:04:33,120 --> 00:04:38,030
بينما كانت سيّدتي المشعوذة تتلعثم
،بتوتّر وهي تؤكّد أنّها أزالت كلّ السّمّ

48
00:04:38,030 --> 00:04:40,000
.ظننتُ أنّها بدت ظريفة نوعًا ما

49
00:04:40,250 --> 00:04:41,630
...ولكن مهلاً

50
00:04:43,220 --> 00:04:48,970
،الدّموع الّتي نما منها هذا الفطر
...كانت جزءًا من جسدها

51
00:04:48,970 --> 00:04:51,390
لماذا يبدو شديد التّركيز هكذا فجأة؟

52
00:04:51,390 --> 00:04:54,210
.أتمنّى أنّك لا تفكّر في شيء قذر يا ولد

53
00:04:54,550 --> 00:04:55,930
.توقّف أيّها الغراب

54
00:04:56,820 --> 00:05:00,570
!مذهل! رائحة شهيّة! شكرًا لك

55
00:05:20,270 --> 00:05:22,620
.ذرفتُ الكثير من الدّموع

56
00:05:24,820 --> 00:05:30,550
كان هنالك حزن وألم بداخلي
.بما يكفي لملء كوب كامل

57
00:05:35,450 --> 00:05:39,020
،لن أخسر الذّكريات الّتي كانت مرتبطة بالحزن

58
00:05:39,330 --> 00:05:42,180
والفطر الّذي نما من دموعي

59
00:05:42,690 --> 00:05:48,460
بدا لونه مثل زمرّديّ ممزوج بالأزرق
.السّماويّ. كان له لون جميل وعميق

60
00:05:50,900 --> 00:05:53,750
،أخذَته سيّدتي المشعوذة وقطّعته

61
00:05:55,240 --> 00:05:56,260
،ثمّ جفّفته

62
00:05:57,410 --> 00:06:00,120
،وقلته لإزال السّمّ منه

63
00:06:00,900 --> 00:06:02,700
.وقامت بغليه للتّخلّص من الذّكريات

64
00:06:03,790 --> 00:06:07,350
وفي الوقت الّذي صار فيه
،الشّاي من فطر دموعي جاهزًا

65
00:06:07,730 --> 00:06:12,260
شعرتُ أنّ قلبي مشرق ونقيّ مثل
.السّماء الزّرقاء بشكل لا يُصدّق

66
00:06:16,300 --> 00:06:19,940
.تستطيع أن تقرّر بنفسك متى تشربه

67
00:06:20,280 --> 00:06:23,440
لكن لا تنس جمع الدّموع
.الّتي ستذرفها في كوب

68
00:06:25,880 --> 00:06:29,200
.كانت مراسمَ ذرفِ دموعٍ متقنة جدًّا

69
00:06:29,630 --> 00:06:32,450
كانت هنالك جِرار من شاي
.دموع سيّدتي المشعوذة

70
00:06:32,450 --> 00:06:38,060
لا بدّ أنّ إعداد كلّ هذا الشّاي استغرق
.ليالٍ عديدة من الشّعور بالحزن الشّديد

71
00:06:38,060 --> 00:06:42,710
أتساءل كم ليلة شعرت
.سيّدتي المشعوذة بذلك

72
00:06:43,080 --> 00:06:46,580
،أتساءل كم يومًا قضته هكذا

73
00:06:47,180 --> 00:06:49,720
.تتحمّل بصمت كلّ هذا الحزن

74
00:06:50,130 --> 00:06:52,860
أعددتُ أيضًا بعض الشّاي
.لمساعدتك على النّوم يا كلود

75
00:06:54,110 --> 00:06:54,970
.ليزي

76
00:06:57,070 --> 00:07:01,620
كنت أبدأ بالتّفكير في ذلك خلال حفلات
،شاي فطر الدّموع الّتي كنّا نقيمها

77
00:07:01,620 --> 00:07:04,150
.لذا كانت تتركني دائمًا بشعور من الحزن

78
00:07:11,830 --> 00:07:17,280
أيُعقل يا لونا أنّك أعطيتِ شاي
الدّموع للغراب عن طريق الخطأ؟

79
00:07:17,280 --> 00:07:19,290
!سيقتلني إن أدرك ذلك

80
00:07:20,170 --> 00:07:22,170
.سأتظاهر أنّي لم أرَ شيئًا

81
00:07:23,320 --> 00:07:27,170
لم أكن أعرف أنّ للغراب
.أيّ دموع بداخله

82
00:07:29,070 --> 00:07:29,920
.هذا مقرف

83
00:07:52,370 --> 00:07:55,110
.يا سيّدتي المشعوذة، لديّ سؤال

84
00:07:56,180 --> 00:07:59,310
.جيّد. بدأ يهتمّ بالدّراسة

85
00:08:00,110 --> 00:08:04,830
ما الّذي يجري هنا؟
ما الّذي يفعله هذان الشّخصان؟

86
00:08:05,890 --> 00:08:07,750
.أسحب ما قلتُه من قبل

87
00:08:08,100 --> 00:08:11,230
،"كُتب هنا أنّها "قبلة

88
00:08:11,230 --> 00:08:15,970
ولكن لماذا قد يفعلان شيئًا مثل هذا؟

89
00:08:18,230 --> 00:08:20,270
أهذا الشّقيّ جادّ؟

90
00:08:22,940 --> 00:08:26,200
عفوًا، هل أنت بخير يا سيّدتي المشعوذة؟

91
00:08:26,780 --> 00:08:28,790
!لا تدعيه ينال منك يا لونا

92
00:08:29,490 --> 00:08:31,590
...ذ-ذلك

93
00:08:31,590 --> 00:08:34,460
هل يمكن أن يفقد ذكرياته
بخصوص أمر كهذا بالفعل؟

94
00:08:35,030 --> 00:08:38,970
القبلةُ شيءٌ يقوم به الأشخاص عندما
.يكونون مقرّبين جدًّا من بعضهم

95
00:08:38,970 --> 00:08:42,610
،إنّها علامة على الحميميّة
.مثل تحيّة

96
00:08:43,660 --> 00:08:48,390
هل قبّلتِ شخصًا ما من قبل
يا سيّدتي المشعوذة؟

97
00:08:48,760 --> 00:08:50,710
!لا يتهاون في أسئلته أبدًا

98
00:08:53,390 --> 00:08:54,750
.تسمّرتْ في مكانها

99
00:08:55,150 --> 00:08:56,550
.إنّها لا تتحرّك

100
00:08:56,970 --> 00:08:58,620
.أصابها عُطل بالتّأكيد

101
00:08:59,450 --> 00:09:04,570
إلى أيّ مدى يجب أن يكونا
مقرّبين حتّى يمكنهما التّقبيل؟

102
00:09:04,570 --> 00:09:09,310
هل تُعدّ علاقتي بك مقرّبة لذلك
الحدّ يا سيّدتي المشعوذة؟

103
00:09:09,540 --> 00:09:12,820
!هذا الوغد

104
00:09:13,340 --> 00:09:18,070
...سيتدثّر بمظهرٍ من البراءة

105
00:09:13,960 --> 00:09:18,530
أم أنّ العلاقة بيننا أنا وأنت

106
00:09:18,530 --> 00:09:21,800
لا تُعدّ مقرّبة لتلك الدّرجة؟

107
00:09:22,180 --> 00:09:24,410
،في تلك اللّحظة، فكّر الغراب قائلاً

108
00:09:24,410 --> 00:09:28,670
لم يخطر ببالي أنّه يمكن"
".طلب قبلة بطريقة كهذه

109
00:09:29,340 --> 00:09:32,730
.مقتبس من مذكّرات كلود الغراب

110
00:09:33,540 --> 00:09:39,650
يـ-ينطبق تعريف القبلة هذا
.على الأشخاص العاديّين فقط

111
00:09:40,530 --> 00:09:44,410
إنّ ذلك لا ينطبق على شخص
.بجسد سامّ مثلي

112
00:09:46,350 --> 00:09:48,850
.كان ذلك ردًّا معقولاً من لونا

113
00:09:49,440 --> 00:09:51,690
...عفوًا، أنا

114
00:09:51,690 --> 00:09:54,530
حتّى لو اضطررنا لفعل ذلك
،من خلال قماش سحريّ

115
00:09:54,770 --> 00:09:57,700
.فأنا أودّ أن أقبّلك يا سيّدتي المشعوذة

116
00:09:58,770 --> 00:09:59,910
!ماذا؟

117
00:10:00,430 --> 00:10:02,660
!لا يعرف هذا الشّقيّ متى يستسلم

118
00:10:14,430 --> 00:10:18,140
.حتّى الغرباء يقبّلون أيدي بعضهم
.سمعتُ أنّ ذلك مجرّد لباقة

119
00:10:18,680 --> 00:10:21,930
!استسلم أيّها الوغد

120
00:10:34,220 --> 00:10:39,450
آمل أن تسمحي لي يومًا ما بتقبيلك
.على شفتيك يا سيّدتي المشعوذة

121
00:10:41,170 --> 00:10:44,700
!حسنًا، سأذهب للتّدرّب على سحري

122
00:10:46,740 --> 00:10:47,950
لونا؟

123
00:10:49,090 --> 00:10:54,710
ذلك الوغد. إنّه يعرف تمامًا كيف يقدّم
قبلة رسميّة على اليد، أليس كذلك؟

124
00:10:54,710 --> 00:10:59,050
!يا لجرأة ذلك المشعوذ الأبيض الشّقيّ

125
00:10:59,050 --> 00:11:03,220
!لا يعرف ما هي القبلة؟

126
00:11:03,220 --> 00:11:05,220
!كان كلّ ذلك مجرّد تمثيل

127
00:11:05,660 --> 00:11:09,200
!كانت سيّدتي المشعوذة جميلة جدًّا

128
00:11:09,200 --> 00:11:15,230
أشعر اليوم أنّني سأقدر على القيام بالسّحر
!الصّعب الّذي عانيتُ معه في التّدريب

129
00:11:16,510 --> 00:11:21,470
.أشعر وكأنّ قلبي سيطير
!أشعر وكأنّي قادر على فعل أيّ شيء

130
00:11:22,670 --> 00:11:24,490
التّسوّق في القرية؟

131
00:11:24,490 --> 00:11:26,240
تريد منّي الذّهاب بالفعل؟

132
00:11:26,240 --> 00:11:29,270
،نعم، ستُسدينا خدمة بذلك

133
00:11:29,590 --> 00:11:34,130
وسيمنحنا ذلك فرصة لتقييم
.تقدّم سحرك كاختبار أوّليّ

134
00:11:34,130 --> 00:11:35,900
.وستقوم البقرة بمراقبتك

135
00:11:35,900 --> 00:11:37,070
أنا؟

136
00:11:37,070 --> 00:11:41,380
إنّ لونا تحميك دائمًا لذلك
،ربّما لم تدرك الأمر بعد

137
00:11:41,380 --> 00:11:44,680
لكنّ فتى مثلك لا يمكنه
استعمال سحره بعد

138
00:11:44,680 --> 00:11:47,870
هو هدف سهل لكلّ أنواع
.الشّياطين والكائنات السّامّة

139
00:11:48,270 --> 00:11:50,720
واثق أنّك سترى بعضها بمجرّد
خروجك من الغابة

140
00:11:50,720 --> 00:11:52,910
.وبعيدًا عن حماية لونا

141
00:11:53,440 --> 00:11:56,120
شياطين وكائنات سامّة؟

142
00:11:56,580 --> 00:12:00,550
استعمل السّحر الّذي تعلّمته حتّى
الآن لحماية نفسك والبقرة

143
00:12:00,550 --> 00:12:02,200
.وأكمل هذه المهمّة

144
00:12:02,420 --> 00:12:06,060
،إن لم تستطع تولّي حتّى ذلك
.فسيتمّ التّخلّي عنك في كلّ الأحوال

145
00:12:07,370 --> 00:12:10,170
وإذا كنت جبانًا وتفضّل
أن يتمّ الاعتناء بك هنا

146
00:12:10,170 --> 00:12:13,250
بينما تلعب "بيت بيوت" في حديقتك
.الصّغيرة، فافعل ما تشاء

147
00:12:14,940 --> 00:12:18,710
،لكن اسمعني جيّدًا
.من الأفضل ألاّ تحاول الهرب

148
00:12:18,710 --> 00:12:22,980
.وإن هربت، فسأحوّل تلك البقرة لحساء

149
00:12:22,980 --> 00:12:25,970
!أظنّ أنّ الغربان تحبّ الحساء كثيرًا

150
00:12:26,450 --> 00:12:29,110
الاعتناء بي" من طرف لونا"
..."ولعب "بيت بيوت

151
00:12:31,420 --> 00:12:35,480
.سأذهب. لن أحاول الهرب

152
00:12:35,480 --> 00:12:40,230
سأكمل المهمّة بأمان وأعود
!إلى هذا المنزل

153
00:12:42,190 --> 00:12:47,950
"حساء لحم بقر"

154
00:12:42,630 --> 00:12:45,330
.إذًا فهي مجرّد رحلة تسوّق عاديّة

155
00:12:45,870 --> 00:12:47,950
.نـ-نعم

156
00:12:48,570 --> 00:12:52,200
ليس هنالك ما تقلق حياله
.بوجودي إلى جانبك

157
00:12:52,200 --> 00:12:55,830
،بمجرّد تجاوزنا لتلكما التّلّتين
.فسنصل إلى قرية ماشر

158
00:12:55,830 --> 00:12:56,960
.حسنًا

159
00:12:56,960 --> 00:13:00,410
،ولمعلوماتك، إن تحوّلتُ إلى حساء

160
00:13:00,410 --> 00:13:05,340
فعلى الأرجح أنّه سيكون ألذّ حساء
في العالم. ألا توافقني يا ليزي؟

161
00:13:05,340 --> 00:13:07,220
...ماذا؟ ذلك

162
00:13:07,690 --> 00:13:12,470
،ومع ذلك ما زلتُ لا أريد أن أُؤكل
.لذلك من الأفضل ألاّ تهرب

163
00:13:12,800 --> 00:13:17,960
مينوس، سيكون لدينا وقت
.للأكل لاحقًا. لنواصل المسير

164
00:13:21,230 --> 00:13:23,990
!أريد بعضًا من ذلك العشب هناك أيضًا

165
00:13:23,990 --> 00:13:26,010
!مينوس، هيّا بنا

166
00:13:26,010 --> 00:13:30,490
يبدو أنّ عشاء اليوم سيكون حساء
.لحم بقر عفن في نهاية المطاف

167
00:13:31,130 --> 00:13:33,500
"!مينوس! عليك العودة"

168
00:13:38,000 --> 00:13:40,340
.ليزي، لنسرع إلى القرية

169
00:13:40,340 --> 00:13:44,010
يمكنني شمّ بعض العشب
.اللّذيذ على الطّريق أمامنا

170
00:13:45,320 --> 00:13:47,610
!ما الّذي فعله؟

171
00:13:48,170 --> 00:13:50,590
هل استعمل لغة الأرواح للتّوّ؟

172
00:13:52,910 --> 00:13:57,880
.ليزي، أقدّم لك بَركة الأشجار

173
00:13:57,880 --> 00:13:59,520
!شكرًا جزيلاً

174
00:14:05,990 --> 00:14:08,120
.إنّه حلزون

175
00:14:08,530 --> 00:14:13,910
.إنّه كائن سامّ، لذلك كن حذرًا
.لا تقترب منه كثيرًا يا ليزي

176
00:14:14,310 --> 00:14:16,160
كائن سامّ؟

177
00:14:16,770 --> 00:14:18,230
ما هذه؟

178
00:14:19,160 --> 00:14:22,150
إنّها كائنات حيّة استهلكت الكثير
من سموم العالم

179
00:14:22,520 --> 00:14:26,030
.وتسمّمت بالكامل... وتحوّلت

180
00:14:27,000 --> 00:14:29,980
.يتحوّل بعضها بسبب كائنات سامّة أخرى

181
00:14:30,430 --> 00:14:36,180
.لكنّها ليست شياطين
.لكن عليك تعلّم ما الفرق بينها

182
00:14:36,680 --> 00:14:38,440
.كن حذرًا يا ليزي

183
00:14:39,350 --> 00:14:42,010
.لا أعتقد أنّه سيقوم بأيّ شيء

184
00:14:42,440 --> 00:14:45,080
.لا تدس على مخاطه السّامّ فحسب

185
00:14:45,440 --> 00:14:48,320
.لا بدّ أنّه يتألّم كثيرًا

186
00:14:48,320 --> 00:14:50,960
،إن كانت لونا هنا
لاستطاعت امتصاص سمّه

187
00:14:50,960 --> 00:14:54,330
.وجعلته أكثر ارتياحًا على الأقلّ

188
00:14:54,330 --> 00:14:59,700
عندما تلتقي سيّدتي المشعوذة بكائنات
سامّة، فهل تمتصّ سمّها أيضًا؟

189
00:14:59,700 --> 00:15:01,830
.تمتصّ فقط ما يكفي لمنحها قليلاً من الرّاحة

190
00:15:02,090 --> 00:15:06,340
كانت ترشّ عليها بعض الأبواغ
،الّتي تمصّ السّمّ

191
00:15:06,580 --> 00:15:13,350
لكنّ ذلك جعل الفطر ينمو لأحجام
.كبيرة مع أنّه امتصّ ألمها

192
00:15:13,350 --> 00:15:16,190
لكنّها الآن تضع عليها قماشًا يمتصّ السّمّ

193
00:15:16,190 --> 00:15:19,950
.ويمنع الوبالة من الانتشار

194
00:15:20,780 --> 00:15:25,610
انظر هناك. إنّهما يرتديان
.أقمشة وضعتها لونا عليهما

195
00:15:25,610 --> 00:15:31,070
مهلاً، ماذا الآن؟ لديكما صديق
آخر يحتاج إلى قماش أيضًا؟

196
00:15:31,070 --> 00:15:33,870
.هكذا إذًا. هذا سيّئ

197
00:15:33,870 --> 00:15:40,620
أتأسّف لكما، لكنّ لونا ليست
.معي اليوم. لكنّها ستأتي ثانية

198
00:15:40,620 --> 00:15:42,750
هل تناسبكما الأقمشة؟

199
00:15:43,590 --> 00:15:45,030
...سيّدتي المشعوذة

200
00:15:45,030 --> 00:15:48,380
.بشكل جيّد؟ كم سرّني سماع هذا

201
00:15:48,380 --> 00:15:50,600
.سأخبر لونا بذلك

202
00:15:56,970 --> 00:15:59,900
.كلّي ثقة أنّها ستسعد بذلك

203
00:16:04,040 --> 00:16:07,310
.سيّدتي المشعوذة شخص رائع بالفعل

204
00:16:07,310 --> 00:16:12,400
.بالطّبع هي كذلك
.نحن جميعًا نحبّ لونا كثيرًا

205
00:16:12,400 --> 00:16:14,870
.لونا مشعوذة رائعة

206
00:16:15,930 --> 00:16:19,370
.نعم، أعتقد أنّي أحبّها أيضًا

207
00:16:19,690 --> 00:16:24,190
ويومًا ما، أريد أن أصير مشعوذًا
.رائعًا مثلها تمامًا

208
00:16:25,160 --> 00:16:27,920
.بكلّ تأكيد، ستصير كذلك بالفعل

209
00:16:28,250 --> 00:16:31,670
يُسعدني كثيرًا سماع
.أنّك تحبّ لونا أيضًا يا ليزي

210
00:16:31,670 --> 00:16:39,430
أريد دعمها. أريد منحها القوّة
.وجلب السّعادة لها

211
00:16:39,430 --> 00:16:43,750
أريد أن أكون مصدر فرح
.في حياتها ولو قليلاً

212
00:16:44,630 --> 00:16:47,670
لنسرع ونحضر الخروف لنستطيع
.العودة للمنزل

213
00:16:48,420 --> 00:16:52,030
!سأذهب إلى أيّ مكان لأكون إلى جانبها

214
00:16:52,360 --> 00:16:55,030
!انظر يا ليزي. القرية هناك

215
00:17:16,420 --> 00:17:21,060
.أكملنا التّسوّق في وقت سريع
!أحسنت عملاً يا ليزي

216
00:17:22,980 --> 00:17:29,270
.كان الجميع ودودًا معك
.لكنّهم بدوا متوتّرين قليلاً

217
00:17:30,250 --> 00:17:35,820
لم يسبق أن كان التّسوّق سهلاً هكذا
!من قبل. يا له من اختلاف كبير

218
00:17:36,170 --> 00:17:38,450
.والآن، علينا العودة للمنزل فحسب

219
00:17:45,580 --> 00:17:46,980
.إنّها تُمطر

220
00:17:46,980 --> 00:17:51,900
،ليزي، المطر سامّ
.لذلك تذكّر ما أخبرتك به لونا

221
00:17:51,900 --> 00:17:56,590
،ارتد غطاء رأسك وغطّ جلدك
.وتأكّد ألاّ تنسى القفّازات

222
00:17:56,590 --> 00:18:00,600
وضع أيضًا القماش السّحريّ
.الّذي أحضرناه على الخروف

223
00:18:01,220 --> 00:18:02,440
ماذا عنك يا مينوس؟

224
00:18:02,830 --> 00:18:04,820
.سأكون بخير

225
00:18:04,820 --> 00:18:05,750
ماذا؟

226
00:18:05,750 --> 00:18:07,100
.أسرع

227
00:18:14,550 --> 00:18:18,780
!ذلك كائن سامّ
ماذا نفعل يا ليزي؟

228
00:18:19,210 --> 00:18:23,150
.ليزي، سأعطيك ثلاثة بذور أمنيات

229
00:18:23,470 --> 00:18:27,210
إن كانت هنالك قوّة تريد استعمالها
،أو رغبة تريد تحقيقها

230
00:18:27,210 --> 00:18:32,820
.كل واحدة من هذه وركّز
،ستقوم بتعزيز سحرك

231
00:18:32,820 --> 00:18:35,720
.وستحقّق لك أيّ أمنية في حدود قوّتك

232
00:18:36,490 --> 00:18:38,180
.والآن، انطق باسمك الحقيقيّ

233
00:18:45,270 --> 00:18:46,390
ماذا؟

234
00:18:48,030 --> 00:18:50,140
ما هذه القوّة؟

235
00:18:51,480 --> 00:18:54,890
.ليزي، أعتقد أنّه يتألّم

236
00:18:56,020 --> 00:18:58,780
!الخروف في خطر أيضًا

237
00:18:58,780 --> 00:19:02,150
.أرخها رجاءً وأنزله

238
00:19:02,780 --> 00:19:06,020
.لا أحبّ هذا. لا أحبّ هذا على الإطلاق

239
00:19:12,790 --> 00:19:14,790
زهرة ضخمة؟

240
00:19:15,720 --> 00:19:19,800
تعرّض الخروف لخدوش بالمخالب
.السّامّة، لكنّه ما زال حيًّا يا ليزي

241
00:19:19,800 --> 00:19:23,980
!كان ذلك رائعًا يا ليزي
متى تعلّمت ذلك النّوع من السّحر؟

242
00:19:25,870 --> 00:19:27,590
ما الّذي تفعله يا ليزي؟

243
00:19:28,250 --> 00:19:32,950
لماذا ضيّعتَ بذور أمنيات
لإنقاذ كائن مثله؟

244
00:19:33,720 --> 00:19:38,600
.إنّ وحوش السّمّ من أمثاله تؤذينا
.كنّا نأمل أن تقضي عليه

245
00:19:44,280 --> 00:19:48,150
هل تتألّم بسبب السّمّ؟

246
00:19:49,070 --> 00:19:52,790
هل كنت تسعى خلف القماش
السّحريّ الّذي كان على الخروف؟

247
00:19:55,190 --> 00:19:59,540
.ليس لدينا قماش كاف لإعطائه منه

248
00:19:59,540 --> 00:20:04,040
.نحتاج لقماش الخروف لتضميد جروحه

249
00:20:07,800 --> 00:20:09,870
ليزي، ما الّذي تفعله؟

250
00:20:18,180 --> 00:20:23,070
استعملتَ سحر التّجسيد؟ جسّدتَ
حتّى إحدى أقمشة لونا السّحريّة؟

251
00:20:23,670 --> 00:20:27,310
!هذا مذهل يا ليزي
!لقد تحسّنت كثيرًا

252
00:20:27,310 --> 00:20:29,330
...لا، بل

253
00:20:35,730 --> 00:20:40,090
.هذا جيّد. إنّه يناسبك تمامًا
.ذلك القماش لك الآن

254
00:20:41,320 --> 00:20:43,590
ما الّذي تفكّر فيه يا ليزي؟

255
00:20:43,820 --> 00:20:48,210
كيف تستعمل القوّة الّتي أعرناها
لك لمساعدة مثل هذه الشّناعة؟

256
00:20:49,160 --> 00:20:51,080
!لقد خاب أملي فيك

257
00:20:51,080 --> 00:20:53,600
.لا أريد الحديث معك
.فكّر مليًّا فيما فعلت

258
00:20:55,700 --> 00:20:58,650
.سأتعلّم السّحر بمفردي

259
00:20:58,650 --> 00:21:02,070
شكرًا على القوى الّتي منحتموني
.إيّاها حتّى الآن

260
00:21:03,080 --> 00:21:05,660
.لكنّك بخير الآن. لا داعي للقلق

261
00:21:06,050 --> 00:21:08,940
حاول فقط أن تكفّ عن سرقة
،الأقمشة من الآخرين

262
00:21:09,620 --> 00:21:11,860
.وعد إلى منزلك بسرعة

263
00:21:13,050 --> 00:21:15,030
.سأعود إلى المنزل أنا أيضًا

264
00:21:16,500 --> 00:21:18,760
ليزي، هل أنت بخير؟

265
00:21:18,760 --> 00:21:21,630
مينوس، أيمكنك حمل الخروف؟

266
00:21:21,630 --> 00:21:26,260
نحتاج لسيّدتي المشعوذة
.لمعالجة إصابات السّمّ في الحال

267
00:21:28,390 --> 00:21:29,660
.علينا أن نسرع

268
00:21:30,830 --> 00:21:34,300
أيمكنك السّير يا ليزي؟
أتريد الرّكوب أيضًا؟

269
00:21:34,630 --> 00:21:38,650
لا. أريد السّير على قدميّ

270
00:21:39,030 --> 00:21:41,780
.للعودة إلى سيّدتي المشعوذة

271
00:21:46,050 --> 00:21:49,310
.واثق أنّ سيّدتي المشعوذة بانتظارنا الآن

272
00:21:51,420 --> 00:21:53,990
.الجميع في الغابة السّوداء بانتظارنا

273
00:21:54,700 --> 00:21:57,190
.وأنا توّاق للعودة إلى ذلك المنزل

274
00:21:59,220 --> 00:22:00,810
...أشعر أنّي وجدته أخيرًا

275
00:22:01,980 --> 00:22:04,460
!وجدت المكان الّذي يمكنني تسميته بمنزلي

276
00:22:16,860 --> 00:22:21,550
لونا، أيمكنك معالجة الخروف
من السّمّ بفطرك في الحال؟

277
00:22:22,380 --> 00:22:23,390
.نعم

278
00:22:23,390 --> 00:22:25,930
ألست مسرورة لأنّني ذهبت معه؟

279
00:22:26,300 --> 00:22:27,480
.بلى

280
00:22:27,480 --> 00:22:31,400
حسنًا، كان سيقع في مشكلة
.كبيرة لولا وجودي

281
00:22:32,690 --> 00:22:33,450
.نعم

282
00:24:06,610 --> 00:24:10,250
الحلقة القادمة
لمّ شمل