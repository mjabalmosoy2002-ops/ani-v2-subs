1
00:00:21,500 --> 00:00:24,340
.يبدو ضخمًا جدًّا

2
00:00:24,340 --> 00:00:27,060
.يا لها من مهمّة غريبة حقًّا

3
00:00:27,500 --> 00:00:30,120
.ومع ذلك، سأنهيها بسرعة

4
00:02:01,740 --> 00:02:07,080
الحلقة 10
لمّ شمل

5
00:02:03,860 --> 00:02:05,160
،إلى الآنسة المشعوذة"

6
00:02:05,630 --> 00:02:07,170
كيف حالك؟

7
00:02:07,640 --> 00:02:09,470
،في وقت غيابك

8
00:02:09,860 --> 00:02:12,670
.صار الهواء والماء حول البلدة قذرًا

9
00:02:13,060 --> 00:02:17,830
يشعر جسدي بالإعياء ولا أستطيع
".الخروج، وصار كلّ يوم يمرّ محبِطًا

10
00:02:31,490 --> 00:02:35,010
".أتمنّى لو تقومين بزيارتنا ثانية قريبًا"

11
00:02:36,210 --> 00:02:40,570
أرسل صاحب متجر الكتب
،ما يشبه رسالة استغاثة

12
00:02:40,570 --> 00:02:44,540
لذلك قرّرت سيّدتي المشعوذة
.زيارة البلدة لأوّل مرّة منذ مدّة

13
00:02:51,420 --> 00:02:54,530
.عليك نسيان أمر الذّهاب إلى البلدة

14
00:02:54,530 --> 00:02:58,060
فإنّ "نهاية كلّ شيء" ظهر
،قرب الحدود مؤخّرًا

15
00:02:58,060 --> 00:03:02,360
،وتدفّق اللاّجئون بسببه إلى البلدة
.لذلك فالأمور لا تبدو آمنة

16
00:03:02,740 --> 00:03:05,180
.حاول الغراب إيقافها

17
00:03:05,910 --> 00:03:08,750
هل هنالك سبب ما لرغبتك في الذّهاب

18
00:03:09,090 --> 00:03:13,400
رغم الخطر الّذي قد نواجهه
يا سيّدتي المشعوذة؟

19
00:03:14,910 --> 00:03:17,760
.لا بدّ أنّ الأمر خطير بما أنّه بعث رسالة

20
00:03:18,040 --> 00:03:23,580
،كما أنّه ذكر أنّ جسده متعب
.لذلك أردتُ أخذ دواء له أيضًا

21
00:03:24,140 --> 00:03:25,510
...سيّدتي المشعوذة

22
00:03:26,070 --> 00:03:27,180
.عليّ الذّهاب

23
00:03:28,120 --> 00:03:30,810
لا، الأمر ليس بتلك البساطة، صحيح؟

24
00:03:31,790 --> 00:03:36,620
.لم تصلك رسالة من بشريّ قبل الآن

25
00:03:40,700 --> 00:03:42,650
.تعنيف عاطفيّ

26
00:03:41,560 --> 00:03:44,540
!ماذا؟ أذلك صحيح؟

27
00:03:44,540 --> 00:03:46,190
.تعنيف عاطفيّ

28
00:03:44,840 --> 00:03:49,150
.كـ-كلاّ. أنت مخطئ

29
00:03:47,900 --> 00:03:49,610
.تعنيف عاطفيّ

30
00:03:49,610 --> 00:03:52,550
.تنطلقين بلهفة لمجرّد تلقّيك لرسالة تافهة

31
00:03:53,100 --> 00:03:54,790
!يا لك من امرأة سهلة

32
00:03:55,060 --> 00:03:59,050
،بالنّسبة لصاحب متجر الكتب
.أنت مجرّد عاملة تنظيف

33
00:03:59,050 --> 00:04:00,550
.تعنيف عاطفيّ

34
00:04:00,850 --> 00:04:02,550
.فهمت

35
00:04:02,550 --> 00:04:06,550
لا بدّ أنّك أردت رفيق مراسلة
.بشدّة يا سيّدتي المشعوذة

36
00:04:02,550 --> 00:04:08,310
.تعنيف عاطفيّ

37
00:04:06,890 --> 00:04:11,050
!هكذا إذًا. كم هذا لطيف، وظريف

38
00:04:12,530 --> 00:04:19,090
ولكن بصراحة، لا أريد أنا أيضًا
.أن تذهب سيّدتي المشعوذة إلى البلدة

39
00:04:19,090 --> 00:04:22,330
لماذا ينمو كلّ هذا الفطر القذر؟

40
00:04:22,330 --> 00:04:25,010
أليست تلك هي مشعوذة الفطر؟

41
00:04:25,010 --> 00:04:30,330
إنّ الفطر الّذي ينمو خلفها أكبر بكثير
.من المعتاد. أتساءل عن السّبب

42
00:04:30,570 --> 00:04:33,080
...عـ-عفوًا

43
00:04:34,120 --> 00:04:35,340
!إنّها تتكلّم

44
00:04:35,340 --> 00:04:36,430
!فرّوا بحياتكم

45
00:04:36,430 --> 00:04:38,650
!يفترض أنّ أنفاسها سامّة

46
00:04:38,650 --> 00:04:40,590
!هذا مرعب

47
00:04:40,590 --> 00:04:43,530
.على الأرجح أنّه لا فائدة من الشّرح لهم

48
00:04:43,530 --> 00:04:47,850
،لكن إن كان القرويّون يتصرّفون هكذا
.فيراودني شعور سيّئ حيال البلدة

49
00:04:58,950 --> 00:05:01,050
.كن حذرًا يا بُنيّ

50
00:05:01,050 --> 00:05:04,610
،إن أمسكتَ بالمشعوذة هكذا
!فستتسمّم وستموت

51
00:05:04,970 --> 00:05:06,220
.تعال إلى هنا

52
00:05:10,660 --> 00:05:11,940
.سأكون بخير

53
00:05:13,730 --> 00:05:18,090
سيّدتي المشعوذة ليست خطيرة
.جدًّا كما تقول الشّائعات عنها

54
00:05:18,090 --> 00:05:20,380
.أرأيتنّ؟ أنا دليل على ذلك

55
00:05:20,770 --> 00:05:24,630
،وإن تركتنّ الفطر وشأنه
.فسيذبل من تلقاء نفسه قريبًا

56
00:05:24,630 --> 00:05:27,170
.شرحتُ كلّ شيء هنا

57
00:05:27,170 --> 00:05:29,470
.ماذا؟ حسنًا

58
00:05:33,210 --> 00:05:37,700
هل ساعدت قوّتي سيّدتي المشعوذة؟

59
00:05:38,780 --> 00:05:43,650
!استطعتُ حمايتها، مع أنّي صغير جدًّا

60
00:05:47,080 --> 00:05:48,440
!كم سرّني هذا

61
00:05:54,700 --> 00:05:58,420
لونا، إنّ يدك اليمنى
.وقدمك اليمنى تتحرّكان معًا

62
00:05:58,670 --> 00:06:01,510
ولكن ماذا عن تلك الشّائعات في البلدة

63
00:06:01,510 --> 00:06:05,570
الّتي تقول أنّ المشعوذين السّود يستدعون
وحوشًا تسمّى "نهاية كلّ شيء"؟

64
00:06:08,450 --> 00:06:09,870
.قد يكون مجرّد هراء

65
00:06:09,870 --> 00:06:11,270
.قد تكونين على حقّ

66
00:06:11,270 --> 00:06:12,680
وكيف لنا أن ندري؟

67
00:06:12,940 --> 00:06:14,030
ماذا؟

68
00:06:14,030 --> 00:06:18,440
لماذا يراودني هذا الشّعور الغريب ثانية؟

69
00:06:19,070 --> 00:06:20,460
."نهاية كلّ شيء"

70
00:06:20,950 --> 00:06:25,550
،في كلّ مرّة أسمع فيها ذلك الاسم
تتلاشى مشاعري السّعيدة

71
00:06:25,960 --> 00:06:28,110
.ويمتلئ قلبي بالقلق وعدم الارتياح

72
00:06:32,980 --> 00:06:35,470
.عفوًا. أنا بخير

73
00:06:39,800 --> 00:06:44,050
!سأتماسك. عليّ حماية سيّدتي المشعوذة

74
00:07:05,850 --> 00:07:09,000
هذه هي... البلدة؟

75
00:07:09,780 --> 00:07:14,390
،"إن لمستم "نهاية كلّ شيء
سيتحوّل جلدكم للأسود ويتعفّن

76
00:07:14,390 --> 00:07:16,360
ويمتلئ الهواء بهذه القذارة

77
00:07:16,360 --> 00:07:18,660
.لدرجة أنّ استنشاقه سيلتهمكم من الدّاخل

78
00:07:16,360 --> 00:07:20,340
هل ذلك الرّجل الّذي يتكلّم من
اللاّجئين الّذين أتون من الحدود

79
00:07:19,010 --> 00:07:23,000
،أمّا الأرض الّتي تشبّعت بسمومه
.فلن يمكن استعمالها إلى بعد 10 سنوات

80
00:07:20,340 --> 00:07:23,000
هربًا من "نهاية كلّ شيء"؟

81
00:07:23,490 --> 00:07:26,010
إنّ الكفر وقلّة إيمان قلب

82
00:07:26,010 --> 00:07:28,260
."هما ما يجلبان "نهاية كلّ شيء

83
00:07:28,670 --> 00:07:30,190
."نهاية كلّ شيء"

84
00:07:30,790 --> 00:07:34,220
.التّلوّث في البلدة أسوأ بكثير ممّا توقّعت

85
00:07:34,220 --> 00:07:36,760
.عليك أن تتحلّى بالقوّة وتدعم لونا

86
00:07:39,590 --> 00:07:43,620
أليست تلك هي؟ المشعوذة الّتي ينمو
الفطر السّامّ السّيّئ أينما ذهبت؟

87
00:07:43,620 --> 00:07:45,250
!سأقضي عليها بنفسي

88
00:07:45,650 --> 00:07:46,820
!مهلاً

89
00:07:46,820 --> 00:07:49,640
!ما الّذي تفعله؟ ماذا لو لعنتك؟

90
00:07:49,640 --> 00:07:51,900
!لكنّ هذا ما قاله الرّجل عند النّافورة

91
00:07:52,310 --> 00:07:56,230
"إنّها تستدعي "نهاية كلّ شيء
.لأنّها غاضبة لأنّها منبوذة

92
00:07:56,230 --> 00:07:58,770
!المشعوذة السّوداء زنديقة شرّيرة

93
00:07:58,770 --> 00:08:01,360
أواثق حيال ذلك؟

94
00:08:01,360 --> 00:08:06,420
أكلت ابنتي فطر المشعوذة
!وعانت لشهر كامل

95
00:08:10,290 --> 00:08:11,210
!ذلك خاطئ

96
00:08:12,210 --> 00:08:14,450
!ارحلي أيّتها الشّيطانة الملعونة

97
00:08:15,670 --> 00:08:16,790
!توقّف

98
00:08:30,690 --> 00:08:32,580
!نمت يد من الأرض

99
00:08:32,580 --> 00:08:34,690
!يد رجل ميت

100
00:08:35,260 --> 00:08:38,080
.يا إلهي، يا إلهي، يا إلهي

101
00:08:38,420 --> 00:08:40,820
!مستحضرة أرواح شرّيرة

102
00:08:43,510 --> 00:08:44,960
!سيّدتي المشعوذة

103
00:08:46,450 --> 00:08:51,590
!توقّفوا! أنتم لا تفهمون
!استمعوا لي رجاءً

104
00:08:51,850 --> 00:08:57,190
ماذا الآن؟ لا تعمل قوّة تعاويذي
.الآسرة عليهم على الإطلاق

105
00:08:59,150 --> 00:09:00,430
!على الإطلاق

106
00:09:12,910 --> 00:09:14,780
.لونا، لنهرب

107
00:09:15,130 --> 00:09:20,220
لا فائدة من جعل الفطر ينمو هنا
.وليزي يتصرّف بشكل غريب

108
00:09:20,760 --> 00:09:21,770
.لا يمكنني

109
00:09:22,380 --> 00:09:27,610
.بعد أن رأيت مدى سوء الوضع
...إن لم أفعل ما أستطيعه الآن

110
00:09:28,570 --> 00:09:33,590
كلاّ. لا يفترض بك إضاعة وقتك
.على هؤلاء القُساة

111
00:09:33,590 --> 00:09:35,220
.دعيهم وشأنهم فحسب

112
00:09:37,330 --> 00:09:38,200
—لو

113
00:09:43,720 --> 00:09:44,710
ماذا؟

114
00:09:46,510 --> 00:09:48,670
لماذا يا سيّدتي المشعوذة؟

115
00:09:49,570 --> 00:09:52,400
!هذا خطير جدًّا! لا تذهبي رجاءً

116
00:09:54,750 --> 00:09:57,060
.لا! لا أحبّ هذا

117
00:09:57,640 --> 00:09:58,690
!كلاّ

118
00:10:00,790 --> 00:10:03,410
!ستجعلين المزيد ينمو؟ سحقًا لك

119
00:10:04,350 --> 00:10:05,660
،أمامي مباشرة

120
00:10:06,060 --> 00:10:07,930
!رمية ممتازة! نلت منها

121
00:10:06,060 --> 00:10:10,670
!يحدث شيء فظيع للشّخص الّذي أحبّه

122
00:10:11,340 --> 00:10:16,670
.ولا يمكنني حمايتها. بل هي من حمتني
!لم أستطع حتّى صدّ الأذى عنها

123
00:10:17,300 --> 00:10:20,410
لماذا أنا ضعيف هكذا؟

124
00:10:49,950 --> 00:10:51,860
أتعتقدون أنّ في ذلك مبالغة كبيرة؟

125
00:10:51,860 --> 00:10:54,170
،تصديق القصص عن الفطر مقبول

126
00:10:54,170 --> 00:10:57,550
"لكنّ مسألة "نهاية كلّ شيء
.يبدو مبالغًا فيه كثيرًا

127
00:10:57,900 --> 00:11:02,310
كما أنّ الهواء حول الفطر
.يبدو أكثر نقاءً دائمًا

128
00:11:02,310 --> 00:11:03,690
.إنّه منعش بالتّأكيد

129
00:11:05,640 --> 00:11:07,090
!أنت! توقّفي

130
00:11:10,370 --> 00:11:11,430
.إنّها بعيدة

131
00:11:12,940 --> 00:11:17,570
.تذكّرتُ شيئًا قالته لي لونا منذ مدّة

132
00:11:17,570 --> 00:11:21,810
كانت وحيدة دائمًا قبل أن أتيتُ
...للعيش معها، لذلك سألتها

133
00:11:21,810 --> 00:11:24,320
"ألم تشعري بالوحدة طوال الوقت يا لونا؟"

134
00:11:24,780 --> 00:11:27,330
.وكان الجميع يتجنّبونها

135
00:11:27,710 --> 00:11:31,380
قلتُ، "لماذا تحاولين تنقية العالم
"من أجل أشخاص مثلهم؟

136
00:11:32,010 --> 00:11:35,730
،لو كنت مكانك، لكرهتُ الأمر بشدّة"
".ولانكمشتُ على نفسي ومتّ

137
00:11:37,420 --> 00:11:39,340
...ثمّ ردّت لونا قائلة

138
00:11:39,810 --> 00:11:45,500
.لم أكن وحدي. كانت الغابة معي دائمًا

139
00:11:45,500 --> 00:11:49,310
،تتغيّر الغابة مع تغيّر الفصول
،وهو أمر دائمًا ما حمّسني

140
00:11:49,620 --> 00:11:53,150
.كما أنّ الغيوم تأتي لتحيّيني يومًا بعد يوم

141
00:11:53,150 --> 00:11:55,640
.وكذلك المطر والثّلج أيضًا

142
00:11:55,640 --> 00:12:01,580
حتّى القمر يغيّر شكله كلّ يوم
.ويتبعني أينما ذهبت

143
00:12:01,990 --> 00:12:06,870
تراقبني الشّمس أيضًا وترعاني
.وتمنحني بركاتها

144
00:12:07,170 --> 00:12:10,740
.كفّي تظاهرًا بالشّجاعة يا لونا

145
00:12:10,740 --> 00:12:13,900
.لا شيء ممّا ذكرتِ من البشر
.بل وليس بينها حيوانات حتّى

146
00:12:13,900 --> 00:12:16,030
.يجعلني ذلك أشعر بالحزن حيالك فحسب

147
00:12:16,030 --> 00:12:19,150
.لـ-لكنّي لا أتظاهر بالشّجاعة

148
00:12:19,970 --> 00:12:25,290
أكاد أنسى أحيانًا، لكنّ الحقيقة
،هي أنّي لستُ وحدي

149
00:12:26,130 --> 00:12:30,100
حتّى إن واجه قلبي مشاكل
.في التّعرّف على ذلك في بعض الأيّام

150
00:12:30,100 --> 00:12:31,410
.حسنًا

151
00:12:31,410 --> 00:12:34,330
،جسدي مسموم وأنا مشعوذة سوداء

152
00:12:34,830 --> 00:12:38,210
لذلك لن أستطيع أبدًا مشاركة
.حياتي مع شخص آخر

153
00:12:38,920 --> 00:12:42,920
،لكن إن قرّرتُ العيش لنفسي فحسب

154
00:12:43,470 --> 00:12:46,260
،أعتقد أنّ ذلك سيزرع القسوة في قلبي

155
00:12:46,670 --> 00:12:49,410
.وستبتلعني الوحدة في نهاية المطاف

156
00:12:50,230 --> 00:12:54,270
لذلك أريد أن أشعر أنّي على صلة
.بالآخرين ومرغوب فيها ولو قليلاً

157
00:12:54,890 --> 00:12:59,730
إنّ شعوري بأنّي أعيش لأكون
،عونًا لغيري، مهما كان خافتًا

158
00:12:59,730 --> 00:13:01,920
.هو ما يُبقيني حيّة

159
00:13:02,190 --> 00:13:05,050
.لا يمكنني التّخلّي عن شخص كهذا ببساطة

160
00:13:05,450 --> 00:13:12,490
لكنّي ضعيف جدًّا، أنا أجبرها
.على السّير وحدها الآن

161
00:13:13,370 --> 00:13:15,270
!أريد أن أصير أقوى

162
00:13:15,940 --> 00:13:20,860
أقوى بما يكفي حتّى لا تضطرّ
.للسّير وحدها ثانية

163
00:13:17,700 --> 00:13:22,420
.ليزي، اهدأ قليلاً
.ستتسبّب في ألم بطن لهاتر

164
00:13:21,300 --> 00:13:26,260
قويّ بما يكفي حتّى لا تشعر أنّ عليها
.التّضحية بنفسها من أجل الآخرين

165
00:13:22,420 --> 00:13:26,920
هذا ليس لطيفًا. لا يمكننا المغادرة
.حتّى تسمح لونا بذلك على أيّ حال

166
00:13:26,920 --> 00:13:27,950
.أريد حمايتها

167
00:13:28,730 --> 00:13:34,120
،لكنّي الآن وأنا أبكي عاجزًا عن الحركة
.أشعر بأنّني عديم الفائدة تمامًا

168
00:13:34,500 --> 00:13:41,650
أريد أن أكون درعها القويّ بما
.يكفي لإبقائي إلى جانبها دائمًا

169
00:13:42,340 --> 00:13:44,410
،حتّى إن عنى ذلك خسارتي لكلّ شيء آخر

170
00:13:44,990 --> 00:13:50,970
أريد أن أصير مشعوذًا قويًّا
.بما يكفي للقيام بذلك لأجلها

171
00:13:51,290 --> 00:13:54,010
.مهلاً أيّتها المشعوذة السّوداء

172
00:13:55,090 --> 00:14:00,230
هل أنت مشعوذة السّمّ الّتي تجعل
فطرًا يؤرق السّلام هنا ينمو؟

173
00:14:00,810 --> 00:14:04,460
ماذا؟ من المثير للاهتمام أنّ مشعوذة
سامّة مثلك قد نجت من شباك

174
00:14:04,460 --> 00:14:10,240
حملات مطاردة المشعوذين السّود الّتي
.كنّا نحن المشعوذين البيض نقوم بها

175
00:14:10,600 --> 00:14:13,240
مشعوذ أبيض؟

176
00:14:23,620 --> 00:14:24,710
كرمة؟

177
00:14:25,650 --> 00:14:27,030
!إنّه قويّ

178
00:14:28,580 --> 00:14:31,260
.لديّ موعد عاجل لا يحتمل التّأجيل

179
00:14:31,260 --> 00:14:36,060
اسمع، تولّ أنت مسؤوليّة إلقائها
.في الزّنزانة رقم 6

180
00:14:36,060 --> 00:14:37,870
.حاضر يا صاحب السّعادة

181
00:14:37,870 --> 00:14:40,810
.احرص على ألاّ تلمسها مباشرة يا هنري

182
00:14:41,040 --> 00:14:43,970
.يُقال أنّ لديها سمًّا كافٍ لجعل جلدك يتعفّن

183
00:14:44,470 --> 00:14:45,800
.مفهوم

184
00:15:02,620 --> 00:15:03,860
هنري؟

185
00:15:06,470 --> 00:15:07,470
.لونا

186
00:15:21,750 --> 00:15:23,550
.حسنًا، ستأتين معي

187
00:15:24,270 --> 00:15:25,670
.لا تحاولي المقاومة

188
00:15:27,880 --> 00:15:31,070
،إن حاولت الهرب الآن
فسيؤجّج ذلك سخط الحشود أكثر

189
00:15:31,420 --> 00:15:34,030
.وسيشتدّ الشّكّ الموجّه إليك

190
00:15:34,600 --> 00:15:35,570
...هنري

191
00:15:36,110 --> 00:15:37,620
.لا ترموا المزيد من الحجارة

192
00:15:45,160 --> 00:15:46,390
.هنري

193
00:15:55,090 --> 00:15:58,490
أنت مشعوذة الفطر، أليس كذلك؟

194
00:15:59,350 --> 00:16:00,990
.يجدر أن تكوني في أمان منهم هنا

195
00:16:01,670 --> 00:16:02,310
ماذا؟

196
00:16:02,610 --> 00:16:07,230
،أنا موظّف في خدمة العائلة الملكيّة
،ومن سلالة المشعوذين البيض

197
00:16:08,040 --> 00:16:10,570
،لكن لا أستطيع استعمال السّحر للأسف

198
00:16:10,860 --> 00:16:15,580
لذلك فالوحيد القادر على فسخ سحر
.الكرمة الّتي تقيّدك هو من ألقاه

199
00:16:15,900 --> 00:16:19,900
لكن أتساءل إن كانت قواك كمشعوذة
.سوداء قادرة على ذلك أيضًا

200
00:16:22,250 --> 00:16:26,840
.عفوًا... لا بدّ أنّك مرتبكة
.ذلك طبيعيّ. أنا آسف

201
00:16:27,660 --> 00:16:32,840
ستكونين بخير. لن يستطيع من يسعون
.لأذيّتك أن يلاحقوك إلى هنا

202
00:16:33,880 --> 00:16:37,710
.أنت مصابة. لا بدّ أنّ ذلك مؤلم

203
00:16:42,630 --> 00:16:44,850
!ما... ماذا؟

204
00:16:44,850 --> 00:16:50,230
مذهل! المشعوذ الّذي جسّد
.الكرمة قويّ بالفعل

205
00:16:51,430 --> 00:16:53,820
.ماذا؟ منديلي نظيف تمامًا

206
00:16:54,680 --> 00:16:56,600
ويصفونك بمشعوذة السّمّ الفظيعة؟

207
00:16:57,320 --> 00:17:00,270
ولكن بصراحة، هذا مدهش
.بأكثر من طريقة

208
00:17:00,790 --> 00:17:05,330
،قواك غريبة حقًّا كما تصفها الشّائعات
.لكنّك لستِ كما تخيّلتُ على الإطلاق

209
00:17:06,250 --> 00:17:11,130
،بمجرّد أن ألقيتُ نظري عليك قبل قليل
.لم أفكّر إلاّ في حمايتك

210
00:17:11,540 --> 00:17:14,380
،وحتّى الآن، مهما نظرتُ إليك

211
00:17:14,380 --> 00:17:17,640
.فلا أرى إلاّ فتاة عاديّة لطيفة سريعة البكاء

212
00:17:18,210 --> 00:17:20,440
.لا يجب علينا أن نُعوّل على الشّائعات أبدًا

213
00:17:22,140 --> 00:17:23,390
...هنري

214
00:17:24,380 --> 00:17:26,760
.كلاّ، علينا أن نغادر بسرعة

215
00:17:27,250 --> 00:17:30,520
.بإمكانك الهرب من ذلك المخرج
.ستتمكّنين من الفرار هكذا

216
00:17:30,890 --> 00:17:33,290
لماذا تقوم بهذا من أجلي؟

217
00:17:34,040 --> 00:17:36,420
.لا يفترض بك أن تتذكّرني على الإطلاق

218
00:17:37,560 --> 00:17:39,340
ماذا لو أمسكوا بك؟

219
00:17:40,250 --> 00:17:44,630
.سأكون بخير. ذلك المُشرف شديد النّسيان

220
00:17:44,990 --> 00:17:47,670
كثيرًا ما ينسى السّجناء
،الّذين أمر باحتجازهم

221
00:17:48,370 --> 00:17:50,820
.لذلك أفعل هذا من وقت لآخر

222
00:17:50,820 --> 00:17:54,830
لا يمكنني استعمال السّحر، لكن
،إن استغللتُ عجزي وعلاقاتي جيّدًا

223
00:17:54,830 --> 00:17:56,720
.بإمكاني اختلاق ما أشاء من الأعذار

224
00:17:57,260 --> 00:18:00,070
—لذلك لا داعي للقلق، اذهبي بسرعة فـ

225
00:18:10,300 --> 00:18:12,120
،قد يبدو كلامي غريبًا

226
00:18:13,210 --> 00:18:15,190
.لكنّني لا أشعر كأنّني التقيتك لأوّل مرّة

227
00:18:17,320 --> 00:18:20,520
تُرى أكان في حلم... أم في حياة سابقة؟

228
00:18:20,520 --> 00:18:24,450
أم أنّ سحرك القويّ هو ما يجعلني
تحت تأثيرك دون وعي منّي؟

229
00:18:25,170 --> 00:18:30,760
لونا، أريدك أن تأتين معي، لإيجاد
.ما ينتظرنا وراء السّعادة المطلقة

230
00:18:31,160 --> 00:18:33,780
الشّيء الوحيد الّذي يخيفني في هذا
.العالم الآن هو فكرة أن أفقدك

231
00:18:34,860 --> 00:18:36,620
.لديّ زوجة وطفل

232
00:18:36,620 --> 00:18:40,620
لا أعرف حتّى لماذا
.قد أقول ذلك لفتاة مثلك

233
00:18:40,970 --> 00:18:43,300
.مـ-مهلاً

234
00:18:43,820 --> 00:18:46,030
لا يشيخ المشعوذون السّود، صحيح؟

235
00:18:46,380 --> 00:18:49,560
.لا، لا. تلك ليست المشكلة هنا

236
00:18:54,150 --> 00:18:55,480
،كوني حذرة رجاءً

237
00:18:56,150 --> 00:18:57,710
...يا مشـ... عفوًا

238
00:18:58,150 --> 00:19:00,760
!ما اسمك؟ أخبريني باسمك

239
00:19:08,290 --> 00:19:12,600
!ماذا؟ ما كان ذلك؟ يا إلهي

240
00:19:13,560 --> 00:19:15,640
!مهلاً... هذه الهالة

241
00:19:15,640 --> 00:19:19,260
.هذا سيّئ. عليّ التّعامل مع ذلك أوّلاً

242
00:19:21,670 --> 00:19:24,320
.ماذا؟ لقد خرجنا من القبّعة

243
00:19:24,320 --> 00:19:26,780
.لكن يبدو أنّ المشاكل ما زالت قائمة

244
00:19:26,780 --> 00:19:29,780
أتساءل إن كان يعني ذلك
.أنّ سحر لونا قد اختفى

245
00:19:29,780 --> 00:19:33,810
.لا يبدو أنّها قد عادت بعد
.أتساءل أين هي الآن

246
00:19:33,810 --> 00:19:36,020
هل حدث شيء ما؟

247
00:19:36,020 --> 00:19:37,320
سيّدتي المشعوذة؟

248
00:19:39,900 --> 00:19:41,530
!مهلاً يا ليزي

249
00:19:41,750 --> 00:19:43,410
!هذا خطير

250
00:19:43,410 --> 00:19:47,540
!سيّدتي المشعوذة
أين أنت يا سيّدتي المشعوذة؟

251
00:19:49,460 --> 00:19:50,670
!ماذا؟

252
00:20:02,410 --> 00:20:03,800
!ليزي

253
00:20:12,460 --> 00:20:15,180
ما... هذا؟

254
00:20:15,790 --> 00:20:17,190
ماذا حدث للتّوّ؟

255
00:20:17,790 --> 00:20:21,280
هل أنت بخير يا ليزي؟
هل أصابك أيٌّ من السّمّ؟

256
00:20:21,280 --> 00:20:22,820
.عرفتُ هذا

257
00:20:23,490 --> 00:20:25,910
،إذًا فقد وصل إلى هنا سلفًا

258
00:20:25,910 --> 00:20:29,190
طفل ملعون انتقلت إليه بذرة
."نهاية كلّ شيء"

259
00:20:29,590 --> 00:20:31,590
!هذا سيّئ

260
00:20:31,590 --> 00:20:35,130
فشلتُ في القضاء على "نهاية
،كلّ شيء" بالكامل عند الحدود

261
00:20:35,130 --> 00:20:39,270
وإن عرف لهب أنّي بعثرتُ أشلاءً منه
،في كلّ مكان مع ذلك الإعصار

262
00:20:39,270 --> 00:20:43,320
!فسيغضب كثيرًا! إنّه مخيف جدًّا

263
00:20:45,950 --> 00:20:49,310
أتوجد طريقة حتّى لا يعرف؟
.يا لسوء حظّي

264
00:20:49,310 --> 00:20:51,350
كيف أخرج من ورطتي هذه؟

265
00:20:53,300 --> 00:20:56,120
.إنّ كوني مشعوذًا أسود لا يُناسبني بتاتًا

266
00:20:57,240 --> 00:21:00,110
ولِمَ كلّ ذلك التّشدّد عن الطّرق المستعملة؟

267
00:21:00,820 --> 00:21:03,170
ما المشكلة ما دامت المهمّة
قد أُنجزت في النّهاية؟

268
00:21:04,920 --> 00:21:07,940
.إنّ هذا يجعلني أرغب في الانسحاب

269
00:21:07,940 --> 00:21:11,120
.ما مشكلته؟ لا يجيد إلاّ الشّكوى

270
00:21:11,550 --> 00:21:13,250
.إنّه لا يكفّ عن التّحدّث مع نفسه

271
00:21:13,960 --> 00:21:18,320
لكن عندما ظهر، بدأت رياح قويّة تعصف

272
00:21:14,270 --> 00:21:18,630
ربّما سأهرب. ولكن هل سأنجح
في ذلك فعلاً أم أنّهم سيمسكون بي؟

273
00:21:18,320 --> 00:21:22,200
.وتخلّصت من كلّ الرّكود المتبقّي

274
00:21:19,010 --> 00:21:20,680
.لا يهمّ. ليكن ما يكون

275
00:21:22,950 --> 00:21:28,670
وأشعر الآن وكأنّ ذلك الإحساس
.الخانق بداخلي قد تلاشى

276
00:21:25,210 --> 00:21:28,670
كما لديّ بلاغ بأنّ لونا
،موجودة في هذه البلدة

277
00:21:28,670 --> 00:21:31,010
فما الّذي تفعله هنا؟

278
00:21:31,290 --> 00:21:33,280
هل تعرف لونا؟

279
00:21:33,280 --> 00:21:36,860
ماذا؟ ماذا قلت؟
هل تعرفون لونا أيضًا؟

280
00:21:36,860 --> 00:21:40,020
كلاّ! عجبًا. لا تخبروها بما
قلته للتّوّ، موافقون؟

281
00:21:40,710 --> 00:21:46,350
مهلاً، أيعقل أنّك أحد أعضاء مجلس
المشعوذين السّود؟ مشعوذ الرّياح؟

282
00:21:46,740 --> 00:21:49,700
فعلاً؟ مهلاً. ماذا؟ ماذا؟ ماذا؟

283
00:21:49,700 --> 00:21:52,290
كيف عرفت ذلك؟
من تكونون من الأساس؟

284
00:21:52,630 --> 00:21:54,050
!كلاّ، هذا مقرف

285
00:21:54,050 --> 00:21:54,900
!ماذا؟

286
00:21:56,150 --> 00:21:59,310
.لا يعقل أن يكون هو. إنّه فظّ للغاية

287
00:21:59,670 --> 00:22:00,670
.معك حقّ

288
00:22:00,670 --> 00:22:03,300
!ماذا؟ ماذا قلت أيّتها البقرة؟

289
00:22:00,670 --> 00:22:03,970
مجلس... المشعوذين السّود؟

290
00:22:03,300 --> 00:22:04,250
!هذا مخيف

291
00:22:04,250 --> 00:22:06,040
مشعوذ الرّياح؟

292
00:22:06,040 --> 00:22:10,680
.كفى! لا جدوى من الكلام معكم
أين هي لونا؟

293
00:22:10,680 --> 00:22:12,810
.عفوًا. أعرف ذلك مسبقًا

294
00:22:13,810 --> 00:22:15,000
!مع السّلامة

295
00:22:15,000 --> 00:22:15,560
!ماذا؟

296
00:22:15,560 --> 00:22:16,530
!مهلاً

297
00:24:06,630 --> 00:24:10,270
الحلقة القادمة
المستشار