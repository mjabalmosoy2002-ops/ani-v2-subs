1
00:00:01,770 --> 00:00:04,190
.مصفوفة الاستخبارات الوطنيّة العامّة الموحّدة

2
00:00:04,850 --> 00:00:07,470
إنّها تشرف على كلّ المؤسّسات
.العموميّة داخل اليابان

3
00:00:07,480 --> 00:00:09,820
هنالك مستودع يحتوي على كلّ
،المعلومات في اليابان

4
00:00:09,820 --> 00:00:12,150
.إنّه نظام يُعتبر القلب النّابض لهذه البلاد

5
00:00:12,700 --> 00:00:14,520
.وقد استولت عليه لوغوس

6
00:00:15,030 --> 00:00:17,400
،بوجود اليابان بين قبضتها الآن

7
00:00:17,410 --> 00:00:21,040
أوقفت لوغوس كلّ البنيات
،التّحتيّة للتنقّلات والاتّصالات

8
00:00:21,040 --> 00:00:26,000
وتركت أقلّ الوظائف الممكنة والمهمّة
.للحفاظ على الحياة في العاصمة

9
00:00:26,700 --> 00:00:30,450
.في هذه المرحلة، أعلنت الحكومة حالة طوارئ

10
00:00:30,850 --> 00:00:35,150
تمّ فرض حظر تجوال طوال اليوم على
،كلّ المركبات مع بعض الاستثناءات

11
00:00:35,150 --> 00:00:38,320
ومُنع كلّ المواطنين من مغادرة
.منازلهم بعد الثّامنة مساءً

12
00:00:39,180 --> 00:00:42,890
أنظمة تمّ تصميمها لإذعان هيئات
.تملك سلطات أعظم

13
00:00:43,680 --> 00:00:47,690
ولكن، سلطة كهذه ليست مصمّمة
.بالضّرورة من طرف النّظام بعينه

14
00:00:55,570 --> 00:00:57,700
،استجابة لتزايد نسبة الجرائم الشّنيعة

15
00:00:57,700 --> 00:01:02,080
ظهرت حركة جديدة بسرعة في صفوف
.الشّرطة وقوّات الأمن في أنحاء العالم

16
00:01:03,990 --> 00:01:08,080
.هذه هي قصّة الخدمات الّتي يقدّمها "أكتيف" في اليابان

17
00:02:26,020 --> 00:02:27,870
.لا زالت شبكات التّلفاز معطّلة إذًا

18
00:02:28,500 --> 00:02:29,290
ماذا عنكم؟

19
00:02:29,310 --> 00:02:30,520
.نفس الشّيء هنا

20
00:02:30,520 --> 00:02:34,480
،أستطيع استعمال الجهاز دون اتّصال
...لكن عندما أحاول أن أصله بالإنترنيت

21
00:02:35,460 --> 00:02:40,800
.لا أستطيع الاتّصال، أنا آسفة

22
00:02:42,010 --> 00:02:44,890
...لا زال مذياع الشّرطة معطّلاً أيضًا

23
00:02:44,890 --> 00:02:47,350
.لكن هنالك بصيص الأمل في كلّ هذا

24
00:02:47,350 --> 00:02:50,320
،فبسبب كون الوحدة الثّامنة على وشك أن يتمّ إيقافها

25
00:02:50,320 --> 00:02:54,290
.تمّ فصل مركبة القيادة من الشّبكة ولم يلحق بها أيّ ضرر

26
00:02:54,590 --> 00:02:57,280
بإمكان دروع الوير خاصّتنا أن تتّصل
.مع بعضها باستعمال المذياع

27
00:02:57,280 --> 00:02:58,120
صحيح؟

28
00:02:58,120 --> 00:02:59,890
ألم يتمّ إضعاف نظام الاتّصال بالمذياع؟

29
00:02:59,890 --> 00:03:01,440
.المذياع التّناظريّ بخير

30
00:03:01,740 --> 00:03:04,160
.أمّا المذياع الرّقميّ فهو معطّل

31
00:03:04,420 --> 00:03:06,400
هل لدينا أيّة معلومات أخرى؟

32
00:03:06,410 --> 00:03:08,120
قد تكون أيّ شيء سواء لها
.علاقة بالمجلس أم لا

33
00:03:08,120 --> 00:03:12,960
الشّي الوحيد الغريب هي الشّائعات عن
.رؤية شبح يظهر في عتمة اللّيل

34
00:03:13,250 --> 00:03:14,290
شبح؟

35
00:03:14,590 --> 00:03:15,420
ما هو هذا؟

36
00:03:15,790 --> 00:03:19,420
تمّ التّبليغ عن عدّة مشاهدات له في
.أوغيكوبو وكاميشاكوجي

37
00:03:19,720 --> 00:03:24,140
،بما أنّهم يقولون أنّ الشّبح يشبه ليكو-تشان
.فهنالك معجبون عنيدون يحاولون مشاهدتها

38
00:03:24,140 --> 00:03:27,350
مشاهدتها؟ لكن ليس من المفترض ألاّ
!يتواجد أحد في الخارج بعد الثّامنة

39
00:03:32,730 --> 00:03:34,560
ما-ما بالها؟

40
00:03:34,900 --> 00:03:38,150
.إنّها محبطة لأنّها لا تستطيع الدّخول للإنترنيت

41
00:03:38,150 --> 00:03:40,650
.صحيح، قد يكون ذلك صعبًا نوعًا ما

42
00:03:40,650 --> 00:03:41,650
،بالتّفكير بالأمر

43
00:03:41,650 --> 00:03:45,660
ذكر مراسلٌ صحفيّ أعرفه أنّ الحاكم
.قد دخل للمشتشفى

44
00:03:45,660 --> 00:03:49,400
.ربّما يكون هذا مجرّد هروب من هذه الورطة

45
00:03:49,410 --> 00:03:51,500
لكان الأمر قد تصدّر الصّفحات الأولى
...لو حدث في يوم آخر

46
00:03:51,500 --> 00:03:55,880
،بينما لا تستطيع الجرائد أن توصل أو تطبع أخبارها
.فلا يوجد ما بوسعهم فعله بتلك المعلومة

47
00:03:57,490 --> 00:03:58,340
!أيّتها الرّئيسة

48
00:03:58,730 --> 00:03:59,790
.أسامي-تشان

49
00:04:00,090 --> 00:04:01,940
ما الّذي تفعلينه هنا؟

50
00:04:01,940 --> 00:04:05,010
—لو كنتِ قد أعلمتني مسبقًا
.أعتقد أنّ ذلك ليس ممكنًا الآن

51
00:04:05,010 --> 00:04:08,990
.أردتُ أن أحضر استجواب هاتشيجو توموكي

52
00:04:08,990 --> 00:04:10,330
استجواب هاتشيجو؟

53
00:04:10,330 --> 00:04:13,510
...كنتُ آمُل الحصول على معلومات عن معاونيه

54
00:04:13,960 --> 00:04:15,770
.لكنّ الأمر كان مضيعة للوقت

55
00:04:15,770 --> 00:04:18,730
.لم يسمحوا حتّى بإخباري عمّاذا يستجوبونه

56
00:04:18,730 --> 00:04:22,340
ربّما لا يملكون أيّة معلومات حقيقيّة
.ليتشاركوها معكِ فحسب

57
00:04:22,690 --> 00:04:27,230
يبدو أنّ هاتشيجو يخوض معهم في حوارات
.متشابكة ويتلاعب بالكلمات

58
00:04:27,690 --> 00:04:29,040
قلتِ يتلاعب؟

59
00:04:29,790 --> 00:04:32,120
بعد أن دفع المجتمع إلى هذا الوضع؟

60
00:04:32,450 --> 00:04:34,210
كيف حال أختك بالمناسبة؟

61
00:04:34,610 --> 00:04:35,960
.لا بدّ أنّها في حالة صدمة

62
00:04:36,210 --> 00:04:39,130
.حسنًا، لا أستطيع أن أقول أنّها على ما يرام

63
00:04:39,380 --> 00:04:42,420
فزميلها الأكبر في مجلس التّلاميذ كان
.مسؤولاً عن كلّ هذا قبل كلّ شيء

64
00:04:42,710 --> 00:04:43,840
.كازاري-كُن

65
00:04:44,300 --> 00:04:45,430
المدير؟

66
00:04:45,430 --> 00:04:48,140
.تعالي معي. يطلب هاتشيجو مقابلتكِ

67
00:04:48,510 --> 00:04:49,350
ماذا؟

68
00:04:50,770 --> 00:04:53,990
.إنّ هذه البلاد قد انهارت خلال ثلاثة أيّام فحسب

69
00:04:53,990 --> 00:04:56,400
،إن استمرّت حالة الطّوارئ هذه

70
00:04:56,400 --> 00:04:59,150
.فقد تتسبّب في أزمة ماليّة عالميّة

71
00:05:00,150 --> 00:05:01,580
ما المضحك في الأمر؟

72
00:05:01,580 --> 00:05:04,430
.أنتِ تردّدين ما يقوله المحقّقون الآخرون فحسب

73
00:05:04,430 --> 00:05:05,830
.خاب ظنّي

74
00:05:05,830 --> 00:05:10,160
ظننتُ أنّ أصغر مفتّشة مساعدة
.قد تفهمني بشكل أوضح

75
00:05:10,160 --> 00:05:12,750
لذلك طلبتَ أن أكون شريكتك في هذه المحادثة؟

76
00:05:13,420 --> 00:05:16,080
.أنا لا أحبّ الملل

77
00:05:16,310 --> 00:05:19,180
هل ضحّيتَ بنفسك من أجل معاونيك؟

78
00:05:19,180 --> 00:05:20,230
تضحية؟

79
00:05:20,570 --> 00:05:24,660
لقد تطوّعتَ لتكون الطّعم لتوفير الوقت
لمعاونيك لأخذ زمام السّيطرة

80
00:05:24,660 --> 00:05:27,760
على مصفوفة الاستخبارات
،الوطنيّة العامّة الموحّدة

81
00:05:27,760 --> 00:05:30,650
.لتأخير الشّرطة ولو كان ذلك بشكل مؤقّت

82
00:05:30,900 --> 00:05:31,390
هل أنا مخطئة؟

83
00:05:33,010 --> 00:05:35,000
.أصبتِ نصف الحقيقة

84
00:05:35,000 --> 00:05:38,310
.لكنّ عبارة "تضحية" تبدو مبالغًا فيها

85
00:05:38,540 --> 00:05:39,310
لماذا؟

86
00:05:39,310 --> 00:05:44,180
.أنا لا أحبّ الخطط الصّارمة
.فلا يوجد أيّ مرح فيها

87
00:05:44,180 --> 00:05:47,350
تمامًا كما هو حال هذه اللّعبة
.الّتي يبدو أنّي ألعبها وحدي

88
00:05:47,900 --> 00:05:52,240
حسنًا، يمكن تحميل مسؤولية ذلك على
.عاتق الرّاشدين غير المسؤولين مباشرة

89
00:05:52,470 --> 00:05:53,690
أين هم معاونوك؟

90
00:05:53,690 --> 00:05:54,800
معاونِييّ؟

91
00:05:56,510 --> 00:05:58,590
.لقد استخففتم بي في النّهاية

92
00:05:58,590 --> 00:05:59,870
ما المضحك؟

93
00:06:00,230 --> 00:06:02,110
.لوغوس ليست منظّمة

94
00:06:02,420 --> 00:06:03,880
،إنّها مجرّد أسلوب

95
00:06:04,170 --> 00:06:07,050
.للاستيلاء على النّظام المعروف باليابان

96
00:06:07,380 --> 00:06:09,720
—ألا تحترم تاريخ اليابان وثقافته

97
00:06:09,720 --> 00:06:11,720
.دعينا لا نتحدّث عن أمور كهذه

98
00:06:12,050 --> 00:06:15,770
نظام اليابان الّذي يحرّك مجموعة ضعيفة
من النّاس اختاروا الاعتماد

99
00:06:15,770 --> 00:06:17,640
."على الرّمز المعروف بـ"اليابان

100
00:06:17,640 --> 00:06:18,980
هل يمكننا أنّ نتّفق أنّ هذا هو الوضع الّذي نعيشه؟

101
00:06:18,980 --> 00:06:22,440
—لكنّكم جميعًا اخترتم أن تجتمعوا و

102
00:06:22,860 --> 00:06:27,190
.بالنّسبة لي، ميثوس مجرّد بيدق من البيادق

103
00:06:28,490 --> 00:06:29,530
ميثوس؟

104
00:06:29,530 --> 00:06:31,030
.إنّه اسم رمزيّ

105
00:06:31,570 --> 00:06:33,030
.واسمي أنا هو بيرد

106
00:06:33,030 --> 00:06:38,040
صحيح، سأعطيكم تلميحًا لجعل
.هذه اللّعبة أكثر إمتاعًا

107
00:06:38,040 --> 00:06:39,080
تلميح؟

108
00:06:39,080 --> 00:06:42,540
.حاولوا الحصول على وحدة "رو" من أوروتشي قبل ميثوس

109
00:06:42,540 --> 00:06:43,750
...وحدة "رو" من أوروتشي

110
00:06:44,040 --> 00:06:48,010
المعلومات الموحّدة الّتي حصل عليها ميثوس
،مصدرها هما الوحدتان "أو" و"تشي" من أوروتشي

111
00:06:48,420 --> 00:06:50,380
.إنّها نصف المسألة فحسب

112
00:06:50,880 --> 00:06:54,550
،ففي النّهاية، عندما نواجه تهديدًا خارجيًّا

113
00:06:54,550 --> 00:06:58,480
يتمّ تفعيل نظام دفاع يحتوي على  أهمّ البيانات

114
00:06:58,480 --> 00:07:02,520
في أشدّ ثنايا النّظام عمقًا، فيتمّ حذف
.الوحدة "رو" بشكل آليّ

115
00:07:03,270 --> 00:07:05,730
وبالطّبع تملك وزارة الشّؤون الدّاخليّة والتّواصل

116
00:07:05,730 --> 00:07:08,070
.بيانات احتياطيّة لها في مكان مختلف

117
00:07:08,070 --> 00:07:09,860
.تأكّدوا من هذا من وزارة الشّؤون الدّاخليّة والتّواصل

118
00:07:09,860 --> 00:07:10,900
!حاضر

119
00:07:15,530 --> 00:07:18,660
،إن حصل ميثوس على الوحدة "رو" أوّلاً

120
00:07:18,660 --> 00:07:21,750
...ستقع اليابان تحت قبضة لوغوس

121
00:07:22,080 --> 00:07:24,790
.كلاّ، بل قبضة ميثوس بالكامل

122
00:07:29,570 --> 00:07:31,800
ما هذا المبنى؟

123
00:07:31,800 --> 00:07:33,210
من يدري؟

124
00:07:33,210 --> 00:07:36,110
إنّ منع الدّخول لمنطقة شعاع محيطها هو 500 متر

125
00:07:36,110 --> 00:07:39,200
.وأمرنا بحراستها هو أمر مهمّ

126
00:07:39,200 --> 00:07:40,640
،مهما تكن أسبابهم

127
00:07:40,640 --> 00:07:43,360
.نحن نتّبع الأوامر فحسب

128
00:07:47,360 --> 00:07:50,800
أكّدت وزارة الشّؤون الدّاخليّة والتّواصل
،وجود البيانات الاحتياطيّة

129
00:07:50,800 --> 00:07:53,570
.لكنّهم مصرّون أنّ نظام أمانهم لا يُخترق

130
00:07:53,570 --> 00:07:56,540
أهذا وقت مناسب لتكون هنالك حرب لمناطق النّفوذ؟

131
00:07:56,540 --> 00:07:58,910
!عليهم تشارك المعلومات مع الحكومة على الأقلّ

132
00:07:58,910 --> 00:08:03,610
في السّرّاء أو الضّرّاء، هذا ما
.أصبحت عليه هذه البلاد

133
00:08:03,910 --> 00:08:07,310
لا يمكننا أن نتوقّع منهم أن يغيّروا
.أسلوب اليابان" في غمضة عين"

134
00:08:07,690 --> 00:08:10,880
ماذا علينا أن نفعل؟
.كيتشيجوجي منطقة كبيرة جدًّا

135
00:08:10,880 --> 00:08:15,180
لنقم بتوزيع القضايا السّابقة علينا لنرَ
.إن كان بإمكاننا العثور على شيء ما

136
00:08:15,180 --> 00:08:17,870
لكن عمّاذا علينا أن نبحث؟

137
00:08:18,390 --> 00:08:20,540
ربّما عن شبح؟

138
00:08:27,920 --> 00:08:29,230
!آ-آسفون

139
00:08:29,230 --> 00:08:34,150
!آسفون! آسفون! آسفون

140
00:08:31,190 --> 00:08:34,150
تعرفون أنّه لا يجب عليكم أن تتواجدوا
.في الخارج بعد الثّامنة

141
00:08:34,490 --> 00:08:35,750
!آسفون

142
00:08:36,150 --> 00:08:37,420
!عودوا لمنازلكم

143
00:08:37,420 --> 00:08:38,370
!حسنًا

144
00:08:38,370 --> 00:08:41,100
هنالك أزمة وهم يتحدّثون عن شبح؟

145
00:08:41,100 --> 00:08:42,610
.هذا هو بلاغنا الثّامن

146
00:08:43,540 --> 00:08:45,010
أسمعتَ لذلك؟

147
00:08:45,010 --> 00:08:45,460
ماذا؟

148
00:08:47,890 --> 00:08:48,880
.انظر

149
00:08:54,710 --> 00:08:56,100
إنّه ليس شبحًا، صحيح؟

150
00:08:56,100 --> 00:08:57,340
.لا تكن سخيفًا

151
00:09:03,770 --> 00:09:05,690
أين ذهبت تلك الفتاة؟

152
00:09:05,690 --> 00:09:06,490
ماذا؟

153
00:09:12,480 --> 00:09:16,080
...أ-أنت، لا يجب عليك أن تكوني في الخارج بعد الثّامنة

154
00:09:21,140 --> 00:09:23,820
هل وجدتَ شيئًا ما يا كيوكاي-كُن؟

155
00:09:23,820 --> 00:09:26,870
.نعم، إنّه تمامًا كما توقّعت

156
00:09:27,250 --> 00:09:30,960
.جهاز إسقاطِ صورٍ مجسّمة مجهّز بكاشف حركة

157
00:09:30,960 --> 00:09:32,250
كاشف حركة؟

158
00:09:32,960 --> 00:09:36,840
تملك الصّورة المجسّمة عدّة أنماط
.تعتمد على الحركة الّتي تمّ كشفها

159
00:09:37,130 --> 00:09:40,890
تمّ زرع نفس الكاشف في إشارات
.مرور أخرى على الأرجح

160
00:09:40,890 --> 00:09:43,890
كانت مجرّد خدعة إذًا؟

161
00:09:43,890 --> 00:09:46,020
أهي بالفعل مجرّد خدعة؟

162
00:09:46,020 --> 00:09:48,400
إنّ المشاهدات تتكتّل حول منطقة
موساشيساكاي وميكاتا وأوغيكوبو

163
00:09:48,400 --> 00:09:51,730
.وكاميشاكوجي وكيتشيجوجي

164
00:09:51,730 --> 00:09:56,070
ألا يوجد مانع من التّصرّف خارج منطقة نفوذنا؟

165
00:09:56,070 --> 00:10:00,450
الحاكم في المستشفى، لذلك كلّ ما
.سنحصل عليه هو تأنيب بعد خروجه

166
00:10:00,450 --> 00:10:02,450
.وحتّى ذلك الحين، لنقم بما نراه مناسبًا

167
00:10:02,450 --> 00:10:06,410
.لحظة، هذا الجهاز يتمّ التّحكّم به عن بعد

168
00:10:06,410 --> 00:10:07,620
عن بعد؟

169
00:10:07,620 --> 00:10:08,920
حتّى في وضعنا الحاليّ؟

170
00:10:08,920 --> 00:10:11,790
.يبدو أنّه يستعمل موجات المذياع التّناظريّة

171
00:10:13,380 --> 00:10:15,090
.في البداية دوغ، ثمّ بيرد

172
00:10:15,380 --> 00:10:17,630
.نحتاج الآن لمونكي فحسب

173
00:10:16,840 --> 00:10:18,880
...قريبًا على ما أظنّ

174
00:10:19,720 --> 00:10:23,890
.ميثوس، فز بهذا القتال إذا أردتَ أن تكون نظيري

175
00:10:32,980 --> 00:10:34,150
أختي؟

176
00:10:34,150 --> 00:10:35,440
!المعذرة

177
00:10:35,440 --> 00:10:36,320
ماذا؟

178
00:10:36,320 --> 00:10:38,740
ماذا؟ أهذا هو منزل الرّئيسة؟

179
00:10:38,740 --> 00:10:39,990
.توقّف، لا تكن فظًّا

180
00:10:39,990 --> 00:10:41,410
!إنّه على حقّ يا كيوكاي-سان

181
00:10:41,410 --> 00:10:42,530
.لا بأس، لا بأس

182
00:10:42,530 --> 00:10:43,830
ما-ماذا هنالك؟

183
00:10:43,830 --> 00:10:45,870
.سأشرح لاحقًا

184
00:10:46,120 --> 00:10:47,500
.هيناتا، ابقي هناك رجاءً

185
00:10:47,500 --> 00:10:49,080
ستشرحين لاحقًا؟

186
00:10:49,500 --> 00:10:50,210
.أنا أرجوكِ

187
00:10:52,630 --> 00:10:53,460
.حسنًا

188
00:10:53,790 --> 00:10:55,130
.عثرت عليه

189
00:10:55,130 --> 00:10:55,670
ماذا؟

190
00:10:55,670 --> 00:10:58,420
.كان يتمّ التّحكّم بذلك الكاشف من هذا الجاسوب

191
00:10:58,420 --> 00:11:00,180
يتمّ التّحكّم به؟

192
00:11:00,840 --> 00:11:04,890
هيناتا، لقد كان هاتشيجو توموكي
.يستغلّ حاسوبك المحمول

193
00:11:11,270 --> 00:11:14,520
استطاع وضع برنامج في حاسوبها
،خلسة قام بتشغيله

194
00:11:15,070 --> 00:11:17,690
وأرسل بعدها إشارات إلى جهاز إرسال

195
00:11:17,690 --> 00:11:20,570
.قام بتشغيل وإبطال تشغيل مستشعرات الحركة

196
00:11:22,240 --> 00:11:27,040
المسألة الأهمّ هنا هو أنّ الملفّ مخفيّ
.بطريقة ذكيّة في برنامج الإرسال

197
00:11:27,620 --> 00:11:28,790
ملفّ خفيّ؟

198
00:11:29,020 --> 00:11:32,940
،عندما نقوم بفكّ شيفرة الملفّ
.نجد ملفًّا مشفّرًا آخر داخله

199
00:11:33,240 --> 00:11:35,260
وتتطلّب البوّابة الأخيرة

200
00:11:35,910 --> 00:11:37,920
.خاصية تفعيل صوتيّة

201
00:11:37,920 --> 00:11:39,150
.فهمت

202
00:11:39,130 --> 00:11:43,050
.إذًا يحتاج الملفّ إلى كلمة سرّ منطوقة ليُفتح

203
00:11:43,050 --> 00:11:44,140
.هذا صحيح

204
00:11:44,390 --> 00:11:45,720
.افتح، توليب

205
00:11:46,810 --> 00:11:47,510
أرأيتم؟

206
00:11:47,510 --> 00:11:48,850
كلمة سرّ إذًا؟

207
00:11:49,140 --> 00:11:51,640
،أظنّ أنّنا سنضطرّ لإجباره على إخبارنا بها

208
00:11:51,640 --> 00:11:54,230
.لكنّي أشكّ أنّه سيكون متعاونًا

209
00:11:54,230 --> 00:11:57,520
.لكنّها لعبته الخاصّة

210
00:11:57,520 --> 00:11:59,860
.لا توجد أيّة فائدة له بجعلنا نقوم بكلّ هذا

211
00:11:59,860 --> 00:12:02,240
إذًا هنالك تلميح ما في مكان ما؟

212
00:12:02,240 --> 00:12:05,030
هيناتا، هل لديكِ أيّة أفكار حول هذا؟

213
00:12:05,030 --> 00:12:09,620
حسنًا، كلّ ما أعرفه هو أنّه قال شيئًا
...غربيًا قبل أن تعتقله الشّرطة

214
00:12:10,700 --> 00:12:11,330
ماذا؟

215
00:12:11,330 --> 00:12:12,290
ماذا حدث؟

216
00:12:14,000 --> 00:12:15,250
...عندما أتوا

217
00:12:16,380 --> 00:12:19,130
ماذا عن "أريد شفتك"؟

218
00:12:19,880 --> 00:12:22,590
.تبًّا، يا له من شخص هادئ الأعصاب

219
00:12:22,590 --> 00:12:24,680
،ذلك ما ظننتُه أيضًا

220
00:12:25,090 --> 00:12:28,760
لكن ربّما ما قصده رئيس القسم
."RIP" بعبارة "شفة" هو

221
00:12:28,760 --> 00:12:30,220
اختصار عبارة "ارقد بسلام"؟

222
00:12:30,560 --> 00:12:31,390
.مهلاً

223
00:12:31,730 --> 00:12:33,770
أصل هذه العبارة لاتينيّ، صحيح؟

224
00:12:33,770 --> 00:12:36,520
.وعليها أن تقول العبارة بنفسها

225
00:12:37,020 --> 00:12:38,230
أنا؟

226
00:12:38,650 --> 00:12:39,480
.جرّبي فحسب

227
00:12:40,900 --> 00:12:42,940
."ريكوييسكات إن باتشي"

228
00:12:43,450 --> 00:12:45,030
نظام افتراضيّ

229
00:12:43,990 --> 00:12:45,030
.فُتح الملفّ

230
00:12:45,030 --> 00:12:46,200
!ممتاز

231
00:12:46,200 --> 00:12:49,830
لقد جهّز هاتشيجو نمط صوتك وكلمة السّرّ
.تلك كمفتاح لفكّ الشّيفرة

232
00:12:49,830 --> 00:12:51,080
.مـ-مهلاً لحظة

233
00:12:51,410 --> 00:12:55,040
هل ذلك يعني أنّه كان يعلم بشأن عملك؟

234
00:12:55,040 --> 00:12:57,000
.أعتقد ذلك

235
00:12:59,090 --> 00:13:02,090
،إذًا بالنّسبة له

236
00:13:02,670 --> 00:13:04,590
...كنتُ مجرّد

237
00:13:06,350 --> 00:13:08,460
.إنّه هيكل من نوع ما

238
00:13:08,720 --> 00:13:11,320
أعتقد أنّه سيكون من الأفضل لو أمكننا
،البحث انطلاقًا من الصّور

239
00:13:11,320 --> 00:13:12,720
...لكن في وضعنا الحاليّ

240
00:13:12,720 --> 00:13:15,990
.مهلاً! لقد رأيتُ هذا المبنى من قبل

241
00:13:16,670 --> 00:13:19,430
،إن لم تخنّي الذّاكرة
.إنّه المبنى القريب من حديقة إينوكاشيرا

242
00:13:19,430 --> 00:13:21,190
.مبنى الاستخبارات

243
00:13:21,440 --> 00:13:23,340
توجد الوحدة "رو" هناك إذًا؟

244
00:13:23,340 --> 00:13:26,650
.لكنّنا سنحتاج لإذن من عدّة وكالات إن أردنا الهجوم

245
00:13:26,650 --> 00:13:29,600
...هذه هي القواعد، ولكن

246
00:13:29,600 --> 00:13:30,980
.لا يوجد وقت لذلك

247
00:13:31,290 --> 00:13:32,850
،إن سُرقت الوحدة "رو" من أوروتشي

248
00:13:32,850 --> 00:13:35,190
.ستقع اليابان بأكملها تحت سيطرتهم

249
00:13:35,210 --> 00:13:37,830
.هذا ليس الوقت المناسب لندقّق في التّفاصيل

250
00:13:37,830 --> 00:13:39,670
.هذه أوّل مرّة نتّفق فيها على شيء ما

251
00:13:40,750 --> 00:13:43,300
.إن حدث أيّ شيء، سأتحمّل المسؤوليّة

252
00:13:44,340 --> 00:13:46,260
.لا تحاول أن تكون بطلاً يا شريكي

253
00:13:46,260 --> 00:13:49,140
.لا تتحدّث معي هكذا. هذا يثير غثياني

254
00:13:49,140 --> 00:13:49,840
ماذا؟

255
00:13:49,840 --> 00:13:51,810
.حسنًا، هذا يكفي

256
00:13:52,220 --> 00:13:52,850
أيّتها الرّئيسة؟

257
00:13:56,310 --> 00:13:57,140
...يا رفاق

258
00:14:02,110 --> 00:14:03,440
!كوباياشي-سان

259
00:14:04,360 --> 00:14:07,740
.نعم، لقد أتيتُ من متجري على درّاجتي

260
00:14:08,110 --> 00:14:11,160
.إنّ هوايتي هي مذياع الهاويين

261
00:14:11,160 --> 00:14:13,830
ما هي رسالة فوناساكا-سان إذًا؟

262
00:14:13,830 --> 00:14:14,580
.نعم، نعم

263
00:14:14,910 --> 00:14:18,410
."يريدك أن تلتقي بهم لأنّهم عرفوا مكان الوحدة "رو

264
00:14:18,410 --> 00:14:19,420
فعلاً؟

265
00:14:19,420 --> 00:14:21,420
.سوف يقومون بالهجوم

266
00:14:21,710 --> 00:14:23,340
.شكرًا لك يا كوباياشي-سان

267
00:14:23,340 --> 00:14:24,800
.سأوافيهم في الحال

268
00:14:25,090 --> 00:14:26,970
.لن تقومي بذلك

269
00:14:27,470 --> 00:14:31,510
كازاري-كُن، ويلوير الوحدة الثّامنة
.ليست ملكيّة خاصّة

270
00:14:31,510 --> 00:14:33,430
...لكن أيّها المدير، نحن الآن

271
00:14:33,430 --> 00:14:34,640
.أجيبيني

272
00:14:34,930 --> 00:14:37,020
مع من أنتِ؟

273
00:14:37,020 --> 00:14:39,350
الشّرطة أم الوحدة الثّامنة؟

274
00:14:39,350 --> 00:14:45,190
بصفتي ظابطة شرطة تمّ تعيينها في الوحدة
.الثّامنة، لا أستطيع مخالفة أوامر رئيستي

275
00:14:45,190 --> 00:14:47,110
.تحتاجين لتعلّم المزيد عن السّياسة

276
00:14:47,110 --> 00:14:51,030
،إذا كنتِ ترغبين أن تصبحي ظابطة مهمّة
.عليك أن تتّبعي إرادة الحكومة

277
00:14:51,870 --> 00:14:53,070
...لكنّنا الآن

278
00:14:53,070 --> 00:14:55,080
!لا رغبة لي للاستماع لشكواكِ

279
00:14:55,080 --> 00:14:58,830
!عليكِ أن تطيعي أوامري فحسب بصفتي مرؤوسكِ

280
00:14:58,830 --> 00:15:01,540
.إذًا أنا أوافق. اذهبي يا كازاري-كُن

281
00:15:02,830 --> 00:15:04,460
...المدير العامّ

282
00:15:04,710 --> 00:15:07,760
.أنا أأذن بهجوم الوحدة الثّامنة

283
00:15:08,300 --> 00:15:11,840
أنتم الوحيدون القادرون على التّصرّف
.في حالة الطّوارئ هذه

284
00:15:11,840 --> 00:15:12,640
.حاضرة

285
00:15:12,640 --> 00:15:14,220
...لكن يا سيّدي

286
00:15:14,220 --> 00:15:18,020
!عليك أن تطيع أوامري فحسب بصفتي مرؤوسك

287
00:15:18,890 --> 00:15:22,060
،ها أنا آمُر الشّعبة الخامسة الخاصّة للأمن العام

288
00:15:22,060 --> 00:15:23,810
،وحدة الهجوم المتنقّل الثّالث الثّامنة

289
00:15:24,110 --> 00:15:25,480
.أن تحمي اليابان

290
00:15:26,940 --> 00:15:27,650
!عُلم

291
00:15:35,580 --> 00:15:39,290
.الوحدة الثّامنة؟ لقد تقفّوا أثرنا أسرع ممّا ظننت

292
00:16:10,110 --> 00:16:12,900
.تأكيد الانتقال للمذياع التّناظريّ

293
00:16:12,900 --> 00:16:13,740
.حسنًا

294
00:16:13,740 --> 00:16:14,450
.إنّه ممتاز

295
00:16:14,660 --> 00:16:15,530
.كلّ شيء على ما يرام

296
00:16:15,530 --> 00:16:16,870
.نعم، أستطيع سماعكم

297
00:16:16,870 --> 00:16:18,330
.حسنًا، لننطلق

298
00:16:25,830 --> 00:16:27,880
!عرفتُ أنّهم سيصلون إلى هنا قبلنا

299
00:16:32,510 --> 00:16:33,970
...إرهابيّون

300
00:16:33,970 --> 00:16:35,340
.اقضوا على العدوّ

301
00:16:42,350 --> 00:16:43,270
ماذا؟

302
00:16:43,520 --> 00:16:47,400
أيّها الرّئيس، المهاجمون يرتدون ويلوير
!قوّات الدّفاع الذّاتيّ المتّحدة

303
00:16:48,110 --> 00:16:50,860
لماذا تهاجمنا قوّات الدّفاع الذّاتيّ؟

304
00:16:51,360 --> 00:16:53,190
.وهم لا يتهاونون في ذلك أيضًا

305
00:16:53,190 --> 00:16:55,320
.مسعاهم هو قتلنا بكلّ وضوح

306
00:16:55,610 --> 00:16:58,160
أهو نظام التّعرّف على الصّديق والعدوّ؟
.إنّه فخّ ممتاز

307
00:16:58,160 --> 00:17:00,080
!لا فرصة أمامنا

308
00:17:00,330 --> 00:17:02,000
.لا تقلقوا، بإمكاننا الفوز

309
00:17:02,410 --> 00:17:04,040
أأنتِ واثقة؟

310
00:17:06,080 --> 00:17:06,790
.هذا صحيح

311
00:17:06,790 --> 00:17:10,000
وحدة "رو" من أوروتشي محميّة ببابٍ سيُفتح

312
00:17:10,000 --> 00:17:12,880
.عن طريق الحاسوب ومفتاح فعليّ بشكل متزامن

313
00:17:12,880 --> 00:17:15,380
،ليس على ميثوس أن يفتح الباب فحسب

314
00:17:15,380 --> 00:17:18,430
.لكن عليه أن يعيد ضبط صلاحيّات دخول المدير

315
00:17:18,430 --> 00:17:19,970
.سياخذ ذلك بعض الوقت

316
00:17:20,350 --> 00:17:21,350
.مفهوم

317
00:17:21,350 --> 00:17:24,060
يا رفاق، عودوا إلى مركبة القيادة
!واستعدّوا للمداهمة

318
00:17:24,060 --> 00:17:24,980
!عُلم

319
00:17:26,140 --> 00:17:28,560
.لقد فككتُ شيفرة كلمة السّرّ

320
00:17:28,900 --> 00:17:30,440
،أعزّائي قوّات الدّفاع الذّاتيّ

321
00:17:30,820 --> 00:17:33,030
.وفّروا لي بعض الوقت رجاءً

322
00:17:39,870 --> 00:17:40,870
.انطلقوا

323
00:17:44,000 --> 00:17:45,660
.نحن الشّرطة

324
00:17:46,290 --> 00:17:48,040
.كفّوا عن المقاومة رجاءً

325
00:17:48,500 --> 00:17:51,710
.إن رفضتم، فسنضطرّ لإيذائكم

326
00:17:56,920 --> 00:18:00,090
!لا فائدة! إنّهم لا يستمعون للأصوات الخارجيّة

327
00:18:00,090 --> 00:18:02,430
.لا خيار آخر أمامنا
!شغّلوا كلّ أوضاع التّصعيد

328
00:18:09,730 --> 00:18:11,610
.هؤلاء الإرهابيّون بارعون بالفعل

329
00:18:16,990 --> 00:18:20,280
!هنالك عدد أقلّ من الإرهابيّين؟ مهلاً لحظة

330
00:18:26,750 --> 00:18:29,170
الوحدة "رو" من أوروتشي موجودة تحتنا بطابقين؟

331
00:18:33,210 --> 00:18:34,670
مستحيل... ميهو؟

332
00:18:35,000 --> 00:18:37,050
—اسمعي! في القبو، مصفوفة الاستخبارات

333
00:18:40,550 --> 00:18:42,600
!التّواصل الخارجي معطّل

334
00:18:51,810 --> 00:18:53,610
لقد وصلت! أين الجميع؟

335
00:18:53,610 --> 00:18:56,690
.ممتاز، انتهيتُ للتّو من القيام بالتّعديلات

336
00:18:56,690 --> 00:18:58,400
.خذي هذه رجاءً

337
00:19:01,410 --> 00:19:03,530
!الهجوم الدّائريّ

338
00:19:10,120 --> 00:19:12,580
.لا وقت لي لأقاتلك الآن

339
00:19:24,930 --> 00:19:27,430
...القليل فحسب... القليل فحسب

340
00:19:45,160 --> 00:19:47,030
!أيّتها الرّئيسة، لا يمكننا الاستمرار أكثر

341
00:19:47,290 --> 00:19:48,410
!عثرتُ عليها

342
00:19:48,410 --> 00:19:50,620
!عثرتُ على مركبة قيادة قوّات الدّفاع الذّاتيّ في الخلف

343
00:19:50,620 --> 00:19:54,080
إنّ قُطع رابط التّواصل خاصّتهم، قد يعود
.نظام تحديد العدوّ والصّديق لطبيعته

344
00:19:54,080 --> 00:19:55,380
!أوسكار 2

345
00:20:02,130 --> 00:20:03,380
!تـ-تبًّا

346
00:20:03,930 --> 00:20:06,600
!نمط محاكات ساكيغاكي، تفعيل

347
00:20:12,440 --> 00:20:14,440
!أحسنت! تهانيّ لك

348
00:20:14,940 --> 00:20:15,610
ماذا؟

349
00:20:22,820 --> 00:20:24,530
،حسب قانون الخدمة السّرّيّة

350
00:20:24,530 --> 00:20:25,780
.سأستعمل الآن القوّة الجسديّة

351
00:20:26,370 --> 00:20:28,200
!الموجة الكهربائيّة الاهتزازايّة الصّادمة المدمّرة

352
00:20:32,210 --> 00:20:33,870
.إلى القيادة، أجيبوني

353
00:20:33,870 --> 00:20:34,670
!إلى القيادة

354
00:20:35,630 --> 00:20:37,250
...تمّ قطع الرّابط

355
00:20:40,380 --> 00:20:43,090
سويتشيرو؟ لماذا أنت هنا؟

356
00:20:43,090 --> 00:20:44,800
.أنا من عليه قول ذلك

357
00:20:47,850 --> 00:20:50,510
!توقّفوا عن الهجوم! توقّفوا الآن

358
00:20:55,520 --> 00:20:57,860
.يبدو أنّهم يتعرّفون عليك كعدوّ الآن أيضًا

359
00:21:04,900 --> 00:21:05,820
!أوسكار 1

360
00:21:07,950 --> 00:21:08,990
ما هذا؟

361
00:21:08,990 --> 00:21:12,250
.محفّز النّوم من حادثة الآليّ العملاق

362
00:21:17,630 --> 00:21:20,130
علينا أن نوقف ميثوس فقط، صحيح؟

363
00:21:20,130 --> 00:21:20,750
.نعم

364
00:21:20,750 --> 00:21:22,130
!الباب مفتوح

365
00:21:29,470 --> 00:21:30,890
أنلنا منه في الوقت المناسب؟

366
00:21:30,890 --> 00:21:32,270
...أم أنّنا

367
00:21:41,020 --> 00:21:41,940
!الإنترنيت

368
00:21:41,940 --> 00:21:43,860
!عاد اتّصال الإنترنيت

369
00:21:47,110 --> 00:21:50,030
!أرى أنّنا استعدنا النّظام! جيّد

370
00:21:50,740 --> 00:21:52,240
،أأنتم سعداء

371
00:21:52,240 --> 00:21:55,080
يا أسلوب اليابان الّذي نفاني؟

372
00:21:55,870 --> 00:21:59,000
...لكن الآن، كلّ شيء ملكي

373
00:22:00,250 --> 00:22:00,960
.لقد فزتُ

374
00:22:02,300 --> 00:22:04,760
لماذا ليكو-تشان على الشّاشة؟

375
00:22:04,760 --> 00:22:07,840
.أنا أعتذر لكلّ من يشاهدني الآن

376
00:22:12,510 --> 00:22:14,220
.تهانيّ

377
00:22:14,220 --> 00:22:16,350
كلّ الأجهزة الّتي تمّ تثبيت تطبيق ليكو عليها

378
00:22:16,350 --> 00:22:18,690
.أصبحت ملكًا لميثوس الآن