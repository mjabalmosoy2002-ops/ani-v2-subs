.وكنّا بالطّبع في طريقنا لفضح محتال

181
00:12:26,620 --> 00:12:28,020
...لكن

182
00:12:40,770 --> 00:12:43,900
...في النّهاية... خفت، و

183
00:12:45,800 --> 00:12:47,370
.هربت

184
00:12:48,800 --> 00:12:51,880
تعني أنّك تركته هناك ببساطة
حتّى لا تقع في المتاعب؟

185
00:12:51,880 --> 00:12:53,530
!يا لك من نذل حقير

186
00:12:53,530 --> 00:12:54,970
.أعلم ذلك

187
00:12:54,970 --> 00:12:58,170
لهذا وافقتُ على المشاركة
.في الحدث الرّئيسيّ

188
00:12:58,510 --> 00:13:00,930
.قوّة لعبة القدماء العظماء حقيقيّة

189
00:13:00,930 --> 00:13:04,430
أقنعتُ نفسي أنّي أستطيع
.استخدام نقاطي لإعادته إلى الحياة

190
00:13:06,020 --> 00:13:10,440
لكن لا يمكنك إنقاذه إن متّ، أليس كذلك؟

191
00:13:10,440 --> 00:13:15,070
أدركت أنّه حتّى لو أعَدْتُه، فلن يُغيّر
.ذلك حقيقة أنّي كنت سبب موته

192
00:13:15,510 --> 00:13:18,130
.لا يمكنني محو ذلك الذّنب

193
00:13:19,280 --> 00:13:22,580
لذا، أفضّل أن أساعدكم جميعًا
.بدلاً من ذلك

194
00:13:22,580 --> 00:13:25,620
.لا بدّ أنّها فرصة منحنيها الإله

195
00:13:26,080 --> 00:13:28,820
.إنّها الفرصة لأكفّر عن أخطائي السّابقة

196
00:13:29,460 --> 00:13:30,460
!مهلاً

197
00:13:30,830 --> 00:13:34,520
!هيّا، اضغطوا الزّرّ
!لا يهمني من منكم يفعلها

198
00:13:36,520 --> 00:13:37,670
.سأفعلها أنا

199
00:13:37,950 --> 00:13:39,020
!تسوغومي-سان

200
00:13:39,020 --> 00:13:42,810
.إن بقينا واقفين هكذا، سنخسر اللّعبة جميعًا

201
00:13:46,250 --> 00:13:47,720
.سأضغط الزّرّ

202
00:13:48,330 --> 00:13:49,550
.باشري

203
00:13:57,230 --> 00:14:02,340
!مهلاً! لم يُفترض أن يحدث هذا

204
00:14:05,580 --> 00:14:06,940
!فُتحت البّوابة

205
00:14:06,940 --> 00:14:08,040
!تسوغومي-سان

206
00:14:08,040 --> 00:14:08,910
!كانّا، مهلاً

207
00:14:09,830 --> 00:14:12,160
!أجل! أنا أوّل الخارجين

208
00:14:13,620 --> 00:14:15,210
!تسوغومي-سان

209
00:14:18,960 --> 00:14:21,420
كلاّ! لماذا؟

210
00:14:24,380 --> 00:14:25,850
!كانّا

211
00:14:45,980 --> 00:14:47,830
ما المضحك؟

212
00:14:47,830 --> 00:14:50,160
!يا لهما من غبيّين

213
00:14:50,160 --> 00:14:52,990
كيف لم يدركا أمرًا بهذه الأهمّيّة؟

214
00:14:52,990 --> 00:14:54,330
عمّ تتحدّث؟

215
00:14:54,940 --> 00:14:57,300
!"إنّه "الفندق المعكوس

216
00:14:57,300 --> 00:14:59,840
.كل شيء هنا معكوس

217
00:14:59,840 --> 00:15:03,590
لذا من الطّبيعيّ أن تكون
.كلّ الرّسائل معكوسة أيضًا

218
00:15:03,590 --> 00:15:07,610
،إذا قالت الرّسالة أنّنا بحاجة إلى قربان
.فهذا يعني أنّنا لسنا بحاجة إليه

219
00:15:07,610 --> 00:15:10,850
،إذا قالت أنّ هذه نقطة الوصول
.فهي العكس تمامًا

220
00:15:11,850 --> 00:15:15,310
يجب الحرص على فهم
!القواعد قبل بدء اللّعب

221
00:15:15,310 --> 00:15:18,270
أيّ نوع من لاعبي غرف الهروب
لا يعرف ذلك؟

222
00:15:18,270 --> 00:15:19,440
...لـ-لكن

223
00:15:19,440 --> 00:15:21,480
...إذًا الأستاذ المساعد تاكاغي

224
00:15:21,480 --> 00:15:23,820
.مات بلا سبب

225
00:15:24,540 --> 00:15:26,850
عرفتَ هذا، ومع ذلك تركتَ الأمر يحدث؟

226
00:15:26,850 --> 00:15:28,360
ومن يهتمّ أصلاً؟

227
00:15:28,360 --> 00:15:31,200
.كلاهما حاولا أن يضحّيا بنا أيضًا

228
00:15:35,740 --> 00:15:41,250
إن أصبحتم القربان، ستُنهون"
".اللّعبة ويموت الجميع سواكم

229
00:15:41,760 --> 00:15:43,020
ما هذه؟

230
00:15:43,020 --> 00:15:44,710
.واحدة من البطاقات الخاصّة

231
00:15:45,030 --> 00:15:48,430
إذًا كان يخطّط لخداعنا منذ البداية؟

232
00:15:48,430 --> 00:15:50,020
!هذا صحيح

233
00:15:51,830 --> 00:15:53,420
.وكذلك هي

234
00:15:53,420 --> 00:15:56,230
،إن تسبّبتم في إقصاء أحدهم بأيديكم"

235
00:15:56,230 --> 00:15:58,930
،ثمّ هربتم قبل البقيّة
".فستحصلون على مكافأة

236
00:16:00,930 --> 00:16:02,230
تفهمون الأمر الآن، صحيح؟

237
00:16:02,610 --> 00:16:07,360
،كانا شخصين حقيرين، لم يهتمّا بكِ
.بل بنفسيهما فقط

238
00:16:10,100 --> 00:16:11,750
...تسوغومي-سان

239
00:16:12,280 --> 00:16:16,490
صحيح. لم تكن تسوكاسا تسوغومي
.تفكّر إلاّ في إنقاذ نفسها

240
00:16:16,490 --> 00:16:18,540
.الأمور ليست بهذه البساطة أبدًا

241
00:16:18,540 --> 00:16:20,040
...كيف لك أن

242
00:16:19,100 --> 00:16:21,380
!نعم، نعم، كفى أيّتها الفاضلة الصّغيرة

243
00:16:21,380 --> 00:16:26,050
في النّهاية، لا أنتِ ولا غيرك
.حاول أن يوقفهما

244
00:16:26,050 --> 00:16:27,260
هل أخطأتُ في شيء ما؟

245
00:16:27,260 --> 00:16:29,540
.لا أحد مذنب هنا

246
00:16:32,800 --> 00:16:35,910
.كان الباب الّذي استخدمته تسوغومي-سان فخًّا

247
00:16:35,910 --> 00:16:38,560
فأين تكون نقطة الوصول الحقيقيّة؟

248
00:16:38,560 --> 00:16:41,690
ألا تعرف الجواب؟

249
00:16:41,690 --> 00:16:45,400
...رغم أنّي أكره الاعتراف
.بدأتُ أرتبك أنا أيضًا

250
00:16:45,400 --> 00:16:48,050
.هيّا بنا، علينا حلّ هذا اللّغز

251
00:16:48,050 --> 00:16:49,370
...كانّا-سان

252
00:16:49,370 --> 00:16:50,580
.أنا بخير

253
00:16:51,690 --> 00:16:54,480
!فكّري، فكّري، فكّري

254
00:16:55,370 --> 00:16:58,700
ما الّذي غفلنا عنه؟

255
00:16:59,570 --> 00:17:01,350
...الفندق المعكوس

256
00:17:01,830 --> 00:17:04,100
.فندق تنعكس فيه كلّ الأشياء

257
00:17:04,710 --> 00:17:06,000
...كلّ الأشياء

258
00:17:06,320 --> 00:17:09,810
...أجل! إن كانت الأمور معكوسة فعلاً

259
00:17:16,270 --> 00:17:18,820
!يشمل ذلك الأرضيّة والسّقف أيضًا

260
00:17:19,710 --> 00:17:22,480
!انسَيْ ذلك الآن! الغرفة تغرق

261
00:17:24,770 --> 00:17:25,940
!لقد توقّفت

262
00:17:26,490 --> 00:17:27,940
!انظروا هناك

263
00:17:29,050 --> 00:17:31,540
بابان لنقطة الوصول؟

264
00:17:31,540 --> 00:17:32,730
ماذا؟

265
00:17:32,730 --> 00:17:34,910
علينا اختيار أحدهما؟

266
00:17:35,230 --> 00:17:37,250
...النّقوش فوق البابين

267
00:17:37,250 --> 00:17:39,080
."الأزرق "كثولو الماء

268
00:17:39,080 --> 00:17:41,040
."الأحمر "غوا اللّهب

269
00:17:42,230 --> 00:17:43,170
!الأرض

270
00:17:43,170 --> 00:17:44,240
!هذا سيّئ

271
00:17:44,240 --> 00:17:45,430
!علينا اختيار أحد البابين الآن

272
00:17:45,430 --> 00:17:46,880
لكن أيّهما هو الصّحيح؟

273
00:17:47,230 --> 00:17:49,270
!لا بدّ من وجود دليل

274
00:17:49,270 --> 00:17:52,010
هذا صحيح! لا بدّ أنّ إحدى
!البطاقات الأخرى تحمل تلميحًا

275
00:17:52,010 --> 00:17:53,430
!هذا صحيح

276
00:17:54,120 --> 00:17:57,050
...كان شيئًا عن جلب الرّياح لشيء ما

277
00:17:58,180 --> 00:18:03,060
،احذروا رياح ملك الرّداء الأصفر"
"!فإنّها تنذر بالموت

278
00:18:03,650 --> 00:18:04,560
!هذه هي

279
00:18:05,060 --> 00:18:07,440
!ثمّة نسمة خفيفة تتسلّل من خلف النّقش

280
00:18:08,000 --> 00:18:12,070
،وإن كان كلّ شيء في هذا المكان معكوسًا
!فمعنى البطاقة سيكون معكوسًا أيضًا

281
00:18:12,070 --> 00:18:15,280
!ما يعني أنّ البابين أمامنا خدعة أيضًا

282
00:18:15,620 --> 00:18:17,430
...المخرج الحقيقيّ هو

283
00:18:18,990 --> 00:18:20,700
!ذلك الثّقب

284
00:18:21,360 --> 00:18:23,130
!علينا أن نقفز هناك؟

285
00:18:23,130 --> 00:18:24,060
!حقًا؟

286
00:18:24,060 --> 00:18:26,210
!هل ستتحمّلين المسؤوليّة إن كنتِ مخطئة؟

287
00:18:28,510 --> 00:18:30,110
أأنتِ واثقة من هذا؟

288
00:18:32,260 --> 00:18:33,130
!أأنت واثقة؟

289
00:18:33,130 --> 00:18:34,630
!نـ-نعم

290
00:18:35,180 --> 00:18:36,590
...أعتقد

291
00:18:45,550 --> 00:18:48,890
!لا أصدّق هذا

292
00:19:01,490 --> 00:19:03,080
!نجونا

293
00:19:03,080 --> 00:19:04,710
!أحسنت عملاً يا كانّا-سان

294
00:19:05,250 --> 00:19:07,710
.كان بإمكاننا سماع الهتاف من الاستوديو

295
00:19:08,130 --> 00:19:09,560
.فعرفنا أنّك كنتِ على صواب

296
00:19:09,560 --> 00:19:11,180
لم تقفز حتّى سمعتَ ذلك؟

297
00:19:11,180 --> 00:19:12,420
الحيطة واجبة، أليس كذلك؟

298
00:19:13,600 --> 00:19:15,530
.أنت مجنونة

299
00:19:15,530 --> 00:19:17,920
المهمّ أنّنا نجونا، أليس كذلك؟

300
00:19:17,920 --> 00:19:19,460
...نعم، لكن

301
00:19:19,460 --> 00:19:21,680
!لِمَ أخذتِني معك؟

302
00:19:21,680 --> 00:19:25,310
.كنتِ واثقة جدًّا من استنتاجك

303
00:19:25,310 --> 00:19:27,520
.وكان لا بدّ أن تتحمّلي مسؤوليّته

304
00:19:28,980 --> 00:19:31,570
!تهانينا

305
00:19:31,890 --> 00:19:35,570
!لقد اجتزتم تحدّي غرفة الهروب

306
00:19:35,570 --> 00:19:37,150
...يا إلهي

307
00:19:37,650 --> 00:19:40,310
.نجونا مجدّدًا

308
00:19:40,310 --> 00:19:42,650
.تمّ إقصاء شخصين هذه المرّة

309
00:19:43,620 --> 00:19:48,630
سيحصل كلّ من تبقّى على
!مليون وأربعمائة ألف نقطة

310
00:19:50,530 --> 00:19:53,960
...كنت أرجو أن يقلّ عددنا أكثر

311
00:19:54,840 --> 00:19:55,930
!ما الّذي تعنيه؟

312
00:19:55,930 --> 00:19:57,720
قمت بخدعة أخرى، صحيح؟

313
00:19:57,720 --> 00:19:59,710
.لا. على الإطلاق

314
00:19:59,710 --> 00:20:02,100
.بل على العكس، هذا كلّه لأنّني لم أفعل شيئًا

315
00:20:02,930 --> 00:20:06,620
بطاقات المكافأة الخاصّة الّتي
...كانت مع تاكاغي وتسوغومي

316
00:20:07,310 --> 00:20:11,020
.كنتُ أوّل من عثر عليها

317
00:20:11,900 --> 00:20:14,780
.لكنّني تجاهلتها فحسب

318
00:20:16,020 --> 00:20:17,490
...أدركتُ حينها

319
00:20:17,910 --> 00:20:21,990
أنّه إن حالفني الحظّ، فقد يقع
.ضحيّتها أحد غيري ويُقصى

320
00:20:23,280 --> 00:20:24,390
!...أيّها الـ

321
00:20:24,390 --> 00:20:27,480
لا يوجد ما قد يدفعك للغضب منّي، صحيح؟

322
00:20:27,480 --> 00:20:30,810
،وأنتم سعداء بهذا أيضًا
!حتّى لو لم تعترفوا بذلك

323
00:20:30,810 --> 00:20:33,550
.نجوتم، وكسبتم نقاطًا إضافيّة

324
00:20:34,680 --> 00:20:35,680
ما الأمر؟

325
00:20:35,680 --> 00:20:39,280
أظننتم حقًّا أننا جميعًا سنبقى
أصدقاء في لعبة مختلّة مثل هذه؟

326
00:20:39,280 --> 00:20:40,590
!مستحيل

327
00:20:40,590 --> 00:20:42,890
كلّنا مجانين مختلّون، أليس كذلك؟

328
00:20:42,890 --> 00:20:44,060
!ينبغي أن تشكروني

329
00:20:44,060 --> 00:20:47,630
!ينبغي أن تكوني أسعد
تريدين المال، أليس كذلك؟

330
00:20:55,620 --> 00:20:58,060
!أنا لستُ مثلك

331
00:20:59,200 --> 00:21:05,150
إذًا، ما الدّافع النّبيل الّذي جاء بك
إلى هنا أيّتها الآنسة كانّا؟

332
00:21:09,580 --> 00:21:11,210
!أعجبني هذا

333
00:21:11,210 --> 00:21:15,540
،كنت أرجو عددًا أكبر من الضّحايا
!لكنّ هذه نهاية رائعة

334
00:21:15,540 --> 00:21:16,930
.كانت مقبولة

335
00:21:16,930 --> 00:21:19,590
.يا له من جمهور صعب الإرضاء

336
00:21:20,800 --> 00:21:24,870
!حسنًا جميعًا! نراكم في اللّعبة القادمة

337
00:21:24,870 --> 00:21:27,180
!أتمنّى لكم مساءً رائعًا

338
00:21:44,440 --> 00:21:47,120
ماذا؟ ما الخطب يا غاتانوثوا؟

339
00:21:47,120 --> 00:21:50,290
!أهكذا يكون وجع القلب؟

340
00:21:50,870 --> 00:21:55,510
.تجاهلوه. التقط ذلك من كتاب غريب ما

341
00:21:55,510 --> 00:21:58,120
ما الّذي نفعله؟

342
00:21:58,120 --> 00:22:01,810
كيف ندّعي أنّنا رُعب كونيّ
ونحن لا نؤذي إلاّ بشرًا ضعفاء؟

343
00:22:01,810 --> 00:22:03,810
كيف يمكننا أن ندعو أنفسنا
بالآلهة الخارجيّة؟

344
00:22:03,810 --> 00:22:06,210
ما بك؟ هل جُننت؟

345
00:22:06,210 --> 00:22:08,030
أليست لعبتك هي التّالية؟

346
00:22:08,030 --> 00:22:09,220
هل أنت بخير؟

347
00:22:09,710 --> 00:22:11,890
.أريد أن أؤمن بهم

348
00:22:11,890 --> 00:22:14,450
.أؤمن بإنسانيّتهم

349
00:22:14,450 --> 00:22:17,950
.ولهذا، ستكون هذه لعبتي