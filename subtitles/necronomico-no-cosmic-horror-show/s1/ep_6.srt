1
00:00:13,340 --> 00:00:14,750
.دعيني أبيت هنا

2
00:00:15,440 --> 00:00:17,290
.أظنّني لا أمانع

3
00:00:22,890 --> 00:00:25,460
،بعد أن تمّ بثّ تلك المسابقة للعالم بأسره

4
00:00:25,460 --> 00:00:30,090
،عرف كلٌّ من معجبيها وكارهيها أين تعيش
.ولم يكن من الآمن البقاء هناك

5
00:00:31,610 --> 00:00:34,480
.لذلك أتت الآنسة الصّغيرة كانّا للعيش معي

6
00:02:14,970 --> 00:02:17,240
.ظللنا هنا طوال الأسبوع

7
00:02:17,240 --> 00:02:18,610
.نعم

8
00:02:20,000 --> 00:02:22,080
.مع أنّي لا أمانع ذلك

9
00:02:22,080 --> 00:02:23,210
...نعم

10
00:02:23,210 --> 00:02:25,700
.توقّفي عن النّظر إلى هاتفك فحسب

11
00:02:25,700 --> 00:02:27,670
.واثقة أنّك لن تجدين أيّ كلام جيّد هناك

12
00:02:27,670 --> 00:02:29,960
!صحيح، لكنّي مدمنة

13
00:02:29,960 --> 00:02:31,540
.لا يبرّر وعيك الذّاتي بنفسك ذلك

14
00:02:31,930 --> 00:02:36,510
أريد أن أجد المديح الوحيد وسط
!الإهانات التّسعة والتّسعين

15
00:02:36,510 --> 00:02:38,380
!أريد أن أتشبّث به كأنّه طوق نجاة

16
00:02:38,850 --> 00:02:41,930
.نعم، واضح أنّك مدمنة فعلاً

17
00:02:41,930 --> 00:02:44,100
ألا يزعجك الأمر؟

18
00:02:44,100 --> 00:02:46,400
،لا أحبّ أن يتكلّم النّاس بالسّوء عنّي

19
00:02:46,400 --> 00:02:48,660
.لكنّ الأمر لا يؤذيني فعليًّا

20
00:02:48,660 --> 00:02:51,030
.ليس وكأنّي سأقابل من قال ذلك يومًا

21
00:02:51,030 --> 00:02:54,200
.لا تصلحين لأن تكوني مقدّمة بثوث مباشرة

22
00:02:54,200 --> 00:02:55,890
.ربّما معك حقّ

23
00:02:56,500 --> 00:02:58,910
.كان الجميع يحضر البثوث لرؤية مايو فحسب

24
00:02:58,910 --> 00:03:01,610
.كان لديها معجبون كثر

25
00:03:01,610 --> 00:03:02,620
.نعم

26
00:03:03,280 --> 00:03:05,080
هل سمعتِ شيئًا جديدًا من كي-سان؟

27
00:03:05,080 --> 00:03:06,000
.لا

28
00:03:06,000 --> 00:03:07,400
.أشعر بالقلق

29
00:03:07,400 --> 00:03:09,200
.يقولون أنّ الشّركة تعيش فوضى

30
00:03:09,200 --> 00:03:12,680
أتمنى أن يفلسوا ويضطرّوا
.لإغلاق مركز الواقع الافتراضيّ ذاك

31
00:03:12,680 --> 00:03:16,340
واثقة أنّ القدماء العظماء سيستخدمون
قواهم لمنع ذلك، أليس كذلك؟

32
00:03:16,340 --> 00:03:18,550
.هذا يغضبني فعلاً

33
00:03:19,320 --> 00:03:23,520
كلّ ما أردته هو الهرب من الأشياء
.المخيفة وقضاء وقت ممتع

34
00:03:25,240 --> 00:03:29,460
يقول هذا التّعليق أنّه كان يجب
.أن أواجه مشاكلي بدلاً من الفرار. هراء

35
00:03:29,460 --> 00:03:30,870
من يظنّ نفسه هذا الأحمق؟

36
00:03:30,870 --> 00:03:33,950
.اسمعي، تجاهليهم جميعًا

37
00:03:34,270 --> 00:03:36,700
.أنا مستعدّة لأساعدك

38
00:03:36,700 --> 00:03:37,700
في ماذا؟

39
00:03:37,700 --> 00:03:40,240
.في إعادة مايو-تشان

40
00:03:40,700 --> 00:03:43,080
.لا أحتاج النّقاط لشيء آخر على أيّة حال

41
00:03:43,080 --> 00:03:45,000
!حقًّا؟ سيكون ذلك رائعًا

42
00:03:45,270 --> 00:03:49,200
نحتاج فقط للتّخلّص من تلك الأخطبوط
الّتي تُدعى كثولو، أليس كذلك؟

43
00:03:49,200 --> 00:03:52,440
.قالوا أنّ مليار نقطة تكفي لذلك

44
00:03:52,440 --> 00:03:54,400
.لا زال ذلك كثيرًا

45
00:03:54,400 --> 00:03:56,170
كم نقطة لديك الآن؟

46
00:03:56,170 --> 00:03:57,170
.خمسة ملايين

47
00:03:57,170 --> 00:03:58,620
...سبعة ملايين

48
00:03:59,840 --> 00:04:04,000
.اللّعبة الرّابعة هي التّالية... ثمّ النّهائيّات

49
00:04:04,000 --> 00:04:05,430
تظنّين أنّنا سنجمع ما يكفي؟

50
00:04:05,430 --> 00:04:07,020
.سأحرص على أن ننجح في ذلك

51
00:04:07,020 --> 00:04:08,310
.مهما كلّف الأمر

52
00:04:12,170 --> 00:04:13,730
هل طلبتِ شيئًا؟

53
00:04:13,730 --> 00:04:14,760
...لا

54
00:04:14,760 --> 00:04:17,490
إذًا هل وجد أحدهم هذا المكان أيضًا؟

55
00:04:20,040 --> 00:04:21,150
.هذا أنا

56
00:04:21,150 --> 00:04:22,860
.سانو سيشيرو

57
00:04:27,120 --> 00:04:28,120
.مرحبًا

58
00:04:29,830 --> 00:04:31,370
.مرحبًا أيّها المهووس بالفتيات الصّغيرات

59
00:04:31,370 --> 00:04:34,540
أخبرتك أن تبقى على بعد مترٍ واحدٍ
.منّي على الأقلّ في كلّ الأوقات

60
00:04:34,540 --> 00:04:36,300
.يا ويحي، أنا أعتذر

61
00:04:36,640 --> 00:04:39,010
.كنت أبحث عنك في كل مكان

62
00:04:40,590 --> 00:04:42,960
!لا تفعل أيّها الملاحق

63
00:04:42,960 --> 00:04:44,850
!لم أخبر أحدًا عن هذا المكان

64
00:04:44,850 --> 00:04:47,740
.لم أكن قلقًا بشأنك

65
00:04:47,740 --> 00:04:52,010
،لكن كانّا-سان اختفت
.فظننتُ أنّها ربّما كانت معك

66
00:04:52,650 --> 00:04:56,910
.العالم بأكمله مشتعل بشأن مستشفى والدك

67
00:04:56,910 --> 00:04:58,460
هل أنت بخير؟

68
00:04:58,460 --> 00:04:59,720
.نعم

69
00:04:59,720 --> 00:05:01,180
.متأكّدة أنّه سيتكفّل بالتّغطية على الأمر

70
00:05:01,180 --> 00:05:04,120
.ومع ذلك، لا أشعر بالحزن لرؤيتهما يعانيان

71
00:05:04,120 --> 00:05:07,460
.إن كان ذلك يريحك، فأنا معك

72
00:05:07,460 --> 00:05:09,940
.أنت شخص طيّب يا سيشيرو-سان

73
00:05:09,940 --> 00:05:11,660
.بالنّسبة لمهووس بالفتيات الصّغيرات بالطّبع

74
00:05:11,660 --> 00:05:13,580
...تمهّلي

75
00:05:14,000 --> 00:05:15,700
ماذا عنك؟

76
00:05:15,700 --> 00:05:17,600
!استقلت من عملي كمدرّس

77
00:05:18,390 --> 00:05:20,630
.لا أريد التّسبّب بالمشاكل لمن حولي

78
00:05:20,930 --> 00:05:24,490
أمّا عائلتي... فقد طلبت
.منهم مغادرة المدينة

79
00:05:24,490 --> 00:05:27,270
.لا بأس، إنّهم يتفهّمون

80
00:05:29,430 --> 00:05:31,390
.سأذهب الآن

81
00:05:31,710 --> 00:05:33,470
وأين تعيش؟

82
00:05:33,470 --> 00:05:37,590
سأقيم في فنادق رجال الأعمال
.الرّخيصة لبعض الوقت

83
00:05:37,590 --> 00:05:42,860
ربّما سأجمع بعض النّقاط
.وأطلب استعادة حياتي

84
00:05:44,110 --> 00:05:45,370
.أعتقد أنّ تلك فكرة جيّدة

85
00:05:45,370 --> 00:05:47,020
.شكرًا

86
00:05:47,020 --> 00:05:51,110
.كيفما انتهى الأمر، فلم يتبقَّ سوى لعبتين

87
00:05:51,110 --> 00:05:52,330
...بالمناسبة

88
00:05:53,210 --> 00:05:54,700
...إيتا-كُن

89
00:05:54,700 --> 00:05:56,880
.قد اختفى

90
00:06:09,840 --> 00:06:11,390
...أتيت في الوقت المناسب

91
00:06:12,540 --> 00:06:14,490
.يا أمينومورا كي-هان

92
00:06:15,200 --> 00:06:17,950
أأنتِ حقًّا غوا-سان؟

93
00:06:17,950 --> 00:06:18,890
.نعم

94
00:06:18,890 --> 00:06:22,810
يمكنك اعتبار هذا "جسدًا نجميًّا
.له كتلة"، إن صحّ التّعبير

95
00:06:22,810 --> 00:06:23,570
ماذا؟

96
00:06:23,570 --> 00:06:28,280
."ببساطة، استخدمتُ بطاقة "الإحياء ليوم واحد

97
00:06:31,680 --> 00:06:34,440
...لكن لديكِ نقاط متراكمة كثيرة

98
00:06:34,440 --> 00:06:37,030
نحتاج جميعًا إلى إجازة من
حين لآخر، أليس كذلك؟

99
00:06:37,030 --> 00:06:39,710
.ربّما معكِ حقّ

100
00:06:40,710 --> 00:06:42,880
تديرون كلّ شيء بالنّقاط، صحيح؟

101
00:06:42,880 --> 00:06:45,630
.نعم، النّقاط هي وسيلتنا في كلّ شيء

102
00:06:45,970 --> 00:06:48,460
كلّ واحد من القدماء العظماء
.يقدّر أشياء مختلفة

103
00:06:48,460 --> 00:06:50,970
.لذا يُجنّبنا هذا النّظام الخلافات

104
00:06:50,970 --> 00:06:53,180
...ما زلت لا أفهم

105
00:06:53,180 --> 00:06:54,820
.حسنًا، هيّا بنا

106
00:06:54,820 --> 00:06:56,940
!لا يمكنني إضاعة ساعاتي الأربع والعشرين

107
00:06:57,330 --> 00:06:59,570
لكن... إلى أين؟

108
00:06:59,570 --> 00:07:02,400
!في جولة تذوّق أطعمة كيوتو، بالطّبع

109
00:07:02,400 --> 00:07:06,860
ولهذا طلبتُ مجيء فوجوشي
.محبّة للتّاريخ مثلك معي

110
00:07:07,210 --> 00:07:09,070
تخرج واحدة من القدماء العظماء
في جولة أطعمة؟

111
00:07:09,070 --> 00:07:10,880
في الأرض نفسها الّتي تعزونها؟

112
00:07:10,880 --> 00:07:12,960
!هذا جنون

113
00:07:16,270 --> 00:07:17,950
.دعيني أخبرك بمعلومة صغيرة

114
00:07:18,250 --> 00:07:23,930
،"يناديني الجميع بـ"غوا
.لكنّ اسمعي الحقيقيّ هو كثوغوا

115
00:07:23,930 --> 00:07:25,080
.هكذا إذًا

116
00:07:25,080 --> 00:07:28,840
يقولون أنّ من الصّعب تذكّر اسمي
.وأنّه قريب جدًّا من اسم كثولو

117
00:07:28,840 --> 00:07:32,470
.لذلك أستخدم اسم "غوا" في الاستوديو

118
00:07:32,780 --> 00:07:35,430
.حسنًا، هذا مربك كثيرًا بالفعل

119
00:07:35,430 --> 00:07:38,730
.لكن على المستوى الكونيّ، لا فرق إطلاقًا

120
00:07:38,730 --> 00:07:42,900
لكن حين نصغّر من أنفسنا لحجم
.يناسب اليابان، تصبح الأمور معقّدة

121
00:07:43,170 --> 00:07:45,360
.حسنًا، لنأكل الآن

122
00:07:45,360 --> 00:07:47,530
.لا تقلقي بشأن المال

123
00:07:47,530 --> 00:07:50,150
.أنشأتُ حسابًا بمائة مليون ينّ قبل أن آتي

124
00:07:50,150 --> 00:07:51,510
!هذا غشّ

125
00:07:51,510 --> 00:07:53,710
.أنت تعقّدين الأمور كثيرًا

126
00:07:53,710 --> 00:07:55,250
.لنفكّر بشكل كونيّ أكثر

127
00:07:55,250 --> 00:07:57,560
لا أريد التّفكير في الأمر
...كونيًّا أيضًا، لكن

128
00:07:57,560 --> 00:08:00,250
،بما أنّنا قادرون على الحديث بهذه الطّريقة

129
00:08:00,560 --> 00:08:03,910
ألا يمكننا إقناعكم بإلغاء الغزو فحسب؟

130
00:08:05,950 --> 00:08:07,770
.لا، مستحيل

131
00:08:07,770 --> 00:08:10,340
...نحن لا نرى البشر

132
00:08:11,190 --> 00:08:13,810
.كمخلوقات متساوية معنا

133
00:08:15,120 --> 00:08:22,860
إن طلبت منك نملة تحت قدمك التّفاوض
على قدم المساواة، فهل ستفعلين؟

134
00:08:33,620 --> 00:08:35,690
نحن نلفت الانتباه، أليس كذلك؟

135
00:08:37,930 --> 00:08:40,040
.لنتظاهر أنّنا في كوميكيت

136
00:08:40,400 --> 00:08:42,360
.أنت تعرفين أشياء غريبة

137
00:08:42,360 --> 00:08:44,250
...هذا معبد

138
00:08:44,250 --> 00:08:48,390
حسنًا، لم نعد نحصل على نظرات
.غريبة كما في السّابق

139
00:08:49,660 --> 00:08:51,130
!"ابتسمي"

140
00:08:54,050 --> 00:08:55,530
!شكرًا جزيلاً

141
00:08:55,530 --> 00:08:56,770
!لا شكر على واجب

142
00:08:56,770 --> 00:08:59,940
!أرأيت؟ يظنّون أنّني شخصيّة أنمي يابانيّة

143
00:08:59,940 --> 00:09:02,200
!"أنا أُساهم في "كول جابان

144
00:09:02,200 --> 00:09:05,870
!إنّكم تغزون اليابان، ولا تساعدونها

145
00:09:14,710 --> 00:09:15,830
أهو لذيذ؟

146
00:09:15,830 --> 00:09:16,830
.نعم

147
00:09:16,830 --> 00:09:19,550
أفهم لماذا حصل على تقييم 4.2
.في غورمي-نافي

148
00:09:19,550 --> 00:09:20,890
!جيّد

149
00:09:20,890 --> 00:09:23,170
.كنت أرغب في تجربته مع أحد ما

150
00:09:23,170 --> 00:09:27,590
.يشتهي جسدي الطّعام
.كان يخصُّ مقدّمة بثوث عن الطّعام

151
00:09:27,590 --> 00:09:29,380
ما بها؟

152
00:09:29,380 --> 00:09:34,430
مقدّمة البثوث الحقيقيّة نائمة
في المستشفى، أليس كذلك؟

153
00:09:34,430 --> 00:09:36,680
.إنّها واحدة من حالات الغيبوبة الغامضة

154
00:09:36,680 --> 00:09:38,500
.في الوقت الحاليّ

155
00:09:38,500 --> 00:09:39,600
.أشعر بالشّفقة عليهم

156
00:09:39,600 --> 00:09:40,850
حقًّا؟

157
00:09:40,850 --> 00:09:43,100
...تخيَّلي لو كانت برغوثة تحت قدمك

158
00:09:43,100 --> 00:09:44,860
.ناقشنا هذا مسبقًا

159
00:09:45,740 --> 00:09:48,950
أتمنّى لو كان الآخرون قادرين
.على تذوّق هذا أيضًا

160
00:09:48,950 --> 00:09:50,570
الآخرون"؟"

161
00:09:50,570 --> 00:09:53,070
ألم أذكر ذلك؟

162
00:09:58,930 --> 00:10:00,120
مايو...؟

163
00:10:00,120 --> 00:10:01,660
ماذا؟

164
00:10:01,660 --> 00:10:04,080
هل سَحَرك جمالي؟

165
00:10:04,080 --> 00:10:05,510
...عفوًا

166
00:10:05,510 --> 00:10:07,510
.نحن متفاجئتان فحسب

167
00:10:08,420 --> 00:10:12,010
!ما الّذي تفعلينه أنت هنا؟

168
00:10:23,030 --> 00:10:24,690
ما الّذي يحدث؟

169
00:10:24,690 --> 00:10:27,620
هل بدأت بغزو عالمنا بالفعل؟

170
00:10:27,620 --> 00:10:28,730
.لا فكرة لديّ

171
00:10:28,730 --> 00:10:31,650
.لا أعلم ما يدور في أذهان الأخاطب

172
00:10:31,650 --> 00:10:35,070
.يا لها من مدينة نابضة بالحياة، رغم صِغَرها

173
00:10:35,070 --> 00:10:37,120
.نعتذر على ذلك أيّتها الأميرة

174
00:10:37,120 --> 00:10:39,050
.إنّها تذكّرني بريليه

175
00:10:39,050 --> 00:10:44,120
...كان هنالك الكثير من المعبودين أيضًا
.لكن من نوع مختلف

176
00:10:44,120 --> 00:10:47,280
كيف كانت المدن في عصور ما قبل التّاريخ؟

177
00:10:47,280 --> 00:10:49,180
هل كانت مريحة فعلاً؟

178
00:10:49,180 --> 00:10:50,390
.لا تسأليني

179
00:10:51,400 --> 00:10:52,920
.كم هذا لذيذ

180
00:10:52,920 --> 00:10:54,330
.أخطبوط تأكل أخطبوط

181
00:10:54,330 --> 00:10:55,760
.هذه لك

182
00:10:55,760 --> 00:10:58,030
...شـ-شكرًا

183
00:11:00,310 --> 00:11:01,600
أهي لذيذة؟

184
00:11:01,880 --> 00:11:02,900
!اللّعنة

185
00:11:02,900 --> 00:11:05,560
!إنّها تستخدم جسد مايو فقط

186
00:11:05,560 --> 00:11:06,900
.وهذه لك أيضًا

187
00:11:06,900 --> 00:11:08,990
!لا تُناوليها لي بمجسّاتك

188
00:11:08,990 --> 00:11:10,190
!قد يراك النّاس

189
00:11:11,590 --> 00:11:15,130
.صحيح، فهذا الجسد النّجميّ بلا قدرات قتاليّة

190
00:11:15,130 --> 00:11:16,820
.يجب ألاّ أُلفت الأنظار إليّ

191
00:11:16,820 --> 00:11:20,620
هل تعرفين ما هو "جسد نجميّ ذو كتلة"؟

192
00:11:20,620 --> 00:11:22,040
.لا

193
00:11:26,520 --> 00:11:29,170
!لم يكن لدى المُويّين أيًّا من هذه الأشياء

194
00:11:29,170 --> 00:11:30,660
!إنّها ظريفة

195
00:11:30,660 --> 00:11:31,880
!لكنّها عدوّتي

196
00:11:45,950 --> 00:11:47,240
.رائع، رائع

197
00:11:47,240 --> 00:11:49,700
.كلّ شيء أرتديه يليق بي

198
00:11:49,700 --> 00:11:53,160
.لم يكن لديكِ جسد بشريّ أصلاً

199
00:11:53,160 --> 00:11:54,960
.هذا صحيح

200
00:11:54,960 --> 00:11:57,610
.أعتقد أنّني اعتدت على هذا الجسد

201
00:11:57,610 --> 00:11:59,320
.صرتُ متعلّقة به

202
00:11:59,320 --> 00:12:00,910
.أفضّل أن تتركيه

203
00:12:00,910 --> 00:12:03,210
.لا تقولي ذلك أيّتها البشريّة

204
00:12:03,210 --> 00:12:06,190
.من الممتع امتلاك جسد

205
00:12:06,190 --> 00:12:10,380
لا أطيق الانتظار للعودة بالكامل
!للحياة وجلب الرّعب للعالم

206
00:12:10,380 --> 00:12:13,500
!لا أعرف ماذا تتوقّعين أن نردّ على ذلك

207
00:12:13,500 --> 00:12:18,230
ولكي أفعل ذلك، يجب أن أجلب
!لكم المزيد من اليأس

208
00:12:18,230 --> 00:12:20,110
.أنتِ مجنونة

209
00:12:22,060 --> 00:12:23,790
.اليوم يوم عطلتنا

210
00:12:23,790 --> 00:12:26,730
!سأتحدّاك في إحدى ألعابكم البشريّة الوضيعة

211
00:12:26,730 --> 00:12:28,560
!أتظنّين أنّكِ ستفوزين؟

212
00:12:33,360 --> 00:12:35,090
!هذا غير عادل أيّتها الأخطبوط

213
00:12:35,090 --> 00:12:36,180
!لستُ أخطبوطًا

214
00:12:36,180 --> 00:12:38,050
!أنا كثولو العظيمة

215
00:12:38,050 --> 00:12:39,320
!سُحقًا

216
00:12:43,750 --> 00:12:46,750
...بدأ جسدي النّجميّ يفقد طاقته

217
00:12:46,750 --> 00:12:49,460
.نلت منك... النّصر لي

218
00:12:50,360 --> 00:12:52,420
.لا يهمّني من يفوز من الأساس

219
00:12:56,230 --> 00:12:58,130
!ما هذا؟! الأمر محرج

220
00:12:58,130 --> 00:13:01,510
.لم أقم بهذا منذ مدّة، لذلك تحمّستُ قليلاً

221
00:13:01,880 --> 00:13:05,530
،كان لِعرق ييث العظيم العديد من الاختراعات

222
00:13:05,530 --> 00:13:08,000
.لكنّهم لم يخترعوا هذا

223
00:13:08,000 --> 00:13:10,710
.لم يعرفوا كيف يمرحون

224
00:13:11,670 --> 00:13:14,230
!هذا البلد رائع

225
00:13:15,440 --> 00:13:16,820
ما بكِ؟

226
00:13:16,820 --> 00:13:20,440
أنت واحدة من القدماء العظماء
!والغازين، لكنّك ظريفة

227
00:13:20,440 --> 00:13:22,250
!هكذا هي أنا

228
00:13:22,250 --> 00:13:24,950
!تـ-تزداد فسادًا كلّ لحظة

229
00:13:24,950 --> 00:13:26,990
!أظنّ أنّه يمكننا هزيمتها لاحقًا

230
00:13:26,990 --> 00:13:28,200
.لن يحدث ذلك

231
00:13:28,580 --> 00:13:31,660
حسنًا، أفهم أنّك استعملت تذكرتك
.للعودة للحياة ليوم واحد

232
00:13:31,660 --> 00:13:33,790
لكن لماذا أتيتِ حقًّا؟

233
00:13:39,230 --> 00:13:42,970
وهكذا، يمكننا أن نتوقّع تركيزًا
أكبر في المستقبل

234
00:13:42,970 --> 00:13:48,850
على حلول مستدامة ومخاطر
.مضمونة للطّلب الوافد

235
00:13:48,850 --> 00:13:50,190
.فهمت

236
00:13:50,190 --> 00:13:56,390
إذًا سيتعيّن على القدماء العظماء
.الّذين لا يتغيّرون تقبُّل التّنوّع

237
00:13:56,390 --> 00:13:57,940
.هذا كلام جيّد

238
00:13:57,940 --> 00:14:00,530
...عفوًا، إنّ قناعك

239
00:14:00,530 --> 00:14:04,490
.صحيح. هذا يُعتبر وقاحة هنا

240
00:14:04,490 --> 00:14:05,690
!حسنًا

241
00:14:09,450 --> 00:14:11,410
!إنّه وسيم جدًّا

242
00:14:11,700 --> 00:14:15,190
.أعتذر. واصل المحاضرة

243
00:14:19,670 --> 00:14:21,750
!كلّ هذا على حسابي

244
00:14:21,750 --> 00:14:23,130
!اشربوا! اشربوا

245
00:14:23,400 --> 00:14:24,710
من هذا الرّجل؟

246
00:14:24,710 --> 00:14:27,760
.أعتقد أنّه أحد كبار مقدّمي البثوث المباشرة

247
00:14:27,760 --> 00:14:30,000
سمعتم عن مقدّمي البثوث أولئك، صحيح؟

248
00:14:30,000 --> 00:14:31,860
.لم يعد أحد يشاهد التّلفاز بعد الآن

249
00:14:31,860 --> 00:14:32,850
!صحيح تمامًا

250
00:14:32,850 --> 00:14:33,750
!يا هؤلاء

251
00:14:33,750 --> 00:14:34,900
هل شاهدتم ذلك؟

252
00:14:34,900 --> 00:14:35,900
ذلك"؟"

253
00:14:35,900 --> 00:14:39,520
!عرض الرّعب الكونيّ! عرض الرّعب

254
00:14:41,030 --> 00:14:42,690
ماذا؟

255
00:14:44,990 --> 00:14:47,120
تبًّا... ألم يشاهده أحد؟

256
00:14:47,120 --> 00:14:49,120
!أعتقد أنّي شاهدتُه

257
00:14:49,120 --> 00:14:52,130
كان ذلك العرض الّذي يصرخ فيه مقدّمو
.البثوث على بعضهم. مسابقة الأسئلة

258
00:14:52,130 --> 00:14:54,390
.تحدّثت عنه الأخبار

259
00:14:54,390 --> 00:14:56,040
.كان النّاس يتساءلون إن كان حقيقيًّا

260
00:14:56,040 --> 00:14:58,630
!إذًا، أحدكم على الأقلّ له فائدة

261
00:14:58,630 --> 00:15:00,470
!نعم، هذا هو

262
00:15:00,470 --> 00:15:02,660
!أنا المنتج

263
00:15:02,660 --> 00:15:05,120
.فعلاً؟ هذا مذهل

264
00:15:05,120 --> 00:15:08,180
.جئت لإجراء بعض الأبحاث في السّوق اليوم

265
00:15:08,180 --> 00:15:10,860
.نعم. عرض الرّعب رائع فعلاً

266
00:15:10,860 --> 00:15:13,140
!لا أطيق الانتظار للحلقة القادمة

267
00:15:13,140 --> 00:15:14,950
فعلاً؟ فعلاً؟

268
00:15:14,950 --> 00:15:17,770
!تأكّدوا من الإعجاب والاشتراك يا رفاق

269
00:15:17,770 --> 00:15:21,450
!حسنًا، لنفتح زجاجة شامبانيا أخرى

270
00:15:22,740 --> 00:15:24,010
...هؤلاء

271
00:15:24,010 --> 00:15:25,680
.لم يشاهدوه

272
00:15:32,010 --> 00:15:33,700
.إنّها ظريفة

273
00:15:33,970 --> 00:15:36,670
.هذا ما أتوقّع من الجسد الّذي اخترته

274
00:15:36,670 --> 00:15:38,170
هل أنت راضية؟

275
00:15:38,710 --> 00:15:40,130
.أنت تسخرين منها

276
00:15:40,600 --> 00:15:41,580
ماذا؟

277
00:15:41,860 --> 00:15:44,640
.ما زالت نائمة هكذا بسببك

278
00:15:44,640 --> 00:15:47,420
أنت تعرفين هذا، فلماذا أتيت لرؤيتها؟

279
00:15:48,320 --> 00:15:50,840
.بدافع الفضول على ما أظنّ

280
00:15:51,300 --> 00:15:52,910
.كورونو ميكو

281
00:15:52,910 --> 00:15:57,680
أشعر فيكِ بقوّة غريبة
.لا يمتلكها البشر الآخرون

282
00:15:57,680 --> 00:16:00,360
.مستوى سلامتك العقليّة لا ينخفض كثيرًا

283
00:16:00,360 --> 00:16:03,520
.مصدر هذه القوّة موجود خارجك

284
00:16:03,520 --> 00:16:08,620
إنّه شيء تعتبرينه أهمّ من
.جسدك... أو حتّى من روحك

285
00:16:09,380 --> 00:16:12,580
وهذا الشّيء هو هي، أليس كذلك؟

286
00:16:12,990 --> 00:16:17,050
.لهذا يمكنكِ مواجهتي رغم صغر حجمك

287
00:16:17,050 --> 00:16:18,950
.أمر مثير للاهتمام

288
00:16:22,820 --> 00:16:26,460
.يمنح ضوء القمر القوّة للأشياء الشّرّيرة

289
00:16:26,460 --> 00:16:31,430
لا أطيق الانتظار حتّى استعادة
.جسدي الحقيقيّ وغمره به

290
00:16:31,430 --> 00:16:33,240
ما بالك؟

291
00:16:33,240 --> 00:16:34,840
أنجزتِ ما جئتِ لأجله، صحيح؟

292
00:16:34,840 --> 00:16:36,560
.ارجعي إلى الواقع الافتراضيّ

293
00:16:36,560 --> 00:16:38,420
.كورونو ميكو

294
00:16:38,420 --> 00:16:39,510
ماذا؟

295
00:16:40,020 --> 00:16:46,800
هذا الجسد المؤقّت... روح
...مايوساكا مايو الّتي تحبّين

296
00:16:46,800 --> 00:16:50,240
.يقول لي أنّه يريد أن يكون معك

297
00:16:51,700 --> 00:16:55,850
عشت لعشرات الآلاف من السّنين
،كأحد القدماء العظماء

298
00:16:55,850 --> 00:16:57,420
.ولم يحدث شيء كهذا من قبل

299
00:16:58,080 --> 00:17:00,170
.لا زلت لا أعرف كيف أشعر حيال ذلك

300
00:17:01,320 --> 00:17:04,430
هل هذا قلب مايوساكا مايو
يتحرّك في داخلي؟

301
00:17:04,430 --> 00:17:06,000
أم أنّه قلبي أنا؟

302
00:17:06,000 --> 00:17:07,710
—لا تسألـ

303
00:17:17,600 --> 00:17:19,260
!ما الّذي تفعلينه؟

304
00:17:19,260 --> 00:17:20,820
.رائع، رائع

305
00:17:20,820 --> 00:17:24,110
.ربّما لم يعد للحدود بين الأفراد أهمّيّة

306
00:17:24,110 --> 00:17:30,320
يمكنني الشّعور برغبة عميقة
.نحوها في روحك أيضًا

307
00:17:30,320 --> 00:17:33,780
!لا تتطفّلي على مشاعري

308
00:17:34,140 --> 00:17:36,160
.تمنّيتُ الشّيء ذاته

309
00:17:36,160 --> 00:17:37,990
.لا بأس في ذلك

310
00:17:40,460 --> 00:17:41,920
!ابتعدي عنّي

311
00:17:43,120 --> 00:17:45,750
.الآن أنجزت ما جئت لأجله

312
00:17:45,750 --> 00:17:48,340
.استمتعتُ أيّتها البشريّة

313
00:17:48,790 --> 00:17:50,650
...كثولو

314
00:17:52,550 --> 00:17:56,020
كيف تجرئين على العبث
!بمشاعري ومشاعر مايو؟

315
00:17:58,550 --> 00:18:02,230
.سأهزمك. أقسم بذلك

316
00:18:02,820 --> 00:18:05,690
!لا يهمني إن كنتِ من القدماء العظماء

317
00:18:05,690 --> 00:18:09,820
،حتّى إن استحال جسدي إلى غبار

318
00:18:09,820 --> 00:18:12,400
...سأطاردك

319
00:18:13,300 --> 00:18:14,390
!وسأقتلك

320
00:18:14,860 --> 00:18:16,590
!هذه هي

321
00:18:16,590 --> 00:18:19,580
!هذه هي أكثر التّعابير الّتي أحبّ فيك

322
00:18:19,580 --> 00:18:22,010
.سعيدة لأنّنا التقينا اللّيلة

323
00:18:22,010 --> 00:18:23,480
.مع السّلامة

324
00:18:24,040 --> 00:18:28,170
!كثولو

325
00:19:02,310 --> 00:19:04,000
.يبدو أن الأمر قد بدأ

326
00:19:04,000 --> 00:19:05,350
...والآن

327
00:19:05,350 --> 00:19:08,320
.أتمنّى لو يمنحني الفاتيكان إجازة يومًا ما

328
00:19:15,060 --> 00:19:16,260
.شكرًا على الوجبة

329
00:19:31,190 --> 00:19:32,650
.التّحقّق من السّلامة العقليّة

330
00:19:34,680 --> 00:19:35,750
.جيّد

331
00:19:35,750 --> 00:19:37,010
.استعداد

332
00:19:37,670 --> 00:19:38,620
!لنبدأ

333
00:19:42,150 --> 00:19:43,540
!تمّ الفحص

334
00:19:57,210 --> 00:19:58,470
...هذه

335
00:19:59,320 --> 00:20:00,680
!كيوتو

336
00:20:00,680 --> 00:20:04,390
!نعم، أهلاً بكم في كيوتو الافتراضيّة

337
00:20:04,390 --> 00:20:08,850
.كي-هان، استمتعتُ برحلتنا الأخيرة إلى كيوتو

338
00:20:08,850 --> 00:20:10,990
ذهبتِ معها إلى كيوتو؟

339
00:20:10,990 --> 00:20:12,440
...نـ-نعم

340
00:20:12,940 --> 00:20:18,380
في الواقع، جزء من الرّحلة كان
.لاستكشاف مواقع اللّعبة القادمة

341
00:20:18,380 --> 00:20:21,280
!والآن، أمعنوا النّظر إلى ابتكاري

342
00:20:29,990 --> 00:20:33,300
أيّها المحاربون الشّجعان
...الّذين نجوا حتّى الآن

343
00:20:33,300 --> 00:20:37,340
لدينا اليوم لعبة دفاع عن برج
!من تصميم غوا-دونو

344
00:20:37,340 --> 00:20:40,830
مِن تلك الألعاب الّتي ندافع فيها
عن قاعدة ضدّ أعداء؟

345
00:20:40,830 --> 00:20:43,070
!يبدو أنّنا لن نضطرّ للتّفكير كثيرًا

346
00:20:43,070 --> 00:20:43,970
!نعم

347
00:20:43,970 --> 00:20:45,720
.لا أظنّ أنّ الأمر بهذه البساطة

348
00:20:45,720 --> 00:20:47,350
عفوًا، هلّي بالكلام؟

349
00:20:47,350 --> 00:20:49,060
ما المشكلة؟

350
00:20:49,060 --> 00:20:52,150
.يبدو أنّ أحد اللاّعبين مفقود

351
00:20:52,150 --> 00:20:53,820
...نعم

352
00:20:53,820 --> 00:20:56,110
.لديّ شعور أنّنا لن نُسرّ بالسّبب

353
00:20:56,110 --> 00:20:58,190
هذا ما تقصدين؟

354
00:20:58,190 --> 00:20:59,560
...في الحقيقة

355
00:21:00,660 --> 00:21:03,950
.انسحب إيتا من اللّعبة

356
00:21:03,950 --> 00:21:05,370
!ماذا؟

357
00:21:05,370 --> 00:21:07,700
.واثق أنّه يملك سببًا وجيهًا

358
00:21:07,700 --> 00:21:10,330
هل يمكننا الانسحاب بالفعل؟

359
00:21:10,330 --> 00:21:13,050
كان هنالك الكثير من الأشخاص
.الغاضبين منه أيضًا

360
00:21:13,050 --> 00:21:16,040
أيُعقل أنّه قتله نفسه؟

361
00:21:16,800 --> 00:21:21,760
.هذا... خارج سيطرتنا

362
00:21:22,100 --> 00:21:23,470
...أنت

363
00:21:23,470 --> 00:21:25,990
!ستكون لعبة اليوم بأربعة لاعبين

364
00:21:25,990 --> 00:21:29,600
.وهناك شيء عليّ أن أخبركم به قبل أن نبدأ

365
00:21:29,600 --> 00:21:31,810
.وهذه إشارتي لأدخل

366
00:21:33,530 --> 00:21:36,480
.تقدّم... أيّها المحارب آكل النّجوم

367
00:21:36,860 --> 00:21:37,790
ماذا؟

368
00:21:37,790 --> 00:21:39,190
محارب"؟"

369
00:21:43,120 --> 00:21:47,080
.يشتهي قمر كيوتو الدّم اللّيلة

370
00:21:47,080 --> 00:21:48,160
...أنت

371
00:21:48,160 --> 00:21:49,630
!إيتا-كُن؟

372
00:21:49,630 --> 00:21:51,750
!لا أعرف أيّ بشريّ بهذا الاسم

373
00:21:51,750 --> 00:21:54,000
،أنا النّجم الأحمر المشؤوم

374
00:21:54,000 --> 00:21:55,460
.المحارب آكل النّجوم

375
00:21:55,460 --> 00:21:56,880
!ألديباران

376
00:21:58,710 --> 00:22:00,920
!إيتا

377
00:22:00,920 --> 00:22:02,490
.قاعدة جديدة

378
00:22:02,490 --> 00:22:04,100
.إنّه المحارب آكل النّجوم

379
00:22:04,100 --> 00:22:08,890
بدءًا من هذه اللّعبة، سيقاتلكم
!نيابة عن القدماء العظماء

380
00:22:09,200 --> 00:22:10,600
!ماذا؟