1
00:00:00,870 --> 00:00:04,820
!إنّهم شياطين! الشّياطين موجودين فعلاً

2
00:00:04,820 --> 00:00:08,810
كما تعلمون جميعًا، سبب الدّمار
الّذي لحق بكيوتو

3
00:00:08,810 --> 00:00:13,500
كان جرّاء لعبة شرّيرة يديرها
!هؤلاء الشّياطين

4
00:00:13,500 --> 00:00:18,630
!والأسوأ من ذلك هو أنّهم يبثّونها

5
00:00:18,630 --> 00:00:22,370
!ولم يظنّ أحد أنّها حقيقيّة

6
00:00:22,380 --> 00:00:25,440
!كانت الحكومة تتستّر على الحقيقة

7
00:00:25,440 --> 00:00:29,710
كنّا الوحيدين الّذين عرفنا
!بهذا التّهديد من البداية

8
00:00:29,710 --> 00:00:31,020
...إنّ هذا

9
00:00:30,100 --> 00:00:31,550
.مهلاً لحظة

10
00:00:36,380 --> 00:00:40,430
.اسمعوا جميعًا، إنّهم ليسوا شياطين

11
00:00:40,430 --> 00:00:43,810
إنّهم كائنات قويّة وُجدت
...منذ قديم الزّمان

12
00:00:44,070 --> 00:00:47,280
.إنّهم القدماء العظماء

13
00:00:47,280 --> 00:00:49,090
!ومن تكون أنت؟

14
00:00:50,180 --> 00:00:54,470
أنا واحد من اللاّعبين النّاجين
!من ألعاب القدماء العظماء

15
00:00:57,110 --> 00:00:58,700
!مـ-مهلاً

16
00:00:58,700 --> 00:01:00,010
ماذا؟

17
00:01:00,010 --> 00:01:01,040
ما الّذي يحدث؟

18
00:01:02,730 --> 00:01:06,250
.أتيتُ لمساعدتكم جميعًا

19
00:01:06,570 --> 00:01:08,980
.يوشك العالم أن يُدمَّر

20
00:01:08,980 --> 00:01:12,950
!لكنّي سأخبركم كيف تنجون

21
00:02:46,360 --> 00:02:51,980
،يقول البعض أنّها نهاية العالم
.بينما يقول آخرون أنّه عقاب إلهيّ

22
00:02:52,360 --> 00:02:56,110
بدأت أعمال الشّغب في الحدوث
،في خضمّ هذه الفوضى

23
00:02:56,110 --> 00:03:00,410
وتأخذ الشّرطة إجراءات أمنيّة
.متقدّمة في بعض الأحياء

24
00:03:01,180 --> 00:03:06,790
تطلب الحكومة من الشّعب البقاء
...في منازلهم إلاّ إن دعت الضّرورة

25
00:03:08,460 --> 00:03:09,790
...هل أنت هو

26
00:03:10,440 --> 00:03:15,510
الشّخص الّذي أرسل لي رسالة
مع غراب وتُدعى جو-سان؟

27
00:03:16,230 --> 00:03:18,590
.سوبا كروكيت، بدون بصل أخضر

28
00:03:21,770 --> 00:03:25,140
أنا مدير فرع اليابان لمكتب الفاتيكان
،للتّحقيقات الخارقة للطّبيعة

29
00:03:25,140 --> 00:03:26,270
.هانتر جو

30
00:03:29,500 --> 00:03:32,380
،"مع أنّي قلتُ "مدير
.إلاّ أنّي الوحيد في الفرع

31
00:03:32,380 --> 00:03:35,440
،فكما هو الحال في العالم
.ينقصنا التّمويل المادّيّ هذه الأيّام

32
00:03:35,440 --> 00:03:38,680
.إنّك تمزح فحسب. سأعود للمنزل

33
00:03:39,130 --> 00:03:45,960
عرفنا من البداية أنّك كنت
.تعملين مع الآلهة الخارجيّين

34
00:03:45,960 --> 00:03:48,860
.نعرف أنّك خرجتِ في نزهة طعام في كيوتو

35
00:03:48,860 --> 00:03:54,550
وأنّك بلا عمل حاليًّا، بعد أنّ طردتك
.الشّركة البارحة لإبعاد إلقاء اللّوم عليهم

36
00:03:54,550 --> 00:03:56,720
عـ-عمّ تتحدّث؟

37
00:03:56,720 --> 00:03:58,200
!سأتّصل بالشّرطة

38
00:03:58,200 --> 00:04:02,940
تعرفين أكثر من غيرك كم
.أنّ الشّرطة بلا حول ولا قوّة

39
00:04:03,260 --> 00:04:04,540
صحيح؟

40
00:04:05,990 --> 00:04:10,650
.لن أتظاهر أنّي بطل من نوع ما

41
00:04:10,650 --> 00:04:14,690
لكنّي لستُ عدوّكم، أنا الفرصة
.الوحيدة أمامكم لقتالهم

42
00:04:15,580 --> 00:04:17,530
هناك طريقة لقتالهم؟

43
00:04:17,860 --> 00:04:20,980
من الآن فصاعدًا، ستقومين
.بما أخبرك به بالضّبط

44
00:04:20,980 --> 00:04:23,160
.قولك لذلك فظّ للغاية

45
00:04:23,160 --> 00:04:27,370
.أنا آسف. لا أجيد الحديث مع النّساء

46
00:04:27,370 --> 00:04:29,770
ما-ما خطب هذا الرّجل؟

47
00:04:31,230 --> 00:04:35,560
بالمناسبة، هناك أمر بخصوص هذه
.القضيّة مثير للقلق بشكل استثنائيّ

48
00:04:36,390 --> 00:04:37,650
وما هو؟

49
00:04:37,650 --> 00:04:40,500
.إنّها حقيقة أنّ العدوّ يوجد في العالم الرّقميّ

50
00:04:40,500 --> 00:04:43,350
لأنّ من الصّعب مقاتلة عدوّ
ليس له جسد مادّيّ؟

51
00:04:43,350 --> 00:04:46,430
.لا، لأنّي أجهل استعمال الحواسيب

52
00:04:47,410 --> 00:04:49,180
ألذلك السّبب أرسلت رسالة مختومة؟

53
00:04:49,180 --> 00:04:51,660
كيف تنجز أيّ شيء هذه الأيّام؟

54
00:04:51,660 --> 00:04:54,860
...أستطيع استعمال الهاتف
!وآلات الفاكس أيضًا

55
00:04:54,860 --> 00:04:56,900
أيّ نوع من محقّقي خوارق الطّبيعة تكون؟

56
00:04:56,900 --> 00:05:01,120
فهمت الآن! لهذا السّبب لم تقم
!بأيّ شيء حتّى الآن

57
00:05:01,120 --> 00:05:02,740
!مذهل! أنت ذكيّة

58
00:05:02,740 --> 00:05:05,040
!لا تحاول الثّناء عليّ

59
00:05:05,040 --> 00:05:06,540
!ما مشكلتك على أيّ حال؟

60
00:05:06,540 --> 00:05:11,690
اسمعي، إن كنتم تريدون قتال
.القدماء العظماء، فستحتاجون لمساعدتي

61
00:05:11,690 --> 00:05:13,290
.أنا لا أثق بك

62
00:05:13,290 --> 00:05:16,080
.كما أنّ هندامك يوحي كأنّك منحرف من نوع ما

63
00:05:16,080 --> 00:05:18,390
.لا أريد أن يرانا أيّ أحد معًا

64
00:05:26,120 --> 00:05:27,180
...لذلك ببساطة

65
00:05:27,180 --> 00:05:32,900
،كلّ اللاّعبين أشخاص بماضٍ صعب
.مثل القتل أو العنف المنزليّ

66
00:05:32,900 --> 00:05:35,530
،بالنّسبة لنا نحن المواطنين الصّالحين

67
00:05:35,530 --> 00:05:38,880
ليس من العادل أن نعهد بالعالم
!لأشخاص مثلهم

68
00:05:38,880 --> 00:05:41,840
!إنّهم لا يعرفون ما الّذي يتحدّثون عنه

69
00:05:41,840 --> 00:05:43,610
.أطفئي هذا الهراء فحسب

70
00:05:47,440 --> 00:05:48,950
قناة تلفزيّة؟

71
00:05:48,950 --> 00:05:51,710
كيف عثرتم على هذا المكان؟

72
00:05:51,710 --> 00:05:55,460
الأمر ليس كذلك، إنّ وجوههم
.منتشرة في كلّ مكان بعد البثّ

73
00:05:55,460 --> 00:05:57,420
.كان من المستحيل أن يظلّوا مختبئين

74
00:05:57,420 --> 00:06:01,170
.إنّنا نريد مساعدة ميكو-سان وكانّا-سان فحسب

75
00:06:01,170 --> 00:06:03,190
تعرفون بأمر كانّا أيضًا؟

76
00:06:03,190 --> 00:06:05,490
إنّهما في مشكلة الآن، صحيح؟

77
00:06:05,490 --> 00:06:07,970
.يتمّ معاملتهما الآن كمجرمي الحروب

78
00:06:08,440 --> 00:06:10,980
.لا تتحدّث عنهما بهذه الطّريقة

79
00:06:10,980 --> 00:06:12,560
.أعتذر على ذلك

80
00:06:12,560 --> 00:06:15,060
.لكنّنا لن نعاملهما هكذا

81
00:06:15,060 --> 00:06:19,400
،سنظهرهما على حقيقتهما ببساطة
.بطلتان تريدان إنقاذ عالمنا

82
00:06:19,660 --> 00:06:21,500
.لا أظنّ أنّي أثق بك

83
00:06:21,500 --> 00:06:23,900
لا أحبّ الطّريقة الّتي يكذب بها
.التّلفاز على النّاس

84
00:06:23,900 --> 00:06:26,530
.نسمع هذا الكلام كثيرًا

85
00:06:27,670 --> 00:06:28,370
...ماما

86
00:06:29,060 --> 00:06:30,330
.لا أمانع ذلك

87
00:06:30,330 --> 00:06:31,680
ميكو؟

88
00:06:31,680 --> 00:06:34,190
.إنّ الاختباء للأبد سيكون كئيبًا جدًّا

89
00:06:34,790 --> 00:06:36,790
إذًا فقد قرأت رسائلي الإلكترونيّة؟

90
00:06:36,790 --> 00:06:38,750
كاغورازاكا كانّا-سان؟

91
00:06:38,750 --> 00:06:41,800
.ماذا؟ أنا؟ نعم

92
00:06:41,800 --> 00:06:47,070
،لا أستطيع مواصلة الاختباء هنا
.وإلاّ تسبّبت بالمشاكل لميكو وماما

93
00:06:47,070 --> 00:06:50,940
وذكرت الرّسالة أنّكم ستقدّمون
.حراسة لنا لإبقائنا في أمان

94
00:06:50,940 --> 00:06:52,300
ذلك صحيح، أليس كذلك؟

95
00:06:52,300 --> 00:06:53,690
.نعم، نعم

96
00:06:53,690 --> 00:06:59,020
أنتما من أشهر الأشخاص في العالم
.الآن، وسنعاملكما على ذلك الأساس

97
00:06:59,020 --> 00:07:01,940
ميكو، أواثقة من رغبتك
في الظّهور على التّلفاز؟

98
00:07:01,940 --> 00:07:04,440
.يبدو ذلك ممتعًا

99
00:07:04,440 --> 00:07:07,100
.كما أنّهم قالوا أنّهم سيريحونني من كانّا

100
00:07:07,100 --> 00:07:09,280
!لا تصفي الأمر كذلك

101
00:07:11,310 --> 00:07:16,620
حسنًا إذًا. سنضع كاميرا على
.كانّا-سان على مدار 24 ساعة

102
00:07:16,620 --> 00:07:18,060
.وأنتِ أيضًا يا ميكو-سان

103
00:07:18,060 --> 00:07:19,150
.لا بأس

104
00:07:19,150 --> 00:07:22,510
لكنّك لا تبدو قلقًا كثيرًا، نظرًا إلى أنّ
.هذه قد تكون الأيّام الأخيرة للأرض

105
00:07:22,510 --> 00:07:24,720
ماذا؟ أتظنّين أنّ هذا سيحدث حقًّا؟

106
00:07:24,720 --> 00:07:27,430
شاهدت بثّ القدماء العظماء
وقرّرت فعل هذا، صحيح؟

107
00:07:27,430 --> 00:07:30,810
.نعم، في الواقع لا يهمّني أمر الأرض كثيرًا

108
00:07:30,810 --> 00:07:33,560
.ما يهمّني أكثر هو صنع عرض جيّد

109
00:07:33,560 --> 00:07:35,900
.حسنًا، ربّما هكذا تسير الأمور

110
00:07:35,900 --> 00:07:39,770
شاركت في الألعاب بنفسي، ومع
.ذلك ما زال الأمر لا يبدو حقيقيًّا لي

111
00:07:40,360 --> 00:07:41,910
.صحيح

112
00:07:42,270 --> 00:07:45,110
ولكن، ما أخبار الآخرين؟

113
00:07:45,560 --> 00:07:46,880
مثل كي-سان؟

114
00:07:46,880 --> 00:07:51,350
.نعم، وسيشيرو-سان أيضًا
.آمل أن يكونا بخير

115
00:07:51,350 --> 00:07:53,870
.سيكونان بخير. كلاهما أقوى منك

116
00:07:53,870 --> 00:07:55,940
ماذا قلت؟

117
00:07:55,940 --> 00:07:57,960
.واثقة أنّهما بارعان في البقاء مختبئين

118
00:07:58,220 --> 00:08:03,670
أصدرت شركة ميغالوكس بيانًا بأنّ جهاز
.الواقع الافتراضيّ خاصّتهم لا علاقة له بهذا

119
00:08:03,670 --> 00:08:05,630
.إنّهم يتهرّبون من المسؤوليّة فحسب

120
00:08:05,630 --> 00:08:06,910
.نعم

121
00:08:06,910 --> 00:08:10,900
،لكن حتّى لو أثار النّاس ضجّة
.لا يغيّر ذلك شيئًا أبدًا

122
00:08:10,900 --> 00:08:15,430
هل يمكنكما أن تتذكّرا كلّ فضائح
المشاهير من بضعة أشهر مضت؟

123
00:08:15,430 --> 00:08:18,230
لا يمكنكما، أليس كذلك؟
.هكذا تسير الأمور دائمًا

124
00:08:18,230 --> 00:08:20,870
هل هذا شيء ينبغي لشخص
يعمل في التّلفاز أن يقوله؟

125
00:08:21,320 --> 00:08:23,280
.أنا لست صحفيًّا على أيّة حال

126
00:08:23,280 --> 00:08:27,060
...لكنّ الأرض قد تهلك بسبب هذا

127
00:08:27,060 --> 00:08:29,240
.أعتقد أنّ الأمر لا يهمّ

128
00:08:29,710 --> 00:08:32,670
،نعم، أعني إذا حدث ذلك
فلن يهمّ أيّ شيء، صحيح؟

129
00:08:32,670 --> 00:08:34,580
،إن أُبيدت البشريّة

130
00:08:34,580 --> 00:08:39,750
فكلّ الأمور الجيّدة والسّيّئة
.لن يكون لها أيّ معنى بعد الآن

131
00:08:39,750 --> 00:08:41,400
.نعم

132
00:08:42,580 --> 00:08:43,750
...ولكن يا كانّا

133
00:08:45,260 --> 00:08:49,890
ألا يثير غضبك أن يعاملوك كدمية
،لتسلية أولئك الأوغاد المقزّزين

134
00:08:49,890 --> 00:08:52,720
ثُمّ يُتوقّع منك الاستسلام بهدوء إذا خسرتِ؟

135
00:08:53,000 --> 00:08:56,310
.هذا صحيح... لديك هدفك الخاصّ

136
00:09:03,320 --> 00:09:04,710
.أعتقد ذلك

137
00:09:06,490 --> 00:09:09,650
.توشك اللّعبة الأخيرة أن تبدأ

138
00:09:09,650 --> 00:09:12,110
.لكن ليس للبشريّة أيّ أمل

139
00:09:12,890 --> 00:09:16,040
.اللّعبة مجرّد طقس، مجرّد إجراء شكليّ

140
00:09:16,040 --> 00:09:20,000
!كانت البشريّة هالكة منذ البداية

141
00:09:21,950 --> 00:09:24,160
!إيتا-سينسي

142
00:09:24,160 --> 00:09:27,090
.لكنّني رأيت عالم القدماء العظماء

143
00:09:27,090 --> 00:09:29,760
.تقبّلتُ محبّة هاستر

144
00:09:29,760 --> 00:09:33,640
إذا عبدتم القدماء العظماء وتقبّلتم
!محبّتهم، يمكنكم تجنّب الموت

145
00:09:33,640 --> 00:09:37,240
!تعالوا معي إن أردتم النّجاة

146
00:09:37,890 --> 00:09:46,540
!إيا! إيا! هاستر

147
00:09:47,680 --> 00:09:51,570
لماذا يردّدون جميعًا اسمك
.أنتَ يا هاستر؟ هذا ليس ممتعًا

148
00:09:51,570 --> 00:09:55,870
مهلاً، لا تغضبي منّي. إنّه مجرّد
صبيّ يستمتع قليلاً، أليس كذلك؟

149
00:09:55,870 --> 00:09:58,440
.لم أعقد معه أيّ اتّفاق

150
00:09:58,440 --> 00:10:01,540
إذًا بماذا يفكّر بالضّبط؟

151
00:10:03,180 --> 00:10:06,090
حسنًا، إنّه يحاول بالفعل
.أن يجعلني أبدو جيّدًا كما أظنّ

152
00:10:06,090 --> 00:10:09,050
لا بأس إذًا إن ساعدته قليلاً
.بعد كلّ جهوده هذه

153
00:10:10,880 --> 00:10:12,170
.رئيس تافه

154
00:10:12,170 --> 00:10:13,130
.رئيس حقير

155
00:10:13,130 --> 00:10:16,600
ما الّذي تخطّط له بالضّبط؟

156
00:10:18,810 --> 00:10:23,310
اللّعبة الأخيرة تقترب، والبشريّة
.على وشك فقدان السّيطرة

157
00:10:23,310 --> 00:10:25,940
إنّنا نشهد ارتفاعًا هائلاً
.في حالات الانتحار والجنون

158
00:10:26,370 --> 00:10:27,670
.ممتاز، ممتاز

159
00:10:27,670 --> 00:10:30,240
.ارتجفوا رعبًا وحماسة

160
00:10:30,240 --> 00:10:32,560
هذا بالضّبط ما نريد
.نحن القدماء العظماء أن نراه

161
00:10:32,560 --> 00:10:35,580
أراهن أنّنا سنحصل على مشاهدات
.كثيرة في اللّعبة القادمة

162
00:10:35,580 --> 00:10:41,950
،سيكون أعظم حدث في تاريخ البشريّة
.لذا أتوقّع حوالي عشرة مليارات مشاهدة

163
00:10:42,460 --> 00:10:43,910
رغم أنّهم سيموتون جميعًا؟

164
00:10:43,910 --> 00:10:48,130
أكيد، ولكن أليس ما يريده مقدّم البثوث
هو الحصول على المشاهدات؟

165
00:10:49,120 --> 00:10:51,590
.يا لك من شخص مريب بالفعل

166
00:10:52,390 --> 00:10:56,300
!حان وقت بثّ خاصّ، قبل لعبة القدماء العظماء

167
00:10:56,300 --> 00:10:59,510
!لنرحّب بضيوفنا

168
00:11:00,410 --> 00:11:05,100
مقدّمة البثوث المباشرة الّتي خطفت
،أنظار الجميع، كاغورازاكا كانّا-سان

169
00:11:05,100 --> 00:11:07,480
!وصديقتها كورونو ميكو-سان

170
00:11:07,480 --> 00:11:09,510
!مر-مر-مرحبًا

171
00:11:09,510 --> 00:11:11,320
!أنا كاغورازاكا كانّا

172
00:11:11,320 --> 00:11:13,030
...مرحبًا

173
00:11:13,030 --> 00:11:15,380
...هذه الأضواء ساخنة

174
00:11:15,380 --> 00:11:19,990
لا أصدّق أنّني على شاشة التّلفاز
!في وقت الذّروة

175
00:11:20,380 --> 00:11:25,290
.رائع... كمّا توقّعت، إنّها ممتازة للتّلفاز

176
00:11:25,290 --> 00:11:29,170
.لكنّ كورونو ليست كذلك على الإطلاق

177
00:11:29,750 --> 00:11:32,250
.أبقوا الكاميرا على كاغورازاكا

178
00:11:33,770 --> 00:11:37,630
.كانّا-سان، أنت مقدّمة بثوث مباشرة منذ مدّة

179
00:11:37,630 --> 00:11:41,470
هل يمكنك أن تخبرينا كيف انتهى
بك الأمر في لعبة القدماء العظماء؟

180
00:11:41,470 --> 00:11:46,030
حسنًا، كنت أظنّ أنّه وقع
،عليّ الاختيار عشوائيًّا

181
00:11:46,030 --> 00:11:49,840
لكن يبدو أنّ هناك نوعًا من الذّكاء
الاصطناعيّ اختار اللاّعبين

182
00:11:49,840 --> 00:11:52,180
.بناءً على من يمكنه جعل اللّعبة أكثر متعة

183
00:11:52,180 --> 00:11:55,510
فهمت. إذًا كان اختيارًا متعمّدًا
.من مديري اللّعبة

184
00:11:55,510 --> 00:11:57,340
.يمكنك قول ذلك

185
00:11:57,340 --> 00:12:00,890
لكنّ فكرة "المتعة" عند القدماء العظماء

186
00:12:00,890 --> 00:12:04,890
تبدو أقرب إلى حدوث أمور مروّعة، صحيح؟

187
00:12:04,890 --> 00:12:08,960
نـ-نعم، إنّهم قد يكونون قساة
بعض الشّيء، صحيح؟

188
00:12:08,960 --> 00:12:11,840
.حسنًا، أظنّ لأنّهم آلهة شرّيرة

189
00:12:11,840 --> 00:12:16,420
.ولكن رغم كلّ ذلك، تمكّنتِ من النّجاة

190
00:12:16,420 --> 00:12:18,110
.هذا مدهش

191
00:12:18,570 --> 00:12:20,760
.كنتُ محظوظة فقط

192
00:12:20,760 --> 00:12:25,590
لكن تمّ إقصاء الكثير من الأشخاص، صحيح؟

193
00:12:25,590 --> 00:12:27,480
...نعم، ذلك

194
00:12:27,910 --> 00:12:32,230
معظم المشاركين الّذين أُقصوا من اللّعبة

195
00:12:32,230 --> 00:12:34,570
.قد نُقلوا إلى مستشفيات نفسيّة

196
00:12:34,570 --> 00:12:37,990
.ولا تظهر أيّ علامات على تعافيهم

197
00:12:38,470 --> 00:12:39,530
.نعم

198
00:12:39,530 --> 00:12:42,180
مهلاً، وما علاقة ذلك بكانّا؟

199
00:12:42,180 --> 00:12:43,130
ماذا؟

200
00:12:43,130 --> 00:12:45,790
لقد انجرّت إلى كلّ هذا من
.دون أن تعرف ما سيحدث

201
00:12:46,140 --> 00:12:49,230
،ولم تكن تريد أن تُقتل
.لذا بذلت جهدها لتفوز

202
00:12:49,230 --> 00:12:50,470
أليس هذا كلّ ما في الأمر؟

203
00:12:50,470 --> 00:12:54,800
بالطّبع. لذلك سأقدّم سؤالاً لك
.يا كورونو ميكو-سان

204
00:12:54,800 --> 00:12:59,880
تقدّمين بثوثًا أيضًا. وتصفين نفسك بمقدّمة
بثوث انقطعت عن الثّانويّة، صحيح؟

205
00:13:00,150 --> 00:13:01,620
نعم، وماذا في ذلك؟

206
00:13:01,620 --> 00:13:04,850
من النّادر أن يستخدم شخص ما
.ترك المدرسة ذلك كميزة دعائيّة

207
00:13:05,210 --> 00:13:06,810
.شكرًا، على ما أظنّ

208
00:13:07,210 --> 00:13:10,020
...والآن، نعود إلى كانّا-سان

209
00:13:10,020 --> 00:13:12,480
ماذا؟ أهذا كلّ الوقت
المخصّص لي على الشّاشة؟

210
00:13:12,930 --> 00:13:14,840
.لننتقل إلى يامادا-سان مباشرة من الميدان

211
00:13:16,300 --> 00:13:18,440
.مرحبًا، أنا يامادا

212
00:13:18,750 --> 00:13:24,660
.أنا الآن أمام مستشفى والد كانّا-سان

213
00:13:26,060 --> 00:13:28,160
.كما ترون، المكان هادئ

214
00:13:28,480 --> 00:13:33,670
منذ وقت قصير، كان هناك حشد
.من المتفرّجين، لكن الآن لا أحد هنا

215
00:13:33,670 --> 00:13:34,690
!مهلاً

216
00:13:34,690 --> 00:13:38,960
يقول الجيران أنّ المستشفى
،مغلق منذ بضعة أيّام

217
00:13:38,960 --> 00:13:41,340
.دون أيّ أثر لوجود أحد هنا

218
00:13:41,340 --> 00:13:42,350
.فهمت

219
00:13:42,350 --> 00:13:45,760
.إذًا فإنّهم يختبئون من الانتقادات

220
00:13:45,760 --> 00:13:48,140
.نعم. هذا كلّ ما لدينا من هنا

221
00:13:48,430 --> 00:13:51,140
وها قد سمعت. ما رأيك يا كانّا-سان؟

222
00:13:51,960 --> 00:13:55,400
!ما بالكم؟! لا علاقة لوالداي بالأمر

223
00:13:55,400 --> 00:13:58,730
لكنّ الحقيقة كُشفت أثناء اللّعبة، صحيح؟

224
00:13:58,730 --> 00:14:01,110
.قلتِ أنّك تعرّضت للعنف

225
00:14:01,110 --> 00:14:03,740
.هذا شيء علينا جميعًا التّفكير فيه

226
00:14:03,740 --> 00:14:05,850
.إنّها مشكلة اجتماعيّة خطيرة

227
00:14:08,440 --> 00:14:10,580
!ستبدأ الإعلانات بعد قليل

228
00:14:11,060 --> 00:14:13,390
...ثلاثة... اثنان

229
00:14:15,040 --> 00:14:16,950
!أنا كاغورازاكا كانّا

230
00:14:16,950 --> 00:14:19,000
...أ-أنا كورونو ميكو

231
00:14:19,000 --> 00:14:21,630
الجولة الأخيرة من لعبة القدماء
!العظماء على وشك أن تبدأ

232
00:14:21,630 --> 00:14:24,260
!مـ-معركة لتحديد مصير الأرض

233
00:14:24,260 --> 00:14:26,890
!لا تفوّتوا البثّ الحيّ

234
00:14:26,890 --> 00:14:29,480
نحن هنا اليوم لدعم
،كاغورازاكا كانّا وكورونو ميكو

235
00:14:29,480 --> 00:14:32,630
.المشاركتين في لعبة القدماء العظماء

236
00:14:32,630 --> 00:14:36,650
!حظًّا سعيدًا في الجولة الأخيرة
!لِنحمِ أرضنا الحبيبة

237
00:14:36,650 --> 00:14:39,050
!ترقّبوا ذلك

238
00:14:43,600 --> 00:14:46,990
...مهلاً! أعلم أنّ زوج أمّي حقير

239
00:14:46,990 --> 00:14:49,200
لكن هل كان لا بدّ أن تذكروه
على التّلفاز الوطنيّ؟

240
00:14:49,630 --> 00:14:52,470
.آسفة... كنت فقط أتّبع النّصّ

241
00:14:52,470 --> 00:14:54,660
.فهمتِ الأمر بشكل خاطئ يا كانّا-تشان

242
00:14:54,990 --> 00:14:58,290
أنتِ بطلة مأساويّة
.تعرّضتِ للعنف من زوج أمّك

243
00:14:58,290 --> 00:15:03,070
،إذا لعبنا على هذا الجانب
.سنُسكت كلّ كارهيك

244
00:15:03,070 --> 00:15:05,130
ما أقوله هو أنّكم لا تظهرون
!أيّ احترام لخصوصيّتي

245
00:15:05,130 --> 00:15:07,210
ماذا؟

246
00:15:07,630 --> 00:15:09,430
خصوصيّة؟ ومن يهتمّ الآن؟

247
00:15:09,430 --> 00:15:11,780
!قد تُدمّر البشريّة

248
00:15:11,780 --> 00:15:13,980
ما هو الموضوع الأكثر جذبًا من ذلك؟

249
00:15:15,040 --> 00:15:18,990
سنجعل منكما بطلتين مأساويّتين
!يحبّهما الجميع

250
00:15:18,990 --> 00:15:20,150
—لذا

251
00:15:22,820 --> 00:15:24,780
آسفة. أنا مجرّد تلميذة
.ثانويّة منقطعة عن الدّراسة

252
00:15:24,780 --> 00:15:28,490
.رائع. سنركّز عليك في الجزء التّالي

253
00:15:28,490 --> 00:15:29,820
!ميكو

254
00:15:29,820 --> 00:15:31,330
!كانّا

255
00:15:31,330 --> 00:15:33,790
!امسحي تلك الابتسامة الغبيّة عن وجهك

256
00:15:35,500 --> 00:15:38,000
،جئتُ إلى هنا لأنّهم قالوا أنّهم سيساعدوننا

257
00:15:38,000 --> 00:15:40,820
لكن لا يمكنني السّماح لهؤلاء
.من التّلفاز أن يعبثوا معك

258
00:15:40,820 --> 00:15:41,960
!سنغادر

259
00:15:46,140 --> 00:15:47,760
...غدًا على السّاعة الثّامنة ليلاً

260
00:15:48,280 --> 00:15:50,470
.لم نتمكّن من المغادرة في الوقت المناسب

261
00:15:53,300 --> 00:15:57,380
!أنا الآن في غرفة الفاكس
.دعوني أريكم بعض الرّسائل

262
00:15:57,380 --> 00:16:00,380
،كانّا-تشان، ميكو-تشان"
".أرجوكما احميا أرضنا

263
00:16:00,380 --> 00:16:02,980
"!أحبّك يا كانّا-تشان! أنا أشجّعك"

264
00:16:03,240 --> 00:16:06,990
كما ترون، تصلنا رسائل
.دعم من كلّ أنحاء اليابان

265
00:16:06,990 --> 00:16:09,700
!ونحن بانتظار رسائلكم أيضًا

266
00:16:15,670 --> 00:16:16,620
!تشجّعا

267
00:16:16,620 --> 00:16:17,990
!كانّا-تشان

268
00:16:18,960 --> 00:16:21,580
.يبدو أنّه لا مفرّ الآن

269
00:16:21,910 --> 00:16:23,880
!لقد حان الوقت

270
00:16:23,880 --> 00:16:26,300
...كاغورازاكا كانّا وكورونو ميكو

271
00:16:26,300 --> 00:16:28,520
!صعدتا للتّوّ إلى السّيّارة

272
00:16:28,520 --> 00:16:30,180
!والآن، عودة إلى الاستوديو

273
00:16:30,180 --> 00:16:31,300
!كانّا-تشان

274
00:16:31,300 --> 00:16:32,640
!أحبّك أيضًا يا ميكو-تشان

275
00:16:32,640 --> 00:16:33,900
!أكرهكم

276
00:16:33,900 --> 00:16:34,760
!موتوا

277
00:16:34,760 --> 00:16:38,570
شخص واحد... إن نجح ولو شخص
...واحد في النّهاية

278
00:16:38,570 --> 00:16:42,350
.سننجو. سيتمّ إنقاذ الأرض

279
00:16:42,350 --> 00:16:46,080
أيّ لعبة تنتظرهم؟

280
00:16:46,080 --> 00:16:49,980
غادرت سيّارة اللّيموزين
.الّتي تُقلّهما من الاستوديو

281
00:16:49,980 --> 00:16:52,780
.ترافقهم عدّة درّاجات شرطة للحراسة

282
00:16:52,780 --> 00:16:55,660
!وداعًا! وحظًّا موفّقًا أيّتها الأرض

283
00:17:04,810 --> 00:17:07,380
!تمّ اعتراض طريقهم

284
00:17:07,380 --> 00:17:10,260
لقد أوقفهم أتباع طائفة يعبدون
!القدماء العظماء

285
00:17:10,690 --> 00:17:13,460
!مهلاً! علينا أن نؤمّن وصولهم بسلام

286
00:17:13,460 --> 00:17:14,630
ما الّذي تفعلونه؟

287
00:17:25,850 --> 00:17:26,980
دُمى؟

288
00:17:34,120 --> 00:17:36,360
.كنت أعلم أنّ هذا سيحدث

289
00:17:36,360 --> 00:17:38,500
!لا تستهيني بمهاراتي في إدارة المخاطر

290
00:17:38,500 --> 00:17:39,790
!ماما، أسرعي

291
00:17:39,790 --> 00:17:42,080
!اتركي الأمر لي
!أنا بارعة في مثل هذه الأمور

292
00:17:42,080 --> 00:17:43,970
!ميكو! ماما! هذا رائع

293
00:17:43,970 --> 00:17:44,990
أتظنّين؟

294
00:17:46,340 --> 00:17:48,130
!دايفوكو

295
00:17:48,130 --> 00:17:50,760
!حان وقت الانطلاق
!تمسّكا جيّدًا

296
00:17:54,040 --> 00:17:56,470
.وصلتنا للتّوّ أخبار جديدة

297
00:17:56,470 --> 00:18:01,640
إنّهما بخير! غادرت كانّا-سان
!وميكو-سان الاستوديو في سيّارة أخرى

298
00:18:03,310 --> 00:18:05,610
!لكنّ الشّغب لم يتوقّف

299
00:18:05,610 --> 00:18:09,990
!إيا! إيا! هاستر

300
00:18:09,990 --> 00:18:11,610
!هذا العالم سيتدمّر

301
00:18:11,870 --> 00:18:14,390
!خلاصنا الوحيد هو القدماء العظماء

302
00:18:14,390 --> 00:18:16,470
!إيا! إيا! هاستر

303
00:18:16,470 --> 00:18:21,290
!إيا! إيا! هاستر! إيا! إيا! هاستر

304
00:18:24,330 --> 00:18:28,520
كانت كورونو ميكو فتاة رائعة
.ولطيفة دائمًا مع الأطفال الأصغر

305
00:18:28,520 --> 00:18:30,500
—تطوّعت للرّحيل

306
00:18:30,750 --> 00:18:34,220
!لا، للتّخرّج—من أجل حماية الميتم

307
00:18:34,220 --> 00:18:38,930
.حاولنا منعها، لكنّها كانت عنيدة

308
00:18:38,930 --> 00:18:42,850
لكن لا أصدّق أنّها تورّطت
!في معركة مروّعة كهذه

309
00:18:43,230 --> 00:18:45,820
!لو أنّني أستطيع أن آخذ مكانها... لفعلت

310
00:18:45,820 --> 00:18:48,430
.بالطّبع. لا بدّ أنّ هذا صعب عليك

311
00:18:49,320 --> 00:18:53,990
انظروا! نحن نتلقّى رسائل
!دعم من مختلف أنحاء البلاد

312
00:18:54,320 --> 00:18:55,990
"!يمكنك فعلها يا كانّا-تشان"

313
00:18:55,990 --> 00:18:57,870
"!لقّنيهم درسًا يا ميكو-تشان"

314
00:18:58,460 --> 00:19:00,580
...أنا متأثّرة جدًّا

315
00:19:00,580 --> 00:19:04,790
،والآن، أيّها المشاهدون في منازلكم
!شجّعوهما أنتم أيضًا

316
00:19:04,790 --> 00:19:06,490
!وجدناهم! لا تدعوهم يهربون

317
00:19:06,490 --> 00:19:08,630
!مشعوذة! إنّها قرباننا

318
00:19:09,880 --> 00:19:11,340
!استسلموا وأريحونا

319
00:19:13,420 --> 00:19:15,590
!لا تدعوا القدماء العظماء يفوزون

320
00:19:15,870 --> 00:19:18,720
!يمكنك فعلها يا ميكو-سان

321
00:19:18,720 --> 00:19:20,800
!كانّا-سان

322
00:19:25,450 --> 00:19:26,940
هذا هو المكان، صحيح؟

323
00:19:29,590 --> 00:19:31,150
!نعم، هذا هو

324
00:19:32,480 --> 00:19:34,360
!شكرًا يا ماما

325
00:19:34,360 --> 00:19:38,080
.لا بأس. اذهبا ولقّناهم درسًا

326
00:19:38,080 --> 00:19:40,970
.افعلا فقط ما تريانه صحيحًا

327
00:19:40,970 --> 00:19:41,980
.نعم

328
00:19:41,980 --> 00:19:43,100
!ميكو

329
00:19:43,100 --> 00:19:44,410
.اعتني بمايو

330
00:19:44,410 --> 00:19:45,670
.نعم

331
00:19:46,390 --> 00:19:48,540
.هذا كلّ ما يهمّني

332
00:19:51,690 --> 00:19:54,300
.شكرًا. سأكون بخير. سأتولّى الأمر

333
00:19:54,670 --> 00:19:57,010
.لنعد إلى المنزل عندما ينتهي كلّ هذا

334
00:19:59,760 --> 00:20:00,890
.لنذهب

335
00:20:01,290 --> 00:20:02,430
.نعم

336
00:20:05,140 --> 00:20:06,640
.ميكو-سان، كانّا-سان

337
00:20:06,640 --> 00:20:08,100
!كي-سان

338
00:20:08,100 --> 00:20:10,230
.سعيد لأنّكما بخير

339
00:20:10,230 --> 00:20:13,610
سيشيرو-سان، أين كنت مختبئًا؟

340
00:20:13,610 --> 00:20:18,320
كان الأمر صعبًا! الفنادق الرّيفيّة
.والحمّامات العامّة الرّخيصة... وما إلى ذلك

341
00:20:18,860 --> 00:20:19,820
وأنت يا كي-سان؟

342
00:20:19,820 --> 00:20:22,670
.كنت أقيم عند صديق مقرّب

343
00:20:23,260 --> 00:20:25,280
...هكذا إذًا

344
00:20:25,700 --> 00:20:28,540
كـ-كنتُ محظوظة حقًّا بإيجاد
!شخصًا متفهّمًا ألجأ إليه

345
00:20:29,360 --> 00:20:30,860
نحن الأربعة فقط؟

346
00:20:31,590 --> 00:20:32,880
.نعم

347
00:20:32,880 --> 00:20:36,090
،فقدنا الكثير من النّاس
.لكنّنا ما زلنا أحياء

348
00:20:36,090 --> 00:20:37,260
!نعم

349
00:20:37,910 --> 00:20:39,760
...حسنًا، دون إضاعة المزيد من الوقت

350
00:20:39,760 --> 00:20:42,670
لقد سبّبتم لنا الكثير
!من المتاعب أيّها الأوغاد

351
00:20:42,670 --> 00:20:44,470
!لكنّ ذلك سينتهي اليوم

352
00:20:44,470 --> 00:20:47,180
!تعالوا ونالوا منّي أيّها القدماء العظماء

353
00:20:50,350 --> 00:20:51,930
.هذه هي النّهاية

354
00:20:51,930 --> 00:20:53,970
...عليّ أن أنهي

355
00:20:54,910 --> 00:20:56,070
.ما بدأتُه

356
00:20:56,510 --> 00:20:59,450
.سيعود بابا إلى البيت. هذا وعد

357
00:20:59,450 --> 00:21:03,840
،عشت حياة بائسة حتّى وصلت إلى هنا
،لكن عندما ينتهي هذا

358
00:21:04,890 --> 00:21:08,410
!سأعيش حياة أفتخر بها

359
00:21:09,320 --> 00:21:10,810
!لنبدأ اللّعبة

360
00:21:12,570 --> 00:21:13,840
!التّحقّق من السّلامة العقليّة

361
00:21:16,230 --> 00:21:17,330
.جيّد

362
00:21:17,330 --> 00:21:18,550
.استعداد

363
00:21:18,800 --> 00:21:20,030
!لنبدأ

364
00:21:23,430 --> 00:21:24,760
!تمّ الفحص

365
00:21:36,520 --> 00:21:39,280
ما-ما هذا؟

366
00:21:39,280 --> 00:21:40,610
!البرد قارس

367
00:21:40,610 --> 00:21:42,860
ما-ما الّذي يحدث هنا؟

368
00:21:42,860 --> 00:21:44,370
هل يحاولون قتلنا؟

369
00:21:44,370 --> 00:21:45,830
...انتظروا، هذا هو

370
00:21:45,830 --> 00:21:51,620
،سيّداتي وسادتي
...مرحبًا بكم في أرض الأحلام

371
00:21:52,440 --> 00:21:53,830
!كاداث

372
00:21:53,830 --> 00:21:55,080
!أيّها الوغد

373
00:21:55,080 --> 00:22:00,210
إنّها المعركة النّهائيّة، لذا استغرق
.الأمر بعض الوقت للتّحضير

374
00:22:00,530 --> 00:22:03,190
والآن... هدفكم هو النّجاة
من هذه العاصفة الثّلجيّة

375
00:22:03,190 --> 00:22:07,610
وهزيمة جميع القدماء العظماء
،الأربعة الّذين بانتظاركم

376
00:22:07,610 --> 00:22:09,470
!ثمّ الوصول إلى قمّة الجبل

377
00:22:09,470 --> 00:22:11,550
ا-القدماء العظماء الأربعة؟

378
00:22:12,230 --> 00:22:17,690
،فلتبدأ اللّعبة النّهائيّة
!جبال الجنون... الآن