1
00:01:30,730 --> 00:01:33,730
آكل الصّدأ المسروق

2
00:01:33,960 --> 00:01:36,360
!من أين أتيتِ بالضبط؟

3
00:01:43,940 --> 00:01:47,620
حسناً، أنتِ تتحرّكين بشكل أفضل
من السّابق بكثير، أليس كذلك؟

4
00:01:47,620 --> 00:01:50,750
تنتهي حياتك هنا يا آكل البشر أكابوشي

5
00:01:50,750 --> 00:01:52,620
أعد أخي إليّ

6
00:01:52,810 --> 00:01:56,300
قبل كلّ شيء، ميلو هو من لحق بي

7
00:01:56,650 --> 00:02:00,000
أراد إنقاذ حياتكِ وجسدكِ الصّدئ هذا

8
00:02:00,220 --> 00:02:02,040
أكاذيب مُقنعة

9
00:02:02,040 --> 00:02:06,770
خدعتَ قلب أخي النقيّ بادّعاءاتك التي لا أساس
لها من الصحّة حيال آكل الصدأ هذا

10
00:02:06,770 --> 00:02:09,070
!أفسحي له مجالاً أكبر

11
00:02:09,410 --> 00:02:12,400
ألم تسمعي يوماً بترك الأطفال يكبرون بمفردهم؟

12
00:02:13,440 --> 00:02:15,770
صحيح. أنتِ أخته، أليس كذلك؟

13
00:02:16,190 --> 00:02:20,030
آسف. تبدين أكبر، ظننتُكِ أمّه

14
00:02:21,580 --> 00:02:22,790
!سوف أسحقك

15
00:02:31,490 --> 00:02:33,610
ما هذا؟

16
00:02:38,290 --> 00:02:39,290
!حمقاء

17
00:02:39,610 --> 00:02:41,290
!ارمي الدرّاجة وانخفضي

18
00:02:44,020 --> 00:02:45,310
اللّعنة

19
00:02:45,310 --> 00:02:48,190
هذا ما يحدث عندما تبدئين القتال في أماكن سخيفة

20
00:02:53,470 --> 00:02:55,060
!بيسكو

21
00:02:56,530 --> 00:02:57,910
!سأدعه يُسقِط باوو

22
00:02:58,230 --> 00:02:59,580
!استعدّ لإمساكها

23
00:03:00,060 --> 00:03:01,430
!حسناً

24
00:03:16,060 --> 00:03:17,330
!ميلو

25
00:03:17,600 --> 00:03:21,350
!إذا حلّقَ أعلى، لن تتمكّن من النّزول

26
00:03:21,570 --> 00:03:22,460
!صحيح

27
00:03:26,880 --> 00:03:28,160
!ميلو

28
00:03:30,490 --> 00:03:32,390
اصعدي درّاجتكِ وشغّليها حالاً

29
00:03:32,390 --> 00:03:33,770
إيمي

30
00:03:33,760 --> 00:03:37,770
!افعليها حالاً! أتريدين أن يموت أخوكِ؟

31
00:03:38,210 --> 00:03:42,440
لم يُفلِت رغم أنّنا حقنّاه بكلّ فطور التّخدير تلك؟

32
00:03:43,870 --> 00:03:44,980
أكتاغاوا

33
00:03:45,820 --> 00:03:48,540
هل تؤمن بي؟

34
00:03:56,630 --> 00:03:57,770
أنا آسف

35
00:04:00,630 --> 00:04:01,480
!حسناً

36
00:04:08,240 --> 00:04:11,020
!ما كان بيسكو ليستسلم

37
00:04:12,350 --> 00:04:14,860
!ليس قبل أن يطلق آخر سهم له

38
00:04:22,250 --> 00:04:23,870
!سأستعير عصاك

39
00:04:24,300 --> 00:04:25,360
!بيسكو

40
00:04:29,010 --> 00:04:31,320
!ميلو

41
00:04:39,440 --> 00:04:40,540
!ميلو

42
00:04:59,700 --> 00:05:03,380
!أكتاغاوا

43
00:05:20,500 --> 00:05:22,120
يسرّني أنّك بخير

44
00:05:22,120 --> 00:05:23,020
أجل

45
00:05:23,010 --> 00:05:26,010
إيمي

46
00:05:24,120 --> 00:05:26,000
لماذا قمتَ بهذا العمل المتهوّر؟

47
00:05:26,490 --> 00:05:28,280
أليس هذا واضحاً؟

48
00:05:28,710 --> 00:05:31,380
لأنّني لا أريد أن أخسركِ قطعاً

49
00:05:42,270 --> 00:05:44,130
...بيسكو، هل هذا

50
00:05:44,130 --> 00:05:46,020
أجل، إنّه آكل الصدأ

51
00:05:46,410 --> 00:05:48,590
فعلناها أخيراً

52
00:05:48,590 --> 00:05:51,020
يمكننا الآن معالجة باوو

53
00:05:51,370 --> 00:05:52,680
أليس كذلك يا بيسكو؟

54
00:05:55,280 --> 00:05:56,340
بيسكو؟

55
00:05:56,340 --> 00:05:58,910
هذا غريب. ثمّة أمر غير طبيعي

56
00:06:09,160 --> 00:06:12,290
كلّ فطر لديه قوّة التهام الصّدأ

57
00:06:12,290 --> 00:06:15,760
يدعى "آكل الصدأ" فقط لأنّ مفعوله أفضل
،بكثير من الفطور الأخرى

58
00:06:16,310 --> 00:06:19,710
،قوّة هذا الشيء في التهام الصدأ وحتّى مذاقه

59
00:06:19,710 --> 00:06:21,760
لا تختلفان عن بقيّة الفطور

60
00:06:22,060 --> 00:06:23,350
...مستحيل

61
00:06:23,770 --> 00:06:26,780
بعد أن عانينا كلّ هذه المعاناة لأجله؟

62
00:06:23,770 --> 00:06:26,780
إيمي

63
00:06:27,010 --> 00:06:29,520
إذا وجدنا الفطر الخاطئ، فلا يسعنا فعل شيء

64
00:06:30,210 --> 00:06:32,780
أمامنا قليل من الوقت قبل غروب الشمس

65
00:06:32,780 --> 00:06:34,660
لنبحث عن فريستنا التالية

66
00:06:35,150 --> 00:06:38,360
أتفهّم شعورك، لكن لا يمكننا فعل ذلك حالاً

67
00:06:38,880 --> 00:06:40,950
من الواضح بأنّك نزفت الكثير من الدّماء

68
00:06:41,410 --> 00:06:43,270
ميلو على حقّ

69
00:06:43,270 --> 00:06:45,950
لا أحد منّا قادر على القتال الآن

70
00:06:46,310 --> 00:06:48,960
إن كنتُما مُنهكَين، لن أضغط عليكما

71
00:06:48,960 --> 00:06:50,080
سأذهب بمفردي

72
00:06:50,080 --> 00:06:51,120
!انتظر

73
00:06:51,480 --> 00:06:54,220
!أنت الأكثر إرهاقاً بيننا

74
00:06:54,410 --> 00:06:58,220
إذا واجهتَ شيئاً من تلك الأشياء بحالتك
!هذه، فسوف تموت دون ريب

75
00:06:58,420 --> 00:07:00,670
!كفاك ثِقة مُفرطة بالنفس

76
00:07:00,670 --> 00:07:02,970
!لن أدع كلّ شيء يذهب سدى بعد كلّ ما قطعناه

77
00:07:03,490 --> 00:07:05,710
!أفلتني أيّها الأحمق

78
00:07:05,710 --> 00:07:06,370
!أكابوشي

79
00:07:13,970 --> 00:07:15,000
!بيسكو

80
00:07:15,000 --> 00:07:17,070
!انتظر، آكل الصدأ

81
00:07:24,650 --> 00:07:25,750
فهمت

82
00:07:26,280 --> 00:07:27,620
إنّه دماء بيسكو

83
00:07:30,960 --> 00:07:32,050
حسناً

84
00:07:32,370 --> 00:07:35,840
هذا يكفي، صحيح؟ ما الخدعة التي
قمتَ بها قبل قليل؟

85
00:07:35,840 --> 00:07:37,500
الأولويّة لنقل دمٍ لك

86
00:07:38,430 --> 00:07:40,720
بيسكو، ما زمرة دمك؟

87
00:07:40,720 --> 00:07:42,930
ماذا يعني "زمرة دم"؟

88
00:07:43,290 --> 00:07:45,180
يبقى الدماء دماء، صحيح؟

89
00:07:45,180 --> 00:07:48,760
...كفاك مزاحاً. لا بدّ وأنّك تعرف زمرة دمك

90
00:07:49,500 --> 00:07:51,360
زمرة الدم؟

91
00:07:51,360 --> 00:07:52,570
ما هي هذه؟

92
00:07:53,090 --> 00:07:57,820
هل يُعقَل أنّ رُعاة الفطور لا يعرفون
شيئاً عن زُمَر الدم؟

93
00:07:58,240 --> 00:08:00,630
...أم أنّ دمهم بحدّ ذاته

94
00:08:00,630 --> 00:08:03,830
ما الخطب؟ ألا يمكنك فعلها دون معرفة ذلك؟

95
00:08:04,100 --> 00:08:05,630
لا، لا مشكلة

96
00:08:06,660 --> 00:08:11,590
حدّثني جابي-سان عن أساطير آكل
الصدأ عندما كنّا في إيميهاما

97
00:08:11,590 --> 00:08:12,570
!ماذا؟

98
00:08:12,570 --> 00:08:14,540
!لم يخبرني عنها أبداً

99
00:08:14,540 --> 00:08:16,100
قلتُ لك لا تتحرّك

100
00:08:16,610 --> 00:08:18,360
شعرتُ بغرابة الأمر

101
00:08:18,940 --> 00:08:23,100
إذا كانت أفعى المزمار هي حوض إنبات
آكل الصدأ، فهذا لا يطابق الأساطير

102
00:08:23,300 --> 00:08:25,530
تقصد أنّ آكل الصدأ الذي ينمو على أفعى المزمار

103
00:08:25,530 --> 00:08:29,620
لا يستيقظ إلّا بعد التّلامس بدماء راعي الفطور؟

104
00:08:29,850 --> 00:08:30,540
أجل

105
00:08:30,850 --> 00:08:34,340
لا بدّ أنّ دماء راعي الفطور يحتوي
على عامل غامض ما

106
00:08:34,840 --> 00:08:39,270
بيسكو، حالما ننتهي من نقل هذا الدّماء
الاصطناعي، أعطني قليلاً من دمك

107
00:08:40,410 --> 00:08:44,010
لماذا كان جابي يلتزم الصّمت حيال هذا؟

108
00:08:44,230 --> 00:08:46,700
،لأنّك إذا اتّخذت الأساطير على ظاهرها

109
00:08:46,700 --> 00:08:49,480
فقد تضحّي براعي فطور آخر

110
00:08:49,480 --> 00:08:51,800
—مُحال أن أفعل هذا لأصدقائي

111
00:08:51,800 --> 00:08:55,770
ألا تُدعى أكابوشي آكل البشر ذو القبّعة
الحمراء لأنّك تفعل ذلك بالتحديد؟

112
00:08:55,770 --> 00:08:58,630
أتريدينني أن أعضّكِ أيّتها الساقطة؟

113
00:08:58,630 --> 00:09:01,670
قلتُ لك لا تتحرّك، ألا تستطيع الثبات مكانك؟

114
00:09:01,670 --> 00:09:05,000
!لا أستطيع الجلوس هنا أهدر وقتي الثمين

115
00:09:14,600 --> 00:09:18,780
تقنيّة غامضة وفعّالة تخصّ علم الدوائيّات

116
00:09:18,780 --> 00:09:23,280
،لعلّ رعاة الفطور ليسوا همجيّين كما يصوّرهم العالم

117
00:09:23,280 --> 00:09:27,260
لكنّهم بالأحرى، منقذون علميّون؟

118
00:09:27,830 --> 00:09:32,200
لكن إن صحَّ ذلك، فماذا عن تلك القصّة؟

119
00:09:34,780 --> 00:09:36,050
ما الذي تنظرين إليه؟

120
00:09:39,310 --> 00:09:41,800
سأذهب لضبط درّاجتي

121
00:09:41,800 --> 00:09:43,760
فقد تعرّضتْ لكثير من الصّدمات والتّلف

122
00:09:56,450 --> 00:10:04,790
،لم أتوقّع أنه بمطاردة آكل البشر أكابوشي
سوف أتوصّل لآكل الصدأ الأسطوري

123
00:10:05,090 --> 00:10:06,330
!كوروكاوا

124
00:10:06,820 --> 00:10:12,250
كان بمقدورك أن تُدهش الحكومة بحدّ
ذاتها بدواء نادر كهذا

125
00:10:12,780 --> 00:10:14,660
مُحافظ إيميهاما؟

126
00:10:15,080 --> 00:10:18,100
سررتُ بلقائك يا أكابوشي

127
00:10:30,320 --> 00:10:33,940
حتّى بعد كلّ ذلك العلاج المضادّ
للجراثيم، يكاد يتفتّح

128
00:10:33,940 --> 00:10:35,880
لن يتمكّن من تحمّل ضربات متعدّدة

129
00:10:36,150 --> 00:10:39,670
أكابوشي، أنت خطير

130
00:10:40,080 --> 00:10:42,660
لا أنفكّ أرتجف

131
00:10:43,100 --> 00:10:45,650
إلى متى ستستمرّ في إطلاق النّار؟

132
00:10:45,650 --> 00:10:49,030
...إنّه جريح! إذا أسقطناه هنا

133
00:10:49,030 --> 00:10:52,570
...إذا استهنت براعي فطور هكذا

134
00:10:57,200 --> 00:11:00,790
فهذا ما سيحدث لك يا غبيّ

135
00:11:03,060 --> 00:11:04,350
!بيسكو

136
00:11:05,280 --> 00:11:08,820
سنلتقي ثانية، أليس كذلك يا أكابوشي؟

137
00:11:08,820 --> 00:11:11,800
اعتبر هذا خاتم وعدنا

138
00:11:13,820 --> 00:11:16,830
استخدم ذلك الحقير رصاصة صدأ

139
00:11:30,160 --> 00:11:33,200
أمتأكّدة بأنّكِ لا تريدين تلقّي حقنة هنا؟

140
00:11:34,050 --> 00:11:35,310
سأكون بخير

141
00:11:35,310 --> 00:11:38,340
إذا كانت هذه تُعالج جابي العجوز، فسأتلقّى واحدة أيضاً

142
00:11:38,830 --> 00:11:39,740
...لكن

143
00:11:40,140 --> 00:11:45,030
سيتوتّر كوروكاوا الآن من قلّة فعاليّة آكل الصدأ

144
00:11:45,520 --> 00:11:51,720
إن تعافيتُ تماماً وظهرت، من يدري ما الّذي
سيفعله لاكتشاف الخدعة وراء ذلك؟

145
00:11:53,090 --> 00:11:55,230
اعتنِ بأكابوشي

146
00:11:56,060 --> 00:12:02,510
في كلّ الأحوال، درّاجتي هي السبيل الوحيد لإيصال
هذه الحقنة لجابي العجوز بينما لا يزال حيّاً

147
00:12:03,380 --> 00:12:07,540
سأذهب إلى قاعدة حرَس للحصول على
معلومات. لا حاجة للقلق

148
00:12:16,680 --> 00:12:20,270
لم أعد الشخص الّذي يستطيع حماية ذلك الفتى

149
00:12:20,940 --> 00:12:23,160
بل أنت يا أكابوشي

150
00:12:23,590 --> 00:12:25,780
لكنّها حصّتكِ

151
00:12:26,390 --> 00:12:28,910
معدتك هذه

152
00:12:28,910 --> 00:12:30,890
،قد يبدو كتصدّؤ خفيف الآن

153
00:12:30,890 --> 00:12:33,640
لكنّه سيتطوّر أسرع من أيّ حالة طبيعيّة

154
00:12:33,850 --> 00:12:36,030
استخدمها عندما يلزم الأمر

155
00:12:36,030 --> 00:12:38,140
...باوو، أنتِ

156
00:12:40,010 --> 00:12:42,490
ناديتني باسمي أخيراً

157
00:12:44,330 --> 00:12:48,610
أسرع واهزم كوروكاوا فحسب، ثمّ
يمكنك أن تأتي وتهزمني

158
00:12:50,460 --> 00:12:51,640
حسناً

159
00:12:54,520 --> 00:12:57,120
مجرّد تغيير طفيف للترتيب إذاً

160
00:12:57,580 --> 00:13:00,490
إن كنتِ تحاولين جعلي مَديناً لكِ، فهذه غير محسوبة

161
00:13:02,280 --> 00:13:05,770
هل تتذكّر أوّل مرّة تقاتلنا فيها؟

162
00:13:06,760 --> 00:13:12,070
أنت الوحيد الّذي قال عنّي جميلة بعد
رؤية صدئي يا أكابوشي

163
00:13:12,610 --> 00:13:15,700
الآن بعد إمعان النظر فيك، أنت جذّاب حقّاً

164
00:13:16,440 --> 00:13:18,400
لديك وجه ظريف

165
00:13:18,820 --> 00:13:19,930
!ماذا؟

166
00:13:20,760 --> 00:13:22,970
عمّاذا تتهامسان؟

167
00:13:23,780 --> 00:13:27,780
إيمي

168
00:13:23,990 --> 00:13:27,070
كنتُ أهدّده لأحرص على حمايتك

169
00:13:32,200 --> 00:13:36,210
إيمي

170
00:13:36,210 --> 00:13:39,960
نفق شيموبوكي

171
00:13:56,530 --> 00:13:58,610
ماذا حلّ للآخرين؟

172
00:13:59,180 --> 00:14:00,710
لماذا الحرَس ليسوا هنا؟

173
00:14:12,200 --> 00:14:14,570
هذه ردود أفعال أشخاص خارقين

174
00:14:15,130 --> 00:14:20,330
حقيقة قدرتكِ على التحرّك بهذا الشكل
رغم أنّكِ جريحة مُفزعة

175
00:14:20,780 --> 00:14:21,960
كوروكاوا

176
00:14:22,400 --> 00:14:24,480
!ماذا فعلت لرجالي؟

177
00:14:25,660 --> 00:14:27,710
تمهّلي لحظة

178
00:14:28,350 --> 00:14:31,980
...يا لكِ من امرأة حادّة الطبع. عجباً

179
00:14:32,450 --> 00:14:35,400
يمكننا التكلّم بعد أن تري هذا

180
00:15:02,480 --> 00:15:03,960
عدتُ يا بيسكو

181
00:15:04,200 --> 00:15:06,090
...طعامنا خنزير مقليّ اليوم

182
00:15:08,970 --> 00:15:10,920
!بيسكو

183
00:15:11,870 --> 00:15:13,730
!ميلو

184
00:15:14,260 --> 00:15:15,850
اسمعني

185
00:15:15,850 --> 00:15:19,480
وجدَ هذا سلطعانَ مُستنقع أنثى وراحَ من تلقاء نفسه

186
00:15:19,700 --> 00:15:22,730
لكن من دون تلك الكمّاشة الكبيرة الّتي
كان فخوراً بها، تمّ إسقاطه

187
00:15:23,070 --> 00:15:27,290
أعتقد لا يمكنك أن توقع بفتاة بكمّاشة صغيرة؟

188
00:15:35,500 --> 00:15:37,240
...أخبرتُك

189
00:15:37,240 --> 00:15:39,670
!مراراً ألّا تتحرّك

190
00:15:39,670 --> 00:15:41,880
!لماذا لا تسمعني عندما أخبرك بشيء؟

191
00:15:42,330 --> 00:15:45,770
...كما قلت، هربَ أكتاغاوا بمفرده وتلقّى الرّفض

192
00:15:47,040 --> 00:15:50,140
تبّاً. أثرتُ غضبه

193
00:15:50,680 --> 00:15:54,810
عندما يصبح هكذا، لا يسامحني ما لم
أطعمه حتّى التّخمة

194
00:15:56,520 --> 00:15:59,140
!لا يا غبيّ! عُد إلى هنا

195
00:15:59,320 --> 00:16:01,230
!سأعود خلال عشر دقائق

196
00:16:01,230 --> 00:16:02,640
طعامنا اليوم خنزير مقليّ، صحيح؟

197
00:16:03,260 --> 00:16:06,110
!سلخ جلد الخنازير مزعج، لذا سأدعه لك

198
00:16:09,750 --> 00:16:10,770
!ذلك الأحمق

199
00:16:11,370 --> 00:16:13,520
أنا قلق جدّاً عليه

200
00:16:13,900 --> 00:16:17,060
بينما هو لا يتعاون البتّة. بئساً له

201
00:16:18,290 --> 00:16:21,650
اختبار، اختبار، اختبار، اختبار

202
00:16:22,060 --> 00:16:27,080
هذا إعلان رسميّ من مُحافِظ إيميهاما، كوروكاوا

203
00:16:28,040 --> 00:16:31,750
هذا تحذير لمجرم مطلوب

204
00:16:31,750 --> 00:16:35,110
أكابوشي بيسكو، وكذلك نيكوياناغي ميلو

205
00:16:35,520 --> 00:16:39,880
لا بدّ أنّكما ما زلتُما ضمن نطاق بثّ توهوكو، صحيح؟

206
00:16:40,390 --> 00:16:43,970
حان وقت العرض إذاً

207
00:16:46,460 --> 00:16:50,180
عسى أن يصلكما هذا الفيديو

208
00:17:03,520 --> 00:17:05,010
أهلاً بعودتك يا بيسكو

209
00:17:10,730 --> 00:17:12,430
أعددت خنزيراً مسلوقاً؟

210
00:17:13,200 --> 00:17:18,570
أجل، كان فيه كثيراً من الدّسم، لذا سيكون
مُضرّاً بمعدتك خِلاف ذلك

211
00:17:18,570 --> 00:17:21,090
أزلتُ قدر ما أستطيع وغليتُ اللّحم قليل الدّهن

212
00:17:21,410 --> 00:17:25,440
...بربّك. الدّسم هو أفضل جزء في الخنزير

213
00:17:27,980 --> 00:17:30,040
ما الأمر؟

214
00:17:36,550 --> 00:17:38,360
سمّ فطر التّنويم

215
00:17:39,290 --> 00:17:42,600
ما الّذي يجري؟ لماذا تحاول فعل هذا؟

216
00:17:44,380 --> 00:17:46,620
...بيسكو، من فضلك

217
00:17:47,080 --> 00:17:48,630
—اسمعني

218
00:17:47,710 --> 00:17:48,630
إنّها باوو، أليس كذلك؟

219
00:17:50,030 --> 00:17:53,270
قاعدة شيموبوكي، صحيح؟ أعرف مكانها

220
00:18:04,400 --> 00:18:05,280
!بيسكو

221
00:18:05,650 --> 00:18:07,240
!لا يمكنك! انتظر

222
00:18:08,060 --> 00:18:10,610
!نتحدّث عن أختك هنا

223
00:18:10,610 --> 00:18:12,190
!هل الوقت ملائم الآن للخوف؟

224
00:18:13,950 --> 00:18:17,870
!قلتُ لك ألّا تذهب

225
00:18:18,940 --> 00:18:20,460
أنا طبيب

226
00:18:20,940 --> 00:18:23,890
هل خلتَ بأنّني لن ألاحظ بأنّك تعاني؟

227
00:18:24,490 --> 00:18:28,240
أعلم بأنّ أعضاءك الحيويّة مُحطّمة من الجروح والسمّ

228
00:18:28,240 --> 00:18:32,030
يمكنك التستّر على جانبك الصّدئ، لكن من الواضح
أنّك لا تستطيع توجيه ركلة فعليّة

229
00:18:32,380 --> 00:18:35,580
من الواضح أنّ نظرك أغبش وأنّك تُطلق
السّهام بناء على الفطرة

230
00:18:35,580 --> 00:18:36,790
عرفتُ كلّ ذلك

231
00:18:37,540 --> 00:18:42,000
!أنت أشدّ مرضاً من باوو أو حتّى جابي-سان

232
00:18:42,430 --> 00:18:46,820
من المُحال أن تعود سليماً إذا ذهبت
!لتخاطر بحياتك في وضعك هذا

233
00:18:47,180 --> 00:18:48,670
وماذا يعني؟

234
00:18:49,010 --> 00:18:50,840
أيّما يحدث، هذه حياتي

235
00:18:51,220 --> 00:18:54,220
لمَ أنا مُلزم بجعلِك تعتني بي بهذا الشّكل؟

236
00:18:54,220 --> 00:18:56,500
!لأنّنا صديقان، أليس كذلك؟

237
00:18:56,790 --> 00:18:59,990
أليس التزامك من هذه النّاحية واضحاً؟

238
00:19:00,280 --> 00:19:03,490
!لا يمكن أن نكون أنا وأنت مَدينين لبعضنا الآخر

239
00:19:04,070 --> 00:19:07,990
،أنت أعزّ صديق لي

240
00:19:07,990 --> 00:19:09,870
ولا أريدك أن تموت

241
00:19:10,550 --> 00:19:13,200
أليس هذا واضحاً؟

242
00:19:13,870 --> 00:19:16,210
!لمَ لا يكون واضحاً؟

243
00:19:20,080 --> 00:19:23,130
كنتُ لأقول نفس الكلام لك يا ميلو

244
00:19:23,790 --> 00:19:29,110
يحتاجك النّاس أكثر بكثير ممّا يحتاجونني

245
00:19:29,910 --> 00:19:31,900
إذا كان ينبغي لأحدنا أن يموت أوّلاً، فهو أنا

246
00:19:32,570 --> 00:19:34,270
ابقَ مكانك هنا فحسب

247
00:19:34,660 --> 00:19:36,040
سأعود سريعاً

248
00:19:37,500 --> 00:19:38,770
لن أدعك تذهب

249
00:19:39,500 --> 00:19:42,360
حتّى لو ترتّب عليّ المخاطرة بكلّ شيء

250
00:19:44,020 --> 00:19:48,500
تعلم بأنّني أمهر من أيّ شخص آخر يا ميلو

251
00:19:49,240 --> 00:19:53,740
وتعرف ماذا أفعل للأشخاص الّذين يسحبون
قوسهم عليّ أيضاً

252
00:19:54,910 --> 00:20:02,540
أجل، أعلم. لكنّك لم تعلّمني أن أخسر أمام
رجل مريض على عتبة موته

253
00:20:13,970 --> 00:20:15,720
!ما زلت متخلّفاً عنّي بسنوات

254
00:20:15,990 --> 00:20:17,480
—إن كنت قد فهمت الآن، فاهدأ إذاً

255
00:20:19,600 --> 00:20:23,530
!أنت من ينبغي أن يهدأ يا بيسكو

256
00:20:23,530 --> 00:20:25,740
!تعال إليّ إذاً

257
00:20:27,890 --> 00:20:29,500
!لن أدعك تذهب

258
00:20:30,410 --> 00:20:31,970
!أبداً

259
00:20:38,000 --> 00:20:39,310
تبّاً

260
00:20:43,230 --> 00:20:44,210
!ميلو

261
00:20:45,800 --> 00:20:47,660
أنا آسف يا بيسكو

262
00:20:47,660 --> 00:20:50,120
أحمق، لا تعتذر

263
00:21:03,740 --> 00:21:05,360
اتّخذتُ قراري

264
00:21:05,810 --> 00:21:14,540
هذه المرّة، سأحميك من الجروح بقدر
ما تلقّيت بالنيابة عنّي

265
00:21:14,540 --> 00:21:16,170
سأكون رمحك كذلك

266
00:21:17,290 --> 00:21:23,170
سأخاطر بجسدي الضعيف هذا مع
...قلبي وروحي لأحرص

267
00:21:24,600 --> 00:21:26,460
لأحرص على حمايتك

268
00:21:27,980 --> 00:21:29,380
...ميلو

269
00:21:29,970 --> 00:21:32,570
...لا تنظر إليّ بهذا الشكل

270
00:21:49,380 --> 00:21:53,720
!سأنقذ باوو وجابي-سان بالتأكيد

271
00:23:24,920 --> 00:23:37,060
الحلقة القادمة

272
00:23:25,580 --> 00:23:26,840
قناع الأرنب يتكلّم

273
00:23:26,840 --> 00:23:28,990
كوروكاوا رجل فظيع حقّاً، أليس كذلك؟

274
00:23:28,990 --> 00:23:31,840
حتّى نحن يراودنا هذا الشعور تجاهه

275
00:23:31,840 --> 00:23:34,440
نأمل أن يهزمه أكابوشي فحسب

276
00:23:34,790 --> 00:23:37,050
"الحلقة القادمة: "فخّ شيطانيّ

277
00:23:37,050 --> 00:23:39,510
حظّاً سعيداً يا أكابوشي

278
00:23:37,060 --> 00:23:39,930
فخّ شيطانيّ