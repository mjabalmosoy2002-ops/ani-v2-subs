1
00:00:03,320 --> 00:00:04,400
!مفاجأة

2
00:00:04,870 --> 00:00:08,860
اكتمل نصّ الأداء الأوّل لفرقة هيتوتوسي

3
00:00:11,160 --> 00:00:12,400
تفضّلي

4
00:00:12,400 --> 00:00:13,910
شكراً

5
00:00:13,910 --> 00:00:15,050
خذي يا هينا-تشان

6
00:00:16,140 --> 00:00:17,280
ومايو-تشان

7
00:00:17,280 --> 00:00:18,370
شكراً

8
00:00:23,860 --> 00:00:25,880
أجل. أعجبني

9
00:00:26,180 --> 00:00:27,660
!جيّد

10
00:00:31,200 --> 00:00:33,690
لكن هذه هي الفكرة العامّة التي أريد انتهاجها

11
00:00:33,690 --> 00:00:35,510
!هذا مدهش

12
00:00:40,830 --> 00:00:42,130
...بالنسبة لهذا الجزء

13
00:00:42,130 --> 00:00:44,020
...لنرَ

14
00:00:44,020 --> 00:00:46,650
تبدين سعيدة جدّاً يا مايو-تشان

15
00:00:46,900 --> 00:00:50,520
...حسناً، بما أنّ القصّة قد اكتملت فهذا يعني

16
00:00:50,800 --> 00:00:53,480
يمكننا البدء بتجربة الملابس، صحيح؟

17
00:02:35,060 --> 00:02:38,010
خرجتُ واشتريتُ الملابس المثالية لكلّ واحدة منكن

18
00:02:38,290 --> 00:02:40,740
أودّ أن أراكن تجرّبنها حالاً

19
00:02:41,510 --> 00:02:43,570
أنتِ عجولة جداً، ألستِ كذلك؟

20
00:02:43,570 --> 00:02:46,050
متى تفعل معظم الفرق هذا؟

21
00:02:46,050 --> 00:02:48,280
قُبيل العرض على ما أعتقد

22
00:02:48,280 --> 00:02:50,420
"يطلقون عليه بـ"الموكب

23
00:02:50,420 --> 00:02:51,650
موكب؟

24
00:02:55,240 --> 00:02:57,400
!ليس ذلك النوع من الموكب

25
00:02:57,940 --> 00:02:59,030
ليس كذلك؟

26
00:03:00,260 --> 00:03:02,130
موكب استعراض الملابس يُقام عندما

27
00:03:02,130 --> 00:03:03,970
يصطفّ الممثّلون بملابسهم

28
00:03:03,970 --> 00:03:06,040
لتفقّد كلّ شيء

29
00:03:06,320 --> 00:03:09,970
لذا لا يمكن أن يتمّ هذا
إلّا قُبيل العرض

30
00:03:09,970 --> 00:03:10,680
ماذا؟

31
00:03:10,680 --> 00:03:14,100
هناك بعض الأشياء التي لا يمكن
تفقّدها إلّا بعد الانتهاء جوهرياً من مرحلة التدريب

32
00:03:14,100 --> 00:03:15,040
!ماذا؟

33
00:03:15,040 --> 00:03:16,670
!مستحيل! مستحيل

34
00:03:16,980 --> 00:03:19,840
!أريد أن ألعب معكن جميعاً بملابس ظريفة

35
00:03:19,840 --> 00:03:21,050
!حالاً

36
00:03:21,310 --> 00:03:23,620
...تحوّلت إلى طفلة

37
00:03:21,310 --> 00:03:26,180
!أريد ذلك! أريد ذلك

38
00:03:23,620 --> 00:03:26,810
إن أردتِ فعلها بهذا الإصرار فسنفعلها
على ما أعتقد

39
00:03:29,540 --> 00:03:30,310
نظرة خاطفة

40
00:03:32,790 --> 00:03:34,940
!ظريفة

41
00:03:33,200 --> 00:03:34,940
يلائمكِ

42
00:03:36,620 --> 00:03:39,690
لا أرتدي لباساً كهذا عادة، لذا
فهو جديد عليّ

43
00:03:39,940 --> 00:03:43,700
ألا تعلمين في المقهى إطلاقاً؟

44
00:03:43,700 --> 00:03:46,080
،ساهمتُ مرّة

45
00:03:46,320 --> 00:03:49,630
لكن كان من الصّعب جداً مقاومة
قضم لقمة أو لقمتين

46
00:03:51,170 --> 00:03:52,460
هذا مُحتمل

47
00:03:52,860 --> 00:03:56,840
إضافة إلى أنّ التنانير تبدو غريبة
جدّاً عليّ

48
00:03:57,060 --> 00:03:59,650
حقّاً؟ لكنّها تبدو جميلة للغاية

49
00:03:59,650 --> 00:04:03,090
لكنّها رخوة ومنتفخة جدّاً، من الصعب
التحرّك بها

50
00:04:03,480 --> 00:04:06,130
لا أستطيع الرّكض بأقصى سرعة

51
00:04:06,130 --> 00:04:10,980
لا أظنّ أنّ فرصاً كثيرة ستسنح لكِ
للركض بأقصى سرعة في المقهى

52
00:04:11,280 --> 00:04:14,820
هينا-تشان، كنتِ تساهمين
في المقهى كثيراً، صحيح؟

53
00:04:14,820 --> 00:04:16,750
هل اعتدتِ على ارتداء ملابس خادمة؟

54
00:04:16,750 --> 00:04:20,610
أجل. لم يعد يحرجني كما كان في السّابق

55
00:04:20,610 --> 00:04:23,570
لهذا أحضرتُ لكِ هذا يا هينا-تشان

56
00:04:27,370 --> 00:04:28,480
!مفاجأة

57
00:04:28,480 --> 00:04:30,620
!إنّها فتاة أرنب

58
00:04:32,720 --> 00:04:36,130
مدهش... هذا ظريف جدّاً

59
00:04:36,470 --> 00:04:38,710
!هينا-تشان، تبدين مثيرة

60
00:04:38,710 --> 00:04:41,630
لكن أليس فاضحاً قليلاً؟

61
00:04:44,870 --> 00:04:46,640
!لـ-لا بأس

62
00:04:46,640 --> 00:04:49,350
كلّ ما عليّ فعله هو اعتباره
!زيّاً للمقهى

63
00:04:49,350 --> 00:04:51,520
لماذا تجبرين نفسكِ على هذا؟

64
00:04:54,480 --> 00:04:56,020
!ظريفة للغاية

65
00:04:56,020 --> 00:04:59,250
رأيتُ أنّ يوا-تشان ستبدو ظريفة
بفستان مئزر

66
00:04:59,250 --> 00:05:02,530
أجل، فأنا أبدو ظريفة بأي لباس

67
00:05:04,870 --> 00:05:06,180
،عندما نقف معاً هكذا

68
00:05:06,180 --> 00:05:08,090
ستكونين الأبرز يا هينا-تشان

69
00:05:08,970 --> 00:05:09,970
...معكِ حقّ

70
00:05:09,970 --> 00:05:11,760
!هذا غير صحيح على الإطلاق

71
00:05:11,760 --> 00:05:15,040
عندما نضع هينا-تشان ويوا-تشان معاً

72
00:05:15,490 --> 00:05:16,400
أرأيتن؟

73
00:05:16,400 --> 00:05:18,980
"ستبدوان وكأنّهما من "أليس في بلاد العجائب

74
00:05:18,980 --> 00:05:21,210
حـ-حقّاً؟

75
00:05:21,210 --> 00:05:24,170
...لا تبدو هذه كحكاية خرافيّة بالنسبة لي

76
00:05:24,500 --> 00:05:28,650
أليس والأرنب؟ فهمت

77
00:05:28,650 --> 00:05:31,720
...يبقى الآن

78
00:05:35,430 --> 00:05:36,500
!مذهل

79
00:05:35,430 --> 00:05:39,190
لدى آكي-تشان قوام رشيق، كان من الصّعب
عليّ الاختيار

80
00:05:36,500 --> 00:05:37,570
!يبدو هذا رائعاً

81
00:05:37,570 --> 00:05:39,190
!جميل

82
00:05:41,250 --> 00:05:43,380
شيء كهذا قد يفي بالغرض أيضاً

83
00:05:45,300 --> 00:05:48,010
...أو حتّى هذا في الواقع

84
00:05:49,490 --> 00:05:51,700
!كلّها ظريفة جداً لدرجة تحيّرني

85
00:05:52,050 --> 00:05:55,330
لكن كلّ هذا غير مُدرج في النصّ حتّى

86
00:05:55,330 --> 00:05:57,210
!أجل، أعلم

87
00:05:57,460 --> 00:05:58,880
...أيضأً، أيضاً

88
00:05:58,880 --> 00:06:02,710
أعتقد أنّ شيئاً كهذا سيليق بهينا-تشان
وآكي-تشان أيضاً

89
00:06:06,840 --> 00:06:09,250
!هذه مجرّد ملابس داخليّة

90
00:06:09,250 --> 00:06:12,970
لكن أظنّها مزركشة وظريفة

91
00:06:13,690 --> 00:06:16,000
خرجت مايو-تشان عن السّيطرة

92
00:06:16,000 --> 00:06:17,980
إنّها تتجاوز الحدود بهذا

93
00:06:18,340 --> 00:06:22,500
...لكن إن كانت هذه الملابس ستحسّن عرضنا

94
00:06:22,500 --> 00:06:24,190
!لِمَ تبالغين إلى هذا الحدّ؟

95
00:06:24,190 --> 00:06:27,240
!هل الحقيقة هي أنّكِ تريدين ارتداء هذا؟

96
00:06:28,520 --> 00:06:29,490
...في الواقع

97
00:06:29,770 --> 00:06:32,370
...الحقيقة هي

98
00:06:32,640 --> 00:06:36,850
أمّي قادمة لزيارة قصر هيتوتوتسي قريباً

99
00:06:36,850 --> 00:06:38,000
!ماذا؟

100
00:06:38,220 --> 00:06:41,390
...أردتها أن ترى أداءنا الأول

101
00:06:41,390 --> 00:06:46,700
لذا أريد أن أقدّم عرضاً جيّداً وأريحها

102
00:06:46,700 --> 00:06:50,130
...آسفة لكونه سبباً أنانيّاً، لكن

103
00:06:51,300 --> 00:06:54,780
!لا يجوز أن ترى أمّ هينا-تشان مقهانا فوضويّاً

104
00:06:55,890 --> 00:06:58,520
!عليّ تنظيفه بسرعة

105
00:06:58,800 --> 00:07:01,440
هل تحبّ أمّكِ وجباتها أن تكون منكّهة؟

106
00:07:01,440 --> 00:07:03,560
!سأبدأ في التّمرين على ذلك حالاً

107
00:07:04,250 --> 00:07:07,330
أتعتقدين أننا ينبغي أن نلمّع الأرض؟

108
00:07:07,330 --> 00:07:08,280
!فكرة سديدة

109
00:07:08,530 --> 00:07:10,150
!أريد الحصول على رفوف كتب جديدة أيضاً

110
00:07:10,150 --> 00:07:13,410
وفي طريقنا، هل ينبغي أن نعيد ترميم المطبخ أيضاً؟

111
00:07:13,410 --> 00:07:15,780
ينبغي إذاً أن نغيّر ورق الجدران

112
00:07:16,540 --> 00:07:19,540
عليكن بذل كلّ هذا المجهود
في التّدريب

113
00:07:20,650 --> 00:07:21,790
تبّاً

114
00:07:21,790 --> 00:07:24,170
كان ينبغي أن تخبرينا بذلك من قبل

115
00:07:24,170 --> 00:07:25,790
لا تكوني غريبة

116
00:07:26,630 --> 00:07:30,890
كلّنا شريكات في فرقة هيتوتوسي

117
00:07:30,890 --> 00:07:32,620
سنساعدكِ بالطبع

118
00:07:32,620 --> 00:07:34,070
هذا صحيح يا هينا-تشان

119
00:07:34,070 --> 00:07:35,920
دعي الأمر علينا جميعاً فحسب

120
00:07:35,920 --> 00:07:39,870
لنقدّم أداء عظيماً لأجلِ أمّ هينا-تشان

121
00:07:39,870 --> 00:07:40,640
!أجل

122
00:07:43,490 --> 00:07:45,790
!شكراً لكُن جميعاً

123
00:07:50,480 --> 00:07:52,290
،الآن بعد أن تمّت تسوية كلّ شيء

124
00:07:52,290 --> 00:07:54,820
ما رأيكن أن نشرب النخب؟

125
00:07:54,820 --> 00:07:57,430
...ونتناول طعاماً خفيفاً ما في نفس الوقت

126
00:07:59,650 --> 00:08:02,700
الوقت مبكّر قليلاً، لكن ما رأيكن
أن نتعشّى؟

127
00:08:02,700 --> 00:08:04,330
!مرحى

128
00:08:06,740 --> 00:08:08,130
تفضّلي

129
00:08:08,130 --> 00:08:09,340
شكراً لكِ

130
00:08:10,850 --> 00:08:13,340
من سيبدأ بشرب النخب؟

131
00:08:17,500 --> 00:08:22,400
،أعتقد أنّ رئيسة فرقة هيتوتوسي، هينا-تشان
هي من ينبغي أن تفعل ذلك

132
00:08:22,400 --> 00:08:24,230
ماذا؟

133
00:08:24,470 --> 00:08:26,160
هيّا، لا تخجلي

134
00:08:26,160 --> 00:08:27,730
مشروبنا جاهز جميعاً

135
00:08:28,720 --> 00:08:30,860
لم أعد أحتمل الانتظار

136
00:08:30,860 --> 00:08:32,890
!حـ-حسناً

137
00:08:32,890 --> 00:08:34,900
...إ-إذاً

138
00:08:36,680 --> 00:08:41,500
لنجاح الأداء الأوّل لفرقة هيتوتوسي

139
00:08:42,020 --> 00:08:45,620
!بصحّتكن

140
00:08:52,580 --> 00:08:54,010
يبدو هذا لذيذاً

141
00:08:54,010 --> 00:08:54,910
هل تودّين قليلاً؟

142
00:08:54,910 --> 00:08:56,560
!أجل! شكراً

143
00:08:56,560 --> 00:08:57,890
تحياتي

144
00:08:59,160 --> 00:09:01,890
هل تقيمين حفل أزياء اليوم أو ما شابه؟

145
00:09:01,890 --> 00:09:03,830
...لا، في الواقع

146
00:09:03,830 --> 00:09:07,360
أتيتُ لأنني سمعتُ أنّكن أنهيتن النصّ

147
00:09:07,360 --> 00:09:11,400
أجل، لهذا كنّا نقيمُ موكبَ استعراض
ملابس مبكّر

148
00:09:11,720 --> 00:09:14,630
سينسي، هل ترغبين أن ترتدي لباساً أيضاً؟

149
00:09:14,630 --> 00:09:17,410
!تفعّلت رغبة مايو-تشان مجدّداً

150
00:09:19,440 --> 00:09:22,490
هذا هو الطريق الذي تسلكنه إذاً

151
00:09:22,490 --> 00:09:26,190
كنتُ آمل أن أطلب منكِ المشورة حول
كيفيّة المضيّ بهذا العمل منذُ بدأتُ بكتابته

152
00:09:26,190 --> 00:09:29,650
أجل، لدينا مساحة مسرحيّة محدودة

153
00:09:29,650 --> 00:09:32,670
!كان هذا يوماً مليئاً بالإنجاز

154
00:09:34,960 --> 00:09:37,040
بقي لباس واحد فقط

155
00:09:37,040 --> 00:09:38,920
هذا فستان جميل

156
00:09:38,920 --> 00:09:41,310
أجل، وكأنّه لباس أميرة

157
00:09:44,200 --> 00:09:45,220
!مايو-تشان

158
00:09:45,220 --> 00:09:46,180
نعم؟

159
00:09:46,180 --> 00:09:49,070
بما أنّنا لدينا هذا اللّباس فما رأيكِ
أن تجرّبيه؟

160
00:09:49,850 --> 00:09:53,440
قلتِ أنّكِ أردتِ أن تكوني أميرة

161
00:09:53,440 --> 00:09:54,420
!ماذا؟

162
00:09:54,420 --> 00:09:56,320
ويبدو أنّه ملائم لمقاسكِ

163
00:10:08,460 --> 00:10:10,250
!أنتِ ظريفة جداً يا مايو-تشان

164
00:10:10,250 --> 00:10:12,020
يليق بكِ كثيراً

165
00:10:12,020 --> 00:10:13,700
!وكأنّه فُصّل بحسب الطلب

166
00:10:13,700 --> 00:10:16,110
!تبدين كأميرة حقاً

167
00:10:18,340 --> 00:10:22,220
!أشعر بتعارض كبير

168
00:10:24,820 --> 00:10:25,800
ما المشكلة؟

169
00:10:25,800 --> 00:10:27,380
!إنّه يليق بكِ

170
00:10:28,100 --> 00:10:29,190
...حسناً

171
00:10:30,270 --> 00:10:33,400
هل نقرأ الآن؟

172
00:10:33,400 --> 00:10:35,800
الآن؟

173
00:10:36,490 --> 00:10:39,250
أمامنا بضعة أسابيع فقط لبدء الأداء

174
00:10:39,250 --> 00:10:42,570
لا يجوز أن نهدر لحظة واحدة

175
00:10:42,570 --> 00:10:43,780
،لكن إن بدأنا الآن

176
00:10:44,130 --> 00:10:47,160
فقد تتأخّرين كثيراً عن العودة إلى المنزل

177
00:10:47,780 --> 00:10:50,070
لا حاجة للقلق

178
00:10:50,070 --> 00:10:51,920
أتيتُ متحضّرة

179
00:10:57,630 --> 00:11:01,160
نـنويتِ قضاء اللّيلة هنا

180
00:11:01,160 --> 00:11:04,050
...غداً هو يوم الأحد، ما يعني

181
00:11:04,840 --> 00:11:06,560
!مخيّم تدريب دون سابق إعداد

182
00:11:07,920 --> 00:11:09,910
...هذا مفاجئ جداً

183
00:11:09,910 --> 00:11:12,880
هيّا، بدّلن ملابسكن بثياب النّوم

184
00:11:12,880 --> 00:11:14,190
لماذا؟

185
00:11:14,450 --> 00:11:17,120
،تجري هذه المسرحيّة في أرض أحلام

186
00:11:17,120 --> 00:11:18,770
بلد أعجوبة

187
00:11:18,770 --> 00:11:22,570
ألا تعتقدن أنّ ثياب النوم هي الأمثل
للانخراط في الجوّ؟

188
00:11:22,880 --> 00:11:26,570
"هذه ليست "أرض أحلام

189
00:11:26,570 --> 00:11:28,200
"بل "أرض العجائب

190
00:11:30,420 --> 00:11:32,340
!يبدو هذام ثيراً للاهتمام

191
00:11:32,340 --> 00:11:34,360
!سأبدّل ملابسي حالاً

192
00:11:37,330 --> 00:11:39,330
...سهرة بيجامات

193
00:11:41,890 --> 00:11:45,120
أعتقد أنّ روري-تشان تحبّ مثل هذه الأمور

194
00:11:46,760 --> 00:11:50,560
...لكن لم أحضر ملابس نوم أو ما شابه

195
00:11:51,350 --> 00:11:53,980
لا تقلقي، دعي الأمر لي

196
00:11:53,980 --> 00:11:56,400
يمكنكِ أن تستعيري ثياب نومي

197
00:11:56,400 --> 00:12:00,860
لديّ ثياب نوم لطيفة ومناسبة جدّاً للناضجاتِ مثلكِ

198
00:12:08,370 --> 00:12:10,250
من أنتِ بالضبط؟

199
00:12:10,620 --> 00:12:13,250
تبدين كطفلة تماماً

200
00:12:13,250 --> 00:12:14,500
أنتِ لا تمزحين

201
00:12:14,500 --> 00:12:15,040
ماذا؟

202
00:12:15,040 --> 00:12:16,000
...آسفة

203
00:12:16,400 --> 00:12:19,360
!رغم ما أبدو عليه، أنا بالغة

204
00:12:19,360 --> 00:12:23,990
تبدين صغيرة جداً، ظننتكِ طفلة

205
00:12:22,450 --> 00:12:27,010
...ربّما ناضج زيادة عن اللزوم

206
00:12:24,980 --> 00:12:26,510
يوا-تشان؟

207
00:12:40,600 --> 00:12:51,330
!تعالوا وشاهدوا من فضلكم

208
00:12:52,100 --> 00:12:54,620
...حان قوت العرض أخيراً

209
00:12:54,620 --> 00:12:56,410
أنا قلقة

210
00:12:56,410 --> 00:12:59,590
...سار كلّ شيء بشكل مثالي في التدريب، لكن

211
00:12:59,860 --> 00:13:01,210
!هيناكو

212
00:13:04,220 --> 00:13:06,090
!لم أركِ منذ وقت

213
00:13:06,090 --> 00:13:07,590
!أمّي

214
00:13:08,880 --> 00:13:11,850
!كيف حالكِ؟ اشتقتُ إليكِ

215
00:13:13,300 --> 00:13:14,420
ما أخبار المدرسة؟

216
00:13:14,420 --> 00:13:16,420
ازداد طول قامتكِ قليلاً، صحيح؟

217
00:13:15,480 --> 00:13:16,420
...عـ-عفواً

218
00:13:16,420 --> 00:13:17,730
هل تأكلين جيّداً؟

219
00:13:17,730 --> 00:13:18,700
...عفواً

220
00:13:18,700 --> 00:13:20,610
!هذا لباس ظريف

221
00:13:20,610 --> 00:13:22,280
أحضرتُ بعض الأشياء لتشجيعكِ

222
00:13:22,280 --> 00:13:23,610
أتعتقدين أنّ هذا يكفي؟

223
00:13:23,880 --> 00:13:25,570
لتشجيعين؟

224
00:13:25,570 --> 00:13:28,210
يبدو أنّ هناك بعض الوقت قبل الأداء

225
00:13:28,210 --> 00:13:28,620
ماذا؟

226
00:13:31,060 --> 00:13:33,410
سأتفقّد طوكيو

227
00:13:33,410 --> 00:13:34,710
اهتمّي بأغراضي، حسناً؟

228
00:13:34,710 --> 00:13:36,000
...حـ-حسناً

229
00:13:36,000 --> 00:13:38,770
...حسناً يا هيناكو

230
00:13:38,770 --> 00:13:41,750
!حظّاً موفقاً

231
00:13:44,370 --> 00:13:47,760
!أمّكِ اجتماعية كثيراً بخلافكِ

232
00:13:50,660 --> 00:13:54,520
ماذا؟ ذهبت أمّكِ للسياحة؟

233
00:13:54,520 --> 00:13:56,390
أردتُ أن ألتقي بها

234
00:13:56,680 --> 00:14:00,000
بصفتي مالكة منزلكِ، كنتُ آمل أن أتكلّم معها

235
00:14:00,000 --> 00:14:01,400
...آسفة

236
00:14:01,400 --> 00:14:07,530
لطالما كانت أمّي نشطة واجتماعيّة وعمليّة

237
00:14:07,980 --> 00:14:10,530
إنّها بعكسي تماماً

238
00:14:10,530 --> 00:14:14,290
طـ-طبيعي، كثير من الأطفال لا يشبهون آبائهم

239
00:14:14,560 --> 00:14:17,790
،كانت أمّي مدرّبة مراسم شاي

240
00:14:17,790 --> 00:14:19,420
لهذا كانت صارمة في مسألة آداب السلوك

241
00:14:20,310 --> 00:14:22,680
ذوقنا مختلف في مسألة الملابس أيضاً

242
00:14:22,680 --> 00:14:24,180
هذا غير ممتع

243
00:14:25,780 --> 00:14:28,430
،وأبي يتمتّع بروح حرّة

244
00:14:28,690 --> 00:14:32,190
لذا عليّ أن أبلي حسناً في إدارة المحلّات

245
00:14:32,190 --> 00:14:35,810
بالنسبة لكِ، هذه مشكلة كبيرة جداً

246
00:14:35,810 --> 00:14:39,270
!مرحى يا صديق

247
00:14:49,610 --> 00:14:50,910
تفضّلي

248
00:14:50,910 --> 00:14:53,030
!أهلاً بكِ في هيتوتوسي

249
00:14:53,030 --> 00:14:55,440
هل قرّرتِ ما تودّين أن تطلبيه؟

250
00:14:55,440 --> 00:14:57,790
هذا ما ننصح به اليوم

251
00:15:07,460 --> 00:15:10,210
مقاعد الجمهور قد امتلأت بالكامل

252
00:15:10,210 --> 00:15:12,050
هل أنتِ بخير؟

253
00:15:12,640 --> 00:15:15,870
ما-ما زلتُ بخير الآن

254
00:15:15,870 --> 00:15:19,020
لكن أشعر وكأنّني سأتوتّر عندما أرى أمّي

255
00:15:19,020 --> 00:15:21,100
تحياتي جميعاً

256
00:15:23,020 --> 00:15:27,100
سأشاهد أداءكن مع أمّي اليوم

257
00:15:27,100 --> 00:15:28,190
مرحباً

258
00:15:28,190 --> 00:15:30,770
!رأيتها في التلفزيون

259
00:15:30,770 --> 00:15:32,420
...أظنّها عارضة أزياء

260
00:15:32,420 --> 00:15:35,310
الجميع في عائلة سينسي مشاهير

261
00:15:36,210 --> 00:15:40,080
أصبحت هينا-تشان فزّاعة
بعد رؤية أمّ سينسي

262
00:15:45,350 --> 00:15:48,650
لماذا تتوتّرين من رؤية أمّ
!شخص آخر؟

263
00:15:50,230 --> 00:15:53,590
حسناً، أوصي بهذا

264
00:15:53,890 --> 00:15:57,600
.أريد من هذا بحجم كبير
وهل يمكنكِ إيقاده بالكحول؟

265
00:15:57,600 --> 00:16:02,980
آسفة، لكن لا نقدّم شراباً كحوليّاً هنا

266
00:16:03,410 --> 00:16:05,470
حسناً، خذن نفساً عميقاً

267
00:16:06,630 --> 00:16:08,150
وزفير

268
00:16:10,330 --> 00:16:14,880
من المتلف للأعصاب أن تشاهدنا عائلاتنا، أليس كذلك؟

269
00:16:14,880 --> 00:16:18,990
لم أكن أحبّ يوم اجتماع أولوياء الأمور
في المدرسة عندما كنتُ صغيرة أيضاً

270
00:16:19,330 --> 00:16:21,380
،عندما كان عليّ أن أقرأ بصوت عال

271
00:16:19,330 --> 00:16:21,380
أمسك بمظلّته فوق الثعلب...

272
00:16:21,380 --> 00:16:24,000
أمسكتُ بكتابي بالمقلوب عن طريق الخطأ

273
00:16:21,380 --> 00:16:25,760
،نظر الثعلب إلى العجوز متفاجئاً

274
00:16:24,000 --> 00:16:28,750
لكن كنتُ قد حفظتُ الكتاب كلّه
لذا لم تكن مشكلة

275
00:16:25,760 --> 00:16:28,750
ثمّ نبح بسعادة

276
00:16:29,020 --> 00:16:34,010
ذات مرّة نسيتُ عباراتي وأنا على خشبةِ المسرح

277
00:16:34,010 --> 00:16:38,140
...وأكملتُ الباقي من خلال الارتجال، لكن مع ذلك

278
00:16:38,140 --> 00:16:41,690
هـ-هذا صحيح، إن بقيتِ تتمنّين ولم تستسلمي

279
00:16:41,690 --> 00:16:43,520
!فسوف يتحقّق حلمكِ

280
00:16:43,520 --> 00:16:46,650
...أجل، لأنّكما عبقريّتان

281
00:16:47,170 --> 00:16:50,210
في الواقع، إن أقنعتِ نفسكِ أنّه لا بأس
إن أخطأتِ

282
00:16:50,210 --> 00:16:52,220
فلن تتوتّري

283
00:16:52,220 --> 00:16:54,150
حـ-حقّاً؟

284
00:16:54,150 --> 00:16:59,340
أخطأتُ ذات مرّة أثناء عزف راقص
وسقطتُ على الجمهور

285
00:16:59,340 --> 00:17:03,040
لكن عدتُ إلى المسرح وتابعتُ الرقص
حتّى النهاية

286
00:17:03,300 --> 00:17:06,320
!حتّى أنا، يوا-ساما العظيمة، أقلق أحياناً

287
00:17:06,320 --> 00:17:08,120
!لذا لا تشعري بالاستياء

288
00:17:10,320 --> 00:17:12,550
!يوا-تشان، أنتِ مدهشة

289
00:17:12,550 --> 00:17:16,100
!ما كنتُ لأتعافى أبداً من شيء كهذا

290
00:17:16,100 --> 00:17:19,240
...مجرّد تخيّل ذلك يجعلني أبدأ بالارتجاف

291
00:17:20,280 --> 00:17:22,930
!تبّاً! خلّف هذا أثراً عكسيّاً

292
00:17:23,490 --> 00:17:28,560
لا، اسمعي! ما أحاول أن أقوله لكِ
هو أنّه لا داعي لتخافي من ارتكاب خطأ

293
00:17:28,560 --> 00:17:29,630
هينا-تشان

294
00:17:30,350 --> 00:17:33,190
تذكّري مسرحيّتنا في المهرجان الثّقافي فحسب

295
00:17:33,640 --> 00:17:35,310
المهرجان الثّقافي؟

296
00:17:35,310 --> 00:17:37,950
أجل. أتذكرين المنديل؟

297
00:17:43,220 --> 00:17:46,400
في الواقع، معكِ حقّ. سارت الأمور
على ما يُرام فحسب، أليس كذلك؟

298
00:17:46,400 --> 00:17:47,840
هذا صحيح

299
00:17:47,840 --> 00:17:50,710
لذا لا ينبغي أن تخافي من ارتكابِ الأخطاء

300
00:17:53,080 --> 00:17:56,140
!نجحتِ في تحسين شعور هينا-تشان

301
00:17:56,140 --> 00:17:58,520
!أعلم أنّني أخطئ طوال الوقت، مفهوم؟

302
00:18:01,620 --> 00:18:04,720
سنكون معكِ لمساعدتكِ، لذا لا تقلقي

303
00:18:05,050 --> 00:18:08,490
لندع أمّكِ ترى كم أنتِ رائعة

304
00:18:08,490 --> 00:18:10,610
!أ-أجل

305
00:18:13,980 --> 00:18:16,990
!لـ-لنفعلها

306
00:18:17,370 --> 00:18:19,240
!أجل

307
00:18:19,890 --> 00:18:21,120
هذا صحيح

308
00:18:21,620 --> 00:18:24,130
،لأجلِ كلّ هؤلاء الفتيات اللّاتي يدعمنني

309
00:18:24,130 --> 00:18:26,870
عليّ أن أنجِح أداءنا الأوّل

310
00:18:37,310 --> 00:18:40,390
...تهيّأتُ نفسياً قبل الخروج إلى هنا، لكن

311
00:18:40,390 --> 00:18:43,510
!هيناكو! أبدعي

312
00:18:41,390 --> 00:18:42,390
هيناكو

313
00:18:42,390 --> 00:18:43,510
هينابون

314
00:18:43,740 --> 00:18:45,760
!أنا هنا أشاهدكِ

315
00:18:45,760 --> 00:18:47,890
!أمّكِ معكِ

316
00:18:48,180 --> 00:18:51,600
!إنّها توتّرني حقاً

317
00:18:48,180 --> 00:18:52,660
!مرحى! مرحى! هيّا! هيّا! هيناكو

318
00:18:53,920 --> 00:18:56,760
...تتحوّل هينا-تشان إلى فزّاعة

319
00:19:01,010 --> 00:19:05,180
قبل أن نبدأ، أودّ أن أقول
بضع كلمات بصفتي مالكة المقهى

320
00:19:09,150 --> 00:19:13,520
محلّانا، مكتبة هيتوتوسي للكتب المُستعملة
ومقهى هيتوتوسي

321
00:19:12,640 --> 00:19:15,200
هينا-تشان، انظري هناك

322
00:19:13,520 --> 00:19:16,920
أنتجا هذه المسرحيّة لترفيه الزبائن

323
00:19:15,200 --> 00:19:15,920
ماذا؟

324
00:19:16,920 --> 00:19:21,930
الذين يزوروننا أثناء فترة سباق
الأختام في حيّ التسوّق

325
00:19:19,250 --> 00:19:21,930
البطاقات القرينة المُعدّة بلُفافات
...القائمة الرئيسيّة للمقهى

326
00:19:21,930 --> 00:19:24,930
هذا هو الأداء الأوّل لفرقتنا المسرحيّة

327
00:19:22,190 --> 00:19:24,930
سهرت مايو-تشان اللّيل كلّه وهي تحضّرها

328
00:19:24,930 --> 00:19:30,190
لكن نأمل أن نكسب دعمكم المستقبليّ
كي نتطوّر

329
00:19:26,350 --> 00:19:30,190
انظري إلى مايو-تشان وهي تقف جاهدة
لتُظهر لنا عباراتنا

330
00:19:30,190 --> 00:19:31,980
ليُسكِن هذا روحكِ

331
00:19:30,190 --> 00:19:34,310
وأيضاً أختامنا في سباق الأختام

332
00:19:31,980 --> 00:19:38,370
،يمكن جمعها عند الطاولة خارج المقهى

333
00:19:32,240 --> 00:19:33,790
!أهذا ما قصدتِه؟

334
00:19:33,790 --> 00:19:36,070
!لا تقفي مكتوفة الأيدي طوال الوقت

335
00:19:36,930 --> 00:19:40,450
سأتحرّك أولاً، لذا عليكِ أن تتبعيني فحسب

336
00:19:38,370 --> 00:19:40,450
لذا زوروها لاحقاً رجاء

337
00:19:41,980 --> 00:19:44,870
...يفعلن كلّ هذا لأجلي فقط

338
00:19:51,930 --> 00:19:53,150
هذا صحيح

339
00:19:53,150 --> 00:19:56,460
أنا لا أقف على هذا المسرح لوحدي

340
00:20:00,640 --> 00:20:02,470
أين أنا؟

341
00:20:02,730 --> 00:20:05,470
ما هذا المكان الذي أتيتُ إليه؟

342
00:20:05,820 --> 00:20:08,350
ومن أنتِ؟

343
00:20:08,970 --> 00:20:12,100
اسمحي لي أن أرحّب بكِ يا آنسة

344
00:20:12,690 --> 00:20:16,360
أهلاً بكِ في بلاد مثيرة جداً
لن تعرفي النوم فيها

345
00:20:16,700 --> 00:20:20,110
أهلاً بكِ في بلاد غاية في المتعة، لن
تتمكّني من مغادرتها

346
00:20:20,500 --> 00:20:23,490
أهلاً بكِ في بلاد العجائب

347
00:20:23,840 --> 00:20:26,440
سأري أمّي

348
00:20:26,440 --> 00:20:30,570
أفضل مسرحيّة يمكنني أداؤها
!مع صديقاتي الرّائعات

349
00:20:38,610 --> 00:20:41,130
!أنا آسفة جميعاً

350
00:20:41,540 --> 00:20:43,730
،أنا الرّئيسة

351
00:20:43,730 --> 00:20:47,510
...لكن جعلتُكن تواجهن كلّ هذه المتاعب

352
00:20:47,780 --> 00:20:51,650
صحّحنا مسار كلّ شيء، لذا لا داعي للقلق

353
00:20:51,650 --> 00:20:54,520
لم يبدُ الجمهور يمانع أيضاً

354
00:20:54,520 --> 00:20:56,200
...لكن

355
00:20:56,200 --> 00:20:59,020
،لم تكوني تتحرّكين إطلاقاً في البداية

356
00:20:59,020 --> 00:21:01,780
لهذا ظننتكِ كنتِ تلعبين دور
فزّاعة أو ما شابه

357
00:21:08,300 --> 00:21:11,250
لكن بعدها أدّيتِ دوركِ حتّى آخر لحظة

358
00:21:11,250 --> 00:21:12,790
أبليتِ حسناً

359
00:21:13,030 --> 00:21:15,420
لقد نضجتِ يا هيناكو

360
00:21:15,810 --> 00:21:17,670
...أمّي

361
00:21:17,670 --> 00:21:19,520
أليس هذا رائعاً يا هينا-تشان؟

362
00:21:19,520 --> 00:21:21,710
لقد أرحتِ أمّكِ

363
00:21:22,040 --> 00:21:24,860
!أجل! شكراً

364
00:21:24,860 --> 00:21:26,590
!يعزو الفضل إليكن جميعاً

365
00:21:27,460 --> 00:21:32,350
!أنا مسرورة جداً لمجيئي إلى قصر هيتوتوسي

366
00:21:32,600 --> 00:21:36,350
حسناً، حان الوقتُ لأستقلّ قطاري، أنا ذاهبة

367
00:21:37,300 --> 00:21:40,300
!يا فتيات، اعتنين بهيناكو لأجلي

368
00:21:52,490 --> 00:21:54,540
إنّها كعاصفة

369
00:23:26,330 --> 00:23:29,300
حدثت أمور كثيرة

370
00:23:29,300 --> 00:23:31,530
منذ مجيء هينا-تشان إلى قصر هيتوتوسي

371
00:23:32,050 --> 00:23:36,040
آمل أن تكون السنة المقبلة سنة جيّدة أيضاً

372
00:23:36,610 --> 00:23:39,440
"الحلقة القادمة "من سنة إلى أخرى