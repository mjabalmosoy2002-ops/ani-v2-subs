1
00:00:09,010 --> 00:00:09,630
!أيتها القائدة

2
00:01:58,180 --> 00:01:59,140
!فيردي

3
00:01:59,140 --> 00:02:00,010
ما الذي يجري؟

4
00:02:01,890 --> 00:02:04,520
سأختفي عمّا قريب

5
00:02:05,100 --> 00:02:06,980
،ما دامت هذه الأغنية تغنى

6
00:02:07,810 --> 00:02:11,400
فلا أستطيع الحفاظ على هيئتي الحقيقيّة

7
00:02:13,070 --> 00:02:14,150
أريا

8
00:02:14,610 --> 00:02:16,110
...أريا

9
00:02:17,070 --> 00:02:19,160
لقد أردتُ تحقيق حلمكِ

10
00:02:19,160 --> 00:02:20,660
!جاول-ساما

11
00:02:20,660 --> 00:02:21,660
!شينكو

12
00:02:21,660 --> 00:02:22,580
!يا رفاق

13
00:02:22,580 --> 00:02:23,160
!الجميع

14
00:02:23,830 --> 00:02:25,160
!البطل

15
00:02:29,380 --> 00:02:32,130
إن أغنية الشفاء تنقّيه

16
00:02:33,960 --> 00:02:35,670
هل بإمكاننا إيقاف ذلك؟

17
00:02:35,670 --> 00:02:36,880
!إنه شيطان

18
00:02:37,430 --> 00:02:39,180
!إنه تابع

19
00:02:41,050 --> 00:02:43,600
...حسنٌ، فعلا هو كذلك، لكن

20
00:02:43,600 --> 00:02:46,020
تشارل، أنا أطلب منكِ ذلك أيضًا

21
00:02:46,520 --> 00:02:48,560
لا زلنا بحاجةٍ إلى التحدث عن بعض الأشياء الإضافيّة

22
00:02:57,240 --> 00:03:00,370
إذن استخدما كريستالتيّ البطل الخاصتين بكما

23
00:03:00,820 --> 00:03:04,240
بإمكانكما صنع حاجز لإبقاءه آمنًا من قوّة الأغنية

24
00:03:04,240 --> 00:03:05,200
فهمت

25
00:03:05,200 --> 00:03:06,000
شكرًا

26
00:03:07,290 --> 00:03:08,870
لا تلوماني على أيًّا ما يحصل

27
00:03:10,460 --> 00:03:12,130
،كريستالتيّ البطل

28
00:03:13,380 --> 00:03:14,800
!تفعيل

29
00:03:28,480 --> 00:03:30,480
لم أعلم بأنه يُمكن استخدامهما هكذا

30
00:03:30,480 --> 00:03:33,020
ولا أنا. لا أستطيع حتّى سماع الأغنية بعد الآن

31
00:03:42,870 --> 00:03:43,830
،جاول

32
00:03:44,370 --> 00:03:46,870
أيها الجميع، أنا آسفة

33
00:03:46,870 --> 00:03:48,290
لقد كان هذا خطأي

34
00:03:48,750 --> 00:03:52,330
لم أعُر فيردي اهتمامًا كافيًا

35
00:03:52,880 --> 00:03:57,050
لم أدرك ما كان يفكّر به

36
00:03:58,170 --> 00:04:01,380
،لقد حلمت بالذهاب إلى السطح

37
00:04:01,380 --> 00:04:05,560
!وكلّ ما فعله فيردي قد كان محاولة تحقيق تلك الأمنية

38
00:04:17,860 --> 00:04:19,240
أهلًا يا فيردي

39
00:04:33,330 --> 00:04:37,340
،لا أعرف القصّة كاملةً، ناهيكَ عن فهم مشاعرك

40
00:04:38,130 --> 00:04:43,090
لكن مهما كان السبب، فلا يجب على الرجل أن يُبكي امرأة أبدًا

41
00:04:43,510 --> 00:04:46,550
،ربما تكونين قد اقترفتِ خطئًا

42
00:04:47,310 --> 00:04:50,980
لكن الاكتفاء بالبكاء والاعتذار لن يحلّ أي شيء

43
00:04:50,980 --> 00:04:55,980
بالإضافة، الحلم بالمستقبل ليس أمرًا سيئًا

44
00:05:01,190 --> 00:05:02,990
أنا آسفة يا فيردي

45
00:05:03,610 --> 00:05:06,740
لقد جعلتك حزينًا

46
00:05:08,950 --> 00:05:10,500
إنه ليس خطأكِ يا أريا

47
00:05:12,660 --> 00:05:16,040
أنا شيطان. تابع

48
00:05:16,750 --> 00:05:18,710
،حتى لو كنت شيطانًا أو تابعًا

49
00:05:19,250 --> 00:05:21,010
فأنت لا زلت فيردي

50
00:05:21,510 --> 00:05:24,550
لطالما كنت معي عندما كنت أشعر بالوحدة

51
00:05:25,300 --> 00:05:28,220
لقد كنت دائمًا تفكّر بي

52
00:05:28,890 --> 00:05:31,600
لقد حاولتَ فعل كل شيء في وسعك من أجلي

53
00:05:32,680 --> 00:05:36,770
أنت ما زلت نفس فيردي الطيّب الذي أحبّه

54
00:05:52,450 --> 00:05:53,160
ماذا يكون ذلك؟

55
00:05:54,660 --> 00:05:55,330
!كلا

56
00:05:55,330 --> 00:05:56,670
!مهلًا

57
00:05:57,250 --> 00:05:58,290
...ذلك الضوء هو

58
00:06:05,050 --> 00:06:06,180
نصلٌ ملعون

59
00:06:08,930 --> 00:06:09,930
لقد تحطّم

60
00:06:10,260 --> 00:06:11,510
لقد عرفت ذلك

61
00:06:11,510 --> 00:06:13,680
لقد كان ممسوسًا بواسطة نصل ملعون

62
00:06:14,100 --> 00:06:15,940
أنا آسف يا أريا

63
00:06:17,850 --> 00:06:19,810
،يا أبطال السطح

64
00:06:20,320 --> 00:06:21,440
أنا آسف

65
00:06:35,080 --> 00:06:36,000
ما هذا؟

66
00:06:36,000 --> 00:06:37,500
لا تقلقي

67
00:06:37,500 --> 00:06:39,330
هذا تغيُّرٌ نحو الأفضل

68
00:06:51,350 --> 00:06:57,600
سوف يستعيد فيردي هيئته الأصلية ببطءٍ بداخل الكريستالة

69
00:06:58,230 --> 00:07:03,070
على الأرجح بأنه قد كان في الأصل روحًا ذات مستوًى عالٍ أو خادمًا لآلهة محليَّة

70
00:07:03,730 --> 00:07:08,610
تملّكهُ النصل الملعون وحوّله إلى تابعٍ للمرض

71
00:07:09,070 --> 00:07:15,330
...عادةً سوف يستغرقه استرجاع هيئته الأصلية وقتًا طويلًا للغاية، لكن

72
00:07:15,330 --> 00:07:20,500
،لو أبقيتِه بجواركِ، وغنّيتِ له أغانٍ لطيفة...

73
00:07:21,080 --> 00:07:23,800
فلربما يستيقظ قريبًا جدًّا

74
00:07:23,800 --> 00:07:25,130
ذلك صحيح

75
00:07:26,920 --> 00:07:27,720
نعم

76
00:07:29,430 --> 00:07:30,640
...صوتها

77
00:07:30,640 --> 00:07:32,140
إنه حقًّا جميل

78
00:07:58,500 --> 00:07:59,790
!أريا-سان

79
00:08:00,080 --> 00:08:01,540
ربيكّا-سان

80
00:08:01,540 --> 00:08:03,750
أنا آسفة لأنني أقلقتكِ

81
00:08:03,750 --> 00:08:06,590
الشيء ذاته ينطبق عليكِ يا أميرة العالم السطحيّ

82
00:08:06,590 --> 00:08:08,670
،اسمي ملهيوري

83
00:08:08,670 --> 00:08:11,300
وأنا مسرورةٌ بلقائكِ أيتها المطربة من البحر السماويّ

84
00:08:11,930 --> 00:08:16,390
لقد تمّ اختياري لقيادة سكّان السماء في غناء أغنية شفائيّة للمهرجان النجميّ

85
00:08:17,060 --> 00:08:20,690
أيتها الأميرة ملهيوري، هلَّا انضممتِ إليّ؟

86
00:08:21,810 --> 00:08:25,190
!أجل، أودّ ذلك

87
00:08:50,380 --> 00:08:52,260
هذه مساعدة كبيرة يا كوفيرت-ساما

88
00:08:52,260 --> 00:08:54,220
!إنه لا شيء

89
00:09:09,900 --> 00:09:13,740
،يا سكّان السطح، ويا كاهنة التنانين تشارل

90
00:09:13,740 --> 00:09:17,080
دعوني أشكركم مرةً أخرى

91
00:09:17,740 --> 00:09:22,500
لقد استغرقَ الأمر وقتًا طويلًا، لكني قد تمكّنت أخيرًا من تحديد مكان تنين النار

92
00:09:22,870 --> 00:09:24,500
!مرحى

93
00:09:25,380 --> 00:09:28,380
الآن لم يتبقَّ لنا شيءٌ لنقلق بشأنه

94
00:09:29,130 --> 00:09:30,510
آن الأوان لقول الوداع

95
00:09:30,510 --> 00:09:31,920
أجل

96
00:09:31,920 --> 00:09:33,430
...لكن قبل ذلك

97
00:09:33,430 --> 00:09:34,630
!صحيح

98
00:09:34,630 --> 00:09:40,680
أودّ إعطائكم شيءٌ ما لأعبّر عن امتناني
لجهوداتكم والشجاعة التي أظهرتموها

99
00:09:54,490 --> 00:09:55,280
ماذا يكون ذلك؟

100
00:09:55,280 --> 00:09:59,660
!"أعتقد بأنهم يسمون جنسه على السطح بـ"الوحوش الخياليّة" أو "الوحوش المقدّسة

101
00:09:59,660 --> 00:10:03,160
!إن "الوحوش الخياليّة" أسطوريّة

102
00:10:03,160 --> 00:10:07,420
،يُقال بأنهم خدمٌ للآلهات
وبأن مجرّد رؤيتهم ستجلب لك الحظّ الجيّد

103
00:10:07,420 --> 00:10:11,550
الوحيدان الذين رأيتهما بعيني هما بيجا وهذا

104
00:10:12,380 --> 00:10:14,170
بيجا هو واحدٌ منهم أيضًا؟

105
00:10:14,170 --> 00:10:17,640
أجل، لقد بدا بمثل تلك الهيئة قبل أن يعاود التحوّل إلى شكله هذا

106
00:10:17,640 --> 00:10:21,060
وبإمكانه التحوّل إلى تلك الهيئة مجددًا

107
00:10:21,060 --> 00:10:26,190
سأمنحكم إياه كعلامةٍ على الصداقة

108
00:10:31,110 --> 00:10:32,440
ماذا؟ أنا؟

109
00:10:32,730 --> 00:10:35,820
يبدو بأنه أعجِب بك أيها الأمير جاول

110
00:10:35,820 --> 00:10:37,530
ذلك عظيم

111
00:10:37,530 --> 00:10:39,910
إنه رائع أيها الأمير جاول

112
00:10:39,910 --> 00:10:42,950
،إذن، بصفتي ممثلة لحلف البلدان الثلاثة

113
00:10:42,950 --> 00:10:46,210
سأرحّب به في جاليتو. هل سيكون ذلك مقبولا؟

114
00:10:46,210 --> 00:10:48,710
أجل، سيكون ذلك مثاليًّا

115
00:10:48,710 --> 00:10:54,460
نوعًا ما يبدو بأن الاحتفاظ بوحشٍ خياليٍّ سيكون أمرًا مخيفًا للغاية

116
00:11:05,600 --> 00:11:06,350
ماذا؟

117
00:11:15,360 --> 00:11:21,200
!وداعًا لكم جميعًا

118
00:11:21,200 --> 00:11:25,120
!وداعًا

119
00:11:28,460 --> 00:11:29,620
أيها الأمير جاول

120
00:11:32,290 --> 00:11:34,130
أريا-سان هناك

121
00:11:35,880 --> 00:11:37,130
فهمت

122
00:11:38,220 --> 00:11:39,050
كوفيرت

123
00:11:39,590 --> 00:11:41,180
هل بإمكانكِ التوجّه إلى هناك؟

124
00:11:41,180 --> 00:11:42,470
طبعًا

125
00:11:42,470 --> 00:11:45,430
ينبغي علينا جميعًا قول الوداع

126
00:11:45,430 --> 00:11:47,430
كلا أيها الأمير جاول

127
00:11:47,890 --> 00:11:52,400
لقد أنقذتْ حياتك، لذا اذهب بمفردك

128
00:11:52,400 --> 00:11:53,400
...استعداد و

129
00:12:01,570 --> 00:12:04,200
أو - أولئك الرفاق

130
00:12:14,880 --> 00:12:17,710
هذه هي المرة الثانية التي تُنقذينني فيها

131
00:12:19,670 --> 00:12:23,720
في المقابل، لقد قمت أنت وأصدقاؤكَ بإنقاذي أنا وفيردي

132
00:12:28,220 --> 00:12:31,350
...هناك العديد من الأشياء التي أردتُ التحدّث عنها، لكن

133
00:12:32,480 --> 00:12:35,190
لا أعرف كيف أشكرك

134
00:12:35,190 --> 00:12:37,230
إنكِ لا تحتاجين إلى ذلك

135
00:12:37,820 --> 00:12:41,950
لقد أنقذتِني، وأنا أنقذتكِ، وكلانا قد خضنا مغامرة

136
00:12:42,700 --> 00:12:45,620
أنتِ صديقتي الآن، مثلهم جميعًا

137
00:12:47,370 --> 00:12:49,250
بالطبع، فيردي أيضًا

138
00:12:50,040 --> 00:12:53,000
أريد أن أراك أنت والآخرين مجددًا

139
00:12:53,330 --> 00:12:55,090
أجل، المثل ينطبق عليّ

140
00:12:55,840 --> 00:12:57,630
لذا سأعود

141
00:12:57,630 --> 00:12:59,880
هل بإمكاني الذهاب لزيارتكم أيضًا؟

142
00:12:59,880 --> 00:13:01,630
طبعًا

143
00:13:01,630 --> 00:13:03,970
صحيح يا رفاق؟

144
00:13:03,970 --> 00:13:05,510
!بالتأكيد

145
00:13:06,350 --> 00:13:10,850
لو أردتِ رؤيتنا، فذلك سببٌ كافٍ للمجيء إلينا

146
00:13:10,850 --> 00:13:17,020
!إنكِ لا تحتاجين إلى سببٍ للرغبة في رؤية شخصٍ ما أو أن تكوني معه

147
00:13:18,230 --> 00:13:19,280
!فهمت

148
00:13:19,280 --> 00:13:20,530
!شكرًا

149
00:13:26,780 --> 00:13:29,410
!أنا أحبكم جميعًا

150
00:13:36,590 --> 00:13:40,090
لقد كنت جريئًا هناك، ألم تكن كذلك يا جاول؟

151
00:13:40,090 --> 00:13:41,630
ليس فعلًا

152
00:13:41,630 --> 00:13:44,630
لقد قلت الوداع فقط. ذلك كل شيء

153
00:13:44,630 --> 00:13:45,680
نعم

154
00:13:45,680 --> 00:13:47,760
لقد كان ذلك عظيمًا، ألم يكن كذلك؟

155
00:13:47,760 --> 00:13:48,680
!بلى

156
00:13:48,680 --> 00:13:52,520
آمل بأن يكون بإمكان أريا-سان المجيء إلى السطح للعب

157
00:13:52,520 --> 00:13:54,140
وأنا كذلك

158
00:13:54,140 --> 00:13:57,810
،ما دمتم تفكّرون ببعضكم
فلا يمكن لأيّ مسافة قطع روابطكم

159
00:13:58,270 --> 00:14:04,820
لكن للحفاظ على قوّة تلك الروابط، فمن الأفضل الالتقاء بالأشخاص الذين تهتمّ بأمرهم من حينٍ لآخر

160
00:14:05,200 --> 00:14:06,320
!صحيح

161
00:14:10,830 --> 00:14:13,250
حسنٌ، أوشكنا على الخروج

162
00:14:13,250 --> 00:14:14,750
إن تنين النار ينتظر

163
00:14:14,750 --> 00:14:16,080
!لطيف

164
00:14:29,050 --> 00:14:29,850
!تنين النار

165
00:14:32,060 --> 00:14:33,890
!آسفة على تعريضك لكلّ ذلك

166
00:14:59,880 --> 00:15:02,170
هذا هو الوداع لليوم

167
00:15:02,170 --> 00:15:03,880
تعالوا لرؤيتنا مجددًا

168
00:15:03,880 --> 00:15:05,840
...سكّان البحر السماويّ

169
00:15:06,510 --> 00:15:08,640
سوف يرحبون بكم دائمًا..

170
00:15:11,140 --> 00:15:17,020
!لقد حصل الكثير، لكنّ الجميع بأمان، واُستعِيد السلام

171
00:15:17,020 --> 00:15:20,360
بالرغم من أنه لم يتسنّى لي القتال بما يكفي

172
00:15:20,360 --> 00:15:22,400
ألا توافقينني الرأي يا إكلير؟

173
00:15:23,020 --> 00:15:24,940
...كلا، حسنٌ

174
00:15:24,940 --> 00:15:28,530
لا يوجد شيءٌ خاطئٌ في عدم الاضطرار للقتال

175
00:15:29,700 --> 00:15:32,780
لقد كنا قادرين على تسوية الأمور من دون أن يتأذّى أحد

176
00:15:33,290 --> 00:15:34,540
أنا سعيدة للغاية بذلك

177
00:15:34,540 --> 00:15:35,330
!أنا أيضًا

178
00:15:35,330 --> 00:15:37,040
حسنٌ، لقد أوشكنا على الخروج من الغيوم

179
00:15:45,880 --> 00:15:47,220
!رائع

180
00:15:47,220 --> 00:15:50,590
تسقطُ قطرات الضوء في الأسفل هنا أيضًا، أليست كذلك؟

181
00:15:50,590 --> 00:15:51,800
إنها جميلة للغاية

182
00:15:51,800 --> 00:15:53,680
لم يسبق وأن رأيتها فعلا من قبل

183
00:15:53,680 --> 00:15:57,730
ولا أنا. لقد سمعت عنها فقط

184
00:15:57,730 --> 00:16:00,940
على الأرجح بأنها تسقط على السطح

185
00:16:00,940 --> 00:16:04,320
أنا متأكدٌ بأن الناس الذين على السطح مندهشين من هذا المنظر أيضًا

186
00:16:13,910 --> 00:16:18,080
وهكذا وصلت مغامرتنا في البحر السماويّ إلى نهايةٍ آمنة

187
00:16:19,120 --> 00:16:25,840
،شرحن الأميرات ما الذي سبّب ظاهرة الطقس الغريبة
وبأنها ستستمرّ لعدة أيام

188
00:16:26,300 --> 00:16:32,550
!لذا هذا الضوء هديّة من الحوت النجميّ الذي في البحر السماويّ

189
00:16:33,090 --> 00:16:37,560
!إنه غير مؤذٍ إطلاقًا، لذا لا تقلقوا

190
00:16:37,560 --> 00:16:40,190
إنه ظاهرة طبيعيّة شديدة الندرة

191
00:16:40,190 --> 00:16:41,350
،عندما يحلّ الظلام

192
00:16:41,350 --> 00:16:44,270
!شاهدوه وأنتم تشربون

193
00:16:54,580 --> 00:16:58,580
...لقد مضى الوقت بسرعة كبيرة مجددًا

194
00:16:58,580 --> 00:17:01,630
!لكن لقد حصل الكثير، ولقد كان كلّ يومٍ ممتعًا

195
00:17:02,290 --> 00:17:04,960
بمقدوركِ العودة قريبًا، صحيح؟

196
00:17:04,960 --> 00:17:05,880
أجل

197
00:17:05,880 --> 00:17:07,630
بإمكاني المجيء في إجازات نهاية الأسبوع الطويلة أيضًا

198
00:17:07,630 --> 00:17:10,640
وبإمكاني تنظيم جدولي على وقت ألعاب الحرب

199
00:17:11,300 --> 00:17:12,430
أنا كذلك

200
00:17:12,430 --> 00:17:14,770
،هذه المرة استطعت أخذ إجازة

201
00:17:15,100 --> 00:17:18,730
لذا سيوجّب عليّ في المرة القادمة
!أن أقوم بعملي كبطل في الألعاب

202
00:17:18,730 --> 00:17:21,400
!أجل! وبصفتي قائدة، سأفعل ما بوسعي أنا أيضًا

203
00:17:21,730 --> 00:17:26,070
!عليّ بذل ما بوسعي لكي يعترفوا بي الناس كحاكمة رسميّة

204
00:17:26,070 --> 00:17:28,700
!سأشجعكِ! فلنبذل ما بوسعنا سويًّا

205
00:17:28,700 --> 00:17:29,610
!نعم، فلنقم بذلك

206
00:17:30,200 --> 00:17:33,280
لسببٍ ما، لا أشعر بحزنٍ شديد

207
00:17:34,330 --> 00:17:36,410
في الواقع، ولا أنا

208
00:17:36,410 --> 00:17:40,040
بإمكاننا التحدث دومًا، وبإمكاننا رؤية بعضنا البعض وقتما شئنا

209
00:17:40,040 --> 00:17:44,710
لكنني أعرف بأنني سأشعر بالحزن حالما أعود وأصبح وحيدة كليًّا

210
00:17:44,710 --> 00:17:49,170
لو حصل ذلك، فسأتصل بكِ فورًا

211
00:17:49,170 --> 00:17:49,930
!أجل

212
00:17:49,930 --> 00:17:51,300
!سأهاتفكِ أيضًا

213
00:17:52,550 --> 00:17:55,430
هاتان الاثنتان صديقتان مقربتان للغاية

214
00:17:55,430 --> 00:17:56,890
أنتِ محقة

215
00:17:57,470 --> 00:18:00,690
لذا لمَ لا نصبح صديقين مقربين أيضًا؟

216
00:18:02,270 --> 00:18:04,480
!كلانا وريثين للملكة البطلة في نهاية المطاف

217
00:18:04,480 --> 00:18:05,320
!أجل

218
00:18:07,780 --> 00:18:10,700
ما الشيء الآخر الذي نسيته أيضًا؟

219
00:18:14,030 --> 00:18:15,450
هذه لكِ يا نانامي-تشان

220
00:18:15,950 --> 00:18:17,410
إنها هديّة من ليف

221
00:18:17,410 --> 00:18:19,160
!شكرًا

222
00:18:19,160 --> 00:18:23,670
حسنٌ، حتى ولو نسيتِ شيئًا ما، فبإمكانكِ العودة لاسترجاعه فحسب

223
00:18:23,670 --> 00:18:27,960
وإذا كان صغيرًا بما يكفي ليحمله تشيني، فبإمكانه القيام بوثبة سريعة ذهابًا وإيابًا

224
00:18:29,720 --> 00:18:31,220
أنتن محقات

225
00:18:31,220 --> 00:18:34,090
لكني لا أريد المغادرة وغرفتي في فوضى

226
00:18:34,600 --> 00:18:39,100
سيكون ذلك عارٌ على لقبكِ كبطلة

227
00:18:40,100 --> 00:18:41,850
بـ - بالضبط

228
00:18:42,310 --> 00:18:44,610
حسنٌ، فلنسارع بتنظيفها

229
00:18:44,610 --> 00:18:46,110
!طبعًا

230
00:18:46,440 --> 00:18:49,400
،أيتها البطلة ربيكّا

231
00:18:49,400 --> 00:18:50,860
!أراكِ في المرة المقبلة

232
00:18:50,860 --> 00:18:52,610
!صحيح يا كو-ساما

233
00:18:52,610 --> 00:18:54,620
سأعود قريبًا، حسنٌ؟

234
00:18:59,120 --> 00:19:00,370
أنتِ متأكدة بأنكِ لم تنسي شيئًا، صح؟

235
00:19:00,660 --> 00:19:01,620
!نعم، أنا مستعدّة بالكامل

236
00:19:02,120 --> 00:19:06,630
،عند أخذ المشاكل التي حصلت في البوابة الأخيرة في الحُسبان
فأريد الحرص على ألا يقع خطبٌ ما هذه المرّة

237
00:19:06,920 --> 00:19:08,000
سيكون الأمر على ما يرام

238
00:19:08,000 --> 00:19:10,380
سأعود إلى المنزل بأمان، بعدئذٍ سأعود قريبًا

239
00:19:10,880 --> 00:19:11,880
جيد

240
00:19:16,760 --> 00:19:18,390
...أصغِ يا شينكو

241
00:19:18,390 --> 00:19:19,390
نعم؟

242
00:19:19,390 --> 00:19:23,270
...ما قالتاه نانامي-سان وربيكّا-سان لأريا-سان

243
00:19:24,650 --> 00:19:27,980
"إنكِ لا تحتاجين إلى سببٍ للرغبة في رؤية شخصٍ ما أو أن تكوني معه"

244
00:19:28,900 --> 00:19:34,700
هل تتذكر؟ ذلك هو ما قُلتَه لربيكّا-ساما منذ زمنٍ طويل

245
00:19:35,990 --> 00:19:39,290
لقد كان ذلك منذ زمنٍ بعيد، ألم يكن كذلك؟

246
00:19:39,790 --> 00:19:42,540
أتذكر ذلك نوعًا ما، ربما

247
00:19:42,830 --> 00:19:46,420
،عندما كانتْ صغيرةً في السنّ
كانت تتطلّع قدمًا للإجازات الطويلة

248
00:19:46,420 --> 00:19:48,420
لأنه حينئذٍ بإمكانها رؤيتك

249
00:19:49,000 --> 00:19:53,300
،في الوقت ذاته، كانت تقلق بأنه يُحتمل بأنك تريد اللعب مع شخصٍ آخر

250
00:19:53,630 --> 00:19:58,720
أو بأن إمضاء الوقت معها سيضجرك لأنها لم تكن شخصًا رياضيًّا

251
00:19:58,720 --> 00:20:03,140
لقد كانت تفكر بشأن أشياء كهذه باستمرار، لذا حاولتْ ألا تزعجكَ كثيرًا

252
00:20:03,140 --> 00:20:07,440
لقد كانت بيكّي هادئة كثيرًا حينما كانت صغيرةً في السنّ

253
00:20:07,440 --> 00:20:11,440
:لكنها تقول بأنّك قُلت لها

254
00:20:11,440 --> 00:20:15,200
إذا أردتِ رؤيتي، فذلك سببٌ كافٍ للمجيء إلي"

255
00:20:15,200 --> 00:20:19,700
"أشعر بالسعادة والمتعة حينما أكون معكِ يا بيكّي

256
00:20:24,370 --> 00:20:28,460
لقد جعلها ذلك سعيدةً للغاية

257
00:20:29,170 --> 00:20:31,500
أظن بأنني أتذكر

258
00:20:31,500 --> 00:20:36,550
لا زلت لم أمضي الكثير من الوقت معك يا شينكو

259
00:20:36,550 --> 00:20:41,260
لكن حتّى ولو، أريد أن أراك قريبًا مجددًا

260
00:20:41,890 --> 00:20:45,140
وأريد الاستمرار في اللعب معك إلى الأبد

261
00:20:51,190 --> 00:20:52,440
المِثل ينطبق عليّ

262
00:20:52,440 --> 00:20:55,320
لذا سأعود قريبًا

263
00:20:55,990 --> 00:20:57,200
أعدكِ بذلك

264
00:20:57,200 --> 00:20:58,490
!حسنٌ

265
00:21:11,090 --> 00:21:13,380
هل عدنا إلى المنزل بأمان؟

266
00:21:13,380 --> 00:21:14,840
أجل

267
00:21:14,840 --> 00:21:16,380
ماذا عن بيكّي؟

268
00:21:16,380 --> 00:21:17,590
سأتصل بها

269
00:21:18,470 --> 00:21:19,840
مرحبًا؟ شينكو؟

270
00:21:20,140 --> 00:21:21,720
!أنا بخير فحسب

271
00:21:22,430 --> 00:21:24,470
!لقد عدتُ بأمان

272
00:21:24,470 --> 00:21:26,640
!من العظيم سماع ذلك

273
00:21:26,640 --> 00:21:28,440
!سأتحدّث معكِ لاحقًا

274
00:21:28,440 --> 00:21:31,610
،حسنٌ، فلنقم بأعمالنا التي على الأرض

275
00:21:31,940 --> 00:21:34,480
!ونستعدّ للعودة إلى فلونياردو

276
00:21:34,480 --> 00:21:35,440
!أجل

277
00:21:35,440 --> 00:21:37,780
!سأبذل جهدي في المدرسة وألعاب القوى

278
00:21:37,780 --> 00:21:39,610
ولا تنسَ حياتك العاطفيّة

279
00:21:39,610 --> 00:21:42,620
تلك مسألة مختلفة

280
00:21:43,280 --> 00:21:46,040
هذه هي نهاية مغامرتنا الخريفيّة

281
00:21:46,040 --> 00:21:50,290
...لكن في نهاية العام، ورأس السنة، وثمّ الربيع المقبل

282
00:21:51,830 --> 00:21:57,880
أنا متأكدة بأننا سنعود إلى منزلنا الآخر لرؤية أصدقائنا الأعزّاء

283
00:21:57,880 --> 00:22:01,720
!سنتوجّه إلى فلونياردو، المكان الذي نحبّه

284
00:23:51,220 --> 00:23:53,140
!حسنٌ أيها الرفاق

285
00:23:53,100 --> 00:23:59,570
نراكم مجددًا

286
00:23:53,140 --> 00:23:55,940
!نراكم مجددًا

287
00:23:55,940 --> 00:23:56,900
!أجل