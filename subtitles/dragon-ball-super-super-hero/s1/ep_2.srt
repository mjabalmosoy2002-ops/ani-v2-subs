1
00:00:16,450 --> 00:00:22,550
؟"الأحمر الرِباط جيش" أَتتذكَّرون جميعًا

2
00:00:23,770 --> 00:00:29,950
"الأحمر القائد" ذلك الجيش الشّرّانيّ المخطّط للهيمنة على العالَم، تحت إِمْرَة

3
00:00:29,980 --> 00:00:36,850
"سون ݠوكو" إلّا أنّه اندثر اندثارًا على يد فتًى صغير يُدعى

4
00:00:39,580 --> 00:00:49,500
"جيرو" في وقتها، تمكّن العالِم النّابغة؛ الدكتور
مِن تطوير أسحلة خاصّة تسمّى "الروبوتات" والتي استطاعتْ النّجاة

5
00:00:50,930 --> 00:00:58,050
"الأحمر القائد" يُكمل إرادة أبيه "ماجينتا" في أثناء ذلك، ما بَرح الاِبن اليتيم

6
00:00:58,070 --> 00:01:05,400
،"المستحضرات الدوائيّة الحمراء" مستخدمًا الأموال الهائلة مِن شركته الصّوريّة
منتظرًا بهدوء نهضة الجيش

7
00:01:06,210 --> 00:01:07,750
...مرّ الوقت

8
00:01:07,780 --> 00:01:15,550
،على تطوير روبوتاته في الخفاء "جيرو" مَضى الدكتور
بلْ حتّى حوّل نفسه إلى روبوت

9
00:01:15,750 --> 00:01:18,260
،وحلفائه "ݠوكو" بَيدَ أنّه هُزم مرّة أخرى مِن قِبل

10
00:01:18,260 --> 00:01:23,400
"روبوت رقم 17" وقُتِلَ في النّهاية على يد مُصطنعه الـ

11
00:01:25,500 --> 00:01:34,650
؛"سيل" ورفاقه مع "ݠوكو" وبَعد فترة وجيزة، تواجه
السّلاح الحيّ الذي لا يُقهر

12
00:01:34,710 --> 00:01:38,000
وفي الأخير ألحقوا به الهزيمة بَعد نِزالٍ عويص

13
00:01:40,400 --> 00:01:47,550
يتخلّى عن "ماجينتا" إثْر النّكسات الجمّة، كاد
"الأحمر الرِباط جيش" إعادة إحياء

14
00:01:47,650 --> 00:01:54,000
؛"جيرو" فكان محظوظًا كفاية لاِكتشافه حفيد الدكتور
الجِهْبِيذ "هيدو" الدكتور

15
00:01:54,230 --> 00:02:01,110
،"هيدو" وبفضل نُبوغ
المُلحّة للاِنتقام تارةً أخرى "ماجينتا" اتقدتْ رغبة

16
00:02:07,600 --> 00:02:11,450
بـطـل                                              خارق

17
00:03:03,900 --> 00:03:05,050
ماجينتا

18
00:03:05,030 --> 00:03:07,800
إذًا؟ "جيرو" أَهذا حفيد الدكتور

19
00:03:10,870 --> 00:03:13,510
عمره: 24 ،"هيدو" اسمه: الدكتور

20
00:03:13,650 --> 00:03:15,950
كارمَين

21
00:03:15,940 --> 00:03:19,150
أَهو أستاذ أمْ طبيب؟

22
00:03:19,200 --> 00:03:23,000
...إنّه يَحمل كِلا المؤهلَين، لاحظ

23
00:03:24,450 --> 00:03:26,450
"كارمَين يقدّم"

24
00:03:28,620 --> 00:03:30,580
هل أعددتَ هذا؟

25
00:03:30,760 --> 00:03:31,760
أجل

26
00:03:32,520 --> 00:03:35,550
الرّاحلة "جيرو" كان والده الاِبن الأصغر لزوجة الدكتور

27
00:03:35,630 --> 00:03:39,750
،حينما كان في المدرسة الاِبتدائيّة
فَقَدَ كِلا والديه في حادث

28
00:03:39,860 --> 00:03:43,540
وبيْنما لا يزال طفلًا، استخدم ميراثه ليعيش بمفرده

29
00:03:43,670 --> 00:03:46,730
ولِنَباغَته حصل على الدكتوراه في سنّ الرّابعة عشرة

30
00:03:46,840 --> 00:03:52,140
غيْر أنّ شخصيّته غريبة الأطوار وقفتْ حائلًا بيْن مُلاءمتهِ لأيٍّ مِن المختبرات

31
00:03:52,140 --> 00:03:56,500
لذا يتضح أنّه استخدم ما تبقى مِن ميراثه لمواصلة أبحاثه على عاتقه

32
00:03:56,650 --> 00:04:01,560
هذا يناسب ما نحن بصدَده، لنعثر عليه فورًا

33
00:04:03,150 --> 00:04:04,790
!أحضِر لي بعض الشّاي

34
00:04:04,790 --> 00:04:06,060
!حالًا

35
00:04:06,060 --> 00:04:07,730
رجاءً انتظر ثلاثة أشهر

36
00:04:07,730 --> 00:04:08,730
!لاِحتساء الشّاي

37
00:04:08,730 --> 00:04:13,160
لأنّه يقضي عقوبةً في السّجن حاليًا ،"هيدو" لا، بلْ مِن أجل الدكتور

38
00:04:13,160 --> 00:04:14,370
!اسمح لي

39
00:04:14,370 --> 00:04:17,000
أَهو مسجون؟ ولأجل ماذا؟

40
00:04:17,000 --> 00:04:23,940
حسنٌ، تَكَشّف أنّه سَرَقَ ثلاث جثثٍ مِن المشرحة وحوّلها إلى روبوتات مبسّطة

41
00:04:23,940 --> 00:04:27,150
!ثُمّ جَنى مالًا بجعلهم يعملون في متجر بقالة

42
00:04:27,150 --> 00:04:31,450
...لا أعرف ما إذا كان عبقريًّا أو معتوهًا، في كِلتا الحالتَين

43
00:04:31,490 --> 00:04:37,400
موهبة تقنيّة الروبوتات "جيرو" جليٌّ أنّه يُشاطر الدكتور

44
00:04:41,630 --> 00:04:46,600
!"الأحمر الرِباط جيش" أيًّا ما كان، نحتاج إلى مهاراته لإحياء

45
00:04:46,670 --> 00:04:47,700
!ساخن

46
00:05:01,010 --> 00:05:02,400
!مَـأْفُـون

47
00:05:02,450 --> 00:05:04,000
!حُـثـالـة

48
00:05:04,280 --> 00:05:06,000
!مَـعـتـوه

49
00:05:14,300 --> 00:05:16,850
الدكتور
هيدو

50
00:05:20,100 --> 00:05:23,300
؟"هيدو" هل أنت الدكتور
لقد كنتُ في انتظارك

51
00:05:24,970 --> 00:05:27,110
...ما أوقحني، اسمح لي بتعريف

52
00:05:27,120 --> 00:05:29,200
؟"المستحضرات الدوائيّة الحمراء" أَلستَ رئيس شركة

53
00:05:34,180 --> 00:05:34,800
!توقّف

54
00:05:36,750 --> 00:05:39,150
كيف لك أنْ تعرفني؟

55
00:05:40,490 --> 00:05:42,000
!استقصيتُ أمرك

56
00:05:42,190 --> 00:05:43,660
أَستقصيتَ أمري؟

57
00:05:43,800 --> 00:05:45,600
!أيّها الجالس بمقعد السّائق

58
00:05:45,660 --> 00:05:50,700
أَلمْ تشاهدني في ساحة التّدريب بالسّجن؟

59
00:05:50,860 --> 00:05:53,800
ارتبتُ الأمر؛ فتَتبّعتك

60
00:05:53,970 --> 00:05:55,400
كيف؟

61
00:05:57,100 --> 00:05:59,300
!"هاتشيمارو" تعال هنا يا

62
00:06:06,880 --> 00:06:11,000
!إنّه عميلي الآليّ والذي صنعته بتعديلٍ على نحلة

63
00:06:11,080 --> 00:06:17,300
"المستحضرات الدوائيّة الحمراء" تتبّعك إلى مكتب رئيس شركة
مراقبًا تقريرك عنّي

64
00:06:17,420 --> 00:06:19,260
مثير للدهشة

65
00:06:19,260 --> 00:06:22,340
رغم ذلك، أثق أنّك تجهل سبب تحرّينا عنك

66
00:06:22,360 --> 00:06:24,900
،باستطاعتي التّخمين

67
00:06:24,910 --> 00:06:31,000
،شابَتْ محادثتكما تشويشًا
!"الأحمر الرِباط جيش" ولكنّي تمكّنتُ مِن سماع قولك

68
00:06:31,170 --> 00:06:34,550
حسنٌ، على أيّ حال دعنا نقلّك

69
00:06:34,740 --> 00:06:37,850
فنحن على معرفةٍ بكلّ أطعمتك المفضّلة

70
00:06:39,210 --> 00:06:41,600
!أَفسِح قليلًا-
!حسنًا-

71
00:06:41,680 --> 00:06:43,450
!اُربط حزام مقعدك-
!حسنًا-

72
00:06:48,450 --> 00:06:50,400
كيف جرتْ الأمور في السّجن؟

73
00:06:50,520 --> 00:06:53,320
هل أساء السّجناء معاملتك؟

74
00:06:53,460 --> 00:06:56,000
،بعضهم فعلها في البداية

75
00:06:56,130 --> 00:06:59,500
!ولكنّهم ماتوا على نحوٍ غامض

76
00:07:00,300 --> 00:07:01,400
!فهمت

77
00:07:02,370 --> 00:07:06,300
"جيرو" لمِن المؤسف مآل جدّك الدكتور

78
00:07:07,170 --> 00:07:09,050
بصراحة، لمْ أهتمّ

79
00:07:09,470 --> 00:07:13,400
كنتُ طفلًا وقتها، ولا أعرف كيف مات

80
00:07:13,750 --> 00:07:15,850
حتّى أنّي ما قابلتُه قَط

81
00:07:16,850 --> 00:07:23,200
ومع ذلك، مصادفةٌ ملفتة أنّ دأبك على أبحاث الروبوت عظيمٌ كما جدّك

82
00:07:23,290 --> 00:07:25,730
بحث صُنع روبوت لا يُقهر، أليس كذلك؟

83
00:07:26,930 --> 00:07:29,930
مذهل، تلك هي غايتي تمامًا

84
00:07:30,500 --> 00:07:33,300
خسارة عبقريّ مثله كانت انتكاسةً كُبرى

85
00:07:33,600 --> 00:07:38,440
قمتُ بتمويل أبحاثه ،"ريد" فبَعد وفاة والدي

86
00:07:38,440 --> 00:07:39,660
فهمتُ مقصدك

87
00:07:39,840 --> 00:07:46,060
،العبقريّ "جيرو" الآن وَقد رحل الدكتور
!العبقريّ الخارق "هيدو" تودّ استبداله بالدكتور

88
00:07:46,070 --> 00:07:50,350
حرفيًّا! فما رأيك؟ هل ستآزرني؟

89
00:07:50,350 --> 00:07:53,520
بوسعك الحصول على الأموال والمعدات البحثيّة كيفما تريد

90
00:07:53,540 --> 00:07:56,790
!سأدفع لك 300 مليون لكلّ روبوت

91
00:07:56,790 --> 00:07:58,900
لستُ متأكدًا

92
00:07:59,460 --> 00:08:00,860
ولمَ لا؟

93
00:08:00,880 --> 00:08:08,530
"المستحضرات الدوائيّة الحمراء" رغم عدم معرفة الجميع، فإنّ شركة
ومصدر أموالها كافّة، أليس كذلك؟ "الأحمر الرِباط جيش"مجرّد واجهة لـ

94
00:08:08,530 --> 00:08:14,750
"الأحمر الرِباط جيش"إبّان طفولتي، مَقَتَ والديَّ جدّي لتأثّره بـ

95
00:08:15,440 --> 00:08:19,300
مدهش، ما توقعتُ معرفتك الكثير

96
00:08:19,580 --> 00:08:23,850
إضافةً إلى، كوني أشدّ المعجبِين بالأبطال الخارقِين شديدي البأس

97
00:08:23,880 --> 00:08:28,410
،ما زال يسعى للهيمنة على العالَم كما في الماضي "الأحمر الرِباط جيش"  ولو أنّ

98
00:08:28,450 --> 00:08:31,090
فبالفطرة سيكونون أعداءً للأبطال الخارقِين، صحيح؟

99
00:08:32,560 --> 00:08:34,370
أنت رجلٌ مثير للاِهتمام

100
00:08:34,690 --> 00:08:37,360
،ما قد يَظهر هيمنةً على العالَم

101
00:08:37,380 --> 00:08:42,200
،فإنّ دافعي الحقيقيّ تطهير العالَم مِن عناصر الخطر والتّمرّد

102
00:08:42,210 --> 00:08:46,550
!لأجل أنْ أقيمَ مجتمعًا نزيهًا يسوده السّلام

103
00:08:46,570 --> 00:08:49,450
!بإسلوبٍ مميّز، إنّي داعم العدالة

104
00:08:49,470 --> 00:08:55,000
وبعبارةٍ أخرى، تنشُد استخدام القوّة لتنشئ عالَمك المِثاليّ

105
00:08:55,450 --> 00:08:58,300
،حسنٌ، امتلاك السّلطة ليست شغلي الشّاغل

106
00:08:58,320 --> 00:09:00,700
فاهتمامي الوحيد مُنصَبٌّ بالأبحاث

107
00:09:00,850 --> 00:09:07,400
إذا كنت غيْر راضٍ، ما قولك أنْ أدفع مليار لكلّ روبوت؟

108
00:09:07,560 --> 00:09:09,130
يبدو كعرضٍ لا يمكنني رفضه

109
00:09:09,260 --> 00:09:10,230
!مِن المحتمل

110
00:09:10,460 --> 00:09:12,600
مكرهٌ أخاك لا بطل

111
00:09:12,600 --> 00:09:15,900
في الواقع، هذا يصبُّ في مصلحتك

112
00:09:16,000 --> 00:09:19,200
!للعِلم، ما رضيتُ خِشية تحديد السلاح

113
00:09:19,400 --> 00:09:25,100
إذْ إنّي حقنتُ بَشرتي بعقارٍ يحصّنه ضدّ الصّدمات

114
00:09:25,140 --> 00:09:26,600
...وبجانب ذلك

115
00:09:27,140 --> 00:09:30,000
،السّامة قاتلة "هاتشيمارو" لدغة

116
00:09:30,250 --> 00:09:35,050
،حتّى الروبوت، ما دامَ فيه جزءًا بشريًّا
!هيهات أنْ يبقى حيًّا إثْر لدغة

117
00:09:38,800 --> 00:09:40,700
،سبب موافقتي الوحيد

118
00:09:40,800 --> 00:09:46,600
أنّي أحببتُ فكرة وجود ميزانيّة ضخمة؛
!لكيْ أنشئ الروبوتات الأفضل في التّاريخ

119
00:09:46,800 --> 00:09:51,500
،ولنكُن على بيّنة
!"ماجينتا" لستُ طامعًا البتّة في منصب الرّئيس

120
00:09:51,500 --> 00:09:52,650
أَفهمتَ ذلك؟

121
00:09:52,700 --> 00:09:54,240
موافق

122
00:09:58,150 --> 00:10:00,380
إذًا، مَنْ ألدّ أعدائك؟

123
00:10:01,650 --> 00:10:04,050
..."سيل" الشِّرذِمة التي قهَرتْ

124
00:10:04,060 --> 00:10:05,990
؟"ساتان"أَتقصد السيد

125
00:10:06,000 --> 00:10:07,300
كلّا، ليس تمامًا

126
00:10:08,350 --> 00:10:10,990
إنّه تابع لهم، ولكنْ وفقًا لاِستقصاءاتنا

127
00:10:10,990 --> 00:10:16,060
،ما هم إلّا مجتمعٌ مُرهِب
!"كپسول" بشركة "بولُما" وزعيمتهم الحقيقيّة

128
00:10:16,090 --> 00:10:20,060
!"كپسول" شركة
!الشّركة الأغنى في العالَم أجمع

129
00:10:20,130 --> 00:10:22,450
ما سمعت أيّ إشاعةٍ مغرضة عنهم مِن قَبل

130
00:10:22,730 --> 00:10:24,000
!لا شكّ في ذلك

131
00:10:24,100 --> 00:10:30,900
إنّ عديد الشّهود رأوا أشباه بشرٍ تطير
"كپسول" داخل وخارج مقرّ شركة

132
00:10:30,940 --> 00:10:34,580
!فأرجح تقصّينا كونهم فضائيِّين

133
00:10:34,580 --> 00:10:35,600
!فضائيّون؟

134
00:10:35,750 --> 00:10:37,920
صحيح، فكّر في الأمر

135
00:10:37,920 --> 00:10:43,820
أَحقًّا ظننتَ بإمكانيّة اختراع ثورةٍ في نظام شركتهم
أو المركبات الفضائيّة دون مساعدة التّقنيّات الفضائيّة؟

136
00:10:43,860 --> 00:10:50,100
!"للاِستيلاء على "الأرض "كپسول" يُخطّط الفضائيّون لاِستخدام شركة

137
00:10:50,460 --> 00:10:52,400
!قصّة لا تُصدق

138
00:10:52,700 --> 00:10:54,500
توقعتُ أنْ يكون هذا ردّك

139
00:10:54,730 --> 00:10:57,540
إنّما اُنظر لهذه، اُلتقِطتْ منذ سنواتٍ عدّة

140
00:10:58,540 --> 00:11:00,800
أَتخيَّلتَ يومًا وجود كائنات كهذه؟

141
00:11:00,910 --> 00:11:05,600
!إنّهم فضائيّون بلا ريب
!"فتك بعضهم بعضًا على "الأرض

142
00:11:05,710 --> 00:11:09,210
!"غالبًا كيْ يقرّروا مَنْ يَحِقُّ له "الأرض

143
00:11:09,210 --> 00:11:12,510
!"بولُما" ويتضح أنّه نفس وقت تشيِيد منظمة

144
00:11:12,580 --> 00:11:19,010
،ولكن في تلك الحالة
وأتباعها على "الأرض" بالقوّة؟ "بولُما" لماذا لا تستولي

145
00:11:19,190 --> 00:11:23,700
،جليًّا، يطمعون باستغلال أبناء الأرض كأيادٍ عاملة

146
00:11:23,930 --> 00:11:27,030
،وبمجرّد جعل "الأرض" جَنّة لأنفسهم

147
00:11:27,170 --> 00:11:32,400
!سيمحقوننا نحن أبناء الأرض ليستقدموا أصدقاءهم الفضائيِّين

148
00:11:32,700 --> 00:11:36,450
،تحفة جدّك الفريدة "سيل" كان

149
00:11:36,770 --> 00:11:46,600
"كپسول" أرسله جدّك لمقاومة شركة
ومؤامرتهم لاِكتناز ثروات العالَم بمساعدة منظمة الفضائيِّين السّرّيّة

150
00:11:47,120 --> 00:11:49,500
!لكنْ للأسف، مات أثناء مسعاه

151
00:11:50,090 --> 00:11:57,000
!خانا صانعيْهما وانضمّا للأعداء "رقم 18"و "رقم 17" حتّى أنّ الربوتَيْن

152
00:11:57,430 --> 00:12:00,160
يبدون كأعداءٍ بالغي القوّة

153
00:12:00,160 --> 00:12:06,700
،"ماجين بوو" فعلًا، فمنظمتهم تضمّ المُخيف
!"پيكّولو" والملك الشّيطانيّ الأعظم

154
00:12:06,800 --> 00:12:10,210
فضائيّ كذلك؟ "(بولُما (الدكتور بريف" هل والد

155
00:12:11,380 --> 00:12:12,810
!على الأرجح

156
00:12:21,490 --> 00:12:24,070
نحتاج إلى أبــطــالٍ على ما يبدو

157
00:12:24,620 --> 00:12:26,660
هذا صحيح تمامًا

158
00:12:26,660 --> 00:12:31,330
أَبوسعك اختراع روبوت قويًّا كفاية لدَحرهم؟

159
00:12:32,900 --> 00:12:35,000
!ما أغباه مِن سؤال

160
00:12:35,300 --> 00:12:37,840
:لديَّ هدفٌ جديد الآن

161
00:12:37,840 --> 00:12:42,010
!اختراع الروبوت الأقوى في الكون

162
00:12:42,010 --> 00:12:43,300
أَليس ذلك رائعًا؟

163
00:12:43,640 --> 00:12:44,800
...بلى

164
00:12:45,180 --> 00:12:48,610
!في المتناول "الأحمر الرِباط جيش"  رائع! صارت عودة

165
00:13:14,670 --> 00:13:15,500
!آهٍ

166
00:13:15,970 --> 00:13:17,140
هل أنتِ بخير؟

167
00:13:17,140 --> 00:13:18,350
!بَسيطة

168
00:13:18,410 --> 00:13:20,600
حسنٌ، هذا كافٍ اليوم

169
00:13:25,120 --> 00:13:26,000
!تفضّل

170
00:13:32,590 --> 00:13:34,120
تُبلينَ بلاءً حسنًا

171
00:13:34,250 --> 00:13:38,600
..."ݠوهان" أفضل مِن
!وكأنّكِ تمتلكين موهبةً تفوق والدكِ

172
00:13:38,760 --> 00:13:43,000
،مِن يديّ "طاقة الكي" إذنْ علِّمني كيف أطلق

173
00:13:43,100 --> 00:13:45,470
"ترانكس-كُن"و "ݠوتين-كُن" مِثلما يفعل

174
00:13:45,470 --> 00:13:49,700
سَبق وأخبرتكِ: أنّ أمورًا كهذه لا تحدث إلّا بعدما تُتقنين الأساسيّات

175
00:13:49,840 --> 00:13:51,550
فلماذا لا يمكنكِ الطّيران حتّى الآن؟

176
00:13:51,610 --> 00:13:53,030
!إنّه أمر بالغ الصّعوبة

177
00:13:53,110 --> 00:13:54,080
!حتمًا صعب

178
00:13:54,380 --> 00:13:55,080
!هراء

179
00:13:55,080 --> 00:13:55,990
...إنّما حاولي

180
00:14:10,730 --> 00:14:12,600
لا ترهقي نفسكِ وركّزي على مُرادكِ

181
00:14:12,700 --> 00:14:15,400
"طاقة الكي" إذا فعلتِ؛ فسترضخ لكِ

182
00:14:17,240 --> 00:14:18,640
!لا فائدة

183
00:14:19,470 --> 00:14:21,000
لا داعيَ للاِستعجال

184
00:14:21,170 --> 00:14:24,200
فما زلتِ بنت الثّالثة ربيعًا، أمامكِ متسعٌ مِن الوقت

185
00:14:24,380 --> 00:14:27,740
"السَيّاجين" فوق ذلك لديكِ دماء

186
00:14:27,980 --> 00:14:30,500
سيصير يسيرًا ما أنْ تتعلّمي طريقة عملها

187
00:14:31,820 --> 00:14:33,180
"پيكّولو" يا سيد

188
00:14:33,180 --> 00:14:34,150
ما الأمر؟

189
00:14:34,190 --> 00:14:37,960
أَحقًّا كان لأبي أنْ يفوقَ جدّي قوةً إذْ أراد؟

190
00:14:37,960 --> 00:14:41,090
؟"ݠوكو" جدّك؟! أَتقصدين

191
00:14:41,110 --> 00:14:45,060
إنّه لحقٌّ، لكنّني لستُ متيقنًا مِن هذا في وقتنا الحاضر

192
00:14:46,200 --> 00:14:49,200
ما شاهدتُ أبي يقاتل قَط

193
00:14:49,400 --> 00:14:51,370
،ما كان بحاجةٍ إلى القتال

194
00:14:51,470 --> 00:14:53,900
ولكنّه سيفعل إنْ حان الوقت

195
00:14:55,940 --> 00:14:58,110
دعينا نعُد، سوف تتأخّرين

196
00:14:59,340 --> 00:15:02,550
اتفقنا، وسأعود باِنتهاء روضة الأطفال

197
00:15:38,380 --> 00:15:39,300
؟"ڤيديل" ما الأمر يا

198
00:15:39,380 --> 00:15:41,450
!"پيكّولو" أسعدتَ صباحًا يا سيد

199
00:15:41,450 --> 00:15:45,150
أخبِرني، هل أنت متفرّغ بَعد الظّهيرة؟

200
00:15:45,320 --> 00:15:49,720
،بَعد الظهيرة! أنا مواظبٌ على التّدريب
ولكنْ، ماذا تريدين؟

201
00:15:49,730 --> 00:15:53,900
،الفصل الذي أعلّمه فنون الدفاع عن النفس لديه بطولة اليوم

202
00:15:53,970 --> 00:15:57,050
،مِن روضة الأطفال "پان" فلنْ يمكنني اصطحاب

203
00:15:57,300 --> 00:16:01,550
!أرجو ألّا تمانع في الذّهاب لاِصطحابها

204
00:16:01,670 --> 00:16:02,820
؟"ݠوهان" ماذا عن

205
00:16:02,840 --> 00:16:07,600
،إنّه مُنكبٌّ على كتابة تقرير بحثه التّالي الذي سيقدّمه

206
00:16:07,610 --> 00:16:10,050
!إذْ لمْ يغادر غرفته منذ أيّام

207
00:16:10,110 --> 00:16:12,200
!ذاك المغفّل فعلها مجددًا

208
00:16:12,280 --> 00:16:14,050
!"پيكّولو" أستجديك يا سيد

209
00:16:14,150 --> 00:16:14,950
موافق

210
00:16:14,950 --> 00:16:17,080
!أشكرك! إنّك لخيرُ مُعين

211
00:16:17,090 --> 00:16:20,450
اصطحبها في الثّالثة، اتفقنا؟
وسأعدّ لك شيئًا لذيذًا

212
00:16:20,490 --> 00:16:22,600
!لقد أخبرتكِ، لا أشرب إلّا الماء

213
00:16:22,630 --> 00:16:23,880
فعلًا، هذا صحيح

214
00:16:23,930 --> 00:16:27,050
!في هذه الحالة، سأشتري لك دمية محشوة لطيفة

215
00:16:29,900 --> 00:16:32,500
لماذا الدمى المحشوة دائمًا؟

216
00:16:39,780 --> 00:16:41,050
!"پيكّولو" سيد

217
00:16:42,480 --> 00:16:45,930
مرّة أخرى "پان" نستمحيك عذرًا، يظهر أنّنا نحتاجك إلى اصطحاب

218
00:16:45,950 --> 00:16:48,610
ويحك! ماذا تحسب نفسك فاعلًا؟

219
00:16:48,690 --> 00:16:50,840
...أكتب تقريرًا عن الحشرات

220
00:16:50,860 --> 00:16:55,300
،منذ فترةٍ قريبة، اُكتشِف نوع نملٍ مذهل في الجزر الجنوبيّة

221
00:16:55,390 --> 00:17:00,010
،حالَ تعرّض للخطر، تطلق النّملة وَهجًا خافتًا وتتحوّل

222
00:17:00,060 --> 00:17:02,200
؟"السَيّاجين الخارق" أَلا تذكّرك بتحوّل

223
00:17:02,270 --> 00:17:04,410
!لمْ يكُن هذا سؤالي

224
00:17:04,440 --> 00:17:10,000
!بلْ كنتُ أتساءل، ما إذا كان بحثك أهمّ مِن الذّهاب لاِصطحابك ابنتك

225
00:17:10,010 --> 00:17:13,900
كلّا، إنّما بَعدها حضرتَ لتساعدنا، أَوليس كذلك؟

226
00:17:15,910 --> 00:17:19,520
وماذا عن قيامك ببعض التّدريبات مِن حينٍ لآخر؟

227
00:17:19,520 --> 00:17:22,080
فما تدري لعلّ أزمةً تكون قريبًا

228
00:17:22,090 --> 00:17:25,480
ماذا؟ أَتحسب أمرًا كهذا سيحدث مجددًا؟

229
00:17:25,490 --> 00:17:30,190
..."ڤيجيتا" حتّى لو حدث، فهنالك دائمًا والدي والسيد

230
00:17:32,130 --> 00:17:34,180
!ما جارَ عليَّ الزّمان بَعد

231
00:17:42,910 --> 00:17:44,200
!بالغ الثّقل

232
00:17:44,240 --> 00:17:46,570
أَلا يحثّك على استجلاب الذّكرَيات؟

233
00:17:46,580 --> 00:17:49,040
!سيكون مجهدًا عليَّ العمل هكذا

234
00:17:49,050 --> 00:17:51,810
!"پان" لا تنتحب، سأذهب لإحضار

235
00:17:51,880 --> 00:17:54,300
!عجبًا! فإنّها ابنتك

236
00:17:54,750 --> 00:17:58,600
!أنا حقًّا آسف، سنشتري لك دميةً محشوة أخرى

237
00:17:58,620 --> 00:18:01,700
!كلّا البتّة! فمتى ذَكرتُ أنّي معجب بهاته الأشياء؟

238
00:18:04,900 --> 00:18:08,030
!متعكّر المزاج "پيكّولو" لا جَرَمَ أنّ السيد

239
00:18:29,490 --> 00:18:31,590
!لقد تطفَّلت على تدريبي

240
00:18:37,660 --> 00:18:40,030
!"پيكّولو" لا بُدّ أنّك الملك الشّيطانيّ الأعظم

241
00:18:41,770 --> 00:18:44,750
!وحسب "پيكّولو" للأسف، أنا

242
00:18:44,770 --> 00:18:46,100
ماذا يفترض أنْ يعني هذا؟

243
00:18:46,170 --> 00:18:52,220
إنّها قصّة طويلة، فمَنْ أنت يا مرتديًا زيّ الأبطال الرّخيص؟

244
00:18:52,310 --> 00:18:56,200
!"عجبًا! على الأقل سمّيه بـ"طرازٍ رجعيّ

245
00:18:56,450 --> 00:18:59,180
...ولسوء حظّك، هويّتي

246
00:19:01,190 --> 00:19:02,520
!لا تزال سرّيّة...

247
00:19:07,630 --> 00:19:11,000
!تلك الشّارة، أتذكرها حينما كنتُ إلهًا

248
00:19:11,030 --> 00:19:14,000
؟"الأحمر الرِباط جيش" أَلا تنتمي إلى

249
00:19:14,270 --> 00:19:17,250
!يا لحَصافتك! لقد أخفقتُ

250
00:19:17,770 --> 00:19:20,810
بالمناسبة، ماذا قصدتَ بقولك "حينما كنتُ إلهًا"؟

251
00:19:21,010 --> 00:19:24,570
كان لزامًا أنْ تقوم ببحثك، فلِمَ عساي أخبِرك؟

252
00:19:24,610 --> 00:19:26,030
!يا لشُحِّك

253
00:19:26,290 --> 00:19:29,500
،منذ أمدٍ بَعيد "الأحمر الرِباط جيش" اِندثر

254
00:19:29,780 --> 00:19:35,010
،لفترةٍ أطول "جيرو" صمد الدكتور
وفي النّهاية حاقَ بمخطّطاته الفشل الذّريع

255
00:19:35,020 --> 00:19:36,820
!كذلك "سيل" متضمّنةً

256
00:19:38,060 --> 00:19:41,420
...ما أتيتُ إلّا لسجالٍ وِديّ

257
00:19:41,490 --> 00:19:43,400
!لكنّي لنْ أستطيع ترك الأمر نحو هذا الحدّ

258
00:19:43,460 --> 00:19:45,300
،خاصّتك "طاقة الكي" لا أستشعر

259
00:19:45,330 --> 00:19:47,700
...إمّا أنّك روبوت أو إنسان آليّ

260
00:19:47,800 --> 00:19:49,470
فمَنْ هو صانعك؟

261
00:19:49,500 --> 00:19:51,740
أَعرفتَ ذلك حتّى؟

262
00:19:51,740 --> 00:19:55,750
!كان بالأحرى توقع ذلك، رغم أنّي لنْ أسبِر سرّي

263
00:19:55,850 --> 00:20:00,650
دعني أحزر، أَتخطّط لمقارعتي؟

264
00:20:00,740 --> 00:20:06,480
!أصبت! والآن يتعيّن عليَّ أنْ أبطش بك

265
00:20:06,530 --> 00:20:10,110
لا تلُمني، فما الأوامر إلّا لتنفَّذ

266
00:20:11,220 --> 00:20:13,190
!حسنٌ، فلنُنهِ الأمر

267
00:20:23,330 --> 00:20:24,270
!ماذا؟

268
00:20:31,610 --> 00:20:33,300
مِن أين تظهر تلك الرّسائل؟

269
00:20:34,710 --> 00:20:37,050
!خيّبتَ أملي قليلًا

270
00:20:37,110 --> 00:20:39,450
!ظننتك أفضل مِن هذا بكثير

271
00:20:56,400 --> 00:20:57,580
!قُضي الأمر

272
00:21:05,540 --> 00:21:08,750
!ماذا؟ هل نُسِفَ إلى أشلاء؟

273
00:21:08,780 --> 00:21:11,090
!أردتُ رؤية جثمانه

274
00:21:16,090 --> 00:21:18,350
!أحسبُني سأتّبعه

275
00:21:30,430 --> 00:21:33,040
ما هذا المبنى؟

276
00:21:45,280 --> 00:21:46,650
!"ݠامّا 2" أهلًا بالسيد

277
00:21:46,660 --> 00:21:47,520
!أهلًا

278
00:21:50,620 --> 00:21:52,920
!بورك عملك المُضنيّ-
!مرحبًا بعودتك-

279
00:21:59,230 --> 00:22:00,560
!لقد اختفى

280
00:22:26,720 --> 00:22:28,160
هناك

281
00:22:36,800 --> 00:22:38,480
"ݠامّا 2" مرحبًا بعودتك يا سيد

282
00:22:38,500 --> 00:22:40,910
مسرور لأنّي عُدت

283
00:22:41,310 --> 00:22:42,370
!؟"ݠامّا" اسمه

284
00:23:05,560 --> 00:23:07,850
"ݠامّا 2" أحسنت صنعًا يا

285
00:23:07,930 --> 00:23:10,250
شاهدتُ كلّ شيء عبر عيْنيك

286
00:23:10,330 --> 00:23:12,180
"هيدو" جزيل الشّكر لك يا دكتور

287
00:23:12,200 --> 00:23:15,250
رغم كوني قد بالغتُ كثيرًا لمحض اختبارٍ

288
00:23:15,250 --> 00:23:17,060
ݠامّا

289
00:23:17,040 --> 00:23:19,000
ماذا؟ أَثمّة آخر؟

290
00:23:19,010 --> 00:23:19,580
!يا هذا

291
00:23:19,590 --> 00:23:20,480
!واهٍ! لا شيء

292
00:23:20,490 --> 00:23:22,590
كلّا، اتّخذتَ القرار الصّائب

293
00:23:22,610 --> 00:23:28,000
إنّما تعيّن عليك اتّخاذ وضعيّةً أقوى أثناء مُستهلّ وخاتمة القتال

294
00:23:28,020 --> 00:23:30,850
!لا أصدّق إدراك العدوّ لهويّته الحقيقيّة

295
00:23:30,990 --> 00:23:35,230
؟"الأحمر الرِباط جيش" أَلمْ ترِد حصولهم على شارة

296
00:23:35,290 --> 00:23:36,760
هل حُدِّدَ مكان جثّته؟

297
00:23:36,760 --> 00:23:37,700
أيُّ جثّة؟

298
00:23:37,760 --> 00:23:40,700
!لقد نُسِفَ إلى أشلاء، فما جدوى ذلك

299
00:23:40,860 --> 00:23:42,700
!يا لك مِن مُتراخٍ

300
00:23:42,800 --> 00:23:46,240
مِن المحال أنْ ينجو، أَولمْ تشاهد ذلك؟

301
00:23:47,640 --> 00:23:49,500
!اُنظر هنا-
ماذا؟-

302
00:23:49,840 --> 00:23:50,900
!باهتٌ جدًا

303
00:23:50,940 --> 00:23:55,030
؛ فمحتمل أنّ منظمة أعدائنا علِمتْ بوجودنا"پيكّولو" إذا كان

304
00:23:55,080 --> 00:23:59,650
لا تقلقك، إذْ علِموا، فلنْ يمكنهم العثور على قاعدتنا السّرّيّة

305
00:23:59,780 --> 00:24:06,090
،ولو فعلوا، فيمكننا دَحرهم جميعًا في آنٍ واحد
!"ݠامّا 1" أنت بالغ التّزمُّت يا

306
00:24:06,100 --> 00:24:07,300
أيُّ منظمة؟

307
00:24:08,060 --> 00:24:10,000
!بلْ أنت المتساهل بشدّة

308
00:24:10,930 --> 00:24:13,130
"كارمَين يقدّم"

309
00:24:13,250 --> 00:24:20,900
ما يُظهرونه كزعماءٍ متوسّطِي القوّة، فإنّ رفقاء
لذوو بأسٍ شديد "ڤيجيتا"و "سون ݠوكو"

310
00:24:21,000 --> 00:24:27,030
،وزِد على ذلك ،"ماجين بوو" ولديهم كذلك المُخيف
!البَئِيس "ساتان" لا نَفتأ نجهل كامل القوّة الحقيقيّة للسيد

311
00:24:27,060 --> 00:24:33,210
!"ݠامّا" ولا يهمّك، لقد أثبتنا في قتالٍ مباشر مدى روعة تحفتي

312
00:24:33,220 --> 00:24:35,850
!ليس كافيًا-
تبًّا! ماذا عن هذا؟-

313
00:24:35,860 --> 00:24:39,200
؟"ݠامّا" سهل المنال يا "پيكّولو" أَلمْ يكُن الملك الشّيطانيّ الأعظم

314
00:24:39,220 --> 00:24:41,800
!نعم، كان خيبة أملٍ كبيرة

315
00:24:42,160 --> 00:24:45,930
الدّاهية "جيرو" لمْ أتوقع غيْر ذلك مِن حفيد الدكتور

316
00:24:46,960 --> 00:24:50,130
!أنا أشبه بخارق النُّبوغ

317
00:24:51,000 --> 00:24:56,530
،يلوذ بالفرار "پيكّولو" حسنًا يا "خارق النُّبوغ"، لأنّك تركتَ
فحريٌّ بنا الإسراع في خططنا

318
00:24:56,540 --> 00:24:58,050
!لا تقلق

319
00:24:58,280 --> 00:25:00,620
،توًّا "ݠامّا" بعدما أثبتُ مقدار قوّة

320
00:25:00,640 --> 00:25:06,380
باِستطاعتي استخدام بياناتهم لصنع عديد النّسخ التي سنحتاجها بلا وقتٍ يُذكر

321
00:25:06,450 --> 00:25:11,370
،مع مجتمعها السّرّيّ الشّرّانيّ "بولُما" وبمجرّد التّخلص مِن

322
00:25:11,390 --> 00:25:16,580
،حينها تابعيها مِن الجيوش والشّرطة لنْ يُبدوا أيّة مقاومة

323
00:25:16,630 --> 00:25:20,170
!وسنتولّى زمام أمور هذا العالَم الفاسد في طرفة عيْن

324
00:25:20,230 --> 00:25:25,880
؟"ماكس سيل" متى سيكتمل ،"هيدو" الأكثر أهميّة يا دكتور

325
00:25:25,900 --> 00:25:27,500
!"ماكس سيل"

326
00:25:27,770 --> 00:25:31,540
..."ݠامّا" بوجود "ماكس سيل" لا تقلق، لسنا في حاجةٍ إلى

327
00:25:31,600 --> 00:25:33,600
لقد سألتك: متى؟

328
00:25:33,680 --> 00:25:38,370
...يا إلهي! أتقصد ذاك
مِن المحتمل أنْ يستغرق وقتًا أطول

329
00:25:38,380 --> 00:25:41,160
!خِلتك قلتَ أنّه اكتمل تقريبًا

330
00:25:41,180 --> 00:25:47,690
نفسه، إنّما برنامج التّحكم بعقله "ماكس سيل" أكملتُ
سوف يستغرق وقتًا أطول ليكتمل

331
00:25:50,280 --> 00:25:52,500
حَتّامَ تتوقّعني سأنتظر؟

332
00:25:52,510 --> 00:25:54,900
..."ماجينتا" لا تؤاخذني لقولي هذا أيّها القائد

333
00:25:54,930 --> 00:26:01,020
"كنتَ مَنْ طَلَبَ منّي ابتداع "قوّة لا يمكن تخيّلها
مهما استغرق ذلك مِن الوقت

334
00:26:01,040 --> 00:26:04,510
!"ماكس سيل"يتبادى أنّك لا تهتمّ كثيرًا بـ

335
00:26:04,580 --> 00:26:07,300
،إنّه لا يُحاكي البطل الخارق بلا شكّ

336
00:26:07,380 --> 00:26:12,080
البيانات إليه "جيرو" وأيضًا، لا يروق لي كيفيّة اسناد الدكتور

337
00:26:12,080 --> 00:26:17,150
ذو قوّة راسخة، واثقٌ أنّك رأيت التّقارير الإخبارية في حينها "سيل"

338
00:26:17,350 --> 00:26:22,330
،إلّا أنّ بياناته كانت بالغة التّعقيد علينا لإعادة تكوينه بأنفسنا

339
00:26:22,360 --> 00:26:26,840
فحسبتُ أنّك ستقدر على إعادته حتّى أقوى عن ذي قَبل

340
00:26:26,860 --> 00:26:31,150
!قطعًا، وبلا أدنى صعوبة، اعتقدتُ فقط أنّها مضيعة للوقت

341
00:26:31,740 --> 00:26:35,350
..."ماكس سيل" بدلًا مِن "ݠامّا" إنْ لمْ تبالغ في تركيزك على

342
00:26:35,370 --> 00:26:37,510
!لكان حتمًا مكتملًا الآن

343
00:26:37,540 --> 00:26:42,020
يتطوّر بإنشاء خلاياه الخاصّة تدريجيًّا "سيل"روبوت كـ

344
00:26:42,050 --> 00:26:44,720
فمِن الجليّ أنْ يتطلّب هذا انتظارًا أطول

345
00:26:44,720 --> 00:26:49,870
رغم كلّ شيء، يجب أنْ تشكرني على
"ݠامّا" اغتنامي لوقت الاِنتظار في تطوير

346
00:26:49,890 --> 00:26:54,990
!هذا يكفي

347
00:26:50,550 --> 00:26:54,990
لا أبالي بشيءٍ إلّا بتفعيل

348
00:26:51,700 --> 00:26:54,990
!"ماكس سيل"

349
00:26:56,630 --> 00:26:59,400
!"ماجينتا" لا تتعجّل أيّها القائد

350
00:26:59,800 --> 00:27:03,580
ليغدونّ وحشًا أعظم ممّا كان عليه سالف عهده

351
00:27:03,600 --> 00:27:07,180
"الأحمر الرِباط جيش" ولكنّه سيكون الوسيلة الأمثل للتّباهي بقوّة

352
00:27:07,200 --> 00:27:12,720
لتكوننّ طامّة كُبرى إنْ أطلقنا العنان له في العالَم بحالته تلك

353
00:27:12,740 --> 00:27:13,440
ولمَ هذا؟

354
00:27:13,500 --> 00:27:19,280
!سيصير غيْر قابلٍ للسيطرة
أَحقًّا تريد تدمير العالَم العازم على حكمه؟

355
00:27:21,120 --> 00:27:26,180
قادران على تولّي أمر أيّ أعداءٍ خطِرة "ݠامّا"فإنّ الـ ،"ماكس سيل" حتّى دون

356
00:27:26,190 --> 00:27:31,530
لتتباهى بقوّتك للعالَم قاطبةً "ماكس سيل" فاِنتظر وقتما يتمّ تفعيل

357
00:27:31,700 --> 00:27:35,150
!آمل أنْ أثق فيك

358
00:27:35,990 --> 00:27:37,470
!بالطّبع يمكنك

359
00:27:37,470 --> 00:27:39,940
...هذا نذير سوء

360
00:27:45,480 --> 00:27:49,720
مَنْ معي؟
!يا للهول! ما توقعتُ اتصالًا مِنك مطلقًا

361
00:27:49,750 --> 00:27:51,550
متواجد؟ "ڤيجيتا" هل ،"بولُما" يا

362
00:27:51,580 --> 00:27:54,730
"بِيروس" لا، كما العادة غادر إلى كوكب الإله

363
00:27:54,790 --> 00:27:57,110
ربما مرّت ثلاثة أسابيعٍ مُذ رأيته

364
00:27:57,190 --> 00:27:58,120
معه؟ "ݠوكو" أَذهب

365
00:27:58,120 --> 00:27:59,490
مِن دون شكّ

366
00:27:59,760 --> 00:28:03,050
؟"وِيس"أَليس لديكِ جهاز الاِتصال بـ

367
00:28:03,060 --> 00:28:05,420
أخبِريهم أنْ يرجعوا كافّة

368
00:28:05,480 --> 00:28:07,840
ماذا؟ هل هناك ما يسوء؟

369
00:28:07,960 --> 00:28:11,970
،أجل، سأوضّح لاحقًا
ولكنْ يبدو أنّ أمرًا مريعًا سيقع

370
00:28:11,970 --> 00:28:15,310
حسنًا فهمتُ! سأحاول الاِتصال بهم

371
00:28:16,040 --> 00:28:19,050
والآن، سأضّطر لتدبّر الأمر بنفسي

372
00:28:19,510 --> 00:28:22,120
!"حبّات السينزو" صحيح! قد تتوفّر بعض

373
00:28:39,660 --> 00:28:41,300
!انتظر! انتظر! انتظر

374
00:28:46,000 --> 00:28:49,420
!اندفعتَ باِهتياجٍ شديد مجددًا

375
00:28:49,740 --> 00:28:53,180
كم مرّة عليَّ إخبارك أنْ تكبحَ جماحك؟

376
00:28:53,180 --> 00:28:55,610
!متأسّف! لمْ أقصد

377
00:28:59,780 --> 00:29:06,400
أَلنْ تتوقّف عن هذا؟
!إذْما تقعُد ساكنًا؛ يُغطِّ الصّدأ مهارتك

378
00:29:06,560 --> 00:29:11,600
الذي معنا "برولي"و ،"جيرين" العالَم حافلٌ بأمثال

379
00:29:12,800 --> 00:29:16,600
!وكثيرٌ مِن الأشخاص المذهلِين

380
00:29:16,900 --> 00:29:20,700
!اُصمتْ ولا تتدخّل! فهذا تدريبٌ أيضًا

381
00:29:20,770 --> 00:29:25,200
!كذّابٌ أشِر! فمُحالٌ أنْ يكون هذا أحد أنواع التّدريب

382
00:29:25,340 --> 00:29:28,000
!ما فهمتَ الأمر فحسب

383
00:29:28,010 --> 00:29:29,400
فِهم ماذا؟

384
00:29:29,550 --> 00:29:37,090
،قويًّا على نحوٍ ساحق "جيرين" كان
رُغم أنّ طاقته ما كانت مختلفةً عنّا حقًّا

385
00:29:37,190 --> 00:29:38,230
!ماذا؟

386
00:29:38,460 --> 00:29:42,250
أَلمْ تلاحظ استخدامه لكامل طاقته بكفاءةٍ تامّة؟

387
00:29:42,390 --> 00:29:48,850
وفي خِضمّ القتال، كان جسده وروحه في راحةٍ تامّة حتّى لحظة ضربَتك

388
00:29:48,870 --> 00:29:49,700
أَحقًّا؟

389
00:29:49,710 --> 00:29:55,110
هجومٌ مِن العدم يتعذّر على العدوّ التّنبّؤ به، فإذْ به يَدحر وابل اللّكمات

390
00:29:55,110 --> 00:29:57,770
وما هو أكثر، لا هَدرَ لمقدرته على التّحمل

391
00:29:57,870 --> 00:29:59,550
...فعلًا

392
00:29:59,610 --> 00:30:02,300
على الأرجح أنّه حقّقها بفضل غريزته

393
00:30:02,450 --> 00:30:06,580
ولأنّي لستُ قادرًا عليها، لذا شرعتُ في تدريب عقلي

394
00:30:06,620 --> 00:30:09,750
!نعم! نعم! نعم! ممتاز

395
00:30:09,750 --> 00:30:15,030
!أنا منبهرٌ لإدراكك ذلك ،"ڤيجيتا-سان" أنت حقًّا رائع يا

396
00:30:15,160 --> 00:30:22,020
!أصبتَ كبد الحقيقة! لا تدركها بكثرة التّدريب لتقوية جسدك كالأحمق

397
00:30:22,130 --> 00:30:23,300
...أجل

398
00:30:24,270 --> 00:30:27,300
رغم استغراقك لوقتٍ طويل لمعرفتها

399
00:30:27,700 --> 00:30:31,200
لمْ يَتواءم معها بشكلٍ كامل "ݠوكو-سان" ويتضح أنّ

400
00:30:31,310 --> 00:30:35,680
بالحقّ! لمَ لا يقوم ثلاثتكم بمباراة سِجالٍ؟

401
00:30:35,750 --> 00:30:38,580
!حتمًا تمزح !"برولي" مع

402
00:30:38,680 --> 00:30:43,700
لقد تحسّن قليلًا، لكنّه لا ينفكّ يجمح هائجًا أحيانًا

403
00:30:43,770 --> 00:30:47,670
!إنْ أطلق لنفسه العنان؛ سيُحمِّص هذا الكويْكب

404
00:30:47,860 --> 00:30:49,600
أعتقد ذلك

405
00:30:49,660 --> 00:30:59,250
"برولي-سان"سيظهران لـ "ڤيجيتا-سان"و "ݠوكو-سان" إذنْ فإنّ
كيف تكون مباراة السِّجال المقيّدة

406
00:30:59,270 --> 00:31:00,410
سمعًا وطاعة

407
00:31:01,670 --> 00:31:02,700
!"وِيس" يا

408
00:31:03,740 --> 00:31:06,200
منذ متى وأنا في غفوةٍ؟

409
00:31:06,280 --> 00:31:08,800
...أنعمتَ صباحًا! لنرى

410
00:31:12,080 --> 00:31:18,450
!ماذا؟ استيقظتُ أبكر ممّا اعتقدتُ
!ولمَ كلّ هذه الجَلَبَة؟ إنّي أشمّ رائحة لذيذة

411
00:31:19,590 --> 00:31:21,050
مَنْ هذا؟

412
00:31:21,060 --> 00:31:22,700
"برولي-سان" إنّه

413
00:31:23,130 --> 00:31:26,080
ماذا يفعل هنا؟ !"برولي"

414
00:31:26,100 --> 00:31:29,150
هنا، أليس كذلك؟ "فريزا" لا سبيل لأنْ يجده

415
00:31:29,200 --> 00:31:31,080
لذا أحضرناه معنا ليَسْلَم مِن خطره

416
00:31:31,100 --> 00:31:33,550
لا تحضر مَنْ تشاء إلى هنا

417
00:31:33,600 --> 00:31:35,750
!هذا ليس فندقًا

418
00:31:38,740 --> 00:31:41,170
!هأنتذا، ألقِ التّحية

419
00:31:41,180 --> 00:31:44,370
!أنا .. أعتذر على التّطفّل

420
00:31:45,420 --> 00:31:47,700
وأنت يا هذا، مَنْ تكون؟

421
00:31:47,720 --> 00:31:51,300
..."فريزا جيش" عضو سابق في  ،"ليمو" اسمي

422
00:31:52,990 --> 00:31:56,700
هذا مصدر الرّائحة اللّذيذة، هيا اجلبه

423
00:31:56,730 --> 00:31:58,560
...حاضر سيدي

424
00:32:05,600 --> 00:32:08,780
؟"فريزا جيش" ليس سيّئًا! ماذا كانت مهامك في

425
00:32:08,810 --> 00:32:11,750
قمتُ بمهامٍ صغيرة، مِن ضمنها الطّهي

426
00:32:11,780 --> 00:32:14,120
حسنًا، يمكنك البقاء

427
00:32:14,180 --> 00:32:16,500
...إنّه بَعيد جدًّا

428
00:32:16,810 --> 00:32:18,440
تبدو بخير حال

429
00:32:18,480 --> 00:32:19,280
أجل

430
00:32:19,280 --> 00:32:20,250
!مرحبًا

431
00:32:20,280 --> 00:32:21,850
أنتم هنا يا رفاق أيضًا

432
00:32:21,890 --> 00:32:25,310
!بالكاد وجدت شيئًا ذا قيمة في هذا المكان، يا لها مِن خيبة

433
00:32:25,320 --> 00:32:27,690
!"تشيلاي" أطبقي فمكِ يا

434
00:32:33,860 --> 00:32:36,350
!سأقوم ببعض التّنظيف

435
00:32:36,430 --> 00:32:38,180
والآن، مَنْ هذه؟

436
00:32:38,230 --> 00:32:41,130
...وأنت ،"تشيلاي" أنا أدعى

437
00:32:41,140 --> 00:32:45,200
؟"بِيروس-ساما" أقصد، أَيُصادف أنّ جلالتك إله الدّمار

438
00:32:45,940 --> 00:32:47,150
!أيْ نعم

439
00:32:47,180 --> 00:32:51,350
الذي يقولون عنه مَهيب الذِّكر مُفزع الكون قاطبةً؟

440
00:33:05,200 --> 00:33:06,650
!تبدين لطيفة

441
00:33:06,760 --> 00:33:07,500
!ماذا؟

442
00:33:07,700 --> 00:33:09,730
يمكنكِ المكوث قدرما تشائين

443
00:33:11,600 --> 00:33:13,670
!ما... ماذا؟

444
00:33:13,870 --> 00:33:18,200
!تقليديًّا هكذا "بِيروس-ساما" ما توقعتُ أنْ يكون ذوق

445
00:33:18,340 --> 00:33:22,450
!حسنًا إذًا! لا تهتموا لما حدث! هيّا ابدآ المباراة

446
00:33:22,550 --> 00:33:24,910
مَنْ يصمدْ أخيرًا يَفُزْ

447
00:33:24,910 --> 00:33:30,390
التّحوّلات والضّربات كـ"كامي هامي ها" محظورة، أَتقبلان بذلك؟

448
00:33:31,760 --> 00:33:35,780
!دعنا نأكل أولًا، فأنا أتضوّر جوعًا

449
00:33:36,930 --> 00:33:39,680
!"السَيّاجين"واهٍ واهٍ على معشر

450
00:33:40,160 --> 00:33:41,650
ماذا؟

451
00:33:42,000 --> 00:33:45,000
أين جهاز للاِتصال خاصّتي يا ترى؟

452
00:33:45,940 --> 00:33:48,350
أين وضعته بحقّ السّماء؟

453
00:33:49,970 --> 00:33:54,420
مِن طعام "الأرض" اللّذيذ إلّا وجَلبه "ڤيجيتا-سان" ما ترك

454
00:33:54,480 --> 00:34:00,800
!تحضير وجبةٍ لنا، آملين بأطيب مذاقٍ "ليمو" لذا طلبتُ مِن

455
00:34:02,590 --> 00:34:07,840
بديع! كيف أعددتها؟
!"ليمو-سان" كما لو كانت سحرًا يا

456
00:34:07,890 --> 00:34:10,470
...أضفتُ بعض التّوابل

457
00:34:10,490 --> 00:34:12,780
أنت، ما المختلف فيها؟

458
00:34:12,800 --> 00:34:14,330
!ليس لديّ فكرة

459
00:34:15,470 --> 00:34:20,220
!"ليمو" أعجبتني! مِن الآن فصاعدًا أنت المسؤول عن الطّهي يا
!"وِيس" أمّا أنت فمطرودٌ يا

460
00:34:20,230 --> 00:34:23,210
!يا للأسى! إنّي لمَحزون

461
00:34:39,820 --> 00:34:41,790
!هيّا ابدآ

462
00:35:57,300 --> 00:35:58,470
!لمْ أنتهِ بَعد

463
00:36:10,510 --> 00:36:13,320
!"كاكاروتّو" إيّاك أنْ تتمادى يا

464
00:36:19,820 --> 00:36:21,260
!لا تستهِن بيّ

465
00:36:34,270 --> 00:36:38,880
قليلًا عن ذي قَبل "ڤيجيتا" تختلف حركات

466
00:36:40,680 --> 00:36:43,160
أفترض أنّها نتيجة تدريبه

467
00:36:43,180 --> 00:36:46,070
يبدو أنّهما سيستغرقان بعض الوقت

468
00:36:46,080 --> 00:36:48,800
ماذا عن التّحلية؟

469
00:36:48,890 --> 00:36:50,000
مثل ماذا؟

470
00:36:50,020 --> 00:36:54,280
"ڤيجيتا-سان" لا زال لدينا مقدار وافر مِن "المثلّجات" التي جلبها

471
00:36:54,360 --> 00:36:57,470
في هذه الحالة، سأذهب لأحضرها

472
00:36:57,490 --> 00:36:59,780
!إذنْ سأساعدكِ

473
00:36:59,830 --> 00:37:00,900
!يا سلام

474
00:37:01,370 --> 00:37:08,600
!المثلّجات، المثلّجات، المثلّجات، ها هي
!"ليمو" أنت يا

475
00:37:08,610 --> 00:37:09,830
نعم سيدي؟

476
00:37:09,870 --> 00:37:13,500
!يمكنك غسل الأطباق لاحقًا، تعال وشاركنا أكل المثلّجات

477
00:37:13,710 --> 00:37:15,110
!هلّا تعفني

478
00:37:16,250 --> 00:37:21,150
!ها هو ذا! وجدته

479
00:37:25,190 --> 00:37:28,090
!كُلْ معنا !"برولي" يا

480
00:37:53,380 --> 00:37:58,430
!"بِيروس-ساما" هذا لطفٌ بالغ منك
أُسائل نفسي، لمِن يا ترى فعلتَها؟

481
00:37:58,450 --> 00:38:00,250
!اُخرُس وكُلْ

482
00:38:09,430 --> 00:38:12,000
!"وِيس" أيا سيد !"وِيس" أيا سيد

483
00:38:13,500 --> 00:38:18,500
لماذا لا تردّ على اتصالي؟

484
00:38:18,980 --> 00:38:23,220
فهمت، لمْ أكُن أعرف حدوث هذا

485
00:38:23,250 --> 00:38:25,600
أنا في غاية الأسف

486
00:38:25,650 --> 00:38:27,100
في الوقت الرّاهن، ليس لديّ سوى حبّتَين

487
00:38:27,120 --> 00:38:30,640
!اثنتان؟ حسنًا، أشكرك

488
00:38:30,690 --> 00:38:33,300
!"رجاءً توخَّ الحذر يا "إلهنا

489
00:38:33,370 --> 00:38:34,960
!"إنّني لمْ أعُد "إلهًا

490
00:38:34,960 --> 00:38:36,950
!ذلك .. صحيح

491
00:38:39,660 --> 00:38:43,210
؟"بولُما" هل اتصلتِ بهم يا

492
00:38:43,230 --> 00:38:47,010
كلّا، فلمْ يُجبني أيّ أحد

493
00:38:47,070 --> 00:38:49,250
ولكنّني سأستمرّ في المحاولة لفترةٍ أطول

494
00:38:49,270 --> 00:38:51,800
هكذا إذًا، أشكركِ واستمرّي بالمحاولة

495
00:38:51,810 --> 00:38:53,900
أَما استطاعت الاِتصال بهم؟

496
00:38:53,980 --> 00:38:57,330
!"ڤيجيتا"أو "ݠوكو" أظنّ ذلك، ستكون مهمّتنا أصعب دون

497
00:38:57,350 --> 00:39:04,550
على قدم المساواة معهما "ݠامّا"إذا حكمنا على قتالي، فإنّ روبوتَيْ الـ

498
00:39:04,650 --> 00:39:07,120
...وحتمًا تلك أنباء سيّئة

499
00:39:07,160 --> 00:39:08,910
؟"سون ݠوهان" ماذا عن

500
00:39:08,960 --> 00:39:16,150
أَلمْ تقُل ذات مرّة, بإمكانه الغدوّ أقوى شخصٍ
على الأرض إذا عَزَمَ عزمًا أكيدًا على ذلك؟

501
00:39:16,170 --> 00:39:18,900
لا يُعتمد عليه بحالته الحاليّة

502
00:39:18,970 --> 00:39:20,600
