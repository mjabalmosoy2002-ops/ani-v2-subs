503
00:39:20,870 --> 00:39:26,320
"رقم 18"و "رقم 17" بيانات عن نقاط ضعف "هيدو"لربّما يملك الدكتور

504
00:39:26,380 --> 00:39:30,080
"ماجين بوو"وكذلك السّبات الحاليّ لـ

505
00:39:30,080 --> 00:39:32,000
...ممّا يعني

506
00:39:32,080 --> 00:39:36,490
لا أصدّق أنّي مضطرّ لتدبّر الأمر بمفردي

507
00:39:36,490 --> 00:39:38,010
...بالحقّ

508
00:39:41,290 --> 00:39:42,530
"پيكّولو-سان"

509
00:39:42,530 --> 00:39:43,630
"ديندي"

510
00:39:44,330 --> 00:39:45,880
هل تبيَّنتَ الموقف؟

511
00:39:45,900 --> 00:39:48,400
أجل، أبصرتُه مِن أعلى

512
00:39:48,500 --> 00:39:52,340
إذْ تبدو الأمور قاتمة، أَبوسعي فعل أيّ شيء؟

513
00:39:52,370 --> 00:39:54,130
،"كوكب ناميك" تناهى إلى مسامعي على

514
00:39:54,140 --> 00:39:59,680
قوّتهما الكامنة "ݠوهان"و "كوريرين" استخلص مِن "ݠورو" أنّ شيخنا الأعظم

515
00:39:59,690 --> 00:40:01,940
فعلًا، كنتُ شاهدًا على ذلك

516
00:40:02,610 --> 00:40:04,300
!افعل ذات الأمر معي

517
00:40:04,380 --> 00:40:05,700
مَنْ؟ أنا؟

518
00:40:05,850 --> 00:40:07,100
هذا صحيح

519
00:40:07,220 --> 00:40:11,000
مِن نفس فئة شيخنا الأعظم "ناميكيٌّ" إنّك

520
00:40:11,050 --> 00:40:12,400
يُفترض أنّك أهلٌ لها

521
00:40:12,420 --> 00:40:17,850
مع الأسف، ليست بمقدرتي إلّا بَعدما أبلُغ سنًّا معيّنة

522
00:40:17,890 --> 00:40:19,300
ما... ماذا؟

523
00:40:19,660 --> 00:40:23,100
؟"كرات التِّنِّين" صحيح! لمَ لا نلجأ إلى

524
00:40:23,300 --> 00:40:24,700
!"كرات التِّنِّين"

525
00:40:24,850 --> 00:40:27,500
!"الأحمر الرِباط جيش" بوسعنا تمنّي اندثار

526
00:40:28,700 --> 00:40:31,830
رغم علمي أنّ كبرياءك سيَحُول دون ذلك

527
00:40:31,910 --> 00:40:37,710
باستخلاص قوّتك الكامنة كما شيخنا الأعظم؟ "شينرون" إذًا، لمَ لا نكلّف

528
00:40:37,710 --> 00:40:40,300
فعلها؟ "شينرون" وهل بمقدور

529
00:40:40,380 --> 00:40:42,420
!"ربّما حال قيامي بـ"ترقيته

530
00:40:42,450 --> 00:40:43,750
!ترقيته"؟"

531
00:40:43,820 --> 00:40:48,000
أَلا تذكر زيادة تحقيق الأماني مِن واحدة إلى ثلاثة؟

532
00:40:48,160 --> 00:40:51,650
فالأمر شبيه بهذا، رجاءً انتظر قليلًا

533
00:41:20,120 --> 00:41:23,650
!حسنًا، يُفترض أنّ "ترقيته" قد تمّت

534
00:41:23,760 --> 00:41:26,450
!كـ"إله" سابق، ما كنتُ أعرف أنّ هذا ممكن

535
00:41:26,500 --> 00:41:29,650
لأنّك أتيتَ إلى "الأرض" منذ زمنٍ طويل

536
00:41:29,730 --> 00:41:33,200
"كرات التِّنِّين" لكنّنا سنحتاج إلى وقتٍ لنجمّع

537
00:41:33,270 --> 00:41:37,700
"بولُما-سان" أظنّ الكرات السّبع بحوزت

538
00:41:37,740 --> 00:41:47,770
وموظّفيها الكرات "بولُما-سان" خلال السّنوات القليلة الماضية، جمّعتْ
لكيْ تتمنّى أمنيّات تافهة حتّى تمنع استخدامها في الشّرّ

539
00:41:47,880 --> 00:41:50,740
!وبالتّأكيد ليس مِن أجل تلك الغاية فحسب

540
00:41:50,790 --> 00:41:55,310
سرقها؟ "فريزا جيش" أَلا تذكر منذ فترةٍ قريبة أنّ

541
00:41:55,370 --> 00:41:58,770
مرّة أخرى "كرات التِّنِّين" وبعدما تحقّقتْ أمنيّته، تبعثرتْ

542
00:41:58,790 --> 00:42:02,100
مفهوم، أيًّا ما كان فهو مِن حسن حظّنا

543
00:42:03,900 --> 00:42:05,030
!"بولُما" يا

544
00:42:05,030 --> 00:42:07,380
نعم، نعم، أسمعك

545
00:42:07,400 --> 00:42:08,560
هل تواصلتي معهم؟

546
00:42:08,600 --> 00:42:10,810
ليس بَعد للأسف

547
00:42:10,840 --> 00:42:14,140
؟"كرات التِّنِّين" أَمِنَ الممكن أنّ لديكِ ،"بولُما"

548
00:42:14,140 --> 00:42:17,850
وما المانع؟ فلديّ السّبع كرات !"كرات التِّنِّين"

549
00:42:17,870 --> 00:42:22,350
!جيّد، سعيتِ جاهدة لتجمعينها، فهلّا سمحتي لنا باستخدامها

550
00:42:22,390 --> 00:42:23,600
!ماذا؟

551
00:42:23,620 --> 00:42:27,700
مِن فضلكِ! أَلنْ تستخدميها لطلب شيءٍ عديم الجدوى بأيّ حال؟

552
00:42:27,720 --> 00:42:30,230
...لا أضيّعها فيما لا يجدي نفعًا

553
00:42:30,360 --> 00:42:33,750
!ولكنْ كُرمى لمسعاك، فلا بأس...

554
00:42:33,800 --> 00:42:35,730
!أشكركِ! سوف آتي حالًا

555
00:42:35,800 --> 00:42:37,800
!انتظريني خارجًا بالحديقة

556
00:42:41,900 --> 00:42:47,100
باسمك أطلب ظهورك ،"شينرون" أيا تنّين الخلود

557
00:43:05,230 --> 00:43:12,210
...اجهَر بما شئتَ وسأمنحك إيّاه
!"پيكّولو" يا للهول! الإله

558
00:43:12,230 --> 00:43:20,700
هل بمقدورك استخلاص كامل طاقتي الكامنة ،"شينرون" يا
؟"ݠورو" الأعظم؛ "الناميكيِّين" كما شيخ

559
00:43:20,710 --> 00:43:25,030
طبعًا نعم، هل هذه أمنيّتك الأولى؟

560
00:43:25,050 --> 00:43:27,320
نعم، فضلًا افعلها

561
00:43:43,100 --> 00:43:46,750
!يا لهذا الشعور .. إنّ قوّتي .. ارتفعت بهذا القدر

562
00:43:46,770 --> 00:43:49,500
!كذلك ثمّة منحة إضافيّة

563
00:43:54,610 --> 00:43:57,910
والآن، رجاءً اُذكر الأمنيّتَيْن الأخريَيْن

564
00:43:57,920 --> 00:43:59,210
تحصّلتُ على مبتغاي

565
00:43:59,220 --> 00:44:01,550
ماذا؟ أَحقًّا؟ أَهذا كلّ شيء؟

566
00:44:01,620 --> 00:44:04,600
إذًا، هل لي بطلب الأمنيّتَيْن الأخريَيْن

567
00:44:04,620 --> 00:44:06,940
بالطّبع، لكِ مطلق الحرّيّة

568
00:44:06,960 --> 00:44:13,140
!في هذه الحالة، ماذا عن جعل مؤخّرتي مشدودة أكثر؟ كأنّي فتاة صغيرة

569
00:44:13,200 --> 00:44:14,090
!ماذا؟

570
00:44:14,130 --> 00:44:18,850
أمنيّةٌ بسيطة، وقد منحتكِ إيّاها

571
00:44:19,000 --> 00:44:24,300
!أمّا الثّالثة، ربّما إزالة التّجاعيد حول عيْنيّ مجددًا

572
00:44:24,340 --> 00:44:25,500
!انتظر لحظة

573
00:44:25,510 --> 00:44:26,710
ما الأمر؟

574
00:44:26,740 --> 00:44:29,850
أَلا يوجد .. أيّ شيءٍ آخر لتتمنّيه؟

575
00:44:29,910 --> 00:44:32,040
!وما الضّرر في ذلك؟

576
00:44:32,110 --> 00:44:36,120
حسنًا، ما رأيك أن أجعل رموشي أطول بمقدار 2مم؟

577
00:44:36,750 --> 00:44:38,350
منحتكِ إيّاها

578
00:44:38,520 --> 00:44:42,190
أترككُم في أمان "پيكّولو" حسنًا إذًا، أيّها الإله

579
00:44:51,300 --> 00:44:54,400
هل كلّ أمانيكِ دائمًا هكذا؟

580
00:44:54,440 --> 00:44:55,480
أَفي ذلك ضررٌ جسيم؟

581
00:44:55,500 --> 00:44:57,680
كلّا، افعلي ما يحلو لكِ

582
00:44:57,710 --> 00:45:00,850
!يا ويحي

583
00:45:00,880 --> 00:45:02,000
ما الأمر؟

584
00:45:02,010 --> 00:45:06,220
"ڤيجيتا"و"ݠوكو"كان علينا أنْ نتمنّى فقط إحضاره لـ

585
00:45:06,220 --> 00:45:09,950
...واهٍ! الفضل كلّه لشدّ مؤخرتكِ

586
00:45:09,950 --> 00:45:13,520
ماذا؟! أَلستَ بدورك لمْ تفكّر في ذلك؟

587
00:45:13,540 --> 00:45:16,890
!سأذهب لأتسلّل إلى مقرّهم ثانيةً...

588
00:45:19,160 --> 00:45:23,800
تاليًا؟ "ڤيجيتا"و "سون ݠوكو" ماذا عن استهداف

589
00:45:23,830 --> 00:45:29,100
يتحتّم علينا القضاء على جميع الزّعماء الصّفوة عوضَ انتظار هجومهم المضاد

590
00:45:29,110 --> 00:45:30,430
أين ذهبتَ؟

591
00:45:30,440 --> 00:45:33,630
شعرتُ بمغصٍ فذهبتُ إلى المرحاض

592
00:45:33,640 --> 00:45:36,670
!هل أنت على ما يرام؟ تبدو مخضرًا بعض الشيء

593
00:45:33,680 --> 00:45:36,460
إذًا؟ "رقم 18"و "رقم 17" ماذا عن الخائنَين

594
00:45:36,480 --> 00:45:40,250
البَئِيس؟ "ساتان" أو السيد

595
00:45:36,680 --> 00:45:39,170
أنا بخير

596
00:45:39,500 --> 00:45:41,410
إذا كنت لنْ تتحمّل؛ أخبِرني فورًا

597
00:45:41,420 --> 00:45:42,110
حاضر

598
00:45:42,120 --> 00:45:46,050
؟"سون ݠوهان" ؛"سون ݠوكو" وماذا عن ابن

599
00:45:46,060 --> 00:45:48,480
