1
00:00:02,200 --> 00:00:03,980
!كما هو متوقّع من صديقتي ابنة المدير

2
00:00:03,980 --> 00:00:07,080
!قمت بتجهيز حائط سرعة بالفعل

3
00:00:07,080 --> 00:00:08,730
.قمت بطلب واحد منذ مدّة

4
00:00:09,190 --> 00:00:12,680
.يمكننا الآن التدرّب على سرعة التسلّق بقدر ما نشاء

5
00:00:16,880 --> 00:00:19,210
.آسفة، لكن أرجو أن تغادري

6
00:00:20,550 --> 00:00:22,440
ما المشكلة؟

7
00:00:22,440 --> 00:00:24,870
ما الذي يعكّر صفو مزاجك هكذا؟

8
00:00:24,870 --> 00:00:27,960
...ذهبت لرؤية جون-تشان لكنّني

9
00:00:29,360 --> 00:00:31,980
.لا داعي للقلق بشأن ذلك بعد الآن

10
00:00:39,330 --> 00:00:40,620
جون-تشان؟

11
00:02:17,330 --> 00:02:20,330
.أنا سعيدة حقّا لعودتك

12
00:02:20,330 --> 00:02:21,490
.آسفة

13
00:02:21,490 --> 00:02:25,720
.أتيت لرؤيتي في الصالة الرياضيّة لكنّني تصرّفت ببرودة تجاهك

14
00:02:25,720 --> 00:02:29,500
.لا تقلقي. ما كان يجدر بي المجيء دون إخبارك هكذا

15
00:02:30,800 --> 00:02:33,880
.تحديت أوتشيمورا بعدما ذهبت

16
00:02:33,880 --> 00:02:35,630
أكاني-سان؟

17
00:02:35,630 --> 00:02:42,140
،أتت إلى مكان عملي وتحدثت بغطرسة

18
00:02:42,140 --> 00:02:43,640
.ثمّ تحدّتني

19
00:02:44,260 --> 00:02:47,270
.لست متفاجئة، لطالما كانت هكذا

20
00:02:49,370 --> 00:02:54,910
،لكنّها ساعدتني على تذكّر كيف كنت عندما بدأت التسلّق لأوّل مرّة

21
00:02:54,910 --> 00:02:56,820
.ومدى متعته

22
00:03:03,430 --> 00:03:06,190
!هذا لا يعني أنها تستحقّ كلّ الثناء

23
00:03:06,190 --> 00:03:08,150
!لست ممتنّة لها أو ما شابه

24
00:03:08,930 --> 00:03:10,380
ما-ما المضحك في الأمر؟

25
00:03:10,380 --> 00:03:12,570
.لا شيء. يسعدني سماع ذلك فحسب

26
00:03:12,570 --> 00:03:15,320
.لكن... الأمر يزعجني نوعًا ما

27
00:03:15,920 --> 00:03:18,730
.ربما أشعر بالغيرة من أكاني-سان

28
00:03:18,730 --> 00:03:20,970
.أنتما أشبه بمتنافستين وديّتين

29
00:03:20,970 --> 00:03:24,150
.كلّا، بالأحرى لا يمكنني الهرب منها

30
00:03:24,710 --> 00:03:26,930
...الشخص الوحيد الذي أعتبره منافسي هو

31
00:03:30,560 --> 00:03:31,940
.لا تهتمّي

32
00:03:32,220 --> 00:03:35,080
.كونومي، فلنعمل رفقة بعض كزميلتين في فريق هاناميا مجدّدا

33
00:03:35,080 --> 00:03:36,940
!أجل بالطبع

34
00:03:37,360 --> 00:03:42,240
!تمامًا مثلك، أصبحت أحبّ التسلّق الآن

35
00:03:44,540 --> 00:03:46,380
.تسرّني عودتك

36
00:03:46,380 --> 00:03:51,080
.من دون وجود جون، فلا يمكنني لعب دور الغبيّة

37
00:03:51,080 --> 00:03:54,970
.تلعبين" دور الغبيّة؟ ظننت أنه أمر طبيعيّ بالنسبة لك"

38
00:03:55,750 --> 00:03:58,030
.تلك سايو-تشين وليس أنا

39
00:03:58,030 --> 00:03:59,540
ماذا؟ حقّا؟

40
00:04:01,000 --> 00:04:04,810
حسنًا. هلّا بدأنا التدريب؟

41
00:04:04,810 --> 00:04:05,390
.جون

42
00:04:05,390 --> 00:04:08,750
هل يمكنك أن تواجهي كونومي-سان في مباراة سرعة؟

43
00:04:05,390 --> 00:04:09,390
ألم يلاحظ أيّ شخصٍ أنّ سايو-تشين غريبة الأطوار نوعًا ما؟

44
00:04:08,750 --> 00:04:09,390
.بالطبع

45
00:04:09,390 --> 00:04:11,890
.أنا مستعدّة لأيّ شيء

46
00:04:12,220 --> 00:04:13,960
كيف يعقل ذلك؟

47
00:04:12,220 --> 00:04:16,900
.حسنا، لمَ لا تريني ما لديك الآن

48
00:04:13,960 --> 00:04:16,900
هل لأنّني أجيد هذا الدور جيّدا؟

49
00:04:17,230 --> 00:04:18,090
.حسنًا

50
00:04:23,400 --> 00:04:29,960
التسلّق السريع يتعلّق بمدى سرعة تسلّقك لحائط
.بطول 15 مترًا بطريق محدّد

51
00:04:29,960 --> 00:04:32,160
.إنه أشبه بسباق 100 متر لكن في التسلّق

52
00:04:32,760 --> 00:04:33,660
مستعدّة؟

53
00:04:34,140 --> 00:04:35,040
.أجل

54
00:04:39,520 --> 00:04:41,550
.عرفت ذلك

55
00:04:41,550 --> 00:04:44,190
،بالنسبة لحائط يفترض أن يتمّ تسلّقه بسرعة

56
00:04:44,190 --> 00:04:46,490
لمَ كلّ مقبض يبعد مسافة كبيرة عن الآخر؟

57
00:04:48,640 --> 00:04:51,180
!كلّها مقوسة ويصعب إمساكها أيضًا

58
00:04:55,190 --> 00:04:57,190
.‫23 ثانية

59
00:05:00,240 --> 00:05:01,040
.تفضّلي

60
00:05:01,040 --> 00:05:03,950
شكرا لك. هل 23.87 ثانية جيّدة؟

61
00:05:03,950 --> 00:05:07,820
.متوسّط سرعة المتنافسات في الثانوية ما بين 16 و17 ثانية

62
00:05:08,140 --> 00:05:10,590
.المحترفات يصلن لحوالي 12 ثانية

63
00:05:10,590 --> 00:05:12,940
...حتى وإن لم تكن السرعة أفضل ميزاتك

64
00:05:12,940 --> 00:05:15,830
،إن أردت التأهّل لنهائيات الكأس الجماعيّ

65
00:05:15,830 --> 00:05:17,360
.فعليك تجاوز حدود 15 ثانية

66
00:05:17,360 --> 00:05:18,570
‫15 ثانية؟!

67
00:05:18,570 --> 00:05:19,790
!دعيني أحاول مجدّدا

68
00:05:19,790 --> 00:05:20,460
.انتظري يا كونومي

69
00:05:23,920 --> 00:05:28,680
ماذا؟ قمت بمحاولة واحدة فقط لذا، لمَ أشعر بالتعب سلفًا؟

70
00:05:28,680 --> 00:05:30,250
.لا تستعجلي الأمور يا كونومي

71
00:05:32,560 --> 00:05:35,360
.التسلّق باستمرار لن يفيدك

72
00:05:35,360 --> 00:05:37,480
.عليك تحليل مبادئ الأمور أوّلا

73
00:05:37,480 --> 00:05:39,830
مبادئ الأمور؟

74
00:05:41,670 --> 00:05:45,850
.التسلق السريع يستهلك الكثير من الطاقة في كلّ محاولة

75
00:05:46,320 --> 00:05:47,240
،لهذا

76
00:05:47,550 --> 00:05:52,160
عليك تقسيم المسار إلى قسم علويّ ونصفي وسفلي

77
00:05:52,160 --> 00:05:54,750
.ونزع الجزء الذي تجدين فيه صعوبة بحذر

78
00:05:55,120 --> 00:05:57,820
.لن يتطلّب ذلك الكثير من قدرة التحمّل

79
00:05:59,480 --> 00:06:01,720
،من أجل الفوز

80
00:06:01,720 --> 00:06:05,700
.على كلّ واحدة منّا أن تحقّق وقتًا أقل من 15 ثانية

81
00:06:06,760 --> 00:06:09,310
.سنبدأ بالتدريب الجسديّ

82
00:06:09,310 --> 00:06:11,640
.قوّة الجسد السفليّ هي مفتاح تسلّق السرعة

83
00:06:14,970 --> 00:06:19,270
تحتاجين للقوّة ليس من أجل الإمساك بالمقابض فحسب
.بل للاندفاع عليها أيضًا

84
00:06:19,840 --> 00:06:23,770
.اعملي على قوّة الضغط خاصتك عن طريق تدريب الكرة مرارا وتكرارًا

85
00:06:24,560 --> 00:06:27,780
.الداينو التي في القسم العلويّ والمنتصف هي العقد على حائط السرعة

86
00:06:28,480 --> 00:06:31,180
.اعملي عليها واحدة بواحدة واحرصي على أن تتقنيها

87
00:06:31,180 --> 00:06:32,280
.مفهوم

88
00:06:32,690 --> 00:06:34,660
.المسار هو نفسه في كلّ مكان

89
00:06:35,060 --> 00:06:36,780
تسلّقيه مرارا وتكرارا

90
00:06:36,780 --> 00:06:39,160
.واجعلي جسدك يحفظه

91
00:06:39,640 --> 00:06:42,170
!علّميه الحركات التي ستساعدك على التسلّق بأقصى سرعة

92
00:06:42,440 --> 00:06:45,300
!سنكون أفضل فريق في اليابان

93
00:06:49,300 --> 00:06:53,690
.ظننت أنّ حركاتي تحسّنت لكنّ وقتي لم يتغيّر

94
00:06:53,690 --> 00:06:54,760
.كونومي-سان

95
00:06:55,920 --> 00:06:57,810
.القائدة... وجون-تشان

96
00:06:58,160 --> 00:07:03,200
هنالك مخيّم تدريب للسرعة بين عدّة مدارس
.خلال عطلة نهاية الأسبوع القادمة

97
00:07:03,200 --> 00:07:05,320
.كلانا سنشارك يا كونومي

98
00:07:05,320 --> 00:07:07,880
...مخيّم تدريب سرعة

99
00:07:12,790 --> 00:07:14,070
.مذهل

100
00:07:14,830 --> 00:07:19,830
ألن تشارك القائدة ونونو-سان؟

101
00:07:20,190 --> 00:07:22,520
.تقومان بالتدريب ضدّ بعض

102
00:07:22,520 --> 00:07:24,100
...كما أنّ هذا المخيّم

103
00:07:25,010 --> 00:07:27,710
.بالطبع ستكونان هنا، نيا

104
00:07:27,710 --> 00:07:31,590
،قد تكونين احتللت مركزًا أفضل منّي في المسابقة الماضية

105
00:07:31,590 --> 00:07:32,950
...لكنّ السرعة هي

106
00:07:31,850 --> 00:07:35,520
.كونومي، فلنذهب للاستعداد قبل وصول الجميع

107
00:07:35,520 --> 00:07:38,520
!لا تتجاهلا وجودي

108
00:07:38,520 --> 00:07:40,960
.لم ألاحظ وجودك يا إيتشيمورا

109
00:07:40,960 --> 00:07:41,600
.نراك لاحقًا

110
00:07:41,880 --> 00:07:43,710
!ما الذي تقصدينه

111
00:07:43,710 --> 00:07:46,610
!ألا تدركين مدى حظّك بالتواجد أمام أكاني-تشان-ساما العظيمة؟

112
00:07:46,610 --> 00:07:49,320
.أنت أشبه بلعنة

113
00:07:49,320 --> 00:07:51,200
!ما الذي قلته؟

114
00:07:51,200 --> 00:07:51,990
.ابتعدي عنّي

115
00:07:52,320 --> 00:07:54,960
متى أصبحتا مقرّبتين هكذا؟

116
00:07:54,960 --> 00:07:55,990
.يا إلهي

117
00:07:56,640 --> 00:08:00,250
.أنتنّ نشطات كفتيات مدرسة إعداديّة أثناء رحلة مدرسيّة

118
00:08:00,540 --> 00:08:01,870
أوبا-سان؟

119
00:08:02,380 --> 00:08:04,650
.مرحبا يا كاساهارا-سان

120
00:08:04,650 --> 00:08:08,200
.سمعت الكثير عن أدائك المبهر مؤخّرا

121
00:08:08,200 --> 00:08:10,400
،تبدين في حالة جيّدة

122
00:08:10,400 --> 00:08:14,160
.لكنّ هذا ينطبق على التسلّق فحسب

123
00:08:14,160 --> 00:08:18,640
بطولة الكأس الجماعيّة القادمة ستقوم باختبارك
.من ناحية ثلاثة ميزات بما فيها السرعة

124
00:08:18,990 --> 00:08:20,140
...أتساءل

125
00:08:20,140 --> 00:08:23,230
هل ستتمكّنين من اللمعان في اختبار السرعة؟

126
00:08:23,890 --> 00:08:26,150
،لأنه ومنذ خسارتي أمامك المرّة الماضية

127
00:08:26,540 --> 00:08:29,820
!كرّست نفسي للتدريب لأيّام... أسابيع وشهور

128
00:08:29,820 --> 00:08:33,310
،قد لا يكون الوقت ملائما لأردّ الجميل

129
00:08:33,740 --> 00:08:38,990
.لكنني سعيدة لكوني سأتسلّق رفقتك خلال هذا المخيّم

130
00:08:43,750 --> 00:08:45,590
!أراك عن قريب

131
00:08:46,870 --> 00:08:49,500
.ما مشكلتها؟ تقوم بإزعاجك هكذا

132
00:08:49,500 --> 00:08:50,880
.اُنظروا من يتحدّث

133
00:08:52,640 --> 00:08:57,580
.لا أعلم السبب، لكن يبدو أنها حاقدة عليك لسبب ما

134
00:08:57,580 --> 00:08:59,790
.هذا دليل على ثقتها بنفسها

135
00:08:59,790 --> 00:09:01,530
.ساتو مارونو

136
00:09:01,530 --> 00:09:03,850
،كونها شاهدت كاساهارا-سان وهي تتسلّق

137
00:09:03,850 --> 00:09:08,310
.استنتجت أنّها لن تكون جيّدة في اختبار السرعة لذلك تقوم باستفزازها

138
00:09:08,650 --> 00:09:14,320
!كاساهارا-سان هي المبتدئة التي وصلت للنهائيّ، فهي محور الاهتمام

139
00:09:15,090 --> 00:09:18,320
.أتفهّم سبب رغبتها في العبث معها، أجل

140
00:09:20,200 --> 00:09:21,500
!يا إلهي

141
00:09:21,500 --> 00:09:25,480
!سمعت حديثكن ودخلت في وضع التحليل دون دراية

142
00:09:25,480 --> 00:09:28,350
!أستميحكن عذرًا، أجل

143
00:09:28,350 --> 00:09:29,200
،بهذا

144
00:09:29,200 --> 00:09:33,680
.سوف أتغلّب على كاساهارا-سان في بطولة الكأس الجماعيّة

145
00:09:33,680 --> 00:09:35,970
!أراكن على ساحة المعركة

146
00:09:37,680 --> 00:09:40,470
.إنّك مشهورة الآن

147
00:09:40,470 --> 00:09:44,470
.الجميع يسعى خلفك، أشعر بالغيرة

148
00:09:40,880 --> 00:09:43,100
...مخيّم تدريب بين عدّة مدارس

149
00:09:43,100 --> 00:09:48,800
.توقّعت أن يقوم الآخرون بالضغط على كونومي هنا لكن ليس لهذه الدرجة

150
00:09:44,470 --> 00:09:47,960
أنت أشبه بنجمة مشهورة. أريد أن يسعى الناس خلفي أنا أيضًا

151
00:09:47,960 --> 00:09:51,760
!ويمنحونني ألقابا مثل "ملاحظة الجريمة" أيضًا

152
00:09:51,760 --> 00:09:52,780
.أوتشيمورا

153
00:09:54,080 --> 00:09:55,980
ما مشكلتك؟

154
00:09:55,980 --> 00:09:57,100
.جون-تشان

155
00:09:57,920 --> 00:10:01,130
.يسعدني أنّني أتيت لهذا المخيّم

156
00:10:01,130 --> 00:10:05,040
.هنالك العديد من الأشخاص ممّن يرغبون في منافستي

157
00:10:05,040 --> 00:10:07,040
!سأبذل ما في وسعي

158
00:10:09,520 --> 00:10:10,700
.تلك هي الروح المطلوبة

159
00:10:11,670 --> 00:10:14,170
.يا لها من إرادة مذهلة

160
00:10:14,170 --> 00:10:16,600
...حتى وأنت ترتدين الملابس، يمكنني معرفة ذلك

161
00:10:17,170 --> 00:10:23,280
.مقارنة بالمرّة الماضية، عضلات ذراعيك والباسطة تبدو متطوّرة أكثر

162
00:10:23,280 --> 00:10:26,180
.نفس الأمر ينطبق عل ىعضلات ساقك، المحرّك الذي يشغّل سرعتك

163
00:10:26,540 --> 00:10:29,720
...كاساهارا كونومي، أنت حقّا

164
00:10:29,720 --> 00:10:31,400
!مذهلة للغاية

165
00:10:32,360 --> 00:10:34,360
!كونومي؟ كونومي

166
00:10:35,190 --> 00:10:38,460
،هذا هو منظّم هذا المخيّم التدريبيّ

167
00:10:38,460 --> 00:10:40,170
.صانع المسارات ناكاتا-سان

168
00:10:40,170 --> 00:10:41,200
!سررت بمعرفتك

169
00:10:41,200 --> 00:10:42,910
!أجل

170
00:10:42,910 --> 00:10:44,490
!سررت بلقائك

171
00:10:44,490 --> 00:10:45,560
.شكرا لك

172
00:10:45,560 --> 00:10:46,470
.نيا

173
00:10:47,860 --> 00:10:51,280
.مرحبا بكم جميعا في مخيّم ناكاتا

174
00:10:51,280 --> 00:10:54,210
،قد يدرك البعض منكن بالنظر إلى المتسابقات الأخريات

175
00:10:54,210 --> 00:10:58,260
.لكنّ الجميع هنا طالبات سنة أولى متفوقات

176
00:10:59,180 --> 00:11:02,970
لا توجد حاليًا منشآت كثيرة
،توفّر حائط سرعة

177
00:11:03,310 --> 00:11:07,220
.والبعض منكم لم يلمس واحدًا في حياته

178
00:11:07,520 --> 00:11:09,040
!لكن لا يمكن لهذا أن يستمر

179
00:11:09,040 --> 00:11:13,230
.لذلك نظّمت هذا المخيّم لطلبة السنة الأولى

180
00:11:13,730 --> 00:11:17,610
.تسلّق السرعة هو رياضة لها مكان في البطولات العالميّة أيضًا

181
00:11:17,610 --> 00:11:21,490
لن تقضوا وقتا طويلًا هنا، لكن تدربن
بكل ما أوتيتن من جهد

182
00:11:21,790 --> 00:11:25,240
!وتحولن إلى متسلّقات سيحملن اسم اليابان لسنوات عديدة

183
00:11:27,010 --> 00:11:30,400
.أوّلا، سنقوم بقياس وقتكن

184
00:11:30,400 --> 00:11:31,500
!حسنًا

185
00:11:45,620 --> 00:11:49,140
...لا زلت بعيدة عن 15 ثانية

186
00:11:49,780 --> 00:11:51,390
ماذا عن البقيّة؟

187
00:11:54,470 --> 00:11:58,380
انتهيت أنت أيضًا؟

188
00:12:07,880 --> 00:12:13,560
.لكن هنالك العديد ممّن يتسلّقون حائط سرعة لأوّل مرّة

189
00:12:18,250 --> 00:12:20,460
.يا لها من خيبة أمل

190
00:12:26,160 --> 00:12:29,720
ما المشكلة؟ لماذا أنت عابسة هكذا؟

191
00:12:29,720 --> 00:12:31,430
ناكاتا-سان؟

192
00:12:35,500 --> 00:12:38,600
لم أتيت إلى هذا المخيّم برأيك؟

193
00:12:39,760 --> 00:12:41,940
.ألقِ نظرة حولك

194
00:12:42,300 --> 00:12:46,040
.اُنظري لكلّ المتسلّقات اللواتي أحضرتهنّ إلى هذا المخيّم

195
00:12:48,710 --> 00:12:51,240
،في مخيّم التدريب هذا

196
00:12:51,240 --> 00:12:55,600
،يمكنك أن تري كيف يتمكّن متسلّقات من مدارس أخرى التسلّق

197
00:12:55,600 --> 00:12:57,960
.وابتكار أفكار من عندك

198
00:12:59,450 --> 00:13:03,080
،اسرقي التقنيات، وستُسرق منك

199
00:13:03,080 --> 00:13:05,760
!التنافس ضدّ بعضكن البعض والنضوج رفقة بعض

200
00:13:05,760 --> 00:13:09,210
!هذا يزيد بعضًا من الجمال لكنّ

201
00:13:09,210 --> 00:13:11,870
،ثمّ تحوّلوا من يرقات إلى فراشات

202
00:13:11,870 --> 00:13:16,940
!طرن من يدي ويومًا ما، حلّقن في السماوات حول العالم

203
00:13:16,940 --> 00:13:21,440
!هذا المخيّم التدريبيّ هو خليّة صنعت من أجل انبثاق فراشات

204
00:13:17,680 --> 00:13:20,710
!ناكاتا-سان! شكرا لك

205
00:13:22,280 --> 00:13:24,350
.ناكاتا-سان معه حقّ

206
00:13:24,350 --> 00:13:26,200
،لا يهمّ إن كنت متأخّرة مقارنة بالجميع

207
00:13:26,200 --> 00:13:31,200
سأستخدم هذا المخيّم والمشاركات فيه لأقتطف
.أفكارا تساعدني في أن أصبح أسرع

208
00:13:32,870 --> 00:13:35,180
.سأفعل أيّ شيء

209
00:13:36,370 --> 00:13:40,330
!وأخيرا، سأكتشف طريقة تساعدني على التسلّق بأسرع طاقتي

210
00:13:41,020 --> 00:13:42,340
!مهما كلّف الأمر

211
00:13:43,590 --> 00:13:46,970
.مارونو-سان تتسلّق الحائط بخفّة باستخدام جسدها الصغير

212
00:13:54,290 --> 00:13:55,230
.حسنًا

213
00:13:58,520 --> 00:14:04,280
.فهمت. يمكنها فعل هذا فقط لأنها حفظت المقابض ومواقعها

214
00:14:04,280 --> 00:14:06,620
...تتسلّق عن طريق استيعاب كلّ خطوة

215
00:14:06,620 --> 00:14:08,970
.هذه هي الأفضليّة لدى مارونو-سان

216
00:14:08,970 --> 00:14:09,740
...و

217
00:14:09,740 --> 00:14:14,730
.أوبا-سان تتسلّق بوضعيّة جميلة تمامًا كما هو متوقّع من راقصة باليه سابقة

218
00:14:14,730 --> 00:14:16,910
،جسدها ورأسها يبقيان ثابتين بطريقة مذهلة

219
00:14:16,910 --> 00:14:19,710
.ممّا يزيل أيّ خطر بوقوعها

220
00:14:23,920 --> 00:14:26,920
.الزاوية التي تنظر منها نحو الأعلى مثالية

221
00:14:26,920 --> 00:14:31,760
معظم المتسلّقين يقومون بحني رؤوسهم بعيدا
.ممّا يدير أجسادهم نحو الوراء أيضًا

222
00:14:32,170 --> 00:14:34,010
لكنّ جسدها ووضعيّتها

223
00:14:35,110 --> 00:14:37,230
.يبقيان ثابتين حتى بسرعات عالية

224
00:14:37,230 --> 00:14:39,450
.هذه هي الأفضليّة لدى أوبا-سان

225
00:14:41,010 --> 00:14:43,610
،من المثير للاهتمام أنّ الجميع يتسلّقن نفس الحائط

226
00:14:43,610 --> 00:14:46,010
.ومع ذلك فكلّ واحدة تتسلّقه على طريقتها الخاصة

227
00:14:54,000 --> 00:14:54,870
.حسنًا

228
00:14:54,870 --> 00:14:58,000
.سننهي أوّل يومٍ بآخر قياس

229
00:15:01,010 --> 00:15:03,280
،شاهدت كيف تقوم جميعهن بالتسلّق والتدرّب

230
00:15:03,280 --> 00:15:05,280
،استوعبت النقاط الأساسيّة

231
00:15:05,280 --> 00:15:08,140
.وعملت على جعلها خاصة بي

232
00:15:08,140 --> 00:15:11,380
!والآن عليّ تطبيقها فحسب

233
00:15:12,430 --> 00:15:14,890
...استعداد

234
00:15:18,390 --> 00:15:20,390
استوعبت الحركات المطلوبة أفضل

235
00:15:20,390 --> 00:15:23,550
.وعدلت مركز الجاذبية جاذبيتي ووضعيّتي

236
00:15:23,550 --> 00:15:25,500
حتى أنّني غيّرت طريقة استخدامي لكاحليّ

237
00:15:25,500 --> 00:15:27,910
.وكيف أضع قدميّ على مواطئ القدم

238
00:15:28,600 --> 00:15:29,480
!نجح الأمر

239
00:15:29,480 --> 00:15:31,670
!يجدر بي الوصول لحدود 15 ثانية هكذا

240
00:15:39,290 --> 00:15:43,290
إنه أبطأ من ذي قبل حتّى؟

241
00:15:44,340 --> 00:15:45,620
لماذا؟

242
00:15:54,860 --> 00:15:57,960
ما المشكلة يا كاساهارا-سان؟

243
00:15:57,960 --> 00:16:00,310
لمَ هذا الوجه العبوس؟

244
00:16:00,310 --> 00:16:02,620
.يا لفظاظتي

245
00:16:02,620 --> 00:16:05,520
بالطبع ستشعرين بالحزن

246
00:16:05,520 --> 00:16:08,440
.بعد التسلّق بطريقة مخزية قبل قليل

247
00:16:11,960 --> 00:16:15,720
،أفترض أنك حاولت تقليد أسلوب شخصٍ آخر

248
00:16:15,720 --> 00:16:19,560
.لكنك كنت تتحرّكين بطريقة غريبة فبدوت كدمية هناك

249
00:16:22,840 --> 00:16:27,050
هل يمكنك تقليص وقتك حقّا خلال اليومين المتبقّيين في هذا المخيّم؟

250
00:16:27,570 --> 00:16:32,680
،قد تكون مهاراتك التحليليّة منحتك نتائج جيّدة في القيادة والتسلّق

251
00:16:32,680 --> 00:16:35,220
.لكنّ السرعة هي نقطة ضعفك

252
00:16:35,520 --> 00:16:40,410
.هذا يجعل من المستحيل على فريق هاناميا الصغير اجتياز المرحلة التأهيليّة

253
00:16:41,430 --> 00:16:46,160
كلّ هذا لأنّ المبتدئة الواعدة خاصتهم، كاساهارا كونومي
!أشبه بسلحفاة من ناحية السرعة

254
00:16:46,160 --> 00:16:48,010
...صحيح

255
00:16:50,080 --> 00:16:50,980
.لحظة

256
00:16:50,980 --> 00:16:52,240
ماذا؟

257
00:17:03,350 --> 00:17:05,500
هل هدأت قليلا؟

258
00:17:05,820 --> 00:17:07,180
.شكرا لك

259
00:17:07,800 --> 00:17:10,750
.آسفة لأنني شرعت في البكاء فجأة

260
00:17:11,720 --> 00:17:13,010
.لا عليك

261
00:17:14,390 --> 00:17:19,720
.كانت واثقة للغاية في تلك المسابقة وبدت مستمتعة بوقتها

262
00:17:19,720 --> 00:17:21,160
أين اختفت تلك الفتاة؟

263
00:17:21,160 --> 00:17:24,680
.أنا سيّئة للغاية حقّا

264
00:17:25,980 --> 00:17:31,760
،حاولت التعلّم من طريقة تسلق الجميع
.لكنني لم أتمكّن من استخدامها كما ينبغي

265
00:17:35,560 --> 00:17:39,410
،إن ضيّعت وقتي الثمين في مخيّم تدريب كهذا

266
00:17:39,770 --> 00:17:43,660
.فقد لا أتمكّن من تجاوز المرحلة التأهيلية كما قلت

267
00:17:44,290 --> 00:17:47,170
...والفوز ليس

268
00:17:54,640 --> 00:17:55,670
...انظري

269
00:17:58,180 --> 00:18:00,480
!انظري لما دفعتني لفعله

270
00:18:00,480 --> 00:18:03,680
!لم يسبق لي صفع أيّ شخص في حياتي من قبل

271
00:18:04,200 --> 00:18:06,180
.آسفة

272
00:18:06,670 --> 00:18:11,690
.منذ أن خسرت أمامك، ركّزت كلّ طاقتي على هزيمتك

273
00:18:12,900 --> 00:18:15,440
...وانظري لنفسك

274
00:18:15,850 --> 00:18:19,320
!لمَ تتصرّفين كخاسرة هكذا؟ ماذا لو كنت بطيئة قليلا؟

275
00:18:19,610 --> 00:18:23,330
!هذه ليست هي نسختك التي أريد هزيمتها

276
00:18:26,600 --> 00:18:29,340
.يا إلهي... يدي تؤلمني

277
00:18:29,340 --> 00:18:31,960
كيف يفترض بي الإمساك بالمقابض هكذا؟

278
00:18:31,960 --> 00:18:34,460
...آسفة

279
00:18:36,890 --> 00:18:38,340
ما المضحك في الأمر؟

280
00:18:38,340 --> 00:18:41,180
أعني، لقد اعتذرت إلى شخصٍ صفعك؟

281
00:18:41,180 --> 00:18:45,850
...أجل، لكنّي شعرت بأنّني أخطأت

282
00:18:46,170 --> 00:18:48,890
.كما هو متوقّع منك

283
00:18:48,890 --> 00:18:50,190
حقّا؟

284
00:18:50,190 --> 00:18:53,000
.على أيّة حال، يسرّني أنها أنّبتك

285
00:18:53,000 --> 00:18:53,860
.أجل

286
00:18:54,170 --> 00:18:57,110
.أوتشيمورا عاتبتني أنا أيضا في الحقيقة

287
00:18:57,110 --> 00:19:00,860
حقّا؟ ماذا قالت؟

288
00:19:00,860 --> 00:19:03,370
...حسنًا

289
00:19:03,370 --> 00:19:06,370
لم أستطع الفهم كونها تتحدّث كقطّة

290
00:19:08,600 --> 00:19:11,620
.يبدو أنّنا متشابهتان أكثر ممّا نعتقد

291
00:19:11,920 --> 00:19:13,250
...جون-تشان

292
00:19:20,420 --> 00:19:24,200
.كنت أنت من تتسلّقين ذلك الحائط لكنه لم يكن أسلوبك في التسلّق

293
00:19:25,200 --> 00:19:30,200
.حاولت جاهدة دمج أفكار الآخرين فتحوّل الأمر إلى فوضى

294
00:19:30,200 --> 00:19:31,480
فوضى؟

295
00:19:31,480 --> 00:19:35,770
سواءٌ كنت قادرة على تطوير مهارات وإن كانت تلك المهارات ملائمة لك

296
00:19:35,770 --> 00:19:37,700
.هما شيئان مختلفان كليّا

297
00:19:38,570 --> 00:19:41,340
.لا تطاردي الظلال وتفقدين نفسك خلال ذلك

298
00:19:41,340 --> 00:19:44,910
.اختاري وتعلّمي ما يلائمك فحسب

299
00:19:44,910 --> 00:19:49,710
.صحيح. ربما هلعت وحاولت القيام بأشياء عديدة في آن واحد

300
00:19:49,710 --> 00:19:51,660
لكن ما الذي يمكنني فعله غير ذلك؟

301
00:19:52,420 --> 00:19:55,840
.عليك اكتشاف ذلك بنفسك

302
00:19:55,840 --> 00:19:57,920
.هكذا يتطوّر المرء

303
00:19:57,920 --> 00:20:01,800
.كلّ شخصٍ يقاتل، يعاني ويتسلّق الحائط بطريقته الخاصة

304
00:20:01,800 --> 00:20:04,720
.يسهل عليك قول ذلك

305
00:20:04,720 --> 00:20:07,130
.لستُ بمثل قوّتك

306
00:20:07,130 --> 00:20:09,560
.كلا، كنت في مكانك أنا أيضًا

307
00:20:11,440 --> 00:20:15,610
خلال بطولة كانتو، ارتبكت للغاية بمشاهدتي لطريقة تسلّقك

308
00:20:15,610 --> 00:20:17,420
.فتوقّفت يداي عن التحرّك كما ينبغي

309
00:20:18,320 --> 00:20:23,630
.أغمضت عينيّ  عن كلّ الأمور في الحياة لأصبح متسلّقة جيّدة

310
00:20:23,630 --> 00:20:27,330
.لكنّك تغلّبت عليّ وكأن لا شيء كان له معنى

311
00:20:27,640 --> 00:20:30,940
فقدت نفسي

312
00:20:30,940 --> 00:20:33,720
.وشعرت بالخوف من التسلّق

313
00:20:33,720 --> 00:20:34,960
...جون-تشان

314
00:20:34,960 --> 00:20:38,000
لذا ثقي بنفسك أكثر

315
00:20:38,000 --> 00:20:40,810
!اُنظري لما جعلتني أخوضه

316
00:20:40,810 --> 00:20:44,470
.افعلي ما بوسعك لاجتياز الحائط الذي يعترض طريقك الآن

317
00:20:45,090 --> 00:20:49,180
.تجاوزيه وستصبحين بمثل قوّتي

318
00:20:50,480 --> 00:20:51,260
.لا تبكي

319
00:20:51,260 --> 00:20:53,550
.آسفة يا جون-تشان

320
00:20:53,550 --> 00:20:54,980
.لا تعتذري أيضًا

321
00:20:55,750 --> 00:20:56,830
.حسنًا

322
00:20:56,830 --> 00:20:58,500
.شكرا لك يا جون-تشان

323
00:20:59,040 --> 00:21:02,470
.سأحاول بجهد أكبر

324
00:21:05,920 --> 00:21:08,650
،بعد كلّ الأمور التي قلتها البارحة

325
00:21:08,650 --> 00:21:10,860
.عليّ بذل كلّ ما في وسعي هنا

326
00:21:12,500 --> 00:21:13,500
.أحدهم هنا

327
00:21:13,860 --> 00:21:16,000
هناك أحد يتدرّب في هذا الصباح الباكر؟

328
00:21:18,210 --> 00:21:19,610
.هكذا أفضل

329
00:21:20,480 --> 00:21:22,410
.لهذا السبب أنت منافسة جديرة

330
00:21:32,160 --> 00:21:33,770
.هذا صعب

331
00:21:33,770 --> 00:21:37,610
كيف يفترض بي اختيار مهارات تلائمني؟

332
00:21:38,050 --> 00:21:41,270
.عليّ محاولة إيجاد طريقة اليوم

333
00:21:42,690 --> 00:21:43,960
ما هذا؟

334
00:21:45,030 --> 00:21:46,400
!يا لسرعتها

335
00:21:46,400 --> 00:21:47,930
!بشكل غامر

336
00:21:55,970 --> 00:21:58,360
من تكون تلك الفتاة؟

337
00:22:01,140 --> 00:22:03,700
ما هذا الشعور الغريب الذي ينتابني؟