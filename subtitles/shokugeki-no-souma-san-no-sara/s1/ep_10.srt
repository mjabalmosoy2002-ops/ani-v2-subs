1
00:00:03,430 --> 00:00:06,520
.كوسنوكي رينتارو ضدّ كوروكيبا ريو

2
00:00:06,520 --> 00:00:09,070
!ليبدأ الشّوكوغيكي

3
00:00:11,860 --> 00:00:14,110
!مذهل! لقد قطّع السّلمون بسرعة

4
00:00:14,550 --> 00:00:18,080
.كان يتحرّك بسرعة، لكنّ السّمك قد قُطّع بدقّة

5
00:00:18,450 --> 00:00:22,960
إنّ كوروكيبا-كُن مدهش أكثر مما كان عليه
!في مواجهتنا في انتخابات الخريف

6
00:00:27,420 --> 00:00:29,300
!كوسنوكي-سينباي يجاريه أيضًا

7
00:00:29,300 --> 00:00:31,890
.مهاراته في استعمال السّكّين متساوية لكوروكيبا

8
00:00:31,890 --> 00:00:32,760
...المركز

9
00:00:33,290 --> 00:00:36,970
يبدو أنّ كلّ أعضائه يمتلكون
.مهارات عالية المستوى

10
00:00:37,290 --> 00:00:39,930
،أخبرني يا كوروكيبا-كُن
كيف تجد مهارات زميلك الأكبر؟

11
00:00:39,930 --> 00:00:43,400
آمل أنّك لست نادمًا على قبولك
.بهذا الشّوكوغيكي

12
00:00:43,400 --> 00:00:45,240
.سيكون ذلك مزعجًا للغاية

13
00:00:46,330 --> 00:00:47,060
ما هذا؟

14
00:00:48,430 --> 00:00:50,020
!إنّه أرزّ

15
00:00:50,380 --> 00:00:52,250
!بل وهنالك نوعان من الأرزّ

16
00:00:52,250 --> 00:00:55,450
دون أن نذكر... هل تلك عجينة
خبز في ذلك القِدر؟

17
00:00:55,450 --> 00:00:58,410
ما الّذي ينوي الفتى كوروكيبا إعداده؟

18
00:00:58,410 --> 00:01:03,040
!هذا أفضل طبق سلمون يمكنني إعداده الآن

19
00:01:03,440 --> 00:01:05,370
.لا يمكنك أن تخسر يا ريو-كُن

20
00:01:05,370 --> 00:01:07,520
ما الأمر يا عضو المركز؟

21
00:01:07,520 --> 00:01:11,730
.كلّ ما فعلتَه هو تقليدي والتّصرّف بتعالٍ وتجبّر

22
00:01:12,990 --> 00:01:16,690
.أرني أفضل ما لديك أيّها النّخبة المدّعي

23
00:01:16,690 --> 00:01:20,340
أم أنّك تحتاج لعذر واهٍ عندما تخسر؟

24
00:01:20,340 --> 00:01:23,590
،كان يوكيهيرا وألديني مزعجان حقًّا

25
00:01:23,590 --> 00:01:26,190
.لكنّك أيضًا لا تختلف عنهما كثيرًا

26
00:01:26,630 --> 00:01:32,860
لكن لا تقلق. لقد كنت أرغب بشدّة

27
00:01:33,370 --> 00:01:36,150
.في إظهار شركائي لك

28
00:01:37,360 --> 00:01:38,360
...تلك

29
00:01:39,930 --> 00:01:42,380
.شاهد فحسب أيّها الرّعاعة

30
00:03:15,460 --> 00:03:19,220
انتهت كلّ التّحدّيّات المقرّرة لهذا
."اليوم في القاعة "ب

31
00:03:20,000 --> 00:03:21,680
!حقّق المركز فوزًا ساحقًا

32
00:03:21,680 --> 00:03:23,490
هل صوّرت ذلك جيّدًا؟

33
00:03:23,490 --> 00:03:25,950
.نعم. كانت هذه تحدّيّات مذهلة

34
00:03:25,950 --> 00:03:28,860
...صاحبة الرّتبة السّادسة كينوكوني نيني

35
00:03:28,860 --> 00:03:31,270
.إنّها أعلى برتبة واحدة عن إيشّيكي-سينباي

36
00:03:31,630 --> 00:03:34,150
هذا يجعلها الطّاهية الأفضل
.بين تلاميذ السّنة الثّانية الحاليّين

37
00:03:37,450 --> 00:03:38,700
!هذا لا يعقل

38
00:03:38,700 --> 00:03:42,880
الكثير من النّوادي ومجموعات الأبحاث
!قد تحدّوهم في شوكوغيكي

39
00:03:42,880 --> 00:03:44,410
.ومع ذلك لم يفز أيّ أحد

40
00:03:44,730 --> 00:03:45,690
.سُحقًا

41
00:03:45,690 --> 00:03:48,710
هذا يعني أنّ ناكيري أزامي
!سيحصل على مبتغاه بالفعل

42
00:03:51,930 --> 00:03:53,580
.رأيت تلك من قبل

43
00:03:53,970 --> 00:03:57,340
عندما واجهت ناكيري أليس في المنافسة
.الأساسيّة لانتخابات الخريف

44
00:03:57,340 --> 00:04:01,470
.إنّه فرن حمل حراريّ بخاريّ وطاحونة تبريد عميق

45
00:04:02,900 --> 00:04:04,750
،كوسنوكي رينتارو-سان

46
00:04:04,750 --> 00:04:08,570
هل أنت قادر بالفعل على التّعامل
مع تكنولوجيا متطوّرة كهذه؟

47
00:04:09,680 --> 00:04:14,940
،بالنّظر للجماهير الغفيرة المتجمّعة هنا

48
00:04:15,460 --> 00:04:17,650
.فسأستعملكم جميعًا للتّرويج لنفسي

49
00:04:18,000 --> 00:04:19,500
فرن حمل؟

50
00:04:19,500 --> 00:04:21,400
.فرن حمل حراري بخاريّ

51
00:04:21,730 --> 00:04:26,120
إنّه فرن تقوم مروحة بداخله
.بتوزيع الحرارة والبخار

52
00:04:26,120 --> 00:04:29,730
إنّه آلة طبخ ثوريّة يتمّ التّحكم بواسطتها
.بالحرارة والرّطوبة بشكل رقميّ

53
00:04:29,730 --> 00:04:33,620
إنّه كلّ ما نحتاجه للقيام بكلّ طرق
.التّحضير تقريبًا المتعلّقة بالحرارة

54
00:04:34,010 --> 00:04:38,570
لا يوجد أيضًا أيّ احتمال لامتزاج الرّوائح، لذلك
.يمكن إعداد أطباق مختلفة في آن واحد

55
00:04:38,570 --> 00:04:39,450
!فعلاً؟

56
00:04:39,450 --> 00:04:40,090
!هذا مفيد جدًّا

57
00:04:40,450 --> 00:04:43,970
،يمكن القول أنّه كحلم تحقّق بالنّسبة للطّهاة

58
00:04:43,970 --> 00:04:46,230
،لكن بسبب الإمكانيّات الواسعة

59
00:04:46,230 --> 00:04:48,470
فقد يفوق الأمر طاقتك ما لم
.تمتلك المعرفة الضّروريّة

60
00:04:48,820 --> 00:04:51,430
،سواء أعجبك ذلك أم لا
فإنّ هذه الآلة تمتحن معرفتك

61
00:04:51,430 --> 00:04:53,730
.للمكوّنات وطرق التّحضير

62
00:04:54,040 --> 00:04:56,500
.عليّ الاعتراف، لم أتوقّع هذا

63
00:04:56,500 --> 00:05:00,320
هل يستطيع فعلاً استعمال
آلة معقّدة كهذه؟

64
00:05:00,320 --> 00:05:03,790
.إنّه يتصرّف كشقيّ غير مسؤول

65
00:05:03,790 --> 00:05:04,930
!سوما-كُن

66
00:05:04,930 --> 00:05:05,610
.هذا صحيح

67
00:05:05,610 --> 00:05:07,210
.لا يبدو كشخص يفكّر كثيرًا

68
00:05:07,210 --> 00:05:10,330
ما كنت لأتوقّع أن تكون تكنولوجيا
.الطّبخ المتطوّرة إحدى نقاط قوّته

69
00:05:10,330 --> 00:05:11,330
!أنت أيضًا يا تاكومي-كُن

70
00:05:12,850 --> 00:05:15,290
أنتم لا تتهاونون أبدًا، صحيح؟

71
00:05:15,710 --> 00:05:19,330
،لكن إن كنتم قلقين للغاية
.واصلوا المشاهدة فحسب

72
00:05:19,330 --> 00:05:23,300
.سوف ترون ما المدهش في طبخ رين-تشان

73
00:05:25,060 --> 00:05:27,010
.إنّه ينقع شرائح السّمك

74
00:05:28,130 --> 00:05:29,180
.إنّه يقطّعها بشكل طوليّ

75
00:05:29,700 --> 00:05:31,500
.لقد لفّها باللّحم المجفّف

76
00:05:31,500 --> 00:05:33,890
هل ينوي مزجهما بالملح والدّهن؟

77
00:05:35,020 --> 00:05:36,230
.سوف يستعمل الفرن

78
00:05:37,690 --> 00:05:40,300
،تحديد الحرارة المركزيّة لتصل 45 درجة

79
00:05:40,300 --> 00:05:43,400
.وتسخينه حتّى 60 درجة لمدّة 18 دقيقة

80
00:05:43,830 --> 00:05:46,220
،رين-تشان خبير في استعمال الحرارة

81
00:05:46,220 --> 00:05:48,700
.والطّبخ بدرجة منخفضة بالتّحديد

82
00:05:49,780 --> 00:05:51,660
.أحسن التّصرّف

83
00:05:51,660 --> 00:05:53,600
الطّبخ بدرجة منخفضة؟

84
00:05:53,600 --> 00:05:58,920
يبدأ البروتين في اللّحم والسّمك
.بالتّمسّخ في حرارة 58 درجة

85
00:05:59,560 --> 00:06:04,330
،بمجرّد أن يصلا إلى 68 درجة
.يصبح اللّحم أكثف وأصلب

86
00:06:04,330 --> 00:06:08,580
،إن حافظنا على الحرارة ما بين 58 و68 درجة

87
00:06:08,580 --> 00:06:10,430
،لن تعاني المكوّنات من ضغط الحرارة

88
00:06:10,430 --> 00:06:12,950
.وستظلّ ليّنة

89
00:06:12,950 --> 00:06:16,310
هذه هي الفكرة الأساسيّة خلف
.الطّبخ بدرجة حرارة منخفضة

90
00:06:17,350 --> 00:06:18,690
!أحسنت

91
00:06:18,690 --> 00:06:20,940
!أفران الحمل الحراريّ البخاريّ

92
00:06:20,940 --> 00:06:22,220
!الطّبخ بحمّامات المياه

93
00:06:22,220 --> 00:06:23,660
!أجهزة الغلي الدّائريّ

94
00:06:23,660 --> 00:06:25,050
!أجهزة غاستروفاك

95
00:06:25,050 --> 00:06:28,700
إنّه طاهٍ يتحكّم بكلّ أنواع
!وسائل التّسخين المتطوّرة

96
00:06:28,700 --> 00:06:32,030
!هذا هو رين-تشان... كوسنوكي رينتارو

97
00:06:32,030 --> 00:06:33,490
!الحرارة هي كلّ شيء

98
00:06:33,490 --> 00:06:37,870
!يمكن التّنافس في أيّ مجال إن أتقنت ذلك

99
00:06:37,870 --> 00:06:39,410
!الحرارة واللّهب

100
00:06:39,410 --> 00:06:42,330
!ستسمح لي مهاراتي بتولّي القمّة

101
00:06:45,570 --> 00:06:47,970
.بدأ يركّز أخيرًا

102
00:06:48,300 --> 00:06:50,220
،بمجرّد أن يبدأ بتسخين المكوّنات

103
00:06:50,220 --> 00:06:52,530
.يهدأ بسرعة

104
00:06:52,530 --> 00:06:57,680
وكأنّ شخصيّته المتحمّسة
.المعتادة تنتقل إلى طبخه

105
00:07:01,560 --> 00:07:02,270
!ماذا؟

106
00:07:02,270 --> 00:07:04,360
!انظروا لذلك اللّمعان

107
00:07:04,970 --> 00:07:08,460
!لقد تحوّلت المكوّنات بالكامل

108
00:07:09,090 --> 00:07:10,950
.إنّها جميلة بالفعل

109
00:07:11,450 --> 00:07:14,450
.أستطيع الجزم أنّها ليّنة بمجرّد النّظر إليها

110
00:07:14,840 --> 00:07:20,210
على الأرجح أنّها ستنهار عند لمسها
.بالسّكّين، يا له من ملمس رائع

111
00:07:20,730 --> 00:07:22,170
.هذا مذهل

112
00:07:22,560 --> 00:07:25,840
.وكأنّ روحه قد انتقلت إلى طبقه حقًّا

113
00:07:25,840 --> 00:07:27,290
.لقد تفاجأت

114
00:07:27,290 --> 00:07:29,210
.إنّه طاهٍ ممتاز

115
00:07:30,910 --> 00:07:31,880
.السّلمندر

116
00:07:32,250 --> 00:07:34,860
السّلمندر؟ ماذا؟

117
00:07:34,860 --> 00:07:37,540
!لكنّ اسمه يبدو رائعًا

118
00:07:37,540 --> 00:07:40,290
السّلمندر هو وحش أسطوريّ
،من أوروبا القرون الوسطى

119
00:07:40,290 --> 00:07:43,480
.سحليّة تعيش بين ألسنة اللّهب

120
00:07:43,480 --> 00:07:45,630
.هذا هو أصل التّسمية

121
00:07:45,630 --> 00:07:49,490
إنّها فئة من أجهزة المطبخ تطلق
.حرارتها من الأعلى بدل الأسفل

122
00:07:49,810 --> 00:07:51,990
.فهمت. السّلمندر

123
00:07:51,990 --> 00:07:56,200
تُستعمل لكرملة سطح طبق ما لإضافة
.لون أو طعم ما أو كلاهما معًا

124
00:07:56,200 --> 00:07:59,870
.بعبارات أخرى، يكاد طبقه أن يصبح جاهزًا

125
00:08:03,190 --> 00:08:04,750
.لقد انتهيت

126
00:08:04,750 --> 00:08:08,070
."لقد سمّيته سلمون "كونفي فلام

127
00:08:08,070 --> 00:08:10,900
.فلام" تعني "لهب" بالفرنسيّة، أي مكسوّ باللّهب"

128
00:08:10,900 --> 00:08:13,720
.هيّا. استمتعوا بهذه التّحفة من اللّهب

129
00:08:14,100 --> 00:08:16,140
،طبق من إعداد كوسنوكي رينتارو

130
00:08:16,580 --> 00:08:19,060
.أحد التّلاميذ المختارين من طرف المركز

131
00:08:19,060 --> 00:08:21,030
.صحيح، صحيح

132
00:08:21,030 --> 00:08:24,030
!تذوّقي طبقي أيضًا رجاءً يا مومو-سينباي

133
00:08:24,030 --> 00:08:25,620
لماذا أنا أيضًا؟

134
00:08:25,620 --> 00:08:29,650
يملك هذا الطّبق خدعة صغيرة
.تضفي طعمًا حلوًا معيّنًا

135
00:08:29,650 --> 00:08:30,860
حلوًا؟

136
00:08:31,260 --> 00:08:32,990
.أعتقد أنّه سيعجبك

137
00:08:33,330 --> 00:08:35,950
هل يفترض أن يكون ذلك تحدّيًا لي؟

138
00:08:35,950 --> 00:08:37,870
!أنا نيّقة فيما يخصّ الحلويّات

139
00:08:37,870 --> 00:08:40,970
!طبق كوسنوكي رينتارو هو الأوّل
.تذوّقوه رجاءً أيّها الحكّام

140
00:08:40,970 --> 00:08:41,580
!لنبدأ

141
00:08:45,020 --> 00:08:46,960
.انظروا لهذا البريق

142
00:08:46,960 --> 00:08:49,920
!اشتمّوا رائحة الدّهن المشويّ

143
00:08:50,920 --> 00:08:53,460
،قد توحي رائحته ومظهره أنّه الطّبق الفائز

144
00:08:53,460 --> 00:08:54,880
!لكن ماذا عن مذاقه؟

145
00:09:00,590 --> 00:09:01,810
!لذيذ

146
00:09:01,810 --> 00:09:03,520
!إنّه لذيذ لدرجة فقدان الوعي

147
00:09:03,520 --> 00:09:07,700
.لحم السّمك ليّن للغاية لدرجة أنّه قد يكون نيّئًا

148
00:09:07,700 --> 00:09:11,780
!ولكنّ الجهة الخارجيّة عبقة بفضل السّلمندر

149
00:09:11,780 --> 00:09:14,650
!يا له من فنّ لهب مميّز

150
00:09:14,650 --> 00:09:17,610
.حـ-حسنًا، ليس سيّئًا

151
00:09:17,610 --> 00:09:19,830
.سأجرّب الطّبق المرافق

152
00:09:22,410 --> 00:09:23,800
.فهمت

153
00:09:23,800 --> 00:09:27,580
هذه بوظة معدّة من السّلمون
.دون أيّ سكّر إضافيّ

154
00:09:27,580 --> 00:09:28,400
ماذا؟

155
00:09:28,400 --> 00:09:29,410
ماذا تعني؟

156
00:09:29,410 --> 00:09:31,170
بوظة سلمون؟

157
00:09:31,170 --> 00:09:32,460
لكن كيف؟

158
00:09:32,460 --> 00:09:34,970
استعملت طاحونة التّبريد العميق، صحيح؟

159
00:09:34,970 --> 00:09:36,630
.أصبت يا أليس-تشان

160
00:09:37,210 --> 00:09:41,890
لقد جمّدت السّلمون الّذي حوّلته لمعجون
.ووضعت ذلك في طاحونة التّبريد العميق

161
00:09:41,890 --> 00:09:47,020
.حوّلته الشّفرات الدّوّارة إلى بوظة حريريّة

162
00:09:47,500 --> 00:09:49,730
،إن أكلتم السّلمون بعد تذوّق البوظة

163
00:09:49,730 --> 00:09:53,400
!يصبح تأثير دفء السّلمون السّاخن أكثر من قبل

164
00:09:53,730 --> 00:09:55,650
السّلمون المعدّ في حرارتين مختلفتين

165
00:09:55,650 --> 00:09:58,610
.يعزّزان تواجد بعضهما على مستقبلات التّذوّق

166
00:09:58,610 --> 00:09:59,950
...الإحساس الحراريّ

167
00:10:00,340 --> 00:10:03,540
اتّبعت ناكيري أليس نفس التّقنيّة
.خلال انتخابات الخريف

168
00:10:03,540 --> 00:10:06,510
!درجة الحرارة والسّخونة والوقت

169
00:10:06,510 --> 00:10:08,960
.إنّها كلّ التّوابل الّتي أستعملها

170
00:10:09,270 --> 00:10:14,050
صحيح. تعزّز درجات الحرارة المختلفة
.نكهات المكوّنات بالكامل

171
00:10:14,550 --> 00:10:20,050
قوّة حياة السّلمون المتّقدة تندفع
،خلال الجدول النّقيّ البارد

172
00:10:20,050 --> 00:10:23,010
!مضرمة النّار في جسدي

173
00:10:23,010 --> 00:10:24,310
!كلاّ

174
00:10:24,310 --> 00:10:30,180
لا أستطيع تفادي هجوم السّلمون
!على حواسّي بعد الآن

175
00:10:33,230 --> 00:10:34,810
.اتُّخذ القرار إذًا

176
00:10:34,810 --> 00:10:36,710
،هذا التّحدّي هو فوز آخر للمركز

177
00:10:36,710 --> 00:10:38,700
.فوز ساحق لكوسنوكي رينتارو

178
00:10:38,700 --> 00:10:43,200
!يمكنك تقرير ذلك بعد أن تنظروا لطبقي

179
00:10:45,450 --> 00:10:49,620
!طبق السّلمون خاصّتي عبارة عن كوليبياك

180
00:10:50,940 --> 00:10:52,330
...كوليبياك

181
00:10:56,750 --> 00:10:57,920
...المكان هادئ

182
00:11:09,690 --> 00:11:12,660
ربّما الشّخص الّذي سينقذ
توتسكي من أزامي-دونو

183
00:11:12,660 --> 00:11:15,860
.هو ذلك الرّجل

184
00:11:18,750 --> 00:11:19,610
.مرحبًا

185
00:11:20,010 --> 00:11:22,240
هل من أحد هنا؟

186
00:11:23,050 --> 00:11:25,450
لا يوجد غيرك يا ناكيري-كُن؟

187
00:11:26,130 --> 00:11:28,270
هل تعرفين أين ذهب البقيّة؟

188
00:11:32,670 --> 00:11:35,110
.ظننتُ أنّ قلبي سيتوقّف

189
00:11:35,110 --> 00:11:35,880
ماذا؟

190
00:11:35,880 --> 00:11:37,670
يا ناكيري-كُن؟

191
00:11:38,120 --> 00:11:40,880
.إذًا فقد ذهب الجميع لمشاهدة التّحدّيّات

192
00:11:41,290 --> 00:11:45,700
لا بدّ أنّ الشّوكوغيكي الّذي يتعلّق بأليس-كُن
.يحدث في هذه الأثناء أيضًا

193
00:11:45,700 --> 00:11:46,350
!ماذا؟

194
00:11:46,350 --> 00:11:47,820
أليس؟

195
00:11:47,820 --> 00:11:48,470
لماذا؟

196
00:11:49,060 --> 00:11:50,930
هل يساورك الفضول بشأن ما قد يحدث؟

197
00:11:53,860 --> 00:11:55,360
!كوليبياك

198
00:11:55,360 --> 00:11:56,820
.أجل

199
00:11:56,820 --> 00:11:57,860
.فهمت

200
00:11:57,860 --> 00:11:59,990
.لهذا السّبب كانت هنالك عجينة

201
00:11:59,990 --> 00:12:01,690
أيّ نوع من الأطباق هذا؟

202
00:12:01,690 --> 00:12:05,870
إنّه يتكوّن من قشرة خبز بريوش
.محشوّة بالسّلمون والأرزّ

203
00:12:06,300 --> 00:12:09,890
إنّه طبق فرنسيّ نشأ في البلاط الملكيّ
.الرّوسيّ في القرن التّاسع عشر

204
00:12:11,780 --> 00:12:16,790
تضاف له الحبوب مع الفطر والكرّاث
.وخضروات أخرى في الحشوة

205
00:12:17,120 --> 00:12:19,250
ما ظنّه الحكّام نوعان مختلفان من الأرزّ

206
00:12:19,250 --> 00:12:20,550
كانا في الحقيقة أرزّ الزّبدة

207
00:12:20,550 --> 00:12:25,180
وحنطة سوداء مقليّة تقدّم في طبق
.في أوروبّا الشّرقيّة تدعى كاشا

208
00:12:26,310 --> 00:12:29,660
يا له من عبق مذهل يصدر من قشرة
.الخبز الذّهبيّة والسّلمون الزّكيّ

209
00:12:29,660 --> 00:12:34,350
انظروا إلى الجزء الدّاخليّ المليء
!بالعصارة مع أرزّ الزّبدة والكاشا

210
00:12:34,350 --> 00:12:37,610
.كفاكم كلامًا وابدؤوا بالأكل قبل أن يبرد

211
00:12:38,080 --> 00:12:44,110
سوف تتذوّقون لذّة لا تقاوم لنكهات
!السّلمون المتفجّرة

212
00:12:54,350 --> 00:12:55,870
!أنا عاجز عن الكلام

213
00:12:55,870 --> 00:12:59,050
.خبز البريوش يغلّف نكهات الحشوة بثبات

214
00:12:59,050 --> 00:13:03,010
!السّمك الأساسيّ والأرزّ والحنطة والخضار والخبز

215
00:13:03,010 --> 00:13:05,840
!كلّ شيء مجتمع في هذا الطّبق

216
00:13:05,840 --> 00:13:08,900
النّكهات الأساسيّة والأومامي من
!السّلمون ترقص في هذا الطّبق

217
00:13:08,900 --> 00:13:11,350
...وحجمه الخالص

218
00:13:12,710 --> 00:13:14,890
!كافٍ لإرسال صعقة خلال أدمغتنا

219
00:13:16,770 --> 00:13:18,150
هل تودّين تذوّق القليل منه؟

220
00:13:18,530 --> 00:13:20,250
.حصلتُ على بعضه من دون إذن

221
00:13:20,250 --> 00:13:21,860
...ماذا؟ لـ-لكن

222
00:13:22,280 --> 00:13:24,620
.شكرًا لك

223
00:13:26,710 --> 00:13:29,780
طاقة السّلمون المركّزة داخل الخبز

224
00:13:29,780 --> 00:13:31,990
.تتحرّر عن طريق صدمة واحدة قويّة

225
00:13:31,990 --> 00:13:33,950
!لا أستطيع

226
00:13:33,950 --> 00:13:36,410
...بتواجد قوّة كهذه، فلا يمكنني تفادي

227
00:13:39,700 --> 00:13:43,140
!التّعرّض لإصابة مباشرة

228
00:13:45,300 --> 00:13:47,100
...لذيذ للغاية

229
00:13:47,670 --> 00:13:49,300
!أحسنت يا كوروكيبا

230
00:13:49,300 --> 00:13:52,810
،هذا الطّبق الّذي نشأ في مطبخ ملكيّ فخم

231
00:13:52,810 --> 00:13:58,230
متناغم بشكل متقن مع مواهب كوروكيبا
!الغاشمة الّتي ترعب الرّجال

232
00:13:58,230 --> 00:14:04,070
لا بدّ أنّ هذا الطّبق قد نشأ من سنوات
.التّنافس العديدة بين هذين الاثنين

233
00:14:04,070 --> 00:14:06,380
من منهما الفائز إذًا؟

234
00:14:06,380 --> 00:14:08,190
.لا بدّ أنّ كوسنوكي هو الفائز

235
00:14:08,190 --> 00:14:09,530
لا يمكن أن يكون كوروكيبا، صحيح؟

236
00:14:10,410 --> 00:14:12,950
!قدّموا أصواتكم رجاءً

237
00:14:17,680 --> 00:14:19,670
!إ-إنّهما متعادلان

238
00:14:19,670 --> 00:14:22,170
!لا يمكنني التّصويت لأحدهما على أنّه الأفضل

239
00:14:22,170 --> 00:14:25,510
يمكنني أن أقول فقط أنّ كلاهما
!قد قدّم طبق السّلمون الأفضل

240
00:14:26,720 --> 00:14:28,610
.لا تتسرّع

241
00:14:28,610 --> 00:14:31,550
،إن قارنتَهما مرّة أخيرة

242
00:14:31,550 --> 00:14:34,310
!يمكنك أن تكتشف وجود اختلاف حاسم بينهما

243
00:14:34,310 --> 00:14:36,050
اختلاف حاسم؟

244
00:14:36,050 --> 00:14:39,390
.بدا لي أنّ كلاهما قدّم طبقًا رائعًا

245
00:14:39,390 --> 00:14:41,900
العامل الأكثر أهمّيّة في تقييم هذا

246
00:14:41,900 --> 00:14:44,650
هو لأيّ درجة حاول كلّ طاهٍ منع
.فقدان أومامي السّلمون

247
00:14:44,650 --> 00:14:48,530
هل ما زال أحد الطّبقين يخفي سرًّا ما؟

248
00:14:49,770 --> 00:14:53,700
أراهن أنّ ذلك السّرّ موجود في الفرن
.الّذي استعمله رين-تشان

249
00:14:53,700 --> 00:14:56,450
.لقد أدرك الحكم ذلك أيضًا

250
00:14:57,660 --> 00:14:59,370
.أنت شديدة الملاحظة يا ميا

251
00:14:59,370 --> 00:15:01,580
.هذا هو الجواب

252
00:15:01,580 --> 00:15:03,460
.يبدو لي كزيت الزّيتون

253
00:15:05,050 --> 00:15:08,480
الاختلاف الحاسم بين الطّبقين

254
00:15:08,480 --> 00:15:10,930
.يمكن العثور عليه في المكوّن الرّطب للسّلمون

255
00:15:10,930 --> 00:15:11,890
.صحيح

256
00:15:11,890 --> 00:15:14,640
عندما أحكمت إغلاق السّلمون في الكيس
،البلاستيكيّ وطبخته بحرارة منخفضة

257
00:15:14,640 --> 00:15:18,060
.غمرته في زيت الزّيتون

258
00:15:18,060 --> 00:15:22,530
،إن أعددنا السّمك بالطّرق العاديّة فقط
،فلا يهمّ كم سنحكم إغلاق السّمك

259
00:15:22,530 --> 00:15:25,490
فإنّ وزن السّمك بحدّ ذاته سيطبّق
ضغطًا على لحم السّمك

260
00:15:25,490 --> 00:15:28,530
.ويتسبّب بخروج العصارة

261
00:15:28,530 --> 00:15:31,010
.وهنا يأتي دور زيت الزّيتون

262
00:15:31,010 --> 00:15:35,800
بفضل خصائص الزّيت الطّفويّة، يمكننا
تسخين السّلمون دون وضع أيّ ضغط عليه

263
00:15:35,800 --> 00:15:37,990
.ودون فقدان قطرة رطوبة واحدة

264
00:15:37,990 --> 00:15:38,900
!صحيح

265
00:15:38,900 --> 00:15:40,040
!ذلك صحيح تمامًا

266
00:15:40,040 --> 00:15:43,470
،عند أخذ قضمة من الطّبق
،تنهار في الفم

267
00:15:43,470 --> 00:15:46,460
!لكنّها لا تكون جافّة بشكل مفاجئ

268
00:15:46,460 --> 00:15:48,940
!إنّها رطبة ومليئة بالعصارة بالكامل

269
00:15:48,940 --> 00:15:51,420
!لم يفقد السّلمون أيًّا من عصارته

270
00:15:51,740 --> 00:15:55,180
تعامله مع المكوّنات ربما يكون
.قد تجاوز كوروكيبا ريو

271
00:15:55,180 --> 00:15:55,980
!ماذا؟

272
00:15:55,980 --> 00:15:57,260
.مذهل

273
00:15:57,260 --> 00:16:00,270
!لكنّ كوروكيبا-كُن خبير في طبخ الطّعام البحريّ

274
00:16:00,610 --> 00:16:03,020
هل فهمت الآن لماذا أنا أفضل منك؟

275
00:16:03,400 --> 00:16:06,980
ما كان ذلك الطّبق الّذي قدّمته
في نهائيّ انتخابات الخريف؟

276
00:16:06,980 --> 00:16:09,940
.صحيح، كان طبق كارتوتشيو

277
00:16:10,370 --> 00:16:12,410
كلّ من ذلك الطّبق وطبق كوليبياك هذا

278
00:16:12,410 --> 00:16:18,490
كان الغرض منهما هو تركيز أومامي المكوّنات
.المختلفة عن طريق لفّها قبل طهيها

279
00:16:18,490 --> 00:16:21,910
.لكن إن أردت رأيي، فذلك ليس كافيًا

280
00:16:21,910 --> 00:16:25,010
إنّ دقّة ورُقيّ تسخين المكوّنات

281
00:16:25,010 --> 00:16:27,180
...مع الحفاظ على طراوتها المطلقة

282
00:16:27,180 --> 00:16:31,510
!هكذا يطبخ النّخبة
.لا يمكنك حتّى الاقتراب من ذلك

283
00:16:31,510 --> 00:16:34,470
هذا الشّوكوغيكي هو مثال آخر لمدى
!الاختلاف الّذي بينك وبيني

284
00:16:34,470 --> 00:16:37,370
أليس ذلك صحيحًا أيّها الحكّام؟

285
00:16:37,930 --> 00:16:41,810
.أنت لم تتغيّر أبدًا منذ انتخابات الخريف

286
00:16:42,230 --> 00:16:47,610
الطّاهي الّذي يغزو حاسّة التّذوّق
.للآخرين بالأمومامي العنيف

287
00:16:47,610 --> 00:16:50,440
.هنالك طرق أكثر رقيًّا لاتّباعها

288
00:16:50,440 --> 00:16:54,990
حسنًا، يمكنك الآن أن تبذل جهدك بالعمل
.تحت إمرتنا من الآن فصاعدًا

289
00:16:54,990 --> 00:16:58,740
لكن هل تمّ اتّخاذ القرار في هذا التّحدّي بالفعل؟

290
00:16:59,300 --> 00:17:02,480
،رغم أنّي لم أجرّب أيّ واحد من الطّبقين

291
00:17:02,480 --> 00:17:06,210
.فأنا أعرف أنّ رينتارو-سينباي مخطئ في أمر واحد

292
00:17:15,620 --> 00:17:23,060
أومامي ونكهة السّلمون اللّذيذين
!أكثر حيويّة في هذا الطّبق

293
00:17:24,860 --> 00:17:27,020
!في طبق كوروكيبا ريو

294
00:17:27,340 --> 00:17:28,350
!ماذا؟

295
00:17:28,760 --> 00:17:31,560
.لا شكّ بكلّ تأكيد

296
00:17:31,560 --> 00:17:35,070
!كوروكيبا هو الأفضل في تعزيز إمكانيّات السّلمون

297
00:17:35,070 --> 00:17:36,030
!أجل

298
00:17:37,530 --> 00:17:38,930
!ماذا؟

299
00:17:38,930 --> 00:17:41,170
!ما الّذي تقولونه أيّها العجائز؟

300
00:17:41,170 --> 00:17:43,050
.كانت طرق التّسخين خاصّتي خالية من الأخطاء

301
00:17:43,050 --> 00:17:45,710
—من المستحيل لطبقي أن يكون أقلّ من

302
00:17:45,710 --> 00:17:47,670
.أغلق فمك

303
00:17:48,310 --> 00:17:49,750
،إن لم تقتنع

304
00:17:50,090 --> 00:17:51,460
.جرّبه بنفسك

305
00:17:51,460 --> 00:17:53,920
!تذوّق طبق كوليبياك خاصّتي

306
00:18:02,220 --> 00:18:04,220
!ماذا؟

307
00:18:04,220 --> 00:18:10,940
السّلمون... أومامي السّلمون
!يغمرني كسيلٍ لا ينتهي

308
00:18:10,940 --> 00:18:13,320
!كيف يعقل هذا؟

309
00:18:13,630 --> 00:18:14,730
ما هذا؟

310
00:18:14,730 --> 00:18:17,990
.هنالك طبقة خضراء بين البريوش والحشوة

311
00:18:18,750 --> 00:18:20,700
أنا أريك يا عضو المركز

312
00:18:21,540 --> 00:18:24,330
أنّي لست نفس الطّاهي الّذي كنت
.عليه في انتخابات الخريف

313
00:18:24,950 --> 00:18:28,330
إنّه كريب مُعدّ من السّبانخ
.الممزوجة في العجينة

314
00:18:28,330 --> 00:18:29,290
كريب؟

315
00:18:29,290 --> 00:18:30,470
!فهمت

316
00:18:30,470 --> 00:18:35,830
النّكهة النّاعمة الّتي أحسست بها
.عندما تذوّقت الطّبق كانت للسّبانخ

317
00:18:35,830 --> 00:18:39,300
!لقد أظهر ذلك خفّة دهن السّلمون

318
00:18:39,300 --> 00:18:41,760
.مذهل، يبدو هذا لذيذًا حقًّا

319
00:18:41,760 --> 00:18:45,220
!طبقتان من البريوش والكريب، مذهل

320
00:18:45,220 --> 00:18:46,960
!هذا ليس كلّ شيء

321
00:18:46,960 --> 00:18:50,850
لا بدّ من وجود خدعة أخرى
!لتدفّق الأومامي ذاك

322
00:18:50,850 --> 00:18:55,400
.لقد أضفت مزيج توابل خاصّ للكريب أيضًا

323
00:18:55,400 --> 00:18:57,070
...توابل

324
00:18:57,070 --> 00:18:59,860
.لقد أعدّ مزيج بهارات بنفسه

325
00:18:59,860 --> 00:19:04,240
إنّه يحتوي على الزّعتر والأوريغانو والثّوم
.والملح الحجريّ إضافة لأشياء أخرى

326
00:19:04,700 --> 00:19:07,450
.مسحوق اللّحم المجفّف من ضمن المكوّنات أيضًا

327
00:19:07,450 --> 00:19:08,650
لحم مجفّف؟

328
00:19:08,650 --> 00:19:10,420
.كما في طبقي

329
00:19:10,420 --> 00:19:11,060
.بالفعل

330
00:19:11,060 --> 00:19:14,700
لعب الحظّ دورًا عندما استعمل كلا الطّاهيين
.اللّحم المجفّف مع السّلمون

331
00:19:14,700 --> 00:19:18,380
كان الفكرة هي نفسها، لكنّ التّنفيذ
!كان مختلفًا تمامًا

332
00:19:18,700 --> 00:19:21,410
لفّ كوسنوكي اللّحم المجفّف حول السّلمون

333
00:19:21,410 --> 00:19:25,390
واستعمل الطبّخ بدرجة حرارة منخفضة
.لتعريضهما إلى حرارة بطيئة وراقية

334
00:19:25,390 --> 00:19:28,900
كما هو حال الطّعام البحريّ وحساء عظام
،الخنزير المستعملة في الرّامن عادة

335
00:19:28,900 --> 00:19:34,360
نجد أنّه جمع بين أومامي السّمك واللّحمّ
.دون أن يسمح لأيٍّ من النّكهات بالإفلات

336
00:19:34,780 --> 00:19:39,190
بعبارات أخرى، حافظ على كلّ النّكهات اللّذيذة
!للسّلمون على الطّبق بشكل مثاليّ شامل

337
00:19:39,190 --> 00:19:42,780
!إذًا لماذا تقول أنّ طبق رين-تشان أقلّ شأنًا؟

338
00:19:42,780 --> 00:19:45,410
."العنصر المميّز هو "التّباين

339
00:19:45,410 --> 00:19:46,620
التّباين؟

340
00:19:46,990 --> 00:19:52,060
حاسّة تذوّق البشر مصمّمة لتشعر
بالغنى والنّكهة بحدّة أكبر

341
00:19:52,060 --> 00:19:54,880
.عندما لا تكون النّكهات متجانسة

342
00:19:54,880 --> 00:19:57,710
إنّه المبدأ نفسه الّذي يفسّر
لماذا يفضّل الكثير من النّاس

343
00:19:57,710 --> 00:20:01,170
الاستمتاع بزيت السّمسم في حساء
الرّامن والحليب في القهوة

344
00:20:01,170 --> 00:20:02,470
.دون خلطهما في البداية

345
00:20:02,470 --> 00:20:03,730
.صحيح

346
00:20:03,730 --> 00:20:05,090
،عند مزج البيض النّيء مع الأرزّ

347
00:20:05,090 --> 00:20:07,610
.يكون مذاقهما أفضل إن لم نمزجهما

348
00:20:07,610 --> 00:20:10,930
يكون الطّعم أفضل عند إضافة صلصة
.الصّويا فوقهما دون غمرهما أيضًا

349
00:20:11,240 --> 00:20:13,690
.كان ذلك بالضّبط هدفي

350
00:20:14,260 --> 00:20:17,800
تم وضع التّتبيل بشكل متباين
.عبر الكريب عمدًا

351
00:20:17,800 --> 00:20:19,180
،أنشأ ذلك جانبين

352
00:20:19,180 --> 00:20:22,520
يمكّن أحدهما من تقدير الأومامي
،الصّريح للسّلمون

353
00:20:22,520 --> 00:20:24,970
بينما الآخر يجمع بين أومامي السّلمون
واللّحم المجفّف في خليط

354
00:20:24,970 --> 00:20:27,030
.قويّ وعميق للنّكهات

355
00:20:27,030 --> 00:20:33,280
لذلك تترك كلّ قضمة صدى يتردّد
.بشدّة عبر مستويات متعدّدة

356
00:20:33,280 --> 00:20:36,880
تتدفّق نكهات السّلمون المميّزة على
!حاسّة التّذوّق بشكل متوالٍ لا ينتهي

357
00:20:36,880 --> 00:20:38,750
لا يمكن تحقيق نكهة عالميّة كهذه

358
00:20:38,750 --> 00:20:43,470
!عن طريق وضع اللّحم المقدّد فوق السّلمون فقط

359
00:20:43,470 --> 00:20:47,390
،قد يبدو طبق كوسنوكي أفضل من الوهلة الأولى

360
00:20:47,390 --> 00:20:51,380
لكنّ كوروكيبا لم يستعمل البريوش
،والكريب لحصر الأومامي فقط

361
00:20:51,380 --> 00:20:54,480
.لكنّه سرّع أيضًا من نكهات السّلمون اللّذيذة

362
00:20:54,820 --> 00:20:59,020
لقد فكّر أيضًا في استعمال تطبيق
متباين للتّتبيل لصالحه؟

363
00:20:59,780 --> 00:21:03,610
كان من المفترض لك أن تكون مجرّد طاهٍ
!يجمع بين أومامي المكوّنات لا غير

364
00:21:04,080 --> 00:21:08,170
لم تكن قادرًا على التّفكير بطريقة دقيقة
!كهذه في انتخابات الخريف

365
00:21:08,660 --> 00:21:09,830
.معك حقّ

366
00:21:10,450 --> 00:21:11,570
!أنت

367
00:21:11,570 --> 00:21:12,580
!ماذا تفعل؟

368
00:21:12,930 --> 00:21:16,330
.لقد سمحت لك بالمجيء لمطبخي كمتدرّب

369
00:21:16,330 --> 00:21:18,350
!اعمل بجهد أكبر

370
00:21:18,350 --> 00:21:19,290
.حسنًا

371
00:21:19,290 --> 00:21:20,670
...سُحقًا

372
00:21:20,670 --> 00:21:22,850
لماذا انتهى بي المطاف في
مطعم كاري بالتّحديد؟

373
00:21:22,850 --> 00:21:26,380
.لا يسعني إلاّ تذكّر وغد البهارات ذاك

374
00:21:27,230 --> 00:21:28,120
!انتهيت

375
00:21:28,120 --> 00:21:28,850
!تحقّق منه

376
00:21:29,490 --> 00:21:30,810
!لا، لا

377
00:21:30,810 --> 00:21:33,310
!أنت لا تعرف شيئًا عن عمق البهارات

378
00:21:33,690 --> 00:21:37,420
إن كان لي خيار، كنت أفضّل الحصول
!على التّلميذ الّذي فاز بانتخابات الخريف

379
00:21:37,420 --> 00:21:39,500
إنّه خبير في البهارات حسب ما سمعت، صحيح؟

380
00:21:39,500 --> 00:21:41,020
!على عكسك أنت

381
00:21:44,630 --> 00:21:45,240
.مرحبًا

382
00:21:45,240 --> 00:21:47,170
.مرحبًا يا ريو-كُن

383
00:21:47,170 --> 00:21:49,070
هل تمرّ فترة التّدريب على خير؟

384
00:21:49,070 --> 00:21:51,260
.نعم، أظنّ ذلك

385
00:21:51,260 --> 00:21:54,530
.من الأفضل ألاّ تفقد أعصابك أمام صاحب المطعم

386
00:21:54,530 --> 00:21:56,160
.ليس بعد

387
00:21:56,550 --> 00:21:59,910
لا يمكننا أن نسمح للأمور أن تنتهي هنا، صحيح؟

388
00:21:59,910 --> 00:22:03,350
علينا أن نثبت أنفسنا بعد إهانة الهزيمة
.الّتي تكبّدناها في انتخابات الخريف

389
00:22:03,350 --> 00:22:04,980
.معك حقّ

390
00:22:04,980 --> 00:22:06,370
!سأنجح

391
00:22:06,370 --> 00:22:08,100
،بما أني أتيت إلى هنا الآن

392
00:22:08,100 --> 00:22:12,890
فسوف أتقن تعقيدات البهارات
!وكيف أستفيد منها

393
00:22:14,180 --> 00:22:18,730
طبعًا أنت لست نفس الطّاهي الّذي كان
!في انتخابات الخريف يا كوروكيبا

394
00:22:18,730 --> 00:22:21,910
.لقد تغيّرت

395
00:22:21,910 --> 00:22:26,940
،بالنّظر الآن لحماسي المشتعل
!يبدو لي سلمونك متجمّدًا

396
00:22:28,950 --> 00:22:30,980
!كوروكيبا هو الفائز

397
00:22:30,980 --> 00:22:33,970
!لقد فاز كوروكيبا ريو

398
00:24:07,130 --> 00:24:10,970
!أتمنّى أن تكون الحلقة القادمة على ذوقكم