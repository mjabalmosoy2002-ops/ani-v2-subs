1
00:00:07,810 --> 00:00:10,400
!هذا لذيذ

2
00:00:10,850 --> 00:00:13,460
.هذا هو كشك يوكيهيرا سوما

3
00:00:13,460 --> 00:00:15,780
إنّه المشارك الّذي وصل للنّهائيّات، صحيح؟

4
00:00:16,100 --> 00:00:18,190
!يا لها من رائحة شهيّة

5
00:00:18,190 --> 00:00:19,540
.خبز الفلفل الأسود

6
00:00:19,870 --> 00:00:22,370
!إنّه ساخن ولذيذ

7
00:00:22,370 --> 00:00:24,750
!أرجوكم تعالوا وكلوا هنا

8
00:00:24,750 --> 00:00:28,210
.خبز الفلفل الأسود، اختصاص تايوانيّ

9
00:00:28,210 --> 00:00:31,800
.أظنّها فكرة جيّدة بصراحة

10
00:00:32,260 --> 00:00:36,560
إنّ ذلك يسمح لك بتمييز نفسك
،من مطبخ سيشوان، نقطة قوّتي

11
00:00:36,560 --> 00:00:38,800
.رغم اختيارك الطّبخ الصّينيّ

12
00:00:39,290 --> 00:00:45,770
قبل كلّ شيء، فإنّ مذاق الفلفل القويّ
.وعصارة اللّحم ستأسران من يتذوّقونه

13
00:00:46,140 --> 00:00:51,480
لكن اعلم أنّه لا فائدة من ذلك
.إن لم يأتِ من يأكله

14
00:00:52,180 --> 00:00:54,180
.اسمع يا يوكيهيرا-تشين

15
00:00:54,180 --> 00:00:59,370
يختلف مهرجان وليمة القمر عن الشّوكوغيكي
.حيث تذوّقُ الحكّام لطعامك مضمون

16
00:00:59,370 --> 00:01:02,300
ماذا؟ ما هذا الكشك الكبير؟

17
00:01:02,300 --> 00:01:04,870
إنّه يقدّم طبخ منطقة سيشوان من صاحب
.المركز الثّامن من النّخبة العشرة

18
00:01:04,870 --> 00:01:06,330
.ربّما سأذهب إلى هناك

19
00:01:06,330 --> 00:01:07,580
!النّخبة العشرة

20
00:01:07,580 --> 00:01:08,900
.أظنّني سأذهب إلى هناك أيضًا

21
00:01:09,340 --> 00:01:12,800
.سيفضّل الزّبائنُ الأقوياءَ فقط

22
00:01:13,400 --> 00:01:15,010
أليس ذلك واضحًا؟

23
00:02:51,390 --> 00:02:53,900
!لقد بدأ مهرجان وليمة القمر أخيرًا يا رفاق

24
00:02:53,900 --> 00:02:56,490
لنستغلّ هذه الفرصة للاستمتاع
بحياة المدرسة لأقصى حدّ

25
00:02:56,490 --> 00:02:58,860
!بينما نضمن أنّ زبائننا راضون بالكامل

26
00:02:58,860 --> 00:03:00,820
!أجل

27
00:03:01,370 --> 00:03:03,030
.بدأ المهرجان أخيرًا يا هيساكو

28
00:03:03,030 --> 00:03:04,280
.نعم يا إرينا-ساما

29
00:03:04,690 --> 00:03:07,500
لنهزم كلّ الأكشاك الأخرى
!بالدّونبوري المميّز خاصّتنا

30
00:03:07,500 --> 00:03:09,100
!ابذلوا ما بوسعكم جميعًا

31
00:03:09,100 --> 00:03:09,620
!حاضر

32
00:03:10,180 --> 00:03:12,840
يا رفاق، هل أنتم جاهزون جميعًا؟

33
00:03:12,840 --> 00:03:14,000
!أجل

34
00:03:14,000 --> 00:03:15,290
!حسنًا، لنبدأ

35
00:03:16,390 --> 00:03:19,850
ما كلّ هذا الكركم؟

36
00:03:19,850 --> 00:03:21,850
...لدينا حبّتا طماطم فحسب

37
00:03:21,850 --> 00:03:23,820
من اهتمّ بالطّلب؟

38
00:03:23,820 --> 00:03:25,510
...حسنًا، ذلك

39
00:03:25,900 --> 00:03:30,170
أخبراني، أين مقبس جهاز الطّرد المركزيّ؟

40
00:03:30,170 --> 00:03:31,260
.هذا كابوس

41
00:03:31,260 --> 00:03:32,350
.بل هو الواقع

42
00:03:36,610 --> 00:03:40,950
واصلوا، واصلوا، واصلوا! تذوّقوا رجاءً
!نكهة مطبخ سيشوان المغرية هذه

43
00:03:41,290 --> 00:03:43,950
،إضافة إلى طبقنا الرّئيسيّ المابو توفو

44
00:03:43,950 --> 00:03:47,660
لدينا سبانخ ماء حارّة وزلابيّة حارّة
!ودجاج مبخّر مع صلصة الفلفل الحارّة

45
00:03:51,040 --> 00:03:52,720
!حارّ جدًّا

46
00:03:52,720 --> 00:03:54,000
!ماء! ماء

47
00:03:54,380 --> 00:03:55,550
...لكن

48
00:03:56,350 --> 00:03:57,340
!لا يمكنني الكفّ عن الأكل

49
00:03:57,710 --> 00:04:01,220
لدينا خبز الفلفل الأسود! من يريد تجربته؟

50
00:04:01,220 --> 00:04:03,340
!احصلوا عليه بينما ما يزال ساخنًا

51
00:04:03,790 --> 00:04:05,990
!ثمنه تذكرة برقوق واحدة فقط

52
00:04:05,990 --> 00:04:07,010
!اقتربوا، اقتربوا

53
00:04:16,300 --> 00:04:19,360
.تذكرة، تذكرتان

54
00:04:19,360 --> 00:04:21,320
.إنّها كثيرة

55
00:04:21,320 --> 00:04:23,420
.هذا رائع، إنّها كثيرة

56
00:04:23,420 --> 00:04:26,320
.أنا سعيد لحصولك على الكثير من الزّبائن

57
00:04:26,320 --> 00:04:29,080
.أنا سعيد من أجلك كزميل أكبر لك

58
00:04:29,080 --> 00:04:32,200
!مستقبل توتسكي مشرق بوجود تلاميذ مثلك

59
00:04:32,850 --> 00:04:35,460
.لقد جنت مجموعة أبحاث الطّبخ الصّينيّ الكثير

60
00:04:35,460 --> 00:04:41,170
ليتك قررّت ألاّ تفتعل قتالاً معي
،واخترت مكانًا مختلفًا لكشكك

61
00:04:41,590 --> 00:04:46,930
لكنت بذلك لتحظى بمهرجان مدرسة
.أكثر مرحًا. هذا مؤسف

62
00:04:47,570 --> 00:04:51,970
حسنًا، على فريق التّجهيز الاستعداد
.لما سنحتاجه غدًا

63
00:04:55,600 --> 00:04:57,340
!ما-ما-ما العمل؟

64
00:04:57,340 --> 00:04:59,440
إنّ خسارتنا أمست مضمونة تمامًا
!من اليوم الأوّل

65
00:04:59,440 --> 00:05:02,610
سوما-كُن، سيحدّد هذا سواء كنت
!ستبقى في توتسكي أم لا

66
00:05:02,610 --> 00:05:06,700
حسنًا، لم أتوقّع أن نبلي حسنًا
...من اليوم الأوّل، لكن

67
00:05:03,270 --> 00:05:04,690
!يا إلهي

68
00:05:07,170 --> 00:05:10,080
!لم أعتقد أنّنا سنعاني هكذا

69
00:05:10,080 --> 00:05:11,830
!هذا لا يدعو للضّحك

70
00:05:12,480 --> 00:05:13,410
...نعم

71
00:05:14,390 --> 00:05:15,850
.معك حقّ

72
00:05:19,340 --> 00:05:22,300
.لدينا إعلان للجميع

73
00:05:22,720 --> 00:05:28,010
لقد انتهينا من فرز مبيعات اليوم الأوّل
.من المهرجان حتّى السّادسة مساءً

74
00:05:28,370 --> 00:05:31,960
سوف نعلن الآن عن ترتيب
.المبيعات لكلّ منطقة

75
00:05:31,960 --> 00:05:34,060
!سنبدأ بمنطقة الشّارع الرّئيسيّ

76
00:05:34,060 --> 00:05:36,310
...المركز الثّالث من نصيب

77
00:05:38,970 --> 00:05:40,110
!مجموعة أبحاث الدّون

78
00:05:40,970 --> 00:05:43,940
!مجموعة أبحاث الدّون! كنّا نوشك أن ننتهي

79
00:05:43,940 --> 00:05:45,320
!انظروا لحالنا الآن

80
00:05:45,320 --> 00:05:47,110
!لا يوجد ما يدعو للفرح بشأن المركز الثّالث

81
00:05:47,110 --> 00:05:49,660
المركز الثّاني من نصيب مجموعة
!أبحاث مشويّات السّيخ

82
00:05:49,660 --> 00:05:51,410
!والآن دور المركز الأوّل

83
00:05:51,410 --> 00:05:53,940
!الفائز هو ملحق تراتّوريا ألديني

84
00:05:53,940 --> 00:05:55,970
!نحن في الصّدارة يا أخي

85
00:05:55,970 --> 00:06:00,290
أعتقد أنّ امتلاك شخص تأهّل للمنافسة
!الرّئيسيّة كقائد لنا كان عامل جذب جيّدًا

86
00:06:00,790 --> 00:06:03,550
.كلاّ، بل لأنّنا عملنا جميعًا معًا

87
00:06:04,660 --> 00:06:07,540
!والآن دور المنطقة الوسطى

88
00:06:07,540 --> 00:06:08,300
!كيف أبلى يوكيهيرا؟

89
00:06:08,640 --> 00:06:11,470
المركز الثّالث من نصيب مطعم يويو
!لمجموعة أبحاث المطبخ الغربيّ

90
00:06:11,820 --> 00:06:14,600
والثّاني من نصيب إل فويغو لمجموعة
!أبحاث المطبخ الإسبانيّ

91
00:06:14,600 --> 00:06:19,770
والمركز الأوّل من نصيب مطعم كوغا
!لمجموعة أبحاث المطبخ الصّينيّ

92
00:06:19,770 --> 00:06:23,020
لقد وصلت مبيعاتهم لضعف مبيعات
!كشك المركز الثّاني وما تحته

93
00:06:23,020 --> 00:06:24,530
...يوكيهيرا

94
00:06:24,530 --> 00:06:27,070
.أرى أنّك لم تستطع أخذ زبائن من كوغا تيروني

95
00:06:27,070 --> 00:06:30,110
كنت آمل أن يحتلّ مكانًا بين
.الثّلاثة الأوائل على الأقلّ

96
00:06:30,110 --> 00:06:32,380
!نسخة إضافيّة من جريدة رياضات توتسكي

97
00:06:32,380 --> 00:06:36,080
لدينا ترتيب اليوم الأوّل الّذي يضمّ
.المراكز ما تحت الثّالث

98
00:06:36,480 --> 00:06:38,040
!انظروا

99
00:06:38,040 --> 00:06:40,000
!هنالك كشكان لم يجنيا أيّة أرباح

100
00:06:40,000 --> 00:06:41,490
!يا لغبائهم

101
00:06:43,290 --> 00:06:44,960
!ما معنى هذا؟

102
00:06:45,290 --> 00:06:48,340
لقد تأهّلتم جميعًا لمراكز متقدّمة
!من منافسة انتخابات الخريف الرّئيسيّة

103
00:06:48,700 --> 00:06:51,810
مجرّد تواجد تواجد المتأهّلين
.الثّلاثة للنّهائيّ في نهاية التّرتيب محرج

104
00:06:51,810 --> 00:06:53,460
!لكنّكم خسرتم المال جميعًا حتّى

105
00:06:53,460 --> 00:06:56,680
هل تحاولون التّقليل من مكانة
!انتخابات الخريف الرّاقية؟

106
00:06:57,490 --> 00:06:59,180
!أ-أنا... أنا آسفة

107
00:06:59,180 --> 00:07:01,810
لم... لم أكن أتحدّث معك على وجه
.الخصوص يا تادوكورو-سان

108
00:07:02,170 --> 00:07:04,350
كيف ستتحمّلين مسؤوليّة هذا يا ناكيري؟

109
00:07:04,350 --> 00:07:06,800
لقد اقترفتِ الكثير من الأخطاء
!في طلب المكوّنات

110
00:07:06,800 --> 00:07:10,210
لكن كان يفترض بك التّحقّق
!من الطّلب يا هاياما-كُن

111
00:07:10,210 --> 00:07:13,440
.أعتقد أنّك قلت ستهتمّين بذلك أيضًا يا آنستي

112
00:07:13,440 --> 00:07:15,610
!أنت، أنت في صفّ من؟

113
00:07:15,610 --> 00:07:16,770
.يا كوروكيبا

114
00:07:16,770 --> 00:07:18,540
ما خطب آنستك؟

115
00:07:18,540 --> 00:07:21,450
!غيّرت القائمة كثيرًا حتّى آخر يوم

116
00:07:21,450 --> 00:07:23,690
!لهذا السّبب اقترفت أخطاءً كهذه

117
00:07:24,840 --> 00:07:26,720
.أنت لا تعرف عمّاذا تتحدّث

118
00:07:26,720 --> 00:07:29,210
.ستواصل فعل ذلك غدًا وإلى الأبد

119
00:07:30,300 --> 00:07:34,820
على أيّ حال، علينا أن نجني أرباحًا
.ابتداءً من الغد فحسب

120
00:07:34,820 --> 00:07:36,100
.حسنًا، لنتّبع طريقة مختلفة

121
00:07:36,100 --> 00:07:38,320
!هذا خطؤك من الأساس

122
00:07:38,320 --> 00:07:40,150
!ألا تشعرين حتّى بالأسف؟

123
00:07:40,150 --> 00:07:42,770
!عمل الفريق منعدم لديهم

124
00:07:43,210 --> 00:07:46,300
ميغومي، هل أنت بخير؟

125
00:07:46,300 --> 00:07:48,090
.أنت لم تتحدّي النّخبة العشرة من الأساس

126
00:07:48,090 --> 00:07:49,850
.وقد ينتهي بكما المطاف مطرودين معًا

127
00:07:49,850 --> 00:07:51,570
...أ-أجل

128
00:07:51,570 --> 00:07:53,780
.حسنًا، أنا واثق من أنّنا سنجد حلاًّ ما

129
00:07:53,780 --> 00:07:55,170
!يوكيهيرا؟

130
00:07:55,170 --> 00:07:56,620
!أين كنت؟

131
00:07:56,970 --> 00:07:59,700
.كان عليّ الاهتمام بأمر ما فحسب

132
00:07:59,700 --> 00:08:01,620
بالمناسبة، هل أنتم جائعون؟

133
00:08:02,620 --> 00:08:05,440
لقد أعددت بعض خبز الفلفل الحارّ
.باستعمال بقايا اليوم

134
00:08:05,440 --> 00:08:06,750
.لنتعشّى معًا

135
00:08:06,750 --> 00:08:08,720
.أكيد، سأتناول واحدًا

136
00:08:08,720 --> 00:08:09,590
!أين ذهب كلّ ذلك التّوتّر؟

137
00:08:10,000 --> 00:08:12,060
!أبليتم حسنًا جميعًا

138
00:08:12,060 --> 00:08:14,050
.لنبدأ إغلاق الكشك لهذا اليوم

139
00:08:14,050 --> 00:08:16,450
ماذا؟ سنتوقّف الآن؟

140
00:08:16,450 --> 00:08:19,530
لكنّ النّاس بدؤوا يتوافدون على
.منطقة يامانوتي للتّوّ

141
00:08:19,530 --> 00:08:20,930
لماذا لا نستمرّ قليلاً بعد؟

142
00:08:21,350 --> 00:08:25,220
.هدفنا الرّئيسيّ هو الاستمتاع بوقتنا

143
00:08:25,220 --> 00:08:27,020
.ليس علينا أن نبالغ في يومنا الأوّل

144
00:08:27,690 --> 00:08:28,650
...إضافة لذلك

145
00:08:29,270 --> 00:08:32,360
.هنالك أمر أريد الاستعداد له غدًا أيضًا

146
00:08:32,900 --> 00:08:35,200
.تفضّلي، ابنة ناكيري الأخرى يجب أن تأكل أيضًا

147
00:08:35,200 --> 00:08:37,040
!أخبرتك ألاّ تنادنا ابنتا ناكيري

148
00:08:37,040 --> 00:08:38,530
!ولن آكل شيئًا

149
00:08:38,530 --> 00:08:40,560
،لقد ساعدتك في اختبار التّذوّق دون قصد

150
00:08:40,560 --> 00:08:42,790
لكنّي لم أعترف بعد بأنّ طبخك
!يرتقي للمستوى المطلوب

151
00:08:42,790 --> 00:08:43,660
...حسنًا

152
00:08:43,660 --> 00:08:45,750
.لكنّه لذيذ يا إرينا

153
00:08:45,750 --> 00:08:50,130
تستفيد حشوة اللّحم من رائحة
.الفلفل الأسود وزيت السّمسم

154
00:08:50,130 --> 00:08:53,450
.لكن كان مذاقها ليكون أفضل إن أعددتها أنا

155
00:08:53,450 --> 00:08:54,260
!ماذا؟

156
00:08:54,260 --> 00:08:55,860
،إضافة للفلف الأسود

157
00:08:55,860 --> 00:08:59,100
تحتوي الحشوة على مسحوق البهارات
،الخمسة الأساسيّة للطّبخ الصّينيّ

158
00:08:59,100 --> 00:09:02,670
.والينسون الّذي يعزّز النّكهة

159
00:09:02,670 --> 00:09:03,730
!أصبت

160
00:09:04,220 --> 00:09:07,560
.التّتبيلات الصّينية مجرّد بهارات في الأساس

161
00:09:07,560 --> 00:09:11,160
كنت قادرًا على استعمال ما تعلّمته خلال
.مواجهة الكاري في المرحلة التّمهيديّة

162
00:09:11,160 --> 00:09:13,860
.وقد ساعدتني نيكومي أيضًا

163
00:09:14,170 --> 00:09:17,360
هنالك تتبيلات أخرى تستعمل
.في المطبخ الصّينيّ أيضًا

164
00:09:17,790 --> 00:09:22,570
صلصة المحّار وصلصة إكس-أو
.والكثير من البهارات الأخرى

165
00:09:22,570 --> 00:09:23,080
.نعم

166
00:09:23,530 --> 00:09:25,750
!لنجرّب بعضها

167
00:09:25,750 --> 00:09:29,460
سألفّ هذا بالعجين مع بعض
.البصل المقطّع بشكل صغير وأطبخه

168
00:09:29,460 --> 00:09:30,860
!لذيذ

169
00:09:30,860 --> 00:09:32,500
!إنّه لذيذ جدًّا يا يوكيهيرا

170
00:09:32,500 --> 00:09:34,680
!شكرًا على مساعدتك يا نيكومي

171
00:09:34,680 --> 00:09:37,180
!كلاّ، لا تمسك يدي فجأة هكذا

172
00:09:37,180 --> 00:09:39,530
يوكيهيرا، لماذا لم تطلب مساعدتي؟

173
00:09:39,530 --> 00:09:41,640
أخي، لماذا لا تسأله مباشرة؟

174
00:09:43,500 --> 00:09:46,890
.هذا هو ترتيب المبيعات لليوم الأوّل إذًا

175
00:09:46,890 --> 00:09:47,840
!مذهل

176
00:09:47,840 --> 00:09:50,890
العديد من النّخبة العشرة قد احتلّوا
!المراكز الأولى في منطقة يامانوتي

177
00:09:50,890 --> 00:09:54,460
أكانيغاكوبو-سينباي الرّابعة من النّخبة
.قد احتلّت المركز الأوّل

178
00:09:54,990 --> 00:09:57,810
بينما تسوكاسا-سينباي الأوّل من النّخبة
.قد احتلّ المركز الخامس

179
00:09:58,740 --> 00:10:04,460
مهلاً، لا أرى كوباياشي ريندو-سينباي الثّانية
.من النّخبة، أو حتّى إيزان-سينباي في القائمة

180
00:10:04,460 --> 00:10:05,870
.أتساءل إن كانا لم يشاركا

181
00:10:05,870 --> 00:10:09,400
.إحدى ابنتا ناكيري احتلّت المركز الثّاني

182
00:10:09,400 --> 00:10:11,150
.هذا مذهل

183
00:10:11,150 --> 00:10:12,770
.سأمرّ عليك، فدعيني أجرّب طعامك

184
00:10:12,770 --> 00:10:15,840
إن كنت تريد الأكل في مطعمي، من الأفضل
.أن تحضر ومعك الكثير من تذاكر الصّنوبر

185
00:10:16,260 --> 00:10:19,250
.لا يمكن الدّخول لكشك إرينا-ساما إلاّ بالحجز

186
00:10:19,250 --> 00:10:21,960
.نحن لا نقبل الزّبائن المارّين

187
00:10:21,960 --> 00:10:25,220
.ولو كنّا نقبلهم، لاحتللنا المركز الأوّل

188
00:10:25,220 --> 00:10:26,060
.هكذا إذًا

189
00:10:26,390 --> 00:10:31,210
لا يحاول كلّ المشاركين التّنافس
.على المبيعات مثلك

190
00:10:31,210 --> 00:10:34,690
ثمّة العديد من التّلاميذ ممّن يسعون
.لصقل مهاراتهم في الطّبخ

191
00:10:34,690 --> 00:10:37,070
.هكذا إذًا، أعتقد أنّ هنالك أنواعًا كثيرة

192
00:10:37,570 --> 00:10:38,770
!على أيّ حال

193
00:10:38,770 --> 00:10:41,940
الآن ليس الوقت المناسب لك لتعير انتباهك
لأكشاك في مناطق أخرى، صحيح؟

194
00:10:41,940 --> 00:10:45,080
عليك التّركيز على هزيمة كوغا-سان
.في المنطقة الوسطى

195
00:10:45,440 --> 00:10:46,330
فعلاً؟

196
00:10:51,090 --> 00:10:51,790
ماذا؟

197
00:10:51,790 --> 00:10:53,060
!نيكومي

198
00:10:53,060 --> 00:10:55,510
!لقد انهارت خيمة كشكنا

199
00:10:55,510 --> 00:10:58,380
!تعالي في الحال

200
00:10:56,730 --> 00:10:58,780
!كفّ عن البكاء أيّها الضّعيف

201
00:10:58,780 --> 00:10:59,770
!تماسك، سآتي في الحال

202
00:10:59,770 --> 00:11:03,710
.يا أخي، علينا أن نبدأ الاجتماع من أجل الغد

203
00:11:03,710 --> 00:11:05,150
.الجميع في انتظارنا

204
00:11:05,150 --> 00:11:06,390
.صحيح

205
00:11:06,700 --> 00:11:08,790
.علينا أن نلتقي ونحدّد استراتيجيّتنا أيضًا

206
00:11:08,790 --> 00:11:09,850
.حسنًا

207
00:11:09,850 --> 00:11:10,310
.نعم

208
00:11:10,310 --> 00:11:14,550
عليك أن تركّز على جني الأرباح
!أكثر من غيرك يا يوكيهيرا

209
00:11:14,550 --> 00:11:16,920
!لا تتسبّب في طرد ميغومي

210
00:11:16,920 --> 00:11:18,520
!أكيد، سأبذل ما في وسعي

211
00:11:18,520 --> 00:11:19,880
في الأساس، أنت مجرّد

212
00:11:19,880 --> 00:11:23,160
.أخي، لنذهب

213
00:11:20,250 --> 00:11:22,270
!مهلاً يا إيسامي

214
00:11:22,270 --> 00:11:23,160
!يا يوكيهيرا

215
00:11:23,160 --> 00:11:27,090
!لا تنس أنّي منافسك

216
00:11:24,090 --> 00:11:27,090
.تادوكورو، أظنّ أنّ علينا الاستعداد للغد أيضًا

217
00:11:27,090 --> 00:11:27,620
!نعم

218
00:11:30,380 --> 00:11:31,710
!حسنًا

219
00:11:31,710 --> 00:11:32,960
ماذا؟

220
00:11:33,280 --> 00:11:37,100
.ظننتُ أنّه قد تبقّى الكثير من لحم الحشوة

221
00:11:37,100 --> 00:11:39,550
ربّما أكلناه كلّه في العشاء قبل قليل؟

222
00:11:43,270 --> 00:11:44,170
...يا سوما

223
00:11:44,170 --> 00:11:45,940
.نعم، شكرًا لك

224
00:11:45,940 --> 00:11:46,890
.تفضّل

225
00:11:47,350 --> 00:11:48,890
.أعتمد عليك

226
00:11:51,890 --> 00:11:53,770
سوما-كُن، ما كان ذلك؟

227
00:11:54,370 --> 00:11:55,810
!أهلاً يا تادوكورو

228
00:11:55,810 --> 00:11:58,280
هل لديك وقت لنتناقش في بعض
الأمور بشأن بقيّة المهرجان؟

229
00:11:58,600 --> 00:11:59,500
ماذا؟

230
00:11:59,500 --> 00:12:00,870
.نـ-نعم

231
00:12:02,470 --> 00:12:03,490
!حسنًا يا رفاق

232
00:12:03,490 --> 00:12:05,200
!إنّه اليوم الثّاني من مهرجان وليمة القمر

233
00:12:05,200 --> 00:12:07,610
!أضفت اتّجاهًا جديدًا لكشكنا

234
00:12:07,610 --> 00:12:12,080
لنزد من رضى الزّبائن
!ونستمتع أكثر بحياة المدرسة

235
00:12:12,080 --> 00:12:14,040
!أجل

236
00:12:15,500 --> 00:12:16,960
!دايغو-تشان

237
00:12:16,960 --> 00:12:18,420
!شوجي-نيان

238
00:12:18,420 --> 00:12:19,880
!شون-ساما

239
00:12:19,880 --> 00:12:21,340
!زينجي

240
00:12:21,340 --> 00:12:23,800
!إيشّيكي-كُن

241
00:12:23,800 --> 00:12:27,110
.يـ-يبدو وكأنّه نادي ضيافة لسبب ما

242
00:12:27,110 --> 00:12:30,390
.لكنّه يعرف زبائنه بالفعل

243
00:12:30,800 --> 00:12:33,520
.قد ندخل المراكز الخمسة الأولى اليوم

244
00:12:33,520 --> 00:12:35,980
!أربع طلبات دونبوري مميّز

245
00:12:35,980 --> 00:12:39,480
إن أردت شيئًا خفيفًا أكثر، فما رأيك بالكالزوني؟

246
00:12:39,820 --> 00:12:41,570
!ليس لدينا خبز نان

247
00:12:42,040 --> 00:12:45,500
تركت تهتمّين بأمر خبز النّان لأنّك قلت
!أنّه يمكنك تولّي ذلك الأمر يا ناكيري

248
00:12:45,500 --> 00:12:47,290
وذلك ما فعلت، أترى؟

249
00:12:47,290 --> 00:12:49,540
!هنالك حلوى تبلورت وتمثّل كلّ ما في خبز النّان

250
00:12:49,540 --> 00:12:51,580
!كيف يمكن للكاري أن يقدّم مع هذه

251
00:12:51,580 --> 00:12:53,470
.إنّ مذاقها يشبه النّان

252
00:12:53,470 --> 00:12:55,270
!أحبّ هذه الرّائحة القذرة

253
00:12:55,270 --> 00:12:56,350
!أعطيني خمسة

254
00:12:56,350 --> 00:12:57,290
!وأنا اثنتان

255
00:12:58,630 --> 00:13:03,050
محلّ الظّلمة للسّمك المجفّف
.له زبائن كثر اليوم أيضًا

256
00:13:03,560 --> 00:13:07,260
أنا قلقة نوعًا ما من أن يكون كلّ
...زبائني من نفس النّوع، لكن

257
00:13:07,260 --> 00:13:11,520
أكانت ساداتسوكا جادّة بشأن تقديم
ذلك في منطقة الشّارع الرّئيسيّ؟

258
00:13:11,520 --> 00:13:13,230
.كانت لتكون هنالك شكاوى عن الرّائحة

259
00:13:13,550 --> 00:13:15,590
!هذا ليس سيّئًا

260
00:13:15,590 --> 00:13:17,590
طعمه يشبه نسخة أكثر حلاوة
.من البطارخ النّاعمة

261
00:13:17,590 --> 00:13:18,670
!صحيح

262
00:13:18,670 --> 00:13:21,190
مذاق يرقات الزّنبور الآسيويّ
العملاق لذيذ، صحيح؟

263
00:13:21,570 --> 00:13:24,150
!شكرًا على الطّعام

264
00:13:24,150 --> 00:13:25,940
...حسنًا، المحطّة التّالية

265
00:13:25,940 --> 00:13:29,450
!لا بدّ أنّه صفّ الدّخول لمطعم كوغا

266
00:13:31,330 --> 00:13:35,120
!هنالك صفّ لا ينتهي أطول من صفّ البارحة

267
00:13:35,450 --> 00:13:38,830
إنّ عملي يسير بوتيرة ثابتة! من الصّعب
!أن يكون المرء ذكيًّا في مجال الأعمال

268
00:13:39,870 --> 00:13:42,300
.حسنًا، أظنّني سأمرّ عليه لاحقًا

269
00:13:42,300 --> 00:13:46,210
.ها هو ذا كشك يوكيهيرا سوما الصّغير

270
00:13:44,320 --> 00:13:47,580
أترغبون بخبز فلفل أسود؟

271
00:13:46,760 --> 00:13:48,500
.خبز فلفل أسود

272
00:13:48,500 --> 00:13:49,980
.يبدو لذيذًا

273
00:13:49,980 --> 00:13:50,720
ماذا؟

274
00:13:50,720 --> 00:13:53,460
إنّهم يأكلون شيئًا ما بعيدان الأكل؟

275
00:13:55,510 --> 00:13:56,890
!حان الوقت

276
00:13:56,890 --> 00:14:00,360
أفضل البائعين في المنطقة الوسطى
...لليوم الثّاني من المهرجان

277
00:14:00,360 --> 00:14:02,430
هو مطعم كوغا لمجموعة
!أبحاث الطّبخ الصّيني

278
00:14:02,430 --> 00:14:04,320
!إنّهم أصحاب أكثر دخل اليوم حتّى الآن أيضًا

279
00:14:04,320 --> 00:14:06,690
.حسنًا، هذا لا يفاجئني

280
00:14:06,690 --> 00:14:10,690
لكنّي بدأت أشعر ببعض الأسف
.على يوكيهيرا-تشين

281
00:14:10,690 --> 00:14:13,910
لقد كان في المركز الأربعين
.في نهاية اللاّئحة البارحة

282
00:14:15,190 --> 00:14:16,580
المركز الخامس والثّلاثون؟

283
00:14:16,580 --> 00:14:19,080
.أرى أنّه حاول قليلاً في اليوم الثّاني

284
00:14:19,850 --> 00:14:21,540
.إنّه ليس هنا

285
00:14:21,850 --> 00:14:22,990
.أخبروني

286
00:14:22,990 --> 00:14:25,610
هل شاهد أحدكم كشك يوكيهيرا-تشين اليوم؟

287
00:14:33,510 --> 00:14:34,600
فعلاً؟

288
00:14:34,600 --> 00:14:36,670
.بيع كلّ شيء اليوم أيضًا

289
00:14:36,670 --> 00:14:40,990
أبلى الطّعام الّذي يفضّله من يحبّون
.الطّعام ذا الرّائحة بلاءً حسنًا

290
00:14:47,100 --> 00:14:48,180
...إنّه

291
00:14:48,180 --> 00:14:48,900
!يا سيّدي

292
00:14:49,430 --> 00:14:52,050
هل ترغبون بأخذ بعض خبز
الفلفل الأسود معكم؟

293
00:14:52,050 --> 00:14:53,410
.إنّه بالمجّان

294
00:14:53,410 --> 00:14:55,570
لا تريد تذاكر مقابل ذلك؟

295
00:14:55,570 --> 00:14:56,130
!كلاّ

296
00:14:56,130 --> 00:14:56,790
!تفضّل

297
00:14:59,250 --> 00:15:01,460
!إنّه مليء بالعصارة وحارّ

298
00:15:01,460 --> 00:15:02,420
!إنّه لذيذ

299
00:15:02,420 --> 00:15:04,890
!إنّه مليء بالعصارة

300
00:15:04,890 --> 00:15:06,980
بما أنّه بالمجّان، فهلّي بواحد أيضًا؟

301
00:15:06,980 --> 00:15:08,340
!أجل، بالطّبع

302
00:15:08,340 --> 00:15:10,230
أنت تخبزه في فرن حجريّ؟

303
00:15:09,210 --> 00:15:10,780
.إنّه لذيذ جدًّا

304
00:15:10,230 --> 00:15:11,820
هلّي بواحد أيضًا؟

305
00:15:10,780 --> 00:15:12,470
!نعم، ومليء بالعصارة

306
00:15:11,820 --> 00:15:13,220
!ساخن

307
00:15:13,220 --> 00:15:15,600
ما الّذي يحدث هنا؟

308
00:15:15,910 --> 00:15:17,060
!ساداتسوكا-سان؟

309
00:15:17,060 --> 00:15:19,770
!حبّار بصلصة الفول السّودانيّ؟! هذا مقرف

310
00:15:19,770 --> 00:15:22,480
.الكوسايا خاصّتك مقرفة أيضًا يا ساداتسوكا

311
00:15:22,480 --> 00:15:24,940
رائحتها مقرفة لكنّها مغرية، صحيح؟

312
00:15:26,870 --> 00:15:29,150
.يا لهما من ثنائيّ

313
00:15:30,330 --> 00:15:35,530
الكيفياك والسورسترومينغ هما اثنان من أفضل
.أطعمة العالم من حيث الرّائحة المقرفة واللّذة

314
00:15:35,530 --> 00:15:39,830
!طموحي هو خلق شيء أبشع بكثير وألذّ

315
00:15:39,830 --> 00:15:42,110
!أنت تفهمين الأمر

316
00:15:42,110 --> 00:15:45,130
تذوّقي تحفتي التجريبيّة: أكثر
!الأطباق قرفًا التجريبي لاحقًا

317
00:15:45,130 --> 00:15:46,330
.حسنًا

318
00:15:46,330 --> 00:15:49,710
سأسمح لك بتذوّق أطباقي
.البشعة واللّذيذة أيضًا

319
00:15:49,710 --> 00:15:53,620
أعتقد أنّ هذين الاثنين ما كان
.يجب أن يلتقيا أبدًا

320
00:15:54,800 --> 00:16:00,770
صحيح، كنتُ أجرّب أطباق جديدة البارحة
.عن طريق جرّ العربة في الأرجاء أيضًا

321
00:16:01,190 --> 00:16:05,190
.تقدّم الأكشاك الأخرى عيّنات على الطّريق

322
00:16:05,190 --> 00:16:09,250
لذلك لن تكون هنالك أيّ مشاكل بأخذ
عربتي وتقديم عيّنات مجّانيّة، صحيح؟

323
00:16:09,250 --> 00:16:10,990
.يا له من تفكير ماكر

324
00:16:10,990 --> 00:16:14,240
سيسمح لي هذا برؤية ردّة فعل
.زبائني على أطباقي

325
00:16:14,240 --> 00:16:17,830
.كما أردت تغيير وتيرتي أيضًا

326
00:16:18,650 --> 00:16:21,160
أظنّ أنّه لا يمكنني أن ألمح شيئًا
لا يمكنني رؤيته

327
00:16:21,680 --> 00:16:24,000
.وأنا أمام مجموعة أبحاث الطّبخ الصّينيّ

328
00:16:24,000 --> 00:16:26,190
هل تريد واحدًا؟

329
00:16:26,190 --> 00:16:27,570
.خبز الفلف الأسود

330
00:16:27,570 --> 00:16:29,430
.يبدو ذلك ثقيلاً نوعًا ما

331
00:16:29,430 --> 00:16:32,340
...إن كان لديكم شيء ينزل للمعدة بسهولة

332
00:16:32,340 --> 00:16:34,300
!طلبك عندي

333
00:16:34,300 --> 00:16:35,760
!انتظر لحظة رجاءً

334
00:16:36,260 --> 00:16:37,220
!لنبدأ

335
00:16:37,930 --> 00:16:39,460
ما هذا؟ معكرونة مصنوعة يدويًّا؟

336
00:16:39,460 --> 00:16:41,770
!أجل، يعدّ التّلميذ معكرونته بنفسه

337
00:16:42,200 --> 00:16:43,730
...هـ-هذا

338
00:16:43,730 --> 00:16:46,600
لقد قطّعت عجينة خبز الفلفل الأسود
!بشكل رقيق وحّولتها لمعكرونة؟

339
00:16:48,290 --> 00:16:49,520
!بالهناء والشّفاء

340
00:16:51,480 --> 00:16:54,950
!يمكنني شمّ حساء القريدس والثّوم

341
00:17:02,110 --> 00:17:03,070
!لذيذ

342
00:17:03,070 --> 00:17:04,910
!إنّ له نكهة عميقة مع أنّه خفيف

343
00:17:05,970 --> 00:17:09,070
كنت آكل طوال اليوم، لكنّ هذا
!ينزل للمعدة مباشرة

344
00:17:09,070 --> 00:17:11,550
!إنّها طريقة مميّزة لإنهاء اليوم

345
00:17:11,550 --> 00:17:16,130
الإضافات عبارة عن حشوة لحم الخنزير
المفروم لخبز الفلفل الأسود؟

346
00:17:16,130 --> 00:17:17,380
!هذا صحيح

347
00:17:17,380 --> 00:17:21,490
لقد جمعت مكوّنات الطّبق البارحة
.فقط بينما كنت أستمع لرغبات الزّبائن

348
00:17:21,490 --> 00:17:25,270
بفضل طبق المعكرونة هذا، حقّقنا
.أرباحًا أعلى في اليوم الثّاني

349
00:17:25,270 --> 00:17:28,230
ما كنت لأتوقّع منك أن تعدّ
...معكرونة من العجينة

350
00:17:28,230 --> 00:17:31,610
.كما أنّك ارتجلت ذلك في لحظة

351
00:17:31,610 --> 00:17:37,430
لا، بصراحة، هنالك طبق معكرونة
.مشابه له في تايوان

352
00:17:37,430 --> 00:17:38,570
!معكرونة دانزي

353
00:17:38,570 --> 00:17:39,770
!صحيح

354
00:17:39,770 --> 00:17:45,020
إنّها معكرونة قمح في حساء خفيف معدّ
،من قشر القريدس ورقائق البونيتو

355
00:17:45,020 --> 00:17:48,180
.فوقها لحم خنزير مفروم وبصل أخضر مقطّع

356
00:17:48,180 --> 00:17:50,540
إنّها تُقدّم في زبديّات صغيرة
.تشبه أكواب الشّاي تقريبًا

357
00:17:50,870 --> 00:17:55,510
هنالك مقولة في تايوان تقول
."الأكل جيّدًا دون التّعب منه"

358
00:17:55,510 --> 00:17:58,760
.لهذا السّبب حجم الطّبق في المتناول

359
00:17:58,760 --> 00:18:03,390
إن كان عليّ تسمية هذا الطّبق، فسيكون
!"المعكرونة الشّبيهة بدانزي بأسلوب يوكيهيرا"

360
00:18:21,620 --> 00:18:24,450
!أتى الكثير من الزّبائن اليوم

361
00:18:24,450 --> 00:18:28,790
رغم أنّه لا يوجد ما يدعو للاحتفال
.بما أنّ كلّ شيء كان مجّانيًّا

362
00:18:29,970 --> 00:18:31,000
.أعتقد ذلك

363
00:18:31,000 --> 00:18:36,940
لكن ساورني نفس الشّعور عندما كنت أتجوّل مع
.أبي لبيع خبز الفلفل الأسود في مهرجان الصّيف

364
00:18:37,820 --> 00:18:39,220
نفس الشّعور؟

365
00:18:39,220 --> 00:18:43,270
في البداية، كان لدينا مجموعة من النّاس
.جلبهم الفضول بشأن الفرن الحجريّ

366
00:18:43,270 --> 00:18:46,420
ثمّ ردود أفعال الزّبائن الّذين جرّبوا
.خبزنا جلبت أشخاصًا أكثر

367
00:18:46,420 --> 00:18:49,990
وفي النّهاية، أمسى لدينا حشد ثابت
.من النّاس حول كشكنا

368
00:18:50,420 --> 00:18:53,190
،ذلك ما كنت أتمنّاه

369
00:18:53,530 --> 00:18:56,580
لكن نظرًا لتواجد مجموعة أبحاث
،الطّبخ الصّينيّ المبهرة أمامنا

370
00:18:56,580 --> 00:18:59,150
.فطبعًا ما كان الأمر ليسير بنفس الطّريقة

371
00:18:59,480 --> 00:19:02,620
.الفرن الحجريّ ليس وسيلة جذب كافية

372
00:19:02,620 --> 00:19:08,300
صحيح، وأظنّ أنّه من الممتع مشاهدة
،خبز الفلفل الأسود وهو يُطبخ

373
00:19:08,300 --> 00:19:11,010
،لكن ما لم ترى شخصًا آخر يأكله

374
00:19:11,010 --> 00:19:13,090
.يصبح من الصّعب تخيّل طعمه بالفعل

375
00:19:13,090 --> 00:19:13,960
.معك حقّ

376
00:19:14,390 --> 00:19:17,070
...أمّا طبخ سيشوان الّذي يقدّمه كوغا-سينباي

377
00:19:17,070 --> 00:19:20,680
.يسهل تخيّل مذاقه بمجرّد النّظر إليه

378
00:19:21,140 --> 00:19:26,470
يختلف مهرجان وليمة القمر عن الشّوكوغيكي
.حيث تذوّق الحكّام لطعامك مضمون

379
00:19:26,470 --> 00:19:32,630
هل علينا التّفكير في طبق جديد للقائمة
يضمّ نكهات يمكن للزّبائن تخيّلها؟

380
00:19:32,630 --> 00:19:35,530
أو ربّما شيء له تأثير جيّد بما يكفي

381
00:19:35,530 --> 00:19:38,690
قادر على جذب الزّبائن بعيدًا عن حرارة طعام
.مجموعة أبحاث الطّبخ الصّينيّ

382
00:19:39,310 --> 00:19:43,780
،إن تمكّنت من تقديم طبق كهذا
.فربّما قد نجد طريقة لتجاوز هذا الأمر

383
00:19:44,740 --> 00:19:45,740
!لقد أتاني الإلهام

384
00:19:46,230 --> 00:19:51,600
سوف نضع لحم البقر من الطّبق الرّئيسيّ
.في حمّام تحت الضّغط لساعتين

385
00:19:51,600 --> 00:19:56,210
ثمّ سنطبخ كلّ الخضروات في فرن بخار حِمل
.حراريّ للوصول لحرارة الطّبخ المثاليّة

386
00:19:56,560 --> 00:19:59,420
سنستعمل مزيج البهارات الّتي أعدّها
—هاياما-كُن لتتبيل كلّ شيء

387
00:19:59,420 --> 00:20:02,860
وبكم سنبيع كلّ هذا؟

388
00:20:02,860 --> 00:20:05,670
...حسنًا، لجني الأرباح

389
00:20:05,670 --> 00:20:07,160
.حوالي عشرين ألف ينّ

390
00:20:07,160 --> 00:20:08,010
!لا يمكننا بيعه

391
00:20:08,010 --> 00:20:09,390
!نحن في منطقة الشّارع الرّئيسيّ

392
00:20:09,390 --> 00:20:11,410
!لن نعرف ذلك ما لم نجرّبه

393
00:20:11,410 --> 00:20:12,370
!لا أوافق

394
00:20:12,370 --> 00:20:14,400
!يمكنني رؤية خسائرنا وهي تزداد

395
00:20:14,400 --> 00:20:16,980
!لكنّ ذلك كان ليصبح قصّة رائعة

396
00:20:16,980 --> 00:20:18,540
.لن يغيّر عبوسك من شيء

397
00:20:18,540 --> 00:20:19,900
.هذا مهرجان وليمة القمر

398
00:20:19,900 --> 00:20:22,870
إن كنت تريدين إعداد أيّ طعام
،كان دون مراعات الزّبائن

399
00:20:22,870 --> 00:20:24,530
!فاستسلمي من الآن

400
00:20:25,260 --> 00:20:26,550
.يا هاياما

401
00:20:26,550 --> 00:20:26,990
ماذا؟

402
00:20:26,990 --> 00:20:30,730
حاول أن تكون إيجابيًّا أكثر مع
.الآنسة عندما تتحدّث معها

403
00:20:30,730 --> 00:20:32,540
.حسّن مزاجها

404
00:20:32,540 --> 00:20:34,700
.ليس عليك أن تصدّق ما تقوله أنت

405
00:20:34,700 --> 00:20:38,100
كلّ هذا لأنّك ظللت تسمح
.لها بفعل ما تشاء

406
00:20:38,100 --> 00:20:39,830
—عليك أن تشعر بالمسؤوليّة

407
00:20:39,020 --> 00:20:41,010
.أسحب عرضي

408
00:20:41,010 --> 00:20:43,810
.الأمر كما قال هاياما-كُن

409
00:20:43,810 --> 00:20:49,350
لنعد للبداية ونفكّر في طبق سيرضي الزّبائن
.الوافدين لمهرجان وليمة القمر

410
00:20:50,010 --> 00:20:51,890
...ما العمل

411
00:20:51,890 --> 00:20:56,350
طبق يطغى على مجموعة أبحاث الطّبخ
الصّينيّ من ناحية التّأثير والشّكل؟

412
00:20:56,350 --> 00:21:00,290
،إضافة إلى طبقهم المميّز المابو توفو

413
00:21:00,290 --> 00:21:02,320
تملك مجموعة أبحاث الطّبخ الصّينيّ
.أطباقًا أخرى مخيفة

414
00:21:02,320 --> 00:21:04,300
.المابو توفو

415
00:21:05,210 --> 00:21:06,450
.أخبريني يا تادوكورو

416
00:21:06,450 --> 00:21:08,700
ما رأيك في مابو توفو مطعم يوكيهيرا؟

417
00:21:08,700 --> 00:21:09,430
ماذا؟

418
00:21:09,430 --> 00:21:11,990
.أعتقد أنّه كان لذيذًا

419
00:21:11,990 --> 00:21:13,660
،لكن إن أسعفتني الذّاكرة
...فقد وجدته ناكيري-سان

420
00:21:14,150 --> 00:21:16,870
.يفتقر طبقك لـ"ما"و"لا" بشكل كبير

421
00:21:16,870 --> 00:21:20,050
.نعم، قالت أنّني لن أفوز أبدًا

422
00:21:20,650 --> 00:21:24,870
لكنّ السّبب الّذي دفع مطعم يوكيهيرا
لكي لا يعد طبق مابو توفو حارًّا

423
00:21:24,870 --> 00:21:30,510
هو أنّ أبي أراد نكهات قد يستمتع
.بها كلّ الزّبائن الدّائمين

424
00:21:30,510 --> 00:21:35,520
قد يتجاوز كوغا-سينباي ذلك من
...ناحية النّكهات القويّة، لكن

425
00:21:36,020 --> 00:21:38,530
.ذلك لا يعني أنّ طبخ والدي كان أقلّ مستوى

426
00:21:38,530 --> 00:21:39,480
...نـ-نعم

427
00:21:40,250 --> 00:21:44,860
إن كان بإمكاني تحسين ذلك المابو توفو
،وإضافة بعض من أفكاري

428
00:21:45,310 --> 00:21:48,240
فأظنّ أنّنا سنجد طريقة للخروج
.من حالة الرّكود هذه

429
00:21:48,240 --> 00:21:50,830
لكن مثل ماذا؟

430
00:21:52,070 --> 00:21:54,440
.آسف يا تادوكورو

431
00:21:54,440 --> 00:21:57,540
.قد ينتهي بك المطاف بلا نوم من الآن فصاعدًا

432
00:21:58,360 --> 00:22:00,010
.هنالك أمر أريد تجربته

433
00:22:00,460 --> 00:22:02,880
طبق المابو توفو الخاصّ بيوكيهيرا الجديد

434
00:22:03,250 --> 00:22:05,840
!سيصيب قلب مطعم كوغا-سينباي

435
00:23:35,850 --> 00:23:38,050
.أنا جائعة

436
00:23:38,050 --> 00:23:38,990
.وأنا أيضًا

437
00:23:38,990 --> 00:23:42,310
أخبريني، هل تريدين تناول بعض لفائف
الكاراغي المميّزة لشارع سوميري؟

438
00:23:42,310 --> 00:23:43,820
!فكرة جيّدة

439
00:23:43,820 --> 00:23:44,870
!لنذهب

440
00:23:44,870 --> 00:23:45,860
!نعم

441
00:23:45,860 --> 00:23:46,520
ماذا؟

442
00:23:46,520 --> 00:23:49,170
.الأضواء منارة في مطعم يوكيهيرا

443
00:23:49,170 --> 00:23:50,330
!معك حقّ

444
00:23:50,330 --> 00:23:51,990
هل عاد يوكيهيرا؟

445
00:23:51,990 --> 00:23:53,950
عاد يوكيهيرا-كُن؟

446
00:24:03,920 --> 00:24:05,920
توتسكي

447
00:24:07,100 --> 00:24:10,920
!أتمنّى أن تكون الحلقة القادمة على ذوقكم