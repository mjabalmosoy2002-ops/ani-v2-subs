1
00:00:09,980 --> 00:00:12,170
!تحتاج جهة غرفة الطّعام إلى تعزيزات

2
00:00:12,490 --> 00:00:17,450
لن نسمح لكم بلمس هذا المسكن
!إلى أن يفوز يوكيهيرا بالشّوكوغيكي

3
00:00:17,450 --> 00:00:19,290
!لقد تجاوزوا حواجزنا

4
00:00:19,290 --> 00:00:22,080
!سُحقًا! سوف ينتهي أمرنا إن دخلوا

5
00:00:22,080 --> 00:00:23,040
.مهلاً

6
00:00:23,040 --> 00:00:24,530
.هنالك خطب ما

7
00:00:24,530 --> 00:00:26,380
إنّهم لا يستعجلون بالدّخول؟

8
00:00:29,340 --> 00:00:31,460
!لا أصدّق أنّ نظّاراتي انكسرت الآن بالتّحديد

9
00:00:37,250 --> 00:00:38,660
!ما الخطب يا مارويْ؟

10
00:00:38,660 --> 00:00:40,060
!ما-ماذا يحدث؟

11
00:00:40,370 --> 00:00:43,510
في الشّوكوغيكي الّذي دار بين
،يوكيهيرا سوما وإيزان إتسويا

12
00:00:43,510 --> 00:00:47,100
.فاز يوكيهيرا سوما بمجموع ثلاثة مقابل لا شيء

13
00:00:47,100 --> 00:00:49,610
...سوما-كُن فاز

14
00:00:47,100 --> 00:00:52,320
أعيد، في الشّوكوغيكي الّذي دار بين
...يوكيهيرا سوما وإيزان إتسويا

15
00:00:51,210 --> 00:00:52,320
!لكن كيف؟

16
00:00:54,090 --> 00:00:55,030
!يوكيهيرا

17
00:00:56,450 --> 00:00:59,830
لقد هزم بالفعل صاحب الرّتبة
...التّاسعة بين النّخبة العشرة

18
00:01:00,350 --> 00:01:02,830
كان إيزان ليأخذ الشّوكوغيكي بجدّيّة أكثر

19
00:01:02,830 --> 00:01:06,500
...إن كان قد راهن برتبته، لكن

20
00:01:06,830 --> 00:01:08,590
...يوكيهيرا سوما

21
00:01:10,780 --> 00:01:15,090
.مرحبًا يا إيشّيكي. أراك تعمل بجدّ على المعاملات الورقيّة

22
00:01:15,090 --> 00:01:16,720
لكن ألا تمانع كلّ هذا؟

23
00:01:17,100 --> 00:01:20,500
.يوشك مسكنك على أن يُغلق

24
00:01:20,500 --> 00:01:22,940
كيف يمكنك الجلوس دون حركة
رغم ما يحدث هنا؟

25
00:01:22,940 --> 00:01:25,100
.لن يُغلق مسكن النّجم القطبيّ

26
00:01:26,850 --> 00:01:29,250
يعرف سوما-كُن أنّ قيمة الطّاهي الحقيقيّة

27
00:01:29,700 --> 00:01:33,280
.لا يمكن قياسها إلاّ عن طريق طبخه

28
00:01:33,860 --> 00:01:36,010
.أعرف ما هو قادر عليه

29
00:01:36,010 --> 00:01:39,740
.سوف يتجاوز تحدّي إيزان المتلاعَب به بسهولة

30
00:01:40,140 --> 00:01:42,200
.بل إن ما سيأتي بعد ذلك هو الأكثر خطورة

31
00:01:42,200 --> 00:01:44,470
.حينها ستبدأ المعركة الحقيقيّة

32
00:01:44,470 --> 00:01:47,860
،عليّ القيام بالتّجهيزات الضّروريّة لذلك
.مهما كانت النّتيجة

33
00:01:49,290 --> 00:01:54,750
.يبدو أنّ الأمور تسير كما تخيّلها إيشّيكي تمامًا

34
00:01:55,590 --> 00:01:57,750
.لقد تمّ إلغاء الطّرد

35
00:01:57,750 --> 00:01:59,230
!أجل

36
00:01:59,230 --> 00:02:01,690
!رائع! إنّهم يغادرون

37
00:02:01,690 --> 00:02:03,010
!تستحقّون ذلك

38
00:02:03,010 --> 00:02:05,770
!مسكن النّجم القطبيّ آمن

39
00:02:21,060 --> 00:02:22,370
.لقد عدت

40
00:02:22,370 --> 00:02:23,870
!غبيّ

41
00:02:23,870 --> 00:02:26,480
!لقد قمتَ بتحدّي شوكوغيكي بمفردك

42
00:02:26,480 --> 00:02:28,280
!لم تتحدّث حتّى معنا

43
00:02:28,280 --> 00:02:29,750
!أنت متهوّر للغاية

44
00:02:29,750 --> 00:02:32,750
!أنت غبيّ وأبله ومغفّل

45
00:02:32,750 --> 00:02:36,010
.كنّا قلقين جميعًا

46
00:02:36,010 --> 00:02:39,130
.لكنّي سعيدة للغاية! أنا جادّة

47
00:02:39,130 --> 00:02:41,950
!شكرًا جزيلاً يا يوكيهيرا

48
00:02:45,030 --> 00:02:46,350
...سوما-كُن

49
00:02:46,750 --> 00:02:48,270
!أهلاً بعودتك

50
00:02:48,650 --> 00:02:49,520
!أجل

51
00:02:51,020 --> 00:02:54,230
لكن كيف هزمت إيزان إتسويا؟

52
00:02:54,230 --> 00:02:55,640
.لقد حدثت أمور كثيرة

53
00:02:55,640 --> 00:02:57,450
.ما زلت لا أصدّق الأمر

54
00:02:57,450 --> 00:02:58,460
ما قصّة هذه الخوذات؟

55
00:02:58,460 --> 00:03:01,030
...إنّها من العهد الذّهبيّ

56
00:03:01,030 --> 00:03:04,340
لنتحدّث عن ذلك لاحقًا
.ودعونا ندخل المسكن الآن

57
00:03:04,340 --> 00:03:05,050
!أجل

58
00:03:05,050 --> 00:03:08,270
!علينا الاحتفال بتمكّننا من إنقاذ مسكننا

59
00:04:40,580 --> 00:04:42,990
!هنيئًا لنا

60
00:04:47,710 --> 00:04:49,880
.أحسنت يا يوكيهيرا

61
00:04:49,880 --> 00:04:51,720
!شكرًا لك يا أراتو

62
00:04:52,050 --> 00:04:53,290
!يوكيهيرا

63
00:04:53,290 --> 00:04:54,850
!كنت أشاهد تحدّي الشّوكوغيكي

64
00:04:54,850 --> 00:04:56,890
.تاكومي-تشي، إيسامي-تشي

65
00:04:56,890 --> 00:04:59,230
.تاكومي-كُن في مزاج المحاضرات المعتاد خاصّته

66
00:04:59,230 --> 00:05:01,980
...تذمّر، تذمّر، تذمّر، تذمّر

67
00:05:02,470 --> 00:05:03,380
ماذا؟

68
00:05:03,380 --> 00:05:04,470
لستَ غاضبًا عليه؟

69
00:05:04,470 --> 00:05:05,780
لا محاضرات؟

70
00:05:05,780 --> 00:05:07,200
.لم يكن لديه خيار آخر

71
00:05:07,200 --> 00:05:10,480
.كان مسكنكم تحت التّهديد

72
00:05:10,480 --> 00:05:12,160
.حتّى أنا كنت لأقوم بالمِثل

73
00:05:12,160 --> 00:05:13,610
...تاكومي-كُن

74
00:05:13,610 --> 00:05:15,610
.مرحبًا يا ناكيري-سان

75
00:05:16,760 --> 00:05:18,630
.كنتِ في مسكن النّجم القطبيّ بالفعل

76
00:05:18,630 --> 00:05:21,340
.مـ-مرحبًا أيّها الأخوان ألديني

77
00:05:21,340 --> 00:05:24,780
!حسنًا، هذه ليلة الاحتفال

78
00:05:24,780 --> 00:05:26,910
!عليكما الأكل قبل أن تذهبا

79
00:05:28,050 --> 00:05:30,860
.لقد أنهى تحدّيًا صعبًا للغاية للتّوّ

80
00:05:30,860 --> 00:05:33,310
.لقد تخلّص من كلّ ذلك التّوتّر

81
00:05:33,310 --> 00:05:35,980
.لكنّك كنت رائعًا يا يوكيهيرا

82
00:05:35,980 --> 00:05:38,730
.لقد سحقت صاحب الرّتبة التّاسعة في شوكوغيكي

83
00:05:38,730 --> 00:05:42,900
هذا يعني أنّك قد تفوز حتّى في مواجهة
.ناكيري-تشان صاحبة الرّتبة العاشرة

84
00:05:42,900 --> 00:05:43,390
!ماذا؟

85
00:05:43,390 --> 00:05:45,050
!لا تكن سخيفًا! يا للفظاظة

86
00:05:45,050 --> 00:05:47,110
ومن هذه الّتي تدعوها ناكيري-تشان؟

87
00:05:47,110 --> 00:05:47,890
ماذا؟

88
00:05:47,890 --> 00:05:50,530
.لكنّك تسمحين ليوشينو بمناداتك إرينا-تشي

89
00:05:50,530 --> 00:05:51,820
!لا تستعمل "تشان" معي

90
00:05:51,820 --> 00:05:53,700
!لا يوجد أيّ وقار فيها

91
00:05:53,700 --> 00:05:55,170
!نعم، نعم

92
00:05:55,170 --> 00:05:58,290
كما أنّ إرينا-ساما في الرّتبة العاشرة
.بسبب انشغالاتها

93
00:05:58,290 --> 00:06:00,140
—إنّ قدراتها الحقيقيّة تضعها في مستوى أعلى

94
00:05:59,210 --> 00:06:03,170
حسنًا، كنت أنا من اقترح موضوع
.ذلك الشّوكوغيكي

95
00:06:03,630 --> 00:06:06,290
رغم أنّ إيزان-سينباي قد قرّر ما
،سيطبخه في منتصف التّحدّي

96
00:06:06,290 --> 00:06:08,180
.استطاع مع ذلك إعداد شيء مثير للاهتمام

97
00:06:08,550 --> 00:06:11,550
.أريد مواجهته تحت ظروف متساوية

98
00:06:11,550 --> 00:06:13,490
.لم يكن نصرًا مُرضيًا إذًا

99
00:06:14,020 --> 00:06:15,310
!أفهمك يا يوكيهيرا

100
00:06:15,310 --> 00:06:20,190
بالتّفكير بالأمر الآن، ماذا يحدث مع بقيّة
المجموعات الأخرى المهدّدة بالإغلاق؟

101
00:06:20,530 --> 00:06:22,520
.ما زالوا في وضع لا يحسدون عليه

102
00:06:23,330 --> 00:06:26,400
.لكن بفضلك يا سوما-كُن، تحسّن الوضع قليلاً

103
00:06:26,400 --> 00:06:28,340
!إ-إيشّيكي-سينباي

104
00:06:28,340 --> 00:06:29,860
!أين كنت؟

105
00:06:29,860 --> 00:06:31,550
.آسف يا رفاق

106
00:06:31,550 --> 00:06:33,990
.أنا عضو في النّخبة العشرة قبل كلّ شيء

107
00:06:34,560 --> 00:06:36,700
كنت قلقًا من أنّي إن فعلت أيّ شيء
،من أجل المسكن بشكل مستعجل

108
00:06:36,700 --> 00:06:40,620
.كانت إدارة أزامي لتزيد من حدّة الأمر علينا

109
00:06:40,970 --> 00:06:44,490
.لقد كنت أتساءل إن كنت قد خنتنا يا إيشّيكي-سينباي

110
00:06:44,490 --> 00:06:46,260
.نعم، ما كان ذلك ليفاجئني

111
00:06:46,260 --> 00:06:47,390
!ماذا؟

112
00:06:47,390 --> 00:06:49,130
كيف يعقل أن تفكّروا هكذا؟

113
00:06:49,440 --> 00:06:54,850
!ألا تفهمون كم أحبّ مسكن النّجم القطبيّ؟

114
00:06:56,140 --> 00:06:57,570
...المعذرة يا إيشّيكي-سان

115
00:06:57,570 --> 00:06:59,600
كيف تحسّن الأمر؟

116
00:06:59,600 --> 00:07:00,600
.صحيح

117
00:07:00,600 --> 00:07:02,770
،بعد معرفة نتائج الشّوكوغيكي

118
00:07:02,770 --> 00:07:05,070
.قامت إدارة أزامي بتقديم إعلان جديد

119
00:07:05,460 --> 00:07:09,780
وافق المركز على قبول تحدّيات
الشوكوغيكي من منظّمة

120
00:07:09,780 --> 00:07:11,910
.تحاول إبطال قرار الإيقاف

121
00:07:11,910 --> 00:07:16,120
وطبعًا سيكون الشّوكوغيكي
!رسميًّا وبحكاّم محايدين

122
00:07:16,670 --> 00:07:20,830
لكنّ هذا لا يغيّر حقيقة أنّ الأكاديميّة
،ما تزال تحت سيطرة المركز

123
00:07:21,290 --> 00:07:24,290
لكنّ طريقة تلاعب إيزان-كُن
.في التّحدّيات قد توقّفت

124
00:07:24,290 --> 00:07:26,330
!لقد جعلت ذلك يحدث يا سوما-كُن

125
00:07:26,330 --> 00:07:28,760
!لقد أعدت الحياة للشّوكوغيكي

126
00:07:28,760 --> 00:07:32,720
.شكرًا لك يا سوما-كُن على إنقاذ منزلنا

127
00:07:32,720 --> 00:07:34,940
.لا داعي لتشكرني

128
00:07:34,940 --> 00:07:37,180
.هذا المكان مهمّ لي أيضًا

129
00:07:37,540 --> 00:07:40,930
.شكرًا لكم جميعًا لحمايتكم المسكن أيضًا

130
00:07:41,440 --> 00:07:43,900
.حسنًا، كفانا حديثًا جادًّا

131
00:07:44,290 --> 00:07:46,730
!لنستمتع ببقيّة الأمسية فحسب

132
00:07:46,730 --> 00:07:48,570
!أجل

133
00:07:48,570 --> 00:07:50,220
!ما-ماذا؟

134
00:07:50,220 --> 00:07:51,970
!إنّه عارٍ ولا يرتدي سوى المئزر؟

135
00:07:51,970 --> 00:07:52,530
!عارٍ؟

136
00:07:52,530 --> 00:07:53,780
!لكن يرتدي مئزرًا؟

137
00:07:53,780 --> 00:07:54,530
!كم هذا فاحش

138
00:07:54,980 --> 00:07:56,470
!لا تنظري

139
00:07:56,470 --> 00:07:58,490
!أشيحي نظرك يا إرينا-ساما

140
00:08:02,410 --> 00:08:05,030
،هذه ليست أوّل مرّة أرى فيها ذلك
.لكن ما زال الأمر يترك انطباعًا

141
00:08:05,030 --> 00:08:08,100
لن يكون مسكنَ النّجم القطبيّ
.دون حدوث ذلك على ما أظنّ

142
00:08:08,920 --> 00:08:12,880
!هيّا! هيّا

143
00:08:09,390 --> 00:08:12,880
ما الّذي يحدث مع قاطني هذا المسكن؟

144
00:08:13,290 --> 00:08:16,180
!إنّهم لا يمانعون أبدًا كونه عاريًا ولا يرتدي إلاّ مئزرًا

145
00:08:16,630 --> 00:08:19,180
.هذا المسكن غريب بالفعل

146
00:08:19,180 --> 00:08:20,570
!بالطّبع

147
00:08:20,570 --> 00:08:22,180
.كلاّ، بل تجاوز الغرابة

148
00:08:22,180 --> 00:08:22,990
!تجاوزها كثيرًا

149
00:08:22,990 --> 00:08:24,440
!كثيرًا! كثيرًا! كثيرًا

150
00:08:24,440 --> 00:08:25,770
إرينا-ساما؟

151
00:08:26,180 --> 00:08:29,280
هيساكو، هل تعرفين كيف تستعملين الغسّالة؟

152
00:08:29,280 --> 00:08:31,770
الـ-الغسّالة؟

153
00:08:31,770 --> 00:08:33,810
.نعم، أعرف

154
00:08:33,810 --> 00:08:34,950
.فهمت

155
00:08:34,950 --> 00:08:39,330
من المثير للإعجاب أنّك تستطيعين
.استعمال آلة تملك كلّ تلك الأزرار

156
00:08:39,330 --> 00:08:40,790
عفوًا يا إرينا-ساما؟

157
00:08:40,790 --> 00:08:43,530
!على أيّ حال، انسي أمر الغسّالة

158
00:08:43,530 --> 00:08:47,420
أنا أحاول فقط أن أقول أنّ ثمّة
أمورًا وأشياء غريبة كثيرة

159
00:08:47,420 --> 00:08:49,280
لم تكن لي أدنى فكرة عنها قبل
!أن آتي إلى هذا المسكن

160
00:08:49,280 --> 00:08:50,250
.صـ-صحيح

161
00:08:50,640 --> 00:08:53,070
.إنّهم أشخاص غريبون للغاية بالفعل

162
00:08:53,070 --> 00:08:57,010
.ويوكيهيرا-كُن في مركزهم

163
00:08:57,690 --> 00:09:00,050
،عندما كان مسكن النّجم القطبيّ محاصرًا

164
00:09:00,050 --> 00:09:07,450
بدا أنّهم واثقون أنّ يوكيهيرا-كُن
.سيكون قادرًا على القيام بمعجزة

165
00:09:08,190 --> 00:09:10,650
.وأنت كذلك يا هيساكو

166
00:09:11,660 --> 00:09:12,610
أنا أيضًا؟

167
00:09:13,180 --> 00:09:17,610
بدوت وكأنّك تعرفين أنّ يوكيهيرا-كُن
.سيتمكّن من فعل شيء ما

168
00:09:18,080 --> 00:09:20,620
لماذا بدوتِ كذلك؟

169
00:09:20,620 --> 00:09:22,920
...أ-أنا، لقد

170
00:09:22,920 --> 00:09:24,310
ماذا يمكنني أن أقول؟

171
00:09:24,310 --> 00:09:26,120
.لم يكن لي أيّ سبب لأشعر كذلك

172
00:09:26,580 --> 00:09:29,130
...لكن راودني إحساس بحدوث ذلك

173
00:09:29,130 --> 00:09:32,630
ربّما الشّخص الّذي سينقذ
توتسكي من أزامي-دونو

174
00:09:33,330 --> 00:09:36,590
.هو ذلك الرّجل

175
00:09:40,050 --> 00:09:42,020
...ناكيري-كُن، أراتو-كُن

176
00:09:42,020 --> 00:09:44,010
!عليكما الانضمام لنا أيضًا

177
00:09:45,090 --> 00:09:46,660
!ارتدِ بعض الملابس من فضلك

178
00:09:46,660 --> 00:09:47,550
.لا بأس

179
00:09:47,550 --> 00:09:49,140
!سيكون الوضع مريحًا بمجرّد أن تعتادي عليه

180
00:09:49,140 --> 00:09:50,530
!لا أرى منطقًا حتّى في كلامك ذلك

181
00:09:50,530 --> 00:09:51,130
!هيّا

182
00:09:52,500 --> 00:09:55,510
صاحب الرّتبة السّابعة بين النّخبة
.العشرة، إيشّيكي ساتوشي

183
00:09:56,110 --> 00:10:00,280
اليوم، ستتخلّى عن رتبتك في مجلس
،النّخبة العشرة لتوتسكي

184
00:10:00,670 --> 00:10:03,240
إلى جانب صاحب الرّتبة الثّالثة ميغيشيما توسكي

185
00:10:03,240 --> 00:10:05,750
.وصاحب الرّتبة الثّامنة كوغا تيرونوري

186
00:10:06,130 --> 00:10:08,210
.حدث هذا بشكل أسرع ممّا ظننت

187
00:10:08,550 --> 00:10:10,830
.وأنت أكثر هدوءًا ممّا ظننت

188
00:10:10,830 --> 00:10:13,880
.كنت أتوقّع هذا بكلّ تأكيد

189
00:10:13,880 --> 00:10:16,100
،إنّ من لا يخضع لتعاليم المركز، مثلي أنا

190
00:10:16,100 --> 00:10:18,800
سيكون مجرّد عائق في النّخبة العشرة، صحيح؟

191
00:10:19,130 --> 00:10:21,010
.من المفيد أنّك لا تحتاج للكثير من التّفسير

192
00:10:21,670 --> 00:10:24,470
.لقد وافق بقيّة أعضاء النّخبة العشرة أيضًا

193
00:10:24,470 --> 00:10:27,620
لكن لماذا؟ لماذا؟

194
00:10:27,620 --> 00:10:31,160
لا أعتقد أنّ علينا طردهم خارج
النّخبة العشرة؟ لماذا؟

195
00:10:31,160 --> 00:10:34,940
.حسنًا، كانت كوباياشي ريندو الوحيدة الّتي عارضت

196
00:10:34,940 --> 00:10:39,400
لن تجبر ابنتك ناكيري إرينا على الانسحاب، صحيح؟

197
00:10:39,400 --> 00:10:42,370
.سوف تعود إليّ في النّهاية

198
00:10:42,770 --> 00:10:46,910
.أنا واثق أنّها ستنضمّ إليّ في مسعاي

199
00:10:47,410 --> 00:10:50,370
.والآن، سنكون مشغولين للغاية بفضلك

200
00:10:50,780 --> 00:10:52,380
بالشّوكوغيكي؟

201
00:10:52,380 --> 00:10:53,440
.نعم

202
00:10:53,440 --> 00:10:56,270
لقد عملت من خلف الكواليس
واتّصلت لأشخاص ذوي صلة

203
00:10:56,270 --> 00:10:59,010
لوضع أسس هذه القواعد الجديدة
.الّتي علينا اتّباعها

204
00:10:59,010 --> 00:11:03,430
علينا السّماح للمنظّمات الّتي تنوي
إبطال أمر الإيقاف

205
00:11:04,250 --> 00:11:08,140
.بأن تواجه جنودي من المركز، فخري وفرحتي

206
00:11:08,860 --> 00:11:16,310
القواعد المتعلّقة بالشّوكوغيكي حول
،المنظّمات المعارضة لمنظّمة أزامي

207
00:11:16,310 --> 00:11:18,190
."المعروفة أيضًا بـ"قواعد إيشّيكي

208
00:11:18,540 --> 00:11:21,090
من يسمّي الأشياء على اسمه؟

209
00:11:21,090 --> 00:11:22,070
.هذا مزعج نوعًا ما

210
00:11:22,070 --> 00:11:27,070
ومع ذلك، ولأنّ إيشّيكي قد وضّح أنّ المركز
،لا يستطيع الاتّصال بالحكّام

211
00:11:27,070 --> 00:11:29,770
.فقد تمّ تأكيد شرعيّة حكمهم

212
00:11:30,580 --> 00:11:34,760
وبالطّبع، كنت أعارض التّحدّيّات
.المتلاعب فيها من الأساس

213
00:11:34,760 --> 00:11:37,410
هنالك بند يُلزم المركز بقبول أيّ تحدّي شوكوغيكي

214
00:11:37,410 --> 00:11:41,470
.حول إبطال قرار إغلاق منظّمة ما أيضًا

215
00:11:41,470 --> 00:11:44,430
.كان إيشّيكي شاملاً في قوانينه

216
00:11:45,700 --> 00:11:49,550
كما أنّ هذا مزعج لأنّه يفرض علينا
.أن نواجه خصومًا أقل مستوى

217
00:11:49,550 --> 00:11:52,300
.حللتُ الأولى في مبيعات مهرجان وليمة القمر

218
00:11:52,300 --> 00:11:54,400
عليهم أن يعلنوا فوز المركز غيابيًّا
.في كلّ مرة لا غير

219
00:11:54,400 --> 00:11:57,020
.عليك قبول هذا وحسب يا مومو-سينباي

220
00:11:57,020 --> 00:12:01,530
.كما عليك ارتداء شعار المركز يا ريندو-سينباي

221
00:12:01,530 --> 00:12:02,810
فعلاً؟

222
00:12:02,810 --> 00:12:05,410
.لكن يبدو أنّه سيكون مزعجًا

223
00:12:05,410 --> 00:12:06,740
.لا تجيبيني بـ"فعلاً" رجاءً

224
00:12:06,740 --> 00:12:07,890
...لكن

225
00:12:07,890 --> 00:12:09,390
.ولا بـ"لكن" أيضًا لو سمحت

226
00:12:09,830 --> 00:12:10,620
.حسنًا

227
00:12:10,980 --> 00:12:14,770
على بقيّتكم أيضًا أن يضعوا شعارهم
.قبل أن تغضب عليكم نيني

228
00:12:15,690 --> 00:12:17,170
.لا داعي لإخباري بذلك مرّتين

229
00:12:21,130 --> 00:12:24,010
.حسنًا، لنواصل العمل إذًا

230
00:12:24,370 --> 00:12:26,890
.حان الوقت لنبدأ صيد النّاجين

231
00:12:29,030 --> 00:12:30,430
صيد النّاجين؟

232
00:12:30,430 --> 00:12:33,730
هذا ما ينعت به المركز تحدّيّات الشّوكوغيكي

233
00:12:33,730 --> 00:12:35,940
.مع المنظّمات الّتي تسعى للنّجاة

234
00:12:36,270 --> 00:12:37,900
.ستجري المجموعة الأولى اليوم

235
00:12:38,930 --> 00:12:40,620
.إنّهم لا يحاولون حتّى تلطيف الأمر

236
00:12:40,620 --> 00:12:43,610
.سيشارك التّلاميذ من المركز في التّحدّيّات

237
00:12:43,610 --> 00:12:44,390
.نعم

238
00:12:44,390 --> 00:12:46,070
،سيشارك أعضاء النّخبة المساندون لأزامي بكّل تأكيد

239
00:12:46,510 --> 00:12:49,770
والبقيّة عبارة عن تلاميذ بارعين يمكن
.أن نصفهم باحتياطيّي النّخبة العشرة

240
00:12:50,890 --> 00:12:52,540
احتياطيّو النّخبة العشرة؟

241
00:12:53,100 --> 00:12:55,150
.أريد التّحقّق منهم

242
00:12:55,870 --> 00:12:57,840
.من الأفضل ألاّ تفكّر في القيام بأمر ما ثانية

243
00:12:57,840 --> 00:12:59,750
!لا مزيد من المبادرات وحدك

244
00:12:59,750 --> 00:13:02,760
.إن كنت ستشاهد الشّوكوغيكي، فسأرافقك

245
00:13:02,760 --> 00:13:05,760
!سأكون قلقًا كثيرًا إن تركتك تذهب وحدك

246
00:13:05,760 --> 00:13:08,150
.أعتقد أنّه لا بأس بذهاب تاكومي-تشي معه

247
00:13:08,150 --> 00:13:11,680
.إنّه في المسكن دائمًا

248
00:13:09,100 --> 00:13:11,680
.أجل، لنذهب

249
00:13:09,100 --> 00:13:11,680
هذا لدواعٍ استكشافيّة فحسب، مفهوم؟

250
00:13:11,680 --> 00:13:13,570
!أ-أريد الذّهاب أيضًا

251
00:13:13,570 --> 00:13:16,480
أنا واثقة أنّ مجموعة أبحاث الطّبخ المحلّيّ
.ستخوض تحدّي شوكوغيكي أيضًا

252
00:13:16,480 --> 00:13:20,080
صحيح. مجموعة أبحاث ميازاتو
.ستقاتل نفس الخصم أيضًا

253
00:13:20,080 --> 00:13:21,850
.مشاهدة التّحدّيّات لن تكون مضيعة للوقت

254
00:13:21,850 --> 00:13:24,980
.يفترض أنّ هنالك ثلاثة قاعات منفصلة

255
00:13:24,980 --> 00:13:27,450
.إذًا يمكننا الانفصال ومشاهدتها جميعها

256
00:13:27,780 --> 00:13:28,360
!أجل

257
00:13:28,360 --> 00:13:29,410
.لنفعل ذلك

258
00:13:31,140 --> 00:13:33,440
."حسنًا، سنذهب نحن للقاعة "أ

259
00:13:33,440 --> 00:13:34,290
!لنبذل جهدنا

260
00:13:34,710 --> 00:13:37,110
!"وسنذهب نحن للقاعة "ب

261
00:13:37,110 --> 00:13:39,900
.سأكون قلقة على إرينا-ساما في غيابنا

262
00:13:39,900 --> 00:13:41,810
.ستكون ناكيري-تشان بخير

263
00:13:41,810 --> 00:13:43,130
.فوميو-سان موجودة هنا أيضًا

264
00:13:43,130 --> 00:13:43,760
!أنت

265
00:13:43,760 --> 00:13:44,970
!"لا تنادها "ناكيري-تشان

266
00:13:44,970 --> 00:13:45,840
.آ-آسف

267
00:13:46,350 --> 00:13:47,460
!حسنًا

268
00:13:47,460 --> 00:13:49,180
!"سنذهب للقاعة "ج

269
00:13:49,590 --> 00:13:52,660
يوكيهيرا، مهمّة اليوم لأغراض
استكشافيّة فحسب، مفهوم؟

270
00:13:52,660 --> 00:13:53,810
.لا تبالغ في الأمر

271
00:13:54,130 --> 00:13:55,680
.أعلم، أعلم

272
00:14:04,530 --> 00:14:06,900
،سواء كان هذا صيد النّاجين أم لا

273
00:14:06,900 --> 00:14:10,620
لن أسمح لأيّ شيء بتشتيت انتباهي عن
.إنصاف هذا التّحدّي ما دمت قيد الحياة

274
00:14:10,620 --> 00:14:14,330
.نعم، مسؤوليّتنا هي منح حكم عادل

275
00:14:14,910 --> 00:14:17,360
!يا للجموع

276
00:14:17,360 --> 00:14:21,280
لنرى، هذا التّحدّي يجمع صاحبة
الرّتبة الرّابعة أكانيغاكوبو-سينباي

277
00:14:21,280 --> 00:14:22,460
.ومجموعة أبحاث الشّوكولاطة

278
00:14:22,460 --> 00:14:25,920
هنالك تحدّي يجمع أيضًا بين إيزان-سينباي
.ومجموعة المطبخ الغربيّ

279
00:14:26,270 --> 00:14:29,890
يبدو أنّه ستجري العديد من تحدّيّات
.الشّوكوغيكي في وقت واحد في كلّ قاعة

280
00:14:29,890 --> 00:14:32,500
مجموعة أبحاث الدّون ليست هنا؟

281
00:14:32,500 --> 00:14:34,390
وهاياما من مجموعة أبحاث
.شيومي ليس هنا أيضًا

282
00:14:34,740 --> 00:14:36,380
.لنبدأ يا بوتشي

283
00:14:36,380 --> 00:14:38,410
.ساعدني في الطّبخ

284
00:14:50,180 --> 00:14:51,150
.حسنًا

285
00:14:51,150 --> 00:14:52,490
.أتمنّى أنّها خُبزت كما يجب

286
00:14:52,860 --> 00:14:55,430
لقد نزعت يدي دبّها المحشوّ
...لتستعملهما كقفّازات فرن

287
00:14:55,430 --> 00:14:57,180
هل هنالك معنى ما من هذا قد فاتني؟

288
00:14:57,180 --> 00:14:59,830
تقول الشّائعات أنّها تفعل ذلك
.في كلّ مرة تطبخ فيها

289
00:15:00,750 --> 00:15:02,870
.إنّها تعمل بسرعة كما هو متوقّع

290
00:15:02,870 --> 00:15:05,870
.قيل أنّها أفضل حلوانيّة في أكاديميّة توتسكي

291
00:15:05,870 --> 00:15:11,130
الكعكة الّتي أكلناها في جلسة مشاهدة
.أوراق الخريف كانت لذيذة للغاية أيضًا

292
00:15:11,700 --> 00:15:12,970
.انتهيت

293
00:15:12,970 --> 00:15:14,350
.يا للجمال

294
00:15:14,350 --> 00:15:15,930
لكن ماذا عن المذاق؟

295
00:15:19,370 --> 00:15:25,380
أكانيغاكوبو مومو وإيزان إتسويا
.قد حقّق كلاهما فوزًا ساحقًا

296
00:15:25,900 --> 00:15:27,070
...مذهل

297
00:15:27,070 --> 00:15:29,150
.فوق ساحق للمركز

298
00:15:29,150 --> 00:15:30,360
...هكذا إذًا

299
00:15:30,810 --> 00:15:32,310
.أريد أن أواجههما

300
00:15:32,310 --> 00:15:33,600
!سوما-كُن

301
00:15:33,600 --> 00:15:35,440
،يوكيهيرا، أعرف أنّي سأبدو ملحًّا

302
00:15:35,440 --> 00:15:37,180
.لكنّ مهمّة اليوم لأسباب استكشافيّة فحسب

303
00:15:37,180 --> 00:15:38,780
—لا يمكنك أن تتحدّاهما

304
00:15:38,780 --> 00:15:40,790
.أعلم، أعلم

305
00:15:40,790 --> 00:15:42,750
...يوكيهيرا

306
00:15:43,140 --> 00:15:46,630
.بالتّفكير بالأمر، لم أر طبق تخصّص إيزان-سينباي بعد

307
00:15:46,990 --> 00:15:50,300
في المرّة القادمة، لنوفّر لكلينا وقتًا أكثر
.للاستعداد والمشاركة في الشّوكوغيكي

308
00:15:50,300 --> 00:15:52,010
.يومًا ما بالتّأكيد

309
00:15:52,010 --> 00:15:53,510
!وغد

310
00:15:53,510 --> 00:15:56,230
...سوف تدفع الثّمن

311
00:15:56,230 --> 00:15:59,430
.سأجعلك تندم على إهانتي

312
00:15:59,430 --> 00:16:01,310
.أراك في مزاج سيّئ

313
00:16:01,310 --> 00:16:04,690
ألا يفترض بك أن تكون جيّدًا كفاية
لتكون عضوًا من النّخبة العشرة؟

314
00:16:05,060 --> 00:16:07,270
.حسنًا، سنتكفّل بالأمر من هنا

315
00:16:07,270 --> 00:16:09,460
.دعنا نهتمّ ببقيّة الشوكوغيكي

316
00:16:09,460 --> 00:16:12,610
.لقد خسرت أمام تلميذ من السّنة الأولى يا إيزان-كُن

317
00:16:14,970 --> 00:16:18,830
،هؤلاء هم رجال المركز
.اختارهم ناكيري أزامي بنفسه

318
00:16:19,330 --> 00:16:22,220
.إنّهم الآن جزء من الفصيل الّذي يسيطر على توتسكي

319
00:16:22,790 --> 00:16:25,940
أنتم لا تمانعون على الإطلاق أنّنا من يختار الموضوع؟

320
00:16:25,940 --> 00:16:26,810
.نعم

321
00:16:26,810 --> 00:16:31,130
.سوف نتنافس معكم بأطباق تختصّون بها

322
00:16:31,130 --> 00:16:36,260
سوف نسحقكم في نفس الموضوع الّذي
.كنتم تحاولون صقل مهاراتكم فيها

323
00:16:36,260 --> 00:16:38,170
.هذا يظهر ذوقًا متدنّيًا

324
00:16:38,170 --> 00:16:40,820
.أنتم تحاولون العبث معهم فحسب

325
00:16:41,900 --> 00:16:46,230
.لكنّ ذلك يجعل الفوز أحلى أكثر يا مومو-سينباي

326
00:16:46,230 --> 00:16:48,480
.استخفّوا بنا بقدر ما تشاؤون

327
00:16:48,480 --> 00:16:52,360
لكنّنا كنّا نحسّن من موهبتنا
.في توتسكي طوال هذا الوقت

328
00:16:52,690 --> 00:16:54,320
!لن يكون الأمر بتلك السّهولة

329
00:17:01,700 --> 00:17:03,540
.والآن، اختر

330
00:17:03,920 --> 00:17:06,700
،هل ستغلقون مجموعة أبحاثكم

331
00:17:06,700 --> 00:17:09,500
أم هل ستُطرد من توتسكي؟

332
00:17:11,270 --> 00:17:13,170
.نختار الإغلاق

333
00:17:14,730 --> 00:17:16,820
.جميعكم بلا قيمة

334
00:17:16,820 --> 00:17:19,850
أتفهمون الآن؟

335
00:17:19,850 --> 00:17:22,310
.لم يتمّ اختياركم

336
00:17:22,310 --> 00:17:24,110
!لذلك عليكم أن تنصاعوا

337
00:17:24,110 --> 00:17:25,770
!هذا الخيار الأصحّ

338
00:17:25,770 --> 00:17:29,230
الانحناء لنا نحن أعضاء المركز

339
00:17:29,640 --> 00:17:32,480
!هو الطّريق الوحيد المتبقّي لكم

340
00:17:32,970 --> 00:17:34,690
!لا أستطيع السّماح بذلك

341
00:17:32,970 --> 00:17:34,690
.لا أستطيع السّماح بذلك

342
00:17:35,840 --> 00:17:36,400
ماذا؟

343
00:17:37,420 --> 00:17:39,620
هل قلتما شيئًا يا تلميذا السّنة الأولى؟

344
00:17:39,620 --> 00:17:43,160
...قلنا أنّنا لن نسمح لكم

345
00:17:43,160 --> 00:17:45,330
.أن تخبرونا ما مدى قيمتنا

346
00:17:45,330 --> 00:17:48,540
ليس سوما-كُن فحسب، بل حتّى
.تاكومي-كُن لم يستطع كبح نفسه

347
00:17:48,540 --> 00:17:51,020
،أنت تلميذ السّنة الأولى الّذي هزم إيزان

348
00:17:51,020 --> 00:17:54,380
.وأنت واحد من التّلاميذ من انتخابات الخريف

349
00:17:54,380 --> 00:17:57,410
.لا أنصحكما بالحديث هكذا معي

350
00:17:57,410 --> 00:18:00,980
أنا من النّخبة الّتي ستضع الجيل
.التّالي للطّهاة على أكتافها

351
00:18:00,980 --> 00:18:01,970
النّخبة؟

352
00:18:01,970 --> 00:18:03,060
.هذا صحيح

353
00:18:03,060 --> 00:18:06,600
أنا من النّخبة وتمّ اختياري من طرف
.مدير الأكاديميّة الحاليّ

354
00:18:07,340 --> 00:18:09,810
.ليس عليكما أن تقفا في وجهي

355
00:18:09,810 --> 00:18:12,450
.لا أشعر بأيّ حسّ للهويّة منك

356
00:18:13,070 --> 00:18:15,790
تأكيدك القويّ على كونك مختارًا

357
00:18:15,790 --> 00:18:19,330
يبدو لي كانعكاس لاحترام الذّات
.المنخفض الذي كنت تواجهه سلفًا

358
00:18:19,330 --> 00:18:23,470
هل عدم قدرتك على تفادي وصف نفسك بالنّخبة

359
00:18:23,470 --> 00:18:26,660
راجع لافتقارك للثّقة في طبخك؟

360
00:18:28,420 --> 00:18:30,860
.قلتَ كلامًا ذكيًّا يا تاكومي

361
00:18:30,860 --> 00:18:32,750
هل هذا صحيح يا سينباي؟

362
00:18:33,200 --> 00:18:34,960
!وغدان

363
00:18:34,960 --> 00:18:37,720
—سوف أوسعكما ضربًا

364
00:18:38,170 --> 00:18:40,860
.إيّاك وإساءة التّصرّف

365
00:18:40,860 --> 00:18:41,740
!شيغي

366
00:18:41,740 --> 00:18:43,140
!أنزلني! الآن

367
00:18:43,140 --> 00:18:44,460
.لن أنزلك

368
00:18:44,460 --> 00:18:46,510
!حسنًا، سأفعل ما تقول

369
00:18:46,510 --> 00:18:47,740
!سأفعل! أنزلني

370
00:18:47,740 --> 00:18:48,940
!لا تحملني هكذا

371
00:18:49,390 --> 00:18:52,410
.كم تسهل إغاظتك يا رين-تشان

372
00:18:52,410 --> 00:18:53,270
!اخرسي يا ميا

373
00:18:53,270 --> 00:18:54,790
!اسمعا يا تلميذا السّنة الأولى

374
00:18:54,790 --> 00:18:58,180
!سوف أقاتلكما في تحدٍّ يومًا ما

375
00:18:58,750 --> 00:19:00,660
.اذهب فحسب

376
00:19:00,660 --> 00:19:03,390
!احرص على الفوز بالتّحدّي الأخير أيضًا

377
00:19:04,160 --> 00:19:07,410
سوف يشارك في تحدٍّ آخر؟

378
00:19:07,410 --> 00:19:09,410
من يواجه؟

379
00:19:11,880 --> 00:19:13,310
!ناكيري أليس؟

380
00:19:13,310 --> 00:19:14,590
!كوروكيبا

381
00:19:14,590 --> 00:19:17,210
!هذا أنتما. مرحبًا

382
00:19:17,210 --> 00:19:18,940
لماذا أنتما هنا؟

383
00:19:18,940 --> 00:19:20,720
هل انضممتما لمجموعة أبحاث؟

384
00:19:20,720 --> 00:19:22,720
!لقد صُدمت أيضًا

385
00:19:22,720 --> 00:19:24,830
،عندما كنت في الإعداديّة

386
00:19:24,830 --> 00:19:27,710
خضتُ شوكوغيكي ضدّ مجموعة
.أبحاث الطّبخ المتطوّر

387
00:19:27,710 --> 00:19:29,180
.وقد فزت بالطّبع

388
00:19:29,180 --> 00:19:32,560
...لقد أخذت مكانهم ومعدّاتهم

389
00:19:32,560 --> 00:19:37,280
لكن يبدو أنّي أصبحت رئيسة مجموعة
!الأبحاث على الأوراق

390
00:19:37,280 --> 00:19:39,110
!لقد صدمت بمعرفتي بذلك

391
00:19:39,110 --> 00:19:40,750
.هذا فظيع من عدّة نواحٍ

392
00:19:41,740 --> 00:19:44,370
.هكذا أصبحتِ جزءًا من صيد النّاجين أيضًا

393
00:19:45,150 --> 00:19:48,930
.يمكنك أن تناديني الرّئيسة أليس

394
00:19:48,930 --> 00:19:50,580
!لم تكوني حتّى تعلمين بهذا طوال هذا الوقت

395
00:19:50,580 --> 00:19:54,860
لماذا تهتمّين إذًا إن كانت مجموعة
الأبحاث ستُغلق؟

396
00:19:55,870 --> 00:19:58,000
...حسنًا، أفترض أنّي

397
00:19:58,000 --> 00:20:01,510
.سوف يتمّ حلّ مجموعة أبحاث الطّبخ المتطّوّر

398
00:20:01,900 --> 00:20:05,760
لكنّي أستطيع الموافقة على
.شوكوغيكي لإبطال ذلك القرار

399
00:20:06,100 --> 00:20:08,640
.كلاّ، لا مشكلة لي في ذلك

400
00:20:09,430 --> 00:20:13,140
،امتلاك لقب "رئيسة" قد يبدو ممتعًا
،وقد يصعب التّخلّي عنه نوعًا ما

401
00:20:13,140 --> 00:20:14,480
.لكنّي لست مهتمّة به على الإطلاق

402
00:20:14,480 --> 00:20:16,270
.لذلك اتركنا رجاءً

403
00:20:17,440 --> 00:20:19,010
.خيار ذكيّ

404
00:20:19,010 --> 00:20:24,320
يجدر بكم أنتم الرّعاع أن تخرسوا
!وتشاهدوا إدارة أزامي تزدهر

405
00:20:24,320 --> 00:20:27,200
!من تنادي بالرّعاع؟

406
00:20:27,200 --> 00:20:29,360
ماذا؟ ما كل ّهذا فجأة؟

407
00:20:29,360 --> 00:20:32,540
!سأسحق أيًّا كان من يجرؤ على مهاجمتي

408
00:20:32,540 --> 00:20:36,170
!سأستعمل طبخي لهزيمتك

409
00:20:37,060 --> 00:20:38,170
...ريو-كُن

410
00:20:38,170 --> 00:20:39,450
.حسنًا

411
00:20:39,450 --> 00:20:41,800
!سأقبل هذا التّحدّي

412
00:20:41,800 --> 00:20:45,010
.وهكذا، سيشارك ريو-كُن في هذا التّحدّي

413
00:20:45,760 --> 00:20:47,610
.هيّا يا ريو-كُن

414
00:20:47,610 --> 00:20:51,610
.فلتُرِ ذلك المدّعي أنّه من النّخبة مكانته الحقيقيّة

415
00:20:51,610 --> 00:20:52,730
.حاضر

416
00:20:52,730 --> 00:20:56,480
الشّوكوغيكي الأخير في اليوم
."الأول في القاعدة "ج

417
00:20:57,060 --> 00:20:57,980
!كوروكيبا-كُن

418
00:20:58,610 --> 00:21:01,990
سيواجه ديكتاتور المطبخ كوروكيبا ريو

419
00:21:01,990 --> 00:21:05,320
.مبتدئ المركز كوسنوكي رينتارو

420
00:21:05,320 --> 00:21:07,680
!إيّاك أن تتجرّأ على الخسارة يا ريو-كُن

421
00:21:07,680 --> 00:21:10,950
أنا آمرك بالفوز بصفتي رئيسة
!مجموعة أبحاث الطّبخ المتطوّر

422
00:21:11,430 --> 00:21:15,420
لن أسمح لعمّي أزامي بالحصول
!على مبتغاه بعد الآن

423
00:21:15,420 --> 00:21:17,090
...كوروكيبا ريو

424
00:21:17,090 --> 00:21:20,300
.لقد وصلت لنهائيّ انتخابات الخريف

425
00:21:20,740 --> 00:21:23,920
.لقد أزعجني شيء ما كثيرًا قبل قليل

426
00:21:23,920 --> 00:21:26,180
.سوف أصبّ جامّ غضبي عليك

427
00:21:26,700 --> 00:21:31,140
.لست خصمًا سيّئًا لأسحقه وأنهي اليوم الأوّل

428
00:21:31,140 --> 00:21:34,600
،إن كنت ستحاول سحقي

429
00:21:34,990 --> 00:21:38,130
!فسوف يتوجّب عليّ سحقك أيضًا

430
00:23:10,310 --> 00:23:12,200
!بالتّوفيق يا كوروكيبا

431
00:23:12,200 --> 00:23:13,830
!أنا أشاهدك من هنا

432
00:23:14,320 --> 00:23:19,210
شكرًا لسماحك لنا بالتّطفّل على
.مكان جيّد للمشاهدة كهذا

433
00:23:20,360 --> 00:23:21,410
ماذا؟

434
00:23:22,630 --> 00:23:26,050
،تتصرّف مومو-سينباي هكذا دائمًا في البداية
.لذلك لا تشعروا بالإهانة من ذلك

435
00:23:26,050 --> 00:23:31,010
سوف يتطلّب الأمر شهرًا على الأقل حتّى
.تنظر إليكم وتشارككم بالحديث

436
00:23:32,180 --> 00:23:36,390
كيف تمكّنتِ من تجاوز المخيّم
وفترة التّدريب وما إلى ذلك؟

437
00:23:36,390 --> 00:23:39,970
.لا يوجد ما يرغمني على شرح ذلك لك

438
00:23:39,970 --> 00:23:40,900
.أنت مزعج

439
00:23:40,900 --> 00:23:41,770
.ماذا؟ لم أسمعك

440
00:23:41,770 --> 00:23:42,380
ماذا قلت؟

441
00:23:42,380 --> 00:23:44,610
!سوما-كُن، أنت تضغط كثيرًا عليها

442
00:23:44,610 --> 00:23:47,610
!الموضوع هو السّلمون

443
00:23:48,370 --> 00:23:50,250
.يا لها من سمكة سلمون جيّدة

444
00:23:50,250 --> 00:23:52,070
.انظروا للون ولمعان خياشمها

445
00:23:52,070 --> 00:23:53,410
...طعام بحريّ

446
00:23:53,410 --> 00:23:56,330
!ركّز يا ريو-كُن

447
00:23:56,330 --> 00:24:00,040
.كوسنوكي رينتارو ضدّ كوروكيبا ريو

448
00:24:00,040 --> 00:24:04,000
!ليبدأ الشّوكوغيكي

449
00:24:07,150 --> 00:24:10,490
!أتمنّى أن تكون الحلقة القادمة على ذوقكم