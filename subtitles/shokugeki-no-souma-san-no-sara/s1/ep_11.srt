1
00:00:07,350 --> 00:00:08,940
.أحسنت عملاً يا ريو-كُن

2
00:00:09,360 --> 00:00:11,900
استمعتَ لما قلتُه وفزت كما
.كان حريًّا بك أن تفعل

3
00:00:11,900 --> 00:00:14,360
.نعم، أظنّ ذلك

4
00:00:14,360 --> 00:00:16,320
.أحرزنا فوزًا على أيّة حال

5
00:00:16,320 --> 00:00:18,860
!لقد نلنا من المركز هذه المرّة

6
00:00:18,860 --> 00:00:19,790
!نعم

7
00:00:21,980 --> 00:00:23,460
.كان تحدّيًا جيّدًا

8
00:00:24,330 --> 00:00:25,630
!المدير ناكيري؟

9
00:00:25,630 --> 00:00:26,670
!أهذا معقول؟

10
00:00:30,620 --> 00:00:33,760
.لم أرك منذ مدّة يا عمّي أزامي

11
00:00:41,930 --> 00:00:42,860
.يا آنسة

12
00:00:42,860 --> 00:00:44,350
ما الّذي تكتبينه دائمًا؟

13
00:00:44,680 --> 00:00:45,880
.رسائل

14
00:00:45,880 --> 00:00:48,020
.أنا أبعث رسائل عبر البريد الجوّيّ إلى اليابان

15
00:00:48,450 --> 00:00:51,300
.إنّ إرينا طلبت منّي أن أراسلها

16
00:00:51,850 --> 00:00:54,610
.لذلك عليّ إرسال الكثير

17
00:00:55,300 --> 00:00:57,110
.رغم أنّ الأمر مزعج للغاية

18
00:00:59,910 --> 00:01:01,020
.فهمت

19
00:01:02,470 --> 00:01:04,040
.إنها تستمتع بالأمر كثيرًا

20
00:01:04,670 --> 00:01:06,210
.مع السّلامة يا إرينا

21
00:01:06,750 --> 00:01:07,830
.رسائل

22
00:01:08,540 --> 00:01:10,380
.من الأفضل أن تبعثي لي رسائل

23
00:01:14,170 --> 00:01:15,130
ماذا؟

24
00:01:15,130 --> 00:01:18,930
لم تصل أيّ رسائل من إرينا اليوم أيضًا؟

25
00:01:18,930 --> 00:01:20,260
.فهمت

26
00:01:20,260 --> 00:01:21,970
.لا بأس يا أمّي

27
00:01:21,970 --> 00:01:23,520
.سأحاول كتابة واحدة أخرى فحسب

28
00:01:24,200 --> 00:01:26,130
.يا إلهي منك يا إرينا

29
00:01:26,130 --> 00:01:28,690
.أنت من قالت أنّك تريدين رسائل

30
00:02:00,070 --> 00:02:01,450
.يا أليس

31
00:02:01,450 --> 00:02:03,720
.شكرًا لاعتنائك بإرينا

32
00:02:05,630 --> 00:02:07,130
...عمّي أزامي

33
00:03:38,850 --> 00:03:41,490
أليس هي رئيسة مجموعة أبحاث الطّبخ المتطوّر؟

34
00:03:41,490 --> 00:03:44,060
منذ متى؟

35
00:03:44,060 --> 00:03:47,820
انظري، إنّه في السجلّ الرّسميّ لتحدّي
.شوكوغيكي في الماضي

36
00:03:48,390 --> 00:03:50,950
لذلك السّبب تمّ استهدافها
.من طرف صيد النّاجين

37
00:03:51,500 --> 00:03:53,770
.أتساءل إن كانت أليس ستكون بخير اليوم

38
00:03:54,970 --> 00:03:55,880
أنت قلقة، صحيح؟

39
00:03:55,880 --> 00:03:58,680
!لـ-لست قلقة

40
00:03:58,680 --> 00:04:01,590
...لكنّ أليس تتصرّف بتهوّر أحيانًا، لذا

41
00:04:01,590 --> 00:04:05,710
.حسنًا، إنّها هي من أخرجتك من منزل العائلة

42
00:04:07,230 --> 00:04:09,930
.تبدو أليس-كُن مهتمّة بأمرك كثيرًا أيضًا

43
00:04:10,320 --> 00:04:12,110
!يا لها من صداقة جميلة

44
00:04:12,110 --> 00:04:13,250
.هذا هو الشّباب

45
00:04:13,860 --> 00:04:15,310
.أتساءل بشأن ذلك

46
00:04:16,720 --> 00:04:20,650
.أشكّ أنّها تعتبرني صديقة لها

47
00:04:21,350 --> 00:04:24,710
.فعلتُ أشياء فظيعة عديدة لأليس

48
00:04:26,470 --> 00:04:30,170
أليس، كانت مجموعتك لأبحاث الطّبخ المتطوّر

49
00:04:30,170 --> 00:04:32,200
الوحيدة الّتي فازت بتحدّي شوكوغيكي
.في صيد النّاجين اليوم

50
00:04:32,610 --> 00:04:36,970
المنظّمات الإثني وثلاثين الأخرى
.هُزمت جميعها وسوف تُحلّ

51
00:04:37,590 --> 00:04:39,190
،بغضّ النّظر عن النّتائج الأخرى

52
00:04:39,190 --> 00:04:41,680
.فقد فاز ريو-كُن ضدّ المركز

53
00:04:41,680 --> 00:04:46,180
هل ما زلت مُصرًّا أنّ طريقتك في التّفكير
صحيحة ولا تقبل الجدال يا عمّي؟

54
00:04:46,490 --> 00:04:48,410
.كم هذا مخيّب للآمال يا أليس

55
00:04:48,410 --> 00:04:53,310
ظننتُ أنّك ستدعمين مدينتي
.الفاضلة لطعام الذّوّاقة

56
00:04:54,010 --> 00:04:57,770
تملك عائلة ناكيري مسؤوليّة تطوير
.عالم طعام الذّوّاقة

57
00:04:58,270 --> 00:05:00,790
.هذا هو الهدف من هذه الثّورة العظيمة

58
00:05:00,790 --> 00:05:01,980
!أبي؟

59
00:05:02,540 --> 00:05:03,340
...أليس

60
00:05:03,830 --> 00:05:06,750
.لا أستطيع أن أوافق على طُرقك يا عمّي

61
00:05:06,750 --> 00:05:07,920
.ولا أرغب في ذلك

62
00:05:07,920 --> 00:05:09,050
.هذا كلّ شيء

63
00:05:09,050 --> 00:05:11,660
.يا لك من فتاة عنيدة

64
00:05:12,150 --> 00:05:14,910
حتّى أنّك أخذت ابنتي العزيزة
.من المنزل دون إذني

65
00:05:15,620 --> 00:05:17,750
فكّري جيّدًا إن كان لديك الحقّ
.بالحديث معي بتلك الطّريقة

66
00:05:17,750 --> 00:05:19,630
!لا أهتمّ

67
00:05:20,160 --> 00:05:21,840
.أنا غاضبة

68
00:05:22,200 --> 00:05:25,840
.لن أنسى ما فعلتَه أبدًا يا عمّي

69
00:05:26,220 --> 00:05:29,510
!أنا لا أحبّك يا عمّي أزامي

70
00:05:33,600 --> 00:05:39,270
لن أسمح لك بفعل ما تشاء بأكاديميّة
!توتسكي! وبإرينا أيضًا

71
00:05:40,820 --> 00:05:41,860
.فهمت

72
00:05:41,860 --> 00:05:43,730
.حسنًا، ابذلي جهدك

73
00:05:43,730 --> 00:05:48,200
.أمّا اليوم، سأهنّئك على فوزك فحسب

74
00:05:54,740 --> 00:05:55,700
...إرينا

75
00:05:55,700 --> 00:05:57,080
كنت تستمعين لنا؟

76
00:06:03,750 --> 00:06:06,590
،لو لم يتدخّل عمّي أزامي

77
00:06:06,590 --> 00:06:11,470
.لكنّا صديقتين أفضل بكثير جدًّا يا إرينا

78
00:06:11,790 --> 00:06:13,220
.كم هذا فظّ منه

79
00:06:15,810 --> 00:06:19,490
!كما أنّك تبدين كئيبة للغاية مؤخّرًا

80
00:06:19,490 --> 00:06:21,560
!لماذا لا تقفين بشكل مستقيم وبفخر؟

81
00:06:21,980 --> 00:06:24,810
لم تغادري غرفتك في مسكن
!النّجم القطبيّ، صحيح؟

82
00:06:24,810 --> 00:06:26,780
!كيف تجرئين؟

83
00:06:26,780 --> 00:06:29,070
!أنت من دفعني للهرب من المنزل

84
00:06:29,410 --> 00:06:33,070
هذا لأنّي لم أطق رؤيتك مرعوبة
!من عمّي أزامي

85
00:06:33,780 --> 00:06:36,430
!عليك أن تقفي في وجهه

86
00:06:36,430 --> 00:06:38,250
!عليك أن تريه أنّك شخص مستقلّ بذاته

87
00:06:38,250 --> 00:06:40,830
!أريه أنّك لست دمية لأيّ أحد

88
00:06:41,270 --> 00:06:43,460
!لا يمكنك البقاء حبيسة قوقعتك للأبد

89
00:06:43,460 --> 00:06:44,700
أفهمتِ؟

90
00:06:44,700 --> 00:06:45,820
...أليس

91
00:06:45,820 --> 00:06:50,300
!كما أنّي أخطّط لهزيمتك شرّ هزيمة يومًا ما

92
00:06:50,780 --> 00:06:53,480
لا أريدك أن تكوني فتاة خجولة

93
00:06:53,480 --> 00:06:56,310
.بينما أحتاج منك لتكوني الجديرة لتكوني ندّي

94
00:06:56,310 --> 00:06:59,050
!ماذا قلت؟

95
00:06:59,050 --> 00:07:00,060
ماذا؟

96
00:07:00,060 --> 00:07:01,810
!كلّ ما تطبخينه طعمه مقرف في كلّ الأحوال

97
00:07:01,810 --> 00:07:03,320
!"قلتِ "مقرف

98
00:07:03,320 --> 00:07:05,290
!قلت "مقرف" لأنّه مقرف بالفعل

99
00:07:05,290 --> 00:07:07,700
.إنّهما مقرّبتان من بعض بالفعل

100
00:07:07,700 --> 00:07:09,790
.لا تقل ذلك لهما

101
00:07:09,790 --> 00:07:11,780
.سيسبّب ذلك بالمشاكل فحسب

102
00:07:14,020 --> 00:07:16,350
المنظّمات الّتي عانت من الهزيمة ستُحلّ في الحال

103
00:07:16,350 --> 00:07:19,040
.وستُمنع من القيام بأيّ نوع من النّشاطات

104
00:07:20,130 --> 00:07:22,540
،وإن كان هنالك أيّ تصرّف متمرّد

105
00:07:22,540 --> 00:07:24,540
.فسيكون العقاب سريعًا

106
00:07:25,190 --> 00:07:26,380
.طاب يومكم

107
00:07:31,550 --> 00:07:36,940
.تغيّر شكل الفصول كثيرًا منذ تأسّس المركز أيضًا

108
00:07:36,940 --> 00:07:37,510
.نعم

109
00:07:37,510 --> 00:07:40,710
لم تعد هنالك فصول أخرى حيث
.نستطيع ابتكار أطباقنا الخاصّة

110
00:07:40,710 --> 00:07:43,770
.أصبح المهمّ لديهم هو اتّباع الوصفات بحذافيرها

111
00:07:43,770 --> 00:07:46,980
إنّهم لا ينوون السّماح لنا بالطّبخ
.كما نريد بالفعل

112
00:07:46,980 --> 00:07:51,290
.حتّى المعلّم شينوميا منحني حرّيّة أكثر في المطبخ

113
00:07:52,570 --> 00:07:54,750
ما الخطب يا سيّدي الطّاهي؟

114
00:07:54,750 --> 00:07:57,990
.شعرت بانزعاج شديد فجأة لسبب ما

115
00:07:59,810 --> 00:08:01,960
المدرّس الّذي كان مسؤولاً عن هذا الفصل

116
00:08:01,960 --> 00:08:06,050
تمّ إعفاؤه بسبب قوله
.أنّه لا يستطيع اتّباع أوامر المركز

117
00:08:06,050 --> 00:08:07,790
!ماذا؟

118
00:08:07,790 --> 00:08:09,090
.تمّ إعفاؤه

119
00:08:09,090 --> 00:08:10,550
.إنّهم قاسون للغاية

120
00:08:10,550 --> 00:08:15,210
بسبب ذلك، سيقوم مدرّس بديل
.بتولّي أمر درس اليوم

121
00:08:15,210 --> 00:08:19,450
سيكون الدّرس من أساسيّات طعام
.ذوّاقة الّتي يتبنّاها المركز

122
00:08:19,450 --> 00:08:21,390
.انتبهوا جيّدًا، وتعلّموا الموادّ

123
00:08:21,770 --> 00:08:24,430
.سوف يحضر المدرّس في الحال

124
00:08:26,630 --> 00:08:28,980
...صاحب الرّتبة الأولى

125
00:08:30,370 --> 00:08:31,940
!تسوكاسا إيشي

126
00:08:33,690 --> 00:08:34,940
.مرحبًا

127
00:08:34,940 --> 00:08:37,880
أنا صاحب الرّتبة الأولى بين النّخبة
.العشرة، تسوكاسا إيشي

128
00:08:37,880 --> 00:08:39,950
.لا أعرف إن كنتم تعرفونني جميعًا

129
00:08:40,640 --> 00:08:41,660
!نحن نعرفك

130
00:08:42,190 --> 00:08:45,070
.سوف أحضّر بضعة أطباق اليوم

131
00:08:45,070 --> 00:08:49,170
.أرغب منكم اتّباع طُرقي بينما تعدّون الأطباق

132
00:08:49,500 --> 00:08:50,330
!فعلاً؟

133
00:08:50,330 --> 00:08:52,090
!سيقوم صاحب الرّتبة الأولى بتعليمنا الطّريقة؟

134
00:08:52,090 --> 00:08:53,300
!هذا مخيف للغاية

135
00:08:53,700 --> 00:08:56,580
أتذكرين جودة ما قدّمه في مهرجان وليمة القمر؟

136
00:08:56,580 --> 00:08:57,930
كانت أطباقًا رائعة، صحيح؟

137
00:08:57,930 --> 00:09:00,430
.كلّ ما تذوّقناه كان مذهلاً

138
00:09:00,430 --> 00:09:04,970
صحيح، يفترض أن أحصل على تلميذ متطوّع

139
00:09:04,970 --> 00:09:07,310
.ليكون مساعدي خلال هذا الفصل

140
00:09:07,310 --> 00:09:09,890
.سوف يقوم بتوفير الدّعم بينما أعدّ الأطباق

141
00:09:14,010 --> 00:09:14,980
.اذهبي أنت

142
00:09:14,980 --> 00:09:16,990
.مستحيل. سأصاب بالإحباط فحسب

143
00:09:17,690 --> 00:09:18,700
ماذا؟

144
00:09:18,700 --> 00:09:19,910
...المعذرة

145
00:09:20,900 --> 00:09:23,210
ألا يريد أيّ أحد أن يطبخ معي؟

146
00:09:25,750 --> 00:09:26,870
!سوما-كُن؟

147
00:09:28,210 --> 00:09:30,160
...يوكيهيرا سوما

148
00:09:30,160 --> 00:09:32,090
.أرى أنّك تلميذ في هذا الفصل

149
00:09:32,090 --> 00:09:34,510
.سأكون مساعدك

150
00:09:34,510 --> 00:09:35,340
لا بأس، صحيح؟

151
00:09:36,490 --> 00:09:38,300
.سأعتمد عليك لمساعدتي إذًا

152
00:09:41,030 --> 00:09:44,240
سوف أشرح خمسة أطباق
.مشهّيات فرنسيّة اليوم

153
00:09:44,240 --> 00:09:45,980
.سأعدّها جميعها في نفس الوقت

154
00:09:46,460 --> 00:09:49,450
.سوف تجهّز المكوّنات يا يوكيهيرا

155
00:09:49,450 --> 00:09:49,940
.حاضر

156
00:09:50,440 --> 00:09:52,520
.حسنًا، لنبدأ

157
00:09:52,520 --> 00:09:57,500
يوكيهيرا، استعمل خلاّط الطّعام لإعداد
.هريسة من تين نصف جافّ

158
00:09:57,500 --> 00:10:00,010
.افرم الكرّاث وقطّع الجزر بشكل صغير جدًّا

159
00:10:00,010 --> 00:10:03,910
أضف حبّ الهيل والحليب لبياض البيض
،والسّكّر لإعداد قشدة إنجليزيّة

160
00:10:03,910 --> 00:10:06,200
.ثمّ اسكبه فوق السّوربي بمجرّد أن يبرد

161
00:10:06,540 --> 00:10:07,160
!مفهوم

162
00:10:08,110 --> 00:10:09,360
!معلومات كثيرة دفعة واحدة

163
00:10:09,360 --> 00:10:10,540
!سوف ينفجر رأسي

164
00:10:14,880 --> 00:10:17,050
!مذهل يا سوما-كُن

165
00:10:17,050 --> 00:10:18,160
—حسنًا، والآن

166
00:10:18,160 --> 00:10:20,780
سأقلي سمك الآيو الصّغير المغطّى
بدقيق القمح الكامل، صحيح؟

167
00:10:21,660 --> 00:10:23,260
!نعم، شكرًا لك

168
00:10:25,460 --> 00:10:28,550
!سينباي، انتهيت من إعداد طبق الكوسى

169
00:10:28,550 --> 00:10:32,150
والقشدة المخفوقة ستُخفق بشكل
.ناعم بعد عشر ثوان أيضًا

170
00:10:32,150 --> 00:10:35,030
.جيّد

171
00:10:32,730 --> 00:10:34,070
!لوز مقليّ

172
00:10:36,930 --> 00:10:40,450
كلّ تقنيّات الطّبخ الفرنسيّ قد حُفرت في ذهني

173
00:10:40,990 --> 00:10:43,450
.عندما قضيتُ فترة تدريبي مع المعلّم شينوميا

174
00:10:43,450 --> 00:10:45,540
.لا تفقد تركيزك يا يوكيهيرا

175
00:10:45,540 --> 00:10:46,430
!حاضر

176
00:10:47,350 --> 00:10:48,910
.التّقديم رجاءً

177
00:10:49,390 --> 00:10:50,370
!مفهوم

178
00:10:50,370 --> 00:10:51,490
.مذهل

179
00:10:51,490 --> 00:10:52,060
.سريعان للغاية

180
00:10:52,060 --> 00:10:53,880
.لا يُصدّق

181
00:10:53,880 --> 00:10:56,170
تعاون حقيقيّ بين موهوبين متساويين

182
00:10:56,170 --> 00:10:58,010
!يمنع دخول أيّ أحد ليس جديرًا بذلك

183
00:10:58,010 --> 00:10:59,060
!يوكيهيرا

184
00:10:59,060 --> 00:11:00,710
!اشوِ الهليوم

185
00:11:00,710 --> 00:11:01,470
!حاضر

186
00:11:03,180 --> 00:11:04,890
.كان ذلك سريعًا

187
00:11:05,250 --> 00:11:08,520
حسنًا، لتجرّبوا جميعًا إعداد نفس الأطباق

188
00:11:08,920 --> 00:11:10,480
.في نفس الوقت

189
00:11:10,480 --> 00:11:12,190
!مستحيل

190
00:11:14,060 --> 00:11:15,610
.إنّها جميلة للغاية

191
00:11:16,210 --> 00:11:19,220
.لم أرها تحضر الفصول لمدّة

192
00:11:19,220 --> 00:11:22,530
.أنا سعيدة لأنّ إرينا-ساما بخير

193
00:11:25,580 --> 00:11:28,290
.أنا سعيدة لاستجماعي القوة لحضور الفصل

194
00:11:28,980 --> 00:11:31,960
.لا يبدو أنّ أبي سيجبرني على العودة أيضًا

195
00:11:31,960 --> 00:11:35,180
!أحسنت عملاً يا إرينا-ساما

196
00:11:35,180 --> 00:11:37,690
.كان من المسلّم حصولك على علامة ممتازة

197
00:11:38,490 --> 00:11:39,880
.كان ذلك سهلاً

198
00:11:41,090 --> 00:11:44,800
.كم هذا استثنائيّ كالعادة يا إرينا-سان

199
00:11:44,800 --> 00:11:46,560
.المدرّسون

200
00:11:46,560 --> 00:11:49,180
.لا بدّ أنّ والدك فخور بك

201
00:11:49,520 --> 00:11:52,140
نتطلّع قُدمًا لإنجازاتك المستقبليّة

202
00:11:52,140 --> 00:11:55,160
.من أجل المركز وأكاديميّة توتسكي

203
00:11:55,160 --> 00:11:56,250
.المعذرة

204
00:11:59,580 --> 00:12:01,290
!أحسنت يا سوما-كُن

205
00:12:01,290 --> 00:12:03,200
!وأنت أيضًا يا تادوكورو

206
00:12:03,200 --> 00:12:04,870
.كان ذلك رائعًا

207
00:12:04,870 --> 00:12:07,330
.تعاملتَ مع كلّ شيء بسهولة

208
00:12:07,330 --> 00:12:10,650
."حسنًا، ما كنتُ لأصف ذلك بـ"سهولة"

209
00:12:10,650 --> 00:12:12,540
.أعضاء المركز ليسوا سيّئين أيضًا

210
00:12:12,960 --> 00:12:13,420
ماذا؟

211
00:12:13,420 --> 00:12:15,210
،بالتّفكير في الأمر الآن

212
00:12:15,210 --> 00:12:17,930
هل ساعدت المركز للتّوّ؟

213
00:12:17,930 --> 00:12:20,090
ما الّذي أفعله؟

214
00:12:22,590 --> 00:12:23,950
مجموعة أبحاث الطّبخ المحلّيّ

215
00:12:23,950 --> 00:12:26,160
ستشارك في الجولة التّالية لتحدّيّات
!الشوكوغيكي في صيد النّاجين

216
00:12:26,160 --> 00:12:26,900
فعلاً؟

217
00:12:26,900 --> 00:12:29,260
!سوف أذهب لاستدعاء الرّئيس

218
00:12:28,710 --> 00:12:29,260
!حسنًا

219
00:12:32,230 --> 00:12:34,190
!ما زلت هنا يا تسوكاسا-سينباي؟

220
00:12:34,540 --> 00:12:38,060
لقد تمالكت نفسي لوقت طويل
،لدرجة أنّه عند نهاية الدّرس

221
00:12:38,060 --> 00:12:39,940
.فقدت كلّ قوّتي

222
00:12:39,940 --> 00:12:44,780
من المخيف للغاية أن أطبخ
.أمام العديد من التّلاميذ

223
00:12:45,130 --> 00:12:48,830
.ربّما أكون قد نسيت إخبارهم بشيء مهمّ

224
00:12:50,370 --> 00:12:52,650
أتساءل إن كانت ريندو ستغضب منّي ثانية

225
00:12:52,650 --> 00:12:54,570
.لتصرّفي بقلّة ثقة في نفسي

226
00:12:55,580 --> 00:12:58,340
.إنّه شخص يسعى للكمال بالفعل

227
00:12:58,340 --> 00:13:01,560
.على أيّ حال، كنت مذهلاً يا يوكيهيرا

228
00:13:01,560 --> 00:13:04,210
.أنت موهوب أكثر ممّا ظننت

229
00:13:04,210 --> 00:13:06,370
.كلاّ، لقد استمتعت

230
00:13:06,370 --> 00:13:07,760
.تعلّمت الكثير أيضًا

231
00:13:07,760 --> 00:13:09,220
.أنت شخص كفء

232
00:13:10,430 --> 00:13:13,890
هل أنت مهتمّ بأن تصبح مساعدي؟

233
00:13:13,890 --> 00:13:17,020
هلّا انضممت إلى المركز؟

234
00:13:17,020 --> 00:13:17,950
ماذا؟

235
00:13:21,780 --> 00:13:27,250
إرينا-ساما، سمعت أنّ عمليّة صيد النّاجين
.التّالية ستُقام لثلاثة أيّام بدءًا من الآن

236
00:13:27,250 --> 00:13:28,280
.فهمت

237
00:13:28,980 --> 00:13:32,080
.يبدو أنّه سيتمّ حلّ الكثير من المنظّمات الأخرى

238
00:13:32,430 --> 00:13:37,330
لكن ربّما تحصل منظّمة أخرى على
.الفوز مثلما حدث مع أليس

239
00:13:38,330 --> 00:13:43,750
،المركزّ التّابع لأبي، ناكيري أزامي
.ليس مطلقًا كما يبدو

240
00:13:45,020 --> 00:13:45,810
ماذا؟

241
00:13:45,810 --> 00:13:46,970
لماذا تحدّقين بي هكذا؟

242
00:13:46,970 --> 00:13:48,840
...لا شيء

243
00:13:48,840 --> 00:13:52,350
.تبدين مختلفة عن المعتاد فحسب

244
00:13:52,920 --> 00:13:55,910
.وكأنّ موقفك قد تغيّر بطريقة ما

245
00:13:56,810 --> 00:13:58,210
...هذا

246
00:13:59,690 --> 00:14:05,110
.قمتُ بما أمر به أبي دون تشكيك حتّى الآن

247
00:14:05,820 --> 00:14:07,990
.لم أفكّر حتّى في القيام بشيء آخر

248
00:14:08,940 --> 00:14:12,030
.سلّمتُ جدلاً أنّه كان عليّ أن أطيع الأوامر

249
00:14:12,370 --> 00:14:17,000
لكنّ يوكيهيرا-كُن وبقيّة قاطني مسكن
.النّجم القطبيّ رفضوا تغيير أنفسهم

250
00:14:17,450 --> 00:14:19,390
.لن ينحنوا أمام أبي

251
00:14:19,980 --> 00:14:24,300
كما أنّ أليس قد أخبرت أبي كم
.أنّها غاضبة في وجهه مباشرة

252
00:14:25,030 --> 00:14:27,760
...عندما رأيتها كذلك، كنتُ

253
00:14:27,760 --> 00:14:30,420
!عليك أن تقفي في وجهه

254
00:14:30,420 --> 00:14:32,140
!عليك أن تريه أنّك شخص مستقلّ بذاته

255
00:14:32,690 --> 00:14:39,170
...بدأت أفكّر أيضًا بشأن ما أريد أنا أن أفعله

256
00:14:39,170 --> 00:14:40,230
...إرينا-ساما

257
00:14:40,600 --> 00:14:45,030
الأمر ليس وكأنّي تأثّرت بأليس ويوكيهيرا-كُن، مفهوم؟

258
00:14:45,510 --> 00:14:47,900
—أريد اتّخاذ قراري بنفسي فحسب

259
00:14:47,900 --> 00:14:48,980
يوكيهيرا؟

260
00:14:48,980 --> 00:14:51,820
—لـ-لذلك لا علاقة ليوكيهيرا بهذا

261
00:14:54,980 --> 00:14:56,830
!تسوكاسا-سان ويوكيهيرا-كُن؟

262
00:14:57,570 --> 00:14:59,260
لماذا يتحدّثان مع بعضهما؟

263
00:14:59,260 --> 00:15:00,830
ما الخطب يا إرينا-ساما؟

264
00:15:01,170 --> 00:15:02,810
لماذا تختبئين؟

265
00:15:02,810 --> 00:15:05,240
.أنا لست واثقة من ذلك

266
00:15:05,240 --> 00:15:08,550
هل تطلب منّي الانضمام للمركز؟

267
00:15:08,550 --> 00:15:09,580
.نعم

268
00:15:09,580 --> 00:15:12,240
.هذه مزحة سيّئة يا تسوكاسا-سينباي

269
00:15:12,240 --> 00:15:13,550
لماذا قد أفعل ذلك؟

270
00:15:13,550 --> 00:15:14,750
.فهمت

271
00:15:14,750 --> 00:15:16,360
.أظنّ أنّك لن تنضمّ

272
00:15:16,360 --> 00:15:18,680
!كلاّ، لا يجب أن يحبطك هذا

273
00:15:19,100 --> 00:15:23,460
.حسنًا، من اللّطيف أن تعترف بمهاراتي

274
00:15:23,460 --> 00:15:27,970
لكنّي لا أريد تقديم طعام مطعم يوكيهيرا
...الشّعبيّ في المركز، لذا

275
00:15:27,970 --> 00:15:29,280
.لن يكون ذلك ضروريًّا

276
00:15:29,990 --> 00:15:32,430
.طبخ مطعم يوكيهيرا الشّعبيّ ليس ضروريًّا

277
00:15:32,430 --> 00:15:36,120
.ما أريده هي مؤهّلاتك كمساعد

278
00:15:36,800 --> 00:15:38,410
،بوجودك إلى جانبي

279
00:15:38,410 --> 00:15:41,830
.أشعر أنّ بإمكاني تحسين طبخي أكثر

280
00:15:42,170 --> 00:15:47,520
المعذرة، لذلك سيكون من اللّطيف
...إن فكّرت بالأمر

281
00:15:47,520 --> 00:15:48,960
.من أجل طبخي

282
00:15:50,460 --> 00:15:53,720
.أنت تقول أشياء أنانيّة بالكامل بشكل غير مبالٍ تمامًا

283
00:15:54,220 --> 00:15:59,260
.يا إلهي، جميع الطّهاة أوغاد أنانيّون

284
00:16:00,390 --> 00:16:02,270
...ناكيري-سان، أراتو-سان

285
00:16:02,270 --> 00:16:03,020
ماذا تفعلان؟

286
00:16:03,020 --> 00:16:04,240
!اختبئي بسرعة

287
00:16:04,980 --> 00:16:07,680
.ستكون هنالك مميّزات لك أيضًا يا يوكيهيرا

288
00:16:07,680 --> 00:16:10,080
،إن انضممت للمركز وشكّلت فريقًا معي

289
00:16:10,080 --> 00:16:13,240
ستكون قادرًا على طبخ طعام من مستوى
.أعلى بكثير ممّا تقدر عليه الآن

290
00:16:13,650 --> 00:16:17,590
لكنّ ذلك سيكون كمساعد لك فحسب، صحيح؟

291
00:16:17,590 --> 00:16:20,330
ما الفائدة إن لم أستطع تقديم طبخي الخاصّ؟

292
00:16:20,330 --> 00:16:23,610
.ذلك صحيح

293
00:16:23,610 --> 00:16:26,670
أنت لا تفكّر في شيء آخر
بالفعل غير طبخك، صحيح؟

294
00:16:26,670 --> 00:16:31,380
كما أنّك لم تر أيًّا من أطباقي من قبل، صحيح؟

295
00:16:31,380 --> 00:16:35,380
!قد يكون طبخي أفضل من طبخك

296
00:16:35,380 --> 00:16:36,390
.فهمت

297
00:16:36,790 --> 00:16:38,350
...دعنا نجرّب إذًا

298
00:16:40,300 --> 00:16:43,020
.ونرى مهارات من منّا هي الأفضل

299
00:16:43,690 --> 00:16:44,930
،إن لم يكن ثمّة مانع

300
00:16:44,930 --> 00:16:46,980
.أستطيع مواجهتك هنا والآن

301
00:16:47,510 --> 00:16:50,360
.كما أنّي سأراهن بالرّتبة الأولى بين النّخبة العشرة

302
00:16:55,250 --> 00:16:56,240
هل أنت جادّ؟

303
00:16:56,560 --> 00:16:57,940
.جادّ تمامًا

304
00:16:57,940 --> 00:17:03,530
لكن إن فزت أنا، فسيكون عليك
.الانضمام للمركز والعمل لديّ

305
00:17:04,890 --> 00:17:09,170
هل تقبل بهذا التّحدّي يا يوكيهيرا سوما؟

306
00:17:14,840 --> 00:17:16,300
.ممتاز

307
00:17:16,700 --> 00:17:18,260
!لنقم بهذا

308
00:17:19,130 --> 00:17:20,970
!سأواجه صاحب الرّتبة الأولى

309
00:17:28,700 --> 00:17:30,610
.اتّخذ القرار إذًا

310
00:17:30,610 --> 00:17:33,610
بشأن الموضوع، ما رأيك بلحم الغزال؟

311
00:17:34,290 --> 00:17:37,070
كان يفترض استعمال لحم الغزال
،خلال الفصل قبل قليل

312
00:17:37,070 --> 00:17:39,700
لذلك هنالك الكثير من القطع
.المختلفة في متناولنا

313
00:17:39,700 --> 00:17:40,990
.فهمت

314
00:17:40,990 --> 00:17:41,790
.لا أمانع

315
00:17:41,790 --> 00:17:44,250
...بالنّسبة لنوع الطّبخ

316
00:17:44,250 --> 00:17:45,620
!ليكن الطّبخ الفرنسيّ

317
00:17:47,100 --> 00:17:48,110
.أكيد

318
00:17:48,110 --> 00:17:49,170
.لنبدأ إذًا

319
00:17:49,880 --> 00:17:50,920
.لقد بدأ التّحدّي

320
00:17:52,100 --> 00:17:56,470
الطّبخ الفرنسيّ الّذي تذوّقته في كشك
تسوكاسا-سينباي في مهرجان وليمة القمر

321
00:17:56,470 --> 00:17:58,590
.كان ترك تأثيرًا مفاجئًا واضحًا

322
00:17:58,970 --> 00:18:02,640
!لكنّي تعلّمت الكثير في مطعم المعلّم شينوميا أيضًا

323
00:18:03,130 --> 00:18:05,610
!سأواجهه بطبخي الفرنسيّ الخاصّ

324
00:18:05,610 --> 00:18:08,160
!كـ-كـ-كيف يحدث هذا من الأساس؟

325
00:18:08,160 --> 00:18:10,440
.لا ندري نحن أيضًا

326
00:18:10,440 --> 00:18:13,210
،لكن بما أنّهما قد بدآ تحدّي الطّبخ

327
00:18:13,210 --> 00:18:14,920
فلا نستطيع إلّا مشاهدة ما سيحدث فحسب

328
00:18:14,920 --> 00:18:17,780
.وكيف سيتحدّى يوكيهيرا-كُن تسوكاسا إيشي البارع

329
00:18:17,780 --> 00:18:19,630
.نعم يا إرينا-ساما

330
00:18:19,630 --> 00:18:21,740
...لكن إن خسر

331
00:18:21,740 --> 00:18:24,040
.حسنًا، لحم الغزال

332
00:18:24,040 --> 00:18:25,700
أيّ نوع من الأطباق سأطبخ؟

333
00:18:25,700 --> 00:18:28,270
أيّ نوع من الأطباق سيسمح لي
بالفوز أمام تسوكاسا إيشي؟

334
00:18:28,270 --> 00:18:31,140
.يوكيهيرا، سأبدأ أوّلاً

335
00:18:32,090 --> 00:18:33,180
!هذا ضخم

336
00:18:33,180 --> 00:18:34,340
.لا بدّ أنّه لحم الظّهر

337
00:18:41,250 --> 00:18:43,140
،بعد مسح اللّحم بالملح والفلفل

338
00:18:43,570 --> 00:18:46,600
.يستعمل السّلمندر لطبخه ببطء وعناية

339
00:18:46,600 --> 00:18:50,710
لقد وضع دهن الغزال المفروم على المقلاة

340
00:18:50,710 --> 00:18:53,730
.لكي لا يلمس اللّحم سطح المقلاة مباشرة

341
00:18:53,730 --> 00:18:55,440
كما أنّه يزيل اللّحم بشكل دوريّ

342
00:18:55,900 --> 00:18:58,510
ويسقيه بالدّهن الذّائب

343
00:18:58,510 --> 00:19:00,440
.لمنع سطح اللّحم من الجفاف

344
00:19:00,440 --> 00:19:02,730
.اهتمامه بالمكوّنات لا يُصدّق

345
00:19:03,170 --> 00:19:05,770
.إنّه لطيف للغاية في التّعامل معها

346
00:19:05,770 --> 00:19:08,200
.وكأنّه يتحدّث إليها بصمت

347
00:19:08,530 --> 00:19:10,960
.لذلك السّبب هو صاحب الرّتبة الأولى

348
00:19:11,270 --> 00:19:14,940
الآن، نراه يتواصل مع المكوّنات
.بالمعنى الحقيقيّ للكلمة

349
00:19:15,650 --> 00:19:18,380
.جيّد. تعال إليّ

350
00:19:19,050 --> 00:19:20,790
.اقترب أكثر

351
00:19:21,930 --> 00:19:23,830
.هذا صحيح. تعال

352
00:19:23,830 --> 00:19:24,600
...والآن

353
00:19:25,850 --> 00:19:29,740
.تعال واستقرّ على طبقي

354
00:19:34,350 --> 00:19:35,620
.مذهل

355
00:19:35,620 --> 00:19:39,780
.يبدو أنّ عصارة لحم الغزال تتموّج داخل اللّحم بصمت

356
00:19:39,780 --> 00:19:45,160
نحن نلاحظ بلوغ المكوّن إلى أعلى
.مستوياته بينما نتحدّث

357
00:19:47,710 --> 00:19:49,330
...لم أتذوّقه بعد، لكن

358
00:19:49,700 --> 00:19:51,540
...بمجرّد النّظر والشّمّ

359
00:19:52,090 --> 00:19:53,960
...لا يسعني إلاّ أن ألتهم

360
00:19:53,960 --> 00:19:56,540
!طاقة المكوّنات

361
00:20:02,510 --> 00:20:06,890
حساسيّته وتقنيّاته حتّى الآن تتجاوز
.ما يمكن للأشخاص العاديّين فعله

362
00:20:07,650 --> 00:20:10,430
،فارس الطّاولة الأبيض تسوكاسا إيشي

363
00:20:10,430 --> 00:20:13,980
قد وطأت قدمه عالمًا مقدّسًا
.تحكمه آلهة طعام الذّوّاقة

364
00:20:16,900 --> 00:20:19,730
يوكيهيرا، هل أنت واثق أنّك
لا تريد أن تبدأ بالطّبخ؟

365
00:20:20,190 --> 00:20:23,980
بصفتي عضوًا في المركز، فلا يجب
،أن أسمح لنفسي بأن أُهزم

366
00:20:23,980 --> 00:20:25,700
.لذلك لن أتهاون في تقديم ما لديّ

367
00:20:25,700 --> 00:20:29,830
تسوكاسا-سينباي، ما الّذي يسعى
المركز لتحقيقه على أيّ حال؟

368
00:20:30,800 --> 00:20:32,160
لماذا تسأل عن هذا فجأة؟

369
00:20:32,160 --> 00:20:36,270
هل السّيطرة على الأكاديميّة هي غرضهم الوحيد؟

370
00:20:36,270 --> 00:20:39,550
.أعني أنّك طاهٍ ممتاز

371
00:20:40,010 --> 00:20:43,670
أعتقد أنّك ستبلي حسنًا بمفردك
.دون الانضمام للمركز

372
00:20:44,510 --> 00:20:47,470
.إنّك تعطيني تقديرًا أكثر من اللازم يا يوكيهيرا

373
00:20:48,600 --> 00:20:52,180
...لكن أعتقد أنّ هدف المركز بعيد المدى هو

374
00:20:52,590 --> 00:20:56,070
.إغلاق كلّ المطاعم في اليابان

375
00:20:58,690 --> 00:20:59,770
ماذا؟

376
00:20:59,770 --> 00:21:01,740
.أتمنّى أنّك لم تسئ الفهم

377
00:21:01,740 --> 00:21:05,660
طبعًا لن نغلق أيّ مطعم يقدّم
.طعام الذّوّاقة الحقيقيّ

378
00:21:06,330 --> 00:21:08,620
.اسمع ما قاله المدير أزامي

379
00:21:08,620 --> 00:21:13,870
علينا القضاء على المطاعم الّتي تقدّم علف الحيوانات
.الّذي لا يستحقّ أن يسمّيه البشر طعامًا

380
00:21:13,870 --> 00:21:19,340
إنّها خطوة ضروريّة للغاية بهدف تطوير
.طعام الذّوّاقة في اليابان

381
00:21:19,340 --> 00:21:24,550
ولذلك يكون من الضّروريّ لنا أن نعلّم الطّهاة
.المتفوّقين الّذين سيصبحون جيشًا لنا

382
00:21:25,650 --> 00:21:28,550
والتّطهير الحاصل الآن في الأكاديميّة
والفصول المُعاد هيكلتها

383
00:21:29,040 --> 00:21:32,560
هي خطوات أوّليّة قبل أن يتمّ إغلاق
.المطاعم المتدنّية في البلاد

384
00:21:32,940 --> 00:21:34,420
المطاعم المتدنّية؟

385
00:21:34,420 --> 00:21:34,850
.صحيح

386
00:21:35,340 --> 00:21:38,590
سوف نمحو كلّ مطاعم المدينة
الّتي تخدم العموم

387
00:21:38,590 --> 00:21:42,470
.ونستبدلها بمطاعم تقدّم طعام ذوّاقة حقيقيّ

388
00:21:42,470 --> 00:21:44,820
.ذلك هو المستقبل الّذي يرغب به المركز

389
00:21:44,820 --> 00:21:47,700
.مطاعم المدينة الّتي تخدم العموم

390
00:21:47,700 --> 00:21:50,910
ذلك يعني أنّ المحلاّت مثل مطعم
...ميتامورا-سان الغربيّ

391
00:21:51,980 --> 00:21:56,290
،ومطعم عائلتي، مطعم يوكيهيرا الشّعبيّ
جميعها غير ضروريّة؟

392
00:21:56,290 --> 00:21:58,500
.نعم، ذلك صحيح

393
00:21:58,500 --> 00:22:03,340
حتّى إن عنى ذلك أنّ هنالك أشخاصًا
سيخسرون أماكن يهتمّون لأمرها كثيرًا؟

394
00:22:03,790 --> 00:22:05,710
.نعم، ذلك صحيح

395
00:22:05,710 --> 00:22:07,340
.أعتقد أنّ لا مفرّ من ذلك

396
00:22:15,510 --> 00:22:16,820
.فهمت

397
00:22:17,660 --> 00:22:22,070
.لا أظنّ أنّي مناسب لأكون مساعدك

398
00:22:26,140 --> 00:22:28,280
.لن أنضمّ للمركز

399
00:22:30,230 --> 00:22:33,300
!سأفوز بهذا التّحدّي

400
00:24:07,130 --> 00:24:10,460
!أتمنّى أن تكون الحلقة القادمة على ذوقكم