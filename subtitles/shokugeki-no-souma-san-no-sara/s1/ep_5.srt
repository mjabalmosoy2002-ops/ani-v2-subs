1
00:00:03,340 --> 00:00:05,980
أمّا المركز الأوّل فهو من نصيب

2
00:00:06,340 --> 00:00:08,980
.عربة يوكيهيرا للطّبخ الصّينيّ

3
00:00:12,650 --> 00:00:15,410
!كلاّ يا كوغا. لقد خسرت

4
00:00:15,410 --> 00:00:17,030
.عليّ فعل شيء ما

5
00:01:58,490 --> 00:02:00,890
...يوكيهيرا-تشين

6
00:02:01,660 --> 00:02:02,890
.سُحقًا

7
00:02:05,390 --> 00:02:07,600
.كنتُ وشيكًا للغاية

8
00:02:07,600 --> 00:02:10,400
!كوغا

9
00:02:10,400 --> 00:02:13,520
خسرتَ في المبيعات يا كوغا؟

10
00:02:13,520 --> 00:02:14,610
!كلاّ

11
00:02:14,610 --> 00:02:15,730
!ريندو-سينباي

12
00:02:16,520 --> 00:02:17,650
...الثّانية من النّخبة

13
00:02:17,650 --> 00:02:21,090
لا أمل منك، أليس كذلك يا كوغا؟

14
00:02:21,090 --> 00:02:22,160
صحيح يا كوغا؟

15
00:02:22,160 --> 00:02:23,730
!اخرسي

16
00:02:23,730 --> 00:02:28,120
لم تشاركي بكشك حتّى وكلّ ما تفعلينه
!هو التّجوال وملء فمك بالطّعام

17
00:02:28,590 --> 00:02:30,070
وماذا في ذلك؟

18
00:02:30,070 --> 00:02:32,960
.معاينة كلّ الطّعام هي طريقة للمشاركة أيضًا

19
00:02:32,960 --> 00:02:40,050
إضافة إلى أنّ انعزالك في مطعمك هو ما تسبّب
في خسارتك أمام زميلك الأصغر، صحيح؟

20
00:02:40,050 --> 00:02:41,970
!اخرسي، اخرسي، اخرسي

21
00:02:41,970 --> 00:02:44,620
!اخرسي! اخرسي

22
00:02:41,970 --> 00:02:44,620
.تغلّبتْ على كوغا-سينباي بالكلام

23
00:02:44,620 --> 00:02:46,890
.أشعر وكأنّي أشاهد شقيقين

24
00:02:47,340 --> 00:02:50,880
.لكنّه نال منّي بالفعل

25
00:02:50,880 --> 00:02:55,370
أعتقد أنّ كلّ شيء قد سار حسب
.خطّة يوكيهيرا-تشين

26
00:02:55,370 --> 00:02:56,850
—علينا إجراء تحدّي شوكوغيكي في أقرب

27
00:02:56,850 --> 00:02:58,010
عمّاذا تتحدّث؟

28
00:02:58,010 --> 00:02:59,990
لا يزال هنالك يوم آخر في مهرجان
وليمة القمر، صحيح؟

29
00:03:00,980 --> 00:03:01,870
ماذا؟

30
00:03:02,370 --> 00:03:04,690
إن لم أهزمك في مجموع المبيعات
،خلال فترة الأيّام الخمسة

31
00:03:04,690 --> 00:03:06,450
.فلن أكون قد فزت

32
00:03:06,800 --> 00:03:09,410
!لم ينتهِ القتال بعد

33
00:03:22,230 --> 00:03:25,760
.أنت تبذل جهدك يا يوكيهيرا سوما

34
00:03:25,760 --> 00:03:29,930
لكن بهذه الوتيرة، لا يبدو أنّ بإمكانك
الفوز بمجموع المبيعات، صحيح؟

35
00:03:30,330 --> 00:03:32,940
!لكنّك توشك على ذلك

36
00:03:32,940 --> 00:03:35,570
حسنًا، إنّ طريقة تخيّلي للموضوع

37
00:03:35,570 --> 00:03:37,910
،هو أني سأتمكّن من مجاراته حتّى اليوم الثّالث

38
00:03:37,910 --> 00:03:40,150
،وأسحقه في اليوم الرّابع

39
00:03:40,150 --> 00:03:44,290
.والفوز بمجموع المبيعات في اليوم الخامس

40
00:03:44,900 --> 00:03:47,030
.أنت متفائل للغاية

41
00:03:47,490 --> 00:03:50,300
،كنتُ واثقًا أنّ لديّ فرصة

42
00:03:50,300 --> 00:03:53,500
ولم أكن أنوي الخسارة في مواجهته
،في مجال المطاعم

43
00:03:53,890 --> 00:03:56,210
.لكن خاب ظنّي

44
00:03:56,810 --> 00:03:58,920
!أنت شخص صريح للغاية

45
00:04:27,170 --> 00:04:30,100
!هذا أفضل حتّى من السّنة الماضية

46
00:04:30,100 --> 00:04:31,330
،لكن عليّ الاعتراف في كلّ الأحوال

47
00:04:31,330 --> 00:04:34,920
.كدت أنفجر ضحكًا في لقاء موميجي سابقًا

48
00:04:35,510 --> 00:04:39,820
لم أعتقد أنّي قد أسمع شخصًا آخر
.يقول نفس الكلام الّذي قلتَه حينها

49
00:04:42,980 --> 00:04:46,100
.أريد الانضمام لنّخبة العشرة الآن

50
00:04:46,100 --> 00:04:49,050
فهل هنالك أيّ أحد منكم عازم
على قبول تحدّي شوكوغيكي منّي؟

51
00:04:49,050 --> 00:04:51,720
!طبعًا لا

52
00:04:55,220 --> 00:04:56,900
...المعذرة

53
00:04:56,900 --> 00:05:01,280
لا أريد سماع أيّ حديث مملّ حول تعرّفنا
.على بعض أفضل وما إلى ذلك

54
00:05:01,830 --> 00:05:04,990
هل هنالك أيّ أحد منكم عازم
على قبول تحدّي شوكوغيكي منّي؟

55
00:05:04,990 --> 00:05:07,220
ماذا تقول؟

56
00:05:07,220 --> 00:05:09,080
وكأنّ هزيمة عضو من العشرة
—النّخبة ستكون

57
00:05:09,080 --> 00:05:10,200
.أكيد

58
00:05:10,550 --> 00:05:12,700
هل يمكننا إقامة واحد اليوم، الآن؟

59
00:05:13,020 --> 00:05:15,660
.هذا إن كنت تقبل بتحدّيّ

60
00:05:26,840 --> 00:05:33,770
نحن تلاميذ السّنة الثّانية مشغولون جدًّا
.بمحاولة هزيمة من هم أعلى منّا أيضًا

61
00:05:33,770 --> 00:05:36,230
تسوكاسا-سان، كنت الرّقم واحد

62
00:05:36,230 --> 00:05:39,990
في المبيعات لخمسة أيّام على التّوالي
في المنطقة الوسطى السّنة الماضية، صحيح؟

63
00:05:40,410 --> 00:05:46,900
لذلك هل تعدني أنّه إن حقّقتُ
،نفس النّتيجة هذه السّنة

64
00:05:47,340 --> 00:05:49,900
فستقبل تحدّي شوكوغيكي آخر معي؟

65
00:05:51,500 --> 00:05:54,290
.في النّهاية، لم يحصل كوغا على أمنيته

66
00:05:54,290 --> 00:05:57,410
لم يفز يوكيهيرا سوما في مجموع
.المبيعات أيضًا

67
00:05:58,630 --> 00:06:01,690
.هذه هي ما تُدعى حرب بلا منتصرين

68
00:06:01,690 --> 00:06:03,880
.يبدو كلّ جانب خائب الظّنّ أيضًا

69
00:06:03,880 --> 00:06:05,230
!اخرسي

70
00:06:05,230 --> 00:06:07,840
.قد يواصل يوكيهيرا-كُن تقدّمه

71
00:06:09,060 --> 00:06:11,220
.أنت شخص صريح أيضًا يا كوغا

72
00:06:11,220 --> 00:06:12,430
!مستحيل

73
00:06:12,850 --> 00:06:16,390
.يعجبني يوكيهيرا سوما أيضًا

74
00:06:16,910 --> 00:06:19,170
.استعملنا كلّ المكوّنات بالكامل تقريبًا

75
00:06:19,170 --> 00:06:23,330
حقّقنا مبيعات جيّدة نوعًا ما
.في اليوم الأخير أيضًا. كنّا وشيكين

76
00:06:23,330 --> 00:06:25,530
.مهلاً يا يوكيهيرا سوما

77
00:06:25,530 --> 00:06:27,450
.لقد حجزت لك طاولة اللّيلة

78
00:06:27,450 --> 00:06:28,110
ماذا؟

79
00:06:28,110 --> 00:06:29,340
أيّ طاولة؟

80
00:06:29,340 --> 00:06:30,890
.في منطقة يامانوتي

81
00:06:30,890 --> 00:06:31,940
ستأتي، صحيح؟

82
00:06:32,700 --> 00:06:33,300
ماذا؟

83
00:06:33,300 --> 00:06:35,200
أين ذهب ميماساكا سوبارو؟

84
00:06:35,200 --> 00:06:39,510
لقد غادر باكرًا لأنّ عليه فتح
.أقفال أكثر من المعتاد

85
00:06:39,510 --> 00:06:42,670
أراهن أنّ الأمر سيأخذ منه وقتًا
.طويلاً إلى أن يركب درّاجته

86
00:06:43,040 --> 00:06:45,260
.حسنًا، ستحضران أنت وتادوكورو-تشان إذًا

87
00:06:45,260 --> 00:06:47,350
،بمجرّد أن تقفلا كشككما

88
00:06:47,350 --> 00:06:49,630
.لنذهب معًا إلى كشك تسوكاسا إيشي

89
00:06:50,150 --> 00:06:53,600
ألا يساورك الفضول لتعرف نوع الطّعام
الّذي يحضّره الأوّل في النّخبة العشرة؟

90
00:06:53,600 --> 00:06:57,330
!لنتّجه إلى منطقة يامانوتي

91
00:06:59,520 --> 00:07:00,940
!هذا مذهل

92
00:07:00,940 --> 00:07:02,060
!ما كلّ هذا؟

93
00:07:02,450 --> 00:07:04,820
.هذا ما هو متوقّع من منطقة يامانوتي

94
00:07:05,210 --> 00:07:08,500
.إنّها منطقة مختلفة تمامًا عن مثيلتيها

95
00:07:08,500 --> 00:07:09,320
.نعم

96
00:07:10,110 --> 00:07:13,820
تكون كلّ الأكشاك في المنطقة الوسطى
،قد أغلقت في هذا الوقت

97
00:07:13,820 --> 00:07:16,180
.لكن ما زالت كلّ الأكشاك هنا مستمرّة في العمل

98
00:07:16,180 --> 00:07:17,790
.قاعدة الزّبائن مختلفة

99
00:07:18,630 --> 00:07:22,550
معظمهم سيقضي اللّيلة في الحرم
.المدرسيّ أو منتجع توتسكي

100
00:07:22,550 --> 00:07:27,260
هذا يعني أنّ الكثير من الأمكنة تبدأ تقديم
.وجبات العشاء في هذا الوقت

101
00:07:27,260 --> 00:07:30,220
إ-إنّها باهظة الثّمن، صحيح؟

102
00:07:30,220 --> 00:07:32,620
.لا تقلقي يا تاداكورو-تشان

103
00:07:32,620 --> 00:07:34,970
.ستكون الدّعوة إلى مطعم تسوكاسا على حسابي

104
00:07:34,970 --> 00:07:37,650
بالتّفكير بالأمر، معظم النّخبة العشرة مثل ناكيري

105
00:07:37,650 --> 00:07:41,940
وإيشيكي-سينباي قد اختاروا هذه المنطقة، صحيح؟

106
00:07:52,660 --> 00:07:54,660
إذًا فالمبيعات تسير جيّدًا؟

107
00:07:54,660 --> 00:07:55,650
.جيّد

108
00:08:00,710 --> 00:08:01,710
!ماذا؟

109
00:08:01,710 --> 00:08:05,370
!كان يدير إيزان-سينباي عشرين كشكًا؟

110
00:08:05,370 --> 00:08:06,140
.نعم

111
00:08:06,140 --> 00:08:07,660
.لقد جنى الكثير

112
00:08:07,660 --> 00:08:10,300
.لا أصدّق أنّ تلميذًا يمكنه تحقيق ذلك

113
00:08:10,300 --> 00:08:12,900
ما الّذي كنت تفعلينه أنت يا ريندو-سينباي؟

114
00:08:13,440 --> 00:08:14,130
أنا؟

115
00:08:19,790 --> 00:08:23,300
!زرتِ كلّ الأكشاك المائة والعشرين في خمسة أيّام؟

116
00:08:23,300 --> 00:08:25,570
!كشك تسوكاسا هو الأخير

117
00:08:25,570 --> 00:08:26,650
!عملتُ جاهدة

118
00:08:26,650 --> 00:08:29,690
أنا لست واثقة أنّ ذلك شيء
.يمكن تحقيقه بالعمل بجهد

119
00:08:29,690 --> 00:08:32,280
.نخبة العشرة تعجّ بالبشر الخارقين

120
00:08:32,670 --> 00:08:34,280
ما الّذي تفعلانه؟

121
00:08:34,280 --> 00:08:36,240
!سوف أترككما وأذهب

122
00:08:59,050 --> 00:09:00,510
.يشبه الأمر مشاهدة المسرح

123
00:09:00,840 --> 00:09:03,980
.تسوكاسا-سينباي في عالمه الخاصّ

124
00:09:04,400 --> 00:09:06,780
هنالك ثلاث طاولات فحسب؟

125
00:09:06,780 --> 00:09:10,440
.يقوم تسوكاسا بكلّ الطّبخ بمفرده

126
00:09:10,440 --> 00:09:13,070
.كلّ ما يفعله بقيّة الموظّفين هو خدمة الزّبائن

127
00:09:13,070 --> 00:09:15,950
لذلك وجب عليه تقليل عدد
.الطّاولات لإنجاح الأمر

128
00:09:15,950 --> 00:09:18,850
يقوم بإعداد وجبة كاملة
!من تسعة أطباق بمفرده؟

129
00:09:18,850 --> 00:09:22,700
لا بدّ أنّ لديه ثقة كبيرة في نفسه
.إن كان سيقوم بكلّ العمل

130
00:09:23,010 --> 00:09:25,470
.السّبب الحقيقيّ أقرب لهذا

131
00:09:25,470 --> 00:09:28,230
كيف يمكنني حتّى التّفكير في السّماح
لشخص آخر بإنهاء أطباقي؟

132
00:09:28,230 --> 00:09:30,430
!هذا مرعب للغاية

133
00:09:30,430 --> 00:09:33,860
بمجرّد أن أبدأ القلق بشأن إمكانيّة
.إخفاقهم، لا أعود قادرًا على الطّبخ

134
00:09:38,660 --> 00:09:40,600
.يمكنكما تقديم هذا

135
00:09:40,600 --> 00:09:44,820
!كن حذراً رجاءً لكي لا تفسد الأطباق

136
00:09:44,820 --> 00:09:47,380
.احملها بحذر شديد

137
00:09:50,300 --> 00:09:51,240
ماذا؟

138
00:09:51,240 --> 00:09:54,600
هذا طبق قريدس ساكورا، صحيح؟

139
00:09:54,600 --> 00:09:57,030
ألا يعتبر واحدًا من مكوّنات الرّبيع الجوهريّة؟

140
00:09:57,030 --> 00:10:00,490
.ظننتُ أنّه سيكون حول مكوّنات الخريف

141
00:10:47,090 --> 00:10:49,250
!ثقا بتسوكاسا لينجح في هذا

142
00:10:49,250 --> 00:10:52,950
،معروف أنّ قريدس ساكورا هو مكوّن ربيعيّ

143
00:10:52,950 --> 00:10:55,750
لكنّه يكون قد نمى كثيرًا في الخريف

144
00:10:55,750 --> 00:10:58,760
.وطوّر نكهة قريدس أكثر حدّة

145
00:10:58,760 --> 00:11:02,810
إذًا فقد استفاد من ذلك بالمعرفة
.الكاملة لخصائص هذا المكوّن

146
00:11:07,180 --> 00:11:08,530
.مذهل

147
00:11:08,530 --> 00:11:11,590
يُظهر كلّ طبق صورًا عن المكوّنات

148
00:11:11,590 --> 00:11:14,150
تنبض بالحياة أكثر ممّا كانت عليه
!المكوّنات وهي حيّة

149
00:11:14,540 --> 00:11:18,270
وأطباق الوجبة الكاملة مبنيّة
،بحيث يتمّ تقديمُ طبق حلو خفيف

150
00:11:18,270 --> 00:11:20,270
.بعد طبق حمضيّ

151
00:11:20,690 --> 00:11:22,500
إنّه يغيّر إحساس كلّ طبق

152
00:11:22,500 --> 00:11:25,660
لمنع كلّ واحد منها من فقدان تأثيره
!في عرضٍ متوازنٍ مذهل

153
00:11:25,660 --> 00:11:29,740
وبينما يعدّل حرارة الطّبق وطريقة التّتبيل

154
00:11:30,230 --> 00:11:34,420
.بهدف التّغيير، يحافظ على تماسكها العامّ

155
00:11:34,760 --> 00:11:37,060
هذا مجال صعوبة مختلف كلّ الاختلاف

156
00:11:37,060 --> 00:11:39,010
.عن إعداد مجرّد طبق وحيد

157
00:11:39,010 --> 00:11:42,490
أنت بعيد كلّ البعد عن متناولي
!أيّها الأوّل بين النّخبة

158
00:11:49,330 --> 00:11:50,890
...يوكيهيرا سوما

159
00:11:50,890 --> 00:11:53,830
.تادوكورو-سان وريندو أيضًا

160
00:11:55,020 --> 00:11:56,590
هل الغرفة باردة؟

161
00:11:56,590 --> 00:11:57,270
هل أنتم بخير؟

162
00:11:57,270 --> 00:12:00,460
!أعلموني إن كانت الحرارة مرتفعة كثيرًا أيضًا

163
00:12:00,460 --> 00:12:02,460
هل المقاعد مريحة؟

164
00:12:02,460 --> 00:12:04,350
هل الإنارة خفيفة جدًّا؟

165
00:12:04,350 --> 00:12:07,450
،اسمع، إن واجهت الزّبائن كثيرًا بما يقلقك

166
00:12:07,450 --> 00:12:09,350
.فستجعلهم غير مرتاحين

167
00:12:10,160 --> 00:12:12,470
أليس كذلك يا تادوكورو-تشان؟

168
00:12:12,470 --> 00:12:13,260
...أنا

169
00:12:13,260 --> 00:12:14,460
.عفوًا، نعم

170
00:12:14,460 --> 00:12:15,130
.قليلاً

171
00:12:15,130 --> 00:12:16,860
!كلاّ

172
00:12:16,860 --> 00:12:19,330
!ماذا يفترض بي أن أفعل إذًا؟

173
00:12:19,330 --> 00:12:22,750
لهذا السّبب أقول دائمًا أنّ عليك
.التّحلّي بثقة أكبر

174
00:12:22,750 --> 00:12:26,780
.وكالعادة، لديك حسّ عالٍ للمكوّنات ذات الجودة

175
00:12:26,780 --> 00:12:27,890
.هذا مبهر

176
00:12:28,590 --> 00:12:29,810
،لكن إن سألتني

177
00:12:29,810 --> 00:12:33,270
.أودّ تجربة طبق تضمّن لمسة لشغفك للطّعام

178
00:12:33,660 --> 00:12:37,150
.كلاّ، لا أحتاج لأضع نفسي في طبخي

179
00:12:38,240 --> 00:12:41,530
يتضمّن عملي محو كلّ دليل
.عن مشاركتي في الطّبق

180
00:12:41,530 --> 00:12:46,110
.أركّز فقط على جودة المكوّنات وتحسينها

181
00:12:46,110 --> 00:12:51,690
لكن وبشكل متناقض، يتضمّن ذلك
.العملُ التّعبيرَ عن نفسي في الطّبق

182
00:12:51,690 --> 00:12:53,830
.هذا ما يُعرِّف طبخي

183
00:12:54,430 --> 00:12:57,460
.حسنًا إذًا، بالهناء والشّفاء

184
00:12:57,460 --> 00:13:03,010
مع الوقت، بدأ الذّوّاقة يصفون تسوكاسا

185
00:13:03,400 --> 00:13:06,190
بالشّخص الّذي ينحني أمام كلّ المكوّنات

186
00:13:06,190 --> 00:13:08,220
،ويكرّس نفسه وكبرياءه لها

187
00:13:09,180 --> 00:13:11,130
."دير فايس غيتر دير تافل"

188
00:13:14,170 --> 00:13:15,890
ألا يبدو ذلك رائعًا؟

189
00:13:15,890 --> 00:13:17,700
،عندما رأيت الاسم أوّل مرّة في مجلّة

190
00:13:17,700 --> 00:13:20,860
.انفجرت من الضّحك

191
00:13:21,380 --> 00:13:23,330
تادوكورو، هل لاحظت شيئًا؟

192
00:13:23,330 --> 00:13:24,070
ماذا؟

193
00:13:24,070 --> 00:13:26,750
،رغم أنّه يتصرّف بشكل متوتّر

194
00:13:26,750 --> 00:13:30,830
.لم يسألنا عن رأينا في الطّعام أبدًا

195
00:13:32,830 --> 00:13:36,710
لديه ثقة وتواضع مطلقين فيما
.يخصّ التّعامل مع المكوّنات

196
00:13:37,180 --> 00:13:39,790
.إنّه يختلف عن أيّ طاهٍ سبق وقابلته

197
00:13:40,110 --> 00:13:42,750
.هذا هو الأوّل بين النّخبة

198
00:13:44,190 --> 00:13:45,220
...إرينا-ساما

199
00:13:45,220 --> 00:13:47,750
.سوف ينتهي مهرجان وليمة القمر قريبًا

200
00:13:48,260 --> 00:13:49,430
.نعم

201
00:13:50,900 --> 00:13:53,930
.لن يحضر اليوم أيضًا

202
00:13:55,910 --> 00:13:57,830
.المعذرة يا سايبا-ساما

203
00:13:59,190 --> 00:14:02,690
.أريد أن أصبح طاهية محترمة مثلك

204
00:14:03,140 --> 00:14:06,440
هلاّ تذوّقت طبخي يومًا ما؟

205
00:14:06,790 --> 00:14:07,930
...نعم

206
00:14:07,930 --> 00:14:14,200
حسنًا، سأقبل عرضك عندما
.تصبحين طاهية جيّدة

207
00:14:14,200 --> 00:14:18,220
.أتطلّع قدُمًا لليوم الّذي سأتذوّق فيه ما تعدّينه

208
00:14:21,150 --> 00:14:24,090
.كلّ هذا لأجل يوم قدومه بعد طول انتظار

209
00:14:26,230 --> 00:14:29,210
.حضر كلّ الضّيوف الّذين قاموا بالحجز

210
00:14:29,210 --> 00:14:30,710
.سأذهب لألقي نظرة

211
00:14:30,710 --> 00:14:31,820
...لا يُعقل

212
00:14:36,410 --> 00:14:37,870
.المعذرة يا سيّدي

213
00:14:37,870 --> 00:14:39,940
.هذا المطعم يقبل أصحاب الحجز فقط

214
00:14:39,940 --> 00:14:41,440
هيساكو؟

215
00:14:46,630 --> 00:14:48,920
.لم أرك منذ مدّة يا إرينا

216
00:14:48,920 --> 00:14:50,110
...أبي

217
00:14:53,460 --> 00:14:55,900
.كان ذلك طعامًا مذهلاً حقًّا

218
00:14:55,900 --> 00:14:57,930
.لقد تملّكني شعور غامر بسببه

219
00:14:57,930 --> 00:15:00,830
من كان يدري بوجود عالم كهذا
في مجال الطّبخ؟

220
00:15:01,500 --> 00:15:02,290
سوما-كُن؟

221
00:15:02,290 --> 00:15:03,620
!هذا مثير للاهتمام

222
00:15:03,620 --> 00:15:05,530
!ليس عليّ الاستخفاف بمنطقة يامانوتي

223
00:15:05,530 --> 00:15:06,800
.إنّه متحمّس للغاية

224
00:15:06,800 --> 00:15:09,120
!أريد أن أعاين المزيد من المطاعم

225
00:15:09,120 --> 00:15:11,300
.لكن ليس لدينا أيّ بطاقات صنوبر أو ما شابه

226
00:15:11,300 --> 00:15:13,430
.صحيح، لكن هنالك كشك ناكيري

227
00:15:13,430 --> 00:15:14,940
—ماذا؟ لكن

228
00:15:14,940 --> 00:15:16,890
...لا بأس. في أوّل يوم من المهرجان

229
00:15:16,890 --> 00:15:18,820
!خذي خبز فلفل أسود

230
00:15:18,820 --> 00:15:19,920
.لا تخجلي

231
00:15:19,920 --> 00:15:21,440
!قلت أنّي لا أريد

232
00:15:21,440 --> 00:15:23,890
.من الجيّد أنّها مدينة لي

233
00:15:23,890 --> 00:15:26,360
.أعتقد أنّك أجبرتها فحسب

234
00:15:27,330 --> 00:15:28,070
.الـ-المعذرة

235
00:15:28,070 --> 00:15:29,150
!هذا غير مقبول تمامًا

236
00:15:29,500 --> 00:15:35,310
!إرينا، طبخك لا يستحقّ مجموعة متدنّية كهذه

237
00:15:37,210 --> 00:15:39,840
.عليك أن تختاري زبائنك بشكل أفضل

238
00:15:39,840 --> 00:15:42,460
.أنت تقلّلين من نفسك

239
00:15:46,800 --> 00:15:48,370
.يا فتى

240
00:15:48,370 --> 00:15:51,760
هل تقول ذلك وأنت تعلم من نكون؟

241
00:15:51,760 --> 00:15:53,730
!هل تعلم؟

242
00:15:53,730 --> 00:15:55,870
.أنا أتذكّره

243
00:15:55,870 --> 00:15:57,740
...هل هو من عائلة ناكيري

244
00:15:58,660 --> 00:15:59,520
!لا يعقل

245
00:15:59,520 --> 00:16:02,640
!لقد تمّ إبعادك من توتسكي

246
00:16:03,180 --> 00:16:05,980
،بالفعل، أنا ناكيري أزامي

247
00:16:06,490 --> 00:16:08,610
.والد ناكيري إرينا

248
00:16:09,360 --> 00:16:13,820
.والد إرينا-ساما... ناكيري أزامي

249
00:16:14,820 --> 00:16:18,540
رأيت صورته من قبل عندما
.كنت في مكتبة الأكاديميّة

250
00:16:19,850 --> 00:16:26,640
هيساكو، لا تطرحي أيّ أسئلة
.عن والد إرينا-ساما على أيّ أحد

251
00:16:26,640 --> 00:16:27,380
هل تفهمين؟

252
00:16:29,840 --> 00:16:33,300
.لقد مُحي بالكامل من حياة عائلة ناكيري

253
00:16:33,300 --> 00:16:35,800
ما الّذي يملكه هذا الرّجل وجعل
إرينا-ساما في هذه الحالة؟

254
00:16:36,530 --> 00:16:39,300
كيف تتجرّؤ على التّصرّف بتعالٍ هكذا
رغم إبعادك عن المدرسة؟

255
00:16:39,300 --> 00:16:43,550
.نحن شركاء عمل رسميّين مع أكاديميّة توتسكي

256
00:16:43,550 --> 00:16:45,280
.أحسنت يا أختي

257
00:16:45,280 --> 00:16:49,650
لذلك فإنّ إهانتنا هي بمثابة إهانة
.في حقّ توتسكي بحدّ ذاتها

258
00:16:50,290 --> 00:16:54,400
.لقد عدت لأصحّح المسار الّذي تسلكه توتسكي

259
00:16:54,400 --> 00:16:55,820
ماذا قلت؟

260
00:16:56,220 --> 00:16:58,850
،لكلّ من يدّعون المعرفة في مجال الطّعام

261
00:16:58,850 --> 00:17:01,020
.أتساءل كم منكم بالفعل يفهم المذاق الحقيقيّ

262
00:17:01,020 --> 00:17:04,250
،كحال كلّ الفنون الرّفيعة الّتي في أسمى مستوياتها

263
00:17:04,250 --> 00:17:07,270
لا يمكن إدراك قيمتها الحقيقيّة

264
00:17:07,270 --> 00:17:13,210
إلاّ ممّن يملكون ذوقًا ومكانة
.وتلقّوا تعليمًا مناسبًا

265
00:17:13,210 --> 00:17:15,580
.طعام الذّوّاقة مشابه تمامًا لذلك

266
00:17:15,580 --> 00:17:19,600
.يجب على قيمته أن تُشارك بين نخبة مختارة فقط

267
00:17:20,050 --> 00:17:22,560
.ذلك هو ما يستحقّ أن يسمّى طعامًا

268
00:17:23,100 --> 00:17:25,470
.وكلّ شيء آخر عداه ليس طعامًا

269
00:17:25,470 --> 00:17:26,390
.إنّه علف حيوانات

270
00:17:27,390 --> 00:17:31,780
لا أتوقّع أن يفهم ذلك أولئك الّذين
يعتقدون على نحو خاطئ

271
00:17:31,780 --> 00:17:34,490
أنّه طعام ذوّاقة ما دامت تستعمل
.فيه المكوّنات الرّفيعة

272
00:17:34,490 --> 00:17:36,240
—يا لك من وغد

273
00:17:36,590 --> 00:17:38,800
،شكرًا على مشاركتنا رأيك القيّم

274
00:17:38,800 --> 00:17:41,810
.لكنّ كلامك لا وزن له هنا مهما كان

275
00:17:41,810 --> 00:17:42,970
!صحيح

276
00:17:42,970 --> 00:17:46,210
!ليست لديك أيّ سلطة على شؤون توتسكي

277
00:17:46,520 --> 00:17:48,660
.الأصل المناسب موجود هنا بالفعل

278
00:17:48,660 --> 00:17:50,170
.وكذلك التّعليم الجيّد

279
00:17:51,750 --> 00:17:52,910
.والآن يا إرينا

280
00:17:53,410 --> 00:17:57,300
.مرّ عقد من الزّمن مذ علّمتك كيف تطبخين

281
00:17:57,690 --> 00:18:01,260
.أريد أن أرى إلى أيّ مدى صقلتِ مواهبك

282
00:18:01,260 --> 00:18:04,730
،كـ-كما قلت من قبل
.نحن لا نستقبل زبائن بدون حجز

283
00:18:04,730 --> 00:18:07,230
.أرى طاولة شاغرة هناك

284
00:18:07,230 --> 00:18:08,730
—تلك من أجل

285
00:18:10,110 --> 00:18:11,790
.القائمة لو سمحت

286
00:18:11,790 --> 00:18:13,810
.والدك جائع

287
00:18:13,810 --> 00:18:15,780
.أريد أكل شي بسرعة

288
00:18:16,730 --> 00:18:19,280
!إرينا-ساما

289
00:18:20,530 --> 00:18:22,240
...حا-حا

290
00:18:29,000 --> 00:18:30,450
.مرحبًا يا ناكيري

291
00:18:30,450 --> 00:18:31,950
هل هنالك طاولة شاغرة؟

292
00:18:33,490 --> 00:18:35,460
يوكيهيرا-كُن؟

293
00:18:37,380 --> 00:18:38,620
.مرحبًا

294
00:18:38,620 --> 00:18:42,350
آسف، هل يمكننا تناول طبخك
رغم أنّه ليس لدينا حجز؟

295
00:18:42,750 --> 00:18:44,890
.تفضّلي، سأعطيك رغيف خبز فلفل أسود آخر

296
00:18:47,350 --> 00:18:48,540
ماذا؟

297
00:18:48,540 --> 00:18:51,810
.أشعر بالكثير من الضّغط في هذه الغرفة لسبب ما

298
00:18:51,810 --> 00:18:53,910
.المعذرة

299
00:18:53,910 --> 00:18:55,940
.يبدو أنّك توشك على تناول الطّعام أيضًا

300
00:18:56,700 --> 00:19:01,200
ربّما يمكننا تشارك الطّاولة إن لم تمانع؟

301
00:19:01,770 --> 00:19:04,780
.إرينا، عليك أن تختاري أصدقاءك بشكل أفضل

302
00:19:06,130 --> 00:19:07,790
!يوكيهيرا سوما

303
00:19:08,540 --> 00:19:10,110
.لقد فقدت شهيّتي

304
00:19:14,340 --> 00:19:16,560
أراتو-سان، من ذلك الرّجل؟

305
00:19:16,560 --> 00:19:18,380
.إنّه والد إرينا-ساما

306
00:19:18,380 --> 00:19:19,050
!ماذا؟

307
00:19:19,380 --> 00:19:21,450
ما خطب صاحب البدلة السّوداء ذاك؟

308
00:19:21,450 --> 00:19:22,890
.عليه تناول الطّعام على الأقلّ قبل ذهابه

309
00:19:24,550 --> 00:19:25,970
ناكيري؟

310
00:19:25,970 --> 00:19:27,060
لماذا ترتعشين؟

311
00:19:37,570 --> 00:19:40,890
.كنت أوشك على زيارتك

312
00:19:41,790 --> 00:19:44,200
.هذا الاستقبال لشرف عظيم

313
00:19:45,050 --> 00:19:47,810
.تبدو في حال جيّدة يا والدي

314
00:19:48,510 --> 00:19:49,570
!ارحل

315
00:19:50,110 --> 00:19:53,250
.لا يحقّ لك أن تخطو خطوة واحدة في هذا المكان

316
00:19:54,190 --> 00:19:59,210
أخبرتك أنّي أمنعك من استعمال
.اسم ناكيري على الإطلاق

317
00:19:59,210 --> 00:20:04,780
أنا من صقل "لسان الإله" الّذي ولدت به
.إرينا ليصبح ما هو عليه الآن

318
00:20:04,780 --> 00:20:06,810
،ربّما تكون قد أبعدتني

319
00:20:06,810 --> 00:20:09,220
.لكنّ أصلي وتعليمي لا يمكن محوهما

320
00:20:09,680 --> 00:20:14,980
أكبر أخطائي كان السّماح لك
.بالاعتناء بإرينا حينها

321
00:20:15,420 --> 00:20:18,030
.لم يكن خطأك وحدك

322
00:20:18,030 --> 00:20:21,620
إن بقيت، ما كنت لأسمح لتوتسكي
،بأن تغدو ما أمست عليه الآن

323
00:20:22,030 --> 00:20:24,950
.مكان يعجّ بالأشخاص العاديّين البشعين

324
00:20:24,950 --> 00:20:27,200
.يا يوكيهيرا سوما

325
00:20:27,200 --> 00:20:28,610
.ها أنت هنا

326
00:20:28,610 --> 00:20:30,290
.ماذا؟ ريندو-سينباي

327
00:20:30,780 --> 00:20:33,220
،رأيت مجموعة من السّيّارات السّوداء تتسارع

328
00:20:33,220 --> 00:20:36,130
.لذلك لحقتها وأنا أتساءل عمّا يجري

329
00:20:36,490 --> 00:20:39,300
،نحن لا نعرف أيضًا

330
00:20:39,300 --> 00:20:42,130
.لكن يبدو أنّ والد ناكيري أتى فجأة

331
00:20:42,460 --> 00:20:43,500
...هكذا

332
00:20:44,670 --> 00:20:47,740
!الطّبخ هو كلّ شيء في هذه الأكاديميّة

333
00:20:47,740 --> 00:20:50,830
،ما داموا يملكون الموهبة
.فيستطيع أيّ أحد تسلّق السّلّم

334
00:20:50,830 --> 00:20:53,100
.ذلك هو تقليد توتسكي

335
00:20:53,100 --> 00:20:54,500
.هراء

336
00:20:54,500 --> 00:20:59,650
السّماح لتلاميذ دون المستوى بالتّعفّن هنا
بينما الهدف هو خلق طعام ذوّاقة حقيقيّ

337
00:20:59,650 --> 00:21:01,400
.لحماقة خالصة

338
00:21:01,400 --> 00:21:04,150
.التّقرير بشأن ذلك يقع بين أيدينا

339
00:21:04,720 --> 00:21:10,030
أولئك الّذين يقرّرون مستقبل توتسكي
!هم طهاة يافعون ببأس وموهبة شديدين

340
00:21:10,520 --> 00:21:14,140
!لن يغيّر كلامك وحدك أيّ شيء

341
00:21:16,040 --> 00:21:21,650
مجلس النّخبة العشرة يملك سلطة تعادل

342
00:21:21,650 --> 00:21:24,510
.مدير الأكاديميّة أو ربّما تفوقه

343
00:21:25,230 --> 00:21:28,920
على سبيل المثال، إن رغبت أغلبيّة
مجلس النّخبة العشرة

344
00:21:28,920 --> 00:21:31,010
.من شخص ما أن يدير الأكاديميّة

345
00:21:31,540 --> 00:21:34,440
يوكيهيرا سوما، أيّ جانب ستختار؟

346
00:21:34,440 --> 00:21:35,320
ماذا؟

347
00:21:35,320 --> 00:21:37,400
.لا فكرة لديّ عمّا يجري

348
00:21:37,400 --> 00:21:38,990
فعلاً؟

349
00:21:38,990 --> 00:21:42,610
وأنا الّتي توقّعتُ أنّك ستنضمّ إلينا
.أيضًا في لمح البصر

350
00:21:42,610 --> 00:21:43,610
أيضًا"؟"

351
00:21:45,020 --> 00:21:46,570
ما-ما هذا؟

352
00:21:47,030 --> 00:21:50,700
وافقت أغلبيّة مجلس النّخبة
.العشرة على إجراء تعديل

353
00:21:51,040 --> 00:21:55,660
.لقد دعموا تعييني كمدير جديد للأكاديميّة

354
00:21:58,620 --> 00:22:01,180
.هنالك موجة جديدة قادمة

355
00:22:01,180 --> 00:22:05,550
يبدو أنّ ركوب تلك الموجة
.هو سيكون أكثر حماسًا

356
00:22:11,180 --> 00:22:16,640
أقوى مجموعة في أكاديميّة توتسكي
!أصبحت خائنة؟

357
00:22:17,030 --> 00:22:20,770
.سيكون كلّ شيء قد تمّ غدًا في نفس هذا الوقت

358
00:22:22,150 --> 00:22:27,320
،هنا في مملكة طعام الذّوّاقة
،جوهرة اليابان

359
00:22:28,220 --> 00:22:30,030
.سأكون الملك الجديد

360
00:24:04,000 --> 00:24:06,000
توتسكي

361
00:24:07,150 --> 00:24:11,010
!أتمنّى أن تكون الحلقة القادمة على ذوقكم