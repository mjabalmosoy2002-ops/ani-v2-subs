1
00:00:04,830 --> 00:00:07,190
.لقد جمعت قوّة من خمسين رجلاً

2
00:00:07,650 --> 00:00:12,650
وبعد ساعة، سأتوصّل بتقرير
.عن انتهاء عمليّة الطّرد

3
00:00:12,650 --> 00:00:17,180
وبهذا، يكون أصدقاؤك العزيزون
.في ورطة حقيقيّة الآن

4
00:00:17,180 --> 00:00:18,630
هل خاب ظنّك؟

5
00:00:18,630 --> 00:00:21,130
مسكنك الغالي سوف يُقفل، صحيح؟

6
00:00:21,130 --> 00:00:22,790
.كلّ هذا بلا فائدة

7
00:00:22,790 --> 00:00:26,080
.لا يهمّ إن فزت أم خسرت في هذا الشّوكوغيكي

8
00:00:26,080 --> 00:00:28,460
أما زلت تريد مواصلة التّحدّي؟

9
00:00:30,920 --> 00:00:32,250
!لننطلق

10
00:00:32,250 --> 00:00:34,340
!ابدؤوا عمليّة الطّرد

11
00:00:41,070 --> 00:00:42,980
.كلاّ... لا أريد هذا

12
00:00:43,300 --> 00:00:48,610
!لا أريد خسارة مسكننا. مستحيل

13
00:02:23,830 --> 00:02:25,740
...إيزان إتسويا

14
00:02:26,050 --> 00:02:27,450
!يا لك من جبان

15
00:02:27,880 --> 00:02:28,830
!يوكيهيرا

16
00:02:29,550 --> 00:02:31,540
أخبرني يا إيزان-سينباي؟

17
00:02:31,940 --> 00:02:34,920
،إن فزتُ بهذا الشّوكوغيكي

18
00:02:35,260 --> 00:02:38,420
فستلغي عمليّة الطّرد من مسكن
النّجم القطبيّ أيضًا، صحيح؟

19
00:02:40,100 --> 00:02:42,130
.نعم، ذلك أكيد

20
00:02:42,130 --> 00:02:44,350
.لا بأس إذًا

21
00:02:44,350 --> 00:02:45,640
.سوف أركّز على طبخي

22
00:02:48,270 --> 00:02:50,440
ما الّذي ستطبخه إذًا؟

23
00:02:50,860 --> 00:02:52,190
.سوف أطبخ الغيوزا

24
00:02:52,530 --> 00:02:53,310
...غيوزا

25
00:02:53,310 --> 00:02:55,490
قال الغيوزا؟

26
00:02:55,490 --> 00:02:59,140
طبخ طعام مألوف من مكوّنات الذّوّاقة؟

27
00:02:59,140 --> 00:03:01,080
.أفترض أنّ هذا مبتكر

28
00:03:01,080 --> 00:03:02,280
.بالفعل

29
00:03:02,600 --> 00:03:07,380
تعرف أنّك إن فشلت، فستدمّر المذاق الرّفيع
المتخلّف في الفم لدجاج ساتسوما، صحيح؟

30
00:03:07,380 --> 00:03:08,910
.حسنًا، شاهدي فحسب

31
00:03:08,910 --> 00:03:11,290
—كفاك عبثًا يا ريندو

32
00:03:11,290 --> 00:03:12,310
ماذا؟

33
00:03:12,310 --> 00:03:13,290
.سينباي

34
00:03:14,030 --> 00:03:18,380
بعد تجهيز الدّجاج، سأترك اللّحم
.يرتاح دون أن يلامس الهواء

35
00:03:18,380 --> 00:03:21,720
في ذلك الوقت، سأفرم الثّوم المعمّر
!والملفوف وفطر الشّيتاكي

36
00:03:22,040 --> 00:03:24,050
!ولن أنسى الزّنجبيل والثّوم

37
00:03:24,050 --> 00:03:29,140
ومن أجل التّتبيل، سأجمع بين صلصة الصّويا
.والفلفل الأسود وصلصة المحّار

38
00:03:29,140 --> 00:03:32,030
لماذا علينا إزعاج أنفسنا بمشاهدتك؟

39
00:03:32,600 --> 00:03:34,240
.اسمع يا يوكيهيرا

40
00:03:34,240 --> 00:03:36,490
.لنكفّ عن التّظاهر للحظة

41
00:03:36,490 --> 00:03:38,480
.يعرف كلانا من سيفوز

42
00:03:38,480 --> 00:03:40,610
.لن يكون لديك منزل لتعود إليه أيضًا

43
00:03:40,610 --> 00:03:44,370
هذه هي النّتيجة بعد أن قرّرت أن تكون
!البطل وتواجهني في تحدّي شوكوغيكي

44
00:03:44,370 --> 00:03:45,880
!اعترف

45
00:03:45,880 --> 00:03:48,950
!فقدت كلّ ما يحفّزك للطّبخ، صحيح؟

46
00:03:48,950 --> 00:03:50,700
ما ردّك يا يوكيهيرا؟

47
00:03:52,920 --> 00:03:55,740
أجل؟ هل انتهيتم من عمليّة الطّرد؟

48
00:03:55,740 --> 00:03:56,640
!كـ-كلاّ

49
00:03:56,640 --> 00:03:57,650
...نحن في الحقيقة

50
00:03:57,650 --> 00:03:58,250
ماذا؟

51
00:03:58,250 --> 00:03:59,340
!أطلقوا

52
00:04:00,700 --> 00:04:02,510
!إنّهم يقاتلوننا بشدّة

53
00:04:06,720 --> 00:04:09,680
.لن أسمح بإقفال مسكن النّجم القطبيّ

54
00:04:09,970 --> 00:04:11,430
!أبدًا

55
00:04:11,430 --> 00:04:14,630
.عرفت أنّكم ستقولون ذلك يا أطفال

56
00:04:14,630 --> 00:04:15,650
!فوميو-سان

57
00:04:18,540 --> 00:04:20,650
يا مديرة المسكن، ما هذه؟

58
00:04:20,650 --> 00:04:24,250
إنّها آثار قديمة من العهد الذّهبيّ
!لمسكن النّجم القطبيّ

59
00:04:24,250 --> 00:04:28,970
حينها، كنّا ناجحين للغاية لدرجة
.أنّنا اكتسبنا الكثير من الكره

60
00:04:28,970 --> 00:04:33,180
.كان التّلاميذ الآخرون يهاجمون هذا المكان مرارًا

61
00:04:33,180 --> 00:04:34,670
.لم أكن أعرف

62
00:04:34,670 --> 00:04:37,590
،لـ-لكن حتّى إن صمدنا ودافعنا عن أنفسنا

63
00:04:37,590 --> 00:04:39,590
.فإنّ النّتيجة لن تتغيّر

64
00:04:39,590 --> 00:04:40,670
.صحيح

65
00:04:40,670 --> 00:04:44,340
،لكنّ سوما-كُن يقاتل من أجلنا جميعًا بمفرده

66
00:04:44,790 --> 00:04:45,840
...لذلك على الأقلّ

67
00:04:46,310 --> 00:04:48,680
نريد على الأقلّ أن ندافع عن المسكن
.حتّى نهاية تحدّي يوكيهيرا

68
00:04:49,160 --> 00:04:51,470
.وحتّى ذلك الحين، علينا حماية المسكن

69
00:04:51,800 --> 00:04:55,560
لن نسمح ليوكيهيرا أن يكون الوحيد
.الّذي يقاتل من أجل المسكن

70
00:04:55,560 --> 00:04:58,980
!من أجل النّجم القطبيّ! لنقاتل

71
00:04:58,980 --> 00:05:01,070
!أجل

72
00:05:08,700 --> 00:05:11,580
!لماذا أنتم عنيدون جميعًا؟

73
00:05:11,580 --> 00:05:12,910
...إيزان-سينباي

74
00:05:13,730 --> 00:05:18,880
،يبدو أنّك تحبّ التّلاعب بالأمور بشدّة

75
00:05:19,350 --> 00:05:23,510
،لكن إن كان لديك ما تخبرني به
فهلاّ فعلتَ ذلك عن طريق طبخك؟

76
00:05:24,090 --> 00:05:24,970
.حسنًا

77
00:05:25,290 --> 00:05:27,050
.فهمت يا يوكيهيرا

78
00:05:27,440 --> 00:05:31,600
،أعتقد أنّه إن كان عليّ تحطيمك
.فسيكون عليّ أن أطبخ

79
00:05:31,600 --> 00:05:32,670
!أجل

80
00:05:32,670 --> 00:05:35,730
!نستطيع أن نتذوّق طبخ إيزان-دونو الجادّ

81
00:05:36,460 --> 00:05:39,400
!كان السّماح لهذه التمثيليّة بالحدوث يستحقّ ذلك

82
00:05:39,750 --> 00:05:41,820
.حسنًا، لقد قرّرت ما سأطبخه

83
00:05:42,250 --> 00:05:47,110
سأقدّم تحفة فنّيّة لا تقلّل ولا تبالغ
.في استعمالات نكهات دجاج ساتسوما

84
00:05:47,420 --> 00:05:50,700
.تذوّق طبقي أيضًا يا يوكيهيرا

85
00:05:50,700 --> 00:05:54,700
على الأقلّ سيسمح ذلك لك بإدراك
.مدى ارتفاع مستواي عنك

86
00:05:55,010 --> 00:05:58,260
،نظرًا للمكوّنات والتّوابل الّتي اختارها إيزان

87
00:05:58,260 --> 00:06:00,420
.فسيعدّ ذلك الطّبق على الأرجح

88
00:06:03,380 --> 00:06:05,210
!لقد وضع الطّائر بأكمله في القِدر

89
00:06:05,210 --> 00:06:06,510
!يا للجرأة

90
00:06:08,930 --> 00:06:11,430
.لن ألمسه لحوال نصف ساعة

91
00:06:11,880 --> 00:06:16,260
سأستغلّ الحرارة الكامنة في القدر
.لطبخ الدّجاج ببطء بالكامل

92
00:06:16,260 --> 00:06:21,150
تسمح هذه العمليّة بالحفاظ
على طراوة دجاج ساتسوما

93
00:06:21,150 --> 00:06:24,650
.لخلق إحساس رائع وليّن في الفم

94
00:06:25,000 --> 00:06:30,280
خبرته في قياس مدى نضج الطّعام ستُمتحن
.بالنّظر إلى أنّه يستعمل الطائر بالكامل

95
00:06:30,280 --> 00:06:34,780
إنّه يقلي الجلد للتّخلّص ببطء
.من الدّهون بينما يُطبخ الدّجاج

96
00:06:34,780 --> 00:06:35,710
.نعم

97
00:06:35,710 --> 00:06:38,790
إضافة لذلك، يستعمل الدّهون
الخفيفة والغنيّة بالنّكهة

98
00:06:38,790 --> 00:06:42,040
.لقلي الثّوم والزّنجبيل والأرزّ النّيء

99
00:06:44,380 --> 00:06:46,580
ما الّذي تحدّق به يا يوكيهيرا؟

100
00:06:46,580 --> 00:06:48,840
...حسنًا، أعني

101
00:06:48,840 --> 00:06:52,720
.كنت أفكّر وأقول أنّك تجيد الطّبخ بالفعل

102
00:06:53,810 --> 00:06:56,350
.أنت الأفضل يا يوكيهيرا

103
00:06:56,820 --> 00:06:58,730
.أفهم ما الّذي دفعك لتقول ذلك

104
00:06:58,730 --> 00:07:02,060
.يبدو إيزان كرجل عصابات ذكيّ بشكل عامّ

105
00:07:02,610 --> 00:07:06,020
.قد لا يبدو عليه ذلك، لكنّه بارع للغاية

106
00:07:06,020 --> 00:07:08,570
،لو لم ينشغل كثيرًا بعمله  كمستشار

107
00:07:08,890 --> 00:07:13,780
لكان العديد من أعضاء النّخبة العشرة
.الحاليّين قد خسروا مراتبهم لصالحه

108
00:07:16,340 --> 00:07:21,670
أوّلاً، أخبرنا رجاءً لماذا اجتزت امتحان الدّخول
لهذه الأكاديميّة يا إيزان إتسويا-كُن؟

109
00:07:22,120 --> 00:07:23,630
.لأنّي أريد جني المال

110
00:07:25,070 --> 00:07:28,980
مدخول إيزان الكامل من عمله
كمستشار في سنته الأولى

111
00:07:28,980 --> 00:07:33,050
تجاوز المجموع الكامل لمصاريف
.التّعليم لكلّ تلاميذ تلك السّنة

112
00:07:33,420 --> 00:07:38,620
لقد استعمل علاقات توتسكي
!وقام بأزيد من 500 استشارة

113
00:07:38,620 --> 00:07:40,770
يضمّ امتداد استشاراته مجموعة
،من المجالات والطّلبات المختلفة

114
00:07:40,770 --> 00:07:43,060
.تجاوز أداؤه الكمال في كلّ واحدة منها

115
00:07:43,450 --> 00:07:48,770
كانت هذه الميزة لتكون مستحيلة
إلاّ إن امتلك إدراكًا بديهيًّا وشاملاً

116
00:07:48,770 --> 00:07:50,600
!لمجالات طبخ ونكهات لا تحصى

117
00:07:50,600 --> 00:07:53,130
قرار قبوله في صفوف النّخبة
.العشرة كان بالإجماع

118
00:07:53,130 --> 00:07:56,830
.هكذا كانت مساهماته الماليّة للأكاديميّة لا تقبل الجدل

119
00:07:57,170 --> 00:07:59,980
.كان بلا شكّ الخيميائيّ

120
00:07:59,980 --> 00:08:02,290
!إنّه يستحقّ ذلك اللّقب

121
00:08:07,290 --> 00:08:11,340
إنّه يأخذ أرزّ الياسمين النّيء الّذي قلاه
...بينما كان المرق ينضج

122
00:08:11,340 --> 00:08:17,220
وطبخه في المرق الصّافي المليء
.بأومامي الدّجاج رفيع

123
00:08:17,220 --> 00:08:19,880
،هذا لا يغتفر كرجل أعمال

124
00:08:19,880 --> 00:08:22,560
.لكنّي سأغضّ النّظر عن التّكلفة والأرباح اليوم

125
00:08:22,560 --> 00:08:24,100
!التّفكير الاستراتيجيّ هو كلّ شيء في الطّبخ

126
00:08:24,520 --> 00:08:25,850
!لا فرصة لديك للفوز

127
00:08:25,850 --> 00:08:28,570
ومع ذلك واجهتني في تحدّي
!شوكوغيكي دون خطّة مسبقة

128
00:08:28,940 --> 00:08:31,780
!اندم على ذلك وغادر توتسكي

129
00:08:31,780 --> 00:08:35,190
أكيد. ليس لديّ أيّ شيء يمكنك
،أن تصفه بالاستراتيجيّة

130
00:08:35,190 --> 00:08:38,160
.لكنّي لم أتحدّاك دون أن أمتلك فرصة للفوز

131
00:08:39,280 --> 00:08:43,620
هنالك أمر أردت أن أريه لك
.في تحدّي الشّوكوغيكي هذا

132
00:08:43,620 --> 00:08:47,590
لذلك لا تنسوا هذا أيّها الحكّام
!واستعدّوا لما هو قادم

133
00:08:48,210 --> 00:08:49,450
!ها نحن أولاء

134
00:08:50,420 --> 00:08:51,420
...الغيوزا

135
00:08:51,730 --> 00:08:53,050
!إنّها مختلفة عن الغيوزا العاديّة

136
00:08:53,590 --> 00:08:55,930
.إنّه لا يستعمل التّغليف الّذي أساسه القمح كالمعتاد

137
00:08:55,930 --> 00:08:59,100
بل يستعمل الأجنحة بحدّ ذاتها للتّغليف؟

138
00:08:59,780 --> 00:09:01,310
.فهمت

139
00:09:01,310 --> 00:09:03,740
لقد أزال العظام الكبيرة والصّغيرة من الجناح

140
00:09:03,740 --> 00:09:05,710
.وملأ مكانها بالحشوة

141
00:09:05,710 --> 00:09:08,610
.إنّها غيوزا أجنحة دجاج ساتسوما

142
00:09:08,610 --> 00:09:09,980
!أصبت

143
00:09:11,430 --> 00:09:13,440
.رائحتها زكيّة

144
00:09:13,440 --> 00:09:16,420
تتكوّن الحشوة من لحم الخنزير المفروم
.والثّوم المعمّر والملفوف وفطر الشّيتاكي

145
00:09:16,420 --> 00:09:18,910
.كما أنّه لحم خنزير مفروم بشكل خشن

146
00:09:18,910 --> 00:09:20,340
!بسرعة، بسرعة

147
00:09:20,340 --> 00:09:22,120
!أنهِ الطّبخ بسرعة

148
00:09:22,120 --> 00:09:24,040
هل ستجرّبينه أيضًا يا ريندو-سينباي؟

149
00:09:24,040 --> 00:09:26,620
.حسنًا، لا بأس بذلك فقد أعددت زيادة

150
00:09:26,620 --> 00:09:28,050
.هذا بلا فائدة

151
00:09:28,050 --> 00:09:31,660
.أيّها الفتى، لست بحاجة لإعداد أيّ شيء لنا

152
00:09:31,660 --> 00:09:34,380
...لا نحتاج لتذوّق شيء

153
00:09:34,380 --> 00:09:36,010
...يعتبر بكلّ شدّة

154
00:09:36,010 --> 00:09:37,090
.طعام ذوّاقة من المستوى الثّاني

155
00:09:37,090 --> 00:09:39,870
من هؤلاء الحكّام على أيّ حال؟

156
00:09:39,870 --> 00:09:42,820
.جميعهم شركاء عمل مع إيزان

157
00:09:42,820 --> 00:09:46,770
،لديهم علاقات متينة في المجال
.إضافة لعلاقات مع المركز أيضًا

158
00:09:46,770 --> 00:09:49,900
.أعتقد أنّهم يجيدون الحكم على الأطباق

159
00:09:51,480 --> 00:09:55,440
لكنّ هذا الطّبق كان محبوبًا للغاية
.لدى زبائن مطعم عائلتنا الشّعبيّ

160
00:09:55,440 --> 00:09:57,250
!كوباياشي ريندو

161
00:09:57,250 --> 00:09:59,820
!أنت عضوة في المركز

162
00:10:00,220 --> 00:10:04,910
أشكّك فيما إن كان عليك منح طبق
.من هذا المستوى الكثير من وقتك

163
00:10:04,910 --> 00:10:09,290
.فلسفتي هي تذوّق الطّعام أوّلاً ثمّ الحكم عليه

164
00:10:10,220 --> 00:10:12,850
لا أصدّق أنّه قد استُعمل لحم خنزير
.مليء بالدّهون في الحشوة

165
00:10:12,850 --> 00:10:16,870
كلّ ما سينتج عن ذلك هو تدمير النّكهات
.الرّفيعة والشّهيّة لدجاج ساتسوما

166
00:10:16,870 --> 00:10:18,660
أستطيع أن أجزم سلفًا قبل حتّى أن أجرّبه

167
00:10:18,660 --> 00:10:20,990
!أنّ هذا حماقة تامّة

168
00:10:20,990 --> 00:10:22,850
أفهمت يا يوكيهيرا؟

169
00:10:22,850 --> 00:10:25,320
.هذه هي حدود مهاراتك في الطّبخ

170
00:10:25,320 --> 00:10:27,050
.هيّا، تراجع

171
00:10:27,050 --> 00:10:29,520
.إليكم جائزتكم على المشاركة في هذه التّمثيليّة

172
00:10:30,250 --> 00:10:31,060
.بالهناء والشّفاء

173
00:10:32,350 --> 00:10:34,020
!أرزّ الدّجاج من هاينان

174
00:10:34,020 --> 00:10:38,780
إنّه يُعرف أيضًا باسم كاو مان غاي أو الأرزّ
.بالدّجاج السّينغافوريّ إضافة لأسماء أخرى

175
00:10:38,780 --> 00:10:42,740
!إنّه طبق أساسيّ في المطبخ الآسيويّ الجنوب شرقيّ

176
00:10:42,740 --> 00:10:44,830
.هذا من أجلك

177
00:10:46,540 --> 00:10:48,000
.شكرًا

178
00:10:51,990 --> 00:10:54,340
!يا للأومامي الخفيف والغامر أيضًا

179
00:10:54,340 --> 00:10:57,300
!يا لطراوة اللّحم المطبوخ بمثاليّة

180
00:10:57,300 --> 00:11:00,630
!النّكهات الرّائعة لا تنتهي

181
00:11:02,220 --> 00:11:05,140
،لقد أعددت ثلاثة أنواع من الصّلصة هذه المرّة

182
00:11:05,500 --> 00:11:08,870
صلصة فلفل حارّ تحتوي على مرق الدّجاج

183
00:11:08,870 --> 00:11:11,910
وصلصة زنجبيل تحتوي على دهن الدّجاج

184
00:11:11,910 --> 00:11:16,400
وصلصة سيو دام، وهي نوع من صلصة
.الصّويا الأساسيّة في المطبخ التّايلانديّ

185
00:11:16,400 --> 00:11:19,780
لا مجال للشّكّ أنّها جميعها
.تتماشى جيّدًا مع الدّجاج

186
00:11:21,150 --> 00:11:23,870
لقد ارتكز على دجاج ساتسوما
.في تصميم وتتبيل طبقه

187
00:11:24,330 --> 00:11:28,080
ذوق إيزان إتسويا الجيّد في الطّبخ
.يُعبّر عنه من خلال هذا الطّبق

188
00:11:28,450 --> 00:11:30,150
،ومن خلال طبخه

189
00:11:33,140 --> 00:11:35,420
!هذا بالفعل خيمياء للنّكهات

190
00:11:35,420 --> 00:11:37,170
.لنرَ

191
00:11:41,270 --> 00:11:42,540
.أحسنت

192
00:11:43,070 --> 00:11:45,720
.أنت هو الخيميائيّ قبل كلّ شيء

193
00:11:45,720 --> 00:11:47,720
حسنًا يا يوكيهيرا سوما؟

194
00:11:48,030 --> 00:11:51,450
!إنّ طبقك لا يرتقي لمعايير المركز

195
00:11:51,450 --> 00:11:53,120
!هل تدرك ذلك الآن

196
00:11:53,120 --> 00:11:57,900
.لكنّ طبقي لم ينتهِ بعد

197
00:11:58,410 --> 00:12:02,360
.تحتاج الغيوزا خاصّتي لخطوة أخيرة قبل أن تكتمل

198
00:12:02,360 --> 00:12:05,370
.أنا واثق أنّ خدعك من المستوى الثّاني

199
00:12:05,370 --> 00:12:07,370
!واضح أنّنا مختلفان اختلاف اللّيل والنّهار

200
00:12:07,690 --> 00:12:10,510
.إيزان-دونو، هذه مضيعة للوقت بكلّ تأكيد

201
00:12:10,510 --> 00:12:12,410
هل ننتقل للتّصويت؟

202
00:12:12,410 --> 00:12:13,850
!أجل، تفضّلوا

203
00:12:13,850 --> 00:12:14,930
.افعلوا ذلك فحسب

204
00:12:14,930 --> 00:12:17,000
.لقد انتهى تحدّي الشّوكوغيكي هذا

205
00:12:17,000 --> 00:12:17,920
.انتهى

206
00:12:17,920 --> 00:12:19,730
.لا تتصرّف هكذا

207
00:12:19,730 --> 00:12:21,770
ما الضّرر من هذا؟

208
00:12:21,770 --> 00:12:24,620
ألا يمكنك تجربة طبقي على الأقلّ يا إيزان-سينباي؟

209
00:12:24,620 --> 00:12:25,500
ماذا؟

210
00:12:25,500 --> 00:12:26,600
...أم أنّك

211
00:12:27,730 --> 00:12:29,680
خائف يا سينباي؟

212
00:12:29,680 --> 00:12:30,890
خائف من طبخي؟

213
00:12:34,350 --> 00:12:35,810
ماذا؟

214
00:12:35,810 --> 00:12:40,010
إن لم تكن ترتعد خوفًا، فما كنت
لتمانع تذوّقه، صحيح؟

215
00:12:40,010 --> 00:12:42,410
سيكون من المؤسف أن تعود لمنزلك
دون تذوّق طبقي

216
00:12:42,410 --> 00:12:45,780
بعد كلّ شيء قلتُه، صحيح؟

217
00:12:45,780 --> 00:12:47,710
...أ-أنت

218
00:12:47,710 --> 00:12:50,420
.أظنّ أنّك ترغب بتذوّقه الآن

219
00:12:50,420 --> 00:12:52,250
!هذا ممتاز

220
00:12:54,250 --> 00:12:56,940
!والآن، اقترب وأمعن النّظر

221
00:12:56,940 --> 00:13:01,100
!سوف يأخذ طبق الغيوزا خاصّتي شكله النّهائيّ

222
00:13:02,850 --> 00:13:04,470
!ما الّذي ستفعله يا يوكيهيرا؟

223
00:13:04,470 --> 00:13:09,300
،حتّى إن تذوّق الحكّام طبقك
!فقد رشاهم إيزان جميعًا

224
00:13:09,300 --> 00:13:11,980
!حسنًا. أرني يا يوكيهيرا

225
00:13:12,510 --> 00:13:14,310
!لكنّ هذه هي نهاية المطاف لك

226
00:13:14,640 --> 00:13:17,690
!استمتع بآخر لحظاتك في الطّبخ في الأكاديميّة

227
00:13:19,530 --> 00:13:23,400
.كان يعدّ مرق دجاجا ساتسوما ذاك قبل التّحدّي

228
00:13:23,810 --> 00:13:25,700
ما الموجود في تلكما العلبتان؟

229
00:13:25,700 --> 00:13:27,660
.إنّها جاهزة ودافئة الآن

230
00:13:27,660 --> 00:13:29,660
.والجلد يبدو جيدًا أيضًا

231
00:13:29,660 --> 00:13:32,010
!إنّه الوقت الّذي أضيف فيه الرّطوبة

232
00:13:37,500 --> 00:13:39,460
جبن؟

233
00:13:39,460 --> 00:13:40,690
بارميزان؟

234
00:13:40,690 --> 00:13:41,570
.فهمت الآن

235
00:13:41,570 --> 00:13:44,590
.يعدّ يوكيهيرا غيوزا الأجنحة

236
00:13:45,300 --> 00:13:49,690
تُطبخ الأجنحة في العادة باستعمال
،الدّقيق المخفّف بالماء

237
00:13:49,690 --> 00:13:52,930
.لكنّ يوكيهيرا راودته فكرة إعدادها بجبن البارميزان

238
00:13:56,740 --> 00:13:58,560
أرأيت؟

239
00:13:58,560 --> 00:14:03,070
لقد هوى الطّبق الآن بالفعل إلى المستوى
.الثّاني من طعام الذّوّاقة

240
00:14:03,070 --> 00:14:09,380
ضرّ لحم الخنزير المليء بالدهن في الحشوة
.الطّبق سلفًا، بينما واصل الجبن إهانته

241
00:14:09,380 --> 00:14:15,040
إنّك تغمر نكهات الدّجاج الرّفيع
!بإضافات غير ضروريّة فقط

242
00:14:15,040 --> 00:14:19,750
.هذا هو العكس تمامًا لابتكار إيزان-دونو الرّفيع

243
00:14:19,750 --> 00:14:22,130
.كانت مضيعة للوقت بالفعل

244
00:14:22,130 --> 00:14:24,840
ما قصّة مرق الدّجاج؟

245
00:14:24,840 --> 00:14:25,910
!حسنًا

246
00:14:25,910 --> 00:14:28,380
.لننهِ التّقييم ونضع حدًّا لهذا الشوكوغيكي

247
00:14:28,380 --> 00:14:29,550
.صه

248
00:14:34,720 --> 00:14:35,680
.ها هي ذي

249
00:14:35,680 --> 00:14:37,680
.لقد حصلت الأجنحة على قوام هشّ

250
00:14:37,680 --> 00:14:38,750
!الآن

251
00:14:44,020 --> 00:14:44,860
.المرق

252
00:14:44,860 --> 00:14:47,360
.إليكم اللّمسة الأخيرة

253
00:14:47,700 --> 00:14:50,700
إعداد صلصة كثيفة عن طريق إضافة
،نشا الأروروت لمرق الدّجاج

254
00:14:50,700 --> 00:14:53,160
!وسكبه فوق الغيوزا كلمسة أخيرة

255
00:14:53,160 --> 00:14:55,870
!بالهناء والشّفاء يا إيزان-سينباي

256
00:15:00,050 --> 00:15:01,000
.هذا غباء

257
00:15:01,470 --> 00:15:03,590
ما الفائدة الّتي قد تضيفها هذه الصّلصة؟

258
00:15:03,590 --> 00:15:06,300
.لقد أضفت ذلك في آخر دقيقة فحسب

259
00:15:06,630 --> 00:15:07,760
.الأمر مؤكّد الآن

260
00:15:07,760 --> 00:15:11,180
.نحن لا نحتاجك في توتسكي

261
00:15:21,980 --> 00:15:23,270
ماذا؟

262
00:15:23,270 --> 00:15:25,690
هل من خطب ما يا إيزان-سينباي؟

263
00:15:25,690 --> 00:15:29,570
أربّما تراودك أفكار بأنّ الغيوزا خاصّتي لذيذة؟

264
00:15:29,570 --> 00:15:30,850
.لا يعقل

265
00:15:30,850 --> 00:15:32,700
.إنّه طعام ذوّاقة من المستوى الثّاني

266
00:15:32,700 --> 00:15:33,820
!مستحيل

267
00:15:33,820 --> 00:15:34,730
.هيّا، هيّا

268
00:15:34,730 --> 00:15:37,830
،إن كنتم ستتصرّفون بقسوة هكذا
ربّما عليكم أن تجرّبوه لتتأكّدوا؟

269
00:15:38,240 --> 00:15:39,750
.تفضّلوا، بالهناء والشّفاء

270
00:15:42,330 --> 00:15:43,710
.أخبرني يا إيزان-سينباي

271
00:15:44,070 --> 00:15:47,670
تعتقد أنّ طبقي لذيذ، صحيح؟

272
00:15:48,090 --> 00:15:51,800
ألا تريد أن تعرف أيّ الطّبقين
كان مذاقه أفضل؟

273
00:15:51,800 --> 00:15:53,300
!هذا سخيف

274
00:15:53,300 --> 00:15:54,430
!سبق وأخبرتك

275
00:15:54,430 --> 00:15:56,780
!لا حاجة لتجربة طبقك

276
00:15:56,780 --> 00:15:58,390
!وقت التّصويت

277
00:15:58,390 --> 00:16:00,260
...عفوًا... انتظر

278
00:16:00,670 --> 00:16:04,480
هل نستطيع تذوّقه على الأقلّ قبل أن نصوّت؟

279
00:16:04,480 --> 00:16:05,610
ماذا؟

280
00:16:05,610 --> 00:16:08,930
...أعني أنّ النّتيجة معروفة سلفًا، لذا

281
00:16:08,930 --> 00:16:11,610
ماذا تقول؟

282
00:16:11,610 --> 00:16:12,860
.لن آكل أيًّا من ذلك

283
00:16:12,860 --> 00:16:16,070
.المعذرة إذًا، لكنّي سأتناول قضمة واحدة

284
00:16:16,070 --> 00:16:18,790
.سأجرّبها أنا أيضًا

285
00:16:26,990 --> 00:16:28,630
!تفضّلي، شكرًا على الانتظار

286
00:16:28,630 --> 00:16:31,400
!أجل! ها قد انتهى

287
00:16:31,400 --> 00:16:33,010
!سأجرّبه أيضًا

288
00:16:33,010 --> 00:16:34,720
!كوباياشي ريندو

289
00:16:34,720 --> 00:16:38,240
.لكن حتّى إيزان كان يتصرّف وكأنّ الطّبق لذيذٌ جدًّا

290
00:16:38,240 --> 00:16:41,030
كيف لا يمكنني تناوله بعد ذلك؟

291
00:16:48,060 --> 00:16:51,820
!هذا لذيذ للغاية يا يوكيهيرا سوما

292
00:16:51,820 --> 00:16:52,830
!كيف؟

293
00:16:52,830 --> 00:16:57,280
كيف يعقل لطبخه الفوضوي أن يحسّن
!نكهات الدّجاج إلى هذه الدّرجة؟

294
00:16:57,280 --> 00:16:59,980
.الجواب لذلك السّؤال يكمن في الصّلصة

295
00:16:59,980 --> 00:17:04,810
أضفت صلصة الصّويا والسّاكي
والخلّ والسّكّر وزيت السّمسم

296
00:17:04,810 --> 00:17:07,630
.ومكوّنًا سرّيًّا لمرق الدّجاج

297
00:17:07,630 --> 00:17:09,150
!مكوّن سرّيّ؟

298
00:17:11,010 --> 00:17:12,010
.إنّه الكاتشاب

299
00:17:12,530 --> 00:17:17,270
لقد أعددت صلصة حلوة ومرّة خاصّة
.بالكاتشاب كمكوّن سرّيّ

300
00:17:17,270 --> 00:17:18,220
...كاتشاب

301
00:17:18,220 --> 00:17:20,530
إنّها الصّلصة الحلوة والمرّة المستعملة
في أطباق مثل لحم الخنزير الحلو والمرّ

302
00:17:20,530 --> 00:17:21,470
.وأرزّ السّلطعون بالبيض

303
00:17:21,910 --> 00:17:26,600
!إنّها طريقة ممتازة لموازنة الزّيت في الطّبخ الصّينيّ

304
00:17:26,600 --> 00:17:29,540
الحمضيّة المضافة من الكاتشاب

305
00:17:29,540 --> 00:17:33,760
سمحت له بإبراز عصارة وغنى لحم الخنزير
،المليء بالدّهون وجبن البارميزان

306
00:17:33,760 --> 00:17:36,990
!كما أبرزت الطّعم الدّائم الرّفيع للدّجاج

307
00:17:36,990 --> 00:17:41,880
إنّ الطّماطم عبارة عن قنابل أومامي
.مليئة بحمض الغلوتامين

308
00:17:41,880 --> 00:17:45,210
.إنّها تتماشى بشكل جيّد مع جبن البارميزان أيضًا

309
00:17:45,210 --> 00:17:50,540
هنالك توافق أيضًا مع مكوّنات الأومامي
.في الدّجاج وفطر الشّيتاكي

310
00:17:50,540 --> 00:17:54,300
ربّما بدا الطّبق كمزيج للأفكار من طعام
،ذوّاقة من المستوى الثّاني

311
00:17:54,300 --> 00:17:56,090
...وبعيدًا كلّ البعد عن التّحسين بقدر الإمكان

312
00:17:56,090 --> 00:17:56,760
!ومع ذلك

313
00:17:56,760 --> 00:17:58,170
،بمجرّد أكل قضمة واحدة

314
00:17:58,170 --> 00:18:01,500
!نجد أنّها مجموعة نكهات مثاليّة بشكل لا يُتصوّر

315
00:18:01,500 --> 00:18:03,890
كيف يمكن تحقيق شيء كهذا من الأساس؟

316
00:18:03,890 --> 00:18:08,140
.لم أكن الوحيد الّذي ابتكر هذا الطّبق

317
00:18:08,140 --> 00:18:10,900
راودتني فكرة إضافة الطّماطم للطّبق هكذا

318
00:18:11,440 --> 00:18:14,310
.بمساعدة تلاميذ من مسكن النّجم القطبيّ

319
00:18:17,830 --> 00:18:19,910
!لا تقلقي يا إرينا-ساما

320
00:18:19,910 --> 00:18:23,030
!لن أسمح لهم بلمسك

321
00:18:23,460 --> 00:18:24,420
...هيساكو

322
00:18:24,420 --> 00:18:25,560
نعم؟

323
00:18:25,560 --> 00:18:29,340
.الأشخاص في هذا المسكن... غريبون نوعًا ما

324
00:18:29,340 --> 00:18:31,290
غريبون"؟"

325
00:18:33,800 --> 00:18:35,300
!إرينا-تشي

326
00:18:35,300 --> 00:18:36,940
!إنّه وقت الانتقام

327
00:18:37,830 --> 00:18:40,010
.لا يبدو أنّكم تسأمون من هذا

328
00:18:40,010 --> 00:18:42,740
!لقد انتقدتنا كثيرًا في الأمس أيضًا

329
00:18:42,740 --> 00:18:45,290
سوف أحرص على جعلك تقولين
!أنّ طبقي لذيذ اليوم بالتّأكيد

330
00:18:46,370 --> 00:18:49,690
لقد اتّبعت نصيحتي وغيّرت الوصفة إذًا؟

331
00:18:50,070 --> 00:18:51,240
.حسنًا

332
00:18:51,240 --> 00:18:53,560
.أنتم تسمحون لي بالبقاء هنا قبل كلّ شيء

333
00:18:53,560 --> 00:18:55,320
—سوف أتذوّق طبخكم ثانية اليوم

334
00:18:56,070 --> 00:18:59,130
!إنّه مختلف تمامًا ممّا أخبرتك أنّه يجب أن يكون

335
00:18:59,130 --> 00:19:00,070
.ماذا؟ حسنًا

336
00:19:00,070 --> 00:19:01,430
!سبق وأخبرتك

337
00:19:01,430 --> 00:19:04,370
!يفترض بالغالانتين أن يقدّم باردًا

338
00:19:04,370 --> 00:19:07,150
.لأنّ إن قدّمته ساخنًا، فسيفقد متانته

339
00:19:07,150 --> 00:19:10,080
كما أنّه كان عليك إبراز الصّلصة
،المُعدّة من فطر البورتشيني

340
00:19:10,080 --> 00:19:14,150
لكنّك استعملت جبن الغورغونزا
!القويّ في صلصتك بدل ذلك

341
00:19:14,150 --> 00:19:17,050
—سيكون أسوأ بكلّ تأكيد من طبق البارحة

342
00:19:17,050 --> 00:19:18,130
!ماذا؟

343
00:19:18,130 --> 00:19:19,010
...لا يعقل

344
00:19:19,870 --> 00:19:21,810
،ما زال ينتقصه بعض التفاصيل

345
00:19:21,810 --> 00:19:24,600
لكنّ جعل نكهات قويّة تتوافق هكذا

346
00:19:24,600 --> 00:19:26,600
!يعزّز من النّكهة في الحقيقة

347
00:19:26,600 --> 00:19:27,450
.أخبريني

348
00:19:27,450 --> 00:19:28,590
كيف هو؟

349
00:19:29,810 --> 00:19:32,790
.تبرز نكهة دهن لحم الخنزير أكثر من اللازم الآن

350
00:19:32,790 --> 00:19:34,720
.إنّها تجعل المذاق مبالغًا فيه أكثر

351
00:19:34,720 --> 00:19:37,190
.لكنّنا نودّ الاحتفاظ بالنّكهة الغنيّة

352
00:19:37,190 --> 00:19:39,910
.أخبريني يا إرينا-تشي

353
00:19:38,940 --> 00:19:39,910
!مهلاً

354
00:19:39,910 --> 00:19:41,550
!لا يمكن لهذا المزيج أن ينجح

355
00:19:39,910 --> 00:19:41,950
.أخبريني

356
00:19:41,550 --> 00:19:43,410
استعمال لحم الخنزير والدّجاج معًا؟

357
00:19:41,950 --> 00:19:43,410
.هيّا، أخبريني

358
00:19:43,850 --> 00:19:46,250
!لا يمكن إضافة نكهات إلى بعضها ببساطة هكذا

359
00:19:46,250 --> 00:19:48,710
.عليك أن تفكّر بشأن تقليل النّكهات أيضًا

360
00:19:47,070 --> 00:19:50,160
مهلاً، ماذا عن إضافة المزيد من الحمضيّة؟

361
00:19:50,160 --> 00:19:51,920
!استمع لي

362
00:19:51,920 --> 00:19:53,490
!أجل

363
00:19:53,490 --> 00:19:55,850
حموضة تحتفظ بأومامي الدّجاج
وغنى لحم الخنزير

364
00:19:55,850 --> 00:19:58,490
.بينما تبطل الزّيتيّة

365
00:19:59,500 --> 00:20:00,510
الحموضة؟

366
00:20:01,720 --> 00:20:03,380
ربّما ينجح ذلك؟

367
00:20:03,380 --> 00:20:04,930
!نعم! سينجح ذلك

368
00:20:04,930 --> 00:20:05,820
!حسنًا

369
00:20:05,820 --> 00:20:07,140
!لنقطف بعضها من المزرعة

370
00:20:07,140 --> 00:20:08,460
!لنذهب إلى مزرعة النّجم القطبيّ

371
00:20:08,460 --> 00:20:09,620
...لـ-لهذا السّبب

372
00:20:09,620 --> 00:20:12,750
!أخبرتكم أن تصغوا إليّ

373
00:20:13,410 --> 00:20:17,020
لقد قمت باختبارات تذوّق أكثر
،ممّا أستطيع عدّه

374
00:20:17,020 --> 00:20:20,860
لكن لم يهمل أحد من قبل توصياتي

375
00:20:21,330 --> 00:20:25,570
.لأنّ حاسّة تذوّقي مطلقة ولا تخطئ

376
00:20:26,260 --> 00:20:28,270
،لكن هنا في مسكن النّجم القطبيّ

377
00:20:28,270 --> 00:20:31,270
التّصادم الفوضويّ للأفكار العشوائيّة

378
00:20:31,270 --> 00:20:33,950
.يعطي حلولاً مفاجئة

379
00:20:34,470 --> 00:20:36,570
أقلت المركز؟

380
00:20:36,570 --> 00:20:41,840
من وجهة نظرك، أراهن أنّنا لا نستحق
.تقييمًا مناسبًا أو ما شابه

381
00:20:42,180 --> 00:20:45,340
لكن حياتنا اليوميّة في المسكن
.معلّقة على هذا الطّبق

382
00:20:45,740 --> 00:20:48,970
،الأيّام الّتي قضيناها نتحدّى بعضنا في المسكن

383
00:20:48,970 --> 00:20:51,600
!المسكن الّذي تحاولون إقفاله الآن

384
00:20:52,370 --> 00:20:53,970
.أخبرني يا سيّدي الجالس في الوسط

385
00:20:54,620 --> 00:21:01,030
سأحطّم طريقة تفكيرك المملّة الّتي تقول
.أنّه توجد طريقة واحدة للطّبخ

386
00:21:01,490 --> 00:21:02,740
.جرّبه

387
00:21:02,740 --> 00:21:06,030
.سوف ينعش عقلك المتحجّر ذاك

388
00:21:10,700 --> 00:21:11,410
...أنت

389
00:21:21,990 --> 00:21:23,920
.أتمنّى أن تعيدوا النّظر

390
00:21:24,530 --> 00:21:29,050
هذا الطّبق الّذي قرٍّرتم أنّه لا يستحقّ
لم يكن بذلك السّوء، صحيح؟

391
00:21:29,050 --> 00:21:31,650
!يوكيهيرا

392
00:21:44,590 --> 00:21:45,810
!شكرًا على تناولكم طعامي

393
00:23:17,950 --> 00:23:21,620
لن يُقفل مسكن النّجم القطبيّ إذًا، صحيح؟

394
00:23:25,960 --> 00:23:29,340
هل تشاهدون هذا يا جماعة المركز؟

395
00:23:30,580 --> 00:23:34,830
،إن كنتم تحاولون العبث مع أصدقائي أو معارفي

396
00:23:34,830 --> 00:23:36,310
.فسوف تدفعون الثّمن

397
00:23:36,310 --> 00:23:40,180
،قد نكون أشخاصًا من مستوى متدنٍّ في نظركم

398
00:23:40,180 --> 00:23:43,270
.لكنّنا لن ندعكم تستهينون بنا  دون فعل شيء

399
00:23:43,270 --> 00:23:45,260
إن كان القتال هو هدفكم، فسأقبل التّحدّي

400
00:23:45,260 --> 00:23:47,230
!وسأبذل في مواجهتكم كلّ ما لديّ

401
00:23:47,230 --> 00:23:50,570
وهذا ينطبق على الجميع حتّى
.إن كانوا من النّخبة العشرة

402
00:24:03,960 --> 00:24:05,960
توتسكي

403
00:24:07,140 --> 00:24:10,460
!أتمنّى أن تكون الحلقة القادمة على ذوقكم