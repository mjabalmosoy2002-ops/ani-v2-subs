1
00:02:16,990 --> 00:02:20,240
المعذرة! هلاّ شكّلتَ فرقة معي؟

2
00:02:20,240 --> 00:02:26,180
شكّلت فرقة معي؟

3
00:02:29,470 --> 00:02:30,880
...عفوًا

4
00:02:33,050 --> 00:02:35,030
ماذا قلت؟

5
00:02:35,030 --> 00:02:37,130
أنت تبحث عن أشخاص، صحيح؟

6
00:02:38,260 --> 00:02:39,760
أشخاص لتشكيل فرقة؟

7
00:02:38,260 --> 00:02:39,760
!تجنيد أعضاء فرقة

8
00:02:42,120 --> 00:02:44,220
...نعم، ذلك صحيح

9
00:02:44,220 --> 00:02:47,980
!لنشكّل أنا وأنت فرقة إذًا

10
00:02:49,310 --> 00:02:52,020
.اسمي نارسينا

11
00:02:52,020 --> 00:02:54,500
!وكما ترى، أنا مُمارِسة فنون قتاليّة

12
00:02:56,640 --> 00:02:58,090
.أنا لاوست

13
00:02:58,740 --> 00:02:59,860
.أنا معالج

14
00:03:00,710 --> 00:03:01,610
.نوعًا ما

15
00:03:01,610 --> 00:03:04,120
!مـ-مـ-مهلاً لحظة

16
00:03:04,120 --> 00:03:05,950
من تكونين؟

17
00:03:06,340 --> 00:03:11,210
موظّفة في فرع ماردات لنقابة
.المغامرين واسمي أمارست

18
00:03:11,210 --> 00:03:13,460
!لكنّ ذلك ليس مهمًّا الآن

19
00:03:13,860 --> 00:03:17,200
هل لديك أدنى فكرة عمّن يكون؟

20
00:03:17,200 --> 00:03:19,970
من... يكون؟

21
00:03:20,880 --> 00:03:23,570
.ذلك لاوست الجاهل

22
00:03:23,570 --> 00:03:24,670
الجاهل؟

23
00:03:25,930 --> 00:03:30,680
ذلك صحيح. إنّه معالج، لكنّ التّعويذة الوحيدة
.الّتي يمكنه استعمالها هي تعويذة شفاء بسيطة

24
00:03:30,680 --> 00:03:36,270
،لقد كان مغامرًا منذ طفولته
،شأنه شأن أيّ يتيمِ متاهة

25
00:03:36,270 --> 00:03:39,360
لكن لا يمكنه حتّى استعمال تعويذة
.شفاء جماعيّ أو شفاء متفوّق

26
00:03:39,360 --> 00:03:41,830
.إنّه غير كفء بالكامل

27
00:03:41,830 --> 00:03:44,030
،على الرّغم من ذلك، فحتّى وقت قريب

28
00:03:44,030 --> 00:03:45,530
أنصال البرق

29
00:03:44,030 --> 00:03:47,800
سمحت له فرقة تُدعى
.أنصال البرق بالانضمام إليهم

30
00:03:47,800 --> 00:03:49,560
.لكنّه طُرد منها

31
00:03:49,560 --> 00:03:52,080
يعرف الجميع في البلدة كم أنّه جاهل

32
00:03:52,080 --> 00:03:55,690
،لأنّه لا يستطيع استعمال تعاويذ التّراقي

33
00:03:55,690 --> 00:03:57,990
.ولا يريده أيّ أحد في فرقته الآن

34
00:03:59,300 --> 00:04:01,390
،واثقة أنّك تواجهين ضائقة ماليّة ما

35
00:04:01,390 --> 00:04:05,070
وإن شكّلت فرقة معه، فلن تجنين حتّى
.ما يكفي من المال لتوفير سكن لائق

36
00:04:05,070 --> 00:04:09,180
،على العكس. إن كان يتعلّق الأمر بالمال
.فلديّ الكثير منه، لذلك سأكون بخير

37
00:04:09,760 --> 00:04:10,600
.انظري

38
00:04:10,600 --> 00:04:11,350
!مهلاً

39
00:04:12,640 --> 00:04:14,070
،أكره قول هذا لك

40
00:04:14,070 --> 00:04:17,860
لكنّ المغامرين الّذين يجتمعون
.في هذه المدينة أشخاص قساة قليلاً

41
00:04:20,360 --> 00:04:25,010
من الأفضل لصحّتك ألاّ تتجوّلي
.وأنت تُظهرين كلّ هذا المال لأيّ أحد

42
00:04:25,010 --> 00:04:26,990
أهذا ما تظنّين؟

43
00:04:27,390 --> 00:04:29,990
!شكرًا جزيلاً على لطفك

44
00:04:33,090 --> 00:04:36,150
صرتِ مغامِرة حديثًا فحسب، صحيح؟

45
00:04:36,150 --> 00:04:37,960
ماذا؟ أذلك واضح عليّ؟

46
00:04:37,960 --> 00:04:38,960
.نعم

47
00:04:38,960 --> 00:04:42,410
.لا تزال عدّتك تلمع لأنّها جديدة

48
00:04:43,150 --> 00:04:48,180
بالمناسبة! بإمكاني تقديمك
.لفرقة ممتازة للمبتدئين إن أردت

49
00:04:48,180 --> 00:04:52,470
.بالطّبع سيكلّفك ذلك عمولة مناسبة

50
00:04:52,470 --> 00:04:54,780
.أنا أرفض في تلك الحالة

51
00:04:54,780 --> 00:04:59,900
قرّرتُ منذ وقت طويل أنّي أريد
.تشكيل فرقة مع ذلك الشّخص

52
00:04:59,900 --> 00:05:00,680
!مع السّلامة

53
00:05:01,050 --> 00:05:01,900
—مهـ

54
00:05:03,500 --> 00:05:04,990
.يا إلهي

55
00:05:04,990 --> 00:05:06,650
هل انتهى حديثكما؟

56
00:05:05,450 --> 00:05:07,990
.لا تلوميني إن حدث أيّ شيء

57
00:05:06,650 --> 00:05:07,990
.نعم، انتهينا

58
00:05:08,350 --> 00:05:11,120
عفوًا، أواثقة أنّك تريدينني؟

59
00:05:09,360 --> 00:05:11,120
...ماذا؟ مهلاً

60
00:05:11,400 --> 00:05:13,120
.نعم، بكلّ تأكيد

61
00:05:11,400 --> 00:05:13,120
أقالت منذ وقت طويل؟

62
00:05:13,120 --> 00:05:15,120
.لا بدّ أن يكون أنت

63
00:05:16,120 --> 00:05:17,620
.تفضّلا

64
00:05:17,620 --> 00:05:19,580
ما الغاية من هذه؟

65
00:05:19,580 --> 00:05:21,380
.إنّها لأجل تسجيل فرقة جديدة

66
00:05:21,860 --> 00:05:26,310
،إن لم تُعيدا هذه
فلن تحصلا على إحالات للمهمّات

67
00:05:26,310 --> 00:05:30,660
ولن نتمكّن من الحكم بينكما إن كانت
.لديكما أيّ خلافات حول الرّسوم

68
00:05:30,660 --> 00:05:31,990
فعلاً؟

69
00:05:44,420 --> 00:05:46,020
.وجدته أخيرًا

70
00:05:47,780 --> 00:05:50,530
حسنًا، هلاّ كتبت اسمك؟

71
00:05:50,530 --> 00:05:52,780
...ماذا؟! عفوًا

72
00:05:52,780 --> 00:05:54,160
ماذا؟

73
00:05:54,160 --> 00:05:56,880
اسمك. تعرفين الكتابة، صحيح؟

74
00:05:56,880 --> 00:05:59,080
.نعم. أعرف ذلك

75
00:06:06,640 --> 00:06:07,350
.حسنًا

76
00:06:10,110 --> 00:06:11,550
.عمولتي

77
00:06:11,550 --> 00:06:13,210
.نعم، صحيح

78
00:06:19,110 --> 00:06:20,380
!كان هذا من دواعي سروري

79
00:06:20,380 --> 00:06:23,860
!هذا يعني أنّنا فرقة الآن بشكل رسميّ

80
00:06:23,860 --> 00:06:26,570
!إنّه لشرف لي أن أعمل معك

81
00:06:36,770 --> 00:06:38,470
.الشّرف كلّه لي

82
00:06:44,190 --> 00:06:48,810
لم يُنهِ أيّ أحد في الحقيقة اكتشاف
،متاهة ماردات حتّى نهايتها بعد

83
00:06:49,710 --> 00:06:53,170
لذلك لا ندري أيّ نوع من الوحوش
.قد يكون سيّد المتاهة بعد

84
00:06:53,930 --> 00:06:58,710
لم تُكتشف الكثير من مناطقها، وما زال
،هنالك الكثير من المساحة للمغامرة

85
00:06:58,710 --> 00:07:01,410
،لذلك يبدأ المغامرون بالتّجمّع هنا

86
00:07:02,300 --> 00:07:07,100
ويساعد ذلك في النّهاية ماردات
.لتصير أكبر مدينة متاهة في المنطقة

87
00:07:11,610 --> 00:07:15,840
لكن هل يمكننا فعلاً الاتّجاه للمتاهة
في وقت مبكّر كهذا؟

88
00:07:15,840 --> 00:07:17,460
...إنّ تلك المرأة قالت

89
00:07:18,040 --> 00:07:19,940
.استمع إلي يا لاوست

90
00:07:19,940 --> 00:07:22,420
.لا تزال نارسينا هاوية

91
00:07:22,420 --> 00:07:24,790
.عليك أخذها إلى المراعي الغربيّة أوّلاً

92
00:07:25,300 --> 00:07:27,420
.ذلك ما قالته

93
00:07:29,110 --> 00:07:30,870
...بخصوص ذلك

94
00:07:31,570 --> 00:07:35,490
هنالك العديد من المواقع الأخرى
حول ماردات تظهر فيها الوحوش

95
00:07:35,490 --> 00:07:38,550
.بسبب الطّاقة السّحريّة الّتي تتسرّب من المتاهة

96
00:07:39,420 --> 00:07:41,430
،هنالك المنطقة الجبليّة في الشّرق

97
00:07:42,140 --> 00:07:43,420
،والغابة في الشّمال

98
00:07:44,660 --> 00:07:46,280
.والأراضي الرّطبة في الجنوب

99
00:07:47,440 --> 00:07:51,530
ومن بينها كلّها، وحدها المراعي الغربيّة
،الّتي تضمّ وحوشًا ضعيفة نوعًا ما

100
00:07:51,530 --> 00:07:54,070
،لذلك فهي مناسبة أكثر للمبتدئين بالفعل

101
00:07:55,500 --> 00:08:00,540
لكنّها منطقة واسعة جدًّا ومن
.الصّعب العثور على أيّ وحوش فيها

102
00:08:01,010 --> 00:08:05,190
،في المتاهة، تظهر الوحوش الواحد تلو الآخر

103
00:08:05,190 --> 00:08:10,550
ولن نقابل أيّ وحوش قويّة ما لم نتعمّق
.كثيرًا، لذلك فكّرتُ أنّ لا بأس بزيارتها

104
00:08:10,550 --> 00:08:12,160
.مفهوم

105
00:08:12,160 --> 00:08:13,750
...وإن حدث أيّ شيء

106
00:08:13,750 --> 00:08:16,300
ماذا؟ هل قلت شيئًا ما؟

107
00:08:16,300 --> 00:08:18,330
.لا، لا شيء

108
00:08:28,770 --> 00:08:31,660
.هذا هو مدخل المتاهة

109
00:08:31,660 --> 00:08:33,070
حسنًا، هل ندخل؟

110
00:08:33,920 --> 00:08:36,810
.مهلاً لحظة. سأسير في المقدّمة

111
00:08:36,810 --> 00:08:37,540
ماذا؟

112
00:08:37,540 --> 00:08:41,120
.أنا مُمارِسة فنون قتاليّة وأنت معالج

113
00:08:41,120 --> 00:08:44,150
.عليّ أنا أن أكون في الطّليعة

114
00:08:44,150 --> 00:08:46,200
...حسنًا، هكذا يكون الوضع عادة

115
00:08:46,200 --> 00:08:47,460
!حسنًا، هيّا بنا

116
00:08:56,170 --> 00:09:01,480
أنا مسرور لأنّها مليئة بالحيويّة، لكن
هل ستكون قادرة على القتال بالفعل؟

117
00:09:19,380 --> 00:09:20,830
ما رأيك بذلك؟

118
00:09:22,140 --> 00:09:24,040
أنا مذهلة، صحيح؟

119
00:09:26,080 --> 00:09:28,000
!نعم، فاجأتني بالفعل

120
00:09:28,000 --> 00:09:29,540
!ممتاز

121
00:09:33,640 --> 00:09:35,410
.هذا حجر سحريّ

122
00:09:35,410 --> 00:09:40,400
يبيعها معظم المغامرين للنّقابة
.لجني بعض المال

123
00:09:40,400 --> 00:09:43,810
ما الّذي تفعله النّقابة بالحجارة
السّحريّة الّتي تشتريها منهم؟

124
00:09:43,810 --> 00:09:48,310
،الحجارة السّحريّة مليئة بالسّحر
...لذلك تُستعمل لأغراض عديدة

125
00:09:48,310 --> 00:09:54,160
لكنّ هذه معرفة عامّة لكلّ
.شخص يريد أن يصير مغامرًا

126
00:09:55,360 --> 00:09:58,060
.لم أكن بارعة أبدًا في الدّراسة

127
00:10:01,030 --> 00:10:03,420
كم سنجني من هذه؟

128
00:10:03,850 --> 00:10:06,450
الحجارة الّتي نحصل عليها من
.الغوبلين ليست ذات قيمة كبيرة

129
00:10:06,860 --> 00:10:11,390
عليك هزيمة وحوش أقوى للحصول
.على حجارة سحريّة قيّمة أكثر

130
00:10:11,970 --> 00:10:14,130
.ذلك منطقيّ

131
00:10:14,500 --> 00:10:18,420
حسنًا، سيكون هذا كافيًا لتغطية
.تكاليف السّكن للّيلة على الأقلّ

132
00:10:18,420 --> 00:10:22,490
ما رأيك؟ هل نتعمّق أكثر قليلاً بعد؟

133
00:10:22,490 --> 00:10:26,680
،نعم! وإن حدث أيّ شيء
!فسأكون هنا لحمايتك

134
00:10:26,680 --> 00:10:28,560
!لا يوجد ما تقلق بشأنه

135
00:10:30,000 --> 00:10:31,670
.هذا مطمئن للغاية

136
00:10:38,280 --> 00:10:38,990
!نارسينا

137
00:10:40,520 --> 00:10:42,060
ما الخطب؟

138
00:10:56,000 --> 00:10:58,890
كيف عرفت أنّه كان موجودًا هناك؟

139
00:10:59,340 --> 00:11:02,830
كان لون تلك الطّوبة مختلفًا قليلاً
.عن البقيّة في الأرض

140
00:11:02,830 --> 00:11:05,430
.لم ألاحظ ذلك على الإطلاق

141
00:11:08,110 --> 00:11:12,960
تحديد أماكن الفخاخ هي مهمّة
اللّصوص في العادة، صحيح؟

142
00:11:12,960 --> 00:11:15,110
...لكنّك معالج

143
00:11:15,430 --> 00:11:17,960
.أنا مغامر منذ وقت طويل

144
00:11:17,960 --> 00:11:20,010
.تعلّمت بعض المهارات مع الوقت

145
00:11:21,000 --> 00:11:24,140
.نعم... لم أفكّر في ذلك

146
00:11:36,750 --> 00:11:39,530
لماذا يوجد أورك هنا؟

147
00:11:39,530 --> 00:11:41,430
هل ذلك غريب؟

148
00:11:41,430 --> 00:11:46,010
.نعم. تُعرف الأورك كوحوش من المستوى المتوسّط

149
00:11:46,010 --> 00:11:47,920
إنّ قوّتها ومرونتها وحدها

150
00:11:47,920 --> 00:11:51,440
تجعلها على نفس مستوى وحوش
.من الطّوابق السّفلى. إنّها قويّة جدًّا

151
00:11:52,310 --> 00:11:55,820
.لا نراها عادة قرب الطّوابق العليا هكذا

152
00:11:55,820 --> 00:11:57,690
هل تعتقد أنّ بإمكاننا الهرب؟

153
00:11:58,870 --> 00:12:02,700
،لا، إن جمعنا قوانا معًا
.فسنكون قادرين على هزيمته

154
00:12:02,700 --> 00:12:05,430
وبالطّبع لن أقوم بالضّغط عليك
.إن كنت لا تريدين المحاولة

155
00:12:05,430 --> 00:12:08,700
،إن كنت تعتقد أنّ بإمكاننا النّجاح
.فلا سبب لديّ لأعترض

156
00:12:09,800 --> 00:12:11,630
.جيّد. اتُّخذ القرار إذًا

157
00:12:30,980 --> 00:12:32,600
.أشعر وكأنّي أركل صخرة

158
00:12:34,240 --> 00:12:35,980
!لكنّه يتحرّك ببطء شديد

159
00:12:38,790 --> 00:12:39,860
!هذا مؤلم

160
00:12:40,150 --> 00:12:41,110
!نارسينا

161
00:12:47,740 --> 00:12:48,290
!كلاّ

162
00:13:22,990 --> 00:13:24,110
هل أنت بخير؟

163
00:13:24,610 --> 00:13:26,170
!نـ-نعم

164
00:13:27,120 --> 00:13:30,500
هل أنت واثق أنّك معالج بالفعل؟

165
00:13:30,500 --> 00:13:33,030
.أنا مغامر منذ وقت طويل

166
00:13:33,030 --> 00:13:35,600
.تعلّمتُ كيف أقاتل لأتدبّر أموري

167
00:13:35,600 --> 00:13:38,900
.لم يبدُ ذلك كشيء لتتدبّر أمورك به فحسب

168
00:13:39,500 --> 00:13:41,730
...نارسينا، ذراعك

169
00:13:42,500 --> 00:13:44,830
.هذا مجرّد خدش

170
00:13:44,830 --> 00:13:46,590
.سيُشفي في وقت وجيز

171
00:13:46,590 --> 00:13:48,800
.لا، إنّه يحتاج ليُعالج بشكل جيّد

172
00:13:49,270 --> 00:13:50,250
...ولكن

173
00:13:50,830 --> 00:13:52,310
.دعيني ألقي نظرة

174
00:13:53,780 --> 00:13:54,810
.شفاء

175
00:14:07,070 --> 00:14:11,400
عجبًا... إنّه أكبر بكثير من
.الّتي تتركها الغوبلين خلفها

176
00:14:11,400 --> 00:14:15,080
،إنّه يحمل سحرًا أكثر أيضًا
.ما يعني أنّ بإمكاننا بيعه بثمن أعلى

177
00:14:15,810 --> 00:14:18,080
ما قولك؟

178
00:14:18,080 --> 00:14:22,010
،لقد أظهرت لي قدراتك
.كما أنّنا جنينا بما يكفي سلفًا

179
00:14:22,010 --> 00:14:23,890
.بإمكاننا العودة الآن

180
00:14:23,890 --> 00:14:25,460
!ما زال بإمكاني المواصلة

181
00:14:29,470 --> 00:14:32,740
.حسنًا. لنطارد بعض الوحوش إذًا

182
00:14:32,740 --> 00:14:33,580
!أجل

183
00:14:41,300 --> 00:14:44,780
جمعتما كلّ هذه الحجارة السّحريّة
في نصف يوم فحسب؟

184
00:14:46,360 --> 00:14:51,360
مهلاً يا لاوست. أراهن أنّك أخذت
نارسينا إلى المتاهة، صحيح؟

185
00:14:51,360 --> 00:14:54,270
.وهذا الحجر السّحريّ من أورك أيضًا

186
00:14:54,270 --> 00:14:56,640
هل نزلتما للطّوابق الوسطى سلفًا؟

187
00:14:56,640 --> 00:14:58,370
.لا، لم ننزل

188
00:14:58,370 --> 00:15:00,960
.كان يتجوّل قرب الطّوابق العليا

189
00:15:01,840 --> 00:15:03,150
.إنّه يقول الحقيقة

190
00:15:03,150 --> 00:15:07,490
حتّى أنّي قلتُ أنّي أريد التّعمّق
.أكثر، لكنّه رفض ذلك

191
00:15:08,400 --> 00:15:09,420
فعلاً؟

192
00:15:09,420 --> 00:15:11,650
إذًا فأنت تصدّقينني؟

193
00:15:11,650 --> 00:15:16,680
نعم. في الحقيقة، كانت هنالك عدّة
.بلاغات مشابهة في الآونة الأخيرة

194
00:15:16,680 --> 00:15:17,860
ماذا؟

195
00:15:17,860 --> 00:15:21,900
إنّ ذلك يشغل بال المسؤولين
.هنا بشكل كبير

196
00:15:21,900 --> 00:15:25,280
على الأرجح أنّ هنالك شيئًا ما
.غريبًا يحدث في المتاهة

197
00:15:25,280 --> 00:15:27,190
شيء مثل ماذا؟

198
00:15:27,680 --> 00:15:31,500
لا أدري. لماذا قد تعرف مجرّد
موظّفة مثلي أيّ شيء عن ذلك؟

199
00:15:32,520 --> 00:15:36,490
حسنًا، تريدان بيع كلّ هذه الحجارة، صحيح؟

200
00:15:36,490 --> 00:15:38,450
.نعم، نقدّر لك ذلك

201
00:15:38,450 --> 00:15:40,460
!أكيد! من دواعي سروري

202
00:15:40,460 --> 00:15:44,220
.سأقوم بتجهيز المبلغ. انتظرا هنا فحسب

203
00:15:45,210 --> 00:15:48,170
تبدو الآنسة أمارست سعيدة للغاية، صحيح؟

204
00:15:48,720 --> 00:15:53,360
عندما يشتري موظّفو النّقابة حجارة
،سحريّة من مغامرين تحت إدارتهم

205
00:15:53,360 --> 00:15:56,600
ترتفع أجورهم بشكل يتناسب
.مع حجم المبيعات

206
00:15:56,600 --> 00:15:59,890
إذًا كلّما زاد عدد الحجارة السّحريّة
...الّتي نحضرها لها

207
00:15:59,890 --> 00:16:02,970
!امتلأت جيوبي أكثر وأكثر

208
00:16:02,970 --> 00:16:04,400
...لذلك السّبب

209
00:16:05,350 --> 00:16:09,080
إن بذلت جهدك، فسيساعدني
ذلك أنا أيضًا، مفهوم يا نارسينا؟

210
00:16:09,080 --> 00:16:10,240
...أكيد

211
00:16:12,110 --> 00:16:14,360
ماذا؟ هذا القدر؟

212
00:16:14,360 --> 00:16:15,580
.نعم، هذا صحيح

213
00:16:15,580 --> 00:16:19,090
.ولا تنسَ أن تقدّم نصفه لنارسينا

214
00:16:19,090 --> 00:16:20,870
.بالطّبع سأفعل

215
00:16:20,870 --> 00:16:25,910
ولكن حتّى نصفه ما زال يعادل عشر
...مرّات ما كنت أحصل عليه من قبل

216
00:16:29,000 --> 00:16:30,390
ما الخطب؟

217
00:16:30,390 --> 00:16:34,650
لم يحصل أبدًا في فرقة أنصال البرق
.على نصيبه العادل

218
00:16:34,650 --> 00:16:37,350
.يبدو أنّهم كانوا يخدعونه بالفعل

219
00:16:37,350 --> 00:16:38,850
!ذلك لئيم جدًّا

220
00:16:38,850 --> 00:16:44,590
صحيح! يفترض بالنّقابة مساعدتنا إن
كانت هنالك أيّ مشاكل في الدّفع، صحيح؟

221
00:16:44,590 --> 00:16:49,020
بالطّبع! سنقوم بالحكم بين أيّ خصوم
.مقابل الأجر المطلوب

222
00:16:49,600 --> 00:16:50,700
أتريدنا أن نقوم بذلك؟

223
00:16:52,290 --> 00:16:53,780
.لا. لا بأس الآن

224
00:16:53,780 --> 00:16:54,770
...لكن

225
00:16:54,770 --> 00:16:58,160
.انضممت سلفًا لفرقة جديدة

226
00:16:58,750 --> 00:17:01,100
.حان الوقت لأنسى أمر الفرقة السّابقة

227
00:17:06,870 --> 00:17:09,180
!شكرًا جزيلاً لكما

228
00:17:22,200 --> 00:17:27,310
.اثنان، أربعة، ستّة، ثمانية، عشرة
.اثنان، أربعة، ستّة، ثمانية، عشرة

229
00:17:27,750 --> 00:17:28,610
.أجل

230
00:17:32,320 --> 00:17:33,710
.أمارست

231
00:17:35,600 --> 00:17:38,280
سـ-سيّد هانزم، هل من خطب ما؟

232
00:17:38,640 --> 00:17:41,000
.يبدو أنّ لاوست كان هنا للتّوّ

233
00:17:41,000 --> 00:17:45,290
أخبريني رجاءً أنّك لم تقدّميه
.إلى فرقة جديدة

234
00:17:45,600 --> 00:17:50,930
بالطّبع لا. حتّى إن قدّمت ذلك الجاهل
.لفرقة ما، فلن تقبله أبدًا

235
00:17:51,550 --> 00:17:55,220
...لكن... كانت هنالك فتاة غريبة

236
00:17:55,600 --> 00:18:00,600
نارسينا؟ لا تقولي لي أنّها كانت
.تلك الفتاة ذات الشّعر الأزرق

237
00:18:00,600 --> 00:18:04,500
.نـ-نعم، ذلك صحيح
.كانت ذات الشّعر الأزرق الجميل

238
00:18:05,160 --> 00:18:06,320
.فهمت

239
00:18:20,250 --> 00:18:22,710
!تفضّل يا لاوست

240
00:18:26,040 --> 00:18:29,850
ماذا؟ هذه هي عضوة فرقتك الجديدة؟

241
00:18:30,560 --> 00:18:32,630
ماذا؟ تعرفين سلفًا بشأن ذلك؟

242
00:18:32,630 --> 00:18:34,430
.انتشر الخبر بالفعل

243
00:18:34,430 --> 00:18:37,380
يقول النّاس أنّ لاوست الجاهل
.قد شكّل فرقة جديدة

244
00:18:37,380 --> 00:18:39,050
هل أتيتما للأكل؟

245
00:18:39,050 --> 00:18:42,440
،أريد الأكل بالفعل
.لكن عليّ حجز غرفة أوّلاً

246
00:18:42,440 --> 00:18:45,060
.حسنًا، اذهب للحديث مع أمّي في الخلف

247
00:18:48,330 --> 00:18:49,270
غرفة؟

248
00:18:49,270 --> 00:18:51,730
أتريدان غرفة واحدة أم غرفتين منفصلتين؟

249
00:18:53,280 --> 00:18:56,610
غرفة واحدة؟ غرفه واحدة معه؟

250
00:18:57,620 --> 00:18:59,790
.كفاك مزاحًا يا سيّدة ميري

251
00:18:59,790 --> 00:19:01,600
.بالطّبع غرفتين منفصلتين

252
00:19:03,440 --> 00:19:08,000
،هكذا إذًا. الطّابق الثّاني خالٍ بالكامل
.لذلك اختارا أيّ غرفتين تريدان

253
00:19:08,000 --> 00:19:11,170
لكن تحتاجان للأكل أوّلاً، صحيح؟

254
00:19:13,550 --> 00:19:14,620
.شكرًا لك

255
00:19:16,710 --> 00:19:19,170
.كانت غرفة واحدة لتفي بالغرض

256
00:19:21,600 --> 00:19:23,140
.حسنًا، تصبحين على خير

257
00:19:23,920 --> 00:19:25,340
.تصبح على خير

258
00:19:51,130 --> 00:19:52,960
.شكرًا جزيلاً

259
00:19:53,380 --> 00:19:56,840
.لا، هذا كلّ ما أستطيع القيام به

260
00:19:57,590 --> 00:19:59,400
!لقد اتّخذت قراري

261
00:20:00,580 --> 00:20:03,050
!سأصير مغامِرة عندما أكبر

262
00:20:03,050 --> 00:20:06,880
!سأصير مغامِرة وأشكّل فرقة معك

263
00:20:06,880 --> 00:20:09,720
.لذلك لا يوجد ما يدعو للقلق

264
00:20:09,720 --> 00:20:12,290
!أعد أن أكون إلى جانبك لحمايتك

265
00:20:16,860 --> 00:20:21,100
،بعد ذلك، بدأت التّدريب لأصير مغامِرة

266
00:20:21,800 --> 00:20:23,420
.لأكون جاهزة لهذا اليوم

267
00:20:24,080 --> 00:20:27,760
لذلك عندما سمعتُ أنّ لاوست
،طُرد من فرقته

268
00:20:27,760 --> 00:20:29,410
.اتّجهتُ إلى هذه المدينة في الحال

269
00:20:30,300 --> 00:20:33,920
شكّلتُ فرقة معه وهزمنا بعض
.الغوبلين معًا اليوم

270
00:20:34,850 --> 00:20:37,920
...فعلتُ كلّ هذا من أجله، ومع ذلك

271
00:20:40,450 --> 00:20:43,430
لم يتعرّف عليّ حتّى، صحيح؟

272
00:20:44,430 --> 00:20:49,690
،صرتُ أطول ممّا كنت عليه وقتها
.والملابس الّتي أرتديها مختلفة تمامًا

273
00:20:50,250 --> 00:20:51,430
،إضافة لذلك

274
00:20:52,230 --> 00:20:54,520
.لم يعد شعري بنفس اللّون حتّى

275
00:20:55,160 --> 00:20:57,180
.بالطّبع ما كان أيّ أحد ليتعرّف إليّ

276
00:20:57,990 --> 00:20:59,520
.حتّى هو

277
00:20:59,900 --> 00:21:02,490
.كما أنّه صار أقوى بكثير

278
00:21:03,130 --> 00:21:05,990
.صار أقوى لدرجة أنّه لا يحتاجني لإنقاذه

279
00:21:07,240 --> 00:21:10,000
ما الّذي تقولينه يا نارسينا؟

280
00:21:10,000 --> 00:21:12,080
أنت هنا لحمايته، صحيح؟

281
00:21:12,080 --> 00:21:14,170
لماذا تجبنين هكذا الآن؟

282
00:21:14,170 --> 00:21:17,980
،اتّخذتِ القرار لتبدئي هذا
!لذلك عليك أن تستمرّي حتّى النّهاية

283
00:21:31,260 --> 00:21:35,020
ومع ذلك، لماذا يصفه النّاس في المدينة

284
00:21:39,580 --> 00:21:43,700
بالجاهل مع أنّه موهوب للغاية؟