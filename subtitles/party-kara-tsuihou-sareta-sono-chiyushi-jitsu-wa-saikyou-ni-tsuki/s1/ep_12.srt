1
00:00:08,260 --> 00:00:11,280
.أرى أنّك أكثر إصرارًا ممّا توقّعت

2
00:00:16,280 --> 00:00:19,870
ألم يكن يفترض بك هزيمة سيّد المتاهة؟

3
00:00:20,160 --> 00:00:24,440
،لا أدري ما الّذي حدث
.لكنّ التّنّين الشّرّير استولى على جسدك

4
00:00:24,440 --> 00:00:28,740
،لطالما ظننتُ أنّك معلّم فظيع

5
00:00:28,740 --> 00:00:33,010
لكنّي لم أتوقّع أبدًا أن تضعني
.في وضع بهذا السّوء

6
00:00:34,060 --> 00:00:37,510
.ولكن أعتقد أنّي لا أختلف عنك

7
00:00:50,080 --> 00:00:54,540
.آسفة يا لاوست. الأمر منوط بك الآن

8
00:01:10,330 --> 00:01:12,050
،الخوف

9
00:01:12,320 --> 00:01:13,800
،الغضب

10
00:01:14,130 --> 00:01:15,480
،الهزيمة

11
00:01:15,480 --> 00:01:17,530
.وثمّ اليأس

12
00:01:18,220 --> 00:01:21,230
.لجميعها نكهات لذيذة

13
00:01:37,740 --> 00:01:39,700
...أخي الكبير، هل هذا الزّلزال

14
00:01:39,700 --> 00:01:41,770
.نعم، بلا أدنى شكّ

15
00:01:45,010 --> 00:01:48,560
!اقتلوهم! اقتلوهم

16
00:01:48,560 --> 00:01:50,070
!اقتلوهم جميعًا

17
00:01:51,140 --> 00:01:52,750
.بدأ الأمر

18
00:01:53,310 --> 00:01:55,460
!الموجة الثّانية لثورة المتاهة

19
00:01:58,800 --> 00:02:07,810
المعالج الّذي طُرد من فرقته

20
00:02:00,260 --> 00:02:07,810
هو في الحقيقة الأقوى

21
00:03:25,970 --> 00:03:30,980
:الحلقة 12
،بخصوص النّهاية
الّتي كانت في الحقيقة
بداية رحلة جديدة

22
00:03:30,980 --> 00:03:32,370
!ماذا؟

23
00:03:34,430 --> 00:03:35,970
كم عددها؟

24
00:03:36,640 --> 00:03:42,150
لا يمكنني الجزم، لكن على الأرجح
.أنّ أعدادها أكثر من الموجة الأولى

25
00:03:43,610 --> 00:03:45,170
.هكذا إذًا

26
00:03:45,170 --> 00:03:46,500
ما الّذي يحدث؟

27
00:03:46,500 --> 00:03:48,580
هل عادت الوحوش؟

28
00:03:49,000 --> 00:03:50,890
.لا داعي للقلق

29
00:03:50,890 --> 00:03:54,950
،ما دام ذلك الحاجز موجودًا
.لا تستطيع الوحوش دخول المدينة

30
00:03:54,950 --> 00:03:59,710
،حتّى إن لم تستطع الدّخول
!لا يمكننا الخروج إن كانت حولنا

31
00:04:00,010 --> 00:04:02,720
إلى متى سيصمد ذلك الحاجز؟

32
00:04:02,960 --> 00:04:04,220
.لستُ واثقًا

33
00:04:11,120 --> 00:04:14,460
،هذا سيّئ. إن استمرّ هذا

34
00:04:16,000 --> 00:04:17,480
.فلن تصمد رالما لأكثر من هذا

35
00:04:23,010 --> 00:04:25,410
.قد لا نصمد نحن أيضًا

36
00:04:27,670 --> 00:04:29,360
كيف وضعه؟

37
00:04:29,360 --> 00:04:30,830
.ليس جيّدًا

38
00:04:31,310 --> 00:04:35,180
لم يُظهر التّنّين الشّرّير شكله
،الحقيقيّ في عالمنا بعد

39
00:04:35,730 --> 00:04:39,880
.لذلك شكّل تلك الذّراع من المانا المركَّزة

40
00:04:40,690 --> 00:04:43,840
.لن يُشفى هذا الجرح بسهولة

41
00:04:45,630 --> 00:04:47,640
...لاوست

42
00:04:49,520 --> 00:04:54,330
.أريدك أن تسامح زعيم فرع النّقابة

43
00:04:54,330 --> 00:04:56,310
.هانزم، لا تقلق حيال ذلك الآن

44
00:04:56,310 --> 00:04:58,860
.أنا أدين له بكلّ شيء

45
00:04:58,860 --> 00:05:00,150
.أعلم ذلك

46
00:05:00,150 --> 00:05:01,110
.كلاّ

47
00:05:03,360 --> 00:05:06,590
،لا بدّ أنّك تفهم، بصفتك يتيم متاهة أيضًا

48
00:05:06,590 --> 00:05:10,400
أنّه لم يكن هنالك مكان لنا
.في هذه البلدة

49
00:05:10,400 --> 00:05:14,360
.لم يهتمّ بنا أيّ أحد. ولم يحتجنا أيّ أحد

50
00:05:14,360 --> 00:05:19,770
تلاعب بنا النّاس فحسب واستغلّونا
.كأنّنا أغراض يمكن التّخلّص منها

51
00:05:20,500 --> 00:05:23,050
.لكنّه كان مختلفًا

52
00:05:23,760 --> 00:05:27,430
.علّمني كلّ شيء أعرفه

53
00:05:27,430 --> 00:05:31,420
،عندما كنتُ مجرّد جاهل

54
00:05:31,420 --> 00:05:34,370
علّمني كلّ مهارة احتجتُ إليها
.لأعيش في هذا العالم

55
00:05:34,870 --> 00:05:37,670
أدرك أنّه كان يستعملني كوسيط بشريّ

56
00:05:37,670 --> 00:05:42,030
ليستطيع أن يظلّ في الظّلال
،ويخفي حقيقة أنّه كان من الإلف

57
00:05:42,590 --> 00:05:46,930
.ولكن رغم ذلك، أنا ممتنّ كثيرًا لك

58
00:05:46,930 --> 00:05:49,070
.لا، الأمر أكبر من ذلك

59
00:05:49,070 --> 00:05:51,950
.أشعر بصلة معيّنة معه

60
00:05:51,950 --> 00:05:53,540
.أعتقد أنّه يشعر بها أيضًا

61
00:05:53,540 --> 00:05:55,040
!أيّها التّنّين الشّرّير

62
00:05:54,270 --> 00:05:56,910
.لذلك السّبب تردّد للحظة وقتها

63
00:05:56,910 --> 00:05:58,720
.سامحني يا هانزم

64
00:05:59,520 --> 00:06:06,150
سررت كثيرًا من معرفة أنّه اهتمّ لأمري
.بقدر ما اهتممتُ أنا بأمره

65
00:06:06,910 --> 00:06:07,930
...ولكن الآن

66
00:06:08,800 --> 00:06:11,680
.هانزم، أنت مخطئ بشأن أمر ما

67
00:06:11,680 --> 00:06:14,940
.ميست ليس الشّخص الوحيد الّذي يقدّرك

68
00:06:15,880 --> 00:06:18,210
.أنا أعتبرك صديقًا مقرّبًا لي

69
00:06:19,260 --> 00:06:21,530
.لطالما اعتبرتُك كذلك

70
00:06:22,650 --> 00:06:29,360
صديق؟ ربّما. ربّما أكون
.قد اعتبرتك كذلك أيضًا

71
00:06:29,360 --> 00:06:33,950
.لذلك السّبب أردتُ منك مغادرة المدينة

72
00:06:34,480 --> 00:06:39,700
أردتُ منك تجنّب هذه الكارثة
.وتواصل حياتك كمغامر

73
00:06:39,700 --> 00:06:41,210
!هذا أنانيّ فحسب

74
00:06:41,630 --> 00:06:42,760
نارسينا؟

75
00:06:42,760 --> 00:06:44,460
ألا تظنّ ذلك؟

76
00:06:44,720 --> 00:06:48,470
أعلم أنّه كانت هنالك أمور ما
،بخصوص المستشار وما إلى ذلك

77
00:06:48,720 --> 00:06:52,470
لكنّ ذلك لا يعني أنّه كان
يجب عليك إخفاء كلّ شيء عنّا

78
00:06:53,020 --> 00:06:55,570
.والتّسبّب بالكثير من المشاكل لأخي الكبير

79
00:06:55,570 --> 00:06:57,630
أهذا ما تعنيه الصّداقة لك؟

80
00:06:58,310 --> 00:07:00,810
!كيف يمكنك حتّى أن تقول أنّك صديقه؟

81
00:07:02,750 --> 00:07:04,740
.لا بأس يا نارسينا

82
00:07:05,760 --> 00:07:07,060
.لا بأس

83
00:07:10,160 --> 00:07:12,300
.لستَ بحاجة لمعالجتي

84
00:07:13,360 --> 00:07:15,890
.كانت كلّ جهودنا هباءً

85
00:07:15,890 --> 00:07:19,460
.علينا الآن مواجهة العقاب الّذي نستحقّه

86
00:07:19,460 --> 00:07:21,920
.إنّك بالفعل أنانيّ للغاية

87
00:07:21,920 --> 00:07:23,880
.عليك أن تنجو

88
00:07:23,880 --> 00:07:27,740
من واجبك مواصلة العيش
!لتتحمّل المسؤوليّة بنفسك

89
00:07:30,620 --> 00:07:31,480
.شفاء

90
00:07:38,020 --> 00:07:40,460
حسنًا يا رجال! هل أنتم جاهزون؟

91
00:07:40,460 --> 00:07:41,520
!نعم

92
00:07:41,520 --> 00:07:42,640
!لننطلق

93
00:07:46,570 --> 00:07:48,940
.خرج مارنل ورجاله

94
00:07:48,940 --> 00:07:52,410
.لا بدّ أنّهم يحاولون تقليل الحمل عن رالما

95
00:07:52,410 --> 00:07:54,450
.مهلاً. ليس رجال مارنل فحسب

96
00:07:55,920 --> 00:07:57,450
!قاتلوا بشدّة يا رفاق

97
00:07:58,000 --> 00:08:01,190
!سأدفع لكم القدر الّذي تطلبونه بعد هذا

98
00:08:01,190 --> 00:08:05,460
،ليس أنا من سيدفع لكم بالضّبط
!بل النّقابة بكلّ تأكيد

99
00:08:05,460 --> 00:08:08,900
.على الأقلّ هم مفيدون في المعارك

100
00:08:08,900 --> 00:08:12,720
وحتّى الآن، يسير كلّ شيء حسب
.ما توقّعه زعيم فرع النّقابة

101
00:08:13,130 --> 00:08:16,360
.فيما عدا استيلاء التّنّين الشّرّير على جسده

102
00:08:17,280 --> 00:08:18,720
ما خطّتكم يا رفاق؟

103
00:08:19,060 --> 00:08:22,200
.بإمكانكم التّخلّي عن المدينة والهرب

104
00:08:22,740 --> 00:08:25,920
،إن عاد التّنّين بشكل كامل
ألن يدمّر العالم؟

105
00:08:25,920 --> 00:08:28,320
.سيكون الهرب بلا جدوى

106
00:08:28,320 --> 00:08:30,230
.سنرافقك يا معلّمي

107
00:08:31,410 --> 00:08:32,450
.نارسينا

108
00:08:33,240 --> 00:08:34,490
نعم يا أخي الكبير؟

109
00:08:35,200 --> 00:08:36,390
.ستبقين في الخلف

110
00:08:38,500 --> 00:08:39,440
ماذا؟

111
00:08:42,250 --> 00:08:43,960
المعالج الّذي طُرد من فرقته هو في الحقيقة الأقوى

112
00:09:09,100 --> 00:09:14,380
،بما أنّي أعلم أنّك الأميرة النّائمة
.لا يمكنني السّماح لك بالاقتراب من التّنّين

113
00:10:02,530 --> 00:10:04,040
!أخي الكبير

114
00:10:24,640 --> 00:10:25,640
!اذهبي

115
00:10:27,140 --> 00:10:29,560
.ستندمين إن لم تذهبي الآن

116
00:10:37,030 --> 00:10:38,490
!ابتعد عن طريقي

117
00:10:42,890 --> 00:10:44,080
نارسينا؟

118
00:10:46,040 --> 00:10:47,410
!أخي الكبير

119
00:10:54,490 --> 00:10:55,300
!تنحّي

120
00:11:08,520 --> 00:11:11,900
!هذا سيّئ. سينهار الحاجز إن استمرّ هذا

121
00:11:13,400 --> 00:11:14,540
...رالما

122
00:11:16,600 --> 00:11:21,220
علينا أخذ سكّان البلدة إلى مكان
.آمن قبل دخول الوحوش

123
00:11:21,220 --> 00:11:22,950
ولكن أين يمكننا الذّهاب؟

124
00:11:26,750 --> 00:11:28,370
ما الّذي تعتقدين أنّك فاعلة؟

125
00:11:28,720 --> 00:11:31,160
.سأستعمل قوّة الأميرة النّائمة

126
00:11:31,160 --> 00:11:34,330
هل تدركين فعلاً ما يعنيه ذلك؟

127
00:11:35,130 --> 00:11:37,550
.لا توجد طريقة أخرى

128
00:11:37,550 --> 00:11:42,000
الأميرة النّائمة قادرة على جعل
.التّنّين الشّرّير يخلد للنّوم

129
00:11:42,000 --> 00:11:45,800
.لكنّ تلك القدرة ليست بالقوّة الّتي تظنّين

130
00:11:45,800 --> 00:11:47,850
.إنّها تستمرّ لعشر سنوات فحسب

131
00:11:49,480 --> 00:11:51,450
ألا تزالين تريدين القيام بذلك؟

132
00:11:53,620 --> 00:11:55,500
ستستمرّ لعشر سنوات فحسب؟

133
00:11:56,240 --> 00:11:57,970
.تلك ليست مدّة طويلة

134
00:11:58,860 --> 00:12:01,580
.لكنّها ليست قصيرة أيضًا

135
00:12:07,040 --> 00:12:10,870
،إن لم يكن لدينا بطل
.فسيكون عليكم البحث عنه فحسب

136
00:12:10,870 --> 00:12:14,960
.أنا واثقة أنّ أخي الكبير سيجده
.وعشر سنوات مدّة طويلة

137
00:12:16,300 --> 00:12:17,910
!أنا أؤمن به

138
00:12:22,560 --> 00:12:23,720
!أيّها التّنّين الشّرّير

139
00:12:28,470 --> 00:12:30,720
!تعال إلى هنا والتهمني

140
00:12:38,190 --> 00:12:43,390
لا فائدة. لا يمكنك مقاومة إغراء
.التهام الأميرة النّائمة

141
00:12:54,800 --> 00:12:55,860
!كلاّ

142
00:12:56,760 --> 00:12:59,920
!كلاّ يا نارسينا

143
00:13:07,380 --> 00:13:09,680
!لاوست! هذا ما حدث وقتها أيضًا

144
00:13:09,680 --> 00:13:11,520
!تراجعي يا لايرا! وأنت أيضًا يا أرميا

145
00:13:31,290 --> 00:13:36,040
يبدو أنّ هنالك بعض الأشياء
.حتّى التّنّين الشّرّير يجهلها

146
00:13:37,540 --> 00:13:40,020
.إنّها قويّة للغاية

147
00:13:53,350 --> 00:13:54,720
!أخي الكبير

148
00:13:57,670 --> 00:14:00,940
!ما الخطب يا أخي الكبير؟ يا أخي الكبير

149
00:14:05,300 --> 00:14:09,240
،هذا سيّئ. إن استمرّ هكذا
.فلن يستطيع العودة لطبيعته

150
00:14:14,150 --> 00:14:16,620
.عد لطبيعتك رجاءً

151
00:14:31,670 --> 00:14:35,890
.عد لطبيعتك رجاءً يا أخي الكبير

152
00:14:38,420 --> 00:14:40,180
!توقّف

153
00:14:47,700 --> 00:14:49,280
نارسينا؟

154
00:14:49,740 --> 00:14:53,700
...نعم. أنا هنا إلى جانبك

155
00:14:55,030 --> 00:14:56,160
.يا أخي الكبير

156
00:15:14,240 --> 00:15:16,220
.لن ترحل إلى أيّ مكان

157
00:15:18,410 --> 00:15:19,810
!لاوست! الآن

158
00:15:20,620 --> 00:15:21,810
...لكن

159
00:15:22,180 --> 00:15:26,820
ما الخطب؟ هذا هو العدوّ
.الّذي أرعبكم جميعًا

160
00:15:27,200 --> 00:15:28,950
لماذا تتردّد؟

161
00:15:31,360 --> 00:15:35,830
.لقد عشتُ حياة طويلة جدًّا
.كانت أكثر بكثير من كافية

162
00:15:41,580 --> 00:15:43,080
.سأقوم أنا بذلك

163
00:15:43,470 --> 00:15:44,550
...نارسينا

164
00:15:45,750 --> 00:15:47,160
.لا، أنا من عليه ذلك

165
00:15:47,160 --> 00:15:49,590
.تتصرّف هكذا دائمًا

166
00:15:49,590 --> 00:15:52,590
هلاّ سمحت لي بحمل نصف
العبء عنك رجاءً؟

167
00:15:57,200 --> 00:15:58,710
.لنفعلها يا نارسينا

168
00:15:58,710 --> 00:16:00,140
.حسنًا يا أخي الكبير

169
00:16:17,120 --> 00:16:22,850
.أحسنتم. لقد غيّر هذا تدفّق السّحر

170
00:16:24,460 --> 00:16:28,460
.تمّ منع عودة التّنّين الشّرّير في الوقت الحاليّ

171
00:16:29,810 --> 00:16:33,110
.والمانا الّتي أغرقت المنطقة تتراجع الآن أيضًا

172
00:16:33,110 --> 00:16:35,890
.ستنتهي الثّورة قريبًا

173
00:16:38,700 --> 00:16:44,970
،أحسنتم يا لاوست ونارسينا
.وأنت أيضًا يا هانزم

174
00:16:47,480 --> 00:16:52,400
.سيّدي ميست، كنتَ بمثابة الأب لي بالفعل

175
00:16:54,600 --> 00:16:58,380
.كنت أصغر بكثير بالنّسبة لي يا بنيّ

176
00:17:14,620 --> 00:17:16,270
أأنت بخير يا رالما؟

177
00:17:16,270 --> 00:17:19,800
ماذا عنك؟ أراهن أنّك ضغطت
.على نفسك كثيرًا ثانية

178
00:17:22,060 --> 00:17:26,270
.لقد قطعتُ عهدًا بحمايتك بحياتي

179
00:17:26,580 --> 00:17:29,770
أتمنّى لو تتوقّف عن قطع
.عهود غريبة بدون إذني

180
00:17:29,770 --> 00:17:33,500
.لكن أعتقد أنّ عليّ أن أشكرك
...وأيضًا

181
00:17:34,880 --> 00:17:36,780
.أتطلّع قُدمًا لقضاء المزيد من الوقت معك

182
00:17:42,530 --> 00:17:45,040
.مات ميست

183
00:17:45,750 --> 00:17:50,540
،عاد التّنّين الشّرّير إلى سباته
.والأميرة النّائمة حيّة تُرزق أيضًا

184
00:17:51,320 --> 00:17:54,350
.يبدو أنّ العالم قد نجا

185
00:17:55,820 --> 00:17:58,950
...ولكن، هذا الرّجل المدعوّ لاوست

186
00:17:59,890 --> 00:18:03,740
.لا بدّ أنّه ليس البطل المقدام

187
00:18:07,190 --> 00:18:10,980
!ماذا؟! زعيم فرع النّقابة الجديد هو أنا؟

188
00:18:10,980 --> 00:18:15,240
!هو أنا؟

189
00:18:15,810 --> 00:18:17,740
.يمكنك رؤية الحالة الّتي أنا عليها

190
00:18:18,660 --> 00:18:21,580
وأنا لا أملك المعايير المناسبة
.لأقف على رأس أيّ أحد

191
00:18:20,850 --> 00:18:23,390
!هذا مؤلم! مؤلم! مؤلم

192
00:18:21,580 --> 00:18:23,390
!ولا أنا أيضًا

193
00:18:23,390 --> 00:18:26,080
...بخصوص أجرة زعيم فرع النّقابة

194
00:18:26,450 --> 00:18:30,310
سأعمل أنا أمارست بكلّ جهدي

195
00:18:30,310 --> 00:18:33,090
لإعادة بناء هذه النّقابة
!ومدينة ماردات الجميلة

196
00:18:36,390 --> 00:18:39,590
هل كنت تعرف بأمر قوّة لاوست؟

197
00:18:39,590 --> 00:18:44,920
نعم، وكنتُ أعرف أنّها ليست شيئًا
.يستطيع أيّ أحد السّيطرة عليه

198
00:18:44,920 --> 00:18:48,060
.دعوا ذلك الأمر للنّقابة في العاصمة الملكيّة

199
00:18:48,540 --> 00:18:54,160
هل يعني ذلك أنّه ما عاد هنالك سبب
يدفعنا لنكون في نفس الفرقة مع لاوست؟

200
00:18:54,160 --> 00:18:55,590
.أفترض ذلك

201
00:18:59,630 --> 00:19:01,880
،أجّلنا هذا الأمر لوقت طويل

202
00:19:01,880 --> 00:19:04,630
.لكنّ التّنّين الشّرّير سينهض ثانية يومًا ما

203
00:19:04,630 --> 00:19:05,360
.نعم

204
00:19:05,870 --> 00:19:09,370
.لذلك السّبب أنا أفكّر في الذّهاب في رحلة

205
00:19:10,050 --> 00:19:12,150
.رحلة لتحديد مكان البطل المقدام

206
00:19:12,790 --> 00:19:14,800
فعلاً؟

207
00:19:16,860 --> 00:19:23,260
...لذلك... إن أردتِ أن
...أعني إن أردتِ فعلاً

208
00:19:26,190 --> 00:19:29,440
فهلاّ رافقتني يا نارسينا؟

209
00:19:32,640 --> 00:19:38,230
أذلك هو الأمر المهمّ الّذي
واصلتَ تأجيل إخباري به؟

210
00:19:38,230 --> 00:19:41,320
.ماذا؟ أعتقد ذلك

211
00:19:41,320 --> 00:19:45,330
لكنّه تغيّر عمّا كنتُ أخطّط
.لإخبارك به في البداية

212
00:19:46,030 --> 00:19:50,250
فعلاً؟ لقد أتيتُ إلى هنا
.لأنّي أردت تشكيل فرقة معك

213
00:19:50,250 --> 00:19:52,220
.ولم يتغيّر ذلك على الإطلاق

214
00:19:53,060 --> 00:19:54,230
فعلاً؟

215
00:19:57,090 --> 00:19:58,180
.فعلاً

216
00:20:06,850 --> 00:20:08,710
!لاوست! نارسينا

217
00:20:09,850 --> 00:20:10,650
.تفضّلا

218
00:20:12,290 --> 00:20:14,730
جهّزت لنا علبة طعام؟

219
00:20:15,130 --> 00:20:16,070
كيف عرفت؟

220
00:20:17,110 --> 00:20:20,490
!كان من الواضح أنّكما ستحاولان الرّحيل خلسة

221
00:20:44,340 --> 00:20:48,470
أيمكننا فعل السّماح لهما بالذّهاب وحدهما؟

222
00:20:48,470 --> 00:20:52,520
إنّ ذلك هو ما قرّراه. لذلك
...لا نريد اعتراض طريقهما. وأيضًا

223
00:20:52,520 --> 00:20:54,900
،ما داما سيظلاّن مغامريْن

224
00:20:54,900 --> 00:20:57,520
.فأنا واثق أنّنا سنراهما في متاهة أخرى يومًا ما

225
00:20:57,850 --> 00:20:59,520
...وحتّى ذلك الحين

226
00:20:59,870 --> 00:21:02,580
.سنودّع بعضنا أيّها التّلميذ الغبيّ

227
00:21:14,390 --> 00:21:16,250
أجاهزة يا نارسينا؟

228
00:21:16,510 --> 00:21:18,040
!نعم يا الكبير