1
00:00:09,660 --> 00:00:11,200
.ها هو ذا

2
00:00:11,200 --> 00:00:12,610
...والرّؤوس

3
00:00:13,150 --> 00:00:15,520
.لا يبدو أنّها كبرت ثانية بعد

4
00:00:17,410 --> 00:00:19,080
.سنواجهه أنا ولايرا

5
00:00:19,550 --> 00:00:20,380
ماذا؟

6
00:00:20,380 --> 00:00:22,690
.أرميا، ادعمينا بسحرك

7
00:00:23,520 --> 00:00:27,510
سابيريا، اذهبي خلفه خلسة
.لتهاجميه على حين غرّة

8
00:00:27,510 --> 00:00:28,320
.عُلم

9
00:00:28,320 --> 00:00:28,920
!لننطلق

10
00:00:28,920 --> 00:00:30,970
!مـ-مهلاً لحظة

11
00:00:30,970 --> 00:00:31,920
ماذا هنالك؟

12
00:00:32,260 --> 00:00:35,930
!أنا معالِجة. لا يمكنني التّواجد في المقدّمة

13
00:00:36,310 --> 00:00:39,180
.ماذا؟ كان لاوست يقوم بذلك دائمًا

14
00:00:39,620 --> 00:00:43,360
لاوست؟ يقصد... الرّجل الّذي
كان في فرقتكم قبلي؟

15
00:00:43,360 --> 00:00:44,390
.نعم

16
00:00:45,180 --> 00:00:46,280
!لا أصدّق هذا

17
00:00:46,280 --> 00:00:49,360
كنتم تجبرون معالجًا على القتال القريب؟

18
00:00:49,680 --> 00:00:52,310
،نعم. كان يركض في الجوار كثيرًا

19
00:00:52,310 --> 00:00:54,320
ولكنّه كان يسدّد هجمات ناجحة
.من وقت لآخر

20
00:00:54,670 --> 00:00:56,000
.هذا صحيح

21
00:00:56,000 --> 00:00:59,780
.كما أنّي واثقة أنّه من قطع ذلك الرّأس

22
00:01:00,470 --> 00:01:03,200
قطع معالجٌ أحد رؤوس الهايدرا؟

23
00:01:04,130 --> 00:01:06,720
.حسنًا، لا مشكلة إن كنت لا تستطيعين ذلك

24
00:01:06,720 --> 00:01:08,630
.يمكنك البقاء في الخلف إذًا

25
00:01:08,630 --> 00:01:10,290
يمكنك استعمال تعاويذ التّراقي، صحيح؟

26
00:01:10,640 --> 00:01:11,800
.بالطّبع أستطيع

27
00:01:12,200 --> 00:01:13,670
.سنكون بخير إذًا

28
00:01:14,730 --> 00:01:19,400
سنحرص أن يكون اليوم هو آخر
!يوم لهذا الهايدرا

29
00:03:00,880 --> 00:03:02,700
.تفضّلي

30
00:03:03,020 --> 00:03:06,580
حسنًا، حسنًا. أرى أنّكما عدتما
.بالكثير اليوم أيضًا

31
00:03:10,060 --> 00:03:12,540
.كما أنّكما ذهبتما للمستويات الوسطى ثانية

32
00:03:13,000 --> 00:03:16,440
لكن من الأفضل ألاّ ترغم نارسينا على
.القيام بما لا تستطيعه يا لاوست

33
00:03:17,000 --> 00:03:21,450
أكيد. نحن فرقة صغيرة تتكوّن
،من اثنين فقط

34
00:03:21,450 --> 00:03:23,010
.لذلك فنحن نتقدّم بحذر

35
00:03:23,440 --> 00:03:25,410
،من الجيّد أنّكما تتصرّفان بحذر

36
00:03:25,410 --> 00:03:28,270
.لكن لا يمكنكما القيام بالكثير بعضوين فقط

37
00:03:28,680 --> 00:03:31,100
ألم يحن الوقت بعد لضمّ أعضاء جدد؟

38
00:03:32,190 --> 00:03:35,240
ستستفيدان كثيرًا بوجود محارب
.أو ساحر في فرقتكما

39
00:03:35,240 --> 00:03:37,980
،بإمكانكما الإطاحة بالمزيد من الوحوش الخطيرة

40
00:03:37,980 --> 00:03:40,150
.وستجنيان مالاً أكثر

41
00:03:40,150 --> 00:03:42,710
!لكما ولي أيضًا

42
00:03:43,840 --> 00:03:45,880
...قد تكونين محقّة

43
00:03:45,880 --> 00:03:48,600
لكن أعتقد أنّ لا بأس بنا نحن
.الاثنين فقط حاليًّا

44
00:03:48,600 --> 00:03:52,460
.تظنّ ذلك؟ إنّكما تجنيان الكثير سلفًا

45
00:03:53,030 --> 00:03:56,510
.على هذا المعدّل، بإمكانكما حتّى تأجير منزل

46
00:03:56,510 --> 00:03:57,210
منزل؟

47
00:03:57,580 --> 00:04:02,190
نعم. إنّ الفرق الّتي لديها مال
إضافيّ بإمكانها تأجير منازل خاصّة

48
00:04:02,190 --> 00:04:04,180
.واستعمالها كقاعدة لعمليّاتها

49
00:04:04,500 --> 00:04:09,390
عند الإقامة في نُزل، يكون هنالك حدّ
،للعُدّة والأغراض الّتي يمكن تخزينها

50
00:04:09,390 --> 00:04:12,030
.كما أنّ تكلفة ذلك ليست قليلة إطلاقًا

51
00:04:12,480 --> 00:04:14,690
،ولكن عندما يكون هنالك ثنائيّ من رجل وامرأة

52
00:04:16,790 --> 00:04:20,790
يمكنكما التّودّدّ لبعضكما كما تشاءان
.ولن يصير المنزل مجرّد قاعدة

53
00:04:20,790 --> 00:04:23,010
!بل سيصير عشّ حبّ

54
00:04:23,010 --> 00:04:25,530
.تظلّ هذه إمكانيّة دائمًا

55
00:04:33,770 --> 00:04:35,020
.أو ربّما ليست كذلك في نهاية المطاف

56
00:04:35,020 --> 00:04:36,540
لماذا قد لا تكون؟

57
00:04:38,240 --> 00:04:42,800
بالمناسبة، كانت فرقة أنصال البرق
.تستأجر منزلاً خاصًّا أيضًا

58
00:04:43,960 --> 00:04:46,460
.لكنّ غرفتي كانت مجرّد خزانة

59
00:04:48,890 --> 00:04:52,110
لقد أساؤوا معاملتك بالفعل، أليس كذلك؟

60
00:04:52,110 --> 00:04:55,680
،بالمناسبة! بالحديث عن أنصال البرق

61
00:04:55,680 --> 00:05:00,370
.قد يكون طردك منها لصالحك في نهاية المطاف

62
00:05:02,570 --> 00:05:03,820
!لماذا؟

63
00:05:04,740 --> 00:05:07,570
!لماذا لا يمكننا هزيمة ذلك الهايدرا؟

64
00:05:07,570 --> 00:05:10,490
!لماذا نفشل دائمًا في هذا الأمر؟

65
00:05:10,490 --> 00:05:15,410
لأنّك تصرّ على مهاجمته مباشرة
.رغم أنّك لستَ قويًّا بما يكفي

66
00:05:15,680 --> 00:05:17,500
ماذا؟ هل قلتِ شيئًا ما؟

67
00:05:18,450 --> 00:05:21,000
.هلاّ أخفضت صوتك؟ لا يمكنني التّركيز

68
00:05:23,960 --> 00:05:25,240
.ستكونين بخير

69
00:05:25,240 --> 00:05:27,140
.سيصدّ هذا السّمَّ

70
00:05:27,790 --> 00:05:29,660
.شكرًا جزيلاً لك

71
00:05:31,520 --> 00:05:34,060
...اسمع، لم أتخيّل أبدًا أنّي سأقول هذا

72
00:05:34,060 --> 00:05:36,080
تقصدين المدعوّ لاوست؟

73
00:05:36,080 --> 00:05:39,270
.يبدو أنّه كان مفيدًا جدًّا بالفعل

74
00:05:39,270 --> 00:05:42,080
،على الرّغم من كلّ التّذمّر
.إلاّ أنّه كان ينجز عمله

75
00:05:42,080 --> 00:05:45,280
كما لم يكن يلاحظ عندما
.نختلس من حصّته أيضًا

76
00:05:45,280 --> 00:05:47,530
سُحقًا! لماذا كان عليه الرّحيل؟

77
00:05:48,170 --> 00:05:50,030
!بل أنت من طرده

78
00:05:50,320 --> 00:05:52,460
ماذا؟ أذلك ما حدث؟

79
00:05:52,960 --> 00:05:54,910
!سيجعل هذا الأمرَ أسهل إذًا

80
00:05:55,320 --> 00:05:59,580
ماذا؟ هل تعرف طريقة جيّدة لإعادته؟

81
00:05:59,580 --> 00:06:03,620
.سأذهب إليه وأقول "عد!" فحسب

82
00:06:03,620 --> 00:06:04,550
ماذا؟

83
00:06:04,550 --> 00:06:08,630
!لأنّنا فرقة أنصال البرق المشهورة

84
00:06:09,000 --> 00:06:11,970
!لا يستطيع أحد رفض دعوة منّا

85
00:06:26,750 --> 00:06:28,010
آنسة لايرا؟

86
00:06:29,880 --> 00:06:31,490
.أرى أنّك استيقظت

87
00:06:31,490 --> 00:06:32,830
كيف تشعرين؟

88
00:06:33,430 --> 00:06:35,420
.صرت أفضل بكثير الآن

89
00:06:35,420 --> 00:06:36,580
.هذا جيّد

90
00:06:38,600 --> 00:06:42,670
يا إلهي! كم نمتُ يا ترى على أيّ حال؟

91
00:06:44,460 --> 00:06:45,760
كيف هي شهيّتك؟

92
00:06:45,760 --> 00:06:47,340
أتريدين منّي إحضار شيء لتأكليه؟

93
00:06:47,340 --> 00:06:49,880
.نعم! لكنّي لا أحتاج للكثير

94
00:06:49,880 --> 00:06:52,030
.مفهوم. سأعود بعد قليل

95
00:06:54,880 --> 00:06:56,300
سابيريا؟

96
00:06:58,210 --> 00:06:59,660
مارغولوس؟

97
00:07:02,330 --> 00:07:04,940
إلى أين ذهبا يا ترى؟

98
00:07:06,150 --> 00:07:08,140
!لاوست، انضمّ إلينا ثانية

99
00:07:08,140 --> 00:07:11,240
!ستسمح لك أنصال البرق بالعودة إليها

100
00:07:11,240 --> 00:07:16,790
...بالعودة إليها

101
00:07:17,600 --> 00:07:18,910
...عفوًا

102
00:07:20,450 --> 00:07:22,250
ما الّذي قتله؟

103
00:07:22,740 --> 00:07:24,340
!كما سمعت

104
00:07:24,340 --> 00:07:27,890
!أقول لك عد إلى فرقتنا

105
00:07:27,890 --> 00:07:28,920
...عفوًا

106
00:07:30,650 --> 00:07:33,660
ذلك الرّجل هو مارغولوس
.من فرقة أنصال البرق

107
00:07:36,560 --> 00:07:40,390
.أفهم تمامًا لماذا قد تتردّد يا لاوست

108
00:07:40,390 --> 00:07:45,690
من الصّعب على شخص من مستواك
.مجاراة مغامر من المستوى الرّفيع مثلي

109
00:07:46,010 --> 00:07:48,030
!لكن لا حاجة للقلق

110
00:07:48,030 --> 00:07:49,940
—إن ساءت الأمور، فسأتخلّص منـ

111
00:07:49,940 --> 00:07:54,320
ما أحاول قوله هو أنّي سأضحّي
!بنفسي لحمايتك

112
00:07:54,630 --> 00:07:57,010
.هذه ليست المشكلة

113
00:07:57,010 --> 00:07:59,390
ماذا؟ تقصد حصّتك؟

114
00:07:59,390 --> 00:08:01,740
!معك حقّ. المال مهمّ للغاية

115
00:08:02,240 --> 00:08:04,330
.بالطّبع ستحصل على حصّة عادلة

116
00:08:04,730 --> 00:08:09,300
لسبب ما، يبدو أنّه كان هنالك بعض
.الأخطاء في الحسابات من قبل

117
00:08:09,300 --> 00:08:11,140
!لكنّي سأكون حذرًا أكثر هذه المرّة

118
00:08:11,140 --> 00:08:13,980
صدّقني، أتمنّى لو أعرف
.كيف حدث هذا من قبل

119
00:08:15,590 --> 00:08:17,520
.واسمح لي بإطلاعك بأمر ما

120
00:08:17,520 --> 00:08:21,180
المعالِجة الجديدة الّتي ضممناها
.غير مفيدة بالمرّة

121
00:08:21,680 --> 00:08:25,190
فكّر فقط كم أنّك ستكون
!ذا عون لنا! فعُد إلينا

122
00:08:27,940 --> 00:08:28,940
.شكرًا لك

123
00:08:29,640 --> 00:08:31,530
!ماذا؟

124
00:08:31,940 --> 00:08:32,780
...إذًا

125
00:08:32,780 --> 00:08:33,860
!تمهّل

126
00:08:35,780 --> 00:08:38,620
أشيح نظري عنه للحظة واحدة
!لتتسلّل أنت وتبدأ بالحديث معه؟

127
00:08:39,020 --> 00:08:43,640
لذلك استمع أنت لي. لن يعود
.لاوست إلى فرقتكم ثانية أبدًا

128
00:08:43,640 --> 00:08:46,770
!لقد صار شريكًا قيّمًا بالنّسبة لي

129
00:08:46,770 --> 00:08:48,630
.لا أظنّ أنّ ذلك سيدوم

130
00:08:48,630 --> 00:08:51,130
لماذا لا تسألينه بنفسه يا صغيرة؟

131
00:08:53,190 --> 00:08:55,010
.لا بأس يا نارسينا

132
00:08:55,010 --> 00:08:56,190
...ولكن

133
00:08:57,400 --> 00:09:00,750
،مارغولوس، شكرتك من باب الأدب

134
00:09:00,750 --> 00:09:04,060
،لأنّك طلبت منّي العودة لفرقتك

135
00:09:04,060 --> 00:09:05,600
.بغضّ النّظر عن نواياك الحقيقيّة

136
00:09:07,030 --> 00:09:08,640
.ولكنّي آسف

137
00:09:08,640 --> 00:09:11,460
.لديّ رفيقة جديدة الآن

138
00:09:11,460 --> 00:09:14,080
.ولن أعود إلى أنصال البرق ثانية

139
00:09:15,760 --> 00:09:18,820
!مـ-مهلاً لحظة! عليك التّفكير في الأمر جيّدًا

140
00:09:18,820 --> 00:09:20,140
!صحيح

141
00:09:20,140 --> 00:09:23,870
أراهن أنّ هذه الصّغيرة تحاول
!استغلالك فحسب

142
00:09:23,870 --> 00:09:24,660
ماذا؟

143
00:09:25,080 --> 00:09:29,340
أراهن أنّكِ أدركتِ أنّ لاوست
!الجاهل ليس جاهلاً على الإطلاق

144
00:09:29,340 --> 00:09:32,800
!وأنّه مغامر مفيد للغاية لأيّ فرقة

145
00:09:33,410 --> 00:09:36,850
هل تحاولين إخباري أنّك لا تقومين
بخداعه وتسرقين حصّته؟

146
00:09:36,850 --> 00:09:39,360
!يبدو كلّ هذا منطقيًّا الآن
!النّقابة متواطئة في هذا أيضًا

147
00:09:39,360 --> 00:09:40,010
!ماذا؟

148
00:09:40,530 --> 00:09:44,460
!افتح عينيك يا لاوست
!إنّك تتعرّض للخداع

149
00:09:44,460 --> 00:09:47,480
!لن تكون هذه الفتاة الصّغيرة صديقة لك أبدًا

150
00:09:48,560 --> 00:09:51,190
!ما... مهلاً، اتركني

151
00:09:51,440 --> 00:09:54,260
،لا أحمل أيّ ضغينة ضدّك

152
00:09:54,260 --> 00:09:57,950
...لكن إن فعلت أيّ شيء لأذيّة نارسينا

153
00:09:58,640 --> 00:10:00,350
ما-ماذا ستفعل؟

154
00:10:01,600 --> 00:10:04,450
.لن أسامح أنصال البرق أبدًا

155
00:10:18,700 --> 00:10:19,560
!أمارست

156
00:10:19,560 --> 00:10:20,390
ما-ماذا؟

157
00:10:21,430 --> 00:10:23,520
!عرّفيني بمغامر جديد

158
00:10:23,520 --> 00:10:25,020
!ليكن شخصًا قويًّا

159
00:10:25,830 --> 00:10:28,990
شخص بإمكانه تولّي المسؤوليّة
.في الجبهات الأماميّة معي

160
00:10:28,990 --> 00:10:31,270
!نعم، محارب! أحتاج محاربًا

161
00:10:31,710 --> 00:10:33,520
هذا لا يُعقل. مرّة أخرى؟

162
00:10:33,520 --> 00:10:38,530
ستهزم أنصال البرق ذلك الهايدرا
!مهما كلّف الأمر

163
00:10:40,030 --> 00:10:41,370
هل أنا مناسب؟

164
00:10:46,650 --> 00:10:48,200
ومن تكون أنت؟

165
00:10:56,850 --> 00:10:59,840
مهلاً! لا يستطيع المغامرون
!القتال فيما بينهم

166
00:10:59,840 --> 00:11:02,580
.اخرسي! هذا مجرّد تدريب

167
00:11:02,580 --> 00:11:03,550
!اخرسي وشاهدي

168
00:11:12,850 --> 00:11:14,130
!ماذا؟

169
00:11:14,130 --> 00:11:15,280
!هذا جنون

170
00:11:15,860 --> 00:11:16,960
.لا أصدّق

171
00:11:16,960 --> 00:11:18,840
!إنّه مجرّد كلام بلا أفعال

172
00:11:21,490 --> 00:11:23,340
!ما-ما الّذي تحدّقون به جميعًا؟

173
00:11:23,340 --> 00:11:25,870
!كنتُ أتساهل معه فحسب

174
00:11:27,310 --> 00:11:28,570
.مارغولوس

175
00:11:31,360 --> 00:11:33,720
.سأخذه معنا

176
00:11:34,400 --> 00:11:37,870
أستثق برجل لا يُظهر حتّى وجهه؟

177
00:11:39,060 --> 00:11:42,130
.يكفي أنّ بإمكاني أن أثق بسيفه

178
00:11:42,130 --> 00:11:44,510
.ولا خيار آخر أمامنا

179
00:11:45,280 --> 00:11:50,040
انتظري وستشاهدين ما الّذي سيحدث
.إن انتشرت إشاعات عجزنا عن هزيمة الهايدرا

180
00:11:50,040 --> 00:11:53,520
.ستهوي سمعة أنصال البرق إلى الحضيض

181
00:11:55,610 --> 00:11:57,400
ما اسمك؟

182
00:11:57,730 --> 00:11:59,640
.أنا زيـ... لا

183
00:12:00,570 --> 00:12:01,760
.شيك

184
00:12:26,010 --> 00:12:27,510
شيلا؟

185
00:12:27,860 --> 00:12:29,060
...أيُعقل أنّها

186
00:12:29,060 --> 00:12:30,540
!تحاول التّقرّب منه؟

187
00:12:31,520 --> 00:12:33,720
.على رسلك. ذلك يبدو سخيفًا

188
00:12:36,340 --> 00:12:39,230
.ماذا هنالك يا شيلا؟ ما زال الوقت باكرًا

189
00:12:39,230 --> 00:12:41,210
.لديك ضيوف يا سيّد لاوست

190
00:12:41,210 --> 00:12:41,900
ضيوف؟

191
00:12:42,500 --> 00:12:45,410
نعم. ولماذا لا تنضميّن أنت أيضًا؟

192
00:12:45,730 --> 00:12:47,720
.قد يكون ضيوفك كذلك

193
00:12:57,490 --> 00:12:59,880
ما الّذي تريدين الحديث بشأنه؟

194
00:13:06,820 --> 00:13:09,410
.عفوًا، أنا آسفة

195
00:13:09,410 --> 00:13:15,890
أدرك تمامًا أنّ هذا ليس
.شيئًا عليّ أن أطلبه منك

196
00:13:19,450 --> 00:13:20,900
.يمكنك أن تدخلي صلب الموضوع

197
00:13:24,400 --> 00:13:28,700
سيّد لاوست، هل يمكنني
إقناعك بالمجيء لمساعدتنا؟

198
00:13:29,130 --> 00:13:30,760
ماذا تقصدين؟

199
00:13:30,760 --> 00:13:32,070
...إنّنا

200
00:13:33,040 --> 00:13:35,760
.إنّه الهايدرا
.الوحش الّذي يسعى مارغولوس خلفه

201
00:13:35,760 --> 00:13:38,000
.إنه يخطّط لصيده ثانية اليوم أيضًا

202
00:13:38,000 --> 00:13:41,840
.إنّه متحمّس للغاية بعد ضمّ محارب جديد

203
00:13:41,840 --> 00:13:44,250
.ما زال لم يتعلّم درسه بعد

204
00:13:44,250 --> 00:13:46,720
.لكنّ ذلك قد يكون مفيدًا أيضًا

205
00:13:47,180 --> 00:13:50,300
.حتّى التّفاؤل له حدود

206
00:13:50,300 --> 00:13:53,100
.ما زال يرفض شراء أيّ ترياق

207
00:13:53,440 --> 00:13:57,210
.لن يدرك الأمر حتّى يتسبّب بمقتل أحد ما

208
00:13:57,210 --> 00:13:58,530
،أدركتُ هذا متأخّرة

209
00:13:58,530 --> 00:14:01,950
.لكنّي بدأت أقدّر كم كنتَ قويًّا يا سيّد لاوست

210
00:14:02,760 --> 00:14:06,110
،لو لم تقطع أحد رؤوس الهايدرا

211
00:14:06,440 --> 00:14:09,820
.لكان قد قُضي على فرقتنا بالكامل

212
00:14:10,890 --> 00:14:12,740
.لا يمكن الجزم بذلك

213
00:14:13,130 --> 00:14:18,780
فعلاً؟ كنّا نواجه وقتًا عصيبًا
.في مواجهة هايدرا سبق وفقد رأسين

214
00:14:18,780 --> 00:14:21,200
هل يمكنك تخيّل الوضع وهو ليس مصابًا؟

215
00:14:21,200 --> 00:14:22,840
.لا أريد حتّى التّفكير في ذلك

216
00:14:23,910 --> 00:14:26,590
ما الّذي تطلبانه منّي بالضّبط؟

217
00:14:26,960 --> 00:14:29,590
.لم تُشفَ إصابات الهايدرا بعد

218
00:14:30,090 --> 00:14:32,100
!إن كنت معنا، فسنستطيع هزيمته

219
00:14:32,640 --> 00:14:34,510
.ودون فقدان أيّ أحد

220
00:14:35,520 --> 00:14:36,500
...لذلك

221
00:14:37,440 --> 00:14:40,050
تطلبين منّي لانضمام ثانية لأنصال البرق؟

222
00:14:42,800 --> 00:14:43,900
.نعم

223
00:14:44,400 --> 00:14:48,520
يا إلهي. أعتقد أنّ مارغولوس
.لم يخبرك بأيّ شيء بعد

224
00:14:49,850 --> 00:14:51,410
عفوًا، أيمكنني طرح سؤال؟

225
00:14:51,730 --> 00:14:53,910
نعم. ما هو؟

226
00:14:54,400 --> 00:14:57,720
...لماذا تريدين مساعدة تلك الفرقة

227
00:14:57,720 --> 00:15:01,290
أقصد، مساعدة مارغولوس بشدّة هكذا؟

228
00:15:01,680 --> 00:15:04,120
.لا بدّ أنّ هذا الوضع بأكمله فظيع بالنّسبة لك

229
00:15:05,570 --> 00:15:09,170
.أعتقد فعلاً أنّ لديه بعض المشاكل الشّخصيّة

230
00:15:09,170 --> 00:15:12,970
.إنّه متسلّط ومتهوّر وجبان ومخادع

231
00:15:12,970 --> 00:15:16,180
.كما أنّه فظّ ومنغلق التّفكير وانتقاميّ

232
00:15:16,490 --> 00:15:19,370
.إنّه جشِع طمّاع وبخيل للغاية

233
00:15:19,370 --> 00:15:20,810
!حتّى أنّه لا يغسل أسنانه إطلاقًا

234
00:15:21,740 --> 00:15:23,310
.كان ذلك قاسيًا للغاية

235
00:15:25,430 --> 00:15:26,810
...ولكن رغم ذلك

236
00:15:28,780 --> 00:15:30,530
.إنّه رفيق لي

237
00:15:30,530 --> 00:15:31,740
.إنّنا في نفس الفرقة

238
00:15:32,080 --> 00:15:34,100
رفيق؟

239
00:15:38,130 --> 00:15:39,540
نارسينا؟

240
00:15:39,860 --> 00:15:43,540
إذًا ماذا كان لاوست في نظرك؟

241
00:15:44,460 --> 00:15:50,090
لا تخبريني أنّك لم تعرفي كيف
!كان يُعامَل بسوء في فرقتكم

242
00:15:50,560 --> 00:15:52,840
!لم أرغب في القيام بما قمتُ به

243
00:15:54,730 --> 00:15:56,550
.كنتُ خائفة

244
00:16:01,370 --> 00:16:07,220
لو لم أفعل ذلك، كنتُ أخشى
.أن يتمّ طردي أنا أيضًا

245
00:16:10,100 --> 00:16:11,780
.أنا آسفة

246
00:16:11,780 --> 00:16:14,660
،أنا مغامِرة جديدة

247
00:16:15,210 --> 00:16:17,440
.ولم أكن أعرف أيّ فِرق أخرى

248
00:16:18,280 --> 00:16:23,540
لم أكن قادرة على معرفة إن كان ما
.يفعله مارغولوس هو الصّواب أم لا

249
00:16:23,980 --> 00:16:27,830
...لم يكن هنالك أيّ وسيلة لأعرف. ولكن

250
00:16:28,960 --> 00:16:30,880
.صرت أفهم الآن

251
00:16:30,880 --> 00:16:33,300
.كان مارغولوس مخطئًا

252
00:16:33,700 --> 00:16:36,800
.ليس كمغامر فحسب، بل كإنسان أيضًا

253
00:16:37,280 --> 00:16:41,260
ومع ذلك، لا أستطيع إدارة ظهري لأحد رفاقي

254
00:16:42,380 --> 00:16:45,390
.الّذين معي في نفس الفرقة

255
00:16:51,510 --> 00:16:54,700
.أرادت الاعتذار لك طوال هذا الوقت

256
00:16:56,120 --> 00:16:57,550
.أنا آسفة

257
00:16:58,690 --> 00:17:02,100
.أنا آسف يا سيّد لاوست

258
00:17:03,540 --> 00:17:05,970
،أدرك كيف تشعر

259
00:17:05,970 --> 00:17:09,130
لكن هل يمكنك على الأقلّ قبول اعتذارها؟

260
00:17:13,270 --> 00:17:14,260
.أرميا

261
00:17:17,870 --> 00:17:20,010
.لا يوجد سبب يدعوك للبكاء يا أرميا

262
00:17:21,040 --> 00:17:23,540
،أخبرتُ مارغولوس بهذا البارحة

263
00:17:23,540 --> 00:17:25,810
لكنّي لا أحمل أيّ ضغينة ضدّك
.أو ضدّ فرقتكم

264
00:17:27,590 --> 00:17:28,560
...إذًا

265
00:17:29,240 --> 00:17:29,980
.نعم

266
00:17:30,750 --> 00:17:32,320
.أنا أفهم. لا بأس

267
00:17:36,380 --> 00:17:38,030
.شكرًا لك

268
00:17:38,030 --> 00:17:39,980
.شكرًا جزيلاً لك

269
00:17:40,880 --> 00:17:45,080
.ولكن، لا نيّة لديّ للعودة إلى أنصال البرق

270
00:17:45,890 --> 00:17:48,360
.أخبرتُ مارغولوس بهذا سلفًا

271
00:17:50,840 --> 00:17:53,300
...هكذا... إذًا

272
00:17:55,780 --> 00:17:59,470
حسنًا، هل انتهى حديثكم؟

273
00:18:02,470 --> 00:18:03,460
ماذا؟

274
00:18:03,460 --> 00:18:05,690
.تبدين شاحبة يا صغيرتي

275
00:18:05,690 --> 00:18:07,310
هل كنت تأكلين جيّدًا؟

276
00:18:07,310 --> 00:18:12,110
لن أسمح لك بمغادرة مطعمي
.بهذه التّعابير المؤسفة على وجهك

277
00:18:12,560 --> 00:18:13,490
ماذا؟

278
00:18:14,070 --> 00:18:16,440
.لدينا خبز وحساء، ومشروبات أيضًا

279
00:18:16,440 --> 00:18:17,820
!ماذا؟

280
00:18:17,820 --> 00:18:20,410
!هيّا، ابدئي بالأكل

281
00:18:21,640 --> 00:18:26,000
.نعم. هكذا. واصلي الأكل

282
00:18:21,640 --> 00:18:27,370
هل هنالك طريقة لجعل أرمينا
تغادر أنصال البرق معك؟

283
00:18:27,370 --> 00:18:31,060
.لو كان بإمكاني ذلك، ما كنّا لتأتي إليك

284
00:18:31,060 --> 00:18:32,940
.أعتقد أنّك على حقّ

285
00:18:33,810 --> 00:18:35,380
الرّفقة؟

286
00:18:37,890 --> 00:18:40,340
.أرمينا فتاة طيّبة

287
00:18:43,120 --> 00:18:44,810
.واسمح لي بإطلاعك بأمر ما

288
00:18:44,810 --> 00:18:48,940
المعالِجة الجديدة الّتي ضممناها
.غير مفيدة بالمرّة

289
00:18:49,280 --> 00:18:52,100
هل أنت المعالِجة لايرا؟

290
00:18:52,100 --> 00:18:53,690
.ماذا؟ نعم

291
00:18:54,740 --> 00:18:56,860
،قد لا يكون هذا من شأني

292
00:18:54,740 --> 00:18:58,760
.واصلي. هذا طبق ميري الضّخم الخاصّ

293
00:18:56,860 --> 00:19:01,090
لكن يراودني شعور بأنّك ستواجهين
.المشاكل في تلك الفرقة أيضًا

294
00:18:58,760 --> 00:19:03,010
!مستحيل أن أستطيع أكل كلّ هذا

295
00:19:01,090 --> 00:19:01,660
—أعتقد

296
00:19:02,040 --> 00:19:05,000
أنّ عليّ ترك الفرقة وتركها؟

297
00:19:05,000 --> 00:19:07,040
كيف لي أن أفعل شيئًا كهذا؟

298
00:19:07,420 --> 00:19:08,750
.أعتقد أنّك محقّة

299
00:19:10,590 --> 00:19:11,690
إنّه لذيذ، صحيح؟

300
00:19:25,860 --> 00:19:27,180
!زيك؟

301
00:19:27,500 --> 00:19:29,600
.ماذا؟ لا، يا لايرا

302
00:19:29,600 --> 00:19:31,520
."ليس "زي" بل "شي

303
00:19:31,520 --> 00:19:33,630
!اسمه شيك. شيك

304
00:19:33,630 --> 00:19:37,360
فعلاً؟ قلتَ أنّه شيك؟

305
00:19:37,360 --> 00:19:40,400
.جيّد يا رفاق! لنسعدّ للذّهاب

306
00:19:40,400 --> 00:19:42,440
!سنقضي على ذلك الهايدرا اليوم

307
00:19:42,440 --> 00:19:43,610
!حا-حاضرة

308
00:19:48,450 --> 00:19:50,660
ما الّذي تظنّ أنّك تفعله هنا؟

309
00:19:50,660 --> 00:19:52,970
.لا أعرف ما تقصدينه لو سمحت

310
00:19:52,970 --> 00:19:55,720
.لم أحظَ بشرف التّعرّف إليك بعد لو سحمت

311
00:19:55,720 --> 00:19:57,550
لماذا تكرّر "لو سمحت" في كلّ جملة؟

312
00:19:58,140 --> 00:20:01,470
،تنكّرك هذا واضح للغاية
فلماذا لا تتحدّث بشكل طبيعيّ؟

313
00:20:01,470 --> 00:20:04,780
.أراهن أنّك قبلت بمهمّة سيّئة أخرى

314
00:20:06,410 --> 00:20:09,080
ماذا؟ لا تريد الحديث إذًا؟

315
00:20:10,280 --> 00:20:13,270
مهلاً. أليس هذا سيف رونالدو؟

316
00:20:14,240 --> 00:20:15,190
هل سرقته؟

317
00:20:16,010 --> 00:20:20,870
!ورثت هذا من معلّمي! إنّه ليس مسروقًا

318
00:20:23,960 --> 00:20:26,920
ومع ذلك، من يكون هذا المدعوّ
رونالدو لو سمحت؟

319
00:20:26,920 --> 00:20:28,940
.لم أسمع بذلك الاسم من قبل لو سمحت

320
00:20:29,520 --> 00:20:30,560
.لا بأس

321
00:20:30,560 --> 00:20:33,830
.لنترك الأمر هنا إذًا يا سيّد شيك

322
00:20:35,010 --> 00:20:39,090
.نعم. أنا ممتنّ لك لو سمحت

323
00:20:40,010 --> 00:20:41,870
.كفّ عن تكرار "لو سمحت" رجاءً