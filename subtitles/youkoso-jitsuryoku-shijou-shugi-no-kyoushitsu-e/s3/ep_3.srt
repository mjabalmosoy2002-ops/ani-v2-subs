1
00:00:15,160 --> 00:00:19,690
لم أعتبر نفسي صالحة أو فاسدة قطّ

2
00:00:20,960 --> 00:00:22,940
،مذ قدومي لهذه المدرسة

3
00:00:21,390 --> 00:00:22,630
!ذلك مذهلٌ يا هونامي-تشان

4
00:00:22,630 --> 00:00:24,460
...ليس لذاك الحدّ

5
00:00:22,940 --> 00:00:27,780
أقسمت بمواجهة كلّ ما يظهر أمامي مباشرةً

6
00:00:24,460 --> 00:00:26,860
!أنتِ متواضعة دوماً

7
00:00:33,410 --> 00:00:34,970
أخبريني يا ساكاياناغي

8
00:00:35,180 --> 00:00:37,480
ما الأمر يا رئيس ناغومو؟

9
00:00:37,480 --> 00:00:41,900
أهنالك معنى لغرفة مجلس
الطلبة هذه بالأصل؟

10
00:00:42,250 --> 00:00:45,020
ألا يمكننا جعلها حجرة كاراوكي أو ما شابه؟

11
00:00:45,900 --> 00:00:48,990
غرفة مجلس الطلبة هي حيث أكون

12
00:00:48,990 --> 00:00:51,210
ذلك منظورٌ فريد

13
00:00:52,250 --> 00:00:52,960
إذاً؟

14
00:00:53,450 --> 00:00:57,050
،إذا كنتِ لا تسعين لدخول مجلس الطلبة

15
00:00:57,480 --> 00:00:59,000
فما الذي تريدينه؟

16
00:00:59,370 --> 00:01:03,170
الأمر متعلّقٌ بعضوة مجلس الطلبة، إيتشينوسي هونامي-سان

17
00:01:03,170 --> 00:01:04,750
يا رئيس ناغومو

18
00:01:06,500 --> 00:01:10,130
أنا على وشك شنّ هجومٍ عليها

19
00:01:11,630 --> 00:01:16,420
قد يؤدي إلى فصلها

20
00:01:16,420 --> 00:01:18,140
إن حصل ذلك، فأرجو عفوك

21
00:01:18,380 --> 00:01:21,770
ظننتني أخبرتكِ بألّا تصعّدي
سلوكيّاتكِ فوق التنمّر

22
00:01:22,160 --> 00:01:25,900
كنت أفكّر بتدابير أكثر حدّة

23
00:01:25,900 --> 00:01:29,610
كنتُ آمل الاحتفاظ بها لتسليتي

24
00:01:29,610 --> 00:01:32,860
علينا الحساب لما هو غير مُتوقّع دوماً

25
00:01:35,620 --> 00:01:37,460
أنتِ فتاةٌ جريئة

26
00:03:08,820 --> 00:03:09,840
!صباح الخير

27
00:03:09,840 --> 00:03:11,440
صباح الخير

28
00:03:10,070 --> 00:03:11,440
ما كانت الحصّة الأولى؟

29
00:03:10,070 --> 00:03:13,710
ليس السبب امتلاككِ لحبيبٍ جديد إذاً يا كارويزاوا-سان؟

30
00:03:11,440 --> 00:03:13,710
إنّها الرياضيّات

31
00:03:13,710 --> 00:03:17,640
شعرت بأنّ عليّ الاستقلال بنفسي قليلاً

32
00:03:17,640 --> 00:03:21,180
كان من السهل جدّاً الاعتماد على يوسكي-كن

33
00:03:18,850 --> 00:03:20,360
!صباح الخير يا كيوتاكا-كن

34
00:03:20,360 --> 00:03:21,180
صباح الخير

35
00:03:21,180 --> 00:03:21,640
مرحباً

36
00:03:21,840 --> 00:03:24,140
!مُذهل! هذا راشدٌ منكِ

37
00:03:24,920 --> 00:03:27,020
الأجواء حيويّة اليوم

38
00:03:27,250 --> 00:03:30,020
يبدو أنّ كارويزاوا-سان وهيراتا-كن قد انفصلا

39
00:03:30,020 --> 00:03:34,030
وأثار ذلك جلبة الفصل؟

40
00:03:34,030 --> 00:03:37,450
بدوتَ مقرّباً منهما

41
00:03:37,450 --> 00:03:38,910
أكنت تعلم بما حصل؟

42
00:03:38,910 --> 00:03:41,100
بالطبع لا

43
00:03:41,100 --> 00:03:43,190
لا أناقش أمور حياتهما الخاصّة

44
00:03:43,190 --> 00:03:45,180
!يا هيراتا

45
00:03:45,540 --> 00:03:48,690
!سمعت أنّ كارويزاوا هجرتك

46
00:03:48,690 --> 00:03:49,540
نوعاً ما

47
00:03:49,760 --> 00:03:51,920
!لا بأس عليك

48
00:03:53,610 --> 00:03:55,150
توقّف يا ياماوتشي

49
00:03:55,150 --> 00:03:57,800
!لكن تعرّض فتى وسيم للهجر

50
00:03:57,800 --> 00:04:00,110
!يجب أن نواسيه

51
00:04:00,490 --> 00:04:01,550
نعتذر على ذلك

52
00:04:02,000 --> 00:04:03,800
!تحلَّ بلباقة أكثر

53
00:04:03,800 --> 00:04:05,310
!دعاني! تبّاً

54
00:04:05,560 --> 00:04:07,590
كيف لكما البقاء بهذا الهدوء حيال الأمر؟

55
00:04:07,590 --> 00:04:08,950
لسنا هادئين بالتحديد

56
00:04:08,950 --> 00:04:10,900
نشعر ببعض الإحباط وحسب

57
00:04:10,900 --> 00:04:11,810
أنت مُملان حقّاً

58
00:04:12,090 --> 00:04:13,540
صباح الخير

59
00:04:14,530 --> 00:04:17,190
هل ياماوتشي هاروكي-كن هنا؟

60
00:04:19,610 --> 00:04:21,950
أجل، إنّه أنا

61
00:04:21,950 --> 00:04:24,770
هل لي ببعضٍ من وقتك؟

62
00:04:27,160 --> 00:04:28,590
دعاني

63
00:04:29,730 --> 00:04:31,940
!لديّ وقتٌ بالطبع

64
00:04:32,310 --> 00:04:34,710
ما-ما الذي يحصل؟

65
00:04:35,970 --> 00:04:41,080
في الواقع، أردت الكلام معك منذ فترة

66
00:04:41,080 --> 00:04:42,920
!حقّاً؟ جدّياً؟

67
00:04:42,920 --> 00:04:43,970
...إنّها تتجرّأ

68
00:04:43,970 --> 00:04:46,330
المكان صاخبٌ هنا نوعاً ما

69
00:04:46,330 --> 00:04:48,480
سألتقيك هناك

70
00:04:49,400 --> 00:04:50,730
هناك؟

71
00:04:51,190 --> 00:04:53,060
!لا! لا! هذا مستحيل

72
00:04:52,720 --> 00:04:53,910
ماذا يحصل؟

73
00:04:53,060 --> 00:04:54,980
!ما الذي يجري؟

74
00:04:53,910 --> 00:04:54,980
كيف؟

75
00:04:54,980 --> 00:04:56,860
لا لغز هنا

76
00:04:56,860 --> 00:04:58,600
اعذرني يا إيكي

77
00:04:58,600 --> 00:05:00,540
انتظر لحظة يا ياماوتشي-كن

78
00:05:00,540 --> 00:05:01,740
ما الأمر؟

79
00:05:02,160 --> 00:05:03,320
هذا فخّ

80
00:05:03,320 --> 00:05:04,330
ماذا؟

81
00:05:04,330 --> 00:05:07,310
لا تمتلك أيّ سبب لترغب في الكلام معك أبداً

82
00:05:07,310 --> 00:05:08,790
!ما معنى ذلك؟

83
00:05:09,030 --> 00:05:12,010
تحمل وقع إهانة بالطبع

84
00:05:12,510 --> 00:05:14,540
اسمعيني، سأقول هذا لمرّة فحسب

85
00:05:14,540 --> 00:05:18,550
أنا سلاح هذا الفصل القاتل

86
00:05:18,550 --> 00:05:19,530
ماذا؟

87
00:05:22,410 --> 00:05:24,590
!لذا سيمضي الأمر بخير

88
00:05:24,590 --> 00:05:27,720
!لا تقلقي، لن أكشف أيّ معلومات هامة

89
00:05:27,720 --> 00:05:29,900
!ساكاياناغي-تشان

90
00:05:33,800 --> 00:05:37,820
هل ساكاياناغي-سان مُعجبة بـ ياماوتشي-كن حقّاً؟

91
00:05:38,300 --> 00:05:40,910
ما رأيكما يا كيو-بون ويوكيمو؟

92
00:05:40,910 --> 00:05:43,320
لا أعرف الكثير عن تلك الأشياء

93
00:05:43,590 --> 00:05:46,890
لم يسبق وأن توصلا معاً

94
00:05:47,360 --> 00:05:50,330
من التسرّع افتراض علاقة الأمر بالحبّ

95
00:05:50,600 --> 00:05:52,540
أنت متّزن جدّاً يا كيو-بون

96
00:05:52,890 --> 00:05:57,100
،يمكنني أن أتفهم مع هيراتا-كن
لكن ليس مع ياماوتشي-كن بالطبع

97
00:05:57,570 --> 00:05:59,090
،بذكر هيراتا-كن

98
00:05:59,090 --> 00:06:03,290
لطالما ظننت أنّه سينفصل عن
كارويزاوا-سان بنهاية المطاف

99
00:06:03,290 --> 00:06:05,000
ماذا؟ حقّاً؟

100
00:06:05,000 --> 00:06:06,850
لم يوافقا بعضهما

101
00:06:07,100 --> 00:06:11,100
أرى أنّ هيراتا-كن يميل
للصنف الجميل الهادئ أكثر

102
00:06:11,100 --> 00:06:14,440
لطالما اعتبرت كارويزاوا-سان جميلة

103
00:06:15,130 --> 00:06:17,230
ما رأيك يا كيوتاكا-كن؟

104
00:06:17,460 --> 00:06:18,620
لا أعلم

105
00:06:18,990 --> 00:06:22,920
المهمّ الآن أنّ هيراتا-كن أصبح أعزباً

106
00:06:22,920 --> 00:06:25,660
وهنالك فتيات كثيرات مُعجبات به

107
00:06:25,660 --> 00:06:27,490
حقّاً؟

108
00:06:27,490 --> 00:06:29,890
ماذا؟ لم تلاحظي قبلاً؟

109
00:06:29,890 --> 00:06:33,520
لنترك ذلك جانباً ونبدأ بالدراسة
للاختبارات النهائيّة

110
00:06:33,520 --> 00:06:36,030
الرسوب سيؤدي للفصل فوريّاً

111
00:06:36,030 --> 00:06:38,250
ماذا؟ أعلينا فعل ذلك الآن؟

112
00:06:38,250 --> 00:06:39,670
ألا يمكننا تأجيله؟

113
00:06:39,670 --> 00:06:40,750
خذا الأمر بمحمل الجدّ

114
00:06:44,690 --> 00:06:47,510
أعتذر على استدعائك للقائي فجأةً

115
00:06:47,950 --> 00:06:48,800
ليست مشكلة

116
00:06:49,950 --> 00:06:51,010
...يا

117
00:06:51,350 --> 00:06:54,770
نادني بـ مي-تشان، فالجميع ينادوني بذلك

118
00:06:55,260 --> 00:06:57,560
هذا عسير

119
00:06:58,230 --> 00:06:59,300
حسناً

120
00:06:59,700 --> 00:07:01,680
ما الموضوع إذاً؟

121
00:07:02,100 --> 00:07:06,280
هلّا... أخبرتني عن هيراتا-كن؟

122
00:07:06,550 --> 00:07:07,940
لمَ تسأليني أنا؟

123
00:07:08,320 --> 00:07:10,780
لستُ مقرّباً منه بالتحديد

124
00:07:10,780 --> 00:07:15,340
لكنّي سمعت أنّك أكثر من يعتمد عليه هيراتا-كن

125
00:07:16,760 --> 00:07:21,320
هل... توجد فتاة يحبّها الآن
هيراتا-كن بالتحديد؟

126
00:07:22,030 --> 00:07:23,550
لا أظنّ ذلك

127
00:07:24,090 --> 00:07:25,050
حقّاً؟

128
00:07:25,270 --> 00:07:27,710
لا أستطيع الجزم

129
00:07:27,710 --> 00:07:30,320
لكنّ كارويزاوا انفصلت عنه للتوّ

130
00:07:31,070 --> 00:07:32,440
صحيح

131
00:07:33,620 --> 00:07:36,770
أتعتقد أنّي أملك فرصةً معه؟

132
00:07:38,630 --> 00:07:40,040
أجل

133
00:07:41,490 --> 00:07:42,250
...لكن

134
00:07:42,600 --> 00:07:43,860
لكن؟

135
00:07:43,860 --> 00:07:45,850
هيراتا شابٌ صالح

136
00:07:47,050 --> 00:07:52,050
لذا أرجّح أن يتوخّى الحذر
في المواعدة من جديد

137
00:07:53,830 --> 00:07:59,650
لعلّه يشعر بالذنب على فشله
في إسعاد كارويزاوا

138
00:08:00,300 --> 00:08:03,030
...هيراتا-كن لطيفٌ هكذا

139
00:08:03,030 --> 00:08:07,600
إن تسرّعتِ بالتقرّب منه، فقد لا يثمر الأمر في صالحك

140
00:08:08,410 --> 00:08:09,720
صحيح

141
00:08:10,480 --> 00:08:12,820
ببطء وثبات إذاً؟

142
00:08:12,820 --> 00:08:13,780
أجل

143
00:08:13,780 --> 00:08:16,350
النصر من نصيب من يضحك أخيراً

144
00:08:18,650 --> 00:08:23,030
أعتقد أنّي كنت أملك انطباعاً
خاطئاً عنك يا أيانوكوجي-كن

145
00:08:23,030 --> 00:08:24,110
انطباع خاطئ؟

146
00:08:24,110 --> 00:08:26,560
أنت قليل الكلام

147
00:08:26,560 --> 00:08:29,340
فظننتك مخيفاً نوعاً ما

148
00:08:29,340 --> 00:08:33,040
لكنّي أفهم الآن سبب اعتماد هيراتا-كن عليك

149
00:08:33,870 --> 00:08:36,320
يسهل الكلام معك

150
00:08:37,490 --> 00:08:41,330
شعرت أنّك كنت تصغي لكلّ كلامي حقّاً

151
00:08:41,330 --> 00:08:43,630
...ماذا؟ هل هذا

152
00:08:44,330 --> 00:08:45,530
هيوري-تشان؟

153
00:08:45,530 --> 00:08:47,510
موعدٌ من ناحية ما؟

154
00:08:47,510 --> 00:08:49,630
!لـ-لا! بالطبع لا

155
00:08:49,930 --> 00:08:53,640
أيمكنني الانضمام لكما إذاً؟

156
00:08:53,640 --> 00:08:55,490
!بالتأكيد

157
00:08:55,490 --> 00:08:57,140
أذلك مقبول؟

158
00:08:57,140 --> 00:08:58,280
أجل

159
00:08:58,280 --> 00:09:01,080
إذاً، ما الذي كنتما تتكلّمان عنه؟

160
00:09:01,080 --> 00:09:03,800
كنت أفكّر بزيارة الصين في وقتٍ ما

161
00:09:04,220 --> 00:09:09,280
صحيح، لأنّ مي-تشان طالبة
تبادل من الصين، أليس كذلك؟

162
00:09:09,960 --> 00:09:14,160
المعذرة، أأنتما صديقان؟

163
00:09:14,160 --> 00:09:17,330
أجل، نقرأ سويّاً

164
00:09:17,330 --> 00:09:19,910
حسناً، ذلك ليس خاطئاً

165
00:09:19,910 --> 00:09:21,440
فهمت

166
00:09:21,440 --> 00:09:25,230
من الرائع تكوين صداقات
من فصول أخرى

167
00:09:25,230 --> 00:09:27,050
أتّفق معكِ

168
00:09:27,340 --> 00:09:31,840
لن تكون حياة مدرسيّة سليمة
بالخصامات طوال الوقت

169
00:09:38,460 --> 00:09:40,430
أعتذر على تأخّري

170
00:09:40,650 --> 00:09:42,310
ما الموضوع؟

171
00:09:43,270 --> 00:09:45,220
كان من الصعب الشرح برسالة

172
00:09:46,210 --> 00:09:49,640
يبدو أنّي أعطي الكثير من النصائح اليوم

173
00:09:50,640 --> 00:09:54,470
هنالك شائعات غريبة تحوم
حول إيتشينوسي-سان

174
00:10:01,960 --> 00:10:03,370
شائعات؟

175
00:10:03,960 --> 00:10:07,010
ببساطة، إنّه ذمّ

176
00:10:07,910 --> 00:10:09,800
ما الفحوى بالتحديد؟

177
00:10:10,710 --> 00:10:12,220
لخصّته هنا

178
00:10:15,350 --> 00:10:16,680
مُذهل

179
00:10:16,680 --> 00:10:18,490
تحمل طابعاً شرّيراً

180
00:10:18,890 --> 00:10:21,440
لكن لا أساس لها من الصحّة

181
00:10:21,900 --> 00:10:24,560
من الممكن اعتبارها حقداً من أحدهم وحسب

182
00:10:24,940 --> 00:10:29,490
لكنّ هذه الشائعات تنتشر بين طلّاب
السنة الأولى سريعاً بالرغم من ذلك

183
00:10:30,120 --> 00:10:34,200
مما يعني أنّ هناك من ينشط في نشرها؟

184
00:10:34,790 --> 00:10:39,380
كانازاكي-كن والبقيّة من الفصل ب يعتقدون
أنّ الفصل أ هو مصدر الشائعات

185
00:10:40,140 --> 00:10:43,580
ساكاياناغي أو كاتسوراغي إذاً؟

186
00:10:43,850 --> 00:10:47,250
يبدو ذلك واضحاً جدّاً بالنسبة لهما

187
00:10:48,120 --> 00:10:49,840
وهذا ما يقلقني

188
00:10:50,050 --> 00:10:55,090
ماذا لو افترضنا تضمّن الشائعات لبعض الحقيقة؟

189
00:10:55,340 --> 00:10:57,540
،حتّى لو كانت البقيّة ملفّقة

190
00:10:57,540 --> 00:11:00,460
ستحمل الكثير من المصداقية جرّاء ذلك

191
00:11:01,070 --> 00:11:03,490
هل أنكرت إيتشينوسي الشائعات؟

192
00:11:03,490 --> 00:11:06,180
كلّا، لا شيء إلى الآن

193
00:11:06,180 --> 00:11:07,850
علينا الترقّب وحسب إذاً

194
00:11:08,170 --> 00:11:10,860
بالتحديد إن كان المصدر هو الفصل أ

195
00:11:11,820 --> 00:11:14,610
لا نمتلك سبباً للتدخّل

196
00:11:15,250 --> 00:11:17,990
هنالك احتمالٌ بأن تفترض إيتشينوسي
أنّنا أعداء لها أيضاً

197
00:11:32,870 --> 00:11:35,840
ما كان أخي ليفعل؟

198
00:11:43,980 --> 00:11:47,730
أعتذر على استدعائكِ في هذا
الوقت المُتأخّر يا إيتشينوسي-سان

199
00:11:47,730 --> 00:11:49,570
لا بأس

200
00:11:49,570 --> 00:11:52,110
أنتِ تقومين بهذا لأنّكِ تهتمين لي، صحيح؟

201
00:11:52,640 --> 00:11:54,990
شكراً لك أيضاً يا أيانوكوجي-كن

202
00:11:55,210 --> 00:11:58,310
أنا مجرّد مرافق لـ هوريكيتا

203
00:11:59,170 --> 00:12:01,490
هذا بخصوص الشائعات، صحيح؟

204
00:12:01,490 --> 00:12:05,820
أجل، ألديكِ فكرة عمن يقوم بنشرها؟

205
00:12:06,620 --> 00:12:11,180
لا أستطيع التأكيد، لكنّي أعتقد
أنّها قد تكون ساكاياناغي-سان

206
00:12:11,560 --> 00:12:13,030
لمَ تظنّين ذلك؟

207
00:12:15,340 --> 00:12:19,890
لقد... أعلنت الحرب عليّ نوعاً ما

208
00:12:22,390 --> 00:12:24,890
قد لا يبدو ذلك مُقنعاً بمفرده

209
00:12:25,130 --> 00:12:28,980
حدّد الفصل أ أنّ الفصل ب
تهديدٌ جدير بالإزالة

210
00:12:28,980 --> 00:12:32,640
ويقوم بأذيّتكِ عبر شائعات
خالية من الصحّة عنكِ

211
00:12:34,330 --> 00:12:36,230
أشكّ في ذلك

212
00:12:36,670 --> 00:12:41,740
أرى أن تصديق الشائعات من عدمه منوطٌ بكم

213
00:12:42,080 --> 00:12:47,120
أظنّ أن أفضل طريقة لمجابهة
ساكاياناغي-سان هي بالبقاء صامتة

214
00:12:47,350 --> 00:12:52,880
سيقي ذلك الفصل ب والفصل ج
من الضرر الإلحاقيّ

215
00:12:53,570 --> 00:12:54,880
أنتِ قويّة

216
00:12:55,240 --> 00:12:59,880
لا تفكّرين بنفسكِ فحسب، بل بمن حولكِ أيضاً

217
00:12:59,880 --> 00:13:02,890
لا أرى أنّ الأمر مميّز

218
00:13:03,330 --> 00:13:04,150
—لنتعاون معاً إذاً

219
00:13:04,150 --> 00:13:06,850
لا تتورّطا في هذا رجاءً

220
00:13:07,600 --> 00:13:12,150
لا حاجة لأن تستقطبا عدائيّة
ساكاياناغي-سان أيضاً

221
00:13:12,670 --> 00:13:14,650
أأنتِ متأكّدة؟

222
00:13:14,920 --> 00:13:16,400
!بالطبع

223
00:13:18,400 --> 00:13:21,010
شكراً لكما على قلقكما عليّ

224
00:13:21,010 --> 00:13:23,370
لكنّي سأكون بخيرٍ حقّاً

225
00:13:24,610 --> 00:13:26,150
شكراً على استضافتي اليوم

226
00:13:26,570 --> 00:13:27,400
إلى اللقاء

227
00:13:33,210 --> 00:13:36,550
كما قلتُ قبلاً، علينا ألّا نتدخّل

228
00:13:37,560 --> 00:13:39,870
،إن كانت ساكاياناغي هي مصدر الشائعات

229
00:13:39,870 --> 00:13:45,270
فتدخّلنا سيضع فصلنا
في مرمى النيران

230
00:13:45,800 --> 00:13:50,810
لكن إن أطاحت بـ إيتشينوسي-سان، فستستهدفنا تالياً

231
00:13:51,050 --> 00:13:54,040
عندها سيكون الفصل ب قد سقط سلفاً

232
00:13:54,040 --> 00:13:55,670
وذلك من صالحنا

233
00:13:55,670 --> 00:13:58,650
لا تبالي بما يحلّ بـ إيتشينوسي-سان؟

234
00:13:59,770 --> 00:14:01,360
أنت بغاية البرودة

235
00:14:02,180 --> 00:14:05,570
ألم يكن هذا موقفكِ الدائم؟

236
00:14:06,350 --> 00:14:09,380
سيتعيّن علينا مواجهتها وهزيمتها
بنهاية المطاف بغضّ النظر

237
00:14:09,870 --> 00:14:12,420
لدينا عدوّ مُشترك الآن

238
00:14:12,420 --> 00:14:15,580
يمكننا إسقاط الفصل أ ثمّ محاربة الفصل ب

239
00:14:15,580 --> 00:14:17,340
تلك مثاليّة صرفة

240
00:14:18,700 --> 00:14:19,940
سأغادر أيضاً

241
00:14:21,200 --> 00:14:22,130
إلى اللقاء

242
00:14:32,300 --> 00:14:33,850
لا تزالين هنا؟

243
00:14:35,470 --> 00:14:37,720
أيمكننا الكلام قليلاً؟

244
00:14:41,880 --> 00:14:43,600
...لا أعرف كيف أقولها

245
00:14:44,680 --> 00:14:46,620
أنا آسفةٌ حقّاً

246
00:14:46,620 --> 00:14:48,250
لمَ تعتذرين؟

247
00:14:49,080 --> 00:14:54,370
يبدو أنّ تلك الشائعات أقلقتكما عليّ حقّاً

248
00:14:56,000 --> 00:15:00,500
لا أريدكما أن تأبها بها حقّاً

249
00:15:00,930 --> 00:15:04,230
أذلك ما أخبرتِه بأفراد الفصل ب أيضاً؟

250
00:15:04,680 --> 00:15:05,360
أجل

251
00:15:05,680 --> 00:15:11,010
هذا الخطّ الذي سألزمه إلى حين تبدّد الشائعات

252
00:15:12,960 --> 00:15:15,050
...كان ذلك كلّ ما أردت قوله

253
00:15:15,670 --> 00:15:17,520
شكراً لك على الاستماع لي

254
00:15:17,940 --> 00:15:19,050
!إلى اللقاء

255
00:15:37,340 --> 00:15:38,460
من معي؟

256
00:15:40,450 --> 00:15:42,620
تكلّم وإلّا سأقفل

257
00:15:43,710 --> 00:15:45,970
أيانوكوجي كيوتاكا

258
00:15:47,070 --> 00:15:48,090
من أنت؟

259
00:15:52,290 --> 00:15:55,220
يُقدمون على حركتهم إذاً؟

260
00:15:59,980 --> 00:16:01,410
ما هذه؟

261
00:16:01,410 --> 00:16:03,040
من وضعها هنا؟

262
00:16:03,040 --> 00:16:04,730
ما الذي يجري؟

263
00:16:04,450 --> 00:16:05,960
!دعني أنظر

264
00:16:08,490 --> 00:16:10,210
أحدث أمرٌ ما؟

265
00:16:11,000 --> 00:16:12,620
أيانوكوجي؟

266
00:16:13,100 --> 00:16:16,550
وُضِعت رسالة غريبة في كافّة صناديقنا البريديّة

267
00:16:17,290 --> 00:16:18,180
هذه

268
00:16:21,100 --> 00:16:24,250
"إيتشينوسي هونامي مُجرمة"

269
00:16:24,250 --> 00:16:27,080
بلغت الشائعات السخيفة هذا الحدّ

270
00:16:27,710 --> 00:16:31,950
بعد هذا العرض الجريء، سيتعيّن على المدرسة التدخّل

271
00:16:31,950 --> 00:16:36,270
وأنا متأكّد أنّ الفاعل يدرك ذلك

272
00:16:36,480 --> 00:16:40,020
ماذا؟ أتعرف من يكون؟

273
00:16:40,020 --> 00:16:42,020
...لا يمكنني الجزم، لكن

274
00:16:42,990 --> 00:16:45,670
لا داعي لتتحاملي على نفسك

275
00:16:45,670 --> 00:16:47,460
لنتكلّم مع المعلّمين

276
00:16:48,100 --> 00:16:49,730
!لا يمكن أن نغضّ الطرف عن هذا

277
00:16:49,730 --> 00:16:52,570
أجل، أنتِ ضحيّة بريئة يا إيتشينوسي

278
00:16:52,870 --> 00:16:54,160
لا بأس

279
00:16:54,160 --> 00:16:57,270
لا يكفي هذا للنيل منّي

280
00:16:57,270 --> 00:16:58,400
!لا تقولي ذلك

281
00:16:58,400 --> 00:17:01,710
ستستمرّ الشائعات بالانتشار
!ما لم تفعلي شيئاً

282
00:17:01,710 --> 00:17:04,280
أجل، يجب اتّخاذ إجراء حازم

283
00:17:04,280 --> 00:17:07,570
سيبلغ الأمر حدّاً لا رجعة منه
!عاجلاً أم آجلاً

284
00:17:10,830 --> 00:17:13,140
أيمكننا الكلام قليلاً؟

285
00:17:14,770 --> 00:17:16,980
أنتِ من الفصل أ، صحيح؟

286
00:17:16,980 --> 00:17:18,500
كامورو ماسومي

287
00:17:22,030 --> 00:17:23,860
غرفتك باهتة للغاية

288
00:17:23,860 --> 00:17:28,610
هذا أوّل ما تقولينه بعد فرضكِ دخولك؟

289
00:17:28,610 --> 00:17:30,360
فرضت دخولي؟

290
00:17:30,360 --> 00:17:32,110
أعتقد أنّي حصلت على إذنك

291
00:17:32,110 --> 00:17:34,870
ما الذي تريدينه منّي إذاً؟

292
00:17:34,870 --> 00:17:37,670
سيطول الموضوع، لذا فلتجلب لي شراباً

293
00:17:39,570 --> 00:17:41,620
قهوة أم شاي؟

294
00:17:41,620 --> 00:17:42,980
ألديك كاكاو؟

295
00:17:43,370 --> 00:17:44,130
أجل

296
00:17:44,130 --> 00:17:45,550
كاكاو إذاً

297
00:17:47,010 --> 00:17:52,010
قدّمت خيارين، وأتت بخيارٍ ثالث؟

298
00:17:57,490 --> 00:17:59,020
لن تشربي؟

299
00:17:59,230 --> 00:18:01,070
أتتوخّى الحذر منّي؟

300
00:18:01,530 --> 00:18:04,020
لمَ لا أفعل؟

301
00:18:04,260 --> 00:18:08,210
،فتاة لم يسبق وأن كلّمتها
،ناهيك عن كونها من الفصل أ

302
00:18:08,210 --> 00:18:10,030
دخلت غرفتي

303
00:18:10,480 --> 00:18:13,400
لا تشبه زميلك ياماوتشي أبداً

304
00:18:15,320 --> 00:18:18,540
ما رأيك بتلك الرسالة عن إيتشينوسي؟

305
00:18:18,540 --> 00:18:20,290
لم أهتمّ

306
00:18:20,290 --> 00:18:23,270
حتّى لو لم تهتمّ، لا بدّ أنّك فكّرت بالأمر، صحيح؟

307
00:18:23,870 --> 00:18:26,690
ما إن كانت إيتشينوسي صالحة أم فاسدة

308
00:18:27,520 --> 00:18:30,800
كونك مُجرماً لا يقتضي فسادك بالتحديد

309
00:18:30,800 --> 00:18:34,090
تعرف ساكاياناغي سرّاً عن إيتشينوسي

310
00:18:34,600 --> 00:18:36,100
حقّاً؟

311
00:18:36,100 --> 00:18:41,440
ليكن في علمك، لا تعرف ساكاياناغي
أنّي أتيت هنا للكلام معك في الموضوع

312
00:18:42,390 --> 00:18:44,310
لا بدّ أنّها ستغضب إن عرفت

313
00:18:44,890 --> 00:18:47,070
أخشى أنّي لا أصدّقكِ

314
00:18:50,320 --> 00:18:54,820
لذا سأخبرك بما تخفيه إيتشينوسي

315
00:18:57,530 --> 00:19:04,710
لكن قبل ذلك، يجب أن تخبرني
لمَ تجعلني ساكاياناغي أكدح هكذا

316
00:19:07,550 --> 00:19:09,550
حدث الأمر بعد مراسم الدخول

317
00:19:18,840 --> 00:19:20,100
انتظري قليلاً

318
00:19:23,270 --> 00:19:27,350
سرقتِ... من المتجر، صحيح؟

319
00:19:32,080 --> 00:19:33,610
وماذا إن فعلت؟

320
00:19:33,910 --> 00:19:36,490
كانت تقنيتكِ مُذهلة

321
00:19:36,490 --> 00:19:38,170
سأعيده

322
00:19:38,170 --> 00:19:39,240
هاكِ

323
00:19:39,960 --> 00:19:42,490
تشربين كحولاً؟

324
00:19:42,730 --> 00:19:45,500
لا أفعل، لست مهتمة بالكحول

325
00:19:45,500 --> 00:19:51,870
أي تقومين بذلك للإثارة فقط؟

326
00:19:51,870 --> 00:19:54,630
لمَ لا تبلّغي عنّي للمدرسة وحسب؟

327
00:19:56,560 --> 00:19:59,020
سأتخلّص من هذا بنفسي

328
00:19:59,910 --> 00:20:02,900
!إذا لم تتصلي بهم، سأفعل أنا

329
00:20:04,690 --> 00:20:08,060
أنتِ تروقينني يا كامورو ماسومي-سان

330
00:20:09,000 --> 00:20:12,520
أعتقد أنّي سأجعلكِ صديقتي الأولى

331
00:20:16,250 --> 00:20:19,030
كنت سارقة متاجر دوريّة

332
00:20:19,330 --> 00:20:20,280
كنتِ"؟"

333
00:20:20,590 --> 00:20:22,630
لا أمتلك وقتاً لذلك الآن

334
00:20:22,630 --> 00:20:25,290
تضغطني ساكاياناغي بالعمل

335
00:20:25,500 --> 00:20:27,540
لذا أتيتِ لي؟

336
00:20:27,540 --> 00:20:28,790
أجل

337
00:20:29,570 --> 00:20:32,600
سرّ إيتشينوسي هو نفس سرّي

338
00:20:32,600 --> 00:20:35,690
تمتلك سجّل سرقات من متاجر إذاً؟

339
00:20:35,690 --> 00:20:37,880
بخلاف ما يبدو من شعبيّتها

340
00:20:39,040 --> 00:20:41,300
لذا يجب أن توقف ساكاياناغي

341
00:20:41,300 --> 00:20:43,270
تستطيع فعل ذلك، صحيح؟

342
00:20:43,770 --> 00:20:45,560
لمَ أنا؟

343
00:20:45,970 --> 00:20:49,290
لا أمتلك أحداً أستطيع ائتمانه

344
00:20:50,060 --> 00:20:54,610
وأنت أكثر من تحذر ساكاياناغي منه

345
00:20:54,610 --> 00:20:56,700
يشرّفني ذلك

346
00:20:56,700 --> 00:20:58,820
لكنّي لا أستطيع الوثوق بكِ

347
00:20:58,820 --> 00:20:59,820
لماذا؟

348
00:20:59,820 --> 00:21:06,330
يمكنني تصوّر تضحية ساكاياناغي بكِ لإقحامي في القتال

349
00:21:07,800 --> 00:21:11,080
سأثبت الأمر إذاً

350
00:21:18,420 --> 00:21:19,240
أترى؟

351
00:21:24,110 --> 00:21:26,220
يبدو أصيلاً بالفعل

352
00:21:26,220 --> 00:21:27,900
بالطبع

353
00:21:27,900 --> 00:21:31,880
وليس شيئاً بإمكان طالبة مثلي شراؤه

354
00:21:33,480 --> 00:21:36,730
ربما عليّ الوثوق بكِ

355
00:21:36,730 --> 00:21:38,520
يسرّني ذلك

356
00:21:38,910 --> 00:21:40,240
بالتوفيق لك

357
00:21:40,240 --> 00:21:42,530
خذي هذا معكِ

358
00:21:43,250 --> 00:21:44,540
!مهلاً

359
00:21:53,050 --> 00:21:54,380
ما الأمر؟

360
00:21:54,830 --> 00:21:56,150
أيانوكوجي

361
00:21:57,000 --> 00:21:59,180
أردت إخبارك بشيء

362
00:22:00,620 --> 00:22:06,180
تواصلت كوشيدا كيكيو مع ناغومو ميابي

363
00:22:08,680 --> 00:22:10,020
فهمت