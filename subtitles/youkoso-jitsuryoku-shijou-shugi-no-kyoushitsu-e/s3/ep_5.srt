1
00:00:13,280 --> 00:00:16,370
كفّ عن نشر هذه الشائعات
!المقيتة يا هاشيموتو

2
00:00:16,370 --> 00:00:20,790
!نعرف أنّك من ينشر هذه الأكاذيب بأوامر ساكاياناغي

3
00:00:20,790 --> 00:00:22,880
توقّفي رجاءً يا إيبوكي-سان

4
00:00:23,090 --> 00:00:24,880
!لا تتدخّلي

5
00:00:24,880 --> 00:00:27,670
لن نغضّ الطرف عن هذا

6
00:00:28,130 --> 00:00:30,130
تريدون فعلها حقّاً؟

7
00:00:30,130 --> 00:00:31,320
!لا تفعلا

8
00:00:31,320 --> 00:00:32,530
!توقّفا

9
00:00:32,530 --> 00:00:34,510
!تراجعا! لا علاقة لكما

10
00:00:34,510 --> 00:00:37,830
نُشِرت شائعات عن أيانوكوجي أيضاً

11
00:00:37,830 --> 00:00:39,110
لنا علاقة

12
00:00:39,110 --> 00:00:42,400
لكنّ إعجابه بـ كارويزاوا
أمرٌ وديع

13
00:00:43,220 --> 00:00:45,650
!لـ-ليس كذلك

14
00:00:45,970 --> 00:00:48,500
،لا يروقني قول كلامي هذا

15
00:00:48,900 --> 00:00:52,240
لكنّي أشتبه بك أيضاً يا هاشيموتو

16
00:00:52,240 --> 00:00:53,660
لا أستغرب

17
00:00:53,660 --> 00:00:57,540
أنا الشاهد الوحيد على لقائك السرّي بـ كارويزاوا

18
00:00:57,540 --> 00:00:59,040
!لقاء سرّي؟

19
00:00:59,040 --> 00:01:01,290
لم يكن شيئاً مهمّاً

20
00:01:02,040 --> 00:01:04,540
!لا تتجاهلنا أيّها الوغد

21
00:01:04,540 --> 00:01:06,800
!إيشيزاكي-كن، لا تتشاجر رجاءً

22
00:01:06,800 --> 00:01:08,380
...لكن

23
00:01:08,380 --> 00:01:10,390
،حتّى لو دفعته على الاعتراف

24
00:01:10,390 --> 00:01:13,050
لن تعترف ساكاياناغي-سان أبداً

25
00:01:13,050 --> 00:01:14,930
أيُفترض بنّا ألّا نقاوم إذاً؟

26
00:01:16,240 --> 00:01:19,410
هلّا سامحتهم على ما بدر اليوم؟

27
00:01:19,810 --> 00:01:23,280
لا شيء لأسامحه، فلم يتضرّر أحد

28
00:01:24,030 --> 00:01:28,320
لكنّي أتمنّى أن تتوقّفوا عن
الاشتباه بنا بلا مسوّغ

29
00:01:28,790 --> 00:01:31,490
لا حاجة لنا بادّعاءات عارية من الصحّة في حياتنا

30
00:01:32,420 --> 00:01:33,560
مفهوم

31
00:01:34,710 --> 00:01:35,950
لنذهب

32
00:01:49,090 --> 00:01:53,340
أتت إيتشينوسي-سان للمدرسة أخيراً إذاً؟

33
00:01:53,570 --> 00:01:56,600
قبل فوات الأوان للاختبارات النهائيّة

34
00:01:56,600 --> 00:01:58,580
ما حركتنا التالية؟

35
00:02:04,290 --> 00:02:05,350
حسناً

36
00:02:05,930 --> 00:02:07,350
كان أداؤكم ممتازاً جميعاً

37
00:02:09,180 --> 00:02:12,720
!أحرزت 90 نقطة يا كيو-بون؟ ذلك مُذهل

38
00:02:12,720 --> 00:02:15,990
علاماتكم جميعاً عالية أيضاً

39
00:02:17,260 --> 00:02:18,490
!أنتم

40
00:02:18,490 --> 00:02:21,960
!اقتحم أشخاصٌ من الفصل أ الفصل ب

41
00:02:28,460 --> 00:02:31,010
ما الذي تريدينه يا ساكاياناغي-سان؟

42
00:02:32,280 --> 00:02:37,760
لطالما كان اعتباري عالياً لتعاون الفصل ب

43
00:02:37,760 --> 00:02:39,420
ما الذي ترمين إليه؟

44
00:02:40,760 --> 00:02:43,950
أتيتُ لإنقاذكم

45
00:02:45,320 --> 00:02:47,270
لمَ لا تدخلي صلب الموضوع وحسب؟

46
00:02:47,650 --> 00:02:51,420
ائتمنتم إيتشينوسي-سان جميعاً
على نقاطكم الخاصّة

47
00:02:51,420 --> 00:02:55,580
وتجاوزتم الكثير من المصاعب بدعم تلك المدّخرات

48
00:02:55,910 --> 00:02:57,660
موضوعي متعلّق بذلك

49
00:02:57,660 --> 00:02:59,780
وما المشكلة؟

50
00:02:59,780 --> 00:03:03,270
لا مشكلة به بالتحديد

51
00:03:05,460 --> 00:03:11,200
لكن ماذا لو تبيّن أنّ هذا الادّعاء صحيح؟

52
00:03:11,800 --> 00:03:15,420
ماذا لو كانت إيتشينوسي-سان مجرمة بحقّ؟

53
00:03:15,630 --> 00:03:17,030
ذلك هراء

54
00:03:17,030 --> 00:03:20,500
كبقيّة الشائعات التي تنشرونها

55
00:03:20,500 --> 00:03:23,560
لا أملك فكرة عمَّ تتكلّم عنه بالتأكيد

56
00:03:23,930 --> 00:03:26,510
ما أحمله هو دليلٌ دامغ

57
00:03:26,510 --> 00:03:30,690
على صدق الشائعات عن إيتشينوسي-سان

58
00:03:30,690 --> 00:03:32,440
لديها دليل؟

59
00:03:32,440 --> 00:03:33,940
ما معنى هذا؟

60
00:03:34,770 --> 00:03:36,700
!اهدؤوا جميعاً

61
00:03:36,940 --> 00:03:40,820
...ائتمان شخص كهذا على نقاط الفصل بأسره

62
00:03:40,820 --> 00:03:43,190
قد يكون تدميريّاً، ألا ترون ذلك؟

63
00:03:44,270 --> 00:03:47,170
أبكلامي خطأ

64
00:03:47,810 --> 00:03:49,680
يا إيتشينوسي هونامي-سان؟

65
00:03:53,220 --> 00:03:55,680
هلّا أفسحت لي؟

66
00:03:55,680 --> 00:03:56,820
إيتشينوسي؟

67
00:03:57,230 --> 00:03:58,720
لا بأس

68
00:04:07,480 --> 00:04:09,540
أنا أعتذر يا رفاق

69
00:04:12,980 --> 00:04:15,150
الزموا الهدوء جميعاً

70
00:04:15,680 --> 00:04:18,490
إنّها تحاول التأسّف

71
00:04:21,590 --> 00:04:22,490
...رفاق

72
00:04:23,460 --> 00:04:27,310
هلّا استمعتم لما أودّ قوله؟

73
00:04:28,770 --> 00:04:30,710
ساكاياناغي-سان مُحقّة

74
00:04:31,390 --> 00:04:33,500
أقدمت على جريمة

75
00:04:34,880 --> 00:04:37,010
جريمة لا تُغتفر

76
00:04:46,110 --> 00:04:51,450
كنت أعيش مع أمّي وأختي الصغيرة

77
00:04:52,680 --> 00:04:54,900
،لم تكن حياةً مُترفة

78
00:04:54,900 --> 00:04:56,290
لكنّنا استمتعنا

79
00:04:59,570 --> 00:05:05,910
كدحت أمّنا في العمل لتغطية احتياجاتنا

80
00:05:13,820 --> 00:05:18,080
لذا بذلت كلّ ما لديّ للحصول
على منحة دراسيّة

81
00:05:18,080 --> 00:05:21,280
للالتحاق بالمدرسة الثانويّة
رغم أنّي لم أمتلك المال

82
00:05:30,090 --> 00:05:30,880
...لكن

83
00:05:33,030 --> 00:05:35,320
في صيف عامي الثالث
...في المدرسة الإعداديّة

84
00:05:42,450 --> 00:05:43,780
...أمّي

85
00:05:44,850 --> 00:05:46,450
سقطت

86
00:05:49,040 --> 00:05:52,200
تبيّن أنّها عملت في ورديّات
أكثر من طاقتها بهدف

87
00:05:52,540 --> 00:05:54,540
شراء هديّة عيد ميلاد لأختي الصغيرة

88
00:05:57,570 --> 00:06:00,600
...كانت أختي تحبّ إحدى الفنّانات الصغيرات

89
00:06:01,800 --> 00:06:04,740
وكانت تضع مشبك شعر

90
00:06:06,710 --> 00:06:12,030
لم تذكر أختي شيئاً عن رغبتها
بأزياء أنيقة أو ألعاب قطّ

91
00:06:13,210 --> 00:06:17,750
كان أوّل شيء باحت برغبتها به

92
00:06:23,960 --> 00:06:28,550
اعتذرت أمّي مراراً

93
00:06:28,880 --> 00:06:32,740
عن عجزها في إعطائها هديّة عيد ميلاد

94
00:06:34,840 --> 00:06:36,500
لذا قرّرت

95
00:06:36,940 --> 00:06:42,450
أنّي سأشتري مشبك الشعر ذاك لأختي قطعاً

96
00:06:47,080 --> 00:06:48,850
،كنت مُتوقّعة

97
00:06:48,850 --> 00:06:54,250
لكن لم يقبل أحدٌ توظيف طالبة في
المدرسة الإعداديّة بدوام جزئيّ بالطبع

98
00:06:56,820 --> 00:07:00,980
لكنّي بذلت كلّ ما بوسعي لجني المال

99
00:07:02,090 --> 00:07:03,010
...مع ذلك

100
00:07:17,330 --> 00:07:19,690
!مُذهل! إنّه ظريفٌ جدّاً

101
00:07:19,690 --> 00:07:21,710
!إنّه الذي ارتدته في المجلّة

102
00:07:21,130 --> 00:07:22,500
!أجل! أردتُ اقتنائه

103
00:07:22,500 --> 00:07:25,090
!أنا أحبّه

104
00:07:25,090 --> 00:07:26,500
!اسمعي، لنرجع غداً

105
00:07:26,500 --> 00:07:29,610
،أجل، لا نستطيع دفع ثمنه اليوم
...لكن إن رجعنا غداً

106
00:07:38,900 --> 00:07:43,190
أردتُ مشبك الشعر ذاك بشدّة

107
00:07:57,770 --> 00:07:59,910
لم يرني أحد

108
00:08:01,780 --> 00:08:07,560
كذبت وقلت أنّ صديقاً أعارني المال

109
00:08:10,930 --> 00:08:13,850
كانت أختي بغاية السعادة

110
00:08:14,660 --> 00:08:18,260
قالت لي "شكراً لكِ يا أختي الكبيرة" مراراً وتكراراً

111
00:08:20,160 --> 00:08:26,370
منظر ابتسامة أختي أزاح عنّي
حسّ الذنب مؤقتاً

112
00:08:28,790 --> 00:08:30,840
،عندما خرجت أمّي من المستشفى

113
00:08:31,670 --> 00:08:33,510
ذهبنا لرؤيتها

114
00:08:35,000 --> 00:08:40,020
أرت أختي مشبك الشعر لأمّي بافتخار

115
00:08:41,140 --> 00:08:44,850
لم أستطع دفع نفسي على إخبارها
...بالتكتّم على الأمر

116
00:08:45,600 --> 00:08:47,800
فقد كانت بغاية السعادة

117
00:08:54,140 --> 00:08:58,770
أعتقد أنّ أمّي عرفت سرقتي له

118
00:08:59,250 --> 00:09:01,240
لم أستطع إخفاء الأمر

119
00:09:04,110 --> 00:09:08,610
أخذتني للمتجر سريعاً للاعتذار

120
00:09:09,040 --> 00:09:13,880
بدأت أستوعب أخيراً ما أقدمتُ عليه

121
00:09:16,280 --> 00:09:20,980
لحظة عودتنا للبيت، أجهشت أمّي بالبكاء
كما لو أنّ حاجزاً سقط داخلها

122
00:09:22,130 --> 00:09:27,060
لم يسبق وأن رأيت أمّي بذاك الشكل

123
00:09:29,760 --> 00:09:35,280
في النهاية، لم يسلّمني أصحاب المتجر للشرطة

124
00:09:36,890 --> 00:09:39,170
انسحبتُ كلّياً

125
00:09:39,570 --> 00:09:42,870
ظللت 6 أشهر أنقد على نفسي

126
00:09:43,890 --> 00:09:46,350
لم أغادر الغرفة

127
00:10:08,710 --> 00:10:10,010
...لكن

128
00:10:10,010 --> 00:10:12,480
...أخبرتني أمّي

129
00:10:15,480 --> 00:10:18,550
"لا تفقدي الأمل بالمدرسة الثانويّة يا هونامي"

130
00:10:20,160 --> 00:10:23,910
"أريدكِ أن تجدي سعادتكِ"

131
00:10:37,330 --> 00:10:42,230
لذا عندما أتيت هنا، قرّرت فتح صفحة جديدة

132
00:10:43,220 --> 00:10:48,100
لاسترجاع ثقة أمّي وأختي بي أيضاً

133
00:10:52,760 --> 00:10:54,050
...يا رفاق

134
00:10:54,660 --> 00:10:56,720
أعتذر على عدم إخباركم قبلاً

135
00:10:57,990 --> 00:11:01,820
أعتذر على كوني قائدة سيّئة

136
00:11:02,570 --> 00:11:04,600
!لستِ كذلك يا إيتشينوسي

137
00:11:05,810 --> 00:11:08,140
نتفهّم ما مررتِ به

138
00:11:08,140 --> 00:11:13,610
بحتِ لنا بسرّكِ الآن لأنّكِ
تثقين بنا، أليس كذلك؟

139
00:11:15,410 --> 00:11:16,610
...رفاق

140
00:11:18,060 --> 00:11:20,580
هل تحاولين إضحاكي؟

141
00:11:21,030 --> 00:11:22,570
...ساكاياناغي-سان

142
00:11:23,030 --> 00:11:26,460
مهما كانت الظروف، تبقى السرقة
من المتاجر سرقة

143
00:11:27,060 --> 00:11:29,480
لا مجال للتعاطف هنا

144
00:11:30,560 --> 00:11:32,840
معكِ حقّ

145
00:11:33,480 --> 00:11:37,470
لا تزول آثار الخطايا التي
أقدمت عليها كلّياً

146
00:11:37,470 --> 00:11:38,740
...إيتشينوسي

147
00:11:39,220 --> 00:11:42,680
من الصحيح أنّي سرقت

148
00:11:43,780 --> 00:11:45,910
لا أنوي الهرب من ذلك

149
00:11:46,680 --> 00:11:50,830
فأنا... اقترفتُ أمراً خاطئاً

150
00:11:51,360 --> 00:11:54,480
يا لانعدام الحياء

151
00:11:55,120 --> 00:11:55,970
صحيح

152
00:11:56,550 --> 00:12:00,380
ربما كان منبع عملي الجاد فضيلة زائفة

153
00:12:01,490 --> 00:12:06,400
لكن... أريد التخرّج معكم جميعاً
!في هذا الفصل

154
00:12:07,010 --> 00:12:09,500
!أريد المشي رفقتكم

155
00:12:10,170 --> 00:12:13,030
...رغم عيوبي، يا رفاق

156
00:12:13,400 --> 00:12:16,010
هلّا أتيتم إلى النهاية معي؟

157
00:12:16,010 --> 00:12:17,260
بالطبع

158
00:12:17,540 --> 00:12:19,510
سنرافقها، أليس كذلك؟

159
00:12:19,510 --> 00:12:20,570
!بالتأكيد

160
00:12:20,570 --> 00:12:20,910
!أجل

161
00:12:20,910 --> 00:12:22,640
!لا ريب

162
00:12:26,140 --> 00:12:27,980
مُذهل

163
00:12:28,600 --> 00:12:31,410
ساكاياناغي، ماذا نفعل الآن؟

164
00:12:34,660 --> 00:12:36,150
أتسمعيني؟

165
00:12:36,150 --> 00:12:37,970
فهمت

166
00:12:37,970 --> 00:12:40,160
يا للختام البهيج

167
00:12:40,970 --> 00:12:44,830
لكن تبقى الحقيقة أنّكِ ارتكبتِ جريمة

168
00:12:45,240 --> 00:12:47,740
ستواصل هذه القصّة التوسّع

169
00:12:48,320 --> 00:12:49,920
أنا مُتحضّرة لذلك

170
00:12:49,920 --> 00:12:51,550
حقّاً؟

171
00:12:51,940 --> 00:12:54,010
—في تلك الحالة، سأفعل

172
00:12:53,220 --> 00:12:56,290
حسناً، يكفي هذا

173
00:12:56,290 --> 00:12:59,470
رئيس مجلس الطلبة؟ والمعلّمون؟

174
00:12:59,860 --> 00:13:04,430
نشر الشائعات الشرّيرة ممنوعٌ الآن

175
00:13:04,690 --> 00:13:10,440
هل بلّغت إيتشينوسي-سان
عن المشكلة التي تواجهها؟

176
00:13:10,440 --> 00:13:14,970
لم يعد هذا يقتصر على إيتشينوسي

177
00:13:14,970 --> 00:13:17,080
أصبحنا محيطين علماً

178
00:13:17,080 --> 00:13:20,820
بالتعليقات الجارحة المُتناقلة
بين طلّاب السنة الأولى

179
00:13:21,490 --> 00:13:25,600
نشر المزيد من الشائعات سيخرق
مبادئ المدرسة الأخلاقيّة

180
00:13:26,580 --> 00:13:32,080
من يتمّ اكتشاف نشره لشائعات شرّيرة
سيتلقّى العقاب اللازم

181
00:13:33,990 --> 00:13:35,230
فهمت

182
00:13:35,570 --> 00:13:39,640
إذا تدخّلت المدرسة، فشأني قد انتهى هنا

183
00:13:40,390 --> 00:13:42,090
سأنصرف

184
00:13:54,280 --> 00:13:57,760
كنتَ مذهلاً بحقّ يا أيانوكوجي-كن

185
00:13:58,660 --> 00:14:00,630
هلّا أخبرتني بشيء؟

186
00:14:01,560 --> 00:14:07,240
هل اعترفت لك إيتشينوسي-سان
بماضيها قبل اليوم؟

187
00:14:07,900 --> 00:14:08,680
أجل

188
00:14:12,240 --> 00:14:15,920
زرت إيتشينوسي في غرفتها بالأمس

189
00:14:19,080 --> 00:14:23,370
أخبرني... أيمكنني طرح سؤالٍ غريب عليك؟

190
00:14:24,310 --> 00:14:25,040
أجل

191
00:14:25,510 --> 00:14:29,950
لمَ لا تقول شيئاً لي؟

192
00:14:32,280 --> 00:14:34,680
سبب قدومي هنا يوميّاً

193
00:14:35,100 --> 00:14:38,140
...هو لأنّي أنتظر اعترافكِ

194
00:14:39,650 --> 00:14:40,660
ربما

195
00:14:42,190 --> 00:14:44,920
تنتظر... اعترافي؟

196
00:14:46,040 --> 00:14:50,610
أعرف الجريمة التي أذنبتِ بها

197
00:14:52,580 --> 00:14:53,620
إيتشينوسي

198
00:14:54,580 --> 00:14:57,570
ما أقدمتِ عليه لن يزول بهربكِ منه

199
00:14:57,570 --> 00:14:58,760
!توقّف

200
00:15:00,630 --> 00:15:03,900
...أنا... أنا

201
00:15:04,250 --> 00:15:06,620
أعرف أنّي ارتكبت أمراً سيّئاً

202
00:15:07,450 --> 00:15:11,250
!ظننت أنّ لا خيار آخر بيدي حينذاك

203
00:15:13,220 --> 00:15:16,600
!أردت جعل أختي تبتسم

204
00:15:18,360 --> 00:15:19,780
لم أحسب لشيء

205
00:15:20,270 --> 00:15:21,480
كنت حمقاء

206
00:15:21,810 --> 00:15:23,810
!كان الهرب هو كلّ ما أستطيع فعله

207
00:15:24,210 --> 00:15:25,620
...والآن

208
00:15:29,750 --> 00:15:34,160
،والآن، كما حصل آنذاك

209
00:15:34,510 --> 00:15:36,270
انسحبت كليّاً

210
00:15:38,040 --> 00:15:40,370
ما كان عليّ أن أفعل؟

211
00:15:41,590 --> 00:15:43,250
ماذا أفعل الآن؟

212
00:15:43,250 --> 00:15:44,590
أخبرني

213
00:15:45,410 --> 00:15:48,320
!أخبرني يا أيانوكوجي-كن

214
00:15:49,480 --> 00:15:53,950
كيف أغادر هذه الغرفة؟

215
00:15:53,950 --> 00:15:55,600
لا أعلم

216
00:15:56,350 --> 00:15:58,640
أعتقد أنّه سيتعيّن عليكِ
مواجهة الأمر بنفسك

217
00:15:59,490 --> 00:16:00,550
أأنا مُخطئ؟

218
00:16:07,890 --> 00:16:10,180
تحطّم قلب إيتشينوسي

219
00:16:12,330 --> 00:16:13,230
...أنا

220
00:16:20,070 --> 00:16:21,160
أنا

221
00:16:23,700 --> 00:16:25,170
من حطّمه

222
00:16:27,090 --> 00:16:31,560
ثمّ التئم الجزء المُحطّم ورجع
أقوى من ذي قبل

223
00:16:31,560 --> 00:16:33,810
مما سمح لها بصدّ اتّهامكِ

224
00:16:34,650 --> 00:16:36,040
ذلك ما حصل

225
00:16:36,460 --> 00:16:38,560
مؤثرٌ بحقّ

226
00:16:39,050 --> 00:16:42,350
استغللتِ كامورو لإقحامي في هذا، أليس كذلك؟

227
00:16:42,350 --> 00:16:44,820
ما الذي يجعلك على يقين؟

228
00:16:45,380 --> 00:16:51,190
علبة الجعّة التي أعطتني إيّاها هي
التي سرقتها في مقتبل العام الدراسيّ

229
00:16:51,700 --> 00:16:54,640
تاريخ الصلاحيّة على علبتها

230
00:16:54,640 --> 00:16:59,970
أقدم بعام تقريباً من المشروبات
المعروضة للبيع حاليّاً

231
00:17:01,360 --> 00:17:06,610
مما يعني أنّ تلك الجعّة
أتت منكِ يا ساكاياناغي

232
00:17:08,840 --> 00:17:13,000
نويتُ الانتظار ومشاهدة ما يحصل
فحسب في البداية

233
00:17:13,530 --> 00:17:17,110
لكنّكِ استغللتِ كامورو لإقحامي

234
00:17:17,110 --> 00:17:18,220
لمَ؟

235
00:17:18,450 --> 00:17:22,400
فعلت كلّ ذلك لاستقطاب اهتمامك بي

236
00:17:22,770 --> 00:17:27,720
أي أنّكِ لا تهتمين بـ إيتشينوسي أبداً؟

237
00:17:28,440 --> 00:17:29,360
صحيح

238
00:17:31,080 --> 00:17:33,080
لمَ لا تنازلني؟

239
00:17:33,700 --> 00:17:35,740
لا أرى منفعة لي

240
00:17:35,740 --> 00:17:41,000
ماذا لو وضعت طردي من المدرسة
على المحكّ إذاً؟

241
00:17:41,990 --> 00:17:47,500
حتّى لو خسرت بالطبع، فلن يتعيّن عليك ترك المدرسة

242
00:17:48,600 --> 00:17:49,760
...لكن

243
00:17:50,000 --> 00:17:55,250
إن خسرت، سأكشف للجميع أنّك
العقل المدبّر للفصل ج

244
00:17:55,840 --> 00:17:58,010
ما الذي سنتراهن عليه؟

245
00:17:58,290 --> 00:18:00,610
ما رأيك بالاختبار المُقبل؟

246
00:18:01,560 --> 00:18:06,650
يبدو أنّ حياتي المدرسيّة
ستصبح حماسيّة أخيراً

247
00:18:14,860 --> 00:18:17,410
شكراً على تلك الشوكولاته

248
00:18:18,640 --> 00:18:23,670
لم أستدعيك إلى هنا
للكلام عن ذلك

249
00:18:24,360 --> 00:18:30,460
كانت المعلومة التي أعطتني إيّاها
كوشيدا قبل الفالينتاين دقيقة

250
00:18:31,860 --> 00:18:37,420
نائب الرئيس كيرياما، أريد منك نشر
هذه المعلومة على لوحة الرسائل

251
00:18:37,770 --> 00:18:39,930
لإنقاذ إيتشينوسي

252
00:18:40,230 --> 00:18:44,310
إن انتشر هذا، فستنهار الثقة بين التلامذة

253
00:18:44,310 --> 00:18:49,300
أكثر من سيتضرّر من ذلك
سيكون الرئيس ناغومو

254
00:18:50,020 --> 00:18:52,690
ألن يكون ذلك لصالحك؟

255
00:18:52,980 --> 00:18:55,680
وسأكون من يُعاقب

256
00:18:56,080 --> 00:18:58,490
،إن رفضت فعل هذا

257
00:18:59,410 --> 00:19:02,770
فسيتعيّن عليّ إخبار الرئيس السابق

258
00:19:03,130 --> 00:19:06,390
أنّك انزحت إلى ناغومو بالفعل

259
00:19:07,200 --> 00:19:08,120
لا بأس

260
00:19:08,640 --> 00:19:12,050
لكنّك ستدين لي بمعروفٍ كبير

261
00:19:13,970 --> 00:19:15,450
أشكركِ

262
00:19:15,450 --> 00:19:18,130
تسرّني الخدمة

263
00:19:18,130 --> 00:19:20,180
إذاً، تعرف ما تفعله، صحيح؟

264
00:19:20,180 --> 00:19:20,980
أجل

265
00:19:22,170 --> 00:19:24,480
أرسلت لك أجر المعلومة للتوّ

266
00:19:24,920 --> 00:19:26,340
فلتتحقّقي من استلامكِ له

267
00:19:28,900 --> 00:19:30,480
!مثاليّ

268
00:19:30,480 --> 00:19:34,990
من الآن فصاعداً، سأعطيكِ نصف
أيّة نقاطٍ أجنيها

269
00:19:35,250 --> 00:19:36,520
أذلك مقبول؟

270
00:19:37,780 --> 00:19:38,600
!أجل

271
00:19:38,990 --> 00:19:43,790
طالما تدفع لي، سأدع الماضي في الماضي

272
00:19:43,790 --> 00:19:45,960
أنت ذكيٌّ بحقّ يا أيانوكوجي-كن

273
00:19:45,960 --> 00:19:48,750
لست كـ هوريكيتا-سان أبداً

274
00:19:49,040 --> 00:19:51,560
أيمكننا الاستمرار على وفاق؟

275
00:19:52,550 --> 00:19:55,090
قبول تحدّي ساكاياناغي

276
00:19:55,590 --> 00:19:59,260
وإنقاذ إيتشينوسي كانا محض حادثتين عرضيّتين

277
00:19:59,920 --> 00:20:04,070
هنالك شيءٌ واحد فحسب أردت
معرفته من هذه الواقعة

278
00:20:05,130 --> 00:20:09,040
ألا وهو جودة وكميّة المعلومات لدى كوشيدا كيكيو

279
00:20:10,070 --> 00:20:11,680
أردت التحقّق من ذلك

280
00:20:13,740 --> 00:20:15,590
والإسهام في فصلها

281
00:21:49,950 --> 00:21:51,760
!صباح الخير يا أيانوكوجي-كن

282
00:21:52,100 --> 00:21:53,320
صباح الخير

283
00:21:53,320 --> 00:21:55,540
كنتِ رائعةً بالأمس

284
00:21:58,160 --> 00:22:00,030
أ-أترى ذلك؟

285
00:22:00,030 --> 00:22:03,480
من المُذهل تجاوزكِ لظلام الماضي بقوّتك

286
00:22:04,540 --> 00:22:05,910
ربما ذلك

287
00:22:06,740 --> 00:22:09,380
لا أستطيع سحب ما فعلتُه

288
00:22:09,800 --> 00:22:10,600
...لكن

289
00:22:11,140 --> 00:22:13,810
أعتقد أنّ بإمكاني العيش مع الأمر
من الآن فصاعداً

290
00:22:14,510 --> 00:22:18,600
،إن استشعرتِ خطر فقدانك لنفسكِ من جديد

291
00:22:19,220 --> 00:22:21,570
فلا تتردّدي في الكلام معي

292
00:22:24,570 --> 00:22:28,460
يسعني الاستماع دوماً على الأقلّ

293
00:22:30,430 --> 00:22:33,260
ستتركني أعتمد عليك هكذا؟

294
00:22:33,600 --> 00:22:35,430
إن كنتِ لا تمانعين

295
00:22:38,120 --> 00:22:40,200
هـ-هكذا إذاً

296
00:22:41,040 --> 00:22:42,820
...هـ-هل

297
00:22:44,120 --> 00:22:45,140
ماذا؟

298
00:22:45,690 --> 00:22:47,560
...حسناً، أنا

299
00:22:48,400 --> 00:22:50,980
...هـ-هذا غريب

300
00:22:50,980 --> 00:22:53,480
ظننتني سأفعلها بسلاسة أكبر

301
00:22:54,480 --> 00:22:56,110
ما خطبي؟

302
00:22:56,110 --> 00:22:59,840
...لم يسبق وأن أعطيتُ أحداً شيئاً كهذا

303
00:23:00,330 --> 00:23:03,000
لكنّي لا أعرف كيف أعبّر
...عن امتناني بغير هذا، لذا

304
00:23:03,000 --> 00:23:05,410
لا داعي لترغمي نفسكِ

305
00:23:05,410 --> 00:23:07,870
!لا-لا-لا أرغم نفسي

306
00:23:12,050 --> 00:23:15,870
تأخّر الوقت قليلاً... لكن هاك

307
00:23:15,870 --> 00:23:17,240
شوكولاته فالينتاين

308
00:23:18,470 --> 00:23:20,690
لا-لا تريدها؟

309
00:23:23,010 --> 00:23:24,050
بلى

310
00:23:25,110 --> 00:23:26,000
شكراً لكِ