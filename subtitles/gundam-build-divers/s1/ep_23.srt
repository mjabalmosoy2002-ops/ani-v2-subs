1
00:00:00,910 --> 00:00:03,160
...سنحدّد مستقبلنا -
...سنحدّد مستقبلنا -

2
00:00:03,200 --> 00:00:05,080
!بباتل غانبلا هذه -
!بباتل غانبلا هذه -

3
00:00:06,040 --> 00:00:08,040
تمّ قبول غانبلا باتل

4
00:00:08,080 --> 00:00:10,410
الانتقال إلى نمط معركة الفورس

5
00:00:10,450 --> 00:00:12,000
جاري تعريف الآليّين

6
00:00:12,040 --> 00:00:13,370
!إنّهم بيلد دايفرز

7
00:00:13,410 --> 00:00:14,370
ماذا؟

8
00:00:14,410 --> 00:00:15,910
من الأعلى؟

9
00:00:15,950 --> 00:00:17,250
!استعدّوا للاعتراض

10
00:00:26,750 --> 00:00:28,120
نحن قادمون

11
00:00:28,160 --> 00:00:29,870
انتظرينا يا سارة فحسب

12
00:00:35,120 --> 00:00:36,450
أصابوا منظومات الدفع خاصّتنا

13
00:00:36,500 --> 00:00:37,910
!اصمدي

14
00:00:39,830 --> 00:00:42,410
!اسحب القبضة الثنائية. اسحب، اسحب

15
00:00:43,330 --> 00:00:45,500
!لا أملك خياراً. هبوط اضطراري

16
00:00:51,750 --> 00:00:54,000
هبط فريق رون بطريقةٍ ما

17
00:00:54,040 --> 00:00:55,160
سنفعل ذلك أيضاً

18
00:01:01,910 --> 00:01:03,160
كيف حال فريق هيرو؟

19
00:01:06,330 --> 00:01:07,410
على رسلِك يا هيرو

20
00:01:07,450 --> 00:01:10,750
!أقرب... أقرب إلى القلعة

21
00:01:14,290 --> 00:01:16,370
!لقد سقط المكّوك 3

22
00:01:16,410 --> 00:01:21,290
هبط المكّوك 1 في الجزيرة العائمة
غاريث، والمكّوك 2 في موردريد

23
00:01:21,910 --> 00:01:23,870
ماذا عن الكيدو سينشي في المركب؟

24
00:01:23,910 --> 00:01:25,950
يبدو أنّهم نُشِروا بالفعل

25
00:01:32,160 --> 00:01:34,700
حطام عدد من الآليّين في الحمولة

26
00:01:35,660 --> 00:01:39,790
يبدو أنّ الغانبلا في المركب قد دُمّروا كلّياً

27
00:03:12,700 --> 00:03:16,950
"الاثنان المصيريّان"

28
00:03:29,790 --> 00:03:32,160
!حسناً. ابدأوا بالتقدّم

29
00:03:38,700 --> 00:03:40,080
!سأندفع للأمام

30
00:03:45,200 --> 00:03:47,620
عمليّة الغزو الخاطف؟

31
00:03:47,660 --> 00:03:51,750
سنتجاوز شبكة دوريّات الائتلاف بالمكاكيك

32
00:03:51,790 --> 00:03:55,250
وندخل القلعةَ مباشرة حيث تُحتجَز سارة

33
00:03:56,040 --> 00:03:57,750
،بأخذهم على حين غرة

34
00:03:57,790 --> 00:04:00,450
يمكننا التّعويض عن التفوّق العددي

35
00:04:00,500 --> 00:04:01,870
!فكرة عظيمة

36
00:04:01,910 --> 00:04:03,040
...لكن

37
00:04:03,080 --> 00:04:06,620
الحامية في محيط القلعة هي قوّة ضخمة
بحدّ ذاتها

38
00:04:06,660 --> 00:04:09,200
لن يكون تخطّيها سهلاً

39
00:04:10,040 --> 00:04:11,080
أتّفق

40
00:04:11,120 --> 00:04:13,160
ماذا يعني هذا؟

41
00:04:13,200 --> 00:04:16,080
لذا سنرسم خطّة أخرى

42
00:04:18,790 --> 00:04:20,580
عدد من الأعداء قادمون من الخلف

43
00:04:20,620 --> 00:04:23,370
الحرّاس الذين انتشروا بالجوار يعودون

44
00:04:23,410 --> 00:04:24,500
!دعوا الأمر لي

45
00:04:27,000 --> 00:04:29,330
عزّزتُ من القوّة الناريّة

46
00:04:30,160 --> 00:04:32,330
لجيغان بلاست ماستر لأقصى حدّ

47
00:04:32,370 --> 00:04:33,750
!سأقضي عليهم جميعاً

48
00:04:53,910 --> 00:04:56,250
...سننقذ سارة

49
00:04:56,910 --> 00:04:58,750
!مهما كلّف الأمر

50
00:05:08,950 --> 00:05:10,000
!ابقوا ثابتين

51
00:05:10,040 --> 00:05:11,950
حاصروهم بشكل تدريجي

52
00:05:13,830 --> 00:05:15,870
أحسنت يا يوكّي

53
00:05:15,910 --> 00:05:17,700
لن ندعهم يتفوّقون علينا

54
00:05:18,410 --> 00:05:20,910
!حسناً، حان وقت الثّوران

55
00:05:23,040 --> 00:05:27,950
الأخطاء البرمجيّة تنتشر في غ.ب.ن
كانتشار النار في الهشيم الآن

56
00:05:28,000 --> 00:05:33,370
لديّ واجب وهو نشر السّلام في هذا العالم

57
00:05:34,830 --> 00:05:36,660
،لذلك السبب

58
00:05:36,700 --> 00:05:39,160
لا أستطيع القبول بوجودك ولا بأي شكل
من الأشكال

59
00:05:39,910 --> 00:05:42,120
وأنتِ قد تقبّلتِ ذلك أيضاً

60
00:06:00,910 --> 00:06:04,250
لقد مارستُ حقوق الفورس الخاص
بي الإداريّة

61
00:06:04,660 --> 00:06:06,750
هذا وكر الفورس الخاص بي

62
00:06:07,330 --> 00:06:11,000
لن أسمح حتّى لمشرف اللّعب أن يفعل
ما يحلو له

63
00:06:11,040 --> 00:06:13,950
!أنتم من يفعلون ما يحلو لكم

64
00:06:14,620 --> 00:06:19,620
بتركِ مستقبل غ.ب.ن بين يدَي مجرّد
!غانبلا باتل واحدة

65
00:06:19,660 --> 00:06:25,790
أليس عالم غ.ب.ن اللّامحدود هذا يتمدّد ويتّسع
لأجل مجرّد غانبلا باتل؟

66
00:06:27,830 --> 00:06:31,040
أفهم أنّنا نثقل في طلباتنا

67
00:06:31,080 --> 00:06:35,870
لكن الآن، سارة ليست مُحتجَزة لدى الإدارة

68
00:06:35,910 --> 00:06:37,660
بل لدى ائتلافنا

69
00:06:38,370 --> 00:06:40,620
من فضلك لا تتجاهل رغبتنا

70
00:06:41,620 --> 00:06:43,120
سمعت ذلك أيضاً

71
00:06:43,830 --> 00:06:48,330
لقد وُلِدتْ من أجزاء مشاعر الغوّاصين
تجاه الغانبلا

72
00:06:50,040 --> 00:06:54,000
،إن كنّا نحن الغوّاصون من أنشأناها

73
00:06:54,040 --> 00:07:00,580
فدعنا إذاً نقرّر مصيرها ومستقبل غ.ب.ن بإرادتنا

74
00:07:01,750 --> 00:07:05,000
حتّى لو أعيدَ كلّ شيء من بعد ذلك
،للحالة الأصليّة

75
00:07:05,040 --> 00:07:09,950
فتلك هي أمنيتنا نحن، اللّاعبون، وأمنيتي
أنا، صديقك

76
00:07:10,000 --> 00:07:11,200
من فضلك يا سيّد كاتسوراغي

77
00:07:16,250 --> 00:07:20,700
هل سمعتم؟ كان دابل-أو ذاك داخل
المكّوك المتحطّم أيضاً

78
00:07:20,750 --> 00:07:24,500
سمعتُ أنّه تحطّم وتشوّه لدرجة أنّه
من غير الممكن تحديد هويّة الغانبلا

79
00:07:31,700 --> 00:07:34,040
...مُحال أن يتوقّع أحد

80
00:07:34,080 --> 00:07:37,750
أنني سأتسلّل إلى داخل القلعة من الممرّ
المائي تحت الأرض

81
00:07:42,080 --> 00:07:45,620
تزييف سقوط المكّوك الذي يتواجد فيه
فريق ريكو؟

82
00:07:45,660 --> 00:07:49,080
ستوهمونهم بأنّ كافّة الغانبلا قد دُمِّروا

83
00:07:49,120 --> 00:07:53,750
نعم. والأعضاء الآخرون سيُحاولون كسر
خطوط الجبهة

84
00:07:53,790 --> 00:07:55,790
لصرف انتباه قوّات العدوّ

85
00:07:55,830 --> 00:07:59,910
ومن ثمّ يستطيع فريق ريكو الآمن الدخول

86
00:07:59,950 --> 00:08:03,500
هذا بالنسبة للمكّوك، لكن كيف سنزيّف
سقوط الغانبلا؟

87
00:08:03,540 --> 00:08:07,120
في هذه الحالة، سيمثّل غانبلا فريقنا
دور الحطام

88
00:08:08,160 --> 00:08:09,120
هيرو؟

89
00:08:09,160 --> 00:08:13,330
تحتاج لـ3 أشخاص لفحص المكاكيك
و6 أشخاص للتحكّم بها

90
00:08:13,370 --> 00:08:16,330
،غاندام كيزونا ضخم جداً ولا يتّسع

91
00:08:16,370 --> 00:08:19,290
لذا يمكننا نشر 4 من س.د غانبلا

92
00:08:20,120 --> 00:08:23,120
،حينها لا يمكننا تشكيل غاندام الصّعقة الفائقة

93
00:08:23,160 --> 00:08:28,160
ولسنا أقوياء مثلكم في القتال الفرديّ

94
00:08:28,790 --> 00:08:31,120
ماذا؟ -
!هذا غير صحيح -

95
00:08:31,160 --> 00:08:32,660
!بل صحيح

96
00:08:33,250 --> 00:08:34,660
...لذا أرجوك

97
00:08:34,700 --> 00:08:37,410
أريدك أن تستخدم الغانبلا الخاص بنا

98
00:08:37,450 --> 00:08:40,500
...لكن -
ستنقذ سارة، صحيح؟

99
00:08:40,540 --> 00:08:43,250
لقد بدأتَ بمعركة طائشة كهذه لأجلها

100
00:08:43,290 --> 00:08:46,620
لذا عليك أن تستخدم الوسائل المتاحة

101
00:08:46,660 --> 00:08:48,870
هذه نصيحتي كغوّاص أقدم منك

102
00:08:49,750 --> 00:08:51,000
...هيرو

103
00:08:53,540 --> 00:08:55,450
شكراً لكم جميعاً

104
00:08:57,080 --> 00:08:58,250
...فلنبدأ

105
00:08:59,040 --> 00:09:00,830
!بهذه العمليّة

106
00:09:02,330 --> 00:09:03,830
!لننقذ سارة

107
00:09:04,370 --> 00:09:05,540
ريكو -
ريكو -

108
00:09:05,580 --> 00:09:06,540
...ريكو

109
00:09:10,870 --> 00:09:12,790
ريكو -
ريكو -

110
00:09:17,040 --> 00:09:20,160
جميعهم ساعدونا وهم على درايةٍ بأنها
مهمّة خطيرة

111
00:09:21,040 --> 00:09:26,410
تطوّع تشا نوار نيو لإيهام العدوّ
بسقوط الغانبلا

112
00:09:29,950 --> 00:09:32,660
...والآخرون لصرف انتباه العدوّ واستدراجه للهجوم

113
00:09:34,450 --> 00:09:36,410
سأصل للقلعة لأجلهم

114
00:09:42,660 --> 00:09:44,910
أقسم أنني سأنقذ سارة

115
00:09:49,910 --> 00:09:51,040
لماذا؟

116
00:09:51,080 --> 00:09:54,160
إنّها طريقتي في تسوية الأمور -
تسوية الأمور؟ -

117
00:09:54,200 --> 00:09:57,410
بعد أن رأيته، اشتعلت نيران الحماس في داخلي

118
00:09:59,500 --> 00:10:01,500
أنا متأكّد أنّكِ قد سمعتِ أيضاً

119
00:10:01,540 --> 00:10:05,500
أنه قد تكون هناك طريقة لإنقاذكِ
وإنقاذ غ.ب.ن. معاً

120
00:10:05,540 --> 00:10:06,700
نعم

121
00:10:07,330 --> 00:10:09,080
أريد أن أسألك مرّة أخيرة

122
00:10:10,450 --> 00:10:11,790
ماذا تريدين؟

123
00:10:13,870 --> 00:10:17,910
بعد انتهاء كلّ شيء، أريد سماع
إجابتك ثانية

124
00:10:23,700 --> 00:10:27,290
إطلاق الغانبلا نحو مواقع الإقلاع

125
00:10:28,120 --> 00:10:30,700
فورس أفالون، كيويا كوجو

126
00:10:31,250 --> 00:10:33,540
!غاندام أيج 2 ماغنوم، إقلاع

127
00:10:43,080 --> 00:10:46,370
نحن نُحاصَر. حريّ بنا أن نتحرّك
...قبل أن

128
00:10:46,410 --> 00:10:48,080
العدوّ في جهة الساعة 10

129
00:10:50,500 --> 00:10:52,040
أنا آسفة

130
00:10:52,080 --> 00:10:54,330
هل ظننتم أنّكم خدعتمونا؟

131
00:10:57,910 --> 00:11:00,540
...الآنسة إيميليا ومبالغتها في التفكير

132
00:11:00,580 --> 00:11:04,160
عدوّ يتسلّل من الممرّ المائي تحت الأرض؟

133
00:11:27,750 --> 00:11:29,620
أتيت فعلاً

134
00:11:29,660 --> 00:11:30,830
!كمين؟

135
00:11:36,250 --> 00:11:37,410
كشفوا أمرنا؟

136
00:11:49,950 --> 00:11:51,160
...روم

137
00:11:57,620 --> 00:11:59,330
سيّد نمر، سأساندك

138
00:12:10,200 --> 00:12:11,330
ماذا؟

139
00:12:15,120 --> 00:12:16,910
...عرفتُ أنك ستكون هنا

140
00:12:19,200 --> 00:12:20,660
يا شهريار

141
00:12:23,370 --> 00:12:25,660
توقّعتُ أن تكون هنا أيضاً

142
00:12:26,750 --> 00:12:28,080
في الوقت المناسب

143
00:12:28,910 --> 00:12:32,500
كنتُ أرغب في تفجير كلّ طاقتي
معك يوماً ما

144
00:12:33,870 --> 00:12:36,160
لا تسرق عبارتي

145
00:12:39,870 --> 00:12:43,330
يوكّي، سأتولّى هذا. اذهب أنت

146
00:12:43,370 --> 00:12:44,750
حـ-حاضر

147
00:12:46,200 --> 00:12:48,120
دعني أسأل قبل أن أسحقك

148
00:12:48,660 --> 00:12:52,540
لماذا تصطفُّ مع الإدارة؟ إنّهم أعداء ريكو

149
00:12:53,330 --> 00:12:56,950
أنا لا أصطفّ مع عدوّ أحد

150
00:12:57,000 --> 00:12:59,330
أنا أفعل ما أؤمن به فحسب

151
00:12:59,370 --> 00:13:00,790
إذاً تعتقد أيضاً

152
00:13:00,830 --> 00:13:07,000
أننا ينبغي أن نمسح سارة خشية
من أن تتسبّب بنهاية غ.ب.ن؟

153
00:13:07,040 --> 00:13:08,290
أجل

154
00:13:08,910 --> 00:13:14,410
إذا اعتبرها غ.ب.ن بالإجماع شيئاً غير
مرغوب فيه

155
00:13:14,450 --> 00:13:21,500
إذاً هل هذا العالم في نظرك هو
مكان لا يعرف الرّحمة ولا الشّفقة؟

156
00:13:21,540 --> 00:13:23,120
لا تكن أحمق

157
00:13:23,660 --> 00:13:27,000
لطالما كان غ.ب.ن فضاء لعبة
غير عضوية

158
00:13:27,040 --> 00:13:29,410
إنّه عديم الرّحمة والشفقة

159
00:13:29,450 --> 00:13:31,540
...لكن أليس غ.ب.ن

160
00:13:31,580 --> 00:13:39,870
مُكوّن من شغف الغوّاصين الملتهب
تجاه الغانبلا؟ وشغفي! وشغف الجميع؟

161
00:13:39,910 --> 00:13:41,910
!كذلك الأمر بالنسبة لك أيضاً

162
00:13:41,950 --> 00:13:44,000
كم هذا رومانسيّ

163
00:13:44,040 --> 00:13:45,200
لا تغيّر الموضوع

164
00:13:46,080 --> 00:13:50,370
ينبغي أن تكون قد علمتَ الآن
بأنّني رجل نزويّ

165
00:13:50,950 --> 00:13:53,790
وأنّني أقيّم الحبّ الحقيقي

166
00:13:54,330 --> 00:13:56,120
...الشيء الوحيد الذي أعرفه

167
00:13:56,160 --> 00:13:59,370
!هو أنّك وغد بغيض

168
00:13:59,410 --> 00:14:00,950
أوجّه نفس الكلام إليك

169
00:14:01,000 --> 00:14:02,750
!لن أتحفّظ

170
00:14:05,580 --> 00:14:07,660
!حضرة القائد -
!لا تتدخّلوا في هذا -

171
00:14:08,620 --> 00:14:12,330
أتوسّل إليك. لا تجعلني أضغط هذا الزناد

172
00:14:12,370 --> 00:14:14,750
الخيار لك

173
00:14:15,700 --> 00:14:21,410
ليس عدلاً أن تلوم الآخرين على تصرّفاتك

174
00:14:21,450 --> 00:14:23,200
لماذا لا تفهم؟

175
00:14:23,250 --> 00:14:27,160
أليس غ.ب.ن لا يُعوّض بثمن بالنسبة لك أيضاً؟

176
00:14:27,200 --> 00:14:32,000
لا شيء يُعوّض بثمن أكثر من ولادة
!حياة جديدة

177
00:14:38,120 --> 00:14:42,700
أتعتقد أنّك تستطيع الحصول على الأفضليّة
في مقاتلتي عن كثب؟

178
00:14:42,750 --> 00:14:45,870
سيكون ذلك من دواعي سروري، أجل

179
00:14:59,290 --> 00:15:00,410
سيرافي

180
00:15:00,950 --> 00:15:02,370
نمط العفريت

181
00:15:05,080 --> 00:15:07,540
...حبّي للغانبلا

182
00:15:07,580 --> 00:15:09,410
!لا ينبغي أن يُستهان به

183
00:15:10,000 --> 00:15:11,410
عظيم

184
00:15:12,040 --> 00:15:13,500
...دعني أريك إذاً

185
00:15:13,540 --> 00:15:16,790
!كم أنّني أقوى منك في القتال عن كثب

186
00:15:26,660 --> 00:15:28,080
أولاً، تينرو

187
00:15:28,830 --> 00:15:30,290
ثانياً، كوكو

188
00:15:31,870 --> 00:15:35,830
!الحركة الخاصّة رعد رايجين

189
00:15:35,870 --> 00:15:37,040
!ترانز-أم

190
00:15:47,250 --> 00:15:48,290
ترانز-أم؟

191
00:16:03,370 --> 00:16:06,000
أنت الأفضل يا شهريار

192
00:16:06,790 --> 00:16:10,200
إذاً سأضطرّ لتقديم أفضل ما لديّ أيضاً

193
00:16:11,250 --> 00:16:16,200
ستكون أوّل شخص يجعلني أستخدم
هذه الحركة

194
00:16:32,750 --> 00:16:35,080
!سرّ شوكان الأعظم

195
00:16:41,450 --> 00:16:44,410
!ريكوغيكي شوريودا

196
00:17:05,750 --> 00:17:08,160
أنت حقّاً مهووس بالمعارك عن كثب

197
00:17:09,120 --> 00:17:11,950
لكن أنا مهووس بالبناء

198
00:17:13,500 --> 00:17:16,620
...مشاهدة معركتك مع ريكو جعلتني أتذكّر

199
00:17:17,790 --> 00:17:21,790
شعوري عندما أعجبتُ أوّل مرّة بغانبلا باتل

200
00:17:22,620 --> 00:17:24,290
إعجابي كمُقاتل

201
00:17:25,540 --> 00:17:30,200
كانت معركة صداقة مليئة بالحبّ الحقيقي الأصيل

202
00:17:31,370 --> 00:17:32,540
شكراً لك

203
00:17:33,290 --> 00:17:34,790
...لا تقلْ لي

204
00:17:34,830 --> 00:17:37,830
أنّك تحالفتَ مع الإدارة لتجعلني أقاتل
بكامل قوّتي؟

205
00:17:39,040 --> 00:17:43,250
يعلم الائتلاف بتكتيكات صرف الانتباه
التي يتّبعها فريقكم

206
00:17:43,290 --> 00:17:44,750
ماذا؟

207
00:17:44,790 --> 00:17:47,330
سأخبرك بأضعف نقاط دفاعهم

208
00:17:47,370 --> 00:17:49,750
...أسرع و -
لن أدعكما -

209
00:17:54,750 --> 00:17:57,330
لن أدعكما تعترضان طريقنا

210
00:17:58,120 --> 00:18:02,500
وأنا أيضاً لا أستطيع ان أدعك تعترض
طريق ريكو

211
00:18:03,540 --> 00:18:05,620
سأواجه البطل

212
00:18:06,160 --> 00:18:07,950
اذهب أنت لمساعدة ريكو

213
00:18:08,000 --> 00:18:11,330
...لا، اذهب أنت. أنا سأتولّى

214
00:18:12,830 --> 00:18:15,790
هلّا توقّفنا عن الجدال؟

215
00:18:15,830 --> 00:18:18,160
...إن لم تتضافر قوانا

216
00:18:18,200 --> 00:18:20,410
لا يمكننا هزيمة هذا الخصم أبداً

217
00:18:24,250 --> 00:18:28,950
!لن أدع أنانيّتك تدمّر غ.ب.ن

218
00:18:29,000 --> 00:18:33,700
لم أبدأ بلعب غ.ب.ن لخوض معركة
كهذه أيضاً

219
00:18:35,330 --> 00:18:37,500
مكان يمكننا فيه أن نبتسم من قلوبنا

220
00:18:38,410 --> 00:18:41,290
هذا هو غ.ب.ن الذي أحبّه

221
00:18:41,330 --> 00:18:43,160
...لذا أنا لا

222
00:18:43,200 --> 00:18:44,370
!...لكن

223
00:19:00,700 --> 00:19:02,830
بدأت الأمور تتّخذ منحى سيّئاً

224
00:19:02,870 --> 00:19:06,120
أتشعر بالإحباط؟ -
كلّا -

225
00:19:06,160 --> 00:19:08,660
حان الوقت لتنفيذ حركة يائسة

226
00:19:08,700 --> 00:19:10,910
تريد استخدام هذا إذاً؟

227
00:19:22,540 --> 00:19:23,750
!خذ هذه

228
00:19:24,290 --> 00:19:27,910
!طريق سوكيوكو الحريري

229
00:19:39,120 --> 00:19:40,450
لنضع حدّاً لهذا

230
00:19:43,500 --> 00:19:45,080
...هـ-هذا

231
00:19:45,910 --> 00:19:49,160
أتساءل ما إن كان ريكو والآخرون يفعلونها

232
00:19:50,200 --> 00:19:51,750
أين غرفة الخادم؟

233
00:19:52,830 --> 00:19:54,830
أخبرك كويتشي، صحيح؟

234
00:19:55,500 --> 00:19:57,660
هل أنت... تسوكاسا؟

235
00:19:57,700 --> 00:19:59,500
دلّيني إلى هناك فحسب

236
00:20:04,910 --> 00:20:06,580
...إن علقنا هنا

237
00:20:06,620 --> 00:20:08,700
!أعداء جدُد في جهة الساعة 11

238
00:20:11,750 --> 00:20:13,700
فريقكم لا أمل له في الفوز

239
00:20:14,500 --> 00:20:16,000
استسلموا

240
00:20:16,040 --> 00:20:19,540
!لا! مُحال أن نستسلم

241
00:20:22,160 --> 00:20:25,700
سننقذ سارة مهما كلّف الأمر

242
00:20:25,750 --> 00:20:27,120
مستحيل

243
00:20:27,160 --> 00:20:30,410
هذا ليس مستحيلاً! أنا جادّة حقاً
!بأننا سننقذها

244
00:20:36,160 --> 00:20:37,290
...أخي

245
00:20:43,330 --> 00:20:47,410
لم أعلم أبداً أنّك مهّدت طريقاً سرّياً
نحو غ.ب.ن بهذا الشكل

246
00:20:49,290 --> 00:20:51,620
تمّ تأكيد أداة بيلد ديكال

247
00:20:52,580 --> 00:20:53,910
...إذاً هذا

248
00:20:53,950 --> 00:20:56,080
ماذا؟ -
لا شيء -

249
00:20:56,120 --> 00:21:00,700
لم أتوقّع أبداً أن نستخدم تقنيّة بريك
ديكال بهذا الشّكل

250
00:21:00,750 --> 00:21:02,370
ألا تثقين بي؟

251
00:21:02,410 --> 00:21:04,000
على العكس

252
00:21:04,040 --> 00:21:08,580
لكن لم أتوقّع أبداً أنه استخدم هذا
النظام من ج.بّي.د

253
00:21:08,620 --> 00:21:10,080
كانت تلك نقطة عمياء

254
00:21:10,120 --> 00:21:12,370
إنها تكنولوجيا نبذتموها أنتم

255
00:21:13,000 --> 00:21:14,330
...لكن هذا غير

256
00:21:14,870 --> 00:21:16,200
لا، معك حقّ

257
00:21:16,250 --> 00:21:18,040
لا حاجة للاعتذار

258
00:21:18,080 --> 00:21:20,290
لكن دعني أشكرك

259
00:21:20,330 --> 00:21:24,910
بفضلِ قدرتنا على استخدامِ تكنولوجيا ج.بّي.د
هذه التي حفظتَها أنت

260
00:21:24,950 --> 00:21:27,950
كورقة رابحة، سننقذ سارة

261
00:21:28,750 --> 00:21:30,870
شكراً لك يا سيّد شيبا

262
00:21:32,250 --> 00:21:33,540
لنتابع

263
00:21:34,910 --> 00:21:36,120
لا داعي للقلق

264
00:21:36,160 --> 00:21:40,830
بهذه الأداة والجسد، يمكننا نقل روحها
بشكل دائم

265
00:21:42,410 --> 00:21:46,370
والآن كلّ ما بقي هو أن ننتظر
وصولها بأمان

266
00:22:00,250 --> 00:22:03,330
...أعدكِ... أقسم

267
00:22:03,370 --> 00:22:05,370
أنني سأنقذك

268
00:22:31,790 --> 00:22:33,000
!سيّد نمر

269
00:22:33,950 --> 00:22:35,160
!سيّد شهري

270
00:22:36,580 --> 00:22:38,660
اهرب يا ريكو

271
00:22:38,700 --> 00:22:39,910
بسرعة

272
00:22:50,120 --> 00:22:51,450
...البطل

273
00:24:11,620 --> 00:24:14,370
لم أتخيّل أبداً أن نواجه بعضنا الآخر
بهذا الشكل يوماً ما

274
00:24:14,410 --> 00:24:17,870
ولا أنا أيضاً... لم أرد أن أقاتلك هكذا

275
00:24:17,910 --> 00:24:20,200
إذاً ليس أمامك سوى خيار واحد

276
00:24:20,250 --> 00:24:22,200
غادر هذا المكان حالاً

277
00:24:22,250 --> 00:24:23,660
!لا أستطيع فعل ذلك

278
00:24:23,700 --> 00:24:24,620
توقّعتُ هذا

279
00:24:24,660 --> 00:24:26,870
!يجب عليّ المضيّ قدماً

280
00:24:26,910 --> 00:24:28,870
أنت من أشعل هذه المعركة

281
00:24:28,910 --> 00:24:32,080
!...إذاً مهما كنتَ قاهراً

282
00:24:32,790 --> 00:24:34,870
الحلقة القادمة، معركة حاسمة

283
00:24:34,910 --> 00:24:38,750
!لن تحطّم سمعة البطل بهذه السّهولة