‫إن استطعت الاستماع إليها مرة أخرى‬

568
00:43:07,120 --> 00:43:08,460
‫سأتذكّر.‬

569
00:43:09,500 --> 00:43:10,420
‫ماذا ستتذكر؟‬

570
00:43:14,460 --> 00:43:16,260
‫لا أريد أن أنسى.‬

571
00:43:18,470 --> 00:43:20,300
‫لا يمكنني أن أتذكّر.‬

572
00:43:23,640 --> 00:43:25,350
‫لا يمكنني أن أتذكّر.‬

573
00:43:36,070 --> 00:43:37,150
‫شكرًا.‬

574
00:43:40,650 --> 00:43:41,780
‫"(يامازاكورا)."‬

575
00:43:42,820 --> 00:43:43,910
‫فيها ثقب.‬

576
00:43:48,660 --> 00:43:49,910
‫كم هي ظريفة.‬

577
00:43:53,250 --> 00:43:54,630
‫ثمة ما بداخلها.‬

578
00:44:00,050 --> 00:44:00,880
‫ألق نظرة.‬

579
00:44:05,390 --> 00:44:10,270
‫"الوداع ليس بالكلمات الملقاة‬
‫كرقصة زهر الكرز"‬

580
00:44:11,350 --> 00:44:12,190
‫أهي قصيدة "هايكو"؟‬

581
00:44:13,350 --> 00:44:14,900
‫"الوداع‬

582
00:44:15,610 --> 00:44:17,360
‫ليس بالكلمات الملقاة"‬

583
00:44:18,650 --> 00:44:20,900
‫"كرقصة زهر الكرز"‬

584
00:44:29,080 --> 00:44:29,950
‫سأبحث عنها.‬

585
00:44:30,540 --> 00:44:31,580
‫سيد "فوجياما".‬

586
00:44:32,250 --> 00:44:34,880
‫سأبحث عن الأسطوانة أيضًا.‬

587
00:44:36,710 --> 00:44:37,590
‫وأنا أيضًا.‬

588
00:44:39,170 --> 00:44:40,300
‫أريده أن يستمع إليها.‬

589
00:44:41,880 --> 00:44:47,140
‫أريده أن يستعيد ذكرياته الغالية على قلبه.‬

590
00:44:52,730 --> 00:44:54,400
‫هل أنت بخير؟ ما خطبك؟‬

591
00:44:54,480 --> 00:44:56,150
‫سيد "فوجياما"؟‬

592
00:44:56,860 --> 00:44:58,270
‫سيد "فوجياما"!‬

593
00:44:58,820 --> 00:45:01,780
‫أبي!‬

594
00:45:18,290 --> 00:45:21,260
‫أتساءل إن كان السيد "فوجياما" بخير.‬

595
00:45:22,210 --> 00:45:23,090
‫أجل.‬

596
00:45:25,010 --> 00:45:27,590
‫لعلّ الأسطوانة التي يبحث عنها‬

597
00:45:28,720 --> 00:45:30,560
‫موجودة بداخل المتجر.‬

598
00:45:32,140 --> 00:45:32,980
‫أجل.‬

599
00:45:34,810 --> 00:45:39,060
‫لكنني أتساءل‬
‫لماذا كان يبحث دومًا في المركز التجاري؟‬

600
00:45:44,030 --> 00:45:45,700
‫- أنا…‬
‫- بالمناسبة…‬

601
00:45:47,950 --> 00:45:49,870
‫لم تضعها مؤخرًا.‬

602
00:45:57,460 --> 00:45:58,790
‫لا تلزمني.‬

603
00:45:58,880 --> 00:45:59,710
‫ماذا؟‬

604
00:46:00,420 --> 00:46:01,250
‫لا عليك.‬

605
00:46:16,440 --> 00:46:18,150
‫"يامازاكورا"…‬

606
00:46:18,770 --> 00:46:22,190
‫"تسجيلات (يامازاكورا)"‬

607
00:46:36,250 --> 00:46:37,410
‫بشأن تلك الأسطوانة‬…‬

608
00:46:38,000 --> 00:46:40,830
‫الفتاة التي صورتها على غلاف الأسطوانة‬
‫ترتدي ملابس ظريفة،‬

609
00:46:40,920 --> 00:46:42,590
‫لذا أجريت بحثًا عبر الصور.‬

610
00:46:44,300 --> 00:46:46,550
‫ملابسها تلك كانت رائجة قبل 50 عامًا.‬

611
00:46:46,630 --> 00:46:48,590
‫يعني أن الأسطوانة من تلك الحقبة.‬

612
00:46:49,340 --> 00:46:51,470
‫هل يتعلّق الموضوع بالسيد "فوجياما"؟‬

613
00:46:52,640 --> 00:46:55,810
‫حسبما يبدو أنّه عمل هنا منذ وقت طويل.‬

614
00:46:55,890 --> 00:46:56,890
‫في المركز التجاري؟‬

615
00:46:56,980 --> 00:46:58,520
‫كلا.‬

616
00:47:06,400 --> 00:47:08,990
‫"ألبوم صور مركز (أودا نوفيل) التجاري"‬

617
00:47:09,070 --> 00:47:10,320
‫"معرض الذكرى السنوية"‬

618
00:47:27,050 --> 00:47:29,050
‫هذه ملصقات مهرجان "داروما".‬

619
00:47:30,720 --> 00:47:33,260
‫عرفوا الألعاب النارية حتى في أول مهرجان.‬

620
00:47:33,350 --> 00:47:34,300
‫أجل.‬

621
00:47:35,010 --> 00:47:37,560
‫يصادف هذا العام السنويّ الـ56…‬

622
00:47:37,640 --> 00:47:40,190
‫إنه مستمر منذ أكثر من 50 عامًا.‬

623
00:47:47,780 --> 00:47:50,740
‫كنا نأمل أن نجد شخصًا عالمًا بالماضي.‬

624
00:47:52,110 --> 00:47:53,950
‫هل من أحد هنا على علم بهذا؟‬

625
00:47:57,450 --> 00:47:58,660
‫صحيح.‬

626
00:47:58,750 --> 00:48:01,540
‫لم لا تجرّبون البحث في المتجر الخيري‬
‫في الطابق الـ3؟‬

627
00:48:01,620 --> 00:48:05,540
‫يقتنون أسطوانات قديمة فيه، صحيح؟‬

628
00:48:05,630 --> 00:48:09,550
‫لا توجد أيّ أسطوانات باسم "يامازاكورا".‬

629
00:48:09,630 --> 00:48:11,590
‫حسنًا.‬

630
00:48:11,680 --> 00:48:17,220
‫لكن أظن أن تلك الأسطوانة قد تكون‬
‫صورة غلاف!‬

631
00:48:17,850 --> 00:48:18,930
‫صورة غلاف؟‬

632
00:48:19,770 --> 00:48:21,730
‫هذا ما تبدو عليه.‬

633
00:48:21,810 --> 00:48:23,560
‫ما هذه؟ إنها ظريفة!‬

634
00:48:23,650 --> 00:48:25,150
‫أليس كذلك؟‬

635
00:48:25,230 --> 00:48:27,900
‫إنه إصدار أسطوانة "هيكارون" المحدود!‬

636
00:48:28,650 --> 00:48:33,490
‫أغلفة الأسطوانات غالبًا ما يكون فيها ثقب‬
‫يسمح بالنظر إلى محتواها.‬

637
00:48:34,570 --> 00:48:37,950
‫ما تحملينها فيها ثقب في الوسط أيضًا.‬

638
00:48:38,040 --> 00:48:39,540
‫فهمت.‬

639
00:48:39,620 --> 00:48:41,290
‫أنت مذهل يا "جابان".‬

640
00:48:41,370 --> 00:48:42,500
‫لا داعي.‬

641
00:48:42,580 --> 00:48:44,370
‫ماذا هناك؟ أهو بحث عن كنز مفقود؟‬

642
00:48:45,170 --> 00:48:46,590
‫أجل، شيء من هذا القبيل.‬

643
00:48:46,670 --> 00:48:48,920
‫ماذا؟ أريد الانضمام أيضًا!‬

644
00:48:50,050 --> 00:48:52,840
‫يبدو أن هذه الأسطوانة من النوع ‬
‫الذي يحمل صورة.‬

645
00:48:54,510 --> 00:48:56,550
‫هل يوجد بينكم من يعرف لمن هي؟‬

646
00:48:57,890 --> 00:49:00,180
‫"- ولا أدنى فكرة.‬
‫- لم أرها من قبل."‬

647
00:49:00,270 --> 00:49:02,480
‫"- هل من تلميح؟‬
‫- سأسأل جدّي!"‬

648
00:49:02,560 --> 00:49:06,190
‫أظن أن لا أحد يعرف.‬

649
00:49:10,820 --> 00:49:12,740
‫أليس برج الراديو في جبل "أومافوسي"؟‬

650
00:49:14,820 --> 00:49:18,330
‫"أليس هذا برج الراديو‬
‫في جبل (أومافوسي)؟"‬

651
00:49:18,410 --> 00:49:21,080
‫"في الجهة الجنوبية من مدينة (أودا)."‬

652
00:49:21,580 --> 00:49:23,910
‫"تشتهر المنطقة بأزهار (يامازاكورا)."‬

653
00:49:47,900 --> 00:49:50,820
‫"حيّ (يوشيدا)، مدينة (أودا)‬
‫تحف جبل (أومافوسي)"‬

654
00:50:03,620 --> 00:50:04,450
‫انظري.‬

655
00:50:07,370 --> 00:50:10,040
‫"مغنية ومؤلفة من مدينة (أودا)"‬

656
00:50:10,130 --> 00:50:12,300
‫"(ساكورا فوجياما)"‬

657
00:50:18,930 --> 00:50:22,600
‫"مغنية ومؤلفة من مدينة (أودا)."‬

658
00:50:22,680 --> 00:50:25,140
‫"(ساكورا فوجياما)، ابنة الـ22 عامًا."‬

659
00:50:26,140 --> 00:50:28,650
‫"كانت (يامازاكورا) آخر أسطوانة أطلقتها."‬

660
00:50:29,940 --> 00:50:32,020
‫اسم عائلتها…‬

661
00:50:32,110 --> 00:50:33,070
‫صحيح.‬

662
00:50:34,070 --> 00:50:35,240
‫"فوجياما".‬

663
00:50:37,320 --> 00:50:38,570
‫أمّي.‬

664
00:50:40,660 --> 00:50:44,750
‫هل يعني أن علاقتها بالسيد "فوجياما"‬
‫هي أنها…‬

665
00:50:44,830 --> 00:50:46,580
‫- زوجته؟‬
‫- أجل.‬

666
00:50:48,040 --> 00:50:51,960
‫كانت أمّي مولعة بالموسيقى.‬

667
00:50:53,550 --> 00:50:55,840
‫أين هي الآن؟‬

668
00:50:56,670 --> 00:51:01,090
‫سمعت أنها مرضت وماتت‬
‫بعد أن أنجبتني بفترة قصيرة.‬

669
00:51:01,180 --> 00:51:04,850
‫كنت صغيرة في السن ولا أتذكّر شيئًا.‬

670
00:51:08,020 --> 00:51:10,020
‫افتتح أبي هذا المتجر‬

671
00:51:10,100 --> 00:51:13,360
‫كي يبيع أسطوانات أمّي.‬

672
00:51:13,440 --> 00:51:15,360
‫فهمت.‬

673
00:51:17,530 --> 00:51:20,860
‫والحقيقة أننا سنغلقه‬
‫في عطلة الأسبوع القادمة.‬

674
00:51:22,950 --> 00:51:25,950
‫صار رثًا ولا أحد يريد أن يعمل فيه.‬

675
00:51:26,910 --> 00:51:29,580
‫إن "ياسويوكي" يحزم أغراضه حاليًا.‬

676
00:51:32,750 --> 00:51:34,960
‫آه كم هذا متعب.‬

677
00:51:36,460 --> 00:51:37,590
‫هل من تقدّم؟‬

678
00:51:38,170 --> 00:51:39,930
‫ها أنا أبحث.‬

679
00:51:40,010 --> 00:51:41,430
‫أراكما جئتما.‬

680
00:51:41,510 --> 00:51:43,100
‫ما الذي أتى بكما؟‬

681
00:51:44,010 --> 00:51:45,260
‫عرّجنا بالمكان فحسب.‬

682
00:51:45,350 --> 00:51:46,560
‫عرّجتما به فحسب؟‬

683
00:51:55,610 --> 00:51:57,150
‫أظن أن السيد "فوجياما"‬

684
00:51:58,990 --> 00:52:01,150
‫يريد الاستماع إلى صوت "ساكورا".‬

685
00:52:02,490 --> 00:52:04,910
‫لهذا السبب يبحث بمشقة عنها.‬

686
00:52:11,920 --> 00:52:12,750
‫هل…‬

687
00:52:16,130 --> 00:52:19,590
‫هل يمكنني المساعدة في حزم الأسطوانات أيضًا؟‬

688
00:52:19,670 --> 00:52:21,550
‫- ماذا؟‬
‫- ما الأمر؟‬

689
00:52:21,630 --> 00:52:26,140
‫الأسطوانة التي يبحث عنها السيد "فوجياما"‬
‫قد تكون هنا.‬

690
00:52:26,220 --> 00:52:27,060
‫مهلك.‬

691
00:52:27,140 --> 00:52:28,270
‫وأنا أيضًا!‬

692
00:52:28,350 --> 00:52:29,640
‫ماذا؟‬

693
00:52:35,230 --> 00:52:36,480
‫لأكون صريحة…‬

694
00:52:39,480 --> 00:52:41,110
‫لقد بحثت بنفسي أيضًا.‬

695
00:52:43,860 --> 00:52:45,870
‫لكنني لم أفلح في إيجادها.‬

696
00:52:49,200 --> 00:52:50,750
‫إن بحثنا كلّنا معًا‬

697
00:52:51,750 --> 00:52:53,330
‫فربما سنجها.‬

698
00:52:57,040 --> 00:52:59,130
‫سأطلب من "بيفر" و"جابان" المساعدة أيضًا.‬

699
00:52:59,210 --> 00:53:00,170
‫حسنًا.‬

700
00:53:00,260 --> 00:53:02,300
‫مهلًا لحظة.‬

701
00:53:02,380 --> 00:53:05,470
‫ما الأسطوانة التي يبحث عنها جدّي؟‬

702
00:53:06,260 --> 00:53:08,100
‫ألا تريد الاستماع إليها أيضًا؟‬

703
00:53:08,680 --> 00:53:10,220
‫إنها بصوت جدتك.‬

704
00:53:11,180 --> 00:53:14,560
‫"ما كنت لآتي بمفردي"‬

705
00:53:14,640 --> 00:53:16,100
‫"لأقطف الزهور"‬

706
00:53:16,190 --> 00:53:19,110
‫"14 أغسطس"‬

707
00:53:22,190 --> 00:53:24,110
‫"مفتوح"‬

708
00:53:47,390 --> 00:53:50,060
‫يا إلهي، الجوّ حارّ.‬

709
00:53:50,140 --> 00:53:50,970
‫أنت محقة.‬

710
00:53:51,060 --> 00:53:52,680
‫أكاد أذوب.‬

711
00:53:52,770 --> 00:53:54,060
‫فلتتكيفوا مع الوضع.‬

712
00:53:54,140 --> 00:53:56,190
‫مكيّف الهواء معطّل.‬

713
00:53:56,270 --> 00:53:58,690
‫ينبغي أن تفي المروحة بالغرض.‬

714
00:54:03,650 --> 00:54:04,740
‫يمكنك أن تنزعيه.‬

715
00:54:06,570 --> 00:54:08,570
‫في الواقع…‬

716
00:54:08,660 --> 00:54:10,450
‫الجو مغبرّ هنا.‬

717
00:54:12,040 --> 00:54:15,160
‫اسمعوا، أعددت معكرونة "السومن". ‬

718
00:54:15,250 --> 00:54:16,830
‫حان وقت الطعام!‬

719
00:54:23,090 --> 00:54:25,260
‫أين "بسمة"؟‬

720
00:54:25,340 --> 00:54:27,800
‫قالت إنها تتبع حمية.‬

721
00:54:43,020 --> 00:54:46,610
‫كم أشعر بالانتعاش!‬

722
00:54:55,410 --> 00:54:57,660
‫الأسطوانة ليست هنا.‬

723
00:54:58,580 --> 00:55:00,540
‫لم نبحث بعد إلّا في نصف الأسطوانات.‬

724
00:55:07,130 --> 00:55:09,130
‫"(الهايكو): أغسطس"‬

725
00:55:43,340 --> 00:55:45,000
‫"(الهايكو): مارس‬
‫ربيع (الكيغو)"‬

726
00:55:45,090 --> 00:55:49,010
‫"المعنى الحقيقي للـ(كيغو):‬
‫صغار الرنكة و(يامازاكورا)"‬

727
00:55:58,980 --> 00:56:00,020
‫"يامازاكورا"…‬

728
00:56:01,310 --> 00:56:02,650
‫"مسابقة في (الهايكو)"‬

729
00:56:02,730 --> 00:56:06,020
‫"تنمو أوراق (يامازاكورا) لتزهر الكرز،‬

730
00:56:06,110 --> 00:56:10,400
‫ومن لديهم أسنان بارزة‬
‫يُسمّون بـ(يامازاكورا)."‬

731
00:56:28,710 --> 00:56:32,260
‫أتساءل كيف ماتت "ساكورا".‬

732
00:56:40,020 --> 00:56:41,980
‫نشر "تشيري" قصيدة "هايكو" جديدة.‬

733
00:56:49,230 --> 00:56:50,490
‫"(يامازاكورا)‬

734
00:56:50,990 --> 00:56:55,490
‫تعجبني الأوراق التي تخبئينها"‬

735
00:57:00,580 --> 00:57:05,330
‫"(يامازاكورا)‬
‫تعجبني الأوراق التي تخبئينها"‬

736
00:57:29,610 --> 00:57:32,530
‫"15 أغسطس"‬

737
00:58:23,290 --> 00:58:25,330
‫لم نجدها هنا.‬

738
00:58:36,510 --> 00:58:39,090
‫شكرًا يا "تشيري".‬

739
00:58:39,180 --> 00:58:40,470
‫وشكرًا لك يا "بسمة".‬

740
00:58:58,150 --> 00:58:59,910
‫"ياسويوكي"؟‬

741
00:58:59,990 --> 00:59:02,950
‫هل يمكنك أن تحزم الثلاجة والمروحة أيضًا؟‬

742
00:59:04,620 --> 00:59:07,080
‫- سأحزمها غدًا.‬
‫- شكرًا.‬

743
00:59:25,270 --> 00:59:26,390
‫ليست هنا.‬

744
00:59:34,070 --> 00:59:35,360
‫بئسًا.‬

745
00:59:44,950 --> 00:59:46,410
‫ما الخطب؟‬

746
00:59:56,960 --> 00:59:57,960
‫ها هي.‬

747
00:59:58,050 --> 00:59:59,920
‫"(يامازاكورا)"‬

748
01:00:00,880 --> 01:00:02,470
‫- وجدناها.‬
‫- أجل.‬

749
01:00:03,010 --> 01:00:04,300
‫"(يامازاكورا)"‬

750
01:00:04,390 --> 01:00:06,390
‫أبي!‬

751
01:00:09,270 --> 01:00:12,190
‫"(يامازاكورا)"‬

752
01:00:17,900 --> 01:00:18,940
‫"ساكورا".‬

