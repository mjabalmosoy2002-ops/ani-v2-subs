1
00:00:02,050 --> 00:00:06,240
بُني هذا البناء كقلعةٍ في الأصل في القرن الرابع عشر

2
00:00:06,240 --> 00:00:10,200
تمّت إعادة ترميمه كنُزل في بدايات القرن العشرين

3
00:00:10,200 --> 00:00:13,480
لكنَّ مالكه مات قبل عشر سنين وتمَّ إغلاقه

4
00:00:13,760 --> 00:00:18,300
بلغ هذا كارز واستغلّه كمسكن للاحتماء من الشمس

5
00:00:18,890 --> 00:00:20,970
يتربّص بهم العدو بالقرب هنا

6
00:00:21,510 --> 00:00:26,050
لكنَّ جوجو وليزا ليزا لا علم لديهم البتَّة بتركيب أو طبيعة المكان

7
00:01:57,560 --> 00:02:02,050
الفصل 21: خطَّة المئة ضدَّ اثنين

8
00:01:58,560 --> 00:01:59,560
سحقاً

9
00:01:59,940 --> 00:02:02,400
ما خطب أنسجة العناكب المريبة هذه؟

10
00:02:02,400 --> 00:02:03,820
قوموا بتنظيف المكان على الأقل

11
00:02:04,400 --> 00:02:08,570
نحن مكتئبون بما يكفي بدون هذا

12
00:02:08,820 --> 00:02:11,910
لكن، نظراً إلى آثار الدماء المتواصلة هذه

13
00:02:12,530 --> 00:02:16,120
لا بدَّ أنَّ وامو تلقّى ضرراً بليغاً بالـ هامون

14
00:02:17,750 --> 00:02:21,080
لم يُهزم سيزر ببساطة بالفعل

15
00:02:27,550 --> 00:02:29,930
لا يمكننا منحه وقتاً للمعالجة

16
00:02:30,550 --> 00:02:33,260
سندخل يا معلّمة ليزا ليزا

17
00:02:36,560 --> 00:02:37,470
ما الخطب؟

18
00:02:37,470 --> 00:02:38,640
حـ... حسناً

19
00:02:39,560 --> 00:02:42,810
مقبض هذا الباب مريب حقّاً

20
00:02:43,020 --> 00:02:46,230
مريب كما لو أنّي أصافح يد رجل ضخم

21
00:02:46,980 --> 00:02:48,320
لستُ باباً

22
00:02:48,320 --> 00:02:49,150
ماذا؟

23
00:02:50,240 --> 00:02:54,370
ما الذي تبحث عنه؟ أخبرتُك أنّي لست باباً

24
00:02:58,750 --> 00:02:59,750
مصّاص دماء

25
00:03:01,700 --> 00:03:02,540
احترس يا جوجو

26
00:03:07,210 --> 00:03:07,960
جوجو

27
00:03:09,340 --> 00:03:15,050
بدون ذلك السلاح، كنتُ لأمزّق وجهك كالقناع

28
00:03:17,260 --> 00:03:19,600
اسمي هو وايرد بيك

29
00:03:20,680 --> 00:03:24,020
قتلتُ محبوبتي خنقاً وكنتُ مجرماً مطارداً

30
00:03:24,020 --> 00:03:28,610
لكنَّ سيّدي كارز عثر عليّ وقام بضمّي
كتابع له عبر قناع حجري

31
00:03:29,150 --> 00:03:30,740
أنا مخلصٌ له

32
00:03:30,900 --> 00:03:36,490
لن أسمح لكما بالدخول إلى مكان راحة أسيادي

33
00:03:36,910 --> 00:03:43,250
أولئك الأوغاد، بدؤوا أخيراً بتحويل البشر إلى طعام لهم

34
00:03:45,630 --> 00:03:47,000
يا إلهي

35
00:03:47,210 --> 00:03:50,760
أنتَ حثالة عليه الموت والاتّجاه نحو الجحيم سريعاً

36
00:03:50,760 --> 00:03:54,760
هَلُمّ، سأساعدك وأدفعك إلى هناك

37
00:03:56,300 --> 00:03:57,050
ليزا ليزا؟

38
00:04:01,350 --> 00:04:05,910
جميلة، حسناء، يا لها من بشرة جميلة

39
00:04:05,910 --> 00:04:09,780
عانقيني، سأمتصُّ دمائك من بشرتكِ البيضاء

40
00:04:10,110 --> 00:04:12,430
لستُ في مزاج حسن

41
00:04:12,750 --> 00:04:17,310
لا أودُّ سماع أيّ كلمات أو رؤية وجه وضيع مثلك

42
00:04:17,830 --> 00:04:20,870
لكن حاول عناقي إن كنتَ تريد

43
00:04:21,620 --> 00:04:24,330
إن كنتَ متحضّراً للموت

44
00:04:30,000 --> 00:04:30,920
مسنّنات

45
00:04:31,510 --> 00:04:33,170
كانت هذه إذاً

46
00:04:33,550 --> 00:04:36,050
لم يكن ما رأيته أصابعاً، بل مسنّنات

47
00:04:36,340 --> 00:04:39,970
يبدو كما لو أنَّ شعره بأكمله تحوّل إلى مسنّنات من جسده

48
00:04:40,260 --> 00:04:44,160
لا يروقني عندما تعبث معي النساء

49
00:04:45,640 --> 00:04:48,360
سيتعيّن عليّ عقابكِ في هذه الحالات

50
00:04:51,110 --> 00:04:53,160
سأعانقكِ بشدَّة

51
00:04:53,400 --> 00:04:55,710
سأعاقبكِ عناقاً

52
00:04:55,710 --> 00:04:58,160
هذا سيّئ، إنَّه أسرع مما يبدو عليه

53
00:05:02,490 --> 00:05:03,510
الوشاح؟

54
00:05:03,510 --> 00:05:07,330
فهمتُ الأمر، ستجعل ليزا ليزا من الوشاح سلاحاً عبر الـ هامون

55
00:05:08,920 --> 00:05:10,380
ما خطب هذا الوشاح؟

56
00:05:12,340 --> 00:05:14,090
قمتِ بإيثاقي هكذا؟

57
00:05:14,370 --> 00:05:15,880
إنَّه مدعاة للضحك

58
00:05:17,180 --> 00:05:19,260
ها هو اختفى

59
00:05:20,550 --> 00:05:21,950
ماذا؟

60
00:05:21,950 --> 00:05:23,460
إلى أين تذهبين؟

61
00:05:23,460 --> 00:05:25,390
هيّا بنا يا جوجو، لندخل

62
00:05:26,100 --> 00:05:27,010
أجل

63
00:05:28,600 --> 00:05:31,980
تحرّكات ليزا ليزا بملاسة الحرير حقّاً

64
00:05:32,270 --> 00:05:34,650
كما لم تهدر أيّ جهد

65
00:05:34,940 --> 00:05:37,230
أنتِ، لا تتجاهليني

66
00:05:37,780 --> 00:05:38,780
أنتَ هناك

67
00:05:38,780 --> 00:05:42,790
ألا تتّفق بأنَّ امرأة مثلها يجب أن تُعاقب بشدّة؟

68
00:05:42,790 --> 00:05:45,690
كلا يا رفيق، أمرك انتهى

69
00:05:45,690 --> 00:05:48,180
أنت من سيُعاقب

70
00:05:48,180 --> 00:05:50,460
لقد أصابتك بالـ هامون

71
00:05:52,380 --> 00:05:53,670
لا تكن سخيفاً

72
00:06:06,770 --> 00:06:08,850
بالإمكان الاعتماد عليها

73
00:06:08,850 --> 00:06:14,440
ظننتُ أنَّها لا تصلح للقتال لأنَّها امرأة، لكنَّ تحرّكاتها مغايرة عن المبتدئين أمثالي

74
00:06:14,440 --> 00:06:15,860
لقد أدهشني هذا

75
00:06:16,110 --> 00:06:17,990
كما يُتوقّع من معلّمة الـ هامون

76
00:06:19,570 --> 00:06:20,860
بالمناسبة يا جوجو

77
00:06:21,160 --> 00:06:26,370
لم تحتسَ العقار المضاد الذي تمكّن سيزر من الحصول عليه بعد؟

78
00:06:27,460 --> 00:06:28,370
أجل

79
00:06:28,580 --> 00:06:29,370
تقصدين هذا؟

80
00:06:29,830 --> 00:06:30,710
لمَ؟

81
00:06:31,380 --> 00:06:33,960
سأشربه بعد هزيمة وامو

82
00:06:35,380 --> 00:06:39,880
ليس هذا الحَلق مرتبطاً بوعدي مع وامو الآن

83
00:06:40,970 --> 00:06:45,850
تغيّر إلى وعدٍ لـ سيزر منّي بالنجاة والنصر في هذا القتال

84
00:06:46,560 --> 00:06:50,980
ليزا ليزا، هل ستحملينه لأجلي حتّى تحين تلك اللحظة؟

85
00:06:52,520 --> 00:06:53,480
كلّا

86
00:06:54,110 --> 00:06:56,360
عليك الاحتفاظ به

87
00:06:57,400 --> 00:06:59,670
لا أدري ما الذي قد يجري لي

88
00:07:03,280 --> 00:07:08,290
مع توغّلهم أكثر وراء أثر دماء وامو، أصبح يصغر تدرّجاً

89
00:07:08,540 --> 00:07:13,960
كان جوجو وليزا ليزا مدركان كلّياً للمعنى الكامن وراء هذا

90
00:07:14,290 --> 00:07:17,460
كانت جروحه قيد المعالجة

91
00:07:21,160 --> 00:07:22,090
أتى؟

92
00:07:34,400 --> 00:07:35,610
كنتُ بانتظارك

93
00:07:36,610 --> 00:07:39,860
يبدو أنَّك نموتَ بالفعل

94
00:07:40,280 --> 00:07:43,740
...أيّها الوغد... قتلتَ سيزر

95
00:07:44,450 --> 00:07:47,660
اهدأ يا جوجو، راقب الأرض بدل وامو

96
00:07:47,990 --> 00:07:51,370
لا حاجة للقلق، أنا صافِ الذهن

97
00:07:51,870 --> 00:07:55,290
لقد لاحظتُها، تقصدين آثار الأقدام على الأرض؟

98
00:07:55,790 --> 00:07:57,130
هناك آثار أخرى

99
00:07:57,500 --> 00:08:01,050
أي أنَّها لـ كارز! أين تختبئ؟

100
00:08:01,630 --> 00:08:03,970
أظهر نفسك

101
00:08:06,430 --> 00:08:09,100
أجل، آثار شخصين وحسب

102
00:08:09,470 --> 00:08:12,510
رغم شعورك بأضعاف التنفّسات بهذه الغرفة

103
00:08:13,980 --> 00:08:16,960
هذه هي إذاً؟ فهمتُ الأمر

104
00:08:16,960 --> 00:08:20,820
هدوء راجح ونظرة فاحصة بالنسبة لامرأة

105
00:08:20,940 --> 00:08:25,570
لا بدَّ أنَّ هذا يبرهن كيف تحوّل جوجو وسيزر إلى محاربين أصيلين في فترة قصيرة

106
00:08:26,410 --> 00:08:29,790
ومقدرتكِ على الإحساس بهذه التنفّسات الخافتة

107
00:08:30,290 --> 00:08:32,870
يبرهن على علو كعبكِ بين محاربي الـ هامون

108
00:08:37,640 --> 00:08:38,880
ماذا؟

109
00:08:39,260 --> 00:08:42,420
أيّها الأوغاد، جميعكم مصّاصي دماء؟ سحقاً

110
00:08:45,380 --> 00:08:47,860
لا ردَّة فعل، يا لريبتهم

111
00:08:56,350 --> 00:08:57,560
كارز

112
00:09:00,480 --> 00:09:04,820
مُنحنا الحياة الأبديّة من سيّدنا كارز مسبقاً، نحن المُختارون

113
00:09:04,820 --> 00:09:06,780
أجل، مئة ضدَّ اثنان

114
00:09:07,030 --> 00:09:12,120
حالما يعطينا سيّدنا الأمر، سنمزّقكما الاثنين إرباً يا جوجو

115
00:09:24,510 --> 00:09:27,430
لا جدوى من هذا، مئة ضدَّ اثنين

116
00:09:27,430 --> 00:09:30,410
ليزا ليزا، لا فرصة لنا هنا

117
00:09:31,010 --> 00:09:32,810
انتظر سيّدي كارز

118
00:09:34,040 --> 00:09:37,600
عاهدتُ هذا الرجل على قتاله في روما

119
00:09:37,940 --> 00:09:40,310
كما أودُّ الانتقام لسيّدي إيشديشي

120
00:09:40,900 --> 00:09:42,820
أرجو أن تسمح لي بقتاله

121
00:09:43,360 --> 00:09:44,360
مرفوض

122
00:09:44,360 --> 00:09:48,360
جلُّ هدفنا هو الاستحواذ على حجر إيجا الأحمر

123
00:09:49,110 --> 00:09:50,620
لا تنسَ هذا يا وامو

124
00:09:51,780 --> 00:09:52,580
حاضر

125
00:09:53,160 --> 00:09:57,680
هذا صحيح، لا جدوى، لم أعد أملك رغبةً في القتال

126
00:09:57,680 --> 00:10:00,040
أنا على يقين من قدرتي على هزيمتك

127
00:10:00,040 --> 00:10:05,760
لكن، حتّى لو انتصرتْ... مع وجود كلّ مصاصي الدماء هؤلاء

128
00:10:06,010 --> 00:10:09,480
مصيري الموت سواءً فزتُ أم خسرت

129
00:10:09,480 --> 00:10:13,260
مع اختلال الكفّة هكذا الآن  لا جدوى سوى الاستسلام

130
00:10:13,510 --> 00:10:15,980
أعلن استسلامي

131
00:10:18,350 --> 00:10:20,860
سحقاً، رأيتم كلَّ شيء؟

132
00:10:21,190 --> 00:10:25,110
ظننت أنّي سأقدر على القضاء عليهم جميعاً عبر إرسال الـ هامون بالخيط

133
00:10:25,610 --> 00:10:27,400
حسناً، اقتلاهما

134
00:10:27,400 --> 00:10:31,120
إن قتلتَنا، لن تحصل على الحجر الأحمر مطلقاً

135
00:10:31,530 --> 00:10:32,280
تمهّلوا

136
00:10:32,740 --> 00:10:34,120
ماذا قلتِ أيّتها المرأة ؟

137
00:10:34,330 --> 00:10:38,910
لستُ ساذجةً كي آتي إلى هنا وبحوزتي الحجر الأحمر

138
00:10:39,160 --> 00:10:43,880
إن لم أكن أنا أو جوجو موجودين بمكانٍ ما في وقت معيّن

139
00:10:44,460 --> 00:10:47,300
ستفجّر القنبلة الموقوتة الحجر الأحمر

140
00:10:52,010 --> 00:10:54,510
كفّي عن الحيل أيتها المرأة

141
00:10:55,010 --> 00:10:59,060
أتظن أنَّكم ستقدرون على العثور على ذاك المكان قبل فوات الأوان؟

142
00:10:59,350 --> 00:11:04,520
سيكون الانفجار صغير المجال، لكن قويّاً بما يكفي لإضرار الحجر الأحمر

143
00:11:07,230 --> 00:11:11,030
هل أمر القنبلة الموقوتة حقيقيّ؟ لم أعلم بهذا

144
00:11:11,030 --> 00:11:13,320
لكنّي سأتبعها في هذا

145
00:11:13,490 --> 00:11:15,750
أجل، كما قالت

146
00:11:15,750 --> 00:11:18,330
"إن مُتنا وقتها "انفجار" انفجار

147
00:11:18,540 --> 00:11:21,960
حتّى ولو، لا أقدر على ترككم تعودون هكذا

148
00:11:22,540 --> 00:11:24,460
لديّ عرض هنا

149
00:11:25,260 --> 00:11:28,510
بالإمكان أن يتواجه جوجو ووامو في قتال فردي

150
00:11:28,820 --> 00:11:32,470
بينما أنا وكارز، سنواجه بعضنا البعض

151
00:11:33,180 --> 00:11:36,970
وسأرهن الحجر الأحمر... على القتالين

152
00:11:37,570 --> 00:11:38,220
ماذا؟

153
00:11:39,350 --> 00:11:42,870
سيحصل المنتصر بأيّة حال على الحجر الأحمر والمستقبل أمامه

154
00:11:43,270 --> 00:11:44,860
الأمر واضح الآن

155
00:11:45,520 --> 00:11:48,830
من سيستحوذ على الحجر الأحمر هم نحن أم أنتم؟

156
00:11:49,360 --> 00:11:53,450
من سينجو؟ العشيرة السوداء من العامود أم نحن البشر؟

157
00:11:53,720 --> 00:11:54,950
...هذه المرأة

158
00:11:56,120 --> 00:11:57,030
وامو؟

159
00:11:58,080 --> 00:12:00,000
دافعتني الضحكات سيّدي كارز

160
00:12:01,240 --> 00:12:02,250
هذا ممتاز

161
00:12:02,570 --> 00:12:07,250
إنَّها تجعلني أبدو كالطفل عندما يتعلّق الأمر بالحِيل

162
00:12:08,170 --> 00:12:10,630
أيّتها المرأة، لا بأس بجرأتك

163
00:12:11,150 --> 00:12:14,010
حسناً إذاً، سأقبل لأجل الحجر الأحمر

164
00:12:14,480 --> 00:12:15,840
لكن لا يصيبكِ الغرور

165
00:12:16,550 --> 00:12:18,850
لا صباح لكما

166
00:12:19,340 --> 00:12:24,600
كنا في موضع أقلّية مهول، لكنَّها دفعت بنا إلى تكافؤ المستوى

167
00:12:24,820 --> 00:12:27,870
في هذه الحالة، لا أمامي سوى أن أفعلها

168
00:12:41,200 --> 00:12:45,080
نحن بحاجة لزمان ومكان ملائمين لأجل القتال

169
00:12:45,790 --> 00:12:47,960
وامو، أدلِ برأيك

170
00:12:49,420 --> 00:12:52,670
الليلة القمر مكتمل، ذاك هو وقتنا

171
00:12:53,010 --> 00:12:54,320
...أمّا المكان

172
00:12:54,320 --> 00:12:58,850
سيكون عند سفح بيز بيرنينا، 15 كم
جنوب شرق المكان هنا

173
00:12:59,890 --> 00:13:03,520
توجد هناك حلقة حجرية أثريّة "تُدعى "كعب الهيكل العظمي

174
00:13:03,980 --> 00:13:08,900
إنَّها ساحة تلاطمت فيها أقدار الكثير من المحاربين

175
00:13:09,650 --> 00:13:10,980
حلقة حجرية؟

176
00:13:11,530 --> 00:13:15,700
أنت، لا يحقُّ لكما اختيار المكان وفق ما يحلو لكما

177
00:13:16,240 --> 00:13:19,410
وامو، هذا اختيار مشوّق

178
00:13:20,030 --> 00:13:22,200
وأيضاً... بخصوص الحجر

179
00:13:22,540 --> 00:13:23,200
جوجو

180
00:13:23,700 --> 00:13:29,000
اجلب الحجر الأحمر إلى الحلقة الحجرية مع منتصف الليلة

181
00:13:29,670 --> 00:13:32,260
وعليك نزع جهاز التفجير ذاك

182
00:13:32,550 --> 00:13:35,420
ستظلُّ المرأة هنا كرهينة

183
00:13:51,480 --> 00:13:52,360
ليزا ليزا

184
00:13:52,610 --> 00:13:55,070
يتّخذان التدابير كيلا نقدر على الهرب

185
00:13:55,530 --> 00:13:59,740
هذا شرط طبيعي، جوجو، اذهب لجلب الحجر

186
00:13:59,950 --> 00:14:01,450
لا تقلق بشأني

187
00:14:02,160 --> 00:14:04,870
أجل، سأحضر إلى مكان النزال حتماً

188
00:14:05,200 --> 00:14:06,460
ثقي بي

189
00:14:07,000 --> 00:14:08,080
أعرف هذا

190
00:14:14,010 --> 00:14:15,090
...سيزر

191
00:14:25,430 --> 00:14:30,660
نوعاً ما، عشتُ أفكّر بأمر نفسي وحسب حتّى البارحة

192
00:14:30,860 --> 00:14:35,030
لكنَّ هناك شعوراً صغيراً مشتعلاً ينمو داخلي

193
00:14:36,320 --> 00:14:38,280
أهذا التعاطف؟

194
00:14:39,410 --> 00:14:43,880
سحقاً، كم وددتُ قتل أولئك الأوغاد

195
00:14:43,880 --> 00:14:50,080
لأجل سيزر، مشّينا، وليزا ليزا وبمشاعر الجميع على عاتقيّ

196
00:14:50,880 --> 00:14:52,590
سأقاتل بضراوة

197
00:15:03,140 --> 00:15:06,630
كما ظننت، لم تنصب عليه أيّة قنابل

198
00:15:06,630 --> 00:15:10,690
ليزا ليزا، يا لجرأتكِ لتنفيذ تلك الحيلة في خضّم ذاك المأزق

199
00:15:12,230 --> 00:15:16,750
حسناً، هل أجلب معي غِير ملابس داخلية أيضاً؟

200
00:15:19,780 --> 00:15:22,160
ما خطب هذه الصورة؟

201
00:15:22,840 --> 00:15:24,870
أليست جدَّتي إرينا؟

202
00:15:25,030 --> 00:15:27,760
لمَ بحوزة ليزا ليزا صورة كهذه؟

203
00:15:29,290 --> 00:15:31,420
ما خطب هذه؟

204
00:15:32,460 --> 00:15:35,290
مايو 1889؟

205
00:15:35,660 --> 00:15:37,180
إنّها قبل خمسين سنة

206
00:15:37,780 --> 00:15:40,720
هذا الشاب هو سبيدواغون

207
00:15:41,790 --> 00:15:42,970
جدَّتي إرينا

208
00:15:43,340 --> 00:15:47,060
وستريتس يحمل طفلاً

209
00:15:47,960 --> 00:15:54,020
ليزا ليزا... لا أعرف شيئاً عن حياتها أو ماضيها بالفعل

210
00:15:54,400 --> 00:15:56,820
لمَ تملك هذه الصور؟

211
00:16:41,240 --> 00:16:43,010
حسناً، إنَّها الحقيقية

212
00:16:43,260 --> 00:16:44,990
سنفي بوعدنا

213
00:16:45,900 --> 00:16:48,160
ستكون مواجهتين فرديتين

214
00:17:06,010 --> 00:17:10,600
بعد رؤيتك لهذه الصور، يبدو أنَّه
يتعيّن عليّ إخبارك

215
00:17:11,100 --> 00:17:14,310
كلا، كنتُ أنوي إخبارك قبل القتال

216
00:17:14,640 --> 00:17:15,940
من أنتِ بالضبط؟

217
00:17:18,400 --> 00:17:19,690
قبل خمسين عاماً

218
00:17:20,530 --> 00:17:25,950
فقدت السيّدة إرينا زوجها جوناثان جوستر على متن سفينة في المحيط الأطلسي

219
00:17:26,030 --> 00:17:27,740
أي جدُّك أنت

220
00:17:28,700 --> 00:17:32,950
بذاك الوقت، أنقذت السيّدة إرينا
حياة طفلة رضيعة

221
00:17:33,500 --> 00:17:35,000
تلك كانت أنا

222
00:17:35,370 --> 00:17:37,710
الرضيعة بتلك الصورة هي أنا

223
00:17:38,900 --> 00:17:40,210
تمهّلي لحظة

224
00:17:40,550 --> 00:17:41,960
كان هذا قبل خمسين عاماً

225
00:17:42,260 --> 00:17:45,200
إن كنتِ رضيعةً قبل خمسين سنة

226
00:17:45,200 --> 00:17:48,770
أنتِ، كم عمركِ بالضبط؟

227
00:17:50,360 --> 00:17:51,850
خمسون عاماً؟

228
00:17:54,200 --> 00:17:57,600
إن كنتِ بخمسين عاماً... هذا يعني

229
00:17:58,160 --> 00:17:59,480
عـ... عجوز

230
00:18:02,780 --> 00:18:04,810
...أليس كذلك؟ طبيعياً

231
00:18:05,460 --> 00:18:08,490
تبدين في أواخر العشرينات كيفما نظرت إليكِ

232
00:18:08,990 --> 00:18:13,410
الـ هامون طاقة حيوية... يُقال بأنَّها تحفظ الشباب

233
00:18:14,000 --> 00:18:19,250
لكن... لا عجب، بدى لي أنَّ طباعكِ وتصرّفاتكِ ليسا ظريفين على الإطلاق

234
00:18:20,060 --> 00:18:22,520
بمقدوري رؤية تجاعيد من فجوة النظّارات الشمسية

235
00:18:24,050 --> 00:18:25,550
أو كانت مخيّلتي وحسب

236
00:18:27,510 --> 00:18:30,260
حسناً، حضّروا الحلبة

237
00:18:30,260 --> 00:18:31,100
أشعلوا النار

238
00:18:40,150 --> 00:18:42,820
لا يبدو أنَّنا في محلٍّ للحديث

239
00:18:43,650 --> 00:18:45,570
لكن علينا القيام بهذا

240
00:18:46,120 --> 00:18:49,450
جذوري لها علاقة بك

241
00:18:49,450 --> 00:18:50,450
جذور؟

242
00:18:51,160 --> 00:18:53,870
فقدتُ والديّ بسبب القناع الحجري

243
00:18:54,620 --> 00:19:00,250
عندما أنقذتني السيّدة إرينا في صغري  كانت حاملةً برضيع وقتها

244
00:19:00,770 --> 00:19:02,710
فقام ستريتس بالاعتناء بأمري

245
00:19:04,160 --> 00:19:06,330
ماذا قلتِ؟ ستريتس؟

246
00:19:06,720 --> 00:19:09,750
تلقّيتُ تعاليم الـ هامون منه

247
00:19:11,070 --> 00:19:14,060
كما تلقّيتُ الحجر كذلك

248
00:19:14,380 --> 00:19:18,560
أي أنَّ ستريتس هو والدكِ المُتبنّي؟

249
00:19:19,390 --> 00:19:24,930
أشعر بالأسى لأنَّ ستريتس فقد صوابه على ذاك النحو عندما باغته أمر الكِبر بالسن

250
00:19:25,520 --> 00:19:30,660
جوجو، حقيقة قتلك له تخلط من دوّامة المشاعر بداخلي

251
00:19:31,400 --> 00:19:33,530
لكن لا بدَّ أنَّه كان قدراً محتوماً

252
00:19:36,540 --> 00:19:38,160
يا للهول

253
00:19:38,540 --> 00:19:41,960
إنَّها مشاعر مختلطة بالفعل

254
00:19:42,880 --> 00:19:45,340
يا للروابط الغريبة

255
00:19:45,920 --> 00:19:50,680
ليزا ليزا... كانت تحمل على عاتقيها
ماضياً حزيناً أيضاً

256
00:19:51,430 --> 00:19:53,970
جوجو، يبدو بأنَّ حديثنا قد انتهى

257
00:19:54,600 --> 00:19:55,930
ما خطب هذا الاهتزاز؟

258
00:20:05,820 --> 00:20:09,820
أتوا، بعد قدومهم بإمكاننا بدء القتال أخيراً

259
00:20:13,740 --> 00:20:14,820
هـ... هذا

260
00:20:21,330 --> 00:20:25,380
ابتعدوا، ابتعدوا، ليست مسؤوليتي إن دُهستم

261
00:20:25,590 --> 00:20:28,300
ما هؤلاء الديناصورات؟

262
00:20:28,300 --> 00:20:30,630
كلا، خيول؟ أهم خيول؟

263
00:20:32,760 --> 00:20:35,390
سيّدي كارز، سيّدي وامو، ابتعدا

264
00:20:35,390 --> 00:20:37,730
لم أعد أقدر على ترويضهم

265
00:20:39,810 --> 00:20:41,640
سيّدي وامو، ابتعد

266
00:20:50,360 --> 00:20:51,820
خيول مطيعة

267
00:20:54,780 --> 00:20:59,290
دفعنا بالمسنَّنات في أدمغة هذه الخيول  فأصبحوا خيولاً مصّاصةً للدماء

268
00:20:59,290 --> 00:21:01,660
خـ... خيول مصّاصة دماء؟

269
00:21:03,620 --> 00:21:09,800
الآن، في هذه الحلبة، سيتواجه وامو وجوجو في نزال عربات تقليدي

270
00:21:12,590 --> 00:21:13,800
نزال عربات؟

271
00:21:14,130 --> 00:21:16,850
نزال عربات مميت كما في روما القديمة

272
00:21:16,850 --> 00:21:20,930
ستسابق على متن هذه العربة وتقاتل بينما تقود

273
00:21:21,140 --> 00:21:28,310
سيّدي وامو أم جوجو؟ من سيسقط أوّلاً، أو يُغلب أثناء القيادة؟

274
00:21:28,310 --> 00:21:30,130
الخسارة تعني الموت

275
00:21:30,130 --> 00:21:31,780
تحضَّر يا جوجو

276
00:21:31,940 --> 00:21:34,200
قوة هذه الخيول مصّاصة الدماء تفوق العادية 150 ضعفاً

277
00:21:34,350 --> 00:21:37,410
التحكّم بهم أمر شاق حتّى بالنسبة لسيّدي وامو

278
00:21:37,410 --> 00:21:38,940
أنتم، تمهّلوا هناك

279
00:21:38,940 --> 00:21:41,830
لا أمانع خوض نزال العربات أو أيّاً يكن

280
00:21:41,830 --> 00:21:45,710
لكن خيول مصّاصة دماء؟ إنَّهم بصفِّكم أنتم

281
00:21:46,120 --> 00:21:50,130
لا حاجة لقلقك، الزِمام معدٌّ لتوصيل الـ هامون

282
00:21:50,460 --> 00:21:52,710
سيتحكّم وامو بالخيول مسخّراً قوّته

283
00:21:52,960 --> 00:21:56,270
بينما ستقدر أنت على التحكّم بهم بالـ هامون

284
00:21:57,400 --> 00:21:59,940
صدقاً؟ يبدوان متوحّشين

285
00:22:00,370 --> 00:22:01,850
هذا خطر، احترسي

286
00:22:07,310 --> 00:22:09,980
هكذا إذاً، بالإمكان التحكّم بهم بالقليل من الـ هامون

287
00:22:10,820 --> 00:22:14,030
!وامو! وامو! وامو

288
00:22:25,040 --> 00:22:26,620
وامو

289
00:22:26,620 --> 00:22:28,790
اختار أسلوباً قديماً لهذا النزال

290
00:22:28,790 --> 00:22:30,920
هذا يعني أنَّه جاد

291
00:22:31,090 --> 00:22:36,590
مما يبرهن أنَّه لا يدخل هذا القتال للتسلية أو يقلِّل من شأنه

292
00:22:37,300 --> 00:22:41,020
عليك التغلّب عليه يا جوجو  لا سبيل أمامنا سوى النصر

293
00:22:41,500 --> 00:22:42,560
لا تعادل

294
00:22:45,520 --> 00:22:46,560
وامو

295
00:22:49,900 --> 00:22:52,820
لم أشرب هذا العقار المضاد بعد

296
00:22:53,070 --> 00:22:57,240
عاهدتُ سيزر على ألّا أفعل حتّى أقتلك

297
00:22:57,490 --> 00:23:02,130
لا بدَّ أنَّ هذا العهد سيمنحني قوّةً لم يسبق لي امتلاكها

298
00:23:08,960 --> 00:23:11,460
قاتل رفقتي يا سيزر

299
00:23:19,130 --> 00:23:20,930
ليبدأ نزال العربات

300
00:23:23,660 --> 00:23:25,600
يُتبع

301
00:24:55,610 --> 00:24:57,610
الحلقة التالية

302
00:24:58,170 --> 00:25:02,300
!وامو! وامو

303
00:25:08,440 --> 00:25:10,480
!ابدءا

304
00:25:08,620 --> 00:25:11,070
الفصل 22: محارب أصيل