!يا لغطرستك

218
00:11:51,900 --> 00:11:53,770
!أنت متغطرسة يا فو

219
00:11:53,770 --> 00:11:55,060
!ما معنى هذا؟

220
00:11:55,060 --> 00:11:56,690
!أنت خادمتي

221
00:11:55,060 --> 00:11:58,400
.أتضور جوعًا. حان وقت الدم

222
00:11:56,690 --> 00:11:58,400
!هذا غير صحيح

223
00:11:58,400 --> 00:12:00,420
أتفهميني؟

224
00:12:01,150 --> 00:12:03,320
ماذا؟

225
00:12:01,790 --> 00:12:02,460
ما الأمر؟

226
00:12:03,320 --> 00:12:05,780
!الدم... ليس هنا

227
00:12:06,580 --> 00:12:08,580
.نسينا جلبه

228
00:12:29,600 --> 00:12:31,350
.تاليًا، أحوال الطقس

229
00:12:31,900 --> 00:12:36,510
الإعصار الذي نشأ في بحر الفلبين
،أمس يستمر في زيادة قوته

230
00:12:36,510 --> 00:12:39,150
.ويعبر الآن خلال منطقة جزيرة فخواتيكية

231
00:12:58,510 --> 00:13:00,870
!من هنا جميعًا

232
00:13:03,300 --> 00:13:05,330
!مرحى

233
00:13:05,330 --> 00:13:07,930
!حسنًا، لنبدأ الإعداد

234
00:13:13,620 --> 00:13:15,090
!أريد دمًا

235
00:13:15,090 --> 00:13:17,040
!ليس لدينا

236
00:13:17,040 --> 00:13:18,530
!لماذا؟

237
00:13:18,530 --> 00:13:19,740
!اهدأن

238
00:13:19,740 --> 00:13:21,150
!لا أستطيع

239
00:13:21,150 --> 00:13:23,370
!دم! أين الدم؟

240
00:13:23,850 --> 00:13:26,780
لماذا لا نصور جزئيّة اليوم الآن؟

241
00:13:31,070 --> 00:13:33,910
!اليوم الثالث في الجزيرة النائية

242
00:13:33,910 --> 00:13:35,790
...اليوم، حسنًا

243
00:13:36,370 --> 00:13:37,080
!توكاغي

244
00:13:37,080 --> 00:13:39,450
!آسفة، ولكنّي سأعود

245
00:13:46,260 --> 00:13:48,410
.أحتاج للدم

246
00:13:49,120 --> 00:13:50,500
!صحيح! هاتفي

247
00:13:50,500 --> 00:13:51,680
!سأتصل بالنجدة عبر هاتفي

248
00:13:52,650 --> 00:13:53,770
!لا توجد خدمة

249
00:13:55,080 --> 00:13:56,240
...أحتاج

250
00:13:56,240 --> 00:13:59,270
!العودة إلى المنزل

251
00:13:59,530 --> 00:14:03,570
!الصالة ستتلقى آلات جديدة
!طلبت من إيتشيجو-كن أن يضبط دبابيسها

252
00:14:03,570 --> 00:14:06,400
!تشانس أكايشي ينتظرني

253
00:14:15,410 --> 00:14:16,580
!صحيح! طوف

254
00:14:32,220 --> 00:14:34,560
!لا

255
00:14:35,540 --> 00:14:37,880
.نفدت أفكاري

256
00:14:37,880 --> 00:14:40,600
.دم... أريد دمًا

257
00:14:40,600 --> 00:14:42,000
...إن غنيت

258
00:14:42,000 --> 00:14:46,300
!حتّى إن غنيت أغنية، لا أستطيع تشتيت نفسي

259
00:14:46,300 --> 00:14:48,070
!سنكون بخير

260
00:14:48,510 --> 00:14:51,230
!ستلاحظ ماساكي الأمر وتأتي لإنقاذنا

261
00:14:51,230 --> 00:14:53,050
!لنركز على تسجيل الفيديو القادم حتّى ذلك الوقت

262
00:14:53,050 --> 00:14:53,740
حسنًا؟

263
00:14:55,540 --> 00:14:56,760
.ليف-ساما

264
00:14:57,640 --> 00:14:59,080
!ليف-ساما

265
00:15:10,440 --> 00:15:11,340
!حسنًا

266
00:16:03,720 --> 00:16:07,920
.وصلت توكاغي إلى وضع الطاقة المنخفضة أيضًا أخيرًا

267
00:16:13,030 --> 00:16:14,280
!تم التحقق من الضوء

268
00:16:14,660 --> 00:16:15,780
!تم التحقق من زاوية الكاميرا

269
00:16:16,120 --> 00:16:17,530
!لنبدأ

270
00:16:17,910 --> 00:16:20,520
!صباح الخير من منتصف الليل

271
00:16:20,520 --> 00:16:23,060
...مايوناكا بانش

272
00:16:31,560 --> 00:16:34,000
.تم التحقق من الإعداد

273
00:16:45,470 --> 00:16:51,140
.لا شيء سار كما خططت في نهاية المطاف

274
00:16:51,940 --> 00:16:55,460
!ولكن عليّ أن أنهي المهمة على الأقل

275
00:16:57,400 --> 00:16:58,880
!أنا ليف

276
00:16:58,880 --> 00:17:02,460
!انتهينا من تحدي النجاة لسبعة أيّام أخيرًا

277
00:17:02,460 --> 00:17:04,460
!أحسنتن العمل جميعًا

278
00:17:06,210 --> 00:17:09,680
.وقعت العديد من المصائب هذه المرة

279
00:17:10,590 --> 00:17:13,370
.كانت توجد أمور كثيرة أردت فعلها

280
00:17:13,840 --> 00:17:18,210
.لنعتبرها أهدافًا مستقبليّة الآن

281
00:17:18,210 --> 00:17:20,900
.سنستعد بشكل أفضل في المرة القادمة

282
00:17:21,450 --> 00:17:24,060
...لتحدي نجاة مثالي أكثر

283
00:17:26,680 --> 00:17:28,200
...تحدي نجاة

284
00:17:31,330 --> 00:17:34,650
.حسنًا إذًا، إلى اللقاء جميعًا

285
00:17:38,550 --> 00:17:42,660
مرّ أسبوع، لذا لماذا لم يعدن بعد؟

286
00:17:43,060 --> 00:17:45,660
...علينا أن نسجل تعليقاتهن النهائيّة أيضًا

287
00:17:46,890 --> 00:17:48,190
!مؤلم

288
00:17:48,190 --> 00:17:49,620
!ما هذا؟

289
00:17:50,840 --> 00:17:53,090
.هذه مؤونتهم

290
00:17:53,090 --> 00:17:54,490
!ماذا؟

291
00:17:54,490 --> 00:17:57,090
!أيعني أنّهن لم يأخذوها؟

292
00:17:57,340 --> 00:18:00,950
أيمكنهن النجاة دون دم لأسبوع؟

293
00:18:07,690 --> 00:18:09,460
...أشعر بالبرد

294
00:18:11,180 --> 00:18:15,510
.ليتني تمكنت من تذوق دم ماساكي قبل النهاية

295
00:18:17,030 --> 00:18:18,720
...ماساكي

296
00:18:37,840 --> 00:18:38,830
ماذا؟

297
00:18:39,690 --> 00:18:40,720
أستطيع العودة؟

298
00:18:44,690 --> 00:18:46,380
!أخيرًا

299
00:18:46,380 --> 00:18:48,850
!سأتمكن من شرب دم ماساكي

300
00:18:48,850 --> 00:18:51,610
!حان وقت الأكل

301
00:18:54,460 --> 00:18:55,390
.ليف

302
00:18:55,910 --> 00:18:56,860
!ليف

303
00:18:57,940 --> 00:18:59,320
كيف حال؟

304
00:19:00,200 --> 00:19:02,800
مـ-ماذا تفعلين هنا؟

305
00:19:02,800 --> 00:19:03,950
!ما هذا السؤال؟

306
00:19:03,950 --> 00:19:05,910
!أنتن من نسيتن أخذ الدم

307
00:19:05,910 --> 00:19:08,320
.يا لكن من مُتعِبات

308
00:19:08,320 --> 00:19:09,410
!شيغي؟

309
00:19:09,410 --> 00:19:13,150
أتعرفين كم من المتعب الطيران
!حاملةً بشريّة عابرة البحر؟

310
00:19:13,860 --> 00:19:14,790
!أنت

311
00:19:15,200 --> 00:19:17,330
!لا فائدة من البكاء في المرة القادمة

312
00:19:17,330 --> 00:19:18,800
!مـ-ماذا؟

313
00:19:18,800 --> 00:19:20,480
!لا تختلقي الأمور

314
00:19:20,480 --> 00:19:21,890
!أيّتها الكاذبة المقلوبة

315
00:19:21,890 --> 00:19:25,390
.أنت من كنت تبكين حول احتمالية موتهن

316
00:19:25,390 --> 00:19:26,670
.لا علاقة لانقلابي بالأمر

317
00:19:26,670 --> 00:19:28,180
!أريد المزيد من الدم

318
00:19:28,180 --> 00:19:30,330
!شربت الكثير

319
00:19:30,330 --> 00:19:32,180
!توقفن عن القتال

320
00:19:32,180 --> 00:19:34,440
.لـ-لم أبك

321
00:19:33,710 --> 00:19:36,490
!مهلك! انتظري دورك

322
00:19:38,630 --> 00:19:39,440
ليف؟

323
00:19:43,720 --> 00:19:45,090
ما الخطب؟

324
00:19:45,090 --> 00:19:49,180
.لم أتمكن من التصوير كما ينبغي إطلاقًا

325
00:19:49,180 --> 00:19:51,340
!لا أستطيع مواجهتك

326
00:19:51,340 --> 00:19:53,080
.اهدئي

327
00:19:53,080 --> 00:19:56,000
!لا أستطيع أن أريك أيّ شيء ممّا صورنا

328
00:19:56,000 --> 00:19:57,540
!ألقيه! ارميه

329
00:19:57,540 --> 00:19:58,850
!آسفة

330
00:19:58,850 --> 00:20:00,510
.شاهدته بالفعل

331
00:20:01,650 --> 00:20:03,210
.بشكل سريع

332
00:20:03,210 --> 00:20:05,180
!لماذا شاهدته؟

333
00:20:05,180 --> 00:20:06,660
.كان ممتعًا

334
00:20:06,660 --> 00:20:07,560
ماذا؟

335
00:20:07,870 --> 00:20:11,130
،قطع شجرة بيديك العاريتين لن يكون مجديًا

336
00:20:11,130 --> 00:20:15,280
...ولكن إشعال النار بسرعة، وشرب ماء غير معالج

337
00:20:15,280 --> 00:20:17,490
.تمكنتن من نصب خيمة أيضًا

338
00:20:17,490 --> 00:20:18,270
أليس كذلك؟

339
00:20:18,270 --> 00:20:20,410
!ولكن لا نستطيع استخدام أغلبه

340
00:20:20,410 --> 00:20:23,490
.إنّه غير منطقي، ويتجاوز الإمكانيات البشرية

341
00:20:23,490 --> 00:20:26,670
.توجد خدع تحريريّة كثيرة يمكننا استخدامها لذلك

342
00:20:26,670 --> 00:20:29,300
.ينبغي للمحتوى أن يكون مثيرًا فحسب

343
00:20:29,300 --> 00:20:33,180
.ولكن كانت هناك سمكة مارلين وثم الإعصار

344
00:20:33,180 --> 00:20:35,420
.النصف الثاني كان عبارة عن ظروفنا ونحن نصف أموات

345
00:20:35,420 --> 00:20:37,740
.كانت كارثة تلو الأخرى

346
00:20:37,740 --> 00:20:39,580
.لا بأس بالكوارث

347
00:20:39,580 --> 00:20:41,880
.يندر أن تكونون نصف أموات

348
00:20:41,880 --> 00:20:43,410
!راودكن الحظ

349
00:20:43,410 --> 00:20:44,690
!ليس كذلك

350
00:20:44,690 --> 00:20:46,970
!لا تستطيعين صنع فيديو مناسب هكذا

351
00:20:47,250 --> 00:20:48,930
.بلى

352
00:20:49,300 --> 00:20:49,940
ماذا؟

353
00:20:50,270 --> 00:20:53,850
،ربما لم تسر الأمور كما خططتِ

354
00:20:53,850 --> 00:20:56,160
.ولكن من الواضح أنّك بذلت كلّ ما لديك

355
00:20:56,160 --> 00:20:59,390
.كلّ هذا ينتج عنه فيديو مناسب

356
00:20:59,800 --> 00:21:01,780
.مثل تلك المرة مع الثوم

357
00:21:02,250 --> 00:21:03,690
.قمتِ بعمل مناسب

358
00:21:04,610 --> 00:21:06,490
...إذًا أنا

359
00:21:06,490 --> 00:21:07,590
.لا بأس

360
00:21:08,420 --> 00:21:10,170
...أهذا يعني

361
00:21:10,770 --> 00:21:12,950
أستطيع شرب دمك؟

362
00:21:12,950 --> 00:21:14,510
.هذا ليس ما اتفقنا عليه

363
00:21:14,510 --> 00:21:15,460
.حسنًا

364
00:21:17,330 --> 00:21:21,180
.رغم ذلك، يبدو أنّكن بحاجة لإدارتي في نهاية المطاف

365
00:21:21,180 --> 00:21:23,530
!عليّ أن أبذل جهدي وأحرّر الفيديو

366
00:21:24,030 --> 00:21:25,310
...أنا

367
00:21:25,310 --> 00:21:27,220
!سأساعدك بتحريره

368
00:21:27,220 --> 00:21:29,760
!سأبذل جهدك معك

369
00:21:31,530 --> 00:21:35,230
.سأحذرك... تحتاجين مهارة عالية للتحرير

370
00:21:35,530 --> 00:21:39,520
.إلّم تكوني جادة، سألغي ذلك الوعد بخصوص دمي للأبد

371
00:21:39,520 --> 00:21:40,690
!لا بأس

372
00:21:40,690 --> 00:21:42,730
!أنا جادة حين يتطلب الأمر

373
00:21:47,070 --> 00:21:48,490
!يسرني وجودك

374
00:23:25,880 --> 00:23:26,550
!أنا ليف

375
00:23:26,550 --> 00:23:27,200
.ماساكي

376
00:23:27,200 --> 00:23:28,190
!نسينا الدم

377
00:23:28,190 --> 00:23:29,260
!إنّه أهم شيء

378
00:23:29,260 --> 00:23:31,040
!هذا خاطئ

379
00:23:31,040 --> 00:23:31,430
ماذا؟

380
00:23:31,430 --> 00:23:33,220
...أهم شيء بالنسبة لي هي ماساكي

381
00:23:33,220 --> 00:23:33,660
.حسنًا، حسنًا

382
00:23:33,660 --> 00:23:34,330
!دمها

383
00:23:34,330 --> 00:23:35,550
!هذا في نهاية المطاف

384
00:23:35,550 --> 00:23:37,180
!"الحلقة القادمة: "أمنية إيتشيكو

385
00:23:37,180 --> 00:23:39,270
!أريد شرب دمك