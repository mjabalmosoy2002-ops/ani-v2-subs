199
00:13:24,480 --> 00:13:26,620
من النّسل الشّيطانيّ القديم

200
00:13:27,360 --> 00:13:29,490
وأنا شينوبي الأميرة سين، من سلالة

201
00:13:29,490 --> 00:13:31,370
كانت تخدمها لأجيال

202
00:13:31,370 --> 00:13:34,320
ماذا؟ على ذكر الأمر، كنتِ في شيمابارا

203
00:13:35,030 --> 00:13:36,020
!كيميغيكو-سان

204
00:13:36,910 --> 00:13:38,190
الآن قد فهمت

205
00:13:38,720 --> 00:13:40,870
،شعرتُ بأنّكِ كنتِ ودودة زيادة عن اللّزوم

206
00:13:40,870 --> 00:13:43,640
لكن كان هدفكِ هو معلومات عن الشّينسينغومي

207
00:13:45,960 --> 00:13:48,140
منذ القِدَم، الأقوياء في كلّ عصر

208
00:13:48,140 --> 00:13:49,900
يضعون نُصب أعينهم على قوّة الشّياطين

209
00:13:49,900 --> 00:13:51,730
ويسعون للحصول عليها

210
00:13:53,920 --> 00:13:59,840
عموماً، تكره عشائرُ الشّيطان القتال
والتورُّط في حروب البشر

211
00:14:00,390 --> 00:14:04,420
ومع الوقت، بدأتْ تتفرّق وتعيش في الخفاء

212
00:14:05,080 --> 00:14:07,000
،ازداد اختلاطهم مع البشر

213
00:14:07,000 --> 00:14:10,170
فأمسى الآن قلّة قليلة من العِرق النّقيّ

214
00:14:10,940 --> 00:14:13,240
مثلكِ ومثل كازاما تقصدين؟

215
00:14:13,440 --> 00:14:16,160
...أجل. في العوالم الغربيّة، عشيرة كازاما

216
00:14:16,160 --> 00:14:19,740
،وفي الشّرق، عشيرة يوكيمورا

217
00:14:19,740 --> 00:14:20,920
هما أكبر عائلتين شيطانيّتين

218
00:14:22,150 --> 00:14:24,560
...سمعتُ أنّ عائلة يوكيمورا قد انقرضت، لكن

219
00:14:24,890 --> 00:14:27,880
...مـ-مهلاً لحظة! ما تقصدينه إذاً

220
00:14:27,880 --> 00:14:29,690
!تشيزورو شيطانة؟

221
00:14:31,040 --> 00:14:33,690
...يبدو أنّكم فكّرتُم في شيء

222
00:14:40,350 --> 00:14:41,310
!جرحها

223
00:14:42,160 --> 00:14:44,200
...كان عميقاً جدّاً، لكن

224
00:14:45,170 --> 00:14:47,450
هذا لأنّني... شيطانة

225
00:14:47,940 --> 00:14:49,070
هكذا إذاً

226
00:14:49,430 --> 00:14:54,070
دمها هو السّبب الّذي جعلَني أسترجع
حواسي في تلك اللّيلة

227
00:14:55,070 --> 00:15:00,720
،لو أنجب ذوو الدّم النّقيّ أو القويّ مولوداً
فإنّه سيُنجب شيطاناً أكثر قوّة حتّى

228
00:15:00,990 --> 00:15:02,830
هذا هو هدف كازاما إذاً

229
00:15:02,830 --> 00:15:03,720
أجل

230
00:15:04,120 --> 00:15:06,140
،إذا هاجمكم كازاما بجدّية

231
00:15:06,140 --> 00:15:08,090
فستعجزون تماماً أمامه

232
00:15:08,090 --> 00:15:11,730
أيّتها الأميرة سين، أليست كلمة
عجز" مُبالغ بها؟"

233
00:15:12,130 --> 00:15:15,210
نحن الشّينسينغومي، ذئاب ميبورو

234
00:15:15,210 --> 00:15:18,230
مواجهتنا شيطاناً أو اثنين لا تردعنا إطلاقاً

235
00:15:18,510 --> 00:15:21,750
يجدر بكم أن تعرفوا حجم قوّة كازاما الكاملة

236
00:15:21,750 --> 00:15:25,240
غير أنّنا قد نتمكّن من حماية تشيزورو

237
00:15:25,850 --> 00:15:28,740
ما يعني بأنّكم "قد" لا تتمكّنون من حمايتها، صحيح؟

238
00:15:30,480 --> 00:15:32,750
يوكيمورا-كن، ماذا عنكِ؟

239
00:15:32,900 --> 00:15:33,690
ماذا؟

240
00:15:33,690 --> 00:15:35,420
:ينبغي أن تقرّري

241
00:15:35,420 --> 00:15:38,180
هل ستذهبين معهما أم ستبقين هنا؟

242
00:15:38,180 --> 00:15:40,070
!لا تقل هذا يا كوندو-سان

243
00:15:40,360 --> 00:15:41,880
اصمت يا شينباتشي

244
00:15:44,030 --> 00:15:44,760
...أنا

245
00:15:52,750 --> 00:15:53,770
سأبقى هنا

246
00:15:55,300 --> 00:15:56,460
...تشيزورو-تشان

247
00:15:58,090 --> 00:15:59,780
أنا آسفة يا سين-تشان

248
00:16:00,050 --> 00:16:01,710
تشيزورو-تشان، هل يُعقَل أن يكون هناك

249
00:16:01,710 --> 00:16:03,930
سبب ما يجعلكِ لا ترغبين في مغادرة هذا المكان؟

250
00:16:03,930 --> 00:16:04,850
ماذا؟

251
00:16:04,850 --> 00:16:06,910
كوجود شخص هنا تُحبّينه على سبيل المثال

252
00:16:07,850 --> 00:16:09,410
...ا-المعذرة

253
00:16:11,230 --> 00:16:13,560
سموّ الأميرة، هل أنتِ متأكّدة من هذا؟

254
00:16:15,020 --> 00:16:17,280
تشيزورو-تشان، لا تنسي

255
00:16:17,280 --> 00:16:19,420
أنا حليفتكِ، اتّفقنا؟

256
00:16:20,450 --> 00:16:21,610
شكراً لكِ

257
00:16:25,410 --> 00:16:27,930
تهانينا حراستك للضّريح الإمبراطوريّ

258
00:16:28,360 --> 00:16:29,930
شكراً جزيلاً لك

259
00:17:06,030 --> 00:17:08,200
غاية في السّهولة

260
00:17:13,120 --> 00:17:14,460
ما خطبهم؟

261
00:17:14,460 --> 00:17:16,350
أعتذر لو تأخّرت

262
00:17:16,590 --> 00:17:20,940
نحن، فيلق الرّازيتسو، سنكون خصومكم
أنتم الشّياطين

263
00:17:22,090 --> 00:17:25,720
يبدو أنّ هؤلاء صُنِعوا نتيجة ذلك البحث

264
00:17:26,100 --> 00:17:27,860
مُزيّفون، أليس كذلك؟

265
00:17:28,060 --> 00:17:30,770
!هيّا! أطلِقوا عنان كامل قوّتكم

266
00:17:35,690 --> 00:17:36,750
!ما هذا؟

267
00:17:50,580 --> 00:17:53,140
،إذا ضربتموهم في أعضائهم الحيويّة
سيُقضى عليهم

268
00:17:53,460 --> 00:17:57,140
!كم من الفظيع صنع وحوش كهؤلاء

269
00:17:57,420 --> 00:17:59,960
صدقت الأقوال. الشّياطين الحقيقيّة
شرِسون بالفعل

270
00:18:04,800 --> 00:18:06,190
أدع هذا الأمر كما

271
00:18:07,300 --> 00:18:08,650
أظنّني لا أملك خياراً

272
00:18:11,140 --> 00:18:12,160
!يوكيمورا-كن

273
00:18:12,430 --> 00:18:13,390
!لا تفعلي

274
00:18:13,390 --> 00:18:15,070
--أمر نائب القائد ألّا تغادري

275
00:18:15,070 --> 00:18:16,810
أنا الوحيدة الّتي يستهدفونها

276
00:18:16,810 --> 00:18:18,610
!لا أريد أن يقاتل الآخرون لأجلي

277
00:18:20,480 --> 00:18:22,170
أتيتُ لآخذكِ

278
00:18:22,400 --> 00:18:24,110
!ابقي خلفي يا يوكيمورا-كن

279
00:18:31,080 --> 00:18:32,240
!شيمادا-سان

280
00:18:32,870 --> 00:18:35,000
--أرجوك أوقف هذا! يكفي

281
00:18:48,810 --> 00:18:51,200
!سانّان-سان! سوف أتولّى هذا الرّجل

282
00:18:51,430 --> 00:18:53,700
!لا تغترّ بنفسك يا فتى

283
00:19:00,690 --> 00:19:01,760
!تشيزورو

284
00:19:02,650 --> 00:19:03,830
!أطلِق سراح تشيزورو

285
00:19:04,990 --> 00:19:06,840
هل تحاول أخذها بالقوّة؟

286
00:19:07,450 --> 00:19:08,880
مُثير

287
00:19:08,880 --> 00:19:11,240
انتهكتم حدود مقرّ الشّينسينغومي

288
00:19:11,240 --> 00:19:14,120
!لن نسمح بمزيد من السّلوك الأنانيّ

289
00:19:19,830 --> 00:19:22,730
!ما الأمر؟ أراك تتراجع

290
00:19:27,220 --> 00:19:30,360
تكمن قيمة تلك المرأة بحقيقة أنّني سوف أستخدمها

291
00:19:30,660 --> 00:19:33,360
!يمكنك إكمال هذه الرّواية في الجحيم

292
00:19:36,350 --> 00:19:37,120
!هيجيكاتا-سان

293
00:19:37,520 --> 00:19:38,490
استيقظتِ إذاً؟

294
00:19:42,460 --> 00:19:43,340
...حسناً

295
00:19:51,370 --> 00:19:52,280
!توقّف

296
00:19:53,370 --> 00:19:54,640
!يجب ألّا تفعلي هذا

297
00:19:57,790 --> 00:20:00,300
لماذا تصطفّين مع البشر؟

298
00:20:00,300 --> 00:20:02,890
في النّهاية، سوف يخونونكِ

299
00:20:03,420 --> 00:20:06,660
رأيتِ أولئك الشّياطين المُزيّفين
الّذين صنعوهم، أليس كذلك؟

300
00:20:07,050 --> 00:20:09,580
ما الجدوى من الوقوف في صفّ الحمقى

301
00:20:09,580 --> 00:20:12,250
الّذين يصنعون مثل هذه الأشياء؟

302
00:20:12,250 --> 00:20:14,910
ومع ذلك... أؤمن بهم

303
00:20:20,060 --> 00:20:22,190
كازاما. رفضَتْك، صحيح؟

304
00:20:22,190 --> 00:20:24,410
فقدتُ اهتمامي بهذا. لنذهب

305
00:20:26,820 --> 00:20:30,320
إلى اللّقاء يا هارادا. سأقتلك في المرّة المقبلة

306
00:20:30,320 --> 00:20:31,670
!أبقِ رقبتك نظيفة وجاهزة لأجلي

307
00:20:31,820 --> 00:20:34,170
هذا الكلام مردود عليك

308
00:20:37,790 --> 00:20:39,410
تفقّدوا الجرحى

309
00:20:39,410 --> 00:20:40,120
!حاضر

310
00:20:40,120 --> 00:20:41,110
عُلِم

311
00:20:43,540 --> 00:20:44,670
هل أنتِ بخير؟

312
00:20:46,130 --> 00:20:47,420
...هارادا-سان

313
00:20:49,380 --> 00:20:50,880
أبليتِ حسناً

314
00:20:50,880 --> 00:20:54,350
--أنا... لأجلي، الجميع

315
00:20:54,760 --> 00:20:56,570
لا تحزني هكذا

316
00:20:56,760 --> 00:21:00,330
الصّواب هو أن يحمي الرّجلُ المرأة يا تشيزورو

317
00:21:00,600 --> 00:21:02,170
لأنّكِ كنتِ هنا معنا

318
00:21:02,170 --> 00:21:04,830
ازدادت قوّتنا أضعافاً عمّا كانت عليه

319
00:21:05,770 --> 00:21:07,830
...هيجيكاتا-سان وشينباتشي أيضاً

320
00:21:11,200 --> 00:21:15,340
هارادا-سان... والجميع... شكراً جزيلاً لكم

321
00:21:19,580 --> 00:21:21,850
قال هيجيكاتا-سان بأنّكِ أبليتِ حسناً أيضاً

322
00:21:23,080 --> 00:21:24,150
أجل

323
00:23:02,530 --> 00:23:04,800
،بحسب تحرُّكات جماعة إيتو

324
00:23:04,800 --> 00:23:06,280
من الواضح أنّ هناك ميول

325
00:23:06,280 --> 00:23:08,960
للعنف ضدّ الشّينسينغومي

326
00:23:08,960 --> 00:23:10,360
العنف؟

327
00:23:10,800 --> 00:23:13,040
يجب على إيتو أن يموت، نقطة انتهى

328
00:23:13,040 --> 00:23:15,040
الحلقة القادمة
مسار الرّوابط