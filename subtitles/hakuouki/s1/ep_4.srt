1
00:00:15,700 --> 00:00:18,030
كيف هي أحوالكِ يا سموّ الأميرة؟

2
00:00:19,660 --> 00:00:21,910
أشعر وكأنّ الرّياح تناديني

3
00:00:22,830 --> 00:00:23,850
الرّياح؟

4
00:00:25,790 --> 00:00:28,920
ثمّة عاصفة لم تهبّ منذ 300 عام
على وشك أن تهيج

5
00:00:32,060 --> 00:00:32,780
أجل مولاتي

6
00:00:34,180 --> 00:00:37,050
من الآن فصاعداً، انتبهي عندما
تلفتين نحو جهة الرّياح

7
00:00:37,630 --> 00:00:38,960
عُلِم

8
00:02:11,350 --> 00:02:13,220
،نحن، الشّينسينغومي

9
00:02:13,220 --> 00:02:16,490
!سوف نقوم بالتّعبئة لحماية مدينة كيوتو

10
00:02:17,990 --> 00:02:18,530
يوليو، 1864

11
00:02:18,530 --> 00:02:20,970
الحقيقة
يوليو، 1864

12
00:02:19,110 --> 00:02:24,450
،طلبَت آيزو رسميّاً من الشّينسينغومي أن يتحرّكوا

13
00:02:24,450 --> 00:02:26,260
ولذا في هذا اليوم، قاموا بالتّعبئة

14
00:02:26,260 --> 00:02:28,280
من أجل دحر قوّات تشوشو

15
00:02:28,280 --> 00:02:30,000
الّتي سعت لدخول القصر الإمبراطوريّ

16
00:02:39,750 --> 00:02:41,470
!أردتُ الذّهاب أيضاً

17
00:02:42,500 --> 00:02:44,390
!البقاء هنا مُملّ جدّاً

18
00:02:46,270 --> 00:02:48,780
،إذا تركت جروحك تُشفى ببساطة

19
00:02:48,780 --> 00:02:51,440
فيمكنك العودة إلى خطوط الجبهة قريباً

20
00:02:52,060 --> 00:02:54,770
...لكن أنا، من النّاحية الأخرى

21
00:02:58,150 --> 00:03:01,180
!يقصد أن تبقى صامتاً وترتاح

22
00:03:01,180 --> 00:03:01,780
!مؤلم

23
00:03:02,280 --> 00:03:04,770
!ماذا تفعل بالضّبط يا سوجي؟

24
00:03:06,910 --> 00:03:08,790
،إذا تناولتُ هذا الدّواء

25
00:03:08,790 --> 00:03:12,480
فقد أتمكّن من إشهار سيف من جديد

26
00:03:12,790 --> 00:03:17,800
الحلقة 4
أولئك القادمون
من الظّلام

27
00:03:17,800 --> 00:03:22,300
هيئة القضاء فوشيمي
الحقيقة

28
00:03:18,590 --> 00:03:19,630
،باسم كاتاموري ماتسودايرا

29
00:03:19,630 --> 00:03:22,300
لواء آيزو، نحن الشّينسينغومي

30
00:03:22,670 --> 00:03:26,310
!سارعنا إلى هنا بعد أن طُلِب منّا حماية العاصمة

31
00:03:30,100 --> 00:03:33,560
طُلِب"؟ لم يردنا كلام كهذا"

32
00:03:34,670 --> 00:03:37,440
!لكن لدينا رسالة رسميّة

33
00:03:37,860 --> 00:03:38,900
--إذا سلّمتها لرؤسائك

34
00:03:38,900 --> 00:03:41,200
!حتّى لو فعلتُ، سيبقى الجواب نفسه

35
00:03:41,200 --> 00:03:42,320
انصرفوا الآن

36
00:03:42,780 --> 00:03:44,320
!لسنا بحاجة لكم يا ذئاب ميبو

37
00:03:44,820 --> 00:03:47,370
!فظيع. يلقّبهم هكذا

38
00:03:48,600 --> 00:03:52,050
حسناً، هكذا يعاملنا الآخرون

39
00:03:52,050 --> 00:03:52,580
...لكن

40
00:03:52,920 --> 00:03:55,210
تندرج نيابة الشّوغن تحت سلطة كووانا

41
00:03:55,460 --> 00:03:59,590
،إذا تعاملنا مع هذا الأمر بسوء
فقد يلطّخ ذلك سمعة آيزو

42
00:04:02,340 --> 00:04:05,720
حضرة الرّئيس كوندو، لن نصل
إلى نتيجة مع نيابة الشّوغن

43
00:04:05,720 --> 00:04:09,060
لنغادر هيئة القضاء وننضمّ لآيزو

44
00:04:10,140 --> 00:04:11,560
هذا خيارنا الوحيد

45
00:04:11,560 --> 00:04:14,980
أعتقد سيترتّب علينا البحث عن المكان الّذي نصب
فيه حامي مكتب كيوتو المعسكر

46
00:04:34,460 --> 00:04:36,250
أحقّاً ذلك؟

47
00:04:38,460 --> 00:04:39,850
عظيم جدّاً

48
00:04:39,850 --> 00:04:42,880
دع الشّينسينغومي يتوجّهون إلى كوجوغاوارا

49
00:04:43,970 --> 00:04:45,310
عُلِم

50
00:04:49,310 --> 00:04:51,980
!سوف نتوجّه الآن إلى كوجوغاوارا

51
00:04:57,230 --> 00:05:00,530
الشّينسينغومي سوف يتأهّبون معنا
نحن عشيرة آيزو؟

52
00:05:03,070 --> 00:05:05,160
لم يردني أي معلومات حول ذلك

53
00:05:05,410 --> 00:05:08,160
آسف، لكن من فضلكم تحقّقوا من ذلك مع رؤسائنا

54
00:05:08,160 --> 00:05:09,160
من جديد؟

55
00:05:10,570 --> 00:05:12,460
مع رؤسائكم؟

56
00:05:12,460 --> 00:05:15,690
!هم من طلبوا منّا المجيء إلى كوجوغاوارا

57
00:05:15,690 --> 00:05:16,330
مهلاً

58
00:05:16,860 --> 00:05:18,790
أريد التكلّم مع رئيس معسكركم

59
00:05:19,340 --> 00:05:21,250
هلّا أخذتني لِلقائه؟

60
00:05:36,960 --> 00:05:39,050
يبدو أنّ جنود آيزو هؤلاء

61
00:05:39,050 --> 00:05:41,770
هم للدّعم فقط، وليس الجيش الرّئيسيّ

62
00:05:42,150 --> 00:05:44,160
يبدو أنّ جيش آيزو الرّئيسيّ

63
00:05:44,160 --> 00:05:46,420
يحمي بوّابة هاماغوري

64
00:05:46,930 --> 00:05:50,200
هل ستُعامَل الشّينسينغومي كقوّات دعم أيضاً إذاً؟

65
00:05:50,490 --> 00:05:52,120
هذا أمر محتوم

66
00:05:53,160 --> 00:05:55,290
الرّسالة الّتي وردت إلى مقرّاتنا

67
00:05:55,290 --> 00:05:58,210
أفادت بأنّ الوقت من ذهب

68
00:05:58,710 --> 00:06:00,410
،يمكننا التوجّه إلى ساحة المعركة فوراً

69
00:06:00,410 --> 00:06:02,260
إذا استدعت الظّروف ذلك

70
00:06:02,720 --> 00:06:05,090
في الوقت الحالي، هذا كلّ ما يمكننا فعله

71
00:06:06,010 --> 00:06:07,220
...حسناً

72
00:06:08,050 --> 00:06:10,600
...لا أظنّني أستطيع الاسترخاء طوال اللّيل

73
00:06:11,010 --> 00:06:13,350
تشيزورو. تكلّمي فقط إذا أردتِ أن ترتاحي

74
00:06:14,180 --> 00:06:16,350
يمكنني على الأقلّ أن أعيركِ حضني

75
00:06:18,480 --> 00:06:19,850
!سأكون بخير

76
00:06:41,850 --> 00:06:42,380
هيّا بنا

77
00:06:43,040 --> 00:06:43,630
!حسناً

78
00:06:45,420 --> 00:06:47,050
!انتظروا هنا أيُّها الشّينسينغومي

79
00:06:47,470 --> 00:06:49,840
!أُمِرنا بالبقاء متأهّبين

80
00:06:51,390 --> 00:06:54,160
متأهّبين لتوفير الدّعم في حال

81
00:06:54,160 --> 00:06:56,140
!شنَّ أوغاد تشوشو هجوماً

82
00:06:56,390 --> 00:06:59,060
--لـ-لكن الأمر بالتحرّك لم

83
00:06:59,060 --> 00:07:01,650
،إذا كانت لديكم ذرّة كرامة في عملكم

84
00:07:02,360 --> 00:07:04,980
!فسحقاً للأوامر ودعونا نفعل شيئاً

85
00:07:10,570 --> 00:07:12,410
!حسناً! اتبعوهم

86
00:07:32,640 --> 00:07:35,930
...مع ذلك، لا أصدّق بأنّهم أغاروا على قصر الإمبراطور

87
00:07:36,360 --> 00:07:39,060
ما الّذي يفكّر فيه جماعة تشوشو بالضّبط؟

88
00:07:39,850 --> 00:07:42,100
...لم أتوقّع أن يتمادوا إلى هذه الدّرجة

89
00:07:43,210 --> 00:07:46,820
سنُريهم ما يحلُّ بأولئك الّذين يُهدِّدون سلامةَ الإمبراطور

90
00:07:50,060 --> 00:07:53,370
في الفجر، أُرسِلَتْ قوّات من تشوشو
إلى بوّابة هاماغوري

91
00:07:53,780 --> 00:07:57,950
قد تصدّى لها بعض من قوّات آيزو وساتسوما

92
00:07:58,870 --> 00:08:01,040
ساتسوما يساعدون آيزو؟

93
00:08:01,040 --> 00:08:03,250
عجيب كيف تتغيّر الأمور في العالم

94
00:08:03,250 --> 00:08:05,810
هيجيكاتا-سان، يُقال أنّه ما زال هناك

95
00:08:05,810 --> 00:08:08,280
بعض من رجال تشوشو في بوّابة كوغي

96
00:08:08,280 --> 00:08:08,960
ماذا؟

97
00:08:09,460 --> 00:08:10,310
حضرة الرّئيس

98
00:08:10,910 --> 00:08:14,390
الرّجال الّذين يُعتقَد بأنّهم أثاروا هذا
الهجوم على القصر الإمبراطوريّ

99
00:08:14,390 --> 00:08:16,250
متوجّهون إلى تلّة تينّوزان

100
00:08:16,250 --> 00:08:17,470
ماذا نفعل يا توشي؟

101
00:08:19,640 --> 00:08:22,820
هارادا. خذ الرّجال وتوجّهوا إلى بوّابة كوغي

102
00:08:22,820 --> 00:08:24,680
تصدّوا لتشوشو المتبقّيين

103
00:08:24,680 --> 00:08:25,620
حاضر

104
00:08:26,230 --> 00:08:28,940
أريدك ويامازاكي أن تكتشفا ما يجري

105
00:08:28,940 --> 00:08:31,860
وفّرا حماية احتياطيّة لبوّابة هاماغوري
كما هو مُخطَّط في الأصل

106
00:08:32,240 --> 00:08:32,870
حاضر

107
00:08:34,200 --> 00:08:37,130
وأيضاً يا حضرة القائد، لديّ عمل مهمّ لك

108
00:08:38,330 --> 00:08:40,570
هناك قوّات مهزومة أخرى غير تلك

109
00:08:40,570 --> 00:08:41,970
المتوجّهة إلى تلّة تينّوزان

110
00:08:42,330 --> 00:08:44,520
،سيتوجّهون غالباً إلى الدّيار

111
00:08:44,520 --> 00:08:46,130
ليحصلوا على مؤونات بالقوّة
من المتاجر في الطّريق

112
00:08:46,420 --> 00:08:47,250
أجل

113
00:08:47,250 --> 00:08:51,670
لتعقّبهم وقتلهم، سيترتّب علينا مغادرة العاصمة

114
00:08:52,030 --> 00:08:54,760
أنت الوحيد القادر على الحصول
على إذنٍ لنا لفعل ذلك

115
00:08:55,890 --> 00:08:56,940
فهمت

116
00:08:56,940 --> 00:08:59,640
سأبحث عن طريقة لإقناع حامي كيوتو

117
00:09:00,010 --> 00:09:02,390
أجل. غين-سان، اذهب معه

118
00:09:02,930 --> 00:09:04,490
راقب القائد جيّداً واحرص

119
00:09:04,490 --> 00:09:06,010
على ألّا يخرج عن السّيطرة

120
00:09:06,010 --> 00:09:08,150
عُلِم. اعتمد عليّ

121
00:09:10,330 --> 00:09:11,780
!والآخرون، تعالوا معي

122
00:09:15,280 --> 00:09:16,410
!سنذهب إلى تلّة تينّوزان

123
00:09:16,950 --> 00:09:18,030
!حاضر

124
00:09:18,620 --> 00:09:19,250
!حاضرة

125
00:09:19,250 --> 00:09:19,780
!هيّا بنا

126
00:09:25,260 --> 00:09:27,080
أوّلاً، أعتقد يجدر بنا أن نرحّب

127
00:09:27,080 --> 00:09:29,480
بمُمثّلي آيزو كأعضاء في الشّينسينغومي

128
00:09:29,750 --> 00:09:31,960
إن أحببت، يمكنني فعل ذلك بنفسي

129
00:09:32,420 --> 00:09:34,630
،ضبّاطهم الكِبار مُشوّشون الآن

130
00:09:34,630 --> 00:09:37,660
ومن غير المُرجّح أن يراقبوا تحرّكاتنا

131
00:09:38,800 --> 00:09:40,850
حسناً يا يامازاكي-كن، أدع الأمر لك

132
00:09:40,850 --> 00:09:43,390
استدعِني إذا واجهتك أي مشكلة

133
00:09:43,390 --> 00:09:44,220
حاضر

134
00:09:46,270 --> 00:09:47,420
!اخرجوا من هنا

135
00:09:47,420 --> 00:09:49,810
!نحن من آيزو سوف نحمي البوّابة

136
00:09:49,810 --> 00:09:50,990
ماذا قلت؟

137
00:09:50,990 --> 00:09:52,680
!نحن عشيرة ساتسوما من سيحميها

138
00:09:52,680 --> 00:09:53,690
!ماذا؟

139
00:09:54,240 --> 00:09:57,210
آيزو وساتسوما يتشاجران على نَيل المجد

140
00:09:57,210 --> 00:09:58,450
!يا للحماقة

141
00:10:00,480 --> 00:10:03,700
ما هذا إذاً؟ الشّينسينغومي؟

142
00:10:04,080 --> 00:10:06,860
اتستدعي آيزو مجموعة من الحمقى؟

143
00:10:06,860 --> 00:10:09,330
!تعلمون بأنّهم جبناء

144
00:10:09,920 --> 00:10:13,090
أعتقد لا تستطيعون القتال ما لم تعتمدوا على رونين، صحيح؟

145
00:10:14,210 --> 00:10:16,170
لا تستمِعوا لكلامِهم التافه

146
00:10:16,170 --> 00:10:18,340
نفّذوا واجباتكم فحسب

147
00:10:18,340 --> 00:10:20,300
ركِّزوا على مهمّتِنا في تأكيدِ ما يجري

148
00:10:20,640 --> 00:10:21,220
حاضر

149
00:10:21,600 --> 00:10:24,720
!وغد، هل تسخر منّا نحن جنود آيزو؟

150
00:10:35,110 --> 00:10:36,800
!أتريد مواجهتنا؟

151
00:10:40,010 --> 00:10:41,240
لا تفعل

152
00:10:41,760 --> 00:10:44,290
الفارق في المهارة بينكما شاسع

153
00:10:59,090 --> 00:11:00,390
!شـ-شينسينغومي

154
00:11:00,590 --> 00:11:03,660
،حمقى، إذا خطّطتُم لاقتحام القصر الإمبراطوريّ

155
00:11:03,660 --> 00:11:06,390
!فسيترتّب عليكم المرور من خلالي أوّلاً

156
00:11:07,350 --> 00:11:08,390
!وغد

157
00:11:08,950 --> 00:11:11,150
!فليتقدّم أي شخص يريد أن يموت أوّلاً

158
00:11:14,360 --> 00:11:15,580
وصلوا إلى هنا بهذه السّرعة؟

159
00:11:15,580 --> 00:11:16,650
!تراجعوا

160
00:11:18,090 --> 00:11:20,200
!لا تدعوهم يهربون. طاردوهم

161
00:11:31,130 --> 00:11:34,920
ما هذا؟ هل فقدتُم شجاعتكم برصاصة واحدة؟

162
00:11:35,460 --> 00:11:37,420
يجب أن ينالكم الشّرف

163
00:11:37,420 --> 00:11:40,280
سوف أستمتع قليلاً معكم أيُّها الأوغاد

164
00:11:40,280 --> 00:11:42,680
،لا مانع من الاستمتاع

165
00:11:42,970 --> 00:11:45,850
...لكن كونك الوحيد الّذي يحمل سلاحاً قاذفاً

166
00:11:48,900 --> 00:11:49,980
يجعلك جباناً

167
00:12:24,360 --> 00:12:26,850
سبّبتُ لكم بعض المتاعب في نُزُل إيكيدا

168
00:12:28,520 --> 00:12:30,980
هل الجرح في جبينه قد شُفي؟

169
00:12:32,290 --> 00:12:35,440
من فضلك أخبره بأنّني آسف لعدم
قدرتي على أخذ الأمور برويّة

170
00:12:36,480 --> 00:12:39,150
أنت من هزم تودو إذاً؟

171
00:12:39,790 --> 00:12:42,360
فهمت. في هذه الحالة، أمست الأمور مفهومة

172
00:12:43,770 --> 00:12:47,050
تخميني هو أنّك جاسوس ساتسوما، وكنت هناك

173
00:12:47,050 --> 00:12:50,170
في تلك اللّيلة كي ترى ما الّذي
تخطّط تشوشو لفعله

174
00:12:53,770 --> 00:12:56,380
جعلتُم من الشّينسينغومي خصماً لكم

175
00:12:56,380 --> 00:12:59,550
بالنّسبة لي، أنت مجرّد عدوّ أسقط تودو فحسب

176
00:12:59,870 --> 00:13:02,340
لكن، في هذا المكان والزّمان، لا أملك سبباً

177
00:13:02,340 --> 00:13:05,430
لمقاتلتكم أنتم الشّينسينغومي

178
00:13:09,330 --> 00:13:11,980
لا أنوي افتعال مشكلة أيضاً

179
00:13:11,980 --> 00:13:14,900
هدفكم هو بلا شكّ نفس هدفنا

180
00:13:15,070 --> 00:13:18,790
،لكن إذا سبّبتُم لنا مزيداً من الإهانة

181
00:13:18,790 --> 00:13:22,570
فنحن الشّينسينغومي وعشيرة آيزو
لن نتوانى عن التحرُّك

182
00:13:22,950 --> 00:13:26,120
صحيح، أخطأتُ من حيث الكلام والفعل

183
00:13:26,850 --> 00:13:30,080
أعتذر منكم هنا، بصِفتي ممثّل عشيرة ساتسوما

184
00:13:35,460 --> 00:13:38,050
أنا، شخصيّاً، تمنّيتُ تجنُّب القتال

185
00:13:39,300 --> 00:13:41,720
أنا ممتنّ لكم على تراجعكم

186
00:13:42,840 --> 00:13:45,100
اسمي كيوجي أماغيري

187
00:13:45,550 --> 00:13:46,930
،في لقائنا المقبل

188
00:13:46,930 --> 00:13:49,890
عسى أن نكون عوناً لبعضنا الآخر

189
00:13:54,900 --> 00:13:56,600
كيوجي أماغيري

190
00:13:56,600 --> 00:14:00,020
ظننتُ بأنّني إذا هدّدتُه بمهاراتي في السّيف
...فسوف ينسحب، لكن

191
00:14:00,020 --> 00:14:01,530
من يكون؟

192
00:14:01,800 --> 00:14:04,570
يبدو أنّ ساتسوما لديهم بعض الرّجال المزعجين

193
00:14:04,950 --> 00:14:07,620
لعلّنا محظوظون لأنّه اقتنع بالحجّة والمنطق

194
00:14:20,590 --> 00:14:22,630
يبدو أنّك تتحلّى ببعض الجرأة

195
00:14:22,630 --> 00:14:24,890
هل تندفع بهذا الشّكل في العادة؟

196
00:14:24,890 --> 00:14:26,980
استعمال الحيلة لخداع الخصم

197
00:14:26,980 --> 00:14:29,640
هي طريقة مُخزية للمُحارب

198
00:14:32,230 --> 00:14:34,130
اسمي كيو شيرانوي

199
00:14:34,130 --> 00:14:36,650
أريد سماع اسمك أيضاً

200
00:14:36,890 --> 00:14:39,270
،أنا قائد الفرقة 10 من الشّينسينغومي

201
00:14:39,270 --> 00:14:40,570
!سانوسكي هارادا

202
00:14:41,990 --> 00:14:43,400
حان الوقت لأغادر

203
00:14:44,000 --> 00:14:46,280
لنترك الأمور على هذا الحال مؤقّتاً

204
00:14:46,820 --> 00:14:51,120
:سانوسكي هارادا من الشّينسينغومي
!تذكّر وجهي جيّداً

205
00:14:54,930 --> 00:14:56,170
في المرّة المقبلة، سوف أقتلك

206
00:15:01,050 --> 00:15:03,970
مُحال أن أنساك يا كيو شيرانوي

207
00:15:03,970 --> 00:15:07,180
أنت أوّل شخص ينجو من رمحي

208
00:15:13,270 --> 00:15:15,140
هل أنت بخير؟

209
00:15:15,140 --> 00:15:15,940
!اسمح لي

210
00:15:18,030 --> 00:15:20,440
هذه المعاطف تعني بأنّكم الشّينسينغومي، صحيح؟

211
00:15:24,860 --> 00:15:27,490
!هذا الرّجل كان في إيكيدا في تلك اللّيلة

212
00:15:27,490 --> 00:15:28,070
ماذا؟

213
00:15:31,030 --> 00:15:33,330
،تفاجأتُ من رؤيتكم في نُزُل إيكيدا في تلك اللّيلة

214
00:15:33,330 --> 00:15:37,040
...لكن أن أراكم هنا ثانية تبحثون عن مزيد من المجد

215
00:15:37,420 --> 00:15:41,090
يبدو أنّكم أيّها السّاموراي المتخلّفون
لم تتعلّموا درسكم بعد

216
00:15:41,380 --> 00:15:44,500
لا. لا أستطيع حتّى أن أسمّيكم كلاب السّاموراي

217
00:15:45,010 --> 00:15:48,010
إذاً أنت أحد الخصوم الموهوبين الّذين
كانوا هناك في نُزُل إيكيدا؟

218
00:15:49,090 --> 00:15:52,510
محاولاتك في الاستفزاز سيّئة للغاية

219
00:15:54,020 --> 00:15:57,270
سمعتُ بأنّكم كنتُم فرقة موهوبة من الرّونين

220
00:15:57,800 --> 00:16:01,480
لكن رؤيتكم بهذا الوضع الآن يجعل
ما سمعتُه ضرباً من الكذب

221
00:16:02,190 --> 00:16:03,940
كان اسمه "أوكيتا"، صحيح؟

222
00:16:03,940 --> 00:16:07,070
كانت مهارته هزيلة جدّاً لدرجة أنّه
لا يمكن أن يُدعى سيّاف

223
00:16:08,200 --> 00:16:11,030
،إذا أردت التكلُّم بسوء عن سوجي
فافعل ذلك

224
00:16:11,030 --> 00:16:13,790
لكن قبل أن تفعل، أخبرني لماذا
هاجمت هذا الرّجل؟

225
00:16:14,370 --> 00:16:18,790
!إذا لم أقبل سببك، فسوف أقتلك هنا والآن

226
00:16:19,250 --> 00:16:21,920
أنتم الأوغاد لا تفقهون شيئاً عن كرامة السّاموراي

227
00:16:21,920 --> 00:16:24,170
كلّ ما تفكّرن فيه هو كسب الصّيت السيّئ

228
00:16:24,170 --> 00:16:25,800
أنتم كلاب الباكوفو

229
00:16:26,510 --> 00:16:29,000
،لأي سبب تطاردون المهزومين

230
00:16:29,000 --> 00:16:31,550
أولئك الّذين فرّوا من ساحة المعركة سلفاً؟

231
00:16:32,550 --> 00:16:35,290
لِمَ لا تفهمون كبرياء وعزّة نفس
،ساموراي تشوشو

232
00:16:35,290 --> 00:16:40,430
الّذين يسعون للذّهاب إلى تلّة تينّوزان
كمكان لشقّ بطونهم؟

233
00:16:40,430 --> 00:16:42,940
إذاً، لا بأس من زهق روح شخص

234
00:16:42,940 --> 00:16:45,070
باسم كرامة وعزّة شخص آخر؟

235
00:16:47,530 --> 00:16:52,590
أعتقد بأنّ مُقاتلة شخص لحماية كرامة
شخص آخر قد يشوّه كرامة هذا الشّخص

236
00:16:53,530 --> 00:16:54,950
!...هذه المرأة

237
00:16:55,830 --> 00:16:59,060
حسناً، إذا وُجِدت الشّينسينغومي لتحقيق
،أعمال خير عظيمة

238
00:16:59,060 --> 00:17:01,580
فكيف لها أن تدنّس كرامة شخص آخر؟

239
00:17:01,580 --> 00:17:02,580
...هذا

240
00:17:03,030 --> 00:17:06,380
...كنتَ قد أثرتَ فضولي بكلامك بغرور وغطرسة

241
00:17:06,780 --> 00:17:08,550
!إيّاك وإهانة ساحة المعركة

242
00:17:08,550 --> 00:17:09,220
ماذا؟

243
00:17:09,840 --> 00:17:12,340
التّافهون الّذين يشعلون المعارك
من أجل أسبابهم الخاصّة وأنانيّتهم

244
00:17:12,930 --> 00:17:16,100
ثمّ يفقدون عزيمة القتال ويلوذون بالفرار

245
00:17:16,100 --> 00:17:18,600
!لا يستحقّون موت مُحارب مجيد

246
00:17:19,270 --> 00:17:21,230
قطع الرّأس يكفي بالنّسبة للمجرم

247
00:17:21,810 --> 00:17:24,060
شرف شقّ البطن يُهدَر

248
00:17:24,060 --> 00:17:26,980
على خونة يهاجمون القصر الإمبراطوريّ، أليس كذلك؟

249
00:17:27,280 --> 00:17:31,020
تقصد بأنّ إشعال معركة ينبغي

250
00:17:31,020 --> 00:17:32,990
!أن يتساوى مع الاستعداد للموت قتلاً؟

251
00:17:33,200 --> 00:17:36,350
،إن أثرت معركة من دون استعداد للموت

252
00:17:36,350 --> 00:17:38,920
فلست جديراً بأن تكون محارباً

253
00:17:40,090 --> 00:17:42,440
،إذا كانت لديهم عزّة محارب

254
00:17:42,440 --> 00:17:45,800
فعدم تحفّظنا إذاً سيكون هديّة فراقنا، صحيح؟

255
00:17:49,420 --> 00:17:53,360
معتوهون! هل نسيتم دوركم؟

256
00:17:57,680 --> 00:18:02,020
هيجيكاتا-سان، سأقود هذه الوحدة مؤقّتاً

257
00:18:02,270 --> 00:18:03,230
!هيّا بنا

258
00:18:03,230 --> 00:18:04,110
!حاضر

259
00:18:05,060 --> 00:18:06,900
!تشيزورو! اعتني به

260
00:18:07,120 --> 00:18:07,910
!حاضرة

261
00:18:09,280 --> 00:18:10,150
!أوغاد

262
00:18:10,440 --> 00:18:11,400
!ها أنا قادم

263
00:18:12,820 --> 00:18:14,160
!لا تشِح بنظرك عن خصمك

264
00:18:14,660 --> 00:18:17,910
ألا تعرف ما الّذي تعنيه المُبارزة العادلة؟

265
00:18:18,240 --> 00:18:21,290
إذاً يبدو أنّ لديك الاستعداد

266
00:18:21,660 --> 00:18:24,170
الاستعداد بعد أن أسقطت زميلنا على الأقلّ

267
00:18:24,500 --> 00:18:26,630
،أنت ماهر في استعمال فمك على الأقلّ

268
00:18:26,630 --> 00:18:29,760
لكن هل تعتقد حقّاً بأنّك تستطيع قتلي؟

269
00:19:11,300 --> 00:19:13,550
كازاما. هذا يكفي

270
00:19:19,220 --> 00:19:22,410
ينبغي أن تعلم خير معرفة بأنّنا
،نحن من ساتسوما

271
00:19:22,410 --> 00:19:24,950
لا نملك سبباً لمقاتلة الشّينسينغومي

272
00:19:29,570 --> 00:19:31,610
لقد كنتُ أظنُّ كذلك

273
00:19:33,160 --> 00:19:33,990
لكن أرى العكس الآن

274
00:19:43,720 --> 00:19:45,000
هل أنتِ بخير؟

275
00:19:45,000 --> 00:19:46,500
!يمكنني فعلها بمفردي

276
00:19:52,000 --> 00:19:53,200
استعملي هذا

277
00:19:54,300 --> 00:19:55,970
شكراً جزيلاً لك

278
00:20:05,890 --> 00:20:06,790
!هيجيكاتا-سان

279
00:20:11,040 --> 00:20:12,730
...صعدنا إلى هناك، لكن جماعة تشوشو أولئك

280
00:20:13,050 --> 00:20:15,110
نفّذوا سيبّوكو جميعهم

281
00:20:15,280 --> 00:20:16,110
ماذا؟

282
00:20:17,450 --> 00:20:21,120
،انتحروا؟ صحيح أنّهم العدوّ
لكنّها طريقة رائعة للموت

283
00:20:22,150 --> 00:20:23,120
هل هذا أمر جيّد؟

284
00:20:23,540 --> 00:20:25,830
ليس بالنّسبة لنا نحن الشّينسينغومي

285
00:20:26,130 --> 00:20:28,620
أدّوا عملنا بالنّيابة عنّا

286
00:20:29,150 --> 00:20:32,750
،لكن عندما يتعلّق الأمر بمنح الفضل لأهل الفضل

287
00:20:32,750 --> 00:20:34,470
فإنّ "عدوّ" و "صديق" غير مهمّتين

288
00:20:34,470 --> 00:20:35,600
هل تفهمين؟

289
00:20:36,880 --> 00:20:40,940
أجل. أشعر وكأنّني أفهم، ولا أفهم في نفس الوقت

290
00:20:43,350 --> 00:20:45,000
!المدينة! إنّها تشتعل

291
00:20:51,810 --> 00:20:56,150
قادة تشوشو المتطرّفون الّذين هاجموا
القصر الإمبراطوريّ

292
00:20:56,150 --> 00:20:58,830
،قُتِلوا في المعركة أو انتحروا

293
00:20:58,830 --> 00:21:00,590
لكن أولئك الّذين نجوا بحياتهم

294
00:21:00,590 --> 00:21:05,390
أشعلوا حريقاً في العاصمة ليؤدّي
،ذلك إلى تدمير 27،511 منزلاً

295
00:21:05,830 --> 00:21:11,170
و 1،207 مخزناً، و 253 معبداً ومزاراً

296
00:21:11,880 --> 00:21:17,150
وأيضاً خسرنا 22 من 23 عربة من عربات مهرجان غيون

297
00:21:18,630 --> 00:21:20,770
عقب هذا، عومِلت جماعة تشوشو

298
00:21:20,770 --> 00:21:24,300
كمُتمرّدين انقلبوا ضدّ القصر الإمبراطوريّ

299
00:21:24,990 --> 00:21:28,670
وسُمّي هذا لاحقاً بتمرُّد كينمون

300
00:23:01,920 --> 00:23:03,950
...الموت كسيّاف

301
00:23:04,450 --> 00:23:07,700
إذا كنت تطلب منّي أن أستمرّ
،في العيش كجثّة فحسب

302
00:23:08,830 --> 00:23:11,850
فدعني أموت كرجل أرجوك

303
00:23:12,740 --> 00:23:14,960
الحلقة القادمة
سيوف متشابكة