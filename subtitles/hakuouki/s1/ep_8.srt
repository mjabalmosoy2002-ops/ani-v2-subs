1
00:00:05,200 --> 00:00:06,740
!تقدّموا، تقدّموا

2
00:00:06,740 --> 00:00:08,450
!اللّعنة

3
00:00:08,700 --> 00:00:10,020
في الآونة الأخيرة، أمسى هيجيكاتا-سان

4
00:00:10,020 --> 00:00:12,070
أكثر عِناداً من المعتاد

5
00:00:13,860 --> 00:00:15,010
:من يحاول الخروج، يقول

6
00:00:15,010 --> 00:00:18,480
"إلى أين أنت ذاهب؟ لماذا؟"
ألف سؤال! صحيح؟

7
00:00:18,860 --> 00:00:21,610
حسناً، هذا يعني فقط أنّ هيجيكاتا-سان

8
00:00:21,610 --> 00:00:23,160
لديه أمور تدور في رأسه

9
00:00:23,490 --> 00:00:26,900
إذاً ينبغي أن يتكلّم بتلك الطّريقة
مع إيتو-سان والآخرين أيضاً

10
00:00:27,530 --> 00:00:31,000
!"يستفزّني عندما يقول "لا تقولوا لهم شيئاً

11
00:00:31,000 --> 00:00:33,590
شكراً جزيلاً على ذلك اليوم

12
00:00:38,150 --> 00:00:40,290
سايتو. هذه صديقتك؟

13
00:00:40,290 --> 00:00:42,860
...ليست "صديقة" بالمعنى الحرفيّ، لكن

14
00:00:43,320 --> 00:00:46,860
ساعدتني قبل أيّام في الشّارع، أليس كذلك؟

15
00:00:48,110 --> 00:00:49,320
...حسناً

16
00:00:51,280 --> 00:00:53,480
بعبارة أدقّ، كانت تشيزورو-تشان

17
00:00:53,860 --> 00:00:55,990
هل تشيزورو-تشان على ما يُرام؟

18
00:00:55,990 --> 00:00:57,860
تشيزورو-تشان؟

19
00:01:01,110 --> 00:01:04,500
في الحقيقة، لا تبدو على طبيعتها مؤخّراً

20
00:01:04,570 --> 00:01:07,320
...أجل. حدثت أمور كثيرة

21
00:02:44,530 --> 00:02:47,740
تشيزورو، لدينا كودو في صفّنا

22
00:02:48,820 --> 00:02:50,270
تعرفين ما الّذي يعنيه ذلك، صحيح؟

23
00:02:51,570 --> 00:02:56,160
،إذا كان أبي مع الجماعة المُناهضة للأجانب فعلاً

24
00:02:56,160 --> 00:02:58,670
فهذا يعني أنّه عدوّ الشّينسينغومي

25
00:03:01,650 --> 00:03:02,700
أهلاً بعودتكم

26
00:03:04,330 --> 00:03:07,220
تشيزورو، تعرفين الآنسة سين، أليس كذلك؟

27
00:03:07,220 --> 00:03:10,040
...ماذا؟ أجل

28
00:03:10,540 --> 00:03:13,040
قالت أنّ لديها شيء تقوله لكِ

29
00:03:14,670 --> 00:03:19,670
الحلقة 8
أحلام عابرة

30
00:03:20,780 --> 00:03:22,680
تشيزورو-تشان، كُلي

31
00:03:23,210 --> 00:03:25,770
الدّانغو هنا شهيٌّ جدّاً

32
00:03:29,710 --> 00:03:32,500
!معكِ حقّ. إنّه شهيّ

33
00:03:32,800 --> 00:03:35,000
أليس كذلك؟ يسرُّني هذا

34
00:03:35,920 --> 00:03:38,010
كنتُ أفكّر فيكِ منذ ذلك الحين

35
00:03:40,800 --> 00:03:42,970
لا بدّ أنّه من الصّعب أن تعيشي امرأة

36
00:03:42,970 --> 00:03:44,700
وسط جنود ذكور

37
00:03:45,510 --> 00:03:48,550
شعرتُ وكأنّنا نعرف بعضنا منذ زمن بعيد

38
00:03:48,710 --> 00:03:50,400
لم أرغب في ترككِ

39
00:03:50,400 --> 00:03:52,610
رغم ذلك، أعتقد بأنّني مجرّد مُتطفِّلة

40
00:03:53,840 --> 00:03:56,210
شكراً لكِ. لا تقلقي

41
00:03:57,130 --> 00:03:59,170
،لكن يا سين-تشان

42
00:03:59,170 --> 00:04:02,220
كيف عرفتِ منذ البداية بأنّني فتاة؟

43
00:04:02,220 --> 00:04:05,390
عرفتُ بالطّبع. كلتانا فتاتان

44
00:04:06,180 --> 00:04:07,620
...هكذا إذاً

45
00:04:12,020 --> 00:04:14,340
تشيزورو-تشان، أين وُلِدتِ؟

46
00:04:14,340 --> 00:04:16,190
في إيدو

47
00:04:16,310 --> 00:04:18,060
هل من أشقاء؟

48
00:04:18,400 --> 00:04:19,360
...لا

49
00:04:20,080 --> 00:04:21,260
أنتِ مجرّد طفلة

50
00:04:21,740 --> 00:04:23,360
مثلي

51
00:04:25,400 --> 00:04:27,900
على ذكر الأمر، مضى وقت طويل منذ

52
00:04:27,900 --> 00:04:29,770
تكلّمتُ مع فتاة هكذا

53
00:04:39,480 --> 00:04:43,150
،النّاس لا يحبّون الشّينسينغومي في كيوتو كثيراً

54
00:04:43,150 --> 00:04:45,130
لكن بعضهم لُطفاء

55
00:04:45,980 --> 00:04:48,790
،قال لي، "كانت مُحبَطة مؤخّراً

56
00:04:48,790 --> 00:04:52,770
"لذا دردشي معها وحسّني مزاجها

57
00:04:53,060 --> 00:04:54,830
ماذا؟ هارادا-سان من فعل؟

58
00:04:54,830 --> 00:04:58,600
...وعدتُ أن أُبقي ذلك سرّاً

59
00:05:01,650 --> 00:05:03,850
حسناً، سوف أغادر الآن

60
00:05:04,440 --> 00:05:07,660
شكراً لك يا سين-تشان. كان ذلك ممتعاً للغاية

61
00:05:08,650 --> 00:05:09,780
بالنّسبة لي أيضاً

62
00:05:10,200 --> 00:05:13,660
في المرّة القادمة، لنذهب إلى مكان
يحتوي على مانجو لذيذة

63
00:05:13,810 --> 00:05:14,630
!حسناً

64
00:05:16,110 --> 00:05:18,200
!وكذلك أنت يا سيّد. إلى اللّقاء

65
00:05:26,690 --> 00:05:29,560
هارادا-سان... شكراً جزيلاً لك

66
00:05:29,560 --> 00:05:32,620
المعذرة، هل كنتُ كئيبة إلى هذا الحدّ؟

67
00:05:32,620 --> 00:05:37,060
ماذا؟ تبّاً. أخبرَتْكِ تلك الفتاة، صحيح؟

68
00:05:38,320 --> 00:05:39,860
...أنا آسفة

69
00:05:39,860 --> 00:05:42,510
لا عليكِ. لكن يسرّني هذا

70
00:05:42,510 --> 00:05:44,940
تبدين سعيدة لأنّكِ أكلتِ بعضاً من الدّانغو

71
00:05:45,240 --> 00:05:47,330
--ماذا؟! لا، هذا ليس

72
00:05:48,160 --> 00:05:51,950
حسناً، "الحظّ الحسن يزور البيوت السّعيدة،" صحيح؟

73
00:05:52,520 --> 00:05:53,520
!أجل

74
00:05:58,310 --> 00:05:59,230
تفضّل

75
00:05:59,550 --> 00:06:00,730
شكراً لكِ

76
00:06:00,730 --> 00:06:01,940
!أنا نعسان

77
00:06:01,940 --> 00:06:03,230
!طعام

78
00:06:03,480 --> 00:06:04,960
!صباح الخير

79
00:06:11,770 --> 00:06:13,020
أين هيسكي؟

80
00:06:13,770 --> 00:06:15,230
أما زال نائماً؟

81
00:06:15,770 --> 00:06:19,990
يوكيمورا-كن، أنا آسف، لكن هلّا أيقظتِ هيسكي؟

82
00:06:19,990 --> 00:06:21,730
حاضرة

83
00:06:25,740 --> 00:06:27,530
هيسكي-كن، هل أنت مستيقظ؟

84
00:06:28,810 --> 00:06:31,150
هيسكي-كن، سوف أدخل

85
00:06:39,300 --> 00:06:42,650
!إن لم تنهض بسرعة، فلن يبقى شيء من الفطور

86
00:06:43,180 --> 00:06:46,260
حسناً، حسناً، فهمت

87
00:06:47,750 --> 00:06:49,760
تشيزورو، أنت بكامل نشاطكِ

88
00:06:50,940 --> 00:06:51,760
!أجل

89
00:07:02,240 --> 00:07:03,270
!سيَفي هذا بالغرض

90
00:07:04,650 --> 00:07:05,650
انتهيتِ؟

91
00:07:06,810 --> 00:07:10,930
أوكيتا-سان، ماذا تفعل بارتدائك هذا الزيّ؟

92
00:07:10,930 --> 00:07:13,160
تعرّقتُ بينما كنتُ نائماً

93
00:07:13,590 --> 00:07:16,320
استحممتُ سريعاً وكنتُ أجفّف نفسي تحت الشّمس

94
00:07:16,320 --> 00:07:18,480
،مهما كان الطّقس جيّداً

95
00:07:18,480 --> 00:07:21,100
!وشعرك مبتلّ هكذا، ستُصاب بنزلة برد

96
00:07:21,100 --> 00:07:23,420
لا مُشكلة. لا تقلقي

97
00:07:24,110 --> 00:07:25,710
بل هذه مُشكلة

98
00:07:25,710 --> 00:07:27,670
من فضلك اعتنِ بنفسك جيّداً

99
00:07:29,560 --> 00:07:34,260
أنتِ كثيرة الإلحاح. يا له من إحساس غريب بالقلق

100
00:07:34,260 --> 00:07:35,680
أنتِ مثل هيجيكاتا-سان

101
00:07:37,900 --> 00:07:40,590
أخبرتُك، عليك أن تجفّف نفسك
!كما ينبغي أوّلاً

102
00:07:42,930 --> 00:07:44,140
!تشيزورو-تشان

103
00:07:44,140 --> 00:07:46,540
لِمَ تفرضين ذلك على الآخرين؟

104
00:07:46,990 --> 00:07:48,690
بلا سبب

105
00:07:52,940 --> 00:07:55,670
يمكنكِ التوقُّف. لقد جفّ بما يكفي

106
00:07:58,020 --> 00:07:58,900
...أنا

107
00:07:59,890 --> 00:08:02,240
أريد أن أطرح عليكِ سؤالاً

108
00:08:03,530 --> 00:08:06,460
بصراحة... ما رأيكِ بشعري؟

109
00:08:09,380 --> 00:08:10,970
أظنّه يليق بك

110
00:08:11,430 --> 00:08:14,720
حقّاً؟ يسرّني ذلك. شكراً لكِ

111
00:08:15,470 --> 00:08:18,960
الحقيقة هي أنّني كنتُ أحاول
تقليد كوندو-سان بواسطة هذا

112
00:08:18,960 --> 00:08:21,480
صحيح، الطّريقة هي نفسها

113
00:08:22,140 --> 00:08:24,980
لا تخبري أحداً بهذا

114
00:08:25,140 --> 00:08:26,180
حسناً

115
00:08:31,640 --> 00:08:33,610
تأخّرتُم كثيراً في العودة

116
00:08:33,610 --> 00:08:35,250
رغم أنّكم لم تكونوا في دوريّة حراسة

117
00:08:36,600 --> 00:08:39,150
أعتقد أخبرتُكم منذ زمن

118
00:08:39,150 --> 00:08:41,420
أنّ تجاوز فترة منع التجوُّل هو سببٌ للسّيبوكو

119
00:08:42,540 --> 00:08:44,490
أنا من أجبرتُهما على الذّهاب

120
00:08:44,800 --> 00:08:46,930
إنّهما غير مسؤولين إطلاقاً

121
00:08:47,430 --> 00:08:49,630
!اطلب منّي القيام بسيبّوكو وسوف أفعل

122
00:08:52,500 --> 00:08:55,970
شينباتشي، لستَ من يقرّر ذلك

123
00:08:56,290 --> 00:08:57,930
،بغضّ النّظر عن المسؤول

124
00:08:57,930 --> 00:09:00,290
الحقيقة هي أنّكم جميعكم انتهكتم قواعد الفرقة

125
00:09:01,260 --> 00:09:03,170
من فضلك انتظر يا هيجيكاتا-سان

126
00:09:03,170 --> 00:09:04,850
نحن الاثنان كنّا سيّئين أيضاً

127
00:09:04,850 --> 00:09:06,140
--لو قلنا "لنذهب" قبلاً، لكنّا

128
00:09:06,140 --> 00:09:07,650
اذهبوا إلى غرفكم أيُّها الحمقى

129
00:09:08,420 --> 00:09:09,920
سأعطي التّعليمات لاحقاً

130
00:09:14,890 --> 00:09:17,700
سـ-سانو-سان! هل أعجبك هذا؟

131
00:09:17,700 --> 00:09:20,790
هيّا بنا! تشيزورو، تعالي أنتِ أيضاً

132
00:09:21,550 --> 00:09:22,290
حسناً

133
00:09:25,260 --> 00:09:26,780
حسناً، ما قرارك؟

134
00:09:27,320 --> 00:09:29,740
تجاوزتُ مرحلة الخوف من الموت منذ زمن

135
00:09:29,740 --> 00:09:31,740
إذا أردت قولها، فقُلها فحسب

136
00:09:35,710 --> 00:09:37,760
أنت غير راضٍ عن طريقتي في مُعالجة الأمور، صحيح؟

137
00:09:38,480 --> 00:09:42,180
هكذا كنتَ تتصرّف دوماً في أوقات كهذه

138
00:09:43,640 --> 00:09:45,410
...في الحقيقة

139
00:09:45,410 --> 00:09:48,740
،مؤخّراً، كنتَ متساهلاً مع الأعضاء الجدُد

140
00:09:48,740 --> 00:09:50,900
لكن تقسو علينا كثيراً نحن

141
00:09:50,900 --> 00:09:53,120
الّذين كانوا معك منذ البداية، صحيح؟

142
00:09:54,660 --> 00:09:57,240
صحيح أنّنا لسنا خطباء عظماء

143
00:09:57,240 --> 00:09:58,950
ولا نملك أصدقاء رفيعي المستوى

144
00:09:59,900 --> 00:10:03,220
لكن الشّينسينغومي لم تتّسع بهذا الشّكل إلّا لأنّنا

145
00:10:03,220 --> 00:10:05,920
!قاتلنا ونحن على استعداد للموت، أليس كذلك؟

146
00:10:14,050 --> 00:10:15,470
أنا آسف

147
00:10:18,140 --> 00:10:20,540
هناك أشخاص قالوا

148
00:10:20,540 --> 00:10:22,730
بأنّني عاملتُكم جميعاً بدلال زائد

149
00:10:23,760 --> 00:10:26,050
،وبأنّني لا أمنح إلّا المخضرمين مناصب هامّة

150
00:10:26,050 --> 00:10:29,740
وبأنّني أفضّلهم وأقدّم لهم أجراً مميّزاً

151
00:10:29,740 --> 00:10:31,150
ومن هذا الهراء

152
00:10:32,590 --> 00:10:34,820
،لكن كان من الخطأ منّي أن أتمادى هكذا

153
00:10:34,820 --> 00:10:37,240
بإزعاجكم حول هذا وذاك

154
00:10:38,720 --> 00:10:42,120
تبّاً. لستُ ندّاً لك بالفعل

155
00:10:42,890 --> 00:10:44,380
أنا آسف أيضاً

156
00:10:45,620 --> 00:10:47,310
لنذهب ونشرب ثانية قريباً

157
00:10:47,980 --> 00:10:50,270
سأبحث عن ساكي خفيف حتّى أنت

158
00:10:50,270 --> 00:10:51,520
تستطيع شربه يا هيجيكاتا-سان

159
00:10:52,830 --> 00:10:54,380
أسأتَ الفهم

160
00:10:54,850 --> 00:10:58,380
،ليست مسألة أنّني لا أستطيع الشّرب
بل لا أشرب

161
00:11:03,240 --> 00:11:06,140
يوليو، 1866

162
00:11:10,000 --> 00:11:11,650
!ا-الشّوغن

163
00:11:15,150 --> 00:11:17,030
!إيموتشي-ساما قد مات

164
00:11:19,310 --> 00:11:21,980
،بعد ذلك بفترة قصيرة، غزو تشوشو

165
00:11:21,980 --> 00:11:24,250
،والّذي كان قد بدأ بتمرُّد كينمون

166
00:11:24,250 --> 00:11:26,340
أدّى إلى النّتيجة الصّادمة

167
00:11:26,340 --> 00:11:29,240
والّتي هي هزيمة جيش الباكوفو النّكراء

168
00:11:30,500 --> 00:11:34,510
كانت اللّحظة الّتي بدأت فيها
الشّجرة العظيمة الّتي لم تهتزّ

169
00:11:34,510 --> 00:11:36,640
لمئتي وستّين عاماً بالاهتزاز

170
00:11:41,440 --> 00:11:43,140
سبتمبر، 1866

171
00:11:43,670 --> 00:11:45,300
لوح إعلان على جسر سانجو جاء فيه

172
00:11:45,300 --> 00:11:48,860
عشيرة تشوشو هي العدوّ" قد تمّ اقتلاعه"

173
00:11:48,860 --> 00:11:54,370
وأُمِر الشّينسينغومي بحماية اللّوحات

174
00:11:58,540 --> 00:11:59,760
مرحباً بعودتك

175
00:11:59,760 --> 00:12:01,480
أهلاً. ما الأخبار؟

176
00:12:03,140 --> 00:12:05,170
أنا مُرهق لدرجة لا تُحتمَل

177
00:12:05,170 --> 00:12:08,120
لا أمانع أن يشتبك سيفي مع جماعة
...أولئك، لكن

178
00:12:08,800 --> 00:12:11,980
لا أجد حماساً في حماية مجرّد لوح إعلان

179
00:12:11,980 --> 00:12:14,080
الآن بعد أن هُزِمَ جيش الباكوفو بأكمله

180
00:12:14,080 --> 00:12:16,130
،أمام عشيرة تشوشو

181
00:12:16,750 --> 00:12:19,050
لا أعتقد أنّ قتل بعض

182
00:12:19,050 --> 00:12:21,760
الرّونين سوف يغيّر شيئاً

183
00:12:22,090 --> 00:12:26,600
إيتو-سان، لديك شكوى من واجبات الشّينسينغومي؟

184
00:12:26,600 --> 00:12:28,150
أبداً، أبداً

185
00:12:28,150 --> 00:12:29,920
إنّ حماية لوح إعلان

186
00:12:29,920 --> 00:12:32,270
هو واجب مهمّ بحدِّ ذاته

187
00:12:32,460 --> 00:12:35,300
حسناً، ابذلوا قصارى جهدكم

188
00:12:38,210 --> 00:12:41,650
اللّعنة. إنّه شخص مُريب كالعادة

189
00:12:42,240 --> 00:12:44,370
،كثيراً ما أراه يجمع زملاءه

190
00:12:44,370 --> 00:12:46,670
ويهمس في آذانهم

191
00:12:46,670 --> 00:12:49,310
لا أحد يعلم ما الّذي يخطّط له وراء الكواليس

192
00:12:49,840 --> 00:12:52,420
ما الّذي كان كوندو-سان يفكّر فيه

193
00:12:52,420 --> 00:12:54,200
عندما ضمَّ شخصاً مثله؟

194
00:12:54,200 --> 00:12:55,130
هارادا-سان

195
00:12:56,060 --> 00:12:59,020
تذكّرت. حان وقت مناوبتي

196
00:13:00,630 --> 00:13:03,470
بالتّوفيق لك يا هارادا-سان

197
00:13:04,280 --> 00:13:05,330
أجل

198
00:13:30,160 --> 00:13:31,430
من أنتم؟

199
00:13:39,470 --> 00:13:41,160
!تراجعوا، تراجعوا

200
00:13:44,500 --> 00:13:45,710
!انتظر

201
00:13:54,420 --> 00:13:55,380
...تشيزورو

202
00:14:02,540 --> 00:14:05,620
!سانو، أنت تسدي لنا معروفاً حقّاً

203
00:14:05,920 --> 00:14:07,360
لم أتصوّر أبداً

204
00:14:07,360 --> 00:14:10,120
أن تستخدم نقود المُكافأة لدعوتنا جميعاً

205
00:14:10,120 --> 00:14:12,920
،شينباتشي-سان، إذا أردت أن تطري عليه

206
00:14:12,920 --> 00:14:16,010
فينبغي أن تذكر بأنّه حمى لوح الإعلان

207
00:14:16,010 --> 00:14:18,880
!أجل، بالطّبع

208
00:14:19,890 --> 00:14:22,430
!حسناً، سيدفع سانو عن هذه اللّيلة

209
00:14:22,430 --> 00:14:25,760
!اشربوا ما تشاؤون، وانسوا أحزانكم

210
00:14:26,020 --> 00:14:28,390
!وغد، هذا مالي أنا

211
00:14:28,960 --> 00:14:30,920
!سانو-سان، شكراً لك

212
00:14:30,920 --> 00:14:33,250
!سأحرص على الشّرب حتّى الإشباع

213
00:14:33,250 --> 00:14:36,490
لكن ليس وكأنّ جميعنا نستطيع شرب السّاكي

214
00:14:36,490 --> 00:14:37,850
كفى كلاماً كهذا

215
00:14:37,850 --> 00:14:39,520
كُلوا ما تشاؤون من طعام

216
00:14:39,520 --> 00:14:40,650
!أجل! أجل

217
00:14:42,200 --> 00:14:44,660
أنتِ واحدةٌ منّا الآن، لذا شاركي
في المراسم بلا تردُّد

218
00:14:44,910 --> 00:14:46,650
حسناً

219
00:14:59,160 --> 00:15:01,170
تحيّاتي لكم جميعاً

220
00:15:02,160 --> 00:15:04,690
سوف أسلّيكم جميعاً أيّها الرّجال في هذا المساء

221
00:15:05,500 --> 00:15:10,090
اسمي كيميغيكو

222
00:15:10,450 --> 00:15:13,180
آمل أن تستمتعوا بوقتكم

223
00:15:14,500 --> 00:15:15,680
!جميلة للغاية

224
00:15:21,790 --> 00:15:24,320
!السّاكي الفاخر لذيذ حقّاً

225
00:15:24,320 --> 00:15:27,210
!تشعر بحرقة عند الحلق

226
00:15:27,210 --> 00:15:30,970
هيسكي. أراك تشرب فقط، دون أن تأكل

227
00:15:30,970 --> 00:15:32,230
سوف تثمل

228
00:15:32,230 --> 00:15:33,450
!لا مُشكلة لهذا اليوم فقط

229
00:15:33,870 --> 00:15:34,890
!تشيزورو

230
00:15:34,890 --> 00:15:36,380
أنتِ لا تشربين؟

231
00:15:36,380 --> 00:15:37,700
!كيف ستثملين؟

232
00:15:38,250 --> 00:15:40,360
...المعذرة، لا أستطيع الشّرب، لذا

233
00:15:40,360 --> 00:15:42,960
!إذاً كُلي حتّى الإشباع

234
00:15:44,370 --> 00:15:46,810
،سمعتُ بأنّك كشيطان

235
00:15:46,810 --> 00:15:49,370
،يا هيجيكاتا-سان من الشّينسينغومي

236
00:15:49,370 --> 00:15:52,930
،لكن يبدو أنّ هذا مجرّد ادّعاء
إذ أراك رجلاً طيّباً

237
00:15:54,120 --> 00:15:55,350
كثيراً ما أسمع ذلك

238
00:15:57,780 --> 00:15:59,810
هيجيكاتا-سان ثمل من الآن؟

239
00:15:59,810 --> 00:16:02,860
كان ذلك سريعاً! لا يستطيع تحمّل الخمر

240
00:16:03,120 --> 00:16:04,800
!لا يستطيع تحمّله

241
00:16:05,830 --> 00:16:08,550
وكأنّهما لوحة تعرض رجلاً وسيماً وامرأة جميلة

242
00:16:09,160 --> 00:16:11,780
جمالهما غاية في الإبهار

243
00:16:13,790 --> 00:16:16,370
...مقارنةً بها، أشعر بالنّقص

244
00:16:17,000 --> 00:16:19,600
مع ذلك، بما أنّنا استطعنا الحصول
على هذا المال

245
00:16:19,600 --> 00:16:21,340
،من مجرّد حماية لوح إعلانات

246
00:16:21,340 --> 00:16:22,870
فلا أحد يعلم كم سنجني

247
00:16:22,870 --> 00:16:25,280
!إذا قبضنا على كافّة الجناة

248
00:16:25,280 --> 00:16:26,950
أجل، معك حقّ

249
00:16:26,950 --> 00:16:28,120
سانو

250
00:16:28,120 --> 00:16:29,760
لماذا تركتَهم يفلتون؟

251
00:16:30,290 --> 00:16:32,020
،إذا كان عددهم 8

252
00:16:32,020 --> 00:16:34,140
فكان ينبغي أن تتمكّن من اكتشاف شيء

253
00:16:34,140 --> 00:16:36,310
أجل. شعرتُ بغرابة ذلك أيضاً

254
00:16:36,750 --> 00:16:39,450
قُبِضَ على بعضهم على الأقلّ، صحيح؟

255
00:16:42,300 --> 00:16:43,520
تشيزورو

256
00:16:43,910 --> 00:16:47,460
هل خرجتِ في تلك اللّيلة؟

257
00:16:47,690 --> 00:16:49,600
ماذا؟ لا

258
00:16:49,600 --> 00:16:51,030
حقّاً؟

259
00:16:51,030 --> 00:16:54,280
أجل. أنا في المقرّ دوماً في اللّيل

260
00:16:55,530 --> 00:16:57,500
ما الأمر يا سانو؟

261
00:16:57,500 --> 00:17:01,670
،عندما كنّا في مواجهة جنود توسا

262
00:17:01,670 --> 00:17:04,350
رأيتُ فتاة هناك تشبه تشيزورو كثيراً

263
00:17:05,000 --> 00:17:07,950
...ثمّ انهار تشكيلُنا

264
00:17:07,950 --> 00:17:09,130
!مستحيل

265
00:17:09,760 --> 00:17:11,500
هل يُعقَل أن تكون

266
00:17:11,500 --> 00:17:14,930
الفتاة الّتي التقيتِها أنتِ وهيسكي
وأنا في الدوريّة من قبل؟

267
00:17:17,740 --> 00:17:20,560
قالت بأنّ اسمها كاورو ناغومو، صحيح؟

268
00:17:20,950 --> 00:17:23,740
هل كانت تشبهكِ حقّاً؟

269
00:17:24,270 --> 00:17:26,580
...لكن هذا ليس كافياً لـ

270
00:17:27,040 --> 00:17:29,740
...لم أعتقد ذلك، لكن

271
00:17:29,740 --> 00:17:32,070
فأساساً، الفتاة الأخرى كانت ترتدي ثياب فتاة

272
00:17:32,380 --> 00:17:36,070
إذاً ينبغي أن نُلبِس تشيزورو كيمونو

273
00:17:39,750 --> 00:17:41,220
!تشيزورو

274
00:17:41,220 --> 00:17:43,460
!أجل! هذه فكرة سديدة

275
00:17:43,770 --> 00:17:44,970
!آنسة كيميغيكو

276
00:17:44,970 --> 00:17:48,060
هلّا ألبستِ هذه الفتاة كيمونو لو سمحتِ؟

277
00:17:49,080 --> 00:17:50,390
--أنتم

278
00:17:51,740 --> 00:17:54,820
موافقة. سأبذل قصارى جهدي

279
00:18:01,140 --> 00:18:03,850
يا شباب. أعتذر لو تأخّرت

280
00:18:17,590 --> 00:18:20,260
!ما-ماذا؟ هذه أنتِ يا تشيزورو؟

281
00:18:20,610 --> 00:18:22,120
أ-أجل

282
00:18:22,370 --> 00:18:24,990
!يا له من تغيير جذريّ

283
00:18:24,990 --> 00:18:27,250
لوهلة، لم أعرفها

284
00:18:27,560 --> 00:18:29,630
حسناً؟ ما رأيك يا سانو؟

285
00:18:32,840 --> 00:18:34,370
في الواقع، لا أعلم

286
00:18:34,370 --> 00:18:37,380
تشيزورو جميلة جدّاً لدرجة لم أعد
أستطيع فيها التّمييز

287
00:18:37,380 --> 00:18:38,400
!ماذا؟

288
00:18:39,080 --> 00:18:41,860
معك حقّ! تشيزورو جميلة جدّاً، صحيح؟

289
00:18:41,860 --> 00:18:44,630
!أجل! يا لها من فتاة

290
00:18:44,630 --> 00:18:47,280
!ماذا؟ سقطَ شينباتشي-سان في سحرها؟

291
00:18:47,280 --> 00:18:49,670
!أحمق، هذا يُشعرني بالخجل

292
00:18:50,640 --> 00:18:52,180
!توقّفوا أرجوكم

293
00:18:53,590 --> 00:18:56,380
!شينباتسو! لِمَ تقول كلاماً غريباً كهذا؟

294
00:18:56,380 --> 00:18:57,710
آسف، آسف

295
00:19:07,040 --> 00:19:08,080
!أنا آسفة

296
00:19:08,080 --> 00:19:10,030
ليس عليكِ الهرب

297
00:19:10,030 --> 00:19:11,010
ماذا؟

298
00:19:12,700 --> 00:19:13,800
أجل

299
00:19:15,720 --> 00:19:17,640
...المرأة الّتي رآها هارادا

300
00:19:19,440 --> 00:19:21,700
ليس عليكِ القلق بشأنها

301
00:19:22,270 --> 00:19:26,470
أولئك الّذين يعارضوننا ينالون ما يستحقّونه دوماً

302
00:19:27,790 --> 00:19:30,520
أجل. شكراً جزيلاً لك

303
00:19:30,520 --> 00:19:32,990
حسناً يا سانو-سان! افعل ذلك الشّيء
!الّذي تفعله دوماً

304
00:19:32,990 --> 00:19:34,140
!حسناً، حسناً

305
00:19:34,140 --> 00:19:36,240
!إن لم تفعل ذلك، فلن أعتبر هذه حفلة شرب

306
00:19:36,240 --> 00:19:37,930
يعيدني هذا للذّكريات

307
00:19:37,930 --> 00:19:39,530
حسناً. أظنّني مضطرّاً لذلك

308
00:19:39,530 --> 00:19:43,060
كنتُ لا أزال في إيدو، أدير دوجو متواضعاً

309
00:19:43,060 --> 00:19:46,830
وكنّا في كلّ ليلة نخرج ونشرب حتّى وقت متأخّر

310
00:19:47,360 --> 00:19:48,230
...نعم

311
00:19:49,460 --> 00:19:53,170
آنذاك، كانت أموالنا شحيحة
...وعدد تلاميذنا قليل، لكن

312
00:19:54,380 --> 00:19:55,850
كان ذلك مُبهِجاً

313
00:19:56,440 --> 00:19:59,590
إذاً حتّى أنت لديك ماضٍ كهذا يا هيجيكاتا-سان

314
00:19:59,840 --> 00:20:01,310
ما معنى هذا؟

315
00:20:01,310 --> 00:20:04,780
لا تقنعيني بأنّكِ كنتِ تركّزين فقط

316
00:20:04,780 --> 00:20:07,850
على صيد الرّونين مثلما أنا الآن

317
00:20:08,940 --> 00:20:12,260
...لا، إطلاقاً

318
00:20:12,790 --> 00:20:14,130
أقول لنفسي ذلك أحياناً

319
00:20:15,830 --> 00:20:18,690
،كنتُ أحمل صندوق دواء وأبيع أثناء التّجوال

320
00:20:18,690 --> 00:20:20,120
،لكن أن أضع سيفاً على خصري الآن

321
00:20:20,120 --> 00:20:21,530
...وأعمل لصالح الباكوفو

322
00:20:24,200 --> 00:20:25,740
...أحياناً أقول لنفسي

323
00:20:26,060 --> 00:20:30,750
بأنّني كنتُ أرى حلماً طويلاً وسعيداً

324
00:20:36,580 --> 00:20:38,880
آسف على التدخُّل

325
00:20:39,470 --> 00:20:43,460
هيجيكاتا-سان، استعراض المعدة الخاصّ
بسانو على وشك أن يبدأ

326
00:20:43,460 --> 00:20:45,490
!تشيزورو، تعالي بسرعة أيضاً

327
00:20:45,490 --> 00:20:48,460
عجباً. أنتم لا تهدؤون

328
00:21:07,410 --> 00:21:09,010
!كان ذلك رائعاً

329
00:21:20,940 --> 00:21:23,300
كازاما والآخرون عادوا إلى كيوتو؟

330
00:21:25,950 --> 00:21:29,010
يبدو أنّ العاصفة ستهبُّ قريباً

331
00:23:01,560 --> 00:23:02,700
حارس الضّريح الإمبراطوريّ؟

332
00:23:02,700 --> 00:23:03,940
أجل

333
00:23:03,940 --> 00:23:05,810
،عند المغادرة، أنا، إيتو

334
00:23:05,810 --> 00:23:09,450
أتبنّى حراسة ضريح الإمبراطور كومي

335
00:23:09,450 --> 00:23:10,450
!مهلاً لحظة

336
00:23:10,450 --> 00:23:12,950
!كيف لنا أن نغفر لمثل هذه الأنانيّة؟

337
00:23:12,950 --> 00:23:16,190
الحلقة القادمة
آثار المجزرة