1
00:00:05,790 --> 00:00:07,000
...سانّان-سان

2
00:00:17,120 --> 00:00:18,910
...سـ-سانّان-سان

3
00:00:34,500 --> 00:00:36,680
يـ-يبدو أنّني تجربة فاشلة، أليس كذلك؟

4
00:00:37,500 --> 00:00:40,360
...يبدو أنّ حظّي

5
00:00:40,360 --> 00:00:42,650
أقلّ ممّا كنتُ أتوقّع

6
00:00:44,290 --> 00:00:46,700
سانّان-سان. هل أنت بخير؟

7
00:00:46,700 --> 00:00:49,920
الوقت ليس مناسباً لتقلقي عليّ أنا، صحيح؟

8
00:00:49,920 --> 00:00:52,660
من فضلك، اقتليني بما أنّ الفُرصة سانحة

9
00:00:53,330 --> 00:00:54,410
!أقتلك؟

10
00:00:54,410 --> 00:00:56,320
كان الدّواء فاشلاً

11
00:00:56,320 --> 00:01:00,020
فقدتُ عقلي تقريباً

12
00:01:00,020 --> 00:01:04,750
!على هذا المُعدّل، سوف أقتلكِ... بالتّأكيد

13
00:01:05,120 --> 00:01:06,370
...لكن مُحال

14
00:01:06,370 --> 00:01:08,910
!مُحال أن أتمكّن من فعل ذلك

15
00:01:09,200 --> 00:01:10,410
!افعليها

16
00:01:12,110 --> 00:01:13,560
سانّان-سان؟

17
00:01:15,330 --> 00:01:18,420
،حتّى تحت تأثير هذا الدّواء

18
00:01:18,420 --> 00:01:22,350
إذا توقّف قلبي، يمكن أن أموت

19
00:01:22,750 --> 00:01:24,870
!سانّان-سان! توقّف

20
00:01:27,120 --> 00:01:30,730
هيّا. اقتليني حالاً

21
00:01:31,040 --> 00:01:33,980
!لا أستطيع يا سانّان-سان! توقّف

22
00:01:34,700 --> 00:01:36,870
!النّجدة! فليُنقذني أحد

23
00:01:36,870 --> 00:01:40,490
!هيّا... دعيني أموت أرجوكِ

24
00:01:40,790 --> 00:01:42,620
!كُفّ عن هذا يا سانّان-سان

25
00:01:43,700 --> 00:01:44,620
!توقّف

26
00:01:46,830 --> 00:01:47,910
!سانّان-سان

27
00:02:06,160 --> 00:02:07,260
!سانّان-سان

28
00:02:09,790 --> 00:02:10,400
!نائب القائد

29
00:02:11,580 --> 00:02:14,830
،شينباتشي، تولَّ عقار مايكاوا، بينما هارادا

30
00:02:14,830 --> 00:02:16,110
تولَّ مدخل ياغي

31
00:02:16,110 --> 00:02:17,840
راقبوا تحرُّكات الجنود

32
00:02:17,840 --> 00:02:19,410
!لا تدعوا أحداً يقترب من هذه الغرفة

33
00:02:19,750 --> 00:02:20,660
حسناً

34
00:02:21,220 --> 00:02:23,020
سايتو، تأهّب في الحديقة

35
00:02:23,020 --> 00:02:24,450
أبقَ رجال إيتو تحت أنظارك

36
00:02:24,810 --> 00:02:25,790
عُلِم

37
00:02:26,540 --> 00:02:29,430
هيجيكاتا-سان، سأبقى هنا

38
00:02:30,240 --> 00:02:32,070
أتشعر برغبة في تجربته؟

39
00:02:32,070 --> 00:02:34,800
إذا كنتَ واثقاً، فلن أمنعك

40
00:02:35,160 --> 00:02:38,670
حسناً، إن فشلت، سأصنع لك معروفاً وأقتلك

41
00:02:39,830 --> 00:02:43,060
:حسناً، اللّيلة هي الّتي ستحدّد

42
00:02:43,060 --> 00:02:45,030
...فيما إذا كان سيعيش أم سيموت

43
00:02:45,660 --> 00:02:47,120
أم يصبح معطوباً

44
00:04:24,910 --> 00:04:27,050
هيجيكاتا-سان، كيف حال سانّان-سان؟

45
00:04:28,120 --> 00:04:29,540
لا نعلم بعد

46
00:04:30,950 --> 00:04:32,330
...سانّان-سان

47
00:04:35,790 --> 00:04:37,010
أين أنا؟

48
00:04:41,730 --> 00:04:43,970
هلّا شرحتِ ما جرى؟

49
00:04:46,660 --> 00:04:47,830
إنّها نفسها

50
00:04:48,430 --> 00:04:50,150
إنّها نفس العيون الّتي رأيتُها

51
00:04:50,150 --> 00:04:51,650
عندما أتيتُ إلى مقرّهم أوّل مرّة

52
00:04:52,470 --> 00:04:57,480
الحلقة 6
وجود الشّياطين

53
00:04:59,780 --> 00:05:02,450
ماذا كنتِ وسانّان-سان تفعلان معاً؟

54
00:05:03,010 --> 00:05:06,040
ظننتُ أنّ ذراع سانّا-سان سوف تتحسّن

55
00:05:06,040 --> 00:05:08,430
إذا تناول دواء، لذا ذهبتُ بحثاً عن دواء

56
00:05:09,190 --> 00:05:12,020
...ثمّ شاءت الصّدفة أن أراه

57
00:05:13,920 --> 00:05:16,560
...المعذرة، الدّواء الّذي تناوله سانّان-سان

58
00:05:16,560 --> 00:05:17,890
...هل صحيح أنّ أبي

59
00:05:17,890 --> 00:05:20,610
له صِلة به؟

60
00:05:21,010 --> 00:05:22,830
سمعتِ ذلك من سانّان-سان؟

61
00:05:24,470 --> 00:05:26,690
الدّواء يجعل النّاس أقوى

62
00:05:26,690 --> 00:05:28,250
لكن يدمّر مهاراتهم

63
00:05:28,960 --> 00:05:31,870
قال بأنّه صُنِعَ بأمر من الباكوفو

64
00:05:31,870 --> 00:05:35,640
واستُخدِمَ على الشّينسينغومي كرعايا تجارب

65
00:05:37,720 --> 00:05:39,950
بما أنّكِ سمعتِ ذلك بالفعل، فما باليد حيلة

66
00:05:39,950 --> 00:05:43,740
،صحيح، كودو-سان مسؤول عن تطويره

67
00:05:43,740 --> 00:05:45,400
لكنّه اختفى قبل إتمامه

68
00:05:48,310 --> 00:05:50,780
أولئك الّذين تناولوا الدّواء موجودون
في عقار مايكاوا

69
00:05:51,460 --> 00:05:53,760
إنّهم بخير ما داموا يبقون بعيدين عن الدّماء

70
00:05:54,440 --> 00:05:57,140
،لكن حالما يخرجون عن السّيطرة
فلا جدوى من فعل شيء

71
00:05:59,520 --> 00:06:02,800
هذا هو سرُّ الشّينسينغومي، وحدهم
كبار القادة من يعلمون ذلك

72
00:06:04,030 --> 00:06:06,660
لكنّكِ قد عرفتِه الآن

73
00:06:13,650 --> 00:06:17,000
،لعلّكِ مفيدة في البحث عن كودو-سان

74
00:06:17,000 --> 00:06:19,060
لكن لن نضطرب إذا اختفيتِ

75
00:06:20,170 --> 00:06:22,760
أي نشاط مشبوه من طرفكِ

76
00:06:23,420 --> 00:06:25,440
ستُقتَلين فوراً. ضعي ذلك في حسبانكِ

77
00:06:25,610 --> 00:06:28,130
...ماذا؟ إذاً أنا

78
00:06:28,690 --> 00:06:30,260
لن أقتلكِ بعد

79
00:06:31,730 --> 00:06:34,950
فأساساً، يمكنكِ الموت في أيّ مكان
وستسير الأمور على ما يُرام

80
00:06:36,140 --> 00:06:37,160
...حسناً

81
00:06:40,480 --> 00:06:43,140
،سانّان-سان، الّذي اِئتُمِن على الاعتناء بالدّواء

82
00:06:43,140 --> 00:06:45,140
استمرَّ في تطويره

83
00:06:45,140 --> 00:06:46,910
حاول أن يجعل الدّواء يُشفي ذراعه

84
00:06:46,910 --> 00:06:49,470
،بينما يحافظ على عقله سليماً
وها هي النّتيجة

85
00:06:50,430 --> 00:06:53,880
،لعلّكِ رأيتِ الجانب السيّئ منه فقط

86
00:06:53,880 --> 00:06:57,470
لكن كان سانّان-سان عبقريّاً جدّاً وموهوباً

87
00:06:58,560 --> 00:07:00,480
،قبل أن يكون هناك شينسينغومي

88
00:07:00,480 --> 00:07:02,500
كان بمثابة الأخ الكبير لي

89
00:07:08,890 --> 00:07:11,450
نحن بحاجة سانّان-سان

90
00:07:12,000 --> 00:07:14,240
لا يمكننا أن نخسره

91
00:07:18,840 --> 00:07:19,850
ستكون الأمور على ما يُرام

92
00:07:20,480 --> 00:07:23,000
!سيكون سانّان-سان بخير

93
00:07:24,620 --> 00:07:25,450
أجل

94
00:07:29,860 --> 00:07:32,630
كلّ ما يمكننا فعله الآن هو المراهنة

95
00:07:32,630 --> 00:07:34,530
على أن تتفوّق روحه على الدّواء

96
00:07:50,370 --> 00:07:53,300
يبدو أنّ سانّان-سان خرج من دائرة الخطر

97
00:07:55,140 --> 00:07:56,720
لقد هدأ

98
00:07:56,720 --> 00:07:58,240
ما زال نائماً

99
00:07:58,600 --> 00:08:01,000
إذاً هل نجح سانّان-سان؟

100
00:08:01,270 --> 00:08:04,130
لن نعرف يقيناً ما لم يستيقظ

101
00:08:04,500 --> 00:08:06,840
لا يبدو مختلفاً عمّا كان عليه في الأمس

102
00:08:11,310 --> 00:08:12,760
صباح الخير

103
00:08:16,250 --> 00:08:17,950
هل أنت بخير يا سوجي؟

104
00:08:17,950 --> 00:08:21,020
...أجل. الهواء خانق هنا بعض الشّيء، لذلك أنا

105
00:08:21,380 --> 00:08:24,610
،يا إلهي. صباح حيويّ كهذا

106
00:08:24,610 --> 00:08:27,020
ومع ذلك تبدو وجوهكم شاحبة جميعاً

107
00:08:27,510 --> 00:08:30,900
هل للأمر علاقة بالاضطرابات في اللّيلة الماضية؟

108
00:08:30,900 --> 00:08:33,200
...في الواقع، هذا

109
00:08:34,990 --> 00:08:36,980
!اخدعه يا سانو

110
00:08:36,980 --> 00:08:38,660
ماذا؟ أنا؟

111
00:08:38,660 --> 00:08:40,860
أجل، أجل. لندع هذا على شخص

112
00:08:40,860 --> 00:08:43,160
ماهر في شرح الأمور

113
00:08:47,350 --> 00:08:49,780
،كما تقول يا حضرة الضّابط إيتو

114
00:08:49,780 --> 00:08:52,790
حدث شيء بالفعل في اللّيلة الماضية في المقرّ

115
00:08:53,300 --> 00:08:55,920
وملامحُ الوضعِ لم تتوضَّحْ جيّداً بعد

116
00:08:55,920 --> 00:08:58,430
يؤسفني سماع ذلك

117
00:08:58,930 --> 00:09:01,780
إزعاجك بهذا كان آخر شيء

118
00:09:01,780 --> 00:09:04,060
تمنّينا فعله

119
00:09:04,790 --> 00:09:07,740
لذا، سوف نقيّم الوضع

120
00:09:07,740 --> 00:09:10,940
...ونبلغك عن التّفاصيل في هذا المساء

121
00:09:11,700 --> 00:09:13,030
هكذا إذاً

122
00:09:13,790 --> 00:09:15,750
فهمتُ الآن

123
00:09:15,750 --> 00:09:17,360
،إن كان الأمر كذلك

124
00:09:17,360 --> 00:09:20,980
فأنتظر دعوتكم في هذا المساء بقلق

125
00:09:28,330 --> 00:09:31,360
رغم ذلك، يبدو أنّه تساهل معنا في هذه

126
00:09:31,360 --> 00:09:34,810
ربّما أعجبه كيف تعامل هاجيمي-كن مع الأمر

127
00:09:35,520 --> 00:09:37,720
أتمنّى أن يكون كذلك

128
00:09:38,300 --> 00:09:40,230
،كبار الشّخصيات مجتمعة

129
00:09:40,230 --> 00:09:42,100
لكن سانّان-سان ليس هنا

130
00:09:42,100 --> 00:09:44,960
سيلاحظ إيتو-سان قريباً وبكلّ تأكيد

131
00:09:44,960 --> 00:09:47,230
بأنّ شيئاً غير منطقيّ يحدث

132
00:09:47,500 --> 00:09:49,480
أجل، صحيح

133
00:09:49,480 --> 00:09:51,380
ذلك الرّجل مُزعج

134
00:09:52,280 --> 00:09:54,230
ماذا نفعل يا توشي؟

135
00:10:06,870 --> 00:10:08,000
!سانّان-سان

136
00:10:08,450 --> 00:10:09,540
هل أنت بخير بما أنّك استيقظت؟

137
00:10:09,750 --> 00:10:12,000
...أنا مُرهَق بعض الشّيء، لكن

138
00:10:12,330 --> 00:10:14,690
أنا متأكّد بأنّ هذا تأثير جانبيّ للدّواء

139
00:10:15,370 --> 00:10:17,070
،منذ تناولي ذلك الدّواء

140
00:10:17,070 --> 00:10:19,680
أمسى روتيني اليوميّ صعباً جدّاً

141
00:10:20,700 --> 00:10:22,510
...لذا، بصيغة أخرى

142
00:10:24,620 --> 00:10:27,270
لم أعُد بشريّاً

143
00:10:27,580 --> 00:10:30,280
!نحن مسرورون لأنّك على قيد الحياة

144
00:10:30,280 --> 00:10:32,190
!هذا أكثر من كافٍ

145
00:10:32,190 --> 00:10:35,030
وبعد، هل شُفيَتْ ذِراعك؟

146
00:10:35,700 --> 00:10:38,070
أجل، يبدو أنّها شُفيتْ

147
00:10:38,070 --> 00:10:40,330
على الأقلّ، لم تعُد تزعجني

148
00:10:40,330 --> 00:10:42,530
لكن لا يمكنك الخروج في النّهار، صحيح؟

149
00:10:42,530 --> 00:10:45,410
هل يمكنك أداء واجبات الفرقة بهذا الشّكل؟

150
00:10:47,620 --> 00:10:50,290
يجدر بكم أن تعتبروني ميّتاً فحسب

151
00:10:53,560 --> 00:10:57,000
أظنّني سأكون مضرب مثل للشّينسينغومي

152
00:10:57,000 --> 00:10:59,800
عمّا يحدث بعد تناول الدّواء

153
00:11:00,520 --> 00:11:03,090
أُمِرنا بواسطة الباكوفو

154
00:11:03,090 --> 00:11:04,960
بكتم سرّ الدّواء

155
00:11:05,620 --> 00:11:07,950
،لكن إذا متُّ

156
00:11:07,950 --> 00:11:10,410
سيبقى وجود الدّواء مدفوناً

157
00:11:11,250 --> 00:11:13,730
،وإذا لم يكن لدى الدّواء آثار جانبيّة

158
00:11:13,730 --> 00:11:15,270
فلن يتردّد أحدٌ عن تناوله، أليس كذلك؟

159
00:11:16,200 --> 00:11:18,250
هذه هي الطريقة الوحيدة؟

160
00:11:19,330 --> 00:11:23,070
حسناً، هذا هو الدّرب الّذي اخترتَه
أنت يا سانّان-سان

161
00:11:25,370 --> 00:11:30,080
إذاً نقلُ مقرّنا باتَ مسألةٌ هامّة

162
00:11:31,330 --> 00:11:35,700
إخباء سانّان-سان عن رجال إيتو سيتطلّب

163
00:11:35,700 --> 00:11:37,590
مقرّاً كبيراً جدّاً

164
00:11:44,710 --> 00:11:47,730
بعد ستّة أشهر، ينتقل الشّينسينغومي

165
00:11:47,730 --> 00:11:50,580
،بالقوّة إلى معبد نيشي هونغوانجي

166
00:11:50,580 --> 00:11:52,430
والّذي كان متعاوناً مع عشيرة تشوشو

167
00:11:56,790 --> 00:11:59,610
!سانّان-سان! العشاء جاهز الآن

168
00:12:00,330 --> 00:12:02,610
هذه أنتِ؟

169
00:12:02,910 --> 00:12:03,980
شكراً لكِ

170
00:12:13,660 --> 00:12:15,070
هل من مُشكلة؟

171
00:12:15,750 --> 00:12:18,280
لا. أبداً

172
00:12:18,660 --> 00:12:19,480
حسناً إذاً

173
00:12:24,540 --> 00:12:29,750
اليومُ الّذي يخسرُ فيه سانّان-سان أمام
...الدّواء ليس ببعيد

174
00:12:34,580 --> 00:12:37,060
‏3 يوليو، 1865

175
00:12:34,790 --> 00:12:37,060
،بعد انتقال المقرّ بفترة قصيرة

176
00:12:37,550 --> 00:12:39,970
عاد هيسكي-كن من إيدو

177
00:12:41,950 --> 00:12:43,550
مضى وقتٌ طويل، أليس كذلك؟

178
00:12:43,550 --> 00:12:45,840
منذ خرجتُ معك في دوريّة يا هيسكي-كن

179
00:12:45,840 --> 00:12:47,070
...أجل

180
00:12:47,410 --> 00:12:50,100
ألم يتنمّر عليكِ شينباتسو أو سانو-سان

181
00:12:50,100 --> 00:12:51,740
أثناء غيابي؟

182
00:12:51,740 --> 00:12:52,620
لا

183
00:12:52,620 --> 00:12:55,780
،كانا يحميانني عند خروجنا لدوريّة

184
00:12:55,780 --> 00:12:58,360
مع ذلك لم نتوصّل إلى أي دليل عن أبي

185
00:12:58,360 --> 00:13:00,560
!حسناً، ابتهجي

186
00:13:00,560 --> 00:13:03,000
قد ينتهي المطاف بلقائنا به

187
00:13:03,000 --> 00:13:04,090
!حـ-حسناً

188
00:13:07,710 --> 00:13:09,600
هيسكي-كن؟ ما الأمر؟

189
00:13:11,030 --> 00:13:14,560
،لم أرَ هذه البلدة أو السكّان منذ مدّة

190
00:13:14,560 --> 00:13:16,250
وأشعر كأنّهم تغيّروا

191
00:13:18,510 --> 00:13:19,590
هيسكي-كن؟

192
00:13:20,250 --> 00:13:21,620
!لا شيء

193
00:13:25,140 --> 00:13:26,290
!سوجي

194
00:13:30,370 --> 00:13:31,820
كيف الأمور عندك؟

195
00:13:31,820 --> 00:13:34,250
لم يتغيّر شيء

196
00:13:35,450 --> 00:13:38,030
لكن أعتقد ستغدو الأمور حافلة

197
00:13:38,030 --> 00:13:39,890
عندما يأتي الشّوغن للزيارة

198
00:13:39,890 --> 00:13:41,500
زيارة؟

199
00:13:41,500 --> 00:13:44,280
سيأتي الشّوغن إلى كيوتو؟

200
00:13:44,280 --> 00:13:47,760
أجل. هذا ما أثار كوندو-سان

201
00:13:48,120 --> 00:13:51,140
...أجل. هذا واضح

202
00:13:55,080 --> 00:13:56,120
!أوكيتا-سان

203
00:13:57,780 --> 00:13:59,080
هل أنت بخير؟

204
00:14:02,070 --> 00:14:03,600
!أيّتها الصّغيرة

205
00:14:03,600 --> 00:14:05,530
من تعتقدين نفسكِ حتّى ترفضي؟

206
00:14:05,930 --> 00:14:09,580
نحنُ مُحاربون نُكافِحُ كلّ يوم لطرد الأجانب

207
00:14:09,580 --> 00:14:11,170
لذا سكب كأس من الخمر لنا

208
00:14:11,170 --> 00:14:14,130
نحن هو أقلّ ما يمكنكِ فعله لأجلنا

209
00:14:14,500 --> 00:14:15,500
!توقّفا

210
00:14:15,500 --> 00:14:16,620
!اتركاني

211
00:14:18,450 --> 00:14:19,420
!تعالي معنا

212
00:14:19,420 --> 00:14:21,240
!لا، توقّفا

213
00:14:21,240 --> 00:14:24,350
يا إلهي. كلمة "وطنيّ" مهدورة

214
00:14:24,350 --> 00:14:27,120
بواسطة أمثالكم

215
00:14:27,120 --> 00:14:28,440
!ماذا؟

216
00:14:30,690 --> 00:14:32,350
عباءة زرقاء فاتحة؟

217
00:14:32,350 --> 00:14:33,680
إنّهم الشّينسينغومي

218
00:14:35,970 --> 00:14:38,540
بما أنّكما تعرفاننا، فهذا يوفّر بعض الوقت

219
00:14:38,540 --> 00:14:39,830
ماذا ستفعلان؟

220
00:14:40,930 --> 00:14:43,310
!اللّعنة! سوف أشرب في مكان آخر

221
00:14:44,310 --> 00:14:45,940
ماذا ستفعل أنت؟

222
00:14:46,560 --> 00:14:47,980
!لن أنسى هذا

223
00:14:54,990 --> 00:14:56,980
شكراً جزيلاً لك

224
00:14:56,980 --> 00:14:59,460
اسمي كاورو ناغومو

225
00:15:04,630 --> 00:15:05,660
ثِق بي

226
00:15:06,230 --> 00:15:07,210
...فعليّاً

227
00:15:09,010 --> 00:15:10,680
أنتما مُتشابهان، أليس كذلك؟

228
00:15:10,680 --> 00:15:14,070
حقّاً؟ لا أراهما كذلك إطلاقاً

229
00:15:14,070 --> 00:15:15,600
بل هما كذلك

230
00:15:19,520 --> 00:15:21,500
،أعتقد إذا تنكّر هذا الفتى بهيئة فتاة

231
00:15:21,500 --> 00:15:23,110
فستصبحان نسخة طبق الأصل

232
00:15:23,620 --> 00:15:25,020
...ا-المعذرة

233
00:15:25,800 --> 00:15:28,730
،أتمنّى أن أشكرك بشكل أفضل

234
00:15:28,730 --> 00:15:30,830
لكن لديّ التزامات أخرى الآن

235
00:15:30,830 --> 00:15:32,870
سامحني على تصرُّفي الصفيق

236
00:15:35,100 --> 00:15:37,310
،سوف أردّ لك الجميل في وقتٍ لاحق

237
00:15:37,310 --> 00:15:39,690
يا سوجي أوكيتا-سان من الشّينسينغومي

238
00:15:42,730 --> 00:15:45,880
رائع! يبدو أنّها أُعجبت بك يا سوجي، أليس كذلك؟

239
00:15:46,310 --> 00:15:49,320
،إذا كانت هكذا هي نظرتك للأمر يا هيسكي

240
00:15:49,320 --> 00:15:51,180
فلن تهزم سانو-سان أبداً

241
00:15:51,680 --> 00:15:53,910
!ما-ما معنى هذا؟

242
00:16:02,950 --> 00:16:04,500
كاورو-سان، صحيح؟

243
00:16:05,290 --> 00:16:07,400
!تشيزورو! سوف نعود

244
00:16:08,490 --> 00:16:09,330
!حسناً

245
00:16:20,540 --> 00:16:22,830
أظنّكم جميعكم قد سمعتُم

246
00:16:22,830 --> 00:16:25,660
،بأنّ الشّوغن الرّابع عشر، إيموتشي توكوغاوا

247
00:16:25,660 --> 00:16:27,540
سيزور العاصمة

248
00:16:27,890 --> 00:16:29,650
،بموجب زيارته

249
00:16:29,650 --> 00:16:31,570
،تلقّينا نحن الشّينسينغومي أوامرَ

250
00:16:31,570 --> 00:16:33,420
حتّى يصل إلى قلعة نيجو، مهمّتنا هي

251
00:16:33,420 --> 00:16:35,930
أن نوفّر له الحماية القصوى

252
00:16:41,840 --> 00:16:44,740
،نظراً إلى حادثة نُزُل إيكيدايا وتمرُّد كينمون

253
00:16:44,740 --> 00:16:46,270
بكلِّ تأكيد، حتّى كبار المسؤولين

254
00:16:46,270 --> 00:16:49,190
اعترفوا بإنجازاتنا وأثنوا عليها

255
00:16:49,500 --> 00:16:51,930
،في رأيي، من خلال حمايته

256
00:16:51,930 --> 00:16:55,000
يقع مصير البلد على عاتق سيوفنا

257
00:16:55,000 --> 00:16:55,700
!أجل

258
00:16:56,250 --> 00:16:59,010
...حمايته هنا في العاصمة

259
00:16:59,010 --> 00:17:01,410
لو ظلّ سانّان-سان معنا

260
00:17:01,870 --> 00:17:04,710
خسرنا حليفاً قيّماً، أليس كذلك؟

261
00:17:06,290 --> 00:17:08,410
وبالتّالي، سوف ننشغل كثيراً في الفترة القادمة

262
00:17:08,410 --> 00:17:11,280
أوّلاً، سيترتّب علينا التّفكير في كيفيّة
تشكيل قوّاتنا

263
00:17:12,120 --> 00:17:15,540
...حسناً إذاً... توشي وأنا... سوجي

264
00:17:15,540 --> 00:17:16,530
المعذرة

265
00:17:16,530 --> 00:17:20,340
كوندو-سان، هل يمكنك استبعاد سوجي هذه المرّة؟

266
00:17:20,340 --> 00:17:22,160
يبدو أنّه مُصاب بنزلة برد

267
00:17:23,000 --> 00:17:25,190
أحقّاً يا سوجي؟ هل أنت بخير؟

268
00:17:25,750 --> 00:17:29,150
شخصيّاً، لا أراها مشكلة

269
00:17:29,150 --> 00:17:31,230
هيجيكاتا-سان يبالغ

270
00:17:31,450 --> 00:17:33,350
!بل هي مشكلة

271
00:17:33,350 --> 00:17:35,110
كنتَ تسعل قبل قليل

272
00:17:35,680 --> 00:17:39,240
بئساً يا هيجيكاتا-سان، أنت وقائيٌّ زيادة عن اللُّزوم

273
00:17:40,950 --> 00:17:42,120
ما الأمر يا هيسكي؟

274
00:17:42,120 --> 00:17:43,870
...المعذرة يا كوندو-سان

275
00:17:43,870 --> 00:17:45,870
في الحقيقة، أشعر بوعكة أيضاً

276
00:17:46,080 --> 00:17:48,330
ماذا؟ هيسكي، هل أصبتَ بنزلة برد أيضاً؟

277
00:17:48,330 --> 00:17:49,750
،في مناسبة كهذه

278
00:17:49,750 --> 00:17:52,490
أردتُ أن نذهب جميعاً للتّرحيب بالشّوغن معاً

279
00:17:52,490 --> 00:17:54,790
المعذرة، آسف

280
00:17:55,240 --> 00:17:56,380
...هيسكي-كن

281
00:17:56,790 --> 00:17:58,910
لا، الأولويّة لصحّتك

282
00:17:58,910 --> 00:18:00,720
ستسنح فُرصة أخرى

283
00:18:00,720 --> 00:18:03,720
عندما نحتاج لكما لاحقاً، أريدكما
أن تفعلا ما بوسعكما

284
00:18:07,250 --> 00:18:09,610
حسناً، ماذا ستفعلين أنتِ؟

285
00:18:09,610 --> 00:18:10,760
نعم؟

286
00:18:10,760 --> 00:18:12,420
لا تتظاهري بالحماقة

287
00:18:12,420 --> 00:18:15,150
أسألكِ فيما إذا كنتِ ستشاركين في حمايته

288
00:18:15,450 --> 00:18:17,520
أ-أنا أيضاً؟

289
00:18:18,540 --> 00:18:20,310
لا نمانع بالطّبع

290
00:18:20,310 --> 00:18:22,740
لا أبالغ إذا قلتُ بأنّكِ أصبحتِ

291
00:18:22,740 --> 00:18:24,580
عضواً في الشّينسينغومي يا يوكيمورا-كن

292
00:18:24,580 --> 00:18:26,510
إن لم تمانعي، احرصي على المشاركة

293
00:18:26,910 --> 00:18:27,810
...لكن

294
00:18:28,870 --> 00:18:31,080
حسناً، لن يكون هناك قلقاً على حياتك

295
00:18:31,080 --> 00:18:34,420
لا أعتقِدُ بأنَّ هُناك رجلاً مجنوناً يُهاجِمُ الشوغن

296
00:18:35,080 --> 00:18:37,170
لِمَ لا تذهبين، جرّبي فحسب

297
00:18:38,000 --> 00:18:42,530
حسناً! يسرُّني أن أُقدِّمَ المُساعدة
إن كنتُم بحاجة لها

298
00:18:58,750 --> 00:19:01,490
الدفعةُ التاليّة من الحُرَّاسِ المُناوبة ستأتي في الساعةِ التاسعة

299
00:19:02,040 --> 00:19:04,950
كلّ من في الوحدةِ الثالثة، اذهبوا من فضلِكم
إلى الحديقة الدّاخليّة

300
00:19:23,330 --> 00:19:25,820
أتساءل ما إن كان كوندو-سان والآخرون

301
00:19:25,820 --> 00:19:28,340
...يرحّبون بالمسؤولين الكبار الآن

302
00:19:33,500 --> 00:19:35,480
عليّ أن أقوم بعملي أيضاً

303
00:19:39,500 --> 00:19:41,000
...هذا الإحساس

304
00:19:49,330 --> 00:19:50,910
!هذا أنتم

305
00:19:52,950 --> 00:19:54,390
لاحظتِ؟

306
00:19:54,390 --> 00:19:57,380
يبدو أنّكِ لستِ سهلة في نهاية المطاف

307
00:19:57,670 --> 00:20:00,380
!لـ-لماذا أنتم هنا؟ وكيف؟

308
00:20:00,500 --> 00:20:03,490
ماذا؟ لن يكون من المنطقيّ

309
00:20:03,490 --> 00:20:05,160
إذا كان هناك ما يصنعه البشر

310
00:20:05,160 --> 00:20:07,120
من شأنه إيقافنا نحن فرقة الشّياطين

311
00:20:07,120 --> 00:20:10,520
شياطين"؟ هل تعبثون معي؟"

312
00:20:11,410 --> 00:20:13,000
لا تعرفين بشأن الشّياطين؟

313
00:20:13,000 --> 00:20:15,280
هل تقولين ذلك بصدق؟

314
00:20:15,280 --> 00:20:19,530
أنتِ واحدةٌ منّا يا تشيزورو يوكيمورا

315
00:20:20,290 --> 00:20:22,030
ما أدراك باسمي؟

316
00:20:22,380 --> 00:20:25,560
جروحكِ تُشفى بسرعة، فكيف لنا

317
00:20:25,560 --> 00:20:27,530
أن نعتبركِ بشريّة عاديّة؟

318
00:20:33,370 --> 00:20:35,170
...حسناً، في هذه الحالة

319
00:20:35,500 --> 00:20:38,180
ألن يكون من الأسرع اختبار ذلك فحسب؟

320
00:20:39,200 --> 00:20:41,050
توقّف يا شيرانوي

321
00:20:43,590 --> 00:20:46,000
،يمكنكِ قبول ذلك أو رفضه

322
00:20:46,000 --> 00:20:48,810
لكن أفعالنا لن تتغيّر

323
00:20:49,500 --> 00:20:51,230
:سأتكلّم بإيجاز

324
00:20:51,230 --> 00:20:52,730
،الكنية الّتي تثبت بأنّكِ شيطانة

325
00:20:52,730 --> 00:20:54,670
...السّيف القصير لشيطان الشّرق

326
00:20:54,670 --> 00:20:57,440
هذه وحدها كافية كإثبات

327
00:20:58,000 --> 00:20:59,320
كنية؟

328
00:20:59,320 --> 00:21:01,520
ما علاقة اسم "يوكيمورا" بالأمر؟

329
00:21:02,260 --> 00:21:03,430
وماذا عن سيفي القصير؟

330
00:21:04,210 --> 00:21:05,430
:سأقول هذا سلفاً

331
00:21:05,430 --> 00:21:08,950
لا نحتاج إذنكِ لأخذكِ معنا

332
00:21:14,210 --> 00:21:16,320
الشّياطين الأنثى ثمينات

333
00:21:16,320 --> 00:21:17,820
تعالي معنا

334
00:23:03,910 --> 00:23:05,130
ما رأيك؟

335
00:23:05,130 --> 00:23:07,360
شُكِّلَ جسدي هذا

336
00:23:07,360 --> 00:23:08,360
!من خلال فنون السّيف

337
00:23:08,950 --> 00:23:10,220
!شينباتشي

338
00:23:10,220 --> 00:23:12,620
!هناك آخرون خلفك، لذا تحرّك بسرعة

339
00:23:14,390 --> 00:23:16,370
الحلقة القادمة
أغلال القدر