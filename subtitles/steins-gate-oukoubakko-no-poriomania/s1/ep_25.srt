00:11:51,890 --> 00:11:52,600
.أجل

193
00:11:53,690 --> 00:11:54,350
.فهمت

194
00:11:56,190 --> 00:11:56,980
.اسمع

195
00:11:57,690 --> 00:12:00,070
.في هذه الحالة، أخبرني شيئًا

196
00:12:00,070 --> 00:12:00,820
ما هو؟

197
00:12:01,490 --> 00:12:05,530
.ذلك... كان هناك حلم غريب راودني

198
00:12:06,240 --> 00:12:09,330
...أنت وأنا... ذلك

199
00:12:09,330 --> 00:12:10,660
ذلك" ماذا؟"

200
00:12:11,160 --> 00:12:12,290
...ذلك

201
00:12:14,420 --> 00:12:16,790
ماذا؟ هل تريدين الذهاب للحمام؟

202
00:12:18,210 --> 00:12:19,500
!أيّها المنحرف

203
00:12:27,300 --> 00:12:31,600
أليس أوكارين وكريس-سان متلائمان جدًّا؟

204
00:12:39,270 --> 00:12:41,280
.هذا سيحدّد النزال

205
00:12:42,650 --> 00:12:44,320
.انتهى الأمر

206
00:12:44,320 --> 00:12:47,280
.لقد ارخى دفاعاته. فيريس فازت بالبطولة

207
00:12:47,870 --> 00:12:48,740
!فعلتها

208
00:12:50,700 --> 00:12:53,660
.فيريس. فيريس. فيريس

209
00:12:57,130 --> 00:13:00,500
إنّه فتًى، لكن من يهتم؟

210
00:13:00,840 --> 00:13:03,010
.يبدو أنّك مشهور

211
00:13:11,680 --> 00:13:13,810
.آ-آسفة على التأخّر

212
00:13:16,600 --> 00:13:17,600
.توقّفي

213
00:13:17,600 --> 00:13:18,810
ماذا عن إضافة "نيا" لطيفة في آخر الكلام؟

214
00:13:19,610 --> 00:13:21,860
!لماذا عليّ فعل هذا؟

215
00:13:21,860 --> 00:13:27,610
—يا عزيزتي المساعِدة، أنتِ تمثلين ثقافة الخادمة اليابانية في أمري

216
00:13:27,610 --> 00:13:31,120
.لم أتفق على القيام بهذا، ولا أريد القيام به

217
00:13:31,120 --> 00:13:35,250
.أنتِ تحتاجين إلى المساعدة لكي تدفعين الدين المتعلق بتذكرة الطائرة

218
00:13:35,250 --> 00:13:37,620
.لهذا من الطبيعي على أعضاء المختبر أن يتساعدوا

219
00:13:37,620 --> 00:13:40,790
متى دفع أحدهم ثمن تذكرتي؟

220
00:13:40,790 --> 00:13:43,050
.على عضو المختبر أن ينقذ نفسه بنفسه

221
00:13:43,050 --> 00:13:44,300
.إذًا أنت أيضًا جد عملاً

222
00:13:45,840 --> 00:13:47,760
،برؤية نشاطكِ

223
00:13:48,390 --> 00:13:50,760
،لابدّ أنّكِ حظيتِ بنومٍ جيّد

224
00:13:50,760 --> 00:13:52,850
.رغم إنّكِ بدوتِ قلقةً وقتها

225
00:13:54,270 --> 00:13:55,350
.أبدًا

226
00:13:55,810 --> 00:13:58,480
.كنت فضوليةً قليلاً فقط

227
00:13:58,900 --> 00:14:01,110
.في الواقع، لم أكن كذلك أبدًا

228
00:14:01,110 --> 00:14:02,730
.إذًا انسي الأمر فقط

229
00:14:03,400 --> 00:14:06,320
.لا فائدة من الشعور بالحرج من أجل شيءٍ حدث في خطّ عالمٍ آخر

230
00:14:07,110 --> 00:14:08,320
.أنا أعلم

231
00:14:09,110 --> 00:14:10,780
.أخطّط لنسيان كلّ شيء

232
00:14:12,700 --> 00:14:13,450
.فهمت

233
00:14:28,680 --> 00:14:30,340
آسفة على التأخير

234
00:14:34,810 --> 00:14:36,060
!سوزوها؟

235
00:14:39,190 --> 00:14:39,770
!سوزوها

236
00:14:47,650 --> 00:14:49,400
لمَ سوزوها هنا؟

237
00:14:50,240 --> 00:14:51,990
.أذكر ما قالته آخر مرّة

238
00:14:53,200 --> 00:14:54,490
.شكرًا لك

239
00:14:54,490 --> 00:14:57,040
.لنلتقي مجدّدًا... بعد سبع سنين

240
00:14:57,450 --> 00:15:00,170
.وآلة الزمن لم يتم اختراعها في هذا العالم أصلاً

241
00:15:00,580 --> 00:15:03,790
.لذا هي لا يجب أن تكون موجودةً هنا، إلّا بعد سبع سنين، عند والدتها

242
00:15:04,800 --> 00:15:08,380
...لكن إذا كانتْ هي

243
00:15:08,380 --> 00:15:10,510
!إذًا هل توجد آلة زمن أيضًا؟

244
00:15:11,470 --> 00:15:14,510
...هل يمكن... أنّ الحرب العالميّة الثالثة

245
00:15:15,430 --> 00:15:17,310
ها؟ أوكابي ليس هنا؟

246
00:15:17,560 --> 00:15:24,020
.لا أدري، لقد رأيته هالعًا وهو خارجٌ من هنا

247
00:15:24,020 --> 00:15:30,070
.جميعًا، لقد رأه أحدهم وهو بوجهٍ مصدوم وركب سيارة أجرة

248
00:15:30,070 --> 00:15:33,120
ها؟ هل حصل شيءٌ ما؟

249
00:15:33,120 --> 00:15:35,160
.إنّه يتصرف كعادته مجدّدًا

250
00:15:37,080 --> 00:15:38,290
!كريس-تشان؟

251
00:15:39,160 --> 00:15:41,670
إذًا تبعتني كلّ الطريق إلى هنا؟

252
00:15:42,250 --> 00:15:44,330
إذًا... أنتِ لستِ هي؟

253
00:15:44,330 --> 00:15:45,540
.أعتقد ذلك

254
00:15:45,540 --> 00:15:48,000
،أتيت إلى هنا لألعب في بطولة راي-نيت

255
00:15:48,000 --> 00:15:52,090
.والآن أنا ذاهبة إلى صديقاتي في لاس فيغاس

256
00:15:52,970 --> 00:15:53,970
.فهمت

257
00:15:53,970 --> 00:15:57,220
...لكن بما أنّك طاردتني ظانًّا أنّي تلك الفتاة

258
00:15:57,220 --> 00:15:59,390
.فهذا يعني أنّها مهمةٌ لك

259
00:15:59,390 --> 00:16:01,810
.تلك الفتاة التي تشبهني

260
00:16:03,850 --> 00:16:06,570
.أجل، إنّها صديقةٌ عزيزة

261
00:16:06,900 --> 00:16:09,360
وأنت لا تعلم أين هي الآن؟

262
00:16:11,360 --> 00:16:12,650
.ليستْ موجودةً الآن

263
00:16:13,450 --> 00:16:15,740
.لكنّي ساتمكّن من رؤيتها خلال سبع سنوات

264
00:16:16,410 --> 00:16:17,530
.متأكّد من هذا

265
00:16:17,530 --> 00:16:20,080
.هاه، يبدو هذا رومانسيًّا

266
00:16:20,700 --> 00:16:26,130
.وأنا حظيت بقراءة حظ جيّدة تقول إنّي سأتزوّج وأحظى بطفلةٍ بعد سبع سنوات

267
00:16:28,300 --> 00:16:29,460
ماذا؟

268
00:16:29,460 --> 00:16:31,130
.لا، لا تهتمّي

269
00:16:35,890 --> 00:16:37,850
.آسفٌ لأنّي أخذت منكِ الكثير من الوقت

270
00:16:37,850 --> 00:16:40,520
.أبدًا
.لقد استمتعت

271
00:16:40,810 --> 00:16:41,600
.وداعًا

272
00:16:47,400 --> 00:16:48,020
.أجل

273
00:16:56,620 --> 00:16:57,700
.بعد سبع سنين

274
00:17:03,080 --> 00:17:06,210
.لا أعتقد أنّي أصدّق بمثل هذه الأشياء

275
00:17:11,710 --> 00:17:13,380
.المتبقّي هو: 67 سنت

276
00:17:13,920 --> 00:17:14,840
.البطاريّة: ميتة

277
00:17:15,220 --> 00:17:17,090
!كيف ساعود بحقّ الجحيم؟

278
00:17:20,930 --> 00:17:24,180
.كان هذا قبل ساعتان

279
00:17:33,070 --> 00:17:33,900
...كريسو

280
00:17:46,750 --> 00:17:47,580
.سحقًا

281
00:17:48,040 --> 00:17:50,000
.أنا لن أخسرها هنا

282
00:17:51,040 --> 00:17:54,210
...أنا العالم المجنون

283
00:17:54,210 --> 00:17:56,840
.هويين كيوما

284
00:18:04,980 --> 00:18:06,310
...لن أقوم

285
00:18:09,020 --> 00:18:09,940
...عليّ

286
00:18:13,020 --> 00:18:14,610
...أن

287
00:18:16,950 --> 00:18:17,900
...أخبرها

288
00:18:20,780 --> 00:18:21,870
تخبرني بماذا؟

289
00:18:31,540 --> 00:18:33,460
.الآن أنا أهلوس

290
00:18:33,460 --> 00:18:35,130
ما الذي تتكلّم عنه؟

291
00:18:35,130 --> 00:18:39,220
.إنّ ما تراه هو حقيقةٌ تلتقطها شبكية عيناك وترسلها لدماغك

292
00:18:41,180 --> 00:18:42,470
.وجدتك أخيرًا

293
00:18:48,270 --> 00:18:51,480
.إذا كنتِ ستنقذين أحدهم، عليكِ التأكّد من أنّ لديكِ ما يكفي من البنزين أوّلاً

294
00:18:51,480 --> 00:18:53,900
.هذا ليس خطأي، لقد كنت مسرعة

295
00:18:53,900 --> 00:18:55,030
ماذا عن هاتفكِ؟

296
00:18:56,610 --> 00:18:57,030
.عديمة الفائدة

297
00:18:57,440 --> 00:18:58,860
.بطارية الهاتف بلا طاقة

298
00:18:58,860 --> 00:19:00,530
.67سنت

299
00:19:00,530 --> 00:19:03,330
.وتكذب على نفسك وتسير على الطريق

300
00:19:03,330 --> 00:19:05,200
.لا أريد سماع هذا منك

301
00:19:05,870 --> 00:19:07,160
.ليس باليد حيلة

302
00:19:07,580 --> 00:19:11,080
.لقد جريت خلف شخصٍ كنت أظنّ أنّي أعرفه

303
00:19:11,460 --> 00:19:12,920
شخصٌ تعرفه؟

304
00:19:12,920 --> 00:19:13,630
.أجل

305
00:19:14,170 --> 00:19:15,130
ماذا؟

306
00:19:16,090 --> 00:19:19,220
.اعتقدت أنّك هربت بسبب ما قلته لك

307
00:19:19,760 --> 00:19:20,630
.أجل

308
00:19:22,010 --> 00:19:23,890
عن ماذا تتكلّمين؟

309
00:19:24,890 --> 00:19:25,930
.لا شيء

310
00:19:26,350 --> 00:19:27,350
...ذلك

311
00:19:27,970 --> 00:19:29,640
...عندما قلت أنّي نسيت كلّ شيء

312
00:19:30,100 --> 00:19:31,230
.ذلك الشيء

313
00:19:31,980 --> 00:19:34,440
.لا تقلها بعدم اهتمام هكذا

314
00:19:35,070 --> 00:19:37,610
.إنّه حقًّا أمرٌ مهم بالنسبة لي

315
00:19:37,610 --> 00:19:38,740
مهم؟

316
00:19:38,740 --> 00:19:39,690
...أعني

317
00:19:41,110 --> 00:19:42,240
...ذلك

318
00:19:42,950 --> 00:19:43,820
ألم أخبرك؟

319
00:19:44,780 --> 00:19:47,370
.كان لديّ حلمٌ غريب آخر

320
00:19:47,370 --> 00:19:49,950
.وأنا لا استطيع التوقّف عن التفكير به

321
00:19:50,540 --> 00:19:53,210
...بدا واقعيًّا جدًّا بالنسبة لحلم، لذا

322
00:19:53,210 --> 00:19:54,040
.إنّه حقيقي

323
00:19:56,380 --> 00:19:57,960
...كما قلت، إنّه حقيقي

324
00:19:57,960 --> 00:19:59,210
.بالنسبة لي

325
00:19:59,210 --> 00:20:00,630
ما الذي تعنيه؟

326
00:20:00,630 --> 00:20:03,840
.في خطّ عالمٍ آخر، قلت لكِ إنّي أحبّكِ

327
00:20:05,350 --> 00:20:07,510
.لا، أنا أحبّكِ الآن

328
00:20:09,770 --> 00:20:11,020
ماذا عنكِ؟

329
00:20:14,980 --> 00:20:16,060
.أنت غير منصف

330
00:20:17,110 --> 00:20:21,570
،لابدّ أنّك قضيت الكثير من الوقت معي في خطّ العالم الآخر

331
00:20:22,150 --> 00:20:27,030
.لكن بالنسبة لي، كان كلّ هذا كالحلم

332
00:20:27,580 --> 00:20:29,990
.من الصعب عليّ تحمّل هذا

333
00:20:37,130 --> 00:20:39,710
."لديّ قدرةٌ تدعى "قراءة شتاينر

334
00:20:40,590 --> 00:20:43,090
.لهذا أحتفظ بكلّ ذكرياتي بين خطوط العالم

335
00:20:43,930 --> 00:20:45,640
...لهذا أذكر

336
00:20:46,510 --> 00:20:48,260
.هذه الأسابيع الثلاثة التي قضيتها معه...

337
00:20:48,640 --> 00:20:52,100
.لا، لقد كانتْ أكثر وأكثر من ثلاث أسابيع

338
00:20:52,770 --> 00:20:55,230
،لكنّي أعلم شيئًا واحدًا عرفته من بقائي معكِ لمدّةٍ طويلة

339
00:20:56,190 --> 00:21:00,280
،في أيّ خطّ عالم، وأيّ وقت، وأينما كنت

340
00:21:00,980 --> 00:21:02,530
.فإنّي دائمًا أحبّكِ

341
00:21:04,280 --> 00:21:07,120
.سأقولها مرّةً أخرى، ماكسي كريسو

342
00:21:07,660 --> 00:21:09,120
.أنا أحبّكِ

343
00:21:10,790 --> 00:21:12,080
ماذا عنكِ؟

344
00:21:12,910 --> 00:21:14,750
،الآن وفي هذه اللحظة

345
00:21:15,620 --> 00:21:17,880
كيف تشعرين نحوي؟

346
00:21:19,500 --> 00:21:20,670
...أنا

347
00:21:22,460 --> 00:21:25,010
هل تريد المعرفة حقًّا؟

348
00:21:48,160 --> 00:21:50,030
.اغلق عينيك