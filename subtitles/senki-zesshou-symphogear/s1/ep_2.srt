1
00:00:28,620 --> 00:00:34,000
أنتِ أنانيةٌ جداً، كلّ البيانات
المحفوظة هُنا عن الآثار هي ملكُنا الآن

2
00:00:36,370 --> 00:00:43,330
لم تعودوا بحاجةٍ إليّ الآن
بعدما مهّدتُ لكم الطريق، يا لها من وقاحة

3
00:01:01,520 --> 00:01:10,040
أعلمُ بأنكم لستُم الأشخاص الوحيدين الذين عثروا
على هذا المكان، لِذا موتوا فحسب يا قِردة الولايات المتّحدة الحُثالة

4
00:01:11,910 --> 00:01:19,200
العمّ سام السخيف
لم يطّلع حتّى على أعماق الفنون السوداء

5
00:01:21,290 --> 00:01:22,080
أطلِقوا النار

6
00:02:59,060 --> 00:03:03,980
الحلقة 10
ما لا يستطيع صنعه سِوى الأيدي المُتشابِكة

7
00:03:01,110 --> 00:03:03,150
نستأذن

8
00:03:20,730 --> 00:03:24,260
ما هذا؟ هل ألهمَتْكِ الجوقة؟

9
00:03:24,260 --> 00:03:29,600
مجرَّد الاستماع للأغنيةِ المدرسيّةِ هنا
يجعلُني أشعرُ بالاسترخاء

10
00:03:29,600 --> 00:03:31,910
هذا يسكِنُ الروحَ حقّاً

11
00:03:31,910 --> 00:03:35,060
وينسرُّ خاطري كلّما تذكّرت
أنَّ الجميع حاضرون هنا

12
00:03:35,060 --> 00:03:37,280
أشعرُ وكأنَّني في منزلي

13
00:03:37,910 --> 00:03:41,250
لقد مضى شهران منذُ قدومي إلى هنا أيضاً

14
00:03:41,620 --> 00:03:44,570
ولكن حدثَ الكثير على مدى هذين الشهرين

15
00:03:44,910 --> 00:03:47,170
نعم، معكِ حقّ

16
00:04:01,830 --> 00:04:04,280
ما الذي يجري هنا...؟

17
00:04:06,970 --> 00:04:09,260
...لا، لم أكن أنا! لا

18
00:04:09,260 --> 00:04:10,270
...كان

19
00:04:19,180 --> 00:04:22,500
لا أحد يُشكِّكُ بكِ

20
00:04:22,690 --> 00:04:26,550
كلّ هذا من صنيع امرأة نعرفُها جيّداً

21
00:04:31,380 --> 00:04:32,230
سيادة القائد كازاناري

22
00:04:53,910 --> 00:04:56,090
ما الذي يجري هنا؟

23
00:04:56,400 --> 00:04:58,810
استخدمتُ طاقتي الروحيّة لحمايتنا

24
00:04:58,810 --> 00:05:00,670
!هذا ليسَ سُؤالي

25
00:05:02,300 --> 00:05:06,320
لماذا يحميني شخصٌ لا يستطيع استخدام درع؟

26
00:05:08,350 --> 00:05:12,080
،أنا أحميكِ لأنّني أكثر نضجاً منكِ

27
00:05:12,080 --> 00:05:14,660
لا لأنني أمتلك أو أفتقر لدرع

28
00:05:14,660 --> 00:05:16,040
نضجاً؟

29
00:05:17,790 --> 00:05:19,960
أكرهُ الناضجين

30
00:05:19,960 --> 00:05:22,430
وأكره أمّي وأبي

31
00:05:22,430 --> 00:05:26,580
الحالِمون والجُبناء، أنا لستُ مثلهم

32
00:05:26,580 --> 00:05:30,700
مساعدة اللّاجئين في مناطِق الحرب؟
إنقاذ العالم بالغِناء؟

33
00:05:30,700 --> 00:05:33,980
ينبغي أن يكونوا قد كبِروا على ذلك الهُراء

34
00:05:34,430 --> 00:05:36,770
كبِروا كثيراً على الأحلام

35
00:05:36,770 --> 00:05:39,390
،لو أرادوا حقاً التخلُّص من الحرب

36
00:05:39,390 --> 00:05:43,570
فينبغي أن يدمِّروا أي شخص
يمتلِك السلطة والرغبة للقتال

37
00:05:43,570 --> 00:05:46,530
هذه هي الطريقةُ الأكثر واقعيّة ومنطقيّة

38
00:05:47,650 --> 00:05:49,940
أهذا ما يحفّزك؟

39
00:05:50,070 --> 00:05:54,990
اسمحي لي أن أسألكِ إذاً: هل تنجحُ هذه الطريقة؟

40
00:05:55,490 --> 00:05:57,120
...في الواقع

41
00:05:57,440 --> 00:06:00,400
"قلتِ "كبِروا كثيراً على الأحلام

42
00:06:00,650 --> 00:06:01,950
على العكس

43
00:06:02,000 --> 00:06:04,660
تحلمين لأنّكِ كبرتِ

44
00:06:05,330 --> 00:06:09,040
عندما تكبرين، تطولُ قامتكِ وتصبحين أقوى

45
00:06:09,040 --> 00:06:12,130
وتزدادُ النقودُ في محفظتكِ

46
00:06:13,090 --> 00:06:16,170
ما كان مُجرَّد أحلام عندما كنتِ صغيرة

47
00:06:16,170 --> 00:06:19,480
قد يُصبِح حقيقة حالما تكبُرين

48
00:06:19,950 --> 00:06:22,140
هنالِك معنى أعمق للأحلام

49
00:06:23,270 --> 00:06:26,850
هل ذهبَ والداكِ إلى منطقةِ حرب ليحلمان؟

50
00:06:27,180 --> 00:06:28,400
لا

51
00:06:28,850 --> 00:06:32,530
أرادا أن يجعلا حلمَ السَّلامِ بالغِناءِ حقيقة

52
00:06:32,580 --> 00:06:36,540
ودخلا الجحيمَ في الأرضِ لتحقيق ذلك

53
00:06:37,520 --> 00:06:39,790
لماذا... لماذا تقول...؟

54
00:06:40,070 --> 00:06:42,460
أرادوا أن يُثبِتوا لكِ

55
00:06:42,750 --> 00:06:46,660
الحقيقة والتي لا جدل حولها
وهي أنَّ الأحلام تتحقّق

56
00:06:48,680 --> 00:06:51,170
،قلتِ أنّكِ تكرهينهما

57
00:06:51,330 --> 00:06:56,820
لكنني على يقين بأنّ والديكِ يُحبّانكِ كثيراً

58
00:07:23,370 --> 00:07:25,420
...لا ينبغي عليّ

59
00:07:25,930 --> 00:07:28,200
لا تستطيعين اصطحابي؟

60
00:07:30,950 --> 00:07:34,880
لستِ وحيدة كما تظنّين

61
00:07:35,770 --> 00:07:41,850
حتّى لو سلكتِ دربكِ الخاص
سيتقاطعُ مع دربنا في المستقبل القريب

62
00:07:41,850 --> 00:07:46,360
هل كنَّا أعداء حتّى اللحظة
فأصبح من المُفترَض أن نصبح أصدقاء الآن؟

63
00:07:46,440 --> 00:07:49,680
ألستَ كبيراً على مثل هذه البديهيات؟

64
00:07:50,170 --> 00:07:52,870
!يا للسخرية

65
00:07:53,580 --> 00:07:54,070
خذي

66
00:07:56,030 --> 00:07:57,660
جهاز إرسال؟

67
00:07:57,660 --> 00:08:02,300
أجل، سيتيحُ لكِ إمكانيّة استخدام المُواصلات
العامّة إلى حدّ معيّن

68
00:08:02,300 --> 00:08:04,710
وبمقدوركِ الشراء من آلاتِ البيع أيضاً

69
00:08:04,710 --> 00:08:05,690
إنها مفيدة

70
00:08:06,570 --> 00:08:07,770
كادينغير

71
00:08:09,200 --> 00:08:12,520
"ظلَّتْ فيني تقولُ تِلك الكلمة "كادينغير

72
00:08:12,520 --> 00:08:14,710
لا أعرف ماذا تعني

73
00:08:14,710 --> 00:08:17,910
...ولكن ظلَّتْ تقولُ أنّها اكتملَتْ

74
00:08:17,950 --> 00:08:19,160
كادينغير؟

75
00:08:21,720 --> 00:08:23,630
سئمتُ من إضاعةِ الوقت

76
00:08:23,630 --> 00:08:25,560
سنُبادرُ بالهجومِ عليها

77
00:08:35,050 --> 00:08:36,670
نعم، هنا تسوباسا

78
00:08:36,670 --> 00:08:37,580
هُنا هيبيكي

79
00:08:37,580 --> 00:08:39,180
لقد توصّلنا إلى شيء

80
00:08:39,700 --> 00:08:40,580
أين ريوكو-كون؟

81
00:08:40,840 --> 00:08:42,750
لم تأتِ بعد

82
00:08:42,750 --> 00:08:44,450
لم نسمع عنها شيئاً منذُ هذا الصباح

83
00:08:44,810 --> 00:08:46,030
هكذا إذاً

84
00:08:46,030 --> 00:08:48,190
أنا على يقين بأنها بخير

85
00:08:48,580 --> 00:08:53,300
إن هاجمَها أحد فستُدمِّرُه
كما فعلَتْ عندما حمَتْني

86
00:08:53,300 --> 00:08:58,590
...لا، الآنسة ساكوراي لم تتدرّب على القتال، إنها

87
00:08:58,590 --> 00:09:04,200
ماذا؟ ألا يمتلك القائد وريوكو-سان قوّةً خارقة؟

88
00:09:11,610 --> 00:09:13,860
استطعتُ الاتّصال أخيراً

89
00:09:13,860 --> 00:09:15,990
آسفة، أسهبتُ في النوم

90
00:09:15,990 --> 00:09:18,610
...وجهاز إرسالي لا يعمل

91
00:09:19,830 --> 00:09:23,170
هل أنتِ بخير يا ريوكو-كون؟ هل أصابكِ مكروه؟

92
00:09:23,170 --> 00:09:25,960
أسهبتُ في النّوم ونسيتُ إزالة القمامة

93
00:09:25,960 --> 00:09:27,250
هل من مُشكلة؟

94
00:09:27,250 --> 00:09:28,690
طمأنْتِني

95
00:09:28,690 --> 00:09:30,060
جيّد إذاً

96
00:09:30,160 --> 00:09:32,080
وددتُ أن أطرحَ عليكِ سؤالاً

97
00:09:32,080 --> 00:09:34,760
أنتَ عجولٌ دوماً، ما الأمر؟

98
00:09:35,470 --> 00:09:36,680
كادينغير

99
00:09:37,090 --> 00:09:39,300
ما الذي تعنيه تِلك الكلمة؟

100
00:09:40,160 --> 00:09:44,810
"إنَّ "كادينغير" كلمة سومريّة تُطلَقُ على أولئك "المُقدّسين

101
00:09:44,810 --> 00:09:48,380
من هذا المُنطلَق، باتَتْ تعني برجاً
شاهقاً يبلغُ عنان السّماء

102
00:09:48,930 --> 00:09:52,420
،إن بنى شخصٌ برجاً كهذا

103
00:09:52,420 --> 00:09:54,770
فكيفَ لنا ألّا نُلاحظه؟

104
00:09:55,150 --> 00:09:58,030
...هذا غريب بعض الشيء

105
00:09:58,650 --> 00:10:01,650
مع ذلك، حصَلنا على دليل أخيراً

106
00:10:01,940 --> 00:10:04,820
إن استمررنا في جمعِ المعلومات
فكأنّنا فزنا

107
00:10:05,180 --> 00:10:08,150
سنستغلُّ ثغرةً لدى العدو ونُوجِّه له ضربة مُوجِعة

108
00:10:08,150 --> 00:10:11,430
هذه هي المعركة الأخيرة، لا تُفسِدا الأمر

109
00:10:11,430 --> 00:10:13,040
حاضر

110
00:10:13,040 --> 00:10:17,640
ثمّة أمر أودُّ تولِّيه أولاً
ومن ثمّ سأتوجهُ إلى هناك مُباشرةً

111
00:10:18,470 --> 00:10:22,290
...كادينغير، برج سرِّي لا يعرفه أحد

112
00:10:22,290 --> 00:10:26,540
حتّى البحث لا يُظهِر أي نتيجة
سِوى حلولاً كامِلة للألعاب

113
00:10:31,940 --> 00:10:36,940
ابحثوا عن أي معلومة متعلِّقة بكادينغير
مهما كانَتْ صغيرة

114
00:10:37,910 --> 00:10:38,470
ما الخطب؟

115
00:10:39,290 --> 00:10:42,420
ثلاثة من النويز المُدرَّع الطائر في آن واحد

116
00:10:42,820 --> 00:10:44,830
لا، هُناك آخر

117
00:10:46,810 --> 00:10:47,830
إنه ضخم

118
00:10:47,830 --> 00:10:50,210
اهربوا

119
00:10:55,840 --> 00:10:58,590
أربعة بالمُجمل، أنا قادمة حالاً

120
00:11:00,670 --> 00:11:04,440
إنه لا يُهاجم أحداً
يكتفي بالحركةِ فحسب؟

121
00:11:04,440 --> 00:11:06,440
نعم، نعم

122
00:11:06,590 --> 00:11:07,800
هيبيكي؟

123
00:11:07,970 --> 00:11:11,470
أنا بخير، أنا وتسوباسا-سان سنُعالجُ الأمر

124
00:11:11,470 --> 00:11:13,430
لِذا عودي إلى المدرسة يا ميكو

125
00:11:13,430 --> 00:11:14,730
إلى ليديان؟

126
00:11:14,730 --> 00:11:20,110
إن ساءَ الأمر فسنضطرُّ لفتح ملاجئ
تحت الأرض ونُخلي الناس

127
00:11:20,400 --> 00:11:23,030
أريدُكِ أن تساهمي في ذلك

128
00:11:23,580 --> 00:11:26,120
حسناً، عُلِم

129
00:11:26,550 --> 00:11:29,310
...آسِفة لتوريطكِ في هذا الأمر

130
00:11:29,310 --> 00:11:32,540
لا، لا مُشكلة

131
00:11:33,000 --> 00:11:35,170
أستطيعُ العودة إلى ليديان

132
00:11:35,170 --> 00:11:39,760
لأنّ هذا يعني أنّكِ مهما ابتعدتِ

133
00:11:39,760 --> 00:11:44,020
سيكونُ لديك دِيار تعودين إليه

134
00:11:44,800 --> 00:11:47,060
...ديار أعودُ إليه

135
00:11:47,060 --> 00:11:49,560
هذا صحيح، لِذا اذهبي

136
00:11:49,670 --> 00:11:54,540
سأكونُ قوية بما يكفي لحمايةِ
ما هو عزيز عليّ، مثلكِ تماماً

137
00:12:03,470 --> 00:12:07,050
ميكو كوهيناتا هي زهرةُ عبّاد الشمس خاصّتي

138
00:12:07,180 --> 00:12:09,950
،أدفأ لحظة هي عندما أكونُ بجانبكِ

139
00:12:09,950 --> 00:12:12,410
وهي المكانُ الذي أعودُ إليه دوماً

140
00:12:12,410 --> 00:12:15,420
لطالما كانَ الأمرُ كذلك وسيبقى كذلك

141
00:12:15,660 --> 00:12:18,100
لهذا سأعودُ مهما حدث

142
00:12:19,170 --> 00:12:20,490
...هيبيكي

143
00:12:20,560 --> 00:12:24,370
فنحنُ لم نرَ الشهبَ سويةً معاً

144
00:12:24,440 --> 00:12:25,180
نعم

145
00:12:25,450 --> 00:12:27,020
حسناً، إلى اللقاء

146
00:12:36,700 --> 00:12:37,630
تسوباسا تتكلّم

147
00:12:38,170 --> 00:12:41,230
هذه آخر الأنباء المتعلِّقة بالطرق التي يسلكُها النويز

148
00:12:41,790 --> 00:12:42,530
نعم

149
00:12:43,370 --> 00:12:50,790
النويز الذي ظهرَ في المنطقة 41 يتوجّه
صوبَ المنطقة 28 عبرَ المنطقة 33

150
00:12:51,040 --> 00:12:57,290
كذلك الأمر، النويز من المنطقتَين
ثمانية عشر وتسعة عشر يتوجّهان صوب المنطقة 24

151
00:12:57,530 --> 00:12:58,390
...و

152
00:12:58,390 --> 00:12:59,890
سيّدي، انظر إلى هذا

153
00:12:59,890 --> 00:13:03,920
كافّة النويز يتوجّهون نحو برج سماء طوكيو

154
00:13:05,750 --> 00:13:07,930
برج سماء طوكيو؟

155
00:13:08,250 --> 00:13:13,200
إذا كانَتْ كادينغير تعني برج
ألا يعني هذا أنَّ برج السماء هو الأنسب؟

156
00:13:14,210 --> 00:13:18,030
يعملُ برجُ السماءُ كنظام رقابة

157
00:13:18,030 --> 00:13:23,300
لقواعد معلومات الفرع 2

158
00:13:24,140 --> 00:13:27,320
كلتاكما، توجّها نحو برج سماء طوكيو حالاً

159
00:13:29,310 --> 00:13:31,260
...حتّى لو كان فخّاً

160
00:13:35,220 --> 00:13:38,970
...برج السماء... لكنّه بعيد جداً

161
00:13:43,880 --> 00:13:47,840
عملُنا هو جعل المستحيل مُمكِناً

162
00:15:17,710 --> 00:15:18,840
الوميض الأزرق

163
00:15:28,560 --> 00:15:32,410
لم أكن أدري بأنَّ التخلِّي عن الأرضيّة العالية
هو بهذا السوء الكبير

164
00:15:32,410 --> 00:15:34,970
بمقدورنا استخدام الحوّامات
للهجوم من السماء أيضاً

165
00:15:38,620 --> 00:15:39,530
...لا

166
00:15:39,530 --> 00:15:40,830
اللّعنة عليهم

167
00:15:51,240 --> 00:15:53,950
نويز طائر... ماذا نفعل؟

168
00:15:53,950 --> 00:15:55,630
لا تخافي يا تاتشيبانا

169
00:15:55,630 --> 00:15:59,250
إذا فشِلَ الحامي فسيكسر العدوّ
حدودَ البلد

170
00:16:13,840 --> 00:16:18,680
أتيتُ إلى هنا لأنّ هذا الشيء
الغبيّ لا يصمت

171
00:16:18,680 --> 00:16:23,120
ولا تُسيئا الفهم، لم آتِ لمساعدتكما

172
00:16:23,370 --> 00:16:27,050
أتَتْ للمساعدة، لقد تأخرتِ قليلاً

173
00:16:29,050 --> 00:16:30,300
أتَتْ للمُساعدة؟

174
00:16:30,300 --> 00:16:35,760
هذا صحيح، مُحارِبة الأثر الثاني، إتشيفال

175
00:16:36,080 --> 00:16:37,290
كريس يوكيني

176
00:16:37,290 --> 00:16:42,220
كريس-تشان، شكراً لكِ
عرفتُ بأنَّنا بمقدورنا فهم بعضنا الآخر

177
00:16:42,220 --> 00:16:45,650
غبيّة، ألم تسمعيني؟

178
00:16:45,650 --> 00:16:48,020
علينا التّعاون معاً حالياً لمقاتلة النويز

179
00:16:48,550 --> 00:16:52,120
سأعالجُ هذه المسألة بنفسي
لا تعترضا طريقي

180
00:17:00,570 --> 00:17:04,530
بمقدورها مُقاتلة النويز في السماء
سنتولّى أمرَ النويز البرِّي

181
00:17:04,530 --> 00:17:05,550
حـ..حسناً

182
00:17:22,680 --> 00:17:25,050
نعم، سأدمّره بالكامل

183
00:17:25,990 --> 00:17:29,650
عليكِ أن تحافظي على رباطة جأشكِ
أتعتقدين أنّكِ تقاتلين بمفردكِ؟

184
00:17:29,900 --> 00:17:32,100
أنا وحيدةٌ دوماً

185
00:17:32,100 --> 00:17:35,440
لسنا زميلات على الإطلاق

186
00:17:37,200 --> 00:17:41,020
قد تكوني محقّة، ولكن لا سبب يدفعُنا للقتال

187
00:17:41,250 --> 00:17:42,620
ولكن بالرّغم من ذلك

188
00:17:42,750 --> 00:17:45,520
لا سبب يدفعُنا لعدمِ القتال

189
00:17:45,540 --> 00:17:47,840
فقد كنَّا نتقاتلُ منذُ فترة ليسَتْ ببعيدة

190
00:17:47,840 --> 00:17:50,420
...لا يمكن للناس أن

191
00:17:52,230 --> 00:17:53,620
!نستطيع

192
00:17:53,620 --> 00:17:55,810
نستطيعُ أن ننسجمَ مع أي أحد

193
00:18:04,350 --> 00:18:09,370
كنتُ أتساءلُ لماذا لم أحصل
على درع مُصفَّح

194
00:18:09,370 --> 00:18:13,370
لطالما كرِهتُ الإحساسَ بالنقص

195
00:18:13,370 --> 00:18:16,220
لكنّني لا أفكِّر بتِلك الطريقة الآن

196
00:18:16,220 --> 00:18:18,710
،لأنني لا أمسِك بأي سلاح

197
00:18:19,160 --> 00:18:21,700
لهذا أستطيعُ الإمساك بأيديكما

198
00:18:22,160 --> 00:18:24,200
أستطيعُ أن أكون صديقتكما

199
00:18:24,930 --> 00:18:26,370
تاتشيبانا؟

200
00:18:46,690 --> 00:18:49,020
هل تصغين إلى هذه الغبيّة؟

201
00:18:49,260 --> 00:18:50,870
ربّما

202
00:18:51,110 --> 00:18:53,650
وأنا على يقين أنكِ كذلك أيضاً

203
00:18:54,590 --> 00:18:56,030
مستحيل

204
00:19:02,910 --> 00:19:05,390
علينا أن نقضي على الزعيم
وإلَّا فلن ينتهي هذا الأمر

205
00:19:05,390 --> 00:19:08,230
لديّ فكرةٌ إذاً

206
00:19:08,230 --> 00:19:10,540
فكرة لا يستطيعُ تنفيذها سوايّ

207
00:19:10,640 --> 00:19:14,720
إنَّ إتشيفال مختصّ في الهجمات
واسِعة وبعيدة النطاق

208
00:19:14,760 --> 00:19:16,390
سأُطلِقُ طلقةً انفجاريّة نحوه

209
00:19:16,890 --> 00:19:18,660
هل ستغنِّين أغنيتكِ النهائية...؟

210
00:19:18,660 --> 00:19:19,100
غبيّة

211
00:19:19,370 --> 00:19:21,800
حياتي ليسَتْ رخيصة إلى هذا الحدّ

212
00:19:21,800 --> 00:19:23,470
كيف إذاً؟

213
00:19:27,550 --> 00:19:32,340
سأظلُّ أشحنها حتّى تبلغ الحدّ
ومن ثمّ أطلقها كلّها في آن واحد

214
00:19:33,010 --> 00:19:36,380
ولكن أثناء الشحن، ستكونين مكشوفة

215
00:19:36,380 --> 00:19:39,480
ستكونين في خطر في ظلّ
وجود هذا العدد الكبير من الأعداء

216
00:19:40,020 --> 00:19:45,370
هذا صحيح، ولكن... يمكنُنا حمايتها

217
00:19:55,550 --> 00:19:57,830
لم يطلبْ أحدٌ شيئاً منها

218
00:19:57,850 --> 00:20:00,300
ولكن لا أستطيع التراجع بعد ذلك

219
00:20:08,310 --> 00:20:11,430
هنالِك يدٌ ممدودةٌ لكلِ فردٍ يستطيعُ الإمساك بها

220
00:20:11,450 --> 00:20:14,700
معركتي هي الإمساكُ بيدِ شخص

221
00:20:15,610 --> 00:20:18,820
إنَّها قوّة التدمير، أو قوّة الربط

222
00:20:19,570 --> 00:20:21,740
ذاك درع تاتشيبانا المُصفَّح

223
00:20:25,320 --> 00:20:26,320
القرارُ عائد لك

224
00:21:11,070 --> 00:21:12,910
هل نجحنا؟

225
00:21:12,910 --> 00:21:14,220
نجحنا بالطبع

226
00:21:22,970 --> 00:21:26,090
!نجحنا، مرحى

227
00:21:26,090 --> 00:21:28,840
توقّفي يا غبيّة، ماذا تفعلين؟

228
00:21:30,050 --> 00:21:32,890
ربِحا بفضلكِ

229
00:21:32,890 --> 00:21:36,090
قلتُ توقّفي

230
00:21:36,090 --> 00:21:39,540
اسمعي، أنا لستُ صديقتكِ

231
00:21:39,540 --> 00:21:44,940
كُل ما أريده هو تسوية الأمر مع فيني
وأحقِّق حلمي الجديد

232
00:21:45,370 --> 00:21:47,350
حلم؟ ألديكِ حلم؟

233
00:21:47,350 --> 00:21:49,900
ما هو؟ أخبريني

234
00:21:49,900 --> 00:21:51,400
اصمتي يا غبيّة

235
00:21:51,400 --> 00:21:52,850
يا لكِ من غبيّة

236
00:21:56,480 --> 00:21:57,210
نعم؟

237
00:21:57,210 --> 00:22:01,410
هيبيكي؟ مدرسة... ليديان
_تتعرّض لهجوم من الداخل

238
00:22:05,990 --> 00:22:09,950
يتبع