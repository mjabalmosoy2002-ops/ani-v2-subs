1
00:00:08,070 --> 00:00:13,950
قالَتْ فيني بأنّكِ تحتاجين لكثير
من التّضخيم
الصوتي لتفعيلِ أثر مُكتمِل

2
00:00:15,080 --> 00:00:19,030
،ما استغرقَني ستّة أشهر لأفعله بعصا سُليمان

3
00:00:19,030 --> 00:00:21,200
فعلَتْه هي بلمح البصر

4
00:00:23,310 --> 00:00:24,370
...وليسَ ذلك فحسب

5
00:00:24,910 --> 00:00:27,620
أطلقَتْ عنانَ قوّتها بالكامل

6
00:00:31,180 --> 00:00:32,780
إنّها وحش

7
00:02:03,540 --> 00:02:08,180
الحلقة 6
حيثُ تؤدِّي الطوالِع

8
00:02:10,100 --> 00:02:13,770
فيني مهووسةٌ جداً بتِلك الفتاة

9
00:02:13,770 --> 00:02:16,620
لدرجة أنَّها تطلبُ منِّي أقبضُ عليها؟

10
00:02:25,810 --> 00:02:30,750
وحينها سأكونُ وحيدة مُجدّداً

11
00:02:43,440 --> 00:02:47,520
أعرفُ ما حلَّ بي

12
00:02:48,360 --> 00:02:52,420
لستِ بحاجةٍ لاستعمال هذا، سأفعلُ ما تشائين

13
00:02:53,740 --> 00:02:57,470
سأريكِ بأنني أفضل منها

14
00:02:57,870 --> 00:03:02,580
سأدمِّرُ أي شخص يحظى بقوّةٍ سِوايّ

15
00:03:02,580 --> 00:03:05,170
هذا ما أُريده

16
00:03:23,730 --> 00:03:26,470
...كانادي، أريدُ رؤيتها أيضاً

17
00:03:27,700 --> 00:03:30,590
وإلَّا فلن أتمكَّن من الوقوف
معكِ جنباً إلى جنب

18
00:03:30,970 --> 00:03:34,840
...ما وراء المعركة، في الجانبِ الآخر

19
00:03:35,760 --> 00:03:37,380
أريدُ أن أتبيّنَ بنفسي

20
00:03:39,260 --> 00:03:44,030
تسوباسا-سان، لقد خرجتِ للتو من العناية
...المركَّزة، لا تضغطي على نفسكِ

21
00:03:47,930 --> 00:03:49,500
أنا آسفة

22
00:04:02,290 --> 00:04:04,970
كانَتْ قوّة دوراندال خارج السيطرة

23
00:04:04,970 --> 00:04:08,350
ما يخيفني ليسَ عجزي عن التحكُّمِ بها

24
00:04:08,670 --> 00:04:12,570
إنَّما استخدامي لها على تِلك
الفتاة دون أدنى تردُّد

25
00:04:13,340 --> 00:04:16,940
...أنا دائماً ضعيفةٌ جداً

26
00:04:28,030 --> 00:04:31,120
لا يكفي أن أتوقّفَ عندَ الهدف

27
00:04:31,120 --> 00:04:33,570
عليّ أن أبتعد أكثر

28
00:04:33,860 --> 00:04:35,430
...أكثر

29
00:04:35,430 --> 00:04:36,580
أكثر

30
00:04:41,080 --> 00:04:43,210
تبّاً، أنتِ تضغطين على نفسكِ كثيراً

31
00:04:43,550 --> 00:04:46,870
آسفة، كنتُ أُفكِّرُ فقط فشرَدت

32
00:04:46,870 --> 00:04:48,970
أنتِ فتاةٌ غريبة الأطوار

33
00:04:48,970 --> 00:04:52,980
آسِفة لجعلكِ تفعلين ذلك في صباحِ يوم أحد

34
00:04:52,980 --> 00:04:58,760
،لا مُشكلة، لقد استمتعت
ذكّرَني ذلك بالمدرسة الإعداديّة

35
00:04:58,760 --> 00:05:00,660
حتّى بعد ركض كل تِلك المسافة؟

36
00:05:00,660 --> 00:05:04,240
لا عجبَ فقد كنتِ جزءاً من فريقِ المضمار

37
00:05:04,240 --> 00:05:08,460
أنا مُتعبةٌ للغاية لدرجة أعجزُ
فيها حتّى عن تحريك ساقيّ

38
00:05:10,770 --> 00:05:11,990
هيبيكي

39
00:05:11,990 --> 00:05:15,980
لقد تغيّرتِ منذُ مجيئكِ إلى ليديان

40
00:05:15,980 --> 00:05:19,510
لم تكوني تحبِّين بذل قصارى
جهدكِ في أي شيء

41
00:05:19,540 --> 00:05:23,670
حقاً؟ لا أظنُّني قد تغيَّرت

42
00:05:25,010 --> 00:05:27,470
هل ظهرَتْ لكِ بعض العضلات؟

43
00:05:27,470 --> 00:05:30,570
وانظري، أنتِ مليئةٌ بالخدوش

44
00:05:30,570 --> 00:05:31,380
ماذا حدث؟

45
00:05:31,380 --> 00:05:33,390
هُنا، وهُنا أيضاً

46
00:05:34,410 --> 00:05:36,930
توقّفي، توقّفي، توقّفي
توقّفي، توقّفي، توقّفي

47
00:05:39,920 --> 00:05:43,090
يجدرُ بكِ أن تدعيني لتناول أوكونومياكي
في مطعم الزهرة

48
00:05:43,520 --> 00:05:46,460
كامتنانٍ على اصطحابي لكِ في يوم الأحد

49
00:05:47,160 --> 00:05:49,810
بالفعل فقد سمِعتُ أنَّ الأوكونومياكي هُناك

50
00:05:49,810 --> 00:05:52,740
...هو الأطيب مُقارنة بأي مطعم آخر، ولكن

51
00:05:52,980 --> 00:05:55,090
حُسِمَ الأمرُ إذاً

52
00:05:55,110 --> 00:05:58,370
أتطلَّعُ قُدماً حقّاً لتناول الأوكونومياكي في الزهرة

53
00:05:58,860 --> 00:06:00,880
أهذا كافٍ حقاً؟

54
00:06:00,880 --> 00:06:03,840
نعم، هذا ما أريده

55
00:06:04,830 --> 00:06:09,590
نعم، تأبين تذكاري لوزير
الدفاع هيروكي، صحيح؟

56
00:06:09,850 --> 00:06:13,030
أجل، ربّما نكونُ قد اختلفنا أحياناً

57
00:06:13,030 --> 00:06:15,900
ولكن لطالما أبدى اهتماماً بما كان لصالحِنا

58
00:06:16,450 --> 00:06:20,000
لقد فقدنا حليفاً قوياً

59
00:06:21,130 --> 00:06:23,040
ما الأوضاع هنا؟

60
00:06:23,150 --> 00:06:26,160
%سبَقْنا التَّاريخَ المحدَّد بـ 17

61
00:06:26,160 --> 00:06:30,070
بصراحة، أشعرُ بالطمأنينة بعد
أن أُلغيَتْ خطّة نقل دوراندال

62
00:06:30,360 --> 00:06:34,930
وها نحنُ نشدِّدُ الأمنَ في المقرّ أيضاً

63
00:06:35,290 --> 00:06:41,210
صُمِّمَ هذا المكان بحيثُ يكون
قابِلاً للتطوير إن اقتضى الأمر

64
00:06:41,470 --> 00:06:46,210
وهذه الخطّة أرسلتُها للحكومةِ منذُ مدّة طويلة

65
00:06:46,670 --> 00:06:50,710
ولكن ألم يُعارِض كثيرٌ من أعضاء
جمعية التشاور ذلك؟

66
00:06:51,050 --> 00:06:55,480
كان زعيمُ المعارضة وزير الدفاع هيروكي آنذاك

67
00:06:56,390 --> 00:06:59,790
قال بأنه لم يكن من الصَّواب إنفاق الكثير
من المال الضريبي على مشروع غير رسمي

68
00:06:59,790 --> 00:07:03,250
وأنه لم يكن من الصَّواب إعطائنا
صلاحيات غير محدودة خارجة عن اختصاصنا

69
00:07:05,920 --> 00:07:10,660
كان سببُ مُعارضته لذلك هو
،إبقائنا على مسارِ طاعة القانون بصرامة

70
00:07:10,660 --> 00:07:14,640
وذلك كي لا يجد أحدٌ ذلك ذريعةً لإغلاقِ قسمنا

71
00:07:16,310 --> 00:07:20,220
سيّدي، من سيحلُّ بديلاً لوزير الدفاع هيروكي؟

72
00:07:20,220 --> 00:07:22,850
سيحلُّ مكانه نائبُ الوزير

73
00:07:22,850 --> 00:07:28,410
وهو أيضاً واحدٌ من الذين وافقوا
على تمويلِ تطوير القاعدة

74
00:07:28,410 --> 00:07:30,220
...صحيح، ولكن

75
00:07:30,220 --> 00:07:31,500
هل من مُشكلة؟

76
00:07:32,220 --> 00:07:37,640
إنه من المُصفِّقين لأمريكا

77
00:07:37,960 --> 00:07:41,460
الأمر الذي يعني بأنَّ السياسات
المُقترَحة للحكومة

78
00:07:41,460 --> 00:07:44,910
لقوى اليابان الدفاعيّة
هي الأرجح للتطبيق

79
00:07:44,940 --> 00:07:49,010
مُستحيل... هل كانت الحكومة الأمريكيّة
مُتورِّطة في الاغتيال؟

80
00:07:52,630 --> 00:07:56,090
يا للهول! أمامنا مُشكلة على ما يبدو

81
00:07:56,100 --> 00:07:58,360
سأذهبُ لإلقاءِ نظرة

82
00:07:58,360 --> 00:07:59,310
حسناً

83
00:08:02,780 --> 00:08:03,320
نعم؟

84
00:08:04,380 --> 00:08:05,210
نعم

85
00:08:05,510 --> 00:08:07,880
أنا؟

86
00:08:08,360 --> 00:08:10,310
نعم، أنا مشغولٌ الآن بعض الشيء

87
00:08:10,610 --> 00:08:13,190
أنا آسف، ولكن هل يمكنُكِ فعلها؟

88
00:08:13,800 --> 00:08:17,010
فأنتِ الوحيدةُ التي أستطيعُ
أن أطلبَ منها ذلك

89
00:08:18,270 --> 00:08:20,550
بالتأكيد، لكَ ذلك

90
00:08:21,770 --> 00:08:25,440
حسناً إذاً، وداعاً

91
00:08:25,880 --> 00:08:28,360
ميكو؟ ما الأمر؟

92
00:08:28,360 --> 00:08:32,360
...في الواقع، أنا ذاهِبة للتسوُّق

93
00:08:32,440 --> 00:08:34,150
هل تُريدين اصطحابي؟

94
00:08:34,780 --> 00:08:37,320
يمكنُنا الذهاب إلى مطعمِ الزهرة لاحقاً

95
00:08:37,320 --> 00:08:41,040
آسفة، حدثَ أمرٌ مفاجئ

96
00:08:41,040 --> 00:08:42,110
هكذا إذاً

97
00:08:42,110 --> 00:08:46,050
وقُبيلَ دعوتكِ لي... أظنُّني منحوسة

98
00:08:46,050 --> 00:08:46,990
لا

99
00:08:46,990 --> 00:08:50,470
فهمت، في المرّة المُقبِلة إذاً

100
00:08:51,080 --> 00:08:52,520
لا تقلقي حيالَ الأمر

101
00:08:52,520 --> 00:08:56,780
ثمّة كِتاب أودُّ الحصول عليه من المكتبة
لهذا سأذهبُ إلى هناك اليوم

102
00:08:57,260 --> 00:08:58,390
أنا حقّاً آسفة

103
00:09:19,080 --> 00:09:20,640
!أستأذن

104
00:09:22,960 --> 00:09:24,470
تسوباسا-سا...؟

105
00:09:27,850 --> 00:09:29,370
...أيُعقَل

106
00:09:29,370 --> 00:09:30,520
...مستحيل

107
00:09:30,520 --> 00:09:32,250
ماذا تفعلين؟

108
00:09:32,860 --> 00:09:35,900
هل أنتِ بخير؟ هل أنتِ في أمان؟

109
00:09:35,900 --> 00:09:39,490
لماذا تسألين مريضةً في مشفى ما إن كانَتْ بخير؟

110
00:09:39,490 --> 00:09:40,260
...لأنّ

111
00:09:40,510 --> 00:09:41,760
...هذا

112
00:09:47,230 --> 00:09:51,160
خشيتُ أن تكوني قد اختُطِفتِ

113
00:09:51,160 --> 00:09:53,800
كان الناسُ في الفرع 2 يتحدّثون

114
00:09:53,800 --> 00:09:56,190
...عن إمكانيّة قيام دُول أخرى بحياكة مُخطَّطات

115
00:10:02,960 --> 00:10:04,280
...المعذِرة

116
00:10:11,850 --> 00:10:14,730
تبّاً... انسي الأمر

117
00:10:14,730 --> 00:10:18,390
أوغاوا-سان طلبَ منِّي أن آتي للاطمئنانِ عليكِ

118
00:10:18,390 --> 00:10:21,020
لِذا دعيني أقومُ بالتنظيف، اتفقنا؟

119
00:10:21,710 --> 00:10:24,170
...أنا لا

120
00:10:24,170 --> 00:10:27,080
أنا لا أفكِّر بهذه الأمور حقاً

121
00:10:27,080 --> 00:10:32,330
فاجأتِني، ظننتُكِ شخصاً يفعلُ كلّ شيء بشكلٍ مثالي

122
00:10:33,280 --> 00:10:35,800
الحقيقةُ هي العكسُ تماماً

123
00:10:35,800 --> 00:10:38,460
الشيء الوحيد الذي أعرفُ القيام به هو القتال

124
00:10:40,310 --> 00:10:41,820
انتهينا

125
00:10:42,160 --> 00:10:44,740
آ..آسفة

126
00:10:44,740 --> 00:10:47,950
كان أوغاوا-سان هو من يفعلُ ذلك لي دوماً

127
00:10:47,950 --> 00:10:51,190
ماذا؟! أيفعلُ رجلٌ ذلك لكِ؟

128
00:10:53,960 --> 00:10:55,170
م..معكِ حقّ

129
00:10:55,170 --> 00:10:58,550
...عندَ الإمعانِ في الأمر، يبدو مليئاً بالعيوب

130
00:10:58,550 --> 00:11:04,140
...ولكن مع ذلك... لا أريدُ أن أتركها فوضويّة، لِذا

131
00:11:06,700 --> 00:11:11,620
ما زلتُ قابِعة في المشفى، لكنني أقرأ التقارير

132
00:11:12,530 --> 00:11:16,730
وقرأتُ بأنّكِ تسدِّين الثغرةَ التي خلّفتُها بأداءٍ عالٍ

133
00:11:17,560 --> 00:11:19,620
هذا غيرُ صحيح على الإطلاق

134
00:11:19,620 --> 00:11:23,000
أحظى بمساعدةِ الجميع في الفرع 2

135
00:11:27,810 --> 00:11:30,280
كيف تكون صادقاً مع نفسك

136
00:11:50,130 --> 00:11:54,160
...أنا سعيدةٌ بقولكِ ذلك

137
00:11:54,670 --> 00:11:57,990
ولكن لهذا أريدُكِ أن تخبريني

138
00:11:58,520 --> 00:12:00,300
عن سببِ قتالكِ

139
00:12:02,480 --> 00:12:05,020
المعركة مع النويز ليسَتْ لعبة

140
00:12:05,150 --> 00:12:09,460
بعد المعارك الخطيرة والكثيرة التي خُضتِها
ينبغي أن تكوني مُدرِكة لذلك

141
00:12:09,980 --> 00:12:12,570
أنا حقّاً لا أعرف

142
00:12:12,790 --> 00:12:17,750
أظنُّ أن إنقاذ الناس هي عادةٌ
لي لا أكثر، لِذا

143
00:12:18,100 --> 00:12:20,510
وبعد؟ أهذا كلّ شيء؟

144
00:12:20,850 --> 00:12:23,360
على سبيلِ المثال، عندما تدرسين
أو تلعبين الرياضة

145
00:12:23,360 --> 00:12:26,430
تتنافسين عادةً مع شخص ما

146
00:12:26,430 --> 00:12:29,900
ولكن لا داعي للمُنافسةِ مع شخص
تودِّين مُساعدته

147
00:12:29,940 --> 00:12:34,120
...لا أبرع في أي شيء لِذا

148
00:12:34,120 --> 00:12:39,370
لِذا جلّ ما أتمنَّاه هو القيام بشيء يُفيدُ الآخرين

149
00:12:44,630 --> 00:12:46,280
...أعتقدُ بأن السبب

150
00:12:47,070 --> 00:12:51,080
السبب هو تِلك الحرب

151
00:12:51,520 --> 00:12:57,500
تِلك الحفلة الموسيقيّة قبلَ عامين
عندما ضحَّتْ كانادي-سان بنفسِها لإنقاذي

152
00:12:58,230 --> 00:13:00,270
ليسَتْ هي فحسب

153
00:13:00,270 --> 00:13:03,960
ماتَ كثيرٌ من الناس في ذاك اليوم

154
00:13:04,110 --> 00:13:09,910
ولكن ما زلتُ هنا وما زلتُ أستطيع
...فعل أشياء كالضحك وتناول الأكلات الخفيفة

155
00:13:10,250 --> 00:13:13,640
لهذا أودُّ أن أكون مُفيدة لشخصٍ ما على الأقلّ

156
00:13:14,060 --> 00:13:17,900
لأنني أريدُ أن أكون قادرة على الضحك
وتناول الأكلات الخفيفة غداً أيضاً

157
00:13:18,640 --> 00:13:20,900
أريدُ مساعدة الناس

158
00:13:22,600 --> 00:13:24,900
سبب إيجابي جدّاً، هكذا عهِدتُكِ

159
00:13:25,440 --> 00:13:30,300
ولكن من المُمكِن أن يكون هذا مجرّد
عذر تفاؤلي للانتحار

160
00:13:30,300 --> 00:13:31,720
انتحار؟

161
00:13:32,290 --> 00:13:35,280
نوع من شعورِ النَّاجي بالذنب
حيثُ ترغبين بالتضحيةِ بحياتكِ لأجل الآخرين

162
00:13:35,280 --> 00:13:40,140
وذلك كي تتحرَّري من آلام
جراحكِ القديمة

163
00:13:40,420 --> 00:13:44,320
عفواً... هل قلتُ شيئاً غريباً؟

164
00:13:45,320 --> 00:13:47,030
...المعذرة

165
00:13:53,100 --> 00:13:56,270
لستُ أنا من يقرِّر فيما إن كان غريباً أم لا

166
00:13:56,590 --> 00:13:59,790
فكِّري وقرِّري بنفسكِ

167
00:13:59,790 --> 00:14:03,810
أفكِّر وأفكِّر ولكن هناك الكثير
من الأشياء التي لا أفهمها

168
00:14:03,810 --> 00:14:08,100
كادَ الظلامُ يبتلعُني عندما لمستُ دوراندال

169
00:14:08,100 --> 00:14:11,470
وبعدما شعرتُ بالوعي، وجدتُ نفسي
أستخدمُ تِلك القوّة على شخص آخر

170
00:14:11,840 --> 00:14:15,060
،لو أحسنتُ استخدام درعي المُصفَّح جيّداً

171
00:14:15,060 --> 00:14:17,090
لما حدثَ ذلك أبداً

172
00:14:17,360 --> 00:14:22,040
أن تعرفي كيفيّة استخدام قوّتكِ تعني
أن تصبحي مُحارِبة

173
00:14:23,200 --> 00:14:24,750
...مُحاربة

174
00:14:25,120 --> 00:14:30,010
هذا يعني الابتعاد أكثر عن حياة الناس العاديين

175
00:14:30,380 --> 00:14:33,510
هل لديكِ العزيمة للقيامِ بذلك؟

176
00:14:35,830 --> 00:14:37,930
هنالِك أشياء أودُّ حمايتها

177
00:14:38,210 --> 00:14:41,500
...كحياة يوميّة هادئة

178
00:14:41,500 --> 00:14:45,860
حِماية تِلك الحياة مهمّة جدّاً لي

179
00:14:45,860 --> 00:14:50,720
...ولكن لا أشعر بأنني قادِرة على فعل
أي شيء حيالَ الأمر

180
00:14:50,790 --> 00:14:54,770
ما الذي تُفكِّرين به عندما تُقاتلين؟

181
00:14:55,870 --> 00:14:58,430
،إذا هاجمَ النويز شخصاً

182
00:14:58,430 --> 00:15:00,650
فأريدُ أن أنقذَ هذا الشخص قدر المُستطاع

183
00:15:00,650 --> 00:15:03,320
أريدُ التوجُّه إلى هُناك مُباشرةً بأسرع
وأقرب ما يُمكن

184
00:15:03,320 --> 00:15:05,480
أريدُ الانطلاق إلى هُناك مُباشرةً لأجلهم

185
00:15:05,480 --> 00:15:06,160
...ومن ثمّ

186
00:15:06,800 --> 00:15:10,190
...إذا قاتلتُ شخصاً، ليسَ من النويز

187
00:15:10,720 --> 00:15:14,720
...أرغبُ أن أفصِحَ له عن مشاعري على ما أعتقد

188
00:15:14,970 --> 00:15:17,950
أودُّ أن أعرف ما إن كان علينا أن نُقاتل

189
00:15:19,740 --> 00:15:25,180
تخيَّلي كلّ ما تشعرين به في ذهنكِ
بكل ما أوتيتِ من قوّة

190
00:15:25,180 --> 00:15:27,230
تِلك هي قوّتكِ للقتال

191
00:15:27,820 --> 00:15:30,970
ذاك هو درع تاتشيبانا هيبيكي المُصفَّح

192
00:15:31,490 --> 00:15:33,220
...أنا جائعة

193
00:15:33,220 --> 00:15:34,240
أتودِّين الذهاب لمكان ما؟

194
00:15:35,860 --> 00:15:38,120
نعم، هيّا بنا

195
00:15:39,800 --> 00:15:41,210
أهلاً وسهلاً

196
00:15:41,210 --> 00:15:42,370
مرحباً

197
00:15:42,370 --> 00:15:46,640
عجباً! تِلك الفتاة التي تأكلُ ثلاث وجبات
كاملة دوماً ليسَتْ برفقتكِ؟

198
00:15:47,080 --> 00:15:49,120
لا يوجدُ سِوايّ اليوم

199
00:15:50,400 --> 00:15:52,130
هكذا إذاً

200
00:15:53,680 --> 00:15:59,330
لعلِّي آكلُ بعضاً من حصّتها باعتبارها غائبة

201
00:15:59,330 --> 00:16:01,760
لا داعي لفعل ذلك، أعدِّي الطعامَ فحسب رجاء

202
00:16:04,540 --> 00:16:06,390
أنا جائعة

203
00:16:06,540 --> 00:16:12,150
لم آكل شيئاً طوال النّهار
لأنني أردتُ أن أتناول هذه الأوكونومياكي

204
00:16:13,710 --> 00:16:16,590
أنتِ تُفكِّرين بمعدة فارِغة إذاً

205
00:16:16,600 --> 00:16:19,660
ستكونُ النتائج سيّئة في هذه الحالة

206
00:16:20,540 --> 00:16:22,620
ربّما

207
00:16:23,550 --> 00:16:29,350
ها أنا أجلسُ هنا أُفكِّر دون علمٍ بأي شيء

208
00:16:29,350 --> 00:16:32,120
...إذا كلّمتُها فأنا على يقين

209
00:16:34,160 --> 00:16:36,640
شكراً لكِ سيّدتي

210
00:16:37,060 --> 00:16:41,160
عودي متى شئتِ

211
00:16:41,290 --> 00:16:42,310
حسناً

212
00:16:45,420 --> 00:16:50,680
رُبّما، ولكن لا أعرف كيفيّة استخدام
درعي المُصفَّح

213
00:16:50,680 --> 00:16:52,780
هل تعلمين هذا يا تسوباسا-سان؟

214
00:16:52,780 --> 00:16:56,860
لن تكون النتائج جيّدة إن فكّرتِ أثناء الجوع

215
00:16:56,860 --> 00:16:58,460
ماذا؟

216
00:16:58,610 --> 00:17:02,550
السيّدة العجوز في مطعم الأوكونومياكي أخبرَتْني بذلك

217
00:17:02,550 --> 00:17:04,490
ذكيّة للغاية، صحيح؟

218
00:17:04,490 --> 00:17:06,290
...بالتأكيد

219
00:17:06,540 --> 00:17:11,460
وجدتُها يا تسوباسا-سان، سأذهبُ لإحضار
بعض من الأوكونومياكي من مطعم الزهرة

220
00:17:11,460 --> 00:17:15,040
حالما نأكل، أنا متأكِّدة بأنني سأجدُ
وسيلةً ما لاستخدام الدرع

221
00:17:15,040 --> 00:17:17,180
أظنُّها ستروقكِ أيضاً

222
00:17:17,180 --> 00:17:18,300
...لا... لحـ

223
00:17:18,300 --> 00:17:19,970
لحظة يا تاتشيبانا

224
00:17:25,980 --> 00:17:29,860
الفتاة المُصفَّحة بنيفوشتان قادمة إلى هنا

225
00:17:30,400 --> 00:17:32,930
أصدِروا أمراً بإخلاءِ المنطقة المحيطة

226
00:17:32,930 --> 00:17:35,110
واتّصِلوا بهيبيكي-كون

227
00:17:39,720 --> 00:17:42,170
حاضر، عُلِم، أنا قادمة حالاً

228
00:17:42,550 --> 00:17:44,290
هيبيكي

229
00:17:46,170 --> 00:17:47,500
ميكو

230
00:17:48,190 --> 00:17:50,190
!أنتِ

231
00:17:51,880 --> 00:17:54,090
...تراجعي، هذا خطير

232
00:17:57,320 --> 00:17:59,730
يا للهول! هل كانَ هُناك شخصاً آخراً؟

233
00:18:23,980 --> 00:18:25,290
هيبيكي؟

234
00:18:26,870 --> 00:18:27,970
أنا آسفة

235
00:18:40,270 --> 00:18:43,810
أتعتقدين حقاً أنَّ فتاة بليدة مثلكِ
تستطيعُ استفزازي؟

236
00:18:43,810 --> 00:18:46,160
...لماذا هيبيكي

237
00:18:46,730 --> 00:18:48,700
لقد بدأتْ هيبيكي-تشان بالقتال

238
00:18:48,700 --> 00:18:51,020
إنها تبتعدُ حالياً عن المدينة

239
00:18:51,960 --> 00:18:53,790
!استمرُّوا في اللحاق بها

240
00:18:53,790 --> 00:18:55,300
سجِّلوا كلّ ثانية مما يجري

241
00:19:00,320 --> 00:19:02,430
لستِ بسيّئة أيتها الطفلة البليدة

242
00:19:02,860 --> 00:19:04,540
"اسمي ليسَ "طفلة بليدة

243
00:19:05,810 --> 00:19:08,290
اسمي هو تاتشيبانا هيبيكي، العمر 15

244
00:19:08,290 --> 00:19:11,750
تاريخ ميلادي 13 سبتمبر وزمرة دمي أو

245
00:19:11,750 --> 00:19:14,780
وقد قستُ طولي مؤخراً فكان 157 سم

246
00:19:14,780 --> 00:19:17,840
ووزني هو... سأخبركِ عندما نصبحُ صديقتَين

247
00:19:17,840 --> 00:19:21,290
هوايتي إنقاذ الناس والأشياء المُفضَّلة
لدي هي الطعام والطعام

248
00:19:21,290 --> 00:19:21,880
...و

249
00:19:22,140 --> 00:19:24,410
لم أصاحب صديقاً من قبل

250
00:19:24,700 --> 00:19:27,770
لماذا تقولين كلّ هذا؟

251
00:19:27,770 --> 00:19:33,020
نحنُ لسنا من "النويز"، يمكننا أن نفهم بعضنا الآخر
وهذا ما دفعَني للكلام

252
00:19:33,040 --> 00:19:34,770
هل أنتِ جادّة؟

253
00:19:34,770 --> 00:19:35,850
بعد كلّ هذا؟

254
00:19:37,250 --> 00:19:37,880
...إنها

255
00:19:39,260 --> 00:19:40,340
تغيّرَ شيء

256
00:19:40,990 --> 00:19:41,850
عزيمة؟

257
00:19:43,140 --> 00:19:46,970
دعينا نتكلّم! لا يجوز أن نقاتلَ بعضنا الآخر

258
00:19:47,560 --> 00:19:50,090
...لأنّنا إن تكلّمنا، يستطيعُ الناس

259
00:19:50,090 --> 00:19:51,290
اصمتي

260
00:19:51,650 --> 00:19:54,260
لا يمكن أن يتفاهمَ الناسُ فيما بينهم

261
00:19:54,500 --> 00:19:57,220
هكذا خُلِقنا

262
00:19:57,260 --> 00:20:01,080
أكرهكِ، أكرهكِ
أكرهكِ، أكرهكِ

263
00:20:01,080 --> 00:20:05,760
لا تتوانين عن الكلام، لكنّكِ لا تفهمين شيئاً

264
00:20:10,010 --> 00:20:14,250
طُلِبَ منِّي اختطافكِ ولكن
لم يعد يهمّني ذلك الآن

265
00:20:14,250 --> 00:20:16,600
سأدمّرُكِ هنا

266
00:20:16,600 --> 00:20:19,670
سأحطِّمُ كلّ ما لديكِ

267
00:20:20,600 --> 00:20:22,550
لن أخسرَ أيضاً

268
00:20:25,030 --> 00:20:26,030
!انفجري

269
00:20:30,580 --> 00:20:32,820
وهذه واحدة أخرى

270
00:20:42,580 --> 00:20:46,110
...بسببكِ... أنا سوف

271
00:20:59,390 --> 00:21:01,250
لا أفلح في هذا

272
00:21:01,290 --> 00:21:05,030
لا أستطيعُ بَلْوَرة طاقة درعي
كما تفعل تسوباسا-سان

273
00:21:05,450 --> 00:21:08,760
تحاولُ استخدام درعها المُصفَّح
خلال هذه الفترة القصيرة؟

274
00:21:09,800 --> 00:21:14,500
الطاقة بحوزتي، إن عجزتُ
عن بلْوَرتها بدرعي المُصفَّح

275
00:21:14,790 --> 00:21:19,040
فسأركِّزُ كلّ تِلك الطاقة في لكمتي فحسب

276
00:21:19,040 --> 00:21:20,690
لن أدعكِ

277
00:21:24,990 --> 00:21:26,220
ماذا؟

278
00:21:26,220 --> 00:21:31,060
كما لو أنّكِ تسحقين البرق

279
00:21:32,880 --> 00:21:36,490
التوجُّه إلى هُناك مُباشرةً بأسرع وأقرب ما يُمكن

280
00:21:36,490 --> 00:21:38,840
...سأفصح لها عن مشاعري

281
00:21:38,840 --> 00:21:41,980
الأغنية التي في قلبي

282
00:21:50,260 --> 00:21:53,330
...مستحيل... مُصفَّح نيفوشتان قد

283
00:22:02,680 --> 00:22:03,970
هيبيكي؟

284
00:22:05,990 --> 00:22:09,950
يتبع