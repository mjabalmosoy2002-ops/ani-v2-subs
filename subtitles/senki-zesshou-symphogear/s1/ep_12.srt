1
00:02:28,520 --> 00:02:34,290
الحلقة 8
لا ظِلال تحت أشعّة الشمس

2
00:02:34,930 --> 00:02:35,920
هل هو النويز؟

3
00:02:36,260 --> 00:02:40,400
أجل، لقد رصَدنا شكلَ
نويز في كتلة المدينة 6

4
00:02:40,920 --> 00:02:45,540
حالفَنا الحظُّ لأننا كنّا في وقت الصباح الباكر
...ولم يسقط أي ضحايا

5
00:02:45,540 --> 00:02:49,560
،ولكن رأينا شكلَ الأثر إتشيفال
وكذلك النويز

6
00:02:50,100 --> 00:02:51,700
...هل يعني هذا يا سيّدي

7
00:02:51,700 --> 00:02:54,510
بأنّ كريس-تشان قاتلَت النويز؟

8
00:02:54,510 --> 00:02:56,170
على الأرجح

9
00:02:57,370 --> 00:02:58,080
ما الأمر؟

10
00:02:58,080 --> 00:03:02,280
المعذرة...كنتُ أقولُ لنفسي فقط
أنّها قد تكون بِلا مأوى

11
00:03:02,750 --> 00:03:04,620
هذا... مُحتمَل

12
00:03:05,040 --> 00:03:08,290
سنتابع التحقيق

13
00:03:08,290 --> 00:03:11,500
ابقي متأهِّبة حتى إشعار آخر

14
00:03:11,580 --> 00:03:13,540
حسناً، عُلِم

15
00:03:17,300 --> 00:03:18,650
ميكو؟

16
00:03:19,020 --> 00:03:21,710
أليسَتْ كوهيناتا-سان هنا اليوم؟

17
00:03:21,710 --> 00:03:25,100
...ظننتُها ذهبَتْ إلى المدرسة قبل أن أذهب

18
00:03:25,810 --> 00:03:27,930
آسِفة لقسوَتي آنذاك

19
00:03:28,610 --> 00:03:30,850
أشعرُ بالمسؤولية

20
00:03:32,380 --> 00:03:35,410
ماذا كنَّا سنفعلُ لو كان هذا أنِمي؟

21
00:03:35,410 --> 00:03:37,510
فكِّري بالأمرِ بجدّية

22
00:03:41,920 --> 00:03:46,710
ميكو... لا أودُّ أن تنتهي صداقتنا هكذا

23
00:04:03,930 --> 00:04:06,080
جيّد... استيقظتِ

24
00:04:06,670 --> 00:04:09,390
كنتِ مُنقَّعة، لهذا بدّلتُ ملابسكِ

25
00:04:06,670 --> 00:04:09,390
كوهيناتا

26
00:04:09,390 --> 00:04:11,660
لم يطلب أحدٌ منكِ ذلك

27
00:04:14,400 --> 00:04:16,210
ما..ماذا؟

28
00:04:16,210 --> 00:04:20,470
...في الواقع، لا أملك أي لِباس داخلي احتياطي

29
00:04:23,410 --> 00:04:24,990
ميكو-تشان؟

30
00:04:25,110 --> 00:04:27,350
كيفَ حالُ صديقتكِ؟

31
00:04:27,350 --> 00:04:29,200
استيقظَتْ للتو

32
00:04:29,200 --> 00:04:32,290
شكراً لكِ لإعارتنا هذا السرير يا سيّدتي

33
00:04:32,550 --> 00:04:34,540
لا تقلقي حيال الأمر

34
00:04:34,540 --> 00:04:37,620
غسلتُ ملابسكِ

35
00:04:38,340 --> 00:04:39,710
سأساعدكِ

36
00:04:39,960 --> 00:04:41,710
شكراً لكِ

37
00:04:41,710 --> 00:04:42,460
العفو

38
00:04:48,990 --> 00:04:51,260
...شكراً

39
00:04:56,690 --> 00:04:59,370
ألن تطلبي منّي شيئاً؟

40
00:05:00,440 --> 00:05:01,610
كلّا

41
00:05:01,610 --> 00:05:06,130
أظنُّني سيّئة في هذه الأمور

42
00:05:06,130 --> 00:05:09,420
،أخشى من إفسادِ العلاقات

43
00:05:09,810 --> 00:05:14,120
لكنني أفسدتُ بدلاً من ذلك أهمّ علاقة لي

44
00:05:14,120 --> 00:05:17,620
هل هذا يعني أنكِ تشاجرتِ مع أحد؟

45
00:05:18,780 --> 00:05:19,810
نعم

46
00:05:21,890 --> 00:05:26,680
لم تتغيّبْ ميكو عن المدرسة من قبل

47
00:05:29,760 --> 00:05:31,200
تسوباسا-سان؟

48
00:05:33,410 --> 00:05:37,080
ظننتُ أنني كنتُ جاهزة لهذا

49
00:05:37,080 --> 00:05:41,810
ظننتُ أنني كنتُ جاهزة لأكون مُحاربة سيمفوغير
لحماية المُقرَّبين إليّ

50
00:05:42,590 --> 00:05:44,320
ولكن يبدو بأنني لستُ جاهزة بعد

51
00:05:45,040 --> 00:05:49,910
زعزعَني شيءٌ صغيرٌ كهذا كلّياً
ولا أستطيع فعل أي شيء

52
00:05:50,120 --> 00:05:53,670
...عليّ أن أصبح أقوى، ولكن

53
00:05:54,090 --> 00:05:55,900
...أريدُ أن أتغيّر، ولكن

54
00:05:56,840 --> 00:06:02,240
ماذا لو كان هذا الشيء الصغير
هو ما تُريدين حمايته حقاً؟

55
00:06:02,930 --> 00:06:05,530
أليس ذلك جيّداً حينها؟

56
00:06:06,310 --> 00:06:09,890
أنا على يقين بأنّكِ قادرة على أن تكوني قويّة
وتبقين مع ذلك كما أنتِ

57
00:06:10,180 --> 00:06:11,830
...تسوباسا-سان

58
00:06:12,840 --> 00:06:16,490
كانَتْ كانادي أفضل منِّي في التشجيع

59
00:06:16,490 --> 00:06:18,660
لا، هذا غيرُ صحيح

60
00:06:24,120 --> 00:06:27,510
لكنني اكتأبتُ ثانيةً على أي حال

61
00:06:27,510 --> 00:06:28,930
أنا مغلوبٌ على أمري

62
00:06:32,000 --> 00:06:35,060
تسوباسا-سان، أما زلتِ تتألّمين؟

63
00:06:35,150 --> 00:06:38,570
إنني أتوخّى حذراً إضافياً، لا داعي للقلق

64
00:06:38,570 --> 00:06:40,460
هكذا إذاً، يسرُّني سماع ذلك

65
00:06:41,930 --> 00:06:44,690
الجهدُ الذي تُشكِّلُه الأغنية النهائية
على الجسدِ مذهل

66
00:06:45,430 --> 00:06:50,850
إنها أغنية الدّمار
تدمِّر النّفسَ والآخرين معاً

67
00:06:51,510 --> 00:06:55,580
إذا ما اعتبرناهُ ثمناً لهذه القوّة الكبيرة
فهو رخيصٌ جداً

68
00:06:55,580 --> 00:06:58,170
الأغنية النهائية... أغنية الدّمار؟

69
00:06:58,180 --> 00:07:00,640
لكن... لكن يا تسوبابسا-سان

70
00:07:00,640 --> 00:07:04,650
يعزو الفضلُ باجتيازي لذلك البرنامج التأهيلي
الصَّعب منذُ عامين

71
00:07:04,650 --> 00:07:06,840
إلى موسيقاكِ التي شجّعَتْني

72
00:07:07,500 --> 00:07:10,870
أعلمُ بأنَّ أغانيكِ ليسَتْ مجرّد
أغاني تدمير

73
00:07:10,870 --> 00:07:15,200
بل إنَّها تُسِرُّ خاطرَ مُستمعينها

74
00:07:15,500 --> 00:07:16,870
تاتشيبانا؟

75
00:07:17,170 --> 00:07:19,810
لِذا تعافي بسُرعة

76
00:07:19,830 --> 00:07:22,620
فأنا أحبُّ موسيقاكِ

77
00:07:31,040 --> 00:07:33,010
كوهيناتا

78
00:07:31,780 --> 00:07:33,010
قِتال؟

79
00:07:33,250 --> 00:07:36,010
أنا حقاً لا أفهم هذا الأمر

80
00:07:36,050 --> 00:07:38,600
ألم تتشاجري مع صديقة من قبل؟

81
00:07:39,380 --> 00:07:41,130
لا أملُك أصدقاء

82
00:07:41,770 --> 00:07:45,340
قُتِلَتْ أمِّي وأبي في الطرف
الآخر من الكوكب

83
00:07:45,500 --> 00:07:47,520
ومنذُ ذلك الحين، عشتُ وحيدة

84
00:07:48,210 --> 00:07:50,280
لم أحظَ بوقتٍ لتشكيل صداقات

85
00:07:50,510 --> 00:07:51,780
...هذا فظيع

86
00:07:51,780 --> 00:07:54,820
والشخص الوحيد الذي ظننتُه قد فهِمَني

87
00:07:55,040 --> 00:07:57,410
استغلَّني كأداة

88
00:07:58,250 --> 00:08:00,640
لم يهتم بي أحدٌ على الإطلاق

89
00:08:01,560 --> 00:08:05,420
كلّ الكِبار حُثالة

90
00:08:05,500 --> 00:08:07,810
قلتُ لهم أنني جريحة، ولم يهتمّوا

91
00:08:07,990 --> 00:08:10,140
قلتُ لهم أن يتوقّفوا، ولم يهتمّوا

92
00:08:10,140 --> 00:08:14,590
لم يصغوا إلى أي كلمة قلتُها

93
00:08:19,200 --> 00:08:20,600
أنا آسفة

94
00:08:21,830 --> 00:08:25,880
اذهبي وأوسعي الذي تُقاتلينه ضرباً

95
00:08:27,030 --> 00:08:30,560
وحالما تعرفان من منكما الأقوى، ينتهي الأمر

96
00:08:30,560 --> 00:08:32,890
يمكنُكِ التعويض حينها، صحيح؟

97
00:08:34,650 --> 00:08:36,880
لا أستطيع فعل ذلك

98
00:08:38,350 --> 00:08:40,230
لستُ أفهمكِ

99
00:08:40,650 --> 00:08:42,730
ولكن شكراً لكِ

100
00:08:42,740 --> 00:08:45,500
ماذا؟ لم أفعل شيئاً

101
00:08:47,790 --> 00:08:50,990
شكراً لكِ من قلبي لاهتمامكِ بي

102
00:08:50,990 --> 00:08:53,200
...يا... المعذرة

103
00:08:53,300 --> 00:08:55,750
كريس، كريس يوكيني

104
00:08:56,770 --> 00:08:58,780
أنتِ لطيفة، أليس كذلك يا كريس؟

105
00:09:01,800 --> 00:09:03,310
أنا؟

106
00:09:03,310 --> 00:09:05,670
وأنا ميكو كوهيناتا

107
00:09:06,010 --> 00:09:08,330
...إن أردتِ

108
00:09:09,520 --> 00:09:12,510
سأكونُ صديقتكِ

109
00:09:20,180 --> 00:09:23,810
لكنّني اقترفتُ أخطاء جسيمة بحقِّكم

110
00:09:29,380 --> 00:09:31,880
تسوباسا تتكلّم، تاتشيبانا بصُحبتي

111
00:09:32,180 --> 00:09:34,620
لقد رصَدنا عدداً كبيراً من النويز

112
00:09:35,160 --> 00:09:38,890
إنهم على الأرجح على صِلة بالنويز
الذين رأيناهم في هذا الصباح

113
00:09:39,230 --> 00:09:41,820
عُلِم، نحنُ في طريقنا

114
00:09:41,820 --> 00:09:42,390
!لا

115
00:09:42,910 --> 00:09:46,020
لا أستطيع إرسالكِ إلى هُناك ما لم تُكملي
فحصكِ الطبِّي

116
00:09:46,020 --> 00:09:47,350
...ولكن

117
00:09:48,020 --> 00:09:50,820
تسوباسا-سان، احمي الجميع

118
00:09:50,820 --> 00:09:53,520
حينها أستطيعُ التركيز على ما هو أمامي

119
00:10:01,950 --> 00:10:04,230
ما الذي يجري؟

120
00:10:04,230 --> 00:10:07,080
ماذا؟ ظهرَ النويز

121
00:10:07,080 --> 00:10:09,110
ألا تعلمين ما يعنيه ذلك المنبِّه؟

122
00:10:10,500 --> 00:10:12,080
سيّدتي، لنُسرع

123
00:10:12,080 --> 00:10:12,980
حسناً

124
00:10:13,430 --> 00:10:15,010
كريس

125
00:10:15,950 --> 00:10:19,510
مستحيل، ماذا أفعل؟

126
00:10:31,400 --> 00:10:34,310
...يُقتَلُ أناسٌ أبرياءٌ بسببي

127
00:10:45,100 --> 00:10:47,990
هذا ليسَ ما أردت

128
00:10:48,650 --> 00:10:51,250
...كلّ شيء أقوم به

129
00:10:51,250 --> 00:10:53,600
ينتهي هكذا دوماً

130
00:11:06,650 --> 00:11:09,870
...أنا هُنا، لِذا

131
00:11:09,870 --> 00:11:12,900
لا تستهدفوا أحداً آخر

132
00:11:39,880 --> 00:11:40,860
هل أنتِ بخير؟

133
00:12:18,870 --> 00:12:20,450
!انظر بنفسك

134
00:12:20,450 --> 00:12:23,880
أنا بخير، لِذا اذهب وساعد الآخرين

135
00:12:24,330 --> 00:12:25,190
...ولكن

136
00:12:25,190 --> 00:12:28,900
قلتُ لك أنني سأتولّى أمرهم جميعاً

137
00:12:31,520 --> 00:12:34,020
اتبعوني أيُّها الحثالة

138
00:12:41,280 --> 00:12:45,030
ألن أكون قادراً على إنقاذِها من جديد؟

139
00:12:45,110 --> 00:12:48,660
هيّا بنا، حان وقتُ العرض

140
00:12:48,660 --> 00:12:51,650
وابِل من عمليات القتل كما البُركان

141
00:12:51,650 --> 00:12:54,560
...أرِيني كلّ ما لديكِ

142
00:12:54,560 --> 00:12:58,980
كلّ شيء، كلّ شيء، كلّ شيء
...كلّ شيء، كلّ شيء

143
00:12:58,980 --> 00:13:01,340
وسأدمِّره بالكامل

144
00:13:02,170 --> 00:13:04,180
نعم، سأدمّره بالكامل

145
00:13:26,170 --> 00:13:28,820
...هل من أحد؟ هل من أحد

146
00:13:49,550 --> 00:13:53,100
اهدئي، يبدو بأنه يستجيبُ للضجيجِ العالي

147
00:13:56,770 --> 00:14:00,890
طاردَني أنا والعمّة من مطعم الزهرة إلى هذا البناء

148
00:14:01,700 --> 00:14:05,000
،إذا غنّيتُ لاستدعاء السيمفوغير خاصّتي

149
00:14:05,000 --> 00:14:07,790
فسأعرّضُ ميكو والسيّدة لخطر

150
00:14:08,950 --> 00:14:10,510
ماذا أفعل؟

151
00:14:35,660 --> 00:14:38,600
كنتُ قاسية جداً معكِ

152
00:14:38,670 --> 00:14:41,510
لا أتوقع منكِ أن تسامحيني

153
00:14:41,570 --> 00:14:43,990
ولكن أريد أن أبقى معكِ على أي حال

154
00:14:44,090 --> 00:14:46,270
أريد أن أقاتل أيضاً

155
00:14:47,190 --> 00:14:49,470
...كلّا... يا ميكو

156
00:14:49,920 --> 00:14:52,310
لا يهمّ ما تفكِّرين به

157
00:14:52,310 --> 00:14:55,780
لا أريدكِ أن تضطرِّي للقيام بهذا بمفردكِ

158
00:14:58,810 --> 00:15:01,290
لن أتردّد بعد الآن

159
00:15:39,280 --> 00:15:40,290
هيبيكي-سان

160
00:15:40,290 --> 00:15:41,710
أوغاوا-سان

161
00:15:43,790 --> 00:15:46,250
أوغاوا-سان، اعتنِ بها

162
00:15:46,250 --> 00:15:47,570
ماذا ستفعلين؟

163
00:15:55,700 --> 00:15:57,480
ميكو، أين أنتِ؟

164
00:15:59,170 --> 00:16:00,720
هيبيكي، اسمعيني

165
00:16:00,720 --> 00:16:03,350
،سأصرفُ انتباهَ النويز

166
00:16:03,350 --> 00:16:05,340
لِذا أنقذي سيّدةَ مطعم الزهرة

167
00:16:05,340 --> 00:16:08,190
لا، لا أستطيع أن أدعكِ تفعلين ذلك

168
00:16:08,190 --> 00:16:11,130
،كنتُ في فريقِ المضمار
لِذا أنا بارعة في الركض، سأكون بخير

169
00:16:11,130 --> 00:16:12,080
!لن تكوني بخير

170
00:16:12,080 --> 00:16:13,080
اجعليها كذلك إذاً

171
00:16:15,600 --> 00:16:17,540
أعلمُ بأن الأمر خطير

172
00:16:17,590 --> 00:16:19,670
لهذا أسألكِ

173
00:16:19,670 --> 00:16:21,750
الشخص الوحيد الذي أستطيعُ الوثوق به

174
00:16:21,750 --> 00:16:23,540
هو أنتِ

175
00:16:25,060 --> 00:16:27,950
لقد قسوتُ عليكِ حقاً

176
00:16:27,950 --> 00:16:29,450
ولكن أريدُ أن أبقى معكِ على أي حال

177
00:16:30,310 --> 00:16:32,340
أريدُ أن أقاتل أيضاً

178
00:16:36,070 --> 00:16:39,090
لستُ الشخص الوحيد الذي يُقاتل

179
00:16:39,090 --> 00:16:42,580
،ظننتُ أن بمقدوري استخدام السيمفوغير
لإنقاذ الناس

180
00:16:42,580 --> 00:16:44,140
ولكن كنتُ مخطئة

181
00:16:44,680 --> 00:16:47,470
أنا لستُ الشخص الوحيد الذي
يبذلُ قصارى جهده

182
00:16:47,470 --> 00:16:50,170
الناس الذين أنقذهُم يبذلون قصارى جهدهم أيضاً

183
00:16:50,400 --> 00:16:51,610
لا تموتي

184
00:16:51,610 --> 00:16:54,650
افتحي عينيكِ، لا تتخلّي عن الحياة

185
00:16:54,650 --> 00:16:59,080
لا يمكنكِ إنقاذ الناس بمفردكِ

186
00:16:59,080 --> 00:17:01,320
...لهذا في ذلك الحين

187
00:17:01,320 --> 00:17:05,640
صاحَتْ كانادي-سان في وجهي قائلة
ألّا أتخلّى عن الحياة

188
00:17:06,320 --> 00:17:08,230
أظنُّني فهمتُ الآن

189
00:17:16,780 --> 00:17:21,240
هذا صحيح، لا أريد إنقاذ الناس

190
00:17:21,430 --> 00:17:24,480
فقط بدافعِ الشعور بذنب
نجاتي من تِلك المأساة

191
00:17:24,860 --> 00:17:28,130
،هاته المشاعر هي ما منحَتْني إيّاها كانادي-سان

192
00:17:28,220 --> 00:17:30,150
،وقبِلتُها

193
00:17:31,020 --> 00:17:33,230
منذُ عامين

194
00:17:35,230 --> 00:17:37,020
...لا أستطيع الركض أكثر من ذلك

195
00:17:40,590 --> 00:17:43,160
أهذه هي النّهاية؟

196
00:17:43,640 --> 00:17:46,660
أظنُّها كذلك... يا هيبيكي

197
00:17:50,180 --> 00:17:53,710
لكنني لم أرَ الشّهب مع هيبيكي بعد

198
00:18:39,170 --> 00:18:42,030
من الصَّعب الحِفاظ على الهدوء
عندَ السقوط

199
00:18:42,030 --> 00:18:46,280
جسدي كلّه يؤلمني... لكنني أنبضُ بالحياة

200
00:18:46,310 --> 00:18:50,810
شكراً لكِ، عرفتُ أنكِ ستأتين لأجلي يا هيبيكي

201
00:18:50,810 --> 00:18:56,300
شكراً لكِ، عرفتُ بأنكِ لن تستسلمي أبداً

202
00:18:56,610 --> 00:18:59,490
لأنكِ صديقتي

203
00:19:05,430 --> 00:19:08,580
...كنتُ خائفة للغاية، خائفة للغاية

204
00:19:08,620 --> 00:19:11,750
أنا أيضاً... كنتُ خائفة للغاية

205
00:19:11,750 --> 00:19:16,770
لم أكن غاضِبة لأنكِ أخفيتِ عنِّي

206
00:19:16,840 --> 00:19:22,190
...لطالما أردتِ مساعدة الآخرين، لكن

207
00:19:22,220 --> 00:19:27,420
صرتِ تحاولين مؤخراً كبت
كلّ الآلام والأحزان داخلكِ

208
00:19:27,420 --> 00:19:30,280
استأتُ من ذلك

209
00:19:30,870 --> 00:19:35,000
كنتُ قلِقة للغاية لدرجة أنكِ قد تتأذّين مجدداً

210
00:19:35,080 --> 00:19:40,110
ولكن تِلك كانَتْ أنانيّة مني لأنني لم أرد أن أخسركِ

211
00:19:40,110 --> 00:19:42,280
...عرفتُ ذلك ولكن

212
00:19:42,280 --> 00:19:45,780
ولكن لم أستطع إعادة المياه إلى مجاريها

213
00:19:46,040 --> 00:19:47,030
ميكو

214
00:19:48,240 --> 00:19:50,860
...ما تزالين

215
00:19:51,500 --> 00:19:53,330
ماذا؟

216
00:19:54,730 --> 00:19:56,180
...كلّ ما في الأمر

217
00:19:56,180 --> 00:19:58,940
...أنّكِ تبكين وشعركِ فوضويّ

218
00:19:58,940 --> 00:20:01,080
...وتتكلّمين بجدِّية تامّة

219
00:20:01,080 --> 00:20:04,380
تباً! لا يحقُّ لكِ أن تتكلّمي

220
00:20:04,380 --> 00:20:05,930
ماذا؟ مستحيل

221
00:20:05,930 --> 00:20:07,630
ميكو، أعطيني مرآة

222
00:20:07,630 --> 00:20:10,060
...لا أحمل مرآة، ولكن

223
00:20:10,070 --> 00:20:11,560
أستطيعُ التقاط صورة بهذا

224
00:20:13,560 --> 00:20:16,060
للأعلى قليلاً، حسناً

225
00:20:16,060 --> 00:20:17,820
سألتقطُها يا هيبيكي

226
00:20:18,900 --> 00:20:21,500
نحنُ رثّتان

227
00:20:21,500 --> 00:20:22,970
منحوستان جدّاً

228
00:20:22,970 --> 00:20:25,280
أبدو أسوأ مما توقعتُ أيضاً

229
00:20:33,080 --> 00:20:33,590
تفضّلي

230
00:20:34,000 --> 00:20:36,180
استعدتُ هذه من السيّدة زهرة

231
00:20:36,180 --> 00:20:37,760
شكراً لك

232
00:20:37,760 --> 00:20:39,460
على الرّحب والسعة

233
00:20:39,710 --> 00:20:41,840
...عفواً... سيّدي

234
00:20:41,840 --> 00:20:47,830
...صدفَ وأن رأتْني أقاتل ثانيةً

235
00:20:47,830 --> 00:20:51,000
هذا غير صحيح، أنا من ورّطَ نفسي

236
00:20:52,190 --> 00:20:55,660
يمكنُك تدوين كلّ ذلك في تقريرك

237
00:20:55,710 --> 00:20:57,850
حسناً، كان أمراً محتوماً

238
00:20:57,850 --> 00:20:58,510
...بالإضافة إلى ذلك

239
00:20:58,800 --> 00:21:03,360
لا يحقُّ لنا أن نشتكي إن كنتُما
تنقذان الناس

240
00:21:03,760 --> 00:21:04,610
!رائع

241
00:21:04,610 --> 00:21:05,620
نعم

242
00:21:10,160 --> 00:21:10,900
...حسناً

243
00:21:12,370 --> 00:21:14,870
يصِلُ نجمُ الحفلةُ متأخراً دوماً

244
00:21:15,180 --> 00:21:18,560
والآن من أين سنبدأ؟

245
00:21:20,520 --> 00:21:23,370
أخبراني في حال رصدتُما أثراً لأي نويز

246
00:21:20,520 --> 00:21:23,880
حانَ الوقتُ لأداء الكِبار لأعمالهم

247
00:21:23,920 --> 00:21:26,060
عودا إلى المنزلِ وارتاحا

248
00:21:26,060 --> 00:21:27,160
حاضر

249
00:21:29,010 --> 00:21:33,080
عفواً... انفصلتُ عن صديقةٍ لي
أثناء عمليّة الإخلاء

250
00:21:33,570 --> 00:21:35,940
...اسمُها هو كريس يوكيني

251
00:21:38,410 --> 00:21:41,630
لم نسمع شيئاً عن وقوع ضحايا

252
00:21:42,100 --> 00:21:45,250
أنا على يقين بأنّكِ ستتواصلين معها

253
00:21:45,250 --> 00:21:45,920
لا تقلقي

254
00:21:47,200 --> 00:21:48,570
...جيّد

255
00:21:57,670 --> 00:22:00,460
تصبحين على خير

256
00:22:02,420 --> 00:22:04,130
!بهذه السرعة

257
00:22:06,220 --> 00:22:07,400
هل خدعتُكِ؟

258
00:22:07,400 --> 00:22:08,790
!يا لكِ من قاسية