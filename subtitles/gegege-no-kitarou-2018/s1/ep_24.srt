00:13:31,390 --> 00:13:36,770
ستدفعين ثمن هذا! كيف تجرؤين
!على استغلال إخلاص الرجل الجرذ

207
00:13:37,270 --> 00:13:39,650
!لـ-لن أسامح

208
00:13:39,770 --> 00:13:43,030
.سيكيو، حان وقت دفع الحساب

209
00:13:43,150 --> 00:13:44,570
حقًّا؟

210
00:13:44,700 --> 00:13:46,070
!...بهذه الحالة

211
00:13:53,950 --> 00:13:54,870
!لا

212
00:13:55,000 --> 00:13:57,210
!تفرقوا وجدوها

213
00:13:59,210 --> 00:14:01,250
!أنت

214
00:14:01,670 --> 00:14:03,800
!توقفي يا سيكيو

215
00:14:03,920 --> 00:14:06,550
!هذا سباق فظيع لكبار السن

216
00:14:06,680 --> 00:14:08,510
!مثيرة للشفقة

217
00:14:14,270 --> 00:14:17,350
!نلت منك! استسلمي

218
00:14:20,150 --> 00:14:23,110
!يا له من جسم جميل

219
00:14:25,820 --> 00:14:28,200
!أيّها العجوز المنحرف! ماذا تفعل؟

220
00:14:28,320 --> 00:14:29,700
!اتركني

221
00:14:30,160 --> 00:14:32,160
!آسف بشأن ذلك

222
00:14:33,790 --> 00:14:35,700
!أسلوب قبضك عليها منافٍ للآداب

223
00:14:38,960 --> 00:14:40,500
!لا تتأخري أيّتها الفتاة القطة

224
00:14:41,460 --> 00:14:43,340
!يستحيل أن أتأخر

225
00:14:44,920 --> 00:14:45,760
!ها هي

226
00:14:48,130 --> 00:14:50,550
!أيّتها الوغدة! استعدي

227
00:14:50,930 --> 00:14:55,020
!هذا انتقام للرجل الجرذ

228
00:15:00,600 --> 00:15:01,480
!ماذا؟

229
00:15:01,770 --> 00:15:03,110
!اهربي يا يوكو

230
00:15:04,860 --> 00:15:07,190
!بـ-بسرعة! اهربي يا يوكو

231
00:15:07,320 --> 00:15:09,740
!اتركني، يا إلهي

232
00:15:09,860 --> 00:15:12,120
!بماذا تفكر؟

233
00:15:13,370 --> 00:15:14,580
!انتظري

234
00:15:21,540 --> 00:15:23,670
!لن تهربي يا سيكيو

235
00:15:24,920 --> 00:15:26,460
!إبر الشعر

236
00:15:30,760 --> 00:15:31,590
!ماذا؟

237
00:15:40,690 --> 00:15:43,650
.حمت نفسها بالتحول إلى صخرة

238
00:15:43,770 --> 00:15:45,150
.ولكنّها النهاية

239
00:15:47,280 --> 00:15:50,530
!نسخت خدعتي

240
00:15:50,650 --> 00:15:53,620
!سيكون حملها صعبًا

241
00:15:53,740 --> 00:15:54,830
.اتركوا الأمر لي

242
00:15:57,660 --> 00:15:59,870
!تخدع الرجال

243
00:16:00,000 --> 00:16:01,830
!امرأة سيّئة

244
00:16:02,670 --> 00:16:04,920
!هل اكتفيتِ؟

245
00:16:05,590 --> 00:16:08,340
!خذي هذه

246
00:16:13,930 --> 00:16:16,890
!أيّها الجرذ الأحمق! لا أصدّق ما فعلته

247
00:16:27,480 --> 00:16:28,230
!ماذا؟

248
00:16:36,410 --> 00:16:38,790
!مؤلم

249
00:16:41,620 --> 00:16:44,880
!تماسك يا كيتارو

250
00:16:50,210 --> 00:16:54,260
...حائط... حائطي

251
00:16:57,050 --> 00:16:59,060
!مخيف

252
00:16:59,180 --> 00:17:01,180
!لفافة القطن-
!مـ-مـ-ماذا؟-

253
00:17:01,310 --> 00:17:03,020
!احملني

254
00:17:04,270 --> 00:17:05,940
!نسخ القطن

255
00:17:06,060 --> 00:17:07,480
!غيتّا متحكم بها عن بعد

256
00:17:10,940 --> 00:17:11,990
!لا فائدة

257
00:17:12,570 --> 00:17:14,240
!سحقًا لك يا كيتارو

258
00:17:27,710 --> 00:17:29,590
!هذا سيّئ

259
00:17:35,800 --> 00:17:37,890
!سأسحبكما إلى الداخل

260
00:17:39,810 --> 00:17:41,600
!ماذا نفعل يا كيتارو؟

261
00:17:41,720 --> 00:17:43,350
!توجه للأمام مباشرة

262
00:17:45,350 --> 00:17:49,190
!ستبتلعنا

263
00:17:49,310 --> 00:17:51,650
!لن تهربا منّي

264
00:17:53,610 --> 00:17:55,740
!أومي-بوزو

265
00:18:07,580 --> 00:18:10,000
!لقد أنقذتنا يا أومي-بوزو

266
00:18:23,220 --> 00:18:28,770
،سواءً كنتِ سيكيو أو أيّ شيء
.فلا يمكنك هزيمة البحر

267
00:18:29,480 --> 00:18:33,110
!لا! اتركني

268
00:18:36,570 --> 00:18:40,240
.أكثر حذرًا

269
00:18:40,370 --> 00:18:42,120
!لا تكن متذمرًا

270
00:18:44,040 --> 00:18:45,370
...حسنًا إذًا

271
00:18:45,750 --> 00:18:49,120
ماذا نفعل بتلك المرأة البذيئة؟

272
00:18:49,250 --> 00:18:50,790
.أعطونيّاها

273
00:18:50,920 --> 00:18:53,670
.سأحتفظ بها كأليفة لفترة

274
00:18:54,300 --> 00:18:56,840
!اتركني! اتركني

275
00:18:56,970 --> 00:18:59,890
!لا! اتركني

276
00:19:05,720 --> 00:19:07,890
!الرجل الجرذ

277
00:19:09,560 --> 00:19:12,520
!الرجل الجرذ-سان! لقد أتيت لي

278
00:19:12,650 --> 00:19:16,190
!أرجوك ساعدني
!لن أفعل شيئًا سيّئًا بعد الآن

279
00:19:17,240 --> 00:19:18,780
!يا لها من كذبة سافرة

280
00:19:18,900 --> 00:19:20,570
.إنّها لا تستسلم أبدًا

281
00:19:20,700 --> 00:19:24,120
!أرجوك! صدقني، سأغير أسلوبي

282
00:19:24,240 --> 00:19:25,700
!أرجوك

283
00:19:25,830 --> 00:19:28,750
.سآخذها إذًا

284
00:19:29,080 --> 00:19:32,290
!أحبك

285
00:19:32,630 --> 00:19:34,920
...هذا يكفي أيّتها الـ

286
00:19:35,050 --> 00:19:36,670
!سيّد أومي-بوزو

287
00:19:38,380 --> 00:19:40,630
هل يمكنك إطلاق سراحها؟

288
00:19:45,560 --> 00:19:46,720
ماذا؟

289
00:19:46,850 --> 00:19:49,560
!أخبرتك أن تطلق سراحها

290
00:19:49,690 --> 00:19:51,310
ماذا قلت؟

291
00:19:51,730 --> 00:19:53,980
...إلّم ترد ذلك

292
00:19:57,480 --> 00:20:00,650
!فسأكون خصمك

293
00:20:08,700 --> 00:20:12,750
سيكيو تلك لم تقل شكرًا حتّى

294
00:20:12,880 --> 00:20:16,380
.كانت قبيحة في نهاية المطاف
!شخصيّتها كانت قبيحة أيضًا

295
00:20:16,710 --> 00:20:19,630
.حسنًا، ليس وكأنّي لا أفهم ذلك

296
00:20:19,760 --> 00:20:22,720
!...بذلك الجسم المتفجر

297
00:20:23,510 --> 00:20:25,850
!هل تريدني أن أقبلك بدلًا من ذلك؟

298
00:20:26,390 --> 00:20:28,350
أكانت تلك فكرة سديدة؟

299
00:20:28,470 --> 00:20:32,060
سيظهر أشخاص مخدوعين من
.قِبل سيكيو مع الوقت

300
00:20:32,190 --> 00:20:35,810
.سنعاقبها ثانية إن حدث ذلك

301
00:20:36,980 --> 00:20:38,110
...ولكن

302
00:20:39,900 --> 00:20:41,900
،لم أقل ذلك سابقًا

303
00:20:42,780 --> 00:20:47,530
.ولكنّها تركت هذا ولم تسرقه

304
00:20:47,990 --> 00:20:49,160
...أتساءل لماذا

305
00:20:49,290 --> 00:20:52,040
أما زلت تقول ذلك؟
.لا بدّ وأنّها نست سرقته فحسب

306
00:20:52,410 --> 00:20:54,080
.هذا كلّ ما بالأمر

307
00:20:54,210 --> 00:20:56,880
.نعم. أعتقد ذلك

308
00:20:57,630 --> 00:21:00,010
.أريد تصديق ذلك

309
00:21:00,130 --> 00:21:04,640
أنّ كان لدى سيكيو
.ذرة طيبة في قلبها

310
00:21:04,760 --> 00:21:09,930
وأنّ مشاعر الرجل الجرذ
.وصلتها ولو قليلًا

311
00:21:24,030 --> 00:21:26,740
!هيّا أيّها العم، أكثر قليلًا

312
00:21:27,030 --> 00:21:30,490
!هذا فقط؟! أيّها البخيل

313
00:21:27,030 --> 00:21:30,740
محل رهانات

314
00:21:31,450 --> 00:21:32,500
!خلاص جيّد

315
00:21:32,620 --> 00:21:34,000
!لأذهب وأصرفه

316
00:21:38,960 --> 00:21:40,300
تفاحة؟

317
00:21:51,930 --> 00:21:53,980
!لا يمكن ذلك

318
00:21:54,230 --> 00:21:57,560
بي، بي، بيبيبي نو بي

319
00:21:57,690 --> 00:22:00,820
في مصرف الأشباح

320
00:22:01,320 --> 00:22:03,820
تفيض الأموال

321
00:22:03,940 --> 00:22:05,070
أتمنّى

322
00:22:05,990 --> 00:22:16,790
سمعت صوت الغيتّا خاصته

323
00:22:18,710 --> 00:22:23,050
من هذا من خلفي؟

324
00:22:24,460 --> 00:22:28,800
لا أستطيع الالتفات

325
00:22:29,800 --> 00:22:35,520
إن آمنت أنّ بإمكاني رؤية قوّة مخفيّة

326
00:22:35,640 --> 00:22:39,980
خلف ذلك الظلام الذي لا يمكن مسحه

327
00:22:40,770 --> 00:22:51,490
سمعت صوت الغيتّا خاصته

328
00:23:06,260 --> 00:23:08,260
.تطبيق غامض ينتشر

329
00:23:08,760 --> 00:23:11,720
...أبي، هذه النجمة الخماسيّة المقلوبة

330
00:23:12,350 --> 00:23:15,020
:الحلقة القادمة من غيغيغي نو كيتارو

331
00:23:15,140 --> 00:23:17,020
".لعنة كوبيري-أوني"

332
00:23:17,390 --> 00:23:19,810
...يفتح الباب إلى العالم غير المرئي