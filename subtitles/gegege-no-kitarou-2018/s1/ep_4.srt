1
00:00:20,470 --> 00:00:23,560
.لا تدخل غابة غيغيغي بلا إذن

2
00:00:23,690 --> 00:00:25,480
هل أنت أوتيوبر يا سيّد؟

3
00:00:25,810 --> 00:00:27,440
هل يمكنني أكله؟

4
00:00:27,560 --> 00:00:28,650
.أعارض ذلك

5
00:00:35,450 --> 00:00:38,280
.العالم الذي تراه ليس كلّ شيء

6
00:00:38,950 --> 00:00:41,160
.هناك أشياء لا يمكنك رؤيتها

7
00:00:41,580 --> 00:00:44,960
...أترى؟ في الظلام من خلفك

8
00:01:01,180 --> 00:01:04,850
غي غي غيغيغي نو غي

9
00:01:05,190 --> 00:01:08,770
نائم في السرير خلال الصباح

10
00:01:09,610 --> 00:01:13,490
هذا ممتع، ممتعٌ للغاية

11
00:01:13,610 --> 00:01:17,280
لا تملك الأشباح مدرسة

12
00:01:17,410 --> 00:01:21,160
ولا اختبارات ولا أيّ شيء

13
00:01:21,740 --> 00:01:25,960
غي غي غيغيغي نو غي

14
00:01:26,080 --> 00:01:29,540
لنغن جميعًا، غيغيغي نو غي

15
00:01:29,880 --> 00:01:33,760
غي غي غيغيغي نو غي

16
00:01:34,170 --> 00:01:37,630
مهرجانات رياضيّة في المقبرة خلال الليل

17
00:01:38,510 --> 00:01:42,510
هذا ممتع، ممتعٌ للغاية

18
00:01:42,640 --> 00:01:46,640
الأشباح لا تموت

19
00:01:46,770 --> 00:01:50,060
أو تمرض ولا أيّ شيء

20
00:01:50,940 --> 00:01:54,530
غي غي غيغيغي نو غي

21
00:01:54,900 --> 00:02:07,790
لنغن جميعًا، غيغيغي نو غي

22
00:02:14,130 --> 00:02:15,510
أيوجد أحد هنا؟

23
00:02:15,630 --> 00:02:18,260
!أرجوكم! أيوجد أحد؟

24
00:02:44,580 --> 00:02:45,540
الفصل 4

25
00:02:55,340 --> 00:02:57,380
!مانا-تشان

26
00:02:57,920 --> 00:02:59,300
!يوتا-كن

27
00:03:00,050 --> 00:03:01,840
هل قابلتِ كيتارو؟

28
00:03:01,970 --> 00:03:03,550
!نعم، قابلته

29
00:03:03,680 --> 00:03:06,890
...يدعى والد كيتارو "الأب مقلة العين-سان"، و

30
00:03:08,520 --> 00:03:11,730
.لا يختلط عالمي اليوكاي والبشر

31
00:03:12,690 --> 00:03:14,860
.لا ينبغي عليهما ذلك

32
00:03:16,150 --> 00:03:16,940
...آسفة، ولكن

33
00:03:17,070 --> 00:03:20,200
!عرفت ذلك! عرفت أنّ كيتارو موجود فعلًا

34
00:03:20,320 --> 00:03:23,950
!كما قالت جدتي، اليوكاي موجودون حقًّا

35
00:03:24,070 --> 00:03:26,700
يوتا-كن؟

36
00:03:27,040 --> 00:03:31,500
آسفة، ولكن لا يفترض عليّ
.إخبار الناس عن كيتارو

37
00:03:31,620 --> 00:03:33,130
لماذا؟

38
00:03:33,250 --> 00:03:37,340
قال كيتارو أنّ عالم البشر
...واليوكاي يجب ألّا يختلطا، و

39
00:03:47,970 --> 00:03:49,730
يعيش كيتارو هنا؟

40
00:03:50,060 --> 00:03:51,890
.لا يعيش هنا

41
00:03:52,270 --> 00:03:55,980
غابة غيغيغي حيث يكون كيتارو
.والبقيّة متصلة بهذا المكان

42
00:03:56,110 --> 00:03:59,280
ولكن يبدو أنّ البشر لا يستطيعون
.دخول غابة غيغيغي

43
00:03:59,400 --> 00:04:01,570
.أنا لم أذهب إليها حتّى

44
00:04:01,700 --> 00:04:04,700
!لا يمكن للبشر دخولها؟ مذهل

45
00:04:04,820 --> 00:04:06,070
هل هي هنا؟

46
00:04:06,200 --> 00:04:07,450
هنا؟

47
00:04:08,990 --> 00:04:11,660
.أخبرتك أنّ البشر لا يستطيعون الدخول

48
00:04:12,080 --> 00:04:13,210
!نفق

49
00:04:13,580 --> 00:04:15,330
!انظري يا مانا-تشان

50
00:04:15,790 --> 00:04:18,420
أتعتقدين أنّه متصل
إلى غابة غيغيغي؟

51
00:04:18,550 --> 00:04:20,010
ماذا؟

52
00:04:23,050 --> 00:04:24,550
.ربما يكون كذلك

53
00:04:24,680 --> 00:04:27,890
!مرحى، يمكنني مقابلة كيتارو

54
00:04:28,010 --> 00:04:28,930
!مذهل

55
00:04:29,060 --> 00:04:32,390
!إنّه يستمر لمسافة طويلة-
"...أمي، اشتريت رقائق بطاطس"

56
00:04:34,940 --> 00:04:37,110
ماذا؟ يوتا-كن؟

57
00:04:41,070 --> 00:04:42,190
!ماذا؟

58
00:04:43,280 --> 00:04:44,610
يوتا-كن؟

59
00:04:44,740 --> 00:04:47,240
!أين ذهبت؟ يوتا-كن

60
00:04:47,370 --> 00:04:49,080
!يوتا-كن

61
00:05:16,940 --> 00:05:20,270
هل هذه غابة غيغيغي؟

62
00:05:24,860 --> 00:05:27,280
ماذا؟ أين ذهب النفق؟

63
00:05:28,450 --> 00:05:30,410
ماذا؟

64
00:05:31,120 --> 00:05:33,410
من أين أتيت يا طفل؟

65
00:05:34,660 --> 00:05:35,790
!مـ-من أنت؟

66
00:05:36,330 --> 00:05:37,830
.هذا فظ

67
00:05:37,960 --> 00:05:42,250
.أنا بيبيبي نو الرجل الجرذ-ساما
.أنا مشهور كثيرًا

68
00:05:42,380 --> 00:05:44,260
هل أنت أوتيوبر يا سيّد؟

69
00:05:44,380 --> 00:05:46,130
.لا، لست كذلك

70
00:05:46,260 --> 00:05:47,680
.لا أعرفك إذًا

71
00:05:48,640 --> 00:05:49,760
...يا إلهي

72
00:05:49,890 --> 00:05:53,020
لا بدّ وأنّك طفل تاه إلى
.هنا من عالم البشر

73
00:05:53,140 --> 00:05:54,730
.هيّا، ارجع

74
00:05:54,850 --> 00:05:57,690
!ماذا؟ أهذه غابة غيغيغي حقًّا إذًا؟

75
00:05:57,810 --> 00:06:00,360
.صحيح. إنّها غابتي

76
00:06:00,480 --> 00:06:02,820
!هل أنت يوكاي إذًا يا سيّد؟

77
00:06:02,940 --> 00:06:08,530
.يوكاي؟ أنا أفوق اليوكاي
.أنا نصف بشري ونصف يوكاي

78
00:06:09,570 --> 00:06:12,490
ما هذه الجلبة أيّها الرجل الجرذ؟

79
00:06:24,130 --> 00:06:26,090
!هل أنت كيتارو-سان؟

80
00:06:26,220 --> 00:06:27,630
!كيتارو-سان

81
00:06:27,760 --> 00:06:31,550
!أردت مقابلتك
!من المذهل أنّك موجود فعلًا

82
00:06:32,180 --> 00:06:33,890
من أنت؟

83
00:06:35,930 --> 00:06:38,390
!الأب مقلة العين-سان؟

84
00:06:39,940 --> 00:06:40,980
...إنّك حقًّا

85
00:06:41,100 --> 00:06:43,610
!إنّك حقيقي بالفعل-
!هذا يدغدغ

86
00:06:44,070 --> 00:06:46,360
!هذا كما قالت مانا-شان

87
00:06:47,740 --> 00:06:49,110
.انتظر

88
00:06:49,860 --> 00:06:51,740
...بمانا-تشان، تعني

89
00:06:51,870 --> 00:06:54,490
...نعم! جارتي ابنة عائلة إينوياما

90
00:06:54,830 --> 00:06:56,370
!مانا-تشان

91
00:06:56,500 --> 00:06:57,450
...تلك

92
00:06:57,580 --> 00:07:01,630
،أخبرني يا كيتارو-سان
هذه غابة غيغيغي، صحيح؟

93
00:07:01,750 --> 00:07:03,960
يوجد الكثير من اليوكاي، صحيح؟

94
00:07:04,590 --> 00:07:07,880
.لا تدخل غابة غيغيغي بلا إذن

95
00:07:17,720 --> 00:07:21,940
كم قرنًا قد مر منذ أن تاه بشري إلى هنا؟

96
00:07:22,060 --> 00:07:25,730
.أعتقد أنّ آخر واحد كان اسمه توراكيتشي

97
00:07:25,860 --> 00:07:30,030
.صبي ثانية؟ أفضّل لو كانت فتاة

98
00:07:30,150 --> 00:07:33,990
أنت تحب النساء حقًّا
يا لفافة القطن-سان، صحيح؟

99
00:07:34,120 --> 00:07:35,280
مـ-ما الذي تقوله؟

100
00:07:35,410 --> 00:07:36,950
!بالطبع-
هل تريدني أن أقبّلك؟

101
00:07:37,080 --> 00:07:39,330
لماذا تضحكون بلا أيّ هم؟

102
00:07:39,450 --> 00:07:41,870
بشري يدخل غابة غيغيغي؟

103
00:07:42,000 --> 00:07:43,330
.أعارض هذا

104
00:07:43,460 --> 00:07:46,800
.صحيح، لا أموال تدرّ من هذا على أيّ حال

105
00:07:46,920 --> 00:07:48,340
.اطردوه بسرعة

106
00:07:48,800 --> 00:07:51,470
.ما هذا؟ إنّنا نتوافق وهذا أمر نادر

107
00:07:51,590 --> 00:07:53,970
المعذرة، أنتِ الفتاة القطّة-سان، صحيح؟

108
00:07:54,090 --> 00:07:54,850
وما بذلك؟

109
00:07:54,970 --> 00:07:57,600
...إنّك كما قالت مانا-تشان

110
00:07:58,100 --> 00:08:04,310
الفتاة القطّة-سان قويّة جدًّا، ورغم ذلك"
".إنّها لطيفة وجميلة ورائعة جدًّا

111
00:08:04,730 --> 00:08:06,980
!هذا ما قالته مانا-تشان

112
00:08:07,940 --> 00:08:10,190
تعرف مانا؟-
!نعم-

113
00:08:10,320 --> 00:08:13,320
هيّا، لقد قابلتَ الجميع، ألم تكتفي؟

114
00:08:13,450 --> 00:08:14,870
.عد إلى البيت

115
00:08:14,990 --> 00:08:17,580
.لا تكن قاسيًا يا كيتارو

116
00:08:17,700 --> 00:08:20,330
.لا بدّ وأنّ القدر هو من أحضره إلى هنا

117
00:08:20,450 --> 00:08:22,250
!...ساحرة الرمل-سان

118
00:08:22,370 --> 00:08:27,340
لحظة. كيف تمكن طفل بشري
بالدخول إلى غابة غيغيغي؟

119
00:08:27,460 --> 00:08:31,420
.أرواح أطفال البشر ليست مستقرّة

120
00:08:31,920 --> 00:08:34,840
.وكأنّهم بين البشر واليوكاي

121
00:08:35,680 --> 00:08:37,430
ما هو اسمك يا صبي؟

122
00:08:37,550 --> 00:08:38,560
.يوتا

123
00:08:38,680 --> 00:08:42,310
يوتا-كن، أنت تؤمن بالأشياء
التي لا يمكنك رؤيتها، صحيح؟

124
00:08:42,430 --> 00:08:45,440
نعم، أخبرتني جدّتي

125
00:08:45,560 --> 00:08:48,900
.عن كيتارو-سان وبقيّة اليوكاي

126
00:08:49,020 --> 00:08:51,070
.فهمت. جدّتك

127
00:08:51,190 --> 00:08:54,860
أنا من اقترح أن نضع رسالة
.في صندوق بريد اليوكاي

128
00:08:54,990 --> 00:08:57,240
.لأنّ جدّتي علّمتني ذلك

129
00:08:57,370 --> 00:08:59,080
.فهمت، فهمت

130
00:08:59,200 --> 00:09:02,620
،كما قالت ساحرة الرمال
.المقابلة بالصدفة هي أمر مقدّر

131
00:09:03,250 --> 00:09:05,750
.أره أرجاء الغابة يا كيتارو

132
00:09:05,870 --> 00:09:06,830
ماذا؟

133
00:09:08,340 --> 00:09:10,050
.حسنًا يا أبي

134
00:09:11,670 --> 00:09:13,880
.سأريك أرجاء المكان، لذا اتبعني

135
00:09:14,550 --> 00:09:17,640
.ولكن لا تلمس شيئًا في الغابة

136
00:09:17,760 --> 00:09:18,470
!حسنًا

137
00:09:21,720 --> 00:09:22,850
.خائن

138
00:09:24,390 --> 00:09:26,600
.لـ-لـ-لا شيء
!مخيفة-

139
00:09:30,360 --> 00:09:32,570
.هذه غابة غيغيغي

140
00:09:32,690 --> 00:09:34,360
.هذه الشجرة الخالدة

141
00:09:34,490 --> 00:09:36,610
.وما بعدها هي ينابيع اليوكاي الساخنة

142
00:09:36,740 --> 00:09:41,080
.ومن هناك يوجد صدع ميداما
.ويليه شلّال ياشاغا

143
00:09:41,200 --> 00:09:42,450
!مذهل

144
00:09:42,580 --> 00:09:44,580
.لا تذهب بلا إذن

145
00:09:44,710 --> 00:09:49,210
ما باليد حيلة. إنّ أطفال
.البشر عبارة عن كرة من الفضول

146
00:09:49,330 --> 00:09:51,300
.هذا ليس بالأمر السيّئ

147
00:09:51,420 --> 00:09:52,460
.نعم، نعم

148
00:10:54,320 --> 00:10:56,860
.كيتارو

149
00:10:59,070 --> 00:11:01,410
.لن يؤذيك. إنّه يوكاي لطيف

150
00:11:01,780 --> 00:11:03,490
.إنّه يعرف الكثير من الأمور

151
00:11:04,790 --> 00:11:08,580
.طفل بشري. هذا أمرٌ نادر

152
00:11:08,710 --> 00:11:13,170
!أنت أبورا-سوماشي-سان، صحيح؟
!سمعت من جدّتي عن أمرك

153
00:11:14,170 --> 00:11:15,880
.ما زلت هنا

154
00:11:16,050 --> 00:11:18,300
هل تريد لعب الشوغي يا كيتارو؟

155
00:11:18,920 --> 00:11:20,220
.في المرّة القادمة

156
00:11:46,540 --> 00:11:48,500
...أيّتها الفتاة القطّة-سان

157
00:11:48,620 --> 00:11:50,910
.لا بأس، إنّه بيتوبيتو-سان فحسب

158
00:11:51,080 --> 00:11:52,620
بيتوبيتو-سان؟

159
00:11:52,750 --> 00:11:54,920
!سمعت عنه من جدّتي

160
00:11:56,250 --> 00:11:59,260
تعرف جدّتك الكثير، أليس كذلك يا يوتا؟

161
00:11:59,380 --> 00:12:00,300
!نعم

162
00:12:00,420 --> 00:12:05,010
لنرَ... يفترض أن أذهب إلى
...جانب الطريق، ثم

163
00:12:09,680 --> 00:12:12,100
.تفضّل يا بيتوبيتو-سان

164
00:12:31,580 --> 00:12:34,000
!كما قالت جدّتي

165
00:12:34,120 --> 00:12:39,210
كيتارو-سان، أتعتقد أنّ
اليوكاي يحبون البشر؟

166
00:12:39,340 --> 00:12:42,340
.بعضهم يفعل وبعضهم ليس كذلك

167
00:12:42,470 --> 00:12:43,930
.كالبشر

168
00:12:44,510 --> 00:12:50,140
لا يؤمن بعض البشر بما لا يمكن
.رؤيته، والبعض يخاف منه بشكل مفرط

169
00:12:56,610 --> 00:12:58,730
.هذا مستنقع أودوروغا

170
00:13:01,940 --> 00:13:04,950
ماذا؟ طفل بشري؟

171
00:13:05,280 --> 00:13:06,870
هل يمكنني أكله؟

172
00:13:08,080 --> 00:13:11,330
.لا يمكنك. إنّه ضيفي

173
00:13:11,450 --> 00:13:13,460
لا يمكنني أكله؟

174
00:13:14,710 --> 00:13:16,880
.ولكنّه يبدو لذيذًا

175
00:13:17,000 --> 00:13:19,590
.ما باليد حيلة، سآخذ غفوة إذًا

176
00:13:23,510 --> 00:13:28,510
فهمت؟ هناك من سيحاول أكل
.البشر في غابة غيغيغي

177
00:13:29,430 --> 00:13:34,310
ولكنّي سأكون بخير طالما كنتَ
أنت والفتاة القطّة-سان هنا، صحيح؟

178
00:13:34,430 --> 00:13:36,230
!بالطبع

179
00:13:36,520 --> 00:13:38,060
...إنّه لا يفهم

180
00:13:39,060 --> 00:13:41,280
أين نذهب تاليًا؟

181
00:13:41,400 --> 00:13:43,110
ماذا عن منزل ساكوسان-با؟

182
00:13:43,240 --> 00:13:46,700
لا ندري ما إن ستكون
.في مزاج جيّد أم سيّئ

183
00:13:47,740 --> 00:13:51,580
.إنّنا قريبون من منزل ياما-جيجي
.علينا الإسراع إلى هناك

184
00:14:11,220 --> 00:14:12,260
ماذا تفعل؟

185
00:14:13,430 --> 00:14:14,980
.لنذهب-
!حـ-حسنًا

186
00:14:27,820 --> 00:14:30,030
غابة غيغيغي

187
00:14:30,870 --> 00:14:34,540
اليوكاي ياما-جيجي

188
00:14:35,910 --> 00:14:38,870
!يا كيتارو

189
00:14:42,210 --> 00:14:45,130
أيّها العجوز البكاء، أتشرب في
مكان كهذا ثانيةً؟

190
00:14:45,260 --> 00:14:49,510
الشارب في النعيم طالما
.لديه شيئًا ليشربه

191
00:14:49,640 --> 00:14:50,760
.كيتارو

192
00:14:53,850 --> 00:14:57,640
.الغابة تنفعل. حدث شيءٌ ما

193
00:14:58,730 --> 00:14:59,770
!يا لفافة القطن

194
00:14:59,900 --> 00:15:01,690
!قادم

195
00:15:02,440 --> 00:15:05,780
