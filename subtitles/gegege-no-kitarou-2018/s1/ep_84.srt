!أشجعك

218
00:13:47,950 --> 00:13:48,990
.مانا

219
00:13:52,950 --> 00:13:55,500
!اشعر بالامتنان لحصولك على المال

220
00:14:00,630 --> 00:14:02,420
هل أنت بخير؟

221
00:14:03,550 --> 00:14:07,890
.نعمل بجهد أكبر من اليابانيين، ولكن أجورنا منخفضة للغاية

222
00:14:08,180 --> 00:14:10,390
كيف تتحمل هذا يا باولو؟

223
00:14:11,220 --> 00:14:15,640
لا توجد أماكن كثيرة يمكن للأجانب
.مثلنا أن يعملوا فيها في هذه الدولة

224
00:14:15,770 --> 00:14:19,770
.ولكن سبب استمراري هو... لأني أملك حلمًا

225
00:14:19,900 --> 00:14:21,270
حلم؟

226
00:14:21,400 --> 00:14:24,360
.أريد كسب الكثير من المال بسرعة

227
00:14:24,480 --> 00:14:27,910
.ومن ثم أعود إلى دولتي وأدرس في الجامعة

228
00:14:28,280 --> 00:14:29,990
.هذا رائع

229
00:14:30,530 --> 00:14:32,950
أتيت لحلم ما أيضًا، أليس كذلك؟

230
00:14:33,450 --> 00:14:34,700
...أنا

231
00:14:39,920 --> 00:14:42,420
.لنبذل جهدنا من أجل أحلامنا

232
00:14:43,210 --> 00:14:45,050
.أجل. حسنًا

233
00:14:47,130 --> 00:14:48,880
هل أنت بخير يا باولو؟

234
00:14:49,010 --> 00:14:50,800
.أ-أنا بخير

235
00:14:57,020 --> 00:14:58,020
.ارتح قليلًا

236
00:14:58,140 --> 00:15:00,350
.أ-أنا بخير

237
00:15:00,480 --> 00:15:02,690
.سأؤدي عملك بدلًا منك

238
00:15:03,150 --> 00:15:04,230
.لا بأس

239
00:15:04,360 --> 00:15:07,280
...لا أريد أن أسبب لك المتاعب

240
00:15:09,660 --> 00:15:11,030
!باولو

241
00:15:12,700 --> 00:15:13,950
!حرارتك مرتفعة للغاية

242
00:15:14,080 --> 00:15:15,290
!فليتصل أحد بالمستشفى

243
00:15:19,920 --> 00:15:22,630
لماذا لا يقدم أحد المساعدة؟

244
00:15:22,750 --> 00:15:24,960
لماذا تتقاعس؟

245
00:15:25,550 --> 00:15:29,300
!باولو مصاب بحمى شديدة
!سيموت إن عمل أكثر من هذا

246
00:15:29,420 --> 00:15:31,050
!لا يهمني! اعمل

247
00:15:31,180 --> 00:15:32,800
!مت إلم تتمكن من ذلك

248
00:15:33,890 --> 00:15:36,140
!ماذا؟

249
00:15:36,770 --> 00:15:39,230
!خذ باولو إلى المشفى

250
00:15:40,730 --> 00:15:42,190
!اتركني

251
00:15:42,310 --> 00:15:45,860
هل تريد أن أبطل الفيزا خاصته وجوازه؟

252
00:15:45,980 --> 00:15:47,150
!ماذا؟

253
00:15:48,490 --> 00:15:50,280
!حاول ضربي

254
00:15:50,400 --> 00:15:54,030
!سأجعل عملكم في اليابان ثانية مستحيلًا

255
00:15:55,240 --> 00:15:59,910
!أنتم الأجانب عليكم العمل بصمت

256
00:16:02,920 --> 00:16:05,420
!آ... آسف

257
00:16:05,540 --> 00:16:08,920
...ماذا؟ حتى لو اعتذرت

258
00:16:09,050 --> 00:16:10,720
.آسف يا مانا

259
00:16:10,840 --> 00:16:13,300
.سأخلف بوعدي

260
00:16:13,680 --> 00:16:17,930
!لا يمكنني... مسامحة هذا الشخص

261
00:16:22,730 --> 00:16:23,520
!ما...؟

262
00:16:23,900 --> 00:16:25,400
!هل تستخف بي؟

263
00:16:25,520 --> 00:16:31,150
!لم يعد هناك ما يمكنه كبح غضبي

264
00:16:32,860 --> 00:16:34,450
!...أ-أنت

265
00:16:34,570 --> 00:16:36,580
!أيها الوغد! ماذا تفعل؟

266
00:16:36,700 --> 00:16:37,450
!سنقتلك

267
00:16:37,870 --> 00:16:39,040
!استمعوا

268
00:16:39,160 --> 00:16:41,210
!أكرس هذا لكم

269
00:16:41,330 --> 00:16:44,210
!هذا القداس

270
00:16:46,840 --> 00:16:48,840
...يا للطف السلام

271
00:16:48,960 --> 00:16:50,130
.صحيح

272
00:16:50,260 --> 00:16:51,720
!كيتارو

273
00:16:51,840 --> 00:16:54,090
!...مصيبة! تشين-سان

274
00:16:54,220 --> 00:16:58,970
رجل عارٍ يهاجم 50 شخصًا

275
00:17:00,600 --> 00:17:02,350
فعلها

276
00:17:13,400 --> 00:17:15,240
!ذلك الوغد

277
00:17:15,570 --> 00:17:17,070
!لن تهرب

278
00:17:17,200 --> 00:17:19,830
!أنت التالي

279
00:17:22,200 --> 00:17:23,750
!توقف

280
00:17:23,870 --> 00:17:25,210
.كيتارو

281
00:17:27,960 --> 00:17:30,590
!كـ-كيتارو، سأترك الأمر لك

282
00:17:30,840 --> 00:17:33,010
لماذا فعلت هذا؟

283
00:17:34,130 --> 00:17:35,970
...قال لنا

284
00:17:36,090 --> 00:17:39,430
!أن نصمت ونعمل، وإلا نموت

285
00:17:41,060 --> 00:17:44,230
!سيُقتل باولو حقًا على هذا النحو

286
00:17:44,350 --> 00:17:46,560
!لهذا سأسحقه أولًا

287
00:17:50,360 --> 00:17:52,440
!توقف

288
00:17:56,410 --> 00:17:57,570
.مانا

289
00:17:58,320 --> 00:18:00,450
.لا يمكنك أن تلجأ للعنف

290
00:18:00,780 --> 00:18:03,450
!أساء لصديقي

291
00:18:03,580 --> 00:18:04,910
!استخدم العنف

292
00:18:05,290 --> 00:18:09,420
!لا يعني هذا أن بإمكانك إيذاءه

293
00:18:09,880 --> 00:18:11,800
!مانا، لماذا توقفينني؟

294
00:18:12,250 --> 00:18:13,800
!لأننا صديقان

295
00:18:17,630 --> 00:18:21,720
رؤيتك تبذل جهدك من أجل قريتك
!جعلتني أريد أن أصادقك

296
00:18:21,850 --> 00:18:23,560
!ظننتني كذلك

297
00:18:23,680 --> 00:18:26,690
!أريد أن نصبح صديقين مقربين أكثر

298
00:18:28,560 --> 00:18:31,190
،قد تكون تعرضت لأمور سيئة

299
00:18:31,320 --> 00:18:34,190
ولكن إن قمت بالمزيد فلن
!تكون قادرًا على إعادة حساباتك لاحقًا

300
00:18:36,150 --> 00:18:38,950
!لذا أرجوك لا تغضب

301
00:18:39,450 --> 00:18:42,660
!لا تكره البشر

302
00:18:55,880 --> 00:19:00,340
هل تعدني ألا تؤذيهم بعد الآن؟

303
00:19:00,470 --> 00:19:03,640
!أجل! أعدك

304
00:19:03,970 --> 00:19:07,100
.أتيت إلى اليابان بحلم

305
00:19:07,230 --> 00:19:10,940
.ولكن كان هذا المكان باردًا للأجانب

306
00:19:11,480 --> 00:19:14,610
.اعتقدت أن كسب العيش سيكون أمتع

307
00:19:14,730 --> 00:19:18,360
.اعتقدت أن الجميع سيتوافق

308
00:19:18,990 --> 00:19:21,870
.ولكني قابلت أشخاصًا طيبين أيضًا

309
00:19:21,990 --> 00:19:23,620
.التقيت بمانا

310
00:19:31,830 --> 00:19:35,250
!منحتني مانا الشجاعة! منحتني القوة

311
00:19:35,380 --> 00:19:40,300
!لهذا لن أكره بشر هذه الدولة

312
00:19:40,720 --> 00:19:42,260
.شكرًا لك

313
00:19:42,680 --> 00:19:49,060
فقط لو تقرب الجميع من بعضهم البعض
،مثل مانا وتشين-سان

314
00:19:49,180 --> 00:19:51,770
.فلن تكون هناك صراعات

315
00:19:52,270 --> 00:19:54,820
.صحيح يا أبي

316
00:20:01,410 --> 00:20:04,030
إغلاق مستودع
لمخالفة قانون معايير العمل

317
00:20:08,410 --> 00:20:09,910
.تعال ثانية في وقت ما

318
00:20:10,040 --> 00:20:13,290
.صحيح. سنرحب بك دائمًا

319
00:20:13,420 --> 00:20:14,670
.اعتن بنفسك

320
00:20:14,790 --> 00:20:16,090
.شكرًا لكم

321
00:20:16,630 --> 00:20:18,090
ماذا ستفعل الآن؟

322
00:20:18,590 --> 00:20:23,180
.وجدت عملًا آخرًا في اليابان، ولكنه بعد قليلًا

323
00:20:23,300 --> 00:20:25,390
.سأكسب المال هناك

324
00:20:27,510 --> 00:20:29,270
سنتقابل ثانية، صحيح؟

325
00:20:29,390 --> 00:20:32,730
،بعد أن أكسب المال، وتصبح قريتي أغنى

326
00:20:32,850 --> 00:20:34,520
!فسآتي لرؤية مانا

327
00:20:35,650 --> 00:20:36,900
هل هذا وعد؟

328
00:20:37,020 --> 00:20:38,280
.إنه وعد

329
00:20:43,490 --> 00:20:44,410
.صحيح

330
00:20:44,530 --> 00:20:46,990
.اشتريت هذا بأجري

331
00:20:50,120 --> 00:20:53,330
.منحتني مانا هذا، لذا هذا عربون شكر

332
00:20:53,460 --> 00:20:57,960
يسعدني هذا! ولكن ألا تمانع ذلك؟
.إنه مال عملت بجد لكسبه

333
00:20:58,090 --> 00:21:00,090
.لا بأس، لا تقلقي

334
00:21:00,210 --> 00:21:02,800
.أسعد هذا مانا

335
00:21:02,930 --> 00:21:04,640
!هذا يسعدني

336
00:21:05,010 --> 00:21:06,390
!شكرًا لك

337
00:21:06,930 --> 00:21:08,890
.سأذهب الآن

338
00:21:09,010 --> 00:21:10,390
!إلى اللقاء

339
00:21:10,520 --> 00:21:11,680
!تمهل يا تشين-سان

340
00:21:12,060 --> 00:21:15,560
!أخبرني باسمك الحقيقي

341
00:21:15,690 --> 00:21:18,320
...اسمي تشين

342
00:21:24,280 --> 00:21:26,370
.لم أتمكن من سماعه

343
00:21:26,490 --> 00:21:28,450
.هذا أفضل

344
00:21:29,620 --> 00:21:31,450
هل تشعر بالقلق حيال تشين-سان؟

345
00:21:31,580 --> 00:21:35,870
أجل. هل سيتمكن من إيجاد عمل جيد هذه المرة؟

346
00:21:36,000 --> 00:21:38,920
.سيكون بخير. انظر

347
00:21:40,960 --> 00:21:42,090
ما هذا؟

348
00:21:42,210 --> 00:21:43,550
!جميل للغاية

349
00:21:44,010 --> 00:21:46,550
!ثلاث أقواس قزح؟

350
00:21:48,510 --> 00:21:50,890
.تحدث أشياء غريبة بالفعل

351
00:21:51,010 --> 00:21:54,520
.وكأنها تحتفل بمستقبله

352
00:21:54,640 --> 00:21:59,190
!أخبرني باسمك في المرة القادمة

353
00:23:01,750 --> 00:23:05,960
...أبي، مجموعة مريبة تحاول إعادة شيء للحياء

354
00:23:06,090 --> 00:23:07,420
...هذه العين الضخمة

355
00:23:08,260 --> 00:23:10,510
الحلقة القادمة من غيغيغي نو كيتارو

356
00:23:10,640 --> 00:23:12,640
".العملاق دايدارابوتشي"

357
00:23:12,760 --> 00:23:15,140
...يفتح الباب إلى العالم غير المرئي