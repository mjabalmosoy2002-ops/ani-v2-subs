1
00:00:15,190 --> 00:00:16,530
!ابتعدي عن طريقي

2
00:00:20,470 --> 00:00:23,080
!إيرنيستا

3
00:00:33,100 --> 00:00:34,050
!إمبرز

4
00:00:37,620 --> 00:00:38,640
.بطيئة

5
00:00:41,510 --> 00:00:42,310
—ما

6
00:00:42,310 --> 00:00:45,990
.كانت ستكون أختي أسرع بكثير بالتأكيد

7
00:00:50,230 --> 00:00:51,590
!شينغيتسو-تشان

8
00:00:52,840 --> 00:00:53,910
...مانغيتسو

9
00:00:54,280 --> 00:00:55,440
هل أنت بخير؟

10
00:00:55,440 --> 00:00:59,660
أعتقد أنّ بعضًا من الضرر الذي
.تلقيته المرة السابقة لا يزال يؤثر عليّ

11
00:00:59,660 --> 00:01:00,940
حقًّا؟

12
00:01:02,540 --> 00:01:03,570
ما هذا؟

13
00:01:05,410 --> 00:01:06,370
...ذلك الضوء

14
00:01:09,790 --> 00:01:11,210
!لا يمكن، ثانية

15
00:01:19,550 --> 00:01:22,010
.هذه الحرارة... لا، إنّه سحر

16
00:01:24,690 --> 00:01:26,480
.جاهزة للإطلاق

17
00:01:26,480 --> 00:01:27,390
.عُلم

18
00:01:27,390 --> 00:01:29,980
!نيني-ني، ابذلي كلّ ما لديك

19
00:01:33,400 --> 00:01:34,590
...أمي

20
00:03:27,930 --> 00:03:29,270
!نانا! ميمي! نيني

21
00:03:32,400 --> 00:03:33,650
من فعل هذا؟

22
00:03:34,430 --> 00:03:36,450
!غبيتان! أخبرتكما أن تعيداها

23
00:03:36,450 --> 00:03:37,510
!نيني

24
00:03:39,490 --> 00:03:40,400
نعم؟

25
00:03:42,030 --> 00:03:43,820
ألم أخبرك تلك المرة؟

26
00:03:44,320 --> 00:03:46,860
.لا ينبغي أن تستخدمي هذه القوة

27
00:03:47,320 --> 00:03:48,740
.آسفة

28
00:03:49,510 --> 00:03:52,460
.تستخدم تقنيات السحر للتحكم بالوحوش

29
00:03:53,200 --> 00:03:55,670
،حتى إن كانت التقنيات لا تستخدم قوة سحرية

30
00:03:55,670 --> 00:03:58,600
.فيمكنها أن تستدعي الوحوش رغم ذلك

31
00:03:59,510 --> 00:04:00,920
حقًّا؟

32
00:04:01,310 --> 00:04:04,120
،نعم. لذا في كل مرة تستخدمونها

33
00:04:04,120 --> 00:04:07,680
.يقترب وحش من الظلام نحوكن أكثر

34
00:04:07,960 --> 00:04:11,620
،في ظلام حالك، دون أيّ أثر

35
00:04:11,620 --> 00:04:14,530
...بلا أيّ صوت... حينها

36
00:04:14,530 --> 00:04:15,820
حينها؟

37
00:04:15,820 --> 00:04:18,520
،تجدنه بجانبكن قبل أن تدركن

38
00:04:19,620 --> 00:04:22,730
.جاهزًا لتناول روح من استخدم التقنية

39
00:04:40,630 --> 00:04:41,980
...يا لها من قوة

40
00:04:42,560 --> 00:04:46,300
علاوة على ذلك، كان ذلك
الشعاع يلاحقنا، أليس كذلك؟

41
00:04:46,590 --> 00:04:49,180
يملك القدرة على ملاحقة الهدف إذًا؟

42
00:04:55,810 --> 00:04:57,400
كانت فيولا خلفي؟

43
00:04:59,860 --> 00:05:01,900
...جميعكن

44
00:05:02,070 --> 00:05:03,880
!كلّ واحدة منكن

45
00:05:03,880 --> 00:05:08,120
!شينغيتسو، شينغيتسو، شينغيتسو، شينغيتسو

46
00:05:08,120 --> 00:05:10,530
!تحبون ذلك الشيء إلى هذه الدرجة؟

47
00:05:11,480 --> 00:05:16,140
!ذلك الوجه... ذلك الصوت... ذلك الشعر؟

48
00:05:20,920 --> 00:05:24,550
!هل أنتِ متأكدة؟ ستسلب كلّ شيء منك

49
00:05:24,900 --> 00:05:30,170
!كا ما أحببته... حياتي كلّها

50
00:05:39,440 --> 00:05:41,270
!سيأتي ثانية

51
00:05:43,280 --> 00:05:46,440
!إيرنيستا

52
00:05:48,100 --> 00:05:49,620
!ها هو

53
00:06:00,710 --> 00:06:02,040
...لا تنظري

54
00:06:09,830 --> 00:06:11,930
!بدأت بفهم الأمر

55
00:06:19,160 --> 00:06:20,940
.رأيته. هنا

56
00:06:26,540 --> 00:06:28,770
.أصبح تصويبها أفضل

57
00:06:34,300 --> 00:06:35,870
...متى تعلمتِ

58
00:06:35,870 --> 00:06:37,470
!لا أدري

59
00:06:37,470 --> 00:06:41,580
لا أستطيع رؤيته، ولكني أشعر
!من أيّ اتجاه سيأتي بشكل ما

60
00:06:43,390 --> 00:06:45,770
...لحظة شعورها بالقوة السحرية

61
00:06:49,370 --> 00:06:52,920
!من هنا يا مانغيتسو
!سيصعب تتبعنا من هنا

62
00:06:58,590 --> 00:06:59,710
...القمر

63
00:07:01,460 --> 00:07:02,190
كيف الأمور؟

64
00:07:02,190 --> 00:07:04,310
!سحقًا! إنّهن مرنات أكثر ممّا توقعت

65
00:07:04,500 --> 00:07:08,940
لأنّ جميع الموجودات هنا هنّ
!اللاتي نجون كلّ قتال خلال السنة الماضية

66
00:07:08,940 --> 00:07:12,070
.هنّ وأمنياتهنّ قويات للغاية

67
00:07:14,290 --> 00:07:16,960
هل تعتقدان أنّ لدي فرصة للفوز؟

68
00:07:17,790 --> 00:07:19,180
...نيني-ني

69
00:07:20,070 --> 00:07:21,190
.أمزح

70
00:07:22,050 --> 00:07:24,140
.سأفوز بالطبع

71
00:07:24,970 --> 00:07:27,720
!لن تُهزم أمنيتنا أمام أحد

72
00:07:40,810 --> 00:07:42,840
.إنّها تضيء طوال الوقت

73
00:07:43,510 --> 00:07:47,920
أعتقد أنّ دقتها المحسنة
.تقلّل من عدد الطلقات التي تحتاجها

74
00:07:48,410 --> 00:07:49,900
...بهذا المعدل

75
00:07:55,610 --> 00:07:56,580
.علينا أن نفعل شيئًا

76
00:08:03,290 --> 00:08:05,390
!سانديني يا مانغيتسو

77
00:08:05,390 --> 00:08:05,920
!ماذا؟

78
00:08:13,270 --> 00:08:15,070
.الأمور تحت سيطرتك بالكامل الآن

79
00:08:15,070 --> 00:08:17,580
!كل ما عليك فعله هو التصويب الآن يا نيني-ني

80
00:08:18,810 --> 00:08:19,390
!ماذا؟

81
00:08:19,390 --> 00:08:20,310
!يوجد شيء

82
00:08:22,770 --> 00:08:24,050
...إنّه

83
00:08:24,730 --> 00:08:26,400
!وجدتك

84
00:08:26,620 --> 00:08:29,480
!كنتِ تختبئين هنا إذًا

85
00:08:30,020 --> 00:08:31,320
!لن أسمح لك

86
00:08:36,320 --> 00:08:38,040
!دمّرت حاجزي

87
00:08:38,040 --> 00:08:39,080
بهذه السرعة؟ حقًّا؟

88
00:08:43,910 --> 00:08:47,040
اهربي! لا يمكن لجي غوان لونغ
!القتال عن قرب

89
00:08:47,040 --> 00:08:48,000
...لكن

90
00:09:01,500 --> 00:09:02,330
!ماذا؟

91
00:09:10,930 --> 00:09:11,690
.وجدتك

92
00:09:12,860 --> 00:09:14,370
!الآن يا نيني-ني

93
00:09:23,140 --> 00:09:24,170
!سحقًا

94
00:09:27,180 --> 00:09:29,330
ما هذا الصوت؟

95
00:09:31,930 --> 00:09:34,100
...صوت... مشؤوم

96
00:09:35,300 --> 00:09:37,790
!لم أرَ هذا الآرمنوكس من قبل

97
00:09:37,790 --> 00:09:38,810
!سويشو

98
00:09:38,810 --> 00:09:42,260
.اصمتي. أنا مشغولة الآن

99
00:10:20,960 --> 00:10:21,970
...القمر

100
00:10:22,390 --> 00:10:23,430
!ينزل

101
00:10:27,550 --> 00:10:28,390
...لا يمكن

102
00:10:28,690 --> 00:10:29,810
...هل هذا

103
00:10:37,890 --> 00:10:39,820
ماذا؟ ماذا يجري؟

104
00:10:40,040 --> 00:10:40,400
...ماذا

105
00:10:40,400 --> 00:10:41,800
.استسلمي

106
00:10:41,800 --> 00:10:44,080
.لا تستطيعين الهرب من هذا الظلام

107
00:10:44,080 --> 00:10:45,040
.انتهى الوقت

108
00:10:45,040 --> 00:10:47,500
!مستحيل! مستحيل، مستحيل، مستحيل

109
00:10:56,250 --> 00:10:57,340
حلم؟

110
00:11:00,720 --> 00:11:01,800
—شينغيتسو-تشا

111
00:11:01,800 --> 00:11:03,010
...آنّا

112
00:11:04,550 --> 00:11:05,600
آنّا؟

113
00:11:07,060 --> 00:11:08,520
...سامحيني

114
00:11:22,050 --> 00:11:23,310
...مانغيتسو

115
00:11:25,170 --> 00:11:28,480
.أنا مسرورة لمشاركتي في غرانبيلم

116
00:11:28,480 --> 00:11:29,330
ماذا؟

117
00:11:29,780 --> 00:11:32,540
أريد الفوز بها الآن

118
00:11:32,540 --> 00:11:35,490
.لأتمكن من تحقيق أمنيتك

119
00:11:37,620 --> 00:11:41,710
وبعد ذلك وجدنا أختي نائمة
.في الحمام لسبب ما

120
00:11:41,710 --> 00:11:44,540
—يا لها من أخت مرتاحة البـ

121
00:11:44,540 --> 00:11:45,390
!مؤلم

122
00:11:46,070 --> 00:11:49,220
.هل أنت بخير؟ عليك الانتباه أثناء مشيك

123
00:11:49,220 --> 00:11:50,990
!أعلم

124
00:11:57,000 --> 00:11:58,280
ماذا؟

125
00:12:00,630 --> 00:12:03,280
لديك أخت كبيرة؟

126
00:12:03,280 --> 00:12:04,200
...نعم

127
00:12:05,320 --> 00:12:07,660
!لا تهمني ظروفك

128
00:12:07,920 --> 00:12:10,500
!عليك أن تأتي حالًا حين أناديك أثناء القتال

129
00:12:10,710 --> 00:12:12,000
!حسنًا

130
00:12:12,000 --> 00:12:14,250
—ولكن بفضل دروسيلا تمكنتِ

131
00:12:14,250 --> 00:12:17,620
كيف لحفيدة عائلة سحرة من مرتبة
!منخفضة أن ترد عليّ؟

132
00:12:17,620 --> 00:12:18,890
!ابتسامة

133
00:12:25,460 --> 00:12:29,960
جهزي لي تقريرًا حول معركة أمس
!وكل المعلومات المتعلقة بآرمنوكس حالًا

134
00:12:29,960 --> 00:12:31,690
!مفهوم

135
00:12:39,000 --> 00:12:42,010
...مرت أكثر من سنة منذ بدء غرانبيلم

136
00:12:42,770 --> 00:12:45,400
.يفترض أن يكون عدد المقاتلين قد انخفض

137
00:12:47,740 --> 00:12:48,950
ماذا؟

138
00:12:49,450 --> 00:12:50,580
!أوني-ساما

139
00:12:50,820 --> 00:12:51,970
كلير؟

140
00:12:51,970 --> 00:12:55,120
!لديّ أخبار يا أوني-ساما! أخبار مذهلة

141
00:12:55,120 --> 00:12:56,040
ماذا؟

142
00:12:56,260 --> 00:12:57,900
!عرفت مدرستها

143
00:12:58,440 --> 00:13:00,940
!المدرسة التي ترتادها شينغيتسو

144
00:13:15,280 --> 00:13:16,980
...سيتغيتس بايكا

145
00:13:19,340 --> 00:13:21,510
.كانت رائحته كرائحتك يا أوني-تشان

146
00:13:28,680 --> 00:13:29,910
...أوني-تشان

147
00:13:32,600 --> 00:13:33,840
.انتظريني

148
00:13:41,350 --> 00:13:42,440
حسنًا؟

149
00:13:43,890 --> 00:13:45,400
.إنّها تستجيب

150
00:13:45,400 --> 00:13:48,430
.توجد حفيدة سحرة بالقرب من هنا فعلًا إذًا

151
00:13:48,640 --> 00:13:50,940
.يستحسن أن تتقصي أمرها

152
00:13:50,940 --> 00:13:54,840
لا بدّ وأنّها اقتربت منك
.لأنّها أحست بشيء

153
00:13:54,840 --> 00:13:56,890
!يستحيل أن تعرف

154
00:13:56,890 --> 00:13:59,310
أتعتقدان أنّي سأخفق وأفضح أمري؟

155
00:13:59,310 --> 00:14:00,350
!بشكل كبير

156
00:14:00,350 --> 00:14:01,500
!اصمتي

157
00:14:01,500 --> 00:14:02,770
نيني-تشان؟

158
00:14:05,460 --> 00:14:06,730
ما الخطب؟

159
00:14:13,270 --> 00:14:15,010
.سأذهب لإعداد الشاي

160
00:14:15,010 --> 00:14:16,710
...إن كان ذلك لا يزعجك

161
00:14:30,360 --> 00:14:31,430
...إلى اليسار

162
00:14:42,770 --> 00:14:45,440
هل تظنينني سأصدق ذلك؟

163
00:14:48,600 --> 00:14:51,410
.هذه هي الآلة التي رأيتها

164
00:14:51,650 --> 00:14:53,010
...مذهل

165
00:14:53,010 --> 00:14:54,410
.إنّها تقنية بسيطة

166
00:14:54,800 --> 00:14:58,000
.تحاول اقتناص هدفها من مسافة بعيدة

167
00:14:58,200 --> 00:15:01,460
.هذا ليس سببًا كافيًا لنا للتعاون معك

168
00:15:02,270 --> 00:15:03,420
التعاون؟

169
00:15:03,970 --> 00:15:07,070
.أستطيع استشعار مكان مصدر الهجمة

170
00:15:07,070 --> 00:15:10,380
ولكنّي أحتاج الدعم للحرص
.على عدم هروبها

171
00:15:10,830 --> 00:15:12,660
أهذا سبب ضعيف؟

172
00:15:13,430 --> 00:15:18,390
لا يزال ممكنًا أنّك تتعاونين
.سرًا مع هذه الآرمنوكس

173
00:15:18,700 --> 00:15:24,080
أنّك من عائلة كانت معروفة في كلّ
...أرجاء شرق أوروبا قبل قرن

174
00:15:24,080 --> 00:15:26,710
.العائلة التي كانت تدعى سحرة التنقية

175
00:15:27,170 --> 00:15:31,370
أنا متأكدو أنّ كان لديهم
.علاقة بعائلتي، عائلة تسوتشيميكادو

176
00:15:31,860 --> 00:15:34,450
.كان ذلك قبل أكثر من قرن

177
00:15:34,620 --> 00:15:36,160
،سأسألك إذًا

178
00:15:36,160 --> 00:15:39,880
لماذا تعاونتِ مع هذه الفتاة؟

179
00:15:39,880 --> 00:15:43,900
لماذا تثقين بها بينما لا تعرفين سليلة
أيّ ساحرة تكون؟

180
00:15:44,460 --> 00:15:45,540
...لأنّ

181
00:15:47,210 --> 00:15:50,420
.لا أمانع التعاون معها

182
00:15:50,420 --> 00:15:51,760
...مانغيتسو

183
00:15:51,760 --> 00:15:53,180
...لأنّها

184
00:15:53,180 --> 00:15:54,760
.تسوتشيميكادو كوون

185
00:15:54,970 --> 00:15:57,530
،صحيح، كما تقول كوون-تشان

186
00:15:57,530 --> 00:16:01,220
قد تصبح النتيجة تعادلًا كالمرة السابقة
.ما لم يتغير شيء

187
00:16:02,530 --> 00:16:03,620
...ولكن

188
00:16:13,240 --> 00:16:15,490
مـ-ما كان ذلك؟

189
00:16:15,990 --> 00:16:17,140
من أنتِ؟

190
00:16:17,560 --> 00:16:20,250
ا-المعذرة... أين الحمام؟

191
00:16:20,250 --> 00:16:22,800
.إنّه في آخر الردهة

192
00:16:22,800 --> 00:16:23,980
من هذه؟

193
00:16:24,450 --> 00:16:26,330
.نيني-تشان صديقة كيبو

194
00:16:26,630 --> 00:16:28,260
.آسفة على الإزعاج

195
00:16:34,410 --> 00:16:35,220
حسنًا؟

196
00:16:35,710 --> 00:16:37,960
.لا استجابة لاستخدام تقنية

197
00:16:37,960 --> 00:16:42,680
يفترض أن تكون هناك آثار لسحرها
.إن كانت حفيدة سحرة

198
00:16:43,960 --> 00:16:44,810
...بريئة

199
00:16:44,810 --> 00:16:46,870
ماذا؟ تشكان بها؟

200
00:16:46,870 --> 00:16:48,750
!ولكنها في المرحلة الإعدادية

201
00:16:48,750 --> 00:16:50,610
.لا علاقة للعمر

202
00:16:50,890 --> 00:16:53,820
.حفدة السحرة يحملون نفس العبء

203
00:16:54,470 --> 00:16:57,710
.ألا وهو سعيهم ليصبحوا برينسيبس

204
00:16:59,140 --> 00:17:00,270
!إلى اللقاء

205
00:17:00,270 --> 00:17:02,650
.نعم... أراك غدًا

206
00:17:13,190 --> 00:17:15,880
.لم يعرفوا هويتي

207
00:17:15,880 --> 00:17:18,760
.هذا بفضل تميمة إلغاء السحر خاصتك

208
00:17:18,760 --> 00:17:19,760
حسنًا؟

209
00:17:19,980 --> 00:17:23,140
.كانوا ثلاثة يناقشن كيفية هزيمتي

210
00:17:23,350 --> 00:17:24,420
حقًا؟

211
00:17:25,360 --> 00:17:26,520
.فزنا بهذا

212
00:17:27,110 --> 00:17:29,360
ما هي خطتهن إذًا؟

213
00:17:31,330 --> 00:17:32,120
ماذا؟

214
00:17:39,580 --> 00:17:42,670
ولكنّي متفاجئة لاستنتاجك أنّ مانغيتسو

215
00:17:42,670 --> 00:17:46,160
مشاركة في غرانبيلم بواسطة
.أثر السحر الضعيف هذا

216
00:17:46,160 --> 00:17:49,250
.لم أستنتج شيئًا، بل بحثت في ما هو غريب

217
00:17:49,680 --> 00:17:50,950
.هذا كلّ ما بالأمر

218
00:17:50,950 --> 00:17:52,210
غريب؟

219
00:17:52,550 --> 00:17:55,220
.تنقل أختي الصغيرة الشعور بوجود خلل

220
00:18:03,100 --> 00:18:04,940
!جميل للغاية

221
00:18:04,940 --> 00:18:07,480
.لم أعرف بوجود مكان كهذا

222
00:18:11,320 --> 00:18:13,430
لماذا تتعاونان؟

223
00:18:14,280 --> 00:18:16,790
.لسنا نتعاون تمامًا

224
00:18:16,790 --> 00:18:18,140
ماذا؟ لستما كذلك؟

225
00:18:18,140 --> 00:18:20,530
...لا، أعني

226
00:18:20,850 --> 00:18:25,410
طالما كنتما في غرانبيلم، فستضطران
.لقتال بعضكما في النهاية

227
00:18:25,410 --> 00:18:28,250
...أن تتعاونا رغم معرفة ذلك

228
00:18:28,520 --> 00:18:30,210
.يبدو غير عادي

229
00:18:32,700 --> 00:18:34,100
تعتقدين ذلك؟

230
00:18:35,030 --> 00:18:37,800
.لا أعتقده غريب

231
00:18:38,280 --> 00:18:39,260
لماذا؟

232
00:18:41,350 --> 00:18:43,450
.هذا ما أشعره

233
00:18:43,970 --> 00:18:45,220
أليس ذلك كافيًا؟

234
00:18:46,930 --> 00:18:50,220
من أيّ سلالة سحرة تكونين؟

235
00:18:50,220 --> 00:18:51,880
...هذا

236
00:18:51,880 --> 00:18:53,700
.ما زلنا لا نعرف

237
00:18:57,030 --> 00:19:01,280
.شعرت بشيء غريب جدًا لحظة لمسي لك

238
00:19:02,200 --> 00:19:04,890
.قد تكونين ساحرة جديدة

239
00:19:05,610 --> 00:19:07,250
...جديدة

240
00:19:10,080 --> 00:19:11,710
.يكفي إلى هنا

241
00:19:12,080 --> 00:19:16,400
سأتواصل معكما حين أكتب
.تفاصيل خطتنا

242
00:19:18,450 --> 00:19:21,720
هل تعتقدين أنّ علينا التعاون معها حقًا؟

243
00:19:22,380 --> 00:19:26,960
.لا أدري، ولكنّي أعتقد أنّ بإمكانها مساعدتك

244
00:19:26,960 --> 00:19:28,070
مساعدتي؟

245
00:19:28,070 --> 00:19:30,270
.نعم. هذا ما أشعره

246
00:19:32,610 --> 00:19:33,650
...مانغيتسو

247
00:19:35,570 --> 00:19:38,120
إن استمر غرانبيلم

248
00:19:38,680 --> 00:19:41,700
،واضطررتِ لقتالي يومًا ما

249
00:19:42,180 --> 00:19:44,100
فماذا ستفعلين؟

250
00:19:44,100 --> 00:19:45,280
ماذا تعنين؟

251
00:19:47,380 --> 00:19:48,950
هل ستقاتلينني؟

252
00:19:52,490 --> 00:19:53,850
.لا أدري

253
00:19:54,400 --> 00:19:55,540
لا تدرين؟

254
00:19:56,100 --> 00:19:58,550
.لن أدري إلى أن يأتي ذلك الوقت

255
00:19:59,170 --> 00:20:01,510
...ولكنّي أعتقد

256
00:20:02,040 --> 00:20:04,230
.أنّنا لن نضطر للقتال

257
00:20:05,010 --> 00:20:07,240
.أبدًا

258
00:20:29,090 --> 00:20:31,870
.إنّك فتاة جيدة. فتاة جيدة للغاية

259
00:20:32,580 --> 00:20:35,940
...ولكن... إن كنتِ ساحرة

260
00:20:36,630 --> 00:20:39,640
...وهذا سبب عدم نموي

261
00:20:53,600 --> 00:20:54,840
.لا بأس

262
00:20:55,990 --> 00:20:57,810
،أينما كنت

263
00:20:57,810 --> 00:21:00,980
.فلن تتغير حقيقة أنّي والدتك

264
00:21:02,000 --> 00:21:03,220
...أمي

265
00:21:06,570 --> 00:21:09,080
.عليك إخفاء حقيقة كونك ساحرة

266
00:21:09,540 --> 00:21:12,280
.هذا ضروري لنجاتك

267
00:21:13,220 --> 00:21:16,620
.ولكن ليس هناك داعٍ لتكرهي نفسك

268
00:21:29,020 --> 00:21:29,870
هذا؟

269
00:21:29,870 --> 00:21:32,720
.نعم. سيصعّب من كشفك

270
00:21:36,770 --> 00:21:37,650
!مرّ

271
00:21:37,890 --> 00:21:39,700
...مرّ للغاية

272
00:21:39,700 --> 00:21:41,460
.هذا دليل على فعاليته

273
00:21:43,480 --> 00:21:48,160
هل علينا إخفاء أمر كوننا حفدة سحرة؟

274
00:21:48,420 --> 00:21:51,620
لطالما كان السحرة يخدعون
.بعضهم البعض منذ قديم الزمان

275
00:21:52,240 --> 00:21:54,880
،ولكن كان من بينهم من لم يرد ذلك

276
00:21:54,880 --> 00:21:57,790
.ولم يخفوا هويتهم أبدًا

277
00:22:01,000 --> 00:22:03,630
.ليس هناك داعٍ لتكرهي نفسك

278
00:22:11,090 --> 00:22:12,330
نيني-تشان؟

279
00:22:13,840 --> 00:22:16,310
.أنا من سلالة سحرة أيضًا

280
00:22:17,380 --> 00:22:20,430
،أنا نيني، ابنة لين فين فين
...مُعلّمة فينغ شوي

281
00:22:22,350 --> 00:22:24,480
.وأشارك في غرانبيلم

282
00:22:24,480 --> 00:22:26,990
يتبع

283
00:23:56,990 --> 00:23:59,750
الحلقة القادمة

284
00:23:58,020 --> 00:24:02,370
تتعاون مانغيتسو وشينغيتسو
.وتسعيان للفوز معًا

285
00:24:02,610 --> 00:24:04,790
،عزيمة نيني قوية

286
00:24:04,790 --> 00:24:07,750
...وآنّا فوغو سيطر عليها الجنون

287
00:24:08,050 --> 00:24:10,740
.وتظهر واحدة أخرى

288
00:24:11,280 --> 00:24:16,310
،معركتهن عبارة عن موشور أرواح
.يلمع بألوان قوس القزح

289
00:24:17,220 --> 00:24:18,760
،الحلقة القادمة من غرانبيلم

290
00:24:19,030 --> 00:24:21,770
".الأمنية الصغيرة للفتاة الصغيرة"

291
00:24:22,310 --> 00:24:25,370
...هذا كل ما تمنته، ولكن

292
00:24:27,020 --> 00:24:30,030
!ترقبوا الحلقة القادمة