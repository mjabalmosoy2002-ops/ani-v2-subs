1
00:00:02,740 --> 00:00:05,730
!سينباي أفضل بكثير لتكون في هذه الجمعيّة

2
00:00:05,730 --> 00:00:06,860
سينباي؟

3
00:00:08,570 --> 00:00:09,480
!أجل

4
00:00:09,480 --> 00:00:13,240
لا أستطيع فهم حتّى لماذا انضمّت
!سينباي لجمعيّة كهذه

5
00:00:13,240 --> 00:00:14,570
أقلتِ سينباي؟

6
00:00:15,060 --> 00:00:17,530
...لكنّنا جميعًا تلميذات سنة أولى

7
00:00:17,530 --> 00:00:20,490
!أنا أتحدّث عن أريما هيزومي-سينباي

8
00:00:21,070 --> 00:00:22,520
تتحدّثين عن هيزومي؟

9
00:00:24,170 --> 00:00:25,960
.مهلاً، لكنّنا في نفس العمر

10
00:00:25,960 --> 00:00:27,360
ربّما رسبت في سنة ما؟

11
00:00:27,360 --> 00:00:28,560
...أو أنّها دخلت المدرسة متأخّرة بسنة

12
00:00:28,560 --> 00:00:31,010
!كفى من هذه الأفكار الفظّة عن سينباي

13
00:00:31,600 --> 00:00:34,880
.رأيت أداءكنّ في الحديقة
!اقترفتنّ الكثير من الأخطاء

14
00:00:35,930 --> 00:00:37,910
.كانت مع الجماهير إذًا

15
00:00:38,960 --> 00:00:42,680
وعندما غيّرتنّ تشكيلتكنّ لم تستطعن
.مواصلة الابتسام

16
00:00:42,680 --> 00:00:44,890
،كان ارتفاع ركلاتكنّ العالية متفاوتًا

17
00:00:44,890 --> 00:00:48,650
والتواء القدم أثناء الدّوران عند
!القيام بالرّكلة الجانبيّة غير مقبول

18
00:00:48,280 --> 00:00:49,690
...المعذرة

19
00:00:48,650 --> 00:00:50,020
—ناهيكنّ عن ذكر

20
00:00:50,400 --> 00:00:52,480
.شكرًا لك على مراقبتنا بشدّة هكذا

21
00:00:52,480 --> 00:00:54,900
!لماذا تشكرينني؟
!أنا أشير إلى أخطائكنّ

22
00:00:55,300 --> 00:01:00,390
على أيّ حال ولمعلوماتكنّ فحسب، فلن أقبل
!أبدًا تواجد جمعيّة تشجيع تفتقر للكفاءة

23
00:01:04,160 --> 00:01:05,210
...هذا مؤلم

24
00:01:05,210 --> 00:01:06,410
.أنا جدّ آسفة

25
00:01:08,050 --> 00:01:09,480
هل أنت بخير؟

26
00:01:09,480 --> 00:01:10,860
!هيزومي

27
00:01:09,480 --> 00:01:10,860
!هيزومي-تشان

28
00:01:11,340 --> 00:01:14,300
....سـ-سـ-سـ

29
00:02:47,110 --> 00:02:48,020
...المعذرة

30
00:02:48,350 --> 00:02:49,390
!أستأذن

31
00:02:51,560 --> 00:02:53,610
لماذا كانت هنا؟

32
00:02:54,070 --> 00:02:55,660
هل هي صديقة لك؟

33
00:02:55,660 --> 00:02:59,290
.نعم. كانت إحدى الفتيات في فرقتي السّابقة

34
00:02:59,290 --> 00:03:01,740
.لم أكن أعرف أنّنا نرتاد نفس الثّانويّة

35
00:03:02,150 --> 00:03:04,090
.لا فكرة لديّ على الإطلاق

36
00:03:04,090 --> 00:03:07,150
هـ-هل يمكنك وصفها
بصديقتك في هذه الحالة؟

37
00:03:07,150 --> 00:03:08,910
.أشعر بالأسف حيالها نوعًا ما

38
00:03:08,910 --> 00:03:10,500
هل أنت سينباي لها؟

39
00:03:10,930 --> 00:03:16,250
إنّها... انضّمت أوشيكو-سان للفرقة
.بعدي، لذلك هي تناديني هكذا

40
00:03:16,250 --> 00:03:18,380
.اسمها أوشيكو-سان إذًا

41
00:03:18,810 --> 00:03:22,990
.في تلك الحالة، جميعكنّ سينباي لي

42
00:03:22,990 --> 00:03:24,140
!زقزقة

43
00:03:24,140 --> 00:03:26,940
!أنا سينباي تشجيع أخيرًا

44
00:03:26,940 --> 00:03:31,140
...سينباي تشجيع... سينباي تشجيع
...سينباي تشجيع

45
00:03:27,320 --> 00:03:31,140
،فقط لأنّ عضوة ما بدأت قبل الأخرى
.فذلك لا يجعلها سينباي للبقيّة

46
00:03:31,480 --> 00:03:32,980
.جميعنا زميلات في الفريق

47
00:03:32,980 --> 00:03:36,220
!أ-أجل! زميلات فريق

48
00:03:36,220 --> 00:03:37,980
.يبدو أنّ أملك قد خاب قليلاً

49
00:03:39,520 --> 00:03:42,990
.لكنّني أتساءل عمّ أرادته أوشيكو-سان

50
00:03:43,400 --> 00:03:46,370
.يبدو أنّها قلقة بشأنك يا هيزومي-تشان

51
00:03:46,720 --> 00:03:49,840
ربّما أتت لتحيّيني عندما عرفت

52
00:03:49,840 --> 00:03:52,440
بوجود زميلة فريق سابقة لها
.ترتاد نفس مدرستها

53
00:03:52,440 --> 00:03:54,400
!ربّما أرادت أن تنضمّ لنا

54
00:03:54,400 --> 00:03:57,850
.كلاّ... لم يبدُ الأمر كذلك في نظري

55
00:03:57,850 --> 00:03:59,300
...المعذرة

56
00:03:59,960 --> 00:04:00,970
ألديكنّ بعض الوقت؟

57
00:04:00,970 --> 00:04:03,130
!انظرن، سينباي حقيقيّة

58
00:04:04,230 --> 00:04:05,760
حقيقيّة؟

59
00:04:06,980 --> 00:04:08,860
تأهّلتنّ لبطولة المقاطعة؟

60
00:04:08,860 --> 00:04:10,240
!هذا رائع

61
00:04:10,240 --> 00:04:12,480
لا بدّ أنّ ذلك يعني أنّكنّ فزتنّ
.بالبطولة الإقليميّة

62
00:04:12,480 --> 00:04:14,030
!تهانينا لكنّ

63
00:04:14,030 --> 00:04:18,070
شكرًا. لذلك أردت أن أطلب منكنّ
.أن تشجّعننا ثانية

64
00:04:18,720 --> 00:04:20,420
...في الحقيقة

65
00:04:20,420 --> 00:04:22,960
!أيّتها القائدة! لنطلب منهنّ أن يشجّعننا ثانية

66
00:04:22,960 --> 00:04:24,330
!نحتاج مشجّعات

67
00:04:24,330 --> 00:04:25,720
!نحتاج لتشجيع

68
00:04:25,720 --> 00:04:27,690
.كانت بقيّة الفريق توّاقة للتّشجيع

69
00:04:27,690 --> 00:04:29,700
.يبدو أنّهنّ مدمنات عليه

70
00:04:30,200 --> 00:04:32,510
هذه المرّة، لن نطلب منكنّ
.التّشجيع من أجلنا فقط

71
00:04:32,510 --> 00:04:36,120
نودّ منكنّ أن تقدّمن أداءً قبل
،المباراة وبين الشّوطين

72
00:04:36,120 --> 00:04:39,080
لذلك سيكون الأمر أشبه بتشجيع
.لكلّ المدارس المشاركة

73
00:04:39,670 --> 00:04:43,590
،لنقم بذلك! كلّما زاد من نشجّعهم
!سيكون ذلك يستحقّ العناء أكثر

74
00:04:45,430 --> 00:04:48,150
.نعم، توقّعت أن يكون ذلك شعورك

75
00:04:50,120 --> 00:04:51,180
.إليكنّ فكرة

76
00:04:51,660 --> 00:04:55,590
لماذا لا نجرّب تصميم الرّقصة معًا؟

77
00:04:56,190 --> 00:04:58,700
!لا-لا-لا أستطيع

78
00:04:58,700 --> 00:04:59,900
!تصميم رقصة

79
00:04:59,900 --> 00:05:01,200
...مستحيل

80
00:05:01,200 --> 00:05:02,110
.سنكون بخير

81
00:05:02,980 --> 00:05:07,130
،لا يهمّ ما ستكون الرّقصة
!فلن تكون مخيفة إن أدّيناها جميعًا

82
00:05:07,890 --> 00:05:10,200
!هيزومي، هذا ليس مطمئنًا أبدًا

83
00:05:10,200 --> 00:05:13,690
كنت أمزح. إن استطعتنّ التّفكير
،في بعض الحركات

84
00:05:13,690 --> 00:05:17,330
،فسنجمع الأجزاء الأفضل منها
.ونشكّل الرّقصة النّهائيّة

85
00:05:17,670 --> 00:05:19,920
.بدت جادّة للغاية بشأن ذلك

86
00:05:19,920 --> 00:05:21,340
!لديّ سؤال

87
00:05:21,630 --> 00:05:24,600
هل هنالك خدع ما للتّفكير في حركات؟

88
00:05:24,600 --> 00:05:26,030
...خدع

89
00:05:26,030 --> 00:05:30,720
في حالتي، أستمع لأغنية وأترك
.زمام الأمور لمخيّلتي

90
00:05:31,350 --> 00:05:34,380
هل لديكنّ أيّة أغانٍ ترغبن بالرّقص عليها؟

91
00:05:35,060 --> 00:05:36,910
.لا شيء يخطر ببالي الآن

92
00:05:36,910 --> 00:05:38,510
.لم أفكّر في ذلك

93
00:05:38,510 --> 00:05:40,230
...لحظة! في تلك الحالة

94
00:05:41,190 --> 00:05:42,570
ما رأيكنّ بهذه؟

95
00:05:42,570 --> 00:05:45,070
!لقد سمعتها من قبل

96
00:05:45,070 --> 00:05:46,880
.أظنّ أنّها ستكون مناسبة

97
00:05:46,880 --> 00:05:49,260
.تبدو أغنية يسهل تصميم رقصة لها

98
00:05:49,260 --> 00:05:50,320
.لا اعتراضات إذًا

99
00:05:50,320 --> 00:05:53,160
!أجل! شكرًا يا فتيات

100
00:05:54,400 --> 00:05:59,720
هذا رأيي فقط، لكنّني أتخيّل
شخصًا يرقص في بالي

101
00:05:59,720 --> 00:06:02,180
وأحاول التّفكير في حركات
.رقص بدون أيّ تحيّز

102
00:06:03,640 --> 00:06:09,550
...تخيّل شخص يرقص في بالي

103
00:06:10,720 --> 00:06:11,690
!فهمت

104
00:06:11,690 --> 00:06:13,180
!ماذا؟ هذا سريع

105
00:06:13,630 --> 00:06:17,880
حسنًا، حسنًا... تخيّل شخص
...يرقص في بالي

106
00:06:21,960 --> 00:06:24,810
!لا يمكنني ذلك! هذا صعب للغاية

107
00:06:24,810 --> 00:06:26,570
!إنّها تتخيّل نفسها وهي تفشل

108
00:06:31,780 --> 00:06:34,080
لماذا لا نفكّر في هذا الأمر في المنزل؟

109
00:06:34,410 --> 00:06:36,500
.حاولن التّفكير به هذه اللّيلة

110
00:06:38,390 --> 00:06:42,280
،سيقوم الجميع بالرّقص عليها
!لذلك عليّ أن أحرص أنّها محترمة

111
00:06:46,210 --> 00:06:48,920
بما أنّني أستعمل رأسي، فسأحتاج لتناول
!بعض الحلويّات للتّزوّد بالطّاقة

112
00:07:01,240 --> 00:07:04,470
.ما زال الطّعم الحلو في فمي
.سأذهب لأعدّ بعض الشّاي الأسود

113
00:07:08,940 --> 00:07:11,370
...سأجمع بعض الأساليب

114
00:07:11,370 --> 00:07:13,240
ماذا عليّ أن أفعل أكثر؟

115
00:07:13,240 --> 00:07:18,340
رحّبوا معنا بضيوف اليوم، مجموعة
!النّجوم الّتي ينتج لها يوتا-سان، ستار

116
00:07:22,050 --> 00:07:24,920
.أجل... الأمر ليس هكذا

117
00:07:25,350 --> 00:07:28,280
لا بدّ من وجود حركات تجعل
!كوهاني تلمع أكثر

118
00:07:29,400 --> 00:07:32,090
!أظرف! وأكثر نشاطًا

119
00:07:35,100 --> 00:07:36,880
تصميم رقصة؟

120
00:07:36,880 --> 00:07:39,180
أتساءل أيّ نوع من التّشجيع
.عليّ أن أفكّر فيه

121
00:07:39,620 --> 00:07:42,940
.سأعتمد هذا وهذا... وأريد القيام بهذا أيضًا

122
00:07:42,940 --> 00:07:46,120
!وأرغب القيام بهذا بكلّ تأكيد

123
00:07:48,820 --> 00:07:51,640
!حسنًا! انتهيت

124
00:07:54,750 --> 00:07:57,290
.قالت هيزومي إنّها ستحلّ الأمر

125
00:08:04,560 --> 00:08:09,710
ربّما ستمنحني هذه الصّور والأقراص
.عن فرقتي السّابقة بعض الأفكار

126
00:08:11,140 --> 00:08:13,720
.لا أرى أوشيكو-سان في أيٍّ من هذه الصّور

127
00:08:13,720 --> 00:08:15,720
...لكنّني واثقة أنّها كانت في الفرقة

128
00:08:18,450 --> 00:08:19,850
كيف سار الأمر يا فتيات؟

129
00:08:20,270 --> 00:08:21,400
!انتهيت

130
00:08:21,400 --> 00:08:23,160
...أعتقد أنّ هذا سينفع

131
00:08:23,160 --> 00:08:24,350
.وأنا أيضًا

132
00:08:24,700 --> 00:08:27,860
،حسنًا، سأقوم بمراجعة أفكاركنّ

133
00:08:28,250 --> 00:08:30,340
.لذلك تدرّبن وحدكنّ اليوم

134
00:08:32,530 --> 00:08:34,620
هل لاحظت الأمر يا كوتيتسو؟

135
00:08:34,620 --> 00:08:35,460
.نعم

136
00:08:36,300 --> 00:08:37,910
.إنّها هنا ثانية

137
00:08:38,990 --> 00:08:42,540
،المعذرة... إن كان الفضول يعتريك
فلماذا لا تدخلين فحسب؟

138
00:08:43,520 --> 00:08:46,080
أوكي، مع من تتحدّثين؟

139
00:08:46,080 --> 00:08:47,040
...أتحدّث مع

140
00:08:47,310 --> 00:08:50,670
!أهو الشّبح؟ هل الشّبح موجود فعلاً؟

141
00:08:50,670 --> 00:08:53,300
!إنّها لم تكتشف تواجدها على الإطلاق

142
00:08:58,850 --> 00:09:01,680
.حسنًا، ستكون تلك رقصتنا

143
00:09:02,000 --> 00:09:04,310
.كلّ ما بقي هو أن نتدرّب عليها

144
00:09:04,760 --> 00:09:07,310
!علينا بذل جهدنا من أجل فريق كرة السّلّة أيضًا

145
00:09:07,310 --> 00:09:09,570
...صـ-صحيح

146
00:09:09,920 --> 00:09:12,570
كوهاني-سان، حافظي على استقامة
.معصميك بشكل أفقيّ

147
00:09:12,800 --> 00:09:14,570
هـ-هكذا؟

148
00:09:14,890 --> 00:09:20,040
،مرّة أخرى! واحد، اثنان، ثلاثة
!أربعة، خمسة، ستّة، سبعة، ثمانية

149
00:09:15,250 --> 00:09:18,060
أتساءل إن كانت لأوشيكو-سان
...أشياء أفضل لتقوم بها

150
00:09:19,450 --> 00:09:21,950
...صحيح، لا يمكنني مجادلتك في ذلك

151
00:09:20,040 --> 00:09:21,950
...اثنان، اثنان، ثلاثة، أربعة

152
00:09:23,240 --> 00:09:24,710
.غدًا هو اليوم المنتظر

153
00:09:25,150 --> 00:09:27,460
.لنبذل جهدنا لكي لا نتأذّى

154
00:09:28,150 --> 00:09:29,720
...أنا متوتّرة جدًّا

155
00:09:29,720 --> 00:09:32,210
!سنكون بخير! لقد تدرّبنا كثيرًا

156
00:09:32,880 --> 00:09:34,460
...مـ-معك حقّ

157
00:09:34,460 --> 00:09:36,180
.سنكون بخير

158
00:09:37,460 --> 00:09:39,530
.إنّها تلك الكتابة المخيفة ثانية

159
00:09:43,460 --> 00:09:44,850
.أتيت إذًا

160
00:09:45,960 --> 00:09:47,190
أوشيكو-سان؟

161
00:09:48,730 --> 00:09:50,670
.هنالك أمر أريد أن أطلبه منك

162
00:09:50,670 --> 00:09:54,280
لماذا تشجّع سينباي معكنّ؟

163
00:09:54,280 --> 00:09:56,640
.لا يمكنكنّ حتّى القيام بالتّقنيات البسيطة

164
00:09:56,640 --> 00:10:00,080
.كانت فرقتها السّابقة أفضل بكثير

165
00:10:00,080 --> 00:10:04,120
لحظة... ربّما عليك أن تسألي
.هيزومي بنفسك

166
00:10:04,120 --> 00:10:05,900
لماذا تسألينني أنا؟

167
00:10:07,720 --> 00:10:11,040
!أعني... كيف لي أن أكلّمها مباشرة؟

168
00:10:11,040 --> 00:10:12,250
!لستُ جديرة بذلك

169
00:10:13,780 --> 00:10:17,760
أعتقد أنّ السّبب هو عدم اكتراثها لمستوى
.مهارتنا وهي تستمتع بوقتها فحسب

170
00:10:18,160 --> 00:10:21,480
.لقد أصبحت أكثر لينًا

171
00:10:21,480 --> 00:10:24,770
...هذا

172
00:10:29,990 --> 00:10:33,160
،لا أعرف الكثير عن فرقتها السّابقة

173
00:10:33,160 --> 00:10:34,010
—ولكنّنا

174
00:10:34,010 --> 00:10:34,520
!يكفي

175
00:10:35,520 --> 00:10:37,240
!توقّفي عن التّصرّف وكأنّك تعرفينها

176
00:10:37,860 --> 00:10:39,720
!لا تعرفين أيّ شيء

177
00:10:49,790 --> 00:10:51,050
...هذا مؤلم

178
00:10:53,680 --> 00:10:56,300
هل أنت بخير؟

179
00:10:57,010 --> 00:11:00,140
...نـ-نعم، أظنّ ذلك

180
00:11:00,140 --> 00:11:02,280
.أنا معتادة على هذه الأشياء بسبب كوهاني

181
00:11:02,280 --> 00:11:03,640
!تزحلق

182
00:11:03,640 --> 00:11:04,550
معتادة؟

183
00:11:04,880 --> 00:11:08,970
الأهمّ من ذلك، لماذا لا تحاولين
الحديث مع هيزومي وجهًا لوجه؟

184
00:11:09,640 --> 00:11:13,560
،إن كنت قلقة جدًّا عليها
.فعليك أن تسأليها عن حالها

185
00:11:14,020 --> 00:11:18,120
.كلّ ما قلته مبنيّ على افتراضات

186
00:11:18,520 --> 00:11:19,900
...معك حقّ

187
00:11:21,720 --> 00:11:24,730
.أعتقد أنّنا نتخيّل الأمور بشكل مختلف

188
00:11:24,730 --> 00:11:29,500
أنا واثقة أنّ طريقة تخيّلنا
.لهيزومي مختلفة تمامًا

189
00:11:29,850 --> 00:11:33,070
بما أنّنا حللنا تلك المشكلة، لنسرع
.قبل أن تغيّري رأيك

190
00:11:35,140 --> 00:11:36,280
...هذا مؤلم

191
00:11:38,390 --> 00:11:39,920
.يبدو أنّه التواء طفيف

192
00:11:39,920 --> 00:11:41,050
!أوكي-تشان؟

193
00:11:41,050 --> 00:11:43,310
هل أنت بخير يا أوكي؟

194
00:11:43,310 --> 00:11:46,340
—أنا بخير. إن لففت كاحلي

195
00:11:48,780 --> 00:11:51,630
،أخبرتها أن تتحدّث معها وجهًا لوجه

196
00:11:51,630 --> 00:11:53,310
.لكنّها لم تستطع ذلك

197
00:11:53,680 --> 00:11:55,150
!أ-أنا جدّ آسفة

198
00:11:55,470 --> 00:11:57,400
—إنّها غلطتي! أنا

199
00:11:57,400 --> 00:11:58,900
.أوشيكو-سان

200
00:11:59,400 --> 00:12:00,470
...لا يعقل

201
00:12:05,280 --> 00:12:06,750
!خذي هذا

202
00:12:06,750 --> 00:12:09,530
هل استعملت أوشيكو-سان حركة ما
على ساق أوكي-سان؟

203
00:12:09,530 --> 00:12:11,290
!أيّ نوع من الأوضاع المخيفة سيكون ذلك؟

204
00:12:11,630 --> 00:12:14,170
.كلاّ، لقد سقطتُ فحسب

205
00:12:14,170 --> 00:12:15,630
.لقد انزلقت على السّطح

206
00:12:15,630 --> 00:12:19,170
كلاّ! لقد حمتني عندما كنت
.أوشك على السّقوط

207
00:12:19,580 --> 00:12:22,470
.إنّه لا يؤلمني كثيرًا. أنا بخير

208
00:12:23,360 --> 00:12:25,680
،أعتقد أنّني أدرك ما يحدث

209
00:12:25,680 --> 00:12:29,430
،لكن حتّى إن كان مجرّد التواء طفيف
.فلا يمكننا الاستخفاف به

210
00:12:29,880 --> 00:12:32,120
.سنؤدّي رقصتنا نحن الثّلاثة فقط غدًا

211
00:12:33,970 --> 00:12:37,310
...ربّما يمكننا تعديل التّوقيت بين أربعتنا

212
00:12:37,740 --> 00:12:41,200
.هنالك جزء نقوم فيه بدوران تبادليّ أيضًا

213
00:12:41,200 --> 00:12:44,490
...لكن... سيكون ذلك أصعب بدون أوكي

214
00:12:45,810 --> 00:12:46,940
...المعذرة

215
00:12:56,340 --> 00:12:58,040
!يا سينباي كرة السّلّة

216
00:12:59,280 --> 00:12:59,960
.مرحبًا

217
00:13:00,500 --> 00:13:02,590
!شكرًا على استضافتنا اليوم

218
00:13:02,590 --> 00:13:04,580
!أكيد، على الرّحب

219
00:13:04,580 --> 00:13:06,020
...مهلاً

220
00:13:06,830 --> 00:13:09,230
هل غيّرتِ مظهرك يا ساواتاري-سان؟

221
00:13:09,230 --> 00:13:12,220
!سيكون ذلك تغيير يستدعي عمليّة تجميل

222
00:13:14,600 --> 00:13:17,830
.من الجيّد أنّ زيّ أوكي يناسبك تمامًا

223
00:13:18,370 --> 00:13:21,860
.ما كنت لأقول أنّه يناسبني تمامًا
...المنطقة المحيطة بالصّدر

224
00:13:22,540 --> 00:13:25,230
!إذًا علينا أن نعدّ زيًّا لك أيضًا

225
00:13:25,230 --> 00:13:26,280
لماذا؟

226
00:13:27,160 --> 00:13:29,920
.أقوم بهذا فقط لأنّني مسؤولة عمّا حدث

227
00:13:29,920 --> 00:13:32,290
.يمكنني أن أتعامل مع كونه مرتخيًا قليلاً

228
00:13:32,290 --> 00:13:34,880
!تمهّلي يا أوشيكو-سان

229
00:13:34,880 --> 00:13:36,490
.كوهاني، اذهبي للاستعداد

230
00:13:36,490 --> 00:13:37,500
!حـ-حسنًا

231
00:13:38,680 --> 00:13:41,500
.كوهاني، أنت تشربين الكثير من الماء

232
00:13:42,790 --> 00:13:44,590
.سأضع المناشف هنا

233
00:13:44,930 --> 00:13:47,220
.سأقوم بكلّ ما باستطاعتي لأدعمكنّ اليوم

234
00:13:49,160 --> 00:13:51,310
...أوكي، أنت نوعًا ما

235
00:13:52,370 --> 00:13:54,100
.كنت أفكّر في نفس الشّيء

236
00:13:54,950 --> 00:13:56,360
...أشعر أنّني

237
00:13:56,360 --> 00:13:58,070
.أشبه زوجة

238
00:13:56,850 --> 00:13:58,680
!كمديرة

239
00:14:01,240 --> 00:14:03,340
!أجل! مديرة! بالضّبط

240
00:14:03,340 --> 00:14:04,570
—هل قلتِ للتّوّ

241
00:14:04,570 --> 00:14:06,240
!مديرة

242
00:14:06,570 --> 00:14:08,920
.مهلاً، قلتِ شيئًا مختلفًا تمامًا

243
00:14:08,920 --> 00:14:10,780
!"قلت "مديرة

244
00:14:10,780 --> 00:14:11,640
!أنت تكذبين

245
00:14:11,640 --> 00:14:12,590
.أوشيكو-سان

246
00:14:12,590 --> 00:14:13,990
نـ-نعم؟

247
00:14:13,990 --> 00:14:18,300
.تمكّنّا من التّدرّب معًا البارحة فقط
هل ستكونين بخير؟

248
00:14:18,300 --> 00:14:19,500
!سـ-سأكون بخير

249
00:14:20,050 --> 00:14:24,250
،مرّ وقت طويل مذ مارست التّشجيع
.لكنّ الرّقصة كانت سهلة

250
00:14:24,250 --> 00:14:28,570
وقت طويل؟ هل تركت الفرقة يا أوشيكو-سان؟

251
00:14:28,570 --> 00:14:30,360
...نـ-نعم

252
00:14:30,360 --> 00:14:34,040
،واصلت التّدرّب بمفردي
...لكنّ... الفرقة

253
00:14:34,680 --> 00:14:37,030
.انشغلت بالثّانويّة فحسب

254
00:14:37,760 --> 00:14:40,570
لا فائدة من البقاء في الفرقة
...من دون تواجدك فيها

255
00:14:40,570 --> 00:14:43,270
...أشعر بحضور متعجرف

256
00:15:00,120 --> 00:15:01,790
!هنالك الكثير من النّاس

257
00:15:02,300 --> 00:15:04,880
.لنبذل جهدنا اليوم

258
00:15:04,880 --> 00:15:06,440
!أ-أجل

259
00:15:06,440 --> 00:15:08,860
!لنشكّل جميعنا دائرة

260
00:15:08,860 --> 00:15:09,910
!لنجتمع

261
00:15:11,010 --> 00:15:13,050
...لديّ طلب

262
00:15:14,660 --> 00:15:16,960
...إ-إذًا فهكذا تبدو صورة إنستغرام

263
00:15:16,960 --> 00:15:18,430
أهذا من أفعال أخيها الكبير ثانية؟

264
00:15:20,120 --> 00:15:22,040
،قبل أن نبدأ المباراة

265
00:15:22,040 --> 00:15:26,150
.ستقدّم جمعيّة التّشجيع لثانويّة كامينوكي أداءً لنا

266
00:15:26,630 --> 00:15:29,540
.رحّبوا بهنّ بتصفيقاتكم رجاءً

267
00:16:34,640 --> 00:16:36,180
!إنّها رائعة

268
00:16:37,350 --> 00:16:41,800
،حركات أوشيكو-سان كبيرة ومتقنة جدًّا

269
00:16:41,800 --> 00:16:43,180
!وهي متميّزة بالفعل

270
00:16:43,530 --> 00:16:44,780
...وأيضًا

271
00:16:47,080 --> 00:16:48,820
!أداؤها مفعم بالحيويّة

272
00:17:08,690 --> 00:17:32,470
!هيّا بنا يا كامينوكي! نحو الفوز هيّا

273
00:17:26,790 --> 00:17:29,600
!لا، لا... أنا آخذ مكان ساواتاري-سان فقط

274
00:17:29,600 --> 00:17:31,820
!عليّ التّركيز والقيام بهذا بشكل جيّد

275
00:17:35,750 --> 00:17:37,570
!لقد دخلت السّلّة

276
00:17:37,960 --> 00:17:39,930
!قومي بالأمر كما يجب

277
00:17:42,200 --> 00:17:43,200
!استراحة ما بين الشّوطين

278
00:17:43,780 --> 00:17:45,340
.احرصن جميعًا على شرب الماء

279
00:17:45,340 --> 00:17:47,380
.ستعدن للتّشجيع بعد استراحة سريعة

280
00:17:48,000 --> 00:17:51,800
!أبليت حسنًا يا أوشيكو-سان
.أدّيت الرّقصة ببراعة

281
00:17:51,800 --> 00:17:53,160
!أجل

282
00:17:54,440 --> 00:17:59,290
...لديك... الكثير من الطّاقة... أيضًا

283
00:17:59,890 --> 00:18:03,140
أعتقد أنّ بإمكانك الاحتفاظ بالمزيد
.من الطّاقة إن خرستِ من وقت لآخر

284
00:18:02,470 --> 00:18:05,990
صحيح يا هيزومي؟

285
00:18:06,550 --> 00:18:07,390
.صحيح

286
00:18:07,840 --> 00:18:10,820
.كانت حركاتك متقنة جدًّا وأداؤك مذهلاً

287
00:18:15,090 --> 00:18:17,530
.لقد ارتاحت قليلاً

288
00:18:17,530 --> 00:18:19,900
.لقد أثنت عليّ سينباي

289
00:18:21,350 --> 00:18:24,990
.هكذا إذًا يبدو تشجيعك يا أوشيكو-سان

290
00:18:25,910 --> 00:18:27,710
،قد يبدو كلامي فظًّا

291
00:18:27,710 --> 00:18:32,500
لكنّني لا أذكر شيئًا عنك أو عن
.عضوات الفرقة الأخريات

292
00:18:33,280 --> 00:18:37,290
كنت مهووسة بالتّشجيع كثيرًا
لدرجة أنّني لم ألاحظ حتّى

293
00:18:37,290 --> 00:18:39,610
.من كانوا حولي

294
00:18:40,480 --> 00:18:44,200
.كان الجميع حولي... مجرّد بطاطس في نظري

295
00:18:44,200 --> 00:18:46,090
!نحو الفوز هيّا

296
00:18:46,090 --> 00:18:48,100
.هذا مخيف بحدّ ذاته

297
00:18:48,960 --> 00:18:51,510
،أعرف أنّ هذا قد أتى متأخّرًا

298
00:18:52,410 --> 00:18:56,990
لكنّني سعيدة للغاية لأنّني تمكّنت من
.التّشجيع معك اليوم يا أوشيكو-سان

299
00:18:58,820 --> 00:18:59,990
...سينباي

300
00:19:00,440 --> 00:19:03,820
.أنا من هي سعيدة بالتّشجيع معك

301
00:19:03,820 --> 00:19:07,500
.لكن.. كلّ ما فعلتُه هو مشاهدتك

302
00:19:08,580 --> 00:19:10,040
...لذلك أستطيع أن أجزم

303
00:19:10,040 --> 00:19:13,980
.بأنّها تستمع بوقتها الآن وليس كما في السّابق

304
00:19:15,080 --> 00:19:16,000
...وأيضًا

305
00:19:17,060 --> 00:19:19,020
.تبدو بشرتها أنعم ورائحة شعرها أزكى

306
00:19:19,020 --> 00:19:21,050
.وذراعاها يبدوان مختلفين أيضًا

307
00:19:21,050 --> 00:19:23,010
...كلاّ! هذا الوضع يدخل مراحله الخطيرة

308
00:19:24,370 --> 00:19:28,020
،لكن كما أولت سينباي اهتمامها للتّشجيع فحسب

309
00:19:28,430 --> 00:19:31,610
.كنت أنا أيضًا أولي اهتمامي لها فقط

310
00:19:32,360 --> 00:19:35,020
أعني، هل كان التّشجيع أمرًا

311
00:19:36,290 --> 00:19:38,170
نقوم به معًا هكذا دائمًا؟

312
00:19:40,000 --> 00:19:44,410
كانت سينباي تبدو صارمة وممتعضة
،دائمًا عندما كانت تشجّع

313
00:19:44,950 --> 00:19:47,660
.لكنّها تبدو الآن مستمتعة بوقتها كثيرًا

314
00:19:48,020 --> 00:19:50,140
.ذلك هو كلّ ما يهمّ

315
00:19:50,790 --> 00:19:53,450
...إن كان ذلك ما يسعد سينباي

316
00:19:56,840 --> 00:19:59,830
...لا... لا

317
00:20:01,800 --> 00:20:05,550
!كلاّ

318
00:20:09,360 --> 00:20:10,680
!سهم"؟"

319
00:20:15,930 --> 00:20:19,690
!أريد أن أشجّع معك أيضًا يا سينباي

320
00:20:20,310 --> 00:20:22,200
!أريد الضّحك معها

321
00:20:22,950 --> 00:20:26,950
،حتّى إن لم أكن قادرة على تغيير سينباي

322
00:20:29,730 --> 00:20:32,520
!كنت أشاهدها طوال هذا الوقت

323
00:20:34,230 --> 00:20:36,210
...مـ-مذهل

324
00:20:37,700 --> 00:20:41,050
.تشجيع أوشيكو-سان مليء بالمشاعر

325
00:20:42,420 --> 00:20:43,850
...التّشجيع أمر

326
00:20:47,540 --> 00:20:49,220
أهو هكذا؟

327
00:20:54,320 --> 00:20:56,040
!نجحنا

328
00:20:56,040 --> 00:20:57,520
!لقد فزن

329
00:21:01,350 --> 00:21:04,140
!تهانينا يا سينباي كرة السّلّة

330
00:21:04,140 --> 00:21:05,660
!شكرًا

331
00:21:12,310 --> 00:21:13,400
!سينباي

332
00:21:14,720 --> 00:21:16,220
...إن تشجيعي

333
00:21:16,870 --> 00:21:18,170
أريدك أن تواصلي

334
00:21:18,760 --> 00:21:20,170
!مشاهدته رجاءً

335
00:21:23,800 --> 00:21:25,170
...لكن

336
00:21:25,670 --> 00:21:28,080
.انتهينا من التّشجيع لهذا اليوم

337
00:21:28,080 --> 00:21:30,330
...ما-ماذا؟ ذلك ليس ما قصدت

338
00:21:30,330 --> 00:21:31,560
!دعم

339
00:21:32,560 --> 00:21:34,680
!ستنضمّين لنا إذًا

340
00:21:34,680 --> 00:21:36,110
.لقد أسعدني ذلك جدًّا

341
00:21:36,110 --> 00:21:37,800
أأنت جادّة يا أوشيكو-سان؟

342
00:21:37,800 --> 00:21:41,440
إذًا لماذا لا تتوقّفي عن مناداتي "سينباي"؟

343
00:21:41,440 --> 00:21:44,100
.نحن زميلات فريق

344
00:21:45,080 --> 00:21:46,730
."لذلك نادني "هيزومي

345
00:21:47,410 --> 00:21:48,920
!أنا كوهاني

346
00:21:48,920 --> 00:21:51,100
...أنا... كوتيتسو

347
00:21:51,100 --> 00:21:51,950
.نادني أوكي

348
00:21:57,320 --> 00:21:59,680
!لقد فقدت أوشيكو-سان وعيها

349
00:21:59,680 --> 00:22:01,260
هـ-هل أنت بخير؟

350
00:22:01,260 --> 00:22:02,720
!أوشيكو-سان

351
00:22:02,720 --> 00:22:04,550
!استيقظي

352
00:23:38,340 --> 00:23:42,020
!في الحلقة القادمة: "اُختيرت القائدة
."فرقة تشجيع من خمسة عضوات