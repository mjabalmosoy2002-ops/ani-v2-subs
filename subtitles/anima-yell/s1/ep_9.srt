1
00:00:15,830 --> 00:00:16,700
!أوشيكو-سان

2
00:00:17,080 --> 00:00:19,440
!ربّما لم ترينني! لكن هذه أنا

3
00:00:19,440 --> 00:00:21,680
!طبعًا رأيتك

4
00:00:21,680 --> 00:00:24,380
!أنا أتجاهلك لأنّك تحرجينني

5
00:00:25,500 --> 00:00:27,560
!ابتعدي عنّي

6
00:01:58,720 --> 00:01:59,760
...وأيضًا

7
00:02:00,270 --> 00:02:02,970
!مرحبًا في جمعيّة التّشجيع

8
00:02:02,970 --> 00:02:04,620
.مرحبًا يا أوشيكو-سان

9
00:02:04,620 --> 00:02:08,700
.لم يكن عليك المجيء لاصطحابي
.كان باستطاعتي المجيء وحدي

10
00:02:08,700 --> 00:02:11,660
والأهمّ من ذلك، كيف حال ساقك
يا ساواتاري-سان؟

11
00:02:11,660 --> 00:02:13,240
.صحيح، إنّها بخير

12
00:02:13,240 --> 00:02:15,150
.أنا أفضل بكلّ تأكيد بعد القليل من الرّاحة

13
00:02:15,730 --> 00:02:19,790
.أنت لطيفة يا أوشيكو-سان
.لقد كنتِ قلقة على أوكي

14
00:02:19,790 --> 00:02:22,370
...حـ-حسنًا، أنا مسؤولة نوعًا ما عن

15
00:02:22,790 --> 00:02:24,330
.آسفة على التّأخّر

16
00:02:25,190 --> 00:02:28,040
أوشيكو-سان، أتيت سلفًا؟

17
00:02:28,920 --> 00:02:31,520
لقد تأخّرتِ. هل طرأ أمر ما؟

18
00:02:31,520 --> 00:02:34,250
...حسنًا، مررت على فصل أوشيكو-سان

19
00:02:34,250 --> 00:02:37,130
!أنا جدّ آسفة لتواجدي هنا
!حتّى أنّك تكبّدتِ عناء المرور بفصلي

20
00:02:37,520 --> 00:02:39,190
!تغيّرت تصرّفاتها تمامًا

21
00:02:40,340 --> 00:02:43,280
!حسنًا، لنهتمّ باستمارة النّادي هذه

22
00:02:43,280 --> 00:02:44,090
!تفضّلي

23
00:02:46,840 --> 00:02:49,080
هل عليّ كتابة كامل اسمي؟

24
00:02:49,080 --> 00:02:50,300
!نعم

25
00:02:52,020 --> 00:02:54,690
...إنّها متردّدة في كتابة اسمها

26
00:02:55,100 --> 00:02:56,940
هل يعني ذلك أنّ أوشيكو-سان

27
00:02:57,260 --> 00:02:59,660
لديها اسم ليس أنثويًّا كثيرًا أيضًا؟

28
00:03:02,720 --> 00:03:05,370
.لا أظنّ أنّ عليك الرّفع من تطلّعات النّاس هكذا

29
00:03:02,720 --> 00:03:05,370
[هانا تعني زهرة]

30
00:03:06,000 --> 00:03:08,450
ماذا؟ هل قمت بخطأٍ ما؟

31
00:03:08,820 --> 00:03:10,670
!أوشيكو هاناوا-تشان

32
00:03:10,670 --> 00:03:12,080
.نعم، اسمك هاناوا-سان إذًا

33
00:03:12,080 --> 00:03:13,080
!كلاّ

34
00:03:13,080 --> 00:03:14,840
!علمتُ أنّكما ستقولان ذلك

35
00:03:14,840 --> 00:03:18,210
.إنّه كانا! لا تنادياني بهاناوا

36
00:03:18,210 --> 00:03:23,080
.هاناوا... لكنّ ذلك بدا بهيجًا أكثر

37
00:03:24,090 --> 00:03:27,510
بهيجًا؟ يبدو "حلق الأنف" بهيجًا؟

38
00:03:28,810 --> 00:03:32,140
...إ-إن كان ذلك رأيك يا سينباي

39
00:03:33,470 --> 00:03:38,010
!حسنًا، أنت هي عضوتنا الخامسة يا هاناوا-تشان
!مرحبًا بك في جمعيّة التّشجيع

40
00:03:38,010 --> 00:03:39,800
!لا تناديني هاناوا

41
00:03:39,800 --> 00:03:41,840
...ولكنّه اسم ظريف

42
00:03:41,840 --> 00:03:43,450
.وحدها سينباي يمكنها مناداتي بذلك

43
00:03:43,990 --> 00:03:45,100
العضوة الخامسة؟

44
00:03:45,100 --> 00:03:47,260
...مهلاً، بوجود عضوة خامسة

45
00:03:47,260 --> 00:03:48,080
.نعم

46
00:03:48,850 --> 00:03:50,010
...خمس عضوات

47
00:03:51,240 --> 00:03:52,920
!هذا يعني أنّ علينا اختيار ألواننا

48
00:03:52,920 --> 00:03:55,020
!أختار البرتقاليّ

49
00:03:56,690 --> 00:03:58,440
!لسنا مسلسل سينتاي من نوع ما

50
00:03:58,440 --> 00:03:59,630
!وأيضًا، من قد يختار البرتقاليّ؟

51
00:04:01,150 --> 00:04:02,970
.هذا يعني أنّ بإمكاننا أن نصبح ناديًا الآن

52
00:04:02,970 --> 00:04:05,130
.صحيح. هذا لأنّنا خمسة عضوات الآن

53
00:04:05,130 --> 00:04:06,890
!يمكننا أن نصبح ناديًا الآن

54
00:04:07,230 --> 00:04:09,820
يمكننا أن ننتقل من كوننا جمعيّة
!تشجيع إلى نادي تشجيع

55
00:04:09,820 --> 00:04:12,350
!أجل! أصبحنا نادي تشجيع أخيرًا

56
00:04:12,350 --> 00:04:13,940
.لقد نجحنا يا كوهاني-تشان

57
00:04:14,240 --> 00:04:17,960
لحظة، ما الاختلاف بين النّادي والجمعيّة من الأساس؟

58
00:04:17,960 --> 00:04:18,970
!لا فكرة لديّ

59
00:04:18,970 --> 00:04:20,900
!رغم أنّك تحمّستِ لهذه الدّرجة؟

60
00:04:21,810 --> 00:04:25,630
الاختلافات الكبيرة هي أنّنا سنحصل على
.غرفة للنّادي ومرشد وميزانيّة نادي

61
00:04:25,630 --> 00:04:28,220
ميزانيّة؟ سيعطوننا مالاً؟

62
00:04:29,040 --> 00:04:31,250
.لكن قد لا يكون الوقت مناسبًا كثيرًا الآن

63
00:04:31,620 --> 00:04:33,790
،ستنتهي الدّورة الأولى قريبًا
قد نضطرّ للانتظار

64
00:04:33,790 --> 00:04:36,480
حتّى اجتماع رؤساء النّوادي
.في الدّورة الثّانية

65
00:04:36,480 --> 00:04:39,900
،إذًا بدءًا من الدّورة الثّانية
!سنعيش حياة هانئة

66
00:04:39,900 --> 00:04:42,460
.لحظة... واصلي أحلامك الكبيرة يا فتاة

67
00:04:42,760 --> 00:04:45,320
!أجل! أمسى لدينا رئيسة نادٍ الآن

68
00:04:45,320 --> 00:04:46,970
.أعتقد أنّها هيزومي بالطّبع

69
00:04:47,290 --> 00:04:48,460
.أجل

70
00:04:48,460 --> 00:04:51,460
كلاّ، أعتقد أنّها يجب أن تكوني
.أنتِ يا كوهاني-سان

71
00:04:52,380 --> 00:04:56,710
...سـ-سينباي، لكن إن كان هذا رأيك

72
00:04:56,710 --> 00:04:57,730
...إذًا

73
00:04:58,520 --> 00:05:00,480
.مقاومتها تفوز

74
00:05:00,480 --> 00:05:05,610
تملك كوهاني-سان القدرة على منح الآخرين
.دفعة طفيفة وتساعدهم على التّقدّم للأمام

75
00:05:06,240 --> 00:05:09,500
أعتقد أنّ ذلك يجعلها الخيار الأمثل
.لتكون رئيسة نادي التّشجيع وقائدته

76
00:05:10,300 --> 00:05:12,580
.نعم، معك حقّ

77
00:05:13,010 --> 00:05:15,830
...كوتيتشان، هيزومي

78
00:05:16,140 --> 00:05:18,250
...لكنّ طرقها، نوعًا ما

79
00:05:18,250 --> 00:05:19,710
.نعم، معك حقّ

80
00:05:19,710 --> 00:05:20,340
.مهلاً

81
00:05:20,800 --> 00:05:22,840
لكن سيكون عليك حضور اجتماعات رئيسات النّوادي

82
00:05:22,840 --> 00:05:25,520
.والتّفاوض من أجل ميزانيّة النّادي وما شابه

83
00:05:25,520 --> 00:05:28,090
هل أنت أهل لتلك المهمّة؟

84
00:05:29,650 --> 00:05:31,470
...ستحضر كوهاني اجتماعات

85
00:05:32,690 --> 00:05:35,960
المعذرة... هلّي بميزانيّة للنّادي؟

86
00:05:35,960 --> 00:05:37,750
أرجوكنّ؟

87
00:05:39,750 --> 00:05:41,300
.أنا جدّ متعبة

88
00:05:41,720 --> 00:05:44,350
!لكن عليّ توفير ميزانيّة للنّادي

89
00:05:45,520 --> 00:05:47,630
.ستكون ظريفة، لذلك ستكون بخير في رأيي

90
00:05:47,630 --> 00:05:50,070
.لا أظنّ أنّ كوهاني-تشان صغيرة لذلك الحدّ

91
00:05:50,070 --> 00:05:51,480
،إن حصلنا على ميزانيّة

92
00:05:51,480 --> 00:05:55,310
سنكون قادرات على استعمالها لشراء
.معدّات وأدوات التّشجيع

93
00:05:55,310 --> 00:05:56,210
!صحيح

94
00:05:56,640 --> 00:06:00,080
.كنّا نشتريها بأنفسنا أو نصنعها بأيدينا حتّى الآن

95
00:06:00,080 --> 00:06:03,520
...لكنّ أزياءنا الحاليّة مصنوعة يدويًّا

96
00:06:03,520 --> 00:06:07,520
صحيح. لذلك سيكون على كانا-تشان
.أن تخيط زيّها بنفسها أيضًا

97
00:06:07,520 --> 00:06:09,760
ماذا؟ فعلاً؟ سأخيطه بيديّ؟

98
00:06:09,760 --> 00:06:11,970
!لا تقلقي! لدينا تصاميم لذلك

99
00:06:12,380 --> 00:06:15,050
!هذا هو تصميم أوكي

100
00:06:15,050 --> 00:06:16,110
!شبح؟

101
00:06:16,110 --> 00:06:17,980
!لماذا تملكين هذا يا كوهاني؟

102
00:06:18,360 --> 00:06:21,630
أعتقد أنّ بإمكاننا مواصلة استعمال
.غرفتنا الحاليّة كغرفة نادٍ في الوقت الحاليّ

103
00:06:21,630 --> 00:06:23,050
.بقي لنا توفير مرشدة فحسب

104
00:06:23,050 --> 00:06:24,760
،بما أنّك تلميذة شرفيّة

105
00:06:24,760 --> 00:06:26,440
ألست مقرّبة إلى أيّ من المدرّسات؟

106
00:06:26,440 --> 00:06:28,110
.كلاّ، لا يمكنني الجزم بذلك

107
00:06:28,410 --> 00:06:30,860
.مهلاً، أعتقد أنّني أعرف إحداهنّ

108
00:06:30,860 --> 00:06:35,900
كوهاني-تشان، المرشدة هي مدرّسة
.ستشرف على نشاطات النّادي

109
00:06:35,900 --> 00:06:38,370
.ماذا؟ نعم. أعرف ذلك

110
00:06:38,870 --> 00:06:39,920
...وأيضًا

111
00:06:40,610 --> 00:06:43,070
.أمسى لنادي التّشجيع خمس عضوات أخيرًا

112
00:06:43,070 --> 00:06:45,380
لذلك هلاّ أصبحتِ مرشدتنا يا إينوكاي-سينسي؟

113
00:06:45,380 --> 00:06:47,500
،يمنح التّشجيع الكثير من الطّاقة

114
00:06:47,500 --> 00:06:50,340
لذلك أظنّ أنّه سيكون مثاليًّا لك
.بما أنّك تبدين مرهقة دائمًا

115
00:06:50,950 --> 00:06:54,160
أنا أبدو مرهقة بالفعل، لذلك السّبب
.بالتّحديد أفضّل ألاّ أكون مرشدتكنّ

116
00:06:54,160 --> 00:06:56,710
لدينا إبريق كهربائيّ ووجبات
،خفيفة في غرفة نادينا

117
00:06:56,710 --> 00:06:58,250
لذلك يمكنكم شرب ما تريدين
!من الشّاي في استراحاتك

118
00:06:58,250 --> 00:07:00,140
!كوهاني! لا تقولي أشياء كهذه أمام مدرّسة

119
00:07:00,140 --> 00:07:02,270
...شاي؟ إذًا

120
00:07:02,660 --> 00:07:04,640
هل لديكنّ كرسيّ تدليك أيضًا؟

121
00:07:04,640 --> 00:07:06,110
.أنت مرهقة جدًّا

122
00:07:06,740 --> 00:07:10,590
.لكنّني لا أعرف شيئًا عن التّشجيع

123
00:07:10,590 --> 00:07:11,550
ألا تمانعن ذلك؟

124
00:07:11,550 --> 00:07:12,820
!لا بأس

125
00:07:12,820 --> 00:07:16,010
!لقد بدأت أتعلّم بعد أن بدأت الدّراسة هنا

126
00:07:16,010 --> 00:07:16,540
صحيح؟

127
00:07:16,540 --> 00:07:20,880
،نعم. بدأنا هذا الرّبيع فحسب
،وكان ذلك صعبًا في البداية

128
00:07:20,880 --> 00:07:23,040
.لكنّني أشعر أنّني أقوى الآن بالتّأكيد

129
00:07:23,040 --> 00:07:26,380
،أنا... أفتقر للقدرة على التّحمّل

130
00:07:26,380 --> 00:07:29,210
...وإن سألني أحد ما، فأنا لست جيّدة كفاية

131
00:07:29,210 --> 00:07:30,200
،والأهمّ من ذلك

132
00:07:30,200 --> 00:07:33,690
ما زلت أقلق من أنّني قد أكون
.مصدر إزعاج للجميع

133
00:07:33,690 --> 00:07:37,850
فهل عليّ فعلاً أن أقوم بالتّشجيع؟

134
00:07:38,810 --> 00:07:42,300
ما الّذي نضيفه نحن للتّشجيع؟

135
00:07:42,300 --> 00:07:44,560
.مرحبًا... أنت تشردين عن صلب الموضوع

136
00:07:44,560 --> 00:07:48,430
!لكنّني واثقة أنّك ستحبّين التّشجيع يا سينسي

137
00:07:48,430 --> 00:07:49,820
.لست واثقة من ذلك

138
00:07:49,820 --> 00:07:53,050
.حسنًا، التّشجيع رياضة جذّابة جدًّا

139
00:07:53,050 --> 00:07:53,700
!نعم

140
00:07:53,700 --> 00:07:58,950
ناهيكنّ عن ذكر أنّني عندما كنت
...أساعد كوماغاي-سينسي ذات يوم

141
00:07:59,720 --> 00:08:05,040
قالت إنّك كنتِ تنادَيْن بالرّاقصة
!التّفسيريّة إينوكاي  في الإعداديّة

142
00:08:05,040 --> 00:08:08,650
صحيح... لا بدّ أنّها كانت تتحدّث
.عن إينوكاي-سان أخرى

143
00:08:08,650 --> 00:08:09,300
...لكن

144
00:08:09,560 --> 00:08:11,340
.قالت إنّها تملك دي في دي أيضًا

145
00:08:12,760 --> 00:08:15,590
!لا بأس! سأكون مرشدتكنّ

146
00:08:15,980 --> 00:08:18,810
!الأطفال مخيفون هذه الأيّام

147
00:08:18,810 --> 00:08:22,430
!أجل! سنعمل بجدّ بالفعل لكي تحبّي التّشجيع

148
00:08:22,880 --> 00:08:25,690
!سنشجّعك حتّى تتخلّصين من تعبك

149
00:08:25,690 --> 00:08:28,170
.مفهوم، مفهوم يا هاتويا

150
00:08:28,170 --> 00:08:29,710
!حتّى أنّني سأدلّك كتفيك

151
00:08:29,710 --> 00:08:30,970
!هذا مؤلم

152
00:08:30,970 --> 00:08:33,360
.قد تكون رئيسة نادٍ جيّدة

153
00:08:33,360 --> 00:08:35,400
من كان يدري أنّ لها موهبة كهذه؟

154
00:08:36,520 --> 00:08:39,550
والآن، أصبحت جمعيّة التّشجيع بعددكنّ الحالي

155
00:08:39,550 --> 00:08:42,240
.فريق تشجيع رسميًّا الآن

156
00:08:42,240 --> 00:08:44,060
.حتّى أنّكنّ حصلتنّ على طلب سلفًا

157
00:08:44,060 --> 00:08:45,250
ماذا؟ ثانية؟

158
00:08:45,640 --> 00:08:47,630
يبدو أنّ أحد الآباء قد رآكنّ

159
00:08:47,630 --> 00:08:49,920
.تشجّعن في مباراة كرة السّلّة ذلك اليوم

160
00:08:49,920 --> 00:08:52,120
!هذا رائع! بدأ الأمر يعطي أُكله

161
00:08:52,120 --> 00:08:54,480
!إنّ دائرة تشجيعنا تتوسّع أكبر وأكبر

162
00:08:54,480 --> 00:08:58,590
.قد يرانا الآن أحد آخر ويقدّم طلبًا أيضًا

163
00:08:58,590 --> 00:09:01,120
.وقد يخلق ذلك فرصة أخرى لنا

164
00:09:01,120 --> 00:09:01,770
!أجل

165
00:09:01,770 --> 00:09:05,440
إنّه طلب تشجيع لمباراة كرة
قدم لفريق مدرسة ابتدائيّة

166
00:09:05,440 --> 00:09:07,270
.إضافة لأداء بين الشّوطين

167
00:09:07,270 --> 00:09:09,420
."الفّريق الّذي ستشجّعنه يُدعى "المنتصرين

168
00:09:09,420 --> 00:09:10,020
!ماذا؟

169
00:09:11,430 --> 00:09:12,970
.لنوقف هذه الاتّصالات للحظة

170
00:09:12,970 --> 00:09:14,030
!لماذا؟

171
00:09:14,030 --> 00:09:16,720
...مهلاً، فريق كرة القدم هذا

172
00:09:16,720 --> 00:09:19,020
...أوكي، هل ما زلت

173
00:09:19,710 --> 00:09:21,660
ما زالت ماذا؟

174
00:09:21,660 --> 00:09:24,020
هل ما زلت عضوة في ذلك الفريق أو ما شابه؟

175
00:09:24,440 --> 00:09:26,040
!بالطّبع لست كذلك

176
00:09:26,040 --> 00:09:28,890
...ربّما هنالك شخص ما زلت لم تنسيه

177
00:09:28,890 --> 00:09:30,420
طفل في الابتدائيّة؟

178
00:09:31,220 --> 00:09:33,450
ما هو السّبب إذًا؟

179
00:09:33,450 --> 00:09:35,760
...إنّها... إنّها

180
00:09:36,480 --> 00:09:39,280
!ما زالت لم تحقّق حلمها في زيارة مدغشقر

181
00:09:39,280 --> 00:09:41,470
.شكرًا على محاولة تشتيت انتباههنّ الفاشلة

182
00:09:41,470 --> 00:09:42,860
،لست واثقة ممّا يحدث

183
00:09:42,860 --> 00:09:44,920
لكن هل توافقن على هذا الطّلب؟

184
00:09:44,920 --> 00:09:46,760
...لحظة

185
00:09:46,760 --> 00:09:49,550
...نريد أن نقبل به، لكن

186
00:09:49,550 --> 00:09:53,110
!أجل! يمكنكنّ أن تقبلن به! لا مانع أبدًا

187
00:09:53,480 --> 00:09:56,940
أخوك الصّغير يلعب في ذلك
الفريق يا أوكي-تشان؟

188
00:09:56,940 --> 00:09:57,740
...نعم

189
00:09:57,740 --> 00:10:00,440
.ذلك سبب إضافيّ لتشجيعهم أكثر

190
00:10:00,440 --> 00:10:02,810
.لا تأتي الفرص كهذه كلّ يوم

191
00:10:04,440 --> 00:10:09,350
،لكنّ أكاني يكره الأمور الأنثويّة كثيرًا مؤخّرًا

192
00:10:09,350 --> 00:10:11,750
.لذلك لم أخبره أنّني مشجّعة

193
00:10:11,750 --> 00:10:15,040
إذًا ما النّادي الّذي يعتقد أنّك منضمّة له؟

194
00:10:15,040 --> 00:10:17,380
.فـ-في نادي العدْوِ رفقة كوهاني

195
00:10:17,690 --> 00:10:19,000
فعلاً؟

196
00:10:19,000 --> 00:10:21,010
...لست واثقة أنّ ذلك مقنع كثيرًا

197
00:10:21,340 --> 00:10:23,660
هل أخبرتنّ جميعًا عائلاتكنّ بما تفعلنه؟

198
00:10:23,660 --> 00:10:24,520
.نعم

199
00:10:24,520 --> 00:10:27,290
أنا وسينباي كنّا بحاجة لإذن من أولياء أمورنا

200
00:10:27,290 --> 00:10:29,280
.لنكون حتّى في فرقة محلّيّة

201
00:10:29,280 --> 00:10:33,580
.بدأت التّشجيع في البداية لأشجّع أخي الأكبر

202
00:10:33,580 --> 00:10:34,900
!فعلاً؟

203
00:10:35,400 --> 00:10:40,160
...أخو سينباي الأكبر
!لا بدّ أنّه شخص ذو نزاهة

204
00:10:40,160 --> 00:10:43,440
.نعم. أخي شخص يمكن التّطلّع إليه

205
00:10:43,440 --> 00:10:45,040
.أنا فخورة جدًّا به

206
00:10:45,040 --> 00:10:46,430
!عرفتُ ذلك

207
00:10:46,430 --> 00:10:49,850
.لكن... ما كنت لآخذ ذلك بجدّيّة كبيرة

208
00:10:49,850 --> 00:10:52,910
.يحدث سوء الفهم طوال الوقت

209
00:10:52,910 --> 00:10:54,130
ماذا؟

210
00:10:54,460 --> 00:10:56,350
إذًا ماذا كان يفعل أخوك؟

211
00:10:56,350 --> 00:10:57,020
...لقد

212
00:10:57,020 --> 00:10:58,090
!مهلاً لحظة

213
00:10:58,560 --> 00:11:01,560
أحتاج لأجهّز نفسي لأكون مستعدّة
.لأيّ شيء ستقولينه

214
00:11:01,560 --> 00:11:04,580
ماذا يفعل أخي في رأيك؟

215
00:11:04,580 --> 00:11:05,820
.إنّه يمارس مبارزة السّيوف اليابانيّة

216
00:11:05,820 --> 00:11:06,600
!هذا عاديّ جدًّا

217
00:11:07,190 --> 00:11:11,000
كان دافعًا بسيطًا للغاية لإسعاده
...عن طريق تشجيعهن لكن

218
00:11:11,000 --> 00:11:12,020
!يبدو ذلك جيّدًا

219
00:11:12,330 --> 00:11:14,700
!أنا واثقة أنّ أكاني-كُن سيكون سعيدًا أيضًا

220
00:11:14,700 --> 00:11:16,540
أ-أتظنّين ذلك؟

221
00:11:16,540 --> 00:11:18,670
!ربّما سيبدأ بالتّشجيع هو أيضًا

222
00:11:18,670 --> 00:11:19,530
ماذا؟

223
00:11:19,530 --> 00:11:23,550
لم لا؟ هنالك الكثير من الأولاد
.يقومون بالتّشجيع مؤخّرًا

224
00:11:23,550 --> 00:11:27,240
نعم، لكن... تركه لكرة القدم
...من أجل التّشجيع سيكون

225
00:11:27,240 --> 00:11:31,290
.لا بأس. إنّهم يهتمّون بالأمر فقط في البداية

226
00:11:35,930 --> 00:11:37,960
.أتساءل إن كان سيسعد بذلك بالفعل

227
00:11:37,960 --> 00:11:39,430
.لقد عدت

228
00:11:40,640 --> 00:11:44,680
مرحبًا بعودتك... ما الخطب يا أكاني؟

229
00:11:45,100 --> 00:11:48,430
.أتت بعض الفتيات لتشجيعنا أثناء التّدريب

230
00:11:50,310 --> 00:11:53,060
!كان صراخهنّ عاليًا لدرجة أنّه شتّت تركيزنا

231
00:11:54,500 --> 00:11:56,160
ما الخطب يا أختي؟

232
00:11:56,160 --> 00:11:58,320
...لا-لا شيء

233
00:11:58,320 --> 00:12:00,700
.لن يسعد بسماع ذلك بكلّ تأكيد

234
00:12:01,860 --> 00:12:05,130
لماذا لدى الفتيات صوت مزعج كهذا؟

235
00:12:05,130 --> 00:12:07,660
.أواصل التّركيز على تدريب كرة القدم فحسب

236
00:12:10,670 --> 00:12:12,410
.لا أستطيع إخباره

237
00:12:13,350 --> 00:12:15,310
،لكنّه سيكتشف الأمر في النّهاية

238
00:12:15,310 --> 00:12:17,880
لذلك من الأفضل إن أخبرته
.عاجلاً أفضل من آجلاً

239
00:12:19,090 --> 00:12:21,370
...ا-اسمع يا أكاني

240
00:12:21,370 --> 00:12:25,370
.صحيح! أنت... لا تشبهينهنّ يا أختي

241
00:12:25,910 --> 00:12:28,810
.لست بغيضة، أنت رائعة

242
00:12:29,590 --> 00:12:31,100
أنت في نادي العدْوِ، صحيح؟

243
00:12:31,910 --> 00:12:34,860
هل يمكنك أن تعلّميني مفتاح الرّكض
بسرعة في وقت لاحق؟

244
00:12:36,290 --> 00:12:39,070
!أختي؟ أختي؟

245
00:12:39,920 --> 00:12:42,700
لهذا السّبب تقرئين كتابًا عن الرّكض؟

246
00:12:42,700 --> 00:12:44,190
.أنت مثيرة للشّفقة

247
00:12:44,190 --> 00:12:47,450
.انظري إليه مباشرة وأخبريه فحسب

248
00:12:47,450 --> 00:12:50,490
ألم أخبرك بشيء مشابه لهذا ذات يوم؟

249
00:12:51,370 --> 00:12:53,720
لماذا لا تخبرينه ببساطة؟

250
00:12:53,720 --> 00:12:58,080
.إن أمكنها ذلك، كانت لتذكر نادي التّشجيع سلفًا

251
00:12:58,080 --> 00:13:01,420
.ناهيكنّ عن أنّه ليس أمرًا يسهل التّحدّث بشأنه

252
00:13:03,340 --> 00:13:05,790
ما رأيك إذًا أن تجعليه يراك في زيّ التّشجيع

253
00:13:05,790 --> 00:13:07,880
ويكتشف الأمر بتلك الطّريقة؟

254
00:13:07,880 --> 00:13:09,510
يراني أرتدي زيّي؟

255
00:13:11,150 --> 00:13:12,890
...لـ-لقد عدت

256
00:13:14,370 --> 00:13:17,270
يبدو وجهك محمرًّا قليلاً، هل أنت بخير؟

257
00:13:18,840 --> 00:13:21,420
لماذا لبستِه تحت زيّك المدرسيّ؟

258
00:13:21,420 --> 00:13:22,680
.لا فائدة من ذلك

259
00:13:22,680 --> 00:13:24,460
...حـ-حسنًا

260
00:13:24,460 --> 00:13:27,660
أعتقد أنّه سيتفهّم الأمر
.إن قمتِ بالتّشجيع أمامه

261
00:13:27,660 --> 00:13:30,110
!مهلاً! أستطيع مساعدتك في ذلك

262
00:13:30,110 --> 00:13:31,540
!إيّاك أرجوك

263
00:13:33,660 --> 00:13:35,320
!أجل

264
00:13:36,550 --> 00:13:37,620
!لقد عدت

265
00:13:37,620 --> 00:13:41,410
!لقد أخفتني! أنت تصرخين كثيرًا يا أختي

266
00:13:41,410 --> 00:13:43,580
وما قصّة "أجل" تلك؟

267
00:13:43,580 --> 00:13:46,820
...لا شيء... كنت أراجع إنجليزيّتي فحسب

268
00:13:48,680 --> 00:13:50,890
...بينما كنت مشغولة أقوم بكلّ هذا الهراء

269
00:13:50,890 --> 00:13:53,390
!المباراة غدًا

270
00:13:53,390 --> 00:13:54,880
أعتقد أنّه في هذه المرحلة

271
00:13:54,880 --> 00:13:57,820
سيعرف بشكل تلقائيّ غدًا دون
.أن تفعلي أيّ شيء

272
00:13:57,820 --> 00:14:01,770
إخباره قبل ذلك يختلف عن اكتشافه
!للأمر أثناء المباراة

273
00:14:02,120 --> 00:14:04,380
.عليك إخباره اللّيلة فحسب إذًا

274
00:14:04,380 --> 00:14:07,820
.لكن إن أخبرته قبل المباراة، فقد لا يحضرها

275
00:14:07,820 --> 00:14:08,780
ما كان أكاني

276
00:14:08,780 --> 00:14:11,740
...ليفوّت اللّعب في مباراة فقط لأنّ

277
00:14:11,740 --> 00:14:13,160
...لا أظنّ... ذلك

278
00:14:13,160 --> 00:14:15,290
!أوكي! ما بال وجهك؟

279
00:14:16,130 --> 00:14:20,090
أخبرني... لديك مباراة غدًا، صحيح يا أكاني؟

280
00:14:20,090 --> 00:14:22,280
.نعم، بالطّبع

281
00:14:22,280 --> 00:14:25,980
.أ-أنا أفكّر في المجيء لتشجيعك

282
00:14:25,980 --> 00:14:27,470
!ماذا؟! ليس عليك ذلك

283
00:14:27,800 --> 00:14:30,880
،قال بقيّة الفتية أنّ عائلاتهم لن تحضر

284
00:14:30,880 --> 00:14:33,200
!لذلك لا تحضري أبدًا! على الإطلاق

285
00:14:33,200 --> 00:14:35,350
!أنا جادّ

286
00:14:35,780 --> 00:14:39,610
بالحديث عن التّشجيع، فسوف تحضر
.فتيات ما لتشجيعنا غدًا

287
00:14:39,610 --> 00:14:41,870
.فـ-فعلاَ؟ يبدو ذلك جيّدًا

288
00:14:41,870 --> 00:14:43,840
.أنا واثقة أنّهنّ سيحمّسن المباراة

289
00:14:43,840 --> 00:14:44,730
!ذلك ليس جيّدًا أبدًا

290
00:14:47,300 --> 00:14:48,490
.أنا لا أحبّ ذلك

291
00:14:48,780 --> 00:14:50,610
!كلّ ما يفعلنه هو اللّهو

292
00:14:52,880 --> 00:14:55,130
...و-ويظهرن ملابسهنّ الدّاخليّة بينما يرقصن

293
00:14:55,130 --> 00:14:56,560
!إنّهنّ مبهرجات فحسب

294
00:14:56,560 --> 00:14:58,800
.أريد لعب كرة القدم بجدّيّة فحسب

295
00:14:58,800 --> 00:15:00,890
.التّشجيع محرج للغاية

296
00:15:01,960 --> 00:15:04,700
—مهلاً. كيف عرفتِ بشأن مباراتي غدًا

297
00:15:04,700 --> 00:15:06,010
ماذا قلت للتّوّ؟

298
00:15:06,010 --> 00:15:06,590
ماذا؟

299
00:15:07,080 --> 00:15:10,380
مبهرجات؟ نظهر ملابسنا الدّاخليّة بينما نرقص؟

300
00:15:10,380 --> 00:15:11,970
أين كنت تنظر من الأساس أيّها المنحرف؟

301
00:15:12,220 --> 00:15:14,120
ماذا؟ منحرف؟

302
00:15:14,120 --> 00:15:16,720
!ذلك ليس الهدف من التّشجيع

303
00:15:17,400 --> 00:15:20,440
احرص على إبقاء عينيك المنحرفتين
!هاتين مفتوحتان غدًا

304
00:15:20,830 --> 00:15:22,730
!سترى ما هو التّشجيع الحقيقيّ

305
00:15:24,230 --> 00:15:25,560
أختي؟

306
00:15:26,460 --> 00:15:29,310
!من الجيّد أنّك تمكّنتِ من إخباره قبل يوم المباراة

307
00:15:29,310 --> 00:15:31,570
!يبدو أنّ الأمر سار على خير

308
00:15:32,550 --> 00:15:35,480
...لقد عاملتُ أخي الصّغير كمنحرف فحسب

309
00:15:35,960 --> 00:15:38,940
...ثمّ تجرّأت على أن أظهر بملابسي الضّيّقة هنا

310
00:15:38,940 --> 00:15:41,210
سوف تثبتين

311
00:15:41,610 --> 00:15:43,960
أنّه كان مخطئًا، صحيح؟

312
00:15:44,360 --> 00:15:45,720
.لننطلق

313
00:15:45,720 --> 00:15:47,960
!أتمنّى أن يكون أخوك هناك

314
00:15:50,400 --> 00:15:52,340
أنت لا تعرفين متى تتوقّفين، صحيح؟

315
00:15:54,280 --> 00:15:56,970
.نحن فرقة التّشجيع من ثانويّة كامينوكي

316
00:15:56,970 --> 00:15:59,130
.شكرًا لاستضافتنا اليوم

317
00:15:59,130 --> 00:16:01,510
.يشرّفنا أن نستضيفكنّ عندنا
.شكرًا على قدومكنّ

318
00:16:02,940 --> 00:16:03,980
!أختي؟

319
00:16:04,320 --> 00:16:05,480
!وكوهاني أيضًا

320
00:16:05,480 --> 00:16:07,160
أخت أكّي؟

321
00:16:07,160 --> 00:16:08,280
أيّهنّ هي؟

322
00:16:08,280 --> 00:16:10,910
!إ-إنّها ليست أختي! كفّوا عن النّظر

323
00:16:10,910 --> 00:16:12,040
!كفّوا عن النّظر

324
00:16:12,040 --> 00:16:14,460
هل أنا مصدر إحراج لتلك الدّرجة؟

325
00:16:15,720 --> 00:16:16,870
...أكاني

326
00:16:17,270 --> 00:16:19,420
.آسفة لأنّني أبقيت الأمر سرًّا عنك

327
00:16:19,420 --> 00:16:20,680
.ابذل جهدك

328
00:16:20,680 --> 00:16:22,120
.لا يهمّ

329
00:16:22,440 --> 00:16:25,000
.لن ألعب من بداية المباراة من الأساس

330
00:16:28,770 --> 00:16:29,500
.حسنًا

331
00:16:29,890 --> 00:16:32,300
!لنرَ إذًا من يمكنه التّشجيع أفضل

332
00:16:34,880 --> 00:16:35,930
!من الأفضل؟

333
00:16:35,930 --> 00:16:39,430
هيزومي-تشان، لا أعتقد أنّ الأمر
.جادّ كما تتصوّرينه

334
00:16:42,470 --> 00:16:44,190
ما خطب أختي؟

335
00:16:44,190 --> 00:16:48,150
—لماذا ترتدين ملابس ظريفة
أعني مبهرجة كهذه؟

336
00:16:49,840 --> 00:16:50,760
—حظًّا سعيـ

337
00:16:50,510 --> 00:17:03,040
!تقدّموا أيّها المنتصرون، تقدّموا

338
00:16:56,220 --> 00:16:57,780
!يا أولاد

339
00:17:00,270 --> 00:17:02,400
!هيّا بنا أيّها المنتصرون

340
00:17:02,400 --> 00:17:03,040
!هيّا

341
00:17:03,040 --> 00:17:06,060
...هـ-هيّا أيّها المنتصرون

342
00:17:06,060 --> 00:17:08,730
!أعلى! هيّا بنا أيّها المنتصرون

343
00:17:08,730 --> 00:17:10,550
!هيّا بنا أيّها المنتصرون

344
00:17:10,550 --> 00:17:16,010
!هيّا بنا أيّها المنتصرون! هيّا بنا أيّها المنتصرون
!هيّا بنا أيّها المنتصرون

345
00:17:14,630 --> 00:17:17,270
.هذا ما كانت تقصده إذًا

346
00:17:16,010 --> 00:17:26,830
!هيّا بنا أيّها المنتصرون

347
00:17:26,830 --> 00:17:43,120
!هيّا بنا أيّها المنتصرون! هيّا بنا أيّها المنتصرون
!هيّا بنا أيّها المنتصرون

348
00:17:27,040 --> 00:17:30,020
...صوت تلك الفتاة عالٍ جدًّا

349
00:17:30,450 --> 00:17:32,650
!أنت رائعة يا سينباي

350
00:17:43,120 --> 00:17:50,630
!هيّا بنا أيّها المنتصرون! هيّا بنا أيّها المنتصرون

351
00:17:51,040 --> 00:17:54,110
.لقد شجّعت بكلّ ما لديّ

352
00:17:54,110 --> 00:17:56,320
بهدف تنشيط الأجواء بين الشّوطين

353
00:17:56,320 --> 00:17:58,730
سنشاهد أداءً من فرقة التّشجيع
!من ثانوية كامينوكي

354
00:18:20,520 --> 00:18:22,540
.لكنّهنّ كنّ يشجّعن طوال هذا الوقت

355
00:18:29,690 --> 00:18:32,470
...إنّهنّ يرقصن دون أيّ تعب بادٍ عليهنّ

356
00:18:37,050 --> 00:18:39,380
.لا في الحقيقة. إنّهنّ مرهقات قليلاً

357
00:19:34,310 --> 00:19:36,620
.ساواتاري، أحسنت بالتّشجيع قبل قليل

358
00:19:36,620 --> 00:19:37,150
ماذا؟

359
00:19:37,150 --> 00:19:39,610
.حسنًا، ستبدأ اللّعب في الشّوط الثّاني

360
00:19:39,610 --> 00:19:40,900
!حا-حاضر

361
00:19:44,240 --> 00:19:47,320
،كنّ يشجّعن طوال الوقت
.ثمّ أدّين تلك الرّقصة

362
00:19:47,320 --> 00:19:49,540
.من المستحيل أن يكنّ بخير بالكامل

363
00:19:52,000 --> 00:19:55,780
!هيّا بنا أيّها المنتصرون! هيّا بنا أيّها المنتصرون

364
00:20:48,420 --> 00:20:50,360
!أكاني

365
00:20:51,520 --> 00:20:53,950
.شكرًا على كلّ شيء لهذا اليوم

366
00:20:53,950 --> 00:20:55,640
.كلاّ، بل شكرًا لكنّ. لقد ارتقيتنّ لتطلّعاتنا

367
00:20:55,640 --> 00:20:57,210
.تجلب أولئك الفتيات الحظّ السّعيد

368
00:20:57,210 --> 00:20:58,300
الحظّ؟

369
00:20:58,300 --> 00:20:59,020
.نعم

370
00:20:59,020 --> 00:21:01,440
يٌقال إنّه عندما نطلب من فتيات
،ثانويّة كامينوكي أن تقمن بالتّشجيع

371
00:21:01,440 --> 00:21:02,920
.يكون الفوز مضمونًا

372
00:21:02,920 --> 00:21:04,340
فعلاً؟

373
00:21:04,800 --> 00:21:06,540
...أ-أختي

374
00:21:07,470 --> 00:21:10,090
...أنا... اليوم، كنت

375
00:21:10,090 --> 00:21:13,120
،كان بمقدورنا الفوز حتّى بدون تشجيعكنّ

376
00:21:13,120 --> 00:21:15,750
.لكنّني أعتقد أنّ علينا شكركنّ على أيّ حال

377
00:21:15,750 --> 00:21:18,200
.إنّه خجول للغاية

378
00:21:18,200 --> 00:21:20,250
.إنّه أخو أوكي-تشان بكلّ تأكيد

379
00:21:20,570 --> 00:21:22,330
...وأيضًا، أظنّ

380
00:21:22,330 --> 00:21:25,470
!أنّ التّشجيع رائع جدًّا

381
00:21:29,960 --> 00:21:31,740
!تهانينا يا أكّي

382
00:21:31,740 --> 00:21:34,730
!بذلتم جهدكم جميعًا! كنتم رائعين

383
00:21:34,730 --> 00:21:36,640
!اخرسي يا كوهاني

384
00:21:36,640 --> 00:21:37,980
!لا تناديني أكّي

385
00:21:38,690 --> 00:21:40,670
!كانت تلك التّسديدة رائعة

386
00:21:40,670 --> 00:21:42,730
!جعلتني أرغب في التّشجيع أكثر وأكثر

387
00:21:42,730 --> 00:21:46,440
طبعًا، فقد كنت أعلم أنّك كنت متعبة
!في الشّوط الثّاني

388
00:21:46,440 --> 00:21:48,120
ماذا؟ كنت تعلم؟

389
00:21:48,120 --> 00:21:51,490
!وذلك الزّيّ لا يبدو جيّدًا عليك أبدًا

390
00:21:51,490 --> 00:21:53,120
.أنت تشعر بالخجل فحسب

391
00:21:53,480 --> 00:21:55,750
.أنت تشبه أوكي كثيرًا

392
00:21:55,750 --> 00:21:57,460
!لست خجولاً

393
00:21:58,280 --> 00:22:00,080
ما بالك؟

394
00:21:58,710 --> 00:22:01,340
!أنت ظريف جدًّا

395
00:22:00,080 --> 00:22:01,340
!اخرسي

396
00:22:02,370 --> 00:22:04,340
.أنتما متشابهان كثيرًا بالفعل

397
00:22:04,340 --> 00:22:06,120
!توقّفي

398
00:23:38,800 --> 00:23:41,450
."في الحلقة القادمة: "جوارب ومخيّم تدريب صيفيّ