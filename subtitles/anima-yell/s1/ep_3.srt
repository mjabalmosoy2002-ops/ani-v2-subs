1
00:00:04,710 --> 00:00:06,940
!سنعمل نحن الثّلاثة معًا أخيرًا

2
00:00:06,940 --> 00:00:08,730
!أنا متحمّسة للغاية

3
00:00:08,730 --> 00:00:10,320
!هيّا يا أوكي! لنذهب للنّادي

4
00:00:10,320 --> 00:00:12,360
.ماذا؟ لستُ ذاهبة

5
00:00:12,360 --> 00:00:15,400
ستفوّتين الحضور من الآن؟
!يا لك من جانحة يا أوكي

6
00:00:15,400 --> 00:00:17,870
!كلاّ! لا تقولي هذا

7
00:00:17,870 --> 00:00:19,450
ما الخطب؟

8
00:00:19,880 --> 00:00:21,620
!أريما-سان

9
00:00:21,620 --> 00:00:23,260
!لنذهب للنّادي

10
00:00:23,260 --> 00:00:27,080
،امتحانات الكفاءة على الأبواب
.لذلك سنتوقّف عن نشاطات النّادي

11
00:00:27,080 --> 00:00:31,610
!ماذا؟! لكنّنا أصبحنا ثلاثة عضوات أخيرًا

12
00:02:03,490 --> 00:02:06,430
.لا يقتصر التّشجيع على نشاطات النّادي فحسب

13
00:02:06,760 --> 00:02:11,440
التّعليم الأكاديميّ هو أساس مهمّ
.على المشجّعات التّركيز عليه

14
00:02:11,770 --> 00:02:13,440
.إنّه تشجيع في الأساس

15
00:02:15,540 --> 00:02:20,110
.هذا جيّد. لا فكرة لدى كوهاني عمّا يحدث أيضًا

16
00:02:20,540 --> 00:02:24,160
،في أمريكا، حيث بدأ التّشجيع
نجد أنّ المشجّعات مصدر إعجاب

17
00:02:24,160 --> 00:02:26,120
.من قبل الجميع وهنّ الأوائل في صفوفهنّ

18
00:02:26,120 --> 00:02:28,960
إنّهنّ لائقات وذكيّات

19
00:02:28,960 --> 00:02:32,010
وجميلات وذوات ابتسامات مشرقة

20
00:02:32,010 --> 00:02:34,250
ولديهنّ القدرة على أن تكنّ
...قائدات محفّزات

21
00:02:34,590 --> 00:02:36,920
...لقد بذلت ما بوسعها

22
00:02:37,290 --> 00:02:39,500
أنا لا أقول أنّ علينا أن نحذو
،حذوهنّ لذلك الحدّ

23
00:02:39,500 --> 00:02:43,380
.ولكن لا ضير من اكتساب علامات جيّدة

24
00:02:43,380 --> 00:02:46,090
بالمناسبة، كيف هي علاماتكما بشكل عامّ؟

25
00:02:47,280 --> 00:02:49,520
.علينا التّدرّب إذًا

26
00:02:55,150 --> 00:02:56,020
!أجل

27
00:02:57,190 --> 00:02:58,860
!أريما-سان رائعة

28
00:02:59,880 --> 00:03:01,410
.لنبدأ أوّلاً بمادّة اللّغة الإنجليزيّة

29
00:03:01,770 --> 00:03:03,390
.أكره الإنجليزيّة

30
00:03:03,390 --> 00:03:05,680
.كلّ ما فعلتِه هو فتح كتابك حتّى الآن

31
00:03:05,680 --> 00:03:08,160
.معظم هتافات التّشجيع تكون بالإنجليزيّة

32
00:03:08,580 --> 00:03:11,450
قد يفهم جمهورك هتافاتك بشكل
.أفضل إن فهمتِ الإنجليزيّة

33
00:03:11,450 --> 00:03:12,880
!أجل

34
00:03:12,880 --> 00:03:14,130
.إنّها قريبة

35
00:03:14,430 --> 00:03:17,740
مثل تقدّموا للفوا! صحيح؟

36
00:03:17,740 --> 00:03:20,130
.بل هي تقدّموا للفوز

37
00:03:20,510 --> 00:03:23,770
.الأمر يتعلّق بأكثر من مجرّد الصّراخ

38
00:03:23,770 --> 00:03:26,250
.قد تؤذين حلقك أيضًا

39
00:03:28,310 --> 00:03:32,810
مفتاح تنفيذ هتافات جيّدة هي
.بإصدارها عميقًا من معدتك

40
00:03:32,810 --> 00:03:33,850
هكذا؟

41
00:03:33,850 --> 00:03:35,100
ماذا حدث للإنجليزيّة؟

42
00:03:36,360 --> 00:03:38,940
.من السّهل مذاكرة التّاريخ عن طريق كتابته

43
00:03:38,940 --> 00:03:40,970
.أكره التّاريخ

44
00:03:43,910 --> 00:03:46,090
!ما الّذي تحاولين تعلّمه من الأساس؟

45
00:03:46,090 --> 00:03:47,820
.ليدي عقل خاصّ بها

46
00:03:50,060 --> 00:03:52,750
على الأرجح لا يمكنك إقحام
...التّشجيع في الرّياضيّات

47
00:03:52,750 --> 00:03:53,750
!مرحى

48
00:03:53,750 --> 00:03:56,400
!أنت! ماذا تفعلين؟

49
00:03:56,400 --> 00:03:57,140
.ظريف

50
00:03:59,440 --> 00:04:03,070
...قوّة التّشجيع... أفتقر لقوّة التّشجيع

51
00:04:03,070 --> 00:04:05,930
...حتّى بعد إقحام التّشجيع في كلّ شيء

52
00:04:06,520 --> 00:04:08,040
.لم تتركي لي أيّ خيار آخر

53
00:04:11,170 --> 00:04:12,690
!ماذا؟

54
00:04:12,690 --> 00:04:20,270
!تقدّمي، تقدّمي يا هاتويا! هيّا يا هاتويا

55
00:04:15,690 --> 00:04:17,190
!تقدّمي، قاتلي، فوزي

56
00:04:18,320 --> 00:04:20,540
!قوّة التّشجيع تفيض منّي الآن

57
00:04:20,270 --> 00:04:21,780
!تقدّمي، قاتلي، فوزي

58
00:04:20,540 --> 00:04:22,440
!اخرسا

59
00:04:22,760 --> 00:04:26,880
بمناسبة ذلك الزّيّ، هل نسيت
أنّه ليس لدينا نادٍ اليوم؟

60
00:04:26,880 --> 00:04:29,080
...بـ-بـ-بالطّبع لم أنسَ

61
00:04:29,590 --> 00:04:32,750
!عليّ الآن أن أعيد كلّ قوّة التّشجيع تلك

62
00:04:32,750 --> 00:04:34,620
ما رأيك أن تستعمليها للدّراسة؟

63
00:04:35,830 --> 00:04:37,420
.سأنتهي في لحظة

64
00:04:42,170 --> 00:04:43,380
!انتهيت

65
00:04:43,380 --> 00:04:46,270
السّروال القصير الرّائع
!الّذي أهدتني إيّاه أريما-سان

66
00:04:46,270 --> 00:04:49,680
!إنّه يمنح قدرة رائعة على التّشجيع بمؤخّرتك

67
00:04:49,680 --> 00:04:52,270
!إنّ ذلك ليس الغرض منه

68
00:04:53,880 --> 00:04:57,270
حسنًا... ما المادّة الّتي علينا  العمل عليها اليوم؟

69
00:04:57,270 --> 00:04:59,820
...عـ-عفوًا

70
00:05:00,270 --> 00:05:03,500
!سأدرس وحدي اليوم

71
00:05:03,500 --> 00:05:05,490
!ليس عليك الهرب

72
00:05:06,020 --> 00:05:07,530
.لا أعتقد أنّها تحاول الهرب

73
00:05:07,530 --> 00:05:10,440
.إنّها قلقة ألاّ نتمكّن من الدّراسة

74
00:05:10,440 --> 00:05:11,770
إذًا فهي قلقة علينا؟

75
00:05:11,770 --> 00:05:12,660
.نعم

76
00:05:15,160 --> 00:05:17,390
في تلك الحالة، سأشعر بتحسّن أفضل

77
00:05:17,390 --> 00:05:20,760
.إن درستِ بالفعل حيث يمكننا رؤيتك

78
00:05:20,760 --> 00:05:23,010
...هذا صحيح

79
00:05:23,940 --> 00:05:25,010
.أنا آسفة

80
00:05:25,010 --> 00:05:28,560
.لا بأس. نعرف كم تعملين بجدّ يا كوهاني

81
00:05:28,560 --> 00:05:32,060
.لكنّني أعتقد أنّ عليك الدّراسة كلّ يوم

82
00:05:32,060 --> 00:05:34,170
.من الصّعب التّعلّم إن لم تواظبي عليه

83
00:05:34,170 --> 00:05:37,020
،حسنًا، عندما تكون علاماتك جيّدة
يتذكّرك المدرّسون أكثر

84
00:05:37,020 --> 00:05:39,880
.ويسهل إيجاد مرشد

85
00:05:44,560 --> 00:05:47,260
...أشعر بوجود تغيّر مفاجئ وجذريّ

86
00:05:47,260 --> 00:05:48,980
...نـ-نعم

87
00:05:49,380 --> 00:05:52,550
.عليك أن تتذكّري أن تأخذي استراحات أيضًا

88
00:05:53,850 --> 00:05:55,500
!تقدّموا للفوز

89
00:05:55,500 --> 00:05:57,290
!لا يجيب هذا على أيّ شيء

90
00:06:02,320 --> 00:06:04,670
إنّها تدرس خلال استراحتها أيضًا؟

91
00:06:05,000 --> 00:06:08,180
.يبدو أنّها تحاول جاهدة ألاّ تذكر التّشجيع أيضًا

92
00:06:08,180 --> 00:06:10,980
...بعد ذكرها للتّشجيع طوال الوقت

93
00:06:14,960 --> 00:06:19,130
،بعد أن انغمست في الدّراسة الآن
!باتت تبدو لي أكثر متعة

94
00:06:19,130 --> 00:06:20,980
.لا أهتمّ للتّشجيع بعد الآن

95
00:06:20,980 --> 00:06:23,020
...بعد الآن... بعد الآن

96
00:06:23,370 --> 00:06:26,120
...ثمّ سأصبح وحدي ثانية

97
00:06:26,120 --> 00:06:29,530
أعتقد أنّ لحظات صدمتك تراودك
...على أقلّ الأشياء

98
00:06:30,930 --> 00:06:33,980
.الدّراسة وأنت تمشين قد تكون خطيرة

99
00:06:33,980 --> 00:06:37,720
عليّ الدّراسة وأنا في طريقي
.للمنزل أيضًا بسبب علاماتي

100
00:06:37,720 --> 00:06:41,170
أعتقد أنّه من الجيّد أنّها لا تقوم
...بأيّ شيء جنونيّ، ولكن

101
00:06:48,230 --> 00:06:50,170
...كوهاني تكون في العادة

102
00:06:50,600 --> 00:06:51,840
!سأحمل أغراضك عنك

103
00:06:52,220 --> 00:06:52,730
—كوها

104
00:06:52,730 --> 00:06:54,580
...المعذرة

105
00:06:55,880 --> 00:06:58,850
لم أزر هذه المنطقة من قبل
.وأعتقد أنّني قد ضعت

106
00:06:59,650 --> 00:07:01,680
.أرغب بالذّهاب إلى هنا

107
00:07:01,680 --> 00:07:04,630
...أ-أكيد. للوصول إلى هنا

108
00:07:05,170 --> 00:07:06,480
!سأوصلك بنفسي

109
00:07:06,480 --> 00:07:09,580
.ممتاز. هذا لطف منك

110
00:07:13,280 --> 00:07:15,100
.شكرًا جزيلاً لك

111
00:07:15,100 --> 00:07:16,840
.مع السّلامة

112
00:07:19,400 --> 00:07:22,700
كوهاني! ما الخطب؟ هل أنت مريضة؟

113
00:07:23,360 --> 00:07:25,960
أحاول أن أحرص على ألاّ أخسر كلّ
...الأشياء الّتي حفظتُها

114
00:07:25,960 --> 00:07:27,210
!وهل ذلك ممكن جسديًّا؟

115
00:07:28,460 --> 00:07:32,840
.لكنّني ارتحت. أنت تتصرّفين كعادتك ثانية

116
00:07:32,840 --> 00:07:34,400
!لكنّ ذلك ليس جيّدًا

117
00:07:34,400 --> 00:07:38,330
،إن لم تتحسّن علاماتي
!فقد لا نجد مرشدًا

118
00:07:38,330 --> 00:07:40,620
ذلك ما كنت قلقة عليه؟

119
00:07:40,620 --> 00:07:44,800
...كنّا نتحدّث عن ذلك كمجرّد احتمال

120
00:07:44,800 --> 00:07:46,860
.أنا آسفة

121
00:07:47,430 --> 00:07:50,200
،لكن إن واصلت التّصرّف بغرابة هكذا

122
00:07:50,200 --> 00:07:53,240
فعلى الأرجح أنّ ذلك كان ليشتّت
.انتباهي ويؤثّر على علاماتي

123
00:07:53,700 --> 00:07:55,870
.وبصراحة، أريما-سان على حافّة الانهيار

124
00:07:55,870 --> 00:07:56,740
!أتصرّف بغرابة؟

125
00:07:57,540 --> 00:08:00,500
.عليك مواصلة التّصرّف كعادتك فحسب

126
00:08:01,360 --> 00:08:02,480
...لكنّني أريد علامات مثاليّة

127
00:08:02,480 --> 00:08:04,670
!كنتِ تنوين الحصول على علامات مثاليّة؟

128
00:08:04,670 --> 00:08:07,720
...دعي ذلك لأريما-سان

129
00:08:08,660 --> 00:08:09,930
...فهمت

130
00:08:13,840 --> 00:08:16,140
.وكأنه عبء وقد انزاح عن كاهلي

131
00:08:21,300 --> 00:08:23,020
!وداعًا أيّها التّشجيع

132
00:08:26,980 --> 00:08:29,440
.يبدو أنّ هاتويا-سان قد هدأت

133
00:08:29,440 --> 00:08:30,150
.نعم

134
00:08:30,150 --> 00:08:34,010
،لقد كانت تضغط على نفسها بالتّأكيد
.لذلك فهذا للأفضل على الأرجح

135
00:08:34,010 --> 00:08:37,320
...أريما-سان ممتازة في قراءة المشاعر

136
00:08:37,320 --> 00:08:38,620
...ولكن

137
00:08:39,320 --> 00:08:41,750
.التّوقيت سيّئ للغاية

138
00:08:42,580 --> 00:08:45,050
...الامتحانات تبدأ اليوم

139
00:08:46,710 --> 00:08:49,000
.حسنًا. هذا كلّ شيء لليوم

140
00:08:50,710 --> 00:08:53,160
!أوكي، أوكي، لنذهب بسرعة

141
00:08:53,160 --> 00:08:56,590
!سنبدأ نحن الثّلاثة نادينا أخيرًا

142
00:08:56,590 --> 00:09:00,470
.نعم. لنذهب... ونأخذ امتحاناتنا الاستدراكيّة

143
00:09:00,470 --> 00:09:02,860
!أ-أوكي

144
00:09:02,860 --> 00:09:05,560
...حظًّا سعيدًا... أنا أشجّعك

145
00:09:05,560 --> 00:09:08,980
!لكن أنا من تريد القيام بالتّشجيع

146
00:09:12,630 --> 00:09:14,160
...أستطيع أخيرًا فعل هذا

147
00:09:14,160 --> 00:09:15,150
.أحسنت عملاً

148
00:09:15,450 --> 00:09:17,790
ما الّذي سنفعله؟

149
00:09:17,790 --> 00:09:20,160
.عليك أن تمدّدي جسدك في البداية يا هاتويا-سان

150
00:09:20,530 --> 00:09:23,480
،علينا أخذ وقتنا في العمل على مرونتك

151
00:09:23,480 --> 00:09:25,840
.لكي لا تؤذي نفسك

152
00:09:25,840 --> 00:09:29,540
في تلك الأثناء، ستتدرّب ساواتاري-سان
.على وضعيّات البداية

153
00:09:29,870 --> 00:09:33,320
في البداية، ضعي يديك على خصرك
.ولتأخذ ذراعيك شكل مثلّث

154
00:09:35,920 --> 00:09:37,930
.هذه هي الوضعيّة الأساسيّة

155
00:09:38,300 --> 00:09:40,460
،وبينما نقف في هذه الوضعيّة

156
00:09:40,460 --> 00:09:42,620
استجمعي قوّتك في عضلات
...بطنك وقفي بثبات

157
00:09:47,160 --> 00:09:50,060
بالمناسبة، أعتقد أنّ كلتاكما
.ترتدي ملابس التّدريب

158
00:09:52,480 --> 00:09:54,320
!أعطتني أريما-سان هذه

159
00:09:54,680 --> 00:09:57,930
.فهمت. هذه ملابس أريما-سان إذًا

160
00:09:59,860 --> 00:10:02,650
!حسنًا! انتهيت من تمديد جسدي

161
00:10:02,650 --> 00:10:04,720
!أريد القيام بوضعيّة البداية أيضًا

162
00:10:04,720 --> 00:10:06,250
...عفوًا

163
00:10:07,600 --> 00:10:10,290
.سيستعمل فريق كرّة السّلة هذه المنطقة

164
00:10:10,730 --> 00:10:13,870
.يحصل كلّ نادٍ على منطقة خاصّة به

165
00:10:13,870 --> 00:10:15,470
في أيّ نادٍ أنتنّ؟

166
00:10:15,470 --> 00:10:17,510
...عـ-عفوًا

167
00:10:17,850 --> 00:10:20,090
!إنّنا في نادي التّشجيع... كما نأمل

168
00:10:20,090 --> 00:10:21,790
مهلاً، ماذا؟

169
00:10:21,790 --> 00:10:24,300
!إنّنا في نادي التّشجيع... كما نأمل

170
00:10:24,300 --> 00:10:26,270
هل تعتقد أنّ ذلك يساعده بالفعل؟

171
00:10:26,270 --> 00:10:27,980
.لا يهمّ. سنستعمل هذه المنطقة

172
00:10:27,980 --> 00:10:30,850
!أرجوك! اسمحي لنا باستعمال هذه المنطقة أيضًا

173
00:10:30,850 --> 00:10:33,770
!سنشجّعكنّ! هيّا يا أوكي

174
00:10:33,770 --> 00:10:35,110
!مهلاً! ستكنّ في طريقنا

175
00:10:38,480 --> 00:10:41,240
!لا نعرف إلاّ وضعيّة البداية

176
00:10:42,660 --> 00:10:45,850
...أعتقد أنّنا لم نفكّر أين سنتدرّب

177
00:10:45,850 --> 00:10:47,620
.يمكننا التّحقّق من أماكن أخرى

178
00:10:53,750 --> 00:10:55,840
.هذه المنطقة ممتلئة بنوادي الرّياضة

179
00:10:55,840 --> 00:10:59,190
أتساءل إن كنّ ستسمحن لنا
...باستعمال منطقة ما

180
00:11:00,160 --> 00:11:01,960
.سأساعدك في حملها

181
00:11:02,370 --> 00:11:03,600
من أنت؟

182
00:11:04,920 --> 00:11:08,220
أظنّ أنّ من الأفضل لنا إن لم
.يكن حولنا أشخاص

183
00:11:08,220 --> 00:11:10,020
.نعم، أوافقك الرّأي

184
00:11:10,950 --> 00:11:11,960
...هكذا

185
00:11:11,960 --> 00:11:12,970
...احرصي على مدّ جسدك

186
00:11:12,970 --> 00:11:15,320
.هذا المكان ممتلئ أيضًا

187
00:11:15,920 --> 00:11:18,070
...المكان الوحيد المتبقّي

188
00:11:23,600 --> 00:11:26,440
هذا إن كنتما لا تعارضان أن أعمل
!في هذه المنطقة فحسب

189
00:11:26,440 --> 00:11:27,450
!إنّها صغيرة

190
00:11:28,180 --> 00:11:31,900
ربّما لا نستطيع الحصول على منطقة
.للتّدريب لأنّنا لسنا ناديًا رسميًّا

191
00:11:32,580 --> 00:11:34,410
...يا للطّبقات الاجتماعيّة

192
00:11:42,070 --> 00:11:44,220
تردن مكانًا ما للقيام بنشاطات ناديكنّ؟

193
00:11:44,220 --> 00:11:47,600
هكذا إذًا، يتمّ تحديد المناطق حسب
.النّوادي الّتي أنتنّ فيها

194
00:11:47,600 --> 00:11:52,350
الـ-المعذرة... هل يمكن اعتبارنا ناديًا
رغم أنّنا ثلاثة عضوات فحسب؟

195
00:11:52,350 --> 00:11:57,150
!أعني، إنّنا ثلاثة من أصل خمسة الآن
وهذا قريب كفاية، صحيح؟

196
00:11:57,150 --> 00:12:00,380
إن أدرناها فسنصبح خمسة، صحيح يا سينسي؟

197
00:12:00,380 --> 00:12:02,610
...في الحقيقة، إن أدرنا ثلاثة فستصبح صفرًا

198
00:12:03,610 --> 00:12:05,270
...ثلاثة

199
00:12:06,620 --> 00:12:08,990
!تهانينا على كونكنّ ثلاثة

200
00:12:10,480 --> 00:12:13,040
!لماذا تتجوّلين وأنت تحملين ذلك؟

201
00:12:13,040 --> 00:12:15,130
هل هنّأتنا؟

202
00:12:15,130 --> 00:12:18,600
.بوجود ثلاثة عضوات، يمكن اعتباركنّ جمعيّة

203
00:12:21,700 --> 00:12:23,880
ما-ما هي الجمعيّة؟

204
00:12:23,880 --> 00:12:26,490
.يمكن اعتباركنّ جمعيّة إن كنتنّ ثلاثة أفراد

205
00:12:26,490 --> 00:12:28,320
،لن تحصلن على تمويل أو غرفة لناديكنّ

206
00:12:28,320 --> 00:12:30,420
.لكن ستُمنحن منطقة للقيام بنشاطاتكنّ

207
00:12:33,140 --> 00:12:35,280
!سنقوم بذلك الآن

208
00:12:35,280 --> 00:12:36,460
.أكيد

209
00:12:36,460 --> 00:12:39,400
...لنرَ... المكان المتوفّر حاليًّا

210
00:12:39,400 --> 00:12:41,320
.نودّ مكانًا في صالة الرّياضة إن أمكن

211
00:12:41,320 --> 00:12:43,700
.حسنًا، غير ممكن. مستحيل وجود متّسع هناك

212
00:12:43,700 --> 00:12:47,450
.لكن يبدو أنّ السّطح مفتوح لبضعة أيّام

213
00:12:47,800 --> 00:12:48,950
!كلاّ

214
00:12:48,950 --> 00:12:51,830
يبدو أنّ غرفة السّمعيّات والمرئيّات
.القديمة هذه شاغرة

215
00:12:51,830 --> 00:12:56,140
!هذا مذهل! إنّها شاسعة

216
00:12:56,140 --> 00:13:00,380
السّقف منخفض قليلاً، لكنّ هذا
.سيفي بالغرض لبعض الوقت

217
00:13:00,380 --> 00:13:01,790
...هذه غرفة رائعة

218
00:13:01,790 --> 00:13:03,840
لماذا لا يستعملها أيّ أحد آخر؟

219
00:13:04,630 --> 00:13:07,850
حسنًا، هذا لأنّه يمكن سماع صوت البيانو

220
00:13:07,850 --> 00:13:10,200
...من غرفة الموسيقى في الأسفل ليلاً

221
00:13:10,200 --> 00:13:11,470
!إذًا فهي غرفة بسمعة سيّئة

222
00:13:11,470 --> 00:13:14,680
!لا يمكننا، لا يمكننا، لا يمكننا
!لا، لا، لا! مستحيل

223
00:13:14,680 --> 00:13:16,140
.لا بأس يا أوكي

224
00:13:16,140 --> 00:13:18,430
!كلماتك لا تطمئن أبدًا

225
00:13:18,430 --> 00:13:20,190
.هذا غير واقعيّ أبدًا

226
00:13:20,190 --> 00:13:23,530
على الأرجح أنّ السّبب هم مدرّسون
.مناوبون يتسلّلون لها للعزف

227
00:13:23,530 --> 00:13:24,950
!وهي لا تؤمن بوجود الأشباح

228
00:13:24,950 --> 00:13:28,640
.سنكون بخير. يبدو أنّ ذلك لا يحدث إلاّ ليلاً

229
00:13:28,640 --> 00:13:30,750
!ذلك ليس المقصود

230
00:13:31,650 --> 00:13:32,700
.أوكي

231
00:13:33,030 --> 00:13:35,080
.لنذهب للسّطح إذًا

232
00:13:35,080 --> 00:13:37,460
...ماذا؟ لكن يا كوهاني

233
00:13:37,460 --> 00:13:40,190
.سأبقي عينيّ مقفلتان وأبذل جهدي

234
00:13:40,190 --> 00:13:41,960
!لا بأس بهذا المكان

235
00:13:41,960 --> 00:13:46,060
في تلك الحالة، فلتملأن هذه الاستمارات
.لجعل جمعيّتكنّ رسميّة

236
00:13:46,060 --> 00:13:48,160
.ها قد أخرجت شيئًا من العدم ثانية

237
00:13:48,160 --> 00:13:51,870
...سينسي... لقد قمت بالكثير من أجلنا

238
00:13:51,870 --> 00:13:54,360
!أريد أن أعرب عن امتناني لك

239
00:13:55,280 --> 00:13:56,850
!شكرًا جزيلاً لك

240
00:13:57,200 --> 00:13:58,100
!العفو

241
00:14:00,730 --> 00:14:17,240
،واحد، اثنان، ثلاثة، أربعة
!خمسة، ستّة، سبعة، ثمانية

242
00:14:18,360 --> 00:14:20,790
.بدأنا أخيرًا نبدو مثل مشجّعات

243
00:14:22,040 --> 00:14:25,170
.أريد أن أسرع وأشجّع أحدًا ما

244
00:14:25,500 --> 00:14:27,960
.على الأرجح أنّ عليك تشجيع نفسك أوّلاً

245
00:14:27,960 --> 00:14:29,050
!نعم، صحيح

246
00:14:29,520 --> 00:14:31,240
!ها هو ذا! اُنظرن

247
00:14:31,240 --> 00:14:33,180
!لقد صنعت ملصقًا

248
00:14:33,180 --> 00:14:37,800
،فهمت. بما أنّنا جمعيّة الآن
.يُسمح لنا بتعليق ملصقات

249
00:14:37,800 --> 00:14:39,270
.أنت تعملين بسرعة

250
00:14:39,680 --> 00:14:42,090
!سبق ووضعتها على كلّ لوحات إعلانات المدرسة

251
00:14:42,090 --> 00:14:43,290
!أنت سريعة بالفعل

252
00:14:43,290 --> 00:14:46,400
حتّى أنّني حرصت على رمي واحدة
.في غرفة الموسيقى في الأسفل أيضًا

253
00:14:46,400 --> 00:14:48,040
!كيف أمكنك ذلك؟

254
00:14:48,040 --> 00:14:51,630
!ربّما سينضمّ إلينا الشّبح أيضًا

255
00:14:51,630 --> 00:14:53,410
!ما مدى غبائك؟

256
00:14:53,410 --> 00:14:56,670
.بالفعل. لا وجود للأشباح

257
00:14:56,670 --> 00:14:57,900
!نعم، نعم

258
00:14:57,900 --> 00:15:01,950
.وحتّى إن انضمّت لنا، فلن تتناسق ركلاتنا أبدًا

259
00:15:01,950 --> 00:15:03,930
.لا تملك الأشباح أرجلاً من الأساس

260
00:15:04,840 --> 00:15:07,820
سيكون من الصّعب حمل أرجلها
.أثناء الحركات الخطرة أيضًا

261
00:15:07,820 --> 00:15:08,840
!صحيح

262
00:15:08,840 --> 00:15:09,720
تأخذين ذلك على محمل الجدّ؟

263
00:15:10,090 --> 00:15:13,350
!تلك ليست المشكلة هنا
!علينا أن نكون أكثير جدّيّة

264
00:15:13,350 --> 00:15:18,000
إن تورّطنا كثيرًا مع أشياء كهذه
!فقد تتملّكنا أيضًا

265
00:15:18,000 --> 00:15:20,580
أنت واسعة المعرفة بها بالنّظر
.إلى أنّك لا تحبّينها

266
00:15:20,580 --> 00:15:21,730
...قبل مدّة

267
00:15:22,520 --> 00:15:27,840
قمتُ ببحث عن كلّ شيء حولها
.لأعرف لماذا كنت خائفة

268
00:15:27,840 --> 00:15:32,490
،والآن، تعرف الكثير الكثير عنها
.لذلك هي خائفة أكثر

269
00:15:32,800 --> 00:15:34,720
!وبالطّبع لا يمكنني فهم الأمر بالكامل

270
00:15:34,720 --> 00:15:36,620
.كان عليّ معرفة هذا من قبل

271
00:15:36,620 --> 00:15:40,000
لكنّنا نستطيع بالفعل سماع
.البيانو من وقت لآخر

272
00:15:40,000 --> 00:15:41,000
!صحيح؟

273
00:15:41,000 --> 00:15:43,630
ناهيكما عن ذكر أنّني أشعر بوجود
.من يراقبنا من وقت لآخر

274
00:15:43,630 --> 00:15:46,880
...أقسم أنّ هنالك من يحدّق بنا الآن

275
00:15:47,280 --> 00:15:48,380
!هناك مثلاً

276
00:15:51,600 --> 00:15:52,990
.لا يوجد أحد هنا

277
00:15:52,990 --> 00:15:55,470
...أنا واثقة أنّني شعرت بوجود أحد

278
00:15:56,980 --> 00:15:57,770
...المعذرة

279
00:15:59,270 --> 00:16:01,400
.أتينا إلى هنا بسبب الملصق

280
00:16:01,400 --> 00:16:03,480
!أكيتسوني-سان! تاتيجيما-سان

281
00:16:03,860 --> 00:16:05,370
هل تعرفينهما؟

282
00:16:05,370 --> 00:16:07,290
.نعم! إنّهما في فصلي

283
00:16:07,290 --> 00:16:08,480
أليس كذلك يا أوكي؟

284
00:16:08,480 --> 00:16:10,480
...نـ-نعم

285
00:16:10,480 --> 00:16:13,320
لديهما... لديهما أرجل، صحيح؟

286
00:16:13,920 --> 00:16:16,450
توقّعت أن تكوني واحدة ممّن
.يفعلون هذا يا هاتويا-سان

287
00:16:16,450 --> 00:16:19,700
نعم! هل تحتاجان لبعض التّشجيع؟
أم تريدان أن تنضمّان لنا؟

288
00:16:20,030 --> 00:16:23,830
أريدكنّ أن تشجّعنني لأتمكّن من
!إخبار الشّخص الّذي أحبّه بمشاعري

289
00:16:23,830 --> 00:16:25,990
بـ-بمشاعرك؟

290
00:16:26,400 --> 00:16:29,630
...هذا ليس الغرض من التّشجيع

291
00:16:29,630 --> 00:16:30,510
...لكن

292
00:16:30,510 --> 00:16:33,850
!سأفعل أيّ شيء سيساعد الآخرين

293
00:16:33,850 --> 00:16:35,840
.لن أتفاجأ إن قامت هاتويا-سان بذلك

294
00:16:37,200 --> 00:16:42,230
ولكن... أنا لا أفهم ذلك النّوع
.من الحبّ كثيرًا

295
00:16:42,560 --> 00:16:45,640
،ستشجّعينني فحسب
.لهذا فذلك ليس بالأمر المهمّ

296
00:16:47,320 --> 00:16:49,000
هل طلبي فيه إزعاج ما؟

297
00:16:49,000 --> 00:16:52,540
أكان يجدر به أن يكون له
علاقة بالنّوادي؟

298
00:16:54,100 --> 00:16:56,480
!سأفعلها! سأشجّعك

299
00:16:56,480 --> 00:16:58,240
أهذه قوّة التّشجيع؟

300
00:16:58,240 --> 00:17:02,110
لكنّ التّشجيع من أجل اعتراف
لا يكون هكذا، صحيح؟

301
00:17:02,110 --> 00:17:05,250
في الحقيقة، كنت أتساءل إن كنتنّ
.تستطعن سماعي أوّلاً أيضًا

302
00:17:06,160 --> 00:17:08,260
.هكذا يبدو الأمر من ناحية التّشجيع

303
00:17:09,540 --> 00:17:11,990
..أمّا بالنّسبة للحبّ والعلاقات

304
00:17:12,720 --> 00:17:14,880
...ورغم ذلك، أرجوكنّ

305
00:17:15,160 --> 00:17:17,640
حسنًا، ما طبيعة هذا الشّخص؟

306
00:17:17,640 --> 00:17:20,810
!إنّه شخص ذكيّ! فهو مدرّسي الخاصّ قبل كلّ شيء

307
00:17:20,810 --> 00:17:22,680
.أجل، يبدو ذكيًّا

308
00:17:22,680 --> 00:17:24,240
.نعم

309
00:17:24,240 --> 00:17:25,280
"تغريد؟"

310
00:17:25,280 --> 00:17:27,060
.تغريد

311
00:17:27,060 --> 00:17:28,970
أهذا يعني أنّه أكبر منك؟

312
00:17:28,970 --> 00:17:30,690
.نعم، إنّه في السّنة الأولى من الجامعة

313
00:17:31,000 --> 00:17:32,440
.تغريد

314
00:17:32,760 --> 00:17:34,570
!إنّه شخص راشد

315
00:17:34,570 --> 00:17:36,400
.يكبرك أربع سنوات

316
00:17:36,400 --> 00:17:41,180
هذا الشّخص في الجامعة، أي أنّ لديه محاضرات
...وعملاً بدوام جزئيّ وحفلات مختلطة

317
00:17:41,180 --> 00:17:43,360
.أي أنّه يبحث عن لقاء أحد ما دائمًا

318
00:17:43,360 --> 00:17:45,100
...لا تزرعي الشّكّ فيها

319
00:17:45,100 --> 00:17:47,870
.كلاّ، أنا أقصد أخي الأكبر

320
00:17:47,870 --> 00:17:49,380
!تمالك نفسك يا أخي

321
00:17:49,930 --> 00:17:52,250
،إن لم يكن لديه شخص يعجبه سلفًا

322
00:17:52,250 --> 00:17:54,630
.فقد يكون هذا أفضل وقت للتّقرّب منه

323
00:17:54,960 --> 00:17:57,800
.يقال إنّ الجنود يشرّفون التّوفيق

324
00:17:57,800 --> 00:17:59,190
الجنود؟

325
00:17:59,570 --> 00:18:03,500
لكن أليس لديك الأفضليّة بما
أنّه مدرّسك الخاصّ

326
00:18:03,500 --> 00:18:05,040
أو بالأحرى، مدرّس خاصّ مقرّب منك؟

327
00:18:05,040 --> 00:18:07,130
ما الّذي تفعلينه في الخلف؟

328
00:18:07,130 --> 00:18:09,650
لا أدري ماذا أقول، لذلك فكّرت
.في إظهار دعمي على الأقلّ

329
00:18:10,290 --> 00:18:14,530
مهلاً، ألا يقال إنّ أسرع طريق
لقلب المرء هو معدته؟

330
00:18:14,530 --> 00:18:17,840
!فهمت! يجب تقوية قبضتك وأن تضربي

331
00:18:17,840 --> 00:18:19,320
...لم أقصد ذلك حرفيًّا

332
00:18:19,610 --> 00:18:22,280
...لقد جرّبت ذلك في الحقيقة

333
00:18:22,280 --> 00:18:24,960
لكن انتهى المطاف بالشّخص
...في السّرير في اليوم التّالي

334
00:18:24,960 --> 00:18:26,890
...قال بأنّه شعر وكأنّ معدته تتلّوى

335
00:18:26,890 --> 00:18:29,250
إذًا فقد أحكمت قبضتها على معدته
...بالفعل... حرفيًّا

336
00:18:29,250 --> 00:18:33,920
وجدتُها! لماذا لا تجرّبين إخباره بما
تشعرين باستعمال هتاف ما؟

337
00:18:33,920 --> 00:18:35,060
هتاف؟

338
00:18:36,520 --> 00:18:39,720
حسنًا، هل من أسئلة؟

339
00:18:39,720 --> 00:18:40,760
!نعم

340
00:18:41,020 --> 00:18:43,390
!أحبّك

341
00:18:43,390 --> 00:18:46,060
!كلاّ، شكرًا

342
00:18:47,870 --> 00:18:49,640
سمعتُ أنّه عندما يريد أحد
،إخبار شخص بمشاعره

343
00:18:49,640 --> 00:18:52,450
.فإنّ الوضع الّذي تكونان فيه مهمّ جدًّا

344
00:18:52,450 --> 00:18:55,730
سمعتُ أنّ الأمر قد يكون أفضل
.بين الغسق وغروب الشّمس

345
00:18:55,730 --> 00:18:58,830
!كما أنّ الأشهر الثّلاثة الأولى هي أفضل وقت

346
00:18:58,830 --> 00:19:00,590
لماذا لا تضعين نفسك في وضع حرج

347
00:19:00,590 --> 00:19:02,740
وذلك لإعطاء مجال لحدوث
تأثير الجسر المعلّق؟

348
00:19:03,720 --> 00:19:05,990
.يبدو هذا مخيفًا صادرًا منك

349
00:19:05,990 --> 00:19:09,360
!وجدتُها! عليك ارتداء زيّك المدرسيّ بكلّ تأكيد

350
00:19:09,360 --> 00:19:10,870
تقصدين كفستان لإثارة إعجابه؟

351
00:19:11,180 --> 00:19:13,900
إنّ مجرّد حقيقة كونك تلميذة ثانويّة
...تجعلك شخصًا غاليًا

352
00:19:13,900 --> 00:19:15,600
.هذا ما يقوله أخي

353
00:19:15,600 --> 00:19:18,510
.أريما-سان، لننس أمر أخيك

354
00:19:18,920 --> 00:19:22,220
.الشّيء الأهمّ من ذلك هو إخباره بمشاعرك

355
00:19:22,220 --> 00:19:24,440
!وارسمي ابتسامة على وجهك

356
00:19:24,440 --> 00:19:27,930
.ونأمل في النّهاية أن تصبحا حبيبًا وحبيبة

357
00:19:28,410 --> 00:19:30,740
...حبيب أكبر سنًّا

358
00:19:32,340 --> 00:19:34,090
...لكن

359
00:19:34,940 --> 00:19:36,690
...لقد فهمتنّ الأمر بشكل خاطئ

360
00:19:39,610 --> 00:19:42,820
...إنّ ذلك المدرّس

361
00:19:45,360 --> 00:19:47,200
...فتاة

362
00:19:56,960 --> 00:20:00,920
إذًا فمهما قاله أخو أريما-سان
.قد لا يساعدك كثيرًا

363
00:20:01,630 --> 00:20:06,260
كلاّ، لستُ واثقة كم أنّ رأيه
.سيساعد مع الرّجال أيضًا

364
00:20:06,660 --> 00:20:09,030
...المعذرة... أنا

365
00:20:10,100 --> 00:20:11,260
أأنتنّ واثقات؟

366
00:20:11,930 --> 00:20:13,850
!بالطّبع

367
00:20:13,850 --> 00:20:18,150
أعتقد أنّ حقيقة كون المرء قادرًا
!على الوقوع في حبّ أيّ أحد رائعة

368
00:20:18,600 --> 00:20:22,470
،أنا لا أفهم الحبّ والعلاقات
.لكنّني أفهم ذلك جيّدًا

369
00:20:26,150 --> 00:20:27,300
!شكرًا

370
00:20:31,810 --> 00:20:34,290
.هاتويا-سان رائعة

371
00:20:34,290 --> 00:20:39,400
.لم أستطع حتّى التّفكير فيم أقوله
.أنا بلا فائدة

372
00:20:39,400 --> 00:20:41,100
.ذلك ليس صحيحًا

373
00:20:41,100 --> 00:20:43,300
.لـ-لقد قلتُ ذلك بصوت عالٍ

374
00:20:43,300 --> 00:20:45,080
إنّ سبب عدم مقدرتك على قول أيّ شيء

375
00:20:45,080 --> 00:20:47,260
هو لأنّك تهتمّين لأمر صديقتك

376
00:20:47,880 --> 00:20:51,310
.ولم تتمكّني من قول أيّ شيء غير مهمّ

377
00:20:51,660 --> 00:20:53,700
.لكنّ ذلك يعني أنّك تفكّرين مليًّا في الأمر

378
00:20:55,860 --> 00:20:58,810
.أشعر الآن وكأنّهنّ يشجّعنني أيضًا

379
00:20:58,810 --> 00:21:01,590
مهلاً، هل قلتُ شيئًا مسلّمًا به؟

380
00:21:04,650 --> 00:21:07,200
!نجح الأمر

381
00:21:08,180 --> 00:21:09,850
!أنا سعيدة من أجلك

382
00:21:09,850 --> 00:21:12,330
!لقد نجحت طريقة أريما

383
00:21:12,330 --> 00:21:13,450
طريقة أريما؟

384
00:21:13,880 --> 00:21:19,000
لقد أخبرتها بحقيقة مشاعري
.بينما كنت مرتدية زيّي المدرسيّ

385
00:21:19,000 --> 00:21:20,210
.أنا معجبة بك

386
00:21:20,670 --> 00:21:23,900
هل يعني هذا أنّ أخي كان على حقّ؟

387
00:21:23,900 --> 00:21:25,970
...كلاّ... أو ربّما كان

388
00:21:25,970 --> 00:21:30,600
.جعلني هذا أدرك فعلاً كم أنّ التّشجيع رائع

389
00:21:30,600 --> 00:21:33,720
هـ-هل يعني هذا أنّك تريدين تجربة الأمر؟

390
00:21:33,720 --> 00:21:35,850
.حسنًا... ربّما

391
00:21:35,850 --> 00:21:38,190
!إذًا! املئي هذه الاستمارة

392
00:21:38,190 --> 00:21:41,860
ولكن، سبق وقرّرت الانضمام
.لنادي اقتصاديّات المنزل

393
00:21:41,860 --> 00:21:43,740
!سأطبخ وجبة لذيذة في المرّة القادمة

394
00:21:44,100 --> 00:21:46,750
!شكرًا على كلّ شيء

395
00:21:46,750 --> 00:21:50,640
.إن تصرّفنا في وقت أبكر، كانتا لتنضمّا

396
00:21:50,640 --> 00:21:51,980
.كان ذلك وشيكًا

397
00:21:51,980 --> 00:21:56,460
لكنّني سعيدة لأنّ أوّل تشجيع لجمعيّة
!التّشجيع قد سار على ما يرام

398
00:21:56,460 --> 00:21:57,330
.بالفعل

399
00:21:57,710 --> 00:22:00,340
...أتساءل ماذا عليّ أن أطبخ أوّلاً

400
00:23:38,850 --> 00:23:41,180
!"في الحلقة القادمة: "لنشجّع