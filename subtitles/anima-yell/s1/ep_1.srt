1
00:00:14,740 --> 00:00:16,200
!تقدّموا، تقدّموا يا فريق إنجلز

2
00:00:16,200 --> 00:00:17,490
!هيّا يا فريق إنجلز

3
00:00:17,490 --> 00:00:19,160
!تقدّموا، قاتلوا، فوزوا

4
00:00:20,580 --> 00:00:22,080
!تقدّموا، تقدّموا يا فريق إنجلز

5
00:00:22,080 --> 00:00:23,580
!هيّا يا فريق إنجلز

6
00:00:23,580 --> 00:00:25,010
!تقدّموا، قاتلوا، فوزوا

7
00:00:37,470 --> 00:00:38,850
!هيّا

8
00:01:19,870 --> 00:01:20,990
!هيّا

9
00:01:46,380 --> 00:01:51,840
بعدما رأيت أنا هاتويا كوهاني
،ذلك المنظر، فإنّ عالمي

10
00:01:53,260 --> 00:01:54,510
...في ذلك اليوم

11
00:01:54,510 --> 00:01:55,580
!تغيّر بالكامل

12
00:01:56,330 --> 00:01:57,970
!أوكي

13
00:01:58,220 --> 00:01:59,910
كـ-كوهاني؟

14
00:02:00,970 --> 00:02:03,510
!وجدتُ شيئًا أريد فعله

15
00:02:03,510 --> 00:02:04,640
...وهو يُدعى

16
00:02:04,640 --> 00:02:05,720
!"الكرسيّ"

17
00:02:06,470 --> 00:02:07,480
الكرسيّ"؟"

18
00:02:09,620 --> 00:02:12,360
.التّشجيع. أنت تقصدين التّشجيع

19
00:02:12,620 --> 00:02:15,140
!نعم! ذلك ما قلتُه بالضّبط

20
00:02:15,140 --> 00:02:16,570
.كلاّ، ليس ذلك ما قلتِه

21
00:02:16,860 --> 00:02:18,180
أليس رائعًا؟

22
00:02:18,180 --> 00:02:22,700
هنالك رياضة هدفها هو تشجيع
!ودعم الآخرين

23
00:02:22,700 --> 00:02:25,580
!كانت حركات المشجّعات متناسقة

24
00:02:25,580 --> 00:02:28,580
!لقد كنّ ظريفات ورائعات

25
00:02:28,800 --> 00:02:33,390
...فعلن هذا وهذا وهذا

26
00:02:30,730 --> 00:02:33,390
مهلاً، كنّا نتحدّث عن رقصة بون؟

27
00:02:33,390 --> 00:02:34,420
!"كلاّ، بل "الكرسيّ

28
00:02:34,750 --> 00:02:36,620
!فهمت! أحتاج لأصرخ بشيء ما

29
00:02:36,620 --> 00:02:38,970
!ذلك ما كان ينقصني

30
00:02:39,340 --> 00:02:45,410
!أو-راق سبانخ

31
00:02:43,110 --> 00:02:46,850
إن كنتِ تحاولين الظّهور كمبتدئة من الطّبقة
.العاملة تقوم برقصة بون لأوّل مرّة، فقد نجحتِ

32
00:02:47,310 --> 00:02:50,920
،لكنّني كلّما فكّرت في الأمر
.فأعتقد أنّ التّشجيع مناسب لك

33
00:02:50,920 --> 00:02:52,810
.ستكونين بذلك تدعمين الآخرين

34
00:02:53,420 --> 00:02:56,800
.أنت تُعطين الأولويّة دائمًا للآخرين قبلك

35
00:02:57,650 --> 00:03:00,430
...التّشجيع مناسب لي... لي... لي

36
00:03:00,430 --> 00:03:01,820
.إنّها لا تستمع لي

37
00:03:01,820 --> 00:03:06,310
حسنًا، إن كنتِ ستبدئين، فمن المرجّح أن يكون
.ذلك في أبريل عندما نبدأ دراستنا في الثّانويّة

38
00:03:06,310 --> 00:03:08,620
.قد يكون لهم نادي مشجّعات أيضًا

39
00:03:08,810 --> 00:03:12,320
!نادي كراسي؟! ما هذا؟
!إنّه يبدو رائعًا

40
00:03:12,320 --> 00:03:15,150
صحيح، دعينا نبدأ بتصحيح
.كيف تنطقين "تشجيع" أوّلاً

41
00:03:18,450 --> 00:03:20,740
...منذ ذلك الوقت وكوهاني

42
00:03:23,220 --> 00:03:25,730
!"بعد أسبوعين آخرين، سأكون في نادي "الكرسيّ

43
00:03:25,730 --> 00:03:27,550
!لا يمكنني الانتظار

44
00:03:29,070 --> 00:03:31,810
!فلتأتِ بسرعة يا شهر أبريل

45
00:03:32,070 --> 00:03:33,810
!سينسي

46
00:03:33,810 --> 00:03:36,320
!"أريد الانضمام لنادي "الكرسيّ

47
00:03:36,320 --> 00:03:37,710
نادي الكرسيّ؟

48
00:03:38,340 --> 00:03:40,190
.تقصدين نادي التّشجيع

49
00:03:40,660 --> 00:03:41,540
.ليس لدينا واحد

50
00:03:42,700 --> 00:03:45,490
لنرجو من سنوات التّعليم الثّلاث
القادمة في هذا المكان

51
00:03:45,490 --> 00:03:49,300
.أن تساعدكنّ لبقيّة حياتكنّ

52
00:03:49,300 --> 00:03:53,790
تلك هي أمنيتنا نحن فريق هيئة
.التّدريس من أعماق قلوبنا

53
00:03:51,380 --> 00:03:55,400
.على الأرجح أنّ هذه غلطتي... لقد حمّستها كثيرًا

54
00:03:55,790 --> 00:03:58,260
.ابتهجي يا كوهاني

55
00:03:56,430 --> 00:04:00,710
،والآن، كلمة من ممثّلة التّلميذات الجديدة
.أريما هيزومي-سان

56
00:03:58,260 --> 00:03:59,250
...نعم

57
00:04:01,300 --> 00:04:02,130
.حاضرة

58
00:04:05,310 --> 00:04:06,370
ماذا؟

59
00:04:06,370 --> 00:04:10,980
في هذا الرّبيع، أخذنا أوّل خطوة لنا في طريق جديد

60
00:04:08,110 --> 00:04:10,500
...أنا واثقة أنّني رأيتها من قبل

61
00:04:10,980 --> 00:04:12,920
.كتلميذات سنة أولى في ثانويّة كامينوكي

62
00:04:12,920 --> 00:04:14,450
!اهدئي أيّتها الفتاة

63
00:04:14,450 --> 00:04:15,730
!لقد تخطّيتِ الأمر بسرعة

64
00:04:16,380 --> 00:04:17,480
!اتّخذت قراري

65
00:04:17,740 --> 00:04:19,310
!"سأنشئ نادي  "كراسي

66
00:04:20,790 --> 00:04:23,190
!إن لم يكون موجودًا، فعليّ إنشاء واحد

67
00:04:23,190 --> 00:04:24,960
!لدينا الآن عضوة مخضرمة في مدرستنا أيضًا

68
00:04:25,500 --> 00:04:26,740
مخضرمة؟

69
00:04:27,310 --> 00:04:31,120
هل تقصدين أنّ ممثّلة التّلميذات
الجديدة مشجّعة؟

70
00:04:31,120 --> 00:04:34,630
.أنا متفاجئة لأنّك تذكّرتِ. يا لها من مصادفة

71
00:04:34,630 --> 00:04:36,500
!إنّ هذا من صنيع القدر

72
00:04:36,500 --> 00:04:38,840
!لقد بدت جميلة للغاية

73
00:04:38,840 --> 00:04:40,880
وقد كانت حركات رقصها وابتسامتها

74
00:04:40,880 --> 00:04:42,710
!متألّقة للغاية

75
00:04:43,550 --> 00:04:46,380
!لا تقلقي يا أوكي، أنت جميلة أيضًا

76
00:04:46,380 --> 00:04:47,720
!ما-ما الّذي تقولينه؟

77
00:04:48,130 --> 00:04:49,810
تعليقاتك النّاقدة ووجهك المُحرج

78
00:04:49,810 --> 00:04:51,700
!يتألّقون أيضًا

79
00:04:51,700 --> 00:04:53,680
!لا يُشعرني ذلك بتحسّن

80
00:04:54,690 --> 00:04:56,670
لكنّني ارتحت في الحقيقة

81
00:04:56,670 --> 00:05:00,440
.لأنّك وجدتِ شيئًا أنت شغوفة حياله

82
00:05:01,050 --> 00:05:04,330
.كلّ ما تفعلينه هو مساعدة الآخرين

83
00:05:05,100 --> 00:05:07,650
...وكأنّه ليس لديك أيّ شيء أردتِ القيام به

84
00:05:08,830 --> 00:05:10,750
...لـ-لذلك

85
00:05:11,450 --> 00:05:13,910
كنتُ قلقة كثيرًا... ماذا؟

86
00:05:16,750 --> 00:05:18,750
"!صياح"

87
00:05:19,340 --> 00:05:21,750
!"سينسي، سأنشئ نادي "كراسي

88
00:05:22,710 --> 00:05:25,280
.تحتاجين على الأقلّ خمسة عضوات لإنشاء نادٍ

89
00:05:26,300 --> 00:05:28,510
!أوكي، علينا العثور على عضوات

90
00:05:28,510 --> 00:05:29,980
!ثلاثة عضوات أخريات فقط

91
00:05:29,980 --> 00:05:31,640
.أنا لن أنضمّ

92
00:05:33,110 --> 00:05:35,860
!ماذا؟ لماذا؟ سيكون ممتعًا

93
00:05:35,860 --> 00:05:37,560
!الأزياء ظريفة أيضًا

94
00:05:37,560 --> 00:05:40,650
!لا تجعليني أرتدي ذلك في ذهنك
!لا يمكنني ارتداء شيء كهذا

95
00:05:40,650 --> 00:05:43,940
!لكنّك تحبّين الأشياء الظّريفة يا أوكي
.رغم أنّك تخفين ذلك

96
00:05:43,940 --> 00:05:44,780
!مهلاً

97
00:05:45,150 --> 00:05:48,340
،كلّما ظهرت نجمات مشهورات على التّلفاز
.أراك تصمتين فجأة وتبدئين المشاهدة

98
00:05:48,340 --> 00:05:51,170
!تشرد عيناك دائمًا تجاه الملابس الظّريفة

99
00:05:51,170 --> 00:05:52,190
فعلاً؟

100
00:05:52,190 --> 00:05:53,700
...لم أكن أعلم

101
00:05:53,700 --> 00:05:56,960
...كوهاني

102
00:05:55,720 --> 00:05:58,710
...أوكي؟ عيناك مخيفتان

103
00:06:01,800 --> 00:06:03,210
!كوهاني

104
00:06:10,020 --> 00:06:11,320
هل أنت بخير؟

105
00:06:13,380 --> 00:06:13,970
!شكرًا لك

106
00:06:20,750 --> 00:06:21,900
!أنت فتاة الكرسيّ

107
00:06:22,550 --> 00:06:24,900
...كلاّ، أخشى أنّني لست كرسيًّا

108
00:06:24,900 --> 00:06:27,600
!أنا آسفة يا كوهاني! أنا سعيدة لأنّك بخير

109
00:06:27,600 --> 00:06:28,900
!انتظري

110
00:06:30,180 --> 00:06:32,360
!شكرًا لإنقاذك لي

111
00:06:32,360 --> 00:06:37,050
،لا مشكلة. أنت خفيفة كالرّيشة
.لذلك لم يكن ذلك متعبًا

112
00:06:37,050 --> 00:06:38,910
!لا بدّ أنّك قويّة

113
00:06:39,380 --> 00:06:41,210
...نعم، أظنّ ذلك

114
00:06:43,280 --> 00:06:46,140
أخبريني، أنت أريما-سان، صحيح؟

115
00:06:46,830 --> 00:06:48,800
هل تقابلنا من قبل؟

116
00:06:49,060 --> 00:06:53,620
"نعم! لقد رأيتك صدفة تقومين بـ"الكرسيّ
.قبل مدّة على ضفّة النّهر

117
00:06:53,620 --> 00:06:54,490
...أنا لا

118
00:06:55,730 --> 00:06:57,670
.أنا واثقة تمامًا أنّني لم أكن كرسيًّا من قبل

119
00:06:57,670 --> 00:07:00,310
!أنا واثقة أنّك اكتشفتِ الأمر
.إنّها تقصد التّشجيع، لا الكرسيّ

120
00:07:00,720 --> 00:07:01,860
...أخبريني يا أريما-سان

121
00:07:01,860 --> 00:07:02,520
—لنقم بالكرسيّ

122
00:07:02,520 --> 00:07:03,630
.الكلمة هي تشجيع

123
00:07:03,630 --> 00:07:05,330
—لنقم بالتّشجيع معًا! أنا أحاول أن

124
00:07:05,330 --> 00:07:06,320
.لن أفعل

125
00:07:13,460 --> 00:07:16,170
.أنا لم أعد أقوم بالتّشجيع

126
00:07:17,590 --> 00:07:20,340
.أنا لم أعد أقوم بالتّشجيع
(تشيا وا موو شينايديسو)

127
00:07:22,160 --> 00:07:24,130
التّشجيع هو أفضل شيء على الإطلاق؟
تشيا وا موشيبون ناي ديسو)؟)

128
00:07:24,130 --> 00:07:25,710
!أنت تبالغين كثيرًا

129
00:07:27,250 --> 00:07:31,130
لا أصدّق أنّ ثمّة هنا من يعرف
...أنّني كنت أقوم بالتّشجيع

130
00:07:31,130 --> 00:07:32,350
.كان ذلك مفاجئًا

131
00:07:33,560 --> 00:07:37,270
...ما كان أحد لفكّر في العادة

132
00:07:33,970 --> 00:07:35,890
....قليلاً فحسب

133
00:07:38,370 --> 00:07:39,580
!من الأسفل، للأعلى

134
00:07:41,440 --> 00:07:43,450
.أنّني مشجّعة في وقت فراغي

135
00:07:42,130 --> 00:07:44,300
شـ-شكرًا؟

136
00:07:48,930 --> 00:07:50,410
...وجدتُها أخيرًا

137
00:07:51,420 --> 00:07:53,420
!رفضني الجميع

138
00:07:53,420 --> 00:07:57,080
!أ-أنا لا أستطيع أن أكون مشجّعة فحسب
!لم أقم برفضك في الحقيقة

139
00:07:58,220 --> 00:07:59,330
...لكن

140
00:08:00,310 --> 00:08:02,440
...بدت كما لو أنّها تتألم عندما سألتها

141
00:08:06,330 --> 00:08:08,810
!يبدو أنّ لديّ المشجّعة رقم واحد

142
00:08:08,810 --> 00:08:10,090
ماذا؟ أين؟

143
00:08:15,160 --> 00:08:17,100
...عـ-عفوًا

144
00:08:17,290 --> 00:08:21,080
.أنا تاتجيما... كوتتسو

145
00:08:21,590 --> 00:08:23,870
.مادّتي المفّضلة هي التّربية الموسيقيّة

146
00:08:23,870 --> 00:08:25,510
.وأقلّ مادّة أحبّها هي التّربية الرّياضيّة

147
00:08:25,510 --> 00:08:29,520
التّعريف عن النّفس! قد تكون هذه
!الفرصة المناسبة للتّرويج لنادي المشجّعات

148
00:08:30,150 --> 00:08:31,940
.حسنًا، التّالية

149
00:08:32,100 --> 00:08:32,700
!حاضرة

150
00:08:32,700 --> 00:08:35,990
أنا هاتويا كوهاني! سوف أقوم
!بإنشاء نادٍ للتّشجيع

151
00:08:35,990 --> 00:08:38,200
.ماذا؟ ذلك يبدو رائعًا

152
00:08:38,200 --> 00:08:39,860
.يبدو التّشجيع ممتعًا

153
00:08:39,860 --> 00:08:41,200
.حسنًا، التّالية

154
00:08:41,390 --> 00:08:42,080
!حاضرة

155
00:08:42,270 --> 00:08:44,030
!أنا هاتويا كوهاني

156
00:08:44,030 --> 00:08:45,010
ماذا؟

157
00:08:45,010 --> 00:08:45,930
!أنا في نادي التّشجيع

158
00:08:45,930 --> 00:08:47,290
!لا يجب عليك القيام بالأمر هكذا

159
00:08:47,610 --> 00:08:49,750
هل ستقابلين تلك الفتاة ثانية؟

160
00:08:49,750 --> 00:08:51,460
!نعم! سأقوم بزيارتها للمرّة المائة

161
00:08:51,460 --> 00:08:53,300
...يُقال ذلك للأضرحة في العادة

162
00:08:53,590 --> 00:08:55,450
!يا أريما-سان

163
00:08:58,040 --> 00:08:59,990
.ربّما تتجاهلك

164
00:08:59,990 --> 00:09:02,020
!ماذا؟ لماذا؟

165
00:09:02,370 --> 00:09:05,330
.ربّما تتصرّف بحذر لأنّها لا تعرفك جيّدًا

166
00:09:05,850 --> 00:09:06,810
...في تلك الحالة

167
00:09:07,060 --> 00:09:10,220
!أحتاج إذًا لأن تتعرّف عليّ أوّلاً

168
00:09:16,840 --> 00:09:18,240
!علّقتها على لوحة الإعلانات؟

169
00:09:18,890 --> 00:09:21,830
.لم تكن لي، لذلك ظننت أنّها انتهت عندي بالخطأ

170
00:09:21,830 --> 00:09:22,800
.تفضّلي

171
00:09:22,800 --> 00:09:26,570
!كلاّ! أريد أن تتعرّفي إليّ

172
00:09:26,570 --> 00:09:27,580
!خذي

173
00:09:28,660 --> 00:09:31,540
.هاتويا كوهاني. عمري 15 سنة

174
00:09:31,540 --> 00:09:33,610
...إليك ثلاث مقاسات من الأعلى إلى

175
00:09:34,530 --> 00:09:36,090
!ما الّذي كتبتِه؟

176
00:09:36,770 --> 00:09:40,450
كادت مقاسات كوهاني الثّلاثة
!أن تُنشر ليراها العالم بأسره

177
00:09:41,160 --> 00:09:43,080
ماذا تقصدين بـ"أوّلاً"؟

178
00:09:43,080 --> 00:09:47,100
طبعًا سأقوم بدعوتك في النّهاية
!للانضمام لنادي المشجّعات

179
00:09:47,490 --> 00:09:50,270
.واثقة أنّني أخبرتك أنّني ما عدت أقوم بالتّشجيع

180
00:09:54,890 --> 00:09:56,660
.تبدو مثابرة

181
00:10:01,660 --> 00:10:03,490
!أريما-سان، أبليتِ حسنًا اليوم

182
00:10:03,890 --> 00:10:05,620
!أريما-سان، لنتغدّى معًا

183
00:10:06,220 --> 00:10:08,870
أريما-سان، لنذهل للمنزل معًا— ماذا؟

184
00:10:08,870 --> 00:10:10,060
.إنّها ليست هنا

185
00:10:11,520 --> 00:10:13,670
!قومي بشيء ما حيالها! أنت المسؤولة عنها

186
00:10:13,670 --> 00:10:16,510
...حسنًا... إنّها لا تصغي، لذا

187
00:10:16,510 --> 00:10:18,430
!ها أنت هناك يا أريما-سان

188
00:10:19,550 --> 00:10:20,890
...لقد وجدتِني

189
00:10:23,320 --> 00:10:24,470
ما الخطب؟

190
00:10:24,470 --> 00:10:26,310
...ماذا؟ لا -لا شيء

191
00:10:27,080 --> 00:10:28,310
...ما من خطب أبدًا

192
00:10:28,990 --> 00:10:33,320
...رغم أنّني قد أكون خائفة من المرتفعات قليلاً

193
00:10:33,740 --> 00:10:34,850
.أو ما شابه

194
00:10:35,290 --> 00:10:36,610
المرتفعات؟

195
00:10:36,900 --> 00:10:38,620
.لكنّنا في الطّابق الثّاني فحسب

196
00:10:40,640 --> 00:10:43,590
.هذا أقصى ما يمكنني فعله بصراحة

197
00:10:43,590 --> 00:10:46,250
...ومع ذلك تريدين أن تصبحي مشجّعة

198
00:10:46,950 --> 00:10:50,240
إنّ المشجّعات لا يقمن بمجموعة تقنيات
،تُسمّى "الحركات الخطرة" فحسب

199
00:10:50,590 --> 00:10:53,870
بل يتضمّن أداؤهنّ القيام بشقلبات
.عالية في الهواء

200
00:10:54,460 --> 00:10:56,990
...مرتفعة... في الهواء

201
00:10:56,990 --> 00:10:59,010
!تتصرّف وكأنّها سمعت قصّة مخيفة

202
00:10:59,010 --> 00:11:03,300
هل هنالك حركات خطرة للأشخاص
الّذين يخافون المرتفعات؟

203
00:11:03,300 --> 00:11:04,950
.لا يمكنني القول إنّني سمعت بأيّ منها

204
00:11:05,500 --> 00:11:08,240
.لديّ ما أفعله لذلك سأذهب

205
00:11:08,240 --> 00:11:08,890
ماذا؟

206
00:11:09,160 --> 00:11:11,280
.ابذلا جهدكما. إلى اللّقاء

207
00:11:14,110 --> 00:11:16,020
!يا أريما-سان

208
00:11:16,020 --> 00:11:17,900
!كفّي عن ملاحقتي رجاءً

209
00:11:18,370 --> 00:11:21,490
،لا يهمّ كم مرّة ستسألينني فيها
—لم أعد أقوم بالتّشجيع

210
00:11:21,750 --> 00:11:24,000
...آسفة بشأن هذا

211
00:11:25,900 --> 00:11:27,800
...إنّك بالفعل

212
00:11:29,690 --> 00:11:33,160
ستكونين لطيفة إن لم تنحرفي عن طريقيك
...وتتبعين النّاس رغم رفضهم لذلك

213
00:11:33,160 --> 00:11:34,770
أنحرف؟

214
00:11:34,770 --> 00:11:38,010
هل أنت منحرفة يا آنسة؟

215
00:11:40,670 --> 00:11:43,890
لماذا تريدين القيام بالتّشجيع مع بهذه الدّرجة؟

216
00:11:44,110 --> 00:11:48,010
ماذا؟ تريدين أن تسمعي كيف
وقعت في حبّ التّشجيع؟

217
00:11:49,370 --> 00:11:53,600
.إنّني... أحبّ مساعدة الآخرين

218
00:11:53,840 --> 00:11:57,380
وبسبب ذلك، فأنا أعطي الأولويّة
.للآخرين دائمًا بدلاً منّي

219
00:11:57,790 --> 00:12:00,200
...وبعد ذلك، أبدت أوكي قلقها عليّ وقالت

220
00:12:00,200 --> 00:12:03,160
لماذا لا تقومين بشيء من أجلك أحيانًا يا كوهاني؟

221
00:12:03,160 --> 00:12:06,490
وبعدها أجد نفسي عالقة في أماكن عالية

222
00:12:06,490 --> 00:12:08,260
أو أصاب بكدمات وخدوش على كامل جسدي

223
00:12:08,260 --> 00:12:10,210
.وأتسبّب بالكثير من المشاكل

224
00:12:11,280 --> 00:12:15,480
لماذا لا تقومين بشيء من أجلك أحيانًا يا كوهاني؟

225
00:12:16,510 --> 00:12:19,630
!وحينها اكتشفت التّشجيع

226
00:12:19,630 --> 00:12:23,630
رياضة رائعة يمكننا من خلالها دعم
!النّاس عن طريق تشجيعهم

227
00:12:24,080 --> 00:12:27,570
أنت السّبب الّذي دفعني لأبدأ
!التّشجيع يا أريما-سان

228
00:12:27,570 --> 00:12:29,700
أ-أنا؟

229
00:12:30,660 --> 00:12:33,140
!ابتسمتِ وكأنّك تستمتعين بوقتك كثيرًا

230
00:12:33,360 --> 00:12:36,150
!حركات رقصك وقفزاتك كانت متناسقة ورائعة

231
00:12:36,400 --> 00:12:39,160
!لكنّ الأهمّ من ذلك، كانت وقفتك مثاليّة

232
00:12:38,090 --> 00:12:40,150
هل تحاول الثّناء عليّ حتّى الموت؟

233
00:12:40,460 --> 00:12:45,340
لذلك إن كان ثمّة سبب يمنعك من
...التّشجيع رغم رغبتك في ذلك

234
00:12:46,960 --> 00:12:51,170
.إن كان ثمّة شيء يزعجك، فأريد أن أساعدك

235
00:13:02,160 --> 00:13:03,280
—أنا

236
00:13:02,630 --> 00:13:06,180
!لأنّك مميّزة في نظري يا أريما-سان

237
00:13:11,870 --> 00:13:14,560
...لا يوجد ما يزعجني

238
00:13:14,560 --> 00:13:15,060
—أريما-سا

239
00:13:15,060 --> 00:13:16,610
.ولن أقوم بالتّشجيع

240
00:13:16,610 --> 00:13:20,450
وكيف تنوين أن تصبحي مشجّعة
بينما تخافين المرتفعات؟

241
00:13:22,080 --> 00:13:24,220
!أنا واثقة أنّ هذه مجرّد لعبة في نظرك

242
00:13:24,220 --> 00:13:27,320
!هذه إهانة لي وللتّشجيع

243
00:13:28,380 --> 00:13:31,250
...أنت

244
00:13:32,100 --> 00:13:33,740
!فاعلة خير جاهلة

245
00:13:36,530 --> 00:13:39,840
هـ-هل كانت تلك إهانة؟

246
00:13:45,390 --> 00:13:46,590
...فهمت

247
00:13:46,790 --> 00:13:48,580
.لقد أغضبتِها إذًا

248
00:13:48,890 --> 00:13:49,820
...نعم

249
00:13:51,640 --> 00:13:55,480
لقد تحدّث مع فتاة ارتادت نفس
...الإعداديّة مع أريما-سان، لكن

250
00:13:56,980 --> 00:13:58,600
!أوكي

251
00:13:58,600 --> 00:14:00,730
!كـ-كان ذلك بمحض الصّدفة

252
00:14:01,930 --> 00:14:06,950
كانت أريما-سان عضوة في فريق التّشجيع المحليّ

253
00:14:06,950 --> 00:14:10,740
.وواصلت تحسّنها

254
00:14:11,290 --> 00:14:15,370
لكن يبدو أنّ بقيّة الفتيات في فريقها
.لم يستطعن مجاراتها

255
00:14:16,690 --> 00:14:21,390
لذلك قامت أريما-سان بالانسحاب
،من الفريق في النّهاية

256
00:14:21,390 --> 00:14:24,630
.لكن كان الأمر أشبه بأنّها أرغمت على ذلك

257
00:14:25,750 --> 00:14:28,550
!زميلاتها لئيمات للغاية

258
00:14:30,550 --> 00:14:31,640
!حسنًا

259
00:14:32,130 --> 00:14:34,110
!سأبدأ التّدريب في الحال

260
00:14:34,110 --> 00:14:36,140
!مهلاً، كيف خرجتِ بذلك الاستنتاج

261
00:14:39,730 --> 00:14:43,080
...واثقة أنّها لم تكن تحاول السّخرية منّي

262
00:14:45,120 --> 00:14:49,080
!لأنّك مميّزة في نظري يا أريما-سان

263
00:14:50,750 --> 00:14:53,880
...لقد غضبتُ ونفّست عن غضبي عليها

264
00:14:54,750 --> 00:14:56,450
!فاعلة خير جاهلة

265
00:14:58,560 --> 00:15:01,360
...أنا محرجة كثيرًا بسبب تصرّفاتي

266
00:15:03,960 --> 00:15:06,700
.أتمنّى ألاّ تواصل اللّحاق بي غدًا

267
00:15:08,440 --> 00:15:09,380
!صباح الخير

268
00:15:10,290 --> 00:15:12,890
بدت جريئة لحدّ ما

269
00:15:12,890 --> 00:15:14,440
.لكنّني لم أرها في الجوار هذا الصّباح

270
00:15:15,630 --> 00:15:18,390
...ربّما أدركت أخيرًا الغرابة الّتي

271
00:15:18,640 --> 00:15:19,600
!أو ربّما لا

272
00:15:21,780 --> 00:15:24,440
ما الّذي تحاول فعله؟

273
00:15:24,440 --> 00:15:28,560
ما كانت لتتحدّث إليّ بالفعل
...كأنّ شيئًا لم يحدث

274
00:15:35,700 --> 00:15:38,410
!هل أتعرّض للّعن في الوقت الحاليّ؟

275
00:15:39,430 --> 00:15:40,410
!مرحبًا

276
00:15:40,700 --> 00:15:42,030
أين كنتِ؟

277
00:15:42,030 --> 00:15:45,420
!ذهبت لرؤية أريما-سان
لقد بدت محبطة البارحة

278
00:15:45,420 --> 00:15:47,830
...لذلك... كنت أرسل لها مشاعر

279
00:15:48,540 --> 00:15:49,820
!بل أشجّعها

280
00:15:49,820 --> 00:15:51,430
.لقد صحّحتِ نفسك بصوت عالٍ للتّوّ

281
00:15:51,720 --> 00:15:53,320
."لنرَ هذا "التّشجيع

282
00:15:56,310 --> 00:15:58,270
...ربّما تكون هذه رقصة لطقوس معيّنة

283
00:16:02,520 --> 00:16:05,870
ما الّذي ستفعلينه بشأن التّدريب؟

284
00:16:05,870 --> 00:16:09,880
في الوقت الحاليّ، أريد أن أعتاد التّواجد
.في أماكن مرتفعة ولو قليلاً

285
00:16:09,880 --> 00:16:11,700
...أماكن مرتفعة

286
00:16:12,520 --> 00:16:14,660
على سطح ما أو في دولاب الملاهي الهوائيّ مثلاً؟

287
00:16:14,660 --> 00:16:16,650
...أو ربّما القفز على الحبل

288
00:16:16,650 --> 00:16:18,200
هل تفاديت قول القفز بالحبل؟

289
00:16:19,100 --> 00:16:21,210
...في حالتك إذًا

290
00:16:21,650 --> 00:16:23,620
لماذا لا نبدأ بهذا؟

291
00:16:24,140 --> 00:16:25,630
!حسنًا

292
00:16:26,470 --> 00:16:28,130
.كفّي عن التّقليل من ارتفاعه

293
00:16:28,420 --> 00:16:31,380
!حسنًا، لنقم بهذا

294
00:16:33,230 --> 00:16:35,210
!قفي! هيّا

295
00:16:35,210 --> 00:16:36,390
!حسنًا، توقّفي

296
00:16:36,810 --> 00:16:38,260
!سأموت

297
00:16:39,930 --> 00:16:44,160
لقد اختفت بالكامل في هذه
...الأيّام القليلة الماضية

298
00:16:44,160 --> 00:16:48,050
لقد أخرجت هاتويا-سان بعض المال
.الّذي أسقطته بالخطأ في إحدى الفجوات

299
00:16:48,050 --> 00:16:50,530
نعم، تقصدين الفتاة الّتي كانت تحاول
التّرويج لنادي التّشجيع؟

300
00:16:50,530 --> 00:16:51,650
.نعم، نعم

301
00:16:52,230 --> 00:16:54,660
...هنالك فتاة ساعدتنا على حمل القمامة

302
00:16:54,840 --> 00:16:57,660
.نعم! إنّها تساعد الجميع

303
00:16:58,250 --> 00:17:01,660
.لا يمكنني رؤيتها، لكنّني أشعر بتواجدها

304
00:17:03,440 --> 00:17:05,210
!مـ-مرحبًا

305
00:17:06,210 --> 00:17:08,670
...إ-إن هذا

306
00:17:08,670 --> 00:17:11,220
!لديّ عادة سيّئة بنقر قدميّ على الأرض

307
00:17:11,220 --> 00:17:13,170
!كوهاني، هذا مبالغ فيه

308
00:17:14,620 --> 00:17:16,180
.على الأرجح أنّ عليك الكفّ عن ذلك

309
00:17:16,510 --> 00:17:17,630
لقد صدّقتك؟

310
00:17:23,010 --> 00:17:26,190
هل بدأتا التّشجيع بمفردهما؟

311
00:17:28,520 --> 00:17:30,800
...رغم أنّها لم تنفكّ عن دعوتي في السّابق

312
00:17:32,690 --> 00:17:35,300
!كلاّ! ماذا قلتُ للتّوّ؟

313
00:17:37,960 --> 00:17:42,200
،لقد نفّست عن غضبي عليها
فماذا يمكنني أن أتوقّع؟

314
00:17:46,470 --> 00:17:47,630
!تشجّعي

315
00:17:47,630 --> 00:17:49,460
!هيّا

316
00:17:50,690 --> 00:17:52,210
،يا أريما-سان

317
00:17:52,680 --> 00:17:55,840
ربّما تعتقدين بأنّك مميّزة
،لأنّك موهوبة للغاية أو ما شابه

318
00:17:55,840 --> 00:17:58,220
.لكن جميعنا متساويات هنا

319
00:17:58,630 --> 00:18:01,800
.عليك النّزول إلى مستوانا

320
00:18:03,410 --> 00:18:05,230
.أنا أرفض

321
00:18:05,720 --> 00:18:08,210
.إذًا يمكنك القيام بما يحلو لك وحدك

322
00:18:14,510 --> 00:18:19,440
...في النّهاية، سواء قمت بالتّشجيع أم لا

323
00:18:21,490 --> 00:18:24,180
.ينتهي بي المطاف وحدي

324
00:18:28,000 --> 00:18:32,880
!مرحى، مرحى يا هيزومي

325
00:18:33,220 --> 00:18:37,390
!تشجّعي، تشجّعي يا هيزومي

326
00:18:39,290 --> 00:18:42,710
!لن أتركك وحدك يا أريما-سان

327
00:18:43,550 --> 00:18:46,890
!سوف أتبعك مهما كلّف الأمر

328
00:18:47,530 --> 00:18:50,690
!لذلك دعينا نقوم بالتّشجيع معًا

329
00:18:52,060 --> 00:18:55,400
رغم أنّني قد أكون خائفة
.من المرتفعات قليلاً... أو ما شابه

330
00:18:55,810 --> 00:18:57,940
!لنبذل جهدنا معًا

331
00:18:58,920 --> 00:19:02,280
أنا متوتّرة للغاية من أجلها لدرجة
!أنّني لا أفهم ماذا يحدث الآن

332
00:19:02,280 --> 00:19:04,500
...إن كنتِ مميّزة يا أريما-سان

333
00:19:06,640 --> 00:19:09,920
!سأبذل جهدي لأصبح مميّزة أيضًا

334
00:19:24,670 --> 00:19:27,760
!سأعمل بجدّ أيضًا

335
00:19:29,970 --> 00:19:32,360
!عـ-على الحركات الخطرة

336
00:19:32,970 --> 00:19:35,320
الحركات الخطرة؟ هل تقصد ذلك
النّوع من الحركات بالفعل؟

337
00:19:46,210 --> 00:19:48,110
..لـ-لذا

338
00:19:49,110 --> 00:19:51,330
...كيف كان أوّل تشجيع لي

339
00:19:51,330 --> 00:19:53,330
!غبيّة

340
00:19:53,330 --> 00:19:55,780
!لماذا قد تغلقين عينيك ثمّ تقفزين؟

341
00:19:55,780 --> 00:19:58,820
!ناهيك عن ذكر أنّ ذلك كان تشجيعًا خاطئًا

342
00:19:58,820 --> 00:20:01,090
ما الّذي تحاولين فعله؟

343
00:20:01,090 --> 00:20:04,970
أتسمّين ذلك تشجيعًا؟!كلّ ما فعلتِ
!هو الصّراخ والقفز من شجرة

344
00:20:04,970 --> 00:20:09,420
لقد أجهزت عليّ بقساوتها المفرطة
...وكلماتها الجارحة

345
00:20:10,330 --> 00:20:13,490
.لكنّك أمسكتِ بي يا أريما-سان

346
00:20:15,210 --> 00:20:17,950
أوا واثقة أنّ بإمكاننا بدء التّشجيع فقط

347
00:20:17,950 --> 00:20:19,820
.عندما نثق بمن حولنا

348
00:20:21,890 --> 00:20:25,220
كنتُ قادرة على القفز
.لأنّني وثقت بك يا أريما-سان

349
00:20:30,360 --> 00:20:31,370
...لذلك

350
00:20:32,070 --> 00:20:33,790
.ثقي بي يا أريما-سان

351
00:20:37,420 --> 00:20:38,880
.لا تقلّلي من شأني هكذا رجاءً

352
00:20:39,310 --> 00:20:42,570
...لقد واصلت النّيل منّي حتّى بعد سقوطي

353
00:20:42,570 --> 00:20:46,390
.إنّ دعمي كقاعدة كان يُعتبر قاعدة منيعة

354
00:20:47,190 --> 00:20:50,640
.أمّا دعمك أنت فسيكون سهلاً

355
00:20:54,620 --> 00:20:56,340
!أريما-سان

356
00:21:00,940 --> 00:21:03,790
ماذا؟ ماذا حدث لقاعدتك المنيعة؟

357
00:21:03,790 --> 00:21:07,010
لا توجد حركات خطرة تتضمّن عرقلة
!زميلتك من الجانب

358
00:21:09,300 --> 00:21:11,410
.أحتاج منك أن تعلّميني أمورًا كهذه

359
00:21:12,120 --> 00:21:14,420
!أتطلّع قُدمًا للعمل معك

360
00:21:16,300 --> 00:21:16,950
.أنا أيضًا

361
00:21:21,920 --> 00:21:23,920
.بما أنّك قلتِ إنّك ستتبعيني

362
00:21:24,200 --> 00:21:28,520
.سأحرص على أن تتعلّمي كلّ شيء
.نعم، كلّ شيء

363
00:21:28,960 --> 00:21:30,930
...لديّ إحساس بأنّ هذا سيكون صعبًا

364
00:21:31,190 --> 00:21:35,270
أجل! نحتاج لثلاثة عضوات أخريات
!فقط لنادي التّشجيع

365
00:21:35,270 --> 00:21:36,800
!مرحى

366
00:21:36,800 --> 00:21:38,460
ألا تقصدين اثنتان؟

367
00:21:37,380 --> 00:21:39,410
!نجحنا

368
00:21:38,460 --> 00:21:42,100
.ماذا عن أوكي-سان؟ بدت حسّاسة إلى حدّ ما

369
00:21:42,100 --> 00:21:44,950
...ماذا؟ إنّ أوكي

370
00:21:45,210 --> 00:21:48,420
...إنّها مرشّحة بكلّ تأكيد
وأنا أحاول إقناعها بالانضمام؟

371
00:21:48,950 --> 00:21:51,400
.عليّ أن أعيد النّظر في عرضي

372
00:21:52,320 --> 00:21:55,080
!أريما-سان

373
00:23:27,530 --> 00:23:30,430
لقد نجحت يا أوكي! قالت أريما-سان
!إنّها ستقوم بالتّشجيع معي

374
00:23:30,430 --> 00:23:31,400
!أحسنت

375
00:23:31,400 --> 00:23:32,490
!عليك الانضمام أيضًا يا أوكي

376
00:23:32,490 --> 00:23:33,800
.أخبرتك أنّني لن أنضمّ

377
00:23:34,080 --> 00:23:37,790
:"في الحلقة الثّانية من "أنيما يل
."ظريفة ورائعة"

378
00:23:37,790 --> 00:23:39,940
!هيّا جميعًا! تقدّموا، فو، وو

379
00:23:39,940 --> 00:23:41,230
وو ماذا؟