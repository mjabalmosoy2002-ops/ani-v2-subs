1
00:00:02,710 --> 00:00:07,520
!سنبدأ الآن بطولة التّشجيع العالميّة للثّانويّات

2
00:00:07,840 --> 00:00:12,060
سيكون عرضنا الأوّل من نادي
!التّشجيع في ثانويّة كامينوكي

3
00:00:46,840 --> 00:00:48,550
!نجحنا

4
00:00:58,740 --> 00:00:59,880
!كوهاني؟

5
00:00:59,880 --> 00:01:03,000
هاتويا كوهاني، سوف تضطرّين
.للوقوف لبقيّة الحصّة

6
00:01:03,750 --> 00:01:04,750
منافسة؟

7
00:01:05,050 --> 00:01:09,470
نعم! منافسة كرسيّ... أقصد منافسة
.التّشجيع الّتي عرضت على التّلفاز

8
00:01:09,470 --> 00:01:12,130
لقد سجّلتُها وشاهدتها وانتهى بها
.المطاف في أحلامي

9
00:01:12,130 --> 00:01:14,190
يقيمون منافسات؟

10
00:01:14,190 --> 00:01:15,820
!كنتِ في المنافسة أيضًا يا أوكي

11
00:01:15,820 --> 00:01:16,630
كان حلمًا، صحيح؟

12
00:01:17,330 --> 00:01:20,250
!كان زيّك ظريفًا جدًّا يا أوكي

13
00:01:20,250 --> 00:01:21,220
—ما

14
00:01:21,640 --> 00:01:23,500
!عليك التّشجيع معي يا أوكي

15
00:01:23,500 --> 00:01:25,980
!أخبرتك أنّني لن أفعل

16
00:03:01,140 --> 00:03:03,990
.كوهاني! كنتِ هنا إذًا

17
00:03:04,610 --> 00:03:05,960
!أوكي

18
00:03:07,240 --> 00:03:10,480
،صديقة طفولتي هاتويا كوهاني

19
00:03:10,480 --> 00:03:12,410
.تتعرّض للإصابات كثيرًا

20
00:03:13,750 --> 00:03:16,590
يا إلهي، أُصبتِ ثانية؟

21
00:03:16,590 --> 00:03:19,270
.سندخل الثّانويّة في العام القادم

22
00:03:19,270 --> 00:03:20,130
...هذا مؤلم

23
00:03:21,280 --> 00:03:23,280
ماذا حدث اليوم؟

24
00:03:23,280 --> 00:03:24,470
...في الحقيقة

25
00:03:25,600 --> 00:03:28,690
إنّها تتعرّض للإصابات في العادة
.لأنّها تساعد الآخرين

26
00:03:28,690 --> 00:03:30,750
،عندما ترى شخصًا ما في مشكلة

27
00:03:30,750 --> 00:03:33,610
.تنطلق راكضة دون تفكير حتّى في نفسها

28
00:03:34,560 --> 00:03:38,560
،يبدو أنّ الكرة كانت مهمّة جدًّا لها
.كانت سعيدة للغاية باستعادتها

29
00:03:38,560 --> 00:03:39,650
!أسعدني ذلك

30
00:03:40,120 --> 00:03:42,840
.ذلك لا يسعدني أنا

31
00:03:44,040 --> 00:03:46,590
.أعني... لقد أُصبتِ بسببها يا كوهاني

32
00:03:46,590 --> 00:03:49,620
.لا تقلقي! الأمر ليس سيّئًا كما يبدو

33
00:03:49,620 --> 00:03:51,870
!هذا ليس القصد هنا

34
00:03:51,870 --> 00:03:54,250
!لا أريدك أن تتعرّضي للأذى على الإطلاق

35
00:03:54,250 --> 00:03:56,300
!حسنًا، سأكون أكثر حذرًا

36
00:03:56,300 --> 00:03:59,000
!إنّها لا تفهم الأمر بتاتًا

37
00:03:59,650 --> 00:04:02,880
،بمجرّد أن يتواجد من هو بحاجة إلى مساعدة

38
00:04:03,240 --> 00:04:06,940
ستذهب راكضة ثانية
.وتنسى كلّ شيء قلتُه الآن

39
00:04:09,340 --> 00:04:13,200
لهذا السّبب عندما أخبرتني كوهاني
،بأنّها وجدت شيئًا أرادت القيام به

40
00:04:13,200 --> 00:04:14,650
.أسعدني ذلك كثيرًا

41
00:04:15,460 --> 00:04:19,150
أتمنّى أن تعطي الأولويّة لنفسها من حين لآخر

42
00:04:19,520 --> 00:04:22,280
.وتهدأ كأيّ تلميذة ثانويّة أخرى

43
00:04:25,200 --> 00:04:26,520
كوهاني؟

44
00:04:26,520 --> 00:04:29,290
ماذا هنالك؟ لماذا دعوتني إلى هنا؟

45
00:04:31,870 --> 00:04:33,510
!شاهدي

46
00:04:37,150 --> 00:04:38,920
!لم تهدأ أبدًا

47
00:04:44,380 --> 00:04:48,480
انضمّت أريما-سان إليّ، لذلك يمكننا
!أن نبدأ التّدريب أخيرًا

48
00:04:48,480 --> 00:04:50,600
.سبق وأخبرتني ذلك البارحة

49
00:04:50,890 --> 00:04:52,720
!أعلميني إن احتجتِ لأيّ شيء يا أوكي

50
00:04:52,720 --> 00:04:53,980
!سأشجّعك

51
00:04:53,980 --> 00:04:54,850
.نعم، نعم

52
00:04:57,190 --> 00:04:58,280
...لحظة

53
00:04:58,280 --> 00:05:00,250
!تشجّعي، تشجّعي يا أوكي

54
00:05:00,250 --> 00:05:01,530
!ما رأيك أن تساعديني؟

55
00:05:01,530 --> 00:05:04,820
!أنا خائفة كثيرًا من الاقتراب من السّياج

56
00:05:04,820 --> 00:05:06,910
!لماذا أتيتِ إلى السّطح إذًا؟

57
00:05:07,510 --> 00:05:11,160
انظري! لقد تحمّستُ لدرجة
!أنّني طلبتُ أزياءً لنا

58
00:05:11,550 --> 00:05:13,470
!حتّى أنّني طلبتُ واحدًا لأريما-سان

59
00:05:13,470 --> 00:05:16,170
طلبتها؟ من أين؟

60
00:05:19,220 --> 00:05:21,050
...عرفتُ أنّه سيكون شيئًا كهذا

61
00:05:21,400 --> 00:05:23,870
!اخلعي ذلك الآن وأعيديه في الحال

62
00:05:23,870 --> 00:05:25,800
...ماذا؟ لكنّه ظريف

63
00:05:28,260 --> 00:05:31,680
لا يجب عليك أن تري هذا
...لأريما-سان بكلّ تأكيد

64
00:05:31,680 --> 00:05:33,470
أتظنّين ذلك؟

65
00:05:34,130 --> 00:05:37,100
...أنا أيضًا اعتقدتُ أنّه ليس مناسبًا قليلاً

66
00:05:37,100 --> 00:05:38,980
—إذًا فقد أدركتِ

67
00:05:39,260 --> 00:05:41,640
تبدو أريما-سان أفضل وهي ترتدي
!الأزرق بدل البنفسجيّ

68
00:05:41,640 --> 00:05:42,480
!وما أدراني؟

69
00:05:42,940 --> 00:05:45,930
!أنا متحمّسة للغاية لنهاية الدّوام
!أتريدين المجيء معي يا أوكي؟

70
00:05:45,930 --> 00:05:46,860
.كلاّ

71
00:05:47,260 --> 00:05:50,810
،أنت عضوة في نادي التّشجيع تقريبًا
.لذلك ليس عليك أن تخجلي

72
00:05:50,810 --> 00:05:52,810
.لستُ كذلك على الإطلاق

73
00:05:57,340 --> 00:06:00,830
!أنا آسفة! سأطلب واحدًا لك في الحال

74
00:06:00,830 --> 00:06:02,380
!توقّفي

75
00:06:02,380 --> 00:06:04,920
!توقّفي عن تخيّلي وأنا أرتديه

76
00:06:08,600 --> 00:06:11,080
...يمرّ الوقت ببطء

77
00:06:12,440 --> 00:06:15,530
أنا متفاجئة من كونك تأخذين ملاحظات
.كما يجب أن تفعلي

78
00:06:17,030 --> 00:06:19,530
عليك العثور على عضوات أخريات
.قبل البدء في التّفكير في اسمٍ للفريق

79
00:06:19,530 --> 00:06:21,720
.فعلتُ ما يمكنني في الوقت الحاليّ

80
00:06:28,030 --> 00:06:31,400
،في العادة، سيكون جمع العضوات مهمًّا

81
00:06:31,400 --> 00:06:35,030
.لكن اليوم، أرغب بالتّدريب

82
00:06:35,030 --> 00:06:35,940
...لكن

83
00:06:37,120 --> 00:06:39,640
لماذا أنت مرهقة حتّى قبل أن نبدأ؟

84
00:06:39,640 --> 00:06:41,000
...أنا متعبة ذهنيًّا

85
00:06:41,360 --> 00:06:44,380
!لكن لديّ الكثير من الطّاقة للتّشجيع

86
00:06:44,380 --> 00:06:46,320
ما الّذي سنفعله اليوم؟

87
00:06:46,320 --> 00:06:48,130
.سنقوم باختبار قوّتك الجسديّة

88
00:06:50,770 --> 00:06:55,500
.من الضّروريّ اختبار القدرات الفرديّة للجميع

89
00:06:56,340 --> 00:06:57,200
.خذي

90
00:06:59,160 --> 00:07:01,150
.آسفة، لم أستطع منع نفسي

91
00:07:02,340 --> 00:07:03,800
.التّركيز: معدوم

92
00:07:03,800 --> 00:07:05,520
هذا أحد الأمور الّتي تختبرينها؟

93
00:07:06,230 --> 00:07:08,820
.أوّلاً، علينا أن نقوم بالإحماء

94
00:07:09,610 --> 00:07:11,350
!حسنًا يا سينسي

95
00:07:15,220 --> 00:07:16,830
!سوف توبّخني

96
00:07:18,180 --> 00:07:19,290
.لا بأس

97
00:07:20,240 --> 00:07:22,590
.لم أكن أتوقّع أيّ شيء من الأساس

98
00:07:22,590 --> 00:07:25,560
!هذا يؤلم حتّى— مؤلم، مؤلم، مؤلم

99
00:07:25,560 --> 00:07:28,200
.لا يستطيع أحد القيام بهذا من البداية

100
00:07:29,320 --> 00:07:34,880
.ولن تتغيّر مرونتك بين ليلة وضحاها فجأة

101
00:07:34,880 --> 00:07:37,360
.علينا العمل عليها بشكل تدريجيّ

102
00:07:37,360 --> 00:07:40,860
.إذًا فهي تنوي البقاء إلى جانبي لوقت طويل

103
00:07:41,480 --> 00:07:42,190
!نعم

104
00:07:42,600 --> 00:07:45,830
.بعد أن وضّحتُ ذلك، فلن أتساهل معك

105
00:07:48,390 --> 00:07:52,950
!حسنًا! سأبذل أقصى ما بوسعي
!شاهدي فقط يا أريما-سان

106
00:08:01,060 --> 00:08:02,080
.‫10,2 ثانية

107
00:08:02,950 --> 00:08:06,840
لا بدّ أنّني... امرأة مناسبة أكثر
...للرّكض لمسافات بعيدة

108
00:08:06,840 --> 00:08:08,490
.لنجرّب المسافات الطّويلة

109
00:08:09,280 --> 00:08:12,040
...كلاّ، لا بدّ أنّني امرأة مناسبة أكثر للقفز

110
00:08:12,840 --> 00:08:14,280
.القفز العموديّ

111
00:08:16,650 --> 00:08:17,840
.القفز من جانب لآخر

112
00:08:17,840 --> 00:08:22,300
...أنا امرأة مناسبة... أكثر للقفز
...من جانب لآخر

113
00:08:23,810 --> 00:08:26,540
هل أنا امرأة من الأساس؟

114
00:08:26,540 --> 00:08:29,190
...ماذا؟! نعم، أظنّ ذلك

115
00:08:29,800 --> 00:08:32,810
!أجل! أنا امرأة مناسبة أكثر للتّشجيع

116
00:08:32,810 --> 00:08:34,750
وماتا تعنين بذلك؟

117
00:08:34,750 --> 00:08:37,320
أنا واثقة بنفسي أكثر عندما يتعلّق
!الأمر بتشجيع الآخرين

118
00:08:38,280 --> 00:08:40,300
...حسنًا، إنّها محقّة

119
00:08:44,280 --> 00:08:45,780
...لن أخبرها بذلك، لكن

120
00:08:47,320 --> 00:08:50,550
لكنّني كنت لأصف ذلك بالقفز
.للأسفل بدل التّشجيع

121
00:08:50,550 --> 00:08:53,550
بالمناسبة، هل اعتدت على الأماكن المرتفعة؟

122
00:08:53,550 --> 00:08:54,800
...كـ-كلاّ

123
00:08:55,150 --> 00:08:59,560
كنتُ قادرة فقط على القفز تلك المرّة
...لأنّ قوّة تشجيعي كانت في أوجها

124
00:09:00,960 --> 00:09:02,760
قوّة... تشجيعك؟

125
00:09:02,760 --> 00:09:04,940
!نعم. قوّة التّشجيع

126
00:09:06,640 --> 00:09:08,260
!لقد فهمت الآن

127
00:09:13,240 --> 00:09:16,060
.سيفي هذا بالنّسبة لاختبارات القوّة الجسديّة

128
00:09:19,730 --> 00:09:23,900
أعتقد أنّه لا يمكنني لومها لكونها
.مكتئبة لهذه النّتائج الفظيعة

129
00:09:24,340 --> 00:09:25,340
...إنّنا

130
00:09:26,750 --> 00:09:29,240
!لم نفعل أيّ شيء له علاقة بالتّشجيع على الإطلاق

131
00:09:29,240 --> 00:09:30,460
!هذا ما يزعجك؟

132
00:09:30,460 --> 00:09:33,580
!حسنًا، كنت أتطلّع للأمر

133
00:09:33,580 --> 00:09:35,850
،الرّقص باستعمال البوم بوم

134
00:09:36,240 --> 00:09:38,360
!بل وحتّى بعض الحركات الخطرة

135
00:09:38,360 --> 00:09:40,100
أردتِ القيام بكلّ ذلك في يوم تدريبك الأوّل؟

136
00:09:40,480 --> 00:09:44,230
.لكن علينا اكتشاف ما هي قدراتك الفرديّة أوّلاً

137
00:09:54,170 --> 00:09:56,440
.هاتويا-سان، تفضّلي

138
00:09:57,890 --> 00:09:59,110
ما هذا؟

139
00:09:59,730 --> 00:10:02,620
.إنّه زيّ التّدريب خاصّتي في الإعداديّة

140
00:10:03,380 --> 00:10:06,120
،لكنّه صغير جدًّا عليّ الآن
.لذلك يمكنك أخذه إن أردت

141
00:10:06,440 --> 00:10:08,700
زيّ تشجيع للتّدريب؟

142
00:10:08,700 --> 00:10:09,880
!لقد نسيت الأمر بسرعة

143
00:10:10,530 --> 00:10:14,920
...مذهل، إنّه ظريف! وليس ذلك فقط

144
00:10:15,310 --> 00:10:18,620
هذا التّصميم الرّائع يسمح لي
!أيضًا بالتّشجيع بمؤخّرتي

145
00:10:15,960 --> 00:10:20,800
قاتلوا

146
00:10:18,620 --> 00:10:20,800
!لا أعتقد أنّ ذلك ما دار في بال المصمّم

147
00:10:21,430 --> 00:10:23,550
هل تشعرين أكثر بأنّك مشجّعة الآن؟

148
00:10:23,550 --> 00:10:26,330
!أنا جدّ سعيدة! شكرًا لك يا أريما-سان

149
00:10:26,330 --> 00:10:27,340
...الـ-العفو

150
00:10:27,340 --> 00:10:28,310
!صحيح

151
00:10:28,730 --> 00:10:31,310
!أحضرتُ لك هذا يا أريما-سان

152
00:10:33,320 --> 00:10:35,370
!هل تسخرين من التّشجيع؟

153
00:10:35,370 --> 00:10:38,500
!كلاّ، لست أفعل! أنّا أحبّه

154
00:10:44,330 --> 00:10:49,260
...جسدي متعب بالكامل بعد التّدريب طوال الأسبوع

155
00:10:49,260 --> 00:10:50,460
.سأحمل حقيبتك عنك

156
00:10:50,460 --> 00:10:51,710
...شكرًا لك

157
00:10:52,440 --> 00:10:55,240
...أعتقد أنّ هذا متوقّع من مشجّعة بارعة سابقة

158
00:10:55,240 --> 00:10:57,210
.لا بدّ أنّه تدريب صارم للغاية

159
00:10:57,210 --> 00:10:59,960
كان عليّ لمس أصابع قدمي عشر مرّات
...والقيام بعشرة تمرين شدّ بطن

160
00:10:59,960 --> 00:11:02,890
ثمّ عشرة تمارين ضغط
!والرّكض السّريع لعشر مرّات

161
00:11:02,890 --> 00:11:04,570
!إنّه عمل شاقّ

162
00:11:06,390 --> 00:11:07,980
!أوكي؟

163
00:11:07,980 --> 00:11:10,890
.فكّرت في مساعدتك على التّدريب قليلاً

164
00:11:13,150 --> 00:11:14,900
!أودّ القيام ببعض التّشجيع الحقيقيّ

165
00:11:14,900 --> 00:11:19,130
لكنّ كلّ ما تقومين به الآن من تدريب
أساسيّ للتّشجيع، صحيح؟

166
00:11:19,130 --> 00:11:21,630
.الأساسيّات مهمّة لأيّ شيء

167
00:11:21,630 --> 00:11:23,280
...أعلم ذلك، لكن

168
00:11:27,900 --> 00:11:31,540
يبدو أنّ كوهاني بدأت تسأم
.من كلّ التّداريب الأساسيّة

169
00:11:32,050 --> 00:11:33,670
.وها أنا أدلّلها ثانية

170
00:11:33,960 --> 00:11:36,810
لكنّني لم أطلب منها القيام
.بأيّ شيء شاقّ بعد

171
00:11:36,810 --> 00:11:38,050
!أنت محقّة تمامًا

172
00:11:38,610 --> 00:11:42,550
قد يكون ذلك راجع لحقيقة أنّها لم تكن
.جيّدة في النّشاطات الجسديّة أبدًا

173
00:11:43,060 --> 00:11:44,940
أعتقد أنّك إن منحتها ما يحفّزها

174
00:11:44,940 --> 00:11:46,800
.ستشعر أنّها قادرة أكثر على القيام بالأساسيّات

175
00:11:46,800 --> 00:11:48,790
—لكنّ ذلك يعتبر تدليلاً فحسب

176
00:11:54,080 --> 00:11:55,690
!آسفة

177
00:11:58,320 --> 00:12:01,760
...وحيدة... وحيدة... وحيدة

178
00:12:01,760 --> 00:12:03,100
...وحيدة

179
00:12:01,760 --> 00:12:04,940
مهلاً، لماذا دخلت في حالة صدمة فجأة؟

180
00:12:03,100 --> 00:12:05,320
...وحيدة... وحيدة

181
00:12:06,080 --> 00:12:09,230
هنالك تغيّر طفيف في البرنامج اليوم

182
00:12:09,230 --> 00:12:11,330
.وسنقوم بشيء أقرب إلى التّشجيع قليلاً

183
00:12:11,330 --> 00:12:14,360
ستتدرّبين معنا أيضًا يا ساواتاري-سان
.بما أنّك من اقترحت هذا

184
00:12:14,360 --> 00:12:15,330
لماذا؟

185
00:12:15,790 --> 00:12:18,090
.لنصنع بعض البوم بوم اليوم

186
00:12:18,450 --> 00:12:21,930
أليست البوم بوم رائعة؟
!إنّها مناسبة للتّشجيع وظريفة

187
00:12:21,930 --> 00:12:24,790
.هذا مريح. تبدو بحال أفضل

188
00:12:25,890 --> 00:12:29,150
.أوّلاً، سنلفّ هذا الشّريط حول اللّوح الكرتونيّ

189
00:12:30,610 --> 00:12:33,020
وبينما نقوم بذلك، سنقوم أيضًا بفتح أرجلنا

190
00:12:33,510 --> 00:12:35,300
.ونمدّد أوتار كعوبنا

191
00:12:36,240 --> 00:12:39,020
،بمجرّد أن نلفّها عشرين مرّة
،نزيل الشّريط عن اللّوح الكرتونيّ بحذر

192
00:12:39,680 --> 00:12:41,530
.وسنقوم بربطه في المنتصف

193
00:12:42,000 --> 00:12:43,840
.وبينما نقوم بذلك، سنقوم بشدّ أرجلها

194
00:12:43,840 --> 00:12:46,450
...إنّك تضيفين بعض تمارين بخفية تدريجيًّا

195
00:12:46,730 --> 00:12:50,450
...تبًّا، هذا أصعب ممّا ظننت

196
00:12:50,450 --> 00:12:53,940
...نعم، يبدو أنّ جسدي يرتعش

197
00:12:54,840 --> 00:12:57,210
.سأخبرك بخدعة يا ساواتاري-سان

198
00:12:57,210 --> 00:12:58,960
هنالك خدعة للقيام بهذا؟

199
00:12:59,260 --> 00:13:00,570
...في الحقيقة

200
00:13:00,570 --> 00:13:02,960
لا يوجد على الإطلاق أيّ سبب
.لمدّ أوتار كعوبنا الآن

201
00:13:02,960 --> 00:13:04,240
.نعم، أعلم ذلك

202
00:13:04,240 --> 00:13:05,340
!يا إلهي

203
00:13:08,820 --> 00:13:09,980
.نجحنا

204
00:13:09,980 --> 00:13:12,680
!انظري! إنّها ظريفة جدًّا عند فتحها

205
00:13:12,680 --> 00:13:14,640
!انظري، انظري

206
00:13:13,070 --> 00:13:14,640
!توقّفي

207
00:13:14,640 --> 00:13:15,870
!ظريفة جدًّا

208
00:13:15,010 --> 00:13:18,400
.وبعد ذلك، سنقوم بقصّها من نهاياتها دون فتحها

209
00:13:16,600 --> 00:13:18,400
!توقّفي

210
00:13:22,720 --> 00:13:25,380
.بمجرّد أن نقوم بذلك، سننشرها من المنتصف

211
00:13:25,780 --> 00:13:27,360
...وبينما نقوم بذلك

212
00:13:27,360 --> 00:13:29,450
...إنّها تفكّر بجدّ

213
00:13:29,790 --> 00:13:31,320
!سنقوم بالتّشجيع

214
00:13:31,320 --> 00:13:34,700
!تقدّموا للفوز! تقدّموا للفوز! تقدّموا للفوز

215
00:13:32,390 --> 00:13:34,700
...أنت تبالغين كثيرًا يا أريما-سان

216
00:13:34,700 --> 00:13:38,580
!تقدّموا للوو! تقدّموا للوو

217
00:13:36,240 --> 00:13:38,580
!ماذا؟ لم تتردّد أبدًا

218
00:13:39,600 --> 00:13:43,070
سنربط قطعتين معًا في الدّاخل
.ونكون قد انتهينا بذلك

219
00:13:43,070 --> 00:13:46,460
.مذهل، لقد تأثّرت نوعًا ما

220
00:13:46,930 --> 00:13:48,430
!مهلاً، ماذا؟

221
00:13:48,860 --> 00:13:51,440
لقد بدت متشابهة في معظم
...المراحل، لذلك كيف

222
00:13:51,440 --> 00:13:55,510
انتهى بي المطاف مركّزة كثيرًا على
...التّشجيع قبل أن أدرك الأمر

223
00:13:57,240 --> 00:13:59,560
...أوّل بوم بوم أصنعها على الإطلاق

224
00:13:59,560 --> 00:14:01,790
.لكنّك صنعتِها من قبل

225
00:14:01,790 --> 00:14:03,530
.لكنّني صنعتها على طريقتي

226
00:14:03,530 --> 00:14:06,700
جيّد جدًّا. لماذا لا نتبادل؟

227
00:14:07,120 --> 00:14:09,440
...تشعر أريما-سان بالسّوء

228
00:14:09,440 --> 00:14:11,640
...لكنّ هذا... هذا

229
00:14:11,640 --> 00:14:13,790
!يمكنك أن تبادليني خاصّتي

230
00:14:13,790 --> 00:14:15,930
لماذا لا نتبادلها جميعًا إذًا؟

231
00:14:15,930 --> 00:14:16,960
!يبدو ذلك جيّدًا

232
00:14:17,600 --> 00:14:21,960
...هذه أوّل... بوم بوم لكوهاني

233
00:14:22,820 --> 00:14:25,460
...بوم بوم صنعناها نحن بصفتنا نادي التّشجيع

234
00:14:25,840 --> 00:14:27,740
!ستكون هذه ذكرى ممتازة

235
00:14:27,740 --> 00:14:28,470
.نعم

236
00:14:31,220 --> 00:14:33,310
!مهلاً! لا تدخلاني في الأمر

237
00:14:33,310 --> 00:14:33,890
.تبًّا

238
00:14:41,850 --> 00:14:44,790
...لا أصدّق أنّني تورّطت في هذا

239
00:14:57,290 --> 00:14:59,680
!فـ-فهمت الأمر بشكل خاطئ

240
00:14:59,680 --> 00:15:03,580
كنت أجرّب البوم بوم
!الّتي صنعتها كوهاني فقط

241
00:15:03,580 --> 00:15:06,490
!لن أنضمّ! لن أصبح مشجّعة

242
00:15:10,060 --> 00:15:11,590
!صباح الخير

243
00:15:11,900 --> 00:15:14,170
.صباح الخير يا ساواتاري-سان

244
00:15:14,170 --> 00:15:16,270
هل قرّرتِ الانضمام لنادٍ ما بالفعل؟

245
00:15:16,270 --> 00:15:17,360
.كلاّ، ليس بعد

246
00:15:17,360 --> 00:15:19,050
.نحن أيضًا

247
00:15:19,050 --> 00:15:21,790
.لكن علينا أن نتّخذ قرارنا سريعًا

248
00:15:21,790 --> 00:15:24,160
هل هنالك نادٍ يحوز على اهتمامك يا ساواتاري-سان؟

249
00:15:24,160 --> 00:15:25,050
...لا يوجد

250
00:15:25,050 --> 00:15:25,940
!في تلك الحالة

251
00:15:27,060 --> 00:15:29,190
...ماذا؟ إنّها لا تُفتح

252
00:15:29,730 --> 00:15:34,980
!أوكي! أوكي! أوكي

253
00:15:31,570 --> 00:15:34,860
نعم، لا يمكنني التّفكير في أيّ نادٍ
.حاز على اهتمامي

254
00:15:35,400 --> 00:15:36,580
!أوكي

255
00:15:37,800 --> 00:15:42,010
منح الضّائعين دفعة لطيفة إلى الاتّجاه
!الصّحيح هو جزء من التّشجيع أيضًا

256
00:15:42,010 --> 00:15:43,520
!تعاليا إلى نادي التّشجيع

257
00:15:43,520 --> 00:15:46,280
تقصدين "إسقاطهم أرضًا" عندما
.قلت دفعة لطيفة

258
00:15:46,280 --> 00:15:47,980
ما الّذي كنتِ تفعلينه في الخزانة من الأساس؟

259
00:15:47,980 --> 00:15:50,970
فكّرت في مفاجأتكنّ وإخباركنّ كم
!أنّ نادي التّشجيع رائع

260
00:15:51,440 --> 00:15:54,680
حسنًا، أخبرينا إذًا ما العظيم بشأنه
.بما أنّك الآن خبيرة تشجيع

261
00:15:55,650 --> 00:15:59,160
...خبيرة تشجيع... خبيرة تشجيع
...خبيرة تشجيع

262
00:15:59,810 --> 00:16:01,980
...خبيرة تشجيع

263
00:16:01,980 --> 00:16:04,480
.حسنًا، فلتأخذ مقاعدكنّ

264
00:16:04,480 --> 00:16:06,030
.انتهى الوقت

265
00:16:06,030 --> 00:16:07,680
.إلى اللّقاء

266
00:16:07,680 --> 00:16:09,800
.حظًّا سعيدًا مع نادي التّشجيع خاصّتك

267
00:16:09,800 --> 00:16:12,360
!سأشجّعكما إن احتجتماني

268
00:16:12,360 --> 00:16:15,370
...عند تطبيق التّعميل على صيغ معقّدة

269
00:16:16,550 --> 00:16:18,060
.هذه من هاتويا-سان

270
00:16:24,500 --> 00:16:26,250
ما هذا؟

271
00:16:26,700 --> 00:16:29,150
...حتّى أنّها لم تجد ما تكتبه في النّهاية

272
00:16:29,150 --> 00:16:30,620
!أوكي

273
00:16:31,650 --> 00:16:34,140
ما قصّة ذلك التّرتيب السّيّئ؟

274
00:16:34,140 --> 00:16:35,510
!لم يكن سيّئًا

275
00:16:35,510 --> 00:16:39,050
!التّشجيع ظريف! إنّه مذهل

276
00:16:39,050 --> 00:16:40,760
!إنّه جميل

277
00:16:44,210 --> 00:16:46,010
!ويجعلك تصرخين قائلة أجل

278
00:16:46,010 --> 00:16:47,520
!إنّها كلمات مجبرة فحسب

279
00:16:47,520 --> 00:16:50,810
ألا تشعرين باختلاف ما بعد قراءتك لتلك الرّسالة؟

280
00:16:50,810 --> 00:16:52,780
.لقد أصبحت عاجزة عن الكلام بالفعل

281
00:16:53,160 --> 00:16:55,100
.هناك أشياء جيّدة عن البدء بالتّشجيع

282
00:16:55,100 --> 00:16:56,610
مثل ماذا؟

283
00:16:57,020 --> 00:16:59,030
!يصبح جسدك أكثر مرونة

284
00:17:00,120 --> 00:17:01,820
!أرأيت؟ أليس هذا رائعًا؟

285
00:17:01,820 --> 00:17:04,000
هل هي جادّة أم تمزح؟

286
00:17:04,330 --> 00:17:06,970
!أنا أكثر مرونة ممّا كنت من قبل

287
00:17:06,970 --> 00:17:10,630
...بذلك؟ أعني أنّني أحبّ التّمرين، لكن

288
00:17:14,720 --> 00:17:18,730
أتساءل إن كانت معاقبة لصوص اللّباس
...المدرسيّ يعتبر تمرينًا

289
00:17:18,730 --> 00:17:20,390
ما-ماذا؟

290
00:17:23,460 --> 00:17:24,860
—لنأكـ

291
00:17:26,390 --> 00:17:28,280
أليست هذه البوم بوم ظريفة؟

292
00:17:28,280 --> 00:17:31,740
يكفي يا كوهاني. وضعتها هنا أيضًا؟

293
00:17:31,740 --> 00:17:33,270
أين غدائي إذًا؟

294
00:17:35,970 --> 00:17:36,950
!كلاّ

295
00:17:37,560 --> 00:17:40,480
...أواجه وقتًا عصيبًا في إقناع أوكي

296
00:17:40,480 --> 00:17:43,340
قد يكون من الصّعب تخيّل نفسها تفعل ذلك

297
00:17:43,340 --> 00:17:45,210
...إن لم ترى كيف يبدو الأمر بالفعل

298
00:17:46,150 --> 00:17:49,820
بالتّفكير في الأمر، لم أقرّر
أن أصبح مشجّعة

299
00:17:49,820 --> 00:17:51,670
.إلاّ بعد أن رأيت المشجّعات

300
00:17:51,670 --> 00:17:55,660
سأكتشف طريقة تمكّنها
.من مشاهدة تشجيع حقيقيّ

301
00:17:56,600 --> 00:17:59,150
بدلاً من التّفكير في مخطّط
،بارع لجعلها تنضمّ

302
00:17:59,150 --> 00:18:02,630
حاولي التّعبير عن مشاعرك الصّادقة
.حول كم تريدين القيام بهذا معها

303
00:18:05,930 --> 00:18:08,040
.أعني، هذا كلّ ما يمكنك فعله

304
00:18:08,040 --> 00:18:09,060
!هذا فحسب؟

305
00:18:09,630 --> 00:18:12,710
!سأخبرك يا أوكي! سأخبرك كيف أشعر

306
00:18:13,950 --> 00:18:17,850
،أنا... أريد أن أشجّع برفقة أوكي

307
00:18:17,850 --> 00:18:20,160
...وأريدها أن تستمتع بالأمر

308
00:18:20,670 --> 00:18:23,600
وأنا أعلم أنّ أوكي ستحبّ
...أزياء التّشجيع أيضًا

309
00:18:23,600 --> 00:18:24,680
.كوهاني

310
00:18:25,640 --> 00:18:26,910
أين كنتِ؟

311
00:18:27,320 --> 00:18:28,500
!أوكي

312
00:18:30,380 --> 00:18:33,210
...أنا... أنا

313
00:18:33,890 --> 00:18:35,130
...أوكي، أنا

314
00:18:35,760 --> 00:18:37,730
!أريد القيام بالأمر معك يا أوكي

315
00:18:37,730 --> 00:18:40,640
!ماذا؟! ماذا؟ ما الّذي تتحدّثين عنه؟

316
00:18:42,730 --> 00:18:45,010
...كنت تقصدين التّشجيع

317
00:18:45,010 --> 00:18:48,730
هل وعدت ناديًا آخر بالانضمام له سلفًا؟

318
00:18:48,730 --> 00:18:50,960
.طبعًا لا

319
00:18:50,960 --> 00:18:53,020
...الأمر ليس وكأنّ لديّ أيّ أحد آخر

320
00:18:53,020 --> 00:18:55,560
...لأقوم بذلك الوعد معه يا كوهاني

321
00:18:55,560 --> 00:18:56,900
!ساواتاري-سان

322
00:18:57,590 --> 00:18:59,530
.هذا من أريما-سان من الفصل 1

323
00:19:00,230 --> 00:19:02,020
.طلبت منّي إعطاءك إيّاها

324
00:19:02,780 --> 00:19:06,620
أعتقد أنّكما أصبحتما مقرّبين كفاية لتكتبا
.لبعضكما رسائل قبل أن أدرك حتّى

325
00:19:06,620 --> 00:19:10,120
كيف يعقل لك أن تقولي ذلك بينما
يبدو هذا كأنّها تتحداني بشكل واضح؟

326
00:19:11,430 --> 00:19:15,580
".قابليني على السّطح رجاءً"
هل تتحداني بالفعل؟

327
00:19:16,260 --> 00:19:18,630
...بصراحة، حتّى أريما-سان تبدو سخيفة الآن

328
00:19:21,190 --> 00:19:22,560
لماذا أغلقته؟

329
00:19:22,560 --> 00:19:25,600
!إ-إ-إنّ أريما-سان تقف متأهّبة هناك

330
00:19:25,600 --> 00:19:27,480
!إنّها بانتظارك

331
00:19:28,100 --> 00:19:29,210
!كفانا كلامًا

332
00:19:29,210 --> 00:19:30,840
!بدأ الأمر! بسرعة

333
00:19:30,840 --> 00:19:32,300
بدأ؟ ما الّذي قد بدأ؟

334
00:19:32,300 --> 00:19:34,650
!أنا واثقة أنّ الأمر سيكون رائعًا! افتحي الباب فحسب

335
00:19:36,860 --> 00:19:46,950
!تقدّمي، تقدّمي يا كامينوكي
!هيّا بنا يا كامينوكي! تقدّمي، قاتلي، فوزي

336
00:19:59,540 --> 00:20:00,920
!لننطلق

337
00:20:21,070 --> 00:20:22,700
!كان ذلك رائعًا

338
00:20:22,700 --> 00:20:24,680
!أخبريني؟ أخبريني؟! ألم يكن ذلك رائعًا؟

339
00:20:24,680 --> 00:20:26,160
ألا تشعرين برغبة في القيام بذلك الآن أيضًا؟

340
00:20:26,680 --> 00:20:28,540
...حسنًا... نعم

341
00:20:28,870 --> 00:20:32,540
،ما زلت غير واثقة من رغبتي في ذلك
...لكنّني واثقة من شيء واحد الآن

342
00:20:36,350 --> 00:20:38,200
!إنّه ظريف ورائع

343
00:20:39,240 --> 00:20:40,210
أليس كذلك؟

344
00:20:40,650 --> 00:20:45,020
أودّ فعلاً أن تكوني زميلة لي
.في الفريق يا ساواتاري-سان

345
00:20:45,020 --> 00:20:48,730
،أعرف لماذا ترغب كوهاني بانضمامي
لكن لماذا تقولين ذلك أيضًا يا أريما-سان؟

346
00:20:50,520 --> 00:20:52,730
،عندما ندعم الآخرين
.كلمّا زاد عددنا، كان ذلك أفضل

347
00:20:53,980 --> 00:20:55,950
!إن كنّا سندعم هاتويا-سان

348
00:20:55,950 --> 00:20:57,880
!أجل، هل نتحدّث عن الحركات الخطرة؟

349
00:20:57,880 --> 00:20:59,860
...إنّها تتحدّث عن الدّعم النفسيّ بكلّ تأكيد

350
00:21:05,440 --> 00:21:10,380
أعتقد أنّ مساعدة صديقة للقيام بشيء
...ترغب فيه هو تشجيع نوعًا ما أيضًا

351
00:21:12,470 --> 00:21:14,220
—حسنًا، سأنضمّ إلى نادي التّشجيع

352
00:21:14,220 --> 00:21:15,890
!أوكي

353
00:21:15,890 --> 00:21:17,600
!أو لن أنضمّ

354
00:21:17,600 --> 00:21:18,710
!آسفة

355
00:21:19,370 --> 00:21:22,200
.لنعرّف عن أنفسنا بشكل رسميّ
.اسمي أريما هيزومي

356
00:21:22,200 --> 00:21:25,300
.وأنا اسمي ساواتاري أوكي
.سررت بلقائك

357
00:21:25,730 --> 00:21:28,590
.ليست لديّ أيّ خبرة في التّشجيع
فهل سيكون ذلك مناسبًا؟

358
00:21:28,590 --> 00:21:29,800
.بالطّبع

359
00:21:30,400 --> 00:21:33,900
.ابذلي جهدك رجاءً لدعم هاتويا-سان

360
00:21:33,900 --> 00:21:36,400
.أكيد. سأبذل قصارى جهدي

361
00:21:36,400 --> 00:21:39,310
...مهلاً... لكنّني خبيرة التّشجيع

362
00:21:40,070 --> 00:21:44,040
بالمناسبة، لماذا كنت متردّدة في
الانضمام لنادي التّشجيع يا أوكي؟

363
00:21:44,040 --> 00:21:49,130
حـ-حسنًا... تنّورات أزياء التّشجيع
...قصيرة جدًّا

364
00:21:49,130 --> 00:21:51,610
لكنّك تحبّين الملابس الظّريفة، صحيح يا أوكي؟

365
00:21:51,610 --> 00:21:53,830
!كـ-كـ-كلاّ، لا أحبّها

366
00:21:53,830 --> 00:21:57,710
إذًا هل تفضّلين زيًّا بسروال قصير
بدل ذلك يا ساواتاري-سان؟

367
00:21:57,710 --> 00:21:59,180
.إنّها متوفّرة أيضًا

368
00:21:59,180 --> 00:22:02,590
مهلاً! تبدو هذه مثل سراويل التّدريب
!القصيرة الّتي أعطيتني إيّاها

369
00:22:05,430 --> 00:22:06,410
.دفع

370
00:23:38,640 --> 00:23:42,020
،في الحلقة القادمة: "جمعيّة التّشجيع
"!التّشجيع للحبّ