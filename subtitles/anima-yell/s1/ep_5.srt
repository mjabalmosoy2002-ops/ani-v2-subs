1
00:00:15,040 --> 00:00:16,410
!تاتيجيما-سان

2
00:00:16,410 --> 00:00:18,280
.مرحبًا بك في جمعيّة التّشجيع

3
00:00:18,540 --> 00:00:21,550
.مـ-مذهل. لديكنّ وجبات خفيفة أيضًا

4
00:00:21,550 --> 00:00:24,240
.أقمنا لك اليوم حفلة ترحيب يا تاتيجيما-سان

5
00:00:24,240 --> 00:00:26,140
!تفضّلي رجاءً

6
00:00:26,140 --> 00:00:28,460
.يبدو هذا شهيًّا، شكرًا لك

7
00:00:29,190 --> 00:00:30,300
.سررنا بتواجدك معنا

8
00:00:30,600 --> 00:00:33,340
هل يمكنني مناداتك كوتيتشان بدءًا من الآن؟

9
00:00:34,400 --> 00:00:35,050
.لا تفعلي رجاءً

10
00:00:38,760 --> 00:00:39,880
ماذا؟

11
00:00:39,880 --> 00:00:43,260
لماذا لا يمكنك اكتشاف ما حدث للتّوّ؟

12
00:00:43,260 --> 00:00:45,560
.واضح أنّك المسؤولة عنه

13
00:00:46,160 --> 00:00:48,870
.أتذكرين؟ إنّها لا تحبّ اسمها

14
00:00:50,490 --> 00:00:51,690
نسيت ذلك، صحيح؟

15
00:00:52,210 --> 00:00:57,390
...لكنّه اسم رائع
.وأريد التّقرّب منك أكثر

16
00:00:57,390 --> 00:00:58,760
أيمكنني ذلك؟

17
00:00:58,760 --> 00:00:59,450
...لكن

18
00:00:59,450 --> 00:01:04,400
،"أعني أنّه بمناداتك "كوتيتشان
!فقد يعتقد النّاس أنّ اسمك كوتيكو

19
00:01:04,400 --> 00:01:05,180
!كوتيكو؟

20
00:01:05,180 --> 00:01:07,270
!لقد جعلتِ اسمها يبدو أسوأ

21
00:02:40,530 --> 00:02:43,760
.حسنًا، هذه فرصة مثاليّة لننادي بعضنا بأسمائنا

22
00:02:44,200 --> 00:02:48,410
.اسم "تا-تي-جي-ما-سان" طويل للغاية

23
00:02:48,410 --> 00:02:51,150
..."أمّا "كوتيتشان

24
00:02:52,020 --> 00:02:54,680
أربعة... فيه أربعة مقاطع صوتيّة، صحيح؟

25
00:02:55,270 --> 00:02:56,780
.المعذرة

26
00:02:57,080 --> 00:02:58,780
.آسفة على التّأخّر

27
00:02:58,780 --> 00:03:00,320
!مرحبًا يا هيزومي

28
00:03:01,400 --> 00:03:03,670
هـ-هـ-هاتويا؟

29
00:03:05,380 --> 00:03:07,830
.فهمت. هذا ما يحدث إذًا

30
00:03:08,240 --> 00:03:11,210
...مناداة بعضنا بأسمائنا الشّخصيّة
.أجد أنّها فكرة جيّدة

31
00:03:11,210 --> 00:03:16,030
حتّى أنّك قد تبدئين في حبّ اسمك
.أكثر إن سمعتِ الآخرين ينادونك به

32
00:03:16,030 --> 00:03:18,710
.هذا فقط إن كنتِ لا تمانعين ذلك يا تاتيجيما-سان

33
00:03:20,070 --> 00:03:22,190
ما قولك إذًا يا كوتيتشان؟

34
00:03:22,190 --> 00:03:23,970
!يمكنك مناداتي باسمي الشّخصيّ أيضًا

35
00:03:24,900 --> 00:03:26,970
...كـ-كوهاني-تشان

36
00:03:29,350 --> 00:03:30,760
!كوتيتشان

37
00:03:30,760 --> 00:03:32,440
...كـ-كوهاني-تشان

38
00:03:34,440 --> 00:03:38,750
،والآن بعد مجيء أرينا-سان... أقصد هيزومي

39
00:03:38,750 --> 00:03:40,210
.فدعونا نبدأ

40
00:03:40,210 --> 00:03:41,320
!أ-أكيد

41
00:03:42,720 --> 00:03:44,250
.يمكنك البقاء جالسة

42
00:03:46,560 --> 00:03:50,830
كوتيتشان، نودّ أن نرحّب بك بشكل
!رسميّ في جمعيّة التّشجيع

43
00:03:52,200 --> 00:03:53,900
.إليك تشجيعًا للتّرحيب بك

44
00:03:53,900 --> 00:03:55,470
...استعداد

45
00:03:55,470 --> 00:03:57,460
!تعالي وانضمّي لنا

46
00:04:03,590 --> 00:04:05,720
!تسنّت لي رؤية لحظة تغيّرها بالضّبط

47
00:04:16,760 --> 00:04:20,650
كاف! واو! تاء! ياء! تاء؟

48
00:04:21,040 --> 00:04:23,980
...شين؟ ألف؟ لحظة

49
00:04:23,980 --> 00:04:26,590
—نون؟ كـ-كوتيتشا

50
00:04:26,590 --> 00:04:28,580
...المعذرة، نادني كوتيتسو فحسب

51
00:04:32,880 --> 00:04:35,170
...أ-أودّ فعل شيء في المقابل

52
00:04:44,390 --> 00:04:45,870
أين ذهبت؟

53
00:04:45,870 --> 00:04:48,110
.ربّما ذهبت لإحضار شيء ما

54
00:04:48,110 --> 00:04:50,520
.أتساءل لماذا فتحت النّافذة

55
00:04:53,300 --> 00:04:54,330
.البيانو

56
00:04:54,330 --> 00:04:56,560
.ذهبت إلى غرفة الموسيقى في الأسفل

57
00:05:08,150 --> 00:05:10,830
!شكرًا لك! سمعنا عزفك بوضوح

58
00:05:10,830 --> 00:05:15,560
كيف يفترض بي أن أشجّع هكذا؟
...عليّ تعزيز قدرتي على التّحمّل

59
00:05:16,760 --> 00:05:19,240
.لدينا طريقة تدريب جيّدة

60
00:05:19,890 --> 00:05:21,590
تقصدين مثل الجري؟

61
00:05:22,370 --> 00:05:23,880
!صنع البوم بوم

62
00:05:28,360 --> 00:05:32,190
.لكن علينا خياطة زيّ كوتيتسو-سان أيضًا

63
00:05:32,190 --> 00:05:34,810
صحيح! فمن يدري متى سنتلقّى طلبنا التّالي؟

64
00:05:34,810 --> 00:05:36,890
!قد تنهال علينا الطّلبات من كلّ جهة

65
00:05:36,890 --> 00:05:41,120
.إذًا فقد كانت أزياؤكنّ من صنعكنّ

66
00:05:41,120 --> 00:05:42,900
.ما زال لدينا التّصميم

67
00:05:42,900 --> 00:05:48,030
...لست جيّدة في الخياطة
فهل تعتقد أنّ بإمكاني فعلها؟

68
00:05:50,530 --> 00:05:53,800
!هيّا، هيّا يا كوتيتشان

69
00:05:53,800 --> 00:05:55,750
...لم أسمع أبدًا بتشجيع يجعل المرء يفرّ

70
00:05:56,210 --> 00:05:58,860
.أمزح فحسب! سأساعدك

71
00:05:58,860 --> 00:06:01,340
.سينتهي في وقت قصير إن ساعدنا جميعنا

72
00:06:01,340 --> 00:06:02,960
.شـ-شكرًا لكنّ

73
00:06:03,290 --> 00:06:06,120
بالمناسبة، هل لديك آلة خياطة؟

74
00:06:06,120 --> 00:06:09,160
،نعم. لديّ واحدة في المنزل

75
00:06:09,160 --> 00:06:10,970
.لذلك على الأرجح أنّني سأخيطه هناك

76
00:06:10,970 --> 00:06:12,170
!ماذا؟

77
00:06:12,170 --> 00:06:13,230
!أنت عصريّة للغاية

78
00:06:13,230 --> 00:06:14,600
!إنّها محترفة

79
00:06:20,000 --> 00:06:23,480
.حسنًا، هذا أوّل تدريب لنا نحن الأربعة

80
00:06:23,480 --> 00:06:26,080
.شـ-شكرًا لضمّكنّ لي

81
00:06:26,080 --> 00:06:27,660
،أعرف أنّني قلتُها سابقًا

82
00:06:27,660 --> 00:06:30,360
لكنّ أوّل ما عليك فعله بخصوص الانضمام
!هو صنع البوم بوم

83
00:06:30,360 --> 00:06:32,150
!إنّ ذلك يمرّن جسدك أيضًا

84
00:06:33,160 --> 00:06:36,250
ما كنتِ لتصدّقي كم أنّ صنع
!البوم بوم يعدّ تدريبًا شاقًّا

85
00:06:36,640 --> 00:06:38,410
!لقد علّمتني هيزومي ذلك

86
00:06:38,410 --> 00:06:41,230
مـ-من صنع البوم بوم فقط؟

87
00:06:41,230 --> 00:06:43,690
...لنغيّر الموضوع

88
00:06:43,000 --> 00:06:44,880
تريد الهرب

89
00:06:44,880 --> 00:06:47,880
من يدري؟ قد يصبح ذلك تقليدًا
!لنادي التّشجيع

90
00:06:49,680 --> 00:06:51,140
...تقليد

91
00:06:51,140 --> 00:06:54,000
مهلاً، أنت سعيدة بشأن ذلك بالفعل؟

92
00:06:54,000 --> 00:06:56,200
.يمكننا صنع البوم بوم في يوم آخر

93
00:06:56,200 --> 00:06:59,260
.أمّا الآن، لنبدأ بمدّ أجسادنا

94
00:07:00,660 --> 00:07:02,800
.فلتدعن أجسادكنّ ترتاح بالكامل

95
00:07:02,800 --> 00:07:04,900
.سنبدأ بأعناقنا

96
00:07:05,480 --> 00:07:08,220
.قومي بما نقوم به وحسب يا كوتيتسو-سان

97
00:07:08,220 --> 00:07:09,400
...حـ-حسنًا

98
00:07:10,290 --> 00:07:13,240
،واحد، اثنان، ثلاثة، أربعة

99
00:07:13,240 --> 00:07:16,270
.خمسة، ستّة، سبعة، ثمانية

100
00:07:16,270 --> 00:07:17,760
.والآن من الجانب للجانب

101
00:07:17,760 --> 00:07:20,680
،واحد، اثنان، ثلاثة، أربعة

102
00:07:20,680 --> 00:07:24,050
.خمسة، ستّة، سبعة، ثمانية

103
00:07:24,050 --> 00:07:25,750
.والآن دور أكتافنا

104
00:07:26,210 --> 00:07:29,390
،واحد، اثنان، ثلاثة، أربعة

105
00:07:29,390 --> 00:07:32,260
.خمسة، ستّة، سبعة، ثمانية

106
00:07:33,110 --> 00:07:35,660
.والآن، سنقوم بثني ومدّ ركبنا

107
00:07:35,660 --> 00:07:39,310
حافظن على استقامة ظهوركنّ
.وأنزلوا أوراككنّ للأسفل

108
00:07:39,970 --> 00:07:43,130
،واحد، اثنان، ثلاثة، أربعة

109
00:07:43,130 --> 00:07:46,060
.خمسة، ستّة، سبعة، ثمانية

110
00:07:46,500 --> 00:07:49,320
،واحد، اثنان، ثلاثة، أربعة

111
00:07:46,900 --> 00:07:49,320
.كوتيتسو-سان، ظهرك ليس مستقيمًا

112
00:07:49,320 --> 00:07:51,930
...فـ-فعلاً؟ أنا آسفة

113
00:07:49,320 --> 00:07:52,570
.خمسة، ستّة، سبعة، ثمانية

114
00:07:54,350 --> 00:07:55,530
هل أنت بخير؟

115
00:07:55,530 --> 00:07:57,450
.نـ-نعم. أنا بخير

116
00:07:57,450 --> 00:07:59,160
.هذا صعب

117
00:07:59,160 --> 00:08:02,220
.لا أحد يجيد ذلك من أوّل محاولة

118
00:08:02,220 --> 00:08:06,680
هذا ما تقولينه، لكنّك قمتِ بكلّ
.هذا بشكل جيّد في أوّل محاولة لك

119
00:08:07,490 --> 00:08:08,550
فعلاً؟

120
00:08:08,550 --> 00:08:10,380
.أنت مذهلة يا أوكي-تشان

121
00:08:10,380 --> 00:08:12,740
.لطالما كانت أوكي جيّدة في الرّياضة

122
00:08:13,650 --> 00:08:16,430
لكن ما الّذي يعنيه ذلك في حالتي
عندما بدأت أوّل مرّة؟

123
00:08:18,020 --> 00:08:21,600
لكن من المستحيل أن أتغلّب عليك
!في الحماس يا كوهاني

124
00:08:21,600 --> 00:08:23,310
!أ-أتعتقدين ذلك؟

125
00:08:23,730 --> 00:08:26,310
!أوكي-تشان مذهلة

126
00:08:28,840 --> 00:08:31,950
،واحد، اثنان، ثلاثة، أربعة

127
00:08:31,950 --> 00:08:34,820
.خمسة، ستّة، سبعة، ثمانية

128
00:08:35,360 --> 00:08:38,410
،واحد، اثنان، ثلاثة، أربعة

129
00:08:36,900 --> 00:08:40,280
،هذه محاولتك الأولى يا كوتيتسو-سان
.لذلك لا تضغطي على نفسك كثيرًا

130
00:08:38,410 --> 00:08:41,200
.خمسة، ستّة، سبعة، ثمانية

131
00:08:41,600 --> 00:08:43,420
...جميعكنّ رائعات

132
00:08:43,420 --> 00:08:48,090
.لـ-لا تقلقي يا كوتيتشان
.ستصبحين مرنة مثلنا قريبًا

133
00:08:48,840 --> 00:08:50,960
!لستِ مقنعة كثيرًا

134
00:08:52,100 --> 00:08:53,820
.والآن، سنعمل على حركات أذرعنا

135
00:08:53,820 --> 00:08:57,470
بشكل عامّ، سنقوم بالوضعيّات
.باستعمال البوم بوم

136
00:08:58,020 --> 00:09:00,860
،هذه أوّل مرّة تقومين بهذا يا كوتيتسو-سان

137
00:09:00,860 --> 00:09:03,350
.لذلك حاولي المشاهدة فقط على المرآة اليوم

138
00:09:03,770 --> 00:09:07,450
لكنّنا نتدرّب في المدخل؟

139
00:09:07,450 --> 00:09:09,050
،إن رأتنا مُدرّسة ما

140
00:09:09,050 --> 00:09:13,360
فسنقول أنّنا نشجّع التّلميذات
.المتّجهات لمنازلهنّ

141
00:09:13,360 --> 00:09:16,070
لماذا قد تشجّعين من هنّ ذاهبات لمنازلهنّ؟

142
00:09:13,360 --> 00:09:16,730
!مرحى! مرحى! لنعد للمنزل

143
00:09:17,140 --> 00:09:20,530
.هنالك عدّة أنواع لحركات الأذرع

144
00:09:20,530 --> 00:09:21,990
.هذه هي الذّراعان للأعلى

145
00:09:22,640 --> 00:09:23,750
.الذّراعان للأسفل

146
00:09:24,400 --> 00:09:25,500
.الذّراعان الممدودان

147
00:09:26,100 --> 00:09:27,250
.الذّراعان المثنيّتان

148
00:09:27,890 --> 00:09:29,000
.الذّراعان المثنيّان للأسفل

149
00:09:29,590 --> 00:09:30,750
.المشابكة

150
00:09:31,350 --> 00:09:32,420
.التصّفيق

151
00:09:33,040 --> 00:09:36,860
هنالك حركات أخرى، لكنّ تعلّمها كلّها
،دفعة واحدة قد يكون صعبًا

152
00:09:36,860 --> 00:09:38,680
.لنقم بهذه فقط اليوم

153
00:09:38,680 --> 00:09:40,760
من الصّعب جعل يديك تقوم
.بالوضعيّة الصّحيحة

154
00:09:41,150 --> 00:09:47,020
حافظي دائمًا على جعل ظهر يديك
.وأصابعك في نفس المستوى

155
00:09:47,020 --> 00:09:49,120
المعذرة... هكذا؟

156
00:09:49,120 --> 00:09:51,510
.معصماك مثنيّان

157
00:09:53,960 --> 00:09:57,900
،عندما تثنين معصميك
.فإنّ البوم بوم ستتدلّى للأسفل

158
00:09:58,530 --> 00:10:02,890
،وإن حافظتِ على استقامة معصميك
.فستبدو البوم بوم أكثر جمالاً

159
00:10:02,890 --> 00:10:04,540
.فهمت

160
00:10:04,910 --> 00:10:07,560
.وأهمّ شيء في هذا هو الابتسام

161
00:10:07,560 --> 00:10:11,290
،إن لم تتمكّني من الابتسام بصدق من قلبك

162
00:10:11,290 --> 00:10:13,880
.لن تستطيعي تشجيع الآخرين

163
00:10:14,280 --> 00:10:16,670
.فهمت. الابتسام مهمّ

164
00:10:17,940 --> 00:10:20,300
.سنقوم بهتافاتنا بالدّور

165
00:10:21,000 --> 00:10:22,330
!أوّلاً، الذّراعان للأعلى

166
00:10:23,540 --> 00:10:24,310
!الذّراعان للأسفل

167
00:10:27,240 --> 00:10:28,480
هكذا؟

168
00:10:28,480 --> 00:10:30,490
.كوتيتسو-سان، تذكّري أن تبتسمي

169
00:10:30,490 --> 00:10:32,810
...صحيح، سأفعل

170
00:10:33,350 --> 00:10:35,080
!مرّة أخرى. الذّراعان للأسفل

171
00:10:36,680 --> 00:10:37,820
!الذّراعان المثنيّان

172
00:10:42,480 --> 00:10:45,540
!ابتسامة كوهاني-تشان مثاليّة

173
00:10:45,900 --> 00:10:49,620
ربّما ذلك بسبّب التّناقض بين
...أعلى جسدها وأسفله

174
00:10:53,330 --> 00:10:56,800
.والآن، لنقم بحركات الأذرع رفقة بعض الموسيقى

175
00:10:59,590 --> 00:11:00,580
!الذّراعان للأعلى

176
00:11:01,540 --> 00:11:02,680
.المشابكة

177
00:11:03,280 --> 00:11:04,300
!الذّراعان للأسفل

178
00:11:04,920 --> 00:11:06,180
.الذّراعان المثنيّان للأسفل

179
00:11:06,690 --> 00:11:08,680
!ابتسامة رائعة يا كوتيتشان

180
00:11:09,020 --> 00:11:10,690
أ-أهذا رأيك؟

181
00:11:11,290 --> 00:11:12,190
.التّصفيق

182
00:11:12,680 --> 00:11:13,900
!الذّراعان الممدودان

183
00:11:14,480 --> 00:11:15,520
!الذّراعان للأسفل

184
00:11:15,900 --> 00:11:17,560
!الذّراعان المثنيّان

185
00:11:17,560 --> 00:11:19,400
!هذا ممتع

186
00:11:20,760 --> 00:11:21,930
.إنّنا ننسجم معًا أكثر

187
00:11:21,930 --> 00:11:22,740
.نعم

188
00:11:29,020 --> 00:11:31,880
.لم يتبقّ لدينا وقت اليوم للتّدرّب على الرّقص

189
00:11:31,880 --> 00:11:34,170
.لقد قمنا بحفلة التّرحيب في البداية

190
00:11:34,520 --> 00:11:38,300
...لكنّ التّدريب كان صعبًا
.وخاصّة الابتسام طوال الوقت

191
00:11:38,670 --> 00:11:42,710
لا أنفكّ عن نسيان الابتسام
.لأنّني أركّز على الوضعيّات

192
00:11:43,350 --> 00:11:44,300
!الذّراعان للأعلى

193
00:11:45,910 --> 00:11:47,060
!التّصفيق

194
00:11:49,970 --> 00:11:52,240
.أنت تبتسمين يا كوتيتشان

195
00:11:52,240 --> 00:11:53,310
فعلاً؟

196
00:11:53,310 --> 00:11:55,310
!هتافك يا كوهاني

197
00:11:55,310 --> 00:11:59,800
!صحيح... الذّراعان المثنيّان للأعلى

198
00:11:59,800 --> 00:12:00,730
ماذا؟

199
00:12:00,730 --> 00:12:02,200
!لا وجود لتلك الحركة

200
00:12:02,840 --> 00:12:05,190
!لنبدأ من جديد! الذّراعان للأسفل

201
00:12:05,720 --> 00:12:06,780
.التّصفيق

202
00:12:07,810 --> 00:12:08,900
.الذّراعان المثنيّان للأسفل

203
00:12:09,750 --> 00:12:11,110
!الذّراعان الممدودان

204
00:12:24,560 --> 00:12:25,590
.الذّراعان للأعلى

205
00:12:26,640 --> 00:12:27,780
.الذّراعان للأسفل

206
00:12:35,320 --> 00:12:37,480
هل أنت بخير يا كوتيتسو؟

207
00:12:37,800 --> 00:12:42,740
عـ-عضلات متورّمة بما أنّني بدأت
...نشاطات النّادي البارحة

208
00:12:42,740 --> 00:12:47,000
.صحيح. انضممت لجمعيّة التّشجيع

209
00:12:47,000 --> 00:12:48,490
!صباح الخير

210
00:12:49,940 --> 00:12:51,840
ما الخطب يا كوتيتشان؟

211
00:12:51,840 --> 00:12:53,500
.عضلاتها متورّمة

212
00:12:53,500 --> 00:12:57,040
.صحيح... كنّا هكذا في البداية أيضًا

213
00:12:57,040 --> 00:12:59,130
!كوتيتشان! تذكّري الابتسام

214
00:13:00,280 --> 00:13:02,460
...نعم، لكن

215
00:13:02,890 --> 00:13:03,970
!الذّراعان للأعلى

216
00:13:06,360 --> 00:13:07,340
!الذّراعان الممدودان

217
00:13:08,690 --> 00:13:10,270
!الذّراعان المثنيّان

218
00:13:10,270 --> 00:13:12,470
مهلاً، ألم تكن عضلاتك متورّمة؟

219
00:13:12,470 --> 00:13:15,760
لقد أصبحت الحركات ردّات فعل
...مشروطة لها سلفًا

220
00:13:15,760 --> 00:13:16,760
!الذّراعان المثنيّان للأعلى

221
00:13:21,240 --> 00:13:24,090
.انتهى زيّ كوتيتشان أيضًا

222
00:13:25,110 --> 00:13:26,560
ما الخطب؟

223
00:13:26,560 --> 00:13:31,450
مـ-من المحرج أن أكون الوحيدة
...الّتي ترتدي الزّيّ

224
00:13:31,450 --> 00:13:33,370
!ماذا؟ لا تقلقي

225
00:13:33,660 --> 00:13:36,640
.إنّ أوكي مُحرَجة أكثر منك
.لقد نسيت أنّنا سنغيّر أزياء المدرسة اليوم

226
00:13:36,640 --> 00:13:38,000
!اخرسي، اخرسي

227
00:13:38,770 --> 00:13:41,090
...مهلاً لحظة. كوهاني

228
00:13:42,290 --> 00:13:45,560
هل أتيتِ إلى المدرسة باكرًا
عن قصد لأنّك عرفتِ ذلك؟

229
00:13:45,560 --> 00:13:49,710
،بالطّبع لا! كانت لديّ واجبات فصل اليوم
.لذلك أتيت باكرًا لأقوم بها

230
00:13:49,710 --> 00:13:51,220
...هـ-هكذا إذًا

231
00:13:51,220 --> 00:13:53,420
.لكنّني كنت آمل أن تكوني قد نسيت نوعًا ما

232
00:13:53,420 --> 00:13:54,720
!مشاكسة

233
00:13:54,720 --> 00:13:57,980
...لـ-لكن ربّما تكون هيزومي قد نسيت أيضًا

234
00:13:57,980 --> 00:13:59,560
.آسفة على التّأخّر

235
00:14:02,230 --> 00:14:03,730
ما الخطب؟

236
00:14:04,090 --> 00:14:07,740
لا شيء، لاحظنا أنّك تذكّرتِ أنّنا
.سنغيّر أزياء المدرسة اليوم

237
00:14:07,740 --> 00:14:09,770
.نسيت أوكي بالكامل

238
00:14:10,230 --> 00:14:11,240
...نعم

239
00:14:11,240 --> 00:14:16,520
،لقد نسيت ذلك هذا الصّباح أيضًا
...لكنّ أخي ذكّرني بذلك

240
00:14:16,900 --> 00:14:19,370
ستعتبر قلّة احترام للعالم إن فقدنا

241
00:14:19,370 --> 00:14:21,610
ولو يومًا واحدًا لم ترتدِ فتيات
.الثّانويّة أزياء الصّيف المدرسيّة

242
00:14:21,610 --> 00:14:23,210
.يمكن الاعتماد دائمًا على أخيك

243
00:14:23,210 --> 00:14:26,890
.أنا سعيدة لتواجدكنّ جميعًا هنا

244
00:14:26,890 --> 00:14:28,970
.لدينا طلب في الحقيقة

245
00:14:29,310 --> 00:14:30,970
طلب تشجيع؟

246
00:14:30,970 --> 00:14:35,470
سنتلقّى أخبارًا منهنّ قريبًا
.في غرفة اقتصاديّات المنزل

247
00:14:35,470 --> 00:14:37,160
!إنّه اليوم أيضًا

248
00:14:37,830 --> 00:14:40,890
،ترتدي كوتيتشان زيّها بالفعل
!لذلك فلنذهب

249
00:14:40,890 --> 00:14:42,040
!ماذا؟

250
00:14:42,040 --> 00:14:43,500
...لا، مهلاً

251
00:14:51,080 --> 00:14:53,670
.لم أقل أنّه طلب تشجيع

252
00:14:55,090 --> 00:14:57,370
.هذه رئيسة نادي اقتصاديّات المنزل

253
00:14:58,080 --> 00:15:00,560
آسفة لأنّني طلبت منكنّ
.الحضور إلى هنا فجأة

254
00:15:00,560 --> 00:15:03,750
،إنّه ليس طلب تشجيع بالضّبط
.لكنّنا نرغب في مساعدتكنّ

255
00:15:04,800 --> 00:15:08,190
أم أنّ الأمر لن يعمل إلاّ إن كان
طلب تشجيع بالتّحديد؟

256
00:15:08,190 --> 00:15:09,510
يعمل؟

257
00:15:09,900 --> 00:15:12,190
،سمعتُ أنّه عند تقديم طلبات لجمعيّة التّشجيع

258
00:15:12,190 --> 00:15:13,870
،فإنّ أيّ أمنية ستتحقّق

259
00:15:13,870 --> 00:15:15,360
،سواء كان علاقات شخصيّة

260
00:15:15,360 --> 00:15:16,600
،أو الدّراسة

261
00:15:16,600 --> 00:15:18,140
.أو الرّياضة

262
00:15:18,140 --> 00:15:20,640
ما هذا؟ ممّن سمعتِ هذا؟

263
00:15:21,190 --> 00:15:25,450
.يبدو أنّ أمنية صديقة أكيتسوني قد تحقّقت

264
00:15:25,450 --> 00:15:26,490
صديقة؟

265
00:15:26,490 --> 00:15:27,900
فعلاً؟

266
00:15:28,340 --> 00:15:33,040
،لا تعمل جمعيّتنا هكذا بالضّبط
!لكن سيسرّنا أن نساعدك

267
00:15:33,040 --> 00:15:36,410
لكن هل هنالك أيّ شيء يمكننا أن نساعد به؟

268
00:15:37,010 --> 00:15:42,100
نحتاج بعض المساعدة في تحديد القائمة
.الّتي سنعدّها لمسابقة الطّبخ القادمة

269
00:15:42,630 --> 00:15:44,790
.تذوّقن بعض الأطباق وقدّمن رأيكنّ فيها

270
00:15:44,790 --> 00:15:49,950
.لكنّ ذلك سيكون مبنيًّا على آرائنا الشّخصيّة

271
00:15:49,950 --> 00:15:51,130
ألا تمانعين ذلك؟

272
00:15:51,130 --> 00:15:53,160
.لا مشكلة، لا مشكلة

273
00:15:53,160 --> 00:15:57,010
أنتنّ أربعة، وهذا يكفي ليمثّل
.أذواق بقيّة البشريّة

274
00:15:57,010 --> 00:15:59,140
أ-أتعتقدين ذلك؟

275
00:16:00,550 --> 00:16:02,770
.لدينا عيّنات مختلفة

276
00:16:03,360 --> 00:16:07,520
.الطّبق الأوّل هو كرات الملفوف بصلصة القشدة

277
00:16:07,520 --> 00:16:09,770
!مذهل، يبدو شهيًّا

278
00:16:09,770 --> 00:16:12,260
.ما رأيكنّ؟ كنّ صريحات معنا

279
00:16:13,560 --> 00:16:15,030
بهذه السّرعة؟

280
00:16:15,360 --> 00:16:20,490
أنا... آسفة. أيمكنني تغيير ملابسي أوّلاً؟

281
00:16:20,490 --> 00:16:22,250
.أشعر كأنّني لا أنتمي إلى هذا المكان

282
00:16:22,250 --> 00:16:24,330
!آسفة يا كوتيتشان

283
00:16:26,970 --> 00:16:29,300
.الطّبق الثّاني عبارة عن دوريا مأكولات بحريّة

284
00:16:34,450 --> 00:16:36,150
!لذيذ للغاية

285
00:16:37,000 --> 00:16:39,930
.طبقنا الثّالث هو غراتان بالخضر الموسميّة

286
00:16:42,290 --> 00:16:44,190
!هذا لذيذ أيضًا

287
00:16:44,520 --> 00:16:49,690
الطّبق الرّابع هو كاربونارا، وهو طبق
.أصليّ خاصّ لثانويّة كامينوكي

288
00:16:50,560 --> 00:16:52,820
!أحببت هذا أيضًا

289
00:16:53,380 --> 00:16:59,200
!لذيذ

290
00:16:59,200 --> 00:17:02,280
المعذرة... ما الّذي تقومين به في كلّ مرّة؟

291
00:17:02,280 --> 00:17:03,710
!هذه حركة الذّراعان للأعلى

292
00:17:05,280 --> 00:17:09,590
.لا تقلقي بشأنهما. إنّها عادة لديهما

293
00:17:13,060 --> 00:17:15,930
أهنالك شيء تحبّين أكله؟

294
00:17:17,190 --> 00:17:18,570
ربّما الفاصولياء؟

295
00:17:18,570 --> 00:17:20,350
الفاصولياء فحسب؟

296
00:17:20,900 --> 00:17:22,910
...تحبّ هاتويا-سان الفاصولياء

297
00:17:22,910 --> 00:17:26,100
...هل هذا يعني أنّ ساواتاري-سان تحبّ

298
00:17:29,510 --> 00:17:31,910
!أيمكنك ألاّ تسخري منّي؟

299
00:17:33,440 --> 00:17:35,610
.هاتويا-سان، إليك حساء الفاصولياء الحمراء

300
00:17:37,390 --> 00:17:39,100
هل تلك حركة أذرع أخرى؟

301
00:17:39,100 --> 00:17:40,540
.نعم. إنّها التّصفيق

302
00:17:40,540 --> 00:17:43,240
.كلاّ، أعتقد أنّها ممتنّة فحسب

303
00:17:43,680 --> 00:17:45,320
.إليك بعض السّبانخ بالسّمسم والصّويا

304
00:17:47,840 --> 00:17:52,280
لـ-لم يتمّ غسل هذه السّبانخ
...بشكل جيّد كما هو واضح

305
00:17:52,280 --> 00:17:53,750
.عليّ إخبارها

306
00:17:54,640 --> 00:17:57,500
...المعذرة... هذه السّبانخ

307
00:17:57,500 --> 00:18:00,220
!أنا أعددتها

308
00:18:00,220 --> 00:18:01,820
ما رأيك؟ ما رأيك؟

309
00:18:03,850 --> 00:18:06,730
.مذاقها ترابيّ للغاية

310
00:18:07,000 --> 00:18:09,270
...أنت لا تخفين صراحتك جيّدًا

311
00:18:10,850 --> 00:18:14,110
.جميعكنّ بارعات في الطّبخ

312
00:18:14,410 --> 00:18:15,990
أليس كذلك؟

313
00:18:16,470 --> 00:18:20,990
الطّبخ ممتع كثيرًا. إنّه أيضًا تدريب
.جيّد لنا لنصبح الزّوجات المثاليّات

314
00:18:21,260 --> 00:18:22,240
زوجات؟

315
00:18:22,950 --> 00:18:25,250
هل لديك أحد ما ستتزوّجينه من الآن؟

316
00:18:31,520 --> 00:18:33,710
أنت صريحة للغاية، صحيح؟

317
00:18:33,710 --> 00:18:37,760
الأمر أشبه لقولي لكلّ ما يدور
...في بالي بشكل طبيعيّ

318
00:18:38,140 --> 00:18:40,190
.إذًا فأنت مثل كوهاني على الأرجح

319
00:18:40,190 --> 00:18:42,270
،إنّها تقول ما يخطر على بالها أيضًا

320
00:18:42,270 --> 00:18:44,410
.وتنسى كلّ شيء بعد أن تأخذ ثلاثة خطوات

321
00:18:44,410 --> 00:18:45,060
!ماذا؟

322
00:18:46,100 --> 00:18:47,560
.لا أعتقد أنّنا متشابهتان

323
00:18:47,560 --> 00:18:48,940
!أرأيت؟! أنت تقومين بذلك ثانية

324
00:18:52,100 --> 00:18:56,070
هذا مذهل للغاية. لا بدّ أنّ الطّبخ
.معًا ممتع للغاية

325
00:18:56,070 --> 00:18:58,080
هل أنت مهتمّة؟

326
00:18:58,080 --> 00:19:01,450
نحن نتحسّن في الطّبخ أسرع
.عندما نقوم بذلك كلّ أسبوع

327
00:19:02,990 --> 00:19:05,580
.من اللّطيف أنّك تستمتعين بينما تتعلّمين شيئًا ما

328
00:19:09,160 --> 00:19:11,640
ما خطب أريما-سان؟

329
00:19:11,640 --> 00:19:13,080
ألم يعجبها أيّ طبق؟

330
00:19:13,620 --> 00:19:19,640
.لتنضمّ إلى نادي اقتصاديّات المنزل

331
00:19:20,200 --> 00:19:21,660
!هيزومي، أوكي

332
00:19:22,520 --> 00:19:25,110
...يبدو الطّبخ ممتعًا، لذا

333
00:19:26,360 --> 00:19:28,680
!لنُقم مخيّم تدريبنا الخاصّ

334
00:19:28,680 --> 00:19:31,350
يسمّونك "قاعدة الأساس الحديديّة"، صحيح؟

335
00:19:33,360 --> 00:19:35,980
لا يجب أن يكون مخيّم التّدريب
!للتّدريب على الطّبخ

336
00:19:36,920 --> 00:19:39,050
."كما أنّ الجملة هي "الأساس المنيع

337
00:19:44,150 --> 00:19:47,370
.حسنًا، أعتقد أنّني حصلت على كلّ آرائكنّ

338
00:19:47,890 --> 00:19:50,910
.هذه طريقتنا على شكركنّ

339
00:19:52,040 --> 00:19:55,340
مهلاً، مهلاً! كلّ ما فعلناه
!هو الأكل وإعطاء رأينا

340
00:19:55,340 --> 00:19:57,170
!سأشعر بالسّوء حيال أكل هذا

341
00:19:57,630 --> 00:19:59,120
.كوهاني، لعابك يسيل

342
00:20:00,520 --> 00:20:03,550
...في الحقيقة، لقد تلقّينا طلبًا أيضًا

343
00:20:03,880 --> 00:20:05,680
.من فريق كرة السّلّة

344
00:20:06,400 --> 00:20:09,240
إنّهنّ يردن شكركنّ على تشجيعهنّ
،في ذلك اليوم

345
00:20:09,240 --> 00:20:12,490
.لكن لم يعتقدن أنّ بإمكانهنّ تقديم شيء جيّد لكنّ

346
00:20:13,430 --> 00:20:15,190
.كما أنّ القائدة خجولة للغاية

347
00:20:15,190 --> 00:20:17,560
...سينباي كرة السّلّة

348
00:20:17,560 --> 00:20:19,190
يشكرننا؟

349
00:20:19,530 --> 00:20:21,000
كلّ ما كان عليهنّ فعله

350
00:20:21,000 --> 00:20:25,320
هو إضافة جملة "جمعيّة التّشجيع
.رائعة" في نهاية كلّ جملة يقلنها

351
00:20:25,320 --> 00:20:27,330
!اللّبيب بالإشارة يفهم يا هيزومي

352
00:20:35,700 --> 00:20:37,840
.أعتقد أنّ بإمكاني أخيرًا فهم كلّ هذه الحركات

353
00:20:38,140 --> 00:20:40,620
.أعجبني هذا كثيرًا

354
00:20:40,620 --> 00:20:43,720
على الأرجح لأنّكنّ أعددتنّ هذا
.من أجلنا خصّيصًا

355
00:20:44,060 --> 00:20:45,790
...فهمت

356
00:20:45,790 --> 00:20:48,830
ربّما يمكننا أن نطبخ من أعماق
قلوبنا بشكل أكثر

357
00:20:48,830 --> 00:20:50,710
.عندما نعرف لمن سنطبخ

358
00:20:51,830 --> 00:20:53,820
.تفضّلي يا أريما-سان

359
00:20:54,760 --> 00:20:57,320
هل فكّرت في الأمر من الأساس؟

360
00:20:57,320 --> 00:21:00,020
!تقطيعها لأشكال جميلة لن يجعلها أفضل

361
00:21:00,480 --> 00:21:04,600
الأهمّ من ذلك، علينا الذّهاب لشكر
!سينباي كرة السّلّة

362
00:21:05,220 --> 00:21:07,460
!لكن سيكون من الخسارة عدم إنهاء كلّ شيء

363
00:21:08,500 --> 00:21:10,660
!شكرًا على الطّعام! هيّا بنا

364
00:21:11,400 --> 00:21:14,160
!ليس عليك غسل الأطباق، اذهبي فحسب

365
00:21:17,080 --> 00:21:18,080
!هيّا

366
00:21:18,510 --> 00:21:19,590
!أيّتها القائدة

367
00:21:21,220 --> 00:21:22,000
!أجل

368
00:21:22,000 --> 00:21:23,550
!يا سينباي كرة السّلّة

369
00:21:23,550 --> 00:21:26,800
!وصلتنا مشاعرك بكلّ وضوح

370
00:21:28,020 --> 00:21:29,550
ما-ما الّذي تتحدّين عنه؟

371
00:21:29,890 --> 00:21:31,420
ماذا؟ ماذا؟

372
00:21:31,420 --> 00:21:34,640
.أخبرتنا رئيسة نادي اقتصاديّات المنزل بكلّ شيء

373
00:21:34,640 --> 00:21:36,190
.لا أدري عمّ تتحدّثين

374
00:21:36,650 --> 00:21:40,320
!حسنًا، سنقوم بالتّشجيع لنشكرك على شكرنا

375
00:21:40,320 --> 00:21:41,720
!استمعي

376
00:21:41,720 --> 00:21:45,820
أرجوك! دعيني أعبّر عن مشاعري
!الفيّاضة بالتّشجيع

377
00:21:45,820 --> 00:21:49,570
.لكنّنا نقوم بتدريب عاديّ اليوم لا غير

378
00:21:49,570 --> 00:21:52,330
.أرجوك يا سينباي كرة السّلّة

379
00:21:52,650 --> 00:21:55,280
...إنّها الّتي تقوم بمنعها في العادة

380
00:21:55,280 --> 00:21:56,670
أهنّ ممتنّات لهذه الدّرجة؟

381
00:21:57,330 --> 00:21:59,740
!عليّ التّحرّك قدر الإمكان

382
00:21:59,740 --> 00:22:01,590
!إن لم أفعل، فسيندم جسدي على ذلك

383
00:22:02,000 --> 00:22:04,060
كم أكلتِ من طعام؟

384
00:23:38,390 --> 00:23:41,940
:في الحلقة القادمة
"!وضعيّة أساس مزدوجة حماسيّة جدًّا"