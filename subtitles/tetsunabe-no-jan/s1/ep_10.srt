1
00:00:04,190 --> 00:00:05,390
!مـ-مهلًا

2
00:00:05,390 --> 00:00:06,750
!هذه آداب أكل غير لائقة

3
00:00:06,750 --> 00:00:08,320
!لا نريد الجزر

4
00:00:08,320 --> 00:00:11,220
!وأنا أكره الفلفل الأخضر
!أريد اللّحم فقط

5
00:00:11,220 --> 00:00:12,410
!أنا أيضًا

6
00:00:12,410 --> 00:00:14,140
!لا خضار! لا نريدها

7
00:00:14,140 --> 00:00:16,390
...كلّ هذا ونحن في مطعم جميل كهذا

8
00:00:16,390 --> 00:00:18,050
.يا لهما من شقيين أنانيين

9
00:00:18,050 --> 00:00:19,320
.سأذهب لألقنهما درسًا

10
00:00:31,320 --> 00:00:34,560
سأعدّ طبقًا من الخضار

11
00:00:34,560 --> 00:00:37,060
يأكله حتّى الأطفال
.الذين لا يحبّون الخضار

12
00:02:17,840 --> 00:02:19,350
ما هذا بالضبط؟

13
00:02:19,350 --> 00:02:21,410
هل خلطت شيئًا فيه؟

14
00:02:21,410 --> 00:02:24,210
.يا لهُ من لون جميل

15
00:02:24,210 --> 00:02:25,810
.من الجزر

16
00:02:25,810 --> 00:02:28,590
ماذا، من الجزر؟ حقًا؟

17
00:02:28,590 --> 00:02:30,420
وضعتها في خلاط

18
00:02:30,420 --> 00:02:35,430
واستخدمت عصيره لعجن
.المعكرونة بدلًا من الماء

19
00:02:35,940 --> 00:02:38,770
هذا هو الطبق الذي كنتِ
...تعملين عليه كلّ ليلة

20
00:02:38,770 --> 00:02:40,310
.يمكنك فعلها يا كيريكو

21
00:02:40,760 --> 00:02:42,330
.عليّ أن أفوز

22
00:02:42,330 --> 00:02:45,530
هذا أفضل طبق معكرونة
...أُعدّه بكلّ إخلاص

23
00:02:45,530 --> 00:02:47,560
!شانهومين الخاص بي

24
00:02:48,440 --> 00:02:50,610
!انتهى الوقت

25
00:02:50,610 --> 00:02:52,820
!وهكذا انتهى الطبخ للجولة النهائية

26
00:02:53,430 --> 00:02:55,030
.حسن، النتيجة مثالية

27
00:02:55,030 --> 00:02:57,450
!لا يستطيع أحد هزيمة طبخي

28
00:02:57,790 --> 00:03:01,370
.فعلتُ كلّ ما بوسعي ولم أخطئ

29
00:03:01,370 --> 00:03:04,800
بذل متنافسونا الثلاثة كلّ جهدهم
!في أطباق المعكرونة هذه

30
00:03:04,800 --> 00:03:07,920
!لكن ماذا سيقول الحُكام؟

31
00:03:08,320 --> 00:03:10,630
.وصل الوغد الصغير إلى النهائيات

32
00:03:10,960 --> 00:03:12,450
...أكياما جان

33
00:03:12,450 --> 00:03:16,430
رتّبتُ هذه البطولة
.لطردك من عالم الطبخ

34
00:03:16,430 --> 00:03:19,140
!فلماذا ما زلتَ هنا؟

35
00:03:19,140 --> 00:03:21,160
!والآن، ليبدأ التحكيم

36
00:03:21,160 --> 00:03:24,520
!أولًا، طبق سيلين يانغ

37
00:03:26,380 --> 00:03:28,170
!هانشي شوجين مين الخاص بي

38
00:03:28,170 --> 00:03:30,860
.إنّه رافيولي بصلصة كورية

39
00:03:30,860 --> 00:03:32,860
.مقدّم مع مشروب فاتح للشهية. استمتعوا

40
00:03:32,860 --> 00:03:35,540
.هذا يُشبه المطبخ الأوروبي الراقي

41
00:03:35,540 --> 00:03:38,320
...اللّون والتقديم كلاهما جديدان

42
00:03:38,320 --> 00:03:40,910
،الغلاف من عجين سبعة أجزاء نشا

43
00:03:40,910 --> 00:03:43,200
.جزآن دقيق معكرونة، وجزء واحد دقيق قمح

44
00:03:43,200 --> 00:03:44,600
،يجعله النشا شفافًا

45
00:03:44,600 --> 00:03:47,160
."ومن هنا أتى اسم "المعكرونة الشفافة

46
00:03:49,290 --> 00:03:51,760
...هذه الشفافية، هذه المرونة

47
00:03:51,760 --> 00:03:54,260
لم أتذوق مثل هذه المعكرونة
!في الطعام الصّيني من قبل

48
00:03:54,260 --> 00:03:57,760
!أشم رائحة البحر
.لا بدّ أنّها معكرونة بحبر الحبّار

49
00:03:57,760 --> 00:04:00,880
إحساس المضغ يذكّرني بمعكرونة
.كونجاك الكورية الباردة

50
00:04:00,880 --> 00:04:03,570
الحلاوة الطفيفة للروبيان الطازج المفروم

51
00:04:03,570 --> 00:04:06,090
.تعزّز هذه الصلصة الحلوة الحارّة

52
00:04:06,090 --> 00:04:10,060
استخدام الكوتشوجانغ في طبق
!صيني أمر جديد حقًا

53
00:04:10,060 --> 00:04:11,810
.شكله فريد أيضًا

54
00:04:11,810 --> 00:04:14,910
.يبدو مثل رافيولي إيطالي. مبتكر جدًا

55
00:04:14,910 --> 00:04:18,780
التقديم أنيق وجميل كما
.كما متوقع من نوفيل شينوا

56
00:04:19,700 --> 00:04:22,170
!طبقٌ مُبتكر من حيثُ اللّون، الشكل، والطّعم

57
00:04:22,170 --> 00:04:24,050
.يا لهُ من طبقٍ مشرق ومبهج

58
00:04:24,050 --> 00:04:27,870
يمكنك أن تسمّيه مطبخًا
.صينيًا عالميًا بلا حدود

59
00:04:27,870 --> 00:04:32,040
!التّالي، طبق أكياما جان

60
00:04:34,040 --> 00:04:36,300
،هذا هو داوشاومين الخاص بي

61
00:04:36,300 --> 00:04:40,630
مقدّم مع ثلاثة صلصات مختلفة
روبيان لو، زا جان، شانشيان لو

62
00:04:40,630 --> 00:04:42,510
.تذوقوا أيً صلصة تريدونها

63
00:04:43,060 --> 00:04:43,890
...إذًا

64
00:04:49,040 --> 00:04:50,520
!رائع

65
00:04:50,520 --> 00:04:51,810
!هذا لذيذ

66
00:04:51,810 --> 00:04:53,060
.نعم صحيح

67
00:04:53,060 --> 00:04:54,860
كمية الماء في عجين داوشاومين

68
00:04:54,860 --> 00:04:58,100
.تختلف حسب درجة الحرارة والرطوبة

69
00:04:58,100 --> 00:05:01,770
،إن لم يُعجَن بشكل صحيح
.فقد تتأثر صلابته وطعمه

70
00:05:01,770 --> 00:05:03,240
.لكن هذا أُنجِز بإتقان

71
00:05:03,240 --> 00:05:06,090
تقديم ثلاث صلصات مختلفة
.فكرة رائعة أيضًا

72
00:05:06,090 --> 00:05:08,560
الأطراف الرفيعة للمعكرونة

73
00:05:08,560 --> 00:05:11,180
.تمسك بنكهات الصلصة ولا تفلتها

74
00:05:11,180 --> 00:05:15,040
لكن الجزء السميك في الوسط
.يتيح لك الاستمتاع بالمعكرونة نفسها

75
00:05:15,040 --> 00:05:17,460
.لا يكفّ أكياما عن إدهاشنا

76
00:05:21,460 --> 00:05:25,440
.أنتم مثيرون للشفقة
.لا تفهمون الأمر إطلاقًا

77
00:05:26,010 --> 00:05:27,240
عذرًا؟

78
00:05:27,240 --> 00:05:28,930
ماذا؟ عمّ تتحدث؟

79
00:05:28,930 --> 00:05:30,870
.هذه مواجهة معكرونة

80
00:05:30,870 --> 00:05:34,130
أيّ أنّها منافسة في أومامي
معكرونتنا، صحيح؟

81
00:05:37,230 --> 00:05:39,990
.إذًا أخيرًا، تذوقوا هذا

82
00:05:41,120 --> 00:05:42,690
ما الذي يحاول فعله؟

83
00:05:42,690 --> 00:05:44,230
...ذلك السائل الأسود

84
00:05:44,230 --> 00:05:45,160
!هيّا

85
00:05:46,070 --> 00:05:47,390
...أهذا

86
00:05:48,070 --> 00:05:50,160
.انتظر يا شو-سان

87
00:05:50,160 --> 00:05:53,580
!هـ-هذه... هذه الرائحة

88
00:05:55,250 --> 00:05:56,340
الرائحة...؟

89
00:05:57,840 --> 00:06:01,160
!نعم، هذه هي! هذه الرائحة

90
00:06:01,450 --> 00:06:05,140
!أتذكر! تذكرت الآن

91
00:06:12,200 --> 00:06:13,490
...هذه المعكرونة

92
00:06:15,520 --> 00:06:20,900
!تفوح هذه المعكرونة برائحة الطبيعة الصينية

93
00:06:21,190 --> 00:06:23,340
أ-أمن خطب ما يا شو-سان؟

94
00:06:23,340 --> 00:06:24,660
ماذا يحدث؟

95
00:06:25,050 --> 00:06:26,160
.إنّه الخل الأسود

96
00:06:26,160 --> 00:06:28,030
خـ-خل أسود؟

97
00:06:28,030 --> 00:06:32,370
ذلك الداوشاومين مغطّى بخلّ
.أسود من مقاطعة شانشي

98
00:06:32,370 --> 00:06:34,420
هذه هي حقيقة السائل الأسود إذًا؟

99
00:06:34,760 --> 00:06:37,410
.شو-سان ينحدر من شانشي

100
00:06:37,410 --> 00:06:41,170
.ربّما يوقظ الخلّ الأسود ذكرياته

101
00:06:41,170 --> 00:06:44,530
.بالضبط! هذا خل شانشي الأسود

102
00:06:44,530 --> 00:06:47,660
!وليس أيّ خل، بل خلّ أكياما السري المعتّق

103
00:06:47,660 --> 00:06:49,260
!هيّا، تذوقوه

104
00:06:53,000 --> 00:06:54,060
...هذا

105
00:06:54,060 --> 00:06:56,560
!إنّه أشبه بتجسيد للنكهات التقليدية

106
00:06:56,560 --> 00:06:59,300
!غني جدًا! مع حموضة معتدلة

107
00:06:59,300 --> 00:07:01,470
من كان يتوقع أنّ داوشاومين بخل أسود

108
00:07:01,470 --> 00:07:03,360
سينتج نكهة بهذا الغنى؟

109
00:07:03,360 --> 00:07:08,290
إنّه أشبه بتذوق هواء وأرض مقاطعة
.شانشي الصينية مع كلّ قضمة

110
00:07:08,290 --> 00:07:10,990
!مذهل! هذا مذهل

111
00:07:10,990 --> 00:07:14,640
.هل فهمتُم الآن؟ المعكرونة مُجرّد طحين

112
00:07:14,640 --> 00:07:16,730
والخلّ الأسود هو الذي يظهر

113
00:07:16,730 --> 00:07:19,520
الحلاوة القصوى والأومامي
!في دقيق القمح

114
00:07:19,520 --> 00:07:22,360
!هذا هو داوشاومين الخاص بي

115
00:07:26,330 --> 00:07:28,930
.دورك الآن يا كيريكو

116
00:07:28,930 --> 00:07:32,640
."أريني ما يقدمه هذا "الطبخ بالقلب

117
00:07:33,680 --> 00:07:39,290
،وأخيرًا، متسابقتنا الثالثة
!غوبانتشو كيريكو وطبقها

118
00:07:39,290 --> 00:07:40,980
.شكرًا جزيلًا

119
00:07:48,910 --> 00:07:52,990
،هونشانهو مين جين
.معكرونة باردة بلون المرجان الأحمر

120
00:07:52,990 --> 00:07:55,870
استمتعوا رجاء بها مع صلصة
.الغمس المقدمة معها

121
00:07:55,870 --> 00:08:00,210
يا له من مشهد جميل! إنّه
!مقدّم على منحوتة جليدية جميلة

122
00:08:00,210 --> 00:08:01,550
!مذهل

123
00:08:00,210 --> 00:08:03,090
!تظهر غوبانتشو موهبة مذهلة

124
00:08:01,550 --> 00:08:03,090
!جميل

125
00:08:03,090 --> 00:08:05,990
.تساءلتُ لِم استغرق تحضيرها وقتًا طويلًا

126
00:08:05,990 --> 00:08:07,420
!هل صنعت تلك المنحوتة؟

127
00:08:07,420 --> 00:08:09,010
...منحوتة جليدية

128
00:08:09,010 --> 00:08:13,260
نعم، لطالما كانت بارعة
.في تلك الأعمال اليدوية

129
00:08:13,260 --> 00:08:15,350
!والآن، لنبدأ التذوق

130
00:08:15,730 --> 00:08:18,390
.أُعِدَّ بطريقة تسهّل أكله

131
00:08:18,390 --> 00:08:22,060
،خضار ولحم ملفوفان في المعكرونة
.تُلتقط بالعيدان بسهولة

132
00:08:22,060 --> 00:08:24,150
...وهذه المعكرونة البرتقالية

133
00:08:24,150 --> 00:08:25,650
...لنتذوق

134
00:08:31,410 --> 00:08:34,920
.فهمت! لها رائحة جزر مميّزة

135
00:08:34,920 --> 00:08:38,580
واللفائف تحقق توازنًا مثاليًا
!بين اللّحم والخضار بداخلها

136
00:08:38,580 --> 00:08:42,500
.مبتكرة جدًا! وطبق مناسب للذوق العصري

137
00:08:42,500 --> 00:08:46,800
البيتا كاروتين في الجزر رائج جدًا
.في عالم الغداء الصحي الآن

138
00:08:46,800 --> 00:08:50,490
،الحشوة هي تشار شو
...لسان بقر بصلصة صويا

139
00:08:50,490 --> 00:08:53,720
.إضافة إلى شرائح خيار، جزر، وبصل

140
00:08:53,720 --> 00:08:56,430
.لسان البقر لم يُطبخ في لوشوي فقط أيضًا

141
00:08:56,430 --> 00:08:59,690
.أميّز رائحة زهرية ناعمة لميغوري لو جيو

142
00:09:02,080 --> 00:09:04,570
.ما يفاجئني أكثر هو صلصة الغمس التي أعدّتها

143
00:09:04,570 --> 00:09:08,190
.أساسُها مُجرد شيتاكي مجفف وكرنب

144
00:09:08,520 --> 00:09:11,500
.ومع ذلك تحمل طعمًا عميقًا بشكل مذهل

145
00:09:11,500 --> 00:09:12,890
!يا لها من مفاجأة

146
00:09:12,890 --> 00:09:15,120
صلصة أساسها مرق خضار؟

147
00:09:15,120 --> 00:09:17,410
!لحظة، هل أعدّت مرق الخضار الفرنسي؟

148
00:09:17,650 --> 00:09:20,940
إنّها نوع من الصلصات صارت
!رائجة في المطبخ الفرنسي مؤخرًا

149
00:09:20,940 --> 00:09:22,870
واختارت استخدامها؟

150
00:09:22,870 --> 00:09:25,630
.هذا عمل رقيق يليق بفتاة شابّة

151
00:09:25,630 --> 00:09:28,610
،لا أثر ظاهر للخضار في هذه الصلصة

152
00:09:28,610 --> 00:09:30,760
.لكنّك تشعر بكامل قوّة أومامي الخضار

153
00:09:30,760 --> 00:09:33,400
والعجيب أنّ صلصة نباتية بالكامل

154
00:09:33,400 --> 00:09:37,450
!يمكنها أن تبرز لذّة لسان البقر

155
00:09:37,450 --> 00:09:39,530
!تفوّقتِ على نفسك

156
00:09:39,530 --> 00:09:41,100
.شكرًا

157
00:09:42,270 --> 00:09:45,360
.سيئ، أثنيتُ عليها بصدق

158
00:09:45,360 --> 00:09:49,170
.ويُقدّم على قطعة فنية تقليدية، بينغ دياو

159
00:09:49,170 --> 00:09:52,770
يُستخدم لتقديم طبق أنيق
مثل شانهومين

160
00:09:52,770 --> 00:09:55,530
...مع حساء شوجين كصلصة

161
00:09:55,530 --> 00:09:59,480
،كلّ عنصر مصقول بدقة

162
00:09:59,480 --> 00:10:01,420
.كلّها تجتمع بانسجام واضح

163
00:10:01,420 --> 00:10:04,370
!لا أجد سوى كلمة "مذهل" للوصف

164
00:10:04,990 --> 00:10:07,670
كما هو متوقع من الجيل
.القادم لعائلة غوبانتشو

165
00:10:07,670 --> 00:10:10,910
.تحقيق طباخة شابة لشيء كهذا أمر مذهل

166
00:10:11,720 --> 00:10:13,470
ما رأيك يا أكياما؟

167
00:10:13,820 --> 00:10:16,430
.هكذا أطبخ بالقلب

168
00:10:18,510 --> 00:10:22,830
وهكذا، بالإضافة إلى
اثني عشر حكمًا أساسيًا

169
00:10:22,830 --> 00:10:26,230
.أنهينا الآن تذوق مائة حكم من الجمهور

170
00:10:26,230 --> 00:10:32,240
صوّتوا رجاء للطّاهي الذي
!استمتعتُم بطبقه أكثر

171
00:10:32,240 --> 00:10:35,740
!سنبدأ بالتصويت من الجمهور

172
00:10:35,740 --> 00:10:38,240
!كلّ صوت يساوي نقطة واحدة

173
00:10:38,240 --> 00:10:41,490
،وجّهوا أنظاركم إلى لوحة النتائج

174
00:10:41,490 --> 00:10:44,200
!سنرى أرقامًا مذهلة الآن

175
00:10:44,200 --> 00:10:46,500
!من سيتصدّر في البداية؟

176
00:10:46,500 --> 00:10:51,610
!ما هذا؟ الفارق ضئيل جدًا

177
00:10:51,610 --> 00:10:53,400
!يا له من حدث غير متوقع

178
00:10:53,400 --> 00:10:55,750
!كما هو متوقع من الجولة النهائية

179
00:10:55,750 --> 00:10:58,260
!هؤلاء الطهاة متقاربون جدًا في المستوى

180
00:10:58,260 --> 00:11:01,540
من سيتصدر في رأيك يا رئيس الطهاة؟

181
00:11:01,540 --> 00:11:03,800
.بدت كلّ الأطباق رائعة

182
00:11:03,800 --> 00:11:07,290
لكنّني أرى أنّ طبق
.جان كان مميزًا رغم ذلك

183
00:11:07,290 --> 00:11:10,020
حصوله على مثل هذه النتيجة
...رغم كُره الجميع له

184
00:11:10,320 --> 00:11:14,400
.كما أنّ أحد الحكام بكى عند تذوّقه

185
00:11:14,400 --> 00:11:17,480
،قد يرى جان الطبخ منافسة

186
00:11:17,480 --> 00:11:20,910
لكنّه قادر على إعداد
!طعام يمس القلوب

187
00:11:20,910 --> 00:11:23,670
.قدمّ الثلاثة عملًا ممتازًا

188
00:11:23,670 --> 00:11:28,540
لكن أحدهم... أعدّ طبقًا
.بعيب حاسم

189
00:11:28,540 --> 00:11:30,540
ماذا؟ ما-ما قصدك؟

190
00:11:30,540 --> 00:11:34,580
من أدرك نوع الطبق الذي
...أرادهُ الحكام في النهائي

191
00:11:34,580 --> 00:11:36,800
.هذا هو العامل الذي يحدد المنتصر

192
00:11:36,800 --> 00:11:42,060
والآن إلى نتائج الاثنا عشر حكمًا

193
00:11:42,060 --> 00:11:46,520
لكن هذا الطاهي طبخ دون
.أن يضع ذلك في اعتباره

194
00:11:50,650 --> 00:11:54,740
وضعت نتائج الجمهور الطهاة
.الثلاثة على مُستوى متقارب

195
00:11:54,740 --> 00:11:57,990
!تتزايد الأرقام بوتيرة مدهشة

196
00:11:57,990 --> 00:12:00,620
!لكن ما هي النتيجة؟

197
00:12:03,450 --> 00:12:06,390
!غوبانتشو كيريكو في المركز الأول

198
00:12:06,390 --> 00:12:09,900
!مجموع نقاطها 124

199
00:12:09,900 --> 00:12:11,590
!هذا هائل

200
00:12:11,590 --> 00:12:12,840
!نعم

201
00:12:12,840 --> 00:12:15,430
!التالية هي سيلين يانغ

202
00:12:15,430 --> 00:12:19,090
!مجموع نقاطها... 93

203
00:12:19,360 --> 00:12:23,760
ماذا؟ خسِر طبقي أمام طبق كيريكو؟

204
00:12:23,760 --> 00:12:27,900
...وأخيرًا، نتيجة أكياما جان

205
00:12:27,900 --> 00:12:29,480
!هـ-هذا؟

206
00:12:30,290 --> 00:12:32,190
!ثلاثة وثلاثون فقط

207
00:12:32,190 --> 00:12:35,930
!لم ينل أكياما جان سوى 33 نقطة

208
00:12:35,930 --> 00:12:38,750
!لم تتغيّر نتيجته بعد تصويت الجمهور

209
00:12:38,750 --> 00:12:44,370
لم يمنحه أيّ حكم نقطة
!واحدة على طبقه الداوشاومين

210
00:12:44,370 --> 00:12:48,370
!أكياما جان في المركز الثالث بفارق كبير

211
00:12:49,160 --> 00:12:50,530
.كما توقعتُ

212
00:12:50,530 --> 00:12:54,000
حقًا؟ كيف حدث هذا يا رئيس الطهاة؟

213
00:13:02,840 --> 00:13:04,760
!ما الذي يجري؟

214
00:13:05,100 --> 00:13:08,020
!فسّروا لي هذه النتيجة

215
00:13:08,020 --> 00:13:10,270
!على أحدكم أن يقدّم جوابًا مقنعًا

216
00:13:10,660 --> 00:13:11,900
...أكياما

217
00:13:11,900 --> 00:13:13,980
.لم يستوعب الأمر حقًا

218
00:13:14,270 --> 00:13:16,400
!كيف أحرزت صفرًا؟

219
00:13:16,400 --> 00:13:18,990
.اضبط أعصابك. هذا المشهد مثير للشفقة

220
00:13:18,990 --> 00:13:24,160
كان طبقك داوشاومين ناقصًا
.جدًا مقارنة بالطبقين الآخرين

221
00:13:24,160 --> 00:13:25,740
ألا تفهم هذا؟

222
00:13:26,610 --> 00:13:28,490
!كيف أفهم؟

223
00:13:28,490 --> 00:13:30,910
!أعلم أنّ الداوشاومين الذي أعددته لذيذ

224
00:13:30,910 --> 00:13:34,080
.أعددتُ معكرونة ألذ من الاثنين

225
00:13:34,480 --> 00:13:36,750
!أنتم اعترفتم بذلك

226
00:13:37,180 --> 00:13:39,250
.نعم، كانت لذيذة

227
00:13:40,130 --> 00:13:43,520
.الداوشاومين الذي أعددتَهُ لذيذ

228
00:13:43,520 --> 00:13:47,730
...المعكرونة، الصلصات الثلاث
.كلّ شيء كان ممتازًا

229
00:13:48,100 --> 00:13:49,640
.لكن هذا كلّ ما في الأمر

230
00:13:50,610 --> 00:13:53,750
كلُّ ما فعلتَهُ هو أخذ طبق
موجود مسبقًا

231
00:13:53,750 --> 00:13:55,560
.وأعددته بشكل أفضل من الآخرين

232
00:13:55,560 --> 00:13:57,980
.ولم تضف شيئًا جديدًا

233
00:13:57,980 --> 00:13:58,980
!ماذا؟

234
00:13:58,980 --> 00:14:01,240
.لا توجد روح شباب في طبقك

235
00:14:01,240 --> 00:14:03,410
.لا إبداع ولا تطوّر

236
00:14:03,410 --> 00:14:05,940
.إنّه يظهر مهارات عالية لكنّها موجودة مسبقًا

237
00:14:05,940 --> 00:14:09,550
قد يكونُ الداوشاومين من
،أعظم أطباق المعكرونة

238
00:14:09,550 --> 00:14:12,950
.لكنّك لم تفعل سوى الحفاظ على التقليد

239
00:14:12,950 --> 00:14:15,310
أين أصالتُك؟

240
00:14:15,310 --> 00:14:18,880
أردنا أن نتذوّق طبق معكرونة
.يحمل بصمتك الخاصّة

241
00:14:19,350 --> 00:14:21,960
لم ترتكب المتنافستان الأخرتان
.هذا الخطأ

242
00:14:21,960 --> 00:14:24,130
.أعدّتا أطباقًا مميزة

243
00:14:24,430 --> 00:14:29,660
طبق يانغ هانشي شوجين مين
.كان أشبه بلقاء شيء جديد كُليًا

244
00:14:29,660 --> 00:14:31,390
.لكنّه كان جديدًا أكثر ممّا ينبغي للأسف

245
00:14:31,680 --> 00:14:35,770
سيستغرقُ قبول شيء كهذا
.على الأرجح وقتًا تدريجيًا

246
00:14:35,770 --> 00:14:38,820
واستخدامكِ لمُكوّن كوري
غير موجود في المطبخ الصيني

247
00:14:38,820 --> 00:14:42,440
.كان تجاوزًا قليلًا للقواعد ما أفقدكِ نقاطًا

248
00:14:42,880 --> 00:14:45,610
كانت المشكلة الأخرى
.في مكوّناتكِ المفرومة

249
00:14:45,610 --> 00:14:47,950
،يبدو أنّك لجأتِ لآلة فرم

250
00:14:47,950 --> 00:14:52,330
.لكن كان الأفضل أن تُقطعيها بسكين يدويًا

251
00:14:52,330 --> 00:14:55,120
يبدو أنّهم راقبوا العملية
بأكملها حقًا إذًا؟

252
00:14:55,120 --> 00:14:59,250
.ثم نأتي إلى طبق غوبانتشو كيريكو

253
00:14:59,250 --> 00:15:03,400
قُدِّم بشكل جميل عاكسًا
معتقد المطبخ الصيني بالتوازن الغدائي

254
00:15:03,400 --> 00:15:07,760
.بطريقة تناسب العصر وبخيال بديع

255
00:15:07,760 --> 00:15:11,520
.مُغذٍ، سهل الأكل ولذيذ

256
00:15:11,520 --> 00:15:14,430
كان طبقًا مثاليًا تشعر
.فيه بحرص على من سيأكله

257
00:15:14,430 --> 00:15:20,480
كان جوهر هذه المنافسة
!الإبداع في أطباق المعكرونة

258
00:15:20,480 --> 00:15:25,330
لم يتضمّن طبقك أيّ نظرة
.مستقبلية للمطبخ الصيني

259
00:15:25,330 --> 00:15:27,070
.ولهذا السبب خسرتَ

260
00:15:27,070 --> 00:15:29,800
.لا يقتصر الأمر على إعداد طبق ألذ

261
00:15:29,800 --> 00:15:31,790
هل فهمتَ يا أكياما؟

262
00:15:41,440 --> 00:15:44,000
!مبروك يا غوبانتشو

263
00:15:44,000 --> 00:15:45,380
.شكرًا جزيلًا

264
00:15:45,380 --> 00:15:48,810
!كيف خطرت لكِ فكرة طبق كهذا؟

265
00:15:49,140 --> 00:15:53,430
لم يكُن ليخطر ببالي لو
.اعتبرتُ الطّبخ مُجرد منافسة

266
00:15:53,970 --> 00:15:57,890
.أعتقد أنّ الطبخ ينبع من القلب

267
00:15:58,200 --> 00:16:00,170
أعددتُ هونشانهو مين جين هذا

268
00:16:00,170 --> 00:16:03,020
ليكون وسيلة لمساعدة الأطفال
الذين يكرهون الخضار

269
00:16:03,020 --> 00:16:05,940
.على إدراك طعمها الطيب

270
00:16:16,660 --> 00:16:18,760
!هذا جزاؤك يا أكياما

271
00:16:18,760 --> 00:16:19,870
!خسرتَ

272
00:16:19,870 --> 00:16:21,040
!وتستحق ذلك

273
00:16:21,040 --> 00:16:23,160
لا ينبغي لطاه حقير مثلك

274
00:16:23,160 --> 00:16:26,760
!أن يصل إلى النهائيات أصلًا

275
00:16:26,760 --> 00:16:30,140
!لا ترموا القمامة رجاء يا سيّداتي وسادتي

276
00:16:30,140 --> 00:16:32,180
!توقفوا رجاء

277
00:16:34,970 --> 00:16:39,190
!نعم، هذا هو
!هذا ما سعيتُ إليه

278
00:16:39,190 --> 00:16:42,650
!الجمهور كلّه ضدك الآن

279
00:16:42,650 --> 00:16:45,860
...عليّ أن أستغل هذا

280
00:16:45,860 --> 00:16:47,180
!هذا جزاؤك يا أكياما

281
00:16:47,180 --> 00:16:48,110
!أيّها الطاهي الفاسد

282
00:16:48,110 --> 00:16:51,540
تقول أنّ الطبخ منافسة؟
!يا لك من أحمق

283
00:16:51,540 --> 00:16:53,490
!عليك أن تعتزل الطبخ

284
00:16:54,640 --> 00:16:57,000
هل اتضح لك الأمر الآن يا أكياما؟

285
00:16:57,000 --> 00:17:01,080
!لن يعترف أحد بطاهٍ شرير مثلك

286
00:17:01,080 --> 00:17:04,400
أرسلتَ الحكام إلى المستشفى
بحساء الفطر السام الذي أعددتَه

287
00:17:04,400 --> 00:17:06,830
واعتمدتَ على تفوقك التقني
!لتطيح ببقية الطهاة

288
00:17:06,830 --> 00:17:09,300
!كلّها حيل جبانة

289
00:17:09,300 --> 00:17:11,960
طاهٍ مثلك يستخدم أيّ وسيلة للفوز

290
00:17:11,960 --> 00:17:14,890
!هو أسوأ نوع من الطهاة

291
00:17:14,890 --> 00:17:17,350
!والنتيجة تثبت ذلك

292
00:17:17,350 --> 00:17:19,360
!العدالة لا ترحم الأشرار

293
00:17:19,360 --> 00:17:22,620
!وهذا ما يشهد به كلّ الحاضرين

294
00:17:22,620 --> 00:17:24,400
!أليس هذا صحيحًا يا سادة؟

295
00:17:24,400 --> 00:17:25,970
!صحيح، أخبره يا أوتاني

296
00:17:25,970 --> 00:17:27,210
!بالضبط

297
00:17:27,210 --> 00:17:28,780
!وبّخه مجددًا

298
00:17:28,780 --> 00:17:34,160
اهرب الآن ذليلًا أيّها
!الطاهي المسعور المجنون

299
00:17:34,160 --> 00:17:34,890
!صحيح

300
00:17:34,890 --> 00:17:36,240
!غادر يا أكياما

301
00:17:34,890 --> 00:17:36,240
...اللّعنة عليك يا أوتاني

302
00:17:36,240 --> 00:17:37,990
!اغرب عن وجوهنا

303
00:17:37,990 --> 00:17:47,960
!عُد أدراجك! عُد أدراجك! عُد أدراجك

304
00:17:39,710 --> 00:17:41,290
.صار الوضع بشعًا

305
00:17:41,780 --> 00:17:45,660
.أكياما... لا يمكنك الطبخ لمجرد الفوز

306
00:17:45,660 --> 00:17:47,960
!إنّما تطبخه لأجل من يأكله

307
00:17:47,960 --> 00:17:52,540
إن طبختَ للفوز فقط
.فستُعادي كلّ النّاس

308
00:17:47,960 --> 00:17:59,920
!عُد أدراجك! عُد أدراجك! عُد أدراجك

309
00:17:52,540 --> 00:17:54,430
!كيف لا تدرك هذا؟

310
00:17:54,690 --> 00:17:56,430
.نلتُ منه كما أردت

311
00:17:56,430 --> 00:17:59,920
!هذا جزاؤه لأنّه أحرجني

312
00:17:59,920 --> 00:18:04,600
!لا أحد يعبث مع أوتاني نيشيدو

313
00:17:59,920 --> 00:18:14,690
!عُد أدراجك! عُد أدراجك! عُد أدراجك

314
00:18:04,880 --> 00:18:09,280
!يا سلام

315
00:18:09,280 --> 00:18:14,690
!لم أشعر بهذا الرضا قط

316
00:18:14,690 --> 00:18:17,990
!عُد أدراجك! عُد أدراجك! عُد أدراجك

317
00:18:27,060 --> 00:18:29,030
!خسرت! خسرت

318
00:18:29,030 --> 00:18:32,880
!خسرت... خسِر أسلوب أكياما في الطبخ

319
00:18:39,240 --> 00:18:44,280
،الندوب على ظهري
...تجسيد لهوسي أنا وجدّي

320
00:18:44,280 --> 00:18:49,650
!ألحقتُ العار به
!جعلت أسلوب طبخ أكياما مسخرة

321
00:18:50,640 --> 00:18:53,400
!أشعر بخزي شديد! أريد أن أختفي

322
00:18:55,410 --> 00:18:56,450
!اللّعنة

323
00:18:56,450 --> 00:19:02,720
!اللّعنة! اللّعنة

324
00:18:58,200 --> 00:18:59,280
!اللّعنة

325
00:19:02,720 --> 00:19:07,420
!اللّعنة على كلّ شيء

326
00:19:16,880 --> 00:19:20,430
.بصراحة... لم أتوقع تلك النتيجة

327
00:19:20,430 --> 00:19:21,590
.نعم

328
00:19:22,930 --> 00:19:25,700
.سأذهب لأطمئن على جان

329
00:19:27,630 --> 00:19:29,550
...آمل أن يكون بخير

330
00:19:29,550 --> 00:19:32,690
.ليس معتادًا على الخسارة

331
00:19:42,570 --> 00:19:46,040
!ما-ماذا حدث هنا؟

332
00:19:48,200 --> 00:19:51,330
ما-ماذا أصاب ظهرك...؟

333
00:19:51,330 --> 00:19:53,050
...وأيضًا

334
00:20:01,980 --> 00:20:03,580
...دماء

335
00:20:06,530 --> 00:20:08,360
.فهمت

336
00:20:16,230 --> 00:20:17,610
جان...؟

337
00:20:17,610 --> 00:20:18,680
.أوكونوغي

338
00:20:19,790 --> 00:20:21,290
كيريكو-سان؟

339
00:20:21,290 --> 00:20:22,540
ما الأمر؟

340
00:20:22,540 --> 00:20:23,870
...في الواقع

341
00:20:24,330 --> 00:20:26,750
.جان... فقد صوابه

342
00:20:31,380 --> 00:20:34,880
!صحيح! محال أن يخسر آل أكياما

343
00:20:38,330 --> 00:20:39,870
...أكياما

344
00:20:42,640 --> 00:20:45,520
.اقترب وقت المرحلة الثانية

345
00:20:45,520 --> 00:20:47,930
.أتساءل أيّ نوع من التحلية سنرى

346
00:20:49,800 --> 00:20:51,250
،أكياما

347
00:20:51,250 --> 00:20:55,800
كشفتَ أنّك بلا أصالة في
.طبق المعكرونة ذلك

348
00:20:55,800 --> 00:20:59,730
.لن يستطيع ابتكار أيّ شيء للتحلية

349
00:21:01,280 --> 00:21:04,020
.الأفضل ألّا تكمل يا أكياما

350
00:21:04,020 --> 00:21:06,740
.لا تخاطر وتتألم أكثر

351
00:21:06,740 --> 00:21:09,870
.انسحب فهذا الأفضل لك

352
00:21:12,450 --> 00:21:13,860
.نـ-نعم

353
00:21:13,860 --> 00:21:17,420
حضور أكياما لم يعد مهمًا

354
00:21:17,420 --> 00:21:21,310
.لم يعد يشكّل أيّ تهديد بنتيجته تلك

355
00:21:21,310 --> 00:21:24,940
.هذا يعني أنّك هدفي الوحيد يا كيريكو-تشان

356
00:21:39,480 --> 00:21:40,770
!أكياما؟

357
00:21:50,280 --> 00:21:52,330
!الطّبخ منافسة

358
00:21:53,060 --> 00:21:56,000
...أنتما الاثنان والحكام

359
00:21:58,690 --> 00:22:02,050
.سأجعلُ منكم جميعًا فوضى دامية