1
00:00:02,440 --> 00:00:03,690
بقرةٌ ضائعة

2
00:00:05,060 --> 00:00:06,860
على الأرجح أنَّها بقرةٌ ضائعة

3
00:00:07,060 --> 00:00:10,250
الكانجي لكلمة "بقرة" هي جزءٌ من كلمة "حلزونة"، أليس كذلك؟

4
00:00:10,230 --> 00:00:15,320
خُذ رمز الدوَّامة الأوَّل، ثمَّ استبدل رمز الماء إلى رمز
الحشرات، أضف إليها رمز البقرة وستحصل على حلزونة

5
00:00:15,740 --> 00:00:20,260
توجد العديد من الأشياء الغريبة والتي تُصيب النَّاس بالحيرة

6
00:00:20,620 --> 00:00:25,790
لكن إن كانت من تِلك النوعيَّة وأسمت نفسها
بالحلزونة الضائعة فهي بقرةٌ ضائعة، أليس كذلك؟

7
00:02:00,000 --> 00:02:01,760
ربما حان الوقت للتكلم بشأن العطلة الربيعية

8
00:02:01,760 --> 00:02:02,720
كان يوما ربيعيا

9
00:02:02,720 --> 00:02:03,510
هُجم علي من قبل مصاصة دماء

10
00:02:03,510 --> 00:02:04,170
من قبل شيطانٍ بارع الجمال

11
00:02:04,170 --> 00:02:04,800
هُجمت من قبل شيطانٍ جميل
سبب تجمد الدماء في عروقي

12
00:02:04,800 --> 00:02:05,340
،نتيجةً لذلك
أصبحت مصاص دماء

13
00:02:05,340 --> 00:02:05,840
من أنقذني من ذاك الجحيم كان عابر سبيلٍ اسمه أوشينو ميمي

14
00:02:05,840 --> 00:02:06,300
وساعدني لاستعيد إنسانيتي

15
00:02:06,300 --> 00:02:06,720
حسنٌ، ليست روايةً بتلك الأهمية

16
00:02:06,720 --> 00:02:07,050
نهايتها لم تكن سعيدةً البتة

17
00:02:07,050 --> 00:02:07,390
لقد انتهت هذه المسألة وحُلّت سلفا
ما تبقّى منها هو توجب شرب الدم مرةّ بالشهر على الأقل
بالإضافة إلى أن بصري أقوى البشر بقليل
هذه أصبحت أشياء بديهية ضمن قدراتي
خصوصا وأن هناك بعض الأشياء علي مواجهتها في الحياة وليست بتلك الصعوبة

18
00:02:07,390 --> 00:02:07,720
...رغم هذا

19
00:02:07,720 --> 00:02:08,010
اعتبر نفسي محظوظا
لأن الأمر لم يستغرق مني سوى عطلتي الربيعية

20
00:02:08,010 --> 00:02:08,220
أما من جهةٍ أخرى
فحال سينجوغاهارا مختلف

21
00:02:08,220 --> 00:02:08,510
لقد أُجبرت طوال سنتين
على التعايش مع إزعاجات جسدها
التي تعيق وتحد من حريتها

22
00:02:08,510 --> 00:02:08,720
أتساءل كيف هي سنتان من الجحيم؟

23
00:02:08,720 --> 00:02:09,510
تدحرج

24
00:02:08,930 --> 00:02:09,720
دائرة

25
00:02:09,720 --> 00:02:10,510
A

26
00:02:10,600 --> 00:02:15,020
حلزون مايوي، الجزء الثاني

27
00:02:10,600 --> 00:02:15,020
الحلقة الرابعة

28
00:02:40,680 --> 00:02:41,680
لقد كان هُنا

29
00:02:43,140 --> 00:02:46,390
المنزلُ الذي أعيشُ فيه كان هُنا بالضَّبط

30
00:02:47,520 --> 00:02:50,730
منزل؟ هذا شارع

31
00:02:50,730 --> 00:02:52,520
أعادوا تشكيل المنطقة

32
00:02:52,520 --> 00:02:56,110
لقد مرَّت سنةٌ واحدة فقط

33
00:02:58,690 --> 00:03:02,990
لقد بعناه، لذا لم أتوقَّع بأنَّ المنزل سيبقى

34
00:03:02,990 --> 00:03:05,160
لكن لا يزال الأمر يُشعرني بالكآبة

35
00:03:05,160 --> 00:03:07,120
نعم، هو كذلك

36
00:03:09,330 --> 00:03:12,580
الحديث عن هذا مضيعةٌ للوقت

37
00:03:12,580 --> 00:03:14,500
لنذهب يا أراراجي

38
00:03:15,090 --> 00:03:16,050
هل انتهيتِ؟

39
00:03:16,050 --> 00:03:17,000
أجل انتهيت

40
00:03:17,630 --> 00:03:18,670
فهمت

41
00:03:18,670 --> 00:03:20,380
هيَّا بنا يا هاتشيكوجي

42
00:03:32,100 --> 00:03:36,360
هيَّا اترُكيني يا هاتشيكوجي، فأنا أمشي بصعوبةٍ بسببك

43
00:03:37,730 --> 00:03:39,570
قولي شيئًا، كفاكِ صمتا

44
00:03:39,570 --> 00:03:44,240
ليس الأمر كما لو أنَّني أرغب في الالتصاق بساقك القذرة كالقَمْلَة

45
00:03:44,240 --> 00:03:46,490
!أنت فظيع! سأبلغ الـ "بي تي آي" عليك

46
00:03:47,450 --> 00:03:48,580
الـ "بي تي آي"؟

47
00:03:48,580 --> 00:03:51,160
الـ "بي تي آي" مُنظَّمةٌ رائعة

48
00:03:51,160 --> 00:03:58,050
أنت مُجرَّدُ قاصرٍ بلا أيِّ نفوذ، وحياتك موضوعةٌ على
الميزان، وبإمكانهم إنهائها بوضع أصبعٍ واحدٍ فقط

49
00:03:59,340 --> 00:04:02,130
أصبعٍ واحد؟ هذا مُخيف

50
00:04:02,130 --> 00:04:05,590
بالمناسبة يا هاتشيكوجي، ما معنى الـ "بي تي آي"؟

51
00:04:03,380 --> 00:04:05,590
سؤال
ما معنى "بي تي آي"؟

52
00:04:05,590 --> 00:04:07,220
...إنَّهُ

53
00:04:07,220 --> 00:04:11,520
الـ "بي تي آي" اختصارٌ لجمعية الآباء والمعلِّمين

54
00:04:12,060 --> 00:04:14,100
هذا يعني أنَّها مكوَّنة من الآباء والمعلِّمين

55
00:04:15,100 --> 00:04:20,070
"أيضًا هو اختصارٌ لمصطلحٍ طبِّي "توسيع الأوعية من خلال الجلد

56
00:04:21,070 --> 00:04:27,320
لكن لا أظنُّ بأنَّ هذا ما تُريده، بل جمعيَّة الآباء والمُعلِّمين

57
00:04:28,490 --> 00:04:30,950
تعرفين كلَّ شيء يا سينجوغاهارا

58
00:04:30,950 --> 00:04:33,870
يبدو ذلك بالنسبة لك لأنَّك جاهلٌ وغير كُفؤ

59
00:04:34,250 --> 00:04:37,540
لا أمانع بأن تتمَّ مُناداتي بالجاهل

60
00:04:37,540 --> 00:04:40,050
لكن أليس "غير كُفؤ" قاسٍ بعض الشيء؟

61
00:04:40,050 --> 00:04:43,340
حقًّا؟ إذًا سأناديك بالبائس في المرَّة القادمة

62
00:04:52,730 --> 00:04:54,100
بالمناسبة يا هاتشيكوجي

63
00:04:54,100 --> 00:04:55,810
ماذا هُناك يا أراراجي؟

64
00:04:55,810 --> 00:04:58,610
ما هو العنوان المكتوب؟

65
00:05:00,940 --> 00:05:03,360
!لن أتحدَّث! سأختار الصَّمت

66
00:05:04,700 --> 00:05:06,780
إن لم تُخبريني فلن آخذكِ إليه

67
00:05:06,780 --> 00:05:09,330
لم أطلب منك ذلك، بإمكاني الذهاب لوحدي

68
00:05:09,330 --> 00:05:10,870
لكنَّكِ ضائعة، أليس كذلك؟

69
00:05:10,870 --> 00:05:12,240
وماذا في ذلك؟

70
00:05:13,750 --> 00:05:16,500
استمعي إليَّ يا هاتشيكوجي

71
00:05:16,500 --> 00:05:20,880
كمرجعٍ لكِ في المُستقبل، من الأفضل أن
تطلبي مُساعدة الآخرين عندما يحدثُ لكِ هذا

72
00:05:21,130 --> 00:05:24,920
ربَّما سأفعل ذلك إن كُنتُ مِثلك ولا أثقُ بنفسي

73
00:05:25,260 --> 00:05:27,380
بإمكانك طلب المُساعدة من النَّاس كيفما تشاء

74
00:05:27,380 --> 00:05:30,390
لكنَّني لا أحتاجُ لذلك

75
00:05:30,390 --> 00:05:34,560
فِعل ذلك مِثل استخدام ماكينة البيع يوميًّا

76
00:05:35,730 --> 00:05:36,940
إذًا لا مجال للتفاوض؟

77
00:05:36,930 --> 00:05:37,680
O

78
00:05:38,060 --> 00:05:40,230
فهمت يا سيِّدتي

79
00:05:40,230 --> 00:05:45,530
من فضلكِ أخبريني، إلى أيِّ مكانٍ يُشيرُ إليه هذا العنوان؟

80
00:05:45,530 --> 00:05:47,530
لا تبدو صادقًا

81
00:05:48,980 --> 00:05:49,230
إطارٌ أسود

82
00:05:48,980 --> 00:05:49,230
مشهد غير مرقم

83
00:05:49,910 --> 00:05:53,620
سيكون هذا كافيًا لانتزاع الحقيقة من أخواتي

84
00:05:53,620 --> 00:05:57,460
لا أستطيع مُعاملة هاتشيكوجي وكأنَّها طِفلةٌ غبيَّة

85
00:05:57,460 --> 00:05:59,670
يا إلهي. ماذا عليَّ أن أفعل؟

86
00:06:00,790 --> 00:06:02,550
سأعطيكِ علاوةً أيَّتها الشابة

87
00:06:03,710 --> 00:06:05,010
سأخبرك بأيِّ شيء

88
00:06:05,000 --> 00:06:06,210
إنها طفلةٌ غبية

89
00:06:05,000 --> 00:06:06,210
مشهد رقم 86

90
00:06:05,010 --> 00:06:06,220
بل طِفلةٌ غبيَّة

91
00:06:07,330 --> 00:06:08,210
إطارٌ أسود

92
00:06:07,330 --> 00:06:08,210
مشهد غير مرقم

93
00:06:08,590 --> 00:06:11,710
امرأةٌ تُدعى تسونادي تعيش هُناك

94
00:06:14,350 --> 00:06:16,520
إذًا... ما علاقتكِ بها؟

95
00:06:16,520 --> 00:06:17,690
إنَّها قريبةٌ لي

96
00:06:17,690 --> 00:06:22,440
قريبة؟ ألا يجبُ أن تكوني في المنزل وتُظهري
بعض الاحترام لعائلتك في يوم الأم؟

97
00:06:22,430 --> 00:06:26,400
أختٌ صغرى توبخ أخاها الأكبر

98
00:06:22,430 --> 00:06:26,400
مشهد رقم 95

99
00:06:22,440 --> 00:06:24,400
...إن كُنتَ ستتصرَّف هكذا يا أخي

100
00:06:24,400 --> 00:06:26,400
...إن استمرَّيت في ذلك، ومهما طال الزمن

101
00:06:26,400 --> 00:06:28,650
لا أريدُ سماع ذلك مِنك

102
00:06:28,650 --> 00:06:30,860
وما الذي تعرفينه عنِّي؟

103
00:06:30,860 --> 00:06:31,950
مُجرَّدُ إحساس

104
00:06:31,950 --> 00:06:36,660
كُنت تُضيِّعُ وقتك في المنتزه طِوال يوم الأحد

105
00:06:36,660 --> 00:06:38,960
الأشخاص العاديُّون لا يفعلون هذا

106
00:06:38,960 --> 00:06:40,040
...لقد كُنتُ

107
00:06:41,130 --> 00:06:42,210
أتجوَّل

108
00:06:42,210 --> 00:06:44,710
تتجوَّل؟ هذا مُذهل

109
00:06:45,880 --> 00:06:47,880
فقط على درَّاجتي

110
00:06:47,880 --> 00:06:51,840
هكذا إذًا؟ التجوُّلُ يجب أن يكون على درَّاجةٍ ناريَّة

111
00:06:51,840 --> 00:06:53,390
...يا للأسف

112
00:06:53,390 --> 00:06:56,970
قوانين المدرسة تمنعني من أخذ رُخصةٍ للدرَّاجات الناريَّة

113
00:06:54,010 --> 00:06:54,380
A

114
00:06:57,680 --> 00:06:59,980
على أيَّة حال، إنَّها خطِرةٌ جدًّا

115
00:06:59,980 --> 00:07:01,810
أفضِّلُ الحصول على سيارة

116
00:07:03,020 --> 00:07:04,310
هكذا إذًا

117
00:07:04,310 --> 00:07:07,900
لكن إن فعلت ذلك، ستُصبح مُتجوِّلًا بأربع عجلات

118
00:07:08,190 --> 00:07:11,780
إنَّها تستخدم معنى التجوال بشكلٍ مُضحكٍ وخاطئ

119
00:07:17,950 --> 00:07:20,830
لكن، الطرُقُ هُنا حقًّا مُعقَّدة

120
00:07:20,830 --> 00:07:24,420
لا أصدِّقُ أنَّكِ أردتِ القدوم إلى هُنا لوحدك

121
00:07:24,710 --> 00:07:26,920
هذه ليست المرَّةُ الأولى

122
00:07:26,920 --> 00:07:29,760
حقًّا ؟ إذًا لمَ أنتِ ضائعة؟

123
00:07:31,430 --> 00:07:33,140
لم آتِ إلى هُنا منذُ وقتٍ طويل

124
00:07:33,680 --> 00:07:36,560
...بالمناسبة يا أراراراجي

125
00:07:36,560 --> 00:07:38,020
!نطقتِ حرفين إضافيين

126
00:07:38,020 --> 00:07:39,560
المعذرة، لقد عضضت لساني

127
00:07:39,560 --> 00:07:41,770
كُفّي عن التلعثم وجعل الأشياء تبدو سيِّئة

128
00:07:42,980 --> 00:07:44,440
ما باليد حيلة

129
00:07:44,440 --> 00:07:47,150
جميعُ النَّاس يتلعثمون

130
00:07:47,150 --> 00:07:51,570
أم تُحاول القول أنَّك لم تتلعثم من قبل؟

131
00:07:48,480 --> 00:07:49,690
A

132
00:07:51,570 --> 00:07:53,320
لا أستطيع القول بأنني لم أفعل ذلك

133
00:07:53,320 --> 00:07:56,070
لكنَّني لا أتلعثم في أسماء الآخرين

134
00:07:56,070 --> 00:07:56,870
...إذًا

135
00:07:56,070 --> 00:07:57,150
A

136
00:07:58,620 --> 00:08:01,620
قُل "انفجار بنزين الباص" ثلاث مرَّات

137
00:08:01,620 --> 00:08:03,290
هذا ليس اسم شخص

138
00:08:03,290 --> 00:08:06,960
بل هو كذلك! أعرف ثلاثة أشخاص باسمٍ كهذا

139
00:08:06,960 --> 00:08:10,670
ولهذا، فهو اسمٌ شائع

140
00:08:11,260 --> 00:08:14,260
انفجار بنزين الباص، انفجار بنزين الباص، انفجار بنزين الباص

141
00:08:14,260 --> 00:08:15,760
الكائن الذي يأكلُ الأحلام هو...؟

142
00:08:16,380 --> 00:08:16,590
إطارٌ أسود

143
00:08:16,380 --> 00:08:16,590
مشهد غير مرقم

144
00:08:17,050 --> 00:08:17,720
التابير؟

145
00:08:17,720 --> 00:08:19,680
إجابةٌ خاطئة

146
00:08:20,020 --> 00:08:22,140
...الكائن الذي يأكلُ الأحلام هو

147
00:08:23,520 --> 00:08:24,650
الإنسان

148
00:08:24,650 --> 00:08:26,440
كُفيّ عن التظاهر بالذكاء

149
00:08:27,390 --> 00:08:28,390
إطارٌ أسود

150
00:08:27,390 --> 00:08:28,390
مشهد غير مرقم

151
00:08:28,730 --> 00:08:30,230
بالمناسبة يا أراراجي

152
00:08:31,650 --> 00:08:33,820
هلَّا أخبرتني بالعنوان مرَّةً أخرى

153
00:08:33,820 --> 00:08:35,410
...لا بأس

154
00:08:35,400 --> 00:08:36,650
إطارٌ أسود

155
00:08:35,400 --> 00:08:36,650
مشهد غير مرقم

156
00:08:37,570 --> 00:08:39,790
يبدو أنَّنا ابتعدنا قليلًا

157
00:08:39,790 --> 00:08:41,250
حقًّا؟

158
00:08:41,250 --> 00:08:43,370
إن أردتَ لومي فافعل ذلك

159
00:08:43,370 --> 00:08:46,250
كلَّا، لن ألومكِ على شيءٍ بسيط

160
00:08:46,250 --> 00:08:47,210
فهمت

161
00:08:56,890 --> 00:09:00,010
لمَ أنتِ خائفةٌ من سينجوغاهارا؟

162
00:09:00,760 --> 00:09:03,480
أشعرُ بأنَّها تكرهُني

163
00:09:03,480 --> 00:09:07,310
وتعتبرني عائقًا، وتريدني أن أختفي

164
00:09:07,310 --> 00:09:10,020
لا أظنُّ بأنَّها هكذا إلى هذا الحد

165
00:09:11,690 --> 00:09:13,280
بالمُناسبة يا سينجوغاهارا

166
00:09:13,280 --> 00:09:14,320
ماذا هُناك؟

167
00:09:14,320 --> 00:09:16,160
هل تكرهين الأطفال؟

168
00:09:16,160 --> 00:09:17,910
أكرهُهُم، وأُبغضُهُم

169
00:09:17,900 --> 00:09:19,860
إطارٌ أحمر

170
00:09:17,900 --> 00:09:19,860
مشهد غير مرقم

171
00:09:17,910 --> 00:09:19,870
أتمنَّى أن يموتوا جميعًا

172
00:09:21,030 --> 00:09:23,410
لا أعرف كيف أتعامل معهم

173
00:09:23,790 --> 00:09:25,790
ربَّما يعود ذلك لمَ حدث في المرحلة المتوسِّطة

174
00:09:25,790 --> 00:09:30,880
خرجت من أحد المتاجر بعدما اشتريت بعض
الحاجيات، ثمَّ اصطدمتُ بطفلٍ في السابعة من عُمره

175
00:09:30,880 --> 00:09:33,130
وبدأ بالبكاء؟

176
00:09:33,130 --> 00:09:34,840
كلَّا، ليس هذا ما حدث

177
00:09:35,220 --> 00:09:39,300
...عندها قُلتُ لذلك الطفل

178
00:09:39,300 --> 00:09:45,260
"هل أنت بخير؟" "هل تأذيت؟" "أرجو المعذرة، أنا آسفة"

179
00:09:39,760 --> 00:09:45,020
"هل أنت بخير؟ هل تأذَّيت؟ أرجو المعذرة، أنا آسفة"

180
00:09:45,730 --> 00:09:50,230
لا أعلم ما الذي عليَّ قولهُ لطفل. لقد فقدتُ صوابي

181
00:09:50,610 --> 00:09:54,650
...لكن بسبب ذلك... بسبب أنَّني تعاملتُ مع الموقف بشكلٍ سيِّئ

182
00:09:55,190 --> 00:09:57,110
لقد صُدِمتُ من نفسي

183
00:09:57,900 --> 00:10:04,870
ومنذُ ذلك اليوم، سواءً كانوا بشرًا أم لا، فأنا أكرهُهُم

184
00:10:09,040 --> 00:10:10,500
على كلٍّ يا أراراجي

185
00:10:10,500 --> 00:10:11,460
ما الأمر؟

186
00:10:11,920 --> 00:10:14,170
يبدو أنَّنا ذهبنا بعيدًا مرَّةً أخرى

187
00:10:14,170 --> 00:10:15,800
أتقصدين العنوان؟

188
00:10:15,800 --> 00:10:17,090
لقد حدث هذا مرَّتين

189
00:10:17,380 --> 00:10:20,010
إن أردتَ لومي فافعل ذلك واستمر

190
00:10:20,010 --> 00:10:22,300
كلَّا، لن ألومكِ على شيءٍ بسيط

191
00:10:22,300 --> 00:10:23,430
مهلًا

192
00:10:23,930 --> 00:10:27,850
سينجوغاهارا، ألمْ تقولي هذا للتوِّ قبل قليل؟

193
00:10:27,850 --> 00:10:29,270
أظنُّ ذلك

194
00:10:29,270 --> 00:10:30,190
ما خطبُكِ؟

195
00:10:30,190 --> 00:10:34,320
فهمت. هذا بسبب إعادة تشكيل المنطقة، صحيح؟

196
00:10:34,320 --> 00:10:36,650
كلَّا، ليس كذلك

197
00:10:36,990 --> 00:10:39,820
ليس الأمر وكأن الطُّرُق القديمة قد اختفت تمامًا

198
00:10:40,160 --> 00:10:42,280
لستُ ضائعة

199
00:10:43,660 --> 00:10:45,080
ما الذي تفعلينه؟

200
00:10:45,080 --> 00:10:48,660
"سأستخدمُ نظام المِلاحة "جي بي إس

201
00:10:49,910 --> 00:10:51,370
إطارٌ أسود

202
00:10:49,910 --> 00:10:51,370
مشهد غير مرقم

203
00:10:54,340 --> 00:10:55,380
ماذا هُناك؟

204
00:10:57,510 --> 00:10:59,800
لقد خرج عن نِطاق الخدمة فجأةً

205
00:11:03,180 --> 00:11:04,140
...هذا

206
00:11:07,810 --> 00:11:09,520
ربَّما لا فائدة من ذلك

207
00:11:11,020 --> 00:11:13,400
مهما حاولنا فلن نصل إلى هُناك

208
00:11:14,900 --> 00:11:15,730
هاتشيكوجي

209
00:11:16,900 --> 00:11:19,610
لن أجد طريقي إلى هُناك

210
00:11:20,030 --> 00:11:23,120
لن أصل إلى والدتي

211
00:11:24,280 --> 00:11:28,330
لأنَّني حلزونةٌ ضائعة

212
00:11:25,650 --> 00:11:26,860
حلزون

213
00:11:25,650 --> 00:11:26,860
مشهد رقم 221

214
00:11:34,210 --> 00:11:37,250
...لأنَّنا لم نستطِع العثور على المكان المطلوب

215
00:11:37,250 --> 00:11:39,200
قُمنا باستشارة أوشينو

216
00:11:40,500 --> 00:11:44,300
A

217
00:11:40,720 --> 00:11:44,300
هل تعرفين أين هو؟ أو رُبَّما عليَّ الذهاب عِوضًا عنكِ

218
00:11:45,260 --> 00:11:51,940
قلقك على أنَّ ذاكرتي ستكون بمستوى ذاكِرَتك لا يجعلني سعيدةً أبدًا

219
00:11:51,940 --> 00:11:54,060
من الأفضل أن أقول أنَّني مُحبطة

220
00:11:54,690 --> 00:11:56,020
هكذا إذًا

221
00:11:57,190 --> 00:11:58,090
وأعني

222
00:11:58,060 --> 00:11:58,310
همس

223
00:11:58,060 --> 00:11:58,310
مشهد رقم آي 233

224
00:11:59,220 --> 00:12:02,570
لا تتركني وحدي مع طفلة

225
00:12:01,060 --> 00:12:01,520
مشهد رقم آي 233

226
00:12:01,060 --> 00:12:04,070
همس

227
00:12:02,560 --> 00:12:04,070
مشهد رقم ه 233

228
00:12:04,070 --> 00:12:06,070
A

229
00:12:13,580 --> 00:12:19,920
بعد الحديث الذي دار بيني وبين سينجوغاهارا، قامت بزيادة حذرها ثانيةً

230
00:12:21,880 --> 00:12:25,340
لقد ذكرتِ أمَّكِ قبل قليل، صحيح؟

231
00:12:25,340 --> 00:12:28,430
ألم تقولي أنَّ تسونادي قريبةٌ لَكْ؟

232
00:12:25,750 --> 00:12:26,760
تسونادي

233
00:12:25,750 --> 00:12:26,760
مشهد رقم بي 243

234
00:12:30,100 --> 00:12:35,850
هاتشيكوجي، سأشتري لكِ بعض الآيسكريم إن اقتربتِ منِّي قليلًا

235
00:12:37,730 --> 00:12:38,690
!لنذهب

236
00:12:39,650 --> 00:12:43,640
...بخصوص ما قُلتهِ قبل قليل... عن والدتُكْ

237
00:12:45,070 --> 00:12:47,200
الأمُّ تُعتبرُ قريبةً أيضًا، أليس كذلك؟

238
00:12:47,200 --> 00:12:49,580
...قد يكون ذلك صحيحًا، ولكن

239
00:12:50,830 --> 00:12:56,000
حتَّى وإن أسميتها بأمِّي، فهي لم تعُدْ كذلك للأسف

240
00:12:58,340 --> 00:13:02,170
تسونادي كان اسميَ الأخير حتَّى الصفِّ الثالث

241
00:13:02,170 --> 00:13:06,340
وعندما أخذني أبي، غيَّرتُهُ إلى هاتشيكوجي

242
00:13:06,340 --> 00:13:12,350
هذا مُحرج، لأنَّني كُنتُ أنصحكِ بزيارة والدتك

243
00:13:12,350 --> 00:13:16,650
كلَّا، لم آتِ إلى هُنا بسبب يوم الأم

244
00:13:16,650 --> 00:13:20,610
سأذهبُ إلى والدتي متى ما سنحت الفُرصة لذلك

245
00:13:21,480 --> 00:13:22,690
فهمت

246
00:13:22,690 --> 00:13:26,910
ولهذا مهما بحثت، لم أستطِع الوصول إلى هُناك أبدًا

247
00:13:27,160 --> 00:13:30,280
وبعدها التقيتِ بالحلزون؟

248
00:13:30,280 --> 00:13:32,910
لا أعلم إن كُنَّا قد التقينا

249
00:13:34,410 --> 00:13:37,620
لا بُدَّ وأنَّكِ مررتِ بالكثير من المشاكل

250
00:13:39,620 --> 00:13:40,080
إطارٌ أحمر

251
00:13:39,620 --> 00:13:40,080
مشهد غير مرقم

252
00:13:40,090 --> 00:13:42,550
!مؤلـ ... ما الذي تفعلينه أيَّتها الطِفلَة؟

253
00:13:43,590 --> 00:13:46,630
!هذا مؤلم! مؤلم! مؤلم! مؤلم

254
00:13:56,010 --> 00:13:56,680
فاكهةٌ لم تنضج بعد

255
00:13:56,010 --> 00:13:56,680
مشهد رقم 279

256
00:14:10,320 --> 00:14:12,490
كلَّا، هذا لا يدعو للضَّحِك

257
00:14:12,990 --> 00:14:17,960
النَّصرُ المُتكرِّر يقود إلى مشاعر فارغة

258
00:14:19,170 --> 00:14:23,800
...وهناك وقف طالب الثانويَّة، ولأسبابٍ سخيفة

259
00:14:23,800 --> 00:14:28,280
أبرح فتاة الابتدائيَّة ضربًا حتَّى أغميَ عليها

260
00:14:31,470 --> 00:14:33,310
ومن أقصدهُ هو أنا

261
00:14:35,510 --> 00:14:36,010
إطارٌ أسود

262
00:14:35,510 --> 00:14:36,010
مشهد غير مرقم

263
00:14:36,390 --> 00:14:39,140
تبدو مُخيفًا يا أراراجي

264
00:14:40,060 --> 00:14:41,900
هـ... هانيكاوا؟

265
00:14:41,900 --> 00:14:44,490
والآن تبدو متفاجئًا

266
00:14:45,380 --> 00:14:47,400
تعابير وجهك هكذا أفضل

267
00:14:49,320 --> 00:14:52,280
ما بِكْ؟ لمَ أنت هُنا؟

268
00:14:52,280 --> 00:14:55,040
أقتلُ الوقت لا أكثر

269
00:14:55,040 --> 00:14:57,580
هكذا إذًا

270
00:14:57,910 --> 00:14:59,920
وأنا أيضًا

271
00:14:59,920 --> 00:15:04,040
لا أحبُّ البقاء في المنزل، ويوم الأحد هو للخروج بالنِّسبة لي

272
00:15:05,880 --> 00:15:08,300
...أعتقدُ بأنَّكِ تقلقين كثيرًا

273
00:15:10,130 --> 00:15:14,010
بالمناسبة يا أراراجي، هل هذه أختك الصغيرة؟

274
00:15:14,010 --> 00:15:16,260
إنَّها مُجرَّدُ طِفلةٍ ضائعة

275
00:15:16,260 --> 00:15:18,390
واسمُها هاتشيكوجي مايوي

276
00:15:18,390 --> 00:15:22,650
هاتشيكوجي؟ هذا الاسمُ شائعُ الاستخدام في كانساي

277
00:15:22,640 --> 00:15:23,850
إطارٌ أسود

278
00:15:22,640 --> 00:15:23,850
مشهد غير مرقم

279
00:15:22,940 --> 00:15:27,150
..."وبالمناسبة، المعبد الذي ذُكِر فيه "قصَص الشينونومي

280
00:15:23,850 --> 00:15:27,140
قصص الشينونومي

281
00:15:27,150 --> 00:15:29,780
اسمُها موجود لكن كتابة الكانجي مُختلفة

282
00:15:30,360 --> 00:15:32,320
أنتِ حقًّا تعرفين كلَّ شيء

283
00:15:32,320 --> 00:15:35,530
لا أعرف كلَّ شيء، فقط كان من ضِمن ما أعرفُه

284
00:15:41,120 --> 00:15:43,250
مرحبًا يا مايوي

285
00:15:43,250 --> 00:15:47,630
أنا صديقة هذا الفتى وأدعى هانيكاوا تسوباسا

286
00:15:48,460 --> 00:15:50,260
لا تتحدَّثي معي رجاءً

287
00:15:50,260 --> 00:15:51,800
فأنا أكرهكِ

288
00:15:51,800 --> 00:15:55,510
يا إلهي، يبدو أنَّني فعلتُ شيئًا وكرِهَتْني عليه

289
00:15:55,510 --> 00:15:56,600
هيَّا، هيَّا

290
00:15:59,930 --> 00:16:04,560
!يا لكِ من لطيفة يا مايوي. أرغبُ في أكلُكِ

291
00:16:06,150 --> 00:16:10,890
لكن، لا يجبُ عليكِ عضُّ يده، أتَّفقنا؟

292
00:16:14,360 --> 00:16:16,660
هيَّا تأسَّفي

293
00:16:18,800 --> 00:16:21,120
أنا آسفة يا أراراجي

294
00:16:23,670 --> 00:16:26,150
وأيضًا لا تفعل ما فعلتهُ لها يا أراراجي

295
00:16:26,150 --> 00:16:28,840
أتقصدين "أن لا أكون عنيفًا"؟

296
00:16:28,840 --> 00:16:31,720
بالطَّبع، العنفُ عادةٌ سيِّئة

297
00:16:31,720 --> 00:16:38,310
ولكن، عندما تضربُ طِفلًا فعليك
أن تُخبره لماذا فعلت ذلك لكي يفهم

298
00:16:39,510 --> 00:16:42,520
الحديثُ معكِ يُشبهُ المُذاكرة

299
00:16:44,970 --> 00:16:45,720
إطارٌ أحمر

300
00:16:44,970 --> 00:16:45,720
مشهد غير مرقم

301
00:16:44,980 --> 00:16:50,750
إذًا هي ضائعة؟ والمكان في الجوار؟ أستطيع إرشادك إن أردت

302
00:16:51,780 --> 00:16:55,700
كلَّا، فقد أرسلت سينجوغاهارا لتبحث عن أحد الأشخاص

303
00:16:55,700 --> 00:16:59,280
هل كُنت معها؟

304
00:17:01,110 --> 00:17:01,360
إطارٌ أسود

305
00:17:01,110 --> 00:17:01,360
مشهد غير مرقم

306
00:17:01,620 --> 00:17:07,830
لقد سألتَ عنها كثيرًا من قبل

307
00:17:11,620 --> 00:17:12,370
إطارٌ أسود

308
00:17:11,620 --> 00:17:12,370
مشهد غير مرقم

309
00:17:12,380 --> 00:17:14,910
فهمت! هكذا إذًا

310
00:17:15,260 --> 00:17:19,470
تخيُّلاتك ستجعل الفتيات المحبات لـ "ياووي" يُقرُّون بهزيمتهم

311
00:17:19,470 --> 00:17:21,310
ياووي؟ ما هذا؟

312
00:17:21,310 --> 00:17:24,520
"اختصارٌ لـ "لا ذروة، لا نهاية، معنى عميق

313
00:17:24,520 --> 00:17:28,100
يبدو أنَّك تكذب. لا بأس، سأتحقَّقُ من الأمر

314
00:17:28,100 --> 00:17:29,270
...تبدين جادَّةً في ذلك

315
00:17:29,270 --> 00:17:32,520
حسنًا إذًا. لا أريد أن أكون عائقًا، لذا سأذهب في طريقي الآن

316
00:17:32,980 --> 00:17:36,240
آسفةٌ على إزعاجك. ألقِ التحيَّة على سينجوغاهارا بالنيابة عنِّي

317
00:17:36,240 --> 00:17:38,490
سأقولها لكِ لقد أسأتِ الفهم

318
00:17:38,490 --> 00:17:42,700
تذكَّرت، أيُمكنُني سؤالكِ يا هانيكاوا؟

319
00:17:42,700 --> 00:17:45,370
أتعرفين امرأةً تُدعى تسونادي وتعيش هُنا؟

320
00:17:45,370 --> 00:17:46,720
تسونادي؟

321
00:17:50,910 --> 00:17:52,870
إطارٌ أسود

322
00:17:50,910 --> 00:17:52,870
مشهد غير مرقم

323
00:17:50,920 --> 00:17:52,880
كلَّا، لا أعرفها

324
00:17:52,880 --> 00:17:55,630
أهُناك شيءٌ لا تعرفه هانيكاوا؟

325
00:17:55,630 --> 00:17:59,930
أخبرتُك من قبل، لا أعرف كلَّ شيء. ويجب
أن يكون الأمر من ضِمن معرفتي

326
00:18:00,220 --> 00:18:01,930
هنالك أمورٌ أخرى لا أعرف عنها شيء

327
00:18:01,930 --> 00:18:03,140
فهمت

328
00:18:03,140 --> 00:18:05,560
آسفةٌ لأنَّني لم أكُن بمستوى تطلُّعاتك

329
00:18:05,560 --> 00:18:06,660
لا مُشكلة

330
00:18:06,660 --> 00:18:09,020
حسنًا، أراك لاحقًا

331
00:18:16,020 --> 00:18:23,740
الرابع عشر من من مايو
الأحد - 14:15:30
إنها اللحظة التي حصلت فيها
على رقم هاتف سينجوغاهارا

332
00:18:16,020 --> 00:18:23,740
مشهد رقم 355

333
00:18:16,360 --> 00:18:19,780
"14:15:30" الأحد ، الرابعَ عَشَر من مايو ، والوقت

334
00:18:19,780 --> 00:18:22,950
إنَّها اللحظةُ التي حصلتُ فيها على رقم هاتف سينجوغاهارا

335
00:18:30,500 --> 00:18:34,260
يا إلهي. لقد أفسَدَت يوم الأحد الذي أتكاسلُ فيه عن العمل

336
00:18:34,260 --> 00:18:36,260
تِلك التسوندري لئيمةٌ بحق

337
00:18:36,260 --> 00:18:37,610
التسوندري؟

338
00:18:37,610 --> 00:18:39,500
أتقصد سينجوغاهارا؟

339
00:18:39,500 --> 00:18:46,020
لكن، خلال فترةٍ قصيرة، قُمتَ بلقاء شيءٍ غريب

340
00:18:46,020 --> 00:18:48,140
لمْ ألتقِ بها

341
00:18:49,100 --> 00:18:50,340
حقًّا؟

342
00:18:50,340 --> 00:18:54,280
فتاةٌ تُدعى هاتشيكوجي مايوي

343
00:18:54,860 --> 00:18:57,240
هاتشيكوجي مايوي؟

344
00:18:57,240 --> 00:19:00,700
هكذا إذًا. فهمت، فهمت

345
00:19:01,110 --> 00:19:05,200
"هاتشيكوجي هي الفصل الخامس من "قصص الشينونومي

346
00:19:03,940 --> 00:19:05,190
الفصل الخامس من قصص الشينونومي

347
00:19:05,490 --> 00:19:07,660
هانيكاوا قالت الشيء ذاته

348
00:19:08,290 --> 00:19:09,910
ما الأمر أيَّتها التسوندري؟

349
00:19:10,540 --> 00:19:11,580
ماذا هُناك يا أوشينو؟

350
00:19:11,580 --> 00:19:18,330
مشهد رقم 359

351
00:19:15,750 --> 00:19:18,330
تنهد

352
00:19:18,880 --> 00:19:21,480
أنت عديمُ الجدوى

353
00:19:22,700 --> 00:19:23,800
ما الذي تتحدَّثُ عنه؟

354
00:19:23,800 --> 00:19:29,520
تِلك التسوندري قلقة، وجعلتها تشعرُ بمسؤوليَّة هذا

355
00:19:29,520 --> 00:19:34,060
آسفٌ لأنَّني وضعتها في هذا الموقف

356
00:19:34,060 --> 00:19:36,370
يا إلهي، ليس هذا ما قصدتُه

357
00:19:36,740 --> 00:19:45,540
أليس تفائلك زائدٌ عن حدِّه وذلك في مُحاولة حلِّ
المُشكلة بينك وبينها وبين مُمَثِّلة الصَّف؟

358
00:19:45,540 --> 00:19:47,650
هذا ليس ما أحاول فِعلَه

359
00:19:47,650 --> 00:19:53,490
وأيضًا، لن يكون بجانبك أحدٌ مثلي فيما بعد
عندما تُصادف مثل هذه الأشياء ثانيةً

360
00:19:53,490 --> 00:19:57,280
وأيضًا، لا يُمكننا حلُّ مُشكلةٍ كهذه عبر الهاتف

361
00:19:58,000 --> 00:20:00,260
ظننتُ بأنَّ هذا الأمر سهل

362
00:20:00,260 --> 00:20:07,510
أضف إلى ذلك، أنَّهُ ليس من الأدب أن تُرسل فتاةً
شابة لوحدها لمكان شخصٍ غريب الأطوار مثلي

363
00:20:07,510 --> 00:20:10,480
لكنَّك لن تفعل شيئًا لها، أليس كذلك؟

364
00:20:10,480 --> 00:20:19,570
سعيدٌ لثقتك بي، ولكنَّها عكسُك تمامًا

365
00:20:21,170 --> 00:20:25,280
أيَّتُها التسوندري، ضعي الدبَّاسة جانبًا، لن أفعل لكِ شيء

366
00:20:25,280 --> 00:20:26,410
دبَّاسة؟

367
00:20:27,450 --> 00:20:29,030
لقد أخافتني

368
00:20:29,030 --> 00:20:31,920
تِلك التسوندري حقًّا مُخيفة

369
00:20:31,920 --> 00:20:33,740
...حسنًا إذًا

370
00:20:33,740 --> 00:20:37,010
لم أعتَدْ الحديث من خلال الهاتف

371
00:20:37,010 --> 00:20:39,340
ما الذي تقصده؟

372
00:20:39,340 --> 00:20:40,550
حسنًا

373
00:20:40,980 --> 00:20:44,140
سأخبرُ التسوندري بطريقة التعامل مع الحلزونة الضائعة

374
00:20:44,140 --> 00:20:46,550
ابقَ في مكانك لبعض الوقت

375
00:20:46,550 --> 00:20:47,940
الطريقة؟

376
00:20:47,940 --> 00:20:49,910
هل من الصواب أن تجعل شخصًا آخر يقوم بهذا؟

377
00:20:49,910 --> 00:20:54,520
أليس من المُفترض أن تكون هُنالك طقوس مِثل المرَّة السابقة؟

378
00:20:54,520 --> 00:20:57,610
كلَّا، الحلزونة ليست مُتعبة مثل السلطعون

379
00:20:57,610 --> 00:21:03,510
وأيضًا هي ليست بآلهة. سأشبِّهُها بالرُّوح أو شبح

380
00:21:03,510 --> 00:21:04,520
روح؟

381
00:21:04,520 --> 00:21:07,490
...أتعلمُ بما سأقوله الآن يا أراراجي

382
00:21:07,490 --> 00:21:10,980
عن معبد الشيكوكو المُقدَّس، ومعبد كانساي كانون المُقدَّس؟

383
00:21:10,980 --> 00:21:14,210
لديَّ خلفيَّةٌ جيِّدة عن ذلك

384
00:21:14,210 --> 00:21:17,730
هاتشيكوجي من هؤلاء أيضًا

385
00:21:18,940 --> 00:21:22,210
"لكن كما ترى، بإمكانك قراءة "هاتشيكو" كـ "ياكو

386
00:21:22,210 --> 00:21:24,910
وبهذا تُصبح سوء طالع

387
00:21:24,910 --> 00:21:30,140
وقد تمَّ التخلِّيَ عن هاتشيكوجي بسبب التفسير الذي انتشر عنه

388
00:21:31,810 --> 00:21:34,950
والآن بعد أن أعطيتك درسًا في التَّاريخ وفهِمتَه

389
00:21:34,950 --> 00:21:38,060
أخبرني بما تعتقدهُ عن اسم هاتشيكوجي مايوي

390
00:21:38,480 --> 00:21:41,570
عادةً ستراه غيرُ ملائم بسبب ما يعنيه

391
00:21:41,570 --> 00:21:42,800
بسبب ما يعنيه؟

392
00:21:42,800 --> 00:21:47,860
لو شعرتَ بذلك منذُ البداية لكان أفضل

393
00:21:47,860 --> 00:21:49,780
أفضل؟ وكيف ذلك؟

394
00:21:49,780 --> 00:21:52,620
إذًا سأخبر التسوندري بالتَّفاصيل

395
00:21:54,200 --> 00:21:58,370
...سيكون جيِّدًا لو أخبرتك بما قُلتُهُ بالضَّبط

396
00:21:59,370 --> 00:22:00,700
إطارٌ أحمر

397
00:21:59,370 --> 00:22:00,700
مشهد غير مرقم

398
00:22:02,460 --> 00:22:04,420
ماذا يقصد؟

399
00:22:07,130 --> 00:22:10,420
كما سمعتِ يا هاتشيكوجي، يبدو أنَّ هُنالك حلٌّ لهذا

400
00:22:10,420 --> 00:22:15,350
من خلال ما سمعت، فلا يبدو لي ذلك

401
00:22:15,680 --> 00:22:17,560
...على كلٍّ يا أراراجي

402
00:22:17,560 --> 00:22:18,520
ماذا هُناك؟

403
00:22:19,900 --> 00:22:22,270
أنا جائعة

404
00:22:23,520 --> 00:22:23,730
رواية الوحوش

405
00:22:23,520 --> 00:22:23,730
حلزون

406
00:22:23,520 --> 00:22:23,730
حلزون مايوي، الجزء الثاني

407
00:22:23,750 --> 00:22:25,020
يُتبع

408
00:22:43,290 --> 00:22:45,920
are ga denebu arutairu bega

409
00:22:43,290 --> 00:22:45,920
أولئك دينيب، آلتير، فيغا

410
00:22:46,000 --> 00:22:48,880
kimi ha yubisasu natsu no daisankaku

411
00:22:46,000 --> 00:22:48,880
إنه المثلث الصيفي الذي أشرت إليه

412
00:22:49,090 --> 00:22:51,550
oboete

413
00:22:49,090 --> 00:22:51,550
تذكرته

414
00:22:51,800 --> 00:22:54,380
sora wo miru

415
00:22:51,800 --> 00:22:54,380
ونظرت إلى السماء

416
00:22:54,920 --> 00:22:57,430
yatto mitsuketa orihimesama

417
00:22:54,920 --> 00:22:57,430
وبالصدفة وجدت نجم أوريهيمي

418
00:22:57,640 --> 00:23:00,430
dakedo doko darou hikoboshisama

419
00:22:57,640 --> 00:23:00,430
لكن أين نجمها الحبيب هيكوبوشي يا ترى؟

420
00:23:00,720 --> 00:23:08,980
kore ja hitoribocchi

421
00:23:00,720 --> 00:23:08,980
لا بد أنها تشعر بالوحدة

422
00:23:09,060 --> 00:23:14,820
makkura no sekai kara miageta

423
00:23:09,060 --> 00:23:14,820
نظرنا إلى السماء من وسط الظلمة الحالكة

424
00:23:15,190 --> 00:23:21,830
yozora ha hoshi ga furu you de

425
00:23:15,190 --> 00:23:21,830
وكانت الشهب قد بدأت تتساقط سلفا

426
00:23:22,160 --> 00:23:24,750
itsu kara darou

427
00:23:22,160 --> 00:23:24,750
أتساءل أين كانتْ مختبئة؟

428
00:23:25,080 --> 00:23:28,500
kimi no koto wo

429
00:23:25,080 --> 00:23:28,500
عندما بدأت البحث

430
00:23:29,080 --> 00:23:33,460
oikakeru watashi ga ita

431
00:23:29,080 --> 00:23:33,460
عنك في كل مكان

432
00:23:33,800 --> 00:23:36,300
douka onegai

433
00:23:33,800 --> 00:23:36,300
أترجاك إذا أمكن

434
00:23:36,720 --> 00:23:39,300
odorokanaide

435
00:23:36,720 --> 00:23:39,300
لا تتفاجأ أرجوك

436
00:23:39,680 --> 00:23:42,180
kiite yo

437
00:23:39,680 --> 00:23:42,180
...وافهم

438
00:23:42,560 --> 00:23:47,810
watashi no

439
00:23:42,560 --> 00:23:47,810
...تلك المشاعر...

440
00:23:48,390 --> 00:23:51,690
kono omoi wo

441
00:23:48,390 --> 00:23:51,690
التي تخصني...

442
00:23:55,400 --> 00:23:56,030
أنا كارين

443
00:23:56,030 --> 00:23:57,080
وأنا تسكيهي

444
00:23:57,080 --> 00:24:00,040
كارين، هل كان الشذوذ للذكور ممنوعٌ تحت حُكم المَلاك؟

445
00:24:00,040 --> 00:24:01,460
والأمرُّ من ذلك أنَّ المُساعدة ممنوعة

446
00:24:01,460 --> 00:24:02,460
والاعتراف أيضًا مُحرَّم؟

447
00:24:02,460 --> 00:24:04,460
يمنعون ذلك ويُحرِّمون ذاك، الوضع فوضويّ

448
00:24:04,460 --> 00:24:05,290
...يا لها من صرامة

449
00:24:05,290 --> 00:24:06,630
لا زالوا يحملون الأسلحة معهم

450
00:24:06,630 --> 00:24:09,760
بالنِّسبة لي حُكَّامهم أكثر رُعبًا من الأسلحة

451
00:24:10,130 --> 00:24:13,050
...ولأكون عادلة، لا حاجة لحماية النَّفس هُناك

452
00:24:13,050 --> 00:24:14,220
في الحقيقة الأمان المُبالغ فيه مُخيفٌ جدًّا

453
00:24:14,220 --> 00:24:16,350
!والآن، حاون وقتُ الأحجية الجديدة

454
00:24:16,350 --> 00:24:17,310
هذه المرَّة الرابعة

455
00:24:17,310 --> 00:24:18,930
...بخصوص نغمات الهاتف الخلوي

456
00:24:18,930 --> 00:24:19,890
شعرتُ بأنَّ الأمر يتعلَّق بذلك

457
00:24:19,890 --> 00:24:21,060
علمتُ بأنَّكِ ستشعُرين بذلك

458
00:24:21,350 --> 00:24:25,440
نغمات الهاتف الخلوي ممنوعةٌ داخل القِطارات

459
00:24:25,800 --> 00:24:27,820
فقد تُزعجُ الرُكَّاب

460
00:24:27,840 --> 00:24:28,690
إذًا يجبُ منعُه

461
00:24:28,690 --> 00:24:30,940
فقط اكتُمي الصَّوت في هاتفكِ الخلوي

462
00:24:30,940 --> 00:24:32,150
هيَّا أخبرينا بالأحجية

463
00:24:32,360 --> 00:24:34,200
الحلقة القادمة

464
00:24:32,360 --> 00:24:34,200
حلزون مايوي، الجزء الثالث

465
00:24:32,360 --> 00:24:34,200
في الحلقة القادمة: حلزون مايوي. الجزءُ الثَّالث

466
00:24:34,200 --> 00:24:35,820
أيُسمح بالنَّظر إلى نغمات الهاتف الخلوي؟

467
00:24:35,820 --> 00:24:36,780
!أيُمكنكِ رؤيتها؟