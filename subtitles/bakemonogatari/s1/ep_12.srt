199
00:08:52,130 --> 00:08:54,760
وكلُّ ذلك بفضلكِ يا سينجوغاهارا

200
00:08:54,760 --> 00:09:00,890
أبي، يبدو أنَّ أراراجي يُريد شُكرك، هلَّا استمعت إليه؟

201
00:09:00,890 --> 00:09:02,850
شكرًا لكِ يا هيتاجي

202
00:09:03,390 --> 00:09:07,680
سيكون من الأفضل لو راجعنا الأجوبة بعد الامتحان مُباشرةً

203
00:09:07,980 --> 00:09:11,730
على كلٍّ، طلبُ هذا الآن يُعدُّ مُزعجًا لكْ، أليس كذلك؟

204
00:09:12,110 --> 00:09:16,410
لكنَّني مُتفاجئة، على الرُّغم من أنَّني قُمتُ بتدريسك

205
00:09:16,410 --> 00:09:17,660
مُتفاجئة؟

206
00:09:17,660 --> 00:09:21,990
أجل. تدريسُك لمْ يكُن مُسلِّيًا إطلاقًا

207
00:09:21,990 --> 00:09:25,870
!لمْ أطلُب منكِ المُساعدة لتتسلَّي بي

208
00:09:25,870 --> 00:09:33,630
"كنتُ واثقةٌ من أنَّك ستقول،"درستُ بجديَّـة ومع ذلك أصبحتُ أسوأ من السابق

209
00:09:33,880 --> 00:09:35,380
على كلٍّ، أنا خائبةُ الأمل

210
00:09:35,380 --> 00:09:38,140
!تمنِّيكِ بحدوث ذلك فِعلٌ سيِّئ

211
00:09:36,590 --> 00:09:38,130
كلام أراراجي المتقلب

212
00:09:38,140 --> 00:09:39,260
هكذا إذًا

213
00:09:40,350 --> 00:09:43,770
لكن نتائجك بالفعل مُدهشة! فخورةٌ بكْ

214
00:09:45,020 --> 00:09:47,480
...وإن استمرَّيت على هذا يا أراراجي

215
00:09:47,480 --> 00:09:50,150
فقد تحصلُ على درجاتٍ أفضل

216
00:09:50,560 --> 00:09:52,320
أفضل؟

217
00:09:52,860 --> 00:09:58,910
يُمكنني الاستمرار في تدريسك إن رغبت في ذلك

218
00:09:58,910 --> 00:09:59,910
...هذا

219
00:10:01,330 --> 00:10:03,080
أفضلُ عرضٍ سمِعتُه

220
00:10:04,620 --> 00:10:05,500
هكذا إذًا

221
00:10:09,750 --> 00:10:13,250
إذًا من الآن فصاعدًا، ستأتي إلى منزلي كُلَّ يومٍ للمُذاكرة

222
00:10:14,760 --> 00:10:16,420
!كـ... كُلَّ يوم؟

223
00:10:16,800 --> 00:10:20,140
!هل فعلًا الأذكياء يدرسون بهذا القَدْر؟

224
00:10:20,140 --> 00:10:24,560
كلَّا، هذا النِّظام مُخصَّصٌ لك يا أراراجي

225
00:10:25,270 --> 00:10:29,520
الأذكياءُ أذكياء قبل الدِّراسة

226
00:10:31,190 --> 00:10:35,030
لكن يبدو أنَّ هانيكاوا تُذاكرُ كُلَّ يوم

227
00:10:35,030 --> 00:10:42,740
للأسف يا أراراجي،"المُذاكرة" التي تقوم بها هانيكاوا مُختلفةٌ تمامًا عنَّا

228
00:10:43,530 --> 00:10:47,790
هانيكاوا شيءٌ آخر، بل من عالمٍ آخر

229
00:10:49,120 --> 00:10:52,790
لكن أليس هانيكاوا دائمًا ما تُحرز العلامة الكاملة؟

230
00:10:53,170 --> 00:10:58,760
إن لمْ تُحرز العلامة الكاملة فمن المؤكَّد بأنَّ هُنالك مُشكلةً ما في أسئلة الامتحان

231
00:10:59,260 --> 00:11:01,050
...ومع ذلك

232
00:11:01,800 --> 00:11:09,180
لا أستطيع القول بأنَّي أغارُ منها عندما أتذكَّر مدى الضَّغط الذي يُسبِّبهُ ذلك

233
00:11:10,560 --> 00:11:12,060
ضغط...؟

234
00:11:12,560 --> 00:11:13,980
أو إجهاد

235
00:11:15,360 --> 00:11:17,110
مشهد رقم 181

236
00:11:15,570 --> 00:11:16,900
إجهاد...؟

237
00:11:17,280 --> 00:11:24,740
بما أنَّك تزحفُ على صخرةٍ يا أراراجي ولا يُمكنك تصوُّرُ مدى ذكاء
الأذكياء، فعليك بذل جُهدٍ مُضاعف لتصل لمستواهم

238
00:11:25,080 --> 00:11:29,080
ولهذا، سأقوم بتدريسك كُلَّ يومٍ في منزلي

239
00:11:30,160 --> 00:11:31,370
بإمكاني فِعلُ ذلك

240
00:11:31,790 --> 00:11:34,380
ويُمكننا القيامُ بذلك في منزل كانبارو بين حينٍ وآخر

241
00:11:34,380 --> 00:11:36,380
وما علاقتُها بهذا؟

242
00:11:36,380 --> 00:11:40,010
عليَّ أن ألعب معها قليلًا

243
00:11:40,010 --> 00:11:41,930
لقد وعدتُها بذلك

244
00:11:42,430 --> 00:11:46,100
لقد قُلت لي من قبل بأنَّك تودُّ اللعب معها، أليس كذلك؟

245
00:11:46,100 --> 00:11:48,560
نعم، هي مرحةٌ جدًّا

246
00:11:51,310 --> 00:11:54,060
...تذكَّرت، بخصوص كانبارو

247
00:11:54,440 --> 00:11:56,310
ما بها؟

248
00:11:56,310 --> 00:11:58,780
لمَ هي منحرفة لهذا الحد؟

249
00:11:58,780 --> 00:12:01,280
منحرفة؟ كانبارو؟

250
00:12:01,280 --> 00:12:02,610
هل أنا مُخطئ؟

251
00:12:03,200 --> 00:12:10,370
حتَّى أوشينو عندما رآها قال بأنَّها فتاةٌ منحرفة أكثر من كونها رياضيَّة

252
00:12:10,700 --> 00:12:14,830
حقًّا؟ يبدو ذلك من منظور الرجال فقط

253
00:12:14,830 --> 00:12:17,770
لكن هي صريحةٌ مع نفسها لا أكثر

254
00:12:18,090 --> 00:12:19,300
فهمت

255
00:12:19,800 --> 00:12:26,800
"ومع ذلك، لا يُمكنُ أن أتجاهل وصفك للكوهاي الخاصَّة بي واللطيفة بـ"المنحرفة

256
00:12:27,180 --> 00:12:29,180
وما الذي ستفعلينه؟

257
00:12:29,770 --> 00:12:31,560
ما الذي سأفعلُه؟

258
00:12:32,810 --> 00:12:37,810
سأُؤثِّرُ على أساس حُكمك، وفي قيَمك الخاصَّة

259
00:12:38,230 --> 00:12:43,570
وعندها ستُصبحُ كانبارو في نظرك فتاةً بريئة ونقيَّة القلب

260
00:12:48,490 --> 00:12:48,910
كلامٌ بذيء

261
00:12:48,490 --> 00:12:48,910
مشهد رقم 201

262
00:13:04,380 --> 00:13:05,970
هذا سيِّئ

263
00:13:10,100 --> 00:13:10,970
مشهد رقم 217

264
00:13:11,260 --> 00:13:14,230
والآن ما رأيك يا أراراجي؟

265
00:13:15,980 --> 00:13:18,900
افعلي ما تُريدن يا هيتاجي

266
00:13:19,480 --> 00:13:20,980
فاصل

267
00:13:19,480 --> 00:13:20,980
مشهد رقم 126

268
00:13:25,490 --> 00:13:26,740
صمت

269
00:13:25,490 --> 00:13:26,740
مشهد رقم 222

270
00:13:27,490 --> 00:13:28,160
...مؤلـ

271
00:13:29,570 --> 00:13:32,290
انتظر هُنا يا أراراجي

272
00:13:32,620 --> 00:13:35,580
سأذهبُ لوحدي لأُعدَّ نفسي

273
00:13:35,580 --> 00:13:37,170
من أجل ماذا؟

274
00:13:37,170 --> 00:13:40,130
تبادل الحديث مع والدي ريثما أعود

275
00:13:51,140 --> 00:13:53,850
اسمُك أراراجي... صحيح؟

276
00:13:54,520 --> 00:13:57,480
أجل. أراراجي كويومي

277
00:13:57,480 --> 00:14:00,690
فهمت، أودعت ابنتي بين يديك

278
00:14:02,190 --> 00:14:03,320
أمزحُ معك

279
00:14:07,360 --> 00:14:13,370
ربَّما سمعت عن ذلك، ولكنَّني رجلٌ مُخلصٌ لعملي

280
00:14:13,370 --> 00:14:16,540
وبالكاد يكون لديَّ وقتٌ أقضيه مع هيتاجي

281
00:14:18,250 --> 00:14:26,800
قد لا يعْني ما سأقوله الآن الشيء الكثير، ولكن قدْ مرَّ
وقتٌ طويلٌ على رؤيتي لـ"هيتاجي" وهي تستمتع بحياتها

282
00:14:28,220 --> 00:14:28,840
صمت / اضطراب

283
00:14:28,220 --> 00:14:28,840
مشهد رقم 241

284
00:14:31,010 --> 00:14:33,560
أسمِعْتَ بما حدث لوالدتها؟

285
00:14:34,140 --> 00:14:34,720
أجل

286
00:14:35,180 --> 00:14:37,270
وعن مَرَضِها؟

287
00:14:37,850 --> 00:14:38,600
أجل

288
00:14:38,980 --> 00:14:40,810
حسنًا، هذا كُلُّ شيء

289
00:14:41,230 --> 00:14:45,730
تِلك لمْ تـكُن الأسباب الوحيدة، بل جزءٌ ليس باليسير
أتحمَّلهُ بسبب وضعي لعملي كأقصى أولويَّاتي

290
00:14:46,230 --> 00:14:49,860
لكنَّ هيتاجي أغلقت قلبها عن الجميع منذُ مُدَّة طويلة

291
00:14:49,860 --> 00:14:50,030
إطارٌ أحمر

292
00:14:49,860 --> 00:14:51,740
مشهد غير مرقم

293
00:14:50,990 --> 00:14:51,740
إطارٌ أسود

294
00:14:54,950 --> 00:15:01,170
ولكن مؤخَّرًا ولأوَّل مرَّة، طلبت منِّي أن أُقدِّم لها صنيعين

295
00:15:02,130 --> 00:15:04,290
الأول هو رقبتها في أن تُساعدني بعملي

296
00:15:05,250 --> 00:15:09,050
والثاني هو هذا. كِلا الطَّلبين تضمَّنهُما شخْصُك

297
00:15:09,720 --> 00:15:14,760
لقد تسبَّبت في هذا التَّغيير الكبير فيها. أنت مُدهشٌ يا أراراجي

298
00:15:15,470 --> 00:15:22,400
شُكرًا لإطرائك. ولكن، كان ذلك محْضُ صُدفةٍ لا أكثر

299
00:15:22,400 --> 00:15:28,150
حقًّا؟ سمِعتُ أنَّ لك دورًا كبيرًا في عمليَّة شِفائها

300
00:15:28,490 --> 00:15:32,700
كما قُلت، لا أظنُّ أنَّني سببٌ في ذلك

301
00:15:33,240 --> 00:15:39,790
ولأُصدِقك القول، هيتاجي هي من أنقذَت نفسها. وأنا كُنتُ موجودًا لحظتها لا أكثر

302
00:15:39,790 --> 00:15:41,790
كلام الأب

303
00:15:39,790 --> 00:15:41,790
مشهد رقم 260

304
00:15:40,290 --> 00:15:41,790
هذا ما عليكَ فِعلُه

305
00:15:42,830 --> 00:15:49,630
وبصراحة، أشكُرُك لأنَّك كُنت هُناك عندما احتاجت إليك

306
00:15:50,920 --> 00:15:53,470
إنَّني فاشلٌ كأبْ

307
00:15:54,140 --> 00:15:59,180
فلَمْ أستطِع التَّواجد بجانبها عندما احتاجت لذلك

308
00:16:00,980 --> 00:16:07,940
ومع هذا كُلِّه، أنا فخورٌ بابنتي. وأثقُ بآرائها وأؤمنُ باختياراتها

309
00:16:08,860 --> 00:16:11,950
وإن كانت تراك الرَّجُل المُناسب لها، فلا نقاش في ذلك

310
00:16:13,200 --> 00:16:16,200
اعتني بابنتي يا أراراجي

311
00:16:17,490 --> 00:16:18,410
...أبي

312
00:16:21,580 --> 00:16:23,330
آسفةٌ لجعلك تنتظر يا أراراجي

313
00:16:25,080 --> 00:16:29,500
أبي، من هُنا سنذهبُ نحنُ الشابَّين فقط

314
00:16:29,920 --> 00:16:31,590
شكرًا على إيصالنا

315
00:16:31,970 --> 00:16:35,720
سنعود بعد ساعتين، لذا اذهب إلى عملك

316
00:16:35,720 --> 00:16:35,930
مشهد رقم 274

317
00:16:38,300 --> 00:16:40,100
...والآن يا أراراجي

318
00:16:51,740 --> 00:16:53,860
شُكرًا لك يا والدي

319
00:17:04,620 --> 00:17:06,620
سينجوغاهارا، ما هذا المكان؟

320
00:17:04,620 --> 00:17:08,630
مشهد رقم 286

321
00:17:06,620 --> 00:17:08,630
أسبق وأجبت لواحدٍ من أسئلتك يا أراراجي؟

322
00:17:12,630 --> 00:17:14,880
إطارٌ أسود

323
00:17:12,630 --> 00:17:14,880
مشهد غير مرقم

324
00:17:14,880 --> 00:17:18,680
...سينجوغاهارا، إلى متى سأمشي هكـ

325
00:17:19,430 --> 00:17:20,180
...هذا مؤلم

326
00:17:36,820 --> 00:17:38,950
إطارٌ أسود

327
00:17:36,820 --> 00:17:38,950
مشهد غير مرقم

328
00:17:38,950 --> 00:17:41,200
كلام هيتاجي

329
00:17:38,950 --> 00:17:41,200
مشهد رقم 297

330
00:17:38,950 --> 00:17:41,200
أغلق عيناك واستَلقي

331
00:17:44,700 --> 00:17:50,460
إطارٌ أسود

332
00:17:44,700 --> 00:17:50,460
مشهد غير مرقم

333
00:17:48,880 --> 00:17:50,460
يُمكنك أن تفتحها الآن

334
00:18:03,010 --> 00:18:04,850
ما رأيك يا أراراجي؟

335
00:18:05,310 --> 00:18:08,700
مُذهل! لا أملك كلماتٍ لوصفه

336
00:18:09,100 --> 00:18:10,610
إذًا لا تملك المهارة في الوصف اللغوي

337
00:18:14,570 --> 00:18:17,240
ذلك دينيب، ألتيار، فيجا

338
00:18:17,820 --> 00:18:20,740
مُثلَّث الصَّيف الشهير، فهِمت؟

339
00:18:21,620 --> 00:18:25,750
ونجمُ الحوَّاء بجانبهم تمامًا

340
00:18:26,160 --> 00:18:30,000
لهذا، نجمُ الحيَّة على نفس الخطِّ من الجهة المُقابلة

341
00:18:31,540 --> 00:18:34,170
وذلك النَّجمُ المُشع هو السُّنبلة

342
00:18:34,750 --> 00:18:37,050
وهذا يعني أنَّ نجم العذراء هُناك

343
00:18:38,380 --> 00:18:42,760
وذاك هو نجمُ السرطان . حسنًا... قد لا تكون رؤيتهُ واضحة

344
00:18:40,510 --> 00:18:41,140
هياجي سينجوغاهارا

345
00:18:40,510 --> 00:18:41,140
مشهد رقم 300

346
00:18:43,260 --> 00:18:43,890
مشهد رقم 300

347
00:18:45,520 --> 00:18:46,140
مشهد رقم 300

348
00:18:52,270 --> 00:18:53,770
إطارٌ أسود

349
00:18:52,270 --> 00:18:53,770
مشهد غير مرقم

350
00:18:52,520 --> 00:18:53,770
هذا كلُّ شيء

351
00:18:54,860 --> 00:18:55,650
ما الذي تعنينه؟

352
00:18:55,650 --> 00:18:58,280
هذا كلُّ ما لديّ

353
00:18:59,900 --> 00:19:02,280
مشهد رقم 301

354
00:19:00,200 --> 00:19:02,280
إمكانيَّة تدريسك

355
00:19:02,700 --> 00:19:06,040
كوهاي لطيفة، وأبٌ أخرقْ

356
00:19:06,660 --> 00:19:08,290
...وهذه السماء المُرصَّعة بالنُّجوم

357
00:19:10,290 --> 00:19:12,920
هذا كلُّ ما لديّ

358
00:19:13,840 --> 00:19:17,260
هذا ما أستطيع تقديمهُ لك يا أراراجي

359
00:19:18,210 --> 00:19:19,600
هذا كلُّ شيء

360
00:19:20,680 --> 00:19:21,590
...كلُّ شيء

361
00:19:22,300 --> 00:19:25,930
ولأكون أكثر دِقَّة، لديَّ الإهانات والكلمات اللاذعة

362
00:19:25,930 --> 00:19:27,430
لا أُريدها

363
00:19:27,430 --> 00:19:30,940
بالإضافة إلى وجود جسدي

364
00:19:31,770 --> 00:19:32,900
هذا لا تُريده أيضًا؟

365
00:19:32,900 --> 00:19:34,690
...كـ... كلَّا... هذا

366
00:19:35,730 --> 00:19:42,070
لكنَّك تعلم بما سأقوله الآن، وهو اعتداء رجلٍ مُنحرفٍ عليَّ وكاد أن يغتصبني

367
00:19:44,450 --> 00:19:50,710
بصراحة، أنا أشعر بخوفٍ من قيام ما كان سيفعلهُ بي معكَ أنت

368
00:19:51,660 --> 00:19:56,840
حاليًّا أنا... أخشى أن أكرهك بسبب ذلك يا أراراجي

369
00:19:58,590 --> 00:20:03,090
وحاليًّا أنا... أخشى أن أخسركْ

370
00:20:09,770 --> 00:20:15,770
ولا أستطيع القول بأنَّني محظوظةٌ بحياتي حتَّى هذه اللحظة

371
00:20:15,770 --> 00:20:22,030
وإن كان لقاؤنا ببعض يُعتبر سوء حظٍّ فلا بأس بذلك

372
00:20:22,950 --> 00:20:26,820
هذا يُثبت مدى عشقي لك يا أراراجي

373
00:20:27,990 --> 00:20:33,160
وبالتَّأكيد سنفعلُ شيئًا، لكن أُريدك أن تنتظر

374
00:20:34,460 --> 00:20:40,000
...وكلُّ ما أستطيع تقديمهُ لك في الوقت الحالي

375
00:20:40,800 --> 00:20:42,340
تِلك السماء المُرَّصعة بالنُّجوم

376
00:20:45,840 --> 00:20:50,930
قدِمتُ إلى هُنا عندما كنتُ صغيرةً مع أبي وأمي

377
00:20:52,180 --> 00:20:53,520
إنَّه كنزي

378
00:20:59,110 --> 00:21:01,900
هل تُحبُّني يا أراراجي؟

379
00:21:02,570 --> 00:21:03,650
أُحبُّك

380
00:21:03,650 --> 00:21:06,490
وأنا أيضًا أُحبُّك

381
00:21:07,160 --> 00:21:08,070
شكرًا لكِ

382
00:21:08,570 --> 00:21:10,580
ما الذي تُحبُّهُ فيني؟

383
00:21:11,290 --> 00:21:14,250
كُلَّ شيء. لا يوجد ما لا أُحبُّهُ فيكْ

384
00:21:14,250 --> 00:21:16,040
فهمت. سعيدةٌ بذلك

385
00:21:16,620 --> 00:21:19,710
ما الذي تُحبِّينهُ فيني؟

386
00:21:20,250 --> 00:21:21,550
...طيِّب

387
00:21:21,550 --> 00:21:23,010
...ولطيف

388
00:21:23,010 --> 00:21:28,680
وتأتي لإنقاذي كالأمير كُلَّما وقعتُ في مُشكلة

389
00:21:29,640 --> 00:21:30,640
سعيدٌ بذلك

390
00:21:36,890 --> 00:21:44,610
بالمُناسبة، ذلك المُنحرف كان فقط يُريد جسدي، ولم يسرق شفتاي

391
00:21:46,740 --> 00:21:50,490
لهذا يا أراراجي... سنُقبِّلُ بعضنا

392
00:21:51,780 --> 00:21:54,330
كلَّا، ليس هكذا

393
00:21:54,330 --> 00:21:58,170
هلَّا... هلَّا قُمت بـ... تقبيلي؟

394
00:21:58,540 --> 00:22:02,320
ما... ما رأيك في أن... تُقبِّلني؟

395
00:22:04,170 --> 00:22:06,590
لنتبادل القُبل يا أراراجي

396
00:22:07,050 --> 00:22:10,090
هذا ما اخترته في النهاية

397
00:22:14,850 --> 00:22:18,940
...وهكذا أصبح هذا اليومَ يومُ احتفالٍ

398
00:22:20,730 --> 00:22:22,070
لنا

399
00:22:42,330 --> 00:22:44,960
are ga denebu arutairu bega

400
00:22:42,330 --> 00:22:44,960
أولئك دينيب. آلتير. فيغا

401
00:22:45,040 --> 00:22:47,920
kimi ha yubisasu natsu no daisankaku

402
00:22:45,040 --> 00:22:47,920
ذلك هو المثلث الصيفي الذي أشرتَ إليه

403
00:22:48,130 --> 00:22:50,590
oboete

404
00:22:48,130 --> 00:22:50,590
تذكرته

405
00:22:50,840 --> 00:22:53,420
sora wo miru

406
00:22:50,840 --> 00:22:53,420
ونظرت إلى السماء

407
00:22:53,960 --> 00:22:56,470
yatto mitsuketa orihimesama

408
00:22:53,960 --> 00:22:56,470
وبالصدفة وجدت نجم أوريهيمي

409
00:22:56,680 --> 00:22:59,470
dakedo doko darou hikoboshisama

410
00:22:56,680 --> 00:22:59,470
لكن أين نجمها الحبيب هيكوبوشي يا ترى؟

411
00:22:59,760 --> 00:23:08,020
kore ja hitoribocchi

412
00:22:59,760 --> 00:23:08,020
يبدو هذا مملاً

413
00:23:08,100 --> 00:23:13,860
makkura no sekai kara miageta

414
00:23:08,100 --> 00:23:13,860
نظرنا إليك من عالم الأبدية المظلم

415
00:23:14,230 --> 00:23:20,870
yozora ha hoshi ga furu you de

416
00:23:14,230 --> 00:23:20,870
والنجوم بدأت فجأة بالسقوط

417
00:23:21,200 --> 00:23:23,790
itsu kara darou

418
00:23:21,200 --> 00:23:23,790
أتساءل أين كانتْ مختبئة؟

419
00:23:24,120 --> 00:23:27,540
kimi no koto wo

420
00:23:24,120 --> 00:23:27,540
عندما بدأت البحث

421
00:23:28,120 --> 00:23:32,500
oikakeru watashi ga ita

422
00:23:28,120 --> 00:23:32,500
عنك في كل مكان

423
00:23:32,840 --> 00:23:35,340
douka onegai

424
00:23:32,840 --> 00:23:35,340
أترجاك إذا أمكن

425
00:23:35,760 --> 00:23:38,340
odorokanaide

426
00:23:35,760 --> 00:23:38,340
لا تتفاجئ أرجوك

427
00:23:38,720 --> 00:23:41,220
kiite yo

428
00:23:38,720 --> 00:23:41,220
...وافهم

429
00:23:41,600 --> 00:23:46,850
watashi no

430
00:23:41,600 --> 00:23:46,850
...تلك المشاعر...

431
00:23:47,430 --> 00:23:50,730
kono omoi wo

432
00:23:47,430 --> 00:23:50,730
التي تخصني...

433
00:23:53,490 --> 00:23:53,700
رواية الأشباح

434
00:23:53,490 --> 00:23:53,700
قطة

435
00:23:53,490 --> 00:23:53,700
قطة تسوباسا، الجزء الثالث

436
00:23:53,700 --> 00:23:54,990
يُتبع

437
00:23:55,910 --> 00:23:56,560
أنا كارين

438
00:23:56,560 --> 00:23:57,080
وأنا تسكيهي

439
00:23:57,450 --> 00:23:59,370
كارين، لقد قُلتِ بأنَّكِ تُجيدين الكاراتيه، صحيح؟

440
00:23:59,370 --> 00:24:01,380
أجل، أنا أجيدها

441
00:24:01,380 --> 00:24:03,440
أليست الكاراتيه وقهوة اللَّاتيه مُتشابهتين بعض الشيء؟

442
00:24:03,440 --> 00:24:03,960
!هُما كذلك

443
00:24:03,960 --> 00:24:07,130
ومثل المُعالجة اليدويَّة ومُدفئة اليدين البلاستيكيَّة، صحيح؟

444
00:24:07,130 --> 00:24:08,710
!هُما كذلك! مُتشابهتين تمامًا

445
00:24:08,710 --> 00:24:09,990
أتساءل إن كان بينهُما صِلة ربط؟

446
00:24:09,990 --> 00:24:10,550
رُبَّما

447
00:24:10,550 --> 00:24:12,180
سيكون رائعًا إن كانا كذلك

448
00:24:12,180 --> 00:24:13,050
وقت الأحجية

449
00:24:13,050 --> 00:24:13,630
الأحجية

450
00:24:13,630 --> 00:24:15,840
أليست هي مُشابهةٌ بعض الشيء لجبنة الكريمة؟

451
00:24:15,840 --> 00:24:16,370
!هُما كذلك

452
00:24:16,370 --> 00:24:18,560
ومثل حساء لحم البقر وقِدْرُ اللَّحم السَّاخن، صحيح؟

453
00:24:18,560 --> 00:24:19,560
!هُما كذلك

454
00:24:19,560 --> 00:24:21,390
عرضٌ مسبق

455
00:24:19,560 --> 00:24:21,390
الحلقة القادمة

456
00:24:19,560 --> 00:24:21,390
قطة تسوباسا، الجزء الثالث

457
00:24:19,560 --> 00:24:21,390
في الحلقة القادمة: قطة تسوباسا. الجزءُ الثَّالث

458
00:24:21,600 --> 00:24:23,900
أليس الجزءُ الثَّالث والسومو مُتشابهين؟

459
00:24:23,920 --> 00:24:24,690
!هُما كذلك