1
00:00:02,270 --> 00:00:04,980
اليوم هو يومٌ عالمي، عيدُ الأم

2
00:00:05,230 --> 00:00:06,190
A

3
00:00:05,730 --> 00:00:11,030
سواءً كُنت تُحبُّها أم لا، أو على وفاقٍ معها أم لا

4
00:00:11,030 --> 00:00:15,950
وإن كُنت تعتبر نفسك مواطنًا يابانيًّا، فستتعامل مع هذا اليوم بجديَّة

5
00:00:18,030 --> 00:00:22,040
لم آتِ لهذه الحديقة لأيِّ سببٍ مُعيَّن

6
00:00:20,120 --> 00:00:25,370
A

7
00:00:22,710 --> 00:00:26,960
وصلتُ إلى هُنا بدرَّاجتي الجبليَّة بشكلٍ عشوائي

8
00:00:26,960 --> 00:00:30,670
أذهب إلى أينما تحملني

9
00:00:31,760 --> 00:00:35,640
...لكن لأنَّني الشَّخص الوحيد في الحديقة

10
00:00:35,640 --> 00:00:39,390
شعرتُ بأنَّني الوحيد في هذا العالم

11
00:00:40,600 --> 00:00:43,140
رُبَّما أبالغ

12
00:00:43,480 --> 00:00:47,480
لكنني شعرتُ وكأنَّ الحديقة مُلكًا لي

13
00:00:48,480 --> 00:00:51,280
وأنَّه سيكون رائعًا لو لمْ أعُد للمنزل أبدًا

14
00:00:51,280 --> 00:00:52,740
هذا ما أشعرُ به الآن

15
00:00:53,990 --> 00:00:54,950
بما أنَّني الوحيد

16
00:00:53,990 --> 00:00:54,950
بما أنّني

17
00:00:55,650 --> 00:00:56,110
وحيد

18
00:00:56,110 --> 00:00:57,490
ولأنَّني وحدي

19
00:01:09,290 --> 00:01:10,460
وحيدٌ مُجدَّدًا؟

20
00:01:11,170 --> 00:01:12,670
لم يكُن ذلك مُفاجئًا

21
00:01:13,210 --> 00:01:14,630
...إن كُنتَ ستتصرَّف هكذا

22
00:01:14,630 --> 00:01:16,510
...إن كُنتَ ستتصرَّف هكذا يا أخي

23
00:01:14,630 --> 00:01:16,510
إطارٌ أسود

24
00:01:14,630 --> 00:01:16,510
مشهد غير مرقم

25
00:02:48,970 --> 00:02:50,720
أممم

26
00:02:50,720 --> 00:02:51,680
أشعر بالملل والوحدة

27
00:02:51,680 --> 00:02:52,470
من يقرأ تافهةً كهذه؟

28
00:02:52,470 --> 00:02:53,140
لمَ وُضعت هذه الكتابة هنا؟

29
00:02:53,140 --> 00:02:53,770
لو كانت ضرورية لما كانت بهذه السرعة

30
00:02:53,770 --> 00:02:54,310
أحقا تحاول قراءتها؟

31
00:02:54,310 --> 00:02:54,810
صدقني لا نفع مما تفعل
ليست ذات أي أهمية

32
00:02:54,810 --> 00:02:55,270
وضعت هنا بداع فالعبث وحسب
لا تتعب نفسك وتركز عليها

33
00:02:55,270 --> 00:02:55,680
إنها فقط لحشو المشهد وإضافة طابع جميل إليه

34
00:02:55,680 --> 00:02:56,020
لذا رجاءً لا تتبعوا أنفسكم بها

35
00:02:56,020 --> 00:02:56,350
ليست إلا زياةً للأطر والمشاهد وحسب

36
00:02:56,350 --> 00:02:56,690
لكنها جميلة

37
00:02:56,690 --> 00:02:56,980
إنها جميلةٌ بحق

38
00:02:56,980 --> 00:02:57,190
أمم، هل قرأتموها كلها؟

39
00:02:57,190 --> 00:02:57,480
أحسنتم في ذلك لكن جهدم عقيم ولا نفع منه

40
00:02:57,480 --> 00:02:57,690
شكرا لكم على تركيزكم بها
إليكم بعض الكلمات العشوائية

41
00:02:57,690 --> 00:02:58,480
ملح

42
00:02:57,900 --> 00:02:58,690
فرن

43
00:02:58,690 --> 00:02:59,550
يبدو أن الحلقة الخاصة بالحزون قد بدأت
أرجو أن تتمتعوا بها
ربما ما كان هذا الفصل ليبدأ
لو لم أكن في حالة ضجر وحدي بالمتنزّه

44
00:02:59,560 --> 00:03:03,980
حلزون مايوي، الجزء الأول

45
00:02:59,560 --> 00:03:03,980
الحلقة الثالثة

46
00:03:04,160 --> 00:03:06,200
يا إلهي. ماذا لدينا هُنا؟

47
00:03:06,200 --> 00:03:08,790
ظننتُ بأنَّ أحدًا قد ترك كلبًا ميِّتًا هُنا

48
00:03:08,790 --> 00:03:11,000
لكن اتَّضح بأنَّه أنت يا أراراجي

49
00:03:13,210 --> 00:03:15,420
ما بك؟ كُنت أُلقِ عليك التحيَّة

50
00:03:15,840 --> 00:03:16,750
أمزحُ معك

51
00:03:16,750 --> 00:03:18,590
كـ ... كلَّا، لا شيء

52
00:03:18,590 --> 00:03:19,800
إذًا ماذا؟

53
00:03:19,800 --> 00:03:21,260
...أيُّها المسكين أراراجي

54
00:03:21,260 --> 00:03:24,470
هل فتنتُك بملابسي الجذَّابة؟

55
00:03:24,460 --> 00:03:25,090
ملابسٌ جذابة

56
00:03:24,460 --> 00:03:25,090
نعيم اللحظة

57
00:03:24,470 --> 00:03:26,560
وشعرت بنعيم هذه اللحظة؟

58
00:03:27,060 --> 00:03:28,600
...لنتجاهل ما قالتهُ لي

59
00:03:28,970 --> 00:03:30,850
لكنَّني بحَقْ فُتِنتُ بها

60
00:03:31,140 --> 00:03:34,940
على كلٍّ، كلمةُ "جذَّابة" وصفٌ رائع، أليس كذلك؟

61
00:03:34,940 --> 00:03:36,020
...هل تعلم أنَّها

62
00:03:36,020 --> 00:03:38,230
"كُتِبت بواسطة خلط حروف "جذور الأعشاب" مع "حمَّام ماءٍ ساخن

63
00:03:36,020 --> 00:03:38,230
جذابة

64
00:03:36,020 --> 00:03:38,230
مشهد رقم سي 77

65
00:03:38,900 --> 00:03:43,530
"ولكن في داخل قلبي، هي أعلى من مستوى كلمة "موي

66
00:03:41,310 --> 00:03:43,520
موي

67
00:03:41,310 --> 00:03:43,520
مشهد رقم أف 77

68
00:03:43,780 --> 00:03:48,080
إنَّني أتطلَّعُ لكيفيَّة استخدامها في الجيل القادم

69
00:03:48,070 --> 00:03:48,780
خادمةٌ جذابة

70
00:03:48,370 --> 00:03:52,790
مثل الخادمة الفاتنة، أو زيُّ آذان القِطَطْ الفاتن

71
00:03:50,240 --> 00:03:51,070
آذانٌ القطط

72
00:03:53,000 --> 00:03:54,940
شيءٌ من هذا القبيل

73
00:03:57,170 --> 00:04:01,280
تفاجأت لأنَّ هذه الملابس أعطتني
انطباعًا مُختلفًا عنكِ عمَّا كان في السابق

74
00:04:01,280 --> 00:04:02,300
هذا كُلُّ ما في الأمر

75
00:04:02,950 --> 00:04:04,260
صدقت في ذلك

76
00:04:04,260 --> 00:04:07,220
ربَّما كنت أرتدي ملابسا أكثير رشدًا وقتها

77
00:04:07,220 --> 00:04:08,560
هكذا إذًا؟

78
00:04:09,890 --> 00:04:14,150
وبمناسبة الحديث عن ذلك، اشتريتُ هذا الطَّقم البارحة

79
00:04:15,020 --> 00:04:16,480
لكن حمدًا لله

80
00:04:16,480 --> 00:04:20,030
أردتك أن تكون أوَّل من يراه

81
00:04:22,440 --> 00:04:26,160
...نيَّتُكِ بأن أشاهدهُ عليكِ أولًا

82
00:04:26,160 --> 00:04:27,450
...كيف أقولها

83
00:04:27,450 --> 00:04:30,200
أشعر بأنَّني محظوظٌ جدًّا وتشرَّفتُ بذلك

84
00:04:30,760 --> 00:04:33,210
لم أُرِدْ أن أُريك إيَّاها

85
00:04:33,500 --> 00:04:34,920
بل أردتُك أن تراها

86
00:04:35,250 --> 00:04:38,290
فهنالك فرقٌ بين الاثنين

87
00:04:41,760 --> 00:04:43,380
بالمناسبة يا أراراجي

88
00:04:43,380 --> 00:04:46,090
ما الذي تفعلهُ هُنا؟

89
00:04:46,090 --> 00:04:48,510
كُنتُ أتجوَّلُ لا أكثر

90
00:04:48,510 --> 00:04:50,560
أردتُ الخروج قليلًا

91
00:04:50,560 --> 00:04:53,890
بعدها وجدتُ هذه الحديقة، فقرَّرت أن آخذ قِسطًا من الراحة

92
00:04:54,350 --> 00:04:55,730
وماذا عنكِ يا سينجوغاهارا؟

93
00:04:55,730 --> 00:04:57,440
هل تأتين غالبًا إلى هذا المكان؟

94
00:04:57,440 --> 00:05:00,570
كُنتُ ألعبُ هُنا في السابق

95
00:04:59,770 --> 00:05:01,140
A

96
00:05:00,570 --> 00:05:01,940
تلعبين؟

97
00:05:01,940 --> 00:05:05,410
تذكَّرت، سبق وأن قلتِ بأنَّكِ كُنتِ تعيشين هُنا

98
00:05:05,410 --> 00:05:06,990
هذا صحيح

99
00:05:08,490 --> 00:05:10,580
لكن لقد تغيَّر كُلُّ شيء

100
00:05:11,080 --> 00:05:14,710
...لستُ عاطفيَّةً تمامًا بشأنه، ولكن

101
00:05:15,500 --> 00:05:22,050
بعد هذه التغيُّرات، تُشعرك لسببٍ ما
أنَّ كلَّ الدوافع قد ذهبت منك

102
00:05:23,300 --> 00:05:25,050
ما باليد حيلة، ألا تتفقين معي؟

103
00:05:26,180 --> 00:05:28,720
صدقت. ما باليد حيلة

104
00:05:30,470 --> 00:05:32,100
أراراجي

105
00:05:32,100 --> 00:05:33,720
هل تُمانع إن جلستُ بجوارك؟

106
00:05:34,390 --> 00:05:35,180
بجواري؟

107
00:05:35,480 --> 00:05:37,270
أريد مناقشتك في أمرٍ ما

108
00:05:38,480 --> 00:05:39,480
لا بأس

109
00:05:39,480 --> 00:05:44,860
جلوسي وحيدًا على الدكَّة غيرُ مُريح

110
00:05:44,860 --> 00:05:45,690
فهمت

111
00:05:45,690 --> 00:05:47,070
إذًا سأجلس

112
00:05:47,980 --> 00:05:48,190
سلطعون

113
00:05:47,980 --> 00:05:48,190
مشهد رقم 124

114
00:05:49,110 --> 00:05:49,320
تلامس

115
00:05:49,110 --> 00:05:49,320
مشهد رقم 126

116
00:05:53,370 --> 00:05:58,080
أردتُ أن أشكُرك مُجدَّدًا على ما فعلته لي

117
00:05:58,080 --> 00:06:02,000
لا حاجة لذلك

118
00:06:02,000 --> 00:06:03,960
اذهبي واشكري أوشينو بدلًا منِّي

119
00:06:03,960 --> 00:06:05,590
سيكون هذا أكثر من كافٍ

120
00:06:07,010 --> 00:06:10,230
سأقوم بدفع الرسوم لأوشينو

121
00:06:10,720 --> 00:06:15,220
أمَّا أنت فأريد شُكرك بطريقةٍ مُختلفةٍ عنه

122
00:06:15,220 --> 00:06:20,730
فقط كُفيّ عن الاعتقاد بأنَّكِ مدينةٌ لي

123
00:06:21,480 --> 00:06:24,320
وإلَّا سيكون من الصعب علينا أن ننسجم

124
00:06:25,190 --> 00:06:26,780
ننسجم؟

125
00:06:28,570 --> 00:06:29,700
أراراجي

126
00:06:30,610 --> 00:06:34,490
هل بإمكاني أن أعتبرك شخصًا قريبًا منِّي؟

127
00:06:36,410 --> 00:06:37,870
بالتَّأكيد

128
00:06:37,870 --> 00:06:42,650
لكن يبدو أنَّك شخصٌ ليس لديه العديد من الأصدقاء، صحيح؟

129
00:06:43,000 --> 00:06:44,920
كُنتُ كذلك حتَّى السنة الماضية

130
00:06:44,920 --> 00:06:48,910
فقد حدثت لي نقلةٌ نوعيَّة في عطلة الربيع الفائت

131
00:06:45,750 --> 00:06:46,370
العطلة الربيعية

132
00:06:45,750 --> 00:06:46,370
مشهد رقم بي 151

133
00:06:47,080 --> 00:06:47,790
مشهد رقم سي 151

134
00:06:50,300 --> 00:06:51,840
وماذا عنكِ يا سينجوغاهارا؟

135
00:06:52,430 --> 00:06:54,220
كُنتُ مِثلك حتَّى وقتٍ قريب

136
00:06:55,010 --> 00:06:57,980
إلى أن قابلتك بالتَّحديد

137
00:06:58,680 --> 00:07:00,140
ما هذا؟

138
00:07:00,140 --> 00:07:01,870
!وما هذا الوضع؟

139
00:07:01,870 --> 00:07:05,280
كما لو أنَّها.. تُريد إفصاح حُبِّها لي

140
00:07:06,610 --> 00:07:08,610
لأوضِّح لك أكثر

141
00:07:08,610 --> 00:07:13,190
مهما كان ردُّك لي، ما زِلتُ أرغب
في تقديم امتناني وشكري لك

142
00:07:14,070 --> 00:07:16,290
...وعندما أنتهي من ذلك، وللمرَّة الأولى

143
00:07:16,990 --> 00:07:19,750
سنُصبح صديقين مُتساويين

144
00:07:21,710 --> 00:07:22,580
صديقين؟

145
00:07:23,200 --> 00:07:23,450
إطارٌ أحمر

146
00:07:23,200 --> 00:07:23,450
مشهد غير مرقم

147
00:07:23,460 --> 00:07:24,750
!صديقين

148
00:07:25,160 --> 00:07:29,790
العودة إلى سياق الحديث

149
00:07:25,170 --> 00:07:29,800
لذا يا أراراجي، هل يوجد شيءٌ تُريدني أن أفعله لك؟

150
00:07:30,220 --> 00:07:32,630
سأفعل أيَّ شيءٍ لهذه المرَّة فقط

151
00:07:33,270 --> 00:07:34,090
أيَّ شيء؟

152
00:07:34,430 --> 00:07:39,180
إنَّني جادَّةٌ في ذلك. سألبِّي لك أمنيتك

153
00:07:39,180 --> 00:07:44,270
سواءً كانت سيطرةً على العالم، أو الخلود، أو
القضاء على الساينز المتَّجهين للأرض الآن

154
00:07:44,270 --> 00:07:47,570
!أتودِّين القول بأنَّكِ أقوى من شن لونج؟

155
00:07:47,570 --> 00:07:48,710
بالطَّبع

156
00:07:48,710 --> 00:07:50,030
يا لهذه الثقة

157
00:07:50,490 --> 00:07:56,370
لأصدِقَك القول، سيكون من الأفضل مُساعدتك في شيءٍ خاص

158
00:07:56,370 --> 00:07:57,510
لأنَّ ذلك أسهل

159
00:07:57,510 --> 00:07:58,410
بالتَّأكيد

160
00:07:59,500 --> 00:08:01,410
كما قُلت، أيَّ شيء

161
00:08:01,410 --> 00:08:04,880
مثلًا إن أردتني أن أنهي أيَّ جُملةٍ أقولُها بـ "نيو" لمدَّة أسبوع

162
00:08:04,880 --> 00:08:08,340
أو أن لا أرتدي ملابس داخليَّة في المدرسة لمدَّة أسبوع

163
00:08:09,380 --> 00:08:13,280
أو أوقظك كلَّ صباح لمدَّة أسبوع مُرتديةً مريلة الطَّبخ فقط

164
00:08:13,280 --> 00:08:16,970
أو أنضمُّ معك في نظامٍ غذائي لمدَّة أسبوع

165
00:08:16,970 --> 00:08:19,600
تملكُ العديد من الخيارات، أليس كذلك؟

166
00:08:19,600 --> 00:08:24,100
!هل تظنِّين بأنَّني مُنحرفٌ مجنون إلى هذا الحد؟

167
00:08:24,100 --> 00:08:26,520
ألستِ فظَّةً بعض الشيء؟

168
00:08:26,520 --> 00:08:29,110
...أرجو المعذرة ولكن

169
00:08:29,110 --> 00:08:34,410
لا أعتقد بأنَّي قادرةٌ على فِعلها طِوال حياتي

170
00:08:34,410 --> 00:08:36,470
!!كلَّا! أنتِ مُخطئة، مُخطئة، مُخطئة

171
00:08:36,470 --> 00:08:41,070
لستُ غاضبًا لأنَّ مستوى انحرافي أكثر مِمَّا توقَّعتِ

172
00:08:41,660 --> 00:08:42,540
هكذا إذًا؟

173
00:08:43,460 --> 00:08:49,460
أقترح أن تجعلني أوقظك كلَّ صباح ولمدَّة أسبوع مُرتديةً مريلة الطَّبخ فقط

174
00:08:49,920 --> 00:08:53,130
وسأصنع طعام الإفطار إن أردت ذلك

175
00:08:53,130 --> 00:08:57,090
ألا يُعتبر ذلك جنَّةً للرجال ورومنسيٌّ أيضًا؟

176
00:08:57,390 --> 00:08:59,520
استمعي إليَّ يا سينجوغاهارا

177
00:08:59,520 --> 00:09:02,730
...إن اتفقنا على فِعلكِ لذلك

178
00:09:02,730 --> 00:09:06,730
عندها لا يُمكن أن نكون صديقين

179
00:09:07,100 --> 00:09:07,850
إطارٌ أسود

180
00:09:07,100 --> 00:09:07,850
مشهد غير مرقم

181
00:09:07,350 --> 00:09:10,360
صدقت فيما قُلت

182
00:09:10,360 --> 00:09:14,400
هذا صحيح. لنضع الأمور الجنسيَّة جانبًا

183
00:09:14,740 --> 00:09:20,200
على كلٍّ، توقَّعت بأنَّك لن تطلُب شيئًا شهوانيًّا

184
00:09:20,990 --> 00:09:22,580
إذًا أنتِ تثقين بي

185
00:09:23,370 --> 00:09:24,410
لأنَّك أعْذَر

186
00:09:25,000 --> 00:09:26,870
لقد قالت لي ذلك من قبل

187
00:09:27,250 --> 00:09:30,340
العذارى من أمثالك ليسوا بهذا الطَّمع، لذا أشعرُ بالارتياح

188
00:09:30,340 --> 00:09:32,800
استمعي إليَّ يا سينجوغاهارا

189
00:09:32,800 --> 00:09:35,380
أنتِ لا تملكين الخبرة في ذلك أيضًا، صحيح؟

190
00:09:35,380 --> 00:09:38,030
ما الذي تقوله؟ بل أملك خبرةً واسعة

191
00:09:38,030 --> 00:09:39,090
...فهمت

192
00:09:39,340 --> 00:09:40,300
أفعلها طِوال الوقت

193
00:09:42,390 --> 00:09:48,980
لنفترض بأنَّ ما قُلتهِ صحيح

194
00:09:48,980 --> 00:09:51,360
ما الذي ستجنينه من إخباري بذلك؟

195
00:09:52,610 --> 00:09:55,030
فهمت. سأصحِّحُ ما قُلت

196
00:09:56,490 --> 00:09:59,240
ليست لديَّ أيُّ خِبرة. أنا عذراء

197
00:10:00,030 --> 00:10:01,110
إطارٌ أسود

198
00:10:00,030 --> 00:10:01,110
مشهد غير مرقم

199
00:10:00,410 --> 00:10:05,510
...وهذا يعني، أنَّ الفتيات اللاتي يتحدَّثن مع أعْذَرٍ ميؤوسٍ منهُ مِثلُك

200
00:10:05,510 --> 00:10:09,630
!عذراءٌ مجنونةٌ مثلي بمشاكل نفسيَّة

201
00:10:10,240 --> 00:10:11,950
إفصاحٌ صريح

202
00:10:12,420 --> 00:10:14,180
لقد انحرفنا عن مسار موضوعنا

203
00:10:14,180 --> 00:10:16,550
لكن أصدقني القول، أتودُّ الحديث معي عن أمرٍ ما؟

204
00:10:16,550 --> 00:10:19,500
ولأكون أكثر وضوحًا، أيوجد شيءٌ ما يُزعجك؟

205
00:10:20,140 --> 00:10:22,080
...شيءٌ يزعجني

206
00:10:22,080 --> 00:10:25,040
لستُ مُتحدِّثةً جيِّدة

207
00:10:25,040 --> 00:10:28,520
لكنَّني أرغبُ في مُساعدتك

208
00:10:30,440 --> 00:10:33,320
...فهمت. إن كُنتُ قادرًا على إخباركِ بذلك

209
00:10:33,320 --> 00:10:35,030
ماذا هُناك؟

210
00:10:35,030 --> 00:10:39,070
حدِّثني بالأمر. هذا سيجعلك تشعرُ بالراحة كما يقولون

211
00:10:41,990 --> 00:10:44,080
لقد تشاجرتُ مع أختي الصغيرة

212
00:10:44,370 --> 00:10:47,040
لا أستطيع مُساعدتك في أمرٍ كهذا

213
00:10:48,500 --> 00:10:50,870
وللحيطة فقط سأستمع للقصَّة بالكامل

214
00:10:51,250 --> 00:10:52,580
للحيطة"؟"

215
00:10:53,790 --> 00:10:56,760
إذًا مع مَن تشاجرت؟

216
00:10:56,760 --> 00:11:00,220
ما أعنيه هو أنَّك تملِكُ شقيقتين، صحيح؟

217
00:11:00,970 --> 00:11:02,140
تعلمين بذلك؟

218
00:11:02,890 --> 00:11:05,180
الشقيقة الكُبرى

219
00:11:05,180 --> 00:11:07,310
لكنَّ المُشكلة مع كِليهما

220
00:11:07,810 --> 00:11:11,850
دائمًا وأبدًا يبدأن بأسئلة الاستفهام وسؤالٍ بالتعجُّب

221
00:11:11,850 --> 00:11:14,570
وذلك لأنَّهُنَّ يتسكَّعن معًا كثيرًا

222
00:11:14,570 --> 00:11:17,750
"هُنَّ المعروفات في مدرسة تسوجانوكي الإعداديَّة بـ "الشقيقتين النَّاريَّتين

223
00:11:17,750 --> 00:11:19,780
وتعرفين بما يُلقَّبن أيضًا؟

224
00:11:20,070 --> 00:11:21,990
اليوم هو يوم الأم، أليس كذلك؟

225
00:11:23,570 --> 00:11:24,950
هذا صحيح

226
00:11:25,910 --> 00:11:29,040
كِليهما مُتعلِّقتان بوالدتي

227
00:11:29,040 --> 00:11:33,070
وأمِّي تُحبُّهما مثل حُبِّ القِطَّة لأبنائها

228
00:11:33,070 --> 00:11:33,690
لذا

229
00:11:33,690 --> 00:11:34,460
فهمت

230
00:11:35,000 --> 00:11:42,590
هذا يعني، بأنَّ المنزل في يوم الأم لم يعُد مُلكًا لك

231
00:11:43,300 --> 00:11:44,550
كما قُلتِ

232
00:11:46,010 --> 00:11:48,970
استيقظتُ باكرًا لكي أتسلَّل خارج المنزل

233
00:11:48,010 --> 00:11:56,560
A

234
00:11:49,310 --> 00:11:53,360
لكن رأتني أختي وأنا أركبُ درَّاجتي الجبليَّة

235
00:11:51,510 --> 00:11:55,680
O

236
00:11:53,360 --> 00:11:54,690
وتجادلنا

237
00:11:54,690 --> 00:11:55,650
تجادلتُما؟

238
00:11:55,650 --> 00:12:00,080
أرادت منِّي البقاء والاحتفال معهم في يوم الأم

239
00:11:55,680 --> 00:12:03,570
O

240
00:11:56,560 --> 00:12:01,810
A

241
00:12:00,080 --> 00:12:03,570
لكن... لا أستطيع فِعل ذلك

242
00:12:03,570 --> 00:12:05,620
...إن كُنتَ ستتصرَّف هكذا يا أخي

243
00:12:03,570 --> 00:12:08,190
كارين غاضبة

244
00:12:05,620 --> 00:12:08,200
...إن استمرَّيت في ذلك، ومهما طال الزمن سوف

245
00:12:12,210 --> 00:12:13,330
بشكلٍ أوضح

246
00:12:13,670 --> 00:12:15,960
لا أستطيع الاحتفال في يوم الأم

247
00:12:16,340 --> 00:12:20,760
وأغضبُ بشدَّة ممَّا تقوله أختي التي تصغُرُنُي بأربعة أعوام

248
00:12:21,300 --> 00:12:25,140
كيف أوضِّحُ لكِ... أشعرُ بأنَّني إنسانٌ تافه

249
00:12:25,140 --> 00:12:27,710
ومهما غضبت، لا أستطيع فعل شيءٍ حِيال ذلك

250
00:12:29,100 --> 00:12:30,680
يا لها من مُشكلةٍ مُعقَّدة

251
00:12:30,680 --> 00:12:33,760
ليست مُعقَّدة، بل غير مُهمَّة

252
00:12:33,760 --> 00:12:36,230
أنا فقط إنسانٌ تافه لا أكثر

253
00:12:36,650 --> 00:12:40,310
...وكُلَّما فكَّرتُ في الاعتذار لأختي

254
00:12:40,310 --> 00:12:42,320
أقرِّر عدم الرجوع إلى المنزل

255
00:12:42,820 --> 00:12:45,200
لا ترغبُ في العودة؟

256
00:12:46,820 --> 00:12:52,540
للأسف. حتَّى بقدراتي، لا أستطيع مُساعدتك في كونك إنسانٌ تافه

257
00:12:52,540 --> 00:12:54,290
على الأقل شجِّعيني

258
00:12:54,290 --> 00:13:00,090
بالتَّاكيد. للأسف. حتَّى بقدراتي، لا أستطيع مُساعدتك في كونك إنسانٌ تافه

259
00:13:01,380 --> 00:13:03,920
يبدو أنَّني شخصٌ مُمِل بالنسبة لكِ

260
00:13:04,260 --> 00:13:06,720
وأواجه المتاعب في أمورٍ بسيطة

261
00:13:06,720 --> 00:13:09,100
لا أفهمُ ذلك... مُطلقًا

262
00:13:10,510 --> 00:13:11,630
...أمورٌ بسيطة

263
00:13:11,630 --> 00:13:13,310
يُمكنكِ تسميتُها بالمُملَّة

264
00:13:13,730 --> 00:13:18,360
"مثل الملل من سحب ورقة الأوميكوجي والمكتوب بداخلها "حظٌّ بسيط

265
00:13:18,860 --> 00:13:21,690
لا يُمكنك إنكار أنَّك جذَّاب يا أراراجي

266
00:13:21,690 --> 00:13:26,200
جذَّاب؟ وهل هي مثلُ سحب ورقة  "حظٌّ بسيط"؟

267
00:13:26,200 --> 00:13:27,460
كُنتُ أمزح

268
00:13:27,460 --> 00:13:32,160
"ثمَّ كونك مُمِلًّا ليس مِثل سحب ورقة "حظٌّ بسيط

269
00:13:32,150 --> 00:13:33,110
بسيط

270
00:13:32,150 --> 00:13:33,110
حظٌّ

271
00:13:33,120 --> 00:13:35,520
أتودِّين القول أنَّها مثلُ ورقة "الحظِّ السيِّئ"؟

272
00:13:35,520 --> 00:13:38,300
غيرُ مُمكن. سيكون ذلك مُدهشًا

273
00:13:38,300 --> 00:13:40,130
أو بالأحرى، سيكون ذلك مُناسبًا

274
00:13:40,670 --> 00:13:42,800
...أراراجي، الوصف لكونك مُمِلًّا

275
00:13:45,710 --> 00:13:53,130
A

276
00:13:45,720 --> 00:13:51,890
مِثل سحب ورقة "حظٌّ رائع"، ولكن عندما تقرأ المحتوى، لا تجدُها بتلك الروعة

277
00:13:51,890 --> 00:13:53,180
هذا هو الوصف المُناسب لك

278
00:13:53,970 --> 00:13:55,100
هذا مُمِلٌ بحقْ

279
00:13:55,100 --> 00:13:59,700
لكن يا أراراجي، الأخوات الصغيرات وُجدوا ليكونوا محبوبات

280
00:13:59,700 --> 00:14:01,060
لا نفعلن شيئًا سوى الشِجار

281
00:14:02,190 --> 00:14:05,240
هل منظرهم قبيح ويجعل عيناك تنزفُ دمًا؟

282
00:14:05,240 --> 00:14:07,280
!ليسوا قبيحات المنظر

283
00:14:07,280 --> 00:14:10,490
أو ربَّما لأنَّك من النوع الذي يُظهر حُبَّهُ بطريقةٍ عكسيَّة

284
00:14:10,780 --> 00:14:13,700
"لم أتوقَّع بأنَّك "سيسكون

285
00:14:13,700 --> 00:14:15,040
لستُ كذلك

286
00:14:15,040 --> 00:14:19,270
من يُفكِّر في حُبِّهم بتلك الطريقة هو من لا يملك شقيقات

287
00:14:19,270 --> 00:14:22,420
إذًا أنت لا تميلُ لهُمْ

288
00:14:22,420 --> 00:14:25,010
ولن تعشق شقيقاتك

289
00:14:25,460 --> 00:14:26,550
وكأنَّني سأفعلُ ذلك

290
00:14:26,550 --> 00:14:29,630
هذا صحيح، يبدو أنَّك يا أراراجي تُفضِّل السوروكون

291
00:14:29,630 --> 00:14:30,720
سوروكون؟

292
00:14:30,720 --> 00:14:32,490
"اختصارٌ لـ "زواج الأخوات

293
00:14:32,490 --> 00:14:34,340
عُرف أيضًا بالزواج الشامل للأخوات

294
00:14:34,340 --> 00:14:39,390
ويعني بأن تتزوَّج الأخت الصغرى أو الكبرى عندما تموت زوجتك

295
00:14:40,730 --> 00:14:43,810
ولمَ أفكِّر في زواج الأخوات؟

296
00:14:43,810 --> 00:14:47,000
في حالتك يا أراراجي، ستُفضِّل الزواج من الصغرى بدلًا من الكُبرى

297
00:14:47,000 --> 00:14:53,580
أوَّلًا، أخت زوجتك ستجعلُها تُناديك بـ "أخي الكبير"، وبعد ذلك ستتزوَّجُها

298
00:14:48,940 --> 00:14:49,560
شرح تزوج الأخوات

299
00:14:49,560 --> 00:14:51,360
أخي الكبير

300
00:14:53,580 --> 00:14:56,870
"حتَّى بعد الزواج، ستجعلُها تُناديك بـ "أخي الكبير

301
00:14:56,870 --> 00:14:59,920
...وبذلك، وبالمعنى المُتعارف عليه، سوف تُصبحُ

302
00:14:59,920 --> 00:15:02,540
!ألا يعني ذلك بأنَّني قتلتُ زوجتي السابقة؟

303
00:15:02,540 --> 00:15:04,800
...إذًا أيُّها السوروكون أراراجي

304
00:15:04,800 --> 00:15:07,320
"أرجوكِ نادني بـ "سيسكون

305
00:15:07,320 --> 00:15:10,450
لكن أخبرتني بأنَّك لا تُريد أختك الصُغرى

306
00:15:10,450 --> 00:15:12,510
!وأيضًا لن أفعل ذلك مع أخت زوجتي

307
00:15:12,760 --> 00:15:15,720
إذًا، هل ستعشقُ فتاةً بسبب شعورك بوجوب ذلك؟

308
00:15:15,720 --> 00:15:16,770
...قُلتُ لكِ

309
00:15:16,420 --> 00:15:17,130
إطارٌ أحمر

310
00:15:16,420 --> 00:15:17,130
مشهد غير مرقم

311
00:15:18,060 --> 00:15:19,980
أيُمكن أن أعشق أحدًا هكذا؟

312
00:15:20,810 --> 00:15:25,190
ما تزالُ صغيرًا لأنَّك صُدِمت بسبب نُكتةٍ لطيفة

313
00:15:25,190 --> 00:15:27,280
كلامكِ لم يكُن كذلك

314
00:15:27,280 --> 00:15:29,400
كُنتُ أختبرُك

315
00:15:29,400 --> 00:15:31,750
ولمَ تفعلين ذلك؟

316
00:15:31,750 --> 00:15:35,160
!مهلًا، لمْ تكوني جادَّةً للتوّ؟

317
00:15:35,450 --> 00:15:37,620
سأتحوَّل عندما يحدثُ ذلك

318
00:15:38,080 --> 00:15:39,450
تتحوَّلين؟

319
00:15:39,450 --> 00:15:40,540
!مُدهش! أريني ذلك

320
00:15:41,540 --> 00:15:45,380
هذه ردَّة فِعلٍ كبيرة لبشريٍّ تافه

321
00:15:45,380 --> 00:15:50,720
لكن مهما كُنت تافهًا، لن أترُكك لوحدك أبدًا

322
00:15:50,720 --> 00:15:54,050
سأتعامل مع تفاهتك حتَّى النهاية

323
00:15:54,340 --> 00:15:56,560
كلماتكِ كانت مُعقَّدة وغريبة

324
00:15:56,560 --> 00:16:01,950
إذًا هل هُنالك شيءٌ آخر يُزعجك غير كونك إنسانٌ تافه؟

325
00:16:01,950 --> 00:16:04,940
أيُّ نوعٍ من الإساءة وقعتُ بها الآن؟

326
00:16:05,190 --> 00:16:07,320
لديك تسامحٌ مُذهل

327
00:16:07,320 --> 00:16:09,190
لا تُبالغي في الاطراء

328
00:16:09,610 --> 00:16:11,430
أحقًّا لا يوجد شيء؟

329
00:16:11,430 --> 00:16:13,450
أتُريدني أن أساعدك في دراستك؟

330
00:16:13,450 --> 00:16:15,590
لقد تخلَّيتُ عن ذلك

331
00:16:15,590 --> 00:16:17,200
لا بأس طالما أنَّني قادرٌ على التخرُّج

332
00:16:17,530 --> 00:16:19,200
إذًا سأساعدك في ذلك

333
00:16:19,200 --> 00:16:20,950
أستطيع فِعل ذلك بنفسي

334
00:16:21,330 --> 00:16:23,080
إذًا تُريد فِعل ذلك بنفسك؟

335
00:16:23,080 --> 00:16:25,540
أنتِ تُحاولين أن تفتعلي شجارًا بيننا، أليس كذلك؟

336
00:16:25,540 --> 00:16:27,130
أظنُّ ذلك

337
00:16:29,170 --> 00:16:31,010
هل تُريد عشيقة؟

338
00:16:35,590 --> 00:16:37,180
..."لو قُلتُ "أريدُ ذلك

339
00:16:38,350 --> 00:16:39,510
فما الذي ستفعلينه؟

340
00:16:40,560 --> 00:16:42,020
ستحصلُ على ذلك

341
00:16:42,980 --> 00:16:44,270
هذا كلُّ ما في الأمر

342
00:16:47,520 --> 00:16:50,860
كلَّا. في الحقيقة لا أريدُ ذلك

343
00:16:53,700 --> 00:16:54,490
فهمت

344
00:16:54,490 --> 00:16:57,150
اشتري لي عُلبة عصير في المرَّة القادمة

345
00:16:57,150 --> 00:16:59,120
وسنكون مُتعادلين

346
00:16:59,830 --> 00:17:00,700
فهمت

347
00:17:01,410 --> 00:17:02,620
لست أنانيًّا

348
00:17:02,620 --> 00:17:04,830
حقًّا تسامحُك مُذهل

349
00:17:11,710 --> 00:17:14,300
لقد رأيتُ هذه الفتاة من قبل

350
00:17:15,300 --> 00:17:16,930
سينجوغاهارا

351
00:17:17,300 --> 00:17:21,350
كيف يُمكنكِ تهجئة ما كُتب على حقيبة طالبة الابتدائيَّة تِلك؟

352
00:17:22,970 --> 00:17:24,350
لا أستطيع رؤية ما تحدَّثت عنه

353
00:17:25,520 --> 00:17:27,940
هل الناس الطبيعيُّون لا يرون شيئًا من هذا المدى؟

354
00:17:27,940 --> 00:17:32,210
هُنالك أرقام وحروف كانجي، رقم ثمانية وتسعة، ومعبد

355
00:17:32,210 --> 00:17:34,730
"وبوضعها في كلمةٍ واحدة، ستكون "هاتشيـ - ـكيو - ديرا

356
00:17:34,730 --> 00:17:36,660
تُقرأُ هاتشيكوجي

