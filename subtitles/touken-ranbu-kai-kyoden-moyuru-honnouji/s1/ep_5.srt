1
00:00:06,180 --> 00:00:08,450
ما الأمر يا رانمارو-دونو؟

2
00:00:10,440 --> 00:00:12,160
ميتسوهيدي-ساما

3
00:00:12,160 --> 00:00:18,030
سامحني. كان عليّ السّؤال، بما أنّك
بدوت مكتئباً جدّاً

4
00:00:18,030 --> 00:00:21,910
يا إلهي. يبدو أنّك وجدتني تائهاً في التّفكير

5
00:00:21,910 --> 00:00:24,850
هل هناك ما يُقلقك؟

6
00:00:25,450 --> 00:00:26,720
...في الواقع

7
00:00:27,960 --> 00:00:32,500
مولايّ منحني هذا السّيف

8
00:00:33,220 --> 00:00:36,680
هل هذا... فودو يوكيميتسو؟

9
00:00:46,110 --> 00:00:47,480
ما الأمر؟

10
00:00:50,380 --> 00:00:52,820
،فودو يوكيميتسو، تسوكوموغامي علبة الشّاي"

11
00:00:53,500 --> 00:00:56,410
"!ونيوا ناغاهيدي، كلّ الثّلاثة مُلكي

12
00:00:57,910 --> 00:01:00,860
،عندما يشرب مولانا وهو بمزاج سعيد

13
00:01:00,860 --> 00:01:02,410
غالباً ما يصفع ركبتيه

14
00:01:02,410 --> 00:01:04,370
ويلقي تلك القصيدة بصوتٍ عال

15
00:01:04,370 --> 00:01:08,340
ذلك السّيف هو كنز مكافئ لأيّ أرض

16
00:01:08,880 --> 00:01:13,170
لكن لماذا مولانا يعطيه لرانمارو-دونو؟

17
00:01:13,170 --> 00:01:16,050
إنّه قيّم جدّاً على أن يحمله مجرّد فتى

18
00:01:16,660 --> 00:01:22,010
هذا يعني ببساطة أنّ مولانا
يقدّر موري رانمارو فوق الجميع

19
00:01:24,460 --> 00:01:25,430
ما الأمر؟

20
00:01:25,800 --> 00:01:27,220
هل أنت ممتعض؟

21
00:01:27,650 --> 00:01:31,400
أشعر فقط وكأنّ مولايّ يمنحني تذكار وداع

22
00:01:31,820 --> 00:01:34,280
يراودني شعور سيّئ في معدتي

23
00:01:35,170 --> 00:01:39,280
ماذا تقول؟ مولانا حيّ يُرزَق

24
00:01:39,280 --> 00:01:44,200
.هذا السّيف ليس مجرّد تذكار
قدّره لبقيّة حياتك

25
00:01:44,660 --> 00:01:48,450
والآن، لدينا أعمال نقوم به. وداعاً

26
00:01:55,900 --> 00:01:58,260
،فودو يوكيميتسو، تسوكوموغامي علبة الشّاي"

27
00:01:58,990 --> 00:02:02,150
"!ونيوا ناغاهيدي، كلّ الثّلاثة مُلكي

28
00:03:50,530 --> 00:03:54,500
يقيم نوبوناغا جلسة شاي قبل
،يوم من حادثة هونّوجي

29
00:03:55,270 --> 00:03:58,250
دون أن يعلم بأنّ مصيره الموت غداً

30
00:03:58,600 --> 00:04:00,020
!يا للاستهتار

31
00:04:00,760 --> 00:04:04,090
اشتهر نوبوناغا بجمعه للقطع الفنّية

32
00:04:04,450 --> 00:04:09,180
هناك روايات تفيد بأنّه استُدرِج إلى هونّوجي
باستخدام أداة شاي شهيرة

33
00:04:09,640 --> 00:04:12,830
لكن هذه ليست إلّا نظريّات

34
00:04:13,450 --> 00:04:15,740
جلسة الشّاي هذه تتوافق مع الحقيقة التّاريخيّة

35
00:04:15,740 --> 00:04:19,580
لم نتحقّق من أي تدخُّل لجيش الانحسار الزّمنيّ

36
00:04:19,580 --> 00:04:22,820
لعلّهم يستهدفون آكيتشي ميتسوهيدي إذاً

37
00:04:23,580 --> 00:04:25,450
من المبكّر جدّاً الجزم

38
00:04:25,820 --> 00:04:29,020
آمل أن يمدّنا هاسيبي والآخرون
بمزيد من المعلومات

39
00:04:33,470 --> 00:04:37,380
يبدو أنّ قوّات آكيتشي متجمّعة في قلعة كامياما

40
00:04:37,830 --> 00:04:40,790
يبدون جاهزين للقتال في أيّ لحظة

41
00:04:41,210 --> 00:04:43,340
معظم الرّجال هنا

42
00:04:43,340 --> 00:04:47,050
يعتقدون بأنّهم متوجّهون لتوفير
الدّعم في قلعة بيتشو-تاكاماتسو

43
00:04:47,430 --> 00:04:52,140
لا يملكون أدنى فكرة بأنّهم على وشك
الذّهاب لقتل أودا نوبوناغا

44
00:04:52,490 --> 00:04:56,070
هذا يشير إلى مدى سرّية العمليّة برمّتها

45
00:04:56,850 --> 00:04:59,440
لا أثر لاستهداف جيش الانحسار
الزّمني لهذا المكان

46
00:04:59,950 --> 00:05:03,010
في هذه الحالة، ينبغي أن نعيد تنظيم
أنفسنا مع يامانباغيري والآخرين

47
00:05:04,420 --> 00:05:07,740
هل سنجد حقّاً أيّ عدوّ بالبحث
في هذه الأرجاء هنا؟

48
00:05:08,090 --> 00:05:11,540
نحن لسنا في حالة مراقبة لجيش
الانحسار الزّمنيّ فقط

49
00:05:11,540 --> 00:05:15,980
إشارات التّاريخ المُعدَّل قد تظهر
بأشكال وأحجام مختلفة

50
00:05:15,980 --> 00:05:16,830
...المعذرة

51
00:05:16,830 --> 00:05:21,670
أظنّني مررتُ عبر كيوتو هنا
آنذاك عندما كنتُ سيفاً

52
00:05:22,220 --> 00:05:24,420
أقصد مع نوبوناغا ورانمارو

53
00:05:25,290 --> 00:05:27,390
ما هذا الشّعور؟

54
00:05:27,950 --> 00:05:30,370
هل هو الحنين؟

55
00:05:30,370 --> 00:05:31,810
!أجل، هذا هو

56
00:05:32,370 --> 00:05:34,680
يملؤني الحنين الآن

57
00:05:36,790 --> 00:05:38,420
هل تشعر بالحنين أيضاً؟

58
00:05:38,970 --> 00:05:39,740
ماذا؟

59
00:05:39,740 --> 00:05:44,230
أنا متأكّد بأنّك قضيت الوقت في كيوتو
هذا العصر أيضاً

60
00:05:44,930 --> 00:05:47,110
ماذا لو فعلتُ ذلك؟

61
00:05:47,860 --> 00:05:51,330
كلّ ما في الأمر هو... أنّ الحنين شعور غريب

62
00:05:52,070 --> 00:05:55,660
يرافقه بهجة وحزن في نفس الوقت

63
00:05:57,170 --> 00:05:58,420
أخبرني يا سوزا

64
00:05:59,050 --> 00:06:00,610
هل يمكننا الذّهاب واللّقاء به؟

65
00:06:01,540 --> 00:06:03,500
اللّقاء بمن؟

66
00:06:03,830 --> 00:06:05,220
نوبوناغا

67
00:06:05,800 --> 00:06:07,640
...كلّ ما أريده هو إمعان النّظر في وجهه

68
00:06:07,640 --> 00:06:08,720
لا يجوز أن تفعل

69
00:06:08,720 --> 00:06:11,510
!أرجوك! كلّ ما أحتاجه هو لحظة واحدة

70
00:06:11,510 --> 00:06:13,340
نحن في مهمّة الآن

71
00:06:13,340 --> 00:06:16,340
الخلط بين العمل والمسائل الخاصّة
أمر غير مقبول ببساطة

72
00:06:17,050 --> 00:06:18,600
ما الّذي يجري؟

73
00:06:18,600 --> 00:06:19,870
!اندلعَتْ معركة

74
00:06:24,070 --> 00:06:26,300
!اللّعنة... كيف تجرؤ؟

75
00:06:25,030 --> 00:06:28,820
...ركّز فقط على مهمّتنا... الآن

76
00:06:33,430 --> 00:06:35,110
...فودو يوكيميتسو

77
00:06:38,460 --> 00:06:39,710
تأخّروا

78
00:06:39,710 --> 00:06:42,800
تجاوزنا الوقت المُحدَّد

79
00:06:42,800 --> 00:06:44,710
أتفهّم تأخيراً بسيطاً، لكن هذا غريب

80
00:06:44,710 --> 00:06:48,550
هل تعتقدون بأنّهم التقوا بالعدوّ أثناء بحثهم؟

81
00:06:48,800 --> 00:06:53,850
لا تقلق. سوزا سامونجي لا يسقط بسهولة

82
00:06:54,130 --> 00:06:56,200
في هذه المرحلة، قد يكون لقاء
عدوّ أفضل حتّى

83
00:06:56,200 --> 00:07:00,140
آمل ألّا يسبّب فودو يوكيميتسو
مشكلة ثانية فحسب

84
00:07:00,570 --> 00:07:01,940
تغيّرت الخطّة

85
00:07:02,360 --> 00:07:07,070
سنبحث الآن عن سوزا سامونجي وفودو يوكيميتسو

86
00:07:09,090 --> 00:07:09,950
ماذا؟

87
00:07:10,280 --> 00:07:11,930
أين معبد هونّوجي بالضّبط؟

88
00:07:12,410 --> 00:07:13,740
!فودو يوكيميتسو

89
00:07:14,540 --> 00:07:15,450
!سوزا

90
00:07:16,610 --> 00:07:20,370
السّماح لي بالإمساك بي يثبت بأنّك
ما زلت بحاجة لكثير من التّدريب

91
00:07:20,370 --> 00:07:21,730
في الوقت المثاليّ

92
00:07:21,730 --> 00:07:24,000
لا أعرف الطّريق إلى معبد هونّوجي

93
00:07:24,000 --> 00:07:25,590
—هل يمكنك المجيء معـ

94
00:07:25,590 --> 00:07:27,180
!يكفي يعني يكفي

95
00:07:28,000 --> 00:07:32,550
،حتّى لو التقيت بأودا نوبوناغا
لن يُسمَح لك بتعديل التّاريخ

96
00:07:33,250 --> 00:07:36,100
لم أكن أنوي ذلك

97
00:07:36,100 --> 00:07:38,560
إذاً لماذا تريد رؤيته؟

98
00:07:38,990 --> 00:07:42,230
...من جديد، كما قلتُ... في الواقع

99
00:07:42,580 --> 00:07:44,090
فودو يوكيميتسو

100
00:07:44,090 --> 00:07:47,570
نحن هنا للدّفاع عن التّاريخ

101
00:07:47,930 --> 00:07:48,940
...وهذا

102
00:07:49,370 --> 00:07:52,820
تاريخ قُتِلَ فيه أودا نوبوناغا في هونّوجي

103
00:07:55,700 --> 00:07:57,490
أنت محظوظ يا سوزا

104
00:07:57,950 --> 00:07:58,770
ماذا؟

105
00:07:59,600 --> 00:08:01,810
،مُنِحتُ لرانمارو

106
00:08:01,810 --> 00:08:04,210
لكنّك بقيت بجانب نوبوناغا حتّى النّهاية

107
00:08:04,660 --> 00:08:06,580
،وحتّى أنّه وسمَك

108
00:08:06,580 --> 00:08:09,380
ما يُثبت حبّه الكبير لك، صحيح؟

109
00:08:09,740 --> 00:08:12,720
منحَك كثيراً من الحبّ، وكنتَ
...معه طوال الوقت

110
00:08:13,630 --> 00:08:15,760
فلماذا لم تستطع إنقاذ نوبوناغا؟

111
00:08:17,760 --> 00:08:19,970
!لماذا لم تستطع الحِفاظ على سلامته؟

112
00:08:21,220 --> 00:08:22,020
...أنا

113
00:08:22,860 --> 00:08:29,320
لا أتذكّر ما إن رأيتُ أي معركة
في هونّوجي في ذلك اليوم

114
00:08:29,740 --> 00:08:30,430
ماذا؟

115
00:08:31,290 --> 00:08:32,890
السّيوف هي أشياء

116
00:08:32,890 --> 00:08:37,160
والأشياء تحقّق غايتها كما
هو مطلوب منها فقط

117
00:08:37,650 --> 00:08:38,980
...لكنّني

118
00:08:39,460 --> 00:08:42,230
كنتُ طائراً حبيساً للأبد

119
00:08:43,610 --> 00:08:44,790
...سوزا

120
00:08:46,020 --> 00:08:47,190
ما الأمر؟

121
00:08:49,740 --> 00:08:50,710
ما الأمر؟

122
00:08:51,500 --> 00:08:54,050
كان سوزا سامونجي سيفاً جميلاً

123
00:08:54,940 --> 00:08:55,810
ماذا؟

124
00:08:56,280 --> 00:08:57,590
...ربّما نوبوناغا

125
00:08:58,100 --> 00:09:02,610
ربّما لم يستخدمك لأنّه لم يرد
أن يلطّخ جمالك بالدّم

126
00:09:05,060 --> 00:09:08,310
بينما أنا مجرّد سيف عديم الجدوى

127
00:09:08,860 --> 00:09:14,140
وهذا يجعلني أشعر بانعدام قيمة أكبر حتّى
عندما أرى سيوفاً مذهلة مثلك

128
00:09:14,770 --> 00:09:16,150
...لهذا السّبب أنا

129
00:09:16,150 --> 00:09:19,530
لـ-لماذا فعلت ذلك؟ لا أعتقد بأنّني قلتُ
!شيئاً يُغضبك إلى هذا الحدّ

130
00:09:19,530 --> 00:09:21,370
ليس هذا السّبب

131
00:09:23,640 --> 00:09:24,320
ما هذا؟

132
00:09:24,320 --> 00:09:26,080
!جيش الانحسار الزّمنيّ

133
00:09:32,800 --> 00:09:34,380
!فودو يوكيميتسو

134
00:09:40,050 --> 00:09:42,060
واجهتُما العدوّ فعلاً إذاً

135
00:09:42,060 --> 00:09:43,720
!لم أطلب مساعدتك

136
00:09:44,020 --> 00:09:46,560
لا تسئ فهمي. لا أفعل هذا لأجلك

137
00:09:46,860 --> 00:09:49,440
أنا أتّبع أوامر المعلّم فحسب
وأقضي على عدوّنا

138
00:09:50,330 --> 00:09:51,770
هذا يجعل الدّماء يغلي حقّاً

139
00:10:01,210 --> 00:10:02,530
!لن أدعكم

140
00:10:02,530 --> 00:10:04,410
!لا تطاردهم

141
00:10:04,790 --> 00:10:05,910
اللّعنة

142
00:10:06,430 --> 00:10:08,610
سوزا وأنا سنتعامل مع هذا الأمر

143
00:10:08,610 --> 00:10:10,580
ياغين، الحق بفودو يوكيميتسو

144
00:10:10,580 --> 00:10:12,590
!حسناً، اعتمد عليّ

145
00:10:16,420 --> 00:10:17,630
!انتظروا

146
00:10:18,020 --> 00:10:18,880
!ها أنت ذا

147
00:10:31,990 --> 00:10:33,150
!تبّاً

148
00:10:40,290 --> 00:10:41,250
!ياغين

149
00:10:43,300 --> 00:10:44,870
!لم أنتهِ بعد

150
00:10:54,170 --> 00:10:55,670
أعدادهم لا تنتهي

151
00:10:58,920 --> 00:10:59,930
!توقّفوا

152
00:10:59,930 --> 00:11:01,930
!قمّة الجبن أن تتجمّعوا على شخص

153
00:11:02,290 --> 00:11:05,310
!أنا، موري رانمارو، سنضع حدّاً لهذا

154
00:11:05,870 --> 00:11:06,990
!رانمارو؟

155
00:11:15,580 --> 00:11:17,280
لماذا هنا؟ لماذا الآن؟

156
00:11:17,810 --> 00:11:19,280
لماذا موري رانمارو؟

157
00:11:21,580 --> 00:11:24,400
ما الأمر؟ سأواجهكم

158
00:11:24,400 --> 00:11:25,280
!تعالوا إليّ

159
00:11:27,740 --> 00:11:28,910
...ماذا

160
00:11:34,260 --> 00:11:35,900
هذا غريب

161
00:11:35,900 --> 00:11:38,460
انسحبوا من دون تحقيق هدفهم

162
00:11:38,860 --> 00:11:41,250
رغم ذلك، يسرّني أنّك بخير

163
00:11:41,250 --> 00:11:42,590
أجل، بشكل ما

164
00:11:45,610 --> 00:11:46,860
ألم تتأذّ؟

165
00:11:52,330 --> 00:11:55,110
من كان أولئك الرّجال غريبي الشّكل؟

166
00:11:56,290 --> 00:12:01,280
رغم ذلك، جميعكم متأنّقون بصورة غريبة

167
00:12:02,230 --> 00:12:03,470
!رانمارو

168
00:12:08,200 --> 00:12:09,870
ما الأمر؟

169
00:12:10,230 --> 00:12:11,950
!مضى وقت طويل

170
00:12:11,950 --> 00:12:12,720
ماذا؟

171
00:12:12,720 --> 00:12:14,210
هذا أنا. ألا تتذكّرني؟

172
00:12:14,810 --> 00:12:18,130
—نوبوناغا سلّمني لك! اسمي فودو

173
00:12:18,130 --> 00:12:19,230
هذا يكفي

174
00:12:22,860 --> 00:12:25,140
أعتذر عن سلوك صديقي

175
00:12:25,490 --> 00:12:27,570
سوف ننصرف الآن

176
00:12:27,570 --> 00:12:29,140
شكراً

177
00:12:29,440 --> 00:12:32,780
!انتظر! ماذا تفعل؟

178
00:12:29,730 --> 00:12:31,970
حسناً، سنغادر. كفّ عن المقاومة

179
00:12:32,780 --> 00:12:35,150
!أفلتني! أفلتني

180
00:12:34,020 --> 00:12:35,150
!لحظة واحدة من فضلكم

181
00:12:38,150 --> 00:12:39,650
أنت

182
00:12:40,010 --> 00:12:42,260
تبدو جريحاً

183
00:12:42,970 --> 00:12:44,560
هذا؟

184
00:12:44,560 --> 00:12:47,410
لا عليك. لا يُعتبَر هذا جرح

185
00:12:47,410 --> 00:12:50,660
لا، لا يجوز أن تستخفّ بجرح سيف

186
00:12:50,660 --> 00:12:54,640
إذا ساء، قد يعرّض هذا حياتك لخطر

187
00:12:54,640 --> 00:12:57,170
رغم ذلك، هذا ليس بالأمر الجلل

188
00:12:57,490 --> 00:12:58,480
بل هو كذلك

189
00:12:58,480 --> 00:13:02,010
لستُ قاسياً لدرجة أتخلّى فيها
عن شخص جريح

190
00:13:02,010 --> 00:13:03,860
...لا، لكن

191
00:13:04,290 --> 00:13:07,550
لديّ غرفة في معبد هونّوجي حيث
نحن متمركزون

192
00:13:08,140 --> 00:13:09,890
سأداويك هناك

193
00:13:17,100 --> 00:13:18,090
وجدتهم؟

194
00:13:19,080 --> 00:13:24,320
لا، لا أثر لهم، لذا كنتُ أستمتع بمناظر كيوتو

195
00:13:24,930 --> 00:13:28,020
سوزو أفضل من هذا

196
00:13:28,020 --> 00:13:31,330
لا بدّ أنّ فودو يوكيميتسو فعل شيئاً غبيّاً

197
00:13:31,640 --> 00:13:34,780
احتُسِبَ لذلك عندما تمّ اختيار هذه الفرقة

198
00:13:35,770 --> 00:13:38,320
،ما لم يتصالحوا مع فودو يوكيميتسو

199
00:13:38,320 --> 00:13:44,210
لا تستطيع سيوف أودا القتال للدّفاع
عن التّاريخ معه في حصننا

200
00:13:44,500 --> 00:13:47,180
لا بدّ أنّ هذه هي النّتيجة الّتي
وصل إليها معلّمُنا

201
00:13:47,570 --> 00:13:49,550
على ذكرِ إزالة الضمادات

202
00:13:54,130 --> 00:13:55,430
من هذا؟

203
00:13:56,380 --> 00:13:58,140
...أحد خدم أودا نوبوناغا

204
00:13:58,700 --> 00:13:59,710
ياسكي

205
00:14:00,560 --> 00:14:02,270
هذا هو إذاً

206
00:14:03,340 --> 00:14:07,360
في المهمّة الّتي كادت فيها فرقتي
...بأكملها تُباد

207
00:14:07,740 --> 00:14:12,740
الشّخص الّذي تآمر مع جيش الانحسار
الزّمنيّ لتعديل التّاريخ

208
00:14:12,740 --> 00:14:14,170
كان ياسكي

209
00:14:14,980 --> 00:14:18,250
كان هدفه الثّأر لحادثة هونّوجي

210
00:14:18,560 --> 00:14:24,500
أعتقد بأنّه فُقِدَ بعد الحادثة وتبيّن
لاحقاً بأنّه يخدم الكورودا

211
00:14:25,090 --> 00:14:29,510
إذاً، في هذه الفترة الزّمنيّة، لا يدرك شيئاً

212
00:14:33,050 --> 00:14:35,680
هل تحتاجني في أمر؟

213
00:14:36,050 --> 00:14:40,520
كنتَ تحدّق بي بنيّة قاتلة في عينيك

214
00:14:42,150 --> 00:14:46,230
كلّ ما في الأمر هو أنّ نظراته مُخيفة طوال الوقت

215
00:14:46,530 --> 00:14:48,740
غالباً ما يُساء فهمه

216
00:14:49,210 --> 00:14:52,110
نعتذر إذا سبّب لك الإزعاج

217
00:14:55,930 --> 00:14:56,930
شكراً

218
00:14:57,500 --> 00:15:02,000
لا، أظنّك كنتَ لتكبح جماح نفسك لو لم أتدخّل

219
00:15:02,460 --> 00:15:08,000
فأساساً، ياسكي هو جزء من حادثة هونّوجي

220
00:15:08,000 --> 00:15:11,790
إذا قتلتَه هنا، فستُعدِّل التّاريخ

221
00:15:14,620 --> 00:15:18,890
بوضع ذلك جانباً، يجب أن نجد
سوزا وفودو حالاً

222
00:15:18,890 --> 00:15:21,190
ربّما يكون هاسيبي والآخرون قد وجدوهما بالفعل

223
00:15:21,640 --> 00:15:23,740
لنعد إلى نقطة الاجتماع

224
00:15:28,650 --> 00:15:30,910
ينبغي لهذا أن يفي بالغرض في الوقت الرّاهن

225
00:15:31,890 --> 00:15:33,710
أشكرك على الإسعافات الأوّليّة

226
00:15:34,440 --> 00:15:37,970
وإلّا كنتُ سأضطرّ للخضوع لإصلاحات

227
00:15:37,970 --> 00:15:38,840
ماذا؟

228
00:15:38,840 --> 00:15:40,370
لا شيء، انسَ الأمر

229
00:15:40,370 --> 00:15:43,080
...شكراً

230
00:15:44,990 --> 00:15:48,500
اسمي موري رانمارو، خادم أودا

231
00:15:49,010 --> 00:15:52,850
كنتُ في البلدة لشراء بعض الأشياء لمولايّ

232
00:15:52,850 --> 00:15:58,090
عندما رأيتُكم تُهاجَمون بواسطة أولئك الأشخاص
غريبي الشّكل، انضممتُ للمعركة

233
00:15:58,930 --> 00:16:02,940
نقدّر مساعدتك لغُرباء أمثالنا

234
00:16:02,940 --> 00:16:05,690
لكن لمَ تفعل كلّ هذا لأجلنا؟

235
00:16:05,690 --> 00:16:09,790
كما قلتُ، لن يكون من الصّواب ترك الجرحى

236
00:16:10,540 --> 00:16:15,490
ألم تضع بعين الاعتبار بأنّنا قد نكون أعداءك؟

237
00:16:15,990 --> 00:16:19,530
،لستُ أفهم ذلك بحدِّ ذاتي

238
00:16:19,950 --> 00:16:23,060
لكن لم أستطع اعتباركم غرباء

239
00:16:23,060 --> 00:16:23,670
ماذا؟

240
00:16:25,960 --> 00:16:29,620
صدّقوني. شعرتُ وكأنّها لم تكن
المرّة الأولى الّتي ألتقي فيها بكم

241
00:16:29,620 --> 00:16:33,010
شعرتُ بإحساس غريب بالألفة معكم

242
00:16:33,570 --> 00:16:36,630
ربّما لم أرد ببساطة أن أقول وداعاً بتلك الطّريقة

243
00:16:37,340 --> 00:16:39,470
أتقول ألفة؟

244
00:16:40,010 --> 00:16:44,200
أجل. لقد راودني ذلك الإحساس من قبل

245
00:16:44,200 --> 00:16:45,480
...كان

246
00:16:48,000 --> 00:16:50,390
أجل. كان ذلك معغ ميتسوهيدي-ساما

247
00:16:52,740 --> 00:16:56,870
.آكيتشي هيوغا-نو-كامي ميتسوهيدي-ساما
أنت مثله

248
00:16:56,870 --> 00:16:59,030
من أي ناحية؟

249
00:16:59,030 --> 00:17:01,540
من أي ناحية بالفعل؟

250
00:17:01,990 --> 00:17:05,790
ربّما حبّك الخالد لمولايّ

251
00:17:06,160 --> 00:17:07,040
—ما

252
00:17:07,040 --> 00:17:12,800
هل كنتم تعملون خدماً لأودا؟

253
00:17:13,250 --> 00:17:15,010
...لا، في الواقع

254
00:17:15,010 --> 00:17:19,010
.نحن ممارسون قتاليّون رحّالون ببساطة
ليست لدينا أي صلة بعشيرة أودا

255
00:17:19,010 --> 00:17:25,270
صادف وأن مررنا بكيوتو فحسب. لا أكثر ولا أقلّ

256
00:17:25,270 --> 00:17:28,270
حقّاً؟ أعتذر على افتراضاتي

257
00:17:28,530 --> 00:17:30,150
لا عليك

258
00:17:30,770 --> 00:17:32,480
...اسمع يا رانمارو، أنا

259
00:17:32,480 --> 00:17:36,740
حسناً، لقد عولِج الجرح. لا سبب
يدفعنا للبقاء هنا فترة أطول

260
00:17:36,740 --> 00:17:39,240
أجل، ينبغي أن ننطلق

261
00:17:39,530 --> 00:17:42,240
!لكن تمكنّا من اللِّقاء برانمارو

262
00:17:43,150 --> 00:17:46,460
ينبغي أن تشكره أيضاً

263
00:17:50,130 --> 00:17:52,910
شكراً يا رانمارو. بالتّوفيق

264
00:17:53,720 --> 00:17:56,410
العفو، أتمنّى لكم التّوفيق أيضاً

265
00:17:56,410 --> 00:17:57,890
وداعاً إذاً

266
00:18:01,260 --> 00:18:02,350
موري رانمارو

267
00:18:04,820 --> 00:18:09,310
ماذا يعني أودا نوبوناغا بالنّسبة لك؟

268
00:18:09,600 --> 00:18:10,340
ماذا؟

269
00:18:11,600 --> 00:18:12,760
...سوزا

270
00:18:12,760 --> 00:18:13,570
هيّا بنا

271
00:18:18,110 --> 00:18:19,050
انتظروا

272
00:18:20,350 --> 00:18:23,620
أشعر وكأنّنا سنلتقي ثانية

273
00:18:25,660 --> 00:18:28,670
أجل، لنلتقِ ثانية بالتّأكيد

274
00:18:32,380 --> 00:18:35,380
ماذا يعني أودا نوبوناغا"؟"

275
00:18:40,120 --> 00:18:43,970
لم أتوقّع أن ألتقي بموري رانمارو بالتّحديد

276
00:18:44,490 --> 00:18:47,980
آمل ألّا يؤثّر تفاعلنا على التّاريخ
من أيّ ناحية من النّواحي

277
00:18:48,740 --> 00:18:53,480
أنا آسف. كلّ هذا لأنّنا اشتبكنا
مع العدوّ بصورة طائشة

278
00:18:53,480 --> 00:18:55,820
لا، هذه ليست غلطة سوزا

279
00:18:56,130 --> 00:18:58,870
كلّ هذا لأنّني ابتعدتُ بمفردي

280
00:19:01,620 --> 00:19:04,550
حسناً، ما حدث قد حدث

281
00:19:04,550 --> 00:19:06,870
لكنّها تحيّرني؟

282
00:19:06,870 --> 00:19:08,520
ما هي؟

283
00:19:08,520 --> 00:19:09,960
تصرّفات جيش الانحسار الزّمنيّ

284
00:19:09,960 --> 00:19:14,560
حالما انضمّ رانمارو للمعركة، انسحبوا
دون القيام بأي شيء

285
00:19:14,880 --> 00:19:16,890
ثمّة شيء غريب في الأمر

286
00:19:17,730 --> 00:19:21,120
موري رانمارو هو لاعب محوريّ في حادثة هونّوجي

287
00:19:21,120 --> 00:19:23,400
،إن لم يخطّطوا للاقتراب منه

288
00:19:23,400 --> 00:19:26,620
فلا بدّ أنّ هذا يعني بأنّ هدفهم في طرف
آكيتشي، لا في طرف أودا

289
00:19:26,970 --> 00:19:30,210
هذا أو يخطّطون لأمر آخر

290
00:19:33,250 --> 00:19:34,980
جيّد. جميعكم بخير

291
00:19:35,940 --> 00:19:38,790
المعذرة... آسف يا مانبا-تشان

292
00:19:38,790 --> 00:19:41,910
تصرّفتُ بمفردي وعرّضتُ الجميع لخطر

293
00:19:43,280 --> 00:19:46,250
أنا حقّاً سيف عديم الجدوى

294
00:19:48,370 --> 00:19:51,820
أنت وأنا متشابهان

295
00:20:06,930 --> 00:20:08,890
ما الّذي تتوقّعه من مجرّد نسخة

296
00:20:13,660 --> 00:20:15,620
اسمي يامانباغيري كونيهيرو

297
00:20:16,260 --> 00:20:19,900
،السّيف الّذي صُنِعَ بأمر من ناغاو أكيناغا
حاكم قلعة آشيكاغا

298
00:20:20,930 --> 00:20:23,010
كنسخة من يامانباغيري

299
00:20:23,850 --> 00:20:26,870
لكنّني لستُ مزيّفاً

300
00:20:27,370 --> 00:20:31,770
،أنا أفضل قطعة فنّية لكونيهيرو
وأنا فخور بقولي ذلك

301
00:20:32,900 --> 00:20:39,450
،لكن ظللتُ أعتبر نفسي مجرّد نسخة
ربّما في محاولة للتهرُّب من مسؤوليّاتي

302
00:20:40,630 --> 00:20:43,020
سأؤدّي عملي كسيف خادم

303
00:20:44,180 --> 00:20:45,070
...لذا

304
00:20:46,220 --> 00:20:48,630
أنت تحاول التخلّص من "انعدام جدواك" أيضاً

305
00:20:50,050 --> 00:20:51,340
...مانبا-تشان

306
00:20:52,140 --> 00:20:53,740
هيّا بنا

307
00:20:56,820 --> 00:21:00,780
يجب أن نكتشف ما الّذي سيحدث
في هذه الفترة الزّمنيّة

308
00:21:01,170 --> 00:21:04,110
حالما تمضي هذه اللّيلة، ستبدأ حادثة هونّوجي

309
00:21:04,380 --> 00:21:07,650
مهما فعل العدوّ، يجب أن نحمي ذلك التّاريخ

310
00:21:09,460 --> 00:21:12,120
،عند بزوغ فجر يوم غد

311
00:21:12,120 --> 00:21:15,810
جيش آكيتشي ميتسوهيدي سوف
يحاصر معبد هونّوجي

312
00:21:16,490 --> 00:21:18,620
،سينهزم موري رانمارو

313
00:21:19,170 --> 00:21:21,710
وسيُقاد أودا نوبوناغا إلى الانتحار

314
00:21:22,810 --> 00:21:26,100
"...فودو يوكيميتسو، علبة الشّاي تسوكوموغامي"

315
00:21:26,920 --> 00:21:27,980
مولايّ

316
00:21:31,640 --> 00:21:35,310
أجل. تمرُّد عظيم جدّاً لدرجة أنّه
دُوِّنَ في كتُب التّاريخ

317
00:21:35,860 --> 00:21:37,460
باسم حادثة هونّوجي

318
00:21:38,270 --> 00:21:40,780
يجب أن نضمن حدوثه كما سُجِّل

319
00:21:45,260 --> 00:21:46,360
!من هناك؟

320
00:21:47,300 --> 00:21:48,950
...أنتم أولئك الأشخاص

321
00:21:49,450 --> 00:21:50,950
!أيّها الأوغاد

322
00:21:56,710 --> 00:21:57,960
ماذا تفعلون؟

323
00:21:57,960 --> 00:22:00,460
!اتركوني... أفلتوني