1
00:00:32,210 --> 00:00:35,220
أفترض أنّ هذا ليس وقت الضّحك

2
00:00:39,850 --> 00:00:40,770
!ميكازوكي

3
00:00:43,650 --> 00:00:45,390
كانت مهارة مُبهرة

4
00:00:46,010 --> 00:00:49,030
مثلما تُشرِق الشّمس على القمر"؟"

5
00:00:49,770 --> 00:00:51,540
هذا سؤال صعب

6
00:00:51,540 --> 00:00:54,400
هل قلتُ ذلك حقّاً؟

7
00:00:54,710 --> 00:00:56,610
كفى عبثاً أيُّها العجوز

8
00:00:58,060 --> 00:01:01,410
يا لها من شمس حالكة السّواد لدينا هنا

9
00:01:01,410 --> 00:01:04,910
الآن أفترض بأنّني ينبغي أن
أحتفِظ بتذكاري

10
00:01:05,420 --> 00:01:08,420
،إذا استخففت بي واعتبرتني نسخة
!فسوف تندم على ذلك

11
00:02:47,870 --> 00:02:50,520
من أنتم؟

12
00:03:03,590 --> 00:03:09,660
رانمارو... سأحلّ مكانك وأنهي ما بدأتَه

13
00:03:11,670 --> 00:03:14,110
!ابتعدوا عن طريقي

14
00:03:14,700 --> 00:03:16,870
!أين أنت يا ميتسوهيدي؟

15
00:03:27,950 --> 00:03:33,060
،لعلّي لا أمتلك خبرة كبيرة في القتال

16
00:03:33,360 --> 00:03:38,190
لكن يبدو أنّني لا أستطيع الاستمرار في تسمية
!نفسي بالطّائر الحبيس والهرب

17
00:03:42,860 --> 00:03:45,910
في نهاية المطاف، هل أنا
مناسب أن أكون مجرّد زينة؟

18
00:03:48,650 --> 00:03:50,660
!ياغين! هاسيبي

19
00:03:51,080 --> 00:03:53,080
إلى متى ستكتئب؟

20
00:03:53,080 --> 00:03:55,670
زينة م لا، يبقى السّيف سيفاً، لذا قاتل

21
00:03:56,210 --> 00:03:59,670
يمكننا حمايتك من الخلف

22
00:04:02,140 --> 00:04:05,520
يمكننا تولّي زمام الأمر هنا

23
00:04:05,520 --> 00:04:06,930
سنمهّد طريقاً لك

24
00:04:07,250 --> 00:04:08,250
والآن اذهب

25
00:04:09,170 --> 00:04:09,930
!حسناً

26
00:04:19,630 --> 00:04:20,610
...ماذا

27
00:04:30,850 --> 00:04:32,140
ميتسوهيدي

28
00:04:35,530 --> 00:04:37,540
جروحك بليغة

29
00:04:43,090 --> 00:04:44,680
كيف تجرؤ؟

30
00:04:47,960 --> 00:04:52,180
!ما كان نوبوناغا ليموت لو لم تقم بهذا الهُراء

31
00:04:54,690 --> 00:04:58,690
!اللّعنة على قضيّتك! تبّاً لحادثة هونّوجي خاصّتك

32
00:04:59,000 --> 00:05:02,190
!سأمسحها من كتُب التّاريخ

33
00:05:12,160 --> 00:05:13,450
سوزا؟

34
00:05:25,260 --> 00:05:28,170
لِمَ تفعل المستحيل لإيقافي؟

35
00:05:28,950 --> 00:05:32,600
يجب ألّا تقتل ميتسوهيدي

36
00:05:33,210 --> 00:05:36,200
!يحاول قتل نوبوناغا

37
00:05:36,200 --> 00:05:38,730
!أنت سيف نوبوناغا أيضاً

38
00:05:39,070 --> 00:05:41,720
،فشلتُ في حمايته آنذاك

39
00:05:41,720 --> 00:05:45,110
!لكن الآن لديّ فُرص أخرى
!يمكنني إنقاذ حياته

40
00:05:45,110 --> 00:05:49,440
ألا تريد إنقاذه يا سوزا؟

41
00:05:49,440 --> 00:05:52,120
!هل نسيت كلَّ الحبّ الّذي منحك إيّاه؟

42
00:05:56,000 --> 00:05:59,000
!لهذا يجب علينا ألّا نقتل ميتسوهيدي

43
00:05:59,490 --> 00:06:06,420
هذا الحدث التّاريخيّ هو ما يجعل نوبوناغا
ورانمارو ما هما عليه

44
00:06:06,850 --> 00:06:11,310
إذا اخترتَ قتل ميتسوهيدي
،وحوّرتَ التّاريخ الآن

45
00:06:11,830 --> 00:06:16,380
فذلك يعني رفض الحياة الّتي
عاشها رانمارو ونوبوناغا

46
00:06:17,830 --> 00:06:19,190
!فودو يوكيميتسو

47
00:06:19,690 --> 00:06:20,870
!انتظر من فضلك

48
00:06:21,690 --> 00:06:23,650
فودو يوكيميتسو

49
00:06:23,650 --> 00:06:25,690
مثلما يعني نوبوناغا الكثير بالنّسبة لك

50
00:06:26,020 --> 00:06:28,700
،فهو يعنيني الكثير

51
00:06:29,040 --> 00:06:32,700
وهو يعني شيئاً بالنّسبة لميتسوهيدي أيضاً

52
00:06:33,180 --> 00:06:38,710
وذاك الشّيء... هو كيان يجب أن يقتله هنا

53
00:06:39,140 --> 00:06:46,710
حادثة هونّوجي هي الصّفحة الأخيرة
!من قصّة معلّمنا، أودا نوبوناغا

54
00:06:48,210 --> 00:06:51,180
أخبرني يا ياغين

55
00:06:52,260 --> 00:06:57,220
هل نوبوناغا في نظرك يجب أن يسقط
أمام ميتسوهيدي أيضاً؟

56
00:06:58,390 --> 00:07:00,230
أخبرني يا هاسيبي

57
00:07:00,590 --> 00:07:04,850
هل نوبوناغا في نظرك يجب
أن يموت في هونّوجي أيضاً؟

58
00:07:06,150 --> 00:07:09,830
لا تسألنا. اسأل نفسك

59
00:07:13,950 --> 00:07:16,620
!ما الأمر؟ اقتلني

60
00:07:33,220 --> 00:07:35,890
،فودو يوكيميتسو، علبة الشّاي تسوكوموغامي"

61
00:07:36,510 --> 00:07:39,850
"!ونيوا ناغاهيدي، كلّ الثّلاثة مُلكي

62
00:07:40,830 --> 00:07:44,350
،كنتَ سيفاً محبوباً بواسطة مولايّ

63
00:07:44,970 --> 00:07:47,370
والآن أنت تنتمي لي

64
00:07:47,370 --> 00:07:50,360
حقِّق هدفك وأنت بحوزتي

65
00:07:50,990 --> 00:07:57,410
،وإذا تركتَني يوماً وامتلكك شخصٌ غيري

66
00:07:58,870 --> 00:08:03,370
فافعل ما يجب عليك فعله
وحقِّق هدفَك الجديد

67
00:08:04,430 --> 00:08:10,910
أعلم بأنّك ستخدم سيّدَك جيّداً كائناً
...من كان، يا فودو يوكيميتسو

68
00:08:11,370 --> 00:08:13,010
يا كنزي

69
00:08:18,670 --> 00:08:21,170
أنا سيفٌ عديم الجدوى

70
00:08:22,730 --> 00:08:26,650
لم أتمكّن أبداً من ردّ الحبّ
،الّذي مُنِحتُ إيّاه

71
00:08:27,700 --> 00:08:29,090
!أنا سيفٌ عديم الجدوى

72
00:08:40,090 --> 00:08:41,080
...هل هذا

73
00:08:44,270 --> 00:08:45,790
مُحال أن أنساه

74
00:08:46,670 --> 00:08:47,590
...ملِك الشّياطين

75
00:08:49,460 --> 00:08:50,700
!نوبوناغا

76
00:09:10,160 --> 00:09:12,930
!نوبوناغا

77
00:09:31,740 --> 00:09:33,300
وها هم قادمون

78
00:09:33,300 --> 00:09:36,380
لا نقبل بالمُماطلة بعد الآن

79
00:09:36,380 --> 00:09:39,020
لا نستطيع ذلك أصلاً

80
00:09:39,020 --> 00:09:42,140
لم يستطيعوا تعديل التّاريخ
،ومنع انتحار نوبوناغا

81
00:09:42,140 --> 00:09:43,890
لذا هم يستهدفون ميتسوهيدي الآن

82
00:09:44,460 --> 00:09:46,390
انهض يا فودو يوكيميتسو

83
00:09:46,930 --> 00:09:51,400
أنت مُحاربٌ سيف، وسوف تقاتل
من أجل حماية التّاريخ

84
00:09:51,890 --> 00:09:52,870
أليس كذلك؟

85
00:09:53,990 --> 00:09:56,400
لستُ بحاجة لتخبرني بذلك

86
00:09:59,180 --> 00:10:00,070
ها أنا قادم

87
00:10:02,870 --> 00:10:05,410
لا تروقني النّظرة في عيونكم

88
00:10:05,850 --> 00:10:06,580
سوف أقتلكم

89
00:10:12,250 --> 00:10:13,030
...أنا

90
00:10:15,070 --> 00:10:16,660
!لستُ مُزيّفاً

91
00:10:19,100 --> 00:10:20,380
تريدون القتال؟

92
00:10:22,380 --> 00:10:23,100
!خذ هذه

93
00:10:24,810 --> 00:10:26,560
ما رأيكم بهذه؟

94
00:10:30,700 --> 00:10:32,230
والآن، النّهاية

95
00:10:32,960 --> 00:10:34,650
!ما لا يقتلني يقوّيني فحسب

96
00:10:36,780 --> 00:10:39,550
!سأقتل كلّ من يقف في وجه سيّدي

97
00:10:42,660 --> 00:10:45,030
!سيفي لن يُوقَف

98
00:10:48,110 --> 00:10:49,860
إمّا النّجاح أو الموت

99
00:10:49,860 --> 00:10:51,460
!سوف أشقُّ طريقي بالقوّة

100
00:11:00,170 --> 00:11:02,060
كلّه وصولاً إلى المقبض

101
00:11:10,210 --> 00:11:12,650
إلى متى سيسخر منّي هذا الوغد؟

102
00:11:13,820 --> 00:11:17,900
إذا سقطتُ، فسيلوّث ذلك اسم نوبوناغا

103
00:11:18,350 --> 00:11:20,150
،قد أكون سيفاً عديم الجدوى

104
00:11:21,620 --> 00:11:23,030
!لكن ليس عليكم قولها

105
00:11:25,960 --> 00:11:28,330
لا أحبّذ نظراتكم هذه

106
00:11:29,170 --> 00:11:32,780
هذا وسم ملِك الشّياطين، والّذي
يجعل الشّخص مجنوناً

107
00:11:35,640 --> 00:11:36,590
خذ

108
00:11:37,900 --> 00:11:40,840
هل ظننت حقّاً بأنّك تستطيع مسّي؟

109
00:11:44,610 --> 00:11:45,850
!مولاي؟

110
00:11:45,850 --> 00:11:47,850
!اللّعنة عليكم يا وحوش

111
00:12:06,070 --> 00:12:09,080
حالما ينتهي هذا، سأكون طائراً
حبيساً في قفص مرّة أخرى

112
00:12:16,330 --> 00:12:19,160
يبدو أنّ هذا آخرهم

113
00:12:19,160 --> 00:12:20,960
لم أعُد قادراً على القتال أيضاً

114
00:12:23,470 --> 00:12:25,470
إلى متى ستبقى جاثماً على ركبتيك؟

115
00:12:26,620 --> 00:12:30,470
،لماذا لم تقتلني؟ لو فعلت

116
00:12:30,850 --> 00:12:34,380
لبقي نوبوناغا على قيدِ الحياة

117
00:12:35,230 --> 00:12:37,480
لأنّك يجب أن تحكم الدّولة

118
00:12:37,820 --> 00:12:40,480
وتشهد على نجاح قضيّتك

119
00:12:42,070 --> 00:12:43,570
قضيّتي؟

120
00:12:43,950 --> 00:12:49,140
أتساءل كيف ستتحدّث أجيالُ المُستقبل
عن الأحداث في هونّوجي اليوم

121
00:12:50,660 --> 00:12:54,310
هل سيقولون، "هل أراد آكيتشي ميتسوهيدي
السّيطرة على الدّولة؟

122
00:12:54,310 --> 00:12:58,500
"أم ربّما لديه سبب ما يدفعه لكره نوبوناغا؟

123
00:12:59,550 --> 00:13:00,940
كلاهما خاطئ

124
00:13:00,940 --> 00:13:04,620
كلّ ما أردتُ منه هو أن يعتبرني قيّماً

125
00:13:05,230 --> 00:13:08,800
لكن لم أعُد أملك شابّاً بجانبي مثل رانمارو

126
00:13:09,620 --> 00:13:13,520
فكرة نبذه لي أخافتني خوفاً شديداً

127
00:13:14,070 --> 00:13:19,300
أردتُه أن يستمرّ في أن يكون
!مولايّ ومعلّمي

128
00:13:19,670 --> 00:13:20,520
...وماذا

129
00:13:21,530 --> 00:13:23,530
وماذا يعني؟

130
00:13:24,090 --> 00:13:27,100
أدّى نوبوناغا دوره في التّاريخ

131
00:13:27,100 --> 00:13:29,530
،لذا أنت يا آكيتشي ميتسوهيدي

132
00:13:30,350 --> 00:13:32,390
!اذهب وأدِّ دورك في التّاريخ أيضاً

133
00:13:33,210 --> 00:13:35,540
دوري في التّاريخ؟

134
00:13:38,250 --> 00:13:40,490
أكمله حتّى النّهاية

135
00:13:41,860 --> 00:13:45,580
هذا هو هدفك، ولا تنسَه

136
00:13:50,110 --> 00:13:52,130
معبد هونّوجي يسقط

137
00:13:52,130 --> 00:13:54,810
كما ورد في كتُب التّاريخ

138
00:13:58,420 --> 00:13:59,330
سوزا

139
00:14:00,780 --> 00:14:03,940
لماذا أبكي بالضّبط؟

140
00:14:06,720 --> 00:14:09,820
لا تقلق. هذا ليس بالأمر السيّئ

141
00:14:11,100 --> 00:14:12,410
...أودا نوبوناغا

142
00:14:12,970 --> 00:14:16,330
من كنتَ بالتّحديد؟

143
00:14:17,300 --> 00:14:19,850
،من كنتَ بالنّسبة لرانمارو وميتسوهيدي

144
00:14:20,260 --> 00:14:27,090
ومن كنتَ بالنّسبة لفودو وياغين وهاسيبي؟

145
00:14:28,210 --> 00:14:30,370
،حاملاً هذا الوسم مثلما أحمل

146
00:14:31,510 --> 00:14:37,030
ما زلتُ لا أراك شيئاً غير ملك الشّياطين

147
00:14:41,810 --> 00:14:44,230
سُجِّلَتْ حادثةُ هونّوجي في التّاريخ

148
00:14:44,980 --> 00:14:47,260
،قُتِلَ موري رانمارو بواسطة رجال آكيتشي

149
00:14:47,660 --> 00:14:51,750
وأودوا نوبوناغا أحرقَ معبدَ هونّوجي
قبل أن يُنهي حياته

150
00:14:52,540 --> 00:14:57,540
بحثَ ميتسوهيدي عن جثّته لكن لم يجدها

151
00:14:58,850 --> 00:15:01,860
،ربّما تحوّلَ كلّ جزء منه إلى رماد
أو ربّما هرب ونجا

152
00:15:02,570 --> 00:15:06,660
،يبقى هذا الجزء مُطوَّقاً بالغموض
لكن لم يكتشف أحدٌ ما حلَّ به

153
00:15:07,850 --> 00:15:11,850
،بعد إنهاء نوبوناغا في حادثة هونّوجي
،آكيتشي ميتسوهيدي

154
00:15:11,850 --> 00:15:13,570
...بعد أحد عشر يوماً فقط

155
00:15:14,260 --> 00:15:19,770
سقط أمام هاشيبا هيديوشي في معركة
يامازاكي وفقد حياته

156
00:15:20,510 --> 00:15:24,770
،لذا كلّ شيء سار وفق التّاريخ
في الورق على الأقلّ

157
00:15:26,150 --> 00:15:27,780
هذا كامل تقريري

158
00:15:29,780 --> 00:15:31,100
يا إلهي

159
00:15:31,510 --> 00:15:35,280
أنا سيفٌ وها أنا ذا أعتني بالخيول

160
00:15:35,660 --> 00:15:41,020
علينا فعل كلّ ما يمليه علينا مُعلّمنا
حتّى لو كان العناية بالخيول

161
00:15:43,170 --> 00:15:46,380
هل تريد بعض الأمازاكي أيضاً؟

162
00:15:46,380 --> 00:15:48,640
متى حصلت عليه؟

163
00:15:48,640 --> 00:15:51,420
عليّ الشّرب لأستمرّ في حياتي

164
00:15:51,420 --> 00:15:54,580
!كُفّ عن التّكاسل! هذا عملٌ مهمّ

165
00:15:54,580 --> 00:15:56,860
أنا لا أتكاسل، آخذ استراحة فحسب

166
00:15:56,470 --> 00:15:58,150
ما الأمر يا ياغين؟

167
00:15:56,860 --> 00:15:59,580
إنَّ الشّرب أثناء العمل غير مقبول

168
00:15:58,990 --> 00:16:03,250
أعتقد بعض النّاس مُتقاربين حقّاً
لدرجة أنّهم يتشاجرون

169
00:15:59,580 --> 00:16:01,190
سوف آخذ هذه

170
00:16:03,560 --> 00:16:05,500
ما معنى هذا؟

171
00:16:05,500 --> 00:16:06,560
لا أدري

172
00:16:09,110 --> 00:16:13,570
في البداية، لم أعلم سببَ إرسال مُعلّمنا
،سيوف أودا إلى هونّوجي

173
00:16:14,370 --> 00:16:15,970
لكن أظنّني أفهم الآن

174
00:16:16,380 --> 00:16:19,080
وماذا كان السّبب برأيك؟

175
00:16:19,450 --> 00:16:23,060
لأنّ هذا خلقَ قصصاً جديدة

176
00:16:23,060 --> 00:16:24,730
أتقول قصصاً؟

177
00:16:25,050 --> 00:16:27,590
قصصنا تجعلنا أقوى

178
00:16:27,940 --> 00:16:30,390
،صحيح أنّ القرار كان تعسُّفيّاً في نظري

179
00:16:31,150 --> 00:16:34,180
لكن هذا يُثبِت كم أنّ الوضع فظيع الآن

180
00:16:35,050 --> 00:16:39,980
المُعلّم لا يتحمّل الجلوس مكتوف اليدين
وينتظرنا نحن والحصن لنصبح أقوى

181
00:16:40,990 --> 00:16:44,600
بدأتَ تفهم الأمر يا يامانباغيري

182
00:16:45,090 --> 00:16:46,090
ماذا تعني؟

183
00:16:46,090 --> 00:16:51,330
الآن أعلم بأنّ الحصن سيكون في أيدي
أمينة حتّى بعد رحيلي

184
00:16:51,690 --> 00:16:55,070
رحيلك؟ عمّاذا تتكلّم؟

185
00:16:56,870 --> 00:16:58,980
مجرّد فرضيّة

186
00:16:58,980 --> 00:17:00,950
لا تكُن خرِفاً

187
00:17:01,370 --> 00:17:06,460
ميكازوكي مونيتشيكا، سنظلّ نحتاج
مساعدتك لمزيد من الوقت

188
00:17:06,460 --> 00:17:09,460
أنا سعيد لأنّك تحترمني هذا الاحترام

189
00:17:12,010 --> 00:17:13,840
أين اختفى الشّاي الخاصّ بي؟

190
00:17:13,840 --> 00:17:16,610
أين بالفعل؟

191
00:17:16,610 --> 00:17:19,010
كنتَ مكشوفاً! لم تتوقّعني، صحيح؟

192
00:17:19,490 --> 00:17:20,540
!تسورومارو

193
00:17:21,360 --> 00:17:23,980
نحتاج مفاجآت في الحياة كي
نبقى على أهبة الاستعداد

194
00:17:23,980 --> 00:17:28,020
،إذا سار كلّ شيء كما نتوقّع
فعقولنا سوف تضمر

195
00:17:28,790 --> 00:17:30,210
تأخّرتُ عليكم، أليس كذلك؟

196
00:17:30,210 --> 00:17:34,140
.أعددتُ طعاماً خفيفاً جديداً مع الشّاي
ما رأيكم بتجربته؟

197
00:17:35,030 --> 00:17:38,030
يبدو هذا لذيذاً

198
00:17:38,430 --> 00:17:40,590
يبدو أنّكم مستمتعون جميعاً

199
00:17:40,980 --> 00:17:43,460
!يبدو هذا شهيّاً

200
00:17:43,460 --> 00:17:45,080
وصفة جديدة؟

201
00:17:45,080 --> 00:17:47,790
من تحاول أن تنتقم منه بالضّبط
بهذا الطّعام الخفيف؟

202
00:17:47,790 --> 00:17:50,210
ليست نيّتي الانتقام

203
00:17:50,210 --> 00:17:53,300
حسناً، سوف نقيم حفلة شكر
في الحصن اليوم

204
00:17:53,300 --> 00:17:55,800
لا ضير من التّرويح عن النّفس
بين الحين والآخر

205
00:17:56,420 --> 00:17:58,440
سأذهب لإبلاغ البقيّة

206
00:17:58,440 --> 00:18:03,310
لا، لندع خادمنا يامانباغيري يجمع الجميع

207
00:18:03,640 --> 00:18:04,410
اذهب

208
00:18:04,410 --> 00:18:06,330
فكرة جيّدة

209
00:18:06,330 --> 00:18:08,210
أفضِّل تحضير وليمة

210
00:18:08,210 --> 00:18:09,810
اسمح لي بالمساعدة

211
00:18:09,810 --> 00:18:12,890
سأذهب لإحضار المكوّنات

212
00:18:14,640 --> 00:18:17,850
حسناً، حسناً، هذا جيّد

213
00:18:23,330 --> 00:18:24,180
مرحباً

214
00:18:24,650 --> 00:18:25,610
ياغين

215
00:18:26,640 --> 00:18:30,580
سمعتُ بأنّ مُعلّمنا اعتبرك أفضل
مُقاتل في معركتنا السّابقة

216
00:18:30,900 --> 00:18:32,220
أحسنت صنعاً

217
00:18:33,830 --> 00:18:34,690
ما الأمر؟

218
00:18:35,130 --> 00:18:37,540
هل حلمتَ بهونّوجي من جديد؟

219
00:18:38,390 --> 00:18:42,640
،لا. لكن حتّى لو توقّفتُ عن الحلم بذلك

220
00:18:42,640 --> 00:18:47,290
فهذا لا يعني أنّ القصّة لا تسكنني

221
00:18:48,190 --> 00:18:50,150
أجل، معك حقّ

222
00:18:53,590 --> 00:18:58,980
لو لم يحملني، لما انهزمَ ملِكُ
الشّياطين باعتقادي

223
00:19:00,290 --> 00:19:01,250
اسمع

224
00:19:02,350 --> 00:19:06,090
...لعلّ عينَي كانتا تُضلّلانني، لكن

225
00:19:06,630 --> 00:19:07,620
ما الأمر؟

226
00:19:08,300 --> 00:19:12,660
،عندما رأينا نوبوناغا-سان هناك في هونّوجي
بدا لي وكأنّه كان يبتسم

227
00:19:13,630 --> 00:19:17,630
سألعب دوري في التّاريخ، وأكون"
صادقاً مع نفسي

228
00:19:18,010 --> 00:19:21,170
لذا اسلكوا دربكم بفخر واعتزاز أيضاً

229
00:19:21,170 --> 00:19:25,100
كافحوا واذبلوا، لكن استمرّوا
"في المضيّ قُدماً

230
00:19:26,940 --> 00:19:29,640
شعرتُ بأنّ هذا ما كان يقوله لنا
بينما يدير ظهره لنا

231
00:19:32,340 --> 00:19:35,150
هذا تفسير ملائم بشكل فظيع

232
00:19:35,530 --> 00:19:40,650
باختصار، قد تكون هذه هي طبيعة الرّجل
الّتي أراها في أودا نوبوناغا

233
00:19:41,000 --> 00:19:45,130
حسناً، ما دام هذا يُرضيك، فليس لديّ ما أقوله

234
00:19:45,130 --> 00:19:47,160
أعتقد شيئاً من هذا القبيل

235
00:19:47,610 --> 00:19:52,180
سوزا سامونجي. هل تمكّنتَ من اكتشاف
ما كان أودا نوبوناغا بالنّسبة لك؟

236
00:19:52,610 --> 00:19:54,170
من يدري؟

237
00:19:55,580 --> 00:19:59,470
ما كنّا لنتكبّد كلّ هذه المُعاناة
لو كان يسير الفهم

238
00:20:33,350 --> 00:20:38,610
والآن، لنشرع في يوم آخر
تحت رعاية مُعلّمنا

239
00:21:01,400 --> 00:21:02,220
!بئساً

240
00:21:02,220 --> 00:21:03,610
!هذا فظيع

241
00:21:03,610 --> 00:21:05,140
...كوجيرو

242
00:21:17,300 --> 00:21:19,690
التويوتومي أم الهوجو؟

243
00:21:20,550 --> 00:21:24,130
...لا أصدِّق بأنّني عالق في الاختيار بينهما

244
00:21:25,170 --> 00:21:28,290
أشعر بأنّني مُثير للشّفقة يا درعي

245
00:21:28,770 --> 00:21:32,220
هل حلمنا بحكم الدّولة مصيره ألّا يتحقّق؟

246
00:21:35,110 --> 00:21:37,170
عام 2205

247
00:21:37,920 --> 00:21:41,720
المُنقِّحون التّاريخيّون والّذين يُخطِّطون
،لتعديل التّاريخ

248
00:21:41,720 --> 00:21:43,770
بدؤوا هجماتهم على الماضي

249
00:21:44,730 --> 00:21:47,410
من أجل إيقافهم، حكومة الزّمن

250
00:21:47,860 --> 00:21:50,830
أرسلَتْ سانيوا إلى فترات زمنيّة مختلفة

251
00:21:51,820 --> 00:21:55,410
السّانيوا هم حُكماء يستطيعون
إيقاظ أرواح خاملة

252
00:21:56,060 --> 00:21:59,420
ومنحهم قوّة للقتال

253
00:22:00,010 --> 00:22:04,420
الأرواح الّتي يوقظونها تتجلّى كمُحاربي سيوف

254
00:22:05,230 --> 00:22:05,990
،ولهذا

255
00:22:06,810 --> 00:22:07,990
سنتوجّه إلى المعركة