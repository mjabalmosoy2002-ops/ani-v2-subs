1
00:00:00,720 --> 00:00:06,010
فِيلا الكونت رودلبيرغ في العاصمة الملكيّة
".تُعرف باسم "القصر المسكون

2
00:00:06,010 --> 00:00:07,680
،ببوّابتهِ الصّدئة

3
00:00:07,680 --> 00:00:09,450
،أرضياتهِ المُتشقّقة

4
00:00:09,450 --> 00:00:11,630
،وأشجاره غير المشذبة

5
00:00:11,630 --> 00:00:15,800
.إنّه فعلًا قصرٌ متداعٍ يليق باسمه

6
00:00:15,800 --> 00:00:18,600
.أو هكذا كان قبل أسبوعين

7
00:00:18,960 --> 00:00:21,150
أهذا قصرُ لوسيانا؟

8
00:00:21,150 --> 00:00:22,650
ما الذي حدث؟

9
00:00:24,800 --> 00:00:27,250
.بياتريس، ميلياريا

10
00:00:27,520 --> 00:00:29,220
!لوسيانا؟

11
00:00:27,520 --> 00:00:29,220
!السيّدة لوسيانا؟

12
00:00:29,690 --> 00:00:32,710
.مرحبًا بكم في منزلي

13
00:00:32,710 --> 00:00:35,320
.تُسعدني جدًا زيارتكما اليوم

14
00:00:37,630 --> 00:00:40,600
.سنتوجّه إلى الشرفة يا ميلودي

15
00:00:40,990 --> 00:00:43,150
.أعدّي الشاي من فضلك

16
00:00:43,150 --> 00:00:45,070
.أمركِ يا سيّدتي

17
00:00:48,160 --> 00:00:51,020
.والآن تفضّلا لشرب بعض الشاي

18
00:00:53,030 --> 00:00:54,490
!...هذا

19
00:00:54,980 --> 00:00:57,360
.يا لها من رائحةٍ غنيّة وعطرة

20
00:00:57,360 --> 00:01:00,740
.عبير الزهور الربيعية يلفّني برفق

21
00:01:00,740 --> 00:01:03,220
.الطّعم لذيذ جدًا أيضًا

22
00:01:03,220 --> 00:01:06,040
يترك ملمسًا منعشًا أثناء
.مروره عبر الحلق

23
00:01:06,040 --> 00:01:09,710
النّكهة النّاعمة عميقة لكنّها
.خالية من أيّ مرارة حادّة

24
00:01:09,710 --> 00:01:13,600
لكن ألا بأس باستخدام أوراق
شاي فاخرة كهذه؟

25
00:01:14,450 --> 00:01:15,930
.اطمئنا

26
00:01:15,930 --> 00:01:18,910
.فهذا هو الشّاي الذي نُقدّمه دائمًا

27
00:01:18,910 --> 00:01:19,890
!ماذا؟

28
00:01:20,260 --> 00:01:24,100
حتّى أوراق الشاي الرخيصة تختلف
.نكهتُها حسب طريقة النقع

29
00:01:24,100 --> 00:01:25,920
أليس كذلك يا ميلودي؟

30
00:01:25,920 --> 00:01:27,460
.نعم يا سيّدتي

31
00:01:27,460 --> 00:01:30,360
بالمناسبة، حتّى خادمتك مختلفة، صحيح؟

32
00:01:30,600 --> 00:01:34,190
ما الذي حدث بالضبط يا سيّدة لوسيانا؟

33
00:01:34,190 --> 00:01:37,480
.تغيّر كلّ شيء بغضون أسبوعين فقط

34
00:01:37,480 --> 00:01:39,120
!أخبرينا

35
00:01:40,410 --> 00:01:42,350
.أخشى أنّ هذا سر

36
00:01:42,350 --> 00:01:44,010
!يا لكِ من لئيمة

37
00:01:44,010 --> 00:01:47,050
لكن ألا تظنّين أنّ الوقت حان
لتتوقفي عن التمثيل؟

38
00:01:47,050 --> 00:01:49,660
.هذا ليس من طبيعتكِ إطلاقًا

39
00:01:55,310 --> 00:01:58,200
أظهرتُ حقًا صورة الآنسة النبيلة، صحيح؟

40
00:01:58,200 --> 00:02:00,330
!اجتهدتُ كثيرًا لأجل ذلك

41
00:02:00,330 --> 00:02:01,820
!نعم، أظهرتِ ذلك

42
00:02:01,820 --> 00:02:04,650
.أنا أحبّ شخصيتك المعتادة يا لوسيانا

43
00:02:04,650 --> 00:02:07,300
!حقًا؟ شكرًا

44
00:02:09,810 --> 00:02:11,240
.حسنًا، إلى اللّقاء في المرّة المقبلة

45
00:02:11,240 --> 00:02:12,180
!أتمنّى لكِ مساءً طيّبًا

46
00:02:22,080 --> 00:02:24,570
!شكرًا يا ميلودي

47
00:02:25,530 --> 00:02:28,760
!لا يجوز أن تُعانقي الخادمة يا سيّدتي

48
00:02:28,760 --> 00:02:30,680
!لكنّني سعيدة جدًا

49
00:02:30,680 --> 00:02:33,500
!نجحت حفلة الشاي بفضلكِ

50
00:02:33,500 --> 00:02:36,370
!فهمت لكن ابتعدي قليلًا رجاءً

51
00:02:36,800 --> 00:02:39,600
!هيّا، تعلمين أنّكِ تريدين هذا

52
00:02:39,600 --> 00:02:42,590
!من أين تعلّمتِ هذه الكلمات؟

53
00:02:43,630 --> 00:02:47,100
يبدو أنّنا سنضطر لبدء
.تدريبك على الآداب من جديد

54
00:02:47,100 --> 00:02:48,410
!أنا آسفة

55
00:02:48,410 --> 00:02:50,520
!كلّ شيء إلّا ذلك

56
00:02:51,900 --> 00:02:56,260
بالمناسبة، لِم اخترتِ العمل هنا يا ميلودي؟

57
00:02:56,260 --> 00:02:59,050
،لأنَّ هذا القصر يُوظّف خادمة واحدة فقط

58
00:02:59,050 --> 00:03:01,830
.لذا تُوكَل إليّ كلّ الواجبات

59
00:03:01,830 --> 00:03:03,490
كلّها؟

60
00:03:03,490 --> 00:03:06,330
،للخادمات واجبات متنوعة

61
00:03:06,330 --> 00:03:09,030
لذا في أماكن مثل القصر
.الملكي، تُقسّم الأعمال بينهن

62
00:03:09,030 --> 00:03:13,240
.لكن هنا، كلّ عمل من نصيبي

63
00:03:13,240 --> 00:03:15,360
!لا تُصادفين عملًا رائعًا كهذا كثيرًا

64
00:03:15,360 --> 00:03:16,920
أهُو رائع حقًا؟

65
00:03:16,920 --> 00:03:21,500
بالطبع! فيسعني تأدية كلّ أعمالِ
الخادمة التي أحبّها كثيرًا

66
00:03:21,500 --> 00:03:25,130
كخادمة، لم يكن أمامي سوى
"أن أصبح "خادمة لكلّ الأعمال

67
00:03:25,130 --> 00:03:27,970
!حيثُ تُوكّل إليّ كلّ المهام

68
00:03:28,380 --> 00:03:33,380
صحيح... سأصبح بكل تأكيد
.أروع خادمة في العالم

69
00:03:33,380 --> 00:03:35,390
!شاهديني يا أمّي

70
00:05:08,150 --> 00:05:11,490
من تلك السيدة الجميلة يا أمّي؟

71
00:05:11,490 --> 00:05:13,260
سيّدة جميلة؟

72
00:05:13,260 --> 00:05:16,220
.إنّها خادمة

73
00:05:17,620 --> 00:05:21,090
سيليستي ماكماردن، التي كانت تُدعى
،أيضًا بميلودي في طفولتها

74
00:05:21,090 --> 00:05:22,860
...اتخذت قرارًا ذلك اليوم

75
00:05:23,550 --> 00:05:25,180
.أنّها ستصبح خادمة

76
00:05:28,040 --> 00:05:30,890
.كنتِ متبهجة جدًا مؤخرًا يا سيليستي

77
00:05:30,890 --> 00:05:33,180
هل وقع أمرٌ سار؟

78
00:05:33,180 --> 00:05:35,800
!نعم! لكنّه سر

79
00:05:35,800 --> 00:05:37,900
!سأخبركِ عندما يحينُ الوقت

80
00:05:38,100 --> 00:05:39,580
.عجبًا

81
00:05:40,140 --> 00:05:43,320
في هذا العالم، يُعتبَر المرء
.بالغًا في سنّ الخامسة عشرة

82
00:05:43,550 --> 00:05:47,120
قرّرت سيليستي أن تتدرّب سرًا
،لتُصبح خادمة حتّى يحين ذلك اليوم

83
00:05:47,120 --> 00:05:49,550
.لتفاجئ أمّها

84
00:05:50,810 --> 00:05:53,470
.أضيئي بدفء... لوتش

85
00:05:57,120 --> 00:05:57,870
...لكن

86
00:06:00,400 --> 00:06:03,470
!أمّي! أمّي

87
00:06:06,120 --> 00:06:08,010
.عزيزتي سيليستي

88
00:06:08,480 --> 00:06:12,350
.أرجو أن تُسامحيني لأنّني سأترككِ

89
00:06:12,770 --> 00:06:14,960
.أردتُ أن أبقى معكِ أطول

90
00:06:14,960 --> 00:06:18,390
أردتُ أن أحتفل بكِ حين
.تصيرين بالغة وخادمة

91
00:06:19,300 --> 00:06:20,720
هل تفاجأتِ؟

92
00:06:20,720 --> 00:06:23,910
.اكتشفت أمّكِ سرّك يا سيليستي

93
00:06:24,840 --> 00:06:29,080
في الواقع، كنتُ أعمل خادمة
.أيضًا في الماضي

94
00:06:29,080 --> 00:06:34,410
أبوكِ، كلاود ليغينبارث كان
.وريثًا للكونت آنذاك

95
00:06:34,410 --> 00:06:36,880
.لا بدّ أنّه ورث اللّقب الآن

96
00:06:37,480 --> 00:06:41,580
.أمامكِ خياران يا سيليستي

97
00:06:41,580 --> 00:06:45,670
الأوّل أن تعودي إلى أبيكِ
.وتُصبحي ابنة الكونت

98
00:06:46,080 --> 00:06:49,340
.والآخر، أن تصبِحي خادمة طبعًا

99
00:06:49,900 --> 00:06:52,810
.سأحترمُ قراركِ

100
00:06:52,810 --> 00:06:54,280
.لكن، لنرَ

101
00:06:54,280 --> 00:06:56,000
،إن انتهى بكِ الأمر لتُصبحي خادمة

102
00:06:56,320 --> 00:06:59,220
.فأرجو أن تصبحي أروع خادمة في العالم

103
00:06:59,950 --> 00:07:02,670
.أحبّك يا سيليستي

104
00:07:04,140 --> 00:07:05,470
.أمّي

105
00:07:05,980 --> 00:07:08,580
!سأصبح خادمة

106
00:07:08,580 --> 00:07:11,460
،من أجلي ومن أجلكِ يا أمّي

107
00:07:12,340 --> 00:07:15,400
!سأصبح أروع خادمة في العالم

108
00:07:15,740 --> 00:07:20,250
.لأجل النفس والآخرين... النذر العظيم

109
00:07:20,660 --> 00:07:23,210
...ماذا؟ هل حدث شيء للتو

110
00:07:23,210 --> 00:07:25,300
.كلّ شيء في مكانه

111
00:07:25,300 --> 00:07:28,930
.أنعِم بالبركة الفضية على العذراء المقدّسة

112
00:07:33,590 --> 00:07:35,460
ما الذي أفعلهُ بحق؟

113
00:07:35,460 --> 00:07:38,670
حتّى أنا أعلم أنّني
.بلا موهبة في السحر

114
00:07:38,670 --> 00:07:40,930
حاولتُ مرارًا وتكرارًا
.منذ كنتُ طفلة

115
00:07:42,830 --> 00:07:44,800
...أضيئي بدفء

116
00:07:44,800 --> 00:07:46,120
.لوتش

117
00:07:52,540 --> 00:07:54,650
أ-أهذه... مانا؟

118
00:07:55,200 --> 00:07:57,270
كيف أمتلكُ مانا؟

119
00:07:57,270 --> 00:08:00,700
و-ولِم تبدو أقوى من مانا أمّي؟

120
00:08:01,110 --> 00:08:04,520
ألن يكون الأمر سيئًا
إن خرجت عن السّيطرة؟

121
00:08:04,840 --> 00:08:06,370
...هذه المانا

122
00:08:06,690 --> 00:08:08,630
!إنّها خطيرة لذا من الأفضل أن أخفيها

123
00:08:09,290 --> 00:08:11,460
لم تعلم سيليستي

124
00:08:11,460 --> 00:08:16,910
أنّ ماناها أقوى حتّى من مانا
.أعظم عشرة سحرة في المملكة

125
00:08:17,600 --> 00:08:18,510
!فكرة

126
00:08:18,880 --> 00:08:23,080
...إن دمجتُ سحر النّار بسحر الرياح

127
00:08:25,150 --> 00:08:26,430
!مذهل

128
00:08:26,430 --> 00:08:30,030
...مذهل. بهذا القدر من القوّة، أستطيع أن

129
00:08:30,030 --> 00:08:32,460
القُوّة التي اكتسبتها

130
00:08:32,460 --> 00:08:37,160
.كانت قوّة تخوّلها حُكم العالم إن شاءت

131
00:08:37,160 --> 00:08:40,300
...حسب الظّروف، قد تُقدِم على

132
00:08:41,200 --> 00:08:42,870
،بهذا السحر

133
00:08:42,870 --> 00:08:45,800
أستطيع تحقيق حُلمي بأن
!أصبح أروع خادمة في العالم

134
00:08:45,800 --> 00:08:49,880
.وهكذا، بدأت سيليستي تطوير سحر الخادمة

135
00:08:51,660 --> 00:08:53,800
...اصبغ هيئتي بسوادٍ عميق

136
00:08:53,800 --> 00:08:55,010
!أنيرير

137
00:09:00,400 --> 00:09:03,870
.جيّد. غيّرتُ لون شعري وعينيّ

138
00:09:04,330 --> 00:09:06,530
إن كان أبي هذا الذي
،ذُكِر في رسالة أمّي

139
00:09:06,530 --> 00:09:10,560
كلاود ليغينبارث، قادمًا ليأخذني كابنته

140
00:09:10,560 --> 00:09:13,000
.فلن أستطيع أن أصبح خادمة

141
00:09:13,440 --> 00:09:16,900
رغم أنّني لا أتصوّر أنّه
...يبحث عن أمّي الآن

142
00:09:17,650 --> 00:09:23,140
وما سببُ قدومِ فارسٍ من آل ليغينبارث
إلى بلدةٍ صغيرة كهذه؟

143
00:09:24,280 --> 00:09:26,460
.أنا أبحث عن شخص

144
00:09:26,830 --> 00:09:27,920
سيلينا؟

145
00:09:28,200 --> 00:09:29,620
هل تعرفها؟

146
00:09:29,620 --> 00:09:31,880
...نـ-نعم... ولكن

147
00:09:32,160 --> 00:09:34,110
.لقد توفيت

148
00:09:34,110 --> 00:09:36,590
...مضى على ذلك قرابة نصف سنة الآن

149
00:09:36,590 --> 00:09:38,680
لديها ابنة لكنّها رحلت قبل يومين

150
00:09:38,680 --> 00:09:41,270
،إلى البلاد المجاورة
قائلة أنّها تريد شفاء

151
00:09:41,270 --> 00:09:43,060
.حزنِها على فقدان والدتها

152
00:09:43,370 --> 00:09:44,440
ابنة؟

153
00:09:44,440 --> 00:09:46,770
أكان السيّدة سيلينا مُتزوّجة؟

154
00:09:46,770 --> 00:09:47,550
.لا

155
00:09:48,730 --> 00:09:50,510
كم عمر الفتاة؟ وكيف هي ملامحها؟

156
00:09:50,510 --> 00:09:53,260
.ستبلغ الخامسة عشرة هذه السنة

157
00:09:53,260 --> 00:09:58,740
فتاة جميلة بشعر فضي نادر
.وعينين لازورديتين مثل والدتها

158
00:09:58,740 --> 00:10:00,590
!شعر فضي

159
00:10:04,830 --> 00:10:07,110
إن غادرت قبل يومين
،إلى البلاد المجاورة

160
00:10:07,110 --> 00:10:09,570
فلا بدّ أنّها وصلت إلى
.ترينديفاليز هنا الآن

161
00:10:09,820 --> 00:10:11,510
فتاة فضيّة الشعر؟

162
00:10:11,510 --> 00:10:12,840
...لا أعرف شيئًا عنها

163
00:10:12,840 --> 00:10:16,540
أظنّني كنتُ لأتذكّر رؤية
.فتاة بشعر مميّز كهذا

164
00:10:18,510 --> 00:10:21,110
...شعر فضي تمامًا مثل حضرته

165
00:10:21,110 --> 00:10:23,450
...لا شك في الأمر إذًا ولكن

166
00:10:30,310 --> 00:10:31,990
ما الأمر؟ هل أنت تائهة؟

167
00:10:31,990 --> 00:10:33,190
...يا آنسة

168
00:10:35,410 --> 00:10:40,290
عـ-عفوًا، لم أستطع إيجاد أين
أستقل العربة إلى العاصمة الملكية

169
00:10:40,290 --> 00:10:41,110
.حـ-حسنًا

170
00:10:41,110 --> 00:10:42,810
.تجدينها هناك

171
00:10:42,810 --> 00:10:44,060
!أنت مُحق

172
00:10:44,370 --> 00:10:47,340
!شكرًا جزيلًا! ساعدتني حقًا

173
00:10:51,160 --> 00:10:53,560
!نسيت! الفتاة فضية الشعر

174
00:10:57,150 --> 00:11:01,640
إذًا من ابتكر خدمة العربات
هذه قبل سبع سنوات

175
00:11:01,640 --> 00:11:03,620
كان وليّ العهد؟

176
00:11:03,620 --> 00:11:06,530
،بدأ المشروعُ الفعلي قبل سبع سنوات

177
00:11:06,530 --> 00:11:09,230
.لكن يبدو أنّه اقترحه قبل سنة من ذلك

178
00:11:09,230 --> 00:11:14,610
أعتقد أنَّ وليّ العهد بعمرٍ مماثل لي
!أي أنّه كان في السادسة وقتها

179
00:11:14,610 --> 00:11:17,200
يوجد أشخاص مذهلون في
هذا العالم حقًا، صحيح؟

180
00:11:18,900 --> 00:11:20,010
.صحيح

181
00:11:20,420 --> 00:11:24,070
!شكرًا لإخباري بقصّة مُمتعة يا سيّد ماكس

182
00:11:24,580 --> 00:11:27,000
...أنا أستمتع أيضًا. عفوًا

183
00:11:27,340 --> 00:11:30,210
.اسمي ميلودي. ميلودي ويف

184
00:11:30,470 --> 00:11:32,010
.غيّرتُ مظهري

185
00:11:32,010 --> 00:11:36,070
ولم أخبر أهل البلدة
.بوجهتي الحقيقية أو السّبب

186
00:11:36,070 --> 00:11:39,160
لكن كان عليّ أن أغيّر اسمي
!أيضًا لأحافظ على السّر

187
00:11:39,160 --> 00:11:42,540
.بالمناسبة، سائق هذه العربة مذهل

188
00:11:42,540 --> 00:11:43,630
من أيّ ناحية؟

189
00:11:43,880 --> 00:11:45,660
لم تهتزّ العربة إطلاقًا

190
00:11:45,660 --> 00:11:48,870
رغم أنّ الطّرق في هذه
...المنطقة لم تُصان جيدًا قط

191
00:11:49,090 --> 00:11:52,050
.عليّ أن أعيد إلقاء التعويذة قريبًا

192
00:11:53,970 --> 00:11:57,190
!لا تهتز، لا ترتج... أوريزونتالي

193
00:12:04,570 --> 00:12:07,930
إن أردتِ أن تُصبحي خادمة
فالأفضل أن تذهبي إلى نقابة التجارة

194
00:12:07,930 --> 00:12:09,680
فهُم يتوسّطون للخدم من الطبقة الوسطى

195
00:12:09,680 --> 00:12:12,390
.ولا يشترطون رسالة توصية

196
00:12:12,390 --> 00:12:14,830
!شكرًا جزيلًا يا سيّد ماكس

197
00:12:14,830 --> 00:12:16,610
!حسنًا، إلى اللّقاء

198
00:12:18,960 --> 00:12:21,510
.ليتنا استطعنا أن نوظّفك نحن

199
00:12:21,830 --> 00:12:24,600
.لكنّني أعتقد أنّ والدي لن يسمح بذلك

200
00:12:28,650 --> 00:12:32,430
لا يوجد سوى وظائف
...قصيرة الأمد للرجال

201
00:12:32,430 --> 00:12:34,930
لحظة، أهذه وظيفة للنساء؟

202
00:12:34,930 --> 00:12:36,900
...لكن هذا

203
00:12:36,900 --> 00:12:39,290
بيت الكونت رودلبيرغ؟

204
00:12:39,290 --> 00:12:41,350
يبحثون عن خادمة لعائلة نبيلة؟

205
00:12:41,350 --> 00:12:45,110
ألا يحتاج خدم العائلات النبيلة
رسالة توصية عادة؟

206
00:12:45,390 --> 00:12:47,720
.لنرَ، يبحثون عن مُوظّفة واحدة

207
00:12:47,720 --> 00:12:49,330
...واجبات الوظيفة هي

208
00:12:49,570 --> 00:12:51,410
!كلّ الأعمال؟

209
00:12:51,410 --> 00:12:53,830
...كلّ الأعمال" يُقصَد بها"

210
00:12:53,830 --> 00:12:56,530
وظيفة تشمل كلّ شيء
من الطّبخ والغسيل

211
00:12:56,530 --> 00:12:58,620
.إلى التنظيف، خدمة الضيوف وأكثر

212
00:12:58,620 --> 00:13:02,510
إنّها أصعب وظيفة
.وأقلّها مكانة بين الخادمات

213
00:13:02,760 --> 00:13:06,100
عادة ما يستعين بها أساسًا نبلاء
الطبقة الدنيا أو عامّة الطبقة الوسطى

214
00:13:06,100 --> 00:13:08,470
الذين لا يستطيعون تحمّل
.تكلفة عدد كبير من الخدم

215
00:13:09,170 --> 00:13:12,430
رؤية بيت كونت يبحث عن
توظيف واحدة

216
00:13:12,430 --> 00:13:14,920
.لا يدلّ إلّا على مصيبة قادمة

217
00:13:14,920 --> 00:13:15,880
...لكن

218
00:13:16,670 --> 00:13:18,770
!...هذه... هذه هي

219
00:13:19,140 --> 00:13:22,450
!هذه هي الوظيفة التي كنتُ أريدها بالضبط

220
00:13:25,460 --> 00:13:27,410
قصر مسكون؟

221
00:13:27,640 --> 00:13:30,340
!الآن هذا تحدٍ يستحق أن أخوضه

222
00:13:30,340 --> 00:13:32,620
!لا بدّ أن أكسب الوظيفة هنا

223
00:13:33,050 --> 00:13:35,240
...لنرَ، مدخل الخدم

224
00:13:35,710 --> 00:13:36,700
عجبًا؟

225
00:13:38,440 --> 00:13:40,530
من أنت؟

226
00:13:40,530 --> 00:13:45,210
...يا لها من فتاة جميلة ولكن

227
00:13:45,440 --> 00:13:46,990
!يا للخسارة

228
00:13:46,990 --> 00:13:49,960
بشرتُها وشعرها في حالة
!يرثى لها وفستانها بالٍ أيضًا

229
00:13:49,960 --> 00:13:51,170
.ليس وقت هذا الآن

230
00:13:51,710 --> 00:13:54,760
حضرتُ ردًا على إعلانكم في نقابة
.التجارة بخصوص توظيف خادمة

231
00:13:54,760 --> 00:13:56,660
.أنا ميلودي ويف

232
00:13:56,660 --> 00:13:58,720
!ماذا؟ أتيتِ بالفعل؟

233
00:13:58,720 --> 00:13:59,640
!شكرًا

234
00:14:00,540 --> 00:14:02,990
!لنتحدث في قاعة الطعام حالًا

235
00:14:02,990 --> 00:14:04,700
!لحظة من فضلك

236
00:14:04,700 --> 00:14:07,470
لا يجوزُ لخادمة أن
!تدخل من الباب الرئيسي

237
00:14:07,470 --> 00:14:08,900
...سأستخدمُ الخلفي

238
00:14:08,390 --> 00:14:10,080
.لا تكترثي لذلك

239
00:14:10,080 --> 00:14:13,400
.أنا أقول أنّه لا بأس لذا لا مشكلة

240
00:14:13,400 --> 00:14:15,240
عفوًا؟ ماذا تقصدين؟

241
00:14:15,700 --> 00:14:18,860
.اسمي لوسيانا رودلبيرغ

242
00:14:18,860 --> 00:14:21,460
.رغم المظهر، فأنا ابنةُ كونت أصيلة

243
00:14:21,460 --> 00:14:23,160
!ماذا؟

244
00:14:26,390 --> 00:14:28,900
.اجلسي. سأعدّ بعض الشاي الآن

245
00:14:28,900 --> 00:14:32,390
لا. محال أن أدع سيّدتي
...تُعدّ شايًا من أجلي

246
00:14:32,390 --> 00:14:33,560
.لا بأس

247
00:14:33,990 --> 00:14:36,560
اعتدتُ على إعداد الشاي لنفسي
.عندما كنتُ لا أزالُ في إقامتي

248
00:14:36,560 --> 00:14:38,270
!انتظري لحظة

249
00:14:38,270 --> 00:14:39,900
!أرجوك، دعيني أتولّى الأمر

250
00:14:39,900 --> 00:14:41,340
...لكنّني قد

251
00:14:41,750 --> 00:14:45,200
!سأعدّ لكِ شايًا لذيذًا للغاية

252
00:14:45,200 --> 00:14:46,550
حقًا؟

253
00:14:46,550 --> 00:14:48,390
إذًا ألا بأس أن أطلب منك هذا؟

254
00:14:48,680 --> 00:14:50,320
!اتركي الأمر لي من فضلك

255
00:14:53,450 --> 00:14:55,750
متى جُلب هذا الماء آخر مرّة؟

256
00:14:55,750 --> 00:14:59,070
جلبتُ هذا الماء من البئر
.أمس. ما زال صالحًا

257
00:14:59,070 --> 00:15:03,320
.للأسف، ليس مناسبًا لنقع الشاي

258
00:15:03,700 --> 00:15:06,550
...هلمّ أيّها الماء البلوري

259
00:15:07,100 --> 00:15:08,610
.فاري أكوا

260
00:15:10,010 --> 00:15:12,970
!مذهل! يمكنكِ استخدام السّحر؟

261
00:15:12,970 --> 00:15:16,300
.سأعدّه حالًا لذا انتظري من فضلك

262
00:15:18,880 --> 00:15:20,820
.حسنًا، اكتمل

263
00:15:27,710 --> 00:15:28,950
!إنّه لذيذ

264
00:15:29,300 --> 00:15:31,530
!الرّائحة والطّعم مُختلفان كليًا

265
00:15:31,530 --> 00:15:34,350
لم أتصوّر أنّ طريفة تحضير واحدة
!قد تصنعُ هذا الفرق

266
00:15:35,280 --> 00:15:37,410
اسمك ميلودي، صحيح؟

267
00:15:37,410 --> 00:15:40,480
ألا بأس أن أفترض أنّكِ ستعملين لديّ؟

268
00:15:40,480 --> 00:15:41,260
!نعم يا سيّدتي

269
00:15:41,260 --> 00:15:42,670
!أنا سعيدة جدًا

270
00:15:42,670 --> 00:15:44,210
!أترقب ذلك

271
00:15:44,530 --> 00:15:48,500
حسنًا إذًا، أودّ أن أستشير
...مدبّرة المنزل حالًا

272
00:15:49,980 --> 00:15:51,980
ماذا؟ ألا تعلمين؟

273
00:15:51,980 --> 00:15:53,210
ما قصدكِ يا سيّدتي؟

274
00:15:53,980 --> 00:15:55,910
...في الحقيقة يا ميلودي

275
00:15:55,910 --> 00:15:57,560
.لا أحد سواكِ

276
00:15:58,370 --> 00:15:59,800
...هذا

277
00:16:00,120 --> 00:16:02,230
.لا أحد سواكِ

278
00:16:02,230 --> 00:16:05,520
أنتِ الخادمة الوحيدة... بل بالأحرى
.أنتِ الوحيدة التي تعملُ لديّ

279
00:16:05,520 --> 00:16:07,980
أنا... فقط؟

280
00:16:07,980 --> 00:16:10,870
.ربّما سترفض الوظيفة بهذه اللّحظة

281
00:16:13,820 --> 00:16:16,790
أكاديمية بالتيشيا الملكيّة للتعليم العالي

282
00:16:16,790 --> 00:16:19,740
.تقعُ في عاصمة مملكة ثيولاس

283
00:16:19,740 --> 00:16:24,070
يُلزم أبناء النبلاء في المملكة
بالالتحاق بهذه الأكاديمية

284
00:16:24,070 --> 00:16:26,660
.لمدّة 3 سنوات فور بلوغهم الخامسة عشرة

285
00:16:27,340 --> 00:16:30,390
،قُبِلت لوسيانا رودلبيرغ أيضًا للالتحاق بها

286
00:16:30,390 --> 00:16:33,840
وكانت تُخطّط للانتقال إلى العاصمة
.الملكيّة مع والديها

287
00:16:33,840 --> 00:16:38,850
لكن بسبب ظروفٍ خارجة عن إرادتها
.انتهى الأمر بلوسيانا أن تذهب بمفردها

288
00:16:38,850 --> 00:16:40,060
...وهكذا

289
00:16:42,520 --> 00:16:43,800
ما هذا؟

290
00:16:44,500 --> 00:16:47,010
لم يكن هناك سوى خادمة
.مُسنّة واحدة كخادمة

291
00:16:47,530 --> 00:16:49,010
...وحتّى هي

292
00:16:51,430 --> 00:16:57,360
سـ-سأكون بخير. كنتُ أعتني بنفسي
!حتّى عندما كنتُ في إقامتنا

293
00:17:08,980 --> 00:17:13,510
.أنا بخير. أنا بخير. أستطيع المواصلة

294
00:17:17,910 --> 00:17:20,050
...عليّ أن أشتري بعض المستلزمات

295
00:17:25,350 --> 00:17:27,190
عفوًا يا سيّدتي؟

296
00:17:27,480 --> 00:17:30,250
سأدير كلّ المهام، صحيح؟

297
00:17:30,250 --> 00:17:31,940
بما أنّه عمل شامل؟

298
00:17:31,940 --> 00:17:33,410
!لا يمكنكِ فعل كلّ شيء بنفسكِ

299
00:17:33,410 --> 00:17:35,270
.افعلي ما تقدرين عليه وذلك يكفي

300
00:17:35,270 --> 00:17:38,190
.سأحاول أن أساعد أيضًا

301
00:17:38,190 --> 00:17:40,740
...لذا... لذا

302
00:17:41,000 --> 00:17:44,180
!عجبًا! شكرًا جزيلًا يا سيّدتي

303
00:17:44,180 --> 00:17:46,210
!سأبذل قصارى جهدي بدءًا من اليوم

304
00:17:50,690 --> 00:17:52,290
أ-أنت موافقة على هذا حقًا؟

305
00:17:52,290 --> 00:17:54,980
تدركين أنّك ستديرين
البيت كلّه بمفردكِ، صحيح؟

306
00:17:54,980 --> 00:17:56,350
!بالطبع

307
00:17:56,350 --> 00:18:00,350
أنا مسرورة جدًا فقط
!لأنّني سأُكلَّف بكلّ الأعمال

308
00:18:00,350 --> 00:18:03,180
لِم هي سعيدة جدًا بهذا؟

309
00:18:03,180 --> 00:18:06,130
ما أوفر حظّي

310
00:18:08,060 --> 00:18:11,100
...حسنًا إذًا، سأبدأ فورًا

311
00:18:11,100 --> 00:18:12,680
!بعد أن أصنع زيّي

312
00:18:13,020 --> 00:18:15,040
زيّ؟ الآن؟

313
00:18:15,040 --> 00:18:16,650
.سيكون جاهزًا في لحظة

314
00:18:16,980 --> 00:18:20,650
.ألبسني ثوبًا جميلًا يا نور... ريكوتشيتورا

315
00:18:28,790 --> 00:18:29,750
!مذهل

316
00:18:30,100 --> 00:18:32,870
!لا أستطيع رؤية أيّ تفاصيل أنثوية

317
00:18:32,870 --> 00:18:34,220
.لا داعي للتعليق على ذلك

318
00:18:34,220 --> 00:18:37,550
سأصبح خادمة حقيقية، صحيح؟

319
00:18:37,950 --> 00:18:39,880
.الحلم الذي لطالما راودني

320
00:18:39,880 --> 00:18:42,600
ما كنتُ أطمحُ إليه منذ
...قبل أن أولد من جديد

321
00:18:42,600 --> 00:18:44,190
!خادمة حقيقية

322
00:18:44,620 --> 00:18:47,890
هل سمعتُم ما قالته ميلودي للتو؟

323
00:18:47,890 --> 00:18:50,390
"منذ قبل أن أولد من جديد"

324
00:18:50,800 --> 00:18:54,230
...صحيح. إنّ ميلودي ويف

325
00:18:54,230 --> 00:18:57,930
فتاة أعيد تجسيدها في هذا العالم
.بسبب حادثة معيّنة

326
00:18:57,930 --> 00:19:00,150
...اسمها السابق قبل ذلك كان

327
00:19:00,150 --> 00:19:01,740
.ريتسوكو ميزونامي

328
00:19:02,140 --> 00:19:04,440
،كانت ترى كلّ شيء بلون واحد

329
00:19:04,440 --> 00:19:06,710
.وظنّت أنّ ذلك هو طبيعة العالم الحقيقية

330
00:19:07,160 --> 00:19:09,250
،عبقرية بالفطرة

331
00:19:09,250 --> 00:19:13,560
أصبحت خبيرة في عدّة
.مجالات بحلول سنّ السادسة

332
00:19:13,560 --> 00:19:17,420
.ونتيجة لذلك، فقدت الاهتمام بالعالم كلّه

333
00:19:17,790 --> 00:19:18,920
...مع ذلك

334
00:19:19,360 --> 00:19:23,470
.أهلًا وسهلًا. شكرًا لحضوركم

335
00:19:25,420 --> 00:19:28,680
من تلك السيّدة الجميلة يا أمّي؟

336
00:19:28,680 --> 00:19:31,900
.سيّدة جميلة؟ إنّها خادمة

337
00:19:32,330 --> 00:19:35,350
معرفة ريتسوكو تميل كثيرًا
.إلى الجانب الأكاديمي في النهاية

338
00:19:35,960 --> 00:19:39,730
يبدو أنّ المنظّمين بذلوا جهدًا
.لإحضارها من بريطانيا

339
00:19:39,730 --> 00:19:42,070
إنّها خادمة صالون مسؤولة
.عن خدمة الزبائن

340
00:19:49,070 --> 00:19:51,400
.إنّها جميلة جدًا

341
00:19:52,370 --> 00:19:55,770
.خادمة... امرأة تعمل في الخدمة المنزلية

342
00:19:55,770 --> 00:19:59,840
ازدهر مفهوم الخادمة خصوصًا
.في النصف الأخير من القرن

343
00:20:01,290 --> 00:20:03,710
.مرحبًا بعودتك يا سيّدي

344
00:20:03,710 --> 00:20:06,010
!يا لها من خادمة جميلة

345
00:20:06,410 --> 00:20:09,280
يسعدني أنّ ريتسوكو تبدو
.مستمتعة مؤخرًا

346
00:20:09,280 --> 00:20:14,100
بالفعل. بدت وكأنّها تشعر بالملل
.من كلّ ما تفعله سابقًا

347
00:20:14,410 --> 00:20:18,070
.بدأت الألوان التي تلاشت من عالمها بالعودة

348
00:20:18,690 --> 00:20:19,490
...وبعدها

349
00:20:19,820 --> 00:20:23,070
.كبرت ريتسوكو لتصبح مهووسة بالخادمات

350
00:20:23,440 --> 00:20:25,410
،بقدرة استثنائية على التعلّم

351
00:20:25,410 --> 00:20:28,390
أتقنت كلّ المهارات المرتبطة بكون المرء خادمة

352
00:20:28,390 --> 00:20:30,070
.وواصلت دراساتها الأكاديمية

353
00:20:30,520 --> 00:20:35,420
أبي، أمّي، سأدرسُ في الخارج
!في بريطانيا لأصبح خادمة

354
00:20:35,710 --> 00:20:37,240
حقًا؟

355
00:20:37,240 --> 00:20:39,590
سمعتُ أنّهم يملكون معلمًا
.سياحيًا يُدعى بيغ بن

356
00:20:39,590 --> 00:20:42,480
أنتِ تحبّين الخادمات حقًا
صحيح يا عزيزتي ريتسوكو؟

357
00:20:42,480 --> 00:20:43,890
.استمتعي بوقتك

358
00:20:44,150 --> 00:20:45,330
...ثمّ

359
00:20:51,270 --> 00:20:53,980
...خادمة... طائرة

360
00:20:54,530 --> 00:20:57,990
...تذكّرت في تلك اللّحظة

361
00:20:57,990 --> 00:21:00,660
.هويتها قبل أن تولد من جديد

362
00:21:01,430 --> 00:21:02,660
...بالمناسبة

363
00:21:09,490 --> 00:21:11,540
.شكرًا على الانتظار

364
00:21:11,540 --> 00:21:13,610
ما رأيكِ يا سيّدتي؟

365
00:21:14,220 --> 00:21:16,460
.نعم، أراهُ جميلًا

366
00:21:16,460 --> 00:21:18,420
.شكرًا جزيلًا

367
00:21:18,420 --> 00:21:20,950
لا يمكن أن تكوني
خادمة دون المظهر المناسب، صحيح؟

368
00:21:20,950 --> 00:21:23,680
السحر قادرٌ على فعل
...شيء كهذا أيضًا إذًا

369
00:21:23,680 --> 00:21:25,920
.استطعتُ صُنع زيّ مقبول

370
00:21:26,250 --> 00:21:30,360
يحتوي على سحرٍ وقائي أيضًا لذا
.هو أصلب من مُعظم الدّروع

371
00:21:30,360 --> 00:21:32,760
.أنتِ تقولين نكاتًا غريبة حقًا يا ميلودي

372
00:21:33,240 --> 00:21:35,810
.ليت الأمر كان نكتة

373
00:21:37,990 --> 00:21:41,840
.الأولوية القُصوى هي صيانة القصر بكلّ تأكيد

374
00:21:41,840 --> 00:21:44,970
.قد يكون فعل هذا بمفردي صعبًا

375
00:21:44,970 --> 00:21:45,770
...إذًا، في هذه الحالة

376
00:21:46,360 --> 00:21:49,810
!لا تبقَ واحدًا يا جسدي... الأنا الأخرى

377
00:21:54,930 --> 00:21:56,920
!هيّا لنبدأ جميعًا

378
00:21:57,140 --> 00:21:58,230
!حسنًا