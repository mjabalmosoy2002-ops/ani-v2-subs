1
00:00:10,740 --> 00:00:12,610
...أليس ذلك

2
00:00:21,220 --> 00:00:22,290
.أهلًا

3
00:00:22,290 --> 00:00:24,710
تتردّد إلى هنا كثيرًا، أليس كذلك؟

4
00:00:24,710 --> 00:00:26,250
هل تتمنّى شيئًا؟

5
00:00:26,250 --> 00:00:27,190
ما اسمك؟

6
00:00:28,650 --> 00:00:30,990
.أنا... ريو

7
00:00:30,990 --> 00:00:34,790
.سمعتُ أنّ هذا الضّريح يشفي الأمراض

8
00:00:36,380 --> 00:00:39,100
.تعاني أمّي من مرض غريب

9
00:00:39,410 --> 00:00:41,000
مرض غريب؟

10
00:00:41,560 --> 00:00:44,980
.أنا الدّكتور راموني. وأنا طبيب غريب بعض الشّيء بدوري

11
00:00:46,730 --> 00:00:48,470
طبيب؟

12
00:00:48,470 --> 00:00:52,180
—هذا صحيح. كما ترى، أنا طبيب فائق العظمة يستطيع

13
00:00:52,180 --> 00:00:53,850
.أيّها الدّكتور، لديك مكالمة

14
00:00:54,630 --> 00:00:56,890
.سأنصت لما لديك

15
00:00:56,890 --> 00:00:59,210
.كورو، اعتن بهذا الصّبيّ

16
00:00:59,690 --> 00:01:01,870
.حسنًا. ادخل رجاءً

17
00:01:02,380 --> 00:01:05,620
.مرحبًا، الدّكتور راموني على الخطّ

18
00:01:06,570 --> 00:01:09,330
.فهمت، فهمت. مريضة تعاني من مرض غامض

19
00:01:09,330 --> 00:01:10,850
.شكرًا كما العادة

20
00:01:11,470 --> 00:01:13,250
ماذا؟ عيناها؟

21
00:01:13,250 --> 00:01:16,140
.مهلًا، أنت لست طبيب أنف وأذن وحنجرة

22
00:01:19,840 --> 00:01:21,050
.فهمت

23
00:01:22,060 --> 00:01:23,560
.المعذرة

24
00:01:24,830 --> 00:01:27,450
.يبدو أنّها وصلت

25
00:01:27,450 --> 00:01:28,110
.إلى اللّقاء

26
00:01:30,380 --> 00:01:34,280
.أُحلتُ إلى هنا

27
00:01:34,610 --> 00:01:36,070
أمّي؟

28
00:03:15,930 --> 00:03:18,340
تحوّلت أذناك إلى جياوزو؟

29
00:03:18,340 --> 00:03:23,570
.أجل. لا أستطيع نزعها ولا غرزها بإبرة

30
00:03:24,860 --> 00:03:27,010
.شكرًا

31
00:03:38,450 --> 00:03:39,820
.تفضّلي

32
00:03:43,740 --> 00:03:46,080
.شكرًا لك

33
00:03:46,080 --> 00:03:49,320
تفضّل يا يو. ألا بأس بالشّراب السّاخن؟

34
00:03:49,730 --> 00:03:51,570
.أجل، لا بأس

35
00:03:51,570 --> 00:03:52,690
يو؟

36
00:03:52,690 --> 00:03:54,570
.إنّه اسم أخي

37
00:03:56,830 --> 00:03:59,740
إذًا، منذ متى وأنت تملكين تلكما الأذنين؟

38
00:03:59,740 --> 00:04:02,210
.منذ أكتوبر من العام الماضي

39
00:04:02,210 --> 00:04:05,640
.مذّاك الحين وأنا لا أستطيع سماع أصوات النّاس أحيانًا

40
00:04:05,640 --> 00:04:09,240
.وأعتقد أنّ السّبب يرجع لتحوّل أذنيّ لهذه

41
00:04:10,390 --> 00:04:15,560
.بالمناسبة، تُولّد الأمراض الغامضة عادةً من الإجهاد

42
00:04:16,150 --> 00:04:19,270
هل حدث شيء في أكتوبر الماضي؟

43
00:04:28,330 --> 00:04:30,550
.لا، لا شيء

44
00:04:33,170 --> 00:04:38,670
.لكن مذّاك الحين وأنا أشعر بالدّوار وضعف الذّاكرة أحيانًا

45
00:04:38,670 --> 00:04:41,500
.وأنا بصدد زيارة طبيب نفسيّ من أجل المشورة

46
00:04:44,440 --> 00:04:45,960
.كان ذلك وشيكًا

47
00:04:48,220 --> 00:04:49,880
!يو، هل أنت بخير؟

48
00:04:49,880 --> 00:04:50,960
!هل سُكب عليك؟

49
00:04:52,170 --> 00:04:53,730
.أنا بخير

50
00:04:53,960 --> 00:04:58,560
.جيّد. كدتُ أحرقك ثانيةً

51
00:04:58,560 --> 00:04:59,480
—المعذرة

52
00:05:16,380 --> 00:05:20,210
.آسفة. لم أسمعك

53
00:05:22,410 --> 00:05:23,360
—المعذرة

54
00:05:23,980 --> 00:05:29,140
.فهمت. تلك الجياوزو تغطّي الأصوات أحيانًا

55
00:05:29,140 --> 00:05:32,760
.الّتي لا ينبغي أن تتدخّل بحياتك الشخصيّة

56
00:05:33,010 --> 00:05:34,930
!هذا غير صحيح

57
00:05:34,930 --> 00:05:38,560
.لسببٍ ما، لا أستطيع سماع كلّ ما يقوله ريو

58
00:05:38,560 --> 00:05:40,720
.لا أستطيع إجراء محادثة لائقة معه

59
00:05:41,130 --> 00:05:43,110
ألا يمكنك فعل شيء؟

60
00:05:44,190 --> 00:05:46,520
كيف أفسّر هذا؟

61
00:05:47,130 --> 00:05:50,640
.انطلاقًا ممّا أرى، فتحتا أذنيك ليستا مسدودتين بالكامل

62
00:05:50,640 --> 00:05:53,050
.ولا تستطيعين سماع فقط أجزاء من أصوات معيّنة

63
00:05:53,720 --> 00:05:57,750
أيّ أنّهما تفرّقان بين الأصوات الّتي يمكنك سماعها عادةً

64
00:05:57,750 --> 00:06:00,380
.والّتي تُغطّى من قبل الجياوزو

65
00:06:00,380 --> 00:06:03,300
.وصوت ريو يندرج في الحالة الأخيرة

66
00:06:03,300 --> 00:06:07,180
فور أن تسمعي الأصوات الّتي يفترض بك سماعها

67
00:06:07,180 --> 00:06:11,090
.لكنّ الجياوزو كانت تحجبها، حينها ستُزال

68
00:06:11,090 --> 00:06:14,300
.وستستطيعين سماع صوت ريو ثانيةً

69
00:06:14,920 --> 00:06:18,060
.لكنّ هذه ليست مسألة منطق، بل مسألة قلب

70
00:06:18,460 --> 00:06:21,200
لمَ تغطّي الجياوزو الأصوات؟

71
00:06:21,560 --> 00:06:24,570
.يجدر بك أن تفكّري مليًّا في السّبب ثانيةً

72
00:06:25,300 --> 00:06:27,480
.على أيّ حال، سنرى كيف ستتطوّر الأمور

73
00:06:27,480 --> 00:06:29,650
.عودي بعد أن تستنتجي شيئًا

74
00:06:29,650 --> 00:06:31,360
.حسنًا

75
00:06:31,840 --> 00:06:34,570
المعذرة. أين المرحاض؟

76
00:06:35,040 --> 00:06:36,210
.هناك

77
00:06:36,700 --> 00:06:38,260
يو، هل تحتاج أن تذهب أيضًا؟

78
00:06:38,260 --> 00:06:39,030
.حسنًا

79
00:06:41,430 --> 00:06:43,440
هل آخذ هذا؟

80
00:06:45,920 --> 00:06:46,800
.أكره هذا

81
00:06:47,580 --> 00:06:51,050
".مهمًا قصدت، دائمًا ما يقول لها، "عودي في وقت لاحق

82
00:06:52,090 --> 00:06:57,200
هذا الضّريح يشفي الأمراض، وأنت طبيب، صحيح؟

83
00:06:57,980 --> 00:07:00,760
.عالج أمّي رجاءً

84
00:07:01,280 --> 00:07:03,340
!سأفعل أيّ شيء

85
00:07:10,140 --> 00:07:12,150
.ثمّة طريقة علاجيّة فعّالة جدًّا

86
00:07:12,150 --> 00:07:15,040
.ولم أنصح بها لأنّها تشملك

87
00:07:16,300 --> 00:07:19,130
لكنّك قلت أنّك ستفعل أيّ شيء، صحيح؟

88
00:07:22,550 --> 00:07:23,360
.أجل

89
00:07:24,090 --> 00:07:27,260
.دكتور، إنّه مجرّد صبيّ

90
00:07:27,260 --> 00:07:29,540
،للتأكّد فقط

91
00:07:29,950 --> 00:07:32,410
هل لديك قضيب؟

92
00:07:32,410 --> 00:07:33,680
!ماذا؟

93
00:07:34,170 --> 00:07:35,340
!أجل

94
00:07:37,560 --> 00:07:38,620
.حسنًا يا كورو

95
00:07:38,620 --> 00:07:41,060
.الرّفّ الأزرق، الصّفّ الخامس. الثّاني من يمينك

96
00:07:41,060 --> 00:07:42,600
.ماذا؟ حاضر

97
00:07:46,560 --> 00:07:47,720
ما هذه؟

98
00:07:48,240 --> 00:07:52,280
.لؤلؤة أصوات اللّيل. إنّها أداة غامضة وغريبة بعض الشّيء

99
00:07:53,090 --> 00:07:59,320
.قلت أنّك ستعالج أمّك، لذا سوف تدفع الثّمن بطبيعة الحال

100
00:08:00,700 --> 00:08:03,320
.والثّمن هو صوتك

101
00:08:04,030 --> 00:08:06,860
.علاجها من عدمه يعتمد عليك

102
00:08:13,140 --> 00:08:17,950
هل أنت واثق من إعطائه تلك
الأداة الغامضة دون معرفة السّبب؟

103
00:08:18,340 --> 00:08:19,860
هل تظنّ أنّني لا أعلم؟

104
00:08:20,170 --> 00:08:23,250
.كورو، لستَ بذلك الغباء

105
00:08:23,250 --> 00:08:26,100
.لديك فكرة عن السّبب

106
00:08:27,820 --> 00:08:33,520
.في الواقع، فقط هي من لا تفهم

107
00:08:36,610 --> 00:08:37,480
.المعذرة

108
00:08:39,190 --> 00:08:40,050
—إنّ يو-كن

109
00:08:46,620 --> 00:08:47,290
—قلت

110
00:08:47,290 --> 00:08:50,380
!لا تفعل! كفّ عن المجيء إلى هنا رجاءً

111
00:08:50,380 --> 00:08:52,530
.أمّي، لندخل إلى البيت

112
00:08:52,530 --> 00:08:53,270
ماذا؟

113
00:08:52,530 --> 00:08:53,950
...المعذرة

114
00:08:58,390 --> 00:08:59,590
.مرحبًا بعودتكما

115
00:08:59,590 --> 00:09:02,020
ما الأمر؟ هل حدث شيء؟

116
00:09:02,440 --> 00:09:06,630
.تحدّث إليّ شخص أمام البيت ثانيةً

117
00:09:08,910 --> 00:09:13,110
،لا أدري ما يقوله بما أنّني لا أستطيع سماع صوته

118
00:09:13,110 --> 00:09:16,270
.لكنّه لا ينفكّ عن القدوم

119
00:09:16,270 --> 00:09:18,190
.لا بدّ أنه وسيط تجاريّ

120
00:09:18,190 --> 00:09:19,550
.لا تدعيه يزعجك

121
00:09:23,390 --> 00:09:25,100
.فهمت

122
00:09:25,680 --> 00:09:28,580
.أيّها الدّكتور، اعمل رجاءً

123
00:09:28,580 --> 00:09:29,590
.أجل، أجل

124
00:09:35,640 --> 00:09:37,080
!حارّ جدًّا

125
00:09:40,450 --> 00:09:41,520
.كان ذلك واضحًا

126
00:09:41,520 --> 00:09:43,930
كورو، لمَ لا تهلع؟

127
00:09:46,020 --> 00:09:47,680
لمَ تبدو متعجرفًا جدًّا؟

128
00:09:47,680 --> 00:09:49,920
أليست تلك حارّة إطلاقًا؟

129
00:09:53,970 --> 00:09:55,610
!أنت تتصرّف بفظاظة

130
00:09:56,710 --> 00:10:02,200
يمكن للجياوزو أن تحوي البهارات
.عن طريق تغليفها داخل جلدها

131
00:10:02,620 --> 00:10:08,200
وهي تغطّي الكلمات المؤلمة الّتي لا تريد
.سماعها داخل تلك الجياوزو دون إدراكها

132
00:10:08,570 --> 00:10:11,710
تفضّل يا يو. ألا بأس بالشّراب السّاخن؟

133
00:10:11,710 --> 00:10:13,750
!يو، هل أنت بخير؟

134
00:10:13,750 --> 00:10:15,100
!هل سُكب عليك؟

135
00:10:15,340 --> 00:10:18,750
المعذرة، لكن مع من تتحدّثين؟

136
00:10:22,880 --> 00:10:24,840
...أكتوبر الماضي

137
00:10:25,230 --> 00:10:27,820
.لا بدّ أنّه تلميذ المدرسة الابتدائيّة ذاك

138
00:10:28,150 --> 00:10:29,950
أكان ذلك؟

139
00:10:29,950 --> 00:10:35,050
.بما أنّه كان في طريق مدرستي، ما زلتُ أذكر حشد المراسلين

140
00:10:36,530 --> 00:10:37,420
.وجدته

141
00:10:38,600 --> 00:10:41,320
.يو، سأطفئ الأضواء

142
00:10:46,610 --> 00:10:49,450
...عليّ أن أعالجها في النّهاية

143
00:10:50,520 --> 00:10:53,330
.هيّا. تشاركا أنتما الاثنين

144
00:10:53,330 --> 00:10:54,520
.يا إلهي

145
00:10:54,520 --> 00:11:01,790
.ستكون لي وحدي لو أنّي لا أملك أخًا

146
00:11:13,550 --> 00:11:15,760
كلّ هذا خطئي

147
00:11:17,950 --> 00:11:19,690
.لأنّه اختفى

148
00:11:25,260 --> 00:11:26,960
أمّي، هل علمتِ؟

149
00:11:26,960 --> 00:11:33,210
تملك الطّماطم جذوعًا لزجة تصيد
—الحشرات وتستهلكها من أجل التّغذية، و

150
00:11:33,210 --> 00:11:35,630
!أريد المزيد من كعكة لحم الخنزير تلك

151
00:11:35,630 --> 00:11:37,090
!لا تكن أنانيًّا

152
00:11:37,090 --> 00:11:38,880
!لكن علينا أن نتشارك دائمًا

153
00:11:38,880 --> 00:11:40,220
!عليك أن تشتري واحدة لكلّ منّا

154
00:11:40,220 --> 00:11:42,550
.حينها لن تستطيعا تناول العشاء

155
00:11:42,550 --> 00:11:44,470
.ما عدت أحبّك ولا يو

156
00:11:47,210 --> 00:11:49,260
.حرقت نفسك

157
00:11:49,590 --> 00:11:51,900
هل أنت بخير؟ هل تتألّم؟

158
00:11:51,900 --> 00:11:53,520
.أنا بخير

159
00:11:53,520 --> 00:11:56,260
.سأجعل ريو يعتذر لاحقًا

160
00:12:00,530 --> 00:12:01,890
—يا أمّي

161
00:12:01,890 --> 00:12:05,370
.آسفة يا يو. سأذهب لأتفقّد حال ريو

162
00:12:08,330 --> 00:12:11,780
.لا تبكِ. أنا واثقة أنّ ذلك لم يكن مقصودًا

163
00:12:27,370 --> 00:12:30,000
.آمل أن يُبهج هذا ريو

164
00:12:38,700 --> 00:12:43,940
يا فتى. هلّا ساعدتني في الإرشاد؟

165
00:13:03,070 --> 00:13:05,000
.يو. يو

166
00:13:06,040 --> 00:13:10,260
.لم يعد إلى البيت لأسبوع بسببي

167
00:13:10,870 --> 00:13:14,470
.بدا أنّه يريد قول شيء حينها

168
00:13:14,840 --> 00:13:18,400
.إنّه خطئي لأنّي اهتممت بريو بدلًا من الإصغاء له

169
00:13:19,600 --> 00:13:20,910
...لريو

170
00:13:22,710 --> 00:13:24,970
!تلقّينا معلومات من شهود تخصّ يو-كن

171
00:13:25,780 --> 00:13:30,140
في يوم اختفائه، اشترى كعك لحم
.خنزير من متجر البقالة الّذي في الجوار

172
00:14:09,130 --> 00:14:09,820
!ما الخطب؟

173
00:14:11,040 --> 00:14:13,180
.يو. يو

174
00:14:14,410 --> 00:14:17,820
...ذراع يو

175
00:14:24,330 --> 00:14:26,200
.أخبرينا عن القضيّة

176
00:14:24,790 --> 00:14:26,860
هل من سبب يدعو أحد لكرهك؟

177
00:14:25,560 --> 00:14:27,330
كيف كان يو-كن؟

178
00:14:28,900 --> 00:14:33,090
،في حالة الصّبيّ المفقود مياتا يو-كن
...أظهرت نتائج فحص الحمض النّوويّ

179
00:14:35,130 --> 00:14:36,370
—أمّي

180
00:14:35,570 --> 00:14:36,850
.لا

181
00:14:37,700 --> 00:14:39,570
.يو لم يمت

182
00:14:40,660 --> 00:14:43,140
.توقّفوا. توقّفوا رجاءً

183
00:14:43,470 --> 00:14:45,970
.توقّفوا. لا، لا، لا

184
00:14:45,970 --> 00:14:47,840
.توقّفوا رجاءً. لا، رجاءً

185
00:14:47,840 --> 00:14:49,730
...لا، لا، لا، لا، لا

186
00:14:50,330 --> 00:14:52,860
.لا أريد سماع هذا بعد الآن

187
00:15:01,280 --> 00:15:04,350
سيّدتي، هل أنت بخير؟

188
00:15:04,350 --> 00:15:07,220
.أنا واثقة أنّ الوضع صعب بعد اختفاء يو-كن

189
00:15:07,900 --> 00:15:09,120
يو؟

190
00:15:10,150 --> 00:15:13,990
.يو هنا

191
00:15:18,810 --> 00:15:20,630
هلوسات حقيقيّة؟

192
00:15:20,940 --> 00:15:26,690
.أجل. إنّها تهلوس بوجود شيء غير حقيقيّ بجانبها

193
00:15:27,320 --> 00:15:33,640
.إنّها تهلوس طفلها من أجل أن تحمي نفسها من حقيقة مؤلمة

194
00:15:33,950 --> 00:15:36,940
.هذا ما قاله الطّبيب النّفسيّ

195
00:15:36,940 --> 00:15:38,240
.فهمت

196
00:15:38,240 --> 00:15:42,310
.اقترحت أن نرى كيف تسير الأمور لأنّك تلقّيت تلك المعلومات

197
00:15:42,310 --> 00:15:43,260
.أجل

198
00:15:44,710 --> 00:15:46,650
.لؤلؤة أصوات اللّيل

199
00:15:47,870 --> 00:15:54,340
.قلت أنّك ستعالج أمّك، لذا سوف تدفع الثّمن بطبيعة الحال

200
00:15:54,340 --> 00:15:56,980
.علاجها من عدمه يعتمد عليك

201
00:16:08,610 --> 00:16:10,750
.ضع هذه في أذنك

202
00:16:11,570 --> 00:16:14,290
.مرحبًا، مرحبًا. حوّل

203
00:16:15,320 --> 00:16:19,860
.عندما تتكلّم من خلالها، يُسمع صوتك في الصّدفة الأخرى

204
00:16:20,290 --> 00:16:22,050
مثل الهاتف؟

205
00:16:22,050 --> 00:16:24,250
.لكنّي لا أسمع أيّ شيء

206
00:16:24,250 --> 00:16:29,620
بطبيعة الحال، يمكن استخدامها فقط
.من قبل رجل وامرأة واقعان في الحبّ

207
00:16:30,290 --> 00:16:34,260
.استُخدما قبل وقت طويل من قبل عشيقين

208
00:16:34,870 --> 00:16:40,110
بواسطتها، استطاعا سماع صوت
.بعضهما حتّى وهما بعيدين عن بعضهما

209
00:16:40,840 --> 00:16:46,260
،لكن كلّما تكلّمت، سُرقت أصواتك من قبل الصّدف

210
00:16:46,260 --> 00:16:48,280
.إلى أن تختفي تمامًا في الأخير

211
00:16:48,280 --> 00:16:52,430
إن تبادلت أنت وشريكك الّلؤلؤة
،اللّتين غذّيتماها بصوتيكما وأكلتماها

212
00:16:52,430 --> 00:16:55,230
.فإنّ حبّكما سيدوم إلى الأبد

213
00:16:55,230 --> 00:16:57,480
.وكأنّها تمّيمة سحريّة

214
00:16:57,950 --> 00:16:59,820
.تبدو كحكاية خرافيّة

215
00:17:00,890 --> 00:17:01,860
.معك حقّ

216
00:17:01,860 --> 00:17:05,470
.على أيّ حال، الأمّ وابنها هما رجل وامرأة يحبّان بعضهما

217
00:17:05,470 --> 00:17:08,510
.عليك وأمّك أن تحتفظا بها

218
00:17:10,770 --> 00:17:12,380
هل فهمت؟

219
00:17:12,380 --> 00:17:18,020
.بينما تتحدّث إلى أمّك عبر هذه، سيختفي صوتك

220
00:17:18,860 --> 00:17:22,640
،وفور أن تعرف أنّ صوت ابنها يختفي، ستحاول أن تسمعه

221
00:17:22,640 --> 00:17:26,520
وإن عنى ذلك تقبّلها للحقيقة
.المؤلمة الّتي غلّفتها بتلك الجياوزو

222
00:17:26,850 --> 00:17:31,580
.بمعنى آخر، طريقة العلاج هذه تقايضك بذلك

223
00:17:33,520 --> 00:17:36,020
هل ستعالجها تلك الأداة الغامضة؟

224
00:17:36,020 --> 00:17:38,030
.لديّ خطّة

225
00:17:38,280 --> 00:17:43,050
،من الممكن أنّ وضعه على الميزان لن يغيّر شيئًا

226
00:17:43,050 --> 00:17:45,800
.لذا سأرجّح الميزان من أجلهما

227
00:17:55,650 --> 00:17:58,420
أخي، أين أنت؟

228
00:17:58,420 --> 00:18:00,300
ماذا؟ ريو-كن؟

229
00:18:07,600 --> 00:18:10,010
!سبق وأخبرتك أن تتوقّف عن المجيء

230
00:18:10,010 --> 00:18:12,100
.لا تكن هكذا

231
00:18:12,420 --> 00:18:15,810
.أحيانًا يتقدّم النّاس بمعلومات بعد قراءتهم لمقالة

232
00:18:17,660 --> 00:18:21,270
ألا تريد أن يُقبض على الجاني الّذي قتل أخاك؟

233
00:18:24,190 --> 00:18:26,190
!لا تفترض أنّ أخي ميّت

234
00:18:53,530 --> 00:18:55,270
.ريو

235
00:18:55,270 --> 00:18:59,210
ذلك الغسيل. لم هو مبلّل؟

236
00:19:01,160 --> 00:19:02,310
هل تُمطر؟

237
00:19:03,740 --> 00:19:07,550
لمَ لم ألحظ؟

238
00:19:08,540 --> 00:19:10,960
.المطر خافت للغاية

239
00:19:18,010 --> 00:19:20,550
.كان قد بقي قدرٌ يكفي لكوب

240
00:19:22,070 --> 00:19:24,900
.ليس من عادتك ألّا تشرب من الكرتونة

241
00:19:24,900 --> 00:19:26,380
.الجوّ بارد قليلًا اليوم

242
00:19:26,380 --> 00:19:28,310
.إنّي أعدّ حليبًا ساخنًا

243
00:19:28,820 --> 00:19:32,050
.أيّها الدّكتور، سأغادر لليوم

244
00:19:32,050 --> 00:19:35,740
حسنًا. لديك عمل ما في البيت، صحيح؟

245
00:19:35,740 --> 00:19:36,560
.أجل

246
00:19:36,860 --> 00:19:37,570
!أيّها الدّكتور

247
00:19:40,870 --> 00:19:41,820
.ريو

248
00:19:42,240 --> 00:19:45,680
...ما العمل؟ أذنا أمّي

249
00:19:46,450 --> 00:19:48,290
!أسرع، تعال بسرعة

250
00:19:48,290 --> 00:19:51,260
.حسنًا، حسنًا. انتظر لكي أقفل البيت

251
00:19:51,500 --> 00:19:53,840
ألست بحاجة لإطفاء الأضواء؟

252
00:19:53,840 --> 00:19:55,970
.لا بأس

253
00:19:55,970 --> 00:19:59,160
.سأعود فور أن أتفحّص أمّه

254
00:20:00,500 --> 00:20:02,220
!بسرعة، بسرعة

255
00:20:02,220 --> 00:20:04,270
.اهدأ

256
00:20:04,500 --> 00:20:05,910
.كن حذرًا

257
00:20:10,340 --> 00:20:13,440
.لا تركض وإلّا ستقع

258
00:20:23,560 --> 00:20:25,440
!مهلًا، إلى أين تذهب؟

259
00:20:25,440 --> 00:20:27,150
!بيتك ليس هناك

260
00:20:27,150 --> 00:20:28,780
.رأيت شيئًا يتحرّك

261
00:20:28,780 --> 00:20:29,990
.قد يكون أخي

262
00:20:29,990 --> 00:20:32,080
!ماذا؟ اهدأ أيّها الغبيّ

263
00:20:32,080 --> 00:20:33,580
...أخوك

264
00:20:36,670 --> 00:20:38,120
!تبًّا

265
00:21:24,490 --> 00:21:25,870
.لقد عدت

266
00:21:29,040 --> 00:21:30,190
ما الخطب؟

267
00:21:32,150 --> 00:21:33,420
...ريو

268
00:21:36,470 --> 00:21:38,460
.لم يعد بعد

269
00:21:46,990 --> 00:21:47,940
!أيّها الدّكتور

270
00:21:49,940 --> 00:21:51,310
!أيّها الدّكتور

271
00:21:53,060 --> 00:21:54,600
!أيّها الدّكتور

272
00:23:25,930 --> 00:23:26,890
!أيّها الدّكتور

273
00:23:26,890 --> 00:23:29,310
.كورو، لقد انتهيت

274
00:23:29,310 --> 00:23:32,440
...ساقاي ووركي ورأسي

275
00:23:32,440 --> 00:23:34,620
.كم أنت غير كفء

276
00:23:34,850 --> 00:23:36,110
.-الدّكتور راموني -أخصّائيّ الأمراض الغامضة

277
00:23:36,110 --> 00:23:39,350
".الحلقة 6، "أذنا الجياوزو، الجزء الثّاني