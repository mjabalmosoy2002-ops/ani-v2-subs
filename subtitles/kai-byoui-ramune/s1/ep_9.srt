1
00:00:00,750 --> 00:00:02,580
"متاهة غامضة؟"

2
00:00:02,580 --> 00:00:03,590
.أجل

3
00:00:04,970 --> 00:00:09,990
.فنّان أدوات غامضة مشهور يدعى رينيت مات مؤخرًّا

4
00:00:10,220 --> 00:00:14,210
.مرحبًا. خبّأتُ كنزًا داخل متاهة غامضة"

5
00:00:14,690 --> 00:00:18,160
.وسأمنحها لأيّ من يعثر على بقاياي

6
00:00:18,160 --> 00:00:21,480
.في ليلة البدر، سيفتح الباب الصّائب

7
00:00:22,050 --> 00:00:27,190
أنت مخادع وبارع وذكيّ، أنا واثق
.أنّك ستقلب الحقيقة الملتوية

8
00:00:27,530 --> 00:00:29,110
".مع تحيّاتي، رينيت

9
00:00:29,590 --> 00:00:32,000
.أي أنّها عمليّة البحث عن الكنز

10
00:00:32,220 --> 00:00:35,330
أجل. شاعريّ جدًّا، صحيح؟

11
00:00:35,330 --> 00:00:38,260
.أتساءل ما هو كنز رينيت

12
00:00:42,890 --> 00:00:45,580
!سحقًا! كنتُ وشيكًا

13
00:00:46,180 --> 00:00:49,450
.يبدو أنّ الأمر لن يكون هيّنًا

14
00:00:49,790 --> 00:00:50,830
.أجل

15
00:01:01,420 --> 00:01:02,510
هل من أحد هنا؟

16
00:01:04,510 --> 00:01:06,250
!الجدّة، نيكو-ني

17
00:01:06,250 --> 00:01:08,510
راموني ومساعده؟

18
00:01:25,260 --> 00:01:29,330
هل ظننت أنّك تستطيع الهرب منّي أيّها الغبيّ؟

19
00:01:30,400 --> 00:01:33,670
.سعيد لرؤيتك ثانيةً أيّها المعلّم موميجي

20
00:03:11,740 --> 00:03:16,110
.فهمت. إذًا فقد تلقّيت دعوةً أيضًا

21
00:03:16,390 --> 00:03:17,830
.أ-أجل

22
00:03:17,830 --> 00:03:21,040
.على أيّ حال، أنا متفاجئ لأنّك تملك مساعدًا الآن

23
00:03:21,040 --> 00:03:23,300
صنعت لنفسك اسمًا، أليس كذلك؟

24
00:03:23,640 --> 00:03:24,610
.مرحبًا

25
00:03:26,010 --> 00:03:28,320
ما بالك؟

26
00:03:28,520 --> 00:03:32,060
.يشعر بالصّدمة حتّى النّخاع

27
00:03:32,640 --> 00:03:35,060
...كلّ تلك التّداريب القاسية

28
00:03:35,060 --> 00:03:38,150
.أرتجف خوفًا بمجرّد تذكّرها

29
00:03:46,400 --> 00:03:48,390
.لكنّ هذا غريب

30
00:03:48,390 --> 00:03:52,150
.أنت تعمل وحدك عادةً، لكنّك هنا مع الجدّة ونيكو-ني

31
00:03:54,040 --> 00:03:55,930
إلى أين أنت ذاهب يا موميجي؟

32
00:03:55,930 --> 00:03:57,630
.المدخل من ذاك الاتّجاه

33
00:03:58,330 --> 00:03:59,890
.صحيح

34
00:03:59,890 --> 00:04:03,620
ما كنت لتأتي إلى هنا لوحدك
.باعتبار حسّك الفظيع بالاتّجاهات

35
00:04:04,290 --> 00:04:06,120
هل قلت شيئًا؟

36
00:04:07,260 --> 00:04:09,530
.ذاك الغبيّ. ما كان يجب أن يقول ذلك

37
00:04:09,530 --> 00:04:14,710
بيبوبو-تشان تستطيع إرشاده
.إلى الأماكن الّتي زارها من قبل فقط

38
00:04:14,710 --> 00:04:16,010
بيبوبو-تشان؟

39
00:04:16,010 --> 00:04:19,490
.ذلك الشّيء. إنّه حيوان أليف مُرشد غامض

40
00:04:22,360 --> 00:04:23,740
.سنتولّى إرشادكم

41
00:04:23,740 --> 00:04:27,580
ممنوع الكاميرات والهواتف الذكيّة
.والأدوات الغامضة بعد هذه النّقطة

42
00:04:31,070 --> 00:04:34,450
.موكي-تشان، أحسني التصرّف أثناء غيابنا

43
00:04:39,310 --> 00:04:41,430
موميجي، ماذا تفعل؟

44
00:04:42,420 --> 00:04:43,410
.لا شيء

45
00:04:44,510 --> 00:04:46,560
.انتهينا من فحص أغراضكم

46
00:04:47,070 --> 00:04:49,490
.سينتهي وقتكم حينما تنطفئ الشّموع

47
00:04:51,000 --> 00:04:53,300
.والآن ادخلوا رجاءً

48
00:04:57,330 --> 00:05:00,140
.مرحبًا بكم في المتاهة الغامضة

49
00:05:02,440 --> 00:05:04,480
.إنّها كأعمال فنّيّة

50
00:05:04,920 --> 00:05:08,570
كلّ الأدوات الغامضة هنا بما فيما المتاهة نفسها

51
00:05:08,570 --> 00:05:11,240
.من أعمال رينيت

52
00:05:11,730 --> 00:05:13,340
كلّ هذه؟

53
00:05:30,960 --> 00:05:35,220
.أكملوا المهامّ رجاءً واحصلوا على كلّ المفاتيح السّبعة

54
00:05:46,280 --> 00:05:47,480
مرايا؟

55
00:05:57,130 --> 00:05:59,590
نسخوني والجدّة؟

56
00:06:00,490 --> 00:06:02,070
ما الّذي يجري؟

57
00:06:05,260 --> 00:06:08,500
.فهمت. لا بدّ أنّ هذه مهمّتنا

58
00:06:08,500 --> 00:06:10,680
لكن كيف يفترض بنا إيجاد الحقيقيّ؟

59
00:06:10,680 --> 00:06:11,910
.إنّه أنا

60
00:06:11,460 --> 00:06:13,880
.إنّه أنا. هذا أنا يا نيكو-ني

61
00:06:11,910 --> 00:06:13,060
.اعذروني

62
00:06:13,880 --> 00:06:15,350
يمكنك أن تعرف ذلك، صحيح؟

63
00:06:16,970 --> 00:06:21,650
.أصواتهم متشابهة، لكن لا يمكنهم نسخ صوت دقّات قلبهما

64
00:06:22,130 --> 00:06:25,440
.صحيح. ينبغي بحاسّة سمع نيكو-سان الاستثنائيّة حلّ المسألة

65
00:06:34,580 --> 00:06:36,520
.جدّتي، وجدتك

66
00:06:37,730 --> 00:06:39,130
.شكرًا لك

67
00:06:39,570 --> 00:06:43,590
.عرفت أنّك ستجدني

68
00:06:44,280 --> 00:06:45,950
.مبهر كعادتك يا نيكو-ني

69
00:06:45,950 --> 00:06:48,330
.أيّها المعلّم، هذا أنا

70
00:06:48,330 --> 00:06:49,830
.أنا الحقيقيّ

71
00:06:50,170 --> 00:06:53,960
.لا أصدّق المتاعب الّتي تسبّب لي

72
00:06:54,290 --> 00:06:56,820
!أنت جريء أيّها الغبيّ

73
00:07:00,670 --> 00:07:02,590
.مبهر

74
00:07:02,590 --> 00:07:03,980
.طبعًا

75
00:07:03,980 --> 00:07:05,680
كيف عرفت؟

76
00:07:06,100 --> 00:07:08,300
.الأمر واضح وضوح الشّمس

77
00:07:08,300 --> 00:07:10,990
.صاحب أغبى مظهر بين الجميع هو الشّخص الحقيقيّ

78
00:07:28,830 --> 00:07:30,480
.الأمر مختلف هذه المرّة

79
00:07:30,480 --> 00:07:32,180
.هذا ليس كلّ شيء

80
00:07:32,180 --> 00:07:33,200
.انظروا

81
00:07:35,480 --> 00:07:37,640
.لا تدعوا هذا يفاجئكم

82
00:07:37,640 --> 00:07:40,320
.فرينيت هو من بنى هذه المتاهة

83
00:07:41,210 --> 00:07:43,070
.موميجي محقّ

84
00:07:43,070 --> 00:07:44,930
.وقتنا محدود أيضًا

85
00:07:45,250 --> 00:07:48,320
إذًا ألن نكون أكثر فاعليّة إن انفصلنا؟

86
00:07:58,380 --> 00:08:02,090
أيّها الدّكتور؟ أيامي-سان؟ نيكو-سان؟

87
00:08:02,350 --> 00:08:04,720
.ضللنا الطّريق بالفعل

88
00:08:05,220 --> 00:08:06,510
.لا يهمّ

89
00:08:06,730 --> 00:08:09,830
.تلك المجموعة تضمّ كلًّا من أيامي-سان ونيكو

90
00:08:11,100 --> 00:08:12,730
.الأهمّ، نحتاج المفاتيح

91
00:08:12,730 --> 00:08:13,610
.لنذهب

92
00:08:24,460 --> 00:08:27,760
".اخترق قلب الدّرع بواسطة السّيف"

93
00:08:43,810 --> 00:08:47,420
هل بدلة الدّرع هذه تقلّد حركاتي؟

94
00:08:48,130 --> 00:08:52,760
.ما يعني أنّ طعن قلبها سيطعن قلبي بدوره

95
00:08:53,270 --> 00:08:54,850
ما العمل؟

96
00:08:54,850 --> 00:08:56,620
.حركاتك لا بأس بها

97
00:08:57,500 --> 00:09:01,870
.طريقة تصرّفك وردّات فعلك لا بأس بها أيضًا

98
00:09:01,870 --> 00:09:04,010
هل تدرّبت في الفنون القتاليّة؟

99
00:09:04,490 --> 00:09:06,400
.عائلتي تدير دوجو

100
00:09:06,600 --> 00:09:10,890
.دوجو. لديّ خطّة لك إذًا

101
00:09:11,290 --> 00:09:14,390
.بدلة الدّرع تلك تقلّد حركاتك فحسب

102
00:09:14,390 --> 00:09:16,900
.ليست جسدك

103
00:09:18,190 --> 00:09:19,400
.فهمت

104
00:09:21,280 --> 00:09:24,790
.سأفعل شيئًا كشخص حيّ يعجز الدّرع عنه

105
00:09:32,210 --> 00:09:33,140
!إنّها فرصتي

106
00:09:39,920 --> 00:09:44,190
.مبهر. كلّ من عقلك وجسدك مرنان

107
00:09:44,520 --> 00:09:47,450
.لكن ما زلت بحاجة للتّعامل مع درعك

108
00:09:48,060 --> 00:09:51,240
.ثمّة طريقة أكثر بساطة وسهولة

109
00:09:52,200 --> 00:09:54,180
...سأتحرّك أسرع ممّا تستطيع مواكبته

110
00:09:55,420 --> 00:09:57,330
!وأخترق قلبها

111
00:10:06,180 --> 00:10:07,540
.هذه الثّانية

112
00:10:07,540 --> 00:10:10,210
...إ-إنّه رائع حقًّا

113
00:10:25,820 --> 00:10:30,570
.يا إلهي. نتفرّق لحظةَ نشيح بنظرنا عن بعضنا

114
00:10:32,280 --> 00:10:34,020
.هذا رينيت

115
00:10:36,250 --> 00:10:39,560
.أحبّ رينيت اختراعاته"

116
00:10:40,040 --> 00:10:43,700
سعادته الأعظم هو الوقت الّذي
.أمضاه في صناعة الأدوات الغامضة

117
00:10:44,160 --> 00:10:48,780
مع أنّ المرض تمكّن من جسده
،إلّا أنّه وحتّى آخر نفس يلفظه

118
00:10:48,780 --> 00:10:52,440
".كان ممسكًا بالقلم الزّجاجيّ الّذي استخدمه لرسم تصاميمه

119
00:10:54,130 --> 00:10:55,970
.مهلًا، أحدهم قادم

120
00:11:03,280 --> 00:11:04,380
مفاتيح؟

121
00:11:06,100 --> 00:11:08,860
".جد الصّندوق الّذي يحتوي التّفّاحة"

122
00:11:16,510 --> 00:11:18,880
.اذهب وافتح ذلك الصّندوق حالًا

123
00:11:18,880 --> 00:11:19,610
ماذا؟

124
00:11:22,090 --> 00:11:24,290
ذاك الّذي في القمّة؟

125
00:11:25,180 --> 00:11:26,480
.أسرع

126
00:11:27,200 --> 00:11:27,830
!حاضر

127
00:11:37,410 --> 00:11:38,580
.وجدته

128
00:11:38,850 --> 00:11:39,650
ماذا؟

129
00:11:40,280 --> 00:11:43,440
.كلّ هذه الصّناديق فخاخ

130
00:11:43,440 --> 00:11:47,560
.تضليل انتباه النّاس من أجل إخفاء الإجابة

131
00:11:48,030 --> 00:11:50,060
.هذا من أساسيّات الخداع

132
00:11:50,640 --> 00:11:52,540
حقًّا؟

133
00:11:56,930 --> 00:12:00,310
.كان يجب أن تقول ذلك أبكر إن كنت تعرف

134
00:12:00,530 --> 00:12:05,450
.غبيّ. إن فعلت ذلك فسأفوّت عنّي المرح

135
00:12:07,900 --> 00:12:09,950
.سمعت أنّك كنت في المستشفى

136
00:12:11,070 --> 00:12:13,230
.أخبرتني أيامي-سان

137
00:12:13,230 --> 00:12:16,330
قالت أنّك أصبت بشدّة وكدت
.تموت في محاولتك لحماية مريض

138
00:12:17,260 --> 00:12:22,300
أخبرتك عدّة مرّات أن تحافظ على
.مسافة مناسبة بينك وبين مرضاك

139
00:12:22,300 --> 00:12:25,350
.كفّ عن التّعاطف عشوائيًّا مع الجميع

140
00:12:25,530 --> 00:12:29,560
وإن كنت لا تستطيع، فعليك أن تغلق
.عيادة الأمراض الغامضة خاصّتك فورًا

141
00:12:29,900 --> 00:12:33,980
.وإلّا جعلت من حولك تعيسًا أيضًا

142
00:12:37,570 --> 00:12:44,050
!أنا ملك المانغا

143
00:12:44,930 --> 00:12:46,410
نيكو، هل أنت بخير؟

144
00:12:46,600 --> 00:12:47,500
.لا فائدة

145
00:12:47,500 --> 00:12:50,260
.يوجد طنين كبير في أذنيّ ولا أستطيع سماعك

146
00:12:50,260 --> 00:12:52,170
.لنأخذ استراحة

147
00:12:52,170 --> 00:12:55,420
.معك حقّ. جمعنا معظم المفاتيح أيضًا

148
00:12:55,710 --> 00:13:00,560
.بما أنّ موميجي-سان يملك واحدًا، فمجموع مفاتيحنا خمسة

149
00:13:00,560 --> 00:13:01,710
.لا تتحرّك

150
00:13:03,230 --> 00:13:07,040
...سلّموا مفاتيحكم. وإلّا

151
00:13:12,600 --> 00:13:13,820
!لا تتحرّكي

152
00:13:16,540 --> 00:13:19,510
.أدوات رينيت الغامضة قيّمة للغاية

153
00:13:20,080 --> 00:13:23,940
.سنفعل أيّ ما تطلّب للحصول على كنز رينيت

154
00:13:24,350 --> 00:13:27,440
.وسنستعملكم كطعم لأخذ مفاتيح أصدقائكم

155
00:13:28,130 --> 00:13:31,450
.لكن أنت أيّها الشّقيّ. لن أسامحك على ذلك

156
00:13:33,550 --> 00:13:36,450
.مهلًا. أحدهم هناك

157
00:13:40,880 --> 00:13:41,740
!كورو

158
00:13:41,740 --> 00:13:42,710
—أولئك

159
00:13:42,710 --> 00:13:44,380
.لا تندفع بتهوّر

160
00:13:44,380 --> 00:13:46,670
.لديه مسدّس، كان حقيقيًّا أم زائفًا

161
00:13:47,620 --> 00:13:49,030
.دعني

162
00:13:49,030 --> 00:13:50,720
ماذا ستفعل إن أُصبت بطلقة؟

163
00:13:50,720 --> 00:13:51,500
.لا أهتمّ

164
00:13:52,660 --> 00:13:54,520
.هذا ما أقصده بالضّبط

165
00:13:54,950 --> 00:13:56,480
.اهدأ

166
00:13:56,480 --> 00:13:59,510
من يقف أمامك؟

167
00:14:09,540 --> 00:14:11,630
.معلّم موميجي

168
00:14:12,350 --> 00:14:13,550
.جيّد

169
00:14:14,190 --> 00:14:18,040
أتظنّ أنّ هناك مشكلة لا أستطيع حلّها؟

170
00:14:18,520 --> 00:14:19,740
.لا

171
00:14:22,850 --> 00:14:24,010
.افتح فمك

172
00:14:25,430 --> 00:14:26,860
.سنستخدم هذه

173
00:14:35,740 --> 00:14:37,960
.يبدو أنّ صديقيكم قد أتيا

174
00:14:39,180 --> 00:14:40,600
.أنت، لا تتحرّك

175
00:14:40,600 --> 00:14:42,180
مـ-ما الّذي يجري؟

176
00:14:42,580 --> 00:14:43,410
ماذا؟

177
00:14:43,730 --> 00:14:46,400
هل الجميع بخير؟

178
00:14:46,610 --> 00:14:51,160
.إن كنت تريدنا أن نحرّر أصدقاءك، سلّمنا مفاتيحك

179
00:14:51,160 --> 00:14:52,840
.حـ-حسنًا

180
00:14:52,840 --> 00:14:53,250
.ويحي

181
00:14:54,210 --> 00:14:57,040
.تبًّا، هذا يستغرق طويلًا

182
00:14:59,620 --> 00:15:01,230
—ما الّذي

183
00:15:02,790 --> 00:15:06,690
!كيف تجرؤ على ضرب تلميذي

184
00:15:14,140 --> 00:15:15,310
دكتور؟

185
00:15:19,170 --> 00:15:21,790
.كانا يحملان مسدّسين مزيّفين في النّهاية

186
00:15:22,860 --> 00:15:26,180
والآن، ماذا أفعل بكما؟

187
00:15:31,920 --> 00:15:34,940
.لم أتوقّعك أن تستخدم زهرة التّيفا

188
00:15:35,610 --> 00:15:40,090
،باستخدام زهرة التّيفا لجعل بيبوبو خفيًّا

189
00:15:40,090 --> 00:15:42,810
.استطاع جلب الاثنين إلى الدّاخل دون لفت الانتباه

190
00:15:43,290 --> 00:15:47,210
.إنّه رجل مخادع بحقّ

191
00:15:48,750 --> 00:15:52,090
.على أيّ حال، لدينا الآن كلّ المفاتيح السّبعة

192
00:16:18,150 --> 00:16:20,610
.يبدو مكان دراسة

193
00:16:26,090 --> 00:16:27,120
.يأبى أن يفتح

194
00:16:27,120 --> 00:16:29,170
ماذا؟ حقًّا؟

195
00:16:29,170 --> 00:16:32,460
.يفترض بشخص واحد أن يجمع كلّ المفاتيح السّبعة غالبًا

196
00:16:32,660 --> 00:16:36,100
وإلّا فالمجموعات الّتي تضمّ
.أعضاء أكثر ستكون لها الأفضليّة

197
00:16:36,100 --> 00:16:37,360
.فهمت

198
00:16:37,360 --> 00:16:39,730
.لندع رامو-تشان يتكلّف بهذا

199
00:16:41,810 --> 00:16:45,100
أين هي بقايا رينيت؟

200
00:16:48,620 --> 00:16:50,720
.الوقت يداهمنا

201
00:16:50,720 --> 00:16:51,860
...دكتور

202
00:16:52,240 --> 00:16:54,120
.سيستطيع إيجادها

203
00:16:54,360 --> 00:16:57,340
.قد لا يكون مثاليًّا، لكنّه لا يزال تلميذي

204
00:17:04,780 --> 00:17:09,370
مع أنّ المرض تمكّن من جسده
،إلّا أنّه وحتّى آخر نفس يلفظه

205
00:17:09,760 --> 00:17:13,790
".كان ممسكًا بالقلم الزّجاجيّ الّذي استخدمه لرسم تصاميمه

206
00:17:15,790 --> 00:17:18,780
.الشّيء الّذي تمسّك به رينيت حتّى النّهاية

207
00:17:19,130 --> 00:17:20,580
...أراهن أنّ عائلته

208
00:17:24,890 --> 00:17:30,180
...حينما تمّ حرق جثمانه، إن ظلّت بقاياه في الزّجاج

209
00:17:32,540 --> 00:17:34,630
.إذًا فهذه هي بقايا رينيت

210
00:17:35,190 --> 00:17:39,470
.تهانينا. توصّلت إلى الإجابة الصّحيحة

211
00:17:49,140 --> 00:17:50,110
.دكتور

212
00:17:50,880 --> 00:17:54,240
.وجدت بقايا رينيت

213
00:17:54,240 --> 00:17:55,910
أين هو الكنز إذًا؟

214
00:17:56,310 --> 00:17:57,930
.وجدته

215
00:17:59,360 --> 00:18:00,840
ما ذلك الكتاب؟

216
00:18:01,620 --> 00:18:02,580
.دعني أرى

217
00:18:05,090 --> 00:18:06,190
.إنّه فهرس

218
00:18:06,190 --> 00:18:10,690
مذكور به أنّنا نستطيع الحصول
.على أيٍّ من أدوات رينيت الغامضة

219
00:18:10,690 --> 00:18:13,950
!حقًّا؟ هذا سخيّ حقًّا

220
00:18:15,910 --> 00:18:19,060
.تفضّلي يا أيامي-سان. شكرًا من أجل اليوم

221
00:18:19,060 --> 00:18:21,160
ماذا؟ حقًّا؟ هل أنت واثق؟

222
00:18:21,160 --> 00:18:23,540
—معلّم؟ هذا لي

223
00:18:29,450 --> 00:18:31,470
!نيكو-ني

224
00:18:36,180 --> 00:18:38,420
.ما زال شيء ما يبدو ناقصًا

225
00:18:39,880 --> 00:18:41,710
كوروبي، ألم تنل قسطًا كافيًا من النّوم؟

226
00:18:42,100 --> 00:18:44,750
!سأمدّك ببعض الطّاقة. شحن

227
00:18:45,400 --> 00:18:46,620
.شكرًا

228
00:18:48,490 --> 00:18:51,780
.منذ ذلك الحين، كان الدّكتور يتصرّف بغرابة

229
00:18:57,640 --> 00:19:01,450
أكان يريد كنز رينيت بهذا الإلحاح؟

230
00:19:13,800 --> 00:19:16,090
.هذا أنت

231
00:19:17,800 --> 00:19:19,570
لمَ أنت هنا؟

232
00:19:19,570 --> 00:19:21,080
.لنفس السبّب الّذي أتى بك

233
00:19:22,080 --> 00:19:24,190
.لإيجاد الحقيقة

234
00:19:28,550 --> 00:19:31,570
،أنت مخادع وبارع وذكيّ"

235
00:19:31,570 --> 00:19:34,840
".أنا واثق أنّك ستقلب الحقيقة الملتوية

236
00:19:35,640 --> 00:19:39,680
.كلا المصطلحين يعنيان قلب شيء أو عكسه

237
00:19:40,080 --> 00:19:44,700
،لذا إن كانت الإجابة الصّحيحة هي البدر
.فأن الإجابة الحقيقيّة هي القمر الجديد

238
00:19:44,980 --> 00:19:47,660
.صحيحة" و"حقيقيّة" هما مفهومان منفصلان"

239
00:19:54,010 --> 00:19:56,720
.لم يحدّد أنّها داخل هذه الغرفة

240
00:19:59,760 --> 00:20:02,720
،بجعلنا ننجز المهامّ في غرف مختلفة

241
00:20:02,720 --> 00:20:08,110
.أعطونا انطباع أنّ علينا البحث داخل تلك الغرفة عن البقايا

242
00:20:08,110 --> 00:20:12,480
أتقصد أنّه لم يكن هناك داعٍ لجمع المفاتيح في النّهاية؟

243
00:20:12,950 --> 00:20:14,600
.بلى، كان ذلك ضروريًّا

244
00:20:14,880 --> 00:20:20,450
.كلّما جمع المرء مفاتيح، آمن أنّ ذلك الفعل يحمل دلالةً

245
00:20:20,450 --> 00:20:22,830
.وذلك يبعدهم أكثر عن الحقيقة الواضحة

246
00:20:23,610 --> 00:20:27,860
إن كان القلم الزّجاجيّ غير الملحوظ
،"في نهاية المتاهة هو الإجابة "الصّحيحة

247
00:20:28,490 --> 00:20:31,870
فإنّ الإجابة "الحقيقيّة" هو أوّل شيء
:يتراءى لك عندما تدخل المتاهة

248
00:20:31,870 --> 00:20:33,980
.هذه اللّوحة اللّافتة للنّظر

249
00:20:40,500 --> 00:20:41,820
هذه اللّوحة؟

250
00:20:43,270 --> 00:20:48,130
والآن. أنا جدّ آسف، لكن لا أستطيع
.أن أدعك ترى ما سيحدث تاليًا

251
00:20:48,400 --> 00:20:49,040
ماذا؟

252
00:20:52,830 --> 00:20:55,270
.سامحني. سآخذك إلى البيت لاحقًا

253
00:20:57,530 --> 00:20:58,830
.والآن

254
00:21:06,100 --> 00:21:07,480
.عرفتها

255
00:21:09,030 --> 00:21:13,080
.شكرًا لك. وصلت إلى الحقيقة

256
00:21:13,790 --> 00:21:18,300
.كشخص يفهم حقًّا، أمنحك كنزي

257
00:21:20,570 --> 00:21:24,420
.إنّه لي أخيرًا. "الكتاب القديم الغامض" النّادر

258
00:21:24,830 --> 00:21:26,700
.بحثت عنه بشقاء

259
00:21:28,780 --> 00:21:31,900
.لا أصدّق المتاعب الّتي تسبّب لي أيّها التّلميذ البليد

260
00:21:40,320 --> 00:21:44,250
.تركت لنا عملًا مذهلًا. ارقد بسلام

261
00:23:30,040 --> 00:23:30,880
مُبكية؟

262
00:23:30,880 --> 00:23:32,430
!جعلت كلّ أمريكا تبكي

263
00:23:32,430 --> 00:23:34,130
.يا دكتور، سأجعلك أنت تبكي

264
00:23:34,310 --> 00:23:35,550
.-دكتور راموني -أخصّائيّ الأمراض الغامضة

265
00:23:35,550 --> 00:23:39,550
".الحلقة 10، "قصّة تورو عميقة الغموض، الجزء الأوّل