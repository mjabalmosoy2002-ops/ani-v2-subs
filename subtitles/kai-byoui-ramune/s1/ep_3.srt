1
00:00:07,790 --> 00:00:09,920
!يا كورو

2
00:00:11,630 --> 00:00:13,810
.هنا

3
00:00:14,910 --> 00:00:16,990
.مرحبًا

4
00:00:23,250 --> 00:00:23,990
—أنت

5
00:00:28,260 --> 00:00:29,660
ماذا تريد؟

6
00:00:29,660 --> 00:00:32,130
هلّا توقّفت عن التصرّف بشكل صارخ هكذا؟

7
00:00:32,130 --> 00:00:33,540
.مخيف

8
00:00:33,540 --> 00:00:36,350
.أنا في متجر الأدوات الغامضة الآن

9
00:00:36,350 --> 00:00:37,510
متجر الأدوات الغامضة؟

10
00:00:37,840 --> 00:00:40,200
أتقصد الأدوات الغامضة كنظرة شوجي

11
00:00:40,200 --> 00:00:43,080
وبرّاد الشّفاه الفضفاضة وقماش
فوروشيكي ذاك من قبل أيّام؟

12
00:00:43,080 --> 00:00:46,110
.أجل، إنّه متجر يبيع ويشتري مثل تلك المنتجات

13
00:00:46,110 --> 00:00:48,890
إن أردت المجيء، سأدع صغيري
.موكي-تشان يدلّك إلى الطّريق

14
00:00:49,900 --> 00:00:51,150
ما قرارك؟

15
00:00:55,010 --> 00:00:56,200
.أنا قادم

16
00:02:33,070 --> 00:02:35,880
!أهلًا يا كورو. أتيت

17
00:02:36,110 --> 00:02:38,490
.سأشتري لك وجبة خفيفة

18
00:02:38,870 --> 00:02:40,430
.أنصحك بهذه

19
00:02:40,430 --> 00:02:42,320
.لنقتسم واحدة

20
00:02:43,020 --> 00:02:45,010
.مرحبًا

21
00:02:45,320 --> 00:02:48,380
أنت مساعد رامو-تشان، كورو-كن؟

22
00:02:48,380 --> 00:02:51,450
.أنا صاحب المتجر. اسمي نيكو

23
00:02:51,800 --> 00:02:53,140
.سعيد للقائك

24
00:02:53,830 --> 00:02:54,990
.وأنا أيضًا

25
00:02:54,990 --> 00:02:56,600
.المعذرة

26
00:02:58,250 --> 00:03:00,390
.‫152 سنتيمتر

27
00:03:00,390 --> 00:03:03,340
يبدو صوتك هادئًا ومعتدلًا، لكنّك تلميذ في الابتدائيّة؟

28
00:03:04,730 --> 00:03:07,660
!كورو، دعاك بتلميذ في الابتدائيّة

29
00:03:08,540 --> 00:03:10,110
!مؤلم

30
00:03:10,540 --> 00:03:12,200
.أنا في الإعداديّة

31
00:03:12,200 --> 00:03:15,880
.آسف. لم أقصد أيّ تقليل

32
00:03:16,390 --> 00:03:19,490
.أيّها الطّبيب، أتيت لأنّك قلت أنّ هذا متجر أدوات غامضة

33
00:03:19,490 --> 00:03:22,010
.ماذا؟ ذلك ما هو عليه تمامًا

34
00:03:42,990 --> 00:03:45,270
.يبدو كمتجر أدوات أثريّة

35
00:03:45,270 --> 00:03:46,040
.أجل، أعلم

36
00:03:46,340 --> 00:03:49,080
.أحيانًا ما يفكّر الزّبائن أنّه متجر أثريّات

37
00:03:54,040 --> 00:03:56,540
.حضّرتُ الشّاي

38
00:03:57,190 --> 00:03:59,390
متى ستعود الجدّة؟

39
00:03:59,390 --> 00:04:01,310
.قريبًا على الأغلب

40
00:04:01,310 --> 00:04:02,510
الجدّة؟

41
00:04:02,510 --> 00:04:05,220
.سيّدة عجوز تعرف الكثير عن الأدوات الغامضة

42
00:04:05,220 --> 00:04:08,630
.أدارت هذا المتجر إلى أن أدركت الـ103

43
00:04:08,940 --> 00:04:11,530
.لا أزال بنصف مستواها من حيث إدارته

44
00:04:11,530 --> 00:04:14,900
.إنّها تتكفّل ببيع وشراء الأدوات الغامضة

45
00:04:14,900 --> 00:04:18,020
.تبدو معمّرة كثيرًا

46
00:04:18,020 --> 00:04:19,850
أما زالت تعمل؟

47
00:04:19,850 --> 00:04:20,910
ماذا؟

48
00:04:22,570 --> 00:04:23,770
مرحبًا بعودتك

49
00:04:24,530 --> 00:04:25,660
.يا جدّتي

50
00:04:26,540 --> 00:04:27,440
ماذا؟

51
00:04:27,710 --> 00:04:30,260
.أهلًا يا جدّتي. كنتُ في انتظارك

52
00:04:30,260 --> 00:04:32,170
راموني، هل أتيت؟

53
00:04:32,170 --> 00:04:33,430
.سعيدة لرؤيتك ثانيةً

54
00:04:33,430 --> 00:04:35,780
أذلك الولد مساعدك؟

55
00:04:36,160 --> 00:04:39,040
.هذه صاحبة المتجر سابقًا الجدّة أيامي

56
00:04:39,320 --> 00:04:43,350
على الرّغم من مظهرها، إلّا أنّ عمرها
.بمجموع 112 سنة في الدّاخل

57
00:04:43,350 --> 00:04:44,300
مجموع؟

58
00:04:44,300 --> 00:04:46,430
.تملك ذكريات لحيواتها السّابقات

59
00:04:48,860 --> 00:04:54,320
،بما أنّك انتظرت مجيئي بصبر
.فلا بدّ أنّك تريد شراء أداة غامضة

60
00:04:54,320 --> 00:04:55,810
أيّها تريد؟

61
00:04:55,810 --> 00:04:58,200
.قطعة أخرى من نظرة شوجي

62
00:05:01,750 --> 00:05:04,090
.كورو، تبدو مأسورًا كثيرًا من كلّ هذا

63
00:05:04,090 --> 00:05:04,970
هل أنت مهتمّ؟

64
00:05:04,970 --> 00:05:07,450
.لم أعلم أنّ الأدوات الغامضة تُصنع

65
00:05:07,450 --> 00:05:12,240
،هناك شتّى الأدوات المختلفة
.لكن لا يمكن صنعها من قبل أيٍّ كان

66
00:05:12,240 --> 00:05:16,580
تستطيع الجدّة أيامي صنعها فقط
—بفضل معرفتها الّتي دامت 112

67
00:05:16,580 --> 00:05:20,970
.بربّك يا راموني، أظنّ أنّك يجب أن تتوقّف عن ذكر سنّي

68
00:05:21,520 --> 00:05:23,970
.ماذا؟ ينقصني مكوّن

69
00:05:24,950 --> 00:05:26,180
.ما باليد حيلة

70
00:05:26,180 --> 00:05:27,820
.لن أستطيع الانتهاء اليوم

71
00:05:27,820 --> 00:05:29,330
حقًّا؟

72
00:05:34,610 --> 00:05:36,890
.هاكَ يا كورو. خذ النّصف

73
00:05:36,890 --> 00:05:38,210
.هذا النّصف لي

74
00:05:38,210 --> 00:05:40,220
أهناك أيّ اختلاف؟

75
00:05:40,450 --> 00:05:42,470
.الاختلاف واضح

76
00:05:42,470 --> 00:05:44,320
.إنّهما مختلفان تمامًا

77
00:05:45,220 --> 00:05:46,360
.بالمناسبة

78
00:05:46,900 --> 00:05:49,190
هل هنالك شخص؟

79
00:05:53,650 --> 00:05:55,780
!مهلًا، من أنت؟

80
00:05:55,780 --> 00:05:57,370
!منذ متى وأنت واقف هناك؟

81
00:05:57,370 --> 00:06:01,210
.ماذا؟ كنتُ في الخارج أنادي لأحد منذ فترة

82
00:06:01,210 --> 00:06:03,580
.ودخلت لأنّه لم يجبني أيّ أحد

83
00:06:03,870 --> 00:06:05,240
كيف يمكنني مساعدتك؟

84
00:06:05,570 --> 00:06:07,950
هذا متجر أثريّات، صحيح؟

85
00:06:07,950 --> 00:06:10,420
.ارتأيت أن أبيع هذه لكم

86
00:06:12,550 --> 00:06:13,950
حقًّا؟

87
00:06:14,750 --> 00:06:16,020
جدّتي؟

88
00:06:16,390 --> 00:06:18,230
.ثمّة أداة غامضة مدروجة هناك

89
00:06:29,210 --> 00:06:30,860
،بالمناسبة

90
00:06:31,640 --> 00:06:35,630
.أريد تلك حقًّا

91
00:06:37,870 --> 00:06:40,430
.ليس هذه

92
00:06:40,750 --> 00:06:44,110
.فهمت. ما باليد حيلة إذًا

93
00:06:45,290 --> 00:06:48,600
.في تلك الحالة، سوف تُفتَقد

94
00:06:58,110 --> 00:07:01,220
.راموني، لستُ واثقة إن كنتَ سعيد أو تعيس الحظّ

95
00:07:01,220 --> 00:07:02,850
ما هذا الكلام فجأةً؟

96
00:07:04,340 --> 00:07:08,600
كان بحوزة ذلك الرّجل المكوّن
.المفقود لإعداد نظرة شوجي خاصّتك

97
00:07:09,620 --> 00:07:11,490
.لكنّه أبى بيعه لي

98
00:07:11,490 --> 00:07:12,610
ماذا؟

99
00:07:12,610 --> 00:07:14,990
.إنّه لصّ على الأغلب

100
00:07:14,990 --> 00:07:15,880
ماذا؟

101
00:07:16,540 --> 00:07:21,140
كان هناك لصّ في الحيّ مؤخّرًا
.يستهدف فقط متاجر الأدوات الأثريّة

102
00:07:21,140 --> 00:07:24,640
لم يقدر أحد على معرفة كيف
.يستطيع الدّخول دون كسر الأقفال

103
00:07:24,640 --> 00:07:26,750
.لقد حيّر الشّرطة

104
00:07:27,040 --> 00:07:31,640
.لكن إن كان يستخدم أداة غامضة، فسيفسّر ذلك الأمر

105
00:07:31,640 --> 00:07:35,250
.كان يملك زهرة تِيفَا

106
00:07:36,590 --> 00:07:38,270
ما هي؟

107
00:07:38,460 --> 00:07:42,980
.إنّها أداة غامضة تخفيك عندما تضعها في فمك

108
00:07:42,980 --> 00:07:45,840
.على حساب وجودك

109
00:07:45,840 --> 00:07:47,270
وجودك؟

110
00:07:47,270 --> 00:07:52,490
هل تذكرون كيف أنّ لا أحد لاحظه
عندما دخل للمتجر قبل هنيهة؟

111
00:07:52,810 --> 00:07:54,370
،إن أكثرت استعمالها

112
00:07:54,370 --> 00:08:00,030
يتوقّف النّاس عن ملاحظتك حتّى
.إن كنت لا تضع التِّيفا في فمك

113
00:08:01,170 --> 00:08:03,880
.قد تموت حتّى

114
00:08:08,750 --> 00:08:10,240
.لا يهمّ

115
00:08:10,240 --> 00:08:12,690
الاختفاء لأنّ أداة غامضة قد استهلكتك

116
00:08:12,690 --> 00:08:15,770
.هي النّهاية الأمثل بالنّسبة للصّ

117
00:08:17,880 --> 00:08:20,210
إلى أين أنت ذاهب أيّها الطّبيب؟

118
00:08:22,110 --> 00:08:24,180
.يا له من حنون

119
00:08:35,670 --> 00:08:38,890
.أيّها الطّبيب، لا تغادر هكذا

120
00:08:38,890 --> 00:08:40,040
.آسف

121
00:08:40,040 --> 00:08:42,590
هل تلاحقه؟

122
00:08:42,590 --> 00:08:45,670
.أجل، لكنّ وجوده يختفي

123
00:08:45,670 --> 00:08:49,300
،إن كان من الصّعب رؤيته بأعيننا
.علينا إذًا أن نستخدم عقولنا لإيجاده

124
00:08:49,300 --> 00:08:52,020
.كان لا يزال يمتلك أدوات أثريّة أخرى معه

125
00:08:52,440 --> 00:08:54,940
.ولا بدّ أنّه سيذهب لمتاجر أخرى لبيعها

126
00:08:54,940 --> 00:08:57,460
أتوجد أيّ متاجر أثريّات في الجوار؟

127
00:08:57,460 --> 00:08:59,960
!فهمت يا كورو. أنت ذكيّ جدًّا

128
00:09:00,500 --> 00:09:03,340
!هناك مختصر عبر تلك الحديقة

129
00:09:12,870 --> 00:09:16,650
إذًا، ما العمل يا جدّتي؟

130
00:09:16,980 --> 00:09:18,610
...لنرَ

131
00:09:19,390 --> 00:09:23,040
.الأدوات الغامضة الخطيرة تغري النّاس

132
00:09:23,040 --> 00:09:25,580
،فلستَ من يستخدمها

133
00:09:25,580 --> 00:09:28,170
.بل هي ما تستخدمك

134
00:09:31,620 --> 00:09:36,080
لمَ لا نرى كيف يتعاملان مع هذا؟

135
00:09:44,760 --> 00:09:46,240
.أنت

136
00:09:47,360 --> 00:09:50,430
.أعطني ذلك الشّيء المعلّق على عنقك

137
00:09:52,940 --> 00:09:54,940
.لا يمكنك أخذ هذه

138
00:09:54,940 --> 00:09:56,890
!كُشف أمرك

139
00:09:56,890 --> 00:09:59,000
كنت تستخدمها لسرقة المتاجر، صحيح؟

140
00:09:59,000 --> 00:10:00,490
!يجب أن تمتنع عن ذلك

141
00:10:00,490 --> 00:10:04,650
أشكّ أنّك تعرف، لكنّ استخدام
.ذلك الشّيء يمحو وجودك تدريجيًّا

142
00:10:04,650 --> 00:10:05,420
—وفي الأخير، سوف

143
00:10:05,590 --> 00:10:07,780
.أعلم

144
00:10:08,960 --> 00:10:11,370
!علمتُ واستخدمتها على كلّ حال

145
00:10:11,370 --> 00:10:13,200
.أنا غبيّ

146
00:10:13,200 --> 00:10:15,260
.قليلًا

147
00:10:15,570 --> 00:10:18,300
!ظننت أنّني سأكون بخير إن استخدمتها قليلًا بعد

148
00:10:19,050 --> 00:10:22,500
!لكنّي بدأت أختفي فعلًا

149
00:10:27,310 --> 00:10:28,310
.اسمع

150
00:10:28,890 --> 00:10:30,820
!ساعدني

151
00:10:32,410 --> 00:10:35,020
.إن كنت تريد أن أنقذك، فسلّمها لي

152
00:10:35,020 --> 00:10:36,530
.حدّد ثمنها

153
00:10:36,530 --> 00:10:39,300
.ماذا؟ لم أقل ذلك

154
00:10:39,300 --> 00:10:42,200
.ماذا؟ كلامك غير منطقيّ

155
00:10:43,950 --> 00:10:46,080
هل استولت الأداة الغامضة على عقله؟

156
00:10:46,430 --> 00:10:48,850
.هربتُ أخيرًا

157
00:10:48,850 --> 00:10:51,330
.لن أسمح بختمي ثانيةً

158
00:10:51,610 --> 00:10:57,340
.عليّ أن أجمّع قوّتي عبر استهلاك وجود البشر

159
00:10:57,750 --> 00:10:59,990
أيمكنني أكلك أيضًا؟

160
00:11:00,990 --> 00:11:05,150
.إن كنت تريده بشدّة، لنتراهن

161
00:11:06,090 --> 00:11:08,640
.الجدّة أيامي، نيكو-ني

162
00:11:08,640 --> 00:11:12,660
.سنمنحك وجود الأشخاص الأربعة هنا

163
00:11:12,660 --> 00:11:15,390
.هذا إن كسبت الرّهان

164
00:11:15,570 --> 00:11:19,440
.أربعة أشخاص؟ عرض لذيذ

165
00:11:19,800 --> 00:11:23,190
.لكن لا بدّ أنّك تريدين شيئًا أيضًا

166
00:11:24,240 --> 00:11:25,650
.بالطّبع

167
00:11:26,190 --> 00:11:29,380
.أوّلًا، أريد زهرة التّيفا خاصّتك

168
00:11:29,730 --> 00:11:34,410
.ثانيًا، أريد منك أن تعيد وجود ذلك الرّجل الّذي استهلكت

169
00:11:34,630 --> 00:11:35,820
أهذا كلّ شيء؟

170
00:11:35,820 --> 00:11:39,180
.بالكاد تبدو كشروط متساوية

171
00:11:39,180 --> 00:11:40,500
.لا بأس يا كورو

172
00:11:41,030 --> 00:11:43,750
.لا تشارك الجدّة إلّا في رهانات تستطيع كسبها

173
00:11:43,750 --> 00:11:47,770
.باعتبار كم أنّ الصّفقة مرضية له، فسيوافق بالتّأكيد

174
00:11:47,770 --> 00:11:49,170
.حسنًا

175
00:11:49,170 --> 00:11:52,200
.لكن، سأقرّر علامَ سنتراهن

176
00:11:52,200 --> 00:11:53,360
.أختار الغمّيضة

177
00:11:54,600 --> 00:11:56,730
.سنلعب في هذه الحديقة

178
00:11:56,730 --> 00:11:59,410
.أوّلًا، ستمهلونني مئة ثانية للاختباء

179
00:11:59,410 --> 00:12:04,870
.ثمّ كلٌّ منكم سيملك دقيقة للبحث عنّي بمجموع أربع دقائق

180
00:12:04,870 --> 00:12:08,900
.إن وجدني أيّ منكم، تكسبون

181
00:12:08,900 --> 00:12:11,120
.وإن لم تستطيعوا، سأكسب أنا

182
00:12:11,570 --> 00:12:14,000
.كلّا. تملك أفضليّة بالغة

183
00:12:14,000 --> 00:12:17,440
.إن كنت لا تقبلين شروطي، فالصّفقة ملغيّة

184
00:12:18,900 --> 00:12:21,110
.حسنًا. لنفعل ذلك

185
00:12:24,330 --> 00:12:27,380
.إذًا تجهّزي لفوزي

186
00:12:29,380 --> 00:12:31,300
.وأنتم أيضًا

187
00:12:31,860 --> 00:12:33,410
وضع علينا علامة بالدّم؟

188
00:12:33,410 --> 00:12:38,890
.الدّم هو ما يربط المشاركين في طقوس سحريّة

189
00:12:38,890 --> 00:12:40,700
.إنّه يمنعنا من الهروب

190
00:12:40,700 --> 00:12:45,470
.ما علينا سوى أن نفعل المثل عندما نجده

191
00:12:52,950 --> 00:12:58,210
هل تعرفون لمَ يُحظر لعب الغمّيضة بعد الغسق؟

192
00:12:58,210 --> 00:13:04,230
.لأنّكم ستختفون عن الوجود فور أن تخسروا أمامي

193
00:13:05,590 --> 00:13:10,180
.لنبدأ لعبة الغمّيضة هذه

194
00:13:13,690 --> 00:13:15,800
.اختفى حقًّا

195
00:13:15,800 --> 00:13:18,220
.ماذا؟ هذا ليس قانونيًّا

196
00:13:18,580 --> 00:13:20,310
.لا يوجد وقت

197
00:13:20,310 --> 00:13:22,210
ما هو ترتيبنا؟

198
00:13:23,300 --> 00:13:25,400
.سأذهب أوّلًا

199
00:13:25,400 --> 00:13:26,230
.كورو

200
00:13:26,480 --> 00:13:29,020
.راموني، أنت ثانيًا

201
00:13:29,020 --> 00:13:30,730
.ثمّ أنا

202
00:13:30,990 --> 00:13:34,810
.لا يمكنني أن أدع ابن حفيدي الظّريف يذهب أوّلًا

203
00:13:35,230 --> 00:13:37,050
.شكرًا لك يا جدّتي

204
00:13:40,360 --> 00:13:41,430
.آسف

205
00:13:41,870 --> 00:13:45,260
.علق الجميع في هذا لأنّني تصرّفتُ دون تفكير

206
00:13:45,950 --> 00:13:47,320
.فات الأوان على ذلك

207
00:13:48,180 --> 00:13:51,500
.لقد اعتدتُ على غرابتك

208
00:13:51,500 --> 00:13:55,020
.لا أدخل في شجارات لا أستطيع الفوز فيها

209
00:13:55,020 --> 00:13:58,520
.أنا متشوّق للعبة الغمّيضة هذه يا رامو-تشان

210
00:13:59,100 --> 00:14:00,910
...رفاق

211
00:14:00,910 --> 00:14:03,480
!إن اختفينا، سنختفي معًا

212
00:14:03,480 --> 00:14:05,070
لمَ تتصرّف بجبن؟

213
00:14:05,070 --> 00:14:06,920
!ألم أقل أنّنا سنفوز؟

214
00:14:10,930 --> 00:14:13,160
.مضت 100 ثانية. سأذهب

215
00:14:13,160 --> 00:14:15,110
!بالتّوفيق يا كورو

216
00:14:15,110 --> 00:14:16,160
.اخرس

217
00:14:16,800 --> 00:14:19,620
.البحث عنه عشوائيًّا مضيعة للوقت

218
00:14:20,160 --> 00:14:23,970
.وفقًا لأسلوب حديثه، إنّه واثق من فوزه

219
00:14:24,350 --> 00:14:29,420
.ما كان شخص بتلك الثّقة أن يختار مكانًا عاديًّا للاختباء

220
00:14:31,300 --> 00:14:34,410
.بل سيختبئ في مكان استفزازيّ

221
00:14:38,300 --> 00:14:39,890
!يا كورو

222
00:14:39,890 --> 00:14:41,140
!كفّ عن اللّهو

223
00:14:41,140 --> 00:14:43,270
.ثمّة الكثير من ألعاب الحديقة هنا

224
00:14:43,270 --> 00:14:46,350
.إنّه يبحث في كلّ الأماكن المرهقة أوّلًا

225
00:14:46,350 --> 00:14:47,700
.فهمت

226
00:14:48,010 --> 00:14:50,230
.ظننت أنّه يستمتع فحسب

227
00:14:54,590 --> 00:14:55,990
.أيّها الطّبيب، دورك

228
00:14:55,990 --> 00:14:56,710
.حسنًا

229
00:14:57,480 --> 00:14:59,950
.أنا من ورّط الجميع في هذه المعمعة

230
00:14:59,950 --> 00:15:05,240
!ينبغي أن أكون من يجده

231
00:15:09,190 --> 00:15:10,840
.آسف أيّتها الجدّة

232
00:15:10,840 --> 00:15:11,990
!ماذا تفعل أيّها العجوز؟

233
00:15:11,990 --> 00:15:14,980
.من الصّعب حقًّا الرّكض لدقيقة

234
00:15:15,410 --> 00:15:16,810
.لا يهمّ

235
00:15:16,810 --> 00:15:20,220
.لم أتوقّع منكما أن تجداه

236
00:15:20,990 --> 00:15:22,220
ألم أخبركم؟

237
00:15:22,220 --> 00:15:25,220
.لا أشارك في شجار لا أستطيع الفوز فيه

238
00:15:25,520 --> 00:15:27,420
...أليست

239
00:15:27,420 --> 00:15:28,740
.شبكة الثّعلب

240
00:15:28,740 --> 00:15:31,340
عبر النّظر خلالها، تخوّل لك رؤية

241
00:15:31,340 --> 00:15:34,720
".كلّ الأشياء غير البشريّة، سواء كانت ثعالب شيطانيّة أو "الغموض

242
00:15:35,700 --> 00:15:39,360
لا يوجد قانون يمنع استخدام
.الأدوات الغامضة في الغمّيضة

243
00:15:39,360 --> 00:15:42,640
.توقّعت حدوث هذا

244
00:15:42,640 --> 00:15:43,870
.لكن لن يفلح

245
00:15:44,150 --> 00:15:47,600
.إن ظنّت أنّنا سنفوز هكذا، فسنخسر

246
00:16:00,780 --> 00:16:01,940
لماذا؟

247
00:16:02,350 --> 00:16:04,870
لمَ لا أرى أيّ شيء؟

248
00:16:06,350 --> 00:16:08,290
لمَ سنخسر؟

249
00:16:08,290 --> 00:16:11,020
.لأنّ من يختبئ إنسان

250
00:16:11,020 --> 00:16:14,080
.لذا لن تظهر شبكة الثّعلب أيّ شيء

251
00:16:14,350 --> 00:16:17,360
!ماذا سنفعل أيّتها الجدّة؟

252
00:16:19,850 --> 00:16:21,000
.أيّها الطّبيب

253
00:16:37,990 --> 00:16:42,010
!فزت. فزت. فزت

254
00:16:42,240 --> 00:16:43,640
...بقي فقط

255
00:16:48,020 --> 00:16:49,390
.أنا آسفة

256
00:16:49,390 --> 00:16:51,490
.لم أستطع إيجاده

257
00:16:54,280 --> 00:16:56,560
لديك هدف آخر، أليس كذلك؟

258
00:17:02,010 --> 00:17:05,410
.هذا تفكير حاذق ومفاجئ منك يا راموني

259
00:17:05,410 --> 00:17:08,770
.أجل... أظنّ ذلك

260
00:17:09,840 --> 00:17:12,080
لم أفكّر أنّه يمكن لشخص مطّلع كثيرًا

261
00:17:12,080 --> 00:17:14,440
.على الأدوات الغامضة أن يقترف مثل ذلك الخطأ

262
00:17:14,440 --> 00:17:17,210
.فهمت. كان أنت إذًا

263
00:17:17,740 --> 00:17:21,680
.أردتُ أن أجهر بالأمر

264
00:17:22,130 --> 00:17:23,960
.فهمت

265
00:17:24,690 --> 00:17:26,070
.نيكو-ني

266
00:17:27,710 --> 00:17:29,820
.اعتمدوا عليّ

267
00:17:29,820 --> 00:17:32,730
.نيكو-ني، أنت لها

268
00:17:32,730 --> 00:17:35,890
.اخرس. لن يستطيع سماعها

269
00:17:35,890 --> 00:17:37,250
سماعها؟

270
00:17:37,250 --> 00:17:40,830
.ترتفع دّقات قلبك عندما تشعر بالحماس

271
00:17:40,830 --> 00:17:46,390
.بعد أن رأى فشل استراتيجيّتي، بات متيقّنًا من فوزه

272
00:17:46,390 --> 00:17:49,330
.جعلتُ صوت دقّات قلبه مسموعة أكثر

273
00:17:49,580 --> 00:17:51,830
—لكن كيف سيساعدنا ذلك على إيجاد

274
00:17:57,290 --> 00:17:59,340
.نيكو-ني كفيف

275
00:17:59,550 --> 00:18:00,460
ماذا؟

276
00:18:00,460 --> 00:18:04,720
.إنّه يرى بكلّ حواسه الأخرى

277
00:18:04,960 --> 00:18:08,730
.يستعين بالصّدى لتحديد مكان ومسافة الأشياء من حوله

278
00:18:08,730 --> 00:18:12,370
.كما يمكنه تحديد ماهيتها بدقّة بمجرّد لمسها

279
00:18:12,370 --> 00:18:14,850
.حاسّة شمّه وتذوّقه ممتازتان أيضًا

280
00:18:14,850 --> 00:18:17,220
".ليس ذلك فحسب، بل ويستطيع حتّى رصد "الغموض

281
00:18:17,220 --> 00:18:20,370
.حواسّ نيكو-ني تفوق مستوى البشر

282
00:18:21,290 --> 00:18:25,590
.إنّه كفيف، لكنّه "يُبصر" أفضل من الجميع

283
00:18:26,160 --> 00:18:29,510
.دقّة قلب أسرع من الأخريات

284
00:18:29,510 --> 00:18:31,010
.إنّه قريب

285
00:18:33,880 --> 00:18:36,340
...هذه هي

286
00:18:47,170 --> 00:18:48,350
.وجدتك

287
00:18:53,660 --> 00:18:56,150
!هذا مستحيل

288
00:19:08,240 --> 00:19:09,980
!نيكو-ني، أحسنت

289
00:19:09,980 --> 00:19:12,260
.لا أصدّق أنّه كان مختبئًا بهذا القرب

290
00:19:12,260 --> 00:19:14,920
.مبهر كالعادة يا نيكو. شكرًا لك

291
00:19:14,920 --> 00:19:17,750
.لا، بل الفضل يعزو لكم جميعًا

292
00:19:17,750 --> 00:19:22,190
.ضُيّقت منطقة بحثي لأنّ كورو-كن ركض كثيرًا

293
00:19:22,520 --> 00:19:25,590
.وجعلت جدّتي إيجاده أسهل عبر الصّوت

294
00:19:26,550 --> 00:19:27,900
،نيكو-ني

295
00:19:28,590 --> 00:19:29,620
ماذا عنّي؟

296
00:19:29,620 --> 00:19:31,920
.شكرًا لأجل دعمك المعنويّ

297
00:19:33,150 --> 00:19:34,650
.والآن

298
00:19:36,570 --> 00:19:38,770
.كسبتُ رهاننا

299
00:19:46,710 --> 00:19:51,070
.حان الوقت لإرجاع وجود ذلك الرّجل

300
00:19:58,660 --> 00:19:59,990
.خذ. هذه لك

301
00:20:00,430 --> 00:20:01,980
!شكرًا أيّتها الجدّة

302
00:20:01,980 --> 00:20:03,050
.لا مشكلة

303
00:20:03,050 --> 00:20:06,000
.سأرسل لك فاتورة كبيرة على كلّ المتاعب الّتي تسبّبتها

304
00:20:06,690 --> 00:20:10,350
كم حسبتِ بالضّبط هذه المرّة؟

305
00:20:10,620 --> 00:20:12,420
.كلّ شيء، بالطّبع

306
00:20:12,420 --> 00:20:14,480
اجعل خصمك يعتقد أنّه يملك الأفضليّة

307
00:20:14,480 --> 00:20:16,880
.ثمّ استدرجه إلى وضع فيه أفضليّة لك

308
00:20:16,880 --> 00:20:18,860
.إنّه تكتيك معياريّ في التّفاوض

309
00:20:18,860 --> 00:20:21,760
إنّها حيّة لـ112 سنة إذًا؟

310
00:20:22,160 --> 00:20:25,610
.لا يمكن لشقيّ عشوائيّ أن يهزمها

311
00:20:26,100 --> 00:20:27,650
.لنعد للبيت

312
00:20:27,650 --> 00:20:30,130
.بما أنّنا بذلنا مجهودًا كبيرًا، دعنا نتوقّف عند حمّام عموميّ

313
00:20:30,410 --> 00:20:33,400
.نيكو-ني، أعرني بعض الثّياب

314
00:20:33,400 --> 00:20:35,450
أكيد. كورو-كن؟

315
00:20:35,450 --> 00:20:36,820
.أجل، رجاءً

316
00:20:39,630 --> 00:20:41,230
.أنا في الإعداديّة

317
00:20:41,230 --> 00:20:45,060
.آسف. لم أقصد أيّ تقليل

318
00:20:45,240 --> 00:20:46,100
...معذرةً

319
00:20:46,920 --> 00:20:49,310
هل ستكون ثيابي على مقاسك؟

320
00:20:49,580 --> 00:20:52,980
قد تناسب ثياب جدّتي مقاسك أكثر؟

321
00:20:55,130 --> 00:20:56,610
أجل، لمَ لا نفعل ذلك؟

322
00:20:56,610 --> 00:20:59,010
.استعر شيئًا مكشكشًا

323
00:20:59,740 --> 00:21:01,260
!مؤلم

324
00:21:03,000 --> 00:21:06,500
.إلى اللّقاء أيّتها الجدّة ونيكو-ني

325
00:21:06,500 --> 00:21:10,230
.آسف على كلّ المتاعب الّتي تسبّبها

326
00:21:10,570 --> 00:21:11,690
.أراكما لاحقًا

327
00:21:15,190 --> 00:21:17,780
.ما زال راموني يملك الكثير لتعلّمه

328
00:21:17,780 --> 00:21:20,430
.لا يشبه معلّمه السّاديّ

329
00:21:21,240 --> 00:21:25,490
.لكنّه يتمتّع بالإمكانات

330
00:21:26,360 --> 00:21:28,830
.أنا عبقريّ

331
00:21:28,830 --> 00:21:32,450
،إن استخدمنا زهرة التّيفا هذه
.بإمكاننا الدّخول لحمّام النّساء كما نشاء

332
00:21:32,450 --> 00:21:35,190
.آمل أن تختفي مع بقيّة الفقاعات

333
00:21:35,190 --> 00:21:36,020
ماذا؟

334
00:23:26,220 --> 00:23:29,240
.أيّها الطّبيب، تحوّلت أطراف أصابع مريضنا إلى فلفل حارّ

335
00:23:29,240 --> 00:23:32,760
.ماذا؟ إذًا بإمكاننا إعداد كلّ المابو توفو الّذي نريد

336
00:23:32,760 --> 00:23:34,010
.ستدفعني للجنون

337
00:23:34,440 --> 00:23:35,780
".-الدّكتور راموني -أخصّائيّ الأمراض الغامضة"

338
00:23:35,780 --> 00:23:38,860
".الحلقة 4، "أطراف أصابع الفلفل الحارّ