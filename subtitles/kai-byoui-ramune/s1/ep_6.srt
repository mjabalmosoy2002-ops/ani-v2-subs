1
00:00:00,750 --> 00:00:02,960
تحوّلت أذناك إلى جياوزو؟

2
00:00:03,970 --> 00:00:10,180
.إنّها تهلوس طفلها من أجل أن تحمي نفسها من حقيقة مؤلمة

3
00:00:10,680 --> 00:00:11,760
—يو-كن

4
00:00:11,760 --> 00:00:14,180
المعذرة، لكن مع من تتحدّثين؟

5
00:00:16,160 --> 00:00:22,450
،عليّ أن أعالجها في النّهاية
.لم يعد إلى البيت لأسبوع بسببي

6
00:00:23,210 --> 00:00:24,960
.لؤلؤة أصوات اللّيل

7
00:00:26,720 --> 00:00:32,470
.بينما تتحدّث إلى أمّك عبر هذه، سيختفي صوتك

8
00:00:34,380 --> 00:00:39,470
.بمعنى آخر، طريقة العلاج هذه تقايضك بذلك

9
00:00:55,460 --> 00:00:59,440
!أيّها الدّكتور

10
00:01:05,020 --> 00:01:09,490
.بسببي، مات الدّكتور

11
00:01:10,420 --> 00:01:11,690
.أنت

12
00:01:13,170 --> 00:01:15,590
.لا تفترض أنّي ميّت

13
00:01:15,590 --> 00:01:17,590
أيّها الدّكتور، هل أنت بخير؟

14
00:01:17,590 --> 00:01:20,530
.أجل، أنا معتاد على الضّرب

15
00:01:20,530 --> 00:01:22,630
.هذا لا يعدّ شيئًا

16
00:01:22,630 --> 00:01:23,610
ماذا؟

17
00:01:23,610 --> 00:01:26,120
.على أيّ حال، هذا ليس جيّدًا

18
00:01:26,120 --> 00:01:28,380
.لن نستطيع التسلّق إلى الأعلى

19
00:03:17,120 --> 00:03:19,960
هل تشعر بالبرد أيّها الدّكتور؟

20
00:03:21,270 --> 00:03:24,210
.أنا بخير. لا تقلق بشأني. نَم فحسب

21
00:03:26,400 --> 00:03:29,350
.أنا قلق جدًّا على أمّي ولا أستطيع النّوم

22
00:03:29,770 --> 00:03:32,980
صحيح. ماذا حدث لأمّك؟

23
00:03:35,770 --> 00:03:38,480
.نمى الجياوزو على أذنيها ثانيةً

24
00:03:38,830 --> 00:03:41,340
.وهي تحجب نصف أذنيها تقريبًا

25
00:03:41,910 --> 00:03:45,110
.أتساءل ما سيحلّ بها

26
00:03:47,910 --> 00:03:49,780
.هناك احتمالين فقط

27
00:03:52,610 --> 00:03:57,240
إمّا أن تنمو الجياوزو لدرجة أن تسدّ فتحتَي أذنيها تمامًا

28
00:03:57,850 --> 00:04:01,120
—أو ستنصت للأصوات الّتي كان يفترض أن تسمعها

29
00:04:01,120 --> 00:04:03,170
.أي الّتي غُلّفت من قبل الجياوزو—وتتعافى

30
00:04:05,000 --> 00:04:07,860
ماذا تريد أمّك برأيك؟

31
00:04:10,290 --> 00:04:14,770
.أظنّها ستختار أن تفقد قدرة سمعها على الأغلب

32
00:04:15,610 --> 00:04:17,680
.أوافقك

33
00:04:20,060 --> 00:04:24,810
.لكن ذلك فقط إلّم يكن هناك شيء في كفّة الميزان

34
00:04:25,280 --> 00:04:28,000
!ريو

35
00:04:30,480 --> 00:04:36,270
أفهم ما تعنيه عندما تتحدّث
.عن وضع شيء على كفّة الميزان

36
00:04:37,320 --> 00:04:42,930
أريد أن أعالج أمّي، لكنّي لم أستطع
.استخدام هذه من شدّة خوفي

37
00:04:44,170 --> 00:04:46,660
ما الّذي يخيفك؟

38
00:04:48,080 --> 00:04:51,250
.إنّه خطئي

39
00:04:51,250 --> 00:04:53,210
.لقد اختفى أخي بسببي

40
00:04:53,210 --> 00:04:55,180
.ومرضت أمّي بسببي

41
00:04:55,690 --> 00:04:59,950
صوتي هو الوحيد الّذي لا تستطيع
!سماعه بتاتًا لأنّها لا تريد سماعه

42
00:05:00,320 --> 00:05:03,010
.أمّي تكرهني

43
00:05:03,010 --> 00:05:05,150
...حتّى إن عنى ذلك أنّ أذنيها لن تتعالج

44
00:05:05,880 --> 00:05:10,060
.كنت خائفًا من ذلك ولم أستطع استخدامها

45
00:05:14,390 --> 00:05:15,360
.اسمع يا فتى

46
00:05:16,140 --> 00:05:18,370
.أنت تقلق أكثر من اللّازم

47
00:05:20,180 --> 00:05:23,300
من بين كلّ ما يقلقك، أيّها تريد أن تصلح أوّلًا؟

48
00:05:25,800 --> 00:05:28,260
.أريد أن تتعافى أمّي

49
00:05:29,130 --> 00:05:32,360
.حسنًا. تعي ما هو مهمّ

50
00:05:32,840 --> 00:05:37,530
.أنا دكتور عظيم، وقد أخبرتك أنّ هذه طريقة العلاج الأفضل

51
00:05:38,090 --> 00:05:39,880
فما الّذي يخيفك؟

52
00:05:43,440 --> 00:05:46,780
.لا تدع القلق يتمكّن منك فتغفل عمّا هو مهمّ

53
00:05:47,700 --> 00:05:50,680
.إن كنت تريد حلّ مشكلة، عليك مواجهتها

54
00:05:51,660 --> 00:05:52,940
...مواجهتها

55
00:05:53,620 --> 00:05:55,950
.وأيضًا، أنا آسف

56
00:05:56,770 --> 00:05:59,630
.سأنال بعض النّوم

57
00:05:59,980 --> 00:06:02,910
.لكن أعد أنّني سأحميك

58
00:06:09,000 --> 00:06:11,400
!أيّها الدّكتور! دكتور

59
00:06:19,060 --> 00:06:22,010
.لا بدّ أنّه كان خائفًا من أن يسقط أو يتأذّى

60
00:06:22,500 --> 00:06:24,840
.لكنّه حماني طوال هذا الوقت

61
00:06:31,760 --> 00:06:35,360
!أمّي! أمّي، هل تستطيعين سماعي؟

62
00:06:35,650 --> 00:06:38,510
!أمّي! أمّي

63
00:07:03,750 --> 00:07:05,140
.المعذرة

64
00:07:08,650 --> 00:07:09,710
أيّها الدّكتور؟

65
00:07:11,880 --> 00:07:13,920
هل ترك الأنوار مفتوحة؟

66
00:07:23,850 --> 00:07:25,180
.إنّه بارد

67
00:07:28,840 --> 00:07:31,190
.لم يشترِ حليبًا جديدًا

68
00:07:31,880 --> 00:07:35,550
...وما زال الكوب الّذي وضعه البارحة هنا، ما يعني

69
00:07:36,020 --> 00:07:38,310
لم يعد منذ ليلة أمس؟

70
00:07:50,110 --> 00:07:51,430
ما العمل؟

71
00:07:51,430 --> 00:07:53,810
...ريو. ريو

72
00:07:54,550 --> 00:07:55,690
.المعذرة

73
00:07:55,690 --> 00:07:59,110
.كان مدخل البيت مكتظًّا، لذا أتيت من هذا الاتّجاه

74
00:07:59,110 --> 00:08:00,700
هل الدّكتور هنا؟

75
00:08:00,990 --> 00:08:04,170
!أنت... كنت في الضّريح

76
00:08:04,170 --> 00:08:05,630
!هل تعرف أين هو ريو؟

77
00:08:05,840 --> 00:08:07,070
ريو-كن؟

78
00:08:07,070 --> 00:08:09,210
!إنّه مختفٍ منذ البارحة

79
00:08:09,630 --> 00:08:11,350
.المعذرة. سأدخل

80
00:08:11,730 --> 00:08:15,400
،قصد الدّكتور المجيء إلى هنا رفقة ريو-كن لتفقّد حالتك

81
00:08:15,400 --> 00:08:18,600
لكنّه لم يأت، أليس كذلك؟

82
00:08:18,800 --> 00:08:22,340
.لا، لكن إن كان مع الدّكتور، فهو معه أينما كان

83
00:08:22,540 --> 00:08:25,890
.مع الأسف، لا أدري أين هو الدّكتور أيضًا

84
00:08:25,890 --> 00:08:26,850
...لا

85
00:08:32,860 --> 00:08:33,350
ماذا؟

86
00:08:33,840 --> 00:08:35,940
ماذا قد يفعل الدّكتور؟

87
00:08:37,980 --> 00:08:39,990
هل لديك لؤلؤة أصوات اللّيل؟

88
00:08:40,390 --> 00:08:42,780
لؤلؤة أصوات اللّيل؟

89
00:08:42,780 --> 00:08:44,570
.إنّها محّارة بها لؤلؤة

90
00:08:44,790 --> 00:08:48,190
هل كان لدى ريو-كن كيس ورقيّ أو علبة؟

91
00:08:48,640 --> 00:08:50,400
.ربّما يقصد ذلك

92
00:08:55,120 --> 00:08:56,550
.عرفتها

93
00:08:59,120 --> 00:09:00,860
ما الّذي يجري؟

94
00:09:01,950 --> 00:09:08,800
.نمت اللّؤلؤة، ما يعني أنّ ريو-كن كان يتحدّث إليك

95
00:09:08,800 --> 00:09:11,180
إذًا هل ريو بخير؟

96
00:09:11,480 --> 00:09:13,240
.ما زال الخطر قائمًا

97
00:09:13,590 --> 00:09:18,830
.نموّ اللّؤلؤة يشير أيضًا إلى أنّ صوت ريو-كن يختفي

98
00:09:19,090 --> 00:09:21,920
،إلّم نسرع، سيختفي صوته تمامًا

99
00:09:21,920 --> 00:09:24,270
.ولن نملك طريقة لإيجاده

100
00:09:24,810 --> 00:09:29,960
.إنّها مسألة وقت فحسب باعتبار أنّ حياته في خطر

101
00:09:31,010 --> 00:09:33,700
لا تستطيعين سماع صوت ريو، صحيح؟

102
00:09:33,700 --> 00:09:35,180
.سأستمع له بدلًا عنك

103
00:09:35,180 --> 00:09:36,160
.لا تستطيع

104
00:09:37,310 --> 00:09:41,630
قال الدّكتور أنّه يمكن استخدامها من
.قبل رجل وامرأة يحبّان بعضهما فحسب

105
00:09:42,160 --> 00:09:46,170
.فقط أمّه تستطيع سماع صوت ريو-كن

106
00:09:48,180 --> 00:09:51,880
فور أن تسمعي الأصوات الّتي يفترض بك سماعها

107
00:09:51,880 --> 00:09:55,780
.لكنّ الجياوزو كانت تحجبها، حينها ستُزال

108
00:09:56,070 --> 00:09:59,480
.وستستطيعين سماع صوت ريو ثانيةً

109
00:10:04,670 --> 00:10:06,030
ما هذا الشّعور؟

110
00:10:06,500 --> 00:10:08,620
،أشعر أنّني إن سمعتُ صوت ريو

111
00:10:08,620 --> 00:10:13,630
.حينها لن يرجع "شيء" إلى البيت أبدًا

112
00:10:16,160 --> 00:10:18,490
.نمت اللّؤلؤة ثانيةً

113
00:10:18,490 --> 00:10:19,770
...لا

114
00:10:19,770 --> 00:10:20,500
!ريو

115
00:10:21,310 --> 00:10:24,330
.لكن الآن... في هذه اللّحظة، عليّ سماع صوت ريو

116
00:10:24,780 --> 00:10:26,860
.رجاءً، دعيني أسمعه

117
00:10:27,790 --> 00:10:30,380
.لست بحاجة لحجب أيّ شيء

118
00:10:30,380 --> 00:10:32,280
!أريد سماع صوت ريو

119
00:10:35,800 --> 00:10:40,230
أيمكنك إخبارنا بشأن اختطاف وقتل يو-كن؟

120
00:10:40,540 --> 00:10:41,400
ماذا؟

121
00:10:41,400 --> 00:10:44,890
.يبدو أنّهم عثروا على ذراعه المبتورة عند مدخل بيتهم

122
00:10:44,890 --> 00:10:46,370
نعتقد أنّه ترك البيت لوحده

123
00:10:46,370 --> 00:10:49,420
.واختُطف من قبل أحدهم بينما كان في الخارج

124
00:10:49,730 --> 00:10:51,830
ما هذا؟

125
00:10:52,430 --> 00:10:56,200
.بقدر ما نكره الاستسلام، الوضع مريع

126
00:10:56,200 --> 00:10:58,750
.آمل أن يجدوا يو-كن قريبًا

127
00:10:57,540 --> 00:11:00,920
...لا... لا... لا

128
00:10:58,750 --> 00:11:00,920
...بشأن احتمال نجاة يو-كن

129
00:11:01,200 --> 00:11:03,920
!لا! لا أريد سماع هذا

130
00:11:04,620 --> 00:11:05,440
.لا فائدة

131
00:11:05,760 --> 00:11:07,360
.الجياوزو تنغلق

132
00:11:07,670 --> 00:11:11,200
.القليل بعد وسيختفي صوت ريو-كن

133
00:11:11,700 --> 00:11:13,680
...أمّي

134
00:11:14,660 --> 00:11:16,630
...صوتي

135
00:11:17,260 --> 00:11:18,660
...الدّكتور

136
00:11:20,020 --> 00:11:21,840
!أصغي له رجاءً

137
00:11:23,430 --> 00:11:26,190
!وحدك تستطيعين سماع صوت ريو

138
00:11:27,040 --> 00:11:28,240
...ريو

139
00:11:30,370 --> 00:11:34,490
!عليّ أن أنصت لصوت ريو

140
00:11:36,500 --> 00:11:39,620
.تطابق الحمض النّوويّ مع حمض يو-كن

141
00:11:39,950 --> 00:11:44,870
ما زالت الشّرطة لم تعثر على أدلّة
.عن هويّة أو أهداف المختطِف

142
00:11:44,870 --> 00:11:46,830
.أخبرينا عن يوم الحادث

143
00:11:46,830 --> 00:11:48,610
.قد يساعدنا ذلك على حلّ القضيّة

144
00:11:48,610 --> 00:11:52,630
.يبدو أنّ الزّوجة تهلوس بشأن يو-كن

145
00:11:54,300 --> 00:11:56,090
!يو، هل أنت بخير؟

146
00:11:56,090 --> 00:11:57,190
!هل سُكب عليك؟

147
00:11:57,190 --> 00:12:00,210
المعذرة، لكن مع من تتحدّثين؟

148
00:12:04,240 --> 00:12:05,710
...يو

149
00:12:05,710 --> 00:12:06,690
.هذا صحيح

150
00:12:07,700 --> 00:12:09,210
...يو لن يعود

151
00:12:25,980 --> 00:12:28,590
...نُزعت الجياوزو. ما يعني

152
00:12:28,590 --> 00:12:31,090
...أمّي... أمّي

153
00:12:31,700 --> 00:12:33,600
ريو؟ أهذا أنت يا ريو؟

154
00:12:34,170 --> 00:12:36,480
أمّي، أيمكنك سماعي؟

155
00:12:36,480 --> 00:12:38,600
.أسمعك. يمكنني سماعك

156
00:12:38,970 --> 00:12:42,170
أنت بخير. أين أنت؟

157
00:12:42,570 --> 00:12:46,610
ماذا؟ الغابة؟ هل أنت مع الدّكتور؟

158
00:12:46,960 --> 00:12:48,160
!سقطتما؟

159
00:12:50,300 --> 00:12:52,340
!ماذا؟ مهلًا

160
00:12:52,930 --> 00:12:57,420
.ثمّة نقطة في الطّريق تطلّ على الغابة بين الضّريح وهنا

161
00:12:57,750 --> 00:12:59,470
.إنّهما هناك على الأغلب

162
00:13:01,060 --> 00:13:02,220
.سأستعير هذا

163
00:13:02,220 --> 00:13:04,420
.سأترك لكما أثرًا لتتبعاه

164
00:13:04,760 --> 00:13:06,510
.استدعيا المساعدة على الفور

165
00:13:06,510 --> 00:13:08,670
.سأذهب لإيجادهما

166
00:13:26,510 --> 00:13:28,760
.هناك علامات تدلّ أنّ أشخاصًا دخلوا من هنا

167
00:13:59,310 --> 00:14:01,440
!أيّها الدّكتور! ريو-كن

168
00:14:08,370 --> 00:14:09,570
!سآتي على الفور

169
00:14:15,470 --> 00:14:16,370
!دكتور

170
00:14:17,110 --> 00:14:19,560
.أيّها الدّكتور، استيقظ

171
00:14:23,370 --> 00:14:24,180
.أهلًا

172
00:14:26,600 --> 00:14:28,400
هل أنت بخير لتجلس؟

173
00:14:29,560 --> 00:14:32,570
...أنا بالكاد بخير. مؤلم

174
00:14:32,570 --> 00:14:36,070
.سأؤدّي الإسعافات الأوّليّة الّتي أستطيع حتّى وصول المساعدة

175
00:14:38,780 --> 00:14:41,310
.لا يبدو أنّ هناك جراح ظاهرة على ريو-كن

176
00:14:41,610 --> 00:14:45,840
...ساعده مِمطَره على التّقليل من آثار انخفاض الحرارة، لكن

177
00:14:47,780 --> 00:14:48,830
ماذا؟

178
00:14:49,160 --> 00:14:52,290
.أيّها الدّكتور، سوف تستهلك ثيابك المبلّلة دفأك

179
00:14:53,420 --> 00:14:55,400
.سأعيرك ثيابي. انزع تلك

180
00:14:55,400 --> 00:14:58,300
.ماذا؟ أنا بخير

181
00:14:58,300 --> 00:14:59,960
استدعيت المساعدة، صحيح؟

182
00:14:59,960 --> 00:15:01,790
.ذلك أفضل من لا شيء

183
00:15:01,110 --> 00:15:03,570
.لا، صدقًا. أنا بخير

184
00:15:03,570 --> 00:15:05,160
لمَ أنت معارض هكذا؟

185
00:15:03,710 --> 00:15:05,160
—أنت، كفّ عن سحب

186
00:15:09,570 --> 00:15:11,800
كورو-سان؟

187
00:15:15,310 --> 00:15:21,570
أودّ أن ألكمك، لكن أظنّ أنّ ذلك
.سيقتلك، لذا سأعفو عنك هذه المرّة

188
00:15:22,100 --> 00:15:24,810
...على أيّ حال! بما أنّك هنا، ألا يعني أنّ

189
00:15:25,230 --> 00:15:28,100
.زالت الجياوزو عن أذنَيّ أمّك

190
00:15:28,100 --> 00:15:30,570
.وصلك صوتها

191
00:15:32,900 --> 00:15:34,660
.هذا عظيم يا ريو

192
00:15:37,470 --> 00:15:40,730
!حسنًا، حسنًا! وقت مستقطع

193
00:15:44,870 --> 00:15:46,450
.يبدو أنّ المساعدة وصلت

194
00:15:46,450 --> 00:15:47,840
.سأبلغهم عن مكانكما

195
00:15:48,260 --> 00:15:49,340
.رجاءً

196
00:16:00,110 --> 00:16:00,860
!ريو

197
00:16:05,910 --> 00:16:06,970
...صوته

198
00:16:08,250 --> 00:16:10,260
.أنا آسفة يا ريو

199
00:16:10,770 --> 00:16:13,220
.آسفة لأنّي لم ألحظ أبكر

200
00:16:14,220 --> 00:16:17,870
.لكنّي مسرورة حقًّا لأنّك بخير

201
00:16:40,160 --> 00:16:41,720
.يا كورو

202
00:16:45,720 --> 00:16:47,350
.شكرًا على إحضارك ملابس للتّغيير

203
00:16:48,860 --> 00:16:51,690
ماذا؟ هل أنت غاضب؟ لماذا؟

204
00:16:51,690 --> 00:16:55,060
ما رأيك أن تبحث في داخلك عن إجابة ذلك السّؤال؟

205
00:16:55,060 --> 00:16:58,100
.أو بالأحرى، من حول خصرك

206
00:17:02,160 --> 00:17:06,520
.كان معك نظرة شوجي وموكي خاصّتك

207
00:17:07,070 --> 00:17:09,370
،لو أنّك استخدمتهما كما فعلت ذلك اليوم

208
00:17:10,360 --> 00:17:13,340
!لأمكن إنقاذك على الفور

209
00:17:14,340 --> 00:17:16,820
.لا، الأمر ليس كما تظنّ

210
00:17:16,820 --> 00:17:21,100
.لو كان ريو في خطر كبير، لاستعملتهما على الفور

211
00:17:21,480 --> 00:17:25,740
لكن عندما أرى فرصة لعلاج أحد أمام
.عينيّ، ينتهي بي المطاف أختار ذلك

212
00:17:26,090 --> 00:17:30,440
.أعطيت الأولويّة لصحّة ريو الجسديّة حقًّا

213
00:17:30,440 --> 00:17:33,390
—لا أريدك أن تفكّر أنّني عرضّته للخطر أو

214
00:17:33,390 --> 00:17:35,110
!لستُ أتحدّث عن ريو-كن

215
00:17:39,880 --> 00:17:43,110
.آسف

216
00:17:43,110 --> 00:17:45,370
.يبدو أنّني أقلقتك

217
00:17:45,640 --> 00:17:51,420
انخفاض حرارة الجسم وفقدان الدّم
.وكدمات وكسر في الكاحل الأيسر

218
00:17:51,420 --> 00:17:53,880
.قال الطّبيب أنّك كنت لتموت إن كنّا في الشّتاء

219
00:17:55,170 --> 00:17:56,800
.آسف

220
00:17:56,800 --> 00:17:57,890
...وأيضًا

221
00:17:58,310 --> 00:18:00,340
.ثمّة ما أريد أن أسألك عنه

222
00:18:00,930 --> 00:18:02,970
.وجدت هذه في غرفة استشارتك

223
00:18:02,970 --> 00:18:06,230
كتبت هذا، أليس كذلك؟

224
00:18:06,230 --> 00:18:08,600
...ذلك

225
00:18:08,870 --> 00:18:12,330
.أودّ منك أن تشرح لي ما يعنيه هذا بالضّبط

226
00:18:12,620 --> 00:18:18,040
من أجل علاج ريو، حصلت على
.إذن والده من أجل بعض الأشياء

227
00:18:18,040 --> 00:18:24,740
قصدتُ فعل ذلك بطريقة آمنة
.ومنظّمة، لكن حدثت تلك الحادثة

228
00:18:25,120 --> 00:18:29,160
.غير معقول. طرقك مريعة حقًّا ولا يمكن تبريرها

229
00:18:29,160 --> 00:18:30,010
!ماذا؟

230
00:18:30,280 --> 00:18:34,510
.بالمناسبة، أصبحت مشتبهًا بك بالاختطاف بعد هذا الحادث

231
00:18:34,510 --> 00:18:36,250
!اختطاف؟

232
00:18:41,180 --> 00:18:45,390
!لا! كورو، لا تتخلّ عنّي

233
00:18:45,860 --> 00:18:49,860
،سيكون من الجيّد لو أمكن ريو-كن أن يشهَد أنّك لم تختطفه

234
00:18:49,860 --> 00:18:51,440
.لكنّه لا يستطيع الكلام

235
00:18:51,860 --> 00:18:52,800
!صحيح

236
00:19:02,110 --> 00:19:05,110
مرحبًا يا ريو. كيف حالك؟

237
00:19:09,200 --> 00:19:12,250
.فهمت. أنا مسرور لأنّك بخير

238
00:19:12,560 --> 00:19:14,800
.بفضلك، لم يتأذّ حتّى

239
00:19:14,800 --> 00:19:16,940
كيف حالك أيّها الدّكتور؟

240
00:19:16,940 --> 00:19:20,890
.أنا محظوظ لأنّني تكبّدتُ بعض الخدوش فحسب

241
00:19:21,550 --> 00:19:22,840
.كاذب

242
00:19:24,430 --> 00:19:27,390
.هذه لؤلؤة أصوات اللّيل الّتي استخدمها ريو

243
00:19:27,790 --> 00:19:33,620
يفترض أن تتبادلا اللّؤلؤتين اللّتين
...رعيتماها بصوتكما وتأكلاهما، لكن

244
00:19:35,120 --> 00:19:39,160
.ريو نفسه سيأكل اللّؤلؤة الّتي رعاها بصوته

245
00:19:46,860 --> 00:19:50,120
.فور أن تذوب تلك اللّؤلؤة تمامًا، سيعود صوتك

246
00:19:51,890 --> 00:19:55,490
.يمكن أن تذوب اللّؤلؤة بالحديث مع بعضكما مباشرة

247
00:19:55,490 --> 00:19:59,430
.أي أنّ عليكما أن تتحدّثا كثيرًا

248
00:19:59,760 --> 00:20:02,330
يمكنني الحديث مع أمّي؟

249
00:20:04,090 --> 00:20:06,710
.آمل أن يتحسّن حال أمّي

250
00:20:07,070 --> 00:20:10,300
.أتساءل إن كان بإمكاني الحديث معها ثانيةً

251
00:20:14,160 --> 00:20:15,500
.شكرًا لك

252
00:20:16,660 --> 00:20:19,520
.العفو

253
00:20:25,980 --> 00:20:26,840
.خذ

254
00:20:26,840 --> 00:20:27,580
.شكرًا

255
00:20:28,360 --> 00:20:33,160
،هذا ما نويت فعله من البداية
وإن فقد ريو-كن صوته، صحيح؟

256
00:20:33,420 --> 00:20:34,740
.أيّها الغبيّ

257
00:20:34,740 --> 00:20:36,470
،لو أنّ أذنيها لم تتحسّنا

258
00:20:36,470 --> 00:20:39,420
.لن يستطيعا الحديث، ولهذا يحتاج لاستعادة صوته

259
00:20:39,920 --> 00:20:42,530
.أردت علاجها من البداية

260
00:20:43,410 --> 00:20:47,990
.لكنّي لن أستطيع مساعدتهما بدءًا من هذه المرحلة

261
00:20:48,690 --> 00:20:53,090
.الأهمّ هو أنّهما يفهمان ألم بعضهما

262
00:20:53,420 --> 00:20:57,350
.ليس من الخيانة أن تتطلّعوا للأمام

263
00:21:00,570 --> 00:21:05,100
.أنا يائسة. أستمرّ في إعداد حصّة يو

264
00:21:10,330 --> 00:21:11,500
...ريو

265
00:21:18,430 --> 00:21:20,170
.سنتشاركها

266
00:21:22,400 --> 00:21:25,010
.أجل، معك حقّ

267
00:21:29,760 --> 00:21:31,260
.شكرًا على الطّعام

268
00:21:35,560 --> 00:21:39,900
يا إلهي، كيف لك أن تؤذي نفسك
هكذا بينما تحاول علاج مريض؟

269
00:21:40,280 --> 00:21:42,170
.يا لك من ضعيف

270
00:21:42,170 --> 00:21:42,710
.مؤلم

271
00:21:42,710 --> 00:21:44,950
...رويدك يا جدّتي

272
00:21:45,770 --> 00:21:48,870
!أيّتها الجدّة، ماذا تفعلين؟

273
00:21:49,290 --> 00:21:51,950
.كورو، ساعدني

274
00:21:49,520 --> 00:21:51,320
.هذا رائع

275
00:21:52,340 --> 00:21:54,150
.جنيتَ على نفسك

276
00:23:25,790 --> 00:23:27,410
.كوروبي

277
00:23:28,440 --> 00:23:31,180
.كورومارو، كوروتان، كوروبي

278
00:23:31,180 --> 00:23:33,970
.سأحشو فمك بالفشار

279
00:23:33,970 --> 00:23:35,430
.-الدّكتور راموني -أخصّائيّ الأمراض الغامضة

280
00:23:35,430 --> 00:23:38,920
".الحلقة 7، "رأس الفشار، الجزء الأوّل