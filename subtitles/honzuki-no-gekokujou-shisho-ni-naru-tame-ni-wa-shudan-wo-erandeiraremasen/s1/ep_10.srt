1
00:00:01,090 --> 00:00:05,600
.وسّعت مبيعات زينة الشّعر عالم ماين أكثر

2
00:00:06,070 --> 00:00:12,040
"في ذات الوقت، كان "الملتهم
.يهدّد بتدمير جسدها

3
00:01:53,650 --> 00:01:56,510
.مضى عامًا منذ مجيئي إلى هذا العالم

4
00:01:56,840 --> 00:01:58,810
.إنّه يوم تخزين اللّحم من جديد

5
00:01:59,500 --> 00:02:02,010
.قريبًا، سيأتي شتائي الثّاني

6
00:02:04,450 --> 00:02:06,430
ثلاثة أيّام؟

7
00:02:06,430 --> 00:02:09,300
لم أكن طريحة الفراش لهذه
.المدّة منذ فترة بعيدة

8
00:02:10,040 --> 00:02:13,570
حسبت أنّني بدأت أتحسّن
.مؤخّرًا، وها أنا ذي

9
00:02:18,220 --> 00:02:21,210
!ابتعدي أيّتها الحمّى الملتهمة

10
00:02:21,790 --> 00:02:26,260
،ضعيها في صندوق ثمّ ضعي الغطاء فوقها

11
00:02:26,260 --> 00:02:28,160
!لتكوني بأمان

12
00:02:29,160 --> 00:02:30,610
.هذا غريبًا جدًّا

13
00:02:30,610 --> 00:02:33,180
.كان قليل من القلق كفيلاً بإعادة المرض

14
00:02:33,970 --> 00:02:38,550
لا يفعل "الملتهم" شيئًا ما دمت
.تمتلكين دافعًا

15
00:02:39,430 --> 00:02:42,770
هذا صحيح. ينبغي أن أشغل
.نفسي بأشياء ممتعة

16
00:02:44,440 --> 00:02:49,450
.طلب منّي بينّو قراءة هذا
عمّاذا يتكلّم يا ترى؟

17
00:02:50,370 --> 00:02:52,070
!عدنا

18
00:02:52,820 --> 00:02:54,050
!انظري يا ماين

19
00:02:54,050 --> 00:02:55,690
!لحم مقدّد

20
00:02:56,010 --> 00:02:58,360
.سأعدّ لك بعض الحساء حالاً

21
00:02:58,360 --> 00:03:00,230
.شكرًا يا توري

22
00:03:00,230 --> 00:03:01,660
.مرحبًا يا ماين

23
00:03:01,660 --> 00:03:02,860
لوتز؟

24
00:03:03,180 --> 00:03:07,250
،أخبرتني توري أنّ حرارتك قد انخفضت
.لذلك أتيت للاطمئنان عليك

25
00:03:07,530 --> 00:03:10,520
فاتك تخزين اللّحم من جديد، أليس كذلك؟

26
00:03:12,430 --> 00:03:14,870
.في الواقع، أنا مسرورة لأنّه فاتني

27
00:03:15,130 --> 00:03:17,720
قلقت لأنّ الحمّى دامت
.لفترة طويلة في هذه المرّة

28
00:03:17,720 --> 00:03:20,560
.تعافيت الآن، لذا لا تقلق

29
00:03:21,040 --> 00:03:25,640
"لا أعرف أيّ شيء عن "الملتهم
،هذا الّذي ذكرته فريدا

30
00:03:25,640 --> 00:03:29,920
لذا لا أدري ما إن أبليت
.حسنًا في مراقبة صحّتك

31
00:03:29,920 --> 00:03:32,010
.لا، كنت ممتازًا

32
00:03:32,010 --> 00:03:35,270
.بفضلك لم أعد أسقط أمام النّاس

33
00:03:35,270 --> 00:03:37,390
.يسرّني سماع ذلك

34
00:03:37,720 --> 00:03:39,840
.يمكنني الذّهاب إلى المتجر غدًا

35
00:03:39,840 --> 00:03:42,030
.بالمناسبة، انظر

36
00:03:44,920 --> 00:03:46,040
...واحد

37
00:03:46,040 --> 00:03:49,150
حسّن مظهرك وتعلّم كيف تلقي
.التّحيّة على النّاس

38
00:03:49,420 --> 00:03:50,400
...اثنان

39
00:03:50,400 --> 00:03:53,420
تعلّم كيف تقرأ وتكتب كلّ الكلمات
.الأساسيّة مع الأرقام

40
00:03:53,740 --> 00:03:54,680
...ثلاثة

41
00:03:54,920 --> 00:03:57,010
.تعلّم كيف تستعمل أداة حساب

42
00:03:57,290 --> 00:04:00,350
.إنّها عمليّة التّدريب للتّلاميذ الجدد

43
00:04:00,350 --> 00:04:03,300
!اسمعا! أنجزا هذا في فصل الشّتاء

44
00:04:03,700 --> 00:04:06,090
كلّ هذا في فصل الشّتاء؟

45
00:04:06,580 --> 00:04:07,670
!مستحيل

46
00:04:08,060 --> 00:04:11,800
.المشكلة الكبرى هي المظهر

47
00:04:14,670 --> 00:04:16,560
هل تعافيت من الحمّى؟

48
00:04:16,560 --> 00:04:19,430
.نعم. آسفة لأنّني سبّبت لك المتاعب

49
00:04:21,110 --> 00:04:23,450
.شكرًا لك على إعطائي هذا

50
00:04:23,450 --> 00:04:27,830
مكتوب أن نحسّن مظهرنا، لكن
ما الّذي تسعى له بالضّبط؟

51
00:04:27,830 --> 00:04:32,260
قبل كلّ شيء، يجب الاهتمام
.بالهندام والحذاء

52
00:04:32,260 --> 00:04:35,710
ينبغي أن تكون عشر فضّيّات صغيرة
.كافية لإيصالكما إلى مستويات مقبولة

53
00:04:35,710 --> 00:04:39,920
عشر فضّيّات صغيرة؟
!لا أحمل هذا المال

54
00:04:39,920 --> 00:04:43,120
أتتذكّر تلك الفضّيّات
الّتي أودعناها لدى النّقابة؟

55
00:04:43,120 --> 00:04:44,850
.يمكننا استخدامها فحسب

56
00:04:45,350 --> 00:04:47,960
فعلنا ذلك لأوقات كهذه؟

57
00:04:48,350 --> 00:04:52,310
وكرأس مال ننفقه وقتما
.نبدأ بصنع شيء جديد

58
00:04:52,310 --> 00:04:54,570
أتتذكّر عندما وصلنا لطريق
مسدود بالنّسبة للمسامير؟

59
00:04:54,570 --> 00:04:58,190
.جوهريًّا، نحتاج مالاً لأيّ شيء وكلّ شيء

60
00:04:58,190 --> 00:04:59,440
.هكذا إذًا

61
00:04:59,840 --> 00:05:03,320
لطالما ظننت أنّنا ينبغي أن نأخذ
،كلّ مكتسباتنا إلى المنزل

62
00:05:03,320 --> 00:05:05,280
.لهذا شعرت بالذّنب تجاه عائلتي

63
00:05:05,280 --> 00:05:11,240
لا ضير من ادّخار المال
.الّذي توفّره لنفسك

64
00:05:12,090 --> 00:05:14,370
.أشعر براحة الآن

65
00:05:14,970 --> 00:05:16,620
.شكرًا يا ماين

66
00:05:16,910 --> 00:05:19,670
.وبهذا ننتهي من مسألة المظهر

67
00:05:19,670 --> 00:05:22,770
فيما يلي... لوتز، عليك أن
.تتعلّم بعض آداب السّلوك

68
00:05:22,770 --> 00:05:25,460
لا يمكنك أن تخدم الزّبائن بأسلوب
.كلامك الّذي تستخدمه الآن

69
00:05:26,840 --> 00:05:27,840
،قبل كلّ شيء

70
00:05:27,840 --> 00:05:31,910
سيكون من اللّطيف أن تضيف
.من فضلك" و "شكرًا لك" إلى جملك"

71
00:05:32,930 --> 00:05:35,060
.إن استطعت من فضلك

72
00:05:35,060 --> 00:05:37,090
...أعتقد يمكنني فعل ذلك

73
00:05:37,900 --> 00:05:38,680
!من فضلك

74
00:05:42,140 --> 00:05:43,560
...سيّد بينّو

75
00:05:44,170 --> 00:05:47,980
لا أعلم إلى أيّ مدى يمكنك
،أن تتحسّن في فصل الشّتاء

76
00:05:47,980 --> 00:05:49,190
.لكن ابذل قصارى جهدك

77
00:05:49,730 --> 00:05:54,290
بالمناسبة، واجهنا مشكلة
.مع شامبو الكلّ في واحد

78
00:05:54,290 --> 00:05:55,650
ماذا حدث؟

79
00:05:55,650 --> 00:05:58,170
،طلبت من ورشة أن تصنعه لي

80
00:05:58,170 --> 00:06:02,060
لكن لا يحصلون على نفس النّتائج
.على الرّغم من اتّباع تعليماتك

81
00:06:02,530 --> 00:06:04,310
هل لديك أدنى فكرة عن السّبب؟

82
00:06:04,310 --> 00:06:07,810
إنّه بسيط وليس أكثر من عصر فاكهة
.واستخراج الزّيت منها

83
00:06:08,120 --> 00:06:10,200
.لا أستطيع بيعه بهذا الشّكل

84
00:06:10,200 --> 00:06:14,050
.وسيعدّ ذلك انتهاكًا لسحر العقد

85
00:06:14,300 --> 00:06:17,530
ماذا يحدث عندما ينتهك سحر العقد؟

86
00:06:18,140 --> 00:06:20,520
.في أسوأ الحالات، قد يهدّد ذلك أرواحنا

87
00:06:22,210 --> 00:06:25,530
!لماذا لم تخبرني بذلك؟

88
00:06:25,960 --> 00:06:29,270
.وهكذا شققنا طريقنا إلى الورشة فورًا

89
00:06:43,570 --> 00:06:45,050
.فهمت الآن

90
00:06:45,050 --> 00:06:46,200
ماذا كانت؟

91
00:06:46,200 --> 00:06:47,880
ماذا كانت المشكلة؟

92
00:06:48,360 --> 00:06:50,250
.القماش الذي استخدمه لعصر الزّيت

93
00:06:50,750 --> 00:06:51,970
القماش؟

94
00:06:52,310 --> 00:06:56,730
تستخدم قماشًا أملس ناعمًا هنا والّذي له
.مسامّات صغيرة بطبيعة الحال

95
00:06:57,050 --> 00:07:01,130
لكنّ القماش الخشن الرّخيص
.في الدّيار له مسامّات أوسع

96
00:07:01,130 --> 00:07:06,860
يحافظ عصر الفاكهة به على ألياف
.الفاكهة وقطع البذور في الزّيت

97
00:07:07,190 --> 00:07:11,110
والّتي تلعب دورًا أساسيًّا
.في إزالة الشّوائب من الشّعر

98
00:07:11,110 --> 00:07:14,620
.هكذا إذًا. نحتاج لقماش أكثر خشونة

99
00:07:14,620 --> 00:07:18,110
معنى هذا أنّنا لا نستطيع استخدام
.كلّ شيء استخرجناه حتّى الآن

100
00:07:18,110 --> 00:07:21,590
بالطّبع يمكننا. عدم استخدامه
.سيكون إسرافًا كبيرًا

101
00:07:22,670 --> 00:07:27,270
مستحضرات تقشير... أعني كلّ ما
.عليك هو أن تصنع منظّفات منها

102
00:07:27,270 --> 00:07:31,170
،إذا اخترت المكوّنات بعناية
.ستتمكّن من صنع موادّ عالية الجودة

103
00:07:31,170 --> 00:07:34,670
.مذهل يا آنسة. معلوماتك وافرة

104
00:07:39,790 --> 00:07:42,560
.وعلى الأرجح تعرف أكثر بكثير ممّا تفشي

105
00:07:42,560 --> 00:07:46,310
تبًّا! إذا استمرّ هذا، فسنعود
!إلى حالة لوتز من جديد

106
00:07:47,130 --> 00:07:48,310
.ماين

107
00:07:48,310 --> 00:07:51,250
!لا يجوز أن أتكلّم أكثر

108
00:07:52,570 --> 00:07:54,920
.أيّ معلومة إضافيّة ستكلّفك

109
00:07:54,920 --> 00:07:56,840
.لن أعطي معلومات مجّانًا

110
00:07:56,840 --> 00:07:57,910
.حسنًا

111
00:07:58,590 --> 00:08:00,940
هل تمانع أن أستعير غرفة اجتماعاتك؟

112
00:08:00,940 --> 00:08:02,950
.أ-أبدًا، تفضّل

113
00:08:02,950 --> 00:08:04,500
...ماذا؟ انتـ

114
00:08:05,280 --> 00:08:06,160
!ماين

115
00:08:06,160 --> 00:08:07,550
!انتظر

116
00:08:06,160 --> 00:08:07,960
.سوف نتكلّم فحسب

117
00:08:07,960 --> 00:08:09,420
.لا أحد يقترب

118
00:08:12,410 --> 00:08:14,140
.ذهبيّتان صغيرتان

119
00:08:14,140 --> 00:08:15,060
عفوًا؟

120
00:08:17,050 --> 00:08:19,170
.سأسدّد لك ذهبيّتين صغيرتين

121
00:08:19,170 --> 00:08:22,370
.أعطيني معلومات
أيّ تحسينات ومكوّنات بديلة

122
00:08:22,370 --> 00:08:24,690
.وكلّ شيء آخر يخطر على البال

123
00:08:25,050 --> 00:08:27,190
ذهبيّتان صغيرتان؟

124
00:08:27,680 --> 00:08:29,160
.ثلاث ذهبيّات صغيرة

125
00:08:29,420 --> 00:08:31,500
ثلاث ذهبيّات صغيرة؟

126
00:08:31,500 --> 00:08:36,410
عندما تسنح فرصة لجني المال، فلا تفوّتيها"
".متى كان وأينما كان وبأيّ شكل كان

127
00:08:36,410 --> 00:08:37,580
أليس كذلك؟

128
00:08:39,830 --> 00:08:43,830
ثلاث ذهبيّات إذًا؟
.هذا أكثر ما يمكنني دفعه

129
00:08:43,830 --> 00:08:45,760
!ا-انتظر لحظة

130
00:08:45,760 --> 00:08:47,930
.خذيها وادّخريها فحسب

131
00:08:47,930 --> 00:08:51,140
المال هو الشّيء الّذي يمكنه
."أن يبعد عنك "الملتهم

132
00:08:52,120 --> 00:08:54,280
كيف عرفت؟

133
00:08:54,850 --> 00:08:57,270
،لطالما احتسبت لهذا الاحتمال

134
00:08:57,270 --> 00:08:59,380
.لكنّ العجوز الخرف أكّد ذلك قبل أيّام

135
00:08:59,810 --> 00:09:02,810
."قال أنّ فريدا أخبرته أنّك مصابة بـ"الملتهم

136
00:09:04,170 --> 00:09:07,950
نجت هي إلى الآن لأنّها ثريّة ولديها
.روابط مع الطّبقة النّبيلة

137
00:09:08,850 --> 00:09:12,890
كلّ ما يمكنني فعله لأجلك
.هو التّسديد ثمن معلوماتك

138
00:09:13,720 --> 00:09:15,260
...سيّد بينّو

139
00:09:16,040 --> 00:09:17,160
.اجلسي

140
00:09:20,160 --> 00:09:23,630
حتّى لو توجّب عليك بيع كلّ ما
تعرفينه، افعلي ذلك وادّخري المال

141
00:09:23,630 --> 00:09:25,400
.لوقت تحتاجين إليه

142
00:09:25,990 --> 00:09:28,410
ماذا تعني؟

143
00:09:29,360 --> 00:09:33,790
.عندما يصبح قمع الحمّى غير ممكن

144
00:09:35,470 --> 00:09:39,550
.شعرت أنّ الحمّى بدأت تنشط أكثر مؤخّرًا

145
00:09:39,550 --> 00:09:41,430
.إذًا لم أكن أتوهّم ذلك

146
00:09:44,250 --> 00:09:46,780
تكبّدت الكثير من العناء
...للوصول إلى هنا

147
00:09:48,480 --> 00:09:50,350
.لا أريد أن أموت بعد

148
00:09:51,280 --> 00:09:52,850
...أريد أن

149
00:09:54,310 --> 00:09:55,840
!لا، سوف أنجو

150
00:09:56,660 --> 00:10:00,740
فهمت. سأقبل بالذّهبيّات
.الثّلاث الصّغيرة

151
00:10:04,220 --> 00:10:08,980
بعت طرق تحسين شامبو
،الكلّ في واحد البسيط لبينّو

152
00:10:08,980 --> 00:10:11,490
بما في ذلك كيف يمكن للملح
،أن يعمل كمادّة كاشطة

153
00:10:11,930 --> 00:10:16,000
وكيف أنّ الحمضيّات تسهّل
.عمليّة إزالة الشّوائب

154
00:10:18,720 --> 00:10:20,500
هل جرّبت كلّ هذا بنفسك؟

155
00:10:20,500 --> 00:10:25,260
لا، لم أستطع. المكوّنات باهظة
.الثّمن على عائلتي

156
00:10:26,900 --> 00:10:29,270
لم تستطيعي تجربتها
ومع ذلك تعلمين أنّها تنجح؟

157
00:10:32,730 --> 00:10:34,600
من تكونين بالضّبط؟

158
00:10:43,250 --> 00:10:44,800
.هذا سرّ

159
00:10:45,360 --> 00:10:48,120
مهما أعطيتني من ذهبيّات
.صغيرة، فلن أتكلّم

160
00:10:50,670 --> 00:10:54,200
كنت جاهزة لهذا عندما قرّرت
.أن أمنحك كلّ تلك المعلومات

161
00:10:54,700 --> 00:10:56,100
...لكن

162
00:10:57,060 --> 00:11:02,630
هل ستطردني بعد أن وجدت
أنّني طفلة مريبة؟

163
00:11:11,230 --> 00:11:13,590
،لا. بما أنّك مدرّة للأموال

164
00:11:13,590 --> 00:11:17,020
سأبذل جهدًا أكبر لأحرص على
.ألاّ يحصل عليك أحدًا آخر

165
00:11:18,850 --> 00:11:21,650
.فأنا رجل أعمال في نهاية المطاف

166
00:11:21,930 --> 00:11:23,290
...سيّد بينّو

167
00:11:31,730 --> 00:11:36,940
وأيضًا شامبو الكلّ في واحد البسيط
.اسم طويل جدًّا ومعقّد

168
00:11:36,940 --> 00:11:38,840
"هل نطلق عليه شامبو "ك.ف.و
بدلاً من ذلك؟

169
00:11:38,840 --> 00:11:43,330
بالتّأكيد، لكن أهذا أفضل ما لديك حقًّا؟

170
00:11:44,930 --> 00:11:46,850
الشاّمبو البسيط إذًا؟

171
00:11:48,190 --> 00:11:50,360
.شامبو "ك.ف.و" مناسب

172
00:11:50,360 --> 00:11:54,610
سوف نصنع ونبيع كمّيّات كبيرة
!من شامبو "ك.ف.و" وزينة الشّعر

173
00:11:56,330 --> 00:11:57,810
!لك ذلك

174
00:12:09,260 --> 00:12:11,950
ماذا؟ نصنع المزيد من زينة الشّعر؟

175
00:12:11,950 --> 00:12:13,090
.نعم

176
00:12:13,090 --> 00:12:17,840
سمع النّاس عن زينة فريدا
.وطلبوا المزيد لأنفسهم

177
00:12:17,840 --> 00:12:21,210
أتريديننا إذًا أن نوقف أشغالنا
اليدويّة الشّتويّة؟

178
00:12:22,780 --> 00:12:25,600
.هذه فترة مزدحمة بالأعمال أيضًا

179
00:12:25,600 --> 00:12:28,360
!لهذا حصلت على سلفة

180
00:12:28,620 --> 00:12:32,360
.برونزيّتان متوسّطتان لكلّ زينة زهرة

181
00:12:32,360 --> 00:12:34,860
!برونزيّتان متوسّطتان لكلّ واحدة؟

182
00:12:39,370 --> 00:12:43,080
!استخدمت سحر الاستعجال! كان فعّالاً جدًّا

183
00:12:44,240 --> 00:12:46,700
هل أصنع جزء الدبّوس؟

184
00:12:46,700 --> 00:12:49,010
.هذا عمل لوتز

185
00:12:49,010 --> 00:12:50,530
لوتز من جديد؟

186
00:12:51,480 --> 00:12:54,780
.أبي، أريد زيارة البوّابة غدًا
هل يمكننا الذّهاب معًا؟

187
00:12:55,220 --> 00:12:57,190
!ماذا؟ بالطّبع

188
00:12:58,010 --> 00:13:01,040
.سمعت أنّك مرضت من جديد يا ماين

189
00:13:01,040 --> 00:13:03,670
.نعم، لكنّني بخير الآن

190
00:13:03,670 --> 00:13:04,460
.هكذا إذًا

191
00:13:04,460 --> 00:13:06,150
!ظهر ترومبي

192
00:13:11,020 --> 00:13:14,090
...كانوا يقولون أنّ ترومبي خطير

193
00:13:27,440 --> 00:13:29,770
.يتكرّر هذا كثيرًا مؤخرًا

194
00:13:33,040 --> 00:13:36,430
.حصلنا على مجموعة من فروع ترومبي

195
00:13:36,430 --> 00:13:39,910
.لم أتوقّع أن نصنع ورقًا مجدّدًا في وقت قريب

196
00:13:39,910 --> 00:13:44,420
.كان ليوبّخنا بينّو إذا أهدرنا التّرومبي هذا

197
00:13:48,340 --> 00:13:50,310
!برد قارس

198
00:13:52,390 --> 00:13:55,770
يجعلني هذا أرغب في تناول بعض
.البطاطا بالزّبدة السّاخنة جدًّا

199
00:13:55,770 --> 00:13:57,300
.سنحتاج لزبدة لأجل ذلك

200
00:13:57,300 --> 00:14:00,370
أتريدينني أن أدخل النّهر في هذا البرد؟

201
00:14:00,370 --> 00:14:02,960
.لنعمل بماء البئر غدًا

202
00:14:02,960 --> 00:14:04,830
!أيمكننا؟ هذا جيّد

203
00:14:04,830 --> 00:14:06,970
.نعم. لا تنس الزّبدة فحسب

204
00:14:06,970 --> 00:14:08,940
الزّبدة؟ لماذا؟

205
00:14:08,940 --> 00:14:11,070
ماذا؟ ألم أقل؟

206
00:14:11,070 --> 00:14:13,580
بالمناسبة، هل سارت الأشغال
اليدويّة على ما يرام؟

207
00:14:13,580 --> 00:14:17,670
،نعم. أراد أبي المشاركة
.ولم أعرف كيف أرفض

208
00:14:17,670 --> 00:14:19,040
ماذا عنكم؟

209
00:14:19,400 --> 00:14:20,800
.لا شيء

210
00:14:21,410 --> 00:14:26,550
طلبت من رالف والآخرين
.المساعدة، لكن لم يهتمّوا

211
00:14:26,550 --> 00:14:29,510
عليك استخدام سحر الاستعجال
.عليهم فحسب

212
00:14:30,190 --> 00:14:32,160
سحر الاستعجال؟

213
00:14:35,260 --> 00:14:36,550
.خذ يا لوتز

214
00:14:36,550 --> 00:14:39,640
هذه خمس برونزيّات متوسّطة
.مقابل خمسة دبابيس شعر

215
00:14:39,960 --> 00:14:41,700
خمس برونزيّات متوسّطة؟

216
00:14:41,700 --> 00:14:44,710
مقابل تلك الأعواد الّتي كان يصنعها لوتز؟

217
00:14:44,710 --> 00:14:47,400
كلّ واحدة من هذه تعادل
!برونزيّة متوسّطة واحدة؟

218
00:14:47,400 --> 00:14:50,800
،ليس بالضّرورة أن يكون لوتز
صحيح؟ هل يمكننا المساعدة؟

219
00:14:55,110 --> 00:14:59,340
!جميع التّجّار محتالون
لِم يرغب المرء في أن يصبح تاجرًا؟

220
00:14:59,340 --> 00:15:01,660
.لا أعرف ماذا أفعل مع لوتز

221
00:15:02,000 --> 00:15:04,960
.حسنًا، لا يبدو رئيسهما رجلاً سيّئًا

222
00:15:04,960 --> 00:15:06,670
.إنّه يسدّد ثمن أشغالنا اليدويّة

223
00:15:06,670 --> 00:15:08,860
.لكن لا يسعني سوى القلق

224
00:15:08,860 --> 00:15:12,680
لم يعمل عملاً غير ثابت كهذا؟

225
00:15:12,680 --> 00:15:14,250
!سنغادر

226
00:15:14,250 --> 00:15:15,520
.إلى اللّقاء

227
00:15:15,520 --> 00:15:17,140
.انتبها على نفسيكما

228
00:15:17,750 --> 00:15:20,400
.أنا ممتنّة جدًّا للوتز

229
00:15:20,400 --> 00:15:22,990
.يعتني بماين دومًا

230
00:15:22,990 --> 00:15:26,770
حقًّا؟ يبدو أنّ ماين تبلي
.بلاء حسنًا مؤخّرًا أيضًا

231
00:15:26,770 --> 00:15:29,550
.نعم، أفضل بكثير مقارنة بالسّابق

232
00:15:29,550 --> 00:15:32,110
.آمل أن تنمو بصحّة جيّدة

233
00:15:42,070 --> 00:15:44,220
قصدتِ كارفيل؟

234
00:15:44,220 --> 00:15:46,030
ألا تريدها؟

235
00:15:46,640 --> 00:15:48,190
.سآكلها

236
00:15:51,630 --> 00:15:53,560
إنّها لذيذة جدًّا! ما هذا؟

237
00:15:53,560 --> 00:15:56,760
.لا يبخّرون طعامهم هنا إذًا

238
00:15:56,760 --> 00:16:00,520
من الطّبيعي ألاّ تعرف كم البطاطا
.المبخّرة مع الزّبدة شهيّة

239
00:16:05,100 --> 00:16:09,450
.بعد ذلك، عملنا على لحاء التّرومبي

240
00:16:10,320 --> 00:16:14,560
،الآن بعد أن أنجزنا ذلك
.يمكننا فعل الباقي  في الرّبيع

241
00:16:14,830 --> 00:16:17,030
.انتهيت من وضع الأدوات جانبًا

242
00:16:17,410 --> 00:16:19,900
—سيكون لدينا مزيدًا من ورق ترومبي

243
00:16:25,740 --> 00:16:30,930
،لماذا؟ لم أكن متوتّرة
!ناهيك عن فقدان العزيمة

244
00:16:30,930 --> 00:16:32,380
ماين؟ ما الأمر؟

245
00:16:33,510 --> 00:16:34,340
!أنت ساخنة

246
00:16:34,960 --> 00:16:37,060
هل عادت الحمّى فجأة؟

247
00:16:37,060 --> 00:16:38,600
ماين، هل أنت بخير؟

248
00:16:47,080 --> 00:16:49,600
...الحمّى... قد زالت

249
00:16:50,070 --> 00:16:51,750
ماذا كان ذلك بالضّبط؟

250
00:16:51,750 --> 00:16:53,070
."الملتهم"

251
00:16:53,070 --> 00:16:57,410
ماذا؟ لكن لم تكن هناك
!أيّ أعراض تنذر بسوء حالتك

252
00:16:57,410 --> 00:17:00,370
!وقلت أنّك تعافيت تمامًا قبل أيّام

253
00:17:00,370 --> 00:17:02,590
.إنّها تعود فجأة في هذه الأيّام

254
00:17:02,590 --> 00:17:06,370
.في السّابق، كان ذلك يحدث عندما أتوتّر فقط

255
00:17:07,290 --> 00:17:08,460
...ماين

256
00:17:09,930 --> 00:17:11,870
.كم أخافني ذلك

257
00:17:12,670 --> 00:17:14,750
ألا يمكننا فعل شيء؟

258
00:17:18,030 --> 00:17:22,020
أتتذكّرين ما قالته فريدا؟
.يكلّف كثيرًا من المال

259
00:17:22,020 --> 00:17:24,130
.قال بينّو نفس الكلام

260
00:17:33,550 --> 00:17:35,240
.سأوصلك

261
00:17:35,240 --> 00:17:37,900
.هذا كلّ ما يمكنني فعله لأجلك

262
00:17:38,180 --> 00:17:41,910
!هذا كلّ"؟ لكنّك تفعل الكثير لي سلفًا"

263
00:17:42,290 --> 00:17:44,900
.اصعدي بسرعة فحسب

264
00:17:46,320 --> 00:17:47,790
...حسنًا

265
00:17:55,500 --> 00:17:57,130
.يا للخيبة

266
00:17:57,630 --> 00:18:00,360
،حتّى في كلّ الكتب الّتي قرأتها

267
00:18:00,360 --> 00:18:04,560
.لا أجد الكلمات المناسبة لأقولها له الآن

268
00:18:05,590 --> 00:18:08,470
.لوتز لطيف لدرجة غير عاديّة

269
00:18:09,390 --> 00:18:13,560
،يقف إلى جانبي حتّى عندما أكون عبئًا

270
00:18:13,560 --> 00:18:17,270
وقبلني حتّى بعد أن اكتشف
.أنّني لست ماين

271
00:18:19,160 --> 00:18:20,640
لوتز؟

272
00:18:20,640 --> 00:18:25,940
حتّى لو سقطت، فليس عليك
الشّعور بالمسؤوليّة، اتّفقنا؟

273
00:18:25,940 --> 00:18:29,160
.وأيضًا، لن أستسلم

274
00:18:29,160 --> 00:18:31,270
.لم أنجز أيّ كتاب بعد

275
00:18:44,930 --> 00:18:47,150
.لوتز، تعال معي. ابقي هنا أنت

276
00:18:49,660 --> 00:18:52,870
.أنقذ ماين يا سيّد بينّو

277
00:18:53,660 --> 00:18:56,180
.لا أستطيع فعلها. لا أستطيع فعل أيّ شيء

278
00:18:57,060 --> 00:19:00,080
سيكون من دواعي سروري
...أن أفعل إن استطعت، لكن

279
00:19:00,520 --> 00:19:03,070
.إذًا لا تدع ماين تهتمّ لأمرك

280
00:19:04,310 --> 00:19:07,050
.تلك الفتاة أكثر نضجًا بكثير ممّا تبدو

281
00:19:07,050 --> 00:19:11,830
.حتّى لو كانت تتألّم، فإنّها تبتسم لأجلك

282
00:19:13,680 --> 00:19:17,750
إن كنت رجلاً، احرص على
!ألاّ تدع ماين تقلق عليك

283
00:19:17,750 --> 00:19:21,940
امتلكت الجرأة لتقول أنّك مستعدّ
،لصنع أيّ شيء تفكّر فيه ماين

284
00:19:21,940 --> 00:19:24,330
!لذا اصنع وبع المنتج تلو الآخر

285
00:19:24,330 --> 00:19:25,970
!اكسب قدر ما تستطيع من أموال

286
00:19:35,750 --> 00:19:38,270
.أصبحت نظرة عينيك جيّدة الآن

287
00:19:39,590 --> 00:19:43,710
،في المرّة التّالية الّتي رأيته فيها
.عاد لوتز إلى طبيعته المعتادة

288
00:19:44,490 --> 00:19:47,950
كنت أعتقد أنّ الحظّ سيحالفنا
،إذا صنعنا عشرة

289
00:19:47,950 --> 00:19:50,000
!لكنّنا صنعنا ضعف ذلك

290
00:19:50,260 --> 00:19:53,150
.إنّ بيع هذه الكمّيّة سيساعدنا قليلاً

291
00:19:53,810 --> 00:19:57,080
تحتاجين للمال لمواجهة "الملتهم"، صحيح؟

292
00:19:57,080 --> 00:19:58,510
...لوتز

293
00:19:58,510 --> 00:20:01,430
هل لديك أيّ أفكار منتج أخرى؟

294
00:20:01,850 --> 00:20:05,760
!سأصنع أيّ شيء وكلّ ما يخطر على بالك

295
00:20:07,620 --> 00:20:08,890
.شكرًا لك

296
00:20:09,790 --> 00:20:12,270
.وبهذا تتمّ عمليّة توصيل زينة الشّعر

297
00:20:12,270 --> 00:20:13,280
.نعم

298
00:20:13,280 --> 00:20:14,960
.حسنًا، إليكما أجركما

299
00:20:15,760 --> 00:20:18,410
هل تعتقد أنّنا نستطيع
بيع هذه كذلك؟

300
00:20:18,410 --> 00:20:21,420
صنعت واحدة أثناء الأشغال اليدويّة
.الشّتويّة في العام الماضي

301
00:20:23,410 --> 00:20:25,400
كنت أنت من جديد؟

302
00:20:25,400 --> 00:20:31,410
هل كلّ منتج غريب صادفته في الأشهر
السّتّة الأخيرة كان مصدره أنت؟

303
00:20:31,410 --> 00:20:34,680
.أنا... آسفة بشأن ذلك

304
00:20:34,680 --> 00:20:38,250
هل لديك أيّ شيء يدرّ دخلاً أكبر
ممّا تدرّه السّلل؟

305
00:20:38,250 --> 00:20:40,540
."شيء قابل للاستهلاك، مثل شامبو "ك.ف.و

306
00:20:40,540 --> 00:20:46,050
حسنًا... ما رأيك بالصّابون الملوّن
أو المعطّر أو الشّمع؟

307
00:20:46,050 --> 00:20:48,600
هل تعرفين كيف تصنعين هذه؟

308
00:20:48,600 --> 00:20:51,930
.نعم، رغم أنّ ذلك يحتمل التّجربة والخطأ

309
00:20:51,930 --> 00:20:54,940
.حسنًا. جرّبي كلّ ما يخطر على ذهنك

310
00:20:54,940 --> 00:20:55,900
.حسنًا

311
00:20:55,900 --> 00:20:57,940
.علينا أن نصنع مزيدًا من الورق أيضًا

312
00:20:57,940 --> 00:21:01,140
،إذا أضفنا الشّموع إلى ذلك
.سننشغل كثيرًا

313
00:21:08,570 --> 00:21:09,540
!ماين

314
00:21:09,540 --> 00:21:10,440
!ماين؟

315
00:21:10,440 --> 00:21:11,590
!هل أنت بخير؟

316
00:21:11,940 --> 00:21:14,950
!هذا سيّئ! مارك، جهّز العربة

317
00:21:25,470 --> 00:21:28,970
...يُتبع

318
00:23:02,450 --> 00:23:05,210
!افعل شيئًا يا سيّد بينّو

319
00:23:05,210 --> 00:23:07,390
يعرف رئيس النّقابة ماذا يفعل، صحيح؟

320
00:23:07,390 --> 00:23:09,090
.لقد تفاوضت معه بالفعل

321
00:23:09,090 --> 00:23:11,010
!يحيا السّيّد بينّو

322
00:23:11,010 --> 00:23:15,460
يبدو أنّه ما زال يمتلك بعضًا من الأدوات
.السّحريّة الّتي اشتراها لفريدا

323
00:23:15,460 --> 00:23:19,010
أداة سحريّة تستعمل مرّة واحدة
.مقابل ذهبيّتين صغيرتين فقط

324
00:23:19,010 --> 00:23:20,360
!ذ-ذهبيّتان؟

325
00:23:20,360 --> 00:23:22,220
.اعتبرها كنوع من الاستثمار

326
00:23:22,220 --> 00:23:25,850
...استثمار؟ يا لك من

327
00:23:25,850 --> 00:23:28,370
.لا داعي لتكون ممتنًّا

328
00:23:28,370 --> 00:23:31,180
!أفعل هذا بنيّة قلب صافية

329
00:23:32,460 --> 00:23:34,640
.أعيدوا لي فقرة الحلقة القادمة