1
00:00:01,060 --> 00:00:04,850
يعلم الطّاقم في الكاتدرائيّة
."أنّ ماين مصابة بـ"الملتهم

2
00:00:05,220 --> 00:00:08,730
.ماين، نودّ أن نتكلّم مع والديك

3
00:00:10,700 --> 00:00:14,870
يقترح بينّو استخدام سحر
،العقد لحمايتها من النّبلاء

4
00:00:15,470 --> 00:00:19,000
.وتتّخذ ماين قرارها بالانضمام للكاتدرائيّة

5
00:02:01,010 --> 00:02:02,720
.لقد عدت

6
00:02:02,720 --> 00:02:04,010
!ماين

7
00:02:04,440 --> 00:02:07,520
حسنًا، ماذا حدث في الكاتدرائيّة؟

8
00:02:07,520 --> 00:02:12,920
في الواقع، طلبت من كبير الكهنة
،أن ينسى أمر تدريبي

9
00:02:12,920 --> 00:02:15,130
،"لكن حالما علموا أنّني مصابة بـ"الملتهم

10
00:02:15,130 --> 00:02:18,080
.قالوا أنّهم يريدون التّكلّم معكما

11
00:02:18,740 --> 00:02:21,570
.وأعطوني هذه الدّعوة لكما

12
00:02:23,260 --> 00:02:25,450
يريدون أن تلتقوا على الجرس
.الثّالث بعد يومين من الآن

13
00:02:25,450 --> 00:02:28,410
ماذا فعلت بالضّبط يا ماين؟

14
00:02:28,800 --> 00:02:31,660
.جعلوني ألمس كأسًا مقدّسة

15
00:02:31,660 --> 00:02:33,790
.وعندما سطعت، طلبوا منّي أن يقابلوكما

16
00:02:34,950 --> 00:02:37,650
،بعد ذلك، ذهبتُ لرؤية بينّو

17
00:02:37,650 --> 00:02:40,790
وحدّثني عن أمور عديدة
."حول النّبلاء و"الملتهم

18
00:02:40,790 --> 00:02:43,880
"يبدو أنّ حمّى "الملتهم
.هي عبارة عن مانا فقط

19
00:02:43,880 --> 00:02:45,300
مانا؟

20
00:02:45,300 --> 00:02:49,960
قال بما أنّ الكأس المقدّسة السّاطعة
،أثبت أنّني أمتلك مانا

21
00:02:49,960 --> 00:02:53,770
فلم يعد بمقدوري الهرب
.من الكاتدرائيّة أو النّبلاء

22
00:02:54,520 --> 00:02:55,690
!لا

23
00:02:56,020 --> 00:03:01,180
،لكن تمتلك الكاتدرائيّة أدواتٍ سحريّة
.لذا يمكنني مواصلة العيش إذا انضممت

24
00:03:04,300 --> 00:03:05,690
أحقًّا؟

25
00:03:05,690 --> 00:03:10,150
لكن لن تتمكّني من رؤيتنا
إذا انضممت، صحيح؟

26
00:03:10,150 --> 00:03:12,270
.إذا بقيت الأمور على حالها، نعم

27
00:03:13,360 --> 00:03:16,320
.لا أريد أن أسلّمك للكاتدرائيّة

28
00:03:16,970 --> 00:03:19,460
...إذا أرسلتك إلى هناك لوحدك

29
00:03:21,360 --> 00:03:25,830
أبي. هل تعلم ما الّذي كان
يجري في العاصمة؟

30
00:03:26,250 --> 00:03:31,070
هل علمت بأنّ هناك عمليّة تطهير
قد وقعت وغيّرت الحال مع النّبلاء؟

31
00:03:31,460 --> 00:03:34,050
ما علاقة هذا بما نناقشه؟

32
00:03:34,050 --> 00:03:37,380
،في الواقع، بما أنّ عدد النّبلاء قد تناقص

33
00:03:37,380 --> 00:03:40,410
.يبدو أنّ الكاتدرائيّة في أمسّ الحاجة للمانا

34
00:03:40,410 --> 00:03:43,190
.لهذا يريدونني

35
00:03:43,900 --> 00:03:46,170
،حسبما رأيت وسمعت في البوّابة

36
00:03:46,170 --> 00:03:49,710
.يتناقص عدد النّبلاء فعلاً

37
00:03:50,620 --> 00:03:53,420
.ما قاله بينّو كان صحيحًا

38
00:03:53,420 --> 00:03:55,710
.إذًا قد يفلح هذا

39
00:03:56,030 --> 00:03:58,100
ماذا تعنين يا ماين؟

40
00:03:58,410 --> 00:04:01,150
.قال أنّني محظوظة

41
00:04:01,150 --> 00:04:03,040
،وأنّني بمفاوضة حريصة

42
00:04:03,040 --> 00:04:06,590
أستطيع تأمين علاج يشبه العلاج
.الّذي يتلقّاه نبيل

43
00:04:08,150 --> 00:04:09,850
.أخبريني بالمزيد

44
00:04:11,590 --> 00:04:15,470
.أوّلاً، تخيّلي النّتيجة الأفضل لنفسك

45
00:04:15,790 --> 00:04:19,870
ما التّنازلات الّتي تحتاجينها
منهم لتحقيق ذلك؟

46
00:04:19,870 --> 00:04:22,110
ما الّذي يمكنك تقديمه لهم؟

47
00:04:22,110 --> 00:04:24,580
ماذا يريدون؟

48
00:04:24,580 --> 00:04:25,870
.اكتشفي كلّ ذلك

49
00:04:26,230 --> 00:04:28,950
...ما أريده

50
00:04:29,610 --> 00:04:32,990
.هو إذن لدخول المكتبة وقراءة الكتب هناك

51
00:04:35,480 --> 00:04:38,970
من العجيب حقًّا أن تكوني
.بسيطة التّفكير هكذا الآن

52
00:04:38,970 --> 00:04:41,530
!إ-إنّها النّتيجة المثاليّة

53
00:04:41,530 --> 00:04:44,350
.إذا أردت أن أكون طمّاعة

54
00:04:47,290 --> 00:04:50,140
.ما يمكنني تقديمه لهم هو المانا والمال

55
00:04:50,140 --> 00:04:51,510
.هذا صحيح

56
00:04:52,000 --> 00:04:56,030
،ما دمت لا تفرّطين في هذه الأمور
.يمكنك ضمان شروط أفضل

57
00:04:56,430 --> 00:05:01,650
إن سارت الأمور بسلاسة، قد يتمّ
.قبولك ككاهنة متدرّبة برداءٍ أزرق

58
00:05:01,650 --> 00:05:08,410
لضمان هذا، قومي بتسجيل مشغل
.ماين وأمّني مصدر تدفّق عائدات

59
00:05:08,710 --> 00:05:09,820
،بالمناسبة

60
00:05:09,820 --> 00:05:15,000
سمعت أنّه لا يمكن الانضمام للكاتدرائيّة
.إذا سجّلت لدى النّقابة

61
00:05:15,000 --> 00:05:18,720
هل يمكنني تسجيل نفسي كرئيسة للمشغل؟

62
00:05:18,720 --> 00:05:23,790
قال كبير الكهنة أنّه سيتفاوض
...مع رئيس النّقابة

63
00:05:27,130 --> 00:05:30,100
!لا تتركي مصيرك بين يدي شخصٍ آخر

64
00:05:30,100 --> 00:05:33,150
إن لم تتمكّني من جعلهم
،يتقبّلون تسجيلك سلفًا

65
00:05:33,150 --> 00:05:36,590
فسدّدي بعض المال وادفعيهم
!للسّماح باستمرار عمل مشغلك

66
00:05:36,850 --> 00:05:42,360
ستكونين الوحيدة في الكاتدرائيّة
!الّتي تتعامل مع النّقابة

67
00:05:42,650 --> 00:05:43,870
!صحيح

68
00:05:43,870 --> 00:05:48,550
إن لزم الأمر، قولي أنّك تريدين استخدام
،مشغل ماين لتوفير عملٍ لليتامى

69
00:05:48,550 --> 00:05:52,790
،وتوفير بيئة أفضل لهم أو مثل هذا الهراء

70
00:05:52,790 --> 00:05:54,110
!ودافعيهم لقبول ملكيّتك

71
00:05:54,530 --> 00:05:57,480
،وأيضًا عمّمي حقيقة أنّك واهنة جسديًّا

72
00:05:57,480 --> 00:06:00,120
.وحاولي تأمين أفضل علاج ممكن

73
00:06:00,120 --> 00:06:03,500
!لا تهتمّي بالمظاهر! قاتلي لتعيشي

74
00:06:03,890 --> 00:06:06,320
.علم. سأحاول

75
00:06:07,300 --> 00:06:09,220
.هذا ما حدث

76
00:06:09,920 --> 00:06:12,890
.هناك مجالٌ للتّفاوض إذًا

77
00:06:12,890 --> 00:06:14,550
.هذا ما أعتقده

78
00:06:14,550 --> 00:06:18,270
.لهذا طلب منّي بينّو أن أقاتل لأعيش

79
00:06:18,670 --> 00:06:20,980
تقاتلين لتعيشي" إذًا؟"

80
00:06:21,900 --> 00:06:26,030
يمكن القول أنّ هناك أمل لنا، صحيح؟

81
00:06:26,330 --> 00:06:27,140
.نعم

82
00:06:27,750 --> 00:06:30,420
.ما يمكننا تقديمه هو المانا والمال

83
00:06:30,420 --> 00:06:33,150
ثمّ علينا التّأكيد على وهني

84
00:06:33,150 --> 00:06:36,020
.وتلقّيي العلاج كأيّ نبيل تقريبًا

85
00:06:36,020 --> 00:06:39,040
،وعلينا أيضًا إقناعهم بالسّماح لي بإدارة مشغلي

86
00:06:39,040 --> 00:06:42,540
.والاستمرار في العيش في المنزل

87
00:06:44,350 --> 00:06:48,250
،إذا وافقوا على هذه المتطلّبات الثّلاثة
.فأعتقد يمكننا القول أنّنا سنربح

88
00:06:49,890 --> 00:06:51,270
.سأجرّب ذلك

89
00:06:53,370 --> 00:06:57,030
!أصبحت جنديًّا لحماية عائلتي

90
00:07:14,350 --> 00:07:17,180
ما الخطب يا توري؟ ألا تستطيعين النّوم؟

91
00:07:22,650 --> 00:07:24,300
ما الأمر؟

92
00:07:25,700 --> 00:07:29,660
هل يمكنكم حقًّا التّفاوض مع النّبلاء؟

93
00:07:30,150 --> 00:07:33,300
ألا يقتلون النّاس لمجرّد الرّدّ عليهم؟

94
00:07:34,790 --> 00:07:38,140
...إذا أصابكم أيّ مكروه، فأنا

95
00:07:41,080 --> 00:07:42,290
!توري

96
00:07:45,620 --> 00:07:47,200
!أمّي

97
00:07:47,200 --> 00:07:50,400
!عودي إلى المنزل مع أبي أرجوك

98
00:07:57,390 --> 00:08:01,500
بعد يومين، كان الوقت قد حان
.للتّفاوض في الكاتدرائيّة

99
00:08:12,630 --> 00:08:15,140
أبي، قاتل لأجلي، اتّفقنا؟

100
00:08:15,730 --> 00:08:17,140
.لك ذلك

101
00:08:22,030 --> 00:08:25,530
.لا بدّ وأنّها مشيئة الآلهة

102
00:08:25,530 --> 00:08:27,760
.جاءت ماين ووالداها

103
00:08:29,340 --> 00:08:31,900
.مرحبًا يا كبير الكهنة

104
00:08:32,180 --> 00:08:35,350
.ماين. أهلاً وسهلاً

105
00:08:40,780 --> 00:08:42,910
من هذين يا ماين؟

106
00:08:42,910 --> 00:08:44,910
.والداي

107
00:08:45,260 --> 00:08:47,370
ماذا؟ والداك؟

108
00:08:48,070 --> 00:08:50,370
ما هو عملهما؟

109
00:08:51,740 --> 00:08:55,750
.أبي جنديّ وأمّي تعمل في ورشة نسيج

110
00:08:56,440 --> 00:08:57,860
جنديّ؟

111
00:09:02,890 --> 00:09:06,220
.لم أتوقّع أن يكونا بهذا الفقر

112
00:09:06,220 --> 00:09:08,400
.يا لها من مضيعة للوقت

113
00:09:09,020 --> 00:09:10,700
.تفضّلوا بالجلوس

114
00:09:10,700 --> 00:09:12,890
!لا حاجة! يمكنهم الوقوف

115
00:09:14,980 --> 00:09:17,890
ما هذا التّغيّر المفاجئ في الموقف؟

116
00:09:19,680 --> 00:09:23,650
.لننهِ هذه المسألة فحسب

117
00:09:24,070 --> 00:09:28,210
أعتقد أنتما مدركان أنّ ماين تريد
،أن تكون كاهنة متدرّبة

118
00:09:28,210 --> 00:09:30,170
.وأنّكما معارضان لذلك

119
00:09:30,170 --> 00:09:31,870
.هذا صحيح

120
00:09:31,870 --> 00:09:36,190
لا أرغب في التّخلّي عن ابنتي
.لتعيش كيتيمة

121
00:09:36,550 --> 00:09:39,000
."لكنّها مصابة بـ"الملتهم

122
00:09:39,000 --> 00:09:42,390
لا يمكنها مواصلة العيش من دون
.التّوصّل لأدواتٍ سحريّة

123
00:09:42,390 --> 00:09:45,690
.الكاتدرائيّة تتبنّاها بكرمٍ لإنقاذ حياتها

124
00:09:46,220 --> 00:09:50,240
جسد ماين ضعيفٌ جدًّا ولا يستطيع
.تحمّل العيش كيتيمة

125
00:09:50,240 --> 00:09:53,830
لا أريدكم أن تشغّلوها كأيّ كاهنة
.ذات رداء رماديّ

126
00:09:55,240 --> 00:09:56,510
!هذا صحيح

127
00:09:56,510 --> 00:09:59,540
!"إنّها فتاةٌ واهنة جدًّا حتّى من دون "الملتهم

128
00:09:59,540 --> 00:10:01,520
!لا يمكنها النّجاة في الكاتدرائيّة

129
00:10:01,990 --> 00:10:05,290
.أرجوكم... دعوها تعيش في المنزل أرجوكم

130
00:10:06,160 --> 00:10:07,710
!وضيعان وقحان

131
00:10:07,710 --> 00:10:11,160
!تجرآن على التّذمّر من عرضنا السّخيّ؟

132
00:10:11,450 --> 00:10:13,790
!اصمتا وسلّما ابنتكما

133
00:10:14,570 --> 00:10:18,540
ماذا؟ هذا نبيل؟

134
00:10:18,830 --> 00:10:20,710
.أنا مضطرٌّ للرّفض

135
00:10:20,710 --> 00:10:25,390
.لن أرمي ابنتي في ميتم

136
00:10:26,780 --> 00:10:29,890
!هذا صحيح! تحلّ بالرّحمة أرجوك

137
00:10:33,310 --> 00:10:34,870
!كيف تجرآن؟

138
00:10:34,870 --> 00:10:40,400
!أمسكوا هذين الأبوين الوقحين واحتجزوا ماين

139
00:10:56,330 --> 00:11:01,470
!أمسكوا هذين الأبوين الوقحين واحتجزوا ماين

140
00:11:01,840 --> 00:11:03,350
.تراجعوا

141
00:11:03,350 --> 00:11:06,330
تريد المقاومة؟

142
00:11:08,340 --> 00:11:11,240
!فسوف آمر بإعدامك باسم الرّبّ

143
00:11:11,240 --> 00:11:16,190
كنت مستعدًّا للموت في لحظة قراري
!بالقتال لأجل ماين

144
00:11:16,420 --> 00:11:19,020
!اللّعنة! أحضروا ماين

145
00:11:19,020 --> 00:11:21,270
.لنمسك الرّجل أوّلاً

146
00:11:38,970 --> 00:11:40,430
!أيّها الوغد

147
00:11:45,290 --> 00:11:47,840
،استطعت إسقاط البعض

148
00:11:47,840 --> 00:11:50,750
لكن كيف ستصمد أمام هذا العدد الكبير؟

149
00:11:52,840 --> 00:11:56,070
أيعتقد مجرّد شخص عاديّ أنّه يستطيع
تحدّي الكاتدرائيّة؟

150
00:11:56,070 --> 00:11:57,810
!ستعدم بالمقصلة

151
00:12:00,180 --> 00:12:03,020
.ستموت ميتة كلب

152
00:12:04,520 --> 00:12:05,790
!نالوا منه

153
00:12:20,390 --> 00:12:22,220
.يكفي

154
00:12:23,560 --> 00:12:24,640
ماين؟

155
00:12:28,290 --> 00:12:33,100
.إيّاكم ولمس أمّي وأبي

156
00:12:40,580 --> 00:12:44,130
.دعوتنا إلى هنا لنتناقش

157
00:12:44,130 --> 00:12:45,880
أهذا ما تعتبره نقاشًا؟

158
00:12:47,350 --> 00:12:48,980
!ا-النّجدة

159
00:12:50,730 --> 00:12:53,270
!ماين! المانا خاصّتك تتسرّب

160
00:12:53,270 --> 00:12:54,950
!تحكّمي بعواطفك

161
00:13:00,700 --> 00:13:02,730
كيف يفترض بي فعل ذلك؟

162
00:13:03,860 --> 00:13:07,720
.كما... تفعلين دومًا

163
00:13:07,720 --> 00:13:13,360
كيف يفترض لي أن أقمع غضبي
تجاه رجل يريد أن يعدم أبي؟

164
00:13:20,180 --> 00:13:22,150
!ا-ابتعدي

165
00:13:22,150 --> 00:13:26,600
!توقّفي! إذا استمررت، فسوف تسحقين قلبه

166
00:13:26,870 --> 00:13:29,860
.كان جاهزًا لقتل شخص

167
00:13:30,860 --> 00:13:34,380
أنا متأكّدة أنّه كان جاهزًا
.للمخاطرة بحياته أيضًا

168
00:13:48,310 --> 00:13:49,190
!ماين

169
00:13:50,880 --> 00:13:51,930
.ابتعد

170
00:13:52,230 --> 00:13:54,880
!اهدئي! لنسوّ الخلافات

171
00:13:55,600 --> 00:13:57,580
لنسوّ الخلافات"؟"

172
00:13:57,580 --> 00:14:00,890
...باستخدام القوّة؟ أم

173
00:14:01,270 --> 00:14:02,590
باستخدام المانا؟

174
00:14:11,330 --> 00:14:13,730
.ليس عليك قتله

175
00:14:15,990 --> 00:14:18,790
،إذا قتلت كبير الكهنة

176
00:14:18,790 --> 00:14:22,000
.فسيجعل هذا عائلتك من قتلة النّبلاء

177
00:14:23,100 --> 00:14:26,120
.وأعلم أنّك لا تريدين ذلك

178
00:14:27,980 --> 00:14:31,760
حتّى عائلتي ستتأذّى بسببي؟

179
00:14:39,380 --> 00:14:41,280
.أرى أنّك عدت إلى رشدك

180
00:14:42,210 --> 00:14:46,350
.لنجر النّقاش الّذي أتيتم لأجله

181
00:14:47,090 --> 00:14:50,650
هل تعني أنّكم ستقبلون بمتطلّباتنا؟

182
00:14:51,660 --> 00:14:52,900
.نعم

183
00:14:53,980 --> 00:14:57,650
لكن قبل ذلك، يجب عليك أن تضعي المانا
.الهائجة خاصّتك تحت السّيطرة

184
00:14:58,350 --> 00:14:59,670
هل يمكنك فعل ذلك؟

185
00:15:03,650 --> 00:15:08,100
.عليّ حبسها في الدّاخل كما أفعل دومًا

186
00:15:15,970 --> 00:15:17,090
!ماين

187
00:15:17,090 --> 00:15:18,420
هل أنت بخير؟

188
00:15:25,120 --> 00:15:26,790
.أنا بخير

189
00:15:26,790 --> 00:15:30,480
.اعتدت على ذلك، وأنا أتحكّم بنفسي الآن

190
00:15:31,450 --> 00:15:34,330
اعتدت على ذلك؟ تقصدين
أنّ ذلك حدث سابقًا؟

191
00:15:34,330 --> 00:15:37,880
،ليس إلى هذا الحدّ

192
00:15:37,880 --> 00:15:40,010
.لكن كان ذلك يحدث كثيرًا

193
00:15:40,010 --> 00:15:41,620
.لم أكن أعلم

194
00:15:42,840 --> 00:15:46,660
المعذرة، هل أنت بخير يا رئيس الكهنة؟

195
00:15:48,640 --> 00:15:51,400
.هذه عقوبتي

196
00:15:52,040 --> 00:15:57,180
استحققت هذا لأنّني لم أمنع
.كبير الكهنة من معاداتك

197
00:15:59,140 --> 00:16:04,090
لم أتوقّع أن يعصي والداك
.العاديّان أوامر نبيل

198
00:16:04,850 --> 00:16:09,690
.ماين هي ابنتي. قلت هذا مرارًا

199
00:16:16,440 --> 00:16:17,630
.ماين

200
00:16:17,630 --> 00:16:23,090
.أحسدك على هذين الأبوين المحبّين

201
00:16:23,980 --> 00:16:27,150
،سواء أكانوا يتامى أو نبلاء

202
00:16:27,150 --> 00:16:30,410
الجميع في الكاتدرائيّة قد نبذوا
.بواسطة آبائهم

203
00:16:34,350 --> 00:16:40,090
عقب ذلك، انتقلنا إلى غرفة
.رئيس الكهنة للحوار

204
00:16:40,500 --> 00:16:44,980
ماذا كان ذلك الّذي فعلته
ماين قبل قليل؟

205
00:16:44,980 --> 00:16:46,340
هل تقصد "السّحق"؟

206
00:16:46,340 --> 00:16:49,200
يدعى بـ"السّحق"؟

207
00:16:49,200 --> 00:16:51,530
،تلوّنت عينا ماين

208
00:16:51,530 --> 00:16:54,350
.وأخذ جسدها يبعث هالةً من نوع ما

209
00:16:57,020 --> 00:17:01,610
ما هذا؟ لم أتوقّع أن أتحوّل
!إلى شكلٍ غريبٍ كهذا

210
00:17:01,940 --> 00:17:06,170
"يحدث هذا عندما يسمح مصابٌ بـ"الملتهم
.لعواطفه بالخروج عن السّيطرة

211
00:17:06,720 --> 00:17:09,460
تتفعّل المانا خاصّته وتجري في أنحاء جسده

212
00:17:09,460 --> 00:17:11,960
.و"تسحق" عدوّه

213
00:17:12,410 --> 00:17:16,020
غالبًا ما يحدث هذا مع الأطفال باعتبارهم
.لا يستطيعون التّحكّم بعواطفهم

214
00:17:16,330 --> 00:17:18,250
ألم تريا هذا من قبل؟

215
00:17:18,250 --> 00:17:21,990
لاحظت تغيّرًا في لون عينيها
.عدّة مرّات سابقًا

216
00:17:22,690 --> 00:17:26,410
،دائمًا ما كان يحدث ذلك أثناء نوبة غضبها
.لكن سرعان ما كانت تتوقّف

217
00:17:26,410 --> 00:17:28,200
...نعم، أتذكّر ذلك

218
00:17:28,200 --> 00:17:29,510
!حقًّا؟

219
00:17:30,970 --> 00:17:35,410
أنا مندهشة من تربيتهما فتاة غريبة
.الأطوار كهذه بكلّ حبّ وحنان

220
00:17:42,310 --> 00:17:45,660
"سمعت أنّ أولئك المصابين بـ"الملتهم
،لديهم كثير من المانا

221
00:17:45,660 --> 00:17:49,700
لكن لم أتوقّع أبدًا أن تكادي
.تقتلين كبير الكهنة

222
00:17:50,570 --> 00:17:52,180
،قد يكون هذا سؤالاً غريبًا

223
00:17:52,960 --> 00:17:54,780
لكن كيف ما زلت على قيد الحياة؟

224
00:17:56,210 --> 00:18:01,520
كلّما كانت المانا خاصّتك أقوى، ازدادت
.حاجتك لإرادة أقوى للتّحكّم بها

225
00:18:01,520 --> 00:18:04,820
لا أفهم كيف ما زلت على قيد الحياة نظرًا
.إلى كمّية المانا الكبيرة الّتي تمتلكينها

226
00:18:06,650 --> 00:18:09,070
.ينبغي أن تكوني ميتة سلفًا

227
00:18:09,490 --> 00:18:14,110
لكن هناك شخص لطيف سمح لي
.باستخدام أداة سحريّة أثناء الاحتضار

228
00:18:15,010 --> 00:18:19,530
ألم تحاولي أن تبرمي اتّفاقية
مع نبيل من خلالهم؟

229
00:18:20,130 --> 00:18:24,760
.لا جدوى من عيش حياةٍ مقيّدة بنبيل

230
00:18:27,080 --> 00:18:29,890
.أردت البقاء مع عائلتي

231
00:18:31,000 --> 00:18:32,890
.أردت صنع كتبي الخاصّة

232
00:18:33,530 --> 00:18:37,670
،إذا لم أستطع عيش حياتي مثلما أريد
.فلا جدوى من الحياة إذًا

233
00:18:48,900 --> 00:18:51,480
.أجد صعوبةً في فهم هذه العقليّة

234
00:18:54,060 --> 00:18:57,200
.ماين، أريدك أن تنضمّي للكاتدرائيّة

235
00:18:57,720 --> 00:18:59,960
.هذا طلب، لا أمر

236
00:19:01,100 --> 00:19:04,000
.أنا المسؤول عن الشّؤون اليوميّة هنا

237
00:19:04,000 --> 00:19:06,610
.سأوفّر لك أفضل بيئة ممكنة

238
00:19:06,610 --> 00:19:10,000
.وبالطّبع، ستُنسى أحداث اليوم كذلك

239
00:19:13,620 --> 00:19:18,630
التزم رئيس الكهنة بكلامه
،وقبل بكلّ متطلّباتنا

240
00:19:19,330 --> 00:19:22,790
.وسأصبح كاهنة متدرّبة برداءٍ أزرق

241
00:19:30,560 --> 00:19:32,210
.انتهى الأمر

242
00:19:32,210 --> 00:19:33,090
.نعم

243
00:19:33,890 --> 00:19:37,640
.أبي، أمّي. شكرًا على القتال لأجلي

244
00:19:37,640 --> 00:19:41,290
أنت من أنقذ حياتنا بذلك
."الّذي يدعى "سحق

245
00:19:42,240 --> 00:19:44,760
خرجت الحمّى عن السّيطرة
.لأنّني استشطت غضبًا

246
00:19:44,760 --> 00:19:46,920
.بصراحة، لا أتذكّر ما حدث تمامًا

247
00:19:51,810 --> 00:19:54,590
.لكن لم تبدأ المعركة الحقيقيّة بعد

248
00:19:54,590 --> 00:19:55,450
.نعم

249
00:19:56,240 --> 00:19:59,050
.مع ذلك، أنا مطمئنّة الآن

250
00:20:00,200 --> 00:20:04,290
ما دام رئيس الكهنة هناك، أظنّك
.ستكونين بخير في الكاتدرائيّة

251
00:20:04,290 --> 00:20:06,040
رئيس الكهنة؟ لماذا؟

252
00:20:06,340 --> 00:20:09,110
أعني أنّه أوقفك، أتتذكّرين؟

253
00:20:09,110 --> 00:20:13,190
من المهمّ وجود شخصٍ يوقفك ويوبّخك
.عندما تفقدين السّيطرة

254
00:20:13,190 --> 00:20:16,190
!تبًا! ينتابني إحساس بأنّه سيوبّخني كثيرًا

255
00:20:31,860 --> 00:20:34,140
.ستكون ماين بخير حتمًا

256
00:20:34,620 --> 00:20:36,830
.فلديها أبوك وأمّك

257
00:20:36,830 --> 00:20:37,820
...نعم

258
00:20:40,600 --> 00:20:42,670
!توري

259
00:20:45,980 --> 00:20:48,380
!توري

260
00:20:50,530 --> 00:20:51,890
...أنتم

261
00:20:53,100 --> 00:20:54,410
!ماين

262
00:21:06,860 --> 00:21:09,870
.ماين... أهلاً بعودتك

263
00:21:11,400 --> 00:21:12,880
...لقد عدت

264
00:21:14,870 --> 00:21:16,410
!توري

265
00:22:58,480 --> 00:23:00,370
!مرحى

266
00:22:58,480 --> 00:23:35,010
انتهى الجزء الأوّل

267
00:23:00,370 --> 00:23:03,550
!بلغنا المشهد الأخير من الجزء الأوّل

268
00:23:03,550 --> 00:23:06,640
نجحت المفاوضات نجاحًا باهرًا، وأستطيع
!مواصلة العيش مع عائلتي

269
00:23:06,640 --> 00:23:10,450
!يا رئيس الكهنة، ستراني في الكاتدرائيّة قريبًا

270
00:23:10,450 --> 00:23:14,860
!يمكنني قراءة بعض الكتب أخيرًا! مرحى

271
00:23:14,860 --> 00:23:18,140
.طريقة احتفالك تجعلني أقلق رغمًا عنّي

272
00:23:18,140 --> 00:23:20,400
.يبدو أنّك لا تفكّرين سوى بالكتب

273
00:23:20,000 --> 00:23:35,010
تذمّر
تذمّر

274
00:23:20,400 --> 00:23:23,680
هل تعين أنّك ستنضمّين للكاتدرائيّة
ككاهنة متدرّبة؟

275
00:23:23,680 --> 00:23:27,010
.سيكون أمامك الكثير لتفعلينه وتتعلّمينه

276
00:23:23,750 --> 00:23:35,010
نكز
نكز

277
00:23:27,010 --> 00:23:30,070
وأيضًا صنع لك رداء أزرق
...رغم كونك من العامّة

278
00:23:30,070 --> 00:23:35,010
!لا! من المبكّر جدًّا على كلّ هذا