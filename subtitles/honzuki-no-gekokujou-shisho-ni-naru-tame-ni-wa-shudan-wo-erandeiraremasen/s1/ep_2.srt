1
00:00:01,190 --> 00:00:05,400
الفتاةُ الّتي تمنّت قراءة الكثير
،من الكتب حتّى بعد مماتِها

2
00:00:05,400 --> 00:00:10,000
،بدأت حياةً جديدة في هذا العالم باسم ماين
.ابنة لعائلة مكافِحة

3
00:00:10,680 --> 00:00:12,700
...ليتَ لديّ كتابًا أطالعه

4
00:00:13,460 --> 00:00:16,210
،نعم، ما دمتُ أمتلك كتبًا

5
00:00:16,700 --> 00:00:19,250
.يمكنني تدبُّر الأمور أينما كنت

6
00:00:19,490 --> 00:00:22,250
.غير أنّ الكتب باهظة الثّمن في هذا العالم

7
00:00:22,250 --> 00:00:26,880
أتعرف محلاًّ يبيع كتبًا؟ أين هو؟

8
00:00:27,130 --> 00:00:30,130
.محلّ؟ لا يوجد محلٌّ كهذا

9
00:00:30,400 --> 00:00:34,240
.تُخَطُّ الكتب باليد كما تعلمين

10
00:00:34,240 --> 00:00:38,150
تكلّف كثيرًا من المال، لدرجة قلّما
.تجدين مِن النّاس مَن يشترونها

11
00:00:38,640 --> 00:00:40,590
...وهكذا توصّلت لقرار

12
00:00:40,840 --> 00:00:43,980
إذا لم تستطع الحصول على كتاب
.لمُطالعته، فعليها أن تصنعه بنفسها

13
00:00:46,250 --> 00:00:47,780
.سوف أصنع كتابًا

14
00:00:48,540 --> 00:00:50,430
.كتابي الخاصّ

15
00:02:36,010 --> 00:02:38,470
.انسي ذلك. لا أكترث لما يتطلّبه الأمر

16
00:02:38,470 --> 00:02:40,830
سوف أحصل على كتبي
.ولو كان آخر عمل أقوم به

17
00:02:40,830 --> 00:02:42,260
!لن أسمح لهذا العالم أن يهزمني

18
00:02:43,220 --> 00:02:46,610
لكن من أين أشتري ورقًا؟

19
00:02:46,940 --> 00:02:50,540
تذكّرت! ربّما يمكنني أن أكتشف
.من خلال البحث في ذكريات ماين

20
00:02:50,540 --> 00:02:56,600
...ورق، ورق، ورق

21
00:02:58,420 --> 00:03:02,150
!لا! لا أملك أيّ ذكريات متعلِّقة بالورق

22
00:03:02,150 --> 00:03:08,200
!وشعري يبدو كورق صنفرة! يحكّني كثيرًا

23
00:03:06,970 --> 00:03:08,200
.لقد عُدت

24
00:03:08,440 --> 00:03:10,690
.أهلاً بعودتِك يا توري. شكرًا لك

25
00:03:11,380 --> 00:03:14,820
.لا يوجد في هذا العالم كتب أو مدارس

26
00:03:15,210 --> 00:03:18,900
الأطفال هنا إمّا يساهمون في أعمال
.المنزل أو يذهبون إلى العمل

27
00:03:18,900 --> 00:03:19,920
.أمّي

28
00:03:20,200 --> 00:03:22,710
.استطعتُ قطف بعض من فاكهةِ ميريل اليوم

29
00:03:23,130 --> 00:03:24,710
.تشبه الأفوكادو

30
00:03:24,970 --> 00:03:27,710
.لنستخلص الزّيت منها بينما هي طازجة

31
00:03:27,710 --> 00:03:29,520
.جهّزي الأمور يا توري

32
00:03:29,520 --> 00:03:30,350
.حاضرة

33
00:03:30,680 --> 00:03:33,840
زيت؟ يمكنُ استخلاص الزّيت من فاكهة ميريل؟

34
00:03:34,750 --> 00:03:35,970
نعم، لماذا؟

35
00:03:37,290 --> 00:03:39,120
!يمكنني صنع شامبو

36
00:03:39,450 --> 00:03:41,010
.تحسين الحياة

37
00:03:41,010 --> 00:03:42,950
!مرحى

38
00:03:43,360 --> 00:03:47,070
يمكنني غسل شعري للمرّة الأولى
!منذ أسبوع

39
00:03:48,060 --> 00:03:53,120
عندما كنتُ أورانو، صنعتُ كثيرًا من
،الصّابون المنزليّ والشّامبو مع أمّي

40
00:03:53,120 --> 00:03:55,040
.لذلك أعرف كيفيّة فعل ذلك

41
00:03:55,300 --> 00:03:57,900
،إذا استخلصتُ زيتًا من فاكهة ما

42
00:03:57,900 --> 00:04:01,390
،واستخدمتُ بعضًا من الأعشاب للتّعطير
...وأضفتُ رشّة ملح

43
00:04:01,390 --> 00:04:03,750
!فينبغي أن أحصل على شامبو خاصّ بي

44
00:04:04,440 --> 00:04:05,710
.توري

45
00:04:06,520 --> 00:04:09,800
هلاّ أعطيتني بعضًا من فاكهة ميريل؟

46
00:04:09,800 --> 00:04:11,810
.أودّ استخلاص الزّيت لنفسي

47
00:04:12,070 --> 00:04:14,320
تريدين تجربة ذلك أيضًا يا ماين؟

48
00:04:14,320 --> 00:04:14,970
.بالتّأكيد

49
00:04:16,140 --> 00:04:17,260
.اسمعي

50
00:04:17,260 --> 00:04:20,580
عليكِ لفّها بقطعةِ قماش
...وذلك كي لا تطرطش

51
00:04:24,230 --> 00:04:27,660
مـ-ماين؟ ماذا تعتقدين أنّك تفعلين؟

52
00:04:28,540 --> 00:04:33,760
هكذا إذًا. كان ينبغي أن ألفّها بقطعة
.قماش وذلك كي لا تطرطش

53
00:04:33,760 --> 00:04:35,140
ماين؟

54
00:04:38,120 --> 00:04:40,340
!لا تلعبي بالطّعام

55
00:04:41,710 --> 00:04:43,140
!انتهيت

56
00:04:43,760 --> 00:04:46,060
.ماين، غُلي الماء الآن

57
00:04:50,810 --> 00:04:52,490
.رائحة زكيّة

58
00:04:53,450 --> 00:04:55,260
!ماذا تفعلين؟

59
00:04:55,260 --> 00:04:57,430
.أغسل شعري

60
00:05:06,440 --> 00:05:07,750
ما-ماذا؟

61
00:05:07,750 --> 00:05:11,710
لماذا يبدو شعرك كسماء اللّيل الآن؟

62
00:05:11,990 --> 00:05:13,520
ماذا صنعتِ للتّوّ؟

63
00:05:14,210 --> 00:05:16,080
...في الحقيقة

64
00:05:17,150 --> 00:05:21,080
.شامبو بسيط شامل المزايا على ما أعتقد

65
00:05:25,130 --> 00:05:27,880
،عندما تخرج أمّي للعمل

66
00:05:27,880 --> 00:05:30,040
.أهتمّ أنا وتوري بالمنزل

67
00:05:30,630 --> 00:05:33,130
!نسي أبي أن يأخذ هذا

68
00:05:33,720 --> 00:05:37,830
أليس هذا ما كان يستعجل
أمّي لتحضّره منذ مدّة؟

69
00:05:37,830 --> 00:05:40,950
.نعم. سوف تغضب كثيرًا إذا علمت بالأمر

70
00:05:40,950 --> 00:05:43,160
.وهو سوف يحتاجه أيضًا

71
00:05:43,160 --> 00:05:44,650
.يجدر بنا أن نسلّمه إيّاه

72
00:05:45,480 --> 00:05:47,910
ماين، أتعتقدين أنّكِ تستطيعين
السّير إلى البوّابة؟

73
00:05:52,080 --> 00:05:53,440
هل أنتِ بخير؟

74
00:05:56,270 --> 00:05:59,680
لا عجب في إصرار أمّي على
.حملي على ظهرها

75
00:06:03,670 --> 00:06:05,810
.ربّما ما كان ينبغي أن نفعل هذا

76
00:06:05,810 --> 00:06:07,930
.لا تستطيعين تحمُّل ذلك بعد

77
00:06:07,930 --> 00:06:09,700
...سأكون بخير

78
00:06:09,700 --> 00:06:12,320
...إذا مشينا... بهدوء ورويّة

79
00:06:12,320 --> 00:06:13,970
ماذا؟ توري؟

80
00:06:14,570 --> 00:06:17,070
.رالف؟ لوتز وفاي أيضًا

81
00:06:17,690 --> 00:06:19,570
.مذهل! فرقة بألوان شعر مختلفة

82
00:06:19,570 --> 00:06:21,460
هل ستذهبون إلى الغابة؟

83
00:06:21,460 --> 00:06:24,060
نعم. ماذا تفعلان؟

84
00:06:24,060 --> 00:06:28,940
كنّا نفكّر في الذّهاب إلى البوّابة
.لتسليم شيء نسيه أبي

85
00:06:29,320 --> 00:06:31,730
هل هم جيران؟

86
00:06:34,810 --> 00:06:35,960
.توقّعت ذلك

87
00:06:36,190 --> 00:06:38,710
،رالف، ذو الشّعر الأحمر
.هو في نفس عمر توري

88
00:06:38,710 --> 00:06:40,650
.إنّه الثّالث بين أربعة إخوة

89
00:06:41,110 --> 00:06:44,450
.وفاي في نفس العمر أيضًا
.إنّه ابن عمّ رالف

90
00:06:45,660 --> 00:06:48,770
.ولوتز الأشقر هو أخو رالف الصّغير

91
00:06:48,770 --> 00:06:50,970
.إنّه في سنِّ الخامسة، أي في مثل سنّي

92
00:06:58,270 --> 00:07:00,220
ماين! هل أنتِ بخير؟

93
00:07:00,220 --> 00:07:03,260
.نعم. إنّه دُوار بسيط فحسب

94
00:07:07,030 --> 00:07:10,030
.لا أستطيع حتّى النّهوض بعد السّقوط

95
00:07:10,030 --> 00:07:12,930
.هذا الجسد واهنٌ حقًّا

96
00:07:12,930 --> 00:07:14,830
ماين، هل أنتِ بخير؟

97
00:07:18,040 --> 00:07:21,050
.ستذهبين إلى البوّابة، صحيح؟ سأوصلك

98
00:07:21,650 --> 00:07:23,190
.لوتز

99
00:07:23,190 --> 00:07:25,450
.لا يمكنك فعل ذلك بعد

100
00:07:25,450 --> 00:07:27,120
.أستطيع أيضًا

101
00:07:27,120 --> 00:07:28,630
.سأحملها أنا

102
00:07:29,950 --> 00:07:31,000
.تعالي

103
00:07:33,730 --> 00:07:35,580
.شكرًا على الخدمة يا لوتز

104
00:07:35,580 --> 00:07:39,270
،لكنّ رالف معتادٌ على ذلك
.لذا دعه يحملها

105
00:07:40,500 --> 00:07:41,780
.حسنًا

106
00:07:42,980 --> 00:07:46,780
.لوتز، أسعدني قلقك عليّ

107
00:07:48,520 --> 00:07:51,410
.أنت لطيفٌ جدًّا. شكرًا لك

108
00:07:57,580 --> 00:07:59,350
رالف، هل أنت بخير؟

109
00:07:59,350 --> 00:08:02,420
.نعم. ماين صغيرة وخفيفة

110
00:08:02,730 --> 00:08:04,420
.أشكرك من أعماق قلبي

111
00:08:05,210 --> 00:08:06,360
.العفو

112
00:08:06,650 --> 00:08:10,830
،يا ولدي العزيز رالفي
هل أنت منجذبٌ نحو أختي؟

113
00:08:17,280 --> 00:08:18,320
.توري

114
00:08:21,020 --> 00:08:22,090
ما الأمر؟

115
00:08:26,500 --> 00:08:29,050
.رائحتكِ زكيّة

116
00:08:30,790 --> 00:08:32,070
حقًّا؟

117
00:08:35,790 --> 00:08:39,280
هل سمعت أيّها المتفرّج؟
."يقول "رائحتك زكيّة

118
00:08:39,280 --> 00:08:41,330
!من يكون؟ البطل في مانغا شوجو؟

119
00:08:43,090 --> 00:08:46,650
.في الواقع، أنا من غسل شعر توري

120
00:08:46,650 --> 00:08:48,330
تبدو أجمل الآن، صحيح؟

121
00:08:48,960 --> 00:08:51,440
!حتّى شعري بات حريريًّا الآن

122
00:08:51,440 --> 00:08:52,880
.نعم، ورائحته رائعة

123
00:08:53,400 --> 00:08:55,390
.حسنًا، حان وقت التّخلّص من هذا

124
00:08:55,390 --> 00:08:56,210
.نعم

125
00:08:56,210 --> 00:08:57,140
!انتظرا

126
00:08:59,470 --> 00:09:00,900
أمّي؟

127
00:09:01,120 --> 00:09:04,860
لكن لم أتوقّع أن تكون أمّي
.لا تزال مهتمّة بمظهرها

128
00:09:09,600 --> 00:09:11,520
.رائحة شعرك زكيّة أيضًا

129
00:09:13,000 --> 00:09:17,150
وتبدين أجمل الآن بعد أن رُبِط
.ورُفِع شعرك ولم يعد يغطّي وجهك

130
00:09:23,170 --> 00:09:26,450
!ماذا؟ كان ذلك مفاجئًا؟

131
00:09:26,450 --> 00:09:31,390
لم يسبق أن تعرّضتُ لموقفٍ كهذا طوال
.سنواتي الماضية، لذا لا أعرف كيف أردّ

132
00:09:33,800 --> 00:09:37,340
!أنا شخصيّة خجولة جدًّا ومحتشِمة

133
00:09:37,340 --> 00:09:41,300
!سيصيبُني هذا العالم بنوبة قلبيّة

134
00:09:48,310 --> 00:09:49,320
.ماين

135
00:09:50,470 --> 00:09:52,970
.انظري، وصلنا إلى البوّابة الجنوبيّة

136
00:09:53,930 --> 00:09:55,190
.أبي

137
00:09:56,440 --> 00:09:58,110
توري؟ ما الأمر؟

138
00:09:58,720 --> 00:10:00,270
.نسيت هذا

139
00:10:00,510 --> 00:10:02,530
!شكرًا لك

140
00:10:03,410 --> 00:10:06,410
انفصل عنّا لوتز ورفيقاه وتابعوا
،طريقهم نحو الغابة

141
00:10:06,410 --> 00:10:09,520
.بينما دخلنا نحن إلى البوّابة

142
00:10:09,840 --> 00:10:13,920
أحضرتا لك شيئًا نسيته؟
.ابنتاك لطيفتان جدًّا

143
00:10:14,270 --> 00:10:15,430
أليستا كذلك؟

144
00:10:15,430 --> 00:10:18,920
!إنّهما ابنتاي، أذكى وأظرف فتاتين في العالم

145
00:10:19,920 --> 00:10:22,250
.ها هو القائد يتبجّح بفتاتيه من جديد

146
00:10:22,900 --> 00:10:24,550
!ما أظرفكما

147
00:10:23,790 --> 00:10:25,280
!كفَّ عن ذلك

148
00:10:32,760 --> 00:10:35,460
أبي، هل حدث شيء؟

149
00:10:35,460 --> 00:10:37,690
.لا بدَ وأنّ شخصيّة بارزة قد أتت

150
00:10:38,070 --> 00:10:39,560
شخصيّة بارزة؟

151
00:10:40,180 --> 00:10:44,320
كنبيل مثلاً يقتضي وصوله
،أن نبلغ الحاكم عنه

152
00:10:44,320 --> 00:10:46,270
.أو شيء من هذا القبيل

153
00:10:46,270 --> 00:10:47,090
.يا قائد

154
00:10:47,280 --> 00:10:48,520
.أوتّو

155
00:10:55,100 --> 00:10:57,460
أهكذا تُلقى التّحيّة هنا؟

156
00:10:58,640 --> 00:11:01,040
.بلّغني بتقريرك يا أوتّو

157
00:11:01,040 --> 00:11:04,650
.يطلب الكونت لوينهارت أن تُفتح البوّابة

158
00:11:04,650 --> 00:11:06,080
ماذا عن ختمه؟

159
00:11:06,080 --> 00:11:07,410
.تمّ تفقُّده

160
00:11:07,410 --> 00:11:08,760
.حسنًا. دعه يعبر

161
00:11:10,540 --> 00:11:13,410
أبي رائع جدًّا عندما ينخرط
.في جوّ العمل

162
00:11:13,410 --> 00:11:14,780
...صـ-صحيح

163
00:11:20,750 --> 00:11:22,240
!هذا ورق

164
00:11:31,360 --> 00:11:32,660
!كتابة حقيقيّة

165
00:11:33,440 --> 00:11:36,510
.ماين، لا تعرقلي عملي

166
00:11:36,510 --> 00:11:38,490
أبي، ما هذا؟

167
00:11:39,370 --> 00:11:41,290
.إنّه برشمان

168
00:11:41,290 --> 00:11:43,790
.ورق مصنوع من جلود الخراف والماعز

169
00:11:43,790 --> 00:11:45,420
...برشمان

170
00:11:47,600 --> 00:11:50,220
.أتوسّل إليك يا أبي

171
00:11:50,220 --> 00:11:52,020
.اشترِ لي بعضًا منه

172
00:11:52,020 --> 00:11:53,510
.لا

173
00:11:53,510 --> 00:11:55,890
!أنا بأمسّ الحاجة إليه

174
00:11:56,160 --> 00:11:58,170
.إنّه ليس شيئًا ليلعب به الأطفال

175
00:11:58,550 --> 00:12:00,910
ناهيكِ عن أنّك لا تجيدين
.القراءة ولا الكتابة

176
00:12:00,910 --> 00:12:02,820
...هذا صحيح

177
00:12:06,870 --> 00:12:10,570
لكن يا قائد، أنت لا تجيد
.الكتابة بحدِّ ذاتك

178
00:12:11,570 --> 00:12:14,580
ماذا؟ لا تجيد الكتابة؟

179
00:12:14,810 --> 00:12:17,770
عمل الجنديّ هو الحفاظ على الأمن
!وتطبيق القانون في البلدة

180
00:12:17,770 --> 00:12:21,960
ما دمنا نعرف كيفيّة كتابة
.أسماء النّاس، فهذا يكفي

181
00:12:21,960 --> 00:12:24,170
.سأتعلّم

182
00:12:24,170 --> 00:12:25,920
هلاّ اشتريتَه لي إذًا؟

183
00:12:25,920 --> 00:12:30,380
.يكلّف كلّ واحد منه راتب شهرٍ كامل
.لا أستطيع إنفاق هذا المبلغ على طفلة

184
00:12:30,380 --> 00:12:31,470
!شهر كامل؟

185
00:12:31,740 --> 00:12:35,820
وأيضًا لا يبيعون ورقًا في المحلاّت
.الّتي يتردّد عليها العامّة

186
00:12:37,190 --> 00:12:40,860
!اللّعنة على الفقر

187
00:12:43,600 --> 00:12:46,680
،إذا أردت أن تتعلّمي كيفيّة القراءة والكتابة
فلمَ لا تستخدمين لوحًا أُردوازيًّا؟

188
00:12:47,840 --> 00:12:51,320
إن كنتِ لا تُمانعين استخدام لوحي
.القديم، فيمكنكِ الحصول عليه

189
00:12:53,340 --> 00:12:54,590
هل أنت متأكّد؟

190
00:12:54,590 --> 00:12:56,950
.نعم. سأحضره معي لاحقًا

191
00:12:58,290 --> 00:13:00,440
!شكرًا لك يا سيّد أوتّو

192
00:13:00,440 --> 00:13:02,960
!أرجوك علّمني كيفيّة القراءة والكتابة

193
00:13:03,190 --> 00:13:04,930
.بالتّأكيد يا ماين

194
00:13:04,930 --> 00:13:06,960
!أعتمد عليك

195
00:13:07,370 --> 00:13:09,110
.لكِ ذلك

196
00:13:09,510 --> 00:13:11,970
!أحبُّك يا سيّد أوتّو

197
00:13:13,330 --> 00:13:14,680
!مرحى

198
00:13:13,810 --> 00:13:15,640
!أوتّو

199
00:13:26,820 --> 00:13:28,930
،مع اقتراب الخريف من نهايته

200
00:13:28,930 --> 00:13:32,460
بدأ النّاس هنا في التّحضير للشّتاء
.الطّويل القادم

201
00:13:32,910 --> 00:13:37,760
منشغلةً بالتّحضير للشّتاء، لم يسعفني
.الوقت لأعمل على صنع الكتب

202
00:13:37,970 --> 00:13:41,560
—"واليوم كان عبارة عن "دونا دونا

203
00:13:41,560 --> 00:13:44,810
.أعني يوم تخزين اللّحم

204
00:13:46,180 --> 00:13:48,930
.إنّه أشبه بمهرجان. سوف تستمتعين

205
00:13:49,250 --> 00:13:51,150
،نذبح الخنازير جميعنا معًا

206
00:13:51,150 --> 00:13:54,880
ثمّ ننقع اللّحم بالماء وندخّنه
.أو نحضّر قدور لحم وسجق

207
00:13:54,880 --> 00:13:56,920
.لن نصمد في الشّتاء لولا ذلك

208
00:13:56,920 --> 00:13:58,950
...ذبح الخنازير

209
00:13:59,200 --> 00:14:03,440
آمل ألاّ تُصاب ماين بحُمّى في منتصف
.الطّريق كما في العام الماضي

210
00:14:03,760 --> 00:14:07,440
.أتمنّى لو أصاب بحُمَى مجدّدًا

211
00:14:43,840 --> 00:14:46,180
!هذا مختلف تمامًا عن البلدة

212
00:14:55,920 --> 00:14:58,700
!والهواء عليلٌ جدًّا! أشعر بالحياةِ من جديد

213
00:14:58,700 --> 00:15:01,710
.ماين، أغلقي فمك وإلاّ عضضتِ لسانك

214
00:15:05,780 --> 00:15:08,840
!تحتاجون لطرُقٍ مُزفّتة

215
00:15:12,190 --> 00:15:14,290
...ليس لدينا سوى أبناء، لذا

216
00:15:16,320 --> 00:15:21,500
طُلب منّي مراقبتهم من بعيد لأنّهم
.لا يريدونني أن أزعجهم

217
00:15:22,220 --> 00:15:27,080
لا أكترث لذلك. فهذا يمنحني الوقت
.لآتي ببعض الأفكار

218
00:15:27,830 --> 00:15:30,670
.كلٌّ من الكتب والورق باهظ الثّمن

219
00:15:32,590 --> 00:15:35,820
في هذه الحالة، سيتوجّب عليّ البدء
!بصنع ورقي الخاصّ

220
00:15:36,560 --> 00:15:40,060
لكن كيف يُفترض أن أفعل ذلك؟

221
00:15:40,060 --> 00:15:42,890
من المُحال أن أتمكّن
.من تقطيعِ الأشجّار بيديّ

222
00:15:45,740 --> 00:15:47,010
!انتظر

223
00:15:47,010 --> 00:15:50,160
.كم هذا بدائيّ

224
00:15:50,770 --> 00:15:54,560
صحيح. ماذا كانوا يفعلون
قبل اختراع الآلات؟

225
00:15:54,560 --> 00:15:58,020
...الحضارات القديمة... مصر القديمة

226
00:15:58,970 --> 00:16:00,260
!ورق البرديّ

227
00:16:00,820 --> 00:16:05,260
حتّى لو لم أستطع صنع ورق البرديّ، ينبغي
.أن أستطيع حياكة شيء ما من الألياف العشبيّة

228
00:16:05,510 --> 00:16:09,940
نعم، سأصنع شيئًا يشبه ورق البرديّ
!وأصنع كتابًا من ذلك

229
00:16:16,330 --> 00:16:17,150
.ها أنا ذا

230
00:16:47,500 --> 00:16:49,180
أين أنا؟

231
00:16:51,460 --> 00:16:53,200
.يسرّني أنّك صحوت

232
00:16:53,200 --> 00:16:54,910
السّيّد أوتّو؟

233
00:16:54,910 --> 00:16:56,940
تتذكّرينني؟

234
00:16:57,650 --> 00:16:59,630
كيف لي أن أنسى؟

235
00:17:08,430 --> 00:17:11,100
كيف حالك؟ هل تحسّنت الآن؟

236
00:17:12,840 --> 00:17:13,970
...المعذرة

237
00:17:13,970 --> 00:17:16,710
لماذا أنا هنا؟

238
00:17:17,110 --> 00:17:19,970
.غبتِ عن الوعي أثناء تخزين اللّحوم

239
00:17:20,580 --> 00:17:24,030
.أحضركِ القائد إلى هنا وهو في حالة هلع

240
00:17:24,290 --> 00:17:26,760
.قال أنّه سيأتي ليأخذك حالما ينتهون

241
00:17:26,760 --> 00:17:27,780
هكذا إذًا؟

242
00:17:31,470 --> 00:17:33,660
هل تشعرين بالوحدة؟

243
00:17:34,510 --> 00:17:37,900
لا. كنتُ أتساءل فقط كيف
.سأمضي الوقت

244
00:17:39,840 --> 00:17:43,160
.تذكّرت، قال أنّك أكبر مما تبدين

245
00:17:43,700 --> 00:17:44,900
.أمهليني لحظة

246
00:17:49,270 --> 00:17:51,640
.هل سيساعدك هذا في تمضية الوقت

247
00:17:53,700 --> 00:17:54,800
!لوح أُردوازيّ

248
00:17:55,060 --> 00:17:57,250
قلتُ أنّني سأعطيك لوحي، أليس كذلك؟

249
00:18:02,950 --> 00:18:03,730
.خذي

250
00:18:06,020 --> 00:18:07,240
.هذا اسمكِ

251
00:18:09,130 --> 00:18:12,110
.هكذا يُكتَب اسمي إذًا

252
00:18:13,740 --> 00:18:17,270
عليّ العودة إلى العمل، لذا ما رأيك
أن تتمرّني على ذلك؟

253
00:18:20,650 --> 00:18:25,120
...مـ... ـا...يـ...ـن

254
00:18:35,480 --> 00:18:36,920
!أنا متحمّسةٌ جدًّا

255
00:18:48,300 --> 00:18:49,680
!أحرف حقيقيّة

256
00:18:53,970 --> 00:18:55,190
!هذا ممتع

257
00:18:58,950 --> 00:19:00,950
!هذا ممتعٌ جدًّا

258
00:19:12,040 --> 00:19:14,500
موتوسو أورانو؟

259
00:19:14,500 --> 00:19:18,320
.لكن لم يعد هذا اسمي

260
00:19:35,520 --> 00:19:37,080
.إيفا، أمّي

261
00:19:38,560 --> 00:19:40,240
.غونتر، أبي

262
00:19:42,040 --> 00:19:43,160
.توري

263
00:19:44,590 --> 00:19:45,730
.رالف

264
00:19:47,120 --> 00:19:48,110
.فاي

265
00:19:49,480 --> 00:19:50,860
.السيّد أوتّو

266
00:19:52,380 --> 00:19:53,410
.لوتز

267
00:19:55,300 --> 00:19:56,220
.ماين

268
00:20:08,120 --> 00:20:10,640
.ماين، عاد القائد لأجلك

269
00:20:14,220 --> 00:20:17,390
!مصيبة يا قائد! ماين

270
00:20:20,660 --> 00:20:23,340
أصبتِ بحُمّى من جديد؟

271
00:20:23,340 --> 00:20:26,670
آسفة. أعلم أنّنا لم ننتهِ
.من التّحضير للشّتاء بعد

272
00:20:27,150 --> 00:20:30,160
.هذا السّجق الّذي أعددناه جميعًا معًا

273
00:20:41,330 --> 00:20:43,180
.إنّه لذيذ

274
00:20:43,480 --> 00:20:46,670
!توري، هذا السّجق شهيٌّ حقًّا

275
00:20:46,670 --> 00:20:50,640
حقًّا؟ حسنًا، حريّ بكِ أن تنامي
.حالما تنتهين من الأكل

276
00:20:50,640 --> 00:20:51,540
.حسنًا

277
00:20:59,780 --> 00:21:02,430
.لكن يحتاج الحساء لبعضِ التّحسين

278
00:21:06,060 --> 00:21:07,830
.كان ذلك رائعًا

279
00:21:14,430 --> 00:21:17,870
.كم أنا سعيدة بمجرّد قدرتي على الكتابة

280
00:21:18,550 --> 00:21:22,050
وسوف أطير من السّعادة إذا استطعت
.قراءة كتاب حقيقيّ

281
00:21:28,720 --> 00:21:34,960
ماذا؟ لحظة، ألم يخطر على ذهني
فكرة رائعة قبل أن يُغمى عليّ؟

282
00:21:35,570 --> 00:21:36,930
ماذا كانت؟

283
00:23:10,950 --> 00:23:14,450
الفصل القادم
أحداث الشّتاء

284
00:23:14,460 --> 00:23:17,020
!ورق برديّ، اللّعنة! ورق البرديّ

285
00:23:17,020 --> 00:23:19,310
!يا لي من خرقاء

286
00:23:18,250 --> 00:23:20,580
.لا شيء جديد

287
00:23:20,970 --> 00:23:25,450
بصرفِ النّظر، لم أتوقّع أن يظهر الشّامبو
.شامل المزايا في هذا الوقت المبكّر

288
00:23:25,450 --> 00:23:26,750
حقًّا؟

289
00:23:26,750 --> 00:23:29,320
—لكن هذا ما يقود إلى الاجتماع بالتّـ

290
00:23:30,570 --> 00:23:32,320
حرق من جديد؟

291
00:23:32,320 --> 00:23:34,460
هلاّ تعلّمت درسك؟