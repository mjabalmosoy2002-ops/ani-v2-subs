1
00:00:01,010 --> 00:00:04,270
تمكّنت ماين من النّجاة بفضل
.إحدى أدوات فريدا السّحريّة

2
00:00:04,880 --> 00:00:05,720
...لكن

3
00:00:06,180 --> 00:00:08,510
.سنة على الأكثر

4
00:00:09,970 --> 00:00:14,230
بعد أن قيل لها أنّ وسيلتها الوحيدة
،للعيش كانت إبرام اتّفاق مع نبيل

5
00:00:14,230 --> 00:00:16,490
.عقدت اجتماعًا عائليًّا

6
00:00:16,740 --> 00:00:20,420
هل يمكنني البقاء هنا مع عائلتي؟

7
00:00:20,420 --> 00:00:23,260
،تختار الموت إلى جانب عائلتها

8
00:00:23,780 --> 00:00:29,740
وتتعهّد باستغلال كلّ لحظة
.من العام المتبقّي لها

9
00:02:12,970 --> 00:02:17,740
قرّرت إذًا عدم التّعاون
.مع السيّد بينّو في العمل

10
00:02:18,020 --> 00:02:21,740
...نعم. عندما تكلّمت مع أوتّو، قال

11
00:02:22,160 --> 00:02:25,390
،باعتبارك ستحقّقين أرباحًا هائلة للمتجر

12
00:02:25,390 --> 00:02:29,390
فقد تتقاضين أكثر من النّاس الذين
.عملوا هناك لأزيد من عشر سنوات

13
00:02:29,820 --> 00:02:32,890
.أنا متأكّد أنّ ذلك سيسبّب بعض المشكلات

14
00:02:33,870 --> 00:02:37,140
ولا يمكنني الذّهاب للعمل إلاّ عندما
.أشعر بأنّني بحالٍ جيّدة أيضًا

15
00:02:37,140 --> 00:02:40,010
.قال أنّ ذلك سيولّد كثيرًا من الخلافات

16
00:02:41,680 --> 00:02:44,500
.هذا صحيح، نعم

17
00:02:45,060 --> 00:02:49,490
.آسفة لكوني لا أستطيع العمل معك يا لوتز

18
00:02:50,330 --> 00:02:52,660
.أعتقد هكذا أفضل

19
00:02:52,930 --> 00:02:57,270
إذا كانت ماين لن تنضمّ، فهذا يعني
.أنّه ليس عليك ذلك أيضًا يا لوتز

20
00:02:57,270 --> 00:02:59,490
—لم يفت الأوان على إيجاد حرفيّ

21
00:02:59,490 --> 00:03:01,150
!توقّفي يا أمّي

22
00:03:01,900 --> 00:03:04,110
!أريد فعلاً أن أكون تاجرًا

23
00:03:04,110 --> 00:03:07,360
!وسأكون كذلك بماين أو بدونها

24
00:03:10,190 --> 00:03:13,120
...لوتز، أنت

25
00:03:13,420 --> 00:03:18,140
هل تعتقد حقًّا أنّك تستطيع القيام
بذلك بينما أبوك وأنا معارضان؟

26
00:03:19,720 --> 00:03:23,210
.أنا جاهزٌ لأكون متدرّبًا مقيمًا إذا لزم الأمر

27
00:03:25,220 --> 00:03:29,780
سيتوجّب عليك العيش في غرفة
،سقفيّة وبظروف قاسية

28
00:03:29,780 --> 00:03:32,940
.وستعمل مجّانًا حتّى تصبح محترفًا

29
00:03:33,650 --> 00:03:36,180
.هكذا يتمّ التّدريب المهنيّ للمتدرّبين المقيمين

30
00:03:37,700 --> 00:03:40,790
!محال أن تتمكّن من ذلك

31
00:03:40,790 --> 00:03:44,680
!بلى! وقد بدأت التّحضير لذلك بالفعل أيضًا

32
00:03:46,320 --> 00:03:48,710
لماذا تكره فكرة أن تكون حرفيًّا إلى هذا الحدّ؟

33
00:03:50,090 --> 00:03:54,340
أعني أنّ الأمور ستبقى على حالها
.للأبد إذا فعلت ذلك

34
00:03:54,970 --> 00:03:56,200
ماذا تعني؟

35
00:03:56,510 --> 00:04:00,510
،سيأخذ أخوتي كلّ شيء

36
00:04:00,510 --> 00:04:02,960
.دون أن يتركوا لي أيّ شيء

37
00:04:04,420 --> 00:04:06,990
،بينما إذا أصبحت تاجرًا

38
00:04:06,990 --> 00:04:09,980
.سأحصد ثمار عرق جبيني

39
00:04:11,260 --> 00:04:13,970
!أريد أن أرى حدود قدراتي

40
00:04:17,450 --> 00:04:21,990
إذا كنت قد فكّرت في الأمر إلى هذا
.الحدّ، فاذهب وابذل قصارى جهدك

41
00:04:23,630 --> 00:04:24,880
حقًّا؟

42
00:04:26,390 --> 00:04:28,380
!شكرًا يا أمّي

43
00:04:33,370 --> 00:04:35,950
،وهكذا، مع وصول فصل الرّبيع متأخّرًا

44
00:04:35,950 --> 00:04:38,920
.رسمنا أنا ولوتز مخطّطاتنا بحزم

45
00:04:42,080 --> 00:04:44,140
.أحلّت عليكما نعمة ذوبان الثّلج

46
00:04:44,140 --> 00:04:48,010
عسى أن تبارك لكما إلهة الرّبيع بكرمها
.السّخيّ الّذي لا حدود له

47
00:04:50,550 --> 00:04:52,800
ماذا كان ذلك؟

48
00:04:52,800 --> 00:04:55,680
.إنّها تحيّة ربيع احتفاليّة بين التجّار

49
00:04:56,130 --> 00:04:58,510
.أحلّت عليكما نعمة ذوبان الثّلج

50
00:04:58,510 --> 00:05:02,240
عسى أن تبارك لك إلهة الرّبيع... ثمّ ماذا؟

51
00:05:02,530 --> 00:05:06,480
عسى أن تبارك لكما إلهة الرّبيع بكرمها
.السّخيّ الّذي لا حدود له

52
00:05:06,920 --> 00:05:09,250
.كان ذلك ممتازًا كمحاولة أولى منك

53
00:05:09,480 --> 00:05:10,460
.نعم

54
00:05:10,460 --> 00:05:11,690
.أقصد لوتز

55
00:05:13,760 --> 00:05:17,610
.كان الوقت قد حان لإبلاغ بينّو بالأخبار

56
00:05:20,690 --> 00:05:24,300
.حسنًا. سألغي تدريبك المهنيّ يا ماين

57
00:05:24,800 --> 00:05:26,270
.أنا آسفة

58
00:05:28,080 --> 00:05:30,500
ماذا سنفعل بشأن هذا؟

59
00:05:33,650 --> 00:05:35,480
.احتفظي به

60
00:05:35,480 --> 00:05:37,840
،وقّعي عقدًا احتكاريًّا معنا

61
00:05:37,840 --> 00:05:41,340
.لتتمكّني من أداء عملك كما من قبل

62
00:05:41,890 --> 00:05:44,910
.كان ذلك بداية لأيّام حافلة جدًّا

63
00:05:44,910 --> 00:05:49,650
الورشة الّتي كنّا نستخدمها
،أصبحت تدعى مشغل ماين رسميًّا

64
00:05:49,650 --> 00:05:52,900
،بعت عمليّة صنع الورق لبينّو

65
00:05:53,270 --> 00:05:56,270
.فتدخّلت نقابة ورق البرشمان في عملنا

66
00:05:57,040 --> 00:06:00,650
،ورقنا مصنوع من الشّجر
لذا هل هذا ينطبق حقًّا؟

67
00:06:00,650 --> 00:06:03,350
إذا استقطب الورق المصنوع
،من النّبات كلّ الزّبائن

68
00:06:03,350 --> 00:06:06,150
،فذلك يعني انهيار سوق ورق البرشمان
.لذا لا يمكن أن يسمحوا بذلك

69
00:06:06,150 --> 00:06:11,060
بدأت بتأسيس نقابة للورق المصنوع
،من النّبات منعًا لأيّ شكاوى

70
00:06:11,060 --> 00:06:14,120
.لكنّ العجوز الخرف لا يوافق على ذلك

71
00:06:14,120 --> 00:06:18,010
إذا افترضنا أنّه وقّعت عقود
،رسميّة على البرشمان

72
00:06:18,010 --> 00:06:22,150
لن يشتكوا حينها بما أنّ ذلك سيؤمّن
بعضًا من الدّخل لهم، صحيح؟

73
00:06:24,550 --> 00:06:28,200
.يسرّني أنّ رئيس النّقابة قد منح موافقته

74
00:06:28,200 --> 00:06:31,620
.نعم. يمكننا الآن بناء مصنع جديد

75
00:06:31,620 --> 00:06:33,500
.أبي

76
00:06:40,280 --> 00:06:42,970
.أنا بينّو من شركة غيلبيرتا

77
00:06:42,970 --> 00:06:45,050
!إنّه أنت إذًا

78
00:06:45,050 --> 00:06:47,040
.شكرًا لك على مساعدة ابنتي

79
00:06:47,310 --> 00:06:48,470
سيّد أوتّو؟

80
00:06:49,880 --> 00:06:53,970
.يبدو بينّو كأبٍ بوجودكما معًا

81
00:06:53,970 --> 00:06:55,380
!أنا أعزب

82
00:06:55,380 --> 00:06:57,410
!ماين ابنتي أنا

83
00:06:59,350 --> 00:07:00,590
.هيّا بنا

84
00:07:01,390 --> 00:07:04,630
.لم أكن أعلم أنّك أعزب يا سيّد بينّو

85
00:07:04,630 --> 00:07:06,110
وهل هذا خطأ؟

86
00:07:06,110 --> 00:07:09,350
،في الواقع، أنت تدير عملاً ضخمًا

87
00:07:09,350 --> 00:07:12,340
لذا، قلت لنفسي لا بدّ وأنّك تتعرّض
.لضغوط كبيرة لتتزوّج

88
00:07:15,700 --> 00:07:20,620
،عندما أردت الزّواج سابقًا
.انشغلت تمامًا بالاعتناء بكورينا

89
00:07:21,100 --> 00:07:24,860
،وعندما تزوّجت هي وأمسيت رجلاً حرًّا

90
00:07:24,860 --> 00:07:28,890
كانت المرأة التي أردت
.الزّواج منها قد ماتت

91
00:07:33,600 --> 00:07:37,390
.لم أتزوّج لأنّني لم أجد امرأة خيرًا منها

92
00:07:37,950 --> 00:07:39,150
.هذا ما في الأمر

93
00:07:47,840 --> 00:07:49,530
ماذا تفعلين؟

94
00:07:50,610 --> 00:07:52,190
.شعرت برغبة في ذلك فقط

95
00:07:58,240 --> 00:08:01,260
،وبينما أخذت أعلّم بينّو كيفيّة صنع الورق

96
00:08:01,640 --> 00:08:04,000
،وأعدّ مشغل ماين وأديره

97
00:08:04,000 --> 00:08:07,620
،وأرتّب الأمور لتدريب لوتز المهنيّ

98
00:08:07,620 --> 00:08:10,600
.كان فصل الصّيف يقترب

99
00:08:12,460 --> 00:08:14,380
.أهلاً يا ماين

100
00:08:14,710 --> 00:08:17,130
.خبزت كعكة إسفنجيّة لك

101
00:08:17,130 --> 00:08:19,470
.شكرًا لك يا سيّدة إيلي

102
00:08:19,470 --> 00:08:22,010
.قولي لي رأيك

103
00:08:22,010 --> 00:08:25,510
كانت الكعكة الإسفنجيّة أطيب
،بكثير من السّابق

104
00:08:25,510 --> 00:08:30,420
لكن قدّمتُ لها معلومات عن كيفيّة تحسينها
.مقابل كيس من السكّر على أيّ حال

105
00:08:31,010 --> 00:08:33,160
قشرة فيلشين، صحيح؟

106
00:08:33,160 --> 00:08:35,020
.حسنًا. سأجرّب ذلك

107
00:08:38,590 --> 00:08:40,410
...بعد أن انتهينا الآن

108
00:08:40,410 --> 00:08:42,780
.لم أرك منذ وقت يا ماين

109
00:08:42,780 --> 00:08:46,030
تفاجأت كثيرًا عندما رأيتك
.تعملين في نقابة التجّار

110
00:08:46,400 --> 00:08:50,710
سأكون بمفردي عندما أفتتح متجري
،في حيّ النّبلاء

111
00:08:50,710 --> 00:08:54,930
لهذا كنت أتدرّب هناك
.لأتعلّم كيف تسير الأمور

112
00:08:55,270 --> 00:08:59,440
.تعجبينني عندما تفكّرين على المدى البعيد

113
00:09:00,570 --> 00:09:02,920
.عليك أن تفكّري على المدى البعيد أيضًا يا ماين

114
00:09:03,210 --> 00:09:07,370
يقول المنطق أنّه ينبغي أن تنسي
.أمر بينّو وتنضمّي إلينا

115
00:09:09,530 --> 00:09:12,790
،أوتّو... شخص أعرفه قال نفس الكلام

116
00:09:12,790 --> 00:09:17,530
قال أنّه ينبغي أن أعمل لصالح رئيس
.النّقابة إذا أردت التّقرّب من النّبلاء

117
00:09:20,450 --> 00:09:22,740
لماذا لا تفعلين ذلك إذًا؟

118
00:09:22,740 --> 00:09:24,800
!كنت أنتظرك

119
00:09:27,700 --> 00:09:30,060
!فصل الصّيف على الأبواب

120
00:09:30,060 --> 00:09:32,330
ماذا تخطّطين أن تفعلي؟

121
00:09:45,660 --> 00:09:48,060
...في الواقع يا فريدا

122
00:09:52,400 --> 00:09:57,110
.اخترت أن أموت إلى جانب عائلتي

123
00:10:04,590 --> 00:10:06,430
.لا أصدّق ذلك

124
00:10:06,430 --> 00:10:07,600
لماذا؟

125
00:10:08,120 --> 00:10:11,840
لأنّني لا أستطيع صنع أدوات سحريّة ربّما؟

126
00:10:15,480 --> 00:10:17,130
".إذا احتجت شيئًا، أصنعه فحسب"

127
00:10:17,130 --> 00:10:20,280
لطالما حصلت على أيّ شيء
.أردت بهذه الطّريقة

128
00:10:20,280 --> 00:10:23,090
لكن لا أستطيع صنع أدوات سحريّة، صحيح؟

129
00:10:23,090 --> 00:10:25,880
...صحيح. لهذا أنت بحاجةٍ لاتّفاقيّة

130
00:10:25,880 --> 00:10:29,400
.لكن لا أريد إبرام اتّفاقية مع نبيل

131
00:10:30,310 --> 00:10:32,820
ألست خائفة من الموت؟

132
00:10:33,470 --> 00:10:36,000
.لم أختر الموت

133
00:10:36,000 --> 00:10:38,860
.اخترت فقط أن أكون مع عائلتي

134
00:10:41,450 --> 00:10:44,080
.لقد أثرت قلقهم لفترةٍ طويلة

135
00:10:44,080 --> 00:10:47,670
لهذا أريد أن أجني وأترك لهم كثيرًا
.من المال قبل أن أرحل

136
00:10:51,930 --> 00:10:55,670
إذًا سأشتري وصفة الكعكة
.الإسفنجيّة منك

137
00:10:56,360 --> 00:10:59,230
ستدعينني أفعل هذا لأجلك، صحيح؟

138
00:11:01,060 --> 00:11:03,350
.شكرًا لك يا فريدا

139
00:11:04,450 --> 00:11:09,170
بعت حقوق احتكار بيع الكعكة
.الإسفنجيّة لفريدا لمدّة عام

140
00:11:09,440 --> 00:11:11,130
عام، صحيح؟

141
00:11:11,130 --> 00:11:15,180
،نعم. حالما يمضي ذلك العام
.سأعمّم الوصفة

142
00:11:15,180 --> 00:11:19,000
.سيوفّر ذلك حلويّات شهيّة في كلّ مكان

143
00:11:19,000 --> 00:11:22,390
.أظنّ أنّ عليّ البقاء حيّة إلى ذلك الحين

144
00:11:23,410 --> 00:11:24,590
،إن لم أكن كذلك

145
00:11:24,590 --> 00:11:26,570
.سأدع القرار لك

146
00:11:27,680 --> 00:11:30,390
،إن كنت لا تريدينني أن أحتكرها للأبد

147
00:11:30,390 --> 00:11:33,980
فمن الأفضل لك أن تعمّميها
.بنفسك بعد عام

148
00:11:50,010 --> 00:11:54,020
.تبدين حقًّا كفتاة ثريّة

149
00:11:54,020 --> 00:11:56,490
.ويبدو أنّك كبرت قليلاً

150
00:11:56,490 --> 00:11:58,840
.طول التّنّورة مثاليّ عليك الآن

151
00:11:58,840 --> 00:12:03,400
،يظلّ النّاس ينادونني بالضّئيلة
.لكن أعتقد أنّني كنت أنمو

152
00:12:03,400 --> 00:12:06,400
.زينة شعرك المتمايلة ظريفة جدًّا أيضًا

153
00:12:06,400 --> 00:12:09,160
.شكرًا على مساعدتي في صنعها يا توري

154
00:12:09,160 --> 00:12:12,660
!ستكون ماين أجمل فتاة في مراسم اليوم

155
00:12:12,660 --> 00:12:16,330
.أبي، قلت نفس الكلام عند تعميد توري

156
00:12:16,330 --> 00:12:17,620
!بالطّبع

157
00:12:17,620 --> 00:12:20,000
!ابنتاي هما الأظرف في العالم

158
00:12:22,940 --> 00:12:24,060
.لوتز

159
00:12:26,190 --> 00:12:27,600
ما الأمر؟

160
00:12:28,250 --> 00:12:30,630
...لا، في الحقيقة

161
00:12:31,050 --> 00:12:35,310
يا إلهي! تبدين وكأنّك تنتمين
.لعائلة ثريّة يا ماين

162
00:12:35,310 --> 00:12:37,690
.شكرًا لك يا سيّدة كارلا

163
00:12:37,690 --> 00:12:39,120
.حسنًا، حان وقت الذّهاب

164
00:12:50,140 --> 00:12:51,960
!ماين! لوتز

165
00:12:52,590 --> 00:12:54,090
!تهانيّ

166
00:12:58,720 --> 00:13:00,900
!زينة شعر جديدة؟

167
00:13:17,110 --> 00:13:18,900
.لا يسمح للآباء بتجاوز هذه النّقطة

168
00:13:18,900 --> 00:13:21,240
.اعتن بماين لأجلي يا لوتز

169
00:13:21,240 --> 00:13:23,120
.بالتّأكيد، سأفعل

170
00:13:25,020 --> 00:13:26,360
.يا ماين

171
00:13:27,190 --> 00:13:30,350
.هذا الزّيّ وزينة الشّعر يليقان بك حقًّا

172
00:13:31,850 --> 00:13:33,870
أنت ظريفة جدًّا لدرجة أعجز
.فيها عن الوصف

173
00:13:33,870 --> 00:13:36,380
!لـ-لم هذا الكلام فجأة؟

174
00:13:39,120 --> 00:13:39,890
.هيّا بنا

175
00:13:43,080 --> 00:13:44,740
!ما أظرفهما

176
00:13:44,740 --> 00:13:46,980
.وكأنّنا نشاهد حفل زفاف صغار

177
00:13:48,090 --> 00:13:50,610
!لا يا ماين

178
00:14:10,610 --> 00:14:13,500
.يفعلون الشّيء الّذي تكرهينه يا ماين

179
00:14:14,260 --> 00:14:16,240
.يوقّع الجميع بدمائهم

180
00:14:16,240 --> 00:14:18,070
.معك حقّ

181
00:14:18,070 --> 00:14:20,590
.يبدو أنّه يتمّ تسجيلنا في شيء

182
00:14:21,350 --> 00:14:22,730
!الجنسيّة

183
00:14:22,730 --> 00:14:23,500
.التّالي

184
00:14:24,170 --> 00:14:25,370
.تعالي إلى هنا

185
00:14:26,640 --> 00:14:29,660
.مدّي يدك وكفّك نحو الأعلى

186
00:14:29,660 --> 00:14:31,490
.حـ-حسنًا

187
00:14:37,310 --> 00:14:39,270
.اضغطي برأس إصبعك على هذه الرّصيعة

188
00:14:43,280 --> 00:14:44,780
.أصبحت جاهزة

189
00:14:44,780 --> 00:14:45,920
!ماين

190
00:14:46,180 --> 00:14:47,440
!تعالي

191
00:14:47,730 --> 00:14:48,650
.نعم

192
00:14:48,650 --> 00:14:50,160
.قادمة

193
00:15:02,420 --> 00:15:04,930
.جاء كبير الكهنة

194
00:15:12,440 --> 00:15:13,940
!لوتز، إنّه كتاب

195
00:15:13,940 --> 00:15:15,230
!أرى كتابًا

196
00:15:15,660 --> 00:15:17,370
هذا كتاب؟

197
00:15:17,370 --> 00:15:19,950
يبدو مختلفًا تمامًا
.عمّا كنت تصنعينه يا ماين

198
00:15:20,200 --> 00:15:22,260
.يبدو باهظ الثّمن

199
00:15:23,200 --> 00:15:24,960
...إنّه كتاب

200
00:15:27,080 --> 00:15:32,120
اسمحوا لي أن أحدّثكم عن الآلهة
.الّتي خلقت هذا العالم

201
00:15:32,120 --> 00:15:36,330
...التقى إله الظّلام الوحيد بإلهة النّور

202
00:15:37,250 --> 00:15:41,530
،التقى إله الظّلام الوحيد بإلهة النّور

203
00:15:41,530 --> 00:15:44,230
،وأنجبا إلهة الماء

204
00:15:44,230 --> 00:15:45,690
،وإله النّار

205
00:15:46,130 --> 00:15:47,780
،وإلهة الرّياح

206
00:15:47,780 --> 00:15:49,870
،وإلهة الأرض

207
00:15:49,870 --> 00:15:52,050
.وهكذا خُلق عالمنا

208
00:15:52,720 --> 00:15:57,060
لاحقًا، وقع إله الحياة في حبّ
،إلهة الأرض من أوّل نظرة

209
00:15:57,060 --> 00:15:58,950
.حتّى تزوّجا

210
00:15:59,510 --> 00:16:06,350
،غير أنّه سرق قوّتها وختمها في جليدٍ وثلج

211
00:16:06,350 --> 00:16:07,700
.فوُلد الشّتاء

212
00:16:08,610 --> 00:16:11,170
،أذابت إلهة النّور الجليد

213
00:16:11,170 --> 00:16:15,590
وجرفت إلهة الماء الجليد
،والثّلج بعيدًا مع إله الحياة

214
00:16:15,590 --> 00:16:19,190
.ممّا جعل النّسل يتبرعم في الرّبيع

215
00:16:20,040 --> 00:16:25,380
يساهم إلهة النّار في نموّ الكائنات
.المتبرعمة في الصّيف

216
00:16:25,830 --> 00:16:29,940
بينما تتصدّى إلهة الرّياح
،لإله الحياة وتبقيه بعيدًا

217
00:16:29,940 --> 00:16:33,720
.يكتمل الحصاد في الخريف

218
00:16:33,720 --> 00:16:45,780
.ثمّ يعود الشّتاء، موسم إله الحياة

219
00:16:48,010 --> 00:16:50,710
،يحكم إله النّار الصّيف

220
00:16:50,710 --> 00:16:55,450
ويهب حمايته الإلهيّة من خلال
.التّطوير والتّوجيه

221
00:16:56,830 --> 00:17:00,110
!أريد قراءة هذا بنفسي

222
00:17:00,110 --> 00:17:03,300
.سنوضّح الآن الطّريقة الصّحيحة للعبادة

223
00:17:03,610 --> 00:17:05,620
.شاهدوا بإمعان

224
00:17:10,130 --> 00:17:12,000
!نقدّم صلواتنا للآلهة

225
00:17:12,700 --> 00:17:15,500
إنّها وضعيّة الرّجل الرّاكض
غليكو! لم هذه الوضعيّة؟

226
00:17:15,500 --> 00:17:17,520
!ثمّ إلى الخضوع؟

227
00:17:17,520 --> 00:17:20,650
.يا إلهي، هذا مضحكٌ للغاية

228
00:17:20,650 --> 00:17:23,780
.والآن انهضوا وانضمّوا إلينا

229
00:17:24,510 --> 00:17:28,140
!نقدّم صلواتنا للآلهة

230
00:17:28,140 --> 00:17:30,900
!مستحيل! لا أستطيع

231
00:17:32,270 --> 00:17:35,780
ماين؟ لماذا لم تقولي
أنّك لست على ما يرام؟

232
00:17:35,780 --> 00:17:36,800
هل أنت بخير؟

233
00:17:36,800 --> 00:17:37,760
.الأمر ليس كذلك

234
00:17:37,760 --> 00:17:39,650
.أ-أنا بخير

235
00:17:39,650 --> 00:17:40,760
ما الأمر؟

236
00:17:40,760 --> 00:17:44,410
.يبدو أنّها متوعّكة. سقطت فجأة

237
00:17:44,410 --> 00:17:46,160
.سندعها ترتاح حالاً

238
00:17:51,100 --> 00:17:54,540
من الواضح أنّ هذه غرفة
.مخصّصة للأثرياء

239
00:17:58,170 --> 00:18:00,350
.واثقة أنّ لباسي هو السّبب

240
00:18:03,880 --> 00:18:06,990
.لا يمكنني البقاء هنا للأبد

241
00:18:06,990 --> 00:18:09,430
.ستفوتني المراسم

242
00:18:19,400 --> 00:18:22,540
ماذا؟ لا أتذكّر أنّي رأيت هذا
...المكان من قبل

243
00:18:23,210 --> 00:18:26,060
.لا، هذا ليس الطّريق الصّحيح

244
00:18:29,540 --> 00:18:34,290
.المعذرة. يبدو أنّني تهت

245
00:18:37,450 --> 00:18:39,050
.هكذا إذًا

246
00:18:39,360 --> 00:18:42,740
.انتظري هنا رجاء
.سآخذك إلى قاعة الصّلاة

247
00:18:44,190 --> 00:18:46,820
.حسنًا. شكرًا جزيلاً لك

248
00:18:57,170 --> 00:18:59,510
...الكثير من الكتب

249
00:19:00,700 --> 00:19:02,860
.جزء منها يبدو كمكتبة مجنزرة أيضًا

250
00:19:05,050 --> 00:19:06,750
.وكأنّها مكتبة حقيقيّة

251
00:19:07,710 --> 00:19:09,260
!أقدّم صلواتي للآلهة

252
00:19:09,260 --> 00:19:11,150
!أقدّم امتناني للآلهة

253
00:19:12,270 --> 00:19:13,580
.حسنًا إذًا

254
00:19:13,580 --> 00:19:14,790
...المعذرة

255
00:19:17,560 --> 00:19:19,720
!هذا مؤلم

256
00:19:20,050 --> 00:19:21,490
ما هذا؟

257
00:19:22,710 --> 00:19:25,550
جدار خفيّ؟

258
00:19:25,860 --> 00:19:28,320
...لكنّ الكتب هناك

259
00:19:29,570 --> 00:19:31,310
!لا

260
00:19:31,310 --> 00:19:33,800
!دعيني أدخل

261
00:19:33,800 --> 00:19:35,820
!أريد الدّخول

262
00:19:35,820 --> 00:19:37,060
.لا أستطيع

263
00:19:37,060 --> 00:19:39,810
!أريد القراءة، لكن لا أستطيع الدّخول

264
00:19:40,100 --> 00:19:43,740
طاقم الكاتدرائيّة هو الوحيد
.الّذي لديه إذن بالدخول

265
00:19:44,290 --> 00:19:47,440
تقصدين يمكنني قراءة هذه الكتب
إذا أصبحت من طاقم الكاتدرائيّة؟

266
00:19:47,440 --> 00:19:49,280
!سأفعل ذلك! أريد أن أكون كذلك

267
00:19:49,280 --> 00:19:51,200
!كيف أنضمّ؟

268
00:19:55,450 --> 00:19:59,840
هلاّ أخبرتني لماذا تريدين
أن تكوني كاهنة متدرّبة؟

269
00:19:59,840 --> 00:20:02,230
!لأنّ هذا المكان يحتوي على مكتبة

270
00:20:02,230 --> 00:20:03,910
مكتبة؟

271
00:20:03,910 --> 00:20:07,130
.يبدو أنّك تسيئين فهم أمر

272
00:20:07,130 --> 00:20:09,540
،الكاتدرائيّة هي مكانٌ للعبادة

273
00:20:09,540 --> 00:20:12,680
.والكهنة والكاهنات هم خدمٌ للآلهة

274
00:20:13,240 --> 00:20:14,440
،فضلاً عن ذلك

275
00:20:14,440 --> 00:20:18,860
،إذا أرادت طفلةٌ من عائلةٍ كعائلتك العمل هنا

276
00:20:19,300 --> 00:20:23,190
فإنّ تبرّعًا ضخمًا سيكون مؤشّرًا
.جيّدًا على شغفك

277
00:20:23,780 --> 00:20:26,430
تبرّع؟

278
00:20:26,940 --> 00:20:29,780
.ربّما يعتقدونني ثريّة

279
00:20:34,290 --> 00:20:36,840
قطعة ذهبيّة كبيرة هي
.أكثر ما يمكنني تقديمه

280
00:20:36,840 --> 00:20:37,840
...قـ

281
00:20:37,840 --> 00:20:39,630
قطعة ذهبيّة كبيرة؟

282
00:20:41,100 --> 00:20:42,930
هل هذا كثير؟

283
00:20:42,930 --> 00:20:46,110
.هذا ما يُسمح لي بإنفاقه

284
00:20:51,340 --> 00:20:56,610
هل وافق والداك على العمل هنا؟

285
00:20:57,400 --> 00:20:59,600
.سأتكلّم معهما الآن

286
00:21:01,610 --> 00:21:05,390
.إذا اعترضا، فتعالي لرؤيتي فورًا

287
00:21:05,390 --> 00:21:06,980
.سأجد لك مخرجًا

288
00:21:06,980 --> 00:21:08,890
.شكرًا لك

289
00:21:08,890 --> 00:21:13,600
وأيضًا، يمكنك قراءة الكتب
،المقدّسة المخزّنة هنا

290
00:21:13,600 --> 00:21:15,610
.لذا عودي متى شئت

291
00:21:15,610 --> 00:21:18,170
!حقًّا؟ مرحى

292
00:21:18,810 --> 00:21:20,500
!أقدّم صلواتي للآلهة

293
00:21:26,020 --> 00:21:29,000
...تحمّست أكثر من اللاّزم

294
00:23:08,430 --> 00:23:11,520
!حظيتَ أخيرًا بوقت لك على الشّاشة

295
00:23:11,520 --> 00:23:13,700
.وقتي على الشّاشة غير مهمّ

296
00:23:13,700 --> 00:23:18,140
لا أصدّق أنّك اندفعت لدخول
.مكتبة الكاتدرائيّة

297
00:23:18,470 --> 00:23:20,840
ألا يمكنك أن تكوني أكثر عقلانيّة؟

298
00:23:20,840 --> 00:23:23,800
!مستحيل! إنّها مكتبة

299
00:23:23,800 --> 00:23:26,330
!جنّة الرّبّ على الأرض

300
00:23:26,330 --> 00:23:28,460
!فكيف لي ألاّ أتحمّس؟

301
00:23:28,460 --> 00:23:32,990
اهدئي. ليس يقينًا أنّك ستتمكّنين
.من الانضمام بعد