1
00:00:00,920 --> 00:00:03,600
،لإشباع رغبتها في صنع الكتب

2
00:00:03,600 --> 00:00:06,100
.أكملت ماين ألواح الصّلصال خاصّتها

3
00:00:06,550 --> 00:00:09,700
.لكنّ محاولتها في تسخينها باءت بفشلٍ آخر

4
00:00:10,810 --> 00:00:13,150
...ثمّ جاء الصّيف

5
00:00:25,540 --> 00:00:28,300
.ويوم تعميد توري

6
00:02:14,140 --> 00:02:17,200
!توري! تبدين جميلة

7
00:02:19,200 --> 00:02:21,110
.تهانينا يا توري

8
00:02:22,420 --> 00:02:23,980
.شكرًا لكما

9
00:02:26,920 --> 00:02:31,130
جرت العادة في هذا العالم أن يقام
.احتفال كبير لمن تبلغ السّابعة من العمر

10
00:02:31,830 --> 00:02:34,540
في نفس اليوم، يتمّ تعميد
.الفتاة في الكاتدرائيّة

11
00:02:35,630 --> 00:02:38,180
.ما أجمل إنجاب الفتيات

12
00:02:38,180 --> 00:02:43,290
.لديك أولاد فقط يا كارلا
.رالف ولوتز وساشا وسيغ

13
00:02:43,890 --> 00:02:45,390
.يا إلهي

14
00:02:46,220 --> 00:02:47,930
.إنّ أمر متعب جدًّا

15
00:02:50,910 --> 00:02:53,070
.حتّى أنّك صفّفت شعرك بشكل جميل

16
00:02:53,070 --> 00:02:55,520
!تبدين كأميرة يا توري

17
00:02:55,890 --> 00:02:57,660
.ماين من فعلت هذا لي

18
00:02:57,950 --> 00:02:59,970
ماذا؟ ماين؟

19
00:02:59,970 --> 00:03:03,030
لديها قدرات أخرى غير وصفاتها
.الاستثنائيّة إذًا

20
00:03:06,510 --> 00:03:09,740
.انظرن. لم أر زينة شعر كهذه من قبل

21
00:03:09,740 --> 00:03:11,870
.معك حقّ. جميلة جدًّا

22
00:03:11,870 --> 00:03:13,660
كيف صنعت؟

23
00:03:13,660 --> 00:03:15,500
!هذا مذهل

24
00:03:16,870 --> 00:03:21,010
زينة الشّعر الّتي صنعتها مميّزة
إلى هذا الحدّ؟

25
00:03:21,430 --> 00:03:23,190
!مستحيل

26
00:03:23,190 --> 00:03:26,850
!لن أذهب لحضور اجتماع في يوم مهمّ كهذا

27
00:03:26,850 --> 00:03:30,720
وحدهم الأطفال من يمكنهم
دخول الكاتدرائيّة، صحيح؟

28
00:03:31,300 --> 00:03:35,790
من واجب الأب أن ينتظر في ساحة
.الكاتدرائيّة أثناء التّعميد

29
00:03:35,790 --> 00:03:40,440
ومن واجب الأب أيضًا أن يذهب للعمل
ويوفّر قوت يوم العائلة، أليس كذلك؟

30
00:03:42,440 --> 00:03:44,110
.أعلم هذا

31
00:03:49,720 --> 00:03:51,910
!لنذهب عبر الشّارع الرّئيسيّ

32
00:03:58,790 --> 00:03:59,900
ماذا؟

33
00:04:01,130 --> 00:04:02,640
.ابتسمي

34
00:04:02,640 --> 00:04:06,210
ما دمت تبتسمين، ستكونين أجمل
.من أيّ شخص آخر

35
00:04:06,490 --> 00:04:09,310
.ماين. لا تكذبي عليّ

36
00:04:09,310 --> 00:04:10,730
!حان وقت الانطلاق

37
00:04:27,600 --> 00:04:28,630
...أبي

38
00:04:28,880 --> 00:04:30,440
.يجب أن نذهب

39
00:04:31,230 --> 00:04:32,360
...توري

40
00:04:33,490 --> 00:04:36,660
!لن تلحق الاجتماع هكذا

41
00:04:37,840 --> 00:04:40,040
!تأخّرت يا قائد

42
00:04:40,310 --> 00:04:42,680
أخبرتك بشأن الاجتماع اليوم، أليس كذلك؟

43
00:04:40,310 --> 00:04:42,680
،بينما يحضر أبي الاجتماع

44
00:04:42,680 --> 00:04:44,910
.كنت أتمرّن على الكتابة

45
00:04:46,430 --> 00:04:47,710
.أوتّو

46
00:04:47,990 --> 00:04:50,920
.السّيّد أوتّو في اجتماعٍ الآن

47
00:04:50,920 --> 00:04:52,800
.هذه أنت يا ماين

48
00:04:52,800 --> 00:04:54,290
.نسيت ذلك

49
00:04:54,730 --> 00:04:56,020
ماذا أفعل الآن؟

50
00:04:56,600 --> 00:04:59,610
هل أقرأها لك؟

51
00:04:59,610 --> 00:05:01,530
يمكنك القراءة؟

52
00:05:01,530 --> 00:05:05,110
أعرف قراءة الأوراق التّعريفيّة
.والرّسائل التّمهيديّة من النّبلاء

53
00:05:05,110 --> 00:05:07,730
.علّمني السّيّد أوتّو

54
00:05:07,730 --> 00:05:09,560
.هذه هي الرّسالة

55
00:05:09,560 --> 00:05:10,540
.تفضّلي

56
00:05:14,880 --> 00:05:17,400
،لديه إحالة من البارون برون

57
00:05:17,400 --> 00:05:20,220
.وسيزور البارون غراز

58
00:05:20,510 --> 00:05:23,290
،يحتاج هذا لختم القائد

59
00:05:23,290 --> 00:05:26,350
.لكنّه يحضر اجتماعًا

60
00:05:26,660 --> 00:05:30,440
يجب تحويله لغرفة انتظار
.النّبلاء الأقلّ مرتبة

61
00:05:30,440 --> 00:05:33,260
التّاجر الّذي يحمل إحالة نبيل

62
00:05:33,260 --> 00:05:37,150
.ينبغي أن يتفهّم الظّرف إذا شرحناه له

63
00:05:38,210 --> 00:05:39,860
.سنعود إلى المنزل يا ماين

64
00:05:39,860 --> 00:05:42,060
.سنغادر قبل أن يصل أوتّو إلينا

65
00:05:42,060 --> 00:05:43,620
!انتظر يا أبي

66
00:05:43,620 --> 00:05:46,160
!أودّ أن أبلغه عن أمر

67
00:05:47,910 --> 00:05:48,950
ماين؟

68
00:05:48,950 --> 00:05:50,330
!سيّد أوتّو

69
00:05:50,330 --> 00:05:53,820
!ثمّة تاجر ومعه إحالة نبيل هنا

70
00:05:53,820 --> 00:05:57,070
لقد حوّلته إلى غرفة انتظار
،النّبلاء الأقلّ رتبة

71
00:05:57,070 --> 00:06:00,210
!لذا من فضلك اهتمّ بأمره حالاً

72
00:06:01,170 --> 00:06:03,820
!أحسنت صنعًا! هذه هي مساعدتي

73
00:06:03,820 --> 00:06:05,040
!كم أنت لئيمة يا ابنتي

74
00:06:05,040 --> 00:06:06,820
...أبي

75
00:06:10,560 --> 00:06:12,050
هكذا إذًا؟

76
00:06:12,520 --> 00:06:17,340
!كانت الكاتدرائيّة جميلة وواسعة أيضًا

77
00:06:17,340 --> 00:06:19,720
.حقًّا؟ يسرّني هذا

78
00:06:19,720 --> 00:06:20,860
!نعم

79
00:06:20,860 --> 00:06:22,100
.توري

80
00:06:23,380 --> 00:06:25,500
.هذا لك

81
00:06:27,360 --> 00:06:29,870
!ما هذا؟ كم هو ظريف

82
00:06:34,730 --> 00:06:36,740
!ولذيذ جدًّا

83
00:06:37,090 --> 00:06:39,660
.هناك بعض الأشكال المثيرة

84
00:06:39,660 --> 00:06:42,370
.لعلّك تمتلكين موهبة في الطّبخ يا ماين

85
00:06:42,830 --> 00:06:45,230
.شكرًا على إعداد هذا يا ماين

86
00:06:45,230 --> 00:06:48,210
.وزينة الشّعر كذلك

87
00:06:48,210 --> 00:06:50,170
.كنت سعيدة حقًّا اليوم

88
00:06:50,170 --> 00:06:52,630
!توري كالملاك

89
00:06:54,860 --> 00:06:57,020
.لدينا هدايا لك يا توري

90
00:07:02,510 --> 00:07:05,020
.إنّها ملابس عمل وأدوات

91
00:07:05,020 --> 00:07:06,620
.اعتني بها جيّدًا

92
00:07:06,620 --> 00:07:09,860
!أبي، أمي، شكرًا لكما

93
00:07:10,170 --> 00:07:12,730
.بالتّوفيق لك في العمل كخيّاطة متدرّبة

94
00:07:13,100 --> 00:07:14,020
!شكرًا

95
00:07:15,210 --> 00:07:18,830
هل سيكون عليها الذّهاب للعمل يوميًّا؟

96
00:07:18,830 --> 00:07:21,290
.فقط لنصف الأسبوع في البداية

97
00:07:21,290 --> 00:07:24,970
.في النّصف الآخر، سأذهب إلى الغابة كالعادة

98
00:07:25,830 --> 00:07:28,340
.هكذا إذًا. هذا جيّد

99
00:07:28,340 --> 00:07:30,910
.تعميد ماين في العام المقبل أيضًا

100
00:07:31,210 --> 00:07:34,170
هل قرّرت ما هي المهنة الّتي ستتدرّبين عليها؟

101
00:07:34,580 --> 00:07:37,840
.نعم. أريد أن أدير مكتبة

102
00:07:38,370 --> 00:07:39,860
مكتبة؟

103
00:07:39,860 --> 00:07:45,100
سأبيع الكتب، أي تاجرة على ما أعتقد؟

104
00:07:45,330 --> 00:07:47,480
،في الواقع، لست أفهم تمامًا

105
00:07:47,480 --> 00:07:49,570
.لكن هذا جيّد ما دام لديك هدف

106
00:07:49,570 --> 00:07:52,780
.بصرف النّظر، هذا لك يا ماين

107
00:07:53,570 --> 00:07:54,890
ما هذا؟

108
00:07:55,510 --> 00:08:00,170
ستساهمين في أعمال المنزل بدلاً
.من توري من الآن فصاعدًا

109
00:08:00,830 --> 00:08:04,160
ستحتاجين لهذا لتوفير الحطب
.والعلف في الغابة

110
00:08:05,330 --> 00:08:06,630
!سكّين

111
00:08:08,760 --> 00:08:11,370
ألا يمكنني استعمال هذا لصنع الألواح الخشبية؟

112
00:08:12,080 --> 00:08:15,830
،سأقطّع الخشب إلى شرائح رفيعة

113
00:08:15,830 --> 00:08:19,090
،وأقشّر السّطح لجعله أملس

114
00:08:19,660 --> 00:08:21,820
.وبعدها سأكتب عليها

115
00:08:21,820 --> 00:08:23,140
!انتهيت

116
00:08:27,760 --> 00:08:30,950
!إذا صنعت الكثير، فستكون بديلاً جيّدًا لكتاب

117
00:08:31,350 --> 00:08:33,910
!شكرًا لك أيّتها الصّين القديمة

118
00:08:36,630 --> 00:08:39,110
!مرحى

119
00:08:42,220 --> 00:08:45,150
!هذه السّكّين... ثقيلة جدًّا

120
00:08:55,960 --> 00:08:58,670
.لوتز وتوري مذهلان

121
00:08:59,240 --> 00:09:02,510
.ينبغي أن أبدأ بما يمكنني فعله أيضًا

122
00:09:08,740 --> 00:09:11,730
.حسنًا، هكذا الأمر في البداية

123
00:09:39,600 --> 00:09:42,390
!قد يفلح هذا

124
00:09:42,910 --> 00:09:46,550
ماذا تصنعين الآن كبديل عن ألواح الصّلصال؟

125
00:09:46,900 --> 00:09:48,280
.لوتز

126
00:09:48,280 --> 00:09:51,690
كيف عرفت أنّ هذا بديل للوح صلصال؟

127
00:09:52,240 --> 00:09:53,230
،أعني

128
00:09:53,540 --> 00:09:55,790
.أراك مستمتعة كثيرًا

129
00:09:57,690 --> 00:10:00,530
بدا وكأنّك كنت على وشك أن تفركي
.خدّك بالخشب

130
00:10:00,810 --> 00:10:04,110
كنتِ مبهورة أيضًا بألواح الصّلصال، أتتذكّرين؟

131
00:10:06,780 --> 00:10:09,390
!لم أكن أعلم! هذا محرج للغاية

132
00:10:09,720 --> 00:10:11,910
حسنًا، ماذا تصنعين؟

133
00:10:12,860 --> 00:10:14,300
.ألواح خشبيّة

134
00:10:14,300 --> 00:10:15,980
ألواح خشبيّة؟

135
00:10:15,980 --> 00:10:17,970
ستكتبين عليها هذه المرّة؟

136
00:10:17,970 --> 00:10:20,960
.نعم. أحتاج لكثير منها

137
00:10:22,590 --> 00:10:24,640
.حسنًا، فهمت. سأساعدك

138
00:10:25,070 --> 00:10:25,920
حقًّا؟

139
00:10:25,920 --> 00:10:28,610
...نعم! لكن بالمقابل

140
00:10:31,760 --> 00:10:34,280
هل يمكنك أن تعرّفيني على أوتّو هذا؟

141
00:10:35,080 --> 00:10:36,570
السّيّد أوتّو؟

142
00:10:36,570 --> 00:10:40,020
.أريد سؤاله عن التّجارة العابرة للحدود

143
00:10:41,760 --> 00:10:44,510
.سأسأل عندما أذهب إلى البوّابة غدًا

144
00:10:44,510 --> 00:10:47,150
.لكنّه كثير الانشغالات

145
00:10:47,150 --> 00:10:49,030
.آسفة مقدّمًا إذا رفض

146
00:10:49,340 --> 00:10:50,760
.لا مشكلة

147
00:10:50,760 --> 00:10:52,490
!شكرًا يا ماين

148
00:11:01,590 --> 00:11:02,840
.السّيّد أوتّو

149
00:11:02,840 --> 00:11:05,860
كيف يبدأ المرء بممارسة التّجارة العابرة للحدود؟

150
00:11:05,860 --> 00:11:09,710
ماذا؟ تريدين أن تكوني تاجرة عابرة للحدود؟

151
00:11:09,710 --> 00:11:11,980
لحظة، هل أنا السّبب؟

152
00:11:11,980 --> 00:11:14,160
!سيقتلني القائد

153
00:11:14,160 --> 00:11:17,980
!كلاّ! إنّه صديقي، ليس أنا

154
00:11:18,430 --> 00:11:19,960
ماذا؟

155
00:11:19,960 --> 00:11:23,020
.إذًا ينبغي أن تخبريه أن ينسى الأمر

156
00:11:23,020 --> 00:11:25,100
.توقّعت

157
00:11:25,470 --> 00:11:26,860
توقّعت ماذا؟

158
00:11:26,860 --> 00:11:32,490
من طريقة كلامه، عرفت
.أنّها ليست مهنة ذات شعبيّة

159
00:11:32,490 --> 00:11:36,080
.بالطّبع، قد يوبّخه والداه توبيخًا شديدًا

160
00:11:36,080 --> 00:11:40,120
كما أنّ حياة مسافر بشكل دائم

161
00:11:40,120 --> 00:11:43,720
.ستكون صعبة جدًّا على فتى مدينة

162
00:11:43,720 --> 00:11:47,470
بما أنّك تعلمين هذا، فلم لا تنصحينه بنفسك؟

163
00:11:48,040 --> 00:11:50,620
،عوضًا عن فتاة مدينةٍ مثلي

164
00:11:50,620 --> 00:11:55,110
سيصغي إليك أكثر على الأرجح
.إذا أعطيته جرعةً من الواقع

165
00:11:57,150 --> 00:12:00,700
لديك علاقات مع تجّار، أليس كذلك؟

166
00:12:00,700 --> 00:12:02,360
،إذا كان يطمح ليكون تاجرًا

167
00:12:02,360 --> 00:12:05,390
فيمكنه مغادرة البلدة في بعض الأوقات
.لشراء وتموين بضائع

168
00:12:05,390 --> 00:12:07,820
،إن كنت تؤدّين دور الوسيط

169
00:12:07,820 --> 00:12:10,070
.فلا بدّ وأنّك تحبّين ذلك الفتى كثيرًا

170
00:12:10,070 --> 00:12:12,750
.ساعدني لوتز في أمور كثيرة

171
00:12:12,750 --> 00:12:15,410
.أريد أن أردّ له الجميل

172
00:12:15,410 --> 00:12:17,560
...هكذا إذًا

173
00:12:18,300 --> 00:12:20,180
.ستكون الإجازة المقبلة مناسبة

174
00:12:20,180 --> 00:12:22,420
!شكرًا لك يا سيّد أوتّو

175
00:12:24,610 --> 00:12:25,820
.صحيح

176
00:12:25,820 --> 00:12:28,250
كيف سأكتب على هذه الألواح الخشبيّة؟

177
00:12:28,250 --> 00:12:30,510
.الأقلام الأردوازيّة لن تنجح

178
00:12:32,550 --> 00:12:38,010
سيّد أوتّو، هل يمكنك أن تدفع لي
بالحبر بدلاً من الأقلام الأردوازيّة؟

179
00:12:38,010 --> 00:12:40,770
سيتوجّب عليك حينها العمل
.لثلاث سنوات مجّانًا. بلا سلفة

180
00:12:41,640 --> 00:12:43,150
!ماذا؟

181
00:12:58,860 --> 00:13:02,050
قال السّيّد أوتّو أنّه يستطيع رؤيتك
.في يوم إجازته المقبلة

182
00:13:02,400 --> 00:13:03,540
حقًّا؟

183
00:13:03,780 --> 00:13:05,550
!شكرًا يا ماين

184
00:13:07,180 --> 00:13:11,150
.آمل أن يكون اجتماعًا مثمرًا لك

185
00:13:16,350 --> 00:13:19,150
.والآن كلّ ما عليّ هو تجفيفها

186
00:13:19,150 --> 00:13:20,610
...فيما يلي

187
00:13:21,150 --> 00:13:24,060
حبر. حبر؟

188
00:13:24,690 --> 00:13:27,320
هل ينبغي أن أذهب وأصطاد
أخطبوطًا أو حبّارًا؟

189
00:13:30,380 --> 00:13:32,660
!الآن أستطيع الكتابة

190
00:13:35,090 --> 00:13:37,510
!لا! أين هو البحر أساسًا؟

191
00:13:42,690 --> 00:13:43,720
رماد؟

192
00:13:44,600 --> 00:13:46,630
!قد يفي الرّماد بالغرض

193
00:13:47,750 --> 00:13:49,080
!أمّي

194
00:13:49,080 --> 00:13:51,080
هل يمكنني الحصول على ذلك الرّماد؟

195
00:13:51,080 --> 00:13:54,050
،لا. يستخدم لصنع الصّابون

196
00:13:54,050 --> 00:13:57,240
.وإذابة الثّلج ومختلف الأشياء الأخرى

197
00:13:57,990 --> 00:13:59,360
.هكذا إذًا

198
00:13:59,860 --> 00:14:01,080
ماذا عن السّخام إذًا؟

199
00:14:02,180 --> 00:14:05,270
!ستنظّفين الفرن لأجلي؟

200
00:14:07,480 --> 00:14:09,460
.بالتوفيق يا ماين

201
00:14:11,000 --> 00:14:14,260
.نعم، بذلت قصارى جهدي

202
00:14:14,260 --> 00:14:16,410
.لكن أمسيت طريحة الفراش بعد ذلك

203
00:14:16,410 --> 00:14:18,110
طريحة الفراش من جديد؟

204
00:14:18,110 --> 00:14:19,620
هل أنت بخير؟

205
00:14:19,900 --> 00:14:21,470
.أنا بخير الآن

206
00:14:21,470 --> 00:14:24,680
على أيّ حال، لنحاول استخدام
.هذا السّخام للكتابة

207
00:14:25,090 --> 00:14:27,920
.أظنّني سأحاول مزجه بالماء أوّلاً

208
00:14:30,680 --> 00:14:33,180
.على الأرجح أنّ السّخام والماء سينفصلان

209
00:14:33,180 --> 00:14:35,420
لم لا تحاولين الكتابة به الآن؟

210
00:14:35,420 --> 00:14:36,420
.حسنًا

211
00:14:41,640 --> 00:14:43,070
.إنّه غير واضح

212
00:14:43,070 --> 00:14:44,440
.لن يفلح هذا

213
00:14:44,780 --> 00:14:46,270
ماذا نفعل تاليًا؟

214
00:14:47,770 --> 00:14:51,730
أعتقد أنّ خلطه مع الزّيت
...هو الخيار الواضح، لكن

215
00:14:51,730 --> 00:14:53,740
.لن تتمكّني من الحصول على زيت

216
00:14:53,740 --> 00:14:56,500
.لن تسمح لي أمّي بالحصول على أيّ زيت

217
00:14:56,500 --> 00:14:57,890
ماذا غير ذلك؟

218
00:14:57,890 --> 00:15:01,960
لا يجب أن يكون سائلاً. إذا استطعت
...صنع شيء كطبشور أو قلم رصاص

219
00:15:09,310 --> 00:15:10,580
!وجدتها

220
00:15:11,510 --> 00:15:13,520
.لنحاول خلطه مع الصّلصال

221
00:15:15,200 --> 00:15:16,280
!حسنًا

222
00:15:31,400 --> 00:15:32,920
!انتهيت

223
00:15:35,410 --> 00:15:38,880
كم من المدّة ينبغي لنا أن نتركه يجفّ؟

224
00:15:38,880 --> 00:15:40,350
.لا أدري

225
00:15:40,350 --> 00:15:42,450
ما رأيك أن نجرّب تسخينها؟

226
00:15:42,450 --> 00:15:46,350
.لا تقدمي على عمل أحمق
هل تريدين أن يحدث انفجار آخر؟

227
00:15:49,550 --> 00:15:52,510
على أيّ حال، يمكنني الكتابة على
.الألواح الخشبيّة بواسطة هذا

228
00:15:52,820 --> 00:15:56,290
.خطوت خطوةً تجاه هدف صنع الكتب

229
00:15:59,000 --> 00:16:01,550
.سأجفّف هذه في المخزن أيضًا

230
00:16:04,250 --> 00:16:06,110
!ماذا؟ اختفت؟

231
00:16:06,110 --> 00:16:07,140
لماذا؟

232
00:16:07,390 --> 00:16:09,100
ما الأمر يا ماين؟

233
00:16:09,620 --> 00:16:12,810
أمّي! هل تعرفين أين الألواح
الخشبيّة الّتي كانت هنا؟

234
00:16:13,280 --> 00:16:14,580
ألواح خشبيّة؟

235
00:16:14,580 --> 00:16:17,550
كانت قطعًا خشبيّة بمختلف
،الأشكال والأحجام

236
00:16:17,550 --> 00:16:19,840
!لكن جميعها لديها سطح أملس

237
00:16:19,840 --> 00:16:23,500
الحطب الّذي أحضرته للمنزل؟

238
00:16:23,500 --> 00:16:25,080
.استعملتُه بالطّبع

239
00:16:25,620 --> 00:16:27,040
استعملتِه؟

240
00:16:27,790 --> 00:16:29,020
لماذا؟

241
00:16:30,150 --> 00:16:33,420
يمكنك المساهمة أخيرًا
،في أعمال المنزل يا ماين

242
00:16:33,420 --> 00:16:36,220
وسعيت جاهدة لإحضار ذلك
.الحطب إلى المنزل

243
00:16:36,220 --> 00:16:41,250
.أردت أن أحوّل قصّتك قبل النّوم إلى كتاب

244
00:16:41,640 --> 00:16:43,050
.لهذا جمعتها

245
00:16:43,050 --> 00:16:46,540
،إذا أردتني أن أروي لك قصصًا قبل النّوم

246
00:16:46,540 --> 00:16:48,240
.فسيكون ذلك من دواعي سروري

247
00:16:48,690 --> 00:16:52,120
...ليس هذا... بيت القصيد

248
00:16:53,340 --> 00:16:54,310
ماين؟

249
00:16:56,760 --> 00:16:59,080
ماذا يحدث؟

250
00:17:01,700 --> 00:17:02,660
ماين؟

251
00:17:02,840 --> 00:17:04,080
!ماين

252
00:17:12,530 --> 00:17:15,770
.أشعر وكأنّ الحمّى تأكلني

253
00:17:15,770 --> 00:17:19,040
.أنا أتلاشى ببطء

254
00:17:20,280 --> 00:17:21,350
!ماين

255
00:17:23,910 --> 00:17:25,220
...لوتز

256
00:17:25,220 --> 00:17:27,190
هل أنت بخير يا ماين؟

257
00:17:27,190 --> 00:17:29,270
.سمعت أنّك انهرت فجأة

258
00:17:29,480 --> 00:17:32,400
.آسفة لإثارة قلقك

259
00:17:33,690 --> 00:17:35,240
.سأذهب لإحضار أمّك

260
00:17:41,460 --> 00:17:43,830
.لم يفلح الأمر مجدّدًا

261
00:17:44,610 --> 00:17:49,510
.أمّي أحرقت... ألواحي الخشبيّة

262
00:17:49,510 --> 00:17:54,580
.بالطّبع، فهي تبدو كحطب

263
00:17:54,580 --> 00:18:02,040
!قدّر لي ألاّ أصنع كتابًا

264
00:18:07,250 --> 00:18:08,910
.لا تلومي نفسك

265
00:18:09,900 --> 00:18:11,010
لوتز؟

266
00:18:11,010 --> 00:18:15,020
كلّ ما تحتاجينه هو اختيار
مادّة لا تحترق، صحيح؟

267
00:18:16,510 --> 00:18:18,690
.أنت لطيف جدًّا يا لوتز

268
00:18:19,100 --> 00:18:23,530
.أ-أحتاجك لتعرّفيني على السّيّد أوتّو

269
00:18:23,530 --> 00:18:27,350
لذا يجب أن تتعافي مهما كلّف الأمر. مفهوم؟

270
00:18:28,540 --> 00:18:31,900
.نعم. شكرًا يا لوتز

271
00:18:32,960 --> 00:18:36,300
لكن حتّى شرائح الخيزران
...الّتي أحضرها لوتز لي

272
00:18:38,600 --> 00:18:40,440
ماذا كان ذلك الصّوت؟

273
00:18:42,680 --> 00:18:45,030
أمّي، ماذا حدث؟

274
00:18:45,420 --> 00:18:48,950
،ظننت أنّ لوتز قد أحضر خشب بانيشت

275
00:18:48,950 --> 00:18:50,550
.لكن يبدو أنه لم يفعل

276
00:18:51,490 --> 00:18:53,060
أحرقته؟

277
00:18:53,350 --> 00:18:57,060
.ليس عليك القلق يا ماين
.استريحي فحسب

278
00:19:05,430 --> 00:19:08,820
،الغضب من إحراق شيء صنعته

279
00:19:08,820 --> 00:19:12,500
،الإحباط نتيجة عدم فهم ذلك الغضب

280
00:19:13,040 --> 00:19:17,320
،وحقيقة أنّني مهما عاودت المحاولة
...لا أستطيع صناعة كتبي الخاصّة

281
00:19:18,370 --> 00:19:20,570
.لم أعد أحتمل

282
00:19:21,210 --> 00:19:24,630
،إذا كانت جهودي لا تؤتي أكلها

283
00:19:24,630 --> 00:19:28,680
فقد أختفي فحسب، صحيح؟

284
00:19:31,530 --> 00:19:32,260
.ماين

285
00:19:33,210 --> 00:19:34,330
!ماين

286
00:19:35,280 --> 00:19:37,770
.سأساعدك في أيّ شيء تريدين

287
00:19:38,290 --> 00:19:41,730
!أحتاجك لتعرّفيني على السّيّد أوتّو

288
00:19:41,730 --> 00:19:45,610
لذا يجب أن تتعافي مهما كلّف الأمر. مفهوم؟

289
00:19:45,610 --> 00:19:49,370
!هذا صحيح! عليّ أن أفي بوعدي

290
00:19:49,370 --> 00:19:53,080
!يجب أن أتحسّن وأعرّفه على أوتّو

291
00:19:55,710 --> 00:19:57,450
.انخفضت

292
00:19:57,450 --> 00:20:00,790
الحمّى في جسدي قد انخفضت الآن؟

293
00:20:01,350 --> 00:20:03,870
.ثمّة مشكلة ما في هذه الحمّى

294
00:20:03,870 --> 00:20:06,280
تهاجمني من الدّاخل

295
00:20:06,280 --> 00:20:09,050
.وتتغيّر درجتها باستمرار

296
00:20:09,720 --> 00:20:12,990
ما المرض الّذي أصيب به
هذا الجسد على أيّ حال؟

297
00:20:14,310 --> 00:20:16,690
هل أنت بخير الآن؟

298
00:20:17,120 --> 00:20:21,130
أخبرني القائد أنّ الحمّى لديك
.لم تنخفض لخمسة أيّام

299
00:20:21,130 --> 00:20:23,430
.نعم، لكنّني بخير

300
00:20:23,430 --> 00:20:25,530
.يبدو وجهك شاحبًا

301
00:20:29,460 --> 00:20:32,260
.كنت أجهد تفكيري في شيء

302
00:20:32,260 --> 00:20:35,890
،جرّبت مختلف الطّرق لصناعة شيء أريده

303
00:20:35,890 --> 00:20:38,460
.لكنّني عجزت عن ذلك تمامًا

304
00:20:39,240 --> 00:20:42,210
ماذا كنت لتفعل مكاني يا سيّد أوتّو؟

305
00:20:44,930 --> 00:20:47,080
بمقدورك استئجار شخصٍ
.ليفعل ذلك عنك

306
00:20:47,720 --> 00:20:50,340
استئجار شخص بنفسي؟

307
00:20:50,340 --> 00:20:52,560
،تبدو فكرة سديدة

308
00:20:52,560 --> 00:20:54,480
لكن ماذا لو كنت لا أملك مالاً؟

309
00:20:54,710 --> 00:20:58,740
أقنعي شخصًا يستطيع فعلها
.بفعل ذلك لأجلك

310
00:20:58,740 --> 00:21:01,820
إن سار الأمر على ما يرام، فلن
.تتضرّري على الصّعيد المادّي

311
00:21:02,730 --> 00:21:04,780
.إنّه رجل أعمال بحت حقًّا

312
00:21:06,010 --> 00:21:07,840
.لكن سأضع ذلك في الحسبان

313
00:21:08,440 --> 00:21:09,500
.تذكّرت

314
00:21:10,330 --> 00:21:12,700
بشأن ذلك الاجتماع الّذي
...اضطررنا لتأجيله

315
00:21:13,080 --> 00:21:17,310
.وهكذا، حدّدنا يومًا مناسبًا للقاء لوتز وأوتّو

316
00:21:17,700 --> 00:21:21,320
تواجد عند السّاحة المركزيّة"
".مع قرع جرس الثّالثة

317
00:21:22,970 --> 00:21:25,530
،إنّه فتى توصين به بنفسك

318
00:21:25,530 --> 00:21:27,370
.لذا أنا متأكّد أنّه سيكون مسلّيًا

319
00:21:27,800 --> 00:21:30,600
.أتطلّع قدمًا ليوم إجازة ممتع

320
00:21:30,600 --> 00:21:32,950
ماذا يقصد؟

321
00:21:32,950 --> 00:21:36,040
ألن يكون مجرّد اجتماع؟

322
00:21:36,520 --> 00:21:40,020
...يُتبع

323
00:23:13,530 --> 00:23:17,940
أيّها الكاهن الأكبر، هل من شيء
مميّز بشأن الاجتماع المقبل؟

324
00:23:17,940 --> 00:23:21,580
وما أدراني بشؤون العامّة؟

325
00:23:21,580 --> 00:23:25,620
حتّى أنت لا تعلم؟

326
00:23:25,620 --> 00:23:28,350
،بخلافك، لديّ فكرة جيّدة

327
00:23:28,350 --> 00:23:30,550
.لكن لن أتسرّع في الاستنتاج

328
00:23:30,550 --> 00:23:35,000
!ماذا؟ أخبرني إن كانت لديك فكرة