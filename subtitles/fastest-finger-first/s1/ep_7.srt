1
00:00:00,510 --> 00:00:04,230
.الأهمّ من ذلك، لا تنسَ لقاءنا الدّوريّ

2
00:00:10,200 --> 00:00:11,490
اللّقاء الدّوريّ"؟"

3
00:00:12,900 --> 00:00:16,410
إنّها منافسة تقام بشكل دوريّ يجتمع
.فيها فرق من العديد من المدارس

4
00:00:17,350 --> 00:00:20,630
حسنًا، يعني هذا أنّ لديك منافسًا، صحيح؟

5
00:00:22,110 --> 00:00:24,370
منافس؟

6
00:00:24,600 --> 00:00:25,420
.نعم

7
00:00:26,670 --> 00:00:28,030
!آ-آسف

8
00:00:28,770 --> 00:00:29,770
!سأعود للمنزل

9
00:00:29,770 --> 00:00:30,710
كوشياما-كُن؟

10
00:00:35,330 --> 00:00:36,260
..."منافس"

11
00:00:36,460 --> 00:00:39,770
،إنّه لقب لا يُمنح إلاّ لشخص تمّ الاعتراف بقدراته

12
00:00:39,770 --> 00:00:41,480
.ويحرّض عواطف أكثر من اسم أيّ أحد آخر

13
00:00:42,640 --> 00:00:47,390
لطالما ظننتُ أنّ امتلاك واحد لن
.يكون أكثر من حلم بالنّسبة لي

14
00:00:55,330 --> 00:00:55,980
!نعم

15
00:00:57,230 --> 00:00:58,280
!إنّه ليس حلمًا

16
00:02:33,660 --> 00:02:34,550
اللّقاء الدّوريّ؟

17
00:02:34,990 --> 00:02:37,080
.أخبرني عنه ميكوريا-كُن

18
00:02:37,080 --> 00:02:42,500
،اعتقدنا أنّك ستعرف موعده
.وكيف تسير المنافسة وما إلى ذلك

19
00:02:42,500 --> 00:02:44,560
.جينكو، اعملي بصمت أكثر

20
00:02:46,550 --> 00:02:47,560
.حاضرة

21
00:02:48,840 --> 00:02:51,570
.كنتُ أفكّر أنّ عليّ إخباركم بالأمر للتّوّ

22
00:02:51,570 --> 00:02:53,310
،لم يتمّ تأكيد الجدول الزّمنيّ الكامل

23
00:02:53,310 --> 00:02:57,530
لكنّ اللّقاء الدّوريّ سيُعقد في يونيو
.في ثانويّة أساغاوكا للبنات

24
00:02:57,530 --> 00:02:59,210
أساغاوكا؟

25
00:02:59,210 --> 00:03:00,990
!تلك مدرسة يوكيتشي

26
00:03:01,930 --> 00:03:03,450
اللّقاء الدّوريّ

27
00:03:03,570 --> 00:03:08,660
هو في الحقيقة عبارة عن نشاط عاديّ
.لكلّ فريق مسابقات أسئلة

28
00:03:09,590 --> 00:03:12,430
لكنّ اللّقاء الدّوريّ لفرق مسابقات الأسئلة للتّلاميذ

29
00:03:12,430 --> 00:03:15,140
.هو لقاء يُعقد خارج ساعات الدّراسة

30
00:03:15,450 --> 00:03:19,330
.تتناوب المدارس على احتضان منافسة مسابقات أسئلة

31
00:03:19,800 --> 00:03:22,890
يمكن أن نصِفها بنسخة أكبر عن اللّقاء
.الأخير الّذي أُقيم في سيكيغاواتا

32
00:03:23,280 --> 00:03:24,640
...نسخة أكبر

33
00:03:24,990 --> 00:03:29,740
ستشارك كلّ المدارس القويّة
.في كانتو والمقاطعات المحيطة

34
00:03:29,740 --> 00:03:31,970
.على الأرجح أنّ أكاديميّة كايجو ستكون هنالك أيضًا

35
00:03:32,890 --> 00:03:35,370
!كايجو هي ثانويّة للنّخبة

36
00:03:35,370 --> 00:03:38,610
!يا إلهي! سيأتي كلّ أولئك الفتية الأذكياء إلى هنا

37
00:03:39,930 --> 00:03:42,160
،بما أنّ أساغاوكا هي المدرسة المضيفة

38
00:03:42,160 --> 00:03:45,120
علينا القيام بتجهيزات لاستقبال
.هذه المدارس التّنافسيّة

39
00:03:45,310 --> 00:03:49,540
إذًا فستتسنّى لنا فرصة جعل فتيان من مدارس
!منافسة أن يتقدّموا بطلبات المشاركة بأنفسهم

40
00:03:49,540 --> 00:03:53,040
وسنتمكّن من رسم تعابير غير مريحة
!على وجوههم بأسئلتنا الصّعبة

41
00:03:53,040 --> 00:03:56,380
سيكون الوضع أشبه بدراما مثيرة للغاية
!لفتيان في حديقة من الفتيات

42
00:03:56,710 --> 00:03:59,340
...كلاّ، أعتقد أنّه ستشارك فتيات أيضًا

43
00:04:01,000 --> 00:04:04,300
.لقد حضّرت خطّة خاصّة مسبقًا

44
00:04:06,750 --> 00:04:09,770
سيكيغاواتا ومياورا... وكايجو أيضًا؟

45
00:04:12,510 --> 00:04:15,710
.فريق كايجو لمسابقات الأسئلة هو الأقوى

46
00:04:16,090 --> 00:04:17,730
.إنّهم فريق من النّخبة على الصّعيد الوطنيّ

47
00:04:18,640 --> 00:04:19,740
فعلاً؟

48
00:04:19,740 --> 00:04:21,240
.المشاركة أمر اختياريّ

49
00:04:22,460 --> 00:04:23,800
!سأشارك

50
00:04:23,800 --> 00:04:24,810
!وأنا أيضًا

51
00:04:25,280 --> 00:04:26,910
!أ-أنا أيضًا

52
00:04:27,570 --> 00:04:29,520
.سأواجه ميكوريا-كُن

53
00:04:30,300 --> 00:04:34,790
،جيّد. في مسابقات الأسئلة التّنافسيّة
.لا يمكن أن تتحسّنوا دون تجربة

54
00:04:35,350 --> 00:04:38,790
سيكون من الجيّد لكم أن تتدرّبوا قليلاً
.مع مدارس مخضرمة في اللّقاء الدّوريّ

55
00:04:39,190 --> 00:04:43,510
على رسلك يا غاكتو. يبدو أنّكم تتوقّعون
.جميعًا أن تخسروا من البداية

56
00:04:45,060 --> 00:04:49,360
.تعتمد كلّ المنافسات على حظّ
.إنّها ممتعة لأنّ الجميع يجهل ما سيحدث

57
00:04:49,360 --> 00:04:50,760
أليس هذا ما تقوله دائمًا؟

58
00:04:51,070 --> 00:04:52,670
!هذا صحيح يا سينباي

59
00:04:52,670 --> 00:04:57,520
أعتقد أنّ كوشياما-كُن على قدم المساواة مع
!تلك المدارس القويّة فيما يخصّ المعرفة

60
00:04:57,920 --> 00:05:00,150
!سـ-سأبذل جهدي للفوز

61
00:05:00,940 --> 00:05:01,960
.هكذا إذًا

62
00:05:02,700 --> 00:05:05,790
،في تلك الحالة، واستعدادًا للّقاء

63
00:05:05,790 --> 00:05:07,780
.عليكم أن تتنافسوا بينكم ابتداءً من اليوم

64
00:05:08,870 --> 00:05:10,160
.سنبدأ بمسابقة أسئلة على ورق

65
00:05:10,650 --> 00:05:12,700
.لديكم عشر دقائق

66
00:05:13,540 --> 00:05:18,420
من المعتاد في مسابقات الأسئلة على الورق
.أن تُقدّم خلال الجولات الأولى للّقاء

67
00:05:18,770 --> 00:05:22,770
إنّه شكل من أشكال المسابقات
.يختبر معرفتكم بكلّ بساطة

68
00:05:24,080 --> 00:05:24,630
.ابدؤوا

69
00:05:25,390 --> 00:05:27,920
إذًا فمسابقات الأسئلة المكتوبة جزء
من المنافسات أيضًا؟

70
00:05:27,920 --> 00:05:29,740
.قد يكون هذا أحد نقاط قوّتي

71
00:05:31,410 --> 00:05:33,920
...أو ربّما لن يكون الأمر سهلاً

72
00:05:34,470 --> 00:05:37,600
خمسون سؤالاً في عشر دقائق... أي أنّ عليّ
.الإجابة على سؤالٍ كلّ اثنتي عشر ثانية

73
00:05:38,200 --> 00:05:40,190
،يضعنا الوقت المحدّد تحت الضّغط

74
00:05:40,190 --> 00:05:42,700
.ولا تخطر الأجوبة على البال في الحال دائمًا

75
00:05:43,610 --> 00:05:47,660
كما أنّي أواجه مشاكل مع الفئات
.غير المألوفة لديّ كثيرًا

76
00:05:48,010 --> 00:05:49,680
...السّؤال الأخير هو

77
00:05:50,420 --> 00:05:53,640
"كم هو زون ساساجيما جينكو حاليًّا بالكيلوغرام؟"

78
00:05:58,140 --> 00:06:01,160
يتمّ إضافة أسئلة تتطلّب قيمًا تقريبيّة أحيانًا

79
00:06:01,160 --> 00:06:03,920
في نهاية مسابقات الأسئلة لتحديد
.الفائز في حالة حدوث تعادل

80
00:06:03,920 --> 00:06:05,670
...المشكلة هو ذلك الصّدر

81
00:06:05,670 --> 00:06:08,130
.إنّه أثقل من صدري بكلّ تأكيد

82
00:06:08,130 --> 00:06:10,140
...إنّها أطول منّي

83
00:06:10,530 --> 00:06:14,100
!ماذا؟ ما بالكم جميعًا؟ كفّوا عن التّحديق بي

84
00:06:14,320 --> 00:06:16,350
.مرّت الدّقائق العشرة. انتهى الوقت

85
00:06:16,350 --> 00:06:17,100
.هيّا

86
00:06:19,170 --> 00:06:20,190
!ما هذا؟

87
00:06:20,430 --> 00:06:22,070
‫47,5 كيلوغرامًا.

88
00:06:22,070 --> 00:06:22,730
!أجل

89
00:06:23,140 --> 00:06:25,030
!أيّها الغبيّ غاكتو

90
00:06:25,570 --> 00:06:27,520
،في المركز الأخير بستّة عشر نقطة

91
00:06:27,520 --> 00:06:28,650
.إينوي دايسكي

92
00:06:31,110 --> 00:06:33,380
...رغم أنّي خمّنت وزنها بالتّحديد

93
00:06:33,710 --> 00:06:35,470
.ما زال الطّريق أمامك طويلاً

94
00:06:35,470 --> 00:06:37,040
!أ-أعلم ذلك

95
00:06:37,410 --> 00:06:39,070
،المركز الثّاني بتسعة وثلاثين نقطة

96
00:06:39,070 --> 00:06:39,990
.فوكامي ماري

97
00:06:42,160 --> 00:06:46,250
أليست الأسئلة الكلاسيكيّة هي نقطة قوّتك؟
.كنتِ لتخسري في الجولة الافتتاحيّة بهذا

98
00:06:46,250 --> 00:06:47,630
.آسفة

99
00:06:47,850 --> 00:06:49,510
،في المركز الأوّل بأربعة وأربعين نقطة

100
00:06:49,510 --> 00:06:50,530
.كوشياما شيكي

101
00:06:50,530 --> 00:06:52,010
.حا-حاضر

102
00:06:52,570 --> 00:06:54,980
.توقّعت أن يكون كوشياما-كُن الأوّل

103
00:06:54,980 --> 00:06:58,280
كوشياما، كيف تشعر حيال علامتك؟

104
00:06:58,280 --> 00:07:01,600
...أ-أبليت بشكل حسن على ما أظنّ

105
00:07:02,070 --> 00:07:03,300
.أنت ساذج

106
00:07:03,300 --> 00:07:07,990
كلّ واحد من لاعبي المدارس المخضرمة سيسجّل
.علامة كاملة في مسابقة أسئلة كلاسيكيّة كهذه

107
00:07:09,060 --> 00:07:11,370
.كنتَ لتخسر في الجولة الافتتاحيّة أيضًا

108
00:07:11,370 --> 00:07:13,150
.لن تتأهّل حتّى لجولات الضّغط على الأزرار

109
00:07:14,650 --> 00:07:16,740
...هذا قاسٍ

110
00:07:17,210 --> 00:07:20,430
تستبعد مسابقات الأسئلة على الورق
.الكثير من المشاركين

111
00:07:20,870 --> 00:07:23,130
يمكن لنقطة واحدة أن تفرّق
.بين الخاسرين والفائزين

112
00:07:23,690 --> 00:07:26,910
.لا تتعدّى قاعدة معرفتك المجال الأدبيّ

113
00:07:27,450 --> 00:07:31,340
.لن تكون ندًّا أبدًا أمام المدارس المخضرمة

114
00:07:31,620 --> 00:07:34,230
...سينباي، لم تكن بحاجة لأن

115
00:07:34,230 --> 00:07:35,550
!أعلم ذلك

116
00:07:35,930 --> 00:07:39,970
،إن ذهبتُ للّقاء الدّوريّ هكذا
.فسأخذل ميكوريا-كُن فحسب

117
00:07:40,900 --> 00:07:43,290
!سأكتسب المزيد من المعرفة

118
00:07:43,660 --> 00:07:46,150
سأحسّن تقنيّاتي وأتعلّم المزيد
!عن مسابقات الأسئلة

119
00:07:47,240 --> 00:07:47,990
!"غاودي"

120
00:07:47,990 --> 00:07:49,070
.صحيح

121
00:07:49,970 --> 00:07:50,940
!"فوايي"

122
00:07:51,160 --> 00:07:52,030
!جوسيكي

123
00:07:53,190 --> 00:07:54,240
...المرّة القادمة

124
00:07:54,780 --> 00:07:56,100
!كوشياما-كُن

125
00:07:56,100 --> 00:07:58,730
.ركّز أكثر على نقاط التّحديد

126
00:07:58,730 --> 00:08:01,110
يكون الأوان قد فات إن انتظرتَ لتعرف
!الإجابة قبل الضّغط على الزّرّ

127
00:08:01,110 --> 00:08:03,210
.اضغط بمجرّد التّفكير أنّ بإمكانك تخمين الإجابة

128
00:08:03,550 --> 00:08:06,170
!وإلاّ، لن تحصل حتّى على الفرصة للإجابة

129
00:08:06,820 --> 00:08:07,950
...فوكامي-سان

130
00:08:14,580 --> 00:08:15,560
.السّؤال

131
00:08:15,560 --> 00:08:17,630
الضّريح حيث يمكن إيجاد إله
—الحماية من النّار

132
00:08:19,240 --> 00:08:20,220
!أكيهابارا

133
00:08:23,130 --> 00:08:24,200
.صحيح

134
00:08:23,810 --> 00:08:25,400
س. الضّريح حيث يمكن إيجاد إله الحماية من النّار سُمّي تيمّنًا
بمدينة ما تُعرف بـ"المدينة الكهربائيّة"، فما هي؟
ج. أكيهابارا

135
00:08:29,570 --> 00:08:32,910
كان علينا أن نعرف أنّ فوكامي-سان ستهزمنا
.شرّ هزيمة في جولة الإصبع الأسرع

136
00:08:33,340 --> 00:08:36,860
.نعم، تمكّنتُ فقط من الإجابة على السّؤال الأخير

137
00:08:38,070 --> 00:08:39,410
...ومع ذلك

138
00:08:39,950 --> 00:08:43,860
لم أعلم أبدًا أنّ هنالك الكثير من مهووسي
.مسابقات الأسئلة مثل غاكتو

139
00:08:43,860 --> 00:08:47,950
ألم يؤثّر عليك تورّط أخيك
في مسابقات الأسئلة على الإطلاق؟

140
00:08:47,950 --> 00:08:52,880
أنا مهتمّة أكثر بصناعة الأشياء بدل الإجابة
.على الأسئلة، هذا كلّ ما في الأمر

141
00:08:55,180 --> 00:08:57,800
.ستكون الأزرار جاهزة قريبًا أيضًا

142
00:08:57,800 --> 00:08:59,500
.تطلّعوا قُدمًا لها

143
00:09:00,180 --> 00:09:03,030
!غاكتو! انتظر! أوصلني معك

144
00:09:03,030 --> 00:09:06,480
.إنّهما مقرّبان كثيرًا

145
00:09:09,340 --> 00:09:11,330
...بالمناسبة يا فوكامي-سان

146
00:09:11,330 --> 00:09:13,620
.شكرًا على نصيحتك بشأن الضّغط على الزّرّ

147
00:09:13,620 --> 00:09:14,840
.العفو

148
00:09:14,840 --> 00:09:19,160
.إنّ رؤيتك تبذل جهدًا كبيرًا تحفّزني أيضًا

149
00:09:20,750 --> 00:09:24,440
صحيح، ما الّذي جعلكِ تهتمّين بمسابقات الأسئلة؟

150
00:09:24,910 --> 00:09:25,870
!أريد أن أعرف أيضًا

151
00:09:27,440 --> 00:09:28,600
...حسنًا

152
00:09:29,360 --> 00:09:32,340
.أظنّ أنّ أخي قد أثّر بي

153
00:09:33,000 --> 00:09:34,550
أخوك؟

154
00:09:34,810 --> 00:09:38,130
،نعم. إنّه أكبر منّي بسنة واحدة

155
00:09:38,130 --> 00:09:40,690
.وهو يشارك في مسابقات الأسئلة منذ الإعداديّة

156
00:09:42,530 --> 00:09:45,380
،كنتُ أقرأ كتب مسابقات الأسئلة مثله

157
00:09:45,380 --> 00:09:47,640
.وجعلته يعلّمني ما يعرف عن مسابقات الأسئلة

158
00:09:48,610 --> 00:09:49,520
.السّؤال

159
00:09:50,420 --> 00:09:53,280
،"الاسم هو مقابل بالفرنسيّة لعبارة "البرق

160
00:09:53,280 --> 00:09:57,030
وهي معجّنات طويلة ورقيقة توضع
الشّكولاطة فوقها، فما هو؟

161
00:10:00,410 --> 00:10:01,580
...الجواب هو

162
00:10:02,800 --> 00:10:03,960
."إكلير"

163
00:10:05,230 --> 00:10:08,560
،في كلّ سنة في مهرجان مدرسة أخي

164
00:10:08,560 --> 00:10:11,420
.يقيم فريق مسابقات الأسئلة منافسة

165
00:10:12,580 --> 00:10:15,420
.وبدأت أشارك فيه مع الوقت

166
00:10:20,650 --> 00:10:24,660
لدى فريق مدرسة أخي لمسابقات
،الأسئلة تاريخ طويل

167
00:10:24,660 --> 00:10:26,640
لذلك فإنّ لقاء مسابقة الأسئلة
السّنويّة في المهرجان

168
00:10:26,640 --> 00:10:29,310
كان له شعبيّة كبيرة بحيث تكون
.كلّ الأماكن محجوزة

169
00:10:29,890 --> 00:10:33,590
.وكان كلّ المشاركين كبارًا فيما عاداي أنا

170
00:10:38,000 --> 00:10:38,670
!حمار

171
00:10:38,670 --> 00:10:43,900
.صحيح

172
00:10:39,950 --> 00:10:41,010
.مقاعد الصّفّ الأوّل

173
00:10:42,100 --> 00:10:43,030
.سيفون

174
00:10:44,200 --> 00:10:47,610
.حينها، ندمت حقًّا على المشاركة

175
00:10:48,170 --> 00:10:52,040
،تمكّنتُ من المشاركة في اللّقاء
.لكن لم أستطع الإجابة على أيّ سؤال

176
00:10:53,360 --> 00:10:55,750
...لكن في خضمّ كلّ ذلك

177
00:10:56,390 --> 00:10:57,260
.السّؤال

178
00:10:57,540 --> 00:10:59,760
،"الاسم هو مقابل بالفرنسيّة لعبارة "البرق

179
00:11:00,970 --> 00:11:02,590
—وهي معجّنات طويلة ورقيقة توضع

180
00:11:09,730 --> 00:11:10,660
."إكلير"

181
00:11:11,020 --> 00:11:12,130
.صحيح

182
00:11:23,790 --> 00:11:25,740
أعتقد أنّه بفضل ذلك السّؤال

183
00:11:25,740 --> 00:11:28,500
.أصبحت مهتمّة بمسابقات الأسئلة الآن

184
00:11:30,090 --> 00:11:32,980
،تمكّنت من الإجابة على سؤال واحد

185
00:11:32,980 --> 00:11:35,880
.لكن ما زلت لا أستطيع نسيان تلك اللّحظة

186
00:11:36,440 --> 00:11:39,970
فهمت... هذا أشبه بما حدث لي
."مع إجابة "داس غيمايني

187
00:11:41,420 --> 00:11:45,850
.والسّبب الآخر هو كيف بدا أخي في ذلك اليوم

188
00:11:48,180 --> 00:11:50,820
.فوكامي سيجي من السّنة الأولى إعداديّ

189
00:11:52,800 --> 00:11:54,560
.لن أخسر أمام التّلاميذ الكبار

190
00:11:54,960 --> 00:11:57,230
جولة الإصبع الأسرع المؤقّتة
.ستستمرّ لخمس دقائق

191
00:11:57,230 --> 00:11:58,630
.لنبدأ الآن

192
00:12:00,560 --> 00:12:01,710
.السّؤال

193
00:12:01,710 --> 00:12:05,530
،عندما تتخطّى طائرة سرعة الصّوت
—فإنّ الصّدمة النّاتجة

194
00:12:05,930 --> 00:12:06,780
.الدّويّ الصّوتيّ

195
00:12:06,780 --> 00:12:09,410
عندما تتخطّى طائرة سرعة الصّوت، فإنّ الصّدمة
النّاتجة تحدث صوتًا يعرف بأيّ اسم؟
ج. الدّويّ الصّوتيّ

196
00:12:07,070 --> 00:12:07,960
.صحيح

197
00:12:11,920 --> 00:12:13,240
.جائزة سيزار

198
00:12:13,240 --> 00:12:14,010
.نوِي

199
00:12:14,010 --> 00:12:15,340
.جوقة الفضاء

200
00:12:15,340 --> 00:12:16,320
.صحيح

201
00:12:24,710 --> 00:12:26,450
.كان رائعًا

202
00:12:27,320 --> 00:12:31,400
ممّا أخبرتٍنا به، فلا بدّ أنّ فريق مسابقات
.الأسئلة لتلك المدرسة رائع أيضًا

203
00:12:31,400 --> 00:12:33,060
ما المدرسة الّتي يرتادها أخوك؟

204
00:12:33,840 --> 00:12:36,350
...صحيح، إنّ أخي

205
00:12:36,990 --> 00:12:39,020
.تلميذ في السّنة الثّانية في ثانويّة كايجو

206
00:12:39,290 --> 00:12:40,510
!كايجو؟

207
00:12:40,510 --> 00:12:42,500
ثانويّة النّخبة؟

208
00:12:42,950 --> 00:12:46,030
ربّما ستتواجهان مع بعضكما
!في المنافسة في اللّقاء الدّوريّ

209
00:12:47,750 --> 00:12:51,250
.لسوء الحظّ، لن يشارك أخي في اللّقاء الدّوريّ

210
00:12:51,660 --> 00:12:53,160
ماذا؟ لماذا؟

211
00:12:54,440 --> 00:12:56,350
.لقد ترك مسابقات الأسئلة

212
00:12:57,920 --> 00:13:00,810
.قال أنّه يريد التّركيز على امتحانات القبول

213
00:13:01,350 --> 00:13:02,750
ما باليد حيلة، صحيح؟

214
00:13:04,160 --> 00:13:04,950
ماري؟

215
00:13:05,950 --> 00:13:07,140
.هذه أنت بالفعل يا ماري

216
00:13:07,620 --> 00:13:09,310
أذاهبة للمنزل؟

217
00:13:09,310 --> 00:13:10,390
من هذان؟

218
00:13:10,810 --> 00:13:11,630
...المعذرة

219
00:13:12,050 --> 00:13:15,280
.إنّهما زميلاي في الفصل كوشياما-كُن وإينوي-كُن

220
00:13:15,280 --> 00:13:17,270
.لقد أوصلاني للمنزل بعد أن تأخّرنا في نادينا

221
00:13:17,670 --> 00:13:20,230
.فهمت شكرًا على ذلك

222
00:13:20,540 --> 00:13:22,060
.ما... من مشكلة

223
00:13:22,060 --> 00:13:23,060
...أنت

224
00:13:23,750 --> 00:13:25,200
.سررت بلقائكما

225
00:13:25,640 --> 00:13:28,160
.أنا سيجي، أخو ماري الأكبر

226
00:13:28,330 --> 00:13:30,510
!سـ-سررنا بلقائك

227
00:13:30,510 --> 00:13:31,440
!يا له من أخ أكبر وسيم

228
00:13:31,440 --> 00:13:33,370
!هذا أخ لا يليق إلاّ بفوكامي-سان

229
00:13:34,210 --> 00:13:35,690
.لنذهب يا ماري

230
00:13:38,080 --> 00:13:41,160
.أراكما لاحقًا يا كوشياما-كُن وإينوي-كُن

231
00:13:42,150 --> 00:13:43,970
...أ-أكيد

232
00:13:43,970 --> 00:13:45,920
.إ-إلى اللّقاء

233
00:13:52,730 --> 00:13:55,240
.عدتَ باكرًا اليوم يا أخي

234
00:13:55,630 --> 00:13:58,100
.كان لدينا درس واحد فقط في المدرسة المتخصّصة

235
00:13:58,980 --> 00:14:01,330
هل تتأخّرين في العودة هكذا دائمًا؟

236
00:14:01,820 --> 00:14:03,070
.هذا لا يعجبني

237
00:14:03,500 --> 00:14:06,450
...أنا... لقد أخذني الحديث مع أصدقائي

238
00:14:07,160 --> 00:14:08,380
...لم أدرك

239
00:14:09,390 --> 00:14:11,100
.أنّك انضممت لنادٍ

240
00:14:11,700 --> 00:14:12,370
أيّ نادٍ؟

241
00:14:14,360 --> 00:14:18,600
آمل أنّك لن تقولي أنّك انضممت
.لمجموعة مسابقات الأسئلة تلك

242
00:14:23,000 --> 00:14:23,880
ما الّذي أخبرتك إيّاه؟

243
00:14:25,260 --> 00:14:29,090
.لا فائدة من مسابقات الأسئلة

244
00:14:40,430 --> 00:14:41,650
.تمّ تحديد الأمر إذًا

245
00:14:43,140 --> 00:14:45,860
.أنا سعيد لأنّه بعد امتحانات منتصف الدّورة

246
00:14:46,320 --> 00:14:47,990
...سيكون ذلك صعبًا

247
00:14:48,470 --> 00:14:50,700
!لماذا اخترن ذلك الموعد؟

248
00:14:50,700 --> 00:14:52,850
!إنّه قبل يومين من امتحانات منتصف الدّورة لدينا

249
00:14:52,850 --> 00:14:54,450
!لماذا مدرستنا هي الوحيدة الّتي لديها امتحانات وقتها؟

250
00:14:55,020 --> 00:14:57,510
.حسنًا، لا يسعنا فعل أيّ شيء حيال ذلك

251
00:15:04,410 --> 00:15:07,550
ميكوريا؟ ألا تحتاج لتدرس؟

252
00:15:07,550 --> 00:15:08,800
.إطلاقًا

253
00:15:09,090 --> 00:15:12,930
لن تكون امتحانات منتصف الدّورة
.أمرًا صعبًا ما دمتُ أنتبه في الدّروس

254
00:15:13,250 --> 00:15:16,060
.أنت المشارك الوحيد حتّى الآن

255
00:15:16,430 --> 00:15:20,290
.ارتح يا ميكوريا. لن ندعك تقوم بالأمر وحيدًا

256
00:15:21,080 --> 00:15:22,900
ماروياما، ستشارك أيضًا؟

257
00:15:23,480 --> 00:15:27,120
.فكّروا بالأمر فحسب. لا تسنح لنا فرص كهذه دائمًا

258
00:15:27,120 --> 00:15:30,240
!إنّها مدرسة للبنات فقط كما تعلمون
!حديقة من الفاكهة الحلوة

259
00:15:30,410 --> 00:15:34,280
هذا صحيح! ستكون الرّائحة هناك
!رائعة بكلّ تأكيد

260
00:15:38,170 --> 00:15:41,500
سيُعقد اللّقاء الدّوريّ في الأحد الأوّل
.من الشّهر القادم

261
00:15:42,000 --> 00:15:44,220
.اقرؤوا كلّ هذا حتّى ذلك الوقت

262
00:15:44,220 --> 00:15:46,500
كلّ هذا في نصف شهر؟

263
00:15:49,120 --> 00:15:52,490
.لا فائدة من مسابقات الأسئلة

264
00:15:54,110 --> 00:15:56,910
كيف له أن يقول أنّها بلا فائدة؟

265
00:15:57,890 --> 00:16:01,300
حسنًا، لقد أخفقت بالكامل في مسابقة
.الأسئلة على الورق

266
00:16:01,300 --> 00:16:03,410
.أعتقد أنّ عليّ قراءة بعضها

267
00:16:04,540 --> 00:16:06,440
.هذا جزء فقط ممّا لديّ

268
00:16:07,120 --> 00:16:09,630
أنا أجمع الأسئلة الماضية من المدارس
الأخرى بشكل دوريّ

269
00:16:09,630 --> 00:16:12,240
إضافة إلى أسئلة من مجموعات
.مسابقات أسئلة للكبار

270
00:16:16,060 --> 00:16:18,190
!ماذا؟ جميعها مليئة بالكلمات لا غير

271
00:16:18,190 --> 00:16:20,840
...هذا يناسبك تمامًا يا كوشياما

272
00:16:23,020 --> 00:16:25,600
.لديك الكثير منها منشور أمامك

273
00:16:26,870 --> 00:16:30,880
،ماذا؟ أنا... كنتُ أبحث عن شيء ما
...وحدث هذا فجأة

274
00:16:31,710 --> 00:16:33,250
ما الّذي كنتَ تقرأه؟

275
00:16:33,250 --> 00:16:34,590
...حسنًا

276
00:16:34,840 --> 00:16:36,100
دليل كيوتو؟

277
00:16:36,530 --> 00:16:37,970
أذاهب في رحلة أو ما شابه؟

278
00:16:38,370 --> 00:16:45,460
كلاّ، لكن هنالك الكثير من المعلومات
.في هذه عن التّاريخ والمآثر المحلّيّة

279
00:16:46,300 --> 00:16:48,570
ظننتُ أنّها قد تكون مفيدة
.في مسابقات الأسئلة أيضًا

280
00:16:51,400 --> 00:16:55,740
إذًا فقد كنتَ تقرأ دلائل سياحيّة لكلّ
مناطق كانساي لذلك السّبب؟

281
00:16:55,740 --> 00:16:58,500
.نعم. من الصّعب التّوقّف بمجرّد أن أبدأ

282
00:16:58,850 --> 00:17:01,040
...كما أنّي أشرد أحيانًا

283
00:17:01,400 --> 00:17:02,620
.هذه طريقة قراءة جيّدة

284
00:17:03,260 --> 00:17:05,350
من السّهل تذكّر معرفةٍ تتلقّاها

285
00:17:05,350 --> 00:17:09,460
عن طريق قراءة مصادر ذات علاقة
.بدل قراءة أيّ شيء عشوائيّ

286
00:17:09,790 --> 00:17:12,020
هل سيكون ذلك مفيدًا في مسابقات الأسئلة؟

287
00:17:12,020 --> 00:17:14,830
تُستعمل الأماكن المشهورة والتّخصّصات
.المحلّيّة في الأسئلة أحيانًا

288
00:17:16,490 --> 00:17:17,160
.السّؤال

289
00:17:29,500 --> 00:17:30,650
.طرأ أمر ما

290
00:17:34,440 --> 00:17:37,780
سينباي، ما الّذي جعلك تهتمّ بمسابقات الأسئلة؟

291
00:17:39,820 --> 00:17:43,040
ما الّذي جعلني أهتمّ بها؟
.يا له من سؤال سخيف

292
00:17:43,590 --> 00:17:48,130
هل نحتاج لسبب للقيام بما نحبّه؟

293
00:18:00,670 --> 00:18:03,680
...ساساجيما-سينباي رائع للغاية

294
00:18:05,230 --> 00:18:06,690
!ما الّذي جعلها تقول ذلك الآن؟

295
00:18:06,960 --> 00:18:10,270
!هذا صحيح! لا يهمّ السّبب إطلاقًا

296
00:18:10,930 --> 00:18:11,770
.آسف بشأن ذلك

297
00:18:13,170 --> 00:18:16,470
!أُحبّ ما أُحبّ، وسأقولها بكلّ فخر

298
00:18:16,470 --> 00:18:17,450
...أنا

299
00:18:19,120 --> 00:18:21,410
!أحبّ مسابقات الأسئلة

300
00:18:23,850 --> 00:18:27,040
!لا أدري ما الّذي يحدث، لكن أحسنت

301
00:18:27,830 --> 00:18:29,000
...جينكو-سان

302
00:18:29,400 --> 00:18:32,900
،ردًّا على حماسكم جميعًا

303
00:18:32,900 --> 00:18:36,220
!أودّ أن أقدّم لكن مجموعة الأزرار من صنعي

304
00:18:36,390 --> 00:18:37,590
أنهيتِ صناعتها؟

305
00:18:37,590 --> 00:18:38,470
متى حدث ذلك؟

306
00:18:38,740 --> 00:18:40,430
.قبل برهة

307
00:18:43,210 --> 00:18:43,890
!تفضّلوا

308
00:18:49,170 --> 00:18:50,600
علب غداء؟

309
00:18:51,160 --> 00:18:53,930
.إ-إنّها أزرار ضغط ظريفة للغاية

310
00:18:55,030 --> 00:18:56,990
.حسنًا، لنقم باختبار الأزرار

311
00:18:57,830 --> 00:18:58,700
!مواء

312
00:18:58,700 --> 00:19:00,030
!قباع

313
00:19:00,030 --> 00:19:01,060
!مأمأة

314
00:19:01,060 --> 00:19:02,210
!نقيق

315
00:19:02,210 --> 00:19:03,660
!لم تعجبني

316
00:19:03,660 --> 00:19:05,200
...إنّها لطيفة، لكن

317
00:19:05,710 --> 00:19:08,070
...سيجعلني هذا أنسى أيّ جواب خمّنتُه

318
00:19:08,070 --> 00:19:10,140
.أصلحي هذا غدًا

319
00:19:10,140 --> 00:19:12,670
.حسنًا، أنتم لا تعرفون كيف تمرحون

320
00:19:13,010 --> 00:19:15,000
!صحيح! السّؤال

321
00:19:15,390 --> 00:19:18,670
بماذا تسمّى فتاة ظريفة مثلي بلهجة كيوتو؟

322
00:19:19,060 --> 00:19:20,270
!مواء

323
00:19:22,720 --> 00:19:24,050
."بـ-ببّين"

324
00:19:24,050 --> 00:19:25,230
!غبيّ

325
00:19:25,230 --> 00:19:26,520
!صحيح

326
00:19:26,710 --> 00:19:29,290
،كانت الإجابة الصّحيحة
...ومع ذلك نُعتُّ بالغبيّ

327
00:19:34,800 --> 00:19:36,990
.حصلنا أخيرًا على أزرارنا الخاصّة

328
00:19:37,350 --> 00:19:40,430
.تحضيراتنا للّقاء الدّوريّ بدأت أخيرًا

329
00:19:51,840 --> 00:19:54,470
.يبدو أنّ كلّ المشاركات قد وصلت

330
00:19:55,520 --> 00:19:58,290
!يا أختي، انظري إليّ

331
00:19:58,290 --> 00:19:59,240
ماذا؟

332
00:19:59,880 --> 00:20:01,800
ما رأيك؟

333
00:20:00,860 --> 00:20:02,510
—مهلاً، ذلك

334
00:20:02,510 --> 00:20:04,630
!أرأيتِ؟ إنّه يناسبني تمامًا

335
00:20:05,190 --> 00:20:07,500
يكاد يحين وقت ارتداء الأزياء
المدرسيّة الصّيفيّة، صحيح؟

336
00:20:07,500 --> 00:20:09,850
!أعيريني هذا الزّيّ عندما يحين الصّيف

337
00:20:09,850 --> 00:20:11,870
ما الّذي قد تفعله به؟

338
00:20:11,870 --> 00:20:12,600
!اخلعه

339
00:20:13,040 --> 00:20:16,000
.أظنّ أنّه لن يُجدي، بما أنّنا نرتاد مدارس مختلفة

340
00:20:16,000 --> 00:20:17,220
تظنّ أنّ ذلك هو السّبب؟

341
00:20:18,340 --> 00:20:19,950
،بالمناسبة يا أختي

342
00:20:19,950 --> 00:20:23,840
هل القيام بمسابقات الأسئلة مع البقيّة ممتع؟

343
00:20:23,840 --> 00:20:27,330
.لدى مدرستك فريق أسئلة مسابقات ممتاز

344
00:20:27,330 --> 00:20:29,240
لماذا لا تجرّبه؟

345
00:20:29,560 --> 00:20:32,760
.لكنّ النّوادي مزعجة

346
00:20:33,600 --> 00:20:36,850
.لكنّي عثرت على شخص مثير للاهتمام

347
00:20:36,850 --> 00:20:38,500
."اسمه هو "كوشياما

348
00:20:38,900 --> 00:20:42,300
...كوشياما؟ سمعتُ ذلك الاسم من قبل

349
00:20:42,300 --> 00:20:44,260
.إنّه يقوم بمسابقات أسئلة أيضًا

350
00:20:45,510 --> 00:20:48,010
هل هو مهووس الأدب ذاك من مدرسة بوزو؟

351
00:20:48,640 --> 00:20:52,770
.لقد تقدّم للمشاركة في اللّقاء الدّوريّ
لكن كيف تعرفه أنت؟

352
00:22:30,510 --> 00:22:33,990
ذهب سيّد المسابقات المعتاد خاصّتنا
.إلى مكان معيّن

353
00:22:34,220 --> 00:22:36,500
!والآن، مباشرة من عين المكان: سيّد المسابقات

354
00:22:36,860 --> 00:22:41,680
نعم! أنا حاليًّا في المكان الّذي يحلم
!كلّ تلاميذ المدارس بزيارته، نيويورك

355
00:22:41,680 --> 00:22:44,890
ومكان لقاء مسابقات الأسئلة للثّانويّات
...هو بالطّبع يوجد

356
00:22:44,890 --> 00:22:46,880
!أمام تمثال الحرّيّة

357
00:22:48,160 --> 00:22:49,720
!أرغب بالذّهاب إلى هناك

358
00:22:49,990 --> 00:22:53,470
نعم، أتطلّع قُدمًا لمشاهدتك هنا
.يوما ما يا كوشياما-كُن

359
00:22:54,130 --> 00:22:56,870
...لنقم بالأمر جميعًا! كلمة السّرّ هي

360
00:22:56,870 --> 00:22:59,700
!النّصر