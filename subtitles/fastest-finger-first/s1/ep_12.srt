1
00:00:08,080 --> 00:00:10,860
.يبدو أنّك قد اكتشفت شيئًا يا كوشياما

2
00:00:11,190 --> 00:00:13,490
.لكنّي واثق من إجابتي

3
00:00:14,250 --> 00:00:15,780
...السّؤال الأبرز هنا

4
00:00:19,370 --> 00:00:20,950
—والآن أيّها اللاّعبون، أظهروا ألو

5
00:00:20,950 --> 00:00:22,380
.مهلاً لحظة

6
00:00:23,000 --> 00:00:25,830
.لنرَ إجاباتهم الواحد تلو الآخر

7
00:00:26,260 --> 00:00:28,290
.أودّ أن أسمع كيف خمّنوا الإجابة

8
00:00:28,570 --> 00:00:30,560
.حسنًا، سنبدأ بشيباتا-سان

9
00:00:32,000 --> 00:00:34,240
لماذا تعتقد أنّ الإجابة هي الجمعة؟

10
00:00:35,210 --> 00:00:39,100
،حسنًا... لم يكن هنالك تاريخ بالثّالث عشر
...لكن بدت جميعها مشؤومة

11
00:00:39,100 --> 00:00:41,660
فهنالك ما يسمّى "الجمعة الأسود"، صحيح؟

12
00:00:42,060 --> 00:00:44,240
.إنّه دور ميكوريا-كُن الآن

13
00:00:44,240 --> 00:00:47,060
سيحصل على عشرين نقطة
.إن كانت إجابته صحيحة

14
00:00:47,910 --> 00:00:49,270
.الأحد

15
00:00:50,010 --> 00:00:51,650
لماذا اخترت الأحد؟

16
00:00:52,260 --> 00:00:56,240
.عمليّة حسابيّة أساسيّة مبنيّة على متطابقة زيلر

17
00:00:56,410 --> 00:00:58,130
ما-ما رأيكم في هذا؟

18
00:00:58,130 --> 00:01:00,020
"وصل ميكوريا-كُن لتخمينه "الأحد

19
00:01:00,020 --> 00:01:01,990
!باستعمال الرّياضيّات وليس التّاريخ

20
00:01:01,990 --> 00:01:05,120
.إنّه ليس تخمينًا، بل إجابة ثابتة

21
00:01:05,440 --> 00:01:07,380
.إنّه دور كوشياما-كُن الآن

22
00:01:08,330 --> 00:01:11,800
.خمّنتُ إجابتي بطريقتي الخاصّة أيضًا

23
00:01:12,400 --> 00:01:13,440
.حاضر

24
00:01:13,440 --> 00:01:18,720
اكتشفتُ إجابتي بناءً على التّاريخ الثّالث
.الّذي في السّؤال وهو 15 ماي 1932

25
00:01:19,390 --> 00:01:24,100
كان ذلك تاريخ الانقلاب المعروف
،بحادثة الخامس عشر من ماي

26
00:01:24,100 --> 00:01:26,310
عندما اُغتيل رئيس الوزراء
...إينوكاي تسويوشي

27
00:01:27,000 --> 00:01:28,810
إذًا فقد استعمل حادثة الخامس عشر من ماي؟

28
00:01:29,020 --> 00:01:32,940
.لكنّي لم أعرف في أيّ يوم من أيّام الأسبوع كانت

29
00:01:33,300 --> 00:01:35,280
،تذكّرتُ كلّ التّفاصيل الّتي قرأتها عنها

30
00:01:35,280 --> 00:01:38,200
لكن لم يكن هنالك أيّ شيء
.يشير إلى يوم معيّن من الأسبوع

31
00:01:39,320 --> 00:01:41,010
.لكنّي تذكّرتُ شيئًا

32
00:01:41,010 --> 00:01:43,560
ذكر أحد الكتب عن حادثة الخامس عشر من ماي

33
00:01:43,560 --> 00:01:47,180
،أنّه حينما علمت زوجة رئيس الوزراء بالحادثة

34
00:01:47,180 --> 00:01:49,800
أسرعت إلى مسكنه من الفندق
.الّذي كانت تقيم فيه

35
00:01:50,850 --> 00:01:53,960
،قرأتُ الكتاب عندما كنتُ في الإعداديّة

36
00:01:54,830 --> 00:02:00,250
وتذكّرتُ أنّي تفاجأت أنّ الفندق الإمبراطوريّ
.كان موجودًا منذ ذلك الحين

37
00:02:00,620 --> 00:02:02,440
،حسب المعلومة الّتي في الكتاب

38
00:02:03,250 --> 00:02:07,760
،كانت زوجته تحضر حفل زفاف أُقيم في الفندق

39
00:02:07,760 --> 00:02:09,230
.عندما عادت مسرعة للمنزل

40
00:02:09,910 --> 00:02:10,860
هكذا إذًا؟

41
00:02:12,020 --> 00:02:12,980
...بعبارات أخرى

42
00:02:15,450 --> 00:02:17,870
،لأنّه كان حفل زفاف

43
00:02:17,870 --> 00:02:19,540
فلا بدّ أنّه أقيم يوم الأحد، صحيح؟

44
00:02:19,540 --> 00:02:22,210
،لم تكن أيّام السّبت عطلة حينها

45
00:02:22,210 --> 00:02:25,330
لذلك كانت تُقام معظم حفلات الزّفاف
.في أيّام الأحد أو العطلات

46
00:02:25,610 --> 00:02:28,830
،لم يعرف كلّ ذلك من الحادثة بحدّ ذاتها
بل من طرف ثالث؟

47
00:02:29,040 --> 00:02:31,460
!هذا مذهل يا كوشياما-كُن
!استنتاج ممتاز

48
00:02:31,700 --> 00:02:34,290
.كوشياما-كُن مثير للاهتمام بالفعل

49
00:02:34,290 --> 00:02:37,290
إن واصل اكتساب المزيد من الخبرة
،واعتاد أكثر على الأمور

50
00:02:37,290 --> 00:02:38,950
.قد يكون لاعب مسابقات أسئلة ممتازًا

51
00:02:41,800 --> 00:02:43,690
.دور سونوهارا-كُن الآن

52
00:02:43,690 --> 00:02:45,740
.كنتَ أنت من ضغط الزّرّ

53
00:02:45,740 --> 00:02:47,070
هل أنت واثق من نفسك؟

54
00:02:47,800 --> 00:02:50,480
!ماذا؟ كان مجرّد حدس

55
00:02:50,730 --> 00:02:52,090
أقلت كان حدسًا؟

56
00:02:52,090 --> 00:02:56,110
.إن أخطأت، فستخسر ثلاث نقاط وستُستبعد

57
00:02:56,110 --> 00:02:58,550
!هذا صحيح

58
00:03:00,350 --> 00:03:03,070
...لا أملك أيّ سبب وجيه خلف إجابتي، لكن

59
00:03:03,280 --> 00:03:04,830
.كلاّ

60
00:03:04,830 --> 00:03:07,810
أجاب كلاهما بيوم الأحد، صحيح؟

61
00:03:07,810 --> 00:03:08,940
...في تلك الحالة

62
00:03:10,540 --> 00:03:12,960
.لقد فزت بهذه اللّعبة الصّغيرة

63
00:03:13,570 --> 00:03:15,420
.أجبتُ بالأحد أنا أيضًا

64
00:03:17,590 --> 00:03:19,730
.حسنًا، سنكشف الآن عن الإجابة الصّحيحة

65
00:03:20,320 --> 00:03:23,950
كان السّؤال هو "‫5 أبريل عام 1722

66
00:03:23,950 --> 00:03:26,800
و22 يناير عام 1905

67
00:03:26,810 --> 00:03:29,730
.و15 ماي عام 1932

68
00:03:29,730 --> 00:03:31,730
،في أيّ يوم على وجه الخصوص
"كانت هذه التّواريخ من أيّام الأسبوع؟

69
00:03:32,500 --> 00:03:35,060
.الإجابة الصّحيحة هي يوم الأحد

70
00:03:37,100 --> 00:03:40,550
التّاريخ الأوّل ‫5 أبريل عام 1722،

71
00:03:40,550 --> 00:03:42,080
.كان يوم اكتشاف جزيرة القيامة

72
00:03:42,560 --> 00:03:47,080
لقد سُمّيت كذلك لأنّها اكتُشفت
.يوم أحد القيامة

73
00:03:47,230 --> 00:03:48,290
...أجل

74
00:03:48,700 --> 00:03:52,430
والتّاريخ الثّاني كانت مجزرة الأحد
.الدّمويّ خلال الثّورة الرّوسيّة

75
00:03:52,430 --> 00:03:53,540
.هذه معرفة عامّة بالطّبع

76
00:03:55,070 --> 00:03:58,430
والآن يا سونوهارا-كُن، بما أنّك أجبت
،بشكل صحيح بعد الضّغط على الزّرّ

77
00:03:58,430 --> 00:03:59,760
.وزّع نقاطك الثّلاثة رجاءً

78
00:04:04,760 --> 00:04:05,760
أكيرا-كُن؟

79
00:04:06,710 --> 00:04:10,420
أليس هذا غريبًا؟ كلّ ما فعلتُ
للقيام بهذه اللّعبة

80
00:04:10,420 --> 00:04:13,510
!قادني أخيرًا لأقرّر من سيفوز ومن سيخسر

81
00:04:13,510 --> 00:04:17,730
هل انتهت هذه اللّعبة؟ أم أنّه
ما زالت هنالك فرصة؟

82
00:04:18,590 --> 00:04:21,190
،لا أهتمّ فعلاً سواء فزتُ أم لا

83
00:04:21,680 --> 00:04:24,150
لكن تريدون فرصة جميعكم، صحيح؟

84
00:04:24,930 --> 00:04:29,280
انظروا! يريدونني جميع أن أنتزع
!النّقاط من صاحب أعلى مجموع

85
00:04:29,280 --> 00:04:31,790
.أسرع فحسب. أنت تضيّع وقتنا

86
00:04:35,260 --> 00:04:39,000
عندما تتمّ إغاظتي، لا يسعني
.إلاّ أن أقوم بردّ فعل

87
00:04:39,710 --> 00:04:41,630
...سأنتزع من ميكوريا تشيساتو

88
00:04:42,270 --> 00:04:43,720
!ثلاثة نقاط

89
00:04:45,120 --> 00:04:48,600
تراجه ميكوريا-كُن من تسعة عشر
!نقطة إلى ستة عشر

90
00:04:48,970 --> 00:04:51,710
لكنّه يحصل على نقطة واحدة
.على إجابته الصّحيحة

91
00:04:54,880 --> 00:04:57,650
!أحسنت يا كوشياما! أصبحتَ في الصّدارة

92
00:04:58,290 --> 00:05:01,610
.ليس باستعمال قدراتي الخاصّة

93
00:05:03,260 --> 00:05:05,250
!نأخذ جميعنا هذا الأمر على محمل الجدّ

94
00:05:05,250 --> 00:05:07,820
لماذا تواصل القيام بأمور غير
!متعاطفة للتّدخّل في ذلك؟

95
00:05:09,590 --> 00:05:10,930
ما الّذي تقوله؟

96
00:05:10,930 --> 00:05:13,960
.كنتَ لتخسر لو أنّني لم أنتزع النّقاط منه

97
00:05:13,960 --> 00:05:16,590
والآن، أمست لديك فرصة! أليس هذا جيّدًا؟

98
00:05:19,170 --> 00:05:20,450
!يعتقد أنّ الأمر مزحة

99
00:05:20,450 --> 00:05:22,170
!استبعدوه

100
00:05:22,370 --> 00:05:25,340
.توقّفا. انتزاع النّقاط جزء من القواعد

101
00:05:26,120 --> 00:05:29,310
يمكن لفائز حقيقيّ أن يفوز
.مهما كانت القواعد

102
00:05:31,780 --> 00:05:32,430
!كوشياما

103
00:05:34,000 --> 00:05:37,600
،إن تركتَ هذه الفرصة تفلت من يديك
.فسأضحك على فشلك من كلّ قلبي

104
00:05:39,460 --> 00:05:41,520
.ها هي ذي روحه التّنافسيّة

105
00:05:42,490 --> 00:05:45,570
لا شيء يحبط من عزيمة ميكوريا-كُن، صحيح؟

106
00:05:46,310 --> 00:05:48,160
.أعتقد أنّ هذا هو مصدر قوّته

107
00:05:56,930 --> 00:05:58,040
—سونوهارا-كُن، إلى أين

108
00:05:58,040 --> 00:06:01,260
.اكتفيت من هذا. أشعر بالملل

109
00:06:01,260 --> 00:06:02,250
.أنا أنسحب

110
00:06:03,670 --> 00:06:04,920
!ماذا؟

111
00:06:07,470 --> 00:06:08,590
!يا سونوهارا

112
00:06:10,450 --> 00:06:11,980
.الأمر ليس ممتعًا فحسب

113
00:06:13,410 --> 00:06:14,410
!أكيرا

114
00:06:14,410 --> 00:06:15,730
!إيّاك أيّتها الرّئيسة

115
00:06:16,060 --> 00:06:18,310
،أعلم أنّك قلقة على أخيك

116
00:06:18,760 --> 00:06:22,020
.لكن عليك ترك هذا لرئيس نادي سيكيغاواتا

117
00:06:26,250 --> 00:06:28,070
.نعم، معك حقّ

118
00:06:28,070 --> 00:06:32,450
عليّ أن أتحمّل مسؤوليّة استضافة
.اللّقاء الدّوريّ حتّى النّهاية

119
00:06:33,430 --> 00:06:37,960
بانسحاب سونوهارا-كُن، سيتواصل
.اللّقاء باللاّعبين الخمسة المتبقّين

120
00:06:50,540 --> 00:06:51,750
ما الّذي تريده؟

121
00:06:51,750 --> 00:06:54,300
من المزعج سماعك تقول أنّك تشعر بالملل

122
00:06:54,300 --> 00:06:55,930
.بينما لم تكن تلعب بجدّ من الأساس

123
00:06:56,410 --> 00:06:58,430
لماذا لا يمكنك أخذ المنافسة على محمل الجدّ؟

124
00:07:01,090 --> 00:07:04,190
يستطيع أيّ أحد اللّعب بأسلوبه الخاصّ
في أيّ لعبة كانت، صحيح؟

125
00:07:04,890 --> 00:07:08,690
والانسحاب قبل نهاية المنافسة هو "أسلوبك"؟

126
00:07:08,690 --> 00:07:10,550
.كلاّ، إنّه ليس كذلك

127
00:07:10,550 --> 00:07:14,340
سأستعمل التّوليفات اللاّنهائيّة وأستغلّ الهفوات
،أو الأوامر السّرّيّة في أيّ وقت بكلّ سرور

128
00:07:14,730 --> 00:07:17,660
لكنّي لن أستعمل أبدًا رموز اختراق
.أو برامج ترقيع مقرصنة

129
00:07:18,310 --> 00:07:19,870
عمّاذا تتحدّث؟

130
00:07:20,170 --> 00:07:22,910
...لكن في ذلك السّؤال الأخير

131
00:07:22,910 --> 00:07:24,840
تقصد سؤال أيّام الأسبوع؟ ماذا بشأنه؟

132
00:07:26,380 --> 00:07:30,230
حوّلتُ فرصة واحد من أصل سبعة
.إلى فرصتين من أصل سبعة

133
00:07:30,230 --> 00:07:33,510
كانجي يومَيْ الأحد والاثنين يُكتبان
بشكل مشابه، صحيح؟

134
00:07:35,750 --> 00:07:40,100
كتبتُه بشكل غير متقن بما يكفي لدرجة
.أن يتمّ قراءته الأحد أو الاثنين معًا

135
00:07:40,100 --> 00:07:43,070
إن كان من يُتوقّع مهم أن يجيبوا بشكل
،صحيح قد أجابوا بالأحد أو الاثنين

136
00:07:43,070 --> 00:07:44,980
.كنتُ لأختار نفس إجابتهم

137
00:07:47,050 --> 00:07:48,940
يمكن تسميتها الحركة المحرّمة
في الألعاب الأخرى، صحيح؟

138
00:07:48,940 --> 00:07:51,650
.لذلك اكتفيت. لقد بالغت في أخطائي

139
00:07:53,250 --> 00:07:56,780
الأحد أو الاثنين؟ إنّهما يُكتبان
.بكانجي مشابه بالفعل

140
00:07:56,780 --> 00:07:58,370
.أنت ماكر بالفعل

141
00:07:59,830 --> 00:08:01,040
—أسمع ذلك كثـ

142
00:08:05,150 --> 00:08:06,500
.لا تفعل ذلك ثانية

143
00:08:07,860 --> 00:08:10,930
!لـ-لن أفعل ذلك! هل أنت مجنون؟

144
00:08:10,930 --> 00:08:12,530
!إنّها مجرّد مسابقة أسئلة... لعبة غبيّة

145
00:08:12,530 --> 00:08:14,300
!إنّكم تتحمّسون كثيرًا بشأنها

146
00:08:14,450 --> 00:08:15,910
أهكذا ترى الأمر؟

147
00:08:15,910 --> 00:08:19,040
بدا لي وكأنّك أردتَ بشدّة إثارة
!سخط الجميع هناك

148
00:08:19,040 --> 00:08:20,640
!لا تملك أيّ أصدقاء، صحيح؟

149
00:08:21,520 --> 00:08:22,480
!ا-اخرس

150
00:08:22,480 --> 00:08:27,040
في كلّ الأحوال، ربّما تستطيع العبث بشكل غير
،مباشر مع من يأخذون هذا على محمل الجدّ

151
00:08:27,040 --> 00:08:29,640
لكنّك لا تملك الشّجاعة لمواجهتهم
!وجهًا لوجه، صحيح؟

152
00:08:29,640 --> 00:08:33,570
أنت مخطئ! لا يوجد من قد يواجهني
!مباشرة، هذا كلّ شيء

153
00:08:36,900 --> 00:08:38,490
!مهلاً! اتركني

154
00:08:39,000 --> 00:08:41,470
!ما مشكلتك؟! أفلت يدي

155
00:08:41,470 --> 00:08:43,010
.ادخل فحسب

156
00:08:43,010 --> 00:08:44,940
.يوشك الأمر أن يصبح مثيرًا للاهتمام

157
00:08:44,940 --> 00:08:46,460
!سوف تندم إن فوّتّه

158
00:08:48,230 --> 00:08:50,920
،وكّأه في البداية على الجدار
وها هما الآن يمسكان بأيدي بعضهما؟

159
00:08:50,920 --> 00:08:53,230
!يا إلهي! هل هذا تطوّر جديد؟

160
00:08:53,230 --> 00:08:55,100
...إنّ رئيس نادي سيكيغاوا

161
00:08:55,100 --> 00:08:57,760
...وأخو رئيسة نادي سونوهارا الصّغير

162
00:09:02,930 --> 00:09:05,080
إن ضغط ميكوريا-كُن على الزّرّ
،وأجاب بشكل صحيح

163
00:09:05,080 --> 00:09:06,890
.فسنحصل كلانا على عشرين نقطة

164
00:09:07,370 --> 00:09:12,400
عليّ أن أتجنّب الدّخول في مواجهةِ
.إصبعٍ أسرعَ حاسمة معه

165
00:09:13,700 --> 00:09:15,780
.بقيت ثلاثة أسئلة

166
00:09:15,780 --> 00:09:18,030
.يحتاج كوشياما لنقطة واحدة فقط

167
00:09:18,030 --> 00:09:20,240
كلّ ما عليه فعله هو الإجابة
...بشكل صحيح وسيفوز

168
00:09:20,240 --> 00:09:21,550
.السّؤال

169
00:09:21,550 --> 00:09:23,950
بماذا تُعرف دائرة الأعمال الّتي تحدث
—خلال أوقات الابتكار الـ

170
00:09:24,870 --> 00:09:25,580
!أجل

171
00:09:25,870 --> 00:09:28,240
ابتكار؟ قانون مور؟

172
00:09:28,240 --> 00:09:30,530
!لا أدري! لم أسمع ما يكفي من السّؤال

173
00:09:31,360 --> 00:09:33,990
.الإجابة الصّحيحة هي أمواج كوندراتييف

174
00:09:32,130 --> 00:09:36,880
س: بماذا تُعرف دائرة الأعمال الّتي تحدث أوقات الابتكار التّكنولوجيّ
مرّة كلّ خمسين سنة والّتي سُمّيت تيمّنًا بخبير اقتصاد روسيّ؟
ج: أمواج كوندراتييف

175
00:09:33,990 --> 00:09:37,280
أجاب كلّ من شيباتا-كُن وشيبويا-كُن
.وميكوريا-كُن إجابة صحيحة

176
00:09:37,280 --> 00:09:41,260
مع إضافة النّقاط إلى مجموع كلّ واحد
.منهم، أصبحت المعركة فوضويّة

177
00:09:41,260 --> 00:09:45,730
عليّ أن أصبح أفضل في الأسئلة المباشرة
.ذات نقاط التّحديد المبكّرة

178
00:09:46,060 --> 00:09:49,490
والآن يا شيباتا-كُن، كيف ستوزّع نقاطك الثّلاثة؟

179
00:09:50,070 --> 00:09:51,080
...حسنًا

180
00:09:51,650 --> 00:09:54,490
.سأنتزع نقطة من كوشياما-كُن من بوزو

181
00:09:56,320 --> 00:10:00,050
يبدو أنّك تستطيع الإجابة بشكل صحيح
.حتّى إن لم تضغط الزّرّ

182
00:10:00,050 --> 00:10:01,200
.لا تنزعج

183
00:10:01,370 --> 00:10:03,260
...أنا... كلاّ

184
00:10:03,260 --> 00:10:04,710
.شكرًا لك

185
00:10:05,480 --> 00:10:08,140
.لا تشكره على انتزاع نقاط منك

186
00:10:08,140 --> 00:10:10,040
...ماذا؟ مـ-معك حقّ

187
00:10:11,180 --> 00:10:12,500
.لكنّي أفهم الأمر

188
00:10:12,670 --> 00:10:13,680
.السّؤال

189
00:10:13,680 --> 00:10:17,640
،يُستعمل في أطباق مثل الكاري
—فما هو البُهار صاحب لقب "ملك

190
00:10:18,520 --> 00:10:21,010
!ضغط شيباتا-كُن على الزّرّ ثانية

191
00:10:21,640 --> 00:10:23,110
أين وصل الجميع الآن؟

192
00:10:23,110 --> 00:10:27,380
لدى شيباتا سبعة عشر نقطة وثمانية عشر
.نقطة لكلّ من ميكوريا وكوشياما

193
00:10:27,380 --> 00:10:29,020
.إنّه سباق متقارب

194
00:10:29,230 --> 00:10:31,820
!هذا مؤسف! إجابة خاطئة يا شيباتا-كُن

195
00:10:31,650 --> 00:10:35,150
س: يُستعمل في أطباق مثل الكاري، فما هو البُهار صاحب
لقب "ملك البهارات" الّذي أكستبه له رائحته الغنيّة؟
ج: الهال

196
00:10:31,820 --> 00:10:34,020
!سُحقًا

197
00:10:34,020 --> 00:10:36,960
!خسارة ثلاث نقاط مؤلمة لشيباتا-كُن

198
00:10:39,110 --> 00:10:42,450
يبدو أنّ الأمر الآن بين يدي ميكوريا-كُن
.وكوشياما-كُن في النّهاية

199
00:10:42,690 --> 00:10:45,990
!وصلنا إلى آخر سؤال أخيرًا يا أختاه

200
00:10:45,990 --> 00:10:48,450
.نعم يا يوكي-سان

201
00:10:48,450 --> 00:10:51,210
هل سنضع حدًّا لما قد أصبح
،معركة مفتوحة للجميع

202
00:10:51,210 --> 00:10:54,440
أم سننتقل لمواجهة حاسمة؟
!لا أطيق الانتظار لأرى ما سيحدث

203
00:10:54,440 --> 00:10:57,420
لننتقل الآن للسّؤال الأخير الّذي
!سيقرّر مصيرهم

204
00:10:57,980 --> 00:11:02,190
للفوز بهذا، أحتاج للضّغط على الزّرّ
.والفوز بثلاث نقاط

205
00:11:02,190 --> 00:11:03,890
.وسأخسر إن أجبت بشكل خاطئ

206
00:11:04,180 --> 00:11:05,770
.نحن في نفس المستوى

207
00:11:05,770 --> 00:11:07,100
!إنّها مواجهة مباشرة الآن

208
00:11:07,390 --> 00:11:08,600
.السّؤال

209
00:11:08,600 --> 00:11:10,850
،مكان يعدّ الآن وجهة للحجّاج المسيح

210
00:11:11,190 --> 00:11:12,600
—أقيم تصليب المسيح

211
00:11:18,100 --> 00:11:19,110
!لقد ضغط

212
00:11:19,390 --> 00:11:22,320
!لقد استعجل! لم تصل إلى نقطة التّحديد بعد

213
00:11:22,760 --> 00:11:23,920
!ضغطت باكرًا

214
00:11:24,390 --> 00:11:27,340
لكن راودني شعور أنّ ميكوريا-كُن
.كان ليسبقني في الضّغط

215
00:11:27,800 --> 00:11:30,460
!عليّ الآن اكتشاف الإجابة فقط

216
00:11:35,720 --> 00:11:38,760
!ضغط كوشياما-كُن من بوزو على الزّرّ

217
00:11:39,060 --> 00:11:41,020
...مواقع الحجّ المسيحيّة

218
00:11:41,020 --> 00:11:42,510
...المسيح والصّليب

219
00:11:42,510 --> 00:11:44,720
ما الإجابة الّتي أستطيع التّفكير بها
من بين هذه الأشياء؟

220
00:11:44,720 --> 00:11:48,470
.إنّه السّؤال الأخير، وأختك ذكيّة

221
00:11:49,020 --> 00:11:50,430
.لا بدّ أنّ ما خفي كان أعظم

222
00:11:56,730 --> 00:11:59,360
كيف أختار من بين كلّ هذه الاحتمالات المختلفة؟

223
00:11:59,360 --> 00:12:00,650
كان هذا أحد الأسئلة الكلاسيكيّة

224
00:12:00,650 --> 00:12:03,360
الّتي أعطانا إيّاها ساساجيما-سينباي
...للاستعداد للّقاء، ولكن

225
00:12:03,700 --> 00:12:05,910
.ذلك مستوى الصّعوبة الأمثل في هذه الجولة

226
00:12:06,220 --> 00:12:09,550
لا بدّ أن يكون مستوى صعوبة
.الّذي هو جزء من الجولة الثّالثة

227
00:12:10,320 --> 00:12:14,870
ربّما يكون المكان الّذي صلّى فيه المسيح
في اللّيلة الّتي سبقت تصليبه؟

228
00:12:15,610 --> 00:12:20,360
مهلاً. هل أعرف من الأساس كيف أميّز
بين مستويات صعوبة أسئلة المسابقات؟

229
00:12:20,680 --> 00:12:23,530
،كانت هنالك أسئلة عدّة كانت غامضة جدًّا

230
00:12:23,530 --> 00:12:25,260
.لكنّها كانت شائعة بالنّسبة لمسابقات الأسئلة

231
00:12:25,770 --> 00:12:29,020
بالنّسبة لمناطق الحجّ الأخرى، فهل
يعقل أن تكون كنيسة القيامة؟

232
00:12:29,700 --> 00:12:31,150
ما الأماكن الأخرى؟

233
00:12:31,650 --> 00:12:33,330
كيف لي أن أجيب على هذا السّؤال؟

234
00:12:33,330 --> 00:12:34,480
ما الّذي كان يدور في بال أساغاوكا؟

235
00:12:34,910 --> 00:12:36,190
.عشر ثوانٍ

236
00:12:36,440 --> 00:12:38,990
.يبدو أن كوشياما يعاني بشدّة

237
00:12:39,740 --> 00:12:41,650
.لقد حدّدتُ إجابتي سلفًا

238
00:12:41,980 --> 00:12:44,540
!الأخير... هذه هي

239
00:12:44,540 --> 00:12:49,020
ربّما الأمر لا يتعلّق بالصّعوبة، بل بكونه
السّؤال الأمثل لختم الجولة الثّالثة؟

240
00:12:49,020 --> 00:12:52,100
.الفئة هي اختصاص أساغاوكا: المسيحيّة

241
00:12:55,830 --> 00:13:00,200
تصليبه؟ صليبه؟ صليب... ماذا؟

242
00:13:00,200 --> 00:13:03,330
...التّصليب... الصّليب

243
00:13:03,790 --> 00:13:05,840
...السّؤال الأمثل ليكون الأخير

244
00:13:06,350 --> 00:13:10,210
!"الأخير... أجل! "الأخير

245
00:13:12,750 --> 00:13:14,720
...الشّارع الأخير الّذي مشى عليه المسيح

246
00:13:14,720 --> 00:13:17,370
الطّريق الّذي سُلك بينما أُخذ
...ليُصلّب في تلّة جلجثة

247
00:13:17,370 --> 00:13:19,820
!"طريق الآلام، "فيا دولوروسا

248
00:13:20,050 --> 00:13:24,320
هذه هي! الإجابة الأمثل للسّؤال
!الأخير في ربع النّهاية

249
00:13:31,120 --> 00:13:33,910
!والآن، أظهروا ألواحكم أيّها اللاّعبون

250
00:13:34,270 --> 00:13:35,790
.كنيسة القيامة

251
00:13:36,160 --> 00:13:37,170
.بيلاطس

252
00:13:37,400 --> 00:13:39,040
.بستان غثسيماني

253
00:13:39,410 --> 00:13:41,000
.فيا دولوروسا

254
00:13:41,270 --> 00:13:42,210
.آمين

255
00:13:42,760 --> 00:13:45,130
!أعطى الجميع إجابة مختلفة

256
00:13:46,030 --> 00:13:47,130
...هذه الإجابة

257
00:13:47,580 --> 00:13:49,140
!ستحدّد الفائز

258
00:13:49,370 --> 00:13:51,640
.والآن، لنسمع السّؤال بالكامل

259
00:13:52,130 --> 00:13:54,350
،مكان يعدّ الآن وجهة للحجّاج المسيح

260
00:13:54,640 --> 00:13:59,250
أقيم تصليب المسيح عيسى في اليوم
الّذي تلا صلاته في بستانٍ

261
00:13:59,250 --> 00:14:04,640
قائلاً: "كلّ الّذين يأخذون السّيفَ بالسّيفِ
يهلكون". فما هو هذا المكان؟

262
00:14:06,350 --> 00:14:07,150
...هذا

263
00:14:07,860 --> 00:14:12,790
الجولة الثّالثة، "كلّ الّذين يأخذون السّيفَ
.بالسيفِ يهلكون"، ستبدأ الآن

264
00:14:14,670 --> 00:14:17,180
.الإجابة الصّحيحة هي بستان غثسيماني

265
00:14:17,180 --> 00:14:19,620
بما أنّ ميكوريا-كُن كان الوحيد
،الّذي أجاب بشكل صحيح

266
00:14:19,620 --> 00:14:21,310
!فقد حصل على نقطتين

267
00:14:22,710 --> 00:14:24,830
آخر من يتأهّل من جولة ربع النّهاية

268
00:14:24,830 --> 00:14:26,880
.هو ميكوريا-كُن من ثانويّة مياورا

269
00:14:27,590 --> 00:14:30,390
!تهانينا للتّأهّل لنصف النّهاية

270
00:14:30,390 --> 00:14:34,160
كان السّؤال الأخير سؤالاً سيكون
،مناسبًا فقط في هذه الجولة

271
00:14:34,160 --> 00:14:36,760
.نظرًا لعنوان الجولة بحدّ ذاتها

272
00:14:37,810 --> 00:14:41,350
هذا هو الفرق بين مهارة
.ميكوريا-كُن وبين مهارتي

273
00:14:41,740 --> 00:14:42,870
.إنّه اختلاف كبير

274
00:14:43,850 --> 00:14:46,540
.بهذا تنتهي الجولة الثّالثة

275
00:14:46,540 --> 00:14:48,450
!لنصفّق لكلّ المتنافسين

276
00:14:52,180 --> 00:14:56,420
.ميكوريا-كُن... ما زلت لا أُعتبر ندًّا لك

277
00:14:56,420 --> 00:14:57,650
.هذا واضح

278
00:14:58,090 --> 00:15:01,000
...آ-آسف. طننتُ أنّي

279
00:15:09,240 --> 00:15:09,840
!كوشياما

280
00:15:12,640 --> 00:15:14,760
ما هو "فيا دولوروسا"؟

281
00:15:16,400 --> 00:15:19,730
.إنّه الطّريق الأخير الّذي سلكه المسيح

282
00:15:20,720 --> 00:15:23,190
.فعلاً؟ سأتذكّر ذلك

283
00:15:24,620 --> 00:15:26,000
لم تكن تعلم؟

284
00:15:30,980 --> 00:15:32,110
!الانتقام

285
00:15:32,390 --> 00:15:35,330
!سوف أواجهك بقدر ما يتطلّبه الأمر

286
00:15:36,370 --> 00:15:38,890
.وبالطّبع، سأفوز

287
00:15:41,840 --> 00:15:43,820
...فرحة الشّباب

288
00:15:43,820 --> 00:15:45,340
أليس كذلك يا سونوهارا؟

289
00:15:45,340 --> 00:15:47,510
أهذا ما أردتني أن أراه؟

290
00:15:48,120 --> 00:15:49,760
.سوف أغادر إن كنّا قد انتهينا

291
00:15:57,750 --> 00:15:58,670
!مهلاً

292
00:15:58,670 --> 00:15:59,960
!أكيرا

293
00:16:00,680 --> 00:16:03,650
!سوف تعاقب عندما نذهب للمنزل

294
00:16:04,240 --> 00:16:06,220
!وكأنّي أهتمّ

295
00:16:06,970 --> 00:16:07,820
!سونوهارا

296
00:16:09,910 --> 00:16:12,990
.ما زلنا سنتقابل كلّ يوم بعد الدّراسة

297
00:16:13,610 --> 00:16:15,450
،إن كنتَ ترغب في ذلك

298
00:16:15,720 --> 00:16:18,220
.تعال وجرّب أسئلة المسابقات ثانية

299
00:16:23,660 --> 00:16:26,170
!شارك في مسابقات الأسئلة معنا

300
00:16:42,600 --> 00:16:45,230
!أنا آسف للجميع

301
00:16:48,240 --> 00:16:52,960
أنا واثق أنّ بعضكم كان منزعجًا
.بتصرّف أصغر أعضائنا

302
00:16:52,960 --> 00:16:57,070
بصفتي رئيس نادينا، فسأتحمّل
.مسؤوليّة إرشاده

303
00:16:57,810 --> 00:16:59,930
.أنا مسؤولة أيضًا

304
00:16:59,930 --> 00:17:02,460
.لقد تسبّب أخي في الكثير من المشاكل

305
00:17:03,080 --> 00:17:04,160
.أنا آسفة

306
00:17:04,600 --> 00:17:07,430
ميكوريا، أليس لديك أيّ شيء لتقوله؟

307
00:17:07,430 --> 00:17:08,880
.لديك الحقّ لتقديم شكوى

308
00:17:08,880 --> 00:17:10,880
،تصرّفه الوقح يزعجني

309
00:17:10,880 --> 00:17:13,130
.لكن عليّ أن أعترف بإبداعه وشجاعته الخالصة

310
00:17:14,090 --> 00:17:15,910
.سأهزمه في المرّة القادمة

311
00:17:16,850 --> 00:17:20,060
.كوشياما، لقد عبث معك أكثر من غيرك

312
00:17:20,060 --> 00:17:22,030
...ماذا؟ كلاّ، أنا

313
00:17:25,050 --> 00:17:28,520
.رؤية ما تفعلونه من أجلي قد أراحتني

314
00:17:29,300 --> 00:17:33,150
أنا أيضًا لديّ زميل أكبر اعتذر
.من أجلي عندما أخطأت

315
00:17:33,460 --> 00:17:36,610
لديّ أصدقاء يريدون القيام
.بمسابقات الأسئلة معي

316
00:17:37,000 --> 00:17:38,890
.ولديّ أشخاص يدعمونني

317
00:17:40,210 --> 00:17:43,650
.لقد أثّر فيّ ذلك كثيرًا وجعلني سعيدًا

318
00:17:46,620 --> 00:17:50,150
.أنا واثق أنّه سيدرك ذلك أيضًا

319
00:17:55,970 --> 00:17:58,760
.سوف نبدأ الآن بإخلاء الغرفة

320
00:17:59,340 --> 00:18:04,300
شكرًا لكم جميعًا على المشاركة اليوم
.في لقاء أساغاوكا الدّوريّ

321
00:18:06,620 --> 00:18:08,070
.أبليتنّ حسنًا

322
00:18:08,070 --> 00:18:09,410
.كان لقاءً جيّدًا

323
00:18:09,410 --> 00:18:11,730
.سيقيم نادينا اجتماع مراجعة بعد هذا

324
00:18:11,990 --> 00:18:13,290
.حظًّا سعيدًا في المرّة القادمة

325
00:18:13,290 --> 00:18:14,190
.بذلتَ ما في وسعك

326
00:18:17,200 --> 00:18:19,370
كان اليوم حافلاً، صحيح يا كوشياما؟

327
00:18:19,720 --> 00:18:21,080
.نعم

328
00:18:21,590 --> 00:18:25,500
.انتهى اللّقاء الدّوريّ بفوز ساساجيما-سينباي بفارق كبير

329
00:18:27,420 --> 00:18:28,600
!إجابة صحيحة

330
00:18:34,410 --> 00:18:36,760
.تهانينا يا ساساجيما-كُن

331
00:18:36,760 --> 00:18:38,010
ما رأيك عن هذا اليوم؟

332
00:18:38,660 --> 00:18:41,160
،كان هذا أوّل لقاء لي منذ مدّة طويلة

333
00:18:41,160 --> 00:18:43,130
!وقد كان ممتعًا للغاية

334
00:18:43,860 --> 00:18:49,600
أعتقد أنّ كلّ مدرسة مشاركة هنا قد اكتشفت
.تحدّيّات وأهداف جديدة في هذا اللّقاء

335
00:18:50,090 --> 00:18:54,030
أتطلّع قُدمًا لأرى كيف سيؤدّي جميع
.من هنا في المستقبل

336
00:18:54,830 --> 00:18:56,810
،بعد فوزك بهذا اللّقاء اليوم

337
00:18:56,810 --> 00:18:59,200
.ستصبح هدفًا للعديد من اللاّعبين الآخرين ثانية

338
00:18:59,620 --> 00:19:01,660
.سأصبح هدفًا؟ على الإطلاق

339
00:19:02,730 --> 00:19:04,960
.نصبح جميعًا سواسية بعد نهاية اللّقاء

340
00:19:04,960 --> 00:19:07,120
.وسيحين اللّقاء التّالي قريبًا

341
00:19:07,570 --> 00:19:09,830
.يبدو أنّه سيكون صيفًا ساخنًا

342
00:19:10,110 --> 00:19:12,540
.هذه هي آخر سنة لنا نحن تلاميذ السّنة الثّالثة

343
00:19:13,010 --> 00:19:14,420
.أريد أن أعيش بلا ندم

344
00:19:17,240 --> 00:19:21,040
،في المرّة القادمة، كما اليوم
.سنبدأ جميعًا من نفس خطّ الانطلاق

345
00:19:21,480 --> 00:19:24,850
.أتطلّع قُدمًا للتّنافس معكم جميعًا ثانية

346
00:19:26,110 --> 00:19:29,140
...أريد مواصلة مسابقات الأسئلة

347
00:19:29,410 --> 00:19:32,120
عليك أن تبذل ما بوسعك فقط
!في المرّة القادمة

348
00:19:32,120 --> 00:19:35,070
سيشارك لاعبون من كلّ أنحاء
.البلاد في اللّقاء التّالي

349
00:19:35,420 --> 00:19:37,610
!سيضعون جميعًا النّصر نصب أعينهم

350
00:19:38,360 --> 00:19:40,570
بطولة مسابقات الأسئلة للثّانويّات؟

351
00:19:41,100 --> 00:19:42,820
من كلّ أنحاء البلاد؟

352
00:19:43,370 --> 00:19:45,670
سيكون هنالك لاعبون مخضرمون
!أكثر لم نلتقي بهم بعد

353
00:19:46,610 --> 00:19:48,740
أشعر بالفعل وكأنّني في نادٍ، صحيح؟

354
00:19:49,350 --> 00:19:50,580
!لم يراودني شعور كهذا من قبل

355
00:19:51,110 --> 00:19:52,040
!أ-أجل

356
00:19:53,020 --> 00:19:56,550
فوكامي-سان، شكرًا لدعوتك
.لي لمجموعة أسئلة المسابقات

357
00:19:58,220 --> 00:20:00,630
.لنقبل جميعًا بتحدّيّات أكثر معًا

358
00:21:37,020 --> 00:21:37,980
!ميكوريا-كُن

359
00:21:41,650 --> 00:21:43,200
!شكرًا على اليوم

360
00:21:43,200 --> 00:21:45,140
!سأتطلّع قُدمًا للمرّة القادمة

361
00:21:45,140 --> 00:21:45,900
—حينها، سوف

362
00:21:45,900 --> 00:21:48,120
هل سترضيك هزيمتك لي؟

363
00:21:49,620 --> 00:21:51,440
.هنالك من هو أمهر دائمًا

364
00:21:51,440 --> 00:21:53,480
.لن تلحق بالرّكب أبدًا إن تباطأت

365
00:21:53,480 --> 00:21:55,290
.لن أنتظرك

366
00:22:01,040 --> 00:22:04,460
!أعترف بمن يسعون للقمّة فحسب

367
00:22:05,000 --> 00:22:08,600
.لقد وجدتُ ندًّا مذهلاً

368
00:22:15,120 --> 00:22:17,790
.أنت قاسٍ بالفعل

369
00:22:19,650 --> 00:22:22,680
...وما ينتظر في الأمام حيث يسعى ندّي المذهل

370
00:22:22,680 --> 00:22:25,670
!هو مكان أريد رؤيته أيضًا

371
00:22:36,440 --> 00:22:37,520
.سأسعى للقمّة

372
00:22:42,830 --> 00:22:45,670
!إنّها منافسة لنرى من منّا سيسمو أكثر