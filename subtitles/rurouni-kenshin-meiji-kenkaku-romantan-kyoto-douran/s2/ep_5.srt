1
00:00:01,050 --> 00:00:02,180
...سنكاكو

2
00:00:03,050 --> 00:00:06,610
.لم أتوقّع أنّ تنتصر منذ البداية

3
00:00:06,970 --> 00:00:11,370
لكنّ الخسارة في مواجهته دون دفعه
...للكشف عن حركة واحدة على الأقلّ

4
00:00:11,770 --> 00:00:15,500
.ستجعلني أضع حدًّا لحياتك بنفسي

5
00:00:22,860 --> 00:00:26,000
...أسلوب سنكاكو السّرّيّ

6
00:00:28,450 --> 00:00:31,460
!المنجنيق البشريّ الخارق

7
00:00:32,080 --> 00:00:35,180
.مفهوم؟ بصمت كي لا يلاحظوك

8
00:00:35,380 --> 00:00:36,970
...أسلوب هيتن ميتسوروغي

9
00:00:39,550 --> 00:00:40,860
!وميض التّنّين المحلّق

10
00:00:49,390 --> 00:00:53,040
.احمل سيفك يا شيشيو ماكوتو

11
00:01:01,940 --> 00:01:07,670
روروني كنشين
—اضطرابات كيوتو—

12
00:02:30,700 --> 00:02:31,960
.مغفّل

13
00:02:32,450 --> 00:02:35,550
تُظهر الرّحمة حتّى لأغبياء من أمثاله؟

14
00:02:35,960 --> 00:02:38,060
.إنّ لينك هذا سيكلّفك حياتك

15
00:02:38,460 --> 00:02:40,010
.لا أهتمّ إطلاقًا

16
00:02:40,460 --> 00:02:43,480
لستُ بحاجة لبذل جهد كبير
."في مواجهة "زميل أصغر

17
00:02:45,460 --> 00:02:47,640
...لا أفهم ما يحدث تمامًا

18
00:02:47,640 --> 00:02:49,610
.لكنّ شيئًا مذهلاً يحدث

19
00:02:50,590 --> 00:02:54,200
.هذا ليس أمرًا علينا حشر أنوفنا فيه

20
00:02:54,690 --> 00:02:57,490
.لا حاجة للتّسلّل خلسة
.يمكنكما الوقوف بكرامة والمشاهدة

21
00:02:58,440 --> 00:03:01,080
.لكن لا تبتعدا عنّي فحسب

22
00:03:01,480 --> 00:03:02,620
...ميساو-دونو

23
00:03:03,450 --> 00:03:06,500
ذلك الهجوم قبل قليل
."الّذي سمّته "وميض التّنّين المحلّق

24
00:03:08,610 --> 00:03:12,210
استعملتَ الجانب غير الحادّ لسيفك
...لضرب ذقن سنكاكو

25
00:03:12,910 --> 00:03:16,970
لكنّها في الأصل تقنية يُستعمل فيها
الجانب الحادّ وتقطع للأعلى، صحيح؟

26
00:03:18,080 --> 00:03:19,300
.نعم

27
00:03:19,300 --> 00:03:20,770
.يا لها من خيبة أمل

28
00:03:21,170 --> 00:03:27,270
سمعتُ أنّ زميلي الأقدم لم يعُد هيتوكيري
.وصار روروني لا يقتل من تقارير أعواني

29
00:03:28,130 --> 00:03:32,990
لكن كان من الصّعب تصديق
.ذلك حتّى رأيت الأمر بأمّ عينيّ

30
00:03:34,180 --> 00:03:38,440
من رابع المستحيلات
.أن تستطيع هزيمتي هكذا

31
00:03:42,350 --> 00:03:43,950
.يا إلهي

32
00:03:44,360 --> 00:03:46,420
.أنا لا أقبل القتالات المملّة

33
00:04:01,960 --> 00:04:03,930
.سأنتظرك في كيوتو

34
00:04:04,540 --> 00:04:07,350
.التحق بي هناك بمجرّد أن تصير هيتوكيري ثانية

35
00:04:07,800 --> 00:04:10,350
.أراك تهرب وأنت تجرّ أذيال الخيبة

36
00:04:18,640 --> 00:04:21,360
.سوجيرو، العب معه بدلاً منّي

37
00:04:21,980 --> 00:04:23,280
أيمكنني ذلك؟

38
00:04:23,520 --> 00:04:28,740
نعم. وكتعبير عن شكري لرؤية وميض
.التّنّين المحلّق، أرهم تقنية تنكن خاصتّك

39
00:04:34,990 --> 00:04:38,500
،إن كانت هذه رغبتك يا شيشيو-سان
.فلن أتردّد أبدًا

40
00:04:38,660 --> 00:04:41,460
.أراك لاحقًا يا زميلي الأقدم

41
00:04:47,920 --> 00:04:49,100
!يا هيمورا

42
00:04:49,100 --> 00:04:50,720
لماذا أنت شارد هكذا؟

43
00:04:50,880 --> 00:04:54,310
،إن لم تسرع الآن
!فسيهرب ذو الضّمادات ذاك

44
00:04:59,600 --> 00:05:01,870
ما-ما كان ذلك للتّوّ؟

45
00:05:05,200 --> 00:05:10,170
لا فائدة. حتّى إن ضربته بهالة سيفك
.هكذا، فستكون مضيعة للوقت

46
00:05:10,570 --> 00:05:12,660
.كنتُ أقوم بذلك طوال الوقت

47
00:05:13,490 --> 00:05:18,510
،لا يمتلك ذلك الشّخص أيّ هالة سيف
.ولا نيّة للقتل، ولا روحًا قتاليّة

48
00:05:23,000 --> 00:05:24,090
.شيشيو-ساما

49
00:05:24,090 --> 00:05:24,920
ماذا؟

50
00:05:25,120 --> 00:05:27,220
ما هي "تنكن" تلك الّتي ذكرتها قبل قليل؟

51
00:05:27,500 --> 00:05:29,230
.إنّه لقبه

52
00:05:29,670 --> 00:05:31,680
.سيف يُحمل بموهبة فطريّة سماويّة

53
00:05:31,680 --> 00:05:33,020
.أو "تنكن" باختصار

54
00:05:33,130 --> 00:05:36,570
لكن ألا يمكن قول نفس الشّيء عن الباتّوساي؟

55
00:05:36,970 --> 00:05:37,900
.أظنّ ذلك

56
00:05:38,800 --> 00:05:42,660
ولكن بسبب مشاكل سوجيرو
...العائليّة كطفل

57
00:05:43,060 --> 00:05:47,240
.فإنّه يفتقر لكلّ المشاعر فيما عدى المتعة

58
00:05:48,270 --> 00:05:51,370
.ولأنّه يفتقر للفرح، فلا روح قتاليّة له

59
00:05:51,370 --> 00:05:54,040
.ولأنّه يفتقر للغضب، فلا نيّة قتلٍ له

60
00:05:54,040 --> 00:05:56,160
،مهما علا مستوى السّيّاف

61
00:05:56,160 --> 00:05:59,500
زادت احتماليّة استجابته
.لهالة الخصم الهجوميّة

62
00:05:59,500 --> 00:06:01,840
.لكنّ ذلك النّهج لن ينفع ضدّ سوجيرو

63
00:06:02,240 --> 00:06:06,720
في الحقيقة، كان سايتو يبحث
عن فرصة لمهاجمتي طوال الوقت

64
00:06:06,720 --> 00:06:10,600
لكنّه لم يستطع توقّع ما قد تكون خطوة
.سوجيرو الّذي كان إلى جانبه ولم يهاجم

65
00:06:11,050 --> 00:06:14,140
إنّ الأمر أسوأ بكثير بالنّسبة لأسلوب
،هيتن ميتسوروغي الخاصّ بالباتّوساي

66
00:06:14,140 --> 00:06:17,270
.لأنّه يتوقّع في الحال عقليّة الخصم

67
00:06:18,640 --> 00:06:20,060
.أنا آسف

68
00:06:20,550 --> 00:06:24,650
.إن لم أسرع، فلن أستطيع اللّحاق بشيشيو-سان

69
00:06:44,250 --> 00:06:45,840
.هيمورا

70
00:06:45,840 --> 00:06:47,420
.إذًا فهكذا سينتهي الأمر

71
00:06:48,000 --> 00:06:52,140
إن كان لا يستطيع استعمال هالة
،السّيف للحصول على الأفضليّة

72
00:06:52,140 --> 00:06:55,900
فإنّ أفضل نهج لاتّباعه هو المبادرة
.بالهجوم بأسرع تقنية سيف لديه

73
00:06:56,300 --> 00:06:58,570
تقنية سحب السّيف، الباتّوجتسو؟

74
00:06:59,510 --> 00:07:01,310
.سأقوم بذلك أيضًا

75
00:07:17,530 --> 00:07:21,500
.على الأرجح أنّ النّزال سيكون صدامًا للباتّوجتسو

76
00:07:33,630 --> 00:07:35,180
...سرعة السّيف

77
00:07:41,970 --> 00:07:43,070
.متساوية

78
00:07:46,400 --> 00:07:47,450
...ولكن

79
00:08:08,910 --> 00:08:15,230
بالنّسبة لسوجيرو الّذي يفتقر
...للحزن ولا يؤثّر فيه قتل الآخرين

80
00:08:15,750 --> 00:08:20,430
والباتّوساي الّذي قرّر ألاّ يقتل
...أيّ إنسان آخر ثانية

81
00:08:20,970 --> 00:08:22,850
،حتّى إن امتلك كلاهما التّنكن

82
00:08:22,850 --> 00:08:25,400
.فهنالك فرق واضح في كيفية تنفيذ الهجوم

83
00:08:25,930 --> 00:08:28,940
،ما لم يتخلّص من فكرة رفض القتل

84
00:08:28,940 --> 00:08:31,120
.فلا يستطيع الباتّوساي الفوز ضدّ سوجيرو

85
00:08:33,480 --> 00:08:35,250
.أظنّ أنّ النّزال قد انتهى

86
00:08:35,650 --> 00:08:36,580
.نعم

87
00:08:37,480 --> 00:08:40,790
.كلاكما غير قادر على القتال
.إنّه تعادل حسب ما أرى

88
00:08:44,200 --> 00:08:46,670
!أجل! هذا هو المتوقّع من هيمورا

89
00:08:46,950 --> 00:08:50,000
.كم هذا رائع

90
00:08:50,000 --> 00:08:52,260
.لا أظنّني أستطيع إصلاحه الآن

91
00:08:52,830 --> 00:08:55,880
.لا يهمّ. كان سيفَ شيشيو-سان على كلّ حال

92
00:08:57,750 --> 00:09:01,020
.لم يكن هنالك فائز أو خاسر في هذا النّزال بالفعل

93
00:09:01,510 --> 00:09:03,560
.سأستأذن بالذّهاب الآن

94
00:09:03,800 --> 00:09:06,400
.قاتلني ثانية إن أردت لو سمحت

95
00:09:07,390 --> 00:09:12,240
.من الأفضل أن تُحضر سيفًا جديدًا

96
00:09:16,020 --> 00:09:17,210
.هيمورا

97
00:09:36,630 --> 00:09:39,100
.مِن هنا؟ أتساءل إن كنت سألحق به

98
00:09:39,500 --> 00:09:40,650
...عفوًا

99
00:09:41,460 --> 00:09:43,140
.مرحبًا

100
00:09:43,140 --> 00:09:45,770
ما الّذي حدث لسنكاكو-ساما؟

101
00:09:45,970 --> 00:09:49,230
.صحيح... لقد هُزم في الدّاخل

102
00:09:49,430 --> 00:09:52,230
في تلك الحالة، ما الّذي علينا فعله الآن؟

103
00:09:52,810 --> 00:09:55,360
.ماذا؟ صحيح

104
00:09:55,690 --> 00:09:59,660
أتساءل ما كان شيشيو-سان ليفعله؟

105
00:10:03,540 --> 00:10:07,630
.أنا آسف. سأسأل شيشيو-سان عنكم جميعًا

106
00:10:08,030 --> 00:10:10,550
.لذلك كونوا في حالة تأهّب حتّى ذلك الوقت

107
00:10:10,950 --> 00:10:13,000
تأهّب؟

108
00:10:13,160 --> 00:10:14,340
.نعم

109
00:10:14,340 --> 00:10:18,470
،أنا في عجلة من أمري
.لذلك تولّوا الأمور حسب ذلك

110
00:10:18,630 --> 00:10:19,510
!مع السّلامة

111
00:10:29,300 --> 00:10:30,440
...هيمورا-سان

112
00:10:34,480 --> 00:10:35,980
!كان سريعًا

113
00:10:37,990 --> 00:10:40,990
روروني كنشين
—اضطرابات كيوتو—

114
00:10:45,610 --> 00:10:47,090
...ذلك السّاكاباتو

115
00:10:47,910 --> 00:10:49,410
.انكسر

116
00:10:49,620 --> 00:10:51,840
.وتركنا جماعة شيشيو تهرب

117
00:10:52,240 --> 00:10:53,630
!أنت

118
00:10:53,630 --> 00:10:54,550
...حسنًا

119
00:10:55,250 --> 00:10:59,730
،بإمكاني أن أطلب دقّ سيف آخر
.وبإمكاننا مطاردة جماعة شيشيو لاحقًا

120
00:11:00,130 --> 00:11:03,550
.أمّا الآن، فعلينا التّخلّص من رجال شيشيو

121
00:11:03,800 --> 00:11:05,940
.ذلك وحده كافٍ بالنّسبة لي

122
00:11:17,730 --> 00:11:19,610
.لا يزال يتنفّس

123
00:11:19,610 --> 00:11:20,990
—الـ

124
00:11:21,150 --> 00:11:23,870
.النّجدة

125
00:11:25,740 --> 00:11:27,290
!النّجدة –
!النّجدة –

126
00:11:27,290 --> 00:11:28,460
!أنجدونا

127
00:11:31,450 --> 00:11:32,330
!إيجي

128
00:11:33,740 --> 00:11:35,750
—مهلاً، لقد سُوّيت المسألة

129
00:11:35,950 --> 00:11:38,130
!مت يا سنكاكو

130
00:11:40,210 --> 00:11:41,770
.لا تقتله بدون أن تسألني

131
00:11:42,460 --> 00:11:45,220
.ثمّة العديد من الأمور الّتي عليّ معرفتها منه

132
00:11:49,260 --> 00:11:50,230
!إيجي

133
00:11:51,550 --> 00:11:53,310
!عليّ أخذ ثأري من ذلك الرّجل

134
00:11:53,310 --> 00:11:54,860
!لا تعترض طريقي

135
00:11:54,860 --> 00:11:55,740
.مغفّل

136
00:11:56,100 --> 00:11:59,440
تمّ حظر القتل بدافع الثّأر
.في السّنة السّادسة من حقبة ميجي

137
00:11:59,850 --> 00:12:03,660
،حتّى إن لم تقتله
،فسيتمّ إعدامه شنقًا بكلّ تأكيد

138
00:12:03,660 --> 00:12:07,280
مع الميزة الإضافيّة المتمثّلة
.في التّعذيب أثناء الاستجواب

139
00:12:07,570 --> 00:12:12,250
سيكون ذلك مؤلمًا أكثر بكثير من
.تلقّيه لضربة قاتلة وهو فاقد للوعي

140
00:12:12,530 --> 00:12:13,710
.شيطان

141
00:12:13,910 --> 00:12:14,840
!اخرس

142
00:12:15,200 --> 00:12:17,540
!لا أهتمّ بالقوانين أو المشنقة

143
00:12:17,830 --> 00:12:20,210
،إن لم آخذ بثأري منه بيديّ هاتين

144
00:12:20,210 --> 00:12:21,760
!فإنّ أخي والبقيّة لن يرقدوا بسلام

145
00:12:21,760 --> 00:12:22,850
.إيجي

146
00:12:23,790 --> 00:12:29,980
،لا يرغب الموتى في الثّأر
.بل في سعادة الأحياء

147
00:12:31,130 --> 00:12:35,940
حتّى إن لطّختَ يديك الصّغيرتين هاتين
.بالدّماء، فلن يُفرح ذلك أيّ أحد

148
00:12:36,260 --> 00:12:40,230
،مع مرور الوقت
،ستكبر هاتان اليدان الصّغيرتان

149
00:12:40,230 --> 00:12:42,160
.وستصير رجلاً راشدًا

150
00:12:43,020 --> 00:12:47,820
ووقتها، لا تكن رجلاً يقمع الآخرين
.بالقوّة مثل جماعة شيشيو

151
00:12:48,740 --> 00:12:53,160
لا تكن رجلاً يشلّه الخوف
.من العنف مثل أولئك القرويّين

152
00:12:54,240 --> 00:13:00,220
،كن رجلاً مثل أخيك
.الّذي قلق عليك حتّى الرّمق الأخير

153
00:13:02,500 --> 00:13:04,270
.كن سعيدًا لو سمحت

154
00:13:16,680 --> 00:13:20,110
.أعتقد أنّ كلّ شيء قد سُوّيَ الآن

155
00:13:21,230 --> 00:13:22,110
.تفضّل

156
00:13:22,270 --> 00:13:24,870
.سأعطيك منديلاً لمسح تلك الدّموع

157
00:13:28,440 --> 00:13:29,530
—أيّها الـ

158
00:13:29,530 --> 00:13:30,370
.على مهل

159
00:13:30,370 --> 00:13:33,200
ما الّذي تظنّ أنّك تفعله بالضّبط يا هذا؟

160
00:13:33,200 --> 00:13:36,340
سُوّيَ كلّ شيء"؟"

161
00:13:44,250 --> 00:13:45,550
.لقد تأخّر

162
00:13:46,170 --> 00:13:48,510
.أتساءل إن كان قد ضاع

163
00:13:51,010 --> 00:13:52,010
.لا

164
00:13:53,670 --> 00:13:55,480
!شيشيو-سان

165
00:13:55,930 --> 00:13:57,490
!من هنا

166
00:14:06,440 --> 00:14:08,610
تفهم أنّها لم تكن غلطتي، صحيح؟

167
00:14:08,610 --> 00:14:11,530
،إن كنتَ ستغضب
.فرجاءً اغضب من هيمورا-سان

168
00:14:11,940 --> 00:14:16,550
ألحق كلّ هذا الضّرر بالنّاغاسوني
كوتتسو بالسّاكاباتو خاصّته؟

169
00:14:16,950 --> 00:14:18,960
.أعتقد أنّي استهنتُ به

170
00:14:18,960 --> 00:14:19,960
كوتتسو؟

171
00:14:19,960 --> 00:14:23,840
،يا فتى، أنت موهوب
.لكنّك تجهل الكثير من الأمور

172
00:14:24,120 --> 00:14:28,590
.إنّه كوتتسو شهير
.سيف من بين 31 سيفًا عظيمًا

173
00:14:28,590 --> 00:14:32,430
.إنّه فريد من نوعه
.كان أيّ سيّاف خبير ليرغب فيه بشدّة

174
00:14:32,840 --> 00:14:35,470
أهو باهظ الثّمن لهذا الحدّ؟

175
00:14:35,470 --> 00:14:36,850
.لا يُقدّر بثمن

176
00:14:36,850 --> 00:14:40,900
تعادل قيمته المبلغ الّذي قد تُحرّر
.به أفضل أويران في حيّ المتعة

177
00:14:41,060 --> 00:14:43,860
.استطاع إلحاق كلّ ذلك الضّرر بسيف مثله

178
00:14:43,860 --> 00:14:45,830
.لا يجب أن تسامح هيمورا-سان على ذلك

179
00:14:45,940 --> 00:14:49,200
سوجيرو، هل يمكنني أن أطلب منك خدمة؟

180
00:14:49,610 --> 00:14:52,070
.اطلب أيّ شيء عدا مبلغ تعويض له

181
00:14:52,070 --> 00:14:55,840
.اجمع كلّ سيوف كيوتو العشرة في الحال

182
00:14:56,240 --> 00:14:57,790
السّيوف العشرة؟

183
00:15:12,250 --> 00:15:13,510
.مفهوم

184
00:15:13,920 --> 00:15:15,510
...شيشيو-ساما

185
00:15:15,510 --> 00:15:16,470
.نعم

186
00:15:18,430 --> 00:15:23,650
أريد إخراج الهيتوكيري باتّوساي
المحبوس داخل هيمورا كنشين

187
00:15:23,650 --> 00:15:26,740
.حتّى إن اضطررت لاستعمال القوّة لذلك

188
00:15:27,390 --> 00:15:30,070
شيشيو-سان، هل تستمتع بوقتك؟

189
00:15:30,730 --> 00:15:31,910
.نوعًا ما

190
00:15:32,360 --> 00:15:34,580
.قلتَ أنّه خيّب أملك

191
00:15:34,580 --> 00:15:35,990
.اخرس

192
00:15:35,990 --> 00:15:37,540
.أسرع وقم بما طلبته منك

193
00:15:37,540 --> 00:15:38,420
!حاضر

194
00:15:42,950 --> 00:15:43,830
ماذا؟

195
00:15:44,830 --> 00:15:46,850
.أعتقد أنّي نسيت شيئًا ما

196
00:15:53,380 --> 00:15:56,860
بهذا، يجدر أن تعود قرية شينغتسو
.إلى ما كانت عليه من قبل إن جاز التّعبير

197
00:15:58,170 --> 00:16:00,860
.إنّهم يهتفون فرحًا بطريقة غير مسؤولة

198
00:16:01,260 --> 00:16:03,600
.ثمّة شيء لا يبدو في محلّه هنا

199
00:16:03,850 --> 00:16:06,230
.ستصير الأمور أصعب بعد هذا

200
00:16:06,230 --> 00:16:11,570
إنّ كلّ القبح في قلوب القرويّين
.ظهر للعلن خلال هذه الحادثة

201
00:16:11,570 --> 00:16:14,450
ستكون العلاقات بينهم غير
.مستقرّة لفترة من الوقت

202
00:16:14,450 --> 00:16:18,210
كما أنّي لا أحبّ شخصيّة
.هذا الرّجل كثيرًا أيضًا

203
00:16:19,570 --> 00:16:24,840
.ومع ذلك، تظلّ هذه قريتي
.سأدعو لتصير أحسن

204
00:16:26,540 --> 00:16:30,380
.سأعود الآن

205
00:16:30,380 --> 00:16:31,510
.نعم

206
00:16:31,670 --> 00:16:34,430
ولكن ماذا سنفعل بإيجي لو سمحت؟

207
00:16:34,710 --> 00:16:37,270
.لا يستطيع أيّ أحد منّا أنا أو أنت أخذه

208
00:16:37,670 --> 00:16:40,470
،سأطلب من توكيو الاعتناء به لفترة

209
00:16:40,470 --> 00:16:43,190
.وبمجرّد أن تهدأ الأمور، فسنفكّر في مستقبله

210
00:16:43,190 --> 00:16:44,060
توكيو؟

211
00:16:44,510 --> 00:16:45,520
.زوجتي

212
00:16:47,720 --> 00:16:49,900
ز-ز-زوجتك؟

213
00:16:49,900 --> 00:16:52,440
أنت متزوّج؟

214
00:16:52,440 --> 00:16:53,450
.نعم

215
00:16:53,450 --> 00:16:55,410
"هذه حقيقة تاريخيّة"

216
00:16:55,940 --> 00:16:57,240
.لا داعي للقلق

217
00:16:57,240 --> 00:16:58,750
.توكيو امرأة مذهلة

218
00:16:59,150 --> 00:17:01,370
.ستعتني بإيجي خير عناية

219
00:17:01,650 --> 00:17:05,620
بالطّبع، إن كانت قادرة على تحمّل
.أن تكون زوجة لرجل مثله

220
00:17:05,620 --> 00:17:09,840
نعم. سيكون ذلك مستحيلاً
.ما لم تكن امرأة مثل بوداسف

221
00:17:06,200 --> 00:17:09,840
"تصوّر تخيّليّ لتوكيو"

222
00:17:10,370 --> 00:17:11,920
.لا داعي للقلق علينا

223
00:17:12,410 --> 00:17:14,930
...أسرع بالذّهاب إلى كيوتو

224
00:17:16,540 --> 00:17:18,800
.وصر هيتوكيري مرّة أخرى

225
00:17:20,670 --> 00:17:22,560
أدركتَ ذلك من هذه المعركة، صحيح؟

226
00:17:22,970 --> 00:17:25,900
إنّ طبيعتك كروروني لن تكون لها
،أيّ فرصة ضدّ أتباع شيشيو

227
00:17:25,900 --> 00:17:28,190
.ناهيك عن شيشيو بحدّ ذاته

228
00:17:28,600 --> 00:17:30,660
.من الجيّد أنّ ذلك السّاكاباتو قد كُسر

229
00:17:31,680 --> 00:17:34,160
.كفاك تردّدًا واتّخذ قرارك

230
00:17:35,520 --> 00:17:38,540
.أنا أعمد عليك، على طبيعتك السّابقة

231
00:17:56,250 --> 00:17:57,430
.هيمورا

232
00:18:00,550 --> 00:18:02,020
.سايتو-سينسي

233
00:18:02,670 --> 00:18:04,270
."لا تنادني بـ"سينسي

234
00:18:04,970 --> 00:18:08,530
.ثمّة مكان عليّ المرور به قبل مغادرة القرية

235
00:18:15,690 --> 00:18:18,740
.حسنًا، أنا لا أفهم تمامًا ما حدث

236
00:18:18,940 --> 00:18:21,450
.لكنّهم هربوا، ونحن فزنا

237
00:18:21,450 --> 00:18:24,870
،بإمكاننا تجاهل ما كان يتحدّث عنه
.لأنّ سايتو لم يفعل أيّ شيء

238
00:18:24,870 --> 00:18:27,920
لنكن متفائلين قليلاً ونبذل كلّ
!ما لدينا! كلّ ما لدينا

239
00:18:27,920 --> 00:18:31,540
هيمورا، تكون هادئًا ووسيمًا عندما
.تصير عيناك مائلتين للأعلى هكذا

240
00:18:27,920 --> 00:18:42,050
:تقنيّة سرّيّة
!نسخ المائة وجه

241
00:18:31,540 --> 00:18:33,880
.لكنّك مخيف ومن الصّعب التّقرّب منك

242
00:18:33,880 --> 00:18:35,340
.إضافة إلى أنّك كئيب

243
00:18:35,340 --> 00:18:39,010
أفضّر أكثر هيمورا الأخرق
!"الّذي يقول "أورو

244
00:18:39,010 --> 00:18:42,050
!نعم، أفضّل ذلك أكثر بكثير، نعم

245
00:18:42,050 --> 00:18:46,270
لا أهتمّ أبدًا إن كنتُ أروق لك
.أم لا يا ميساو-دونو

246
00:18:46,270 --> 00:18:47,480
ماذا؟ فعلاً؟

247
00:18:47,480 --> 00:18:48,440
كما توقّعت؟

248
00:18:48,440 --> 00:18:51,410
!مهلاً، كان ذلك فظًّا للغاية

249
00:18:58,020 --> 00:19:00,740
.أخذ ذلك الكثير من الوقت

250
00:19:00,740 --> 00:19:02,280
.لنسرع

251
00:19:02,280 --> 00:19:05,410
على الأرجح أنّ جماعة شيشيو
،لن تهاجمنا ثانية حتّى نصل إلى كيوتو

252
00:19:05,410 --> 00:19:07,250
.لذلك سنسلك طريق توكايدو لو سمحت

253
00:19:07,570 --> 00:19:10,260
.كما أنّي جائع أيضًا

254
00:19:11,030 --> 00:19:13,960
.كان يعبث معي

255
00:19:14,700 --> 00:19:16,550
!ركلة غضب الوحش الطّائر

256
00:19:16,550 --> 00:19:17,880
...أورو

257
00:19:18,460 --> 00:19:19,730
.هذا مؤلم

258
00:19:20,250 --> 00:19:21,260
!خذ

259
00:19:21,260 --> 00:19:22,140
أورو؟

260
00:19:24,000 --> 00:19:26,810
إنّه بسكويت قاسٍ! قلت أنّك جائع، صحيح؟

261
00:19:28,550 --> 00:19:30,570
.سآخذ واحدًا إذًا

262
00:19:32,020 --> 00:19:33,770
—ليس ممزوجًا بأيّ سمّ أو

263
00:19:33,770 --> 00:19:36,020
!أنت مزعج! اخرس وكله فحسب

264
00:19:39,650 --> 00:19:40,580
.نعم

265
00:19:41,060 --> 00:19:42,360
.إنّه لذيذ بالفعل

266
00:19:42,360 --> 00:19:43,780
أليس كذلك؟

267
00:19:43,780 --> 00:19:46,620
!حتّى أوشي-ساما وهانيا-كُن أثنيا عليّ

268
00:19:46,620 --> 00:19:49,460
أسنعود إلى ذلك ثانية؟

269
00:19:49,460 --> 00:19:53,760
بالطّبع! سأستخرج كلّ التّفاصيل
!منك قبل وصولنا إلى كيوتو

270
00:19:56,410 --> 00:19:59,680
.في الوقت الحاليّ، لنسرع في طريقنا إلى كيوتو

271
00:20:00,830 --> 00:20:04,850
هل سأصير هيتوكيري ثانية...؟

272
00:20:05,420 --> 00:20:07,610
.سأعرف الإجابة في كيوتو

273
00:20:10,630 --> 00:20:11,650
.هيّا بنا

274
00:20:22,990 --> 00:20:26,990
:الحلقة التّاسعة والعشرون"
"إلى كيوتو مرّة أخرى

275
00:21:57,000 --> 00:21:59,790
مطعم أكابيكو للحم بقر"
"في القدر السّاخن والسّاكي

276
00:21:59,030 --> 00:22:01,180
!شكرًا جزيلاً

277
00:22:05,290 --> 00:22:08,180
ما-ما الخطب يا تاي-سان؟

278
00:22:09,210 --> 00:22:13,770
.لقد دفع كلّ الزّبائن فواتيرهم

279
00:22:13,770 --> 00:22:14,720
.هكذا إذًا

280
00:22:14,880 --> 00:22:18,150
.ولسبب ما، أشعر وكأنّنا نفتقر لشيء ما

281
00:22:18,150 --> 00:22:19,310
ماذا؟

282
00:22:19,310 --> 00:22:21,940
تتحدّين عن سانوسكي-سان، صحيح؟

283
00:22:22,520 --> 00:22:26,750
هل هو بخير في رحلته إلى كيوتو؟

284
00:22:34,200 --> 00:22:35,840
.هذا سيّئ

285
00:22:36,450 --> 00:22:40,050
.أظنّني ضعت بالفعل

286
00:22:41,580 --> 00:22:43,510
في أيّ اتّجاه تقع كيوتو؟

287
00:22:45,000 --> 00:22:49,970
"الحلقة القادمة: لقاء في الغابة"

288
00:22:46,670 --> 00:22:49,310
."الحلقة القادمة: "لقاء في الغابة