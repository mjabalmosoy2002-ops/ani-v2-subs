1
00:00:07,190 --> 00:00:11,400
!تحرّكوا بسرعة كي لا نعترض طريق فوجي

2
00:00:11,400 --> 00:00:12,860
!أخرجوا سيوفكم! استعداد

3
00:00:12,860 --> 00:00:16,120
!جاهز –
!جاهز –

4
00:00:19,950 --> 00:00:21,040
سيف؟

5
00:00:21,040 --> 00:00:22,330
.هذا لا يُعقل

6
00:00:22,330 --> 00:00:24,710
من قد يستطيع استعمال شيء كهذا؟

7
00:00:32,880 --> 00:00:33,800
ماذا؟

8
00:00:34,300 --> 00:00:36,180
لم يكن للشّوريكن أيّ تأثير؟

9
00:00:36,180 --> 00:00:37,850
!يا له من جسد لا يُصدّق

10
00:00:49,440 --> 00:00:51,320
ماذا؟ ما هذا؟

11
00:00:52,110 --> 00:00:53,780
إ-إيوانبو-ساما؟

12
00:00:53,780 --> 00:00:55,450
ما الّذي تفعله؟

13
00:00:55,450 --> 00:00:56,990
هل من خطب ما؟

14
00:01:02,830 --> 00:01:04,500
ما هؤلاء الأشخاص؟

15
00:01:04,500 --> 00:01:07,420
.لا أدري، لكن لم يتبقّ لدينا وقت

16
00:01:08,460 --> 00:01:11,050
.علينا العودة وتبليغ ميساو-تشان

17
00:01:11,050 --> 00:01:12,960
!أعني تبليغ القائدة

18
00:03:22,010 --> 00:03:26,140
تاكاني-سينسي، لأيّ غرض تلك البطاقات؟

19
00:03:26,720 --> 00:03:28,270
.لتصنيف المرضى

20
00:03:29,480 --> 00:03:31,890
سنصنّف المرضى من الّذين
يتمّ إحضارهم إلى هنا

21
00:03:31,890 --> 00:03:33,730
.حسب مدى حاجتهم للعناية الطّبّيّة

22
00:03:34,560 --> 00:03:38,730
سيُمنح المرضى الّذين يحتاجون للعلاج
.الفوريّ بطاقات خشبيّة حمراء

23
00:03:39,240 --> 00:03:42,280
وسيُمنح المرضى الّذي يمكن علاجهم
.لاحقًا بطاقات خشبيّة صفراء

24
00:03:42,280 --> 00:03:46,870
وسيُمنح المرضى ذوي الأعراض
.المستقرّة بطاقات خشبيّة خضراء

25
00:03:46,870 --> 00:03:48,450
.وسنعالجهم حسب ذلك التّسلسل

26
00:03:49,120 --> 00:03:50,410
ما الغرض من البطاقات السّوداء؟

27
00:03:51,750 --> 00:03:52,790
.إنّها للموتى

28
00:03:54,630 --> 00:03:57,710
هل سنستقبل الكثير من الضّحايا اللّيلة؟

29
00:03:58,210 --> 00:04:00,800
سيكون من الرّائع لو كان
.كلّ هذا العمل هباءً

30
00:04:17,610 --> 00:04:19,070
.تمالك نفسك

31
00:04:20,030 --> 00:04:22,780
...أ-أخبرني يا غويتشي

32
00:04:22,780 --> 00:04:23,860
أتريد الهروب؟

33
00:04:23,860 --> 00:04:25,360
!لا تتفوّه بالهراء

34
00:04:25,870 --> 00:04:27,160
...أعني

35
00:04:27,950 --> 00:04:30,120
!البقاء للأقوى

36
00:04:30,580 --> 00:04:33,290
!إن هربنا هنا، فسنكون فرائس للأبد

37
00:04:33,290 --> 00:04:34,670
!سيتمّ التهامنا بالكامل

38
00:04:44,510 --> 00:04:47,470
"مطعم أوُيْيا"

39
00:04:58,650 --> 00:04:59,480
.كاورو

40
00:05:02,230 --> 00:05:04,650
،قالوا أنّ الوقت وشيك
.لذلك علينا أن نجتمع جميعًا

41
00:05:06,320 --> 00:05:07,280
.مفهوم

42
00:05:10,700 --> 00:05:11,540
...في الغد

43
00:05:13,080 --> 00:05:16,120
.عندما يحين الغد، سيكون كنشين قد عاد

44
00:05:17,580 --> 00:05:18,830
...لذلك سأفعل

45
00:05:20,210 --> 00:05:21,920
.ما أنا قادرة على فعله

46
00:05:24,050 --> 00:05:25,800
بعد كلّ هذا؟

47
00:05:25,800 --> 00:05:28,800
ياهيكو، ألم تكن قلقًا على كنشين؟

48
00:05:29,140 --> 00:05:30,300
.بالطّبع لا

49
00:05:30,800 --> 00:05:34,680
،لا يهمّ ما مدى قوّة الخصم
.فسانوسكي موجود أيضًا

50
00:05:34,680 --> 00:05:38,060
وسايتو معهما أيضًا رغم أنّي
.لا أريد الاعتماد عليه كثيرًا

51
00:05:38,060 --> 00:05:41,480
وقبل كلّ شيء، كنشين
!هو أفضل سيّاف في اليابان

52
00:05:43,400 --> 00:05:44,440
.معك حقّ

53
00:06:13,390 --> 00:06:14,520
.حان الوقت

54
00:06:15,680 --> 00:06:18,310
أيّها الرّئيس، ماذا نفعل؟

55
00:06:18,520 --> 00:06:19,980
.ابقوا متأهّبين

56
00:06:20,480 --> 00:06:23,650
إن حصلتم على أيّ معلومات
،عن أيّ حرائق أو أعمال شغب

57
00:06:23,650 --> 00:06:25,280
.فسنتعامل معها في الحال

58
00:06:27,780 --> 00:06:29,240
.حان الوقت. هيّا

59
00:06:31,200 --> 00:06:33,200
.حسنًا، التّالي... انطلق

60
00:06:33,910 --> 00:06:35,040
...غويتشي

61
00:06:35,040 --> 00:06:37,450
.لا تتكلّم أكثر. بدأ الأمر سلفًا

62
00:06:39,210 --> 00:06:40,210
ما الخطب؟

63
00:06:40,420 --> 00:06:42,080
لماذا عدت؟

64
00:06:42,080 --> 00:06:43,090
!الشّرطة

65
00:06:43,630 --> 00:06:44,880
!إنّهم في كلّ مكان

66
00:06:47,630 --> 00:06:48,760
!ذهبوا من هناك

67
00:06:49,260 --> 00:06:50,890
!انتظر يا هذا

68
00:06:51,550 --> 00:06:53,510
!كانت هنالك صافرات من أماكن أخرى أيضًا

69
00:06:53,890 --> 00:06:56,600
!ثمّة عدد أكثر ممّا كنّا نتوقّعه

70
00:06:56,600 --> 00:06:58,480
.سُحقًا! لا خيار لدينا

71
00:06:58,980 --> 00:07:00,480
!تأهّبوا جميعًا

72
00:07:00,480 --> 00:07:03,690
سأبعث رسولاً وأطلب إرشادات
.من كاماتاري-ساما

73
00:07:03,980 --> 00:07:05,650
.استقبلنا رسلاً من كلّ حيّ

74
00:07:05,650 --> 00:07:09,360
ابتداءً من السّاعة 23:59، اعتقلنا
.العديد من الأفراد المشبوهين

75
00:07:09,860 --> 00:07:11,660
.لم يتمّ إضرام أيّ حرائق

76
00:07:11,990 --> 00:07:13,120
.هذا كلّ شيء

77
00:07:13,120 --> 00:07:14,030
.هكذا إذًا

78
00:07:14,740 --> 00:07:16,330
كم عددُ من اعتُقلوا؟

79
00:07:16,330 --> 00:07:18,370
.أقلّ من 20 بقليل حتّى الآن

80
00:07:19,410 --> 00:07:21,420
.ما زلنا نملك القدرة على تولّي أمر المزيد

81
00:07:21,920 --> 00:07:22,750
.حسنًا

82
00:07:22,920 --> 00:07:26,050
عيِّنوا رجالاً من الفرقة الرّئيسيّة
.لنقل الأفراد المشبوه بهم

83
00:07:26,050 --> 00:07:28,460
ستستمرّ فرق الأمن بفعل
.ما كانوا يفعلونه حتّى الآن

84
00:07:28,460 --> 00:07:29,630
.مفهوم

85
00:07:36,100 --> 00:07:37,100
.تأخّروا

86
00:07:37,560 --> 00:07:39,430
أين ألسنة اللّهب؟

87
00:07:39,430 --> 00:07:41,060
!لا تعرف الصّبر أبدًا

88
00:07:41,390 --> 00:07:44,270
.لن تنتشر الحرائق بتلك السّهولة

89
00:07:44,270 --> 00:07:45,310
!لديّ تقرير

90
00:07:46,480 --> 00:07:48,860
ينتشر رجال الشّرطة في كلّ
.مكان من مدينة كيوتو

91
00:07:49,070 --> 00:07:51,650
.لا تستطيع الفرقة الأولى تنفيذ العمليّة

92
00:07:51,650 --> 00:07:53,070
!وكذلك الفرقة الثّانية

93
00:07:53,070 --> 00:07:56,780
والفرقة الثّالثة أيضًا تجد
!صعوبة في تنفيذ العمليّة

94
00:07:56,780 --> 00:07:59,790
.يا إلهي. جميعهم أطفال مشاكسون بلا فائدة

95
00:08:00,290 --> 00:08:03,960
.لا خيار أمامنا. لنغيّر الخطّة الآن

96
00:08:03,960 --> 00:08:08,920
.سنقوم بخلق إلهاء لتسهيل قيامكم بعملكم

97
00:08:08,960 --> 00:08:11,380
أوسوي-دونو، المهمّة الموكلة
لنا نحن السّيوف العشرة

98
00:08:11,380 --> 00:08:14,010
.هي اغتيال الشّخصيّات المحوريّة المهمّة

99
00:08:14,550 --> 00:08:19,390
مهمّتنا لا تنصّ على قتل رجالِ
.الشّرطة متدنّي المستوى والمدنيّين

100
00:08:20,640 --> 00:08:23,480
،بمجرّد انتشار الحريق
.فسيصير الأمران نفس الشّيء

101
00:08:23,890 --> 00:08:27,480
لن يكون هنالك أيّ تغيير
.إن ماتوا جميعًا في النّهاية

102
00:08:27,480 --> 00:08:30,070
.لن أضغط كثيرًا

103
00:08:30,070 --> 00:08:30,940
...ولكن

104
00:08:31,860 --> 00:08:33,610
.لا تعترضوا طريقي

105
00:08:35,160 --> 00:08:38,330
.في تلك الحالة، سنستأذن أنا وفوجي

106
00:08:39,030 --> 00:08:41,120
—حسنًا. وأنا

107
00:08:41,120 --> 00:08:43,750
.ابق هنا أيّها الغبيّ. ستعترض الطّريق فحسب

108
00:08:48,250 --> 00:08:50,960
كاماتاري-ساما، ماذا علينا أن نفعل؟

109
00:08:52,460 --> 00:08:53,880
.دعوني أفكّر

110
00:09:00,060 --> 00:09:03,310
.أيّها الرّئيس، اختفى الأفراد المشبوهين

111
00:09:03,640 --> 00:09:05,690
ربّما استسلموا؟

112
00:09:08,440 --> 00:09:12,820
ماذا إن أرسلنا الوحدة المركزيّة
كدعم لإيجاد المتخلّفين عن الرّكب؟

113
00:09:12,820 --> 00:09:14,990
.أظنّ أنّ ذلك سيكون أكثر كفاءة

114
00:09:15,490 --> 00:09:16,860
.صحيح

115
00:09:18,780 --> 00:09:20,240
ماذا؟ ما هذا؟

116
00:09:20,240 --> 00:09:21,370
ما هذا الصّوت؟

117
00:09:21,370 --> 00:09:22,950
!مهلاً! انظروا هناك

118
00:09:45,770 --> 00:09:46,690
!استعدّوا للاعتراض

119
00:09:47,190 --> 00:09:49,900
إلى فرقة الأسلحة النّاريّة، اصطفّوا
!في ثلاثة صفوف! تقدّموا للأمام

120
00:09:53,980 --> 00:09:55,030
.استعدّوا

121
00:09:57,820 --> 00:09:58,950
.صوّبوا

122
00:10:00,410 --> 00:10:02,030
!أطلقوا

123
00:10:08,210 --> 00:10:12,340
من أجل كرامة الشّرطة، يجب
!علينا أن نوقف هذه الانتهاكات

124
00:10:12,460 --> 00:10:14,300
!يا فرقة السّيّافين، إلى الأمام

125
00:10:15,090 --> 00:10:16,590
!تقدّموا

126
00:10:16,720 --> 00:10:18,550
!هجوم

127
00:10:20,430 --> 00:10:21,300
.هـ-هذا سيّئ

128
00:10:21,300 --> 00:10:22,470
!إنّهم يفوقوننا عددًا

129
00:10:22,470 --> 00:10:23,720
!اهربوا

130
00:10:24,010 --> 00:10:25,600
!اللّعنة عليكم

131
00:10:25,600 --> 00:10:26,430
.لا بأس

132
00:10:27,310 --> 00:10:29,730
.يستطيع كلّ من يريد الهرب أن يهرب

133
00:10:31,520 --> 00:10:33,360
...لكن

134
00:10:34,190 --> 00:10:38,610
فقط إن كنتم قادرين على تجاوز
حاصود إله الموت هذا، مفهوم؟

135
00:10:39,450 --> 00:10:40,610
ما-ماذا؟

136
00:10:40,610 --> 00:10:41,870
صراع داخليّ؟

137
00:10:47,200 --> 00:10:49,830
ما الفائدة من قطع لعب تخشى الموت؟

138
00:10:50,620 --> 00:10:54,040
.وخاصّة إن كانت مجرّد بيادق مثلكم

139
00:10:54,500 --> 00:10:56,710
.الخيار الوحيد للبيادق هو التّقدّم للأمام

140
00:10:57,510 --> 00:10:58,420
.انطلقوا

141
00:10:58,970 --> 00:11:00,340
!إلى الأمام

142
00:11:00,550 --> 00:11:02,300
!استعجلوا

143
00:11:02,300 --> 00:11:03,550
!اثبتوا

144
00:11:03,680 --> 00:11:05,510
!دافعوا بكلّ ما لديكم

145
00:11:14,940 --> 00:11:17,440
.حسنًا. ستفي هذه المنطقة بالغرض

146
00:11:17,690 --> 00:11:21,570
هذه هي فرصتنا بينما الفرقة
.الرّئيسيّة والشّرطة يتواجهون معًا

147
00:11:21,570 --> 00:11:22,410
.نعم

148
00:11:29,250 --> 00:11:30,790
.حسنًا، لنقم بهذا

149
00:11:40,420 --> 00:11:42,890
!اسمعوا! وجدتُ مفتعلي حرائق

150
00:11:42,890 --> 00:11:43,800
أين؟ أين؟

151
00:11:44,090 --> 00:11:45,760
!وجدتهم! هنا

152
00:11:45,890 --> 00:11:47,140
!نالوا منهم

153
00:11:47,140 --> 00:11:48,310
!مـ-مهلاً لحظة

154
00:11:48,310 --> 00:11:50,770
لماذا ثمّة الكثير من النّاس
مستيقظين في مثل هذا الوقت؟

155
00:11:54,400 --> 00:11:55,270
.حسنًا

156
00:11:55,810 --> 00:11:56,980
!الوضع هنا جيّد حاليًّا

157
00:11:57,650 --> 00:11:59,190
—يا ميساو-تشان

158
00:11:59,190 --> 00:12:01,400
!أقصد، أيّتها القائدة الجديدة

159
00:12:01,400 --> 00:12:02,740
!ألقينا القبض عليهم هنا

160
00:12:03,160 --> 00:12:04,700
!شكرًا جزيلاً لكم

161
00:12:04,700 --> 00:12:06,660
!لكنّ هذه هي البداية فقط

162
00:12:06,910 --> 00:12:09,040
!كونوا حذرين وأنتم تقومون بالدّوريّات

163
00:12:09,040 --> 00:12:10,830
!أجل! دعي الأمر لنا

164
00:12:10,830 --> 00:12:13,370
،والآن يا أوتشيكا-سان وأوماسو-سان

165
00:12:13,370 --> 00:12:15,920
سأستمع إلى تقاريركما
،عمّا حدث قبل قليل لاحقًا

166
00:12:17,500 --> 00:12:19,800
علينا مواصلة منع إضرام الحرائق
!وحماية الجميع

167
00:12:19,800 --> 00:12:20,710
—حاضرة يا ميساو-تشان

168
00:12:21,300 --> 00:12:23,930
.أقصد، كوني حذرة أيضًا أيّتها القائدة

169
00:12:27,010 --> 00:12:28,470
!حظًّا سعيدًا

170
00:12:28,680 --> 00:12:29,810
!أجل

171
00:12:30,310 --> 00:12:33,690
لسبب ما، شعبيّة جماعة
.أونيوابانشو كيوتو كبيرة

172
00:12:34,190 --> 00:12:35,190
.نعم

173
00:12:35,520 --> 00:12:37,770
.لا أصدّق أنّهم ما زالوا جواسيس

174
00:12:38,270 --> 00:12:42,030
لكنّ هذه هي طريقة الحياة الّتي
...اختارها أوكينا-سان والبقيّة

175
00:12:42,030 --> 00:12:42,950
!أجل

176
00:12:42,950 --> 00:12:45,030
.ونتيجة سنواتهم العشر

177
00:12:45,530 --> 00:12:48,990
نعم. قوّة جماعة الأونيوابانشو
،الّتي لا تتزعزع الحقيقيّة

178
00:12:49,540 --> 00:12:52,660
...حتّى في مواجهة مدفع غاتالينغ

179
00:12:53,960 --> 00:12:57,790
لا تزال موجودة هنا بالفعل
!وإن اختلف شكلها

180
00:12:58,790 --> 00:13:01,550
!حسنًا! انتشروا جميعًا

181
00:13:01,550 --> 00:13:04,050
!أجل –
!أجل –

182
00:13:04,050 --> 00:13:05,430
!كاورو-سان! ياهيكو-كُن

183
00:13:05,590 --> 00:13:07,390
!إلى المكان التّالي! التّالي

184
00:13:07,390 --> 00:13:08,680
!نعم –
!أجل –

185
00:13:16,190 --> 00:13:17,400
.تأخّروا

186
00:13:18,480 --> 00:13:22,230
يجدر أن تكون هنالك ألسنة لهب
.يمكن رؤيتها من اتّجاه كيوتو الآن

187
00:13:22,740 --> 00:13:24,860
لماذا يتحرّكون ببطء هكذا؟

188
00:13:25,530 --> 00:13:28,120
.إنّهم يواجهون ألف رجل شرطة الآن

189
00:13:28,820 --> 00:13:31,330
.ليس من المفاجئ لهم أن يواجهوا وقتًا صعبًا

190
00:13:31,540 --> 00:13:33,450
.ولكن مع ذلك، أخذ الأمر وقتًا طويلاً

191
00:13:33,450 --> 00:13:35,870
.لا حاجة فعليّة للعجلة

192
00:13:35,870 --> 00:13:39,290
.فلا أظنّ أنّ هنالك من سيأتي لمطاردتنا هنا

193
00:13:39,290 --> 00:13:42,760
...أيعقل يا شيشيو-ساما

194
00:13:42,760 --> 00:13:45,340
أن تكون عاطفيًّا بعض الشّيء الآن؟

195
00:13:45,670 --> 00:13:47,300
رغم رؤية أرض مليئة بذكريات الماضي

196
00:13:47,300 --> 00:13:52,260
تحترق بالكامل هو لأجل مهمّتنا
.إلاّ أنّك تشعر ببعض النّدم في النّهاية

197
00:13:53,020 --> 00:13:56,640
لذلك أردتَ على الأقلّ
.أن ترى كيف ستنتهي

198
00:13:57,140 --> 00:13:59,440
.يومي، لقد شربتِ الكثير

199
00:14:00,360 --> 00:14:03,440
ما السّبب الّذي قد يجعلني عاطفيًّا؟

200
00:14:03,940 --> 00:14:06,950
.إنّنا نبحر من أجل مجدي

201
00:14:07,400 --> 00:14:09,910
حريق كيوتو الكبير الّذي أنتظره

202
00:14:10,120 --> 00:14:14,040
هي ألعاب ناريّة احتفاليّة
.لشروعنا في حرب وإعلانها

203
00:14:14,540 --> 00:14:16,000
...ومع ذلك

204
00:14:20,130 --> 00:14:23,210
إنّ حقيقة تركي لمنافستي مع ذلك
الرّجل بدون نتيجة محسومة

205
00:14:23,210 --> 00:14:26,340
.هو أمر أندم عليه بالفعل

206
00:14:30,970 --> 00:14:31,890
!هوجي-ساما

207
00:14:32,510 --> 00:14:33,930
هل بدأت تظهر ألسنة اللّهب؟

208
00:14:33,930 --> 00:14:34,930
!كـ-كلاّ

209
00:14:35,270 --> 00:14:36,390
!ثمّة عربة

210
00:14:36,600 --> 00:14:40,810
!عربة في طريقها إلينا بسرعة كبيرة

211
00:14:41,020 --> 00:14:43,980
في أيّ واحدة يا كنشين؟
أيّها هي سفينة شيشيو؟

212
00:14:44,150 --> 00:14:46,190
!تلك! السّفينة الخشبيّة تلك

213
00:14:46,400 --> 00:14:49,150
إنّها الوحيدة الّتي تطلق بخارًا
!وتستعد للانطلاق

214
00:14:49,410 --> 00:14:50,610
.حسنًا، توقّف

215
00:15:01,040 --> 00:15:01,880
!مستحيل

216
00:15:04,590 --> 00:15:08,170
أنا وهو هيتوكيري نتشابه
.في الكثير من النّواحي

217
00:15:08,170 --> 00:15:10,430
.لا بدّ أنّه قرأ أفكاري

218
00:15:13,600 --> 00:15:16,560
...أتيت لتودّعني وأنا مغادر في رحلتي إذًا

219
00:15:19,310 --> 00:15:21,230
!يا هيمورا الباتّوساي

220
00:15:23,480 --> 00:15:28,190
في كلّ الأحوال، سأقوم بتهنئته
.على اكتشاف هذا الأمر

221
00:15:28,940 --> 00:15:30,650
...هيمورا الباتّوساي

222
00:15:31,160 --> 00:15:33,410
...وسايتو هاجيمي أيضًا

223
00:15:34,450 --> 00:15:35,450
ماذا؟

224
00:15:36,370 --> 00:15:38,790
.ثمّة رجل مجهول معهما

225
00:15:38,790 --> 00:15:39,660
ماذا؟

226
00:15:41,500 --> 00:15:45,130
.صحيح، أظنّ أنّه صديق هيمورا-سان

227
00:15:45,290 --> 00:15:47,590
...إن أسعفتني الذّاكرة

228
00:15:47,590 --> 00:15:49,510
.ساغارا سانوسكي

229
00:15:49,510 --> 00:15:52,590
.يبدو أنّه مقاتل مأجور معروف في طوكيو

230
00:15:53,140 --> 00:15:56,680
،ولكن مقارنة بالآخريْن
.مهاراته القتاليّة أقلّ بكثير

231
00:15:57,180 --> 00:15:58,560
فعلاً؟

232
00:15:58,850 --> 00:16:01,020
.إنّه نكرة إذًا

233
00:16:02,980 --> 00:16:07,020
لا بدّ أنّ العدوّ متفاجئ
.من رؤيتنا جميعًا هنا

234
00:16:07,020 --> 00:16:08,150
.مغفّل

235
00:16:08,360 --> 00:16:12,240
.لكن لا يزال الوقت باكرًا على التّفاجؤ

236
00:16:13,820 --> 00:16:16,700
والآن، ماذا نفعل يا شيشيو-سان؟

237
00:16:17,120 --> 00:16:20,660
هل نسوّ الحساب الّذي بدأ
في قرية شينغتسو هنا؟

238
00:16:20,910 --> 00:16:25,500
كم أودّ ذلك، لكن لا يمكنني
.إضاعة الوقت هنا

239
00:16:26,130 --> 00:16:29,880
،ومع ذلك، إن انطلقنا الآن
،سيبدو الأمر وكأنّنا نهرب منه

240
00:16:29,880 --> 00:16:31,170
.وذلك مزعج

241
00:16:31,670 --> 00:16:34,130
.هوجي، دع الجميع يصعدون على متن السّفينة

242
00:16:34,130 --> 00:16:34,970
ماذا؟

243
00:16:34,970 --> 00:16:37,390
.واستعدّوا للتّخلّص من الطّبقة الخارجيّة

244
00:16:38,260 --> 00:16:41,560
سنريهم فارقًا كبيرًا في القوّة

245
00:16:41,560 --> 00:16:45,350
.وسنجعله يتذوّق عجزه قبل أن نودّعه

246
00:16:46,900 --> 00:16:49,730
والآن، ماذا نفعل؟

247
00:16:50,070 --> 00:16:53,450
قبل كلّ شيء، علينا الغطس تحت
.الماء والتّسلّل إليهم إن أمكن

248
00:16:53,950 --> 00:16:56,240
—ثمّ سنتّجه لقاع السّفينة –
.مهلاً لحظة –

249
00:16:57,030 --> 00:17:00,790
،إن كنت تريد إحداث ثقب فيها
.فلديّ شيء أفضل بكثير من السّيف

250
00:17:01,450 --> 00:17:05,460
.أعطاني كاتسو هذه المتفجّرات كهديّة وداع

251
00:17:05,960 --> 00:17:08,460
!إنّها من النّوع الأحدث الّذي لا يحتاج لإشعال

252
00:17:08,710 --> 00:17:09,550
—إن استعملنا هذه

253
00:17:09,550 --> 00:17:10,420
.مغفّل

254
00:17:11,880 --> 00:17:16,680
،اسمع يا هذا، في كلّ مرّة
—أيّ جزء لا تفـ

255
00:17:16,680 --> 00:17:18,850
.إن كنت لا تفهم، فأنت مغفّل حقيقيّ

256
00:17:18,850 --> 00:17:20,560
ماذا؟ –
...اهدأ يا سانو –

257
00:17:21,060 --> 00:17:24,810
،حتّى إن كانت لا تحتاج لإشعال
،إن غصت في البحر وهي معك

258
00:17:24,810 --> 00:17:27,150
.من الطّبيعيّ أنّ يتبلّل البارود الّذي بداخلها

259
00:17:27,480 --> 00:17:31,360
،إن حدث ذلك، فستفشل في الانفجار
.مهما كانت جودتها عالية

260
00:17:32,570 --> 00:17:33,820
.أتمنّى أن تكون قد فهمت

261
00:17:34,030 --> 00:17:39,030
ليس لديك سيف، لذلك الزم مكانك
.هنا حتّى تصل شرطة أوساكا

262
00:17:46,040 --> 00:17:47,040
ما هذا؟

263
00:17:47,170 --> 00:17:49,000
دمّرت سفينة شيشيو نفسها؟

264
00:17:49,590 --> 00:17:51,210
هل خرج المدفع عن السّيطرة؟

265
00:17:52,300 --> 00:17:53,420
.لا

266
00:18:14,780 --> 00:18:17,150
.يبدو أنّكم تفاجأتم

267
00:18:17,780 --> 00:18:21,870
مع أنّي أنفقت ثلاثة أخماس مدّخرات حياتي

268
00:18:21,870 --> 00:18:24,790
،في سفينة رنغوكو المدرّعة هذه

269
00:18:25,450 --> 00:18:28,870
أحتاج منك لأن تكون متفاجئًا أكثر
.حتّى يكون الأمر يستحقّ ذلك

270
00:18:29,500 --> 00:18:32,210
.هوجي، لقّم مدفع آرمسترونغ

271
00:18:32,670 --> 00:18:37,130
دعهم يستمتعون بالألعاب
.النّاريّة احتفالاً بمغادرتي أيضًا

272
00:18:37,130 --> 00:18:38,180
.عُلم

273
00:18:39,840 --> 00:18:41,300
سفينة مدرّعة؟

274
00:18:42,100 --> 00:18:44,970
إن استطاع شخص الحصول
،على شيء كهذا

275
00:18:45,270 --> 00:18:48,230
فإنّ حكومة ميجي لن تدوم
.طويلاً في كلّ الأحوال

276
00:18:48,770 --> 00:18:51,900
أيّها الباتّوساي، بإمكانك قطع الفولاذ، صحيح؟

277
00:18:52,400 --> 00:18:55,150
.نعم، ما دام ليس تحت الماء

278
00:18:56,190 --> 00:18:58,150
.يبدو أنّ هنالك تغيّرًا في الخطّة

279
00:18:58,780 --> 00:19:02,160
.سانو، سنجذب أنا وسايتو نيران المدفع لنا

280
00:19:03,030 --> 00:19:05,790
استغلّ تلك الفرصة واعثر على قارب صغير

281
00:19:05,790 --> 00:19:08,580
وتسلّل إلى السّفينة المدرّعة
.وهاجمها بالمتفجّرات

282
00:19:08,580 --> 00:19:09,420
ماذا؟

283
00:19:09,420 --> 00:19:11,880
استهدف غرفة المحرّك. مفهوم؟ –
—مهلاً! انتظر يا كنشين –

284
00:19:11,880 --> 00:19:12,840
!نار

285
00:19:13,420 --> 00:19:14,250
!هيّا بنا –
!مهلاً –

286
00:19:23,140 --> 00:19:24,220
!كنشين

287
00:19:24,510 --> 00:19:28,480
،إن تسلّلتُ وبحثتُ عن قارب
.فسيأخذ ذلك الكثير من الوقت

288
00:19:29,020 --> 00:19:31,940
أيمكنك مواصلة تفادي نيران
المدفع حتّى ذلك الحين؟

289
00:19:32,190 --> 00:19:33,360
!سُحقًا

290
00:19:38,360 --> 00:19:39,700
!أصابت الطّلقة الأولى الهدف

291
00:19:40,150 --> 00:19:41,950
أنلقّم الطّلقة الثّانية؟

292
00:19:42,450 --> 00:19:45,280
.لا. هذا يكفي بالنّسبة لمدفع آرمسترونغ

293
00:19:45,620 --> 00:19:48,250
جهّز مدفع غاتالينغ بدلاً منه
.وفي أسرع وقت

294
00:19:48,500 --> 00:19:49,460
ماذا؟

295
00:19:54,420 --> 00:19:55,250
ماذا؟

296
00:19:58,550 --> 00:20:01,430
...أرحّب بالهجوم الانتحاريّ اليائس

297
00:20:02,220 --> 00:20:05,100
.أو ذلك ما أودّ قوله، لكن لا تزال ساذجًا

298
00:20:06,180 --> 00:20:09,730
.قرأت أفكاري وتوقّعت كلّ خططي

299
00:20:10,270 --> 00:20:12,600
.ولكن يمكن للعكس أن يحدث أيضًا

300
00:20:13,150 --> 00:20:17,650
من الطّبيعيّ لي أيضًا أن أكون
.قد قرأت أفكارك وتوقّعتُ حركاتك

301
00:20:20,400 --> 00:20:21,280
!سانو

302
00:20:21,490 --> 00:20:25,700
!أعلم سلفًا أنّكما كنتما مجرّد إلهاء

303
00:20:25,830 --> 00:20:28,370
!مدفع الغاتالينغ، إطلاق

304
00:20:39,460 --> 00:20:40,300
—كان ذلك

305
00:20:40,460 --> 00:20:42,550
!أسلوب إتقان الطّبقتين الخاصّ بأنجي

306
00:20:42,880 --> 00:20:44,180
...ذلك الوغد

307
00:20:44,760 --> 00:20:46,600
.ليس مجرّد نكرة

308
00:20:49,390 --> 00:20:50,310
سانو؟

309
00:20:53,230 --> 00:20:54,190
.رمح— لا

310
00:20:54,190 --> 00:20:55,020
!غمد

311
00:20:57,610 --> 00:20:58,610
!مذهل

312
00:21:01,240 --> 00:21:02,650
...التقينا أخيرًا

313
00:21:03,360 --> 00:21:04,360
.أيّها الباتّوساي

314
00:21:09,660 --> 00:21:11,040
...شينوموري

315
00:21:12,040 --> 00:21:13,080
.أوشي

316
00:22:46,050 --> 00:22:47,050
:في الحلقة القادمة

317
00:22:47,050 --> 00:22:49,430
."حريق كيوتو الكبير، الجزء الثّاني"