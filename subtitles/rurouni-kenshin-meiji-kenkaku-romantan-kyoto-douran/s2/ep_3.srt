1
00:00:04,310 --> 00:00:06,900
.شينوموري أوشي

2
00:00:10,190 --> 00:00:12,820
هل تعرف أوشي-ساما؟

3
00:00:13,820 --> 00:00:15,610
ماذا عن أعضاء الأونيوابانشو؟

4
00:00:15,610 --> 00:00:16,950
هل ما زالوا مع أوشي-ساما؟

5
00:00:17,280 --> 00:00:18,490
.هيّا أخبرني

6
00:00:18,490 --> 00:00:21,370
أين الجميع الآن؟ هل هم بخير؟

7
00:00:20,040 --> 00:00:23,000
"جسر الدّموع"

8
00:00:27,040 --> 00:00:32,720
روروني كنشين
—اضطرابات كيوتو—

9
00:01:53,000 --> 00:01:57,010
:الحلقة السّابعة والعشرون
القرية المتخلّى عنها

10
00:02:00,470 --> 00:02:02,970
!أنت! انتظر لحظة

11
00:02:03,260 --> 00:02:05,930
لماذا صرت صامتًا فجأة؟

12
00:02:06,140 --> 00:02:08,600
أخبرني! هل هانيا-كُن بخير؟

13
00:02:08,600 --> 00:02:11,150
ماذا عن العجوز شيكيجو وبشيمي وهيوتّوكو؟

14
00:02:12,980 --> 00:02:14,020
ما خطبك أيّها القصير؟

15
00:02:14,020 --> 00:02:15,530
!يا رأس المكنسة! يا ذا النّدبة المتقاطعة

16
00:02:15,530 --> 00:02:18,280
!يا منتهك مرسوم منع حمل السّيف
!يا ذا الكيمونو الأحمر سيّئ الذّوق

17
00:02:19,070 --> 00:02:22,320
،لديّ اسم وهو هيمورا كنشين

18
00:02:22,320 --> 00:02:24,540
.لذلك أتمنّى لو تناديني به لو سمحت

19
00:02:24,540 --> 00:02:27,580
،إن ناديتك باسمك
فهل ستخبرني عن الجميع؟

20
00:02:27,580 --> 00:02:29,750
.لا علاقة للأمرين ببعضهما لو سمحت

21
00:02:30,580 --> 00:02:33,210
!كفّ عن العبث معي أيّها الوغد –
أورو؟ –

22
00:02:34,000 --> 00:02:36,630
أجبني! ما الّذي حدث لأوشي-ساما والبقيّة؟

23
00:02:36,630 --> 00:02:39,010
...أورو

24
00:02:45,720 --> 00:02:47,020
.لن أستسلم

25
00:02:48,270 --> 00:02:50,520
،منذ أن بدأت البحث عن أوشي-ساما والبقيّة

26
00:02:50,520 --> 00:02:53,440
هذه أوّل مرّة أحصل فيها
!على دليل ملموس

27
00:02:51,730 --> 00:02:53,440
‫‫"12 كيلومترًا إلى هاكوني"

28
00:02:54,270 --> 00:02:56,400
!لن أستسلم أبدًا

29
00:03:01,610 --> 00:03:03,820
.إنّها مثابِرة بكلّ تأكيد

30
00:03:05,200 --> 00:03:07,660
.ربّما عليّ التّحدّث عن الأونيوابانشو فحسب

31
00:03:08,790 --> 00:03:11,040
...ستكون هذه قصّة صعبة على ميساو-دونو

32
00:03:11,540 --> 00:03:14,840
لكن قد يكون ذلك أفضل
.من مواصلة البحث عنهم بتهوّر

33
00:03:14,840 --> 00:03:15,670
...ولكن

34
00:03:18,710 --> 00:03:22,590
.احرص ألاّ يقتلك أيّ أحد آخر حتّى أقتلك أنا

35
00:03:23,590 --> 00:03:29,060
رغم أنّها ستواصل مضايقتي
.بما أنّي الدّليل الوحيد الّذي لديها

36
00:03:29,810 --> 00:03:33,850
على أيّ حال، لا يمكنني جعلها
،تتبعني أكثر في هذه الرّحلة

37
00:03:34,270 --> 00:03:36,820
بما أنّ لا فكرة لديّ متى
.قد يهاجم رجال شيشيو

38
00:03:39,610 --> 00:03:40,610
.أظنّني سأهرب منها

39
00:03:40,610 --> 00:03:41,450
ماذا؟

40
00:03:44,070 --> 00:03:44,910
!يا هذا

41
00:03:45,120 --> 00:03:46,870
.يا لك من غبيّ

42
00:03:46,870 --> 00:03:48,290
،لو لم تتغيّر الأمور

43
00:03:48,290 --> 00:03:52,460
لكنتُ قادرة على مساعدة أوشي-ساما
.ككونويتشي في مجموعة الأونيوابانشو

44
00:03:52,460 --> 00:03:54,250
—أنا واثقة جدًّا من سرعة ركضي

45
00:03:54,710 --> 00:03:55,540
ماذا؟

46
00:03:55,960 --> 00:03:57,840
.لقد سبقني بمسافة طويلة

47
00:03:58,210 --> 00:03:59,050
!سُحقًا

48
00:03:59,300 --> 00:04:01,300
ما هذا الرّجل؟

49
00:04:11,890 --> 00:04:13,440
.إنّها لا تستسلم

50
00:04:13,440 --> 00:04:16,110
.أركض بسرعة كبيرة
.أنا متفاجئ لأنّها قادرة على مجاراتي

51
00:04:16,860 --> 00:04:17,690
...ولكن

52
00:04:18,480 --> 00:04:22,240
سُحقًا. لا أصدّق أنّ كلّ ما
.أستطيعه هو مجاراته فحسب

53
00:04:22,240 --> 00:04:24,490
.إنّه ليس رجلاً عاديًّا على الإطلاق

54
00:04:24,780 --> 00:04:28,200
.ربّما... قاتَل ضدّ أوشي-ساما والبقيّة

55
00:04:30,490 --> 00:04:31,910
.هذا مؤلم

56
00:04:32,710 --> 00:04:34,000
كلاّ، أين ذهب؟

57
00:04:39,420 --> 00:04:41,380
.كفّي عن مطاردتي

58
00:04:42,840 --> 00:04:44,380
عمّ تتكلّم؟

59
00:04:44,760 --> 00:04:46,220
!لقد بدأت للتّوّ

60
00:04:46,590 --> 00:04:48,680
ما لم تخبرني ما تعرفه
،عن أوشي-ساما والبقيّة

61
00:04:48,680 --> 00:04:50,060
—فلن أتراجع حتّى إن قتلت

62
00:04:59,270 --> 00:05:00,900
ماذا؟

63
00:05:01,980 --> 00:05:05,110
هل قفز فوق هذا الأخدود بالفعل؟

64
00:05:06,780 --> 00:05:07,910
ماذا أفعل؟

65
00:05:08,410 --> 00:05:11,330
.هذا مستحيل حتّى بالنّسبة لي

66
00:05:12,160 --> 00:05:14,500
.لكن عليّ إيقافه في كلّ الأحوال

67
00:05:15,160 --> 00:05:16,710
!الكوناي الطّاعنة الطّائرة

68
00:05:22,130 --> 00:05:25,590
صدّ الكوناي الطّائرة بضغط الهواء
.النّاجم عن سحب سيفه فحسب

69
00:05:26,430 --> 00:05:29,930
.استسلمي فحسب وعودي إلى كيوتو بسلام

70
00:05:30,300 --> 00:05:35,810
لا أعلم ما الظّروف الّذي دفعت
،أوشي ليأخذك تحت جناحه

71
00:05:35,810 --> 00:05:38,100
.لكنّ مجموعة الأونيوابانشو تواصل القتال

72
00:05:38,600 --> 00:05:40,150
.إنّهم في خطر دائم

73
00:05:40,980 --> 00:05:42,860
،كان أوشي مدركًا لذلك

74
00:05:42,860 --> 00:05:46,150
.ولهذا السّبب تركك مع ذلك الجدّ في كيوتو

75
00:05:50,120 --> 00:05:53,620
.من الأفضل أن تقسّي قلبك وتنسي

76
00:05:54,080 --> 00:05:56,080
.ذلك سيكون لصالح سعادتك

77
00:06:06,840 --> 00:06:07,930
.المعذرة

78
00:06:15,600 --> 00:06:18,940
!كفّ عن محاضرتي أيّها المغفّل

79
00:06:19,600 --> 00:06:20,690
ما الّذي تقصده بأن أنسى؟

80
00:06:20,940 --> 00:06:23,400
!كنتُ أبحث عنهم لأنّي لا أستطيع أن أنسى

81
00:06:23,400 --> 00:06:24,480
!توقّفي! لا تتهوّري

82
00:06:24,690 --> 00:06:29,820
كيف يمكن لنسيان الشّخص
الّذي أحبّ أن يجلب لي السّعادة؟

83
00:06:52,340 --> 00:06:55,640
.بعد كلّ هذا، إنّه رجل مذهل بالفعل

84
00:06:56,810 --> 00:06:58,390
.أنا أفهم نوعًا ما

85
00:06:58,390 --> 00:07:01,100
.لقد قاتَل أوشي-ساما

86
00:07:02,440 --> 00:07:03,770
.ولكن لا بأس

87
00:07:04,190 --> 00:07:08,030
،لا يهمّ من سيكون خصمه
.مستحيل أن يخسر أوشي-ساما

88
00:07:08,860 --> 00:07:12,530
واثقة أنّ أوشي-ساما ما زال في صحّة جيّدة
...ويعيش في مكان ما من هذا العالم

89
00:07:13,200 --> 00:07:16,160
.مع الجميع من الأونيوابانشو

90
00:07:21,540 --> 00:07:23,380
ماذا؟ ماذا؟

91
00:07:23,380 --> 00:07:25,170
.أرى أنّك استيقظت أخيرًا

92
00:07:28,510 --> 00:07:30,760
أفقدت الوعي؟

93
00:07:30,760 --> 00:07:31,590
.نعم

94
00:07:32,090 --> 00:07:34,680
وأنت انتظرت حتّى أستيقظ؟

95
00:07:36,680 --> 00:07:38,680
لديّ أسباب تجعلني هدفًا لهجمات عدوّ

96
00:07:38,680 --> 00:07:41,270
.في أيّ مرحلة من رحلتي هذه

97
00:07:41,770 --> 00:07:45,610
إنّها رحلة خطيرة لا يمكنني السّماح
.خلالها لأيّ أحد بالسّفر معي

98
00:07:46,070 --> 00:07:49,940
إن كنت ستلحقين بي، فابقي بعيدة
.وتظاهري أنّك غريبة لو سمحت

99
00:07:51,400 --> 00:07:55,490
لا أظنّك ستكفّين عن ملاحقتي
.لذلك لا تتصرّفي بتهوّر على الأقلّ

100
00:07:56,490 --> 00:07:57,870
،وحسب معرفتي بك

101
00:07:57,870 --> 00:08:00,830
فإنّك ستلاحقينني في كلّ الأحوال
حتّى إن رفضتُ ذلك، أليس كذلك؟

102
00:08:03,210 --> 00:08:04,630
!بالطّبع

103
00:08:04,920 --> 00:08:08,500
!سأقابل أوشي-ساما ثانية مهما كلّف الأمر

104
00:08:19,060 --> 00:08:20,310
.هذا ليس المطلوب

105
00:08:21,060 --> 00:08:23,310
.كلّ ما أفعله هو تدمير الطّبيعة حولي

106
00:08:23,310 --> 00:08:25,270
.لا يُعتبر ذلك تدريبًا على الإطلاق

107
00:08:26,360 --> 00:08:31,650
،بالتّفكير في الأمر
،كلّ ما فعلتُه هو الشّجار

108
00:08:31,650 --> 00:08:34,030
.لا فكرة لديّ ماذا يجدر بي أن أفعل

109
00:08:34,610 --> 00:08:39,370
وفوق كلّ ذلك، ظننتُ أنّي أسلك
،طريق ناكاسِندو

110
00:08:39,370 --> 00:08:42,500
.لكن انتهى بي المطاف وسط الجبال لسبب ما

111
00:08:42,960 --> 00:08:46,380
على أيّ حال، عليّ التّركيز على
.الوصول إلى كيوتو أوّلاً

112
00:08:49,500 --> 00:08:51,010
...الشَّمال من هنا. لذلك

113
00:08:51,510 --> 00:08:53,760
...وبما أنّ كيوتو في الغرب

114
00:08:54,510 --> 00:08:56,470
.فستكون في هذا الاتّجاه

115
00:08:57,220 --> 00:08:59,850
!حسنًا! ها أنا قادم يا كيوتو

116
00:09:00,810 --> 00:09:04,480
.وهكذا يضيع سانوسكي أكثر وأكثر

117
00:09:05,060 --> 00:09:07,060
"مصحّة أوغوني"

118
00:09:05,600 --> 00:09:06,480
...في تلك الأثناء

119
00:09:11,280 --> 00:09:12,230
ماذا؟

120
00:09:13,070 --> 00:09:15,200
!ميغومي-كُن! ما الّذي تفعلينه؟

121
00:09:15,200 --> 00:09:19,030
إنّه يحترق، صحيح؟ أيمكنك إزالته عنّي؟

122
00:09:15,570 --> 00:09:18,070
.أتساءل إن كان كِن-سان بخير

123
00:09:18,660 --> 00:09:21,910
،بدا الأمر خطيرًا مع جماعة شيشيو وحدها

124
00:09:21,910 --> 00:09:24,410
لكنّ ذلك المدعوّ شينوموري أوشي
.يلاحقه أيضًا الآن

125
00:09:25,750 --> 00:09:27,170
.أنا قلقة

126
00:09:27,170 --> 00:09:28,290
!هذا ساخن

127
00:09:34,340 --> 00:09:37,220
.وقلق ميغومي كان شديدًا جدًّا

128
00:09:37,220 --> 00:09:39,180
.بشتّى الأشكال

129
00:09:40,260 --> 00:09:41,640
...وأيضًا

130
00:09:47,270 --> 00:09:49,270
هل أنت بخير يا ياهيكو؟

131
00:09:50,060 --> 00:09:51,900
.لستُ بخير

132
00:09:52,440 --> 00:09:54,110
.شكرًا على الطّعام

133
00:09:54,650 --> 00:09:58,530
.لم أكن أعلم أنّ القوارب تتمايل لهذا الحدّ

134
00:09:58,530 --> 00:10:00,240
كيف يمكنك أن تكوني بخير؟

135
00:10:00,240 --> 00:10:04,580
،أشعر ببعض دوار الحركة بالفعل
.لكن لا يمكنني السّماح لذلك بإيقافي

136
00:10:05,200 --> 00:10:09,380
جعلتُ الجميع يقلقون عليّ أثناء
.اليومين الأخيرين بسبب نوبة حزني

137
00:10:09,790 --> 00:10:12,710
.لذلك قرّرتُ أنّي لن أشتكي بعد الآن

138
00:10:16,880 --> 00:10:18,090
.على رسلك

139
00:10:21,930 --> 00:10:24,970
...سأرى كنشين ثانية

140
00:10:26,060 --> 00:10:29,060
روروني كنشين
—اضطرابات كيوتو—

141
00:10:30,440 --> 00:10:31,440
.هيمورا

142
00:10:32,900 --> 00:10:34,110
!يا هيمورا

143
00:10:34,610 --> 00:10:37,860
إنّها الظّهيرة سلفًا، لماذا لا نتناول الغداء؟

144
00:10:40,410 --> 00:10:41,240
.أخبرني

145
00:10:41,700 --> 00:10:43,240
!ألا تسمعني؟

146
00:10:44,330 --> 00:10:45,950
!لا تتجاهلني يا هذا

147
00:10:46,370 --> 00:10:50,670
،ما هذا؟ وقبل كلّ شيء
لماذا تسير عبر الغابة عن قصد؟

148
00:10:50,670 --> 00:10:53,290
ما زلتَ تحاول الهرب منّي، أليس كذلك؟

149
00:10:53,710 --> 00:10:55,550
.لا أحاول ذلك

150
00:10:55,550 --> 00:11:00,840
عبور الغابة أسرع فحسب من الرّجوع
.عبر الطّريق الّذي أتينا منه لو سمحت

151
00:11:01,300 --> 00:11:02,970
.سنصل إلى الطّريق الرّئيسيّ عند الشّفق

152
00:11:02,970 --> 00:11:05,760
لا أنوي أخذ استراحة حتّى ذلك
.الوقت لو سمحت

153
00:11:06,140 --> 00:11:08,480
،أمّا بالنّسبة للغداء
.يمكنك أكله وأنت تسيرين

154
00:11:08,980 --> 00:11:11,730
...مفهوم. سأشرع في ذلك إذًا

155
00:11:12,810 --> 00:11:15,020
وماذا عنك يا هيمورا؟ ألن تأكل؟

156
00:11:15,020 --> 00:11:17,900
.لسوء الحظّ، لا أحمل معي أيّ طعام

157
00:11:18,490 --> 00:11:19,320
.هكذا إذًا

158
00:11:19,820 --> 00:11:22,410
،لكنّ هذا البسكويت القاسي لي
!لن تحصل على أيّ منه

159
00:11:22,910 --> 00:11:23,870
.نعم، نعم

160
00:11:24,070 --> 00:11:27,870
لكنّي سأعطيك بعضه إن أخبرتني
.عن أوشي-ساما والبقيّة

161
00:11:28,370 --> 00:11:29,500
.لا أريده

162
00:11:29,790 --> 00:11:34,420
يا إلهي. أتساءل ما الّذي يفعله
.أوشي-ساما والبقيّة الآن

163
00:11:38,170 --> 00:11:39,010
...على أيّ حال

164
00:11:39,340 --> 00:11:42,550
.هانيا-كُن خبير مذهل في الكِنبو

165
00:11:42,550 --> 00:11:46,100
!وبصراحة، تعلّمتُ تقنيات اللّكم منه

166
00:11:46,470 --> 00:11:47,310
.عجبًا

167
00:11:48,060 --> 00:11:49,680
.إنّها أفعى حفر

168
00:11:49,680 --> 00:11:50,680
.كان ذلك وشيكًا

169
00:11:50,980 --> 00:11:54,190
.وأنا أزعج نفسي وأحاول الحديث عن الجميع

170
00:11:54,440 --> 00:11:55,980
!استمع، اللّعنة عليك

171
00:11:59,860 --> 00:12:01,030
.على رسلك

172
00:12:01,030 --> 00:12:02,910
.أستمع لكلامك بالفعل لو سمحت

173
00:12:04,070 --> 00:12:08,080
يا إلهي. سأبدأ أخيرًا الحديث
.عن أوشي-ساما أيضًا

174
00:12:09,080 --> 00:12:09,950
...أوشي

175
00:12:09,950 --> 00:12:10,790
.نعم

176
00:12:11,250 --> 00:12:15,210
العبقريّ بين الجواسيس العباقرة
.الّذي صار أصغر قائد على الإطلاق

177
00:12:15,210 --> 00:12:16,750
.خبير في الكِنبو والسّيف القصير

178
00:12:17,710 --> 00:12:22,010
.إنّه جادّ ومسؤول وطيّب
.يهتمّ كثيرًا لزملائه

179
00:12:22,510 --> 00:12:26,970
،ولكن ظاهريًّا
،كقائد لمجموعة الأونيوابانشو

180
00:12:26,970 --> 00:12:29,810
.فإنّه ذكيّ ولكن قاسي القلب وجامد الوجه

181
00:12:31,140 --> 00:12:36,440
.كان ليحفّز زملاءه ويبتسم بثقة قبل المعركة

182
00:12:36,440 --> 00:12:38,480
،لكنّه لم يبتسم أبدًا في الحقيقة
.ولا حتّى لمرّة واحدة

183
00:12:39,570 --> 00:12:42,110
.أعتقد أنّه لا يزال هكذا حتّى يومنا هذا

184
00:12:44,280 --> 00:12:49,700
لكنّي سأرى يومًا ما ابتسامة
—أوشي-ساما الخفيّة

185
00:12:49,700 --> 00:12:50,790
!يا هذا

186
00:12:50,950 --> 00:12:51,790
ماذا؟

187
00:12:52,000 --> 00:12:58,000
.كان يسير عبر الشّجيرات هكذا بسهولة البارحة

188
00:12:59,090 --> 00:13:03,470
أخبرني، لماذا تتكبّد عناء الدّوس
على العشب هكذا؟

189
00:13:03,880 --> 00:13:06,050
.سيجعل ذلك السّير أسهل عليك

190
00:13:08,720 --> 00:13:12,680
إنّه... بإمكانه أن يضيّعني بسهولة
.إن حاول ذلك

191
00:13:14,060 --> 00:13:16,980
بطريقة ما... إنّهما مختلفان تمامًا
.من حيث الشّخصيّة

192
00:13:17,730 --> 00:13:20,610
لكنّ طريقة إخفائه لمشاعره الحقيقيّة

193
00:13:20,610 --> 00:13:23,280
.هو شيء يتشاركه مع أوشي-ساما نوعًا ما

194
00:13:24,820 --> 00:13:25,950
.غيّرتُ رأيي

195
00:13:26,860 --> 00:13:28,820
أنت جائع، صحيح يا هيمورا؟

196
00:13:30,450 --> 00:13:32,790
.سأقدّم لك واحدة في النّهاية

197
00:13:34,250 --> 00:13:36,290
ولكن واحدة فقط، مفهوم؟

198
00:13:39,710 --> 00:13:41,960
—هل تحتوي على سمّ أو ما شابه

199
00:13:41,960 --> 00:13:42,880
!كلاّ

200
00:13:44,670 --> 00:13:46,090
.لا بأس بها إذًا

201
00:13:50,430 --> 00:13:51,390
هيمورا؟

202
00:13:53,810 --> 00:13:54,770
—هل كان ذلك الصّوت

203
00:13:56,020 --> 00:13:59,520
.ابتعدي عنّي بصمت قدر الإمكان لو سمحت

204
00:13:59,520 --> 00:14:02,940
أيُعقل... أنّ هنالك من يسعى خلفك بالفعل؟

205
00:14:02,940 --> 00:14:04,190
!اذهبي بسرعة فحسب

206
00:14:04,940 --> 00:14:09,280
،هذا سيّئ. إن هاجموا الآن
.فستتورّط ميساو-دونو أيضًا

207
00:14:09,950 --> 00:14:10,870
.لا خيار أمامي

208
00:14:11,120 --> 00:14:12,950
!عليّ المبادرة بالهجوم

209
00:14:13,330 --> 00:14:15,040
!مهلاً! انتظر لحظة

210
00:14:15,250 --> 00:14:18,250
—بإمكاني مساعدتك ولو

211
00:14:32,560 --> 00:14:34,680
هل هو ميت؟

212
00:14:35,180 --> 00:14:37,430
...لا، لكن

213
00:14:39,690 --> 00:14:42,900
هل من كلمات أخيرة لو سمحت؟

214
00:14:44,650 --> 00:14:47,360
أن يشهد المرء على لحظات آخرَ
.الأخيرة هو قدر من نوع ما

215
00:14:48,200 --> 00:14:50,200
.سأفعل كلّ ما بوسعي لو سمحت

216
00:14:51,950 --> 00:14:55,620
...أ-أرجوك

217
00:14:57,450 --> 00:14:59,210
...قريتي... وأخي الصّغير

218
00:15:00,920 --> 00:15:03,960
.أنقذهم من جماعة شيشيو

219
00:15:10,890 --> 00:15:14,220
،كانت قرية صغيرة تضمّ 50 شخصًا

220
00:15:14,220 --> 00:15:19,310
تقع على مقربة من طريق
.توكايدو قرب نومازو-جوكو

221
00:15:19,980 --> 00:15:21,690
.اسم القرية هو شينغِتسو

222
00:15:22,440 --> 00:15:27,030
يقال أنّها كانت قرية عاديّة
.حتّى سنتين من الآن

223
00:15:29,240 --> 00:15:30,910
!هيّا، استيقظ

224
00:15:33,990 --> 00:15:35,120
.إنّه مستيقظ

225
00:15:35,990 --> 00:15:37,160
من أنتما؟

226
00:15:38,290 --> 00:15:39,120
وأين أخي؟

227
00:15:49,840 --> 00:15:52,680
...عندما وجدناه، كان قد

228
00:15:54,640 --> 00:15:57,470
!سُحقًا

229
00:16:03,600 --> 00:16:06,360
هلاّ أخبرتنا... عن وضعك؟

230
00:16:08,320 --> 00:16:12,070
ما الّذي قد أجنيه من حديثي مع غريبين؟

231
00:16:12,320 --> 00:16:16,330
.أنا في طريقي إلى كيوتو لمواجهة شيشيو

232
00:16:27,090 --> 00:16:28,460
...قبل سنتين

233
00:16:28,880 --> 00:16:34,180
،ظهر أحد رجال شيشيو فجأة
.وقتل الشّرطيّ واستولى على القرية

234
00:16:34,970 --> 00:16:39,140
وفي كلّ مرّة يتمّ إرسال شرطيّ
.جديد، كان يقوم بقتله

235
00:16:40,390 --> 00:16:43,060
.وبعد عامين، توقّفوا عن إرسال رجال الشّرطة

236
00:16:43,060 --> 00:16:45,600
.تخلّت الحكومة عن قرية شينغِتسو

237
00:16:45,810 --> 00:16:49,190
.مستحيل. تخلّت عنها؟ هذه مبالغة

238
00:16:49,190 --> 00:16:51,650
...ربّما يأخذون وقتهم لوضع خطّة

239
00:16:53,070 --> 00:16:54,570
.انظرا لهذه

240
00:16:55,410 --> 00:16:58,780
هذه أحدث خريطة أحضرها
.أخي الكبير معه من طوكيو

241
00:16:58,780 --> 00:17:00,910
!لقد اختفى اسم "قرية شينغِتسو" منها

242
00:17:01,910 --> 00:17:04,790
أدرك أخي الكبير الكارثة الّتي حلّت
بالقرية بعد رؤيته لهذا

243
00:17:04,790 --> 00:17:08,880
.وحاول إنقاذ عائلته على الأقلّ وقُتل

244
00:17:09,670 --> 00:17:12,800
!قُتل على يد سِنكاكو، أحد رجال شيشيو المقرّبين

245
00:17:14,340 --> 00:17:15,430
.عليّ العودة

246
00:17:15,930 --> 00:17:19,010
.ما زال والداي هناك لأنّهما لم يستطيعا الهرب

247
00:17:19,640 --> 00:17:20,930
!عليّ إنقاذهما

248
00:17:23,600 --> 00:17:24,560
...أخي

249
00:17:26,190 --> 00:17:28,060
.أعرني قوّتك رجاءً

250
00:17:30,400 --> 00:17:34,360
.سأعيرك أنا قوّتي بدل أخيك لو سمحت

251
00:17:36,110 --> 00:17:37,910
ما اسمك؟

252
00:17:39,530 --> 00:17:40,530
.إيجي

253
00:17:41,290 --> 00:17:43,250
.ميساو-دونو، اعتني بإيجي

254
00:17:43,250 --> 00:17:44,870
!ماذا؟ أنا سأذهب معك

255
00:17:45,000 --> 00:17:48,250
.لا. سأذهب إلى القرية وحدي

256
00:17:48,250 --> 00:17:49,920
.عليكما الانتظار هنا لو سمحت

257
00:18:00,260 --> 00:18:02,260
.لا يتمّ الاعتناء بها على الإطلاق

258
00:18:02,770 --> 00:18:04,100
.وكأنّها قرية مهجورة

259
00:18:05,730 --> 00:18:10,860
يأتي شيشيو إلى هذه القرية ويظلّ
.فيها لحوالي أسبوع كلّ ستّة أشهر

260
00:18:11,360 --> 00:18:13,820
،لا أدري لماذا يأتي

261
00:18:13,820 --> 00:18:17,950
.ولكنّ سِنكاكو يحكم هذه القرية لذلك السّبب

262
00:18:18,570 --> 00:18:22,620
.وشيشيو يقيم في القرية في الوقت الحاليّ

263
00:18:23,620 --> 00:18:26,870
.يوجد سِنكاكو في ذلك القصر لخدمة شيشيو

264
00:18:27,370 --> 00:18:30,040
!لذلك هذه هي الفرصة الوحيدة لإنقاذ والداي

265
00:18:31,170 --> 00:18:34,260
.أنت، علينا الاقتراب أكثر وإلاّ فقدنا أثره

266
00:18:34,260 --> 00:18:38,260
.هيمورا ليس رجلاً عاديًّا
.سيلاحظ وجودنا إن اقتربنا أكثر

267
00:18:55,900 --> 00:18:57,240
...إعدام

268
00:18:58,070 --> 00:19:01,950
،جسداهما مُقطّعان
.تمامًا مثل جسد أخي ذلك الولد

269
00:19:02,410 --> 00:19:05,160
إذًا فهذا أيضًا من أفعال المدعوّ سِنكاكو؟

270
00:19:09,170 --> 00:19:11,830
!أبي! أمّي

271
00:19:22,970 --> 00:19:25,510
.لا بدّ أنّك غريب

272
00:19:26,100 --> 00:19:28,350
!لا ينجو الغرباء من هنا أبدًا

273
00:19:28,850 --> 00:19:32,310
.مع أنّ هذين الاثنين كانا من القرية

274
00:19:32,520 --> 00:19:36,690
.خطّط ابنهما الهرب من هذه القرية

275
00:19:36,690 --> 00:19:40,150
.أعدمهما سِنكاكو-ساما تحمّلاً للمسؤوليّة

276
00:19:40,610 --> 00:19:43,990
.مع أنّنا نحن من علّقناهما لاحقًا

277
00:19:44,620 --> 00:19:46,160
.علّقوهما ليكونا عبرة

278
00:19:46,540 --> 00:19:51,500
هذه هي القرية الّتي حصل عليها
!شيشيو-ساما من خنازير الحكومة

279
00:19:52,080 --> 00:19:56,130
والقوّة لمنح الحياة أو الموت
بين يديْ شيشيو-ساما

280
00:19:56,130 --> 00:19:59,590
!وسِنكاكو-ساما الّذي يحكم القرية بأكملها

281
00:19:59,880 --> 00:20:04,350
،ونزولاً عند أوامر سِنكاكو-ساما
!الموت هو مصير كلّ الغرباء

282
00:20:04,600 --> 00:20:05,930
!استعدّ

283
00:20:05,930 --> 00:20:07,310
...إنّ من عليه الاستعداد الآن

284
00:20:07,810 --> 00:20:08,770
.هو أنتم

285
00:20:16,610 --> 00:20:20,570
في العادة، كنتُ لأقول أنّ على
.من لا يريد أن يتأذّى أن يتراجع

286
00:20:21,450 --> 00:20:23,570
.لكنّي لستُ قادرًا على قول ذلك اليوم

287
00:20:24,030 --> 00:20:27,200
!سأطيح بكلّ واحد منكم

288
00:20:27,740 --> 00:20:30,660
!الموت هو مصير كلّ الغرباء

289
00:20:34,580 --> 00:20:36,590
!هيّا، تماسك! هيّا

290
00:20:36,960 --> 00:20:40,840
،أعلم أنّ هذا صعب للغاية
!لكنّه ليس وقتًا مناسبًا للاستسلام

291
00:20:40,840 --> 00:20:43,340
.لن يُعيد البكاء الموتى

292
00:20:43,340 --> 00:20:44,800
!لذلك عليك أن تقف على قدميك الآن

293
00:20:45,180 --> 00:20:46,260
...الموت هو

294
00:20:47,050 --> 00:20:48,350
!مصير كلّ الغرباء

295
00:20:50,060 --> 00:20:50,930
!سُحقًا

296
00:20:51,100 --> 00:20:53,100
...الموت هو مصير كلّ

297
00:21:00,650 --> 00:21:03,950
مـ-من أنت؟

298
00:21:05,360 --> 00:21:06,660
...ذلك الرّجل

299
00:21:07,200 --> 00:21:10,120
...ظننتُ أنّه في طريقه إلى كيوتو

300
00:21:10,540 --> 00:21:14,250
لماذا يضيّع وقته في مكان كهذا؟

301
00:22:45,090 --> 00:22:50,090
:الحلقة القادمة
صورة الطَّموح

302
00:22:46,630 --> 00:22:49,590
."في الحلقة القادمة: "صورة الطَّموح