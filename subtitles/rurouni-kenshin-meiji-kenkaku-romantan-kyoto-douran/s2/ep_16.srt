1
00:00:11,510 --> 00:00:12,770
!معلّمي

2
00:00:14,030 --> 00:00:16,450
إنّ وميض التّنّين الطّائر المقدّس

3
00:00:16,660 --> 00:00:19,400
.هي التّقنية الأقوى في أسلوب ميتسوروغي

4
00:00:19,780 --> 00:00:22,830
أنا أيضًا حصلتُ عليها على حساب

5
00:00:22,960 --> 00:00:24,920
.حياة سلفي

6
00:00:25,620 --> 00:00:27,030
،وبصفتّي معلّمًا

7
00:00:27,260 --> 00:00:29,880
.ما عاد لي أيّ شيء لأعلّمك إيّاه

8
00:00:31,410 --> 00:00:33,840
،سيكون عليك بدءًا من الآن أيّها الرّوروني

9
00:00:34,160 --> 00:00:35,260
...أن تواصل

10
00:00:41,060 --> 00:00:42,520
...معلّمي

11
00:00:50,710 --> 00:00:52,340
.لا بدّ أنّه يمزح

12
00:00:52,870 --> 00:00:55,000
حتّى في سنّه هذه، فهو أقوى بكثير

13
00:00:55,410 --> 00:00:59,280
من أن تتمّ الإطاحة به بضربة
.ساكاباتو بسيطة

14
00:01:19,290 --> 00:01:20,760
.سأنقذه

15
00:01:22,370 --> 00:01:24,320
!لا يجب أن يموت هكذا

16
00:03:02,580 --> 00:03:03,570
!ها هو ذا

17
00:03:03,990 --> 00:03:06,770
،أكلتُ فطر قرطوب كاد يقتلني

18
00:03:06,890 --> 00:03:08,910
.وأعدّ لي هذا العلاج

19
00:03:09,430 --> 00:03:13,420
.لا وقت لإحضار طبيب من أسفل الجبل

20
00:03:14,010 --> 00:03:15,420
عليّ أن أعتمد

21
00:03:15,580 --> 00:03:18,680
.على قوّة معلّمي وهذه الجرعة

22
00:03:22,840 --> 00:03:24,020
...معلّمي

23
00:03:27,110 --> 00:03:28,480
.لقد عدت

24
00:03:28,990 --> 00:03:30,020
!ها أنت يا فتى

25
00:03:30,350 --> 00:03:32,650
.ما الّذي حدث؟ تبدين غاضبة

26
00:03:32,790 --> 00:03:35,150
أين كنت طوال هذا الوقت؟

27
00:03:36,750 --> 00:03:41,010
.معنويّات الجميع منخفضة لبقائهم محاصرين هنا

28
00:03:41,180 --> 00:03:44,570
.لذلك خرجتُ لشراء مأكولات تتميّز بها كيوتو

29
00:03:44,960 --> 00:03:48,060
أذلك هو سبب اختفائك لثلاثة أيّام؟

30
00:03:48,200 --> 00:03:50,330
.لم أعرف ما الّذي أختاره

31
00:03:51,930 --> 00:03:53,140
هل من مشكلة؟

32
00:03:53,900 --> 00:03:58,280
.وصل أوسوي أثناء غيابك
!لقد مررنا بالكثير

33
00:03:58,430 --> 00:04:01,180
وماذا فعلت؟

34
00:04:02,160 --> 00:04:05,060
.مرحبًا يا أوسوي-سان. لم أرك منذ مدّة

35
00:04:05,200 --> 00:04:06,720
أتريد بعض الحلويّات؟

36
00:04:17,240 --> 00:04:18,900
أهي ياتسوهاتشي؟

37
00:04:20,650 --> 00:04:21,860
.بالضّبط

38
00:04:22,410 --> 00:04:24,030
.مذهل كعادتك يا أوسوي-سان

39
00:04:24,600 --> 00:04:27,280
،في كلّ مرّة تترك فيها شيشيو

40
00:04:27,420 --> 00:04:31,110
.يكون ذلك لأجل مهمّة ما

41
00:04:31,250 --> 00:04:33,790
.وليس لشراء الحلويّات

42
00:04:34,430 --> 00:04:36,310
،بفضل عين الرّوح شينغان خاصّتي

43
00:04:36,450 --> 00:04:39,980
.أستطيع قراءة أفكار أيّ أحد

44
00:04:40,130 --> 00:04:44,070
حتّى بالنّسبة لأكثر العقول اضطرابًا

45
00:04:44,200 --> 00:04:46,510
.مثل عقلك أنت

46
00:04:47,110 --> 00:04:48,070
فعلاً؟

47
00:04:52,520 --> 00:04:53,640
...ولكن

48
00:04:54,470 --> 00:04:57,260
،مهما كان ما تخطّط له

49
00:04:57,390 --> 00:05:00,110
.فهو ليس من شأني

50
00:05:01,660 --> 00:05:04,190
.بالمناسبة، كدت أنسى

51
00:05:04,580 --> 00:05:08,510
تمّ استدعاء السّيوف العشرة
.للقاعة الكبرى بشكل طارئ

52
00:05:08,640 --> 00:05:12,420
.وصل آخر ثلاثة إلى هنا سلفًا

53
00:05:14,680 --> 00:05:16,980
.مرحبًا يا كاماتاري-سان

54
00:05:18,290 --> 00:05:21,400
.هذا أنت يا سو-تشان! سررت بلقائك

55
00:05:23,560 --> 00:05:26,380
.وسررت بلقائك أنت أيضًا يا يومي-سان

56
00:05:27,800 --> 00:05:31,280
دعينا نكتشف أخيرًا من منّا بإمكانه

57
00:05:31,430 --> 00:05:33,060
.الفوز بقلب شيشيو-ساما

58
00:05:33,460 --> 00:05:35,180
.بكلّ سرور

59
00:05:35,660 --> 00:05:39,400
.وكأنّي قد أخسر في مواجهة رجل مثلك

60
00:05:41,640 --> 00:05:44,230
.إنّ شعف الشّباب جميل بالفعل

61
00:05:44,380 --> 00:05:45,980
.الشّيخ سايزوتشي

62
00:05:48,440 --> 00:05:50,820
.تبدو في صحّة جيّدة

63
00:05:51,800 --> 00:05:54,900
.أنت الوحيد الّذي تبدو سعيدًا برؤيتي

64
00:05:55,040 --> 00:05:59,500
.يرفض البقيّة إلقاء نظرة أو تحيّة عليّ حتّى

65
00:05:59,690 --> 00:06:02,500
!حال شباب هذه الأيّام في انحدار

66
00:06:02,840 --> 00:06:08,200
لكن في الحقيقة، يشعرون جميعًا
.بالغيرة من قوّتي

67
00:06:10,340 --> 00:06:12,950
بالمناسبة، أين شريكك؟

68
00:06:13,800 --> 00:06:15,270
.بقي فوجي في الخارج

69
00:06:15,690 --> 00:06:19,880
.من المستحيل له أن يتّسع داخل المخبأ

70
00:06:20,350 --> 00:06:23,360
،عندما نكون أنا وهو جزءًا من جيش ما

71
00:06:23,500 --> 00:06:27,530
.لا يوجد عدوّ قد يشكّل تهديدًا لنا

72
00:06:27,670 --> 00:06:30,540
،وهذا يجعل من الضّعفاء مجرّد متفرّجين

73
00:06:30,680 --> 00:06:32,520
.وذلك هو سبب استيائهم

74
00:06:33,950 --> 00:06:36,050
.هكذا الأمر إذًا

75
00:06:38,860 --> 00:06:40,380
أهنالك خطب ما؟

76
00:06:40,520 --> 00:06:43,850
إن كنت لا أنظر إليك، فذلك ببساطة

77
00:06:43,990 --> 00:06:46,000
.لأنّي لستُ مهتمًّا بك

78
00:06:46,310 --> 00:06:47,970
...المعذرة يا هينيا-سان

79
00:06:48,110 --> 00:06:52,320
كان بإمكاني تجاهل ثرثرتك
،أيّها العجوز الخرِف

80
00:06:52,690 --> 00:06:54,670
.لكنّك أهنتني

81
00:06:55,080 --> 00:06:58,640
.أنت هو الضّعيف أيّها العجوز

82
00:07:01,030 --> 00:07:02,960
.لا أنصحك بإسماعي لمثل هذا الكلام

83
00:07:03,100 --> 00:07:07,940
هل أنت من النّوع الّذي يتفاخر
للتّغطية عن ضعفه؟

84
00:07:08,630 --> 00:07:12,450
إن اعتذرتَ منّي، فقد تعيش
.لعُمر أطول ممّا عشتَه حتّى الآن

85
00:07:12,750 --> 00:07:16,950
.سأنقش هذه الكلمات على شاهد قبرك

86
00:07:25,680 --> 00:07:26,660
.هذا يكفي

87
00:07:28,200 --> 00:07:30,400
...ستكون التّالي إن تدخّلت

88
00:07:30,820 --> 00:07:33,090
.قلتُ هذا يكفي

89
00:07:34,220 --> 00:07:35,680
.امتنعوا رجاءً عن أيّ شجار

90
00:07:35,820 --> 00:07:37,970
سيخيب ظنّ شيشيو-سان

91
00:07:38,100 --> 00:07:41,930
.إن تقاتلنا فيما بيننا في يوم لمّ شملنا

92
00:07:42,080 --> 00:07:43,770
أتريدون حلويّات؟

93
00:07:45,990 --> 00:07:48,930
من الأفضل ترك الأمر على هذا
.الحال أيّها الشّيخ سايزوتشي

94
00:07:49,280 --> 00:07:50,900
.ما باليد حيلة

95
00:07:56,260 --> 00:07:57,470
.لقد هدأ

96
00:07:59,030 --> 00:08:01,320
.شكرًا جزيلاً يا أنجي-سان

97
00:08:01,460 --> 00:08:04,500
.فعلتُ ما كان يجب عليّ فعله فحسب

98
00:08:05,060 --> 00:08:06,630
.لنهدأ جميعًا

99
00:08:06,770 --> 00:08:08,050
.اخرس

100
00:08:11,590 --> 00:08:14,290
.جيّد! يبدو أنّ الجميع هنا

101
00:08:17,940 --> 00:08:21,340
.آسف يا شيشيو-سان على غيابي لثلاثة أيّام

102
00:08:21,480 --> 00:08:22,320
.لا بأس

103
00:08:22,470 --> 00:08:23,970
.أحضرتُ هذه معي

104
00:08:24,100 --> 00:08:27,360
.ليس الآن يا سوجيرو. الأولويّة للاجتماع

105
00:08:27,500 --> 00:08:29,020
.إنّها لذيذة

106
00:08:43,800 --> 00:08:45,420
.شكرًا جزيلاً لك

107
00:08:45,780 --> 00:08:47,500
.سأستمتع بها لاحقًا

108
00:08:49,820 --> 00:08:52,170
.شكرًا لقدومكم من أماكن بعيدة

109
00:08:52,360 --> 00:08:55,220
.وآسف على جعلكم تنتظرون

110
00:08:55,610 --> 00:08:59,330
.منع حدث ما تشو من التّواجد معنا

111
00:08:59,880 --> 00:09:03,790
.جميعنا هنا الآن فيما عداه

112
00:09:05,310 --> 00:09:06,880
،إنّ من يحبّونني

113
00:09:07,440 --> 00:09:09,650
،وأولئك الّذين يسعون لموتي

114
00:09:10,040 --> 00:09:12,560
،والمحبطين من حكومة ميجي

115
00:09:13,360 --> 00:09:16,840
...وأولئك الّذين لديهم ثقة مطلقة في قوّتهم

116
00:09:19,180 --> 00:09:21,430
،لكلّ واحد منهم نواياه وخططه الخاصّة

117
00:09:21,620 --> 00:09:25,340
.لكنّنا سنبدأ التّحرّك معًا

118
00:09:27,370 --> 00:09:30,880
،غدًا ليلاً قبل دقيقة من منتصف اللّيل

119
00:09:31,070 --> 00:09:33,940
.سنضرم النّيران في كيوتو

120
00:09:38,630 --> 00:09:40,220
هل من اعتراضات؟

121
00:09:44,870 --> 00:09:45,950
.لا اعتراضات

122
00:09:54,720 --> 00:09:56,860
.هذا الوحش ليس بشرًا

123
00:09:57,020 --> 00:10:00,980
ستُدمَّر كيوتو في لمح البصر
.إن أُطلق العنان لقوّته

124
00:10:01,120 --> 00:10:02,330
أليس كذلك يا توكوجي؟

125
00:10:02,550 --> 00:10:05,540
.قوّة كلّ واحد من السّيوف العشرة وحشيّة

126
00:10:05,690 --> 00:10:08,210
.من الأفضل تفادي الاقتراب منهم كثيرًا

127
00:10:08,360 --> 00:10:09,640
.هذا صحيح

128
00:10:09,790 --> 00:10:12,500
،أنا جاهز للموت تنفيذًا لأوامر شيشيو-ساما

129
00:10:12,650 --> 00:10:15,510
.لكن ليس هباءً على يد أوسوي

130
00:10:15,750 --> 00:10:17,420
!يا شوزو

131
00:10:21,430 --> 00:10:25,240
غويتشي، قلتَ أنّك من كيوتو، صحيح؟

132
00:10:25,380 --> 00:10:26,220
.نعم

133
00:10:26,440 --> 00:10:27,940
ألا يزعجك هذا؟

134
00:10:28,370 --> 00:10:30,420
.ستلتهم النّيران المدينة ليلة الغد

135
00:10:30,840 --> 00:10:33,150
.سأتجاوز ذلك يا توجيرو-سان

136
00:10:33,540 --> 00:10:36,430
.ذهبت أمّي إلى الجبال

137
00:10:36,800 --> 00:10:37,910
ووالدك؟

138
00:10:38,040 --> 00:10:40,990
.لقد قُتل أثناء اضطرابات فترة الإصلاح

139
00:10:41,130 --> 00:10:42,270
.هكذا إذًا

140
00:10:44,610 --> 00:10:47,580
!الإصلاح، النّظام الجديد... مجرّد هراء

141
00:10:47,770 --> 00:10:52,050
.تغيّرت مقاليد السّلطة، لكن لم تتحسّن أوضاعنا

142
00:10:52,180 --> 00:10:56,960
وحدهم جماعة صغيرة من النّاس
.من يعيشون حياة هانئة

143
00:10:57,200 --> 00:11:00,590
لذلك فإنّ الأمر منوط بنا نحن
.لبناء حقبة جديدة

144
00:11:00,960 --> 00:11:03,140
!حان وقت ثورتنا

145
00:11:29,700 --> 00:11:32,020
!هذا رائع بالفعل

146
00:11:32,520 --> 00:11:34,010
.كنتُ أبحث عنك

147
00:11:34,140 --> 00:11:37,800
.احرص على إبلاغ أحد ما عندما تخرج

148
00:11:39,040 --> 00:11:40,470
ماذا تريد منّي؟

149
00:11:40,740 --> 00:11:44,990
.أريد إبلاغك بإشاعة تدور في البلدة فحسب

150
00:11:45,140 --> 00:11:48,640
.يُقال أنّ العجوز من أوُيْيا قد عاد للحياة

151
00:11:49,610 --> 00:11:51,610
لماذا أتيت إلى هنا لإخباري؟

152
00:11:51,760 --> 00:11:53,800
.ظننتُ أنّ الأمر يقلق راحتك

153
00:11:54,460 --> 00:11:57,880
.هدفي الوحيد هو قتل الباتّوساي

154
00:11:58,350 --> 00:12:00,640
.ولا يهمّني أيّ شيء آخر

155
00:12:03,210 --> 00:12:04,230
وأنت؟

156
00:12:04,370 --> 00:12:05,220
عفوًا؟

157
00:12:05,810 --> 00:12:08,280
ما سبب اتّباعك لذلك الرّجل؟

158
00:12:10,540 --> 00:12:13,760
تتحدّث عن شيشيو-سان، أليس كذلك؟

159
00:12:15,250 --> 00:12:16,380
.نعم

160
00:12:19,140 --> 00:12:20,460
...هدفي

161
00:12:24,830 --> 00:12:25,800
ماذا هنالك؟

162
00:12:28,120 --> 00:12:29,100
.لا شيء

163
00:12:31,510 --> 00:12:33,840
،ربّما لا يكون لديّ هدف

164
00:12:34,230 --> 00:12:35,400
.في نهاية المطاف

165
00:12:36,550 --> 00:12:38,400
!يومي-سان

166
00:12:40,080 --> 00:12:42,260
هل صحيح أنّ تشو قد اعتُقل؟

167
00:12:42,410 --> 00:12:45,300
صحيح. على الأرجح أنّه يتذمّر
.في السّجن الآن

168
00:12:46,270 --> 00:12:47,780
لماذا لا يهرب؟

169
00:12:47,940 --> 00:12:52,410
.ما أدراني؟ ربّما وضعوا له حارسًا قويًّا

170
00:12:53,830 --> 00:12:55,030
.هذا مؤسف

171
00:12:55,160 --> 00:13:00,640
عجبًا. من النّادر أن يثير رجل آخر
.غير شيشيو-ساما اهتمامك

172
00:13:00,800 --> 00:13:02,360
هل أشمّ رائحة خيانة؟

173
00:13:02,500 --> 00:13:05,460
.غبيّة! بالطّبع لا

174
00:13:05,600 --> 00:13:10,180
كانت المعركة لتكون أسهل
.بكثير بوجود تشو فحسب

175
00:13:10,800 --> 00:13:12,440
لِمَ أسهل؟

176
00:13:12,670 --> 00:13:15,600
.لنقل أنّ ذلك كان ليوفّر عليّ التّفكير الزّائد

177
00:13:15,760 --> 00:13:20,400
إنّ ضمير المرء قد يعرقله
.في بعض الأحيان خلال المعركة

178
00:13:20,600 --> 00:13:22,570
.وهذا يعقّد الأمور

179
00:13:23,780 --> 00:13:27,350
.إنّه لا يشفق على النّساء والأطفال إطلاقًا

180
00:13:28,220 --> 00:13:29,520
.لا يهمّ على أيّ حال

181
00:13:29,790 --> 00:13:34,750
سأبذل كلّ ما في وسعي للحصول
!على انتباه شيشيو-ساما

182
00:13:34,890 --> 00:13:36,510
.إلى اللّقاء

183
00:13:39,960 --> 00:13:42,840
.إنّ اللّحظة المنتظرة تدنو منّا يا شيشيو-ساما

184
00:13:42,990 --> 00:13:44,050
.نعم

185
00:13:44,720 --> 00:13:47,530
.ستتغيّر كيوتو بالكامل في ظرف يوم واحد

186
00:13:47,700 --> 00:13:50,170
.وكذلك اليابان في ظرف أيّام قليلة

187
00:13:50,700 --> 00:13:52,350
.أرى بعض الحماسة في الأفق أخيرًا

188
00:13:52,480 --> 00:13:53,930
!شيشيو-ساما

189
00:13:54,070 --> 00:13:55,500
.لا تبكِ، ذلك مزعج

190
00:13:55,620 --> 00:13:56,570
!حاضر

191
00:13:56,700 --> 00:13:58,720
.مع أننا لم نبدأ بعد حتّى

192
00:13:58,860 --> 00:14:00,520
.حاضر، حاضر

193
00:14:00,910 --> 00:14:02,360
...ولكن –
نعم؟ –

194
00:14:02,960 --> 00:14:05,690
...إن كان هنالك ما أندم عليه

195
00:14:32,930 --> 00:14:34,120
...معلّمي

196
00:14:42,760 --> 00:14:45,610
.حسنًا، سأتركك الآن. سأذهب إلى العيادة

197
00:14:48,310 --> 00:14:50,400
أواثقة أنّك بخير؟

198
00:14:50,540 --> 00:14:52,200
ماذا؟ لماذا؟

199
00:14:57,170 --> 00:14:59,330
هل ستخرجين يا ميغومي-سان؟

200
00:14:59,470 --> 00:15:00,370
.نعم

201
00:15:00,510 --> 00:15:01,420
.أتمنّى لك يومًا طيّبًا

202
00:15:02,190 --> 00:15:03,760
.ميساو-تشان

203
00:15:05,120 --> 00:15:07,860
أيمكنك الذّهاب للحديث معها؟

204
00:15:10,360 --> 00:15:12,800
.من الخطير التّحديق بشرود أمام نافذة

205
00:15:13,170 --> 00:15:16,900
.قد يستهدفك العدوّ في أيّ لحظة

206
00:15:17,080 --> 00:15:18,220
...ميساو-تشان

207
00:15:18,420 --> 00:15:22,030
.لا تقولي "ميساو"! صرت أُعرف بالقائدة الآن

208
00:15:24,130 --> 00:15:28,330
أتمنّى أن يعود هيمورا قريبًا
.وقد تعلّم كلّ الأسرار

209
00:15:31,000 --> 00:15:32,040
.آسفة

210
00:15:32,310 --> 00:15:35,500
.لديك ما يكفي لتقلقي بشأنه يا ميساو-تشان

211
00:15:35,620 --> 00:15:37,870
.لا، لا. لا تقلقي حيالي

212
00:15:38,290 --> 00:15:41,460
.لقد سُوّي كلّ شيء الآن

213
00:15:41,830 --> 00:15:45,400
.لذلك لا تتردّدي إن كان هنالك ما يزعجك

214
00:15:50,060 --> 00:15:53,170
.يحاول دائمًا أن يصير أقوى وأقوى

215
00:15:53,710 --> 00:15:56,890
.ذلك هو حال كلّ سيّاف

216
00:15:57,410 --> 00:16:00,310
،ولكن إن ورث كنشين التّقنية السّرّيّة الأقوى

217
00:16:00,600 --> 00:16:03,510
فعلى الأرجح أنّه قد يصير قادرًا
،على هزيمة جماعة شيشيو

218
00:16:03,830 --> 00:16:09,290
لكنّه يخاطر بخسارة المعركة ضدّ
الهيتوكيري الّذي دفنه عميقًا في داخله

219
00:16:09,420 --> 00:16:10,990
.لوقت طويل

220
00:16:11,380 --> 00:16:12,840
....وذلك هو

221
00:16:13,490 --> 00:16:14,330
.ما يُقلقني

222
00:16:19,460 --> 00:16:20,600
...كنشين

223
00:16:36,280 --> 00:16:38,720
هل انتهت قيلولتك؟

224
00:16:41,700 --> 00:16:44,830
ثمّة العديد من النّاس في انتظار عودتك

225
00:16:44,980 --> 00:16:46,520
.على أحرّ من الجمر

226
00:16:47,330 --> 00:16:49,020
،بدل إضاعة وقتك هنا

227
00:16:49,300 --> 00:16:51,480
.انزل إلى المدينة بسرعة

228
00:16:52,200 --> 00:16:54,450
!مـ... معلّمي

229
00:17:05,210 --> 00:17:07,130
.لا تقترب من معلّمك فجأة هكذا

230
00:17:08,410 --> 00:17:12,420
.لكنّي ممتنّ لهذا... لقد أدّى الدّواء مفعوله

231
00:17:13,640 --> 00:17:15,320
هل تقصد هذا المسحوق؟

232
00:17:15,560 --> 00:17:19,550
.إنّه مجرّد مزيج أعددتُه بنفسي بشكل عشوائيّ

233
00:17:19,700 --> 00:17:20,930
ماذا؟

234
00:17:22,120 --> 00:17:23,250
،في تلك الحالة

235
00:17:23,680 --> 00:17:25,520
كيف شفيت؟

236
00:17:26,180 --> 00:17:27,850
،إن كان عليّ أن أدين بذلك لأيّ شيء

237
00:17:28,360 --> 00:17:29,770
.فسيكون لهذا السّيف

238
00:17:30,530 --> 00:17:32,690
ساكاباتو شين-أوتشي؟

239
00:17:33,080 --> 00:17:34,190
.أمعن النّظر

240
00:17:34,750 --> 00:17:40,700
،لقد خرج الوتد المثبّت
.وبالكاد بإمكانه تثبيت النّصل

241
00:17:41,010 --> 00:17:44,660
لذلك السّبب ضعفت قوّة
وميض التّنّين الطّائر المقدّس

242
00:17:44,800 --> 00:17:48,670
لأنّه تمّ امتصاصها قليلاً
.من طرف السّيف بحدّ ذاته

243
00:17:49,020 --> 00:17:53,560
.إنّه سلاح جيّد يفهم ما يشعر به حامله

244
00:17:57,630 --> 00:17:59,200
...شاكّو-دونو

245
00:18:00,100 --> 00:18:03,760
،حسنًا، كلّ هذا نتيجة لعبقريّتي بشكل أساسيّ

246
00:18:03,880 --> 00:18:07,440
درّبتُك بشكل مثاليّ جعل سيفك
.يرتقي لمستويات أعلى

247
00:18:09,480 --> 00:18:11,540
،لم يكن الأمر سهلاً إطلاقًا

248
00:18:11,690 --> 00:18:14,100
.لكنّ تعليمك للتّقنية السّرّيّة الأقوى انتهى

249
00:18:16,500 --> 00:18:18,470
،كما رأيتَ للتّوّ

250
00:18:18,640 --> 00:18:21,790
تمنح تقنية وميض التّنّين الطّائر
،المقدّس قوّة تدميريّة ملحوظة

251
00:18:21,930 --> 00:18:24,330
.حتّى إن نُفّذت بواسطة نصل معكوس

252
00:18:24,680 --> 00:18:28,240
بدءًا من الآن، سيكون منوطًا بك كروروني

253
00:18:28,380 --> 00:18:30,050
أن تجعل التّقنية أكثر مثاليّة

254
00:18:30,190 --> 00:18:34,210
.عن طريق تعديل قوّتها وسرعتها كما ترغب

255
00:18:35,200 --> 00:18:36,090
.عُلم

256
00:18:38,540 --> 00:18:39,600
.ممتاز

257
00:18:40,810 --> 00:18:42,580
.حسنًا، كفانا إضاعة للوقت

258
00:18:42,720 --> 00:18:46,980
.انزل الجبل للانضمام لأولئك الّذين ينتظرونك

259
00:18:47,600 --> 00:18:48,480
.عُلم

260
00:18:51,410 --> 00:18:54,300
.حسنًا يا معلّمي، شكرًا على كلّ شيء

261
00:18:55,300 --> 00:18:56,280
.انتظر

262
00:18:58,960 --> 00:19:01,640
،تمّ توارث هذه العباءة من جيل لآخر

263
00:19:01,980 --> 00:19:06,950
.وهي علامة على معلّم أسلوب هيتن ميتسوروغي

264
00:19:07,360 --> 00:19:08,470
.خذها

265
00:19:09,270 --> 00:19:11,500
.أنت تستحقّها الآن

266
00:19:16,330 --> 00:19:17,920
.شكرًا لك، لكنّها لن تناسبني

267
00:19:18,070 --> 00:19:19,300
!أيّها الولد

268
00:19:19,460 --> 00:19:20,510
،معلّمي

269
00:19:20,950 --> 00:19:23,040
،مع أنّي تعلّمت التّقنية السّرّيّة الأقوى

270
00:19:23,240 --> 00:19:26,040
لا أنوي أن أرث اسم هيكو سيجورو

271
00:19:26,200 --> 00:19:29,120
.وأصير حامله الرّابع عشر

272
00:19:29,550 --> 00:19:31,110
...ورثت فقط

273
00:19:31,470 --> 00:19:34,230
.مبادئ أسلوب هيتن ميتسوروغي

274
00:19:35,020 --> 00:19:38,150
.توقّعتُ تفانيًا أكثر منك

275
00:19:41,130 --> 00:19:45,650
.مع أنّ أنانيّتك ليست أمرًا جديدًا

276
00:19:46,320 --> 00:19:48,330
.لديّ طلب آخر

277
00:19:48,760 --> 00:19:49,960
...أيمكنك خلال قتالي

278
00:19:50,370 --> 00:19:52,860
،ضدّ جماعة شيشيو

279
00:19:53,010 --> 00:19:55,660
أن تحمي أصدقائي في أوُيْيا؟

280
00:20:01,590 --> 00:20:04,310
.لا تستغلّ لُطفي

281
00:20:05,720 --> 00:20:09,170
،إن كنتَ لا تريد أن تخلفني

282
00:20:09,320 --> 00:20:12,000
.فما عدتَ تلميذي

283
00:20:12,150 --> 00:20:15,090
.تظاهر بأنّي لم أكن معلّمك أبدًا

284
00:20:15,240 --> 00:20:16,340
!معلّمي

285
00:20:18,440 --> 00:20:19,460
...ولكن

286
00:20:21,100 --> 00:20:24,100
أنا لم أعلّمك أسلوب هيتن ميتسوروغي

287
00:20:24,530 --> 00:20:28,080
.لأجعلك تعاني، فتذكّر ذلك جيّدًا

288
00:20:31,170 --> 00:20:33,420
.ليس عليك أن تقلق كثيرًا

289
00:20:33,860 --> 00:20:36,740
.أسرع واهزم شيشيو

290
00:20:37,760 --> 00:20:39,060
...معلّمي

291
00:20:42,410 --> 00:20:44,440
ما اسمك يا فتى؟

292
00:20:44,980 --> 00:20:46,220
شينتا؟

293
00:20:46,960 --> 00:20:50,600
.إنّه اسم ليّن جدًّا ليحمله سيّاف

294
00:20:51,500 --> 00:20:53,110
،بدءًا من اليوم

295
00:20:53,480 --> 00:20:55,230
.سيصير اسمك كنشين

296
00:20:57,530 --> 00:21:01,400
.سأعلّمك ما أعرف، ستصير وريثي

297
00:22:46,170 --> 00:22:49,580
."في الحلقة القادمة: "هدف آخر