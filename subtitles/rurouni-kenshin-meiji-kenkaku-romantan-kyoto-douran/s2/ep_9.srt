1
00:00:04,980 --> 00:00:08,440
!آخر نماذج سيوف شاكّو المميّزة القاتلة

2
00:00:08,440 --> 00:00:10,230
!كن حذرًا يا هيمورا

3
00:00:11,690 --> 00:00:14,150
!إنّه لا يزال يحمل سيفًا

4
00:00:14,860 --> 00:00:16,910
.لنبدأ

5
00:00:22,450 --> 00:00:25,370
!ما رأيك؟ هذا السّيف هو الأعزّ عندي

6
00:00:25,920 --> 00:00:27,080
...السّيف القاتل المميّز

7
00:00:27,380 --> 00:00:28,790
!نصل هاكوجين

8
00:00:29,670 --> 00:00:30,500
!إنّه طويل

9
00:00:30,500 --> 00:00:32,130
!إضافة لكونه مرنًا جدًّا –
!هيمورا –

10
00:00:34,260 --> 00:00:37,220
...كلاّ! إن تفاديت ذلك بهامش ضئيل جدًّا

11
00:02:14,980 --> 00:02:18,990
الحلقة الثّالثة والثّلاثين
استلال السّيف المحرّم

12
00:02:24,080 --> 00:02:25,950
.ما كنتُ أهدف إليه تمامًا

13
00:02:26,540 --> 00:02:29,620
.ما عاد بإمكانك الآن التّحرّك بحرّيّة

14
00:02:32,130 --> 00:02:35,300
...السّيف القاتل المميّز، نصل هاكوجين

15
00:02:35,880 --> 00:02:41,590
إنّه سيف دُقَّ بشكل رفيع قدر الإمكان
.مع الحفاظ على شدّة النّصل

16
00:02:41,590 --> 00:02:45,010
.بدا وكأنّه قادر على التّحكّم به كما يشاء

17
00:02:45,560 --> 00:02:48,180
،إنّ بجعل رأس النّصل ثقيلاً بعض الشّيء

18
00:02:48,180 --> 00:02:50,640
يصير بالإمكان نقل حركات المعصم المفاجئة

19
00:02:50,640 --> 00:02:53,860
.مباشرة إلى مسار النّصل للتّحكّم فيها

20
00:02:54,360 --> 00:02:59,320
وبعد إصابة ساقه، صار تفادي تحرّكات نصل
...هاكوجين المتغيّرة بالكامل مستحيلاً

21
00:02:59,820 --> 00:03:03,410
.حصلتُ على جمهور مزعج دون أن أدرك ذلك

22
00:03:03,410 --> 00:03:06,040
.لننتقل إذًا إلى ذروة الأحداث

23
00:03:08,290 --> 00:03:09,960
."أسلوبي "الأفعى الضّخمة

24
00:03:10,580 --> 00:03:12,170
!إليك هذا

25
00:03:20,510 --> 00:03:22,180
!أنا متفاجئ من أنّك صددته

26
00:03:22,180 --> 00:03:24,760
!لكنّي لم أنتهِ بعد

27
00:03:29,390 --> 00:03:30,230
!هيمورا

28
00:03:36,940 --> 00:03:38,440
.الوضع ميؤوس منه بالفعل

29
00:03:38,940 --> 00:03:40,650
.لا فرصة لديك للفوز

30
00:03:41,280 --> 00:03:42,910
...إن لم أفعل أيّ شيء

31
00:03:47,580 --> 00:03:48,580
يا عزيزي؟

32
00:03:50,000 --> 00:03:51,790
.عليّ التّخلّي عن سيف والدي

33
00:03:52,250 --> 00:03:54,380
علينا الآن إنقاذ إيوري

34
00:03:54,380 --> 00:03:57,380
والابتعاد عن حمّام الدّماء
.هذا قدر الإمكان

35
00:03:57,840 --> 00:03:59,340
ذلك الرّجل الّذي يتكلّم بلهجة أوساكا

36
00:03:59,340 --> 00:04:01,380
.يركّز في قتاله ضدّ ذلك الرّجل

37
00:04:02,010 --> 00:04:03,340
...ذلك

38
00:04:02,010 --> 00:04:04,300
.يمكنني انتهاز هذه الفرصة لإنقاذ إيوري

39
00:04:04,300 --> 00:04:06,510
ستجعل من هيمورا طُعمًا؟

40
00:04:06,510 --> 00:04:09,470
كان مدركًا تمامًا أنّه لا يستطيع
،القتال بسيف مكسور

41
00:04:09,470 --> 00:04:12,690
ومع ذلك أتى هيمورا إلى هنا
!أسرع من أيّ منّا

42
00:04:13,690 --> 00:04:17,190
.لم أطلب منه ذلك

43
00:04:17,820 --> 00:04:19,780
.إنّه يقاتل بمحض اختياره

44
00:04:22,820 --> 00:04:24,200
.سيكو-سان

45
00:04:24,700 --> 00:04:27,410
،أنا وليّ أمرها قبل كلّ شيء

46
00:04:27,410 --> 00:04:31,660
أفهم تمامًا ما يعنيه أن تضع ابنك
...قبل كلّ شيء. ولكن

47
00:04:32,000 --> 00:04:36,540
ما الّذي يحاول هيمورا-كُن حمايته
عن طريق القتال بمحض اختياره؟

48
00:04:36,540 --> 00:04:39,380
هل يمكنك فهم ذلك أيضًا؟

49
00:04:45,840 --> 00:04:49,430
.حسنًا. سأكون أكثر كرمًا

50
00:04:49,640 --> 00:04:52,180
!سأريك تقنية عظيمة أخرى

51
00:04:52,560 --> 00:04:54,770
!"أسلوبي "الالتفاف

52
00:05:01,360 --> 00:05:03,570
!"أسلوبي "النّاب السّامّ

53
00:05:09,830 --> 00:05:10,620
...ما

54
00:05:11,620 --> 00:05:13,580
إنّك لا تعرف ما الاستسلام، صحيح؟

55
00:05:14,370 --> 00:05:17,540
.من المثير للشّفقة النّظر إليك

56
00:05:23,050 --> 00:05:26,720
.إنّ هاتين العينين تغضبانني بشدّة

57
00:05:27,680 --> 00:05:29,970
أنت تدرك الوضع، صحيح؟

58
00:05:29,970 --> 00:05:32,470
.أنت محاصر بالكامل

59
00:05:33,060 --> 00:05:37,440
هذا ليس وقتًا مناسبًا لوضع
.حياتك على المحكّ لأجل شقيّ صغير

60
00:05:38,940 --> 00:05:44,740
في الماضي، قتلتُ العديد من
.الرّجال لتحقيق حقبة جديدة

61
00:05:45,030 --> 00:05:47,860
ماذا؟ أتحاول التّفاخر؟

62
00:05:48,070 --> 00:05:53,410
لا بأس. التّشبّث بإنجازات الماضي
.في هذه المرحلة مثير جدًّا للشّفقة

63
00:05:53,410 --> 00:05:55,080
.لا يوجد ما هو أفضل من هذا

64
00:05:55,790 --> 00:05:59,290
بعد معارك مميتة وإراقة دماء
،لا يمكن التّكفير عنها

65
00:05:59,290 --> 00:06:02,090
فقد مرّت عشر سنوات منذ
.دخولنا حقبة جديدة حتّى الآن

66
00:06:02,590 --> 00:06:05,130
وبدون معرفة المعارك المميتة
،وإراقة الدّماء

67
00:06:05,130 --> 00:06:08,680
بدأت تظهر على هذه الحقبة علامات
السّلام حيث يمكن للأطفال

68
00:06:08,680 --> 00:06:11,640
.أن يكبروا بصحّة جيّدة في منازل مُحِبّة وعطوفة

69
00:06:12,810 --> 00:06:15,520
.قد يكون مجرّد شقيّ صغير في نظرك

70
00:06:15,520 --> 00:06:19,190
ولكن في نظري، إنّه نعمة لا غنى
.عنها في هذا العصر الجديد

71
00:06:20,060 --> 00:06:25,230
سأعيد إيوري إلى سيكو وزوجته
.سالمًا وإن قتلني ذلك

72
00:06:31,120 --> 00:06:36,200
.سأحرص على أن يُبقي انتباهه عليّ
!أسرعوا وخذوا إيوري الآن

73
00:06:42,460 --> 00:06:43,290
عزيزي؟

74
00:06:44,340 --> 00:06:47,760
ماذا؟ تتظاهر أنّك بطل عدالة؟

75
00:06:48,550 --> 00:06:51,220
.إنّ ذلك يجعلني أبدو كشرّير

76
00:06:51,220 --> 00:06:53,350
.وذلك يغضبني أكثر

77
00:06:54,890 --> 00:06:55,970
.يكفي

78
00:06:56,560 --> 00:06:59,190
.انتهى دورك هنا الآن

79
00:07:00,230 --> 00:07:02,940
،بدءًا من الآن، تحت راية شيشيو-ساما

80
00:07:02,940 --> 00:07:07,610
سيخلق نصل هاكوجين هذا
.حقبة جديدة أخرى

81
00:07:07,610 --> 00:07:10,070
.يمكنك الموت مطمئنًّا

82
00:07:10,070 --> 00:07:13,950
يؤسفني قول هذا، لكنّ ذلك
.غير ممكن بالنّسبة لك

83
00:07:14,740 --> 00:07:17,040
.لا تُولد الحقب الجديدة بالسّيوف

84
00:07:17,040 --> 00:07:19,660
.بل تُولد على أيدي الأشخاص الّذين يحملونها

85
00:07:27,920 --> 00:07:28,760
!يا عزيزي

86
00:07:28,760 --> 00:07:32,680
!إنّه يحاول فعلاً استعمال هيمورا كطُعم

87
00:07:32,840 --> 00:07:34,760
!انتظرني يا إيوري

88
00:07:34,760 --> 00:07:36,180
.سأحرص على إنقاذك

89
00:07:36,180 --> 00:07:38,220
!تماسك قليلاً فحسب

90
00:07:38,220 --> 00:07:41,020
ما الّذي يفعله الجمهور بصعوده
على الخشبة بدون إذن؟

91
00:07:41,020 --> 00:07:41,890
!انتبه

92
00:07:47,270 --> 00:07:50,740
!إنّك تغضبني بشدّة بالفعل

93
00:07:51,200 --> 00:07:52,200
!سيكو-دونو

94
00:07:53,950 --> 00:07:55,570
.سأراهن على هذا الرّجل

95
00:07:55,990 --> 00:07:58,120
!قد أستطيع أن أعهد له بها

96
00:07:58,120 --> 00:07:59,450
...هذه الحقبة المسالمة الجديدة

97
00:08:00,040 --> 00:08:01,330
!الّتي سيحميها بكلّ تأكيد

98
00:08:02,370 --> 00:08:05,250
واثق أنّ هذا الرّجل سيستعمل
!سيف والدي خير استعمال

99
00:08:07,170 --> 00:08:10,590
".السّيوف الّتي أدقّها ستخلق حقبة جديدة"

100
00:08:11,170 --> 00:08:16,510
لم أحبّ أبدًا تلك الكلمات
.الّتي كان أبي يردّدها

101
00:08:17,510 --> 00:08:19,520
.فهمتُ أخيرًا معناها

102
00:08:20,140 --> 00:08:23,940
هذا صحيح. من الوقاحة أن نقول
.أنّ السّيوف تخلق حقبًا جديدة

103
00:08:24,440 --> 00:08:26,980
،إنّ النّاس هم من يخلقون الحقب الجديدة

104
00:08:26,980 --> 00:08:31,150
.والحقب الّتي تأسّست يحميها النّاس أيضًا

105
00:08:31,780 --> 00:08:36,200
ولحماية هذا السّلام، يواصل
...ذلك الرّجل القتال في الخفاء

106
00:08:36,700 --> 00:08:38,620
...لذلك فإنّ أخر سيوف أبي

107
00:08:40,870 --> 00:08:44,460
!لن أتهاون بعد الآن! لقد أغضبتني

108
00:08:44,460 --> 00:08:46,500
!انظر إلى رأسي

109
00:08:46,500 --> 00:08:49,090
!لقد انتصب شعري بسبب الغضب

110
00:08:49,550 --> 00:08:53,300
تقصد شعر المكنسة ذاك؟
.أظنّه كان كذلك دائمًا

111
00:08:53,670 --> 00:08:54,800
!نعم، نعم

112
00:08:55,050 --> 00:08:56,800
.مكنسة. مكنسة

113
00:08:57,050 --> 00:09:00,760
لا تردّ على مزحة شخص آخر بوجه
!جادّ كهذا أيّها المغفّل

114
00:09:01,100 --> 00:09:03,680
!إنّك مزعج لأبعد الحدود

115
00:09:08,480 --> 00:09:10,610
.اعترَضه بما بقي من غمده

116
00:09:12,070 --> 00:09:14,950
!سُحقًا! اقتربتُ منه كثيرًا وصرت في مرماه

117
00:09:28,330 --> 00:09:31,550
!أجل! ضربة مضادّة بكوعه

118
00:09:31,550 --> 00:09:36,680
استفزّه ليغريه بالاقتراب بما يكفي
...ليستطيع الهجوم بقفزة واحدة

119
00:09:37,220 --> 00:09:43,140
،بدون سيف وبساق يُمنى مصابة
.كان ذلك الهجوم ملاذ هيمورا-كُن الأخير

120
00:09:43,600 --> 00:09:46,060
...إن لم يُنهِ بذلك الأمر

121
00:09:49,100 --> 00:09:51,610
.كان ذلك وشيكًا، وشيكًا بالفعل

122
00:09:51,610 --> 00:09:55,360
.لقد استهنتُ بك بالفعل

123
00:09:56,740 --> 00:09:57,740
.هذا سيّئ

124
00:09:58,280 --> 00:10:03,200
إنّ ذلك الهجوم ساعدني فعلاً
.على إنزال الدّماء من رأسي

125
00:10:03,700 --> 00:10:07,460
.لن أقترب ولو شبرًا من مرماك ثانية

126
00:10:07,460 --> 00:10:12,170
سأقطّعك لأشلاء من بعيد
.وسأرميها في نهر شيجوغاوارا

127
00:10:13,090 --> 00:10:16,010
.لم تعد لديه الآن فرصة للنّصر

128
00:10:16,010 --> 00:10:19,840
كلّ ما يمكن التّفكير فيه الآن هو كيفية
.الهرب من هذه الأزمة دون فقدان أيّ أحد

129
00:10:20,590 --> 00:10:22,390
...ليت كان لديه سيف

130
00:10:24,220 --> 00:10:25,270
!هيمورا-سان

131
00:10:29,940 --> 00:10:31,770
!هذا سيف والدي الأخير

132
00:10:32,480 --> 00:10:34,150
!استعمله رجاءً

133
00:10:35,990 --> 00:10:38,990
روروني كنشين
—اضطرابات كيوتو—

134
00:10:49,160 --> 00:10:50,080
!هيمورا

135
00:10:50,290 --> 00:10:54,550
.جعلني أتدحرج للوراء، لذلك أخّر ذلك بدايتي

136
00:10:55,420 --> 00:10:56,960
.لا يهمّ

137
00:10:57,720 --> 00:11:01,800
.هزيمتك والحصول على السّيف الأخير

138
00:11:01,800 --> 00:11:06,390
.صار كِلا الهدفين هدفًا واحدًا الآن

139
00:11:07,930 --> 00:11:09,230
.سُحقًا

140
00:11:09,690 --> 00:11:12,440
.علينا تسوية الأمر بسرعة

141
00:11:12,650 --> 00:11:15,110
.يملك كلانا سيفًا حقيقيًّا

142
00:11:15,110 --> 00:11:16,900
.إمّا أن نقتُل أو نُقتل

143
00:11:16,900 --> 00:11:18,900
يسهل فهم هذا، صحيح؟

144
00:11:19,150 --> 00:11:20,490
!انطلق يا هيمورا

145
00:11:20,490 --> 00:11:22,870
!النّصر لك بما أنّ لديك سيفًا الآن

146
00:11:25,490 --> 00:11:29,410
.كلاّ. لن يقوم هيمورا-كُن باستلال ذلك السّيف

147
00:11:30,410 --> 00:11:33,000
.بل على الأرجح أنّه لا يستطيع

148
00:11:33,290 --> 00:11:36,800
،بما أنّه أقسم ألاّ يقتل

149
00:11:36,800 --> 00:11:40,760
فإنّ استلال أيّ سيف ليس سيفَ
.ساكاباتو سيكون محرّمًا بالكامل عليه

150
00:11:41,050 --> 00:11:44,090
لكنّ هذا ليس الوقت لذلك الآن، صحيح؟

151
00:11:44,350 --> 00:11:46,470
!إن لم يقتُل، فسيُقتل

152
00:11:46,470 --> 00:11:49,350
،لا أدري أيّ نوع من الهيتوكيري كان هيمورا

153
00:11:49,350 --> 00:11:50,640
—لكنّ قتل شخص آخر ليس

154
00:11:50,640 --> 00:11:53,150
."المشكلة ليست في قتل "شخص آخر

155
00:11:53,150 --> 00:11:56,440
.ظهر عدوّ قويّ من جماعة شيشيو

156
00:11:56,440 --> 00:12:00,690
،إنّ قلبه يشبه ميزانًا الآن

157
00:12:00,690 --> 00:12:05,490
وهو يتأرجح بين روروني يرفض
.القتل وهيتوكيري باتّوساي

158
00:12:06,910 --> 00:12:10,330
هيتوكيري باتّوساي؟

159
00:12:10,330 --> 00:12:12,250
...السّيّاف الأسطوريّ

160
00:12:12,830 --> 00:12:16,250
،إن استلّ ذلك السّيف الآن للقتل

161
00:12:16,250 --> 00:12:18,420
.فسيفقد القيود الّذي وضعها على قلبه

162
00:12:18,420 --> 00:12:22,050
وبعد ذلك، فسيعود مباشرة
.للسّير على طريق الهيتوكيري المدمّر

163
00:12:23,930 --> 00:12:27,470
.لن يستطيع أبدًا العودة ليكون روروني ثانية

164
00:12:28,600 --> 00:12:32,060
ليت غمد ذلك السّيف لم يكن
،خشبًا عاديًّا وهشًّا

165
00:12:32,060 --> 00:12:35,600
...وكان معدنًا مثل السّاكاباتو

166
00:12:36,310 --> 00:12:39,070
أنت هو الهيتوكيري باتّوساي؟

167
00:12:39,570 --> 00:12:43,490
لماذا تتردّد كثيرًا لقتل شخص آخر؟

168
00:12:44,860 --> 00:12:49,990
لا بأس. إن كنت تقول
،أنّك نسيت فرحة قتل رجل

169
00:12:49,990 --> 00:12:52,500
.فسأجعلك تتذكّرها الآن

170
00:12:54,250 --> 00:12:56,460
.عن طريق عرض مباشر

171
00:12:57,590 --> 00:12:58,460
!إيوري

172
00:12:58,670 --> 00:13:03,090
سأقطّع هذا الشّقيّ الّذي وصفتَه
!بنعمة السّلام من قبل لأشلاء

173
00:13:06,510 --> 00:13:08,300
!وقعت في فخّي أيّها الغبيّ

174
00:13:08,300 --> 00:13:10,350
!كلاّ! كان يستفزّك فحسب

175
00:13:10,350 --> 00:13:14,060
!سأردّ لك الصّاع صاعين على سخريتك منّي

176
00:13:20,230 --> 00:13:21,440
!نلت منك

177
00:13:21,440 --> 00:13:24,610
.بإمكان رأس نصل هاكوجين الذّهاب لأيّ مكان

178
00:13:25,280 --> 00:13:27,240
!سأطعنك من الخلف

179
00:13:34,660 --> 00:13:37,290
ما كانت ردّة الفعل الخارقة
لقدرات البشر تلك؟

180
00:13:37,290 --> 00:13:39,960
.إنّه شخص مختلف تمامًا عمّا كان عليه قبل قليل

181
00:13:40,340 --> 00:13:41,920
...أسلوب هيتن ميتسوروغي

182
00:13:43,130 --> 00:13:45,340
!وميض التّنّين الملتفّ: دوّامة الشّعر

183
00:13:45,880 --> 00:13:46,720
!هيمورا

184
00:14:01,570 --> 00:14:02,980
.لقد فعلها

185
00:14:15,540 --> 00:14:17,620
...هل قتل

186
00:14:31,550 --> 00:14:32,560
.هيمورا

187
00:14:34,060 --> 00:14:35,600
...أنا

188
00:14:39,600 --> 00:14:41,480
...ذلك السّيف

189
00:14:42,980 --> 00:14:44,400
!ساكاباتو

190
00:14:47,990 --> 00:14:51,700
ماذا؟! السّيف الأخير لأراي شاكّو

191
00:14:51,700 --> 00:14:54,580
!كان ساكاباتو مثل الّذي أعطاه لهيمورا-كُن

192
00:14:55,040 --> 00:15:01,130
لا، هذا... يبدو أنّه يناسب يدي
.أكثر بقليل من السّيف السّابق

193
00:15:01,750 --> 00:15:04,880
...لكن إن كان سيفَ ساكاباتو

194
00:15:09,630 --> 00:15:11,300
!فإنّه حيّ يا هيمورا

195
00:15:11,300 --> 00:15:13,760
!لم تخلف وعدك بعدم القتل

196
00:15:13,760 --> 00:15:15,220
.فهمت

197
00:15:16,220 --> 00:15:21,730
فهمت بالكامل الآن لماذا يودّ
شيشيو-ساما تولّي أمرك

198
00:15:21,730 --> 00:15:25,980
على الرّغم من هدفه الكبير
.بالسّيطرة على البلاد

199
00:15:26,320 --> 00:15:29,360
.لكن لا تغترّ بذلك

200
00:15:29,360 --> 00:15:34,240
ثمّة عشرة سيّافين آخرين
.في وحدة السّيوف العشرة الخاصّة

201
00:15:34,700 --> 00:15:36,580
،واثنان منهم

202
00:15:36,580 --> 00:15:41,080
سوجيرو الّذي سبق وقاتلتَه

203
00:15:41,080 --> 00:15:44,040
،وأوسوي-سان القادم إلى هنا من ريوكيو

204
00:15:44,040 --> 00:15:46,210
.وهما أفضل منك بكثير

205
00:15:46,550 --> 00:15:50,720
!لن تتمكّن أبدًا من الوصول إلى شيشيو-ساما

206
00:15:50,720 --> 00:15:53,220
فكّر مليًّا في ضعفك

207
00:15:53,220 --> 00:15:56,970
وراقب بصمت شيشيو-ساما
!وهو يسيطر على البلاد

208
00:15:58,520 --> 00:15:59,560
.يا جدّي

209
00:16:00,100 --> 00:16:01,060
.حاضر

210
00:16:01,310 --> 00:16:02,810
!الحُكم

211
00:16:05,610 --> 00:16:07,360
ماذا سنفعل به؟

212
00:16:07,360 --> 00:16:11,650
سؤال وجيه. أودّ سحب الكثير
،من المعلومات منه

213
00:16:11,650 --> 00:16:13,110
.لذلك سنأخذه إلى أوُيْيا

214
00:16:13,410 --> 00:16:16,370
.لا، علينا تسليمه للشّرطة

215
00:16:16,910 --> 00:16:19,440
،لستُ واثقًا أنّه وصل إلى كيوتو بعد

216
00:16:19,450 --> 00:16:23,710
لكن ثمّة رجل من الشّرطة يملك السّلطة
.لفعل أيّ شيء بخصوص جماعة شيشيو

217
00:16:24,080 --> 00:16:26,040
.ذلك هو الطّريق الأكثر أمانًا

218
00:16:26,040 --> 00:16:27,460
...ذلك الرّجل

219
00:16:27,960 --> 00:16:30,460
.إن كانت هذه رغبتك يا هيمورا-كُن

220
00:16:31,420 --> 00:16:33,130
ساكاباتو؟

221
00:16:33,840 --> 00:16:36,180
آخر سيوف أبي؟

222
00:16:36,970 --> 00:16:42,560
لا أفهم. لم ينفكّ أبي عن صنع
...سيوف قاتلة، فلماذا

223
00:16:48,730 --> 00:16:49,860
...ذلك السّيف

224
00:16:50,900 --> 00:16:51,740
ينكسر؟

225
00:16:52,190 --> 00:16:56,570
لم يستطع الغمد الخشبيّ العاديّ
.احتواء تقنية هيمورا-كُن

226
00:17:03,500 --> 00:17:06,920
.لا بأس. لم يتضرّر النّصل بحدّ ذاته

227
00:17:10,050 --> 00:17:11,210
...هذا

228
00:17:19,640 --> 00:17:24,100
صنعتُ من المعدنِ أنصالاً لشهور"
.وسنوات كأنّي أقطع نفسي

229
00:17:23,770 --> 00:17:28,810
"مطعم أوُيْيا"

230
00:17:24,100 --> 00:17:28,810
،حتّى إن كرهني ابني
".فذلك من أجل زمن حفيدي

231
00:17:30,110 --> 00:17:35,780
،استمرّ في صنع أنصال لسنوات
.وهو يشعر وكأنّه يقطّع نفسه

232
00:17:35,950 --> 00:17:39,910
،وحتّى إن عنى ذلك أن يكرهه ابنه

233
00:17:39,910 --> 00:17:42,910
قام بالأمر للجيل التّالي
.الّذي سيكبر فيه حفيده

234
00:17:43,660 --> 00:17:49,210
على الأرجح أنّ شاكّو نقش ذلك
.كقصيدة وداعه

235
00:17:49,670 --> 00:17:52,420
إذًا فقد أدرك أبي في منتصف طريقه

236
00:17:52,420 --> 00:17:56,970
أنّ فخره وحده من كان يقول
.أنّ السّيوف تخلق حقبًا جديدة

237
00:17:57,590 --> 00:18:01,310
لكنّ ذلك الوقت كان في منتصف
.اضطرابات باكوماتسو

238
00:18:01,310 --> 00:18:04,730
وكان فوضويًّا جدًّا لدرجة
أنّه لم يستطع التّوقّف

239
00:18:04,730 --> 00:18:06,940
.أو أن يتريّث بما يكفي ليتألّم

240
00:18:07,350 --> 00:18:09,770
،وكحدّاد سيوف يعيش في حقبة باكوماتسو

241
00:18:09,770 --> 00:18:12,070
.استمرّ أبي في التّقدّم للأمام

242
00:18:12,070 --> 00:18:15,990
كان الشّيء الوحيد الّذي بإمكانه فعله
،هو مواصلة صنع سيوف قاتلة

243
00:18:15,990 --> 00:18:18,740
.وكلّه أمل بأنّ حقبة مسالمة ستحلّ قريبًا

244
00:18:19,700 --> 00:18:22,620
،كان عليه أن يعيش ما بدا كحياة ساخرة

245
00:18:22,620 --> 00:18:26,290
.تُعارض تمامًا ما كان يشعر به

246
00:18:27,410 --> 00:18:33,590
ترك والدي خلفه، إلى جانب صلوات
،النّدم العميق والأمل الخافت

247
00:18:33,590 --> 00:18:37,380
.سيفه السّاكاباتو المقدّس شين-أوتشي

248
00:18:38,220 --> 00:18:39,550
شين-أوتشي؟

249
00:18:39,550 --> 00:18:40,390
.نعم

250
00:18:41,260 --> 00:18:45,600
،عند دقّ سيف مقدّس
،من العادة ألاّ يُصنع واحد فقط

251
00:18:45,600 --> 00:18:48,060
.بل اثنين أو أكثر من ذلك

252
00:18:48,640 --> 00:18:54,150
أمّا السّيف الّذي دُقَّ بشكل جيّد
،يُسمّى شين-أوتشي ويُقدّم للآلهة

253
00:18:54,150 --> 00:18:58,490
،بينما البقيّة تُسمّى كاغي-أوتشي
.وإمّا أن تُخزّن أو تُوزّع

254
00:19:00,530 --> 00:19:05,080
مفهوم. إذًا فقد كان هنالك
.اثنان من السّاكاباتو

255
00:19:05,290 --> 00:19:07,370
،وهذا هو الشّين-أوتشي

256
00:19:07,370 --> 00:19:10,670
!أي السّاكاباتو الأفضل من السّاكاباتو السّابق

257
00:19:11,460 --> 00:19:13,880
.أرجو أن تقبله يا هيمورا-سان

258
00:19:14,380 --> 00:19:17,300
.أنا واثق أنّ ذلك ما كانت يأمله أبي

259
00:19:22,180 --> 00:19:25,430
.سمعتُ أنّك ستترك المناصرين يا هيمورا

260
00:19:29,440 --> 00:19:32,940
.لقد حقّقنا النّصر للتّوّ في توبا-فوشيمي

261
00:19:33,610 --> 00:19:36,150
.بدأ القتال للتّوّ فحسب

262
00:19:36,650 --> 00:19:38,990
.إنّ الإصلاح الإمبراطوريّ لم يحدث بعد

263
00:19:38,990 --> 00:19:40,780
.هذا تصرّف أنانيّ منك

264
00:19:41,410 --> 00:19:45,990
وفوق ذلك، إلى أين تعتقد
أنّك ذاهب بدون سيفك؟

265
00:19:47,080 --> 00:19:50,960
حصلتُ على العفو من كاتسورا-سينسي
.يا شاكّو-دونو

266
00:19:51,620 --> 00:19:54,130
...بدءًا من الآن، لن أقتل أيّ رجل

267
00:19:54,630 --> 00:19:58,510
وسأبحث عن طريق لحماية النّاس الّذين
.يعيشون في الحقبة الجديدة وأسير عليه

268
00:20:00,220 --> 00:20:05,220
،إن وُجدر طريق كهذا
.أحبّ أيضًا أن أعرف به

269
00:20:05,680 --> 00:20:10,730
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

270
00:20:12,390 --> 00:20:14,690
.عش بالسّيف، ومت بالسّيف

271
00:20:15,190 --> 00:20:18,360
.لا يجدر أن يوجد طريق آخر لك

272
00:20:22,200 --> 00:20:23,530
.هديّة وداع

273
00:20:24,530 --> 00:20:29,330
إنّه محاولة فاشلة، لكنّه سيكون أكثر
.من كافٍ بالنّسبة لمن أنت عليه الآن

274
00:20:29,950 --> 00:20:33,000
وكبداية، حاول أن تكون سيّافًا
.وأنت تحمل ذلك على خصرك

275
00:20:33,580 --> 00:20:37,500
.واثق أنّك سترى بنفسك مدى سذاجتك الآن

276
00:20:38,590 --> 00:20:44,340
إن كنت لا تزال قادرًا على التّفوّه
...بمثل هذا الهراء عندما ينكسر

277
00:20:45,800 --> 00:20:49,640
.عد إلى كيوتو وزُرني مرّة أخرى

278
00:21:09,790 --> 00:21:13,790
"السّنة الرّابعة من حقبة كييو"
"ضواحي أوينو"

279
00:22:45,010 --> 00:22:50,010
الحلقة القادمة
هجوم السّاكاباتو الأوّل

280
00:22:45,970 --> 00:22:49,180
."في الحلقة القادمة: "هجوم السّاكاباتو الأوّل