1
00:00:04,940 --> 00:00:06,060
...هذا الشّرطيّ

2
00:00:06,650 --> 00:00:08,190
يعرف هيمورا؟

3
00:00:11,780 --> 00:00:12,700
!نسيت تمامًا! هيمورا

4
00:00:21,580 --> 00:00:22,660
.مذهل

5
00:00:23,080 --> 00:00:24,670
.لا يبدو عليه التّعب أبدًا

6
00:00:25,170 --> 00:00:28,630
أنت. لماذا تضيّع الوقت هنا؟

7
00:00:33,920 --> 00:00:35,010
.سايتو

8
00:00:40,060 --> 00:00:45,730
روروني كنشين
—اضطرابات كيوتو—

9
00:02:05,980 --> 00:02:09,980
:الحلقة الثّامنة والعشرون
صورة الطَّموح

10
00:02:11,860 --> 00:02:13,440
لماذا أنت هنا؟

11
00:02:13,440 --> 00:02:14,730
.للعمل

12
00:02:14,730 --> 00:02:19,660
تواصل معي أحد رجالي الّذين أرسلتُهم
.إلى هنا وقال أنّ شيشيو موجود هنا الآن

13
00:02:19,660 --> 00:02:22,580
ستحتاج القوّات العقابيّة لوقت
،قبل وصولها إلى كيوتو

14
00:02:22,870 --> 00:02:24,950
.لذلك قرّرت المجيء كلّ هذه المسافة

15
00:02:25,410 --> 00:02:29,250
.وبالطّبع ذلك الرّجل مفقود الآن

16
00:02:30,120 --> 00:02:33,880
هل يُعقل أنّ أخو إيجي كان
جاسوسًا لشرطة العاصمة؟

17
00:02:34,340 --> 00:02:35,340
إيجي؟

18
00:02:39,010 --> 00:02:43,760
فهمت. ينحدر ميشيما إيتشيرو
.من قرية شينغتسو هذه

19
00:02:44,350 --> 00:02:48,230
أرسلتُه مُعتقدًا أنّ بإمكانه التّسلّل
.بينهم دون جذب الشّبهات إليه

20
00:02:48,680 --> 00:02:50,640
.أعتقد أنّهم اكتشفوا من يكون

21
00:02:51,310 --> 00:02:53,980
.وأراد على الأقلّ أن يحمي عائلته

22
00:02:59,650 --> 00:03:00,910
.يا له من غبيّ

23
00:03:01,570 --> 00:03:04,240
.كان عليه انتظار وصولي

24
00:03:04,580 --> 00:03:05,580
!مهلاً لحظة

25
00:03:05,870 --> 00:03:08,790
هذه ليست الطّريقة المناسبة
!للحديث عن تابع مات سلفًا

26
00:03:09,290 --> 00:03:10,960
...أنت، من تكون

27
00:03:14,880 --> 00:03:16,130
فتاةُ ابن عرسٍ هذه؟

28
00:03:17,090 --> 00:03:19,090
!مت! سأقتلك

29
00:03:19,090 --> 00:03:20,380
.على مهلك

30
00:03:21,340 --> 00:03:23,010
.هذه هي طباعه فحسب

31
00:03:23,510 --> 00:03:24,350
...على أيّ حال

32
00:03:24,850 --> 00:03:26,930
.دعونا ننزلهما ونكرمهما بالدّفن

33
00:03:28,430 --> 00:03:29,480
.صحيح

34
00:03:30,810 --> 00:03:31,890
.مهلاً

35
00:03:35,940 --> 00:03:38,150
.لا يمكنكم إنزالهما

36
00:03:39,360 --> 00:03:43,530
...إن قمتم بإنزالهما وأثرتم غضب سنكاكو

37
00:03:43,820 --> 00:03:46,450
.فلن نستطيع نحن القرويّون قتاله

38
00:03:46,740 --> 00:03:49,370
.لذلك دعوهما كما هما

39
00:03:49,910 --> 00:03:51,160
ما الّذي تقوله؟

40
00:03:51,580 --> 00:03:53,540
ألستم من نفس القرية؟

41
00:03:53,540 --> 00:03:57,340
،حتّى إن كنتم تُعامَلون هكذا
ما زلتم ستنصاعون لسنكاكو؟

42
00:03:58,590 --> 00:04:00,800
.إن جابهنا سنكاكو، فسنموت

43
00:04:01,470 --> 00:04:05,390
.ولكن، إن لم نجابهه، فسنظلّ أحياء على الأقلّ

44
00:04:05,850 --> 00:04:10,390
.هذا من أجل صالح القرية
...أنتم الغرباء والفتى ميشيما

45
00:04:10,680 --> 00:04:13,640
.عليكم مغادرة القرية في الحال

46
00:04:14,400 --> 00:04:16,150
أفهمت يا إيجي؟

47
00:04:16,440 --> 00:04:17,270
—أيّها الـ

48
00:04:17,270 --> 00:04:18,110
.لا داعي للغضب

49
00:04:18,820 --> 00:04:25,570
قلّة فقط من يقدرون على المخاطرة
.بحياتهم لحماية الشّرف والكرامة كبشر

50
00:04:25,950 --> 00:04:30,540
،إن كنتم تسعون للبقاء أحياء فحسب
.فلن تحتاجوا للشّرف أو الكرامة

51
00:04:31,370 --> 00:04:33,210
وما أدرى غريبًا مثلك بحالنا؟

52
00:04:33,370 --> 00:04:36,460
.كلّ هذا نِتاجٌ لجُبن رجال الشّرطة

53
00:04:36,880 --> 00:04:40,880
.في كلّ الأحوال، لن نسمح لكم بإنزال الجثّتين

54
00:04:42,010 --> 00:04:43,670
.غادروا المكان في الحال

55
00:04:45,550 --> 00:04:46,390
!هيمورا

56
00:04:55,270 --> 00:04:56,850
—ما الّذي تفعله يا

57
00:04:57,190 --> 00:04:58,230
!هيمورا

58
00:05:06,530 --> 00:05:08,820
.هذا هو الوضع الحاليّ لهذه القرية

59
00:05:09,620 --> 00:05:14,080
وهكذا ستصير اليابان في العصر
.الجديد الّذي يُنشؤه شيشيو

60
00:05:16,370 --> 00:05:19,040
،إن صارت هذه القرية خرابًا
.فسيكون ذلك خطؤك

61
00:05:19,420 --> 00:05:20,840
.أيّها القاتل

62
00:05:21,800 --> 00:05:24,590
.النّاس ضعفاء ضدّ رعب العنف

63
00:05:24,590 --> 00:05:28,470
وتحت براثنه، يتحوّل الهدف الرّئيسيّ
،في حياتهم إلى النّجاة فحسب

64
00:05:28,970 --> 00:05:30,760
.ويفقدون كلّ ذرّة شرف وكرامة لديهم

65
00:05:31,180 --> 00:05:33,890
هل تخلّت الحكومة عن هذه القرية بالفعل؟

66
00:05:34,230 --> 00:05:35,520
.ليس هذه القرية فحسب

67
00:05:35,730 --> 00:05:39,980
تمّ التّخلّي عن عشرة قرى أخرى
.وصارت ضمن منطقة شيشيو

68
00:05:40,650 --> 00:05:43,610
سبق واستسلمت الشّرطة
.عن فكرة استعادة القرى منه

69
00:05:43,860 --> 00:05:45,360
،لا أفهم الأمر بالكامل

70
00:05:45,360 --> 00:05:47,700
،لكن إن لم تكن الشّرطة ذات فائدة
أفلا يمكنكم استعمال الجيش؟

71
00:05:48,110 --> 00:05:51,700
مغفّلة. انتهت حرب سينان
.منذ ستّة أشهر فحسب

72
00:05:51,700 --> 00:05:53,910
،إن تمّ نشر الجيش لحلّ اضطرابات داخليّة

73
00:05:54,160 --> 00:05:56,830
فسيكشف ذلك عن عدم استقرارنا
.الدّاخليّ للبلدان الأجنبيّة

74
00:05:57,250 --> 00:05:59,250
!هذا ليس وقتًا مناسبًا لقول ذلك

75
00:05:59,540 --> 00:06:04,000
،حتّى إن كنّا سنستعمل الجيش
.لن يوافق السّياسيّون على ذلك أبدًا

76
00:06:04,510 --> 00:06:05,340
لماذا؟

77
00:06:07,380 --> 00:06:11,430
إنّ كلّ واحد منهم يخاف أن يكون
.مصيره مثل مصير السّيّد أوكوبو

78
00:06:12,350 --> 00:06:16,060
،إن استعمالنا الجيش
...فسنستعيد القرى بالتّأكيد

79
00:06:16,560 --> 00:06:19,270
لكنّ الانتقام عن طريق الاغتيالات
.سيصير أمرًا لا مفرّ منه

80
00:06:19,940 --> 00:06:21,730
أظنّك تدركين جيّدًا

81
00:06:21,730 --> 00:06:26,400
كم أنّ الاغتيال أمر مخيف ويصعب
.منعه بالنّسبة لمسؤولي الحكومة

82
00:06:27,530 --> 00:06:29,820
إنّ مسؤولي الحكومة مجرّد
.بشر قبل كلّ شيء

83
00:06:30,320 --> 00:06:32,280
إنّهم يخشون على حياتهم

84
00:06:32,280 --> 00:06:35,160
ويعتقدون دائمًا أنّ شخصًا آخر
.سيحلّ المشكلة

85
00:06:35,540 --> 00:06:36,910
ومن هذا الشّخص الآخر؟

86
00:06:37,040 --> 00:06:39,170
من سيجعل هذه القرية محترمة؟

87
00:06:39,330 --> 00:06:42,670
من سينتقم لذلك الفتى بالضّبط؟

88
00:06:44,460 --> 00:06:48,760
القرية والشّرطة والجيش والحكومة
...وكلّ شيء آخر

89
00:06:49,260 --> 00:06:52,220
إن لم نفعل أيّ شيء، سيصير
.كلّ شيء كما يريده شيشيو ماكوتو

90
00:06:54,260 --> 00:06:58,020
.لذلك السّبب يحتاجون لك ولي الآن

91
00:07:00,980 --> 00:07:03,230
.أعرف أين هو قصر شيشيو

92
00:07:03,940 --> 00:07:06,440
،إنّه أقرب من كيوتو بعض الشّيء
ولكن هل نقابله هناك؟

93
00:07:08,780 --> 00:07:09,650
.نعم

94
00:07:10,530 --> 00:07:12,410
!مهلاً! سأذهب أيضًا

95
00:07:12,870 --> 00:07:14,330
.لا يمكنك مرافقتنا

96
00:07:14,330 --> 00:07:15,280
.ابقي هنا

97
00:07:15,280 --> 00:07:19,160
لماذا؟ لا أستطيع حتّى مسامحة
!أيّ أحد يقوم بمثل تلك الأمور

98
00:07:19,660 --> 00:07:20,580
.ميساو-دونو

99
00:07:20,660 --> 00:07:22,370
—ماذا؟ مهما كان ما ستقوله

100
00:07:22,370 --> 00:07:23,540
...أريدك

101
00:07:24,000 --> 00:07:26,000
.أن تظلّي إلى جانب إيجي

102
00:07:30,090 --> 00:07:31,180
.مفهوم

103
00:07:33,180 --> 00:07:35,260
!أعتذر بشدّة

104
00:07:35,260 --> 00:07:41,100
تغلغل هيمورا باتّوساي في غابة
!هاكوني فجأة وفقدنا أثره

105
00:07:41,690 --> 00:07:45,400
تمّ نشر الجميع للبحث عن
—مكانه، لذلك رجاءً

106
00:07:45,900 --> 00:07:47,780
ماذا نفعل يا شيشيو-سان؟

107
00:07:48,530 --> 00:07:50,690
.لا بأس. سأدع الأمر يمرّ

108
00:07:51,700 --> 00:07:54,740
أشعر بتحسّن بعد أوّل علاج
.بالمياه السّاخنة منذ ستّة أشهر

109
00:07:55,410 --> 00:07:58,910
أسرعوا في العثور على الباتّوساي
.قبل أن أغيّر رأيي

110
00:07:59,160 --> 00:08:01,540
!شـ-شكرًا جزيلاً لك

111
00:08:01,830 --> 00:08:02,830
.مسرور لأجلك

112
00:08:04,040 --> 00:08:08,500
لكن في المرّة القادمة الّتي تفشل
.فيها، فلن أدع هذا يمرّ مرور الكرام

113
00:08:09,380 --> 00:08:10,260
!حا-حاضر

114
00:08:10,920 --> 00:08:12,220
!سيتا-ساما

115
00:08:12,510 --> 00:08:14,800
يا للجلبة. ماذا هنالك؟

116
00:08:14,800 --> 00:08:15,800
...في الحقيقة

117
00:08:19,060 --> 00:08:20,100
فعلاً؟

118
00:08:21,350 --> 00:08:23,020
.شيشيو-سان. شيشيو-سان

119
00:08:23,020 --> 00:08:25,940
.يا لهذا الضّجيج
ماذا هنالك هذه المرّة؟

120
00:08:26,310 --> 00:08:28,520
ثمّة رجل بندبة على شكل تقاطع
على خدّه الأيسر

121
00:08:28,900 --> 00:08:30,650
...وشرطيّ يحمل كاتانا

122
00:08:31,280 --> 00:08:33,950
.في طريقهما إلى هذا القصر

123
00:08:36,160 --> 00:08:37,320
.فهمت

124
00:08:37,830 --> 00:08:41,660
إذًا فهو يأخذ وقته ليأتي قبل
.أن أتوجّه لاستقباله

125
00:08:41,660 --> 00:08:43,290
...هذا هو المتوقّع من زميلي الأقدم

126
00:08:43,750 --> 00:08:46,500
.سوجيرو، اذهب وقابلهما

127
00:08:46,500 --> 00:08:47,330
.حاضر

128
00:08:47,330 --> 00:08:48,670
...وأيضًا

129
00:08:49,840 --> 00:08:52,840
.اطلب من سنكاكو الاستعداد للقتال

130
00:08:55,720 --> 00:08:56,640
.سنكاكو

131
00:08:57,390 --> 00:08:59,850
!سنكاكو! سنكاكو

132
00:09:01,810 --> 00:09:02,930
!سأقتله

133
00:09:03,810 --> 00:09:07,350
!سأقتل سنكاكو

134
00:09:08,020 --> 00:09:11,030
روروني كنشين
—اضطرابات كيوتو—

135
00:09:15,780 --> 00:09:19,410
لا بدّ أنّكما هيمورا باتّوساي-سان
.وسايتو هاجيمي-سان

136
00:09:20,580 --> 00:09:21,700
...هذا الصّوت

137
00:09:22,490 --> 00:09:23,950
.كن حذرًا يا سايتو

138
00:09:23,950 --> 00:09:26,460
.ذلك هو الرّجل الّذي اغتال أوكوبو-سان

139
00:09:26,460 --> 00:09:28,830
.ماذا؟ كفّ عن ذلك

140
00:09:28,830 --> 00:09:31,170
.أنا مجرّد مرشد اليوم

141
00:09:31,170 --> 00:09:34,220
.أتريان؟ لا أحمل أيّ أسلحة

142
00:09:34,970 --> 00:09:38,180
إنّ شيشيو-سان في انتظاركما
.في الغرفة الخلفيّة

143
00:09:38,720 --> 00:09:39,970
...لذلك تفضّلا

144
00:09:40,850 --> 00:09:44,850
لن يحدث أيّ شيء إن تصرّفنا
.بحذر شديد. لنذهب

145
00:09:53,480 --> 00:09:57,490
شيشيو-ساما، ما رأيك بشراب بعد الحمّام؟

146
00:09:58,610 --> 00:09:59,450
.لقد وصلا

147
00:10:01,370 --> 00:10:05,000
إذًا فأنت... هو شيشيو ماكوتو؟

148
00:10:11,880 --> 00:10:14,090
.بإمكانك إضافة عبارات تشريفيّة على الأقلّ

149
00:10:14,090 --> 00:10:15,840
.يا لك من زميلٍ أقدمٍ فظّ

150
00:10:16,880 --> 00:10:19,970
.لا داعي للقلق حيال الأمر
.إن عدم الاحترام متبادل

151
00:10:20,430 --> 00:10:22,930
أواثق من وقوفك هناك؟

152
00:10:22,930 --> 00:10:26,140
بالنّسبة للباتّوساي، فتلويحة سيف
.واحدة كافية للقضاء على شيشيو

153
00:10:26,640 --> 00:10:27,730
.لا بأس

154
00:10:28,190 --> 00:10:32,570
ما كان هيمورا-سان ليقوم
،بتصرّف قذر مثل إيقاعه في فخّ

155
00:10:32,570 --> 00:10:33,940
.على عكسك أنت

156
00:10:35,690 --> 00:10:37,530
.نحن كالكتاب المفتوح له

157
00:10:41,490 --> 00:10:43,990
إلى أين أنت ذاهب بذلك الشّيء؟

158
00:10:44,490 --> 00:10:45,700
.إلى قصر شيشيو

159
00:10:46,200 --> 00:10:47,200
.سأحظى بانتقامي

160
00:10:47,410 --> 00:10:50,040
ما الّذي تقوله؟
!ذلك مستحيل بالنّسبة لشخص مثلك

161
00:10:50,040 --> 00:10:51,960
!إنّها ليست مسألة مستحيل أو ممكن

162
00:10:52,290 --> 00:10:53,880
!بل إمّا أن أفعل أو لا أفعل

163
00:10:57,550 --> 00:10:58,470
!انتظر

164
00:11:00,090 --> 00:11:02,050
.سأساعدك

165
00:11:03,850 --> 00:11:07,220
.آسفة يا هيمورا. سأساعد هذا الفتى

166
00:11:08,140 --> 00:11:12,440
،إن كان الأونيوابانشو قد قُتلوا

167
00:11:12,940 --> 00:11:15,690
!فسأسعى للانتقام أيضًا وإن قتلني ذلك

168
00:11:17,190 --> 00:11:18,940
.إيّاك أن تعترضي طريقي

169
00:11:24,450 --> 00:11:26,290
لماذا استهدفت هذه القرية؟

170
00:11:27,040 --> 00:11:32,250
،أنت تسعى خلف البلاد بأكملها
.وليس قرية أوقريتين فحسب

171
00:11:34,960 --> 00:11:35,840
.الينابيع السّاخنة

172
00:11:37,210 --> 00:11:39,840
.المياه هنا مفيدة جدًّا لجسدي

173
00:11:40,220 --> 00:11:44,010
لكن إذا رآني روّاد العلاج بالينابيع السّاخنة
الآخرون، فسيخافون، أليس كذلك؟

174
00:11:44,430 --> 00:11:46,560
.لذلك السّبب جعلته لي بالكامل

175
00:11:47,060 --> 00:11:52,190
أفسدتَ قرية بأكملها من أجل ذلك السّبب؟

176
00:11:55,560 --> 00:11:57,360
.كنت أمزح. أمزح فحسب

177
00:12:00,860 --> 00:12:04,280
تمامًا كما تقول عنك الشّائعات، يبدو
.أنّ لديك شخصيّة جدّيّة بشكل سخيف

178
00:12:04,490 --> 00:12:07,330
.يا له من استفزاز رخيص
.لا تأخذ الأمر على محمل الجدّ

179
00:12:07,830 --> 00:12:12,920
اخترتُ هذه القرية لاستعمالها
.كمعقل للاستيلاء على منطقة توكاي

180
00:12:12,920 --> 00:12:16,630
.لكنّي أحبّ الينابيع السّاخنة هنا بالفعل

181
00:12:16,630 --> 00:12:17,460
—شيشيو

182
00:12:17,460 --> 00:12:18,800
.لا تقل كلمة واحدة

183
00:12:19,170 --> 00:12:23,510
إذًا فأنت تؤسّس قاعدة لك
،هنا للانتقام من حكومة ميجي

184
00:12:23,760 --> 00:12:25,340
أيّها الشّابّ المغطّى بالضّمادات؟

185
00:12:25,850 --> 00:12:30,470
،يا قائد الوحدة الثّالثة من الشّينسنغومي
.سايتو هاجيمي-سان

186
00:12:31,140 --> 00:12:34,190
،طباعك أقرب إلى طباعي من طِباع الباتّوساي

187
00:12:34,190 --> 00:12:36,520
.لذلك ظننتُ أنّك ستكون متفهّمًا أكثر

188
00:12:36,520 --> 00:12:38,110
.لكن يبدو أنّك لستَ كذلك

189
00:12:39,020 --> 00:12:44,740
لا رغبة لي إطلاقًا في الانتقام من الأشخاص
.الّذين سبّبوا لي هذه الجروح

190
00:12:45,320 --> 00:12:47,070
.في الحقيقة، أنا أقدّرهم

191
00:12:47,830 --> 00:12:51,700
علّمتني هذه الجروح أشياء
.عديدة تغلغلت داخل جسدي

192
00:12:52,290 --> 00:12:54,500
".تقود الثّقة إلى الخيانة"

193
00:12:54,500 --> 00:12:56,830
".أرخِ دفاعك، وستُقتل"

194
00:12:56,830 --> 00:12:58,670
".اقتل قبل أن تُقتل"

195
00:12:59,250 --> 00:13:06,800
أضيفا لذلك، "ستنجذب النّساء
."إلى الرّجل الجيّد مهما كان مظهره

196
00:13:07,010 --> 00:13:08,140
.فهمت

197
00:13:08,640 --> 00:13:11,140
إذًا هلاّ أغلقت فمك وأرحتنا؟

198
00:13:11,520 --> 00:13:15,980
من المتعب جدًّا السّفر
.عبر اليابان فقط من أجلك أنت

199
00:13:16,480 --> 00:13:18,980
أغلق فمي؟

200
00:13:19,730 --> 00:13:24,700
،أنت وأنا وزميلي الأقدم
.عشنا جميعًا في نفس حقبة باكوماتسو

201
00:13:25,150 --> 00:13:29,700
.عشتما في أوقات الشّغف هذه
كيف لا تستطيعان أن تفهما ما أشعر به؟

202
00:13:31,580 --> 00:13:33,660
.احترام الإمبراطور. هزيمة الشّوغونيّة

203
00:13:33,660 --> 00:13:35,960
.استبعاد الأجانب. فتح الموانئ

204
00:13:35,960 --> 00:13:37,580
وصارت باكوماتسو في النّهاية

205
00:13:37,580 --> 00:13:43,010
أوّل حقبة مضطربة منذ 300 سنة
.منذ حقبة سنغوكو

206
00:13:43,630 --> 00:13:45,550
...ساتسوما وتوسا وتشوشو

207
00:13:46,050 --> 00:13:50,600
قاتلوا وقُتلوا كلّ يوم في هذه
،الحقبة الفوضويّة

208
00:13:53,600 --> 00:13:56,310
،إن حدث ووُلد المرء في حقبة كهذه

209
00:13:57,100 --> 00:14:00,900
فلن يكون رجلاً ما لم يكن مسعاه
.الهيمنة على العالم بأكمله

210
00:14:06,320 --> 00:14:08,320
،ولكن مهلاً. كدتُ أتعرّض للاغتيال

211
00:14:08,320 --> 00:14:11,330
،وعندما عدتُ بعد شفاء جراحي
...كانت الاضطرابات قد انتهت

212
00:14:11,780 --> 00:14:15,830
.وتمّ إنشاء هذا الشّيء المسمّى حكومة ميجي

213
00:14:16,160 --> 00:14:19,960
لا يمكنهم حتّى إرسال قوّات
،لقتل رجل شبه ميت

214
00:14:19,960 --> 00:14:24,130
.لأنّهم قلقون من عيون الغرب

215
00:14:24,130 --> 00:14:26,170
.يا لها من حكومة ضعيفة

216
00:14:26,760 --> 00:14:29,720
لا يمكنني السّماح لأشخاص مثلهم
.بأن يحكموا هذه البلاد

217
00:14:30,470 --> 00:14:31,720
...لذلك

218
00:14:32,100 --> 00:14:36,020
!إن انتهت الاضطرابات، فسأبدأ أخرى جديدة

219
00:14:36,520 --> 00:14:39,060
!وهذه المرّة، سأكون المسيطر

220
00:14:39,400 --> 00:14:42,520
!ثمّ سأجعل البلاد أقوى

221
00:14:43,400 --> 00:14:47,610
.تلك هي "العدالة" الّتي سأجلبها لليابان

222
00:14:48,400 --> 00:14:51,870
ولكن، أولئك الّذين ستُراق دماؤهم
..."من أجل هذه "العدالة

223
00:14:52,580 --> 00:14:55,660
.هم الأشخاص الّذين يعيشون بسلام في الحاضر

224
00:14:57,000 --> 00:14:58,210
.شيشيو ماكوتو

225
00:14:59,210 --> 00:15:04,920
لا يمكنني السّماح بإراقة دماء المزيد
.من النّاس من أجل "عدالتك" وحدها

226
00:15:07,130 --> 00:15:09,130
سايتو-سان، ماذا عنك؟

227
00:15:09,430 --> 00:15:13,180
إنّ امتلاك أحلام مثاليّة مثله
.ليست من هواياتي

228
00:15:13,680 --> 00:15:17,810
لكن يبدو أنّ ما يُناسبني أكثر هو التّواجد
.في الجانب الّذي سيطيح بشيشيو

229
00:15:18,100 --> 00:15:21,400
.لا أمانع القتال إن كنتُ مضطرًّا لذلك

230
00:15:21,400 --> 00:15:25,360
إن كنتُ سأقاتل، فأفضّل القيام بذلك
.في مدينة كيوتو المذهلة

231
00:15:25,360 --> 00:15:28,150
...ولكن إن كنتما مصرّين

232
00:15:33,870 --> 00:15:40,660
،فستواجهانني أنا سنكاكو
!حاكم قرية شينغتسو هذه

233
00:15:42,040 --> 00:15:43,380
.فهمت

234
00:15:43,380 --> 00:15:44,920
...أنت هو سنكاكو إذًا

235
00:15:45,460 --> 00:15:49,050
.الّذي قتل والدَيْ إيجي وأخاه

236
00:15:54,090 --> 00:15:55,430
.إنّه سريع

237
00:15:55,550 --> 00:15:56,390
!بطيء

238
00:15:59,390 --> 00:16:02,060
يا إلهي. كان ذلك مخيّبًا للآمال
.أكثر ممّا توقّعت

239
00:16:03,600 --> 00:16:06,520
!إنّ هيمورا باتّوساي لا يستحقّ أن نخشاه

240
00:16:07,730 --> 00:16:09,740
.قطعتُ وعدًا لإيجي لو سمحت

241
00:16:10,820 --> 00:16:15,070
!لذلك سأبدأ بهزيمتك أنت قبل شيشيو

242
00:16:16,870 --> 00:16:17,700
...هزيمتي

243
00:16:18,240 --> 00:16:19,450
أنا؟

244
00:16:19,450 --> 00:16:20,290
.نعم

245
00:16:21,290 --> 00:16:22,500
!كم هذا ممتع

246
00:16:28,670 --> 00:16:32,380
.لقد قطعتُ 99 شخصًا حتّى الآن

247
00:16:32,380 --> 00:16:34,840
!ستكون أنت هدفي المائة

248
00:16:35,640 --> 00:16:38,890
‫99 فقط؟ هذا ليس رقمًا لتتفاخر به.

249
00:16:42,890 --> 00:16:45,150
.هذه هي "السّرعة المقدّسة" المشهورة

250
00:16:45,520 --> 00:16:50,150
،ولكن إن قارنّا بين سرعتهما
.فإنّ سنكاكو لن يتخلّف عن الرّكب

251
00:16:50,150 --> 00:16:50,990
!إليك هذه

252
00:16:53,700 --> 00:16:54,990
.تبًّا

253
00:16:55,200 --> 00:17:00,450
هل الهيتوكيري باتّوساي جبان
لا يمكنه إلاّ مهاجمة النّاس من الخلف؟

254
00:17:00,740 --> 00:17:02,620
...إن كان ذلك كلّ شيء

255
00:17:03,960 --> 00:17:05,250
.يمكنني القيام بالمثل

256
00:17:06,080 --> 00:17:08,630
.هذا أيضًا ليس أمرًا لتتفاخر به

257
00:17:08,750 --> 00:17:10,500
!سرعتانا متساوية

258
00:17:10,500 --> 00:17:13,630
!لكنّي أملك القوّة الّتي تفتقر لها أنت

259
00:17:15,470 --> 00:17:16,300
!سريع

260
00:17:16,300 --> 00:17:17,300
!شديد

261
00:17:17,300 --> 00:17:18,600
!قويّ

262
00:17:18,850 --> 00:17:21,060
!لا أملك أنا سنكاكو أيّ نقاط ضعف

263
00:17:21,060 --> 00:17:22,310
!خذ هذه

264
00:17:22,770 --> 00:17:25,270
...أسلوب سنكاكو

265
00:17:25,520 --> 00:17:26,980
!الضّربات الفارمة

266
00:17:34,150 --> 00:17:35,650
...أسلوب سنكاكو

267
00:17:35,990 --> 00:17:38,450
!المنجنيق البشريّ

268
00:17:48,170 --> 00:17:52,590
إلى متى ستواصل تفاديّ أيّها الباتّوساي؟

269
00:17:58,300 --> 00:17:59,760
!تنتقل في الأرجاء كثيرًا

270
00:18:01,390 --> 00:18:04,180
أتظنّ أنّ بإمكانك الهرب منّي للأبد؟

271
00:18:05,060 --> 00:18:07,560
.يبدو أنّ هيمورا-سان يواجه وقتًا عصيبًا

272
00:18:07,560 --> 00:18:10,190
.كان تحت الضّغط طوال هذا الوقت
.لم يهاجم ولو مرّة واحدة

273
00:18:10,650 --> 00:18:13,030
ما رأيك أن تساعده؟

274
00:18:13,030 --> 00:18:14,280
أتمازحني؟

275
00:18:14,280 --> 00:18:17,820
لا أرى أيّ فائدة من الكشف عن مهاراتي
.في المسايفة لشخص مثله

276
00:18:18,450 --> 00:18:19,530
.انظر

277
00:18:20,160 --> 00:18:24,250
كان يتحدّث بفخر مع ابتسامة
،سخرية على وجهه قبل قليل

278
00:18:24,250 --> 00:18:26,660
،لكن بمجرّد أن بدأت المعركة
.تغيّرت تعابير وجهه إلى ما تراه الآن

279
00:18:27,160 --> 00:18:31,000
إنّه يحاول الحصول على فكرة واضحة
.عن كلّ تفصيل صغير يفعله الباتّوساي

280
00:18:31,000 --> 00:18:34,380
قد يكون صريحًا، لكنّ الحذر
.منه ليس أمرًا يمكن الاستهانة به

281
00:18:34,960 --> 00:18:37,630
.وبالطّبع لاحظَ الباتّوساي نظراته إليه أيضًا

282
00:18:38,300 --> 00:18:42,930
لذلك السّبب لا يهاجم ويستدرج
.خصمه ليدمّر نفسه بنفسه

283
00:18:43,430 --> 00:18:44,560
يدمّر نفسه؟

284
00:18:48,640 --> 00:18:49,770
.حان الوقت

285
00:18:49,900 --> 00:18:50,730
!سُحقًا لك

286
00:18:50,730 --> 00:18:52,650
—لماذا لا تـ

287
00:18:59,320 --> 00:19:02,530
!سا-ساقي... كُسرت

288
00:19:03,030 --> 00:19:07,080
بما أنّك لم تقلّل من سرعتك
،وواصلت الانتقال من حركة لأخرى

289
00:19:07,080 --> 00:19:10,880
فإنّ حِملَ جسدك عندما تستدير
.تجاوز الحدّ بسرعة

290
00:19:11,000 --> 00:19:12,040
!مستحيل

291
00:19:12,040 --> 00:19:15,630
إن كنّا بنفس السّرعة، عليك أن تبلغ
حدودك أيضًا بما أنّك أضعف

292
00:19:15,630 --> 00:19:17,300
—في وقت أسرع منّي

293
00:19:17,300 --> 00:19:23,850
إنّ لجسدك الثّقيل حِملاً أعلى
.لأنّنا نتحرّك بنفس السّرعة

294
00:19:24,180 --> 00:19:26,060
!مستحيل! هذا مستحيل

295
00:19:26,060 --> 00:19:27,890
!لم يحد أيّ شيء كهذا من قبل

296
00:19:27,890 --> 00:19:29,980
—لماذا لسرعة قليلة مثل هذه أن

297
00:19:29,980 --> 00:19:30,810
.مغفّل

298
00:19:31,980 --> 00:19:35,230
.كان الباتّوساي يزيد من سرعته بشكل تدريجيّ

299
00:19:35,730 --> 00:19:39,360
،ولأنّك اعتقدت أنّ لك نفس سرعته

300
00:19:39,360 --> 00:19:41,450
.وقعت في الفخ مباشرة

301
00:19:42,530 --> 00:19:45,740
.تحدّثت عن قتلك لـ99 شخصًا

302
00:19:45,740 --> 00:19:48,750
.أرى أنّه قد قُرِّر أنّك الشّخص المائة

303
00:19:48,750 --> 00:19:53,130
فهمت. إنّ الجميع يفكّرون بكلّ
.تفصيل أثناء القتال

304
00:19:57,130 --> 00:19:59,260
!كذب! كان ذلك كذبًا! لم يحدث ذلك

305
00:19:59,260 --> 00:20:02,510
.كانت عبارة "99 شخصًا" مجرّد تلاعب بالكلمات

306
00:20:02,930 --> 00:20:06,510
لكنّك كنت الشّخص الّذي قتل
عائلة إيجي، صحيح؟

307
00:20:06,970 --> 00:20:07,850
...سنكاكو

308
00:20:08,720 --> 00:20:12,230
.لم أتوقّع أنّ تنتصر منذ البداية

309
00:20:12,650 --> 00:20:16,940
لكنّ الخسارة في مواجهته دون دفعه
...للكشف عن حركة واحدة على الأقلّ

310
00:20:17,440 --> 00:20:21,150
.ستجعلني أضع حدًّا لحياتك بنفسي

311
00:20:28,540 --> 00:20:31,620
...أسلوب سنكاكو السّرّيّ

312
00:20:34,000 --> 00:20:38,340
!المنجنيق البشريّ الخارق

313
00:20:42,470 --> 00:20:43,840
...أسلوب هيتن ميتسوروغي

314
00:20:50,770 --> 00:20:52,020
!وميض التّنّين المحلّق

315
00:21:08,120 --> 00:21:12,000
.احمل سيفك يا شيشيو ماكوتو

316
00:22:44,960 --> 00:22:49,970
:الحلقة القادمة
إلى كيوتو مرّة أخرى

317
00:22:46,670 --> 00:22:49,300
."في الحلقة القادمة: "إلى كيوتو مرّة أخرى