1
00:00:14,860 --> 00:00:25,210
"(السّنة الرّابعة من حقبة كييو (1868"
"ضواحي أوينو"

2
00:00:15,810 --> 00:00:17,660
،في السّنة الرّابعة من حقبة كييو

3
00:00:18,240 --> 00:00:21,390
.كانت قد وضعت معركة أوينو أوزارها

4
00:00:21,820 --> 00:00:26,010
،وفي أوينو، على مشارف إيدو
اشتبكت القوّات الموالية للشّوغونيّة

5
00:00:26,150 --> 00:00:30,920
مع قوّات المناصرين للإمبراطوريّة
.من ساتسوما وتشوشو

6
00:00:31,150 --> 00:00:33,380
،ولم يستمرّ الهجوم سوى نصف يوم

7
00:00:33,530 --> 00:00:36,080
.وكان النّصر الإمبراطوريّ ساحقًا

8
00:00:36,260 --> 00:00:39,810
،وكما هو الحال مع كلّ هزيمة
.يتعرّض المهزومون لملاحقة قاسية

9
00:00:39,950 --> 00:00:41,350
.ذهبت لإلقاء نظرة

10
00:00:41,490 --> 00:00:42,570
.ممتاز

11
00:00:42,710 --> 00:00:44,460
وبعد؟ ما رأيك؟

12
00:00:44,600 --> 00:00:47,650
.لا مجال للشّكّ، إنّه هو

13
00:00:47,880 --> 00:00:49,200
أأنت واثق؟

14
00:00:49,340 --> 00:00:53,610
،إنّه يتظاهر بأنّه مزارع
!لكنّي تعرّفت عليه بسبب ذراعه

15
00:00:54,400 --> 00:00:55,780
أتريدون قتله؟

16
00:00:55,910 --> 00:00:56,970
!بالطّبع

17
00:00:57,120 --> 00:01:00,850
جعلَنا غوريلاّ إيدو شائن الصّيت
.غيتشي نعاني الكثير

18
00:01:00,980 --> 00:01:02,180
!سنطيح به

19
00:01:02,320 --> 00:01:03,250
!بلا أيّ تردّد

20
00:01:03,400 --> 00:01:05,890
.لاحقًا. لقد حان الوقت للعودة للمقرّ الرّئيسيّ

21
00:01:06,020 --> 00:01:07,680
وما علاقة ذلك بنا؟

22
00:01:07,820 --> 00:01:10,710
.نحن في مهمّة لمطاردة الجنود المهزومين

23
00:01:10,840 --> 00:01:13,920
.بإمكانكم تحقيق انتقامكم في أوقات فراغكم

24
00:01:14,050 --> 00:01:14,890
ماذا قلت؟

25
00:01:15,010 --> 00:01:18,470
عثرنا عليه للتّوّ، وها أنت تريد
منّا أن نتركه يذهب؟

26
00:01:18,610 --> 00:01:21,050
.في الجيش، لدينا جدول زمنيّ نحترمه

27
00:01:21,170 --> 00:01:24,850
.وإلاّ، فحتّى علاقاتي لن تستطيع حمايتكم

28
00:01:25,300 --> 00:01:27,580
.لا بأس إذًا. لنعد

29
00:01:27,720 --> 00:01:29,170
أأنت واثق؟

30
00:01:29,310 --> 00:01:31,180
.نحن نعرف أين يختبئ

31
00:01:31,320 --> 00:01:35,120
.سنعود مرّة أخرى لتولّي أمره

32
00:01:46,980 --> 00:01:48,000
ماذا؟

33
00:01:48,320 --> 00:01:49,610
!يا ويحي

34
00:01:51,540 --> 00:01:54,690
أتيت لتحتمي هنا من المطر؟
.لا أظنّ ذلك

35
00:01:54,840 --> 00:01:56,380
لقد تمّ التّخلّي عنك، صحيح؟

36
00:01:56,640 --> 00:01:58,050
.لا داعي للقلق الآن

37
00:02:12,110 --> 00:02:17,700
روروني كنشين
—اضطرابات كيوتو—

38
00:03:43,160 --> 00:03:44,580
...غيتشي-سان

39
00:03:46,000 --> 00:03:48,160
.أرى أنّك أحضرتِ معك واحدًا آخر

40
00:03:48,380 --> 00:03:49,880
.لم أستطع التّخلّي عنه

41
00:03:50,020 --> 00:03:53,870
،إن استمرّ هذا الوضع
.ستصير لنا حديقة حيوانات حقيقيّة

42
00:03:54,010 --> 00:03:55,710
كم عددها هذه المرّة؟

43
00:03:56,290 --> 00:03:58,190
...قطّ و

44
00:03:59,330 --> 00:04:00,550
.رجل

45
00:04:04,060 --> 00:04:07,000
أحسنت، لديك زوج سلفًا
ومع ذلك أحضرت رجلاً آخر؟

46
00:04:07,140 --> 00:04:08,790
!كفّ عن مضايقتي هكذا

47
00:04:08,920 --> 00:04:11,770
لم أستطع تركه ليلقى حتفه
.على قارعة الطّريق

48
00:04:12,000 --> 00:04:13,040
.هذه طبيعتك

49
00:04:13,560 --> 00:04:16,460
.لديك قلب طيّب، وذلك ما أحبّه فيك

50
00:04:18,150 --> 00:04:21,000
!كفّ عن هذا، إنّك تحرجني كثيرًا

51
00:04:25,130 --> 00:04:27,070
.اذهبي لتغيير ملابسك، أنت مبلّلة بالكاملة

52
00:04:27,840 --> 00:04:29,950
.ذلك ليس جيّدًا للطّفل أيضًا

53
00:04:32,940 --> 00:04:33,890
.حسنًا

54
00:04:35,060 --> 00:04:38,100
هُرير لطيف. أرى أنّك لا تثير
.الكثير من الشّغب

55
00:04:40,430 --> 00:04:43,740
.كلاّ! إنّه مبلّل أيضًا، يا له من مسكين

56
00:04:54,930 --> 00:05:00,180
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

57
00:05:00,670 --> 00:05:03,420
.عش بالسّيف، ومت بالسّيف

58
00:05:03,660 --> 00:05:06,900
.لا يجدر أن يوجد طريق آخر لك

59
00:05:15,200 --> 00:05:16,580
هل استيقظت؟

60
00:05:17,070 --> 00:05:18,390
.أيّها السّاموراي الشّابّ

61
00:05:18,550 --> 00:05:21,660
.فقدتَ وعيك، وكنت تعاني من الحمّى

62
00:05:22,460 --> 00:05:25,820
حسب مظهرك، فلا بدّ أنّك أحد
.الموالين المهزومين في أوينو

63
00:05:26,100 --> 00:05:27,550
...لا، بل أنا

64
00:05:27,680 --> 00:05:29,020
.لا داعي للقلق

65
00:05:29,920 --> 00:05:32,210
.استرح فحسب

66
00:05:35,340 --> 00:05:36,610
.أنا ممتنّ لكما

67
00:05:37,960 --> 00:05:41,110
تعالي جميعك! احرصي على
.إبقاء السّاموراي الشّابّ دافئًا

68
00:06:04,600 --> 00:06:06,800
كيف تشعر هذا الصّباح أيّها السّاموراي الشّابّ؟

69
00:06:09,260 --> 00:06:12,700
.أنا بخير. صرت في أفضل حالاتي

70
00:06:13,870 --> 00:06:16,780
.بل ما زال عليك أن ترتاح أكثر

71
00:06:18,960 --> 00:06:20,850
أين هي أغراضي؟

72
00:06:21,030 --> 00:06:23,430
.ستجد كلّ شيء هناك عند الزّاوية

73
00:06:24,790 --> 00:06:28,260
إنّه سيف ممتاز. أهو جديد؟

74
00:06:28,720 --> 00:06:31,840
.لقد عُهد بذلك السّيف لي

75
00:06:31,980 --> 00:06:34,020
.لم أقم باستلاله بعد

76
00:06:34,720 --> 00:06:36,330
ولِمَ لا؟

77
00:06:39,140 --> 00:06:41,290
أهو جديد تمامًا بالفعل؟

78
00:06:41,760 --> 00:06:43,520
!كم أحبّ الأشياء الجديدة

79
00:06:43,650 --> 00:06:48,050
أستمتع دائمًا بارتداء الملابس
.الجديدة في مطلع كلّ سنة

80
00:06:48,190 --> 00:06:50,500
.تبدين جميلة مهما ارتديتِ يا ساتسكي

81
00:06:51,170 --> 00:06:53,010
!توقّف، أنت تُحرجني ثانية

82
00:06:53,170 --> 00:06:54,840
!إنّه دوري لأحرجك الآن

83
00:06:55,010 --> 00:06:57,600
!غيتشي-سان، أيّها الشّقيّ الوسيم

84
00:06:58,510 --> 00:06:59,750
.شكرًا لك

85
00:07:01,320 --> 00:07:04,730
كيف تجرؤ على فعل ذلك بي؟

86
00:07:04,960 --> 00:07:06,700
.إنّكما غارقين في الحبّ

87
00:07:07,420 --> 00:07:11,330
!كلاّ، لم تكن تلك نيّتي

88
00:07:35,120 --> 00:07:36,220
!أيّها السّاموراي الشّابّ

89
00:07:36,640 --> 00:07:40,270
.سأذهب لقضاء بعضٍ من شؤوني
أتحتاج لأيّ شيء؟

90
00:07:40,420 --> 00:07:41,940
.لا، لا تشغلي بالك

91
00:07:53,920 --> 00:07:55,660
سلاح جيتّي؟

92
00:07:55,810 --> 00:07:58,720
.نعم. إنّه فخر وفرحة غيتشي-سان

93
00:08:00,260 --> 00:08:01,580
،قبل وقت ليس ببعيد

94
00:08:01,940 --> 00:08:05,080
.خدم كرجل قانون

95
00:08:05,480 --> 00:08:07,400
،أترى أولئك المسؤولين الفاسدين

96
00:08:07,550 --> 00:08:12,510
المستغلّين الّذين يسمّون أنفسهم وطنيّين
...ويستخدمون ذلك لابتزاز النّاس

97
00:08:13,220 --> 00:08:16,460
.كان غيتشي-سان يطارد الأوغاد من أمثالهم

98
00:08:16,770 --> 00:08:20,810
،لكنّه كان مخيفًا للغاية
.وحصل على أعداء كُثر

99
00:08:21,200 --> 00:08:23,520
وضع له أولئك الجبناء كمينًا

100
00:08:23,830 --> 00:08:25,560
.وقطعوا ذراعه اليمنى

101
00:08:28,160 --> 00:08:30,700
.ما عاد قادرًا على حمل الجيتّي خاصّته الآن

102
00:08:31,070 --> 00:08:33,200
.ما عاد قادرًا على القتال بعد الآن

103
00:08:34,380 --> 00:08:36,850
.وقد استقال من منصبه

104
00:08:37,900 --> 00:08:41,180
.عفوًا! إنّني أزعجك بقصصي

105
00:08:41,930 --> 00:08:44,460
.دعنا لا ننغمس كثيرًا في الذّكريات الحزينة

106
00:08:49,520 --> 00:08:52,110
عسى أن يكون طفلي الّذي لم
يولد بعد بصحّة جيّدة

107
00:08:52,860 --> 00:08:55,420
.وعسى أن يتعافى السّاموراي الشّابّ بسرعة

108
00:09:00,970 --> 00:09:03,700
!أجل، وجدت الكثير من البيض

109
00:09:03,830 --> 00:09:05,920
.سيجعل الحياة تدبّ ثانية في السّاموراي الشّابّ

110
00:09:09,900 --> 00:09:12,860
هذا الزّيّ... القوّات الإمبراطوريّة الجديدة؟

111
00:09:13,040 --> 00:09:15,110
!هيّا، تحرّكا بسرعة

112
00:09:20,400 --> 00:09:21,910
...ذلك السّاموراي الشّابّ

113
00:09:22,160 --> 00:09:24,460
.في خطر ولا يجب أن يعثروا عليه

114
00:09:35,650 --> 00:09:38,750
جنديّ إمبراطوريّ يطارد المهزومين؟

115
00:09:39,250 --> 00:09:41,160
أيجرؤ على التّوغّل بيننا هكذا؟

116
00:09:45,020 --> 00:09:48,020
روروني كنشين
—اضطرابات كيوتو—

117
00:09:50,200 --> 00:09:53,820
تعجّ كلّ من إيدو وجبال أوينو
.بالقوّات الإمبراطوريّة

118
00:09:54,100 --> 00:09:56,780
.لا تحاول قتالهم

119
00:09:57,080 --> 00:10:01,740
إنّ أفضل شيء يمكنك فعله الآن هو الهرب
.خلسة بمجرّد استعادة كامل عافيتك

120
00:10:02,020 --> 00:10:05,080
،اسمع أيّها السّاموراي الشّابّ
.إنّ ساتسكي محقّة

121
00:10:05,740 --> 00:10:07,790
سيكون الأوان قد فات، بمجرّد
.وقوع الفأس على الرّأس

122
00:10:09,200 --> 00:10:11,260
قاتلتَ بما فيه الكفاية، صحيح؟

123
00:10:11,850 --> 00:10:16,420
.ارم سلاحك واختفي، لن يلومك أحد على ذلك

124
00:10:19,160 --> 00:10:22,740
الهرب نجاة. ما زالت أمامك
.حياتك بأكملها لتعيشها

125
00:10:25,160 --> 00:10:28,410
.لا رحمة لدى صيّادي الجنود المهزومين

126
00:10:28,560 --> 00:10:32,370
.اختبئ في الحظيرة بينما تتعافى

127
00:10:32,780 --> 00:10:35,540
.ميكي، تاما، روكي، كوسو

128
00:10:35,710 --> 00:10:37,640
!احرصي على إبقاء السّاموراي الشّابّ دافئًا

129
00:10:40,400 --> 00:10:45,320
إنّنا لا نطلب منك الانتقال إلى هنا
.أو نحثّك على المغادرة من باب الحقد

130
00:10:45,510 --> 00:10:48,460
.أعلم أنّكما تفعلان هذا من أجل صالحي

131
00:10:50,110 --> 00:10:54,290
.نحن أيضًا اضطررنا للهرب وتركنا كلّ شيء خلفنا

132
00:10:55,100 --> 00:10:59,800
عندما تعرّض غيتشي-سان لذلك الهجوم
.الفظيع، وجدتُه على شفير الموت

133
00:11:00,010 --> 00:11:02,050
.اعتنيتُ به حتّى استعاد عافيته، واختبأنا

134
00:11:02,170 --> 00:11:05,890
.كان المسؤولون الفاسدون يسعون خلف حياته

135
00:11:06,040 --> 00:11:09,850
بالكاد هربنا منهم، وها نحن
.نعيش هنا مذّاك الحين

136
00:11:10,390 --> 00:11:11,600
.لكنّي لا أمانع ذلك

137
00:11:12,190 --> 00:11:15,100
.نحن سعيدان الآن

138
00:11:16,120 --> 00:11:18,780
.وسنصير أسعد بكثير قريبًا

139
00:11:19,390 --> 00:11:20,960
.واثقة من ذلك

140
00:11:22,070 --> 00:11:25,690
،سنُرزق بالكثير من الأطفال
،وعندما نشيخ

141
00:11:25,820 --> 00:11:29,120
.سنشرب الشّاي معًا بينما نحضن القطط

142
00:11:29,440 --> 00:11:31,200
.تلك سعادة حقيقيّة

143
00:11:32,120 --> 00:11:34,500
،كانوا يصفون غيتشي بغوريلاّ إيدو

144
00:11:34,630 --> 00:11:37,000
لكنّ شهرته ليست ما جعلني

145
00:11:37,180 --> 00:11:40,130
.سعيدة لأكون زوجته

146
00:11:40,670 --> 00:11:44,610
.ما دمتُ معه، فأنا أسعد النّساء

147
00:11:45,410 --> 00:11:47,430
غوريلاّ إيدو غيتشي؟

148
00:11:48,610 --> 00:11:49,790
.بكلّ تأكيد

149
00:11:49,940 --> 00:11:53,650
جعلَنا غوريلاّ إيدو شائن الصّيت
.غيتشي نعاني الكثير

150
00:11:53,870 --> 00:11:54,980
!سنطيح به

151
00:11:55,200 --> 00:11:56,510
!بلا أيّ تردّد

152
00:11:59,440 --> 00:12:00,790
...أولئك الرّجال

153
00:12:04,340 --> 00:12:06,710
.صار لدينا بعض الوقت أخيرًا

154
00:12:07,820 --> 00:12:10,150
يختبئ غيتشي هنا؟

155
00:12:10,300 --> 00:12:12,970
.أنا واثق من ذلك
.كنت أراقب المكان من بعيد

156
00:12:24,760 --> 00:12:25,900
!غيتشي-سان

157
00:12:27,820 --> 00:12:30,560
.كنّا نبحث عنك يا غوريلاّ إيدو غيتشي

158
00:12:30,700 --> 00:12:33,440
لا أصدّق أنّك كنت تختبئ
...في مكان ناءٍ كهذا

159
00:12:34,340 --> 00:12:35,820
...أوغاد

160
00:12:37,020 --> 00:12:39,110
.أنهوا هذا الأمر بسرعة

161
00:12:42,120 --> 00:12:44,120
.مفهوم

162
00:12:45,030 --> 00:12:47,650
.هؤلاء هم الرّجال الّذين قطعوا ذراعه

163
00:12:49,790 --> 00:12:50,860
!خذ

164
00:12:55,610 --> 00:12:57,170
!لا تتدخّلي يا امرأة

165
00:12:58,840 --> 00:12:59,910
.ساتسكي

166
00:13:00,660 --> 00:13:02,690
.ذلك الجيتّي لي

167
00:13:03,390 --> 00:13:05,720
...غيتشي-سان... ولكن

168
00:13:06,210 --> 00:13:07,520
...إنّ هذا الجيتّي

169
00:13:07,960 --> 00:13:11,310
.ليس بغرض اعتقال المجرمين فحسب

170
00:13:12,050 --> 00:13:15,270
.إنّه وقبل كلّ شيء، سلاح للحماية

171
00:13:23,940 --> 00:13:25,340
أتريد القتال؟

172
00:13:25,470 --> 00:13:27,740
.بذراع واحدة؟ لا تجعلني أضحك

173
00:13:37,780 --> 00:13:38,830
غيتشي-سان؟

174
00:13:39,340 --> 00:13:43,020
.أنا من تسعون خلفه
!دعوا ساتسكي وشأنها

175
00:13:43,160 --> 00:13:46,090
.وفي المقابل، سأسلّمكم سلاحي وحياتي

176
00:13:46,280 --> 00:13:47,710
!سأضحّي بنفسي

177
00:13:48,690 --> 00:13:49,930
هل فقدت عقلك؟

178
00:13:50,250 --> 00:13:52,230
!لا يمكنك الموت

179
00:13:52,360 --> 00:13:54,090
.سامحيني يا ساتسكي

180
00:13:54,220 --> 00:13:56,640
.أنا أدين لك بحياتي

181
00:13:56,780 --> 00:14:00,980
فدعيها تُهدر لإنقاذك أنت
.والطّفل الّذي تحملينه

182
00:14:02,820 --> 00:14:06,560
!يا لها من تضحية نبيلة
...وعندما تُطلب بكلّ أدب هكذا

183
00:14:06,930 --> 00:14:10,370
!فلا تُغيّر أيّ شيء. مُت

184
00:14:10,540 --> 00:14:13,160
!سنقتلكم جميعًا

185
00:14:25,050 --> 00:14:26,300
السّاموراي الشّابّ؟

186
00:14:27,830 --> 00:14:29,470
من أين أتيت يا هذا؟

187
00:14:29,660 --> 00:14:31,500
!أنت –
!حاضر –

188
00:14:36,940 --> 00:14:38,350
!الرّمح الطّاعن

189
00:14:38,560 --> 00:14:40,310
،بفضل قبضته

190
00:14:40,440 --> 00:14:44,520
فإنّ هذا الرّمح الاستثنائيّ مثاليّ
!لتسديد الطّعنات

191
00:14:50,080 --> 00:14:51,600
!اذهبا لمكان آمن

192
00:15:09,180 --> 00:15:12,120
!تلك النّدبة على شكل التّقاطع... غير ممكن

193
00:15:12,630 --> 00:15:15,140
!كم أنت مزعج بتفاديك لي باستمرار

194
00:15:30,050 --> 00:15:31,320
!اهرب أيّها السّاموراي الشّابّ

195
00:15:31,460 --> 00:15:34,250
!إنّه ليس بخير، دعوه وشأنه –
!اخرسا –

196
00:15:38,830 --> 00:15:39,750
!مُت

197
00:15:49,990 --> 00:15:54,590
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

198
00:15:55,310 --> 00:15:57,870
.عش بالسّيف، ومت بالسّيف

199
00:15:58,010 --> 00:16:01,240
.لا يجدر أن يوجد طريق آخر لك

200
00:16:16,460 --> 00:16:19,000
النّصل معكوس؟

201
00:16:19,940 --> 00:16:21,940
ما هذا السّيف؟

202
00:16:56,130 --> 00:17:00,350
.كان سيفي موجّها في الماضي لأشخاص قتلتُهم

203
00:17:00,490 --> 00:17:02,220
.كان سيفَ هيتوكيري قاتِل

204
00:17:06,070 --> 00:17:07,930
...لكنّ سيفَ القاتِل هذا

205
00:17:08,200 --> 00:17:11,460
.ما عاد موجّهًا للآخرين، بل موجّهًا لي

206
00:17:12,150 --> 00:17:14,210
.هذا ما يُمثّله هذا السّيف

207
00:17:15,840 --> 00:17:16,840
!السّاكاباتو

208
00:17:22,430 --> 00:17:24,310
!موتوا

209
00:17:28,860 --> 00:17:30,770
!أسلوب هيتن ميتسوروغي

210
00:17:33,400 --> 00:17:34,940
!وميض مطرقة التّنّين

211
00:17:43,340 --> 00:17:45,710
!لا مجال للشّكّ! أنت الهيتوكيري باتّوساي

212
00:17:46,770 --> 00:17:48,080
ما الّذي تفعله هنا؟

213
00:17:48,670 --> 00:17:52,740
!تمّ الإعلان أنّك مفقود بعد معركة كيوتو

214
00:17:53,080 --> 00:17:54,300
من أنت؟

215
00:17:54,440 --> 00:17:57,250
!أنا إلى جانبك
.مناصر للإمبراطوريّة من تشوشو

216
00:17:57,380 --> 00:17:59,250
.واسمي سوغا تسوكاسا

217
00:17:59,530 --> 00:18:01,680
.إنّه لشرف لي أن أقابلك

218
00:18:01,940 --> 00:18:05,680
!إنّ سمعتك كهيتوكيري باتّوساي تسبقك

219
00:18:05,890 --> 00:18:08,580
.بعد كيوتو، فزنا في معركة أوينو أيضًا

220
00:18:08,720 --> 00:18:11,840
.اتبعني! سيكون الجميع سعداء برؤيتك

221
00:18:11,990 --> 00:18:14,240
!اليابان لنا الآن

222
00:18:15,650 --> 00:18:18,920
...الهجوم على رجل لا علاقة له بالحرب

223
00:18:19,350 --> 00:18:21,760
أهكذا يتصرّف مناصرو الإمبراطوريّة؟

224
00:18:22,760 --> 00:18:23,830
...لكنّي لم

225
00:18:23,960 --> 00:18:26,420
.لقد غضضتَ النّظر عن أفعالٍ شائنة

226
00:18:27,520 --> 00:18:29,740
...إن رؤية واحد منهم

227
00:18:29,950 --> 00:18:32,840
يتصرّف هكذا سيجلب العار لرفاقنا
.الّذين سقطوا في المعارك

228
00:18:36,120 --> 00:18:37,760
!أنا أعتذر من أعماق قلبي

229
00:18:37,910 --> 00:18:40,240
!أقسم أنّ ذلك لن يحدث ثانية

230
00:18:40,390 --> 00:18:42,890
!أعدك، أعدك أنّه لن يتكرّر

231
00:18:52,960 --> 00:18:56,280
!شكرًا ثانية على حمايتنا

232
00:18:56,540 --> 00:18:59,150
.بل أنا من عليه أن يشكركما

233
00:19:01,410 --> 00:19:03,600
.عثرتَ لنفسك على منزل جيّد

234
00:19:05,190 --> 00:19:07,830
.يمكن لهذا السّقف أن يأويك أيضًا

235
00:19:08,000 --> 00:19:10,630
.لا يوجد لديك ما تخشاه من الجيش الإمبراطوريّ

236
00:19:10,760 --> 00:19:14,090
.بكلّ تأكيد. بإمكانك البقاء هنا

237
00:19:14,360 --> 00:19:16,520
.من اللّطف منكما أن تعرضا عليّ هذا

238
00:19:16,670 --> 00:19:18,430
.لكنّي متشوّق للتّرحال

239
00:19:18,590 --> 00:19:21,570
.أريد رؤية هذا العالم الجديد القادم

240
00:19:22,990 --> 00:19:25,970
.اعتنيا جيّدًا ببعضكما

241
00:19:26,900 --> 00:19:30,440
.سأدعو أن يولد طفلكما بصحّة جيّدة

242
00:19:30,740 --> 00:19:35,570
!لا داعي للقلق! سأنجب طفلاً قويًّا

243
00:19:37,740 --> 00:19:41,840
.أنا روروني رحّالة. سأترك الحياة ترشدني

244
00:19:45,780 --> 00:19:47,280
.ساكاباتو

245
00:19:47,780 --> 00:19:50,960
...كلّ الأرواح الّتي سلبتُها

246
00:19:51,080 --> 00:19:53,100
هل سيكون هذا السّيف هو الجواب؟

247
00:19:53,380 --> 00:19:57,170
"ماذا ستقطع؟" "من ستقطع؟"

248
00:20:01,580 --> 00:20:06,390
إنّه محاولة فاشلة، لكنّه سيكون أكثر
.من كافٍ بالنّسبة لمن أنت عليه الآن

249
00:20:07,130 --> 00:20:10,530
وكبداية، حاول أن تكون سيّافًا
.وأنت تحمل ذلك على خصرك

250
00:20:11,580 --> 00:20:15,610
.واثق أنّك سترى بنفسك مدى سذاجتك الآن

251
00:20:20,950 --> 00:20:22,350
.شاكّو-دونو

252
00:20:23,130 --> 00:20:27,690
لا أزال أنا أيضًا أريد الإيمان
.بذلك الحلم العاطفيّ نوعًا ما

253
00:20:28,400 --> 00:20:29,380
...لذلك

254
00:20:30,490 --> 00:20:32,420
...سأقبل بهذا السّاكاباتو

255
00:20:33,200 --> 00:20:35,300
.بكلّ امتنان وعرفان

256
00:20:39,610 --> 00:20:40,510
!ممتاز

257
00:20:41,520 --> 00:20:43,800
.حسنًا، سنغادر الآن

258
00:20:43,940 --> 00:20:46,050
.أكيد، اعتنوا بأنفسكم

259
00:20:48,000 --> 00:20:49,260
"!رجاءً"

260
00:20:49,500 --> 00:20:53,000
"!ثافح! ثافح! مع الثّلامة"

261
00:21:00,460 --> 00:21:02,650
"!ثافح! ثافح"

262
00:21:11,040 --> 00:21:15,040
الحلقة الرّابعة والثّلاثين
هجوم السّاكاباتو الأوّل

263
00:22:45,000 --> 00:22:50,010
الحلقة القادمة
هيكو سيجورو

264
00:22:46,400 --> 00:22:49,540
."في الحلقة القادمة: "هيكو سيجورو