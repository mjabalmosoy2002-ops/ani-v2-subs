1
00:00:06,040 --> 00:00:08,270
.السّعي خلف سيف ساكاباتو

2
00:00:09,110 --> 00:00:13,500
بما أنّ أراي شاكّو قد توفيّ الآن، قرّر
.هيمورا كنشين اللّجوء لابنه سيكو

3
00:00:13,660 --> 00:00:14,650
!ولكن

4
00:00:15,200 --> 00:00:19,910
قرّر سيكو الّذي يسعى للسّلام
.التّوقّف عن صناعة السّيوف

5
00:00:20,760 --> 00:00:25,580
،أمّا كنشين النّبيل والشّريف
.فقد رفض الضّغط عليه

6
00:00:26,850 --> 00:00:30,970
ورغم إحباطه، بدأ البحث عن
.سيف ساكاباتو جديد من البداية

7
00:00:34,230 --> 00:00:36,200
!إنّك نبيل أكثر من اللاّزم

8
00:00:37,010 --> 00:00:40,520
.إنّ ذلك الخرِع لم يتحلّ ولو بذرّة شجاعة

9
00:00:40,660 --> 00:00:44,000
!إن أصررتَ عليه أكثر، كان ليصنع لك سيفًا

10
00:00:44,140 --> 00:00:45,000
.كلاّ

11
00:00:46,920 --> 00:00:49,280
.يعيش سيكو-دونو حياة مسالمة الآن

12
00:00:49,410 --> 00:00:52,530
بأيّ حقّ أطلب منه التّخلّي عن ذلك؟

13
00:00:52,660 --> 00:00:55,230
.إنّك بالفعل نبيل أكثر من اللاّزم

14
00:00:55,530 --> 00:00:58,150
،حتّى لو كنّا قد أجبرناه

15
00:00:58,290 --> 00:01:02,040
.فلن يكون لسيف صُنع بالإكراه أيّ روح

16
00:01:02,210 --> 00:01:06,340
إن واجه سيتا سوجيرو
،الّذي كسر سيفه السّابق

17
00:01:06,480 --> 00:01:08,630
...أو شيشيو ماكوتو بسيف كهذا

18
00:01:09,130 --> 00:01:11,840
.فسيفقد هيمورا-كُن حياته

19
00:01:14,180 --> 00:01:17,380
إنّه لا يحتاج لسيف ساكاباتو
.بغرض العرض فحسب

20
00:01:17,540 --> 00:01:19,190
على سيفه الجديد

21
00:01:19,320 --> 00:01:22,520
.أن يتجاوز السّيف الّذي كُسر بمراحل

22
00:01:22,780 --> 00:01:24,990
ألا تفهمين ذلك؟

23
00:01:25,130 --> 00:01:28,350
.يا إلهي، لقد ربّيتُ أكبر أغبياء البلدة بالفعل

24
00:01:28,810 --> 00:01:33,030
ما الّذي ستفعله حيال ذلك؟ –
...علينا اللّجوء إلى حدّادين آخرين –

25
00:01:34,380 --> 00:01:36,360
!عجوز خرف

26
00:01:39,410 --> 00:01:42,190
"!ثافح! ثافح"

27
00:01:42,870 --> 00:01:44,560
.هذا أفضل

28
00:01:44,930 --> 00:01:48,050
،لو أنّي أقنعتُ سيكو-دونو بصنع سيف لي

29
00:01:48,210 --> 00:01:50,920
.لجعلَته جماعة شيشيو يدفع ثمن ذلك

30
00:01:52,090 --> 00:01:55,990
أرفض إلحاق الأذى بهذه العائلة
.الّتي تزدهر في سلام حقبة ميجي

31
00:01:57,340 --> 00:01:59,200
.وكذلك الوضع لمطعم أوُيْيا

32
00:01:59,920 --> 00:02:02,880
رغم أنّ أفراده أعضاء سابقون
،في الأونيوابانشو

33
00:02:03,030 --> 00:02:06,340
.فلن ينجّيهم ذلك من بطش شيشيو ورجاله

34
00:02:06,780 --> 00:02:09,330
،بمجرّد إيجاد الرّجل الآخر

35
00:02:09,510 --> 00:02:10,820
.سأغادر هذا المكان

36
00:02:11,150 --> 00:02:13,690
!أودّ أن أذكّرك أنّنا نبذل الكثير لأجلك هنا

37
00:02:13,860 --> 00:02:16,530
!لذلك على الأقلّ لا تشرد هكذا

38
00:04:02,250 --> 00:04:05,680
.يا له من ترحيب يا هوجي

39
00:04:06,150 --> 00:04:09,170
هل تولّيت أمر المهمّة الّتي أوكلتُها لك؟

40
00:04:09,400 --> 00:04:10,310
.نعم

41
00:04:10,540 --> 00:04:13,310
.تمّ توفير كلّ الأسلحة كما خطّطنا

42
00:04:14,730 --> 00:04:16,860
بالمناسبة، أين هو سوجيرو؟

43
00:04:17,030 --> 00:04:21,150
أرسلتُه لجمع أعضاء السّيوف
.العشرة المنتشرين في الشّرق

44
00:04:21,610 --> 00:04:25,390
لن يكون من السّهل العثور على
.بعضهم مثل أنجي

45
00:04:25,780 --> 00:04:29,460
لذا قمتُ بنفسي بإرسال رسائل
.إلى الأعضاء في الغرب

46
00:04:30,090 --> 00:04:31,120
...هذا يعني

47
00:04:31,640 --> 00:04:32,590
...نعم

48
00:04:36,550 --> 00:04:39,100
،بمجرّد اجتماع السّيوف العشرة

49
00:04:39,260 --> 00:04:40,940
.سيبدأ غزونا لهذه البلاد

50
00:04:43,390 --> 00:04:46,260
!شيشيو-ساما! شيشيو-ساما! شيشيو-ساما

51
00:04:50,560 --> 00:04:52,630
!أسمعتم يا رفاقي؟

52
00:04:52,760 --> 00:04:55,080
!لقد حان الوقت لنشرع في ثورتنا أخيرًا

53
00:04:55,230 --> 00:04:58,230
!كونوا على أهبة الاستعداد

54
00:04:58,370 --> 00:05:02,740
!شيشيو-ساما! شيشيو-ساما! شيشيو-ساما

55
00:05:04,150 --> 00:05:06,950
"أسمعتم يا رفاقي؟"

56
00:05:07,490 --> 00:05:09,990
ألا ترى أنّك بالغت كثيرًا في عرضك ذاك؟

57
00:05:10,130 --> 00:05:13,430
على العكس، أنا منغمس في الكامل
.في دوري كضابط عسكريّ

58
00:05:13,560 --> 00:05:17,030
لذلك، سأغادر الآن لإبلاغ
.قوّاتنا في كلّ أرجاء البلاد

59
00:05:17,160 --> 00:05:18,000
.انتظر

60
00:05:19,500 --> 00:05:21,610
.لم أقل كلّ ما لديّ بعد

61
00:05:22,240 --> 00:05:25,840
.سيأخذ جمع كلّ السّيوف العشرة وقتًا

62
00:05:25,980 --> 00:05:30,170
،وبعد كلّ هذا الخمول
.أراهن أنّهم كالجالس على الجمر

63
00:05:30,410 --> 00:05:32,770
،بدل إرسالهم للمشاركة في ثورتنا

64
00:05:32,910 --> 00:05:35,890
لنضعهم في طريق سلاح
.الحكومة السّرّيّ الوحيد

65
00:05:36,320 --> 00:05:39,360
ستكون مواجهتهم لهيمورا الباتّوساي
.إحماءً كافيًا لهم

66
00:05:41,710 --> 00:05:43,040
.مفهوم

67
00:05:43,170 --> 00:05:48,890
إذًا فهذا هو السّبب الّذي جعلك
.تطلب منّي مراقبة الباتّوساي

68
00:05:49,520 --> 00:05:51,080
!أنا أعترض

69
00:05:51,210 --> 00:05:53,040
،السّيوف العشرة هم سلاحنا

70
00:05:53,180 --> 00:05:58,820
إنّهم وحدة من النّخبة لا تحفّظات
.لها لاغتيال مسؤولين حكوميّين

71
00:05:58,970 --> 00:06:04,210
لذلك فإنّ استعمالهم لمجابهة
!الباتّوساي سيكون قمّة في الغباء

72
00:06:04,390 --> 00:06:07,380
.ألم أخبرك؟ لا يهتمّ هوجي لخطّتك أبدًا

73
00:06:08,120 --> 00:06:10,560
أنا أعترف أنّه كانت لديّ نفس
.ردّة الفعل في البداية

74
00:06:10,710 --> 00:06:14,610
.لكن لا داعي للقلق
.بإمكاننا وضع ثقتنا في السّيوف العشرة

75
00:06:14,770 --> 00:06:17,770
.نعم، يومي محقّة تمامًا

76
00:06:18,400 --> 00:06:20,140
.نحن السيّوف العشرة

77
00:06:20,270 --> 00:06:23,400
.لن نُهزم أبدًا أمام هيتوكيري وضيع

78
00:06:24,010 --> 00:06:25,860
.أرى أنّك هنا سلفًا يا تشو

79
00:06:26,000 --> 00:06:28,380
.نعم، أوساكا قريبة جدًّا من هنا

80
00:06:28,500 --> 00:06:32,290
إضافة إلى أنّي وسيوفي متشوّقون
.جدًّا لنظهر معدننا الحقيقيّ

81
00:06:32,420 --> 00:06:33,620
.لا تستعجل

82
00:06:33,960 --> 00:06:36,290
.انتظر إلى أن يصل بعضة آخرون من زملائك

83
00:06:36,820 --> 00:06:39,660
هوجي، أنعرف مكان الباتّوساي؟

84
00:06:41,260 --> 00:06:43,650
.ما زلنا لم نحدّد مكانه بالضّبط

85
00:06:43,790 --> 00:06:47,250
،لكن قبل وقت ليس ببعيد
قام بزيارة أراي سيكو

86
00:06:47,380 --> 00:06:50,380
.وهو ابن حدّاد السّيوف الموهوب أراي شاكّو

87
00:06:50,760 --> 00:06:55,090
لا بدّ أنّه يبحث عن بديل للسّاكاباتو
.الّذي كسره سوجيرو

88
00:06:55,220 --> 00:06:56,060
وبعد؟

89
00:06:56,460 --> 00:06:59,620
يبدو أنّ سيكو قد رفض طلب
.صنع سيف جديد له

90
00:06:59,780 --> 00:07:04,860
حتّى أنّه لم يبعه آخر سيف
.قيل أنّ أباه صنعه قبل موته

91
00:07:07,500 --> 00:07:11,410
أقلت آخر سيف صنعه أراي شاكّو؟

92
00:07:11,570 --> 00:07:14,120
.يا لها من أخبار جيّدة

93
00:07:16,690 --> 00:07:19,830
.هدّئ من روعك. لا تقم بأيّ شيء متهوّر

94
00:07:19,980 --> 00:07:21,000
.مفهوم

95
00:07:21,780 --> 00:07:23,260
...ذلك الفتى

96
00:07:23,400 --> 00:07:27,330
.تتغيّر ملامحه دائمًا عند الحديث عن السّيوف

97
00:07:27,960 --> 00:07:30,800
.سأذهب للحمّام للتّخلّص من عناء الطّريق

98
00:07:31,170 --> 00:07:34,540
.سأنتظرك في الغرفة، فلا تجعلني أنتظر طويلاً

99
00:07:34,850 --> 00:07:35,760
.حسنًا

100
00:07:37,240 --> 00:07:40,410
.شيشيو-ساما، لا زلتُ معترضًا على قرارك

101
00:07:40,540 --> 00:07:42,580
،قد يكون أضعف الآن بالفعل

102
00:07:42,700 --> 00:07:45,900
.لكن لا يزال هيمورا الباتّوساي قاتلاً أسطوريًّا

103
00:07:46,040 --> 00:07:48,950
إن استطاعت مواجهته للسّيوف العشرة

104
00:07:49,090 --> 00:07:53,380
،أن توقظ أيّام مجده السّابقة
!فسيُعرقل ذلك ثورتنا

105
00:07:53,520 --> 00:07:55,280
.لا أهتمّ على الإطلاق

106
00:07:56,450 --> 00:07:57,790
،إن حدث ذلك

107
00:07:57,930 --> 00:08:01,010
.سأتولّى شخصيًّا الإطاحة بالباتّوساي

108
00:08:01,140 --> 00:08:03,330
.وهو أمر لا أمانعه على الإطلاق

109
00:08:04,940 --> 00:08:08,760
لكنّ السّيوف العشرة تضمّ
،سوجيرو وأوسوي

110
00:08:08,900 --> 00:08:11,250
لذلك ففرص حدوث ذلك
.تكاد تكون منعدمة

111
00:08:11,380 --> 00:08:15,050
.سأكون راضيًا مهما كانت النّتيجة

112
00:08:23,900 --> 00:08:28,020
.كما توقّعت. لا شيء قد ينال من هذا الرّجل

113
00:08:43,740 --> 00:08:45,700
!مكنسة! مكنسة

114
00:08:46,650 --> 00:08:48,550
!كم تحبّ المزاح يا صغير

115
00:08:48,710 --> 00:08:49,870
!خذ

116
00:08:50,070 --> 00:08:51,100
كينداما؟

117
00:08:51,230 --> 00:08:53,100
!بابا بارع

118
00:08:53,230 --> 00:08:55,600
فعلاً؟ أوالدك بارع لتلك الدّرجة؟

119
00:08:55,740 --> 00:09:00,310
،أنا بارع أيضًا! لم أجربّها من قبل
!لكنّ ذلك لن يمنعني

120
00:09:00,640 --> 00:09:03,460
!راقب جيّدًا أيّها الصّغير

121
00:09:03,590 --> 00:09:05,270
.أنت تواجه محترفًا

122
00:09:06,050 --> 00:09:08,020
!لنبدأ... أجل

123
00:09:09,860 --> 00:09:11,340
!فشلت، فشلت

124
00:09:11,480 --> 00:09:15,610
.انسَ ذلك. كنت أقوم بالإحماء فحسب

125
00:09:17,860 --> 00:09:21,110
.شاهد، سأنجح في المرّة القادمة

126
00:09:26,290 --> 00:09:28,460
!هيّا! ماذا؟ كلاّ

127
00:09:35,290 --> 00:09:38,050
مرحبًا بك. هل تبحث عن شيء ما؟

128
00:09:38,690 --> 00:09:40,160
.يكفي لعبًا

129
00:09:42,980 --> 00:09:45,930
.أنا أبحث عن آخر أعمال شاكّو

130
00:09:51,670 --> 00:09:52,810
أهو لديك؟

131
00:09:55,140 --> 00:09:57,180
هل أنت بخير يا هيمورا-كُن؟

132
00:09:57,320 --> 00:09:58,570
.نوعًا ما

133
00:09:58,730 --> 00:10:01,650
!هنالك حدّ لهرائك! اعتذري

134
00:10:01,790 --> 00:10:05,040
.إنّها غلطتي لو سحمت، كان انتباهي مشتّتًا

135
00:10:05,420 --> 00:10:10,250
على أيّ حال، عليك نسيان
.أن يصنع سيكو سيفًا لك

136
00:10:10,500 --> 00:10:11,710
.بكلّ تأكيد

137
00:10:12,180 --> 00:10:13,530
...ولكن

138
00:10:15,180 --> 00:10:16,170
أبي؟

139
00:10:16,570 --> 00:10:18,340
آخر أعماله؟

140
00:10:18,680 --> 00:10:21,860
.نعم. هذا ما سمعتُ به

141
00:10:21,990 --> 00:10:25,180
يقال أنّ أراي شاكّو العظيم صنع
.سيفًا أخيرًا قبل موته

142
00:10:25,800 --> 00:10:29,140
أتمانع لو ألقيت نظرة عليه؟

143
00:10:29,470 --> 00:10:32,460
من أين سمع بأمر السّيف؟

144
00:10:33,730 --> 00:10:36,690
أعتذر، لا أدري عمّ تتحدّث؟

145
00:10:36,930 --> 00:10:40,730
لا نعرف أيّ شيء عن آخر
.سيف صنعه أبي

146
00:10:40,880 --> 00:10:43,160
.ما عدت أملك أيًّا من أعماله

147
00:10:48,040 --> 00:10:52,030
.للأسف، لا بدّ أنّي كنتُ مخطئًا

148
00:10:52,330 --> 00:10:54,210
.أعتذر بشدّة

149
00:10:55,240 --> 00:10:56,470
.أرجو ألاّ تلوماني على هذا

150
00:10:56,600 --> 00:11:01,680
إنّني في الحقيقة أحبّ السّيوف
.بجنون وأتوق لتجربتها كلّها

151
00:11:01,810 --> 00:11:04,300
.لذلك السّبب صرت سيّافًا

152
00:11:08,020 --> 00:11:09,050
ما الّذي تفعله؟

153
00:11:09,180 --> 00:11:10,730
.انتظر وسترى

154
00:11:21,450 --> 00:11:22,360
!إيوري

155
00:11:37,590 --> 00:11:40,210
.إنّ هذه تقنية إغماد السّيف في الهواء

156
00:11:40,350 --> 00:11:42,680
.إنّها ليست أمرًا يبرع فيه الكثير من النّاس

157
00:11:43,020 --> 00:11:44,060
.أجل

158
00:11:45,120 --> 00:11:49,890
عندما أخبرتني أنّك لا تملك
.السّيف، صُدمت للغاية

159
00:11:50,120 --> 00:11:52,790
،أنا أحبّ كلّ السّيوف بالفعل

160
00:11:52,920 --> 00:11:56,750
لكنّ سيوف شاكّو تحمل مكانة
.مميّزة في قلبي

161
00:11:56,890 --> 00:11:59,700
.هذا ليس جيّدًا على الإطلاق

162
00:12:00,610 --> 00:12:03,780
.أخشى أنّي قد أفشل في محاولتي التّالية

163
00:12:04,820 --> 00:12:05,740
!إيوري

164
00:12:07,310 --> 00:12:08,370
!يا عزيزي

165
00:12:09,420 --> 00:12:14,620
ليس من عادتي فعلاً القيام
.بنفس الخدعة مرّتين على التّوالي

166
00:12:14,830 --> 00:12:18,800
!تراجعا واستمتعا بالعرض

167
00:12:19,050 --> 00:12:20,630
!متّعا أنظاركما

168
00:12:21,360 --> 00:12:24,170
.انتظر! سيف والد زوجي ليس هنا

169
00:12:24,320 --> 00:12:25,220
!أزوسا

170
00:12:27,180 --> 00:12:31,920
،لقد تمّ إهداء آخر أعماله
!إنّه موجود في ضريح هاكوسان

171
00:12:32,070 --> 00:12:34,200
.إذًا فأنتما تعرفان بالفعل أين مكانه

172
00:12:34,340 --> 00:12:38,150
.ليس من اللّطيف أن تكذبا هكذا

173
00:12:38,590 --> 00:12:40,970
.حسنًا، أظنّني سأمرّ على المكان

174
00:12:41,100 --> 00:12:46,030
سأحتفظ بالطّفل حتّى أتأكّد
.من أنّكما تقولان الحقيقة

175
00:12:49,590 --> 00:12:52,700
.وإيّاكما أن تلجآ للشّرطة أيضًا

176
00:12:52,840 --> 00:12:57,990
أنا لستُ خائفًا منهم من الأساس، لكن
.طلب منّي شيشيو-ساما ألاّ أجلب الأنظار

177
00:12:58,320 --> 00:13:00,550
...لذلك لا تخبرا أحدًا بالأمر

178
00:13:01,190 --> 00:13:03,380
أم عليّ إخباركما بالعواقب؟

179
00:13:03,510 --> 00:13:06,220
!سنلتزم الصّمت! لا تؤذ إيوري فحسب

180
00:13:42,790 --> 00:13:46,010
.أنا بارع أكثر باستعمال السّيف

181
00:13:53,590 --> 00:13:58,040
.يحتاج هيمورا لسيف جديد
.سأقوم بإقناع ذلك الخرِع

182
00:13:58,180 --> 00:14:00,280
لماذا أخبرته؟

183
00:14:01,620 --> 00:14:05,360
لقد صنع أبي ذلك السّيف
.بنيّة أن يصير سيفًا مقدّسًا

184
00:14:05,510 --> 00:14:08,360
.لم يتمّ استلاله من غمده من قبل أبدًا

185
00:14:08,630 --> 00:14:12,570
إنّه السّيف الوحيد من سيوفه
.الّذي لم يلطّخ بالدّماء بعد

186
00:14:13,150 --> 00:14:15,240
،إن تلطّخ هذا السّيف بالدّماء

187
00:14:15,390 --> 00:14:17,410
.فسيفقد أبي ما تبقّى له من كرامة

188
00:14:17,620 --> 00:14:21,210
،لن يُعتبر حدّاد سيوف
.بل الرّجل الّذي صنع أدوات قتل

189
00:14:21,430 --> 00:14:22,840
...ورغم ذلك

190
00:14:23,070 --> 00:14:26,660
،لو لم أقل أيّ شيء
ماذا كان سيحلّ بإيوري في رأيك؟

191
00:14:26,820 --> 00:14:31,030
،أعرف أنّ شرف والدك مهمّ
!لكنّه هدّد حياة ابننا

192
00:14:31,180 --> 00:14:34,060
هل رأيت عيني ذلك الرّجل؟

193
00:14:34,490 --> 00:14:37,420
.لم يكن محبّ سيوف عاديّ فحسب

194
00:14:37,660 --> 00:14:38,890
...إنّ عيناه

195
00:14:39,500 --> 00:14:42,470
!كانت عينا رجل يحبّ سلب الأرواح

196
00:14:43,670 --> 00:14:46,900
...إن عثر على سيف أبي

197
00:14:47,050 --> 00:14:48,460
.فلن يتردّد أبدًا

198
00:14:48,610 --> 00:14:52,140
!سيسرع لتجربته في الحال

199
00:14:52,680 --> 00:14:53,820
...سُحقًا

200
00:14:54,170 --> 00:14:58,880
.تخلّيتُ عن صنع السّيوف
فلماذا يحدث هذا لي؟

201
00:14:59,520 --> 00:15:01,450
!أخبراني بكلّ شيء بالتّفصيل

202
00:15:03,760 --> 00:15:04,960
!أيّتها الجدّة أوشيغي

203
00:15:05,110 --> 00:15:08,710
!مرحبًا يا ميساو-تشان
.أرى أنّك عدت لكيوتو

204
00:15:08,860 --> 00:15:12,040
.لديّ رسالة لجدّي
!استعملي الرّو الأوّل

205
00:15:12,440 --> 00:15:13,430
.في الحال

206
00:15:21,020 --> 00:15:24,440
.إنّها رسالة من شيغي
.إنّه الرّو الأوّل لديها

207
00:15:25,260 --> 00:15:28,820
إنّها طريقة تواصل تستعملها
.شبكة الأونيوابانشو

208
00:15:29,030 --> 00:15:31,860
تنقسم كيوتو إلى أحياء حسب
،التّسلسل الأبجديّ

209
00:15:32,010 --> 00:15:35,230
،وينقسم كلّ واحد منها لثلاثة
.ليكون المجموع هو 141

210
00:15:35,370 --> 00:15:39,880
.تنتقل المعلومات بسرعة كما ترى

211
00:15:40,140 --> 00:15:41,960
.ماذا؟ إنّها من ميساو

212
00:15:42,120 --> 00:15:44,920
...غادرت دون أن تقول إلى أين

213
00:15:50,700 --> 00:15:55,340
.اختطف أحد أتباع شيشيو ابن سيكو

214
00:15:56,520 --> 00:15:59,890
!انتظر يا هيمورا-كُن
!السّاكاباتو خاصّتك مكسور

215
00:16:00,060 --> 00:16:03,020
!ستكون لخصمك أفضليّة كبيرة عليك

216
00:16:03,940 --> 00:16:05,660
...هيمورا-كُن

217
00:16:10,650 --> 00:16:13,240
.أخذ منّي هذا الأمر وقتًا

218
00:16:13,380 --> 00:16:16,910
.إنّ تصميم مدينة كيوتو سخيف للغاية

219
00:16:17,140 --> 00:16:20,460
...لا بأس، آخر أعمال ساكّو

220
00:16:20,610 --> 00:16:23,010
...أتساءل أيّ نوع من أسلحة الموت يكون

221
00:16:31,160 --> 00:16:32,550
"!رجاءً"

222
00:16:35,670 --> 00:16:39,060
.لا تبدو لي كشخص أتى لزيارة الضّريح

223
00:16:39,210 --> 00:16:40,690
من تكون؟

224
00:16:48,720 --> 00:16:51,230
ندبة على شكل تقاطع على خدّه الأيسر؟

225
00:16:53,440 --> 00:16:54,690
!فهمت

226
00:16:54,820 --> 00:16:58,120
إذًا فأنت هو الهيتوكيري باتّوساي الشّهير؟

227
00:16:58,270 --> 00:17:01,210
.ظننتُ أنّك ستكون أطول

228
00:17:01,360 --> 00:17:04,330
.تبدو مثل امرأة

229
00:17:04,700 --> 00:17:05,970
.ذلك لا يهمّ

230
00:17:06,190 --> 00:17:10,550
حسنًا، هل أتيت لاختبار آخر
أعمال شاكّو أيضًا؟

231
00:17:10,890 --> 00:17:15,350
لسوء الحظّ، أنا أبحث عن نوع
.مختلف من السّيوف

232
00:17:15,590 --> 00:17:18,500
.إن كنت تريد سيف شاكّو، فخذه

233
00:17:19,020 --> 00:17:21,530
.ولكن اترك الطّفل أوّلاً

234
00:17:21,890 --> 00:17:25,790
أتحاول تجنّب قتال غير ضروريّ
بهذه الطّريقة؟

235
00:17:25,950 --> 00:17:29,470
.فحسب اعتقادي، سيفك السّاكاباتو مكسور

236
00:17:29,620 --> 00:17:34,580
عليّ الاعتراف، لستُ متحمّسًا
.لقتال رجل لا يريد القتال

237
00:17:34,710 --> 00:17:38,780
ولكن إن اعترض طريقي عدوّ
،رسميّ لنا ولم أواجهه

238
00:17:39,160 --> 00:17:42,100
.فأعتقد أنّ شيشيو-ساما سيقتلني

239
00:17:42,520 --> 00:17:43,550
...إضافة لذلك

240
00:17:45,680 --> 00:17:48,710
،إن حصلتُ على سيف شاكّو الأخير

241
00:17:49,030 --> 00:17:52,210
.فسأحتاج لشيء ما لأجرّبه

242
00:17:53,620 --> 00:17:58,430
.ولطالما أردتُ تقطيع طفل

243
00:18:00,070 --> 00:18:03,480
.لذلك أنا أرفض طلبك

244
00:18:03,620 --> 00:18:06,060
.لنتواجه رجلاً لرجل

245
00:18:06,200 --> 00:18:08,870
،تعلم أنّ سيفي مكسور
،ولديك رهينة

246
00:18:09,020 --> 00:18:11,270
ومع ذلك تتحدّث عن قتال رجل لرجل؟

247
00:18:11,700 --> 00:18:13,200
.إنّك تسخر منّي

248
00:18:13,350 --> 00:18:15,550
.لا أسخر منك على وجه التّحديد

249
00:18:15,700 --> 00:18:18,200
!أسخر من تصرّفك المتغطرس فحسب

250
00:18:19,890 --> 00:18:20,950
!خذ هذا

251
00:18:22,980 --> 00:18:25,200
إن كنت تريد قتلي

252
00:18:25,340 --> 00:18:28,290
فهاجم بتقنية أقوى من تقنية
.غاتوتسو الخاصّة بسايتو

253
00:18:30,550 --> 00:18:32,090
.أسلوب هيتن ميتسوروغي

254
00:18:32,440 --> 00:18:34,020
!وميض التّنّين الملتفّ

255
00:18:41,170 --> 00:18:45,470
،فهمت. قد تبدو ضعيفًا
.لكنّ ضرباتك قويّة

256
00:18:45,840 --> 00:18:50,060
لكنتُ قد تأذّيتُ بشدّة
.لو لم أملك سيوفًا في ظهري

257
00:18:50,250 --> 00:18:51,410
،ومع ذلك

258
00:18:51,560 --> 00:18:54,730
.ستندم لأنّك أغضبتني

259
00:18:55,450 --> 00:18:59,990
،إليك واحدًا من أعمال شاكّو الأولى
!السّيفين التّوأم

260
00:19:00,340 --> 00:19:04,990
بوجود نصلين قريبين من بعضهما
،هكذا، ستتكبّد إصابتين قريبتين

261
00:19:05,120 --> 00:19:07,830
.وسيكون من الصّعب تقطيب ذلك

262
00:19:07,960 --> 00:19:09,120
...بمعنى آخر

263
00:19:09,120 --> 00:19:13,580
حتّى إن لم أصب أعضاءك الحيويّة، فإنّ
.أيّ جرح من هذا السّيف سيكون قاتلاً

264
00:19:13,710 --> 00:19:17,090
!ستموت بعد أن تلتهمك الغنغرينا

265
00:19:20,190 --> 00:19:22,630
أهذا هو كلّ ما في جعبتك؟

266
00:19:25,340 --> 00:19:26,850
.أسلوب هيتن ميتسوروغي

267
00:19:28,150 --> 00:19:29,620
!وميض التّنّين المحلّق

268
00:19:34,620 --> 00:19:37,910
.آسف لأنّك اضطررت للانتظار
.سأنزلك في الحال

269
00:19:39,470 --> 00:19:41,340
.مفهوم

270
00:19:42,020 --> 00:19:44,120
.كنتَ على حقّ

271
00:19:44,440 --> 00:19:49,200
.لقد بالغت في السّخرية منك بالفعل

272
00:19:49,440 --> 00:19:53,420
أصبتُه في نقطة حيويّة
ومع ذلك بإمكانه النّهوض؟

273
00:19:54,900 --> 00:19:57,840
.آسف يا إيوري. سيأخذ هذا وقتًا أطول

274
00:19:57,980 --> 00:20:01,680
!كفّ عن الحديث مع الطّفل
!انظر إليّ أنا أيّها الغبيّ

275
00:20:01,820 --> 00:20:04,010
!سأقتل هذا الشّقيّ إن تجاهلتني ثانية

276
00:20:06,520 --> 00:20:10,300
عجبًا، تبدو كقاتل بالفعل
.عندما ترغب في ذلك

277
00:20:10,430 --> 00:20:13,060
.لا يجب عليك أن تخدع الآخرين

278
00:20:13,210 --> 00:20:17,720
لو أنّك أريتني هذه النّظرة
.من البداية، لبذلتُ كلّ قوّتي أيضًا

279
00:20:19,920 --> 00:20:21,900
.درع فضّيّة

280
00:20:22,380 --> 00:20:24,860
.ذلك هو سبب نجاته من وميض التّنّين المحلّق

281
00:20:28,980 --> 00:20:33,750
!تأخّرت كثيرًا يا جدّي
!أرسلتُ لك أفضل حمامة

282
00:20:33,890 --> 00:20:34,940
ماذا عن هيمورا؟

283
00:20:35,080 --> 00:20:38,440
.انطلق بمجرّد أن عرف بالأمر
.لم أستطع اللّحاق به

284
00:20:38,580 --> 00:20:42,330
!لكنّ سيفه مكسور
.لذلك السّبب طلبتُ مساعدتك أنت

285
00:20:42,480 --> 00:20:43,510
!لنسرع

286
00:20:46,790 --> 00:20:48,550
!بدأت المعركة سلفًا

287
00:20:49,540 --> 00:20:50,390
...ذلك

288
00:20:55,200 --> 00:20:59,080
انتبه! ما لدى ذلك الرّجل حول
!خصره ليس درعًا

289
00:20:59,480 --> 00:21:03,210
.إنّه سيف قضى أبي شهورًا في تطويره

290
00:21:03,340 --> 00:21:05,770
!إنّه أحد سيوفه المميتة

291
00:21:07,330 --> 00:21:10,910
،أنا صيّاد السّيوف تشو
.أحد السّيوف العشرة

292
00:21:11,060 --> 00:21:13,920
.ليبدأ الجنون الآن

293
00:22:46,380 --> 00:22:49,420
."في الحلقة القادمة: "استلال السّيف المحرّم