1
00:00:06,770 --> 00:00:07,760
من تكون؟

2
00:00:07,880 --> 00:00:09,140
!أيّها الوغد

3
00:00:10,040 --> 00:00:14,110
لا أرى أيّ فائدة من التّعريف عن
.نفسي لرجال يوشكون على الموت

4
00:00:16,310 --> 00:00:17,370
!لنقم بهذا

5
00:00:34,500 --> 00:00:36,970
.كان حظّك تعيسًا يا فتى

6
00:00:37,550 --> 00:00:41,560
تداعى كلّ شيء منذ وصول
.السّفن السّوداء قبل سنتين

7
00:00:41,680 --> 00:00:44,200
.تحوّل العديد من السّاموراي لقطع الطّريق

8
00:00:44,740 --> 00:00:47,400
.ووضعني القدر على طريقهم

9
00:00:47,580 --> 00:00:49,680
.لقد تمّ الانتقام لك مهما كان الوضع

10
00:00:53,420 --> 00:00:57,770
.لن يُعيدهم غضبك ولا حتّى دموعك للحياة

11
00:00:58,450 --> 00:01:00,920
إنّ مثل هذه المآسي صارت أمرًا شائعًا

12
00:01:01,040 --> 00:01:03,290
.في اليابان الحاليّة

13
00:01:04,070 --> 00:01:07,630
.اعتبر نفسك محظوظًا لأنّك نجوت

14
00:01:09,180 --> 00:01:11,460
.انزل إلى القرية الّتي في أسفل الجبل

15
00:01:11,650 --> 00:01:14,920
.سيعتني بك سكّانها

16
00:01:31,520 --> 00:01:34,830
.كانت هذه ذكريات قديمة جدًّا

17
00:01:35,900 --> 00:01:38,780
أنت! إلى متى تنوي البقاء
مستلقيًا على الأرض؟

18
00:01:39,150 --> 00:01:40,490
.انهض أيّها المتكاسل

19
00:03:14,960 --> 00:03:18,960
الحلقة التّاسعة والثّلاثين
بين الحياة والموت

20
00:03:19,840 --> 00:03:21,930
.قلتُ لك انهض أيّها التّلميذ الغبيّ

21
00:03:24,540 --> 00:03:28,520
.إن لم تنهض، سأواصل الغوص أكثر في الماضي

22
00:03:28,880 --> 00:03:32,170
.مثل آخر مرّة بلّلتَ فيها فراشك

23
00:03:32,300 --> 00:03:34,520
كنتَ في الحادية عشرة حينها، صحيح؟

24
00:03:34,880 --> 00:03:38,100
أو مثل المرّة الّتي أكلت فيها
.فطرًا كاد يقتلك

25
00:03:38,230 --> 00:03:39,280
!يا معلّمي

26
00:03:39,650 --> 00:03:43,260
لماذا تذكر هذه الأوقات المحرجة
الّتي كنت قد نسيتها؟

27
00:03:43,380 --> 00:03:45,240
.إنّك لئيم بالفعل

28
00:03:45,450 --> 00:03:47,040
أنا لئيم؟

29
00:03:47,210 --> 00:03:49,930
مع أنّي كنتُ أتحمّل تلميذي الجاحد

30
00:03:50,060 --> 00:03:52,820
وتقلّبات مزاجه طوال أسبوع؟

31
00:03:52,990 --> 00:03:56,170
.بل يجب أن يتمّ الإشادة بصبري هنا

32
00:03:57,290 --> 00:03:58,130
...في كلّ الأحوال

33
00:03:58,660 --> 00:04:00,710
.بدأت هذه اللّعبة الصّغيرة تشعرني بالملل

34
00:04:01,410 --> 00:04:04,220
،عليك إصابتي في هجومك التّالي

35
00:04:04,340 --> 00:04:06,570
.وإلاّ فلن أعلّمك التّقنية السّرّيّة

36
00:04:08,090 --> 00:04:10,620
،المعلّم الحاليّ لأسلوب هيتن ميتسوروغي

37
00:04:10,960 --> 00:04:14,730
الثّالث عشر من بين من حملوا
.اسم هيكو سيجورو

38
00:04:15,410 --> 00:04:18,580
.هذا ليس وقتًا مناسبًا للتّهاون

39
00:04:19,310 --> 00:04:21,780
...إن كانت هذه فرصتي الأخيرة

40
00:04:22,420 --> 00:04:25,240
.عليّ بذل كلّ ما لديّ

41
00:04:28,900 --> 00:04:30,000
.سأهاجم

42
00:04:31,080 --> 00:04:32,160
.هلمّ

43
00:04:39,090 --> 00:04:40,670
...أسلوب هيتن ميتسوروغي

44
00:04:40,880 --> 00:04:42,340
!وميض مطرقة التنّين

45
00:04:42,500 --> 00:04:43,840
!وميض التّنّين المحلّق

46
00:04:53,660 --> 00:04:55,730
هل ستستمرّ في النّوم طويلاً؟

47
00:04:56,470 --> 00:04:58,150
.انهض بسرعة

48
00:05:02,850 --> 00:05:06,530
ركّزتَ على الهجوم على
.حساب كلّ شيء آخر

49
00:05:06,680 --> 00:05:09,770
،إن تهاونت في وضعيّتك أثناء نزولك

50
00:05:09,890 --> 00:05:11,770
.فسينتهي بك المطاف بارتجاج

51
00:05:12,050 --> 00:05:13,450
!يا لك من غبيّ

52
00:05:14,490 --> 00:05:15,660
،ومع ذلك

53
00:05:16,410 --> 00:05:18,050
أفترض أنّ هذا ما تطلّبه الأمر منك

54
00:05:18,170 --> 00:05:22,660
لتستطيع أخيرًا إصابتي بهجوم
.وتحطّم عشر سنوات من الفشل

55
00:05:24,070 --> 00:05:26,890
،بإمكاني التّعليق عن أشياء عدّة بشأن وضعيّتك

56
00:05:27,020 --> 00:05:28,800
.لكنّ الإصابة تظلّ إصابة

57
00:05:29,190 --> 00:05:31,930
.سأعلّمك التّقنية السّرّيّة كما وعدت

58
00:05:32,520 --> 00:05:33,780
.استعدّ

59
00:05:37,790 --> 00:05:41,170
.استمع جيّدًا، ولا تحرّك ساكنًا مهما حدث

60
00:05:41,890 --> 00:05:44,900
.سيكلّفك أصغر خطأ حياتك

61
00:05:46,200 --> 00:05:47,360
.لنراجع الأساسيّات

62
00:05:48,020 --> 00:05:50,630
.لننظر إلى مدى هجمات السّيوف القاتلة

63
00:05:51,310 --> 00:05:52,330
...لدينا بالتّرتيب

64
00:05:53,150 --> 00:05:54,040
،الهجوم النّازل

65
00:05:54,680 --> 00:05:55,540
،قُطريًّا من اليسار

66
00:05:56,200 --> 00:05:57,290
،قُطريًّا من اليمين

67
00:05:57,950 --> 00:05:58,870
،الجانب الأيمن

68
00:05:59,400 --> 00:06:00,580
،الجانب الأيسر

69
00:06:01,120 --> 00:06:02,290
،الهجوم الصّاعد يمينًا

70
00:06:02,810 --> 00:06:04,380
،الهجوم الصّاعد يسارًا

71
00:06:04,880 --> 00:06:06,480
.الهجوم العكسيّ

72
00:06:07,230 --> 00:06:09,930
.وأخيرًا، هجوم المدى القريب

73
00:06:11,100 --> 00:06:12,110
.الطّعن

74
00:06:13,190 --> 00:06:15,520
مهما كان أسلوبك، فإنّ الهجمات القاتلة

75
00:06:15,660 --> 00:06:18,600
تكون مبنيّة دائمًا على هذه
.الهجمات التّسعة الأساسيّة

76
00:06:18,850 --> 00:06:21,030
وبشكل مماثل، تطوّرت الأشكال الدّفاعيّة

77
00:06:21,150 --> 00:06:24,110
.لصدّ هذه الهجمات الأساسيّة

78
00:06:24,360 --> 00:06:25,320
...ولكن

79
00:06:37,050 --> 00:06:40,730
عن طريق دفع السّرعة الخارقة
،للطّبيعة لأسلوبنا إلى ذروتها

80
00:06:42,080 --> 00:06:45,630
صار من الممكن توجيه كلّ
.الهجمات التّسعة دفعة واحدة

81
00:06:47,750 --> 00:06:49,880
،أسلوب هيتن ميتسوروغي

82
00:06:50,740 --> 00:06:52,250
.وميض التّنّين تُساعيّ الرّؤوس

83
00:06:57,990 --> 00:07:01,320
،وكما هو عرين التّنّين
،فإنّ هذا الهجوم محيّر

84
00:07:01,450 --> 00:07:05,750
لكنّه لا يدمج الهجمات التّسعة
،في هجوم واحد فحسب

85
00:07:05,980 --> 00:07:07,950
.بل يضيف إليه اندفاعًا

86
00:07:08,070 --> 00:07:10,570
.وهذا يجعل من المستحيل تفاديه

87
00:07:11,520 --> 00:07:14,250
.وهي التّقنية الّتي أتفوّق فيها

88
00:07:14,880 --> 00:07:17,490
.كنتُ متسمّرًا في مكاني قبل ذلك الاندفاع

89
00:07:18,180 --> 00:07:19,710
.هذه هي التّقنية السّرّيّة إذًا

90
00:07:20,340 --> 00:07:23,500
،أسلوب هيتن ميتسوروغي
.وميض التّنّين تُساعيّ الرّؤوس

91
00:07:24,920 --> 00:07:27,650
.لا تقف هناك بلا حراك
.حان دورك لتجرّب

92
00:07:28,150 --> 00:07:30,220
ماذا؟ يُفترض بي تنفيذها؟

93
00:07:30,350 --> 00:07:32,340
بالطّبع، ما الّذي كنت تتوقّعه؟

94
00:07:32,600 --> 00:07:35,820
.تختبر التّقنية وثمّ تنفّذها بنفسك

95
00:07:35,940 --> 00:07:38,230
.يأتي الإتقان من كثرة التّدريب

96
00:07:38,700 --> 00:07:41,010
!هكذا علّمتك دائمًا

97
00:07:41,920 --> 00:07:43,850
!وميض التّنّين المحلّق! وميض مطرقة التّنّين

98
00:07:43,850 --> 00:07:45,110
!وميض التّنّين الملتفّ

99
00:07:45,610 --> 00:07:47,700
...لا أصدّق أنّي نجوت من كلّ ذلك

100
00:07:47,830 --> 00:07:52,150
.هذا لأنّي أتقنت فنوني بشكل مثاليّ

101
00:07:52,460 --> 00:07:55,280
.إن كنت تفهم ذلك، جرّب الهجوم

102
00:07:56,660 --> 00:07:58,240
.ابذل كلّ ما لديك

103
00:08:06,440 --> 00:08:08,940
.بالطّبع عجزت عن أيّ ردّة فعل

104
00:08:09,380 --> 00:08:12,320
.لكنّ تفاجئي من الأمر لم يمنعني من الملاحظة

105
00:08:13,590 --> 00:08:15,300
.أسلوب هيتن ميتسوروغي

106
00:08:17,440 --> 00:08:18,810
!وميض التّنّين تُساعيّ الرّؤوس

107
00:08:35,850 --> 00:08:37,810
!يا له من فشل ذريع

108
00:08:38,750 --> 00:08:42,250
.ظننتُ أنّ هجومي كان مثاليًّا

109
00:08:42,440 --> 00:08:44,580
.بل كان كذلك بالفعل

110
00:08:45,750 --> 00:08:49,400
ولكن لسوء الحظّ، من ناحية
قوّة الذّراعين والوزن

111
00:08:49,530 --> 00:08:52,050
،اللّذين يعتبران نقطة مهمّة أثناء الاندفاع

112
00:08:52,630 --> 00:08:56,180
.فإنّي أملك أفضليّة كبيرة مقارنة بك

113
00:08:56,520 --> 00:08:58,760
في مواجهة وميض التّنّين تُساعيّ
،الرّؤوس خاصّتي

114
00:08:59,200 --> 00:09:01,450
.لن يرتقي خاصّتك للمستوى المطلوب

115
00:09:01,580 --> 00:09:04,350
.ولا حتّى أيّ من تقنياتك الأخرى أيضًا

116
00:09:08,240 --> 00:09:11,950
واعلم أنّه في مواجهة وميض
،التّنّين تُساعيّ الرّؤوس خاصّتي

117
00:09:12,260 --> 00:09:14,570
.لا تنفع إلاّ تقنية واحدة

118
00:09:19,480 --> 00:09:22,710
إنّها التّقنية السّرّيّة الأقوى
.لأسلوب هيتن ميتسوروغي

119
00:09:23,140 --> 00:09:25,410
.وميض التّنّين الطّائر المقدّس

120
00:09:34,920 --> 00:09:37,430
لماذا تلك النّظرة المتفاجئة؟

121
00:09:37,940 --> 00:09:42,250
لم أذكر أبدًا أنّ وميض التّنّين تُساعيّ
.الرّؤوس كانت التّقنية السّرّيّة الأقوى

122
00:09:43,150 --> 00:09:45,730
.وهي التّقنية الّتي أتفوّق فيها

123
00:09:48,310 --> 00:09:49,870
.خُدعتُ ثانية

124
00:09:51,680 --> 00:09:54,420
إنّ وميض التّنّين تُساعيّ الرّؤوس
أشبه باختبار

125
00:09:54,540 --> 00:09:56,740
.أثناء محاولة نقل وميض التّنّين الطّائر المقدّس

126
00:09:57,200 --> 00:10:00,370
إن نجحتَ في صدّ وميض التّنّين
،تُساعيّ الرّؤوس القاتلة

127
00:10:00,490 --> 00:10:02,950
.فذلك يعني أنّك أتقنت التّقنية السّرّيّة الأقوى

128
00:10:03,630 --> 00:10:04,700
...ولكن

129
00:10:04,950 --> 00:10:08,830
تأمّل للحظة في طبيعة
.وميض التّنّين تُساعيّ الرّؤوس

130
00:10:09,150 --> 00:10:12,780
وعند القيام بذلك، ستُكشف لك
وميض التّنّين الطّائر المقدّس

131
00:10:12,900 --> 00:10:14,580
.وستتمكنّ من استخدامها

132
00:10:14,910 --> 00:10:17,120
طبيعة وميض التّنّين تُساعيّ الرّؤوس؟

133
00:10:29,070 --> 00:10:32,650
.إنّه هجوم لا يمكن تفاديه أو صدّه

134
00:10:33,010 --> 00:10:34,250
...الحلّ الوحيد هو

135
00:10:34,640 --> 00:10:38,900
كسر زخم الهجوم باستعمال
.تقنيات سحب السّيف

136
00:10:39,350 --> 00:10:40,930
.أحسنت عملاً

137
00:10:41,470 --> 00:10:44,850
.تقنية سحب سيف بسرعة تفوق سرعة التّنّين

138
00:10:45,080 --> 00:10:49,130
،تلك هي التّقنية السّرّيّة الأقوى
.وميض التّنّين الطّائر المقدّس

139
00:10:49,560 --> 00:10:53,870
،ولكن بما أنّك تستعمل ساكاباتو
.فإنّ في وضع غير مؤات سلفًا

140
00:10:54,000 --> 00:10:58,030
هل ستكون قادرًا على
التّفوّق على سرعة ضرباتي؟

141
00:11:08,020 --> 00:11:11,170
...سيفك في غمده مع وضعية استرخاء

142
00:11:11,560 --> 00:11:12,850
.إنّك تلعب بالنّار

143
00:11:13,280 --> 00:11:14,780
.أنا مدرك لذلك

144
00:11:14,940 --> 00:11:16,610
.لكنّ خياراتي محدودة

145
00:11:17,240 --> 00:11:19,050
عليّ قبول الموت

146
00:11:19,390 --> 00:11:22,360
.إن كنت أريد تعلّم التّقنية السّرّيّة الأقوى

147
00:11:33,480 --> 00:11:34,920
.سأمنحك ليلة واحدة

148
00:11:35,280 --> 00:11:37,580
ابحث في روحك حتّى الصّباح

149
00:11:37,700 --> 00:11:40,050
.وجد ما تفتقر له قبل ذلك

150
00:11:40,670 --> 00:11:42,170
،إن لم تستطع لك

151
00:11:42,330 --> 00:11:44,260
لن تتقن أبدًا التّقنية السّرّيّة الأقوى

152
00:11:44,540 --> 00:11:47,960
.وستفقد حياتك بغباء

153
00:12:09,170 --> 00:12:10,310
...عليّ أن

154
00:12:10,820 --> 00:12:12,370
أجد ما أفتقر له؟

155
00:12:19,990 --> 00:12:21,260
ألم ترَه؟

156
00:12:21,630 --> 00:12:22,660
.لا

157
00:12:22,940 --> 00:12:26,230
.لم نرَ فتى أو أيّ أحد منذ أسبوع

158
00:12:26,370 --> 00:12:27,220
.تفضّل

159
00:12:29,640 --> 00:12:33,480
أيعقل أنّه تخلّى عن حياته بسبب اليأس؟

160
00:12:34,090 --> 00:12:36,350
.للأسف، إنّه أمر شائع

161
00:12:37,310 --> 00:12:41,270
مع أنّي أحمل سيفًا مشبعًا بتعاليم
،أسلوب هيتن ميتسوروغي

162
00:12:41,630 --> 00:12:44,910
إلاّ أنّني لم أستطع إنقاذ العديد
.من النّاس في كثير من الأحيان

163
00:12:45,740 --> 00:12:48,530
في هذه الحقبة الّتي يخيّم
،عليها الظّلام أكثر فأكثر

164
00:12:48,780 --> 00:12:51,480
.أنا واثق من شيء واحد فقط

165
00:12:51,630 --> 00:12:54,880
.سيكون هنالك دائمًا ضحايا أدفنهم

166
00:13:10,920 --> 00:13:14,810
،أرى أنّك لم تدفن والديك فقط
ولكنّك دفنت قطّاع الطّرق أيضًا؟

167
00:13:15,350 --> 00:13:17,270
.كانوا تجّار عبيد

168
00:13:18,000 --> 00:13:20,910
.مات والداي بسبب الكوليرا قبل سنة

169
00:13:21,670 --> 00:13:22,670
...ولكن

170
00:13:23,020 --> 00:13:27,240
،لا يهمّ إن كانوا تجّار عبيد أم قطّاع طرق
.لا يمكن التّمييز بينهم بعد الموت

171
00:13:27,570 --> 00:13:30,300
.إذًا فقد دفنتهم جميعًا دون تمييز

172
00:13:31,530 --> 00:13:33,470
ماذا عن هذه القبور الثّلاثة؟

173
00:13:34,150 --> 00:13:37,920
إنّهنّ كاسومي-سان
!وأكاني-سان وساكورا-سان

174
00:13:38,850 --> 00:13:41,030
،كان والديهنّ غارقين في الدّيون

175
00:13:41,210 --> 00:13:44,130
.لذلك أُخذن من عائلاتهنّ

176
00:13:44,920 --> 00:13:49,300
،قابلتهنّ اليوم فقط
.وكنتُ الفتى الوحيد هنا

177
00:13:49,440 --> 00:13:50,970
.ويتيم

178
00:13:52,130 --> 00:13:55,850
.كنتُ عازمًا على حمايتهنّ بحياتي

179
00:13:57,080 --> 00:13:58,060
.لكنّي فشلت

180
00:13:59,940 --> 00:14:03,390
.كنتُ أودّ تزيين قبورهنّ بحجارة جميلة

181
00:14:03,580 --> 00:14:06,130
.لكن لم أعثر إلاّ على هذه الحجارة القبيحة

182
00:14:06,530 --> 00:14:08,750
،لذلك بحثت عن زهور

183
00:14:08,990 --> 00:14:10,820
.لكن لا شيء ينمو هنا

184
00:14:13,200 --> 00:14:14,540
.هذه عطيّة

185
00:14:19,610 --> 00:14:21,640
ما اسمك يا فتى؟

186
00:14:22,480 --> 00:14:23,710
.شينتا

187
00:14:24,030 --> 00:14:25,050
شينتا؟

188
00:14:36,980 --> 00:14:40,530
.إنّه اسم ليّن جدًّا ليحمله سيّاف

189
00:14:44,150 --> 00:14:45,780
،بدءًا من اليوم

190
00:14:46,380 --> 00:14:48,220
.سيصير اسمك كنشين

191
00:14:54,490 --> 00:14:56,350
،سأعلّمك ما أعرف

192
00:14:56,680 --> 00:14:58,470
.ستصير وريثي

193
00:15:16,130 --> 00:15:17,520
.إلى اليسار قليلاً

194
00:15:18,820 --> 00:15:20,690
.خنصرك في المكان الخطأ

195
00:15:21,860 --> 00:15:24,180
.إنّك تستعمل الكثير من القوّة

196
00:15:28,470 --> 00:15:30,330
.مرّت تسعة عشرة سنة

197
00:15:30,790 --> 00:15:31,660
...وغدًا

198
00:15:33,090 --> 00:15:35,870
،سواء نقلتُ إليك التّقنية السّرّيّة الأقوى أم لا

199
00:15:36,480 --> 00:15:39,180
.سيبزغ الفجر على فراقنا

200
00:15:46,220 --> 00:15:49,050
.يبدو أنّه لم يغمض لك جفن طوال اللّيل

201
00:15:49,310 --> 00:15:51,160
.وأنت أيضًا يا معلّمي

202
00:15:57,500 --> 00:16:00,390
أخبرني، هل عثرت على ما تفتقر له؟

203
00:16:02,030 --> 00:16:02,980
.لا

204
00:16:04,000 --> 00:16:05,200
.هكذا إذًا

205
00:16:06,630 --> 00:16:10,280
.خاب ظنّي، هذه هي حدودك إذًا

206
00:16:11,410 --> 00:16:14,650
،إن كنتَ عاجزًا عن العثور على ما تفتقر له

207
00:16:14,800 --> 00:16:16,610
.فيمكنك نسيان التّقنية السّرّيّة الأقوى

208
00:16:16,810 --> 00:16:20,250
.ناهيك عن هوسك بالقضاء على شيشيو وجماعته

209
00:16:20,490 --> 00:16:23,160
،حتّى إن حدثت معجزة ونجحت

210
00:16:23,290 --> 00:16:26,290
.فسيلتهمك القاتل الّذي بداخلك بالكامل

211
00:16:27,390 --> 00:16:31,050
سيلتهمك النّدم إلى الأبد وستدمّرك الوحدة

212
00:16:31,650 --> 00:16:32,880
.وسيصير ملاذك القتل فحسب

213
00:16:36,780 --> 00:16:41,100
،لا يمكنني نقل التّقنية السّرّيّة الأقوى لك
.لكن بإمكاني إنهاء معاناتك

214
00:16:41,310 --> 00:16:43,940
.إنّه واجبي الأخير تجاهك بفصتي معلّمك

215
00:16:59,730 --> 00:17:02,170
.كانت تلك العباءة تزن 40 كيلوغرامًا

216
00:17:02,300 --> 00:17:05,540
.كانت مبطّنة بنوابض تقيّد عضلاتي

217
00:17:05,930 --> 00:17:09,630
.تتلخّص وظيفتها في كبح جماح قوّة معلّم الأسلوب

218
00:17:10,240 --> 00:17:14,570
إنّها تنتقل من جيل لآخر لكلّ
.من سيحمل اسم هيكو سيجورو

219
00:17:15,950 --> 00:17:17,570
...آمل أن تكون جاهزًا

220
00:17:18,200 --> 00:17:19,350
.يا كنشين

221
00:17:22,410 --> 00:17:24,080
...إذًا فهذا هو

222
00:17:24,460 --> 00:17:26,260
.الوجه الحقيقيّ لهيكو سيجورو

223
00:17:27,390 --> 00:17:28,770
.يدي اليسرى ترتعد

224
00:17:29,630 --> 00:17:31,240
...أيفترض بي الخوف

225
00:17:31,950 --> 00:17:33,740
من هيكو سيجورو؟

226
00:17:34,460 --> 00:17:37,660
أم من الموت المحتّم الّذي يتربّص وراءه؟

227
00:17:38,680 --> 00:17:39,910
!اهدأ

228
00:17:40,370 --> 00:17:42,210
،أنا جاهز للموت

229
00:17:42,330 --> 00:17:45,750
.وكنتُ كذلك منذ أيّام نهاية الشّوغونيّة

230
00:17:46,410 --> 00:17:48,140
،وإن كلّفني ذلك حياتي

231
00:17:48,790 --> 00:17:51,470
.عليّ تعلّم التّقنية السّرّيّة الأقوى

232
00:17:52,480 --> 00:17:53,670
!لنبدأ

233
00:18:03,470 --> 00:18:04,600
الموت؟

234
00:18:05,500 --> 00:18:09,210
.لن يُعيدهم غضبك ولا حتّى دموعك للحياة

235
00:18:09,340 --> 00:18:11,740
إنّ مثل هذه المآسي صارت أمرًا شائعًا

236
00:18:11,870 --> 00:18:13,520
.في اليابان الحاليّة

237
00:18:13,660 --> 00:18:17,040
.اعتبر نفسك محظوظًا لأنّك نجوت

238
00:18:17,180 --> 00:18:18,780
ما اسمك يا فتى؟

239
00:18:18,910 --> 00:18:21,700
.إنّه اسم ليّن جدًّا ليحمله سيّاف

240
00:18:21,830 --> 00:18:25,150
.بدءًا من اليوم، سيصير اسمك كنشين

241
00:18:28,000 --> 00:18:28,920
!الموت

242
00:18:34,430 --> 00:18:36,680
كاورو-دونو؟

243
00:18:37,230 --> 00:18:39,960
!أنت هو الرّوروني الّذي أريد

244
00:18:40,670 --> 00:18:43,040
.سُحقًا. أريد أن أصير أقوى

245
00:18:43,180 --> 00:18:45,750
.من الأفضل ألاّ تغادر المكان بدون علمي

246
00:18:45,890 --> 00:18:47,350
.أفضّل الحكم بالموت

247
00:18:47,540 --> 00:18:51,840
!هيمورا الباتّوساي –
حملك للعبء وحدك والعيش تعيسًا –

248
00:18:51,980 --> 00:18:54,650
!أمر لن أرضى به أبدًا

249
00:18:55,000 --> 00:18:57,610
.اليابان مهدّدة –
.عُد إلى كيوتو –

250
00:18:57,780 --> 00:19:01,360
!كنشين

251
00:19:01,640 --> 00:19:03,620
!لا أريد الموت

252
00:19:03,770 --> 00:19:06,910
!لا يمكنني الموت! ليس الآن

253
00:19:20,480 --> 00:19:22,930
.جيّد. إذًا فقد فهمت

254
00:19:24,430 --> 00:19:28,410
.قتلتَ أشخاصًا من قبل
.قطعت خيط حياة العديد من النّاس

255
00:19:28,680 --> 00:19:31,000
،أكلك الشّعور بالذّنب والنّدم من الدّاخل

256
00:19:31,240 --> 00:19:34,330
.ولذلك لا تحترم وجودك على الإطلاق

257
00:19:34,940 --> 00:19:36,700
وأثناء قيامك بذلك، نسيتَ أنّ حياتك

258
00:19:36,820 --> 00:19:40,300
.مساوية لحياة أيّ شخص آخر، لا أكثر ولا أقلّ

259
00:19:41,690 --> 00:19:45,710
.ونتيجة لهذا، فإنك تكبح قوّتك

260
00:19:46,110 --> 00:19:47,290
،وفي بعض الأحيان

261
00:19:47,420 --> 00:19:50,750
.تفقد السّيطرة على القاتل الكامن بداخلك

262
00:19:51,290 --> 00:19:53,220
،للتّغلّب على ذلك

263
00:19:53,450 --> 00:19:56,930
تحتاج إلى ما لمحتَه للتّوّ
.عن طريق اقترابك من الموت

264
00:19:57,070 --> 00:19:59,630
.إنّ الإرادة للعيش هي ما تفتقر إليه

265
00:20:03,400 --> 00:20:05,620
...الضّعفاء والأعزّاء عليك

266
00:20:05,840 --> 00:20:09,750
،لا تملك إلاّ العطف والحنان تجاههم
.لدرجة التّضحية بنفسك

267
00:20:10,090 --> 00:20:13,040
.ولكنّ هؤلاء النّاس سيعانون بعد موتك

268
00:20:13,220 --> 00:20:15,680
.ولن تحميهم من المحن بهذه الطّريقة

269
00:20:16,330 --> 00:20:17,880
...مشاكل عصرنا

270
00:20:18,000 --> 00:20:21,900
حتّى لو ضحّيت بنفسك بكلّ
،ما أوتيت من حماسة

271
00:20:22,020 --> 00:20:23,380
...وكلّ هذا الإيثار

272
00:20:23,510 --> 00:20:27,120
.سيضيع بين ثنايا الزّمن فحسب

273
00:20:27,840 --> 00:20:31,050
.إنّ الإرادة للعيش تنتصر على كلّ شيء

274
00:20:32,100 --> 00:20:34,270
.إيّاك أن تنسى ذلك

275
00:20:35,170 --> 00:20:39,710
.صرت الآن تحمل وميض التّنّين الطّائر المقدّس

276
00:20:40,060 --> 00:20:41,900
.ستهزم شيشيو وجماعته لا محالة

277
00:20:42,370 --> 00:20:44,650
وينطبق نفس الكلام
.على القاتل القابع بداخلك

278
00:20:45,100 --> 00:20:46,940
.سوف تنتصر

279
00:20:47,630 --> 00:20:48,780
...معلّمي

280
00:20:53,840 --> 00:20:55,810
!معلّمي –
!لا داعي للقلق –

281
00:20:58,590 --> 00:21:01,610
هذه هي طقوس بدء استخدام
.وميض التّنّين الطّائر المقدّس

282
00:21:02,030 --> 00:21:04,610
.هذا هو مصير تلاميذ أسلوب هيتن ميتسوروغي

283
00:21:11,760 --> 00:21:13,050
!معلّمي

284
00:22:46,020 --> 00:22:49,480
."في الحلقة القادمة: "اجتماع السّيوف العشرة