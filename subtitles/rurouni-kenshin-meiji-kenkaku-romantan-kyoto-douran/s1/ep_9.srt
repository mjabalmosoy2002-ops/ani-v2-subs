1
00:00:05,980 --> 00:00:09,440
!آخر نماذج سيوف شاكّو المميّزة القاتلة

2
00:00:09,440 --> 00:00:11,230
!كن حذرًا يا هيمورا

3
00:00:12,690 --> 00:00:15,150
!إنّه لا يزال يحمل سيفًا

4
00:00:15,860 --> 00:00:17,910
.لنبدأ

5
00:00:23,450 --> 00:00:26,370
!ما رأيك؟ هذا السّيف هو الأعزّ عندي

6
00:00:26,920 --> 00:00:28,080
...السّيف القاتل المميّز

7
00:00:28,380 --> 00:00:29,790
!نصل هاكوجين

8
00:00:30,670 --> 00:00:31,500
!إنّه طويل

9
00:00:31,500 --> 00:00:33,130
!إضافة لكونه مرنًا جدًّا –
!هيمورا –

10
00:00:35,260 --> 00:00:38,220
...كلاّ! إن تفاديت ذلك بهامش ضئيل جدًّا

11
00:02:15,980 --> 00:02:19,990
الحلقة الثّالثة والثّلاثين
استلال السّيف المحرّم

12
00:02:25,080 --> 00:02:26,950
.ما كنتُ أهدف إليه تمامًا

13
00:02:27,540 --> 00:02:30,620
.ما عاد بإمكانك الآن التّحرّك بحرّيّة

14
00:02:33,130 --> 00:02:36,300
...السّيف القاتل المميّز، نصل هاكوجين

15
00:02:36,880 --> 00:02:42,590
إنّه سيف دُقَّ بشكل رفيع قدر الإمكان
.مع الحفاظ على شدّة النّصل

16
00:02:42,590 --> 00:02:46,010
.بدا وكأنّه قادر على التّحكّم به كما يشاء

17
00:02:46,560 --> 00:02:49,180
،إنّ بجعل رأس النّصل ثقيلاً بعض الشّيء

18
00:02:49,180 --> 00:02:51,640
يصير بالإمكان نقل حركات المعصم المفاجئة

19
00:02:51,640 --> 00:02:54,860
.مباشرة إلى مسار النّصل للتّحكّم فيها

20
00:02:55,360 --> 00:03:00,320
وبعد إصابة ساقه، صار تفادي تحرّكات نصل
...هاكوجين المتغيّرة بالكامل مستحيلاً

21
00:03:00,820 --> 00:03:04,410
.حصلتُ على جمهور مزعج دون أن أدرك ذلك

22
00:03:04,410 --> 00:03:07,040
.لننتقل إذًا إلى ذروة الأحداث

23
00:03:09,290 --> 00:03:10,960
."أسلوبي "الأفعى الضّخمة

24
00:03:11,580 --> 00:03:13,170
!إليك هذا

25
00:03:21,510 --> 00:03:23,180
!أنا متفاجئ من أنّك صددته

26
00:03:23,180 --> 00:03:25,760
!لكنّي لم أنتهِ بعد

27
00:03:30,390 --> 00:03:31,230
!هيمورا

28
00:03:37,940 --> 00:03:39,440
.الوضع ميؤوس منه بالفعل

29
00:03:39,940 --> 00:03:41,650
.لا فرصة لديك للفوز

30
00:03:42,280 --> 00:03:43,910
...إن لم أفعل أيّ شيء

31
00:03:48,580 --> 00:03:49,580
يا عزيزي؟

32
00:03:51,000 --> 00:03:52,790
.عليّ التّخلّي عن سيف والدي

33
00:03:53,250 --> 00:03:55,380
علينا الآن إنقاذ إيوري

34
00:03:55,380 --> 00:03:58,380
والابتعاد عن حمّام الدّماء
.هذا قدر الإمكان

35
00:03:58,840 --> 00:04:00,340
ذلك الرّجل الّذي يتكلّم بلهجة أوساكا

36
00:04:00,340 --> 00:04:02,380
.يركّز في قتاله ضدّ ذلك الرّجل

37
00:04:03,010 --> 00:04:04,340
...ذلك

38
00:04:03,010 --> 00:04:05,300
.يمكنني انتهاز هذه الفرصة لإنقاذ إيوري

39
00:04:05,300 --> 00:04:07,510
ستجعل من هيمورا طُعمًا؟

40
00:04:07,510 --> 00:04:10,470
كان مدركًا تمامًا أنّه لا يستطيع
،القتال بسيف مكسور

41
00:04:10,470 --> 00:04:13,690
ومع ذلك أتى هيمورا إلى هنا
!أسرع من أيّ منّا

42
00:04:14,690 --> 00:04:18,190
.لم أطلب منه ذلك

43
00:04:18,820 --> 00:04:20,780
.إنّه يقاتل بمحض اختياره

44
00:04:23,820 --> 00:04:25,200
.سيكو-سان

45
00:04:25,700 --> 00:04:28,410
،أنا وليّ أمرها قبل كلّ شيء

46
00:04:28,410 --> 00:04:32,660
أفهم تمامًا ما يعنيه أن تضع ابنك
...قبل كلّ شيء. ولكن

47
00:04:33,000 --> 00:04:37,540
ما الّذي يحاول هيمورا-كُن حمايته
عن طريق القتال بمحض اختياره؟

48
00:04:37,540 --> 00:04:40,380
هل يمكنك فهم ذلك أيضًا؟

49
00:04:46,840 --> 00:04:50,430
.حسنًا. سأكون أكثر كرمًا

50
00:04:50,640 --> 00:04:53,180
!سأريك تقنية عظيمة أخرى

51
00:04:53,560 --> 00:04:55,770
!"أسلوبي "الالتفاف

52
00:05:02,360 --> 00:05:04,570
!"أسلوبي "النّاب السّامّ

53
00:05:10,830 --> 00:05:11,620
...ما

54
00:05:12,620 --> 00:05:14,580
إنّك لا تعرف ما الاستسلام، صحيح؟

55
00:05:15,370 --> 00:05:18,540
.من المثير للشّفقة النّظر إليك

56
00:05:24,050 --> 00:05:27,720
.إنّ هاتين العينين تغضبانني بشدّة

57
00:05:28,680 --> 00:05:30,970
أنت تدرك الوضع، صحيح؟

58
00:05:30,970 --> 00:05:33,470
.أنت محاصر بالكامل

59
00:05:34,060 --> 00:05:38,440
هذا ليس وقتًا مناسبًا لوضع
.حياتك على المحكّ لأجل شقيّ صغير

60
00:05:39,940 --> 00:05:45,740
في الماضي، قتلتُ العديد من
.الرّجال لتحقيق حقبة جديدة

61
00:05:46,030 --> 00:05:48,860
ماذا؟ أتحاول التّفاخر؟

62
00:05:49,070 --> 00:05:54,410
لا بأس. التّشبّث بإنجازات الماضي
.في هذه المرحلة مثير جدًّا للشّفقة

63
00:05:54,410 --> 00:05:56,080
.لا يوجد ما هو أفضل من هذا

64
00:05:56,790 --> 00:06:00,290
بعد معارك مميتة وإراقة دماء
،لا يمكن التّكفير عنها

65
00:06:00,290 --> 00:06:03,090
فقد مرّت عشر سنوات منذ
.دخولنا حقبة جديدة حتّى الآن

66
00:06:03,590 --> 00:06:06,130
وبدون معرفة المعارك المميتة
،وإراقة الدّماء

67
00:06:06,130 --> 00:06:09,680
بدأت تظهر على هذه الحقبة علامات
السّلام حيث يمكن للأطفال

68
00:06:09,680 --> 00:06:12,640
.أن يكبروا بصحّة جيّدة في منازل مُحِبّة وعطوفة

69
00:06:13,810 --> 00:06:16,520
.قد يكون مجرّد شقيّ صغير في نظرك

70
00:06:16,520 --> 00:06:20,190
ولكن في نظري، إنّه نعمة لا غنى
.عنها في هذا العصر الجديد

71
00:06:21,060 --> 00:06:26,230
سأعيد إيوري إلى سيكو وزوجته
.سالمًا وإن قتلني ذلك

72
00:06:32,120 --> 00:06:37,200
.سأحرص على أن يُبقي انتباهه عليّ
!أسرعوا وخذوا إيوري الآن

73
00:06:43,460 --> 00:06:44,290
عزيزي؟

74
00:06:45,340 --> 00:06:48,760
ماذا؟ تتظاهر أنّك بطل عدالة؟

75
00:06:49,550 --> 00:06:52,220
.إنّ ذلك يجعلني أبدو كشرّير

76
00:06:52,220 --> 00:06:54,350
.وذلك يغضبني أكثر

77
00:06:55,890 --> 00:06:56,970
.يكفي

78
00:06:57,560 --> 00:07:00,190
.انتهى دورك هنا الآن

79
00:07:01,230 --> 00:07:03,940
،بدءًا من الآن، تحت راية شيشيو-ساما

80
00:07:03,940 --> 00:07:08,610
سيخلق نصل هاكوجين هذا
.حقبة جديدة أخرى

81
00:07:08,610 --> 00:07:11,070
.يمكنك الموت مطمئنًّا

82
00:07:11,070 --> 00:07:14,950
يؤسفني قول هذا، لكنّ ذلك
.غير ممكن بالنّسبة لك

83
00:07:15,740 --> 00:07:18,040
.لا تُولد الحقب الجديدة بالسّيوف

84
00:07:18,040 --> 00:07:20,660
.بل تُولد على أيدي الأشخاص الّذين يحملونها

85
00:07:28,920 --> 00:07:29,760
!يا عزيزي

86
00:07:29,760 --> 00:07:33,680
!إنّه يحاول فعلاً استعمال هيمورا كطُعم

87
00:07:33,840 --> 00:07:35,760
!انتظرني يا إيوري

88
00:07:35,760 --> 00:07:37,180
.سأحرص على إنقاذك

89
00:07:37,180 --> 00:07:39,220
!تماسك قليلاً فحسب

90
00:07:39,220 --> 00:07:42,020
ما الّذي يفعله الجمهور بصعوده
على الخشبة بدون إذن؟

91
00:07:42,020 --> 00:07:42,890
!انتبه

92
00:07:48,270 --> 00:07:51,740
!إنّك تغضبني بشدّة بالفعل

93
00:07:52,200 --> 00:07:53,200
!سيكو-دونو

94
00:07:54,950 --> 00:07:56,570
.سأراهن على هذا الرّجل

95
00:07:56,990 --> 00:07:59,120
!قد أستطيع أن أعهد له بها

96
00:07:59,120 --> 00:08:00,450
...هذه الحقبة المسالمة الجديدة

97
00:08:01,040 --> 00:08:02,330
!الّتي سيحميها بكلّ تأكيد

98
00:08:03,370 --> 00:08:06,250
واثق أنّ هذا الرّجل سيستعمل
!سيف والدي خير استعمال

99
00:08:08,170 --> 00:08:11,590
".السّيوف الّتي أدقّها ستخلق حقبة جديدة"

100
00:08:12,170 --> 00:08:17,510
لم أحبّ أبدًا تلك الكلمات
.الّتي كان أبي يردّدها

101
00:08:18,510 --> 00:08:20,520
.فهمتُ أخيرًا معناها

102
00:08:21,140 --> 00:08:24,940
هذا صحيح. من الوقاحة أن نقول
.أنّ السّيوف تخلق حقبًا جديدة

103
00:08:25,440 --> 00:08:27,980
،إنّ النّاس هم من يخلقون الحقب الجديدة

104
00:08:27,980 --> 00:08:32,150
.والحقب الّتي تأسّست يحميها النّاس أيضًا

105
00:08:32,780 --> 00:08:37,200
ولحماية هذا السّلام، يواصل
...ذلك الرّجل القتال في الخفاء

106
00:08:37,700 --> 00:08:39,620
...لذلك فإنّ أخر سيوف أبي

107
00:08:41,870 --> 00:08:45,460
!لن أتهاون بعد الآن! لقد أغضبتني

108
00:08:45,460 --> 00:08:47,500
!انظر إلى رأسي

109
00:08:47,500 --> 00:08:50,090
!لقد انتصب شعري بسبب الغضب

110
00:08:50,550 --> 00:08:54,300
تقصد شعر المكنسة ذاك؟
.أظنّه كان كذلك دائمًا

111
00:08:54,670 --> 00:08:55,800
!نعم، نعم

112
00:08:56,050 --> 00:08:57,800
.مكنسة. مكنسة

113
00:08:58,050 --> 00:09:01,760
لا تردّ على مزحة شخص آخر بوجه
!جادّ كهذا أيّها المغفّل

114
00:09:02,100 --> 00:09:04,680
!إنّك مزعج لأبعد الحدود

115
00:09:09,480 --> 00:09:11,610
.اعترَضه بما بقي من غمده

116
00:09:13,070 --> 00:09:15,950
!سُحقًا! اقتربتُ منه كثيرًا وصرت في مرماه

117
00:09:29,330 --> 00:09:32,550
!أجل! ضربة مضادّة بكوعه

118
00:09:32,550 --> 00:09:37,680
استفزّه ليغريه بالاقتراب بما يكفي
...ليستطيع الهجوم بقفزة واحدة

119
00:09:38,220 --> 00:09:44,140
،بدون سيف وبساق يُمنى مصابة
.كان ذلك الهجوم ملاذ هيمورا-كُن الأخير

120
00:09:44,600 --> 00:09:47,060
...إن لم يُنهِ بذلك الأمر

121
00:09:50,100 --> 00:09:52,610
.كان ذلك وشيكًا، وشيكًا بالفعل

122
00:09:52,610 --> 00:09:56,360
.لقد استهنتُ بك بالفعل

123
00:09:57,740 --> 00:09:58,740
.هذا سيّئ

124
00:09:59,280 --> 00:10:04,200
إنّ ذلك الهجوم ساعدني فعلاً
.على إنزال الدّماء من رأسي

125
00:10:04,700 --> 00:10:08,460
.لن أقترب ولو شبرًا من مرماك ثانية

126
00:10:08,460 --> 00:10:13,170
سأقطّعك لأشلاء من بعيد
.وسأرميها في نهر شيجوغاوارا

127
00:10:14,090 --> 00:10:17,010
.لم تعد لديه الآن فرصة للنّصر

128
00:10:17,010 --> 00:10:20,840
كلّ ما يمكن التّفكير فيه الآن هو كيفية
.الهرب من هذه الأزمة دون فقدان أيّ أحد

129
00:10:21,590 --> 00:10:23,390
...ليت كان لديه سيف

130
00:10:25,220 --> 00:10:26,270
!هيمورا-سان

131
00:10:30,940 --> 00:10:32,770
!هذا سيف والدي الأخير

132
00:10:33,480 --> 00:10:35,150
!استعمله رجاءً

133
00:10:36,990 --> 00:10:39,990
روروني كنشين
—اضطرابات كيوتو—

134
00:10:50,160 --> 00:10:51,080
!هيمورا

135
00:10:51,290 --> 00:10:55,550
.جعلني أتدحرج للوراء، لذلك أخّر ذلك بدايتي

136
00:10:56,420 --> 00:10:57,960
.لا يهمّ

137
00:10:58,720 --> 00:11:02,800
.هزيمتك والحصول على السّيف الأخير

138
00:11:02,800 --> 00:11:07,390
.صار كِلا الهدفين هدفًا واحدًا الآن

139
00:11:08,930 --> 00:11:10,230
.سُحقًا

140
00:11:10,690 --> 00:11:13,440
.علينا تسوية الأمر بسرعة

141
00:11:13,650 --> 00:11:16,110
.يملك كلانا سيفًا حقيقيًّا

142
00:11:16,110 --> 00:11:17,900
.إمّا أن نقتُل أو نُقتل

143
00:11:17,900 --> 00:11:19,900
يسهل فهم هذا، صحيح؟

144
00:11:20,150 --> 00:11:21,490
!انطلق يا هيمورا

145
00:11:21,490 --> 00:11:23,870
!النّصر لك بما أنّ لديك سيفًا الآن

146
00:11:26,490 --> 00:11:30,410
.كلاّ. لن يقوم هيمورا-كُن باستلال ذلك السّيف

147
00:11:31,410 --> 00:11:34,000
.بل على الأرجح أنّه لا يستطيع

148
00:11:34,290 --> 00:11:37,800
،بما أنّه أقسم ألاّ يقتل

149
00:11:37,800 --> 00:11:41,760
فإنّ استلال أيّ سيف ليس سيفَ
.ساكاباتو سيكون محرّمًا بالكامل عليه

150
00:11:42,050 --> 00:11:45,090
لكنّ هذا ليس الوقت لذلك الآن، صحيح؟

151
00:11:45,350 --> 00:11:47,470
!إن لم يقتُل، فسيُقتل

152
00:11:47,470 --> 00:11:50,350
،لا أدري أيّ نوع من الهيتوكيري كان هيمورا

153
00:11:50,350 --> 00:11:51,640
—لكنّ قتل شخص آخر ليس

154
00:11:51,640 --> 00:11:54,150
."المشكلة ليست في قتل "شخص آخر

155
00:11:54,150 --> 00:11:57,440
.ظهر عدوّ قويّ من جماعة شيشيو

156
00:11:57,440 --> 00:12:01,690
،إنّ قلبه يشبه ميزانًا الآن

157
00:12:01,690 --> 00:12:06,490
وهو يتأرجح بين روروني يرفض
.القتل وهيتوكيري باتّوساي

158
00:12:07,910 --> 00:12:11,330
هيتوكيري باتّوساي؟

159
00:12:11,330 --> 00:12:13,250
...السّيّاف الأسطوريّ

160
00:12:13,830 --> 00:12:17,250
،إن استلّ ذلك السّيف الآن للقتل

161
00:12:17,250 --> 00:12:19,420
.فسيفقد القيود الّذي وضعها على قلبه

162
00:12:19,420 --> 00:12:23,050
وبعد ذلك، فسيعود مباشرة
.للسّير على طريق الهيتوكيري المدمّر

163
00:12:24,930 --> 00:12:28,470
.لن يستطيع أبدًا العودة ليكون روروني ثانية

164
00:12:29,600 --> 00:12:33,060
ليت غمد ذلك السّيف لم يكن
،خشبًا عاديًّا وهشًّا

165
00:12:33,060 --> 00:12:36,600
...وكان معدنًا مثل السّاكاباتو

166
00:12:37,310 --> 00:12:40,070
أنت هو الهيتوكيري باتّوساي؟

167
00:12:40,570 --> 00:12:44,490
لماذا تتردّد كثيرًا لقتل شخص آخر؟

168
00:12:45,860 --> 00:12:50,990
لا بأس. إن كنت تقول
،أنّك نسيت فرحة قتل رجل

169
00:12:50,990 --> 00:12:53,500
.فسأجعلك تتذكّرها الآن

170
00:12:55,250 --> 00:12:57,460
.عن طريق عرض مباشر

171
00:12:58,590 --> 00:12:59,460
!إيوري

172
00:12:59,670 --> 00:13:04,090
سأقطّع هذا الشّقيّ الّذي وصفتَه
!بنعمة السّلام من قبل لأشلاء

173
00:13:07,510 --> 00:13:09,300
!وقعت في فخّي أيّها الغبيّ

174
00:13:09,300 --> 00:13:11,350
!كلاّ! كان يستفزّك فحسب

175
00:13:11,350 --> 00:13:15,060
!سأردّ لك الصّاع صاعين على سخريتك منّي

176
00:13:21,230 --> 00:13:22,440
!نلت منك

177
00:13:22,440 --> 00:13:25,610
.بإمكان رأس نصل هاكوجين الذّهاب لأيّ مكان

178
00:13:26,280 --> 00:13:28,240
!سأطعنك من الخلف

179
00:13:35,660 --> 00:13:38,290
ما كانت ردّة الفعل الخارقة
لقدرات البشر تلك؟

180
00:13:38,290 --> 00:13:40,960
.إنّه شخص مختلف تمامًا عمّا كان عليه قبل قليل

181
00:13:41,340 --> 00:13:42,920
...أسلوب هيتن ميتسوروغي

182
00:13:44,130 --> 00:13:46,340
!وميض التّنّين الملتفّ: دوّامة الشّعر

183
00:13:46,880 --> 00:13:47,720
!هيمورا

184
00:14:02,570 --> 00:14:03,980
.لقد فعلها

185
00:14:16,540 --> 00:14:18,620
...هل قتل

186
00:14:32,550 --> 00:14:33,560
.هيمورا

187
00:14:35,060 --> 00:14:36,600
...أنا

188
00:14:40,600 --> 00:14:42,480
...ذلك السّيف

189
00:14:43,980 --> 00:14:45,400
!ساكاباتو

190
00:14:48,990 --> 00:14:52,700
ماذا؟! السّيف الأخير لأراي شاكّو

191
00:14:52,700 --> 00:14:55,580
!كان ساكاباتو مثل الّذي أعطاه لهيمورا-كُن

192
00:14:56,040 --> 00:15:02,130
لا، هذا... يبدو أنّه يناسب يدي
.أكثر بقليل من السّيف السّابق

193
00:15:02,750 --> 00:15:05,880
...لكن إن كان سيفَ ساكاباتو

194
00:15:10,630 --> 00:15:12,300
!فإنّه حيّ يا هيمورا

195
00:15:12,300 --> 00:15:14,760
!لم تخلف وعدك بعدم القتل

196
00:15:14,760 --> 00:15:16,220
.فهمت

197
00:15:17,220 --> 00:15:22,730
فهمت بالكامل الآن لماذا يودّ
شيشيو-ساما تولّي أمرك

198
00:15:22,730 --> 00:15:26,980
على الرّغم من هدفه الكبير
.بالسّيطرة على البلاد

199
00:15:27,320 --> 00:15:30,360
.لكن لا تغترّ بذلك

200
00:15:30,360 --> 00:15:35,240
ثمّة عشرة سيّافين آخرين
.في وحدة السّيوف العشرة الخاصّة

201
00:15:35,700 --> 00:15:37,580
،واثنان منهم

202
00:15:37,580 --> 00:15:42,080
سوجيرو الّذي سبق وقاتلتَه

203
00:15:42,080 --> 00:15:45,040
،وأوسوي-سان القادم إلى هنا من ريوكيو

204
00:15:45,040 --> 00:15:47,210
.وهما أفضل منك بكثير

205
00:15:47,550 --> 00:15:51,720
!لن تتمكّن أبدًا من الوصول إلى شيشيو-ساما

206
00:15:51,720 --> 00:15:54,220
فكّر مليًّا في ضعفك

207
00:15:54,220 --> 00:15:57,970
وراقب بصمت شيشيو-ساما
!وهو يسيطر على البلاد

208
00:15:59,520 --> 00:16:00,560
.يا جدّي

209
00:16:01,100 --> 00:16:02,060
.حاضر

210
00:16:02,310 --> 00:16:03,810
!الحُكم

211
00:16:06,610 --> 00:16:08,360
ماذا سنفعل به؟

212
00:16:08,360 --> 00:16:12,650
سؤال وجيه. أودّ سحب الكثير
،من المعلومات منه

213
00:16:12,650 --> 00:16:14,110
.لذلك سنأخذه إلى أوُيْيا

214
00:16:14,410 --> 00:16:17,370
.لا، علينا تسليمه للشّرطة

215
00:16:17,910 --> 00:16:20,440
،لستُ واثقًا أنّه وصل إلى كيوتو بعد

216
00:16:20,450 --> 00:16:24,710
لكن ثمّة رجل من الشّرطة يملك السّلطة
.لفعل أيّ شيء بخصوص جماعة شيشيو

217
00:16:25,080 --> 00:16:27,040
.ذلك هو الطّريق الأكثر أمانًا

218
00:16:27,040 --> 00:16:28,460
...ذلك الرّجل

219
00:16:28,960 --> 00:16:31,460
.إن كانت هذه رغبتك يا هيمورا-كُن

220
00:16:32,420 --> 00:16:34,130
ساكاباتو؟

221
00:16:34,840 --> 00:16:37,180
آخر سيوف أبي؟

222
00:16:37,970 --> 00:16:43,560
لا أفهم. لم ينفكّ أبي عن صنع
...سيوف قاتلة، فلماذا

223
00:16:49,730 --> 00:16:50,860
...ذلك السّيف

224
00:16:51,900 --> 00:16:52,740
ينكسر؟

225
00:16:53,190 --> 00:16:57,570
لم يستطع الغمد الخشبيّ العاديّ
.احتواء تقنية هيمورا-كُن

226
00:17:04,500 --> 00:17:07,920
.لا بأس. لم يتضرّر النّصل بحدّ ذاته

227
00:17:11,050 --> 00:17:12,210
...هذا

228
00:17:20,640 --> 00:17:25,100
صنعتُ من المعدنِ أنصالاً لشهور"
.وسنوات كأنّي أقطع نفسي

229
00:17:24,770 --> 00:17:29,810
"مطعم أوُيْيا"

230
00:17:25,100 --> 00:17:29,810
،حتّى إن كرهني ابني
".فذلك من أجل زمن حفيدي

231
00:17:31,110 --> 00:17:36,780
،استمرّ في صنع أنصال لسنوات
.وهو يشعر وكأنّه يقطّع نفسه

232
00:17:36,950 --> 00:17:40,910
،وحتّى إن عنى ذلك أن يكرهه ابنه

233
00:17:40,910 --> 00:17:43,910
قام بالأمر للجيل التّالي
.الّذي سيكبر فيه حفيده

234
00:17:44,660 --> 00:17:50,210
على الأرجح أنّ شاكّو نقش ذلك
.كقصيدة وداعه

235
00:17:50,670 --> 00:17:53,420
إذًا فقد أدرك أبي في منتصف طريقه

236
00:17:53,420 --> 00:17:57,970
أنّ فخره وحده من كان يقول
.أنّ السّيوف تخلق حقبًا جديدة

237
00:17:58,590 --> 00:18:02,310
لكنّ ذلك الوقت كان في منتصف
.اضطرابات باكوماتسو

238
00:18:02,310 --> 00:18:05,730
وكان فوضويًّا جدًّا لدرجة
أنّه لم يستطع التّوقّف

239
00:18:05,730 --> 00:18:07,940
.أو أن يتريّث بما يكفي ليتألّم

240
00:18:08,350 --> 00:18:10,770
،وكحدّاد سيوف يعيش في حقبة باكوماتسو

241
00:18:10,770 --> 00:18:13,070
.استمرّ أبي في التّقدّم للأمام

242
00:18:13,070 --> 00:18:16,990
كان الشّيء الوحيد الّذي بإمكانه فعله
،هو مواصلة صنع سيوف قاتلة

243
00:18:16,990 --> 00:18:19,740
.وكلّه أمل بأنّ حقبة مسالمة ستحلّ قريبًا

244
00:18:20,700 --> 00:18:23,620
،كان عليه أن يعيش ما بدا كحياة ساخرة

245
00:18:23,620 --> 00:18:27,290
.تُعارض تمامًا ما كان يشعر به

246
00:18:28,410 --> 00:18:34,590
ترك والدي خلفه، إلى جانب صلوات
،النّدم العميق والأمل الخافت

247
00:18:34,590 --> 00:18:38,380
.سيفه السّاكاباتو المقدّس شين-أوتشي

248
00:18:39,220 --> 00:18:40,550
شين-أوتشي؟

249
00:18:40,550 --> 00:18:41,390
.نعم

250
00:18:42,260 --> 00:18:46,600
،عند دقّ سيف مقدّس
،من العادة ألاّ يُصنع واحد فقط

251
00:18:46,600 --> 00:18:49,060
.بل اثنين أو أكثر من ذلك

252
00:18:49,640 --> 00:18:55,150
أمّا السّيف الّذي دُقَّ بشكل جيّد
،يُسمّى شين-أوتشي ويُقدّم للآلهة

253
00:18:55,150 --> 00:18:59,490
،بينما البقيّة تُسمّى كاغي-أوتشي
.وإمّا أن تُخزّن أو تُوزّع

254
00:19:01,530 --> 00:19:06,080
مفهوم. إذًا فقد كان هنالك
.اثنان من السّاكاباتو

255
00:19:06,290 --> 00:19:08,370
،وهذا هو الشّين-أوتشي

256
00:19:08,370 --> 00:19:11,670
!أي السّاكاباتو الأفضل من السّاكاباتو السّابق

257
00:19:12,460 --> 00:19:14,880
.أرجو أن تقبله يا هيمورا-سان

258
00:19:15,380 --> 00:19:18,300
.أنا واثق أنّ ذلك ما كانت يأمله أبي

259
00:19:23,180 --> 00:19:26,430
.سمعتُ أنّك ستترك المناصرين يا هيمورا

260
00:19:30,440 --> 00:19:33,940
.لقد حقّقنا النّصر للتّوّ في توبا-فوشيمي

261
00:19:34,610 --> 00:19:37,150
.بدأ القتال للتّوّ فحسب

262
00:19:37,650 --> 00:19:39,990
.إنّ الإصلاح الإمبراطوريّ لم يحدث بعد

263
00:19:39,990 --> 00:19:41,780
.هذا تصرّف أنانيّ منك

264
00:19:42,410 --> 00:19:46,990
وفوق ذلك، إلى أين تعتقد
أنّك ذاهب بدون سيفك؟

265
00:19:48,080 --> 00:19:51,960
حصلتُ على العفو من كاتسورا-سينسي
.يا شاكّو-دونو

266
00:19:52,620 --> 00:19:55,130
...بدءًا من الآن، لن أقتل أيّ رجل

267
00:19:55,630 --> 00:19:59,510
وسأبحث عن طريق لحماية النّاس الّذين
.يعيشون في الحقبة الجديدة وأسير عليه

268
00:20:01,220 --> 00:20:06,220
،إن وُجدر طريق كهذا
.أحبّ أيضًا أن أعرف به

269
00:20:06,680 --> 00:20:11,730
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

270
00:20:13,390 --> 00:20:15,690
.عش بالسّيف، ومت بالسّيف

271
00:20:16,190 --> 00:20:19,360
.لا يجدر أن يوجد طريق آخر لك

272
00:20:23,200 --> 00:20:24,530
.هديّة وداع

273
00:20:25,530 --> 00:20:30,330
إنّه محاولة فاشلة، لكنّه سيكون أكثر
.من كافٍ بالنّسبة لمن أنت عليه الآن

274
00:20:30,950 --> 00:20:34,000
وكبداية، حاول أن تكون سيّافًا
.وأنت تحمل ذلك على خصرك

275
00:20:34,580 --> 00:20:38,500
.واثق أنّك سترى بنفسك مدى سذاجتك الآن

276
00:20:39,590 --> 00:20:45,340
إن كنت لا تزال قادرًا على التّفوّه
...بمثل هذا الهراء عندما ينكسر

277
00:20:46,800 --> 00:20:50,640
.عد إلى كيوتو وزُرني مرّة أخرى

278
00:21:10,790 --> 00:21:14,790
"السّنة الرّابعة من حقبة كييو"
"ضواحي أوينو"

279
00:22:46,010 --> 00:22:51,010
الحلقة القادمة
هجوم السّاكاباتو الأوّل

280
00:22:46,970 --> 00:22:50,180
."في الحلقة القادمة: "هجوم السّاكاباتو الأوّل