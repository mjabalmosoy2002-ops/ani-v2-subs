1
00:00:07,040 --> 00:00:09,270
.السّعي خلف سيف ساكاباتو

2
00:00:10,110 --> 00:00:14,500
بما أنّ أراي شاكّو قد توفيّ الآن، قرّر
.هيمورا كنشين اللّجوء لابنه سيكو

3
00:00:14,660 --> 00:00:15,650
!ولكن

4
00:00:16,200 --> 00:00:20,910
قرّر سيكو الّذي يسعى للسّلام
.التّوقّف عن صناعة السّيوف

5
00:00:21,760 --> 00:00:26,580
،أمّا كنشين النّبيل والشّريف
.فقد رفض الضّغط عليه

6
00:00:27,850 --> 00:00:31,970
ورغم إحباطه، بدأ البحث عن
.سيف ساكاباتو جديد من البداية

7
00:00:35,230 --> 00:00:37,200
!إنّك نبيل أكثر من اللاّزم

8
00:00:38,010 --> 00:00:41,520
.إنّ ذلك الخرِع لم يتحلّ ولو بذرّة شجاعة

9
00:00:41,660 --> 00:00:45,000
!إن أصررتَ عليه أكثر، كان ليصنع لك سيفًا

10
00:00:45,140 --> 00:00:46,000
.كلاّ

11
00:00:47,920 --> 00:00:50,280
.يعيش سيكو-دونو حياة مسالمة الآن

12
00:00:50,410 --> 00:00:53,530
بأيّ حقّ أطلب منه التّخلّي عن ذلك؟

13
00:00:53,660 --> 00:00:56,230
.إنّك بالفعل نبيل أكثر من اللاّزم

14
00:00:56,530 --> 00:00:59,150
،حتّى لو كنّا قد أجبرناه

15
00:00:59,290 --> 00:01:03,040
.فلن يكون لسيف صُنع بالإكراه أيّ روح

16
00:01:03,210 --> 00:01:07,340
إن واجه سيتا سوجيرو
،الّذي كسر سيفه السّابق

17
00:01:07,480 --> 00:01:09,630
...أو شيشيو ماكوتو بسيف كهذا

18
00:01:10,130 --> 00:01:12,840
.فسيفقد هيمورا-كُن حياته

19
00:01:15,180 --> 00:01:18,380
إنّه لا يحتاج لسيف ساكاباتو
.بغرض العرض فحسب

20
00:01:18,540 --> 00:01:20,190
على سيفه الجديد

21
00:01:20,320 --> 00:01:23,520
.أن يتجاوز السّيف الّذي كُسر بمراحل

22
00:01:23,780 --> 00:01:25,990
ألا تفهمين ذلك؟

23
00:01:26,130 --> 00:01:29,350
.يا إلهي، لقد ربّيتُ أكبر أغبياء البلدة بالفعل

24
00:01:29,810 --> 00:01:34,030
ما الّذي ستفعله حيال ذلك؟ –
...علينا اللّجوء إلى حدّادين آخرين –

25
00:01:35,380 --> 00:01:37,360
!عجوز خرف

26
00:01:40,410 --> 00:01:43,190
"!ثافح! ثافح"

27
00:01:43,870 --> 00:01:45,560
.هذا أفضل

28
00:01:45,930 --> 00:01:49,050
،لو أنّي أقنعتُ سيكو-دونو بصنع سيف لي

29
00:01:49,210 --> 00:01:51,920
.لجعلَته جماعة شيشيو يدفع ثمن ذلك

30
00:01:53,090 --> 00:01:56,990
أرفض إلحاق الأذى بهذه العائلة
.الّتي تزدهر في سلام حقبة ميجي

31
00:01:58,340 --> 00:02:00,200
.وكذلك الوضع لمطعم أوُيْيا

32
00:02:00,920 --> 00:02:03,880
رغم أنّ أفراده أعضاء سابقون
،في الأونيوابانشو

33
00:02:04,030 --> 00:02:07,340
.فلن ينجّيهم ذلك من بطش شيشيو ورجاله

34
00:02:07,780 --> 00:02:10,330
،بمجرّد إيجاد الرّجل الآخر

35
00:02:10,510 --> 00:02:11,820
.سأغادر هذا المكان

36
00:02:12,150 --> 00:02:14,690
!أودّ أن أذكّرك أنّنا نبذل الكثير لأجلك هنا

37
00:02:14,860 --> 00:02:17,530
!لذلك على الأقلّ لا تشرد هكذا

38
00:04:03,250 --> 00:04:06,680
.يا له من ترحيب يا هوجي

39
00:04:07,150 --> 00:04:10,170
هل تولّيت أمر المهمّة الّتي أوكلتُها لك؟

40
00:04:10,400 --> 00:04:11,310
.نعم

41
00:04:11,540 --> 00:04:14,310
.تمّ توفير كلّ الأسلحة كما خطّطنا

42
00:04:15,730 --> 00:04:17,860
بالمناسبة، أين هو سوجيرو؟

43
00:04:18,030 --> 00:04:22,150
أرسلتُه لجمع أعضاء السّيوف
.العشرة المنتشرين في الشّرق

44
00:04:22,610 --> 00:04:26,390
لن يكون من السّهل العثور على
.بعضهم مثل أنجي

45
00:04:26,780 --> 00:04:30,460
لذا قمتُ بنفسي بإرسال رسائل
.إلى الأعضاء في الغرب

46
00:04:31,090 --> 00:04:32,120
...هذا يعني

47
00:04:32,640 --> 00:04:33,590
...نعم

48
00:04:37,550 --> 00:04:40,100
،بمجرّد اجتماع السّيوف العشرة

49
00:04:40,260 --> 00:04:41,940
.سيبدأ غزونا لهذه البلاد

50
00:04:44,390 --> 00:04:47,260
!شيشيو-ساما! شيشيو-ساما! شيشيو-ساما

51
00:04:51,560 --> 00:04:53,630
!أسمعتم يا رفاقي؟

52
00:04:53,760 --> 00:04:56,080
!لقد حان الوقت لنشرع في ثورتنا أخيرًا

53
00:04:56,230 --> 00:04:59,230
!كونوا على أهبة الاستعداد

54
00:04:59,370 --> 00:05:03,740
!شيشيو-ساما! شيشيو-ساما! شيشيو-ساما

55
00:05:05,150 --> 00:05:07,950
"أسمعتم يا رفاقي؟"

56
00:05:08,490 --> 00:05:10,990
ألا ترى أنّك بالغت كثيرًا في عرضك ذاك؟

57
00:05:11,130 --> 00:05:14,430
على العكس، أنا منغمس في الكامل
.في دوري كضابط عسكريّ

58
00:05:14,560 --> 00:05:18,030
لذلك، سأغادر الآن لإبلاغ
.قوّاتنا في كلّ أرجاء البلاد

59
00:05:18,160 --> 00:05:19,000
.انتظر

60
00:05:20,500 --> 00:05:22,610
.لم أقل كلّ ما لديّ بعد

61
00:05:23,240 --> 00:05:26,840
.سيأخذ جمع كلّ السّيوف العشرة وقتًا

62
00:05:26,980 --> 00:05:31,170
،وبعد كلّ هذا الخمول
.أراهن أنّهم كالجالس على الجمر

63
00:05:31,410 --> 00:05:33,770
،بدل إرسالهم للمشاركة في ثورتنا

64
00:05:33,910 --> 00:05:36,890
لنضعهم في طريق سلاح
.الحكومة السّرّيّ الوحيد

65
00:05:37,320 --> 00:05:40,360
ستكون مواجهتهم لهيمورا الباتّوساي
.إحماءً كافيًا لهم

66
00:05:42,710 --> 00:05:44,040
.مفهوم

67
00:05:44,170 --> 00:05:49,890
إذًا فهذا هو السّبب الّذي جعلك
.تطلب منّي مراقبة الباتّوساي

68
00:05:50,520 --> 00:05:52,080
!أنا أعترض

69
00:05:52,210 --> 00:05:54,040
،السّيوف العشرة هم سلاحنا

70
00:05:54,180 --> 00:05:59,820
إنّهم وحدة من النّخبة لا تحفّظات
.لها لاغتيال مسؤولين حكوميّين

71
00:05:59,970 --> 00:06:05,210
لذلك فإنّ استعمالهم لمجابهة
!الباتّوساي سيكون قمّة في الغباء

72
00:06:05,390 --> 00:06:08,380
.ألم أخبرك؟ لا يهتمّ هوجي لخطّتك أبدًا

73
00:06:09,120 --> 00:06:11,560
أنا أعترف أنّه كانت لديّ نفس
.ردّة الفعل في البداية

74
00:06:11,710 --> 00:06:15,610
.لكن لا داعي للقلق
.بإمكاننا وضع ثقتنا في السّيوف العشرة

75
00:06:15,770 --> 00:06:18,770
.نعم، يومي محقّة تمامًا

76
00:06:19,400 --> 00:06:21,140
.نحن السيّوف العشرة

77
00:06:21,270 --> 00:06:24,400
.لن نُهزم أبدًا أمام هيتوكيري وضيع

78
00:06:25,010 --> 00:06:26,860
.أرى أنّك هنا سلفًا يا تشو

79
00:06:27,000 --> 00:06:29,380
.نعم، أوساكا قريبة جدًّا من هنا

80
00:06:29,500 --> 00:06:33,290
إضافة إلى أنّي وسيوفي متشوّقون
.جدًّا لنظهر معدننا الحقيقيّ

81
00:06:33,420 --> 00:06:34,620
.لا تستعجل

82
00:06:34,960 --> 00:06:37,290
.انتظر إلى أن يصل بعضة آخرون من زملائك

83
00:06:37,820 --> 00:06:40,660
هوجي، أنعرف مكان الباتّوساي؟

84
00:06:42,260 --> 00:06:44,650
.ما زلنا لم نحدّد مكانه بالضّبط

85
00:06:44,790 --> 00:06:48,250
،لكن قبل وقت ليس ببعيد
قام بزيارة أراي سيكو

86
00:06:48,380 --> 00:06:51,380
.وهو ابن حدّاد السّيوف الموهوب أراي شاكّو

87
00:06:51,760 --> 00:06:56,090
لا بدّ أنّه يبحث عن بديل للسّاكاباتو
.الّذي كسره سوجيرو

88
00:06:56,220 --> 00:06:57,060
وبعد؟

89
00:06:57,460 --> 00:07:00,620
يبدو أنّ سيكو قد رفض طلب
.صنع سيف جديد له

90
00:07:00,780 --> 00:07:05,860
حتّى أنّه لم يبعه آخر سيف
.قيل أنّ أباه صنعه قبل موته

91
00:07:08,500 --> 00:07:12,410
أقلت آخر سيف صنعه أراي شاكّو؟

92
00:07:12,570 --> 00:07:15,120
.يا لها من أخبار جيّدة

93
00:07:17,690 --> 00:07:20,830
.هدّئ من روعك. لا تقم بأيّ شيء متهوّر

94
00:07:20,980 --> 00:07:22,000
.مفهوم

95
00:07:22,780 --> 00:07:24,260
...ذلك الفتى

96
00:07:24,400 --> 00:07:28,330
.تتغيّر ملامحه دائمًا عند الحديث عن السّيوف

97
00:07:28,960 --> 00:07:31,800
.سأذهب للحمّام للتّخلّص من عناء الطّريق

98
00:07:32,170 --> 00:07:35,540
.سأنتظرك في الغرفة، فلا تجعلني أنتظر طويلاً

99
00:07:35,850 --> 00:07:36,760
.حسنًا

100
00:07:38,240 --> 00:07:41,410
.شيشيو-ساما، لا زلتُ معترضًا على قرارك

101
00:07:41,540 --> 00:07:43,580
،قد يكون أضعف الآن بالفعل

102
00:07:43,700 --> 00:07:46,900
.لكن لا يزال هيمورا الباتّوساي قاتلاً أسطوريًّا

103
00:07:47,040 --> 00:07:49,950
إن استطاعت مواجهته للسّيوف العشرة

104
00:07:50,090 --> 00:07:54,380
،أن توقظ أيّام مجده السّابقة
!فسيُعرقل ذلك ثورتنا

105
00:07:54,520 --> 00:07:56,280
.لا أهتمّ على الإطلاق

106
00:07:57,450 --> 00:07:58,790
،إن حدث ذلك

107
00:07:58,930 --> 00:08:02,010
.سأتولّى شخصيًّا الإطاحة بالباتّوساي

108
00:08:02,140 --> 00:08:04,330
.وهو أمر لا أمانعه على الإطلاق

109
00:08:05,940 --> 00:08:09,760
لكنّ السّيوف العشرة تضمّ
،سوجيرو وأوسوي

110
00:08:09,900 --> 00:08:12,250
لذلك ففرص حدوث ذلك
.تكاد تكون منعدمة

111
00:08:12,380 --> 00:08:16,050
.سأكون راضيًا مهما كانت النّتيجة

112
00:08:24,900 --> 00:08:29,020
.كما توقّعت. لا شيء قد ينال من هذا الرّجل

113
00:08:44,740 --> 00:08:46,700
!مكنسة! مكنسة

114
00:08:47,650 --> 00:08:49,550
!كم تحبّ المزاح يا صغير

115
00:08:49,710 --> 00:08:50,870
!خذ

116
00:08:51,070 --> 00:08:52,100
كينداما؟

117
00:08:52,230 --> 00:08:54,100
!بابا بارع

118
00:08:54,230 --> 00:08:56,600
فعلاً؟ أوالدك بارع لتلك الدّرجة؟

119
00:08:56,740 --> 00:09:01,310
،أنا بارع أيضًا! لم أجربّها من قبل
!لكنّ ذلك لن يمنعني

120
00:09:01,640 --> 00:09:04,460
!راقب جيّدًا أيّها الصّغير

121
00:09:04,590 --> 00:09:06,270
.أنت تواجه محترفًا

122
00:09:07,050 --> 00:09:09,020
!لنبدأ... أجل

123
00:09:10,860 --> 00:09:12,340
!فشلت، فشلت

124
00:09:12,480 --> 00:09:16,610
.انسَ ذلك. كنت أقوم بالإحماء فحسب

125
00:09:18,860 --> 00:09:22,110
.شاهد، سأنجح في المرّة القادمة

126
00:09:27,290 --> 00:09:29,460
!هيّا! ماذا؟ كلاّ

127
00:09:36,290 --> 00:09:39,050
مرحبًا بك. هل تبحث عن شيء ما؟

128
00:09:39,690 --> 00:09:41,160
.يكفي لعبًا

129
00:09:43,980 --> 00:09:46,930
.أنا أبحث عن آخر أعمال شاكّو

130
00:09:52,670 --> 00:09:53,810
أهو لديك؟

131
00:09:56,140 --> 00:09:58,180
هل أنت بخير يا هيمورا-كُن؟

132
00:09:58,320 --> 00:09:59,570
.نوعًا ما

133
00:09:59,730 --> 00:10:02,650
!هنالك حدّ لهرائك! اعتذري

134
00:10:02,790 --> 00:10:06,040
.إنّها غلطتي لو سحمت، كان انتباهي مشتّتًا

135
00:10:06,420 --> 00:10:11,250
على أيّ حال، عليك نسيان
.أن يصنع سيكو سيفًا لك

136
00:10:11,500 --> 00:10:12,710
.بكلّ تأكيد

137
00:10:13,180 --> 00:10:14,530
...ولكن

138
00:10:16,180 --> 00:10:17,170
أبي؟

139
00:10:17,570 --> 00:10:19,340
آخر أعماله؟

140
00:10:19,680 --> 00:10:22,860
.نعم. هذا ما سمعتُ به

141
00:10:22,990 --> 00:10:26,180
يقال أنّ أراي شاكّو العظيم صنع
.سيفًا أخيرًا قبل موته

142
00:10:26,800 --> 00:10:30,140
أتمانع لو ألقيت نظرة عليه؟

143
00:10:30,470 --> 00:10:33,460
من أين سمع بأمر السّيف؟

144
00:10:34,730 --> 00:10:37,690
أعتذر، لا أدري عمّ تتحدّث؟

145
00:10:37,930 --> 00:10:41,730
لا نعرف أيّ شيء عن آخر
.سيف صنعه أبي

146
00:10:41,880 --> 00:10:44,160
.ما عدت أملك أيًّا من أعماله

147
00:10:49,040 --> 00:10:53,030
.للأسف، لا بدّ أنّي كنتُ مخطئًا

148
00:10:53,330 --> 00:10:55,210
.أعتذر بشدّة

149
00:10:56,240 --> 00:10:57,470
.أرجو ألاّ تلوماني على هذا

150
00:10:57,600 --> 00:11:02,680
إنّني في الحقيقة أحبّ السّيوف
.بجنون وأتوق لتجربتها كلّها

151
00:11:02,810 --> 00:11:05,300
.لذلك السّبب صرت سيّافًا

152
00:11:09,020 --> 00:11:10,050
ما الّذي تفعله؟

153
00:11:10,180 --> 00:11:11,730
.انتظر وسترى

154
00:11:22,450 --> 00:11:23,360
!إيوري

155
00:11:38,590 --> 00:11:41,210
.إنّ هذه تقنية إغماد السّيف في الهواء

156
00:11:41,350 --> 00:11:43,680
.إنّها ليست أمرًا يبرع فيه الكثير من النّاس

157
00:11:44,020 --> 00:11:45,060
.أجل

158
00:11:46,120 --> 00:11:50,890
عندما أخبرتني أنّك لا تملك
.السّيف، صُدمت للغاية

159
00:11:51,120 --> 00:11:53,790
،أنا أحبّ كلّ السّيوف بالفعل

160
00:11:53,920 --> 00:11:57,750
لكنّ سيوف شاكّو تحمل مكانة
.مميّزة في قلبي

161
00:11:57,890 --> 00:12:00,700
.هذا ليس جيّدًا على الإطلاق

162
00:12:01,610 --> 00:12:04,780
.أخشى أنّي قد أفشل في محاولتي التّالية

163
00:12:05,820 --> 00:12:06,740
!إيوري

164
00:12:08,310 --> 00:12:09,370
!يا عزيزي

165
00:12:10,420 --> 00:12:15,620
ليس من عادتي فعلاً القيام
.بنفس الخدعة مرّتين على التّوالي

166
00:12:15,830 --> 00:12:19,800
!تراجعا واستمتعا بالعرض

167
00:12:20,050 --> 00:12:21,630
!متّعا أنظاركما

168
00:12:22,360 --> 00:12:25,170
.انتظر! سيف والد زوجي ليس هنا

169
00:12:25,320 --> 00:12:26,220
!أزوسا

170
00:12:28,180 --> 00:12:32,920
،لقد تمّ إهداء آخر أعماله
!إنّه موجود في ضريح هاكوسان

171
00:12:33,070 --> 00:12:35,200
.إذًا فأنتما تعرفان بالفعل أين مكانه

172
00:12:35,340 --> 00:12:39,150
.ليس من اللّطيف أن تكذبا هكذا

173
00:12:39,590 --> 00:12:41,970
.حسنًا، أظنّني سأمرّ على المكان

174
00:12:42,100 --> 00:12:47,030
سأحتفظ بالطّفل حتّى أتأكّد
.من أنّكما تقولان الحقيقة

175
00:12:50,590 --> 00:12:53,700
.وإيّاكما أن تلجآ للشّرطة أيضًا

176
00:12:53,840 --> 00:12:58,990
أنا لستُ خائفًا منهم من الأساس، لكن
.طلب منّي شيشيو-ساما ألاّ أجلب الأنظار

177
00:12:59,320 --> 00:13:01,550
...لذلك لا تخبرا أحدًا بالأمر

178
00:13:02,190 --> 00:13:04,380
أم عليّ إخباركما بالعواقب؟

179
00:13:04,510 --> 00:13:07,220
!سنلتزم الصّمت! لا تؤذ إيوري فحسب

180
00:13:43,790 --> 00:13:47,010
.أنا بارع أكثر باستعمال السّيف

181
00:13:54,590 --> 00:13:59,040
.يحتاج هيمورا لسيف جديد
.سأقوم بإقناع ذلك الخرِع

182
00:13:59,180 --> 00:14:01,280
لماذا أخبرته؟

183
00:14:02,620 --> 00:14:06,360
لقد صنع أبي ذلك السّيف
.بنيّة أن يصير سيفًا مقدّسًا

184
00:14:06,510 --> 00:14:09,360
.لم يتمّ استلاله من غمده من قبل أبدًا

185
00:14:09,630 --> 00:14:13,570
إنّه السّيف الوحيد من سيوفه
.الّذي لم يلطّخ بالدّماء بعد

186
00:14:14,150 --> 00:14:16,240
،إن تلطّخ هذا السّيف بالدّماء

187
00:14:16,390 --> 00:14:18,410
.فسيفقد أبي ما تبقّى له من كرامة

188
00:14:18,620 --> 00:14:22,210
،لن يُعتبر حدّاد سيوف
.بل الرّجل الّذي صنع أدوات قتل

189
00:14:22,430 --> 00:14:23,840
...ورغم ذلك

190
00:14:24,070 --> 00:14:27,660
،لو لم أقل أيّ شيء
ماذا كان سيحلّ بإيوري في رأيك؟

191
00:14:27,820 --> 00:14:32,030
،أعرف أنّ شرف والدك مهمّ
!لكنّه هدّد حياة ابننا

192
00:14:32,180 --> 00:14:35,060
هل رأيت عيني ذلك الرّجل؟

193
00:14:35,490 --> 00:14:38,420
.لم يكن محبّ سيوف عاديّ فحسب

194
00:14:38,660 --> 00:14:39,890
...إنّ عيناه

195
00:14:40,500 --> 00:14:43,470
!كانت عينا رجل يحبّ سلب الأرواح

196
00:14:44,670 --> 00:14:47,900
...إن عثر على سيف أبي

197
00:14:48,050 --> 00:14:49,460
.فلن يتردّد أبدًا

198
00:14:49,610 --> 00:14:53,140
!سيسرع لتجربته في الحال

199
00:14:53,680 --> 00:14:54,820
...سُحقًا

200
00:14:55,170 --> 00:14:59,880
.تخلّيتُ عن صنع السّيوف
فلماذا يحدث هذا لي؟

201
00:15:00,520 --> 00:15:02,450
!أخبراني بكلّ شيء بالتّفصيل

202
00:15:04,760 --> 00:15:05,960
!أيّتها الجدّة أوشيغي

203
00:15:06,110 --> 00:15:09,710
!مرحبًا يا ميساو-تشان
.أرى أنّك عدت لكيوتو

204
00:15:09,860 --> 00:15:13,040
.لديّ رسالة لجدّي
!استعملي الرّو الأوّل

205
00:15:13,440 --> 00:15:14,430
.في الحال

206
00:15:22,020 --> 00:15:25,440
.إنّها رسالة من شيغي
.إنّه الرّو الأوّل لديها

207
00:15:26,260 --> 00:15:29,820
إنّها طريقة تواصل تستعملها
.شبكة الأونيوابانشو

208
00:15:30,030 --> 00:15:32,860
تنقسم كيوتو إلى أحياء حسب
،التّسلسل الأبجديّ

209
00:15:33,010 --> 00:15:36,230
،وينقسم كلّ واحد منها لثلاثة
.ليكون المجموع هو 141

210
00:15:36,370 --> 00:15:40,880
.تنتقل المعلومات بسرعة كما ترى

211
00:15:41,140 --> 00:15:42,960
.ماذا؟ إنّها من ميساو

212
00:15:43,120 --> 00:15:45,920
...غادرت دون أن تقول إلى أين

213
00:15:51,700 --> 00:15:56,340
.اختطف أحد أتباع شيشيو ابن سيكو

214
00:15:57,520 --> 00:16:00,890
!انتظر يا هيمورا-كُن
!السّاكاباتو خاصّتك مكسور

215
00:16:01,060 --> 00:16:04,020
!ستكون لخصمك أفضليّة كبيرة عليك

216
00:16:04,940 --> 00:16:06,660
...هيمورا-كُن

217
00:16:11,650 --> 00:16:14,240
.أخذ منّي هذا الأمر وقتًا

218
00:16:14,380 --> 00:16:17,910
.إنّ تصميم مدينة كيوتو سخيف للغاية

219
00:16:18,140 --> 00:16:21,460
...لا بأس، آخر أعمال ساكّو

220
00:16:21,610 --> 00:16:24,010
...أتساءل أيّ نوع من أسلحة الموت يكون

221
00:16:32,160 --> 00:16:33,550
"!رجاءً"

222
00:16:36,670 --> 00:16:40,060
.لا تبدو لي كشخص أتى لزيارة الضّريح

223
00:16:40,210 --> 00:16:41,690
من تكون؟

224
00:16:49,720 --> 00:16:52,230
ندبة على شكل تقاطع على خدّه الأيسر؟

225
00:16:54,440 --> 00:16:55,690
!فهمت

226
00:16:55,820 --> 00:16:59,120
إذًا فأنت هو الهيتوكيري باتّوساي الشّهير؟

227
00:16:59,270 --> 00:17:02,210
.ظننتُ أنّك ستكون أطول

228
00:17:02,360 --> 00:17:05,330
.تبدو مثل امرأة

229
00:17:05,700 --> 00:17:06,970
.ذلك لا يهمّ

230
00:17:07,190 --> 00:17:11,550
حسنًا، هل أتيت لاختبار آخر
أعمال شاكّو أيضًا؟

231
00:17:11,890 --> 00:17:16,350
لسوء الحظّ، أنا أبحث عن نوع
.مختلف من السّيوف

232
00:17:16,590 --> 00:17:19,500
.إن كنت تريد سيف شاكّو، فخذه

233
00:17:20,020 --> 00:17:22,530
.ولكن اترك الطّفل أوّلاً

234
00:17:22,890 --> 00:17:26,790
أتحاول تجنّب قتال غير ضروريّ
بهذه الطّريقة؟

235
00:17:26,950 --> 00:17:30,470
.فحسب اعتقادي، سيفك السّاكاباتو مكسور

236
00:17:30,620 --> 00:17:35,580
عليّ الاعتراف، لستُ متحمّسًا
.لقتال رجل لا يريد القتال

237
00:17:35,710 --> 00:17:39,780
ولكن إن اعترض طريقي عدوّ
،رسميّ لنا ولم أواجهه

238
00:17:40,160 --> 00:17:43,100
.فأعتقد أنّ شيشيو-ساما سيقتلني

239
00:17:43,520 --> 00:17:44,550
...إضافة لذلك

240
00:17:46,680 --> 00:17:49,710
،إن حصلتُ على سيف شاكّو الأخير

241
00:17:50,030 --> 00:17:53,210
.فسأحتاج لشيء ما لأجرّبه

242
00:17:54,620 --> 00:17:59,430
.ولطالما أردتُ تقطيع طفل

243
00:18:01,070 --> 00:18:04,480
.لذلك أنا أرفض طلبك

244
00:18:04,620 --> 00:18:07,060
.لنتواجه رجلاً لرجل

245
00:18:07,200 --> 00:18:09,870
،تعلم أنّ سيفي مكسور
،ولديك رهينة

246
00:18:10,020 --> 00:18:12,270
ومع ذلك تتحدّث عن قتال رجل لرجل؟

247
00:18:12,700 --> 00:18:14,200
.إنّك تسخر منّي

248
00:18:14,350 --> 00:18:16,550
.لا أسخر منك على وجه التّحديد

249
00:18:16,700 --> 00:18:19,200
!أسخر من تصرّفك المتغطرس فحسب

250
00:18:20,890 --> 00:18:21,950
!خذ هذا

251
00:18:23,980 --> 00:18:26,200
إن كنت تريد قتلي

252
00:18:26,340 --> 00:18:29,290
فهاجم بتقنية أقوى من تقنية
.غاتوتسو الخاصّة بسايتو

253
00:18:31,550 --> 00:18:33,090
.أسلوب هيتن ميتسوروغي

254
00:18:33,440 --> 00:18:35,020
!وميض التّنّين الملتفّ

255
00:18:42,170 --> 00:18:46,470
،فهمت. قد تبدو ضعيفًا
.لكنّ ضرباتك قويّة

256
00:18:46,840 --> 00:18:51,060
لكنتُ قد تأذّيتُ بشدّة
.لو لم أملك سيوفًا في ظهري

257
00:18:51,250 --> 00:18:52,410
،ومع ذلك

258
00:18:52,560 --> 00:18:55,730
.ستندم لأنّك أغضبتني

259
00:18:56,450 --> 00:19:00,990
،إليك واحدًا من أعمال شاكّو الأولى
!السّيفين التّوأم

260
00:19:01,340 --> 00:19:05,990
بوجود نصلين قريبين من بعضهما
،هكذا، ستتكبّد إصابتين قريبتين

261
00:19:06,120 --> 00:19:08,830
.وسيكون من الصّعب تقطيب ذلك

262
00:19:08,960 --> 00:19:10,120
...بمعنى آخر

263
00:19:10,120 --> 00:19:14,580
حتّى إن لم أصب أعضاءك الحيويّة، فإنّ
.أيّ جرح من هذا السّيف سيكون قاتلاً

264
00:19:14,710 --> 00:19:18,090
!ستموت بعد أن تلتهمك الغنغرينا

265
00:19:21,190 --> 00:19:23,630
أهذا هو كلّ ما في جعبتك؟

266
00:19:26,340 --> 00:19:27,850
.أسلوب هيتن ميتسوروغي

267
00:19:29,150 --> 00:19:30,620
!وميض التّنّين المحلّق

268
00:19:35,620 --> 00:19:38,910
.آسف لأنّك اضطررت للانتظار
.سأنزلك في الحال

269
00:19:40,470 --> 00:19:42,340
.مفهوم

270
00:19:43,020 --> 00:19:45,120
.كنتَ على حقّ

271
00:19:45,440 --> 00:19:50,200
.لقد بالغت في السّخرية منك بالفعل

272
00:19:50,440 --> 00:19:54,420
أصبتُه في نقطة حيويّة
ومع ذلك بإمكانه النّهوض؟

273
00:19:55,900 --> 00:19:58,840
.آسف يا إيوري. سيأخذ هذا وقتًا أطول

274
00:19:58,980 --> 00:20:02,680
!كفّ عن الحديث مع الطّفل
!انظر إليّ أنا أيّها الغبيّ

275
00:20:02,820 --> 00:20:05,010
!سأقتل هذا الشّقيّ إن تجاهلتني ثانية

276
00:20:07,520 --> 00:20:11,300
عجبًا، تبدو كقاتل بالفعل
.عندما ترغب في ذلك

277
00:20:11,430 --> 00:20:14,060
.لا يجب عليك أن تخدع الآخرين

278
00:20:14,210 --> 00:20:18,720
لو أنّك أريتني هذه النّظرة
.من البداية، لبذلتُ كلّ قوّتي أيضًا

279
00:20:20,920 --> 00:20:22,900
.درع فضّيّة

280
00:20:23,380 --> 00:20:25,860
.ذلك هو سبب نجاته من وميض التّنّين المحلّق

281
00:20:29,980 --> 00:20:34,750
!تأخّرت كثيرًا يا جدّي
!أرسلتُ لك أفضل حمامة

282
00:20:34,890 --> 00:20:35,940
ماذا عن هيمورا؟

283
00:20:36,080 --> 00:20:39,440
.انطلق بمجرّد أن عرف بالأمر
.لم أستطع اللّحاق به

284
00:20:39,580 --> 00:20:43,330
!لكنّ سيفه مكسور
.لذلك السّبب طلبتُ مساعدتك أنت

285
00:20:43,480 --> 00:20:44,510
!لنسرع

286
00:20:47,790 --> 00:20:49,550
!بدأت المعركة سلفًا

287
00:20:50,540 --> 00:20:51,390
...ذلك

288
00:20:56,200 --> 00:21:00,080
انتبه! ما لدى ذلك الرّجل حول
!خصره ليس درعًا

289
00:21:00,480 --> 00:21:04,210
.إنّه سيف قضى أبي شهورًا في تطويره

290
00:21:04,340 --> 00:21:06,770
!إنّه أحد سيوفه المميتة

291
00:21:08,330 --> 00:21:11,910
،أنا صيّاد السّيوف تشو
.أحد السّيوف العشرة

292
00:21:12,060 --> 00:21:14,920
.ليبدأ الجنون الآن

293
00:22:47,380 --> 00:22:50,420
."في الحلقة القادمة: "استلال السّيف المحرّم