1
00:00:07,770 --> 00:00:08,760
من تكون؟

2
00:00:08,880 --> 00:00:10,140
!أيّها الوغد

3
00:00:11,040 --> 00:00:15,110
لا أرى أيّ فائدة من التّعريف عن
.نفسي لرجال يوشكون على الموت

4
00:00:17,310 --> 00:00:18,370
!لنقم بهذا

5
00:00:35,500 --> 00:00:37,970
.كان حظّك تعيسًا يا فتى

6
00:00:38,550 --> 00:00:42,560
تداعى كلّ شيء منذ وصول
.السّفن السّوداء قبل سنتين

7
00:00:42,680 --> 00:00:45,200
.تحوّل العديد من السّاموراي لقطع الطّريق

8
00:00:45,740 --> 00:00:48,400
.ووضعني القدر على طريقهم

9
00:00:48,580 --> 00:00:50,680
.لقد تمّ الانتقام لك مهما كان الوضع

10
00:00:54,420 --> 00:00:58,770
.لن يُعيدهم غضبك ولا حتّى دموعك للحياة

11
00:00:59,450 --> 00:01:01,920
إنّ مثل هذه المآسي صارت أمرًا شائعًا

12
00:01:02,040 --> 00:01:04,290
.في اليابان الحاليّة

13
00:01:05,070 --> 00:01:08,630
.اعتبر نفسك محظوظًا لأنّك نجوت

14
00:01:10,180 --> 00:01:12,460
.انزل إلى القرية الّتي في أسفل الجبل

15
00:01:12,650 --> 00:01:15,920
.سيعتني بك سكّانها

16
00:01:32,520 --> 00:01:35,830
.كانت هذه ذكريات قديمة جدًّا

17
00:01:36,900 --> 00:01:39,780
أنت! إلى متى تنوي البقاء
مستلقيًا على الأرض؟

18
00:01:40,150 --> 00:01:41,490
.انهض أيّها المتكاسل

19
00:03:15,960 --> 00:03:19,960
الحلقة التّاسعة والثّلاثين
بين الحياة والموت

20
00:03:20,840 --> 00:03:22,930
.قلتُ لك انهض أيّها التّلميذ الغبيّ

21
00:03:25,540 --> 00:03:29,520
.إن لم تنهض، سأواصل الغوص أكثر في الماضي

22
00:03:29,880 --> 00:03:33,170
.مثل آخر مرّة بلّلتَ فيها فراشك

23
00:03:33,300 --> 00:03:35,520
كنتَ في الحادية عشرة حينها، صحيح؟

24
00:03:35,880 --> 00:03:39,100
أو مثل المرّة الّتي أكلت فيها
.فطرًا كاد يقتلك

25
00:03:39,230 --> 00:03:40,280
!يا معلّمي

26
00:03:40,650 --> 00:03:44,260
لماذا تذكر هذه الأوقات المحرجة
الّتي كنت قد نسيتها؟

27
00:03:44,380 --> 00:03:46,240
.إنّك لئيم بالفعل

28
00:03:46,450 --> 00:03:48,040
أنا لئيم؟

29
00:03:48,210 --> 00:03:50,930
مع أنّي كنتُ أتحمّل تلميذي الجاحد

30
00:03:51,060 --> 00:03:53,820
وتقلّبات مزاجه طوال أسبوع؟

31
00:03:53,990 --> 00:03:57,170
.بل يجب أن يتمّ الإشادة بصبري هنا

32
00:03:58,290 --> 00:03:59,130
...في كلّ الأحوال

33
00:03:59,660 --> 00:04:01,710
.بدأت هذه اللّعبة الصّغيرة تشعرني بالملل

34
00:04:02,410 --> 00:04:05,220
،عليك إصابتي في هجومك التّالي

35
00:04:05,340 --> 00:04:07,570
.وإلاّ فلن أعلّمك التّقنية السّرّيّة

36
00:04:09,090 --> 00:04:11,620
،المعلّم الحاليّ لأسلوب هيتن ميتسوروغي

37
00:04:11,960 --> 00:04:15,730
الثّالث عشر من بين من حملوا
.اسم هيكو سيجورو

38
00:04:16,410 --> 00:04:19,580
.هذا ليس وقتًا مناسبًا للتّهاون

39
00:04:20,310 --> 00:04:22,780
...إن كانت هذه فرصتي الأخيرة

40
00:04:23,420 --> 00:04:26,240
.عليّ بذل كلّ ما لديّ

41
00:04:29,900 --> 00:04:31,000
.سأهاجم

42
00:04:32,080 --> 00:04:33,160
.هلمّ

43
00:04:40,090 --> 00:04:41,670
...أسلوب هيتن ميتسوروغي

44
00:04:41,880 --> 00:04:43,340
!وميض مطرقة التنّين

45
00:04:43,500 --> 00:04:44,840
!وميض التّنّين المحلّق

46
00:04:54,660 --> 00:04:56,730
هل ستستمرّ في النّوم طويلاً؟

47
00:04:57,470 --> 00:04:59,150
.انهض بسرعة

48
00:05:03,850 --> 00:05:07,530
ركّزتَ على الهجوم على
.حساب كلّ شيء آخر

49
00:05:07,680 --> 00:05:10,770
،إن تهاونت في وضعيّتك أثناء نزولك

50
00:05:10,890 --> 00:05:12,770
.فسينتهي بك المطاف بارتجاج

51
00:05:13,050 --> 00:05:14,450
!يا لك من غبيّ

52
00:05:15,490 --> 00:05:16,660
،ومع ذلك

53
00:05:17,410 --> 00:05:19,050
أفترض أنّ هذا ما تطلّبه الأمر منك

54
00:05:19,170 --> 00:05:23,660
لتستطيع أخيرًا إصابتي بهجوم
.وتحطّم عشر سنوات من الفشل

55
00:05:25,070 --> 00:05:27,890
،بإمكاني التّعليق عن أشياء عدّة بشأن وضعيّتك

56
00:05:28,020 --> 00:05:29,800
.لكنّ الإصابة تظلّ إصابة

57
00:05:30,190 --> 00:05:32,930
.سأعلّمك التّقنية السّرّيّة كما وعدت

58
00:05:33,520 --> 00:05:34,780
.استعدّ

59
00:05:38,790 --> 00:05:42,170
.استمع جيّدًا، ولا تحرّك ساكنًا مهما حدث

60
00:05:42,890 --> 00:05:45,900
.سيكلّفك أصغر خطأ حياتك

61
00:05:47,200 --> 00:05:48,360
.لنراجع الأساسيّات

62
00:05:49,020 --> 00:05:51,630
.لننظر إلى مدى هجمات السّيوف القاتلة

63
00:05:52,310 --> 00:05:53,330
...لدينا بالتّرتيب

64
00:05:54,150 --> 00:05:55,040
،الهجوم النّازل

65
00:05:55,680 --> 00:05:56,540
،قُطريًّا من اليسار

66
00:05:57,200 --> 00:05:58,290
،قُطريًّا من اليمين

67
00:05:58,950 --> 00:05:59,870
،الجانب الأيمن

68
00:06:00,400 --> 00:06:01,580
،الجانب الأيسر

69
00:06:02,120 --> 00:06:03,290
،الهجوم الصّاعد يمينًا

70
00:06:03,810 --> 00:06:05,380
،الهجوم الصّاعد يسارًا

71
00:06:05,880 --> 00:06:07,480
.الهجوم العكسيّ

72
00:06:08,230 --> 00:06:10,930
.وأخيرًا، هجوم المدى القريب

73
00:06:12,100 --> 00:06:13,110
.الطّعن

74
00:06:14,190 --> 00:06:16,520
مهما كان أسلوبك، فإنّ الهجمات القاتلة

75
00:06:16,660 --> 00:06:19,600
تكون مبنيّة دائمًا على هذه
.الهجمات التّسعة الأساسيّة

76
00:06:19,850 --> 00:06:22,030
وبشكل مماثل، تطوّرت الأشكال الدّفاعيّة

77
00:06:22,150 --> 00:06:25,110
.لصدّ هذه الهجمات الأساسيّة

78
00:06:25,360 --> 00:06:26,320
...ولكن

79
00:06:38,050 --> 00:06:41,730
عن طريق دفع السّرعة الخارقة
،للطّبيعة لأسلوبنا إلى ذروتها

80
00:06:43,080 --> 00:06:46,630
صار من الممكن توجيه كلّ
.الهجمات التّسعة دفعة واحدة

81
00:06:48,750 --> 00:06:50,880
،أسلوب هيتن ميتسوروغي

82
00:06:51,740 --> 00:06:53,250
.وميض التّنّين تُساعيّ الرّؤوس

83
00:06:58,990 --> 00:07:02,320
،وكما هو عرين التّنّين
،فإنّ هذا الهجوم محيّر

84
00:07:02,450 --> 00:07:06,750
لكنّه لا يدمج الهجمات التّسعة
،في هجوم واحد فحسب

85
00:07:06,980 --> 00:07:08,950
.بل يضيف إليه اندفاعًا

86
00:07:09,070 --> 00:07:11,570
.وهذا يجعل من المستحيل تفاديه

87
00:07:12,520 --> 00:07:15,250
.وهي التّقنية الّتي أتفوّق فيها

88
00:07:15,880 --> 00:07:18,490
.كنتُ متسمّرًا في مكاني قبل ذلك الاندفاع

89
00:07:19,180 --> 00:07:20,710
.هذه هي التّقنية السّرّيّة إذًا

90
00:07:21,340 --> 00:07:24,500
،أسلوب هيتن ميتسوروغي
.وميض التّنّين تُساعيّ الرّؤوس

91
00:07:25,920 --> 00:07:28,650
.لا تقف هناك بلا حراك
.حان دورك لتجرّب

92
00:07:29,150 --> 00:07:31,220
ماذا؟ يُفترض بي تنفيذها؟

93
00:07:31,350 --> 00:07:33,340
بالطّبع، ما الّذي كنت تتوقّعه؟

94
00:07:33,600 --> 00:07:36,820
.تختبر التّقنية وثمّ تنفّذها بنفسك

95
00:07:36,940 --> 00:07:39,230
.يأتي الإتقان من كثرة التّدريب

96
00:07:39,700 --> 00:07:42,010
!هكذا علّمتك دائمًا

97
00:07:42,920 --> 00:07:44,850
!وميض التّنّين المحلّق! وميض مطرقة التّنّين

98
00:07:44,850 --> 00:07:46,110
!وميض التّنّين الملتفّ

99
00:07:46,610 --> 00:07:48,700
...لا أصدّق أنّي نجوت من كلّ ذلك

100
00:07:48,830 --> 00:07:53,150
.هذا لأنّي أتقنت فنوني بشكل مثاليّ

101
00:07:53,460 --> 00:07:56,280
.إن كنت تفهم ذلك، جرّب الهجوم

102
00:07:57,660 --> 00:07:59,240
.ابذل كلّ ما لديك

103
00:08:07,440 --> 00:08:09,940
.بالطّبع عجزت عن أيّ ردّة فعل

104
00:08:10,380 --> 00:08:13,320
.لكنّ تفاجئي من الأمر لم يمنعني من الملاحظة

105
00:08:14,590 --> 00:08:16,300
.أسلوب هيتن ميتسوروغي

106
00:08:18,440 --> 00:08:19,810
!وميض التّنّين تُساعيّ الرّؤوس

107
00:08:36,850 --> 00:08:38,810
!يا له من فشل ذريع

108
00:08:39,750 --> 00:08:43,250
.ظننتُ أنّ هجومي كان مثاليًّا

109
00:08:43,440 --> 00:08:45,580
.بل كان كذلك بالفعل

110
00:08:46,750 --> 00:08:50,400
ولكن لسوء الحظّ، من ناحية
قوّة الذّراعين والوزن

111
00:08:50,530 --> 00:08:53,050
،اللّذين يعتبران نقطة مهمّة أثناء الاندفاع

112
00:08:53,630 --> 00:08:57,180
.فإنّي أملك أفضليّة كبيرة مقارنة بك

113
00:08:57,520 --> 00:08:59,760
في مواجهة وميض التّنّين تُساعيّ
،الرّؤوس خاصّتي

114
00:09:00,200 --> 00:09:02,450
.لن يرتقي خاصّتك للمستوى المطلوب

115
00:09:02,580 --> 00:09:05,350
.ولا حتّى أيّ من تقنياتك الأخرى أيضًا

116
00:09:09,240 --> 00:09:12,950
واعلم أنّه في مواجهة وميض
،التّنّين تُساعيّ الرّؤوس خاصّتي

117
00:09:13,260 --> 00:09:15,570
.لا تنفع إلاّ تقنية واحدة

118
00:09:20,480 --> 00:09:23,710
إنّها التّقنية السّرّيّة الأقوى
.لأسلوب هيتن ميتسوروغي

119
00:09:24,140 --> 00:09:26,410
.وميض التّنّين الطّائر المقدّس

120
00:09:35,920 --> 00:09:38,430
لماذا تلك النّظرة المتفاجئة؟

121
00:09:38,940 --> 00:09:43,250
لم أذكر أبدًا أنّ وميض التّنّين تُساعيّ
.الرّؤوس كانت التّقنية السّرّيّة الأقوى

122
00:09:44,150 --> 00:09:46,730
.وهي التّقنية الّتي أتفوّق فيها

123
00:09:49,310 --> 00:09:50,870
.خُدعتُ ثانية

124
00:09:52,680 --> 00:09:55,420
إنّ وميض التّنّين تُساعيّ الرّؤوس
أشبه باختبار

125
00:09:55,540 --> 00:09:57,740
.أثناء محاولة نقل وميض التّنّين الطّائر المقدّس

126
00:09:58,200 --> 00:10:01,370
إن نجحتَ في صدّ وميض التّنّين
،تُساعيّ الرّؤوس القاتلة

127
00:10:01,490 --> 00:10:03,950
.فذلك يعني أنّك أتقنت التّقنية السّرّيّة الأقوى

128
00:10:04,630 --> 00:10:05,700
...ولكن

129
00:10:05,950 --> 00:10:09,830
تأمّل للحظة في طبيعة
.وميض التّنّين تُساعيّ الرّؤوس

130
00:10:10,150 --> 00:10:13,780
وعند القيام بذلك، ستُكشف لك
وميض التّنّين الطّائر المقدّس

131
00:10:13,900 --> 00:10:15,580
.وستتمكنّ من استخدامها

132
00:10:15,910 --> 00:10:18,120
طبيعة وميض التّنّين تُساعيّ الرّؤوس؟

133
00:10:30,070 --> 00:10:33,650
.إنّه هجوم لا يمكن تفاديه أو صدّه

134
00:10:34,010 --> 00:10:35,250
...الحلّ الوحيد هو

135
00:10:35,640 --> 00:10:39,900
كسر زخم الهجوم باستعمال
.تقنيات سحب السّيف

136
00:10:40,350 --> 00:10:41,930
.أحسنت عملاً

137
00:10:42,470 --> 00:10:45,850
.تقنية سحب سيف بسرعة تفوق سرعة التّنّين

138
00:10:46,080 --> 00:10:50,130
،تلك هي التّقنية السّرّيّة الأقوى
.وميض التّنّين الطّائر المقدّس

139
00:10:50,560 --> 00:10:54,870
،ولكن بما أنّك تستعمل ساكاباتو
.فإنّ في وضع غير مؤات سلفًا

140
00:10:55,000 --> 00:10:59,030
هل ستكون قادرًا على
التّفوّق على سرعة ضرباتي؟

141
00:11:09,020 --> 00:11:12,170
...سيفك في غمده مع وضعية استرخاء

142
00:11:12,560 --> 00:11:13,850
.إنّك تلعب بالنّار

143
00:11:14,280 --> 00:11:15,780
.أنا مدرك لذلك

144
00:11:15,940 --> 00:11:17,610
.لكنّ خياراتي محدودة

145
00:11:18,240 --> 00:11:20,050
عليّ قبول الموت

146
00:11:20,390 --> 00:11:23,360
.إن كنت أريد تعلّم التّقنية السّرّيّة الأقوى

147
00:11:34,480 --> 00:11:35,920
.سأمنحك ليلة واحدة

148
00:11:36,280 --> 00:11:38,580
ابحث في روحك حتّى الصّباح

149
00:11:38,700 --> 00:11:41,050
.وجد ما تفتقر له قبل ذلك

150
00:11:41,670 --> 00:11:43,170
،إن لم تستطع لك

151
00:11:43,330 --> 00:11:45,260
لن تتقن أبدًا التّقنية السّرّيّة الأقوى

152
00:11:45,540 --> 00:11:48,960
.وستفقد حياتك بغباء

153
00:12:10,170 --> 00:12:11,310
...عليّ أن

154
00:12:11,820 --> 00:12:13,370
أجد ما أفتقر له؟

155
00:12:20,990 --> 00:12:22,260
ألم ترَه؟

156
00:12:22,630 --> 00:12:23,660
.لا

157
00:12:23,940 --> 00:12:27,230
.لم نرَ فتى أو أيّ أحد منذ أسبوع

158
00:12:27,370 --> 00:12:28,220
.تفضّل

159
00:12:30,640 --> 00:12:34,480
أيعقل أنّه تخلّى عن حياته بسبب اليأس؟

160
00:12:35,090 --> 00:12:37,350
.للأسف، إنّه أمر شائع

161
00:12:38,310 --> 00:12:42,270
مع أنّي أحمل سيفًا مشبعًا بتعاليم
،أسلوب هيتن ميتسوروغي

162
00:12:42,630 --> 00:12:45,910
إلاّ أنّني لم أستطع إنقاذ العديد
.من النّاس في كثير من الأحيان

163
00:12:46,740 --> 00:12:49,530
في هذه الحقبة الّتي يخيّم
،عليها الظّلام أكثر فأكثر

164
00:12:49,780 --> 00:12:52,480
.أنا واثق من شيء واحد فقط

165
00:12:52,630 --> 00:12:55,880
.سيكون هنالك دائمًا ضحايا أدفنهم

166
00:13:11,920 --> 00:13:15,810
،أرى أنّك لم تدفن والديك فقط
ولكنّك دفنت قطّاع الطّرق أيضًا؟

167
00:13:16,350 --> 00:13:18,270
.كانوا تجّار عبيد

168
00:13:19,000 --> 00:13:21,910
.مات والداي بسبب الكوليرا قبل سنة

169
00:13:22,670 --> 00:13:23,670
...ولكن

170
00:13:24,020 --> 00:13:28,240
،لا يهمّ إن كانوا تجّار عبيد أم قطّاع طرق
.لا يمكن التّمييز بينهم بعد الموت

171
00:13:28,570 --> 00:13:31,300
.إذًا فقد دفنتهم جميعًا دون تمييز

172
00:13:32,530 --> 00:13:34,470
ماذا عن هذه القبور الثّلاثة؟

173
00:13:35,150 --> 00:13:38,920
إنّهنّ كاسومي-سان
!وأكاني-سان وساكورا-سان

174
00:13:39,850 --> 00:13:42,030
،كان والديهنّ غارقين في الدّيون

175
00:13:42,210 --> 00:13:45,130
.لذلك أُخذن من عائلاتهنّ

176
00:13:45,920 --> 00:13:50,300
،قابلتهنّ اليوم فقط
.وكنتُ الفتى الوحيد هنا

177
00:13:50,440 --> 00:13:51,970
.ويتيم

178
00:13:53,130 --> 00:13:56,850
.كنتُ عازمًا على حمايتهنّ بحياتي

179
00:13:58,080 --> 00:13:59,060
.لكنّي فشلت

180
00:14:00,940 --> 00:14:04,390
.كنتُ أودّ تزيين قبورهنّ بحجارة جميلة

181
00:14:04,580 --> 00:14:07,130
.لكن لم أعثر إلاّ على هذه الحجارة القبيحة

182
00:14:07,530 --> 00:14:09,750
،لذلك بحثت عن زهور

183
00:14:09,990 --> 00:14:11,820
.لكن لا شيء ينمو هنا

184
00:14:14,200 --> 00:14:15,540
.هذه عطيّة

185
00:14:20,610 --> 00:14:22,640
ما اسمك يا فتى؟

186
00:14:23,480 --> 00:14:24,710
.شينتا

187
00:14:25,030 --> 00:14:26,050
شينتا؟

188
00:14:37,980 --> 00:14:41,530
.إنّه اسم ليّن جدًّا ليحمله سيّاف

189
00:14:45,150 --> 00:14:46,780
،بدءًا من اليوم

190
00:14:47,380 --> 00:14:49,220
.سيصير اسمك كنشين

191
00:14:55,490 --> 00:14:57,350
،سأعلّمك ما أعرف

192
00:14:57,680 --> 00:14:59,470
.ستصير وريثي

193
00:15:17,130 --> 00:15:18,520
.إلى اليسار قليلاً

194
00:15:19,820 --> 00:15:21,690
.خنصرك في المكان الخطأ

195
00:15:22,860 --> 00:15:25,180
.إنّك تستعمل الكثير من القوّة

196
00:15:29,470 --> 00:15:31,330
.مرّت تسعة عشرة سنة

197
00:15:31,790 --> 00:15:32,660
...وغدًا

198
00:15:34,090 --> 00:15:36,870
،سواء نقلتُ إليك التّقنية السّرّيّة الأقوى أم لا

199
00:15:37,480 --> 00:15:40,180
.سيبزغ الفجر على فراقنا

200
00:15:47,220 --> 00:15:50,050
.يبدو أنّه لم يغمض لك جفن طوال اللّيل

201
00:15:50,310 --> 00:15:52,160
.وأنت أيضًا يا معلّمي

202
00:15:58,500 --> 00:16:01,390
أخبرني، هل عثرت على ما تفتقر له؟

203
00:16:03,030 --> 00:16:03,980
.لا

204
00:16:05,000 --> 00:16:06,200
.هكذا إذًا

205
00:16:07,630 --> 00:16:11,280
.خاب ظنّي، هذه هي حدودك إذًا

206
00:16:12,410 --> 00:16:15,650
،إن كنتَ عاجزًا عن العثور على ما تفتقر له

207
00:16:15,800 --> 00:16:17,610
.فيمكنك نسيان التّقنية السّرّيّة الأقوى

208
00:16:17,810 --> 00:16:21,250
.ناهيك عن هوسك بالقضاء على شيشيو وجماعته

209
00:16:21,490 --> 00:16:24,160
،حتّى إن حدثت معجزة ونجحت

210
00:16:24,290 --> 00:16:27,290
.فسيلتهمك القاتل الّذي بداخلك بالكامل

211
00:16:28,390 --> 00:16:32,050
سيلتهمك النّدم إلى الأبد وستدمّرك الوحدة

212
00:16:32,650 --> 00:16:33,880
.وسيصير ملاذك القتل فحسب

213
00:16:37,780 --> 00:16:42,100
،لا يمكنني نقل التّقنية السّرّيّة الأقوى لك
.لكن بإمكاني إنهاء معاناتك

214
00:16:42,310 --> 00:16:44,940
.إنّه واجبي الأخير تجاهك بفصتي معلّمك

215
00:17:00,730 --> 00:17:03,170
.كانت تلك العباءة تزن 40 كيلوغرامًا

216
00:17:03,300 --> 00:17:06,540
.كانت مبطّنة بنوابض تقيّد عضلاتي

217
00:17:06,930 --> 00:17:10,630
.تتلخّص وظيفتها في كبح جماح قوّة معلّم الأسلوب

218
00:17:11,240 --> 00:17:15,570
إنّها تنتقل من جيل لآخر لكلّ
.من سيحمل اسم هيكو سيجورو

219
00:17:16,950 --> 00:17:18,570
...آمل أن تكون جاهزًا

220
00:17:19,200 --> 00:17:20,350
.يا كنشين

221
00:17:23,410 --> 00:17:25,080
...إذًا فهذا هو

222
00:17:25,460 --> 00:17:27,260
.الوجه الحقيقيّ لهيكو سيجورو

223
00:17:28,390 --> 00:17:29,770
.يدي اليسرى ترتعد

224
00:17:30,630 --> 00:17:32,240
...أيفترض بي الخوف

225
00:17:32,950 --> 00:17:34,740
من هيكو سيجورو؟

226
00:17:35,460 --> 00:17:38,660
أم من الموت المحتّم الّذي يتربّص وراءه؟

227
00:17:39,680 --> 00:17:40,910
!اهدأ

228
00:17:41,370 --> 00:17:43,210
،أنا جاهز للموت

229
00:17:43,330 --> 00:17:46,750
.وكنتُ كذلك منذ أيّام نهاية الشّوغونيّة

230
00:17:47,410 --> 00:17:49,140
،وإن كلّفني ذلك حياتي

231
00:17:49,790 --> 00:17:52,470
.عليّ تعلّم التّقنية السّرّيّة الأقوى

232
00:17:53,480 --> 00:17:54,670
!لنبدأ

233
00:18:04,470 --> 00:18:05,600
الموت؟

234
00:18:06,500 --> 00:18:10,210
.لن يُعيدهم غضبك ولا حتّى دموعك للحياة

235
00:18:10,340 --> 00:18:12,740
إنّ مثل هذه المآسي صارت أمرًا شائعًا

236
00:18:12,870 --> 00:18:14,520
.في اليابان الحاليّة

237
00:18:14,660 --> 00:18:18,040
.اعتبر نفسك محظوظًا لأنّك نجوت

238
00:18:18,180 --> 00:18:19,780
ما اسمك يا فتى؟

239
00:18:19,910 --> 00:18:22,700
.إنّه اسم ليّن جدًّا ليحمله سيّاف

240
00:18:22,830 --> 00:18:26,150
.بدءًا من اليوم، سيصير اسمك كنشين

241
00:18:29,000 --> 00:18:29,920
!الموت

242
00:18:35,430 --> 00:18:37,680
كاورو-دونو؟

243
00:18:38,230 --> 00:18:40,960
!أنت هو الرّوروني الّذي أريد

244
00:18:41,670 --> 00:18:44,040
.سُحقًا. أريد أن أصير أقوى

245
00:18:44,180 --> 00:18:46,750
.من الأفضل ألاّ تغادر المكان بدون علمي

246
00:18:46,890 --> 00:18:48,350
.أفضّل الحكم بالموت

247
00:18:48,540 --> 00:18:52,840
!هيمورا الباتّوساي –
حملك للعبء وحدك والعيش تعيسًا –

248
00:18:52,980 --> 00:18:55,650
!أمر لن أرضى به أبدًا

249
00:18:56,000 --> 00:18:58,610
.اليابان مهدّدة –
.عُد إلى كيوتو –

250
00:18:58,780 --> 00:19:02,360
!كنشين

251
00:19:02,640 --> 00:19:04,620
!لا أريد الموت

252
00:19:04,770 --> 00:19:07,910
!لا يمكنني الموت! ليس الآن

253
00:19:21,480 --> 00:19:23,930
.جيّد. إذًا فقد فهمت

254
00:19:25,430 --> 00:19:29,410
.قتلتَ أشخاصًا من قبل
.قطعت خيط حياة العديد من النّاس

255
00:19:29,680 --> 00:19:32,000
،أكلك الشّعور بالذّنب والنّدم من الدّاخل

256
00:19:32,240 --> 00:19:35,330
.ولذلك لا تحترم وجودك على الإطلاق

257
00:19:35,940 --> 00:19:37,700
وأثناء قيامك بذلك، نسيتَ أنّ حياتك

258
00:19:37,820 --> 00:19:41,300
.مساوية لحياة أيّ شخص آخر، لا أكثر ولا أقلّ

259
00:19:42,690 --> 00:19:46,710
.ونتيجة لهذا، فإنك تكبح قوّتك

260
00:19:47,110 --> 00:19:48,290
،وفي بعض الأحيان

261
00:19:48,420 --> 00:19:51,750
.تفقد السّيطرة على القاتل الكامن بداخلك

262
00:19:52,290 --> 00:19:54,220
،للتّغلّب على ذلك

263
00:19:54,450 --> 00:19:57,930
تحتاج إلى ما لمحتَه للتّوّ
.عن طريق اقترابك من الموت

264
00:19:58,070 --> 00:20:00,630
.إنّ الإرادة للعيش هي ما تفتقر إليه

265
00:20:04,400 --> 00:20:06,620
...الضّعفاء والأعزّاء عليك

266
00:20:06,840 --> 00:20:10,750
،لا تملك إلاّ العطف والحنان تجاههم
.لدرجة التّضحية بنفسك

267
00:20:11,090 --> 00:20:14,040
.ولكنّ هؤلاء النّاس سيعانون بعد موتك

268
00:20:14,220 --> 00:20:16,680
.ولن تحميهم من المحن بهذه الطّريقة

269
00:20:17,330 --> 00:20:18,880
...مشاكل عصرنا

270
00:20:19,000 --> 00:20:22,900
حتّى لو ضحّيت بنفسك بكلّ
،ما أوتيت من حماسة

271
00:20:23,020 --> 00:20:24,380
...وكلّ هذا الإيثار

272
00:20:24,510 --> 00:20:28,120
.سيضيع بين ثنايا الزّمن فحسب

273
00:20:28,840 --> 00:20:32,050
.إنّ الإرادة للعيش تنتصر على كلّ شيء

274
00:20:33,100 --> 00:20:35,270
.إيّاك أن تنسى ذلك

275
00:20:36,170 --> 00:20:40,710
.صرت الآن تحمل وميض التّنّين الطّائر المقدّس

276
00:20:41,060 --> 00:20:42,900
.ستهزم شيشيو وجماعته لا محالة

277
00:20:43,370 --> 00:20:45,650
وينطبق نفس الكلام
.على القاتل القابع بداخلك

278
00:20:46,100 --> 00:20:47,940
.سوف تنتصر

279
00:20:48,630 --> 00:20:49,780
...معلّمي

280
00:20:54,840 --> 00:20:56,810
!معلّمي –
!لا داعي للقلق –

281
00:20:59,590 --> 00:21:02,610
هذه هي طقوس بدء استخدام
.وميض التّنّين الطّائر المقدّس

282
00:21:03,030 --> 00:21:05,610
.هذا هو مصير تلاميذ أسلوب هيتن ميتسوروغي

283
00:21:12,760 --> 00:21:14,050
!معلّمي

284
00:22:47,020 --> 00:22:50,480
."في الحلقة القادمة: "اجتماع السّيوف العشرة