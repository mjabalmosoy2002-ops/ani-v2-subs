1
00:00:15,860 --> 00:00:26,210
"(السّنة الرّابعة من حقبة كييو (1868"
"ضواحي أوينو"

2
00:00:16,810 --> 00:00:18,660
،في السّنة الرّابعة من حقبة كييو

3
00:00:19,240 --> 00:00:22,390
.كانت قد وضعت معركة أوينو أوزارها

4
00:00:22,820 --> 00:00:27,010
،وفي أوينو، على مشارف إيدو
اشتبكت القوّات الموالية للشّوغونيّة

5
00:00:27,150 --> 00:00:31,920
مع قوّات المناصرين للإمبراطوريّة
.من ساتسوما وتشوشو

6
00:00:32,150 --> 00:00:34,380
،ولم يستمرّ الهجوم سوى نصف يوم

7
00:00:34,530 --> 00:00:37,080
.وكان النّصر الإمبراطوريّ ساحقًا

8
00:00:37,260 --> 00:00:40,810
،وكما هو الحال مع كلّ هزيمة
.يتعرّض المهزومون لملاحقة قاسية

9
00:00:40,950 --> 00:00:42,350
.ذهبت لإلقاء نظرة

10
00:00:42,490 --> 00:00:43,570
.ممتاز

11
00:00:43,710 --> 00:00:45,460
وبعد؟ ما رأيك؟

12
00:00:45,600 --> 00:00:48,650
.لا مجال للشّكّ، إنّه هو

13
00:00:48,880 --> 00:00:50,200
أأنت واثق؟

14
00:00:50,340 --> 00:00:54,610
،إنّه يتظاهر بأنّه مزارع
!لكنّي تعرّفت عليه بسبب ذراعه

15
00:00:55,400 --> 00:00:56,780
أتريدون قتله؟

16
00:00:56,910 --> 00:00:57,970
!بالطّبع

17
00:00:58,120 --> 00:01:01,850
جعلَنا غوريلاّ إيدو شائن الصّيت
.غيتشي نعاني الكثير

18
00:01:01,980 --> 00:01:03,180
!سنطيح به

19
00:01:03,320 --> 00:01:04,250
!بلا أيّ تردّد

20
00:01:04,400 --> 00:01:06,890
.لاحقًا. لقد حان الوقت للعودة للمقرّ الرّئيسيّ

21
00:01:07,020 --> 00:01:08,680
وما علاقة ذلك بنا؟

22
00:01:08,820 --> 00:01:11,710
.نحن في مهمّة لمطاردة الجنود المهزومين

23
00:01:11,840 --> 00:01:14,920
.بإمكانكم تحقيق انتقامكم في أوقات فراغكم

24
00:01:15,050 --> 00:01:15,890
ماذا قلت؟

25
00:01:16,010 --> 00:01:19,470
عثرنا عليه للتّوّ، وها أنت تريد
منّا أن نتركه يذهب؟

26
00:01:19,610 --> 00:01:22,050
.في الجيش، لدينا جدول زمنيّ نحترمه

27
00:01:22,170 --> 00:01:25,850
.وإلاّ، فحتّى علاقاتي لن تستطيع حمايتكم

28
00:01:26,300 --> 00:01:28,580
.لا بأس إذًا. لنعد

29
00:01:28,720 --> 00:01:30,170
أأنت واثق؟

30
00:01:30,310 --> 00:01:32,180
.نحن نعرف أين يختبئ

31
00:01:32,320 --> 00:01:36,120
.سنعود مرّة أخرى لتولّي أمره

32
00:01:47,980 --> 00:01:49,000
ماذا؟

33
00:01:49,320 --> 00:01:50,610
!يا ويحي

34
00:01:52,540 --> 00:01:55,690
أتيت لتحتمي هنا من المطر؟
.لا أظنّ ذلك

35
00:01:55,840 --> 00:01:57,380
لقد تمّ التّخلّي عنك، صحيح؟

36
00:01:57,640 --> 00:01:59,050
.لا داعي للقلق الآن

37
00:02:13,110 --> 00:02:18,700
روروني كنشين
—اضطرابات كيوتو—

38
00:03:44,160 --> 00:03:45,580
...غيتشي-سان

39
00:03:47,000 --> 00:03:49,160
.أرى أنّك أحضرتِ معك واحدًا آخر

40
00:03:49,380 --> 00:03:50,880
.لم أستطع التّخلّي عنه

41
00:03:51,020 --> 00:03:54,870
،إن استمرّ هذا الوضع
.ستصير لنا حديقة حيوانات حقيقيّة

42
00:03:55,010 --> 00:03:56,710
كم عددها هذه المرّة؟

43
00:03:57,290 --> 00:03:59,190
...قطّ و

44
00:04:00,330 --> 00:04:01,550
.رجل

45
00:04:05,060 --> 00:04:08,000
أحسنت، لديك زوج سلفًا
ومع ذلك أحضرت رجلاً آخر؟

46
00:04:08,140 --> 00:04:09,790
!كفّ عن مضايقتي هكذا

47
00:04:09,920 --> 00:04:12,770
لم أستطع تركه ليلقى حتفه
.على قارعة الطّريق

48
00:04:13,000 --> 00:04:14,040
.هذه طبيعتك

49
00:04:14,560 --> 00:04:17,460
.لديك قلب طيّب، وذلك ما أحبّه فيك

50
00:04:19,150 --> 00:04:22,000
!كفّ عن هذا، إنّك تحرجني كثيرًا

51
00:04:26,130 --> 00:04:28,070
.اذهبي لتغيير ملابسك، أنت مبلّلة بالكاملة

52
00:04:28,840 --> 00:04:30,950
.ذلك ليس جيّدًا للطّفل أيضًا

53
00:04:33,940 --> 00:04:34,890
.حسنًا

54
00:04:36,060 --> 00:04:39,100
هُرير لطيف. أرى أنّك لا تثير
.الكثير من الشّغب

55
00:04:41,430 --> 00:04:44,740
.كلاّ! إنّه مبلّل أيضًا، يا له من مسكين

56
00:04:55,930 --> 00:05:01,180
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

57
00:05:01,670 --> 00:05:04,420
.عش بالسّيف، ومت بالسّيف

58
00:05:04,660 --> 00:05:07,900
.لا يجدر أن يوجد طريق آخر لك

59
00:05:16,200 --> 00:05:17,580
هل استيقظت؟

60
00:05:18,070 --> 00:05:19,390
.أيّها السّاموراي الشّابّ

61
00:05:19,550 --> 00:05:22,660
.فقدتَ وعيك، وكنت تعاني من الحمّى

62
00:05:23,460 --> 00:05:26,820
حسب مظهرك، فلا بدّ أنّك أحد
.الموالين المهزومين في أوينو

63
00:05:27,100 --> 00:05:28,550
...لا، بل أنا

64
00:05:28,680 --> 00:05:30,020
.لا داعي للقلق

65
00:05:30,920 --> 00:05:33,210
.استرح فحسب

66
00:05:36,340 --> 00:05:37,610
.أنا ممتنّ لكما

67
00:05:38,960 --> 00:05:42,110
تعالي جميعك! احرصي على
.إبقاء السّاموراي الشّابّ دافئًا

68
00:06:05,600 --> 00:06:07,800
كيف تشعر هذا الصّباح أيّها السّاموراي الشّابّ؟

69
00:06:10,260 --> 00:06:13,700
.أنا بخير. صرت في أفضل حالاتي

70
00:06:14,870 --> 00:06:17,780
.بل ما زال عليك أن ترتاح أكثر

71
00:06:19,960 --> 00:06:21,850
أين هي أغراضي؟

72
00:06:22,030 --> 00:06:24,430
.ستجد كلّ شيء هناك عند الزّاوية

73
00:06:25,790 --> 00:06:29,260
إنّه سيف ممتاز. أهو جديد؟

74
00:06:29,720 --> 00:06:32,840
.لقد عُهد بذلك السّيف لي

75
00:06:32,980 --> 00:06:35,020
.لم أقم باستلاله بعد

76
00:06:35,720 --> 00:06:37,330
ولِمَ لا؟

77
00:06:40,140 --> 00:06:42,290
أهو جديد تمامًا بالفعل؟

78
00:06:42,760 --> 00:06:44,520
!كم أحبّ الأشياء الجديدة

79
00:06:44,650 --> 00:06:49,050
أستمتع دائمًا بارتداء الملابس
.الجديدة في مطلع كلّ سنة

80
00:06:49,190 --> 00:06:51,500
.تبدين جميلة مهما ارتديتِ يا ساتسكي

81
00:06:52,170 --> 00:06:54,010
!توقّف، أنت تُحرجني ثانية

82
00:06:54,170 --> 00:06:55,840
!إنّه دوري لأحرجك الآن

83
00:06:56,010 --> 00:06:58,600
!غيتشي-سان، أيّها الشّقيّ الوسيم

84
00:06:59,510 --> 00:07:00,750
.شكرًا لك

85
00:07:02,320 --> 00:07:05,730
كيف تجرؤ على فعل ذلك بي؟

86
00:07:05,960 --> 00:07:07,700
.إنّكما غارقين في الحبّ

87
00:07:08,420 --> 00:07:12,330
!كلاّ، لم تكن تلك نيّتي

88
00:07:36,120 --> 00:07:37,220
!أيّها السّاموراي الشّابّ

89
00:07:37,640 --> 00:07:41,270
.سأذهب لقضاء بعضٍ من شؤوني
أتحتاج لأيّ شيء؟

90
00:07:41,420 --> 00:07:42,940
.لا، لا تشغلي بالك

91
00:07:54,920 --> 00:07:56,660
سلاح جيتّي؟

92
00:07:56,810 --> 00:07:59,720
.نعم. إنّه فخر وفرحة غيتشي-سان

93
00:08:01,260 --> 00:08:02,580
،قبل وقت ليس ببعيد

94
00:08:02,940 --> 00:08:06,080
.خدم كرجل قانون

95
00:08:06,480 --> 00:08:08,400
،أترى أولئك المسؤولين الفاسدين

96
00:08:08,550 --> 00:08:13,510
المستغلّين الّذين يسمّون أنفسهم وطنيّين
...ويستخدمون ذلك لابتزاز النّاس

97
00:08:14,220 --> 00:08:17,460
.كان غيتشي-سان يطارد الأوغاد من أمثالهم

98
00:08:17,770 --> 00:08:21,810
،لكنّه كان مخيفًا للغاية
.وحصل على أعداء كُثر

99
00:08:22,200 --> 00:08:24,520
وضع له أولئك الجبناء كمينًا

100
00:08:24,830 --> 00:08:26,560
.وقطعوا ذراعه اليمنى

101
00:08:29,160 --> 00:08:31,700
.ما عاد قادرًا على حمل الجيتّي خاصّته الآن

102
00:08:32,070 --> 00:08:34,200
.ما عاد قادرًا على القتال بعد الآن

103
00:08:35,380 --> 00:08:37,850
.وقد استقال من منصبه

104
00:08:38,900 --> 00:08:42,180
.عفوًا! إنّني أزعجك بقصصي

105
00:08:42,930 --> 00:08:45,460
.دعنا لا ننغمس كثيرًا في الذّكريات الحزينة

106
00:08:50,520 --> 00:08:53,110
عسى أن يكون طفلي الّذي لم
يولد بعد بصحّة جيّدة

107
00:08:53,860 --> 00:08:56,420
.وعسى أن يتعافى السّاموراي الشّابّ بسرعة

108
00:09:01,970 --> 00:09:04,700
!أجل، وجدت الكثير من البيض

109
00:09:04,830 --> 00:09:06,920
.سيجعل الحياة تدبّ ثانية في السّاموراي الشّابّ

110
00:09:10,900 --> 00:09:13,860
هذا الزّيّ... القوّات الإمبراطوريّة الجديدة؟

111
00:09:14,040 --> 00:09:16,110
!هيّا، تحرّكا بسرعة

112
00:09:21,400 --> 00:09:22,910
...ذلك السّاموراي الشّابّ

113
00:09:23,160 --> 00:09:25,460
.في خطر ولا يجب أن يعثروا عليه

114
00:09:36,650 --> 00:09:39,750
جنديّ إمبراطوريّ يطارد المهزومين؟

115
00:09:40,250 --> 00:09:42,160
أيجرؤ على التّوغّل بيننا هكذا؟

116
00:09:46,020 --> 00:09:49,020
روروني كنشين
—اضطرابات كيوتو—

117
00:09:51,200 --> 00:09:54,820
تعجّ كلّ من إيدو وجبال أوينو
.بالقوّات الإمبراطوريّة

118
00:09:55,100 --> 00:09:57,780
.لا تحاول قتالهم

119
00:09:58,080 --> 00:10:02,740
إنّ أفضل شيء يمكنك فعله الآن هو الهرب
.خلسة بمجرّد استعادة كامل عافيتك

120
00:10:03,020 --> 00:10:06,080
،اسمع أيّها السّاموراي الشّابّ
.إنّ ساتسكي محقّة

121
00:10:06,740 --> 00:10:08,790
سيكون الأوان قد فات، بمجرّد
.وقوع الفأس على الرّأس

122
00:10:10,200 --> 00:10:12,260
قاتلتَ بما فيه الكفاية، صحيح؟

123
00:10:12,850 --> 00:10:17,420
.ارم سلاحك واختفي، لن يلومك أحد على ذلك

124
00:10:20,160 --> 00:10:23,740
الهرب نجاة. ما زالت أمامك
.حياتك بأكملها لتعيشها

125
00:10:26,160 --> 00:10:29,410
.لا رحمة لدى صيّادي الجنود المهزومين

126
00:10:29,560 --> 00:10:33,370
.اختبئ في الحظيرة بينما تتعافى

127
00:10:33,780 --> 00:10:36,540
.ميكي، تاما، روكي، كوسو

128
00:10:36,710 --> 00:10:38,640
!احرصي على إبقاء السّاموراي الشّابّ دافئًا

129
00:10:41,400 --> 00:10:46,320
إنّنا لا نطلب منك الانتقال إلى هنا
.أو نحثّك على المغادرة من باب الحقد

130
00:10:46,510 --> 00:10:49,460
.أعلم أنّكما تفعلان هذا من أجل صالحي

131
00:10:51,110 --> 00:10:55,290
.نحن أيضًا اضطررنا للهرب وتركنا كلّ شيء خلفنا

132
00:10:56,100 --> 00:11:00,800
عندما تعرّض غيتشي-سان لذلك الهجوم
.الفظيع، وجدتُه على شفير الموت

133
00:11:01,010 --> 00:11:03,050
.اعتنيتُ به حتّى استعاد عافيته، واختبأنا

134
00:11:03,170 --> 00:11:06,890
.كان المسؤولون الفاسدون يسعون خلف حياته

135
00:11:07,040 --> 00:11:10,850
بالكاد هربنا منهم، وها نحن
.نعيش هنا مذّاك الحين

136
00:11:11,390 --> 00:11:12,600
.لكنّي لا أمانع ذلك

137
00:11:13,190 --> 00:11:16,100
.نحن سعيدان الآن

138
00:11:17,120 --> 00:11:19,780
.وسنصير أسعد بكثير قريبًا

139
00:11:20,390 --> 00:11:21,960
.واثقة من ذلك

140
00:11:23,070 --> 00:11:26,690
،سنُرزق بالكثير من الأطفال
،وعندما نشيخ

141
00:11:26,820 --> 00:11:30,120
.سنشرب الشّاي معًا بينما نحضن القطط

142
00:11:30,440 --> 00:11:32,200
.تلك سعادة حقيقيّة

143
00:11:33,120 --> 00:11:35,500
،كانوا يصفون غيتشي بغوريلاّ إيدو

144
00:11:35,630 --> 00:11:38,000
لكنّ شهرته ليست ما جعلني

145
00:11:38,180 --> 00:11:41,130
.سعيدة لأكون زوجته

146
00:11:41,670 --> 00:11:45,610
.ما دمتُ معه، فأنا أسعد النّساء

147
00:11:46,410 --> 00:11:48,430
غوريلاّ إيدو غيتشي؟

148
00:11:49,610 --> 00:11:50,790
.بكلّ تأكيد

149
00:11:50,940 --> 00:11:54,650
جعلَنا غوريلاّ إيدو شائن الصّيت
.غيتشي نعاني الكثير

150
00:11:54,870 --> 00:11:55,980
!سنطيح به

151
00:11:56,200 --> 00:11:57,510
!بلا أيّ تردّد

152
00:12:00,440 --> 00:12:01,790
...أولئك الرّجال

153
00:12:05,340 --> 00:12:07,710
.صار لدينا بعض الوقت أخيرًا

154
00:12:08,820 --> 00:12:11,150
يختبئ غيتشي هنا؟

155
00:12:11,300 --> 00:12:13,970
.أنا واثق من ذلك
.كنت أراقب المكان من بعيد

156
00:12:25,760 --> 00:12:26,900
!غيتشي-سان

157
00:12:28,820 --> 00:12:31,560
.كنّا نبحث عنك يا غوريلاّ إيدو غيتشي

158
00:12:31,700 --> 00:12:34,440
لا أصدّق أنّك كنت تختبئ
...في مكان ناءٍ كهذا

159
00:12:35,340 --> 00:12:36,820
...أوغاد

160
00:12:38,020 --> 00:12:40,110
.أنهوا هذا الأمر بسرعة

161
00:12:43,120 --> 00:12:45,120
.مفهوم

162
00:12:46,030 --> 00:12:48,650
.هؤلاء هم الرّجال الّذين قطعوا ذراعه

163
00:12:50,790 --> 00:12:51,860
!خذ

164
00:12:56,610 --> 00:12:58,170
!لا تتدخّلي يا امرأة

165
00:12:59,840 --> 00:13:00,910
.ساتسكي

166
00:13:01,660 --> 00:13:03,690
.ذلك الجيتّي لي

167
00:13:04,390 --> 00:13:06,720
...غيتشي-سان... ولكن

168
00:13:07,210 --> 00:13:08,520
...إنّ هذا الجيتّي

169
00:13:08,960 --> 00:13:12,310
.ليس بغرض اعتقال المجرمين فحسب

170
00:13:13,050 --> 00:13:16,270
.إنّه وقبل كلّ شيء، سلاح للحماية

171
00:13:24,940 --> 00:13:26,340
أتريد القتال؟

172
00:13:26,470 --> 00:13:28,740
.بذراع واحدة؟ لا تجعلني أضحك

173
00:13:38,780 --> 00:13:39,830
غيتشي-سان؟

174
00:13:40,340 --> 00:13:44,020
.أنا من تسعون خلفه
!دعوا ساتسكي وشأنها

175
00:13:44,160 --> 00:13:47,090
.وفي المقابل، سأسلّمكم سلاحي وحياتي

176
00:13:47,280 --> 00:13:48,710
!سأضحّي بنفسي

177
00:13:49,690 --> 00:13:50,930
هل فقدت عقلك؟

178
00:13:51,250 --> 00:13:53,230
!لا يمكنك الموت

179
00:13:53,360 --> 00:13:55,090
.سامحيني يا ساتسكي

180
00:13:55,220 --> 00:13:57,640
.أنا أدين لك بحياتي

181
00:13:57,780 --> 00:14:01,980
فدعيها تُهدر لإنقاذك أنت
.والطّفل الّذي تحملينه

182
00:14:03,820 --> 00:14:07,560
!يا لها من تضحية نبيلة
...وعندما تُطلب بكلّ أدب هكذا

183
00:14:07,930 --> 00:14:11,370
!فلا تُغيّر أيّ شيء. مُت

184
00:14:11,540 --> 00:14:14,160
!سنقتلكم جميعًا

185
00:14:26,050 --> 00:14:27,300
السّاموراي الشّابّ؟

186
00:14:28,830 --> 00:14:30,470
من أين أتيت يا هذا؟

187
00:14:30,660 --> 00:14:32,500
!أنت –
!حاضر –

188
00:14:37,940 --> 00:14:39,350
!الرّمح الطّاعن

189
00:14:39,560 --> 00:14:41,310
،بفضل قبضته

190
00:14:41,440 --> 00:14:45,520
فإنّ هذا الرّمح الاستثنائيّ مثاليّ
!لتسديد الطّعنات

191
00:14:51,080 --> 00:14:52,600
!اذهبا لمكان آمن

192
00:15:10,180 --> 00:15:13,120
!تلك النّدبة على شكل التّقاطع... غير ممكن

193
00:15:13,630 --> 00:15:16,140
!كم أنت مزعج بتفاديك لي باستمرار

194
00:15:31,050 --> 00:15:32,320
!اهرب أيّها السّاموراي الشّابّ

195
00:15:32,460 --> 00:15:35,250
!إنّه ليس بخير، دعوه وشأنه –
!اخرسا –

196
00:15:39,830 --> 00:15:40,750
!مُت

197
00:15:50,990 --> 00:15:55,590
،بعد قتلك للعديد من الرّجال
.فلا تهرب الآن

198
00:15:56,310 --> 00:15:58,870
.عش بالسّيف، ومت بالسّيف

199
00:15:59,010 --> 00:16:02,240
.لا يجدر أن يوجد طريق آخر لك

200
00:16:17,460 --> 00:16:20,000
النّصل معكوس؟

201
00:16:20,940 --> 00:16:22,940
ما هذا السّيف؟

202
00:16:57,130 --> 00:17:01,350
.كان سيفي موجّها في الماضي لأشخاص قتلتُهم

203
00:17:01,490 --> 00:17:03,220
.كان سيفَ هيتوكيري قاتِل

204
00:17:07,070 --> 00:17:08,930
...لكنّ سيفَ القاتِل هذا

205
00:17:09,200 --> 00:17:12,460
.ما عاد موجّهًا للآخرين، بل موجّهًا لي

206
00:17:13,150 --> 00:17:15,210
.هذا ما يُمثّله هذا السّيف

207
00:17:16,840 --> 00:17:17,840
!السّاكاباتو

208
00:17:23,430 --> 00:17:25,310
!موتوا

209
00:17:29,860 --> 00:17:31,770
!أسلوب هيتن ميتسوروغي

210
00:17:34,400 --> 00:17:35,940
!وميض مطرقة التّنّين

211
00:17:44,340 --> 00:17:46,710
!لا مجال للشّكّ! أنت الهيتوكيري باتّوساي

212
00:17:47,770 --> 00:17:49,080
ما الّذي تفعله هنا؟

213
00:17:49,670 --> 00:17:53,740
!تمّ الإعلان أنّك مفقود بعد معركة كيوتو

214
00:17:54,080 --> 00:17:55,300
من أنت؟

215
00:17:55,440 --> 00:17:58,250
!أنا إلى جانبك
.مناصر للإمبراطوريّة من تشوشو

216
00:17:58,380 --> 00:18:00,250
.واسمي سوغا تسوكاسا

217
00:18:00,530 --> 00:18:02,680
.إنّه لشرف لي أن أقابلك

218
00:18:02,940 --> 00:18:06,680
!إنّ سمعتك كهيتوكيري باتّوساي تسبقك

219
00:18:06,890 --> 00:18:09,580
.بعد كيوتو، فزنا في معركة أوينو أيضًا

220
00:18:09,720 --> 00:18:12,840
.اتبعني! سيكون الجميع سعداء برؤيتك

221
00:18:12,990 --> 00:18:15,240
!اليابان لنا الآن

222
00:18:16,650 --> 00:18:19,920
...الهجوم على رجل لا علاقة له بالحرب

223
00:18:20,350 --> 00:18:22,760
أهكذا يتصرّف مناصرو الإمبراطوريّة؟

224
00:18:23,760 --> 00:18:24,830
...لكنّي لم

225
00:18:24,960 --> 00:18:27,420
.لقد غضضتَ النّظر عن أفعالٍ شائنة

226
00:18:28,520 --> 00:18:30,740
...إن رؤية واحد منهم

227
00:18:30,950 --> 00:18:33,840
يتصرّف هكذا سيجلب العار لرفاقنا
.الّذين سقطوا في المعارك

228
00:18:37,120 --> 00:18:38,760
!أنا أعتذر من أعماق قلبي

229
00:18:38,910 --> 00:18:41,240
!أقسم أنّ ذلك لن يحدث ثانية

230
00:18:41,390 --> 00:18:43,890
!أعدك، أعدك أنّه لن يتكرّر

231
00:18:53,960 --> 00:18:57,280
!شكرًا ثانية على حمايتنا

232
00:18:57,540 --> 00:19:00,150
.بل أنا من عليه أن يشكركما

233
00:19:02,410 --> 00:19:04,600
.عثرتَ لنفسك على منزل جيّد

234
00:19:06,190 --> 00:19:08,830
.يمكن لهذا السّقف أن يأويك أيضًا

235
00:19:09,000 --> 00:19:11,630
.لا يوجد لديك ما تخشاه من الجيش الإمبراطوريّ

236
00:19:11,760 --> 00:19:15,090
.بكلّ تأكيد. بإمكانك البقاء هنا

237
00:19:15,360 --> 00:19:17,520
.من اللّطف منكما أن تعرضا عليّ هذا

238
00:19:17,670 --> 00:19:19,430
.لكنّي متشوّق للتّرحال

239
00:19:19,590 --> 00:19:22,570
.أريد رؤية هذا العالم الجديد القادم

240
00:19:23,990 --> 00:19:26,970
.اعتنيا جيّدًا ببعضكما

241
00:19:27,900 --> 00:19:31,440
.سأدعو أن يولد طفلكما بصحّة جيّدة

242
00:19:31,740 --> 00:19:36,570
!لا داعي للقلق! سأنجب طفلاً قويًّا

243
00:19:38,740 --> 00:19:42,840
.أنا روروني رحّالة. سأترك الحياة ترشدني

244
00:19:46,780 --> 00:19:48,280
.ساكاباتو

245
00:19:48,780 --> 00:19:51,960
...كلّ الأرواح الّتي سلبتُها

246
00:19:52,080 --> 00:19:54,100
هل سيكون هذا السّيف هو الجواب؟

247
00:19:54,380 --> 00:19:58,170
"ماذا ستقطع؟" "من ستقطع؟"

248
00:20:02,580 --> 00:20:07,390
إنّه محاولة فاشلة، لكنّه سيكون أكثر
.من كافٍ بالنّسبة لمن أنت عليه الآن

249
00:20:08,130 --> 00:20:11,530
وكبداية، حاول أن تكون سيّافًا
.وأنت تحمل ذلك على خصرك

250
00:20:12,580 --> 00:20:16,610
.واثق أنّك سترى بنفسك مدى سذاجتك الآن

251
00:20:21,950 --> 00:20:23,350
.شاكّو-دونو

252
00:20:24,130 --> 00:20:28,690
لا أزال أنا أيضًا أريد الإيمان
.بذلك الحلم العاطفيّ نوعًا ما

253
00:20:29,400 --> 00:20:30,380
...لذلك

254
00:20:31,490 --> 00:20:33,420
...سأقبل بهذا السّاكاباتو

255
00:20:34,200 --> 00:20:36,300
.بكلّ امتنان وعرفان

256
00:20:40,610 --> 00:20:41,510
!ممتاز

257
00:20:42,520 --> 00:20:44,800
.حسنًا، سنغادر الآن

258
00:20:44,940 --> 00:20:47,050
.أكيد، اعتنوا بأنفسكم

259
00:20:49,000 --> 00:20:50,260
"!رجاءً"

260
00:20:50,500 --> 00:20:54,000
"!ثافح! ثافح! مع الثّلامة"

261
00:21:01,460 --> 00:21:03,650
"!ثافح! ثافح"

262
00:21:12,040 --> 00:21:16,040
الحلقة الرّابعة والثّلاثين
هجوم السّاكاباتو الأوّل

263
00:22:46,000 --> 00:22:51,010
الحلقة القادمة
هيكو سيجورو

264
00:22:47,400 --> 00:22:50,540
."في الحلقة القادمة: "هيكو سيجورو