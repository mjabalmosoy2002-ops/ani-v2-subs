1
00:00:02,050 --> 00:00:03,180
...سنكاكو

2
00:00:04,050 --> 00:00:07,610
.لم أتوقّع أنّ تنتصر منذ البداية

3
00:00:07,970 --> 00:00:12,370
لكنّ الخسارة في مواجهته دون دفعه
...للكشف عن حركة واحدة على الأقلّ

4
00:00:12,770 --> 00:00:16,500
.ستجعلني أضع حدًّا لحياتك بنفسي

5
00:00:23,860 --> 00:00:27,000
...أسلوب سنكاكو السّرّيّ

6
00:00:29,450 --> 00:00:32,460
!المنجنيق البشريّ الخارق

7
00:00:33,080 --> 00:00:36,180
.مفهوم؟ بصمت كي لا يلاحظوك

8
00:00:36,380 --> 00:00:37,970
...أسلوب هيتن ميتسوروغي

9
00:00:40,550 --> 00:00:41,860
!وميض التّنّين المحلّق

10
00:00:50,390 --> 00:00:54,040
.احمل سيفك يا شيشيو ماكوتو

11
00:01:02,940 --> 00:01:08,670
روروني كنشين
—اضطرابات كيوتو—

12
00:02:31,700 --> 00:02:32,960
.مغفّل

13
00:02:33,450 --> 00:02:36,550
تُظهر الرّحمة حتّى لأغبياء من أمثاله؟

14
00:02:36,960 --> 00:02:39,060
.إنّ لينك هذا سيكلّفك حياتك

15
00:02:39,460 --> 00:02:41,010
.لا أهتمّ إطلاقًا

16
00:02:41,460 --> 00:02:44,480
لستُ بحاجة لبذل جهد كبير
."في مواجهة "زميل أصغر

17
00:02:46,460 --> 00:02:48,640
...لا أفهم ما يحدث تمامًا

18
00:02:48,640 --> 00:02:50,610
.لكنّ شيئًا مذهلاً يحدث

19
00:02:51,590 --> 00:02:55,200
.هذا ليس أمرًا علينا حشر أنوفنا فيه

20
00:02:55,690 --> 00:02:58,490
.لا حاجة للتّسلّل خلسة
.يمكنكما الوقوف بكرامة والمشاهدة

21
00:02:59,440 --> 00:03:02,080
.لكن لا تبتعدا عنّي فحسب

22
00:03:02,480 --> 00:03:03,620
...ميساو-دونو

23
00:03:04,450 --> 00:03:07,500
ذلك الهجوم قبل قليل
."الّذي سمّته "وميض التّنّين المحلّق

24
00:03:09,610 --> 00:03:13,210
استعملتَ الجانب غير الحادّ لسيفك
...لضرب ذقن سنكاكو

25
00:03:13,910 --> 00:03:17,970
لكنّها في الأصل تقنية يُستعمل فيها
الجانب الحادّ وتقطع للأعلى، صحيح؟

26
00:03:19,080 --> 00:03:20,300
.نعم

27
00:03:20,300 --> 00:03:21,770
.يا لها من خيبة أمل

28
00:03:22,170 --> 00:03:28,270
سمعتُ أنّ زميلي الأقدم لم يعُد هيتوكيري
.وصار روروني لا يقتل من تقارير أعواني

29
00:03:29,130 --> 00:03:33,990
لكن كان من الصّعب تصديق
.ذلك حتّى رأيت الأمر بأمّ عينيّ

30
00:03:35,180 --> 00:03:39,440
من رابع المستحيلات
.أن تستطيع هزيمتي هكذا

31
00:03:43,350 --> 00:03:44,950
.يا إلهي

32
00:03:45,360 --> 00:03:47,420
.أنا لا أقبل القتالات المملّة

33
00:04:02,960 --> 00:04:04,930
.سأنتظرك في كيوتو

34
00:04:05,540 --> 00:04:08,350
.التحق بي هناك بمجرّد أن تصير هيتوكيري ثانية

35
00:04:08,800 --> 00:04:11,350
.أراك تهرب وأنت تجرّ أذيال الخيبة

36
00:04:19,640 --> 00:04:22,360
.سوجيرو، العب معه بدلاً منّي

37
00:04:22,980 --> 00:04:24,280
أيمكنني ذلك؟

38
00:04:24,520 --> 00:04:29,740
نعم. وكتعبير عن شكري لرؤية وميض
.التّنّين المحلّق، أرهم تقنية تنكن خاصتّك

39
00:04:35,990 --> 00:04:39,500
،إن كانت هذه رغبتك يا شيشيو-سان
.فلن أتردّد أبدًا

40
00:04:39,660 --> 00:04:42,460
.أراك لاحقًا يا زميلي الأقدم

41
00:04:48,920 --> 00:04:50,100
!يا هيمورا

42
00:04:50,100 --> 00:04:51,720
لماذا أنت شارد هكذا؟

43
00:04:51,880 --> 00:04:55,310
،إن لم تسرع الآن
!فسيهرب ذو الضّمادات ذاك

44
00:05:00,600 --> 00:05:02,870
ما-ما كان ذلك للتّوّ؟

45
00:05:06,200 --> 00:05:11,170
لا فائدة. حتّى إن ضربته بهالة سيفك
.هكذا، فستكون مضيعة للوقت

46
00:05:11,570 --> 00:05:13,660
.كنتُ أقوم بذلك طوال الوقت

47
00:05:14,490 --> 00:05:19,510
،لا يمتلك ذلك الشّخص أيّ هالة سيف
.ولا نيّة للقتل، ولا روحًا قتاليّة

48
00:05:24,000 --> 00:05:25,090
.شيشيو-ساما

49
00:05:25,090 --> 00:05:25,920
ماذا؟

50
00:05:26,120 --> 00:05:28,220
ما هي "تنكن" تلك الّتي ذكرتها قبل قليل؟

51
00:05:28,500 --> 00:05:30,230
.إنّه لقبه

52
00:05:30,670 --> 00:05:32,680
.سيف يُحمل بموهبة فطريّة سماويّة

53
00:05:32,680 --> 00:05:34,020
.أو "تنكن" باختصار

54
00:05:34,130 --> 00:05:37,570
لكن ألا يمكن قول نفس الشّيء عن الباتّوساي؟

55
00:05:37,970 --> 00:05:38,900
.أظنّ ذلك

56
00:05:39,800 --> 00:05:43,660
ولكن بسبب مشاكل سوجيرو
...العائليّة كطفل

57
00:05:44,060 --> 00:05:48,240
.فإنّه يفتقر لكلّ المشاعر فيما عدى المتعة

58
00:05:49,270 --> 00:05:52,370
.ولأنّه يفتقر للفرح، فلا روح قتاليّة له

59
00:05:52,370 --> 00:05:55,040
.ولأنّه يفتقر للغضب، فلا نيّة قتلٍ له

60
00:05:55,040 --> 00:05:57,160
،مهما علا مستوى السّيّاف

61
00:05:57,160 --> 00:06:00,500
زادت احتماليّة استجابته
.لهالة الخصم الهجوميّة

62
00:06:00,500 --> 00:06:02,840
.لكنّ ذلك النّهج لن ينفع ضدّ سوجيرو

63
00:06:03,240 --> 00:06:07,720
في الحقيقة، كان سايتو يبحث
عن فرصة لمهاجمتي طوال الوقت

64
00:06:07,720 --> 00:06:11,600
لكنّه لم يستطع توقّع ما قد تكون خطوة
.سوجيرو الّذي كان إلى جانبه ولم يهاجم

65
00:06:12,050 --> 00:06:15,140
إنّ الأمر أسوأ بكثير بالنّسبة لأسلوب
،هيتن ميتسوروغي الخاصّ بالباتّوساي

66
00:06:15,140 --> 00:06:18,270
.لأنّه يتوقّع في الحال عقليّة الخصم

67
00:06:19,640 --> 00:06:21,060
.أنا آسف

68
00:06:21,550 --> 00:06:25,650
.إن لم أسرع، فلن أستطيع اللّحاق بشيشيو-سان

69
00:06:45,250 --> 00:06:46,840
.هيمورا

70
00:06:46,840 --> 00:06:48,420
.إذًا فهكذا سينتهي الأمر

71
00:06:49,000 --> 00:06:53,140
إن كان لا يستطيع استعمال هالة
،السّيف للحصول على الأفضليّة

72
00:06:53,140 --> 00:06:56,900
فإنّ أفضل نهج لاتّباعه هو المبادرة
.بالهجوم بأسرع تقنية سيف لديه

73
00:06:57,300 --> 00:06:59,570
تقنية سحب السّيف، الباتّوجتسو؟

74
00:07:00,510 --> 00:07:02,310
.سأقوم بذلك أيضًا

75
00:07:18,530 --> 00:07:22,500
.على الأرجح أنّ النّزال سيكون صدامًا للباتّوجتسو

76
00:07:34,630 --> 00:07:36,180
...سرعة السّيف

77
00:07:42,970 --> 00:07:44,070
.متساوية

78
00:07:47,400 --> 00:07:48,450
...ولكن

79
00:08:09,910 --> 00:08:16,230
بالنّسبة لسوجيرو الّذي يفتقر
...للحزن ولا يؤثّر فيه قتل الآخرين

80
00:08:16,750 --> 00:08:21,430
والباتّوساي الّذي قرّر ألاّ يقتل
...أيّ إنسان آخر ثانية

81
00:08:21,970 --> 00:08:23,850
،حتّى إن امتلك كلاهما التّنكن

82
00:08:23,850 --> 00:08:26,400
.فهنالك فرق واضح في كيفية تنفيذ الهجوم

83
00:08:26,930 --> 00:08:29,940
،ما لم يتخلّص من فكرة رفض القتل

84
00:08:29,940 --> 00:08:32,120
.فلا يستطيع الباتّوساي الفوز ضدّ سوجيرو

85
00:08:34,480 --> 00:08:36,250
.أظنّ أنّ النّزال قد انتهى

86
00:08:36,650 --> 00:08:37,580
.نعم

87
00:08:38,480 --> 00:08:41,790
.كلاكما غير قادر على القتال
.إنّه تعادل حسب ما أرى

88
00:08:45,200 --> 00:08:47,670
!أجل! هذا هو المتوقّع من هيمورا

89
00:08:47,950 --> 00:08:51,000
.كم هذا رائع

90
00:08:51,000 --> 00:08:53,260
.لا أظنّني أستطيع إصلاحه الآن

91
00:08:53,830 --> 00:08:56,880
.لا يهمّ. كان سيفَ شيشيو-سان على كلّ حال

92
00:08:58,750 --> 00:09:02,020
.لم يكن هنالك فائز أو خاسر في هذا النّزال بالفعل

93
00:09:02,510 --> 00:09:04,560
.سأستأذن بالذّهاب الآن

94
00:09:04,800 --> 00:09:07,400
.قاتلني ثانية إن أردت لو سمحت

95
00:09:08,390 --> 00:09:13,240
.من الأفضل أن تُحضر سيفًا جديدًا

96
00:09:17,020 --> 00:09:18,210
.هيمورا

97
00:09:37,630 --> 00:09:40,100
.مِن هنا؟ أتساءل إن كنت سألحق به

98
00:09:40,500 --> 00:09:41,650
...عفوًا

99
00:09:42,460 --> 00:09:44,140
.مرحبًا

100
00:09:44,140 --> 00:09:46,770
ما الّذي حدث لسنكاكو-ساما؟

101
00:09:46,970 --> 00:09:50,230
.صحيح... لقد هُزم في الدّاخل

102
00:09:50,430 --> 00:09:53,230
في تلك الحالة، ما الّذي علينا فعله الآن؟

103
00:09:53,810 --> 00:09:56,360
.ماذا؟ صحيح

104
00:09:56,690 --> 00:10:00,660
أتساءل ما كان شيشيو-سان ليفعله؟

105
00:10:04,540 --> 00:10:08,630
.أنا آسف. سأسأل شيشيو-سان عنكم جميعًا

106
00:10:09,030 --> 00:10:11,550
.لذلك كونوا في حالة تأهّب حتّى ذلك الوقت

107
00:10:11,950 --> 00:10:14,000
تأهّب؟

108
00:10:14,160 --> 00:10:15,340
.نعم

109
00:10:15,340 --> 00:10:19,470
،أنا في عجلة من أمري
.لذلك تولّوا الأمور حسب ذلك

110
00:10:19,630 --> 00:10:20,510
!مع السّلامة

111
00:10:30,300 --> 00:10:31,440
...هيمورا-سان

112
00:10:35,480 --> 00:10:36,980
!كان سريعًا

113
00:10:38,990 --> 00:10:41,990
روروني كنشين
—اضطرابات كيوتو—

114
00:10:46,610 --> 00:10:48,090
...ذلك السّاكاباتو

115
00:10:48,910 --> 00:10:50,410
.انكسر

116
00:10:50,620 --> 00:10:52,840
.وتركنا جماعة شيشيو تهرب

117
00:10:53,240 --> 00:10:54,630
!أنت

118
00:10:54,630 --> 00:10:55,550
...حسنًا

119
00:10:56,250 --> 00:11:00,730
،بإمكاني أن أطلب دقّ سيف آخر
.وبإمكاننا مطاردة جماعة شيشيو لاحقًا

120
00:11:01,130 --> 00:11:04,550
.أمّا الآن، فعلينا التّخلّص من رجال شيشيو

121
00:11:04,800 --> 00:11:06,940
.ذلك وحده كافٍ بالنّسبة لي

122
00:11:18,730 --> 00:11:20,610
.لا يزال يتنفّس

123
00:11:20,610 --> 00:11:21,990
—الـ

124
00:11:22,150 --> 00:11:24,870
.النّجدة

125
00:11:26,740 --> 00:11:28,290
!النّجدة –
!النّجدة –

126
00:11:28,290 --> 00:11:29,460
!أنجدونا

127
00:11:32,450 --> 00:11:33,330
!إيجي

128
00:11:34,740 --> 00:11:36,750
—مهلاً، لقد سُوّيت المسألة

129
00:11:36,950 --> 00:11:39,130
!مت يا سنكاكو

130
00:11:41,210 --> 00:11:42,770
.لا تقتله بدون أن تسألني

131
00:11:43,460 --> 00:11:46,220
.ثمّة العديد من الأمور الّتي عليّ معرفتها منه

132
00:11:50,260 --> 00:11:51,230
!إيجي

133
00:11:52,550 --> 00:11:54,310
!عليّ أخذ ثأري من ذلك الرّجل

134
00:11:54,310 --> 00:11:55,860
!لا تعترض طريقي

135
00:11:55,860 --> 00:11:56,740
.مغفّل

136
00:11:57,100 --> 00:12:00,440
تمّ حظر القتل بدافع الثّأر
.في السّنة السّادسة من حقبة ميجي

137
00:12:00,850 --> 00:12:04,660
،حتّى إن لم تقتله
،فسيتمّ إعدامه شنقًا بكلّ تأكيد

138
00:12:04,660 --> 00:12:08,280
مع الميزة الإضافيّة المتمثّلة
.في التّعذيب أثناء الاستجواب

139
00:12:08,570 --> 00:12:13,250
سيكون ذلك مؤلمًا أكثر بكثير من
.تلقّيه لضربة قاتلة وهو فاقد للوعي

140
00:12:13,530 --> 00:12:14,710
.شيطان

141
00:12:14,910 --> 00:12:15,840
!اخرس

142
00:12:16,200 --> 00:12:18,540
!لا أهتمّ بالقوانين أو المشنقة

143
00:12:18,830 --> 00:12:21,210
،إن لم آخذ بثأري منه بيديّ هاتين

144
00:12:21,210 --> 00:12:22,760
!فإنّ أخي والبقيّة لن يرقدوا بسلام

145
00:12:22,760 --> 00:12:23,850
.إيجي

146
00:12:24,790 --> 00:12:30,980
،لا يرغب الموتى في الثّأر
.بل في سعادة الأحياء

147
00:12:32,130 --> 00:12:36,940
حتّى إن لطّختَ يديك الصّغيرتين هاتين
.بالدّماء، فلن يُفرح ذلك أيّ أحد

148
00:12:37,260 --> 00:12:41,230
،مع مرور الوقت
،ستكبر هاتان اليدان الصّغيرتان

149
00:12:41,230 --> 00:12:43,160
.وستصير رجلاً راشدًا

150
00:12:44,020 --> 00:12:48,820
ووقتها، لا تكن رجلاً يقمع الآخرين
.بالقوّة مثل جماعة شيشيو

151
00:12:49,740 --> 00:12:54,160
لا تكن رجلاً يشلّه الخوف
.من العنف مثل أولئك القرويّين

152
00:12:55,240 --> 00:13:01,220
،كن رجلاً مثل أخيك
.الّذي قلق عليك حتّى الرّمق الأخير

153
00:13:03,500 --> 00:13:05,270
.كن سعيدًا لو سمحت

154
00:13:17,680 --> 00:13:21,110
.أعتقد أنّ كلّ شيء قد سُوّيَ الآن

155
00:13:22,230 --> 00:13:23,110
.تفضّل

156
00:13:23,270 --> 00:13:25,870
.سأعطيك منديلاً لمسح تلك الدّموع

157
00:13:29,440 --> 00:13:30,530
—أيّها الـ

158
00:13:30,530 --> 00:13:31,370
.على مهل

159
00:13:31,370 --> 00:13:34,200
ما الّذي تظنّ أنّك تفعله بالضّبط يا هذا؟

160
00:13:34,200 --> 00:13:37,340
سُوّيَ كلّ شيء"؟"

161
00:13:45,250 --> 00:13:46,550
.لقد تأخّر

162
00:13:47,170 --> 00:13:49,510
.أتساءل إن كان قد ضاع

163
00:13:52,010 --> 00:13:53,010
.لا

164
00:13:54,670 --> 00:13:56,480
!شيشيو-سان

165
00:13:56,930 --> 00:13:58,490
!من هنا

166
00:14:07,440 --> 00:14:09,610
تفهم أنّها لم تكن غلطتي، صحيح؟

167
00:14:09,610 --> 00:14:12,530
،إن كنتَ ستغضب
.فرجاءً اغضب من هيمورا-سان

168
00:14:12,940 --> 00:14:17,550
ألحق كلّ هذا الضّرر بالنّاغاسوني
كوتتسو بالسّاكاباتو خاصّته؟

169
00:14:17,950 --> 00:14:19,960
.أعتقد أنّي استهنتُ به

170
00:14:19,960 --> 00:14:20,960
كوتتسو؟

171
00:14:20,960 --> 00:14:24,840
،يا فتى، أنت موهوب
.لكنّك تجهل الكثير من الأمور

172
00:14:25,120 --> 00:14:29,590
.إنّه كوتتسو شهير
.سيف من بين 31 سيفًا عظيمًا

173
00:14:29,590 --> 00:14:33,430
.إنّه فريد من نوعه
.كان أيّ سيّاف خبير ليرغب فيه بشدّة

174
00:14:33,840 --> 00:14:36,470
أهو باهظ الثّمن لهذا الحدّ؟

175
00:14:36,470 --> 00:14:37,850
.لا يُقدّر بثمن

176
00:14:37,850 --> 00:14:41,900
تعادل قيمته المبلغ الّذي قد تُحرّر
.به أفضل أويران في حيّ المتعة

177
00:14:42,060 --> 00:14:44,860
.استطاع إلحاق كلّ ذلك الضّرر بسيف مثله

178
00:14:44,860 --> 00:14:46,830
.لا يجب أن تسامح هيمورا-سان على ذلك

179
00:14:46,940 --> 00:14:50,200
سوجيرو، هل يمكنني أن أطلب منك خدمة؟

180
00:14:50,610 --> 00:14:53,070
.اطلب أيّ شيء عدا مبلغ تعويض له

181
00:14:53,070 --> 00:14:56,840
.اجمع كلّ سيوف كيوتو العشرة في الحال

182
00:14:57,240 --> 00:14:58,790
السّيوف العشرة؟

183
00:15:13,250 --> 00:15:14,510
.مفهوم

184
00:15:14,920 --> 00:15:16,510
...شيشيو-ساما

185
00:15:16,510 --> 00:15:17,470
.نعم

186
00:15:19,430 --> 00:15:24,650
أريد إخراج الهيتوكيري باتّوساي
المحبوس داخل هيمورا كنشين

187
00:15:24,650 --> 00:15:27,740
.حتّى إن اضطررت لاستعمال القوّة لذلك

188
00:15:28,390 --> 00:15:31,070
شيشيو-سان، هل تستمتع بوقتك؟

189
00:15:31,730 --> 00:15:32,910
.نوعًا ما

190
00:15:33,360 --> 00:15:35,580
.قلتَ أنّه خيّب أملك

191
00:15:35,580 --> 00:15:36,990
.اخرس

192
00:15:36,990 --> 00:15:38,540
.أسرع وقم بما طلبته منك

193
00:15:38,540 --> 00:15:39,420
!حاضر

194
00:15:43,950 --> 00:15:44,830
ماذا؟

195
00:15:45,830 --> 00:15:47,850
.أعتقد أنّي نسيت شيئًا ما

196
00:15:54,380 --> 00:15:57,860
بهذا، يجدر أن تعود قرية شينغتسو
.إلى ما كانت عليه من قبل إن جاز التّعبير

197
00:15:59,170 --> 00:16:01,860
.إنّهم يهتفون فرحًا بطريقة غير مسؤولة

198
00:16:02,260 --> 00:16:04,600
.ثمّة شيء لا يبدو في محلّه هنا

199
00:16:04,850 --> 00:16:07,230
.ستصير الأمور أصعب بعد هذا

200
00:16:07,230 --> 00:16:12,570
إنّ كلّ القبح في قلوب القرويّين
.ظهر للعلن خلال هذه الحادثة

201
00:16:12,570 --> 00:16:15,450
ستكون العلاقات بينهم غير
.مستقرّة لفترة من الوقت

202
00:16:15,450 --> 00:16:19,210
كما أنّي لا أحبّ شخصيّة
.هذا الرّجل كثيرًا أيضًا

203
00:16:20,570 --> 00:16:25,840
.ومع ذلك، تظلّ هذه قريتي
.سأدعو لتصير أحسن

204
00:16:27,540 --> 00:16:31,380
.سأعود الآن

205
00:16:31,380 --> 00:16:32,510
.نعم

206
00:16:32,670 --> 00:16:35,430
ولكن ماذا سنفعل بإيجي لو سمحت؟

207
00:16:35,710 --> 00:16:38,270
.لا يستطيع أيّ أحد منّا أنا أو أنت أخذه

208
00:16:38,670 --> 00:16:41,470
،سأطلب من توكيو الاعتناء به لفترة

209
00:16:41,470 --> 00:16:44,190
.وبمجرّد أن تهدأ الأمور، فسنفكّر في مستقبله

210
00:16:44,190 --> 00:16:45,060
توكيو؟

211
00:16:45,510 --> 00:16:46,520
.زوجتي

212
00:16:48,720 --> 00:16:50,900
ز-ز-زوجتك؟

213
00:16:50,900 --> 00:16:53,440
أنت متزوّج؟

214
00:16:53,440 --> 00:16:54,450
.نعم

215
00:16:54,450 --> 00:16:56,410
"هذه حقيقة تاريخيّة"

216
00:16:56,940 --> 00:16:58,240
.لا داعي للقلق

217
00:16:58,240 --> 00:16:59,750
.توكيو امرأة مذهلة

218
00:17:00,150 --> 00:17:02,370
.ستعتني بإيجي خير عناية

219
00:17:02,650 --> 00:17:06,620
بالطّبع، إن كانت قادرة على تحمّل
.أن تكون زوجة لرجل مثله

220
00:17:06,620 --> 00:17:10,840
نعم. سيكون ذلك مستحيلاً
.ما لم تكن امرأة مثل بوداسف

221
00:17:07,200 --> 00:17:10,840
"تصوّر تخيّليّ لتوكيو"

222
00:17:11,370 --> 00:17:12,920
.لا داعي للقلق علينا

223
00:17:13,410 --> 00:17:15,930
...أسرع بالذّهاب إلى كيوتو

224
00:17:17,540 --> 00:17:19,800
.وصر هيتوكيري مرّة أخرى

225
00:17:21,670 --> 00:17:23,560
أدركتَ ذلك من هذه المعركة، صحيح؟

226
00:17:23,970 --> 00:17:26,900
إنّ طبيعتك كروروني لن تكون لها
،أيّ فرصة ضدّ أتباع شيشيو

227
00:17:26,900 --> 00:17:29,190
.ناهيك عن شيشيو بحدّ ذاته

228
00:17:29,600 --> 00:17:31,660
.من الجيّد أنّ ذلك السّاكاباتو قد كُسر

229
00:17:32,680 --> 00:17:35,160
.كفاك تردّدًا واتّخذ قرارك

230
00:17:36,520 --> 00:17:39,540
.أنا أعمد عليك، على طبيعتك السّابقة

231
00:17:57,250 --> 00:17:58,430
.هيمورا

232
00:18:01,550 --> 00:18:03,020
.سايتو-سينسي

233
00:18:03,670 --> 00:18:05,270
."لا تنادني بـ"سينسي

234
00:18:05,970 --> 00:18:09,530
.ثمّة مكان عليّ المرور به قبل مغادرة القرية

235
00:18:16,690 --> 00:18:19,740
.حسنًا، أنا لا أفهم تمامًا ما حدث

236
00:18:19,940 --> 00:18:22,450
.لكنّهم هربوا، ونحن فزنا

237
00:18:22,450 --> 00:18:25,870
،بإمكاننا تجاهل ما كان يتحدّث عنه
.لأنّ سايتو لم يفعل أيّ شيء

238
00:18:25,870 --> 00:18:28,920
لنكن متفائلين قليلاً ونبذل كلّ
!ما لدينا! كلّ ما لدينا

239
00:18:28,920 --> 00:18:32,540
هيمورا، تكون هادئًا ووسيمًا عندما
.تصير عيناك مائلتين للأعلى هكذا

240
00:18:28,920 --> 00:18:43,050
:تقنيّة سرّيّة
!نسخ المائة وجه

241
00:18:32,540 --> 00:18:34,880
.لكنّك مخيف ومن الصّعب التّقرّب منك

242
00:18:34,880 --> 00:18:36,340
.إضافة إلى أنّك كئيب

243
00:18:36,340 --> 00:18:40,010
أفضّر أكثر هيمورا الأخرق
!"الّذي يقول "أورو

244
00:18:40,010 --> 00:18:43,050
!نعم، أفضّل ذلك أكثر بكثير، نعم

245
00:18:43,050 --> 00:18:47,270
لا أهتمّ أبدًا إن كنتُ أروق لك
.أم لا يا ميساو-دونو

246
00:18:47,270 --> 00:18:48,480
ماذا؟ فعلاً؟

247
00:18:48,480 --> 00:18:49,440
كما توقّعت؟

248
00:18:49,440 --> 00:18:52,410
!مهلاً، كان ذلك فظًّا للغاية

249
00:18:59,020 --> 00:19:01,740
.أخذ ذلك الكثير من الوقت

250
00:19:01,740 --> 00:19:03,280
.لنسرع

251
00:19:03,280 --> 00:19:06,410
على الأرجح أنّ جماعة شيشيو
،لن تهاجمنا ثانية حتّى نصل إلى كيوتو

252
00:19:06,410 --> 00:19:08,250
.لذلك سنسلك طريق توكايدو لو سمحت

253
00:19:08,570 --> 00:19:11,260
.كما أنّي جائع أيضًا

254
00:19:12,030 --> 00:19:14,960
.كان يعبث معي

255
00:19:15,700 --> 00:19:17,550
!ركلة غضب الوحش الطّائر

256
00:19:17,550 --> 00:19:18,880
...أورو

257
00:19:19,460 --> 00:19:20,730
.هذا مؤلم

258
00:19:21,250 --> 00:19:22,260
!خذ

259
00:19:22,260 --> 00:19:23,140
أورو؟

260
00:19:25,000 --> 00:19:27,810
إنّه بسكويت قاسٍ! قلت أنّك جائع، صحيح؟

261
00:19:29,550 --> 00:19:31,570
.سآخذ واحدًا إذًا

262
00:19:33,020 --> 00:19:34,770
—ليس ممزوجًا بأيّ سمّ أو

263
00:19:34,770 --> 00:19:37,020
!أنت مزعج! اخرس وكله فحسب

264
00:19:40,650 --> 00:19:41,580
.نعم

265
00:19:42,060 --> 00:19:43,360
.إنّه لذيذ بالفعل

266
00:19:43,360 --> 00:19:44,780
أليس كذلك؟

267
00:19:44,780 --> 00:19:47,620
!حتّى أوشي-ساما وهانيا-كُن أثنيا عليّ

268
00:19:47,620 --> 00:19:50,460
أسنعود إلى ذلك ثانية؟

269
00:19:50,460 --> 00:19:54,760
بالطّبع! سأستخرج كلّ التّفاصيل
!منك قبل وصولنا إلى كيوتو

270
00:19:57,410 --> 00:20:00,680
.في الوقت الحاليّ، لنسرع في طريقنا إلى كيوتو

271
00:20:01,830 --> 00:20:05,850
هل سأصير هيتوكيري ثانية...؟

272
00:20:06,420 --> 00:20:08,610
.سأعرف الإجابة في كيوتو

273
00:20:11,630 --> 00:20:12,650
.هيّا بنا

274
00:20:23,990 --> 00:20:27,990
:الحلقة التّاسعة والعشرون"
"إلى كيوتو مرّة أخرى

275
00:21:58,000 --> 00:22:00,790
مطعم أكابيكو للحم بقر"
"في القدر السّاخن والسّاكي

276
00:22:00,030 --> 00:22:02,180
!شكرًا جزيلاً

277
00:22:06,290 --> 00:22:09,180
ما-ما الخطب يا تاي-سان؟

278
00:22:10,210 --> 00:22:14,770
.لقد دفع كلّ الزّبائن فواتيرهم

279
00:22:14,770 --> 00:22:15,720
.هكذا إذًا

280
00:22:15,880 --> 00:22:19,150
.ولسبب ما، أشعر وكأنّنا نفتقر لشيء ما

281
00:22:19,150 --> 00:22:20,310
ماذا؟

282
00:22:20,310 --> 00:22:22,940
تتحدّين عن سانوسكي-سان، صحيح؟

283
00:22:23,520 --> 00:22:27,750
هل هو بخير في رحلته إلى كيوتو؟

284
00:22:35,200 --> 00:22:36,840
.هذا سيّئ

285
00:22:37,450 --> 00:22:41,050
.أظنّني ضعت بالفعل

286
00:22:42,580 --> 00:22:44,510
في أيّ اتّجاه تقع كيوتو؟

287
00:22:46,000 --> 00:22:50,970
"الحلقة القادمة: لقاء في الغابة"

288
00:22:47,670 --> 00:22:50,310
."الحلقة القادمة: "لقاء في الغابة