1
00:00:08,190 --> 00:00:12,400
!تحرّكوا بسرعة كي لا نعترض طريق فوجي

2
00:00:12,400 --> 00:00:13,860
!أخرجوا سيوفكم! استعداد

3
00:00:13,860 --> 00:00:17,120
!جاهز –
!جاهز –

4
00:00:20,950 --> 00:00:22,040
سيف؟

5
00:00:22,040 --> 00:00:23,330
.هذا لا يُعقل

6
00:00:23,330 --> 00:00:25,710
من قد يستطيع استعمال شيء كهذا؟

7
00:00:33,880 --> 00:00:34,800
ماذا؟

8
00:00:35,300 --> 00:00:37,180
لم يكن للشّوريكن أيّ تأثير؟

9
00:00:37,180 --> 00:00:38,850
!يا له من جسد لا يُصدّق

10
00:00:50,440 --> 00:00:52,320
ماذا؟ ما هذا؟

11
00:00:53,110 --> 00:00:54,780
إ-إيوانبو-ساما؟

12
00:00:54,780 --> 00:00:56,450
ما الّذي تفعله؟

13
00:00:56,450 --> 00:00:57,990
هل من خطب ما؟

14
00:01:03,830 --> 00:01:05,500
ما هؤلاء الأشخاص؟

15
00:01:05,500 --> 00:01:08,420
.لا أدري، لكن لم يتبقّ لدينا وقت

16
00:01:09,460 --> 00:01:12,050
.علينا العودة وتبليغ ميساو-تشان

17
00:01:12,050 --> 00:01:13,960
!أعني تبليغ القائدة

18
00:03:23,010 --> 00:03:27,140
تاكاني-سينسي، لأيّ غرض تلك البطاقات؟

19
00:03:27,720 --> 00:03:29,270
.لتصنيف المرضى

20
00:03:30,480 --> 00:03:32,890
سنصنّف المرضى من الّذين
يتمّ إحضارهم إلى هنا

21
00:03:32,890 --> 00:03:34,730
.حسب مدى حاجتهم للعناية الطّبّيّة

22
00:03:35,560 --> 00:03:39,730
سيُمنح المرضى الّذين يحتاجون للعلاج
.الفوريّ بطاقات خشبيّة حمراء

23
00:03:40,240 --> 00:03:43,280
وسيُمنح المرضى الّذي يمكن علاجهم
.لاحقًا بطاقات خشبيّة صفراء

24
00:03:43,280 --> 00:03:47,870
وسيُمنح المرضى ذوي الأعراض
.المستقرّة بطاقات خشبيّة خضراء

25
00:03:47,870 --> 00:03:49,450
.وسنعالجهم حسب ذلك التّسلسل

26
00:03:50,120 --> 00:03:51,410
ما الغرض من البطاقات السّوداء؟

27
00:03:52,750 --> 00:03:53,790
.إنّها للموتى

28
00:03:55,630 --> 00:03:58,710
هل سنستقبل الكثير من الضّحايا اللّيلة؟

29
00:03:59,210 --> 00:04:01,800
سيكون من الرّائع لو كان
.كلّ هذا العمل هباءً

30
00:04:18,610 --> 00:04:20,070
.تمالك نفسك

31
00:04:21,030 --> 00:04:23,780
...أ-أخبرني يا غويتشي

32
00:04:23,780 --> 00:04:24,860
أتريد الهروب؟

33
00:04:24,860 --> 00:04:26,360
!لا تتفوّه بالهراء

34
00:04:26,870 --> 00:04:28,160
...أعني

35
00:04:28,950 --> 00:04:31,120
!البقاء للأقوى

36
00:04:31,580 --> 00:04:34,290
!إن هربنا هنا، فسنكون فرائس للأبد

37
00:04:34,290 --> 00:04:35,670
!سيتمّ التهامنا بالكامل

38
00:04:45,510 --> 00:04:48,470
"مطعم أوُيْيا"

39
00:04:59,650 --> 00:05:00,480
.كاورو

40
00:05:03,230 --> 00:05:05,650
،قالوا أنّ الوقت وشيك
.لذلك علينا أن نجتمع جميعًا

41
00:05:07,320 --> 00:05:08,280
.مفهوم

42
00:05:11,700 --> 00:05:12,540
...في الغد

43
00:05:14,080 --> 00:05:17,120
.عندما يحين الغد، سيكون كنشين قد عاد

44
00:05:18,580 --> 00:05:19,830
...لذلك سأفعل

45
00:05:21,210 --> 00:05:22,920
.ما أنا قادرة على فعله

46
00:05:25,050 --> 00:05:26,800
بعد كلّ هذا؟

47
00:05:26,800 --> 00:05:29,800
ياهيكو، ألم تكن قلقًا على كنشين؟

48
00:05:30,140 --> 00:05:31,300
.بالطّبع لا

49
00:05:31,800 --> 00:05:35,680
،لا يهمّ ما مدى قوّة الخصم
.فسانوسكي موجود أيضًا

50
00:05:35,680 --> 00:05:39,060
وسايتو معهما أيضًا رغم أنّي
.لا أريد الاعتماد عليه كثيرًا

51
00:05:39,060 --> 00:05:42,480
وقبل كلّ شيء، كنشين
!هو أفضل سيّاف في اليابان

52
00:05:44,400 --> 00:05:45,440
.معك حقّ

53
00:06:14,390 --> 00:06:15,520
.حان الوقت

54
00:06:16,680 --> 00:06:19,310
أيّها الرّئيس، ماذا نفعل؟

55
00:06:19,520 --> 00:06:20,980
.ابقوا متأهّبين

56
00:06:21,480 --> 00:06:24,650
إن حصلتم على أيّ معلومات
،عن أيّ حرائق أو أعمال شغب

57
00:06:24,650 --> 00:06:26,280
.فسنتعامل معها في الحال

58
00:06:28,780 --> 00:06:30,240
.حان الوقت. هيّا

59
00:06:32,200 --> 00:06:34,200
.حسنًا، التّالي... انطلق

60
00:06:34,910 --> 00:06:36,040
...غويتشي

61
00:06:36,040 --> 00:06:38,450
.لا تتكلّم أكثر. بدأ الأمر سلفًا

62
00:06:40,210 --> 00:06:41,210
ما الخطب؟

63
00:06:41,420 --> 00:06:43,080
لماذا عدت؟

64
00:06:43,080 --> 00:06:44,090
!الشّرطة

65
00:06:44,630 --> 00:06:45,880
!إنّهم في كلّ مكان

66
00:06:48,630 --> 00:06:49,760
!ذهبوا من هناك

67
00:06:50,260 --> 00:06:51,890
!انتظر يا هذا

68
00:06:52,550 --> 00:06:54,510
!كانت هنالك صافرات من أماكن أخرى أيضًا

69
00:06:54,890 --> 00:06:57,600
!ثمّة عدد أكثر ممّا كنّا نتوقّعه

70
00:06:57,600 --> 00:06:59,480
.سُحقًا! لا خيار لدينا

71
00:06:59,980 --> 00:07:01,480
!تأهّبوا جميعًا

72
00:07:01,480 --> 00:07:04,690
سأبعث رسولاً وأطلب إرشادات
.من كاماتاري-ساما

73
00:07:04,980 --> 00:07:06,650
.استقبلنا رسلاً من كلّ حيّ

74
00:07:06,650 --> 00:07:10,360
ابتداءً من السّاعة 23:59، اعتقلنا
.العديد من الأفراد المشبوهين

75
00:07:10,860 --> 00:07:12,660
.لم يتمّ إضرام أيّ حرائق

76
00:07:12,990 --> 00:07:14,120
.هذا كلّ شيء

77
00:07:14,120 --> 00:07:15,030
.هكذا إذًا

78
00:07:15,740 --> 00:07:17,330
كم عددُ من اعتُقلوا؟

79
00:07:17,330 --> 00:07:19,370
.أقلّ من 20 بقليل حتّى الآن

80
00:07:20,410 --> 00:07:22,420
.ما زلنا نملك القدرة على تولّي أمر المزيد

81
00:07:22,920 --> 00:07:23,750
.حسنًا

82
00:07:23,920 --> 00:07:27,050
عيِّنوا رجالاً من الفرقة الرّئيسيّة
.لنقل الأفراد المشبوه بهم

83
00:07:27,050 --> 00:07:29,460
ستستمرّ فرق الأمن بفعل
.ما كانوا يفعلونه حتّى الآن

84
00:07:29,460 --> 00:07:30,630
.مفهوم

85
00:07:37,100 --> 00:07:38,100
.تأخّروا

86
00:07:38,560 --> 00:07:40,430
أين ألسنة اللّهب؟

87
00:07:40,430 --> 00:07:42,060
!لا تعرف الصّبر أبدًا

88
00:07:42,390 --> 00:07:45,270
.لن تنتشر الحرائق بتلك السّهولة

89
00:07:45,270 --> 00:07:46,310
!لديّ تقرير

90
00:07:47,480 --> 00:07:49,860
ينتشر رجال الشّرطة في كلّ
.مكان من مدينة كيوتو

91
00:07:50,070 --> 00:07:52,650
.لا تستطيع الفرقة الأولى تنفيذ العمليّة

92
00:07:52,650 --> 00:07:54,070
!وكذلك الفرقة الثّانية

93
00:07:54,070 --> 00:07:57,780
والفرقة الثّالثة أيضًا تجد
!صعوبة في تنفيذ العمليّة

94
00:07:57,780 --> 00:08:00,790
.يا إلهي. جميعهم أطفال مشاكسون بلا فائدة

95
00:08:01,290 --> 00:08:04,960
.لا خيار أمامنا. لنغيّر الخطّة الآن

96
00:08:04,960 --> 00:08:09,920
.سنقوم بخلق إلهاء لتسهيل قيامكم بعملكم

97
00:08:09,960 --> 00:08:12,380
أوسوي-دونو، المهمّة الموكلة
لنا نحن السّيوف العشرة

98
00:08:12,380 --> 00:08:15,010
.هي اغتيال الشّخصيّات المحوريّة المهمّة

99
00:08:15,550 --> 00:08:20,390
مهمّتنا لا تنصّ على قتل رجالِ
.الشّرطة متدنّي المستوى والمدنيّين

100
00:08:21,640 --> 00:08:24,480
،بمجرّد انتشار الحريق
.فسيصير الأمران نفس الشّيء

101
00:08:24,890 --> 00:08:28,480
لن يكون هنالك أيّ تغيير
.إن ماتوا جميعًا في النّهاية

102
00:08:28,480 --> 00:08:31,070
.لن أضغط كثيرًا

103
00:08:31,070 --> 00:08:31,940
...ولكن

104
00:08:32,860 --> 00:08:34,610
.لا تعترضوا طريقي

105
00:08:36,160 --> 00:08:39,330
.في تلك الحالة، سنستأذن أنا وفوجي

106
00:08:40,030 --> 00:08:42,120
—حسنًا. وأنا

107
00:08:42,120 --> 00:08:44,750
.ابق هنا أيّها الغبيّ. ستعترض الطّريق فحسب

108
00:08:49,250 --> 00:08:51,960
كاماتاري-ساما، ماذا علينا أن نفعل؟

109
00:08:53,460 --> 00:08:54,880
.دعوني أفكّر

110
00:09:01,060 --> 00:09:04,310
.أيّها الرّئيس، اختفى الأفراد المشبوهين

111
00:09:04,640 --> 00:09:06,690
ربّما استسلموا؟

112
00:09:09,440 --> 00:09:13,820
ماذا إن أرسلنا الوحدة المركزيّة
كدعم لإيجاد المتخلّفين عن الرّكب؟

113
00:09:13,820 --> 00:09:15,990
.أظنّ أنّ ذلك سيكون أكثر كفاءة

114
00:09:16,490 --> 00:09:17,860
.صحيح

115
00:09:19,780 --> 00:09:21,240
ماذا؟ ما هذا؟

116
00:09:21,240 --> 00:09:22,370
ما هذا الصّوت؟

117
00:09:22,370 --> 00:09:23,950
!مهلاً! انظروا هناك

118
00:09:46,770 --> 00:09:47,690
!استعدّوا للاعتراض

119
00:09:48,190 --> 00:09:50,900
إلى فرقة الأسلحة النّاريّة، اصطفّوا
!في ثلاثة صفوف! تقدّموا للأمام

120
00:09:54,980 --> 00:09:56,030
.استعدّوا

121
00:09:58,820 --> 00:09:59,950
.صوّبوا

122
00:10:01,410 --> 00:10:03,030
!أطلقوا

123
00:10:09,210 --> 00:10:13,340
من أجل كرامة الشّرطة، يجب
!علينا أن نوقف هذه الانتهاكات

124
00:10:13,460 --> 00:10:15,300
!يا فرقة السّيّافين، إلى الأمام

125
00:10:16,090 --> 00:10:17,590
!تقدّموا

126
00:10:17,720 --> 00:10:19,550
!هجوم

127
00:10:21,430 --> 00:10:22,300
.هـ-هذا سيّئ

128
00:10:22,300 --> 00:10:23,470
!إنّهم يفوقوننا عددًا

129
00:10:23,470 --> 00:10:24,720
!اهربوا

130
00:10:25,010 --> 00:10:26,600
!اللّعنة عليكم

131
00:10:26,600 --> 00:10:27,430
.لا بأس

132
00:10:28,310 --> 00:10:30,730
.يستطيع كلّ من يريد الهرب أن يهرب

133
00:10:32,520 --> 00:10:34,360
...لكن

134
00:10:35,190 --> 00:10:39,610
فقط إن كنتم قادرين على تجاوز
حاصود إله الموت هذا، مفهوم؟

135
00:10:40,450 --> 00:10:41,610
ما-ماذا؟

136
00:10:41,610 --> 00:10:42,870
صراع داخليّ؟

137
00:10:48,200 --> 00:10:50,830
ما الفائدة من قطع لعب تخشى الموت؟

138
00:10:51,620 --> 00:10:55,040
.وخاصّة إن كانت مجرّد بيادق مثلكم

139
00:10:55,500 --> 00:10:57,710
.الخيار الوحيد للبيادق هو التّقدّم للأمام

140
00:10:58,510 --> 00:10:59,420
.انطلقوا

141
00:10:59,970 --> 00:11:01,340
!إلى الأمام

142
00:11:01,550 --> 00:11:03,300
!استعجلوا

143
00:11:03,300 --> 00:11:04,550
!اثبتوا

144
00:11:04,680 --> 00:11:06,510
!دافعوا بكلّ ما لديكم

145
00:11:15,940 --> 00:11:18,440
.حسنًا. ستفي هذه المنطقة بالغرض

146
00:11:18,690 --> 00:11:22,570
هذه هي فرصتنا بينما الفرقة
.الرّئيسيّة والشّرطة يتواجهون معًا

147
00:11:22,570 --> 00:11:23,410
.نعم

148
00:11:30,250 --> 00:11:31,790
.حسنًا، لنقم بهذا

149
00:11:41,420 --> 00:11:43,890
!اسمعوا! وجدتُ مفتعلي حرائق

150
00:11:43,890 --> 00:11:44,800
أين؟ أين؟

151
00:11:45,090 --> 00:11:46,760
!وجدتهم! هنا

152
00:11:46,890 --> 00:11:48,140
!نالوا منهم

153
00:11:48,140 --> 00:11:49,310
!مـ-مهلاً لحظة

154
00:11:49,310 --> 00:11:51,770
لماذا ثمّة الكثير من النّاس
مستيقظين في مثل هذا الوقت؟

155
00:11:55,400 --> 00:11:56,270
.حسنًا

156
00:11:56,810 --> 00:11:57,980
!الوضع هنا جيّد حاليًّا

157
00:11:58,650 --> 00:12:00,190
—يا ميساو-تشان

158
00:12:00,190 --> 00:12:02,400
!أقصد، أيّتها القائدة الجديدة

159
00:12:02,400 --> 00:12:03,740
!ألقينا القبض عليهم هنا

160
00:12:04,160 --> 00:12:05,700
!شكرًا جزيلاً لكم

161
00:12:05,700 --> 00:12:07,660
!لكنّ هذه هي البداية فقط

162
00:12:07,910 --> 00:12:10,040
!كونوا حذرين وأنتم تقومون بالدّوريّات

163
00:12:10,040 --> 00:12:11,830
!أجل! دعي الأمر لنا

164
00:12:11,830 --> 00:12:14,370
،والآن يا أوتشيكا-سان وأوماسو-سان

165
00:12:14,370 --> 00:12:16,920
سأستمع إلى تقاريركما
،عمّا حدث قبل قليل لاحقًا

166
00:12:18,500 --> 00:12:20,800
علينا مواصلة منع إضرام الحرائق
!وحماية الجميع

167
00:12:20,800 --> 00:12:21,710
—حاضرة يا ميساو-تشان

168
00:12:22,300 --> 00:12:24,930
.أقصد، كوني حذرة أيضًا أيّتها القائدة

169
00:12:28,010 --> 00:12:29,470
!حظًّا سعيدًا

170
00:12:29,680 --> 00:12:30,810
!أجل

171
00:12:31,310 --> 00:12:34,690
لسبب ما، شعبيّة جماعة
.أونيوابانشو كيوتو كبيرة

172
00:12:35,190 --> 00:12:36,190
.نعم

173
00:12:36,520 --> 00:12:38,770
.لا أصدّق أنّهم ما زالوا جواسيس

174
00:12:39,270 --> 00:12:43,030
لكنّ هذه هي طريقة الحياة الّتي
...اختارها أوكينا-سان والبقيّة

175
00:12:43,030 --> 00:12:43,950
!أجل

176
00:12:43,950 --> 00:12:46,030
.ونتيجة سنواتهم العشر

177
00:12:46,530 --> 00:12:49,990
نعم. قوّة جماعة الأونيوابانشو
،الّتي لا تتزعزع الحقيقيّة

178
00:12:50,540 --> 00:12:53,660
...حتّى في مواجهة مدفع غاتالينغ

179
00:12:54,960 --> 00:12:58,790
لا تزال موجودة هنا بالفعل
!وإن اختلف شكلها

180
00:12:59,790 --> 00:13:02,550
!حسنًا! انتشروا جميعًا

181
00:13:02,550 --> 00:13:05,050
!أجل –
!أجل –

182
00:13:05,050 --> 00:13:06,430
!كاورو-سان! ياهيكو-كُن

183
00:13:06,590 --> 00:13:08,390
!إلى المكان التّالي! التّالي

184
00:13:08,390 --> 00:13:09,680
!نعم –
!أجل –

185
00:13:17,190 --> 00:13:18,400
.تأخّروا

186
00:13:19,480 --> 00:13:23,230
يجدر أن تكون هنالك ألسنة لهب
.يمكن رؤيتها من اتّجاه كيوتو الآن

187
00:13:23,740 --> 00:13:25,860
لماذا يتحرّكون ببطء هكذا؟

188
00:13:26,530 --> 00:13:29,120
.إنّهم يواجهون ألف رجل شرطة الآن

189
00:13:29,820 --> 00:13:32,330
.ليس من المفاجئ لهم أن يواجهوا وقتًا صعبًا

190
00:13:32,540 --> 00:13:34,450
.ولكن مع ذلك، أخذ الأمر وقتًا طويلاً

191
00:13:34,450 --> 00:13:36,870
.لا حاجة فعليّة للعجلة

192
00:13:36,870 --> 00:13:40,290
.فلا أظنّ أنّ هنالك من سيأتي لمطاردتنا هنا

193
00:13:40,290 --> 00:13:43,760
...أيعقل يا شيشيو-ساما

194
00:13:43,760 --> 00:13:46,340
أن تكون عاطفيًّا بعض الشّيء الآن؟

195
00:13:46,670 --> 00:13:48,300
رغم رؤية أرض مليئة بذكريات الماضي

196
00:13:48,300 --> 00:13:53,260
تحترق بالكامل هو لأجل مهمّتنا
.إلاّ أنّك تشعر ببعض النّدم في النّهاية

197
00:13:54,020 --> 00:13:57,640
لذلك أردتَ على الأقلّ
.أن ترى كيف ستنتهي

198
00:13:58,140 --> 00:14:00,440
.يومي، لقد شربتِ الكثير

199
00:14:01,360 --> 00:14:04,440
ما السّبب الّذي قد يجعلني عاطفيًّا؟

200
00:14:04,940 --> 00:14:07,950
.إنّنا نبحر من أجل مجدي

201
00:14:08,400 --> 00:14:10,910
حريق كيوتو الكبير الّذي أنتظره

202
00:14:11,120 --> 00:14:15,040
هي ألعاب ناريّة احتفاليّة
.لشروعنا في حرب وإعلانها

203
00:14:15,540 --> 00:14:17,000
...ومع ذلك

204
00:14:21,130 --> 00:14:24,210
إنّ حقيقة تركي لمنافستي مع ذلك
الرّجل بدون نتيجة محسومة

205
00:14:24,210 --> 00:14:27,340
.هو أمر أندم عليه بالفعل

206
00:14:31,970 --> 00:14:32,890
!هوجي-ساما

207
00:14:33,510 --> 00:14:34,930
هل بدأت تظهر ألسنة اللّهب؟

208
00:14:34,930 --> 00:14:35,930
!كـ-كلاّ

209
00:14:36,270 --> 00:14:37,390
!ثمّة عربة

210
00:14:37,600 --> 00:14:41,810
!عربة في طريقها إلينا بسرعة كبيرة

211
00:14:42,020 --> 00:14:44,980
في أيّ واحدة يا كنشين؟
أيّها هي سفينة شيشيو؟

212
00:14:45,150 --> 00:14:47,190
!تلك! السّفينة الخشبيّة تلك

213
00:14:47,400 --> 00:14:50,150
إنّها الوحيدة الّتي تطلق بخارًا
!وتستعد للانطلاق

214
00:14:50,410 --> 00:14:51,610
.حسنًا، توقّف

215
00:15:02,040 --> 00:15:02,880
!مستحيل

216
00:15:05,590 --> 00:15:09,170
أنا وهو هيتوكيري نتشابه
.في الكثير من النّواحي

217
00:15:09,170 --> 00:15:11,430
.لا بدّ أنّه قرأ أفكاري

218
00:15:14,600 --> 00:15:17,560
...أتيت لتودّعني وأنا مغادر في رحلتي إذًا

219
00:15:20,310 --> 00:15:22,230
!يا هيمورا الباتّوساي

220
00:15:24,480 --> 00:15:29,190
في كلّ الأحوال، سأقوم بتهنئته
.على اكتشاف هذا الأمر

221
00:15:29,940 --> 00:15:31,650
...هيمورا الباتّوساي

222
00:15:32,160 --> 00:15:34,410
...وسايتو هاجيمي أيضًا

223
00:15:35,450 --> 00:15:36,450
ماذا؟

224
00:15:37,370 --> 00:15:39,790
.ثمّة رجل مجهول معهما

225
00:15:39,790 --> 00:15:40,660
ماذا؟

226
00:15:42,500 --> 00:15:46,130
.صحيح، أظنّ أنّه صديق هيمورا-سان

227
00:15:46,290 --> 00:15:48,590
...إن أسعفتني الذّاكرة

228
00:15:48,590 --> 00:15:50,510
.ساغارا سانوسكي

229
00:15:50,510 --> 00:15:53,590
.يبدو أنّه مقاتل مأجور معروف في طوكيو

230
00:15:54,140 --> 00:15:57,680
،ولكن مقارنة بالآخريْن
.مهاراته القتاليّة أقلّ بكثير

231
00:15:58,180 --> 00:15:59,560
فعلاً؟

232
00:15:59,850 --> 00:16:02,020
.إنّه نكرة إذًا

233
00:16:03,980 --> 00:16:08,020
لا بدّ أنّ العدوّ متفاجئ
.من رؤيتنا جميعًا هنا

234
00:16:08,020 --> 00:16:09,150
.مغفّل

235
00:16:09,360 --> 00:16:13,240
.لكن لا يزال الوقت باكرًا على التّفاجؤ

236
00:16:14,820 --> 00:16:17,700
والآن، ماذا نفعل يا شيشيو-سان؟

237
00:16:18,120 --> 00:16:21,660
هل نسوّ الحساب الّذي بدأ
في قرية شينغتسو هنا؟

238
00:16:21,910 --> 00:16:26,500
كم أودّ ذلك، لكن لا يمكنني
.إضاعة الوقت هنا

239
00:16:27,130 --> 00:16:30,880
،ومع ذلك، إن انطلقنا الآن
،سيبدو الأمر وكأنّنا نهرب منه

240
00:16:30,880 --> 00:16:32,170
.وذلك مزعج

241
00:16:32,670 --> 00:16:35,130
.هوجي، دع الجميع يصعدون على متن السّفينة

242
00:16:35,130 --> 00:16:35,970
ماذا؟

243
00:16:35,970 --> 00:16:38,390
.واستعدّوا للتّخلّص من الطّبقة الخارجيّة

244
00:16:39,260 --> 00:16:42,560
سنريهم فارقًا كبيرًا في القوّة

245
00:16:42,560 --> 00:16:46,350
.وسنجعله يتذوّق عجزه قبل أن نودّعه

246
00:16:47,900 --> 00:16:50,730
والآن، ماذا نفعل؟

247
00:16:51,070 --> 00:16:54,450
قبل كلّ شيء، علينا الغطس تحت
.الماء والتّسلّل إليهم إن أمكن

248
00:16:54,950 --> 00:16:57,240
—ثمّ سنتّجه لقاع السّفينة –
.مهلاً لحظة –

249
00:16:58,030 --> 00:17:01,790
،إن كنت تريد إحداث ثقب فيها
.فلديّ شيء أفضل بكثير من السّيف

250
00:17:02,450 --> 00:17:06,460
.أعطاني كاتسو هذه المتفجّرات كهديّة وداع

251
00:17:06,960 --> 00:17:09,460
!إنّها من النّوع الأحدث الّذي لا يحتاج لإشعال

252
00:17:09,710 --> 00:17:10,550
—إن استعملنا هذه

253
00:17:10,550 --> 00:17:11,420
.مغفّل

254
00:17:12,880 --> 00:17:17,680
،اسمع يا هذا، في كلّ مرّة
—أيّ جزء لا تفـ

255
00:17:17,680 --> 00:17:19,850
.إن كنت لا تفهم، فأنت مغفّل حقيقيّ

256
00:17:19,850 --> 00:17:21,560
ماذا؟ –
...اهدأ يا سانو –

257
00:17:22,060 --> 00:17:25,810
،حتّى إن كانت لا تحتاج لإشعال
،إن غصت في البحر وهي معك

258
00:17:25,810 --> 00:17:28,150
.من الطّبيعيّ أنّ يتبلّل البارود الّذي بداخلها

259
00:17:28,480 --> 00:17:32,360
،إن حدث ذلك، فستفشل في الانفجار
.مهما كانت جودتها عالية

260
00:17:33,570 --> 00:17:34,820
.أتمنّى أن تكون قد فهمت

261
00:17:35,030 --> 00:17:40,030
ليس لديك سيف، لذلك الزم مكانك
.هنا حتّى تصل شرطة أوساكا

262
00:17:47,040 --> 00:17:48,040
ما هذا؟

263
00:17:48,170 --> 00:17:50,000
دمّرت سفينة شيشيو نفسها؟

264
00:17:50,590 --> 00:17:52,210
هل خرج المدفع عن السّيطرة؟

265
00:17:53,300 --> 00:17:54,420
.لا

266
00:18:15,780 --> 00:18:18,150
.يبدو أنّكم تفاجأتم

267
00:18:18,780 --> 00:18:22,870
مع أنّي أنفقت ثلاثة أخماس مدّخرات حياتي

268
00:18:22,870 --> 00:18:25,790
،في سفينة رنغوكو المدرّعة هذه

269
00:18:26,450 --> 00:18:29,870
أحتاج منك لأن تكون متفاجئًا أكثر
.حتّى يكون الأمر يستحقّ ذلك

270
00:18:30,500 --> 00:18:33,210
.هوجي، لقّم مدفع آرمسترونغ

271
00:18:33,670 --> 00:18:38,130
دعهم يستمتعون بالألعاب
.النّاريّة احتفالاً بمغادرتي أيضًا

272
00:18:38,130 --> 00:18:39,180
.عُلم

273
00:18:40,840 --> 00:18:42,300
سفينة مدرّعة؟

274
00:18:43,100 --> 00:18:45,970
إن استطاع شخص الحصول
،على شيء كهذا

275
00:18:46,270 --> 00:18:49,230
فإنّ حكومة ميجي لن تدوم
.طويلاً في كلّ الأحوال

276
00:18:49,770 --> 00:18:52,900
أيّها الباتّوساي، بإمكانك قطع الفولاذ، صحيح؟

277
00:18:53,400 --> 00:18:56,150
.نعم، ما دام ليس تحت الماء

278
00:18:57,190 --> 00:18:59,150
.يبدو أنّ هنالك تغيّرًا في الخطّة

279
00:18:59,780 --> 00:19:03,160
.سانو، سنجذب أنا وسايتو نيران المدفع لنا

280
00:19:04,030 --> 00:19:06,790
استغلّ تلك الفرصة واعثر على قارب صغير

281
00:19:06,790 --> 00:19:09,580
وتسلّل إلى السّفينة المدرّعة
.وهاجمها بالمتفجّرات

282
00:19:09,580 --> 00:19:10,420
ماذا؟

283
00:19:10,420 --> 00:19:12,880
استهدف غرفة المحرّك. مفهوم؟ –
—مهلاً! انتظر يا كنشين –

284
00:19:12,880 --> 00:19:13,840
!نار

285
00:19:14,420 --> 00:19:15,250
!هيّا بنا –
!مهلاً –

286
00:19:24,140 --> 00:19:25,220
!كنشين

287
00:19:25,510 --> 00:19:29,480
،إن تسلّلتُ وبحثتُ عن قارب
.فسيأخذ ذلك الكثير من الوقت

288
00:19:30,020 --> 00:19:32,940
أيمكنك مواصلة تفادي نيران
المدفع حتّى ذلك الحين؟

289
00:19:33,190 --> 00:19:34,360
!سُحقًا

290
00:19:39,360 --> 00:19:40,700
!أصابت الطّلقة الأولى الهدف

291
00:19:41,150 --> 00:19:42,950
أنلقّم الطّلقة الثّانية؟

292
00:19:43,450 --> 00:19:46,280
.لا. هذا يكفي بالنّسبة لمدفع آرمسترونغ

293
00:19:46,620 --> 00:19:49,250
جهّز مدفع غاتالينغ بدلاً منه
.وفي أسرع وقت

294
00:19:49,500 --> 00:19:50,460
ماذا؟

295
00:19:55,420 --> 00:19:56,250
ماذا؟

296
00:19:59,550 --> 00:20:02,430
...أرحّب بالهجوم الانتحاريّ اليائس

297
00:20:03,220 --> 00:20:06,100
.أو ذلك ما أودّ قوله، لكن لا تزال ساذجًا

298
00:20:07,180 --> 00:20:10,730
.قرأت أفكاري وتوقّعت كلّ خططي

299
00:20:11,270 --> 00:20:13,600
.ولكن يمكن للعكس أن يحدث أيضًا

300
00:20:14,150 --> 00:20:18,650
من الطّبيعيّ لي أيضًا أن أكون
.قد قرأت أفكارك وتوقّعتُ حركاتك

301
00:20:21,400 --> 00:20:22,280
!سانو

302
00:20:22,490 --> 00:20:26,700
!أعلم سلفًا أنّكما كنتما مجرّد إلهاء

303
00:20:26,830 --> 00:20:29,370
!مدفع الغاتالينغ، إطلاق

304
00:20:40,460 --> 00:20:41,300
—كان ذلك

305
00:20:41,460 --> 00:20:43,550
!أسلوب إتقان الطّبقتين الخاصّ بأنجي

306
00:20:43,880 --> 00:20:45,180
...ذلك الوغد

307
00:20:45,760 --> 00:20:47,600
.ليس مجرّد نكرة

308
00:20:50,390 --> 00:20:51,310
سانو؟

309
00:20:54,230 --> 00:20:55,190
.رمح— لا

310
00:20:55,190 --> 00:20:56,020
!غمد

311
00:20:58,610 --> 00:20:59,610
!مذهل

312
00:21:02,240 --> 00:21:03,650
...التقينا أخيرًا

313
00:21:04,360 --> 00:21:05,360
.أيّها الباتّوساي

314
00:21:10,660 --> 00:21:12,040
...شينوموري

315
00:21:13,040 --> 00:21:14,080
.أوشي

316
00:22:47,050 --> 00:22:48,050
:في الحلقة القادمة

317
00:22:48,050 --> 00:22:50,430
."حريق كيوتو الكبير، الجزء الثّاني"