1
00:00:05,940 --> 00:00:07,060
...هذا الشّرطيّ

2
00:00:07,650 --> 00:00:09,190
يعرف هيمورا؟

3
00:00:12,780 --> 00:00:13,700
!نسيت تمامًا! هيمورا

4
00:00:22,580 --> 00:00:23,660
.مذهل

5
00:00:24,080 --> 00:00:25,670
.لا يبدو عليه التّعب أبدًا

6
00:00:26,170 --> 00:00:29,630
أنت. لماذا تضيّع الوقت هنا؟

7
00:00:34,920 --> 00:00:36,010
.سايتو

8
00:00:41,060 --> 00:00:46,730
روروني كنشين
—اضطرابات كيوتو—

9
00:02:06,980 --> 00:02:10,980
:الحلقة الثّامنة والعشرون
صورة الطَّموح

10
00:02:12,860 --> 00:02:14,440
لماذا أنت هنا؟

11
00:02:14,440 --> 00:02:15,730
.للعمل

12
00:02:15,730 --> 00:02:20,660
تواصل معي أحد رجالي الّذين أرسلتُهم
.إلى هنا وقال أنّ شيشيو موجود هنا الآن

13
00:02:20,660 --> 00:02:23,580
ستحتاج القوّات العقابيّة لوقت
،قبل وصولها إلى كيوتو

14
00:02:23,870 --> 00:02:25,950
.لذلك قرّرت المجيء كلّ هذه المسافة

15
00:02:26,410 --> 00:02:30,250
.وبالطّبع ذلك الرّجل مفقود الآن

16
00:02:31,120 --> 00:02:34,880
هل يُعقل أنّ أخو إيجي كان
جاسوسًا لشرطة العاصمة؟

17
00:02:35,340 --> 00:02:36,340
إيجي؟

18
00:02:40,010 --> 00:02:44,760
فهمت. ينحدر ميشيما إيتشيرو
.من قرية شينغتسو هذه

19
00:02:45,350 --> 00:02:49,230
أرسلتُه مُعتقدًا أنّ بإمكانه التّسلّل
.بينهم دون جذب الشّبهات إليه

20
00:02:49,680 --> 00:02:51,640
.أعتقد أنّهم اكتشفوا من يكون

21
00:02:52,310 --> 00:02:54,980
.وأراد على الأقلّ أن يحمي عائلته

22
00:03:00,650 --> 00:03:01,910
.يا له من غبيّ

23
00:03:02,570 --> 00:03:05,240
.كان عليه انتظار وصولي

24
00:03:05,580 --> 00:03:06,580
!مهلاً لحظة

25
00:03:06,870 --> 00:03:09,790
هذه ليست الطّريقة المناسبة
!للحديث عن تابع مات سلفًا

26
00:03:10,290 --> 00:03:11,960
...أنت، من تكون

27
00:03:15,880 --> 00:03:17,130
فتاةُ ابن عرسٍ هذه؟

28
00:03:18,090 --> 00:03:20,090
!مت! سأقتلك

29
00:03:20,090 --> 00:03:21,380
.على مهلك

30
00:03:22,340 --> 00:03:24,010
.هذه هي طباعه فحسب

31
00:03:24,510 --> 00:03:25,350
...على أيّ حال

32
00:03:25,850 --> 00:03:27,930
.دعونا ننزلهما ونكرمهما بالدّفن

33
00:03:29,430 --> 00:03:30,480
.صحيح

34
00:03:31,810 --> 00:03:32,890
.مهلاً

35
00:03:36,940 --> 00:03:39,150
.لا يمكنكم إنزالهما

36
00:03:40,360 --> 00:03:44,530
...إن قمتم بإنزالهما وأثرتم غضب سنكاكو

37
00:03:44,820 --> 00:03:47,450
.فلن نستطيع نحن القرويّون قتاله

38
00:03:47,740 --> 00:03:50,370
.لذلك دعوهما كما هما

39
00:03:50,910 --> 00:03:52,160
ما الّذي تقوله؟

40
00:03:52,580 --> 00:03:54,540
ألستم من نفس القرية؟

41
00:03:54,540 --> 00:03:58,340
،حتّى إن كنتم تُعامَلون هكذا
ما زلتم ستنصاعون لسنكاكو؟

42
00:03:59,590 --> 00:04:01,800
.إن جابهنا سنكاكو، فسنموت

43
00:04:02,470 --> 00:04:06,390
.ولكن، إن لم نجابهه، فسنظلّ أحياء على الأقلّ

44
00:04:06,850 --> 00:04:11,390
.هذا من أجل صالح القرية
...أنتم الغرباء والفتى ميشيما

45
00:04:11,680 --> 00:04:14,640
.عليكم مغادرة القرية في الحال

46
00:04:15,400 --> 00:04:17,150
أفهمت يا إيجي؟

47
00:04:17,440 --> 00:04:18,270
—أيّها الـ

48
00:04:18,270 --> 00:04:19,110
.لا داعي للغضب

49
00:04:19,820 --> 00:04:26,570
قلّة فقط من يقدرون على المخاطرة
.بحياتهم لحماية الشّرف والكرامة كبشر

50
00:04:26,950 --> 00:04:31,540
،إن كنتم تسعون للبقاء أحياء فحسب
.فلن تحتاجوا للشّرف أو الكرامة

51
00:04:32,370 --> 00:04:34,210
وما أدرى غريبًا مثلك بحالنا؟

52
00:04:34,370 --> 00:04:37,460
.كلّ هذا نِتاجٌ لجُبن رجال الشّرطة

53
00:04:37,880 --> 00:04:41,880
.في كلّ الأحوال، لن نسمح لكم بإنزال الجثّتين

54
00:04:43,010 --> 00:04:44,670
.غادروا المكان في الحال

55
00:04:46,550 --> 00:04:47,390
!هيمورا

56
00:04:56,270 --> 00:04:57,850
—ما الّذي تفعله يا

57
00:04:58,190 --> 00:04:59,230
!هيمورا

58
00:05:07,530 --> 00:05:09,820
.هذا هو الوضع الحاليّ لهذه القرية

59
00:05:10,620 --> 00:05:15,080
وهكذا ستصير اليابان في العصر
.الجديد الّذي يُنشؤه شيشيو

60
00:05:17,370 --> 00:05:20,040
،إن صارت هذه القرية خرابًا
.فسيكون ذلك خطؤك

61
00:05:20,420 --> 00:05:21,840
.أيّها القاتل

62
00:05:22,800 --> 00:05:25,590
.النّاس ضعفاء ضدّ رعب العنف

63
00:05:25,590 --> 00:05:29,470
وتحت براثنه، يتحوّل الهدف الرّئيسيّ
،في حياتهم إلى النّجاة فحسب

64
00:05:29,970 --> 00:05:31,760
.ويفقدون كلّ ذرّة شرف وكرامة لديهم

65
00:05:32,180 --> 00:05:34,890
هل تخلّت الحكومة عن هذه القرية بالفعل؟

66
00:05:35,230 --> 00:05:36,520
.ليس هذه القرية فحسب

67
00:05:36,730 --> 00:05:40,980
تمّ التّخلّي عن عشرة قرى أخرى
.وصارت ضمن منطقة شيشيو

68
00:05:41,650 --> 00:05:44,610
سبق واستسلمت الشّرطة
.عن فكرة استعادة القرى منه

69
00:05:44,860 --> 00:05:46,360
،لا أفهم الأمر بالكامل

70
00:05:46,360 --> 00:05:48,700
،لكن إن لم تكن الشّرطة ذات فائدة
أفلا يمكنكم استعمال الجيش؟

71
00:05:49,110 --> 00:05:52,700
مغفّلة. انتهت حرب سينان
.منذ ستّة أشهر فحسب

72
00:05:52,700 --> 00:05:54,910
،إن تمّ نشر الجيش لحلّ اضطرابات داخليّة

73
00:05:55,160 --> 00:05:57,830
فسيكشف ذلك عن عدم استقرارنا
.الدّاخليّ للبلدان الأجنبيّة

74
00:05:58,250 --> 00:06:00,250
!هذا ليس وقتًا مناسبًا لقول ذلك

75
00:06:00,540 --> 00:06:05,000
،حتّى إن كنّا سنستعمل الجيش
.لن يوافق السّياسيّون على ذلك أبدًا

76
00:06:05,510 --> 00:06:06,340
لماذا؟

77
00:06:08,380 --> 00:06:12,430
إنّ كلّ واحد منهم يخاف أن يكون
.مصيره مثل مصير السّيّد أوكوبو

78
00:06:13,350 --> 00:06:17,060
،إن استعمالنا الجيش
...فسنستعيد القرى بالتّأكيد

79
00:06:17,560 --> 00:06:20,270
لكنّ الانتقام عن طريق الاغتيالات
.سيصير أمرًا لا مفرّ منه

80
00:06:20,940 --> 00:06:22,730
أظنّك تدركين جيّدًا

81
00:06:22,730 --> 00:06:27,400
كم أنّ الاغتيال أمر مخيف ويصعب
.منعه بالنّسبة لمسؤولي الحكومة

82
00:06:28,530 --> 00:06:30,820
إنّ مسؤولي الحكومة مجرّد
.بشر قبل كلّ شيء

83
00:06:31,320 --> 00:06:33,280
إنّهم يخشون على حياتهم

84
00:06:33,280 --> 00:06:36,160
ويعتقدون دائمًا أنّ شخصًا آخر
.سيحلّ المشكلة

85
00:06:36,540 --> 00:06:37,910
ومن هذا الشّخص الآخر؟

86
00:06:38,040 --> 00:06:40,170
من سيجعل هذه القرية محترمة؟

87
00:06:40,330 --> 00:06:43,670
من سينتقم لذلك الفتى بالضّبط؟

88
00:06:45,460 --> 00:06:49,760
القرية والشّرطة والجيش والحكومة
...وكلّ شيء آخر

89
00:06:50,260 --> 00:06:53,220
إن لم نفعل أيّ شيء، سيصير
.كلّ شيء كما يريده شيشيو ماكوتو

90
00:06:55,260 --> 00:06:59,020
.لذلك السّبب يحتاجون لك ولي الآن

91
00:07:01,980 --> 00:07:04,230
.أعرف أين هو قصر شيشيو

92
00:07:04,940 --> 00:07:07,440
،إنّه أقرب من كيوتو بعض الشّيء
ولكن هل نقابله هناك؟

93
00:07:09,780 --> 00:07:10,650
.نعم

94
00:07:11,530 --> 00:07:13,410
!مهلاً! سأذهب أيضًا

95
00:07:13,870 --> 00:07:15,330
.لا يمكنك مرافقتنا

96
00:07:15,330 --> 00:07:16,280
.ابقي هنا

97
00:07:16,280 --> 00:07:20,160
لماذا؟ لا أستطيع حتّى مسامحة
!أيّ أحد يقوم بمثل تلك الأمور

98
00:07:20,660 --> 00:07:21,580
.ميساو-دونو

99
00:07:21,660 --> 00:07:23,370
—ماذا؟ مهما كان ما ستقوله

100
00:07:23,370 --> 00:07:24,540
...أريدك

101
00:07:25,000 --> 00:07:27,000
.أن تظلّي إلى جانب إيجي

102
00:07:31,090 --> 00:07:32,180
.مفهوم

103
00:07:34,180 --> 00:07:36,260
!أعتذر بشدّة

104
00:07:36,260 --> 00:07:42,100
تغلغل هيمورا باتّوساي في غابة
!هاكوني فجأة وفقدنا أثره

105
00:07:42,690 --> 00:07:46,400
تمّ نشر الجميع للبحث عن
—مكانه، لذلك رجاءً

106
00:07:46,900 --> 00:07:48,780
ماذا نفعل يا شيشيو-سان؟

107
00:07:49,530 --> 00:07:51,690
.لا بأس. سأدع الأمر يمرّ

108
00:07:52,700 --> 00:07:55,740
أشعر بتحسّن بعد أوّل علاج
.بالمياه السّاخنة منذ ستّة أشهر

109
00:07:56,410 --> 00:07:59,910
أسرعوا في العثور على الباتّوساي
.قبل أن أغيّر رأيي

110
00:08:00,160 --> 00:08:02,540
!شـ-شكرًا جزيلاً لك

111
00:08:02,830 --> 00:08:03,830
.مسرور لأجلك

112
00:08:05,040 --> 00:08:09,500
لكن في المرّة القادمة الّتي تفشل
.فيها، فلن أدع هذا يمرّ مرور الكرام

113
00:08:10,380 --> 00:08:11,260
!حا-حاضر

114
00:08:11,920 --> 00:08:13,220
!سيتا-ساما

115
00:08:13,510 --> 00:08:15,800
يا للجلبة. ماذا هنالك؟

116
00:08:15,800 --> 00:08:16,800
...في الحقيقة

117
00:08:20,060 --> 00:08:21,100
فعلاً؟

118
00:08:22,350 --> 00:08:24,020
.شيشيو-سان. شيشيو-سان

119
00:08:24,020 --> 00:08:26,940
.يا لهذا الضّجيج
ماذا هنالك هذه المرّة؟

120
00:08:27,310 --> 00:08:29,520
ثمّة رجل بندبة على شكل تقاطع
على خدّه الأيسر

121
00:08:29,900 --> 00:08:31,650
...وشرطيّ يحمل كاتانا

122
00:08:32,280 --> 00:08:34,950
.في طريقهما إلى هذا القصر

123
00:08:37,160 --> 00:08:38,320
.فهمت

124
00:08:38,830 --> 00:08:42,660
إذًا فهو يأخذ وقته ليأتي قبل
.أن أتوجّه لاستقباله

125
00:08:42,660 --> 00:08:44,290
...هذا هو المتوقّع من زميلي الأقدم

126
00:08:44,750 --> 00:08:47,500
.سوجيرو، اذهب وقابلهما

127
00:08:47,500 --> 00:08:48,330
.حاضر

128
00:08:48,330 --> 00:08:49,670
...وأيضًا

129
00:08:50,840 --> 00:08:53,840
.اطلب من سنكاكو الاستعداد للقتال

130
00:08:56,720 --> 00:08:57,640
.سنكاكو

131
00:08:58,390 --> 00:09:00,850
!سنكاكو! سنكاكو

132
00:09:02,810 --> 00:09:03,930
!سأقتله

133
00:09:04,810 --> 00:09:08,350
!سأقتل سنكاكو

134
00:09:09,020 --> 00:09:12,030
روروني كنشين
—اضطرابات كيوتو—

135
00:09:16,780 --> 00:09:20,410
لا بدّ أنّكما هيمورا باتّوساي-سان
.وسايتو هاجيمي-سان

136
00:09:21,580 --> 00:09:22,700
...هذا الصّوت

137
00:09:23,490 --> 00:09:24,950
.كن حذرًا يا سايتو

138
00:09:24,950 --> 00:09:27,460
.ذلك هو الرّجل الّذي اغتال أوكوبو-سان

139
00:09:27,460 --> 00:09:29,830
.ماذا؟ كفّ عن ذلك

140
00:09:29,830 --> 00:09:32,170
.أنا مجرّد مرشد اليوم

141
00:09:32,170 --> 00:09:35,220
.أتريان؟ لا أحمل أيّ أسلحة

142
00:09:35,970 --> 00:09:39,180
إنّ شيشيو-سان في انتظاركما
.في الغرفة الخلفيّة

143
00:09:39,720 --> 00:09:40,970
...لذلك تفضّلا

144
00:09:41,850 --> 00:09:45,850
لن يحدث أيّ شيء إن تصرّفنا
.بحذر شديد. لنذهب

145
00:09:54,480 --> 00:09:58,490
شيشيو-ساما، ما رأيك بشراب بعد الحمّام؟

146
00:09:59,610 --> 00:10:00,450
.لقد وصلا

147
00:10:02,370 --> 00:10:06,000
إذًا فأنت... هو شيشيو ماكوتو؟

148
00:10:12,880 --> 00:10:15,090
.بإمكانك إضافة عبارات تشريفيّة على الأقلّ

149
00:10:15,090 --> 00:10:16,840
.يا لك من زميلٍ أقدمٍ فظّ

150
00:10:17,880 --> 00:10:20,970
.لا داعي للقلق حيال الأمر
.إن عدم الاحترام متبادل

151
00:10:21,430 --> 00:10:23,930
أواثق من وقوفك هناك؟

152
00:10:23,930 --> 00:10:27,140
بالنّسبة للباتّوساي، فتلويحة سيف
.واحدة كافية للقضاء على شيشيو

153
00:10:27,640 --> 00:10:28,730
.لا بأس

154
00:10:29,190 --> 00:10:33,570
ما كان هيمورا-سان ليقوم
،بتصرّف قذر مثل إيقاعه في فخّ

155
00:10:33,570 --> 00:10:34,940
.على عكسك أنت

156
00:10:36,690 --> 00:10:38,530
.نحن كالكتاب المفتوح له

157
00:10:42,490 --> 00:10:44,990
إلى أين أنت ذاهب بذلك الشّيء؟

158
00:10:45,490 --> 00:10:46,700
.إلى قصر شيشيو

159
00:10:47,200 --> 00:10:48,200
.سأحظى بانتقامي

160
00:10:48,410 --> 00:10:51,040
ما الّذي تقوله؟
!ذلك مستحيل بالنّسبة لشخص مثلك

161
00:10:51,040 --> 00:10:52,960
!إنّها ليست مسألة مستحيل أو ممكن

162
00:10:53,290 --> 00:10:54,880
!بل إمّا أن أفعل أو لا أفعل

163
00:10:58,550 --> 00:10:59,470
!انتظر

164
00:11:01,090 --> 00:11:03,050
.سأساعدك

165
00:11:04,850 --> 00:11:08,220
.آسفة يا هيمورا. سأساعد هذا الفتى

166
00:11:09,140 --> 00:11:13,440
،إن كان الأونيوابانشو قد قُتلوا

167
00:11:13,940 --> 00:11:16,690
!فسأسعى للانتقام أيضًا وإن قتلني ذلك

168
00:11:18,190 --> 00:11:19,940
.إيّاك أن تعترضي طريقي

169
00:11:25,450 --> 00:11:27,290
لماذا استهدفت هذه القرية؟

170
00:11:28,040 --> 00:11:33,250
،أنت تسعى خلف البلاد بأكملها
.وليس قرية أوقريتين فحسب

171
00:11:35,960 --> 00:11:36,840
.الينابيع السّاخنة

172
00:11:38,210 --> 00:11:40,840
.المياه هنا مفيدة جدًّا لجسدي

173
00:11:41,220 --> 00:11:45,010
لكن إذا رآني روّاد العلاج بالينابيع السّاخنة
الآخرون، فسيخافون، أليس كذلك؟

174
00:11:45,430 --> 00:11:47,560
.لذلك السّبب جعلته لي بالكامل

175
00:11:48,060 --> 00:11:53,190
أفسدتَ قرية بأكملها من أجل ذلك السّبب؟

176
00:11:56,560 --> 00:11:58,360
.كنت أمزح. أمزح فحسب

177
00:12:01,860 --> 00:12:05,280
تمامًا كما تقول عنك الشّائعات، يبدو
.أنّ لديك شخصيّة جدّيّة بشكل سخيف

178
00:12:05,490 --> 00:12:08,330
.يا له من استفزاز رخيص
.لا تأخذ الأمر على محمل الجدّ

179
00:12:08,830 --> 00:12:13,920
اخترتُ هذه القرية لاستعمالها
.كمعقل للاستيلاء على منطقة توكاي

180
00:12:13,920 --> 00:12:17,630
.لكنّي أحبّ الينابيع السّاخنة هنا بالفعل

181
00:12:17,630 --> 00:12:18,460
—شيشيو

182
00:12:18,460 --> 00:12:19,800
.لا تقل كلمة واحدة

183
00:12:20,170 --> 00:12:24,510
إذًا فأنت تؤسّس قاعدة لك
،هنا للانتقام من حكومة ميجي

184
00:12:24,760 --> 00:12:26,340
أيّها الشّابّ المغطّى بالضّمادات؟

185
00:12:26,850 --> 00:12:31,470
،يا قائد الوحدة الثّالثة من الشّينسنغومي
.سايتو هاجيمي-سان

186
00:12:32,140 --> 00:12:35,190
،طباعك أقرب إلى طباعي من طِباع الباتّوساي

187
00:12:35,190 --> 00:12:37,520
.لذلك ظننتُ أنّك ستكون متفهّمًا أكثر

188
00:12:37,520 --> 00:12:39,110
.لكن يبدو أنّك لستَ كذلك

189
00:12:40,020 --> 00:12:45,740
لا رغبة لي إطلاقًا في الانتقام من الأشخاص
.الّذين سبّبوا لي هذه الجروح

190
00:12:46,320 --> 00:12:48,070
.في الحقيقة، أنا أقدّرهم

191
00:12:48,830 --> 00:12:52,700
علّمتني هذه الجروح أشياء
.عديدة تغلغلت داخل جسدي

192
00:12:53,290 --> 00:12:55,500
".تقود الثّقة إلى الخيانة"

193
00:12:55,500 --> 00:12:57,830
".أرخِ دفاعك، وستُقتل"

194
00:12:57,830 --> 00:12:59,670
".اقتل قبل أن تُقتل"

195
00:13:00,250 --> 00:13:07,800
أضيفا لذلك، "ستنجذب النّساء
."إلى الرّجل الجيّد مهما كان مظهره

196
00:13:08,010 --> 00:13:09,140
.فهمت

197
00:13:09,640 --> 00:13:12,140
إذًا هلاّ أغلقت فمك وأرحتنا؟

198
00:13:12,520 --> 00:13:16,980
من المتعب جدًّا السّفر
.عبر اليابان فقط من أجلك أنت

199
00:13:17,480 --> 00:13:19,980
أغلق فمي؟

200
00:13:20,730 --> 00:13:25,700
،أنت وأنا وزميلي الأقدم
.عشنا جميعًا في نفس حقبة باكوماتسو

201
00:13:26,150 --> 00:13:30,700
.عشتما في أوقات الشّغف هذه
كيف لا تستطيعان أن تفهما ما أشعر به؟

202
00:13:32,580 --> 00:13:34,660
.احترام الإمبراطور. هزيمة الشّوغونيّة

203
00:13:34,660 --> 00:13:36,960
.استبعاد الأجانب. فتح الموانئ

204
00:13:36,960 --> 00:13:38,580
وصارت باكوماتسو في النّهاية

205
00:13:38,580 --> 00:13:44,010
أوّل حقبة مضطربة منذ 300 سنة
.منذ حقبة سنغوكو

206
00:13:44,630 --> 00:13:46,550
...ساتسوما وتوسا وتشوشو

207
00:13:47,050 --> 00:13:51,600
قاتلوا وقُتلوا كلّ يوم في هذه
،الحقبة الفوضويّة

208
00:13:54,600 --> 00:13:57,310
،إن حدث ووُلد المرء في حقبة كهذه

209
00:13:58,100 --> 00:14:01,900
فلن يكون رجلاً ما لم يكن مسعاه
.الهيمنة على العالم بأكمله

210
00:14:07,320 --> 00:14:09,320
،ولكن مهلاً. كدتُ أتعرّض للاغتيال

211
00:14:09,320 --> 00:14:12,330
،وعندما عدتُ بعد شفاء جراحي
...كانت الاضطرابات قد انتهت

212
00:14:12,780 --> 00:14:16,830
.وتمّ إنشاء هذا الشّيء المسمّى حكومة ميجي

213
00:14:17,160 --> 00:14:20,960
لا يمكنهم حتّى إرسال قوّات
،لقتل رجل شبه ميت

214
00:14:20,960 --> 00:14:25,130
.لأنّهم قلقون من عيون الغرب

215
00:14:25,130 --> 00:14:27,170
.يا لها من حكومة ضعيفة

216
00:14:27,760 --> 00:14:30,720
لا يمكنني السّماح لأشخاص مثلهم
.بأن يحكموا هذه البلاد

217
00:14:31,470 --> 00:14:32,720
...لذلك

218
00:14:33,100 --> 00:14:37,020
!إن انتهت الاضطرابات، فسأبدأ أخرى جديدة

219
00:14:37,520 --> 00:14:40,060
!وهذه المرّة، سأكون المسيطر

220
00:14:40,400 --> 00:14:43,520
!ثمّ سأجعل البلاد أقوى

221
00:14:44,400 --> 00:14:48,610
.تلك هي "العدالة" الّتي سأجلبها لليابان

222
00:14:49,400 --> 00:14:52,870
ولكن، أولئك الّذين ستُراق دماؤهم
..."من أجل هذه "العدالة

223
00:14:53,580 --> 00:14:56,660
.هم الأشخاص الّذين يعيشون بسلام في الحاضر

224
00:14:58,000 --> 00:14:59,210
.شيشيو ماكوتو

225
00:15:00,210 --> 00:15:05,920
لا يمكنني السّماح بإراقة دماء المزيد
.من النّاس من أجل "عدالتك" وحدها

226
00:15:08,130 --> 00:15:10,130
سايتو-سان، ماذا عنك؟

227
00:15:10,430 --> 00:15:14,180
إنّ امتلاك أحلام مثاليّة مثله
.ليست من هواياتي

228
00:15:14,680 --> 00:15:18,810
لكن يبدو أنّ ما يُناسبني أكثر هو التّواجد
.في الجانب الّذي سيطيح بشيشيو

229
00:15:19,100 --> 00:15:22,400
.لا أمانع القتال إن كنتُ مضطرًّا لذلك

230
00:15:22,400 --> 00:15:26,360
إن كنتُ سأقاتل، فأفضّل القيام بذلك
.في مدينة كيوتو المذهلة

231
00:15:26,360 --> 00:15:29,150
...ولكن إن كنتما مصرّين

232
00:15:34,870 --> 00:15:41,660
،فستواجهانني أنا سنكاكو
!حاكم قرية شينغتسو هذه

233
00:15:43,040 --> 00:15:44,380
.فهمت

234
00:15:44,380 --> 00:15:45,920
...أنت هو سنكاكو إذًا

235
00:15:46,460 --> 00:15:50,050
.الّذي قتل والدَيْ إيجي وأخاه

236
00:15:55,090 --> 00:15:56,430
.إنّه سريع

237
00:15:56,550 --> 00:15:57,390
!بطيء

238
00:16:00,390 --> 00:16:03,060
يا إلهي. كان ذلك مخيّبًا للآمال
.أكثر ممّا توقّعت

239
00:16:04,600 --> 00:16:07,520
!إنّ هيمورا باتّوساي لا يستحقّ أن نخشاه

240
00:16:08,730 --> 00:16:10,740
.قطعتُ وعدًا لإيجي لو سمحت

241
00:16:11,820 --> 00:16:16,070
!لذلك سأبدأ بهزيمتك أنت قبل شيشيو

242
00:16:17,870 --> 00:16:18,700
...هزيمتي

243
00:16:19,240 --> 00:16:20,450
أنا؟

244
00:16:20,450 --> 00:16:21,290
.نعم

245
00:16:22,290 --> 00:16:23,500
!كم هذا ممتع

246
00:16:29,670 --> 00:16:33,380
.لقد قطعتُ 99 شخصًا حتّى الآن

247
00:16:33,380 --> 00:16:35,840
!ستكون أنت هدفي المائة

248
00:16:36,640 --> 00:16:39,890
‫99 فقط؟ هذا ليس رقمًا لتتفاخر به.

249
00:16:43,890 --> 00:16:46,150
.هذه هي "السّرعة المقدّسة" المشهورة

250
00:16:46,520 --> 00:16:51,150
،ولكن إن قارنّا بين سرعتهما
.فإنّ سنكاكو لن يتخلّف عن الرّكب

251
00:16:51,150 --> 00:16:51,990
!إليك هذه

252
00:16:54,700 --> 00:16:55,990
.تبًّا

253
00:16:56,200 --> 00:17:01,450
هل الهيتوكيري باتّوساي جبان
لا يمكنه إلاّ مهاجمة النّاس من الخلف؟

254
00:17:01,740 --> 00:17:03,620
...إن كان ذلك كلّ شيء

255
00:17:04,960 --> 00:17:06,250
.يمكنني القيام بالمثل

256
00:17:07,080 --> 00:17:09,630
.هذا أيضًا ليس أمرًا لتتفاخر به

257
00:17:09,750 --> 00:17:11,500
!سرعتانا متساوية

258
00:17:11,500 --> 00:17:14,630
!لكنّي أملك القوّة الّتي تفتقر لها أنت

259
00:17:16,470 --> 00:17:17,300
!سريع

260
00:17:17,300 --> 00:17:18,300
!شديد

261
00:17:18,300 --> 00:17:19,600
!قويّ

262
00:17:19,850 --> 00:17:22,060
!لا أملك أنا سنكاكو أيّ نقاط ضعف

263
00:17:22,060 --> 00:17:23,310
!خذ هذه

264
00:17:23,770 --> 00:17:26,270
...أسلوب سنكاكو

265
00:17:26,520 --> 00:17:27,980
!الضّربات الفارمة

266
00:17:35,150 --> 00:17:36,650
...أسلوب سنكاكو

267
00:17:36,990 --> 00:17:39,450
!المنجنيق البشريّ

268
00:17:49,170 --> 00:17:53,590
إلى متى ستواصل تفاديّ أيّها الباتّوساي؟

269
00:17:59,300 --> 00:18:00,760
!تنتقل في الأرجاء كثيرًا

270
00:18:02,390 --> 00:18:05,180
أتظنّ أنّ بإمكانك الهرب منّي للأبد؟

271
00:18:06,060 --> 00:18:08,560
.يبدو أنّ هيمورا-سان يواجه وقتًا عصيبًا

272
00:18:08,560 --> 00:18:11,190
.كان تحت الضّغط طوال هذا الوقت
.لم يهاجم ولو مرّة واحدة

273
00:18:11,650 --> 00:18:14,030
ما رأيك أن تساعده؟

274
00:18:14,030 --> 00:18:15,280
أتمازحني؟

275
00:18:15,280 --> 00:18:18,820
لا أرى أيّ فائدة من الكشف عن مهاراتي
.في المسايفة لشخص مثله

276
00:18:19,450 --> 00:18:20,530
.انظر

277
00:18:21,160 --> 00:18:25,250
كان يتحدّث بفخر مع ابتسامة
،سخرية على وجهه قبل قليل

278
00:18:25,250 --> 00:18:27,660
،لكن بمجرّد أن بدأت المعركة
.تغيّرت تعابير وجهه إلى ما تراه الآن

279
00:18:28,160 --> 00:18:32,000
إنّه يحاول الحصول على فكرة واضحة
.عن كلّ تفصيل صغير يفعله الباتّوساي

280
00:18:32,000 --> 00:18:35,380
قد يكون صريحًا، لكنّ الحذر
.منه ليس أمرًا يمكن الاستهانة به

281
00:18:35,960 --> 00:18:38,630
.وبالطّبع لاحظَ الباتّوساي نظراته إليه أيضًا

282
00:18:39,300 --> 00:18:43,930
لذلك السّبب لا يهاجم ويستدرج
.خصمه ليدمّر نفسه بنفسه

283
00:18:44,430 --> 00:18:45,560
يدمّر نفسه؟

284
00:18:49,640 --> 00:18:50,770
.حان الوقت

285
00:18:50,900 --> 00:18:51,730
!سُحقًا لك

286
00:18:51,730 --> 00:18:53,650
—لماذا لا تـ

287
00:19:00,320 --> 00:19:03,530
!سا-ساقي... كُسرت

288
00:19:04,030 --> 00:19:08,080
بما أنّك لم تقلّل من سرعتك
،وواصلت الانتقال من حركة لأخرى

289
00:19:08,080 --> 00:19:11,880
فإنّ حِملَ جسدك عندما تستدير
.تجاوز الحدّ بسرعة

290
00:19:12,000 --> 00:19:13,040
!مستحيل

291
00:19:13,040 --> 00:19:16,630
إن كنّا بنفس السّرعة، عليك أن تبلغ
حدودك أيضًا بما أنّك أضعف

292
00:19:16,630 --> 00:19:18,300
—في وقت أسرع منّي

293
00:19:18,300 --> 00:19:24,850
إنّ لجسدك الثّقيل حِملاً أعلى
.لأنّنا نتحرّك بنفس السّرعة

294
00:19:25,180 --> 00:19:27,060
!مستحيل! هذا مستحيل

295
00:19:27,060 --> 00:19:28,890
!لم يحد أيّ شيء كهذا من قبل

296
00:19:28,890 --> 00:19:30,980
—لماذا لسرعة قليلة مثل هذه أن

297
00:19:30,980 --> 00:19:31,810
.مغفّل

298
00:19:32,980 --> 00:19:36,230
.كان الباتّوساي يزيد من سرعته بشكل تدريجيّ

299
00:19:36,730 --> 00:19:40,360
،ولأنّك اعتقدت أنّ لك نفس سرعته

300
00:19:40,360 --> 00:19:42,450
.وقعت في الفخ مباشرة

301
00:19:43,530 --> 00:19:46,740
.تحدّثت عن قتلك لـ99 شخصًا

302
00:19:46,740 --> 00:19:49,750
.أرى أنّه قد قُرِّر أنّك الشّخص المائة

303
00:19:49,750 --> 00:19:54,130
فهمت. إنّ الجميع يفكّرون بكلّ
.تفصيل أثناء القتال

304
00:19:58,130 --> 00:20:00,260
!كذب! كان ذلك كذبًا! لم يحدث ذلك

305
00:20:00,260 --> 00:20:03,510
.كانت عبارة "99 شخصًا" مجرّد تلاعب بالكلمات

306
00:20:03,930 --> 00:20:07,510
لكنّك كنت الشّخص الّذي قتل
عائلة إيجي، صحيح؟

307
00:20:07,970 --> 00:20:08,850
...سنكاكو

308
00:20:09,720 --> 00:20:13,230
.لم أتوقّع أنّ تنتصر منذ البداية

309
00:20:13,650 --> 00:20:17,940
لكنّ الخسارة في مواجهته دون دفعه
...للكشف عن حركة واحدة على الأقلّ

310
00:20:18,440 --> 00:20:22,150
.ستجعلني أضع حدًّا لحياتك بنفسي

311
00:20:29,540 --> 00:20:32,620
...أسلوب سنكاكو السّرّيّ

312
00:20:35,000 --> 00:20:39,340
!المنجنيق البشريّ الخارق

313
00:20:43,470 --> 00:20:44,840
...أسلوب هيتن ميتسوروغي

314
00:20:51,770 --> 00:20:53,020
!وميض التّنّين المحلّق

315
00:21:09,120 --> 00:21:13,000
.احمل سيفك يا شيشيو ماكوتو

316
00:22:45,960 --> 00:22:50,970
:الحلقة القادمة
إلى كيوتو مرّة أخرى

317
00:22:47,670 --> 00:22:50,300
."في الحلقة القادمة: "إلى كيوتو مرّة أخرى