1
00:00:12,510 --> 00:00:13,770
!معلّمي

2
00:00:15,030 --> 00:00:17,450
إنّ وميض التّنّين الطّائر المقدّس

3
00:00:17,660 --> 00:00:20,400
.هي التّقنية الأقوى في أسلوب ميتسوروغي

4
00:00:20,780 --> 00:00:23,830
أنا أيضًا حصلتُ عليها على حساب

5
00:00:23,960 --> 00:00:25,920
.حياة سلفي

6
00:00:26,620 --> 00:00:28,030
،وبصفتّي معلّمًا

7
00:00:28,260 --> 00:00:30,880
.ما عاد لي أيّ شيء لأعلّمك إيّاه

8
00:00:32,410 --> 00:00:34,840
،سيكون عليك بدءًا من الآن أيّها الرّوروني

9
00:00:35,160 --> 00:00:36,260
...أن تواصل

10
00:00:42,060 --> 00:00:43,520
...معلّمي

11
00:00:51,710 --> 00:00:53,340
.لا بدّ أنّه يمزح

12
00:00:53,870 --> 00:00:56,000
حتّى في سنّه هذه، فهو أقوى بكثير

13
00:00:56,410 --> 00:01:00,280
من أن تتمّ الإطاحة به بضربة
.ساكاباتو بسيطة

14
00:01:20,290 --> 00:01:21,760
.سأنقذه

15
00:01:23,370 --> 00:01:25,320
!لا يجب أن يموت هكذا

16
00:03:03,580 --> 00:03:04,570
!ها هو ذا

17
00:03:04,990 --> 00:03:07,770
،أكلتُ فطر قرطوب كاد يقتلني

18
00:03:07,890 --> 00:03:09,910
.وأعدّ لي هذا العلاج

19
00:03:10,430 --> 00:03:14,420
.لا وقت لإحضار طبيب من أسفل الجبل

20
00:03:15,010 --> 00:03:16,420
عليّ أن أعتمد

21
00:03:16,580 --> 00:03:19,680
.على قوّة معلّمي وهذه الجرعة

22
00:03:23,840 --> 00:03:25,020
...معلّمي

23
00:03:28,110 --> 00:03:29,480
.لقد عدت

24
00:03:29,990 --> 00:03:31,020
!ها أنت يا فتى

25
00:03:31,350 --> 00:03:33,650
.ما الّذي حدث؟ تبدين غاضبة

26
00:03:33,790 --> 00:03:36,150
أين كنت طوال هذا الوقت؟

27
00:03:37,750 --> 00:03:42,010
.معنويّات الجميع منخفضة لبقائهم محاصرين هنا

28
00:03:42,180 --> 00:03:45,570
.لذلك خرجتُ لشراء مأكولات تتميّز بها كيوتو

29
00:03:45,960 --> 00:03:49,060
أذلك هو سبب اختفائك لثلاثة أيّام؟

30
00:03:49,200 --> 00:03:51,330
.لم أعرف ما الّذي أختاره

31
00:03:52,930 --> 00:03:54,140
هل من مشكلة؟

32
00:03:54,900 --> 00:03:59,280
.وصل أوسوي أثناء غيابك
!لقد مررنا بالكثير

33
00:03:59,430 --> 00:04:02,180
وماذا فعلت؟

34
00:04:03,160 --> 00:04:06,060
.مرحبًا يا أوسوي-سان. لم أرك منذ مدّة

35
00:04:06,200 --> 00:04:07,720
أتريد بعض الحلويّات؟

36
00:04:18,240 --> 00:04:19,900
أهي ياتسوهاتشي؟

37
00:04:21,650 --> 00:04:22,860
.بالضّبط

38
00:04:23,410 --> 00:04:25,030
.مذهل كعادتك يا أوسوي-سان

39
00:04:25,600 --> 00:04:28,280
،في كلّ مرّة تترك فيها شيشيو

40
00:04:28,420 --> 00:04:32,110
.يكون ذلك لأجل مهمّة ما

41
00:04:32,250 --> 00:04:34,790
.وليس لشراء الحلويّات

42
00:04:35,430 --> 00:04:37,310
،بفضل عين الرّوح شينغان خاصّتي

43
00:04:37,450 --> 00:04:40,980
.أستطيع قراءة أفكار أيّ أحد

44
00:04:41,130 --> 00:04:45,070
حتّى بالنّسبة لأكثر العقول اضطرابًا

45
00:04:45,200 --> 00:04:47,510
.مثل عقلك أنت

46
00:04:48,110 --> 00:04:49,070
فعلاً؟

47
00:04:53,520 --> 00:04:54,640
...ولكن

48
00:04:55,470 --> 00:04:58,260
،مهما كان ما تخطّط له

49
00:04:58,390 --> 00:05:01,110
.فهو ليس من شأني

50
00:05:02,660 --> 00:05:05,190
.بالمناسبة، كدت أنسى

51
00:05:05,580 --> 00:05:09,510
تمّ استدعاء السّيوف العشرة
.للقاعة الكبرى بشكل طارئ

52
00:05:09,640 --> 00:05:13,420
.وصل آخر ثلاثة إلى هنا سلفًا

53
00:05:15,680 --> 00:05:17,980
.مرحبًا يا كاماتاري-سان

54
00:05:19,290 --> 00:05:22,400
.هذا أنت يا سو-تشان! سررت بلقائك

55
00:05:24,560 --> 00:05:27,380
.وسررت بلقائك أنت أيضًا يا يومي-سان

56
00:05:28,800 --> 00:05:32,280
دعينا نكتشف أخيرًا من منّا بإمكانه

57
00:05:32,430 --> 00:05:34,060
.الفوز بقلب شيشيو-ساما

58
00:05:34,460 --> 00:05:36,180
.بكلّ سرور

59
00:05:36,660 --> 00:05:40,400
.وكأنّي قد أخسر في مواجهة رجل مثلك

60
00:05:42,640 --> 00:05:45,230
.إنّ شعف الشّباب جميل بالفعل

61
00:05:45,380 --> 00:05:46,980
.الشّيخ سايزوتشي

62
00:05:49,440 --> 00:05:51,820
.تبدو في صحّة جيّدة

63
00:05:52,800 --> 00:05:55,900
.أنت الوحيد الّذي تبدو سعيدًا برؤيتي

64
00:05:56,040 --> 00:06:00,500
.يرفض البقيّة إلقاء نظرة أو تحيّة عليّ حتّى

65
00:06:00,690 --> 00:06:03,500
!حال شباب هذه الأيّام في انحدار

66
00:06:03,840 --> 00:06:09,200
لكن في الحقيقة، يشعرون جميعًا
.بالغيرة من قوّتي

67
00:06:11,340 --> 00:06:13,950
بالمناسبة، أين شريكك؟

68
00:06:14,800 --> 00:06:16,270
.بقي فوجي في الخارج

69
00:06:16,690 --> 00:06:20,880
.من المستحيل له أن يتّسع داخل المخبأ

70
00:06:21,350 --> 00:06:24,360
،عندما نكون أنا وهو جزءًا من جيش ما

71
00:06:24,500 --> 00:06:28,530
.لا يوجد عدوّ قد يشكّل تهديدًا لنا

72
00:06:28,670 --> 00:06:31,540
،وهذا يجعل من الضّعفاء مجرّد متفرّجين

73
00:06:31,680 --> 00:06:33,520
.وذلك هو سبب استيائهم

74
00:06:34,950 --> 00:06:37,050
.هكذا الأمر إذًا

75
00:06:39,860 --> 00:06:41,380
أهنالك خطب ما؟

76
00:06:41,520 --> 00:06:44,850
إن كنت لا أنظر إليك، فذلك ببساطة

77
00:06:44,990 --> 00:06:47,000
.لأنّي لستُ مهتمًّا بك

78
00:06:47,310 --> 00:06:48,970
...المعذرة يا هينيا-سان

79
00:06:49,110 --> 00:06:53,320
كان بإمكاني تجاهل ثرثرتك
،أيّها العجوز الخرِف

80
00:06:53,690 --> 00:06:55,670
.لكنّك أهنتني

81
00:06:56,080 --> 00:06:59,640
.أنت هو الضّعيف أيّها العجوز

82
00:07:02,030 --> 00:07:03,960
.لا أنصحك بإسماعي لمثل هذا الكلام

83
00:07:04,100 --> 00:07:08,940
هل أنت من النّوع الّذي يتفاخر
للتّغطية عن ضعفه؟

84
00:07:09,630 --> 00:07:13,450
إن اعتذرتَ منّي، فقد تعيش
.لعُمر أطول ممّا عشتَه حتّى الآن

85
00:07:13,750 --> 00:07:17,950
.سأنقش هذه الكلمات على شاهد قبرك

86
00:07:26,680 --> 00:07:27,660
.هذا يكفي

87
00:07:29,200 --> 00:07:31,400
...ستكون التّالي إن تدخّلت

88
00:07:31,820 --> 00:07:34,090
.قلتُ هذا يكفي

89
00:07:35,220 --> 00:07:36,680
.امتنعوا رجاءً عن أيّ شجار

90
00:07:36,820 --> 00:07:38,970
سيخيب ظنّ شيشيو-سان

91
00:07:39,100 --> 00:07:42,930
.إن تقاتلنا فيما بيننا في يوم لمّ شملنا

92
00:07:43,080 --> 00:07:44,770
أتريدون حلويّات؟

93
00:07:46,990 --> 00:07:49,930
من الأفضل ترك الأمر على هذا
.الحال أيّها الشّيخ سايزوتشي

94
00:07:50,280 --> 00:07:51,900
.ما باليد حيلة

95
00:07:57,260 --> 00:07:58,470
.لقد هدأ

96
00:08:00,030 --> 00:08:02,320
.شكرًا جزيلاً يا أنجي-سان

97
00:08:02,460 --> 00:08:05,500
.فعلتُ ما كان يجب عليّ فعله فحسب

98
00:08:06,060 --> 00:08:07,630
.لنهدأ جميعًا

99
00:08:07,770 --> 00:08:09,050
.اخرس

100
00:08:12,590 --> 00:08:15,290
.جيّد! يبدو أنّ الجميع هنا

101
00:08:18,940 --> 00:08:22,340
.آسف يا شيشيو-سان على غيابي لثلاثة أيّام

102
00:08:22,480 --> 00:08:23,320
.لا بأس

103
00:08:23,470 --> 00:08:24,970
.أحضرتُ هذه معي

104
00:08:25,100 --> 00:08:28,360
.ليس الآن يا سوجيرو. الأولويّة للاجتماع

105
00:08:28,500 --> 00:08:30,020
.إنّها لذيذة

106
00:08:44,800 --> 00:08:46,420
.شكرًا جزيلاً لك

107
00:08:46,780 --> 00:08:48,500
.سأستمتع بها لاحقًا

108
00:08:50,820 --> 00:08:53,170
.شكرًا لقدومكم من أماكن بعيدة

109
00:08:53,360 --> 00:08:56,220
.وآسف على جعلكم تنتظرون

110
00:08:56,610 --> 00:09:00,330
.منع حدث ما تشو من التّواجد معنا

111
00:09:00,880 --> 00:09:04,790
.جميعنا هنا الآن فيما عداه

112
00:09:06,310 --> 00:09:07,880
،إنّ من يحبّونني

113
00:09:08,440 --> 00:09:10,650
،وأولئك الّذين يسعون لموتي

114
00:09:11,040 --> 00:09:13,560
،والمحبطين من حكومة ميجي

115
00:09:14,360 --> 00:09:17,840
...وأولئك الّذين لديهم ثقة مطلقة في قوّتهم

116
00:09:20,180 --> 00:09:22,430
،لكلّ واحد منهم نواياه وخططه الخاصّة

117
00:09:22,620 --> 00:09:26,340
.لكنّنا سنبدأ التّحرّك معًا

118
00:09:28,370 --> 00:09:31,880
،غدًا ليلاً قبل دقيقة من منتصف اللّيل

119
00:09:32,070 --> 00:09:34,940
.سنضرم النّيران في كيوتو

120
00:09:39,630 --> 00:09:41,220
هل من اعتراضات؟

121
00:09:45,870 --> 00:09:46,950
.لا اعتراضات

122
00:09:55,720 --> 00:09:57,860
.هذا الوحش ليس بشرًا

123
00:09:58,020 --> 00:10:01,980
ستُدمَّر كيوتو في لمح البصر
.إن أُطلق العنان لقوّته

124
00:10:02,120 --> 00:10:03,330
أليس كذلك يا توكوجي؟

125
00:10:03,550 --> 00:10:06,540
.قوّة كلّ واحد من السّيوف العشرة وحشيّة

126
00:10:06,690 --> 00:10:09,210
.من الأفضل تفادي الاقتراب منهم كثيرًا

127
00:10:09,360 --> 00:10:10,640
.هذا صحيح

128
00:10:10,790 --> 00:10:13,500
،أنا جاهز للموت تنفيذًا لأوامر شيشيو-ساما

129
00:10:13,650 --> 00:10:16,510
.لكن ليس هباءً على يد أوسوي

130
00:10:16,750 --> 00:10:18,420
!يا شوزو

131
00:10:22,430 --> 00:10:26,240
غويتشي، قلتَ أنّك من كيوتو، صحيح؟

132
00:10:26,380 --> 00:10:27,220
.نعم

133
00:10:27,440 --> 00:10:28,940
ألا يزعجك هذا؟

134
00:10:29,370 --> 00:10:31,420
.ستلتهم النّيران المدينة ليلة الغد

135
00:10:31,840 --> 00:10:34,150
.سأتجاوز ذلك يا توجيرو-سان

136
00:10:34,540 --> 00:10:37,430
.ذهبت أمّي إلى الجبال

137
00:10:37,800 --> 00:10:38,910
ووالدك؟

138
00:10:39,040 --> 00:10:41,990
.لقد قُتل أثناء اضطرابات فترة الإصلاح

139
00:10:42,130 --> 00:10:43,270
.هكذا إذًا

140
00:10:45,610 --> 00:10:48,580
!الإصلاح، النّظام الجديد... مجرّد هراء

141
00:10:48,770 --> 00:10:53,050
.تغيّرت مقاليد السّلطة، لكن لم تتحسّن أوضاعنا

142
00:10:53,180 --> 00:10:57,960
وحدهم جماعة صغيرة من النّاس
.من يعيشون حياة هانئة

143
00:10:58,200 --> 00:11:01,590
لذلك فإنّ الأمر منوط بنا نحن
.لبناء حقبة جديدة

144
00:11:01,960 --> 00:11:04,140
!حان وقت ثورتنا

145
00:11:30,700 --> 00:11:33,020
!هذا رائع بالفعل

146
00:11:33,520 --> 00:11:35,010
.كنتُ أبحث عنك

147
00:11:35,140 --> 00:11:38,800
.احرص على إبلاغ أحد ما عندما تخرج

148
00:11:40,040 --> 00:11:41,470
ماذا تريد منّي؟

149
00:11:41,740 --> 00:11:45,990
.أريد إبلاغك بإشاعة تدور في البلدة فحسب

150
00:11:46,140 --> 00:11:49,640
.يُقال أنّ العجوز من أوُيْيا قد عاد للحياة

151
00:11:50,610 --> 00:11:52,610
لماذا أتيت إلى هنا لإخباري؟

152
00:11:52,760 --> 00:11:54,800
.ظننتُ أنّ الأمر يقلق راحتك

153
00:11:55,460 --> 00:11:58,880
.هدفي الوحيد هو قتل الباتّوساي

154
00:11:59,350 --> 00:12:01,640
.ولا يهمّني أيّ شيء آخر

155
00:12:04,210 --> 00:12:05,230
وأنت؟

156
00:12:05,370 --> 00:12:06,220
عفوًا؟

157
00:12:06,810 --> 00:12:09,280
ما سبب اتّباعك لذلك الرّجل؟

158
00:12:11,540 --> 00:12:14,760
تتحدّث عن شيشيو-سان، أليس كذلك؟

159
00:12:16,250 --> 00:12:17,380
.نعم

160
00:12:20,140 --> 00:12:21,460
...هدفي

161
00:12:25,830 --> 00:12:26,800
ماذا هنالك؟

162
00:12:29,120 --> 00:12:30,100
.لا شيء

163
00:12:32,510 --> 00:12:34,840
،ربّما لا يكون لديّ هدف

164
00:12:35,230 --> 00:12:36,400
.في نهاية المطاف

165
00:12:37,550 --> 00:12:39,400
!يومي-سان

166
00:12:41,080 --> 00:12:43,260
هل صحيح أنّ تشو قد اعتُقل؟

167
00:12:43,410 --> 00:12:46,300
صحيح. على الأرجح أنّه يتذمّر
.في السّجن الآن

168
00:12:47,270 --> 00:12:48,780
لماذا لا يهرب؟

169
00:12:48,940 --> 00:12:53,410
.ما أدراني؟ ربّما وضعوا له حارسًا قويًّا

170
00:12:54,830 --> 00:12:56,030
.هذا مؤسف

171
00:12:56,160 --> 00:13:01,640
عجبًا. من النّادر أن يثير رجل آخر
.غير شيشيو-ساما اهتمامك

172
00:13:01,800 --> 00:13:03,360
هل أشمّ رائحة خيانة؟

173
00:13:03,500 --> 00:13:06,460
.غبيّة! بالطّبع لا

174
00:13:06,600 --> 00:13:11,180
كانت المعركة لتكون أسهل
.بكثير بوجود تشو فحسب

175
00:13:11,800 --> 00:13:13,440
لِمَ أسهل؟

176
00:13:13,670 --> 00:13:16,600
.لنقل أنّ ذلك كان ليوفّر عليّ التّفكير الزّائد

177
00:13:16,760 --> 00:13:21,400
إنّ ضمير المرء قد يعرقله
.في بعض الأحيان خلال المعركة

178
00:13:21,600 --> 00:13:23,570
.وهذا يعقّد الأمور

179
00:13:24,780 --> 00:13:28,350
.إنّه لا يشفق على النّساء والأطفال إطلاقًا

180
00:13:29,220 --> 00:13:30,520
.لا يهمّ على أيّ حال

181
00:13:30,790 --> 00:13:35,750
سأبذل كلّ ما في وسعي للحصول
!على انتباه شيشيو-ساما

182
00:13:35,890 --> 00:13:37,510
.إلى اللّقاء

183
00:13:40,960 --> 00:13:43,840
.إنّ اللّحظة المنتظرة تدنو منّا يا شيشيو-ساما

184
00:13:43,990 --> 00:13:45,050
.نعم

185
00:13:45,720 --> 00:13:48,530
.ستتغيّر كيوتو بالكامل في ظرف يوم واحد

186
00:13:48,700 --> 00:13:51,170
.وكذلك اليابان في ظرف أيّام قليلة

187
00:13:51,700 --> 00:13:53,350
.أرى بعض الحماسة في الأفق أخيرًا

188
00:13:53,480 --> 00:13:54,930
!شيشيو-ساما

189
00:13:55,070 --> 00:13:56,500
.لا تبكِ، ذلك مزعج

190
00:13:56,620 --> 00:13:57,570
!حاضر

191
00:13:57,700 --> 00:13:59,720
.مع أننا لم نبدأ بعد حتّى

192
00:13:59,860 --> 00:14:01,520
.حاضر، حاضر

193
00:14:01,910 --> 00:14:03,360
...ولكن –
نعم؟ –

194
00:14:03,960 --> 00:14:06,690
...إن كان هنالك ما أندم عليه

195
00:14:33,930 --> 00:14:35,120
...معلّمي

196
00:14:43,760 --> 00:14:46,610
.حسنًا، سأتركك الآن. سأذهب إلى العيادة

197
00:14:49,310 --> 00:14:51,400
أواثقة أنّك بخير؟

198
00:14:51,540 --> 00:14:53,200
ماذا؟ لماذا؟

199
00:14:58,170 --> 00:15:00,330
هل ستخرجين يا ميغومي-سان؟

200
00:15:00,470 --> 00:15:01,370
.نعم

201
00:15:01,510 --> 00:15:02,420
.أتمنّى لك يومًا طيّبًا

202
00:15:03,190 --> 00:15:04,760
.ميساو-تشان

203
00:15:06,120 --> 00:15:08,860
أيمكنك الذّهاب للحديث معها؟

204
00:15:11,360 --> 00:15:13,800
.من الخطير التّحديق بشرود أمام نافذة

205
00:15:14,170 --> 00:15:17,900
.قد يستهدفك العدوّ في أيّ لحظة

206
00:15:18,080 --> 00:15:19,220
...ميساو-تشان

207
00:15:19,420 --> 00:15:23,030
.لا تقولي "ميساو"! صرت أُعرف بالقائدة الآن

208
00:15:25,130 --> 00:15:29,330
أتمنّى أن يعود هيمورا قريبًا
.وقد تعلّم كلّ الأسرار

209
00:15:32,000 --> 00:15:33,040
.آسفة

210
00:15:33,310 --> 00:15:36,500
.لديك ما يكفي لتقلقي بشأنه يا ميساو-تشان

211
00:15:36,620 --> 00:15:38,870
.لا، لا. لا تقلقي حيالي

212
00:15:39,290 --> 00:15:42,460
.لقد سُوّي كلّ شيء الآن

213
00:15:42,830 --> 00:15:46,400
.لذلك لا تتردّدي إن كان هنالك ما يزعجك

214
00:15:51,060 --> 00:15:54,170
.يحاول دائمًا أن يصير أقوى وأقوى

215
00:15:54,710 --> 00:15:57,890
.ذلك هو حال كلّ سيّاف

216
00:15:58,410 --> 00:16:01,310
،ولكن إن ورث كنشين التّقنية السّرّيّة الأقوى

217
00:16:01,600 --> 00:16:04,510
فعلى الأرجح أنّه قد يصير قادرًا
،على هزيمة جماعة شيشيو

218
00:16:04,830 --> 00:16:10,290
لكنّه يخاطر بخسارة المعركة ضدّ
الهيتوكيري الّذي دفنه عميقًا في داخله

219
00:16:10,420 --> 00:16:11,990
.لوقت طويل

220
00:16:12,380 --> 00:16:13,840
....وذلك هو

221
00:16:14,490 --> 00:16:15,330
.ما يُقلقني

222
00:16:20,460 --> 00:16:21,600
...كنشين

223
00:16:37,280 --> 00:16:39,720
هل انتهت قيلولتك؟

224
00:16:42,700 --> 00:16:45,830
ثمّة العديد من النّاس في انتظار عودتك

225
00:16:45,980 --> 00:16:47,520
.على أحرّ من الجمر

226
00:16:48,330 --> 00:16:50,020
،بدل إضاعة وقتك هنا

227
00:16:50,300 --> 00:16:52,480
.انزل إلى المدينة بسرعة

228
00:16:53,200 --> 00:16:55,450
!مـ... معلّمي

229
00:17:06,210 --> 00:17:08,130
.لا تقترب من معلّمك فجأة هكذا

230
00:17:09,410 --> 00:17:13,420
.لكنّي ممتنّ لهذا... لقد أدّى الدّواء مفعوله

231
00:17:14,640 --> 00:17:16,320
هل تقصد هذا المسحوق؟

232
00:17:16,560 --> 00:17:20,550
.إنّه مجرّد مزيج أعددتُه بنفسي بشكل عشوائيّ

233
00:17:20,700 --> 00:17:21,930
ماذا؟

234
00:17:23,120 --> 00:17:24,250
،في تلك الحالة

235
00:17:24,680 --> 00:17:26,520
كيف شفيت؟

236
00:17:27,180 --> 00:17:28,850
،إن كان عليّ أن أدين بذلك لأيّ شيء

237
00:17:29,360 --> 00:17:30,770
.فسيكون لهذا السّيف

238
00:17:31,530 --> 00:17:33,690
ساكاباتو شين-أوتشي؟

239
00:17:34,080 --> 00:17:35,190
.أمعن النّظر

240
00:17:35,750 --> 00:17:41,700
،لقد خرج الوتد المثبّت
.وبالكاد بإمكانه تثبيت النّصل

241
00:17:42,010 --> 00:17:45,660
لذلك السّبب ضعفت قوّة
وميض التّنّين الطّائر المقدّس

242
00:17:45,800 --> 00:17:49,670
لأنّه تمّ امتصاصها قليلاً
.من طرف السّيف بحدّ ذاته

243
00:17:50,020 --> 00:17:54,560
.إنّه سلاح جيّد يفهم ما يشعر به حامله

244
00:17:58,630 --> 00:18:00,200
...شاكّو-دونو

245
00:18:01,100 --> 00:18:04,760
،حسنًا، كلّ هذا نتيجة لعبقريّتي بشكل أساسيّ

246
00:18:04,880 --> 00:18:08,440
درّبتُك بشكل مثاليّ جعل سيفك
.يرتقي لمستويات أعلى

247
00:18:10,480 --> 00:18:12,540
،لم يكن الأمر سهلاً إطلاقًا

248
00:18:12,690 --> 00:18:15,100
.لكنّ تعليمك للتّقنية السّرّيّة الأقوى انتهى

249
00:18:17,500 --> 00:18:19,470
،كما رأيتَ للتّوّ

250
00:18:19,640 --> 00:18:22,790
تمنح تقنية وميض التّنّين الطّائر
،المقدّس قوّة تدميريّة ملحوظة

251
00:18:22,930 --> 00:18:25,330
.حتّى إن نُفّذت بواسطة نصل معكوس

252
00:18:25,680 --> 00:18:29,240
بدءًا من الآن، سيكون منوطًا بك كروروني

253
00:18:29,380 --> 00:18:31,050
أن تجعل التّقنية أكثر مثاليّة

254
00:18:31,190 --> 00:18:35,210
.عن طريق تعديل قوّتها وسرعتها كما ترغب

255
00:18:36,200 --> 00:18:37,090
.عُلم

256
00:18:39,540 --> 00:18:40,600
.ممتاز

257
00:18:41,810 --> 00:18:43,580
.حسنًا، كفانا إضاعة للوقت

258
00:18:43,720 --> 00:18:47,980
.انزل الجبل للانضمام لأولئك الّذين ينتظرونك

259
00:18:48,600 --> 00:18:49,480
.عُلم

260
00:18:52,410 --> 00:18:55,300
.حسنًا يا معلّمي، شكرًا على كلّ شيء

261
00:18:56,300 --> 00:18:57,280
.انتظر

262
00:18:59,960 --> 00:19:02,640
،تمّ توارث هذه العباءة من جيل لآخر

263
00:19:02,980 --> 00:19:07,950
.وهي علامة على معلّم أسلوب هيتن ميتسوروغي

264
00:19:08,360 --> 00:19:09,470
.خذها

265
00:19:10,270 --> 00:19:12,500
.أنت تستحقّها الآن

266
00:19:17,330 --> 00:19:18,920
.شكرًا لك، لكنّها لن تناسبني

267
00:19:19,070 --> 00:19:20,300
!أيّها الولد

268
00:19:20,460 --> 00:19:21,510
،معلّمي

269
00:19:21,950 --> 00:19:24,040
،مع أنّي تعلّمت التّقنية السّرّيّة الأقوى

270
00:19:24,240 --> 00:19:27,040
لا أنوي أن أرث اسم هيكو سيجورو

271
00:19:27,200 --> 00:19:30,120
.وأصير حامله الرّابع عشر

272
00:19:30,550 --> 00:19:32,110
...ورثت فقط

273
00:19:32,470 --> 00:19:35,230
.مبادئ أسلوب هيتن ميتسوروغي

274
00:19:36,020 --> 00:19:39,150
.توقّعتُ تفانيًا أكثر منك

275
00:19:42,130 --> 00:19:46,650
.مع أنّ أنانيّتك ليست أمرًا جديدًا

276
00:19:47,320 --> 00:19:49,330
.لديّ طلب آخر

277
00:19:49,760 --> 00:19:50,960
...أيمكنك خلال قتالي

278
00:19:51,370 --> 00:19:53,860
،ضدّ جماعة شيشيو

279
00:19:54,010 --> 00:19:56,660
أن تحمي أصدقائي في أوُيْيا؟

280
00:20:02,590 --> 00:20:05,310
.لا تستغلّ لُطفي

281
00:20:06,720 --> 00:20:10,170
،إن كنتَ لا تريد أن تخلفني

282
00:20:10,320 --> 00:20:13,000
.فما عدتَ تلميذي

283
00:20:13,150 --> 00:20:16,090
.تظاهر بأنّي لم أكن معلّمك أبدًا

284
00:20:16,240 --> 00:20:17,340
!معلّمي

285
00:20:19,440 --> 00:20:20,460
...ولكن

286
00:20:22,100 --> 00:20:25,100
أنا لم أعلّمك أسلوب هيتن ميتسوروغي

287
00:20:25,530 --> 00:20:29,080
.لأجعلك تعاني، فتذكّر ذلك جيّدًا

288
00:20:32,170 --> 00:20:34,420
.ليس عليك أن تقلق كثيرًا

289
00:20:34,860 --> 00:20:37,740
.أسرع واهزم شيشيو

290
00:20:38,760 --> 00:20:40,060
...معلّمي

291
00:20:43,410 --> 00:20:45,440
ما اسمك يا فتى؟

292
00:20:45,980 --> 00:20:47,220
شينتا؟

293
00:20:47,960 --> 00:20:51,600
.إنّه اسم ليّن جدًّا ليحمله سيّاف

294
00:20:52,500 --> 00:20:54,110
،بدءًا من اليوم

295
00:20:54,480 --> 00:20:56,230
.سيصير اسمك كنشين

296
00:20:58,530 --> 00:21:02,400
.سأعلّمك ما أعرف، ستصير وريثي

297
00:22:47,170 --> 00:22:50,580
."في الحلقة القادمة: "هدف آخر