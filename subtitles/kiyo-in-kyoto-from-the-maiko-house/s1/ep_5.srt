00:16:52,570 --> 00:16:54,910
لنبدأ بالجرف

198
00:16:55,490 --> 00:16:58,540
!يمكننا الانتهاء قبل دوام المدرسة

199
00:17:02,880 --> 00:17:05,670
شكراً يا سوميري وكينتا

200
00:17:05,670 --> 00:17:09,090
لمَ لا تأتي جرّافة الثلج إلى هنا؟

201
00:17:09,090 --> 00:17:12,340
!سأفعل كلّ ذلك بنفسي

202
00:17:12,340 --> 00:17:16,810
!تركتِ بعض الثلج المُتساقط للتو هنا

203
00:17:17,520 --> 00:17:19,480
السّرعة ليست كلّ شيء

204
00:17:19,810 --> 00:17:23,940
أنت منزعج فحسب لأنّك أبطأ منّي

205
00:17:24,270 --> 00:17:25,820
كلّا

206
00:17:25,820 --> 00:17:28,650
أفضّل أن أؤدّي عملي بإتقان

207
00:17:29,030 --> 00:17:31,780
أقطع كتلة من الثلج

208
00:17:31,780 --> 00:17:35,280
!ثمّ أغرفها كلّها

209
00:17:35,950 --> 00:17:39,290
مهّدتَ طريقاً نظيفاً جدّاً

210
00:17:39,290 --> 00:17:43,000
لكنّه عمل مُجهد جدّاً

211
00:17:43,500 --> 00:17:44,960
كيو؟

212
00:18:10,110 --> 00:18:14,030
!جرفتُ ثلجاً أكثر منك

213
00:18:14,030 --> 00:18:16,530
!قمتُ بعملي بإتقان أكبر

214
00:18:16,530 --> 00:18:19,160
!مستحيل

215
00:18:44,190 --> 00:18:46,600
شغّلتُ نار الفرن

216
00:18:46,600 --> 00:18:48,310
شكراً

217
00:18:48,310 --> 00:18:50,780
كيو، هل يمكنكِ إحضار العجينة؟

218
00:18:50,780 --> 00:18:51,530
!حاضر

219
00:18:53,110 --> 00:18:54,900
تفضّلي يا جدّتي

220
00:19:00,660 --> 00:19:03,120
دلّكيها جيّداً يا كيو

221
00:19:03,120 --> 00:19:04,120
حسناً

222
00:19:04,120 --> 00:19:06,370
مزّقيها ومدّيها

223
00:19:10,670 --> 00:19:15,630
حساء هيتسومي
(خضروات جذريّة ومعجّنات قمح في مرقة دجاج ساخنة جدّاً)

224
00:19:31,360 --> 00:19:34,490
هذا كلّ ما أريده بعد جرف الثلج

225
00:19:34,490 --> 00:19:35,990
!أتّفق

226
00:19:36,490 --> 00:19:38,740
كُلوا المزيد

227
00:19:38,740 --> 00:19:40,740
!حسناً

228
00:19:49,330 --> 00:19:50,340
الآن

229
00:19:51,290 --> 00:19:53,880
سأذهب لجرف بعض الثلج

230
00:20:00,970 --> 00:20:04,600
كيو في كيوتو: من بيت المايكو

231
00:20:09,020 --> 00:20:09,900
سوميري

232
00:20:11,270 --> 00:20:12,110
وكيو

233
00:20:12,400 --> 00:20:16,190
طبق اليوم

234
00:20:17,780 --> 00:20:22,740
يذكّرني حساء هيتسومي بالديار دوماً

235
00:20:22,740 --> 00:20:26,040
كنّا نأكله معاً بعد جرف الثلج

236
00:20:26,040 --> 00:20:30,040
لنراجع كيفيّة إعداد هيتسومي

237
00:20:30,040 --> 00:20:34,800
تعلّمتُ من مشاهدة جدّة كيو أيضاً

238
00:20:35,760 --> 00:20:38,680
نضيف خضروات الجذر إلى مرقة داشي

239
00:20:38,680 --> 00:20:42,050
ثمّ نطبخها على نار هادئة مع الساكي
وخمر الأرزّ وصلصة الصّويا

240
00:20:46,100 --> 00:20:49,480
عندما يجهز الحساء، نضيف العجينة

241
00:20:50,440 --> 00:20:54,150
نستخدم اليدين لشدّ ومدّ عجينة الطحين

242
00:20:54,150 --> 00:20:57,150
نمزّق قطعاً بأحجام صغيرة جدّاً ونضيفها

243
00:20:57,150 --> 00:21:00,950
ستكون الثّخانة غير متناسقة

244
00:21:01,740 --> 00:21:07,040
الاستمتاع بقوام ثخين ورقيق هو جزء من المرح

245
00:21:07,040 --> 00:21:10,540
نقدّمها عندما تُطبخ العجينة بالكامل

246
00:21:10,960 --> 00:21:16,420
الحساء السّاخن يدفئ الجسم والرّوح
في الأيّام الباردة

247
00:21:16,840 --> 00:21:20,550
لدى العديد من المناطق حساء خاصّ

248
00:21:20,550 --> 00:21:24,010
إنّها شهيّة في أيّام البرد تحديداً

249
00:21:24,930 --> 00:21:27,970
"أوّلاً، حساء تيبّو الخاص بهوكّايدو الشرقيّة"

250
00:21:28,850 --> 00:21:33,940
تيبّو تعني بندقيّة، والحساء هو"
"المُنكّه بميسو مع سلطعان

251
00:21:34,480 --> 00:21:38,820
"يتمّ التقاط لحم السلطعان بعيدان الطعام"

252
00:21:38,820 --> 00:21:42,660
"يبدو كتلقيم رصاص في سبطانة بندقيّة"

253
00:21:43,530 --> 00:21:47,790
حساء الميسو مع السمك المنفوخ"
"يدعى أيضاً حساء تيبّو

254
00:21:47,790 --> 00:21:53,460
"هذا لأنّ سمّ السمكة المنفوخة يمكن أن يكون قاتلاً"

255
00:21:49,660 --> 00:21:56,210
سمّ

256
00:21:53,460 --> 00:21:55,630
!يا له من شرور

257
00:21:56,290 --> 00:21:58,050
"فيما يلي، حساء سينبي الخاص بأوموري"

258
00:21:58,800 --> 00:22:02,680
"حساء فريد مع رقائق نانبو فيه"

259
00:22:02,680 --> 00:22:07,720
الرّقائق المنقوعة بالمرقة مليئة"
"بالنكهات مع قوام مميّز

260
00:22:07,720 --> 00:22:11,060
!تبدو الرّقائق المنقوعة بالنكهات لذيذة

261
00:22:11,850 --> 00:22:14,020
"التّالي، حساء ناتّو الخاص بياماغاتا"

262
00:22:14,650 --> 00:22:17,980
يحتوي حساء الميسو هذا على فول"
"الصّويا المُخمّر المفروم

263
00:22:17,980 --> 00:22:21,610
لا بدّ أنّه يفيض برائحة ناتّو

264
00:22:21,610 --> 00:22:23,490
!لا يُقاوم بالنسبة لعشّاق الناتّو

265
00:22:24,030 --> 00:22:28,200
"لدى كيوتو حساؤها الخاص، حساء إيتوكو"

266
00:22:29,330 --> 00:22:33,790
"يؤكل في مناسبات خاصّة في مناطق معيّنة من كيوتو"

267
00:22:33,790 --> 00:22:38,420
يحتوي على حبوب أزوكي وبطاطا"
"وخضروات جذريّة وجيلي كونياك

268
00:22:38,420 --> 00:22:42,470
إنّه حساء ميسو حلو بشكل مبهر

269
00:22:42,470 --> 00:22:46,260
"وهناك حساء إتشيغوني وحساء آخر يدعى ماميبو"

270
00:22:46,260 --> 00:22:49,350
"دونغارا ونوبّي من الشّمال"

271
00:22:49,350 --> 00:22:52,180
"...ميتّا ودوبو"

272
00:22:52,180 --> 00:22:56,190
"...تسوغاني وداغو وساتسوما من الجنوب"

273
00:22:56,190 --> 00:22:58,020
!لا أستطيع قراءتها كلّها

274
00:22:58,020 --> 00:23:03,320
النّاس من كلّ أنحاء اليابان تتناول الحساء كلّ يوم

275
00:23:03,320 --> 00:23:09,910
جميعنا نتشارك الشّعور الّذي يدفئ القلب
بعد تناول حساء ساخن

276
00:24:45,000 --> 00:24:55,010
انتظار رسالة
كريسمس في كاغاي
عشيّة العام الجديد في كاغاي

277
00:24:46,420 --> 00:24:49,340
كيو في كيوتو: من بيت المايكو

278
00:24:49,340 --> 00:24:52,600
!تابعونا من جديد في المرّة المقبلة

279
00:24:55,010 --> 00:25:00,020
كيو في كيوتو: من بيت المايكو