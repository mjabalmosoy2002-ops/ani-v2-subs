1
00:01:31,360 --> 00:01:35,200
،كي تعيش فتيات بيت المايكو بشكل جماعي

2
00:01:37,200 --> 00:01:40,960
كتابة الرّسائل هي وسيلة اعتياديّة للتواصل

3
00:01:43,210 --> 00:01:46,710
بما أنّهن لا يحملن هواتف خليويّة أو حواسيب

4
00:01:46,710 --> 00:01:49,420
لا يستطعن الاتّصال أو إرسال رسالة الكترونيّة

5
00:01:50,340 --> 00:01:52,170
!حبيب؟

6
00:01:52,170 --> 00:01:54,890
ظننتُهما انفصلا

7
00:01:54,890 --> 00:01:58,390
عادا معاً في هذه المكالمة

8
00:01:58,390 --> 00:02:03,350
،تستطيع المايكو استعمال هاتف البيت
لكن قد يكون ذلك غريباً

9
00:02:03,350 --> 00:02:06,360
الفصل 16 - انتظار رسالة

10
00:02:10,360 --> 00:02:12,570
رسائل الجميع

11
00:02:13,400 --> 00:02:15,240
ورسالتي

12
00:02:16,320 --> 00:02:17,240
!رائع

13
00:02:42,100 --> 00:02:44,350
!جدّتي، مرحباً

14
00:02:53,860 --> 00:02:56,360
كيو

15
00:03:00,620 --> 00:03:03,080
!كينتا

16
00:03:03,080 --> 00:03:05,660
لا بيسبول اليوم؟

17
00:03:05,660 --> 00:03:07,170
استراحة اختبار

18
00:03:07,170 --> 00:03:09,170
خذي، رسالة

19
00:03:09,170 --> 00:03:11,420
ادخل

20
00:03:11,420 --> 00:03:14,720
سأجرف الثّلج أوّلاً

21
00:03:19,220 --> 00:03:22,060
حسناً، حسناً

22
00:03:44,160 --> 00:03:46,370
كينتا؟ ما الأمر؟

23
00:03:46,370 --> 00:03:47,410
لا شيء

24
00:03:47,870 --> 00:03:49,500
ركّز

25
00:03:49,500 --> 00:03:50,670
حاضر

26
00:03:55,130 --> 00:03:57,590
كيو
سوميري

27
00:04:02,930 --> 00:04:04,520
شكراً

28
00:04:48,560 --> 00:04:50,810
من جديد يا كينتا؟

29
00:04:50,810 --> 00:04:51,940
لا شيء

30
00:04:54,270 --> 00:04:56,280
خطّ يد غريب

31
00:05:00,320 --> 00:05:02,820
جدّتي، انتهيت

32
00:05:02,820 --> 00:05:05,240
شكراً. هل بردت؟

33
00:05:05,240 --> 00:05:08,700
ماذا؟ لا أدري

34
00:05:11,670 --> 00:05:14,290
ابقَ بجانب الفرن

35
00:05:16,420 --> 00:05:19,380
!مرحى! كُرات أرزّ مشويّة

36
00:05:17,960 --> 00:05:23,930
ياكي أونيغيري
(كُرات أرزّ مشويّة كطعام خفيف)
(رائحة تحميص للميسو الحلو)

37
00:05:23,930 --> 00:05:28,060
قلّبها بعيدان الطعام إذا كانت ساخنة جدّاً

38
00:05:28,060 --> 00:05:29,180
لا مشكلة

39
00:05:32,900 --> 00:05:39,230
تقول كيو أنّها عائدة إلى الدّيار في
أوموري لعطلة العام الجديد

40
00:05:59,550 --> 00:06:01,470
خطّ يد غريب

41
00:06:04,840 --> 00:06:08,600
كيو في كيوتو: من بيت المايكو

42
00:06:12,810 --> 00:06:13,810
سوميري

43
00:06:15,020 --> 00:06:16,020
وكيو

44
00:06:16,310 --> 00:06:20,110
طبق اليوم

45
00:06:20,820 --> 00:06:23,530
دافئة من الخارج، ومنفوشة من الدّاخل

46
00:06:23,530 --> 00:06:25,990
كُرات الأرزّ المشويّة

47
00:06:25,990 --> 00:06:29,080
طعامي الخفيف في مُنتصف اللّيل في الدّيار

48
00:06:29,080 --> 00:06:34,290
أعتبر كُرات الأرزّ طبقاً رئيسيّاً، لكن
المشويّة منها طعاماً خفيفاً

49
00:06:34,290 --> 00:06:36,460
!أنا أيضاً

50
00:06:36,460 --> 00:06:41,670
كنتُ أتناول تلك التي تعدّها جدّة كيو
كطعام خفيف طوال الوقت

51
00:06:41,670 --> 00:06:45,760
كنّا نشويها على سطح الفرن في الشّتاء

52
00:06:45,760 --> 00:06:49,720
حيث تبدأ رائحة الميسو المُحمّصة تفوح

53
00:06:49,720 --> 00:06:52,850
!أتذكّرها جيّداً

54
00:06:52,850 --> 00:06:56,310
وكنّا ندهنها بصلصة الصّويا في الدّيار

55
00:06:56,310 --> 00:07:01,690
ميسو أو صلصة الصّويا هو اختلاف إقليمي

56
00:07:01,690 --> 00:07:06,780
لم يسبق أن تناولتُ كُرة أرزّ مشويّة
بالميسو، لكن واضح أنّها شهيّة

57
00:07:06,780 --> 00:07:10,620
الأرزّ والميسو مزيجان متناسبان

58
00:07:11,160 --> 00:07:15,870
هرس كُرة الأرزّ المشويّة في الشّاي
يعطي مذاقاً لذيذاً أيضاً

59
00:07:15,870 --> 00:07:19,460
أو مرقة داشي

60
00:07:19,460 --> 00:07:22,630
المُكوّنات هي أساسيّات المطبخ

61
00:07:22,630 --> 00:07:29,010
من السّريع تحضيرها في مقلاة أو مُحمّصة
خبز، الطعام الخفيف المثاليّ

62
00:07:29,010 --> 00:07:34,310
لكنّها تتساقط بسهولة أثناء الشيّ

63
00:07:34,310 --> 00:07:35,640
هذا محزن للغاية

64
00:07:35,640 --> 00:07:39,650
هناك بعض النّصائح لمنع حدوث ذلك

65
00:07:39,650 --> 00:07:44,360
"مكتوب، "استخدمي أرزّاً ساخناً مطبوخاً طازجاً

66
00:07:44,360 --> 00:07:50,660
الأرزّ السّاخن يلتصق بشكل أفضل"
"من البارد ويحافظ على شكله

67
00:07:52,530 --> 00:07:56,580
"أوّلاً، قومي بالشيّ حتّى تصبح بنّية بلا صلصة"

68
00:07:56,580 --> 00:08:02,000
"سيتصلّب الجانب المشويّ ويقلّل احتمالات تساقطها"

69
00:08:02,000 --> 00:08:06,340
ثمّ ادهني الجوانب المُتصلّبة بالصّلصة

70
00:08:06,340 --> 00:08:10,260
"الدّهن بالصّلصة بواسطة فرشاة سيجعلها أكثر ليناً"

71
00:08:10,260 --> 00:08:14,010
"ثمّ قومي بالشيّ جيّداً حتّى تجفّ الصّلصة"

72
00:08:14,010 --> 00:08:16,680
!هكذا إذاً! شكراً على النّصائح

73
00:08:16,680 --> 00:08:20,690
!أشعر أنّني أستطيع إعدادها بنفسي الآن

74
00:08:20,690 --> 00:08:23,020
تعلّمتُ الكثير أيضاً

75
00:08:23,020 --> 00:08:28,650
لكن حتّى من دون النّصائح، لا أفشل أبداً

76
00:08:28,650 --> 00:08:32,030
مذهل! كيف تفعلين ذلك؟

77
00:08:32,030 --> 00:08:35,410
سأشارك سرّي معكما فقط

78
00:08:36,370 --> 00:08:38,040
!المُجمَّدة

79
00:08:38,040 --> 00:08:39,960
لا عجب

80
00:08:56,970 --> 00:09:03,190
الفصل 17 - الكريسمس في كاغاي

81
00:08:58,350 --> 00:09:01,020
جاء الكريسمس

82
00:09:01,020 --> 00:09:03,190
إنّه الكريسمس

83
00:09:03,690 --> 00:09:08,490
لا توجد مناسبات كريسمس مُميّزة في كاغاي

84
00:09:08,490 --> 00:09:11,950
لا زينة إضاءة للكريسمس

85
00:09:11,950 --> 00:09:14,950
ولا أشجّار كريسمس

86
00:09:15,450 --> 00:09:18,120
لكن هناك آثار للكريسمس

87
00:09:19,040 --> 00:09:20,580
مساء الخير

88
00:09:21,080 --> 00:09:24,040
أهلاً بعودتك

89
00:09:24,040 --> 00:09:26,670
لم أرك منذ مدّة

90
00:09:27,210 --> 00:09:30,510
الحبل الشريطي الخاص بمالكة بيت الشّاي

91
00:09:32,260 --> 00:09:34,300
من هنا رجاء

92
00:09:35,010 --> 00:09:37,180
تصفيف الزّهور

93
00:09:39,600 --> 00:09:41,520
لأجل الجميع

94
00:09:42,020 --> 00:09:45,020
أو هديّة الكعك الخاصّة بزبون

95
00:09:47,270 --> 00:09:49,860
...كعك

96
00:09:49,860 --> 00:09:51,950
...المزيد من الكعك

97
00:09:53,410 --> 00:09:57,410
!ماذا يعني كعك الهديّة؟

98
00:09:57,410 --> 00:10:01,710
كعك الكريسمس الّذي يحضره الزبائن

99
00:10:02,080 --> 00:10:04,750
حصلتُ على خمسة على الأقلّ

100
00:10:04,750 --> 00:10:07,790
!لم أحصل إلّا على أربعة

101
00:10:07,790 --> 00:10:09,300
أنا أيضاً

102
00:10:09,300 --> 00:10:12,590
هذا كثير جدّاً، لكن لا يمكننا الرّفض

103
00:10:12,590 --> 00:10:16,140
صحيح، يجب أن نكون مُمتنّات لكرمِهم

104
00:10:16,140 --> 00:10:18,600
!هذا صعب جدّاً

105
00:10:19,010 --> 00:10:21,600
تمهّلن لحظة

106
00:10:21,980 --> 00:10:26,190
لم أحصل على أيّ كعك بعد

107
00:10:26,190 --> 00:10:27,310
...كعك

108
00:10:27,310 --> 00:10:32,150
أحتاج لراحة من الكريمة المخفوقة والفراولة

109
00:10:32,150 --> 00:10:33,280
أنا أيضاً

110
00:10:33,280 --> 00:10:37,620
!سئمتُ من كعك الكريسمس

111
00:10:43,160 --> 00:10:48,210
...كنتُ أستعدّ لتحضير الكعك، وقالت أمّي

112
00:10:48,210 --> 00:10:52,050
لا حاجة للكريمة المخفوقة أو الفراولة

113
00:10:52,050 --> 00:10:54,340
!لا عجب

114
00:10:54,340 --> 00:10:56,090
حتّى أمّي؟

115
00:10:57,300 --> 00:11:00,260
...كريمة مخفوقة، فراولة

116
00:11:00,260 --> 00:11:03,560
أين الكريسمس خاصّتي؟

117
00:11:09,730 --> 00:11:12,690
!هذا دراميّ جدّاً يا سوميري

118
00:11:12,690 --> 00:11:15,200
...لكنّه الكريسمس

119
00:11:18,490 --> 00:11:22,830
لا أملك كلّ المكوّنات لخَبز الكعك

120
00:11:25,580 --> 00:11:27,540
لكن لديّ البعض

121
00:11:33,300 --> 00:11:36,050
فواكه لإعداد أطعمة خفيفة

122
00:11:36,050 --> 00:11:39,720
فواكه مُعلّبة لتخفيف البرد

123
00:11:39,720 --> 00:11:42,100
!سنستخدمها كلّها

124
00:11:46,390 --> 00:11:49,770
أوّلاً، نقطّع الفاكهة إلى قطع صغيرة

125
00:11:53,280 --> 00:11:56,740
نُفكّر في كيفيّة ترتيب الفواكه

126
00:11:56,740 --> 00:11:58,360
ترتيب؟

127
00:12:01,530 --> 00:12:04,790
ثمّ نخفق الكريمة جيّداً

128
00:12:09,040 --> 00:12:14,840
يكمن السرّ في خفقها حتّى تبرز القمم للأعلى

129
00:12:15,550 --> 00:12:18,050
ثمّ نأخذ قطعة خبز

130
00:12:19,510 --> 00:12:23,600
ونرتّب الفواكه المُقطّعة هكذا

131
00:12:23,600 --> 00:12:24,890
...ونغطّيها

132
00:12:30,940 --> 00:12:34,020
ونضع فوقها قطعة خبز أخرى

133
00:12:34,570 --> 00:12:38,110
نقطّع بعناية

134
00:12:38,700 --> 00:12:41,950
انتهيت! جاهزة؟

135
00:12:42,450 --> 00:12:44,200
!انظري

136
00:12:52,920 --> 00:12:57,880
شطائر الفاكهة
(كريمة مخفوقة وكثير من الفواكه على خبزة رطبة)

137
00:12:58,590 --> 00:13:00,800
جاء الكريسمس

138
00:13:00,800 --> 00:13:02,800
أجل

139
00:13:05,930 --> 00:13:08,100
!لنأكل

140
00:13:08,100 --> 00:13:10,600
!عيد ميلاد مجيد

141
00:13:10,600 --> 00:13:12,440
!شهيّة

142
00:13:12,440 --> 00:13:13,980
كالكعك تماماً

143
00:13:13,980 --> 00:13:16,730
!كعك الكريسمس الخاص بكيو

144
00:13:20,700 --> 00:13:24,410
كيو في كيوتو: من بيت المايكو

145
00:13:28,660 --> 00:13:29,660
سوميري

146
00:13:30,960 --> 00:13:31,870
وكيو

147
00:13:32,170 --> 00:13:35,960
طبق اليوم

148
00:13:35,960 --> 00:13:42,050
،أرادت سوميري كعكاً في الكريسمس
لذا أعددتُ شطائر فاكهة

149
00:13:42,050 --> 00:13:45,970
شكراً على جعلي أشعر بأجواء
كريسمس جميلة يا كيو

150
00:13:45,970 --> 00:13:47,850
لا شكر على واجب

151
00:13:48,890 --> 00:13:54,230
!الحواف المُقطّعة من شطائركِ جميلة

152
00:13:54,230 --> 00:13:56,730
كما في المحلّات تماماً

153
00:13:56,730 --> 00:13:58,570
!أنتِ تحرجينني

154
00:13:59,230 --> 00:14:03,780
الحواف الجميلة تجعلها تبدو أكثر لذّة حتّى

155
00:14:04,240 --> 00:14:09,370
تلك الّتي تُباع في المحلّات المُختصّة
تبدو جذّابة جدّاً للأكل

156
00:14:09,370 --> 00:14:14,080
أودّ أن أعرف السرّ وراء جعل الحواف جميلة هكذا

157
00:14:14,080 --> 00:14:15,880
!أنا أيضاً

158
00:14:15,880 --> 00:14:20,510
سأبحث حول الأمر هنا

159
00:14:21,300 --> 00:14:26,510
"أوّلاً، تخيّلي خطّ السكّين العموديّ أو القطريّ"

160
00:14:26,510 --> 00:14:32,230
"ثمّ ضعي الفواكه على امتدادها"

161
00:14:33,020 --> 00:14:37,190
الفواكه المُنسّقة بشكل عشوائيّ"
"ستُدفَن وتُخفى

162
00:14:37,190 --> 00:14:40,570
"ولن تظهر سوى الكريمة"

163
00:14:40,570 --> 00:14:44,240
!لا، لا، أريدها مليئة بالفواكه

164
00:14:44,820 --> 00:14:50,410
نصيحة أخرى وهي استخدام فواكه أكبر"
"حجماً للحصول على مظهر أفضل

165
00:14:50,410 --> 00:14:55,370
بالفعل الفواكه الأكبر مذهلة أكثر

166
00:14:55,370 --> 00:14:58,210
وأكثر إرضاء عند الأكل

167
00:14:58,210 --> 00:15:00,960
أحبّ أن تكون الفواكه كثيرة أيضاً

168
00:15:00,960 --> 00:15:06,260
لُفّي الكريمة المخفوقة مع الفاكهة"
"وقومي بتغطيتها بالبلاستيك

169
00:15:06,260 --> 00:15:08,850
"وبرّديها في الثلّاجة"

170
00:15:08,850 --> 00:15:16,270
رسم خطّ تعليم سيساعد في تذكّر"
"الجهة التي عليك التّقطيع منها لاحقاً

171
00:15:16,270 --> 00:15:19,560
...التّقطيع في الاتّجاه الخاطئ

172
00:15:19,560 --> 00:15:24,070
!سيؤدّي إلى خطأ مأساويّ

173
00:15:24,070 --> 00:15:28,450
"قطّعي الشّطيرة الملفوفة المُبرّدة"

174
00:15:28,450 --> 00:15:34,410
أزيلي أيّ كريمة إضافيّة عن السّكين"
"بعد كلّ عمليّة تقطيع

175
00:15:34,410 --> 00:15:39,830
الكريمة المُتبقّية ستجعل الحافّة"
"المُقطّعة التاليّة فوضويّة

176
00:15:40,590 --> 00:15:42,460
!هذا مُفيد جدّاً

177
00:15:42,460 --> 00:15:46,300
أريد إعداد المزيد من شطائر الفاكهة

178
00:15:46,300 --> 00:15:47,970
!أحتاج لمزيد من الخبز

179
00:15:47,970 --> 00:15:53,470
يمكنكما الاعتماد عليّ في تجربة
!شطائر الفاكهة الشهيّة خاصّتكما

180
00:15:53,470 --> 00:15:55,020
!لكِ ذلك

181
00:16:00,020 --> 00:16:03,980
الفصل 18 - عشيّة العام الجديد في كاغاي

182
00:16:04,480 --> 00:16:06,570
أجل، صحيح

183
00:16:07,320 --> 00:16:10,950
لديّ تذاكر قطار ليوم غدّ

184
00:16:12,740 --> 00:16:15,250
أجل

185
00:16:15,250 --> 00:16:18,290
سأعود إلى المنزل في يوم العام الجديد

186
00:16:18,290 --> 00:16:19,420
كيو؟

187
00:16:20,080 --> 00:16:22,210
كيو، سأغادر

188
00:16:22,210 --> 00:16:23,710
حسناً يا أمّي

189
00:16:23,710 --> 00:16:25,050
...سأعود بعد

190
00:16:27,130 --> 00:16:28,510
مرحباً؟

191
00:16:28,510 --> 00:16:31,510
شكراً لك. سوف آتي

192
