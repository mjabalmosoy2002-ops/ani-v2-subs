1
00:00:24,010 --> 00:00:27,900
!أعتذر! سحبتُ يدكِ بشدّة

2
00:00:27,900 --> 00:00:31,510
!لا، لا بأس
!آسفة لأنّي لم أكن أكثر حذرًا

3
00:00:31,810 --> 00:00:34,700
.أعتذر على زيارتي المفاجئة

4
00:00:35,140 --> 00:00:37,180
.سأغادر الآن

5
00:00:37,790 --> 00:00:39,840
.حسنًا

6
00:00:41,730 --> 00:00:43,140
...إن لم يكن لديك مانع

7
00:00:46,430 --> 00:00:50,480
.أريدكِ أن تزوروني بغرفتي في وقت ما

8
00:01:00,260 --> 00:01:04,000
...هذا أكثر مما يستطيع قلبي تحمّله

9
00:02:57,560 --> 00:03:01,770
.صداع الثمالة مزعج

10
00:03:02,050 --> 00:03:05,340
.يتحوّل فيكتور إلى ثعبان مراوغ عندما يشرب

11
00:03:04,440 --> 00:03:06,830
!أحضر لي كأسين آخرين

12
00:03:07,060 --> 00:03:11,490
هل حصل على بركة الذئب الرماديّ حقًا
وليس بركة الثعبان؟

13
00:03:13,460 --> 00:03:18,280
.هذا أول يوم إجازة لي منذ وقت طويل
.لا أريد أن يلازمني هذا الشعور السيئ طوال اليوم

14
00:03:22,970 --> 00:03:25,070
!أرسينت-ساما

15
00:03:25,960 --> 00:03:28,040
.لم أرك منذ زمن

16
00:03:28,500 --> 00:03:30,720
هل أنت في إجازة اليوم؟

17
00:03:31,170 --> 00:03:32,750
.نعم، هذا صحيح

18
00:03:32,750 --> 00:03:36,460
بدوتَ كأنك لستَ بحالة جيدة
.لذا اشرب بعض الماء

19
00:03:36,910 --> 00:03:38,710
.أنتِ مراعية حقًا

20
00:03:38,710 --> 00:03:40,590
!أرسينت-ساما

21
00:03:41,650 --> 00:03:45,710
متى ستخرج معي في موعد كما وعدتني؟

22
00:03:46,060 --> 00:03:48,160
...حسنًا

23
00:03:49,230 --> 00:03:51,100
!أرسينت

24
00:03:51,700 --> 00:03:54,450
ألن تخرج للهو اليوم؟

25
00:03:54,450 --> 00:03:56,950
!الماء يا أرسينت-ساما

26
00:03:56,950 --> 00:03:59,710
ماذا عن موعدنا يا أرسينت-ساما؟

27
00:03:59,710 --> 00:04:03,780
!لنستمتع قليلًا يا أرسينت

28
00:04:03,780 --> 00:04:05,920
!أرسينت-ساما -

29
00:04:04,090 --> 00:04:08,650
.نعم... الفتيات رائعات -

30
00:04:05,920 --> 00:04:08,020
!أرسينت

31
00:04:08,650 --> 00:04:12,190
.أنا سعيد بوجودهن بجواري

32
00:04:15,550 --> 00:04:16,930
...إنها

33
00:04:18,430 --> 00:04:19,870
.الغوريلا الصغيرة

34
00:04:25,790 --> 00:04:26,920
.آسف

35
00:04:28,160 --> 00:04:30,620
.طرأ أمر ما، لذا أراكنّ لاحقًا

36
00:04:30,620 --> 00:04:31,870
ماذا؟

37
00:04:32,290 --> 00:04:35,400
.سأزوركن مجددًا. إلى اللقاء

38
00:04:37,720 --> 00:04:39,200
!عدني

39
00:04:39,200 --> 00:04:41,120
!أنت ممل

40
00:04:45,050 --> 00:04:49,050
...إن كانت هنا في هذا الوقت
.أتساءل إن كانت تقوم بدورية في المدينة

41
00:05:02,250 --> 00:05:05,650
.مرحبًا، أتفقّد أمرك فحسب

42
00:05:05,650 --> 00:05:09,250
.أتيتِ مجددًا

43
00:05:09,930 --> 00:05:15,100
أنتِ مثابرة وتعملين بجدّ
!كفارسة مبتدئة! أحسنت

44
00:05:15,820 --> 00:05:17,250
.شكرًا جزيلًا لك

45
00:05:17,750 --> 00:05:19,580
.أنا أشجعك

46
00:05:19,580 --> 00:05:20,530
.شكرًا لك

47
00:05:34,290 --> 00:05:38,620
من الصعب التفكير في أنها غوريلا
.من خلال مراقبتها فحسب

48
00:05:39,270 --> 00:05:41,270
ماذا قلت؟

49
00:05:41,940 --> 00:05:44,100
ماذا تعني بأنك لن تسمح لنا بالدخول؟

50
00:05:44,100 --> 00:05:46,180
!الزبون دائمًا على حق

51
00:05:46,180 --> 00:05:51,800
...لا، لكن... أنت تُزعج بقية الزبائن

52
00:05:47,790 --> 00:05:50,510
!اسمح لنا بالدخول إذًا

53
00:05:53,170 --> 00:05:54,520
.ها هي ذي

54
00:05:53,600 --> 00:05:56,740
...أنا في غاية الأسف، لكن

55
00:05:56,740 --> 00:06:00,090
...عذرًا

56
00:06:00,090 --> 00:06:01,290
ماذا تريدين؟

57
00:06:01,290 --> 00:06:03,840
أنتِ فارسة مبتدئة؟

58
00:06:03,840 --> 00:06:05,640
ماذا تريدين؟

59
00:06:05,640 --> 00:06:07,160
...حسنًا

60
00:06:07,160 --> 00:06:09,090
!خذنا إلى مقاعدنا بسرعة

61
00:06:09,090 --> 00:06:11,110
!توقفا رجاءً

62
00:06:11,110 --> 00:06:13,430
!وأحضر لنا شرابنا بسرعة

63
00:06:13,430 --> 00:06:16,670
!مهلًا

64
00:06:14,180 --> 00:06:16,670
...ما باليد حيلة. سأساعدها

65
00:06:28,650 --> 00:06:32,860
.شكرًا جزيلًا لك
.لقد أنقذتني

66
00:06:32,860 --> 00:06:34,040
.لا داعي للشكر

67
00:06:34,040 --> 00:06:37,090
تواصل معي على الفور
.إن طرأ أمر ما مجددًا

68
00:06:41,060 --> 00:06:42,680
.ليست سيئة

69
00:06:44,410 --> 00:06:47,670
.آسفة على هذا

70
00:06:48,080 --> 00:06:50,700
.ها أنتِ ذي. لقد وصلنا

71
00:06:50,700 --> 00:06:55,300
.شكرًا لك
.يصبح السير صعبًا عند التقدّم في العمر

72
00:06:55,300 --> 00:06:56,860
!اعتني بنفسك

73
00:06:56,860 --> 00:07:00,270
.أنتِ أيضًا أيتها الفارسة المبتدئة

74
00:07:11,070 --> 00:07:12,750
ما الذي تنظرين إليه؟

75
00:07:13,670 --> 00:07:15,640
القائد أدلر؟

76
00:07:16,200 --> 00:07:18,410
...أنا خارج الخدمة اليوم

77
00:07:19,040 --> 00:07:20,920
.يمكنك مناداتي أرسينت

78
00:07:21,190 --> 00:07:24,420
...لا، لا أستطيع

79
00:07:24,670 --> 00:07:26,780
.لا يهم

80
00:07:26,780 --> 00:07:29,610
ما الذي كنتِ تحدّقين به؟

81
00:07:32,680 --> 00:07:35,620
تحبين هذه الأشياء إذًا؟

82
00:07:35,620 --> 00:07:40,440
.لا... ليست لي

83
00:07:40,440 --> 00:07:43,420
.أعرف شخصًا يحب الحلويات

84
00:07:43,420 --> 00:07:46,180
واعتقدتُ أنه سيفرح
.إن أخبرته عنها

85
00:07:48,450 --> 00:07:49,940
...فهمت

86
00:07:51,300 --> 00:07:54,460
هل تريدينني أن أرافقك
إلى الداخل إذًا؟

87
00:07:55,220 --> 00:07:57,780
كادت تنتهي دوريّتك، صحيح؟

88
00:07:58,170 --> 00:08:02,420
بوسعكِ اعتبار هذا تدريبًا

89
00:08:02,420 --> 00:08:04,340
.قبل مجيئك إلى هنا بصحبة الشخص الذي تتحدثين عنه

90
00:08:11,210 --> 00:08:14,740
!أعتذر، لكنني أرفض ذلك

91
00:08:14,740 --> 00:08:15,800
لماذا؟

92
00:08:16,470 --> 00:08:21,480
ليس لأنك أعلى مرتبة
...بل لأن التواجد بمفردي مع رجل

93
00:08:21,480 --> 00:08:26,560
.أنتِ تبالغين في التفكير بهذا الأمر
.سنشرب الشاي معًا فحسب

94
00:08:26,560 --> 00:08:28,860
.أنا آسفة

95
00:08:31,010 --> 00:08:31,990
...إذًا

96
00:08:32,500 --> 00:08:34,820
هل كنتُ لتوافقين لو قلتُ أنه أمر؟

97
00:08:34,820 --> 00:08:39,450
...أمر؟ لكن

98
00:08:39,450 --> 00:08:43,130
...مع ذلك

99
00:08:43,130 --> 00:08:45,670
.آسف، أنا أمزح

100
00:08:47,470 --> 00:08:49,710
.هيّا، عودي لعملك

101
00:08:49,710 --> 00:08:51,460
.حسنًا

102
00:08:51,770 --> 00:08:53,770
.أستأذن

103
00:08:57,840 --> 00:08:59,230
.مهلًا

104
00:08:59,230 --> 00:09:00,930
نعم؟

105
00:09:01,780 --> 00:09:05,200
...بشأن ما قلته سابقًا
...لو لم يكن أمرًا من شخص أعلى رتبة

106
00:09:05,980 --> 00:09:08,500
،وكان طلبًا من صديقك الحميم
فهل كنتِ لترافقيني؟

107
00:09:13,010 --> 00:09:14,690
!أنا أمزح

108
00:09:33,790 --> 00:09:36,350
...أتساءل ما هذا الشعور

109
00:09:38,650 --> 00:09:42,160
أعتقد أنّي سأحلّق اليوم
!أبعد مما أفعل في العادة

110
00:10:08,960 --> 00:10:11,200
!أيزاك

111
00:10:14,810 --> 00:10:15,830
!صوفيا

112
00:10:15,830 --> 00:10:19,160
!آسفة على تأخري

113
00:10:26,020 --> 00:10:30,850
.أنا آسفة! لم آخذ قوّتي بعين الاعتبار

114
00:10:30,850 --> 00:10:35,740
...سُعدت برؤية وجهك فحسب
.ولم أستطع كبح نفسي

115
00:10:37,450 --> 00:10:38,940
!لا مانع لديّ

116
00:10:38,940 --> 00:10:42,710
سأكون سعيدًا بإمساكك
!وقوتك الطاغية في أيّ وقت

117
00:10:42,710 --> 00:10:44,000
...أيزاك

118
00:10:44,310 --> 00:10:46,490
.هيّا بنا

119
00:10:46,840 --> 00:10:48,270
.حسنًا

120
00:10:50,840 --> 00:10:52,150
كيف يسير الأمر؟

121
00:10:52,150 --> 00:10:55,250
.هذا محرج حقًا

122
00:10:57,030 --> 00:11:00,590
.لا بأس. أرني فحسب

123
00:11:00,590 --> 00:11:02,130
...حسنًا

124
00:11:05,480 --> 00:11:07,770
ما رأيك؟

125
00:11:07,770 --> 00:11:10,900
!نعم! تبدين رائعة
!إنه جميل جدًا

126
00:11:10,900 --> 00:11:12,270
حقًا؟

127
00:11:12,270 --> 00:11:15,010
.سنشتري هذا الفستان

128
00:11:15,720 --> 00:11:17,280
!شكرًا لك

129
00:11:31,310 --> 00:11:34,420
.كان ذلك ممتعًا جدًا

130
00:11:34,420 --> 00:11:37,830
!أحبّتك الجراء بشدّة يا أيزاك

131
00:11:38,510 --> 00:11:40,560
.شكرًا لك على هذا اليوم

132
00:11:40,560 --> 00:11:43,920
هذا أول موعد لي
.لذا خشيتُ ألا تستمتعي به

133
00:11:44,240 --> 00:11:47,460
!سأستمتع بالذهاب إلى أيّ مكان برفقتك يا أيزاك

134
00:11:48,420 --> 00:11:50,180
...لأنك

135
00:11:51,980 --> 00:11:55,480
.صديقي الحميم

136
00:12:04,610 --> 00:12:06,610
.امسح هذه الابتسامة البلهاء من على وجهك

137
00:12:09,380 --> 00:12:11,550
!إدي

138
00:12:11,550 --> 00:12:15,160
ما الذي تستذكره في مكان كهذا؟

139
00:12:15,160 --> 00:12:18,710
.الحلم الذي رأيته البارحة
.آسف يا إدي، إنه سرّ

140
00:12:18,710 --> 00:12:20,460
.لستُ مهتمًا بذلك على الإطلاق

141
00:12:20,460 --> 00:12:25,010
.هذا فظيع
.عليك أن تهتم لأمري قليلًا

142
00:12:26,350 --> 00:12:27,460
...الأهم من هذا

143
00:12:27,920 --> 00:12:32,770
.كانت نظرتك شاعرية منذ قليل

144
00:12:33,480 --> 00:12:37,570
هل أسعدك أمر ما؟

145
00:12:47,230 --> 00:12:49,640
ما الذي تفعله هنا؟

146
00:12:49,640 --> 00:12:51,560
...حسنًا، هذا

147
00:12:53,030 --> 00:12:55,090
!قطّة

148
00:12:55,090 --> 00:12:57,480
،قفزت فوق ساقيّ فجأة

149
00:12:57,480 --> 00:12:59,610
ولا أدري ما العمل الآن
.بما أنها تأبى التحرك

150
00:13:00,250 --> 00:13:02,560
.أشعر بالغيرة

151
00:13:02,560 --> 00:13:03,700
لماذا؟

152
00:13:03,700 --> 00:13:07,830
تبدو معتادة على البشر
.لذا بوسعك لمسها إن أردتِ

153
00:13:07,830 --> 00:13:12,710
لا. أخشى أن أقتلها
.دون قصد إن لم أتوخّ الحذر

154
00:13:12,710 --> 00:13:15,070
هل أنتِ حاصدة أرواح؟

155
00:13:15,430 --> 00:13:17,210
...أنا غوريلا

156
00:13:21,440 --> 00:13:23,620
هل تحبين القطط؟

157
00:13:23,620 --> 00:13:28,200
.نعم. إنها ظريفة وتهدّئ الروح لذا أحبها

158
00:13:32,220 --> 00:13:36,200
بالمناسبة، لماذا كنتَ تجلس هنا؟

159
00:13:36,580 --> 00:13:38,530
.كنت أختبئ من الفتيات

160
00:13:39,540 --> 00:13:41,780
.فهمت

161
00:13:46,790 --> 00:13:49,710
...نعم، من المستحيل

162
00:13:50,800 --> 00:13:53,160
.أن أخبره بما حدث

163
00:13:53,160 --> 00:13:56,800
ما سرّ تلك النظرة إذًا يا إدي؟

164
00:13:56,800 --> 00:13:58,140
!إنها مخيّلتك فحسب

165
00:13:58,490 --> 00:13:59,770
حقًا؟

166
00:13:59,770 --> 00:14:01,550
.أيًا يكن

167
00:14:04,420 --> 00:14:05,910
هل نغادر؟

168
00:14:18,940 --> 00:14:25,510
تقوم صوفيا بدورية
بالعاصمة الملكية اليوم إذًا؟

169
00:14:25,980 --> 00:14:30,170
.نعم. لكن يفترض أن تكون دورية صباحية

170
00:14:30,800 --> 00:14:34,020
،لكن بمعرفتي بها
فلا شكّ أن العديد من الأشخاص

171
00:14:34,020 --> 00:14:37,630
قد طلبوا منها مساعدتهم
.لذا ستتأخر على الأرجح

172
00:14:37,630 --> 00:14:41,400
.هذا لأن صوفيا فتاة رائعة

173
00:14:41,400 --> 00:14:43,910
.صحيح

174
00:14:47,990 --> 00:14:50,570
...إذًا

175
00:14:54,400 --> 00:14:57,250
...حسنًا

176
00:14:57,250 --> 00:14:58,950
.قل ما عندك فحسب

177
00:14:59,280 --> 00:15:05,210
أتعتقد أن صوفيا... تحب شخصًا ما؟

178
00:15:07,620 --> 00:15:08,710
إدي؟

179
00:15:08,710 --> 00:15:12,510
.من يدري؟ لا أعلم

180
00:15:15,250 --> 00:15:16,980
...صحيح

181
00:15:16,980 --> 00:15:20,130
.أنت لا تعلم

182
00:15:25,730 --> 00:15:26,240
إدي؟

183
00:15:26,240 --> 00:15:29,150
!قلتُ أنني لا أدري

184
00:15:29,570 --> 00:15:30,650
!لا أدري

185
00:15:30,650 --> 00:15:35,110
لماذا أنت غاضب؟

186
00:15:45,440 --> 00:15:47,830
!اشترينا الكثير اليوم

187
00:15:47,830 --> 00:15:48,930
!بالفعل

188
00:15:48,930 --> 00:15:50,430
!كان ذلك ممتعًا جدًا

189
00:15:50,430 --> 00:15:55,080
سنجعلك تغيّرين فساتينك البالية
!أخيرًا يا أرينيي

190
00:15:55,080 --> 00:15:56,420
...أجل

191
00:15:56,420 --> 00:16:00,930
ماذا؟ ألا تثقين بذوقي؟

192
00:16:00,930 --> 00:16:03,760
.لا. الأمر ليس كذلك

193
00:16:03,760 --> 00:16:07,690
.أعتقد أن ذوقك رائع يا كاريسا
...الأمر فحسب

194
00:16:07,690 --> 00:16:08,890
فحسب؟

195
00:16:12,180 --> 00:16:18,130
...ذلك الفستان فاخر جدًا
.لذا لا أعتقد أنه سيليق بي

196
00:16:18,130 --> 00:16:22,050
لماذا تتحدثين عن نفسك بسلبية دائمًا؟

197
00:16:25,530 --> 00:16:30,210
أنزعج بشدّة كلما رأيتَ
!شخصًا يتصرّف على هذا النحو

198
00:16:30,610 --> 00:16:35,220
أنتِ جميلة جدًا
.ولديك وجه من الدرجة أ

199
00:16:37,150 --> 00:16:40,230
لم يكن هناك داعٍ
.لسماع ما قلته للتو

200
00:16:40,530 --> 00:16:45,230
عمومًا، أريد القيام بأمر ما
!حيال هذا لأنه هدر

201
00:16:45,660 --> 00:16:48,120
.شكرًا لك

202
00:16:51,670 --> 00:16:54,950
.أردنا دعوة صوفيا أيضًا

203
00:16:54,950 --> 00:16:59,940
.حقًا؟ إنها راضية أيضًا بمظهرها الممل

204
00:16:59,940 --> 00:17:01,320
!بالفعل

205
00:17:01,320 --> 00:17:06,170
...يا إلهي. ما مدى انشغالها في يوم إجازتها

206
00:17:13,200 --> 00:17:16,930
صوفيا ريلر؟

207
00:17:22,210 --> 00:17:26,090
.لم أكن أعلم أنكِ فارسة مبتدئة

208
00:17:26,090 --> 00:17:30,150
...أعلم أنكِ تختفين بعد المدرسة مباشرة لكن

209
00:17:30,410 --> 00:17:32,700
.آسفة لأنّي أخفيتُ الأمر

210
00:17:32,700 --> 00:17:39,150
لكن... أردتُ أن تكون
.حياتي المدرسية هادئة قدر الإمكان

211
00:17:39,430 --> 00:17:44,760
.لذا... آمل أن تبقين الأمر سرًا

212
00:17:47,660 --> 00:17:52,740
أتفهّم رغبتك في عيش
.حياة مدرسية راقية

213
00:17:52,740 --> 00:17:55,660
لكن لماذا تحاولين إخفاء الأمر؟

214
00:17:57,220 --> 00:17:59,670
أليس هذا أمرًا يدعو للفخر؟

215
00:18:00,230 --> 00:18:02,920
.هذا ليس عملًا يستطيع أيًا كان القيام به

216
00:18:05,150 --> 00:18:06,440
!تمامًا

217
00:18:06,440 --> 00:18:08,680
.إنه عمل مذهل

218
00:18:08,920 --> 00:18:12,180
لكنني لستُ متأكدة من كوني
.مناسبة لهذا العمل

219
00:18:13,980 --> 00:18:15,290
.صوفيا

220
00:18:15,880 --> 00:18:20,690
،يتملّك القلق الفتيات مثلنا دائمًا

221
00:18:21,390 --> 00:18:23,950
.لذا نبالغ في القلق بشأن ما يفكر به الآخرون

222
00:18:25,150 --> 00:18:28,950
".أتساءل إن كنّ سيكرهنني إن قلتُ هذا"

223
00:18:30,010 --> 00:18:34,830
أو "أتساءل إن كنّ سيُنهين
".صداقتنا إن تصرّفتُ على سجيّتي

224
00:18:36,390 --> 00:18:40,010
لكن آنذاك، شعرتُ بسوء شديد

225
00:18:40,010 --> 00:18:44,040
لأن ضعفي جعلني
.أرتكب أمرًا فظيعًا في حقّك

226
00:18:44,400 --> 00:18:46,750
...أدركتُ مدى ضعفي

227
00:18:46,750 --> 00:18:49,490
.لذا قررتُ أن أتغيّر

228
00:18:50,930 --> 00:18:55,900
أردتُ أن أصبح فتاة
.لا تكترث لما يفكّر به الآخرون

229
00:18:56,450 --> 00:18:58,650
،في بادئ الأمر، شعرتُ بخوف شديد

230
00:18:59,210 --> 00:19:03,910
لكن الجميع تحدثن إليّ
.كما يفعلن في العادة بشكل مفاجئ

231
00:19:04,630 --> 00:19:09,490
ولهذا تمكنتُ اليوم
!من الذهاب للتسوّق مع صديقاتي

232
00:19:11,050 --> 00:19:15,390
لذا أعتقد أن لا بأس
.بالتصرّف على سجيّتك يا صوفيا

233
00:19:16,190 --> 00:19:21,150
لا أعتقد أن عليك إخفاء
!كونك فارسة مبتدئة

234
00:19:21,730 --> 00:19:26,420
أنتِ رائعة حقًا
!ويليق بك هذا الزيّ

235
00:19:28,160 --> 00:19:30,400
.أرينيي محقة

236
00:19:30,760 --> 00:19:34,880
عليك التصرّف بعفوية
.وأن تكوني على سجيّتك

237
00:19:34,880 --> 00:19:40,400
لا أفهم الأشخاص الذين يتصرّفون
.بطرق مختلفة على الإطلاق

238
00:19:40,400 --> 00:19:44,020
تتصرّف كاريسا-ساما على سجيّتها
!في كل يوم من أيام السنة الـ365

239
00:19:44,020 --> 00:19:45,910
.أحبّ عدم تغييرها لطباعها

240
00:19:45,910 --> 00:19:50,610
.حقًا؟ من المحرج أن يُقال لي هذا

241
00:19:50,610 --> 00:19:51,630
!ظريفة جدًا

242
00:19:51,630 --> 00:19:53,060
!أنت ظريفة جدًا

243
00:19:53,060 --> 00:19:55,120
.كاريسا مذهلة

244
00:19:55,120 --> 00:19:56,430
...نعم

245
00:19:57,320 --> 00:19:59,580
...التصّرف على سجيّتي إذًا

246
00:19:59,580 --> 00:20:03,440
.نعم. وتحدثي إلينا إن كان هناك ما يقلقك

247
00:20:04,830 --> 00:20:08,430
صحيح. لا تتردّدي في التحدث
.إلينا بشأن أيّ شيء

248
00:20:08,780 --> 00:20:12,440
نحن صديقات، ألسنا كذلك؟

249
00:20:15,620 --> 00:20:18,950
.شكرًا لكن جميعًا

250
00:20:19,350 --> 00:20:22,510
لماذا تبكين؟

251
00:20:22,510 --> 00:20:25,260
.أنتِ فتاة مثيرة للاهتمام حقًا

252
00:20:25,780 --> 00:20:29,460
!إذًا... بوسعنا ترك هذا جانبًا

253
00:20:29,770 --> 00:20:34,920
أصحيح أن هناك عدّة
رجال وسيمين ضمن الفرسان الملكيين؟

254
00:20:34,920 --> 00:20:37,600
!خصوصًا القادة

255
00:20:39,290 --> 00:20:43,400
.يتمرّن معظمهم بجدّ

256
00:20:43,970 --> 00:20:48,720
.لذا أعتقد أنهم وسيمون من هذه الناحية

257
00:20:48,720 --> 00:20:49,720
!يا إلهي

258
00:20:50,280 --> 00:20:53,460
!إذًا فهم وسيمون ومفتولوا العضلات

259
00:20:53,460 --> 00:20:54,980
!هذا مذهل حقًا

260
00:20:55,370 --> 00:20:57,480
.بالمناسبة يا كاريسا

261
00:20:59,320 --> 00:21:02,580
ماذا عن الشخص الذي كان برفقتك
خلال الحفل المدرسي؟

262
00:21:02,580 --> 00:21:04,070
أليس صديقك الحميم؟

263
00:21:05,010 --> 00:21:07,370
ليونهارت؟

264
00:21:07,840 --> 00:21:09,120
.ليس كذلك

265
00:21:09,680 --> 00:21:13,760
لقد تحدث إليّ عند مدخل
.قاعة الحفل فحسب

266
00:21:13,760 --> 00:21:18,290
.كان وسيمًا جدًا لذا لم أرفض

267
00:21:18,620 --> 00:21:21,100
.لكنني لا أعرفه

268
00:21:21,100 --> 00:21:23,120
...فهمت

269
00:21:23,120 --> 00:21:24,700
!الأهم من هذا

270
00:21:25,630 --> 00:21:28,270
،بما أننا معًا جميعًا
لنذهب للتسوّق بصحبة صوفيا

271
00:21:28,270 --> 00:21:29,980
!لنشتري لها فستانًا أيضًا

272
00:21:30,770 --> 00:21:32,100
!هيّا بنا

273
00:21:33,400 --> 00:21:34,500
!أنا موافقة

274
00:21:34,500 --> 00:21:37,850
قلتِ أنكِ تريدين البحث
!عن فستان مثالي لصوفيا أيضًا

275
00:21:37,850 --> 00:21:43,050
سنحتاج أيضًا لفساتين ملائمة
!للقاء الفرسان الملكيين

276
00:21:43,050 --> 00:21:44,680
!انتظري رجاءً

277
00:21:44,680 --> 00:21:46,550
!كاريسا-ساما

278
00:21:47,760 --> 00:21:50,860
.كاريسا مفعمة بالحيوية دومًا

279
00:21:50,860 --> 00:21:51,930
.صحيح

280
00:21:52,890 --> 00:21:55,790
هيّا! لِم التباطؤ؟

281
00:21:55,790 --> 00:21:59,410
!سيُغلق المتجر أبوابه إن لم نُسرع