1
00:00:10,050 --> 00:00:11,510
!هيراهارا-سان

2
00:00:20,350 --> 00:00:23,060
.يتناغم كل شيء على نحو مثير للشفقة

3
00:00:23,060 --> 00:00:27,190
.هذا هو مفتاح الأبواب

4
00:02:06,040 --> 00:02:07,870
...ماذا

5
00:02:07,870 --> 00:02:09,870
فُتحت أبواب "العالم المشترك"؟

6
00:02:13,500 --> 00:02:14,880
!هيوري

7
00:02:20,140 --> 00:02:21,800
!انظري هناك

8
00:02:34,730 --> 00:02:36,780
!هذا سيء للغاية

9
00:02:36,780 --> 00:02:38,450
.اهدئي -
...لكن -

10
00:02:38,450 --> 00:02:41,660
.فُتحت أبواب "العالم المشترك" وأصبحت صدعًا في الزمكان

11
00:02:42,820 --> 00:02:44,080
صحيح؟

12
00:02:44,080 --> 00:02:45,740
صدع؟

13
00:02:45,740 --> 00:02:50,080
أصبحت هناك فجوة في الجدار
.الذي يفضل "العالم المشترك" عن هذا العالم

14
00:02:50,080 --> 00:02:53,080
،إن اندمج العالمان

15
00:02:53,080 --> 00:02:55,800
.ستتدمر قوانين هذا العالم مجددًا

16
00:02:55,800 --> 00:02:58,340
كيف يُفترض بي معرفة ما يعنيه ذلك؟

17
00:02:58,340 --> 00:02:59,840
.أصغي إلي

18
00:02:59,840 --> 00:03:02,930
،إن تدمرت قوانين هذا العالم
...ستفقد المشاعر حُرمتها

19
00:03:04,470 --> 00:03:07,430
ما تقصدين بـ"إن تدمرت"؟

20
00:03:19,610 --> 00:03:24,280
.سيبدأ وقتي السليم في التحرك أخيرًا

21
00:03:28,870 --> 00:03:31,580
.لن نسمح لكِ بتنفيذ خطتك يا شينو-تشان

22
00:03:31,580 --> 00:03:34,040
."سنحمي "العالم المشترك

23
00:03:35,750 --> 00:03:40,050
.أنتما حارستا "العالم المشترك" فحسب
!لا تعترضا طريقي

24
00:03:48,930 --> 00:03:50,180
ما الخطب؟

25
00:03:50,180 --> 00:03:52,270
."تُهاجم شينو "العالم المشترك

26
00:03:53,770 --> 00:03:55,110
.يجب أن أذهب

27
00:03:58,070 --> 00:03:59,940
.لكنك مصابة

28
00:04:01,400 --> 00:04:02,740
...روكا-تشان

29
00:04:04,610 --> 00:04:06,200
.كل هذا خطئي

30
00:04:07,330 --> 00:04:10,290
.لقد قُمت بكل هذا

31
00:04:10,290 --> 00:04:13,120
...ريوكا-سان، أميرو-سان

32
00:04:13,120 --> 00:04:15,290
.روكا-تشان... كل هذا خطئي

33
00:04:15,290 --> 00:04:17,590
!اهدئي يا هيوري

34
00:04:17,590 --> 00:04:21,420
ما الذي علي فعله؟ ما الذي يُفترض بي فعله؟

35
00:04:21,420 --> 00:04:24,010
.لا بأس يا هيوري

36
00:04:24,010 --> 00:04:25,800
...أختي

37
00:04:25,800 --> 00:04:29,060
.لم تقترفي أي ذنب يا هيوري

38
00:04:29,060 --> 00:04:31,430
.إنها غلطة هذا العالم الظالم

39
00:04:32,680 --> 00:04:35,810
...وعرفت ذلك

40
00:04:35,810 --> 00:04:38,820
.عرفت أنكِ ستفتحين الأبواب

41
00:04:41,990 --> 00:04:43,700
ما الذي تقصدينه؟

42
00:04:45,660 --> 00:04:48,410
خططنا منذ البداية لاستغلالكما

43
00:04:48,410 --> 00:04:52,950
.لجعل كل الأزهار الصغيرة تخرج عن السيطرة

44
00:04:54,710 --> 00:04:59,000
كيف نجعل الأزهار الصغيرة تتألم
...وكيف نجعل مشاعرهن تخرج عن السيطرة

45
00:04:59,000 --> 00:05:01,000
!لقد توصلنا إلى كل ذلك

46
00:05:01,000 --> 00:05:04,590
.شكرًا لكما لوقوعكما في الفخ

47
00:05:04,590 --> 00:05:06,680
!أوتا، أيتها اللعينة

48
00:05:06,680 --> 00:05:12,220
للتوضيح فحسب، كانت هذه خطة
.أختي وشينو-تان

49
00:05:12,220 --> 00:05:13,810
...أختي

50
00:05:13,810 --> 00:05:19,150
.كل هذا من أجل حمايتك
،طالما أن هذا العالم غلطة

51
00:05:19,150 --> 00:05:22,570
.فلن يتوقف الألم والمعاناة

52
00:05:23,650 --> 00:05:29,160
لكن لو فتحنا الأبواب واستطعنا التحكم
،في مشاعر الجميع السخيفة

53
00:05:29,160 --> 00:05:33,040
.فلن تخرج مشاعرك عن السيطرة

54
00:05:33,040 --> 00:05:35,500
.يضمن هذا سعادتك

55
00:05:36,830 --> 00:05:39,290
سعادتي؟

56
00:05:39,290 --> 00:05:43,630
،أجل. حتى لو كان عليكِ الاحتفاظ بنقاط ضعفك

57
00:05:43,630 --> 00:05:46,840
.تستطيعين النجاة في عالم تملؤه الطيبة

58
00:05:46,840 --> 00:05:49,340
!لا تقرري بدلًا عن هيوري

59
00:05:49,340 --> 00:05:51,550
عالم تكون فيه هيوري سعيدة؟

60
00:05:52,680 --> 00:05:57,940
!هيوري من يحق لها اتخاذ هذا القرار وليس أنت

61
00:05:59,810 --> 00:06:05,150
.مشاعر هيوري... ليست ضعفًا

62
00:06:05,150 --> 00:06:07,820
.تستطيع الاهتمام بالآخرين

63
00:06:07,820 --> 00:06:12,660
...تستطيع الغضب من أجلهم والبكاء من أجلهم

64
00:06:12,660 --> 00:06:14,950
!بذل ما بوسعها لمساعدتهم

65
00:06:16,040 --> 00:06:18,750
!لن أسمح لكِ بفرض نفسك على تلك المشاعر

66
00:06:21,040 --> 00:06:24,920
عالم سليم؟ السعادة؟

67
00:06:24,920 --> 00:06:28,550
!لا تستغلي هيوري لتحقيق رغبتك

68
00:06:29,970 --> 00:06:31,590
...روكا-تشان

69
00:06:34,430 --> 00:06:38,310
.أُنقذ العديد من الأشخاص بفضل مشاعرها

70
00:06:38,310 --> 00:06:42,310
.هيراهارا هيوري التي ترين هي من الماضي

71
00:06:42,310 --> 00:06:44,520
.إنها ليست الفتاة التي أمامك الآن

72
00:06:45,730 --> 00:06:48,530
،أنت محقة. لو كانت مومو-سان هنا

73
00:06:48,530 --> 00:06:51,200
.لكان لديها ما تقوله بشأن هذا

74
00:06:51,200 --> 00:06:52,700
...جميعًا

75
00:07:01,880 --> 00:07:03,960
..."العالم المشترك"

76
00:07:03,960 --> 00:07:06,420
ما الذي علينا فعله؟

77
00:07:06,420 --> 00:07:08,880
.سنُغلق أنا وهيوري الأبواب

78
00:07:13,180 --> 00:07:15,720
.لا بأس إن كنتن لا تفهمن

79
00:07:15,720 --> 00:07:19,140
سأحمي هيوري بطريقتي الخاصة

80
00:07:19,140 --> 00:07:21,520
.وسأنشئ عالمًا سليمًا

81
00:07:24,150 --> 00:07:26,360
...مياكو-تشان، نينا-تشان

82
00:07:26,360 --> 00:07:28,900
هلا تعتنيان بريوكا-سان وأميرو-سان؟

83
00:07:28,900 --> 00:07:30,200
.حسنًا -
.دعي الأمر  لنا -

84
00:07:32,490 --> 00:07:36,120
.كوماغاوا-سان -
!بل أوتا-تشان. أحب لعبة المطاردة -

85
00:07:37,660 --> 00:07:40,080
.لن أسمح لكما باعتراض طريقنا

86
00:08:06,440 --> 00:08:07,690
!بسرعة

87
00:08:07,690 --> 00:08:09,110
!أعلم

88
00:08:09,110 --> 00:08:11,320
...علينا الوصول إلى غرفتي فحسب

89
00:08:09,110 --> 00:08:12,550
"ثانوية تسوكينوميا"

90
00:08:11,320 --> 00:08:12,570
.أمسكت بكن

91
00:08:23,000 --> 00:08:24,250
!اذهبي

92
00:08:29,050 --> 00:08:31,210
.يبدو أننا بمفردنا مجددًا

93
00:08:31,210 --> 00:08:34,550
.أجل. سأعتني بك جيدًا

94
00:08:55,700 --> 00:08:59,160
ارتكبت خطأ آخر، أليس كذلك؟

95
00:08:59,160 --> 00:09:01,450
...وقد ورطت أميرو في الأمر

96
00:09:04,710 --> 00:09:08,290
.يُضحي ذلك الخاتم بمشاعرك الغالية

97
00:09:09,340 --> 00:09:13,470
.يسرق مشاعرك التي حاولت أميرو-سان حمايتها

98
00:09:13,470 --> 00:09:15,090
أفعلت أميرو ذلك؟

99
00:09:15,090 --> 00:09:21,220
...لكنكِ تعانين وتندمين على ذلك وتتألمين بشدة

100
00:09:21,220 --> 00:09:26,390
.ما زلت تملكين مشاعرك. لم تنتهي المعركة بعد

101
00:09:32,030 --> 00:09:34,530
.الوضع خطير هنا. لنذهب

102
00:09:39,120 --> 00:09:40,280
ما الذي تفعلينه؟

103
00:09:40,280 --> 00:09:43,160
.سأذهب للعثور على مكان شينو

104
00:09:43,160 --> 00:09:46,290
.لم تعد موجودة في هذا العالم

105
00:09:48,460 --> 00:09:51,460
لقد أنشأت مكانها الخاص بين هذا العالم
"و"العالم المشترك

106
00:09:51,460 --> 00:09:53,170
.وتختبئ هناك

107
00:09:58,300 --> 00:10:01,760
...لكن بواسطة هذا الخاتم

108
00:10:01,760 --> 00:10:04,350
.أنا واثقة من عثوري على شينو

109
00:10:10,480 --> 00:10:11,940
!روكا-تشان

110
00:10:47,390 --> 00:10:48,980
كيف يُفترض بنا القتال؟

111
00:10:50,850 --> 00:10:52,440
.آسفة يا روكا-تشان

112
00:10:53,400 --> 00:10:54,770
...لا داعي لهذا

113
00:10:54,770 --> 00:11:01,280
.كنتُ يائسة. أحب أختي كثيرًا وأردت حمايتها

114
00:11:01,280 --> 00:11:05,160
.أصبحت في مرحلة ما أخشى إخبارها بالحقيقة

115
00:11:07,450 --> 00:11:09,830
.لا تقتصر الحياة على الأمور الممتعة فحسب

116
00:11:10,960 --> 00:11:13,710
...تحزنين وتغضبين

117
00:11:13,710 --> 00:11:16,170
تجتاحك الكثير من المشاعر عندما
.تكونين رفقة شخص ما

118
00:11:17,510 --> 00:11:21,510
.لكن هذا لا يجعلها أقل أهمية

119
00:11:21,510 --> 00:11:24,140
.لكنك علّمتني هذا يا روكا-تشان

120
00:11:24,140 --> 00:11:25,810
...هيوري

121
00:11:36,860 --> 00:11:39,900
.لا يهم ما أكتشفه عنكِ، فلن أتغير

122
00:11:42,410 --> 00:11:46,490
.سأواجهك إن قمت بتصرف غبي

123
00:11:46,490 --> 00:11:49,830
.لم أعد كما كنت في السابق

124
00:11:49,830 --> 00:11:52,420
.إذن سأدعوك بالغبية أيضًا

125
00:11:57,840 --> 00:12:00,220
.لنُغلق الأبواب معًا

126
00:12:00,220 --> 00:12:02,130
.بمشاعرنا

127
00:12:04,300 --> 00:12:06,510
.ما زالت لا تعلم

128
00:12:06,510 --> 00:12:10,310
،بمجرد أن تعرفي بشأن ذلك
.فلا يمكنك الفرار من هذا الظلام

129
00:12:12,440 --> 00:12:17,730
أنا الوحيدة التي تستطيع حماية هيوري
.من ذلك الظلام واليأس

130
00:12:26,490 --> 00:12:28,200
...هيوري، سأكون أنا من

131
00:12:42,970 --> 00:12:48,220
متى كان ذلك... حين اكتشفت ذلك الألم
الذي يبدو كأنه أبدي؟

132
00:12:49,720 --> 00:12:56,440
واحدًا تلو الآخر... يُسلب مني الأشخاص
.الأكثر أهمية في حياتي

133
00:13:02,150 --> 00:13:03,360
أمي...؟

134
00:13:04,610 --> 00:13:09,780
في كل مرة، يغرق قلبي أعمق فأعمق

135
00:13:09,780 --> 00:13:13,750
.في أعماق الظلام دون مخرج

136
00:13:10,790 --> 00:13:13,750
"دفتر بنكي"

137
00:13:17,710 --> 00:13:20,130
!انظري يا أختي

138
00:13:20,130 --> 00:13:25,010
لكنني كان ما يزال هناك شعاع أمل
.يخترق نوره الظلام

139
00:13:27,470 --> 00:13:29,300
ما رأيك؟

140
00:13:29,300 --> 00:13:30,760
.يليق بكِ

141
00:13:32,060 --> 00:13:37,400
.دافئ مثل أشعة الشمس... تُلقي ضوءها على مشاعري

142
00:13:48,820 --> 00:13:50,370
...أختي

143
00:13:53,700 --> 00:13:59,210
.ذلك ما تعنيه هيوري بالنسبة لي
.لا يوجد ما هو أكثر أهمية لي

144
00:13:59,210 --> 00:14:04,150
"بلاتانوس"

145
00:14:01,000 --> 00:14:02,670
.بوركت جهودك

146
00:14:04,300 --> 00:14:07,880
"هل أستطيع الاتصال بك يا أختي؟"
"!أشعر بالملل"

147
00:14:09,260 --> 00:14:12,430
.لم أرك منذ فترة يا أختي

148
00:14:14,520 --> 00:14:16,390
...أنتِ

149
00:14:26,610 --> 00:14:28,530
شينو؟

150
00:14:28,530 --> 00:14:33,830
.سأخبرك بكل شيء. بكل شيء عنكِ

151
00:14:48,260 --> 00:14:53,050
...لماذا نسيت؟ هيوري قد

152
00:14:53,050 --> 00:14:55,770
.لقد تركتها تموت

153
00:14:55,770 --> 00:15:02,060
،إن سمحنا لهذا بالاستمرار
.ستتكرر نفس المأساة

154
00:15:03,360 --> 00:15:05,570
.لكن لا داعي للقلق بعد الآن

155
00:15:09,150 --> 00:15:13,030
.هذه وسيلة إنقاذك لأختك

156
00:15:29,420 --> 00:15:31,590
.من هذا الاتجاه

157
00:15:47,860 --> 00:15:49,690
.لنبدأ

158
00:15:55,950 --> 00:15:57,450
...هذا مؤلم

159
00:15:59,330 --> 00:16:01,460
هل كنت أعترض طريقك؟

160
00:16:02,710 --> 00:16:04,580
ألم تكوني تريدينني؟

161
00:16:10,720 --> 00:16:13,220
.الآن، أنقذيها

162
00:16:14,140 --> 00:16:19,600
.لم أعد أريد هذا! هذا مؤلم
.أريد أن أختفي

163
00:16:45,330 --> 00:16:48,420
.هذا العالم غلطة

164
00:16:48,420 --> 00:16:51,720
تستمر معاناة الفتيات

165
00:16:51,720 --> 00:16:55,260
.ومع ذلك، تَقرر انتهاء القصة فحسب

166
00:16:55,260 --> 00:17:01,220
حماقة الناس تمنعهم من إدراك هذا
.فيمضون في حياتهم

167
00:17:02,810 --> 00:17:07,610
.لكننا مختلفات. نعلم بشأن هذه الأخطاء

168
00:17:09,020 --> 00:17:11,900
.نعلم ما الصواب وما الخطأ

169
00:17:14,780 --> 00:17:20,290
.سيقودنا هذا النور الغالي نحو العالم السليم

170
00:17:21,120 --> 00:17:24,910
.نور نحو العالم السليم

171
00:17:34,760 --> 00:17:37,430
.أهلًا بعودتك يا أختي

172
00:17:37,430 --> 00:17:38,470
هيوري؟

173
00:17:40,100 --> 00:17:41,850
هل فاجأتك؟

174
00:17:41,850 --> 00:17:43,100
...غذا إجازة، لذا أتيت إلى المنزل -

175
00:17:43,100 --> 00:17:44,480
!هيوري -
...غذا إجازة، لذا أتيت إلى المنزل -

176
00:17:46,190 --> 00:17:49,360
هل من خطب يا أختي؟

177
00:18:02,240 --> 00:18:04,950
"لن تعود أمي إلى المنزل"

178
00:18:07,330 --> 00:18:08,040
"أثق بأختي"

179
00:18:08,250 --> 00:18:08,960
"!يمكنك فعلها يا هيوري"

180
00:18:08,960 --> 00:18:09,540
"!افعلي أكثر مما يوجد على قائمة الأعمال المنزلية"

181
00:18:09,540 --> 00:18:10,000
"!بدون تذمر"

182
00:18:10,000 --> 00:18:10,880
"أحب أختي"

183
00:18:15,300 --> 00:18:19,640
.عرفت هذا... لا أستطيع حماية هيوري

184
00:18:19,640 --> 00:18:23,470
.رغم أنني كنت بجانبها، لم أستطع أن أدرك أنها تعاني

185
00:18:24,470 --> 00:18:26,310
...لأنني هربت

186
00:18:26,310 --> 00:18:29,270
،إن سمحنا لهذا بالاستمرار

187
00:18:29,270 --> 00:18:33,570
.ستتكرر نفس المأساة

188
00:18:33,570 --> 00:18:37,150
...لكن في العالم السليم

189
00:18:37,150 --> 00:18:42,830
،لن يكون على هيوري أن تعاني
.ولن تخرج مشاعرها عن السيطرة

190
00:18:44,330 --> 00:18:47,520
"بلاتانوس"

191
00:18:44,950 --> 00:18:47,540
.سأكون قادرة على حمايتها

192
00:18:48,000 --> 00:18:51,210
.سأستطيع تحقيق أمنيتي

193
00:18:53,250 --> 00:18:56,670
.هيراهارا ميو، لدي طلب

194
00:19:04,640 --> 00:19:08,690
.لم أعلم ما يجب علي فعله آنذاك

195
00:19:10,810 --> 00:19:12,690
.لكن الوضع مختلف الآن

196
00:19:13,770 --> 00:19:16,030
