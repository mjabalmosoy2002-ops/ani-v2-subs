1
00:00:02,580 --> 00:00:04,000
!نينا-تشان

2
00:00:15,300 --> 00:00:16,890
...نينا-تشان

3
00:01:49,150 --> 00:01:50,860
يامادا نينا؟

4
00:01:52,650 --> 00:01:58,660
.لكن هذا... مستحيل
.من المستحيل أن تنقذكما

5
00:01:58,660 --> 00:02:01,870
ما الذي حدث حقًا يا هاناري-سان؟

6
00:02:03,450 --> 00:02:05,910
.أظن أن نينا-تشان قد تغيرت

7
00:02:07,160 --> 00:02:09,170
...آنذاك

8
00:02:09,170 --> 00:02:12,340
!احمي مشاعر نينا-تشان رجاءً

9
00:02:12,340 --> 00:02:14,670
...ابتعدي

10
00:02:14,670 --> 00:02:16,720
!عن مشاعري

11
00:02:22,260 --> 00:02:23,850
...أختي

12
00:02:23,850 --> 00:02:27,640
.أريد رؤية نينا-تشان مجددًا

13
00:02:27,640 --> 00:02:33,310
أريد البحث عنها لأعثر عليها وأسألها
.عمّا تفكر به حاليًا

14
00:02:33,310 --> 00:02:34,610
.لن أسمح لكِ بهذا

15
00:02:35,400 --> 00:02:37,150
.لم أقل أي شيء بعد

16
00:02:37,150 --> 00:02:40,570
.لستِ بحاجة لقول شيء
.أعلم فيما تفكرين بالتحديد

17
00:02:40,570 --> 00:02:44,120
.تريدين أن تصبحي صديقتها
.تريدين القتال إلى جانبها

18
00:02:44,120 --> 00:02:46,490
.لن أسمح بذلك

19
00:02:47,620 --> 00:02:48,910
...مياكو-تشان

20
00:02:48,910 --> 00:02:52,040
!لقد حاولت سرقة مشاعري

21
00:02:52,040 --> 00:02:54,960
هل ظننتِ حقًا أنني سأوافق على هذا؟

22
00:02:57,010 --> 00:03:00,220
!قولي شيئًا يا هاناري-سان

23
00:03:00,220 --> 00:03:02,470
.تخلطين وعاء نخالة الأرز ذاك طوال هذا الوقت

24
00:03:03,430 --> 00:03:06,060
.يبدو أنه يجب خلط المكونات على نحو منتظم

25
00:03:06,060 --> 00:03:07,060
...و

26
00:03:07,060 --> 00:03:08,350
و؟

27
00:03:10,640 --> 00:03:13,360
...أتساءل ما رأي مومو-سان

28
00:03:23,490 --> 00:03:28,580
."العينة الاستثنائية "أ
.شظية" متضررة وجزء مفقود بالكامل"

29
00:03:31,920 --> 00:03:35,250
.ما الذي يؤخركما؟ اصعدا بسرعة

30
00:03:38,300 --> 00:03:40,300
أهكذا تدرب الناس في عصر "شُوا"؟

31
00:03:40,300 --> 00:03:42,260
متى كان عصر "شُوا"؟

32
00:03:42,260 --> 00:03:45,600
أنتما اللتان طلبتما مني تعليمكما
!كيف تقاتلان

33
00:03:45,600 --> 00:03:48,260
...لكن هذا ليس قتالًا

34
00:03:48,260 --> 00:03:51,690
...يتمحور كل شيء حول قوة الإرادة! و

35
00:03:57,520 --> 00:04:04,070
.كما أخبرتكِ، سأحمي ما هو غالٍ عليكِ

36
00:04:05,200 --> 00:04:06,700
!مومو-سان

37
00:04:13,080 --> 00:04:14,370
.هيراهارا-سان

38
00:04:15,420 --> 00:04:17,750
هل استيقظتِ يا روكا-تشان؟

39
00:04:18,800 --> 00:04:21,800
.كنت أفكر

40
00:04:21,800 --> 00:04:26,930
،بشأن ما سبق، أفهم وجهة نظرك

41
00:04:26,930 --> 00:04:29,640
.وأفهم وجهة نظر شيراكابا-سان

42
00:04:29,640 --> 00:04:37,020
يامادا نينا ومومو-سان كلتاهما تملكان
.مشاعر قوية تُجاه أختك

43
00:04:37,020 --> 00:04:39,440
ألا تظنين أن الأمر سينجح؟

44
00:04:40,360 --> 00:04:45,990
...لكن إن أدى هذا بطريقة ما إلى استعادة أختك

45
00:04:45,990 --> 00:04:48,240
أتظنين أننا نستطيع القتال معًا؟

46
00:04:48,240 --> 00:04:54,330
.علينا أن نسأل مومو-سان شخصيًا
."لنستعد "شظيتها

47
00:04:54,330 --> 00:04:57,250
!أجل! ومشاعر الجميع

48
00:04:59,380 --> 00:05:02,440
"مطبعة ياما"

49
00:05:01,300 --> 00:05:02,760
.مرحبًا

50
00:05:02,760 --> 00:05:04,300
.تفضلي

51
00:05:04,300 --> 00:05:06,050
.لحظة من فضلك

52
00:05:11,430 --> 00:05:12,930
"ألبوم صور سي جي"

53
00:05:12,930 --> 00:05:14,640
"اجعليها صورة لا تُنسى"

54
00:05:17,400 --> 00:05:19,480
.شكرًا لك على انتظارك

55
00:05:19,480 --> 00:05:23,530
.هذه هي البيانات التي أرسلتها لنا سابقًا

56
00:05:23,530 --> 00:05:26,700
.وهذه صورك

57
00:05:26,700 --> 00:05:29,820
.تأكدي من المحتويات للاحتياط

58
00:05:33,950 --> 00:05:36,830
.هذه من رحلتنا المدرسية

59
00:05:36,830 --> 00:05:38,500
.كان ذلك ممتعًا للغاية

60
00:05:38,500 --> 00:05:43,340
أتذكرين؟ واجهت صعوبة في التقاط
.هذه الصورة بطريقة ملائمة

61
00:05:43,340 --> 00:05:48,800
.أجل، كررنا التقاطها مرارًا
.ثم... حصلنا على أفضل صورة

62
00:05:48,800 --> 00:05:53,640
بالمناسبة، ما كانت تلك الأغنية التي سمعنا آنذاك؟

63
00:05:53,640 --> 00:05:58,020
.ألا تذكرين يا ريوكا؟ إنها هذه

64
00:06:00,860 --> 00:06:04,650
.هذه الأغنية! كما هو متوقع منكِ يا أميرو

65
00:06:04,650 --> 00:06:07,240
.اتذكر كل شيء يخص قائمة الاستماع خاصتنا

66
00:06:09,910 --> 00:06:11,410
.المهرجان الثقافي

67
00:06:12,870 --> 00:06:17,500
!مرتفعات هيثكليف ذات الرياح العاتية! رائعة للغاية

68
00:06:17,500 --> 00:06:19,670
.أنتِ من التقط الصورة

69
00:06:19,670 --> 00:06:22,630
...كنا نستمع إلى

70
00:06:22,630 --> 00:06:24,000
!هذه

71
00:06:26,590 --> 00:06:28,010
.أجل

72
00:06:30,840 --> 00:06:34,310
.هذه صورة من عيد ميلادي للعام الماضي

73
00:06:34,310 --> 00:06:37,060
.وكنا نستمع إلى هذه

74
00:06:42,610 --> 00:06:44,150
.دعيني أرى

75
00:06:50,240 --> 00:06:51,570
.تفضلي

76
00:06:56,290 --> 00:06:59,830
!أميرو؟ أميرو

77
00:07:02,830 --> 00:07:06,170
هل شردت؟

78
00:07:06,170 --> 00:07:07,960
...أميرو

79
00:07:13,850 --> 00:07:16,010
...عاكسة جديدة

80
00:07:17,060 --> 00:07:21,140
!يغمرني الحماس بالتفكير في الأمر فحسب

81
00:07:21,140 --> 00:07:23,230
!أنا أفقد صوابي

82
00:07:25,440 --> 00:07:31,280
.بالطبع نحن نتحدث عن أختنا، لذا هي لم تتردد

83
00:07:31,280 --> 00:07:36,870
.رغم أنني كنت لأفضل أن تتردد وتعاني

84
00:07:47,500 --> 00:07:50,420
.أريد زهرة جديدة

85
00:07:50,420 --> 00:07:55,260
.زهرة ذات حزن لا نهاية له تُردد صوتًا بائسًا

86
00:07:55,260 --> 00:07:56,390
.زهرة كتلك

87
00:07:56,390 --> 00:08:01,480
أليست "شظية" هيراهارا هيوري
هي ما نحتاجه يا شينو-تان؟

88
00:08:01,480 --> 00:08:05,480
"أجل. من أجل فتح الأبواب نحو "العالم المشترك
.في أقرب وقت ممكن

89
00:08:05,480 --> 00:08:08,860
أنت أيضًا؟ ما الذي يحدث؟

90
00:08:08,860 --> 00:08:12,320
...أحب أن يتم تجاهلي، لكن

91
00:08:12,320 --> 00:08:15,990
لماذا نتخلى عن هيراهارا هيوري؟

92
00:08:15,990 --> 00:08:18,200
.أريد "شظيتين" إن أمكن

93
00:08:18,200 --> 00:08:20,200
.أزهار جديدة

94
00:08:21,660 --> 00:08:25,750
!تتجاهلان وجودي بالكامل! أحب هذا

95
00:08:27,000 --> 00:08:30,170
.التجول مهم لكن توخيا الحذر

96
00:08:30,170 --> 00:08:33,970
.خصوصًا أن هيوري هي هدف عدونا الرئيسي

97
00:08:33,970 --> 00:08:35,510
.أجل، أعلم

98
00:08:35,510 --> 00:08:39,600
.لن أفعل الشيء ذاته مجددًا

99
00:08:39,600 --> 00:08:42,640
.سآتي إليكِ مباشرة إن حدث أمر ما يا هيراهارا-سان

100
00:08:45,150 --> 00:08:47,310
...أو هذا ما قلته

101
00:08:47,310 --> 00:08:48,860
حقًا؟

102
00:08:56,070 --> 00:08:59,410
.هشة للغاية... وهناك العديد منها

103
00:08:59,410 --> 00:09:02,250
...يجعل التشوه في الزمكان مشاعر الجميع

104
00:09:14,550 --> 00:09:16,760
لماذا هي غلطتي لأنني ذهبت معهن...؟

105
00:09:17,800 --> 00:09:20,600
ماذا تعني أنه كان يجب أن أعرف...؟

106
00:09:20,600 --> 00:09:24,770
لماذا كل هذا خطئي...؟

107
00:09:37,570 --> 00:09:39,070
...فتاة سحرية

108
00:09:41,910 --> 00:09:45,160
.صحيح؟ أتذكرك

109
00:09:50,630 --> 00:09:54,170
.أصبح قلبي أخف الآن

110
00:09:54,170 --> 00:09:56,220
.أشعر كأنني وُلدت من جديد

111
00:09:56,220 --> 00:09:57,220
...أنت

112
00:09:57,220 --> 00:10:02,100
هل أنتِ التي أخذت مشاعري؟
أنتِ وصديقاتك؟

113
00:10:02,100 --> 00:10:04,970
.كلا، هذا غير مهم

114
00:10:04,970 --> 00:10:08,940
.كنت أتساءل إن كان بإمكاني استعادتها

115
00:10:10,650 --> 00:10:13,360
...لا نريد أن ننام

116
00:10:13,360 --> 00:10:15,610
لا بد من وجود طريقة ما، أليس كذلك؟

117
00:10:15,610 --> 00:10:19,320
لا بد أنك تعرفين، صحيح؟
.أنتِ التي سلبتنا مشاعرنا

118
00:10:22,780 --> 00:10:26,750
آسفة، لكن هلا تتوقفن عن إلقاء اتهامات كهذه؟

119
00:10:26,750 --> 00:10:28,120
.إنها صديقتي

120
00:10:28,120 --> 00:10:29,750
...ريوكا-سان

121
00:10:32,340 --> 00:10:33,750
.هيا بنا، لنذهب

122
00:10:42,720 --> 00:10:45,680
ماذا؟ هل أنت رفيقتها أيضًا؟

123
00:10:47,100 --> 00:10:48,770
ما اسمك؟

124
00:10:49,940 --> 00:10:52,190
...فوجي أيومو

125
00:10:52,190 --> 00:10:55,940
.سأتذكر اسمك. لنصبح أصدقاء

126
00:10:59,610 --> 00:11:02,030
...إنها -
...إنها رائعة للغاية -

127
00:11:27,930 --> 00:11:29,270
.نينا-تشان

128
00:11:44,570 --> 00:11:46,740
!نينا-تشان

129
00:11:46,740 --> 00:11:48,040
.أحتاج للتحدث إليك

130
00:11:48,040 --> 00:11:50,330
.ليس لدي ما أقوله لك

131
00:11:50,330 --> 00:11:52,620
.هذه أنتِ كما توقعت

132
00:11:53,540 --> 00:11:55,670
!توقفي عن التحدث إلي

133
00:11:57,460 --> 00:12:00,340
.لم أسامحكِ بعد

134
00:12:00,340 --> 00:12:03,010
،أنتِ من جعل أختي تعاني

135
00:12:03,010 --> 00:12:05,640
.ثم دفعتها إلى نقطة اللاعودة

136
00:12:06,890 --> 00:12:09,310
.ومع ذلك، أنقذتني

137
00:12:09,310 --> 00:12:12,600
.أنقذتِ تلك الفتاة للتو

138
00:12:12,600 --> 00:12:14,270
.هذا ما أكرهه بشأنك

139
00:12:14,270 --> 00:12:16,610
!مايا

140
00:12:16,610 --> 00:12:19,650
!اصمدي يا مايا! اتصلي بالإسعاف

141
00:12:19,650 --> 00:12:21,610
!حسنًا

142
00:12:25,950 --> 00:12:28,830
.شكرًا لكِ على ما فعلتِ منذ قليل

143
00:12:28,830 --> 00:12:30,330
...ريوكا-سان

144
00:12:30,330 --> 00:12:32,290
.تاتشيبانا

145
00:12:32,290 --> 00:12:35,670
.اسمي الكامل هو تاتشيبانا ريوكا

146
00:12:35,670 --> 00:12:37,170
ماذا عنك؟

147
00:12:37,170 --> 00:12:39,550
.هاناري روكا

148
00:12:40,590 --> 00:12:43,430
.هاناري روكا. اسم رائع

149
00:12:43,430 --> 00:12:45,510
.تشرفت بمعرفتك أيتها الغزالة الصغيرة

150
00:12:47,510 --> 00:12:50,140
بالمناسبة، هل رأيتِ أميرو؟

151
00:12:50,140 --> 00:12:52,060
...أميرو

152
00:12:52,060 --> 00:12:53,730
!ريوكا

153
00:12:55,940 --> 00:12:57,400
.أميرو

154
00:12:57,400 --> 00:13:03,860
،إنها على هذا الحال دومًا
.لقد غابت عن ناظري فجأة اليوم

155
00:13:03,860 --> 00:13:05,950
هل تبحثين عنها؟

156
00:13:05,950 --> 00:13:08,120
.أجل، دائمًا

157
00:13:10,200 --> 00:13:12,250
...كنت أبحث طوال هذا الوقت

158
00:13:14,790 --> 00:13:18,040
.ما باليد حيلة. أظنني سأنتظر في بقعتنا الاعتيادية

159
00:13:18,040 --> 00:13:20,960
Sorry, but would you keep me
company for a bit?

160
00:13:45,530 --> 00:13:48,370
هل تعرفين هذه اللعبة؟
ضوء أحمر، ضوء أخضر؟

161
00:13:48,370 --> 00:13:51,580
..."بينما يُدير الشخص ظهره بعد أن يقول، "ضوء أحمر

162
00:13:51,580 --> 00:13:54,000
!لا أهتم! اغربي عن وجهي

163
00:14:06,260 --> 00:14:09,180
.لأنكِ كنتِ تلوحين بها في الأرجاء

164
00:14:15,060 --> 00:14:17,730
.لا شك أن هناك شيئًا مهمًا بداخلها

165
00:14:17,730 --> 00:14:20,690
.تتجولين دومًا وأنتِ تحملينها يا نينا-تشان

166
00:14:25,740 --> 00:14:27,240
.أخبريني يا نينا-تشان

167
00:14:27,240 --> 00:14:31,320
.من المستحيل أن أقاتل إلى جانبكن

168
00:14:31,320 --> 00:14:36,120
كيف عرفتِ ما أود قوله؟ -
.من السهل معرفة ما يدور في ذهنك -

169
00:14:36,120 --> 00:14:38,420
.هذا ما أخبرتني به مياكو-تشان أيضًا

170
00:14:38,420 --> 00:14:39,790
.كأنني أهتم

171
00:14:41,670 --> 00:14:43,710
!لننقذ أختي

172
00:14:45,840 --> 00:14:49,590
.أريد إنقاذها. لذا لنعمل معًا

173
00:14:49,590 --> 00:14:53,010
،اثنتان أفضل من واحدة
!وثلاث أفضل من اثنتان

174
00:14:53,010 --> 00:14:56,220
.لنستعد مشاعر أختي

175
00:14:56,220 --> 00:14:58,940
...إن كانت هناك أي مشاعر لاستعادتها

176
00:15:00,190 --> 00:15:03,270
ماذا تقصدين يا نينا-تشان؟

177
00:15:03,270 --> 00:15:07,360
.لم تعد أختي الشخص الذي نعرفه

178
00:15:10,280 --> 00:15:12,620
،لا أعلم ما نوع تلك التعويذة

179
00:15:12,620 --> 00:15:15,580
.لكن أختي الآن مثل شينو

180
00:15:15,580 --> 00:15:17,540
.أستطيع معرفة هذا من القتال الأخير

181
00:15:17,540 --> 00:15:20,250
!هذا... غير صحيح

182
00:15:20,250 --> 00:15:24,000
.ما زالت مشاعر أختي في مكان ما في أعماقها

183
00:15:24,000 --> 00:15:27,340
.افعلي ما تشائين. لن أوقفك

184
00:15:29,260 --> 00:15:32,010
.لكنني لم أستطع الشعور بها

185
00:15:32,010 --> 00:15:35,600
.بالمشاعر التي تُكنها أختي تُجاهي وتُجاهك

186
00:15:35,600 --> 00:15:39,270
.لا شيء على الإطلاق

187
00:15:39,270 --> 00:15:40,770
...لذا

188
00:15:43,560 --> 00:15:48,110
.عندما يحين الوقت، سأنهي كل شيء

189
00:15:48,110 --> 00:15:51,450
...حتى لو قُضي علينا معًا، سوف أقوم

190
00:15:52,700 --> 00:15:54,950
...نينا-تشان

191
00:15:54,950 --> 00:16:00,000
!لا يمكنك فعل هذا. سأحمي أختي وأنقذها

192
00:16:00,000 --> 00:16:02,710
.مشاعرها... بالإضافة إلى مشاعر مومو-سان والبقية

193
00:16:02,710 --> 00:16:04,830
!سأستعيدها كلها

194
00:16:06,090 --> 00:16:08,510
ألا تعلمين؟

195
00:16:10,590 --> 00:16:14,680
.بمجرد أن تُسلب "الشظية"، لا يمكنك إعادتها

196
00:16:31,780 --> 00:16:33,240
أتريدين بعضها؟

197
00:16:37,870 --> 00:16:40,410
ما الذي أفعله؟

198
00:16:46,170 --> 00:16:48,250
أين نحن؟

199
00:16:48,250 --> 00:16:50,960
.إنه مكان لقائنا الاعتيادي أنا وأميرو

200
00:16:50,960 --> 00:16:54,550
.إنه مكاننا الخاص

201
00:16:54,550 --> 00:16:57,100
هل تعلمين لِم أنقذتك؟

202
00:16:57,100 --> 00:16:59,220
لماذا؟

203
00:17:00,180 --> 00:17:02,230
.لأنكِ فتاة سحرية

204
00:17:03,270 --> 00:17:06,690
.أولئك الفتيات لم يكن مخطئات

205
00:17:06,690 --> 00:17:09,400
ذلك ما يعنيه هذا الخاتم، أليس كذلك؟

206
00:17:09,400 --> 00:17:11,030
.أخبرتني أميرو

207
00:17:12,530 --> 00:17:14,990
...تلك الغزالة الصغيرة

208
00:17:14,990 --> 00:17:18,200
كيف تعلم أميرو بشأن هذا؟

209
00:17:18,200 --> 00:17:22,250
...لقد سُلبت مشاعر أميرو أيضًا

210
00:17:23,330 --> 00:17:25,620
.من طرف فتاة سحرية مثلك

211
00:17:28,290 --> 00:17:31,590
لا يمكنك... إعادة "الشظية"؟

212
00:17:31,590 --> 00:17:34,590
.غيرت رأيي مرة واحدة  فقط

213
00:17:34,590 --> 00:17:36,760
.لم أعلم ما الذي كنت أفكر به

214
00:17:41,430 --> 00:17:45,690
.وداعًا أيتها الزهرة الصغيرة، هيا بنا يا سينباي

215
00:17:49,400 --> 00:17:55,320
ربما لأن مشاعرها كانت شبيهة بالمشاعر
.التي أكنها لأختي

216
00:17:56,320 --> 00:17:58,320
.لكن كان ذلك بلا جدوى

217
00:17:58,320 --> 00:18:03,160
،بمجرد أن تسلبيهن مشاعرهن
.يفقدن هويتهن

218
00:18:03,160 --> 00:18:07,790
،لا يتعلق الأمر بالألم والمعاناة فحسب
.بل يُصبحن غير قادرات على الإحساس

219
00:18:07,790 --> 00:18:10,750
.وفي النهاية، يغطن في نوم عميق

220
00:18:12,710 --> 00:18:16,550
،قبل حدوث ذلك، أو بالأحرى
لمنع حدوث ذلك

221
00:18:16,550 --> 00:18:18,640
.أنا أبذل كل ما بوسعي

222
00:18:18,640 --> 00:18:20,350
...لكن

223
00:18:20,350 --> 00:18:22,930
ما نوع المشاعر التي سُلبت من أميرو-سان؟

224
00:18:22,930 --> 00:18:26,310
.كنت أحاول العثور عليها طوال هذا الوقت

225
00:18:30,520 --> 00:18:32,820
.كنا معًا دومًا منذ طفولتنا

226
00:18:33,980 --> 00:18:36,400
.كنا أصدقاء طفولة

227
00:18:36,400 --> 00:18:38,280
...ثم، في مرحلة ما

228
00:18:46,960 --> 00:18:50,670
.أصبحت أعز أصدقائي، أختي الصغرى... كلا

229
00:18:50,670 --> 00:18:56,010
.لا أستطيع التعبير عما تمثله أميرو لي

230
00:18:58,880 --> 00:19:03,050
.كما هو متوقع منك، لديك شعبية كبيرة

231
00:19:03,050 --> 00:19:04,890
.ترفّقي بي

232
00:19:04,890 --> 00:19:06,350
"ريوكا-سان"

233
00:19:06,680 --> 00:19:09,190
.ستواعدين شخصًا ما في النهاية

234
00:19:09,190 --> 00:19:11,440
.لا أخطط لمواعدة أي شخص

235
00:19:15,570 --> 00:19:17,320
.ما الخطب؟ هيا بنا

236
00:19:17,320 --> 00:19:19,240
.حسنًا

237
00:19:26,790 --> 00:19:28,750
!تفضلي يا تاتشيبانا-سينباي

238
00:19:31,460 --> 00:19:33,250
!لقد منحتها إياه! فعلت ذلك حقًا

239
00:19:33,250 --> 00:19:35,130
!أحسنتِ يا أكيمي

240
00:19:36,760 --> 00:19:39,590
.والآن، ها هو السؤال المهم يا ريوكا

241
00:19:39,590 --> 00:19:43,720
كم عدد قطع الشوكولاتة التي حصلتِ عليها
بمناسبة عيد الحب هذه السنة؟

242
00:19:43,720 --> 00:19:45,680
.ترفّقي بي

243
00:19:45,680 --> 00:19:50,020
.لا تقلقي، سأشاركك أكلها

244
00:19:50,020 --> 00:19:53,060
.أميرو -
.ماذا؟ هيا بنا

245
00:19:53,060 --> 00:19:55,690
.حسنًا

246
00:19:57,900 --> 00:20:02,110
كنت ساذجة للغاية. ظننت أننا سنبقى
.على حالنا للأبد

247
00:20:02,110 --> 00:20:04,570
...لو فكرت في مشاعرها أكثر

248
00:20:04,570 --> 00:20:07,240
...لو اهتممت بها أكثر

249
00:20:07,240 --> 00:20:11,210
...لو تواصلت معها في وقت مبكر

250
00:20:16,130 --> 00:20:17,420
!أميرو

251
00:20:20,970 --> 00:20:24,140
!أميرو! أميرو

252
00:20:24,140 --> 00:20:25,970
!أميرو

253
00:20:27,890 --> 00:20:29,930
تفهمين الآن، صحيح؟

254
00:20:29,930 --> 00:20:32,770
.لا يهم إن كانت مومو أو أي فتاة أخرى

255
00:20:32,770 --> 00:20:34,810
.لن يستيقظن أبدًا

256
00:20:36,900 --> 00:20:40,440
.فكري في إنقاذ أختي فحسب

257
00:20:42,450 --> 00:20:44,740
حدث هذا مرة واحدة فحسب، صحيح؟

258
00:20:44,740 --> 00:20:49,040
حاولت إعادة "شظية" مرة واحدة فحسب، صحيح؟

259
00:20:49,040 --> 00:20:50,660
.مرة واحدة كافية

260
00:20:50,660 --> 00:20:52,370
!لكن يجب ألا تستسلمي

261
00:20:52,370 --> 00:20:55,500
!لن أتخلى عن أختي أيضًا

262
00:20:55,500 --> 00:20:57,380
لذا... حسنًا؟

263
00:20:59,630 --> 00:21:03,220
.أظن أنه لا جدوى من مجادلتك
.افعلي ما يحلو لكِ

264
00:21:04,680 --> 00:21:06,430
!نينا-تشان

265
00:21:06,430 --> 00:21:08,720
ما الخطب؟ هل تؤلمك معدتك؟

266
00:21:10,970 --> 00:21:12,390
قرقرة؟

267
00:21:14,520 --> 00:21:18,480
.في النهاية، لم أستطع فعل أي شيء من أجلها

268
00:21:27,950 --> 00:21:29,620
.إننا نُسمى عاكسات

269
00:21:31,040 --> 00:21:35,870
وليس فتيات سحريات. وواجبنا كعاكسات

270
00:21:35,870 --> 00:21:37,880
.هو حماية المشاعر

271
00:21:37,880 --> 00:21:41,090
.لم نكن لنسرقها أبدًا

272
00:21:41,090 --> 00:21:43,050
...عاكسات

273
00:21:43,050 --> 00:21:44,880
!ريوكا

274
00:21:47,840 --> 00:21:50,060
.أترين؟ أخبرتكِ أنها ستأتي

275
00:21:50,060 --> 00:21:52,470
،مهما بلغت المسافة التي تفصلنا

276
00:21:52,470 --> 00:21:55,600
.هذا هو مكان لقائنا

277
00:21:55,600 --> 00:21:56,850
!ريوكا

278
00:22:00,270 --> 00:22:02,900
.كنت قلقة بشأنك يا أميرو

279
00:22:02,900 --> 00:22:05,150
!أنا آسفة للغاية

280
00:22:09,120 --> 00:22:10,950
.هذه هاناري روكا

281
00:22:12,410 --> 00:22:16,080
.سأفعل ما بوسعي لإعادة مشاعر أميرو-سان

282
00:22:17,370 --> 00:22:20,290
...مشاعري

283
00:22:26,800 --> 00:22:29,090
.أريد اثنتان إن أمكن

284
00:22:29,090 --> 00:22:31,850
.أزهار جديدة

285
00:22:31,850 --> 00:22:36,310
"من أجل فتح أبواب "العالم المشترك
.في أقرب وقت ممكن

286
00:22:40,480 --> 00:22:41,230
:الحلقة 14"

287
00:22:41,230 --> 00:22:43,020
:الحلقة 14"
"الشاهدة التي لم تعد قادرة على الكلام

288
00:24:15,030 --> 00:24:17,870
.أشعر بمشاعرهما تتناغم -
.لكل شخص أسراره -

289
00:24:17,870 --> 00:24:20,870
.أجل، أحاول التصرف بصلابة -
.هناك ما أود إخباركما به -

290
00:24:20,870 --> 00:24:21,830
.أجل، أحاول التصرف بصلابة -
...بشأن يامادا-سان -

291
00:24:21,830 --> 00:24:23,420
...الشخص الذي سلب سوميراغي أميرو مشاعرها -
...بشأن يامادا-سان -

292
00:24:23,420 --> 00:24:24,250
...الشخص الذي سلب سوميراغي أميرو مشاعرها -
.أتساءل إن كنا سنكتشف أمر مشاعري المفقودة -

293
00:24:24,250 --> 00:24:27,210
.لن أستسلم إلى أن نستعيد تلك المشاعر -
.أتساءل إن كنا سنكتشف أمر مشاعري المفقودة -