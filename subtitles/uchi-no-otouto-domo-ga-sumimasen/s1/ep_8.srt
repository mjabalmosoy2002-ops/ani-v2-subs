1
00:01:39,320 --> 00:01:42,490
أنا مُتحمّس جدّاً للمهرجان الثّقافيّ
!الخاصّ بالمدرسة الثّانويّة

2
00:01:42,490 --> 00:01:44,480
هل ستحضرونه جميعاً؟

3
00:01:44,480 --> 00:01:48,580
اليوم، أنا هنا في مدرسة أختي الكبيرة
!وأخي الكبير

4
00:01:48,580 --> 00:01:49,830
!مهلاً، مهلاً، مهلاً، مهلاً

5
00:01:50,120 --> 00:01:50,840
!مُؤلم

6
00:01:50,840 --> 00:01:52,740
لا يجوز أن تُسجّل هذا عشوائيّاً

7
00:01:54,810 --> 00:01:57,880
اليوم هو المهرجان الثّقافيّ الّذي
كنّا ننتظره

8
00:01:58,940 --> 00:02:01,150
،بما أنّنا عمِلنا بجدٍّ للتّحضير له

9
00:02:01,490 --> 00:02:03,370
أنا مُتحمِّسة أكثر حيال هذا

10
00:02:05,390 --> 00:02:07,330
،أتفهّم حماسك

11
00:02:07,330 --> 00:02:08,600
،لكن إذا أزعجت أحداً

12
00:02:08,600 --> 00:02:09,480
فسأطردك من هنا

13
00:02:09,480 --> 00:02:10,300
بئساً

14
00:02:10,300 --> 00:02:12,860
وها أنا ذا، أخطِّط لبثّي الأوّل

15
00:02:12,860 --> 00:02:15,240
أنت صغيرٌ جدّاً على الإنترنت

16
00:02:15,900 --> 00:02:17,530
سيو ليس معك؟

17
00:02:17,530 --> 00:02:19,690
لقد جاء معي إلى هنا

18
00:02:19,690 --> 00:02:23,000
لكن كان الازدحام شديداً، فقال بأنّه
يريد البقاء في مكانٍ أهدأ

19
00:02:23,000 --> 00:02:23,850
آسف

20
00:02:23,850 --> 00:02:24,530
لا أستطيع فعل هذا

21
00:02:24,530 --> 00:02:25,810
اتّصل بي عندما تعود إلى المنزل

22
00:02:25,810 --> 00:02:27,540
أعتقد كان ذلك مُبكّراً جدّاً

23
00:02:28,250 --> 00:02:30,730
!وجدتُ إيتو-تشان

24
00:02:30,730 --> 00:02:31,960
!روي-كن

25
00:02:33,460 --> 00:02:34,890
!أتيت

26
00:02:34,890 --> 00:02:36,400
هل حصلت على خريطة من الآن؟

27
00:02:37,130 --> 00:02:39,300
!تحوّلتِ إلى فأر

28
00:02:39,300 --> 00:02:41,240
هذا لأنّني في لجنة العمل

29
00:02:41,240 --> 00:02:43,350
إنّه ظريفٌ جدّاً. دعيني ألتقط صورة

30
00:02:43,350 --> 00:02:45,190
!لقطة! لقطة

31
00:02:45,190 --> 00:02:46,520
!لقطة

32
00:02:46,520 --> 00:02:49,030
ولا أطيق انتظار رؤية غين-كن كأمير

33
00:02:49,030 --> 00:02:50,970
ستأتين للمُشاهدة معي، صحيح؟

34
00:02:52,840 --> 00:02:53,980
إيتو-تشان؟

35
00:02:54,730 --> 00:02:55,750
!صحيح، بالمُناسبة

36
00:02:55,750 --> 00:02:57,930
،العرض الصّباحيّ للمسرحيّة بدأ بالفعل

37
00:02:57,930 --> 00:02:58,980
لذا اسبقاني

38
00:02:58,980 --> 00:02:59,930
لن تذهبي؟

39
00:03:00,610 --> 00:03:03,140
أعني بأنّني في لجنة العمل، لذا
أنا مشغولة حقّاً

40
00:03:03,140 --> 00:03:04,940
لا أعلم متى سأتفرّغ

41
00:03:04,940 --> 00:03:06,860
ينبغي أن تسبقاني

42
00:03:06,860 --> 00:03:07,850
!إلى اللِّقاء

43
00:03:11,380 --> 00:03:14,160
الوجود في لجنة العمل يبدو مُرهِقاً للغاية

44
00:03:14,160 --> 00:03:17,250
يبدو أنّه يوجد عددٌ أكبر بكثير من النّاس
هنا في هذا العام

45
00:03:17,730 --> 00:03:19,620
الكثير من الأشياء المُلفِتة

46
00:03:24,140 --> 00:03:25,880
،أنا آسفة حقّاً

47
00:03:25,880 --> 00:03:27,510
...لكن أشعر وكأنّني الآن

48
00:03:27,790 --> 00:03:30,080
لا أستطيع النّظر في وجه غين

49
00:03:31,380 --> 00:03:32,490
تُحبّينه، أليس كذلك؟

50
00:03:32,490 --> 00:03:34,010
أقصد ناريتا غين

51
00:03:35,500 --> 00:03:38,600
لأنّني أشعر وكأنّه يستطيع رؤية
ما بداخل عقلي

52
00:03:42,890 --> 00:03:45,440
يا لها من أميرة حسناء

53
00:03:45,910 --> 00:03:48,170
البشرة بيضاء كالثّلج

54
00:03:48,850 --> 00:03:51,050
والشّعر أسود كخشب الأبنوس

55
00:03:51,050 --> 00:03:53,190
والشّفتان قرمزيّتان كالدّم

56
00:03:54,120 --> 00:03:56,520
لا أصدِّق بأنّه رُغم أنّ القدر
،قد جمعنا معاً

57
00:03:56,520 --> 00:03:57,940
...أن تكون ميّتة

58
00:04:20,460 --> 00:04:23,650
كان ذلك... رائعاً للغاية

59
00:04:23,930 --> 00:04:24,920
عجباً

60
00:04:24,920 --> 00:04:26,440
يمكن للمرء فعلها إذا كرّس جهوده في الأمر

61
00:04:26,440 --> 00:04:28,610
كنت رائعاً جدّاً يا يوكيتومو-كن

62
00:04:28,610 --> 00:04:30,380
حسناً، هل حدث شيء؟

63
00:04:30,380 --> 00:04:31,550
ليس تماماً

64
00:04:34,460 --> 00:04:37,260
!مُذهل، كان ذلك مُمتعاً للغاية

65
00:04:37,260 --> 00:04:40,830
لم أكن أعلم بأنّك أمير حقيقيّ

66
00:04:41,650 --> 00:04:43,350
حسناً، هل حدث شيء؟

67
00:04:45,110 --> 00:04:47,010
كما قلتُ، ليس تماماً

68
00:04:48,480 --> 00:04:51,640
...تخيّل وجود شخص مُميّز أمامك

69
00:04:51,870 --> 00:04:53,770
...كنتُ أقول لنفسي فقط

70
00:04:53,770 --> 00:04:57,220
كيف سيبدوان أحمقين إذا فاجأتُهما

71
00:04:59,300 --> 00:05:00,910
عمّن يتكلّم؟

72
00:05:00,910 --> 00:05:01,940
رُبّما أنا؟

73
00:05:01,940 --> 00:05:03,090
هل هو أنا؟

74
00:05:04,010 --> 00:05:05,400
طِلاء، طِلاء

75
00:05:05,750 --> 00:05:06,980
ربت ربت، ربت ربت

76
00:05:06,980 --> 00:05:08,090
ماذا تفعل؟

77
00:05:09,290 --> 00:05:11,400
أستعدّ للعرض التّالي بالطّبع

78
00:05:11,790 --> 00:05:13,780
حضّرتُ قلبي

79
00:05:13,780 --> 00:05:15,300
،لمشهد القبلة التّالي

80
00:05:15,300 --> 00:05:17,220
!لا تتصنّع! امنحني إيّاها بشغف

81
00:05:17,220 --> 00:05:20,170
!سأستجيب بكُلّ ما أوتيت من قوّة

82
00:05:20,170 --> 00:05:21,900
،في العروض السّبعة المُتبقّية

83
00:05:21,900 --> 00:05:24,860
!ستكون هاتان الشّفتان مُلكك

84
00:05:24,860 --> 00:05:28,440
لماذا تقتل حماسي حيال هذا؟

85
00:05:40,100 --> 00:05:42,730
!مُذهل

86
00:05:42,730 --> 00:05:46,260
يبدو أنّ عرض سنو وايت الّذي يؤدّيه الصّفّ الثّالث
لطلّاب السّنة الثّانية قد اكتمل بالفعل

87
00:05:46,260 --> 00:05:47,920
بجدّية؟

88
00:05:47,920 --> 00:05:48,990
هذا جنون

89
00:05:48,990 --> 00:05:51,480
يُفترض أن يكون الأمير وسيماً جداً

90
00:05:51,480 --> 00:05:52,870
!رائع

91
00:05:52,870 --> 00:05:54,750
أتقولين "وسيم"؟

92
00:05:55,350 --> 00:05:57,940
أعتقد بأنّ الجميع يفعلون ما بوسعهم

93
00:05:59,670 --> 00:06:02,170
!يا لها من أميرة جميلة

94
00:06:06,010 --> 00:06:07,500
!هذا سيّئ

95
00:06:07,500 --> 00:06:09,620
!لا يسعني سوى إعادة عيش التّجربة

96
00:06:09,620 --> 00:06:10,800
ماذا تفعلين؟

97
00:06:11,080 --> 00:06:13,630
هل وجدتِ شخصاً للتغيُّب عن المدرسة

98
00:06:13,630 --> 00:06:15,390
!أنا لا أتغيّب عن المدرسة

99
00:06:15,390 --> 00:06:17,640
وهذه أوّل مرّة أراك فيها اليوم أصلاً

100
00:06:17,640 --> 00:06:18,900
ماذا كنتَ تفعل؟

101
00:06:18,900 --> 00:06:19,600
ماذا؟

102
00:06:19,600 --> 00:06:20,930
كنتُ أُقدِّم المُساعدة

103
00:06:20,930 --> 00:06:21,900
صحيح؟

104
00:06:21,900 --> 00:06:24,020
!لمَعان

105
00:06:24,020 --> 00:06:27,670
إرشاد النّاس عبر المدرسة هو جزء
من مهمّة لجنة العمل أيضاً

106
00:06:27,670 --> 00:06:30,660
أنت تُغازلهن حرفيّاً

107
00:06:30,660 --> 00:06:33,690
!إذا احتجتِ أيّ مُساعدة، فأبلغيني فحسب

108
00:06:33,690 --> 00:06:34,550
بالتّأكيد

109
00:06:34,550 --> 00:06:36,660
شكراً أيُّها الجذّاب

110
00:06:36,660 --> 00:06:38,800
لم تضجر من هذا، صحيح؟

111
00:06:38,800 --> 00:06:41,340
ألم تقل بأنّ المُواعدة مُزعجة؟

112
00:06:41,340 --> 00:06:44,110
كما قلتُ، كنتُ أدلّهن فحسب

113
00:06:44,110 --> 00:06:45,890
—لحظة، لا تقولي لي بأنّكِ تغارين

114
00:06:45,890 --> 00:06:47,290
سأعود إلى العمل

115
00:06:48,790 --> 00:06:51,280
مهلاً، إنّه المهرجان الثّقافيّ

116
00:06:51,280 --> 00:06:53,080
لِمَ لا تسترخين قليلاً؟

117
00:06:53,080 --> 00:06:55,510
"المُشكلة الكُبرى تكمن في "تراخي
!لجنة العمل

118
00:06:55,510 --> 00:06:57,430
ها أنتِ ذي من جديد، تتصرّفين بجدّية

119
00:06:57,430 --> 00:06:59,540
هل سبقَ وفكّرتِ في الأمر؟

120
00:06:59,540 --> 00:07:01,940
عندما تقضين كُلَّ وقتكِ تلتزمين
،بالقواعد حرفيّاً

121
00:07:02,200 --> 00:07:05,630
فقد تنشغلين جدّاً عن رؤية الشّيء المُهمّ

122
00:07:06,290 --> 00:07:09,700
يبدو أنّ صفّ أخيكِ الصّغير مُشتعل حماساً

123
00:07:09,700 --> 00:07:11,690
إنّهم يشتهرون

124
00:07:12,150 --> 00:07:13,410
انظري، انظري

125
00:07:15,330 --> 00:07:17,990
أرى بأنّه من الجيّد الاستمرار في مُراقبته

126
00:07:17,990 --> 00:07:20,220
الفتيات اللّواتي رأيتِهن قبل قليل
—يُلاحقن الأمير أيضاً

127
00:07:22,030 --> 00:07:23,460
وكيف لهذا أن يعنيني؟

128
00:07:23,460 --> 00:07:26,830
،لـ-لـ-لطالما كان أخي الصّغير شهيراً

129
00:07:26,830 --> 00:07:28,440
فأين المُشكلة؟

130
00:07:29,270 --> 00:07:31,590
من الواضح أنّها غاية في القلق

131
00:07:31,590 --> 00:07:34,640
على هذا المُعدّل، قد تحصل عليه
مُزعجة مُشاكسة ما

132
00:07:34,640 --> 00:07:35,920
،حتّى لو كنّا عائلة

133
00:07:35,920 --> 00:07:38,040
...لا يحقُّ لي أن أخبره بِمَن يرتبط

134
00:07:38,040 --> 00:07:41,470
أنتِ لا تكترثين إذاً مهما حدث؟

135
00:07:42,090 --> 00:07:46,080
إنّه من النّوع الّذي يحتاج لدفعة
معنويّة واحدة للوقوع في الحُبّ

136
00:07:46,080 --> 00:07:46,830
دفعة؟

137
00:07:46,830 --> 00:07:49,130
الشّباب الّذين يتظاهرون بأنّهم
...غير مُهتمّين بالمُواعدة

138
00:07:49,130 --> 00:07:50,170
...يتظاهرون

139
00:07:50,170 --> 00:07:52,120
،بما أنّهم يُقاومون الإغراء دوماً

140
00:07:52,120 --> 00:07:54,570
فهم أضعف بكثير أمام الإغواء

141
00:07:54,570 --> 00:07:55,670
!ضعيف

142
00:07:57,360 --> 00:07:59,090
...ضعيف أمام الإغواء

143
00:07:59,090 --> 00:08:00,820
...يستسلم للإغراء بسهولة

144
00:08:00,820 --> 00:08:02,720
حالما يقع في الحُبّ، فسوف
تتهافت الفتيات عليه

145
00:08:03,400 --> 00:08:04,830
!يا لها من خطيئة

146
00:08:12,320 --> 00:08:16,850
...عندما نذهب إلى الجحيم... سنكون... معاً

147
00:08:21,600 --> 00:08:22,590
تفضّلي

148
00:08:23,490 --> 00:08:26,910
لِمَ لا تتناولين شيئاً دافئاً وتهدئين؟

149
00:08:26,910 --> 00:08:28,610
شكراً جزيلاً لك

150
00:08:34,730 --> 00:08:36,000
آسف، اتّفقنا؟

151
00:08:37,030 --> 00:08:39,990
ليس وكأنّني قصدتُ إبكاءكِ

152
00:08:42,440 --> 00:08:43,870
"حُبّ"

153
00:08:45,210 --> 00:08:46,600
ماذا يعني هذا حتّى؟

154
00:08:47,930 --> 00:08:50,500
،قلتِ بأنّكِ لا تعرفين معنى الحُبّ

155
00:08:50,810 --> 00:08:53,180
لكن أعتقد بأنّكِ لا تريدين أن
تعرفي فحسب، صحيح؟

156
00:08:53,930 --> 00:08:56,330
أقصد، الانغماس في الأمر سوف
يُعقِّد المسألة ليس إلّا

157
00:08:57,980 --> 00:09:00,860
كنتُ أُفكِّر منذ قلتَ ذلك

158
00:09:02,150 --> 00:09:08,020
أعتقد بأنّ هذه هي الخسارة الكُبرى
الّتي أمرُّ بها في حياتي

159
00:09:09,400 --> 00:09:12,140
هل هو شيء عليكِ التّفكير فيه مليّاً؟

160
00:09:12,140 --> 00:09:13,170
ماذا عنك إذاً؟

161
00:09:13,170 --> 00:09:15,320
ماذا تريد أن تفعل عندما تقع في الحُبّ؟

162
00:09:15,990 --> 00:09:17,290
،إذا جذبَ شخصٌ اهتمامي

163
00:09:17,290 --> 00:09:19,070
فسأبدأ بمُواعدته

164
00:09:19,070 --> 00:09:21,860
!نتكلّم عن "الحُبّ" هنا

165
00:09:21,860 --> 00:09:24,020
وماذا تقصد بـ"سأبدأ"؟

166
00:09:25,870 --> 00:09:28,910
أتحدّث عن شخص بمُجرّد التّفكير فيه

167
00:09:28,910 --> 00:09:30,360
تتسارع نبضات قلبي

168
00:09:30,360 --> 00:09:33,080
عندما يحزن، أشعر بالحزن معه

169
00:09:33,080 --> 00:09:35,880
وعندما نكون معاً، تزداد متعة
الأشياء خمسة أضعاف

170
00:09:36,150 --> 00:09:38,650
،لسنا مُرتبطين بالدّم

171
00:09:38,650 --> 00:09:41,110
لكن مع ذلك أريد البقاء بجانبه للأبد

172
00:09:41,110 --> 00:09:42,230
...هل هذا

173
00:09:42,680 --> 00:09:46,900
هل هذا يعني "الحُبّ" بالفعل؟

174
00:09:48,570 --> 00:09:49,350
...لحظة

175
00:09:49,730 --> 00:09:51,530
...المعذرة

176
00:09:52,050 --> 00:09:56,240
حسناً، لا أقول بأنّني فكّرتُ في
الأمر بهذا العمق من قبل

177
00:09:56,620 --> 00:10:00,240
،لذا لم أفهم سوى نصف ما قلتِه

178
00:10:00,550 --> 00:10:03,740
لكن يبدو هذا "الحُبّ" مُلائماً بالنّسبة لي

179
00:10:04,210 --> 00:10:05,600
إذاً هذا صحيح

180
00:10:05,600 --> 00:10:07,530
...أنا حقّاً

181
00:10:08,250 --> 00:10:10,750
ا-ابتعد عنها

182
00:10:12,200 --> 00:10:13,370
من أنت؟

183
00:10:13,370 --> 00:10:13,980
—سيو-كن

184
00:10:13,980 --> 00:10:15,110
اسمي ناريتا سيو

185
00:10:15,110 --> 00:10:16,170
!المعذرة

186
00:10:17,650 --> 00:10:22,010
!سأجعلك تدفع الثّمن إذا أبكيتَ أونيه-تشان

187
00:10:24,010 --> 00:10:26,450
!لحظة، تمهّل

188
00:10:24,920 --> 00:10:26,450
..."أونيه-تشان"

189
00:10:26,450 --> 00:10:28,520
هناك المزيد من الأخوة الصّغار؟

190
00:10:30,000 --> 00:10:32,370
إنّها محبوبةٌ حقّاً بواسطة مُختلف الأشخاص

191
00:10:33,020 --> 00:10:36,470
إنّها مُمتعة جدّاً حقّاً

192
00:10:38,980 --> 00:10:40,280
ماذا أفعل؟

193
00:10:40,510 --> 00:10:42,530
!هل يُعقَل أن يكون قد سَمِع؟

194
00:10:42,760 --> 00:10:43,970
!سيو-كن، انتظر

195
00:10:43,970 --> 00:10:45,790
لم يكن الأمر كما بدا لك

196
00:10:47,540 --> 00:10:51,130
أقصد بأنّه زلَّ لساني هناك وقلتُ
،بعض الكلام العشوائيّ

197
00:10:51,130 --> 00:10:53,590
...لكن ليس وكأنّ لديّ أي نيّة لـ

198
00:10:53,590 --> 00:10:55,090
عمّاذا تتكلّمين؟

199
00:10:55,090 --> 00:10:57,760
ظننتُ بأنّه كان يُضايقكِ

200
00:10:57,760 --> 00:11:00,340
...أقصد، بدا وكأنّكما كنتُما تتجادلان

201
00:11:00,340 --> 00:11:02,270
!هذا ممتاز. لم يسمع شيئاً

202
00:11:02,270 --> 00:11:04,600
كنّا في اجتماع عمل فحسب

203
00:11:04,600 --> 00:11:07,870
هذا ما كان عليه الأمر إذاً؟

204
00:11:07,870 --> 00:11:09,600
أنا مسرورٌ للغاية

205
00:11:09,600 --> 00:11:13,430
كنتُ متأكّداً بأنّه كان يتنمّر عليكِ

206
00:11:13,430 --> 00:11:16,230
!هذا مُطمئن، هذا مُطمئن

207
00:11:16,230 --> 00:11:17,880
آسفة لأنّني كذبت

208
00:11:20,480 --> 00:11:23,480
لذا أعتقد بأنّني كنتُ وقحاً
جدّاً بحقّ ذلك الرّجل

209
00:11:23,480 --> 00:11:24,420
لا عليك

210
00:11:24,420 --> 00:11:26,950
سأتحمّل المسؤوليّة وأعتذر منه لاحقاً

211
00:11:27,270 --> 00:11:30,210
لكن تأمّل حالك وأنت تتمشّى بمفردك

212
00:11:30,210 --> 00:11:31,840
لقد نضجتَ حقّاً

213
00:11:31,840 --> 00:11:32,610
ليس تماماً

214
00:11:32,610 --> 00:11:35,840
كنتُ أختبئ فحسب ثمّ صادفتُكِ من النّافذة

215
00:11:35,840 --> 00:11:37,050
تختبئ؟

216
00:11:37,050 --> 00:11:39,840
!إيتو-تشان! سيو-كن

217
00:11:39,840 --> 00:11:42,900
!أحضرتْ لي هاتان الفتاتان مجموعة أشياء

218
00:11:42,900 --> 00:11:45,670
!والآن سأخرج في مُواعدة معهما

219
00:11:45,670 --> 00:11:47,540
!روي-ساما مُريح حقّاً

220
00:11:47,540 --> 00:11:48,850
!بجدّية، إنّه ملاك

221
00:11:48,850 --> 00:11:49,690
آسف

222
00:11:49,690 --> 00:11:51,540
أخبريني عندما تحين عودتنا للمنزل

223
00:11:51,540 --> 00:11:53,600
!روي-ساما

224
00:11:53,600 --> 00:11:55,930
!إنّها فتاةٌ تلو الأُخرى

225
00:11:55,930 --> 00:11:57,980
!هذا الفتى أسوأ حتّى

226
00:11:57,980 --> 00:12:00,490
إنّه مشهورٌ من الآن

227
00:12:00,750 --> 00:12:01,740
والآن ماذا؟

228
00:12:01,740 --> 00:12:04,540
هل سيتمكّن من تناول العشاء اللّيلة؟

229
00:12:04,540 --> 00:12:05,780
أنا قلقةٌ للغاية

230
00:12:05,780 --> 00:12:07,740
سيكون بخير

231
00:12:07,740 --> 00:12:09,160
!وجدتُها

232
00:12:09,160 --> 00:12:11,310
هل من مكان تودُّ زيارته؟

233
00:12:11,310 --> 00:12:12,880
سآخذك إلى أيّ مكان

234
00:12:12,880 --> 00:12:13,830
هل أنتِ متأكِّدة؟

235
00:12:14,960 --> 00:12:16,210
...حسناً

236
00:12:16,610 --> 00:12:17,640
...في هذه الحالة

237
00:12:22,290 --> 00:12:24,150
أتيت

238
00:12:24,840 --> 00:12:27,750
ظننتُك مُختبئاً في مكانٍ ما

239
00:12:27,750 --> 00:12:30,470
...في الواقع، أتتْ أونيه-تشان معي، لذا

240
00:12:30,470 --> 00:12:32,630
لم يكن لي خيار في المسألة

241
00:12:32,630 --> 00:12:34,980
في هذه الحالة، أريد الذّهاب لرؤية غين-كن

242
00:12:36,460 --> 00:12:37,480
أنتِ

243
00:12:41,850 --> 00:12:43,420
ما هذا بالضّبط؟

244
00:12:43,420 --> 00:12:45,910
تبدين ظريفة جدّاً

245
00:12:46,280 --> 00:12:47,780
أيقول عنّي ظريفة؟

246
00:12:48,600 --> 00:12:52,200
تبدو رائعاً جدّاً بحدِّ ذاتك

247
00:12:52,760 --> 00:12:54,160
لا تقعي في الحُبّ

248
00:12:54,160 --> 00:12:55,190
!مُحال

249
00:12:55,920 --> 00:12:59,250
لحظة، هل هذا الفتى هو أخٌ آخر
من أخوة ناريتا الصِّغار؟

250
00:13:00,170 --> 00:13:01,780
!أنت ظريفٌ للغاية

251
00:13:01,780 --> 00:13:03,320
تبدو الأصغر سنّاً بالفعل

252
00:13:03,320 --> 00:13:04,220
كم عمرك؟

253
00:13:04,220 --> 00:13:05,290
ما اسمك؟

254
00:13:05,290 --> 00:13:07,930
أخوك الأكبر لا يتنمّر عليك، صحيح؟

255
00:13:06,650 --> 00:13:08,680
...ا-المعذرة

256
00:13:08,680 --> 00:13:10,310
هـ-هل هو بخير؟

257
00:13:10,310 --> 00:13:13,180
ربّما كان من المُبكِّر جدّاً إحضاره
إلى مكانٍ كهذا

258
00:13:13,180 --> 00:13:15,800
سيترتّب عليه الاعتياد على ذلك
في نهاية المطاف

259
00:13:15,800 --> 00:13:18,230
هل أنتِ بخير في أعمالكِ في اللّجنة؟

260
00:13:18,230 --> 00:13:21,190
أقضي استراحتي الرّسميّة، لذا أنا بخير

261
00:13:21,740 --> 00:13:23,260
...صمت مُحرِج

262
00:13:23,690 --> 00:13:27,190
!إذاً سنو وايت هي حديث البلدة فعلاً

263
00:13:27,190 --> 00:13:29,460
...الجميع يقولون بأنّ الأمير فظيع

264
00:13:29,460 --> 00:13:31,800
ماذا؟ لستُ أميراً فظيعاً

265
00:13:31,800 --> 00:13:32,950
أنا أتّخذ هذا الأمر بجدّية

266
00:13:33,170 --> 00:13:35,410
أجل، ليس هذا ما يقصدونه

267
00:13:36,170 --> 00:13:37,760
أنت تتّخذ الأمر بجدّية إذاً

268
00:13:39,420 --> 00:13:41,620
أجل، أنا كذلك

269
00:13:44,110 --> 00:13:45,630
،لا أعلم ما يكون هذا بالضّبط

270
00:13:45,950 --> 00:13:49,470
لكن تبدين دوماً بأنّكِ تستمتعين في القيام
بالأعمال. أعتقد بأنّها عدوى

271
00:13:50,020 --> 00:13:54,600
سنكون معاً دوماً، لذا رُبّما هذا يعني
بأنّنا "عائلة" الآن

272
00:13:56,790 --> 00:13:58,230
،إن كان هذا صحيحاً حقّاً

273
00:13:59,680 --> 00:14:01,930
فأنا في غاية السّرور

274
00:14:03,630 --> 00:14:05,180
أوه أختك هنا؟

275
00:14:03,630 --> 00:14:06,880
"أن يكون غين جزءاً من "العائلة
...الّتي لطالما أردتُها

276
00:14:05,180 --> 00:14:06,170
كيف أبدو؟

277
00:14:06,170 --> 00:14:07,300
فظيع حقّاً

278
00:14:08,340 --> 00:14:10,290
...المسافة بيننا تنكمش تدريجيّاً

279
00:14:11,450 --> 00:14:12,150
،أنتِ

280
00:14:15,910 --> 00:14:17,090
هيّا

281
00:14:17,620 --> 00:14:22,880
حرصَ الجميع على أن تحصلي على
أفضل مقعد في القاعة

282
00:14:30,250 --> 00:14:31,900
...يا مرآة، يا مرآة على الجدار

283
00:14:31,900 --> 00:14:34,820
من الأجمل بينهن جميعاً؟

284
00:14:34,820 --> 00:14:35,770
أعلم بأنّه أنا

285
00:14:35,770 --> 00:14:37,340
أعرف الجواب سلفاً

286
00:14:37,340 --> 00:14:39,120
—بالطّبع، إنّها أنا

287
00:14:39,120 --> 00:14:40,030
أعترض

288
00:14:40,030 --> 00:14:45,000
الأجمل بينهن هي الأميرة سنو وايت

289
00:14:45,000 --> 00:14:46,840
!ماذا قلت؟

290
00:14:49,410 --> 00:14:52,620
أنا الأميرة سنو وايت

291
00:14:53,330 --> 00:14:54,740
أنا لذيذة

292
00:14:54,970 --> 00:14:57,730
يا إلهي. يا لها من تفّاحة تبدو شهيّة

293
00:14:58,090 --> 00:14:59,330
أنا لذيذة

294
00:14:59,330 --> 00:15:01,210
...ها أنا ذي

295
00:15:01,210 --> 00:15:02,250
قضمة

296
00:15:02,250 --> 00:15:03,940
نمنمنمنم

297
00:15:11,130 --> 00:15:12,550
أنا شهيّة

298
00:15:15,500 --> 00:15:18,040
!الأميرة سنو وايت قد ماتت

299
00:15:18,040 --> 00:15:21,330
!افتحي عينيكِ أرجوكِ يا أميرة سنو وايت

300
00:15:22,310 --> 00:15:23,670
!ها هو

301
00:15:23,670 --> 00:15:25,150
!إنّه الأمير

302
00:15:33,890 --> 00:15:36,540
يا لها من أميرة حسناء

303
00:15:36,910 --> 00:15:39,550
شعرها أسود كخشب الأبنوس

304
00:15:39,550 --> 00:15:41,920
وشفتاها قرمزيّتان كالدّم

305
00:15:43,050 --> 00:15:45,400
متى بدأتُ "أُحبّه"؟

306
00:15:47,370 --> 00:15:48,550
ما هذا بالضّبط؟

307
00:15:48,550 --> 00:15:51,760
وأنا الّذي كنتُ هنا جاهزاً
للمجيء وإحضاركِ

308
00:15:52,020 --> 00:15:53,640
أهلاً بعودتكِ يا إيتو

309
00:15:54,010 --> 00:15:57,090
لعلّ ذلك كان منذ "أهلاً بعودتك" تلك

310
00:15:57,660 --> 00:16:01,390
شعرتُ وكأنّني مطلوبة فعلاً، وأسعدَني ذلك

311
00:16:04,890 --> 00:16:06,320
لا داعي للقلق

312
00:16:06,320 --> 00:16:09,400
سأطمس هذا الإحساس بعناية

313
00:16:09,890 --> 00:16:10,720
هل أنتِ حمقاء؟

314
00:16:10,720 --> 00:16:14,660
أتعتقدين بأنّ القيام بأشياء لم نطلبها
منكِ سيجعلنا سُعداء؟

315
00:16:15,290 --> 00:16:17,700
كلامه شديدٌ دوماً ولئيم

316
00:16:18,280 --> 00:16:19,410
...لكن وقتها

317
00:16:19,410 --> 00:16:21,290
يفيض دوماً بالحنان

318
00:16:22,290 --> 00:16:24,160
هذا مَن وقعتُ في حُبّه

319
00:16:35,820 --> 00:16:37,640
...هناك أكثر ممّا هو كافٍ بالنّسبة لي

320
00:16:39,930 --> 00:16:42,320
لأعتبر هذا أفضل نوع من الحُبّ

321
00:16:48,270 --> 00:16:50,280
!روي-ساما، أراك قريباً

322
00:16:48,610 --> 00:16:52,190
يبدو أنّ سيو-كن وروي-كن استمتعا كثيراً

323
00:16:50,280 --> 00:16:52,190
!إلى اللّقاء

324
00:16:52,690 --> 00:16:54,480
!أحسنتم صنعاً جميعاً

325
00:16:54,480 --> 00:16:56,320
!تأثّرتُ كثيراً

326
00:16:56,670 --> 00:16:57,350
تفضّل

327
00:16:57,350 --> 00:16:59,200
اشتريتُ مجموعة من الأشياء العشوائيّة

328
00:16:59,200 --> 00:17:00,540
!بعض الأكلات الخفيفة

329
00:17:00,540 --> 00:17:01,670
شكراً لكِ

330
00:17:01,670 --> 00:17:03,170
ماذا؟ أين غين؟

331
00:17:03,170 --> 00:17:05,080
إن كنتِ تقصدين سموّه، انظري تحت

332
00:17:05,080 --> 00:17:06,010
تحت؟

333
00:17:10,820 --> 00:17:13,320
ستائر فوق السّتائر؟

334
00:17:17,760 --> 00:17:19,140
شكراً لعملك

335
00:17:27,600 --> 00:17:28,920
اختبار، اختبار

336
00:17:29,610 --> 00:17:34,820
مُسابقة كاراوكي ما بعد الحفلة" الخاصّة"
!بمهرجان سيشو على وشك البدء

337
00:17:34,820 --> 00:17:37,860
!لنُكرّس كُلّ مشاعرنا في الغناء

338
00:17:37,860 --> 00:17:40,580
!ننتظر اشتراككم بلهفة

339
00:17:40,970 --> 00:17:44,080
!لنُغنِّ جميعاً بملء قلوبنا

340
00:17:44,420 --> 00:17:48,570
التّسجيل لمُسابقة كاراوكي ما بعد
!الحفلة يجري هنا

341
00:17:48,570 --> 00:17:49,830
إيتو-تشان

342
00:17:49,830 --> 00:17:51,800
المهرجان انتهى تماماً

343
00:17:51,800 --> 00:17:53,420
أعتقد يمكنك خلع هذا

344
00:17:53,420 --> 00:17:54,770
عفواً؟

345
00:17:54,770 --> 00:17:56,970
المهرجان لا ينتهي ما لم نعُد إلى المنزل

346
00:17:56,970 --> 00:17:58,670
ما هذا الإحساس بالواجب؟

347
00:17:58,670 --> 00:17:59,970
!المعذرة

348
00:17:59,970 --> 00:18:02,090
نرغب في الدّخول كزوجين

349
00:18:02,090 --> 00:18:03,850
هل يمكننا التّسجيل رغم ذلك؟

350
00:18:03,850 --> 00:18:06,230
أخبرتُك سلفاً، لن أفعل هذا

351
00:18:06,230 --> 00:18:08,920
!على أيّ حال، دعني أُبدِّل ملابسي فحسب

352
00:18:08,920 --> 00:18:11,620
هيّا! لنذهب هكذا

353
00:18:11,620 --> 00:18:14,480
هنا لدينا اشتراك لثنائي

354
00:18:14,480 --> 00:18:17,490
هل ترغبان في المُنافسة في النّصف
الأوّل أم الثّاني؟

355
00:18:17,490 --> 00:18:21,630
لا أفهم شخصاً يريد الغناء أمام الآخرين. ماذا؟

356
00:18:21,630 --> 00:18:23,230
أنت أصمّ النّغم؟

357
00:18:23,230 --> 00:18:24,210
اصمت

358
00:18:24,210 --> 00:18:25,850
ألن تفعلها حقّاً؟

359
00:18:25,850 --> 00:18:28,490
لكنّها فُرصة جيّدة للاعتراف اعترافاً مُبهراً

360
00:18:29,000 --> 00:18:30,650
هذا يحدث في كلّ عام

361
00:18:30,650 --> 00:18:33,030
إخبار شخص "أُحبّك" على خشبة المسرح

362
00:18:33,030 --> 00:18:35,760
أعتقد بأنّك خائف

363
00:18:35,760 --> 00:18:38,890
ماذا لو رُفِضت أمام جميع أولئك النّاس؟

364
00:18:39,770 --> 00:18:41,110
...في الواقع

365
00:18:41,820 --> 00:18:43,750
يبدو أنّ لديك الكثير من وقت الفراغ

366
00:18:44,780 --> 00:18:47,210
سواء كان هناك شخص أريد أن
...أقول ذلك له

367
00:18:47,210 --> 00:18:49,210
لا علاقة لك بالأمر

368
00:18:49,520 --> 00:18:52,770
لا أفهم لِمَ تظلّ تحشر أنفك
في شؤون الآخرين

369
00:18:55,780 --> 00:18:57,800
لحظة، هل تقصد بأنّه يوجد شخص؟

370
00:18:57,800 --> 00:18:59,540
هل هو رُبّما... موي؟

371
00:18:59,540 --> 00:19:00,060
اصمت

372
00:19:00,060 --> 00:19:01,780
هل سمعتِ ذلك؟

373
00:19:02,050 --> 00:19:04,290
!يتكلّم بتلك النّبرة مع زميله السّينباي

374
00:19:04,290 --> 00:19:05,410
!مُخيف للغاية

375
00:19:05,410 --> 00:19:07,870
لا أعلم ما الّذي ترينه في فتى
سليط اللّسان مثله

376
00:19:07,870 --> 00:19:10,890
هلّا توقّفت عن استفزازه من فضلك؟

377
00:19:11,790 --> 00:19:13,540
مهلاً، مهلاً

378
00:19:14,290 --> 00:19:17,140
كنتِ تلعبين دور الشّخص المُلتزم
طوال هذا الوقت

379
00:19:17,140 --> 00:19:20,620
،الشّخص الّذي تُحبّينه بمتناول قبضتكِ

380
00:19:20,620 --> 00:19:22,800
فما الّذي تخشينه بالضّبط؟

381
00:19:23,120 --> 00:19:24,750
هذا واضح

382
00:19:25,180 --> 00:19:27,170
،تقاربنا أخيراً كعائلة

383
00:19:27,170 --> 00:19:28,810
ولا أريد إفسادها

384
00:19:29,210 --> 00:19:31,080
أقصد، ليس وكأنّني لم أفكّر أبداً

385
00:19:31,080 --> 00:19:33,060
بشأن ما لو أنّنا التقينا بطريقة طبيعيّة

386
00:19:33,440 --> 00:19:37,570
لكنّني سعيدةٌ حقّاً بأنّني أستطيع
أن أكون "أونيه-تشان" بالنّسبة لهم

387
00:19:37,860 --> 00:19:41,640
إنّ كسر تلك العلاقة بعد أن قبِلوني بذلك الشّكل

388
00:19:41,640 --> 00:19:43,200
سيكون خيانة

389
00:19:43,200 --> 00:19:45,790
،إذا حصل غين على حبيبة في المُستقبل

390
00:19:45,790 --> 00:19:47,190
فسأكون بجانبه أرعاه

391
00:19:47,190 --> 00:19:49,710
سأحرص حتّى على تقدير حبيبته أيضاً

392
00:19:50,260 --> 00:19:53,460
ما دام غين يبتسم، فأنا سعيدة

393
00:19:54,200 --> 00:19:57,790
أعتقد بأنّ هذه طريقة مقبولة لحُبّ شخص

394
00:19:59,460 --> 00:20:01,990
هل أقول كلاماً غريباً؟

395
00:20:07,960 --> 00:20:09,030
آسف، آسف

396
00:20:09,030 --> 00:20:11,010
هذا الزيّ تأثيره شديد

397
00:20:11,010 --> 00:20:14,100
فقدتُ تركيزي في مُنتصف الكلام

398
00:20:14,100 --> 00:20:19,490
لكن فهمتُ بأنّ حُبّكِ في بُعد
آخر عن الحُبّ الّذي أعرفه

399
00:20:22,150 --> 00:20:24,200
قد أشعر بالغيرة قليلاً حتّى

400
00:20:24,200 --> 00:20:26,810
شخص مثلي مُحال أن يستطيع
تجربة تقليد الشّعور

401
00:20:26,810 --> 00:20:29,620
بحُبّ نقيّ كهذا تجاه شخص

402
00:20:31,860 --> 00:20:34,620
!ستبدأ مُسابقة الكاراوكي الآن

403
00:20:34,620 --> 00:20:36,200
!ماتسودا-سان من السّنة الثّانية، الصّفّ اثنان

404
00:20:36,200 --> 00:20:38,380
!سأغنّي لكم اللّيلة

405
00:20:40,820 --> 00:20:42,840
لقد بدأت

406
00:20:42,840 --> 00:20:44,600
إنّهم يفعلونها حقّاً

407
00:20:44,600 --> 00:20:46,260
لا أُصدِّق ذلك أيضاً

408
00:20:50,580 --> 00:20:55,160
لكن لا بُدّ أنّه شعور رائع أن ينفتح
المرء تماماً أمام الآخرين

409
00:20:57,900 --> 00:21:01,400
هل يتكلّم من مُنطلق الحسد؟

410
00:21:01,850 --> 00:21:05,660
أعتقد لن تعرف ما إن كان شعوراً جميلاً
أو لا ما لم تُجرّبه

411
00:21:05,660 --> 00:21:08,570
ماذا؟ ستبدئين بإلقاء مُحاضرة عليّ الآن؟

412
00:21:08,570 --> 00:21:10,920
كنتُ أقول ما يدور في ذهني فحسب

413
00:21:10,920 --> 00:21:14,410
كنتُ أقول لنفسي بأنّك لست
شخصاً سيّئاً تماماً

414
00:21:14,760 --> 00:21:16,320
،تقول بأنّك هكذا أو ذاك

415
00:21:16,320 --> 00:21:19,550
لكن ألا تتكيّف مع طريقة نظرة النّاس لك؟

416
00:21:19,550 --> 00:21:22,320
بصراحة، هذا يجعل الأمور تبدو أسهل

417
00:21:22,320 --> 00:21:24,410
لا يبدو أنّك تُحبّ الأمور المُعقّدة

418
00:21:26,800 --> 00:21:29,730
أحياناً، تجعل هذه الفتاةُ قلبي يخفق

419
00:21:30,040 --> 00:21:32,080
أتحاولين تجريدي من كافّة طبقاتي؟

420
00:21:32,080 --> 00:21:35,970
لِمَ لا تنتهز هذه الفُرصة وتكشف
عن شيء على المسرح؟

421
00:21:35,970 --> 00:21:38,130
لا وقت أفضل من المهرجان

422
00:21:41,250 --> 00:21:43,820
أظنّني بخير حاليّاً

423
00:21:44,740 --> 00:21:47,910
جُلّ ما أريده هو أن أُظهِر حقيقتي
لذلك الشّخص المُميّز

424
00:21:48,780 --> 00:21:53,290
أظنّني سأبقى على مبدأ الأمان
حتّى أستطيع أن أُظهِر له

425
00:21:56,210 --> 00:21:57,750
آسفة لأنّني تطفّلت

426
00:21:58,200 --> 00:22:00,360
حقيقتي"؟"

427
00:22:01,160 --> 00:22:02,110
المعذرة

428
00:22:02,110 --> 00:22:03,550
أتيتُ للتّسجيل

429
00:22:03,550 --> 00:22:04,840
!حسناً

430
00:22:05,300 --> 00:22:07,850
،تحمّستُ وأثقلتُ العيار

431
00:22:07,850 --> 00:22:09,970
لكن لا أعلم ما إن كنتُ أستطيع
الاحتفاظ بهذا السّرّ

432
00:22:12,100 --> 00:22:15,950
أنا لا أُجيد الكذِب حقّاً