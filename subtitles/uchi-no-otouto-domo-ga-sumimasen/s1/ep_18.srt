1
00:00:01,400 --> 00:00:03,140
سنبدأ الآن ببرنامجنا النّهاريّ

2
00:00:03,510 --> 00:00:06,480
حدثنا الأوّل هو مُنافسة التشجيع

3
00:00:16,740 --> 00:00:18,980
!هيّا

4
00:00:26,820 --> 00:00:30,460
في الحقيقة، لا أريد رؤيتهما
يُواجهان بعضهما الآخر

5
00:00:31,370 --> 00:00:32,200
...لكن

6
00:00:32,760 --> 00:00:35,930
أم أنّكِ تعتقدين أيضاً بأنّني سأخسر حتماً؟

7
00:00:35,930 --> 00:00:40,060
لا أعتقد بأنّ غين-كن سيتغيّر من خلال الكلام

8
00:00:41,050 --> 00:00:42,390
هل ستُشاهدينني؟

9
00:00:43,210 --> 00:00:45,210
لن تكون معركة غبيّة الآن

10
00:00:45,210 --> 00:00:46,440
سأفعلها كما ينبغي

11
00:00:46,770 --> 00:00:52,010
...وإن صادفَ أن... ربحتُ ضدّ غين-كن

12
00:00:53,570 --> 00:00:55,060
!فسأخبركِ حينها

13
00:00:59,040 --> 00:01:02,750
فقرتنا التّالية، معركة ركوب الظّهر حيث
تتنافس كافّة السّنوات الدّراسيّة

14
00:01:04,210 --> 00:01:06,080
!هيّا بنا أيّها الفريق الأزرق

15
00:01:06,080 --> 00:01:08,830
!لا تخسروا أيّها الفريق الأزرق

16
00:01:06,080 --> 00:01:08,830
أوّلاً، لدينا الفريق الأزرق ضدّ الفريق الأبيض

17
00:01:11,590 --> 00:01:18,100
الفريق صاحب أكثر ثنائيّين سليمين
سيتأهّل للجولة المُقبلة

18
00:01:22,470 --> 00:01:23,950
!سنفعلها

19
00:01:23,950 --> 00:01:25,910
!هاجموني بكلّ قوّتكم

20
00:01:27,080 --> 00:01:29,620
...استعداد، هيّا

21
00:03:12,490 --> 00:03:14,590
!فوراً، إنّها فوضى حقيقيّة

22
00:03:14,590 --> 00:03:16,250
هل الفريق الأزرق مُتقدِّم قليلاً؟

23
00:03:23,590 --> 00:03:24,660
!فعلَها

24
00:03:24,660 --> 00:03:26,010
!قوّة الأخ الأكبر

25
00:03:26,010 --> 00:03:27,360
!هذا هو المُفضَّل لدينا

26
00:03:27,360 --> 00:03:28,860
!هذا شديد

27
00:03:28,860 --> 00:03:30,540
!صحيح، أين سيو-كن؟

28
00:03:35,180 --> 00:03:36,250
هذا مُطمئن

29
00:03:36,250 --> 00:03:37,970
ما زال في المُنافسة

30
00:03:37,970 --> 00:03:41,150
يبدو أنّه بدأ أخيراً يا ناريتا-سان

31
00:03:41,380 --> 00:03:44,280
كيف ستنتهي هذه المعركة برأيكِ؟

32
00:03:44,280 --> 00:03:46,790
أيّ شيء قد يحدث

33
00:03:46,790 --> 00:03:50,520
في حين أنّ الأخ الثّالث النيِّق يبدو
،في موقف ضعيف جدّاً

34
00:03:50,520 --> 00:03:52,720
طفرة النموّ الأخيرة تلك منحَتْه
،مسافة وصول أفضل

35
00:03:52,720 --> 00:03:55,040
ناهيك عن عقل لاعب فيديو

36
00:03:55,040 --> 00:03:56,570
ماذا تفعل؟

37
00:03:56,570 --> 00:03:57,740
تعليق حيّ مُزيَّف

38
00:03:57,740 --> 00:03:59,210
يمكنكِ الانضمام أيضاً

39
00:03:59,210 --> 00:04:00,670
لا، لا داعي

40
00:04:00,670 --> 00:04:03,680
!يبدو أنّها ستكون معركة شقيقين شديدة

41
00:04:03,680 --> 00:04:05,550
من تُشجِّعين؟

42
00:04:05,550 --> 00:04:08,510
أيُّهما؟ حسناً، كلاهما

43
00:04:08,800 --> 00:04:10,900
واحد لكلّ ذِراع، صحيح؟

44
00:04:10,900 --> 00:04:13,140
أنتِ امرأةٌ خطيرة

45
00:04:13,140 --> 00:04:14,730
متى تعلّمَ هذه الأشياء؟

46
00:04:14,730 --> 00:04:16,880
...لا! هذا ليس ما أنا

47
00:04:16,880 --> 00:04:19,730
!يا للهول! يبدو أنّهما على وشك المُواجعة

48
00:04:27,210 --> 00:04:29,110
أرى بأنّك لا تزال صامداً

49
00:04:29,110 --> 00:04:30,740
لنفعلها إذاً

50
00:04:30,740 --> 00:04:32,020
!مُخيف

51
00:04:32,020 --> 00:04:35,130
!هذا هو "الغوريلّا الأزرق!" السّنة الثّالثة

52
00:04:36,290 --> 00:04:38,040
!انسحبوا! انسحبوا

53
00:04:38,880 --> 00:04:39,650
أيهربون؟

54
00:04:39,650 --> 00:04:41,290
كانوا يُواجهون غوريلّا حرفيّاً

55
00:04:41,680 --> 00:04:42,920
!ا-انتظروا

56
00:04:42,920 --> 00:04:43,680
!مُحال

57
00:04:43,680 --> 00:04:45,720
!لا نستطيع هزيمة الغوريلّا الأزرق

58
00:04:45,720 --> 00:04:48,010
حسناً، إنّه غوريلّا، لكن يجب أن
نبذل قصارى جهدنا

59
00:04:48,010 --> 00:04:49,140
،إذا أسقطناه

60
00:04:49,140 --> 00:04:51,520
فسيُشكِّل ذلك ضربةً قاسِمة لصفوفهم

61
00:04:51,520 --> 00:04:52,520
!هل جُنِنت؟

62
00:04:52,520 --> 00:04:55,260
!مُواجهة زعيم كهذا هي انتحار

63
00:04:55,260 --> 00:04:57,560
نحن مُجرّد بيادق هنا

64
00:04:57,560 --> 00:05:01,140
سكيون من الأفضل أن نحاول
!اختيار أهداف أسهل

65
00:05:01,140 --> 00:05:01,980
أنت مُخطئ

66
00:05:02,450 --> 00:05:03,990
!لسنا بيادق

67
00:05:06,010 --> 00:05:08,790
!لو كان ذلك صحيحاً، لما بقينا واقفين هنا

68
00:05:08,790 --> 00:05:12,910
،لكن ما زال أمامنا جداراً لصعوده
!أمام أنظارنا مُباشرة

69
00:05:15,590 --> 00:05:16,660
!ناريتا

70
00:05:16,660 --> 00:05:17,920
!أنا فخورٌ جدّاً بك

71
00:05:17,920 --> 00:05:21,340
!أنت مليء بالمُفاجآت حقّاً

72
00:05:21,340 --> 00:05:23,340
!بالتّوفيق يا يامادا-سان

73
00:05:23,340 --> 00:05:24,480
!مرحى

74
00:05:24,480 --> 00:05:25,590
!ها هي الذّروة

75
00:05:37,020 --> 00:05:39,100
انظر إلى ذِراعيك النّحيلتين

76
00:05:39,450 --> 00:05:42,370
ضئيلتان جدّاً بالرّغم من تدريبك السّرّيّ

77
00:05:48,160 --> 00:05:50,060
لا تستهن بي

78
00:05:50,060 --> 00:05:52,910
توقّعتُ بأنّني لن أربح أبداً
بمُهاجمتك ببساطة فقط

79
00:05:54,480 --> 00:05:56,990
هذه فكرة طريفة

80
00:05:56,990 --> 00:05:58,180
عيناك تدمعان

81
00:05:58,180 --> 00:05:59,050
هل أنت بخير؟

82
00:05:59,050 --> 00:05:59,870
!إنّهما ليستا كذلك

83
00:05:59,870 --> 00:06:00,950
!لا تسهر من أخيك الكبير

84
00:06:02,520 --> 00:06:06,360
رايت؟ هذه إحدى طِباعك السّيّئة

85
00:06:06,360 --> 00:06:07,280
ماذا؟

86
00:06:07,280 --> 00:06:09,340
دائماً ما تُغيِّر الموضوع هكذا

87
00:06:09,680 --> 00:06:12,600
لهذا السّبب لا تملك فكرة
!عمّا تشعر به فعليّاً

88
00:06:12,600 --> 00:06:16,080
ألست مُعرَّضاً لهجمات خلسة
لأنّ رأسك ويديك

89
00:06:16,080 --> 00:06:17,980
مشغولون دوماً بلعِب دور الأخ الأكبر؟

90
00:06:18,770 --> 00:06:20,890
أنت مُزعجٌ حقّاً

91
00:06:20,890 --> 00:06:24,030
ماذا عساني أفعل غير لعِب
دور الأخ الأكبر؟

92
00:06:25,880 --> 00:06:29,180
تتصرّف وكأنّك كشفت أمري تماماً

93
00:06:29,730 --> 00:06:32,450
أتظنُّ بأنّني سأدعكم تعرفون شعوري
،بعد كُلّ هذا الوقت

94
00:06:33,090 --> 00:06:37,440
في حين أنّكم تستطيعون دوماً
!قول ما تشاؤون فحسب؟

95
00:06:37,440 --> 00:06:38,040
...غين-كن

96
00:07:06,810 --> 00:07:09,690
المعركة بين الفريق الأزرق والفريق
!الأبيض قد انتهت

97
00:07:15,480 --> 00:07:18,490
هذا يختتم كافّة الفعاليّات

98
00:07:19,140 --> 00:07:22,870
ينبغي للتّلاميذ الآن أن يستعدّوا
لمراسم الاختتام

99
00:07:27,130 --> 00:07:27,930
ماذا؟

100
00:07:29,670 --> 00:07:31,660
ما الّذي أفعله هنا؟

101
00:07:48,420 --> 00:07:51,240
تذكّرت، سقطتُ في معركة حمل على الظّهر

102
00:07:51,240 --> 00:07:52,410
!هذا مُحرِج للغاية

103
00:07:52,990 --> 00:07:55,370
...وأنا الّذي كنتُ قد تحدّيتُه

104
00:07:57,670 --> 00:07:58,990
...سيو-كن

105
00:07:59,300 --> 00:08:00,910
—إيتو-تشا

106
00:08:00,180 --> 00:08:02,260
!هذا مُطمئن

107
00:08:02,260 --> 00:08:06,630
!لم أعرف ماذا أفعل لو لم تستيقظ ثانية

108
00:08:07,160 --> 00:08:09,750
ماذا حدث منذ ذلك الحين؟

109
00:08:09,750 --> 00:08:12,130
...أتذكّر وقائع مُبهَمة فحسب

110
00:08:12,130 --> 00:08:16,360
لذا، سقطتَ في معركة الحمل على الظّهر
،ولم تحرك ساكناً

111
00:08:16,360 --> 00:08:18,890
لذا حملَك غين إلى هنا

112
00:08:19,600 --> 00:08:21,140
هكذا إذاً

113
00:08:21,140 --> 00:08:24,140
مهلاً. سأحضر مشروبات لنا

114
00:08:24,900 --> 00:08:27,140
يبدو أنّك لم تتعرّض لجروح بليغة

115
00:08:29,150 --> 00:08:30,150
شكراً لك

116
00:08:30,790 --> 00:08:32,630
لماذا أنا الضّعيف دوماً؟

117
00:08:33,210 --> 00:08:35,330
بعد كُلّ هذا، انتهى المطاف بحاجتي للمُساعدة

118
00:08:35,850 --> 00:08:37,220
ما الّذي أفعله أصلاً؟

119
00:08:37,700 --> 00:08:42,280
مهما حاولت، لا أستطيع الفوز على البطل

120
00:08:42,790 --> 00:08:45,500
وبعد؟ ماذا تريدني أن أفعل؟

121
00:08:45,850 --> 00:08:49,290
...لو... لو ربحتُ

122
00:08:51,820 --> 00:08:52,490
لا مُشكلة

123
00:08:52,490 --> 00:08:54,150
سأفعل أيّ ما تقوله

124
00:08:54,150 --> 00:08:55,590
هذا ما اتّفقنا عليه

125
00:08:55,590 --> 00:08:59,050
لا، أنت من يُفترض له أن يدعني أفعل شيئاً

126
00:09:00,650 --> 00:09:02,880
ماذا؟

127
00:09:02,880 --> 00:09:06,170
مرحباً؟ على الخاسر أن يُطيع أمراً
واحداً من الرّابح

128
00:09:07,050 --> 00:09:09,150
لكن أنت من ربح؟

129
00:09:09,150 --> 00:09:09,760
ماذا؟

130
00:09:10,090 --> 00:09:12,110
!هل أنت من يسخر منّي الآن؟

131
00:09:12,110 --> 00:09:14,320
إذاً ما هذا الّذي بيدك اليُمنى؟

132
00:09:14,320 --> 00:09:15,580
...ماذا تقصد

133
00:09:19,700 --> 00:09:20,650
!ماذا؟

134
00:09:21,160 --> 00:09:23,080
أنت لا تتذكّر فعلاً، أليس كذلك؟

135
00:09:43,490 --> 00:09:46,980
حاولتُ إنقاذك فنشلتَ هذا منّي أيُّها الشّرّير

136
00:09:47,910 --> 00:09:50,970
إذاً... ربحتُ؟

137
00:09:50,970 --> 00:09:53,110
من حيث القواعد، غالباً أجل

138
00:09:53,420 --> 00:09:54,510
...هكذا إذاً

139
00:09:54,510 --> 00:09:56,280
!كُن سعيداً إذاً، اللّعنة

140
00:09:56,280 --> 00:09:58,490
!هذا مُهينٌ جدّاً بالنّسبة لي

141
00:09:59,120 --> 00:10:01,420
لا أشعر بأنّني ربحتُ إطلاقاً

142
00:10:01,730 --> 00:10:03,490
وكنتُ أوّل من سقط

143
00:10:03,490 --> 00:10:06,460
يا إلهي، أنت تُعقِّد كافّة الأمور حقّاً

144
00:10:07,050 --> 00:10:11,170
فضلاً عن ذلك، هذا يُذكّرني حقّاً
بالعائلة من جديد

145
00:10:11,170 --> 00:10:13,420
مدى روعتك كأخ أكبر

146
00:10:13,420 --> 00:10:15,090
ما الّذي تتحدّث عنه؟

147
00:10:15,090 --> 00:10:17,600
سلّيتَني، أليس كذلك؟

148
00:10:18,010 --> 00:10:20,040
،كان بوسعك أن تدعني أُدمِّر نفسي فقط

149
00:10:20,040 --> 00:10:22,080
لكن خاطرتَ لإنقاذي

150
00:10:22,080 --> 00:10:23,970
هذا هُراء. أنت تُبالغ في التّفكير

151
00:10:25,190 --> 00:10:26,380
فهمت

152
00:10:26,780 --> 00:10:31,230
لفترة طويلة، كُلّ ما فعلتَه كان التّفكير
في بقيّتنا

153
00:10:33,640 --> 00:10:36,190
لدرجة أنّك أصبحتَ أصمّاً لمشاعرك الخاصّة

154
00:10:38,060 --> 00:10:39,280
أنا آسف

155
00:10:40,660 --> 00:10:41,570
شكراً لك

156
00:10:45,300 --> 00:10:47,380
أودّ أن أطلب منك  طلباً واحداً فقط

157
00:10:54,060 --> 00:10:56,880
إلى أين أنت ذاهب يا سيو-كن؟

158
00:10:58,880 --> 00:11:01,750
طلبتُ منك انتظاري هنا

159
00:11:01,750 --> 00:11:04,050
آسف. أنا بخير تماماً الآن

160
00:11:04,050 --> 00:11:05,890
هل أنت متأكّد؟

161
00:11:05,890 --> 00:11:07,280
أجل، أنا متأكّد

162
00:11:07,590 --> 00:11:09,560
ولم يبقَ سوى مراسم الاختتام الآن

163
00:11:09,560 --> 00:11:12,030
غين-كن ينتظر هناك، لكن سأغادر

164
00:11:14,900 --> 00:11:16,640
ما-ماذا؟

165
00:11:16,640 --> 00:11:18,900
بالمُناسبة، ماذا كان ذلك على أّ حال؟

166
00:11:19,360 --> 00:11:20,700
ماذا تقصدين؟

167
00:11:20,700 --> 00:11:22,800
الكلام الّذي قلتَ بأنّك ستخبرني
به عندما تربح

168
00:11:23,690 --> 00:11:26,150
...هذا

169
00:11:27,530 --> 00:11:29,790
...وإن صادفَ أن... ربحتُ ضدّ غين-كن

170
00:11:31,370 --> 00:11:32,490
مُدهش للغاية

171
00:11:32,490 --> 00:11:34,030
ربحتَ ضدّ غين

172
00:11:34,030 --> 00:11:34,790
آسفة

173
00:11:34,790 --> 00:11:36,210
استهنتُ بك

174
00:11:38,470 --> 00:11:40,630
هذا أقرب إلى التّعادُل

175
00:11:40,630 --> 00:11:42,260
هذا غير صحيح

176
00:11:42,260 --> 00:11:44,820
كنتَ رائعاً حقّاً، منذ البداية

177
00:11:44,820 --> 00:11:48,850
أنا واثقة بأنّ غين يُفكِّر في الأمر
الآن بينما هو غاضب

178
00:11:48,850 --> 00:11:50,460
...رُبّما

179
00:11:50,460 --> 00:11:53,070
لكن يصبُّ هذا في صالحنا حقّاً

180
00:11:53,440 --> 00:11:56,140
،لم أرتح لفكرة قِتال بعضكما الآخر

181
00:11:56,140 --> 00:11:58,100
لكن أعتقد بأنّه كان يوجد معنى وراء ذلك

182
00:11:58,430 --> 00:12:01,030
أعتقد بأنّ هذه الرّسالة كانت
شديدة الوضوح

183
00:12:01,030 --> 00:12:04,250
بأنّك لم تعُد بحاجته

184
00:12:04,660 --> 00:12:08,070
من ناحيته، يجدر به أن يتعلّم كيف
،يترك أخاه مُستقلّاً

185
00:12:08,070 --> 00:12:10,160
وذلك كي يسترخي بحدِّ ذاته أكثر قليلاً

186
00:12:11,870 --> 00:12:14,120
آمل أن يفعل حقّاً

187
00:12:14,900 --> 00:12:16,950
!آسفة، توّلَ الأمر إلى حِوار حول غين

188
00:12:17,390 --> 00:12:20,020
لا يوجد الكثير لمُناقشته عنّي، لذا لا تقلقي

189
00:12:20,550 --> 00:12:22,590
أعتذر منكِ، لأنّني أعطيتُ انطباعاً خاطئاً

190
00:12:22,590 --> 00:12:24,390
هل أنت متأكّد؟

191
00:12:24,720 --> 00:12:27,430
إن كنتَ مُتردّداً، فليس عليك ذلك صدِّقني

192
00:12:27,430 --> 00:12:28,930
!لستُ كذلك، لستُ كذلك

193
00:12:28,930 --> 00:12:30,700
وعد؟

194
00:12:31,410 --> 00:12:34,900
...فـ-في الواقع

195
00:12:34,900 --> 00:12:35,530
نعم؟

196
00:12:36,100 --> 00:12:37,920
،إذا صادفَ وفزتُ ضدّ غين-كن

197
00:12:37,920 --> 00:12:40,360
فسوف يكتئب كثيراً بسبب ذلك، صحيح؟

198
00:12:40,360 --> 00:12:44,710
لذا إن حدثَ ذلك، أردتُ أن أطلب
منكِ الاهتمام به

199
00:12:47,870 --> 00:12:50,990
!أ-أوه، هذا فقط؟ يمكنني تلبية ذلك

200
00:12:56,600 --> 00:12:57,660
حسناً يا إيتو-تشان

201
00:12:57,660 --> 00:12:58,840
أنتِ التّالية

202
00:12:59,880 --> 00:13:02,010
عمّاذا تتكلّمان بحقّ السّماء؟

203
00:13:02,010 --> 00:13:04,130
نُجري مُحادثة

204
00:13:04,130 --> 00:13:05,300
ما مُشكلتك؟

205
00:13:05,730 --> 00:13:07,130
لا شيء

206
00:13:08,490 --> 00:13:09,300
غين-كن

207
00:13:10,680 --> 00:13:12,020
لقد وعدت

208
00:13:13,360 --> 00:13:14,280
حظّاً سعيداً

209
00:13:19,610 --> 00:13:21,220
وعدَ بماذا؟

210
00:13:21,760 --> 00:13:22,800
هذا ليس من شأنكِ

211
00:13:24,940 --> 00:13:28,110
أعتقد بأنّها عولِجَت الآن؟

212
00:13:32,790 --> 00:13:34,040
!يامادا-سان

213
00:13:35,100 --> 00:13:36,290
كوموغي-سان

214
00:13:36,730 --> 00:13:38,370
هل أنت متأكّد من أنّك تستطيع
الخروج إلى هنا ثانية؟

215
00:13:38,370 --> 00:13:40,540
أجل. أنا بخير تماماً

216
00:13:40,540 --> 00:13:42,980
!كم أنا مسرور

217
00:13:42,980 --> 00:13:45,330
!كنتُ قلقاً حقّاً

218
00:13:45,960 --> 00:13:48,550
تذكّرت، كيف انتهت مُنافستك الخاصّة؟

219
00:13:48,820 --> 00:13:51,300
يبدو أنّني ربحت

220
00:13:51,300 --> 00:13:54,050
إذاً أختك الكُبرى هي مُلكك الآن؟

221
00:13:54,050 --> 00:13:56,060
سيكون هذا طلباً ثقيلاً

222
00:13:56,060 --> 00:13:56,930
ماذا؟

223
00:13:56,930 --> 00:13:59,810
أقصد بأنّها تُحبّ غين-كن

224
00:14:00,040 --> 00:14:01,510
ماذا؟ ماذا؟

225
00:14:01,880 --> 00:14:03,990
إذاً ما الّذي كنتَ تُقاتل لأجله حتّى؟

226
00:14:04,860 --> 00:14:06,240
وجهة نظر سديدة

227
00:14:06,940 --> 00:14:09,070
أعتقد بأنّ المُنافسة لم تكُن مُهمّة فعلاً

228
00:14:10,930 --> 00:14:12,970
لكنّه كان شيئاً ترتّبَ عليّ القيام به

229
00:14:16,330 --> 00:14:19,170
أريدك أن تعبِّر عن مشاعرك الفعليّة

230
00:14:19,990 --> 00:14:21,730
ليس لي. بل لإيتو-تشان

231
00:14:22,370 --> 00:14:23,170
ماذا؟

232
00:14:23,570 --> 00:14:26,410
هل اعتقدتَ بأنّني سأطلب منك الابتعا د عنها؟

233
00:14:26,960 --> 00:14:28,200
مُحال

234
00:14:28,200 --> 00:14:30,050
كانت لترفضني على أيّ حال

235
00:14:30,290 --> 00:14:32,220
إذاً سوف تكتفي بالاستسلام؟

236
00:14:32,660 --> 00:14:34,600
،لا أمانع الرّفض على وجه الخصوص

237
00:14:34,600 --> 00:14:36,810
لكن لا أريد جعل الأمور أكثر
إرباكاً بالنّسبة لها

238
00:14:38,810 --> 00:14:42,990
أريدها فقط أن تُكافأ على منح 110% دوماً

239
00:14:44,530 --> 00:14:47,200
وأن تُحافِظ على ضحكتها ببهجة بلا حدود

240
00:14:48,650 --> 00:14:53,950
وحتّى أنّني أردتُ أن أكون البطل
في نظر الفتاة الّتي أُحبّ

241
00:14:56,140 --> 00:14:57,770
شكراً لصبركم

242
00:14:57,770 --> 00:14:59,830
سنُعلن الآن عن الفريق الرّابح

243
00:15:00,080 --> 00:15:03,590
،في هذا العام، بعد إحداث فوضى
!يربح الفريق الأبيض

244
00:15:08,960 --> 00:15:12,000
!والآن، ستبدأ مراسم توزيع الجوائز

245
00:15:25,210 --> 00:15:28,760
غين، ماذا ينبغي أن نُعدّ على العشاء

246
00:15:29,330 --> 00:15:30,900
الملفوف رخيص

247
00:15:30,900 --> 00:15:33,570
وأيضاً، ينبغي لِلّحّام أن يبدأ
بتنزيلاته المحدودة زمنيّاً قريباً

248
00:15:33,570 --> 00:15:36,050
لذا هل يجدر بنا إعداد لُفافات
ملفوف مع لحم مفروم؟

249
00:15:36,050 --> 00:15:37,630
تناولنا ذلك في الأسبوع الماضي

250
00:15:37,630 --> 00:15:40,250
...حسناً إذاً

251
00:15:42,410 --> 00:15:44,370
هل فكّرتَ في غيوزا للتو؟

252
00:15:44,370 --> 00:15:45,580
يا لها من صدفة

253
00:15:45,580 --> 00:15:47,750
كنتُ على وشك أن أقول غيوزا

254
00:15:47,750 --> 00:15:50,410
والآن كُلّ ما أريد أكله هو الغيوزا

255
00:15:50,410 --> 00:15:52,760
لا أحبّ القيام بكُلّ ذلك العمل
...اليوم، لكن مع ذلك

256
00:15:53,030 --> 00:15:56,390
لكن أعتقد بأنّني سأفعلها لأجل
حفلة ما بعد المهرجان الرّياضيّ

257
00:15:56,390 --> 00:15:57,900
إن ساهمنا جميعاً، فسيُنجَز ذلك بسرعة

258
00:15:57,900 --> 00:16:00,390
ومضى وقتٌ طويل منذ تناولنا الغيوزا خاصّتك

259
00:16:01,950 --> 00:16:04,010
أريدك أن تقول ما تشعر به فعلاً

260
00:16:05,010 --> 00:16:06,660
ليس لي. بل لإيتو-تشان

261
00:16:09,360 --> 00:16:12,440
صحيح. أعددتُه بُعيد وصولكِ

262
00:16:12,440 --> 00:16:15,870
أجل، أجل. كان لذيذاً جدّاً

263
00:16:17,530 --> 00:16:19,930
هل كنتِ تُهينين الغيوزا خاصّتي للتو؟

264
00:16:23,540 --> 00:16:25,340
ما زلتِ تتعقّبين ذلك؟

265
00:16:25,340 --> 00:16:28,150
حتّى في ذلك الوقت، كان من الواضح أنّكِ
تُكرهين نفسكِ على أكلها

266
00:16:28,150 --> 00:16:29,550
!لم أكن أُكرِه نفسي

267
00:16:29,550 --> 00:16:30,920
!لقد أحببتُها

268
00:16:30,920 --> 00:16:33,800
أفسدتِ معدتكِ وترتّب عليكِ
الاختباء في دورة المياه

269
00:16:33,800 --> 00:16:34,590
!مُقرف

270
00:16:34,590 --> 00:16:36,720
!لا تتذكّر أشياء كهذه أيُّها المُنحرف

271
00:16:36,720 --> 00:16:38,730
!المُنحرف الّذي يبكي هو المُنحرف الحقيقيّ

272
00:16:38,730 --> 00:16:39,310
!مُنحرفة

273
00:16:39,310 --> 00:16:41,410
!كُفّ عن قول "مُنحرفة" مِراراً أيّها المُنحرِف

274
00:16:41,410 --> 00:16:43,160
!أين الخطأ في نعتكِ بـ"مُنحرفة"؟

275
00:16:43,160 --> 00:16:43,850
!أيّتها المُنحرفة

276
00:16:43,850 --> 00:16:45,640
!مُنحرف-
!مُنحرفة-

277
00:16:48,480 --> 00:16:50,780
...على ذكر دورة المياه

278
00:16:50,780 --> 00:16:53,000
نفد لدينا ورق المراحيض تقريباً

279
00:16:53,000 --> 00:16:54,780
أنتِ قويّةٌ جدّاً

280
00:16:55,470 --> 00:16:56,520
ماذا؟

281
00:16:56,520 --> 00:16:58,530
هل تحاول افتعال شِجار معي تالياً؟

282
00:17:04,370 --> 00:17:06,550
!حسناً إذاً، لنعُد إلى المنزل

283
00:17:06,550 --> 00:17:08,540
!انتظري

284
00:17:08,540 --> 00:17:10,140
هل نسينا شراء شيء؟

285
00:17:10,140 --> 00:17:13,100
لا! لكن لا يجدر بكِ أن تحملي
كُلَّ شيء. هذا خطير

286
00:17:13,100 --> 00:17:14,550
أعطيني الأكياس

287
00:17:17,220 --> 00:17:18,550
ها نحن أولاء

288
00:17:18,550 --> 00:17:19,960
!ما خطبكِ؟

289
00:17:19,960 --> 00:17:21,810
كم أنت جسور

290
00:17:22,480 --> 00:17:23,560
يدك اليُمنى

291
00:17:23,560 --> 00:17:26,330
كنتَ تحاول عدم استعمالها. ما السّبب؟

292
00:17:27,440 --> 00:17:30,070
هل جرحتَها عندما سقطتَ
في معركة الحمل على الظّهر؟

293
00:17:31,820 --> 00:17:34,070
توقّعتُ ذلك

294
00:17:37,370 --> 00:17:39,820
لا يمكنني إخفاء شيء عنكِ حقّاً

295
00:17:41,490 --> 00:17:43,010
حسناً، المعذرة

296
00:17:43,010 --> 00:17:45,170
لكن يبدو أنّ التطفُّل يجري في دمي الآن

297
00:17:45,170 --> 00:17:48,200
لديّ أربعة أخوة صِغار في المنزل
يتصرّفون دوماً بشقاوة

298
00:17:55,270 --> 00:17:58,370
آسف. لأنّني أقلقتُكِ في أمور كثيرة

299
00:17:58,370 --> 00:18:01,610
على أيّ حال، ماذا تريد أن تفعل بالغيوزا؟

300
00:18:01,610 --> 00:18:04,890
نحن لا نعدّها كثيراً، لذا اتريد
جربة نكهات مُختلفة؟

301
00:18:04,890 --> 00:18:07,140
ألا تريد استكشاف آفاق جديدة؟

302
00:18:07,140 --> 00:18:09,440
!عرفتُ بأنّكِ لم تُريدي أكل الغيوزا خاصّتي

303
00:18:09,440 --> 00:18:10,650
سآكل خاصّتك أيضاً

304
00:18:10,970 --> 00:18:12,530
هل أنت تجسيد للشّراهة؟

305
00:18:12,530 --> 00:18:14,900
!أجل، هذه هي أنا

306
00:18:15,290 --> 00:18:18,330
لا يهمّ. نادِني بما تشاء

307
00:18:18,330 --> 00:18:21,660
في هذا الوقت، لا يمكنك أن تقول
شيئاً لاستفزازي

308
00:18:21,890 --> 00:18:22,780
قزمة

309
00:18:22,780 --> 00:18:23,930
لا مُشكلة

310
00:18:23,930 --> 00:18:24,910
رأس كوكيشي

311
00:18:24,910 --> 00:18:26,620
سمعتُ ذلك من قبل

312
00:18:26,620 --> 00:18:27,410
أخت كُبرى مغرورة

313
00:18:27,800 --> 00:18:29,120
هذه صحيحة

314
00:18:29,450 --> 00:18:30,310
كينتارو

315
00:18:30,310 --> 00:18:32,920
لم أسمع هذا منذ مدّة

316
00:18:32,920 --> 00:18:34,390
أهذا كلّ ما لديك؟

317
00:18:43,510 --> 00:18:47,270
ينبغي... أن تقضي وقتاً أطول
في النّظر إليّ فقط

318
00:18:53,770 --> 00:18:55,110
وجه غريب

319
00:19:02,270 --> 00:19:03,590
"وجه غريب"

320
00:19:04,500 --> 00:19:05,910
لا، ليس هذا

321
00:19:06,330 --> 00:19:08,180
!الكلام الّذي قاله قبل ذلك

322
00:19:08,180 --> 00:19:10,170
!ما الّذي يعني "النّظر إليّ فقط"؟

323
00:19:10,450 --> 00:19:12,030
هل تخيّلتُ ذلك؟

324
00:19:12,030 --> 00:19:13,420
هل تسخر منّي؟

325
00:19:14,350 --> 00:19:16,640
أم أنّك مُرهَق جدّاً لدرجة أنّ
مشاعرك قد تلخبطت؟

326
00:19:16,640 --> 00:19:17,920
!الأمر ليس كذلك

327
00:19:19,660 --> 00:19:22,390
عبّرتِ عن حواركِ الدّاخليّ بصوت
عالٍ بالمُناسبة

328
00:19:22,390 --> 00:19:24,150
!ماذا؟ النّجدة

329
00:19:24,150 --> 00:19:26,090
لم ألحظ حتّى

330
00:19:28,060 --> 00:19:31,130
لم أعرف كيف أذكر الأمر

331
00:19:33,170 --> 00:19:35,260
،ليس بسبب الوعد فقط

332
00:19:35,690 --> 00:19:37,770
لكن كنتُ أقول لنفسي بأنّني أحتاج لقولها

333
00:19:39,160 --> 00:19:41,520
رؤية سيو هكذا جعلني أدرك الأمر

334
00:19:42,550 --> 00:19:43,860
الوعد؟

335
00:19:46,360 --> 00:19:48,600
قول ماذا؟

336
00:19:52,570 --> 00:19:54,110
الاعتراف بمشاعري؟

337
00:21:29,140 --> 00:21:30,250
!مرحى

338
00:21:30,250 --> 00:21:31,890
!إنّها حفلة غيوزا

339
00:21:32,170 --> 00:21:33,710
أنا من أعدّها

340
00:21:33,710 --> 00:21:35,590
لطيف جدّاً

341
00:21:35,590 --> 00:21:37,000
احرص على النّفخ عليها

342
00:21:37,000 --> 00:21:38,650
!لنأكل

343
00:21:40,620 --> 00:21:41,400
ماذا؟

344
00:21:42,640 --> 00:21:43,960
لماذا نتناول غيوزا؟

345
00:21:46,960 --> 00:21:49,840
،صحيح. بعد المهرجان الرّياضيّ

346
00:21:49,840 --> 00:21:52,250
قرّرنا إقامة حفلة غيوزا

347
00:21:52,250 --> 00:21:53,910
...ثمّ

348
00:21:53,910 --> 00:21:55,210
"الاعتراف بمشاعري؟"

349
00:21:58,580 --> 00:22:00,190
يتصرّف بشكل طبيعيّ حيال هذا الأمر

350
00:22:00,660 --> 00:22:03,340
.يجلس هنا بشكل طبيعيّ
ويأكل الغيوزا بشكل طبيعيّ

351
00:22:04,130 --> 00:22:05,100
لحظة

352
00:22:05,100 --> 00:22:06,800
هل حدثَ ذلك أصلاً؟

353
00:22:06,800 --> 00:22:08,250
هل أخطأتُ السّمع؟

354
00:22:08,920 --> 00:22:12,280
كنتُ مُتعَبة وبالكاد أتذكّر بأنّني
مشيتُ إلى المنزل

355
00:22:12,940 --> 00:22:13,780
هل كان حلماً؟

356
00:22:14,230 --> 00:22:15,390
ماذا؟

357
00:22:15,390 --> 00:22:17,690
هل أكلي للغيوزا غريب إلى هذه الدّرجة؟

358
00:22:17,690 --> 00:22:18,500
!إطلاقاً

359
00:22:18,500 --> 00:22:20,810
شعرتُ فقط بأنّك تستمتع بها كثيراً

360
00:22:22,240 --> 00:22:24,400
!لا بُدّ أنّه كان حلماً

361
00:22:24,400 --> 00:22:26,820
...مُحال أن يقول غين كلاماً كهذا

362
00:22:34,610 --> 00:22:35,620
مهلاً، مهلاً

363
00:22:35,620 --> 00:22:38,080
لا تستهترا كثيراً وتنسيا أمرنا

364
00:22:39,930 --> 00:22:41,470
!نحن لا نفعل ذلك

365
00:22:43,210 --> 00:22:44,900
لم يكن حلماً

366
00:22:45,460 --> 00:22:46,730
!كان حقيقيّاً

367
00:22:47,680 --> 00:22:49,120
غين-كن، أنت سيّئ في اللّفّ

368
00:22:49,120 --> 00:22:51,160
من يكترث ما دمت تستطيع أكلها؟

369
00:22:51,930 --> 00:22:53,990
من وضع جيلي في هذه؟

370
00:22:53,990 --> 00:22:55,480
أشتمّ رائحة

371
00:22:55,480 --> 00:22:57,150
!شيء ما يحترق

372
00:22:57,150 --> 00:22:59,230
لستُ من أعدّها

373
00:22:59,230 --> 00:23:01,390
هـ-هذه غيوزا البودينغ خاصّتي

374
00:23:01,390 --> 00:23:03,440
لماذا تفعل ذلك حتّى؟

375
00:23:03,440 --> 00:23:05,120
!خفِّف الحرارة بسرعة

376
00:23:14,140 --> 00:23:15,990
انظري إليّ فقط

377
00:23:16,960 --> 00:23:18,100
إليّ فقط

378
00:23:18,650 --> 00:23:19,690
أنا فقط

379
00:23:26,010 --> 00:23:29,450
هل هذا يعني أنّ غين يكنُّ مشاعر تجاهي؟

380
00:23:34,670 --> 00:23:38,290
