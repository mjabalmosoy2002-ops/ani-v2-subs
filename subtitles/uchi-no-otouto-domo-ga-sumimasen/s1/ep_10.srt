1
00:00:04,690 --> 00:00:06,940
هذا الصّوت... أهذا أنت يا أوتو-سان؟

2
00:00:07,480 --> 00:00:09,990
كيف عرفت بأنّني هنا؟

3
00:00:09,990 --> 00:00:14,290
لأنّني كنتُ أعيش جواركِ منذ البداية

4
00:00:16,790 --> 00:00:19,180
لا تخافي

5
00:00:19,180 --> 00:00:21,290
أنا جاركِ، أوتو

6
00:00:22,790 --> 00:00:24,230
!هذا مُخيفٌ جدّاً

7
00:00:24,230 --> 00:00:26,730
!كان يعيش جوارها منذ البداية

8
00:00:26,730 --> 00:00:28,970
!هذا العرض مُخيفٌ جدّاً

9
00:00:28,970 --> 00:00:30,800
هذا هو النّوع الّذي تحبّينه إذاً

10
00:00:30,800 --> 00:00:33,300
نحن هنا الآن

11
00:00:34,380 --> 00:00:35,500
اسمع

12
00:00:35,500 --> 00:00:38,300
لستُ الشّخص الّذي وقعتْ ني-سان في حُبّه

13
00:00:38,630 --> 00:00:41,210
،إنّها واقعة في حُبّ الدراما الرّومانسيّة الشّهيرة

14
00:00:41,210 --> 00:00:43,270
،"رومانسيّة ورود رجاء القلب الزّرقاء"

15
00:00:43,270 --> 00:00:45,610
"والّتي تُختصَر إلى "أخي

16
00:00:45,610 --> 00:00:49,610
...بفضل سرعة بديهة راكو، تجنّبنا رصاصة، لكن

17
00:00:49,610 --> 00:00:52,160
هل صدرت الحلقة التّالية بالفعل؟

18
00:00:52,160 --> 00:00:54,210
!لا تدعني أشاهد المزيد

19
00:00:54,210 --> 00:00:55,660
ما هو المُخيف في هذا أصلاً؟

20
00:00:56,330 --> 00:00:58,180
إنّها قصّة حول بشر أحياء عاديّين

21
00:00:58,180 --> 00:00:59,750
غين-كن، ألا تعلم؟

22
00:00:59,750 --> 00:01:03,180
!لا شيء أكثر رُعباً من البشر في هذا الكوكب

23
00:01:08,620 --> 00:01:11,180
لا أتذكّر بأنّ هذا العرض مُضحك

24
00:01:11,180 --> 00:01:12,300
إنّه ليس كذلك

25
00:01:12,300 --> 00:01:14,030
رُبّما هو مُرهَق؟

26
00:01:14,030 --> 00:01:17,140
أو ربّما حدث شيء في المدرسة؟

27
00:01:18,520 --> 00:01:20,030
!أحقّاً ذلك يا سيو-كن؟

28
00:01:20,030 --> 00:01:21,550
هل حدث شيء في المدرسة؟

29
00:01:21,550 --> 00:01:22,740
المدرسة؟

30
00:01:22,740 --> 00:01:23,870
—إنّها هادئة تماماً

31
00:01:23,870 --> 00:01:25,740
!هل تسير دراستك على ما يُرام؟

32
00:01:25,740 --> 00:01:27,480
!هل تعرّفتَ على بعض الأصدقاء؟

33
00:01:27,480 --> 00:01:30,600
!إذا احتجت للتّنفيس يوماً، فتعال إليّ مُباشرة

34
00:01:31,600 --> 00:01:35,830
أعتقد بأنّني تعرّفتُ على صديق جديد

35
00:01:43,360 --> 00:01:45,170
اسمها كوموغي-سان

36
00:03:17,120 --> 00:03:19,470
!سيو-كن لديه صديقة

37
00:03:19,470 --> 00:03:20,940
أنا مسرورة لأجله

38
00:03:20,940 --> 00:03:24,040
ليس من طِباعه أن يخرج مع فتاة
مُبهرَجة مثلها

39
00:03:24,040 --> 00:03:25,500
كان كوزبلاي

40
00:03:25,500 --> 00:03:27,610
تبدو فتاة شابّة لطيفة

41
00:03:27,610 --> 00:03:30,050
لم يلتقِ بها حتّى بعد

42
00:03:30,050 --> 00:03:32,980
بحسب معلوماتنا المُتاحة، قد يكون
عجوزاً مُريباً ما

43
00:03:32,980 --> 00:03:35,360
"ما زلتَ في وضع "أوتو-سان

44
00:03:35,360 --> 00:03:37,320
هذا مُحتمَل

45
00:03:37,320 --> 00:03:38,610
!حتّى أنت أيضاً

46
00:03:38,610 --> 00:03:41,510
،بالطّبع أريد أن أكون سعيداً لأجله

47
00:03:41,510 --> 00:03:43,690
،لكنّه مُنعزل تماماً

48
00:03:43,690 --> 00:03:46,620
ولم يتعرّف على صديق حقيقيّ من قبل

49
00:03:47,070 --> 00:03:49,590
،بحسب ما رأيتُ سيو-كن حتّى الآن

50
00:03:49,590 --> 00:03:51,330
لا أنكر بأنني قلقة أيضاً

51
00:03:51,690 --> 00:03:54,290
لكن ستكون الأمور على ما يُرام

52
00:03:54,760 --> 00:03:58,490
إن لم يفلح الأمر، فما زال لديه نحن

53
00:03:58,490 --> 00:04:01,850
الآن، يحاول سيو-كن الاتّصال بالعالم الخارجيّ

54
00:04:02,580 --> 00:04:05,210
!بصفتنا عائلته، يجب علينا دعمه

55
00:04:05,990 --> 00:04:08,430
...الكلام سهل، لكن

56
00:04:10,400 --> 00:04:11,370
من فضلك

57
00:04:11,370 --> 00:04:13,360
إن حدث شيء، فسوف نتدخّل

58
00:04:13,360 --> 00:04:15,420
حاليّاً، كُن هادئاً وراقبه

59
00:04:15,730 --> 00:04:20,500
ذلك الفتى الّذي كان يبكي ويتلوّى ككُرة
يضحك بسعادة الآن

60
00:04:21,150 --> 00:04:23,530
فكيف لنا ألّا نُشجِّعه؟

61
00:04:33,350 --> 00:04:34,670
!أهلاً بعودتك

62
00:04:34,670 --> 00:04:36,670
ما-ما-ماذا أفعل؟

63
00:04:36,670 --> 00:04:39,010
حـ-حصلتُ على دعوة

64
00:04:39,010 --> 00:04:43,520
سئلتُ ما إن كنتُ أستطيع حضور
!حدَث مُقبل معاً

65
00:04:44,470 --> 00:04:48,480
بـ"حدث"، أعني معارضَ حيث يبيع
النّاس كُتُباً من مُؤلّفين مُستقلّين وما شابه

66
00:04:48,480 --> 00:04:50,150
،هذا محصور باللّعبة الّتي ألعبها الآن

67
00:04:50,150 --> 00:04:52,260
لذا إنّه ليس بالحدَث الضّخم بعد

68
00:04:52,260 --> 00:04:55,480
،لكن مُؤخّراً، شاركَ المزيد من المُؤلِّفين المشهورين
وبالتّالي بدأ هذا النّوع ينتشر

69
00:04:58,080 --> 00:04:59,230
!انظرا

70
00:04:59,230 --> 00:05:01,830
!مكتوب بأنّ رسّامين مشهورين سيُشاركون أيضاً

71
00:05:01,830 --> 00:05:03,370
!هذا رائع للغاية

72
00:05:03,370 --> 00:05:05,550
،لا أملك أي فكرة عن هذا

73
00:05:05,550 --> 00:05:08,370
!لكن لم أرَه مُتحمّساً بهذا الشّكل من قبل

74
00:05:08,370 --> 00:05:12,080
،في الواقع، كوموغي-سان هي كاتبة أيضاً

75
00:05:12,080 --> 00:05:15,750
وعندما تكلّمنا، انتهى المطاف بالمُوافقة
على مُمارستي الرّسم معها

76
00:05:15,750 --> 00:05:17,700
!هذا مُذهلٌ حقّاً

77
00:05:17,700 --> 00:05:23,470
لكن كنتُ أرسم كهواية فقط، ورسمي
ليس رائعاً إلى ذلك الحدّ

78
00:05:24,970 --> 00:05:27,220
!لا، في الواقع، إنّه ممتازٌ جدّاً

79
00:05:27,670 --> 00:05:31,020
لكن كانت كوموغي-سان مُتحمّسة حقّاً لرسومي

80
00:05:31,020 --> 00:05:34,730
قالت بأنّه بعد رؤية أعمالي، القصّة
تبني نفسها بنفسها

81
00:05:35,000 --> 00:05:38,730
إذا كان هذا النّوع من الأشياء يجلب
،البهجة للآخرين

82
00:05:39,050 --> 00:05:41,080
فقد أرغب في تجربته بالفعل

83
00:05:41,080 --> 00:05:42,610
سيو-كن

84
00:05:42,990 --> 00:05:44,490
من الواضح أنّ هذا غير مُمكن

85
00:05:44,780 --> 00:05:45,760
ماذا؟

86
00:05:45,760 --> 00:05:47,400
ماذا تقصد؟

87
00:05:47,400 --> 00:05:50,810
الشّخص الّذي يُمطرك بالمديح هو شخصٌ مُريب

88
00:05:50,810 --> 00:05:55,400
وأيضاً، سمعتُ بأنّ عليك تقديم امتحانات
التّعويض للفصل النّصفيّ

89
00:05:55,400 --> 00:05:56,750
لديك امتحانات دخول قريباً

90
00:05:57,380 --> 00:05:59,760
هل لديك الوقت حقّاً للّهو هكذا؟

91
00:06:00,320 --> 00:06:03,050
!مـ-من الصّعب المُجادلة على الوقائع

92
00:06:03,590 --> 00:06:06,310
،اسمع، لا أريد إفساد مزاجك

93
00:06:06,310 --> 00:06:08,020
لكنّه شهر نوفمبر بالفعل

94
00:06:08,020 --> 00:06:11,060
لا ينبغي أن تستخدم موهبةً نادرة
كهذه للتهرُّب من الواقع

95
00:06:11,960 --> 00:06:15,170
إجبار صديقتك على مُجاراة ذلك هو
قلّة أدب أيضاً

96
00:06:15,930 --> 00:06:19,200
لِمَ عليك أن تكون قاسياً هكذا؟

97
00:06:22,820 --> 00:06:23,870
حسناً

98
00:06:25,310 --> 00:06:26,910
شكراً على إخباري

99
00:06:27,520 --> 00:06:30,050
كنتُ على وشك فقدان رؤية ما هو واضح

100
00:06:31,700 --> 00:06:33,300
!انتظر يا سيو-كن

101
00:06:33,300 --> 00:06:34,870
لا مُشكلة

102
00:06:34,870 --> 00:06:36,420
أعتذر لأنّني سبّبتُ جلبة

103
00:06:39,540 --> 00:06:40,650
غين

104
00:06:41,170 --> 00:06:42,920
دعني أضربك لمرّتين أو ثلاث

105
00:06:42,920 --> 00:06:43,840
لا

106
00:06:43,840 --> 00:06:46,040
كم كان ليُكلِّف هذا؟

107
00:06:46,040 --> 00:06:48,220
لا تستخدميها لأشياء كهذه

108
00:06:48,830 --> 00:06:52,350
سأبسِّط الأمر: ينبغي أن يضع أولويّة
لما يحتاج فعله

109
00:06:52,740 --> 00:06:55,100
هذا منطقيّ بالطّبع

110
00:06:55,460 --> 00:06:59,450
لكن لا أعلم ما إن كان من المُمكن تنظيم
مشاعر سيو-كن بطريقة بسيطة

111
00:07:03,750 --> 00:07:05,460
أتعتقد بأنّك تستطيع فعلها؟

112
00:07:05,460 --> 00:07:07,590
أنوي اعتماد هذا الزيّ

113
00:07:07,590 --> 00:07:08,610
ما رأيك؟

114
00:07:16,950 --> 00:07:17,940
...إنّه

115
00:07:17,940 --> 00:07:20,210
الحُبّ غالباً

116
00:07:22,350 --> 00:07:25,720
إن كان كذلك، فأنا واثقة بأنّ كُلّ
ما يستطيع التّفكير فيه هو هي

117
00:07:25,990 --> 00:07:28,220
كيف سيتمكّن من التّركيز على الامتحانات حينها؟

118
00:07:29,510 --> 00:07:31,830
!لذا يجب أن يفعل ما يشاء

119
00:07:31,830 --> 00:07:35,200
ألا تعتقد بأنّ ذلك سيكون مصدر التّحفيز؟

120
00:07:35,200 --> 00:07:38,400
إذا رُفِض، فقد يخسر أكثر من مُجرّد حافز

121
00:07:39,900 --> 00:07:42,320
ألا تضعين هذا الاحتمال بعين الاعتبار؟

122
00:07:42,320 --> 00:07:43,180
آسفة

123
00:07:43,180 --> 00:07:45,090
لم أفكّر في ذلك البتّة

124
00:07:45,510 --> 00:07:47,150
هذا هو طبعكِ

125
00:07:48,360 --> 00:07:51,280
الحُبّ مُحبطٌ حقّاً

126
00:07:53,220 --> 00:07:54,660
بالفعل

127
00:07:56,410 --> 00:07:58,880
!أتحدّث عن سيو-كن

128
00:08:17,610 --> 00:08:19,190
سأغادر الآن

129
00:08:23,020 --> 00:08:24,240
!سيو-كن

130
00:08:27,280 --> 00:08:28,600
...سيو-كن

131
00:08:28,600 --> 00:08:30,440
...لا... أنا

132
00:08:30,440 --> 00:08:33,200
أنا... بخير

133
00:08:33,630 --> 00:08:36,540
،لديّ امتحانات تعويض اليوم

134
00:08:36,540 --> 00:08:38,060
لذا يجب أن أذهب إلى المدرسة

135
00:08:39,220 --> 00:08:42,960
وعدتُ غين-كن بأنّني سأفعلها حقّاً

136
00:08:42,960 --> 00:08:45,330
!لا يمكنك الذّهاب بوضع كهذا

137
00:08:45,770 --> 00:08:47,710
كُلّ ما في الأمر هو أنّني لم أنَم جيّداً

138
00:08:48,140 --> 00:08:50,970
سهرتُ اللّيل كُلّه لإنجاز المخطوطة
قبل الموعد النّهائيّ للتّسليم

139
00:08:51,220 --> 00:08:52,390
مخطوطة؟

140
00:08:53,350 --> 00:08:55,200
!ا-انسي الأمر

141
00:08:55,200 --> 00:08:56,580
أيّ موعد نهائيّ؟

142
00:08:56,580 --> 00:08:58,290
...لأجل

143
00:09:00,880 --> 00:09:02,230
أنا آسف

144
00:09:02,600 --> 00:09:05,290
لم أستطع رفض المخطوطة

145
00:09:05,620 --> 00:09:08,440
لكن لم أتخلَّ عن الدّراسة

146
00:09:08,440 --> 00:09:10,740
وأخبرتُها بأنّني لا أستطيع حضور الحدَث

147
00:09:10,740 --> 00:09:12,680
هل كنتَ تحاول فعل الأمرين في آن واحد؟

148
00:09:12,680 --> 00:09:15,740
أقصد بأنّها ليست شخصاً سهل المنال

149
00:09:15,740 --> 00:09:17,990
شعرتُ وكأنّني إذا قلتُ "في المرّة
،"المُقبلة رُبّما

150
00:09:17,990 --> 00:09:20,770
...فقد تفقد الاهتمام بي

151
00:09:22,000 --> 00:09:25,130
...إذا كان لديها قوّة التّأثير به إلى هذه الدّرجة

152
00:09:25,510 --> 00:09:28,680
أردتُ فقط أن أكون قادراً على
الارتقاء لبعض توقُّعاتها

153
00:09:28,680 --> 00:09:33,930
ارتأيتُ بأنّه بهذه الطّريقة، قد تُحافظ
هي على هذا الاتّصال بيننا

154
00:09:34,830 --> 00:09:37,450
لا بُدّ أنّه الحُبّ حتماً

155
00:09:38,560 --> 00:09:39,890
سيو-كن، اسمع

156
00:09:39,890 --> 00:09:43,650
إذا ابتعد شخصٌ عنك لأنّك
،لم ترتقِ لتوقُّعاته

157
00:09:43,650 --> 00:09:46,360
فهو غير جدير بصداقتك

158
00:09:47,530 --> 00:09:48,820
...لكن

159
00:09:48,820 --> 00:09:53,530
إذا كنتَ تقول بأنّها كذلك، فسأثِق بحدسك

160
00:09:53,530 --> 00:09:55,740
!سأشجّعك، مهما قال الآخرون

161
00:09:57,030 --> 00:10:01,610
لذا أخبرني، ما هو أكثر شيء تريد فعله؟

162
00:10:03,440 --> 00:10:08,000
يامادا-سان، هل ترغب في اللِّقاء
بأصدقاء على الواقع يوماً ما؟

163
00:10:08,500 --> 00:10:11,050
...لا أملك أصدقاء على أرض الواقع أيضاً

164
00:10:11,050 --> 00:10:13,730
لكن لطالما أردتُ امتلاك واحد

165
00:10:15,760 --> 00:10:21,210
سيكون من المثاليّ أن نصبح أنا
وأنت صديقين على أرض الواقع

166
00:10:26,780 --> 00:10:27,810
أريد اللِّقاء بها

167
00:10:29,820 --> 00:10:31,490
إذا كانت لا تُمانع شخصاً مثلي

168
00:10:32,350 --> 00:10:34,220
أريد الذّهاب إليها

169
00:10:34,650 --> 00:10:38,490
أريد التعرُّف عليها بشكل أفضل
وأريدها أن تعرف المزيد عنّي

170
00:10:39,400 --> 00:10:41,390
كنتُ أبحث أيضاً، لفترة طويلة

171
00:10:42,520 --> 00:10:45,260
بالنّسبة لشخص لديّ ارتباط أعمق معه

172
00:10:55,530 --> 00:10:57,160
...أتساءل ما إن كان عليّ رفضه

173
00:10:58,800 --> 00:11:00,510
إيندو

174
00:11:00,990 --> 00:11:02,160
إيندو، أتكلّم معكِ

175
00:11:02,160 --> 00:11:05,440
!اصمت وكُفّ عن مُناداتي باسمي الحقيقيّ

176
00:11:05,440 --> 00:11:08,790
أنا مُكتئبة لأنّني قد أرفض شخصاً
!أنا مُعجبة به حقّاً

177
00:11:08,790 --> 00:11:10,360
جاءك زبون

178
00:11:13,820 --> 00:11:16,520
سـ-سررتُ بلقائكِ

179
00:11:17,030 --> 00:11:17,950
هذا أنا

180
00:11:18,410 --> 00:11:19,250
...المعذرة

181
00:11:20,950 --> 00:11:22,200
أنا يامادا

182
00:11:23,560 --> 00:11:26,000
،أردتُ حقّاً اللّقاء بكِ

183
00:11:27,020 --> 00:11:29,200
لذا انتهى المطاف بمجيئي في النّهاية

184
00:11:34,870 --> 00:11:36,510
...إنّها تبدأ

185
00:11:36,980 --> 00:11:39,510
علاقته الرّومانسيّة تبدأ هنا

186
00:11:40,810 --> 00:11:43,010
يامادا-سان؟

187
00:11:44,170 --> 00:11:46,300
أردتُ اللّقاء بكِ منذ مدّة طويلة

188
00:11:46,300 --> 00:11:48,520
ثمّة أمر أردتُ أن أخبركِ به

189
00:11:48,520 --> 00:11:49,730
أنا سعيدة

190
00:11:50,100 --> 00:11:52,360
أردتُ اللّقاء بك منذ مدّة طويلة أيضاً

191
00:11:55,940 --> 00:11:59,070
أعتقد بأنّه لا يتعرّض لاحتيال بواسطة
عجوز مُريب ما

192
00:11:59,070 --> 00:11:59,700
!غين

193
00:11:59,700 --> 00:12:02,380
مهلاً، مهلاً، أين كِتاب سيو-كن؟

194
00:12:02,380 --> 00:12:03,540
!روي-كن؟

195
00:12:03,540 --> 00:12:05,960
عيبٌ عليكِ يا ني-سان

196
00:12:05,960 --> 00:12:09,620
لم تدعينا إلى حضور ظرف مُسلٍّ كهذا

197
00:12:09,990 --> 00:12:12,210
كيف عرفتُم بأنّنا سنكون هنا؟

198
00:12:12,210 --> 00:12:15,450
إلى أين سيذهب سيو غير هذا المكان؟

199
00:12:15,450 --> 00:12:18,630
بحث راكو-كن عن هذا المكان لأجلنا

200
00:12:19,000 --> 00:12:20,440
!يا إلهي

201
00:12:20,440 --> 00:12:24,210
!هذا يوم مُهمّ بالنّسبة لسيو

202
00:12:25,900 --> 00:12:27,930
،لا أمانع ذهابك لحضور الحدَث

203
00:12:27,930 --> 00:12:30,680
لكن لم تخرج من المدينة بمفردك
من قبل، أليس كذلك؟

204
00:12:30,680 --> 00:12:32,240
هل تعرف كيف تستقلّ القطار؟

205
00:12:32,640 --> 00:12:34,980
لن أعرف ما لم أُجرِّب

206
00:12:35,650 --> 00:12:37,780
أريد الذّهاب واللّقاء بها بمُفردي

207
00:12:37,780 --> 00:12:41,000
أريد تجربة إثارة إعجاب كوموغي-سان
ولو قليلاً فحسب

208
00:12:41,370 --> 00:12:42,490
لذا سأذهب

209
00:12:42,960 --> 00:12:43,700
!سيو-كن

210
00:12:43,700 --> 00:12:44,700
!المحطّة من هنا

211
00:12:48,640 --> 00:12:49,350
!بسرعة

212
00:12:49,350 --> 00:12:50,740
!القطار قادم

213
00:12:51,510 --> 00:12:52,850
سأشتري التّذكرة

214
00:12:53,210 --> 00:12:54,740
هل هو من هذا الطّريق؟

215
00:12:57,710 --> 00:12:59,820
تمالك نفسك يا سيو-كن

216
00:13:03,970 --> 00:13:07,520
أعدك بأنّني لن أفعل شيئاً عقب هذا

217
00:13:09,110 --> 00:13:10,650
شكراً جزيلاً لكِ

218
00:13:10,650 --> 00:13:11,660
إلى اللِّقاء

219
00:13:24,620 --> 00:13:27,680
—في الواقع، أردتُ أيضاً أن أُخبرك بشيء

220
00:13:27,680 --> 00:13:28,580
!المعذرة

221
00:13:28,580 --> 00:13:30,910
!كان كتابكِ الأحدث رائعاً للغاية أيضاً

222
00:13:30,910 --> 00:13:33,120
!إنّه ما أردتُ قراءته بالضّبط

223
00:13:33,120 --> 00:13:34,810
حـ-حقّاً؟

224
00:13:34,810 --> 00:13:36,940
كانت هناك بعض الأجزاء الّتي لم أكن
مُتيقّنة منها تماماً

225
00:13:36,940 --> 00:13:37,960
أي أجزاء؟

226
00:13:37,960 --> 00:13:39,380
!كان الكِتاب كُلّه هائلاً

227
00:13:39,380 --> 00:13:41,520
...لا، كانت مُساهمتك هي الّتي

228
00:13:41,520 --> 00:13:42,380
أقصد، انظري هنا

229
00:13:42,660 --> 00:13:45,180
قرأتُ كُلّ ما كتبتِه حتّى الآن

230
00:13:45,180 --> 00:13:48,770
!لذا هل يمكنني شرح سبب روعتكِ في لحظات؟

231
00:13:50,040 --> 00:13:53,770
أوّلاً، أعتقد بأنّ العوالم الّتي تبنينها
!في رواياتكِ مُبهرة

232
00:13:53,770 --> 00:13:56,660
،قد يبدو بأنّ بداية القصّة سخيفة للغاية

233
00:13:56,660 --> 00:13:57,610
،لكن مع مُتابعة القراءة

234
00:13:57,610 --> 00:13:59,620
،نُدرك بأنّ هناك خيوطاً تُنسَج تِلو الخيوط

235
00:13:57,610 --> 00:14:00,580
ما الّذي قطعَ كُلّ هذه المسافة
إلى هنا ليفعله؟

236
00:13:59,620 --> 00:14:01,510
ثمّ لا يستطيع المرء التوقُّف عن القِراءة

237
00:14:00,580 --> 00:14:03,950
حسبما رأيت، ظننتُ بأنّه أراد
...أن يُخبرها بأنّه يُحبّها

238
00:14:01,510 --> 00:14:04,950
،لكن طريقة مُعالجة الخيوط تفوق خيالي

239
00:14:04,570 --> 00:14:07,530
...لا يتحدّث سوى عن الكُتُب منذ اللِّقاء بها

240
00:14:04,950 --> 00:14:07,530
!والقصّة تغدر بالقارئ بأفضل وسيلة مُمكنة

241
00:14:07,530 --> 00:14:08,870
!على أيّ حال، أنتِ إلهة

242
00:14:08,870 --> 00:14:11,040
هذه هي الكلمة الوحيدة الّتي
يمكنني وصفكِ بها

243
00:14:11,320 --> 00:14:13,340
لم أعد قادراً على التحمُّل

244
00:14:13,340 --> 00:14:16,900
لا أحد يحبّ رجلاً لا يتحدّث سوى عن نفسه

245
00:14:17,460 --> 00:14:19,050
راقب وتعلّم

246
00:14:19,870 --> 00:14:20,880
!مرحباً أيّتها الآنسة اللّطيفة

247
00:14:20,880 --> 00:14:22,010
—ربّما أنتِ وأنا نستطيع أن

248
00:14:22,010 --> 00:14:24,010
!أنا آسفة جدّاً على إزعاجه لكِ

249
00:14:26,760 --> 00:14:29,500
...المعذرة... هل أنتِ

250
00:14:36,470 --> 00:14:39,770
شكراً على الاعتناء بأخينا

251
00:14:41,280 --> 00:14:43,220
غين-كن وراكو-كن، لماذا أنتما هنا أيضاً؟

252
00:14:43,220 --> 00:14:45,130
!أ-أنا آسفة يا يامادا-سان

253
00:14:45,130 --> 00:14:47,410
!حدث أمرٌ فجأة، لذا يجب عليّ الرّحيل

254
00:14:48,080 --> 00:14:49,560
!أنا آسفة حقّاً

255
00:14:50,410 --> 00:14:51,540
!أنتِ

256
00:14:51,540 --> 00:14:53,010
لا يجوز أن تُغادري بهذه البساطة

257
00:14:53,010 --> 00:14:54,280
!تولّ الأمر بنفسك

258
00:14:57,290 --> 00:14:58,250
!كوموغي-سان

259
00:15:08,880 --> 00:15:12,560
كُلّ هذا لأنّنا تدخّلنا

260
00:15:12,560 --> 00:15:14,670
بعد أن تمكّنا من اللِّقاء أخيراً

261
00:15:14,670 --> 00:15:17,090
كُلّ ما فعلناه كان إلقاء التّحيّة

262
00:15:18,110 --> 00:15:20,440
شعرتْ بالذّنب، لذا هربتْ

263
00:15:21,130 --> 00:15:24,040
كنتُ أعلم بأنّ لديها بعض النّوايا
السّيّئة تجاه سيو

264
00:15:24,040 --> 00:15:25,650
إنّها شرّيرة. شرّيرة

265
00:15:25,650 --> 00:15:28,030
!أنت الشّرّير هنا

266
00:15:28,350 --> 00:15:29,260
مُؤلم

267
00:15:29,910 --> 00:15:33,980
!هربتْ لأنّك كنتَ مُخيفاً جدّاً

268
00:15:33,980 --> 00:15:35,830
لم يتمكّن من التّواصل معها منذ ذلك الحين

269
00:15:35,830 --> 00:15:37,830
سيو-كن مُكتئب الآن أيضاً

270
00:15:38,150 --> 00:15:39,710
!كيف ستُعالج هذا أيّها الأخ الأكبر؟

271
00:15:39,710 --> 00:15:41,710
يا له من اتِّهام فظيع

272
00:15:41,710 --> 00:15:44,500
!على أيّ حال، لا تتدخّل في هذا الأمر

273
00:15:44,500 --> 00:15:46,790
سأبحث عن كوموغي-سان

274
00:15:46,790 --> 00:15:49,640
كيف ستجدينها دون أي طرف خيط؟

275
00:15:53,350 --> 00:15:54,790
آ-آسف

276
00:15:54,790 --> 00:15:56,310
لا شيء

277
00:15:57,150 --> 00:15:58,310
هل تعرفينه؟

278
00:15:58,310 --> 00:16:00,280
لا

279
00:16:03,770 --> 00:16:06,560
!توقّف مكانك

280
00:16:11,220 --> 00:16:13,540
...لا أملك أصدقاء على أرض الواقع أيضاً

281
00:16:14,560 --> 00:16:18,590
سيكون من المثاليّ أن نصبح أنا
وأنت صديقين على أرض الواقع

282
00:16:20,090 --> 00:16:22,540
هذا ما قالته

283
00:16:22,800 --> 00:16:24,150
...ومع ذلك

284
00:16:24,150 --> 00:16:25,550
هل بدوتُ مُستميتاً جدّاً؟

285
00:16:25,840 --> 00:16:27,190
!على أيّ حال، أنتِ إلَهة

286
00:16:27,190 --> 00:16:29,260
هذه هي الكلمة الوحيدة الّتي
يمكنني وصفكِ بها

287
00:16:29,260 --> 00:16:31,180
لماذا قلتُ كُلّ ذلك؟

288
00:16:31,180 --> 00:16:33,510
!لعلّها ظنّتْ بأنّني كنتُ ذليلاً جدّاً

289
00:16:33,510 --> 00:16:36,380
...عجباً، إنّه لا يعرف الصّمت

290
00:16:36,380 --> 00:16:37,530
مُقرف للغاية

291
00:16:37,530 --> 00:16:39,520
تلك النّظرة الّتي كانت مُرتسمة
في وجهها غالباً

292
00:16:40,180 --> 00:16:44,530
"غالباً تمّ وسمي بـ"السّيّد ذليل
في كُتُب التّاريخ خاصّتها

293
00:16:45,190 --> 00:16:48,010
ماذا أفعل إذا لم أستطع رؤيتها ثانية؟

294
00:16:55,860 --> 00:16:57,370
مرحباً؟ كوموغي-سان؟

295
00:16:58,870 --> 00:16:59,870
...المعذرة

296
00:17:00,190 --> 00:17:01,630
هذا مُطمئن

297
00:17:01,630 --> 00:17:03,880
،لم أستطع الوصول إليكِ إطلاقاً
لذا كنتُ قلقاً حقّاً

298
00:17:04,650 --> 00:17:06,430
أنا آسفٌ فعلاً بشأن ذلك اليوم

299
00:17:06,430 --> 00:17:09,280
كنتُ مُتحمّساً زيادة عن اللُّزوم

300
00:17:09,280 --> 00:17:12,890
أنا متأكّدٌ بأنّكِ نفرتِ منّي بعد
...فرضتُ عليكِ كُلّ تلك المشاعر

301
00:17:12,890 --> 00:17:17,390
لكن ما زال هناك الكثير من الكلام
الّذي أردتُ أن أقوله لكِ

302
00:17:18,500 --> 00:17:19,930
فهمت

303
00:17:19,930 --> 00:17:22,080
لهذا توقّفتَ عن المجيء إلى المدرسة

304
00:17:22,920 --> 00:17:27,150
مررتُ بفترة كهذه أيضاً، لذا أتفهّمك

305
00:17:28,830 --> 00:17:32,820
يُراودني إحساس بأنّنا قد نكون مُتشابهين تماماً

306
00:17:35,610 --> 00:17:40,160
كنتِ مُهمّة جدّاً بالنّسبة لي بصفتكِ
أوّل شخص من خارج عائلتي

307
00:17:40,700 --> 00:17:42,670
يتقبّلني

308
00:17:48,410 --> 00:17:50,980
أتفهّم بأنّ هذه هي آخر مرّة نتكلّم فيها

309
00:17:51,550 --> 00:17:56,680
لذا من فضلكِ، دعيني أخبركِ
بأهمّ شيء على الإطلاق

310
00:17:57,760 --> 00:18:02,160
كوموغي-سان، شكراً لك على التّواصل معي

311
00:18:03,300 --> 00:18:06,380
،كنتُ لأتمنّى أن نستمرّ كصديقين

312
00:18:06,380 --> 00:18:07,610
—لكن إذا كنّا

313
00:18:07,610 --> 00:18:08,750
آسفة

314
00:18:11,700 --> 00:18:13,530
!سـ-ساعدني

315
00:18:13,530 --> 00:18:15,870
...أمسكَ بي شخصٌ مُخيف

316
00:18:15,870 --> 00:18:16,830
!ماذا؟

317
00:18:16,830 --> 00:18:18,090
!أين أنتِ؟

318
00:18:43,290 --> 00:18:44,890
ماذا تفعل؟

319
00:18:44,890 --> 00:18:46,760
،دعيناه إلى داخل منزلنا

320
00:18:46,760 --> 00:18:48,460
لكن بعدها حاول الهرب

321
00:18:49,980 --> 00:18:53,280
!أجل، لأنّك أجبرته على المجيء

322
00:18:53,280 --> 00:18:55,410
...إذاً في الواقع، هذا الشّخص هو

323
00:18:55,410 --> 00:18:56,910
!كوموغي-سان؟

324
00:18:56,910 --> 00:18:58,660
!أنت كوموغي-سان، صحيح؟

325
00:18:59,940 --> 00:19:01,160
...كيف

326
00:19:01,160 --> 00:19:02,900
يسرّني هذا

327
00:19:02,900 --> 00:19:06,780
كنتُ قلقاً عندما ذكرت وجود شخص مُخيف

328
00:19:06,780 --> 00:19:10,350
سيو-كن، أنا مُندهشة من معرفتك بأنّ
هذا كوموغي-سان

329
00:19:10,350 --> 00:19:11,170
أجل

330
00:19:11,170 --> 00:19:12,920
فنحن صديقان

331
00:19:12,920 --> 00:19:14,450
من الطّبيعيّ أن أعرف

332
00:19:17,120 --> 00:19:18,440
...في الواقع

333
00:19:19,220 --> 00:19:22,680
كنتُ أتألّم كثيراً بشأن كيفيّة
شرح هذا الأمر لك

334
00:19:22,990 --> 00:19:25,190
أنا آسف لأنّني هربتُ قبل أيّام

335
00:19:25,500 --> 00:19:26,920
،كان فعل ذلك سيّئاً للغاية

336
00:19:26,920 --> 00:19:28,440
بعد أن دعيتُك وما إلى هنالك

337
00:19:28,440 --> 00:19:30,070
—أجل، لكن كان ذلك لأنّني

338
00:19:30,070 --> 00:19:30,930
لا

339
00:19:31,570 --> 00:19:35,400
،ظننتُ بأنّني كنتُ جاهزاً للاعتراف ليامادا-سان

340
00:19:35,400 --> 00:19:37,710
لكن خفتُ في النّهاية

341
00:19:38,840 --> 00:19:41,190
يمكن إساءة تفسير هوايتي بسهولة

342
00:19:41,190 --> 00:19:43,750
لذا قد تكون الأجواء مُزعجة جدّاً
عندما يكتشف النّاس

343
00:19:44,170 --> 00:19:47,130
لهذا السّبب أقنعتُ نفسي بالفصل تماماً
بين مدرستي

344
00:19:47,130 --> 00:19:49,890
وحياتي الخاصّة حالما ألتحق بالمدرسة الثّانويّة

345
00:19:50,780 --> 00:19:54,510
لا أُصدِّق بأنّك الأخ الصّغير لشخص من مدرستي

346
00:19:56,260 --> 00:19:58,030
لن نُخبر أحداً

347
00:19:58,030 --> 00:20:00,350
شكراً على صداقتك لأخي

348
00:20:00,730 --> 00:20:02,140
أنا آسف

349
00:20:02,140 --> 00:20:03,720
،حدثتْ معك كُلّ تلك الأمور

350
00:20:03,720 --> 00:20:05,490
بينما كنتُ لا أُفكِّر سوى بنفسي

351
00:20:06,170 --> 00:20:09,240
،أنا سعيد بوجودي معك بأيّ شكل كان

352
00:20:09,240 --> 00:20:10,780
لكن لا أريد أن أُرغمك

353
00:20:11,610 --> 00:20:17,360
لكن إذا وقع مكروه في المُستقبل
،واحتجت مُساعدة

354
00:20:17,360 --> 00:20:19,370
فآمل أن تتذكّرني

355
00:20:20,060 --> 00:20:21,770
!سآتي للاستماع لك في أيّ وقت

356
00:20:22,330 --> 00:20:25,150
لحظة، ها أنا أُبالغ من جديد

357
00:20:25,150 --> 00:20:27,000
لا تقل هذا

358
00:20:27,640 --> 00:20:31,250
سماعك تعطي رأيك في الحدَث أسعدَني حقّاً

359
00:20:31,660 --> 00:20:34,080
،قَبِلتني بلا تردُّد

360
00:20:34,080 --> 00:20:36,010
رغم أنّني كتمتُ عنك هذا السرّ

361
00:20:36,650 --> 00:20:39,980
لِمَ لا أريد أن أكون مع شخص عظيم مثلك؟

362
00:20:46,510 --> 00:20:49,520
،لذا هذا هو أنا فعلاً

363
00:20:49,520 --> 00:20:52,180
لكن سأحاول أن أصبح أقوى نفسيّاً

364
00:20:53,110 --> 00:20:55,940
هل ستستمرّ في الخروج معي؟

365
00:21:02,200 --> 00:21:04,530
،انتهى الأمر ليس كَحُبّ

366
00:21:04,530 --> 00:21:08,140
لكن كصديق عزيز أيضاً وهي خطوة ممتازة

367
00:22:54,990 --> 00:22:55,870
أنتِ

368
00:22:56,310 --> 00:22:57,780
كيف سار الأمر؟

369
00:22:57,780 --> 00:22:59,570
بدا بخير تماماً

370
00:22:59,940 --> 00:23:01,820
حُبّ؟ ماذا تقصدين؟

371
00:23:02,250 --> 00:23:05,060
أردتُ فقط أن نكون صديقين

372
00:23:05,060 --> 00:23:08,320
أعتقد بأنّ الحُبّ هو شيء يحدث
في بُعد آخر

373
00:23:08,730 --> 00:23:10,460
،لا أفهمه

374
00:23:10,460 --> 00:23:11,920
ولا أريد ذلك حقّاً

375
00:23:12,310 --> 00:23:13,680
ألم تكوني أنتِ

376
00:23:13,680 --> 00:23:17,460
الّتي كانت تصرخ قائلة بأنّه
مُنفطر القلب ومُكتئب؟

377
00:23:17,460 --> 00:23:18,770
...أقصد

378
00:23:18,770 --> 00:23:21,590
ما زال صغيراً جدّاً على كُلّ ذلك

379
00:23:21,590 --> 00:23:23,150
ما خطبه؟

380
00:23:23,150 --> 00:23:25,590
يتصرّف كخبير ما

381
00:23:25,590 --> 00:23:29,180
إذاً، هل لديك شخص كهذا؟

382
00:23:31,000 --> 00:23:34,190
المنزل مليء بالأشخاص الّذين
يحتاجون اهتمامي الدّائم

383
00:23:34,190 --> 00:23:36,590
لا أملك وقتاً لمثل هذه الأمور

384
00:23:38,120 --> 00:23:39,210
هكذا إذاً