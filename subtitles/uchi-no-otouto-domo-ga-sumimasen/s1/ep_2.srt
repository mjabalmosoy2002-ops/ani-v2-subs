1
00:00:07,600 --> 00:00:10,200
يتصرّف غين وكأنّ كلّ شيء طبيعيّ

2
00:00:10,560 --> 00:00:14,080
...حتّى بعد ما حدث في اللّيلة الماضية

3
00:00:14,830 --> 00:00:20,750
!هذه المرّة، نقلَني عملي إلى هوكّايدو

4
00:00:20,750 --> 00:00:21,860
!يا للهول

5
00:00:21,860 --> 00:00:24,870
!لا أستطيع العيش بعيدة عنك

6
00:00:24,870 --> 00:00:27,090
أعتقد عليك أن تفعل ما يُمليه عليك عملُك

7
00:00:27,090 --> 00:00:30,630
!رائع! كمّيات غير محدودة من السّلطعان يوميّاً

8
00:00:30,630 --> 00:00:33,800
ما دمت ستُرسل لنا المال، سنكون بخير

9
00:00:33,800 --> 00:00:35,810
حقّاً؟

10
00:00:36,510 --> 00:00:37,460
!مهلاً، مهلاً

11
00:00:37,460 --> 00:00:40,060
ألا ينبغي أن تقول على الأقلّ
!بأنّك سوف تفتقده؟

12
00:02:22,820 --> 00:02:24,330
اسمي إيندو ريو

13
00:02:24,590 --> 00:02:26,580
!اسمي ساواكي موني

14
00:02:26,580 --> 00:02:27,220
تشان-ريو

15
00:02:27,220 --> 00:02:27,960
تشان-موني

16
00:02:27,960 --> 00:02:29,070
!هما لقبانا

17
00:02:29,070 --> 00:02:30,380
!سررنا بلقائكِ

18
00:02:31,510 --> 00:02:33,330
!سررتُ بلقائكما أيضاً

19
00:02:34,250 --> 00:02:35,590
...بالمناسبة

20
00:02:35,970 --> 00:02:38,740
ما هو شعوركِ بعد أن أصبحتِ جزءاً
من عائلة ناريتا غين؟

21
00:02:40,670 --> 00:02:42,390
ماذا تقصدين؟

22
00:02:42,390 --> 00:02:45,380
أقصد بأنّكِ تستيقظين في كلّ يوم
!فترينه أمامكِ

23
00:02:45,380 --> 00:02:48,060
!وكأنّها السّعادة المثاليّة

24
00:02:48,060 --> 00:02:50,070
...ليس تماماً

25
00:02:50,190 --> 00:02:52,910
نـ-نصف عارٍ صباحاً؟

26
00:02:52,910 --> 00:02:54,720
كـ... كلّها؟

27
00:02:55,500 --> 00:02:57,700
لـ-ليس كلّها

28
00:02:57,700 --> 00:02:58,880
مهلاً لحظة

29
00:02:59,240 --> 00:03:01,330
هل رأيتِ لباسه التّحتيّ؟

30
00:03:01,330 --> 00:03:03,750
ما النّوع الّذي يرتديه؟

31
00:03:04,020 --> 00:03:07,870
...في الواقع، رأيتُه يرتدي شيئاً أزرق

32
00:03:10,100 --> 00:03:12,330
ما هي مُشكلتكِ بالضّبط؟

33
00:03:12,330 --> 00:03:15,450
كفّي عن الكشف عن مُختلف أشكال
المعلومات حولنا

34
00:03:15,450 --> 00:03:17,390
لقد سألتاني

35
00:03:17,390 --> 00:03:20,220
أيّ مُنحرف يُجيب عن أسئلة حول

36
00:03:20,220 --> 00:03:21,210
!ملابس أخوتكِ التّحتيّة؟

37
00:03:21,210 --> 00:03:22,720
أنا آسفة

38
00:03:23,870 --> 00:03:26,730
!لكن يبدو أنّك ذو شعبيّة حقّاً

39
00:03:26,730 --> 00:03:31,610
تعتقد أختك الكبرى بأنّها ينبغي أن تكون
!أكثر اعتزازاً بوسامتك

40
00:03:33,670 --> 00:03:36,450
لا تتملّقي لي بينما تلعبين دور
!الأخت الكُبرى" التّافه ذاك"

41
00:03:37,900 --> 00:03:42,790
وجود شخص واحد يفهمني فقط يكفيني

42
00:03:48,100 --> 00:03:49,400
ولا تنسي ذلك

43
00:03:49,400 --> 00:03:50,290
أيّتها الحمقاء

44
00:03:51,300 --> 00:03:52,600
إلى أين أنت ذاهب؟

45
00:03:52,600 --> 00:03:53,650
إلى عملي

46
00:03:55,790 --> 00:03:57,190
ماذا كان ذلك؟

47
00:03:57,190 --> 00:03:58,260
،لا أدري

48
00:03:58,260 --> 00:04:00,900
هل قصدَ بأنّ لديه شخص كهذا بالفعل؟

49
00:04:00,900 --> 00:04:03,140
تقصدين حبيبة ما؟

50
00:04:03,140 --> 00:04:05,310
...أجل، أجل. حبيبة

51
00:04:06,020 --> 00:04:07,520
!حبيبة؟

52
00:04:09,200 --> 00:04:10,270
—تفضّل بالدّخول

53
00:04:11,270 --> 00:04:12,700
طاولة لشخصين

54
00:04:12,700 --> 00:04:13,800
!انقلعا

55
00:04:15,590 --> 00:04:18,690
لماذا فكّرتَ في المجيء إلى هنا والتّحقيق؟

56
00:04:18,690 --> 00:04:20,200
،هذا مُجرّد حدس

57
00:04:20,670 --> 00:04:22,630
لكن أعتقد بأنّ غين مُهتمّ بالنّساء الأكبر سنّاً

58
00:04:22,630 --> 00:04:23,990
ما الّذي يجعلك تعتقد ذلك؟

59
00:04:25,210 --> 00:04:28,640
لأنّه مُجبَر على التّعامل مع أشخاص
أصغر سنّاً طوال الوقت

60
00:04:29,070 --> 00:04:31,780
في عمله، هناك مُختلف أنواع
النّساء الأكبر سنّاً

61
00:04:31,780 --> 00:04:33,440
لديه فُرص تعارُف كثيرة

62
00:04:33,440 --> 00:04:34,870
!أنت مُذهل

63
00:04:34,870 --> 00:04:36,510
!كمُتحرٍّ خبير

64
00:04:37,520 --> 00:04:43,470
إذاً بدأ المُدير يرتعد وأعاد ترتيب
!المُناوبات وهو في حالة هلع

65
00:04:41,770 --> 00:04:45,560
شخص يفهمه حقّاً إذاً؟

66
00:04:46,120 --> 00:04:49,340
ماذا ستفعلين إذا كان لديه حبيبة؟

67
00:04:50,420 --> 00:04:51,950
...في هذه الحالة

68
00:04:52,710 --> 00:04:54,590
أعتقد سيكون من الأفضل أن أعرّف عن نفسي

69
00:04:54,590 --> 00:04:55,870
قد تفعلينها حقّاً

70
00:04:54,600 --> 00:04:56,570
...شكراً لكِ على الاعتناء بأخي

71
00:04:56,840 --> 00:04:58,160
بئس الأمر

72
00:04:58,160 --> 00:05:01,410
كنتُ أرى بأنّه سيكون من المُمتع
أن تُصابي بالغيرة

73
00:05:01,410 --> 00:05:02,590
على أخي الصّغير؟

74
00:05:02,590 --> 00:05:04,280
ألن تغاري ولو قليلاً؟

75
00:05:04,540 --> 00:05:07,450
فسيعني ذلك بأنّ غين ينتمي لشخصٍ آخر

76
00:05:15,460 --> 00:05:18,100
!أهلاً بعودتك

77
00:05:18,100 --> 00:05:19,010
تأخّرت في العودة

78
00:05:19,260 --> 00:05:21,690
كان لدينا نقص في الطّاقم اليوم

79
00:05:21,690 --> 00:05:22,940
أتريد الاستحمام؟

80
00:05:22,940 --> 00:05:24,280
الحمّامٌ جاهزٌ الآن

81
00:05:24,760 --> 00:05:26,160
أم أنّك تريد الاستحمام لاحقاً؟

82
00:05:26,160 --> 00:05:28,880
إن كنتَ جائعاً، فأستطيع أن أعدّ
...لك شيئاً على الفور

83
00:05:30,230 --> 00:05:31,770
لا داعي

84
00:05:31,770 --> 00:05:33,560
أتعتقدين نفسكِ زوجتي؟

85
00:05:35,270 --> 00:05:37,120
!لستُ زوجتك! أنا أختك الكبرى

86
00:05:37,120 --> 00:05:38,640
أختي الكبرى المُولعة إذاً

87
00:05:38,640 --> 00:05:39,280
—المُو

88
00:05:39,280 --> 00:05:40,900
—كنتُ فقط

89
00:05:39,900 --> 00:05:41,620
،ليس عليكِ القلق بشأني

90
00:05:41,620 --> 00:05:44,780
لذا استرخي أو ما شابه فحسب

91
00:05:44,780 --> 00:05:48,580
بدأتِ في مدرسة جديدة للتو، لذا
لا بُدّ أنّكِ مُنهكة ذهنيّاً

92
00:05:49,700 --> 00:05:51,270
ها هو ذا من جديد

93
00:05:51,270 --> 00:05:54,430
يدّعي الصّلابة، لكن لا يولي اهتماماً لنفسه

94
00:05:54,430 --> 00:05:56,670
أتريد اللّعب مع غوميز؟

95
00:05:56,670 --> 00:05:57,630
لا

96
00:05:57,630 --> 00:06:00,050
!بربّك

97
00:05:58,170 --> 00:06:00,460
...قال بأنّ غين ينتمي لشخص آخر

98
00:06:01,400 --> 00:06:03,140
لا أعلم

99
00:06:03,640 --> 00:06:06,220
،غين يعطي الأولويّة لعائلته دوماً

100
00:06:06,720 --> 00:06:10,020
لذا أعتقد من اللّطيف أن يعامله
شخصٌ مُعاملة خاصّة

101
00:06:11,080 --> 00:06:12,850
امرأة بالغة؟

102
00:06:13,100 --> 00:06:14,270
هذا صحيح

103
00:06:14,670 --> 00:06:17,490
يبدو أنّ هناك فتاة في مكان عمله
ينسجم معها

104
00:06:17,490 --> 00:06:19,200
وهي بالغة لعينة

105
00:06:19,200 --> 00:06:21,840
ألن تكون فضيحة إذا مسّتْه بضُرّ؟

106
00:06:21,840 --> 00:06:23,500
هل سمعتِ شيئاً؟

107
00:06:23,500 --> 00:06:26,030
...لـ-لا، لم يذكر شيئاً

108
00:06:26,030 --> 00:06:29,660
ماذا سأفعل إذا تمّ الإعلان عن الأمر
...بشكلٍ رسميّ فجأة

109
00:06:29,660 --> 00:06:31,430
...لحظة... لا أستطيع

110
00:06:31,430 --> 00:06:33,590
!إ-إنّه غين الجميع في نهاية المطاف

111
00:06:33,590 --> 00:06:34,960
،إذا أراد مُواعدة أحد

112
00:06:34,960 --> 00:06:38,840
!فأريده أن يكون مع فتاة تُسعده

113
00:06:40,960 --> 00:06:42,920
سأغادر الآن

114
00:06:43,680 --> 00:06:45,420
إلى اللّقاء

115
00:06:45,420 --> 00:06:48,180
بمن سيلتقي وأين في هذا الوقت
الباكر من صباح الأحد؟

116
00:06:48,900 --> 00:06:51,690
لكن ليس وكأنّني أستطيع سؤاله عن الأمر

117
00:06:53,140 --> 00:06:54,520
أتريدين اللّحاق به؟

118
00:06:56,330 --> 00:06:59,570
كان يُغادر بشكل عشوائيّ من قبل أيضاً

119
00:07:00,790 --> 00:07:02,340
،لكن إذا سألنا إلى أين هو ذاهب

120
00:07:02,340 --> 00:07:04,490
فسوف يمتعض ولن يخبرنا

121
00:07:04,490 --> 00:07:07,280
رُبّما سنلتقي بأصدقاء فحسب؟

122
00:07:07,280 --> 00:07:11,480
في أيّام كهذه، دائماً ما يعود والبسمة في وجهه

123
00:07:11,480 --> 00:07:15,350
كما الشّعور عندما تمرّين من جانب
امرأة بالغة وتشمّين رائحة عطِرة منها

124
00:07:15,350 --> 00:07:16,290
هكذا

125
00:07:16,290 --> 00:07:17,290
!سيّئ

126
00:07:17,290 --> 00:07:18,750
!هذا سيّئ

127
00:07:18,750 --> 00:07:21,400
!حسناً، هذا غير مقبول حتماً وينبغي أن نغادر حالاً

128
00:07:21,750 --> 00:07:23,080
توقّعت. إنّها امرأة

129
00:07:24,710 --> 00:07:26,050
!آسفة لتأخُّري

130
00:07:26,340 --> 00:07:27,330
...هذا

131
00:07:27,720 --> 00:07:28,470
حسناً

132
00:07:28,470 --> 00:07:30,510
والآن، لنجمع دليلاً غير قابل للدّحض

133
00:07:30,510 --> 00:07:33,690
!لا يجدر بك أن تفعل ذلك حقّاً

134
00:07:33,690 --> 00:07:34,560
أنتم

135
00:07:35,840 --> 00:07:37,230
ماذا تفعلون هنا؟

136
00:07:37,230 --> 00:07:40,060
ا-المعذرة، هناك مُبرّر جيّد لهذا

137
00:07:41,060 --> 00:07:42,820
!غين-كن

138
00:07:42,820 --> 00:07:44,320
!اشتقتُ لك كثيراً

139
00:07:44,320 --> 00:07:45,570
!طفلة؟

140
00:07:46,000 --> 00:07:47,940
بئساً

141
00:07:47,940 --> 00:07:50,490
أعتقد سأجعلكم تُرافقون بعضكم
الآخر جميعاً أيضاً

142
00:07:56,290 --> 00:07:58,150
!أهلاً وسهلاً

143
00:07:58,150 --> 00:07:59,590
ما هذا؟

144
00:07:59,590 --> 00:08:00,940
أخبريني

145
00:08:00,940 --> 00:08:04,310
هل أنتِ جزءٌ من عائلة غين حقّاً؟

146
00:08:04,310 --> 00:08:05,520
أجل

147
00:08:05,520 --> 00:08:12,300
!في المُستقبل، سأكون زوجة غين-كن

148
00:08:12,720 --> 00:08:13,920
...متى قد

149
00:08:13,920 --> 00:08:15,310
!لم أفعل شيئاً

150
00:08:16,250 --> 00:08:17,600
!أمّي

151
00:08:20,340 --> 00:08:24,210
تاماكي-سان هي زميلتي في العمل
ودائماً ما تعتني بي

152
00:08:24,760 --> 00:08:27,450
أحياناً، تُقيم هذه الفعاليّات مع صديقاتها
الأُمّهات الأُخريات

153
00:08:27,450 --> 00:08:29,360
تجري أمور كثيرة معها

154
00:08:30,760 --> 00:08:34,220
أنا هنا كبديل عن زوجها المشغول بالعمل

155
00:08:34,220 --> 00:08:34,900
هذا ما في الأمر

156
00:08:34,900 --> 00:08:36,620
...إنّه يتعاطف معها فحسب إذاً

157
00:08:36,620 --> 00:08:38,540
هل تفعلان مثل هذه الأشياء دوماً؟

158
00:08:38,540 --> 00:08:40,320
إن لم أكن مشغولاً

159
00:08:40,660 --> 00:08:43,710
لم أتوقّع بأنّ هذا مُهمّ بما يكفي لذِكره

160
00:08:43,710 --> 00:08:45,800
!لكنّه كذلك

161
00:08:45,800 --> 00:08:48,130
الفتيات في المدرسة كُنّ قلقات عليك

162
00:08:48,540 --> 00:08:50,520
ما السّبب؟

163
00:08:51,110 --> 00:08:53,720
ما المُسلّي في الثّرثرة حولي؟

164
00:08:55,980 --> 00:08:59,980
كنتُ أقول لنفسي بأنّك قاسٍ جدّاً مع نفسك

165
00:09:00,310 --> 00:09:03,010
لا يروقني هذا بعض الشّيء

166
00:09:03,610 --> 00:09:08,720
وكأنّك تقول بأنّ الخِصال الجيّدة
فيك غير مُهمّة

167
00:09:08,720 --> 00:09:12,490
بصفتي أختك الكبرى، هذا يُحزنني بعض الشّيء

168
00:09:15,710 --> 00:09:16,580
!مهلاً

169
00:09:16,580 --> 00:09:18,160
!ليس هذا ثانية

170
00:09:18,750 --> 00:09:20,970
أنا غاضبة فعلاً الآن

171
00:09:21,540 --> 00:09:24,990
أنتِ جريئةٌ حقّاً

172
00:09:27,590 --> 00:09:29,020
المعذرة

173
00:09:29,020 --> 00:09:29,760
نعم

174
00:09:30,190 --> 00:09:31,490
كم ثمن هذا؟

175
00:09:31,490 --> 00:09:33,300
هل فهمَ ذلك حقّاً؟

176
00:09:33,700 --> 00:09:36,560
كنتُ أحاول إخباره بشيء جادّ

177
00:09:37,560 --> 00:09:39,790
رُبّما هو غير مُتقبِّل للأمر حاليّاً؟

178
00:09:59,480 --> 00:10:01,200
!شكراً لعملك

179
00:10:01,460 --> 00:10:02,970
أحسنت صنعاً اليوم

180
00:10:02,970 --> 00:10:06,210
نحن نُنجز أكثر أثناء وجودك هنا

181
00:10:06,210 --> 00:10:08,590
من الواضح أنّها تستغلّه

182
00:10:08,590 --> 00:10:10,530
سوف نُغادر الآن

183
00:10:10,530 --> 00:10:13,360
من فضلك بلّغ شكري لأختك الكبرى

184
00:10:13,360 --> 00:10:14,660
!وداعاً

185
00:10:19,260 --> 00:10:23,440
لم يكن عليها تدمير نفسها بينما
كنّا نُقدّم المُساعدة فحسب

186
00:10:23,800 --> 00:10:27,260
على إيتو-تشان أن تعتني بنفسها
بشكل أفضل

187
00:10:32,660 --> 00:10:33,960
غريب

188
00:10:33,960 --> 00:10:35,780
أشعر بدفء في جسدي

189
00:10:36,410 --> 00:10:39,920
ماذا فعلتُ اليوم؟

190
00:10:40,720 --> 00:10:44,760
لا أعلم، لكن أشعر بأنّني قلقة
على غين كثيراً

191
00:10:50,490 --> 00:10:51,540
على ذِكر الأمر

192
00:10:51,540 --> 00:10:55,010
أريد الاهتمام بغين

193
00:10:57,390 --> 00:11:00,720
...غين... أيُّها الأحمق

194
00:11:05,030 --> 00:11:06,120
حمقاء

195
00:11:09,360 --> 00:11:12,400
أظنّني أختاً كُبرى مُولعة حقّاً، صحيح؟

196
00:11:16,040 --> 00:11:18,300
تريدينني أن أذهب إلى هوكّايدو أيضاً؟

197
00:11:18,950 --> 00:11:21,750
أجل، هذا الشّيء المنطقيّ الوحيد

198
00:11:21,750 --> 00:11:23,870
أنتما قد تزوّجتُما للتو

199
00:11:23,870 --> 00:11:25,740
نشكركِ على تقديركِ

200
00:11:25,740 --> 00:11:27,710
لكن لا يمكننا ترككم هنا بمفردكم

201
00:11:27,710 --> 00:11:29,630
أنتِ فتاة

202
00:11:29,630 --> 00:11:31,790
لا يمكننا أن ندعكِ تبقين هنا
وحيدة مع مجموعة

203
00:11:31,790 --> 00:11:33,380
!من الفتيان القذرين المليئين بالهرمونات

204
00:11:33,710 --> 00:11:36,310
،هذا أشبه بدخول قفص بلا أسلحة

205
00:11:36,310 --> 00:11:38,470
!وفي الدّاخل وحش لم يأكل منذ شهر

206
00:11:38,800 --> 00:11:40,380
هل يقصدنا نحن؟

207
00:11:40,380 --> 00:11:42,260
من غيرنا؟

208
00:11:42,520 --> 00:11:44,160
،حسناً إذاً، إن كنتما ستذهبان

209
00:11:44,160 --> 00:11:46,680
فلِمَ لا تأخذانها معكم وتُغادرون أنتم الثّلاثة؟

210
00:11:46,680 --> 00:11:48,980
سيُحقّق ذلك سلاماً

211
00:11:48,980 --> 00:11:49,730
!مهلاً

212
00:11:49,730 --> 00:11:51,980
!لست أنت من يُقرّر

213
00:11:51,980 --> 00:11:54,610
تقول هذا الفتاة الّتي كانت تُحاول
أن تُقرّر من تلقاء نفسها

214
00:11:54,610 --> 00:11:56,190
!أكره ذلك، أكره ذلك

215
00:11:56,190 --> 00:11:58,000
!لا أريد الابتعاد عن إيتو-تشان

216
00:11:58,000 --> 00:12:00,450
...المعذرة، هل يمكنك التوقُّف عن هذا

217
00:11:58,250 --> 00:12:00,870
!لم أكن أُقرّر شيئاً

218
00:12:00,870 --> 00:12:01,850
!يكفي

219
00:12:01,850 --> 00:12:04,290
!من فضلكم لا تتشاجروا بسببي

220
00:12:04,920 --> 00:12:08,740
على أيّ حال، سأذهب إلى هناك
!بمفرديوهذا أمرٌ نهائيّ

221
00:12:08,740 --> 00:12:09,880
!انصراف

222
00:12:13,590 --> 00:12:17,440
أما من طريقة حقّاً لإقناعه؟

223
00:12:17,440 --> 00:12:21,550
سيشعر بالوحشة الشّديدة إذا
إذا قضى وقته هناك وحيداً

224
00:12:21,550 --> 00:12:27,180
يُراودني نفس الشّعور، لكن لماذاN\تتكلّمين بهذا الشّكل؟

225
00:12:27,180 --> 00:12:29,920
لأنّك طلبت منّي الابتعاد عن غرفكم

226
00:12:30,540 --> 00:12:32,250
سأكرّر كلامي

227
00:12:32,670 --> 00:12:35,220
أنتِ وأمّي وأبي ينبغي أن ترحلوا

228
00:12:35,220 --> 00:12:37,690
جُلّ اهتمامك هو رحيلي، أليس كذلك؟

229
00:12:37,690 --> 00:12:42,320
أريد فقط أن يقضي أبي وأمّي
!وقتهما معاً فحسب

230
00:12:42,320 --> 00:12:45,550
إن بقيتِ هنا، فستُحاولين لعب
دور "الأخت الكُبرى" التّافه ذاك

231
00:12:45,550 --> 00:12:46,980
أنا أكبر سنّاً فعلاً

232
00:12:46,980 --> 00:12:49,260
وسيترتّب علينا أن نكون أكثر
حرصاً لأنّكِ فتاة

233
00:12:49,260 --> 00:12:51,580
ألا تتمشّى في المنزل شبه عارٍ
في كلّ صباح؟

234
00:12:51,580 --> 00:12:56,050
فضلاً عن ذلك، ليس وكأنّكِ كنتِ تريدين العيش
معنا نحن الأخوة الأصغر، صحيح؟

235
00:12:57,270 --> 00:12:59,560
،لن تكوني مُضطرّة للاعتناء بنا

236
00:12:59,560 --> 00:13:01,120
ويمكنكِ أن تعيشي حياتكِ بسلام

237
00:13:01,120 --> 00:13:04,030
سأكون قلقة إذا غادرتُ

238
00:13:04,030 --> 00:13:06,030
هوّني عليّ

239
00:13:06,030 --> 00:13:08,890
كنّا نهتمّ ببعضنا بشكل جيّد حتّى الآن

240
00:13:10,510 --> 00:13:13,200
الأهمّ، أودُّ الخروج الآن

241
00:13:15,130 --> 00:13:19,340
وأنا هنا الّتي كنتُ أعتقد بأنّني
أستطيع أن نصبح عائلة واحدة

242
00:13:19,340 --> 00:13:21,400
...ثمّ يأتي ويقول ذلك

243
00:13:22,100 --> 00:13:25,270
،إذا بقيتِ هنا بمفردكِ

244
00:13:25,270 --> 00:13:26,910
فماذا سيحدث إذاً؟

245
00:13:29,080 --> 00:13:32,040
يبدو أنّه من الأفضل أن أُريكِ

246
00:13:39,140 --> 00:13:43,850
أنتِ مرِحةٌ زيادة عن اللّزوم وتُقنعين
نفسكِ بأنّنا عائلة الآن

247
00:13:44,380 --> 00:13:46,770
لكنّكِ تنسين شيئاً هامّاً

248
00:13:47,430 --> 00:13:48,430
غين؟

249
00:13:48,800 --> 00:13:50,900
في نهاية المطاف، لسنا مُرتبطين بالدّم

250
00:13:51,810 --> 00:13:56,180
،يمكننا المُحاولة قدر ما نشاء
لكن لن نكون عائلة أبداً

251
00:13:57,150 --> 00:13:58,810
،إذا تركتِ نفسكِ مكشوفة هكذا

252
00:13:58,810 --> 00:13:59,810
—فسوف تتأذّين

253
00:14:00,790 --> 00:14:01,900
فهمت

254
00:14:04,540 --> 00:14:07,160
أفهمك بوضوح

255
00:14:07,630 --> 00:14:09,500
سأفكّر في الأمر ثانية

256
00:14:11,910 --> 00:14:16,170
يسرّني أنّني تمكّنتُ من معرفة
مشاعرك تجاهي

257
00:14:21,850 --> 00:14:23,010
كاذب

258
00:14:25,390 --> 00:14:26,940
إنّه كاذب

259
00:14:28,680 --> 00:14:31,430
أتريدين أن نُعدّه معاً؟

260
00:14:31,680 --> 00:14:32,950
،آنذاك

261
00:14:32,950 --> 00:14:37,870
كنتُ سعيدة جدّاً لأنّني ظننتُ بأنّه
كان يحاول ضمّي للعائلة

262
00:14:40,480 --> 00:14:42,490
مهلاً، نحن عالقون

263
00:14:46,240 --> 00:14:48,660
،لا أعرف ما حدث بالضّبط

264
00:14:48,660 --> 00:14:51,220
لكن إذا تشاجرتما، فتصالحا بسرعة

265
00:14:51,220 --> 00:14:52,590
لا يهمّ

266
00:14:52,590 --> 00:14:54,830
سترحل قريباً على أيّ حال

267
00:14:58,680 --> 00:15:00,910
...عليك أن تُبرّر موقفك

268
00:15:00,910 --> 00:15:03,800
!اصطادَ أشيائي المُفضّلة

269
00:15:04,640 --> 00:15:05,930
هكذا إذاً

270
00:15:05,930 --> 00:15:07,730
فرضتَ نفسك عليها في دورة المياه

271
00:15:07,730 --> 00:15:08,840
أنت قمامة

272
00:15:08,840 --> 00:15:12,140
ارتأيتُ بأنّ بثّ بعض الخوف
في قلبها قد ينفعها

273
00:15:12,720 --> 00:15:17,040
أنا حقّاً لا أريدها أن بقى
لأنّها تشفق علينا

274
00:15:17,940 --> 00:15:19,460
أنا مُدرك

275
00:15:19,460 --> 00:15:22,320
لسبب مجيئها الحقيقيّ إلى منزلنا

276
00:15:23,470 --> 00:15:26,640
أنا آسفة حقّاً لأنّني لم أخبركِ بأنّكِ
ستحصلين على أخوة أصغر سنّاً

277
00:15:27,110 --> 00:15:32,450
أعرف جيّداً بأنّكِ لطالما أردتِ
حياةً مع أمّ وأب

278
00:15:34,060 --> 00:15:38,250
لكن بعدها كتمت مشاعرها الخاصّة

279
00:15:39,430 --> 00:15:41,630
ألا يستفزّك هذا؟

280
00:15:42,890 --> 00:15:46,510
ربّما ما يقوله غين صحيح

281
00:15:47,630 --> 00:15:51,510
أقصد بأنّ هذا الشّيء الّذي
"ندعوه "عائلة

282
00:15:51,510 --> 00:15:54,540
هو مجموعة مصطنعة من الغُرباء

283
00:16:01,510 --> 00:16:05,530
هناك جدران لا يمكن اختراقها
،لأنّنا غير مُرتبطين بالدّم

284
00:16:05,530 --> 00:16:09,540
كانت نظرتي ضيّقة على مُلاحظة ذلك

285
00:16:10,730 --> 00:16:12,730
،كنتُ الوحيدة المُتحمّسة

286
00:16:12,730 --> 00:16:15,410
لذا أنا متأكّدة بأنّهم يعتقدونني سخيفة

287
00:16:18,800 --> 00:16:20,430
سنذهب إذاً

288
00:16:20,430 --> 00:16:22,970
،سنغيب لليلةٍ واحدة فقط بحثاً عن غرفة

289
00:16:22,970 --> 00:16:24,840
لذا لا داعي للمجيء يا إيتو-تشان

290
00:16:24,840 --> 00:16:28,630
!لا، لا، لا، لا، لا يمكنك الذّهاب

291
00:16:27,470 --> 00:16:28,630
!لكن سأفعل

292
00:16:28,630 --> 00:16:31,140
أريد رؤية المكان الّذي قد أقيم فيه

293
00:16:31,140 --> 00:16:34,370
!أتوسّل إليكِ، لا ترحلي أرجوكِ

294
00:16:34,370 --> 00:16:35,350
...روي-كن

295
00:16:35,350 --> 00:16:38,550
!لا أستطيع العيش من دون طعامكِ

296
00:16:38,550 --> 00:16:40,850
!تحمّلي مسؤوليّة تَركي بهذا الوضع

297
00:16:41,150 --> 00:16:42,610
...أنا مُوزِّعة الطّعام

298
00:16:42,610 --> 00:16:44,520
تمالك نفسك

299
00:16:44,870 --> 00:16:50,210
أبي، احرص على إيجاد مكان
يتّسع لثلاثة أشخاص

300
00:16:50,210 --> 00:16:53,660
أعتقد بصدق بأنّ هذا سيكون الأمثل

301
00:16:54,240 --> 00:16:56,700
...لا داعي لتؤيّد ذلك أيضاً

302
00:16:56,700 --> 00:16:59,160
...ظننتُك ستكون أكثر إحباطاً

303
00:16:59,160 --> 00:17:00,170
حسناً

304
00:17:00,760 --> 00:17:04,010
،إن كنت تعتقد ذلك فعلاً
فسأُفكِّر في الأمر

305
00:17:09,940 --> 00:17:10,620
ماذا؟

306
00:17:10,620 --> 00:17:11,930
اذهبي فحسب

307
00:17:15,900 --> 00:17:19,900
أتعلمين؟ لستِ مُضطرّة للعودة حتّى

308
00:17:21,310 --> 00:17:23,520
!ماذا... هذا كلام فظيع تقوله

309
00:17:23,520 --> 00:17:26,040
سيُوفّر ذلك نفقات السّفر

310
00:17:26,040 --> 00:17:27,220
!بالطّبع

311
00:17:27,220 --> 00:17:28,320
!الادّخار مُهمّ

312
00:17:28,550 --> 00:17:31,190
لكن لن أُبالي حتّى إذا ندمتَ
!على قول كلّ ذلك

313
00:17:31,190 --> 00:17:32,570
—أيّها الأحمـ

314
00:17:33,030 --> 00:17:34,950
!ستُصبح أصلع

315
00:17:37,080 --> 00:17:38,300
!لا! لا

316
00:17:38,300 --> 00:17:41,000
!فليوقفها أحدٌ ما

317
00:17:39,630 --> 00:17:40,460
!اصمت

318
00:17:41,000 --> 00:17:42,830
!دعها

319
00:17:42,830 --> 00:17:44,580
إنّها غريبة ليس إلّا

320
00:17:49,710 --> 00:17:50,360
!أنت لئيم

321
00:17:50,360 --> 00:17:52,460
!كيف يُطاوعك قلبُك أن تقول عنها ذلك؟

322
00:17:52,460 --> 00:17:55,260
!ظننتُ بأنّنا سنصبح عائلة جميعاً؟

323
00:17:55,260 --> 00:17:57,730
...مهلاً، هذه للصّراصير

324
00:17:55,500 --> 00:17:57,720
!أكره وقاحتك لقولك ذلك

325
00:17:57,720 --> 00:18:00,840
!فلتفقد كُلّ شعرك وتنقلع

326
00:18:00,840 --> 00:18:02,540
!سأهرب من هذا المنزل أيضاً

327
00:18:03,320 --> 00:18:05,370
...بئساً

328
00:18:14,720 --> 00:18:17,560
...إن كان لديك أيّ ملابس

329
00:18:26,810 --> 00:18:27,930
!بئس الأمر

330
00:18:27,930 --> 00:18:30,810
!اليوم هو يوم الحليب بـ 95 ين

331
00:18:30,810 --> 00:18:32,070
ماذا أفعل؟

332
00:18:32,070 --> 00:18:34,010
روي-كن يشرب الكثير من
الحليب صباحاً

333
00:18:34,010 --> 00:18:35,340
!لا أريد أن أهجرهم

334
00:18:35,720 --> 00:18:37,340
رُبّما ينبغي أن أخبرهم؟

335
00:18:37,340 --> 00:18:39,100
..."اذهبوا واشتروا الحليب"

336
00:18:39,410 --> 00:18:41,350
في نهاية المطاف، لسنا مُرتبطين بالدّم

337
00:18:44,020 --> 00:18:45,350
...غين

338
00:18:46,340 --> 00:18:51,540
هل قلتَ كُلّ ذلك لأنّك ارتأيتَ
بأنّ حياة مع أمٍّ وأب

339
00:18:51,540 --> 00:18:54,940
ستكون أقرب إلى عائلة طبيعيّة؟

340
00:18:56,330 --> 00:19:00,980
أعني بأنّني لا أتخيّل أن يقول شخصٌ
،لطيفٌ مثلك كلاماً كهذا

341
00:19:00,980 --> 00:19:01,900
ولو كان مزحة

342
00:19:04,200 --> 00:19:07,810
بالتّأكيد، كنتُ لأحلم بتلك الحياة الطّبيعيّة

343
00:19:07,810 --> 00:19:10,210
لكن لا أُبالي لأيّ من هذا بعد الآن

344
00:19:12,180 --> 00:19:14,740
العيش معكم جميعاً جعلَني أُدرك ذلك

345
00:19:14,740 --> 00:19:19,640
ما أردتُه لم يكن ما يعتبره المُجتمع
"عائلة طبيعيّة"

346
00:19:26,230 --> 00:19:27,490
إيتو-تشان

347
00:19:32,830 --> 00:19:38,540
"إنّما العائلة هي حيث من "الطّبيعيّ
أن يتواجد شخصٌ بجانبك دوماً

348
00:19:40,300 --> 00:19:41,240
أنتِ

349
00:19:41,490 --> 00:19:43,240
استغرقت وقتاً طويلاً، ينبغي أن تخرج

350
00:19:44,420 --> 00:19:46,570
أعلم بأنّك جائع

351
00:19:51,710 --> 00:19:52,740
تبّاً

352
00:19:52,740 --> 00:19:55,240
بدأ يُقلّد السّلوك الغريب للشّخص
الّذي في الطّابق العلويّ

353
00:19:57,960 --> 00:20:00,100
هناك طعامٌ حتّى ليوم غد؟

354
00:20:08,330 --> 00:20:09,510
عزيزي عين

355
00:20:09,510 --> 00:20:11,160
،عندما تُسخّن الكاري

356
00:20:11,160 --> 00:20:14,350
احرص على استخدام حرارة
هادئة ولا تترك الفرن

357
00:20:14,810 --> 00:20:17,300
هناك سلطة أيضاً، لذا كلوها
معاً من فضلكم

358
00:20:17,680 --> 00:20:19,610
متى فعلتْ كُلّ هذا؟

359
00:20:19,930 --> 00:20:21,930
هل استيقظتْ باكراً ثانية؟

360
00:20:22,660 --> 00:20:26,580
وأيضاً، قال سيو-كن بأنّه
،لا يُحبّ الطّماطم

361
00:20:26,580 --> 00:20:28,550
،لكن أحاول تخفيف عادته تلك

362
00:20:28,550 --> 00:20:30,670
لذا أضفتُها خلسة للكاري

363
00:20:30,670 --> 00:20:32,430
أنا متأكّدة بأنّ الأمور ستكون بخير

364
00:20:32,430 --> 00:20:34,880
حرصتُ على جعل مذاقه مُناسباً للجميع

365
00:20:36,890 --> 00:20:41,210
هل تحتسب لكلّ هذه الأمور عندما تطبخ؟

366
00:20:43,780 --> 00:20:46,070
،إذا كنتَ تشعر بأنّك مُخطئ ولو قليلاً

367
00:20:46,070 --> 00:20:48,170
فيجدر بك الاعتذار والسّعي لإعادتها

368
00:20:48,170 --> 00:20:49,310
ما الّذي تتحدّث عنه؟

369
00:20:49,310 --> 00:20:51,480
وكأنّك لا تعلم

370
00:20:51,480 --> 00:20:54,740
إذا غادرتَ الآن، فأعتقد ما زلتَ
قادراً على اللّحاق

371
00:20:58,590 --> 00:21:01,490
حتّى لو ذهبت، لن تستمع لي

372
00:21:03,000 --> 00:21:05,820
ستعود حياتُنا إلى ما كانت عليه سابقاً

373
00:21:05,820 --> 00:21:07,620
لكن إلى أين أنت ذاهب؟

374
00:21:08,030 --> 00:21:10,620
،تذكّرتُ بأنّ ذلك الحليب عليه تنزيلات

375
00:21:10,620 --> 00:21:12,040
!لذا سأذهب وأشتري بعضاً منه

376
00:21:12,350 --> 00:21:13,790
هكذا إذاً

377
00:21:22,090 --> 00:21:23,320
لماذا؟

378
00:21:23,320 --> 00:21:27,180
تذكّرتُ للتو بأنّ هناك بعض الأشياء
الّتي نسيتُ إحضارها في المتجر

379
00:21:27,180 --> 00:21:29,190
!يمكننا فعل ذلك بمفردنا

380
00:21:29,190 --> 00:21:30,730
...في الواقع، بخصوص ذلك

381
00:21:31,850 --> 00:21:34,110
!على أيّ حال، لن أذهب

382
00:21:34,570 --> 00:21:38,360
!أنا مُمتعضة لأنّ الأمور سارت وفق ما تريد

383
00:21:38,900 --> 00:21:42,020
...أنا متأسّفة على والدينا، لكن

384
00:21:46,540 --> 00:21:47,900
ما الأمر؟

385
00:21:47,900 --> 00:21:51,000
ها أنا كنتُ جاهزاً للمجيء وإعادتكِ

386
00:21:54,120 --> 00:21:57,770
يمكنك أن تطلب منّي المُغادرة قدر
ما تشاء، لكن لن أذهب إلى مكان

387
00:21:58,230 --> 00:22:00,650
أليس لديك أيّ شيء لتقوله لي؟

388
00:22:02,440 --> 00:22:04,760
،منذ اللّقاء بعائلتي الجديدة

389
00:22:05,370 --> 00:22:08,260
لم يمضِ يوم هادئ واحد حقّاً

390
00:22:09,540 --> 00:22:11,160
...لكنّني

391
00:22:11,950 --> 00:22:13,930
أهلاً بعودتكِ يا إيتو

392
00:22:14,590 --> 00:22:17,160
أحبّ أخوتي الصِّغار...