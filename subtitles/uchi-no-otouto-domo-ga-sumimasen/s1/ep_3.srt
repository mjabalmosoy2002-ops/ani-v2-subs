1
00:00:01,850 --> 00:00:05,860
كنّا نعيش بمعزل عن أبي وأمّي
لمدّة أسبوع كامل الآن

2
00:00:08,070 --> 00:00:09,280
!أنتما

3
00:00:09,280 --> 00:00:11,080
لا يجوز أن تتكاسلا وتلعبا ألعاب
!الفيديو طوال اليوم

4
00:00:11,080 --> 00:00:12,900
بالإضافة إلى أنّ المُقرمشات والأكلات
!الخفيفة مُنتشرة في كلّ مكان

5
00:00:12,900 --> 00:00:15,030
ومن فضلك، لا تدع الضّفدع
!يقفز من مكانٍ لآخر بحرّية

6
00:00:17,710 --> 00:00:19,390
—سنُنظّف كُلّ شيء لاحقاً

7
00:00:19,390 --> 00:00:21,460
!قلتَ ذلك قبل ساعتين

8
00:00:21,460 --> 00:00:23,620
!أسرعا واستحمّا

9
00:00:30,200 --> 00:00:31,550
...بئساً

10
00:00:32,580 --> 00:00:34,430
،في هذه اللّحظة في منزل ناريتا

11
00:00:34,860 --> 00:00:37,020
مفهوم النّظام على وشك الانهيار

12
00:02:12,310 --> 00:02:13,980
ما زلتِ مُستيقظة؟

13
00:02:14,440 --> 00:02:15,660
الحمّام مُتاح

14
00:02:16,360 --> 00:02:19,190
سأذهب حالما أنتهي من إعداد
غداء يوم غد

15
00:02:19,190 --> 00:02:21,800
هل هذه كفتة قريدس؟

16
00:02:22,410 --> 00:02:23,840
!لا تأكلها الآن

17
00:02:25,250 --> 00:02:27,410
واحدة ستكون كافية

18
00:02:30,000 --> 00:02:31,480
!لا

19
00:02:31,480 --> 00:02:32,250
!كلب سيّئ

20
00:02:32,250 --> 00:02:33,330
!اخلد إلى النّوم

21
00:02:33,700 --> 00:02:34,770
بخيلة جدّاً

22
00:02:36,130 --> 00:02:37,190
هذا سيّئ

23
00:02:37,190 --> 00:02:38,550
الوقت ليس مُناسباً للتردُّد

24
00:02:38,550 --> 00:02:40,050
يجب عليّ حماية النّظام

25
00:02:40,920 --> 00:02:43,140
!لقد وعدت

26
00:02:43,430 --> 00:02:45,130
،قرّرنا هذا في الوقت الحاليّ

27
00:02:45,130 --> 00:02:48,060
سأكون الوحيدة الّتي ستذهب مع أبيك
عند انتقاله إلى عمله الجديد

28
00:02:48,060 --> 00:02:50,190
!لكن سنعود بشكل مُتكرّر للاطمئنان

29
00:02:50,570 --> 00:02:53,560
أنتما تقلقان زيادة عن اللّزوم

30
00:02:53,560 --> 00:02:58,950
أقصد بأنّ لديك فتى في المنزل
في مثل سنّكِ

31
00:02:58,950 --> 00:03:00,040
...لذا

32
00:03:00,040 --> 00:03:02,220
...في حال حدث أيّ شيء

33
00:03:02,220 --> 00:03:03,780
!عـ-عمّاذا تتحدّث؟

34
00:03:03,780 --> 00:03:05,430
—نحن عائلة، لذا لا يمكن لنا أن

35
00:03:04,630 --> 00:03:07,290
ويحكِ

36
00:03:07,290 --> 00:03:09,920
أتعتقدين حقّاً أنّ أيّاً منّا سيردُّ على هذا؟

37
00:03:12,080 --> 00:03:16,320
لستُ بائساً لدرجة أهتمّ بأمثال كينتارو

38
00:03:16,320 --> 00:03:19,520
لديّ الحقّ في الاختيار أيضاً

39
00:03:19,520 --> 00:03:21,690
!أنت تُهينني بصورة عفويّة

40
00:03:21,690 --> 00:03:24,170
كنتُ أنقل أفكاري الصّادقة فحسب

41
00:03:24,170 --> 00:03:27,620
،إيتو-تشان، بعد عامين أو ثلاثة
...ستصبحين أيضاً

42
00:03:27,620 --> 00:03:28,600
!أُمّي؟

43
00:03:29,140 --> 00:03:31,510
...لن تكون هناك أي فُرصة لذلك

44
00:03:32,740 --> 00:03:34,610
هلّا قرأتِ لأجلي؟

45
00:03:32,980 --> 00:03:34,610
"لا تجعل الأمور غريبة الأطوار"

46
00:03:35,350 --> 00:03:38,990
هذه هي القواعد الّتي تجمعنا معاً

47
00:03:46,050 --> 00:03:47,500
كينتارو

48
00:03:48,780 --> 00:03:50,540
استعدّي للعودة إلى المنزل

49
00:03:50,890 --> 00:03:53,130
هناك تنزيلات على البيض اليوم

50
00:03:53,130 --> 00:03:54,150
حسناً، حسناً

51
00:03:54,150 --> 00:03:55,290
سأذهب الآن

52
00:03:57,800 --> 00:04:00,380
!آسف لأنّني تأخّرت

53
00:04:01,200 --> 00:04:02,530
!روي-كن

54
00:04:02,530 --> 00:04:05,250
،صندوق واحد من البيض لكلّ زبون
لذا طلبتُ منه المجيء

55
00:04:05,250 --> 00:04:07,140
!حصلتُ عليكما لنفسي

56
00:04:07,600 --> 00:04:12,040
إيتو-تشان، حبّذا لو تُعدّين لنا
!ملفوفاً اليوم

57
00:04:12,040 --> 00:04:14,050
!بكلّ تأكيد. سأُعدّه

58
00:04:14,380 --> 00:04:17,020
روي-كن ظريف جدّاً ومُتّزن

59
00:04:17,020 --> 00:04:19,380
لا ينبغي أن تُدلّليه هكذا

60
00:04:22,110 --> 00:04:24,070
!حسناً، هيّا بنا

61
00:04:28,010 --> 00:04:30,500
المشي هكذا يُوحي وكأنّكما والداي

62
00:04:30,870 --> 00:04:32,180
!لا كأخوة؟

63
00:04:34,120 --> 00:04:35,210
!مرحى

64
00:04:35,210 --> 00:04:37,150
!ادفعيني! ادفعيني

65
00:04:37,150 --> 00:04:39,040
!هذا مُخصّص للأطفال

66
00:04:39,770 --> 00:04:42,550
...لكن الآن بالتّفكير في الأمر

67
00:04:42,550 --> 00:04:43,630
!لا، لا

68
00:04:43,630 --> 00:04:44,800
!عليك شراؤها

69
00:04:45,120 --> 00:04:46,490
!يجب عليكِ ذلك

70
00:04:45,430 --> 00:04:47,670
روي-كن مُفعم بالطّاقة حقّاً اليوم

71
00:04:46,490 --> 00:04:49,810
!يجب أن تشتريها! أرزوكِ

72
00:04:48,290 --> 00:04:49,810
...أو بالأحرى

73
00:04:51,850 --> 00:04:52,810
أنا مُرهَق

74
00:04:53,270 --> 00:04:54,800
إيتو-تشان، احمليني

75
00:04:55,360 --> 00:04:56,440
إنّه صبيانيّ؟

76
00:04:58,440 --> 00:05:01,820
!ليس هكذا! برفق! برفق

77
00:05:03,940 --> 00:05:04,820
آسف بشأن ذلك

78
00:05:05,510 --> 00:05:08,320
أحياناً، يتصرّف بهذه الطّريقة

79
00:05:08,320 --> 00:05:10,600
،أعتقد الآن بعد رحيل والدينا

80
00:05:10,600 --> 00:05:13,090
يفتقدهما أكثر ممّا يُدرك حتّى

81
00:05:15,460 --> 00:05:18,840
ماذا يُدعى هذا؟ تقدُّم عمري؟

82
00:05:18,840 --> 00:05:20,340
"تقصد "تقهقر عمري

83
00:05:20,720 --> 00:05:25,090
روي هو الوحيد الّذي لم يعرف
منزلاً فيه والدان

84
00:05:26,530 --> 00:05:30,500
تُوفّيت أمُّنا بعد ولادته مُباشرة

85
00:05:31,390 --> 00:05:33,650
،حصلَ على عائلة كاملة أخيراً ثانية

86
00:05:33,650 --> 00:05:36,060
لكن بعد مُغادرتهما الآن، إنّه يفتقدهما

87
00:05:36,420 --> 00:05:37,140
أنا آسفة

88
00:05:37,140 --> 00:05:39,140
لم ألحظ حتّى

89
00:05:39,860 --> 00:05:41,990
إنّه مُبتهج دوماً وضحوك

90
00:05:44,150 --> 00:05:46,470
أتساءل كم مضى على كبته لهذه المشاعر

91
00:05:48,010 --> 00:05:51,870
،أعتقد بأنّه كان معتاداً على الوحدة

92
00:05:52,350 --> 00:05:56,000
لدرجة أنّه لم يلحظ حتّى بأنّه
كان يكبت وحدته

93
00:06:03,790 --> 00:06:06,260
كُفّي عن البُكاء

94
00:06:06,260 --> 00:06:09,140
يبدو الآن وكأنّني أنا سبب بكائكِ

95
00:06:09,770 --> 00:06:11,120
!دعني فحسب

96
00:06:11,120 --> 00:06:14,770
!أنا أبكي لأجل أخي الظّريف

97
00:06:17,670 --> 00:06:19,190
إنّه بخير

98
00:06:19,190 --> 00:06:22,920
لديه شخص بجانبه يجهش بالبُكاء لأجله

99
00:06:23,720 --> 00:06:24,690
أحمق

100
00:06:25,890 --> 00:06:29,270
!سأبكي كثيراً لأجلك أيضاً

101
00:06:29,270 --> 00:06:31,370
لا، أنا بخير

102
00:06:32,270 --> 00:06:35,040
أريد أن أقدّرهم أكثر فأكثر حتّى

103
00:06:35,500 --> 00:06:38,540
أريد أن أُدلّلهم قدر ما يشاؤون

104
00:06:38,540 --> 00:06:40,400
!مُذهل

105
00:06:40,400 --> 00:06:42,200
كان إلهامنا اليوم هو وجبات الأطفال تلك

106
00:06:42,200 --> 00:06:44,150
!أحبّكِ حُبّاً جمّاً يا إيتو-تشان

107
00:06:44,710 --> 00:06:46,540
—لنأكل

108
00:06:46,540 --> 00:06:48,760
بالمُناسبة، هل كتبت وظيفتك المدرسيّة؟

109
00:06:50,510 --> 00:06:54,260
ألم أخبرك بأن تكتبها قبل العشاء؟

110
00:06:54,260 --> 00:06:56,970
ما رأيك أن نفعلها معاً حالما ننتهي هنا؟

111
00:06:57,200 --> 00:06:58,550
أنا واثقة بأنّه من الشّاقّ أن يفعلها بمُفرده

112
00:06:58,550 --> 00:06:58,880
أنتِ

113
00:06:58,880 --> 00:07:00,480
لذا من الصّعب أن يجد الحافز

114
00:07:00,480 --> 00:07:01,550
!أنتِ

115
00:07:01,960 --> 00:07:03,860
!شكراً لكِ يا إيتو-تشان

116
00:07:06,310 --> 00:07:10,500
لذا خطرتْ على ذهني فكرة ممتازة للتو

117
00:07:11,260 --> 00:07:15,450
ماذا لو تزوّجتِ في المُستقبل
غين-كن أو واحداً منّا؟

118
00:07:16,340 --> 00:07:17,330
ماذا؟

119
00:07:17,330 --> 00:07:18,750
لا تُعيريه أي اهتمام

120
00:07:18,750 --> 00:07:20,310
...إذاً يمكننا دوماً

121
00:07:20,310 --> 00:07:22,950
روي-كن، روي-كن. ماذا عن وظيفتك الدّراسيّة؟

122
00:07:22,950 --> 00:07:24,330
مقالة؟

123
00:07:24,760 --> 00:07:26,300
"أحلام مُستقبليّة"

124
00:07:27,110 --> 00:07:29,550
ماذا تريد أن تكون في المُستقبل؟

125
00:07:29,550 --> 00:07:30,880
...في الواقع

126
00:07:30,880 --> 00:07:32,410
!أريد أن أكون رائد فضاء

127
00:07:32,410 --> 00:07:34,480
!أو ساحراً شهيراً عالميّاً

128
00:07:34,480 --> 00:07:36,470
!أريد أن أكون خبّازاً أيضاً

129
00:07:36,780 --> 00:07:38,700
!هذا كثير

130
00:07:38,700 --> 00:07:39,580
لكن أتعلمين؟

131
00:07:40,700 --> 00:07:42,950
وجدتُ حُلمي الأكبر

132
00:07:44,070 --> 00:07:45,630
ما هو؟

133
00:07:46,350 --> 00:07:48,980
!بالمُناسبة يا إيتو-تشان

134
00:07:50,430 --> 00:07:53,620
سأستخدم هذا لأجعلكِ تبدين كعروس

135
00:07:53,620 --> 00:07:55,610
...روي-كن، المعذرة

136
00:07:56,970 --> 00:07:58,180
!فعلتُها

137
00:07:58,180 --> 00:07:59,510
!اكتب وظيفتك

138
00:08:00,450 --> 00:08:03,350
تبدين كعروس حقيقيّة

139
00:08:04,160 --> 00:08:08,550
هل تقسمين بأن تتزوّجي
شخصاً في هذا المنزل؟

140
00:08:08,550 --> 00:08:10,760
...لـ-لا أستطيع الإجابة عن هذا السّؤال

141
00:08:11,280 --> 00:08:12,010
تبّاً

142
00:08:13,050 --> 00:08:14,640
لنُنهِ هذا الأمر

143
00:08:16,110 --> 00:08:19,800
"حسناً. من الآن فصاعداً، أنتِ وأنا "مُتزوّجان

144
00:08:20,270 --> 00:08:21,950
!ماذا تقول؟

145
00:08:23,620 --> 00:08:26,150
!تهانينا

146
00:08:26,150 --> 00:08:27,880
شكراً لك

147
00:08:27,880 --> 00:08:31,990
!حسناً! أرغب في البدء بحفلة الزّفاف الآن

148
00:08:31,990 --> 00:08:33,650
لا داعي

149
00:08:34,530 --> 00:08:37,410
نحن عريسان، لذا اللّيلة هي
ليلتنا الأولى معاً

150
00:08:37,940 --> 00:08:40,330
ولا نريد أن يُقاطعنا أحد

151
00:08:40,330 --> 00:08:42,000
!حـ-حسناً

152
00:08:42,000 --> 00:08:45,170
إ-إذاً لِمَ لا أذهب وأكتب وظيفتي
المدرسيّة في غرفة أُخرى؟

153
00:08:45,170 --> 00:08:46,990
!افعل ذلك

154
00:08:46,990 --> 00:08:49,290
وأيضاً، واستحمّ وفرّش أسنانك
!واخلد إلى النّوم

155
00:08:49,290 --> 00:08:50,790
عُدت

156
00:08:52,320 --> 00:08:54,110
المعذرة... ما الّذي يجري؟

157
00:08:54,420 --> 00:08:55,430
لا شيء مُهمّ

158
00:08:56,450 --> 00:09:00,180
كنتُ أعلّمها فقط كيفيّة التّعامل مع روي

159
00:09:00,180 --> 00:09:04,630
!مَن يعتقدني أُخوتي الصّغار بالضّبط؟

160
00:09:06,690 --> 00:09:10,190
96... 97... 98

161
00:09:10,900 --> 00:09:12,650
يبدو أنّه انتهى بشكل ما

162
00:09:13,930 --> 00:09:15,830
خطّه سيّئ للغاية

163
00:09:15,830 --> 00:09:18,140
رُبّما يجدر بك أن تمدحه لأنّه
أنجز ذلك على الأقلّ؟

164
00:09:19,740 --> 00:09:22,090
إحساس غين بالمسافات غريب حقّاً

165
00:09:22,090 --> 00:09:23,770
ماذا تفعلين؟

166
00:09:23,770 --> 00:09:24,820
!روي-كن

167
00:09:24,820 --> 00:09:27,500
هل تذكّرتَ العدّ إلى 100
قبل الخروج من الحمّام؟

168
00:09:27,500 --> 00:09:30,630
حسناً، هل قضيتُما ليلةً أولى سعيدة معاً؟

169
00:09:32,630 --> 00:09:35,350
لـ-لم نفعل ذلك

170
00:09:35,350 --> 00:09:37,800
وجهكِ أحمر تماماً

171
00:09:38,030 --> 00:09:39,420
حسناً إذاً

172
00:09:39,420 --> 00:09:41,720
سأنضمّ لكما للّيلة

173
00:09:45,010 --> 00:09:48,480
كنتُ أرغب في مُحاولة النّوم
هكذا ولو لمرّة

174
00:09:49,770 --> 00:09:52,710
لا أرى حدوداً لما يفعله بسبب إفسادكِ له

175
00:09:52,710 --> 00:09:54,860
كان بوسعك أن تقول بأنّك
لا تريد فعل ذلك فحسب

176
00:09:54,860 --> 00:09:57,900
غين-كن، أريدك اليوم أن تقرأ لي

177
00:10:01,040 --> 00:10:04,240
حالما ينام، عودي إلى سريركِ

178
00:10:04,600 --> 00:10:05,660
حسناً

179
00:10:05,660 --> 00:10:07,350
هذا هو الوقت الوحيد

180
00:10:07,660 --> 00:10:11,540
ألعب لعبةَ العائلة فقط بسبب بُكائك

181
00:10:12,580 --> 00:10:13,960
ها هو ذا من جديد

182
00:10:14,200 --> 00:10:19,070
،إنّه كتلة مُتنقّلة من الحُبّ تجاه عائلته

183
00:10:20,400 --> 00:10:22,970
لذا لا يسعني أن أغضب منه
ولو أردتُ ذلك

184
00:10:32,360 --> 00:10:33,340
أنتِ

185
00:10:33,340 --> 00:10:35,170
ينبغي لك العودة إلى سريرك

186
00:10:46,170 --> 00:10:48,830
يبدو هذا كـ"عائلة" فعلاً

187
00:10:51,580 --> 00:10:56,050
!سأبكي كثيراً لأجلك أيضاً

188
00:10:59,430 --> 00:11:04,590
إذا جاء ذلك اليوم، سأعتمد
عليكِ يا أونيه-تشان

189
00:11:15,730 --> 00:11:17,840
!لا ينبغي أن ننام جميعاً معاً هكذا

190
00:11:25,900 --> 00:11:27,290
"أحلام مُستقبليّة"

191
00:11:27,740 --> 00:11:32,490
حُلمي الأكبر هو أن أعيش بسعادة"
مع عائلتي للأبد

192
00:11:32,890 --> 00:11:36,860
لهذا لا يُسمَح لإيتو-تشان
بالزّواج من شخص آخر

193
00:11:37,220 --> 00:11:40,630
أريدها أن تتزوّج غين-كن
"أو شخصاً آخر في عائلتنا

194
00:11:40,630 --> 00:11:42,580
أتزوّج؟

195
00:11:44,190 --> 00:11:47,770
لأنّني سعيد جدّاً لأنّ لديّ"
أُخت كُبرى الآن

196
00:11:47,770 --> 00:11:50,820
أريد أن أكون معها للأبد

197
00:11:50,820 --> 00:11:54,690
العيش مع إيتو-تشان وغين-كن
والآخرين جميعهم

198
00:11:54,690 --> 00:11:57,270
"هو كُلّ ما أحتاجه لأكون سعيداً

199
00:12:13,090 --> 00:12:15,350
!ماذا؟

200
00:12:17,730 --> 00:12:18,700
!أنتما

201
00:12:18,700 --> 00:12:21,340
يُسمَح بلعِب ساعة واحدة من ألعاب
!الفيديو في اليوم فقط

202
00:12:21,640 --> 00:12:24,660
هذه هي القاعدة الجديدة في عائلة ناريتا

203
00:12:24,660 --> 00:12:25,510
!أرجوكِ يا إيتو-تشان

204
00:12:25,780 --> 00:12:27,510
!لا تكوني هكذا

205
00:12:28,950 --> 00:12:31,180
!وجدتُ هذا في سلّة القمامة

206
00:12:31,180 --> 00:12:34,690
يجب أن تكون أكثر جدّية
!بشأن وظائفك المدرسيّة

207
00:12:34,690 --> 00:12:36,080
،والدانا ليسا هنا حاليّاً

208
00:12:36,080 --> 00:12:38,680
لذا يجب أن أكون صارمة بشأن هذا
بصِفتي أختك الكُبرى

209
00:12:39,000 --> 00:12:40,940
هذه المرّة أحرزَ علامة عشريّة

210
00:12:40,940 --> 00:12:42,520
!أحسنت صنعاً، أحسنت

211
00:12:42,520 --> 00:12:44,700
لم تُحرز أكثر من عشرة من قبل، صحيح؟

212
00:12:44,700 --> 00:12:45,810
ماذا؟

213
00:12:45,810 --> 00:12:47,660
!أتمدح شيئاً كهذا؟

214
00:12:47,660 --> 00:12:49,070
،في منزلنا، عندما نُوبّخ شخصاً

215
00:12:49,070 --> 00:12:52,540
نحاول أيضاً أن نجد شيئاً نمدحه عليه

216
00:12:53,020 --> 00:12:55,430
وهذه ليست عائلة عُلماء أيضاً

217
00:12:56,210 --> 00:12:58,790
يقول غين بأنّه هكذا كانت أُمُّنا
السّابقة تتصرّف

218
00:12:59,150 --> 00:13:01,500
لذا كان يُقلّد ذلك طوال هذا الوقت

219
00:13:01,960 --> 00:13:04,220
...أعترف، إنّه بارد الأعصاب

220
00:13:04,960 --> 00:13:09,050
،أعتقد بصِفتي أخت ناريتا الكُبرى
ما زال لديّ الكثير لأتعلّمه

221
00:13:11,670 --> 00:13:14,640
سأُعيد الآن أوراق الامتحان النّصفيّ

222
00:13:15,110 --> 00:13:17,960
كُلّ من حصل على علامة الرّسوب سوف
،يُعيد الامتحان في الأسبوع المُقبل

223
00:13:17,960 --> 00:13:19,520
لذا ابقوا مُتأهّبين

224
00:13:20,640 --> 00:13:21,720
ماذا؟

225
00:13:21,720 --> 00:13:23,400
!هذا أكثر من سيّئ

226
00:13:23,400 --> 00:13:25,770
هل ركّزتُ زيادة عن اللّزوم
!على الوظيفة المدرسيّة؟

227
00:13:25,770 --> 00:13:28,530
في مدرستي القديمة، كنتُ
...أتدبّر أمري دوماً

228
00:13:29,030 --> 00:13:29,770
بجدّية؟

229
00:13:29,770 --> 00:13:31,720
حصلتِ على أقلّ من المُعدّل
في كلّ مادّة؟

230
00:13:31,720 --> 00:13:33,500
اقلقي على نفسكِ بدلاً من أن تُوبّخيني

231
00:13:33,800 --> 00:13:36,950
"فظيع جدّاً رغم أنّكِ "الأخت الكُبرى

232
00:13:36,950 --> 00:13:39,100
!هذا مُحرج للغاية

233
00:13:39,670 --> 00:13:41,190
حسناً، لن أذكر ذلك فحسب

234
00:13:41,670 --> 00:13:42,340
مرحباً

235
00:13:43,420 --> 00:13:44,580
!ما-ماذا؟

236
00:13:44,910 --> 00:13:47,220
لا أحتاج عشاء اللّيلة

237
00:13:47,220 --> 00:13:48,220
دُعيتُ إلى العمل

238
00:13:48,220 --> 00:13:49,930
!عُلِم، عُلِم

239
00:13:49,930 --> 00:13:51,930
!لا بُدّ أنّ هذا شاقّ كالعادة

240
00:13:51,930 --> 00:13:54,680
!بالمُناسبة، لديّ واجب تنظيف اليوم

241
00:13:55,700 --> 00:13:58,190
!بالتّوفيق لك في عملك اليوم

242
00:14:05,380 --> 00:14:07,760
تبيّن بأنّني غبيّة

243
00:14:08,950 --> 00:14:10,310
وإن يكن؟

244
00:14:10,310 --> 00:14:12,320
هناك في الحياة أشياء غير الدّراسة

245
00:14:12,320 --> 00:14:14,970
!أجل، لكن يبدو هذا سيّئاً للغاية

246
00:14:15,390 --> 00:14:17,810
هل تهتمّين بالمظاهر فحسب؟

247
00:14:17,810 --> 00:14:19,460
!بالطّبع

248
00:14:19,850 --> 00:14:21,460
...أقصد، أنا

249
00:14:22,160 --> 00:14:23,960
الأخت الكُبرى في منزلنا؟

250
00:14:24,830 --> 00:14:26,970
!ر-راكو-كن؟

251
00:14:29,100 --> 00:14:31,370
أنتِ قلقة من أن يسخر غين منكِ؟

252
00:14:31,370 --> 00:14:32,470
...بالتّأكيد، هذا أحد الأسباب

253
00:14:33,300 --> 00:14:36,350
لكن هذا سيُثير قلقَ أمِّي أيضاً

254
00:14:36,350 --> 00:14:39,460
ستعتقد بأنّ السّبب هو لأنّها
نقلَتْنا إلى هنا

255
00:14:39,460 --> 00:14:42,860
رغم أنّ عدم مُواكبتي لهذه المدرسة
الجديدة هو غلطتي أنا

256
00:14:42,860 --> 00:14:45,140
ولا أعلم حتّى كيف سيردُّ أبي

257
00:14:47,120 --> 00:14:48,030
أفهمكِ

258
00:14:48,030 --> 00:14:50,000
تريدينني أن ألتزم الصّمت
حيال هذا إذاً

259
00:14:50,610 --> 00:14:52,180
!شكراً لك

260
00:14:52,180 --> 00:14:53,780
...أنت تتفهّم الأمر

261
00:14:52,910 --> 00:14:54,160
...لكن بالمُقابل

262
00:14:55,010 --> 00:14:57,450
هل أنتِ مُتفرِّغة بعد دوام المدرسة اليوم؟

263
00:15:00,670 --> 00:15:03,200
...ما هذا؟ ناعم جدّاً

264
00:15:04,130 --> 00:15:05,090
أجل

265
00:15:05,340 --> 00:15:06,300
ماذا؟

266
00:15:06,300 --> 00:15:07,420
هكذا إذاً

267
00:15:08,160 --> 00:15:10,910
أوّلاً، وضعتِ الإجابات هنا في العمود الخطأ

268
00:15:11,540 --> 00:15:12,950
هل أنتِ سيّئة في الحفظ؟

269
00:15:13,840 --> 00:15:17,130
عند دراسة التّاريخ، عليكِ الرّبط
بين النّاس والفترات الزّمنيّة

270
00:15:17,130 --> 00:15:19,970
بالنّسبة للإنجليزيّة، فإنّ قول الكلمات
بصوت عالٍ يصقل لفظكِ

271
00:15:19,970 --> 00:15:21,060
لذا ستتعلّمين بشكل أفضل

272
00:15:21,400 --> 00:15:23,360
هل تُواجهين صعوبة مع هذا الدّرس؟

273
00:15:23,360 --> 00:15:24,340
،إن كنتِ كذلك

274
00:15:24,340 --> 00:15:27,610
احصلي على دليل دراسة يلائمكِ
وادرسي على وتيرتكِ الخاصّة

275
00:15:27,920 --> 00:15:31,270
راكو-كن، هل يوجد مُدرّس عالميّ
!من نوع ما بداخلك؟

276
00:15:31,270 --> 00:15:32,610
إطلاقاً

277
00:15:32,840 --> 00:15:35,430
أنا أُكرّر فقط ما وردَ في الكُتُب

278
00:15:35,980 --> 00:15:37,550
،إذا تتبّعتِ النقاطَ المفتاحيّة

279
00:15:37,550 --> 00:15:39,090
فيمكنكِ الإجابة عن كافّة الأسئلة تقريباً

280
00:15:39,090 --> 00:15:40,870
!لا يقول مثل هذا الكلام إلّا العباقرة

281
00:15:41,310 --> 00:15:44,280
لكن لماذا تفعل كُلّ هذا لأجلي؟

282
00:15:44,980 --> 00:15:47,460
أنتِ تُعينيننا طوال الوقت

283
00:15:47,920 --> 00:15:49,890
،فضلاً عن ذلك، إذا اكتأبتِ

284
00:15:49,890 --> 00:15:51,880
فسيُشعرنا هذا بالملل أيضاً

285
00:15:53,890 --> 00:15:58,630
!ماذا فعلتُ لأستحقّ أخاً رائعاً كهذا؟

286
00:15:59,510 --> 00:16:00,770
ماذا حدث لك؟

287
00:16:02,120 --> 00:16:03,280
ما مُشكلة هذا الوجه؟

288
00:16:03,280 --> 00:16:04,230
هذا مُخيف

289
00:16:04,230 --> 00:16:06,260
حقّاً؟ آسفة

290
00:16:06,670 --> 00:16:09,310
بالمُناسبة، تريد بعض الشّاي؟

291
00:16:09,310 --> 00:16:10,390
لا

292
00:16:10,390 --> 00:16:11,360
حسناً

293
00:16:11,610 --> 00:16:13,550
سأتناول بعضاً مع راكو-كن إذاً

294
00:16:13,550 --> 00:16:14,820
ماذا؟

295
00:16:14,820 --> 00:16:17,310
لماذا أنتِ وراكو؟

296
00:16:19,160 --> 00:16:19,880
أنت

297
00:16:21,310 --> 00:16:22,120
قلتُ أنتِ

298
00:16:22,590 --> 00:16:23,790
!كُفّ عن إزعاجي

299
00:16:23,790 --> 00:16:25,630
لِمَ تُبالي إلى هذا الحدّ؟

300
00:16:25,630 --> 00:16:28,170
لا أستطيع أن أُخبره بأنّني أدرس
من أجل امتحانات التّعويض

301
00:16:29,300 --> 00:16:30,230
عفواً؟

302
00:16:30,230 --> 00:16:33,470
سلوككِ المُريب يُزعجني فحسب

303
00:16:33,930 --> 00:16:35,200
ماذا تُخبئين؟

304
00:16:36,060 --> 00:16:37,470
إنّه الأخ الأكبر بلا شكّ

305
00:16:37,470 --> 00:16:40,180
...كنتُ عفوية جدّاً لكن مع ذلك لاحظَني

306
00:16:40,600 --> 00:16:42,980
!لكن لا أستطيع أن أدعه يكتشف الأمر

307
00:16:44,170 --> 00:16:46,650
شكراً على اهتمامك

308
00:16:46,650 --> 00:16:48,860
،استجدّت معي بعض الأمور فحسب

309
00:16:48,860 --> 00:16:52,110
لكن راكو-كن يُساعدني، لذا
!كُلّ شيء على ما يُرام

310
00:16:53,150 --> 00:16:55,420
هل نُتابع في غرفتك؟

311
00:16:55,420 --> 00:16:57,450
هذه فكرة سديدة

312
00:17:03,390 --> 00:17:05,140
لماذا مع راكو؟

313
00:17:05,140 --> 00:17:07,880
ما الّذي يمكنها مُناقشته معه
لا يمكنها مُناقشته معي؟

314
00:17:09,790 --> 00:17:10,930
هذا غريب

315
00:17:11,250 --> 00:17:13,140
،كنتُ ألعب لساعتين

316
00:17:13,140 --> 00:17:15,300
لكن لم تقُل إيتو-تشان أيّ كلمة

317
00:17:15,300 --> 00:17:18,210
ربّما لم تعُد تكترث للأشخاص
الّذين لا يصغون أبداً

318
00:17:18,210 --> 00:17:19,550
!سأتوقّف إذاً

319
00:17:21,410 --> 00:17:22,560
!إن كنت ستتوقّف، فأعطِني إذاً

320
00:17:25,070 --> 00:17:26,940
آسفة لأنّني أتصنّع

321
00:17:28,690 --> 00:17:30,820
،لكن حتّى لو كنتُ أتظاهر

322
00:17:30,800 --> 00:17:33,070
لا أتحمّل فكرة الخسارة أمامك

323
00:17:34,820 --> 00:17:37,070
لأنّك ثابت ورزين فحسب

324
00:17:51,180 --> 00:17:52,970
،ارتكبتِ بعض الأخطاء الطّائشة

325
00:17:52,970 --> 00:17:55,170
لكن ينبغي أن تكوني جاهزة
لامتحانات التّعويض غداً

326
00:17:56,140 --> 00:17:59,180
أعلم بأنّكِ تستطيعين فعلها
إن ركّزتِ، لذا عليكِ بهم

327
00:17:59,180 --> 00:18:00,080
!حسناً

328
00:18:01,570 --> 00:18:03,220
!غين-كن

329
00:18:03,220 --> 00:18:05,130
هل سهرتَ على ألعاب الفيديو
طوال اللّيل ثانية؟

330
00:18:05,130 --> 00:18:06,510
!تعلم بأنّ هذا سيّئ

331
00:18:06,510 --> 00:18:08,330
!وتنام هنا كالقذرين

332
00:18:08,770 --> 00:18:12,230
!أسرع واستعدّ للمدرسة

333
00:18:12,710 --> 00:18:16,450
...روي-كن وغين قد تبادلا

334
00:18:17,780 --> 00:18:20,930
أعتقد بأنّ عدم مُبالاتكِ فجأة لغين

335
00:18:20,930 --> 00:18:23,330
أدخلَه في هذه النّوبة

336
00:18:24,060 --> 00:18:25,120
ماذا تقصد؟

337
00:18:29,990 --> 00:18:32,150
هذا سيّئ حقّاً

338
00:18:40,570 --> 00:18:41,390
!حسناً

339
00:18:46,010 --> 00:18:48,230
ينبغي لهذا أن ينتهي اليوم

340
00:18:49,690 --> 00:18:51,730
،حالما تنتهي هذه المعركة

341
00:18:51,730 --> 00:18:54,090
أعتقد بأنّني سأتوقّف عن كوني
!الأخت الفاشلة

342
00:19:00,500 --> 00:19:01,490
ما هذا؟

343
00:19:01,490 --> 00:19:03,490
هل تنتظر أختنا الكبرى؟

344
00:19:03,720 --> 00:19:05,140
!ولِمَ أنتظر؟

345
00:19:06,290 --> 00:19:09,790
أحبّ أخي الكبير الظّريف الّذي
لا يستطيع الاعتراف بذلك فحسب

346
00:19:09,790 --> 00:19:12,220
أتستمتع بالسّخرية منّي؟

347
00:19:12,220 --> 00:19:14,330
ما الّذي كان يجري مُؤخّراً؟

348
00:19:14,330 --> 00:19:15,760
كنتَ تتسلّل خلسة

349
00:19:15,760 --> 00:19:16,800
هذا مُخيف

350
00:19:16,800 --> 00:19:18,840
أنت تجرحني

351
00:19:18,840 --> 00:19:21,300
أردتُ مُساعدة أختنا الكُبرى فحسب

352
00:19:22,240 --> 00:19:23,220
مع الأسف

353
00:19:23,220 --> 00:19:27,310
كنتُ أتطلّع لرؤيتك تشتعل غيرة
،لفترة أطول

354
00:19:27,710 --> 00:19:29,720
لكن أعتقد سأكتفي بهذا القدر

355
00:19:30,030 --> 00:19:32,480
لو استمررتُ أكثر، قد تبدأ بكرهي

356
00:19:33,470 --> 00:19:34,200
أنت

357
00:19:35,400 --> 00:19:38,960
،لا أعلم ما الّذي أصاب رأسك

358
00:19:38,960 --> 00:19:40,150
لكن على أيّ حال، شكراً

359
00:19:41,140 --> 00:19:44,300
كان غالباً شيئاً ما كنتُ لأتمكّن
،من تقديم المُساعدة فيه

360
00:19:44,670 --> 00:19:46,660
لذا يسرّني أنّك وقفتَ معها

361
00:19:47,000 --> 00:19:49,620
رأيت؟ هذا ما أتحدّث عنه

362
00:19:49,620 --> 00:19:50,240
ماذا؟

363
00:19:52,370 --> 00:19:53,920
ليس عليك أن تفهم ذلك

364
00:19:54,490 --> 00:19:58,990
بجدّية، ما الّذي يتطلّبه لإيقاف عين
عن التصرُّف كأخ كبير بإفراط؟

365
00:20:02,180 --> 00:20:04,070
،وبخصوصها

366
00:20:04,070 --> 00:20:06,310
لا ينبغي أن تتكلّم عنها بكلام قاسٍ

367
00:20:06,310 --> 00:20:08,810
قد لا يبدو كذلك، لكنّها تبذل قصارى جهدها

368
00:20:09,100 --> 00:20:11,310
قُم بعملك المعتاد وامدحها حتّى النّهاية

369
00:20:15,810 --> 00:20:17,790
لستُ بحاجة لتخبرني بذلك

370
00:20:21,860 --> 00:20:23,610
غين-كن فتى قويّ

371
00:20:24,270 --> 00:20:27,370
لم أرَه يبكي ولا مرّة أثناء الجنازة

372
00:20:28,120 --> 00:20:31,540
لكن أنا واثقة بأنّ أمّه تستطيع
أن ترقد بسلام

373
00:20:32,030 --> 00:20:35,600
لأنّني متأكّدة بأنّه سيحمي عائلته

374
00:20:39,800 --> 00:20:42,870
،أنا مُمتنّ لحصولي على أخ أكبر مُؤتمن

375
00:20:43,400 --> 00:20:46,260
لكن أحياناً سيكون من اللّطيف
أن تتصرّف كما لو أنّك في سنّنا

376
00:20:46,710 --> 00:20:49,060
وإلّا كنتُ لأقلق بصِفتي أخ أصغر

377
00:20:51,330 --> 00:20:54,980
حسناً، كيف ينبغي أن أستفزّه تالياً؟

378
00:20:57,710 --> 00:21:00,780
يجدر بي حقّاً أن أعترف لغين

379
00:21:01,370 --> 00:21:05,010
...لا أحبّ أن أكذب على أحد

380
00:21:06,660 --> 00:21:08,660
يواجهني دون تحفُّظات

381
00:21:09,740 --> 00:21:13,400
غين؟ ماذا تفعل هنا؟

382
00:21:13,400 --> 00:21:14,560
كيف كانت امتحانات التّعويض خاصّتكِ؟

383
00:21:14,560 --> 00:21:17,160
—على ما يُرام، بفضل راكو-كن

384
00:21:18,270 --> 00:21:21,750
أنا آسفة. سبّبتُ لك قلقاً لا ضرورة له

385
00:21:21,750 --> 00:21:24,880
تمكّنتِ من حلّ المُشكلة دون الاعتماد عليّ

386
00:21:25,110 --> 00:21:25,930
تستحقّين الإطراء

387
00:21:25,930 --> 00:21:27,080
شكراً

388
00:21:27,080 --> 00:21:29,370
ما هذا الإطراء الّذي يتقطّر بالسّخرية؟

389
00:21:32,420 --> 00:21:34,640
كنتَ تعلم بكلّ شيء إذاً؟

390
00:21:34,640 --> 00:21:37,200
أنتِ لا تُجيدين الكذب

391
00:21:37,200 --> 00:21:38,840
ممّا جعل الأمر أكثر طرافة من أيّ شيء

392
00:21:39,480 --> 00:21:40,700
!أيّها الكاذب

393
00:21:40,700 --> 00:21:43,480
!كنتَ تعبس لأنّه لم يكن لديّ وقت لك

394
00:21:44,180 --> 00:21:45,500
لا أدري ما تقصدينه

395
00:21:45,920 --> 00:21:47,660
كالعادة، يحاول إخفاء ذلك

396
00:21:48,330 --> 00:21:50,420
رغم أنّ هذا مكشوف بشكل سافر

397
00:21:51,180 --> 00:21:55,380
إذاً هل كنتَ مُضجَراً إلى هذا
الحدّ من دوني؟

398
00:21:57,130 --> 00:21:58,670
إنّه سيّئ في ذلك فحسب

399
00:21:59,100 --> 00:22:01,320
أعني في إظهار ذاته الحقيقيّة

400
00:22:03,600 --> 00:22:05,170
قليلاً فقط

401
00:22:08,470 --> 00:22:09,960
حقّاً؟

402
00:22:09,960 --> 00:22:12,020
!أحسنت صنعاً في الاعتراف بذلك يا غين

403
00:22:12,020 --> 00:22:13,340
!ممتاز، ممتاز

404
00:22:13,340 --> 00:22:14,370
...إنّ غين

405
00:22:14,370 --> 00:22:16,150
لا تغترّي جدّاً بنفسكِ

406
00:22:16,660 --> 00:22:17,630
ظريف جدّاً...