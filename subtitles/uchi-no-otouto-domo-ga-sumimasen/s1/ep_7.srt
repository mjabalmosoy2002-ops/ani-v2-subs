1
00:00:02,670 --> 00:00:04,360
!ها نحن أولاء

2
00:00:08,190 --> 00:00:10,190
فعلتُها

3
00:00:10,190 --> 00:00:13,330
هل تعلم بأنّ الإنسان يكسر البطّيخ
كي يتمكّن من أكلها؟

4
00:00:13,550 --> 00:00:14,980
آسفة يا ميغو-تشان

5
00:00:14,980 --> 00:00:16,870
بعد أن تكبّدتِ عناء تحصيل واحدة

6
00:00:16,870 --> 00:00:18,460
لا عليكِ

7
00:00:18,460 --> 00:00:20,600
لدينا العديد من البطّيخ البارد

8
00:00:21,070 --> 00:00:24,050
عدتُ حالياً إلى دياري

9
00:00:24,650 --> 00:00:26,100
،بما أنّها استراحة الصّيف

10
00:00:26,100 --> 00:00:29,180
أحضرني أخوتي إلى هنا كإيحاء عائلي

11
00:00:30,120 --> 00:00:32,310
!أنا مسرورة جدّاً لأنّنا أتينا إلى هنا

12
00:00:32,310 --> 00:00:35,810
لكن في هذا الصّباح ظننتُ حقّاً
بأنّه تمّ اختطافي

13
00:00:36,750 --> 00:00:39,490
سوف نُغادر، لذا أمامكِ عشر
!ثوانٍ للاستعداد

14
00:00:39,490 --> 00:00:40,460
ماذا؟

15
00:00:41,300 --> 00:00:45,070
!اليوم، ستبقين معنا، ولا نريد اعتراضاً

16
00:00:45,820 --> 00:00:47,610
...هذه الإيحاءات العائليّة

17
00:00:47,610 --> 00:00:50,110
!إنّها الأفضل

18
00:02:22,970 --> 00:02:25,080
،رويتِ لنا بعض القصص عنهم

19
00:02:25,080 --> 00:02:27,320
لكنّهم مجموعة طريفة حقّاً

20
00:02:28,260 --> 00:02:29,250
أليس كذلك؟

21
00:02:29,660 --> 00:02:32,700
هالتُكِ قد تغيّرتْ قليلاً

22
00:02:32,700 --> 00:02:34,590
أعتقد لأنّكِ أخت كُبرى الآن

23
00:02:34,590 --> 00:02:36,310
لا أظنّ ذلك

24
00:02:36,310 --> 00:02:38,610
ما زالت هناك الكثير من الأشياء
الّتي لا أعرفها

25
00:02:38,610 --> 00:02:40,430
لم أنضج إطلاقاً

26
00:02:40,430 --> 00:02:41,600
!فهمت

27
00:02:41,600 --> 00:02:43,770
هل لأنّكِ واقعة في الحُبّ؟

28
00:02:46,470 --> 00:02:47,790
لا؟

29
00:02:47,790 --> 00:02:50,440
لكن ليس وكأنّ هذا مُستحيل؟

30
00:02:50,440 --> 00:02:53,710
أنتِ تعيشين مع فتيان تحت سقف واحد

31
00:02:53,710 --> 00:02:56,200
وجميعهم لطيفون ووسيمون

32
00:02:56,420 --> 00:03:01,330
على العكس، سيكون من الأغرب
!إن لم تُغرَمي بهم

33
00:03:01,330 --> 00:03:03,330
،ولستُم مُرتبطين بالدّم

34
00:03:03,330 --> 00:03:06,070
لذا أعتقد هذا مشروع تماماً

35
00:03:06,070 --> 00:03:09,340
نسيتُ بأنّ ميغو-تشان كانت هكذا دوماً

36
00:03:10,100 --> 00:03:12,030
هل قرأتِ عدد هذا الشّهر؟

37
00:03:12,030 --> 00:03:14,720
!لا يتوقّف قلبي عن النّبض

38
00:03:16,090 --> 00:03:19,530
أعتقد ترعرعت في بيئة رومانسيّة

39
00:03:19,530 --> 00:03:23,930
،إذا كان عليّ اختيار أحدهم ليكون حبيبكِ

40
00:03:23,930 --> 00:03:25,850
فأعتقد أختار الأخ الأكبر

41
00:03:25,850 --> 00:03:28,770
!سأسأله عن مشاعره

42
00:03:28,770 --> 00:03:31,360
!لحظة، لحظة، لحظة، لحظة، توقّفي

43
00:03:31,660 --> 00:03:34,990
أوّلاً، لم نتحقّق من الشّعور الّذي يُراودني

44
00:03:35,290 --> 00:03:37,900
آسفة... معكِ حقّ

45
00:03:39,660 --> 00:03:44,070
،لكن الآن بعد أن أصابني الفضول
سأسأل على أيّ حال فحسب

46
00:03:44,070 --> 00:03:45,910
!ميغو-تشان

47
00:03:45,910 --> 00:03:47,250
!أنتِ

48
00:03:47,740 --> 00:03:51,080
لماذا لا تتكلّمين سوى عن الشّباب الآخرين؟

49
00:03:51,080 --> 00:03:52,280
ميغو الحمقاء

50
00:03:52,280 --> 00:03:54,270
!أوتا

51
00:03:56,950 --> 00:03:57,590
غين؟

52
00:04:06,200 --> 00:04:08,900
على أيّ حال، يجب عليّ إبعاده عن ميغو-تشان

53
00:04:11,950 --> 00:04:13,900
اقتربنا. أوشكنا على الوصول

54
00:04:15,480 --> 00:04:17,610
...حالما نتسلّق هذا

55
00:04:19,950 --> 00:04:21,380
ما الأمر؟

56
00:04:21,380 --> 00:04:22,950
استمرّي في الحركة فحسب

57
00:04:22,950 --> 00:04:26,200
!لـ-لـ-لا شيء

58
00:04:29,940 --> 00:04:30,710
أنتِ

59
00:04:32,270 --> 00:04:35,240
لن تقترحي أن نقفز من هنا، أليس كذلك؟

60
00:04:35,240 --> 00:04:36,810
بالطّبع لا

61
00:04:36,810 --> 00:04:38,670
،سوف نتزحلق زحلقةً فحسب

62
00:04:38,670 --> 00:04:39,970
من الجانب

63
00:04:39,970 --> 00:04:42,320
أجل، سأرفض ذلك أيضاً

64
00:04:47,070 --> 00:04:48,850
هذا المكان جميل

65
00:04:49,120 --> 00:04:50,600
هل يُعجبك؟

66
00:04:50,600 --> 00:04:51,980
أعتقد بأنّ روي يُحبّه أكثر

67
00:04:53,480 --> 00:04:56,080
ربّما يمكننا المجيء معكِ في كلّ عام

68
00:04:56,080 --> 00:04:57,110
!سيكون ذلك رائعاً

69
00:04:58,110 --> 00:05:01,490
آمل أن تأتي معنا أمّي وأبي
في العام القادم أيضاً

70
00:05:01,490 --> 00:05:05,400
حينئذ يمكننا صنع الكثير من الذّكريات
الجديدة معاً كعائلة

71
00:05:06,620 --> 00:05:08,490
تتمكّنين من رؤية أصدقاء طفولتك أيضاً

72
00:05:08,490 --> 00:05:09,880
وذلك كي لا تشتاقين لهم

73
00:05:11,590 --> 00:05:14,890
لماذا يبتسم ببراءة هكذا؟

74
00:05:14,890 --> 00:05:16,960
،فقط لأنّنا غيّرنا الخلفيّة

75
00:05:16,960 --> 00:05:19,060
تبدو فجأة كابتسامة خاصّة

76
00:05:19,630 --> 00:05:20,530
حسناً

77
00:05:20,890 --> 00:05:24,440
أنتِ لا تُفكِّرين في الانتقال
والعودة إلى هنا، صحيح؟

78
00:05:24,440 --> 00:05:26,090
بالطّبع لا

79
00:05:26,090 --> 00:05:28,660
على أيّ حال، لستُم هنا

80
00:05:29,230 --> 00:05:34,900
ظننتُ بأنّني سأكون بخير بمُفردي
معه، لكن أشعر بتوتُّر

81
00:05:35,320 --> 00:05:36,900
أتفهّمكِ

82
00:05:37,630 --> 00:05:41,920
بالإضافة إلى ذلك، أعتدتُ على
وجودكِ في المنزل

83
00:05:42,490 --> 00:05:46,120
رُبّما لأنّه فصل الصّيف فحسب

84
00:05:46,660 --> 00:05:48,860
،لكن إذا حاولتِ يوماً الانتقال والعودة

85
00:05:48,860 --> 00:05:51,210
فسوف أُعيدكِ بلا نقاش

86
00:05:51,210 --> 00:05:54,620
لا أجد أيّ سبب آخر

87
00:05:56,840 --> 00:05:58,680
لا تنسي ذلك أبداً

88
00:05:59,080 --> 00:06:01,870
يبدو أخي الصّغير برّاقاً

89
00:06:01,870 --> 00:06:03,290
...هذا لأنّ

90
00:06:03,930 --> 00:06:06,570
أنت من يجب عليه أن يحذر

91
00:06:06,880 --> 00:06:07,930
أنهِ هذا الأمر

92
00:06:08,240 --> 00:06:12,140
إذا أظهرتَ لأجلي هذا الإيحاء
...العائليّ المُتشدِّد

93
00:06:12,670 --> 00:06:14,050
أنهِ الأمر بسرعة

94
00:06:14,440 --> 00:06:15,950
،سأكون غاية في السّعادة

95
00:06:15,950 --> 00:06:19,440
سأكون حتّى ألطف مع الجميع
ابتداء من الغد

96
00:06:21,800 --> 00:06:23,200
...أنتِ

97
00:06:23,670 --> 00:06:25,540
وجهكِ أحمر بعض الشّيء

98
00:06:25,540 --> 00:06:26,260
هل أنتِ بخير؟

99
00:06:26,260 --> 00:06:27,700
!دعني وشأني فحسب

100
00:06:28,670 --> 00:06:31,240
أريد أن ينتهي هذا الصّيف ببسرعة

101
00:06:31,590 --> 00:06:34,020
...وإلّا أشعر بأنّ شيئاً قد يبدأ

102
00:06:41,950 --> 00:06:44,240
،وبينما كنتُ قلقة حول مُختلف الأمور

103
00:06:44,240 --> 00:06:47,090
سرعان ما انتهى الصّيف

104
00:06:47,640 --> 00:06:52,210
!حسناً! لنُجهِّز الأمور للمهرجان الثّقافيّ

105
00:06:52,600 --> 00:06:55,770
أوّلاً، هل يرغب أحدٌ في المُشاركة
في لجنة العمل؟

106
00:06:55,770 --> 00:06:56,420
!أنا

107
00:06:58,900 --> 00:07:00,880
لن تسنح هذه الفُرصة ثانية

108
00:07:01,230 --> 00:07:02,910
قالتها ميغو-تشان بنفسها

109
00:07:03,290 --> 00:07:05,150
لا تعلمين ما إن كنتِ واقعة في الحُبّ؟

110
00:07:05,150 --> 00:07:08,280
أقصد، ليس وكأنّني وقعتُ
في الحُبّ من قبل

111
00:07:08,280 --> 00:07:10,200
،غين مُهمٌّ فعلاً بالنّسبة لي

112
00:07:10,200 --> 00:07:12,540
لكنّه أخي الصّغير، لذا بالطّبع هو مُهمّ

113
00:07:12,540 --> 00:07:16,350
إذاً يجدر بكِ تجربة شخص آخر

114
00:07:16,350 --> 00:07:17,290
ماذا؟

115
00:07:17,290 --> 00:07:21,170
لم تعيري انتباهاً إلّا لِمَن
هو بداخل منزلكِ

116
00:07:21,170 --> 00:07:23,880
ربّما حان الوقت لتوسيع آفاقكِ؟

117
00:07:25,210 --> 00:07:29,250
التّواجد في لجنة العمل هو
ذروة توسيع الآفاق

118
00:07:29,960 --> 00:07:31,900
شكراً على التطوُّع

119
00:07:32,700 --> 00:07:34,850
...والآن، بخصوص برنامجنا

120
00:07:35,520 --> 00:07:39,220
الاستطلاع الّذي أجريناه من قبل
كلّفَنا بأداء مسرحيّة

121
00:07:47,140 --> 00:07:51,370
المعذرة، هذا هو مكان اجتماع
اللّجنة، صحيح؟

122
00:07:51,620 --> 00:07:52,620
أنتِ، أنتِ

123
00:07:53,460 --> 00:07:56,090
الحظّ لم يبتسم لكِ، صحيح؟

124
00:07:56,090 --> 00:07:57,760
عفواً؟

125
00:07:57,760 --> 00:08:01,400
التّواجد في لجنة العمل يعني
،أن تكوني ساعية بالنّسبة للجميع

126
00:08:01,400 --> 00:08:03,590
لذا لا أحد يريد فعل ذلك

127
00:08:03,860 --> 00:08:05,300
...ساعية

128
00:08:05,710 --> 00:08:08,620
اسمي أوداغاوا مافويو. سنة ثالثة

129
00:08:08,620 --> 00:08:09,890
وأنتِ؟

130
00:08:09,890 --> 00:08:11,400
!سررتُ بلقائك

131
00:08:11,400 --> 00:08:13,610
اسمي ناريتا إيتو، سنة ثانية
من الصّفّ ثلاثة

132
00:08:14,550 --> 00:08:15,840
إيتو-تشان، صحيح؟

133
00:08:15,840 --> 00:08:17,310
حسناً، حسناً

134
00:08:17,830 --> 00:08:19,780
تبدين جادّة مثلما توقّعت

135
00:08:20,920 --> 00:08:23,070
حسناً! تعالي واجلسي بجانبي

136
00:08:23,290 --> 00:08:25,110
إذاً، تفضّلي دفتري

137
00:08:25,320 --> 00:08:26,810
،حسناً، سوف آخذ قيلولة

138
00:08:26,810 --> 00:08:28,740
لذا أيقظيني عندما ينتهي الاجتماع

139
00:08:29,560 --> 00:08:31,480
سنبدأ الآن بالاجتماع

140
00:08:31,480 --> 00:08:33,950
!ما-ماذا حدث للتو؟

141
00:08:35,130 --> 00:08:36,650
،أنا مُرتبِكة قليلاً

142
00:08:36,650 --> 00:08:39,160
لكن يبدو هذا السّينباي حُرّاً
زيادة عن اللّزوم

143
00:08:44,780 --> 00:08:47,050
هذه هي مُلاحظات اليوم

144
00:08:49,910 --> 00:08:52,680
!عجباً، دوّنتِ مُلاحظات لأجلي فعلاً

145
00:08:53,020 --> 00:08:54,220
شكراً

146
00:08:54,220 --> 00:08:55,780
ثمّة أمر واحد فقط

147
00:08:56,820 --> 00:08:59,390
،أقول هذا كزميلة في اللّجنة

148
00:09:00,070 --> 00:09:02,000
،حتّى لو كنتَ مُرهَقاً

149
00:09:02,000 --> 00:09:04,020
أرى أنّه من الوقاحة أن تنام أمام الملأ

150
00:09:04,020 --> 00:09:06,480
حيث يجري الجميع نقاشاً

151
00:09:06,480 --> 00:09:09,400
معكِ حقّ، هذه غلطتي

152
00:09:09,400 --> 00:09:11,160
في المرّة المُقبلة، سأكون أكثر حذراً

153
00:09:11,160 --> 00:09:16,160
وأيضاً، تمّ تكليفنا بصنع
اللّافتة للبوّابة الرّئيسيّة

154
00:09:16,390 --> 00:09:19,790
،سنلتقي غداً لأجل ذلك
لذا الرّجاء الحضور

155
00:09:20,250 --> 00:09:21,670
عُلِم

156
00:09:22,260 --> 00:09:24,040
،إذا شعرتُ برغبة في ذلك
فسأكون حاضراً

157
00:09:24,040 --> 00:09:26,460
!يجب أن تحضر، من فضلك

158
00:09:26,460 --> 00:09:30,340
حسناً، ربّما سأفعل إذا أتيتِ
وأوصلتِني يا إيتو-تشان

159
00:09:33,400 --> 00:09:35,330
!يا للجرأة

160
00:09:38,250 --> 00:09:39,120
!غين؟

161
00:09:39,120 --> 00:09:40,430
!اصمتي

162
00:09:40,430 --> 00:09:42,790
!الأمير

163
00:09:42,790 --> 00:09:45,190
ربّما لا يروقه هذا الزيّ؟

164
00:09:45,190 --> 00:09:47,270
سأدعه يرتديه

165
00:09:47,270 --> 00:09:49,080
!هنا

166
00:09:49,080 --> 00:09:51,940
!أيّها الأمير

167
00:09:52,670 --> 00:09:53,870
مهلاً

168
00:09:54,300 --> 00:09:55,820
هذا غير مُريح إطلاقاً

169
00:09:55,820 --> 00:09:57,760
آسف

170
00:10:00,550 --> 00:10:02,590
أنت لا تريد أن تلعب دور الأمير حقّاً؟

171
00:10:03,170 --> 00:10:06,020
ظننتُ أنّه من المُذهل أن تلعب
دوراً رياديّاً

172
00:10:06,020 --> 00:10:07,640
ما المُذهل في ذلك؟

173
00:10:07,640 --> 00:10:10,190
،لم يكن لي رأي في ذلك
قرّروا أثناء نومي

174
00:10:10,970 --> 00:10:12,860
أهذا ما تفعلينه؟

175
00:10:12,860 --> 00:10:13,800
أجل

176
00:10:14,040 --> 00:10:15,970
يبدو شاقّاً

177
00:10:15,970 --> 00:10:18,180
لا تضغطي على نفسكِ كثيراً ثانية

178
00:10:18,660 --> 00:10:22,830
سأتساهل على نفسي بخصوص الأعمال
المنزليّة غداً، لذا لا تقلق

179
00:10:23,220 --> 00:10:27,780
أي مُتعصِّب مهرجانات ينضمّ
للجنة العمل؟

180
00:10:27,780 --> 00:10:30,220
إنّه أمرٌ أردتُ القيام به
في هذا العام فحسب

181
00:10:30,220 --> 00:10:31,400
هذا العام؟

182
00:10:32,970 --> 00:10:37,800
حتّى الآن، ليس لديّ أيّ شخص
يُشاهدني في الفعاليّات المدرسيّة

183
00:10:38,300 --> 00:10:40,430
،لم أستطع الطّلب من أمِّي المجيء

184
00:10:40,430 --> 00:10:42,750
عندما علمتُ أنّها كانت تعمل
دوماً بجدٍّ لأجلي

185
00:10:43,380 --> 00:10:47,680
لكن هذا العام مُختلف، لذا أعتقد
بأنّني يمكنني أن أكون مُتحفِّزة

186
00:10:47,680 --> 00:10:48,890
أم أنّه لا يحقُّ لي؟

187
00:10:49,740 --> 00:10:51,050
،إن عبّرتِ عن الأمر بهذه الطّريقة

188
00:10:51,050 --> 00:10:54,670
فإنّه يبدو وكأنّني شخص مُروِّع
لعدم رغبتي في القيام بذلك

189
00:10:54,670 --> 00:10:56,900
لم أقل ذلك الكلام بسبب هذا

190
00:10:57,390 --> 00:11:01,690
حسناً. إذاً سأكون الأمير أو أيّاً يكن

191
00:11:01,690 --> 00:11:05,760
أقصد، لا أريدكِ أن تشتكي قائلة
بأنّني أفسدتُ المهرجانَ بعد ذلك

192
00:11:05,760 --> 00:11:06,600
وهذا ما في الأمر

193
00:11:07,690 --> 00:11:11,780
،دائماً هو أكثر من يشتكي

194
00:11:12,560 --> 00:11:16,050
لكن في النّهاية، يريد أن يُحافظ
على سعادة عائلته

195
00:11:16,050 --> 00:11:17,280
—هذا هو غين الّذي أُحـ

196
00:11:18,520 --> 00:11:19,940
...مُخيف جدّاً

197
00:11:19,940 --> 00:11:23,910
"هل كنتُ على وشك قول "أُحبّه
كما لو أنّني أتلو قصيدة؟

198
00:11:23,910 --> 00:11:26,450
!سنُقيم مهرجانَ كاري اللّيلة

199
00:11:26,450 --> 00:11:27,980
هل أُبالغ في التّفكير في الأمر؟

200
00:11:27,980 --> 00:11:32,200
أقصد، ذلك "الحُبّ" كان من ناحية
!حُبّ عائليّ

201
00:11:33,120 --> 00:11:34,600
أتطبخين لجيش؟

202
00:11:36,680 --> 00:11:40,190
على أيّ حال، حاليّاً، أحتاج للتّركيز
!على المهرجان الثّقافيّ

203
00:11:42,250 --> 00:11:44,520
المعذرة

204
00:11:45,000 --> 00:11:47,940
هل أودوغاوا-سينباي هنا؟

205
00:11:47,940 --> 00:11:51,700
...إنّه هنا، لكنّه مشغول قليلاً حاليّاً

206
00:11:52,110 --> 00:11:53,780
!أيّها الخائن القذر

207
00:11:56,540 --> 00:11:58,760
!لا تتكلّم معي ثانية أبداً

208
00:12:01,640 --> 00:12:03,020
عُلِم

209
00:12:03,020 --> 00:12:04,530
شكراً على كُلّ شيء

210
00:12:10,560 --> 00:12:12,640
!إيتو-تشان

211
00:12:13,080 --> 00:12:16,300
المعذرة، ألا ينبغي أن تلحق بها؟

212
00:12:16,300 --> 00:12:18,440
لا مُشكلة

213
00:12:18,440 --> 00:12:21,800
فعلاقتنا لم تكن تعتمد على
شيء حقيقيّ على أيّ حال

214
00:12:24,980 --> 00:12:29,770
اتّهمَتْني بالخيانة فقط لأنّني
أخرج مع فتيات أُخريات

215
00:12:29,770 --> 00:12:33,820
لماذا تبدأ الفتيات بالانزعاج بعد
بدئنا بالمُواعدة؟

216
00:12:33,820 --> 00:12:35,050
!هذا الشّخص مريض نفسيّاً

217
00:12:35,050 --> 00:12:37,860
!يُعاني هذا السّينباي من مرض

218
00:12:37,860 --> 00:12:40,030
لا أشعر بحافز اليوم

219
00:12:40,750 --> 00:12:43,190
ما رأيكِ بالتغيُّب عن الاجتماع
والخروج في مُواعدة بدلاً من ذلك؟

220
00:12:43,190 --> 00:12:44,320
!عفواً؟

221
00:12:44,320 --> 00:12:47,450
في الأمس، قلتَ بأنّك ستحضر
الاجتماع إذا أتيتُ وأوصلتُك

222
00:12:47,450 --> 00:12:48,580
هل قلتُ ذلك؟

223
00:12:49,920 --> 00:12:51,860
بربّكِ، إنّها مُجرّد مُواعدة بسيطة

224
00:12:51,860 --> 00:12:54,860
مع شخص مثلكِ، أنا واثق بأنّها
ستكون مُنعشة ومُمتعة

225
00:12:54,860 --> 00:12:56,340
!لا أُريد

226
00:12:56,340 --> 00:12:57,840
ماذا؟ لكن لماذا؟

227
00:12:59,200 --> 00:13:03,090
لأنّ... أ-أوّل مرّة أريد الخروج
،فيها في مُواعدة

228
00:13:03,090 --> 00:13:05,850
!أريدها أن تكون مع الشّخص الّذي أُحبّه

229
00:13:11,070 --> 00:13:14,660
لحظة، هل هذا يعني إذاً بأنّكِ
لم تخرجي في مُواعدة من قبل؟

230
00:13:15,050 --> 00:13:17,190
لم أحظَ بوقتٍ كافٍ لذلك

231
00:13:17,910 --> 00:13:19,760
وليس لديكِ حبيب؟

232
00:13:19,760 --> 00:13:21,070
سأتجنّب الإجابة

233
00:13:21,070 --> 00:13:23,160
لكن هناك شخص تُحبّينه، صحيح؟

234
00:13:29,620 --> 00:13:31,400
أنا آسفة

235
00:13:31,400 --> 00:13:33,540
لا أعلم حقّاً

236
00:13:33,540 --> 00:13:35,250
ماذا تقصدين بأنّكِ "لا تعرفين"؟

237
00:13:36,190 --> 00:13:40,380
،أقصد، لم أقع في الحُبّ من قبل

238
00:13:40,380 --> 00:13:43,100
لذا لا أعرف كيف هو الشُّعور فعلاً

239
00:13:44,680 --> 00:13:47,210
هل تريدين التمرُّن بالخروج معي إذاً؟

240
00:13:47,540 --> 00:13:48,770
ماذا؟

241
00:13:49,060 --> 00:13:50,280
لا تقلقي

242
00:13:50,280 --> 00:13:54,400
سيكون مُجرّد تمرين، وأنا معتاد
على مثل هذه الأمور

243
00:13:54,400 --> 00:13:55,360
...ثمّ

244
00:13:57,800 --> 00:14:03,240
أنا متأكّدٌ بأنّكِ ستكتشفين ماهيّة
الحُبّ حالما نخرج معاً

245
00:14:03,240 --> 00:14:04,240
صحيح؟

246
00:14:04,240 --> 00:14:06,140
لا يبدو هذا سيّئاً، أليس كذلك؟

247
00:14:06,900 --> 00:14:09,240
ما الّذي يقوله حتّى؟

248
00:14:09,510 --> 00:14:10,610
أنا خائفة

249
00:14:10,950 --> 00:14:12,120
!النّجدة

250
00:14:13,080 --> 00:14:14,130
...غين

251
00:14:14,130 --> 00:14:15,080
!إيتو

252
00:14:18,520 --> 00:14:20,140
ماذا تفعلين؟

253
00:14:20,140 --> 00:14:21,040
!تعالي

254
00:14:22,170 --> 00:14:24,090
!أمير فجأة

255
00:14:26,280 --> 00:14:28,680
!ابتعدي عنه

256
00:14:29,230 --> 00:14:32,440
ما مُشكلتك أيُّها الأمير الصّغير؟

257
00:14:32,440 --> 00:14:34,640
أتعرف إيتو-تشان؟

258
00:14:35,290 --> 00:14:36,230
ماذا؟

259
00:14:36,550 --> 00:14:38,440
وماذا لو كنتُ كذلك؟

260
00:14:38,760 --> 00:14:40,570
أنا أخوها الصّغير

261
00:14:41,160 --> 00:14:42,050
هل لديك اعتراض؟

262
00:14:48,470 --> 00:14:50,450
هل أنت أخوها الصّغير فعلاً؟

263
00:14:56,470 --> 00:14:59,590
لذا، لديّ إعلان لكم جميعاً

264
00:15:01,510 --> 00:15:03,670
هدّئي قلبكِ

265
00:15:03,670 --> 00:15:04,380
"فراغ"

266
00:15:04,380 --> 00:15:05,800
كوني الفراغ

267
00:15:06,900 --> 00:15:10,350
مهرجاننا الثّقافيّ مُقبل علينا أخيراً

268
00:15:10,680 --> 00:15:14,160
وبهذا، نكون قد وصلنا للجزء
الأكثر حرجاً من تحضيراتنا

269
00:15:14,160 --> 00:15:16,740
لذا سأعود إلى المنزل لاحقاً

270
00:15:16,740 --> 00:15:19,330
!لا تقلقي بشأن ذلك

271
00:15:19,330 --> 00:15:20,730
!بالتّوفيق

272
00:15:20,730 --> 00:15:22,110
شكراً لكما

273
00:15:22,110 --> 00:15:24,280
،بطرد كافّة الأفكار السّيّئة عنّي

274
00:15:24,280 --> 00:15:27,460
سأصبح النّسخة المثاليّة للأخت
الكُبرى لعائلة ناريتا

275
00:15:28,110 --> 00:15:28,960
أنتِ

276
00:15:35,270 --> 00:15:37,650
،قد أتقبّل عودتكِ إلى المنزل مُتأخِّرة

277
00:15:38,020 --> 00:15:40,750
لكن لا تكوني لوحدكِ مع ذلك
الشّخص إطلاقاً

278
00:15:40,750 --> 00:15:44,460
تقصد السّينباي الّذي حاول مُغازلتها؟

279
00:15:44,810 --> 00:15:46,220
!ماذا حدث؟

280
00:15:46,220 --> 00:15:47,470
!هذا لا يُغتفَر

281
00:15:47,470 --> 00:15:50,760
لم يفعل شيئاً غريباً لكِ، صحيح؟

282
00:15:51,230 --> 00:15:52,720
!شيء غريب؟

283
00:15:53,150 --> 00:15:54,850
...على سبيل المثال

284
00:15:59,440 --> 00:16:02,410
لماذا يغازل أحدٌ شخصاً مثلكِ؟

285
00:16:02,410 --> 00:16:04,940
!أنا آسفة لأنّ شخصاً أراد هذا

286
00:16:05,630 --> 00:16:07,790
...لا بُدّ أنّني فقدتُ صوابي

287
00:16:08,680 --> 00:16:09,960
،لأنّني آنذاك

288
00:16:09,960 --> 00:16:13,520
ظننتُ بأنّ الأمير موجود فعلاً

289
00:16:16,890 --> 00:16:19,360
!حسناً، لا، توقّف

290
00:16:19,360 --> 00:16:22,820
!أيُّها الأمير، تعابير وجهك لا تنقل أي مشاعر

291
00:16:22,820 --> 00:16:26,690
ولماذا أنت الأميرة سنو وايت؟

292
00:16:26,690 --> 00:16:29,330
هذا يكفي لقتل أيّ عواطف

293
00:16:30,060 --> 00:16:31,440
!كم أُعاني"

294
00:16:33,710 --> 00:16:36,920
"قبلة رقيقة قد تكون كافية لطمأنتي

295
00:16:38,380 --> 00:16:41,690
ماذا يفعل المرء لمُساعدة شخص كهذا؟

296
00:16:45,210 --> 00:16:47,110
إيتو-تشان

297
00:16:47,110 --> 00:16:48,620
،بعد أن نفرغ من العمل اليوم

298
00:16:48,620 --> 00:16:50,280
ما رأيك بالخروج في تلك المُواعدة؟

299
00:16:50,660 --> 00:16:53,140
،أريد العودة إلى المنزل باكراً
لذا لا أستطيع

300
00:16:53,140 --> 00:16:56,240
هل قال أخوكِ الصّغير شيئاً؟

301
00:16:56,240 --> 00:16:58,310
هل هو أخوكِ الصّغير فعلاً أصلاً؟

302
00:16:58,310 --> 00:16:59,870
لا تبدوان مُتشابهين إطلاقاً

303
00:17:00,230 --> 00:17:02,940
إنّه أخي الصّغير منذ زواج
والدينا مرّة أُخرى

304
00:17:03,590 --> 00:17:05,200
حقّاً؟

305
00:17:05,920 --> 00:17:09,090
في العادة، سيكون هذا كافياً لاستفزازهما

306
00:17:09,600 --> 00:17:16,400
لكن رُبّما هذا مُمتع إن لم تكن
الأمور سهلة كالمعتاد

307
00:17:18,640 --> 00:17:19,600
تبّاً

308
00:17:21,180 --> 00:17:23,920
!تأخّر الوقت وما زلتُ هنا

309
00:17:28,230 --> 00:17:29,150
!أنتِ

310
00:17:30,600 --> 00:17:32,100
غين

311
00:17:32,100 --> 00:17:33,670
،انغمستُ كثيراً في هذا

312
00:17:33,670 --> 00:17:35,150
فنسيتُ الوقت

313
00:17:35,520 --> 00:17:38,750
أتعملين معه فقط؟

314
00:17:38,750 --> 00:17:39,550
ماذا؟

315
00:17:39,550 --> 00:17:40,850
—لا، كان هناك آخرون قبل لحـ

316
00:17:40,850 --> 00:17:41,680
!هذا صحيح

317
00:17:41,680 --> 00:17:44,290
كنّا نحن الاثنان نعمل بجدّ معاً

318
00:17:48,060 --> 00:17:48,830
بئساً

319
00:17:48,830 --> 00:17:51,040
،ظننتُ أنّ هناك حشرة على يدك

320
00:17:51,040 --> 00:17:52,640
لكن لا بُدّ أنّني كنتُ مُخطئاً

321
00:17:52,640 --> 00:17:55,380
كنت تحاول دفعها بعيداً لأجلي

322
00:17:55,380 --> 00:17:56,670
هذا لطفٌ كبيرٌ منك

323
00:17:56,670 --> 00:17:59,200
أنا مُفعم باللّطف فحسب

324
00:17:59,200 --> 00:18:01,480
لا بُدّ أنّ الفتيات مُولعات بك

325
00:18:01,480 --> 00:18:03,010
—مهلاً يا غين

326
00:18:07,530 --> 00:18:09,860
أنا أتضوّر جوعاً، لذا لنعُد إلى المنزل

327
00:18:09,860 --> 00:18:12,350
!سأذهب وأُخبر المُعلّم، انتظرا هنا فحسب

328
00:18:15,920 --> 00:18:18,130
هل أنت قلقٌ على أختك الكُبرى؟

329
00:18:18,460 --> 00:18:20,250
تبدو وقائيّاً بشكل مُبالغ به

330
00:18:20,720 --> 00:18:23,070
لكن أتفهّم مشاعرك هذه

331
00:18:23,620 --> 00:18:27,210
التّواجُد مع إيتو-تشان مُطمئن جدّاً

332
00:18:27,470 --> 00:18:31,090
وردود أفعالها ظريفة جدّاً لدرجة
لا تستطيع تجاهلها فحسب

333
00:18:31,910 --> 00:18:34,250
لكن في النّهاية، أنت أخوها الصّغير

334
00:18:34,250 --> 00:18:38,580
مُحال أن تُصبح الرّقم واحد في نظرها

335
00:18:41,720 --> 00:18:44,520
لا أُبالي لأن أكون الرّقم واحد
في حياة أحد

336
00:18:44,520 --> 00:18:47,000
أنا أحمي عائلتي

337
00:18:48,030 --> 00:18:51,840
حريّ بك أن تُفكِّر مرّتين بشأن العبث
معها من أجل تسلية نفسك

338
00:18:52,820 --> 00:18:55,530
—إذا فعلتَ أيّ شيء لأذيّتها، فأنا

339
00:18:55,530 --> 00:18:57,160
!شكراً على الانتظار

340
00:19:00,160 --> 00:19:02,490
يبدو أنّ لديك الكثير من الأعمال أيضاً

341
00:19:02,490 --> 00:19:03,800
أجل

342
00:19:03,800 --> 00:19:06,920
طلبوا منّي حفظ كافّة سطوري
قبل حلول الغد

343
00:19:06,920 --> 00:19:08,850
ما زلت لم تحفظها؟

344
00:19:08,850 --> 00:19:11,370
ليس عليّ ترديد كلمات مُحرِجة
،أمام جمهور فحسب

345
00:19:11,370 --> 00:19:13,220
هناك مشهد قبلة أيضاً

346
00:19:13,220 --> 00:19:16,340
تجري أمور كثيرة، لذا تغيب
السّطور عن ذهني

347
00:19:17,500 --> 00:19:19,810
لم أكن مُلائماً كأمير على أيّ حال

348
00:19:20,510 --> 00:19:25,730
أتعلم؟ لا أظنّك مُضطرّاً للالتزام
بدور الأمير تماماً

349
00:19:26,420 --> 00:19:29,790
أنت رائعٌ بما يكفي من دون فعل شيء

350
00:19:29,790 --> 00:19:32,940
وصعوبة انسجامك مع العبارات
ليست مُشكلة أيضاً

351
00:19:33,940 --> 00:19:36,300
بعد ذلك، استخدم مُخيّلتك فحسب

352
00:19:36,300 --> 00:19:39,320
تخيّل وجود شخص مُميّز أمامك فحسب

353
00:19:39,320 --> 00:19:43,790
وأقنع نفسك بأنّك تتكلّم معه

354
00:19:43,790 --> 00:19:45,960
لا بُدّ أنَّ لديك شخص كهذا

355
00:19:47,320 --> 00:19:49,240
لا أُصدِّق ذلك

356
00:19:50,270 --> 00:19:52,860
يا لها من أميرة حسناء

357
00:19:53,540 --> 00:19:55,850
،لا أُصدِّق بأنّها رغم أنَّ القدر جمعنا معاً

358
00:19:56,220 --> 00:19:57,810
...قد ماتت

359
00:20:00,160 --> 00:20:00,980
—ما

360
00:20:04,140 --> 00:20:07,270
إذاً، هكذا؟

361
00:20:08,520 --> 00:20:10,430
!لا تفعل هذا فجأة فحسب

362
00:20:10,430 --> 00:20:11,360
!أخفتَني

363
00:20:11,360 --> 00:20:13,780
!أنتِ من طلب منّي فعلها

364
00:20:13,780 --> 00:20:15,780
...هذا صحيح، لكن

365
00:20:15,780 --> 00:20:17,250
يكفي

366
00:20:17,250 --> 00:20:19,320
لا تطلبي منّي فعل شيء ثانية يا حمقاء

367
00:20:20,270 --> 00:20:22,990
كيف لهما أن يكونا مُمتعضين هكذا؟

368
00:20:22,990 --> 00:20:25,380
ماذا؟! ما زلتُما هنا؟

369
00:20:28,420 --> 00:20:30,050
أراك غداً

370
00:20:30,400 --> 00:20:33,420
،أعتقد إذا كان أخوكِ غير الشّقيق
فهذا يُفسِّر الأمور

371
00:20:33,940 --> 00:20:35,420
ماذا تقصد؟

372
00:20:35,420 --> 00:20:38,420
كنتُ أتساءل عن سبب عدم
وقوعكِ في حُبّي

373
00:20:39,030 --> 00:20:42,660
لكن يبدو أنّ عقلكِ محجوز بالكامل بواسطته

374
00:20:43,080 --> 00:20:44,190
بواسطته"؟"

375
00:20:45,220 --> 00:20:46,510
،رُبّما ليس تماماً

376
00:20:46,510 --> 00:20:48,930
لكن لا تعتبرينه أخاكِ الصّغير فقط

377
00:20:49,830 --> 00:20:50,960
أنتِ تُحبّينه، أليس كذلك؟

378
00:20:50,960 --> 00:20:52,650
أقصد ناريتا غين

379
00:20:53,710 --> 00:20:54,920
حُبّ؟

380
00:20:58,320 --> 00:21:01,120
،قلتِ بأنّكِ لا تعرفين معنى الحُبّ

381
00:21:01,120 --> 00:21:03,530
لكن أعتقد بأنّكِ لا تريدين أن
تعرفي فحسب، صحيح؟

382
00:21:04,120 --> 00:21:09,120
أقصد، الانغماس في الأمر سوف
يُعقِّد المسألة ليس إلّا

383
00:21:12,790 --> 00:21:15,380
ما هو الحُبّ حتّى...؟

384
00:21:16,060 --> 00:21:19,220
عمّاذا كنتُما تتهامسان بالضّبط قبل قليل؟

385
00:21:20,050 --> 00:21:23,240
عن المُهرجان

386
00:21:23,240 --> 00:21:24,430
بجدّية؟

387
00:21:26,510 --> 00:21:30,690
ألست مُنهمكاً بي زيادة عن اللُّزوم؟

388
00:21:34,020 --> 00:21:36,110
أجل. نحن أخوان

389
00:21:36,110 --> 00:21:37,730
من الطّبيعيّ أن أنهمك

390
00:21:37,730 --> 00:21:38,930
عمّاذا تتكلّم؟

391
00:21:40,020 --> 00:21:43,970
،لكن كُلّما أعارني غين اهتماماً

392
00:21:43,970 --> 00:21:48,220
أصبحتُ أكثر غرابة

393
00:21:49,030 --> 00:21:52,860
عندما أكون معه، لا أستطيع الحِفاظ
على وجودي في فراغ

394
00:21:53,680 --> 00:21:55,680
أيّاً يكن، لنعُد إلى المنزل فحسب

395
00:21:57,910 --> 00:21:58,880
حسناً

396
00:21:59,630 --> 00:22:04,180
أقصد، الانغماس في الأمر سوف
يُعقِّد المسألة ليس إلّا

397
00:22:08,020 --> 00:22:10,180
...إذا كنتُ مُنغمسة في الأمر

398
00:22:12,330 --> 00:22:13,440
...فماذا

399
00:22:15,370 --> 00:22:17,070
سيحلُّ بي؟