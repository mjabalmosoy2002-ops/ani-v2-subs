1
00:01:37,020 --> 00:01:39,430
لا يبدو أنّنا سنعود إلى المنزل
في أيّ وقت قريب

2
00:01:42,550 --> 00:01:47,500
ليس وكأنّني كنتُ ذاهباً إلى المنزل دون
إجراء مُحادثة حقيقيّة معكِ

3
00:01:55,390 --> 00:02:00,110
ما-ماذا تقصد بذلك؟

4
00:02:01,450 --> 00:02:03,560
كنتُ أفكِّر منذ ذلك الحين

5
00:02:04,250 --> 00:02:05,190
فيكِ

6
00:02:06,410 --> 00:02:08,770
لستُ من أنصار التّفكير

7
00:02:09,650 --> 00:02:13,500
،لذا لا أعرف ما الجواب الصّحيح على اعترافك

8
00:02:15,690 --> 00:02:17,320
لكن لا أعتقد بأنّني أستطيع فعلها

9
00:02:18,450 --> 00:02:21,040
...أعتبركِ فرداً من العائلة فقط

10
00:02:21,040 --> 00:02:22,090
!حـ-حقّاً؟

11
00:02:22,090 --> 00:02:23,910
كيف يُفترض بك أن تُجيب حتّى؟

12
00:02:24,130 --> 00:02:27,910
استغرقتُ أيضاً وقتاً لأتبيّن من مشاعري

13
00:02:28,180 --> 00:02:29,590
أقصد بأنّه أنت

14
00:02:29,590 --> 00:02:32,390
،كان انطباعي الأوّل عنك سيّئاً للغاية

15
00:02:32,390 --> 00:02:34,520
،أنت سريع جدّاً في التعرِّي في أيّ مكان

16
00:02:34,520 --> 00:02:36,910
أنت سريع جدّاً في السّخرية
!من النّاس، وهكا

17
00:02:37,300 --> 00:02:39,500
،ظننتُ بأنّكِ قلتِ بأنّكِ تحبّينني

18
00:02:39,500 --> 00:02:40,970
لذا ما هذا الكلام الغبيّ؟

19
00:02:41,250 --> 00:02:43,430
!أبذل قصارى جهدي لتهدئة الأوضاع

20
00:02:43,430 --> 00:02:45,440
لا بُدّ من وجود أشياء أُخرى يمكنكِ قولها

21
00:02:45,440 --> 00:02:48,310
!لا تُعلّمني كيفيّة التكلُّم بعد أن رفضتني للتو

22
00:02:48,310 --> 00:02:50,920
أنا تائه. لا أعرف كيف هي صورتي داخل رأسك

23
00:02:50,920 --> 00:02:52,690
!أجل، هذا يجعلنا اثنين

24
00:02:55,510 --> 00:03:01,990
هل يمكنك على الأقلّ أن تخبرني كيف تراني؟

25
00:03:03,750 --> 00:03:05,880
كيف أراكِ؟

26
00:03:06,230 --> 00:03:09,270
أعتقد مثل... دُمية كوكيشي؟

27
00:03:11,390 --> 00:03:13,120
وجودكِ حولي يبعث على الهدوء

28
00:03:13,120 --> 00:03:14,580
عفواً؟

29
00:03:14,580 --> 00:03:16,720
"أليست "فرداً هامّاً في العائلة

30
00:03:16,720 --> 00:03:18,150
أو "أخت كُبرى" أفضل؟

31
00:03:18,150 --> 00:03:21,530
"على الأقلّ، ليس "دُمية كوكيشي؟

32
00:03:22,280 --> 00:03:23,610
شكراً لصبركم

33
00:03:23,610 --> 00:03:25,640
سنستأنف الآن رحلة المركبة

34
00:03:25,640 --> 00:03:27,930
أنت من ينبغي أن يبحث عن أشياء
!أُخرى كي يقولها

35
00:03:27,930 --> 00:03:29,130
!كفّي عن التحرُّك كثيراً

36
00:03:29,130 --> 00:03:31,630
!هل تريد منّي أن أعيش حياتي كدُمية؟

37
00:03:31,630 --> 00:03:33,390
!لم أقل ذلك أبداً

38
00:03:33,390 --> 00:03:35,070
على أيّ حال، ما العيب في دُمى كوكيشي؟

39
00:03:35,070 --> 00:03:36,900
!قارنّي بشيء بشريّ

40
00:03:37,720 --> 00:03:40,000
!أهلاً بعودتكما

41
00:03:41,850 --> 00:03:43,220
هيّا. انزلي

42
00:03:43,220 --> 00:03:45,280
لا. أنت أوّلاً

43
00:03:45,280 --> 00:03:48,170
أنا واثقة بأنّك لا تطيق انتظار الخروج
،من هنا والابتعاد عنّي

44
00:03:48,170 --> 00:03:50,790
بما أنّك لا تستطيع التّمييز فيما إذا كنتُ
أختك أو دُمية كوكيشي

45
00:03:51,030 --> 00:03:53,070
!كان من المُفترَض أن يكون ذلك كاستعارة

46
00:03:51,640 --> 00:03:53,070
...المعذرة

47
00:03:53,070 --> 00:03:54,880
!كانت تلك الاستعارة الأسوأ في العالم

48
00:03:54,880 --> 00:03:56,260
،بعد استغراق وقت طويل للإجابة

49
00:03:56,260 --> 00:03:58,200
!هذا أفضل ما توصّلت إليه؟

50
00:03:59,040 --> 00:04:00,300
هل ترغبان في تكرار التّجربة؟

51
00:04:00,300 --> 00:04:01,770
!أجل، من فضلك

52
00:04:03,770 --> 00:04:06,810
ما الّذي كنّا نتحدّث عنه حتّى؟

53
00:04:08,040 --> 00:04:09,600
فهمتِ الآن، صحيح؟

54
00:04:10,990 --> 00:04:14,700
هذه هي المسافة الأكثر طبيعيّة
بالنّسبة لنا على ما أعتقد

55
00:04:15,600 --> 00:04:18,250
ما الّذي سيتغيّر حتّى إذا كنّا نتواعد؟

56
00:04:18,610 --> 00:04:21,460
عندما قلتُ "لا أستطيع فعلها"، فليس
لأنّني أكرهكِ

57
00:04:22,290 --> 00:04:26,590
حتّى هذا النّوع من الشّجار
...مُمتع بعض الشّيء معكِ

58
00:04:27,910 --> 00:04:32,430
لهذا السّبب سأظلّ أعزّكِ كفرد من العائلة

59
00:04:34,190 --> 00:04:35,420
أم أنّ ذلك غير مُناسب؟

60
00:04:36,450 --> 00:04:38,820
،أعلم بأنّني أخّرتُ إجابتي لفترة طويلة

61
00:04:38,820 --> 00:04:41,570
لكن في النّهاية، هذا أفضل
ما يمكنني قوله حاليّاً

62
00:04:43,400 --> 00:04:44,870
آسف

63
00:04:44,870 --> 00:04:48,280
ارتأيتُ بأنّ هذا لم يكن شيئاً
قابلاً للردّ فوراً

64
00:04:49,250 --> 00:04:52,190
إنّه غالباً مُهمّ حقّاً بالنّسبة لكِ

65
00:04:57,410 --> 00:04:59,490
!حسناً، فهمت. كان الأمر برمّته غلطتي

66
00:04:59,490 --> 00:05:01,810
!هل قلتُ كلاماً مُجحِفاً من جديد؟

67
00:05:01,810 --> 00:05:04,440
،إن كنت قادراً على إعطاء إجابة مُناسبة كهذه

68
00:05:04,440 --> 00:05:06,780
فلماذا لم تفعل ذلك منذ البداية؟

69
00:05:06,780 --> 00:05:08,280
!مهلاً، لا تبكي

70
00:05:08,280 --> 00:05:09,980
حسناً إذاً، هل تريدين البدء من جديد؟

71
00:05:10,490 --> 00:05:13,150
كُفّ عن تهديدي بكلام جارح

72
00:05:13,580 --> 00:05:15,690
معكِ حقّ. آسف

73
00:05:18,250 --> 00:05:22,170
أحبّ مُشاجرتك هكذا أيضاً

74
00:05:22,690 --> 00:05:26,360
لديك لِسان حادّ، لكنّك حنون حقّاً

75
00:05:29,230 --> 00:05:33,680
رُبّما هذا ما يجعلني أفقد صوابي
،وأقع في حُبّك

76
00:05:34,440 --> 00:05:36,080
لكن لستُ نادمة على ذلك

77
00:05:37,230 --> 00:05:41,820
شكراً على مُراعاة مشاعري إلى هذا الحدّ

78
00:05:43,180 --> 00:05:45,360
،أشعر بالرّضا بعض الشّيء

79
00:05:45,360 --> 00:05:47,130
بطريقة "التّباهي" هذه

80
00:05:48,450 --> 00:05:49,910
أعتقد بأنّ هذا جيّد

81
00:05:52,700 --> 00:05:53,940
هكذا أفضل

82
00:05:54,810 --> 00:05:58,540
غالباً هذا أفضل وضع بالنّسبة لنا

83
00:05:58,540 --> 00:06:01,910
وأيضاً لن أستعمل أسلوب الالتفاف معكِ

84
00:06:01,910 --> 00:06:04,050
"لن؟ بالأحرى "لا تستطيع

85
00:06:04,050 --> 00:06:05,260
أعلم

86
00:06:05,260 --> 00:06:06,630
...أنتِ

87
00:06:07,540 --> 00:06:09,200
،وداعاً فعلاً هذه المرّة

88
00:06:10,670 --> 00:06:12,190
يا حُبِّي الأوّل

89
00:06:19,770 --> 00:06:20,680
!حسناً

90
00:06:20,680 --> 00:06:21,770
!حان وقت الاستيقاظ

91
00:06:23,170 --> 00:06:26,740
إذا ظللتُم كسالى هكذا فستنتهي
!استراحة الرّبيع دون أن تشعروا

92
00:06:26,740 --> 00:06:28,310
غين، هل لديك عمل اليوم؟

93
00:06:28,310 --> 00:06:30,200
أجل، وماذا يعني؟

94
00:06:30,200 --> 00:06:31,240
روي-كن؟

95
00:06:31,460 --> 00:06:32,910
أنا ذاهب إلى منزل ماي-تشان

96
00:06:32,910 --> 00:06:33,870
راكو-كن؟

97
00:06:33,870 --> 00:06:35,240
المكتبة

98
00:06:35,240 --> 00:06:38,410
شو-كن حالياً في وضع هيكيكوموري يلعب لُعبة

99
00:06:39,190 --> 00:06:42,420
سأطوّر أطباقَ جديدة صديقة للميزانيّة

100
00:06:42,760 --> 00:06:44,310
بقي يومان من استراحة الرّبيع

101
00:06:44,310 --> 00:06:47,300
!لنستغلّ اليوم لأقصى درجة

102
00:06:49,640 --> 00:06:52,030
تبدو مُتحمِّسة للغاية ثانية

103
00:06:52,030 --> 00:06:53,680
أمستْ تِلك هِوايتها

104
00:06:54,640 --> 00:06:56,060
!مؤلم

105
00:06:56,330 --> 00:06:57,810
أنا آسف

106
00:07:00,280 --> 00:07:02,640
كان الأمر هكذا منذ ذهبتُما
إلى مدينة الملاهي

107
00:07:03,560 --> 00:07:04,650
هل حدث شيء؟

108
00:07:05,370 --> 00:07:06,320
ليس تماماً

109
00:07:08,520 --> 00:07:09,570
!ما الخطب؟

110
00:07:09,860 --> 00:07:11,700
رفضتَها، أليس كذلك؟

111
00:07:13,050 --> 00:07:13,700
لماذا؟

112
00:07:14,570 --> 00:07:15,510
!أنت

113
00:07:15,510 --> 00:07:17,820
كنتُ أُناقش الأمور معها لبعض الوقت

114
00:07:17,820 --> 00:07:20,460
بالنّيابة عن أخي الأكبر السّاذج البائس

115
00:07:23,240 --> 00:07:25,350
شعرتُ بالرّاحة لأنّها تمكّنتْ
،أخيراً من الاعتراف

116
00:07:25,350 --> 00:07:28,840
لكنّك تحاول الآن التّظاهر بأنّه لم يحدث شيء

117
00:07:29,610 --> 00:07:32,200
من الطّبيعي أن أقلق حيال الأمر

118
00:07:32,200 --> 00:07:35,410
حريّ بك أن تُجيب بصدق وإلّا أرسلتُ
هذه للجميع حول العالم

119
00:07:37,530 --> 00:07:40,800
أقصد... نحن... عائلة

120
00:07:41,210 --> 00:07:45,070
...كم هذا غريب

121
00:07:45,070 --> 00:07:49,210
قبل مدّة، ألم تُحاول دفعها تجاهي
بعد عدم فهم مُحيطك جيّداً؟

122
00:07:49,210 --> 00:07:51,990
ألم تقل حينها بأنّ كوننا عائلة لا يهمّ؟

123
00:07:53,190 --> 00:07:54,690
!ماذا تريدني أن أفعل؟

124
00:07:54,690 --> 00:07:56,850
!بصراحة لا أعرف ماذا أفعل

125
00:07:58,450 --> 00:08:01,460
تبّاً. أشفق عليها لوقوعها
في حُبّ غبيّ كهذا

126
00:08:01,460 --> 00:08:03,280
،إن كنتَ قلقاً عليها إلى هذه الدّرجة

127
00:08:03,280 --> 00:08:05,380
—فلِمَ لا تكون حبيبها

128
00:08:06,960 --> 00:08:08,990
أيّها الحُثالة

129
00:08:08,990 --> 00:08:11,800
من الأفضل أن تختار الموت على
قول هذا الكلام لها

130
00:08:14,340 --> 00:08:16,900
ما هو... الحُبّ؟

131
00:08:21,300 --> 00:08:24,390
إن كنتَ لا تعلم، فابدأ بمُواعدتها فحسب

132
00:08:24,630 --> 00:08:27,500
لن تنعتني بالحُثالة إذا فعلتُ ذلك؟

133
00:08:27,860 --> 00:08:29,780
الأمر يعتمد عليك

134
00:08:30,610 --> 00:08:32,640
ما أقصده انسَ لِلَحظة بأنّها
،فردٌ من العائلة

135
00:08:33,080 --> 00:08:35,530
وانظر إليها على طبيعتها فحسب

136
00:08:37,610 --> 00:08:40,160
وصلتُ إلى هذه المرحلة

137
00:08:41,110 --> 00:08:45,700
اعتباري إيّاها فتاةً بدا وكأنّ الأمور
،ستتّخذ منحى مُريباً

138
00:08:45,700 --> 00:08:47,540
لذا توقّفت

139
00:08:49,850 --> 00:08:50,830
ماذا قلت؟

140
00:08:52,840 --> 00:08:54,330
أتساءل ما إن تصرّفتُ بشكل صحيح

141
00:08:55,440 --> 00:08:58,460
هل تمكّنتُ من فعل كُلّ شيء كالمعتاد؟

142
00:09:00,290 --> 00:09:03,350
لكن يؤرقني قليلاً أنّ غين يبدو
أهدأ من العادة

143
00:09:06,530 --> 00:09:08,020
!سنُغادر

144
00:09:08,020 --> 00:09:10,120
!لا تتأخّروا كثيراً في الخارج

145
00:09:14,900 --> 00:09:17,460
و-وداعاً

146
00:09:18,080 --> 00:09:19,250
بالتّوفيق لك

147
00:09:19,620 --> 00:09:21,520
سأتأخّر في العودة

148
00:09:24,610 --> 00:09:26,030
لماذا كان يتكلّم بتلك الطّريقة؟

149
00:09:26,880 --> 00:09:29,180
هل بدا سلوكي مُصطنعاً؟

150
00:09:30,530 --> 00:09:32,730
أعتقد لا بُدّ أنّ ذلك سبّبَ له إحراجاً

151
00:09:33,950 --> 00:09:35,970
يجب عليّ نسيان ذلك والعودة

152
00:09:36,720 --> 00:09:40,040
العودة إلى ما قبل وقوعي في حُبّه
حيث كان كُلّ شيء هادئاً

153
00:09:42,010 --> 00:09:43,140
...بالمُناسبة

154
00:09:44,290 --> 00:09:45,720
ما زلتُ لم أُرجِع هذه

155
00:09:47,840 --> 00:09:49,130
سأغسلها وأُعيدها

156
00:09:56,080 --> 00:09:57,000
لا يجدر بي ذلك

157
00:09:58,090 --> 00:10:01,290
شو-كن، هل لديك أيّ شيء للغسيل؟

158
00:10:02,320 --> 00:10:04,190
قلتُ بأن أنسى ذلك

159
00:10:04,580 --> 00:10:07,030
آسفة، هل كنتَ نائماً؟

160
00:10:07,030 --> 00:10:08,880
سأحضر لك طعاماً لاحقاً

161
00:10:08,880 --> 00:10:10,450
من الأفضل أن تأكل جيّداً

162
00:10:10,880 --> 00:10:13,480
إنّه نائم لذا لا يستطيع سماعي

163
00:10:13,480 --> 00:10:14,500
...على هذا المُعدَّل

164
00:10:18,540 --> 00:10:19,510
تبّاً

165
00:10:20,640 --> 00:10:23,760
أتعلمين؟ لا يهمّ

166
00:10:27,060 --> 00:10:32,300
سيكون من الجيّد أن يرتطم رأسي وتزول
كافّة الذّكريات المُؤلمة

167
00:10:33,180 --> 00:10:38,020
رُبّما وصولاً إلى اليوم الّذي انضممتُ
فيه لهذه العائلة أوّل مرّة

168
00:10:39,250 --> 00:10:40,430
مُحال

169
00:10:40,430 --> 00:10:43,030
ألن يكون ذلك مُلائماً؟

170
00:10:50,310 --> 00:10:51,330
هل أنتِ بخير؟

171
00:10:52,860 --> 00:10:55,050
هل اصطدمتِ بشيء؟

172
00:10:55,310 --> 00:10:56,280
أونيه-تشان؟

173
00:10:59,780 --> 00:11:00,490
من أنت؟

174
00:11:08,090 --> 00:11:09,040
أنا آسف

175
00:11:09,450 --> 00:11:12,730
لا بُدّ أنّكِ انصدمتِ عندما رأيتِني
فجأة بهذا الشّكل

176
00:11:12,730 --> 00:11:14,730
لـ-لا عليك

177
00:11:16,170 --> 00:11:18,350
...ظننتُك غريباً ما

178
00:11:19,450 --> 00:11:24,010
شعرتُ بأنّ جسدي بدا غريباً منذ
بدء استراحة الرّبيع

179
00:11:24,330 --> 00:11:26,910
لكن كنتُ مُنغمساً في اللّعب لدرجة
لم أحظَ بوقت للقلق

180
00:11:26,910 --> 00:11:28,830
...في فترة ما أدركتُ بأنّني كنتُ هكذا

181
00:11:28,830 --> 00:11:31,530
لا، هذا تغيُّر كبير

182
00:11:33,530 --> 00:11:34,870
!تتفّرت

183
00:11:34,870 --> 00:11:36,590
!ظهرَتْ تفرة

184
00:11:36,820 --> 00:11:38,260
"تقصد "طفرة

185
00:11:38,260 --> 00:11:39,270
!أجل

186
00:11:39,270 --> 00:11:42,520
إذاً كيف ترى العالم من الأعلى هناك؟

187
00:11:42,520 --> 00:11:44,220
المشهد جميل

188
00:11:44,220 --> 00:11:47,110
هل صحيح أنّ البشر يبدون كقمامة؟

189
00:11:47,110 --> 00:11:48,470
إطلاقاً

190
00:11:48,730 --> 00:11:51,780
أعتقد بأنّني أيضاً مررتُ بطفرة نموّ كبيرة
في السّنة الإعداديّة الثّالثة

191
00:11:51,780 --> 00:11:53,600
هل هذا قدَر ناريتا؟

192
00:11:54,550 --> 00:11:56,870
لكن يسرّني أنّه كان شو-كن فقط

193
00:11:57,410 --> 00:12:00,800
لوهلة، ظننتُ بأنّني خُلِقتُ
من جديد في إيسيكاي

194
00:12:00,800 --> 00:12:03,490
هل أنتِ مُرتبكة لدرجة سقطتِ
فيها عبر السّلالم؟

195
00:12:04,690 --> 00:12:06,680
...آسف

196
00:12:06,680 --> 00:12:08,810
!ما-ما الّذي تتحدّث عنه؟

197
00:12:08,810 --> 00:12:10,940
!لستُ مُرتبِكة أو ما شابه

198
00:12:10,940 --> 00:12:13,120
،أقصد، أجل، رُفِضتُ بتلك الطّريقة فحسب

199
00:12:13,360 --> 00:12:15,110
!لكنّني على ما يُرام

200
00:12:15,110 --> 00:12:16,520
...قالَتْها بلسانها للتو

201
00:12:16,520 --> 00:12:18,660
إنّه العمل كالمعتاد

202
00:12:18,660 --> 00:12:22,110
انظر. أعددتُ كُلّ هذه الأطباق الاقتصاديّة

203
00:12:22,110 --> 00:12:24,970
إن أعددتِ كُلّ هذه الكمّية، فهل
يبقى "اقتصاديّاً"؟

204
00:12:25,770 --> 00:12:27,180
عُدت

205
00:12:27,180 --> 00:12:29,170
أهلاً بعودتك

206
00:12:31,910 --> 00:12:33,140
من أنت؟

207
00:12:34,620 --> 00:12:35,690
هذا صحيح

208
00:12:35,980 --> 00:12:38,570
لا يمكنني البقاء مكتئبة هكذا للأبد

209
00:12:41,970 --> 00:12:44,320
ماذا عنك؟ كما الماضي؟

210
00:12:44,320 --> 00:12:47,110
أجل. الجميع يبلون حسناً

211
00:12:47,110 --> 00:12:49,250
مراسم دخول المدرسة الخاصّة بشو-كن اقتربت

212
00:12:49,250 --> 00:12:50,780
!تهانينا

213
00:12:50,780 --> 00:12:54,330
مضى قرابة العام منذ أصبحت أختاً كُبرى

214
00:12:54,740 --> 00:12:55,750
عام واحد

215
00:12:56,280 --> 00:12:56,970
هذا صحيح

216
00:12:57,370 --> 00:13:00,210
أقصد أنا على وشك بلوغ الهدف بوجودي

217
00:13:00,210 --> 00:13:01,960
مع عائلة ناريتا لعام واحد

218
00:13:02,440 --> 00:13:05,840
!هذا مُؤشِّر على بداية عصر جديد

219
00:13:11,130 --> 00:13:13,600
لم يكن علينا التّواجد هنا جميعاً

220
00:13:14,000 --> 00:13:15,610
إنّه في المدرسة الثّانوية بالفعل

221
00:13:15,610 --> 00:13:18,660
!سيشعر بتحسُّن إذا كنّا جميعاً هنا

222
00:13:18,660 --> 00:13:20,600
راكو-كن، أنت مسؤول عن التّصوير

223
00:13:20,600 --> 00:13:22,930
يريد والدانا رؤية ذلك أيضاً

224
00:13:22,930 --> 00:13:24,840
أجل، أجل. اعتمدي عليّ

225
00:13:24,840 --> 00:13:27,610
والآن، سنعرّف عن تلاميذنا الجدُد

226
00:13:29,550 --> 00:13:30,120
هل هو هناك؟

227
00:13:30,470 --> 00:13:31,920
!هل شو-كن هناك حقّاً؟

228
00:13:31,920 --> 00:13:33,160
اهدئي

229
00:13:36,400 --> 00:13:39,100
أعتقد بأنّه مُلفت بما أنّه طويلٌ جدّاً

230
00:13:42,410 --> 00:13:44,820
لماذا ظننتُ بأنّني أستطيع فعلها؟

231
00:13:46,090 --> 00:13:49,050
...الكثير من الغُرباء... الكثير من الخوف

232
00:13:49,570 --> 00:13:51,930
لن أتعرّف على أصدقاء أبداً هكذا

233
00:13:51,930 --> 00:13:53,330
ستكون بخير

234
00:13:53,330 --> 00:13:55,640
إنّهم بشرٌ مثلك، لا سبب يدعوك للخوف

235
00:13:55,640 --> 00:13:57,050
صحيح

236
00:13:57,050 --> 00:13:58,890
،حتّى لو لم تستطع التعرّف على أصدقاء

237
00:13:58,890 --> 00:14:01,140
هذا ليس تغيُّراً كبيراً بالنّسبة لك

238
00:14:04,390 --> 00:14:05,490
أنا آسف

239
00:14:05,490 --> 00:14:08,220
أتيتُم جميعاً إلى هنا لأجلي، بينما أتصرّف هكذا

240
00:14:08,550 --> 00:14:10,040
عمّاذا تتكلّم؟

241
00:14:10,040 --> 00:14:13,120
حضرتَ مراسم الدّخول وهذه خطوة
!هامّة بالفعل

242
00:14:13,370 --> 00:14:16,120
!انسَ الأمر ولنبذل قصارى جهدنا ثانية غداً

243
00:14:19,720 --> 00:14:20,540
حسناً

244
00:14:21,130 --> 00:14:23,270
،هذا يعني بأنّنا سنكون معاً كُلّ يوم

245
00:14:23,270 --> 00:14:24,630
في المنزل وفي المدرسة

246
00:14:24,950 --> 00:14:26,570
!أنا مُتحمّسة للغاية

247
00:14:29,930 --> 00:14:30,580
أجل

248
00:14:31,540 --> 00:14:33,250
لا تقلق يا شو-كن

249
00:14:33,250 --> 00:14:35,850
!سأكون صخر الأساس لحياتك الجديدة

250
00:14:39,390 --> 00:14:40,850
مناديل وأقمشة؟

251
00:14:40,850 --> 00:14:41,580
أجل

252
00:14:41,580 --> 00:14:42,410
غداؤك؟

253
00:14:42,410 --> 00:14:43,120
تمّ

254
00:14:43,120 --> 00:14:44,370
الدّفاتر؟ المقلمة؟

255
00:14:44,370 --> 00:14:45,150
!تمّ

256
00:14:45,380 --> 00:14:46,430
!لنذهب إذاً

257
00:14:46,430 --> 00:14:47,130
!أجل

258
00:14:47,780 --> 00:14:49,630
،سآتي لأقلك بعد دوام المدرسة ثانية

259
00:14:49,630 --> 00:14:51,090
لذا انتظرني في صفّك

260
00:14:51,090 --> 00:14:51,770
!حسناً

261
00:14:52,540 --> 00:14:54,620
أنا مُندهش من مُواظبتهم على هذا

262
00:14:54,620 --> 00:14:56,670
كان الأمر كذلك لمدّة أسبوع

263
00:14:56,670 --> 00:14:58,670
يجب لأحد أن يقول شيئاً

264
00:14:58,670 --> 00:15:01,190
إنّها تُعامله كتلميذ مدرسة ابتدائيّة

265
00:15:01,190 --> 00:15:02,630
لا بأس في ذلك، صحيح؟

266
00:15:03,160 --> 00:15:05,420
،تمكّنَ من الدّوام في المدرسة كُلّ يوم

267
00:15:05,420 --> 00:15:07,630
وكلاكما تعلمان بأنّ الفضل يعزو لها

268
00:15:07,630 --> 00:15:08,870
أتغار؟

269
00:15:09,850 --> 00:15:11,900
هل أصابتك الغيرة أخيراً؟

270
00:15:11,900 --> 00:15:15,720
أقصد بأنّ هذا هو السّبب الّذي جعلها
لا تلتفت إليك كثيراً مُؤخّراً

271
00:15:15,720 --> 00:15:17,040
هذه ليست نظرة جيّدة

272
00:15:17,040 --> 00:15:20,360
من السيّئ التصرُّف بطريقة التملُّك
بعد أن رفضتَها

273
00:15:20,360 --> 00:15:21,210
!اصمت

274
00:15:21,210 --> 00:15:22,150
!أنتما

275
00:15:22,520 --> 00:15:25,800
احترما عمريكما وكفّا عن الشِّجار
!في هذا الوقت الباكر صباحاً

276
00:15:25,800 --> 00:15:27,770
سنكون أضحوكة الحيّ

277
00:15:29,220 --> 00:15:32,980
وكأنّه أصبح ناضجاً جدّاً حالما
...بلغَ الصّفّ الرّابع

278
00:15:33,530 --> 00:15:35,490
إنّه مُجرّد مُدّعٍ

279
00:15:41,000 --> 00:15:42,450
إيتو-بيبّي

280
00:15:42,450 --> 00:15:44,250
أتريدين أن نُقيم مجموعة دراسيّة اليوم؟

281
00:15:44,250 --> 00:15:45,410
يمكننا فعلها في منزلي

282
00:15:45,410 --> 00:15:47,010
!لدينا أكلات خفيفة

283
00:15:47,010 --> 00:15:48,550
!آسفة، أنا مشغولة

284
00:15:50,050 --> 00:15:50,700
مؤلم

285
00:15:50,700 --> 00:15:51,650
—آسفة

286
00:15:54,250 --> 00:15:55,050
لا يهمّ

287
00:15:59,810 --> 00:16:01,230
!أنت تفعل هذا عمداً

288
00:16:01,230 --> 00:16:03,600
أجل، هذه عبارتي أنا

289
00:16:03,830 --> 00:16:05,200
ابتعد عن طريقي

290
00:16:05,200 --> 00:16:06,770
شو-كن ينتظرني

291
00:16:06,770 --> 00:16:08,730
على الأقلّ دعيه يعود إلى المنزل بنفسه

292
00:16:09,060 --> 00:16:11,710
لطالما أحبَّ أن يكون وحيداً على أيّ حال

293
00:16:11,710 --> 00:16:14,610
لا تأتيني باكية إذا قال بأنّكِ تُثيرين أعصابه

294
00:16:14,610 --> 00:16:16,400
!إثارة أعصابه؟

295
00:16:16,870 --> 00:16:19,220
!مُحال أن يقول ذلك

296
00:16:19,220 --> 00:16:20,370
،لمعلوماتك فقط

297
00:16:20,370 --> 00:16:24,250
قوّيتُ قلبي واقتصرتُ فقط على المشي
!معه من وإلى المدرسة

298
00:16:25,300 --> 00:16:28,320
على أيّ حال، هذا مُؤقّت فحسب

299
00:16:28,700 --> 00:16:32,490
لا أستطيع تجاهل الأمر والشّعور بالاطمئنان
حتّى يجد شو-كن

300
00:16:32,490 --> 00:16:36,290
موطِئاً حيث يستطيع الاستمتاع بحياته المدرسيّة

301
00:16:37,820 --> 00:16:40,640
هل شو هو كُلّ ما يمكنكِ التّفكير فيه مؤخّراً؟

302
00:16:41,490 --> 00:16:45,130
هل ستُناديني هنا بالأخت
المُدلِّلة من جديد؟

303
00:16:45,130 --> 00:16:47,900
!هـ-هذا صحيح يا حمقاء

304
00:16:52,170 --> 00:16:53,320
ماذا كان ذلك؟

305
00:16:53,830 --> 00:16:55,960
وكأنّه غير قلِق عليه أيضاً

306
00:16:56,810 --> 00:16:58,890
لكن أجل، فهمت

307
00:16:58,890 --> 00:17:01,950
غين غريب جدّاً في أمور كهذه

308
00:17:02,670 --> 00:17:03,500
هذا يكفي

309
00:17:03,500 --> 00:17:06,270
إن لم أتوخّ الحذر، فسأفكِّر في غين
باستمرار ثانية

310
00:17:07,040 --> 00:17:09,440
!الآن، شو-كن هو الأهمّ

311
00:17:11,310 --> 00:17:11,950
ماذا؟

312
00:17:13,430 --> 00:17:14,590
!ماذا؟ ماذا؟ ماذا؟

313
00:17:14,880 --> 00:17:16,800
هذا جيّد، أنتِ هنا

314
00:17:16,800 --> 00:17:17,560
!كوموغي-سان

315
00:17:17,560 --> 00:17:18,720
!شو-كن اختفى

316
00:17:18,720 --> 00:17:23,030
آسف، لكن من فضلكِ استخدمي اسمي
الحقيقيّ في المدرسة

317
00:17:23,030 --> 00:17:26,040
المعذرة... ذكِّرني ماذا كان؟

318
00:17:26,040 --> 00:17:27,100
!إنّه إيندو

319
00:17:27,100 --> 00:17:29,110
!لكن على أيّ حال، تعالي معي بسرعة

320
00:17:29,370 --> 00:17:31,970
!ياما... شو-كن خرج عن السّيطرة

321
00:17:33,810 --> 00:17:35,920
!من يكون هذا الشّخص

322
00:17:35,920 --> 00:17:38,620
ظننتُه كان يمزح عندما دخل

323
00:17:38,620 --> 00:17:40,230
!إنّه قويٌّ جدّاً

324
00:17:40,230 --> 00:17:41,620
!قويّ لدرجة غير معقولة

325
00:17:41,620 --> 00:17:43,850
رؤساء نادينا من ضمن أفضل 16
،على مُستوى البلد

326
00:17:43,850 --> 00:17:45,750
!ولا يملكون فُرصة أمامه

327
00:17:46,080 --> 00:17:47,810
!ما صفّه؟! ما اسمه؟

328
00:17:47,810 --> 00:17:48,950
أعرف من يكون

329
00:17:48,950 --> 00:17:51,000
إنّه ناريتا شو من الصّفّ 3-1

330
00:17:51,000 --> 00:17:52,000
!علينا تجنيده

331
00:17:52,000 --> 00:17:54,480
!ثمّ سنطمح لكسب البطولات

332
00:17:54,480 --> 00:17:57,790
!أجل، سيكون إضافة عظيمة

333
00:17:55,010 --> 00:17:56,200
مُذهل، صحيح؟

334
00:17:56,200 --> 00:17:58,680
إنّه مشهورٌ جدّاً بالفعل في مجموعتنا

335
00:17:57,790 --> 00:17:59,910
!يمكننا غزو العالم معه

336
00:17:59,020 --> 00:18:01,020
تمّ تأسيس هذا النّادي مؤخّراً فحسب

337
00:18:01,020 --> 00:18:02,740
،لكن أعتقد حقّاً بأنّه ينبغي له الانضمام

338
00:18:02,740 --> 00:18:04,520
لذا طلبتُ منه المجيء لتفقُّد ذلك

339
00:18:13,540 --> 00:18:14,890
!أ-أنا آسف جدّاً

340
00:18:14,890 --> 00:18:17,280
...كنتُ ألقي نظرة سريعة فحسب، لكن حينها

341
00:18:17,280 --> 00:18:18,810
لا عليك

342
00:18:19,280 --> 00:18:21,200
كنتُ على وشك العودة إلى
المنزل فعلاً الآن

343
00:18:21,200 --> 00:18:22,930
ماذا؟ ستعودين إلى المنزل بالفعل؟

344
00:18:22,930 --> 00:18:24,950
!لا، يجدر بك البقاء والاستمتاع

345
00:18:25,930 --> 00:18:26,910
...لكن

346
00:18:27,860 --> 00:18:29,730
ناريتا-كن، صحيح؟

347
00:18:30,680 --> 00:18:32,710
آمل أن تبقى أيضاً

348
00:18:32,710 --> 00:18:34,280
،في المرّة المُقبلة لن أتساهل معك

349
00:18:34,280 --> 00:18:36,740
لذا آمل أن تُخصّص مزيداً من الوقت

350
00:18:37,090 --> 00:18:38,220
!أجل

351
00:18:39,250 --> 00:18:40,590
!أتّفق

352
00:18:40,590 --> 00:18:43,400
!أنا أخت ناريتا شو الكُبرى

353
00:18:47,360 --> 00:18:48,180
أنا آسف

354
00:18:48,410 --> 00:18:50,080
استغرقَ ذلك وقتاً طويلاً

355
00:18:50,080 --> 00:18:51,320
!لا تقلق أبداً

356
00:18:51,320 --> 00:18:53,870
هل استمتعت بنادي الرّياضات الإلكترونيّة؟

357
00:18:53,870 --> 00:18:55,440
أقصد بأنّك ستنضمّ، صحيح؟

358
00:18:57,240 --> 00:18:57,970
أجل

359
00:18:58,300 --> 00:19:00,080
ربّما سأفعل

360
00:19:00,080 --> 00:19:01,770
كوموغي-سان هناك أيضاً

361
00:19:02,410 --> 00:19:06,450
بدأتُ أشعر وكأنّني قد أكون
بخير في ا لواقع

362
00:19:06,810 --> 00:19:09,250
،في البداية، كنتُ خائفاً للغاية

363
00:19:09,760 --> 00:19:12,170
والآن أنا مسرور لأنّني صرتُ آتي إلى المدرسة

364
00:19:13,240 --> 00:19:14,860
كُلّ الفضل يعزو لكِ

365
00:19:18,040 --> 00:19:21,930
هذا يُحزنني قليلاً لكونك نمَوت بهذه السّهولة

366
00:19:21,930 --> 00:19:23,610
يا إلهي، هل هذا سيّئ؟

367
00:19:24,030 --> 00:19:25,430
إطلاقاً

368
00:19:25,430 --> 00:19:27,850
كنتُ أفكّر بطريقة أنانيّة فحسب

369
00:19:28,190 --> 00:19:31,510
أنا مسرورةٌ حقّاً لأنّك تستمتع بوقتك

370
00:19:43,210 --> 00:19:45,210
لا يزال يبدو ملائكيّاً عندما ينام

371
00:19:46,020 --> 00:19:48,050
خفقَ قلبي فعلاً آنذاك

372
00:19:48,770 --> 00:19:52,100
أنا سعيدةٌ حقّاً لأنّه وجدَ مكانه

373
00:19:53,110 --> 00:19:57,240
لكن تفكيري بأنّ دوري هنا قد انتهى
يبعث على التّشاؤم

374
00:19:59,860 --> 00:20:05,980
كنتُ أستخدم هذا كمهرب لعدم
التّفكير في غين طوال الوقت

375
00:20:07,150 --> 00:20:08,470
أنا آسفة

376
00:20:08,850 --> 00:20:10,580
،يجب عليّ الانخراط مع نفسي بصراحة

377
00:20:11,350 --> 00:20:14,010
ومع شو-كن كذلك

378
00:20:16,570 --> 00:20:18,860
هل حدث شيء مؤخّراً؟

379
00:20:19,220 --> 00:20:21,110
ماذا؟ لماذا تسأل؟

380
00:20:22,400 --> 00:20:24,240
تبدين حزينة أحياناً

381
00:20:24,240 --> 00:20:25,740
!حقّاً؟

382
00:20:26,040 --> 00:20:26,990
أنا آسف

383
00:20:27,590 --> 00:20:30,090
،كنتُ مُنغمساً جدّاً مع نفسي

384
00:20:30,090 --> 00:20:31,910
لكن كان ذلك في ذهني طوال هذا الوقت

385
00:20:31,910 --> 00:20:33,280
...أقصد

386
00:20:33,280 --> 00:20:36,130
يجب عليّ الضّغط على نفسي من أجل
امتحانات دخول الجامعة الآن

387
00:20:36,130 --> 00:20:39,880
أقصد بأنّ كُلّ ما يمكنني فعله هو
!تجاوز ذلك، لذا لا تقلق

388
00:20:40,330 --> 00:20:44,150
بالإضافة إلى هذا، ستنشغل بشؤونك
،الخاصّة من الآن فصاعداً

389
00:20:44,150 --> 00:20:46,600
!لذا ليس عليك القلق بشأني

390
00:20:49,590 --> 00:20:50,440
...لذا أعتقد

391
00:20:52,510 --> 00:20:54,770
ما باليد حيلة حقّاً

392
00:20:56,790 --> 00:21:01,350
ألن أتمكّن من فعل شيء لكِ حقّاً؟

393
00:21:02,260 --> 00:21:03,890
أعلم بأنّني غير أهل للاعتماد

394
00:21:04,770 --> 00:21:08,280
لكن إذا كان النّاس يفعلون كُلّ
،شيء لأجلي دوماً

395
00:21:09,160 --> 00:21:11,820
فلا يمكنني القول بأنّني نضجتُ إطلاقاً

396
00:21:13,040 --> 00:21:17,970
كنتُ قادراً على الخروج من تلك
الغرفة بفضل وجودك هناك

397
00:21:17,970 --> 00:21:20,430
والآن أتمكّن من فعل كُلّ هذه الأشياء المُمتعة

398
00:21:20,900 --> 00:21:23,660
لهذا أقول ألّا تقلقي

399
00:21:23,660 --> 00:21:26,180
أنا أفعل ما أريد فعله فقط على أيّ حال

400
00:21:26,670 --> 00:21:30,530
بصراحة، لا يزال هناك الكثير لتعلّمه
عن التصرُّف كأخت كُبرى

401
00:21:30,530 --> 00:21:33,270
دائماً ما أستعجل الأمور وأخطئ
...وأتلقّى التّوبيخ

402
00:21:32,570 --> 00:21:33,910
!هذا غير صحيح على الإطلاق

403
00:21:34,930 --> 00:21:39,250
من المُثير للإعجاب حقّاً أن تُفكّري
،فينا جميعاً دوماً

404
00:21:39,860 --> 00:21:43,480
وبأن تتمكّني من إعداد طعام
،شهيّ كُلّ يوم

405
00:21:43,480 --> 00:21:45,450
وألّا تُفوّتي أيّ يوم مدرسيّ

406
00:21:45,770 --> 00:21:49,830
من الرّائع حقّاً أيضاً أن تتمكّني من التعرُّف
فوراً على مجموعة جديدة من الأصدقاء

407
00:21:50,820 --> 00:21:54,420
وددتُ لو أقول بأنّكِ أفضل
من أن تكوني أختي الكُبرى

408
00:21:57,010 --> 00:22:00,490
لذا سأصبح أقوى

409
00:22:01,880 --> 00:22:04,190
وذلك كي أتمكّن من حمايتكِ في المرّة المُقبلة

410
00:22:05,720 --> 00:22:10,220
مُحال أن أسامح شخصاً يتسبّب بِبُكائكِ

411
00:22:14,970 --> 00:22:16,090
!شكراً لك