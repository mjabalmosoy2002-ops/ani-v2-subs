1
00:01:36,970 --> 00:01:38,100
كيف حاله؟

2
00:01:38,940 --> 00:01:41,540
عالجتُ الجراح الّتي تدمّرت بها الخلايا

3
00:01:41,600 --> 00:01:43,700
.وجهّزتُه بالأطراف الاصطناعيّة

4
00:01:44,340 --> 00:01:46,600
—بقي فقط أن نصنع الأطراف الاصطناعيّة المخصّصة

5
00:01:46,670 --> 00:01:48,270
...بشأن ذلك

6
00:01:49,370 --> 00:01:54,570
.قيل أنّ الكارا تملك التّكنولوجيا لإصلاح جسد كاواكي

7
00:01:54,840 --> 00:01:55,940
أهناك ما تستطيع فعله؟

8
00:01:56,740 --> 00:02:00,740
.مع الأسف، ذلك مستحيل بمستوى تقنيّاتنا الحاليّ

9
00:02:01,370 --> 00:02:04,300
.أفضل ما يمكننا فعله هو إنشاء طرف اصطناعيّ متقدّم

10
00:02:04,800 --> 00:02:09,200
.وحتّى ذلك سيستغرق بعض الوقت

11
00:02:10,770 --> 00:02:12,970
إذًا، سيظلّ دون ذراع يمنى حتّى حين؟

12
00:02:13,170 --> 00:02:14,300
!هذا صعب

13
00:02:14,900 --> 00:02:18,170
لديك العديد من النّماذج الأوّليّة الّتي صنعت لي، أليس كذلك؟

14
00:02:18,740 --> 00:02:20,900
ألا يمكنه استخدام إحداها في الوقت الرّاهن؟

15
00:02:21,300 --> 00:02:22,670
.ذلك مستحيل أيضًا

16
00:02:23,140 --> 00:02:27,870
كلّ الأطراف الاصطناعيّة الّتي طوّرت
.صُنعت بغرض التّفاعل مع تشاكرا المستخدم

17
00:02:28,440 --> 00:02:32,840
لن يعمل طرف اصطناعيّ صُنع من
.أجلك دون التشّاكرا خاصّتك أيّها السّابع

18
00:02:33,470 --> 00:02:34,840
...فهمت

19
00:02:35,840 --> 00:02:37,140
التشّاكرا خاصّتي؟

20
00:02:38,200 --> 00:02:41,770
حسنًا! هلّا أحضرت إحدى تلك النّماذج الّتي صنعت لي؟

21
00:02:41,900 --> 00:02:43,970
!—ماذا؟ لكنّ ذلك

22
00:02:45,240 --> 00:02:47,170
!أعلم، افعل فحسب رجاءً! أسرع

23
00:02:47,570 --> 00:02:49,170
...حسنًا

24
00:02:53,100 --> 00:02:54,840
ماذا ستفعل؟

25
00:02:55,140 --> 00:02:59,740
كما أسلفت، لن يعمل الطّرف الاصطناعيّ
.دون التشّاكرا خاصّتك أيّها السّابع

26
00:03:00,840 --> 00:03:02,170
.أدري ذلك

27
00:03:22,500 --> 00:03:23,600
!مذهل

28
00:03:23,670 --> 00:03:27,400
!إنّك تشارك التشّاكرا خاصّتك لربط الذّراع بالقوّة

29
00:03:27,900 --> 00:03:30,070
.لم أفكّر في ذلك حتّى

30
00:03:30,340 --> 00:03:31,770
كاواكي، كيف هي؟

31
00:03:35,070 --> 00:03:36,600
...ألا يعني هذا

32
00:03:36,670 --> 00:03:39,740
أنّ عليك شحنها بالتشّاكرا خاصّتك على مدار السّاعة؟

33
00:03:40,470 --> 00:03:41,740
أليس في ذلك عمل كبير؟

34
00:03:42,140 --> 00:03:45,640
.ذلك ليس أصعب من الحفاظ على نسخة ظلّ

35
00:03:46,300 --> 00:03:50,070
.وبالطّبع، يعني هذا أيضًا أنّها لن تعمل أثناء نومي

36
00:03:51,400 --> 00:03:53,840
ألا بأس بهذا؟

37
00:03:54,170 --> 00:03:55,640
.لا تقلق بشأن ذلك

38
00:03:56,100 --> 00:04:00,740
.كما أخبرتك سابقًا، التشّاكرا قوّة ملزمة

39
00:04:01,200 --> 00:04:03,370
وهذا خير مثال، صحيح؟

40
00:04:05,870 --> 00:04:06,840
...لا بدّ وأن أقرّ

41
00:04:07,200 --> 00:04:10,400
.تبدو رائعًا للغاية بتلك الذّراع

42
00:04:10,700 --> 00:04:12,400
.أشعر بالغيرة نوعًا ما

43
00:04:13,240 --> 00:04:14,370
!أيّها الشّقيّ

44
00:04:14,640 --> 00:04:16,940
أتريدني أن أدمّر يدك اليمنى أيضًا؟

45
00:04:17,340 --> 00:04:20,540
.إن حالفك الحظّ، قد يتخلّص ذلك من الوتد خاصّتك أيضًا

46
00:04:21,100 --> 00:04:22,740
!توقّف أيّها النّذل

47
00:04:22,800 --> 00:04:24,540
!لا تبدو كمزحة عندما تقولها أنت

48
00:04:27,200 --> 00:04:29,540
...سحقًا. لا تخفني هكذا

49
00:04:30,140 --> 00:04:32,270
...بالمناسبة. بشأن التشّاكرا

50
00:04:32,840 --> 00:04:34,370
هل لديّ تشاكرا أيضًا؟

51
00:04:35,570 --> 00:04:39,270
.أجل. تتواجد فيك أيضًا

52
00:04:54,770 --> 00:04:56,300
.لا أرى أيّ شيء غريب

53
00:04:57,000 --> 00:04:57,800
!شكرًا على وقتك

54
00:05:03,370 --> 00:05:06,570
هل من داعٍ حقًّا لإجراء الصّيانة على جسدي؟

55
00:05:07,000 --> 00:05:08,170
.لا تشتكِ

56
00:05:08,500 --> 00:05:10,800
!—إن حدث أيّ شيء، سأُحمّل مسؤوليّة

57
00:05:15,700 --> 00:05:16,640
.لقد عادت

58
00:05:55,700 --> 00:05:57,000
!سحقًا لذلك الشّقيّ

59
00:05:57,400 --> 00:06:00,270
!ستدفع ثمن هذا يا أوزوماكي ناروتو

60
00:06:02,900 --> 00:06:04,240
!ديلتا

61
00:06:04,570 --> 00:06:06,800
!كفّي عن تدمير الغطاء كلّ ما خرجت

62
00:06:06,900 --> 00:06:07,900
!اخرس

63
00:06:08,370 --> 00:06:11,070
!واجبي أن أدمّر الأشياء، مهما كانت

64
00:06:11,600 --> 00:06:13,300
،إن كان لديك الوقت للشّكوى

65
00:06:13,370 --> 00:06:15,340
!لمَ لا تخصّصه للقيام بواجبك أيّها العجوز؟

66
00:06:17,170 --> 00:06:18,040
.سحقًا

67
00:06:18,100 --> 00:06:20,100
.لديها قم متحاذق

68
00:06:23,600 --> 00:06:25,500
!كلّ فرد منهم

69
00:06:27,070 --> 00:06:28,700
!يا ديلتا

70
00:06:28,870 --> 00:06:31,340
.يبدو أنّك تعرّضت لضرب مبرح

71
00:06:39,400 --> 00:06:42,340
.لا أمانع مساعدتك إن أتيت وبكيت على كتفي

72
00:06:42,470 --> 00:06:43,540
.سحقًا

73
00:06:43,800 --> 00:06:45,970
!سأقتل الهوكاغي

74
00:06:46,540 --> 00:06:47,800
الهوكاغي؟

75
00:06:48,240 --> 00:06:51,040
ألا يفترض أنّك ذهبت إلى قرية الورق لاسترداد الوعاء؟

76
00:06:53,370 --> 00:06:54,700
ماذا حدث؟

77
00:06:58,500 --> 00:07:00,270
أخفقت بشدّة إذًا؟

78
00:07:00,700 --> 00:07:01,900
!إنّها غلطة كاواكي

79
00:07:02,240 --> 00:07:04,900
.قرّر أن يحمي ابنة الهوكاغي

80
00:07:05,170 --> 00:07:06,200
كاواكي فعل ذلك؟

81
00:07:06,570 --> 00:07:08,640
لمَ عساي يحمي ابنة الهوكاغي؟

82
00:07:08,740 --> 00:07:10,270
!لا أملك أدنى فكرة

83
00:07:10,900 --> 00:07:14,540
.يبدو أنّ كاواكي يتفاهم جيّدًا مع الهوكاغي

84
00:07:14,800 --> 00:07:16,070
،لا يهمّ

85
00:07:16,140 --> 00:07:18,340
.لكن أظنّ أنّ الخيار الوحيد هو أن أذهب لقرية الورق

86
00:07:18,670 --> 00:07:21,840
.بما أنّك لم تستطيعي التّعامل معه، فأظنّ دوري قد حان

87
00:07:22,070 --> 00:07:24,170
.لا تنجرف في حماسك يا كود

88
00:07:24,540 --> 00:07:27,570
.لا أمانع قتلك قبل أن آخذ حياة الهوكاغي

89
00:07:27,670 --> 00:07:29,800
.يكفي يا ديلتا

90
00:07:30,900 --> 00:07:32,200
.يا لها من فوضى

91
00:07:33,300 --> 00:07:38,040
يفترض أنّني أخبرتك أن تتّبعي
.أوامر كاشين كوجي في هذه المهمّة

92
00:07:38,800 --> 00:07:40,070
أين هو؟

93
00:07:41,240 --> 00:07:43,700
.إنّه متخفّي في قرية الورق

94
00:07:43,940 --> 00:07:46,170
.لا بدّ أنّه ما زال يراقب كاواكي

95
00:07:46,540 --> 00:07:51,270
ألم تقتض المهمّة باسترجاعه قبل أن تصل له قرية الورق؟

96
00:07:51,640 --> 00:07:53,640
!ما الّذي يفعله كوجي؟

97
00:07:54,170 --> 00:07:56,740
.كانت تلك نيّتي بطبيعة الحال

98
00:07:57,170 --> 00:08:01,270
.كنتُ سأقتلهم وأستعيد كاواكي قبل أن يأخذوه

99
00:08:02,700 --> 00:08:04,840
!لكنّ كوجي أوقفني

100
00:08:05,200 --> 00:08:08,400
.قال أنّه يريد تركه من أجل جمع المزيد من المعلومات

101
00:08:09,240 --> 00:08:10,170
معلومات؟

102
00:08:10,740 --> 00:08:11,800
.الوتد

103
00:08:12,200 --> 00:08:15,370
.ثمّة شخص عداك وكاواكي يملكه

104
00:08:15,870 --> 00:08:16,700
ماذا؟

105
00:08:17,070 --> 00:08:18,200
!الوتد؟

106
00:08:18,770 --> 00:08:21,740
،بعد موت موموشيكي، تفقّدنا الهوكاغي

107
00:08:21,800 --> 00:08:24,240
.لكن لم يبدُ أنّه يملك الوتد

108
00:08:24,800 --> 00:08:26,700
!هل يمكن أن يكون أوتشيها ساسكي؟

109
00:08:27,240 --> 00:08:28,140
.لا

110
00:08:28,200 --> 00:08:30,570
.بل ابن الهوكاغي، أوزوماكي بوروتو

111
00:08:30,900 --> 00:08:32,000
بوروتو؟

112
00:08:32,800 --> 00:08:34,240
هل أنت واثقة من ذلك؟

113
00:08:34,570 --> 00:08:35,940
.لا شكّ في ذلك

114
00:08:37,140 --> 00:08:38,970
.أوزوماكي بوروتو

115
00:08:39,770 --> 00:08:40,970
.ابن الهوكاغي

116
00:08:41,870 --> 00:08:47,970
.رأيت قوّة كاواكي وبوروتو تتعزّز عندما تجاوب وتداهما

117
00:08:48,500 --> 00:08:51,240
.لا مجال للشّكّ. إنّه الوتد الحقيقيّ

118
00:08:55,500 --> 00:08:57,870
.هذه أخبار غير متوقّعة

119
00:08:58,370 --> 00:08:59,740
.يا لموموشيكي اللّعين ذاك

120
00:08:59,800 --> 00:09:03,400
...تمكّنت من ترك وعائك الخاصّ من خلفك

121
00:09:03,470 --> 00:09:05,470
.قبل أن تموت

122
00:09:09,140 --> 00:09:10,870
!أخبرتك أنّ هذا سيحدث

123
00:09:11,000 --> 00:09:15,340
وأنّك إن تركت كاواكي في القرية، سيأتي
.أولئك الأشخاص من الكارا لاسترجاعه

124
00:09:15,740 --> 00:09:18,770
هل نويت أن تضع الجميع في القرية في خطر أكبر؟

125
00:09:19,200 --> 00:09:21,540
،قد يكون ذلك صحيحًا

126
00:09:21,870 --> 00:09:24,370
لكنّ الكارا تخطّط لشيء بلا شكّ

127
00:09:24,440 --> 00:09:27,600
.عن طريق إرغام دور ما يدعونه بالوعاء على كاواكي

128
00:09:28,040 --> 00:09:31,370
.حدسي يخبرني أنّنا لا يجب أن نسلّمه لهم

129
00:09:31,940 --> 00:09:33,940
.ناروتو محقّ

130
00:09:34,500 --> 00:09:37,470
.لديهم تقنيّات تفوق تقنيّات قرية الورق

131
00:09:38,100 --> 00:09:42,470
.وإحباط خطّتهم سيحافظ على أمن القرية

132
00:09:43,300 --> 00:09:45,900
أظنّنا يجب أن نراقبه أكثر

133
00:09:45,970 --> 00:09:48,270
.إلى أن نعرف بشأن ظروفه

134
00:09:49,200 --> 00:09:51,270
.سحقًا. حسنًا

135
00:09:51,570 --> 00:09:53,740
.لكنّي سأوكّل أمنًا عليه

136
00:09:53,800 --> 00:09:54,740
!شيكامارو

137
00:09:54,800 --> 00:09:55,770
.انتظر

138
00:09:56,170 --> 00:09:57,500
.هذا غير قابل للنّقاش

139
00:09:57,670 --> 00:10:00,140
.هذا هو الشّرط الوحيد الّذي لن أتراجع عنه

140
00:10:03,200 --> 00:10:05,440
أيمكنني الاعتماد عليك إذًا يا كونوهامارو؟

141
00:10:06,000 --> 00:10:06,940
.بالطّبع

142
00:10:07,500 --> 00:10:08,700
.آسف

143
00:10:08,770 --> 00:10:11,240
.أعلم أنّك ما زلت تتعامل مع ما حدث لموغينو

144
00:10:11,900 --> 00:10:12,800
.لا بأس

145
00:10:12,870 --> 00:10:14,870
.انتهيت من ترتيب أموره

146
00:10:15,540 --> 00:10:18,040
.وارتأيت أنّ الوقت حان لأعود إلى العمل

147
00:10:18,900 --> 00:10:20,900
.وأيضًا، بشأن كاواكي

148
00:10:22,540 --> 00:10:23,270
!حاضر

149
00:10:23,870 --> 00:10:26,270
.لستُ متساهلًا كالسّابع

150
00:10:26,700 --> 00:10:29,140
.إن لاحظت أيّ شيء، أبلغني على الفور

151
00:10:29,740 --> 00:10:31,100
.أشعر مثلك

152
00:10:31,770 --> 00:10:35,840
.ربّما بدأ أولئك الأشخاص من الكارا خطوتهم بالفعل

153
00:10:36,300 --> 00:10:37,740
.اعمل بهذا الافتراض

154
00:10:38,440 --> 00:10:39,100
.سأفعل

155
00:10:39,240 --> 00:10:41,840
.لا أريد المزيد من الخسائر

156
00:11:12,000 --> 00:11:12,830
...أخبرني

157
00:11:14,100 --> 00:11:15,830
لمَ تتمادى إلى هذا الحدّ من أجلي؟

158
00:11:16,200 --> 00:11:18,400
ماذا؟ عمّاذا تتحدّث؟

159
00:11:19,000 --> 00:11:20,260
.هذه الذّراع

160
00:11:20,800 --> 00:11:23,230
،لا أفهم كيف تعمل التشّاكرا تمامًا

161
00:11:23,500 --> 00:11:26,130
لكن ألن ينال منك الإرهاق بسببي؟

162
00:11:26,630 --> 00:11:29,000
.لا تقلق بشأن أشياء مملّة كهذه

163
00:11:29,160 --> 00:11:33,460
.أخذت على نفسك عناء حمايتي وهيماواري في النّهاية

164
00:11:34,030 --> 00:11:36,930
.توفير التشّاكرا لذراعك بالكاد تعوّض عن ذلك

165
00:11:37,800 --> 00:11:39,860
.هذا خطئي من الأساس

166
00:11:40,600 --> 00:11:42,660
.هاجمت الكارا بسبب وجودي هنا

167
00:11:43,130 --> 00:11:45,130
.أنت من حماني

168
00:11:46,060 --> 00:11:47,000
...كاواكي

169
00:11:47,400 --> 00:11:49,000
...أنت

170
00:11:50,800 --> 00:11:52,930
.تذكّرني بنفسي عندما كنتُ صغيرًا نوعًا ما

171
00:11:53,360 --> 00:11:55,530
.لذا، لا أستطيع تركك لوحدك

172
00:11:56,430 --> 00:11:57,330
...أبي

173
00:11:57,860 --> 00:12:00,930
.أنت محظوظ لأنّك كبرت وصرت الهوكاغي

174
00:12:01,000 --> 00:12:02,300
فكيف نحن متشابهان؟

175
00:12:02,960 --> 00:12:04,060
.لا أصدّقك

176
00:12:05,600 --> 00:12:06,530
...لكن

177
00:12:07,800 --> 00:12:10,230
...لا أريد أن أتسبّب بالمزيد من المشاكل

178
00:12:10,760 --> 00:12:11,730
...بشأن ذلك

179
00:12:13,000 --> 00:12:16,060
هلّا علّمتني كيف أستخدم النّينجيتسو؟

180
00:12:18,730 --> 00:12:21,130
.أكيد! لكنّ الأمر ليس سهلًا

181
00:12:21,430 --> 00:12:22,960
فهل أنت واثق؟

182
00:12:25,130 --> 00:12:25,960
!حسنًا

183
00:12:26,130 --> 00:12:28,760
.إذًا اعتبارًا من اليوم، أنت تلميذي

184
00:12:30,130 --> 00:12:31,930
!هل تريد أن تصبح نينجا؟

185
00:12:32,000 --> 00:12:34,400
!لن أخسر أمامك يا كاواكي

186
00:12:34,800 --> 00:12:36,000
...اخرس

187
00:12:36,560 --> 00:12:38,360
.أردّ لك نفس الكلام يا بوروتو

188
00:13:06,760 --> 00:13:09,360
.قوّة الوتد مذهلة بكلّ تأكيد

189
00:13:09,960 --> 00:13:11,060
.أجل

190
00:13:17,900 --> 00:13:21,830
اسمع، لا تعتمد على أدوات
.النّينجا العلميّة أو قوّة الوتد خاصّتك

191
00:13:22,200 --> 00:13:23,600
.استخدم التشّاكرا خاصّتك

192
00:13:38,360 --> 00:13:40,500
!هذا سهل

193
00:13:52,800 --> 00:13:53,960
!عجبًا

194
00:13:54,030 --> 00:13:56,200
!هذا خطير! أنت سيّئ

195
00:13:56,600 --> 00:13:57,830
استخدمت الوتد خاصّتك، صحيح؟

196
00:13:58,500 --> 00:14:00,500
أصبت الهدف، أليس كذلك؟

197
00:14:00,800 --> 00:14:01,960
هل لديك مشكلة؟

198
00:14:02,030 --> 00:14:03,800
!أليس هذا تدريب النّينجيتسو؟

199
00:14:03,860 --> 00:14:05,300
!استخدم التشّاكرا خاصّتك

200
00:14:05,760 --> 00:14:09,260
لكن ألا تُستخدم التشّاكرا للحصول على القوّة؟

201
00:14:09,530 --> 00:14:12,300
.التشّاكرا ليست أداة للحصول على القوّة

202
00:14:13,300 --> 00:14:14,560
أتذكر ما قلت؟

203
00:14:14,760 --> 00:14:18,130
.الشّيء المذهل في التشّاكرا هي قوّتها على صنع الصّلات

204
00:14:19,830 --> 00:14:21,200
.لا أفهم ما يعنيه ذلك

205
00:14:21,860 --> 00:14:24,830
.إنّ التشّاكرا تصلك بالغير

206
00:14:25,230 --> 00:14:27,430
.ستفهم يومًا ما يا كاواكي

207
00:14:27,760 --> 00:14:30,500
.فور أن تكوّن رابطًا عاطفيًّا مع أحدهم

208
00:14:39,330 --> 00:14:40,930
.ينبغي بهذا المكان أن يكون جيّدًا

209
00:14:46,160 --> 00:14:48,760
بابا، هل سنتدرّب هنا؟

210
00:14:49,200 --> 00:14:50,360
.هذا صحيح

211
00:14:50,760 --> 00:14:51,860
...لكن قبل ذلك

212
00:14:51,930 --> 00:14:55,200
ما زلت لم أرك القوّة الحقيقيّة لهذه التّقنيّة، أليس كذلك؟

213
00:14:56,060 --> 00:14:57,600
قوّتها الحقيقيّة؟

214
00:14:57,730 --> 00:15:00,030
يعتمد إتقان التشّيدوري كثيرًا على سرعة ضربتك

215
00:15:02,160 --> 00:15:05,330
إنّ مزيج تركيز التشّاكرا خاصّتك على نقطة واحدة

216
00:15:06,230 --> 00:15:08,800
وسرعة ضربتك يخلقان صوتًا فريدًا

217
00:15:08,860 --> 00:15:10,630
.يشبه صوت ألف طير

218
00:15:11,500 --> 00:15:13,700
...ولهذا هذه التّقنية تدعى

219
00:15:16,060 --> 00:15:17,200
!بالتشّيدوري

220
00:15:38,700 --> 00:15:41,200
...تلك هي قوّة التشّيدوري

221
00:15:42,500 --> 00:15:45,830
.مرّر كاكاشي هذه التّقنية لي

222
00:15:46,560 --> 00:15:47,800
السّادس؟

223
00:15:48,230 --> 00:15:49,330
.هذا صحيح

224
00:15:55,700 --> 00:15:57,960
وعاء آخر إذًا؟

225
00:15:58,030 --> 00:16:00,430
.يبدو أنّ الأمور ستصبح حافلة

226
00:16:01,900 --> 00:16:04,260
كيف سارت صيانة بورو؟

227
00:16:05,500 --> 00:16:08,060
.سيستغرق الأمر بعض الوقت لأحصل على النّتائج

228
00:16:09,730 --> 00:16:12,200
.أظنّ أنّ هذا يعني أنّك ما زلت لا تعرف من يكون الخائن

229
00:16:12,460 --> 00:16:14,030
الخائن؟

230
00:16:14,560 --> 00:16:16,700
هل شككت بي؟

231
00:16:17,030 --> 00:16:20,000
هل أهدرت وقتي بحجّة "الصّيانة"؟

232
00:16:21,130 --> 00:16:23,700
.أنا مهتمّ بالوعاء دون سواه

233
00:16:24,030 --> 00:16:26,600
.لا أملك أيّ سبب لخيانة جيغن

234
00:16:26,860 --> 00:16:28,200
!أعلم

235
00:16:28,260 --> 00:16:31,200
.لكنّك لم تكن المشتبه الوحيد

236
00:16:31,430 --> 00:16:33,300
...لكن في حال

237
00:16:33,430 --> 00:16:35,530
،أنّنا لم نكشف الخائن

238
00:16:35,600 --> 00:16:39,200
.بإمكاننا قتل الجميع وتشكيل مجموعة جديدة من الدّاخليّين

239
00:16:39,260 --> 00:16:41,900
.ثمّة الكثير من النّاس الّذين يستوفون الشّروط

240
00:16:55,230 --> 00:16:55,800
!أنت

241
00:16:57,700 --> 00:16:59,330
!كان ذلك هجومًا جيّدًا

242
00:17:09,800 --> 00:17:11,200
!تشيدوري

243
00:17:20,000 --> 00:17:22,300
!لا فائدة. لا أملك قوّة كافية

244
00:17:22,800 --> 00:17:25,800
،بما أنّك تملكين الآن توموي اثنين في عينيك

245
00:17:25,860 --> 00:17:27,960
.فيمكنك تعلّم التشّيدوري

246
00:17:28,660 --> 00:17:31,460
لكنّ هذه التّقنيّة تتطلّب منك قراءة تحرّكات الخصم

247
00:17:31,530 --> 00:17:33,060
...والضّرب من مسافة قريبة

248
00:17:33,600 --> 00:17:36,260
.قد تتضرّرين بشكل جسيم إن استطاع خصمك ردّها

249
00:17:36,330 --> 00:17:37,600
.إنّها سيف ذو حدّين

250
00:17:38,100 --> 00:17:41,330
.عليك إلحاق الضّرر بخصمك بهجمة واحدة

251
00:17:47,230 --> 00:17:48,100
!أجل

252
00:17:55,500 --> 00:17:56,630
هل حدث شيء؟

253
00:17:57,360 --> 00:17:58,860
.استدعاني ساي

254
00:17:59,930 --> 00:18:02,700
.إنّها مهمّة أنا فقط أستطيع التّعامل معها

255
00:18:03,260 --> 00:18:05,330
.عليّ العودة لمكاتب الهوكاغي الآن

256
00:18:06,200 --> 00:18:07,530
.آسف يا سارادا

257
00:18:09,060 --> 00:18:11,160
.سأكون بخير لوحدي

258
00:18:11,460 --> 00:18:12,360
.حسنًا

259
00:18:22,000 --> 00:18:24,730
!عجبًا! لديهم بطاقات جديدة

260
00:18:26,160 --> 00:18:27,200
بطاقات؟

261
00:18:27,600 --> 00:18:29,960
.تمّ وضع شينوبي من التّاريخ بأكمله في بطاقات

262
00:18:30,630 --> 00:18:32,330
.إنّها تحظى بشعبيّة كبيرة في القرية

263
00:18:33,500 --> 00:18:34,630
.يا للغباء

264
00:18:36,760 --> 00:18:40,430
.أتساءل إن كان بوروتو والبقيّة يتدرّبون بجدّ الآن

265
00:18:42,130 --> 00:18:44,330
.حدسي يخبرني أنّها هذه

266
00:18:43,420 --> 00:18:43,850
ماذا؟

267
00:18:45,430 --> 00:18:46,760
بوروتو؟

268
00:18:47,330 --> 00:18:48,560
!سارادا

269
00:18:49,330 --> 00:18:50,730
سارادا، هل أتيت من أجل البطاقات أيضًا؟

270
00:18:50,800 --> 00:18:52,330
...لا، أنا

271
00:18:52,900 --> 00:18:54,800
.أظنّني أثنيت عليهم أكثر من اللّازم

272
00:18:55,130 --> 00:18:57,730
!أرجو أن أحصل على أيّ أحد عدا أبي

273
00:19:01,560 --> 00:19:03,260
!يا عمّة! أريد حزمتين من البطاقات

274
00:19:06,530 --> 00:19:08,230
لا تملك أيّ مال، صحيح؟

275
00:19:08,730 --> 00:19:11,030
...كنتُ أوفّر من مكافآت مهامّي

276
00:19:11,230 --> 00:19:12,500
.اختر واحدة

277
00:19:12,860 --> 00:19:14,360
.يا للغباء

278
00:19:17,600 --> 00:19:19,630
!إنّه الرّابع

279
00:19:19,730 --> 00:19:22,930
!حصلت على بطاقة فائقة النّدرة من أوّل اختيار؟

280
00:19:24,160 --> 00:19:26,060
.لهذا المبتدئون مخيفون جدًّا

281
00:19:26,800 --> 00:19:28,400
أنت محظوظ حقًّا، أليس كذلك؟

282
00:19:28,730 --> 00:19:31,530
الرّابع... أهذا الشّخص هوكاغي أيضًا؟

283
00:19:31,960 --> 00:19:35,100
اسمع، هلّا امتنعت عن الإشارة له بـ"هذا الشخص"؟

284
00:19:35,330 --> 00:19:38,160
.إنّه ناميكازي ميناتو-ساما، الهوكاغي الرّابع

285
00:19:38,500 --> 00:19:41,300
—إنّه جدّ بوروتو، لذا هو والد السّا

286
00:19:41,360 --> 00:19:42,460
!سحقًا

287
00:19:43,660 --> 00:19:45,300
!ليس ثانيةً

288
00:19:46,560 --> 00:19:49,200
.أظنّني يجب أن أتخلّى عن البطاقات حقًّا

289
00:19:49,400 --> 00:19:51,230
.أرى أنّك ملعون بالسّابع ثانيةً

290
00:19:51,730 --> 00:19:54,100
!تبًّا

291
00:19:56,760 --> 00:19:57,600
.اسمع

292
00:19:58,100 --> 00:19:59,000
ماذا؟

293
00:19:59,600 --> 00:20:00,560
.لنتبادل

294
00:20:00,960 --> 00:20:02,460
ماذا؟ هل أنت واثق؟

295
00:20:03,000 --> 00:20:04,230
.لا أمانع

296
00:20:04,430 --> 00:20:06,360
.لا أعلم أيّ شيء عن الرّابع على أيّ حال

297
00:20:07,060 --> 00:20:08,300
!أجل

298
00:20:08,360 --> 00:20:12,530
!هذه أوّل مرّة أحصل على بطاقة هوكاغي عدا أبي

299
00:20:12,760 --> 00:20:14,630
هل أنت واثق من ذلك؟

300
00:20:12,760 --> 00:20:14,630
!أوّل مرّة على الإطلاق

301
00:20:14,730 --> 00:20:18,500
.قيمة الشّيء في عين مالكه

302
00:20:16,600 --> 00:20:18,500
!أجل

303
00:20:18,660 --> 00:20:20,900
الهوكاغي السّابع إذًا؟

304
00:20:21,500 --> 00:20:22,660
!كاواكي

305
00:20:22,730 --> 00:20:24,000
!شكرًا لك

306
00:20:26,060 --> 00:20:29,060
.إنّ التشّاكرا تصلك بالغير

307
00:20:29,400 --> 00:20:31,560
.ستفهم يومًا ما يا كاواكي

308
00:20:32,030 --> 00:20:34,730
.فور أن تكوّن رابطًا عاطفيًّا مع أحدهم

309
00:20:42,660 --> 00:20:43,730
.شقيّ غبيّ

310
00:20:44,930 --> 00:20:46,130
!ماذا؟

311
00:20:46,400 --> 00:20:47,900
!ما مشكلتك بالضّبط؟

312
00:20:47,930 --> 00:20:50,630
!لن تكسب أيّ أصدقاء أبدًا بذلك السّلوك

313
00:20:50,800 --> 00:20:53,000
!أنت فاسد! أتدري؟

314
00:21:14,560 --> 00:21:16,400
.أفتقد إلى قطعة

315
00:21:19,260 --> 00:21:21,100
.لا يوجد أيّ شيء في الحقيبة

316
00:21:22,560 --> 00:21:23,960
أما زال في الخارج؟

317
00:21:30,530 --> 00:21:32,000
!يا فتى

318
00:21:42,160 --> 00:21:43,160
!ما الّذي—؟

319
00:21:43,600 --> 00:21:45,630
!من هناك؟

320
00:21:46,460 --> 00:21:47,760
.اجلس

321
00:21:48,030 --> 00:21:51,200
...لا تفارق جانب ناروتو دون إذن

322
00:23:25,450 --> 00:23:28,010
.لا أصدّق أنّ لديه وحشًا كهذا في داخله

323
00:23:28,380 --> 00:23:30,610
.لا عجب أنّ الهوكاغي قويّ

324
00:23:30,710 --> 00:23:32,610
.لا تخف هكذا

325
00:23:33,250 --> 00:23:35,610
.أنصت لما سأقول فحسب

326
00:23:36,180 --> 00:23:39,850
.بمراقبتي لك، أنت تشبه ناروتو كثيرًا

327
00:23:40,280 --> 00:23:43,210
.ما يجعلني أريد أن أتحدّث معك نوعًا ما

328
00:23:43,880 --> 00:23:47,350
:في الحلقة القادمة

329
00:23:47,580 --> 00:23:48,680
"دموع فارغة"

330
00:23:49,610 --> 00:23:51,950
أنا أشبه الهوكاغي كثيرًا؟