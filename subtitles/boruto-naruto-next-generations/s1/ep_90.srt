1
00:00:04,020 --> 00:00:08,720
أرض

2
00:00:17,420 --> 00:00:19,460
!ستدفع ثمن هذا يا ميتسكي

3
00:00:23,490 --> 00:00:25,020
!كو-ساما
!توقف رجاءً

4
00:00:25,290 --> 00:00:26,290
!ابتعدي عن طريقي

5
00:00:26,420 --> 00:00:28,020
،تحتاج إلى العناية الطبيّة الآن
!—وإلّا

6
00:00:34,060 --> 00:00:35,060
!انتظرا

7
00:00:35,920 --> 00:00:36,520
!احترس

8
00:00:40,760 --> 00:00:41,760
!ميتسكي

9
00:00:43,590 --> 00:00:44,590
!شكرًا لك

10
00:00:46,060 --> 00:00:47,060
أكيد

11
00:00:47,790 --> 00:00:49,120
!ميتسكي

12
00:00:55,920 --> 00:00:56,920
!—ذاك الشخص

13
00:00:58,160 --> 00:00:59,920
بوروتو وسارادا، اذهبا خلف كو

14
00:01:00,190 --> 00:01:01,190
!—لكن

15
00:01:01,820 --> 00:01:02,820
ثق بي

16
00:01:05,090 --> 00:01:07,220
أنا سعيد لأنك أتيت خلفي

17
00:01:07,790 --> 00:01:10,820
لكن هناك ما يجب عليّ فعله

18
00:01:10,890 --> 00:01:12,790
قبل أن أعود معك

19
00:01:19,160 --> 00:01:20,160
حسنًا

20
00:01:21,960 --> 00:01:23,090
مينسكي

21
00:01:24,260 --> 00:01:26,790
!لماذا يا ميتسكي؟

22
00:01:40,920 --> 00:01:42,060
!لن أدعك تتقدّم أكثر

23
00:01:43,220 --> 00:01:45,690
!لا تعرفان متى تستسلمان، أليس كذلك؟

24
00:01:46,320 --> 00:01:48,820
لكني سوف أقتلكما هذه المرة

25
00:01:49,160 --> 00:01:50,160
!ماذا—؟

26
00:01:50,260 --> 00:01:51,090
!هيا بنا

27
00:01:51,160 --> 00:01:52,160
!أجل

28
00:03:30,300 --> 00:03:33,630
!خدعتني تمامًا يا ميتسكي

29
00:03:34,170 --> 00:03:35,570
توقف عن هذا يا سيكيي

30
00:03:36,300 --> 00:03:38,670
وإلّا لن يصمد جسدك

31
00:03:39,330 --> 00:03:40,830
يجب أن تشعر بالعار

32
00:03:41,970 --> 00:03:44,070
!وتوقّف عن ادّعاء أنّك صديقي الآن

33
00:03:52,270 --> 00:03:53,970
أُطلق سراح التسوتشيكاغي-ساما

34
00:03:54,670 --> 00:03:55,670
انتهى أمر كو

35
00:03:56,600 --> 00:03:57,970
لقد خسرتم

36
00:03:58,070 --> 00:03:59,100
!اخرس

37
00:03:59,170 --> 00:04:01,270
لا داعي لنا لنواصل القتال

38
00:04:01,330 --> 00:04:03,070
!اخرس! اخرس! اخرس

39
00:04:03,570 --> 00:04:05,430
!كذبت عليّ

40
00:04:05,800 --> 00:04:07,570
خلتُ أنّك صديقي

41
00:04:07,630 --> 00:04:11,570
!وشعرتُ أنّنا تفاهمنا جيّدًا

42
00:04:12,800 --> 00:04:16,430
!بينما كنتَ تضحك عليّ في قلبك طوال هذا الوقت

43
00:04:16,900 --> 00:04:17,900
أنت مخطئ

44
00:04:18,570 --> 00:04:21,230
أريد أن أساعدك

45
00:04:21,700 --> 00:04:22,830
تريد أن تساعدني؟

46
00:04:23,470 --> 00:04:27,170
!إذًا، أعطني قلبك

47
00:04:49,070 --> 00:04:51,270
لن أدعك تهرب يا ميتسكي

48
00:05:13,330 --> 00:05:14,330
!شكرًا

49
00:05:14,470 --> 00:05:16,070
لا يزال الوقت مبكّرًا على أن تشكرني

50
00:05:20,870 --> 00:05:23,370
تلك النظارات جميلة حقًّا

51
00:05:23,870 --> 00:05:26,170
سوف آخذها في النهاية

52
00:05:26,700 --> 00:05:28,000
انسي ذلك

53
00:05:28,570 --> 00:05:30,730
ما كنتِ لتبدين جميلة بالنظارات

54
00:05:32,030 --> 00:05:33,200
!يا لعجرفتك

55
00:05:33,500 --> 00:05:36,130
ما كنتُ لأتبجّح إن كنتُ مكانك

56
00:05:36,830 --> 00:05:39,030
انعدمت خياراتكما حقًّا

57
00:05:39,670 --> 00:05:41,570
لكنّك تهلعين مع ذلك، صحيح؟

58
00:05:42,300 --> 00:05:43,370
!ذلك واضحٌ على وجهك

59
00:05:43,670 --> 00:05:44,670
!اخرسي

60
00:05:48,900 --> 00:05:49,900
!سأسحقكما

61
00:05:51,030 --> 00:05:52,230
!مـ-ما هذا؟

62
00:06:01,570 --> 00:06:02,570
!محال

63
00:06:12,330 --> 00:06:15,000
!كنتُ أحتفظ بهذه الدمية للأخير

64
00:06:15,500 --> 00:06:17,000
،يا للأسف

65
00:06:17,070 --> 00:06:19,130
،حتّى إن كنتما دميتاي الخاصّتان
لستما جميليّ المظهر

66
00:06:21,600 --> 00:06:25,900
...لكن، لأجل التخلّص من القبيحين أمثالكما

67
00:06:27,070 --> 00:06:28,830
!هذا الشّيء مناسب تمامًا

68
00:06:43,030 --> 00:06:44,070
!اللعنة

69
00:06:46,370 --> 00:06:50,070
يبدو أنّك في موقفٍ ليس رائع أيها الشقيّ

70
00:06:50,770 --> 00:06:51,770
!—أنت

71
00:06:52,230 --> 00:06:53,000
!فهمت

72
00:06:53,300 --> 00:06:54,630
!أنتما لحم مفروم

73
00:07:00,130 --> 00:07:01,330
!تقنية الاستدعاء

74
00:07:10,770 --> 00:07:11,670
!ما كان ذلك؟

75
00:07:12,000 --> 00:07:13,530
!شكرًا لك لأجل إنقاذي يا غاراغا

76
00:07:14,070 --> 00:07:17,170
ماذا؟ متى أنقذتك؟

77
00:07:18,570 --> 00:07:19,630
أنت فظيع

78
00:07:19,970 --> 00:07:21,700
...لذا أنت طفلٌ مذلّل

79
00:07:22,200 --> 00:07:24,430
!أما زلت تتفوّه بمثل هذا الكلام؟

80
00:07:25,270 --> 00:07:27,130
،على كلّ حال
!أنا في موقفٍ حرج الآن

81
00:07:27,530 --> 00:07:28,870
وكأنّي أهتمّ

82
00:07:29,070 --> 00:07:32,470
...أنا فقط أُطفئ الشرارات

83
00:07:32,530 --> 00:07:34,130
!الهامرة

84
00:07:36,300 --> 00:07:38,330
أترى؟ أنت تقاتل معي في الأخير

85
00:07:38,770 --> 00:07:39,770
!اخرس

86
00:07:40,230 --> 00:07:41,600
لا أفعل هذا لأجلك

87
00:07:42,330 --> 00:07:43,730
...بالنّسبة لي، هذا

88
00:07:44,400 --> 00:07:46,570
!سوف ننجز مهمّة اليوم بطريقةٍ جريئة

89
00:07:47,200 --> 00:07:50,300
!أجل، يستحيل أن نخسر

90
00:07:52,070 --> 00:07:55,370
!ميتسكي، شكرًا لك

91
00:07:58,000 --> 00:07:58,770
ماذا؟

92
00:07:58,970 --> 00:08:00,600
...اكتشفت

93
00:08:00,670 --> 00:08:05,670
أنّها قد لا تكون فكرة سيّئة
أن أساعد البشر مرّةً أخرى

94
00:08:12,570 --> 00:08:16,670
!لا تدع الأشياء القبيحة تزداد عددًا... أكوتا

95
00:08:25,930 --> 00:08:26,930
!غاراغا

96
00:08:33,970 --> 00:08:35,700
...اللعنة

97
00:08:37,200 --> 00:08:38,400
!نجونا بأعجوبة

98
00:08:38,830 --> 00:08:40,330
!من أعطاك الإذن للقفز على رأسي؟

99
00:08:41,370 --> 00:08:42,530
!الهجوم التالي قادم

100
00:08:44,070 --> 00:08:46,970
!لا تخسر أيها الشقيّ

101
00:08:57,830 --> 00:08:59,130
!عرفتها

102
00:08:59,200 --> 00:09:01,930
،قد تكونون بشرًا
لكنّكم لستم جميلين على الإطلاق

103
00:09:04,700 --> 00:09:05,930
!إيّاكما والاستهانة بي

104
00:09:09,170 --> 00:09:10,200
!موتا

105
00:09:17,670 --> 00:09:19,330
إيّاك والاستهانة بالشارينغان خاصّتي

106
00:09:19,830 --> 00:09:21,400
!أسلوب البرق: كرة البرق

107
00:09:31,370 --> 00:09:32,970
هل رأيت شيئًا جميلًا؟

108
00:09:34,130 --> 00:09:35,630
آسفة لأنه لم يكن حقيقيًّا

109
00:09:36,430 --> 00:09:39,130
قلت أننا لسنا جميلين إطلاقًا

110
00:09:39,730 --> 00:09:43,700
لكن ثمّة أشياء ثمينة مدفونة داخلنا نحن البشر

111
00:09:44,800 --> 00:09:46,170
...كعدم الاستسلام أبدًا مثلًا

112
00:09:46,830 --> 00:09:48,470
...وعدم الخضوع

113
00:09:49,600 --> 00:09:50,830
وأشياء أخرى كالشارينغان

114
00:09:52,230 --> 00:09:53,500
!اخرسي

115
00:09:56,270 --> 00:09:59,800
!لا
لماذا؟ لماذا؟

116
00:10:00,430 --> 00:10:03,370
!أكوتا! ما الذي تفعله؟

117
00:10:03,970 --> 00:10:06,530
!أسرع وأنقذني

118
00:10:09,700 --> 00:10:10,670
!لا تدعه يفرّ

119
00:10:10,730 --> 00:10:11,730
!أجل

120
00:10:18,200 --> 00:10:20,630
!فقط مزّق ذلك الشيء عنك

121
00:10:27,470 --> 00:10:28,470
!غاراغا

122
00:10:37,430 --> 00:10:38,770
!نل منه يا غاراغا

123
00:10:39,630 --> 00:10:41,930
!سوف أُحطّمه إلى شظايا

124
00:10:52,270 --> 00:10:54,700
!لا، توقف

125
00:10:54,770 --> 00:10:57,700
!—لمَ على شخصٍ بجمالي أن ينتهي به المطاف

126
00:11:05,670 --> 00:11:07,670
،أظنّك حتّى إن تهندمتِ من الخارج

127
00:11:08,230 --> 00:11:11,170
فذلك ليس كافيًا ليجعلك جميلةً

128
00:11:18,650 --> 00:11:19,650
ميتسكي

129
00:11:20,050 --> 00:11:24,090
أردتَ أن تقتلنا من البداية، أليس كذلك؟

130
00:11:25,390 --> 00:11:26,450
،ادّعيتَ فقط أنّك  في صفّنا

131
00:11:26,520 --> 00:11:28,090
ثم تلاعبتَ بنا

132
00:11:31,320 --> 00:11:32,790
!لن أسامحك أبدًا

133
00:11:33,190 --> 00:11:34,320
!مُت فحسب

134
00:11:46,550 --> 00:11:47,920
...إن كنتُ أهدف لقتلكم

135
00:11:48,690 --> 00:11:50,990
لما أنقذتك سابقًا

136
00:11:52,420 --> 00:11:55,750
كان عليّ أن أكتشف إن كنتم

137
00:11:56,350 --> 00:11:57,990
ستجلبون الضرر إلى قرية الورق

138
00:11:58,190 --> 00:11:59,390
لهذا أتيت معكم

139
00:12:00,450 --> 00:12:02,090
!إذًا، الإجابة واضحة

140
00:12:02,750 --> 00:12:05,050
!نحن حماة العالم

141
00:12:06,020 --> 00:12:07,020
كلّا، أنت مخطئ

142
00:12:07,450 --> 00:12:08,950
سلك كو الطريق الخاطئ

143
00:12:09,720 --> 00:12:10,950
ولا توجد عودة بالنسبة له

144
00:12:11,650 --> 00:12:14,620
،إن ظلّت الأشياء على ما هي عليه
سوف تصبحون أعداء للبشر

145
00:12:15,220 --> 00:12:16,550
!وما أدراك؟

146
00:12:17,450 --> 00:12:18,450
...كو-ساما

147
00:12:18,890 --> 00:12:20,620
!كو-ساما يفعل هذا لصالح البشر

148
00:12:28,550 --> 00:12:29,550
أعلم

149
00:12:33,150 --> 00:12:34,820
لأنّنا متشابهان كثيرًا على الأغلب

150
00:12:35,790 --> 00:12:39,990
كما قلت، ربّما نحن متوافقان

151
00:12:40,790 --> 00:12:41,990
ولهذا أعلم

152
00:12:42,420 --> 00:12:43,450
!تعلم ماذا؟

153
00:12:44,220 --> 00:12:45,850
تملكون إرادةً جميعًا

154
00:12:46,450 --> 00:12:48,220
أملكها أنا، وكذلك أنتم

155
00:12:48,850 --> 00:12:50,990
لهذا أريد أن أنقذكم

156
00:12:51,590 --> 00:12:52,520
هذه إرادتي

157
00:12:53,220 --> 00:12:56,550
!لا تملك أيّ حق
!لقد خنتَ صديقك

158
00:13:03,990 --> 00:13:07,050
!كفّ عن الهرب وقاتلني يا ميتسكي

159
00:13:10,890 --> 00:13:13,120
!سأريك، بقوّتي

160
00:13:13,920 --> 00:13:16,850
لا طائل من قتال بعضنا لبعض

161
00:13:17,950 --> 00:13:18,950
هكذا إذًا؟

162
00:13:19,220 --> 00:13:20,950
إذًا، سأمنحك سببًا للقتال

163
00:13:22,050 --> 00:13:24,450
سوف أقتل بوروتو

164
00:13:25,190 --> 00:13:28,720
،صديقك الثمين ذاك
..."شمسك"

165
00:13:29,090 --> 00:13:30,920
!سأقتلك بيداي هاتين

166
00:13:32,620 --> 00:13:35,050
هل القتال هو السّبيل الوحيد؟

167
00:13:36,050 --> 00:13:38,420
لم يعد هناك سبيلٍ آخر

168
00:13:39,820 --> 00:13:40,890
...سيكيي

169
00:13:42,050 --> 00:13:43,050
!فليكن

170
00:13:44,250 --> 00:13:45,850
!إذًا، حسمتَ أمرك؟

171
00:13:46,220 --> 00:13:46,990
!سيكيي

172
00:13:47,150 --> 00:13:48,220
!ميتسكي

173
00:14:09,850 --> 00:14:12,620
!اختف إلى الأبد

174
00:14:15,450 --> 00:14:18,050
!أسلوب البرق: برق الثعبان

175
00:14:26,190 --> 00:14:27,190
!ما الذي يجري؟

176
00:14:27,790 --> 00:14:29,520
لمَ لم يتفجّر؟

177
00:14:35,950 --> 00:14:37,490
!ميتسكي

178
00:14:39,320 --> 00:14:41,950
،سيكيي
أنت مستخدم أسلوب الأرض

179
00:14:42,750 --> 00:14:44,720
يمكن لأسلوب البرق خاصتي أن يبطله

180
00:14:45,650 --> 00:14:46,750
ماذا؟

181
00:14:47,720 --> 00:14:49,590
...كما قلت

182
00:14:51,150 --> 00:14:57,450
أظنّنا لم نكن متوافقين في النهاية

183
00:15:10,250 --> 00:15:11,450
...عليّ أن أسرع

184
00:15:11,990 --> 00:15:13,020
!الثالث

185
00:15:14,420 --> 00:15:15,350
أهذا أنت يا سيكّي؟

186
00:15:15,420 --> 00:15:16,620
ما الذي تفعله هنا؟

187
00:15:17,020 --> 00:15:22,290
أجل، أخبرني أكاتسوتشي-سان أن أنقذك، لهذا أتيت

188
00:15:22,890 --> 00:15:24,020
أكاتسوتشي؟

189
00:15:24,720 --> 00:15:26,790
فهمت، شكرًا لك

190
00:15:27,490 --> 00:15:27,990
...والآن

191
00:15:28,550 --> 00:15:29,620
أيها الثالث، اصعد على ظهري رجاءً

192
00:15:30,050 --> 00:15:31,590
سنخرج من هنا وننضمّ إلى البقيّة

193
00:15:32,220 --> 00:15:35,490
لا، لا يمكنني أن أهرب

194
00:15:37,120 --> 00:15:39,190
سيكّي، أحتاج مساعدتك

195
00:15:39,590 --> 00:15:41,150
إلى أين ستذهب؟

196
00:15:42,250 --> 00:15:45,450
إلى مكانٍ لإنهاء هذا القتال

197
00:15:55,690 --> 00:15:56,850
الوقت ينفد

198
00:16:07,220 --> 00:16:08,220
!—هذا

199
00:16:08,750 --> 00:16:10,620
!أنت في حالة حرجة

200
00:16:14,150 --> 00:16:18,450
!ليس بعد
!لا يمكنني السقوط بعد

201
00:16:19,090 --> 00:16:21,150
...أسرع
!أسرع بزراعة القلب

202
00:16:21,620 --> 00:16:23,350
أنا آسف جدًّا

203
00:16:24,020 --> 00:16:27,920
هرب المتبرّعون قبل أن أجهّزه

204
00:16:28,420 --> 00:16:31,590
،لو أنّي أملك المواد الخام فقط
لجهّزتُ واحدًا على الفور

205
00:16:33,850 --> 00:16:35,020
...فهمت

206
00:16:35,290 --> 00:16:37,250
تحتاج إلى المواد الخام فحسب، صحيح؟

207
00:16:38,520 --> 00:16:40,750
!قلب إنسان

208
00:16:56,290 --> 00:16:57,290
...ميتسكي

209
00:16:57,450 --> 00:16:58,450
!حاول ألّا تتحرّك

210
00:17:00,590 --> 00:17:03,590
أعرف طريقةً لأدبّر لك قلبًا

211
00:17:04,420 --> 00:17:05,590
...الشخص الذي صنعني

212
00:17:06,050 --> 00:17:07,550
...يمكنه أن يُدبّره لك

213
00:17:07,620 --> 00:17:08,990
لستَ بحاجةٍ لتعزيتي

214
00:17:11,550 --> 00:17:14,950
أعرف جسدي على الأقل

215
00:17:18,650 --> 00:17:19,650
!هذا ليس عادلًا

216
00:17:20,220 --> 00:17:24,420
كان لديك ما أبتغيه من البداية

217
00:17:25,090 --> 00:17:26,250
وما الذي ابتغيته؟

218
00:17:27,020 --> 00:17:28,120
أتذكر ما أخبرتك إيّاه؟

219
00:17:28,920 --> 00:17:31,550
أردتُ امتلاك شيءٍ أحميه

220
00:17:32,490 --> 00:17:33,590
...شخص أحميه

221
00:17:34,490 --> 00:17:35,550
شخص ثمين

222
00:17:36,920 --> 00:17:39,590
،البشر يعتزّون ببعضهم البعض

223
00:17:40,090 --> 00:17:41,390
ولهذا يصبحون أقوى، صحيح؟

224
00:17:43,990 --> 00:17:50,490
كو-سانا وكيرارا وكاكو وكوكويو وأنت

225
00:17:51,650 --> 00:17:55,350
أصبحتَ شخصًا ثمينًا لي

226
00:17:56,890 --> 00:18:01,720
لكن أظنّنا لم نستطع أن نصبح مثلك وذلك المدعو بوروتو

227
00:18:03,790 --> 00:18:04,690
سيكيي

228
00:18:05,950 --> 00:18:07,090
...قوّتك

229
00:18:07,690 --> 00:18:11,820
...بتُّ أعلم أنّها كانت قوّةً لأجل حماية بوروتو وليس أنا

230
00:18:14,850 --> 00:18:16,250
!أحسده

231
00:18:17,620 --> 00:18:21,720
لمَ لم تحاول قتالي؟

232
00:18:22,620 --> 00:18:25,350
أنا عدوك

233
00:18:26,250 --> 00:18:27,190
كلّا، لستَ كذلك

234
00:18:28,490 --> 00:18:29,490
،أخبرتني سابقًا

235
00:18:30,150 --> 00:18:33,690
أنّني كنتُ أحمل معي الوحدة
عندما كنتُ في قرية الورق

236
00:18:35,420 --> 00:18:38,520
بوروتو والجميع في القرية يعاملونني جيّدًا جدًّا

237
00:18:39,150 --> 00:18:40,220
...لكن

238
00:18:40,790 --> 00:18:45,590
أشعر أحيانًا وكأنّ كلامي لا يبلغهم

239
00:18:46,620 --> 00:18:48,250
،لذا فكّرت، إن كانت تلك هي الحقيقة

240
00:18:49,390 --> 00:18:51,190
إذًا أن محق

241
00:18:52,890 --> 00:18:54,520
أنا وأنتم متشابهون

242
00:18:55,550 --> 00:18:56,550
حقًّا؟

243
00:18:57,590 --> 00:19:00,290
قاتلتكم لأجل بوروتو

244
00:19:00,890 --> 00:19:02,350
لكنّه ليس السّبب الوحيد

245
00:19:03,020 --> 00:19:04,890
كلّ ما قلتُه سابقًا كان معنيًّا لك

246
00:19:05,450 --> 00:19:08,090
فقط أردتُ منك أن تتوقف

247
00:19:12,820 --> 00:19:13,890
...ميتسكي

248
00:19:17,450 --> 00:19:18,450
!سيكيي

249
00:19:19,090 --> 00:19:20,420
...أظن

250
00:19:20,690 --> 00:19:24,390
...لن أكون الوحيد
...الذي سيموت

251
00:19:26,890 --> 00:19:28,020
يمكنني أن أرى ذلك

252
00:19:28,920 --> 00:19:30,890
...كيرارا ماتت للتّو

253
00:19:31,820 --> 00:19:33,620
...كاكو وكاكويو أيضًا

254
00:19:35,090 --> 00:19:37,850
...سوف ألحق بهما

255
00:19:43,420 --> 00:19:44,450
ميستكي؟

256
00:19:45,550 --> 00:19:46,550
...كنّا

257
00:19:47,450 --> 00:19:50,490
صديقين أيضًا، صحيح؟

258
00:20:18,950 --> 00:20:19,950
!تسوتشيكاغي-ساما

259
00:20:20,250 --> 00:20:22,220
أخضعنا العدوّ في الجانب الشماليّ من القرية

260
00:20:22,720 --> 00:20:23,720
حسنًا

261
00:20:24,020 --> 00:20:27,020
أعتمد عليكم لأجل العناية بالجرحى وحراسة الخلف

262
00:20:27,220 --> 00:20:27,920
!حاضر

263
00:20:28,690 --> 00:20:30,720
،من لا يزال في وسعه القتال
!فليأتِ معي

264
00:20:30,950 --> 00:20:31,690
!حاضر

265
00:20:35,620 --> 00:20:36,850
المكان صامت بغرابة

266
00:20:38,320 --> 00:20:39,320
...ولا وجود للأكوتا أيضًا

267
00:20:39,690 --> 00:20:41,020
لا تهمل دفاعك

268
00:20:41,320 --> 00:20:42,320
!أعلم

269
00:20:43,190 --> 00:20:44,720
سوف أقبض على كو مهما كان

270
00:20:50,190 --> 00:20:51,190
!ميتسكي

271
00:20:51,690 --> 00:20:52,690
آسف لجعلكما تنتظران

272
00:20:53,150 --> 00:20:54,150
!تأخرت

273
00:20:54,450 --> 00:20:55,450
آسف

274
00:20:55,820 --> 00:20:56,820
هل أنت بخير؟

275
00:20:57,150 --> 00:20:57,990
أجل

276
00:21:01,620 --> 00:21:03,820
أخبرني بالتفاصيل لاحقًا

277
00:21:07,190 --> 00:21:09,720
يبدو أنّ كو لجأً هناك

278
00:21:09,950 --> 00:21:12,420
لا يمكنه أن يتحرّك بسهولة بذلك الجرح

279
00:21:13,350 --> 00:21:16,590
!سوف ننهي هذا الأمر بسرعة ونعود إلى قرية الورق

280
00:21:17,620 --> 00:21:18,620
...بوروتو

281
00:21:29,190 --> 00:21:32,790
إذًا، أتيتم إلى هنا لتلقوا حتفكم أيها الضعفاء؟

282
00:21:33,390 --> 00:21:35,150
،يبدو أنّك تبلي بخير

283
00:21:35,220 --> 00:21:37,150
!مع أنّك أُصبتَ بواسطة ميتسكي

284
00:21:38,050 --> 00:21:39,190
!انظرا! صدره

285
00:21:41,750 --> 00:21:43,290
!—ذ-ذلك

286
00:23:26,300 --> 00:23:28,030
،لأنّنا اختبرنا الألم

287
00:23:28,100 --> 00:23:30,360
نعرف قيمة السّلام

288
00:23:30,430 --> 00:23:33,130
ونبذل كلّ ما في وسعنا لحماية الضعفاء

289
00:23:34,000 --> 00:23:36,860
،لكن أحيانًا عندما نرتطم بالحائط

290
00:23:36,930 --> 00:23:39,460
نفقد الإرادة لفعل ذلك

291
00:23:40,130 --> 00:23:42,830
:في الحلقة القادمة

292
00:23:43,300 --> 00:23:44,430
"إرادة أونوكي"

293
00:23:45,000 --> 00:23:48,230
لكن بما أنّك مُنِحتَ الفرصة لتواجه نفسك

294
00:23:48,560 --> 00:23:50,600
يمكنك أن تلمّ أشتاتك وتبدأ من جديد