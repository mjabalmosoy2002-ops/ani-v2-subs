1
00:00:06,410 --> 00:00:07,810
!سحقًا

2
00:00:08,110 --> 00:00:11,210
!أنا جائع حقًّا وذراعي لا تتجدّد بسرعة كافية

3
00:00:17,440 --> 00:00:18,840
!لم أجده في أيّ مكان

4
00:00:19,010 --> 00:00:22,310
!سحقًا! أين ذهب ذلك النّذل؟

5
00:00:22,740 --> 00:00:25,640
.لا بدّ أنّه هرب إلى الخارج

6
00:00:31,040 --> 00:00:32,570
.علينا أن نذهب خلفه

7
00:00:41,340 --> 00:00:43,610
!على أيّ حال، عليّ الابتعاد من هنا

8
00:00:44,570 --> 00:00:47,770
!عليّ الابتعاد عنه... قدر الإمكان

9
00:01:00,170 --> 00:01:02,010
.الهارب ذكر مراهق

10
00:01:02,010 --> 00:01:05,510
.نعتقد أنّه يرتدي رداء مستشفى أخضر وقد يكون مصابًا

11
00:01:06,110 --> 00:01:07,910
.هذا وضع خطير للغاية

12
00:01:08,040 --> 00:01:09,340
!لا تهملوا دفاعكم

13
00:01:10,770 --> 00:01:14,010
!ممثلّة الصّفّ لا تدري كم هو خطير

14
00:01:14,140 --> 00:01:16,210
!علينا أن نجده قبلها

15
00:01:16,310 --> 00:01:19,970
أعتقد أنّ أسرع وسيلة للخروج
.من البلدة هي بأخذ القطار السّريع

16
00:01:20,710 --> 00:01:21,940
.يبدو ذلك احتمالًا

17
00:01:22,070 --> 00:01:23,540
!لنذهب إلى المحطّة

18
00:01:43,740 --> 00:01:45,710
.خسرت الكثير من الدّم

19
00:01:45,770 --> 00:01:46,940
!سحقًا

20
00:01:52,070 --> 00:01:53,570
...الأهمّ أوّلًا

21
00:01:53,640 --> 00:01:57,270
.عليّ أن آكل شيئًا، وإلّا لن تتجدّد ذراعي بسرعة كافية

22
00:03:48,200 --> 00:03:49,500
!لذيذ

23
00:03:49,960 --> 00:03:52,500
!خاصّتهم هو الأفضل

24
00:03:57,100 --> 00:03:59,460
...أريد أن أسرق واحدًا وأتناوله

25
00:04:05,600 --> 00:04:07,600
.لكن لا يمكنني أن أجذب أيّ انتباه حاليًّا

26
00:04:07,730 --> 00:04:08,830
!سحقًا

27
00:04:08,930 --> 00:04:11,530
!لا يمكنني أن أضيّع وقتي هنا

28
00:04:17,930 --> 00:04:20,360
،أحتاج الابتعاد قدر الإمكان

29
00:04:20,430 --> 00:04:21,900
!إلى مكان لا يراني فيه

30
00:04:31,900 --> 00:04:33,660
!لا شيء لائق هنا

31
00:04:40,200 --> 00:04:42,700
!سأذهب للتّوصيل

32
00:05:16,130 --> 00:05:18,500
هل أنت متوتّر لأنّك جائع؟

33
00:05:19,260 --> 00:05:20,730
...اهدأ

34
00:05:21,160 --> 00:05:24,100
.مع الأسف، وجدت هذا قبلك

35
00:05:29,500 --> 00:05:33,630
.حاول التّحرّك وأنا ممسك بك من عنقك

36
00:05:38,500 --> 00:05:40,800
.يبدو أنّك لصّ

37
00:05:41,330 --> 00:05:45,530
.لا بدّ أنّك أُصبت لها من محاولتك سرقة النّاس

38
00:06:09,430 --> 00:06:10,700
.جيّد

39
00:06:11,260 --> 00:06:14,260
.لا ينبغي أن تثق بالنّاس بسهولة

40
00:06:16,530 --> 00:06:17,630
!خذ

41
00:06:23,930 --> 00:06:26,560
.وكأنّني سآكل قطعة خبز مقرفة ومغطّاة بالتّراب

42
00:06:38,000 --> 00:06:39,230
.ما زال حديثًا

43
00:06:39,500 --> 00:06:41,800
.يبدو أنّه لم يغادر البلدة بعد

44
00:06:42,230 --> 00:06:44,900
.سيستغرق بعض الوقت للتّعافي

45
00:06:44,960 --> 00:06:47,960
،لا أظنّه مستعدًّا للقتال بعد

46
00:06:48,060 --> 00:06:49,400
.لكن علينا أن نحذر مع ذلك

47
00:06:51,030 --> 00:06:53,700
!أجل، كنت قلقة بشأن ذلك أيضًا

48
00:06:54,300 --> 00:06:56,500
يا لك من وحش، ألست كذلك؟

49
00:06:56,560 --> 00:06:58,660
.أظنّك مثلي تمامًا

50
00:07:00,600 --> 00:07:03,060
...لربّما هو أيضًا

51
00:07:11,060 --> 00:07:12,700
.أنا جدّ جائع

52
00:07:29,430 --> 00:07:32,100
.ستضطرّني للتخلّص منك إن واصلت ملاحقتي

53
00:07:38,700 --> 00:07:40,400
.كلب غبيّ

54
00:07:58,130 --> 00:07:59,930
!كفّ عن ملاحقتي

55
00:08:02,500 --> 00:08:03,900
.سحقًا

56
00:08:04,100 --> 00:08:07,300
.سأكون في مأزق عويص ما لم أجد شيئًا أأكله

57
00:08:15,730 --> 00:08:18,400
.يبدو أنّهم لم يروا أيّ أحد يشبهه

58
00:08:18,400 --> 00:08:21,530
هل أخطأنا في التّفكير أنّه قد يتسلّل إلى القطار السّريع؟

59
00:08:21,930 --> 00:08:23,930
ماذا عن القطار التّالي؟

60
00:08:23,930 --> 00:08:26,130
.قالوا أنّه سيصل بعد ساعة من الآن

61
00:08:26,660 --> 00:08:28,960
ما العمل؟ هل ننتظر حتّى حين؟

62
00:08:29,400 --> 00:08:32,500
.سنهدر الوقت فحسب. دعانا ننضمّ إلى البقيّة

63
00:08:32,660 --> 00:08:35,530
.ربّما تواصلت معهم ممثّلة الفصل ببعض المعلومات

64
00:08:44,560 --> 00:08:47,900
...حتّى إن كان طفلًا فجًّا

65
00:08:49,700 --> 00:08:54,530
.أظنّ أنّ من المخاطرة حقًّا أن ندع أحدًا لا نعرفه يدخل قريتنا

66
00:08:54,960 --> 00:08:56,760
.هذا سبب معقول

67
00:08:57,200 --> 00:09:02,030
سيكون ذلك بمثابة التّعامل مع حطب
.قد يتحوّل إلى نار مستعرّة في أيّة لحظة

68
00:09:05,660 --> 00:09:10,000
.كما أنّ الكارا تبحث عنه بشكل محموم

69
00:09:10,800 --> 00:09:13,660
...إن حاولوا استرجاعه

70
00:09:15,230 --> 00:09:18,300
.ستصبح القرية ساحة معركة ثانيةً

71
00:09:25,530 --> 00:09:28,200
.حسنًا... ها نحن ذا

72
00:09:32,530 --> 00:09:34,800
أنت، هل انتهيت من الإعدادات؟

73
00:09:45,160 --> 00:09:47,230
!هل عدت ثانيةً أيّها الكلب اللّعين؟

74
00:09:47,500 --> 00:09:48,660
!عد إلى هنا

75
00:10:04,560 --> 00:10:05,630
!ذاك القماش

76
00:10:08,300 --> 00:10:10,400
!أنت سريع أيّها الكلب اللّعين

77
00:10:11,460 --> 00:10:13,260
!سحقًا! سأنال منك

78
00:10:13,460 --> 00:10:14,630
!توقّف رجاءً

79
00:10:14,860 --> 00:10:16,330
!ماذا إن انتهى بك المطاف تضربه؟

80
00:10:16,400 --> 00:10:17,860
!لا تتدخّلي أيّتها الآنسة الصّغيرة

81
00:10:18,130 --> 00:10:20,260
!لن تهرب بفعلتك

82
00:10:35,460 --> 00:10:39,060
!ما كان يجب أن أهب ذلك الخبز لذلك الكلب

83
00:10:40,930 --> 00:10:43,530
.لم تتماثل ذراعي للشّفاء بعد أيضًا

84
00:10:44,200 --> 00:10:46,000
.سحقًا. يا لحظّي العاثر

85
00:10:55,760 --> 00:10:56,960
.هذا أنت

86
00:10:58,130 --> 00:11:00,500
أهذه... لي؟

87
00:11:10,400 --> 00:11:12,030
!انتهى أمرك أيّها الكلب المغفّل

88
00:11:12,100 --> 00:11:14,860
!أعدها! سحقًا! دعها

89
00:11:15,360 --> 00:11:16,830
!يا للخسارة

90
00:11:17,030 --> 00:11:18,500
!انظر إليها

91
00:11:18,560 --> 00:11:19,710
!توقّعت ذلك

92
00:11:18,560 --> 00:11:20,430
!ما عدت أستطيع بيعها

93
00:11:22,360 --> 00:11:26,660
!من المزعج وجود كلب حثالة مثلك من الأساس

94
00:11:26,730 --> 00:11:27,800
.انتظر

95
00:11:29,060 --> 00:11:31,260
ماذا ستفعل به؟

96
00:11:32,800 --> 00:11:36,260
.سألقّن هذا الكلب الشّارد الرّديء درسًا

97
00:11:36,900 --> 00:11:37,960
!ماذا؟

98
00:11:38,800 --> 00:11:40,430
تلقّنه درسًا؟

99
00:11:42,900 --> 00:11:44,730
!لا تعبث

100
00:11:47,130 --> 00:11:48,330
!أ-أنت وحش

101
00:11:54,700 --> 00:11:56,200
!مـ-ماذا؟

102
00:11:58,030 --> 00:11:59,600
!إلامَ تنظر؟

103
00:12:00,530 --> 00:12:02,560
أتريدني أن أقتلك أيضًا؟

104
00:12:03,300 --> 00:12:06,160
الأهمّ، علينا إنقاذ الكلب، صحيح؟

105
00:12:26,600 --> 00:12:29,630
.ينبغي أن تشفى الجراح قريبًا

106
00:12:35,230 --> 00:12:36,800
.دعني أرى جراحك أيضًا

107
00:12:36,930 --> 00:12:38,270
!لا تلمسيني

108
00:12:42,170 --> 00:12:43,500
!مذهل

109
00:12:44,070 --> 00:12:46,070
!كدت تتماثل للشّفاء

110
00:12:47,370 --> 00:12:50,600
.آسفة بشأن نو

111
00:12:52,870 --> 00:12:54,170
إلامَ تنظر؟

112
00:12:54,600 --> 00:12:56,770
!ما عاد لك شأن معي

113
00:13:02,930 --> 00:13:04,770
.لم تكن بحاجة لفعل ذلك

114
00:13:04,970 --> 00:13:08,930
.لن يحدث خير من تورّطه مع النّاس

115
00:13:11,170 --> 00:13:14,530
هل تتحدّث عن نفسك يا ترى؟

116
00:13:18,100 --> 00:13:20,530
،ربّما أسدتني معروفًا

117
00:13:20,600 --> 00:13:22,000
.لكن لا أملك نيّة في العودة

118
00:13:22,470 --> 00:13:24,570
،فور أن تشفى ذراعي تمامًا

119
00:13:24,630 --> 00:13:26,170
.يمكنني أن أبيد بلدة كهذه

120
00:13:31,930 --> 00:13:36,630
.يبدو أنّ الهوكاغي-ساما متّجه إلى هنا للحديث معك بنفسه

121
00:13:37,070 --> 00:13:39,170
.وماذا إذًا؟ يا للغباء

122
00:13:39,600 --> 00:13:41,470
.إنّه شخص متفهّم

123
00:13:41,870 --> 00:13:43,330
.أنا واثقة أنّه يريد مساعدتك

124
00:13:43,470 --> 00:13:45,800
لا بدّ أنّه مهتمّ بقدراتي الجسديّة فحسب، صحيح؟

125
00:13:45,930 --> 00:13:47,630
.لا أثق بالكبار

126
00:13:47,700 --> 00:13:50,200
.وبطبيعة الحال، لا أثق بالأطفال أيضًا

127
00:13:52,000 --> 00:13:55,700
.أعلم كيف هو شعور ألّا تثق بمن حولك

128
00:13:58,630 --> 00:14:01,300
.ماذا؟ كفّي عن محاولة خداعي

129
00:14:03,100 --> 00:14:06,330
قام أبي بزراعة سلاح في جسدي

130
00:14:06,400 --> 00:14:10,900
.بغرض إرضاء إحساسه المشوّه للانتقام

131
00:14:11,970 --> 00:14:15,170
رأيت مظهر نو، أليس كذلك؟

132
00:14:16,070 --> 00:14:17,800
،عندما كنت لا أزال صغيرةً

133
00:14:17,870 --> 00:14:20,030
.وثقت بأبي وفعلت ما مُلي عليّ

134
00:14:20,470 --> 00:14:24,970
.كدتُ أدمّر قرية الورق

135
00:14:25,770 --> 00:14:30,330
.لكنّ بوروتو والجميع أعادوني إلى الطّريق الصّواب

136
00:14:32,370 --> 00:14:34,770
لمَ تخبرينني كلّ هذا؟

137
00:14:35,830 --> 00:14:40,100
.انتابني شعور أنّك ربّما مررت بماضٍ أليم

138
00:14:40,330 --> 00:14:41,870
!لا تدفعيني للضّحك

139
00:14:41,930 --> 00:14:43,500
!لا تعرفينني

140
00:14:43,900 --> 00:14:46,700
!أريدك أن تخبرينني لأنّني لا أدري

141
00:14:47,500 --> 00:14:49,470
!لا تتحرّك بعد

142
00:14:49,970 --> 00:14:52,100
!سـ-سحقًا

143
00:14:52,170 --> 00:14:53,970
!ما زلتُ أشعر بالدّوار

144
00:14:54,400 --> 00:14:56,030
.لهذا أخبرتك

145
00:14:56,100 --> 00:14:58,530
.انتظر لحظة. أظنّني أملك شيئًا هنا

146
00:15:00,530 --> 00:15:03,500
.يبدو أنّك تستمتع بكونك فضوليًّا

147
00:15:03,830 --> 00:15:04,970
!وجدته

148
00:15:05,170 --> 00:15:08,600
.لا تقلق، هذا مجرّد مكمّل غدائيّ

149
00:15:14,200 --> 00:15:15,700
!إيّاك يا نول

150
00:15:16,770 --> 00:15:18,170
!اهدأ

151
00:15:19,130 --> 00:15:21,300
!لا نيّة لي لإيذائك

152
00:15:21,400 --> 00:15:22,470
!اخرسي

153
00:15:22,670 --> 00:15:25,770
!لن أدعك تحقينني بأيّ شيء آخر

154
00:15:27,570 --> 00:15:29,030
!دع ممثّلة الفصل وشأنا

155
00:15:30,630 --> 00:15:32,700
!انتظر يا بوروتو

156
00:15:45,400 --> 00:15:46,900
.فهمت

157
00:15:46,970 --> 00:15:49,470
.كنت تحاولين كسب الوقت

158
00:15:49,900 --> 00:15:51,400
!أ-أنت مخطئ

159
00:15:58,930 --> 00:15:59,970
!نو

160
00:16:02,000 --> 00:16:04,130
!ممثّلة الفصل هناك، هل جننت؟

161
00:16:04,230 --> 00:16:05,030
!إطلاق

162
00:16:14,330 --> 00:16:15,370
!لا تدعاه يهرب

163
00:16:28,100 --> 00:16:29,800
!ممثّلة الفصل، هل أنت بخير؟

164
00:16:30,170 --> 00:16:31,070
!بوروتو

165
00:16:31,330 --> 00:16:33,770
!وراءه! سألحق بكما بعد دقيقة

166
00:16:42,470 --> 00:16:44,270
!سلّم نفسك بهدوء

167
00:16:44,530 --> 00:16:46,770
!يستحيل أن أفعل ذلك

168
00:17:17,900 --> 00:17:20,130
.علينا أن نعود إلى القرية قبل انتهاء اليوم

169
00:17:21,200 --> 00:17:24,670
.أحتاج منك أن تقرّر ما سنفعله بشأن الصّبيّ بسرعة

170
00:17:24,670 --> 00:17:27,030
.أجل، مفهوم

171
00:17:33,800 --> 00:17:35,130
!انتظر

172
00:17:35,330 --> 00:17:37,130
!ممثّلة الفصل، تماسكي

173
00:17:38,670 --> 00:17:40,570
!بوروتو، ماذا حدث؟

174
00:17:41,030 --> 00:17:45,730
!الشّخص الّذي وجدناه هرب من المختبر

175
00:17:45,800 --> 00:17:46,630
!ماذا؟

176
00:17:47,430 --> 00:17:50,270
.يبدو أنّ ما خشناه أكثر قد حصل

177
00:17:58,930 --> 00:18:00,300
!هل أنت بخير؟

178
00:18:01,330 --> 00:18:03,730
.نحن بحاجة لإيجاده قبل أن يتسبّب بمزيد من الضّرر

179
00:18:04,030 --> 00:18:06,330
.أجل، أظنّنا لا نملك خيارًا

180
00:18:07,630 --> 00:18:10,630
.انتظر رجاءً أيّها السّابع

181
00:18:11,070 --> 00:18:12,500
ما الأمر يا سوميري؟

182
00:18:13,170 --> 00:18:16,270
.يملك نظرة حزينة في عينيه

183
00:18:17,400 --> 00:18:20,330
.ينتابني شعور أنّه ليس هائجًا بإرادته

184
00:18:20,700 --> 00:18:23,670
!حاول خنقك يا ممثّلة الفصل

185
00:18:24,130 --> 00:18:26,730
...أعرف تلك النّظرة لأنّني

186
00:18:27,530 --> 00:18:29,970
.كنت مثله تمامًا

187
00:18:32,030 --> 00:18:33,870
.علينا تقييده أوّلًا

188
00:18:34,300 --> 00:18:35,770
.سنستجوبه لاحقًا

189
00:18:36,600 --> 00:18:39,900
.رجاءً أيّها السّابع

190
00:18:40,170 --> 00:18:41,970
.أصغ لما لديه

191
00:18:55,000 --> 00:18:56,630
.يبدو أنّ قوّته قد خارت

192
00:19:01,770 --> 00:19:03,100
!اضبط نفس

193
00:19:03,800 --> 00:19:06,200
!لا تفكّر في فعل أيّ شيء آخر

194
00:19:06,400 --> 00:19:08,670
!أذلك الشّخص الخطير؟

195
00:19:13,800 --> 00:19:17,070
!لا تمل عليّ الأوامر

196
00:19:17,370 --> 00:19:18,470
أتحاول المقاومة؟

197
00:19:18,530 --> 00:19:19,370
!لم تترك لي خيارًا إذًا

198
00:19:19,430 --> 00:19:20,670
!لا تفعلوا رجاءً! توقّفوا

199
00:19:23,530 --> 00:19:25,370
!أوقفوا ذلك الوحش عن الحراك

200
00:19:25,500 --> 00:19:27,130
!لا تتساهلوا معه

201
00:19:42,930 --> 00:19:43,830
!ماذا؟

202
00:19:44,130 --> 00:19:46,500
...سأريكم ما يعنيه

203
00:19:47,130 --> 00:19:49,630
!ألّا تتساهل

204
00:19:54,230 --> 00:19:55,530
!انبطحوا جميعًا

205
00:19:55,630 --> 00:19:57,470
!احترقوا

206
00:20:39,100 --> 00:20:41,370
.ظهر الزّعيم الكبير أخيرًا إذًا

207
00:20:42,030 --> 00:20:44,670
هل تنوي توريط الأبرياء؟

208
00:20:45,000 --> 00:20:46,370
.اخرس

209
00:20:46,430 --> 00:20:48,530
.لا تهدر حياتك

210
00:20:49,270 --> 00:20:51,470
.أنا واثق أنّ هناك من يكترث لك

211
00:20:51,830 --> 00:20:54,630
.لا أملك شخصًا كذلك

212
00:20:59,830 --> 00:21:03,630
.قرّرت أن أعتني بك بنفسي

213
00:21:12,730 --> 00:21:16,470
!دع... يدي

214
00:21:19,630 --> 00:21:21,330
.لا تدّع الصّلابة

215
00:21:21,900 --> 00:21:24,130
.لن أفعل أيّ شيء سيّئ

216
00:21:27,330 --> 00:21:28,700
!حمدًا لهذا

217
00:21:28,930 --> 00:21:30,970
ما الّذي يجري؟

218
00:21:32,300 --> 00:21:35,700
.أظنّه كان يحتمي أمامنا فحسب

219
00:21:36,470 --> 00:21:40,570
.شعرتُ في داخله شيئًا كحزن شديد

220
00:21:41,030 --> 00:21:43,270
...حزن شديد

221
00:21:45,370 --> 00:21:47,330
في داخله؟

222
00:23:25,800 --> 00:23:27,700
!لا تستصغروا من أبي

223
00:23:27,770 --> 00:23:31,730
!أبي صادق! أبي شخص عظيم

224
00:23:32,030 --> 00:23:34,870
،أنتم لا تعرفون عنه شيئًا

225
00:23:34,930 --> 00:23:37,130
!لذا كفّوا عن الحديث عنه

226
00:23:38,230 --> 00:23:41,730
:في الحلقة القادمة

227
00:23:42,300 --> 00:23:43,400
"الماضي"

228
00:23:43,700 --> 00:23:46,970
...لا بدّ أنّك عانيت كثيرًا

229
00:23:47,130 --> 00:23:51,970
.أبليت حسنًا بتحمّلك. لكن انتهى كلّ شيء الآن