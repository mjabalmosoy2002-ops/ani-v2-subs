1
00:00:05,430 --> 00:00:09,070
مرحبًا أيّها الجيوبي... هل كنت تحسن التصرّف؟

2
00:00:09,630 --> 00:00:11,230
أذلك جيوبي؟

3
00:00:24,470 --> 00:00:25,830
.لا يصدّق

4
00:00:25,970 --> 00:00:28,800
!يبدو الآن مثل الأوتسوتسكي الّذي رأيته قبل قليل

5
00:00:32,900 --> 00:00:35,630
!عليّ أن أبلغ ناروتو بأسرع وقت

6
00:02:23,830 --> 00:02:26,260
!حسنًا، سأذهب لأتدرّب

7
00:02:27,860 --> 00:02:30,230
.حاول أن تتفاهم مع أبي

8
00:02:32,130 --> 00:02:34,160
ماذا يعتبرني؟ طفل؟

9
00:02:39,630 --> 00:02:41,630
.أشعر بالنّعاس نوعًا ما اليوم

10
00:02:41,800 --> 00:02:44,030
!هذا ما أودّ قوله

11
00:02:44,430 --> 00:02:46,230
،كلّ ذلك لأنّني تورّطت مع ذلك الشّخص

12
00:02:46,300 --> 00:02:47,660
...مع أنّ الأمر لا يعنيني

13
00:02:50,100 --> 00:02:51,330
.لا شيء

14
00:02:51,960 --> 00:02:54,230
.سأنام لفترة، لذا لا توقظني

15
00:02:54,830 --> 00:02:56,200
.حسنًا، حسنًا

16
00:03:01,900 --> 00:03:04,930
كاواكي، ماذا تفعل؟

17
00:03:05,930 --> 00:03:09,960
.تنقصني شظيّة واحدة فحسب من المزهريّة

18
00:03:10,600 --> 00:03:13,900
.أشكّ أنّك ستجدها الآن

19
00:03:14,360 --> 00:03:16,430
.هيناتا تنظّف كلّ يوم

20
00:03:17,130 --> 00:03:18,800
...قد تكون محقًّا، لكن

21
00:03:19,530 --> 00:03:22,330
.لا أستطيع تركَ الأمر إلى أن أتفقّد بنفسي

22
00:03:22,860 --> 00:03:25,130
رغم ذلك، فعلت ما يكفي، أليس كذلك؟

23
00:03:25,630 --> 00:03:28,100
.تمّ ترميمها بالكامل تقريبًا

24
00:03:29,100 --> 00:03:33,530
ما المرمّم في مزهريّة بثقب وتسرّب؟

25
00:03:34,200 --> 00:03:35,230
...أنت

26
00:03:36,760 --> 00:03:41,160
.قول مثل هذا الكلام المستهتر هو ما يجعل بوروتو يصرخ عليك

27
00:03:42,200 --> 00:03:43,200
!معك حقّ

28
00:03:44,730 --> 00:03:47,860
!أشعر وكأنّني كسبتُ ابنًا صارمًا آخر

29
00:03:50,500 --> 00:03:53,930
...أنا

30
00:03:55,100 --> 00:03:56,530
.لستُ ابنك

31
00:04:02,530 --> 00:04:05,100
!سحقًا! خسرتُ ثانيةً

32
00:04:05,160 --> 00:04:06,800
!تبًّا

33
00:04:06,860 --> 00:04:08,600
!أنت قويّ للغاية

34
00:04:08,760 --> 00:04:10,530
!تساهل معي أحيانًا

35
00:04:10,930 --> 00:04:14,960
.آسف يا إيوابي، تكتيكاتك القتاليّة صريحة للغاية

36
00:04:15,230 --> 00:04:18,300
.لن تهزمني أبدًا ما لم تغيّرها

37
00:04:18,660 --> 00:04:21,730
.هذا يعني أنّنا سنأكل على حساب فريقك ثانيةً

38
00:04:22,230 --> 00:04:24,630
.أريد بعض حلويات مسحوق الفول المحمّص

39
00:04:24,700 --> 00:04:25,530
.شكرًا

40
00:04:26,860 --> 00:04:29,530
.آسف يا دينكي، هلّا ساعدتني

41
00:04:29,730 --> 00:04:31,630
!أحتاج قوّتك الماليّة فحسب

42
00:04:32,030 --> 00:04:33,460
!ثانيةً؟

43
00:04:33,530 --> 00:04:36,260
!ما كان يجب أن تفعل هذا إلّم تكن لديك أيّ فرصة للفوز

44
00:04:36,330 --> 00:04:38,600
!كان ينبغي أن أفوز هذه المرّة

45
00:04:38,700 --> 00:04:41,560
.تقول ذلك، لكنّك خسرت ثمان مرّات على التّوالي

46
00:04:41,830 --> 00:04:46,200
!استخدم نفوذ شركتك لتغيير قواعد البطاقات، كي أفوز

47
00:04:46,260 --> 00:04:48,960
!هذا مستبعد تمامًا

48
00:04:51,660 --> 00:04:53,860
غير ذلك... الأمور مسالمة حقًّا، أليس كذلك؟

49
00:04:54,060 --> 00:04:56,360
.لم نحظ بأيّ مهامّ كبيرة مؤخّرًا

50
00:04:58,000 --> 00:05:01,700
رفاق، ما رأيكم بذلك الشّخص؟

51
00:05:02,360 --> 00:05:03,500
ذلك الشّخص؟

52
00:05:04,100 --> 00:05:05,400
.أقصد كاواكي

53
00:05:06,760 --> 00:05:09,630
،يبدو أنّ السّابع يراقبه

54
00:05:09,800 --> 00:05:12,430
لكن أينبغي أن نثق به بسهولة؟

55
00:05:12,900 --> 00:05:15,260
تقصد أنّه قد يكون "جاسوسًا عدوًّا"؟

56
00:05:15,700 --> 00:05:18,900
،على أبي أن يراقب الأشياء المشكوك في أمرها لأنّه عمله

57
00:05:18,960 --> 00:05:21,660
.لكن يبدو أنّه يثق به على مستوى شخصيّ

58
00:05:22,330 --> 00:05:23,960
،في الجانب الآخر

59
00:05:24,030 --> 00:05:26,200
.أخبرتني أمّي أن أظلّ بعيدًا عنه

60
00:05:26,560 --> 00:05:29,960
.في الواقع، من الطّبيعيّ أن يشعر الآباء هكذا

61
00:05:30,530 --> 00:05:33,200
.أبي محتاط بدوره

62
00:05:33,500 --> 00:05:35,130
!الوسامة ليست جريمة

63
00:05:35,200 --> 00:05:37,600
.أظنّ أنّ من الرّائع أن تكون رائعًا وغامضًا

64
00:05:37,930 --> 00:05:40,400
.لم أقابله سوى مؤخّرًا لكن فكّرتُ أنّه شخص لطيف

65
00:05:40,800 --> 00:05:44,500
.ويبدو أنّه يتفاهم تدريجيًّا مع بوروتو أيضًا

66
00:05:44,860 --> 00:05:49,130
.لستُ واثقًا. لا أحبّه

67
00:05:49,460 --> 00:05:50,360
حقًّا؟

68
00:05:50,800 --> 00:05:53,830
...رأيته قبل أيّام مع السّابع

69
00:05:57,900 --> 00:05:59,330
.كان عدوانيًّا حقًّا

70
00:05:59,400 --> 00:06:02,760
.حدّق بي وبدا وكأنّه قد يعضّني

71
00:06:04,160 --> 00:06:07,300
!هكذا كنت في البداية تمامًا

72
00:06:07,830 --> 00:06:09,660
!لا تذكر ذلك

73
00:06:09,800 --> 00:06:11,860
،إنّه عدوانيّ بالفعل

74
00:06:11,930 --> 00:06:15,030
!لكن أظنّ أنّه صادق بشكل مفاجئ وشخص طيّب

75
00:06:15,330 --> 00:06:17,660
!ميتال! تعلم ما أقصده

76
00:06:17,730 --> 00:06:19,300
!الوسامة ليست جريمة

77
00:06:19,800 --> 00:06:21,330
صادق؟

78
00:06:21,930 --> 00:06:23,460
.آمل ذلك

79
00:06:57,260 --> 00:07:00,200
.مضى وقت طويل مذ الحادثة مع ديلتا

80
00:07:04,260 --> 00:07:09,000
...ظننت أنّني سأرى بعض التحرّكات إن واصلت في مراقبته

81
00:07:09,200 --> 00:07:11,300
.لكن لم يحدث أيّ شيء بعد

82
00:07:12,360 --> 00:07:16,660
.لا بدّ أنّه علمَ من ديلتا أنّ بوروتو يملك الوتد أيضًا

83
00:07:18,030 --> 00:07:20,800
ما الّذي يدبّر له؟

84
00:07:29,800 --> 00:07:31,800
!مرحبًا يا إينو-سان

85
00:07:32,030 --> 00:07:34,360
.مرحبًا يا سارادا-تشان

86
00:07:34,830 --> 00:07:38,300
.أتيت لأخذ الأزهار الّتي طلبت أمّي

87
00:07:39,930 --> 00:07:41,700
.لقد أعددتها

88
00:07:42,430 --> 00:07:44,260
!عجبًا، إنّها جميلة

89
00:07:44,330 --> 00:07:45,900
!شكرًا جزيلًا

90
00:07:46,600 --> 00:07:49,230
هديّة لساسكي إذًا؟

91
00:07:49,630 --> 00:07:53,100
.مهما كبرت، لا تزال ساكورا كفتاة يافعة واقعة في الحبّ

92
00:07:54,700 --> 00:07:56,930
.أشعر بالخجل من مشاهدتها

93
00:07:57,130 --> 00:07:58,700
!لا ضير في ذلك

94
00:07:58,760 --> 00:08:00,800
.حتّى أنّني أشعر ببعض الغيرة

95
00:08:01,560 --> 00:08:02,860
.كدتُ أنسى

96
00:08:03,130 --> 00:08:06,630
هلّي ببعض من تلك بشكل منفصل؟

97
00:08:06,900 --> 00:08:09,660
هل ستعطين أحدًا هديّة أيضًا؟

98
00:08:10,130 --> 00:08:13,000
...أجل، نوعًا ما

99
00:08:21,700 --> 00:08:22,800
!الأخيرة

100
00:08:24,400 --> 00:08:25,760
ماذا؟

101
00:08:30,030 --> 00:08:33,500
.ليس من عادتك أن تفقد ثباتك هكذا

102
00:08:33,860 --> 00:08:35,200
!مؤلم

103
00:08:35,500 --> 00:08:38,430
.لا، كان ذلك أكثر من الغريب

104
00:08:38,860 --> 00:08:41,360
.هذه أوّل مرّة يحدث لي هذا مذ أصبحتُ نينجا

105
00:08:42,030 --> 00:08:43,900
.تجمّد جسدي فجأة

106
00:08:44,160 --> 00:08:45,060
حقًّا؟

107
00:08:48,260 --> 00:08:50,000
!بوروتو، يدك اليمنى

108
00:08:52,660 --> 00:08:54,200
!علامة الوتد

109
00:08:54,330 --> 00:08:56,860
أحدث ذلك بسبب هذا؟

110
00:08:57,360 --> 00:08:58,800
ألم تفعل ذلك قصدًا؟

111
00:08:59,160 --> 00:09:03,160
.لا أستطيع إخراجه بإرادتي بعد

112
00:09:04,130 --> 00:09:08,660
...بل يتفعّل من نفسه فحسب في القتال... أو عندما

113
00:09:09,860 --> 00:09:12,530
.يتجاوب مع وتد كاواكي

114
00:09:13,100 --> 00:09:16,760
كاواكي...أيعقل أنّ شيئًا ما حدث له؟

115
00:09:18,530 --> 00:09:21,960
...لكنّ السّابع معه، لذا يفترض أن يكون بخير

116
00:09:27,760 --> 00:09:31,330
...يساورني شعور سيّئ حيال هذا

117
00:09:34,800 --> 00:09:35,560
.ها قد انتهيت

118
00:09:35,630 --> 00:09:39,230
.حسنًا يا ناروتو، سأذهب للتسوّق في البقالة من أجل العشاء

119
00:09:39,730 --> 00:09:41,030
!إلى اللّقاء

120
00:09:41,600 --> 00:09:44,060
!حسنًا، كوني حذرة

121
00:09:46,730 --> 00:09:49,430
!أعتذر على وضعك في هذا الموقف يا كونوهامارو

122
00:09:49,830 --> 00:09:52,430
!لا بأس، هذا جزء من مهمّتي

123
00:09:56,660 --> 00:10:00,900
أظنّني لا أملك طريقة عدا ملء الثّقب بطريقة أخرى إذًا؟

124
00:10:14,660 --> 00:10:19,160
...سيظنّ أنّني أتصرّف بفضول فحسب على الأغلب

125
00:10:19,860 --> 00:10:23,530
أيعقل أنّ تلك الأزهار لكاواكي؟

126
00:10:24,200 --> 00:10:26,600
.يبدو أنّهم يتفاهمون جميعًا أفضل ممّا توقّعت

127
00:10:30,760 --> 00:10:34,000
!ما هذه التشّاكرا الشرّيرة بشكل لا يصدّق؟

128
00:10:36,860 --> 00:10:39,700
!—ما الّذي يجري؟! إنّ وتدي

129
00:10:46,630 --> 00:10:48,130
!كاواكي، ما الخطب؟

130
00:11:16,660 --> 00:11:17,630
ما—؟

131
00:11:18,260 --> 00:11:19,360
!ماذا؟

132
00:11:33,200 --> 00:11:35,760
!أيّها الوغد! جيغن

133
00:11:48,400 --> 00:11:50,800
!بوروتو، إنّ الوتد خاصّتك يستمرّ في الانتشار

134
00:11:51,300 --> 00:11:53,730
!لقد حدث شيء لكاواكي بكلّ تأكيد

135
00:11:53,970 --> 00:11:55,230
!علينا أن نسرع

136
00:11:59,170 --> 00:12:00,230
أليس ذلك—؟

137
00:12:00,570 --> 00:12:02,270
...إنّهما بوروتو وميتسكي

138
00:12:02,430 --> 00:12:06,000
.أتساءل لمَ هما مستعجلان هكذا

139
00:12:10,500 --> 00:12:11,500
!جيغن

140
00:12:13,170 --> 00:12:17,230
...افترضتُ أنّه سيحاول استرجاع كاواكي

141
00:12:17,300 --> 00:12:19,530
!لكن بأن يظهر شخصيًّا؟

142
00:12:19,930 --> 00:12:21,000
!مستحيل

143
00:12:21,070 --> 00:12:22,700
،إن كان هذا ممكن من البداية

144
00:12:22,770 --> 00:12:26,100
!إذًا لم يكن هناك أيّ حاجة لمهمّة لاسترجاع الوعاء

145
00:12:31,100 --> 00:12:34,370
...ظننتُ أنّني أتحقّق في نوايا جيغن الحقيقيّة من حلال تحرّكاته

146
00:12:34,430 --> 00:12:37,600
!لكن يبدو أنّ دوافعي هي من كان يُحقّق بها

147
00:12:39,500 --> 00:12:43,030
.ممّا أرى، يبدو أنّ هذه غرفة المعيشة

148
00:12:44,530 --> 00:12:50,530
.أعتذر عن الدّخول بحذائي يا أوزوماكي ناروتو

149
00:12:53,400 --> 00:12:55,570
.لا أكترث لذلك

150
00:12:56,300 --> 00:12:57,930
أنت جيغن، أليس كذلك؟

151
00:12:59,100 --> 00:13:00,470
.أردتُ لقاءك

152
00:13:01,370 --> 00:13:06,170
.أتيتُ لإعادة ابني العنيد إلى البيت فحسب

153
00:13:07,970 --> 00:13:10,900
.لا أنوي أن أتسبّب لك بأيّ متاعب

154
00:13:11,970 --> 00:13:15,530
.مع أنّني محبط قليلًا لأنّ بوروتو ليس هنا

155
00:13:15,770 --> 00:13:18,330
!كيف تجرؤ على التكلّم باستهتار هكذا

156
00:13:22,370 --> 00:13:22,970
!إنّه سريع

157
00:13:27,900 --> 00:13:29,770
!أيّها السّابع، ماذا حدث؟

158
00:13:29,830 --> 00:13:31,330
!انتظر! لا تقترب أكثر

159
00:13:31,930 --> 00:13:33,230
!ابتعدوا من هنا يا رفاق

160
00:13:34,470 --> 00:13:35,930
ما بال هذه الأوتاد؟

161
00:13:36,230 --> 00:13:37,570
!إنّ التشّاكرا خاصّتي تُمتصّ

162
00:13:38,000 --> 00:13:39,800
!أيّها السّابع، سنساعدك

163
00:13:42,500 --> 00:13:43,730
!أيّها الوغد

164
00:13:45,670 --> 00:13:47,630
.سألهو معك قليلًا

165
00:13:47,700 --> 00:13:48,870
!لا تعبث معي

166
00:13:54,300 --> 00:13:56,030
!راسنغان

167
00:13:57,170 --> 00:13:58,000
!ماذا؟

168
00:14:01,370 --> 00:14:06,030
أهذا أفضل ما لدى جونين قرية الورق؟

169
00:14:07,330 --> 00:14:08,500
!—أيّها الـ

170
00:14:12,430 --> 00:14:13,700
!كونوهامارو

171
00:14:14,900 --> 00:14:17,600
.لا تتسبّب بأيّ مشاكل

172
00:14:18,670 --> 00:14:22,130
...والآن أيّها الابن المتمرّد

173
00:14:22,730 --> 00:14:25,400
.انتهت العطلة. حان الوقت لتعود إلى بيتك

174
00:14:25,830 --> 00:14:27,630
.لستُ ابنك

175
00:14:28,270 --> 00:14:32,670
!لم أعتبرك والدي يومًا

176
00:14:33,700 --> 00:14:35,970
.إن كنت تعرف مصلحتك، فانهض

177
00:14:36,830 --> 00:14:39,230
أم تريد أن تتأذّى ثانيةً؟

178
00:14:42,530 --> 00:14:46,130
.تعلم أنّك لا تستطيع عصياني

179
00:14:47,200 --> 00:14:48,430
!أيّها الوغد

180
00:14:52,100 --> 00:14:57,200
!أخبرني كيف أتخلّص من هذه العلامة المقزّزة الّتي وضعت عليّ

181
00:14:58,270 --> 00:15:03,130
أتقول أنّك تحبّ تلك اليد اليمنى
اللّعبة الّتي حصلت عليها من الهوكاغي

182
00:15:03,200 --> 00:15:06,300
أكثر من الوتد الّذي وهبتك إيّاه؟

183
00:15:08,130 --> 00:15:09,800
.فكّر جيّدًا

184
00:15:10,230 --> 00:15:15,000
ما أدراك أنّها ليست جهازًا للتجسّس عليك؟

185
00:15:17,400 --> 00:15:21,630
...من هذا المنطق، فهي لا تختلف عن الوتد الّذي أعطيتك

186
00:15:21,870 --> 00:15:24,070
.بل ذات الشّيء

187
00:15:24,300 --> 00:15:25,330
!اخرس

188
00:15:25,670 --> 00:15:27,830
!الهوكاغي ليس مثلك

189
00:15:30,970 --> 00:15:32,500
.العبارات تخونني

190
00:15:33,000 --> 00:15:36,130
.أفق الآن يا كاواكي

191
00:15:39,200 --> 00:15:45,000
.إنّ الهوكاغي وهذه القرية يستغلّونك فحسب

192
00:15:45,900 --> 00:15:49,300
.لا مكان هنا لشخص فارغ مثلك

193
00:15:51,870 --> 00:15:54,900
.أصغ جيّدًا يا كاواكي

194
00:15:55,400 --> 00:15:59,870
.أنا الوحيد الّذي يتصرّف حقًّا في مصلحتك

195
00:16:01,070 --> 00:16:05,570
.لستُ جبانًا مهووسًا بالسّلام كالهوكاغي

196
00:16:06,000 --> 00:16:09,370
...لا يأبه سوى لإبقاء السّلام في قريته

197
00:16:10,230 --> 00:16:13,130
.لست جزءًا من تلك الصّورة

198
00:16:14,770 --> 00:16:16,800
...انتظر فحسب يا كاواكي

199
00:16:16,870 --> 00:16:17,870
!أنا آتٍ

200
00:16:18,530 --> 00:16:21,030
.مثير للشّفقة

201
00:16:22,470 --> 00:16:25,570
...هو وذراعه اليمنى

202
00:16:25,870 --> 00:16:28,500
.عندما نعود إلى الدّيار، سأصلح ذراعك

203
00:16:28,670 --> 00:16:30,400
.لا أطيق النّظر لها

204
00:16:32,070 --> 00:16:33,000
...اسمع

205
00:16:33,800 --> 00:16:35,400
...أيّها الأصلع

206
00:16:36,900 --> 00:16:42,530
...أنت وغد مقرف... لذا

207
00:16:48,900 --> 00:16:53,130
!إيّاك والتّقليل من احترام السّابع

208
00:16:55,130 --> 00:16:59,000
متى تقدّم بهذا القدر؟

209
00:17:01,530 --> 00:17:03,300
!أذلك ما أظنّه؟ مستحيل

210
00:17:04,570 --> 00:17:06,270
!يا ناروتو

211
00:17:06,330 --> 00:17:07,700
.هذا مثير للشّفقة

212
00:17:07,770 --> 00:17:09,430
أتدعو نفسك الهوكاغي؟

213
00:17:10,370 --> 00:17:12,000
.اخرس يا كوراما

214
00:17:12,070 --> 00:17:15,030
.لا أستطيع خلع هذه الأشياء لوحدي

215
00:17:15,700 --> 00:17:19,300
.أظنّ أنّ هذا يُعتبر حالة طارئة

216
00:17:23,800 --> 00:17:24,730
!كاواكي

217
00:17:27,930 --> 00:17:29,070
.سيكون الأمر بخير

218
00:17:29,430 --> 00:17:30,770
.انتظر قليلًا فحسب

219
00:17:33,170 --> 00:17:36,530
.فهمت. قوّة الكيوبي

220
00:17:36,870 --> 00:17:39,600
أتنوي التدخّل مهما كان؟

221
00:17:39,730 --> 00:17:44,870
!ما تفعله لا يبدو لي كتربية لائقة

222
00:17:47,330 --> 00:17:48,770
.حسنًا

223
00:17:50,530 --> 00:17:54,670
!سأتخلّص منك يا أوزوماكي ناروتو

224
00:18:11,300 --> 00:18:13,900
.لا تقارن ديلتا بهذا الشّخص مطلقًا

225
00:18:14,130 --> 00:18:16,100
!استخدام التّايجيتسو لوحده سيتركك في وضعٍ سيّئ

226
00:18:16,170 --> 00:18:20,800
!أدري ذلك، لكن لا يمكنني أن أستخدم هجومًا كبيرًا هنا

227
00:18:23,600 --> 00:18:27,570
هل تريد أن تواصل القتال أيّها الهوكاغي؟

228
00:18:29,530 --> 00:18:32,670
.لا أمانع

229
00:18:37,570 --> 00:18:38,670
!أيّها السّابع

230
00:18:39,430 --> 00:18:44,200
.من المزعج أن تكون بحاجة لحماية الكثير

231
00:18:48,870 --> 00:18:54,070
.لنرَ كم تستطيع حمايتهم

232
00:18:57,070 --> 00:18:58,900
!هل سيفعل ذلك هنا؟

233
00:19:09,770 --> 00:19:11,370
!حسنًا، أستسلم

234
00:19:11,430 --> 00:19:12,830
!توقّف يا جيغن

235
00:19:15,270 --> 00:19:16,870
!سأمتثل لأمرك

236
00:19:17,870 --> 00:19:19,500
!أسرع وأعدني

237
00:19:19,570 --> 00:19:21,430
!كاواكي، أنت—؟

238
00:19:21,900 --> 00:19:26,730
!فقط عدني أنّك لن تمسّ السّابع بضرّ

239
00:19:27,230 --> 00:19:28,830
!انتظر لحظة

240
00:19:29,100 --> 00:19:30,700
!من أين يستمدّ كلّ هذا؟

241
00:19:31,530 --> 00:19:33,970
.لا يمكن التّعامل معه مثل ديلتا

242
00:19:34,270 --> 00:19:36,800
!حتّى أنت لن تنجو إن قاتلته

243
00:19:37,500 --> 00:19:42,070
!أفضّل أن أكون سجينه... على أن أفقدك

244
00:19:43,800 --> 00:19:44,600
...كاواكي

245
00:19:46,900 --> 00:19:47,900
.حسنًا

246
00:19:48,570 --> 00:19:52,670
.ما دمتَ مطيعًا، فلا مشكلة

247
00:19:53,470 --> 00:19:56,070
.تعال إلى هنا يا كاواكي

248
00:19:56,830 --> 00:19:58,230
.قلت لا مشكلة

249
00:19:58,300 --> 00:20:00,000
!بل إنّ هذه لمشكلة كبيرة أيّها الوغد

250
00:20:00,630 --> 00:20:02,330
!توقّف، هذا يكفي

251
00:20:02,800 --> 00:20:05,600
!لا علاقة لك بهذا من الأساس

252
00:20:05,930 --> 00:20:06,830
!اغرب

253
00:20:06,970 --> 00:20:08,700
!لا أستطيع

254
00:20:09,070 --> 00:20:12,700
.إنّه واجبي كهوكاغي أن أحمي الجميع في القرية—عائلتي

255
00:20:12,830 --> 00:20:14,170
!لا توجد أيّ استثناءات

256
00:20:14,230 --> 00:20:15,800
!ولهذا بالضّبط لا يجب أن تفعل ذلك

257
00:20:15,870 --> 00:20:20,070
.أنت مخطئ. هذا يشملك يا كاواكي

258
00:20:21,930 --> 00:20:23,230
!أيّها السّابع

259
00:20:27,470 --> 00:20:29,630
.لا أطيق الإصغاء لهذا

260
00:20:33,600 --> 00:20:37,370
!لنحسم هذا بالطّريقة البسيطة إذًا

261
00:20:39,870 --> 00:20:42,370
!توقّف يا جيغن! لا تفعل

262
00:20:53,570 --> 00:20:55,030
...أيّها السّابع

263
00:21:10,300 --> 00:21:11,530
أين نحن؟

264
00:21:11,700 --> 00:21:14,930
.إنّه بعد آخر عن الّذي كنتَ فيه

265
00:21:15,130 --> 00:21:17,830
.إنّه عالم دون قرية الورق

266
00:21:19,100 --> 00:21:22,530
.والآن، هذا الوداع يا أوزوماكي ناروتو

267
00:21:22,830 --> 00:21:25,070
.سأتركك هنا

268
00:21:25,200 --> 00:21:26,200
!ماذا؟

269
00:21:26,500 --> 00:21:29,500
.اعتن بنفسك أيّها السّابع

270
00:21:30,930 --> 00:21:32,070
!انتظر

271
00:21:34,800 --> 00:21:37,670
.أهملت دفاعك أيّها الفاشل

272
00:21:38,600 --> 00:21:39,570
!ساسكي؟

273
00:21:39,870 --> 00:21:41,970
.نينجيتسو الانتقال الآنيّ

274
00:21:42,300 --> 00:21:43,830
.أوتشيها ساسكي

275
00:21:44,270 --> 00:21:46,530
تعقّبت تشاكرا الهوكاغي إلى هنا، أليس كذلك؟

276
00:21:47,330 --> 00:21:48,830
.هذا ممتاز

277
00:21:48,900 --> 00:21:52,870
.سأضع نهاية لكما معًا ها هنا

278
00:23:25,480 --> 00:23:27,220
...ناروتو وساسكي

279
00:23:27,280 --> 00:23:30,420
.أمكنكما أن تهربا دون أن تخوضا معركةً لا طائل منها

280
00:23:30,620 --> 00:23:32,820
.ذلك يعتمد على كيف تفكّر في الأمر

281
00:23:33,420 --> 00:23:34,980
،إن قمنا بسحقك هنا

282
00:23:35,050 --> 00:23:37,050
فسيكون ذلك قد استحقّ عناء المجيء إلى هنا، صحيح؟

283
00:23:37,120 --> 00:23:38,820
!أجل، هذا صحيح

284
00:23:38,880 --> 00:23:40,020
.هذا ممتاز

285
00:23:40,080 --> 00:23:42,820
.يمكننا القتال بكلّ قوّتنا هنا دون الحاجة للقلق

286
00:23:43,520 --> 00:23:46,420
:في الحلقة القادمة

287
00:23:46,650 --> 00:23:48,250
"إنّه خطير"

288
00:23:51,220 --> 00:23:53,150
.إنّكما تدفعاني للضّحك