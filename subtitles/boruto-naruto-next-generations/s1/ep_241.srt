1
00:00:40,570 --> 00:00:41,610
!سيرين-ساما

2
00:00:42,210 --> 00:00:44,740
.سمعنا بعودة أراومي-ساما

3
00:00:44,980 --> 00:00:47,150
!يا لها من أنباء سارّة

4
00:00:49,130 --> 00:00:50,110
!أحضره ها هنا

5
00:00:52,120 --> 00:00:54,390
.اقبلي هذا رجاءً

6
00:00:54,950 --> 00:00:57,720
.اقبلي بعودة عشيرتنا إلى الفوناتو مرّة أخرى أرجوك

7
00:00:57,820 --> 00:01:00,630
لمَ أتيت إلى هنا بظنّك؟

8
00:01:01,030 --> 00:01:03,730
.لأنّ هناك ما أسأله

9
00:01:04,430 --> 00:01:05,430
المعذرة؟

10
00:01:07,100 --> 00:01:09,070
لمَ خنتنا؟

11
00:01:09,530 --> 00:01:10,540
!خنتكم؟

12
00:01:11,340 --> 00:01:12,970
أتقصدينني؟

13
00:01:12,970 --> 00:01:15,370
!لا ندري عمّاذا تتحدّثين

14
00:01:15,440 --> 00:01:16,440
أليس كذلك؟

15
00:01:16,510 --> 00:01:17,510
!هذا صحيح

16
00:01:17,740 --> 00:01:19,110
!هذا غير ممكن

17
00:01:19,240 --> 00:01:21,950
!دائمًا كنّا أوفياء لأراومي-ساما والبقيّة

18
00:01:22,010 --> 00:01:23,410
!لا تكذبوا

19
00:01:25,980 --> 00:01:28,090
،بمجرّد أن قُبض على أبي

20
00:01:28,150 --> 00:01:29,890
خنتم الفوناتو

21
00:01:29,990 --> 00:01:32,190
.وتواطأتم مع شينوبي قرية الضّباب

22
00:01:32,560 --> 00:01:35,030
هل ظننتم أنّنا لن نعرف ذلك؟

23
00:01:35,030 --> 00:01:36,360
...كان ذلك

24
00:01:36,760 --> 00:01:39,000
!لا أملك الوقت للأعذار

25
00:03:34,460 --> 00:03:35,460
.جيّد

26
00:03:35,530 --> 00:03:36,530
حقًّا؟

27
00:03:36,900 --> 00:03:37,900
.أجل

28
00:03:38,130 --> 00:03:40,000
لقد تحسّنت، أليس كذلك يا إيكادا؟

29
00:03:42,000 --> 00:03:43,000
!أجل

30
00:03:43,070 --> 00:03:44,240
ما حال السّفينة؟

31
00:03:44,640 --> 00:03:49,070
.سننتهي من الإصلاح فور أن نحصّن الهيكل من الماء

32
00:03:49,940 --> 00:03:51,040
كم سيستغرق ذلك؟

33
00:03:53,350 --> 00:03:56,050
.يومان إلى ثلاثة أيّام على ما أظنّ

34
00:03:56,380 --> 00:03:57,950
!أنتَ مُنقِذ يا إيكادا

35
00:03:58,750 --> 00:03:59,750
.يمكننا العودة إلى الدّيار الآن

36
00:03:59,990 --> 00:04:02,920
!ما كنّا لنستطيع النّجاح لولاك أيّها الزّعيم كاجيكي والجميع

37
00:04:18,040 --> 00:04:19,640
!إنّه لذيذ

38
00:04:19,810 --> 00:04:20,810
أليس كذلك؟

39
00:04:20,940 --> 00:04:24,110
.تفاجأت عندما جرّبتها للمرّة الأولى عندما أتيت إلى هنا

40
00:04:24,710 --> 00:04:29,110
.أريد أن يجرّبها الكثير من النّاس من دول مختلفة

41
00:04:41,790 --> 00:04:43,960
أفكّر في بناء سفينة كبيرة يومًا ما

42
00:04:44,330 --> 00:04:46,830
...حتّى أجمع شمل النّاس

43
00:04:47,970 --> 00:04:49,900
.هذا حلم عظيم

44
00:04:51,000 --> 00:04:52,840
،من أجل تحقيق ذلك الحلم

45
00:04:53,310 --> 00:04:56,940
.أنا بحاجة للبقاء مع الزّعيم لأتعلّم المزيد عن بناء السّفن

46
00:04:57,710 --> 00:05:01,050
،وما زال عليّ تعلّم الكثير من الأشياء

47
00:05:01,110 --> 00:05:05,150
...وليس عن المحيط فحسب، بل حتّى عن السّماء والرّيح والطّقس

48
00:05:09,150 --> 00:05:11,790
...لا أدري كم سيستغرق ذلك من سنة، ولكن

49
00:05:12,990 --> 00:05:16,830
.سأوصل هذه المكسّرات لك بنفسي يومًا ما

50
00:05:17,000 --> 00:05:18,000
حقًّا؟

51
00:05:18,100 --> 00:05:19,130
!أتطلّع لذلك

52
00:05:30,110 --> 00:05:32,040
.تفضّل وكل رجاءً

53
00:05:32,580 --> 00:05:34,050
!هناك أطباق إضافيّة

54
00:05:34,910 --> 00:05:35,900
!تفضّل

55
00:05:36,950 --> 00:05:39,250
.يبدو أنّهم أوشكوا على إصلاح السّفينة

56
00:05:39,790 --> 00:05:41,920
.ما يعني أنّنا سنغادر قريبًا

57
00:05:42,550 --> 00:05:44,990
إلى حياة السّجن إذًا؟

58
00:05:47,090 --> 00:05:49,030
،حسنٌ، علينا أن نعود في الوقت الرّاهن

59
00:05:49,130 --> 00:05:50,200
.لكن ما باليد حيلة

60
00:05:50,360 --> 00:05:51,530
.هذا صحيح

61
00:05:52,030 --> 00:05:55,000
،مع ذلك، إن تمّت الموافقة على أوراق تخفيض عقوباتنا

62
00:05:55,170 --> 00:05:57,300
.فسنستطيع الخروج قريبًا

63
00:05:57,740 --> 00:05:59,340
...آمل ذلك حقًّا

64
00:06:00,160 --> 00:06:02,610
.قمنا بكلّ ذلك العمل أيضًا

65
00:06:03,180 --> 00:06:06,280
!قد يعفون عنّا حتّى

66
00:06:07,280 --> 00:06:08,280
.أشكّ في ذلك

67
00:06:12,920 --> 00:06:15,690
.أنتما الاثنان متشائمان للغاية

68
00:06:20,590 --> 00:06:22,460
!مكسّرات الحبّار

69
00:06:32,000 --> 00:06:33,070
.اعتن بالأمور أثناء غيابي

70
00:06:33,710 --> 00:06:34,710
.حاضر

71
00:06:54,790 --> 00:06:57,000
...مكسّرات الحبّار

72
00:07:02,130 --> 00:07:03,900
،يبدو أنّك اعتدتَ حقًّا على حياة بنّائي السّفن

73
00:07:03,900 --> 00:07:04,900
أليس كذلك؟

74
00:07:09,570 --> 00:07:11,440
.لم أرك منذ مدّة يا إيكادا

75
00:07:13,480 --> 00:07:14,480
...أختي

76
00:07:20,950 --> 00:07:22,790
.عاد أبانا

77
00:07:23,090 --> 00:07:23,960
.أعلم

78
00:07:24,760 --> 00:07:26,990
.وصلت الإشاعات حتّى هنا

79
00:07:27,430 --> 00:07:28,930
.إذًا هذا يُبسّط الأمور

80
00:07:31,330 --> 00:07:33,030
.أريد منك أن تعود فورًا

81
00:07:33,700 --> 00:07:35,000
،حتّى إن عدت

82
00:07:35,570 --> 00:07:36,840
،بحالتي الحاليّة

83
00:07:37,070 --> 00:07:39,000
.لا يوجد ما أستطيع فعله

84
00:07:39,300 --> 00:07:41,840
.لديك القوّة

85
00:07:42,940 --> 00:07:46,950
.قوّة تنّين الماء الّتي يملكها الجميع في عشيرة فوناتو

86
00:08:01,030 --> 00:08:05,030
.سنبدأ الآن الطّقوس لتحديد قوى الفوناتو خاصّتكم

87
00:08:06,360 --> 00:08:09,370
.الأمواج العاتية ترقص بجنون

88
00:08:09,870 --> 00:08:12,800
.هذا هو اليوم المثاليّ حقًّا لهذه المراسم

89
00:08:14,540 --> 00:08:15,910
!أحضروا إيكادا إلى هنا

90
00:08:16,070 --> 00:08:17,980
!لا أريد فعل هذا

91
00:08:18,080 --> 00:08:19,980
!أنا خائف

92
00:08:20,080 --> 00:08:22,250
!لا أريد

93
00:08:23,950 --> 00:08:25,980
.إيكادا مثير للشّفقة

94
00:08:26,120 --> 00:08:30,120
.يا له من جبان، على الرّغم من كونه فوناتو شرعيّ

95
00:08:30,490 --> 00:08:34,590
.لقد واجهت بحارًا أشرس من هذا البحر اليوم

96
00:08:34,660 --> 00:08:36,030
واجهت؟

97
00:08:36,130 --> 00:08:39,970
ألا تقصد أنّ شخصًا ضعيفًا قام بشيء متهوّر؟

98
00:08:40,030 --> 00:08:41,030
!اخرسي

99
00:08:41,130 --> 00:08:43,500
!اعترف أبي بالرّوح القتاليّة في أفعالي

100
00:08:43,570 --> 00:08:44,570
!تينما

101
00:08:46,070 --> 00:08:47,740
.هذا مكان مقدّس

102
00:08:48,040 --> 00:08:49,540
.صن لسانك

103
00:08:51,040 --> 00:08:51,910
.آسف

104
00:08:56,550 --> 00:08:58,280
،أرنا قوّتك

105
00:08:58,970 --> 00:08:59,950
.يا إيكادا

106
00:09:24,280 --> 00:09:26,040
ربّما مات؟

107
00:10:08,190 --> 00:10:10,620
هل أنقذته الأمواج العاتية؟

108
00:10:11,490 --> 00:10:13,090
.لا يملك أيّ قوى

109
00:10:18,730 --> 00:10:19,730
...إيكادا

110
00:10:20,300 --> 00:10:22,070
...أظهرت لنا

111
00:10:22,670 --> 00:10:23,840
.قواك

112
00:10:24,140 --> 00:10:26,400
!والآن سخّرها من أجل عشيرتنا

113
00:10:29,570 --> 00:10:34,250
.حينها، أظهرت قوّة أكثر من أيّ فرد آخر في عشيرتنا

114
00:10:35,550 --> 00:10:39,050
.في تلك اللّحظة، اعترف بك أبانا

115
00:10:41,050 --> 00:10:46,290
.لديك قوّة أكبر من قوّتي وقوّة أخوانا إيساري وتينما

116
00:10:46,990 --> 00:10:49,130
.لا أذكر ما حدث

117
00:10:49,660 --> 00:10:53,900
.كما أنّني لا أدري حتّى إن أظهرتُ أيّ قوّة

118
00:10:54,630 --> 00:10:57,940
.لا أملك أيّ دليل، على خلافك وأخوانا

119
00:10:58,900 --> 00:11:02,070
.لهذا سخر منّي الجميع لأنّي لا أمتلك أيّ قوى

120
00:11:02,940 --> 00:11:05,210
لكنّك تعلمين ذلك، أليس كذلك؟

121
00:11:05,710 --> 00:11:07,750
ذلك لأنّ أخوانا والجميع

122
00:11:07,910 --> 00:11:09,980
!لا يعرفون قوّتك الحقيقيّة

123
00:11:10,720 --> 00:11:11,720
...لا

124
00:11:11,950 --> 00:11:15,290
،إن سحبني أخي الكبير تينما إلى ساحة المعركة

125
00:11:15,390 --> 00:11:16,450
.فلن أستطيع فعل أيّ شيء

126
00:11:17,190 --> 00:11:18,960
.فسأعيق الجميع فحسب

127
00:11:20,160 --> 00:11:22,130
.لا أحبّ الحرب

128
00:11:22,860 --> 00:11:23,960
،لهذا قبل خمس سنوات

129
00:11:24,230 --> 00:11:25,900
...عندما سُجن أبي

130
00:11:26,700 --> 00:11:29,870
.قرّرت أن أكون مفيدًا لعشيرتنا بطريقة أخرى

131
00:11:30,640 --> 00:11:31,870
.ولهذا أتيت إلى هنا

132
00:11:32,940 --> 00:11:33,940
.إيكادا

133
00:11:34,610 --> 00:11:36,940
،عندما أخبرت الجميع بقراري

134
00:11:37,410 --> 00:11:39,110
عارضه أخي الكبير تينما بشدّة

135
00:11:39,610 --> 00:11:41,980
.ولم يبدُ أخي إيساري سعيدًا بشأنه

136
00:11:42,710 --> 00:11:45,750
.لكنّك حاولت إقناع الجميع

137
00:11:46,220 --> 00:11:48,290
.ولهذا السّبب، أتيت إلى هنا

138
00:11:48,690 --> 00:11:50,060
!لا تسئ الفهم

139
00:11:50,420 --> 00:11:53,930
فكّرت كذلك فقط عندما رأيت كم أنّ
،شعب أرض الماء أصبحوا فاسدين

140
00:11:53,930 --> 00:11:55,030
!لدرجة أنّك ستغيّر رأيك

141
00:11:56,630 --> 00:11:58,130
!والآن عُد حالًا

142
00:11:58,200 --> 00:12:00,470
!هذه مشكلة الفوناتو

143
00:12:00,700 --> 00:12:04,000
.أخبرني الزّعيم أنّي مؤهّل أخيرًا

144
00:12:04,440 --> 00:12:05,740
!بدأتُ لتوّي

145
00:12:06,000 --> 00:12:06,570
!—لذا

146
00:12:06,620 --> 00:12:07,010
!اخرس

147
00:12:07,670 --> 00:12:09,110
!لديك القوّة

148
00:12:09,510 --> 00:12:13,240
!وينبغي أن تُسخّر تلك القوّة من أجل أبينا وعشيرتنا

149
00:12:13,880 --> 00:12:16,980
!وُلدتَ كفوناتو، لذا عليك أن تنفّذ مهمّتك

150
00:12:17,080 --> 00:12:18,750
مهمّة الفوناتو؟

151
00:12:18,950 --> 00:12:19,980
!حان الوقت لذلك

152
00:12:20,150 --> 00:12:21,150
!لا أريد

153
00:12:21,290 --> 00:12:24,090
!أريد البقاء هنا وتحقيق حلمي

154
00:12:24,560 --> 00:12:26,090
!هذه مهمّتي

155
00:12:26,320 --> 00:12:28,190
!لا تكن أنانيًّا

156
00:12:30,230 --> 00:12:35,730
!لا تدري ما مرّت به عشيرتنا في السّنوات الخمس الماضية

157
00:12:36,300 --> 00:12:39,940
!لن ندع أرض الماء يفعلون ما يحلو لهم ببحارنا

158
00:12:40,440 --> 00:12:43,040
هل تنوي أن تظلّ متخلّفًا دون فعل أيّ شيء؟

159
00:12:43,540 --> 00:12:46,080
!هل تعتبر نفسك فوناتو شرعيّ حقًّا؟

160
00:12:52,120 --> 00:12:53,790
.سآتي لأخذك اللّيلة

161
00:12:54,050 --> 00:12:56,090
.جهّز نفسك

162
00:13:13,000 --> 00:13:14,410
شينوبي قرية الورق؟

163
00:13:14,910 --> 00:13:16,880
،بعض الأشخاص الّذين استخدموا سيوف النّينجا

164
00:13:17,080 --> 00:13:19,480
!وشينوبي من قرية الورق فعلوا ذلك

165
00:13:23,980 --> 00:13:25,080
!ممتاز

166
00:13:25,480 --> 00:13:30,590
.سأريهم ما يحدث لمن يعارض الفوناتو

167
00:13:35,460 --> 00:13:37,030
.كنتَ هنا إذًا يا إيكادا

168
00:13:38,960 --> 00:13:39,960
ما الخطب؟

169
00:13:40,530 --> 00:13:42,330
.لا شيء

170
00:13:43,640 --> 00:13:44,640
.فهمت

171
00:13:44,700 --> 00:13:45,840
...هذا جيّد، إذًا

172
00:13:46,640 --> 00:13:47,610
...أجل

173
00:14:11,100 --> 00:14:12,100
هل تريد شيئًا؟

174
00:14:12,370 --> 00:14:13,470
.ليس تمامًا

175
00:14:14,300 --> 00:14:16,200
.أردت أن أحدّثك قليلًا فحسب

176
00:14:18,040 --> 00:14:21,440
هل أنت شينوبي من قرية الورق فعلًا؟

177
00:14:21,610 --> 00:14:22,610
ماذا؟

178
00:14:22,810 --> 00:14:24,240
لمَ قد تظنّ ذلك؟

179
00:14:24,440 --> 00:14:25,450
...لنرَ

180
00:14:25,980 --> 00:14:28,310
.انتابني شعور فحسب

181
00:14:30,220 --> 00:14:31,280
ماذا عنك؟

182
00:14:31,350 --> 00:14:33,150
،أنت سيّاف ماهر

183
00:14:33,450 --> 00:14:35,560
فلمَ تعمل كمدير سجن؟

184
00:14:36,320 --> 00:14:39,230
.طلبتُ أن أصبح مدير سجن بمحض إرادتي

185
00:14:40,060 --> 00:14:41,060
.وأفتخر بذلك

186
00:14:41,830 --> 00:14:42,800
،أيضًا

187
00:14:43,230 --> 00:14:45,730
.يبدو أنك تدعم أولئك الثّلاثة كثيرًا

188
00:14:47,370 --> 00:14:48,570
أدعمهم؟

189
00:14:51,440 --> 00:14:55,510
.يعاني أولئك الّذين اقترفوا أخطاءً من النّدم

190
00:14:56,580 --> 00:14:58,440
.لكن يمكن للنّاس أن يتغيّروا

191
00:14:59,610 --> 00:15:03,320
.ربّما أدعم بونتان والبقيّة كلّ الدّعم

192
00:15:07,350 --> 00:15:09,370
.فالدّماء الملعونة تسري في عروقي

193
00:15:10,760 --> 00:15:11,860
،بسبب ذلك

194
00:15:12,490 --> 00:15:13,490
،كلّما حملتُ سيفًا

195
00:15:13,590 --> 00:15:16,530
.كنتُ أميل لإيذاء أيّ شخص من حولي

196
00:15:23,840 --> 00:15:26,340
.رجل يدعى شيزوما استخدم ماضيّ لاستغلالي

197
00:15:26,970 --> 00:15:28,980
،عندما ضللتُ طريقي

198
00:15:29,340 --> 00:15:32,010
.بوروتو هو من أعادني لطريق الصّواب

199
00:15:32,350 --> 00:15:33,350
بوروتو؟

200
00:15:33,450 --> 00:15:34,450
.نعم

201
00:15:34,680 --> 00:15:38,890
...لهذا السّبب، بالنّسبة لبونتان وهيبيتشيغو وكيوهو

202
00:15:39,790 --> 00:15:42,120
.أريد أن أعيدهم للطّريق الصّواب كما فعل معي بوروتو

203
00:15:48,590 --> 00:15:50,300
...أودّ أن أصير الشّخص

204
00:15:50,800 --> 00:15:52,620
.الّذي يساعدهم في إيجاد طريقهم

205
00:15:54,000 --> 00:15:54,970
...فهمت

206
00:15:57,570 --> 00:15:59,410
!كنتَ هنا إذًا يا كاغورا

207
00:16:00,820 --> 00:16:03,340
.وردتنا رسالة من أرض الماء

208
00:16:07,680 --> 00:16:08,850
،بمجرّد أن وصلنا إلى هنا

209
00:16:09,480 --> 00:16:12,490
.أبلغنا مكتب الميزوكاغي أنّنا سنعود بحرًا

210
00:16:13,520 --> 00:16:16,190
كما أبلغناهم بما فعله بونتان والبقيّة لمساعدتنا

211
00:16:16,260 --> 00:16:18,690
.وسألتهم كيف سيتمّ مكافأتهم

212
00:16:19,330 --> 00:16:20,530
تقصد تخفيض عقوباتهم، صحيح؟

213
00:16:21,130 --> 00:16:22,130
.أجل

214
00:16:23,430 --> 00:16:24,430
كاغورا؟

215
00:16:25,530 --> 00:16:27,430
"،ناقشت الجهات الأمنيّة المسألة"

216
00:16:27,930 --> 00:16:30,240
".وبناء على مجهوداتهم، سنقوم بتخفيض عقوباتهم"

217
00:16:30,700 --> 00:16:31,700
".بثلاث سنوات"

218
00:16:32,140 --> 00:16:33,140
ثلاث سنوات؟

219
00:16:33,440 --> 00:16:34,310
هذا كلّ شيء؟

220
00:16:40,280 --> 00:16:42,680
...هكذا سار الأمر في النّهاية إذًا

221
00:16:43,480 --> 00:16:44,880
!يا للسّخف

222
00:16:47,090 --> 00:16:48,550
.عملوا بجدّ

223
00:16:49,820 --> 00:16:51,360
.أفكّر في تقديم استعطاف آخر

224
00:16:52,330 --> 00:16:53,330
.معك حقّ

225
00:16:53,560 --> 00:16:56,530
.أعلمنا رجاءً إن كان هناك ما نستطيع فعله

226
00:17:06,340 --> 00:17:08,440
.كنتما على حقّ

227
00:17:09,880 --> 00:17:11,680
.كنتُ ساذجة للغاية

228
00:17:12,250 --> 00:17:14,850
!قاموا بتخفيض عقوبتنا بثلاث سنوات فقط

229
00:17:15,250 --> 00:17:18,520
.عندما نعود، سيكون علينا أن نواصل في السّجن

230
00:17:21,790 --> 00:17:22,760
.ما باليد حيلة

231
00:17:23,160 --> 00:17:24,160
ماذا؟

232
00:17:24,260 --> 00:17:25,690
ألا تمانعان هذا؟

233
00:17:26,330 --> 00:17:29,530
!ضقتُ ذرعًا من وعود كاغورا الكاذبة

234
00:17:30,030 --> 00:17:32,700
!خيارنا الوحيد هو الهرب

235
00:17:33,430 --> 00:17:34,430
الهرب؟

236
00:17:34,800 --> 00:17:36,340
.لا يمكننا أن نهرب

237
00:17:36,600 --> 00:17:37,940
.لدينا علامات لعنة

238
00:17:38,340 --> 00:17:39,110
.أجل

239
00:17:39,210 --> 00:17:42,580
.لهذا علينا أن نبطلها فحسب

240
00:17:45,310 --> 00:17:46,310
!هيبيتشيغو

241
00:17:46,450 --> 00:17:47,450
هل...؟

242
00:17:48,450 --> 00:17:49,450
!هذا صحيح

243
00:17:49,980 --> 00:17:52,020
.سأقتل كاغورا

244
00:18:00,360 --> 00:18:03,130
.يبدو أنّ دفاعه مكشوف هذه اللّحظة

245
00:18:03,860 --> 00:18:08,870
.علاوة على ذلك، يبدو أنّه يثق بنا بعد كلّ ما فعلناه

246
00:18:09,440 --> 00:18:12,240
.إن كنّا نريد المحاولة، فهذه فرصتنا

247
00:18:12,340 --> 00:18:16,310
...إن فعلنا ذلك... شينوبي قرية الورق سوف

248
00:18:16,380 --> 00:18:20,310
!لهذا سنفعل ذلك بطريقة لا يكتشفون أمرنا

249
00:18:21,680 --> 00:18:23,850
.هذه هي فرصتنا الأمثل

250
00:18:24,350 --> 00:18:26,790
.إن تركنا هذه الفرصة تمرّنا، فلن نحظى بفرصة أخرى

251
00:18:27,490 --> 00:18:29,090
!لنهرب معًا

252
00:18:31,490 --> 00:18:32,630
ما رأيكما؟

253
00:18:34,390 --> 00:18:35,390
.لستُ مهتمّة فعلًا

254
00:18:38,100 --> 00:18:39,100
لمَ لا؟

255
00:18:39,400 --> 00:18:40,530
لماذا؟

256
00:18:41,030 --> 00:18:42,270
أليس هذا واضحًا؟

257
00:18:42,570 --> 00:18:46,070
.إن هربنا فسنكون مطاردين لبقيّة حياتنا

258
00:18:46,640 --> 00:18:48,110
.وسيقبضون علينا في نهاية الأمر

259
00:18:48,470 --> 00:18:49,680
.هكذا سيسير الأمر

260
00:18:50,510 --> 00:18:52,750
علينا أن نحرص فقط ألّا يمسكوا بنا، صحيح؟

261
00:18:54,150 --> 00:18:55,150
.أخبريني لماذا

262
00:18:55,520 --> 00:18:56,780
هل لديك سبب؟

263
00:19:00,990 --> 00:19:03,220
!كاغورا، لمَ أنقذتني؟

264
00:19:03,820 --> 00:19:06,360
.لا أريد أن يتعرّض أيّ من أصدقائي الأعزّاء للأذى

265
00:19:07,890 --> 00:19:08,900
...ليس تمامًا

266
00:19:10,060 --> 00:19:11,060
...بونتان

267
00:19:11,500 --> 00:19:13,100
.لا أصدّق حقًّا أنّك غير مهتمّة

268
00:19:13,200 --> 00:19:15,300
يبدو أنّك فقدت مهاراتك، أليس كذلك؟

269
00:19:15,800 --> 00:19:16,800
ماذا؟

270
00:19:17,340 --> 00:19:18,540
،إن كنت تريدين الهرب

271
00:19:18,970 --> 00:19:20,640
.فلمَ لا تهربين لوحدك فحسب

272
00:19:24,480 --> 00:19:25,610
.حسنًا

273
00:19:26,250 --> 00:19:28,380
،بما أنّك مصرّة

274
00:19:28,850 --> 00:19:29,850
.سأفعل ذلك بالضّبط

275
00:19:47,400 --> 00:19:48,430
.مرحبًا بعودتك

276
00:19:48,730 --> 00:19:49,740
.أجل

277
00:19:50,100 --> 00:19:52,610
.كان هناك شينوبي من قرية الورق

278
00:19:53,440 --> 00:19:56,010
.هم من دمّروا حصن تينما المتنقّل

279
00:19:56,780 --> 00:19:58,310
.إيكادا مشترك في الأمر أيضًا

280
00:19:58,880 --> 00:20:01,380
.لا يمكننا أن نتجاهل ما فعلوه

281
00:20:02,010 --> 00:20:03,380
.سنهاجم في منتصف اللّيل

282
00:20:03,380 --> 00:20:04,380
!حاضر

283
00:20:04,980 --> 00:20:06,720
!جميعًا، تأهّبوا للقتال

284
00:20:09,220 --> 00:20:11,520
.اقتلوا الجميع ما عدا واحدًا

285
00:20:11,560 --> 00:20:13,330
ما عدا واحدًا؟

286
00:20:14,390 --> 00:20:18,400
.سيعيش النّاجي الوحيد ليحدّث الجميع عن رعب الفوناتو

287
00:20:48,190 --> 00:20:50,030
...يا إلهي

288
00:20:50,530 --> 00:20:54,370
!يا لك من أحمق مكشوف تمامًا

289
00:20:55,640 --> 00:20:56,840
.لستُ واثقًا من ذلك

290
00:20:57,100 --> 00:20:58,100
!كاغورا

291
00:20:58,340 --> 00:21:00,340
هل عرفت أنّني سآتي؟

292
00:21:00,940 --> 00:21:02,780
.أنا متأهّب دائمًا لهجمات العدوّ

293
00:21:03,340 --> 00:21:04,340
...ولكن

294
00:21:04,610 --> 00:21:06,180
.لم أحسب أنّه سيكون أنت

295
00:21:07,750 --> 00:21:10,320
.سمعتُ أنّهم خفّضوا عقوبتنا بثلاث سنوات فقط

296
00:21:11,820 --> 00:21:12,820
!سمعت بذلك؟

297
00:21:12,890 --> 00:21:16,060
.كنت تستغلّنا ليس إلّا

298
00:21:16,520 --> 00:21:18,090
.لا تدفعني للضّحك

299
00:21:18,190 --> 00:21:19,730
...كنتُ سأقدّم استعطافًا آخر

300
00:21:20,630 --> 00:21:22,030
!طفح الكيل

301
00:21:22,530 --> 00:21:24,700
.دعني أوضّح الأمور

302
00:21:25,100 --> 00:21:29,290
!لا أملك أيّ نيّة للعودة لذلك المكان

303
00:21:40,480 --> 00:21:43,520
!بئسَ كلّ شيء

304
00:21:48,320 --> 00:21:49,460
...ما

305
00:21:50,990 --> 00:21:52,320
ذلك؟

306
00:23:25,200 --> 00:23:28,040
!لنرهم مدى رعب الفوناتو

307
00:23:28,370 --> 00:23:31,510
.فوناموشي، اعتن بأمر كاغورا الضّباب

308
00:23:31,680 --> 00:23:32,980
.مفهوم

309
00:23:33,440 --> 00:23:36,780
.سيشكّل ورقة مفاوضة جيّدة مع أرض الماء

310
00:23:36,910 --> 00:23:37,910
.نعم

311
00:23:38,080 --> 00:23:41,480
...لا يهمّني إن كان أولئك الأشقياء من قرية الورق أو مكان آخر

312
00:23:41,690 --> 00:23:44,350
.سأتخلّص منهم بيديّ هاتين

313
00:23:45,060 --> 00:23:48,390
:في الحلقة القادمة

314
00:23:48,930 --> 00:23:49,930
"سيرين"

315
00:23:50,390 --> 00:23:53,060
!لا فائدة من محاولة الاختباء منّي