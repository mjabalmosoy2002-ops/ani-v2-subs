سأساندكِ كليّاً

196
00:13:28,950 --> 00:13:30,420
...هكذا إذاً

197
00:13:30,420 --> 00:13:33,040
أنا... أحبّ

198
00:13:33,550 --> 00:13:34,340
أجل

199
00:13:36,680 --> 00:13:39,540
أيمكن لي أن أقع في الحبّ حقّاً؟

200
00:13:39,540 --> 00:13:41,000
بالطبع

201
00:13:41,670 --> 00:13:46,280
ما الذي... أستطيع فعله كي ألفت
انتباه سيتشي برأيك؟

202
00:13:46,280 --> 00:13:47,170
ماذا؟

203
00:13:47,170 --> 00:13:51,220
أريد أن أعلم سيتشي بمشاعري

204
00:13:51,680 --> 00:13:55,930
!أريد أن يحبّني سيتشي كما أحبّه

205
00:13:57,730 --> 00:13:59,370
!دعي الأمر لي

206
00:13:59,370 --> 00:14:02,820
سأعلّمكِ الطريقة المثالية
!للفوز بقلب سيتشي-سان

207
00:14:05,210 --> 00:14:06,820
!محال

208
00:14:07,570 --> 00:14:10,280
أكان فعل ذلك سيّئاً؟

209
00:14:10,280 --> 00:14:12,330
فوق السيّئ

210
00:14:12,650 --> 00:14:17,200
في هذا البلد، عندما يقدّم
الشاب خاتماً لفتاة

211
00:14:17,200 --> 00:14:19,800
،ويضعه على بنصرها الأيسر

212
00:14:19,800 --> 00:14:22,090
فهو رمزٌ لقسمه بالحُب الأبديّ

213
00:14:23,320 --> 00:14:28,220
،"وإذا حاولت قول "أمزح فقط!" أو "خطئي

214
00:14:28,220 --> 00:14:30,340
ستُعدم

215
00:14:30,340 --> 00:14:32,350
!أُ-أُعدم؟

216
00:14:32,350 --> 00:14:36,100
سيتمّ خصيك بأحسن الأحوال

217
00:14:39,100 --> 00:14:41,860
!إ-إلّا ذاك

218
00:14:42,220 --> 00:14:45,360
لمَ لا تتزوّجها وحسب إذاً؟

219
00:14:45,360 --> 00:14:47,080
أ-أتزوّج؟

220
00:14:47,080 --> 00:14:49,290
أقسمتَ بحبّك الأبديّ بالفعل

221
00:14:49,290 --> 00:14:50,860
ماذا قد تفعل غير ذلك؟

222
00:14:50,860 --> 00:14:52,880
...لـ-لكن

223
00:14:56,680 --> 00:15:01,420
قلبك متمحور حول فتاة
أخرى بالفعل، أليس كذلك؟

224
00:15:01,840 --> 00:15:03,420
حسناً، أجل

225
00:15:03,420 --> 00:15:08,130
في تلك الحالة، ابن حبّاً أبدياً
لهما الاثنتين

226
00:15:08,130 --> 00:15:10,700
يجب أن تكون منفتح الذهن
بما يكفي لذلك

227
00:15:10,700 --> 00:15:13,420
!ما-ماذا؟

228
00:15:16,310 --> 00:15:20,690
سأعطيك نصيحةً واحدة
بما أنّي أكبرك سنّاً

229
00:15:20,690 --> 00:15:24,440
لا تعطهما أيّ إجابة مبهمة البتّة

230
00:15:24,440 --> 00:15:29,810
إمّا تحمّل المسؤولية، أو قدّم لهما اعتذاراً خالصاً

231
00:15:29,810 --> 00:15:32,470
احرص على توضيح قرارك

232
00:15:33,990 --> 00:15:35,310
فهمت

233
00:15:35,310 --> 00:15:38,950
أظنّني سأحاول توضيح نفسي شخصيّاً

234
00:15:39,760 --> 00:15:41,250
شكراً على الطعام

235
00:15:41,250 --> 00:15:43,070
كان الشاي لذيذاً

236
00:15:43,070 --> 00:15:44,960
شكراً جزيلاً لك

237
00:15:44,960 --> 00:15:47,450
لنتحدّث مزيداً إذاً
متى التقينا مجدّداً

238
00:15:48,080 --> 00:15:49,460
!أجل، بالتأكيد

239
00:15:51,500 --> 00:15:53,110
يا للشباب

240
00:15:54,020 --> 00:15:57,260
،رانزي، رغم أنّي هنا

241
00:15:57,260 --> 00:16:00,740
أنت تكشف نفسك كثيراً
بقدومك إلى هنا بمفردك

242
00:16:00,740 --> 00:16:01,980
...لا تزال

243
00:16:01,980 --> 00:16:03,750
لا تقلق

244
00:16:03,750 --> 00:16:07,730
،ستأتي أقوى سيّافة في المملكة
لويز، لاصطحابي

245
00:16:07,730 --> 00:16:11,990
أشعر بالأسى على لويز-ساما التي عليها
التعايش مع نزواتك طوال الوقت

246
00:16:16,910 --> 00:16:18,980
رأيت؟ ها هي

247
00:16:25,540 --> 00:16:26,830
قرار؟

248
00:16:27,290 --> 00:16:29,810
أعرف أنّه لا يمكنني إطالة الأمر

249
00:16:30,230 --> 00:16:31,510
...لكنّي

250
00:16:41,020 --> 00:16:43,670
أتساءل ما إن كانت
ساريا لا تزال هنا

251
00:16:43,670 --> 00:16:46,340
يـ-يمكنني أخذ وقتي بالتفكير اليوم

252
00:16:46,340 --> 00:16:48,990
وأصل لقرار غداً

253
00:16:48,990 --> 00:16:52,020
أتيتُ هنا لاصطحاب ساريا بالفعل

254
00:16:52,440 --> 00:16:55,010
وأشعر بالأسى على آرتوريا-سان

255
00:16:55,010 --> 00:16:57,370
لكنّي سأخبرها غداً

256
00:16:57,370 --> 00:16:58,710
!أ-أجل

257
00:16:59,240 --> 00:17:01,530
أنا فظيع

258
00:17:02,560 --> 00:17:03,790
سيتشي

259
00:17:09,010 --> 00:17:11,070
آ-آرتوريا-سان؟

260
00:17:13,850 --> 00:17:15,900
آرتوريا-سان أمامي

261
00:17:16,560 --> 00:17:20,810
الآن هو وقت توضيح سوء
الفهم حيال الخاتم، أليس كذلك؟

262
00:17:21,190 --> 00:17:24,810
قد لا تسامحني، لكن عليّ الاعتذار، صحيح؟

263
00:17:25,130 --> 00:17:26,770
!لذا هيّا، قلها

264
00:17:27,100 --> 00:17:28,660
ما الذي تخافه؟

265
00:17:29,120 --> 00:17:33,000
!قلها، قلها، قلها، قلها

266
00:17:34,130 --> 00:17:35,350
آرتوريا-سان

267
00:17:35,710 --> 00:17:37,830
...في الواقع، ذاك الخاتم

268
00:17:40,610 --> 00:17:44,790
هـ-هذه... قبلة، أليس كذلك؟

269
00:17:48,030 --> 00:17:50,270
لا تقل مزيداً

270
00:17:51,090 --> 00:17:52,300
أعرف

271
00:17:52,650 --> 00:17:57,800
أعرف أنّك لم تعطني هذا الخاتم
لأنّك تشعر بذاك الشكل

272
00:17:57,800 --> 00:17:59,090
...إذاً

273
00:17:59,090 --> 00:18:01,100
!لكنّي لا أهتمّ

274
00:18:03,340 --> 00:18:04,880
لا أهتمّ

275
00:18:05,600 --> 00:18:08,100
لأنّي وقعت في حبّك

276
00:18:09,020 --> 00:18:12,560
أعرف أنّ لديك ساريا سلفاً

277
00:18:12,560 --> 00:18:16,730
لكن... لكنّي وقعت في حبّك مع ذلك

278
00:18:16,730 --> 00:18:19,990
!يوجعني قلبي بمجرّد رؤيتك

279
00:18:20,260 --> 00:18:21,620
...آرتوريا-سان

280
00:18:21,620 --> 00:18:23,200
هل لا أكفي؟

281
00:18:23,650 --> 00:18:27,160
لا يمكنني البقاء بجانبك؟

282
00:18:27,920 --> 00:18:29,620
...ذلك ليس

283
00:18:29,620 --> 00:18:33,470
لستُ أنثويّة، وقد لا أكون جذّابةً للحبّ

284
00:18:34,190 --> 00:18:35,730
...لكنّي مع ذلك

285
00:18:36,440 --> 00:18:37,730
...آرتوريا-سان

286
00:18:39,930 --> 00:18:43,500
لا يمكنني الاختيار بينهما

287
00:18:44,140 --> 00:18:48,730
في تلك الحالة، ابن حبّاً أبدياً
لهما الاثنتين

288
00:18:49,500 --> 00:18:50,730
...لكن

289
00:18:51,000 --> 00:18:52,510
...أنا لا أزال

290
00:18:54,210 --> 00:18:55,130
...أنا

291
00:18:55,990 --> 00:18:57,080
!ساريا

292
00:19:00,990 --> 00:19:02,720
!ساريا؟

293
00:19:02,720 --> 00:19:05,740
!هـ-هذا ليس ما تظنّينه

294
00:19:06,080 --> 00:19:07,750
اقبلها

295
00:19:09,120 --> 00:19:12,840
أشعر ببعض الحزن لأنّي
لا أستطيع امتلاكك لي وحدي

296
00:19:12,840 --> 00:19:17,630
لكن لم يخطر لي أن أستطيع
استحكار جاذبيّتك لي فقط

297
00:19:17,630 --> 00:19:21,010
...إ-إنّكِ حقّاً

298
00:19:21,010 --> 00:19:25,760
كما تميل الإناث للذكور الأقوياء بطبيعتهنّ

299
00:19:26,600 --> 00:19:27,770
إناث؟

300
00:19:27,770 --> 00:19:30,770
...لا تزالين غوريلا عندما يتعلّق الأمر بذلك

301
00:19:30,770 --> 00:19:35,850
لذا فلتقبل آرتوريا-سان
يا سيتشي كما يجب

302
00:19:35,850 --> 00:19:40,030
أنا أحبّ آرتوريا-سان أيضاً، وأريد البقاء معها

303
00:19:40,820 --> 00:19:42,530
...ساريا

304
00:19:48,010 --> 00:19:49,130
...آرتوريا-سان

305
00:19:49,910 --> 00:19:50,710
آر

306
00:19:52,000 --> 00:19:54,070
نادني بـ آر

307
00:19:54,380 --> 00:19:58,590
هذا الاسم الذي يناديني
به المقرّبون منّي

308
00:19:58,910 --> 00:20:01,420
ولا تضف ألقاباً

309
00:20:02,290 --> 00:20:04,180
فهمت يا آر

310
00:20:08,400 --> 00:20:10,550
أنا أحبّك أيضاً يا آر

311
00:20:21,190 --> 00:20:22,160
...آر

312
00:20:23,060 --> 00:20:26,640
أعرف أنّه لا أمل منّي
،ولستُ جديراً بالمسؤولية

313
00:20:27,400 --> 00:20:32,710
لكنّي سأبذل قصارى جهدي كيلا
أجعلكِ تندمين على وقوعك في حبّي

314
00:20:33,830 --> 00:20:34,630
أجل

315
00:20:35,530 --> 00:20:38,400
!أصبحتُ وآر معاً الآن

316
00:20:44,280 --> 00:20:45,710
!مُبارك

317
00:20:47,090 --> 00:20:54,480
مُبارك

318
00:20:56,700 --> 00:20:58,230
!شكراً

319
00:20:58,230 --> 00:21:01,700
أيمكن أن تنتهي الأمور هكذا؟

320
00:22:43,990 --> 00:22:47,040
"...و-وقت فقرة "حالة سيتشي

321
00:22:47,040 --> 00:22:48,750
!تصفيق، تصفيق، تصفيق

322
00:22:48,750 --> 00:22:51,030
!تلعثمتُ من البداية

323
00:22:51,030 --> 00:22:52,590
...حـ-حسناً

324
00:22:52,590 --> 00:22:56,840
!حالة سيتشي للوقت الراهن هي... هذه

325
00:23:03,870 --> 00:23:05,170
،أخبريني يا آر

326
00:23:05,170 --> 00:23:07,530
ما "صنع السحر" هذا؟

327
00:23:07,530 --> 00:23:12,060
يبدو أنّها مهارةٌ تمكّنه من صنع
سحره الجديد الخاصّ

328
00:23:12,060 --> 00:23:15,520
،طالما يمتلك تصوّراً واضحاً ويمنحها اسماً

329
00:23:15,520 --> 00:23:17,980
!يمكنه صنع أيّ تعويذة

330
00:23:17,980 --> 00:23:20,020
!مذهل! ذلك مفيد

331
00:23:20,020 --> 00:23:22,760
أريد... صنع شيءٍ مع سيتشي

332
00:23:22,760 --> 00:23:25,190
ماذا؟ ما الذي تريدين صنعه؟

333
00:23:26,340 --> 00:23:27,130
آر؟

334
00:23:27,130 --> 00:23:30,640
!لـ-ليس ذلك! ذ... ذ... ذكريات

335
00:23:30,640 --> 00:23:32,880
!أريد صنع ذكريات

336
00:23:35,430 --> 00:23:38,460
،تحيط بي ساريا وآرتوريا الآن، فتاتان جميلتان

337
00:23:38,460 --> 00:23:41,030
!وتظهر بطلة جديدة من فورها

338
00:23:41,030 --> 00:23:42,790
...وبالنسبة لمظهرها، فهي

339
00:23:42,790 --> 00:23:43,770
!حمار؟

340
00:23:44,080 --> 00:23:46,480
"!الحلقة القادمة: "ظهور لولوني

341
00:23:46,480 --> 00:23:47,410
—هيّا بنا يا حصا

342
00:23:47,410 --> 00:23:49,570
!كلا، يا فتاة الحمار