1
00:00:00,000 --> 00:00:03,350
حصن كاناري

2
00:00:03,680 --> 00:00:08,000
سنشرع الآن في تنفيذ
.عملية إنقاذ أرس

3
00:00:08,000 --> 00:00:09,860
.لا يُسمح بالفشل

4
00:00:10,320 --> 00:00:13,110
!سنقضي على العدو قضاءً تامًا

5
00:00:13,600 --> 00:00:15,640
لكن من سيتولى قيادة العملية؟

6
00:00:15,640 --> 00:00:18,300
.روسيل منشغل بالمفاوضات في الميناء

7
00:00:18,300 --> 00:00:22,300
سيستغرق استدعاء ميري من
.لامبرغ وقتًا طويلًا

8
00:00:22,300 --> 00:00:23,840
...في هذه الحالة

9
00:00:24,250 --> 00:00:26,770
!عليّ أن أتولى القيادة بنفسي

10
00:00:25,660 --> 00:00:27,980
!لا يمكنك

11
00:00:26,770 --> 00:00:27,980
!اهدئي

12
00:00:27,980 --> 00:00:30,180
!أفلتيني حالًا يا شارلوت

13
00:00:30,180 --> 00:00:32,540
!ماذا تأملين أن تُحققي؟

14
00:00:32,540 --> 00:00:36,510
هل تأذنون لي بتولّي هذا الدور؟

15
00:00:37,280 --> 00:00:38,630
!توماس؟

16
00:02:10,400 --> 00:02:13,770
الحلقة 31   الانطلاق لإنقاذ أرس

17
00:02:11,080 --> 00:02:14,730
.سمعتُ أنّ ميري ذهبت لاستقطابك

18
00:02:15,080 --> 00:02:18,140
هل قبلتَ عرضها إذًا؟

19
00:02:19,550 --> 00:02:23,230
لم أقرّر بعد إن كنتُ
،سأخدمكم رسميًا

20
00:02:23,230 --> 00:02:24,940
،لكنّني سمعتُ ما دار بينكم

21
00:02:24,940 --> 00:02:25,950
...لذا يسعدني أن

22
00:02:27,740 --> 00:02:30,750
.امتناني لك لا حدود له يا توماس

23
00:02:31,200 --> 00:02:32,710
...أخبرتك أنّني لم

24
00:02:32,710 --> 00:02:35,380
لا أدري كيف أستطيع
.أن أوفيك حقّك من الشكر

25
00:02:35,380 --> 00:02:38,340
...أن يُساعدنا عدو سابق

26
00:02:39,680 --> 00:02:43,520
قررتُ فقط أنّ وضعي سيكون أفضل
.مع زوجك بدلًا من الحاكم كوران

27
00:02:43,520 --> 00:02:46,600
،والآن وقد وافقتُ على المساعدة
.أقسم أن أعيده سالمًا

28
00:02:47,010 --> 00:02:48,100
!رائع

29
00:02:48,570 --> 00:02:50,290
!براهام، زاهت

30
00:02:50,290 --> 00:02:52,090
.سأدعو لكم بالنصر

31
00:02:52,090 --> 00:02:54,480
!احرصوا على إعادة سيّدي أرس

32
00:02:54,480 --> 00:02:55,970
!لا مشكلة

33
00:02:55,970 --> 00:02:57,740
!سننهي المهمة في لمح البصر

34
00:02:58,240 --> 00:03:00,740
.لا بدّ أن تعودوا به سالمًا

35
00:03:03,320 --> 00:03:06,240
والآن، كيف سنفعل هذا؟

36
00:03:06,240 --> 00:03:09,870
الأمر في غاية السهولة! إنّهم مجرد
قطاع طرق تافهون، صحيح؟

37
00:03:09,870 --> 00:03:13,960
جيش كاناري قوي جدًا
.لذا لننقضّ عليهم ونسحقهم

38
00:03:14,320 --> 00:03:18,180
.لا يمكننا ضمان أنّهم سيواجهوننا في قتال

39
00:03:18,180 --> 00:03:20,870
.سيفرّون لا محالة إن أرسلنا قوّة كبيرة

40
00:03:20,870 --> 00:03:22,970
وماذا سيحلّ بالرهائن حينها؟

41
00:03:24,480 --> 00:03:27,390
.سيقتلونهم كي لا يعرقلوهم

42
00:03:27,680 --> 00:03:28,800
.صحيح

43
00:03:28,800 --> 00:03:30,890
.وعندها ستقتلك سيّدة البيت

44
00:03:31,760 --> 00:03:33,080
!سيّدة البيت؟

45
00:03:37,460 --> 00:03:39,120
!من تكون أنت أصلًا؟

46
00:03:39,120 --> 00:03:41,180
تقتحم المكان فجأة
...وتبدأ بإصدار الأوامر

47
00:03:41,180 --> 00:03:44,400
قوّات كاناري النخبة
!هي الأقوى في ميسيان

48
00:03:44,400 --> 00:03:46,320
!نستطيع تولّي الأمر بأنفسنا

49
00:03:46,320 --> 00:03:47,380
.أنصت يا صبي

50
00:03:47,380 --> 00:03:48,870
صـ-صبي"؟"

51
00:03:49,250 --> 00:03:52,200
تقول أنّكم الأقوى في ميسيان؟

52
00:03:52,200 --> 00:03:56,560
لكن مهاجمتهم مباشرة بأسلحتكم
مسلولة ليس خطّة

53
00:03:56,560 --> 00:03:57,880
...أولًا

54
00:03:58,120 --> 00:04:00,260
.عليك أن تعرف عدوّك

55
00:04:03,440 --> 00:04:06,050
أهُنا تعرّضوا لهجوم مباغت؟

56
00:04:06,050 --> 00:04:08,890
...لكن لا أثر لأحد في الجوار

57
00:04:14,160 --> 00:04:15,770
.مضى على هذا بعض الوقت

58
00:04:16,690 --> 00:04:17,700
.انظر إلى هذا

59
00:04:19,020 --> 00:04:20,050
ما رأيك؟

60
00:04:21,300 --> 00:04:23,710
إنّها مجرّد بقايا نار مخيّم ودلو، صحيح؟

61
00:04:24,700 --> 00:04:28,030
.هذا الدلو مصنوع من الفولاذ

62
00:04:28,400 --> 00:04:31,100
.الخشب هو المادة الأكثر استخدامًا في ميسيان

63
00:04:31,100 --> 00:04:34,250
.الدلاء المعدنية نادرة الاستخدام

64
00:04:34,250 --> 00:04:37,940
.والدلو الفولاذي يُعدّ شيئًا ثمينًا

65
00:04:37,940 --> 00:04:40,050
.صحيح، نادرًا ما نرى مثل هذه الدلاء

66
00:04:40,470 --> 00:04:43,600
حتّى لو تعقّبت قوات
كاناري مخيمهم

67
00:04:43,600 --> 00:04:46,330
فهل يعقل أن يتركوا شيئًا
ثمينًا كهذا أثناء انسحابهم

68
00:04:47,920 --> 00:04:50,130
.لعلّهم كانوا مستعجلين

69
00:04:50,130 --> 00:04:52,050
لكن ما أهمية ذلك أصلًا؟

70
00:04:53,880 --> 00:04:57,430
أنت لا تكلّف نفسك عناء
التفكير في الأمور ولو للحظة

71
00:04:57,430 --> 00:04:59,940
.عليكَ أن تتلقى تعليمًا قويمًا

72
00:04:59,940 --> 00:05:01,350
تعليم؟

73
00:05:02,390 --> 00:05:03,100
.هيّا بنا

74
00:05:03,100 --> 00:05:05,310
!مـ-مهلًا، انتظر

75
00:05:06,940 --> 00:05:09,160
هيّا، أيّ نوع من التعليم تقصد؟

76
00:05:09,680 --> 00:05:12,930
هل تعرف ما المواد
اللازمة لصناعة الفولاذ؟

77
00:05:12,930 --> 00:05:15,280
...ماذا؟ لنرَ

78
00:05:19,980 --> 00:05:20,840
أذلك هو المكان؟

79
00:05:25,780 --> 00:05:27,340
.أرى حراسًا

80
00:05:27,760 --> 00:05:29,370
.تتمتع بنظر ثاقب

81
00:05:31,140 --> 00:05:32,430
.أنت محق

82
00:05:33,040 --> 00:05:34,550
.انظر إلى ملابسهم

83
00:05:36,070 --> 00:05:39,480
إنّها متسخة لكنّها أزياء
.عسكرية تابعة لسيتز

84
00:05:40,420 --> 00:05:43,480
صحّ حدسي الذي راودني
.حين رأيتُ مخيّمهم

85
00:05:44,180 --> 00:05:47,490
لِم يرتدي قطاع الطرق
أزياء جيش سيتز؟

86
00:05:47,850 --> 00:05:49,990
سرقوها، صحيح؟

87
00:05:50,370 --> 00:05:54,600
هل سيقطعون كلّ تلك المسافة إلى
مقاطعة مجاورة ليسرقوا أزياء عسكرية؟

88
00:05:54,600 --> 00:05:56,370
.لن أكلّف نفسي عناء ذلك

89
00:05:57,950 --> 00:05:59,000
.كلامك صحيح

90
00:05:59,440 --> 00:06:02,200
.يُعَدّ الفولاذ أبرز منتجات سيتز

91
00:06:02,200 --> 00:06:05,510
يتوافق مع الأحجار السحرية التي
.يمكن استخراجها من المناجم هناك

92
00:06:06,000 --> 00:06:07,510
فولاذ إذًا؟

93
00:06:07,510 --> 00:06:11,510
أليست تلك المادة التي
صُنع منها الدلو في المخيّم؟

94
00:06:11,840 --> 00:06:15,350
أتظنّ أنَّهم جنود سيتز إذًا؟

95
00:06:15,350 --> 00:06:18,310
.هذا يفسّر مسألة الفولاذ والأزياء

96
00:06:18,310 --> 00:06:19,500
.نعم

97
00:06:19,500 --> 00:06:22,780
جنود انشقوا عن الجيش
.ولم يعودوا إلى صفوفه

98
00:06:22,780 --> 00:06:24,320
.ليس أمرًا نادر الحدوث

99
00:06:24,320 --> 00:06:26,310
!أكنتُ محقًا؟

100
00:06:26,310 --> 00:06:30,780
بالمناسبة يا سيّد، هل استنتجتَ كلّ
ذلك من دلو فولاذي واحد؟

101
00:06:31,170 --> 00:06:32,630
.بالطبع

102
00:06:32,630 --> 00:06:35,360
لكن المشكلة أنّنا إن
،هاجمناهم مباشرة من هنا

103
00:06:35,360 --> 00:06:38,290
.فسيحرقون المكان ويفرّون

104
00:06:39,380 --> 00:06:40,510
...إذًا كيف يمكننا أن

105
00:06:40,510 --> 00:06:43,990
كيف سننقذ أرس لوفنت؟

106
00:06:43,990 --> 00:06:47,550
من ناحية معيّنة، يتوقف مصير
.كاناري بأكملها على عاتقك

107
00:06:48,160 --> 00:06:49,550
.استخدم عقلك

108
00:06:51,360 --> 00:06:52,800
عقلي؟

109
00:06:53,680 --> 00:06:57,920
سمعتُ شائعات تفيد بأنّ
.صفوف قطاع الطرق تتزايد بسرعة

110
00:06:57,920 --> 00:07:01,210
ما يعني أنّهم يستقبلون أفرادًا أكثر
.ممّا كان لديهم في البداية

111
00:07:01,210 --> 00:07:05,070
هل المزيد من جنود سيتز
يتوافدون إلى ميسيان؟

112
00:07:05,550 --> 00:07:09,320
!لا... إنّهم يجنّدون قطاع الطرق

113
00:07:10,570 --> 00:07:14,880
ما رأيكم أن نتنكّر كقطاع
طرق ونتسلل إلى عصابتهم؟

114
00:07:14,880 --> 00:07:17,870
لن نلفت الأنظار مع
!وجود عدد كبير من المجندين الجدد

115
00:07:18,390 --> 00:07:21,350
.هذا ما يعنيه استخدام عقلك

116
00:07:21,350 --> 00:07:23,250
.تذكّر هذا يا صبي

117
00:07:24,560 --> 00:07:27,770
!نعم! أنا مذهل

118
00:07:27,770 --> 00:07:30,990
!اخفض صوتك يا أحمق! سيسمعونك

119
00:07:31,980 --> 00:07:34,680
نجح في دفع ذلك الغبي
براهام إلى التفكير؟

120
00:07:31,980 --> 00:07:34,680
!ربّما أنا خبير استراتيجي أيضًا

121
00:07:34,680 --> 00:07:36,660
.لا أظن أنّ ما فعلته يؤهلك لذلك

122
00:07:36,010 --> 00:07:41,480
ربّما نستطيع بلوغ آفاق أرحب
!بوجود هذا الرجل إلى جانبنا

123
00:07:36,660 --> 00:07:37,810
لا أمل لي في ذلك إذًا؟

124
00:07:37,810 --> 00:07:38,690
.لا للأسف

125
00:07:41,480 --> 00:07:44,480
من ينبغي أن يتسلل إذًا؟

126
00:07:44,480 --> 00:07:46,480
.نحتاج شخصًا فطنًا

127
00:07:46,800 --> 00:07:47,780
!أنا الأنسب إذًا

128
00:07:47,780 --> 00:07:50,280
.لا تصلح لهذه المهمة أيّها القائد

129
00:07:50,280 --> 00:07:51,740
!لماذا؟

130
00:07:51,740 --> 00:07:55,240
.لا تسأل إلّا إن أردتَ الجواب حقًا

131
00:07:55,240 --> 00:07:56,740
.فهمت

132
00:07:57,090 --> 00:08:00,250
.لا خيار أمامنا سوى أن أذهب أنا

133
00:08:00,250 --> 00:08:02,990
!زاهت! نعتمد عليك

134
00:08:02,990 --> 00:08:03,750
!اخفض صوتك

135
00:08:03,750 --> 00:08:07,170
تسلّل زاهت

136
00:08:08,030 --> 00:08:08,880
عدو؟

137
00:08:09,370 --> 00:08:14,640
...لستُ متأكدًا ولكن

138
00:08:14,640 --> 00:08:16,140
!إنّه بمفرده

139
00:08:18,360 --> 00:08:22,020
من تكون؟ هل تدرك أين أنت؟

140
00:08:22,290 --> 00:08:25,980
.نعم، أنا روبيوس
.أتيتُ من مقاطعة باراديل

141
00:08:26,250 --> 00:08:29,900
كاذب! أنت جندي من ميسيان، صحيح؟

142
00:08:29,900 --> 00:08:31,540
!أتريد الموت؟

143
00:08:31,540 --> 00:08:35,360
ألديكم ما يدعوكم للاعتقاد
بأنّني لستُ من باراديل؟

144
00:08:35,750 --> 00:08:40,370
.لا، لكنتك تبدو باراديلية بلا شك

145
00:08:41,370 --> 00:08:43,860
.أنا أبحث عن عمل

146
00:08:43,860 --> 00:08:46,120
ما رأيك أن تدعوني
أنضم إلى عصابتكم؟

147
00:08:48,120 --> 00:08:52,080
.عذرًا لكن صفوفنا مكتملة

148
00:08:52,080 --> 00:08:54,630
!لكن لا داعي لترحل بهذه السرعة

149
00:08:55,680 --> 00:08:57,360
.يمكنك ترك تلك الحقيبة هنا

150
00:08:57,360 --> 00:08:58,590
.بحقّك يا رجل

151
00:08:58,590 --> 00:09:02,520
حتّى لو كان لديكم ما يكفي
فلا بدّ أنّكم تريدون أصحاب مهارات، صحيح؟

152
00:09:03,440 --> 00:09:05,320
...نعم، نريد

153
00:09:05,320 --> 00:09:09,000
.لكنّني لا أظنّك مؤهلًا

154
00:09:14,950 --> 00:09:17,050
أنتم تفتقرون للأدب إذًا؟

155
00:09:17,050 --> 00:09:20,120
.أنا شخص معروف في باراديل

156
00:09:20,760 --> 00:09:26,250
قبل 10 سنوات، اعتدتُ الشرب مع
.زعيم قطاع طرق من ميسيان يدعى جورج

157
00:09:26,680 --> 00:09:28,760
هل تعرف جورج؟

158
00:09:28,760 --> 00:09:30,480
.هذا عجيب

159
00:09:30,480 --> 00:09:34,760
عملتُ لدى جورج ولم يسبق أن ذكرك

160
00:09:36,190 --> 00:09:39,640
بالمناسبة، جورج موجود في
.هذه القلعة حاليًا

161
00:09:39,640 --> 00:09:40,890
ما رأيك أن أسأله عنك؟

162
00:09:42,780 --> 00:09:46,890
لا بأس بذلك! لم أشرب
.مع ذلك العجوز منذ زمن

163
00:09:48,300 --> 00:09:50,380
.يبدو أنَّ كلامه صحيح

164
00:09:50,380 --> 00:09:53,400
.حسنًا، سنسمح لك بمقابلة الزعيم

165
00:09:54,560 --> 00:09:56,240
.أعتذر عن التشكيك فيك

166
00:09:56,240 --> 00:10:00,270
يتباهى كثيرون بمعرفة أشخاص
.معروفين كي يرفعوا من شأن أنفسهم

167
00:10:00,270 --> 00:10:01,910
.أشكركم

168
00:10:03,680 --> 00:10:07,550
.في الحقيقة... فارق جورج الحياة

169
00:10:07,550 --> 00:10:09,920
.كنتُ أخادعك قبل قليل

170
00:10:10,190 --> 00:10:13,700
.يا للأسف. سأحتسي كأسًا على ذكراه

171
00:10:14,480 --> 00:10:15,920
.كنتُ أعلم ذلك

172
00:10:16,640 --> 00:10:20,930
قتلتُ جورج بنفسي خلال
.مهمة بصفتي مرتزقًا

173
00:10:22,800 --> 00:10:24,820
.نجح التسلل

174
00:10:24,820 --> 00:10:26,850
.حان وقت مباشرة العمل

175
00:10:27,460 --> 00:10:31,560
.براهام، توماس... أنجزا ما عليكما

176
00:10:44,240 --> 00:10:47,620
ريكويا فوجيميا

177
00:10:46,320 --> 00:10:49,200
ألا تستطيع النوم... يا ريكويا؟

178
00:10:51,200 --> 00:10:54,670
أعتذر لأنّني ورّطتك
.في مشكلات كاناري

179
00:10:55,610 --> 00:10:59,640
لا شك أنّك تشعر بالقلق لكنّني
.متأكد من أنَّ المساعدة ستصل

180
00:10:59,640 --> 00:11:02,550
عليك أن تدّخر قوّتك
.إلى حين الحاجة إليها

181
00:11:02,930 --> 00:11:05,750
.أُسِرت بسبب غفلتي أنا

182
00:11:05,750 --> 00:11:09,350
.لكن سيفي سيُباع قريبًا

183
00:11:09,350 --> 00:11:11,760
.وهذا أمر لا أستطيع الكف عن التفكير فيه

184
00:11:12,820 --> 00:11:16,170
.لا بدّ أنّك تعتز بذلك السيف كثيرًا

185
00:11:16,170 --> 00:11:18,320
...قلتَ أنّه إرث عائلي ولكن

186
00:11:19,610 --> 00:11:23,320
.لم يكن مقدّرًا لي اعتلاء العرش قط

187
00:11:24,140 --> 00:11:25,580
ماذا تقصد بهذا؟

188
00:11:26,180 --> 00:11:28,610
هل تسمح أن أقص عليك قصة؟

189
00:11:29,320 --> 00:11:34,430
...عن مولدي وما حدث في يوه

190
00:11:32,620 --> 00:11:34,960
قبل عشر سنوات     مملكة يوه

191
00:11:35,360 --> 00:11:38,960
حكمت عائلة فوجيميا مملكة يوه منذ تأسيسها

192
00:11:38,960 --> 00:11:43,370
كنتُ الابن الخامس للزوجة
.الأولى للملك الثالث عشر

193
00:11:43,370 --> 00:11:46,940
.كان ترتيبي بعيدًا جدًا في ولاية العرش

194
00:11:48,150 --> 00:11:49,290
...وبسبب ذلك

195
00:11:51,910 --> 00:11:53,310
!مايكا، تاكاو

196
00:11:55,490 --> 00:11:59,390
،على خلاف إخوتنا الأكبر سنًا
حظينا بالحرية في طفولتنا

197
00:11:59,390 --> 00:12:03,110
وكثيرًا ما كنّا نتسلل من
مراقبة مربيتنا لنستكشف البلدة

198
00:12:03,770 --> 00:12:07,530
،مايكا وتاكاو أخواي من أبي
لكن أعمارنا متقاربة

199
00:12:07,530 --> 00:12:10,620
.وكنّا نلعب كثيرًا مع أطفال البلدة

200
00:12:11,070 --> 00:12:14,620
...نلعب حتّى تغيب الشمس وعندها

201
00:12:15,630 --> 00:12:17,270
.يا للعجب

202
00:12:17,270 --> 00:12:20,130
.كانت أمّي تأتي دائمًا لتصطحبني

203
00:12:20,480 --> 00:12:22,410
.يا لكم من مشاغبين

204
00:12:22,410 --> 00:12:25,140
من الذي أقنع الجميع
بمغادرة القلعة؟

205
00:12:26,670 --> 00:12:28,890
!كـ-كانت فكرتنا

206
00:12:28,890 --> 00:12:31,390
!لا، غير صحيح! كانت فكرتي

207
00:12:31,390 --> 00:12:34,400
...أنا من قال ذلك

208
00:12:32,080 --> 00:12:34,660
!لا، بل نحن

209
00:12:32,080 --> 00:12:33,460
...لكنّني

210
00:12:34,660 --> 00:12:35,880
!نعم

211
00:12:37,190 --> 00:12:38,730
.لنعد إلى المنزل

212
00:12:43,500 --> 00:12:45,410
.تذكرت. تفضّلي

213
00:12:46,120 --> 00:12:48,910
إنّها زينة شعر مصنوعة
.من أزهار البلدة

214
00:12:49,500 --> 00:12:51,870
.أردتُ أن أهديك إيّاها

215
00:12:52,310 --> 00:12:54,370
.يا لك من فتى عزيز

216
00:13:00,150 --> 00:13:02,260
.تبدين جميلة يا أمّي

217
00:13:02,980 --> 00:13:05,260
.شكرًا لك يا ريكويا

218
00:13:05,670 --> 00:13:08,810
،أحببتُ أمّي وإخوتي

219
00:13:08,810 --> 00:13:11,580
.كما أحببتُ مملكة يوه

220
00:13:13,170 --> 00:13:15,180
،ومع تقدمنا في العمر

221
00:13:15,920 --> 00:13:20,440
بدؤوا يدرّبوننا لنكون
.عونًا لإخوتنا ووالدنا

222
00:13:22,420 --> 00:13:25,530
مايكا ذكية لذا تدرّبت
.مع المسؤولين والاستراتيجيين

223
00:13:25,940 --> 00:13:29,030
.تاكاو قوي لذا تدرّب مع المحاربين

224
00:13:31,180 --> 00:13:34,360
،أنا لم أمتلك أيّ مواهب بارزة

225
00:13:34,360 --> 00:13:36,540
.لكنّني كرّستُ نفسي لدراساتي

226
00:13:39,000 --> 00:13:40,420
.رائحة احتراق

227
00:13:41,600 --> 00:13:42,680
!أخي الكبير

228
00:13:50,630 --> 00:13:52,010
...أخي الكبير

229
00:13:52,010 --> 00:13:53,270
.الأمير ريكويا

230
00:13:53,270 --> 00:13:55,890
...إنّه هجوم! عليك أن تهـ

231
00:13:55,890 --> 00:13:58,190
!اهرب حالًا

232
00:14:01,900 --> 00:14:04,240
!أبي! أمّي

233
00:14:07,170 --> 00:14:08,370
!أخي الكبير

234
00:14:10,880 --> 00:14:13,120
ريكويا... أهذا أنت؟

235
00:14:13,420 --> 00:14:14,550
!أخي

236
00:14:14,550 --> 00:14:16,540
...عليك أن تذهب

237
00:14:16,540 --> 00:14:19,180
!لا تتكلّم! سنعالج جراحك

238
00:14:20,330 --> 00:14:23,770
!عليك حماية أبينا

239
00:14:24,990 --> 00:14:26,050
...أخي

240
00:14:28,590 --> 00:14:29,700
!أخي

241
00:14:30,450 --> 00:14:32,510
!أخي

242
00:14:33,430 --> 00:14:34,530
...لماذا

243
00:14:35,430 --> 00:14:37,520
لماذا  كان عليهم أن يموتوا؟

244
00:14:37,890 --> 00:14:39,020
!أبي

245
00:14:46,290 --> 00:14:47,500
...ريكويا

246
00:14:50,310 --> 00:14:51,180
!أبي

247
00:14:51,180 --> 00:14:54,020
.خانني أتباعي

248
00:14:54,020 --> 00:14:55,790
!يسعون للاستيلاء على العرش

249
00:14:56,110 --> 00:14:57,470
العرش؟

250
00:14:57,470 --> 00:14:58,520
...أمّي

251
00:14:58,520 --> 00:15:00,290
!هل أمّي سالمة؟

252
00:15:00,290 --> 00:15:03,770
.لا، لقد أخذوها

253
00:15:06,200 --> 00:15:07,300
...ريكويا

254
00:15:07,720 --> 00:15:09,300
.خذ هذا واهرب

255
00:15:10,050 --> 00:15:12,930
ينبغي أن يكون هذا السيف
!في حوزة الملك

256
00:15:12,930 --> 00:15:13,800
.نعم

257
00:15:15,280 --> 00:15:17,610
.عليك أن تصبح الملك

258
00:15:17,610 --> 00:15:22,270
!خذ هذا السيف واستعد مملكة يوه

259
00:15:22,270 --> 00:15:24,940
...أنا، الملك؟ ماذا تقول

260
00:15:24,940 --> 00:15:27,070
!إنّهم هنا! اقتلوهم جميعًا

261
00:15:27,680 --> 00:15:29,580
!من هنا يا سيّدي الشاب

262
00:15:35,280 --> 00:15:38,080
!سنبقيهم منشغلين. اهربوا

263
00:15:39,210 --> 00:15:41,620
.أوكل إليك أمر مملكتنا

264
00:15:46,400 --> 00:15:51,240
جرّد تمرّد الحاشية
.عائلة فوجيميا من العرش

265
00:15:51,240 --> 00:15:54,340
.ولم ينجُ سوى أنا، مايكا وتاكاو

266
00:16:02,150 --> 00:16:04,340
.لم يعد بوسعنا فعل شيء هنا يا أخي

267
00:16:04,340 --> 00:16:06,100
.لنغادر المملكة

268
00:16:06,100 --> 00:16:09,530
.استولوا بالفعل على إدارة شؤون المملكة

269
00:16:09,530 --> 00:16:10,780
وماذا عن أمّي؟

270
00:16:11,350 --> 00:16:14,280
.زوّجوها بمن استولى على العرش

271
00:16:15,010 --> 00:16:18,390
.لكنّها رهينة في الحقيقة
.زوجته بالاسم فحسب

272
00:16:22,810 --> 00:16:24,140
...سوف

273
00:16:25,180 --> 00:16:27,420
!سنعود لإنقاذها

274
00:16:29,460 --> 00:16:30,810
!أمّي

275
00:16:34,720 --> 00:16:37,660
.بقيّة القصة كما أخبرتك

276
00:16:38,200 --> 00:16:42,100
تنقلنا بين الممالك بحثًا عن
.مساعدة أصحاب النفوذ والسلطة

277
00:16:44,250 --> 00:16:50,440
.لا أملك حكمة مايكا ولا قوّة تاكاو

278
00:16:50,440 --> 00:16:55,110
،مع ذلك بصفتي وريث العرش
.لا بدّ لي أن أستعيد مملكتي

279
00:16:55,500 --> 00:16:59,120
،بصفتي حاكم إقطاعية
.أظنّني أتفهم شعورك

280
00:17:00,680 --> 00:17:01,750
...أيّها اللّورد أرس

281
00:17:02,640 --> 00:17:05,620
هل سبق أن فكّرت في نسبك؟

282
00:17:06,410 --> 00:17:10,260
بحكم مولدنا كنبلاء، مصيرنا
.أن نتوارث السلطة

283
00:17:10,260 --> 00:17:13,130
لكن لِم تنتقل إلينا تلك السلطة؟

284
00:17:13,790 --> 00:17:16,620
هل لأنّ دماء الملوك
تجري في عروقنا؟

285
00:17:18,990 --> 00:17:22,940
.أعتقد أنَّ أمورًا كهذه لا معنى لها

286
00:17:22,940 --> 00:17:26,640
على الأقل، لا شيء من ذلك
.يمكن أن يُرى بالعين

287
00:17:27,230 --> 00:17:31,650
بناء على ذلك، أنا لستُ سوى
.شاب جاهل عديم المواهب

288
00:17:32,420 --> 00:17:36,150
فهل يستطيع شخص مثلي
...شخص عادي مثلي

289
00:17:36,850 --> 00:17:40,530
!أن يتحمّل حقًا مسؤولية مملكة؟

290
00:17:42,490 --> 00:17:45,040
ما يعني أنَّ ذلك السيف
.هو كلّ ما أملك

291
00:17:45,790 --> 00:17:50,550
الدليل الوحيد على أحقيتي بوراثة العرش
،هو ذلك السيف الذي يُقال أنّه قتل تنينًا

292
00:17:50,550 --> 00:17:51,980
!نصل قاتل التنين

293
00:17:52,930 --> 00:17:57,340
لا أكون شخصًا مميزًا إلّا
.حين أحمل ذلك السيف

294
00:17:59,290 --> 00:18:04,900
ما الذي أملكه غيره
لإثبات أحقيتي بالعرش؟

295
00:18:04,900 --> 00:18:07,940
.أسأتَ فهم الأمر كليًا يا ريكويا

296
00:18:11,100 --> 00:18:13,440
يا زعيم! ما الأمر؟

297
00:18:13,440 --> 00:18:17,450
الفتى، الأسمر المالكاني، والرجل
...ذو الشعر الطويل

298
00:18:18,120 --> 00:18:20,540
.لديّ مكان أودّ اصطحابكم إليه

299
00:18:22,950 --> 00:18:26,330
تعذيب فيرغو

300
00:18:29,460 --> 00:18:33,210
أنا أكره الكاذبين لعلمكم

301
00:18:33,560 --> 00:18:37,040
،أنا رجل أحبّ الصراحة

302
00:18:37,040 --> 00:18:40,250
لكن النّاس لا يكفّون
.عن الكذب وتخييب أملي

303
00:18:40,250 --> 00:18:44,390
.عاقبتُ نصيبي من الكاذبين

304
00:18:45,470 --> 00:18:51,100
جندي من سيتز، قادر رجاله لتشكيل عصابة من...
...قطاع الطرق  بعد هزيمتهم عند نهر كومير

305
00:18:46,370 --> 00:18:47,710
...هذا الرجل

306
00:18:47,710 --> 00:18:51,100
.يبدو أنّ لديك سيفًا نفيسًا

307
00:18:51,580 --> 00:18:54,880
،يبدو أنَّ رجالي صدّقوا قصّتك

308
00:18:54,880 --> 00:18:58,610
لكن ما الذي يدفع مسافرًا
لحمل سيف بهذه القيمة؟

309
00:18:59,600 --> 00:19:02,420
.إنّه إرث عائلي

310
00:19:02,420 --> 00:19:04,910
.تركهُ لي أبي

311
00:19:08,640 --> 00:19:11,230
أنت تكذب بشأن كونك
!مُجرّد مسافر، صحيح؟

312
00:19:11,230 --> 00:19:13,420
!إنّه لا يكذب

313
00:19:15,280 --> 00:19:17,760
لِم تفعل هذا؟

314
00:19:17,760 --> 00:19:19,740
كنتَ أحد جنود سيتز، صحيح؟

315
00:19:20,720 --> 00:19:23,320
تنبهتَ لذلك إذًا؟

316
00:19:23,320 --> 00:19:26,930
ادعيتَ أنّك من أسرة
...تجار ولكن

317
00:19:26,930 --> 00:19:30,680
...رأيتُ وجهك في تلك المعركة

318
00:19:30,680 --> 00:19:33,250
.يا سيّد أرس لوفنت

319
00:19:33,250 --> 00:19:35,940
.وأنت أيضًا يا ريتز ميوسيس

320
00:19:36,890 --> 00:19:40,880
أنت من تسببتَ بهذه الندبة
.في معركة نهر كومير

321
00:19:40,880 --> 00:19:43,270
.هذا يجعلنا رفيقي ساحة المعركة

322
00:19:44,570 --> 00:19:48,230
بعد أن هُزمنا، أخذتُ رجالي
.وصرنا قطاع طرق

323
00:19:48,230 --> 00:19:50,080
!لكنّه قرار ممتاز

324
00:19:50,080 --> 00:19:53,030
نجني أموالًا أكثر ممّا كنّا
!نجنيه حين كنّا جنودًا

325
00:19:53,030 --> 00:19:54,670
...والأهم

326
00:19:55,270 --> 00:20:00,670
إنّ مصير الذين هزموا الجنرال
.بوروتز بات بين يديّ

327
00:20:01,500 --> 00:20:03,680
...تجرّأ على مسّ سيّدي أرس

328
00:20:03,680 --> 00:20:07,680
.وسأقتلك قبل أن تتاح لم فرصة للتفكير

329
00:20:09,080 --> 00:20:11,680
.كنتَ هكذا في ساحة المعركة أيضًا

330
00:20:12,290 --> 00:20:14,190
.لن أقتلك

331
00:20:14,190 --> 00:20:17,170
.لن أجني منك مالًا إن كنت ميتًا

332
00:20:17,170 --> 00:20:21,190
لكن بسبب كذبك والندبة
...التي تسببت بها

333
00:20:21,190 --> 00:20:22,940
!سأحتاج لردّ الصاع إليك

334
00:20:22,940 --> 00:20:23,780
!ريتز

335
00:20:24,950 --> 00:20:28,790
ما بك؟ أين ذلك الوحش الذي
!رأيته في ساحة المعركة؟

336
00:20:31,910 --> 00:20:34,290
لم تخرج منك حتّى صرخة واحدة إذًا؟

337
00:20:35,260 --> 00:20:38,920
،بما أنّك كنتَ عبدًا في السابق
.لا بدّ أنّك اعتدت تلقي الجلد

338
00:20:42,720 --> 00:20:43,930
!توقف

339
00:20:44,940 --> 00:20:47,080
.صحيح أنّني كذبت

340
00:20:47,080 --> 00:20:49,060
،لكن إن أردتَ معاقبة أحد

341
00:20:49,360 --> 00:20:51,680
!فعليك أن تعاقبني أنا، سيّده

342
00:20:52,020 --> 00:20:53,670
!لا يا سيّدي أرس

343
00:20:53,670 --> 00:20:55,810
.يا لجرأتك

344
00:20:59,040 --> 00:21:00,320
!سيّدي أرس

345
00:21:00,320 --> 00:21:04,360
!انظر إليك تتلوى
!أهذه أول مرّة تُجلد فيها؟

346
00:21:04,750 --> 00:21:06,770
!توقف

347
00:21:07,840 --> 00:21:13,050
تظاهر بالشجاعة كما تشاء. ينتزع هذا
.السوط الحقيقة من الجميع

348
00:21:15,070 --> 00:21:16,870
...هيّا، قُلها

349
00:21:17,390 --> 00:21:20,440
".اضربه بدلًا منّي"

350
00:21:21,630 --> 00:21:23,520
...إنّه محق! اتركني أحلّ محله

351
00:21:23,520 --> 00:21:24,840
!ستضربني أنا

352
00:21:28,720 --> 00:21:30,720
لِم تصرّ إلى هذا الحد
على تجنيبه العقاب؟

353
00:21:31,210 --> 00:21:35,140
.لأنّني عاجز من دون ريتز

354
00:21:35,980 --> 00:21:38,150
...السبب الوحيد الذي يتيح لي أن أكون سيدًا

355
00:21:38,780 --> 00:21:41,500
!هو ثقة النّاس بقدرتي على ذلك

356
00:21:41,500 --> 00:21:45,610
!لهذا لن أسمح لك بإيذاء أتباعي

357
00:23:26,130 --> 00:23:28,170
استخدمتَ عقلك حقًا
.آنذاك أيّها القائد

358
00:23:28,170 --> 00:23:29,690
صحيح؟ ألستُ رائعًا؟

359
00:23:29,690 --> 00:23:31,370
.كان هذا تهكمًا

360
00:23:31,370 --> 00:23:32,510
تهكم؟

361
00:23:32,510 --> 00:23:34,260
!أهذا نوع من الطعام؟

362
00:23:34,260 --> 00:23:36,510
!يبدو أنّ المسن بحاجة لتعليمك مجددًا

363
00:23:36,860 --> 00:23:39,570
"في الحلقة القادمة "ما يحتاجه الملك

364
00:23:39,570 --> 00:23:40,050
الحلقة القادمة   ما يحتاجه الملك