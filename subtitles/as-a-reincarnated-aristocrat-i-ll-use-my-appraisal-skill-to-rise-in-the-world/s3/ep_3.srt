1
00:00:00,810 --> 00:00:04,900
نهر كومير

2
00:00:14,880 --> 00:00:17,330
.سحركِ مذهل يا موشيا

3
00:00:17,330 --> 00:00:19,490
!أنتِ تتحسنين باستمرار

4
00:00:19,840 --> 00:00:21,620
!شكرًا جزيلًا

5
00:00:21,620 --> 00:00:24,450
!سأبذل قصارى جهدي لأصبح أكثر نفعًا

6
00:00:26,250 --> 00:00:29,570
لا نحظى بقسط من الرّاحة
حتّى بعد انتصارنا إذًا؟

7
00:00:29,570 --> 00:00:32,210
!يُرهقنا معلّمي بالعمل كثيرًا

8
00:00:32,720 --> 00:00:34,980
.انقلوا ذلك الطوب إلى الجهة الغربية

9
00:00:34,980 --> 00:00:35,810
!أمرك

10
00:00:35,810 --> 00:00:37,380
!ضعوا تلك بجوار البوابة

11
00:00:37,380 --> 00:00:37,930
!أمرك

12
00:00:39,390 --> 00:00:46,270
استطاع ريتز بفضل قيادته المحنّكة سحق
.طليعة جيش سيتز المكونة من 40 ألف جندي

13
00:00:46,640 --> 00:00:52,780
ذاع صيت حاصد الأرواح من لوفنت
،ومحاربتيه الساحرتين خارج ميسيان

14
00:00:52,780 --> 00:00:56,090
.ووصلت كذلك إلى صفوف قوات سيتز أيضًا

15
00:02:27,000 --> 00:02:32,000
الحلقة 27   زاهت وبراهام

16
00:02:27,690 --> 00:02:32,000
كان رجال سيتز أضعف ممّا توقعت

17
00:02:32,000 --> 00:02:34,080
.لم أضطر لبذل جهد يُذكر

18
00:02:34,080 --> 00:02:35,380
حقًا؟

19
00:02:35,910 --> 00:02:37,730
.تولَّ أمر هذه أيضًا إذًا

20
00:02:37,730 --> 00:02:39,380
!سهل جدًا

21
00:02:46,080 --> 00:02:48,570
...آمل أن تكون هذه نهاية الأمور ولكن

22
00:02:49,140 --> 00:02:52,650
حصن بولرايد، مقاطعة سيتز

23
00:02:49,630 --> 00:02:52,650
!سامحني أيّها القائد بوروتز

24
00:02:53,110 --> 00:02:56,530
لانتورك لودر

25
00:02:53,110 --> 00:02:56,530
.لا بأس. فقد قيّمنا قوّة العدو

26
00:02:56,930 --> 00:03:00,150
بات واضحًا لي لِم يصرّ
.الحاكم على القتال لكسب ما لديهم

27
00:03:00,150 --> 00:03:04,080
لكنّك منحتني هذه الفرصة
...رغم أنّني من أنصار الحاكم السابق

28
00:03:00,700 --> 00:03:04,580
بوروتز هيغاند

29
00:03:04,080 --> 00:03:07,160
!وها أنا أخذلك وأجلب العار عليك

30
00:03:08,030 --> 00:03:11,170
.أقاموا معسكرًا حصينًا بحق

31
00:03:11,600 --> 00:03:14,600
يسهلُ الدّفاع عنه حتّى
.في مواجهة جيش كبير

32
00:03:15,700 --> 00:03:18,830
.قائدهم ريتز، رجل داهية

33
00:03:20,240 --> 00:03:21,880
كاناري إذًا؟

34
00:03:21,880 --> 00:03:24,210
...ازداد اهتمامي أكثر من ذي قبل

35
00:03:25,820 --> 00:03:26,810
!يا جماعة

36
00:03:27,230 --> 00:03:29,810
!يبدو أنّ ريتز والبقية قد انتصروا

37
00:03:30,760 --> 00:03:32,960
!كما هو متوقع من ريتز

38
00:03:32,960 --> 00:03:36,020
تصدّوا لجيش يبلغ
!ضعف عددهم؟ هذا مذهل

39
00:03:36,350 --> 00:03:40,080
نأمل الآن أن يكفّوا عن
مهاجمتنا كليًا، صحيح؟

40
00:03:40,080 --> 00:03:41,360
.صحيح

41
00:03:42,330 --> 00:03:45,460
.دحرناهم كما خططنا

42
00:03:45,460 --> 00:03:47,970
...بات القرار بأيديهم الآن ولكن

43
00:03:49,630 --> 00:03:50,960
.عذرًا

44
00:03:51,270 --> 00:03:54,420
هل يمكنك إرسال مبعوث
إلى إقامة لوفنت؟

45
00:03:55,290 --> 00:03:58,300
معبر جديد

46
00:03:59,330 --> 00:04:00,800
أليس هذا مذهلًا؟

47
00:04:01,250 --> 00:04:04,620
لأيّ غرض تجمع كلّ هذه الأيائل؟

48
00:04:04,620 --> 00:04:07,280
!حسنًا، أطلقوا الأيائل

49
00:04:10,310 --> 00:04:12,880
!أرسلوا كلاب الصيد والفرسان خلفها

50
00:04:12,880 --> 00:04:14,480
!وجّهوها إلى النهر

51
00:04:22,000 --> 00:04:24,620
ما الغرض من هذا
أيّها القائد بوروتز؟

52
00:04:24,620 --> 00:04:27,370
.راقب فحسب. سترى قريبًا

53
00:04:39,750 --> 00:04:41,260
!نجحت في العبور

54
00:04:41,260 --> 00:04:43,310
...لم يكتمل الأمر بعد

55
00:04:51,210 --> 00:04:53,420
!هذا هو معبرنا الجديد

56
00:04:53,420 --> 00:04:55,580
!سنعبر النهر من هنا

57
00:04:56,980 --> 00:04:58,980
...القائد بوروتز

58
00:04:58,980 --> 00:05:01,220
!إنّه مذهل

59
00:05:01,220 --> 00:05:02,200
.لانتورك

60
00:05:02,200 --> 00:05:03,240
!حـ-حاضر؟

61
00:05:03,860 --> 00:05:05,950
السبب الذي جعلني
أعيّنك لهذه المهمة

62
00:05:05,950 --> 00:05:08,950
.هو ثقتي بحسن قيادتك

63
00:05:08,950 --> 00:05:10,240
.سأعتمد عليك في المرّة القادمة

64
00:05:10,680 --> 00:05:13,120
!أمرك! اترك الأمر لي

65
00:05:14,720 --> 00:05:17,120
!حالة طارئة أيّها القائد ريتز

66
00:05:17,750 --> 00:05:20,490
مستحيل! كيف استطاعُوا حشد
!قواتهم بهذه السرعة؟

67
00:05:20,490 --> 00:05:22,630
،على أيّ حال
!بدؤوا تحركهم بكل تأكيد

68
00:05:23,110 --> 00:05:27,380
،إن نجحوا في عبور النّهر
!فلن نصمد أمامهم

69
00:05:28,760 --> 00:05:29,890
ما الوضع؟

70
00:05:29,890 --> 00:05:32,890
أعالي نهر كومير

71
00:05:30,420 --> 00:05:32,270
.لا يقلّ عدد جنودهم عن 70 ألفًا

72
00:05:34,430 --> 00:05:35,640
!سبعون ألفًا؟

73
00:05:35,640 --> 00:05:38,310
!هذا يقارب ضعف عدد قوّاتهم السابقة

74
00:05:38,720 --> 00:05:41,070
.لا بأس حتّى لو كانوا ضعف عددنا

75
00:05:41,070 --> 00:05:43,780
ما زلتِ قادرة على سحقهم
بتعاويذكِ، صحيح يا أختاه؟

76
00:05:44,280 --> 00:05:45,400
.لا

77
00:05:45,940 --> 00:05:49,280
لم نُحضر معنا أيّ مُحفّزات سحرية كبيرة
.بسبب استعجالنا في القدوم إلى هنا

78
00:05:49,850 --> 00:05:53,540
لن نستطيع الاعتماد على خُطّة تعتمد
.على السحر كما فعلنا سابقًا

79
00:05:53,540 --> 00:05:55,040
...لحظة لكن هذا يعني

80
00:05:55,590 --> 00:05:57,660
!أنّنا في ورطة فعلية

81
00:05:57,660 --> 00:06:00,200
إلى التشكيل الدفاعي فورًا

82
00:06:00,200 --> 00:06:03,580
امنعوا العدو من العبور
!يا وحدة الهجوم بعيد المدى

83
00:06:07,480 --> 00:06:09,670
!العدو يتمركز

84
00:06:09,670 --> 00:06:12,430
!لتُفعّل الوحدة الأمامية تعاويذ الدفاع

85
00:06:15,410 --> 00:06:18,440
!احذروا الهجمات السحرية القوية

86
00:06:18,440 --> 00:06:21,810
!استعدُوا يا وحدة الهجوم بعيد المدى

87
00:06:22,280 --> 00:06:24,320
!أطلقوا السهام

88
00:06:25,180 --> 00:06:30,070
واجه ريتز جيشًا قوامه 70 ألف
،جندي بـ20 ألفًا

89
00:06:30,480 --> 00:06:32,320
.لكن قوّات سيتز كانت بأوج نشاطها

90
00:06:32,770 --> 00:06:35,400
،أمام موجات الجنود المتدفقة

91
00:06:35,400 --> 00:06:38,330
.كان سقوطهم حتميًا

92
00:06:41,850 --> 00:06:44,710
!توقفوا عن القتال
!انسحبوا مؤقتًا

93
00:06:44,710 --> 00:06:47,110
!انسحبوا بسرعة

94
00:06:47,110 --> 00:06:48,840
!اتركوا وراءكم ما لا نحتاج إليه

95
00:06:48,840 --> 00:06:52,350
!إنّهم يفرّون! تقدّموا

96
00:06:53,350 --> 00:06:56,770
الحرس الخلفي

97
00:06:54,270 --> 00:06:55,430
!يا كلامانت

98
00:06:56,180 --> 00:06:59,860
سأتولّى قيادة الحرس
.الخلفي لصدّ هجومهم

99
00:06:59,860 --> 00:07:01,600
!هل ستساندني؟

100
00:07:01,600 --> 00:07:04,250
.لا يمكننا المخاطرة بفقدان قائدنا

101
00:07:04,250 --> 00:07:05,990
.أنا سأتولّى قيادة الحرس الخلفي

102
00:07:05,990 --> 00:07:06,530
!لا

103
00:07:07,150 --> 00:07:08,960
،بعد أن أُجبِرنا على إصدار أمر بالانسحاب

104
00:07:08,960 --> 00:07:12,520
فإنّ القائد مسؤول عن
!تقليل الخسائر

105
00:07:12,520 --> 00:07:14,490
!أريد أن أتولى القيادة بنفسي

106
00:07:15,440 --> 00:07:16,910
!يا معلّمي

107
00:07:16,910 --> 00:07:18,900
ما رأيك أن تترك المهمة لي؟

108
00:07:18,900 --> 00:07:19,830
!براهام؟

109
00:07:20,230 --> 00:07:23,760
!اترك الأمر لوحدتي النّخبة

110
00:07:23,760 --> 00:07:25,440
...ركّز أنت على إصدار الأوامر

111
00:07:25,440 --> 00:07:27,680
!هذه ليست لعبة

112
00:07:27,680 --> 00:07:30,890
القتال أثناء الانسحاب قد يعرقل
!اتّخاذ القرارات السليمة

113
00:07:30,890 --> 00:07:33,230
!لا تملك الخبرة الكافية لذلك

114
00:07:33,230 --> 00:07:34,540
!أستطيع فعلها

115
00:07:35,570 --> 00:07:39,310
!أثق بأنَّ وحدتنا هي الأقوى في كاناري

116
00:07:39,310 --> 00:07:41,670
!وتزدادُ ثقتي بها إن كانت المهمة صعبة

117
00:07:41,670 --> 00:07:44,810
كما أنَّنا أمهر المقاتلين بعدك
!ما يعني أنَّ علينا تولّي المهمّة

118
00:07:45,420 --> 00:07:48,320
!أليس هذا هو الغرض من وجود وحدة نُخبة؟

119
00:07:48,630 --> 00:07:50,030
...أضِف إلى ذلك

120
00:07:50,400 --> 00:07:52,080
!لا، انسَ الأمر

121
00:07:52,080 --> 00:07:54,160
اتركني أتعامل معهم فحسب، اتفقنا؟

122
00:07:54,160 --> 00:07:58,490
هذه فرصتي لأريك
!مقدار ما تعلّمته منك

123
00:08:00,280 --> 00:08:01,600
.مفهوم

124
00:08:01,600 --> 00:08:04,140
.سأعهد إليك بحياة 20 ألف

125
00:08:04,630 --> 00:08:06,750
...لكنّي سأعطيك أمرًا إضافيًا

126
00:08:08,690 --> 00:08:10,510
.عُد حيًا

127
00:08:11,840 --> 00:08:13,660
!نعم، لا مشكلة

128
00:08:18,220 --> 00:08:21,230
!أعيدوا ملء مخزوننا من السائل السحري بسرعة

129
00:08:21,230 --> 00:08:22,980
!لن ننجو على هذا الحال

130
00:08:24,690 --> 00:08:25,980
!موشيا

131
00:08:39,200 --> 00:08:41,950
،أنا قائد وحدة النخبة في جيش كاناري

132
00:08:42,240 --> 00:08:44,210
!براهام جو

133
00:08:45,200 --> 00:08:46,710
...لديّ سؤال لكم

134
00:08:47,130 --> 00:08:49,590
!ألكم أمّهات في وطنكم؟

135
00:08:53,040 --> 00:08:55,460
إن أردتُم فرصة للعودة
،إلى أحضان أمهاتكم

136
00:08:55,460 --> 00:08:57,800
!فعودوا أدراجكم حالًا

137
00:09:00,580 --> 00:09:03,520
لكن إن أردتُم أن تتركوها
،تبكي عند قبوركم

138
00:09:03,520 --> 00:09:05,190
!فلتبقوا لتواجهوا مصيركم

139
00:09:08,120 --> 00:09:09,520
!هيّا يا رجال

140
00:09:18,140 --> 00:09:21,190
هل علينا مواجهة جيش
!مكون من 70 ألف جندي بمفردنا؟

141
00:09:21,190 --> 00:09:22,680
!هـ-هذا مرعب

142
00:09:22,680 --> 00:09:23,700
!أنت

143
00:09:23,700 --> 00:09:24,960
!نـ-نعم؟

144
00:09:25,470 --> 00:09:27,210
!أنت شجاع يا رجل

145
00:09:28,480 --> 00:09:30,460
أنت ترتجف من شدّة الحماس، صحيح؟

146
00:09:31,100 --> 00:09:34,720
أنت مُتحمّس لإثبات رجولتك حتّى
!أنّك لا تستطيع التوقف عن الارتجاف

147
00:09:35,070 --> 00:09:35,990
!هل تسمعونني؟

148
00:09:35,990 --> 00:09:40,930
!نحن أشرس وأفضل الرجال في كاناري بأسرها

149
00:09:41,490 --> 00:09:46,720
غدًا، سيعرف الجميع في
!ميسيان أسماءنا

150
00:09:48,900 --> 00:09:50,710
!نعم، هذا صحيح

151
00:09:50,710 --> 00:09:51,900
!لنفعلها

152
00:09:52,320 --> 00:09:53,900
!هذا ينطبق عليك أيضًا، صحيح؟

153
00:09:55,320 --> 00:09:56,400
!نعم

154
00:10:04,080 --> 00:10:05,660
.فهمت

155
00:10:06,430 --> 00:10:11,050
أدركتُ أخيرًا سبب تعليق
.أرس آمالًا كبيرة عليه

156
00:10:16,460 --> 00:10:17,690
...براهام

157
00:10:21,520 --> 00:10:23,550
.كسبنا وقتًا كافيًا

158
00:10:23,550 --> 00:10:25,310
.يفترض أن تكون القوات الرئيسية بأمان الآن

159
00:10:25,310 --> 00:10:27,660
.سيكونُ بقاؤنا هنا مدّة أطول أمرًا خطيرًا

160
00:10:29,420 --> 00:10:30,570
.فهمت

161
00:10:31,070 --> 00:10:34,020
!هيّا يا رفاق! انسحبوا بأقصى سرعة

162
00:10:37,990 --> 00:10:39,560
!لن تهربوا

163
00:10:39,990 --> 00:10:41,740
!اخترقوا صفوفهم

164
00:10:52,540 --> 00:10:54,630
!خذ سيفي أيّها القائد

165
00:10:55,080 --> 00:10:56,590
!ماذا تفعل بحق؟

166
00:10:59,050 --> 00:11:02,180
!واصلوا المسير! سألحق بكم

167
00:11:06,370 --> 00:11:08,150
!علينا إنقاذ القائد

168
00:11:08,150 --> 00:11:10,270
!إنّهم يفوقوننا عددًا بكثير يا أحمق

169
00:11:10,270 --> 00:11:12,600
!وهناك المزيد منهم قادمون

170
00:11:12,600 --> 00:11:14,630
!لكن لا يمكننا أن نتركه يموت

171
00:11:15,360 --> 00:11:18,190
.قد يكون هذا في صالحي

172
00:11:18,900 --> 00:11:23,070
سأصبح القائد الجديد
.إن تخلّيتُ عنه الآن

173
00:11:23,450 --> 00:11:27,000
لم أرغب قط في العمل
...تحت إمرة هذا الشقي

174
00:11:25,940 --> 00:11:27,830
!يا نائب القائد! يا نائب القائد

175
00:11:27,830 --> 00:11:28,620
!أوامرك

176
00:11:31,330 --> 00:11:32,580
!زاهت

177
00:11:33,260 --> 00:11:35,100
!تولَّ أمر الوحدة

178
00:11:35,100 --> 00:11:37,270
...وأبلغ معلّمي

179
00:11:38,560 --> 00:11:41,840
!أنّني آسف لأنّني عجزتُ عن تنفيذ أوامره

180
00:11:45,980 --> 00:11:48,970
.نعم، أنا أحمق فعلًا

181
00:11:52,800 --> 00:11:56,900
قبل تسع سنوات، حين كنتُ
...في الثامنة من عمري

182
00:11:55,020 --> 00:11:58,400
مولد محارب

183
00:11:56,900 --> 00:12:00,480
!تفوّقت وحدتنا عليكم جميعًا اليوم

184
00:12:00,480 --> 00:12:04,400
!لا تبالغ. نحن من أنجز معظم العمل

185
00:12:09,290 --> 00:12:11,460
...إنّهما الرجلان من عائلة جو

186
00:12:11,460 --> 00:12:14,830
.سمعتُ أنّهما قاتلا ببراعة اليوم أيضًا

187
00:12:14,830 --> 00:12:19,020
.محال أن نخسر ما داما إلى جانبنا

188
00:12:14,830 --> 00:12:19,250
براهام جو، عمره 8 سنوات

189
00:12:19,680 --> 00:12:21,340
!أخي الكبير! أبي

190
00:12:21,850 --> 00:12:23,300
!مرحبًا بعودتكما

191
00:12:23,300 --> 00:12:25,680
.شكرًا لاستقبالك لنا يا براهام

192
00:12:25,680 --> 00:12:28,400
!صرتُ قادرًا على ركوب الخيل

193
00:12:28,400 --> 00:12:30,850
آمل أن أقاتل إلى جانبكما
!في ساحة المعركة قريبًا

194
00:12:30,850 --> 00:12:33,240
.يسعدنا أن تنضمّ إلينا

195
00:12:33,240 --> 00:12:36,100
لكن أتَرى هذا السلاح الذي
توارثته عائلة جو؟

196
00:12:36,800 --> 00:12:40,680
لن تصبح رجلًا بحق حتّى
.تستطيع التلويح به ببراعة

197
00:12:42,940 --> 00:12:46,060
،منذ عهد جدّ جدّي

198
00:12:46,060 --> 00:12:50,620
كانت أسرة جو عائلة محاربين
.تخدم أساسًا كفرسان

199
00:12:51,050 --> 00:12:57,660
كنتُ أنا، أبي، وأخي الكبير نُلبّي
.النداء ونجوب أنحاء سمرفورث

200
00:12:58,560 --> 00:13:02,720
لم أُجِد حتّى ركوب الخيل
،جيدًا ولم أملك سلاحًا

201
00:13:02,720 --> 00:13:06,130
لذا كنتُ أبقى في المؤخرة
.وأساندهما من هناك

202
00:13:06,940 --> 00:13:08,640
...لكنّني كنتُ أعلم أنّي يومًا ما

203
00:13:09,250 --> 00:13:13,100
سأمتطي أحد تلك الخيول الأصيلة
،ألوّح بسلاح ضخم

204
00:13:13,100 --> 00:13:16,140
!وأصبح محاربًا عظيمًا مثلهما

205
00:13:16,610 --> 00:13:18,220
.هذا ما ظننته على الأقل

206
00:13:20,200 --> 00:13:21,100
!براهام

207
00:13:22,300 --> 00:13:24,150
!أ-أخي الكبير

208
00:13:24,560 --> 00:13:26,930
هل أنت بخير؟ أين أبي؟

209
00:13:27,920 --> 00:13:29,450
.أنا ذاهب لإنقاذه الآن

210
00:13:29,450 --> 00:13:30,530
.أحتاج إلى مزيد من الأسلحة

211
00:13:30,880 --> 00:13:34,200
!نعم، أبي يعادل 10 مقاتلين، صحيح؟

212
00:13:34,200 --> 00:13:35,860
!اذهب واحسم الأمر يا أخي

213
00:13:40,080 --> 00:13:41,190
.خذ

214
00:13:41,660 --> 00:13:42,670
.براهام

215
00:13:43,540 --> 00:13:45,010
.احتفظ بهذا السلاح

216
00:13:49,830 --> 00:13:51,940
لكن ألن تحتاج إليه؟

217
00:13:51,940 --> 00:13:53,610
!خذه معك

218
00:13:54,470 --> 00:13:57,180
.لن أحتاجه للتعامل مع أولئك الخاسرين

219
00:13:57,180 --> 00:13:59,150
.حسنًا، إلى اللقاء

220
00:14:00,530 --> 00:14:03,190
!عليك أن تعود سالمًا

221
00:14:04,530 --> 00:14:08,300
.لكن أبي وأخي لم يعودا أبدًا

222
00:14:11,900 --> 00:14:14,630
،حتّى بعد انتهاء الحرب

223
00:14:14,630 --> 00:14:17,120
.لم يُخبرني أحد إن كانا قد ماتا أم ما زالا حيين

224
00:14:18,510 --> 00:14:20,990
.تأخّرا كثيرًا في العودة

225
00:14:20,990 --> 00:14:21,970
.أنت

226
00:14:22,630 --> 00:14:24,760
أنت الفتى من أسرة جو، صحيح؟

227
00:14:24,760 --> 00:14:26,970
ماذا تفعل هنا؟

228
00:14:26,970 --> 00:14:28,250
.أنا أنتظر

229
00:14:28,250 --> 00:14:30,510
.سيعود أبي وأخي قريبًا

230
00:14:30,510 --> 00:14:32,480
.كفّ عن السذاجة

231
00:14:32,480 --> 00:14:34,510
.من الواضح أنّهما ماتا في المعركة

232
00:14:34,950 --> 00:14:36,640
.لم يموتا

233
00:14:36,640 --> 00:14:39,670
.قال بقية أفراد وحدتهما أنّهُما ماتا

234
00:14:39,670 --> 00:14:43,030
.لقد كذبوا. لا تعرف أسرتي الهزيمة

235
00:14:43,030 --> 00:14:45,170
لِماذا لم يعودا إذًا؟

236
00:14:45,170 --> 00:14:46,780
،إن كانا حيّين ولم يعودا

237
00:14:46,780 --> 00:14:49,420
فهذا يعني أنّهما تخلّيا عنك، صحيح؟

238
00:14:49,420 --> 00:14:51,110
.يا لها من أسرة قاسية

239
00:14:53,770 --> 00:14:55,300
!اصمت

240
00:14:55,300 --> 00:14:58,320
!لن أسمح لك بالإساءة إليهما

241
00:14:58,320 --> 00:15:00,480
!أخي وأبي لا يزالان حيّين

242
00:15:00,480 --> 00:15:02,330
...لا يهم ما يقوله أيّ أحد

243
00:15:02,330 --> 00:15:04,670
!أنا أثق بهما

244
00:15:06,610 --> 00:15:07,920
...يا صبي

245
00:15:12,670 --> 00:15:14,050
.وجدتُها

246
00:15:14,340 --> 00:15:15,580
!هذا

247
00:15:18,900 --> 00:15:21,430
،إن اكتسبتُ شهرة بهذا

248
00:15:21,430 --> 00:15:24,520
!فسيضطر أبي وأخي إلى ملاحظتي

249
00:15:24,520 --> 00:15:30,140
كلّ ما عليّ فعله هو أن أصبح أعظم
!وأشهر رجل في سمرفورث

250
00:15:35,830 --> 00:15:38,220
.انتظروا هنا حتّى تصلنا الإشارة

251
00:15:38,940 --> 00:15:39,540
!أحمق

252
00:15:39,920 --> 00:15:43,170
،اسمي براهام جو

253
00:15:43,610 --> 00:15:45,880
!وسأصبح أعظم رجل في العالم

254
00:15:47,900 --> 00:15:49,410
.سأصبح أقوى

255
00:15:50,420 --> 00:15:53,890
سأزدادُ قوّة يومًا بعد يوم
...وأصبح مشهورًا

256
00:15:54,480 --> 00:15:55,770
...حين أحقق ذلك

257
00:15:59,470 --> 00:16:03,020
!أعلم أنّهما سيعودان إليّ

258
00:16:10,110 --> 00:16:11,580
!براهام

259
00:16:16,080 --> 00:16:17,120
...زاهت، أنت

260
00:16:17,120 --> 00:16:20,830
!إيّاك أن تستسلم! انهض حالًا

261
00:16:21,140 --> 00:16:23,140
!لكن عددهم كبير

262
00:16:23,140 --> 00:16:23,960
...عليك أن تهرب

263
00:16:23,960 --> 00:16:26,500
!حسبتُ أنّك براهام جو

264
00:16:27,030 --> 00:16:29,500
حسبتُ أنّك ستصبح أعظم
!رجل في العالم

265
00:16:29,840 --> 00:16:30,630
!اللّعنة

266
00:16:32,820 --> 00:16:36,970
!إيّاك أن تهدر حياتك بهذه السهولة

267
00:16:39,350 --> 00:16:42,190
!لن يُغيّر انضمام مقاتل آخر شيئًا

268
00:16:42,190 --> 00:16:43,560
!طوّقوهما

269
00:16:48,180 --> 00:16:51,300
!يا لك من قائد كثير المتاعب

270
00:16:55,540 --> 00:16:57,280
!شكرًا جزيلًا يا زاهت

271
00:16:57,280 --> 00:16:59,080
...نسيتُ ذلك للحظة

272
00:16:59,450 --> 00:17:03,540
عاهدتُ نفسي بهذا السلاح
...أن أفعل ما عليّ فعله

273
00:17:03,540 --> 00:17:05,580
!ولن أموت قبل أن أفي بعهدي

274
00:17:06,330 --> 00:17:08,860
،اسمي براهام جو

275
00:17:08,860 --> 00:17:10,840
!وسأصبح أعظم رجل في العالم

276
00:17:10,840 --> 00:17:13,270
!إنّه يخادعنا! كاد يموت

277
00:17:13,270 --> 00:17:14,220
!انطلقوا

278
00:17:21,960 --> 00:17:23,350
!يا قائد

279
00:17:24,400 --> 00:17:25,850
!اركب

280
00:17:29,360 --> 00:17:31,520
!ماذا عسى هذان الاثنان فعله وحدهما؟

281
00:17:31,520 --> 00:17:33,260
...اقضوا عليهما

282
00:17:36,000 --> 00:17:39,820
يا قائد! لا تحاول أن
!تصبح أسطورة بمفردك

283
00:17:40,240 --> 00:17:42,790
!لا تستحق أن تحظى بموت عظيم كهذا

284
00:17:43,060 --> 00:17:47,060
!أنتم جميعًا حمقى مثلي

285
00:17:47,060 --> 00:17:49,080
!حسنًا، لنخرج من هنا

286
00:17:49,500 --> 00:17:52,130
!لا تدعوهم يفرّون! طاردوهم

287
00:18:06,980 --> 00:18:10,070
.يبدو أنّهم بدؤوا يتراجعون

288
00:18:10,070 --> 00:18:11,500
.عمل رائع

289
00:18:13,030 --> 00:18:14,200
يا قائد؟

290
00:18:14,200 --> 00:18:15,860
!يا قائد

291
00:18:20,250 --> 00:18:21,450
...يا إلهي

292
00:18:21,990 --> 00:18:24,290
.لا تُخفني هكذا

293
00:18:30,500 --> 00:18:32,000
!لقد عادوا

294
00:18:33,330 --> 00:18:35,840
!عُدنا سالمين

295
00:18:36,200 --> 00:18:38,230
!فعلوها حقًا

296
00:18:38,230 --> 00:18:40,510
!أفلتوا من مطاردة 10 ألف جندي

297
00:18:41,420 --> 00:18:42,970
!معلّمي

298
00:18:44,290 --> 00:18:46,000
.أحسنتَ يا براهام

299
00:18:46,000 --> 00:18:48,100
.لهذا السبب أنت أفضل تلاميذي

300
00:18:48,450 --> 00:18:50,400
!نعم، أحسنتُ صنعًا

301
00:18:50,400 --> 00:18:53,060
.وأنا ظننتُ أنّك هالك لا محالة

302
00:18:53,060 --> 00:18:54,660
!لئيمة

303
00:18:56,450 --> 00:18:58,510
!هذا طبيعي

304
00:18:58,510 --> 00:19:00,660
...لِم يذكّرني

305
00:19:01,520 --> 00:19:04,770
.رغم أنّهما لا يتشابهان في شيء

306
00:19:06,660 --> 00:19:10,080
ماضي زاهت

307
00:19:06,660 --> 00:19:08,770
هل ستغادر بالفعل يا أبي؟

308
00:19:08,770 --> 00:19:11,120
.وصلني للتو عرض عمل مُغرٍ

309
00:19:11,120 --> 00:19:13,030
.سأعود بعد أسبوعين

310
00:19:13,030 --> 00:19:15,460
ستأتي السيّدة التي في الجهة
.المقابلة لتفقد أحوالك

311
00:19:21,340 --> 00:19:22,570
.عليك أن تفهم الأمر

312
00:19:23,180 --> 00:19:27,020
أحتاج إلى المال لأصطحبك
.إلى ذلك الطبيب في العاصمة

313
00:19:27,980 --> 00:19:31,560
...أعلم. لكنّني كنتُ أفضّل لو

314
00:19:32,700 --> 00:19:35,570
أعلم. سنلعبُ قدر ما تشاء
.عندما تتعافى بالكامل

315
00:19:36,340 --> 00:19:38,630
!حسنًا. رافقتك السلامة

316
00:19:39,640 --> 00:19:44,870
كلّ ما أتذكره من تلك
.الفترة هو القتال

317
00:19:45,200 --> 00:19:48,870
قاتلتُ بلا توقف
...محاولًا كسب المال

318
00:19:49,160 --> 00:19:51,740
...وحين عدتُ إلى المنزل أخيرًا

319
00:19:52,930 --> 00:19:54,620
.كان ابني قد مات

320
00:19:55,760 --> 00:19:57,260
...لماذا لم

321
00:19:59,750 --> 00:20:02,160
،فقدتُ سببي للقتال

322
00:20:02,160 --> 00:20:05,480
لكنّني لم أستطع التخلص من شعوري
،بالذنب لعدم امتلاكي مالًا كافيًا

323
00:20:05,480 --> 00:20:08,260
.لذا لم أستطِع تغيير نمط حياتي

324
00:20:08,880 --> 00:20:13,540
لا... بل لأنّني لو أقررتُ
،بأنّ خياري كان خاطئًا

325
00:20:13,540 --> 00:20:16,020
،لربّما حطّمني ذلك نفسيًا

326
00:20:16,710 --> 00:20:20,030
مُتسائلًا لماذا لم أقضِ
...معه وقتًا أطول

327
00:20:20,790 --> 00:20:22,530
.الأمر نفسه ينطبق عليه

328
00:20:23,170 --> 00:20:26,030
.لا أشعر بأيّ مسؤولية تجاهه

329
00:20:26,470 --> 00:20:28,210
.بل إنّ حياتي ستكون أفضل من دونه

330
00:20:29,190 --> 00:20:34,370
لكن أكنتُ سأضحّي به هو الآخر
بسبب أسلوب عيشي؟

331
00:20:36,540 --> 00:20:38,710
.سُلب ابني مستقبله

332
00:20:39,270 --> 00:20:44,490
لم أستطع أن أبقى متفرجًا
!بينما يُسلب طفل آخر مستقبله

333
00:20:48,570 --> 00:20:49,950
!يا نائب القائد زاهت

334
00:20:50,470 --> 00:20:54,430
سِرنا على خطاك
!لأنّك بيّنتَ لنا السبيل

335
00:20:54,980 --> 00:20:56,120
!شكرًا

336
00:20:56,120 --> 00:20:57,860
!شكرًا

337
00:20:57,860 --> 00:20:59,600
...لم أفعل شيئًا يُذكر

338
00:20:59,600 --> 00:21:01,360
!زاهت

339
00:21:10,340 --> 00:21:15,020
.لعلني لم أتّخذ القرار الخاطئ هذه المرّة

340
00:21:18,580 --> 00:21:22,340
حصن كومير

341
00:21:19,070 --> 00:21:20,500
.فهمت

342
00:21:20,500 --> 00:21:22,340
.يبدو أنّها كانت معركة عسيرة

343
00:21:22,770 --> 00:21:25,950
.شكرًا لكم على حماية جنودنا العشرين ألفًا

344
00:21:25,950 --> 00:21:28,220
.كنتَ الشّخص المناسب لهذه المهمّة يا ريتز

345
00:21:28,590 --> 00:21:31,680
.لا، خسرتُ رغم ذلك

346
00:21:31,680 --> 00:21:35,230
زمام المبادرة في أيديهم
.الآن وعلينا الردّ سريعًا

347
00:21:35,670 --> 00:21:38,640
.لم يقتصر الأمر على ريتز وشارلوت

348
00:21:38,640 --> 00:21:42,300
...بل موشيا، براهام، وزاهت

349
00:21:42,300 --> 00:21:45,740
بذل كلّ أتباعي الجُدد جهدًا
.كبيرًا لصدّ العدو

350
00:21:46,660 --> 00:21:48,990
.والآن عليّ أن أكون على قدر حماسهم

351
00:21:49,470 --> 00:21:51,720
!يبدأ الهجوم المضاد الآن

352
00:21:51,720 --> 00:21:54,250
!حان دورنا لنُبادر بالهجوم

353
00:23:26,500 --> 00:23:28,550
أبلى براهام بلاءً رائعًا إذًا؟

354
00:23:28,550 --> 00:23:32,020
.أنا فخور بما بلغه من تطور

355
00:23:32,020 --> 00:23:34,650
.يبدأ هجومنا المضاد الآن

356
00:23:34,650 --> 00:23:37,350
!سنحمي كاناري مهما كلّفنا الأمر

357
00:23:37,350 --> 00:23:38,680
".الحلقة القادمة "نهاية العدائية

358
00:23:38,680 --> 00:23:48,680
الحلقة القادمة   نهاية العدائية