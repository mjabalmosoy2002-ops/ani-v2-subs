1
00:00:05,020 --> 00:00:08,020
.أريمورا-سان، حان وقت قياس حرارتك

2
00:00:08,020 --> 00:00:10,360
ماذا؟ أريمورا-سان؟

3
00:00:11,650 --> 00:00:13,500
أريمورا-سان؟

4
00:02:09,520 --> 00:02:10,840
!اسمعوا جميعًا

5
00:02:10,840 --> 00:02:14,650
!هذا هو اليوم الّذي طالما انتظرتموه
!إنّه سباق تلاميذ السّنة الثّالثة

6
00:02:14,650 --> 00:02:20,050
!أريدك أن تظهروا لي كلّ ما درستموه

7
00:02:20,050 --> 00:02:21,680
.حافظوا على هدوئكم طوال الوقت

8
00:02:21,680 --> 00:02:23,510
.قوموا بذلك كما تدرّبتم

9
00:02:23,990 --> 00:02:25,120
!حاضر

10
00:02:28,620 --> 00:02:29,700
!إنّهم مستر دكتور

11
00:02:31,570 --> 00:02:33,470
!الرّئيسة سايونجي هناك أيضًا

12
00:02:35,900 --> 00:02:38,090
.هذا مختلف تمامًا عن آخر مرّة

13
00:02:38,090 --> 00:02:41,760
هذه السّباقات طريقة لتقديم
.هؤلاء التّلاميذ للعالم بأكمله

14
00:02:41,760 --> 00:02:44,350
.إنّها أشبه بمهرجان كبير

15
00:02:45,400 --> 00:02:47,090
.ستكون هذه حفلة ممتازة

16
00:02:47,580 --> 00:02:48,640
.نعم

17
00:02:48,640 --> 00:02:51,390
.أنا سعيدة لأنّ مستر دكتور تمكّنوا من الحضور

18
00:02:51,390 --> 00:02:55,830
لم يكن لنا خيار آخر، بعد المشاكل
.الّتي تسبّبنا بها في المدرسة

19
00:02:56,140 --> 00:03:00,210
إن شارك مستر دكتور في حدث هنا
.مقابل مغادرة يو المدرسة

20
00:03:00,210 --> 00:03:01,740
.فستكون قصّة جيّدة في الحقيقة

21
00:03:02,840 --> 00:03:05,580
.صرتِ أفضل كممثّلة

22
00:03:05,580 --> 00:03:07,270
.شكرًا لك

23
00:03:11,830 --> 00:03:14,130
!إنّه وقت العرض

24
00:03:14,370 --> 00:03:18,760
!تمّ تمشيط الخيول بشكل جميل

25
00:03:18,760 --> 00:03:21,510
.التّلاميذ الكبار متوتّرون

26
00:03:21,510 --> 00:03:23,290
.إنّ الملامح الّتي تعلو وجوههم مختلفة تمامًا

27
00:03:23,290 --> 00:03:25,580
.يتوقّع الواحد منّا أنّهم سيلوّحون لنا

28
00:03:25,580 --> 00:03:27,510
.إنّ أذهانهم مشغولة بأمور أخرى

29
00:03:30,420 --> 00:03:34,190
.شكرًا على كلّ شيء

30
00:03:35,270 --> 00:03:37,390
.إنّه تلميذ مهمّ لدينا

31
00:03:37,390 --> 00:03:41,110
ولكنّ الخيار عائد إليه بغضّ
.النّظر إن كنّا قد جهّزنا لهذا

32
00:03:41,110 --> 00:03:42,870
.أنت قاسٍ

33
00:03:44,870 --> 00:03:45,890
!تاكو-سان

34
00:03:45,890 --> 00:03:46,910
كيف سار الأمر؟

35
00:03:46,910 --> 00:03:48,260
.لا بأس

36
00:03:48,260 --> 00:03:49,480
...حمدًا على هذا

37
00:03:49,480 --> 00:03:50,740
.أراحني هذا

38
00:03:50,740 --> 00:03:52,500
.سيتفاجأ الجميع

39
00:03:52,770 --> 00:03:55,510
.لا أطيق الانتظار حتّى أراه ثانية

40
00:03:55,510 --> 00:03:56,540
.نعم

41
00:03:58,900 --> 00:04:00,050
.هوشو-كُن

42
00:04:01,750 --> 00:04:03,430
.ضع ثقتك بيو

43
00:04:08,830 --> 00:04:10,940
يو، ما الّذي تفعله؟

44
00:04:11,560 --> 00:04:13,100
!يو، توقّف

45
00:04:16,360 --> 00:04:17,500
!يو

46
00:04:22,020 --> 00:04:22,990
!اتركيني

47
00:04:24,210 --> 00:04:25,200
.تاكو-سان

48
00:04:32,730 --> 00:04:34,450
.أعطيته الإذن بذلك

49
00:04:34,450 --> 00:04:35,790
...لكن أيّها الطّبيب

50
00:04:35,790 --> 00:04:38,420
.وعدني أنّه لن يبالغ في ذلك

51
00:04:38,740 --> 00:04:41,950
.إنّه يريد التّحسّن بالفعل

52
00:04:42,430 --> 00:04:46,430
.قرّرت أنّ سلوكه المتفائل قد يساعده على الشّفاء

53
00:04:46,660 --> 00:04:47,670
...ولكن

54
00:04:48,910 --> 00:04:51,810
.لا أستطيع ضمان أنّه سيتحسّن خلال شهر

55
00:05:06,810 --> 00:05:07,640
نعم؟

56
00:05:07,640 --> 00:05:09,160
!لديّ توصيل لك

57
00:05:15,730 --> 00:05:16,950
إري-تشان؟

58
00:05:23,220 --> 00:05:26,910
.تاكو-سان، آسفة على إرسال هذه لك

59
00:05:27,500 --> 00:05:32,640
،لا أستطيع الاتّصال بأريمورا
.لذلك أوصليها له رجاءً

60
00:05:32,640 --> 00:05:36,390
إنّها تتضمّن نسخًا عن ملاحظاتنا في الفصول

61
00:05:36,390 --> 00:05:39,810
.وملفّات فيديو لتداريبنا وركوبنا

62
00:05:40,200 --> 00:05:44,920
،قد لا يستطيع أريمورا التّدرّب الآن

63
00:05:44,920 --> 00:05:48,530
لكن أعتقد أنّ مشاهدة طرق ركوب
.كازانامي وأماني قد تساعده على التّعلّم

64
00:05:48,530 --> 00:05:51,370
!قد يساعده ماكي على تعلّم كيف لا يركب

65
00:05:51,370 --> 00:05:56,000
.ردّ ماكي قائلاً "هذا فظيع" عندما كتبتُ هذا

66
00:05:56,000 --> 00:05:59,880
.يؤمن الجميع أنّ أريمورا سيعود

67
00:06:00,270 --> 00:06:04,130
.لذلك نرجوك، أوصليها له

68
00:06:04,620 --> 00:06:07,390
.أعلم أنّه طلب صعب

69
00:06:07,390 --> 00:06:11,710
وفي زيارتك القادمة لكيوتو، سأدعوك
.لوجبة مجّانيّة في مطعم عائلتي

70
00:06:26,150 --> 00:06:30,370
تعلو وجه يو نفس الملامح
.الّتي علت وجهه وقتها

71
00:07:05,990 --> 00:07:07,910
!يو، سأكون في الانتظار

72
00:07:08,520 --> 00:07:09,850
!المعذرة

73
00:07:09,850 --> 00:07:12,090
أنت مع مستر دكتور، صحيح؟

74
00:07:12,090 --> 00:07:13,810
.لدينا مشكلة

75
00:07:15,690 --> 00:07:17,870
!ليغيّر تلاميذ السّنة الأولى ملابسهم

76
00:07:17,870 --> 00:07:18,810
!حالاً

77
00:07:24,230 --> 00:07:26,180
.مع السّلامة جميعًا

78
00:07:26,760 --> 00:07:28,300
!هاياتو

79
00:07:33,130 --> 00:07:35,420
تتظاهر أنّك راشد حتّى النّهاية، صحيح؟

80
00:07:35,420 --> 00:07:38,100
.وأنت ما زلت تتصرّف كطفل

81
00:07:38,100 --> 00:07:40,340
.أنا جيّد كما أنا

82
00:07:41,810 --> 00:07:43,870
.هاياتو، شكرًا لك

83
00:07:44,330 --> 00:07:45,080
.العفو

84
00:07:45,550 --> 00:07:46,700
!إلى اللّقاء

85
00:07:53,180 --> 00:07:54,690
تغيير في الخطّة؟

86
00:07:54,690 --> 00:07:55,780
المعذرة؟

87
00:07:55,780 --> 00:08:00,770
أصرّت الرّئيسة  على إنهاء حفل مستر دكتور

88
00:08:00,770 --> 00:08:02,710
.بينما مل زالت الكاميرات تصوّر

89
00:08:02,710 --> 00:08:03,660
وماذا في ذلك؟

90
00:08:03,660 --> 00:08:05,670
سيقومون بتسجيل برامج الحدث

91
00:08:05,670 --> 00:08:11,010
ليتمّ تبكير فقرة قفز تلاميذ السّنة
.الأولى بربع ساعة

92
00:08:11,010 --> 00:08:13,130
.قالوا أنّ المدير وافق

93
00:08:13,130 --> 00:08:15,630
.مذهل. هذا سيّئ

94
00:08:15,630 --> 00:08:17,300
متى سيأتي أريمورا؟

95
00:08:17,300 --> 00:08:20,890
...إن ركض من المحطّة، فسيصل في الوقت

96
00:08:20,890 --> 00:08:23,790
.لا، أفضّل ألاّ يتعب نفسه

97
00:08:23,790 --> 00:08:25,340
...لكن ليست لدينا أيّ سيّارات

98
00:08:26,230 --> 00:08:27,310
.أبي

99
00:08:28,840 --> 00:08:29,800
.هاياتو

100
00:08:30,570 --> 00:08:32,110
.دع الأمر لي

101
00:08:47,330 --> 00:08:49,720
!سُحقًا! ليس الآن

102
00:08:55,810 --> 00:08:57,110
سيأتي من يُقلّني؟

103
00:09:07,220 --> 00:09:09,550
.لم أرك منذ مدّة يا أريمورا

104
00:09:11,020 --> 00:09:14,030
تي إم أوبرا أو

105
00:09:11,020 --> 00:09:14,030
السّجلّ: 26 مباراة    14 انتصارًا
الجنس: ذكر
اللّون: كستنائيّ

106
00:09:11,020 --> 00:09:14,030
:إنجازات مهمّة
ساتسكي شو تنّو شو
دورة الرّبيع)    انتصارات)
تاكارازوكا
(كينّن تنّو شو (دورة الخريف
كأس اليابان
أريما كينّن

107
00:09:11,020 --> 00:09:14,030
صخب المراهقة

108
00:09:16,580 --> 00:09:19,070
.لم أتوقّع هذه المفاجأة

109
00:09:19,070 --> 00:09:24,350
قالت تاكو-سان أنّ هذه هي أفضل
.طريقة لدفع الرّئيسة على قبول الأمر

110
00:09:24,350 --> 00:09:26,580
إذًا فهكذا هو عالم الكبار؟

111
00:09:28,700 --> 00:09:31,090
هاياتو، كيف هو حالك؟

112
00:09:31,090 --> 00:09:32,030
.أنا بخير

113
00:09:32,360 --> 00:09:34,590
.آكل بشكل عاديّ هذه الأيّام

114
00:09:38,540 --> 00:09:40,850
كيف حال يدك اليمنى؟

115
00:09:40,870 --> 00:09:42,320
.إنّها لا بأس الآن

116
00:09:42,320 --> 00:09:43,350
.وكأنّها جديدة

117
00:09:44,910 --> 00:09:47,710
.أنا آسف بشأن الحادثة

118
00:09:47,710 --> 00:09:49,210
.ليس عليك الاعتذار

119
00:09:49,540 --> 00:09:53,360
وصلتُ إلى هذه المرحلة بفضل
.دعمك لي أنت والبقيّة

120
00:09:55,410 --> 00:09:56,410
.فهمت

121
00:09:57,360 --> 00:10:01,630
.كنتُ سعيدًا لأنّك أخبرتني ألاّ أستسلم

122
00:10:01,630 --> 00:10:06,100
.أنا من كان متبلّدًا في مشاعره. أعتذر منك

123
00:10:06,100 --> 00:10:07,330
.ما حدث قد حدث

124
00:10:08,660 --> 00:10:10,820
.تجاوزت الأمر الآن

125
00:10:11,730 --> 00:10:12,420
.نعم

126
00:10:13,970 --> 00:10:18,340
.أريمورا، ما عدتُ تلميذًا في مدرسة سباقات الخيول

127
00:10:19,210 --> 00:10:20,010
...لكن

128
00:10:20,440 --> 00:10:23,510
.لم أتخلّى عن ركوب الخيول

129
00:10:23,510 --> 00:10:25,310
.نعم، أعلم ذلك

130
00:10:28,150 --> 00:10:29,000
...لذلك

131
00:10:32,350 --> 00:10:38,280
لنحصل على كلمة من كلّ واحد من
.التّلاميذ الجدد في هذه السّنة

132
00:10:39,320 --> 00:10:44,770
.أنت تدرس هنا لستّة أشهر الآن
كيف وجدت الوضع يا ماكي-سان؟

133
00:10:44,770 --> 00:10:47,700
!صحيح. إنّ الدّراسة هنا رائعة

134
00:10:48,410 --> 00:10:52,290
...الفصول والرّكوب والأمور الأخرى الّتي اختبرتها

135
00:10:52,520 --> 00:10:55,500
!بدأت أشعر أنّني فارس سباقات بالفعل

136
00:10:56,520 --> 00:10:58,340
.وسأواصل العمل بجدّ

137
00:10:58,650 --> 00:11:00,090
!شكرًا لك

138
00:11:00,630 --> 00:11:02,160
.وأنت يا كيوريكي-سان

139
00:11:02,160 --> 00:11:06,640
!نـ-نعم. بدأت أشعر أنّني فارس سباقات أيضًا

140
00:11:06,980 --> 00:11:10,920
في البداية، دخلت في شجارات كثيرًا
.مع زملائي لأتفه الأسباب

141
00:11:11,350 --> 00:11:14,920
!لكنّنا نريد أن نصير فرسان سباقات معًا

142
00:11:15,650 --> 00:11:21,700
!نضجتُ الآن وأنا في طريقي نحو تحقيق حلمي

143
00:11:22,540 --> 00:11:23,700
!وسأبذل قصارى جهدي

144
00:11:24,700 --> 00:11:28,040
.شكرًا لك. وأنت يا ساكورابا-سان

145
00:11:28,580 --> 00:11:30,590
...نعم

146
00:11:31,370 --> 00:11:34,840
.أنا مشوّش بعض الشّيء اليوم

147
00:11:35,390 --> 00:11:38,960
.ترك أحد زملائي المدرسة قبل أيّام

148
00:11:39,590 --> 00:11:41,760
،عمل بجدّ أكثر من أيّ أحد فينا

149
00:11:41,760 --> 00:11:44,640
وأنا حزين لأنّني لن أتمكّن
.من التّدرّب معه بعد الآن

150
00:11:45,380 --> 00:11:50,460
ولكن في نفس الوقت، علّمني ذلك
.كم أنّ هذا المجال صعب

151
00:11:51,160 --> 00:11:53,980
!أريد أن أصير فارس سباقات يحوز على احترامه

152
00:11:55,050 --> 00:11:57,010
.يا له من هدف رائع

153
00:11:57,010 --> 00:11:59,530
!ستكونون جميعًا منافسين لبعضكم في المستقبل

154
00:11:59,530 --> 00:12:00,850
!هذا صحيح

155
00:12:00,850 --> 00:12:03,550
،لذلك بما أنّنا ما زلنا في المدرسة الآن

156
00:12:03,550 --> 00:12:08,450
نريد أن نكون أصدقاء نعمل
!لتحقيق نفس الحلم معًا

157
00:12:10,170 --> 00:12:11,370
.بالطّبع

158
00:12:12,420 --> 00:12:13,870
...والآن

159
00:12:16,380 --> 00:12:18,740
.لم أكن أعلم بوجود هذا الطّريق هنا

160
00:12:18,740 --> 00:12:20,850
.وجدته في أوّل يوم لي في المدرسة

161
00:12:20,850 --> 00:12:22,050
.استدر يمينًا

162
00:12:38,190 --> 00:12:39,730
.أنا بخير الآن

163
00:12:50,190 --> 00:12:51,050
ما الخطب؟

164
00:12:52,590 --> 00:12:54,920
!لا شيء، فلا تهتمّ

165
00:12:54,920 --> 00:12:56,170
!سأزيد سرعتي

166
00:13:00,170 --> 00:13:03,260
.استعدّوا لعرض القفز يا تلاميذ السّنة الأولى

167
00:13:03,260 --> 00:13:04,210
!حالاً

168
00:13:08,510 --> 00:13:10,430
أنت هو كازانامي-كُن؟

169
00:13:10,430 --> 00:13:12,450
.ما...؟ نعم

170
00:13:14,060 --> 00:13:15,090
!أريمورا

171
00:13:16,690 --> 00:13:17,810
!لا تستسلم

172
00:13:17,810 --> 00:13:22,190
!أريد رؤيتك تصير أفضل فارس سباقات

173
00:13:31,000 --> 00:13:34,500
أخبرني يو أنّك كنت تعمل بجدّ
.لمساعدته على العودة

174
00:13:34,750 --> 00:13:35,970
.لم أفعل أيّ شيء

175
00:13:36,430 --> 00:13:37,890
.يو هو من عمل بجدّ

176
00:13:39,550 --> 00:13:41,060
.لذلك سيكون بخير

177
00:13:41,380 --> 00:13:42,620
!ضعا ثقتكما في يو

178
00:13:47,320 --> 00:13:48,510
.سمعتَ ما قاله

179
00:13:48,510 --> 00:13:50,940
.نعم. لنضع ثقتنا به

180
00:13:57,450 --> 00:13:58,570
!رايس كيت

181
00:14:01,560 --> 00:14:02,520
!ها قد عدت

182
00:14:06,070 --> 00:14:07,530
!لنقم بهذا

183
00:14:08,210 --> 00:14:09,060
...أيّها المدير

184
00:14:09,780 --> 00:14:11,320
...أريمورا يو

185
00:14:11,320 --> 00:14:14,130
.نعم. سيشارك في تمارين القفز

186
00:14:24,670 --> 00:14:26,190
!إنّه يو

187
00:14:26,190 --> 00:14:27,240
!يو هنا

188
00:14:36,180 --> 00:14:37,410
.أريمورا يو

189
00:14:37,410 --> 00:14:38,440
!أريمورا-كُن

190
00:14:39,880 --> 00:14:41,440
!سرّتني رؤيتكم يا رفاق

191
00:14:41,800 --> 00:14:43,320
...يا إلهي

192
00:14:43,320 --> 00:14:45,230
!أخفتنا كثيرًا

193
00:14:45,230 --> 00:14:47,690
متأخّر لجلب الانتباه لك، صحيح؟

194
00:14:48,110 --> 00:14:49,700
.شون، ها قد عدت

195
00:14:50,910 --> 00:14:53,070
رايس كيت هو الأفضل، صحيح؟

196
00:14:53,780 --> 00:14:54,550
!نعم

197
00:14:56,050 --> 00:14:58,330
!حسنًا جميعًا

198
00:14:58,690 --> 00:15:00,830
!إنّه وقت العرض

199
00:15:01,460 --> 00:15:05,090
!هل أنتم جاهزون؟ حسنًا

200
00:15:05,090 --> 00:15:07,070
!أجل

201
00:15:18,360 --> 00:15:19,310
أبي؟

202
00:15:19,670 --> 00:15:21,350
ألن تشاهدهم؟

203
00:15:23,380 --> 00:15:26,360
ماذا عنك؟ ألا يجدر بالمرشد أن يشاهد العرض؟

204
00:15:26,610 --> 00:15:28,270
.المرشد أساهي هناك

205
00:15:28,780 --> 00:15:31,610
.لديّ أمر أهمّ للاهتمام به

206
00:15:35,060 --> 00:15:39,420
شكرًا لسماحك لي بالبقاء
.في المدرسة لبعض الوقت يا أبي

207
00:15:39,420 --> 00:15:40,680
.لا مشكلة في ذلك

208
00:15:40,680 --> 00:15:42,670
.أنت تلميذ هنا حتّى نهاية اليوم

209
00:15:45,430 --> 00:15:49,380
.أبليت حسنًا يا هاياتو. لقد تخرّجت

210
00:15:57,450 --> 00:16:03,400
سيقدّم تلاميذ السّنة الأولى الآن عرض
.القفز خاصّتهم واختبار طريقة ركوب القرد

211
00:16:15,810 --> 00:16:17,090
.حظًّا سعيدًا

212
00:16:17,910 --> 00:16:19,410
.أحدثت فوضى عارمة

213
00:16:21,220 --> 00:16:22,620
...الرّئيسة

214
00:16:22,860 --> 00:16:25,620
،أحضرتِ مستر دكتور إلى هنا في يوم السّباق

215
00:16:25,620 --> 00:16:27,130
.ووسائل الإعلام أيضًا ليشاهد الجميع

216
00:16:27,130 --> 00:16:29,550
،إن عاد يو وكلّ الكاميرات تصوّره

217
00:16:29,550 --> 00:16:31,620
،فستهتف له اليابان بأسرها

218
00:16:31,620 --> 00:16:33,510
.ولن يكون لديّ خيار سوى قبول الأمر

219
00:16:37,010 --> 00:16:38,590
.تفكير ماكر

220
00:16:38,990 --> 00:16:42,770
.رأيت كيف تديرين الأمور عن قرب

221
00:16:46,870 --> 00:16:48,860
متى بدأ التّدريب؟

222
00:16:48,860 --> 00:16:51,280
.قبل شهر

223
00:16:52,920 --> 00:16:56,360
استعار غرفة العلاج الطّبيعيّ
.في المستشفى في منتصف اللّيل

224
00:16:57,280 --> 00:16:59,860
هل كوسي وماساكي يعلمان؟

225
00:16:59,860 --> 00:17:01,890
.لا تلوميهما

226
00:17:01,890 --> 00:17:03,870
.توسّلتهما للمساعدة

227
00:17:11,380 --> 00:17:13,370
!يو، أنت لها

228
00:17:13,370 --> 00:17:15,130
!يمكنك النّجاح

229
00:17:18,120 --> 00:17:21,560
رايس كيت. بإمكانك النّجاح، صحيح؟

230
00:17:23,660 --> 00:17:24,640
!حسنًا

231
00:17:24,640 --> 00:17:26,600
!أريمورا، انطلق

232
00:17:43,660 --> 00:17:45,380
!لا! لم يقترب بما يكفي

233
00:17:45,380 --> 00:17:46,450
!أريمورا-كُن

234
00:18:01,470 --> 00:18:02,770
.إنّه مذعور

235
00:18:02,770 --> 00:18:04,220
هل سيكون بخير؟

236
00:18:04,220 --> 00:18:05,980
...يا إلهي

237
00:18:08,920 --> 00:18:12,270
لن تسمح لهذه أن تكون النّهاية، صحيح يا يو؟

238
00:18:14,780 --> 00:18:17,490
!لا، بالطّبع لا

239
00:18:17,490 --> 00:18:19,540
أريمورا، أجاهز لهذا؟

240
00:18:19,870 --> 00:18:21,950
!نعم! أنا بخير

241
00:18:26,760 --> 00:18:27,910
.أنا بخير

242
00:18:46,940 --> 00:18:47,860
!أجل

243
00:18:52,480 --> 00:18:53,580
!فعلها

244
00:18:53,580 --> 00:18:55,480
!مذهل يا أريمورا-كُن

245
00:19:10,790 --> 00:19:11,720
...يو

246
00:19:21,500 --> 00:19:23,000
.كان ذلك رائعًا يا يو

247
00:19:23,000 --> 00:19:24,060
!شكرًا

248
00:19:24,060 --> 00:19:25,580
!كنتَ رائعًا

249
00:19:25,580 --> 00:19:27,820
!ما كنت لأظنّ أبدًا أنّك أُصبت

250
00:19:29,050 --> 00:19:31,590
ماذا؟ هل أصبتَ بالفعل؟

251
00:19:31,590 --> 00:19:34,700
أكانت هذه مجرّد خدعة كبيرة؟

252
00:19:35,610 --> 00:19:37,870
ألا يمكنكم القول أنّكم منبهرون فحسب؟

253
00:19:39,350 --> 00:19:41,190
!شكرًا لكم جميعًا

254
00:19:45,180 --> 00:19:50,250
بهذا ينتهي عرض طريقة ركوب
.القرد لتلاميذ السّنة الأولى

255
00:19:50,660 --> 00:19:52,590
!شكرًا جزيلاً

256
00:19:58,340 --> 00:19:59,260
...الرّئيسة

257
00:20:13,260 --> 00:20:14,020
...عفوًا

258
00:20:14,020 --> 00:20:14,900
.أنت مطرود

259
00:20:18,120 --> 00:20:20,650
.رفضتَ القيام بما أخبرتك لك

260
00:20:21,210 --> 00:20:24,870
لم تعد الآن جزءًا من مستر دكتور
.بشكل دائم وليس مؤقّتًا فحسب

261
00:20:28,220 --> 00:20:31,660
من الأفضل أن تجني المال كفارس سباقات
.لتدفع الشّرط الجزائيّ في العقد

262
00:20:35,170 --> 00:20:36,180
...أيّتها الرّئيسة

263
00:20:36,180 --> 00:20:39,420
!سأصير فارس سباقات لن ينساه أحد أبدًا

264
00:21:10,180 --> 00:21:12,830
!يو! المرشد ينادي

265
00:21:13,060 --> 00:21:14,870
!حسنًا! أنا قادم

266
00:23:27,020 --> 00:23:29,450
كازانامي-كُن، كيف حال كيسكي؟

267
00:23:33,110 --> 00:23:34,490
.الحصان في حالة جيّدة

268
00:23:37,990 --> 00:23:39,240
.سومراغي-سينسي