1
00:01:33,790 --> 00:01:35,870
.ذلك ليس صحيحًا

2
00:01:35,870 --> 00:01:39,030
.غضب عليّ ساكورابا-سينسي البارحة فحسب

3
00:01:39,030 --> 00:01:41,150
!تحسّنت كثيرًا

4
00:01:41,150 --> 00:01:42,920
!لا أطيق الانتظار حتّى سباقك الأوّل

5
00:01:42,920 --> 00:01:44,810
.أتمنّى أن تكونوا على حقّ

6
00:01:44,810 --> 00:01:47,940
!سأبذل جهدي لأكون فارسة ممتازة

7
00:01:51,400 --> 00:01:53,670
.صرت أفضل بكثير في التّعامل مع الإعلام

8
00:01:53,670 --> 00:01:55,800
.لا أدري إن كان عليك وصف الأمر كذلك

9
00:01:55,800 --> 00:01:58,490
لكن إن صدرت الكثير من المقالات
،عنّي وصرتُ حديث النّاس

10
00:01:58,490 --> 00:02:01,050
!فقد أستطيع ركوب حصان جيّد

11
00:02:02,510 --> 00:02:03,900
كيف حال كازانامي-كُن؟

12
00:02:06,390 --> 00:02:10,190
ما حدث مع أوك نيتشر أثّر فيه كثيرًا، صحيح؟

13
00:02:12,120 --> 00:02:15,390
،من الصّعب معرفة ما بفكّر به

14
00:02:16,490 --> 00:02:18,060
.لذلك لا فكرة لديّ

15
00:02:23,450 --> 00:02:24,460
.شكرًا لك

16
00:02:28,230 --> 00:02:29,380
.آسف بشأن ما حدث

17
00:02:29,820 --> 00:02:31,710
.كان كيسكي حصانًا جيّدًا

18
00:02:32,910 --> 00:02:36,880
.موت الخيول جزء من هذا العمل

19
00:02:37,470 --> 00:02:40,100
.نعاني جميعًا بشدّة بطُرقنا الخاصّة

20
00:02:40,490 --> 00:02:42,760
.لا يختفي الألم أبدًا

21
00:02:43,020 --> 00:02:46,410
...سيتجاوز كازانامي-كُن هذا يومًا ما

22
00:02:47,390 --> 00:02:50,310
.لكن ربّما كان مقرّبًا كثيرًا من الخيول

23
00:02:53,050 --> 00:02:54,690
مزارع هيراتو؟

24
00:02:55,010 --> 00:02:56,460
ذهب شون إلى هناك؟

25
00:02:56,460 --> 00:02:59,810
.إنّها مزرعة كبيرة في شيزوناي في هوكّايدو

26
00:03:00,180 --> 00:03:04,410
أخبرتني زوجة المالك أنّه وصل
.إلى هناك قبل يومين أو ثلاثة

27
00:03:05,310 --> 00:03:07,220
.وُلد كيسكي هناك

28
00:03:07,560 --> 00:03:10,990
.كان يفترض إرساله إلى هناك بعد تقاعده

29
00:03:11,800 --> 00:03:12,740
هذا هو السّبب؟

30
00:03:14,210 --> 00:03:15,800
،لا أريد إعطاء الأمر أكثر من حجمه

31
00:03:15,800 --> 00:03:17,860
.لذلك سأعتبر الأمر كعطلة حاليًّا

32
00:03:18,550 --> 00:03:22,720
ولكن سيتوجّب عليكّ الاتّصال بمدرسة
.سابقات الخيول إن لم يعد قريبًا

33
00:03:28,030 --> 00:03:30,030
.إنّه بعيد جدًّا

34
00:03:30,030 --> 00:03:32,690
.لا تعني المسافات شيئًا لكازانامي شون

35
00:03:32,990 --> 00:03:34,690
.أعتقد أنّني سأذهب

36
00:03:34,950 --> 00:03:35,820
فعلاً؟

37
00:03:34,950 --> 00:03:35,820
ماذا؟

38
00:03:35,820 --> 00:03:36,690
لماذا؟

39
00:03:36,690 --> 00:03:38,390
.سأقابله وأتحدّث معه مباشرة

40
00:03:38,390 --> 00:03:39,720
.انس الأمر

41
00:03:40,620 --> 00:03:41,890
لماذا؟

42
00:03:42,690 --> 00:03:44,610
.لقد هرب

43
00:03:44,610 --> 00:03:47,470
.مطاردة شخص ما هرب ليست مسؤوليّتك

44
00:03:51,320 --> 00:03:53,790
!شون ليس من النّوع الّذي يهرب

45
00:03:53,790 --> 00:03:55,530
!لا بدّ من سبب وجيه

46
00:03:55,530 --> 00:03:57,630
!ومن يهتمّ لوجود سبب

47
00:03:57,630 --> 00:03:59,790
!إنّ شخصًا مثله لا يجب اعتباره فارسًا

48
00:03:59,790 --> 00:04:02,220
أم أنّك ستتخلّى عن عملك أيضًا؟

49
00:04:02,220 --> 00:04:04,260
.أريمورا يو، اذهب

50
00:04:05,190 --> 00:04:07,510
.ستندم على هذا للأبد إن لم تذهب الآن

51
00:04:09,270 --> 00:04:12,430
.سنتولّى أمر واجباتك في الإسطبل

52
00:04:12,430 --> 00:04:13,980
...صـ-صحيح

53
00:04:13,980 --> 00:04:17,310
.سأشعر بالسّوء إن تركنا كازانامي

54
00:04:17,310 --> 00:04:18,270
!تبًّا

55
00:04:18,810 --> 00:04:21,320
!لا شيء أسوأ من زملاء الفصل

56
00:04:42,380 --> 00:04:45,470
...سيتجاوز كازانامي-كُن هذا يومًا ما

57
00:04:46,140 --> 00:04:49,080
.لكن ربّما كان مقرّبًا كثيرًا من الخيول

58
00:05:01,480 --> 00:05:02,990
...هذا هو المكان إذًا

59
00:05:04,270 --> 00:05:05,630
!مرحبًا

60
00:05:15,390 --> 00:05:16,290
!شون

61
00:05:17,970 --> 00:05:20,120
...ماذا؟ يو

62
00:05:20,120 --> 00:05:21,570
ماذا تفعل هنا؟

63
00:05:23,050 --> 00:05:27,680
!مرحبًا. ثمّة الكثير من الخيول هنا
!أنا مستمتع

64
00:05:27,680 --> 00:05:29,170
عمّ تتكلّم؟

65
00:05:29,530 --> 00:05:31,370
!الجميع قلقون بشأنك

66
00:05:32,110 --> 00:05:35,030
...لكنّك تقف هنا والبسمة تعلو وجهك

67
00:05:37,260 --> 00:05:38,660
...اهدئي يا مومو

68
00:05:39,380 --> 00:05:41,360
.لا تصرخ

69
00:05:41,360 --> 00:05:42,400
.أنت تخيفها

70
00:05:42,750 --> 00:05:44,060
!...اسمع

71
00:05:46,600 --> 00:05:47,900
ماذا؟

72
00:05:51,490 --> 00:05:52,910
.هذا يكفي

73
00:05:52,910 --> 00:05:55,160
.لا شجار أمام الخيول

74
00:06:01,920 --> 00:06:04,430
.آسفة لأنّي عاملتك بخشونة

75
00:06:04,430 --> 00:06:06,880
.لا عليك، أنا من عليه الاعتذار

76
00:06:06,880 --> 00:06:09,390
.قطعتَ مسافة طويلة

77
00:06:09,390 --> 00:06:14,060
.سمعتُ أنّ شون... أقصد كازانامي مقيم هنا

78
00:06:14,060 --> 00:06:19,490
هذا صحيح. أصيب أحد عمّالنا
.لذلك لم يكن لدينا بديل له

79
00:06:19,490 --> 00:06:20,920
.لقد ساعدنا كثيرًا

80
00:06:20,920 --> 00:06:23,790
أتعلم أنّه وُلدت عندما ثلاثة مهور، صحيح؟

81
00:06:23,790 --> 00:06:26,030
،كنّا جميعنا نعمل بكلّ جهدنا

82
00:06:26,400 --> 00:06:30,430
!رغم أنّنا نربيّها فحسب في العادة

83
00:06:34,170 --> 00:06:36,130
.لم أتوقّع أن تأتي يا يو

84
00:06:37,350 --> 00:06:39,140
أنت مشغول بالتّدريب، صحيح؟

85
00:06:39,660 --> 00:06:41,670
أنت مشغول أيضًا، صحيح؟

86
00:06:42,150 --> 00:06:44,380
سيدخل كيرارين لسباق ساتسكي شو قريبًا، صحيح؟

87
00:06:45,780 --> 00:06:47,140
...نعم، ولكن

88
00:06:51,130 --> 00:06:52,420
.يحتاج السّياج للإصلاح

89
00:06:52,420 --> 00:06:54,110
!هذا صحيح

90
00:06:54,110 --> 00:06:54,760
!سأذهب في الحال

91
00:06:55,850 --> 00:06:57,680
.مـ-مرحبًا

92
00:07:00,770 --> 00:07:01,940
.استمتع بإقامتك

93
00:07:05,540 --> 00:07:08,190
.لن أعود

94
00:07:09,950 --> 00:07:13,560
...ترك الباب مفتوحًا ثانية

95
00:07:13,560 --> 00:07:16,290
.آسفة. زوجي غير ودود بعض الشّيء

96
00:07:18,450 --> 00:07:21,430
.فهمت. تقابلتما. هذا جيّد

97
00:07:22,840 --> 00:07:26,620
.يا إلهي... إنّه يجعل سومراغي-سينسي تقلق

98
00:07:26,620 --> 00:07:27,670
لن يعود؟

99
00:07:28,300 --> 00:07:30,420
.نعم، هذا ما قاله

100
00:07:30,810 --> 00:07:33,470
.لكنّني سأعيده في كلّ الأحوال

101
00:07:33,480 --> 00:07:34,540
.فهمت

102
00:07:35,950 --> 00:07:38,720
.أريمورا-كُن، هنالك أمر أريد منك القيام به

103
00:07:45,690 --> 00:07:46,790
معطّل؟

104
00:07:47,250 --> 00:07:51,340
آسف يا شون، ولكن هل تستطيع
الاحتياطيّ من المنزل؟

105
00:07:51,340 --> 00:07:52,110
.حاضر

106
00:07:52,810 --> 00:07:54,490
.تفضّل، استعمل هذا

107
00:07:57,380 --> 00:07:59,380
لماذا هو بحوزتك؟

108
00:07:59,380 --> 00:08:02,790
.أخبرتني سونوكو-سان أن أحضره

109
00:08:03,720 --> 00:08:05,700
.لا تضغط عليه كثيرًا

110
00:08:05,700 --> 00:08:12,150
ابق قريبًا منه فحسب إلى أن سوّي
.أموره بنفسه، بقدر استطاعتك

111
00:08:13,190 --> 00:08:16,890
.ماساو-سان، دعني أساعد مع شون رجاءً

112
00:08:19,410 --> 00:08:20,600
.إن كان هذا ما تريد

113
00:08:23,310 --> 00:08:25,060
.حسنًا

114
00:08:26,670 --> 00:08:28,350
.لم أتوقّع أنّ العمل سيكون صعبًا هكذا

115
00:08:28,350 --> 00:08:29,230
.نعم

116
00:08:29,960 --> 00:08:33,410
.سأظلّ هنا لفترة، لذلك علّمني ماذا أفعل

117
00:08:34,280 --> 00:08:37,120
علينا الآن المساعدة في شراء العلف، صحيح؟

118
00:08:37,120 --> 00:08:38,620
.حسنًا، لنذهب

119
00:08:38,620 --> 00:08:40,760
!مهلاً

120
00:08:58,100 --> 00:09:00,540
كانت مومو جائعة إذًا؟

121
00:09:01,090 --> 00:09:02,990
أهي واحدة من المواليد الجدد في هذا الشّتاء؟

122
00:09:02,990 --> 00:09:05,100
.نعم، إنّه تتصرّف بصبيانيّة

123
00:09:05,100 --> 00:09:06,230
.هذه طبيعتك

124
00:09:06,820 --> 00:09:09,860
.يمكنك معرفة حتّى ما تفكّر به المهرة

125
00:09:11,500 --> 00:09:15,770
.كلاّ، لا أستطيع سماع أصواتها الآن

126
00:09:18,370 --> 00:09:21,560
.يو، راقب مومو قليلاً

127
00:09:21,560 --> 00:09:24,360
.سأحضر البقيّة من المرعى

128
00:09:24,360 --> 00:09:25,170
!مهلاً

129
00:09:29,370 --> 00:09:31,550
عندما وصل شون-كُن إلى هنا؟

130
00:09:31,780 --> 00:09:33,450
كيف كانت حالته؟

131
00:09:34,180 --> 00:09:38,050
.كان متّسخًا ومبلّلاً بالكامل عندما رأيناه

132
00:09:39,230 --> 00:09:42,550
.قال أنّه أتى لرؤية كيسكي

133
00:09:42,550 --> 00:09:43,850
كيسكي؟

134
00:09:43,850 --> 00:09:45,690
ثمّ أدرك زوجي

135
00:09:45,690 --> 00:09:49,750
أنّه كان الفتى الّتي كان يسوس
.كيسكي في هانشين دايشوتن

136
00:09:50,410 --> 00:09:54,730
ظنّ أنّه ربّما كان يريد رؤية المكان الّذي
.كان يفترض أن يعود إليه كيسكي

137
00:09:57,940 --> 00:09:59,780
!شكرًا على الطّعام

138
00:09:59,780 --> 00:10:04,160
ما رأيك يا يو-كُن؟ أنا مهرة في الطّبخ، صحيح؟

139
00:10:04,160 --> 00:10:05,870
استعملت مهرة بدل ماهرة، فهمت؟

140
00:10:05,870 --> 00:10:09,950
!نعم، شعرت بالدّفء بعد تناوله

141
00:10:09,950 --> 00:10:12,520
!طبخ سونوكو-سان لذيذ جدًّا

142
00:10:13,510 --> 00:10:14,820
.أعلم، أعلم

143
00:10:14,820 --> 00:10:17,250
!اعمل بجدّ، ثمّ كل قدر ما تريد

144
00:10:17,250 --> 00:10:18,760
!هذا هو سرّ الصّحّة الجيّدة

145
00:10:19,710 --> 00:10:22,590
.ساعد يو كثيرًا اليوم

146
00:10:22,590 --> 00:10:26,560
نعم، لم تتسنّ لي فرصة رؤية
.الكثير من المهور من قبل

147
00:10:26,560 --> 00:10:29,730
ستصير خيول سباقات يومًا ما، صحيح؟

148
00:10:29,730 --> 00:10:30,530
.نعم

149
00:10:30,530 --> 00:10:33,590
.ستكون جاهزة لتتسابق بعد سنتين

150
00:10:33,590 --> 00:10:35,980
.آمل أن أستطيع امتطاء مومو يومًا ما

151
00:10:35,980 --> 00:10:39,260
إنّها مهرة واعدة! لا أطيق الانتظار
.لرؤية ما يخبّئه القدر لها

152
00:10:39,260 --> 00:10:41,240
.اجنِ الكثير من المال برفقتها

153
00:10:42,390 --> 00:10:43,370
.سأبذل جهدي

154
00:10:43,370 --> 00:10:46,870
.لا بدّ أنّ كيسكي كان مثلها

155
00:10:51,380 --> 00:10:57,110
.وُلد كيسكي هنا. وخاض سباقات عدّة

156
00:10:59,410 --> 00:11:01,340
...لو كان ما زال حيًّا

157
00:11:02,540 --> 00:11:06,830
كان ليقضي الكثير من الوقت
في العَدْو هنا في المزرعة، صحيح؟

158
00:11:07,690 --> 00:11:08,680
.شون

159
00:11:10,620 --> 00:11:13,400
...شون، إنّ كيسكي

160
00:11:15,180 --> 00:11:17,710
،المزارع مكان تولد فيه الخيول

161
00:11:17,710 --> 00:11:19,150
.ولا تتقاعد فيه

162
00:11:20,900 --> 00:11:24,150
.كان مالك كيسكي لطيفًا بإرساله إلى هنا

163
00:11:24,490 --> 00:11:27,580
.لكنّ ذلك ليس ما يحدث في العادة

164
00:11:30,650 --> 00:11:31,850
.أنا آسف

165
00:11:33,330 --> 00:11:35,250
مهلاً، ما الخطب؟

166
00:11:35,250 --> 00:11:36,870
!المعذرة يا شون-كُن

167
00:11:36,870 --> 00:11:39,930
.الحمّام جاهز لكما. هيّا أسرعا

168
00:11:55,630 --> 00:11:56,500
...عفوًا

169
00:11:57,110 --> 00:11:58,340
...بشأن ما حدث

170
00:11:59,740 --> 00:12:03,490
.لقد كان يهتمّ كثيرًا لأمر كيسكي

171
00:12:03,960 --> 00:12:08,730
...لم يستطع تجاوز حقيقة موته
.لهذا السّبب أتى إلى هنا

172
00:12:09,660 --> 00:12:13,700
قال شون أنّه ما عاد يستطيع
.سماع أصوات الخيول

173
00:12:14,060 --> 00:12:18,040
،ظننتُ أنّه إن استطاع سماعها ثانية
.فسيتمكّن من العودة

174
00:12:18,540 --> 00:12:22,260
!وسيتمكّن من ركوب الخيول ثانية

175
00:12:30,750 --> 00:12:33,580
.لا أعرف ما الّذي تفكّر به الخيول

176
00:12:34,020 --> 00:12:37,430
،لكن إن كان يستطيع فعلاً التّواصل مع قلوبها

177
00:12:38,990 --> 00:12:42,400
.أستطيع جعله يلتقي بكيسكي ثانية

178
00:13:03,110 --> 00:13:07,050
!نسيم الصّباح لذيذ جدًّا

179
00:13:07,050 --> 00:13:08,510
!كما في الجزيرة

180
00:13:21,590 --> 00:13:23,090
.صباح الخير

181
00:13:23,400 --> 00:13:26,340
...لم يحن موعد دورة مشي مومو

182
00:13:26,340 --> 00:13:29,570
وما الّذي يفعله يو وسونوكو-سان هنا؟

183
00:13:29,570 --> 00:13:33,830
اقطع بعض العشب الّذي قرب
.قدمك وأحضره إلى أنف مومو

184
00:13:34,870 --> 00:13:36,770
...حسنًا

185
00:13:59,000 --> 00:14:00,210
...كيسكي

186
00:14:00,810 --> 00:14:03,570
.إنّها تقوم بهذا بعد تناولها للإفطار عادة

187
00:14:05,160 --> 00:14:07,030
.تمامًا مثل أخيها

188
00:14:08,330 --> 00:14:10,600
.لمومو وكيسكي نفس الأب

189
00:14:11,160 --> 00:14:13,560
.إنّهما شقيقان

190
00:14:15,050 --> 00:14:16,230
...أخت كيسكي

191
00:14:17,830 --> 00:14:19,060
الصّغيرة؟

192
00:14:32,500 --> 00:14:35,180
!كيسكي... حيّ

193
00:14:36,860 --> 00:14:39,080
!ما زالت سلالة كيسكي مستمرّة

194
00:14:40,770 --> 00:14:47,530
!لكن لهذا السّبب أعرف... أن كيسكي رحل

195
00:14:47,530 --> 00:14:48,830
...شون

196
00:14:49,550 --> 00:14:50,680
.أعلم

197
00:14:50,990 --> 00:14:53,870
.لم يكن ما حدث مع كيسكي غلطتي

198
00:14:53,870 --> 00:14:55,480
.إنّه جزء من عملنا

199
00:14:56,430 --> 00:14:57,590
.أنا محترف

200
00:14:58,070 --> 00:14:59,500
.عليّ تقبّل الأمر

201
00:15:01,230 --> 00:15:02,000
...ولكن

202
00:15:03,670 --> 00:15:04,680
...لا أستطيع

203
00:15:05,240 --> 00:15:06,500
.أنا أتألّم في كلّ الأحوال

204
00:15:09,110 --> 00:15:12,610
...سأشهد على موت الكثير من الخيول

205
00:15:14,590 --> 00:15:17,480
وأعلم أنّ ذلك... أعلم أنّه سيؤلمني

206
00:15:18,900 --> 00:15:22,120
.ولن يسعني فعل شيء

207
00:15:23,620 --> 00:15:25,070
.لا بأس إن آلمك ذلك

208
00:15:28,070 --> 00:15:29,990
.ليس عليك أن تعتاد على الأمر

209
00:15:31,180 --> 00:15:32,700
.لا عيب في الشّعور بالحزن

210
00:15:34,410 --> 00:15:36,990
!لكن ليس عليك الاستسلام

211
00:15:38,830 --> 00:15:41,820
،لا أعرف ما هو الصّواب

212
00:15:42,450 --> 00:15:46,550
،لكنّني قرّرت أنّني سأعيش في هذا العالم

213
00:15:47,570 --> 00:15:48,840
!لذلك عليّ المواصلة للأمام

214
00:15:50,700 --> 00:15:53,820
ماذا عليّ أن أفعل؟

215
00:15:54,810 --> 00:15:56,950
.هذا قرارك أنت وحدك

216
00:15:57,720 --> 00:15:58,630
...لكن

217
00:15:59,220 --> 00:16:00,490
...أنت تحبّ التّسابق

218
00:16:02,500 --> 00:16:04,440
تحبّ الخيول، صحيح؟

219
00:16:31,170 --> 00:16:32,360
...كيسكي

220
00:16:36,040 --> 00:16:38,810
!كيسكي

221
00:16:52,390 --> 00:16:53,670
...شكرًا لك

222
00:16:58,890 --> 00:16:59,790
.شون

223
00:17:02,040 --> 00:17:02,760
.يو

224
00:17:04,050 --> 00:17:05,020
.لنعد

225
00:17:14,770 --> 00:17:15,770
أنت بخير الآن، صحيح؟

226
00:17:17,390 --> 00:17:18,210
.نعم

227
00:17:20,460 --> 00:17:22,450
.سنفتقدك

228
00:17:23,350 --> 00:17:25,270
عندما يعودان، آمل أن يمسكا
...بلجام الأمور جيّدًا

229
00:17:27,230 --> 00:17:30,280
لجام بدل زمام، أفهمت...؟

230
00:17:31,870 --> 00:17:34,120
!مزحة خيول

231
00:17:38,460 --> 00:17:42,070
.عشب شهر ماي جميل وخضرته نضرة

232
00:17:42,070 --> 00:17:44,800
،اليوم، وخلال هذه الدّقيقتين والنّصف القادمة

233
00:17:44,800 --> 00:17:48,010
.سنشهد أنا وأنتم على شيء مميّز معًا

234
00:17:48,500 --> 00:17:51,170
!لقد آن أوان ديربي اليابان

235
00:17:51,780 --> 00:17:54,510
!كلّ العيون تنظر لأوك دايموند

236
00:17:54,510 --> 00:17:58,270
هل يستطيع كوجي يوشيهيسا التّعويض
عن خسارة أوك دايموند العام الماضي؟

237
00:18:06,550 --> 00:18:09,500
!شكرًا على كلّ ما علّمتموني إيّاه

238
00:18:09,500 --> 00:18:13,630
أقول هذا كلّ عام، لكنّ فترات
.التّدريب هذه تنتهي بسرعة

239
00:18:13,630 --> 00:18:16,440
.أبليتَ حسنًا أثناء عملك مع عجوز مثلي

240
00:18:18,730 --> 00:18:21,200
!ما زال هنالك الكثير يمكنك تعليمي إيّاه

241
00:18:22,980 --> 00:18:25,200
.سأراك ثانية بعد ستّة أشهر

242
00:18:25,200 --> 00:18:26,580
!حظًّا سعيدًا

243
00:18:26,580 --> 00:18:29,210
!نعم، شكرًا لك

244
00:18:45,180 --> 00:18:47,820
.كوجي-سان، شكرًا على كلّ ما فعلته من أجلي

245
00:18:48,850 --> 00:18:50,560
.لم أفعل أيّ شيء من أجلك

246
00:18:50,910 --> 00:18:52,480
.أعد أنّني سأعود

247
00:18:52,710 --> 00:18:55,190
.لا تبدأ بالتّقاعس وأنت لم تتخرّج بعد

248
00:18:55,550 --> 00:18:58,240
.سأشاهد سباقك التّجريبيّ

249
00:18:59,910 --> 00:19:00,780
!شكرًا لك

250
00:19:04,580 --> 00:19:06,330
!شكرًا يا سيّدي

251
00:19:06,330 --> 00:19:08,880
.شكرًا لك على كلّ شيء

252
00:19:08,880 --> 00:19:13,080
!آمل أن تشاهدني أثناء رحلتي نحو الشّهرة

253
00:19:14,090 --> 00:19:16,700
!سأبذل جهدي في مدرسة سباقات الخيول

254
00:19:16,700 --> 00:19:18,580
!أتطلّع قدمًا للسّباق التّجريبيّ

255
00:19:23,230 --> 00:19:25,060
.تبدو وسيمًا اليوم

256
00:19:28,330 --> 00:19:31,140
شون، أليس عليك الذّهاب؟

257
00:19:31,140 --> 00:19:33,150
!هذا صحيح

258
00:19:33,900 --> 00:19:35,860
!حظًّا سعيدًا مع كيكّا شو

259
00:19:35,860 --> 00:19:39,140
!أعلم أنّ كيرارين سيكون بخير

260
00:19:39,140 --> 00:19:41,340
.مع السّلامة لك أيضًا يا كيكومي-سان

261
00:19:42,790 --> 00:19:44,110
.سمعتَ ما قال

262
00:19:45,610 --> 00:19:49,810
،سأذهب لمقابلة كاشينو هذا المساء
.لذلك تولّ زمام الأمور هنا

263
00:19:49,810 --> 00:19:51,240
.مفهوم

264
00:19:51,240 --> 00:19:53,380
!سومراغي-سينسي! تاياسو-سان

265
00:19:54,250 --> 00:19:57,660
!شكرًا على كلّ شيء في هذه السّنة الماضية

266
00:19:57,660 --> 00:19:59,930
.كانت سنة حافلة بالفعل

267
00:19:59,930 --> 00:20:02,630
.قمتَ بأشياء كثيرًا لم أرها في بياناتي من قبل

268
00:20:02,630 --> 00:20:05,760
.عفوًا... آسف بشأن المشاكل

269
00:20:05,760 --> 00:20:09,180
.لا، بل وفّرتَ لي الكثير من البيانات الجديدة

270
00:20:09,180 --> 00:20:10,390
.كازانامي-كُن

271
00:20:10,630 --> 00:20:11,430
.نعم

272
00:20:11,890 --> 00:20:17,460
لا أعتقد أنّ كلّ الأشياء
.الّتي تعلّمتَها هنا كانت جيّدة لك

273
00:20:19,900 --> 00:20:24,810
.حمّلتك مسؤوليّات صعبة، وأثقلت كاهلك كثيرًا

274
00:20:27,900 --> 00:20:29,050
.أنا آسفة

275
00:20:32,470 --> 00:20:33,960
!هذا ليس صحيحًا

276
00:20:35,020 --> 00:20:38,670
!قضيت وقتًا رائعًا في هذه الإسطبلات

277
00:20:39,550 --> 00:20:42,850
!قابلت وركبت الكثير من الخيول

278
00:20:43,230 --> 00:20:45,620
!أخذت كيرارين حتّى الدّيربي

279
00:20:46,680 --> 00:20:47,980
...وأيضًا

280
00:20:49,890 --> 00:20:51,410
!قابلت كيسكي أيضًا

281
00:20:56,940 --> 00:20:58,500
...إن كنتَ

282
00:21:11,670 --> 00:21:12,890
.كازانامي-كُن

283
00:21:12,890 --> 00:21:14,410
.ثمّة أمر آخر

284
00:21:15,310 --> 00:21:16,230
.نعم

285
00:21:17,340 --> 00:21:19,330
.انتهى وقت تدرّبك في إسطبلاتنا

286
00:21:22,180 --> 00:21:23,350
.أبليتَ بلاءً حسنًا

287
00:21:28,780 --> 00:21:30,440
!شكرًا لك

288
00:23:24,470 --> 00:23:25,920
.حان الوقت أخيرًا

289
00:23:25,920 --> 00:23:28,420
.نعم. هيّا بنا