1
00:01:49,250 --> 00:01:50,570
...رايس كيت

2
00:01:50,570 --> 00:01:51,540
يو؟

3
00:01:51,820 --> 00:01:53,380
!سأنادي بالطّبيب

4
00:01:53,380 --> 00:01:55,720
!يو! يو

5
00:02:14,070 --> 00:02:14,880
!سايونجي-سان

6
00:02:14,880 --> 00:02:15,700
!أيّتها الرّئيسة

7
00:02:15,700 --> 00:02:19,180
بلغنا أنّ أوتوناشي يو-سان
.تعرّض لحادث أثناء التّدريب

8
00:02:19,180 --> 00:02:20,420
كيف يمكنك وصف إصاباته؟

9
00:02:23,710 --> 00:02:26,190
كيف هي إصاباته؟

10
00:02:26,190 --> 00:02:29,000
.استيقظ للتّوّ

11
00:02:29,000 --> 00:02:31,140
.سرّني سماع ذلك

12
00:02:31,140 --> 00:02:32,570
...نوهيرا-سان

13
00:02:33,130 --> 00:02:35,630
.لا أريد رؤيتك هنا ثانية

14
00:02:36,430 --> 00:02:39,130
.سنحرص أن ينال يو أفضل عناية

15
00:02:39,540 --> 00:02:44,260
لا أحد من مجال سباقات الخيول
.مرحّب به في غرفته

16
00:02:44,520 --> 00:02:45,580
.مفهوم

17
00:02:46,060 --> 00:02:48,100
...عفوًا، آسف بشأن أريمورا

18
00:02:48,100 --> 00:02:49,140
.غادرا

19
00:03:03,450 --> 00:03:05,370
.يو، توقّف

20
00:03:05,370 --> 00:03:10,300
لكن لديّ امتحان طريقة القرد
.وتدريب القفز خلال شهر

21
00:03:11,340 --> 00:03:13,810
...عليّ أن أتحسّن قبل ذلك

22
00:03:15,080 --> 00:03:17,820
صحيح! هل رايس كيت بخير؟

23
00:03:17,820 --> 00:03:19,020
.إنّه بخير

24
00:03:19,020 --> 00:03:21,300
.لقد عاد للإسطبل وهو بأفضل حال

25
00:03:21,870 --> 00:03:22,980
...حمدًا على ذلك

26
00:03:23,640 --> 00:03:24,600
ماذا عن هاياتو؟

27
00:03:24,600 --> 00:03:28,020
.اقلق على نفسك وليس على الآخرين

28
00:03:29,010 --> 00:03:30,110
.أيّها الطّبيب

29
00:03:30,690 --> 00:03:34,190
...أريمورا-سان، بشأن إصاباتك

30
00:03:34,590 --> 00:03:39,650
إن ضغطت على عضلاتك الآن
.قبل أن تتعافى، فقد تتضرّر

31
00:03:39,650 --> 00:03:43,910
.من المهمّ أن تمنح نفسك الوقت للتّعافي

32
00:03:43,910 --> 00:03:45,190
الوقت؟

33
00:03:45,190 --> 00:03:46,370
هل تعني...؟

34
00:03:46,370 --> 00:03:49,250
.إنّ شهرًا ليس كافيًا

35
00:03:53,790 --> 00:03:59,010
فيل لنا أنّ أريمورا لم يعاني من أيّ أضرار
.خطيرة على مستوى عظامه أو أعضائه

36
00:03:59,010 --> 00:04:03,300
لكنّه يعاني من تمزّق عضليّ
.أضعف يده اليمنى

37
00:04:04,350 --> 00:04:06,470
.سيتوجّب عليه أن يرتاح لمدّة

38
00:04:06,470 --> 00:04:10,020
.لكنّ امتحاننا وتمارين القفز بعد شهر

39
00:04:10,020 --> 00:04:11,640
هل سيفيه الوقت؟

40
00:04:11,640 --> 00:04:12,890
أخبرنا أيّها المرشد؟

41
00:04:14,970 --> 00:04:18,020
.لن نغيّر جدول التّمارين

42
00:04:18,380 --> 00:04:20,150
...إن لم يتعافى في الوقت

43
00:04:20,150 --> 00:04:22,170
...سيكرّر السّنة

44
00:04:22,170 --> 00:04:23,950
سيتأخّر في الدّراسة؟

45
00:04:24,790 --> 00:04:26,070
.نعم

46
00:04:29,140 --> 00:04:30,790
ماذا عن هاياتو؟

47
00:04:30,790 --> 00:04:33,060
.لم يتأذّ هوشو كثيرًا

48
00:04:33,390 --> 00:04:36,630
.المرشد نوهيرا معه. لا داعي للقل

49
00:04:36,630 --> 00:04:41,840
عفوًا، هل صحيح أنّ المرشد نوهيرا هو والده؟

50
00:04:41,840 --> 00:04:43,100
.نعم

51
00:04:43,100 --> 00:04:46,600
.طلب هوشو ألاّ تعلموا بالأمر

52
00:04:46,980 --> 00:04:50,760
.أراد أن تعتبروه زميلاً تلميذًا كأيّ واحد منكم

53
00:04:50,760 --> 00:04:53,270
.ذلك يبدو من شيمه بالتّأكيد

54
00:04:53,270 --> 00:04:56,600
لكن ألا يجعل ذلك المرشد نوهيرا يبدو قاسيًا؟

55
00:04:56,600 --> 00:04:58,810
.هكذا هو الحال بالنّسبة لفرسان السّباقات

56
00:04:58,810 --> 00:05:02,580
من الصّعب معرفة كيفية التّصرّف
.حيال ابن في نفس المجال

57
00:05:06,820 --> 00:05:08,970
.إنّها غلطتي بالكامل

58
00:05:09,330 --> 00:05:10,970
.لا تلم نفسك

59
00:05:11,350 --> 00:05:12,830
.كانت حادثة

60
00:05:13,230 --> 00:05:16,460
...لكن إن لم أفقد السّيطرة

61
00:05:17,070 --> 00:05:19,590
...لو لم أحبر نفسي على فقدان الوزن

62
00:05:19,870 --> 00:05:22,110
...لو أنّي اتّخذت قراري باكرًا

63
00:05:23,590 --> 00:05:26,550
...إن لم يعد أريمورا

64
00:05:27,140 --> 00:05:29,970
.حاليًّا، فكّر بنفسك

65
00:05:32,140 --> 00:05:33,670
.وما يمكنك فعله الآن

66
00:05:38,450 --> 00:05:41,440
أتظنّون أنّ الأمر سيكون صعبًا على أريمورا-كُن؟

67
00:05:41,930 --> 00:05:45,740
،إنّه صعب بدون امتلاك قبضة محكمة
.فذلك هو جوهر طريقة ركوب القرد

68
00:05:45,740 --> 00:05:50,990
أعلم أنّ الأمر سيّئ، لأنّ المرشد
.أساهي لم يتكلّم بغرابة كعادته

69
00:05:50,990 --> 00:05:54,370
.لكنّ إصابة واحدة لا تعني نهاية كلّ شيء

70
00:05:54,370 --> 00:05:59,800
صحيح. فارس السّباقات المشهور
.كوجي عاد بعد تكبّده لإصابة بليغة

71
00:06:02,380 --> 00:06:06,330
عاد بعض الفرسان بعد تعافيهم
.من إصابات بليغة

72
00:06:06,330 --> 00:06:08,510
،لكن فقط إن كانوا بارعين من الأساس

73
00:06:08,510 --> 00:06:12,050
كما أنّهم لا يتسابقون بنفس
.الوتيرة السّابقة

74
00:06:12,360 --> 00:06:16,300
شون، أراك صامتًا. أليست لديك أيّ أفكار؟

75
00:06:17,060 --> 00:06:19,810
.لا تبدو لي منزعجًا كثيرًا بهذا

76
00:06:19,810 --> 00:06:21,020
.توقّف

77
00:06:21,020 --> 00:06:24,780
.ما تقوله مجرّد هراء

78
00:06:24,780 --> 00:06:25,770
!ماذا؟

79
00:06:25,770 --> 00:06:29,770
أريمورا يو مصاب. لا يمهمّ غلطة
،من كانت أو كيف حدث ذلك

80
00:06:29,770 --> 00:06:31,280
.هذه حقيقة ثابتة

81
00:06:31,580 --> 00:06:34,270
.ذلك لن يتغيّر لأنّه صديقه فحسب

82
00:06:34,730 --> 00:06:36,580
هذا ما يعنيه أن تكون فارس سباقات، صحيح؟

83
00:06:43,770 --> 00:06:47,140
من يهتمّ إن كرّر السّنة؟

84
00:06:47,140 --> 00:06:49,550
.انتظر سنة وستُحلّ كلّ المشاكل

85
00:06:50,490 --> 00:06:52,050
...صحيح، ولكن

86
00:06:58,860 --> 00:06:59,890
!هاياتو

87
00:07:03,010 --> 00:07:06,190
فهمت. لا زوّار؟

88
00:07:06,190 --> 00:07:09,700
.قيل لي أنّ شهرًا ليس كافيًا للتّعافي

89
00:07:09,700 --> 00:07:13,700
...آمل أن يتحسّن قبل موعد الامتحان

90
00:07:13,700 --> 00:07:15,010
.لكنّني قلق

91
00:07:15,670 --> 00:07:18,700
هل أنت قلق حيال أريمورا فحسب؟

92
00:07:21,850 --> 00:07:24,080
لماذا لا تعترف كيف تشعر بالفعل؟

93
00:07:30,580 --> 00:07:33,090
أتشعر بالوحدة يا رايس كيت؟

94
00:07:33,340 --> 00:07:36,530
فهمت... تفتقد يو أيضًا، صحيح؟

95
00:07:40,350 --> 00:07:43,100
هل سيعود إن انسحبت أنت؟

96
00:07:44,930 --> 00:07:47,010
.ما كنتَ لتفهم

97
00:07:47,010 --> 00:07:47,960
!هاياتو

98
00:07:50,930 --> 00:07:52,580
!ما عدت أتحمّل أكثر

99
00:07:53,290 --> 00:07:54,620
لماذا؟

100
00:07:56,890 --> 00:08:01,870
أعلم أفضل من أيّ أحد آخر
!أنّ وزني لن ينخفض

101
00:08:02,260 --> 00:08:07,050
لكنّ كنت غبيًّا وواصلت كفاحي
!ما أدّى لإصابة أريمورا

102
00:08:08,010 --> 00:08:10,420
!حتّى أنّي عرّضته للخطر

103
00:08:11,460 --> 00:08:12,780
.ذلك ليس صحيحًا

104
00:08:14,260 --> 00:08:17,630
.ما عدتُ أملك الحقّ في امتطاء حصان

105
00:08:19,430 --> 00:08:24,440
.لكنّه يريدك أن تركبه ثانية

106
00:08:26,220 --> 00:08:32,390
،حتّى إن شعرنا بالحزم وانسحبنا
.ففي النّهاية، لا تهتمّ الخيول بذلك

107
00:08:32,890 --> 00:08:36,910
،إن وُجد شيء مثل الحقّ في امتطاء حصان

108
00:08:38,740 --> 00:08:42,130
فستفقده فقط إن رفض الحصان
!أن تمتطيه في رأيي

109
00:08:56,930 --> 00:08:58,910
.أظنّ أنّ هذه هي النّهاية لأوتوناشي يو

110
00:08:58,910 --> 00:09:01,030
.لم يكرّس نفسه لهذا 100% من الأساس

111
00:09:01,030 --> 00:09:02,340
.إنّها غلطته بالكامل

112
00:09:02,340 --> 00:09:04,230
!عد إلى مستر دكتور

113
00:09:21,240 --> 00:09:22,410
...يو

114
00:09:26,710 --> 00:09:30,540
تاكو-سان، يمكن للنّاس
أن يكونوا قساة، صحيح؟

115
00:09:31,400 --> 00:09:33,050
...حسنًا

116
00:09:33,700 --> 00:09:35,790
!أريد العودة لركوب الخيل بسرعة

117
00:09:36,870 --> 00:09:39,680
.عليّ بذل جهدي خلال العلاج الجسديّ

118
00:09:39,990 --> 00:09:41,970
أعتقد أنّ بإمكاني البدء الأسبوع القادم؟

119
00:09:42,380 --> 00:09:43,660
.تسبّبت بالمشاكل للجميع

120
00:09:43,660 --> 00:09:47,570
.%عليّ العودة وبذل 100% مما لديّ... بل 120

121
00:09:47,570 --> 00:09:49,690
.لن أسمح لك بركوب الخيل ثانية

122
00:09:50,490 --> 00:09:52,270
...الرّئيسة

123
00:09:56,180 --> 00:09:59,450
.أرسلت أوراق انسحابك من مدرسة ركوب الخيل

124
00:10:14,500 --> 00:10:16,920
!هذا سخيف

125
00:10:17,820 --> 00:10:19,840
أهذا صحيح أيّها المرشد؟

126
00:10:20,070 --> 00:10:24,080
.وصلتنا أوراق انسحابه من وكالته

127
00:10:24,080 --> 00:10:27,020
.يتعامل المرشد نوهيرا معها في الوقت الحاليّ

128
00:10:27,020 --> 00:10:29,100
.لا توافقوا عليها

129
00:10:29,410 --> 00:10:31,610
،بدون معرفة ما حقيقة شعوره شخصيًّا

130
00:10:31,610 --> 00:10:34,630
.لا يمكننا تجاهل طلب من أوصيائه

131
00:10:34,630 --> 00:10:37,540
قالوا للتّوّ أنّ أريمورا مصدوم بشأن إصابته

132
00:10:37,540 --> 00:10:40,110
.وفقد دافعه ليصير فارس سباقات

133
00:10:41,620 --> 00:10:44,450
!أيّها المرشد، أظنّها مجرّد كذبة

134
00:10:44,450 --> 00:10:46,050
!صحيح! ذلك ليس صحيحًا

135
00:10:46,050 --> 00:10:48,910
.كذبة معقّدة كثيرًا
!هذه هي طباع اليابانيّين بالفعل

136
00:10:48,910 --> 00:10:49,880
ما معنى ذلك؟

137
00:10:49,880 --> 00:10:51,360
.هذا يعني أنّ الوكالة أرسلت الأوراق دون علمه

138
00:10:51,360 --> 00:10:52,730
.أريد تصديق ذلك أيضًا

139
00:10:52,730 --> 00:10:54,920
.لكن على الجميع الانتظار الآن

140
00:11:25,950 --> 00:11:28,490
لا! لماذا؟

141
00:11:29,120 --> 00:11:34,340
إنّ كونك فارس سباقات
!قد يودي بحياتك. إنّه أمر خطير

142
00:11:36,390 --> 00:11:41,850
بيدك المصابة هذه، هل يمكنك
أن تنجح كفارس سباقات؟

143
00:11:41,850 --> 00:11:43,140
...أنا

144
00:11:43,580 --> 00:11:45,200
...إن تحسّنت

145
00:11:45,200 --> 00:11:47,080
وإن لم تتحسّن؟

146
00:11:47,930 --> 00:11:53,730
عندما انسحبتَ من مستر دكتور، قلت
.أنّك ستدفع الشّرط الجزائيّ في العقد

147
00:11:53,730 --> 00:11:56,180
كيف تنوي فعل ذلك؟

148
00:12:00,570 --> 00:12:01,690
.يو

149
00:12:05,010 --> 00:12:06,910
.كن واقعيًّا

150
00:12:07,850 --> 00:12:11,410
.لديك طريق واحد وهو أن تكون فنّانًا

151
00:12:41,860 --> 00:12:42,890
.اعتن بنفسك

152
00:12:56,170 --> 00:12:57,030
.أنت

153
00:13:07,470 --> 00:13:08,870
...فارس السّباقات كوجي

154
00:13:10,120 --> 00:13:11,700
.نعم. نعم

155
00:13:11,700 --> 00:13:14,140
.آ-آسفة... شكرًا

156
00:13:15,080 --> 00:13:19,360
.مكثت هنا عندما أصبت إصابة بليغة

157
00:13:19,830 --> 00:13:22,230
.ما زلت آتي إلى هنا لأخذ مسكّناتي

158
00:13:23,770 --> 00:13:27,080
.آسف لأنّي كنت فظًّا معك في الدّيربي

159
00:13:27,080 --> 00:13:29,130
.سمعتُ أنّك فنّان

160
00:13:29,130 --> 00:13:31,310
!كان عليّ أن أطلب توقيعك

161
00:13:36,840 --> 00:13:39,560
أخبرني، متى ستغادر؟

162
00:13:41,430 --> 00:13:44,010
.سأنسحب

163
00:13:44,440 --> 00:13:45,950
هل الوضع سيّئ لهذا الحدّ؟

164
00:13:47,170 --> 00:13:48,010
.لا

165
00:13:50,760 --> 00:13:52,010
.فهمت

166
00:13:52,930 --> 00:13:55,300
.إلى اللّقاء إذًا أيّها الفنّان

167
00:13:55,300 --> 00:13:57,140
.سعيد لأنّ منافسيّ قد قلّوا واحدًا

168
00:13:58,650 --> 00:14:01,020
.لستَ مؤهّلاً لهذا

169
00:14:07,650 --> 00:14:08,700
!كوجي-سان

170
00:14:10,300 --> 00:14:13,890
لماذا لم تضغط على نفسك أكثر
في ديربي هذه السّنة؟

171
00:14:16,300 --> 00:14:20,040
في آخر ممرّ مستقيم، عندما كانت
.هنالك فجوة أمام موا ويستريا

172
00:14:20,040 --> 00:14:21,750
!كنتَ بطيئًا في عبورها

173
00:14:22,290 --> 00:14:24,920
!أظنّ أنّه كان عليك الاندفاع أكثر

174
00:14:30,310 --> 00:14:33,600
لا فائدة من إخبار شخص لا نيّة له
.ليكون فارس سباقات

175
00:14:38,380 --> 00:14:40,870
...لم أعتقد أنّ أيّ أحد سيرى ذلك

176
00:14:44,280 --> 00:14:45,290
!سُحقًا

177
00:14:58,250 --> 00:15:00,410
!لا أستطيع قبول هذا

178
00:15:00,410 --> 00:15:02,330
لماذا على أريمورا الانسحاب؟

179
00:15:02,330 --> 00:15:07,190
على الأرجح أنّ السّيّدة الضّفدعة
.الشّيطانيّة تلك من أرسل الأوراق

180
00:15:07,190 --> 00:15:08,510
.أنا واثق من ذلك

181
00:15:08,510 --> 00:15:12,150
.هي من طلبت إنجاز الوثائقيّ عنه

182
00:15:12,150 --> 00:15:16,360
أي أنّها لم ترد أبدًا أن يصير
فارس سباقات من الأساس؟

183
00:15:16,360 --> 00:15:17,770
...هذا فظيع

184
00:15:18,510 --> 00:15:21,770
.لكنّ خبر إصابته الخطيرة صحيح

185
00:15:22,650 --> 00:15:25,270
ما كان أريمورا أن يستسلم، صحيح؟

186
00:15:28,790 --> 00:15:31,330
!لنكتشف ذلك بأنفسنا إذًا

187
00:15:44,910 --> 00:15:46,170
اتّخذت قرارك؟

188
00:15:46,430 --> 00:15:50,170
.نعم. لكن امنحني بعض الوقت

189
00:15:52,420 --> 00:15:55,020
.لا بأس. افعل ما تريده

190
00:15:55,620 --> 00:16:00,180
.لديّ طلب آخر... حول أريمورا

191
00:16:08,940 --> 00:16:13,700
المعذرة! أنا هنا لرؤية
!أريمورا-كُن في الغرفة 402

192
00:16:19,590 --> 00:16:21,150
.سأعود في الحال

193
00:16:34,930 --> 00:16:36,800
!مرحبًا يا يو

194
00:16:38,030 --> 00:16:39,250
!شون

195
00:16:40,310 --> 00:16:44,310
!لا يمكنكما خداعي بهذا التّنكّر

196
00:16:44,670 --> 00:16:48,610
.لا تسمح الرّئيسة لأيّ أحد برؤية يو
.ولا حتّى أنتم

197
00:16:48,610 --> 00:16:50,680
!لبعض الوقت فحسب! أرجوك

198
00:16:50,680 --> 00:16:53,250
لا يمكنك فعل أيّ شيء يا تاكو-سان؟

199
00:16:54,850 --> 00:16:55,980
.المعذرة

200
00:16:55,980 --> 00:16:58,360
أيمكنك إذًا أن توصلي إليه رسالة؟

201
00:16:58,670 --> 00:17:00,100
...آسفة، لكن

202
00:17:01,820 --> 00:17:03,620
!مهلاً

203
00:17:03,620 --> 00:17:04,990
!صحيح

204
00:17:04,990 --> 00:17:06,740
!أردت أن أسألك عن شيء

205
00:17:06,740 --> 00:17:11,900
!صحيح، صحيح! وأنا أيضًا
!أريد مقابلة صحافيّة، هل من نصائح؟

206
00:17:08,750 --> 00:17:11,900
!ما حيوانك المفضّل؟ أنا أحبّ الكلاب! لديّ واحد

207
00:17:11,900 --> 00:17:13,290
!يا تاكو-سان

208
00:17:13,290 --> 00:17:14,910
!انتظري

209
00:17:17,730 --> 00:17:21,710
طلب هاياتو من المرشد نوهيرا
.أن يسمح لنا بمغادرة المدرسة

210
00:17:21,710 --> 00:17:23,630
لكن كيف...؟

211
00:17:23,630 --> 00:17:25,970
!سيحتاجون لجدار أكبر من هذا لإيقافي

212
00:17:25,970 --> 00:17:28,440
.إنّ تسلّقه أسهل من جروف الجزيرة

213
00:17:28,440 --> 00:17:29,880
...حسنًا

214
00:17:30,320 --> 00:17:31,740
—لا يمكنك أن

215
00:17:32,050 --> 00:17:33,240
.سرّني هذا

216
00:17:33,240 --> 00:17:37,320
.ظننتُ أنّك أصيب بشدّة
.مسرور لأنّك تبلي أفضل ممّا توقّعت

217
00:17:38,590 --> 00:17:40,330
.لستُ كذلك

218
00:17:41,290 --> 00:17:43,830
.انتهى أمري

219
00:17:43,830 --> 00:17:45,340
!لا تكن سخيفًا

220
00:17:45,340 --> 00:17:47,710
!ابذل جهدك وستعود لسابق عهدك

221
00:17:47,710 --> 00:17:49,230
!انتهى أمري

222
00:17:54,210 --> 00:17:57,670
لا أستطيع أن أصير فارس سباقات
.مهما بذلت من جهد

223
00:17:58,540 --> 00:18:01,720
...لا أستطيع امتطاء رايس كيت

224
00:18:03,150 --> 00:18:05,230
.ما كنت لتفهم

225
00:18:06,220 --> 00:18:11,480
أنت متفائل دائمًا. بإمكانك معرفة
...ما تشعر به الخيول

226
00:18:19,390 --> 00:18:23,050
!رأيتك عن قرب... ولا يمكنني أن أصير مثلك

227
00:18:26,110 --> 00:18:28,000
لكنّك تحبّ ذلك، صحيح؟

228
00:18:28,280 --> 00:18:29,160
ماذا؟

229
00:18:31,330 --> 00:18:34,570
تحبّ ركوب الخيول، صحيح؟

230
00:18:46,690 --> 00:18:50,730
!بالطّبع! أكثر من أيّ شيء آخر

231
00:18:52,490 --> 00:18:54,940
!نعم، أعلم ذلك

232
00:18:59,810 --> 00:19:01,490
...حسنًا

233
00:19:22,110 --> 00:19:23,490
.تأخّرت

234
00:19:24,930 --> 00:19:26,310
أوصلتها له؟

235
00:19:26,310 --> 00:19:27,220
.نعم

236
00:19:28,260 --> 00:19:29,250
.لا داعي للقلق

237
00:19:32,990 --> 00:19:35,230
أصوتي واضح؟

238
00:19:35,230 --> 00:19:36,300
!أكي

239
00:19:36,300 --> 00:19:37,290
هل أنتم جاهزون؟

240
00:19:37,290 --> 00:19:38,060
.حسنًا

241
00:19:38,060 --> 00:19:39,780
.لنقم بهذا بسرعة

242
00:19:39,780 --> 00:19:41,200
.سأبدأ

243
00:19:41,200 --> 00:19:42,180
!يا أريمورا

244
00:19:42,180 --> 00:19:45,240
ما كان يو من مستر دكتور
!الّذي أحبّ أن يستسلم

245
00:19:45,240 --> 00:19:46,670
!أرني أنّك تتحلّى بالشّجاعة

246
00:19:46,670 --> 00:19:48,700
!أريمورا-كُن، تشجّع

247
00:19:48,700 --> 00:19:53,510
إن انسحبت، فأنا من ستحصل على
كلّ الانتباه. ألا تمانع ذلك؟

248
00:19:53,510 --> 00:19:58,060
ما زلت لم تخبرني كيف أتقرّب
.إلى صحافيّة بعد

249
00:19:58,700 --> 00:20:02,260
ألن أرى محاولات أريمورا يو لركوب
الخيل المثيرة للشّفقة ثانية؟

250
00:20:02,260 --> 00:20:03,970
.لا تهتمّ

251
00:20:04,220 --> 00:20:05,220
.أريمورا

252
00:20:05,780 --> 00:20:06,840
.هاياتو

253
00:20:09,310 --> 00:20:12,060
.أريمورا، أنا جدّ آسف

254
00:20:12,840 --> 00:20:15,100
،أعلم أنّ لا شيء ممّا قد أقوله سيكفّر عمّا حدث

255
00:20:15,540 --> 00:20:17,320
.ولا أتحمّل مواجهتك مباشرة

256
00:20:17,810 --> 00:20:21,500
!أريمورا، لا تستسلم! أرجوك

257
00:20:22,610 --> 00:20:24,030
!يو، استمع

258
00:20:26,550 --> 00:20:28,260
أجاهز يا هاياتو؟

259
00:20:28,680 --> 00:20:29,340
.نعم

260
00:20:31,000 --> 00:20:33,070
!هيّا بنا يا رايس كيت

261
00:20:46,970 --> 00:20:49,220
يو، أشعرت بذلك؟

262
00:20:49,220 --> 00:20:51,580
!لنصر واحدًا، مرّة أخرى

263
00:21:12,330 --> 00:21:13,540
!يو

264
00:21:31,370 --> 00:21:33,660
.أردت الشّعور بالرّياح

265
00:21:34,290 --> 00:21:36,280
.حـ-حسنًا