1
00:00:46,840 --> 00:00:48,890
.تهانينا يا أماني

2
00:00:49,230 --> 00:00:50,780
.شكرًا لك يا أريمورا يو

3
00:00:51,400 --> 00:00:54,240
!بدأت أشعر أخيرًا أنّني حقّقت مؤهّلاتي كفارس

4
00:00:54,510 --> 00:00:55,740
...أماني

5
00:00:58,490 --> 00:01:01,370
أهذا ما كنتَ تظنّ أنّني سأقوله؟

6
00:01:01,370 --> 00:01:03,890
،إن كان هذا أفضل ركوب أستطيعه

7
00:01:03,890 --> 00:01:08,000
!فإنّ التّنافس على مستوى عالميّ حلم داخل حلم

8
00:01:09,630 --> 00:01:11,480
!اسمعوا أيّها الضّعفاء

9
00:01:12,000 --> 00:01:14,590
!لا أنوي البقاء كفارس في اليابان

10
00:01:15,970 --> 00:01:18,810
!سأستعمل هذا المكان كدرج لأخطو لعالم أوسع

11
00:01:19,160 --> 00:01:22,760
!بإمكانكم البقاء هنا كضفادع في بئر

12
00:01:22,760 --> 00:01:26,560
!إن كنتم تريدون قتالي، فاصبوا للعالميّة

13
00:01:26,560 --> 00:01:30,120
!سأكون بانتظاركم

14
00:01:30,120 --> 00:01:33,710
.بدأ حديث أماني يشبه حديث المرشد

15
00:01:34,510 --> 00:01:36,990
...ذاك هو تأثيره السّيّئ الأكبر

16
00:01:37,540 --> 00:01:42,710
حسنًا، مرّت ثلاث سنوات مذ بدأت
،التّصوير بهذه الكاميرا أوّل مرّة

17
00:01:44,060 --> 00:01:48,120
!ويوشك العصافير الصّغار أن يغادروا العشّ

18
00:01:48,120 --> 00:01:50,580
...وثائقيّ مدرسة سباقات الخيول

19
00:01:50,580 --> 00:01:52,990
خلال أسبوع واحد، فإنّ فرسان المستقبل

20
00:01:52,990 --> 00:01:55,620
!سيتّجهون لخوض سباقهم التّجريبيّ السّابع

21
00:02:13,500 --> 00:02:14,830
...هكذا إذًا

22
00:02:15,250 --> 00:02:17,810
.رأينا الرّقم 5 يتقدّم خلفه

23
00:02:20,600 --> 00:02:21,280
!كوتا

24
00:02:23,700 --> 00:02:25,410
.تعال معي للحظة

25
00:02:28,660 --> 00:02:33,420
.لطالما أردت قول شيء لك

26
00:02:35,420 --> 00:02:40,180
.كنتُ أعلم أنّك متحيّز ضدّي وضدّ سوجيرو

27
00:02:40,180 --> 00:02:43,450
.نعم، أبي فارس في الأرياف

28
00:02:43,960 --> 00:02:46,620
ظننتَ أنّني محظوظ، صحيح؟

29
00:02:51,060 --> 00:02:52,920
.أعترف أنّ ذلك صحيح

30
00:02:53,750 --> 00:02:55,000
فماذا في ذلك؟

31
00:02:55,000 --> 00:02:59,800
!لا يحقّ لك قول أيّ شيء

32
00:03:00,670 --> 00:03:03,330
،كما قاتلتَ أنت

33
00:03:04,010 --> 00:03:07,580
!فلدينا طُرقنا الخاصّة في القتال أيضًا

34
00:03:09,350 --> 00:03:11,140
!أعلم ذلك تمام المعرفة

35
00:03:11,610 --> 00:03:15,270
وكون المرء غير محظوظ أيضًا
.هو سلاح بحذّ ذاته

36
00:03:17,560 --> 00:03:19,240
.لن نَقبل ببعضنا أبدًا

37
00:03:21,060 --> 00:03:23,550
!لكنّي لن أخسر أمامك! هذا كلّ شيء

38
00:03:25,630 --> 00:03:27,850
!ولا أنا أيّها الغبيّ

39
00:03:31,520 --> 00:03:34,340
!لا ترمي بشكل غريب

40
00:03:34,340 --> 00:03:36,600
!أمسك بها فحسب

41
00:03:34,990 --> 00:03:38,420
لماذا هما متحمّسان لهذه الدّرجة؟

42
00:03:56,630 --> 00:03:57,500
.مرحبًا

43
00:03:57,990 --> 00:03:59,780
.سرّتني رؤيتك ثانية

44
00:04:00,920 --> 00:04:02,340
.أرى أنّك في أفضل حال

45
00:04:05,260 --> 00:04:08,210
.أخبرينا ما هو شعورك حيال السّباق التّالي

46
00:04:08,620 --> 00:04:12,070
.سأبذل قصارى جهدي مهما كان الوضع

47
00:04:12,440 --> 00:04:14,930
...مع أنّي لم أفز بعد

48
00:04:14,930 --> 00:04:19,630
لكنّ حصاني هذه المرّة هو حصان
.سبق وركبته كثيرًا منذ سنتي الأولى

49
00:04:19,630 --> 00:04:23,110
!آمل أن أستطيع أن أريدكم كم أنّنا متوافقان معًا

50
00:04:24,200 --> 00:04:26,570
.حسنًا، هذا جيّد. شكرًا لك

51
00:04:26,570 --> 00:04:29,280
كنتُ متوتّرة قليلاً، صحيح؟

52
00:04:29,280 --> 00:04:30,740
هل نعيد التّصوير؟

53
00:04:30,740 --> 00:04:32,400
!لا بأس

54
00:04:32,400 --> 00:04:35,710
!سأعرضه خلال تخرّجك! كوني في الانتظار

55
00:04:36,130 --> 00:04:38,130
.سأصوّر البقيّة لاحقًا

56
00:04:38,130 --> 00:04:39,670
!حسنًا

57
00:04:41,950 --> 00:04:44,520
.أحسنت عملاً يا آنسة شيموتسكي

58
00:04:44,520 --> 00:04:48,800
آمل ألاّ يجعلني ذلك أبدو أسوأ
.من لو لم أفعل شيئًا

59
00:04:49,090 --> 00:04:50,810
.لا بأس

60
00:04:51,050 --> 00:04:54,750
.لكن سيكون هنالك الكثير من المشاهدين

61
00:04:54,750 --> 00:04:56,150
.لا يا شيموتسكي

62
00:04:58,400 --> 00:05:01,750
صحيح أنّك تجلبين الكثير من الانتباه
،لسباقات الخيول

63
00:05:01,750 --> 00:05:04,090
.لكنّ تلك ليست مشكلتك

64
00:05:04,510 --> 00:05:08,410
...لكنّ الصّحفيّين قادمون لأنّني هنا

65
00:05:08,410 --> 00:05:11,740
.ها قد بالغتِ كثيرًا

66
00:05:12,910 --> 00:05:15,480
.لا تجبري نفسك على حمل أعباء لا ضرورة منها

67
00:05:16,090 --> 00:05:18,380
.لا يريد أيّ أحد ذلك منك

68
00:05:18,830 --> 00:05:22,360
ذات مرّة، كان هناك فارس كتب
.عنه مقالات أكبر من كوجي

69
00:05:23,000 --> 00:05:26,430
،لكن بمجرّد انسحابه
.قلّ حجم المقالات للحدّ الأدنى

70
00:05:27,610 --> 00:05:31,320
،والآن، قلّة فقط يعرفون أنّه مرشد

71
00:05:32,100 --> 00:05:35,260
.لكنّ ذلك فقط لأه ليس بتلك البراعة

72
00:05:35,900 --> 00:05:38,100
.لم يكن يستحقّ المقالات الكبيرة

73
00:05:40,780 --> 00:05:43,250
.إنّ قيمتك لا تُحدَّد بسباقات الخيول

74
00:05:43,250 --> 00:05:45,110
!أنت ما زلت أنت

75
00:05:45,110 --> 00:05:47,580
.أنا هي أنا فحسب

76
00:05:47,580 --> 00:05:48,840
!نعم

77
00:05:48,840 --> 00:05:53,080
لذلك إن كنت لا تستحقيّن الانتباه
الّذي تحصلين عليه الآن، فما العمل؟

78
00:05:53,080 --> 00:05:54,830
!سأذهب للتّدريب

79
00:05:54,830 --> 00:05:56,830
!عليّ جني الكثير من المال

80
00:05:58,580 --> 00:06:00,550
!ممتاز

81
00:06:04,420 --> 00:06:06,260
.تفضّلا

82
00:06:07,890 --> 00:06:09,220
.استمتعا

83
00:06:09,630 --> 00:06:11,570
!شكرًا لك

84
00:06:15,190 --> 00:06:17,860
حتّى هذا المكان ضمن منطقتك؟

85
00:06:17,860 --> 00:06:19,910
.تعرّفنا على بعضنا حديثًا

86
00:06:19,910 --> 00:06:23,690
.قالت أنّها ستشاهد بثّ السّباق

87
00:06:24,470 --> 00:06:27,010
.أصبح كوتا أفضل بكثير

88
00:06:27,490 --> 00:06:29,570
أكنت تشاهد؟

89
00:06:29,910 --> 00:06:33,730
.تركبون الخيول جميعًا كمحترفين
.أفضل من السّابق بكثير

90
00:06:34,430 --> 00:06:37,040
.آتى تدريبكم في المراكز أُكله

91
00:06:37,750 --> 00:06:39,490
.أعتقد ذلك

92
00:06:40,210 --> 00:06:42,170
كيف حال دراستك يا هاياتو؟

93
00:06:43,370 --> 00:06:46,100
.سجّلني أبي في مدرسة تحضيريّة

94
00:06:46,100 --> 00:06:48,660
سأكون قادرًا على خوض امتحانات
.الولوج للجامعات العام القادم

95
00:06:49,340 --> 00:06:51,310
.وأنا أدرس بجدّ حتّى ذلك الحين

96
00:06:51,310 --> 00:06:53,430
نوهيرا شخص طيّب، صحيح؟

97
00:06:53,430 --> 00:06:56,700
.وعد أن يساعدني حتّى أدخل الجامعة

98
00:06:57,480 --> 00:07:00,940
من الجيّد وجود والد إلى جانبك
.عندما تسوء الأمور

99
00:07:01,810 --> 00:07:03,570
.لذلك حسناته ومساوئه

100
00:07:04,590 --> 00:07:08,230
.سيكون الأمر منوطًا بي بمجرّد قبولي

101
00:07:08,230 --> 00:07:11,260
،دراسة الطّبّ البيطريّ تتطلّب مالاً

102
00:07:11,800 --> 00:07:13,820
.وهي ليست بالأمر الهيّن أبدًا

103
00:07:15,800 --> 00:07:17,860
ينطبق نفس الأمر على البشر والخيول، صحيح؟

104
00:07:18,330 --> 00:07:20,380
.لكنّني لن أستسلم

105
00:07:20,810 --> 00:07:25,010
،عندما كنت في مدرسة سباقات الخيول
.كنتُ أعمل بقصارى جهدي

106
00:07:27,180 --> 00:07:29,900
.كانت تجربة ذلك مساعدة كبيرة لي

107
00:07:30,340 --> 00:07:31,160
.نعم

108
00:07:39,490 --> 00:07:43,590
.يومًا ما، ستعتني بحصاني في ميهو أو ريتّو

109
00:07:44,060 --> 00:07:45,700
.بعد سنوات طويلة

110
00:07:48,070 --> 00:07:49,140
،ولكن

111
00:07:50,730 --> 00:07:53,650
وجود في نفس مجال العملي مثلي

112
00:07:54,830 --> 00:07:55,870
.يُسعدني

113
00:08:03,720 --> 00:08:06,490
.أعتقد أنّني أفهم لماذا تحبّك الفتيات

114
00:08:08,420 --> 00:08:09,510
ماذا تقصد بذلك؟

115
00:08:09,510 --> 00:08:10,650
.لا تهتمّ

116
00:08:10,650 --> 00:08:12,200
!ماذا؟ يراودني الفضول الآن

117
00:08:31,970 --> 00:08:33,000
...المديرة

118
00:08:34,830 --> 00:08:37,030
.لم أرك منذ مدّة يا يو

119
00:08:39,700 --> 00:08:43,890
لم أستطع الحضور العام الماضي
.لأنّي كنت في مركز التّدريب

120
00:08:44,620 --> 00:08:47,370
هل تمكّنت من إخبار والديك عمّا تفعله؟

121
00:08:47,370 --> 00:08:50,960
.نعم. آمل أن يكونا سعيدين

122
00:08:51,340 --> 00:08:53,730
...واثقة أنّهما يشجّعانك

123
00:08:53,730 --> 00:08:58,700
...كانت أمّك تحبّ خوض تحدّيات جديدة

124
00:09:00,260 --> 00:09:01,680
.هذا صحيح

125
00:09:05,440 --> 00:09:06,520
...عفوًا

126
00:09:07,310 --> 00:09:08,230
.أيّتها المديرة

127
00:09:08,940 --> 00:09:11,820
!أعد أنّني سأصبح فارس سباقات

128
00:09:12,610 --> 00:09:16,520
.ربّيتني لأكون فنّانًا مشهورًا

129
00:09:17,540 --> 00:09:21,640
.أحببت الغناء والرّقص أمام النّاس

130
00:09:22,620 --> 00:09:24,120
...لكن في النّهاية

131
00:09:24,500 --> 00:09:25,370
.نعم

132
00:09:26,190 --> 00:09:28,500
!عثرت على شيء أحبّه أكثر

133
00:09:29,720 --> 00:09:30,840
.أنا ممتنّ لك

134
00:09:35,220 --> 00:09:38,870
...عندما التقيت بك أوّل مرّة

135
00:09:42,030 --> 00:09:45,580
كانت في عينيك نظرة عزيمة قويّة
.لا يمكنني نسيانها

136
00:09:46,750 --> 00:09:51,860
،جعلتُ منك فنّانًا ليكون لتلك النّظرة ملاذ

137
00:09:52,130 --> 00:09:55,250
.وقد ارتقيتَ لتطلّعاتي وأكثر

138
00:09:56,610 --> 00:10:00,850
.لعينيك تأثير على النّاس

139
00:10:01,540 --> 00:10:04,120
.لذلك السّبب أصبحتَ فنّانًا محبوبًا

140
00:10:05,410 --> 00:10:10,380
وها أنت الآن تمنح النّاس أحلامًا
.كفارس سباقات بدل ذلك، هذا كلّ شيء

141
00:10:11,060 --> 00:10:15,420
.وكأنّك تركت المنزل وصرت تعيش بمفردك الآن

142
00:10:15,420 --> 00:10:17,860
.ذلك لا يتغيّر مهما كان ما تريد أن تصبح

143
00:10:19,050 --> 00:10:22,630
.أنت ابني، أينما ذهبت

144
00:10:36,860 --> 00:10:39,500
!أغنية مستر دكتور الجديدة رائعة

145
00:10:39,500 --> 00:10:41,830
!إنّهما في تناغم مثاليّ

146
00:10:42,620 --> 00:10:46,310
المعذرة! هل أنت أوتوناشي-كُن؟

147
00:10:48,060 --> 00:10:49,790
!أنا آسفة

148
00:10:49,790 --> 00:10:51,360
...أعني أريمورا-سان

149
00:10:51,360 --> 00:10:53,720
!عفوًا، حظًّا سعيدًا لك في سباقك

150
00:10:53,720 --> 00:10:55,300
!سنظلّ نشجّعك على الدّوام

151
00:10:57,670 --> 00:10:58,540
!أكيد

152
00:11:23,790 --> 00:11:24,630
.مرحبًا

153
00:11:25,200 --> 00:11:26,380
.شون

154
00:11:27,740 --> 00:11:28,430
.يو

155
00:11:35,490 --> 00:11:38,750
.ثمّة أمر عليّ إخبارك به

156
00:11:56,650 --> 00:11:57,990
!يا شون

157
00:12:00,700 --> 00:12:03,990
كيكومي-سان! سومراغي-سان
!وتاياسو-سان أيضًا

158
00:12:07,630 --> 00:12:09,240
مايوكا كيوشين؟

159
00:12:10,340 --> 00:12:12,040
.إنّه في حالة جيّدة

160
00:12:12,450 --> 00:12:14,750
اعتنيتَ به في المدرسة، صحيح؟

161
00:12:15,300 --> 00:12:18,250
!توقّعت أن تلاحظ ذلك

162
00:12:19,990 --> 00:12:24,840
.كازانامي-كُن، شاهدتُ كلّ سباقاتك

163
00:12:25,570 --> 00:12:26,760
.شكرًا لك

164
00:12:28,570 --> 00:12:30,720
تعرف إذًا ماذا أريد قوله، صحيح؟

165
00:12:32,230 --> 00:12:33,030
!نعم

166
00:12:35,140 --> 00:12:37,980
.سأخوض أفضل سباق اليوم قدر الإمكان

167
00:12:38,550 --> 00:12:39,270
...لذلك

168
00:12:41,090 --> 00:12:42,780
!شاهديني حتّى النّهاية

169
00:12:46,040 --> 00:12:47,700
.أتطلّع قُدمًا لذلك

170
00:12:48,020 --> 00:12:50,140
!يستأذن كازانامي شون للذّهاب

171
00:12:52,700 --> 00:12:56,200
.نضج شون كثيرًا

172
00:12:56,950 --> 00:12:57,890
.كلاّ

173
00:12:58,490 --> 00:13:00,960
.ما زال لم ينسلخ عن جلده القديم تمامًا

174
00:13:00,960 --> 00:13:04,190
...علينا نحن البالغون أن نراقبه حتّى النّهاية

175
00:13:06,280 --> 00:13:08,260
حتّى اللّحظة الّتي يبدأ فيها بالطّيران

176
00:13:08,720 --> 00:13:11,430
!نحو المستقبل الّذي اختاره

177
00:13:17,710 --> 00:13:20,320
.التقيتُ ميكو-تشان اليوم

178
00:13:20,650 --> 00:13:22,500
ابنة كاشينو؟

179
00:13:23,980 --> 00:13:24,740
.نعم

180
00:13:25,510 --> 00:13:27,700
.لم نرَ بعضنا منذ مدّة

181
00:13:28,470 --> 00:13:31,210
.أريتها شريطًا لمومو في مزارع هيراتو

182
00:13:32,380 --> 00:13:33,450
أكانت سعيدة؟

183
00:13:33,450 --> 00:13:34,760
.جدًّا

184
00:13:35,130 --> 00:13:38,960
.أخبرتها أنّني سأودّع كيسكي أيضًا

185
00:13:39,430 --> 00:13:40,490
.فهمت

186
00:13:42,860 --> 00:13:44,920
.ستكون مومو فرسًا رائعة

187
00:13:44,920 --> 00:13:47,880
.ستشجّعها ميكو-تشان أيضًا

188
00:13:51,510 --> 00:13:54,270
يو، اذهب إلى الدّيربي رفقة مومو، مفهوم؟

189
00:13:59,350 --> 00:14:00,790
.كم هذا أنانيّ

190
00:14:06,630 --> 00:14:08,990
هل سينجح يو وكازانامي-كُن؟

191
00:14:09,460 --> 00:14:11,020
.إنّهما يدّخران قدرتهما على التّحمّل

192
00:14:11,020 --> 00:14:12,740
.لا بدّ أنّ لديهما سببًا وجيهًا

193
00:14:13,180 --> 00:14:15,970
.وهذا كلّ شيء حتّى إن لم يكن لديهما

194
00:14:15,970 --> 00:14:17,250
!مستحيل

195
00:14:18,460 --> 00:14:20,040
.إنّه سباقهما الأخير

196
00:14:21,070 --> 00:14:23,500
.إنّه ليس الأخير

197
00:14:24,130 --> 00:14:29,370
.نعم، هذا مجرّد سباق واحد يستمرّ في المستقبل

198
00:14:29,930 --> 00:14:33,430
!أجل! هيّا جميعًا

199
00:14:33,430 --> 00:14:36,950
!لنكن رائعين

200
00:14:38,750 --> 00:14:40,330
.إنّ الأغبياء ليسوا في أفضل حالاتهم

201
00:14:40,330 --> 00:14:41,450
!أستطيع النّجاح

202
00:14:41,450 --> 00:14:45,900
،قبل أن أستولي على العالم
!عليّ القضاء على الضّعفاء

203
00:14:46,140 --> 00:14:49,600
سأظلّ صادقة مع نفسي، دون التّفكير
...في أيّ شيء غير مهمّ

204
00:14:49,600 --> 00:14:52,590
...لكنّي أريد ذلك المال

205
00:14:52,590 --> 00:14:55,040
!انتظريني فحسب يا أكوام المال

206
00:14:55,300 --> 00:14:58,000
!أنا في طريقي إلى مضمار طوكيو

207
00:14:58,000 --> 00:14:59,940
!أبي، شاهدني

208
00:14:59,940 --> 00:15:02,130
.حلمي ليس أن أكون فارس فحسب

209
00:15:02,130 --> 00:15:04,460
!حلمي أكبر من ذلك بكثير

210
00:15:04,460 --> 00:15:06,430
.آسف أيّتها الهررة الصّغيرة

211
00:15:06,430 --> 00:15:09,990
.سباق اليوم هو من أجل صديق عزيز

212
00:15:09,990 --> 00:15:14,430
أنا أصيل، لذلك أودّ أن تُسلّط عليّ
!أفضل الأضواء الممكنة

213
00:15:14,840 --> 00:15:19,200
إن كان أريمورا-كُن وكازانامي-كُن
!يخطّطان لأمر ما، فسأقبل تحدّيهما

214
00:15:19,200 --> 00:15:21,110
!لا تستخفّوا بالسّاعات الّتي عملت فيها جاهدًا

215
00:15:21,110 --> 00:15:23,230
!إنّ العمل الجادّ لا يخيّب صاحبه أبدًا

216
00:15:26,820 --> 00:15:29,270
.رأيتُ كم أنّ كوتا كان منزعجًا

217
00:15:31,150 --> 00:15:34,460
.عندما خسر في السّباق التّجريبيّ الأخير أمامك

218
00:15:35,940 --> 00:15:39,190
.كنتُ خائفًا حتّى من الحديث معه

219
00:15:40,270 --> 00:15:42,170
.كان محبطًا كثيرًا فحسب

220
00:15:47,400 --> 00:15:50,420
.لا أفهم ذلك الشّعور

221
00:15:55,630 --> 00:15:57,770
...يو، أنا

222
00:16:01,090 --> 00:16:02,350
,سأستمع لك هنا

223
00:16:07,320 --> 00:16:08,840
.أحبّ هذا المكان

224
00:16:14,320 --> 00:16:15,280
!الآن

225
00:16:24,870 --> 00:16:27,610
.كنّا ننظر إلى نفس الاتّجاه

226
00:16:27,610 --> 00:16:31,340
ألا تحبّ الخيول والتّسابق أيضًا؟

227
00:16:31,340 --> 00:16:32,750
.نعم

228
00:16:33,980 --> 00:16:38,950
أحبّ ذلك، ولهذا السّبب أدركت
.أنّ حبّ الشّيء فحسب لا يجعل منه عملاً

229
00:16:40,350 --> 00:16:44,850
.قالت لي سومراغي-سينسي شيئًا عندما غادرتُ ريتّو

230
00:16:46,530 --> 00:16:51,360
إن أردت أن تختار طريقًا غير
،كونك فارس سباقات

231
00:16:52,660 --> 00:16:53,990
.فمرحبًا بك هنا دائمًا

232
00:17:01,270 --> 00:17:04,010
.تمكّنتْ من رؤية ذلك

233
00:17:04,620 --> 00:17:06,510
إذًا فأنت...؟

234
00:17:06,510 --> 00:17:07,630
.لا ادري

235
00:17:08,250 --> 00:17:12,510
.ربّما سأكون مدرّبًا
.ربّما سأساعد في مزرعة هيراتو

236
00:17:12,510 --> 00:17:13,390
...لكن

237
00:17:15,300 --> 00:17:17,310
...الشّيء الوحيد الواثق منه

238
00:17:19,010 --> 00:17:21,830
.هو أنّني لستُ فارسًا

239
00:17:30,060 --> 00:17:31,630
.يبدو هدا من شيمك تمامًا يا شون

240
00:17:33,020 --> 00:17:36,280
.لذلك لن أتراجع عمّا أفكّر به أيضًا

241
00:17:40,270 --> 00:17:42,250
.سابقني بحقّ غدًا

242
00:17:43,530 --> 00:17:45,230
.نعم. لك ذلك

243
00:17:45,740 --> 00:17:48,270
لكن ما الغاية من هذه القبّعة؟

244
00:17:48,270 --> 00:17:49,420
.سأعطيها لك

245
00:17:49,420 --> 00:17:53,000
.تبدو دائمًا وكأنّك ستطفو لمكان ما

246
00:17:53,620 --> 00:17:57,430
،لذلك أحتاج لشي ما لأجدك به
.أينما حللتَ وارتحلت

247
00:17:57,900 --> 00:17:59,640
.أنت تبالغ

248
00:18:00,970 --> 00:18:02,970
.لكن شكرًا

249
00:18:03,580 --> 00:18:04,920
.سأعتني بها جيّدًا

250
00:18:06,550 --> 00:18:09,710
.حسنًا، سأعطيك شيئًا أيضًا يا يو

251
00:18:10,380 --> 00:18:12,450
.يو، خذ هذه

252
00:18:14,450 --> 00:18:18,320
.ما عدت أحتاج لهذه القوّة

253
00:18:43,250 --> 00:18:46,340
...إذًا فهذا هو العالم الّذي تراه الآن

254
00:18:46,700 --> 00:18:48,580
...يا له من شعور رائع

255
00:18:49,140 --> 00:18:51,650
.شون، عدني

256
00:18:51,650 --> 00:18:53,110
أعدك؟

257
00:18:53,110 --> 00:18:54,060
.نعم

258
00:18:54,680 --> 00:18:56,940
...مهما كانت الإجابة الّتي ستعثر عليها

259
00:18:57,580 --> 00:18:59,880
...فإنّك يومًا ما

260
00:19:08,410 --> 00:19:10,830
!يو! انطلق

261
00:19:12,600 --> 00:19:14,630
!واصل يا شون

262
00:19:55,010 --> 00:19:56,750
!شكرًا لكم جميعًا

263
00:19:57,020 --> 00:19:59,330
!صوّرت كلّ شيء

264
00:19:59,870 --> 00:20:01,630
...والآن

265
00:20:02,010 --> 00:20:04,580
!لنلتقط صورة لتذكّر هذا اليوم

266
00:20:04,580 --> 00:20:08,780
!اسمعوا جميعًا، لنستعدّ للطّيران بعيدًا

267
00:20:11,770 --> 00:20:13,520
!استعدّوا

268
00:20:14,190 --> 00:20:16,790
!ثلاثة، اثنان، واحد

269
00:22:03,810 --> 00:22:05,590
!ها نحن أولاء

270
00:22:08,120 --> 00:22:11,020
!بالكاد انتهيت

271
00:22:16,500 --> 00:22:18,650
.كوجي-سان، أحسنت عملاً

272
00:22:20,660 --> 00:22:22,150
.أنت هنا أخيرًا

273
00:22:22,770 --> 00:22:27,640
حان الوقت لتتعلّم أنّ ركوبك الضّعيف
!لن يفيدك في العالم الحقيقيّ. ابدأ العمل

274
00:22:27,640 --> 00:22:28,530
!حاضر

275
00:22:47,010 --> 00:22:49,280
.وها هو ذا

276
00:22:49,280 --> 00:22:52,340
.فارس هذه السّنة المبتدئ أريمورا

277
00:22:52,340 --> 00:22:58,150
،سبق وانضمّ زملاء فصله للمضمار
.بينما كانت بدايته هو متأخّرة قليلاً

278
00:22:59,190 --> 00:23:03,020
هل سيرينا ركوبه القويّ
الّذي لا يقوى عليه إلاّ مبتدئ؟

279
00:23:23,850 --> 00:23:25,000
!...الآن

280
00:23:27,310 --> 00:23:28,510
!لنتسابق

281
00:23:36,180 --> 00:23:40,020
صخب المراهقة