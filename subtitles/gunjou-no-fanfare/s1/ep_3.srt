1
00:01:34,030 --> 00:01:36,030
...تعريف الحصان الأصيل هو

2
00:01:36,340 --> 00:01:37,280
.أصيل

3
00:01:39,660 --> 00:01:40,780
...وضع الحصان

4
00:01:40,780 --> 00:01:41,530
!وضع

5
00:01:43,780 --> 00:01:45,790
...لا بدّ من الحفاظ على الجوانب الجسديّة

6
00:01:45,790 --> 00:01:46,910
.الجسديّة

7
00:01:48,940 --> 00:01:51,750
.أماني، توقّف عن ذلك رجاءً

8
00:01:51,750 --> 00:01:53,550
!أنا جدّ آسف

9
00:01:53,550 --> 00:01:55,790
...حسنًا، إن قلبتم الصّفحة

10
00:01:55,790 --> 00:01:56,880
!صفحة

11
00:01:55,790 --> 00:01:57,250
!اخرس

12
00:01:59,680 --> 00:02:01,180
!اخرس

13
00:02:02,770 --> 00:02:06,240
لم تكن لي أيّ نيّة لارتياد مدرسة
.يابانيّة على أيّ حال

14
00:02:06,240 --> 00:02:10,520
!إنّ فكرة وجود شيء هنا لأتعلّمه مجرّد هراء

15
00:02:13,240 --> 00:02:15,030
!أرفض القيام بهذا

16
00:02:15,710 --> 00:02:19,990
هل يعلّمكم تنظيف الإسطبلات
أيّ شيء عن ركوب الخيول؟

17
00:02:21,300 --> 00:02:27,120
،إن أردتم أن تكونوا من خيرة فرسان السّباقات
فانسوا أمر تلميع الأرضيّات القذرة

18
00:02:27,120 --> 00:02:29,600
وتعلّموا كيف تصقلون مهاراتكم
!على مستوى عالميّ

19
00:02:31,980 --> 00:02:33,470
.القواعد قواعد

20
00:02:33,820 --> 00:02:38,300
يساعدنا تنظيف الإسطبلات
.وإطعام الخيول على فهمها

21
00:02:38,530 --> 00:02:40,770
.يساعدنا على التّواصل معها أفضل

22
00:02:41,800 --> 00:02:44,180
.يقال أنّ الحصان والإنسان واحد

23
00:02:44,180 --> 00:02:46,060
!عليك أن تصير واحدًا مع حصانك

24
00:02:53,150 --> 00:02:55,550
واحد مع حصانك؟

25
00:02:57,360 --> 00:02:59,720
!الخيول شركاء عمل

26
00:02:59,720 --> 00:03:03,320
.لا يمكنك أن تصير واحدًا معها بالتملّق لها

27
00:03:03,320 --> 00:03:04,660
ماذا قلت؟

28
00:03:05,970 --> 00:03:07,610
!توقّفوا

29
00:03:07,610 --> 00:03:09,500
!حسنًا، سأدغدغك إذًا

30
00:03:09,500 --> 00:03:10,900
!دغدغة دغدغة دغدغة

31
00:03:11,340 --> 00:03:14,000
!لا! لا! لا تأكل رأسي

32
00:03:11,340 --> 00:03:14,000
.حسنًا، سأذهب للقيام بالمشي الصّباحيّ

33
00:03:14,650 --> 00:03:15,290
!أنت

34
00:03:15,290 --> 00:03:15,920
!انتظر

35
00:03:16,270 --> 00:03:17,420
ما مشكلته؟

36
00:03:17,420 --> 00:03:19,920
.أظنّ أنّه يحبّ جلب الانتباه فحسب

37
00:03:34,440 --> 00:03:36,590
!أريمورا، أخفض وركيك

38
00:03:36,590 --> 00:03:37,940
!أنت تهتزّ للأمام والخلف

39
00:03:37,940 --> 00:03:39,090
!حاضر

40
00:03:42,660 --> 00:03:44,710
.يبلي يو بلاءً حسنًا

41
00:03:44,710 --> 00:03:46,840
.تحسّن كثيرًا مؤخّرًا

42
00:03:46,840 --> 00:03:50,660
!تسمّون ذلك "تحسّنًا"؟ إنّه مستواه متدنٍّ

43
00:03:51,400 --> 00:03:52,740
فعلاً؟

44
00:03:55,400 --> 00:03:59,520
لا يستطيع الفتى الّتي في الأمام
.جعل حصانه يستمع إليه

45
00:04:00,050 --> 00:04:02,640
.والّذي خلفه مزاجيّ

46
00:04:02,640 --> 00:04:06,470
.عندما يكون مركّزًا، يُبلي حسنًا
.وعندما لا يركّز، يكون فوضويًّا

47
00:04:06,730 --> 00:04:08,770
.كما أنّ لا أمل من الثّالث هناك

48
00:04:08,770 --> 00:04:10,680
.لا حسّ في ذلك على الإطلاق

49
00:04:12,000 --> 00:04:14,120
.عليه الانسحاب فحسب

50
00:04:17,580 --> 00:04:19,220
.لديك الكثير من الآراء بالفعل أيّها الأشقر

51
00:04:19,220 --> 00:04:21,540
وهل تملك أنّ أيّ حسّ إذًا؟

52
00:04:21,540 --> 00:04:23,990
.أكثر منك يا ورديّ الشّعر

53
00:04:24,300 --> 00:04:28,450
كنتَ تمتطي حصانك قبل قليل
.بشكل أنانيّ جعل الحصان يلهث

54
00:04:28,450 --> 00:04:31,000
أتنوي أن تكون فارس سباقات قصيرة؟

55
00:04:31,000 --> 00:04:31,830
ماذا قلت؟

56
00:04:32,150 --> 00:04:35,190
.أكي، أنت تعامل أريمورا بفظاعة دائمًا

57
00:04:35,190 --> 00:04:37,580
.أظنّ أنّ هذا ما يوصف بحلال علينا وحرام عليكم

58
00:04:37,580 --> 00:04:41,050
!لا بأس! لنرَ ما بإمكانك فعله

59
00:04:42,220 --> 00:04:45,300
.متّع ناظريك أيّها الفتى الخنزير

60
00:04:45,970 --> 00:04:47,400
ماذا؟

61
00:04:47,400 --> 00:04:49,850
ما الّذي يتجادلون حوله؟

62
00:04:57,980 --> 00:04:59,360
!إنّه وسيم جدًّا

63
00:04:59,630 --> 00:05:01,690
.ذلك ركوب مثاليّ

64
00:05:02,840 --> 00:05:06,310
.شاهدوا جميعًا، هذا هو الأسلوب الأوروبّيّ الجميل

65
00:05:06,740 --> 00:05:08,270
.تعلّموا منه

66
00:05:32,810 --> 00:05:35,190
.كان أحدهم لا بأس به

67
00:05:35,190 --> 00:05:37,410
.أمّا البقيّة فعديمو المنفعة على حدّ سواء

68
00:05:37,410 --> 00:05:41,650
.لا، بل عدم منفعة أحدهم كانت أكثر من البقيّة

69
00:05:47,230 --> 00:05:50,250
إلى متى ستواصل التّنظيف؟

70
00:05:50,250 --> 00:05:51,980
.هذا أنت يا أماني

71
00:05:53,780 --> 00:05:54,830
كيف سار التّدريب؟

72
00:05:55,290 --> 00:05:58,170
،كنتُ أعطي بعض النّصائح للفتى الخنزير

73
00:05:58,420 --> 00:05:59,810
.وأخبره أنّه يضيّع وقته

74
00:06:02,550 --> 00:06:04,820
لا يمكنك حتّى القيام بهذا؟

75
00:06:04,820 --> 00:06:07,220
!عليك تدريب بدنك أكثر

76
00:06:08,010 --> 00:06:11,280
قبل ذلك، عليك أن تتدرّب
!على الاستغناء عن الحفّاظات

77
00:06:14,070 --> 00:06:14,640
!انتظر

78
00:06:14,640 --> 00:06:17,640
!أماني، غادر

79
00:06:18,840 --> 00:06:20,350
.بإمكاني تخيّل ما حدث

80
00:06:21,150 --> 00:06:23,690
هل كازانامي شون هنا؟

81
00:06:23,690 --> 00:06:25,800
.على الأرجح أنّ شون في الإسطبل ج

82
00:06:26,250 --> 00:06:29,310
.يذهب في كلّ مساء للحديث مع كلّ الخيول

83
00:06:29,310 --> 00:06:30,320
.حسنًا

84
00:06:36,060 --> 00:06:39,260
.أماني، أبليتَ حسنًا اليوم

85
00:06:39,630 --> 00:06:43,380
.بدوتَ وكأنّك تعدو في السّهول الأوروبّيّة

86
00:06:45,970 --> 00:06:49,840
هل تعني أنّ الأمر بدا وكأنّني كنت أستمتع بوقتي؟

87
00:06:49,840 --> 00:06:51,120
...لا

88
00:06:52,490 --> 00:06:54,890
.حسنًا، ربّما

89
00:06:54,890 --> 00:06:58,310
تظنّ ذلك أيّها الفتى عديم الحسّ؟

90
00:07:12,370 --> 00:07:14,830
ما الّذي تفعله هنا؟

91
00:07:15,080 --> 00:07:19,080
.سمعت أنّك كنت فنّانًا قبل بضعة أشهر فحسب

92
00:07:20,800 --> 00:07:22,000
وماذا في ذلك؟

93
00:07:22,720 --> 00:07:25,180
.كان ركوبك فظيعًا

94
00:07:25,180 --> 00:07:28,840
لماذا لا تتظاهر بالرّقص فوق حصانك قليلاً؟

95
00:07:28,840 --> 00:07:29,810
—ما الّذي قلتـ

96
00:07:29,810 --> 00:07:31,340
أريمورا؟

97
00:07:31,340 --> 00:07:33,200
.كنت أضيّع وقتي

98
00:07:42,880 --> 00:07:45,230
ما مشكلته؟

99
00:07:45,230 --> 00:07:47,600
.لا أهتمّ إن كان قد عاد للتّوّ من إنجلترا

100
00:07:47,600 --> 00:07:49,030
!إنّه مجرّد وغد

101
00:07:49,030 --> 00:07:52,230
.يُفترض أنّه درس في فرنسا والولايات المتّحدة

102
00:07:52,230 --> 00:07:55,530
.إنّه يحبّ فعلاً التّحدّث بوقاحة

103
00:07:55,530 --> 00:07:57,280
.لقد أفسد الأجواء هنا

104
00:07:57,620 --> 00:07:59,300
ما رأيك يا أريمورا؟

105
00:08:01,530 --> 00:08:03,120
!إنّه يغضبني

106
00:08:03,340 --> 00:08:04,630
فعلاً؟

107
00:08:04,630 --> 00:08:07,170
.حسنًا، سأتحدّاه ابتداءً من الغد

108
00:08:07,170 --> 00:08:10,020
.أظنّ أنّكم تضيّعون وقتكم فحسب

109
00:08:10,020 --> 00:08:12,170
إري، ألا تمانعين هذا؟

110
00:08:12,170 --> 00:08:14,670
.لم يقل أيّ شيء لي

111
00:08:15,010 --> 00:08:16,860
صحيح يا كازانامي؟

112
00:08:19,960 --> 00:08:21,260
.صحيح

113
00:08:21,610 --> 00:08:24,200
.ولكنّ مهاراته حقيقيّة

114
00:08:24,200 --> 00:08:27,340
.توازنه على الحصان ممتاز
.وسيطرته مثاليّة

115
00:08:27,340 --> 00:08:29,670
بإمكانه توقّع ما يجعل الحصان
.مميّزًا في رمشة عين

116
00:08:31,160 --> 00:08:32,360
...لكن

117
00:08:35,880 --> 00:08:38,830
حسنًا، لا أجد أيّ شيء سيّئ
.أقوله عنه حتّى الآن

118
00:08:38,830 --> 00:08:41,860
.إنّه الأفضل بيننا جميعًا في امتطاء الخيول

119
00:08:45,150 --> 00:08:47,270
.لنلق نظرة على حالة الطّقس غدًا

120
00:08:47,270 --> 00:08:52,060
،ستكون السّماء غائمة غدًا صباحًا
.لكنّ الشّمس ستكون ساطعة في النّهار

121
00:08:52,370 --> 00:08:55,300
،وفي اللّيل، ستصعد سحب ماطرة من الجنوب

122
00:08:55,300 --> 00:08:58,650
.وستخلق فرصة لحدوث عواصف عند الجبال

123
00:08:56,000 --> 00:08:56,940
.أماني

124
00:08:57,920 --> 00:09:00,530
كازانامي، أتريد الخروج لتتمشّى؟

125
00:08:59,340 --> 00:09:01,810
...ستزداد الأجواء دفئًا غدًا مع انقشاع السّحب

126
00:09:25,330 --> 00:09:26,830
شون وأماني؟

127
00:09:28,540 --> 00:09:30,540
.قال كوتا أنّه رآهما

128
00:09:30,540 --> 00:09:32,480
!ذهبا للخارج للتّوّ

129
00:09:35,800 --> 00:09:37,280
ما الّذي يفعلانه؟

130
00:09:37,620 --> 00:09:40,180
.تحقّق من غرفتيهما ولم يكونا هناك

131
00:09:40,180 --> 00:09:42,680
لكنّهما سيعودان قريبًا، صحيح؟

132
00:09:42,680 --> 00:09:45,600
.ثمّة سبب يمنعنا من الانتظار

133
00:09:51,990 --> 00:09:54,100
.جدول دوريّات المرشدين

134
00:09:54,750 --> 00:09:55,990
.مذهل

135
00:09:55,990 --> 00:09:58,570
.إنّهم يخرجون دائمًا عند الحادية عشر

136
00:09:58,570 --> 00:10:02,800
،يقوم المرشد نوهيرا بالدّوريّة اليوم
.لذلك فالوضع سيّئ جدًّا

137
00:10:02,800 --> 00:10:03,620
سيّئ؟

138
00:10:03,620 --> 00:10:05,340
هل نسيت؟

139
00:10:05,340 --> 00:10:08,580
،إن خالف عضو من الفصل 42 القواعد
!سيعتبرون أنّ الفصل بأكمله خالفها

140
00:10:08,580 --> 00:10:12,790
.ثلاث نقاط مقابل المغادرة دون إذن
.ونقطة إضافيّة لأنّ الوقت متأخّر

141
00:10:12,790 --> 00:10:15,510
...إن طُبّق ذلك علينا جميعًا

142
00:10:15,510 --> 00:10:19,050
فلن يُسمح لنا بالقيام بتداريب
.امتطاء الخيول لأسبوع

143
00:10:19,050 --> 00:10:21,550
لن نستطيع امتطاء الخيول لأسبوع؟

144
00:10:21,550 --> 00:10:22,720
!سيكون ذلك سيّئًا

145
00:10:23,490 --> 00:10:25,770
!سنذهب لإعادتهما

146
00:10:45,200 --> 00:10:46,480
!حسنًا، لنذهب

147
00:10:59,920 --> 00:11:02,430
!مذهل، هذا المكان رائع

148
00:11:02,790 --> 00:11:05,470
!يمكن وصفه بشبيه القدّيس أندروز في اليابان

149
00:11:06,570 --> 00:11:08,410
.أنت تبالغ

150
00:11:08,410 --> 00:11:09,950
.دعنا نعود

151
00:11:09,950 --> 00:11:12,130
.سنُعاقب لأنّنا غادرنا بدون إذن

152
00:11:12,130 --> 00:11:14,140
.لا علاقة لذلك بنا

153
00:11:22,180 --> 00:11:26,870
كازانامي شون، هلاّ أتيت معي إلى إنجلترا؟

154
00:11:28,580 --> 00:11:32,100
.أنوي مغادرة هذا المكان غدًا

155
00:11:32,580 --> 00:11:37,280
لا فائدة من المرشدين
.ولا يملك التّلاميذ أيّ حسّ

156
00:11:38,290 --> 00:11:41,030
.آسف، لكنّني أحبّ هذا المكان

157
00:11:41,030 --> 00:11:41,630
!لا

158
00:11:41,630 --> 00:11:45,020
.شون، بإمكانك أن تكون فارس سباقات رائعًا

159
00:11:49,900 --> 00:11:52,980
ما هو فارس السّباقات الرّائع في ظنّك؟

160
00:11:53,900 --> 00:11:54,940
ماذا؟

161
00:12:00,300 --> 00:12:02,250
.أماني، ثمّة أحد ما هنا

162
00:12:07,740 --> 00:12:08,690
...هذا

163
00:12:09,330 --> 00:12:10,150
.لنذهب

164
00:12:10,150 --> 00:12:11,460
!ماذا؟ مهلاً

165
00:12:14,050 --> 00:12:15,780
.مرحبًا أيّها العمّ

166
00:12:15,780 --> 00:12:17,760
!مرحبًا يا سو-تشان

167
00:12:17,760 --> 00:12:20,210
أتريد حساء هاروسامي قليل
السّعرات كالمعتاد؟

168
00:12:20,210 --> 00:12:21,550
سو-تشان؟

169
00:12:21,550 --> 00:12:23,190
!أنا زبون منتظم

170
00:12:23,190 --> 00:12:25,890
.لا! أنا أبحث عن أحد اليوم

171
00:12:33,770 --> 00:12:35,490
!شكرًا لكم

172
00:12:34,370 --> 00:12:36,210
.سألت من أجلكم

173
00:12:36,210 --> 00:12:39,780
هل تعرف جميع من في المدينة؟

174
00:12:40,210 --> 00:12:42,330
.نحن هنا منذ شهرين

175
00:12:42,330 --> 00:12:45,360
.بالطّبع سأتعرّف على النّاس

176
00:12:46,630 --> 00:12:48,830
...مهاراته الاجتماعيّة مذهلة

177
00:12:51,300 --> 00:12:53,080
.أنا أبحث عن بعض أصدقائي

178
00:12:53,360 --> 00:12:56,310
.اثنان بالتّحديد، وبنفس عمرنا

179
00:12:56,310 --> 00:12:57,980
هلاّ سمحت لنا بالدّخول؟

180
00:12:57,980 --> 00:13:00,360
أنتم من مدرسة سباقات الخيول، صحيح؟

181
00:13:00,360 --> 00:13:01,670
...لـ-لا

182
00:13:01,970 --> 00:13:04,000
!لا يجب عليكم الخروج في وقت متأخّر

183
00:13:06,580 --> 00:13:09,860
تلك المنشفة! هل تحبّ مستر دكتور أيّها العمّ؟

184
00:13:10,810 --> 00:13:13,270
.إنّها هديّة من ابنتي

185
00:13:13,900 --> 00:13:14,980
...أيّها العمّ

186
00:13:15,580 --> 00:13:20,190
،هل تريد لابنتك أن تقول
!رائع يا أبي! أحبّك"

187
00:13:27,450 --> 00:13:30,490
.أحبّت ابنته الفيديو خاصّتك كثيرًا

188
00:13:30,490 --> 00:13:32,950
.نعم، وكان في مزاج جيّد أيضًا

189
00:13:32,950 --> 00:13:35,960
.حتّى أنّه أعطانا مصابيح يدويّة

190
00:13:35,960 --> 00:13:37,370
...يا إلهي

191
