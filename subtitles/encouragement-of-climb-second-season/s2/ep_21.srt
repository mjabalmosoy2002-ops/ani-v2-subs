1
00:01:32,250 --> 00:01:34,190
...تلك كانت ذكرياتٌ لا تنسى

2
00:01:34,610 --> 00:01:37,340
!لنأتي إلى هنا عندما نكبرُ

3
00:01:37,340 --> 00:01:38,160
.أجل

4
00:01:38,160 --> 00:01:40,970
!حتماً! حتماً علينا فعلها

5
00:01:40,970 --> 00:01:42,780
!أجل! إنهُ وعدٌ

6
00:01:51,580 --> 00:01:53,260
!لقد أنهيتها كلها

7
00:01:53,260 --> 00:01:54,610
حقاً؟

8
00:01:54,610 --> 00:01:58,300
.الآن يمكنني الذهاب إلى جبل تانيغاوا دون القلقِ على أي شيء

9
00:01:59,610 --> 00:02:03,080
.لقد كانت أوي متحمسةً للغاية

10
00:02:07,230 --> 00:02:08,220
...لكن

11
00:02:08,790 --> 00:02:11,570
،بعد أن نوفي بوعدنا

12
00:02:11,570 --> 00:02:13,600
ما الذي سيحدثُ؟

13
00:02:17,760 --> 00:02:19,320
إذاً لقد حان الوقتُ أخيراً؟

14
00:02:20,340 --> 00:02:21,400
ما الخطب؟

15
00:02:21,400 --> 00:02:22,620
،بما أنكِ تسلقتِ جبل فوجي

16
00:02:22,620 --> 00:02:23,920
.هذا سيكون لا شيء بالنسبة لكِ

17
00:02:23,920 --> 00:02:24,900
.صحيح

18
00:02:25,110 --> 00:02:26,490
.توخي الحذر

19
00:02:26,490 --> 00:02:28,190
.شكراً لك، أبي

20
00:02:28,190 --> 00:02:29,520
.إنني ذاهبةٌ الآن

21
00:02:33,220 --> 00:02:35,360
،إذا وفينا بوعدنا

22
00:02:35,990 --> 00:02:38,710
أسيتغيرُ شيٌ ما؟

23
00:02:41,050 --> 00:02:43,600
.أتمنى أن نبقى كما نحن الآن

24
00:02:47,470 --> 00:02:49,220
!يا هيناتا

25
00:02:50,990 --> 00:02:52,360
!صباح الخير

26
00:02:52,360 --> 00:02:54,760
.صباح الخير

27
00:02:57,270 --> 00:02:59,110
!صباحُ الخيـرِ

28
00:03:01,010 --> 00:03:03,280
أأنتِ مستعدةٌ لهذا اليوم؟

29
00:03:03,280 --> 00:03:06,550
لن تمرضي بنصف الطريقِ مجدداً هذه المرة صحيح؟

30
00:03:06,550 --> 00:03:08,580
.سأكون على ما يرام. لقد نمتُ جيداً

31
00:03:10,710 --> 00:03:15,620
...أتمنى أن لا تنتهي علاقتنا بعد أن ننهي هذا

32
00:03:17,080 --> 00:03:20,000
،عند محطة تاكاساكي سوف نتحول إلى خط جوويتسو

33
00:03:20,000 --> 00:03:25,500
،وبعدها سوف نغير القطار عند محطة ميناكامي
.بعدها يجدر أن نصل إلى محطة دواي عند الساعة ١٠ ص

34
00:03:25,500 --> 00:03:29,040
،من المفترض أن يكون التنقل أريح
،إذا أخذنا الحافلة من ميناكامي

35
00:03:29,040 --> 00:03:31,900
يُقال بأن المتسلقين الماهرون ينبغي
.أن يبدأوا التسلق من محطة دواي

36
00:03:31,900 --> 00:03:33,050
الماهرين؟

37
00:03:33,050 --> 00:03:37,150
.هنالك سلمٌ طويلٌ للغاية من الرصيف حتى مخرج المحطة

38
00:03:37,470 --> 00:03:38,410
...آه صحيح

39
00:03:38,410 --> 00:03:41,540
...عندما ذكرتيها تذكرتها عندما ذهبنا

40
00:03:41,540 --> 00:03:42,270
!أجل صحيح

41
00:03:42,270 --> 00:03:44,270
.إظهار مدى براعتِنا ليس هدفنا الآن

42
00:03:44,270 --> 00:03:46,710
.لقد فكرتُ أن نبدأ من هناك فحسبْ

43
00:03:47,470 --> 00:03:48,680
...أوي

44
00:03:50,960 --> 00:03:52,110
ما الخطب؟

45
00:03:52,110 --> 00:03:53,600
.لا شيء

46
00:03:53,600 --> 00:03:54,870
.لا شيء البتة

47
00:03:59,140 --> 00:04:01,380
!وعندها خرجت القطة فجأة

48
00:04:01,380 --> 00:04:02,260
حقاً؟

49
00:04:05,230 --> 00:04:06,930
!لقد وصلنا

50
00:04:08,200 --> 00:04:09,260
!ياللهول

51
00:04:09,260 --> 00:04:11,680
الرصيفُ هو في الحقيقة نفق؟

52
00:04:12,190 --> 00:04:13,270
.فهمتُ الآن

53
00:04:13,270 --> 00:04:15,110
.إنني نوعاً ما أتذكرهُ

54
00:04:15,110 --> 00:04:17,180
.إنهُ باردٌ بعض الشيء

55
00:04:17,180 --> 00:04:19,060
.على الأرجح هذه هي السلالم

56
00:04:19,060 --> 00:04:19,590
ماذــــ

57
00:04:19,660 --> 00:04:20,850
!ماذا؟

58
00:04:21,090 --> 00:04:23,520
...لا أستطيعُ... رؤية القمة

59
00:04:23,520 --> 00:04:25,940
.هنالك تقريباً أكثر من ٤٠٠ درجٍ

60
00:04:25,940 --> 00:04:27,630
أتذكرتِ هذا أيضاً؟

61
00:04:27,630 --> 00:04:28,730
...أ-أجل

62
00:04:28,730 --> 00:04:32,000
.لكن هذا أكثرُ بكثير مما تذكرتْ

63
00:04:41,510 --> 00:04:45,260
.تسلق هذه السلالم هو تقريباً مثل تسلق الجبال

64
00:04:45,260 --> 00:04:47,340
!إنها كثيرةٌ للغاية

65
00:04:47,340 --> 00:04:49,260
إلى أيّ حدٍ تمتدُ؟

66
00:04:50,220 --> 00:04:52,590
!هل أنتما على ما يرام؟

67
00:04:52,590 --> 00:04:55,020
!إننا بخير

68
00:04:55,020 --> 00:04:57,820
!خذا وقتكما في الصعودِ ولا تستعجلا

69
00:04:57,820 --> 00:05:00,020
!إننا ذاهبات الآن

70
00:05:00,020 --> 00:05:01,760
!حسناً

71
00:05:01,760 --> 00:05:04,100
.لا يمكننا البقاءُ هنا هكذا

72
00:05:04,100 --> 00:05:06,280
!لا يزالُ أمامنا تسلقُ جبل تانيغاوا

73
00:05:06,280 --> 00:05:07,910
!أنتِ على حق

74
00:05:07,910 --> 00:05:08,450
!لنجتهد

75
00:05:11,700 --> 00:05:14,450
.يجدر بي حقاً أن أُحسّن قدرتي على التحملِ

76
00:05:14,960 --> 00:05:17,980
.أنتِ على حق، أيتها العجوزة

77
00:05:17,980 --> 00:05:19,900
من هي العجوزة؟

78
00:05:19,900 --> 00:05:21,410
...أيتها العجوز

79
00:05:21,410 --> 00:05:26,300
.واحد، اثنان

80
00:05:29,190 --> 00:05:31,690
.واحد، اثنان

81
00:05:31,690 --> 00:05:33,930
...واحد، اثنان

82
00:05:35,130 --> 00:05:37,280
٤٦٠

83
00:05:37,280 --> 00:05:39,060
٤٦١

84
00:05:39,640 --> 00:05:42,060
٤٦٢

85
00:05:43,780 --> 00:05:45,630
!ووصلنا

86
00:05:45,630 --> 00:05:46,950
...إذاً

87
00:05:46,950 --> 00:05:48,490
أين هو المخرج؟

88
00:05:50,070 --> 00:05:50,870
ما؟

89
00:05:51,970 --> 00:05:52,950
هاه؟

90
00:05:52,950 --> 00:05:54,940
".أحسنت صنعاً"

91
00:05:54,940 --> 00:05:58,430
،هنالك ١٤٣ سلالمَ أُخرى حتى مخرج المحطة

92
00:05:58,430 --> 00:06:01,650
.و٢٤ درجاً آخراً بعد ذلك

93
00:06:03,570 --> 00:06:04,690
.لنفعلها

94
00:06:04,690 --> 00:06:05,210
.أجل

95
00:06:07,000 --> 00:06:08,800
!لقد فعلناها أخيراً

96
00:06:09,370 --> 00:06:11,610
.ا-المعذرة على تأخرنا

97
00:06:11,610 --> 00:06:13,960
ما الذي تملئينه هناك؟

98
00:06:13,960 --> 00:06:15,940
.استمارة تسجيل للتسلق

99
00:06:15,940 --> 00:06:18,530
.إنها للشرطة في حال حدث حادثٌ أو ما شابه

100
00:06:18,530 --> 00:06:20,200
!حـ-حوادث؟

101
00:06:20,200 --> 00:06:21,180
.نعم

102
00:06:24,870 --> 00:06:26,060
.لقد فهمتُ

103
00:06:26,060 --> 00:06:27,970
،لذلك فقط في حال دعت الحاجة

104
00:06:27,970 --> 00:06:30,640
.ينبغي أن تكتبي هنا إلى أين أنتِ ذاهبة ومتى ستعودين

105
00:06:30,640 --> 00:06:33,760
.ويجب أن تقدمي لهم تفاصيل الاتصال بكِ ومسار رحلتكِ

106
00:06:33,760 --> 00:06:36,220
.إنهم يطلبون معلوماتٍ مفصلة حقاً

107
00:06:36,220 --> 00:06:39,870
،أعلم بأنه هذا يبدو مزعجاً بعض الشيء
.لكننا ملزمون على ملئها

108
00:06:39,870 --> 00:06:41,550
.فنحنُ لم نأتي هنا لنموت

109
00:06:42,880 --> 00:06:43,920
.وها قد انتهينا

110
00:06:44,840 --> 00:06:46,560
.والآن نحن مستعدات

111
00:06:46,560 --> 00:06:47,170
.لنذهب

112
00:06:47,690 --> 00:06:49,270
!حسناً

113
00:06:53,130 --> 00:06:55,940
!ياللهول

114
00:07:01,580 --> 00:07:03,230
.وأخيراً إننا هنا

115
00:07:03,910 --> 00:07:04,480
.أجل

116
00:07:05,820 --> 00:07:07,490
...لقد فعلناها حقاً

117
00:07:07,490 --> 00:07:08,980
...لقد جئنا لجبلُ ذكرياتِنا

118
00:07:11,070 --> 00:07:12,990
.لحسن حظنا أن الطقس جميلٌ

119
00:07:13,300 --> 00:07:15,940
،على الرغم من ذلك، الطقس في الجبال يتغير بسرعةٍ

120
00:07:15,940 --> 00:07:17,370
.لذلك لا تهملي نفسكِ

121
00:07:17,370 --> 00:07:20,390
.لقد جلبت معطف المطر الخاص بي، لهذا سأكون بخير

122
00:07:20,390 --> 00:07:22,520
.في الحقيقة، آملُ أن تمطر

123
00:07:22,520 --> 00:07:24,640
.لا تقولي أشياءً مشؤومة كهذه

124
00:07:24,640 --> 00:07:26,330
.لن نكون قادرات على رؤية شروق الشمسِ

125
00:07:26,810 --> 00:07:28,290
!ها! أنتِ على حق

126
00:07:28,290 --> 00:07:30,840
!إنسَّي ما قلتهُ قبل قليل

127
00:07:46,600 --> 00:07:48,210
.هنالك متجرٌ هنا

128
00:07:48,210 --> 00:07:50,580
.لنشتري الهدايا التذكارية أثناء عودتنا

129
00:07:50,580 --> 00:07:53,350
.سأشتري بضائع غوما-تشان

130
00:07:53,350 --> 00:07:54,500
غوما-تشان؟

131
00:07:54,500 --> 00:07:57,860
.إنهُ حصانٌ ظريفٌ يشبهُ إلى حدٍ ما موما-كن

132
00:07:57,860 --> 00:07:59,360
!هاـه

133
00:07:59,360 --> 00:08:01,460
أوي، ما الذي ستشترينهُ أنتِ؟

134
00:08:03,020 --> 00:08:03,540
أوي؟

135
00:08:06,440 --> 00:08:08,560
أوي-تشان، أأنتِ بخير؟

136
00:08:08,560 --> 00:08:09,990
!أ-أجل

137
00:08:09,990 --> 00:08:11,010
أنا بخيرٍ

138
00:08:11,010 --> 00:08:12,050
!تماماً

139
00:08:12,050 --> 00:08:14,300
...إذن لا بأس

140
00:08:18,920 --> 00:08:20,050
.حسناً، لنركب

141
00:08:20,050 --> 00:08:20,680
!أجل

142
00:08:21,510 --> 00:08:22,430
أوي؟

143
00:08:25,030 --> 00:08:27,060
.إنها تبدو شاحبة الوجهِ

144
00:08:27,060 --> 00:08:28,940
.كما توقعت، إنها خائفة

145
00:08:30,010 --> 00:08:31,660
أستصعدنّ؟

146
00:08:32,900 --> 00:08:34,900
.تستطيعين الذهاب أولاً

147
00:08:34,900 --> 00:08:36,320
.شكراً

148
00:08:43,430 --> 00:08:44,370
.تفضلي

149
00:08:44,980 --> 00:08:46,250
.أ-أ شكراً

150
00:08:56,880 --> 00:08:57,670
...أوي

151
00:08:58,130 --> 00:09:00,400
.أوي-سان، لنبذل ما في وسعنا

152
00:09:00,400 --> 00:09:02,030
.تبقى القليلُ بعدْ

153
00:09:02,030 --> 00:09:04,060
.أ-أجل

154
00:09:04,060 --> 00:09:06,600
.تذكري كيف تخطيتِ الأمر في ميتستوجي

155
00:09:06,600 --> 00:09:09,040
.هذا صحيح

156
00:09:09,040 --> 00:09:12,570
.لا تستطيعُ أوي البقاء واقفةً في مثل هذا المكانِ

157
00:09:12,570 --> 00:09:13,780
!تفضلوا

158
00:09:14,670 --> 00:09:15,900
!سوف نمضي قدماً

159
00:09:21,450 --> 00:09:22,730
!هيا بنا، لنذهب

160
00:09:22,730 --> 00:09:24,700
...أ-أجل

161
00:09:31,170 --> 00:09:32,270
!أوي-سان

162
00:09:32,270 --> 00:09:33,230
.ستكونين بخير

163
00:09:33,230 --> 00:09:35,280
!سوف نصل حتى قبل أن تدركِ ذلك

164
00:09:40,750 --> 00:09:42,320
وجهتكم هي مسطحات تينجين؛

165
00:09:42,320 --> 00:09:45,230
.من هناك تستطيعون سلك طريق المعالم السياحية

166
00:09:45,230 --> 00:09:51,810
.مرصد تينجين يكمنُ على ارتفاع حوالي ١،٥٠٠ متراً

167
00:09:53,310 --> 00:09:54,510
!أوي

168
00:09:55,980 --> 00:09:56,990
.لا تستسلمي

169
00:09:56,990 --> 00:09:58,090
.انظري إلى فوق

170
00:09:58,090 --> 00:10:00,200
...ذلك هو المكان الذي سنتسلقهُ

171
00:10:00,200 --> 00:10:02,550
...المكان الذي وعدنا بعضنا أن نذهب إليه

172
00:10:08,320 --> 00:10:09,870
...المكان الذي

173
00:10:26,280 --> 00:10:27,920
!لقد فعلتها

174
00:10:27,920 --> 00:10:28,640
!مرحى

175
00:10:28,640 --> 00:10:30,650
!لقد فعلتها، هيناتا

176
00:10:32,360 --> 00:10:33,390
!لقد فعلتيها

177
00:10:33,390 --> 00:10:35,260
.تستطيعين فعلها عندما تحاولين

178
00:10:35,260 --> 00:10:37,350
.شكراً، هيناتا

179
00:10:39,110 --> 00:10:42,070
!لقد فعلتها، كايدي-سان، كوكونا-تشان

180
00:10:42,070 --> 00:10:43,810
.أحسنتِ صنعاً، أوي-تشان

181
00:10:43,810 --> 00:10:45,100
.لقد فعلتِها حقاً

182
00:10:45,100 --> 00:10:47,200
.تهانينا على إنهاء الجزء الأول

183
00:10:47,690 --> 00:10:50,950
.والآن الجزء الثاني بانتظاركِ

184
00:10:52,620 --> 00:10:53,960
!دعونا نذهب بحماسٍ

185
00:10:54,500 --> 00:10:55,860
...ذلك صحيح

186
00:10:55,860 --> 00:10:58,180
.لا يزالُ أمامي تلفريك التزلج

187
00:10:58,180 --> 00:10:59,910
،بما أنكِ تجاوزتِ التلفريك السابق

188
00:10:59,910 --> 00:11:01,450
!ستكونين بخير مع هذا

189
00:11:02,430 --> 00:11:02,760
-لا

190
00:11:03,370 --> 00:11:06,140
!لا يوجد أي شيءٍ يحميني من السقوطِ

191
00:11:06,140 --> 00:11:07,310
!كما توقعت، إنهُ مستحيل

192
00:11:07,310 --> 00:11:08,610
...مستحيلٌ

193
00:11:08,610 --> 00:11:11,360
.لكنهُ ليس عالياً مثل التلفريك السابق

194
00:11:11,360 --> 00:11:12,380
.هذا صحيحٌ

195
00:11:12,380 --> 00:11:13,730
.هيا، أوي

196
00:11:17,750 --> 00:11:19,930
!أ-أعلم

197
00:11:19,930 --> 00:11:22,080
!حسناً، لنذهب إذن

198
00:11:22,080 --> 00:11:24,580
!لا تدفعيني

199
00:11:29,160 --> 00:11:30,700
.يالهُ من منظرٍ جميل

200
00:11:30,700 --> 00:11:32,290
.أنتِ على حق

201
00:11:36,080 --> 00:11:38,060
!إنهُ عالٍ للغاية

202
00:11:38,060 --> 00:11:40,280
.ستكونين بخير، أُنظري

203
00:11:40,280 --> 00:11:42,570
.إنهُ ليس بذلك العلوّ

204
00:11:44,340 --> 00:11:46,490
.هذا صحيح، ستكونين بخير

205
00:11:46,490 --> 00:11:49,800
.إذا كُنا معاً ستكون قادرتنا على التغلبِ على مصاعبِنا

206
00:11:49,800 --> 00:11:52,320
.لنذهب أبعد؛ أبعد من ذلك

207
00:11:52,320 --> 00:11:54,770
.إلى المكان الذي وعدنا بعضنا بهِ