1
00:00:17,740 --> 00:00:18,990
!وجدتُها

2
00:00:26,200 --> 00:00:27,620
!كاوس-تشان؟

3
00:00:33,320 --> 00:00:34,920
...كويومي-تشان

4
00:00:34,920 --> 00:00:36,250
.أنا آسفة

5
00:00:36,250 --> 00:00:38,490
الأهمّ من ذلك الآن، هل أنت بخير؟

6
00:00:38,490 --> 00:00:42,300
...بدا وكأنّ شيئًا ما هناك

7
00:00:45,810 --> 00:00:47,230
.لا أرى أيّ شيء

8
00:00:58,780 --> 00:01:01,090
...وجدتك

9
00:02:35,120 --> 00:02:37,660
.يبدو أنّه لا يوجد شيء هنا

10
00:02:38,800 --> 00:02:41,950
.لنتناول بعض المثلّجات وننسى الأمر برمّته

11
00:02:41,950 --> 00:02:42,930
...حسنًا

12
00:02:43,810 --> 00:02:47,000
.أصبح الجوّ حارًّا مؤخّرًا

13
00:02:47,000 --> 00:02:47,810
...نعم

14
00:02:48,570 --> 00:02:51,390
!أنا أخاف الأشباح كثيرًا

15
00:02:55,660 --> 00:02:57,370
.لا تقلقي

16
00:02:57,370 --> 00:02:58,940
.أنا واثقة أنّك كنتِ تتخيّلين الأمر فحسب

17
00:02:58,940 --> 00:03:01,800
بالتّفكير في الأمر، ألا توجد مقولة
تقول "تبدأ الأشباح بالقلق"؟

18
00:03:15,670 --> 00:03:17,660
ما الخطب يا كاوس-تشان؟

19
00:03:18,990 --> 00:03:21,640
ألا تؤمنين بوجود الأشباح؟

20
00:03:26,300 --> 00:03:27,810
!روكي-سان

21
00:03:28,650 --> 00:03:30,550
ما الخطب يا كاوس-تشان؟

22
00:03:31,610 --> 00:03:33,780
...هنالك شبح

23
00:03:33,780 --> 00:03:34,890
شبح؟

24
00:03:34,890 --> 00:03:36,290
أواثقة أنّك لا تتخيّلين ذلك فحسب؟

25
00:03:36,290 --> 00:03:37,070
!كلاّ

26
00:03:37,070 --> 00:03:39,260
...إنّ لديه شعرًا طويلاً حالك السّواد

27
00:03:39,260 --> 00:03:42,020
لا يمكن رؤية وجهه ويطفو
!شعره في كلّ مكان

28
00:03:42,020 --> 00:03:45,530
أنا واثقة أنّك رأيتِ رسّامة مانغا
.سكبت الكثير من الحبر على رأسها

29
00:03:45,530 --> 00:03:47,770
...قد يكون ذلك مُقلقًا لسبب مختلف تمامًا

30
00:03:49,000 --> 00:03:50,970
.هدّئي من روعك قليلاً

31
00:03:50,970 --> 00:03:51,790
...حسنًا

32
00:03:52,680 --> 00:03:55,550
!تذكّرتُ للتّوّ أنّني تركتُ كويومي-تشان مع الشّبح

33
00:03:58,430 --> 00:03:59,550
!كلاّ

34
00:04:02,220 --> 00:04:04,280
!كويومي-تشان سوف تُلعنُ

35
00:04:04,280 --> 00:04:05,770
!هذا لطيف للغاية

36
00:04:06,720 --> 00:04:09,520
.صحيح؟ جسدي بارد جدًّا

37
00:04:09,520 --> 00:04:10,480
.إنّهما على وفاق

38
00:04:11,690 --> 00:04:13,640
.فورا-سينباي

39
00:04:13,640 --> 00:04:15,890
!روكي-تشان وتسو-تشان

40
00:04:15,890 --> 00:04:17,070
أتعرفن بعضكنّ؟

41
00:04:17,070 --> 00:04:21,030
كانت زميلتنا الكبرى واهتمّت بنا
.عندما أتينا إلى المسكن أوّل مرّة

42
00:04:21,240 --> 00:04:23,980
.أنا فورا سوزو من السّنة الثّانية في الثّانويّة

43
00:04:23,980 --> 00:04:25,530
.أنا رسّامة مانغا رعب

44
00:04:26,620 --> 00:04:28,700
ألم تعودي للمنزل؟

45
00:04:28,700 --> 00:04:31,780
!إنّهما أفضل صديقاتي

46
00:04:31,780 --> 00:04:33,370
...الأمر لا يبدو كذلك

47
00:04:33,770 --> 00:04:35,750
،بالمناسبة

48
00:04:35,750 --> 00:04:39,210
هل هذه هي الفتاة الّتي كانت تصرخ
قبل قليل بذلك الصّوت الرّائع؟

49
00:04:39,210 --> 00:04:40,900
!اسمها هو كاوس-تشان

50
00:04:40,900 --> 00:04:43,340
!اسمك كاوس-تشان إذًا

51
00:04:44,350 --> 00:04:46,460
.شعرك طويل وجميل

52
00:04:46,700 --> 00:04:49,930
يقولون أنّ الأشخاص الّذين لديهم شعر
،طويل يمتلكون قوى روحيّة أقوى

53
00:04:49,930 --> 00:04:53,330
لذلك فإنّ الأشباح قد تحبّك
...يا كاوس-تشان

54
00:04:55,060 --> 00:04:57,400
!سوف أذهب لحلق كلّ شعري

55
00:04:55,660 --> 00:04:57,400
!لا تتسرّعي بفعل أيّ شيء

56
00:04:57,620 --> 00:04:59,620
هل ستكون بخير؟

57
00:04:59,620 --> 00:05:01,170
!أنت باردة جدًّا

58
00:05:01,170 --> 00:05:03,980
!لن أقلق بشأن اللّيالي السّاخنة جدًّا مجدّدًا

59
00:05:06,070 --> 00:05:09,400
...وأعتقد أنّ هذه تتكيّف بسهولة كبيرة

60
00:05:15,640 --> 00:05:17,330
...فورا-سينباي

61
00:05:19,420 --> 00:05:20,730
.إنّها مخيفة

62
00:05:20,730 --> 00:05:23,210
.عليّ أن أحرص ألاّ ألتقي بها

63
00:05:25,200 --> 00:05:28,300
...كانت كاوس-تشان خائفة جدًّا

64
00:05:28,300 --> 00:05:30,480
.نعم، لا يمكنني لومها على ذلك

65
00:05:30,480 --> 00:05:33,010
فلدى فورا-سينباي عادة
...الظّهور من العدم بالفعل

66
00:05:33,010 --> 00:05:34,220
...صحيح، صحيح

67
00:05:34,220 --> 00:05:37,500
.سأحذّر كاوس-تشان لتكون جاهزة

68
00:05:37,500 --> 00:05:38,840
...وخاصّة

69
00:05:40,010 --> 00:05:41,900
...صباح الخير

70
00:05:44,210 --> 00:05:47,380
بشأن حقيقة أنّها تحبّ الظّهور
...من خلف النّاس أمام المرايا

71
00:05:47,380 --> 00:05:49,110
.فات الأوان

72
00:05:54,020 --> 00:05:56,750
...كاوس-تشان، تفضّلي

73
00:05:57,100 --> 00:05:58,700
!كعك

74
00:05:58,700 --> 00:06:01,160
!كلاّ

75
00:06:04,580 --> 00:06:07,250
!كاوس-تشان، لا بدّ أنّك تحبّينها كثيرًا

76
00:06:07,250 --> 00:06:11,220
.أقصد الدّمى... أنا أحبّها أيضًا

77
00:06:09,290 --> 00:06:11,210
!كلاّ، كلاّ

78
00:06:16,410 --> 00:06:18,980
كاوس-تشان، أتريدين بعضه؟

79
00:06:18,980 --> 00:06:21,000
...لا أريد

80
00:06:23,280 --> 00:06:27,230
!أستطيع رسم صور رائعة عندما أسمع صراخك

81
00:06:28,470 --> 00:06:32,200
كاوس-تشان؟ ما الخطب يا كاوس-تشان؟

82
00:06:32,200 --> 00:06:32,810
ماذا؟

83
00:06:32,810 --> 00:06:34,450
!كاوس-تشان

84
00:06:35,030 --> 00:06:36,960
!سوموسان! سيبّا! جوهاكيو

85
00:06:36,960 --> 00:06:38,360
!تلك ليست تعويذة من الأساس

86
00:06:38,360 --> 00:06:42,250
ناهيك عن ذكر أنّ سينباي ليست شبحًا
!من الأساس، لذلك فهذه وقاحة

87
00:06:42,250 --> 00:06:44,650
!كلاّ! سوف يتمّ تطهيري

88
00:06:44,650 --> 00:06:46,410
!توقّفي رجاءً

89
00:06:44,830 --> 00:06:46,410
،في الحقيقة

90
00:06:46,410 --> 00:06:47,610
...يبدو أنّها تستمتع بهذا الاهتمام

91
00:06:47,610 --> 00:06:49,050
!هذه فرصتك! اهربي

92
00:06:51,500 --> 00:06:53,480
!أنا خائفة جدًّا

93
00:06:53,680 --> 00:06:57,000
.إنّك تصرخين كثيرًا لدرجة أنّها قد أُعجبت بك

94
00:06:57,000 --> 00:06:59,440
.أنقذيني رجاءً يا روكي-سان

95
00:06:59,440 --> 00:07:03,220
بالتّفكير بالأمر، كانت تتبع روكّي
.إلى كلّ مكان في البداية أيضًا

96
00:07:04,120 --> 00:07:06,100
،حتّى عندما أكون نائمة

97
00:07:06,100 --> 00:07:07,720
...أو في الحمّام

98
00:07:08,070 --> 00:07:11,740
...لا يهمّ كم مرّة أحاول الإفلات منها

99
00:07:11,980 --> 00:07:14,840
،ظننتُ أنّني سأفقد صوابي

100
00:07:14,840 --> 00:07:18,480
.لكنّني تمكّنت من رسم هذه في كلّ الأحوال

101
00:07:18,480 --> 00:07:22,080
من الرّائع أنّك تمكّنتِ من استعمال
!تلك التّجربة في عملك

102
00:07:22,280 --> 00:07:25,540
ذلك ما فعلته روكّي لتجاوز
...تلك الفترة بطريقة ما، لكن

103
00:07:25,540 --> 00:07:28,510
...ظهرت فورا-سينباي وهي تنفخ في بوقها

104
00:07:28,510 --> 00:07:32,240
!سوف ينتهي بي الأمر قربانًا لفورا-سينباي

105
00:07:29,170 --> 00:07:32,230
لن تتمكّن كاوس حتّى من رسم
...المانغا على هذه الحال

106
00:07:32,230 --> 00:07:34,760
الطّريقة الوحيدة لدفع فورا-سينباي لنسيان أمرها

107
00:07:34,760 --> 00:07:37,480
!هي بأن تتشجّع وتتجاهلها

108
00:07:41,470 --> 00:07:42,680
هل سينجح هذا؟

109
00:07:43,060 --> 00:07:43,900
.نعم

110
00:07:43,900 --> 00:07:45,790
.لا يجب السّماح لها بالدّخول مهما كلّف الأمر

111
00:07:45,790 --> 00:07:47,640
.حسنًا

112
00:08:05,320 --> 00:08:08,250
كاوس-تشان، هل أنت هنا؟

113
00:08:08,250 --> 00:08:12,920
!كلاّ

114
00:08:09,620 --> 00:08:10,970
!أدخليني

115
00:08:10,970 --> 00:08:12,920
!افتحي

116
00:08:16,730 --> 00:08:20,020
!أنا أخاف من الرّعد

117
00:08:20,020 --> 00:08:23,050
!وأنا خائفة منك

118
00:08:22,110 --> 00:08:23,030
...أرجوك

119
00:08:23,030 --> 00:08:24,570
.افتحي الباب

120
00:08:25,150 --> 00:08:27,130
!أشعر بالوحدة بمفردي

121
00:08:27,810 --> 00:08:31,360
...عدت أخيرًا إلى المسكن

122
00:08:31,360 --> 00:08:34,080
لكنّ الفتاة الّتي كنت شريكتها
!في الغرفة قد غادرت

123
00:08:34,850 --> 00:08:36,280
...أنا وحيدة تمامًا

124
00:08:50,680 --> 00:08:53,050
...لا أدري فعلاً

125
00:08:53,930 --> 00:08:55,410
...كيف

126
00:08:56,390 --> 00:08:59,670
...أتعامل مع الآخرين جيّدًا

127
00:09:01,220 --> 00:09:02,600
...أنا غريبة

128
00:09:02,600 --> 00:09:05,760
...لهذا السّبب تتجاهلنني جميعكنّ

129
00:09:12,340 --> 00:09:13,820
...هذا الإحساس

130
00:09:13,820 --> 00:09:15,610
...إنّه نوعًا ما

131
00:09:17,050 --> 00:09:18,060
!كاوس-تشان

132
00:09:18,060 --> 00:09:18,730
!مهلاً

133
00:09:18,730 --> 00:09:19,950
!لا تفتحي الباب

134
00:09:21,040 --> 00:09:22,830
!أنا أفهم

135
00:09:23,640 --> 00:09:27,640
،لو... لو كان الجميع قد تركوني

136
00:09:27,640 --> 00:09:29,630
،لكنتُ وحيدة أنا أيضًا

137
00:09:29,880 --> 00:09:31,630
!لذلك لا أستطيع تركها وحدها

138
00:09:47,510 --> 00:09:50,420
.لا فائدة. كاوس-تشان لطيفة للغاية

139
00:09:50,420 --> 00:09:53,480
على هذا المعدّل، قد تختفي كاوس
...من المسكن

140
00:09:53,480 --> 00:09:55,060
...مستحيل

141
00:09:55,060 --> 00:09:57,480
!أنت مخيفة بالفعل

142
00:09:57,630 --> 00:09:58,990
ماذا؟

143
00:09:58,990 --> 00:10:02,940
...إنّها نحيلة، لكنّ صدرها كبير

144
00:10:02,940 --> 00:10:04,840
!فهمت

145
00:10:05,420 --> 00:10:07,370
...كاوس-تشان

146
00:10:07,370 --> 00:10:08,620
نعم؟

147
00:10:09,840 --> 00:10:12,600
بما أنّني قد أمعنت النّظر إليها جيّدًا
.الآن، أجدها جميلة للغاية

148
00:10:14,790 --> 00:10:17,760
ماذا؟ ما هذا الاختلاف غير المتوقّع؟

149
00:10:19,230 --> 00:10:21,710
هلاّ أصبحتِ صديقتي؟

150
00:10:21,710 --> 00:10:23,600
!نـ-نعم

151
00:10:23,600 --> 00:10:24,850
!شكرًا لك

152
00:10:26,700 --> 00:10:30,410
هل... هنالك اختلاف ما في صرختها؟

153
00:10:35,700 --> 00:10:36,540
نعم؟

154
00:10:38,090 --> 00:10:40,060
.مرحبًا يا فورا-سينباي

155
00:10:40,060 --> 00:10:41,100
.مرحبًا

156
00:10:41,100 --> 00:10:42,540
.تفضّلي رجاءً

157
00:10:43,230 --> 00:10:46,810
.فورا-سينباي، بشرتك فاتحة جدًّا وجميلة

158
00:10:46,810 --> 00:10:48,260
أتظنّين ذلك؟

159
00:10:48,260 --> 00:10:50,000
...أنا لا أخرج كثيرًا

160
00:10:50,280 --> 00:10:53,370
!أنت ترتدين فساتين جميلة دائمًا

161
00:10:53,370 --> 00:10:54,960
من أين اشتريت هذا؟

162
00:10:54,960 --> 00:10:56,960
...من... الإنترنت

163
00:10:56,960 --> 00:11:00,600
فعلاً؟ ما الخدمة الّتي استعملتها؟

164
00:10:57,860 --> 00:10:58,780
ماذا؟

165
00:10:58,780 --> 00:11:02,400
بطريقة ما، معاملتي بشكل
...عاديّ تبدو محرجة

166
00:11:04,420 --> 00:11:08,850
أتساءل إن كانت نقطة ضعف كاوس-تشان
.هي احتياج الأشخاص النّاضجين لها

167
00:11:09,610 --> 00:11:11,150
هل ظهر منافس جديد؟

168
00:11:11,150 --> 00:11:13,130
.الأمر ليس كذلك

169
00:11:13,590 --> 00:11:17,140
.لكنّني سعيدة بوجود مكان لفورا-سينباي الآن

170
00:11:17,140 --> 00:11:20,560
،نعم. إنّها مختلفة قليلاً
.لكنّها ليست شخصًا سيّئًا

171
00:11:21,510 --> 00:11:24,530
...شكرًا على قلقك عليّ

172
00:11:25,870 --> 00:11:28,520
!ها أنت ذي أيّتها الرّوح الشّرّيرة! اختفي

173
00:11:28,520 --> 00:11:32,000
،أنتما ترفضانني كما يجب عليكما
...وهذا مريح للغاية

174
00:11:33,460 --> 00:11:36,800
...أنتِ شخص مزعج جدًّا بالفعل

175
00:11:38,280 --> 00:11:40,990
.ستكون الأجواء صافية عبر البلاد بأكملها

176
00:11:40,990 --> 00:11:42,780
.وألقوا نظرة على هذه رجاءً

177
00:11:42,780 --> 00:11:46,770
إنّها ساحة كوتشيا، الوقت الأمثل لمشاهدة شجيرات
.كوتشيا في روعتها الكاملة هو أثناء الخريف

178
00:12:08,270 --> 00:12:11,260
لم ترني أولئك الفتيات، صحيح؟

179
00:12:11,970 --> 00:12:14,760
.نعم. أنا لا أبدو كأوتاكو على الإطلاق

180
00:12:14,760 --> 00:12:16,060
.لا بأس

181
00:12:16,060 --> 00:12:17,380
.لم يُكشف سرّي بعد

182
00:12:19,190 --> 00:12:20,940
!أنا مغادِرة

183
00:12:20,940 --> 00:12:22,940
!بالتّوفيق لك

184
00:12:29,180 --> 00:12:31,660
هل سهرتِ ليلة البارحة أيضًا؟

185
00:12:33,100 --> 00:12:35,320
...كنت أفكّر بشأن قصّتي

186
00:12:35,320 --> 00:12:38,990
تسوباسا-سان، سمعتُ أنّ ترتيبك
.في استقصاء القرّاء قد ارتفع

187
00:12:38,990 --> 00:12:40,110
.نعم

188
00:12:40,110 --> 00:12:42,470
...أنا سعيدة، لكنّني أشعر بالضّغط أيضًا

189
00:12:42,470 --> 00:12:47,110
ناهيكنّ عن رغبتي في سماع النّاس
.وهم يخبرونني لماذا ارتفع

190
00:12:47,110 --> 00:12:50,770
على الأرجح أنّك ستغطّين في النّوم في
.الفصل على هذه الحال يا تسو-تشان

191
00:12:50,770 --> 00:12:54,580
،نيجينو-سينسي صارمة للغاية ومخيفة
.لذلك عليك أن تكوني حذرة

192
00:12:54,580 --> 00:12:57,330
أنا واثقة أنّها لم تكتشف

193
00:12:57,330 --> 00:12:59,930
أنّ سبب نوم تسو-تشان في الفصل
...هو المانغا خاصّتها، لكن

194
00:13:04,880 --> 00:13:07,770
.صباح الخير

195
00:13:07,770 --> 00:13:09,520
...صـ-صباح

196
00:13:09,760 --> 00:13:10,600
!مويتا-سان

197
00:13:10,600 --> 00:13:12,620
!عليك أن تلقي التّحيّة بشكل واضح ومسموع

198
00:13:12,620 --> 00:13:13,980
!أنا آسفة

199
00:13:13,980 --> 00:13:19,350
لكنّ التّعرّض للتّوبيخ من طرف
...معلّمات جميلات أمر رائع

200
00:13:19,350 --> 00:13:22,120
مويتا-سان؟ لماذا تبتسمين؟

201
00:13:22,120 --> 00:13:23,880
!كلاّ! أنا آسفة

202
00:13:23,880 --> 00:13:25,740
.تصرّفي بلباقة أكثر رجاءً

203
00:13:27,900 --> 00:13:30,420
هل استوحيتِ ذلك من نيجينو-سينسي؟

204
00:13:30,420 --> 00:13:31,200
.نعم

205
00:13:31,200 --> 00:13:33,740
.كنتُ أرغب في رسم شخصيّة كهذه

206
00:13:33,740 --> 00:13:36,500
هذا رائع! إنّ نيجينو-سينسي
!ظريفة قبل كلّ شيء

207
00:13:36,500 --> 00:13:37,680
.أحسنتِ بلاءً

208
00:13:37,680 --> 00:13:40,380
لماذا لا تجعلين صدرها أكبر قليلاً؟

209
00:13:40,380 --> 00:13:41,500
.أعتقد أنّ هذا مناسب

210
00:13:41,500 --> 00:13:43,510
عمّ تتهامسن؟

211
00:13:43,510 --> 00:13:44,400
...هل يُعقل

212
00:13:44,400 --> 00:13:48,250
...ربّما تتصرّف كأستاذة، ولكن

213
00:13:45,920 --> 00:13:48,250
."إنّها من معجبي "البطل المظلم

214
00:13:48,250 --> 00:13:50,380
.إنّها معجبة حقيقيّة أيضًا

215
00:13:48,860 --> 00:13:50,600
.إنّها واحدة منّا إذًا

216
00:13:50,600 --> 00:13:51,450
!هذا صحيح

217
00:13:51,450 --> 00:13:52,930
...إن كنّ هناك

218
00:13:52,930 --> 00:13:55,810
.إنّها تفتقر الآن لنقص في الشّخصيّة من نوع ما

219
00:13:55,810 --> 00:13:58,620
نقص؟ ما الّذي كنتِ لتفعلينه يا روكي-سان؟

220
00:13:58,620 --> 00:14:00,060
...حسنًا

221
00:14:00,060 --> 00:14:01,440
...عليّ أن أعرف

222
00:14:02,110 --> 00:14:04,820
مثلاً أن تبدو جادّة ولكنّها ترتدي
.ملابس داخليّة جذّابة

223
00:14:05,790 --> 00:14:07,540
أذلك صحيح يا إيروكاوا-سان؟

224
00:14:07,540 --> 00:14:09,400
.كلاّ، لم نكن نتحدّث عنّي

225
00:14:11,270 --> 00:14:12,090
،حسنًا

226
00:14:12,090 --> 00:14:13,880
.سوف نبدأ درسنا الآن

227
00:14:15,720 --> 00:14:19,450
.إن لم يكتشفن أمري، فذلك جيّد

228
00:14:20,010 --> 00:14:23,460
لكن لماذا كانت أولئك الفتيات هناك؟

229
00:14:23,460 --> 00:14:24,470
...هل يعقل

230
00:14:24,470 --> 00:14:25,610
أنّهنّ معجبات؟

231
00:14:26,220 --> 00:14:27,560
استغرقت في النّوم سلفًا؟

232
00:14:27,780 --> 00:14:29,060
!كاتسوكي-سان

233
00:14:29,060 --> 00:14:31,290
هل أتيتِ للمدرسة للنّوم فحسب؟

234
00:14:31,290 --> 00:14:32,550
!تسوباسا-سان

235
00:14:32,550 --> 00:14:36,220
!تسو-تشان، استيقظي يا تسو-تشان

236
00:14:32,860 --> 00:14:36,220
أعتقد أنّني سأسألهنّ بعض
.الأسئلة العفويّة أوّلاً فحسب

237
00:14:36,220 --> 00:14:37,970
!تعالي معي رجاءً

238
00:14:39,180 --> 00:14:40,690
.سأعرف السّبب أوّلاً

239
00:14:41,320 --> 00:14:44,150
والآن، هل تستمعين لي يا كاتسوكي-سان؟

240
00:14:44,150 --> 00:14:46,440
لماذا أنت متعبة كثيرًا هكذا؟

241
00:14:46,440 --> 00:14:48,730
هل تشاهدين أنمي يعرض في وقت متأخّر؟

242
00:14:48,730 --> 00:14:51,700
...أ-أنا

243
00:14:51,700 --> 00:14:55,450
لا أستطيع إخبارها أنّني رسّامة
.مانغا مهما كلّف الأمر

244
00:14:55,450 --> 00:14:57,510
...عليّ أن أسأل

245
00:14:57,510 --> 00:14:59,450
هل تسهرين لوقت متأخّر؟

246
00:15:00,770 --> 00:15:02,630
...في الحقيقة، أنا

247
00:15:02,630 --> 00:15:03,980
.لا يمكنني إخبارها

248
00:15:06,010 --> 00:15:08,900
.هذا بالضّبط ما كنتُ قلقة من حدوثه

249
00:15:08,900 --> 00:15:10,050
...نعم

250
00:15:10,050 --> 00:15:12,350
!هذا ليس منصفًا في حقّ تسوباسا-سان

251
00:15:12,590 --> 00:15:15,950
!سينسي، أرجوك لا تغضبي على تسوباسا-سان

252
00:15:15,950 --> 00:15:17,300
!إنّها متعبة كثيرًا

253
00:15:17,300 --> 00:15:17,970
...كويومي

254
00:15:18,310 --> 00:15:20,970
.كلاّ، لا يمكنني السّماح لها بالنّوم خلال فصلي

255
00:15:22,440 --> 00:15:24,860
إذًا، إن بدت تسوباسا-سان
،على أنّها توشك أن تنام

256
00:15:24,860 --> 00:15:26,690
!فسأسكب لها بعض القهوة

257
00:15:26,690 --> 00:15:28,170
!تفضّلي

258
00:15:28,170 --> 00:15:30,600
!أنت لستِ في فصلي من الأساس

259
00:15:33,820 --> 00:15:36,980
.إنّها تراقبك عن كثب الآن يا تسوباسا-سان

260
00:15:38,620 --> 00:15:41,170
،سألتني لماذا أنام في الفصل

261
00:15:41,170 --> 00:15:44,160
لكنّني لم أستطع إخبارها
.أنّني أسهر اللّيل لرسم المانغا

262
00:15:44,670 --> 00:15:50,600
ربّما عليك أن تخبري نيجينو-سينسي
.بالحقيقة فحسب

263
00:15:50,600 --> 00:15:52,470
...لكنّني أتساءل إن كانت ستقبل بذلك

264
00:15:52,730 --> 00:15:56,230
،إنّها مسؤولة للغاية
.لذلك قد توبّخها كثيرًا

265
00:15:56,230 --> 00:15:59,050
!كفّي عن رسم المانغا وادرسي

266
00:16:00,650 --> 00:16:03,620
...التّعرّض للتّوبيخ من أستاذة جميلة

267
00:16:04,710 --> 00:16:06,820
هل تريدين أن تُوبَّخي يا كاوس-تشان؟

268
00:16:06,820 --> 00:16:09,720
.في كلّ الأحوال، لا يمكنني قول أيّ شيء

269
00:16:10,410 --> 00:16:12,360
...لأنّ كوني فتاة ثانويّة ومؤلّفة

270
00:16:12,840 --> 00:16:15,870
...لا يتناسب مع صورة مانغا الشّونين

271
00:16:17,970 --> 00:16:23,040
.يجب أن تظلّ هويّة "وينغ في" سرّيّة

272
00:16:23,300 --> 00:16:26,870
..."وينغ في"

273
00:16:26,870 --> 00:16:29,930
لماذا كرّرتم اسم شهرتي جميعكنّ للتّوّ؟

274
00:16:29,930 --> 00:16:31,330
.كلاّ، بلا سبب

275
00:16:31,330 --> 00:16:35,450
تعتقد تسو-تشان أنّه رائع، لكن يصعب
.قول أيّ شيء بخصوص ذلك

276
00:16:35,620 --> 00:16:39,880
على أيّ حال، حاولي على الأقلّ أن تظلّي
.مستيقظة في الفصل التّالي مع نيجينو-سينسي

277
00:16:40,600 --> 00:16:42,310
!تفضّلي، إليك فنجان قهوة

278
00:16:46,730 --> 00:16:48,300
...تسو-تشان تبدو مسؤولة و

279
00:16:48,300 --> 00:16:50,610
!تعمل؟

280
00:16:50,610 --> 00:16:53,930
لا تستطيعين فعل ما يحلو لك
!ما دمتِ لا تنامين يا تسو-تشان

281
00:16:53,930 --> 00:16:56,370
...لكن إن لم أفعل هذا، فسأغطّ في النّوم

282
00:16:57,680 --> 00:16:58,650
!ما العمل؟

283
00:17:00,120 --> 00:17:02,070
!انتهى الأمر

284
00:17:02,070 --> 00:17:04,540
!سوف تكتشف الأمر

285
00:17:05,160 --> 00:17:07,410
!عرفتُ هذا

286
00:17:14,970 --> 00:17:17,300
.أعتقد أنّها قد تقع في المشاكل

287
00:17:17,300 --> 00:17:21,360
من وجهة نظرة الأساتذة، على الأرجح
.أنّها بدت كخربشات فحسب

288
00:17:22,690 --> 00:17:25,780
كاتسوكي-سان، هنالك أمر أريد
.أن أسألك عنه

289
00:17:25,780 --> 00:17:26,710
...هذه

290
00:17:27,820 --> 00:17:32,050
!هـ-هل أنت معجبة بـ"البطل المظلم" أيضًا؟

291
00:17:32,690 --> 00:17:34,410
!سينسي

292
00:17:35,180 --> 00:17:36,970
هل تعرفينها؟

293
00:17:36,970 --> 00:17:40,260
.أنا أقرأها منذ الفصل الأوّل

294
00:17:40,260 --> 00:17:42,280
!أنا معجبة كبيرة بـ"وينغ في"-سينسي

295
00:17:42,740 --> 00:17:44,360
...معجبة

296
00:17:44,730 --> 00:17:50,110
كاتسوكي-سان، تبدو رسوماتك
...وكأنّها رسميّة تقريبًا

297
00:17:50,110 --> 00:17:51,330
...نعم

298
00:17:51,330 --> 00:17:53,290
!إنّها معجبة بالفعل

299
00:17:54,130 --> 00:17:55,670
!عليّ تغيير الموضوع

300
00:17:55,900 --> 00:17:57,150
...في الحقيقة

301
00:17:57,150 --> 00:18:00,210
ما الّذي تحبّينه في "البطل المظلم"؟

302
00:18:00,210 --> 00:18:02,280
،في الحقيقة

303
00:18:02,280 --> 00:18:04,180
،أحبّ القصّة والرّسم أيضًا

304
00:18:04,180 --> 00:18:06,760
!لكنّ البطل ظريف للغاية

305
00:18:06,990 --> 00:18:09,810
ظريف؟ ألا تقصدين رائعًا؟

306
00:18:09,810 --> 00:18:12,920
نعم! إنّه فتى شقيّ وبنطاله
!القصير ظريف للغاية

307
00:18:12,920 --> 00:18:14,780
!رضفتاه هما الأفضل

308
00:18:14,780 --> 00:18:16,780
...فهمت

309
00:18:16,780 --> 00:18:18,780
.أعتقد أنّني لم أفكّر بشأن ذلك من قبل

310
00:18:18,780 --> 00:18:22,280
مهلاً، مهلاً... لقد تحمّست كثيرًا
.دون أن أفكّر في الأمر

311
00:18:24,020 --> 00:18:25,450
...أخبريني

312
00:18:25,450 --> 00:18:28,810
هل تذهبين إلى الاحتفاليّات أيضًا؟

313
00:18:29,420 --> 00:18:32,630
أو هل تشاركين في أمور كتلك؟

314
00:18:34,090 --> 00:18:35,460
!لا يمكنني الجلوس مكتوفة اليدين

315
00:18:35,460 --> 00:18:36,730
!يا سينسي

316
00:18:36,730 --> 00:18:38,250
.مويتا-سان

317
00:18:38,250 --> 00:18:40,030
...تسوباسا-سان

318
00:18:40,030 --> 00:18:40,620
نعم؟

319
00:18:41,390 --> 00:18:43,030
!ماذا؟

320
00:18:43,930 --> 00:18:45,580
!سينسي

321
00:18:45,580 --> 00:18:46,930
...لا-لا بأس

322
00:18:47,480 --> 00:18:51,150
...يرسم "وين في"-سينسي رسومات مذهلة

323
00:18:51,340 --> 00:18:52,640
لذلك كنتُ جاهزة لأتقبّل

324
00:18:52,640 --> 00:18:56,110
أيّ صورة قد يبدو عليها أو ما
...قد تكون شخصيّته في الحقيقة

325
00:18:56,110 --> 00:18:58,220
،لكنّ حقيقة كونها فتاة ثانويّة

326
00:18:58,220 --> 00:18:59,580
...بل وتلميذة لي فوق ذلك

327
00:18:59,580 --> 00:19:01,610
!كلاّ، كلاّ، لا يمكن ذلك

328
00:19:01,900 --> 00:19:05,220
مستحيل أن يكون "وينغ في"-سينسي
!هي كاتسوكي-سان

329
00:19:05,220 --> 00:19:06,330
!لكنّ ذلك صحيح

330
00:19:06,330 --> 00:19:08,120
!تسوباسا-سان رائعة

331
00:19:08,120 --> 00:19:11,300
!لستُ ساذجة لدرجة أن تخدعنني هكذا

332
00:19:11,300 --> 00:19:13,010
!لكنّنا لا نخدعك

333
00:19:13,550 --> 00:19:16,500
...لست واثقة إن كان هذا سيثبت الأمر، لكن

334
00:19:16,500 --> 00:19:18,960
.هذه المخطوطة الّتي أنهيتُها هذا الصّباح

335
00:19:30,220 --> 00:19:32,070
!سـ-سـ-سينسي

336
00:19:32,070 --> 00:19:33,190
!اعذري وقاحتي رجاءً

337
00:19:33,190 --> 00:19:35,130
...أنت هي سينسي

338
00:19:35,480 --> 00:19:37,000
هل يمكنني أن أطلب منك شيئًا؟

339
00:19:37,000 --> 00:19:37,860
.نعم

340
00:19:38,780 --> 00:19:40,540
هل سبق وذهبت

341
00:19:40,540 --> 00:19:44,040
إلى احتفاليّة الأنمي الّتي أُقيمت
في مدينة الملاهي في ذلك اليوم؟

342
00:19:44,040 --> 00:19:45,200
..كلاّ

343
00:19:45,200 --> 00:19:49,200
لكنّنا ذهبنا إلى مدينة الملاهي
.في ذلك اليوم بالصّدفة

344
00:19:50,000 --> 00:19:51,960
!إذًا فهنّ لم يكتشفن الأمر

345
00:19:52,410 --> 00:19:55,930
هنالك الكثير من القرّاء الّذين يعتقدون
،أنّ "وينغ في" رجل

346
00:19:55,930 --> 00:20:00,790
لذلك لا أستطيع الذّهاب إلى أيّ تجمّعات
.أو احتفاليّات رسميّة أو جلسات تواقيع

347
00:20:00,790 --> 00:20:03,290
...فـ-فهمت

348
00:20:03,290 --> 00:20:08,340
.لذلك أبقي حقيقة أنّني "وينغ في" سرًّا رجاءً

349
00:20:08,780 --> 00:20:10,540
!بالطّبع

350
00:20:10,540 --> 00:20:13,100
...وأيضًا

351
00:20:13,100 --> 00:20:14,420
...لقد أسعدني هذا

352
00:20:16,500 --> 00:20:19,960
هذه أوّل مرّة يتسنّى لي فيها
.أن أستمع لرأي معجب مباشرة

353
00:20:20,430 --> 00:20:23,030
.شكرًا جزيلاً على دعمك

354
00:20:24,060 --> 00:20:25,780
!لا داعي لذلك

355
00:20:25,780 --> 00:20:29,200
الأستاذة الخالية من الأخطاء
...تحبّ الرّضفات

356
00:20:29,200 --> 00:20:30,330
...مهلاً

357
00:20:30,330 --> 00:20:33,010
ما خطب هذا النّقص؟

358
00:20:33,020 --> 00:20:35,450
أنتنّ الأربعة رسّامات مانغا؟

359
00:20:35,450 --> 00:20:39,000
لهذا السّبب أرى النّوم يغلبكنّ
.وتبدون متعبات للغاية

360
00:20:39,000 --> 00:20:40,760
!كان عليكنّ إخباري باكرًا

361
00:20:40,760 --> 00:20:43,240
.واضح أنّنا فوّتنا الوقت المناسب لذكر الأمر

362
00:20:43,240 --> 00:20:47,010
.نحن نعيش في مسكن معًا جميعًا

363
00:20:48,680 --> 00:20:50,410
...مسكن رسّامات مانغا

364
00:20:50,410 --> 00:20:54,640
أنا واثقة أنّ هنالك من أخبرني
...بأمر كهذا من قبل

365
00:20:56,070 --> 00:20:58,110
...مهلاً، إذًا فمديرة المسكن

366
00:20:58,110 --> 00:20:59,590
.نعم، إنّها أنا

367
00:20:59,590 --> 00:21:02,860
.ترتاد فتياتي مدرستك

368
00:21:02,860 --> 00:21:05,070
،إنّهنّ يبدون مشغولات كثيرًا
.لذلك اهتمّي بهنّ رجاءً

369
00:21:05,070 --> 00:21:06,520
!كان عليك إخباري يا غبيّة

370
00:21:06,520 --> 00:21:07,830
.آسفة، لقد نسيت تمامًا

371
00:21:10,480 --> 00:21:13,900
.أعتقد أنّ هويّتك الحقيقيّة قد اكتُشفت

372
00:21:13,900 --> 00:21:14,760
.نعم

373
00:21:14,760 --> 00:21:18,870
ربّما يعني ذلك أنّ نيجينو-سينسي
.ستتساهل معك

374
00:21:18,870 --> 00:21:19,940
.كلاّ، كلاّ

375
00:21:19,940 --> 00:21:23,450
.ما زال علينا أن نوازن بين رسم المانغا والدّراسة

376
00:21:23,450 --> 00:21:24,760
...نعم

377
00:21:24,760 --> 00:21:29,340
لكن لا أصدّق أنّ شخصًا مثل
...نيجينو-سينسي يحبّ المانغا

378
00:21:30,230 --> 00:21:32,180
!أعرف

379
00:21:32,180 --> 00:21:34,140
ما هو موضوعك اليوم؟

380
00:21:34,140 --> 00:21:35,840
."حسنًا. إنّه "النّقص

381
00:21:35,840 --> 00:21:38,060
.أعتقد أنّ تلك وجهة نظر ممتازة

382
00:21:38,060 --> 00:21:39,600
فعلاً؟

383
00:21:40,950 --> 00:21:46,580
،هذه الشّبح الوحيدة الجميلة في الحقيقة
،وذات البشرة الجذّابة والصّدر الكبير

384
00:21:46,580 --> 00:21:48,930
إضافة للأستاذة الجميلة الصّارمة
،جدًّا أثناء النّهار

385
00:21:48,930 --> 00:21:50,860
...ولكنّها معجبة بمانغا شونين

386
00:21:50,860 --> 00:21:52,260
.هي مواصفات شخصيّات ممتازة

387
00:21:52,260 --> 00:21:53,420
!نعم

388
00:21:53,420 --> 00:21:55,540
.لكنّ الأهمّ الآن هو القصّة

389
00:21:58,000 --> 00:22:00,110
.أعتقد أنّ هذه ستُرفض أيضًا

390
00:23:31,410 --> 00:23:33,640
!وجود شخص يعرف ما نمرّ به أمر رائع فعلاً

391
00:23:33,640 --> 00:23:34,350
!أعلم ذلك

392
00:23:34,350 --> 00:23:36,080
!أفهم ذلك تمامًا

393
00:23:36,080 --> 00:23:37,590
!إنّهما تتواصلان بعينيهما

394
00:23:37,590 --> 00:23:40,600
"!في الحلقة القادمة: "أهذا هو النّعيم؟