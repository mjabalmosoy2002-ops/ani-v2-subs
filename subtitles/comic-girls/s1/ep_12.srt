1
00:00:03,260 --> 00:00:03,980
ماذا؟

2
00:00:04,220 --> 00:00:06,970
أبلى الفصل الأوّل حسنًا؟

3
00:00:06,970 --> 00:00:07,800
!نعم

4
00:00:07,800 --> 00:00:10,490
قسم التّحرير بأكمله يتحدّث
!عن مدى تحسّنك

5
00:00:10,490 --> 00:00:12,950
قالوا أنّ خلفيّاتك تبدو رائعة
!والشّخصيّات الخلفيّة ظريفة

6
00:00:15,160 --> 00:00:16,580
...انتهيت

7
00:00:16,580 --> 00:00:19,610
.شكرًا على مساعدتي حتّى النّهاية

8
00:00:19,860 --> 00:00:22,130
...الأجزاء الّتي لم أرسمها بنفسي

9
00:00:25,490 --> 00:00:26,590
!أنا مُحرجة للغاية

10
00:00:26,590 --> 00:00:28,880
!يا لي من رسّامة مانغا فاشلة

11
00:00:28,880 --> 00:00:30,170
،كاوس-سينسي

12
00:00:30,170 --> 00:00:32,900
،بالكاد احترمتِ موعد التّسليم هذه المرّة

13
00:00:32,900 --> 00:00:35,840
لذلك احرصي على ألاّ تتأخّري
.في تسليم الفصل الثّاني

14
00:00:36,370 --> 00:00:37,670
كاوس-سينسي؟

15
00:00:38,180 --> 00:00:39,800
هل أنت بخير؟

16
00:00:40,140 --> 00:00:41,760
كاوس-سينسي؟

17
00:00:41,760 --> 00:00:44,010
!كاوس-سينسي؟

18
00:00:45,170 --> 00:00:48,430
سأكون صريحة معك
.وسأرفض هذا الفصل الثّاني

19
00:00:48,430 --> 00:00:52,320
.لقد حصلتِ أخيرًا على بقعة ضيفة لفصلين

20
00:00:52,520 --> 00:00:56,060
بوجود فصل ثانٍ كهذا، فلن نتمكّن
.حتّى من نشر الفصل الأوّل

21
00:00:56,830 --> 00:00:58,650
!أ-أنا آسفة

22
00:01:01,120 --> 00:01:02,450
،على هذا المعدّل

23
00:01:02,630 --> 00:01:06,080
.لن تستطيعين المواصلة كرسّامة مانغا

24
00:01:06,410 --> 00:01:09,280
.لن أضعك حتّى في مسكن جديد

25
00:01:14,580 --> 00:01:15,840
حلم؟

26
00:01:16,320 --> 00:01:17,180
!كلاّ

27
00:01:17,180 --> 00:01:19,260
!يمكن لذلك أن يكون واقعًا بكلّ سهولة

28
00:01:19,260 --> 00:01:21,340
.عليّ العمل بجهد أكبر في الفصل الثّاني أيضًا

29
00:01:21,750 --> 00:01:22,680
.كويومي-تشان

30
00:01:24,840 --> 00:01:26,170
...كويومي-تشان

31
00:01:27,270 --> 00:01:28,780
أما زلت نائمة؟

32
00:01:28,780 --> 00:01:30,850
...هذا ليس سيّئًا

33
00:01:31,320 --> 00:01:35,030
!حسنًا، ابتسمن جميعًا

34
00:01:37,500 --> 00:01:39,610
!ري-تشان، أرني، أرني

35
00:01:39,610 --> 00:01:41,820
.يبدو وجه كاوس-تشان غريبًا

36
00:01:41,820 --> 00:01:43,370
!لا تذكّريني رجاءً

37
00:01:46,780 --> 00:01:49,830
.بقيت لدينا عشرة أيّام فحسب في هذا المسكن

38
00:01:52,290 --> 00:01:57,010
أشعر بالوحدة لمجرّد التّفكير
.أنّني لن أراكنّ يا فتيات لبعض الوقت

39
00:01:57,440 --> 00:01:58,990
...نعم

40
00:01:59,290 --> 00:02:01,880
...سأكون سجينة في قصرها ثانية

41
00:02:01,880 --> 00:02:02,970
.أنت تتحدّثين عن منزلك

42
00:02:02,970 --> 00:02:06,090
،إنّ عيد مولد أبي وشيك

43
00:02:06,090 --> 00:02:08,820
لذلك سيكون عليّ مغادرة
.المسكن قبلكنّ جميعًا

44
00:02:09,050 --> 00:02:12,070
،سنذهب في رحلة عائليّة

45
00:02:12,070 --> 00:02:14,600
.لذلك قد أغادر المسكن باكرًا أيضًا

46
00:02:14,600 --> 00:02:15,300
!ماذا؟

47
00:02:15,300 --> 00:02:17,910
...عليّ أيضًا زيارة بعض القبور

48
00:02:19,710 --> 00:02:22,640
.لذلك سأذهب للمنزل اليوم

49
00:02:22,640 --> 00:02:23,770
...لقد

50
00:02:24,910 --> 00:02:27,000
.لقد فهمت

51
00:02:32,470 --> 00:02:34,400
متى ستذهبين للمنزل يا كاوس-تشان؟

52
00:02:34,400 --> 00:02:35,000
!ماذا؟

53
00:02:35,000 --> 00:02:37,100
!عـ-عمّ تتحدّثين؟

54
00:02:37,320 --> 00:02:39,670
هل أنت بخير يا كاوس-تشان؟

55
00:02:39,670 --> 00:02:40,970
.تبدين شاحبة

56
00:02:41,320 --> 00:02:43,560
هل يعقل أنّك تواجهين صعوبات
في فصلك الثّاني؟

57
00:02:46,020 --> 00:02:47,300
،مرّة أخرى

58
00:02:47,300 --> 00:02:49,200
...أشعر بالتوتّر، وبسبب كلّ هذا الضغط

59
00:02:49,200 --> 00:02:52,900
.لم أقم برسم ولو مربّع واحد بعد

60
00:02:52,900 --> 00:02:53,600
ماذا؟

61
00:02:53,600 --> 00:02:57,670
كاوس-تشان، عليك الأكل والابتهاج
!في أوقات كهذه

62
00:02:57,670 --> 00:02:58,200
!خذي

63
00:02:59,820 --> 00:03:01,330
...كويومي-تشان

64
00:03:02,650 --> 00:03:03,900
!كاوس-تشان؟

65
00:03:03,900 --> 00:03:06,000
...معدتي ليست في أحسن حال لأنّني متوتّرة

66
00:03:06,000 --> 00:03:07,180
!هل أنت بخير؟

67
00:03:07,180 --> 00:03:08,450
...نـ-نعم

68
00:03:08,450 --> 00:03:10,320
.لا تبدين بخير على الإطلاق

69
00:03:10,320 --> 00:03:12,320
!أنا قلقة

70
00:03:17,490 --> 00:03:20,300
ماذا تفعلين يا روكي-سان؟

71
00:03:20,460 --> 00:03:24,090
،عندما تواجهين مشاكل في مخطوطتك
.فأفضل شيء للقيام به هو التّحرّك

72
00:03:24,090 --> 00:03:25,800
.هيّا. جرّبي ذلك أيضًا

73
00:03:25,980 --> 00:03:27,770
.حـ-حسنًا

74
00:03:29,160 --> 00:03:31,880
!هيّا

75
00:03:31,880 --> 00:03:35,930
!هيّا! هيّا

76
00:03:35,930 --> 00:03:39,160
!هيّا! هيّا! هيّا! هيّا

77
00:03:36,360 --> 00:03:37,450
ما رأيك؟

78
00:03:37,450 --> 00:03:39,160
قلّ توتّرك، صحيح؟

79
00:03:39,160 --> 00:03:40,250
!نعم

80
00:03:40,250 --> 00:03:42,120
!أظنّ ذلك

81
00:03:42,450 --> 00:03:43,980
!جيّد

82
00:03:43,980 --> 00:03:47,950
!هيّا! هيّا! هيّا! هيّا

83
00:03:44,000 --> 00:03:48,200
أليس هذا هو التّدريب الّذي تقومين به دائمًا
لتكبير صدرك وتحسين انحناءات جسدك؟

84
00:03:48,200 --> 00:03:50,170
!كـ-كلاّ، ليس هو

85
00:03:50,580 --> 00:03:52,910
هل ستذهبين للرّكض يا تسوباسا-سان؟

86
00:03:52,910 --> 00:03:53,870
.نعم

87
00:03:54,170 --> 00:03:55,870
أتريدين أن ترافقيني يا كاوس؟

88
00:04:03,960 --> 00:04:06,140
.يمكنك الرّكض حسب وتيرتك

89
00:04:06,140 --> 00:04:09,510
من المهمّ لجسدك أن يستيقظ
.والضّغط على ذلك الزّرّ لتبدئي

90
00:04:09,510 --> 00:04:10,730
!أجل

91
00:04:11,310 --> 00:04:11,800
!هيّا بنا

92
00:04:12,520 --> 00:04:15,510
لن تكوني قادرة على هزيمة
!العدوّ بتدريب كهذا

93
00:04:15,970 --> 00:04:18,190
!يبدو أنّها ضغطت على زرّها

94
00:04:24,010 --> 00:04:26,350
.هذا لذيذ جدًّا يا كاوس-تشان

95
00:04:26,350 --> 00:04:29,210
،عندما لا يمكنك أكل الوجبات الخفيفة
!فعليك تناول طعام حقيقيّ

96
00:04:29,210 --> 00:04:32,290
،أعددتُ أطباقًا خفيفة على المعدة
.لذلك كلي ما تستطيعين

97
00:04:32,550 --> 00:04:34,880
.الجميع لطفاء للغاية

98
00:04:34,880 --> 00:04:38,010
.يبذلن كلّهنّ ما باستطاعتهنّ لإبهاجي

99
00:04:38,010 --> 00:04:40,800
!سآكل الكثير، وسأبذل جهدي في الرّسم

100
00:04:40,800 --> 00:04:41,880
هل تشعرين بالتّحفيز الآن؟

101
00:04:41,880 --> 00:04:43,340
!نعم

102
00:04:46,010 --> 00:04:49,600
أعتقد أنّني أشعر بتوتّر أقلّ الآن
.بفضل مساعدة الجميع

103
00:04:49,820 --> 00:04:51,000
...حسنًا

104
00:04:51,000 --> 00:04:52,480
!سأبذل جهدي أرسم

105
00:05:04,280 --> 00:05:08,080
،جسدي ليس متوتّرًا الآن
!لكنّ عقلي فارغ تمامًا

106
00:05:08,510 --> 00:05:12,380
ربّما لن أكون قادرة على النّجاح
!كرسّامة مانغا على الإطلاق

107
00:05:12,380 --> 00:05:13,980
!أنهيتُ حصّتي من العمل لليوم

108
00:05:13,980 --> 00:05:15,590
!أنت سريعة يا كويومي-تشان

109
00:05:15,590 --> 00:05:17,710
!موعد التّسليم يقترب وأنا متوتّر جدًّا

110
00:05:17,960 --> 00:05:21,210
هذه أوّل بقعة ضيفة من فصلين
تحظين بها، صحيح؟

111
00:05:21,210 --> 00:05:24,430
،سوف نساعدك جميعًا ثانية
!لذلك ابذلي جهدك

112
00:05:24,970 --> 00:05:26,660
!شكرًا جزيلاً لك

113
00:05:26,660 --> 00:05:27,800
—إن أمكننا جميعًا أن

114
00:05:27,800 --> 00:05:31,260
.مهلاً، لن ينفع ذلك
.أنا ذاهبة للمنزل غدًا في الحقيقة

115
00:05:32,310 --> 00:05:33,780
...جميعنا سوف

116
00:05:34,010 --> 00:05:36,520
...وسف نعمل... على... وصايا

117
00:05:36,520 --> 00:05:38,280
!سيعمل الجميع على وصايا؟

118
00:05:37,480 --> 00:05:38,270
...وصايا

119
00:05:43,370 --> 00:05:45,770
هل ستكونين بخير يا كاوس-تشان؟

120
00:05:45,770 --> 00:05:48,070
...أفضّل ألاّ أتركك بمفردك، لكن

121
00:05:48,360 --> 00:05:50,780
لن تذهبي للمنزل قريبًا؟

122
00:05:50,930 --> 00:05:54,970
...سـ-ستأتي أمّي لتقلّني، لذلك

123
00:05:54,970 --> 00:05:56,600
!أنا آسفة يا كاوس-تشان

124
00:05:56,600 --> 00:05:57,970
!كاوس-تشان

125
00:05:57,970 --> 00:05:59,580
...لا-لا بأس

126
00:05:59,580 --> 00:06:02,550
أنهيتنّ جميعًا مخطوطاتكنّ باكرًا

127
00:06:02,550 --> 00:06:05,210
.لتتمكّن من مغادرة المسكن في أيّ وقت

128
00:06:05,210 --> 00:06:06,880
.جميعكنّ رائعات

129
00:06:06,880 --> 00:06:08,280
.أنتنّ محترفات

130
00:06:08,280 --> 00:06:10,130
.تهتممن بشدّة بعائلاتكنّ

131
00:06:10,130 --> 00:06:12,240
.بالكاد يمكنني مجاراتكنّ

132
00:06:12,240 --> 00:06:15,190
.لا يمكنني حتّى التّفكير في نشر سلسلة متواصلة

133
00:06:15,560 --> 00:06:19,140
.أعرف تمام المعرفة كم أنتنّ رائعات

134
00:06:21,660 --> 00:06:23,170
!أنا جدّ آسفة

135
00:06:25,060 --> 00:06:27,190
.لا تقلقن أنفسكنّ بشخص مثلي رجاءً

136
00:06:27,190 --> 00:06:31,310
!وداعًا يا رسّامات المانغا الرّائعات

137
00:06:31,310 --> 00:06:32,480
،كاوس-تشان

138
00:06:32,480 --> 00:06:35,280
،على الأرجح أنّك تتصرّفين بجدّيّة الآن
لكن هل يمكنك توديعنا بشكل لائق؟

139
00:06:48,680 --> 00:06:50,520
!حـ-حسنًا

140
00:06:50,810 --> 00:06:54,380
!سيكون عليّ رسم الفصل الثّاني وحدي

141
00:06:54,870 --> 00:06:57,550
...لا-لا يمكنني الرّؤية

142
00:06:58,510 --> 00:07:01,620
جمعتُ شعري على شكل ذيل حصان
!لأحفّز نفسي، لكنّ ذلك لا ينفع

143
00:07:01,620 --> 00:07:02,920
.سأصفّف شعري على شكل ضفيرتين ثانية

144
00:07:09,380 --> 00:07:14,410
.يا لي من كائن مثير للشّفقة وأنا وحدي

145
00:07:15,480 --> 00:07:18,060
.مرحبًا، معك أميساوا

146
00:07:18,060 --> 00:07:20,620
.أردتُ التّحقّق من وضع الفصل الثّاني

147
00:07:21,370 --> 00:07:24,110
.آسفة... لم أنتهِ بعد

148
00:07:24,110 --> 00:07:28,220
.فهمت. لم يتبقّ الكثير من الوقت

149
00:07:28,220 --> 00:07:29,560
.تمالكي نفسك رجاءً

150
00:07:29,560 --> 00:07:30,800
.حـ-حسنًا

151
00:07:32,890 --> 00:07:34,250
كاوس-سينسي؟

152
00:07:34,250 --> 00:07:36,110
هل تشعرين بتوعّك؟

153
00:07:36,120 --> 00:07:36,940
هل أنت بخير؟

154
00:07:36,940 --> 00:07:38,540
...نعم، أنا آسفة

155
00:07:38,540 --> 00:07:42,980
.أظنّ أنّ قلبي في حالة فوضى الآن نوعًا ما

156
00:07:43,200 --> 00:07:44,010
قلبك؟

157
00:07:44,010 --> 00:07:45,690
...أعني الرّسم

158
00:07:46,820 --> 00:07:48,260
...أنا وحيدة

159
00:07:48,490 --> 00:07:50,300
هل تصبح غير مستقرّة عاطفيًّا؟

160
00:07:51,010 --> 00:07:52,380
!أ-أنا آسفة

161
00:07:52,380 --> 00:07:54,860
...لقد غادر الجميع

162
00:07:54,860 --> 00:07:57,210
...أنا وحدي... في غرفتي... وحزينة

163
00:07:57,210 --> 00:08:00,580
...لذلك لم أستطع الرّسم بطريقة ظريفة

164
00:08:01,370 --> 00:08:02,510
.حـ-حسنًا

165
00:08:02,510 --> 00:08:05,790
.لقد غادر الجميع المسكن سلفًا

166
00:08:06,810 --> 00:08:09,900
،لكن بما أنّني تحدّثت معك الآن

167
00:08:09,900 --> 00:08:12,780
.أشعر بتحسّن طفيف

168
00:08:12,780 --> 00:08:15,390
.مهلاً، لا تبدين في حالة جيّدة أبدًا

169
00:08:15,810 --> 00:08:19,850
أعتقد أنّ كاوس-سينسي لم تكن جاهزة
.عاطفيًّا لبقعة الضّيفة بفصلين

170
00:08:20,520 --> 00:08:24,310
عليّ تعديل الوضع في حالة ما إذا لم
.تستطع تسليم مخطوطتها في الوقت

171
00:08:24,310 --> 00:08:26,510
...أ-أنا آسفة

172
00:08:26,510 --> 00:08:27,520
ماذا أفعل؟

173
00:08:28,390 --> 00:08:31,700
،إنّ حقيقة قدوم موعد التّسليم لا محالة
،حتّى إن كنتُ أواجه وقتًا عصيبًا

174
00:08:31,700 --> 00:08:33,240
،تجعلني أشعر كأنّني رسّامة مانغا حقيقيّة

175
00:08:33,240 --> 00:08:34,840
.ممّا يجعلني سعيدة

176
00:08:34,840 --> 00:08:36,360
!أنا آسفة

177
00:08:36,360 --> 00:08:38,200
.ربّما سوف تكون بخير

178
00:08:38,570 --> 00:08:41,550
.حسنًا، سأكون بانتظارك، لذا ابذلي جهدك

179
00:08:41,550 --> 00:08:43,160
!حا-حاضرة

180
00:08:44,700 --> 00:08:46,190
!حسنًا

181
00:09:00,200 --> 00:09:04,400
...لقد غادر الجميع بالفعل

182
00:09:07,520 --> 00:09:09,450
.نياوس-سينسي

183
00:09:10,100 --> 00:09:14,810
بالتّفكير بالأمر، كانت القطط تلازمني
.دائمًا حتّى في منزلنا

184
00:09:15,250 --> 00:09:17,050
.لم أكن وحيدة

185
00:09:19,020 --> 00:09:20,290
!كلاّ

186
00:09:20,290 --> 00:09:21,610
!لا يمكنك اللّعب بمجسّماتي

187
00:09:31,290 --> 00:09:33,210
ما الخطب يا كاوروكو-تشان؟

188
00:09:33,210 --> 00:09:34,800
.تبدين محبطة

189
00:09:34,800 --> 00:09:36,300
فعلاً؟

190
00:09:36,300 --> 00:09:38,930
.عليك الابتسام دائمًا وأنت على الخشبة

191
00:09:38,930 --> 00:09:40,920
!نعم

192
00:09:40,920 --> 00:09:43,050
!هذه هي أنا الحقيقيّة

193
00:09:43,580 --> 00:09:46,230
،ألعب دائمًا مع مجسّماتي وحدي

194
00:09:46,230 --> 00:09:48,310
...وأغنّي أغاني أنمي

195
00:09:48,310 --> 00:09:51,130
!لذلك هذا عاديّ

196
00:09:51,130 --> 00:09:52,860
!هكذا أنا في العادة

197
00:09:52,860 --> 00:09:54,770
.كاوس-تشان، العشاء جاهز

198
00:09:55,060 --> 00:09:57,430
!أمّي— أعني مديرة المسكن

199
00:10:03,200 --> 00:10:05,990
،أنا الوحيدة هنا على العشاء

200
00:10:06,200 --> 00:10:09,090
.ومع ذلك فإنّه لذيذ ودافئ

201
00:10:09,090 --> 00:10:11,210
.أشعر أنّني في منزلي

202
00:10:11,210 --> 00:10:12,790
.بالطّبع

203
00:10:13,580 --> 00:10:16,300
.هذا لأنّني أمّك هنا

204
00:10:17,210 --> 00:10:19,450
...أمّـ— مديرة المسكن

205
00:10:19,450 --> 00:10:20,840
—أمّـ

206
00:10:22,470 --> 00:10:25,140
.أنا آسفة. لا تبكي

207
00:10:25,140 --> 00:10:27,770
.سوف تختنقين بسبب الطّعام

208
00:10:31,080 --> 00:10:33,610
.يبدو أنّه موعد نوم نياوس-تشان

209
00:10:33,610 --> 00:10:34,650
.على مهلك

210
00:10:34,650 --> 00:10:35,930
.أبليتِ حسنًا

211
00:10:36,690 --> 00:10:39,740
آسفة لأنّني لا أنفكّ عن إبداء
.شغفي بأصغر الأشياء

212
00:10:39,740 --> 00:10:41,130
.تعالي يا كاوس-تشان

213
00:10:53,860 --> 00:10:57,000
.عليّ مواصلة العمل بجدّ

214
00:11:04,380 --> 00:11:06,650
.كاوس-تشان، لديك زائرة

215
00:11:21,340 --> 00:11:23,850
!أ-أمّي

216
00:11:23,850 --> 00:11:25,070
!كاوس-سينسي

217
00:11:25,360 --> 00:11:26,740
ماذا تفعلين هنا؟

218
00:11:26,740 --> 00:11:28,580
.يفترض بك أن تقلّيني الأسبوع القادم

219
00:11:28,880 --> 00:11:29,350
ماذا؟

220
00:11:29,350 --> 00:11:31,450
.لا بدّ أنّني أخطأت في التّاريخ

221
00:11:31,450 --> 00:11:34,830
..."إذًا فأمّك تناديك "كاوس-سينسي

222
00:11:37,220 --> 00:11:40,470
هل الرّسّامات الأخريات لسن هنا؟

223
00:11:40,470 --> 00:11:43,220
،لقد عادت كلّ واحدة منهنّ لمنزلها

224
00:11:43,220 --> 00:11:45,370
.لذلك أنا وحدي هنا الآن

225
00:11:45,370 --> 00:11:47,770
.هذا مؤسف للغاية

226
00:11:48,230 --> 00:11:52,530
أحضرت الكثير من الصّور
.أردتُ أن أريها لهنّ

227
00:11:52,530 --> 00:11:53,360
صور؟

228
00:11:53,360 --> 00:11:54,540
.نعم، صور لكاوس-سينسي

229
00:11:54,540 --> 00:11:55,460
!أحضرتها معك؟

230
00:11:55,460 --> 00:11:56,560
!كم أودّ رؤيتها

231
00:11:56,560 --> 00:11:57,650
...هذه

232
00:11:59,660 --> 00:12:03,760
هذه كاوس-سينسي وقد سقطت بعد
.أن التفّ عليها حبل القفز

233
00:12:03,760 --> 00:12:04,850
.يا إلهي

234
00:12:05,240 --> 00:12:07,140
هذه كاوس-سينسي الّتي كانت
خائفة للغاية من الغيلان

235
00:12:07,140 --> 00:12:10,080
خلال مهرجان رمي الحبوب لدرجة
.أنّها أتت راكضة للمنزل من الحضانة

236
00:12:10,870 --> 00:12:14,330
هذه كاوس-سينسي الّتي لا تنفكّ
.عن إمساك الكينداما برأسها

237
00:12:14,500 --> 00:12:17,950
هذه كاوس-سينسي الّتي كانت ترتعد
.لأنّها كانت خائفة من بابا نويل

238
00:12:16,380 --> 00:12:18,510
.أعتقد أنّك كنت تبكين دائمًا

239
00:12:19,830 --> 00:12:23,510
لكنّ الوقت الوحيد الّذي توقّفت فيه
.عن البكاء هو عندما كانت ترسم

240
00:12:24,080 --> 00:12:27,950
.كنتُ سعيدة للغاية لأنّها وجدت شيئًا تحبّه

241
00:12:27,950 --> 00:12:29,420
...أمّي

242
00:12:29,720 --> 00:12:32,610
...كانت مركّزة للغاية

243
00:12:32,610 --> 00:12:35,400
!وقد كانت بارعة للغاية

244
00:12:35,400 --> 00:12:37,840
.المانغا خاصّتها هي الأفضل في العالم أيضًا

245
00:12:37,840 --> 00:12:40,810
!لقد أنجبتُ عبقريّة رائعة

246
00:12:40,810 --> 00:12:43,060
!لا تقولي ذلك أمام مديرة المسكن رجاءً

247
00:12:43,060 --> 00:12:47,200
كما أنّك أصبحت أفضل بكثير في
.عدد "كيوس" الّذي صدر البارحة

248
00:12:47,220 --> 00:12:49,340
.ذلك هو العدد الّذي يضمّ الفصل الأوّل

249
00:12:49,340 --> 00:12:54,660
كان جيّدًا للغاية لدرجة أنّني اشتريت
.الكثير ووزّعتها على الجيران

250
00:12:54,660 --> 00:12:58,020
"استمتعوا بهذا العدد من "كيرارا كيوس
.مع المانجو خاصّتكم

251
00:12:58,020 --> 00:12:58,920
.كم هذا لطيف

252
00:12:59,930 --> 00:13:01,820
!هذا محرج للغاية! توقّفي رجاءً

253
00:13:01,820 --> 00:13:03,620
.لكنّه جيّد جدًّا

254
00:13:03,620 --> 00:13:06,890
!هنالك العديد من الأشخاص أفضل منّي

255
00:13:06,890 --> 00:13:10,140
...وفوق ذلك، يعمل الجميع بجدّ

256
00:13:10,520 --> 00:13:12,400
...وأنا أستمرّ في التّراجع

257
00:13:12,400 --> 00:13:15,180
...حالفني الحظّ وحصلتُ على بدايتي فحسب

258
00:13:15,180 --> 00:13:17,820
...أنا... لست

259
00:13:18,490 --> 00:13:20,970
هل أصبح الرّسم يسبّب لك الألم أيضًا؟

260
00:13:23,160 --> 00:13:26,720
إن اشتدّت عليك الأمور، يمكنك العودة
.للمنزل يا كاوروكو-تشان

261
00:13:27,240 --> 00:13:29,900
هل تريدين مواصلة المحاولة

262
00:13:29,900 --> 00:13:31,970
رغم أنّ الأمر صعب لدرجة
أنّه يدفعك للبكاء؟

263
00:13:34,090 --> 00:13:36,920
.آسفة لكوني أنانيّة

264
00:13:37,340 --> 00:13:38,440
.فهمت

265
00:13:39,230 --> 00:13:41,530
!لقد كبرتِ كثيرًا

266
00:13:41,530 --> 00:13:43,340
!كنتِ صغيرة جدًّا

267
00:13:43,340 --> 00:13:44,890
!أ-أمّي

268
00:13:44,890 --> 00:13:46,860
!أنا لم أتغيّر أبدًا

269
00:13:52,330 --> 00:13:54,580
حسنًا، هل نعود للمنزل؟

270
00:13:58,800 --> 00:14:00,810
.سوف أبقى هنا لبعض الوقت

271
00:14:02,440 --> 00:14:03,900
لن تعودي للمنزل؟

272
00:14:04,280 --> 00:14:08,460
.ثمّة مخطوطة لم أنهها بعد

273
00:14:08,460 --> 00:14:10,460
،أريد إنهاءها بينما أنا هنا

274
00:14:10,460 --> 00:14:13,370
!بقوّتي أنا

275
00:14:17,420 --> 00:14:20,420
.في تلك الحالة، سأكون بانتظارك في المنزل

276
00:14:20,950 --> 00:14:22,240
ألا بأس بذلك؟

277
00:14:22,240 --> 00:14:23,120
.نعم

278
00:14:23,120 --> 00:14:25,770
.أهمّ شيء هو ما يريده رسّامو المانغا

279
00:14:26,740 --> 00:14:28,550
!شكرًا جزيلاً لك

280
00:14:38,760 --> 00:14:40,390
.سأبذل جهدي

281
00:14:44,420 --> 00:14:45,770
ماذا أفعل؟

282
00:14:45,770 --> 00:14:47,800
.ما زالت يدي تأبى التّحرّك

283
00:14:47,800 --> 00:14:50,890
...يومها، كان الجميع ما زال هنا

284
00:14:51,320 --> 00:14:52,530
!و-وجدتُها

285
00:14:52,840 --> 00:14:56,010
في أوقات كهذه، سأراجع
...الفصل الأوّل فحسب

286
00:15:01,020 --> 00:15:02,800
!سأذهب معك

287
00:15:02,800 --> 00:15:04,010
!أنا أيضًا

288
00:15:04,010 --> 00:15:06,120
ماذا نفعل غدًا؟

289
00:15:11,640 --> 00:15:14,600
.إنّها مليئة بالسّعادة

290
00:15:14,980 --> 00:15:16,350
!كلاّ

291
00:15:16,350 --> 00:15:19,490
.لقد سمحتُ للمانغا خاصّتي أن تبكيني

292
00:15:20,060 --> 00:15:24,060
لا أصدّق أنّني رسمت عالمًا حالمًا
.كهذا بدون وعي منّي

293
00:15:25,290 --> 00:15:30,030
ليس من المسلّمات امتلاك
.أصدقاء حولي يتقبّلونني

294
00:15:30,490 --> 00:15:36,100
تمكّني من رسم المانغا في كلّ يوم
.هو معجزة بحدّ ذاتها

295
00:15:42,580 --> 00:15:44,080
...كويومي-تشان

296
00:15:44,080 --> 00:15:45,290
!صحيح

297
00:15:45,290 --> 00:15:48,590
"لقد اشتريتُ عدد "كيرارا
!الّذي يضمّ المانغا خاصّتك

298
00:15:49,500 --> 00:15:52,350
وجدتِ الوقت لتشتريه وأنت
في طريقك للمنزل؟

299
00:15:52,350 --> 00:15:54,220
!أنت ملاك حقيقيّ يا كويومي-تشان

300
00:15:56,930 --> 00:15:58,340
!إنّها تستحمّ؟

301
00:16:02,730 --> 00:16:04,730
.تسوباسا-سان وروكي-سان أيضًا

302
00:16:05,170 --> 00:16:07,000
!أريد التّعبير عن مشاعري الآن

303
00:16:07,980 --> 00:16:10,330
.يمكنني رؤية وجوه الجميع

304
00:16:10,330 --> 00:16:11,460
.لا بأس

305
00:16:11,460 --> 00:16:12,940
.نحن معًا

306
00:16:13,200 --> 00:16:15,650
!لا بأس... سأبذل جهدي

307
00:16:50,060 --> 00:16:52,040
.أبليتِ حسنًا

308
00:17:21,440 --> 00:17:24,980
.يا مديرة المسكن، شكرًا على كلّ شيء

309
00:17:24,980 --> 00:17:27,450
أنا سعيدة لتمكّنك من إنهاء كلّ
.شيء دون مشاكل

310
00:17:27,450 --> 00:17:29,290
هل ستقومين بتسليمها الآن؟

311
00:17:29,290 --> 00:17:31,440
.كلاّ، لقد أرسلتها بالبريد الإلكترونيّ

312
00:17:31,800 --> 00:17:33,970
.لا بدّ أنّ ذلك كان صعبًا

313
00:17:33,970 --> 00:17:36,160
.قمتِ بهذا وحدك. أنا فخورة بك

314
00:17:37,290 --> 00:17:40,680
لكنّني أوشكت أن أشعر وكأنّني رسّامة
،مانغا محبوبة للغاية

315
00:17:40,680 --> 00:17:42,220
.لذلك كان ذلك ممتعًا

316
00:17:42,220 --> 00:17:43,370
...فـ-فهمت

317
00:17:44,760 --> 00:17:46,890
.حسنًا، سأغادر الآن

318
00:17:49,580 --> 00:17:51,120
.اهتمّي بنفسك

319
00:17:56,890 --> 00:17:58,090
...والآن

320
00:17:59,480 --> 00:18:01,600
.عليّ الاستعداد أيضًا

321
00:18:15,760 --> 00:18:17,820
!نسيتُ وضعه على الوضع الصّامت

322
00:18:17,820 --> 00:18:18,680
مرحبًا؟

323
00:18:18,680 --> 00:18:21,660
.كاوس-سينسي، وصلتني مخطوطتك

324
00:18:21,660 --> 00:18:23,280
.كان ذلك في آخر لحظة

325
00:18:23,280 --> 00:18:24,930
!أنا جدّ آسفة

326
00:18:24,930 --> 00:18:28,780
عليك إصلاح عادة التّأخّر عندما يكون
.لديك موعد تسليم

327
00:18:28,780 --> 00:18:30,160
!أ-أنا آسفة

328
00:18:30,160 --> 00:18:32,520
!أنا جدّ آسفة بالفعل

329
00:18:32,970 --> 00:18:34,760
.لكنّها كانت رائعة

330
00:18:37,180 --> 00:18:38,820
...عـ-عفوًا

331
00:18:38,820 --> 00:18:40,220
ماذا قلتِ؟

332
00:18:40,440 --> 00:18:43,930
.إنّها مانغا جيّد للغاية

333
00:18:47,120 --> 00:18:50,390
.لقد تحسّن رسمك والقصّة كانت مثيرة للاهتمام

334
00:18:51,010 --> 00:18:52,000
كانت هنالك لحظة

335
00:18:52,000 --> 00:18:56,630
ظننتُ فيها أنّه ربّما كان من المبّكر لك
.الحصول على بقعة ضيفة بفصلين

336
00:18:57,090 --> 00:18:59,850
لكنّني سعيدة للغاية
.لأنّك تمكّنتِ من تحقيق هذا

337
00:19:00,240 --> 00:19:02,390
لقد رأيتُ هويّتك في عملك
،هذا أكثر من غيره

338
00:19:03,260 --> 00:19:06,280
.وأعتقد أنّ هذه أفضل مخطوطة لك حتّى الآن

339
00:19:10,510 --> 00:19:12,170
مرحبًا؟

340
00:19:12,360 --> 00:19:14,620
كاوس-سينسي؟ أيمكنك سماعي؟

341
00:19:20,140 --> 00:19:23,200
!نـ-نعم! يمكنني ذلك

342
00:19:35,640 --> 00:19:36,700
كويومي-تشان؟

343
00:20:01,160 --> 00:20:02,400
...أنا ممتنّة جدًّا

344
00:20:03,220 --> 00:20:05,010
...لتمكّني

345
00:20:05,750 --> 00:20:07,590
...من اختبار

346
00:20:08,280 --> 00:20:10,490
.عالم لطيف كهذا

347
00:21:38,140 --> 00:21:39,980
.يا كاوس-سينسي

348
00:21:51,160 --> 00:21:54,240
...لا-لا يمكنني... التّنفّس

349
00:21:56,360 --> 00:21:57,330
...لكن

350
00:21:58,090 --> 00:22:00,700
.أستطيع أخيرًا رؤية الجميع

351
00:22:00,700 --> 00:22:03,020
!لا أطيف الانتظار حتّى أراهنّ

352
00:22:11,660 --> 00:22:14,220
!أجل! إنّه لامع جدًّا

353
00:22:18,190 --> 00:22:20,660
!كاوس-تشان

354
00:22:20,660 --> 00:22:23,370
كويومي-تشان! لقد اشتقت لك

355
00:22:23,370 --> 00:22:25,220
!وأنا أيضًا

356
00:22:25,220 --> 00:22:26,570
!لنبذل جهدنا معًا ثانية

357
00:22:26,570 --> 00:22:27,970
—نعم! لنبذل

358
00:22:27,970 --> 00:22:29,570
!كاوس-تشان

359
00:22:29,940 --> 00:22:31,900
.أنا سعيدة لرؤيتك على أحسن حال

360
00:22:34,110 --> 00:22:36,060
...جسدي... التّعب

361
00:22:36,060 --> 00:22:38,120
!لم تكن بخير على الإطلاق

362
00:22:39,990 --> 00:22:40,860
...لكن

363
00:22:41,730 --> 00:22:43,390
.عدنا معًا جميعًا

364
00:22:43,390 --> 00:22:44,360
.نعم

365
00:22:44,860 --> 00:22:48,680
.المعذرة... تبدين متعبة قليلاً يا تسوباسا-سان

366
00:22:48,680 --> 00:22:51,450
.لقد حرّرني السّيّد الشّيطان أخيرًا

367
00:22:51,450 --> 00:22:54,260
.إنّها هكذا دائمًا عندما تعود لمنزلها

368
00:22:54,260 --> 00:22:56,410
كيف المانغا خاصّتك يا كاوس-تشان؟

369
00:22:57,010 --> 00:22:58,310
،فـ-في الحقيقة

370
00:22:58,310 --> 00:23:00,730
لقد استمرّ رفض مخطوطاتي
،الواحدة تلو الأخرى

371
00:23:00,730 --> 00:23:03,580
لذلك ما زلت بعيدة كلّ البعد
.عن سلسلة متواصلة

372
00:23:03,580 --> 00:23:05,980
،كلّما كان الدّرب طويلاً
!كان السّعي خلفه جديرًا أكثر

373
00:23:06,890 --> 00:23:08,440
...وكلّما كان السّعي خلفه جديرًا أكثر

374
00:23:08,880 --> 00:23:11,180
.زادت صعوبة الدّرب

375
00:23:11,180 --> 00:23:12,800
.لقد أعادت تشكيل الجملة

376
00:23:12,800 --> 00:23:14,650
.تعود تسو-تشان إلى سابق عهدها

377
00:23:15,900 --> 00:23:17,230
.يا فتيات

378
00:23:20,070 --> 00:23:21,630
.مرحبًا بعودتكنّ

379
00:23:21,630 --> 00:23:23,590
!ري-تشان، لقد عدنا

380
00:23:24,580 --> 00:23:26,210
!حسنًا، لنرسم بعض المانغا

381
00:23:29,230 --> 00:23:30,440
!أجل