1
00:00:02,420 --> 00:00:03,240
.أنت

2
00:00:06,100 --> 00:00:08,380
.يمكنك التحليق أعلى

3
00:00:12,840 --> 00:00:14,790
!شويو

4
00:00:15,150 --> 00:00:16,730
.أهلًا

5
00:00:16,730 --> 00:00:18,430
.أهلًا يا كاغياما

6
00:00:18,750 --> 00:00:20,350
!مرحبًا

7
00:00:20,350 --> 00:00:22,590
هل أنتما بخيرٍ يا هيناتا وكاغياما؟

8
00:00:22,590 --> 00:00:24,060
.أهلًا يا سوغاوارا-سان

9
00:00:24,060 --> 00:00:24,960
.أهلًا

10
00:00:24,960 --> 00:00:27,000
.يا أهلًا بكما

11
00:00:27,000 --> 00:00:30,860
.يستحسن ألَّا تتشاجرا بمجرد عودتكما

12
00:00:30,860 --> 00:00:34,860
.لا، لقد كانا يتشاجران سلفًا عندما أحضرت المفتاح

13
00:00:34,860 --> 00:00:36,320
.حدث هذا سريعًا

14
00:00:36,320 --> 00:00:38,220
،على كلٍّ

15
00:00:38,220 --> 00:00:40,650
هذه سجيتكما، صحيح؟

16
00:00:41,440 --> 00:00:44,670
كيف كان معسكر تدريب الشباب يا كاغياما؟

17
00:00:44,670 --> 00:00:48,230
أجل، هذه هي! كيف كانت كافة اليابان؟

18
00:00:49,560 --> 00:00:51,640
.الأرضية لم تكن مصنوعةً من الألواح الخشبية

19
00:00:51,640 --> 00:00:53,010
أتتحدث عن الملعب؟

20
00:00:53,010 --> 00:00:57,360
كيف كانت كرة الطائرة هناك؟ اجتمع العديد من اللاعبين البارعين من كافة الأرجاء، صحيح؟

21
00:00:57,360 --> 00:00:59,470
.نعم، جميعهم كانوا بارعين

22
00:00:59,470 --> 00:01:01,810
.هذه هي، أخبرنا المزيد عنهم

23
00:01:01,810 --> 00:01:05,440
ألم تحاول التسلل لمعسكر تدريب شباب كافة اليابان يا هيناتا؟

24
00:01:05,440 --> 00:01:07,220
...لـ- لا

25
00:01:07,220 --> 00:01:09,950
.سيقبض عليه إذا حاول، لذا يبدو أنه تخلى عن الفكرة

26
00:01:09,950 --> 00:01:11,030
يقبض عليه؟

27
00:01:11,500 --> 00:01:12,620
.تسوكيشيما

28
00:01:12,620 --> 00:01:16,370
.كان يخطط في الواقع للتسلل لمعسكر طوكيو

29
00:01:17,290 --> 00:01:19,450
.أحسنت الكفاح يا شويو

30
00:01:21,050 --> 00:01:23,720
هل كبرت أنتَ أيضًا في المعسكر يا تسوكيشيما؟

31
00:01:23,720 --> 00:01:26,020
...نعم، أظن هذا

32
00:01:25,240 --> 00:01:26,760
هل زاد طولك؟

33
00:01:26,760 --> 00:01:28,080
هل أنتَ عمتهُ أم ماذا؟

34
00:01:28,080 --> 00:01:30,170
.كما لو أنه سيزداد طولًا في خمسة أيام

35
00:01:30,530 --> 00:01:31,520
!أهلًا

36
00:01:31,520 --> 00:01:32,750
.أهلًا

37
00:01:35,480 --> 00:01:38,140
.آ-آسف على كل المتاعب التي سببتها

38
00:01:39,470 --> 00:01:42,910
.حتى لو بقيت هنا، فلن يكون لكَ نفعٌ بمفردك

39
00:01:44,360 --> 00:01:45,660
!اصمت

40
00:01:45,660 --> 00:01:48,030
!لا داعي لتذكيري بهذا في كل مرة

41
00:01:48,030 --> 00:01:50,560
.قلتها مرةً واحدةً فقط

42
00:01:50,560 --> 00:01:53,080
هل زاد طولكَ يا تسوكي؟

43
00:01:53,080 --> 00:01:54,780
.اصمت يا ياماغوتشي

44
00:01:54,780 --> 00:01:57,800
.كان المكان هادئًا في الأيام القليلة الماضية

45
00:01:57,800 --> 00:01:59,240
.أجل

46
00:02:00,480 --> 00:02:03,430
.شجارهم يُشعرني بالراحة

47
00:03:48,280 --> 00:03:49,360
.سأساعدكِ

48
00:03:49,360 --> 00:03:50,580
.شكرًا

49
00:03:52,340 --> 00:03:53,190
في هذا المكان؟

50
00:03:53,190 --> 00:03:54,120
.نعم

51
00:03:55,450 --> 00:03:58,080
ما الغرض من هذا الشريط يا ياتشي-سان؟

52
00:03:58,080 --> 00:04:00,650
.سنقسم الشبكة لتسعة أقسام

53
00:04:01,060 --> 00:04:04,390
،كان أعضاء الفريق يتدربون على الإرسال طيلة الأسبوع الماضي

54
00:04:04,390 --> 00:04:09,660
.وأوكاي-سان يريدهم أن يتأكدوا لأي اتجاهٍ يريدون الإرسال له

55
00:04:10,270 --> 00:04:14,050
.مثل رؤية ما يحدث وأين ستسقط الكرة عندما يضربونها لذاك المكان

56
00:04:21,580 --> 00:04:23,330
...سبعون بالمئة

57
00:04:28,440 --> 00:04:29,630
.أحسنت التصويب

58
00:04:29,630 --> 00:04:31,100
.أجل

59
00:04:40,690 --> 00:04:41,720
!مباشرة

60
00:04:41,720 --> 00:04:43,780
.لقد تلقَّاها بسهولة

61
00:04:54,330 --> 00:04:57,240
.نيشينويا-كن لم يتمكن من استقبالها

62
00:04:57,240 --> 00:05:00,360
.نيشينويا لا يجيد الاستقبالات من فوق مستوى الكتف

63
00:05:01,130 --> 00:05:05,610
أما كان يستطيع استقبالها من الأسفل كالعادة فحسب؟

64
00:05:05,610 --> 00:05:09,050
.يصعب استقبال الإرسالات العائمة القافزة لأنه لا يمكن توقعها

65
00:05:09,500 --> 00:05:14,980
.أنجع طريقةٍ لقهرها هي التموضع للأمام وتلقيها بتمريرةٍ عالية

66
00:05:14,980 --> 00:05:21,380
.هناك احتمالٌ كبيرٌ أننا سنواجه خصومًا أقوياء بوسعهم استخدام الإرسال العائم القافز

67
00:05:21,380 --> 00:05:24,690
.لا ضرر من إيجاد المزيد من الطرق لإيقافه

68
00:05:26,600 --> 00:05:28,350
.أحسنتَ الإرسال يا كينوشتا

69
00:05:28,350 --> 00:05:29,190
أليس كذلك؟

70
00:05:29,190 --> 00:05:30,350
ماذا عنك يا ناريتا؟

71
00:05:30,350 --> 00:05:33,410
.سأقوم بالإرسالات العائمة العادية

72
00:05:34,750 --> 00:05:35,860
...أنا أيضًا

73
00:05:42,410 --> 00:05:43,460
.خارج الملعب

74
00:05:46,160 --> 00:05:48,430
.ياماغوتشي متحمسٌ حقًا

75
00:06:07,340 --> 00:06:09,070
.لم أضربها بالقوة التي أريدها

76
00:06:09,660 --> 00:06:10,800
هل ستتجه للخارج؟

77
00:06:26,330 --> 00:06:31,220
،هناك أوقاتٌ يقوم فيها هيناتا بحركاتٍ خارقة

78
00:06:32,040 --> 00:06:33,890
...لكن ما فعله للتو

79
00:06:34,220 --> 00:06:36,810
.بدا وكأنه أمرٌ طبيعي

80
00:06:38,960 --> 00:06:40,600
.أحسنتم صنعًا

81
00:06:40,600 --> 00:06:42,530
.يبدو أنها ستثلج الليلة

82
00:06:42,530 --> 00:06:43,760
حقًا؟

83
00:06:43,760 --> 00:06:45,110
.كاغياما

84
00:06:45,660 --> 00:06:47,530
ما الذي عنيتهُ بـ"التحليق للأعلى"؟

85
00:06:54,130 --> 00:06:56,040
أنتما متعبان من المخيم التدريبي، أليس كذلك؟

86
00:06:56,570 --> 00:06:58,870
.يمنع عليكما إجهاد نفسيكما

87
00:06:59,180 --> 00:07:01,270
.قـ- قليلًا فحسب

88
00:07:01,270 --> 00:07:03,020
.قليلًا فقط

89
00:07:03,020 --> 00:07:04,180
.أجل

90
00:07:08,920 --> 00:07:11,770
."قفزاتك دائمًا ما تكون مثل "بيون، بيون

91
00:07:11,770 --> 00:07:12,760
!ماذا؟

92
00:07:13,180 --> 00:07:15,250
...ولكن القفزات الرائعة

93
00:07:16,720 --> 00:07:17,980
."تكون مثل "دون

94
00:07:20,280 --> 00:07:22,880
.مهمتك هي الركض في الأرجاء أساسًا

95
00:07:22,880 --> 00:07:23,900
!لا تصغ الأمر كهذا

96
00:07:24,320 --> 00:07:28,310
."لذا، تقفز نزوةً مثل "بيون، بيون

97
00:07:28,310 --> 00:07:31,860
.الأمر كسابقه، لكن نبرة صوتهِ مختلفة

98
00:07:32,360 --> 00:07:34,370
،كنت تقفز بقدر الإمكان

99
00:07:34,370 --> 00:07:37,060
.ومتأكد أنك تبذل قصارى جهدك في المباريات

100
00:07:37,060 --> 00:07:37,950
...لكن

101
00:07:38,940 --> 00:07:40,890
.أعلم أنه يمكنك القفز للأعلى أكثر

102
00:07:42,290 --> 00:07:46,550
أين تضع ثقلك عندما تقفز؟

103
00:07:46,550 --> 00:07:47,750
أين؟

104
00:07:49,970 --> 00:07:50,970
قدماي؟

105
00:07:51,280 --> 00:07:53,930
!أقصد مكانًا آخر عدا قدميك أيها الأحمق

106
00:07:53,930 --> 00:07:55,950
!لم أفكر بهذا الموضوع من قبل

107
00:07:55,950 --> 00:07:59,880
ماذا؟ أكنتَ تقفز لكل ذلك الارتفاع دون وعي أيها المغفل؟

108
00:07:59,880 --> 00:08:02,190
ماذا؟ لماذا توبخني؟

109
00:08:06,450 --> 00:08:10,940
.تمنحك القفزات العالية والمتسقة حريةً أكثر للرد وأنت في الجو

110
00:08:11,620 --> 00:08:14,240
،وعندما تقوم بتلك القفزات

111
00:08:14,590 --> 00:08:16,590
.تسمع صدى ضرب قدميك للأرضية

112
00:08:19,780 --> 00:08:23,620
أتظن أنهما سيستمران "لوقتٍ قليلٍ" فقط؟

113
00:08:23,620 --> 00:08:25,750
.يبدو أنها ستثلج في أيِّ لحظة

114
00:08:26,250 --> 00:08:29,600
أتصدق أنهما سيقومان بالأمر "لوقتٍ وجيزٍ" فقط يا دايتشي؟

115
00:08:29,600 --> 00:08:31,230
.اصمت

116
00:08:31,230 --> 00:08:34,180
عجبًا، أين هيناتا وكاغياما؟

117
00:08:34,520 --> 00:08:36,540
.قالا أنهما سيستمران لوقتٍ أطول قليلًا

118
00:08:36,540 --> 00:08:38,480
.مذهل

119
00:08:38,480 --> 00:08:39,180
ما هو؟

120
00:08:39,840 --> 00:08:42,620
،أفهم شعور الرغبة للذهاب لمعسكرٍ تدريبي

121
00:08:42,620 --> 00:08:44,980
.ولكنني أفضل بعض الراحة بعدها

122
00:08:44,980 --> 00:08:47,150
لأي مدًى يحبان كرة الطائرة؟

123
00:08:49,050 --> 00:08:50,110
...لكن

124
00:08:51,030 --> 00:08:57,590
أأنا الوحيد الذي يظن أنا كاغياما متجهمٌ منذ أن عاد؟

125
00:08:58,710 --> 00:08:59,810
!مرةً أخرى

126
00:09:03,510 --> 00:09:06,000
.أجل، هذا مذهلٌ حقًا

127
00:09:06,370 --> 00:09:08,680
.الارتفاع والموضع مثاليان

128
00:09:08,680 --> 00:09:10,650
.ويقوم بفعلها كل مرة

129
00:09:10,650 --> 00:09:12,760
.إنهُ بارعٌ حقًا

130
00:09:14,200 --> 00:09:14,760
!أنت

131
00:09:15,130 --> 00:09:16,510
!قفزتك تنحرف مجددًا

132
00:09:18,390 --> 00:09:21,030
.ضع كلَّ ثقلكَ على مقدمة قدمك

133
00:09:21,030 --> 00:09:23,950
.هناك فرقٌ كبيرٌ عندما تفكر بهذا حقًا

134
00:09:30,590 --> 00:09:31,830
...مقدمة قدمي

135
00:09:31,830 --> 00:09:34,760
...ركز على زخم التقدم، بعدها

136
00:09:38,090 --> 00:09:39,230
!اقفز

137
00:09:40,860 --> 00:09:42,080
!غادرا

138
00:10:03,370 --> 00:10:04,810
!إنهاءٌ رائع

139
00:10:07,050 --> 00:10:08,000
أمن خطبٍ ما؟

140
00:10:08,000 --> 00:10:09,540
.لا

141
00:10:09,540 --> 00:10:10,770
...يبدو الأمر

142
00:10:11,580 --> 00:10:17,530
كما لو أن هناك أوقاتًا يصبح فيها هيناتا هادئًا
.للغاية منذ عودته من المعسكر التدريبي

143
00:10:19,110 --> 00:10:20,140
...أظن

144
00:10:28,140 --> 00:10:30,080
.أنا أقفز كما ينبغي

145
00:10:30,080 --> 00:10:31,170
حقًا؟

146
00:10:31,170 --> 00:10:33,000
.ربما كنت أتخيل إذن

147
00:10:40,090 --> 00:10:40,840
.كاغياما

148
00:10:42,500 --> 00:10:43,310
نعم؟

149
00:10:44,930 --> 00:10:49,850
...سمعت عن مجريات معسكر تدريب الشباب فنيًا

150
00:10:49,850 --> 00:10:51,110
كيف كان؟

151
00:10:52,240 --> 00:10:55,550
أعني... أهناك ما يزعجك؟

152
00:10:56,470 --> 00:10:57,470
.لا

153
00:10:57,470 --> 00:10:58,780
.فهمت

154
00:11:02,170 --> 00:11:05,470
ما معنى "الشخص العفيف" برأيك؟

155
00:11:07,640 --> 00:11:09,330
أحدهم دعاك بهذا إذن؟

156
00:11:09,330 --> 00:11:10,210
.نعم

157
00:11:10,210 --> 00:11:11,930
.مُعدٌّ آخر في المعكسر قال لي هذا

158
00:11:14,170 --> 00:11:18,130
.كما هو متوقعٌ من معسكر الشباب، هناك بعض الأوغاد فيه

159
00:11:25,580 --> 00:11:28,520
.هذا ما اعتاد جدي قولهُ لنا دائمًا

160
00:11:29,780 --> 00:11:32,650
،أنا متأكدٌ من أنك تفعل هذا

161
00:11:33,980 --> 00:11:37,030
.لذا لا داعي للتردد

162
00:11:44,130 --> 00:11:46,480
.سيصلون في أيِّ لحظة

163
00:11:46,480 --> 00:11:47,660
.أجل

164
00:11:48,380 --> 00:11:50,870
لست خائفًا بعد الآن، أليس كذلك يا آساهي-سان؟

165
00:11:55,040 --> 00:11:57,050
.ما كنت سأطلب منافسًا أفضل منهم

166
00:12:00,380 --> 00:12:02,550
.هناك شيءٌ أود تجربته كذلك

167
00:12:02,550 --> 00:12:03,470
ماذا؟

168
00:12:36,420 --> 00:12:37,500
!شكرًا على استضافتنا

169
00:12:37,790 --> 00:12:39,410
!شكرًا

170
00:12:43,470 --> 00:12:46,130
.إنهم مرعبون كالعادة

171
00:12:49,760 --> 00:12:51,470
.لا داعي لتحديد أحدهم

172
00:12:52,180 --> 00:12:53,810
!هيناتا

173
00:12:53,810 --> 00:12:55,700
!كوغاني

174
00:12:55,700 --> 00:12:57,310
!تسوكي

175
00:12:58,850 --> 00:13:01,940
.شكرًا على قدومكم اليوم

176
00:13:01,940 --> 00:13:04,400
.مباركٌ وصولكم لبطولة الربيع

177
00:13:04,400 --> 00:13:06,830
.جميع لاعبينا متحمسون

178
00:13:06,830 --> 00:13:08,180
!شكرًا

179
00:13:08,180 --> 00:13:09,830
.نتطلع قدمًا لمنافستكم

180
00:13:15,750 --> 00:13:19,000
.يستحسن بكَ ألا تتراخى لمجرد أنها مباراةٌ تدريبية

181
00:13:19,000 --> 00:13:20,960
!أجل، بالطبع

182
00:13:33,630 --> 00:13:34,800
!تجمعوا

183
00:13:36,740 --> 00:13:40,240
.حاجز صد داتيكو هو الأفضل في المحافظة بلا شك

184
00:13:40,240 --> 00:13:43,650
.وواحد من بين الأوائل على صعيد البلاد كذلك

185
00:13:43,650 --> 00:13:47,360
.سمعت أنهم أصبحوا أفضل منذ تصفيات بطولة الربيع

186
00:13:47,890 --> 00:13:53,330
.لا وقت لدينا بالطبع لكي يصل صدنا لمستواهم

187
00:13:54,140 --> 00:13:55,100
.انصتوا

188
00:13:55,100 --> 00:13:59,380
.صد داتيكو أصبح أفضل في الأشهر الستة الماضية

189
00:13:59,380 --> 00:14:00,840
.اعتادوا على تلك الجدران

190
00:14:01,660 --> 00:14:06,140
.بهذه الطريقة لن تصابوا بالذعر عندما تواجهون جدرانًا مشابهةً في البطولة الوطنية

191
00:14:06,760 --> 00:14:08,160
!أجل

192
00:14:46,850 --> 00:14:48,590
!لنلعب

193
00:14:53,080 --> 00:14:53,760
!نيشينويا

194
00:14:53,760 --> 00:14:54,890
!إنها لي

195
00:14:58,350 --> 00:15:00,280
!هيناتا سريع

196
00:15:00,280 --> 00:15:02,060
أهو الهجوم المشهور فائق السرعة؟

197
00:15:12,950 --> 00:15:13,620
...حزمةٌ

198
00:15:15,730 --> 00:15:17,310
!من الصدِّ القارئ

199
00:15:24,740 --> 00:15:29,470
.هجومنا الخلفي السريع يستجيب له صادٌّ واحد عادةً

200
00:15:29,770 --> 00:15:31,900
.دون ذكر أن هيناتا كان طُعمًا لهم

201
00:15:34,040 --> 00:15:37,250
.لديهم ثلاثةٌ في حاجز الصد

202
00:15:38,830 --> 00:15:40,430
!جميعهم قاموا بالصد

203
00:15:40,430 --> 00:15:41,900
!ردة فعلهم سريعة

204
00:15:46,240 --> 00:15:48,810
،كما فعل تسوكيشيما تمامًا أثناء مباراتنا ضد شيراتوريزاوا

205
00:15:49,690 --> 00:15:54,620
.الصد المحكم لا يشكل ضغطًا على الضارب فقط، بل على المعدِّ كذلك

206
00:15:55,680 --> 00:15:57,080
،بالنسبة لكاغياما

207
00:15:57,650 --> 00:16:01,150
.ربما تكون هذه مباراةً أصعب من التي خاضها ضد شيراتوريزاوا

208
00:16:02,360 --> 00:16:04,000
!أجل

209
00:16:04,000 --> 00:16:05,860
!لقد فعلناها

210
00:16:07,140 --> 00:16:09,230
هلَّا قمت بالسخرية منا؟

211
00:16:16,650 --> 00:16:18,480
...ثلاثةٌ في حاجز الصد

212
00:16:18,480 --> 00:16:25,120
.متأكدٌ أن كاغياما أراد تخطي ثلاثي الصد العالي ذاك من أول محاولة

213
00:16:25,120 --> 00:16:26,670
.يا لهُ من وقح

214
00:16:26,670 --> 00:16:29,730
.يبدو أنه بالغ في المحاولة

215
00:16:30,770 --> 00:16:34,370
.كنت متأكدًا من أنهم سيتابعون هيناتا

216
00:16:35,430 --> 00:16:36,890
...لنرَ

217
00:16:36,890 --> 00:16:41,020
.الطريقة التي يقوم بها حاجز صد داتيكو بالقفز تعرف بالصد القارئ

218
00:16:44,250 --> 00:16:45,880
...وتشكيلتهم

219
00:16:46,360 --> 00:16:48,510
إنهم يستخدمون الحزمة المتنقلة، أليس كذلك؟

220
00:16:49,240 --> 00:16:50,200
.بلى

221
00:16:50,200 --> 00:16:52,340
.الحزمة تحمل المعنى نفسه

222
00:16:53,000 --> 00:16:58,700
بالنسبة للحزمة المتنقلة، الصادون يتجمعون في المنتصف
،لكي يتمكنوا من التحرك كلما أراد الخصم الهجوم

223
00:16:58,700 --> 00:17:02,010
.ويقومون بمواجهتهم بأكبر عددٍ ممكن

224
00:17:02,010 --> 00:17:08,150
لكن بما أنهم يتجمعون في المنتصف، من الصعب
.مواجهة الهجمات السريعة من أطراف الملعب

225
00:17:09,340 --> 00:17:14,420
.حتى الآن، نحن وباقي الفرق كنا نستخدم التحرك المنتشر

226
00:17:14,420 --> 00:17:17,350
،وكما توحي الكلمة، فهي تدل على الانتشار

227
00:17:17,350 --> 00:17:20,630
.لذا في هذه التشكيلة، الصادُّون ينتشرون على جميع أنحاء الشبكة

228
00:17:20,630 --> 00:17:23,250
،إنها ليست أفضل تشكيلةٍ لمواجهة الهجمات السريعة من المنتصف

229
00:17:23,250 --> 00:17:28,220
.ولكن يمكن وضع صادٍّ واحدٍ على الأقل مقابل أي هجمةٍ من الملعب

230
00:17:29,490 --> 00:17:33,920
.يبدو الأمر وكأن التنقل المنتشر له أفضلية أعلى للنجاح

231
00:17:34,350 --> 00:17:37,330
.بما أنهم ينتشرون في الملعب بتساوٍ

232
00:17:37,330 --> 00:17:39,280
ينتشرون بتساوٍ إذن؟

233
00:17:39,280 --> 00:17:40,390
.هذا صحيح

234
00:17:40,890 --> 00:17:44,350
،لكن عندما يجيد حاجز الصد القارئ تشكيلة الحزمة

235
00:17:45,460 --> 00:17:46,750
.يكونون مخيفين

236
00:17:47,560 --> 00:17:48,530
!دايتشي-سان

237
00:17:50,610 --> 00:17:53,440
!سأخترقهم من المنتصف

238
00:17:54,080 --> 00:17:59,950
.هدفهم الدائم هو هو بناء جدرانٍ في أي مكانٍ على الشبكة

239
00:18:00,480 --> 00:18:01,430
...هذه هي

240
00:18:02,710 --> 00:18:04,710
.استراتيجية حزمة حاجز الصد القارئ

241
00:18:09,830 --> 00:18:11,270
.إنهاءٌ رائع

242
00:18:12,540 --> 00:18:14,760
.لقد تمكنوا من لمسها من أول مرة

243
00:18:14,760 --> 00:18:16,930
.واستطاع اثنان متابعته كذلك

244
00:18:17,530 --> 00:18:19,890
...الضغط الذي تشعر بهِ عندما تقابل العديد من الصادِّين أمامك

245
00:18:20,520 --> 00:18:22,060
.شديد

246
00:18:27,840 --> 00:18:28,820
!إنهاءٌ رائع

247
00:18:32,150 --> 00:18:33,420
!ابذل ما بوسعك

248
00:18:33,420 --> 00:18:34,150
.أجل

249
00:18:38,860 --> 00:18:39,920
!بانتلون

250
00:18:39,920 --> 00:18:41,120
!إنها لي

251
00:18:46,780 --> 00:18:50,250
.أرى أنهم سريعون للغاية في تلقي الكرة كالعادة

252
00:19:14,620 --> 00:19:15,870
!سحقًا

253
00:19:15,870 --> 00:19:18,030
!صد داتيكو في غاية الروعة

254
00:19:18,450 --> 00:19:20,470
!تحركوا للجانب الآخر بسرعة

255
00:19:20,470 --> 00:19:22,990
.دون ذكر أن اثنانِ منهم قد تجمعا بسرعة

256
00:19:23,570 --> 00:19:24,990
!أجل

257
00:19:30,300 --> 00:19:31,230
.آسفٌ بشأن هذا

258
00:19:39,060 --> 00:19:43,440
.للتو ظننت أن هجومًا من اليمين سيكون أفضل خيارٍ لنا

259
00:19:45,420 --> 00:19:48,540
،بوضع ما إذا كان قراري هو الأفضل أم لا جانبًا

260
00:19:49,660 --> 00:19:53,190
.الضغط الذي شعرت بهِ أثر على تصرفاتي

261
00:19:53,190 --> 00:19:54,810
.حتى لو كان بسيطًا

262
00:19:55,800 --> 00:20:02,280
.حاجز صد داتيكو يجعلني أختار أيَّ شيءٍ عدا المنتصف

263
00:20:03,410 --> 00:20:07,800
.حتى بالنسبة لهاوٍ، صد داتيكو مرعب

264
00:20:08,640 --> 00:20:13,670
.الصادون والمعدون يستمرون في القتال حتى بعد الهجوم

265
00:20:14,530 --> 00:20:17,410
.إنه قتالٌ لرؤية من يستطيع وضع ضغطٍ أكبر

266
00:20:37,810 --> 00:20:38,750
.هذا رائع

267
00:20:48,240 --> 00:20:51,090
.اللعب ضد لاعبين ماهرين أمرٌ رائع

268
00:20:54,930 --> 00:20:55,500
.أوبارا

269
00:20:55,810 --> 00:20:56,470
.أجل

270
00:20:57,040 --> 00:20:58,020
!كوغاني

271
00:21:04,620 --> 00:21:05,680
.المعذرة

272
00:21:05,680 --> 00:21:07,390
.كان هذا هجومًا مفاجئًا قويًا

273
00:21:08,300 --> 00:21:09,390
!لليسار

274
00:21:09,780 --> 00:21:10,560
!أزوماني-سان

275
00:21:14,540 --> 00:21:15,880
...تبدو جيدة

276
00:21:23,510 --> 00:21:24,320
!المعذرة

277
00:21:35,090 --> 00:21:35,620
.لمسةٌ واحدة

278
00:21:35,990 --> 00:21:37,440
.عجبًا

279
00:21:37,440 --> 00:21:40,090
.أظن أن كاراسنو يملك صادِّين كذلك

280
00:21:42,750 --> 00:21:43,670
!فوتاكتشي-سان

281
00:21:49,230 --> 00:21:50,140
.هجومٌ مخادع

282
00:21:53,960 --> 00:21:55,610
...الرعد

283
00:21:57,140 --> 00:21:58,910
!المتدحرج

284
00:22:00,670 --> 00:22:02,230
!أحسنت يا نيشينويا

285
00:22:02,530 --> 00:22:03,690
!استقبالٌ رائع

286
00:22:06,620 --> 00:22:07,860
!نيشينويا-سان

287
00:22:08,410 --> 00:22:09,820
!أنتَ تعترض الطريق

288
00:22:18,840 --> 00:22:20,940
!ماذا؟

289
00:23:54,120 --> 00:23:56,090
."الحلقة القادمة: "عودة