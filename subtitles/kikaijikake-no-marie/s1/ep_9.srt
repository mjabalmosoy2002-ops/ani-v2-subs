1
00:01:32,190 --> 00:01:33,860
!يشهد اليوم مهرجان الخريف

2
00:01:33,860 --> 00:01:35,450
تتألّق الألعاب النّاريّة في أرجاء البلاد

3
00:01:35,850 --> 00:01:42,830
في كلّ عام، يتطلّع تلاميذ ثانويّة
كالميا لرؤيتها بعد دوام المدرسة

4
00:01:43,790 --> 00:01:47,750
.لديّ عمل في مجلس الطّلبة
لا أستطيع المُشاركة

5
00:01:47,750 --> 00:01:49,300
هكذا إذاً

6
00:01:50,090 --> 00:01:54,640
...أريد بالطّبع رؤية الألعاب النّاريّة مع ماري
!لكن الأمر ليس بتلك البساطة

7
00:01:55,210 --> 00:02:00,800
لو كنتُ بشريّة، أنا متأكّدة بأنّني
كنتُ سأقع في حُبّك

8
00:02:01,690 --> 00:02:05,150
،لـ-لا يوجد أمل! بعد ما قالته لي

9
00:02:05,150 --> 00:02:07,420
لا يسعني النّظر إليها بتلك الطّريقة

10
00:02:08,050 --> 00:02:09,900
!يا للخسارة

11
00:02:09,900 --> 00:02:13,320
سأنتظرك حتّى تنتهي على الأقلّ

12
00:02:13,320 --> 00:02:16,410
أشكرك. إلى اللّقاء

13
00:02:17,130 --> 00:02:20,260
كنتُ لأتمنّى مُشاهدة الألعاب
النّاريّة مع آرثر-ساما

14
00:02:23,590 --> 00:02:25,440
أصدقاء؟

15
00:02:31,210 --> 00:02:35,440
،حتّى في تلك الجزيرة الإستوائيّة
،اشتقتُ لآرثر عندما يقول

16
00:02:35,440 --> 00:02:42,310
"!أيّتها الخنزيرات عديمات الجدوى"
"!أو "عُدنَ إلى مزرعة الخنازير خاصّتكن

17
00:02:42,310 --> 00:02:43,430
!بالفعل

18
00:02:46,630 --> 00:02:49,140
هذا هو نادي مُعجبي آرثر-ساما

19
00:02:49,690 --> 00:02:53,570
أرغب في مُصادقتهن ومُشاهدة
الألعاب النّاريّة معاً

20
00:02:54,030 --> 00:02:57,470
لكن مُجرّد التمنِّي لا ينفع، أليس كذلك؟

21
00:03:00,540 --> 00:03:02,370
!أتيتُ مُستعدّة

22
00:03:02,370 --> 00:03:05,080
!أعددتُ هذا البسكويت في صفّ الطّبخ

23
00:03:05,580 --> 00:03:08,580
سيكون رمزاً مثاليّاً للصّداقة

24
00:03:09,790 --> 00:03:10,840
...المعذرة

25
00:03:11,060 --> 00:03:14,600
مـ-ما رأيكن أن نصبح صديقات؟

26
00:03:15,100 --> 00:03:17,340
ورُبّما نُشاهد الألعاب النّاريّة معاً؟

27
00:03:17,590 --> 00:03:18,810
مهلاً يا ماري

28
00:03:18,810 --> 00:03:20,420
أجل، نتمنّى ذلك

29
00:03:20,420 --> 00:03:22,350
مُذهل! يبدو هذا البسكويت شهيّاً

30
00:03:22,670 --> 00:03:25,560
أعددتُها لكُن جميعاً

31
00:03:27,850 --> 00:03:30,540
حسناً. تمّ التحقُّق من المُحاكاة

32
00:03:31,010 --> 00:03:34,110
،لكن من باب الحيطة فقط
سأُجري تجربة إضافيّة

33
00:03:34,530 --> 00:03:37,910
هـ-هلّا أصبحت صديقي لو سمحت؟

34
00:03:37,910 --> 00:03:39,240
على الرّحب

35
00:03:40,240 --> 00:03:41,440
!ماذا؟

36
00:03:42,510 --> 00:03:44,250
هل هذه لي أنا؟

37
00:03:44,460 --> 00:03:45,840
!هذا لطيف

38
00:03:44,870 --> 00:03:46,250
—أنت! لا

39
00:03:50,110 --> 00:03:55,630
،كنتُ واثقاً من تحمُّلي للسُّموم
لكن هذه فتّاكة

40
00:03:56,570 --> 00:03:59,860
إذاً، تريدين صنع صداقة مع أولئك الفتيات؟

41
00:04:00,260 --> 00:04:01,800
لكن لن يفلح هذا أبداً

42
00:04:02,670 --> 00:04:06,590
جميعهن ثريّات وترعرعن
،في كنف الرّفاهيّة

43
00:04:06,590 --> 00:04:09,720
لذا ستبدين شاذّة في مجموعتهن

44
00:04:10,730 --> 00:04:13,620
!خطّطتُ لتلك المُشكلة بالفعل

45
00:04:16,510 --> 00:04:20,040
!ماري... بوضع الفتاة الثّريّة

46
00:04:30,170 --> 00:04:32,970
—ثمّ بعد ذلك، آرثر

47
00:04:32,970 --> 00:04:35,410
المعذرة. كيف حالكن؟

48
00:04:35,410 --> 00:04:36,960
ماذا؟ ماري؟

49
00:04:36,960 --> 00:04:39,550
هـ-هل تجرّبين شكلاً جديداً؟

50
00:04:40,100 --> 00:04:42,640
يا لوقاحتي لعدم تعريفي
عن نفسي مُسبقاً

51
00:04:42,640 --> 00:04:46,020
مثلكن، أنا ثريّة مُبتدئة

52
00:04:46,020 --> 00:04:47,430
تشمل هواياتي... الخيل

53
00:04:52,930 --> 00:04:57,070
يا إلهي، تبدو وجبتكن ناقصة البروتين

54
00:04:57,580 --> 00:05:00,100
لا يكتمل الشّاي إلّا به

55
00:05:01,790 --> 00:05:04,140
!هذا بدائيّ جدّاً

56
00:05:04,140 --> 00:05:06,550
!من الواضح أنّها مُنتحلة

57
00:05:06,550 --> 00:05:08,080
!لنطردها

58
00:05:08,730 --> 00:05:10,800
!يا إلهي

59
00:05:14,980 --> 00:05:16,330
هل أنتِ بخير؟

60
00:05:16,330 --> 00:05:19,980
شارف الغداء على الانتهاء. أتعتقدين بأنّ
صنع أصدقاء سيفلح؟

61
00:05:20,310 --> 00:05:26,350
لم أرغب بمُصادقة شخص مثلما أرغب الآن

62
00:05:27,950 --> 00:05:29,990
أنا آسفة بشأن ما سبق

63
00:05:29,990 --> 00:05:31,660
!من فضلكِ كوني صديقتي

64
00:05:31,660 --> 00:05:33,300
أريد أن نشاهد الألعاب النّاريّة معاً

65
00:05:33,300 --> 00:05:34,360
مع أطيب تحيّة، ماري

66
00:05:34,640 --> 00:05:38,440
طلبتُ من شخص أن يخبرني أين يمكنني
إيجاد خزانة ملابس رئيسة نادي المُعجبين

67
00:05:38,440 --> 00:05:42,570
ربّما سيكون من الأسهل إقناعهن بالكتابة

68
00:05:42,570 --> 00:05:43,740
رسالة؟ هذا كلّ شيء؟

69
00:05:44,220 --> 00:05:48,900
أرفقتُ أفضل هديّة تخطر
على البال لتشجيعها

70
00:05:49,390 --> 00:05:52,000
آمل أن تروقها

71
00:05:52,310 --> 00:05:54,710
ما هذه؟ رسالة؟

72
00:05:54,710 --> 00:05:56,500
يا له من ظرف جميل

73
00:05:57,020 --> 00:05:59,520
لعلّها رسالة حُبّ

74
00:05:59,520 --> 00:06:00,760
أتعتقدين ذلك؟

75
00:06:01,180 --> 00:06:02,670
...لنرَ

76
00:06:11,020 --> 00:06:11,910
ماذا؟

77
00:06:12,520 --> 00:06:15,770
!بـ-برسيم رُباعي الأوراق؟

78
00:06:15,990 --> 00:06:21,280
كانت تعلم بحساسيّتي من برسيم رُباعي
!الأوراق ونصبتْ لي هذا الفخّ

79
00:06:21,530 --> 00:06:22,430
مستحيل

80
00:06:22,430 --> 00:06:24,030
ما أدراكِ بذلك؟

81
00:06:24,620 --> 00:06:26,660
!تبّاً... هذا الشّيء

82
00:06:30,410 --> 00:06:33,130
!أنا أتّقد غيظاً

83
00:06:33,130 --> 00:06:35,540
!غيظاً

84
00:06:40,590 --> 00:06:43,170
بهذا نختتم حصّة النّشاط لهذا اليوم

85
00:06:43,170 --> 00:06:45,930
!أو هذا ما اعتقدتموه! فكّروا ثانية

86
00:06:45,930 --> 00:06:47,930
!انظروا إلى هذا رجاء

87
00:06:47,930 --> 00:06:51,430
!من كان؟! من كسر مزهريّتي المُفضّلة؟

88
00:06:51,430 --> 00:06:54,150
!حاولتم ترقيعها بشريط لاصق، لكن هذا واضح

89
00:06:54,710 --> 00:06:56,190
!أزهاري المسكينة

90
00:06:56,450 --> 00:07:00,690
كعقوبة، التّلميذ المُذنِب سيبقى
!حتّى وقت متأخّر ويُنظّف الصّفّ

91
00:07:00,690 --> 00:07:05,110
ولن تنتهي حصّة النّشاط ما لم
!أكتشف من المسؤول بينكم

92
00:07:05,110 --> 00:07:06,670
!هذا يعني لا ألعاب ناريّة

93
00:07:06,670 --> 00:07:08,450
!ماذا؟

94
00:07:08,450 --> 00:07:10,400
!مستحيل

95
00:07:10,950 --> 00:07:12,940
!لا! أريد رؤية الألعاب النّاريّة

96
00:07:11,610 --> 00:07:13,630
بجدّية؟ هناك ألعاب ناريّة على وشك أن تُطلَق

97
00:07:12,940 --> 00:07:15,180
لا يحدث هذا إلّا مرّة في العام

98
00:07:13,630 --> 00:07:15,350
من فعلَ ذلك، فليعترف

99
00:07:14,240 --> 00:07:17,730
رسمتُ مُخطّطات مع شخص في صفّ آخر

100
00:07:15,180 --> 00:07:19,710
أسرع طريقة للخروج من هذا هو أن
يتحمّل شخصٌ اللّوم ويبقى مُتأخّراً

101
00:07:20,550 --> 00:07:21,320
أنا

102
00:07:22,230 --> 00:07:23,990
كسرتُ المزهريّة

103
00:07:29,050 --> 00:07:31,730
ماذا عن صديقاتكِ الجدُد؟

104
00:07:31,730 --> 00:07:32,990
سأكون بخير

105
00:07:32,990 --> 00:07:35,900
،أردتُ أصدقاء لمُشاهدة الألعاب النّاريّة معاً

106
00:07:35,900 --> 00:07:38,530
لكن الجميع مُتحمّسون لها

107
00:07:38,530 --> 00:07:40,480
لذا للحفاظ على ذلك وعدم

108
00:07:42,230 --> 00:07:46,990
إفساد متعة الآخرين، يمكنني
تدبّر أمري بنفسي

109
00:07:54,240 --> 00:07:57,390
ليس لديها أصدقاء، لذا هذا
مُلائم بصورة مثاليّة

110
00:07:57,390 --> 00:08:00,360
رغم أنّنا نحن من كسرنا المزهريّة

111
00:08:01,140 --> 00:08:02,750
حقّاً؟

112
00:08:02,750 --> 00:08:05,510
يسرّني معرفة ذلك

113
00:08:05,510 --> 00:08:08,790
أنت تلميذ الشّرف ذاك

114
00:08:08,790 --> 00:08:11,740
أنت تستفزّني منذ وقت طويل

115
00:08:14,870 --> 00:08:17,270
!انسَ كلّ ما سمعتَه للتو

116
00:08:17,560 --> 00:08:19,270
...وإلّا

117
00:08:19,480 --> 00:08:22,450
ماذا؟ ستُبادر باللّكمة الأولى؟

118
00:08:22,450 --> 00:08:24,090
...ما يجعل هذا

119
00:08:24,090 --> 00:08:26,140
دفاعاً عن النّفس

120
00:08:27,170 --> 00:08:29,150
أ-أنا آسف جدّاً

121
00:08:29,150 --> 00:08:31,530
لنُصحّح الخطأ

122
00:08:32,950 --> 00:08:36,100
لن يتنمّر أحدٌ على ماري سوايّ

123
00:08:37,650 --> 00:08:40,380
!نحن من كسر تلك المزهريّة

124
00:08:40,380 --> 00:08:43,680
!حطّمناها إلى أشلاء والآن نُنظّف

125
00:08:44,770 --> 00:08:46,430
...ما الّذي يفعلونه

126
00:08:46,430 --> 00:08:47,630
تعالي الآن

127
00:08:57,310 --> 00:09:03,620
مفهوم؟ تكلّمي بوضوح عندما تتحدّثين
معهن، وحاولي أن تتصرّفي بشكل طبيعيّ

128
00:09:03,620 --> 00:09:05,150
...ا-المعذرة

129
00:09:05,150 --> 00:09:06,480
!اذهبي الآن

130
00:09:06,480 --> 00:09:07,320
!مهلاً

131
00:09:07,900 --> 00:09:09,570
...لـ-لـ-لحظة

132
00:09:11,320 --> 00:09:14,830
ماري؟ بما يمكننا خدمتكِ؟

133
00:09:15,940 --> 00:09:17,540
كوني شُجاعة

134
00:09:21,250 --> 00:09:25,090
هلّا أصبحتُن صديقاتي رجاء؟

135
00:09:30,380 --> 00:09:31,470
لا نريد

136
00:09:33,100 --> 00:09:39,100
هل كنتِ تحومين حولنا طوال اليوم
فقط لتطرحي هذا السّؤال؟

137
00:09:39,100 --> 00:09:41,300
!مُحال أن نصبح صديقات

138
00:09:41,300 --> 00:09:45,200
نحن ببساطة مُختلفات تماماً

139
00:09:47,140 --> 00:09:51,780
لكن أحترم مشاعركِ تجاه آرثر

140
00:09:52,390 --> 00:09:53,610
...لذا

141
00:09:53,950 --> 00:09:59,870
،سوف أشاهد الألعاب النّاريّة معكِ
ليس كصديقة، بل كمُنافسة شريفة

142
00:10:02,710 --> 00:10:06,750
اسمي بريجيت. سررتُ بانضمامكِ

143
00:10:07,260 --> 00:10:11,210
...ماري، بخصوص المزهريّة في الصّفّ

144
00:10:11,210 --> 00:10:17,390
أخبرنا المُعلّمة بأنّكِ مُحال أن تفعلي ذلك
!ولا بُدّ أنّه كان شخصاً آخر

145
00:10:17,750 --> 00:10:19,270
!شكراً جزيلاً

146
00:10:24,540 --> 00:10:28,150
نواه... شكراً لك

147
00:10:32,420 --> 00:10:34,060
اقترب الوقت

148
00:10:34,060 --> 00:10:36,100
تعالي يا ماري

149
00:10:36,100 --> 00:10:36,530
!حسناً

150
00:10:52,650 --> 00:10:53,550
هل أنتِ بخير؟

151
00:10:55,260 --> 00:10:58,070
!آرثر-ساما

152
00:10:58,070 --> 00:11:00,470
أنجزتُ عملي باكراً

153
00:11:04,870 --> 00:11:06,730
هل يمكنني الانضمام لكُن؟

154
00:11:06,730 --> 00:11:08,190
أ-أجل

155
00:11:08,190 --> 00:11:10,280
!بالطّبع

156
00:11:10,280 --> 00:11:12,590
تبّاً. من الصّعب مُشاهدة الألعاب النّاريّة

157
00:11:13,350 --> 00:11:14,630
!كوني موطئ قدمي

158
00:11:14,630 --> 00:11:16,070
!حاضرة

159
00:11:29,550 --> 00:11:30,910
أليست جميلة؟

160
00:11:30,910 --> 00:11:33,090
لا شيء أفضل من مُشاهدة
الألعاب النّاريّة مع الجميع

161
00:11:55,110 --> 00:11:57,630
نواه. كنّا نبحث عنك

162
00:11:57,630 --> 00:11:59,030
ما الّذي تفعله؟

163
00:11:59,030 --> 00:12:01,110
آسف

164
00:12:01,750 --> 00:12:03,860
لم أستطع الإشاحة بنظري
عن كلّ ذلك الجمال

165
00:12:18,990 --> 00:12:21,020
هذه مقالات عنك في شبابك

166
00:12:21,350 --> 00:12:25,830
.جمعتُ وتخلّصتُ من كلّ شيء تقريباً
هذه كلّ ما بقي

167
00:12:26,700 --> 00:12:30,000
،أنا متأكّد بأنّها تعيدكِ لذكريات جميلة
لذا انظري إليها مرّة أخيرة

168
00:12:30,540 --> 00:12:34,280
وآرثر-ساما قد خرج لنزهة مشي ليليّة

169
00:12:34,620 --> 00:12:36,220
ينبغي أن نكتفي بهذا القدر

170
00:12:36,850 --> 00:12:37,640
حسناً

171
00:12:52,690 --> 00:12:55,400
كانت الألعاب النّاريّة مُمتعة حقّاً

172
00:12:56,390 --> 00:13:00,220
كانت ماري 2 الوحيدة الّتي أستطيع
،أن أُناديها صديقتي

173
00:13:00,660 --> 00:13:03,100
لكن الآن لديّ بريجيت وفتيات
نادي المُعجبين أيضاً

174
00:13:28,630 --> 00:13:29,700
ما هذا؟

175
00:13:52,580 --> 00:13:55,700
هل شاهدت الألعاب النّاريّة
البارحة أيضاً يا ماري 2؟

176
00:13:55,700 --> 00:13:57,980
رصدتُ أصوات الانفجارات

177
00:13:57,980 --> 00:13:59,930
كانت مُدهشة

178
00:13:59,930 --> 00:14:00,410
مُذهلة

179
00:14:00,410 --> 00:14:04,130
ألوان مُختلفة تنفجر في السّماء

180
00:14:04,130 --> 00:14:05,200
مُذهلة

181
00:14:06,270 --> 00:14:07,740
!لا شيء! صفر

182
00:14:08,170 --> 00:14:12,500
"كلّ المعلومات عن "ماري إيفانس
!هذه مفقودة بشكل مُريب

183
00:14:12,770 --> 00:14:16,330
عندما أتوصّل إلى هذه المقالة، أجد
!بأنّ الصّور والاسم مُختلفون

184
00:14:16,330 --> 00:14:18,500
يبدو الأمر برمّته مُتعمَّداً

185
00:14:22,230 --> 00:14:25,010
هل يُعقل أنّ مولايّ الصّغير
!كشفَ هويّتكِ الحقيقيّة؟

186
00:14:25,620 --> 00:14:31,410
لكن هذه أوّل مرّة يتصرّف فيها بغرابة

187
00:14:31,410 --> 00:14:32,520
صحيح

188
00:14:33,030 --> 00:14:35,810
وكيف حدث ذلك الآن بعد كلّ هذا الوقت؟

189
00:14:35,810 --> 00:14:40,030
كان ليكتشف بأنّني بشريّة مُسبقاً بالفعل

190
00:14:41,100 --> 00:14:41,780
صحيح

191
00:14:42,060 --> 00:14:43,780
كان ينبغي لبطّاريّات أ-أ أن تفضحني

192
00:14:44,060 --> 00:14:46,780
أو في أوّل مرّة لمس فيها
شعركِ أو بشرتكِ

193
00:14:46,780 --> 00:14:50,540
أو حتّى في لحظة رؤيته لكِ

194
00:14:54,610 --> 00:14:57,290
انسي الأمر. أنا أبالغ في التّفكير

195
00:14:57,290 --> 00:14:59,590
!كلام فارغ

196
00:15:00,370 --> 00:15:07,050
،لأنّ آرثر كان غافلاً تماماً
سرعان ما اطمأنّ قلب الثّلاثي

197
00:15:08,570 --> 00:15:10,820
لن أصل إلى نتيجة في البحث
!عن الأشياء عبر الإنترنت

198
00:15:11,710 --> 00:15:14,080
!يجب أن أتحقّق شخصيّاً

199
00:15:14,080 --> 00:15:16,560
...إذا تبيّن بأنّ ماري بشريّة

200
00:15:18,090 --> 00:15:20,080
فمن الأفضل أن أكون مُستعدّاً
للدّفاع عن نفسي

201
00:15:21,410 --> 00:15:26,680
!سئمتُ من الكذب عليّ

202
00:15:49,810 --> 00:15:52,070
لم تتأذّوا، أليس كذلك؟

203
00:15:53,850 --> 00:15:56,620
هل هي غير خائفة لأنّها روبوت؟

204
00:16:10,830 --> 00:16:13,370
ألا تتعب أبداً لأنّها روبوت؟

205
00:16:14,020 --> 00:16:19,120
بئساً! أنا لا أُسبّب سوى
المتاعب لآرثر-ساما

206
00:16:19,120 --> 00:16:23,280
آمل أن تبذلوا جميعكم ما بوسعكم لأجله

207
00:16:25,070 --> 00:16:29,700
هل هي لطيفة معي لأنّها كانت
مُبرمجة على ذلك؟

208
00:16:35,110 --> 00:16:36,240
!زيت؟

209
00:16:39,380 --> 00:16:41,630
مُجرّد الشّرب مُزعج

210
00:16:41,630 --> 00:16:43,370
من الصّعب الشّرب من هذا الشّيء

211
00:16:43,370 --> 00:16:46,400
تمّت عمليّة التّشحيم

212
00:16:49,150 --> 00:16:52,440
ما الّذي كنتُ أُفكّر فيه؟

213
00:16:52,860 --> 00:16:56,230
لا بُدّ أنّ تلك مقالة مُزيّفة نشرها أحدٌ ما

214
00:16:57,310 --> 00:16:58,910
ماري، تعالي معي

215
00:16:58,910 --> 00:17:00,740
حـ-حاضرة

216
00:17:15,190 --> 00:17:18,800
أستطيع العزف على البيانو هكذا بفضلكِ

217
00:17:20,130 --> 00:17:23,800
كنتُ مُعذَّباً بواسطة ماضيّي
طوال هذا الوقت

218
00:17:27,110 --> 00:17:29,260
أنقذتِني بمُجرّد وجودكِ هنا

219
00:17:30,430 --> 00:17:33,820
يمكنني الوثوق بكِ. أنتِ لا تكذبين

220
00:17:33,820 --> 00:17:35,200
لأنّكِ روبوت

221
00:17:36,130 --> 00:17:37,700
...إذا

222
00:17:38,250 --> 00:17:41,960
،إذا كنتَ سعيداً يا آرثر-ساما
فكذلك أكون أنا

223
00:17:44,710 --> 00:17:46,740
ماري هي روبوت

224
00:17:47,170 --> 00:17:49,710
لا يُفترض للرّوبوتات أن تمتلك مشاعر

225
00:17:50,460 --> 00:17:51,970
...إذاً لماذا

226
00:17:53,860 --> 00:17:56,970
كيف لها أن تبتسم بهذه البهجة؟

227
00:17:57,630 --> 00:17:59,830
كما يفعل البشر

228
00:18:06,430 --> 00:18:10,220
إنّه ضعيف، لكن لديها نبض

229
00:18:14,980 --> 00:18:16,990
هكذا إذاً

230
00:18:22,330 --> 00:18:25,240
...ماري، أنتِ فعلاً

231
00:18:43,250 --> 00:18:44,770
...آرثر-ساما

232
00:18:44,770 --> 00:18:46,010
آرثر-ساما؟

233
00:18:46,010 --> 00:18:48,760
ماري، لستِ روبوتاً

234
00:18:49,270 --> 00:18:51,620
هل تشعر بوعكة؟

235
00:18:50,150 --> 00:18:51,620
أنتِ غير مُبرمجة

236
00:18:55,250 --> 00:18:59,970
لكن ساعدتِني مرّات كثيرة

237
00:18:59,970 --> 00:19:03,040
لطالما وقفتِ بجانبي وأعنتِني

238
00:19:03,780 --> 00:19:06,880
لا يوجد خِداع في ذلك، صحيح؟

239
00:19:07,850 --> 00:19:11,800
هل تُمانعين مُعانقتي؟ ولو قليلاً؟

240
00:19:11,800 --> 00:19:14,820
توقّعت. أنت تشعر بوعكة

241
00:19:14,820 --> 00:19:16,550
أجل، بالطّبع

242
00:19:21,070 --> 00:19:25,950
أستطيع سماع نبضات قلب ماري

243
00:19:28,410 --> 00:19:32,320
لم تكن خادمة روبوت وقعتُ في حُبّها

244
00:19:42,610 --> 00:19:45,720
كان أنتِ يا ماري إيفانس

245
00:19:51,980 --> 00:19:53,960
ماري بشريّة

246
00:19:53,960 --> 00:19:59,510
لكن لا يبدو أنّها تريد أن تقتلني
أو نصب فخّ لي

247
00:20:00,390 --> 00:20:01,680
...في هذه الحالة

248
00:20:01,680 --> 00:20:03,140
ماري، ما الخطب؟

249
00:20:07,180 --> 00:20:09,350
!هناك ورقة مفقودة بالفعل

250
00:20:10,010 --> 00:20:12,590
هل يقصد تلك المقالة الّتي التقطتُها؟

251
00:20:14,210 --> 00:20:17,830
،إذا اكتشفَ مولايّ الصّغير بأنّكِ بشريّة

252
00:20:18,270 --> 00:20:22,870
فسيترتّب عليّ إرسالكِ إلى مكان
بعيد ما كما ناقشنا من قبل

253
00:20:23,180 --> 00:20:25,680
!روي... إذاً أنت العقل المُدبِّر لكلّ ذلك

254
00:20:26,180 --> 00:20:28,370
لحظة، "مكان بعيد"؟

255
00:20:28,730 --> 00:20:31,270
أجل، فهمتُ تماماً

256
00:20:33,060 --> 00:20:35,840
ما حدث مع داريل جعلَني أدرك حقّاً

257
00:20:37,340 --> 00:20:40,130
بأنّ المكر سوف يؤذي آرثر-ساما ليس إلّا

258
00:20:41,900 --> 00:20:46,880
لا يحقّ لكاذبة مثلي أن تبقى بجانبه

259
00:20:48,150 --> 00:20:52,340
عندما يكتشف، سأغادر فوراً

260
00:20:52,340 --> 00:20:53,900
لستُ مُتحسِّرة على شيء

261
00:20:56,140 --> 00:20:59,000
لا أقصد جعلكِ تتحمّلين العبء لوحدكِ

262
00:21:00,170 --> 00:21:02,120
أنا من وظّفكِ

263
00:21:02,540 --> 00:21:05,410
،أنوي الإفصاح عن كلّ شيء لمولايّ الصّغير

264
00:21:05,410 --> 00:21:10,160
والاعتذار على خيانته، وتقبُّل العواقب

265
00:21:11,700 --> 00:21:13,170
...روي

266
00:21:19,980 --> 00:21:23,940
ماري! روي! وجدتُ الصّفحة المفقودة

267
00:21:23,940 --> 00:21:25,680
سقطتْ في سياج الحديقة

268
00:21:26,450 --> 00:21:28,180
هذا مُطمئن

269
00:21:28,180 --> 00:21:29,710
...تلك المقالة

270
00:21:30,180 --> 00:21:33,040
اتّخذتُ القرارَ الصّائب بتركها حيث وجدتُها

271
00:21:37,990 --> 00:21:38,930
...ماري

272
00:21:38,930 --> 00:21:42,460
،بالنّسبة لكِ، أنا غالباً جزء من عملكِ فحسب

273
00:21:44,140 --> 00:21:46,820
لكن أُحبّكِ

274
00:21:47,230 --> 00:21:48,450
أريد أن أكون معكِ دوماً

275
00:21:49,070 --> 00:21:52,960
...لذا سأحرص

276
00:21:54,180 --> 00:21:56,740
!على ألّا تكتشفي بأنّني أعرف سرّكِ

277
00:21:58,170 --> 00:21:59,360
أبداً

278
00:23:32,090 --> 00:23:34,310
،حدثت أمور كثيرة

279
00:23:34,310 --> 00:23:37,750
،لكن قبل أن نذهب إلى مدينة الملاهي
أريد توضيح هذا الأمر جيّداً

280
00:23:37,750 --> 00:23:40,980
!هذا وقت مُهمّ جدّاً لي ولماري