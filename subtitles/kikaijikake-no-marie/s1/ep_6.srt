1
00:01:36,070 --> 00:01:36,970
تأخّرت

2
00:01:38,210 --> 00:01:39,570
تأخُّر عشر دقائق

3
00:01:39,570 --> 00:01:41,450
أ-أنا آسف جدّاً يا سيّدي

4
00:01:41,450 --> 00:01:44,090
قُضي على السّائق هذه المرّة فعلاً

5
00:01:44,090 --> 00:01:45,240
حسناً

6
00:01:45,240 --> 00:01:46,930
ماري، اركبي أوّلاً

7
00:01:59,580 --> 00:02:01,610
آرثر-ساما غير غاضب؟

8
00:02:01,610 --> 00:02:02,600
لماذا؟

9
00:02:03,950 --> 00:02:08,100
آرثر-ساما، أتمنّى لك عيد
ميلاد سعيداً اليوم

10
00:02:09,030 --> 00:02:10,860
!هل هو... عيد... ميلاده؟

11
00:02:11,240 --> 00:02:15,470
كيف لي ألّا أعرف بأنّه يوم مُهمّ
بالنّسبة للشّخص الّذي أُحبّه؟

12
00:02:16,060 --> 00:02:21,950
عيد ميلادي... الأقلّ تفضيلاً لديّ
من بين 365 يوماً في العام

13
00:02:23,490 --> 00:02:30,180
،إنّه يمنح النّاس ذريعة لإرسال هدايا لي
كلّها مُفخّخة بسيوف أو قنابل

14
00:02:30,180 --> 00:02:32,930
ووجبات طعام عيد ميلادي مُسمَّمة دوماً

15
00:02:33,290 --> 00:02:36,430
دائماً ما تُلغَى حفلاتي بسبب قنابل

16
00:02:37,550 --> 00:02:41,760
—وعيد ميلادي يعيد لي ذكرى أكره حتّى

17
00:02:43,430 --> 00:02:45,760
لا، انسي الأمر

18
00:02:46,410 --> 00:02:48,390
الذّكرى الجميلة الّتي لديّ

19
00:02:48,750 --> 00:02:51,440
هي في العام الّذي تبنّاني فيه
أبي كابن له

20
00:02:51,440 --> 00:02:54,770
،اقتطع وقتاً من جدوله المُزدحم لأجلي

21
00:02:55,490 --> 00:02:59,960
وتناولنا كعك عيد ميلاد معاً

22
00:02:59,960 --> 00:03:01,810
...كعك عيد ميلاد

23
00:03:05,510 --> 00:03:08,550
،قبل أن ينتهي المطاف بي في فقر مدقع

24
00:03:09,040 --> 00:03:12,540
.حصلتُ على واحد في كلّ عام
أسعدني ذلك كثيراً

25
00:03:14,260 --> 00:03:18,490
هذا يحسم المسألة! عندما نعود
!إلى القصر، سأخبز كعكاً

26
00:03:19,050 --> 00:03:19,550
،في نهاية المطاف

27
00:03:20,270 --> 00:03:24,820
يُفترَض أن تكون أعياد ميلادي
مُناسبات مُبهجة

28
00:03:25,380 --> 00:03:27,740
!آرثر

29
00:03:28,560 --> 00:03:32,310
!من فضلك اقبل هدايا عيد الميلاد هذه منّا

30
00:03:35,210 --> 00:03:36,070
آسف

31
00:03:36,820 --> 00:03:40,570
قرّرتُ ألّا أقبل أي هديّة من زملاء صفّ

32
00:03:40,980 --> 00:03:43,500
أكره طلب ذلك، لكن أعيدوها رجاء

33
00:03:44,460 --> 00:03:46,780
ماري، ساعديني في إعادتها جميعها

34
00:03:46,780 --> 00:03:47,830
حاضرة

35
00:03:53,380 --> 00:03:55,210
مهلاً لحظة

36
00:03:55,210 --> 00:03:58,460
هلّا تكلّمت معنا بعد دوام المدرسة؟

37
00:04:02,990 --> 00:04:04,220
!ماري

38
00:04:04,620 --> 00:04:09,220
ما رأيكِ بمُصادقتنا نحن، نادي مُعجبي آرثر؟

39
00:04:09,220 --> 00:04:10,600
نادي ماذا؟

40
00:04:11,420 --> 00:04:18,700
والمعروف أيضاً بالمُجتمع الّذي يرغب من آرثر
!أن ينظر إليه كما لو أنّه حثالة

41
00:04:21,250 --> 00:04:24,240
إنّه كاره للبشر حرفيّاً

42
00:04:24,240 --> 00:04:29,740
عندما نلقي السّلام عليه، فإنّه يردّ
بابتسامة المُحرَج ليبدو مُهذّباً

43
00:04:30,630 --> 00:04:33,250
!سرعان ما تعرفين بأنّه يعتبرنا مصدر إزعاج

44
00:04:34,630 --> 00:04:36,650
!ونحن نعشق ذلك

45
00:04:37,500 --> 00:04:42,790
على أيّ حال، أثق بأنّكِ تفهمين شعورنا الآن

46
00:04:43,180 --> 00:04:45,090
لذا من فضلكِ، خذي هذه

47
00:04:45,790 --> 00:04:49,260
سأتحقّق مع آرثر-ساما. تحسُّباً فقط

48
00:04:49,260 --> 00:04:50,590
—شكراً لـ

49
00:04:50,590 --> 00:04:54,270
لكن هل ستكُنّ صديقاتي حقّاً؟

50
00:04:54,270 --> 00:04:55,730
أنا مسرورة

51
00:04:55,730 --> 00:04:58,520
أحبّ آرثر-ساما أيضاً

52
00:04:59,530 --> 00:05:02,150
!مهلاً! لا تقولي لي بأنّكِ أحد أولئك الأشخاص

53
00:05:03,690 --> 00:05:08,780
لأكون واضحة، الوقوع في الحُبّ هو
جريمة شديدة داخل نادي المُعجبين

54
00:05:08,780 --> 00:05:12,570
أتسألين عن السّبب؟ لأنّ آرثر
أروع من ذلك بكثير

55
00:05:12,570 --> 00:05:15,540
الوقوع في حُبّه سلوك غاية في الوقاحة

56
00:05:15,790 --> 00:05:17,780
!لذا استسلمي كبقيّتنا

57
00:05:17,780 --> 00:05:18,790
لا، شكراً

58
00:05:19,070 --> 00:05:21,330
!هل تفتعلين مُشكلة معنا؟

59
00:05:21,330 --> 00:05:22,440
!تعالي إلى هنا

60
00:05:22,440 --> 00:05:24,050
كلّ شيء ينهار إذاً

61
00:05:24,050 --> 00:05:28,140
هل الوقوع في حُبّ آرثر-ساما خاطئ؟

62
00:05:35,460 --> 00:05:37,310
...آرثر-ساما

63
00:05:42,260 --> 00:05:44,820
إذا لهوتُن كثيراً فستتأذّين

64
00:05:44,820 --> 00:05:46,470
!نـ-نحن آسفات جدّاً

65
00:05:46,470 --> 00:05:48,320
!نستأذن

66
00:05:48,770 --> 00:05:50,260
نجوت

67
00:05:50,260 --> 00:05:52,910
ماري، ماذا حدث؟ هل أنتِ بخير؟

68
00:05:52,910 --> 00:05:56,530
كنّا فقط... نلعب المُطاردة واللّمس

69
00:05:56,530 --> 00:05:59,380
أهذا كلّ شيء؟ أنا مُطمئنّ

70
00:05:59,380 --> 00:06:01,940
يبدو أنّ أعمال مجلس الطّلبة ستُؤخّرني اليوم

71
00:06:01,940 --> 00:06:04,140
هلّا عدتِ إلى المنزل من دوني؟

72
00:06:04,140 --> 00:06:05,840
عُلِم يا مولايّ

73
00:06:13,110 --> 00:06:18,230
،ما دمتُ أخلط الكثير من الأشياء اللّذيذة
سيغدو لذيذاً... أليس كذلك؟

74
00:06:33,100 --> 00:06:34,370
لم يكن ذلك لطيفاً

75
00:06:34,370 --> 00:06:38,380
هوّني عليّ. لم تتعافَ ذراعي
اليسرى تماماً بعد

76
00:06:45,170 --> 00:06:46,370
لن أرضخ

77
00:06:46,370 --> 00:06:48,880
—أيّ شخص يريد الموت لآرثر-ساما يجب

78
00:06:48,880 --> 00:06:53,760
استرخي. أنا أقضي استراحة
من أعمال الاغتيال المأجورة

79
00:06:53,760 --> 00:06:57,310
لن أفعل شيئاً لأذيّة آرثر

80
00:06:59,290 --> 00:07:01,730
ماذا تفعل هنا إذاً؟

81
00:07:01,730 --> 00:07:03,310
أليس هذا واضحاً؟

82
00:07:03,950 --> 00:07:05,740
أنا هنا لأجل تلك الكعكة

83
00:07:09,190 --> 00:07:11,070
أتظنّني سأُعطيك إيّاها؟

84
00:07:11,070 --> 00:07:14,320
هذه كعكة عيد ميلاد آرثر-ساما

85
00:07:14,590 --> 00:07:16,670
دعني أخبز بسلام

86
00:07:16,670 --> 00:07:19,200
اسمحي لي بإعطاء بعض
نصائح الخَبز لكِ إذاً

87
00:07:20,730 --> 00:07:24,210
الخَبز هو فُرصة لدسّ مادّة غريبة
في جسد هدفكِ

88
00:07:24,210 --> 00:07:26,340
يجب عليكِ الحرص على إنجاز العمل

89
00:07:29,660 --> 00:07:31,450
...كعكتي

90
00:07:32,090 --> 00:07:35,390
وما هذه الرّائحة الغريبة بالضّبط؟

91
00:07:35,390 --> 00:07:38,100
مهلاً، لا تنظري إليّ

92
00:07:38,340 --> 00:07:41,100
أنتِ سيّئة في الخَبز فحسب

93
00:07:41,810 --> 00:07:45,860
،كنتُ آمل الحصول على هذه الكعكة
لكن تبدو كريهة، لذا لا أُريد

94
00:07:45,860 --> 00:07:50,570
إلى اللّقاء. بالتّوفيق لكِ في علاقة
الحُبّ الهالكة هذه

95
00:07:51,450 --> 00:07:55,370
على أيّ حال، لا أصدّق كم أنّ القصر
مليء بالثّغرات الأمنيّة

96
00:07:55,890 --> 00:07:59,620
ربّما سآتي لاحقاً ثانية لأتفقّد
ماري بزيّ الخادمة الخاصّ بها

97
00:08:03,630 --> 00:08:04,630
تشغيل

98
00:08:05,370 --> 00:08:08,110
تمّ رصد خطر ذي أولويّة قصوى

99
00:08:08,110 --> 00:08:10,130
البدء بالفرم

100
00:08:11,670 --> 00:08:13,130
وقت شريحة الهامبرغر

101
00:08:13,130 --> 00:08:16,190
إذا كانت ماري 2 موجودة، فالأفضل
أن أُلغي أي زيارات إضافيّة

102
00:08:16,190 --> 00:08:17,750
سأغادر

103
00:08:19,390 --> 00:08:22,360
إعادة تشغيل النّظام الأمنيّ المُعطَّل

104
00:08:22,360 --> 00:08:24,140
تأسيس دوريّات

105
00:08:25,110 --> 00:08:28,900
انتهى المطاف به بعيداً تماماً
،عمّا تخيّلتُه

106
00:08:29,250 --> 00:08:32,790
لكن يسرّني أنّه يبدو لا بأس به
الآن بعد أن قمتُ بلفّه

107
00:08:34,070 --> 00:08:35,410
بدء وضع الطّاقة

108
00:08:46,350 --> 00:08:47,850
!كـ-كعكتي

109
00:08:47,850 --> 00:08:49,020
—أ-أنا آسفة حقّـ

110
00:08:49,020 --> 00:08:50,130
لا عليكِ

111
00:08:50,450 --> 00:08:53,420
بصراحة، لم أُعدّها بشكل مُتقَن

112
00:08:53,420 --> 00:08:56,460
انسي ذلك وركّزي على تعزيز الدّوريّات

113
00:08:56,460 --> 00:09:00,380
بالطّبع. عُلِم

114
00:09:08,850 --> 00:09:12,320
أعتقد لن أعطيها له في نهاية المطاف

115
00:09:13,450 --> 00:09:15,700
!سلوك وقح

116
00:09:15,700 --> 00:09:18,470
بالتّوفيق لكِ في علاقة الحُبّ الهالكة هذه

117
00:09:21,570 --> 00:09:26,830
فضلاً عن ذلك، من يدري ما إن كان
سيقبلها منّي تحديداً؟

118
00:09:27,210 --> 00:09:32,290
بالإضافة إلى هذا، يستحقّ أفضل
من مُحاولة فاشلة كهذه

119
00:09:33,210 --> 00:09:37,050
—إذا كنتُ سأحرج نفسي، فلا ينبغي لي

120
00:09:37,050 --> 00:09:38,610
ما الّذي تفعلينه يا ماري؟

121
00:09:39,220 --> 00:09:41,980
أ-أهلاً بعودتك، آرثر-ساما

122
00:09:41,980 --> 00:09:43,460
أشكركِ

123
00:09:43,460 --> 00:09:45,310
قضيتُ يوماً مُرهقاً آخر

124
00:09:45,900 --> 00:09:49,020
كان تجنُّب الهدايا بعد الدّوام
المدرسيّ عملاً مُجهِداً

125
00:09:50,630 --> 00:09:54,740
ليتني أستطيع معرفة نوايا النّاس
...من خلال تعابير وجوههم

126
00:09:55,300 --> 00:10:00,240
لكن بعد ما مررتُ به، لا يسعني
الوثوق بأيّ أحد منهم

127
00:10:00,240 --> 00:10:04,230
في النّهاية، اليوم لم يكن يوماً
جيّداً لأيّ شخص

128
00:10:05,710 --> 00:10:08,250
لا عجب في أنّني أكره أعياد الميلاد

129
00:10:09,500 --> 00:10:14,390
يُفترض لأعياد الميلاد أن تكون
مُناسبات مُبهِجة

130
00:10:14,390 --> 00:10:20,640
هذا صحيح. لم أرِد من آرثر-ساما
أن يكره هذا اليوم

131
00:10:22,270 --> 00:10:23,510
،آرثر-ساما

132
00:10:25,020 --> 00:10:28,100
عيد ميلاد سعيد

133
00:10:30,520 --> 00:10:34,270
،حتّى لو كنتَ تكره هذا اليوم

134
00:10:34,610 --> 00:10:36,930
أردتُ الاحتفال به

135
00:10:37,380 --> 00:10:42,780
لذا حمّلتُ وصفة وجرّبتُ إعداد... هذا

136
00:10:48,930 --> 00:10:50,150
بالطّبع

137
00:10:51,530 --> 00:10:56,010
ليس عليّ الشّعور بالاكتئاب في كلّ مرّة
يأتي فيها عيد ميلادي بعد الآن

138
00:10:57,940 --> 00:10:59,430
فلديّ أنتِ

139
00:11:00,300 --> 00:11:01,820
...آرثر-ساما

140
00:11:03,290 --> 00:11:05,020
أنا هنا لأجلك

141
00:11:06,220 --> 00:11:08,310
...وسأبقى هنا

142
00:11:09,830 --> 00:11:11,260
بجانبك تماماً

143
00:11:20,220 --> 00:11:24,740
خلطت ماري السّكّر مع الملح

144
00:11:27,740 --> 00:11:28,830
إنّه لذيذ

145
00:11:30,090 --> 00:11:33,070
ثمّة شيء أردتُكِ أن تفعليه
لأجلي منذ مدّة

146
00:11:39,770 --> 00:11:41,420
بدّلي لباسكِ بهذا

147
00:11:58,540 --> 00:11:59,870
هلّا فتحتُ الباب؟

148
00:11:59,870 --> 00:12:01,240
أجل، تفضّل

149
00:12:03,240 --> 00:12:04,950
المعذرة

150
00:12:07,730 --> 00:12:10,110
...آرثر-ساما، هذا الزيّ

151
00:12:10,500 --> 00:12:11,750
...تبدين جميلة

152
00:12:18,910 --> 00:12:20,260
يا آنسة ماري

153
00:12:22,810 --> 00:12:24,210
...ليس هنا بالتّحديد

154
00:12:26,710 --> 00:12:27,390
حسناً

155
00:12:30,470 --> 00:12:31,390
هكذا أفضل

156
00:12:31,780 --> 00:12:33,890
آرثر-ساما بارع جدّاً في هذا

157
00:12:38,930 --> 00:12:43,150
دائماً ما أطلب منكِ مُساعدتي
في الأمور كما تعلمين

158
00:12:58,900 --> 00:13:01,110
!هـ-هذا مُحرج للغاية

159
00:13:01,450 --> 00:13:04,670
ليس عليك فعل شيء يا آنسة ماري

160
00:13:04,670 --> 00:13:08,250
،إنّه يفعل كلّ هذه الأشياء الّتي أُحبّها لأجلي

161
00:13:08,860 --> 00:13:12,030
فلماذا أشعر بصِراع في داخلي؟

162
00:13:13,950 --> 00:13:17,200
آرثر-ساما، لديّ كومة هدايا لأجلك

163
00:13:17,200 --> 00:13:18,310
مهلاً لحظة

164
00:13:18,770 --> 00:13:22,170
أنا متأكّد بأنّني أعطيتُ تعليمات
بترك كلّ طلبيّات التّسليم في الخارج

165
00:13:23,570 --> 00:13:25,200
هل أنت جديد؟

166
00:13:25,820 --> 00:13:27,950
!أيّ عيد ميلاد هو هذا؟

167
00:13:28,370 --> 00:13:30,590
هذه إشارتي للتدخُّل

168
00:13:37,670 --> 00:13:43,500
بعد آخر مرّة، طوّرتُه إلى شيء قويّ بما يكفي
لشلّ حركة شخص بصعقة واحدة

169
00:13:45,970 --> 00:13:48,780
...لكن في العادة أكون أنا من

170
00:13:49,190 --> 00:13:50,910
فهمت

171
00:13:53,090 --> 00:13:56,100
!حان وقت ردّ الاعتبار

172
00:13:56,610 --> 00:13:57,530
آسفة

173
00:13:57,980 --> 00:13:59,980
هلّا انتظرت لحظة؟

174
00:14:08,750 --> 00:14:11,120
!لكن انتظرتُ كما طلبتِ

175
00:14:11,450 --> 00:14:13,940
أعلم سببَ شعوري بالحيرة

176
00:14:13,940 --> 00:14:16,500
...بدلاً من أن أكون محميّة

177
00:14:16,500 --> 00:14:18,910
المعذرة يا آرثر-ساما

178
00:14:19,710 --> 00:14:22,500
أريد أن أكون أنا من يحمي آرثر-ساما

179
00:14:22,500 --> 00:14:28,730
آرثر-ساما، يمكنك فعل أيّ شيء
يخطر على بالك

180
00:14:29,060 --> 00:14:32,760
أنا متأكّدة بأنّك ردعتَ المغتالين قبل
أن أصل إلى هنا

181
00:14:33,190 --> 00:14:39,940
لكن لأنّك تستطيع الصّمود بمفردك
أريد أن أحميك

182
00:14:41,330 --> 00:14:44,270
هل حمايتي لك تُزعجك؟

183
00:14:44,580 --> 00:14:48,300
لا، أحبّ حمايتكِ لي يا ماري

184
00:14:49,050 --> 00:14:51,470
يسرّني سماع ذلك

185
00:14:56,650 --> 00:14:58,790
!آرثر-ساما غاب عن الوعي؟

186
00:14:59,140 --> 00:15:00,750
هل اتّصلتِ بمُمرّضة المدرسة؟

187
00:15:00,750 --> 00:15:04,040
ليس بعد. قال أن أحضركِ على الفور

188
00:15:04,420 --> 00:15:07,550
!...آرثر-ساما، آرثر-ساما

189
00:15:07,550 --> 00:15:11,300
!وعدتُ أن أحافظ على سلامته

190
00:15:11,300 --> 00:15:13,260
إنّه خلف هذا الباب

191
00:15:17,140 --> 00:15:18,250
آرثر-ساما؟

192
00:15:28,320 --> 00:15:32,470
!أهلاً بكِ في نادي عشّاق الرّوبوتات

193
00:15:34,050 --> 00:15:36,830
قوّتكِ وسرعتكِ مُدهشتان

194
00:15:37,080 --> 00:15:42,530
لدرجة أنّنا بدأنا بالشّكّ بأنّكِ روبوت فعلاً
قد تمّ تطويره بواسطة شركة زيتيس

195
00:15:43,620 --> 00:15:45,940
لكن كان وقوعها في الخدعة سهلاً

196
00:15:45,940 --> 00:15:48,790
قد تكون مُجرّد روبوت رديء جدّاً

197
00:15:48,790 --> 00:15:54,340
لذا جوهريّاً، دعيناكِ إلى هنا لدراستكِ

198
00:15:54,340 --> 00:15:58,650
!دعيتموني؟ تقصدون بأنّكم اختطفتموني

199
00:15:59,230 --> 00:16:00,850
عليّ الخروج من هنا، والآن

200
00:16:00,850 --> 00:16:03,730
حسناً، لنُفكّكها

201
00:16:03,730 --> 00:16:05,490
!أجل

202
00:16:04,710 --> 00:16:06,880
لنبدأ بخلع ملابسها

203
00:16:06,880 --> 00:16:11,690
هل قام أحدٌ هنا من قبل بخلع
ملابس فتاة؟

204
00:16:16,620 --> 00:16:18,370
!توقّفوا

205
00:16:18,370 --> 00:16:21,370
!تبّاً! تمّ الإيقاع بنا

206
00:16:21,650 --> 00:16:25,880
إنّها روبوت! من صمّمها لاستهداف
!ضمائرنا بهذا الشّكل؟

207
00:16:25,880 --> 00:16:28,250
!لا يمكننا القيام بذلك

208
00:16:28,610 --> 00:16:31,180
هؤلاء أغبياء للغاية

209
00:16:31,180 --> 00:16:33,310
لن أصل إلى نتيجة هكذا

210
00:16:33,310 --> 00:16:37,390
في الواقع، لديّ نظام مُضادّ للجاذبيّة في قدمَي

211
00:16:37,910 --> 00:16:40,430
لذا أستطيع الحَوم لمسافة ثلاث
ميلّيمترات عن الأرض

212
00:16:40,890 --> 00:16:41,760
!ماذا؟

213
00:16:41,760 --> 00:16:42,530
!مستحيل

214
00:16:42,530 --> 00:16:44,580
!كذلك الشّيء الشّهير؟ تعرفينه

215
00:16:44,580 --> 00:16:46,270
!يا للتّكنولوجيا المُتطوّرة

216
00:16:46,270 --> 00:16:50,060
لكن سيكون من الصّعب أن أُريكم هكذا

217
00:16:50,490 --> 00:16:53,280
هلّا فككتُم قيدي عن العمود على الأقلّ؟

218
00:16:53,530 --> 00:16:55,140
!يجب أن أرى

219
00:16:55,140 --> 00:16:56,410
...ر-ربّما لا ينبغي لنا ذلك

220
00:17:08,920 --> 00:17:10,670
"لا أعلم ما إن كنتُ سأُسمّيه "حَوم

221
00:17:10,670 --> 00:17:12,550
إنّه مُجرّد قفز عاديّ، صحيح؟

222
00:17:13,950 --> 00:17:17,430
حتّى الرّوبوتات تكذب أحياناً

223
00:17:19,680 --> 00:17:20,600
!لقد هربتْ

224
00:17:20,600 --> 00:17:21,430
!الحقوا بها

225
00:17:28,560 --> 00:17:30,620
!هذا الرّوبوت خطير

226
00:17:30,620 --> 00:17:32,630
!لا مزيد من اللّطف

227
00:17:32,630 --> 00:17:33,880
!بئس الأمر

228
00:17:33,880 --> 00:17:36,300
!حان وقت التّفكيك! أحضروا مفكّاتكم جميعاً

229
00:17:36,300 --> 00:17:38,830
!تفكيك

230
00:17:37,420 --> 00:17:39,580
!فليُنقذني أحدٌ ما

231
00:17:42,190 --> 00:17:43,700
...آرثر-ساما

232
00:17:43,700 --> 00:17:45,560
كـ-كيف وجدتنا هنا؟

233
00:17:45,560 --> 00:17:46,490
!آرثر-ساما

234
00:17:46,490 --> 00:17:49,750
هل أنتم مهووسو روبوتات حقّاً؟

235
00:17:50,710 --> 00:17:52,870
!ماذا؟! جي.بي.أس؟

236
00:17:57,530 --> 00:18:00,720
!ابتعد عن بحثنا

237
00:18:05,770 --> 00:18:08,790
ماري مُلكي. لا يستطيع أحد
آخر الحصول عليها

238
00:18:08,790 --> 00:18:09,850
!سأحافظ على سلامتها

239
00:18:10,070 --> 00:18:14,350
أريد حماية آرثر-ساما، لكن انتهى
المطاف به يُنقذني من جديد

240
00:18:14,750 --> 00:18:16,050
هيّا بنا يا ماري

241
00:18:19,060 --> 00:18:20,990
...مـ-ملابسي التّحتيّة

242
00:18:23,510 --> 00:18:27,710
لا أستطيع أن أدع آرثر-ساما يراني
بهذه الحالة المُخزية

243
00:18:28,050 --> 00:18:30,500
لم تتضرّري، أليس كذلك يا ماري؟

244
00:18:31,740 --> 00:18:33,250
!يجب عليّ التّفكير سريعاً

245
00:18:33,600 --> 00:18:36,500
من أنت؟ لا أعرفك، أنا خائفة

246
00:18:36,850 --> 00:18:37,760
ماذا؟

247
00:18:40,740 --> 00:18:42,760
فقدتْ ماري ذاكرتها؟

248
00:18:43,090 --> 00:18:44,810
أجل، هذا صحيح

249
00:18:44,810 --> 00:18:48,790
يبدو أنّهم فعلوا شيئاً لمسح
بياناتها المُتعلّقة بي

250
00:18:48,790 --> 00:18:49,890
بياناتها؟

251
00:18:50,460 --> 00:18:51,890
أيّ هُراء هو هذا؟

252
00:18:51,890 --> 00:18:52,900
أنا آسفة

253
00:18:53,550 --> 00:18:56,610
الصّيانة قد تُصلح هذا الأمر

254
00:18:56,610 --> 00:18:58,040
—سآخذها اللّيلة و

255
00:18:58,040 --> 00:19:00,490
لا، سأجد طريقة ما

256
00:19:00,490 --> 00:19:02,490
!سأجعلها تتذكّر مهما كلّف الأمر

257
00:19:08,380 --> 00:19:10,070
...ا-المعذرة

258
00:19:13,060 --> 00:19:16,250
ماري، أنتِ لا تتذكّرين غالباً

259
00:19:16,250 --> 00:19:20,660
لكن لدينا سبعة مبادئ مُغازلة
نتّبعها كلّ يوم

260
00:19:21,850 --> 00:19:25,560
مـ-مبادئ ماذا؟ أيّ غبيّ يتّبع هذه؟

261
00:19:26,500 --> 00:19:29,430
لذا لنُحاول مُراجعتها

262
00:19:30,020 --> 00:19:30,950
...قد

263
00:19:31,930 --> 00:19:34,290
قد يساعدكِ هذا في تذكُّر شيء

264
00:19:34,290 --> 00:19:40,060
حسناً، أظنّني سأتماشى مع هذه
المبادئ" ثمّ أخبره بأنّني أتذكّر"

265
00:19:43,310 --> 00:19:46,080
أوّلاً، عِناق صباح الخير

266
00:19:46,620 --> 00:19:51,580
ثانياً، الإمساك بالأيدي في الطّريق من
وإلى المدرسة، مع تشابُك الأصابع

267
00:19:56,090 --> 00:19:59,090
...ثالثاً، طلب فتح الفم

268
00:20:03,390 --> 00:20:06,100
رابعاً، النّظر في عينَي بعضنا الآخر

269
00:20:09,600 --> 00:20:11,860
خامساً، وسادة الحضن

270
00:20:13,180 --> 00:20:16,360
سادساً، الرّبت على الرّأس

271
00:20:16,850 --> 00:20:18,790
مضى وقت طويل

272
00:20:24,430 --> 00:20:27,130
...أخيراً، المبدأ السّابع والأخير

273
00:20:31,650 --> 00:20:32,870
...هل يُعقَل أنّه

274
00:20:33,590 --> 00:20:35,410
هلّا أغمضتِ عينيكِ؟

275
00:20:36,710 --> 00:20:37,770
!توقّعت

276
00:20:40,020 --> 00:20:41,010
...قبلة

277
00:21:02,740 --> 00:21:05,530
أنتِ لا تتذكّرين حقّاً

278
00:21:07,610 --> 00:21:12,190
فقدتِ كلّ ذاكرتكِ عنّي

279
00:21:17,810 --> 00:21:19,790
أتذكّر

280
00:21:19,790 --> 00:21:26,570
بعد الاحتكاك معك، اكتشفتُ وضع
الحبيبة في برنامجي المركزيّ

281
00:21:27,380 --> 00:21:32,730
أثناء تحليل ذلك، حدّدتُ واستعدتُ
بياناتي المُتعلّقة بك

282
00:21:33,180 --> 00:21:35,330
!أنتِ تتذكّرينني يا ماري

283
00:21:35,330 --> 00:21:40,650
وأيضاً، لم نُبرِم أيّ اتّفاق رسميّ
بشأن المُغازلة

284
00:21:41,290 --> 00:21:43,190
،أنت تكره الأكاذيب

285
00:21:43,900 --> 00:21:46,700
ومع ذلك أرى بأنّك ما زلتَ تُمارسها

286
00:21:49,950 --> 00:21:55,960
،لو كان ذلك الاتّفاق حقيقيّاً"
"،لعدنا إلى المنزل يداً بيد

287
00:21:55,960 --> 00:22:00,960
كلاهما قالا لنفسيهما ذلك بنفس التّفكير

288
00:23:31,740 --> 00:23:35,550
ثانويّة كالميا تُواجه ثانويّة بيرينيال
في يوم الرّياضة المُشتركة السّنويّ

289
00:23:35,550 --> 00:23:38,510
سواء كان سِباق أكياس البطاطا أو معركة
ركوب الظّهر، سأفجّر كلّ طاقتي

290
00:23:38,510 --> 00:23:40,980
داريل؟ أعزّ صديق لآرثر-ساما؟