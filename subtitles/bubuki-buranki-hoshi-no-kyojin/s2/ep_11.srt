1
00:00:20,240 --> 00:00:22,830
،لا أصدِّق أنّه حتّى بقوّة باتالوف

2
00:00:22,830 --> 00:00:25,790
لا نؤثِّر به على الإطلاق

3
00:00:29,560 --> 00:00:30,840
...هذه

4
00:00:31,570 --> 00:00:34,340
هذه قدم ليتيشيا اليسرى

5
00:00:34,340 --> 00:00:36,930
حريّ بك استخدامها بعناية وإلّا ضربتك حتّى أفقدك الوعي

6
00:00:43,320 --> 00:00:48,710
إنّه رمحٌ مُلائم للبورانكي باتالوف والملك
المُستقبلي، جاستين ليون

7
00:00:50,040 --> 00:00:51,990
أقبلُ بقدم البجعة اليسرى

8
00:00:51,990 --> 00:00:54,070
وسأستخدمها بكلِّ امتنان

9
00:00:54,520 --> 00:00:55,570
حسناً إذاً

10
00:00:55,570 --> 00:00:59,070
!لنحطِّم رأس ذلك العجوز غي

11
00:01:09,900 --> 00:01:12,260
،وفقاً لكلمات الربّ

12
00:01:12,260 --> 00:01:15,360
نخلق هذه الأرض ونرعاها ونملؤها

13
00:01:15,360 --> 00:01:18,630
ونهيمن على كلّ الكائنات الحيّة

14
00:01:19,170 --> 00:01:24,280
ومع ذلك تبقى البشريّة خرقاء للأبد تتصارع فيما بينها

15
00:01:24,750 --> 00:01:28,430
،لكن بقوّة هذا الإله الجديد

16
00:01:28,430 --> 00:01:31,190
،تستطيع البشريّة، كجنس من الكائنات الحيّة

17
00:01:31,190 --> 00:01:34,650
أن تتطوّر للمرحلة المقبلة أخيراً

18
00:01:37,920 --> 00:01:38,980
ألم؟

19
00:01:41,550 --> 00:01:43,700
،حتّى بهذا الجسد العظيم

20
00:01:43,700 --> 00:01:47,370
!تسبّب قرصة برغوث ألماً؟

21
00:01:55,900 --> 00:01:59,050
!تبّاً، أنت قويّ! أنت صلبٌ كصخرة

22
00:01:59,050 --> 00:02:02,930
!يدايّ تؤلماني! أنا عطِشة، أنا أتضوّر جوعاً

23
00:02:05,950 --> 00:02:07,100
!إيبيزو

24
00:02:07,100 --> 00:02:08,080
!جاستين

25
00:02:10,810 --> 00:02:11,800
...غي

26
00:02:11,800 --> 00:02:13,730
،ستكونين التالية

27
00:02:13,730 --> 00:02:15,820
يا ابنة السّاحرة

28
00:02:24,580 --> 00:02:26,700
!جيّد! استيقظت

29
00:02:26,700 --> 00:02:28,340
أ-تشان، هل أنتَ بخير؟

30
00:02:28,340 --> 00:02:29,080
نعم

31
00:02:29,840 --> 00:02:30,860
أين نحن؟

32
00:02:30,860 --> 00:02:33,790
يبدو أنّنا داخل ذلك الجسم الضخم

33
00:02:33,790 --> 00:02:35,940
أ-تشان، أما زالت تُؤلمك؟

34
00:02:35,940 --> 00:02:38,930
لا. شكراً يا كوغاني-تشان

35
00:02:38,930 --> 00:02:43,300
ليتَ بقيّتنا نستطيع أن نتحمّلَ بعضاً من الألمِ عنك

36
00:02:43,630 --> 00:02:45,940
لا تكوني خرقاء يا كوغاني

37
00:02:45,940 --> 00:02:47,390
مُحال أن أرغب بذلك

38
00:02:47,390 --> 00:02:50,990
ماذا؟ تبّاً، يا لها من أنانيّة

39
00:02:50,990 --> 00:02:53,890
كما يُقال بالطبع، الشبابُ لا يتحمّلون الألم كذلك

40
00:02:53,890 --> 00:02:56,440
هيراغي، ملك الأنين من الألم

41
00:02:56,440 --> 00:02:57,570
ملِك الألم

42
00:02:57,570 --> 00:02:59,900
!ما قصّتكِ؟ اصمتي

43
00:02:59,900 --> 00:03:01,700
،ما أعنيه هو

44
00:03:01,700 --> 00:03:08,950
أنّنا نتمكّن من العملِ ككتلةٍ واحدة لأنّ أزوما
يتحمّلُ الألمَ عنّا، أليس كذلك؟

45
00:03:08,950 --> 00:03:10,300
...هي-كن

46
00:03:10,300 --> 00:03:13,460
هيراغي، تقولُ كلاماً لطيفاً في بعضِ الأحيان

47
00:03:13,460 --> 00:03:16,390
!في بعض الأحيان؟! ماذا تعنين بذلك؟

48
00:03:16,390 --> 00:03:18,160
!أقولُ كلاماً لطيفاً طوال الوقت

49
00:03:18,160 --> 00:03:21,080
!أنتِ لا تسمعين فحسب يا كينوا

50
00:03:21,080 --> 00:03:22,350
أجل، أجل

51
00:03:30,090 --> 00:03:31,770
شكراً يا هيراغي

52
00:03:33,200 --> 00:03:35,150
...شكراً يا كوغاني-تشان

53
00:03:35,670 --> 00:03:36,650
...كينوا

54
00:03:37,060 --> 00:03:37,980
شيزورو

55
00:03:38,810 --> 00:03:41,750
هذا صحيح. نحنُ كتلةٌ واحدةٌ الآن

56
00:03:42,140 --> 00:03:43,160
!هيّا بنا

57
00:03:44,290 --> 00:03:47,330
،لهزيمةِ غي وإنقاذ ريوكو

58
00:03:47,750 --> 00:03:48,910
!بصفةِ أوبو

59
00:03:49,360 --> 00:03:50,270
!نعم

60
00:04:01,020 --> 00:04:02,720
...كازوكي ميغيوا

61
00:04:03,260 --> 00:04:05,230
طفلتنا

62
00:04:06,400 --> 00:04:07,500
...ما الذي

63
00:04:08,000 --> 00:04:09,690
ما الذي تقوله يا أوبو؟

64
00:04:11,480 --> 00:04:14,540
!أوبو! أجبني أرجوك

65
00:04:34,290 --> 00:04:37,430
"نحن من تطلِقون عليهم بـ"بورانكي

66
00:04:37,830 --> 00:04:41,460
"خدَمٌ لـ"البداية العظيمة

67
00:04:41,460 --> 00:04:46,360
مهمّتنا هي تهيئة الكوكب الذي سيسكنُ فيه

68
00:04:49,420 --> 00:04:55,190
،لتجنُّب مصير سقوط "العظيم" كسيّدٍ لنا

69
00:04:55,560 --> 00:04:59,310
وصلنا إلى هذا الكوكب بعد رحلةٍ طويلة

70
00:04:59,750 --> 00:05:02,540
لكن "العظيم" لم يرغب

71
00:05:02,540 --> 00:05:06,570
بتعديلِ هذا الكوكب بما فيه من حياة مُفعمة بالحيويّة

72
00:05:07,000 --> 00:05:09,990
لهذا اختارَ أن يخلد إلى النّوم

73
00:05:11,350 --> 00:05:14,280
وهذا ما أدّى إلى تبعثرنا وضياعنا

74
00:05:15,100 --> 00:05:20,590
على مدى فترة طويلة من الزمن، أجسامنا
التي تفسّخَتْ في هذا الكوكب

75
00:05:20,590 --> 00:05:23,280
،بدأت تختلط مع البشر

76
00:05:23,280 --> 00:05:25,390
ليؤدّي ذلك إلى ائتلافٍ عميق

77
00:05:25,390 --> 00:05:28,540
في نهاية المطاف، وُلِدَ كائنٌ ما

78
00:05:31,190 --> 00:05:35,810
كائن حيّ يمكنُ أن يُدعى "بورانكي" أيضاً
رُغم أنّه من البشر

79
00:05:36,100 --> 00:05:38,980
والذي هو أنتِ يا ميغيوا

80
00:05:41,160 --> 00:05:45,540
،وحقيقة أنّكِ أنجبتِ أطفالاً

81
00:05:45,540 --> 00:05:48,710
لكن لم تنقلي قواكِ إليهم، هي الدليل

82
00:05:50,020 --> 00:05:50,970
...إذاً

83
00:05:51,660 --> 00:05:53,040
هذه هي إذاً

84
00:06:11,220 --> 00:06:13,440
!أزوما! ألغِ الاندماج

85
00:06:14,380 --> 00:06:16,670
!سنسبقُك ونمهّد طريقاً

86
00:06:16,670 --> 00:06:20,960
وذلك كي تتوجّه مباشرة نحو إنتيـه... نحو ريوكو

87
00:06:20,960 --> 00:06:22,130
...لكن يا هيراغي

88
00:06:22,130 --> 00:06:24,850
!أزوما! لا وقت للجدال

89
00:06:24,850 --> 00:06:25,740
...كينوا

90
00:06:25,740 --> 00:06:27,300
...اذهب يا أزوما

91
00:06:27,300 --> 00:06:29,070
يا قلبنا

92
00:06:29,370 --> 00:06:30,610
...شيزورو

93
00:06:30,610 --> 00:06:31,620
!أ-تشان

94
00:06:31,620 --> 00:06:34,620
!لا مانع من الانفصالِ الآن

95
00:06:34,620 --> 00:06:37,610
حتّى لو تفرّقنا، نحن نتشاطرُ نفس العقل

96
00:06:37,610 --> 00:06:38,620
!نعم

97
00:06:38,620 --> 00:06:39,950
...كوغاني-تشان

98
00:06:44,370 --> 00:06:47,380
!حسناً! أعتمدُ عليكم جميعاً

99
00:06:51,150 --> 00:06:52,930
!هيّا بنا يا تسوراراي

100
00:06:52,930 --> 00:06:54,840
!حان وقتُ التحليق يا إيواتوشي

101
00:06:54,840 --> 00:06:58,600
قطِّعاهم إلى أن لا يبقى منهم شيء يا هيميكيري وهويمارو

102
00:06:58,600 --> 00:07:02,690
ميغيتي-تشان، لكمة الصّاروخ بأقصى قوّة

103
00:07:15,990 --> 00:07:19,330
!انطلق يا أوبو

104
00:07:32,530 --> 00:07:33,090
...ريوكو

105
00:07:41,080 --> 00:07:44,250
ريوكو، أنتِ وأنا واحد

106
00:07:55,000 --> 00:07:59,370
لماذا؟ لماذا لا يحدث أي شيء؟

107
00:08:01,420 --> 00:08:02,660
...إنتيـه

108
00:08:03,160 --> 00:08:05,530
هل ماتَ بعد تعفّن دماغه؟

109
00:08:06,760 --> 00:08:10,880
...لكن في ذلك اليوم، آنذاك... أنا متأكّدةٌ أنَّ ريوكو

110
00:08:10,880 --> 00:08:15,390
ميغيوا، استُدعيتُ إلى هذا المكان ببساطة

111
00:08:15,390 --> 00:08:17,950
.كمُنبِّه لصحوتكِ

112
00:08:19,340 --> 00:08:24,970
آنذاك، انتقلَ كيانكِ إلى وجودٍ جديد

113
00:08:25,630 --> 00:08:27,990
نحن حالياً في الزمنِ الماضي

114
00:08:28,610 --> 00:08:33,150
،ذاتكِ الحاليّة تمتلكُ قوّة السفر عبر الزمن

115
00:08:33,680 --> 00:08:36,750
وكذلك قوى أعظم أخرى

116
00:08:39,880 --> 00:08:43,540
أشعرُ بأنّني أستطيع استيعاب هذا الآن

117
00:08:45,050 --> 00:08:47,540
،افعلي ما يجبُ فعله

118
00:08:47,960 --> 00:08:50,290
يا ابنتنا الحبيبة

119
00:08:51,380 --> 00:08:53,200
شكراً لك يا أوبو

120
00:09:03,260 --> 00:09:07,420
ريوكو، أنتِ وأنا واحد

121
00:09:59,540 --> 00:10:01,330
...هل كنتِ

122
00:10:01,330 --> 00:10:03,290
هناك دوماً؟

123
00:10:05,520 --> 00:10:08,830
كنتِ معي طوال الوقت يا ميغيوا

124
00:10:28,390 --> 00:10:30,990
!ريوكو

125
00:10:32,850 --> 00:10:33,990
ريوكو؟

126
00:10:35,300 --> 00:10:36,530
منذُ اليوم

127
00:10:37,320 --> 00:10:40,210
،الذي توقّفَ فيه الزمن بالنسبةِ لجسدي

128
00:10:40,640 --> 00:10:43,690
كلّ لحظة عشتُها كانَتْ بِلا طعم

129
00:10:44,710 --> 00:10:48,810
...بعد أن كانت ميغيوا لطيفة بما يكفي لمنحي هذه الحياة

130
00:10:49,860 --> 00:10:54,460
.كي لا أموت، لم أذق طعمَ الحياة أبداً

131
00:10:55,440 --> 00:10:56,440
...ريوكو

132
00:10:57,210 --> 00:11:01,340
لا أعتقد أنَّ الحياة لا طعم لها على الإطلاق

133
00:11:02,000 --> 00:11:04,490
أنتِ على قيدِ الحياة الآن

134
00:11:04,920 --> 00:11:10,060
مجرّد حقيقة وجودكِ على قيدِ الحياة تسعدني كثيراً

135
00:11:12,210 --> 00:11:14,010
هيّا بنا يا ريوكو

136
00:11:20,350 --> 00:11:21,360
...تبّاً

137
00:11:21,870 --> 00:11:24,250
مُصاب بجروحٍ دوماً

138
00:11:24,250 --> 00:11:25,620
أنا؟

139
00:11:25,950 --> 00:11:26,990
أجل

140
00:11:28,260 --> 00:11:30,370
شكراً لك يا أزوما

141
00:11:31,980 --> 00:11:32,500
العفو

142
00:11:34,870 --> 00:11:37,740
،مدّني بقوّتك كي نتمكّن من إيقافِ غي

143
00:11:39,050 --> 00:11:40,440
يا كازوكي أزوما

144
00:11:41,110 --> 00:11:43,640
نعم. بالطبع يا ريوكو

145
00:11:48,140 --> 00:11:50,320
!ميغيتي-تشان، تماسك

146
00:11:50,320 --> 00:11:53,810
هل وصلَ أزوما إلى إنتيـه فعلاً؟

147
00:11:54,250 --> 00:11:55,110
نيو نيو؟

148
00:11:56,810 --> 00:11:58,360
ما هذا؟

149
00:12:02,890 --> 00:12:05,330
!ما هذه النيران؟! إنّها ليست ساخنة

150
00:12:05,330 --> 00:12:07,240
ما هذا البورانكي؟

151
00:12:07,240 --> 00:12:10,130
أوبو؟ لا، ليس كذلك

152
00:12:10,500 --> 00:12:12,140
ولا إنتيـه أيضاً

153
00:12:12,560 --> 00:12:13,980
...إنتيـه-أوبو

154
00:12:13,980 --> 00:12:15,500
!لا فرق

155
00:12:19,590 --> 00:12:21,170
!هيّا بنا يا ريوكو

156
00:12:21,170 --> 00:12:23,960
!نعم! لنذهب معاً يا أزوما

157
00:12:33,020 --> 00:12:35,150
!أظنُّني لا أملُك خياراً سوى فعلها

158
00:12:38,060 --> 00:12:40,180
!ماذا الآن؟

159
00:12:41,780 --> 00:12:42,690
ما هذا؟

160
00:12:45,850 --> 00:12:47,770
كاوروكو، هنا

161
00:12:48,990 --> 00:12:50,750
ماذا؟ حسناً

162
00:12:54,760 --> 00:12:56,810
ما ذلك البورانكي؟

163
00:12:58,000 --> 00:13:01,570
هل اندمج إنتيـه وأوبو معاً؟

164
00:13:06,700 --> 00:13:09,600
،أيّاً كان نوع البورانكي الذي يواجهني

165
00:13:09,600 --> 00:13:11,810
!لن يكون ندّاً لي

166
00:13:26,200 --> 00:13:28,740
...إذاً هذه هي قوّة ريوكو وأزوما

167
00:13:28,740 --> 00:13:31,080
بعد اندماجهما ليُصبِحا إنتيـه-أوبو؟

168
00:13:36,820 --> 00:13:38,200
!انتهى الأمرُ يا غي

169
00:13:38,590 --> 00:13:40,710
!لن ندعك تفعل ما يحلو لك بعد الآن

170
00:13:41,360 --> 00:13:44,930
أيُّها الشيطان اللّعين الذي يُضحِّي بكلّ مُستخدمي

171
00:13:44,930 --> 00:13:48,340
...البوبوكي الصِّغار لتحقيقِ مآربه الشخصيّة

172
00:13:48,340 --> 00:13:51,720
!سأضعُ حدّاً لك

173
00:13:52,020 --> 00:13:53,830
...بانريو ريوكو

174
00:13:55,350 --> 00:13:57,730
...بما أنّ إنتيـه هنا فإذاً

175
00:14:06,320 --> 00:14:07,850
...كيف تجرؤين

176
00:14:07,850 --> 00:14:10,700
!كيف تجرؤين يا بانريو ريوكو؟

177
00:14:11,100 --> 00:14:13,330
!لن تفلتي بفعلتكِ هذه

178
00:14:20,330 --> 00:14:21,840
!أزوما! ريوكو

179
00:14:25,750 --> 00:14:31,350
سأدعكِ وإنتيـه تُلصِقان رأس الإله بجسدِه ثانيةً يا ريوكو

180
00:14:34,750 --> 00:14:35,740
!ريوكو

181
00:15:07,240 --> 00:15:08,920
...تبّاً لكم

182
00:15:08,920 --> 00:15:10,570
!تبّاً لكم

183
00:15:11,470 --> 00:15:12,590
ما هذا الضوء؟

184
00:15:15,510 --> 00:15:20,570
لكن بما أنّهم عادوا إلى هنا فلديّ
فُرصة للفوز

185
00:15:21,880 --> 00:15:24,750
لماذا تعترضون طريقي؟

186
00:15:25,070 --> 00:15:28,170
،سأعيد بِناء هذا العالم

187
00:15:28,170 --> 00:15:32,880
الذي لوّثَه اختلاط البشر والبورانكي معاً، من الصفر

188
00:15:33,180 --> 00:15:36,200
ستبدأ البشريّة بتاريخها الدمويّ

189
00:15:36,200 --> 00:15:41,210
!مرّة أخرى أمامي أنا، إلههم

190
00:15:41,210 --> 00:15:46,090
!هراء! يدك بحدِّ ذاتها مُلطَّخة بالدماء يا غي

191
00:15:47,620 --> 00:15:51,270
غي، لا أفهم ما تقوله

192
00:15:52,420 --> 00:15:55,710
ريوكو وأنا لم نفعل شيئاً سوى الاقتتال
فيما بيننا لفترةٍ طويلة

193
00:15:56,200 --> 00:15:58,090
تفكيري مختلف تماماً عن تفكيرها

194
00:15:58,530 --> 00:16:02,530
لكنّنا الآن نقود إنتيـه-أوبو معاً

195
00:16:03,090 --> 00:16:06,740
أنا سعيدٌ حقّاً بوجود ريوكو معي

196
00:16:07,820 --> 00:16:08,890
لهذا أعلم أنّك تخطئ

197
00:16:08,890 --> 00:16:14,700
عندما تحاولُ جعل هذا العالم يبدو تماماً كما
تريده أن يكون

198
00:16:15,190 --> 00:16:19,330
نحن لسنا ملعونين، ولسنا ملوّثين أيضاً

199
00:16:20,770 --> 00:16:24,900
!أيجرؤ طفل جاهل مثلك أن يتبجّح أمامي؟

200
00:16:25,290 --> 00:16:30,310
!سأقضي... سأقضي عليكما هنا وفي الحال

201
00:16:37,330 --> 00:16:42,810
ماذا ستفعلُ بي أنا، دِماغ الإله
ديوس ماغنا، أيّها الفتى الصغير؟

202
00:16:43,260 --> 00:16:47,310
هل ستحطّمُ ذلك القلب وتدخل الدماغ؟

203
00:16:48,330 --> 00:16:49,440
...أزوما

204
00:16:49,800 --> 00:16:51,280
أنت محقّ

205
00:16:51,750 --> 00:16:55,910
يجبُ ألّا نصغي لأحمق يظنُّ أنّ

206
00:16:55,910 --> 00:16:58,200
روح العدالة لديه هي المُطلَقة

207
00:16:58,690 --> 00:16:59,790
...ريوكو

208
00:17:00,290 --> 00:17:00,830
!نعم

209
00:17:07,940 --> 00:17:08,950
!مستحيل

210
00:17:09,280 --> 00:17:11,850
...أنا داخل دماغه

211
00:17:12,230 --> 00:17:14,760
!أنا دماغه! فكيف يتمكّنان من دفعي للخلف؟

212
00:17:17,130 --> 00:17:19,220
قلبان؟

213
00:17:51,830 --> 00:17:52,920
ريوكو؟

214
00:17:53,630 --> 00:17:56,940
أزوما، يجب ألّا تتّسخ يداك

215
00:17:58,000 --> 00:17:59,030
...ريوكو

216
00:18:13,250 --> 00:18:15,360
اسمعني يا ابن السّاحرة

217
00:18:17,370 --> 00:18:22,410
كازوكي أزوما، لم تعد بشريّاً عادياً

218
00:18:23,830 --> 00:18:27,530
الآن بعدما استخدمتَ قوّةَ البورانكي
لتحقِّق إرادتك

219
00:18:27,530 --> 00:18:31,520
حالما تنتهي هذه المعركة، ستعود
...إلى العالمِ البشريّ

220
00:18:31,920 --> 00:18:37,550
إلى الحياةِ المُملّة والقيام بنفس الأعمال
الدنيويّة يوماً بعد يوم

221
00:18:38,610 --> 00:18:40,560
،عندما تفعل ذلك

222
00:18:40,560 --> 00:18:44,420
أتعتقد أنّك ستكون قادراً على اعتبار حياة

223
00:18:44,420 --> 00:18:47,390
!الثّمل النّتِن الذي يعيش في الأحياء الفقيرة قيّمة؟

224
00:18:47,750 --> 00:18:51,270
!لن تستطيع بالطبع! مثلي تماماً

225
00:18:54,690 --> 00:19:00,650
تمَّ الاستيلاء على عقلِك بواسطة البورانكي يا كازوكي أزوما

226
00:19:30,900 --> 00:19:32,680
ماذا حلَّ بأزوما وريوكو؟

227
00:19:32,680 --> 00:19:34,380
!هل هما بخير؟

228
00:19:35,440 --> 00:19:36,900
لا أدري

229
00:19:38,440 --> 00:19:39,500
...هذا

230
00:19:43,650 --> 00:19:47,290
إنتيـه؟ ما الأمر؟

231
00:19:48,160 --> 00:19:50,660
ريوكو، سأذهب

232
00:19:50,980 --> 00:19:53,630
...ميغيوا؟ وعيكِ

233
00:19:54,700 --> 00:19:56,390
اسمعيني يا ريوكو

234
00:19:56,890 --> 00:20:00,240
...أتى هذا المذنّب إلى هنا لأجلي

235
00:20:00,760 --> 00:20:04,380
،ليحمِل أرواح عمالِقة المجرّة اللُّطفاء معاً

236
00:20:04,380 --> 00:20:05,640
والمتبعثِرة بين النجوم

237
00:20:06,640 --> 00:20:08,010
...لكن هذا

238
00:20:08,350 --> 00:20:12,870
ميغيوا، لم ألاحظ أبداً

239
00:20:13,500 --> 00:20:16,270
كنتِ بجانبي طوال الوقت

240
00:20:16,510 --> 00:20:18,790
لا تقلقي حيالَ ذلك أرجوكِ يا ريوكو

241
00:20:19,560 --> 00:20:25,290
بعد الاختلاط بإنتيـه، نسيتُ تماماً من أكون

242
00:20:25,820 --> 00:20:29,540
لكن أنا مسرورةٌ للغاية لتمكُّني من حمايتكِ
إلى هذا اليوم

243
00:20:30,620 --> 00:20:34,670
هذا أقلّ ما يمكنني فعله للتكفيرِ عن الخطأ
الذي ارتكبتُه آنذاك

244
00:20:35,640 --> 00:20:37,330
ماذا تقولين؟

245
00:20:37,330 --> 00:20:39,420
...طوال هذا الوقت، لهذا السبب نفسه أنا

246
00:20:55,340 --> 00:20:59,000
ريوكو، اعتني بأزوما وكاوروكو

247
00:21:10,960 --> 00:21:12,580
!اللّعنة

248
00:21:12,580 --> 00:21:15,950
!مجرّد الجلوس مكتوفة الأيدي والانتظار يستفزّني

249
00:21:15,950 --> 00:21:18,780
!هل أزوما وريوكو هزما غي أم لا؟

250
00:21:18,780 --> 00:21:20,460
!هل هما حيّان أم ميّتان؟

251
00:21:53,400 --> 00:21:54,790
...صوت

252
00:21:55,240 --> 00:21:56,710
...صوت أ-تشان

253
00:21:57,020 --> 00:21:59,290
!أسمعُ صوتَ أ-تشان ينادي

254
00:22:00,040 --> 00:22:01,550
!كوغاني

255
00:22:01,910 --> 00:22:04,430
تبّاً، إنّها لا تتحلّى بالصبر

256
00:22:04,430 --> 00:22:05,910
حسناً، أظنُّني سأذهبُ أيضاً

257
00:22:06,910 --> 00:22:07,890
!با-زوم

258
00:22:08,530 --> 00:22:10,080
تبّاً

259
00:22:13,110 --> 00:22:15,430
!انتظروا لحظة يا جماعة

260
00:22:18,430 --> 00:22:20,220
!تبّاً