1
00:00:54,010 --> 00:01:00,730
ستجد كلّ ما تحتاجه في متجر هوكّيوكو الكبير

2
00:01:01,440 --> 00:01:08,060
حقّق احتياجاتك من التسوُّق
!في متجر هوكّيوكو

3
00:01:09,100 --> 00:01:17,400
نلبّي كافّة طلباتك ونرحّب بك بابتسامة

4
00:01:17,530 --> 00:01:24,290
مُلتقى للجميع. متجر الأحلام

5
00:01:36,630 --> 00:01:37,840
!المعذرة

6
00:01:53,280 --> 00:01:54,440
أهلاً وسهلاً

7
00:01:55,780 --> 00:01:58,490
هل يمكنني خدمتك؟

8
00:02:01,500 --> 00:02:04,240
من أنتِ؟

9
00:02:04,830 --> 00:02:06,000
أنا؟

10
00:02:06,830 --> 00:02:08,120
أنا مُضيفة

11
00:02:10,630 --> 00:02:13,590
أهلاً بكِ في متجر هوكّيوكو الكبير

12
00:02:59,250 --> 00:03:03,510
اسمي آكينو. إنّه يومي الأوّل
في هذا المتجر

13
00:03:06,220 --> 00:03:09,300
زبائننا هم حيوانات بكافّة الأشكال والألوان

14
00:03:13,400 --> 00:03:17,860
زبائن بأجنحة، وآخرون بحافر

15
00:03:18,520 --> 00:03:22,030
زبائن صغار، وزبائن كبار

16
00:03:22,240 --> 00:03:26,580
والبعض الآخر جذّابون بصورة مُلفِتة

17
00:03:28,320 --> 00:03:29,410
!مُؤلم

18
00:03:41,430 --> 00:03:42,680
مرحباً

19
00:03:43,930 --> 00:03:46,680
هل يمكنني خدمتكما بشيء؟

20
00:03:47,550 --> 00:03:48,720
نحن نتفرّج فحسب

21
00:03:49,940 --> 00:03:51,400
عُلِم سيّدي

22
00:03:51,900 --> 00:03:52,900
ابتعدي عن طريقي

23
00:03:53,270 --> 00:03:55,150
!أ-أستميحك عذراً

24
00:03:55,440 --> 00:03:56,480
دعيني أمرّ

25
00:03:56,730 --> 00:03:58,230
--أنا حقّاً -
!ابتعدي -

26
00:03:58,350 --> 00:03:59,480
أنتِ تعترضين طريقي

27
00:04:03,450 --> 00:04:06,120
!أنا خجِلة جدّاً يا سيّد بطريق

28
00:04:06,620 --> 00:04:08,570
هل أنت بخير؟

29
00:04:08,740 --> 00:04:11,210
يا للهول! هل يتنفّس؟

30
00:04:11,580 --> 00:04:13,170
!استدعوا الطّبيب

31
00:04:13,290 --> 00:04:14,830
...هذا لا يُغتفَر

32
00:04:17,290 --> 00:04:18,920
!أنا آسفة حقّاً

33
00:04:19,550 --> 00:04:22,260
ينبغي ألّا تفقدي ابتسامتكِ

34
00:04:22,430 --> 00:04:22,930
ماذا؟

35
00:04:27,050 --> 00:04:28,340
هل لتعلمين

36
00:04:29,260 --> 00:04:34,060
الابتسامة اختُرِعَتْ بواسطة أكثر
حيوان عانى في هذه الأرض

37
00:04:35,600 --> 00:04:40,280
لذا أيّتها الآنسة الصّغيرة. هلّا
دفعتِ حوضي دفعةً قويّة؟

38
00:04:41,240 --> 00:04:43,240
حوضك يا سيّدي؟ -
أجل -

39
00:04:44,400 --> 00:04:46,070
دفعة قويّة

40
00:04:46,780 --> 00:04:48,660
على حوضك؟

41
00:04:49,160 --> 00:04:51,120
!أجل! دفعة قويّة

42
00:04:51,500 --> 00:04:53,040
!حـ-حاضرة

43
00:05:00,920 --> 00:05:03,010
اسمي آكينو

44
00:05:03,470 --> 00:05:05,260
!اليوم هو يومي الأوّل

45
00:05:05,760 --> 00:05:09,730
سُرِرتُ بلقائك. أنا المُضيفة موري

46
00:05:11,730 --> 00:05:14,560
أهلاً بكِ في متجر هوكّيوكو الكبير

47
00:05:20,440 --> 00:05:21,650
!سُرِرتُ بلقائكِ أيضاً

48
00:05:21,860 --> 00:05:26,740
المعذرة. أين مكتب البريد؟

49
00:05:26,860 --> 00:05:31,410
مكتب البريد في نهاية تلّة مُنحدِرة

50
00:05:31,710 --> 00:05:33,790
هلّا أمهلتِني لحظة؟

51
00:05:34,950 --> 00:05:35,950
بالطّبع

52
00:05:36,210 --> 00:05:37,500
أستأذن

53
00:05:39,410 --> 00:05:42,170
...إنّها رشيقة جدّاً

54
00:05:44,050 --> 00:05:45,380
!تذكّري أن تبتسمي

55
00:05:46,670 --> 00:05:50,640
تعابير وجهكِ تُوحي وبوضوح بأنّكِ
تلومين نفسكِ لارتكابكِ أخطاء

56
00:05:50,770 --> 00:05:53,390
هذا مرفوض! هذا طابق مبيعات

57
00:05:53,520 --> 00:05:55,470
رأيتِني...؟

58
00:05:56,060 --> 00:05:59,980
كوني حذرة! عيون السيّد تودو في كلّ مكان

59
00:06:00,280 --> 00:06:02,940
فأنتِ لا تُريدين طردكِ بينما
لا تزالين في فترة تجريب، صحيح؟

60
00:06:03,780 --> 00:06:05,820
!اسمي إيواسي. سُررتُ بلقائكِ

61
00:06:06,570 --> 00:06:07,940
!كذلك أنا

62
00:06:08,030 --> 00:06:11,870
سيّدتي، هل نضع حقائبكِ في خزانتنا؟

63
00:06:12,250 --> 00:06:14,120
أجل من فضلكِ

64
00:06:14,200 --> 00:06:17,450
يا للّطف! الفهود تُعاني من هشاشة
عِظام كما تعلمين

65
00:06:17,750 --> 00:06:18,750
!أحسني الأداء

66
00:06:21,920 --> 00:06:23,050
مرحباً

67
00:06:23,630 --> 00:06:25,090
المعذرة يا سيّدتي؟

68
00:06:25,670 --> 00:06:26,170
ماذا؟

69
00:06:26,760 --> 00:06:29,420
هل نُخزّن حقائبكِ؟

70
00:06:29,970 --> 00:06:31,140
حقائب؟

71
00:06:31,470 --> 00:06:35,890
تلك الّتي على ظهركِ. يمكننا
وضعها في خزانتنا

72
00:06:36,560 --> 00:06:39,100
هل قلتِ "حقائق" للتو؟

73
00:06:39,900 --> 00:06:40,440
ماذا؟

74
00:06:41,610 --> 00:06:44,480
هل سترمين بأطفالي في خزانة؟

75
00:06:46,440 --> 00:06:50,160
!أنا آسفة حقّاً يا سيّدة أبوسوم

76
00:06:56,080 --> 00:06:57,660
جيّد أنّه لم يرني أحد

77
00:06:58,030 --> 00:06:59,450
بالفعل

78
00:06:59,920 --> 00:07:02,170
سيّد تودو! أين أنت؟

79
00:07:02,340 --> 00:07:04,880
كمُدير طابق، يجب أن أحرص

80
00:07:04,960 --> 00:07:09,170
على ألّا تُهين المُضيفة الجديدة زبائننا

81
00:07:09,760 --> 00:07:12,140
يبدو أنّكِ تُعانين

82
00:07:13,220 --> 00:07:15,180
...لو سمحت يا سيّد تودو

83
00:07:15,760 --> 00:07:18,430
التّعامل مع الزّبائن ليس سهلاً

84
00:07:18,510 --> 00:07:22,110
بعضهم لا يحتاجون مساعدة

85
00:07:22,650 --> 00:07:25,020
لستُ خبيرة كالآخرين

86
00:07:26,190 --> 00:07:28,610
!انظري إلى عيونهم فحسب

87
00:07:29,990 --> 00:07:32,070
...عيونهم؟ لكن

88
00:07:33,830 --> 00:07:37,160
سيّد تودو! إلى أين ذهبت؟

89
00:07:40,130 --> 00:07:44,000
أتعطيها نصائح؟ هذا لطفٌ غير معتاد منك

90
00:07:44,210 --> 00:07:45,420
سيّد إيلولو

91
00:07:48,670 --> 00:07:51,720
"النّظر إلى عيونهم فقط"

92
00:07:52,850 --> 00:07:54,090
حقّاً؟

93
00:07:54,470 --> 00:07:57,640
سننزل -
!أمسكيني -

94
00:07:58,680 --> 00:08:02,270
!لا أستطيع تمييز الزّبون الّذي بحاجة مُساعدة

95
00:08:02,770 --> 00:08:04,560
من هنا

96
00:08:05,730 --> 00:08:08,480
أريد أن أتبوّل يا أمّي

97
00:08:08,860 --> 00:08:10,870
...النّظر إلى عيونهم

98
00:08:13,030 --> 00:08:14,070
...النّظر إلى

99
00:08:15,110 --> 00:08:16,950
عيونهم

100
00:08:20,540 --> 00:08:22,290
!من وجهة نظرهم

101
00:08:27,670 --> 00:08:28,960
أهلاً وسهلاً

102
00:08:30,180 --> 00:08:34,130
هل يمكنني خدمتك يا سيّد ابن مِقرض؟

103
00:08:34,300 --> 00:08:35,300
...هل أنتِ

104
00:08:36,510 --> 00:08:38,390
مُضيفة؟ -
!أجل -

105
00:08:38,510 --> 00:08:40,980
...حضرة المُضيفة

106
00:08:44,400 --> 00:08:47,060
!أحتاج نصيحتكِ

107
00:08:49,210 --> 00:08:52,760
أترين ذلكما الزّوجين البومين الضّاحكين؟

108
00:08:52,880 --> 00:08:53,880
أجل

109
00:08:54,300 --> 00:08:57,260
السيّد بوم هناك هو الرّئيس التّنفيذيّ
لشركة خدمة عُملاء

110
00:08:57,340 --> 00:09:00,430
أحضرتُهما إلى هنا لترفيهما

111
00:09:03,250 --> 00:09:06,580
يبدو أنّهما يستمتعان بوقتهما. هذا رائع

112
00:09:06,830 --> 00:09:08,830
هذا غير صحيح

113
00:09:09,000 --> 00:09:10,790
أستميحك عذراً؟

114
00:09:14,420 --> 00:09:15,500
!سيّد بوم

115
00:09:15,830 --> 00:09:20,130
هلّا سمحت لنا بنَيل شرف الاهتمام
بهذا الشّيء عنك؟

116
00:09:20,250 --> 00:09:24,540
لا ضرورة لذلك. من فضلك ضعها في كيس

117
00:09:24,750 --> 00:09:26,250
حاضر

118
00:09:27,330 --> 00:09:28,330
تفضّل من هنا سيّدي

119
00:09:28,500 --> 00:09:33,500
بفضلك، استمتعنا بالتسوُّق

120
00:09:36,580 --> 00:09:37,790
...هكذا إذاً

121
00:09:38,250 --> 00:09:43,750
،يشتري السيّد بوم كلّ شيء لنفسه
لذا أنت لا تُنجز مهمّتك

122
00:09:44,670 --> 00:09:48,250
من الصّعب ترفيه بعض الأثرياء

123
00:09:48,500 --> 00:09:51,830
هل لديك أي أفكار لي يا حضرة المُضيفة؟

124
00:09:54,000 --> 00:09:58,670
الزّبون راضٍ تماماً. كيف يمكننا إرضاءه أكثر؟

125
00:09:59,830 --> 00:10:03,130
!انظري إلى عيونهم فحسب

126
00:10:04,000 --> 00:10:07,670
!شاهدي الأمور من وجهة نظرهم
!كوني شديدة المُلاحظة

127
00:10:07,870 --> 00:10:11,080
أليست هذه المِحفظة جميلة أيضاً؟

128
00:10:11,250 --> 00:10:12,960
لنشترهما معاً

129
00:10:13,210 --> 00:10:16,080
كلّا! لا يمكنني شراءهما معاً

130
00:10:16,170 --> 00:10:17,710
...سيّد بوم! اسمح لنا

131
00:10:17,790 --> 00:10:21,670
يريد السيّد ابن مِقرض شراء
شيء للسيّد بوم

132
00:10:22,290 --> 00:10:25,250
أريد أن أُدلّل زوجتي اليوم

133
00:10:26,210 --> 00:10:29,210
يريد السيّد بوم إرضاء زوجته

134
00:10:30,000 --> 00:10:32,130
...زوجته

135
00:10:32,210 --> 00:10:33,710
كم مرّة يجب أن أخبرك؟

136
00:10:33,830 --> 00:10:36,330
أنا محتارة. كلتاهما جميلتان

137
00:10:37,500 --> 00:10:39,830
كلتاهما جميلتان؟

138
00:10:40,670 --> 00:10:45,500
من أنت؟

139
00:10:46,000 --> 00:10:50,830
!هذا قريب جدّاً

140
00:10:51,460 --> 00:10:52,670
!أتكلّم معك

141
00:10:54,790 --> 00:10:56,500
!المعذرة

142
00:10:57,420 --> 00:10:59,500
يا لها من شابّة طريفة

143
00:10:59,870 --> 00:11:01,960
سأختار هذه. هيّا بنا

144
00:11:02,920 --> 00:11:05,670
المعذرة. سوف نأخذ هذه

145
00:11:13,330 --> 00:11:14,830
!آنسة آكينو

146
00:11:15,170 --> 00:11:16,500
!سيّد تودو

147
00:11:16,630 --> 00:11:18,670
ماذا تفعلين بالضّبط؟

148
00:11:18,870 --> 00:11:23,170
!إنّهما زبونان في.آي.أي
!من فضلكِ لا تسيئي لهما

149
00:11:23,460 --> 00:11:24,460
في.آي.أي؟

150
00:11:24,540 --> 00:11:29,710
!حيوانات هامّة جدّاً! هؤلاء الزّبائن أنواع مُنقرضة

151
00:11:32,040 --> 00:11:35,500
!تفاعلها مع الزّبائن يُوتّرني

152
00:11:35,630 --> 00:11:37,750
اهدأ يا سيّد تودو

153
00:11:38,630 --> 00:11:42,920
...كنتُ مصدوماً قليلاً بلقائنا الأوّل أيضاً، لكن

154
00:11:43,170 --> 00:11:46,330
،لم تدُس عليك فحسب

155
00:11:46,670 --> 00:11:48,960
!بل نادتك بالبطريق أيضاً

156
00:11:49,080 --> 00:11:51,080
--لماذا هي

157
00:11:57,750 --> 00:11:58,960
سيّد تودو

158
00:11:59,790 --> 00:12:03,540
أعتقد بأنّ مُضيفتنا الجديدة تروقني

159
00:12:05,210 --> 00:12:08,580
انظر. يبدو أنّ لدينا زبون راضٍ هناك

160
00:12:15,250 --> 00:12:20,290
آكينو. زبون ظهر اليوم يطلبك

161
00:12:21,460 --> 00:12:23,790
!سيّد ابن مِقرض

162
00:12:23,960 --> 00:12:27,420
ودّعتُ الزّوجين في المطار للتو

163
00:12:27,580 --> 00:12:28,750
كيف سار الأمر؟

164
00:12:28,870 --> 00:12:31,080
أخذتُ بنصيحتكِ

165
00:12:32,250 --> 00:12:36,130
وأعطيتُ السيّدة بومة كلّ البضاعة
الّتي لم تخترها

166
00:12:36,290 --> 00:12:38,830
كهديّة منّا

167
00:12:40,580 --> 00:12:41,580
!يا إلهي

168
00:12:45,540 --> 00:12:48,250
!طارت فرحاً

169
00:12:48,330 --> 00:12:51,460
وذلك أسعدَ السيّد بوم كثيراً أيضاً

170
00:12:52,250 --> 00:12:55,710
!قدّم لنا طلباً بمشروع جديد

171
00:12:56,170 --> 00:12:57,710
!هذا مُبهر

172
00:12:57,830 --> 00:12:59,500
يعزو كلّ الفضل لكِ

173
00:12:59,630 --> 00:13:01,250
لا شكر على واجب

174
00:13:01,580 --> 00:13:04,830
غالباً تواجه النّساء صعوبة في الاختيار

175
00:13:05,250 --> 00:13:10,250
ثمّ تندمنَ على عدم شراء الشّيء
الّذي لم يستطعن اختياره

176
00:13:13,500 --> 00:13:17,420
أظنّني سأزور متجر هوكّيوكو كثيراً لاحقاً

177
00:13:17,630 --> 00:13:20,170
!سيكون هذا من دواعي سرورنا

178
00:13:22,080 --> 00:13:24,540
شكراً لكِ يا آنسة مُضيفة

179
00:13:25,630 --> 00:13:28,790
!نأمل خدمتكم من جديد قريباً

180
00:13:32,250 --> 00:13:35,210
لا بأس بذلك كيوم أوّل لك

181
00:13:35,330 --> 00:13:38,130
ارتكبتُ الكثير من الأخطاء

182
00:13:38,250 --> 00:13:41,750
لكن كان الزّبون سعيداً. هذا ما يهمّ

183
00:13:41,960 --> 00:13:43,460
!أجل -
...لكن -

184
00:13:43,580 --> 00:13:47,960
!لا تغترّي بنفسكِ! أنتِ تُوتّرينني

185
00:13:49,130 --> 00:13:52,630
كوني حذرة. السيّد تودو يُراقبنا دوماً

186
00:13:53,540 --> 00:13:54,790
شكراً لعملكِ

187
00:13:56,170 --> 00:13:57,500
يا آنسة مُضيفة

188
00:14:05,670 --> 00:14:09,670
!"قال، "شكراً لكِ يا آنسة مُضيفة

189
00:14:14,920 --> 00:14:16,750
انظر إلى هذه الأنياب

190
00:14:19,750 --> 00:14:23,170
لم يتوقّف أسلافنا الشُّجعان
،عن نفش ريشهم

191
00:14:23,290 --> 00:14:26,130
ليسقطوا ضحايا لتلك الأنياب
لعشرات آلاف السّنين

192
00:14:26,500 --> 00:14:30,330
من الواضح أنّ ريشك البرّاق
مُلفِت جدّاً للأنظار

193
00:14:30,710 --> 00:14:33,250
هل أُخفي ريشي الجميل؟

194
00:14:35,790 --> 00:14:38,080
أفضِّل إخفاءك

195
00:14:47,250 --> 00:14:48,370
!سيّدي

196
00:14:49,670 --> 00:14:54,870
!طقوس المُغازلة ممنوعة رجاء
قد تُزعج الزّبائن الآخرين

197
00:14:55,000 --> 00:14:56,080
تُزعج؟

198
00:14:56,790 --> 00:14:58,870
--أ... أقصد

199
00:14:58,960 --> 00:15:01,210
سامحني يا سيّدي

200
00:15:01,370 --> 00:15:06,080
ريش ذيلك الجميل قد يكون برّاقاً جدّاً

201
00:15:06,250 --> 00:15:09,420
لدرجة تُبهِر عيون زبائننا اللّيليّين الحسّاسة

202
00:15:09,540 --> 00:15:11,080
هل تمانع يا سيّدي؟

203
00:15:13,920 --> 00:15:16,960
يا له من مكان لئيم -
بالفعل يا عزيزتي -

204
00:15:17,540 --> 00:15:19,250
نشكر تفهّمكما

205
00:15:20,330 --> 00:15:22,330
!اختاري كلماتكِ بعناية

206
00:15:22,460 --> 00:15:26,830
الزّبائن الّذين يشعرون بإهانة
لن يعودوا أبداً على الأغلب

207
00:15:27,130 --> 00:15:28,420
!سأتوخّى الحذر

208
00:15:30,370 --> 00:15:32,630
لم أرَ أبي منذ سنوات

209
00:15:32,960 --> 00:15:35,130
كنتُ أبحث عن شيء أشتريه له

210
00:15:35,420 --> 00:15:36,750
حسناً يا سيّدتي

211
00:15:37,040 --> 00:15:42,000
هلّا أخبرتني بالمزيد عن أبيكِ؟

212
00:15:43,080 --> 00:15:44,420
ها هُم

213
00:15:45,040 --> 00:15:49,370
،إذا كان مُولعاً بالأشياء العتيقة
فهلّا اقترحتُ قلمَ حبر؟

214
00:15:50,000 --> 00:15:53,830
إنّه مُفيد لتدوين أشياء قد نسيَها

215
00:15:55,250 --> 00:15:58,290
مُبهر! شكراً لكِ

216
00:15:59,870 --> 00:16:04,250
"شابّة"
"شعر طويل وجميل"

217
00:16:06,670 --> 00:16:08,370
ماذا عن فِرشاة شعر؟

218
00:16:09,290 --> 00:16:10,540
فِرشاة شعر؟

219
00:16:10,630 --> 00:16:13,250
لدينا فِرشاة تجعل شعرها يلمع

220
00:16:13,370 --> 00:16:17,670
...مهلاً لحظة. يجب أن أدوّن ذلك

221
00:16:17,920 --> 00:16:20,130
يا له من قلم حبر جميل لديك

222
00:16:20,250 --> 00:16:27,870
،لطالما كنتُ كثير النّسيان. لذلك
كنتُ أدوّن المُلاحظات مؤخّراً

223
00:16:29,040 --> 00:16:32,920
يا إلهي. ساعتي مدفونة في فِرائي

224
00:16:33,040 --> 00:16:34,500
إنّها 5 مساء سيّدي

225
00:16:34,630 --> 00:16:36,290
شكراً لكِ يا عزيزتي

226
00:16:37,000 --> 00:16:39,330
حجزتُ في مطعم قريب

227
00:16:39,420 --> 00:16:42,330
مضى سنوات منذ رأيتُ ابنتي آخر مرّة

228
00:16:42,580 --> 00:16:45,250
إنّها مُمثّلة

229
00:16:45,750 --> 00:16:48,080
يا إلهي! مُمثّلة؟

230
00:16:48,710 --> 00:16:50,870
هل تريدين أن تري؟ -
أيمكنني؟ -

231
00:16:50,960 --> 00:16:53,630
...حدث ذلك قبل مدّة، لكن

232
00:16:54,000 --> 00:16:55,040
تفضّلي

233
00:16:55,130 --> 00:16:58,170
!إنّها جميلة جدّاً

234
00:17:00,580 --> 00:17:02,750
المعذرة. هل يمكنني؟

235
00:17:08,790 --> 00:17:10,540
!ماذا؟

236
00:17:11,630 --> 00:17:13,870
لنلفّ هذه

237
00:17:14,460 --> 00:17:15,370
شكراً لك

238
00:17:17,000 --> 00:17:19,920
لدينا ثلاث خيارات من الأشرطة

239
00:17:20,130 --> 00:17:22,130
...في الواقع -
!سيّدتي -

240
00:17:24,920 --> 00:17:27,750
...سيّدتي، بدلاً من قلم حبر

241
00:17:28,670 --> 00:17:31,040
ما رأيكِ بساعة جيبيّة؟

242
00:17:33,250 --> 00:17:36,870
ذكرتِ بأنّ أبيكِ مُولع بالأدوات العتيقة

243
00:17:37,170 --> 00:17:41,870
لدينا أقلام حبر فاخرة، لكن متجرنا

244
00:17:42,580 --> 00:17:47,330
يعتزّ بساعاته الجيبيّة والمُصنَّعة
بواسطة حِرفيّين خُبراء

245
00:17:47,460 --> 00:17:50,500
إنّها تليق بالكيمونو اليابانيّة كذلك

246
00:17:50,580 --> 00:17:54,290
يراودني إحساس بأنّه سيقول "ساعة جيب؟
"!كم هذا جميل

247
00:17:54,370 --> 00:17:57,580
ألا تعتقدين ذلك؟

248
00:17:59,000 --> 00:18:01,460
...حسنٌ إن كنتِ مُصرّة

249
00:18:02,130 --> 00:18:03,710
!خيار ممتاز

250
00:18:05,500 --> 00:18:08,460
تبدو هذه جميلة

251
00:18:09,250 --> 00:18:12,460
المعذرة، هل صفّفتِ شعركِ يا سيّدتي؟

252
00:18:12,750 --> 00:18:15,710
أجل، لأجل فيلمي المُقبل

253
00:18:15,920 --> 00:18:17,580
هل عرفتِني؟

254
00:18:17,750 --> 00:18:19,870
أتُمثّلين؟

255
00:18:19,960 --> 00:18:24,710
أجل. لكن ما زالت المعلومات
،حول الفيلم لم تكتمل

256
00:18:25,750 --> 00:18:27,420
لذا احتفظي بها سرّاً لو سمحتِ

257
00:18:29,790 --> 00:18:31,750
أستميحك عذراً

258
00:18:31,870 --> 00:18:35,420
!لن أتفوّه بكلمة

259
00:18:36,920 --> 00:18:38,420
أستأذن بالانصراف

260
00:18:44,130 --> 00:18:46,580
سوف ألفّ هذه

261
00:18:48,580 --> 00:18:51,540
لدينا ثلاثة خيارات من الأشرطة

262
00:18:52,420 --> 00:18:53,540
!سيّدي

263
00:18:55,040 --> 00:18:58,330
ما رأيك بوشاح بدلاً من فِرشاة؟

264
00:18:58,750 --> 00:19:01,920
يمكنك استخدامه كغطاء في الصّيف كذلك

265
00:19:02,330 --> 00:19:05,130
يمكنك ارتداءه بعدّة طُرُق. إنّه أنيق جدّاً

266
00:19:05,250 --> 00:19:08,750
!هكذا! أو هكذا! أو هكذا

267
00:19:09,330 --> 00:19:12,250
"!أنا متأكّدة بأنّها ستخبرك "كم هذا جميل

268
00:19:20,040 --> 00:19:21,580
...هذا مُطمئن

269
00:19:21,750 --> 00:19:23,040
آنسة أكينو

270
00:19:23,370 --> 00:19:24,500
!سيّد تودو

271
00:19:25,710 --> 00:19:29,000
هل تعرفين الخطأ الّذي اقترفتِه؟

272
00:19:29,420 --> 00:19:30,630
خطأ؟

273
00:19:30,920 --> 00:19:35,710
كنتُ أخشى أن يُقدّما لبعضهما الآخر
هديّة لم يكونا بحاجتها

274
00:19:35,790 --> 00:19:38,170
لا أقصد ذلك. قصدتُ مُلاحظاتك

275
00:19:38,290 --> 00:19:39,370
مُلاحظات؟

276
00:19:41,170 --> 00:19:42,250
هذه؟

277
00:19:43,040 --> 00:19:45,710
فِراء المينك قيِّم جدّاً

278
00:19:46,170 --> 00:19:50,580
قد يحاول بعض الأوغاد بيعه مقابل المال

279
00:19:52,080 --> 00:19:56,080
يجب أن تتعاملي مع بعض المعلومات
!الخاصّة بحرص شديد

280
00:19:56,420 --> 00:19:58,210
!حاضرة! أنا آسفة جدّاً

281
00:19:58,290 --> 00:20:00,330
لكن أبليتِ حسناً بخصوص الباقي

282
00:20:00,750 --> 00:20:01,420
حقّاً؟

283
00:20:04,250 --> 00:20:05,790
هل أطرى عليّ للتو؟

284
00:20:08,080 --> 00:20:11,750
!سـ-سيّد تودو! لا تفعل هذا مجدّداً من فضلك

285
00:20:27,870 --> 00:20:28,920
!يا للهول

286
00:20:34,870 --> 00:20:35,870
المعذرة

287
00:20:37,000 --> 00:20:38,920
...إذا رأيا بعضهما الآخر الآن

288
00:20:39,630 --> 00:20:41,420
!فذلك سوف يفسد المُفاجأة

289
00:20:52,500 --> 00:20:55,000
!لن ألحق

290
00:20:57,540 --> 00:21:01,540
أخفي ريشي الجميل؟ أفضّل إخفاءك

291
00:21:01,630 --> 00:21:03,080
!سيّد طاووس

292
00:21:04,040 --> 00:21:08,790
!طقوس المُغازلة ممنوعة رجاء
قد تُزعج الزّبائن الآخرين

293
00:21:10,040 --> 00:21:12,750
تُزعج؟

294
00:21:19,960 --> 00:21:20,750
!سيّدي

295
00:21:21,330 --> 00:21:25,750
أيّتها المُضيفة، الحُبّ لا يعرف زمناً ولا مكاناً

296
00:21:25,830 --> 00:21:26,920
!بالطّبع

297
00:21:29,920 --> 00:21:33,540
لكن قد يكون ريش ذيلك برّاقاً جدّاً

298
00:21:33,750 --> 00:21:37,290
لدرجة تُبهِر عيون زبائننا اللّيليّين الحسّاسة

299
00:21:37,750 --> 00:21:40,130
شكراً على تفهّمك

300
00:21:42,830 --> 00:21:45,960
يا له من مكان لئيم، أليس كذلك؟ -
بالفعل يا عزيزيتي -

301
00:21:46,130 --> 00:21:47,130
...أنا ممتنّة

302
00:21:49,460 --> 00:21:51,000
لكنا...

303
00:21:51,080 --> 00:21:52,210
آنسة مُضيفة

304
00:21:54,130 --> 00:21:56,290
قرّرتُ هذه

305
00:21:56,460 --> 00:21:58,750
!خيار ممتاز

306
00:22:00,040 --> 00:22:02,580
هل تعتقدين بأنّ أبي سيحبّها؟

307
00:22:03,250 --> 00:22:05,040
!أنا متأكّدة من ذلك

308
00:22:23,080 --> 00:22:26,460
،من بين كلّ أفكارها غريبة الأطوار
!استخدمتْ زبوناً كغطاء

309
00:22:26,630 --> 00:22:29,170
لديّ سؤال لك يا سيّد مدير الطّابق

310
00:22:29,750 --> 00:22:34,370
من سيصمد أكثر؟ القويّ أم الذّكيّ؟

311
00:22:34,790 --> 00:22:36,870
...يمكنني القول بأنّه

312
00:22:37,500 --> 00:22:42,500
القادر على التغيُّر والتكيّف مع بيئته

313
00:22:42,710 --> 00:22:43,870
!أصبت

314
00:22:45,630 --> 00:22:47,870
...لكن -
لكن؟ -

315
00:22:48,000 --> 00:22:49,920
"إنّ نظريّة "البقاء للأفضل

316
00:22:50,710 --> 00:22:53,460
لا تُفسّر التطوُّر الّذي لا يُلائم البقاء

317
00:22:54,290 --> 00:22:59,790
على سبيل المثال، ريش الطّاووس الجميل
يُلفت انتباه المُفترسين

318
00:23:01,000 --> 00:23:02,920
التطوُّر مُعقَّد

319
00:23:03,210 --> 00:23:04,750
...هكذا إذاً

320
00:23:05,080 --> 00:23:07,130
كيف حال الآنسة آكينو؟

321
00:23:07,250 --> 00:23:10,630
آمل أن تتمكّن من التكيُّف مع بيئتها بسرعة

322
00:23:10,710 --> 00:23:13,540
وذلك كي تتمكّن من الصّمود هنا

323
00:23:13,630 --> 00:23:16,370
...التكيّف، وإلّا

324
00:23:17,750 --> 00:23:18,920
وإلّا ماذا؟

325
00:23:39,670 --> 00:23:41,040
شكراً على الانتظار

326
00:23:41,540 --> 00:23:45,500
الريزوتّو الخاصّ بنا مُكوَّن من أرزّ كوشيهيكاري
وزعفران وزبدة وعشب بحريّ

327
00:23:45,630 --> 00:23:49,250
--ورُشَّ عليه كُسكُس القرنبيط مع

328
00:23:51,580 --> 00:23:55,330
--المعذرة. المُزيّن ببيمينتو حُلوة وعُصارة الحمّـ

329
00:23:55,630 --> 00:23:56,630
--الحمّـ

330
00:23:57,080 --> 00:24:01,170
مُزيّن ببيمينتو حُلوة مع عُصارة الحمّص

331
00:24:02,460 --> 00:24:05,040
أنا مُحرجة للغاية يا رئيس النّادلين

332
00:24:05,130 --> 00:24:08,170
ينبغي أن تُقدَّم القائمة كسردٍ انسيابيّ

333
00:24:08,250 --> 00:24:09,130
بالفعل

334
00:24:09,250 --> 00:24:11,710
هل من أفكار بشأن غرفة طعامنا الرّئيسيّة؟

335
00:24:12,370 --> 00:24:17,170
أنا مُندهشة بخدمة النّادلين الحريصة

336
00:24:17,790 --> 00:24:21,130
آمل أن تجدي ذلك مُلهِماً لكِ
في واجباتكِ كمُضيفة

337
00:24:21,790 --> 00:24:23,960
لهذا تتدرّبين هنا، صحيح؟

338
00:24:24,250 --> 00:24:26,870
...في الواقع، كنتُ أقول لنفسي

339
00:24:27,290 --> 00:24:30,250
ألن يكون من المناسب

340
00:24:30,370 --> 00:24:33,420
أن يتواجد جرس على كلّ مائدة؟

341
00:24:34,670 --> 00:24:36,750
كما في مقعد المُضيفة

342
00:24:43,830 --> 00:24:46,630
إنّهم يُعدّون الطّبق الرّئيسيّ الآن

343
00:24:47,330 --> 00:24:50,670
.بعضهم يطبخون لحم الصّويا
والبعض الآخر يصنع الصّلصة

344
00:24:51,040 --> 00:24:53,630
والبعض يقلي الخضراوات

345
00:24:53,830 --> 00:24:58,210
ورئيس المطبخ يتفقّد كلّ شيء

346
00:24:59,630 --> 00:25:03,040
أنت! لماذا رئيس النّادلين يتسكّع؟

347
00:25:03,790 --> 00:25:09,040
المسألة كلّها تتعلّق بالتّوقيت. عندما يجتمع
اللّحم والخضراوات والصّلصة معاً

348
00:25:11,580 --> 00:25:14,130
عندما يُقدَّم الطّبق للضّيف

349
00:25:14,790 --> 00:25:19,460
جميعنا نتعاون معاً لتقديم الوجبة المثاليّة

350
00:25:23,130 --> 00:25:26,580
!المطعم يعني التّعاون كفريق

351
00:25:31,460 --> 00:25:33,130
...التّعاون كفريق

352
00:25:39,580 --> 00:25:41,130
لديك موهبة

353
00:25:42,330 --> 00:25:45,920
أعتذر. لا بدّ أنّني أزعجك

354
00:25:46,130 --> 00:25:50,460
لا أبداً. هل أنت رسّام؟

355
00:25:50,630 --> 00:25:53,960
لا، أنا مجرّد طبّاخ باتيسري مُساعد

356
00:25:54,830 --> 00:25:58,290
المعذرة، هل تريدين تجربة واحد؟

357
00:25:59,000 --> 00:26:00,790
كم هذا ظريف! هل يمكنني؟

358
00:26:00,920 --> 00:26:03,250
أكيد -
شكراً لك -

359
00:26:03,710 --> 00:26:06,790
أنا من مُعجبي السيّد وولي

360
00:26:06,960 --> 00:26:09,870
من السيّد وولي؟

361
00:26:10,630 --> 00:26:14,080
السيّد وولي، الماموث. أحد أعظم
!النحّاتين على الإطلاق

362
00:26:14,210 --> 00:26:17,630
وهذه إحدى أعماله

363
00:26:17,790 --> 00:26:21,460
سامحني على جهلي رجاء

364
00:26:21,630 --> 00:26:25,370
...انظري إلى هذه المُنحنيات الجميلة

365
00:26:25,500 --> 00:26:28,170
--الآن بعد إمعان انّظر، إنّه نحت مُبهـ

366
00:26:31,040 --> 00:26:33,750
!ا-المعذرة يا سيّد بطريق

367
00:26:34,080 --> 00:26:36,210
هل أنت بخير؟

368
00:26:36,920 --> 00:26:41,040
أتتعلّمين من الزّبائن؟ ما زال
أمامكِ الكثير لتتعلّميه

369
00:26:41,130 --> 00:26:41,960
ماذا؟

370
00:26:42,630 --> 00:26:44,210
هل يمكنك رؤيتها؟

371
00:26:44,580 --> 00:26:47,370
مأساة وجمال المُتبقّيين الوحيدين في هذا الكوكب

372
00:26:47,500 --> 00:26:51,670
...والحبّ الاستثنائيّ الّذي يتشاركانه

373
00:26:52,130 --> 00:26:56,540
لم أكن مُدرِكة لحسّكِ الشّاعريّ
المُبهر يا سيّد بطريق

374
00:26:56,960 --> 00:26:59,170
ناديني بالرّومانسيّ

375
00:26:59,460 --> 00:27:02,670
لكن سأحيد عن الموضوع. حوضي من فضلك

376
00:27:03,330 --> 00:27:05,000
ألم تأتِ للأكل؟

377
00:27:05,210 --> 00:27:06,460
!دفعة قويّة من فضلكِ

378
00:27:10,670 --> 00:27:13,040
لماذا أتيت إلى هنا؟

379
00:27:14,790 --> 00:27:15,670
آكينو

380
00:27:16,130 --> 00:27:19,130
الذّئب اليابانيّ في الطّاولة 15

381
00:27:19,710 --> 00:27:20,870
ما رأيكِ؟

382
00:27:23,290 --> 00:27:26,630
...يبدو قلقاً بعض الشّيء

383
00:27:27,370 --> 00:27:30,330
هل سئمَ انتظار طعامه؟

384
00:27:30,500 --> 00:27:33,790
لا، لا. انظري إلى ما يمسك به

385
00:27:34,830 --> 00:27:36,130
علبة خاتم

386
00:27:36,290 --> 00:27:38,250
...تماماً. لذا

387
00:27:38,330 --> 00:27:43,630
يعتريه الحزن لأنّ حبيبته لم تأتِ

388
00:27:43,790 --> 00:27:45,460
هكذا إذاً

389
00:27:45,580 --> 00:27:49,420
قلتِ بأنّه سيكون من الملائم أن يتواجد جرس
،في كلّ طاولة. لكن إن كان كذلك

390
00:27:49,540 --> 00:27:55,040
فلن يعير النّادلون اهتماماً للزّبائن
إلّا عندما يقرع الجرس

391
00:27:57,790 --> 00:28:00,130
ثلاثون دقيقة بكأس من الخمر

392
00:28:00,210 --> 00:28:03,750
حان وقت التقرُّب من السّيّد الحزين يا آكينو

393
00:28:03,830 --> 00:28:04,630
ماذا؟

394
00:28:05,040 --> 00:28:08,540
عامليه بكلّ لطف وحنان لعلاج قلبه المفطور

395
00:28:08,750 --> 00:28:11,960
لكن بهدوء، وذلك كي لا يُلاحظ الزّبائن الآخرون

396
00:28:12,080 --> 00:28:13,630
أنا يا سيّدي؟

397
00:28:14,830 --> 00:28:18,500
عندما تخسر شيئاً، فإنّه يراودك شعور
أعظم ممّا كان يراودك من قبل

398
00:28:19,580 --> 00:28:20,330
ماذا؟

399
00:28:20,670 --> 00:28:23,000
غداً هو يوم آخر

400
00:28:23,500 --> 00:28:27,670
يتوقّف المطر دوماً. وتُشرِق
الشّمس دوماً

401
00:28:28,130 --> 00:28:30,790
عمّاذا تتكلّمين؟

402
00:28:33,500 --> 00:28:35,540
المعذرة! سامحني على وقاحتي رجاء

403
00:28:36,170 --> 00:28:40,000
فهمت. ظننتِ بأنّني رُفِضت، أليس كذلك؟

404
00:28:40,290 --> 00:28:41,830
!المعذرة يا سيّدي

405
00:28:42,000 --> 00:28:44,130
...في الواقع

406
00:28:44,960 --> 00:28:48,170
لم يبتعد ظنّكِ كثيراً

407
00:28:48,420 --> 00:28:49,210
ماذا؟

408
00:28:50,000 --> 00:28:55,210
أفكّر بالتقدّم لخطبة حبيبتي هنا
في الأسبوع المقبل

409
00:28:55,830 --> 00:28:58,000
كان اليوم مجرّد تجربة

410
00:28:58,170 --> 00:29:00,460
هكذا إذاً. هذا رائع

411
00:29:00,580 --> 00:29:04,630
لكن أشعر بتردُّد بعض الشّيء

412
00:29:05,750 --> 00:29:08,920
إنّها بعيدة عن منالي

413
00:29:09,540 --> 00:29:12,420
أظنّها تخرج معي فقط

414
00:29:12,540 --> 00:29:15,460
لأنّه لا يوجد ذِئاب يابانيّون آخرون

415
00:29:15,540 --> 00:29:16,670
يا إلهي

416
00:29:17,210 --> 00:29:21,790
ارتأيتُ بأنّ هذا المطعم الرّاقي سوف
يمدّني بشجاعة التقدّم لها

417
00:29:22,540 --> 00:29:25,750
لكن انتهى المطاف بي أبدو
كحبيب مهجور بدلاً من ذلك

418
00:29:27,500 --> 00:29:29,830
ربّما هذا ما كان يُفترض أن يكون

419
00:29:31,670 --> 00:29:32,790
،سيّد ذئب

420
00:29:35,080 --> 00:29:36,460
دع الأمر لنا

421
00:29:36,580 --> 00:29:37,330
ماذا؟

422
00:29:37,630 --> 00:29:41,040
أعِدُك بأنّنا سنجعل تقديم

423
00:29:42,330 --> 00:29:44,870
!الخاتم لها ممكناً

424
00:29:45,500 --> 00:29:46,540
ماذا؟

425
00:29:49,670 --> 00:29:50,670
ما الأمر؟

426
00:29:50,750 --> 00:29:53,080
هل كلّ شيء على ما يُرام
بخصوص تدريب المطعم؟

427
00:29:53,170 --> 00:29:54,750
...قطعتُ وعداً

428
00:29:55,420 --> 00:29:59,670
لا ينبغي أن أقطع وعوداً لا أستطيع
...الالتزام بها، لكن

429
00:29:59,750 --> 00:30:03,170
كيف لي أن أساعده في تقدُّم للخطوبة؟

430
00:30:04,170 --> 00:30:07,290
إنّ كلمة "لا" غير واردة في قاموس المُضيفة

431
00:30:07,670 --> 00:30:11,580
لا يمكننا، لا نملك، لا نعلم" كلّها كلمات مُحرّمة"

432
00:30:12,130 --> 00:30:16,370
!يجب تلبية توقُّعات الزّبون دوماً

433
00:30:18,290 --> 00:30:19,290
!حاضرة

434
00:30:21,460 --> 00:30:23,630
!سيّد ماروكي، يا لها من مفاجأة جميلة

435
00:30:23,830 --> 00:30:26,000
ماذا كنت تفعل منذ التّقاعد؟

436
00:30:26,210 --> 00:30:29,630
مع الأسف، غالباً ما أُعامَل كقمامة
...في المنزل في هذه الأيّام

437
00:30:29,790 --> 00:30:32,330
من هذا يا آنسة موري؟

438
00:30:32,830 --> 00:30:34,960
سيّد ماروكي، مُضيف مُخضرم

439
00:30:35,250 --> 00:30:40,130
إنّه مُتقاعد، لكنّه يأتي لمساعدتنا
عندما ننضغط في العمل

440
00:30:40,250 --> 00:30:41,830
هل يوجد مقهى جيّد في الجوار؟

441
00:30:42,040 --> 00:30:43,420
أمهليني بضع ثوانٍ رجاء

442
00:30:47,540 --> 00:30:49,710
هل لي أن أقترح هذه الخيارات الثّلاثة؟

443
00:30:51,460 --> 00:30:54,920
هذا مُبهر جدّاً يا سيّد ماروكي -
عرفنا بأنّنا نستطيع الاعتماد عليك -

444
00:30:55,000 --> 00:30:57,420
يا إلهي. انتقلت المقاهي الثّلاثة كلّها؟

445
00:30:59,630 --> 00:31:01,420
هل سيكون بخير؟

446
00:31:05,710 --> 00:31:07,000
هل يمكنني مساعدتك

447
00:31:08,920 --> 00:31:10,920
أبحث عن هذه الرّائحة

448
00:31:12,750 --> 00:31:16,040
الرّائحة خفيفة جدّاً لدرجة أنّها تلاشتْ تقريباً

449
00:31:16,250 --> 00:31:20,580
كانت الرّائحة لا تزال موجودة قبل شهرين
عندما وُضِعَتْ على هذا الكتاب

450
00:31:20,920 --> 00:31:23,290
لا أستطيع شمّها

451
00:31:23,750 --> 00:31:28,370
لكن إذا كان أسد يقول ذلك، فلا بدّ
أنّ الرّائحة كانت موجودة هنا قبل ذلك

452
00:31:28,750 --> 00:31:32,580
هل نحاول استحضار ذاكرتك؟

453
00:31:32,920 --> 00:31:33,960
ذاكرتي؟

454
00:31:35,420 --> 00:31:38,710
أيّهما أقرب؟ هذه أم تلك؟

455
00:31:40,040 --> 00:31:41,210
ربّما هذه

456
00:31:41,420 --> 00:31:43,210
إذاً قد تكون رائحة حامضيّة

457
00:31:44,290 --> 00:31:45,670
ماذا عن هذه؟

458
00:31:46,540 --> 00:31:48,290
ما زال بمقدوري شمّ الأُخرى

459
00:31:48,420 --> 00:31:50,710
المعذرة. لنبدأ من جديد

460
00:31:51,210 --> 00:31:54,130
هناك الكثير منها لدرجة لا أستطيع تمييز الفرق

461
00:31:54,290 --> 00:31:56,130
لا تستسلم يا سيّدي

462
00:31:56,250 --> 00:31:58,290
استنشق من منخرك الأيمن

463
00:31:59,750 --> 00:32:03,750
إنّه مُتّصل بجانب الدّماغ الّذي يُعالج الرّوائح

464
00:32:03,870 --> 00:32:05,290
...نكهة حامضيّة

465
00:32:09,580 --> 00:32:12,920
لدى هذه العطور رائحة حامضيّة طويلة الأمد

466
00:32:13,290 --> 00:32:14,420
ما الّذي يجري؟

467
00:32:14,540 --> 00:32:17,130
يحاول البحث عن عطر مُعيّن

468
00:32:17,250 --> 00:32:18,580
ما نوع العطر؟

469
00:32:19,000 --> 00:32:20,710
اشتمّي هذه العيّنة

470
00:32:20,830 --> 00:32:22,670
لو سمحت

471
00:32:22,870 --> 00:32:25,540
أنا أيضاً -
أريد التّجربة كذلك -

472
00:32:25,670 --> 00:32:27,130
...الجميع

473
00:32:27,250 --> 00:32:30,580
ماذا؟ أشتمّ رائحة ضعيفة

474
00:32:31,250 --> 00:32:34,370
!سيّدة دُبّ! حاسّة الشمّ لديكِ مُذهلة

475
00:32:34,580 --> 00:32:36,500
...ماذا؟ لكن هذه

476
00:32:36,580 --> 00:32:40,710
!هذه آديو برودينس بواسطة ماركور
!أنا مُتيقّنة من ذلك

477
00:32:41,460 --> 00:32:44,290
!يُعيدني هذا للذّكريات -
كانت مشهورة للغاية -

478
00:32:46,290 --> 00:32:48,000
...أنا آسفة حقّاً، لكن

479
00:32:49,330 --> 00:32:54,580
توقّفوا عن صنع آديو برودينس منذ سنوات

480
00:32:56,960 --> 00:33:02,500
هلّا فكّرت بهديّة أخرى لأمّك؟

481
00:33:02,670 --> 00:33:04,920
...على سبيل المثال -
لا بدّ أنّها كانت تلك -

482
00:33:07,750 --> 00:33:09,580
وإلّا فلا أستطيع الزّواج

483
00:33:11,080 --> 00:33:15,670
لا أستطيع الزّواج إذا لم
!أحصل على تلك الرّائحة

484
00:33:16,710 --> 00:33:17,920
الزّواج؟

485
00:33:19,080 --> 00:33:23,420
.تيسّا هي الأسد الأشهر في المدرسة
كان هذا شرطها

486
00:33:24,710 --> 00:33:29,960
ستتزوّجني إذا أحضرتُ لها العطر الموجود
على إشارة الكتاب المرجعيّة هذه

487
00:33:30,920 --> 00:33:32,000
...لكن

488
00:33:34,290 --> 00:33:36,170
...إن لم يكن هناك أمل من حصولي عليه

489
00:33:36,580 --> 00:33:41,580
!سيّدي، أمهلني قليلاً من الوقت لو سمحت

490
00:33:42,460 --> 00:33:45,960
!سأجد لك ذلك العطر

491
00:33:46,130 --> 00:33:47,630
!أعِدُك

492
00:33:53,290 --> 00:33:56,040
...فعلتُها من جديد

493
00:33:59,370 --> 00:34:06,170
إنّ كلمة "لا" غير موجودة في قاموس المُضيفة

494
00:34:08,130 --> 00:34:10,170
...ما أسهل الكلام

495
00:34:17,000 --> 00:34:19,170
ماذا؟ هل نحن نتباطأ؟

496
00:34:19,330 --> 00:34:21,460
يحدث هذا في كلّ مرّة

497
00:34:22,540 --> 00:34:24,170
أصعد فيها

498
00:34:28,250 --> 00:34:32,130
لكن لا مُشكلة. سنصل إلى هناك في النّهاية

499
00:34:32,420 --> 00:34:37,540
هل أنت السيّد وولي، النحّات؟

500
00:34:38,540 --> 00:34:43,500
أجل. أتيتُ لمُناقشة متحف الكريسماس الخاصّ بي

501
00:34:43,790 --> 00:34:47,460
النّحت خارج المطعم جميل جدّاً

502
00:34:47,630 --> 00:34:50,580
مأساة وجمال المُتبقّيين الوحيدين
في هذا الكوكب

503
00:34:50,710 --> 00:34:54,790
...والحُبّ الاستثنائيّ الّذي يتشاركانه

504
00:34:55,040 --> 00:34:59,170
شكراً لكِ. هل أنتِ في مُعضلة؟

505
00:35:00,210 --> 00:35:04,580
لأنّكِ كنتِ تأنّين وتتذمّرين

506
00:35:04,710 --> 00:35:10,000
أحاول حلّ مُشكلة لزبون

507
00:35:10,670 --> 00:35:11,750
هكذا إذاً

508
00:35:15,000 --> 00:35:17,750
ما طبيعة الزّبون؟

509
00:35:18,080 --> 00:35:20,420
هناك اثنان

510
00:35:20,540 --> 00:35:24,920
كلاهما يريدان التقدّم لخطبة الآخر
لكنّهما غير واثقين

511
00:35:25,080 --> 00:35:27,420
...أريد مساعدتهما، لكن

512
00:35:28,370 --> 00:35:32,000
جميعنا نفتقر للثّقة

513
00:35:32,960 --> 00:35:37,710
لستُ ماهراً في التّعبير، لذا عندما
...تقدّمتُ لخطبة زوجتي

514
00:35:56,420 --> 00:36:01,210
!في نحت جليديّ. يا لها من خطوبة رومانسيّة

515
00:36:01,790 --> 00:36:03,750
كان ذلك منذ زمن بعيد، بعيد جدّاً

516
00:36:03,920 --> 00:36:05,080
!هذا جميل جدّاً

517
00:36:08,370 --> 00:36:10,920
!شكراً لك يا سيّد وولي

518
00:36:17,870 --> 00:36:21,790
.يتطلّب هذا تعاوناً جماعيّاً
!أحتاج مُساعدة الجميع

519
00:36:21,960 --> 00:36:24,250
هل يمكنني أن أطلب هذا المعروف رجاء؟

520
00:36:24,750 --> 00:36:27,330
يبقى الوعد وعداً

521
00:36:28,420 --> 00:36:31,080
!أثِق بأنّني أستطيع الاعتماد عليكم جميعاً

522
00:36:31,540 --> 00:36:33,960
!إنّها غلطتك من الأساس

523
00:36:34,080 --> 00:36:37,630
ماذا إذا لم ينجح ذلك؟ -
!لن أتحمّل أي مسؤوليّة -

524
00:36:37,790 --> 00:36:39,790
ما هي استراتيجيّتك؟

525
00:36:42,080 --> 00:36:43,460
!سيّد رئيس الطبّاخين

526
00:36:43,750 --> 00:36:47,540
هذا لأجل في.آي.أي. أخبريني بخطّتكِ

527
00:36:48,420 --> 00:36:50,710
!باختصار: جليد

528
00:36:55,330 --> 00:36:57,370
يا له من مطعم جميل

529
00:36:57,790 --> 00:36:58,290
أجل

530
00:36:59,750 --> 00:37:02,000
ونحت جليدي جميل

531
00:37:02,540 --> 00:37:06,330
ليس للسيّد وولي تماماً، لكن
لا بأس به أيضاً

532
00:37:06,750 --> 00:37:08,750
أنت فنّان حقيقيّ أيّها الطبّاخ

533
00:37:09,460 --> 00:37:13,000
وبعد؟ عمّاذا أردت أن نتحدّث؟

534
00:37:13,210 --> 00:37:19,170
في الواقع، لكن... لنأكل أوّلاً ونتكلّم لاحقاً، حسناً؟

535
00:37:19,420 --> 00:37:20,630
إنّهما مُنسجمان

536
00:37:21,080 --> 00:37:23,170
في الوقت يا سيّد رئيس النّادلين

537
00:37:23,580 --> 00:37:26,080
ممتاز. لنستأنف الخطّة

538
00:37:26,540 --> 00:37:28,000
!إنّه وقت العشاء

539
00:37:37,000 --> 00:37:38,330
شكراً على الانتظار

540
00:37:38,870 --> 00:37:42,830
الريزوتّو الخاصّ بنا مُكوَّن من أرزّ كوشيهيكاري
وزعفران وزبدة وعشب بحريّ

541
00:37:43,080 --> 00:37:45,290
ورُشَّ عليه كُسكُس القرنبيط

542
00:37:45,460 --> 00:37:49,420
مُزيّن ببيمينتو حُلوة مع عُصارة الحمّص

543
00:37:49,960 --> 00:37:51,040
!يبدو هذا شهيّاً

544
00:37:51,750 --> 00:37:52,710
بالفعل

545
00:37:53,210 --> 00:37:54,210
!قلتُها

546
00:37:56,670 --> 00:38:00,370
البيمينتو وعُصارة الحمّص يُضفيان
لمسة حُلوة لطيفة

547
00:38:02,000 --> 00:38:04,290
!يا للهول! إنّه يشرب من إناء الأنامل

548
00:38:04,920 --> 00:38:06,130
...هذا سيّئ

549
00:38:08,580 --> 00:38:11,710
يحتوي هذا الماء على نكهة حامضيّة خفيفة

550
00:38:20,580 --> 00:38:21,710
أجل، بالفعل

551
00:38:24,210 --> 00:38:26,080
!يا لها من شابّة طيّبة القلب

552
00:38:41,790 --> 00:38:45,250
حسناً. انتهيا من التّحلية

553
00:38:46,080 --> 00:38:47,130
حان الوقت تقريباً

554
00:38:50,540 --> 00:38:51,790
المعذرة

555
00:38:53,420 --> 00:38:55,210
كيف كانت وجبتكما؟

556
00:38:55,290 --> 00:38:56,870
!خُرافيّة قطعاً

557
00:38:57,040 --> 00:38:58,540
يسرّني ذلك

558
00:38:58,960 --> 00:39:02,250
هل تريد بعض الشّاي؟

559
00:39:02,750 --> 00:39:06,370
رائحتها لطيفة جدّاً. لا بدّ أنّه الياسمين

560
00:39:09,750 --> 00:39:11,130
المعذرة

561
00:39:22,750 --> 00:39:24,370
ما زلتُ أتذكّرها

562
00:39:25,250 --> 00:39:30,670
عندما التقيتُ بك أوّل مرّة، كانت زهور
الياسمين البيضاء تتفتّح

563
00:39:31,290 --> 00:39:32,710
أتتذكّرين ذلك؟

564
00:39:32,870 --> 00:39:34,080
بالطّبع

565
00:39:35,540 --> 00:39:38,170
،في كلّ عام من هذه الفترة

566
00:39:39,000 --> 00:39:41,460
أقول لنفسي كم أنا مسرورة بلقائنا

567
00:40:04,540 --> 00:40:05,710
...هلّا

568
00:40:08,170 --> 00:40:11,170
،يسقط الخاتم مع ذوبان الجليد

569
00:40:11,290 --> 00:40:15,000
الطّعام الّذي تمّ إعداده وتقديمه
...بالوتيرة الصّحيحة

570
00:40:15,750 --> 00:40:18,000
كان تعاوُناً جماعيّاً مُبهراً

571
00:40:19,460 --> 00:40:20,580
...والآن

572
00:40:22,290 --> 00:40:24,830
ماذا عن وعدها الآخر؟

573
00:40:26,330 --> 00:40:29,870
أنا آسفة حقّاً

574
00:40:31,250 --> 00:40:35,080
أخشى بأنّني لم أجد العطر الّذي وعدتُ به

575
00:40:35,710 --> 00:40:39,370
مع الأسف، نحن غير قادرين على تلبية طلبك

576
00:40:41,460 --> 00:40:46,000
نرغب في التّوصية بخيارات بديلة

577
00:40:46,290 --> 00:40:50,370
لا يهمّ. أنا آسف لأنّني عرّضتُك
لكلّ هذه المتاعب

578
00:40:54,210 --> 00:40:55,330
!سيّدي

579
00:40:56,080 --> 00:40:57,250
!مفاجأة

580
00:40:58,370 --> 00:41:01,330
ماذا لدينا هنا؟ عملة معدنيّة

581
00:41:03,630 --> 00:41:04,920
سيّد ماروكي؟

582
00:41:05,290 --> 00:41:09,580
كم هذا غريب. هناك شيء على كتفك يا سيّدي

583
00:41:10,080 --> 00:41:10,960
تفضّل

584
00:41:12,580 --> 00:41:13,920
...هذه القنينة

585
00:41:20,500 --> 00:41:22,500
!إنّه ذلك العطر

586
00:41:22,960 --> 00:41:27,290
!سحر المُضيف

587
00:41:27,960 --> 00:41:33,080
يعثر على عطر خامل في مكان ما
من هذا العالم

588
00:41:33,330 --> 00:41:37,580
ويفاجئ الزّبون ليجعل الأمر يبدو
وكأنّ العطر ظهر بالسّحر

589
00:41:37,670 --> 00:41:42,960
نتاج سنوات من العلاقة المبنيّة
مع رُعاة هذا المتجر

590
00:41:43,630 --> 00:41:48,460
.من فضلك تعامل معها بحرص
قد تكون آخر قنينة من هذا النّوع

591
00:41:49,210 --> 00:41:51,040
...حالما تزول

592
00:41:51,960 --> 00:41:54,670
فحتّى السّحر لن يُعيدها

593
00:41:55,790 --> 00:41:56,920
!شكراً لك

594
00:41:59,130 --> 00:42:00,330
آنسة مُضيفة

595
00:42:03,670 --> 00:42:04,790
!شكراً لكِ

596
00:42:06,750 --> 00:42:09,750
،مهمّة التقدُّم للخطوبة المُزدوج
تمّ إنجازها بنجاح

597
00:42:10,080 --> 00:42:15,580
هذه هي نتيجة تكاتُف الجميع لتحقيق
وعود طائشة من شخص غرّ

598
00:42:17,580 --> 00:42:22,170
لكن لولا الآنسة آكينو، ما كنّا
عرفنا حاجات الزّبائن

599
00:42:22,580 --> 00:42:24,830
إنّه تعاون جماعيّ ممتاز

600
00:42:26,040 --> 00:42:30,130
إنّهم يُعرقلون العلاقات العاطفيّة
الخاصّة بالأنواع المُنقرضة

601
00:42:30,210 --> 00:42:34,370
مُعتقدين بأنّهم يمارسون عمل الربّ
بتعزيز فكرة التّناسُل

602
00:42:34,790 --> 00:42:36,130
سيّد توكيوا

603
00:42:37,080 --> 00:42:39,790
تُساورني شكوك

604
00:42:39,920 --> 00:42:44,830
بخصوص استئجار تلك المُضيفة المُتدرِّبة رسميّاً

605
00:42:47,420 --> 00:42:50,080
مُستشار إعادة هيكلة؟

606
00:42:50,210 --> 00:42:53,920
أجل. نِظام مُطبَّق بشكل سرّي
لتعزيز التّنافس

607
00:42:54,040 --> 00:42:56,630
بين المُوظّفين

608
00:42:56,790 --> 00:43:02,080
لمُراقبة المتجر وغربلة العُمّال عديمي الكفاءة

609
00:43:02,790 --> 00:43:05,710
هل هذا يعني بأنّني مطرودة؟

610
00:43:05,870 --> 00:43:09,370
هذا مُؤسف لأنّكِ لستِ مُوظّفة حتّى بعد

611
00:43:09,540 --> 00:43:11,040
!يا إلهي

612
00:43:11,920 --> 00:43:13,420
!أمزح، أمزح

613
00:43:15,960 --> 00:43:20,210
!كنتُ هنا قبلكِ أيّتها المُضيفة
!هذا ليس عدلاً

614
00:43:20,330 --> 00:43:24,370
عندما خرجتُ من المصعد، وجدتُ
!نفسي في آخر الطّابور

615
00:43:24,710 --> 00:43:26,250
أنا آسفة

616
00:43:26,580 --> 00:43:31,830
هذه غلطتنا لعدم انتباهنا للأشخاص
!الّذين ينتظرون في الطّابور

617
00:43:32,080 --> 00:43:36,750
أريد أن تنمو تلك النّبتة بين الصُّخور

618
00:43:37,080 --> 00:43:42,580
عن إذنك يا سيّدي، لكن حوض
الأسماك هذا هولوغراميّ

619
00:43:45,250 --> 00:43:50,080
لكن قد يتواجد النّبات في الصّورة في مكان ما

620
00:43:50,210 --> 00:43:52,670
سأتفقّد الأمر لأجلك حالاً

621
00:43:52,790 --> 00:43:57,920
آكينو تتعلّم. لن تفشل بتلك السّهولة

622
00:43:58,080 --> 00:44:01,790
يبدو أنّك تُعجَب بها شيئاً فشيئاً يا سيّد تودو

623
00:44:01,920 --> 00:44:07,130
...ماذا؟ أنا مجرّد مُدير طابق مهتمّ بالجديدة

624
00:44:11,540 --> 00:44:16,580
أيّتها المُضيفة، أبحث عن فُستان حفلة جديد

625
00:44:16,710 --> 00:44:20,080
ملابس النّساء في الطّابقين 3 و 4

626
00:44:20,210 --> 00:44:26,330
،إذا سرتِ بشكل مستقيم في هذا الممرّ
...فستجدين مصاعد

627
00:44:30,250 --> 00:44:31,670
ها هو ذا

628
00:44:31,960 --> 00:44:34,580
شكراً لكِ على المجيء معي

629
00:44:34,750 --> 00:44:37,670
استمتعي بتسوّقكِ

630
00:44:40,250 --> 00:44:41,750
المُضيفة

631
00:44:44,080 --> 00:44:46,580
هلّا ساعدتني في الاختيار؟

632
00:44:49,870 --> 00:44:50,960
جميل

633
00:44:52,040 --> 00:44:53,170
رائع

634
00:44:54,080 --> 00:44:56,130
يليق بكِ كثيراً

635
00:44:57,330 --> 00:44:59,080
آسفة على إزعاجك

636
00:44:59,630 --> 00:45:01,290
!عـ-على الإطلاق

637
00:45:01,460 --> 00:45:07,040
أتوتّر ولا أستطيع التكلّم عندما
ينتظرني مُوظّف

638
00:45:07,830 --> 00:45:11,210
يسرّني أنّكِ هنا

639
00:45:13,130 --> 00:45:14,630
هذا يليق بكِ بشكل مثاليّ

640
00:45:14,920 --> 00:45:17,920
حقّاً؟ سوف آشتريه إذاً

641
00:45:18,670 --> 00:45:23,460
استغرقتِ وقتاً طويلاً. آسفة، لكن
سألغي كلّ هذه الفساتين

642
00:45:24,670 --> 00:45:29,920
،الآن بعد أن قرّرتُ شراء هذا العِقد
لا يليق معه إلّا هذا الفستان الأبيض

643
00:45:30,210 --> 00:45:31,540
ألا تُوافقينني؟

644
00:45:31,670 --> 00:45:32,830
...أ-أكيد

645
00:45:33,330 --> 00:45:35,670
هل لديكم منه بمقاس أكبر؟

646
00:45:35,790 --> 00:45:37,790
...أنا آسفة

647
00:45:38,330 --> 00:45:42,870
هذا الوحيد الّذي لدينا في المتجر حالياً

648
00:45:43,000 --> 00:45:44,370
حضرة المُضيفة

649
00:45:45,130 --> 00:45:46,130
!حـ-حاضرة

650
00:45:46,330 --> 00:45:49,370
أليس هذا متجر هوكّيوكو، "حيث
ستجد كلّ ما تحتاجه"؟

651
00:45:49,540 --> 00:45:52,330
أجل، سوف نطلبه حالاً

652
00:45:52,500 --> 00:45:55,000
!أريد حالاً

653
00:45:55,130 --> 00:46:00,040
"بكلّ تأكيد يا سيّدتي. سنُحدّده كعمل طارئ

654
00:46:00,250 --> 00:46:03,130
أنتِ مُضيفة لطيفة جدّاً

655
00:46:03,250 --> 00:46:06,710
من الواضح أنّكِ نادمة حقّاً

656
00:46:07,290 --> 00:46:10,460
أنا كذلك بالفعل يا سيّدتي

657
00:46:11,000 --> 00:46:13,630
هل تعرفين ماذا يعني "خدمة"؟

658
00:46:16,080 --> 00:46:19,250
"إنّها مُستمدّة من كلمة "سارفانت

659
00:46:20,330 --> 00:46:23,170
عندما لا تُلبّي الخادمة توقُّعات سيّدها

660
00:46:23,290 --> 00:46:28,670
فأعتقد بأنّها ستحاول جاهدة لتصحيح الأمور

661
00:46:30,080 --> 00:46:34,000
أنا لا أطلب منك الاعتذار

662
00:46:34,250 --> 00:46:35,960
أو التذلّل

663
00:46:38,580 --> 00:46:40,920
"الزّبون أشبه بإله"

664
00:46:42,790 --> 00:46:44,920
ألم يعلّموكِ ذلك؟

665
00:46:45,330 --> 00:46:49,000
كلمة "لا" غير موجودة في قاموس المُضيفة

666
00:46:49,250 --> 00:46:53,920
!يجب الارتقاء دوماً لتوقُّعات الزّبون

667
00:46:56,330 --> 00:46:57,210
أجل

668
00:47:04,670 --> 00:47:09,580
--أنا آسفة لأنّنا لم نستطع الارتقاء لتوقّـ

669
00:47:11,710 --> 00:47:14,000
سأتولّى هذا يا آكينو

670
00:47:15,870 --> 00:47:20,170
من فضلكِ اقبلي اعتذارنا
عن أيّ إزعاج كنّا قد سبّبناه

671
00:47:20,420 --> 00:47:24,250
لكن مع الأسف ليس لدينا الفستان الآن

672
00:47:24,370 --> 00:47:29,040
هلّا طلبنا منكِ المُغادرة اليوم لو سمحتِ؟

673
00:47:29,670 --> 00:47:30,630
عفواً؟

674
00:47:31,210 --> 00:47:34,000
المُغادرة؟ عمّاذا تتكلّمين؟

675
00:47:34,170 --> 00:47:38,540
هذه غلطتكِ، ومع ذلك تجعلينني
!أبدو غير عقلانيّة

676
00:47:38,630 --> 00:47:40,670
!هذا غير معقول

677
00:47:42,500 --> 00:47:45,630
،إذا كان الزّبون أشبه بإله

678
00:47:45,710 --> 00:47:49,420
لكن هلّا أخفضتِ صوتكِ رجاء؟

679
00:47:50,250 --> 00:47:53,870
فبعض الآلهة الآخرين في المتجر
قد ينزعجون من ذلك

680
00:48:19,670 --> 00:48:22,670
!لن أعود إلى هذا المتجر ثانية

681
00:48:23,040 --> 00:48:24,250
!سيّدتي

682
00:48:26,000 --> 00:48:28,000
سوف أرافقها لوداعها

683
00:48:28,130 --> 00:48:29,210
!سأذهب أيضاً

684
00:48:29,790 --> 00:48:32,250
ينبغي لكِ أن تعودي

685
00:48:43,080 --> 00:48:46,960
فقمة الرّاهب الكاريبي تعيش في البحر الكاريبي

686
00:48:47,670 --> 00:48:51,670
قلّة حذرهم جعلتهم فريسة سهلة للصيّادين

687
00:48:51,830 --> 00:48:55,080
الّذين ابتغوا دهونها لتزييت المكنات

688
00:48:55,710 --> 00:48:59,040
انقرضَتْ في عام 1952

689
00:49:00,080 --> 00:49:02,000
من أنت؟

690
00:49:02,330 --> 00:49:06,170
اللّطف الزّائد عن اللّزوم يؤدّي
إلى الدّمار الذّاتيّ

691
00:49:06,580 --> 00:49:11,500
سمحتِ للزّبونة بأن تتمادى في طلباتها
حتّى أصبحت غير عقلانيّة

692
00:49:13,000 --> 00:49:14,370
،وفوق كلّ ذلك

693
00:49:14,500 --> 00:49:19,670
أفسدتِ تجربة تسوُّق الزّبائن الآخرين

694
00:49:19,830 --> 00:49:24,040
خطأ فادح بالنّسبة لمُضيفة، أليس كذلك؟

695
00:49:25,630 --> 00:49:30,630
أولئك الّذين لا يستطيعون رؤية الصّورة
بشموليّتها لن يكونوا مُضيفين جيّدين

696
00:49:31,460 --> 00:49:34,370
لا نحتاجكِ هنا

697
00:49:41,710 --> 00:49:43,540
هذا هو إعلاننا التّجاريّ

698
00:49:43,790 --> 00:49:47,540
أجل. بدأ جدّي هذه الرّقصة

699
00:49:48,040 --> 00:49:52,000
لكن أعتقد حان الوقت لإعادة تجديد ذلك

700
00:49:52,790 --> 00:49:56,750
أليس عملك أيضاً هو الحِفاظ
على الوضع الرّاهن؟

701
00:49:59,920 --> 00:50:01,790
يا لها من مكتبة مُبهرة

702
00:50:01,920 --> 00:50:05,210
كلّها لجدّي. تاريخ كافّة الأنواع

703
00:50:05,460 --> 00:50:09,460
حتّى سجلّات الحيوانات انقرضت

704
00:50:11,710 --> 00:50:15,750
البوم الضّاحك الّذي يُشبه صوته
صوت القهقهة

705
00:50:16,330 --> 00:50:22,000
الّذي شوهد آخر مرّة في كانتربيري
في عام 1914. انقرض الآن

706
00:50:23,170 --> 00:50:24,500
المِينك البحريّ

707
00:50:24,830 --> 00:50:29,130
استهدفه البشر للحصول على فرائه الفاخر

708
00:50:29,500 --> 00:50:32,500
اختفى في 1880

709
00:50:34,330 --> 00:50:37,420
ازدهرت الذّئاب اليابانيّة في اليابان

710
00:50:38,210 --> 00:50:42,710
نعرف القليل عنها فقط. انقرضت
في عام 1905

711
00:50:44,670 --> 00:50:48,960
تعرّض الأوك العظيم لصيد جائر
للحصول على لحمه ودهونه

712
00:50:49,130 --> 00:50:54,920
في عام 1830، تمّ الإبلاغ عن وجود
خمسين أوك على قيد الحياة فقط

713
00:50:55,580 --> 00:50:59,630
لكن قُتِلوا جميعاً بواسطة البشر
لصنع عيّنات من الأصناف الحيّة

714
00:50:59,710 --> 00:51:02,540
وانقرضتْ في عام 1844

715
00:51:06,000 --> 00:51:08,920
المتجر الأوّل في العالم

716
00:51:09,040 --> 00:51:12,040
قد تأسّس في نفس العام

717
00:51:12,670 --> 00:51:18,540
العصر الّذي بدأ البشر فيه يحصلون على الأشياء
من باب الرّغبة، وليس الضّرورة

718
00:51:20,040 --> 00:51:22,790
بُني متجر هوكّيوكو الكبير

719
00:51:22,870 --> 00:51:27,170
لخدمة الـ في.آي.أي الّذين انقرضوا
بسبب البشر

720
00:51:27,750 --> 00:51:31,080
لنقل قصّة كفاحنا إلى الأجيال المستقبليّة

721
00:51:31,290 --> 00:51:35,370
ولمنح البشر فُرصة للتّكفير عن خطاياهم

722
00:51:35,670 --> 00:51:40,500
إذاً هذه حديقة نموذجيّة خياليّة
تسمح للـ في.آي.أي

723
00:51:40,630 --> 00:51:42,870
بأن يُصبحوا مُستهلكين في السّوق الكبيرة

724
00:51:43,670 --> 00:51:49,460
...وها أنا أصيغ رؤيتي لمستقبل هذا المتجر

725
00:51:50,790 --> 00:51:53,210
المستقبل؟

726
00:51:54,210 --> 00:51:56,210
لستُ متأكّداً تماماً

727
00:51:58,210 --> 00:52:01,170
لكن دعنا ألّا نحكم عليها بعد

728
00:52:21,170 --> 00:52:25,500
مرحباً. شكراً عى القدوم إلى متجرنا اليوم

729
00:52:25,830 --> 00:52:27,170
!آنسة مُضيفة

730
00:52:28,370 --> 00:52:29,370
أهلاً وسهلاً

731
00:52:30,500 --> 00:52:31,830
جاء هذا اليوم

732
00:52:31,960 --> 00:52:35,870
!أجل! المتحف الخاصّ بالسيّد وولي
!أنا متحمّس للغاية

733
00:52:36,500 --> 00:52:40,250
!"وحتّى أنّنا سنتمكّن من رؤية تحفته، "السميلودون

734
00:52:40,500 --> 00:52:42,830
المتحف في القاعة العظيمة

735
00:52:43,000 --> 00:52:44,460
شكراً لكِ

736
00:52:44,750 --> 00:52:45,830
!أستأذن

737
00:52:46,210 --> 00:52:47,500
!استمتع

738
00:52:54,040 --> 00:52:56,920
لا نحتاجك هنا

739
00:52:57,870 --> 00:52:59,040
...المعذرة

740
00:52:59,920 --> 00:53:03,290
أريد أن أشتري لابنتي هديّة كريسماس

741
00:53:04,330 --> 00:53:06,790
بكلّ تأكيد. كيف يمكنني مساعدتكِ؟

742
00:53:06,920 --> 00:53:10,960
هذا مُطمئن! لكن ميزانيّتي محدودة

743
00:53:12,330 --> 00:53:15,710
هل يمكنكِ مساعدتي في إيجاد
شيء بوسعي شراءه بهذا؟

744
00:53:20,000 --> 00:53:22,460
...هديّة يمكن شراؤها بقطعة معدنيّة واحدة

745
00:53:23,330 --> 00:53:25,830
ابنتي جونيسي مريضة

746
00:53:26,000 --> 00:53:29,210
إنّها تزور المشفى باستمرار طيلة حياتها

747
00:53:30,370 --> 00:53:33,000
لم تستطع المجيء اليوم أيضاً

748
00:53:33,830 --> 00:53:37,040
إنّ التمشّي في هذا المتجر في الكريسماس

749
00:53:37,170 --> 00:53:41,170
كان ليُصبح الهديّة الأمثل لها

750
00:53:42,540 --> 00:53:47,170
قلّما تجد من الأدوات يمكنك
شراؤها بقطعة معدنيّة واحدة

751
00:53:49,540 --> 00:53:53,540
هذا متجر فاخر

752
00:53:54,040 --> 00:53:58,540
أتساءل ما إن كنتُ مُلائماً لأكون مُضيفاً هنا

753
00:54:04,370 --> 00:54:05,670
!آنسة مُضيفة

754
00:54:07,130 --> 00:54:12,080
...سيّد أسد بربريّ! هل الفتاة الصّغيرة بجانبك

755
00:54:12,370 --> 00:54:14,130
هي حبيبتي تيسّا...

756
00:54:15,540 --> 00:54:17,710
شكراً على مساعدتي قبل أيّام

757
00:54:17,870 --> 00:54:22,210
أخبرتُ تيسّا عنك، وأصرّتْ على
المجيء إلى هنا معي

758
00:54:22,710 --> 00:54:26,830
كنتُ أتساءل ما إن كنتُ أستطيع
فعل شيء بالمقابل

759
00:54:29,040 --> 00:54:31,710
في حقيقة الأمر، أودّ أن أطلب معروفاً

760
00:54:33,330 --> 00:54:38,170
كما ترون، كافّة الحيوانات بنفس الطّول

761
00:54:38,330 --> 00:54:41,170
كانت هذه أمنية السيّدة وولي

762
00:54:41,500 --> 00:54:47,630
لطالما أحزنتْها الحياة القصيرة
للحيوانات الأصغر حجماً

763
00:54:47,830 --> 00:54:53,870
تمنّتْ أن تكون كافّة الحيوانات
سواسية وبنفس الحجم

764
00:54:54,080 --> 00:54:59,080
...من هذه النّاحية، هذا تجسيد للأرض الفاضلة

765
00:55:01,920 --> 00:55:03,210
المعذرة

766
00:55:04,170 --> 00:55:07,290
!هذا نجاح باهر

767
00:55:07,790 --> 00:55:09,790
يسرّني ذلك

768
00:55:09,960 --> 00:55:11,080
!سيّد وولي

769
00:55:12,370 --> 00:55:13,210
مرحباً

770
00:55:13,370 --> 00:55:16,960
.شكراً لك على ذلك اليوم
احتسِ بعض الشّاي رجاء

771
00:55:19,080 --> 00:55:20,250
شكراً لكِ

772
00:55:21,870 --> 00:55:23,170
هل رأيت المتحف؟

773
00:55:23,250 --> 00:55:27,710
بالتّأكيد. أحببتُ "السميلودون" بالذّات

774
00:55:28,370 --> 00:55:33,630
كانت زوجتي مُتحيّزة لذلك أيضاً

775
00:55:34,790 --> 00:55:37,080
!حذارِ -
أنا آسف -

776
00:55:49,540 --> 00:55:51,000
!هذه كارثة

777
00:55:51,630 --> 00:55:56,000
إنّ "السميلودون" هي النّحت الّذي
...صنع اسم السيّد وولي كفنّان

778
00:55:56,080 --> 00:55:58,210
!عمل فنّي لا يُقدَّر بثمن

779
00:55:58,370 --> 00:56:02,330
،حتّى عندما بدأ استديو بيرمافروست بالذّوبان

780
00:56:02,460 --> 00:56:04,630
!تمّ الاحتفاظ بهذا الشّيء المُميّز

781
00:56:04,750 --> 00:56:08,250
نحن مُدرِكون تماماً لقيمة عمل السيّد ووي

782
00:56:08,460 --> 00:56:11,790
سوف نتحمّل كامل المسؤوليّة
...ونقدّم تعويضات

783
00:56:11,920 --> 00:56:14,710
!المسألة لا صِلة لها بالمال

784
00:56:14,790 --> 00:56:17,830
أشكّ حتّى في أنّكم تفهمون القيمة
"الحقيقيّة لـ"السميلودون

785
00:56:18,000 --> 00:56:19,000
المعذرة

786
00:56:20,500 --> 00:56:23,000
هذا لا يعنيك

787
00:56:23,130 --> 00:56:25,670
تراجعي يا آنسة أكينو

788
00:56:26,710 --> 00:56:27,830
سأبقى

789
00:56:28,420 --> 00:56:31,420
هل تعتقدين بأنّكِ تستطيعين المساعدة؟

790
00:56:31,710 --> 00:56:33,500
لا أدري

791
00:56:33,960 --> 00:56:35,500
...لكن

792
00:56:35,670 --> 00:56:36,920
أريد البقاء

793
00:56:37,830 --> 00:56:40,000
سيّد وولي؟

794
00:56:40,870 --> 00:56:42,670
أنا آسفة حقّاً

795
00:56:42,960 --> 00:56:46,540
من فضلك اسمح لي بالذّهاب معك
!للاعتذار من زوجتك

796
00:56:47,210 --> 00:56:48,500
آنسة أكينو

797
00:56:49,830 --> 00:56:53,870
زوجة السيّد وولي قد تُوفّيت بالفعل

798
00:56:55,500 --> 00:56:57,370
وهذا ما في الأمر

799
00:56:59,920 --> 00:57:03,750
لكلّ شيء نهاية

800
00:57:24,790 --> 00:57:28,630
!سيبدأ الحفل الموسيقيّ! لنذهب! بسرعة

801
00:57:37,290 --> 00:57:38,420
!سيّد وولي

802
00:57:40,790 --> 00:57:44,330
...لا أعرف كيف أعتذر

803
00:57:46,330 --> 00:57:47,750
أين المعنويّات؟

804
00:57:49,130 --> 00:57:54,080
بدت همّتكِ مُثبّطة طوال اليوم

805
00:57:54,710 --> 00:57:56,370
رغم أنّ اليوم هو يوم الكريسماس

806
00:58:02,330 --> 00:58:08,920
لا أدري ما إن كنتُ أُسعِد زبائننا فعلاً أم لا

807
00:58:09,580 --> 00:58:14,330
أتساءل ما إن كنتُ أستحقّ أن أكون مُضيفة

808
00:58:15,500 --> 00:58:17,790
كذلك أنا

809
00:58:18,330 --> 00:58:23,750
أتساءل أحياناً ما إن كان هناك معنى
وراء العمل الّذي أقوم به

810
00:58:24,330 --> 00:58:25,460
...لا تقل هذا

811
00:58:27,040 --> 00:58:30,500
ها هي ذي! آنسة مُضيفة، إنّه جاهز

812
00:58:30,670 --> 00:58:32,830
حقّاً؟

813
00:58:33,460 --> 00:58:35,790
تفضّلي -
شكراً لك -

814
00:58:36,290 --> 00:58:38,170
!انظري

815
00:58:40,290 --> 00:58:42,370
!سُررت بلقائك يا جونيسي

816
00:58:42,630 --> 00:58:47,210
اسمي تيسّا. هذه أوّل مرّة لي
!في متجر هوكّيوكو الكبير

817
00:58:47,540 --> 00:58:50,500
زينة الكريسماس جميلة

818
00:58:50,710 --> 00:58:54,960
!لنخُض جولة كريسماس في متجر هوكّيوكو الكبير

819
00:58:55,960 --> 00:58:59,250
هذا هو ركن مُستحضرات التّجميل في المُلحق

820
00:59:00,330 --> 00:59:02,960
!انظري إلى كلّ هذه الألوان

821
00:59:03,080 --> 00:59:05,580
ما هو لونك المُفضّل يا جونيسي؟

822
00:59:06,080 --> 00:59:09,000
!وهذا قسم العطور

823
00:59:09,460 --> 00:59:14,170
ساعدتني المُضيفات في إيجاد
هذا العطر الثّمين

824
00:59:14,630 --> 00:59:17,420
!المُفضّل لدى جدّتي الرّاحلة

825
00:59:19,420 --> 00:59:22,830
اشترى أبي هذا الوشاح هنا

826
00:59:23,000 --> 00:59:25,830
اشتريتُ هذه السّاعة الجيبيّة
له. أليس هذا أنيقاً؟

827
00:59:26,330 --> 00:59:29,370
يا لها من صدفة! أتينا إلى نفس
المتجر للتسوّق من أجل بعضنا الآخر

828
00:59:29,500 --> 00:59:33,000
!يبدو أنّنا أزعجنا المُضيفة

829
00:59:34,500 --> 00:59:36,710
أتينا للتسوّق معاً اليوم

830
00:59:36,830 --> 00:59:39,750
من الرّائع قضاء الوقت مع العائلة

831
00:59:40,920 --> 00:59:42,460
!يا له من فستان جميل

832
00:59:44,000 --> 00:59:45,580
وعدنا بعضنا

833
00:59:45,960 --> 00:59:50,290
بأنّنا سنتناول العشاء في هذا
المطعم في كلّ ذكرى زفاف سنويّة

834
00:59:51,210 --> 00:59:53,210
أيّ نوع من المتاجر هو؟

835
00:59:53,330 --> 00:59:56,330
...في الواقع، بالنّسبة لي

836
00:59:57,040 --> 01:00:00,210
إنّه مكان يمنحني فيه شخصٌ دفعة قويّة

837
01:00:02,370 --> 01:00:03,420
!سيّد طائر

838
01:00:05,500 --> 01:00:07,830
نودّ أن نطلب معروفاً

839
01:00:07,960 --> 01:00:09,000
معروف؟

840
01:00:09,130 --> 01:00:11,000
لا يمكننا فعل ذلك بمفردنا

841
01:00:11,960 --> 01:00:14,130
مستحيل -
!من فضلك -

842
01:00:14,250 --> 01:00:18,460
كم مرّة يجب أن أخبرك؟ الأوك
العظيم لا يستطيع التّحليق

843
01:00:18,830 --> 01:00:21,000
لكن هذا من أجل المُضيفة

844
01:00:22,250 --> 01:00:24,500
تُريد أن تُري جمال متجر هوكّيوكو الكبير

845
01:00:24,670 --> 01:00:28,630
لزبونة مريضة ولا تستطيع المجيء شخصيّاً

846
01:00:39,330 --> 01:00:41,000
...المستقبل

847
01:01:32,460 --> 01:01:36,790
أحبّتْ زوجتي هذا المتجر، لكن
مهما سألتُها من مرّات

848
01:01:37,500 --> 01:01:42,790
،عمّا يُعجبها فيه، كانت تضحك وتقول

849
01:01:43,830 --> 01:01:45,540
"إذا ذهبت، فسوف ترى"

850
01:01:47,330 --> 01:01:51,370
ما الّذي يُعجبك في متجر هوكّيوكو الكبير؟

851
01:01:52,960 --> 01:01:54,080
أنا؟

852
01:01:55,630 --> 01:02:00,170
كلّ زبون يأتي إلى هنا يُغادر
والبسمة في وجهه

853
01:02:01,960 --> 01:02:04,370
،حتّى أولئك الّذين أتوا إلى هنا حزينين

854
01:02:04,960 --> 01:02:07,920
سيعودون إلى المنزل بابتسامة

855
01:02:08,960 --> 01:02:12,420
هذا ما يُعجبني في هذا المتجر

856
01:02:14,370 --> 01:02:17,210
لهذا أريد البقاء

857
01:02:18,370 --> 01:02:24,170
!لتوفير أفضل خدمة يمكنني توفيرها لزبائننا

858
01:02:26,290 --> 01:02:29,370
هكذا إذاً. هذا جيّد

859
01:02:30,540 --> 01:02:32,750
!سيّد وولي

860
01:02:34,540 --> 01:02:36,290
أنا آسف حقّاً

861
01:02:40,830 --> 01:02:44,670
...هذه لك. أنا... في الواقع

862
01:02:45,420 --> 01:02:49,130
.أنا من أشدّ مُعجبيك يا سيّد وولي
أنا طبّاخ باتيسري مُساعد

863
01:02:49,420 --> 01:02:53,000
شجعَتْني المُضيفة

864
01:02:53,330 --> 01:02:55,960
ساعدني الجميع في المطعم

865
01:02:56,960 --> 01:02:58,040
...لذا

866
01:02:59,330 --> 01:03:00,830
هل يمكنني؟

867
01:03:11,830 --> 01:03:15,250
...هذه زوجتي

868
01:03:17,290 --> 01:03:18,580
وأنا

869
01:03:25,710 --> 01:03:27,000
شكراً لك

870
01:03:34,040 --> 01:03:35,830
يا له من مشهد جميل

871
01:03:36,670 --> 01:03:41,040
يأتي كثير من النّاس إلى هنا
بحثاً عن هديّة لشخص

872
01:03:41,460 --> 01:03:47,250
لكن لا أحد يعلم ما إذا كانت
الهديّة ستُقدَّر حقّاً

873
01:03:48,630 --> 01:03:50,420
لكن أعتقد

874
01:03:50,790 --> 01:03:54,250
أنّ عمل المُضيفة هو محاولة فهم

875
01:03:54,420 --> 01:03:58,040
أُمنية الزّبائن الصّادقة لفعل شيء
من أجل شخص ما

876
01:03:59,580 --> 01:04:01,540
،عندما أراقبها، يتجلّى لي

877
01:04:02,210 --> 01:04:05,170
بأنّها تحبّ إسعاد النّاس حقّاً

878
01:04:05,630 --> 01:04:09,330
كلّ مُضيفة يمكنها أن تطمح إلى ذلك

879
01:04:11,540 --> 01:04:15,370
في متجر، الحلم والرّغبة
وجهان لعملة واحدة

880
01:04:15,960 --> 01:04:22,170
هل أنا إنسانيّ زيادة عن اللّزوم
لأنّني ألمس جمالاً في هذا؟

881
01:04:53,920 --> 01:04:58,040
شكراً على القدوم

882
01:05:21,580 --> 01:05:25,080
ستجد كلّ ما تحتاجه في متجر هوكّيوكو الكبير

883
01:05:25,170 --> 01:05:29,250
اسمي آكينو. أعمل في متجر

884
01:05:33,170 --> 01:05:36,290
زبائننا هم حيوانات بكافّة الأشكال والألوان

885
01:05:39,210 --> 01:05:43,630
زبائن بأجنحة، وآخرون بحافر

886
01:05:45,000 --> 01:05:48,790
زبائن صغار، وزبائن كبار

887
01:05:49,420 --> 01:05:53,750
والبعض الآخر جذّابون بصورة مُلفِتة

888
01:05:55,960 --> 01:05:57,370
!المعذرة

889
01:06:04,580 --> 01:06:05,870
أهلاً وسهلاً

890
01:06:08,000 --> 01:06:11,420
هل يمكنني خدمتك؟

891
01:06:12,750 --> 01:06:15,130
من أنتِ؟

892
01:06:16,460 --> 01:06:17,750
أنا؟