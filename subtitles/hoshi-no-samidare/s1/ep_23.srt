1
00:00:02,550 --> 00:00:03,920
حسناً إذاً

2
00:00:04,780 --> 00:00:07,440
من يريد إيقاف الأميرة، فليأتي إليّ

3
00:00:08,430 --> 00:00:09,990
سأواجهكم

4
00:00:12,680 --> 00:00:13,480
!نوي

5
00:00:13,480 --> 00:00:14,820
!قُل شيئاً، تبّاً

6
00:00:17,230 --> 00:00:18,740
،سوبارو-تشان، يوكي-تشان

7
00:00:18,740 --> 00:00:21,040
اعتنيا بشينونومي-سان وأكاني-كن

8
00:00:21,040 --> 00:00:22,750
إلى أين أنتِ ذاهبة يا سورانو-سان؟

9
00:00:23,100 --> 00:00:24,290
هناك

10
00:00:24,290 --> 00:00:26,960
!أنتما لا ينبغي أن تقاتلا أماميا-سان

11
00:00:27,590 --> 00:00:30,880
!تبّاً، لا أستطيع حتّى الوقوف

12
00:00:30,880 --> 00:00:32,920
!يبدو هذا ممتعاً للغاية أيضاً، اللّعنة

13
00:00:34,670 --> 00:00:40,100
لماذا لستُ الشّخص الّذي يقف هناك الآن؟

14
00:00:40,630 --> 00:00:41,620
يوهي

15
00:00:41,620 --> 00:00:43,630
يسرّني أنّ ميكازوكي ليس هنا

16
00:00:44,110 --> 00:00:45,640
،إذا قاتلتُه

17
00:00:45,640 --> 00:00:49,370
فأنا متأكّد بأنّني سأستمتع كثيراً وأستهلك كلّ طاقتي

18
00:00:49,880 --> 00:00:53,690
...لكن مع ذلك أنت تواجه فارسَي وحشين أسطوريّين

19
00:00:54,470 --> 00:00:56,160
سأتدبّر الأمر

20
00:00:56,160 --> 00:00:58,810
بابيلون هي قوّة مخصّصة لمقاتلة
أشخاص آخرين على أيّ حال

21
00:01:00,460 --> 00:01:03,430
...هذه القوّة وجهودي وتخطيطي

22
00:01:03,430 --> 00:01:06,300
!كلّ ذلك كان لأجل هذا اليوم

23
00:01:08,210 --> 00:01:11,390
لا أصدّق بأنّه كان ينتظرنا زعيم سرّي كهذا

24
00:01:11,390 --> 00:01:12,930
ماذا ستفعل يا ناغومو؟

25
00:01:12,930 --> 00:01:15,010
سأوقفهم من دون قتلهم

26
00:01:15,010 --> 00:01:16,630
سأكسر إرادتهم

27
00:01:17,060 --> 00:01:20,220
نحن حُماة هذا الكوكب

28
00:01:20,220 --> 00:01:22,870
حان هذا اليوم أخيراً

29
00:01:22,870 --> 00:01:24,690
أجل يا شيا

30
00:01:24,690 --> 00:01:26,010
هل ستكونين بخير؟

31
00:01:26,010 --> 00:01:29,520
إنّهما قويّان حقّاً يا ياكو

32
00:01:29,520 --> 00:01:30,580
أنا بخير

33
00:01:30,580 --> 00:01:31,940
لكن سأوقفهم

34
00:01:32,870 --> 00:01:36,030
!سأكون أنا من يأسر أماميا-كن

35
00:01:45,990 --> 00:01:48,620
نقطة ضعفكما هي أنّ كليكما قويّان جدّاً

36
00:01:50,260 --> 00:01:52,310
ثـ-ثقيل جدّاً

37
00:01:53,150 --> 00:01:55,400
،لم تتخيّلا أنّكما ستقاتلان شخصاً آخر

38
00:01:55,400 --> 00:01:58,030
لذا تشتّتَ تركيزكما بكبتِ قوّتكما

39
00:01:58,500 --> 00:02:01,460
لن تتمكّنا من هزيمتي وأنتما ما زلتُما تريان قدراتنا

40
00:02:01,460 --> 00:02:02,890
كقوّة هجوميّة فحسب

41
00:02:04,070 --> 00:02:08,310
هاكودو، هل كنتِ تعلمين بشأن أساهينا وأماميا؟

42
00:02:08,310 --> 00:02:09,270
أجل

43
00:02:10,230 --> 00:02:14,020
سمعتُهما يتحدّثان أثناءا مُعسكرنا الصّيفي

44
00:02:15,750 --> 00:02:17,820
وصدّقتهما؟

45
00:02:17,820 --> 00:02:19,530
ما كنتُ لأفعل

46
00:02:19,930 --> 00:02:23,990
مُحال أن يكونا يتوقان لتدمير العالم

47
00:02:25,110 --> 00:02:27,140
ليس أماميا يوهي الّذي نعرفه

48
00:02:27,140 --> 00:02:29,280
ولا أساهينا ساميداري الّتي نعرفها

49
00:02:30,130 --> 00:02:32,210
هذا ليس من طباعك يا ناغومو-سان

50
00:02:32,210 --> 00:02:34,420
تجهر بشكوكك في ساحة المعركة

51
00:02:35,150 --> 00:02:36,750
ليست شكوكاً

52
00:02:36,750 --> 00:02:38,130
إنّها خيبات أمل

53
00:02:39,840 --> 00:02:43,490
،إذا أصيبَ أحد في نهاية المطاف

54
00:02:43,490 --> 00:02:45,180
لن نتمكّن من الذّهاب للشرب لاحقاً

55
00:02:46,700 --> 00:02:49,020
أتقول الشّرب؟

56
00:02:49,750 --> 00:02:52,720
!أماميا، عندما نعود، سنُقيم حفلة

57
00:02:52,720 --> 00:02:55,060
،لا يمكنكما تحطيم الأرض

58
00:02:55,060 --> 00:02:56,980
!لذا أَدرِك ذلك قبل أن تتأذّى

59
00:03:02,910 --> 00:03:06,120
إذاً من فضلك راقب دون تدخُّل

60
00:03:06,570 --> 00:03:09,770
،من واجب البالغين تأديب الأطفال

61
00:03:09,770 --> 00:03:11,540
!وأريد إيقافكما

62
00:03:12,120 --> 00:03:13,840
أريد القيام بعملي

63
00:03:13,840 --> 00:03:15,090
أنا غير موظّف في نهاية المطاف

64
00:03:15,710 --> 00:03:17,240
شكراً جزيلاً لك

65
00:03:17,730 --> 00:03:19,670
...من فضلكم حاولوا إيقافنا

66
00:03:19,670 --> 00:03:21,090
!هذا إن استطعتُم

67
00:03:24,270 --> 00:03:25,100
!هناك

68
00:03:40,610 --> 00:03:41,820
!لا يمكنني القبض عليه

69
00:03:41,820 --> 00:03:42,850
!لمَ لا؟

70
00:03:42,850 --> 00:03:44,820
!كان ذلك سهلاً للغاية أثناء تدريبنا

71
00:03:44,820 --> 00:03:47,030
كان ذلك الأساس الّذي مهّدتُه لليوم أيضاً

72
00:03:48,240 --> 00:03:49,580
ماء؟

73
00:03:51,160 --> 00:03:52,640
!راوغه؟

74
00:03:53,540 --> 00:03:54,500
!لا أستطيع التحكّم

75
00:03:54,780 --> 00:03:59,460
بابيلون الخاصّة بأماميا تحسّن سرعته
بينما تخفض سرعة خصومه

76
00:04:00,920 --> 00:04:02,880
!من الصّعب التّعامل مع هذا

77
00:04:02,880 --> 00:04:04,450
...الماء ثقيل جدّاً

78
00:04:04,450 --> 00:04:05,590
...إنّ تحكُّمي

79
00:04:05,590 --> 00:04:08,340
!سوف أقبض عليه مهما كلّف الأمر

80
00:04:17,840 --> 00:04:18,710
!الآن

81
00:04:18,710 --> 00:04:21,440
...جمّده وأوقـ... ـفه

82
00:04:27,600 --> 00:04:29,490
أنا آسفة

83
00:04:30,180 --> 00:04:31,810
نفدت اللّياقة؟

84
00:04:31,810 --> 00:04:35,370
،لا، أنتِ لستِ فارسة وحوش أسطوريّة
لذا قاتلتِ ببسالة

85
00:04:39,260 --> 00:04:45,110
!اللّعنة، اللّعنة، اللّعنة

86
00:04:45,110 --> 00:04:47,890
!أريد أن أكون هناك

87
00:04:48,200 --> 00:04:49,280
!استيقظ

88
00:04:49,280 --> 00:04:51,220
!اشفِنا أرجوك

89
00:04:54,240 --> 00:04:55,830
...ألوها

90
00:04:57,510 --> 00:04:59,060
ما الّذي يحلم به؟

91
00:05:00,380 --> 00:05:02,230
!مـ-مهلاً

92
00:05:02,230 --> 00:05:03,070
!ماذا؟

93
00:05:11,310 --> 00:05:14,540
يـ-يو-كن، هذا فظيع

94
00:05:16,510 --> 00:05:18,590
استسلم يا ناغومو

95
00:05:18,590 --> 00:05:20,540
لا أحد منكم يستطيع هزيمة أماميا

96
00:05:20,930 --> 00:05:22,000
!أنيما

97
00:05:29,350 --> 00:05:31,210
!هراوة ملك التنّين

98
00:05:32,930 --> 00:05:34,640
!هاكودو! أنتِ تُبالغين

99
00:05:42,640 --> 00:05:44,620
!يا له من طيش

100
00:05:44,620 --> 00:05:46,790
استخدمتُ أخر جزء من لياقتي للتصدّي لهذا

101
00:05:52,340 --> 00:05:53,980
أنا آسف يا هاكودو-سان

102
00:05:56,330 --> 00:05:57,220
...لكنّني

103
00:06:04,920 --> 00:06:08,190
أحبّ تلك الفتاة

104
00:06:08,810 --> 00:06:13,180
لذا أريد أن أكون أنا من يوقفها... لا أحد آخر

105
00:06:22,330 --> 00:06:23,600
أجل

106
00:06:23,600 --> 00:06:27,360
عرفتُ بأنّك ستقول ذلك يا يو-كن

107
00:08:06,430 --> 00:08:08,840
!لن أدع ذلك الشّيء يدمّر الأرض

108
00:08:08,840 --> 00:08:10,300
!لا يوجد سبب ما

109
00:08:10,300 --> 00:08:15,300
!ستكون قبضتي هي من يحطّم هذا الكوكب

110
00:08:16,680 --> 00:08:18,350
أماميا يوهي

111
00:08:19,000 --> 00:08:21,180
أقسِم بولاءك لي

112
00:08:21,970 --> 00:08:25,000
...ثمّ التقينا نحن الاثناان قبل عام

113
00:08:26,440 --> 00:08:28,940
ستُوقف أساهينا بمفردك؟

114
00:08:28,940 --> 00:08:29,870
أجل

115
00:08:29,870 --> 00:08:31,800
لذا جميعكم، من فضلكم الا تتدخّلوا

116
00:08:33,470 --> 00:08:34,240
يا أميرة

117
00:08:38,080 --> 00:08:40,560
توقّعت يا يو-كن

118
00:08:40,560 --> 00:08:41,880
توقّعتُ أن ينتهي الأمر  بهذا الشّكل

119
00:08:42,600 --> 00:08:47,710
لأنّك لطالما كنت بطلي يا يو-كن

120
00:08:57,270 --> 00:08:58,440
هيو-كن

121
00:08:59,350 --> 00:09:00,430
،حسناً

122
00:09:02,850 --> 00:09:03,920
هل ستحاول إيقافي؟

123
00:09:05,240 --> 00:09:06,560
!سأوقفكِ

124
00:09:07,290 --> 00:09:09,980
رأيت؟ أنت غاية في الرّوعة

125
00:09:10,960 --> 00:09:11,990
ها أنا قادمة

126
00:09:32,590 --> 00:09:34,480
يو-كن، هل تتذكّر؟

127
00:09:35,020 --> 00:09:37,340
في يوم عيد ميلادي العام الماضي

128
00:09:41,440 --> 00:09:43,340
!عيد ميلاد سعيد

129
00:09:41,890 --> 00:09:43,340
استمتعت

130
00:09:43,910 --> 00:09:48,010
إذا أردت، بوسعكِ أن تكبُري وتصبحي بالغة أيضاً

131
00:09:48,010 --> 00:09:50,020
شكراً يا نوي

132
00:09:50,740 --> 00:09:52,980
كانت تلك أوّل مرّة أذكر فيها ذلك، صحيح؟

133
00:09:53,580 --> 00:09:58,350
بأنّني مريضة وبأنّه لم يبقَ لي
الكثير لأعيش من دون أنيما

134
00:09:59,450 --> 00:10:00,460
آسفة

135
00:10:00,910 --> 00:10:03,280
قضينا وقتاً ممتعاً كثيراً في ذلك اليوم أيضاً

136
00:10:06,480 --> 00:10:08,580
...شكراً يا يو-كن

137
00:10:08,580 --> 00:10:10,040
ستموت معي؟

138
00:10:10,420 --> 00:10:11,890
بكلّ سرور

139
00:10:11,890 --> 00:10:14,410
على قول ذلك لي آنذاك...

140
00:10:15,910 --> 00:10:19,530
،كنتُ سعيدة جدّاً وحزينة جدّاً
فلم أعرف ماذا أفعل

141
00:10:21,220 --> 00:10:24,970
سأواجه كلّ العشرة بمفردي وأهزم الجميع

142
00:10:25,230 --> 00:10:29,520
...الكلام الّذي قلتَه، وجهك، عيناك

143
00:10:31,560 --> 00:10:35,280
لطالما جعلَتْ نبضات قلبي تتسارع

144
00:10:35,280 --> 00:10:37,330
...لماذا ساميداري-سان

145
00:10:37,330 --> 00:10:39,860
تقاتل بتلك النّظرة في وجهها؟...

146
00:10:40,640 --> 00:10:42,070
أعتقد كان ذلك عندما بكيت

147
00:10:42,070 --> 00:10:46,030
بعد الإدراك بأنّك ورثت تقنيّات شينونومي-سان

148
00:10:46,920 --> 00:10:49,600
كان ذلك عندما ظننتُ أوّل مرّة بأنّ
الأمر قد يصبح هكذا يوماً ما

149
00:10:50,960 --> 00:10:55,150
يو-كن، مهما كانت الخيارات الّتي تصنعها
،بعد محبّة هذا العالم

150
00:10:55,150 --> 00:10:56,920
سأظلّ أحبّك مع ذلك

151
00:10:57,820 --> 00:11:01,680
حتّى لو حاولت إيقافي في المعركة الأخيرة

152
00:11:02,410 --> 00:11:05,230
أنا أنتمي إليكِ

153
00:11:05,930 --> 00:11:10,350
سأقدّم لك وبكلّ سرور هذا العالم الّذي أحبّه

154
00:11:10,350 --> 00:11:11,700
كاذب

155
00:11:13,000 --> 00:11:16,650
كان ذلك أثناء لقائنا بالجميع تقريباً

156
00:11:17,310 --> 00:11:18,900
شكراً للجميع

157
00:11:19,860 --> 00:11:22,040
لأنّهم أصبحوا أصدقائي

158
00:11:24,590 --> 00:11:26,090
...عندما أتت أمّي للزيارة

159
00:11:26,900 --> 00:11:28,190
كان ذلك عندما علمت

160
00:11:30,230 --> 00:11:32,460
لا أستطيع أن أصبح بالغة

161
00:11:34,790 --> 00:11:38,530
تيقّنتُ بأنّك سوف توقفني

162
00:11:38,530 --> 00:11:40,480
لا داعي للخوف

163
00:11:40,480 --> 00:11:41,720
فأنا معكِ

164
00:11:41,720 --> 00:11:44,400
لكن... كنتَ غاية في الرّوعة

165
00:11:45,870 --> 00:11:48,890
حبّي للعالم ازداد أكثر فأكثر

166
00:11:49,630 --> 00:11:51,980
لم أرد أن تبدأ المعركة النّهائيّة

167
00:11:52,380 --> 00:11:54,490
أردتُ أن تدوم تلك الأيّام للأبد

168
00:11:55,030 --> 00:11:56,830
هكذا أردتُ أن أشعر

169
00:11:57,640 --> 00:12:02,330
لكن سُرعان ما أدركتُ مُكرهةً بأنّ ذلك كان مستحيلاً

170
00:12:03,010 --> 00:12:08,330
قبل مدّة طويلة، خسرت صديقتي أخاها
الصّغير في حادث سير

171
00:12:09,700 --> 00:12:14,550
"آنذاك، كانت كثيراً ما تقول، "ليتني متّ معه

172
00:12:15,210 --> 00:12:19,660
لكن تلك الصّديقة متزوّجة وسعيدة حاليّاأً

173
00:12:21,630 --> 00:12:24,180
النّاس قادرون على إيجاد السّعادة

174
00:12:25,020 --> 00:12:26,880
لا ضير أن يكون النّاس سُعداء

175
00:12:28,740 --> 00:12:31,060
ظلّ الوقت يمضي رغم أنّني أردتُه أن يتوقّف

176
00:12:31,950 --> 00:12:34,920
،ظلّ يو-كن يزداد روعة بعد روعة

177
00:12:35,680 --> 00:12:37,900
روعة بعد روعة

178
00:12:41,860 --> 00:12:44,820
لا أصدّق أنّه حتّى أماميا يدافع

179
00:12:44,820 --> 00:12:47,280
هل أنت بخير يا يوهي؟

180
00:12:47,280 --> 00:12:48,280
أجل

181
00:12:48,840 --> 00:12:51,070
رأيت؟ تلك النّظرة من جديد

182
00:12:51,950 --> 00:12:54,620
...مع اقتراب المعركة النّهائية، قلتُ لنفسي

183
00:12:55,280 --> 00:12:59,500
ما رأيكم بـ"الضّوء المُحقّق للأمنيات" كاِسم للمجال المُدمَج؟

184
00:12:59,500 --> 00:13:01,050
أعتقد هذا لطيف

185
00:13:01,050 --> 00:13:02,640
أجل

186
00:13:02,640 --> 00:13:05,280
إن كان هذا ما قرّرتُماه، فهذا أفضل اسم

187
00:13:06,510 --> 00:13:08,060
إنّه اسم لطيف

188
00:13:08,060 --> 00:13:09,640
ما رأيك يا يو-كن؟

189
00:13:09,640 --> 00:13:11,110
أنا مستعدّ تماماً له

190
00:13:12,220 --> 00:13:17,130
إنّها التقنيّة الّتي ستحقّق كلّ أمانينا

191
00:13:20,240 --> 00:13:22,670
"،الجميع يريدون أن يحظوا بمستقبل"

192
00:13:22,670 --> 00:13:25,530
"لكن لا أستطيع أن أكون هناك معهم"

193
00:13:26,960 --> 00:13:30,960
"سيجدون السّعادة في مستقبل من دوني"

194
00:13:32,680 --> 00:13:35,680
"!يا وقت، توقّف! توقّف أرجوك"

195
00:13:37,410 --> 00:13:38,710
عرفت

196
00:13:39,500 --> 00:13:41,960
...ومع ذلك، أنا ما زلتُ

197
00:13:53,140 --> 00:13:54,850
!أحتاج مزيداً من القوّة

198
00:13:58,350 --> 00:13:59,190
!يو-كن؟

199
00:13:59,190 --> 00:14:00,650
!أماميا-سان

200
00:14:00,040 --> 00:14:00,650
!نوي

201
00:14:00,650 --> 00:14:04,170
!أماميا-كن

202
00:14:04,170 --> 00:14:06,990
!نوي

203
00:14:05,030 --> 00:14:06,050
!أماميا

204
00:14:08,160 --> 00:14:09,110
يو-كن

205
00:14:13,620 --> 00:14:16,560
القوى الخارقة عشوائيّة وخطيرة

206
00:14:16,560 --> 00:14:18,370
...ما دام المرء يبتغيها وبإيمان راسخ

207
00:14:18,370 --> 00:14:19,900
!أماميا! هل أنت بخير؟

208
00:14:19,900 --> 00:14:20,630
!أجل

209
00:14:21,440 --> 00:14:23,280
سيستجيب القدر حينئذ

210
00:14:23,910 --> 00:14:26,630
!حـ-حصانة

211
00:14:27,650 --> 00:14:30,010
هذا هو الرّجل الّذي وقعتُ في حبّه

212
00:14:31,220 --> 00:14:33,500
أنت مذهل يا يو-كن

213
00:14:33,500 --> 00:14:38,020
تهاجمني باستمرار لإيقافي بينما
أنا لم أعد قادرة على إيقاف نفسي

214
00:14:39,670 --> 00:14:41,270
!أنت بطلي

215
00:14:44,820 --> 00:14:45,930
ماذا؟

216
00:14:45,930 --> 00:14:48,410
المِطرد الّذي كنتُ أمسك به اختفى؟

217
00:14:48,410 --> 00:14:51,200
ويمكنني الشّعور بقوّة تتدفّق في داخلي

218
00:14:52,350 --> 00:14:54,280
يوهي، هل انكمشت؟

219
00:14:55,370 --> 00:14:58,250
لا، أنا من أصبح أضخم؟

220
00:14:58,750 --> 00:15:00,540
!حصانة؟

221
00:15:00,770 --> 00:15:02,750
كـ-كيف؟

222
00:15:03,720 --> 00:15:04,730
...يو-كن

223
00:15:09,500 --> 00:15:11,750
ها أنا قادمة يا فارسة التنّين الأسود

224
00:15:15,740 --> 00:15:18,490
اذهبي وتعلّمي من يكون

225
00:15:27,690 --> 00:15:29,280
!حسناً، تفاديتُها

226
00:15:34,480 --> 00:15:38,370
ينبغي أن أحدّثكم جميعاً... عنها

227
00:15:38,930 --> 00:15:39,850
أنيما؟

228
00:15:40,760 --> 00:15:47,170
جسدها متأثّر بمرض ما زال بلا علاج في هذا العصر

229
00:15:48,270 --> 00:15:53,100
في الماضي، حرمَها مرضُها من الألم والمتعة

230
00:15:54,330 --> 00:15:59,310
ما كان مهمّ بالنسبة لها ما إن كانت
تشعر بالحياة في تلك اللّحظة

231
00:15:59,870 --> 00:16:01,810
كانت طفلة حصيفة

232
00:16:02,390 --> 00:16:03,550
ماذا؟

233
00:16:04,010 --> 00:16:05,360
مرض؟

234
00:16:05,360 --> 00:16:06,910
سامي-تشان كانت كذلك؟

235
00:16:06,910 --> 00:16:08,980
هذه أوّل مرّة أسمع فيها ذلك

236
00:16:08,980 --> 00:16:11,830
عندما التقت بالشابّ أماميا يوهي

237
00:16:11,830 --> 00:16:14,830
،وأريتُها شكل الأرض من الفضاء

238
00:16:14,830 --> 00:16:18,080
اكتسبت ساميداري أخيراً رغبات
خاصّها بها وللمرّة الأولى

239
00:16:18,940 --> 00:16:22,910
أرادت أن تلتقي من جديد بأماميا يوهي وأن تمتلك الأرض

240
00:16:23,290 --> 00:16:25,180
تمتلك الأرض؟

241
00:16:25,180 --> 00:16:27,000
أيّ فكرة هي هذه؟

242
00:16:27,380 --> 00:16:30,060
تحطيم الأرض بيديها الاثنتين

243
00:16:30,060 --> 00:16:33,150
كانت تلك الوسيلة الوحيدة لامتلاكها
والّتي كانت قد خطرت على ذهنها

244
00:16:33,870 --> 00:16:38,470
كانت غالباً لتتوق لامتلاك الأرض
بغضّ النّظر عن مرضها

245
00:16:38,990 --> 00:16:42,100
،وما كان مرضها مُهمّاً إذا حطّمت الأرض

246
00:16:42,100 --> 00:16:43,940
بما أنّ كلّ شيء كان سينتهي بفعل ذلك

247
00:16:44,560 --> 00:16:48,900
لذا في نظرها، لم يكن مرضها مهمّاً

248
00:16:49,720 --> 00:16:52,390
،لكن التقت من جديد حينها بأماميا يوهي

249
00:16:52,390 --> 00:16:54,360
والتقت بكم جميعاً

250
00:16:54,700 --> 00:16:57,240
أدركتْ معنى السّعادة

251
00:16:57,800 --> 00:17:01,330
في حين ظنّتْ أنّ الحياة كانت مجرّد
،حبّ العالم والرّغبة فيه

252
00:17:01,870 --> 00:17:05,790
عَلِمَتْ بأنّ العالم أيضاً

253
00:17:06,480 --> 00:17:08,290
سيُبادلها الحبّ

254
00:17:09,100 --> 00:17:11,260
،بدأت تفتقد كلّ يوم يمضي

255
00:17:11,910 --> 00:17:15,160
وعدد المرّات الّتي تذكّرت فيه مرضها ازداد

256
00:17:15,710 --> 00:17:18,720
،سواء سحقَتِ الأرضَ أم لا

257
00:17:18,720 --> 00:17:20,430
هذه الأيّام سوف تنتهي

258
00:17:20,890 --> 00:17:23,680
لا شيء يمضي قُدماً بالنسبة لها
ولا شيء لها إذا توقّفَتْ

259
00:17:24,290 --> 00:17:26,880
لذا لا يمكنها إيقاف نفسها بعد الآن

260
00:17:27,480 --> 00:17:29,700
لهذا لا بدّ أن يكون أماميا يوهي

261
00:17:31,300 --> 00:17:33,650
لمَ هذا الإسهاب؟

262
00:17:34,050 --> 00:17:37,610
ماذا سيحدث لـ يو-كن بعد أن يوقف الأميرة؟

263
00:17:37,610 --> 00:17:41,300
ماذا سيحدث للأميرة بعد أن يوقفها يو-كن؟

264
00:17:41,300 --> 00:17:43,830
!أما من شيء يمكنني فعله؟

265
00:17:44,210 --> 00:17:49,680
أخبرتُ سامي-تشان بأنّ الناس يمكنهم أن يكونوا
سعداء حتّى بعد خسارة شخص يحبّونه

266
00:17:49,680 --> 00:17:52,470
،أردتُها أن تعرف بأنّ الناس أقوياء

267
00:17:52,470 --> 00:17:56,170
لكن اعتقدت سامي-تشان غالباً بأنّني كنتُ أتخلّى عنها

268
00:17:56,550 --> 00:17:58,400
!أريد فعل شيء ما أيضاً

269
00:17:58,400 --> 00:18:00,510
!أما من شيء يمكننا فعله يا أنيما؟

270
00:18:00,510 --> 00:18:04,970
لا أريد أن تعتقد سامي-تشان بأنّها
!وحيدة تماماً يا أنيما

271
00:18:04,970 --> 00:18:08,350
!أنيما

272
00:18:05,930 --> 00:18:07,140
...أنيما

273
00:18:08,650 --> 00:18:09,810
...أنيما

274
00:18:10,850 --> 00:18:12,280
تريدون فعل شيء ما؟

275
00:18:12,280 --> 00:18:13,980
هل يمكنكم فعل شيء؟

276
00:18:13,980 --> 00:18:16,030
قرّروا ذلك بأنفسكم

277
00:18:28,110 --> 00:18:29,590
...الفُرسان الوحوش

278
00:18:30,950 --> 00:18:32,190
...شكراً لكم

279
00:18:33,200 --> 00:18:35,190
على اللّقاء بتلك الفتاة

280
00:18:40,600 --> 00:18:44,810
آسفة يا يو-كن، أصبحتُ قويّة جدّاً

281
00:18:45,220 --> 00:18:47,380
!قوّتها بمستوى مختلف تماماً

282
00:18:48,060 --> 00:18:49,020
!بابيلون

283
00:18:51,150 --> 00:18:53,230
آسف، يمكنني تبديد هذا أيضاً

284
00:18:54,140 --> 00:18:57,240
شكراً لك على محاولة إيقافي

285
00:18:58,320 --> 00:19:01,600
هكذا إذاً... أعتقد أنّ هذا مستحيل حتّى عليك

286
00:19:04,840 --> 00:19:06,800
حسناً، سأغادر الآن

287
00:19:08,170 --> 00:19:09,500
!إ-إلى أين؟

288
00:19:09,500 --> 00:19:11,740
إلى لكمة ساميداري الهائلة

289
00:19:12,750 --> 00:19:14,090
سأنهيها بشكل كامل

290
00:19:14,090 --> 00:19:16,420
!يا أميرة! يوهي

291
00:19:17,570 --> 00:19:18,500
وداعاً

292
00:19:29,540 --> 00:19:31,060
!أخبرتِني، أليس كذلك؟

293
00:19:31,610 --> 00:19:33,560
هذا يكفي يا يو-كن

294
00:19:34,930 --> 00:19:36,500
...بأنّني أستطيع التّحليق

295
00:19:36,500 --> 00:19:37,530
هذا ايكفي

296
00:19:43,450 --> 00:19:45,370
!أعلى منكِ...

297
00:20:24,030 --> 00:20:26,730
لا أعلم ماذا يمكننا أن نفعل لإنقاذها

298
00:20:26,730 --> 00:20:27,990
...لذا يا أماميا

299
00:20:27,990 --> 00:20:29,830
!نأتمنك عليها

300
00:20:29,830 --> 00:20:32,210
!ودعينا نتحمّل ذلك العبء معكِ

301
00:20:32,620 --> 00:20:36,670
!أنا آسفة لأنّني لم أفهم ألمك من قبل

302
00:20:36,670 --> 00:20:40,630
!لذا حدّثينا أكثر عن سامي-تشان

303
00:20:40,990 --> 00:20:43,220
...لأنّنا جميعنا نريد أن نكون معاً

304
00:20:43,580 --> 00:20:45,800
لدقيقة أو ثانية أطول

305
00:20:46,980 --> 00:20:49,350
...تقلُّبات الزمكان

306
00:20:49,890 --> 00:20:51,420
!االلّعنة

307
00:20:51,420 --> 00:20:53,350
!هيّا

308
00:21:10,740 --> 00:21:12,510
!لا يمكنك إيقاف الزمن

309
00:21:12,510 --> 00:21:14,300
!لن أغيّر قراري

310
00:21:14,300 --> 00:21:15,960
!لذا كلّ شيء ينتهي اليوم

311
00:21:15,960 --> 00:21:17,690
!أحبّكِ

312
00:21:17,690 --> 00:21:19,310
!أريد أن أتحمّل أعباءكِ

313
00:21:19,310 --> 00:21:20,820
!لم يتردّد عقلي أبداً

314
00:21:20,820 --> 00:21:21,840
!ليس منذ ذلك اليوم

315
00:21:21,840 --> 00:21:23,050
!سأنهيه

316
00:21:23,350 --> 00:21:24,500
!...أنا

317
00:21:37,050 --> 00:21:38,490
!أنا هنا معكِ

318
00:21:55,490 --> 00:21:57,660
!سأذهب معكِ بدلاً من الأرض

319
00:21:58,380 --> 00:22:00,540
!سأضحّي بحياتي لأجلكِ

320
00:22:01,080 --> 00:22:04,510
،لذا عيشي معي

321
00:22:06,120 --> 00:22:07,460
!ولنمُت معاً

322
00:22:10,240 --> 00:22:11,400
لا، لا داعي

323
00:22:11,400 --> 00:22:13,020
ليس عليك المُبالغة إلى هذا الحدّ

324
00:22:21,820 --> 00:22:23,140
يو-كن

325
00:22:23,140 --> 00:22:26,660
أحبّك يا يو-كن

326
00:22:27,960 --> 00:22:31,530
أحبّك أكثر من هذا الكوكب