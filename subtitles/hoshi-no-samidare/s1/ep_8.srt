1
00:00:02,440 --> 00:00:04,000
!هذا هو نحن

2
00:00:04,000 --> 00:00:05,430
!الفرسان الوحوش

3
00:00:05,970 --> 00:00:08,630
،لنأخذ أولئك الّذين يتوقون لدمارنا

4
00:00:08,630 --> 00:00:10,030
،ونسحقهم تحت فكّنا

5
00:00:10,030 --> 00:00:11,710
!ونلتهمهم بشكل كامل

6
00:00:11,710 --> 00:00:12,950
!أجل

7
00:00:13,900 --> 00:00:17,280
،لحماية الأرض من السّلاح المُدمِّر للكواكب

8
00:00:17,280 --> 00:00:18,920
...مِطرقة البسكويت

9
00:00:19,450 --> 00:00:22,240
،لهزيمة السّاحر، أنيموس

10
00:00:22,240 --> 00:00:23,360
...و

11
00:00:24,110 --> 00:00:26,330
،لتحقيق طموحاتنا

12
00:00:27,920 --> 00:00:34,620
توحّدَ فرسان الوحوش النّاجون تحت
راية أنيما في أواخر يوليو

13
00:02:07,310 --> 00:02:08,690
!دورك

14
00:02:08,690 --> 00:02:11,980
!أنا، راديكال ميري، سأحطّمك

15
00:02:12,300 --> 00:02:14,690
!ماري السحريّة، حضّري نفسك

16
00:02:16,510 --> 00:02:18,260
شخصيّة جديدة

17
00:02:18,260 --> 00:02:19,990
زيّ مذهل

18
00:02:19,990 --> 00:02:24,480
يحتوي هذا على الحلقة 27 حتّى 39

19
00:02:24,480 --> 00:02:26,700
شكراً على السماح لي باستعارتها

20
00:02:26,700 --> 00:02:31,170
لكن أنا متفاجئ من معرفة أنّكِ
تشاهدين مثل هذه الأشياء

21
00:02:31,170 --> 00:02:33,590
أحبّ الأنمي والمانغا

22
00:02:33,590 --> 00:02:35,220
ياكو شديدة الاهتمام بذلك

23
00:02:35,220 --> 00:02:36,500
إنّه كوسبلاير

24
00:02:36,500 --> 00:02:37,510
!شيا

25
00:02:37,840 --> 00:02:39,450
ماذا يعني؟

26
00:02:39,450 --> 00:02:41,720
شخص يرتدي أزياء

27
00:02:41,720 --> 00:02:43,160
!أزياء؟

28
00:02:44,930 --> 00:02:47,890
حسناً، ينبغي أن أذهب الآن

29
00:02:52,000 --> 00:02:53,060
...كوسبلاي

30
00:03:00,360 --> 00:03:02,090
لمَ كلّ هذا؟

31
00:03:02,090 --> 00:03:04,160
لن تُريها لأحد

32
00:03:04,160 --> 00:03:05,620
لا مشكلة

33
00:03:06,540 --> 00:03:08,300
لقطة جميلة، لقطة جميلة

34
00:03:09,090 --> 00:03:11,630
ينبغي أن تُريها لأمامي على الأقلّ

35
00:03:11,630 --> 00:03:13,280
لماذا أماميا-كن؟

36
00:03:13,280 --> 00:03:14,820
لماذا هو؟

37
00:03:14,820 --> 00:03:16,360
حسناً، أيّاً يكن

38
00:03:16,990 --> 00:03:19,670
سيظنّ بأنّني غريبة

39
00:03:19,670 --> 00:03:21,750
ها أنتِ تتردّدين

40
00:03:21,750 --> 00:03:25,140
أين الشّجاعة التي تحلّيتِ بها عندما
التقينا أوّل مرّة؟

41
00:03:25,140 --> 00:03:28,370
عندما التقينا أوّل مرّة؟

42
00:03:50,830 --> 00:03:53,060
!ا-المعذرة! لـ-لحظة

43
00:03:53,060 --> 00:03:55,800
!لن أعضّك! اسمعيني

44
00:03:55,800 --> 00:03:58,550
إذاً الأفاعي قادرة على الكلام الآن؟

45
00:03:58,550 --> 00:04:00,650
!ما زالت نائمة

46
00:04:00,650 --> 00:04:01,510
!استيقظي

47
00:04:01,510 --> 00:04:03,730
!قلتُ استيقظي

48
00:04:04,680 --> 00:04:07,900
حسناً، ماذا أردتِ أن تناقشي؟

49
00:04:07,900 --> 00:04:08,760
حسناً

50
00:04:08,760 --> 00:04:11,810
،أحتاج قوّتكِ للمساعدة في هزيمة السّاحر أنيموس

51
00:04:11,810 --> 00:04:15,160
الّذي يخطّط لتدمير الكوكب

52
00:04:15,160 --> 00:04:16,860
حسناً. بالتأكيد

53
00:04:16,860 --> 00:04:19,090
هل كنتِ تسمعينني؟

54
00:04:19,090 --> 00:04:20,930
سوف أنقذ الكوكب، صحيح؟

55
00:04:20,930 --> 00:04:24,920
أنا لا أمزح عندما أقول بأنّها
معركة حياة أو موت

56
00:04:24,920 --> 00:04:26,320
سأبذل قصارى جهدي

57
00:04:28,240 --> 00:04:30,090
حسناً، أيّاً يكن

58
00:04:30,090 --> 00:04:32,870
في هذه الحالة، دعيني أشرح الأمور

59
00:04:34,590 --> 00:04:36,150
وهذا ما في الأمر

60
00:04:36,150 --> 00:04:39,560
،وكمكافأة مُقدَّماً على صوغ ميثاق الفارس

61
00:04:39,560 --> 00:04:42,520
يمكنني منحك أمنية واحدة

62
00:04:43,270 --> 00:04:44,450
فهمتِ؟

63
00:04:44,450 --> 00:04:46,170
أجل، غالباً

64
00:04:46,170 --> 00:04:47,800
إذاً يمكنني فعلها الآن؟

65
00:04:47,800 --> 00:04:48,760
تفعلين ماذا؟

66
00:04:49,220 --> 00:04:50,600
أتلو أمنيتي

67
00:04:50,600 --> 00:04:52,990
إنّها المكافأة على وضع حياتكِ على المحكّ

68
00:04:52,990 --> 00:04:55,060
ينبغي أن تفكّري فيها أكثر

69
00:04:55,060 --> 00:04:58,460
إذا كانت حياتي على المحكّ، أليس
من الأفضل فعلها في وقت أبكر؟

70
00:04:58,460 --> 00:05:01,650
هل تقصدين بأنّكِ مستعدّة للموت في أيّ وقت؟

71
00:05:02,040 --> 00:05:03,160
أجل

72
00:05:03,160 --> 00:05:07,110
فاساساً، كلّ ما هو حيّ مُقدّر له أن يموت

73
00:05:09,070 --> 00:05:12,660
أمنيتي هي أن يموت أبي وأمّي وبقيّة

74
00:05:12,660 --> 00:05:17,120
أفراد عائلتي بابتسامة عندما
يحين وقتهم للرحيل

75
00:05:17,120 --> 00:05:18,280
هل يمكنكِ فعل ذلك؟

76
00:05:18,280 --> 00:05:19,680
يمكنني

77
00:05:19,680 --> 00:05:22,360
،سواء أكان ذلك بعد إنقاذكِ للأرض بفترة طويلة

78
00:05:22,360 --> 00:05:24,410
،أو إذا جاءت النّهاية فجأة غداً

79
00:05:24,410 --> 00:05:26,800
ستتمكّن عائلتكِ من الموت بابتسامة

80
00:05:26,800 --> 00:05:28,410
هذا مُطمئن

81
00:05:28,410 --> 00:05:30,280
مُقدّر للناس أن يموتوا

82
00:05:30,280 --> 00:05:33,050
لهذا أستغلّ الحياة أحسن استغلال
وذلك كي أموت بلا حسرات

83
00:05:33,050 --> 00:05:37,120
الموت بابتسامة هو الترف الأعظم في هذا العالم

84
00:05:37,120 --> 00:05:38,520
لذا هذه هي أمنيتي

85
00:05:38,520 --> 00:05:40,020
لكن أنا أغشّ قليلاً

86
00:05:40,340 --> 00:05:41,740
أجل

87
00:05:41,740 --> 00:05:44,160
في كلّ الأحوال، تمّت صياغة الميثاق

88
00:05:44,820 --> 00:05:46,610
أنا شيا مون

89
00:05:47,060 --> 00:05:48,570
هاكودو يايوي

90
00:05:48,940 --> 00:05:51,590
نحن معاً فارس الأفعى

91
00:05:53,190 --> 00:05:57,360
لذا ظننتُ بأنّني ظهرتُ أمام امرأة مجنونة

92
00:05:57,360 --> 00:05:58,750
حقّاً؟

93
00:05:58,750 --> 00:06:01,990
ينبغي أن تحافظي على سلوك
عدم الخوف هذا

94
00:06:01,990 --> 00:06:03,960
عندما تتفاعلين مع أمامي

95
00:06:14,210 --> 00:06:15,080
ناغومو

96
00:06:16,730 --> 00:06:18,480
صباح الخير

97
00:06:19,480 --> 00:06:22,230
أليس لديك عمل اليوم يا ناغومو-سان؟

98
00:06:22,230 --> 00:06:26,530
ناغومو-دونو غير موظّف على ما يبدو

99
00:06:26,530 --> 00:06:28,010
بجدّية؟

100
00:06:28,010 --> 00:06:30,540
هل أنهيتُما تدريبكما الصّباحي؟

101
00:06:30,540 --> 00:06:31,460
أجل

102
00:06:31,460 --> 00:06:33,950
إذاً لنذهب لتناول الفطور معاً

103
00:06:34,650 --> 00:06:36,340
على حسابي بالطبع

104
00:06:38,620 --> 00:06:41,190
أنت غير موظّف ولديك مال؟

105
00:06:41,190 --> 00:06:43,100
هل يعيش على نفقة والديه؟

106
00:06:43,100 --> 00:06:45,340
...لحظة، نظراً إلى سنّه

107
00:06:54,510 --> 00:06:55,270
آسف

108
00:06:56,030 --> 00:06:57,280
مرحباً

109
00:06:57,280 --> 00:06:58,520
أوكا-سان؟

110
00:06:59,690 --> 00:07:03,200
أجل. أنا أبلي حسناً

111
00:07:04,140 --> 00:07:05,340
عمل؟

112
00:07:05,340 --> 00:07:07,440
لا داعي للقلق، الأمور بخير

113
00:07:08,380 --> 00:07:09,200
إلى اللّقاء

114
00:07:10,540 --> 00:07:12,990
هـ-هل كانت أمّك؟

115
00:07:12,990 --> 00:07:15,450
كانت زوجتي، نعيش متباعدين

116
00:07:15,450 --> 00:07:17,570
!زوجتك؟

117
00:07:17,570 --> 00:07:20,910
...تـ-تنادي زوجتك بـ"أوكا-سان"؟ إذاً

118
00:07:21,240 --> 00:07:23,380
أجل، لديّ ابن واحد

119
00:07:23,380 --> 00:07:25,150
غير موظّف مع زوجة وطفل؟

120
00:07:25,150 --> 00:07:28,090
...ويكذب على زوجته بشأن عمله

121
00:07:28,390 --> 00:07:29,540
...المعذرة

122
00:07:29,540 --> 00:07:30,590
ماذا؟

123
00:07:30,590 --> 00:07:33,430
كيف التقيت أنت وزوجتك؟

124
00:07:34,880 --> 00:07:37,200
كان ذلك قبل أن أصبح متحرّياً على ما أذكر

125
00:07:37,200 --> 00:07:38,100
مُتحرٍّ؟

126
00:07:38,100 --> 00:07:39,240
أجل

127
00:07:39,240 --> 00:07:42,810
،عندما كنتُ لا أزال في سلك الشّرطة
تلقّيتُ مكالمة بشأن عمليّة سرقة

128
00:07:44,340 --> 00:07:48,690
فسرقتَ قلب زوجتك مع المجرم؟

129
00:07:48,690 --> 00:07:51,280
تبدو فخورة جدّاً بذلك التّلاعب اللّفظي

130
00:07:52,780 --> 00:07:55,250
هلّا سألتُك عن سبب اعتزالك؟

131
00:07:59,400 --> 00:08:02,210
اعتزلتُ مؤخّراً فقط

132
00:08:04,250 --> 00:08:07,380
ناغومو-سان، لماذا تنام هنا ثانية؟

133
00:08:07,380 --> 00:08:10,520
هيواتاري؟

134
00:08:10,520 --> 00:08:11,670
سأنهض الآن

135
00:08:18,130 --> 00:08:19,840
لمَ هذه النّظرة؟

136
00:08:19,840 --> 00:08:23,100
لا تصرخ، ستحرج نفسك

137
00:08:23,100 --> 00:08:26,900
بقيّة البشر غير قادرين على رؤيتي أو سماعي

138
00:08:27,440 --> 00:08:31,060
أظنّني ما زلتُ لم أصحُ تماماً

139
00:08:31,900 --> 00:08:33,870
هل أنت بخير؟

140
00:08:33,870 --> 00:08:34,870
أجل

141
00:08:39,200 --> 00:08:41,410
استمرّ في التصرّف بشكل طبيعي واسمع

142
00:08:41,410 --> 00:08:44,080
الآن، الأرض في خطر

143
00:08:47,090 --> 00:08:49,500
شكراً على عملك الدّؤوب يا ناغومو-سان

144
00:08:49,500 --> 00:08:50,860
العفو

145
00:08:50,860 --> 00:08:53,720
ذلك المُعتدي التسلسليّ الّذي كنّا
نطارده يتصرّف بجسارة

146
00:08:53,720 --> 00:08:55,570
لذا انشغلنا كثيراً

147
00:08:55,570 --> 00:08:58,500
لم نحصل على أيّ طرف خيط عنه، أليس كذلك؟

148
00:08:58,500 --> 00:08:59,560
لا

149
00:08:59,560 --> 00:09:02,540
رغم أنّ الرّئيس حصل على معلومة
بأنّ الجاني سوف ينشط

150
00:09:02,540 --> 00:09:05,070
في المكان الّذي نحن مُتوجّهين صوبه الآن

151
00:09:05,070 --> 00:09:07,690
من أين حصل على معلومة كهذه؟

152
00:09:07,690 --> 00:09:08,750
أعرف

153
00:09:08,750 --> 00:09:11,110
إنّها مُزيّفة غالباً، لكن هذا لا يعني ألّا نذهب

154
00:09:11,110 --> 00:09:12,070
!ماذا؟

155
00:09:15,820 --> 00:09:17,150
ما الأمر؟

156
00:09:17,150 --> 00:09:19,070
لـ-لا شيء

157
00:09:20,870 --> 00:09:22,640
يبدو أنّ هذا هو المكان

158
00:09:22,640 --> 00:09:24,880
إنّه حيّ عاديّ

159
00:09:24,880 --> 00:09:26,830
سوف ينشط هنا؟

160
00:09:26,830 --> 00:09:28,310
لا أعلم

161
00:09:28,310 --> 00:09:32,010
لكن سيكون من الخطير أن نفترض بأنّه لن يفعل

162
00:09:32,010 --> 00:09:32,840
صحيح

163
00:09:33,710 --> 00:09:37,960
لا أتحمّل رؤية طفل بريء أمثالهم يتأذّى

164
00:09:38,890 --> 00:09:41,940
أيّ بالغ يتسبّب ببكاء طفل هو عدوّي

165
00:09:42,820 --> 00:09:45,250
لننفصل ونبحث في المنطقة

166
00:09:45,250 --> 00:09:46,270
!أجل

167
00:09:46,990 --> 00:09:48,100
هيواتاري

168
00:09:48,980 --> 00:09:53,030
نحن مُطبِّقو قانون، لا أبطال عدالة

169
00:09:53,030 --> 00:09:54,630
لا تنسي ذلك

170
00:09:55,120 --> 00:09:55,940
!حاضرة

171
00:09:58,410 --> 00:10:01,370
كنتَ تتحدّث عن أنّ الأرض في خطر؟

172
00:10:02,000 --> 00:10:06,230
لعلّك ينبغي أن تركّز على الخطر الرّاهن حاليّاً؟

173
00:10:06,910 --> 00:10:09,180
هذا ليس شيئاً أحتاج سماعه منك

174
00:10:09,180 --> 00:10:14,360
نحن مُطبِّقو قانون، لا أبطال عدالة؟

175
00:10:16,730 --> 00:10:19,760
يبدو أنّك تعتزّ بكونك مُتحرّياً

176
00:10:19,760 --> 00:10:22,750
الأمر ليس كذلك

177
00:10:23,310 --> 00:10:26,700
أحاول أداء واجبي فحسب

178
00:10:26,700 --> 00:10:30,230
العدالة" ليست كلمة يمكنك التلفّظ"
بها عفوياً هكذا

179
00:10:31,950 --> 00:10:34,720
يبدو أنّ لديك مشاعر قويّة تجاه العدالة

180
00:10:40,440 --> 00:10:41,740
!ابتعد عن طرقي! وإلّا طعنتُك

181
00:10:41,740 --> 00:10:42,840
!تنحَّ جانباً

182
00:10:51,160 --> 00:10:52,250
هل أنتِ بخير؟

183
00:10:52,920 --> 00:10:54,010
أجل

184
00:10:54,010 --> 00:10:56,420
الجرح ليس عميقاً

185
00:10:57,000 --> 00:10:58,130
هكذا إذاً

186
00:11:05,460 --> 00:11:08,850
الّذي بجانبه هو الرّئيس، أليس كذلك؟

187
00:11:08,850 --> 00:11:11,160
هل يُعقَل بأنّه...؟

188
00:11:11,160 --> 00:11:12,270
سأذهب أنا

189
00:11:16,700 --> 00:11:19,190
فشلتُ في قتله بسبب امرأة

190
00:11:19,530 --> 00:11:23,510
حتّى أنا لا أستطيع أن أتجاهل جريمة قتل

191
00:11:24,040 --> 00:11:25,660
ابنك؟

192
00:11:26,430 --> 00:11:29,470
لهذا حصلتَ على معلومة دقيقة كهذه عنه

193
00:11:29,470 --> 00:11:30,980
أنت؟

194
00:11:30,980 --> 00:11:33,830
لماذا لم تمنعه بما أنّك علمت؟

195
00:11:33,830 --> 00:11:36,120
مُحال أن يصغي إليّ عندما أخبره

196
00:11:36,120 --> 00:11:39,670
لهذا أرسلتُكما

197
00:11:40,470 --> 00:11:42,530
،لا أعرف التحفُّظ

198
00:11:42,530 --> 00:11:44,790
—لذا في المرّة المقبلة آمل أن توقفني قبل أن أقتل

199
00:11:47,890 --> 00:11:51,180
سوف أتجاهل هذا أيضاً

200
00:11:51,180 --> 00:11:55,860
لكن تعلم ما سيحدث إذا تعمّقت
أكثر في هذه المسألة، صحيح؟

201
00:11:56,920 --> 00:12:03,890
حسناً، أعتمد عليك في الاستمرار
في تطبيق العدالة وحفظ السّلام

202
00:12:03,890 --> 00:12:05,010
يا رئيس

203
00:12:12,790 --> 00:12:15,730
تطبيق القانون عمل صعب، صحيح؟

204
00:12:16,840 --> 00:12:18,770
—بالمناسبة، إنَّ الأرض

205
00:12:21,250 --> 00:12:22,470
سوجي؟

206
00:12:22,470 --> 00:12:24,090
مرحباً يا أبي

207
00:12:24,550 --> 00:12:27,900
!حصلتُ على هديّة عيد الميلاد. شكراً لك

208
00:12:27,900 --> 00:12:30,380
...لكن بخصوص الأسطوانة

209
00:12:30,380 --> 00:12:32,400
ما هو باروتمان؟

210
00:12:35,410 --> 00:12:36,980
،عندما كنتُ صغيراً

211
00:12:36,980 --> 00:12:40,070
طلبوا منّي فعليّاً أن أرتدي زيّاً
مثله وأُطلّ به ذات مرّة

212
00:12:40,070 --> 00:12:41,570
مذهل

213
00:12:41,570 --> 00:12:43,140
لكن لعبتُ دور شرِّير

214
00:12:44,110 --> 00:12:45,880
رغم أنّك شرطيّ؟

215
00:12:45,880 --> 00:12:48,380
إنّها سلسلة ممتعة. ينبغي أن تشاهدها

216
00:12:48,380 --> 00:12:49,570
أكيد

217
00:12:49,570 --> 00:12:53,580
واظب على عمل الخير كبطل
عدالة حقيقي يا أبي

218
00:12:53,580 --> 00:12:55,340
أجل. إلى اللّقاء

219
00:12:55,340 --> 00:12:56,340
إلى اللّقاء

220
00:12:57,420 --> 00:13:01,860
عدوّنا هو شرٌّ حقيقيّ يحاول
تدمير الكوكب حرفيّاً

221
00:13:02,380 --> 00:13:06,020
يمكنك أن تصبح... بطل عدالة حقيقيّاً

222
00:13:06,450 --> 00:13:08,190
لن أكون واحداً أبداً

223
00:13:08,190 --> 00:13:11,210
إذا كان بقاؤنا على المحكّ، فسنلجأ
إلى استخدام أيّ وسيلة ضروريّة

224
00:13:11,210 --> 00:13:13,770
لا يمكنك اعتبار هذا بطل عدالة

225
00:13:14,390 --> 00:13:15,900
لكن حسناً

226
00:13:15,900 --> 00:13:17,850
أنا مستعدّ لتلطيخ يديّ

227
00:13:18,460 --> 00:13:20,180
تصدّقني؟

228
00:13:20,180 --> 00:13:22,590
أنا مُنفتح على الغوامض

229
00:13:23,190 --> 00:13:24,710
اسمي ناغومو سويتشيرو

230
00:13:24,710 --> 00:13:26,090
دانس دارك

231
00:13:29,640 --> 00:13:31,540
تبدو كتمثيليّة شرطة

232
00:13:31,540 --> 00:13:33,650
هذا رائع للغاية

233
00:13:33,650 --> 00:13:36,000
!كان لديك عمل فعليّاً إذاً

234
00:13:36,000 --> 00:13:39,710
في وقت لاحق، ارتأيتُ أن أحاول
،التحقّق من وجود دانس مادّياً

235
00:13:44,500 --> 00:13:47,340
لكن يبدو أنّه يرفض أن يدع رجلاً يمتطيه

236
00:13:47,700 --> 00:13:49,430
أذيتُ ظهري بسبب ذلك

237
00:13:49,800 --> 00:13:51,580
،ثمّ عندما كنتُ طريحاً لمدّة أسبوع

238
00:13:51,580 --> 00:13:54,570
،تذكّرتُ كلّ امتعاضي المكبوت في السّلك

239
00:13:54,570 --> 00:13:55,520
فاستقلت

240
00:13:57,250 --> 00:14:00,310
،بالمناسبة، كان هذا يحيّرني منذ مدّة

241
00:14:01,860 --> 00:14:07,740
لكن هل ظننت بأنّني أصبحتُ كبير
السنّ هكذا دون الحصول على عمل؟

242
00:14:10,030 --> 00:14:11,400
أنا آسف

243
00:14:13,080 --> 00:14:14,900
كان نفس الحلم ثانية

244
00:14:15,600 --> 00:14:18,700
في الحلم، كنتُ أستطيع مراقبة الكوكب بأكمله

245
00:14:18,700 --> 00:14:20,920
كنتُ عالياً في السّماء البعيدة

246
00:14:21,320 --> 00:14:22,950
إطلالة جميلة

247
00:14:22,950 --> 00:14:27,590
تساءلتُ حول هذا من قبل، لكن
هل أنا الوحيد الّذي يرى هذا الحلم؟

248
00:14:28,000 --> 00:14:31,220
أيّ شخص يأتي إلى هنا إذا
دعاه أنيما أو دعوتُه أنا

249
00:14:31,220 --> 00:14:32,810
أجل

250
00:14:39,350 --> 00:14:40,970
شيماكي-كن

251
00:14:40,970 --> 00:14:43,280
عمّاذا ينبغي أن نتكلّم اليوم؟

252
00:14:45,450 --> 00:14:47,460
لنتكلّم عن الطعام

253
00:14:47,460 --> 00:14:49,360
ماذا تحبّ يا شيماكي-كن؟

254
00:14:49,810 --> 00:14:52,200
مؤخّراً، أمسيتُ مهتمّاً بالطعام الصّيني

255
00:14:52,200 --> 00:14:53,610
هذا جيّد

256
00:14:53,610 --> 00:14:55,210
،حسبما أرى

257
00:14:55,210 --> 00:14:58,420
قد يكون الطعام محلّياً، لكنّه ليس مُقيّداً بحدود

258
00:14:58,420 --> 00:15:01,420
لا يهمّ من أيّ بلد هو ما دام الطعام لذيذاً

259
00:15:01,420 --> 00:15:04,170
ما نوع الطعام الّذي تحبّه يا أنيموس؟

260
00:15:04,170 --> 00:15:07,090
الطعام اليابانيّ. أحبُّ السّوبا حقّاً

261
00:15:07,090 --> 00:15:09,700
تجيد استخدام عيدان الطعام؟

262
00:15:10,670 --> 00:15:12,350
أنا من اليابان كما تعلم

263
00:15:12,350 --> 00:15:15,950
حسناً، أنيموس هو مصطلح نفسيّ

264
00:15:15,950 --> 00:15:17,140
أظنّه لم يكن اسمك الحقيقيّ

265
00:15:17,140 --> 00:15:19,810
لا، أنيموس هو اسمي الحقيقيّ

266
00:15:19,810 --> 00:15:22,870
إنّه ليس اسماً غريباً إلى هذا
الحدّ في عصري

267
00:15:23,550 --> 00:15:24,620
في عصرك؟

268
00:15:27,320 --> 00:15:29,490
صباح الخير يا هيو-كن

269
00:15:29,490 --> 00:15:31,590
صباح النور يا كوه

270
00:15:31,590 --> 00:15:33,660
ما الّذي تحدّثتما عنه؟

271
00:15:34,220 --> 00:15:37,620
عن الطعام على ما أعتقد

272
00:15:38,010 --> 00:15:41,940
في كلّ الأحوال، أتساءل لماذا يريد
أنيموس أن يتحدّث معي

273
00:15:41,940 --> 00:15:45,920
هذا لأنّك الأكثر شبهاً بالسّاحر

274
00:15:48,620 --> 00:15:50,800
ماذا؟ آلة زمن؟

275
00:15:50,800 --> 00:15:53,510
أجل. هل تعتقدين أنّ ذلك ممكن؟

276
00:15:55,100 --> 00:15:58,650
،يتباطأ الزمن حالما تقترب من سرعة الضوء

277
00:15:59,210 --> 00:16:03,060
لذا إذا تجوّلت بسفينة فضائيّة
،بسرعة أقلّ من سرعة الضّوء

278
00:16:03,360 --> 00:16:06,760
فإنّ الوقت في الأرض سيسبق
،الزمن في السّفينة الفضائيّة

279
00:16:06,760 --> 00:16:08,570
لذا أجل، يمكنك الانتقال للمستقبل

280
00:16:06,770 --> 00:16:10,780
الزمن في السّفينة

281
00:16:06,770 --> 00:16:10,780
الزمن في الأرض

282
00:16:08,570 --> 00:16:10,780
مع أنّه لا توجد أيّ سفينة بهذه السّرعة

283
00:16:10,780 --> 00:16:12,240
ماذا عن الماضي؟

284
00:16:12,240 --> 00:16:14,560
السّفر من زمن لآخر؟

285
00:16:14,560 --> 00:16:17,620
لديك معلومات حول ذلك أكثر منّي، صحيح؟

286
00:16:18,830 --> 00:16:21,650
مجالك هو علم النفس، أليس كذلك؟

287
00:16:21,650 --> 00:16:24,920
ألا تعرف شخصاً يجري بحثاً حول
الإدراك المُتجاوز للحواس؟

288
00:16:24,920 --> 00:16:27,050
هذا نمطيّ

289
00:16:27,050 --> 00:16:29,430
،إذا كان بُعد النّظر موجوداً

290
00:16:29,430 --> 00:16:32,570
ألا يمكن للمرء أن يقول بأنّ المعلومات
كانت تعود بالزمن للوراء؟

291
00:16:33,130 --> 00:16:35,470
،أتحدّث عن معرفة المستقبل فعليّاً

292
00:16:35,470 --> 00:16:37,390
لا مجرّد إجراء توقّعات محسوبة بدقّة

293
00:16:37,390 --> 00:16:39,070
،إذا كان ذلك يحدث فعليّاً

294
00:16:39,070 --> 00:16:41,600
فهذا سيثبت بأنّه يوجد سفر عبر الزمن

295
00:16:44,740 --> 00:16:48,900
رغم ذلك، تندرج فكرة آلة زمن تحت الغوامض

296
00:16:49,450 --> 00:16:52,100
كان ذلك خطأ. لم يسعني فعل شيء

297
00:16:52,100 --> 00:16:52,960
بشأن ماذا؟

298
00:16:52,960 --> 00:16:57,680
تعليق آمالي على العلم وتخيُّل حدود العلم

299
00:16:57,680 --> 00:16:58,780
ماذا تقصد؟

300
00:16:59,420 --> 00:17:03,500
علّقتَ آمالك على وجود آلة زمن

301
00:17:03,500 --> 00:17:06,500
لأنّني قلتُ "في عصري" أثناء حلمك، صحيح؟

302
00:17:08,460 --> 00:17:09,490
مرحباً

303
00:17:10,160 --> 00:17:12,220
ألا يمكنك فعل شيء بشأن هذا الزيّ؟

304
00:17:12,220 --> 00:17:14,550
لا أستطيع، ولن أفعل

305
00:17:15,210 --> 00:17:16,560
هل تريد شيئاً؟

306
00:17:16,560 --> 00:17:18,030
شيماكي-كن

307
00:17:18,030 --> 00:17:20,210
هلّا انضممت إليّ؟

308
00:17:20,210 --> 00:17:22,770
انسَ أمر الأميرة والفرسان وهذا الكوكب

309
00:17:22,770 --> 00:17:24,230
ماذا؟

310
00:17:24,230 --> 00:17:26,860
ينتابني إحساس بأنّك وأنا نستطيع أن ننسجم

311
00:17:26,860 --> 00:17:28,390
دعني أحزر

312
00:17:28,390 --> 00:17:33,360
ماذا كانت أمنيتك الأولى عند صوغ ميثاق الفارس؟

313
00:17:34,010 --> 00:17:37,320
الحصول على سجلّات أكاشيك

314
00:17:37,320 --> 00:17:40,040
حاولتَ معرفة كلّ شيء عن الكون، صحيح؟

315
00:17:41,490 --> 00:17:45,110
حاولتَ أن تصبح كائناً عليماً، أليس كذلك؟

316
00:17:46,260 --> 00:17:48,800
لكن أخبرني كوه بأنّ ذلك مستحيل

317
00:17:49,250 --> 00:17:50,650
،قال بأنّه لو كان يستطيع فعل ذلك

318
00:17:50,650 --> 00:17:55,260
حينئذ سيكون شيئاً نظيراً أو حتّى
أعظم من السّاحر

319
00:17:55,260 --> 00:17:59,630
احتضان هذه الرّغبة هو دلالة على أنّك مثلي

320
00:17:59,630 --> 00:18:02,260
فأساساً هذا ما أرغبه أنا

321
00:18:02,670 --> 00:18:03,940
انضمّ إليّ

322
00:18:03,940 --> 00:18:06,980
لنستحوذ على غموض الكون معاً

323
00:18:09,750 --> 00:18:10,810
مؤلم

324
00:18:11,820 --> 00:18:13,520
!وجدتُ السّاحر

325
00:18:13,520 --> 00:18:16,290
!إنّه أنيموس! أنا متأكّد

326
00:18:16,290 --> 00:18:17,290
!لنقضِ عليه

327
00:18:17,290 --> 00:18:19,280
!ابتعد عن شيماكي-سان

328
00:18:19,280 --> 00:18:21,370
!يوكي-تشان! سوبارو-تشان

329
00:18:21,370 --> 00:18:24,060
الدّيك الصّغير والسُّلحفاة الصّغيرة

330
00:18:24,060 --> 00:18:25,250
مرحباً

331
00:18:25,250 --> 00:18:27,580
!اصمت! هيّا بنا يا يوكي

332
00:18:28,370 --> 00:18:29,670
!أجل يا سوبارو-تشان

333
00:18:34,920 --> 00:18:38,300
أعتقد ينبغي أن أستأذن بالانصراف اليوم

334
00:18:38,630 --> 00:18:40,780
يمكنك أن تعطيني إجابتك لاحقاً

335
00:18:40,780 --> 00:18:41,760
وداعاً

336
00:18:43,220 --> 00:18:45,430
!ا-انتظر! أيُّها السّاحر

337
00:18:45,430 --> 00:18:47,350
!لديّ رسالة من سيّدنا

338
00:18:47,900 --> 00:18:50,310
"قال، "نحن بشر

339
00:19:02,440 --> 00:19:05,200
غالباً سيستدعيك ثانية اللّيلة

340
00:19:06,860 --> 00:19:09,230
هل ستقف في صفّ أنيموس؟

341
00:19:09,230 --> 00:19:13,630
ظننتُ بأنّ دمار الأرض كان هدفه الحقيقيّ

342
00:19:13,910 --> 00:19:15,960
لكن الأمر ليس كذلك

343
00:19:15,960 --> 00:19:17,590
هدفه أكبر من ذلك

344
00:19:17,590 --> 00:19:20,460
هل تريد أن تعرف كلّ شيء عن الكون؟

345
00:19:20,460 --> 00:19:22,050
أجل، أريد

346
00:19:22,050 --> 00:19:23,890
أريد أن أعرف كلّ شيء

347
00:19:28,260 --> 00:19:31,230
حسناً، الأمر كما تعتقد

348
00:19:31,230 --> 00:19:33,190
أنا من المستقبل

349
00:19:33,710 --> 00:19:37,990
أنا الموجة المُتقدّمة التي نشأت من
المستقبل وتطوي الزمكان

350
00:19:37,990 --> 00:19:41,490
بينما أسافر إلى نقطة الأصل حيث مُلتقى كلّ شيء

351
00:19:41,490 --> 00:19:44,800
أنا إله الدّمار الّذي وُلِدَ لإحقاق التّوازن المُضادّ

352
00:19:44,800 --> 00:19:47,760
الكائن الخارق المعروف بالإله
الّذي صنع هذا الكون

353
00:19:47,760 --> 00:19:49,290
هذا هو أنا

354
00:19:49,290 --> 00:19:51,920
هذه حكاية عظيمة وفظيعة في آن واحد

355
00:19:51,920 --> 00:19:57,240
رغم أنّني أمتلك قوّة إله، وُلِدتُ
في البداية كجسد بشريّ

356
00:19:57,240 --> 00:19:59,680
لهذا أنا أيضاً أمتلك رغبة

357
00:19:59,680 --> 00:20:00,380
—رغبة

358
00:20:00,380 --> 00:20:02,340
معرفة كلّ شيء

359
00:20:02,610 --> 00:20:03,760
أجل

360
00:20:03,760 --> 00:20:07,390
وسأؤدّي وظيفتي سعياً وراء
تلك الرّغبة الدنيويّة

361
00:20:07,390 --> 00:20:12,320
أريد رؤية نقطة الالتقاء حيث بدأ
كلّ شيء بأمّ عيني

362
00:20:12,320 --> 00:20:13,810
لنذهب ونراقبها معاً

363
00:20:14,580 --> 00:20:19,030
ولماذا يتفاعل إله مع بشريّ عاديّ مثلي؟

364
00:20:19,030 --> 00:20:24,870
كلّ الفرسان هم أشخاص بإمكانيّة
ليصبحوا نُظراء لي

365
00:20:24,870 --> 00:20:27,270
جميعكم بشر غير عاديّين

366
00:20:28,040 --> 00:20:30,140
لنكن صديقين يا شيماكي-كن

367
00:20:30,140 --> 00:20:34,210
لمَ لا نتشارك بهجة تعلُّم كلّ شيء؟

368
00:20:37,710 --> 00:20:40,260
يبدو أنّني أستطيع استعمالها، حتّى هنا

369
00:20:40,260 --> 00:20:41,460
تستعمل ماذا؟

370
00:20:41,460 --> 00:20:46,300
سأريك ما تمنّيتُه بعد طلب معرفة كلّ شيء

371
00:20:46,300 --> 00:20:47,130
كان

372
00:20:47,130 --> 00:20:49,370
—تطويراً خاصّاً لمجال الاحتواء الّذي لديّ

373
00:20:49,370 --> 00:20:51,930
!مجال الخلق: كيبيلي

374
00:20:54,980 --> 00:20:56,390
ماذا؟

375
00:20:56,390 --> 00:20:58,190
!فارس ينشئ غوليم؟

376
00:20:58,190 --> 00:21:00,230
!يا لها من فكرة

377
00:21:00,230 --> 00:21:01,940
!مذهل يا شيماكي-كن

378
00:21:02,210 --> 00:21:05,240
!لم يفكّر أيّ فارس في هذا من قبل

379
00:21:05,240 --> 00:21:11,230
هدفي هو استخدام معرفة سجلّات
أكاشيك لإسعاد البشريّة جمعاء

380
00:21:11,230 --> 00:21:15,330
لذا سأسحق طموحك الضّئيل

381
00:21:15,330 --> 00:21:19,110
من فضلك مُت هنا لأجل البشريّة يا إله

382
00:21:24,210 --> 00:21:25,710
:مجال الفوضى

383
00:21:25,710 --> 00:21:26,740
!باندورا

384
00:21:31,850 --> 00:21:33,810
!...ماذا؟! أنت

385
00:21:33,810 --> 00:21:35,460
اسمح لي أن أعرّفك

386
00:21:35,460 --> 00:21:38,870
،إنّه فارس البوم وفارسي

387
00:21:38,870 --> 00:21:40,910
أكاني تايو-كن

388
00:21:40,910 --> 00:21:42,030
لا تلمسني

389
00:21:42,510 --> 00:21:45,700
...كلّ هراء إله الدّمار وسعادة البشريّة هذا

390
00:21:45,700 --> 00:21:47,410
أنتما لستُما عاديّين

391
00:21:47,410 --> 00:21:48,490
أنتما وحشان

392
00:21:48,490 --> 00:21:51,450
يبدو أنّه في فترة التمرُّد تلك

393
00:21:51,450 --> 00:21:54,470
...ما معنى هذا يا أكاني-كن؟ أنت

394
00:21:54,470 --> 00:21:56,640
يا لها من خسارة يا شيماكي-كن

395
00:21:56,640 --> 00:21:59,680
حسناً، لنكتفِ بهذا القدر اليوم

396
00:21:59,680 --> 00:22:00,670
إلى اللّقاء

397
00:22:00,670 --> 00:22:03,210
!أنيموس! أكاني-كن! انتظرا

398
00:22:05,900 --> 00:22:06,870
صباح الخير

399
00:22:06,870 --> 00:22:08,240
صباح النُّور

400
00:22:09,210 --> 00:22:11,260
هل وقفت في صفّ أنيموس؟

401
00:22:11,260 --> 00:22:13,990
...لم أستطع. رغم أنّ

402
00:22:13,990 --> 00:22:15,010
رغم ماذا؟

403
00:22:15,880 --> 00:22:17,760
لا، سأتجاهل الأمر حاليّاً

404
00:22:17,760 --> 00:22:21,460
مجرى الزمن شيء عظيم. قويّ
بما يكفي لإنشاء آلهة

405
00:22:21,460 --> 00:22:24,220
لا أحد يعلم كيف سيُصاغ القدر

406
00:22:24,220 --> 00:22:26,990
لا أفهم شيئاً ممّا تقوله

407
00:22:26,990 --> 00:22:29,070
أنتما لستُما عاديّين

408
00:22:29,070 --> 00:22:30,200
أنتما وحشان

409
00:22:30,200 --> 00:22:32,140
وحشان؟

410
00:22:32,140 --> 00:22:34,160
هل أنا وحش أيضاً؟

411
00:22:34,520 --> 00:22:36,370
لا، ربّما هذا أمر إيجابيّ

412
00:22:38,330 --> 00:22:41,670
دوري هو أن أكون وحشاً قاتلاً للآلهة

413
00:22:41,670 --> 00:22:44,790
عميل سلام يلتهم أحشاء إله شرّير

414
00:22:45,440 --> 00:22:50,300
لمَ لا أطمح لأصبح وحشاً يقاتل لأجل العدالة؟