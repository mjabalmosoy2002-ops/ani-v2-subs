1
00:00:03,580 --> 00:00:04,940
!حان وقت الأكل

2
00:00:11,970 --> 00:00:15,450
أتساءل ما إن كان يو-كن قد وصل للمنزل بعد

3
00:01:52,830 --> 00:01:56,130
تدرك بأنّني ما زلتُ لم أحقّق الأمنية التي تستحقّها

4
00:01:56,130 --> 00:01:59,380
بعد كمكُافأة على إبرام ميثاق مع فارس، صحيح؟

5
00:01:59,380 --> 00:02:00,360
أجل

6
00:02:01,180 --> 00:02:04,610
سيكون من الممكن علاج مرض جدّك

7
00:02:05,780 --> 00:02:08,060
قد أطلب منك قتله فحسب

8
00:02:09,700 --> 00:02:13,150
ماذا حدث بينك وبين جدّك؟

9
00:02:13,950 --> 00:02:16,020
تربّيتُ بواسطة جدّي

10
00:02:16,530 --> 00:02:18,400
،كان يحذّرني ثلاثة مرّات في اليوم

11
00:02:18,400 --> 00:02:20,720
"لا تشكّل أعداء. سيطعنونك في بطنك"

12
00:02:20,720 --> 00:02:23,370
"لا تشكّل أصدقاء. سيطعنونك في ظهرك"

13
00:02:23,370 --> 00:02:26,300
"النّاس قمامة، بمن فيهم أنت وأنا"

14
00:02:26,300 --> 00:02:28,150
لعشر سنوات كاملة متتالية

15
00:02:34,880 --> 00:02:37,340
لماذا تقيم في غرفة الضّيوف في منزلك؟

16
00:02:37,920 --> 00:02:40,840
لأنّ ابن عمّي كويشي يستخدم غرفتي

17
00:02:41,890 --> 00:02:43,400
،عندما ذهبتُ إلى الكلّية

18
00:02:43,400 --> 00:02:46,530
،قلِقَتْ عمّتي بشأن إقامة جدّي بمفرده

19
00:02:46,530 --> 00:02:49,270
لذا تعيش عائلتها هنا الآن

20
00:02:49,530 --> 00:02:51,040
عمّتك؟

21
00:02:51,040 --> 00:02:53,230
ماذا عن والديك؟

22
00:02:53,500 --> 00:02:55,400
...أجل، بخصوص ذلك

23
00:02:56,690 --> 00:02:59,670
يو-ني، العشاء جاهز

24
00:03:01,990 --> 00:03:03,570
!حان وقت الأكل

25
00:03:03,840 --> 00:03:07,290
،يوهي، أعددتُ طعامك المُفضّل، كاراغي

26
00:03:07,570 --> 00:03:09,140
لذا كُل حتّى الشبع

27
00:03:09,140 --> 00:03:10,660
شكراً لك

28
00:03:14,250 --> 00:03:16,440
!أمّي، أعددتِ كمّية كبيرة

29
00:03:16,440 --> 00:03:17,830
كان ذلك لذيذاً

30
00:03:19,790 --> 00:03:22,150
،لذا لنعُد إلى حديثنا السّابق

31
00:03:22,150 --> 00:03:24,330
ماذا عن والديك؟

32
00:03:24,330 --> 00:03:25,390
أجل

33
00:03:30,920 --> 00:03:33,810
أبي وأمّي قد رحلا

34
00:03:35,020 --> 00:03:37,320
لا أعرف ماذا أقول

35
00:03:37,620 --> 00:03:41,650
كان أبي مُتحرّياً، وذات يوم اختفى

36
00:03:42,280 --> 00:03:45,860
بعد أشهر عديدة، قبضوا على رجل
يعمل في تهريب الأسلحة

37
00:03:45,860 --> 00:03:49,300
اعترفَ بقتل مُتحرٍّ شاهده وهو يجري صفقة

38
00:03:49,300 --> 00:03:51,530
ورمى بجثّته في الجبال

39
00:03:53,230 --> 00:03:55,040
،والمُتحرّي الّذي تخلّص منه كان أبي

40
00:03:55,850 --> 00:03:58,750
والرّجل الّذي قُبِض عليه كان شريكه

41
00:03:59,350 --> 00:04:02,780
عندما سمعت أمّي الأنباء، انهارت نفسيّاً واختفت

42
00:04:03,680 --> 00:04:06,100
فقدَ جدّي الأمل في البشريّة

43
00:04:06,100 --> 00:04:08,410
وربّاني لتجنّب كلّ أشكال التّفاعل مع النّاس

44
00:04:08,410 --> 00:04:10,640
وذلك كي لا ينتهي المطاف بي مثل أبي

45
00:04:11,320 --> 00:04:14,010
كلّما عارضتُ تعاليمه كان يقيّدني

46
00:04:14,010 --> 00:04:15,400
ويحبسني

47
00:04:20,450 --> 00:04:21,570
هذا جنون، صحيح؟

48
00:04:21,970 --> 00:04:23,840
قاسٍ جدّاً لدرجة أنّها تبدو مزحة

49
00:04:25,360 --> 00:04:27,880
انظر إلى وجهك يا يوهي

50
00:04:27,880 --> 00:04:31,290
تبدو كطفل بكّاء بالنسبة لي

51
00:04:31,720 --> 00:04:34,460
لكن كنتُ أبتسم ابتسامة عاديّة

52
00:04:34,820 --> 00:04:37,210
ومن الّذي تكرهه؟

53
00:04:37,210 --> 00:04:38,270
جدّك؟

54
00:04:38,270 --> 00:04:40,050
شريك والدك؟

55
00:04:40,430 --> 00:04:43,030
أمّك التي تركتك واختفت؟

56
00:04:45,360 --> 00:04:49,220
هذا العالم بأكمله الّذي صنعهم جميعاً

57
00:04:51,210 --> 00:04:55,880
لهذا سأفعل المستحيل لأساعد الأميرة

58
00:04:56,960 --> 00:04:58,490
في تدمير هذا العالم

59
00:04:59,950 --> 00:05:03,070
إنّ لعن العالم لن يجلب إلّا البؤس لنفسك

60
00:05:03,960 --> 00:05:05,800
أنا بائس جدّاً لدرجة لم أعد أبتسم فيها

61
00:05:10,500 --> 00:05:13,850
جدّي، أحضرتُ يو-ني

62
00:05:16,970 --> 00:05:18,020
أنت

63
00:05:19,130 --> 00:05:21,680
نسيتُ شراء شيء للشرب

64
00:05:21,680 --> 00:05:23,820
يو-ني، هل تريد شيئاً؟

65
00:05:23,820 --> 00:05:25,570
لا، لا داعي

66
00:05:25,570 --> 00:05:26,470
حسناً

67
00:05:36,530 --> 00:05:39,280
هناك قوّة في عينيك

68
00:05:40,100 --> 00:05:42,640
وجدتَ مكاناً تنتمي له

69
00:05:43,850 --> 00:05:44,990
صديق؟

70
00:05:59,340 --> 00:06:02,290
لا ترتعد. لن أفعل شيئاً

71
00:06:02,720 --> 00:06:06,860
،بعد أن غادرتَ وبدأتُ أعيش مع عائلة كويشي

72
00:06:06,860 --> 00:06:09,760
بدأتُ أخيراً أسترجع الابتسامة التي فقدتُها

73
00:06:09,760 --> 00:06:12,740
عندما غادرَنا الداك

74
00:06:14,180 --> 00:06:16,510
لم يبقَ لي فترة طويلة في هذا العالم

75
00:06:16,510 --> 00:06:20,140
اسمح لي بطلب أنانيّ أخير. أريد أن أعتذر

76
00:06:20,790 --> 00:06:24,250
مع أنّني أعلم بأنّه لا يمكن أن يُغفَر لي

77
00:06:24,250 --> 00:06:25,890
!بالطبع لا

78
00:06:25,890 --> 00:06:27,460
!كيف لي أن أسامحك؟

79
00:06:27,460 --> 00:06:29,610
!الاعتذار الآن لن يكفي

80
00:06:30,350 --> 00:06:34,200
أتعتقد بأنّك تستطيع التّعويض عن أيّ
فعل بغيض فعلته لي؟

81
00:06:34,670 --> 00:06:36,370
طلبك غير مُجاب إذا كنت تعتقد

82
00:06:37,320 --> 00:06:39,960
بأنّك تستطيع أن تحني رأسك
!وتقول بأنّك تحسّنت فحسب

83
00:06:43,480 --> 00:06:44,750
يو-ني؟

84
00:06:45,590 --> 00:06:47,130
!اللّعنة عليك يا جدّي

85
00:06:47,130 --> 00:06:50,720
هل لديك أدنى فكرة كم حزنتُ عندما
!غادر أبي وأمّي؟

86
00:06:51,120 --> 00:06:53,990
!ومع ذلك حرّرتَ كلّ حزنك اللّعين عليّ

87
00:06:53,990 --> 00:06:56,500
في الوقت الّذي كان من المُفترض
!أن يكون أنا من يحزن؟

88
00:06:56,500 --> 00:06:59,060
!كتِف مَن كان يُفترض أن أستند عليه وأبكي؟

89
00:07:07,560 --> 00:07:09,150
!كـ-كيف يُعقَل هذا؟

90
00:07:18,120 --> 00:07:19,050
!اهرب

91
00:07:27,420 --> 00:07:29,130
!يا لها من قوّة

92
00:07:29,770 --> 00:07:33,090
!سأموت مباشرة إذا تلقّيتُ حتّى لكمة واحدة

93
00:07:37,840 --> 00:07:39,840
إنّه يعاني في التحرّك

94
00:07:39,840 --> 00:07:41,930
كان دخول الجبال الخيار الصّائب

95
00:07:44,830 --> 00:07:47,930
رغم أنّك جريتَ لأكثر من ساعة الآن

96
00:07:47,930 --> 00:07:49,530
ألم تبلغ أقصى حدّ لديك؟

97
00:07:49,530 --> 00:07:52,610
عندما أبلغ حدّي الأقصى، أموت

98
00:07:52,610 --> 00:07:55,200
لدى الغوليم لياقة غير محدودة

99
00:07:55,200 --> 00:07:57,420
،مهما ابتعدت عنه في هذه الجبال

100
00:07:57,420 --> 00:07:58,650
سوف يصل إليك في نهاية المطاف

101
00:08:13,310 --> 00:08:14,450
...يجب

102
00:08:15,420 --> 00:08:16,760
...يجب أن أفعل شيئاً

103
00:08:17,350 --> 00:08:19,350
لا يسعك فعل شيء

104
00:08:19,350 --> 00:08:21,520
،لديك مجال الاحتواء

105
00:08:21,520 --> 00:08:24,740
لكن هذا أشبه بمقاتلة دبّابة بسيف خشبيّ

106
00:08:25,150 --> 00:08:27,730
قوّته بمستوى مختلف

107
00:08:29,260 --> 00:08:30,800
...هذا

108
00:08:30,800 --> 00:08:33,110
انتهى أمرنا يا يوهي

109
00:08:33,700 --> 00:08:37,910
لا! هل سأنهزم في منتصف الطريق
بهذا الشّكل من جديد؟

110
00:08:38,270 --> 00:08:40,620
من جديد؟ ماذا تعني بـ"من جديد"؟

111
00:08:45,250 --> 00:08:46,170
!تباً

112
00:09:13,650 --> 00:09:15,710
...أنا أغيب عن الوعي

113
00:09:15,710 --> 00:09:19,430
النّوم يعني بأنّك لن تعاني في النّهاية

114
00:09:19,430 --> 00:09:21,330
الوداع يا يوهي

115
00:09:25,860 --> 00:09:26,840
أين أنا؟

116
00:09:28,110 --> 00:09:29,450
يو-كن

117
00:09:32,130 --> 00:09:33,280
نمت من الآن؟

118
00:09:34,190 --> 00:09:36,070
التقيتُ بغوليم

119
00:09:36,550 --> 00:09:39,870
تعبتُ كثيراً بعد الهرب منه لدرجة
أنّني غبتُ عن الوعي

120
00:09:41,000 --> 00:09:42,430
هذا سيّئ

121
00:09:42,830 --> 00:09:46,020
تسرّني رؤيتكِ من جديد مرّة أخيرة
ولو كان هذا مجرّد حلم

122
00:09:48,020 --> 00:09:50,050
كنتُ خائفاً جدّاً من جنازير جدّي

123
00:09:50,770 --> 00:09:53,540
لكن لا يمكنني العيش من دون أيّ جنازير بعد الآن

124
00:09:54,380 --> 00:09:56,490
لهذا أردتُ ذلك

125
00:09:56,490 --> 00:10:00,110
أردتُ دليلاً مُطلقاً يخبرني ماذا عليّ أن أفعل

126
00:10:00,110 --> 00:10:01,450
دليل؟

127
00:10:02,130 --> 00:10:04,640
،بقسَم الولاء لكِ

128
00:10:04,640 --> 00:10:06,440
كنتُ أحاول إقناع نفسي بأنّني قد أتقيّد

129
00:10:06,440 --> 00:10:08,490
بجنازير جديدة ليست من جدّي

130
00:10:10,480 --> 00:10:14,570
كنتُ أهرب من مسؤوليّة التّفكير لأجل نفسي فقط

131
00:10:15,130 --> 00:10:16,970
استخدمتك

132
00:10:17,500 --> 00:10:19,080
أنا آسف على كلّ شيء

133
00:10:20,220 --> 00:10:21,290
يو-كن

134
00:10:22,570 --> 00:10:24,220
هل تحبّني؟

135
00:10:25,450 --> 00:10:27,550
!أ-أتطرحين هذا السّؤال الآن؟

136
00:10:28,290 --> 00:10:30,850
لا، بسبب ما يجري الآن؟

137
00:10:30,850 --> 00:10:34,070
أجل. ردّة فعلك هي دليلٌ كافٍ

138
00:10:36,420 --> 00:10:39,640
مع أنّ هذه ليست مشكلة يمكن
حلّها بتوجيه أمر لك للنجاة

139
00:10:40,300 --> 00:10:41,440
...لذا بدلاً من ذلك

140
00:10:43,030 --> 00:10:45,650
!إذا عدتَ حيّاً، سأمنحك قبلة

141
00:10:45,650 --> 00:10:46,330
!قبلة

142
00:10:46,330 --> 00:10:47,690
!ماذا؟

143
00:10:47,690 --> 00:10:50,150
!لـ-لكن لن يتذكّر أحدنا هذا عندما نستيقظ

144
00:10:50,150 --> 00:10:55,380
فضلاً عن ذلك، الّتي أحبّها هي
نفسك الخارجيّة الأظرف

145
00:10:55,880 --> 00:10:58,720
!أيّها الوقح! كلتاهما أنا

146
00:10:58,720 --> 00:11:01,680
!والآن اخرج إلى هناك وافعل شيئاً بشأن هذا

147
00:11:02,890 --> 00:11:05,370
استيقظت؟

148
00:11:05,370 --> 00:11:06,940
كم غبتُ عن الوعي؟

149
00:11:06,940 --> 00:11:08,980
دقيقة أو اثنتين

150
00:11:08,980 --> 00:11:12,230
هكذا إذاً. أشعر وكأنّني نمتُ لستّ ساعات

151
00:11:12,890 --> 00:11:15,340
انتهى أمرنا أخيراً

152
00:11:15,340 --> 00:11:17,030
يمكنني الفوز الآن

153
00:11:17,030 --> 00:11:18,300
عمّاذا تتكلّم؟

154
00:11:19,700 --> 00:11:21,070
!هيّا بنا

155
00:11:21,780 --> 00:11:22,950
!سأتغلّب

156
00:11:23,620 --> 00:11:25,650
!على هذه المِحنة

157
00:11:26,620 --> 00:11:28,750
تدفع الصّخرة بمجال الاحتواء؟

158
00:11:37,460 --> 00:11:38,660
لا جدوى؟

159
00:11:38,660 --> 00:11:41,800
هجمتك الشّاملة خدشَتْه خدشاً فقط

160
00:11:45,150 --> 00:11:47,110
يوهي، لا فائدة

161
00:11:47,110 --> 00:11:48,970
لستُ ندّاً له

162
00:11:49,490 --> 00:11:52,760
أنا آسف لإقحامك في هذه المعركة

163
00:11:53,560 --> 00:11:55,400
أريد الاعتذار

164
00:11:55,890 --> 00:11:57,610
أنا آسف على كلّ شيء

165
00:11:57,940 --> 00:11:59,140
!لا تعتذر

166
00:11:59,140 --> 00:12:00,690
!لن نموت

167
00:12:01,130 --> 00:12:03,560
!أخبرتُك للتو بأنّني سأتغلّب على هذه المِحنة

168
00:12:03,560 --> 00:12:04,940
انظر إلى معدة الغوليم

169
00:12:04,940 --> 00:12:09,660
قد يكون خفيفاً، لكن شيئاً غير
قبضة الأميرة قد أضرّ بها

170
00:12:09,660 --> 00:12:12,090
!هذا يعني أنّه يمكن هزيمته؟

171
00:12:14,210 --> 00:12:15,200
!ما الخطب؟

172
00:12:15,200 --> 00:12:16,490
!لماذا تتوقّف؟

173
00:12:18,170 --> 00:12:19,440
!مُنحدر

174
00:12:21,130 --> 00:12:22,650
...هذا الارتفاع

175
00:12:22,650 --> 00:12:26,250
لن تتمكّن من النّزول بلياقتك المُنهَكة

176
00:12:40,290 --> 00:12:41,070
!ماذا؟

177
00:12:41,070 --> 00:12:42,390
!كيف؟

178
00:12:43,020 --> 00:12:45,790
استخدمتُ عدداً من الاندفاعات القصيرة

179
00:12:45,790 --> 00:12:48,230
لتقليص مدّة التّفعيل

180
00:12:48,230 --> 00:12:50,290
بالكاد استخدمتُ أيّ لياقة بذلك

181
00:12:50,290 --> 00:12:52,040
!إنّه قادم نحوك

182
00:12:52,040 --> 00:12:53,250
الأحمق

183
00:12:53,820 --> 00:12:55,450
،مهما كان قويّاً

184
00:12:55,450 --> 00:12:59,170
لا يستطيع استخدام قوّته الهائلة في
الهواء حيث لا يوجد موطئ قدم

185
00:12:59,790 --> 00:13:01,760
!فلتغُص

186
00:13:06,930 --> 00:13:09,100
هذا هو الغوليم إذاً؟

187
00:13:09,100 --> 00:13:10,630
ليس مُبهراً إلى هذا الحدّ

188
00:13:14,570 --> 00:13:15,480
مرحباً؟

189
00:13:15,480 --> 00:13:18,010
!يو-ني! أجبت أخيراً

190
00:13:18,010 --> 00:13:19,060
ما الأمر؟

191
00:13:19,060 --> 00:13:21,080
!عُد إلى المشفى حالاً

192
00:13:21,080 --> 00:13:22,400
!...إنّ جدّي

193
00:13:22,400 --> 00:13:23,930
...جدّي

194
00:13:51,390 --> 00:13:52,570
!جدّي؟

195
00:13:52,570 --> 00:13:53,890
!استدعوا طبيبه

196
00:13:53,310 --> 00:13:54,920
!تماسك

197
00:13:53,890 --> 00:13:54,920
!عُلِم

198
00:14:01,570 --> 00:14:03,500
ما الأمر يا يوهي؟

199
00:14:06,560 --> 00:14:08,790
لا أستطيع مسامحة جدّي أبداً

200
00:14:09,720 --> 00:14:11,160
...يوهي

201
00:14:11,160 --> 00:14:15,120
عشرة أشهر تقريباً مع كويشي

202
00:14:15,640 --> 00:14:17,940
عكسَتْ تلك السّنوات العشر معي؟

203
00:14:18,690 --> 00:14:21,080
!ما الّذي كنتُ أعنيه بالنسبة له إذاً؟

204
00:14:21,470 --> 00:14:24,380
،لعلّ ذلك كان بطريقة مُلتوية

205
00:14:24,380 --> 00:14:27,040
لكن أحبَّك جدُّك

206
00:14:27,890 --> 00:14:29,880
أاحبّني؟

207
00:14:31,320 --> 00:14:33,730
الحبّ لا يسمح لك بالإفلات بأيّ شيء تفعله

208
00:14:34,530 --> 00:14:36,600
...قد يكون هذا صحيحاً، لكن

209
00:14:41,320 --> 00:14:46,700
فهمت. تريد أن تكون مُتحرّياً مثل أبيك إذاً؟

210
00:14:54,230 --> 00:14:55,480
...نوي

211
00:14:55,480 --> 00:14:56,610
ما الأمر؟

212
00:14:59,240 --> 00:15:01,290
أنقذ جدّي

213
00:15:01,880 --> 00:15:04,340
!عُلِم يا صديقي

214
00:15:14,880 --> 00:15:18,590
!اكتمل ميثاق الفارس الآن

215
00:15:18,590 --> 00:15:21,330
!لنواجه الموت معاً

216
00:15:22,100 --> 00:15:25,400
نوي... شكراً لك

217
00:15:33,760 --> 00:15:36,160
رأيت؟ عدتُ على قيد الحياة

218
00:15:37,450 --> 00:15:40,210
على أيّ حال، يسرّني بأنّك نجوت

219
00:15:40,960 --> 00:15:42,170
أجل، كذلك أنا

220
00:15:44,080 --> 00:15:45,420
!ما-ماذا؟

221
00:15:45,420 --> 00:15:48,960
أريد أن أعطيك مكافأتك

222
00:15:58,400 --> 00:16:00,350
طلعَ الصّباح

223
00:16:04,720 --> 00:16:07,980
ما نظرة عدم الرّضا هذه؟

224
00:16:08,930 --> 00:16:09,930
،في الواقع

225
00:16:10,760 --> 00:16:13,580
أشعر وكأنّني شاهدتُ حلماً مُخيّباً للتو

226
00:16:19,580 --> 00:16:21,060
صباح الخير

227
00:16:21,840 --> 00:16:22,910
!يو-كن

228
00:16:23,400 --> 00:16:24,510
!صباح الخير

229
00:16:24,510 --> 00:16:25,280
هل أنت بخير؟

230
00:16:25,280 --> 00:16:27,130
،لا أعاني من شيء جوهريّاً

231
00:16:27,130 --> 00:16:29,880
لكن عضلاتي متخدّرة من الجري في الجبال

232
00:16:31,410 --> 00:16:33,190
!عليك أن تتدرّب أكثر إذاً

233
00:16:34,340 --> 00:16:40,320
!47, 48, 49, 50

234
00:16:40,320 --> 00:16:41,380
!انتهيت

235
00:16:41,380 --> 00:16:42,270
فعلتها

236
00:16:44,300 --> 00:16:45,880
،منذ ذلك الحين

237
00:16:45,880 --> 00:16:47,900
شعرتُ بحرارة تتراكم داخل صدري

238
00:16:47,900 --> 00:16:51,340
وتملؤني حتّى الأعصاب في أصابعي

239
00:16:51,820 --> 00:16:53,140
يمكنني أن أقاتل

240
00:16:53,690 --> 00:16:56,050
يمكنني مقاتلة أولئك الغوليم

241
00:16:58,280 --> 00:16:59,740
!حسناً، وقت الطعام، وقت الطعام

242
00:16:59,740 --> 00:17:01,950
يمكنني مساعدتها

243
00:17:02,840 --> 00:17:05,690
!سأكون اليد اليمنى للشيطان

244
00:17:05,690 --> 00:17:08,350
!توقّفا مكانكما

245
00:17:09,070 --> 00:17:10,630
!مرحباً

246
00:17:10,630 --> 00:17:12,710
سررتُ بلقائكما

247
00:17:13,200 --> 00:17:13,940
من أنت؟

248
00:17:13,940 --> 00:17:15,180
...اسمي هو

249
00:17:18,190 --> 00:17:20,630
!شينونومي هانغيتسو...

250
00:17:22,890 --> 00:17:24,140
...و

251
00:17:24,140 --> 00:17:25,540
هذه بطاقتي

252
00:17:26,000 --> 00:17:27,610
اسمي أماميا يوهي

253
00:17:27,610 --> 00:17:29,360
أنا أساهينا ساميداري

254
00:17:30,610 --> 00:17:32,380
بطل عدالة؟

255
00:17:32,380 --> 00:17:34,860
!يبعث هذا على السّرور

256
00:17:34,860 --> 00:17:36,530
عدالة؟

257
00:17:36,530 --> 00:17:39,570
أنت لا تتغيّر أبداً يا نوي كريزانت

258
00:17:40,070 --> 00:17:43,090
أمنيتنا العظمى هي هزيمة ذلك السّاحر

259
00:17:43,090 --> 00:17:45,720
وإيقاف مِطرقة البسكويت من السّقوط

260
00:17:46,320 --> 00:17:49,290
ينبغي أن نبقى هادئين ريثما نحقّق ذلك

261
00:17:49,290 --> 00:17:51,100
!تكلّم الكلب

262
00:17:51,100 --> 00:17:52,380
!أنت فارس؟

263
00:17:52,380 --> 00:17:54,670
سررتُ بلقائكِ يا أميرة

264
00:17:54,670 --> 00:17:56,840
أنت أيضاً فارس سحليّة

265
00:17:57,180 --> 00:17:58,670
لودو تشيفالير

266
00:17:58,670 --> 00:17:59,800
أنا مُحارب

267
00:17:59,800 --> 00:18:01,930
هذا مُنشار(رودو). الفارس الكلب

268
00:18:01,930 --> 00:18:03,010
!اسمي لودو

269
00:18:03,010 --> 00:18:05,560
،لاحظتُكما قبل مدّة

270
00:18:05,560 --> 00:18:08,980
لكن أردتُ أن أظهر أمامكما بطريقة
رائعة حتّى جاء هذا اليوم

271
00:18:09,980 --> 00:18:12,870
أعتقد انتهى الأمر بتعريف عاديّ

272
00:18:12,870 --> 00:18:14,940
آسف على التأخّر بالانضمام إليكم

273
00:18:15,450 --> 00:18:17,770
أتعتبر هذا عاديّاً؟

274
00:18:17,770 --> 00:18:20,820
!عليّ أن أشرع في العمل

275
00:18:20,820 --> 00:18:23,790
!لنتكلّم مُطوّلاً في المرّة المقبلة

276
00:18:23,790 --> 00:18:24,880
!هيّا بنا يا مُنشار

277
00:18:24,880 --> 00:18:26,040
!لودو

278
00:18:27,580 --> 00:18:29,280
يا له من رجل طريف

279
00:18:35,680 --> 00:18:40,650
قال ذلك الكلب بأنّك لم تتغيّر، لذا
هل تعرفان بعضكما الآخر؟

280
00:18:40,650 --> 00:18:43,640
كلانا فارسان، لذا يجدر بنا أن نعرف بعضنا

281
00:18:44,310 --> 00:18:45,100
يجدر؟

282
00:18:45,100 --> 00:18:47,210
لا أتذكّره

283
00:18:47,210 --> 00:18:51,860
لكن بصراحة، مُعظم ذكرياتي قبل
اللّقاء بك ضبابيّة

284
00:18:52,370 --> 00:18:56,570
لا أعرف سوى الأساسيّات، حتّى
عندما يتعلّق الأمر بقتالنا

285
00:18:56,570 --> 00:18:59,310
كلّ شيء بما في ذلك "إنقاذ العالم
من مِطرقة البسكويت

286
00:18:59,310 --> 00:19:02,910
وحماية أميرتنا من السّاحر"؟

287
00:19:03,330 --> 00:19:05,900
لا أفهم ما مدى ارتباط كلّ هذا ببعضه

288
00:19:10,040 --> 00:19:12,500
شينونومي هانغيتسو، صحيح؟

289
00:19:12,500 --> 00:19:14,840
،إذا كان يعتبر نفسه بطل عدالة

290
00:19:14,840 --> 00:19:17,260
إذاً ينبغي أن أتستّر على طموح الأميرة

291
00:19:17,840 --> 00:19:20,270
أاعتقد لا يستحقّ الأمر القلق

292
00:19:20,270 --> 00:19:23,060
يبدو أخرق، لذا أشكّ في أنّه سيكون قويّاً في القتال

293
00:19:26,260 --> 00:19:27,590
!يو-كن

294
00:19:28,160 --> 00:19:29,560
في طريق عودتك إلى المنزل؟

295
00:19:29,560 --> 00:19:31,200
!أجل. لنذهب إلى المنزل معاً

296
00:19:31,200 --> 00:19:32,100
بالتأكيد

297
00:19:32,100 --> 00:19:33,950
!اسمع

298
00:19:33,950 --> 00:19:37,260
!البارحة، قامت أختي بتصرّف طريف حقّاً

299
00:19:37,900 --> 00:19:38,900
!أنتِ مكشوفة

300
00:19:55,200 --> 00:19:56,670
!ما-ماذا كان ذلك؟

301
00:19:56,670 --> 00:19:59,340
هانغيتسو هو معلّم في الفنون القتاليّة القديمة

302
00:19:59,340 --> 00:20:02,900
لا القوّة الهائلة ولا السّرعة الخاطفة تنفعان معه

303
00:20:06,230 --> 00:20:07,600
...يا له من رجل

304
00:20:07,970 --> 00:20:10,930
يُعامل أميرتنا وكأنّها طفلة

305
00:20:12,000 --> 00:20:13,690
!لا وقت للاكتفاء بالمراقبة

306
00:20:13,690 --> 00:20:14,470
!أوقفهما

307
00:20:14,470 --> 00:20:17,140
!سيكون من الفظيع أن تصيبه ولو بضربة واحدة

308
00:20:17,140 --> 00:20:18,520
تريدني أن أوقفهما؟

309
00:20:18,820 --> 00:20:21,510
!لكن لا فُرصة لي للتدخّل

310
00:20:22,270 --> 00:20:23,530
...في هذه الحالة

311
00:20:24,200 --> 00:20:27,280
!لا تتحرّك! إلّا إن كنت لا تهتمّ لما يحدث له

312
00:20:28,170 --> 00:20:29,830
!كلب رهينة؟

313
00:20:38,880 --> 00:20:40,380
مهلاً

314
00:20:41,690 --> 00:20:43,920
،ظننتُني ألغيتُ مُعظم ذلك التأثير

315
00:20:43,920 --> 00:20:46,090
لكن مع ذلك قذفتني بعيداً

316
00:20:46,090 --> 00:20:48,000
!كان ذلك وشيكاً

317
00:20:48,000 --> 00:20:50,060
!خلتُ نفسي قد قتلتُك

318
00:20:50,060 --> 00:20:50,980
!ماذا؟

319
00:20:52,320 --> 00:20:54,030
!يا لها من قوّة! مذهل

320
00:20:54,030 --> 00:20:55,270
!مُطمئن

321
00:20:57,450 --> 00:20:58,390
آسف بشأن ذلك

322
00:20:58,390 --> 00:20:59,980
كنتُ أختبرها قليلاً فحسب

323
00:21:00,270 --> 00:21:02,940
أردتُ قياس قوّة الأميرة الّتي يُزعَم
بأنّها قويّة بنفسي

324
00:21:03,420 --> 00:21:07,410
يبدو أنّكِ تعتمدين على القوّة الجسديّة الخالصة

325
00:21:07,410 --> 00:21:08,960
أماميا

326
00:21:08,960 --> 00:21:11,740
هل تنوي اللّجوء إلى نفس هذه التّكتيكات

327
00:21:11,740 --> 00:21:13,620
عندما تقاتل الأميرة غوليم؟

328
00:21:14,560 --> 00:21:16,460
هذه قوّة فارغة

329
00:21:17,290 --> 00:21:19,400
أنت أسفل السّافلين

330
00:21:22,210 --> 00:21:23,420
!حسناً

331
00:21:23,420 --> 00:21:25,620
!عليّ الانتقال إلى عملي التّالي

332
00:21:25,620 --> 00:21:27,370
!إلى اللّقاء

333
00:21:34,590 --> 00:21:37,290
!بطل العدالة، شينونومي هانغيتسو

334
00:21:37,290 --> 00:21:39,270
!يا له من رجل طريف

335
00:21:39,270 --> 00:21:41,400
تبدين فظّة بالضحك وفمكِ مفتوح هكذا

336
00:21:41,400 --> 00:21:46,130
قلت بأنّك أحببت شخصي الخارجيّ الأكثر تهذيباً؟

337
00:21:46,130 --> 00:21:48,570
هل هو مُهذّب حقّاً؟

338
00:21:49,280 --> 00:21:53,410
أنت نزِق هكذا لأنّك لم تستطع التّباهي
أمام شخصي الخارجيّ، أليس كذلك؟

339
00:21:53,410 --> 00:21:56,630
وهل أنتِ بخير بعد مقاتلته هكذا؟

340
00:21:57,250 --> 00:21:59,850
هل أنا بخير؟

341
00:22:04,370 --> 00:22:05,800
مع من تعتقد نفسك تتكلّم؟

342
00:22:14,180 --> 00:22:16,560
المكافأة التي فشلتُ في منحك إيّاها في الأمس

343
00:22:17,370 --> 00:22:19,590
لا وقت نهدره على الامتعاض

344
00:22:19,590 --> 00:22:22,020
كُن أقوى، لأجلي أيضاً

345
00:22:22,780 --> 00:22:24,730
سيتوجّب عليّ أن أصبح أقوى أيضاً

346
00:22:25,660 --> 00:22:27,950
إذا أردتُ سحق العالم

347
00:22:29,990 --> 00:22:31,650
ما الأمر؟

348
00:22:31,650 --> 00:22:35,200
شعرتُ وكأنّني رأيتُ حلماً جميلاً فحسب

349
00:22:35,200 --> 00:22:37,210
يبدو هذا جيّداً لي

350
00:22:37,210 --> 00:22:39,810
كنتَ كئيباً جدّاً عندما خلدتَ إلى النّوم

351
00:22:41,930 --> 00:22:43,960
الشّفقة على نفسي لن تغيّر شيئاً

352
00:22:44,510 --> 00:22:47,370
الأهمّ هو أن أصبح أقوى

353
00:22:48,530 --> 00:22:50,490
بصفتي يد الشّيطان اليمنى