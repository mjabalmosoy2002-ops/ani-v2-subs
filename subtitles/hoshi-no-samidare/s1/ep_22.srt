1
00:00:10,470 --> 00:00:13,490
نصبَ حاجزاً حول الجزيرة

2
00:00:14,370 --> 00:00:17,160
لا يمكننا الانتقال آنيّاً أقرب من ذلك إلى الجزيرة

3
00:00:17,160 --> 00:00:18,440
ماذا؟

4
00:00:19,330 --> 00:00:20,550
لا يمكنكِ كسره؟

5
00:00:23,270 --> 00:00:24,580
إنّه قويّ جدّاً

6
00:00:25,380 --> 00:00:29,450
يبدو أنّ أنيموس صبَّ مُعظم قوّته فيه

7
00:00:32,680 --> 00:00:36,390
دمّرتِ مِطرقة البسكويت خاصّته، لذا هو حذر منكِ

8
00:00:39,400 --> 00:00:42,280
إنّه خائف... من ساميداري

9
00:00:43,250 --> 00:00:45,960
إنّه لا يركّز على المعركة هناك في الأسفل

10
00:00:46,590 --> 00:00:48,770
فقط اضربي الحاجز بين الحين والآخر

11
00:00:49,910 --> 00:00:50,730
هكذا؟

12
00:00:55,400 --> 00:00:57,570
سيمنحهم ذلك بعض الدّعم

13
00:01:02,110 --> 00:01:04,310
أتعتقدين نفسكِ قادرة على إصابتي؟

14
00:01:07,700 --> 00:01:08,810
أصبتُه؟

15
00:01:09,760 --> 00:01:12,110
الخوف يثبّط قوى الشّخص

16
00:01:14,030 --> 00:01:15,130
هذا هو مفتاحنا للفوز

17
00:02:51,650 --> 00:02:52,480
!حسناً

18
00:03:02,760 --> 00:03:03,950
!كان ذلك وشيكاً

19
00:03:06,870 --> 00:03:08,730
تبادُل أماكن؟

20
00:03:08,730 --> 00:03:10,070
هذا مُزعج

21
00:03:11,970 --> 00:03:14,420
اسمحوا لي بتوجيه بضع هجمات أيضاً

22
00:03:18,840 --> 00:03:20,400
،من مدى قريب

23
00:03:20,400 --> 00:03:22,050
!يمكننا الثّأر لسيّدنا

24
00:03:22,050 --> 00:03:24,870
!الرّمح الّذي لا يمكن إيقافه

25
00:03:24,870 --> 00:03:26,260
!تحطّم؟

26
00:03:29,700 --> 00:03:31,230
تجديد؟

27
00:03:31,230 --> 00:03:33,720
أنا غاضب الآن

28
00:03:33,720 --> 00:03:35,870
إليكما ردّ الاعتبار

29
00:03:40,600 --> 00:03:42,200
!شينونومي-سان

30
00:03:43,580 --> 00:03:45,660
لديّ المزيد والمزيد

31
00:03:45,980 --> 00:03:47,300
!اللّعنة

32
00:03:47,620 --> 00:03:49,580
أنت صامد حقّاً

33
00:04:07,220 --> 00:04:08,950
مهلكما

34
00:04:08,950 --> 00:04:09,760
!خذا

35
00:04:27,890 --> 00:04:28,890
هل نلنا منه؟

36
00:04:34,990 --> 00:04:37,000
!بئساً

37
00:04:54,130 --> 00:04:56,510
،حتّى لو كانت هذه الأجرام غير قاتلة

38
00:04:56,940 --> 00:04:59,320
تبقى قويّة بما يكفي لزعزعتنا

39
00:05:00,060 --> 00:05:01,530
!هذا سيّئ

40
00:05:01,530 --> 00:05:04,140
!ميكازوكي يتحمّل الكثير

41
00:05:12,890 --> 00:05:14,080
...شينونومي-سان

42
00:05:16,410 --> 00:05:18,690
أنت مذهل

43
00:05:18,690 --> 00:05:21,000
لكن إلى متى يمكنك الصّمود؟

44
00:05:26,500 --> 00:05:28,470
!التّرس الّذي لا ينكسر

45
00:05:37,260 --> 00:05:38,520
!هيو-تشان؟

46
00:05:39,980 --> 00:05:42,990
!هاجما

47
00:05:42,990 --> 00:05:46,010
!اضرباه بأقصى ما يمكنكما

48
00:05:46,010 --> 00:05:47,360
!هذا صحيح

49
00:05:47,360 --> 00:05:50,100
!سنحميكما قدر المستطاع

50
00:05:50,490 --> 00:05:51,950
!هيّا

51
00:05:51,950 --> 00:05:53,230
!حسناً

52
00:05:55,870 --> 00:05:58,660
!الرّمح الّذي لا ينكسر

53
00:05:58,660 --> 00:06:00,150
مهلاً

54
00:06:01,480 --> 00:06:02,390
!شيماكي-سان

55
00:06:02,390 --> 00:06:03,750
!شينونومي-سان

56
00:06:09,720 --> 00:06:12,970
الحِفاظ على حاجز أمر صعب

57
00:06:15,550 --> 00:06:17,420
،فوقه لدينا الأميرة الوحش

58
00:06:17,420 --> 00:06:20,670
وأسفله لدينا هذه الفرقة الجريئة تصعّب الأمر

59
00:06:20,670 --> 00:06:22,900
،قد يكون هذا غيضاً من فيض

60
00:06:24,170 --> 00:06:29,360
لكن سأسترجع قوّة الزمكان الّتي أعرتك إيّاها

61
00:06:30,540 --> 00:06:33,080
أعاره قوّة؟

62
00:06:34,880 --> 00:06:36,160
أكاني-كن؟

63
00:06:37,510 --> 00:06:39,050
!لـ-لوكي

64
00:06:39,050 --> 00:06:40,540
ما الأمر؟

65
00:06:40,840 --> 00:06:43,270
!أ-أمنيتي

66
00:06:43,730 --> 00:06:45,880
!امنع عودة قوّتي

67
00:06:49,670 --> 00:06:51,080
!هريسفيلغر

68
00:06:54,050 --> 00:06:56,230
،إذا كنت تتوق لمُستقبل

69
00:06:56,230 --> 00:06:58,520
،فسأمنحك أمنيتك إذاً كائناً من يكون عدوّك

70
00:06:59,300 --> 00:07:01,040
!يا صديقي الصّغير

71
00:07:05,260 --> 00:07:06,980
!تقلّبات الزمكان

72
00:07:11,540 --> 00:07:12,650
...تاكّون

73
00:07:12,650 --> 00:07:13,740
أكاني-كن؟

74
00:07:16,750 --> 00:07:18,200
...ألمي

75
00:07:18,900 --> 00:07:20,030
...أكاني

76
00:07:23,370 --> 00:07:24,680
هكذا إذاً

77
00:07:25,160 --> 00:07:27,890
،هذا هو الجواب على وظيفتك إذاً

78
00:07:27,890 --> 00:07:29,050
يا أكاني-كن

79
00:07:31,360 --> 00:07:36,760
،أنت فتى، لذا ظاننتُك ستخاف وتصطفّ معي في النّهاية

80
00:07:37,450 --> 00:07:40,850
لكن أعتقد كنتُ ودوداً جدّاً معك

81
00:07:40,850 --> 00:07:43,350
ألست خائفاً منّي؟

82
00:07:44,360 --> 00:07:45,730
أنا خائف

83
00:07:46,220 --> 00:07:50,690
لكن أعتقد هناك شيء أريده الآن

84
00:07:51,060 --> 00:07:53,030
ما هو؟

85
00:07:53,390 --> 00:07:54,940
لا أعلم

86
00:07:54,940 --> 00:07:55,980
...لكن

87
00:07:56,530 --> 00:07:57,910
!لكنّه هناك

88
00:08:06,590 --> 00:08:10,830
حسناً، أعتقد انتهى الأمر في هذه الجولة أيضاً

89
00:08:10,830 --> 00:08:14,550
سئمتُ من اللّعب واللّهو، لذا حان وقت إنهاء هذا

90
00:08:20,960 --> 00:08:22,060
...حسناً

91
00:08:29,130 --> 00:08:33,890
!حان وقت المذبحة

92
00:08:44,260 --> 00:08:46,380
!ما تلك الهالة؟

93
00:08:46,810 --> 00:08:48,270
إنّه أنيموس

94
00:08:48,270 --> 00:08:50,100
أصبح جادّاً

95
00:08:51,450 --> 00:08:52,340
ساميداري

96
00:08:53,530 --> 00:08:54,930
أعلم

97
00:08:56,220 --> 00:08:59,140
!لكن هذا الحاجز صلب جدّاً

98
00:09:01,100 --> 00:09:03,870
!على أيّ حال، سأستمرّ حتّى أنشئ حفرة فيه

99
00:09:36,310 --> 00:09:38,530
!من الواضح أنّه مختلف عن السّابق

100
00:09:38,990 --> 00:09:42,500
!إنّه طاغٍ، وكأنّنا مُحاطون بضغينة مُركَّزة

101
00:10:09,590 --> 00:10:11,480
هجوم منطقة؟

102
00:10:11,480 --> 00:10:13,300
أين الجميع؟

103
00:10:23,060 --> 00:10:25,310
!لو راوغتُ للخلف لكنتُ في عداد الموتى

104
00:10:28,650 --> 00:10:29,720
!توخّوا الحذر

105
00:10:29,720 --> 00:10:31,520
!أنيموس يختبئ وسط الدّخان

106
00:10:49,330 --> 00:10:50,650
!الدّخان

107
00:10:50,650 --> 00:10:51,670
!أجل

108
00:10:52,810 --> 00:10:54,130
...جـ-جروحهم

109
00:10:54,130 --> 00:10:55,340
!حسناً

110
00:10:55,340 --> 00:10:56,580
...تقلُّبات

111
00:11:04,530 --> 00:11:05,930
!تقلُّبات الزّمكان

112
00:11:08,120 --> 00:11:09,210
حتّى ملابسي؟

113
00:11:09,210 --> 00:11:10,430
!مذهل

114
00:11:11,080 --> 00:11:15,570
...لكن بالتحكّم بالزمكان فوق مساحة واسعة كهذه

115
00:11:15,570 --> 00:11:19,550
،حتّى لو استطاع استعادة لياقته
أشكّ في أنّه يستطيع الحفاظ عليها للأبد

116
00:11:23,120 --> 00:11:24,570
!سورانو! أكاني

117
00:11:29,150 --> 00:11:31,510
!كرة الطاقة تلك؟ إنّها ضخمة

118
00:11:41,220 --> 00:11:44,060
!تـ-تقلُّبات الزمكان

119
00:11:45,290 --> 00:11:46,300
!أكاني

120
00:11:58,270 --> 00:12:01,160
!تقلُّبات الزّمكان

121
00:12:09,130 --> 00:12:13,630
...تمّت استعادة لياقتي، لكن عقلي

122
00:12:13,630 --> 00:12:14,510
أكاني-كن؟

123
00:12:14,510 --> 00:12:15,630
هل أنت بخير؟

124
00:12:18,800 --> 00:12:22,630
لا يرجع الوقت بالنسبة لعقلكم

125
00:12:24,830 --> 00:12:29,750
الإرهاق من التحكّم بالزمكان محفور في وعيكم

126
00:12:35,810 --> 00:12:37,300
!شيماكي-سان

127
00:12:40,050 --> 00:12:41,230
!هيو-تشان

128
00:13:00,170 --> 00:13:04,460
تجاوزَ شيماكي-كن الحدَّ لصنع ثالث عشر

129
00:13:04,460 --> 00:13:09,560
أكاني-كن مجرّد طفل، لكن ظلّ يستخدم
قوّته حتّى غاب عن الوعي

130
00:13:09,560 --> 00:13:12,290
،ومع ذلك، رغم فقدانكم وسائل التّعافي

131
00:13:12,290 --> 00:13:17,670
ما زلتُم تنظرون إليّ أنا، الإله، بنار في عيونكم

132
00:13:18,430 --> 00:13:21,230
!أثني عليكم

133
00:13:22,040 --> 00:13:23,720
أكاني طفل؟

134
00:13:24,410 --> 00:13:27,130
لا علاقة لحجم الجسد بالنّضج

135
00:13:28,110 --> 00:13:30,080
لا يوجد بيننا إلّا محاربين

136
00:13:33,160 --> 00:13:36,090
أنت الطفل الوحيد هنا يا أنيموس

137
00:13:40,520 --> 00:13:42,550
!واحد، اثنان

138
00:13:49,350 --> 00:13:50,430
...هي

139
00:13:50,430 --> 00:13:51,930
!اخترقت الحاجز؟

140
00:13:51,930 --> 00:13:54,520
!جعلتموه يستهلك مقداراً هائلاً من الطاقة

141
00:13:54,520 --> 00:13:57,140
!لم يبقَ لدى أنيموس إلّا القليل من القوّة النفسيّة

142
00:13:58,190 --> 00:13:59,900
!هيّا، ها نحن ذا

143
00:14:00,920 --> 00:14:02,040
إنّها قادمة

144
00:14:02,040 --> 00:14:03,900
!عليّ إيقافها

145
00:14:04,410 --> 00:14:07,400
عليّ سحقهم أجمعين

146
00:14:09,660 --> 00:14:11,770
!بضربة واحدة

147
00:14:16,350 --> 00:14:18,030
!كوساكابي

148
00:14:18,030 --> 00:14:20,080
!التّرس الّذي لا يمكن إيقافه

149
00:14:20,080 --> 00:14:21,330
!زوكونفت

150
00:14:32,090 --> 00:14:33,680
شيماكي-سان عملاق؟

151
00:14:38,260 --> 00:14:39,650
،أنيموس

152
00:14:39,650 --> 00:14:41,270
ما هذا الجرح؟

153
00:14:43,720 --> 00:14:47,240
هجماتنا ستنجح الآن، أليس كذلك؟

154
00:14:49,200 --> 00:14:51,660
—مُحال أن يصيب هذا

155
00:14:56,950 --> 00:14:59,620
هذه المرّة الأولى والأخيرة يا ناغومو

156
00:15:00,120 --> 00:15:01,460
هذا يكفي

157
00:15:01,460 --> 00:15:03,180
شكراً لك يا دانس

158
00:15:09,380 --> 00:15:13,180
أنيموس، لا يمكنك تدمير الكوكب أبداً

159
00:15:13,180 --> 00:15:15,910
يمكنني، وقد فعلت

160
00:15:15,910 --> 00:15:19,060
مرّات كثيرة من قبل، ومرّات كثيرة مُقبلة

161
00:15:19,540 --> 00:15:20,640
كنتَ تحلم

162
00:15:22,190 --> 00:15:23,720
حلم سيّئ

163
00:15:23,720 --> 00:15:26,120
عودي إلى النّوم أيّتها الرّوح الطفوليّة

164
00:15:28,980 --> 00:15:30,620
مستحيل

165
00:15:30,620 --> 00:15:34,230
أنا مُحاصَر؟

166
00:15:34,230 --> 00:15:35,290
لماذا؟

167
00:15:35,850 --> 00:15:38,100
لطالما كنتُ أربح من قبل

168
00:15:38,100 --> 00:15:39,930
ما الّذي تغيّر؟

169
00:15:39,930 --> 00:15:42,110
ما المختلف هذه المرّة؟

170
00:15:43,750 --> 00:15:45,560
!أساهينا ساميداري

171
00:15:46,120 --> 00:15:49,050
!ليتني كنتُ أملك مِطرقتي! حاجزي

172
00:15:56,890 --> 00:15:58,050
أنيما

173
00:16:00,540 --> 00:16:01,670
أنيموس

174
00:16:23,610 --> 00:16:26,510
أنيما

175
00:16:26,510 --> 00:16:27,520
نعم؟

176
00:16:28,490 --> 00:16:31,340
ما هذا؟

177
00:16:31,340 --> 00:16:32,750
رمح؟

178
00:16:32,750 --> 00:16:33,800
أجل

179
00:16:36,870 --> 00:16:41,440
لماذا أنزف؟

180
00:16:42,910 --> 00:16:44,880
...غالباً لأنّك تذكّرت

181
00:16:45,690 --> 00:16:47,860
شعور امتلاك جسد

182
00:16:48,510 --> 00:16:50,050
لا أريد الموت

183
00:16:52,110 --> 00:16:53,240
سوف تموت

184
00:16:54,510 --> 00:16:57,800
ما زالت هناك أمور كثيرة أريد معرفتها

185
00:16:58,240 --> 00:16:59,950
ابحث عنها في دورة الحياة والموت

186
00:17:00,570 --> 00:17:02,220
قد تتجسّد روحك من جديد يوماً ما

187
00:17:03,670 --> 00:17:06,620
...تعتقدين أنّ شيئاً كهذا

188
00:17:06,620 --> 00:17:07,720
لا أحد يعلم

189
00:17:08,420 --> 00:17:10,350
لكن رأيتُ دلالات

190
00:17:12,920 --> 00:17:16,120
رائحة لم أشتمّها من قبل ملأتني بالحنين

191
00:17:16,120 --> 00:17:18,500
مشهد لم أره من قبل ملأني بالحنين

192
00:17:19,260 --> 00:17:22,850
أشياء لا أعرف شيئاً عنها أحبّها أو أكرهها

193
00:17:24,140 --> 00:17:27,630
،بينما أعيش حياتي الطويلة

194
00:17:27,630 --> 00:17:31,320
لطالما شعرتُ أنّ المكان الّذي أنتميتُ
إليه كان بجانبي تماماً

195
00:17:32,570 --> 00:17:36,840
وأشعر كأنّ لديه شكل عجلة

196
00:17:38,830 --> 00:17:41,670
هذا صحيح

197
00:17:42,520 --> 00:17:48,010
لطالما شعرتُ بالحنين أثناء الفترة
التي تتخلّل التنقّل عبر الزمكان

198
00:17:48,010 --> 00:17:51,860
والتجلّي في الأرض

199
00:17:52,900 --> 00:17:54,130
سأذهب إلى الدّيار

200
00:17:56,760 --> 00:18:01,590
في المرّة المقبلة، أريد أن أولَد ككائن قدير

201
00:18:02,520 --> 00:18:06,270
أتساءل ما إن كان موجوداً في مكان ما، في زمن ما

202
00:18:06,900 --> 00:18:07,830
إنّه موجود

203
00:18:08,390 --> 00:18:10,740
أجل. موجود

204
00:18:11,790 --> 00:18:12,930
يمكنني رؤيته

205
00:18:13,820 --> 00:18:16,410
في مكاني التّالي

206
00:18:17,070 --> 00:18:19,900
هذه مدّة طويلة جدّاً

207
00:18:19,900 --> 00:18:22,410
هل شيء كهذا مُمكن؟

208
00:18:22,910 --> 00:18:26,870
هل يمكنك التّكفير عن خطايا حياتك الماضية هناك؟

209
00:18:27,210 --> 00:18:29,910
ستكون صعبة

210
00:18:29,910 --> 00:18:33,920
سأحتاج غالباً لـ 500 عام

211
00:18:43,890 --> 00:18:45,630
سأذهب الآن

212
00:18:46,770 --> 00:18:51,270
...أنيما، تلك الحلقة

213
00:18:56,450 --> 00:19:02,330
إلى متى ستظلّين مُتمسّكة بذكرى طفولـ...؟

214
00:19:13,140 --> 00:19:14,420
...أخي

215
00:19:27,570 --> 00:19:33,100
آسفة لأنّني لم أستطع إيقافك قبلاً

216
00:19:38,220 --> 00:19:39,230
أنيما

217
00:19:40,820 --> 00:19:41,860
...أنا آسفة

218
00:19:42,850 --> 00:19:47,120
لعدم قدرتي على البُكاء عندما مات زملاؤكم

219
00:19:47,740 --> 00:19:48,660
لا مشكلة

220
00:19:57,740 --> 00:20:01,160
أنيما، ماذا سيحدث لهذه الجزيرة؟

221
00:20:01,160 --> 00:20:04,140
هل ستنهار الآن بعد أن رحلَ أنيموس؟

222
00:20:04,980 --> 00:20:06,830
لن تنهار هذه الجزيرة

223
00:20:07,490 --> 00:20:09,800
ساميداري يصونها الآن

224
00:20:10,800 --> 00:20:11,670
ماذا؟

225
00:20:12,820 --> 00:20:15,850
هذه هي نهاية حكاية أنيموس وحكايتي

226
00:20:16,550 --> 00:20:19,940
من الآن فصاعداً، هذه حكايتها

227
00:20:20,260 --> 00:20:21,780
ماذا؟

228
00:20:25,150 --> 00:20:26,950
ماذا تقصدين بذلك؟

229
00:20:27,950 --> 00:20:28,970
!أنتم

230
00:20:28,970 --> 00:20:31,410
!يا فُرسان الوحوش

231
00:20:31,410 --> 00:20:33,310
!انتباها

232
00:20:37,830 --> 00:20:41,630
!سوف نسحق الأرضَ الآن

233
00:20:43,260 --> 00:20:44,190
ماذا؟

234
00:20:46,050 --> 00:20:47,330
أعني ما أقوله

235
00:20:47,940 --> 00:20:49,390
نعني ما نقوله

236
00:20:52,980 --> 00:20:53,940
إنّهم جادّون

237
00:21:01,710 --> 00:21:02,810
أساهينا؟

238
00:21:02,810 --> 00:21:04,380
ما معنى هذا؟

239
00:21:04,980 --> 00:21:05,700
أماميا؟

240
00:21:12,200 --> 00:21:14,330
كلاهما جادّان بشأن هذا

241
00:21:15,880 --> 00:21:17,040
!منذ متى؟

242
00:21:17,040 --> 00:21:18,830
من البداية

243
00:21:18,830 --> 00:21:20,740
لطالما أردتُ أن تكون هذه الأرض لي

244
00:21:21,500 --> 00:21:26,510
والطريقة الوحيدة للحصول على هذه
المجوهرة الضخمة هي الموت معها

245
00:21:27,510 --> 00:21:32,470
لطالما كنتُ فارسها، منذ البداية

246
00:21:36,890 --> 00:21:38,380
ها أنا ذي

247
00:21:38,380 --> 00:21:40,480
لكمة ساميداري الهائلة

248
00:21:42,900 --> 00:21:44,990
!أساهينا

249
00:21:46,290 --> 00:21:47,320
!أماميا

250
00:21:59,530 --> 00:22:01,790
أماميا-كن، ما الّذي...؟

251
00:22:01,790 --> 00:22:02,800
المعذرة

252
00:22:05,420 --> 00:22:06,550
!هيو-تشان

253
00:22:11,640 --> 00:22:12,870
اخلد إلى النّوم من فضلك

254
00:22:13,470 --> 00:22:15,110
أنت أكثر من يخيفني

255
00:22:15,670 --> 00:22:20,150
إذا استطعت إنشاء غوليم آخر، فقد ينافس الأميرة

256
00:22:22,070 --> 00:22:23,520
...والآن

257
00:22:25,050 --> 00:22:27,660
من يريد إيقاف الأميرة، فليأتي إليّ

258
00:22:29,970 --> 00:22:31,460
سأواجهكم