1
00:00:05,850 --> 00:00:09,030
آلهة الفوز إبتسمت لي

2
00:00:10,430 --> 00:00:13,200
! آخر من سيضحك هو أنا

3
00:00:14,850 --> 00:00:15,520
-ما

4
00:00:17,970 --> 00:00:21,580
! سوف أكون في نفس المجموعة مع إيتشيكا, لذا لا يُمكنني الخسارة

5
00:00:28,040 --> 00:00:29,340
! إلهي, ساعدني

6
00:00:36,810 --> 00:00:38,800
هل هذه كاميرتكَ يا إيتشيكا ؟

7
00:00:39,170 --> 00:00:40,160
أجل

8
00:00:40,160 --> 00:00:44,020
أحضرتُها معي كي أستطيع أخذ صورٍ تذكاريَّة خلال الرِّحلة

9
00:00:44,590 --> 00:00:45,890
صور تذكاريَّة ؟

10
00:00:46,240 --> 00:00:46,990
أجل

11
00:00:46,990 --> 00:00:49,680
.. لِـ أنَّني مُمثِّل الفصل, سأكون في مجموعة مُختلفة عنكم

12
00:00:49,680 --> 00:00:52,440
ألتقط الصُّور لِـ المناظر و غيرها

13
00:00:52,440 --> 00:00:54,200
في مجموعة مُختلفة !؟

14
00:00:54,480 --> 00:00:56,820
أتعني أنَّك لن تكون في مجموعتنا ؟

15
00:00:56,820 --> 00:01:00,780
لماذا لم تُخبرنا بِـ هذا الشَّيء المُهم من قبل ؟

16
00:01:00,780 --> 00:01:03,600
ماذا ؟ لماذا أنتنَّ غاضبات ؟

17
00:01:02,130 --> 00:01:04,520
! يا إلهي, إيتشيكا-سان

18
00:01:05,450 --> 00:01:07,460
سوف تكون هذه رحلةً جيِّدة, أليس كذلك ؟

19
00:01:09,410 --> 00:01:10,700
هذا صحيح

20
00:02:52,170 --> 00:02:54,940
! وااه ! إنَّه مكانٌ جميل

21
00:02:54,940 --> 00:02:56,810
إنَّه فُندقٌ صغيرٌ خلَّاب

22
00:02:56,810 --> 00:03:00,350
! الجميع ! أسرعوا, أسرعوا ! إنَّه مُذهل

23
00:03:01,880 --> 00:03:02,910
! جميل

24
00:03:02,910 --> 00:03:04,540
أتساءل كيف تبدو الغُرف

25
00:03:11,370 --> 00:03:17,660
الجميع, إسمعوا, مجموعاتُكم لديها وقتُ فراغ بعد هذا

26
00:03:18,090 --> 00:03:21,300
سنذهب جميعنا إلى معبد كيوميزو لاحقًا هذا المساء

27
00:03:21,700 --> 00:03:24,930
تأكَّدوا بِـ أن تكونوا هُناك في هذا الوقت

28
00:03:24,930 --> 00:03:26,420
مفهوم ؟

29
00:03:26,420 --> 00:03:27,450
! إذًا, إنصراف

30
00:03:27,450 --> 00:03:28,180
! حاضر

31
00:03:33,300 --> 00:03:34,360
.. آنو

32
00:03:34,360 --> 00:03:36,690
أوريمورا-كن, لقد وصلت إليك بعض الأمتعة

33
00:03:37,480 --> 00:03:38,190
إيه ؟

34
00:03:45,060 --> 00:03:46,280
ما الخطب ؟

35
00:03:47,150 --> 00:03:50,820
لقد وصلت إليَّ أمتعةٌ لا أملك عنها أيَّة فكرة

36
00:03:57,630 --> 00:04:01,420
! جاا - جاا ! إنَّها الأُخت تاتيناشي

37
00:04:01,420 --> 00:04:03,130
تـ- تاتيناشي-سان !؟

38
00:04:03,130 --> 00:04:04,320
أُختي !؟

39
00:04:05,520 --> 00:04:06,670
يا إلهي

40
00:04:06,670 --> 00:04:11,100
! كانزاشي-تشان, توقَّفي ! مـ- مهلًا

41
00:04:12,250 --> 00:04:13,890
! لم أفعل أيَّ شيءٍ بعد

42
00:04:15,170 --> 00:04:16,560
! ساعدني, إيتشيكا

43
00:04:17,010 --> 00:04:18,270
حـ- حسنًا

44
00:04:25,980 --> 00:04:27,610
عن ماذا كان ذلك ؟

45
00:04:34,000 --> 00:04:38,290
المشاعر العابرة .. تتراقص في رياح الخريف

46
00:04:42,840 --> 00:04:47,040
موسم الحُب أتى بِـ التَّأكيد

47
00:04:48,500 --> 00:04:50,290
! أوي, سيسيليا

48
00:04:52,480 --> 00:04:54,100
إنَّها جميلةٌ جدًّا

49
00:04:54,560 --> 00:04:55,390
هيه !؟

50
00:04:57,480 --> 00:04:59,500
يا إلهي, إنَّه غير صبور

51
00:04:59,500 --> 00:05:03,860
إذا كان يُريد تصويري, كل ما عليه فعله هو طلب ذلك مِنِّي

52
00:05:07,050 --> 00:05:09,300
هل الصُّورة جميلة ؟

53
00:05:09,540 --> 00:05:12,100
إذا لم تُمانع, أرني إيَّاها رجاءً

54
00:05:12,100 --> 00:05:13,040
أجل

55
00:05:15,040 --> 00:05:17,370
أليست جميلة ؟ أشجار القيقب هذه

56
00:05:18,630 --> 00:05:21,600
إيتشيكا-سان ! ما الذي يعنيه هذا !؟

57
00:05:21,600 --> 00:05:22,480
هيه ؟

58
00:05:22,820 --> 00:05:25,010
آره, هل أصبحت مُشوَّشة أو شيء كـ هذا ؟

59
00:05:25,310 --> 00:05:27,780
! هذه ليست المُشكلة

60
00:05:27,780 --> 00:05:29,860
.. أوَّلًا يا إيتشيكا-سان, أنتَ

61
00:05:28,790 --> 00:05:31,060
! أوريمو ! أوريمو -

62
00:05:31,620 --> 00:05:33,140
! إلتقط صورةً لنا

63
00:05:33,540 --> 00:05:34,440
! حسنًا

64
00:05:36,450 --> 00:05:38,220
! أوريمورا-كن, هُنا أيضًا

65
00:05:38,340 --> 00:05:39,560
! غير عادل ! غير عادل

66
00:05:39,560 --> 00:05:41,280
! هُنا أيضًا رجاءً

67
00:05:42,050 --> 00:05:43,600
حسنًا, فهمت

68
00:05:43,860 --> 00:05:45,590
إذًا, بِـ الدَّور, حسنًا ؟

69
00:05:48,980 --> 00:05:51,910
أوريمورا-كن, تأكَّد من تصوير القمَّة أيضًا

70
00:05:51,910 --> 00:05:54,120
إنتظر, إنتظر ! أنا سأدخل أيضًا

71
00:05:55,390 --> 00:05:56,850
! إنَّه مصنوعٌ من الذَّهب حقًّا

72
00:05:56,850 --> 00:05:58,540
! هُنالك الكثير من الكوي

73
00:05:59,780 --> 00:06:01,460
! أُنظرن ! أُنظرن ! إنَّها عروس

74
00:06:01,460 --> 00:06:03,420
! الكيمونو الأبيض جميلٌ جدًّا

75
00:06:25,670 --> 00:06:26,650
! إيتشيكا

76
00:06:29,430 --> 00:06:30,660
ما الذي تفعله ؟

77
00:06:31,190 --> 00:06:33,940
غطاء العدسة وقع أسفل هذه

78
00:06:36,940 --> 00:06:39,790
أعتقد أنَّ يدي تستطيع الدُّخول. هل تُريد مِنِّي المُحاولة ؟

79
00:06:39,790 --> 00:06:41,380
أوه, آسفٌ على ذلك

80
00:06:45,200 --> 00:06:47,580
إنَّه مُظلم, لا أستطيع الرُّؤية جيِّدًا

81
00:06:48,850 --> 00:06:50,650
كما توقَّعت, بِـ دون فائدة

82
00:06:51,840 --> 00:06:54,210
لا مُشكلة, إيتشيكا

83
00:06:58,040 --> 00:06:59,140
! شارو

84
00:06:59,280 --> 00:07:00,920
! أستطيعُ رؤيته

85
00:07:01,190 --> 00:07:04,600
هيه ؟ و لكنِّي ما زلت لا أستطيع رؤيته

86
00:07:05,190 --> 00:07:08,600
هـ- هـ- هـ- هذا ليس ما أعنيه

87
00:07:08,810 --> 00:07:10,200
! حصلتُ عليها

88
00:07:11,870 --> 00:07:13,110
خُذ, إيتشيكا

89
00:07:13,110 --> 00:07:14,760
شـ- شكرًا لكِ

90
00:07:14,900 --> 00:07:16,400
.. و لكن, حسنًا

91
00:07:16,400 --> 00:07:17,580
ما الخطب, إيتشيكا ؟

92
00:07:20,190 --> 00:07:21,580
لقد إرتفعت

93
00:07:25,630 --> 00:07:26,860
! آسف

94
00:07:27,580 --> 00:07:29,000
.. إذًا

95
00:07:29,160 --> 00:07:32,980
أُخرج معي قليلًا و بعدها سأُسامحك

96
00:07:33,490 --> 00:07:35,220
حـ- حسنًا

97
00:07:44,840 --> 00:07:47,790
.. لا يُناسبني تمنِّي أُمنية من الإله و لكن

98
00:07:47,790 --> 00:07:50,460
.. بما أنَّ هذا الضَّريح مشهورٌ في إنجاح العلاقات الرُّومانسيَّة

99
00:07:50,460 --> 00:07:52,530
سوف تُجاب صلواتي, أليس كذلك ؟

100
00:07:56,640 --> 00:08:01,250
أرجوك .. أتمنَّى أن تجعل ذلك الأحمق يُلاحظ مشاعري و لو قليلًا

101
00:08:02,090 --> 00:08:03,200
! حسنًا

102
00:08:08,740 --> 00:08:10,810
يـ- يا للمُصادفة ! ماذا ؟

103
00:08:10,810 --> 00:08:12,820
هل هذا الضَّريح مشهورٌ في شيءٍ ما ؟

104
00:08:12,820 --> 00:08:17,060
! أ- أنا كُنتُ بِـ القُرب من هُنا, لذا قرَّرتُ التَّوقُّف هُنا فحسب

105
00:08:17,600 --> 00:08:21,770
! أنا أيضًا, صادف وُجودي في هذا المكان

106
00:08:21,770 --> 00:08:25,650
و بما أنِّني هُنا, فكَّرتُ في زيارته

107
00:08:25,650 --> 00:08:27,150
آه, هكذا إذًا ؟

108
00:08:34,560 --> 00:08:36,660
أتمنَّى أن أملك الكثير من الأطفال

109
00:08:36,660 --> 00:08:38,720
لاورا ! منذ متى أنتِ هُنا ؟

110
00:08:38,720 --> 00:08:40,990
بِـ الأحرى, ما الذي قُلتيه لِـ توِّكِ ؟

111
00:08:42,440 --> 00:08:45,340
سمعتُ أنَّه إذا تمنَّيت أُمنية, فسوف تتحقَّق

112
00:08:46,970 --> 00:08:48,700
! الـ- الجميع

113
00:08:49,970 --> 00:08:50,630
! أهلًا

114
00:08:50,630 --> 00:08:52,070
إيتشيكا !؟

115
00:08:50,630 --> 00:08:52,070
إيتشيكا-سان !؟

116
00:08:54,510 --> 00:08:57,880
شارلوتّ-سان ! ما الذي يعنيه هذا !؟

117
00:08:57,880 --> 00:09:00,450
هل يُمكن أنَّكِ كُنتِ في موعدٍ من وراء ظُهورنا !؟

118
00:09:00,450 --> 00:09:02,680
كلَّا, هذا ليس ما في الأمر

119
00:09:03,050 --> 00:09:05,800
هذا صحيح, لا يُمكن أن يكون هذا صحيحًا

120
00:09:06,210 --> 00:09:10,380
إضافةً لِـ ذلك, سمعتُ بِـ أنَّه إذا غضبتن, ستُجمِّعن الغِربان من حولكن

121
00:09:10,760 --> 00:09:13,540
! بما أنَّنا أتينا في رحلة, دعونا نحظى بِـ بعض المرح

122
00:09:18,870 --> 00:09:22,080
ماذا !؟ ماذا !؟ ما الذي يجري بِـ الضَّبط !؟

123
00:09:22,480 --> 00:09:24,620
! إيتشيكـــــــــا

124
00:09:32,170 --> 00:09:33,810
أوريمورا-سينسيه

125
00:09:34,850 --> 00:09:37,130
هل هُنالك شيءٌ يُضايقكِ ؟

126
00:09:37,950 --> 00:09:38,780
أجل

127
00:09:39,260 --> 00:09:43,280
بما أنَّ الأكادميَّة و الطُّلاب هوجموا مرَّاتٍ عديدة مُؤخَّرًا

128
00:09:44,280 --> 00:09:46,590
.. كي يستمتع الطُّلاب بِـ الرِّحلة

129
00:09:46,590 --> 00:09:48,100
راقبي المُحيطين حولنا

130
00:09:49,810 --> 00:09:50,650
! حاضر

131
00:09:55,100 --> 00:09:57,370
لقد أضعتُهُم بِـ طريقةٍ ما

132
00:09:57,370 --> 00:09:59,780
! وااي, إنَّه أوريمو

133
00:10:02,500 --> 00:10:04,030
نوهوهون-سان ؟

134
00:10:04,030 --> 00:10:06,680
أنا مُطاردةٌ من قِبَل كان-تشان

135
00:10:06,680 --> 00:10:09,020
! هونّيه ! إنتظري

136
00:10:09,020 --> 00:10:11,230
يا إلهي, إلى متى سأطاردكِ !؟

137
00:10:12,030 --> 00:10:13,020
! كانزاشي

138
00:10:13,060 --> 00:10:14,880
ما خطب هذا الزِّي ؟

139
00:10:15,790 --> 00:10:16,870
! إيتشيكا

140
00:10:18,470 --> 00:10:20,880
هـ- هذا ليس كما تظنُّه يا إيتشيكا

141
00:10:20,880 --> 00:10:25,530
هذا .. لقد إستأجرته لِـ أنَّ الجميع قال لي ذلك

142
00:10:26,040 --> 00:10:30,260
.. أنا قُلت لهم بِـ أن يتوقَّفوا و لكن, آنو, حسنًا

143
00:10:31,140 --> 00:10:32,900
أعتقد بِـ أنَّه يُناسبكِ كثيرًا

144
00:10:33,430 --> 00:10:35,110
حـ .. حقًّا !؟

145
00:10:35,600 --> 00:10:36,170
أجل

146
00:10:39,830 --> 00:10:41,490
تمَّ تأكيد الهدف

147
00:10:41,830 --> 00:10:45,240
! ما الذي يُناسبها يا تُرى ؟ أوريمورا إيتشيكا-كن

148
00:10:45,260 --> 00:10:46,420
.. أنتَ

149
00:10:46,420 --> 00:10:47,800
! لن نُسامحك

150
00:10:48,260 --> 00:10:49,520
! اللعنة

151
00:10:50,400 --> 00:10:51,820
! لن ندعكَ تهرب

152
00:10:51,380 --> 00:10:52,900
! إيتشيكا

153
00:10:52,240 --> 00:10:53,090
! إنتظر

154
00:10:55,900 --> 00:10:57,460
! لِـ نهرب ! كانزاشي

155
00:11:00,760 --> 00:11:01,720
.. إيتشيكا

156
00:11:02,500 --> 00:11:03,500
! إنتبه

157
00:11:11,580 --> 00:11:12,700
! إيتشيكا

158
00:11:14,660 --> 00:11:19,280
أنت ما الذي تفعله بِـ الضَّبط !؟

159
00:11:19,720 --> 00:11:21,090
إييه !؟

160
00:11:42,910 --> 00:11:45,220
! إنَّه لذيذٌ جدًّا

161
00:11:45,260 --> 00:11:47,600
شكرًا لكَ على الوجبة, إيتشيكا-سان

162
00:11:47,600 --> 00:11:49,470
لماذا عليَّ فعل ذلك ؟

163
00:11:49,470 --> 00:11:50,620
ماذا !؟

164
00:11:50,860 --> 00:11:52,840
ألديكَ مُشكلة ؟

165
00:11:53,560 --> 00:11:56,780
سنُسامحكَ على هذا, أنتَ محظوظ

166
00:11:58,650 --> 00:12:01,830
الأكثر أهمِّية, هوكي, لقد وجدتِ مكانًا رائعًا

167
00:12:03,800 --> 00:12:05,600
أ- أظنُّ ذلك

168
00:12:08,800 --> 00:12:13,400
.. لقد وجدتُ هذا المكان كي أستطيع أنا و إيتشيكا زيارته سويَّة و لكن

169
00:12:17,940 --> 00:12:19,210
! إنَّه لذيذ

170
00:12:24,230 --> 00:12:25,560
ما الخطب ؟

171
00:12:26,860 --> 00:12:28,370
ما هذا ؟

172
00:12:29,380 --> 00:12:31,600
إنَّها حلوى يابانيَّة, لاورا

173
00:12:32,470 --> 00:12:34,140
إذا أردتِ, ما رأيكِ بِـ تجربة واحدة ؟

174
00:12:39,620 --> 00:12:42,230
! إرحموني

175
00:12:42,710 --> 00:12:45,480
نحنُ وُجدنا كي نُؤكل

176
00:12:45,660 --> 00:12:48,620
هُنالك فاصوليا حُلوة داخلنا

177
00:12:50,210 --> 00:12:52,220
.. و لكن, أنا

178
00:12:53,320 --> 00:12:57,760
.. إذًا, أنتِ

179
00:12:54,940 --> 00:12:57,760
يُمكنكِ أكلي أنا أوَّلًا

180
00:13:02,250 --> 00:13:04,130
إنَّها لذيذة, جرِّبي تناولها

181
00:13:17,730 --> 00:13:19,270
! لذيذة

182
00:13:19,810 --> 00:13:21,060
ألم أقُل لكِ ؟

183
00:13:43,180 --> 00:13:47,870
.. لقد أخبَرَتني .. بِـ ألَّا أنسى أحدًا من ماضيَّ أبدًا

184
00:13:59,680 --> 00:14:00,480
إيتشيكا

185
00:14:01,240 --> 00:14:02,160
هوكي

186
00:14:03,460 --> 00:14:05,270
ألستِ مع الجميع ؟

187
00:14:06,220 --> 00:14:09,770
آه .. لِـ بعض الأسباب, إنفصلتُ عنهم

188
00:14:10,910 --> 00:14:14,790
بِـ المُناسبة, سمعتُ بِـ أنَّه تُوجد غابة خيزران مُذهلة في الأمام

189
00:14:15,690 --> 00:14:16,810
هل ذهبت إلى هُناك مسبقًا ؟

190
00:14:17,290 --> 00:14:19,590
هييه .. لم أذهب إلى هُناك بعد

191
00:14:20,390 --> 00:14:21,800
أتُريدين الذَّهاب سويَّة ؟

192
00:14:23,570 --> 00:14:24,920
! هذا صحيح

193
00:14:43,100 --> 00:14:45,610
إنَّه مكانٌ يُشعركَ بِـ الرَّاحة

194
00:14:48,810 --> 00:14:50,120
هذا صحيح

195
00:14:53,700 --> 00:14:56,540
.. أردتُ المجيء إلى هُنا حقًّا

196
00:15:00,330 --> 00:15:02,120
معك سويَّة

197
00:15:03,960 --> 00:15:07,200
لقد إعتدتُ التَّنزُّه في الماضي معكِ يا هوكي بِـ هذه الطَّريقة, أليس كذلك ؟

198
00:15:09,000 --> 00:15:10,580
هذا صحيح

199
00:15:11,180 --> 00:15:14,350
لقد كُنت تدعوني كثيرًا بعد التَّدريب

200
00:15:15,880 --> 00:15:17,510
هذا يُشعرني بِـ الحنين

201
00:15:23,570 --> 00:15:25,500
هل حصل شيءٌ ما ؟

202
00:15:25,500 --> 00:15:27,390
نوعًا ما, لا تبدو على طبيعتك

203
00:15:27,970 --> 00:15:29,650
إيه ؟ حقًّا ؟

204
00:15:30,370 --> 00:15:32,670
صحيح, هوكي, دعيني ألتقط صورةً لكِ

205
00:15:33,100 --> 00:15:36,660
إذا أردت, هل تُريد مِنِّي تصويركما معًا ؟

206
00:15:37,170 --> 00:15:40,100
أنتُما تُفضِّلانِ أن تكونا في صورةٍ معًا, أليس كذلك ؟

207
00:15:41,710 --> 00:15:43,420
إذًا, أعتمد عليكِ

208
00:15:49,880 --> 00:15:51,540
! شكرًا جزيلًا لكِ

209
00:15:51,670 --> 00:15:54,660
أنتُما تبدوانِ رائعين

210
00:15:54,660 --> 00:15:56,090
آه, شكرًا

211
00:15:56,620 --> 00:16:02,160
.. أتمنَّى لكَ رحلةً مُوفَّقة

212
00:15:58,860 --> 00:16:02,160
أوريمورا إيتشيكا-كن

213
00:16:05,410 --> 00:16:08,130
آره ؟ هل قُلت لها إسمي ؟

214
00:16:09,130 --> 00:16:10,120
.. كلَّا

215
00:16:12,990 --> 00:16:19,740
.. شُرفة كيوميزو الرَّئيسيَّة تقع فوق ثلاثين متر من إرتفاع مُنحدر الجبل

216
00:16:19,740 --> 00:16:24,090
مدعومةٌ بِـ  139عمود يُدعون بِـ مناصب الجحيم

217
00:16:26,990 --> 00:16:28,360
! إنَّها جميلة

218
00:16:28,360 --> 00:16:30,250
! هذا رائع

219
00:16:31,130 --> 00:16:36,300
إذًا, الجميع, تأكَّدوا من التَّجمُّع عند محطَّة القطار في الوقت المُحدَّد, حسنًا ؟

220
00:16:36,300 --> 00:16:38,100
! حــــــاضر

221
00:16:38,720 --> 00:16:40,430
أنا سأذهب إلى محلِّ الهدايا

222
00:16:40,430 --> 00:16:42,270
نيه, نيه, أتُريدين تفقُّد ذلك المكان أيضًا ؟

223
00:16:52,880 --> 00:16:56,700
من الوقاحة إلتقاط الصُّور لِـ الفتيات من دون طلب إذنِهنَّ أوَّلًا

224
00:16:56,860 --> 00:16:58,340
.. آه, كلَّا

225
00:17:00,350 --> 00:17:04,220
.. حسنًا

226
00:17:01,300 --> 00:17:04,220
تأكَّد من إعطائي نُسخةً لاحقًا

227
00:17:07,840 --> 00:17:08,870
إيتشيكا

228
00:17:08,870 --> 00:17:09,880
أوه, ماذا هُناك ؟

229
00:17:10,290 --> 00:17:12,640
أُريد رؤية الصُّور التي إلتقطتها اليوم

230
00:17:12,780 --> 00:17:13,740
حسنًا

231
00:17:13,940 --> 00:17:14,880
إنظري

232
00:17:17,140 --> 00:17:19,300
لقد ذهبتَ إلى أماكن كثيرة

233
00:17:20,240 --> 00:17:21,600
أ- أجل

234
00:17:21,910 --> 00:17:24,220
أنا أيضًا, أرني إيَّاهم رجاءً

235
00:17:26,270 --> 00:17:28,040
! آه, هذه ! هذه

236
00:17:28,040 --> 00:17:30,760
! هذه رائعةٌ جدًّا

237
00:17:30,760 --> 00:17:33,190
أنا ما زلتُ أنظر إليهم كما تعلمين

238
00:17:33,190 --> 00:17:35,070
أنا أيضًا كذلك

239
00:17:35,560 --> 00:17:37,030
! بِـ الدَّور

240
00:17:37,480 --> 00:17:39,890
! أوريمورا-كن, أنا أُريد رؤيتهم أيضًا

241
00:17:39,890 --> 00:17:41,120
! هذا غير عادل

242
00:17:41,120 --> 00:17:43,640
! أنا أيضًا ! أنا أيضًا

243
00:17:44,000 --> 00:17:47,060
! قُلت لكنّ, من المُستحيل أن ترَوهم جميعكنَّ في وقتٍ واحد

244
00:17:59,640 --> 00:18:02,010
آسف .. سأذهب لِـ إحضارها

245
00:18:04,510 --> 00:18:06,340
.. إيتّو

246
00:18:07,260 --> 00:18:09,520
إنَّها هُنا كما أذكر

247
00:18:18,890 --> 00:18:20,070
.. أنتِ

248
00:18:22,430 --> 00:18:24,220
أوريمورا إيتشيكا

249
00:18:24,560 --> 00:18:27,090
سوف أسلبكَ حياتك

250
00:18:31,500 --> 00:18:33,160
! تعال, أيُّها الفارسُ الأسود

251
00:18:40,060 --> 00:18:41,460
أوه, سيسيليا

252
00:18:42,320 --> 00:18:45,930
لقد حان تقريبًا وقتُ التَّجمُّع, إلى أين أنتِ ذاهبة ؟

253
00:18:46,180 --> 00:18:51,000
إيتشيكا-سان تأخَّر في العودة, لذا أردتُ الذَّهاب و تفحُّص الأمر

254
00:18:51,840 --> 00:18:52,850
.. إيتشيكا قد

255
00:18:55,130 --> 00:18:58,660
الجميع, هل جميع من يجلسون بِـ جانبكنَّ موجود ؟

256
00:18:59,570 --> 00:19:02,360
سينسيه, أوريمورا-كن غير موجود

257
00:19:02,360 --> 00:19:05,370
و أيضًا شينونونو-سان و آلكوتّ-سان

258
00:19:06,530 --> 00:19:07,520
.. نيه, إنظرن

259
00:19:12,170 --> 00:19:17,080
يامادا-سينسيه, إرجعي إلى الفُندق قبلي, حالَما أجدهم سأعود فورًا

260
00:19:17,080 --> 00:19:18,210
! حـ- حاضر

261
00:19:22,700 --> 00:19:23,720
ماذا !؟

262
00:19:41,980 --> 00:19:45,430
.. النَّظر إلى المدينة بِـ رشاقةٍ من مكانٍ كـ هذا

263
00:19:46,150 --> 00:19:49,000
يبدو أنَّ طريقة تفكير المشاهير تختلف عنَّا

264
00:19:51,760 --> 00:19:57,000
ضباب موسكو السَّميك هو الـ آي إس خاصَّتكِ .. أليس كذلك ؟

265
00:19:57,500 --> 00:19:59,760
هذا هو الإسم السَّابق

266
00:19:59,820 --> 00:20:02,560
الآن إسمه السَّيدة الغامضة

267
00:20:03,260 --> 00:20:04,960
هكذا إذًا

268
00:20:07,610 --> 00:20:10,770
ما الذي تُخطِّطون له, يا مُهمَّة الشَّبح ؟

269
00:20:11,960 --> 00:20:17,980
آرا .. ما هو مقدار ما تعرفينه .. ساراشكي تاتيناشي-سان ؟

270
00:20:19,400 --> 00:20:21,740
لن أدعكم تفعلون ما تشاؤون

271
00:20:23,830 --> 00:20:26,940
.. لقد كان الوضع جيِّدًا و لكن

272
00:20:26,940 --> 00:20:29,330
يبدو أنَّكِ تأخَّرتِ قليلًا

273
00:20:34,780 --> 00:20:36,830
! لقد بدأنا بالفعل

274
00:20:45,970 --> 00:20:47,210
ما الذي يحدث ؟

275
00:20:47,210 --> 00:20:48,320
لا أعلم

276
00:20:48,320 --> 00:20:51,240
سأحاول الدُّخول إلى نظام التَّحكُّم

277
00:20:51,840 --> 00:20:53,560
أوريمورا-سينسيه, ما هذا !؟

278
00:20:53,900 --> 00:20:58,290
إتَّصلي بِـ الأكادميَّة حالًا و إطلبي دعمًا عسكريًّا

279
00:20:58,290 --> 00:20:59,490
! عُلم

280
00:21:01,430 --> 00:21:03,690
إذًا فهم ينوُون إستخدام أيَّة وسيلة, هاه !؟

281
00:21:06,640 --> 00:21:08,030
! إيتشيكا

282
00:21:08,030 --> 00:21:09,580
! إيتشيكا-سان

283
00:21:25,950 --> 00:21:29,000
! لن أسمح لكما, أيَّتها الطِّفلتين اللعينتين

284
00:21:29,130 --> 00:21:30,350
.. أنتِ

285
00:21:30,780 --> 00:21:33,910
إنَّه أوتامُ-ساما .. هل نسيتِ !؟

286
00:21:41,600 --> 00:21:43,600
قُلتِ بِـ أنَّكِ مادوكا, صحيح ؟

287
00:21:43,600 --> 00:21:45,760
لماذا تسعين خلفي ؟

288
00:21:46,940 --> 00:21:48,740
أنتَ لستَ بِـ عدوِّي

289
00:21:49,050 --> 00:21:50,120
ماذا !؟

290
00:21:51,160 --> 00:21:53,700
.. هدفي الحقيقيُّ هو

291
00:21:54,000 --> 00:21:56,880
قتلُ أوريمورا تشيفويو

292
00:21:58,180 --> 00:21:59,500
تشيفويو-نيه !؟

293
00:23:42,970 --> 00:23:45,440
إذًا فـ هذه هي الموضة المشهورة حاليًّا, هاه ؟

294
00:23:45,440 --> 00:23:47,840
حسنًا, لِـ نُحاول صُنعها

295
00:23:48,250 --> 00:23:52,320
إيتّو .. هذه هي .. الذِّراع, صحيح ؟

296
00:23:54,440 --> 00:23:55,910
! إنَّها تتحرَّك

297
00:23:56,330 --> 00:23:59,910
مُذهل ! لا عجب أنَّ تشيفويو-نيه مجنونةٌ عليها

298
00:24:00,340 --> 00:24:01,830
مهلًا, تشيفويو-نيه !؟

299
00:24:02,290 --> 00:24:07,380
: 2 الحلقة القادمة من الـ ستراتوس الانهائي
" إنـــــــتــــــهــــــــــت الـــــــــفـــــــتـــــــــيـــــــات "