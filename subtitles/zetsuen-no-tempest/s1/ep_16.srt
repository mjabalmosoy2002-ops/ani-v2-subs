1
00:01:35,540 --> 00:01:38,540
يبدو أنَّنا سنحظى بمنظرٍ رائع للألعاب النارية هذه الليلة

2
00:01:38,540 --> 00:01:39,960
...هذا صحيح

3
00:01:45,950 --> 00:01:47,090
...أخبريني

4
00:01:47,090 --> 00:01:50,090
،سمعتُ أنَّكِ حينما ترتدين اليوكاتا

5
00:01:50,090 --> 00:01:52,920
...لا ترتدين معه ملابس داخلية لتجنُّب خطوط اللباس الداخلي

6
00:01:52,920 --> 00:01:53,770
أهذا صحيح؟

7
00:01:53,770 --> 00:01:55,610
أنا لا أرتدي للنصف العلوي

8
00:01:55,610 --> 00:01:56,980
النصف السفلي سرّي

9
00:01:58,990 --> 00:01:59,900
،مع ذلك

10
00:02:00,470 --> 00:02:03,940
،إن كانت لديك رغبة مُلحّة لمعرفة ذلك

11
00:02:04,580 --> 00:02:08,570
سأسمح لك بالوصول إليه ورؤية ذلك بنفسك يا يوشينو-سان

12
00:02:10,240 --> 00:02:11,610
!أنا آسف

13
00:02:11,610 --> 00:02:13,460
!لقد سألتُ عن أمرٍ سخيفٍ للغاية

14
00:02:14,220 --> 00:02:16,280
لا جرأة لديك إطلاقًا

15
00:02:18,590 --> 00:02:21,700
لديكِ حقًا شخصية فظيعة يا آيكا-تشان

16
00:02:21,700 --> 00:02:26,630
وهل تدعي أنَّك شخصٌ خلوق يا يوشينو-سان؟

17
00:02:27,080 --> 00:02:30,710
لا أظُنُّ أنَّ بإمكاني إنكار ذلك، كوني أُواعد آيكا-تشان

18
00:02:30,710 --> 00:02:32,990
من دون علم ماهيرو

19
00:02:38,310 --> 00:02:40,150
،من بين جميع الأشخاص الذين أعرفهم

20
00:02:40,150 --> 00:02:43,270
أظُنُّ أنَّكَ الأكثر إخافةً يا يوشينو-سان

21
00:02:51,030 --> 00:02:54,700
،إن كنتِ ترغبين بعلاقةٍ مع يوشينو-كن بشدّة

22
00:02:55,720 --> 00:02:59,500
فأنَّ شجرة سفر التكوين قد تقتُل صديقته

23
00:03:00,200 --> 00:03:02,740
إن رغبتُ بالأمر بشدّة؟

24
00:03:02,740 --> 00:03:04,060
غير مُمكِن

25
00:03:04,060 --> 00:03:06,460
كما أنَّني مقتنعةٌ تمامًا بقضاء الوقت مع يوشينو هكذا

26
00:03:07,500 --> 00:03:09,980
!لابُدَّ أنَّ هذا ما أخطأتُ به

27
00:03:09,980 --> 00:03:11,720
هل تُنصتين يا هاكازي-سان؟

28
00:03:11,720 --> 00:03:14,180
أقُلتَ شيئًا ما؟

29
00:03:14,180 --> 00:03:18,770
كنتُ أقول أنَّ جاسوسًا على ما يبدو قد تسلّل إلى قرية كوساريبي

30
00:03:18,770 --> 00:03:20,850
...أجل، هذا صحيح

31
00:03:21,330 --> 00:03:24,900
لكن أنّى لـياماموتو معرفة معلومة كهذه؟

32
00:03:24,900 --> 00:03:27,340
لابُدَّ أنَّها تُدبِّر لأمرٍ ما

33
00:03:27,340 --> 00:03:28,480
،لقد بدأ

34
00:03:28,480 --> 00:03:29,700
،أيُّها الحضور

35
00:03:28,480 --> 00:03:38,410
لحظاتٌ حتّى الحدث!؟

36
00:03:29,700 --> 00:03:34,030
هذه هي الشجرة التي تمَّ تأشيرها لتُدمَّر من قبل من يُسمّي نفسه ساحر سفر الخروج

37
00:03:34,030 --> 00:03:36,030
،يكادُ أن يحين الموعد

38
00:03:36,030 --> 00:03:38,410
لكن لم تحدُث أيُّ تغيُّرات مرئيّة حتّى الآن

39
00:03:43,650 --> 00:03:46,900
سيكون الأمر ممل إن كان مقلب

40
00:03:46,900 --> 00:03:48,710
لكن يبدو أنَّهُ حقيقي

41
00:03:49,560 --> 00:03:53,310
في ذلك التصريح، ألم يدّعي أنَّ تلك الشجرة كانت "شجرة سفر التكوين"؟

42
00:03:53,810 --> 00:03:56,890
،ذلك هو الاسم الحقيقي لتلك الشجرة

43
00:03:57,460 --> 00:04:00,100
لا يعرفه إلّا القلائل من في الحكومة

44
00:04:00,100 --> 00:04:00,790
!أُنظُروا

45
00:04:00,790 --> 00:04:01,390
...هذا

46
00:04:08,260 --> 00:04:09,720
من هؤلاء؟

47
00:04:09,720 --> 00:04:12,970
أيُعقلُ أنَّ يكون هذان ساحرا سفر الخروج؟

48
00:04:24,330 --> 00:04:25,870
ما هذا؟

49
00:04:35,830 --> 00:04:39,970
شخص آخر، يُرجّحُ بأنَّهُ ساحر، قد ظهر أمام الشجرة

50
00:04:39,970 --> 00:04:42,430
!هذه اللقطة لم تُعدّل إطلاقًا

51
00:04:42,430 --> 00:04:44,600
ساحرٌ" غامض قد ظهر! هل الأمر كما قد صُرّح!؟"

52
00:04:42,850 --> 00:04:44,600
يبدو الأمر كالسحر حقًا

53
00:04:50,150 --> 00:04:50,940
!إبادة

54
00:04:54,000 --> 00:04:58,000
AlSayyad : تـرجُـمـة

55
00:04:58,000 --> 00:05:02,000
Ahmed Stein : تـدقـيـق

56
00:05:08,440 --> 00:05:10,750
!الأمر حقيقي! إنَّهُ ساحر حقيقي

57
00:05:10,750 --> 00:05:13,670
...كما قد صُرّح، لقد ظهر أمامنا

58
00:05:15,390 --> 00:05:18,460
!الساحر يُحلّق بعيدًا في السماء

59
00:05:19,590 --> 00:05:21,710
كان ذلك مبهرجًا للغاية

60
00:05:21,710 --> 00:05:22,520
فلنرجع

61
00:05:23,350 --> 00:05:25,190
...لحظةً من فضلك

62
00:05:25,190 --> 00:05:26,190
...الفندق الذي

63
00:05:26,190 --> 00:05:27,510
ليس هذا ما قصدت

64
00:05:27,510 --> 00:05:29,960
ما أقصده أن نرجع إلى قلعة كوساريبي

65
00:05:30,480 --> 00:05:34,860
لا يُمكِنُني ترك الأمور على حالها إن كان
هُنالك جاسوسٌ قد تسلّل حقًا إلى القرية

66
00:05:34,860 --> 00:05:37,860
لكن لقد قُلتِ أنَّهم رُبَّما يُدبِّرون لأمرٍ ما

67
00:05:38,260 --> 00:05:40,690
وهذا سببٌ آخر لأُحقِّق بالأمر

68
00:05:40,690 --> 00:05:42,830
هذه هي طبيعتي

69
00:05:42,830 --> 00:05:43,580
...كما أنَّ

70
00:05:44,560 --> 00:05:45,330
كما أنَّ؟

71
00:05:48,110 --> 00:05:49,320
!لا شيء

72
00:05:49,320 --> 00:05:50,140
هاكازي-سان

73
00:05:51,010 --> 00:05:54,010
أرغب بالعودة إلى الديار لأحظى ببعض الهدوء

74
00:05:55,420 --> 00:05:58,500
ليس سيئًا بالنسبة لمخنث

75
00:05:58,990 --> 00:06:01,850
لقد أخترنا شجرة يتعذر الوصول إليها نسبيًا من قبل المتفرجين

76
00:06:01,850 --> 00:06:04,390
لنُقلل الأضرار الجانبية في حال أخفقنا

77
00:06:04,390 --> 00:06:06,640
إن أصبح مرعبًا الآن، فسيكون أمامنا الكثير للقيام به

78
00:06:07,240 --> 00:06:11,650
أتساءل إن كان يُدرك ما سيحدُث

79
00:06:12,230 --> 00:06:14,810
!نتطلّع لظهورٍ آخر للساحر

80
00:06:14,810 --> 00:06:16,260
!نعود لك في الإستوديو، ساتاكي-سان

81
00:06:16,260 --> 00:06:17,150
أحسنتَ صُنعًا

82
00:06:17,150 --> 00:06:18,820
يبدو أنَّ كلَّ شيءٍ قد سارَ على ما يُرام

83
00:06:22,070 --> 00:06:25,130
!أشعُر أنَّ قلبي على وشك الإنفجار

84
00:06:26,340 --> 00:06:29,790
أحقًا علينا القيام بأمرٍ مُبالغٍ كهذا؟

85
00:06:29,790 --> 00:06:31,160
!هذه هي البداية فقط

86
00:06:31,160 --> 00:06:33,100
سنجعل الأمر أكثر بهرجةً في المرّة القادمة

87
00:06:33,100 --> 00:06:34,970
أسيكون هُنالك المزيد؟

88
00:06:34,970 --> 00:06:36,620
،هُنالك مكانان آخران في البلاد

89
00:06:36,620 --> 00:06:38,020
ومن ثم سنذهب خارج البلاد

90
00:06:38,020 --> 00:06:38,970
!خارج البلاد؟

91
00:06:41,240 --> 00:06:42,390
أُريد العودة إلى المنزل

92
00:06:42,910 --> 00:06:44,110
يا للأسف

93
00:06:44,110 --> 00:06:46,020
لدينا مهمةٌ أُخرى

94
00:06:47,220 --> 00:06:49,420
لا تقلق! يُمكِنُكَ أن تحظى ببعض النوم

95
00:06:49,420 --> 00:06:52,020
ماذا عن الطعام؟ ماذا عن الحمّام؟

96
00:07:04,750 --> 00:07:06,070
!إنَّها الأميرة

97
00:07:07,000 --> 00:07:09,410
!لقد عادت الأميرة

98
00:07:09,410 --> 00:07:12,310
علمتُ أنّي لن أموت قبل رؤيتكِ مرّةً أخرى

99
00:07:12,310 --> 00:07:14,210
سعيدةٌ برؤية الجميع على خير ما يُرام

100
00:07:13,270 --> 00:07:14,210
!أيَّتُها الأميرة

101
00:07:14,210 --> 00:07:17,960
لقد كبرتُما كثيرًا يا هيرويوكي و ميكي

102
00:07:19,190 --> 00:07:21,970
أحصلتِ لنفسكِ على شابٍّ باستعمال السحر أيَّتُها الأميرة؟

103
00:07:22,340 --> 00:07:24,120
...مُغفّل! ما الذي

104
00:07:24,120 --> 00:07:25,100
!أيَّتُها الأميرة

105
00:07:28,810 --> 00:07:29,970
!سانا

106
00:07:35,310 --> 00:07:36,980
تبدين بحالٍ أفضل يا سانا

107
00:07:39,180 --> 00:07:40,680
قبرُ أخيها؟

108
00:07:40,680 --> 00:07:44,790
قبل حوالي ستّة أشهر من إرسالي للجزيرة، فقد حياته

109
00:07:44,790 --> 00:07:45,740
جرّاء المرض

110
00:07:46,330 --> 00:07:49,010
،كانا مُقربيَن للغاية، لذا حين مات

111
00:07:49,010 --> 00:07:51,460
لم تُغادر الفراش

112
00:07:51,460 --> 00:07:53,560
لكنَّها تبدو أفضل الآن

113
00:07:53,560 --> 00:07:54,590
أجل

114
00:07:54,590 --> 00:07:57,040
يبدو أنَّ الزمن قد شفى جراحها

115
00:07:58,190 --> 00:08:00,090
،وبعودتي الآن

116
00:08:00,090 --> 00:08:03,240
يُمكِنُني إدراكُ بأنَّ سنتين قد مرّت

117
00:08:06,240 --> 00:08:08,260
...بالتفكير أنَّها قد تقع بالشرك بسهولة

118
00:08:08,260 --> 00:08:10,830
أنتِ من حضّرتي الطُعم

119
00:08:10,830 --> 00:08:13,190
هذا لأنَّ سامون-سان قد طلب ذلك

120
00:08:13,540 --> 00:08:15,860
لذا أحضرنا هذان إلى هُنا

121
00:08:15,860 --> 00:08:17,560
للتحقُّق منهم، صحيح؟

122
00:08:17,560 --> 00:08:20,250
لنرى كيف هو ساحر سفر الخروج؟

123
00:08:20,250 --> 00:08:21,780
إنَّهُ هُناك

124
00:08:24,200 --> 00:08:26,630
ليس هذا الذي يُرثى لحاله

125
00:08:27,880 --> 00:08:30,190
بل الذي لديه قلب سفر الخروج

126
00:08:31,970 --> 00:08:32,910
!شبح؟

127
00:08:32,910 --> 00:08:33,970
أجل

128
00:08:33,970 --> 00:08:38,630
يُفترض أنَّ طفلًا قد شاهد شبحًا باهتًا بالقُرب من الضريح ليلة البارحة

129
00:08:39,100 --> 00:08:40,360
...لقد فهمت

130
00:08:40,360 --> 00:08:44,900
أظُنَّ أنَّ أحدًا قد تسلّل إلى القرية حقًا

131
00:08:44,900 --> 00:08:50,550
من الطبيعي الاشتباه بأنَّ الشخص المختبئ في ظلام الليل هو شبح

132
00:08:52,220 --> 00:08:54,610
يُمكِنُكَ نشر هذه الشائعة

133
00:08:54,610 --> 00:08:58,520
وبهذا لن يتجوّل الأطفال في أماكن محظورة

134
00:08:58,520 --> 00:08:59,900
كما ترغبين

135
00:08:59,900 --> 00:09:02,380
هلّا واصلنا تحقيقنا؟

136
00:09:02,380 --> 00:09:03,990
سوف أُريك القرية أيضًا

137
00:09:03,990 --> 00:09:06,500
ولكن، ألا يُفترض بكِ أن تستريحي قليلًا؟

138
00:09:06,500 --> 00:09:09,230
لقد عُدتِ للديار توًا

139
00:09:09,230 --> 00:09:11,830
أعتذر عن هذا، لكن ما زلنا في صميم رحلتنا

140
00:09:12,310 --> 00:09:13,570
،كما تعلمون سلفًا

141
00:09:13,570 --> 00:09:17,050
شجرة سفر التكوين قد غيرّت العالم بشكلٍ جذري

142
00:09:17,050 --> 00:09:18,820
في الوقت الراهن، أشعر كما لو

143
00:09:18,820 --> 00:09:21,050
أنَّ عليَّ الإصغاء إلى رغبات سامون

144
00:09:21,410 --> 00:09:24,220
تبدين أكثر منطقية أيَّتُها الأميرة

145
00:09:24,220 --> 00:09:26,760
كلّا، أعني بأنَّكِ أصبحتِ أكثر لباقة

146
00:09:26,760 --> 00:09:28,220
إنَّهُ الرجل

147
00:09:28,220 --> 00:09:31,180
المرأة تتغيّر بسبب الرجال

148
00:09:33,100 --> 00:09:35,020
...الأمر ليس كذلك! إنَّهُ

149
00:09:35,020 --> 00:09:37,620
ألستِ كبيرةً لتحمرّي خجلًا؟

150
00:09:37,620 --> 00:09:41,790
في عمركِ، حملنا أطفالًا في كلِّ مكان

151
00:09:41,790 --> 00:09:43,030
...في كلِّ مكان

152
00:09:43,030 --> 00:09:47,240
...أ...أطـ...أطفـ

153
00:09:50,450 --> 00:09:52,950
أنتِ سريعةٌ للغاية يا هاكازي-سان

154
00:09:53,370 --> 00:09:55,050
مثيرٌ للشفقة

155
00:09:55,050 --> 00:09:56,410
...في الماضي

156
00:09:56,410 --> 00:09:57,160
أُنظُر

157
00:09:57,930 --> 00:10:01,170
سمعتُ بأنَّهم عبروا النهر باستخدام بكرة فوق ذلك

158
00:10:01,170 --> 00:10:03,170
يا للهول، مستحيل

159
00:10:03,170 --> 00:10:04,510
لا خيار آخر

160
00:10:06,020 --> 00:10:06,980
!لحظة

161
00:10:06,980 --> 00:10:12,260
إن لمستُه ستزداد مشاعري أكثر

162
00:10:12,260 --> 00:10:13,390
...أعتذر عن ذلك

163
00:10:14,310 --> 00:10:16,030
سوف أمضي قُدمًا

164
00:10:20,550 --> 00:10:22,110
هذا ضريحٌ مثيرٌ للإعجاب

165
00:10:22,550 --> 00:10:26,070
أُرجِّحُ بأنَّ الجاسوس قد جاء إلى هُنا للبحث عن وثائق قديمة

166
00:10:26,070 --> 00:10:28,220
من الممكن أن يعود

167
00:10:28,220 --> 00:10:31,870
أيُوجدُ هُنا ما قد يُفسِّر أصل شجرة سفر التكوين؟

168
00:10:31,870 --> 00:10:32,950
،لا

169
00:10:32,950 --> 00:10:36,150
،مُعظمُ سجلّاتنا لم تُترك بشكلٍ مادّي

170
00:10:36,150 --> 00:10:38,500
بل نُقلتْ شفهيًا

171
00:10:40,910 --> 00:10:44,340
،إذن حتّى إن جاء جاسوسٌ إلى هُنا

172
00:10:44,340 --> 00:10:47,000
فلا شيء باقٍ لهم ليأخُذوه؟

173
00:10:47,000 --> 00:10:50,360
القوى التي يملكها القرويين هُنا

174
00:10:50,360 --> 00:10:52,510
واضحة للغاية

175
00:10:52,990 --> 00:10:56,230
مُؤسفٌ أنَّ وجود ساحر سفر الخروج

176
00:10:56,230 --> 00:10:58,610
يُلفت الإنتباه لوجود السحر

177
00:10:58,610 --> 00:11:02,130
...وبما أنَّ كلَّ من في القرية قادرٌ على استخدام السحر

178
00:11:03,270 --> 00:11:05,980
!ياله من شعورٍ رائع

179
00:11:06,570 --> 00:11:08,470
أكان ذلك حمّامًا يابانيًا مصنوعًا من خشب السرو بالكامل؟

180
00:11:08,470 --> 00:11:11,400
!الحمّام في مقرّ سامون-سان مدهش

181
00:11:11,400 --> 00:11:13,660
لا يزال الوقت مُبكِّرًا على الإسترخاء، هذا ليس نُزلًا يابانيًا

182
00:11:16,470 --> 00:11:19,160
يبدو أنَّ الأميرة قد أصدرت تحذيرًا بالفعل

183
00:11:19,160 --> 00:11:23,880
لقد أمرت الجميع بعدم استخدام السحر نهائيًا لفترةٍ من الوقت

184
00:11:23,880 --> 00:11:26,600
كما هو مُتوقّع، لكن يبدو أنَّها تتصرّف بسُرعة

185
00:11:26,600 --> 00:11:30,900
علينا إخفاء حقيقة أنَّ هذه قريةٌ للسحرة بأيّ ثمن

186
00:11:31,470 --> 00:11:32,430
ماذا أيضًا؟

187
00:11:32,430 --> 00:11:36,730
شخصٌ في القصر أخبرني قصّة غريبة

188
00:11:36,730 --> 00:11:37,890
قصّة غريبة؟

189
00:11:38,330 --> 00:11:41,440
يُقال أنَّ طفلًا في القرية قد شاهد شبحًا

190
00:11:41,940 --> 00:11:45,770
إذن كأسوأ سيناريو، سوف نتخلّى عن ملاحقة الجاسوس؟

191
00:11:45,770 --> 00:11:49,070
كلُّ شيءٍ بخير طالما لا يشهدوا استخدامنا للسحر

192
00:11:49,070 --> 00:11:51,860
لا أمانع إن انتهى الأمر كقصّة أشباح

193
00:11:52,410 --> 00:11:53,900
أشباحٌ إذن؟

194
00:11:53,900 --> 00:11:56,060
لكن ألا يبدو الأمر مضحكًا؟

195
00:11:56,060 --> 00:11:58,990
أطفال سحرة يخافون من الأشباح؟

196
00:11:58,990 --> 00:12:00,040
حقًا؟

197
00:12:00,040 --> 00:12:02,280
تيتسوما كان جبانًا للغاية

198
00:12:02,280 --> 00:12:04,250
غالبًا ما أجعله يُبلِّل سرواله من الخوف

199
00:12:04,760 --> 00:12:09,760
أعتقدُ أنّي عرفتُ لِمَ يمقُت هاكازي-سان

200
00:12:10,280 --> 00:12:11,420
أثمة خطبٌ ما؟

201
00:12:11,420 --> 00:12:15,090
إذن فأنتِ لا تخافين من الأشباح؟

202
00:12:15,090 --> 00:12:16,950
بالطبع

203
00:12:16,950 --> 00:12:19,850
...أميرة سفر التكوين لا تخاف من الأشباح

204
00:12:20,730 --> 00:12:24,520
لكن إن بدا عليَّ الخوف هُنا، ألن أكون أظرف؟

205
00:12:25,020 --> 00:12:29,480
لحظة، لحظة، ما الذي أُفكِّرُ فيه بوقتٍ كهذا؟

206
00:12:30,130 --> 00:12:31,250
أثمة خطبٌ ما؟

207
00:12:31,250 --> 00:12:34,290
...لا، حسنًا

208
00:12:34,290 --> 00:12:37,280
أنت أيضًا تؤمن بالأشياء التي تستطيع رؤيتها، صحيح؟

209
00:12:39,380 --> 00:12:40,450
أهكذا أبدو؟

210
00:12:40,920 --> 00:12:42,270
هل أنا مخطئة؟

211
00:12:42,270 --> 00:12:46,250
"لا تقولي يظهر يا مولاتي! فإنَّهُ الواقع؛ وأنا لا أعرف التظاهر"

212
00:12:46,250 --> 00:12:47,040
ماذا؟

213
00:12:47,560 --> 00:12:49,370
إنَّهُ اقتباس من هاملت

214
00:12:49,370 --> 00:12:52,300
القصّة أيضًا عن شبح

215
00:12:53,110 --> 00:12:54,920
،سُمّمَ الملك وقُتِل

216
00:12:54,920 --> 00:12:59,030
ثم ظهر كشبحٍ أمام هاملت يُطالبه بالانتقام

217
00:12:59,890 --> 00:13:03,430
...سألته أمه إن كان قد رأى شبحًا حقًا

218
00:13:09,350 --> 00:13:10,940
تبدو مهمومًا

219
00:13:10,940 --> 00:13:14,240
حسنًا، لقد قلتِ أنّي أكثر شخصٍ إخافةٍ قد عرفته

220
00:13:14,770 --> 00:13:16,940
أتساءل فقط إن كنتُ أبدو كذلك للآخرين

221
00:13:17,990 --> 00:13:19,820
!لا تقولي يظهر يا مولاتي"

222
00:13:19,820 --> 00:13:21,940
فإنَّهُ الواقع؛

223
00:13:21,940 --> 00:13:25,250
"وأنا لا أعرف التظاهر

224
00:13:27,100 --> 00:13:28,730
هاملت مجددًا؟

225
00:13:28,730 --> 00:13:30,550
أعتقدتُ أنَّكَ من النوع

226
00:13:30,550 --> 00:13:33,590
الذي قد يقول أنَّهُ لم يرَ شبحًا حتّى لو رآه

227
00:13:34,070 --> 00:13:36,590
أنا لا أؤمن بوجودهم أصلًا

228
00:13:37,100 --> 00:13:40,860
أنت تُصبح بالتدريج مملًا مثل ماهيرو

229
00:13:40,860 --> 00:13:42,930
لن تتقبّل الأشياء غير المنطقية

230
00:13:45,970 --> 00:13:47,910
أليس الأمرُ محزنٌ قليلًا؟

231
00:13:48,600 --> 00:13:50,360
إنَّها تشعُّ ومن ثم تختفي

232
00:13:52,630 --> 00:13:55,480
ترغبُ برؤية شخصٍ راحل حتّى وإن كان شبحًا

233
00:13:56,310 --> 00:13:58,260
هل ستُنكِرُ هذه المشاعر أيضًا؟

234
00:13:59,620 --> 00:14:00,370
،على سبيل المثال

235
00:14:01,390 --> 00:14:03,830
ماذا إن كان شبحي؟

236
00:14:18,630 --> 00:14:19,780
هل عثرتَ عليها؟

237
00:14:19,780 --> 00:14:20,300
لا، ليس بعد

238
00:14:20,910 --> 00:14:22,290
متى كانت آخر مرّةٍ رأيتها؟

239
00:14:22,290 --> 00:14:24,140
منذ أن غادرتْ بمفردها عند المساء

240
00:14:24,140 --> 00:14:25,870
على أيّ حال، فلنُتابع البحث

241
00:14:25,870 --> 00:14:26,560
ما الأمر؟

242
00:14:28,100 --> 00:14:29,480
مصيبةٌ أيَّتُها الأميرة

243
00:14:29,480 --> 00:14:31,400
!سانا مفقودة

244
00:14:43,200 --> 00:14:47,570
هل قصّةٌ حول أشخاص رغبوا بالانتقام لدرجة أنَّهم دمروا أنفسهم مثيرةٌ حقًا؟

245
00:14:48,070 --> 00:14:50,570
ياللعجب، هل قرأتها؟

246
00:14:50,570 --> 00:14:54,100
لقد رأيتُ المسرحية مع حبيبتي أيّام الثانوية

247
00:14:54,100 --> 00:14:56,570
أحقًا قصدتَ مدرسة ثانوية؟

248
00:14:57,550 --> 00:14:59,210
ماذا تحسبني؟

249
00:14:59,540 --> 00:15:01,660
"خطأ "هاملت

250
00:15:01,660 --> 00:15:04,710
أنَّهُ آمن بشيءٍ لا وجود له كالأشباح

251
00:15:05,520 --> 00:15:07,830
،اللحظة التي آمن بها بشيءٍ غير منطقي

252
00:15:07,830 --> 00:15:09,430
كانت لحظة هلاكه

253
00:15:09,820 --> 00:15:13,350
ألا تؤمن بصوت الأموات أو الأرواح؟

254
00:15:13,350 --> 00:15:16,720
إنَّها مجرد أوهام صوّرها البشر

255
00:15:16,720 --> 00:15:18,390
ما أن تموت فهذه هي النهاية

256
00:15:18,830 --> 00:15:20,640
،الأموات لا يرجعون

257
00:15:20,640 --> 00:15:22,820
ولا يسمعوا رغباتنا

258
00:15:23,410 --> 00:15:24,610
جميعها أوهام

259
00:15:25,580 --> 00:15:28,850
...الأشياء التي نسيتَ أن تقولها، الأشياء التي لم تستطع قولها

260
00:15:28,850 --> 00:15:32,240
أرادوا أن تسمعهم الأشباح، ولهذا حلموا بها

261
00:15:32,860 --> 00:15:37,150
من المرجّح أيضًا أنَّ الناس قد صوّروا رغباتهم كأشباح

262
00:15:38,890 --> 00:15:41,290
فوا ماهيرو محقٌ بهذا الصدد

263
00:15:41,830 --> 00:15:44,750
الأشباح مجرد أوهام

264
00:15:44,750 --> 00:15:47,290
تقول هذا بقناعةٍ عالية

265
00:15:47,290 --> 00:15:49,280
أيُعقلُ أنَّكَ خائفٌ منهم؟

266
00:15:49,280 --> 00:15:50,550
!لا تكوني سخيفة

267
00:15:50,930 --> 00:15:53,830
على أيّ حال، مُرجّحٌ أكثر إن افترضنا

268
00:15:53,830 --> 00:15:57,330
أنَّ الشبح الذي يؤمن به الأطفال هو الجاسوس

269
00:15:57,330 --> 00:15:59,770
من المستحسن التحقيق بالأمر

270
00:15:59,770 --> 00:16:02,100
لكن ماهيرو-كن مثيرٌ للاهتمام

271
00:16:02,100 --> 00:16:06,290
"يُنكِرُ وجود الأشباح لكن يُحبُّ "هاملت

272
00:16:08,480 --> 00:16:09,950
أنا لا أُحبُّ الأشباح على أيّ حال

273
00:16:10,260 --> 00:16:13,200
كلُّ ما في الأمر أنَّ آيكا اعتادت الاقتباس منه طيلة الوقت

274
00:16:13,590 --> 00:16:16,740
إنَّها قصّةٌ في نهايتها، حبيب المرأة وأخيها

275
00:16:16,740 --> 00:16:18,960
يحزن على خسارة أخته، ويُقاتل حتّى الموت

276
00:16:18,960 --> 00:16:20,720
...ذلك الأخ يُمكِنُ أن يكون

277
00:16:20,720 --> 00:16:22,920
ليس "هاملت" وحسب

278
00:16:22,920 --> 00:16:26,250
كانت تقتبس من هذه أيضًا

279
00:16:26,250 --> 00:16:27,340
العاصفة"؟"

280
00:16:27,870 --> 00:16:30,060
ألا تعرفُ هذه؟

281
00:16:31,980 --> 00:16:34,470
،في النهاية، كلِّ شيء سيُغتفر

282
00:16:34,470 --> 00:16:38,110
وينتهي المطاف بالجميع سعداء وأحرار

283
00:16:39,860 --> 00:16:41,940
هاملت" و "العاصفة"؟"

284
00:16:41,940 --> 00:16:44,010
،كِلاهما قصّتا انتقام

285
00:16:44,010 --> 00:16:46,360
لكن النهايتان مُتناقضتان بالكامل

286
00:16:46,360 --> 00:16:47,130
!أُنظُرا

287
00:16:50,460 --> 00:16:55,370
!سانا

288
00:16:56,810 --> 00:16:59,670
!حريق... الضريح يحترق

289
00:17:03,220 --> 00:17:04,490
!الجسر المعلّق

290
00:17:05,000 --> 00:17:07,830
إنَّهم يستخدمون نوعًا من التكتيكات الفعّالة

291
00:17:07,830 --> 00:17:10,070
لإثبات وجود السحر

292
00:17:10,070 --> 00:17:11,670
...إذن فالجاسوس

293
00:17:14,670 --> 00:17:15,470
!انتظر

294
00:17:15,470 --> 00:17:18,300
هذه هي الفرصة المثالية لنعلم

295
00:17:18,300 --> 00:17:21,600
ما إن كان تاكيغاوا يوشينو ساحر سفر الخروج بالفعل

296
00:17:22,000 --> 00:17:25,020
،مُؤسفٌ أنَّنا نشتبه فقط بـيوشينو-كن على أنَّه هو المختار

297
00:17:25,020 --> 00:17:27,690
باعتبار أنَّنا نعرف من يكون المختار الآخر

298
00:17:28,220 --> 00:17:32,320
هذا يمنح شعورًا رائعًا في كلِّ مرة

299
00:17:37,980 --> 00:17:39,150
!أُنظُروا! إنَّها سانا

300
00:17:41,690 --> 00:17:42,950
!سانا

301
00:17:42,950 --> 00:17:45,570
لِمَ أتت إلى هُنا؟

302
00:17:45,570 --> 00:17:47,950
يُفترضُ أنَّها سمعتْ عن الشبح

303
00:17:47,950 --> 00:17:50,430
رُبَّما لهذا السبب أتت إلى هُنا

304
00:17:50,430 --> 00:17:51,170
ماذا؟

305
00:17:52,290 --> 00:17:53,970
أظُنُّ أنَّني أفهم

306
00:17:55,910 --> 00:17:57,090
!على أيّ حال، علينا إنقاذها

307
00:17:57,770 --> 00:17:58,700
لا خيار آخر

308
00:17:58,700 --> 00:18:01,680
!أيَّتُها الأميرة، أنتِ من أمرتِنا ألّا نستخدم السحر

309
00:18:01,680 --> 00:18:03,770
!إنَّهُ يُحاولُ دفعكِ لاستخدام السحر

310
00:18:03,770 --> 00:18:06,600
!إن لم نوقِفها، فأنَّ النيران ستنتشر في الغابة

311
00:18:06,990 --> 00:18:09,560
!هُنالك احتمالٌ أيضًا لوجود كاميرا مخفيّة في مكانٍ ما

312
00:18:09,560 --> 00:18:11,270
!إذن ما الذي علينا فعله؟

313
00:18:11,270 --> 00:18:15,450
!من دون السحر، لا يوجد هُنا سوى الأطفال وكبار السن

314
00:18:19,250 --> 00:18:20,120
!يوشينو

315
00:18:28,620 --> 00:18:29,750
ما الذي تحاول فعله؟

316
00:18:30,210 --> 00:18:32,190
...إن انزلقتُ على الحبل باستخدام هذه السلسلة

317
00:18:32,190 --> 00:18:33,960
!لا تكُن مُغفّلًا، هذا خطيرٌ للغاية

318
00:18:33,960 --> 00:18:36,960
!سوف أفصله عن سانا-سان وأقوم بإبعاده

319
00:18:36,960 --> 00:18:37,880
!يوشينو

320
00:18:39,620 --> 00:18:41,830
...ظنّتْ بأنَّها قادرةٌ على رؤية شبح أخيها

321
00:18:42,310 --> 00:18:43,970
لهذا السبب أتت

322
00:18:44,540 --> 00:18:46,980
أرادتْ رؤيته حتّى وإن كان شبحًا

323
00:18:51,520 --> 00:18:52,570
!يوشينو

324
00:18:59,130 --> 00:19:00,460
...يوشينو-كن

325
00:19:00,460 --> 00:19:02,830
من النادر رؤيته هكذا كونه هادئ في العادة

326
00:19:02,830 --> 00:19:05,810
لكن قد يكون كلُّ هذا جزءً من خطته

327
00:19:05,810 --> 00:19:09,120
ولكن، أتظُنُّ أنَّهُ سيُقدِم على مُخاطرةٍ كهذه؟

328
00:19:09,120 --> 00:19:11,370
أين المخاطرة في ذلك؟

329
00:19:11,370 --> 00:19:14,250
أنسيتِ أنَّ لديه طلسم؟

330
00:19:30,100 --> 00:19:31,650
!أُهرُبي إلى الغابة

331
00:19:47,590 --> 00:19:48,250
!يوشينو

332
00:19:52,420 --> 00:19:53,750
!اسمعيني

333
00:19:58,720 --> 00:19:59,510
!لقد استخدمتْهُ بالفعل

334
00:20:00,090 --> 00:20:03,010
كلّا، لقد جعلها تاكيغاوا يوشينو تستخدمُه

335
00:20:03,010 --> 00:20:05,680
...ما أن تُدرك الفتاة البريئة شهوتها

336
00:20:05,680 --> 00:20:07,420
حتّى يُصبح التعامل معها مستحيلًا...

337
00:20:15,610 --> 00:20:16,350
!انتظر

338
00:20:29,370 --> 00:20:31,310
انتهى الأمر بشكلٍ جيّد

339
00:20:31,310 --> 00:20:33,090
لمصلحتنا على أيّ حال

340
00:20:36,640 --> 00:20:37,630
!هل أنتَ بخير؟

341
00:20:37,630 --> 00:20:40,630
لقد لويتُ كاحلي قليلًا

342
00:20:40,630 --> 00:20:43,680
يبدو أنَّهم إكتشفوا أمر السحر

343
00:20:43,680 --> 00:20:45,300
...هذا ليس

344
00:20:49,600 --> 00:20:53,350
!هذا ليس ما أهتمُّ له الآن

345
00:20:56,810 --> 00:20:59,820
لقد كنتُ قلقةً للغاية

346
00:21:00,290 --> 00:21:01,440
...هاكازي-سان

347
00:21:04,160 --> 00:21:05,490
أتُحاولُ القول

348
00:21:05,490 --> 00:21:08,540
أنَّ كلَّ ما حدث كان من تدبير ساحر سفر الخروج؟

349
00:21:08,960 --> 00:21:12,100
أميرة سفر التكوين بدأتْ بتجاهُل

350
00:21:12,100 --> 00:21:14,990
منطق شجرة سفر التكوين من أجله

351
00:21:14,990 --> 00:21:19,300
من لديه مثل هذه القوة بجانب ساحر سفر الخروج؟

352
00:21:19,750 --> 00:21:25,450
لكن من المرجّح أنَّ هاكازي-سان ترى يوشينو-كن من منظورٍ مختلف

353
00:21:26,080 --> 00:21:27,930
!كيف ترين أنتِ الأمر؟

354
00:21:28,680 --> 00:21:30,170
لا أعلم

355
00:21:30,170 --> 00:21:32,430
لا أعلم ما الذي عليَّ تصديقه

356
00:21:38,410 --> 00:21:39,500
لا فائدة

357
00:21:40,020 --> 00:21:43,050
،حتّى إن كان الذنب يسحقُني

358
00:21:43,050 --> 00:21:44,070
...فأنا

359
00:21:45,070 --> 00:21:47,780
أُحبُّ يوشينو

360
00:21:50,780 --> 00:21:52,560
...الجاسوس

361
00:21:52,560 --> 00:21:55,870
أتعني أنَّ وكالةً وطنيّة وراء ذلك؟

362
00:21:55,870 --> 00:21:58,580
،أعترِفُ أنَّ الأمر كان غير مُتوقّع قليلًا

363
00:21:58,580 --> 00:22:01,680
لكن رُبَّما لمصلحتنا أنَّ قرية كوساريبي

364
00:22:01,680 --> 00:22:04,150
وأمر ارتباطها بالسحر قد فُضِح

365
00:22:04,150 --> 00:22:05,260
ما الذي تعنيه؟

366
00:22:05,680 --> 00:22:09,470
على ما يبدو ستسنح لنا فرصٌ أكثر لاستخدام أوراقنا بشكلٍ فعّال

367
00:22:09,470 --> 00:22:12,130
يبدو أنَّكَ ستعود إلى مركزك سريعًا

368
00:22:12,130 --> 00:22:14,270
لا أملك سوى رجاء ذلك

369
00:22:14,740 --> 00:22:18,050
ربما أكون قد وجدتُ شيئًا مثيرًا بنفسي

370
00:22:18,050 --> 00:22:19,560
شيئًا مثيرًا؟

371
00:22:20,010 --> 00:22:22,570
...شيءٌ قد يكون المفتاح لمعرفة

372
00:22:23,620 --> 00:22:26,060
سبب وجود أشجار سفر التكوين وسفر الخروج

373
00:24:02,900 --> 00:24:05,250
الصديقة من المدرسة الثانوية

374
00:24:05,250 --> 00:24:06,850
قد تكون زميلته في الصف

375
00:24:07,420 --> 00:24:10,160
ما هذا؟ أهو حبٌّ كوميديّ؟

376
00:24:10,160 --> 00:24:11,890
ماذا عن إمرأةٍ متزوّجة؟

377
00:24:11,890 --> 00:24:15,280
"حتّى أنت يُمكِنُ أن توصفَ بـ"الحثالة

378
00:24:15,280 --> 00:24:16,720
هذا قاسٍ

379
00:24:16,720 --> 00:24:20,690
فالفضول يُراودني بشأن آلة قشر الجليد

380
00:24:20,690 --> 00:24:23,230
ثلج البحر إذن؟