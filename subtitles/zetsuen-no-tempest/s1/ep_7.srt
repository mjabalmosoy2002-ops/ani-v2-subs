1
00:01:33,940 --> 00:01:35,250
...ماهيرو

2
00:01:36,170 --> 00:01:38,540
...إذن، ما تُحاول قوله

3
00:01:39,720 --> 00:01:43,340
أأرغبُ أن أكون عشيقتك؟

4
00:01:46,470 --> 00:01:49,600
لا، لن أُبالغ لتلك الدرجة

5
00:01:50,660 --> 00:01:51,920
...إذن

6
00:01:51,920 --> 00:01:54,840
كيف ترغب أن ينتهي بك الحال مع أختك الصغرى؟

7
00:01:54,840 --> 00:01:56,070
ما الذي تعنينه بأختي الصغرى

8
00:01:56,070 --> 00:01:59,070
أنتِ لا تُفكّرين بي كأخٍ أكبر

9
00:01:59,070 --> 00:02:00,740
بالتأكيد

10
00:02:00,740 --> 00:02:02,620
نحنُ غير مرتبطَين بالدم حتّى

11
00:02:04,740 --> 00:02:07,620
لِمَ تحتم أن تكوني أنتِ؟

12
00:02:07,620 --> 00:02:08,960
الأمر لاعقلاني

13
00:02:09,530 --> 00:02:12,000
أنتِ نقيض الفتيات اللواتي أواعدهنّ

14
00:02:12,000 --> 00:02:14,700
...لا تملكين أثداءً أو إغراءً جنسيًا

15
00:02:14,700 --> 00:02:16,870
لِمَ تُثيرين اهتمامي؟

16
00:02:16,870 --> 00:02:18,380
لِمَ لا أقدر أن أُحافظ على رِباطة جأشي؟

17
00:02:18,950 --> 00:02:20,910
أنت لا تحظى بقسطٍ كافٍ من النوم

18
00:02:20,910 --> 00:02:21,970
!هذا ليس ما في الأمر

19
00:02:26,650 --> 00:02:27,450
...آيكا

20
00:02:28,230 --> 00:02:31,500
في الوقت الراهن، لا تُبادري بأيّ علاقةٍ مع أيّ أحد

21
00:02:31,500 --> 00:02:34,190
لا تعصيني، أفهمتِ؟

22
00:02:36,410 --> 00:02:37,530
،في هذه الحالة

23
00:02:37,530 --> 00:02:41,390
ما أنت فاعل إن كنتُ في علاقة حاليًا؟

24
00:02:43,200 --> 00:02:45,870
!لا تقولي لي أنَّ لديكِ صديق

25
00:02:47,910 --> 00:02:50,580
أعتبره أمرٌ عقلاني ، ما هو رأيك؟

26
00:02:54,830 --> 00:02:57,420
،هل يتغلّب الحُبُّ على القدر"

27
00:02:57,420 --> 00:03:00,990
أم هل يتغلّب القدر على الحُبّ

28
00:03:00,990 --> 00:03:02,430
هذه

29
00:03:02,430 --> 00:03:06,330
"مسألةٌ ما زلنا بحاجةٍ إلى أن نحلّها

30
00:03:08,000 --> 00:03:11,000
AlSayyad : تـرجُـمـة

31
00:03:11,000 --> 00:03:14,000
Ahmed Stein : تـدقـيـق

32
00:03:28,880 --> 00:03:30,310
ما الذي تفعله؟

33
00:03:30,310 --> 00:03:31,540
لحمايتنا من البرد

34
00:03:31,540 --> 00:03:33,830
سيُبقي الهواء البارد خارجًا

35
00:03:34,380 --> 00:03:35,330
ما أخبار هاكازي-سان؟

36
00:03:35,830 --> 00:03:40,160
لقد قالت شيئًا عن استجماع قوتها قبل المعركة الأخيرة

37
00:03:41,760 --> 00:03:45,310
أنا واثقٌ أنَّها تغُطُّ في نومٍ عميق

38
00:03:48,360 --> 00:03:49,680
خُذ

39
00:03:52,700 --> 00:03:54,020
من أين لك هذا؟

40
00:03:54,020 --> 00:03:57,180
اقترضته من البيت الذي نمنا فيه

41
00:03:57,180 --> 00:03:58,890
أنت مدهشٌ حقًا

42
00:03:58,890 --> 00:04:00,010
لصٌ صفيق

43
00:04:00,010 --> 00:04:01,620
!أنا فقط اقترضتها

44
00:04:01,620 --> 00:04:02,940
!سوف أقوم بإعادتها

45
00:04:02,940 --> 00:04:04,460
حينما ينتهي كلُّ شيء

46
00:04:08,150 --> 00:04:09,230
...حينما ينتهي

47
00:04:09,960 --> 00:04:10,700
كلُّ شيء

48
00:04:23,860 --> 00:04:25,420
،بغضِّ النظر عن النتيجة

49
00:04:26,150 --> 00:04:28,800
كلُّ اللاعقلانية ستُصحّح

50
00:04:29,510 --> 00:04:32,420
،ما أن نجد قاتل آيكا-تشان

51
00:04:32,420 --> 00:04:35,430
لا شكَّ لديّ أنَّ ماهيرو سيقتُله

52
00:04:37,340 --> 00:04:38,430
...الانتقام

53
00:04:38,890 --> 00:04:42,550
هذا هو السبب الوحيد لوجود ماهيرو الحالي

54
00:04:43,680 --> 00:04:44,800
،بصرفِ ذلك

55
00:04:45,670 --> 00:04:48,200
ما الذي سيحدُث بعد أن يحظى بانتقامه؟

56
00:04:58,620 --> 00:05:02,420
رسائل مستلمة

57
00:05:02,870 --> 00:05:04,300
لقد مرَّ وقتٌ طويل

58
00:05:05,460 --> 00:05:09,140
لقد اعتدتَ التحديق في هاتفك دائمًا

59
00:05:09,620 --> 00:05:11,630
لكنّك توقّفت مُؤخّرًا

60
00:05:17,900 --> 00:05:19,850
...الجوُّ باردٌ للغاية

61
00:05:22,120 --> 00:05:23,130
...ذلك اليوم

62
00:05:26,440 --> 00:05:28,240
ذلك اليوم كان حارًا

63
00:05:29,050 --> 00:05:32,140
آيكا-تشان، ألا زال لديكِ كلُّ هذه الفروض لتُؤدّيها؟

64
00:05:32,140 --> 00:05:37,540
إنَّ من اللاعقلانية أن نُسلّم الكثير من الفروض
لدرجة ألّا نستمتع بعُطلتِنا الصيفية

65
00:05:39,360 --> 00:05:40,000
قُبلة

66
00:05:43,180 --> 00:05:45,300
هل سنُقبّل بعضنا قبل نهاية الصيف؟

67
00:05:45,300 --> 00:05:46,550
...هذا

68
00:05:57,180 --> 00:05:58,780
رُغم أنَّها لن تكون هنا

69
00:06:01,510 --> 00:06:04,330
أتفقُ معكِ

70
00:06:04,330 --> 00:06:06,010
،كونها المرة الأولى لنا

71
00:06:06,010 --> 00:06:08,490
علينا أن نختار المكان بعناية

72
00:06:08,490 --> 00:06:10,590
ألديكَ أيُّ أفكار يا يوشينو-سان؟

73
00:06:12,040 --> 00:06:13,780
...لا يُمكنني التفكير بشيءٍ الآن

74
00:06:13,780 --> 00:06:17,160
إذن، ألديكِ أيُّ أفكارٍ يا آيكا-تشان؟

75
00:06:19,210 --> 00:06:21,180
لديَّ المكان المثالي

76
00:06:23,480 --> 00:06:24,570
بيتٌ صيفيّ؟

77
00:06:24,570 --> 00:06:25,520
أجل

78
00:06:25,520 --> 00:06:29,880
نحن دائمًا ما نُمضي الأسبوع الأخير للعطلة الصيفيّة هُناك كعائلةٍ واحدة

79
00:06:29,880 --> 00:06:31,770
أتدعونني أيضًا؟

80
00:06:31,770 --> 00:06:34,080
أنا واثقةٌ أنَّ والديّ سيُسعدان بقدومك

81
00:06:34,780 --> 00:06:37,770
لكن أسبوعٌ مع ماهيرو؟

82
00:06:37,770 --> 00:06:40,040
...وستكون معي أيضًا

83
00:06:41,700 --> 00:06:45,140
يوشينو-سان، أرجوك كُن لطيفًا مع ماهيرو

84
00:06:46,030 --> 00:06:50,190
أنا واثقةٌ أنَّكَ الشخص الوحيد الذي يُمكن أن يكون صديقه

85
00:06:53,990 --> 00:06:55,050
...آيكا-تشان

86
00:06:57,370 --> 00:07:00,580
لابُدَّ أنَّكِ لاحظتِ مشاعر ماهيرو، أليس كذلك؟

87
00:07:01,640 --> 00:07:02,630
...إذن

88
00:07:07,840 --> 00:07:09,090
فوا ماهيرو

89
00:07:10,970 --> 00:07:12,040
ماهيرو؟

90
00:07:12,040 --> 00:07:13,080
أنت مُتفرِّغ، صحيح؟

91
00:07:13,080 --> 00:07:14,870
قابلني في المحطّة

92
00:07:15,350 --> 00:07:18,460
...أُفضّل ألّا تفترض أنّي مُتفرِّغ

93
00:07:18,460 --> 00:07:19,910
إذن أراك بعد عشر دقائق

94
00:07:19,910 --> 00:07:20,890
عشر دقائق؟

95
00:07:20,890 --> 00:07:22,420
هذا الوقت غيرُ كافٍ

96
00:07:22,420 --> 00:07:23,440
!أنت

97
00:07:24,800 --> 00:07:26,110
...تبًا

98
00:07:31,780 --> 00:07:32,900
!مرحبًا

99
00:07:34,270 --> 00:07:35,070
...أنت، ماهيرو

100
00:07:35,070 --> 00:07:36,600
دعني أُعرّفك

101
00:07:36,600 --> 00:07:38,410
هذا هو تاكيغاوا يوشينو

102
00:07:38,410 --> 00:07:39,620
يوشينو-كن؟

103
00:07:39,620 --> 00:07:41,130
يا له من اسمٍ فريد

104
00:07:41,750 --> 00:07:42,910
...انتظر لحظة

105
00:07:42,910 --> 00:07:44,550
...بعد التفكير بالأمر، أنا مشغولٌ حقًّا

106
00:07:45,290 --> 00:07:46,880
والآن، هيّا بنا

107
00:07:46,880 --> 00:07:48,140
!ظريفٌ للغاية

108
00:07:48,140 --> 00:07:50,200
كونه أصغر سنًا ليس سيئًا إلى هذا الحد

109
00:07:50,460 --> 00:07:52,280
لكنكِ تميلين دائمًا لمن هُم أكبرُ منكِ

110
00:07:50,820 --> 00:07:54,220
لن أغفر لك هذا يا ماهيرو

111
00:07:52,280 --> 00:07:54,220
ذلك من الماضي، ونحن في الحاضر الآن

112
00:07:54,220 --> 00:07:56,590
وماذا إن لم تغفر؟

113
00:07:59,400 --> 00:08:00,180
القصاص

114
00:08:01,220 --> 00:08:02,830
!مذهل

115
00:08:02,830 --> 00:08:03,560
رائع للغاية

116
00:08:03,560 --> 00:08:04,020
أعلم

117
00:08:16,360 --> 00:08:19,030
...كلاهما رائع للغاية

118
00:08:19,030 --> 00:08:20,270
إنَّهما كالمحترفين

119
00:08:21,020 --> 00:08:21,750
صحيح؟

120
00:08:29,270 --> 00:08:30,320
...مهلًا

121
00:08:30,320 --> 00:08:31,380
ما هذا؟

122
00:08:38,900 --> 00:08:40,180
!إلى اللقاء

123
00:08:41,310 --> 00:08:42,190
...اسمع

124
00:08:43,240 --> 00:08:45,370
عليك حقًّا التوقُّف عن هذا

125
00:08:45,370 --> 00:08:46,440
إنَّهُ تصرُّفٌ شائن

126
00:08:47,020 --> 00:08:48,410
ما خطبُك؟

127
00:08:48,410 --> 00:08:50,980
وأنا من كنتُ أحاول الحصول لك على صديقة

128
00:08:50,980 --> 00:08:52,890
من طلب منك ذلك؟

129
00:08:52,890 --> 00:08:55,030
تبدو واثقًا للغاية

130
00:08:55,030 --> 00:08:58,060
لم أتوقّع أن تحظى بواحدةٍ
...بالنظر إلى شخصيتك

131
00:08:58,060 --> 00:08:59,360
الصديقة

132
00:08:59,360 --> 00:09:00,920
ليست شيئًا تحظى به

133
00:09:00,920 --> 00:09:02,370
بمجرد أنَّك رغبت بذلك

134
00:09:03,070 --> 00:09:04,700
،تُقابلُ شخصًا تُحبه

135
00:09:04,700 --> 00:09:06,460
وترغبان بإمضاء وقتكما معًا

136
00:09:07,360 --> 00:09:08,420
ولهذا

137
00:09:09,040 --> 00:09:12,250
أنت تريدها أن تكون صديقتك، أليس كذلك؟

138
00:09:20,500 --> 00:09:21,540
ما الأمر؟

139
00:09:23,000 --> 00:09:24,110
لم أعُد أهتم

140
00:09:34,720 --> 00:09:36,390
،رُغم أنَّها العطلة الصيفية

141
00:09:36,390 --> 00:09:39,900
لديك بعض الجُرأة حقًا للرجوع للبيت في وقتٍ متأخر

142
00:09:39,900 --> 00:09:42,220
لقد كُنتُ بصُحبةِ يوشينو

143
00:09:42,220 --> 00:09:43,280
يوشينو-سان؟

144
00:09:43,280 --> 00:09:47,400
،أعتقدتُ أنَّهُ قد يرغب بصديقةٍ أو اثنتين

145
00:09:47,400 --> 00:09:49,760
لذا فكّرتُ بتقديمه لبعض الفتيات

146
00:09:50,490 --> 00:09:52,960
لم يبدُ مستاءً للغاية

147
00:09:53,760 --> 00:09:55,840
أجدُ صعوبةً في تصديق

148
00:09:55,840 --> 00:09:58,920
أنَّك قد تتسكّع مع شخصٍ قد يُناسب يوشينو-سان

149
00:09:58,920 --> 00:10:00,680
...ما كنتُ لأقول هذا

150
00:10:00,680 --> 00:10:02,510
كان هُنالك بعضٌ من طالبات الجامعة الغنيّات

151
00:10:03,110 --> 00:10:05,970
يستحيل لطالبة جامعة غنيّة أن تُطيق

152
00:10:06,310 --> 00:10:08,760
،ما قد يقوله يوشينو-سان المُخادع، على سبيل المثال

153
00:10:08,760 --> 00:10:12,000
"أُريد تناول ترقوتكِ بعيدان الطعام"

154
00:10:12,660 --> 00:10:15,440
نظرتكِ لـيوشينو تبدو حاقدةً قليلًا

155
00:10:16,170 --> 00:10:17,450
،ببساطة

156
00:10:17,450 --> 00:10:20,950
،إن أردت التفكير بشأنه بإيجابيّه
يوشينو-سان لديه قدرةٌ عالية على التكيُّف

157
00:10:20,950 --> 00:10:23,280
،لكن إن فكّرت بسلبيّة
فهو لا يملكُ أيَّ شخصيّة

158
00:10:23,900 --> 00:10:28,200
،يُمكِنُه التصرُّفَ بشكلٍ طبيعيّ تحتَ أيّ ظرف

159
00:10:28,200 --> 00:10:30,440
لكنَّهُ لن يقوم بالمبادرة الشخصية

160
00:10:30,440 --> 00:10:32,870
أو يُحاول تغيير الوضع الراهن

161
00:10:33,210 --> 00:10:37,460
لذا، ليس من ضمن شخصيته أخذ زمام المبادرة مع النساء

162
00:10:38,630 --> 00:10:41,660
بل هو على العكس، شخصٌ يحتاج الآخرين للمبادرة تجاهه

163
00:10:41,660 --> 00:10:43,320
أيُّ فتاةٍ طبيعيّة

164
00:10:43,320 --> 00:10:46,020
سترفُض الشخص الذي لا يقوى على إبداء رأيه

165
00:10:46,020 --> 00:10:48,970
حسنًا، أظُنُّ أنَّ هذا صحيح

166
00:10:49,790 --> 00:10:51,530
أفضلُ من قد يُناسب يوشينو-سان

167
00:10:52,390 --> 00:10:53,940
هو شخصٌ مثلك يا ماهيرو

168
00:10:55,110 --> 00:10:55,860
أنا؟

169
00:10:56,400 --> 00:10:58,420
،أنت مهملٌ وأنانيّ

170
00:10:58,420 --> 00:11:01,030
وتفعل ما يحلو لك

171
00:11:01,450 --> 00:11:03,700
،لا تهتم بمدى تلاعُبك بالآخرين

172
00:11:03,700 --> 00:11:05,130
إلى حد التسلُّط

173
00:11:05,530 --> 00:11:09,000
أنا واثقةٌ أنَّ يوشينو-سان سيكون مثاليًا لشخصٍ مثلك

174
00:11:09,000 --> 00:11:11,340
لا تقولي أمورًا مقززةً كهذه

175
00:11:12,940 --> 00:11:16,870
لم أعني أنَّ عليكما أن تواعدا بعضكما البعض

176
00:11:16,870 --> 00:11:20,190
ما قُلتُه ببساطة، أنَّ لا وجود للكثير من النساء

177
00:11:20,190 --> 00:11:22,260
المُستبدّات والمغروراتِ مثلك

178
00:11:23,070 --> 00:11:24,160
،رغم ذلك

179
00:11:24,910 --> 00:11:27,720
أظُنُّ أنَّ عليك معاملة يوشينو-سان بودّية

180
00:11:27,720 --> 00:11:28,470
ماذا؟

181
00:11:30,040 --> 00:11:33,070
،مهما حدث أنا واثقةٌ

182
00:11:33,070 --> 00:11:35,400
أنَّهُ سوف يكون بجانبك

183
00:11:41,320 --> 00:11:43,450
...لقد أرهقني ماهيرو بشدة

184
00:11:45,450 --> 00:11:50,430
أيُعقل أنَّهُ يعلم بأمري أنا و آيكا-تشان

185
00:11:50,970 --> 00:11:53,050
...ولهذا كان يُحاول الإيقاع بي

186
00:11:53,920 --> 00:11:56,070
كلّا، لا يُعقل هذا

187
00:11:56,620 --> 00:12:00,510
إنَّهُ حادّ الإدراكِ حقًّا، لكنَّهُ غافلٌ عن الأمور المهمة

188
00:12:05,960 --> 00:12:07,140
!آيكا-تشان

189
00:12:10,570 --> 00:12:13,600
...هذان الشقيقان مميزان حقًا

190
00:12:11,520 --> 00:12:15,020
صديقة

191
00:12:11,520 --> 00:12:15,020
كيف كانت ترقوة فتاة
الجامعة؟

192
00:12:30,190 --> 00:12:31,610
...سحقًا، إنَّهُ صاخب

193
00:12:32,130 --> 00:12:34,020
لا يُمكُنني النوم

194
00:12:34,020 --> 00:12:35,690
لم أكُن أعلم أنَّكَ حسّاسٌ للغاية

195
00:12:35,690 --> 00:12:37,820
ولِمَ لا؟

196
00:12:37,820 --> 00:12:39,690
فأنا صبيٌ مُدلّل

197
00:12:40,290 --> 00:12:42,040
إذن أنت تعترف بالأمر

198
00:12:43,220 --> 00:12:43,870
أخبرني

199
00:12:45,380 --> 00:12:47,130
ألم تقُل في السابق

200
00:12:47,640 --> 00:12:49,630
أنَّ لا فائدة من الحصول على صديقة

201
00:12:49,630 --> 00:12:52,080
إن لم تكن تُحبّها من أعماقك؟

202
00:12:54,140 --> 00:12:57,190
أقُلتُ هذا؟

203
00:12:57,190 --> 00:12:59,840
لم أفهم معنى ذلك

204
00:13:00,840 --> 00:13:03,320
لقد كانوا هم من يطلبون منّي الخروج

205
00:13:03,320 --> 00:13:05,400
...لقد كان الأمر هكذا دائمًا

206
00:13:06,530 --> 00:13:09,910
إذن كيف يبدو؟

207
00:13:10,490 --> 00:13:11,720
مواعدة فتاةٍ تُحبها؟

208
00:13:14,390 --> 00:13:15,980
...أتساءل كيف يبدو أيضًا

209
00:13:16,900 --> 00:13:18,700
،بغض النظر عن مدى المحبة

210
00:13:18,700 --> 00:13:21,110
دائمًا ما قد يحدث نوعٌ من الشقاق، أليس كذلك؟

211
00:13:21,110 --> 00:13:23,430
أظنُّ أنَّ من الصعب تقبُّل

212
00:13:23,430 --> 00:13:26,450
مواعدتك لشخصٍ تُحبُّه بصدق

213
00:13:26,450 --> 00:13:27,690
أتظنُّ ذلك؟

214
00:13:28,280 --> 00:13:29,420
أجل هذا ما أظنُّه

215
00:13:34,550 --> 00:13:37,190
النجوم جميلة، أليس كذلك؟

216
00:13:37,950 --> 00:13:41,180
لقد راقبنا النجوم من قبل معًا، أليس كذلك؟

217
00:13:41,180 --> 00:13:42,070
...أجل

218
00:13:42,660 --> 00:13:44,210
في منزل العائلة الصيفي؟

219
00:13:44,210 --> 00:13:46,050
أجل، عطلة الصيف

220
00:13:47,250 --> 00:13:48,250
مهلًا

221
00:13:48,250 --> 00:13:50,820
ألم تقُل أنَّكَ تكره النجوم؟

222
00:13:50,820 --> 00:13:53,220
أُحبُّ نجوم الشتاء

223
00:13:53,690 --> 00:13:58,110
أعجز عن شرح السبب جيدًا، لكنها تبدو مهيبة وباردة

224
00:13:58,650 --> 00:14:02,230
إنَّها عالية، ولا يُمكن بلوغها بسهولة

225
00:14:04,740 --> 00:14:08,510
ماهيرو لم يُدرك

226
00:14:09,410 --> 00:14:13,540
أنَّهُ كان مغرمًا بـآيكا-تشان

227
00:14:16,160 --> 00:14:17,290
،بالرغم من شخصيته

228
00:14:18,040 --> 00:14:21,330
فقد كان خائفًا حتّى من لمس آيكا-تشان

229
00:14:23,930 --> 00:14:27,620
لم يعلم ما يتحتّم عليه فعله حينما يقف بجانبها

230
00:14:29,670 --> 00:14:32,210
،بغض النظر عمّا قالته

231
00:14:32,210 --> 00:14:34,580
أنا واثقٌ أنَّ آيكا لم تكره ماهيرو

232
00:14:39,640 --> 00:14:41,100
،لو أنَّهما ألتقيا في ظروفٍ مختلفة

233
00:14:41,900 --> 00:14:43,370
...لربما كان هذان الاثنان

234
00:14:52,690 --> 00:14:53,810
...انتظر، ماهيرو

235
00:14:53,810 --> 00:14:54,700
!آيكا-تشان

236
00:15:01,290 --> 00:15:02,000
لا تعترضيني

237
00:15:02,000 --> 00:15:03,810
...يا للإزعاج

238
00:15:03,810 --> 00:15:06,440
"قُم بما تقدر عليه بيديك"

239
00:15:06,440 --> 00:15:08,470
أليست هذه هي سياسة والدي؟

240
00:15:08,470 --> 00:15:12,350
من المؤسف أنَّ والديكُما لم يتمكّنا من الحضور

241
00:15:12,350 --> 00:15:15,140
لديهما عملٌ شاق، فما باليد حيلة

242
00:15:15,140 --> 00:15:16,440
...يوشينو-سان

243
00:15:16,440 --> 00:15:19,020
أيُمكنُكَ مسحُ السلالم حينما تنتهي؟

244
00:15:20,560 --> 00:15:21,310
أجل

245
00:15:26,310 --> 00:15:28,900
أنتِ تكرهين يوشينو حقًا، أليس كذلك؟

246
00:15:28,900 --> 00:15:29,930
ماذا؟

247
00:15:29,930 --> 00:15:31,850
لقد دعوتِهِ إلى هنا

248
00:15:31,850 --> 00:15:35,080
للتنفيس عن إحباطكِ عن طريق إرهاقه بالعمل، صحيح؟

249
00:15:35,540 --> 00:15:37,950
أو ربما تُخطِّطان لأمرٍ آخر؟

250
00:15:38,670 --> 00:15:39,750
نُخطِّط؟

251
00:15:41,480 --> 00:15:43,420
قد تكون مُحقًّا

252
00:15:48,430 --> 00:15:49,630
!أنتِ

253
00:15:49,980 --> 00:15:51,780
!إن قمتِ بشواء هذا الكم فسيحترق

254
00:15:51,780 --> 00:15:55,030
!وأنت كان عليك وضع الصلصة قبل الطهو

255
00:15:55,030 --> 00:15:55,640
...تمهّلا

256
00:15:56,030 --> 00:15:57,260
...دعونا نحاول الاستمتاع بالطعام

257
00:16:02,340 --> 00:16:04,580
سأتولّى مُهمّة الشواء

258
00:16:09,210 --> 00:16:10,900
أُريد بعض الذرة بعد ذلك يا يوشينو

259
00:16:10,900 --> 00:16:13,080
أنا أرغب بالأكل أيضًا

260
00:16:16,910 --> 00:16:18,560
صديقة

261
00:16:16,910 --> 00:16:18,560
دعنا نلتقي في الباحة
بعد العشاء

262
00:16:26,180 --> 00:16:27,030
!أنت

263
00:16:27,690 --> 00:16:29,230
إنَّها تحترق يا يوشينو

264
00:16:34,580 --> 00:16:36,150
...يا للروعة

265
00:16:37,530 --> 00:16:38,870
مدهشة

266
00:16:38,870 --> 00:16:39,770
أليست كذلك؟

267
00:16:40,500 --> 00:16:45,220
لا يُمكِنُنا رُؤية كلِّ هذه النجوم في المدينة

268
00:16:45,220 --> 00:16:47,900
...لم أرَ هذا القدر من النجوم

269
00:16:47,900 --> 00:16:49,730
تبدو وكأنَّها تتدفق من السماء

270
00:16:50,420 --> 00:16:53,610
نجوم الصيف قاسية للغاية

271
00:16:54,310 --> 00:16:56,360
إنَّها تلمعُ بلا تفكيرٍ أو مبالاة

272
00:16:56,780 --> 00:16:59,340
أتكرهين النجوم يا آيكا-تشان؟

273
00:16:59,340 --> 00:17:00,460
أنا أُحبُّها

274
00:17:01,750 --> 00:17:04,680
إنَّها تُحاول جاهدةً لتُظهر تألُّقها

275
00:17:04,680 --> 00:17:09,370
تحاول إعلامنا أنَّها موجودةٌ قبل أن تختفي

276
00:17:10,050 --> 00:17:13,170
أُحبُّ تلك الأمنية البسيطة والصادقة

277
00:17:14,670 --> 00:17:15,700
...آيكا-تشان

278
00:17:19,000 --> 00:17:22,100
أنت موجود هنا يا يوشينو-سان

279
00:17:22,850 --> 00:17:23,720
أجل

280
00:17:25,690 --> 00:17:26,810
وأنتِ أيضًا

281
00:17:38,670 --> 00:17:40,120
أين أنت يا يوشينو؟

282
00:17:41,730 --> 00:17:44,960
ما الذي تفعلانه؟

283
00:17:44,960 --> 00:17:46,840
لنلعب بالورق

284
00:17:47,390 --> 00:17:49,670
عليك لعب الورق في المنزل الصيفي

285
00:17:53,220 --> 00:17:56,340
إذن الخاسر سيعدُّ الإفطار

286
00:17:56,340 --> 00:17:57,270
ماذا؟

287
00:17:57,270 --> 00:17:58,920
!أنتِ ستلعبين أيضًا؟

288
00:17:58,920 --> 00:17:59,890
بالطبع

289
00:18:00,470 --> 00:18:02,340
ما الذي كُنتُما تفعلان هنا على أيّ حال؟

290
00:18:03,270 --> 00:18:05,890
...كُنّا ننظُر إلى النجوم

291
00:18:07,420 --> 00:18:09,350
لا أُحبُّ نجوم الصيف

292
00:18:09,350 --> 00:18:11,780
إنَّها تلمع بلا مبالاةٍ للعالم

293
00:18:11,780 --> 00:18:13,820
إنَّها تُشعرني بالانزعاج

294
00:18:14,280 --> 00:18:15,650
لنعد إلى المنزل

295
00:18:17,650 --> 00:18:21,620
اضبط هاتفك على النمط الهزاز

296
00:18:26,760 --> 00:18:28,620
!يا للإزعاج

297
00:18:29,030 --> 00:18:34,180
لِمَ لمْ تُخبرني أنَّكَ بارعٌ في لعبة الورق؟

298
00:18:34,180 --> 00:18:37,820
إنَّهُ ليس أمرًا قد تُخبر الناس به

299
00:18:37,820 --> 00:18:39,380
...آيكا قويةٌ أيضًا

300
00:18:39,590 --> 00:18:40,380
نغمة الرنين على النمط الهزاز

301
00:18:39,770 --> 00:18:41,390
رغم أنَّها ليست ذكيةً مثلي

302
00:18:45,390 --> 00:18:46,330
يوشينو

303
00:18:47,310 --> 00:18:49,690
من الأفضل لك ألّا تنفرد بـآيكا

304
00:18:50,230 --> 00:18:54,110
إنَّها تُخطِّط لأشياء خبيثة

305
00:18:55,370 --> 00:18:56,740
خبيثة؟

306
00:18:56,740 --> 00:18:59,170
لقد كانت هكذا دائمًا

307
00:19:00,010 --> 00:19:02,350
لم أفهم ما تُفكِّر به أبدًا

308
00:19:02,350 --> 00:19:05,000
إنَّها فظّةٌ دائمًا ولا تتصرّف بلطافة

309
00:19:05,000 --> 00:19:08,660
أعتقدتُ أنَّ العيش معها سيكون مستحيلًا

310
00:19:09,150 --> 00:19:12,120
،لكن لسببٍ ما علمت

311
00:19:12,120 --> 00:19:14,130
أنَّها ستُصبح جزءً من العائلة

312
00:19:14,540 --> 00:19:17,210
كما لو أنَّها تنتمي لهذا المكان

313
00:19:17,700 --> 00:19:20,350
حقًّا، ما الذي تُفكّرُ به؟

314
00:19:20,970 --> 00:19:24,330
أتُريد أن تعلم

315
00:19:24,330 --> 00:19:26,060
ما الذي تُفكّرُ به حقًا؟

316
00:19:26,060 --> 00:19:27,270
أجل

317
00:19:27,270 --> 00:19:28,520
إنَّهُ أمرٌ مزعج

318
00:19:30,940 --> 00:19:31,640
...أتعلم

319
00:19:33,800 --> 00:19:37,000
...ما تشعر به تجاه آيكا-تشان

320
00:19:42,670 --> 00:19:43,280
لا شيء

321
00:19:44,290 --> 00:19:48,340
على هذا المعدل، ستكون مسؤولًا عن إعداد الإفطار طوال الأسبوع

322
00:20:08,390 --> 00:20:09,680
أتساءل

323
00:20:09,680 --> 00:20:12,340
إن كانت غرائز ماهيرو قد حذّرته

324
00:20:14,190 --> 00:20:17,290
على هذا المعدل، لن نكون قادريَن على فعلها

325
00:20:18,530 --> 00:20:21,360
فأنت لا تقود كرجل

326
00:20:22,010 --> 00:20:23,910
...لا أعلم كيفية الاستجابة لهذا

327
00:20:24,710 --> 00:20:26,990
!آيكا-تشان، إنَّ هذا خطير

328
00:20:38,130 --> 00:20:39,380
...آيكا-تشان

329
00:20:41,260 --> 00:20:42,340
يوشينو-سان

330
00:20:55,100 --> 00:20:56,680
لا يُمكِنُنا فعلها

331
00:20:58,760 --> 00:20:59,960
آيكا-تشان؟

332
00:21:00,530 --> 00:21:03,630
فأزهار عبّاد الشمس تُراقب

333
00:21:05,070 --> 00:21:06,910
...آيكا-تشان

334
00:21:12,210 --> 00:21:13,630
الجوُّ بارد

335
00:21:14,940 --> 00:21:15,920
هل استيقظت؟

336
00:21:16,600 --> 00:21:18,290
لقد حان الوقت، يوشينو

337
00:21:18,890 --> 00:21:20,020
...هذا

338
00:21:20,020 --> 00:21:22,550
...لم أتوقع أن تُثير الطلاسم اهتمامي

339
00:21:26,310 --> 00:21:28,360
لكن عليَّ القول، أنّي متحمّسٌ للغاية

340
00:21:41,620 --> 00:21:43,590
لِمَ تبدو خائفًا؟

341
00:21:43,590 --> 00:21:45,010
أنا لن أُطلق عليك

342
00:21:49,220 --> 00:21:52,160
النية تدوم ما بقيت عالقة بالذاكرة"

343
00:21:52,940 --> 00:21:55,980
"لكن ما أكثر ما نزمع أمرًا ثم ننقضه

344
00:21:56,910 --> 00:21:58,250
هاملت إذن؟

345
00:21:58,250 --> 00:21:59,580
ليس سيئًا

346
00:22:00,380 --> 00:22:02,850
اليوم ستُسجل نهاية مسرحية الانتقام هذه

347
00:22:04,440 --> 00:22:05,340
،لكن أنظر "

348
00:22:06,300 --> 00:22:09,420
،إلى مطلع الفجر مرتديًا كساءه الأحمر

349
00:22:09,800 --> 00:22:12,970
"وهو يطل من فوق الندى المتساقط على ذلك الكثيب الشرقي

350
00:22:16,220 --> 00:22:17,140
فلنذهب

351
00:22:17,140 --> 00:22:17,880
أجل

352
00:24:02,310 --> 00:24:04,830
أتحسبُ أنَّ كلَّ شيءٍ سيتغيّر بدءً من الآن؟

353
00:24:04,830 --> 00:24:08,000
حان الوقت لنرى كيف سينتهي هذا القتال يا سامون

354
00:24:08,920 --> 00:24:10,280
إذن أيَّتُها الأميرة

355
00:24:10,280 --> 00:24:13,110
لنضع اليوم حدًا لحُسنِ حظّكِ

356
00:24:13,630 --> 00:24:16,750
للقيام بذلك، لابُدَّ أن يُدمّر العالم أولًا

357
00:24:17,480 --> 00:24:20,070
ظهرتِ أخيرًا يا شجرة سفر الخروج

358
00:24:20,530 --> 00:24:21,610
...ولكن

359
00:24:21,610 --> 00:24:23,640
لكي آخذ بثأري إلى أبعد الحدود