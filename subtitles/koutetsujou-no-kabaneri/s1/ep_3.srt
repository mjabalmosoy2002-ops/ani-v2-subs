1
00:00:05,270 --> 00:00:07,610
أقُلتِ نصف جثّة... ؟

2
00:00:07,610 --> 00:00:08,980
.صحيح

3
00:00:08,980 --> 00:00:11,610
.كائنٌ بينَ البشر والجثث

4
00:00:12,280 --> 00:00:14,860
!أنتِ مثلي؟

5
00:00:18,660 --> 00:00:20,910
.كلُّ ما أفهمه هو أنّكما لستما بشرًا

6
00:00:22,790 --> 00:00:24,960
...إن كنتَ عدوّي إذًا

7
00:00:26,960 --> 00:00:27,670
.فسأقتلك

8
00:00:32,880 --> 00:00:34,590
.الجثث أعداءُ البشرية

9
00:00:37,970 --> 00:00:39,850
.أوقف هذا يا كوروسو

10
00:00:43,020 --> 00:00:46,810
،لو لا هذان الاثنان
.لكنّا قد هلكنا جميعًا

11
00:00:47,060 --> 00:00:49,980
.مهما كانَ الأمر، لا يمكنني السماح للجثث بالبقاء هنا

12
00:00:49,980 --> 00:00:51,900
.أنا أوافقه الرأي

13
00:00:52,190 --> 00:00:53,400
.أنا جثّة

14
00:00:53,400 --> 00:00:55,700
.السماح لي بالبقاء هنا سيؤدّي بالجميع للإصابة

15
00:00:59,620 --> 00:01:00,620
...ما-ما بالك

16
00:01:00,620 --> 00:01:02,620
.أنتَ لست جثّة بل نصفَ جثّة

17
00:01:02,620 --> 00:01:05,250
،قد يكون جسدكَ جسدَ جثّة
.ولكنَّ عقلك عقلُ بشري

18
00:01:05,250 --> 00:01:06,000
...أتتوقعين منّي تصديق

19
00:01:06,000 --> 00:01:07,130
.أيامي-سان

20
00:01:07,130 --> 00:01:09,790
قطار "كوتيتسوجو" هذا متجّه إلى "كونغوكاكو"، أليس كذلك؟

21
00:01:10,800 --> 00:01:13,970
...أجل، وذلك وفقًا لجدوله الزّمني

22
00:01:14,550 --> 00:01:15,800
ما هو "كونغوكاكو"؟

23
00:01:15,800 --> 00:01:17,260
ألم تسمعي به؟

24
00:01:17,260 --> 00:01:20,140
.إنّه حصنُ "شوغن" العظيم

25
00:01:20,430 --> 00:01:23,350
...أيامي-ساما، إن كنّا متوجهين نحو "كونغوكاكو" فإنّني

26
00:01:23,350 --> 00:01:25,020
هلّا أخذتني إلى هناك؟

27
00:01:25,020 --> 00:01:28,310
.افعلي ذلك وأعدكِ بأنّني لن أبرح هذه المقطورة

28
00:01:28,310 --> 00:01:29,860
...ويحكِ، لم أنهي حديثي معها بعـ

29
00:01:39,240 --> 00:01:42,240
.بأي حال، أنا لن أبرحَ هذا القطار سواءٌ وافقتِ أم لا

30
00:01:43,790 --> 00:01:46,410
هل أنتَ بشريٌ أم جثّة؟

31
00:01:46,410 --> 00:01:49,880
.لا هذا ولا ذاك
.إنّني نصف جثّة

32
00:03:21,260 --> 00:03:23,510
.هذا خطيرٌ يا سوزوكي-سان

33
00:03:24,430 --> 00:03:26,760
.أنا في حاجة لفحصها من الجانب

34
00:03:28,020 --> 00:03:29,640
.لا أصدّق هذا

35
00:03:28,020 --> 00:03:29,640
.لقد سمعتُ أنَّ هناك جثّة على متن القطار

36
00:03:29,640 --> 00:03:31,310
.إياك وأن تفتح النافذة اللّعينة

37
00:03:31,310 --> 00:03:32,770
.فاليأخذ كلّ فردٍ منكم واحدة

38
00:03:33,060 --> 00:03:35,310
.سنعود من جديد هذا المساء بمزيدٍ من الطعام

39
00:03:36,440 --> 00:03:38,280
.وكأنَّ شيئًا كهذا سيكون كافيًا

40
00:03:40,360 --> 00:03:41,740
.تفضّلي

41
00:03:41,740 --> 00:03:43,030
.شكرًا لك

42
00:03:46,280 --> 00:03:48,450
.لطفلكِ الّذي لم يولد بعد

43
00:03:53,960 --> 00:03:59,050
.ليس هناك ما يكفي من الطعام والماء لتلبية حشدِ النّاس الّذين على متن القطار

44
00:03:59,050 --> 00:04:00,670
هل سنُفلح؟

45
00:04:00,670 --> 00:04:02,970
.لا خيار أمامنا سوى المُحاولة

46
00:04:02,970 --> 00:04:05,600
.لا يوجد مكان آمن غير ذلك

47
00:04:05,970 --> 00:04:09,430
ولكن، ماذا سنفعل إن رفضنا "كونغوكاكو"؟

48
00:04:09,430 --> 00:04:11,100
.حصص الطعام

49
00:04:11,100 --> 00:04:14,690
.الزعيم الحاليُ هو عمُّ أيامي-ساما

50
00:04:15,230 --> 00:04:16,560
.لن يجرؤوا على رفضنا

51
00:04:18,070 --> 00:04:20,940
.توقّف، يداك مغطاة بالزيت

52
00:04:20,940 --> 00:04:22,280
.إنّه جسدي

53
00:04:22,280 --> 00:04:24,450
أنتَ تقصد جسدكَ الّذي وهبتهُ لك أمّك؟

54
00:04:52,600 --> 00:04:54,770
جراحُكَ اندملتْ كلّها، أليس كذلك؟

55
00:04:55,600 --> 00:04:58,060
.ذلك لأنَّ لديكَ جسد جثّة

56
00:04:58,860 --> 00:05:01,570
.يجب أن تكونَ قادرًا على التحرّك بشكل جيّد الآن

57
00:05:03,320 --> 00:05:05,820
."قُلتِ بأنّكِ ذاهبة إلى "كونغوكاكو

58
00:05:07,280 --> 00:05:09,780
.ذلكَ لأنّني وعدتُ آني-ساما

59
00:05:09,780 --> 00:05:12,250
.لا يُمكنني إعلامكَ بالتفاصيل، ولكنّني في مهمّة ضرورية

60
00:05:13,370 --> 00:05:15,540
هل أنت مهتمٌ بـ"كونغوكاكو" أيضًا؟

61
00:05:16,170 --> 00:05:18,960
.إنّهم في الطليعة من ناحية دراسة الجثث

62
00:05:18,960 --> 00:05:23,340
.قد يكون بمقدورهم فعل شيءٍ بشأن حالة "نصف الجثّة" هذه

63
00:05:23,340 --> 00:05:24,920
.ظننتُ أنّك تودُّ النزول

64
00:05:25,720 --> 00:05:29,800
،"ليس معنى هذا أنّني صدقتُ قصتكِ حول "أنصاف الجثث

65
00:05:29,800 --> 00:05:33,430
،ولكن، إن بقيتُ في مقطورة المَرجَلِ هاته لثلاثة أيام

66
00:05:33,430 --> 00:05:36,810
.ذلكَ سيُثبتُ أنَّ عقلي ما يزال بشريًا

67
00:05:36,810 --> 00:05:38,440
.قُضيَ الأمر إذًا

68
00:05:38,440 --> 00:05:39,190
قُضيَ الأمر؟

69
00:05:40,190 --> 00:05:42,730
.ستركبُ قطار "كوتيتسوجو" معي

70
00:05:42,730 --> 00:05:44,940
.وستُلازمني كدرعي

71
00:05:45,240 --> 00:05:46,740
درع؟

72
00:05:46,740 --> 00:05:50,120
.عندما أقاتل لوقتٍ طويل، ينتابني النعاس وأنام

73
00:05:50,120 --> 00:05:52,540
.ولذلكَ أحتاج درعًا حيًّا

74
00:05:52,540 --> 00:05:55,000
.فعضاتُ الجثث لا يبدو أنّها تؤثر بأي حال

75
00:05:55,710 --> 00:05:56,910
...كفاكِ هراءً

76
00:05:59,750 --> 00:06:01,790
ستذهبُ إلى "كونغوكاكو"، أليس كذلك؟

77
00:06:01,790 --> 00:06:03,500
.فالتنهض إذًا
.سوفَ نبدأ

78
00:06:04,210 --> 00:06:05,340
نبدأ ماذا؟

79
00:06:05,340 --> 00:06:07,050
التدريب، أوليس ذلك واضحًا؟

80
00:06:07,590 --> 00:06:10,550
.أنتَ لستَ بدرعٍ جيّدٍ في حالتكَ المزرية هاته

81
00:06:11,760 --> 00:06:12,890
.تمهلّي لحظة

82
00:06:12,890 --> 00:06:14,520
،تحركاتك بطيئة للغاية

83
00:06:14,520 --> 00:06:16,100
.قدماكَ مفتوحتان على مصرعيْهما

84
00:06:16,100 --> 00:06:17,060
.قلتُ لكِ انتظري

85
00:06:17,310 --> 00:06:21,020
كيفَ تجرؤون على تركِ جثّة على متن القطار؟

86
00:06:21,020 --> 00:06:22,690
.لم يتأخر الوقت بعد

87
00:06:22,690 --> 00:06:25,280
.اطردوا تلك الجثث الوحوش فورًا

88
00:06:25,280 --> 00:06:28,650
.لقد قطعا وعدًا بأن يظلّا في المقطورة الخلفية

89
00:06:28,650 --> 00:06:30,950
أحقًا تظنّينَ أنَّ جثّة ستُحافظ على وعدها؟

90
00:06:31,240 --> 00:06:34,620
ألا تشعرون بالامتنان لهما أيها الزعماء الستّة؟

91
00:06:35,330 --> 00:06:40,370
.ناهيكَ عن أنَّ ذلك الرّجل حاول القيام بالأمر الصائب بالرُغم من تحوّله لجثّة

92
00:06:40,370 --> 00:06:41,830
.لا يمكنكم الدّخول عنوة هكذا يا سادة

93
00:06:44,210 --> 00:06:47,260
،لقد رفضوا الانصات
."طالبينَ منّا أن نوقفَ قطار "كوتيتسوجو

94
00:06:47,260 --> 00:06:48,800
.أوقفوا القطار رجاءً

95
00:06:48,800 --> 00:06:50,260
.نريد إقامة جنازة

96
00:06:50,550 --> 00:06:52,350
.نريد أن نصليَّ من أجل عائلتنا

97
00:06:52,350 --> 00:06:56,020
.وصلواتنا لن تصلهم ان ابتعدنا كثيرًا

98
00:06:56,020 --> 00:06:58,680
ألا تريدين أن ترقد أرواح أحفادنا بسلام؟

99
00:07:08,740 --> 00:07:11,320
لا فائدة، كم مرّة عليَّ اخبارُك؟

100
00:07:11,320 --> 00:07:13,620
.دُر هكذا واندفع مرتين واضرب

101
00:07:13,620 --> 00:07:15,280
.لم تقترب من فعل ذلك حتى

102
00:07:15,280 --> 00:07:17,750
...فـ-فقط لأنَّ بوسعكِ فعل ذلك

103
00:07:17,750 --> 00:07:19,580
.لا يعني أنَّ شرحكِ واضح

104
00:07:20,120 --> 00:07:22,920
.تمالك نفسك قليلاً

105
00:07:22,920 --> 00:07:26,210
.لم أنزع حزامي بعد وها أنت ذا طريح أرضًا

106
00:07:28,760 --> 00:07:31,260
لأي غرضٍ تضعينَ ذاك الشيءَ على عنقكِ؟

107
00:07:33,260 --> 00:07:35,300
.لعلّه مشابه للّذي لديك

108
00:07:35,300 --> 00:07:38,560
،لكنّني إن نزعتُ خاصتي
.فإنَّ بمقدوريَ القتال بقوّتي الكاملة

109
00:07:38,890 --> 00:07:41,890
.ولكن، بعد فترة من الوقت، امتدّت اللّعنة وأصبحَ ينتابني التعب

110
00:07:41,890 --> 00:07:43,100
.هذا غريب

111
00:07:45,360 --> 00:07:45,900
!جثة؟

112
00:07:46,190 --> 00:07:46,980
ما الأمر؟

113
00:07:47,570 --> 00:07:48,480
.أ-أنتِ

114
00:07:49,940 --> 00:07:52,240
مومي، ما الّذي تفعلينه؟

115
00:07:52,240 --> 00:07:53,660
.توقّف أرجوك

116
00:07:53,660 --> 00:07:56,990
.لقد رأيتكِ تحصلين على حصّتين من الطعام

117
00:07:57,790 --> 00:07:58,490
.إنّها الجثّة

118
00:07:59,040 --> 00:08:00,000
!جثّة؟

119
00:08:00,000 --> 00:08:01,500
.لا يُفترض بها الخروج

120
00:08:02,000 --> 00:08:04,710
.الجثث... الجثث طليقة

121
00:08:08,960 --> 00:08:10,760
...لقد شعرتُ بذلك حتمًا

122
00:08:11,550 --> 00:08:13,470
.فالتعودي يا مومي

123
00:08:13,470 --> 00:08:16,180
لقد قطعتِ وعدًا بألا تبرحي مقطورة المرجل، صحيح؟

124
00:08:16,180 --> 00:08:17,510
.تنحّ عن طريقي

125
00:08:18,140 --> 00:08:19,020
.لا تتحرّكا

126
00:08:20,640 --> 00:08:22,600
.أنصاف جثث، بلا كلام فارغ

127
00:08:22,600 --> 00:08:24,900
أتتوقان لبعض الدّماء البشريّة الطازجة؟

128
00:08:24,900 --> 00:08:26,230
.توقّف

129
00:08:26,230 --> 00:08:28,110
.سأعيدُ مومي الآن

130
00:08:28,110 --> 00:08:30,610
."سأحرص على ألا تخرجَ حتى نصل لـ"كونغوكاكو

131
00:08:30,610 --> 00:08:33,150
وهل بوسعكَ فعل شيءٍ كهذا؟

132
00:08:34,660 --> 00:08:35,740
.مومي-سان

133
00:08:37,200 --> 00:08:40,200
ما معنى هذا؟

134
00:08:40,200 --> 00:08:41,700
لماذا خرجتما؟

135
00:08:41,700 --> 00:08:43,160
.لقد وعدتُماني

136
00:08:43,500 --> 00:08:45,080
.لن تفهميني حتى لو أخبرتُكِ

137
00:08:45,080 --> 00:08:46,170
.مهلاً

138
00:08:47,500 --> 00:08:50,920
.ما كان يجب أن نسمح لهذه الجثث بالبقاء في القطار بالفعل

139
00:08:50,920 --> 00:08:53,220
.لنطردهم حالاً من القطار

140
00:08:53,800 --> 00:08:54,840
.هاتِ ما لديك

141
00:08:54,840 --> 00:08:55,970
.توقّفي

142
00:09:00,470 --> 00:09:02,100
.لديَّ أخبارٌ سيّئةٌ أيها القائد

143
00:09:02,100 --> 00:09:04,980
.يبدو أنَّ خزّان المياه الّذي قُمنا بإصلاحه  أُصيب

144
00:09:05,980 --> 00:09:08,440
.ويستحيل بلوغ المحطّة المُقبلة على هذه الحال

145
00:09:16,530 --> 00:09:17,990
هل سنتوقّف؟

146
00:09:17,990 --> 00:09:19,910
.سيقومون بجمع المياه

147
00:09:20,660 --> 00:09:22,790
.تحقّق فيما إن كان الضغط في ارتفاع أم لا

148
00:09:22,790 --> 00:09:25,040
.أجل، هكذا يجب أن يكون

149
00:09:39,930 --> 00:09:41,810
.لا توجد أيُّ جثث على مرمى النّظر

150
00:09:43,020 --> 00:09:46,440
كم نحتاج من وقتٍ لإصلاح خزّان المياه؟

151
00:09:46,440 --> 00:09:49,400
.ربّما حتى صباح اليوم التالي

152
00:09:49,650 --> 00:09:50,980
الصباح؟

153
00:09:51,690 --> 00:09:54,900
.يمكننا أن نتناوبَ في الحراسة

154
00:09:54,900 --> 00:09:56,450
.فكرة جيّدة

155
00:09:56,450 --> 00:10:00,780
،لنتلوا صلواتنا إذًا
.مادام قطار "كوتيتسوجو" متوقفًا

156
00:10:01,280 --> 00:10:03,200
أهذا بناءً على طلبِ أولئكَ المسنّين؟

157
00:10:04,040 --> 00:10:06,120
.أودُّ تقديم صلاةٍ أيضًا

158
00:10:06,120 --> 00:10:07,870
.من أجل أبي

159
00:10:09,670 --> 00:10:10,710
.لقد فهمت

160
00:10:27,350 --> 00:10:30,810
.ارقدوا في سلام، ارقدوا في سلام

161
00:10:58,800 --> 00:10:59,880
ماذا قلت؟

162
00:10:59,880 --> 00:11:01,470
أهذا صحيح؟

163
00:11:01,470 --> 00:11:04,050
.وهم يتظاهرون بأنّهم بشر

164
00:11:04,390 --> 00:11:05,600
.هذا لا يُغتفر

165
00:11:05,600 --> 00:11:07,020
أيحاولون العبث معنا؟

166
00:11:09,270 --> 00:11:11,020
.كفَّ عن ذلك وعد إلى العمل

167
00:11:11,310 --> 00:11:14,690
.وكأنَّ الصلاة ستعيدهم إلى الحياة

168
00:11:17,480 --> 00:11:18,440
.سأساعدك

169
00:11:21,160 --> 00:11:22,620
.أنتَ شخصٌ فانٍ

170
00:11:25,990 --> 00:11:28,290
هل فقدتِ شخصًا ما؟

171
00:11:28,290 --> 00:11:29,910
.مُعلّمي

172
00:11:29,910 --> 00:11:32,750
وهل كنتِ مقرّبةً جدًا من مُعلّمكِ ذاك؟

173
00:11:35,090 --> 00:11:36,210
.أنتَ تثير اشمئزازي

174
00:11:39,010 --> 00:11:41,880
.تلكَ هي طبيعتي

175
00:11:47,470 --> 00:11:49,100
ألن تقوم بالصلاة؟

176
00:11:49,100 --> 00:11:51,480
.لقد فقدتُ عائلتي منذ وقتٍ طويل

177
00:11:52,270 --> 00:11:53,810
!عجبًا

178
00:11:53,810 --> 00:11:55,270
.مثلي تمامًا

179
00:11:59,360 --> 00:12:01,400
.كلّنا نشترك في نفس القصة

180
00:12:01,400 --> 00:12:04,030
.أن تخسرَ عائلتكَ على يد الجثث

181
00:12:07,160 --> 00:12:09,660
ما ذلك الشيء الّذي في يدكَ اليُمنى؟

182
00:12:10,910 --> 00:12:13,000
.أتألم عندما أضربه

183
00:12:17,800 --> 00:12:19,880
.مجرّد حجرٍ يُمكنكِ ايجاده حول أيِ نهرٍ قديم

184
00:12:21,220 --> 00:12:24,010
.وجدتُ اثنين من هذه الحجارة الجميلة مع أختي

185
00:12:25,300 --> 00:12:28,220
،قلتُ لها أنَّ بإمكانها أن تحظى بكليهما ولكن

186
00:12:28,220 --> 00:12:32,180
.قالتْ أنّه يجبُ يحظى كلانا بواحدٍ ليجلب لنا الحظ الجيّد

187
00:12:34,650 --> 00:12:37,400
.لم أكن أخطّط للحفاظ عليه كتذكار

188
00:12:40,150 --> 00:12:41,400
.حدث ذلك قبل خمس سنوات

189
00:12:42,360 --> 00:12:44,820
.اجتاح الجثث محطّتنا

190
00:12:45,450 --> 00:12:48,080
.وجرّاء الخوف لاذ البالغون بالفرار

191
00:12:49,700 --> 00:12:51,080
.لقد تركونا خلفهم

192
00:12:52,580 --> 00:12:54,750
.وأمسك الجثث بأختي

193
00:12:56,960 --> 00:12:58,790
قصّة فريدة من نوعها، صحيح؟

194
00:13:00,170 --> 00:13:02,720
ولكن، ماذا فعل أخوها الغبيُّ برأيك؟

195
00:13:04,050 --> 00:13:04,970
.فرَّ هاربًا

196
00:13:07,050 --> 00:13:09,600
...متذرّعًا بعذرٍ واهٍ وهو طلب المساعدة

197
00:13:09,600 --> 00:13:11,720
.هربتُ من ذاك المكان

198
00:13:13,350 --> 00:13:15,850
.حاولتُ التمسكَ بشخص ما

199
00:13:20,400 --> 00:13:22,320
...ولكن، عندما عدت

200
00:13:22,650 --> 00:13:25,530
.كانت أختي ملقاةً على الأرض وقد بدأت بالتحوّل

201
00:13:28,700 --> 00:13:31,160
كونيَ شقيقًا جبانًا
.بدأتُ بالبُكاء والاعتذار

202
00:13:32,450 --> 00:13:34,290
."أصرخ مرارًا وتكرارًا: "أنا آسف، أنا آسف

203
00:13:36,250 --> 00:13:37,750
.لكنّني كنتُ أعلم أنَّ الأوان قد فات

204
00:13:39,500 --> 00:13:41,210
.أختي رحلت

205
00:14:15,700 --> 00:14:18,710
...حتى لو كان ذلك يعني موتنا معًا وقتها

206
00:14:19,500 --> 00:14:21,880
.فقد كان يجبُ أن أتغلّبَ على خوفي وأقاتل

207
00:14:23,130 --> 00:14:26,260
...مهما كرهتُ نفسي لهربي وتخلّيَ عنها

208
00:14:26,260 --> 00:14:28,130
.فإنَّ أختي لن تعود أبدًا

209
00:14:35,850 --> 00:14:38,350
.إنّها بالفعل قصّة فريدة

210
00:14:39,690 --> 00:14:43,150
.الضعيف يموت والقويُّ يعيش

211
00:14:44,570 --> 00:14:46,240
.هذا كلّ ما في الأمر

212
00:14:50,450 --> 00:14:51,530
هل نفعلها؟

213
00:14:51,530 --> 00:14:53,120
.دعوا الأمر لي

214
00:14:53,120 --> 00:14:55,290
ما الّذي تنوون فعله؟

215
00:14:55,870 --> 00:14:58,040
.إنّهما ليسا عدوّينِ لنا

216
00:14:58,040 --> 00:15:00,290
.لقد أنقذانا

217
00:15:00,290 --> 00:15:01,750
.الجثث هم العدو

218
00:15:01,750 --> 00:15:03,590
.إن بادروا بالهجوم علينا فلن تكون أمامنا فرصة

219
00:15:03,590 --> 00:15:05,300
.دعينا نفعل ذلك رجاءً يا أيامي-ساما

220
00:15:05,880 --> 00:15:07,260
...أنتم

221
00:15:10,590 --> 00:15:12,090
أيامي-ساما؟

222
00:15:13,510 --> 00:15:14,890
...أنا

223
00:15:14,890 --> 00:15:16,930
.أصدقاؤكِ عصبيون بشكلٍ مروّع

224
00:15:17,470 --> 00:15:18,730
...إنّهم

225
00:15:19,100 --> 00:15:20,100
.لا بأس

226
00:15:20,100 --> 00:15:23,060
.إن أردتم حربًا فيسرّني إجباركم

227
00:15:23,360 --> 00:15:24,060
.تمهّلي

228
00:15:29,030 --> 00:15:31,110
.على الضُعفاء ألا يتصنّعوا الشجاعة

229
00:15:31,490 --> 00:15:33,240
.لا تستفزّيهم يا مومي

230
00:15:33,740 --> 00:15:35,490
.هم من بدؤوا باستفزازي

231
00:15:35,490 --> 00:15:37,700
.أنظروا؟ إنَّ أنصافَ الجثث لأعداءٌ لنا حقًا

232
00:15:38,500 --> 00:15:40,000
.لا تتراجعوا يا رفاق

233
00:15:40,000 --> 00:15:42,500
.يجبُ علينا حماية عائلاتنا

234
00:15:42,500 --> 00:15:44,040
.تطهير شامل

235
00:15:44,420 --> 00:15:45,710
.كفوا عن ذلكَ فورًا

236
00:15:49,340 --> 00:15:51,760
.انزلي من فضلكِ، فهذا خطير

237
00:15:51,760 --> 00:15:54,010
.لا تسمحي لهم رجاءً يا أيامي-ساما

238
00:16:14,280 --> 00:16:15,700
لا فائدة؟

239
00:16:18,040 --> 00:16:19,410
.أنا آسفة

240
00:16:20,750 --> 00:16:22,000
...أمّكَ

241
00:16:22,960 --> 00:16:24,750
.لا يمكنها انجابكَ يا صغيري

242
00:16:26,750 --> 00:16:28,210
شينو-سان؟

243
00:16:28,210 --> 00:16:29,420
.إنّها نصف جثّة

244
00:16:29,420 --> 00:16:31,130
ما الّذي تفعلينه هنا؟

245
00:16:31,130 --> 00:16:33,090
.هؤلاء متعصبون أيضًا

246
00:16:33,090 --> 00:16:35,140
.لم آتي لافتعال قتالٍ هنا

247
00:16:37,930 --> 00:16:39,970
.هلّا قدّمتِ لي معروفًا؟

248
00:16:39,970 --> 00:16:41,180
ما-ماهو؟

249
00:16:43,810 --> 00:16:45,150
ما الخطب؟

250
00:16:46,900 --> 00:16:48,270
هل تريد التبوّل؟

251
00:16:48,270 --> 00:16:50,070
هل تشعر بالضيق؟

252
00:16:59,080 --> 00:17:00,290
.لقد ضحك

253
00:17:01,540 --> 00:17:03,080
.لقد جعلته يضحك

254
00:17:05,670 --> 00:17:09,340
،إيكوما، أذكر أنّكَ قلتَ لوالدي

255
00:17:09,340 --> 00:17:12,010
.ألا نُصوّبَ بنادقنا اتجاهَ الأهداف الخاطئة

256
00:17:13,420 --> 00:17:14,010
.إذن

257
00:17:16,300 --> 00:17:18,010
هل أنصاف الجثث أعداؤنا؟

258
00:17:18,390 --> 00:17:20,510
أم أنّهم حلفاؤنا؟

259
00:17:21,140 --> 00:17:23,480
.أيامي-ساما -
.توقّفي رجاءً -

260
00:17:25,060 --> 00:17:29,860
،مادام المسؤول عن قطار "كوتيتسوجو" قد غادر
،فكامل المسؤولية تقع على عاتقي

261
00:17:30,320 --> 00:17:33,530
.في تحديد أعدائنا من حلفائنا

262
00:17:36,360 --> 00:17:38,820
لماذا ترفض استخدام يدكَ اليُمنى؟

263
00:17:39,120 --> 00:17:41,240
لماذا لا تقوم بإمساكي ببساطة وعضي؟

264
00:17:41,240 --> 00:17:42,330
.لا أستطيع

265
00:17:42,330 --> 00:17:43,450
لماذا؟

266
00:17:43,790 --> 00:17:45,790
.لأنني أخذتُ عهدًا على نفسي

267
00:17:46,620 --> 00:17:48,710
.أنا أرفض الهرب بعد الآن

268
00:17:48,710 --> 00:17:51,590
،لن أدع أيَ أرواح أخرى تسقط ضحايا

269
00:17:51,590 --> 00:17:54,920
.لأجل إنقاذ شخصٍ خسيس مثلي

270
00:17:56,380 --> 00:17:58,390
.الجثث هم أعداؤنا

271
00:17:58,930 --> 00:18:00,890
...وأنا أعيش لأجل هدفٍ واحد

272
00:18:01,220 --> 00:18:03,890
.وهو إبادة الجثث عن بكرة أبيهم

273
00:18:11,480 --> 00:18:12,900
...هل أنتم

274
00:18:12,900 --> 00:18:14,150
راضون بشكل كافٍ الآن؟

275
00:18:16,450 --> 00:18:19,820
،من ما يزالون يصدّقون أنَ هذا الرجل عدوّنا

276
00:18:19,820 --> 00:18:22,080
.أنا أرحب بكم هنا

277
00:18:22,830 --> 00:18:24,870
.وأمنحكم فرصةً لتتحققوا بأنفسكم

278
00:18:36,470 --> 00:18:39,890
.أنا أعتذر لاختباري لك بهذا الشكل

279
00:18:39,890 --> 00:18:40,720
.لا بأس

280
00:18:41,090 --> 00:18:45,220
ولكن، لماذا أمسكت بنصل الخنجر مباشرة؟

281
00:18:45,220 --> 00:18:46,890
.كان بإمكانك إمساك يدي

282
00:18:48,310 --> 00:18:50,940
.كلا، أنا لا أستطيع التحكم في قواي جيدًا

283
00:18:51,690 --> 00:18:55,440
.فلم يمضِ وقتٌ طويل منذ أن أصبحت هكذا

284
00:18:55,980 --> 00:18:58,200
.كنتُ أخشى أن أتسبب في إيذائكِ

285
00:18:59,570 --> 00:19:01,410
.ما كنتَ في حاجة للقلق بشأني إلى هذا الحدّ

286
00:19:01,990 --> 00:19:04,410
.عليكَ القلق على نفسك أكثر

287
00:19:04,410 --> 00:19:05,200
.حسنٌ

288
00:19:15,380 --> 00:19:16,210
إيكوما؟

289
00:19:16,840 --> 00:19:18,380
ما الخطب؟

290
00:19:24,470 --> 00:19:26,600
.توقّف عن هذا، أنا جادّة

291
00:19:30,270 --> 00:19:32,150
.هذا مضحك للغاية

292
00:19:33,480 --> 00:19:35,650
.كلّ ذلك الضحك فتح شهيّتي

293
00:19:35,650 --> 00:19:37,280
."لدينا حساء "الدانغو

294
00:19:37,280 --> 00:19:38,940
.سآتيكِ بصحنٍ منه

295
00:19:38,940 --> 00:19:40,150
.شكرًا

296
00:19:40,150 --> 00:19:41,860
.لكنّني لستُ بحاجة لذلك

297
00:19:43,990 --> 00:19:46,080
.امنحوني بعض الدّماء فقط

298
00:19:47,240 --> 00:19:48,370
دماء؟

299
00:19:48,910 --> 00:19:50,460
.لونه أحمر

300
00:19:50,460 --> 00:19:53,420
.الشيءُ الّذي يتدفق بغزارة عن جرح أحدهم

301
00:19:53,420 --> 00:19:55,040
...لكنّكِ

302
00:19:55,040 --> 00:19:56,380
.أنا نصف جثّة

303
00:19:57,050 --> 00:19:58,960
.نصف جسدي جثّة على أي حال

304
00:20:03,680 --> 00:20:05,180
.لعلَّ هذا بسبب نزيفكَ الحاد للدماء

305
00:20:05,720 --> 00:20:07,060
.انتظرني رجاءً

306
00:20:09,180 --> 00:20:10,310
هل هذه مزحة؟

307
00:20:10,310 --> 00:20:12,690
أتريدين منا أن نصبح جثثًا أيضًا؟

308
00:20:12,690 --> 00:20:14,060
.تراجعي يا كاجيكا

309
00:20:14,060 --> 00:20:15,810
.فهي محض وحشٍ ليس إلا

310
00:20:18,690 --> 00:20:21,610
.ما باليد حيلة، فأنا جائعة

311
00:20:34,710 --> 00:20:35,790
.إنّها جثّة

312
00:20:42,090 --> 00:20:43,340
شينو-سان؟

313
00:20:46,550 --> 00:20:48,180
...انتظري، فتلك المرأة

314
00:21:01,610 --> 00:21:04,490
.إنّها حامل بطفل

315
00:21:11,040 --> 00:21:12,290
إيكوما؟

316
00:21:12,290 --> 00:21:13,540
هل أنت...؟