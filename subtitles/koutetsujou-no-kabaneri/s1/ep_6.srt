1
00:00:06,060 --> 00:00:07,060
...أنقذيني

2
00:00:09,440 --> 00:00:10,400
...أنقذيني

3
00:00:19,370 --> 00:00:20,290
.تحرّكي يا مومي

4
00:00:21,620 --> 00:00:23,250
.فقد وصل سمّوه

5
00:00:24,620 --> 00:00:25,040
.حاضر

6
00:01:07,580 --> 00:01:08,880
.إنّه قادمٌ في اتجاهنا

7
00:01:09,170 --> 00:01:10,000
.يوكينا-سان

8
00:01:10,960 --> 00:01:12,250
.سأدخُل لممر الاغاثة

9
00:01:33,150 --> 00:01:34,440
.فالتصوبوا

10
00:01:35,030 --> 00:01:36,530
.نــــار

11
00:01:55,460 --> 00:01:57,880
هل أنتَ بشريٌ أم جثّة؟

12
00:01:58,430 --> 00:01:59,680
.لا هذا ولا ذاك

13
00:02:00,140 --> 00:02:01,600
.إنّني نصف جثّة

14
00:03:36,820 --> 00:03:37,400
!مومي

15
00:03:39,360 --> 00:03:40,400
هل استعدتِ وعيكْ؟

16
00:03:41,070 --> 00:03:41,900
...إيكوما

17
00:03:42,780 --> 00:03:43,740
هل أنتَ بخير؟

18
00:03:44,030 --> 00:03:45,070
.نوعًا ما

19
00:03:45,530 --> 00:03:46,660
.لقد كنتُ محظوظًا

20
00:03:49,540 --> 00:03:51,120
هل يُؤلمكِ؟

21
00:03:52,620 --> 00:03:53,420
...أجل

22
00:03:54,580 --> 00:03:55,540
.انتظري

23
00:04:00,630 --> 00:04:01,510
.سحقًا

24
00:04:02,170 --> 00:04:04,260
لماذا آل بنا الحال هكذا؟

25
00:04:06,180 --> 00:04:08,810
تريد القول أنَّ فشلنا كان بسببي، أليس كذلك؟

26
00:04:09,310 --> 00:04:10,560
.هذا صحيح

27
00:04:11,310 --> 00:04:13,350
.فبسببكِ تدمّرتْ خُطّتي

28
00:04:14,770 --> 00:04:16,690
.ومع ذلك، فقد كنتُ مغفّلاً أيضًا

29
00:04:17,440 --> 00:04:18,820
،فبعدَ أن رأيتُكِ تسقُطين

30
00:04:19,070 --> 00:04:21,440
.تركتُ مقبض التحكّم بالرافعة وهرعتُ إليكِ

31
00:04:22,820 --> 00:04:24,450
.كلانا غبيّان

32
00:04:24,950 --> 00:04:26,370
.أنا متأكدٌ من أنَّ الجميع قد ضاقوا ذرعًا بنا الآن

33
00:04:27,070 --> 00:04:28,910
.لهذا السبب، لا يجبُ أن نموت

34
00:04:29,240 --> 00:04:30,120
.علينا إصلاح الأمر

35
00:04:32,450 --> 00:04:34,500
.سنخرج من هنا بأي ثمنٍ يا مومي

36
00:04:38,130 --> 00:04:40,340
ألا يمكننا حقًا العودة للوراء؟

37
00:04:40,960 --> 00:04:43,380
،فتجاوز هذا المكان بوجود ذلك الوحش

38
00:04:43,670 --> 00:04:45,010
.أمرٌ لا نستطيع فعلَه

39
00:04:45,470 --> 00:04:49,220
أيمكننا العودة لطريقِ جبلِ ناغي؟

40
00:04:49,560 --> 00:04:51,350
.لا يمكننا زيادة السرعة بأي شكلٍ كان

41
00:04:51,770 --> 00:04:54,770
.وإذا قام بملاحقتنا، فلن نتمكّن من الهرب

42
00:04:56,900 --> 00:04:59,980
.ولكن، الدخان الأسود في الوقتِ الرّاهن متناثر

43
00:05:00,730 --> 00:05:02,360
.وقد نتمكّن من المرور خلاله بالقوّة

44
00:05:03,320 --> 00:05:05,450
...كما أنَّ ركام البرج مرتفع إلى النصف

45
00:05:05,780 --> 00:05:09,370
.إن تحمّلنا بعض الأضرار، فقد نتمكّن من المرور

46
00:05:10,200 --> 00:05:12,540
.أنتَ محق، فهذا يستحق المراهنة عليه

47
00:05:13,120 --> 00:05:14,750
...عفوًا، ولكن

48
00:05:15,210 --> 00:05:18,420
هل تنوونَ التخلّيَ عن إيكوما ومومي-تشان؟

49
00:05:18,790 --> 00:05:19,840
.بالتأكيد

50
00:05:20,290 --> 00:05:24,590
فحسب ما سمعت، تلك الفتاة الجثّة ذهبت لقتلهم
.دون تفكير

51
00:05:25,130 --> 00:05:28,050
.وذلك أثار استياء الدّخان الأسود ولفتَ انتباهه إلينا

52
00:05:28,760 --> 00:05:32,010
.ناهيكم عن تركِ ذلك الشاب لمهمّته في منتصفها

53
00:05:32,350 --> 00:05:33,600
.يستحقان ما سيجري لهما

54
00:05:33,810 --> 00:05:35,980
.أنتم تبالغون في الأمر

55
00:05:37,020 --> 00:05:38,060
.هذا صحيح

56
00:05:38,690 --> 00:05:41,650
.لا يمكتنا تجاهل التهديد الآتي من الدّخان الأسود

57
00:05:42,480 --> 00:05:45,320
.لا شكَّ في وجود طريقة أفضل

58
00:05:51,370 --> 00:05:52,240
.سحقًا

59
00:05:53,870 --> 00:05:55,450
.هذا يكفي، دعني وشأني

60
00:05:55,790 --> 00:05:57,790
.فالأقوى هو من ينجو في النّهاية

61
00:05:58,290 --> 00:06:00,000
.ومصير الضعيف هو الموت ليس إلاَ

62
00:06:00,790 --> 00:06:02,090
ما الّذي تقولينه؟

63
00:06:02,630 --> 00:06:05,010
إذًا، متى يمكن للضعيف أن يغدوَ قويًا؟

64
00:06:10,720 --> 00:06:12,050
.قلت لكَ هذا يكفي

65
00:06:12,850 --> 00:06:14,260
.فلستَ مجبرًا على مساعدتي

66
00:06:14,810 --> 00:06:17,060
.فأنا لا أريدُ أن يتمَّ إنقاذي من طرفك

67
00:06:18,600 --> 00:06:21,230
إذًا، أتقولين أن لا بأس ببقائكِ هكذا؟

68
00:06:23,070 --> 00:06:24,690
.لم أقل شيئًا كهذا

69
00:06:25,570 --> 00:06:27,570
.أقول أنّني سأتدبّر أمري بنفسي

70
00:06:28,740 --> 00:06:31,950
...هذا فقط لأنّني أخطأتُ التقدير سابقًا

71
00:06:34,620 --> 00:06:36,450
،سأُخرجُ نفسي من تحتِ هذا الشيء فورًا

72
00:06:37,330 --> 00:06:38,580
.وأطيح بالجثث

73
00:06:39,500 --> 00:06:41,880
.لم يسبق لي وأن تعرّضتُ للعض من طرفِ جثّة

74
00:06:43,090 --> 00:06:45,670
...أنا لستُ ضعيفة

75
00:06:53,850 --> 00:06:54,600
.سحقًا

76
00:06:56,270 --> 00:06:57,470
ما الّذي تقولينه؟

77
00:06:57,720 --> 00:06:59,310
.من الواضح أنّكِ ضعيفة الآن

78
00:06:59,690 --> 00:07:01,560
.فأنتِ عالقة بالكامل تحت هذه الصخور

79
00:07:01,940 --> 00:07:03,110
.أنا لستُ ضعيفة

80
00:07:03,360 --> 00:07:05,150
.بل أنتِ ضعيفة -
.لستُ كذلك -

81
00:07:08,360 --> 00:07:09,400
.لا تفعل -
!مومي -

82
00:07:09,820 --> 00:07:10,700
...سأصبحُ جثّة

83
00:07:11,110 --> 00:07:12,820
مستحيل... هل انتهى أمري؟

84
00:07:13,450 --> 00:07:14,780
.لكنّني لستُ ضعيفةً أبدًا

85
00:07:14,780 --> 00:07:16,870
.أنا لا أريد أن أصبحَ جثّة

86
00:07:25,630 --> 00:07:27,000
.أتيتُ ببعض الدّم معي

87
00:07:27,960 --> 00:07:29,590
.لحسنِ الحظ أنّني لم أُسقطهُ سابقًا

88
00:07:36,010 --> 00:07:37,850
.هدّئي من روعك

89
00:07:38,720 --> 00:07:40,600
.فأنتِ جائعة قليلاً ليسَ إلا

90
00:07:41,560 --> 00:07:44,520
عندما نجوع، فنحن نتحوّل لجثث في النّهاية، أليس كذلك؟

91
00:07:46,480 --> 00:07:47,520
.لا أدري

92
00:07:48,780 --> 00:07:49,490
...ولكن

93
00:07:50,860 --> 00:07:54,160
.جميع رفاقي تحوّلوا إلى جثث

94
00:08:13,930 --> 00:08:15,970
.سأخرجكِ من تحت الأنقاض لاحقًا

95
00:08:16,220 --> 00:08:17,850
.سأهتم بأمر الجثث أولاً

96
00:08:17,970 --> 00:08:19,930
.توقّف، فأعدادهم هائلة

97
00:08:20,350 --> 00:08:22,140
...لن تتمكّن من هزيمتهم وحـ -
.اصمتي -

98
00:08:29,730 --> 00:08:31,280
...بشأنِ ما قُلتِه سابقًا

99
00:08:32,240 --> 00:08:34,740
.نحنُ بالفعل ضُعفاء يا مومي

100
00:08:37,120 --> 00:08:37,530
...ولكن

101
00:08:38,950 --> 00:08:41,500
.هذا لا يعني أنَّ علينا ألا نُقاوم

102
00:08:46,630 --> 00:08:48,750
.أنا هنا، هلمّوا إلي

103
00:09:04,520 --> 00:09:05,270
.أهربوا

104
00:09:05,270 --> 00:09:07,980
.إنّهم آتونَ إلى هنا -
.توجّهوا بسرعة إلى القطار المدرّع -

105
00:09:26,580 --> 00:09:29,040
إذًا، فقد تعرّضتُم للعضّ بالفعل، أليسَ كذلك؟

106
00:09:30,040 --> 00:09:31,380
ماذا أنتم فاعلون؟

107
00:09:31,420 --> 00:09:33,420
،مادام أحدكم قد تحوّل إلى جثّة

108
00:09:33,590 --> 00:09:36,220
.فهذا معناه أنَّ جميعَكم جثث

109
00:09:36,220 --> 00:09:37,050
.توقّف

110
00:09:41,560 --> 00:09:45,310
...فالتخرجي... أيّتها الجثّة

111
00:09:45,930 --> 00:09:47,770
.فالتخرُجي

112
00:10:00,490 --> 00:10:01,280
أمي؟

113
00:10:04,450 --> 00:10:05,290
...أمي

114
00:10:06,120 --> 00:10:08,250
...كلا... كلا

115
00:10:08,420 --> 00:10:10,380
.كــــلا

116
00:10:58,050 --> 00:10:59,800
.هاهي ذي، إنّها هنا

117
00:11:06,010 --> 00:11:07,270
.جيّد، واصلوا السحب

118
00:11:16,400 --> 00:11:18,280
ماذا؟ أينَ أنا؟

119
00:11:18,860 --> 00:11:21,660
.إنّه نفقٌ تحت الأرض
.أنا سعيدٌ لأنّنا وجدناكِ

120
00:11:21,860 --> 00:11:23,370
.سوفَ نعالجُ جراحكِ على الفور

121
00:11:26,950 --> 00:11:27,660
وماذا عنه؟

122
00:11:28,120 --> 00:11:30,290
أتقصدين إيكوما؟
...نحن مازلنا لم

123
00:11:31,750 --> 00:11:32,250
.أنتِ

124
00:11:39,170 --> 00:11:40,420
ما كلُّ هذا؟

125
00:11:40,470 --> 00:11:42,180
أيُعقل أنَّ إيكوما هو من فعل ذلك؟

126
00:11:42,680 --> 00:11:44,300
أ-أنتَ تمزح، صحيح؟

127
00:11:44,970 --> 00:11:48,060
.كلا، فقلوبهم مثقوبة بطلقة واحدة

128
00:11:48,850 --> 00:11:50,810
.وذلك أمرٌ مستحيل من دون الرّصاص النّفاث

129
00:12:01,450 --> 00:12:02,280
...إيكوما

130
00:12:05,160 --> 00:12:06,870
...مهلاً، إيكوما

131
00:12:07,330 --> 00:12:08,290
...هذا مؤلم

132
00:12:10,370 --> 00:12:11,410
...كفّي عن أرجَحَتي

133
00:12:12,410 --> 00:12:13,040
...سحقًا

134
00:12:13,290 --> 00:12:15,960
.أولئكَ الأوغاد قاموا بعضي في المعدة

135
00:12:20,460 --> 00:12:21,420
لماذا؟

136
00:12:22,510 --> 00:12:23,930
...بالرغم من كوننا ضعفاء

137
00:12:24,800 --> 00:12:26,640
.إلا أنّني وإياكَ لازلنا أحياءً

138
00:12:27,890 --> 00:12:29,180
...بالرغم من أنّنا لسنا أقوياء

139
00:12:29,430 --> 00:12:30,720
ما الّذي تتحدّثين عنه؟

140
00:12:31,730 --> 00:12:34,350
...أنا أتألم ولهذا، كفّي عن قول أشياءَ معقّدة

141
00:12:35,020 --> 00:12:35,810
...سحقًا

142
00:12:37,360 --> 00:12:38,360
أيمكنكَ الحركة؟

143
00:12:39,690 --> 00:12:40,400
...أجل

144
00:12:43,570 --> 00:12:45,490
.الوضع خطير هنا
.علينا العودة

145
00:12:58,080 --> 00:12:59,040
ما هذا الشيء؟

146
00:12:59,250 --> 00:13:00,500
...مُستعمرةٌ موحّدة

147
00:13:01,250 --> 00:13:02,170
أوتعرفينَ هذا الشيء؟

148
00:13:02,960 --> 00:13:04,840
.لنؤجل الحديث لوقت لاحق
.فهذا الشيءُ قادم

149
00:13:16,730 --> 00:13:18,270
.أسرعوا، أسروعوا

150
00:13:28,780 --> 00:13:30,280
ما الّذي يفعله؟

151
00:13:30,830 --> 00:13:32,950
.إنّه يحاول امتصاص أجساد رفاقه

152
00:13:33,370 --> 00:13:34,290
الجثث؟

153
00:13:34,580 --> 00:13:35,120
.بلى

154
00:13:35,620 --> 00:13:37,290
.لقد سمعتُ بأنّهم جشعون

155
00:13:37,920 --> 00:13:41,670
.فهم يمتصون كلَّ شيءٍ سواءٌ كانوا بشرًا أو جثثا

156
00:13:42,710 --> 00:13:44,260
.دعوتِ هذا الشيءَ بالمستعمرة الموحّدة

157
00:13:45,170 --> 00:13:46,970
.أنا أراه للمرّة الأولى أيضًا

158
00:13:47,340 --> 00:13:48,390
أيمكننا التغلّب عليه؟

159
00:13:49,140 --> 00:13:53,890
.لهذا السبب أتينا بهذا المدفع من النوع 48

160
00:13:55,020 --> 00:13:55,980
...يا رفاق

161
00:13:57,350 --> 00:13:58,060
.أنا آسف

162
00:13:58,730 --> 00:14:01,190
،فبسببنا آلَ الوضع بنا إلى هذه الحال

163
00:14:01,650 --> 00:14:02,520
.ورغم ذلك أتيتم إلينا

164
00:14:02,940 --> 00:14:05,320
.أنتما لستما سوى إضافة زائدة

165
00:14:06,280 --> 00:14:09,780
.فقد صادفَ وأن أتينا إلى مكانكما لأنني تذكرت وجود هذا الشيء هناك

166
00:14:10,570 --> 00:14:12,660
.لذلك، يمكنكما ردّ الجميل بالعمل أيضًا

167
00:14:13,830 --> 00:14:14,700
.لقد فهمت

168
00:14:24,840 --> 00:14:26,510
ضربُ القلب مباشرة؟

169
00:14:26,880 --> 00:14:27,470
.أجل

170
00:14:27,800 --> 00:14:30,590
.إنّها الطريقة الوحيدة للتغلّب على المستعمرة الموحّدة

171
00:14:31,680 --> 00:14:35,180
.بداخله توجد جثّة واحدةٌ تُمثّل القلب

172
00:14:35,560 --> 00:14:36,310
...إن استطعنا

173
00:14:36,810 --> 00:14:38,180
،بذلك المدفع

174
00:14:38,230 --> 00:14:39,190
.يمكننا ثقبه

175
00:14:39,770 --> 00:14:41,650
.كلا، فذلك مستحيل

176
00:14:42,230 --> 00:14:44,270
.فالقلبُ محجوب بعدد كبير من الجثث

177
00:14:44,770 --> 00:14:46,480
ماذا سنفعل إذًا؟

178
00:14:47,110 --> 00:14:48,530
،إن ضربناه بالمدفع

179
00:14:48,780 --> 00:14:51,280
،فسيتناثر جسده
.ويُكشَفُ قلبُه

180
00:14:51,660 --> 00:14:53,030
.وعندها نضرب ضربتنا القاضية

181
00:15:03,210 --> 00:15:04,250
.هذا مفهوم

182
00:15:04,880 --> 00:15:06,550
.سنتولّى ما تبقى بأنفسنا

183
00:15:07,090 --> 00:15:09,550
.أما أنتِ يا مومي-سان، فابقيْ هنا ودعي جسدكِ يرتاح

184
00:15:10,260 --> 00:15:12,680
.أنا من ستضربُ قلبه

185
00:15:14,220 --> 00:15:15,260
هل ستكونين بخير؟

186
00:15:16,010 --> 00:15:17,640
.أنا مرتاحة بما فيه الكفاية

187
00:15:18,020 --> 00:15:19,850
.وليس هناك ما يدعوكم للقلق

188
00:15:20,600 --> 00:15:22,350
.سأردّ لكم الجميل بالعمل

189
00:15:25,360 --> 00:15:26,190
.أحسنت عملاً

190
00:15:26,780 --> 00:15:28,150
...هذا مؤلم

191
00:15:38,750 --> 00:15:39,540
.أنا آسفة

192
00:15:41,330 --> 00:15:44,210
.آسفةٌ لأنّني قلتُ بأنَّ تارو محظوظ لأنه مات

193
00:15:47,210 --> 00:15:49,590
.حسنٌ، أنا في طريقي للإطاحة بذلك الشيء الضخم

194
00:15:50,840 --> 00:15:52,590
أيُمكنكِ فعلُ شيءٍ كهذا؟

195
00:15:54,140 --> 00:15:55,930
.دعوا هذا الأمر لحارستكم

196
00:16:13,320 --> 00:16:15,070
.هاقد أتى، وهو أضخم مما كان عليه سابقًا

197
00:16:15,870 --> 00:16:16,870
.سأنطلق

198
00:16:26,420 --> 00:16:28,130
تاكومي، هل المدفع جاهز؟

199
00:16:28,420 --> 00:16:30,340
.نحن نقوم بتوصيله بالمرجَل الآن

200
00:16:30,510 --> 00:16:31,880
.باشر الأمرَ يا سوزوكي-سان

201
00:16:32,090 --> 00:16:32,970
.حسنٌ

202
00:16:34,590 --> 00:16:35,390
.انتهيت

203
00:16:35,640 --> 00:16:36,850
.سأقوم بتدويره

204
00:16:43,810 --> 00:16:44,940
.تماسكي

205
00:16:47,310 --> 00:16:50,070
.أيها البدين، احرص على الإطلاق في اللحظة الأخيرة

206
00:16:50,190 --> 00:16:52,030
ماذا؟ في اللّحظة الأخيرة؟

207
00:16:52,240 --> 00:16:53,030
.هاقد أتى

208
00:16:57,740 --> 00:16:58,830
...ليس بعد

209
00:17:00,950 --> 00:17:01,750
...ليس بعد

210
00:17:12,800 --> 00:17:14,010
.لقد تسرّعت

211
00:17:14,010 --> 00:17:16,510
.ما باليد حيلة، فهذه المرّة الأولى لي مع هذا الشيء

212
00:17:22,680 --> 00:17:24,350
.إنّهم الجثث -
.فالنحمي المدفع -

213
00:17:27,810 --> 00:17:29,310
.سأستخدم السيفَ الّذيَ صنعتَه

214
00:17:29,860 --> 00:17:32,070
.إن لقيتَ حتفكَ فلا تُلقِ باللّوم على السيف

215
00:17:32,940 --> 00:17:33,900
.كم هذا مضحك

216
00:17:36,110 --> 00:17:37,490
.نحن سنتقدّم

217
00:17:59,390 --> 00:18:00,300
.سحقًا

218
00:18:00,600 --> 00:18:01,640
.أيامي-ساما

219
00:18:01,850 --> 00:18:04,640
.زيدوا من السرعة من فضلكم، فذلك الشيءُ سيُدرِكنا

220
00:18:04,930 --> 00:18:05,850
.يوكينا-سان

221
00:18:06,430 --> 00:18:08,600
.سأحرّر الحدّ الأقصى من الضغط

222
00:18:17,900 --> 00:18:19,030
!الضغط لا يزداد؟

223
00:18:22,410 --> 00:18:23,990
سوكاري، أيمكنك سماعي؟

224
00:18:24,410 --> 00:18:25,290
ما الأمر؟

225
00:18:25,500 --> 00:18:27,330
،شيءٌ ما يُعيق محور نقل الحركة

226
00:18:27,330 --> 00:18:28,670
.وهو ما يمنع الضغط من الازدياد

227
00:18:28,670 --> 00:18:29,620
.اذهب لإزالته

228
00:18:29,670 --> 00:18:31,130
...ماذا؟ لكنَّ ذلك

229
00:18:31,750 --> 00:18:34,050
أليس هو الجانب الآخر من قضيبِ الرّبط؟

230
00:18:34,380 --> 00:18:35,380
.هذا صحيح

231
00:18:36,010 --> 00:18:38,220
.إن لمستَه ولو برفق، فستُقطع ذراعك

232
00:18:38,380 --> 00:18:40,220
.توخّ الحذر -
ماذا؟ -

233
00:18:46,810 --> 00:18:48,270
...هذا ليس يومَ سعدي

234
00:18:48,890 --> 00:18:51,600
.المدفع أصبح جاهزًا -
.حسنٌ -

235
00:18:55,020 --> 00:18:57,320
.أنا أعتمد عليكَ هذه المرّة أيها البدين

236
00:18:57,320 --> 00:18:58,820
.أعرف هذا

237
00:19:06,120 --> 00:19:07,330
.أطلق النار يا تاكومي

238
00:19:07,620 --> 00:19:08,660
.أسرع

239
00:19:08,960 --> 00:19:10,120
...ليس بعد

240
00:19:30,230 --> 00:19:31,310
.أزلتُ العائق

241
00:19:31,640 --> 00:19:32,980
.عملٌ جيدٌ يا سوكاري

242
00:19:41,200 --> 00:19:42,160
.الآن

243
00:20:06,760 --> 00:20:07,560
هل نجحَت؟

244
00:20:17,940 --> 00:20:18,690
!مومي

245
00:20:23,860 --> 00:20:25,280
.إلى الدّاخلِ بسرعة

246
00:20:32,370 --> 00:20:34,000
.نحن نسير بسرعة كبيرة

247
00:20:35,920 --> 00:20:36,790
.يا رفاق

248
00:20:37,090 --> 00:20:39,210
.توجهوا جميعًا نحوَ اليمين من فضلكم

249
00:20:39,500 --> 00:20:41,300
.فعلى هذه الحال، سنخرج عن السكّة

250
00:20:44,550 --> 00:20:46,180
.ادفعـــوا

251
00:20:48,930 --> 00:20:49,930
.قاتلوا