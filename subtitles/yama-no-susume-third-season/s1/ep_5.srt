1
00:01:32,000 --> 00:01:33,980
إنه يوم أحد مُشمس

2
00:01:34,470 --> 00:01:39,990
والد هيناتا يوصلنا بسيّارته إلى غونما
في طريقه إلى العمل

3
00:01:40,200 --> 00:01:42,720
عمّاذا ستكتب اليوم؟

4
00:01:42,720 --> 00:01:45,500
سأكتب مقالةً عن يامادا نوبورو-سان

5
00:01:45,500 --> 00:01:47,230
يامادا-سان؟

6
00:01:47,230 --> 00:01:50,630
،إنه أحد أعظم متسلّقي الجبال في غونما

7
00:01:50,630 --> 00:01:53,330
غزا عدداً من الجبال التي يبلغ ارتفاعها 8.000 متراً

8
00:01:53,330 --> 00:01:54,260
!مذهل

9
00:01:54,730 --> 00:01:56,760
هل يمكننا قراءة الكتاب عندما ينتهي؟

10
00:01:57,000 --> 00:01:59,820
أتعتقد أننا سنتمكّن من مشاهدة جبل تانيغاوا من بعيد؟

11
00:01:59,820 --> 00:02:02,230
سننحرف عن الطريق السريع قريباً

12
00:02:02,230 --> 00:02:03,670
لا أعتقد سترينه

13
00:02:05,430 --> 00:02:10,600
توجّهنا إلى جبل تانيغاوا، وهو جبل له
...مكانة خاصّة في قلوبنا

14
00:02:10,600 --> 00:02:12,860
أو بالأحرى، قلعة

15
00:02:13,530 --> 00:02:18,520
قلعة لوكهارت، حديقة نموذجيّة من الحجر في غونما

16
00:02:21,940 --> 00:02:26,200
لم تستطع كايدي-سان الذهاب معنا
،لتدرس مع يوكا-سان

17
00:02:26,450 --> 00:02:29,380
،لكن هونوكا-تشان، التي تعيش في غونما
انضمّت إلينا

18
00:02:33,860 --> 00:02:35,710
!هونوكا-تشان

19
00:02:44,240 --> 00:02:46,540
حسناً، سأعود إليكن في المساء

20
00:02:46,540 --> 00:02:47,870
!شكراً

21
00:02:50,200 --> 00:02:51,770
هل انتظرتِ طويلاً؟

22
00:02:51,770 --> 00:02:53,200
كلّا

23
00:02:53,570 --> 00:02:55,360
وصلتُ إلى هنا للتو

24
00:02:55,360 --> 00:02:56,740
هل أتيتِ بحافلة؟

25
00:02:56,740 --> 00:02:58,240
...لا، أوني

26
00:03:00,940 --> 00:03:03,060
أوصلني أخي بسيّارة

27
00:03:03,060 --> 00:03:03,990
هيّا بنا

28
00:03:04,230 --> 00:03:05,860
نعم، هيّا بنا

29
00:03:05,860 --> 00:03:09,000
لطالما أردتُ زيارة قلعة لوكهارت ولو لمرّة

30
00:03:09,180 --> 00:03:11,550
حدّثتني كوكونا-تشان عنها

31
00:03:11,550 --> 00:03:13,390
قالت أنّه يوجد مكان مذهل هنا

32
00:03:13,390 --> 00:03:18,050
نقلوا هذه القلعة مباشرة من اسكتلندا

33
00:03:18,970 --> 00:03:22,490
أعلم عن هذا المكان، لكن لم أزره من قبل

34
00:03:22,910 --> 00:03:24,260
أنا متحمّسة أيضاً

35
00:03:26,260 --> 00:03:27,550
!قلعة

36
00:03:27,550 --> 00:03:29,170
أتعتقدن أننا سنرى أميرة؟

37
00:03:29,170 --> 00:03:31,020
بالطبع لا

38
00:03:34,300 --> 00:03:35,190
!ضفدع

39
00:03:35,520 --> 00:03:37,160
!إنه ظريف جداً

40
00:03:38,470 --> 00:03:42,070
يوجد فرس نهر وسنجاب وأسد أيضاً

41
00:03:44,160 --> 00:03:45,950
لنذهب إلى هناك

42
00:03:46,820 --> 00:03:48,700
حجر القوّة؟

43
00:03:48,900 --> 00:03:53,920
يبدو أنّه يجعلك أكثر نضجاً عاطفياً
ويحافظ على جدّيتك

44
00:03:53,920 --> 00:03:55,590
مكتوب أنه يُلمَس مع شخص آخر

45
00:03:55,590 --> 00:03:58,340
ألا يُفترض أن نفعل هذا مع شريك حياتنا؟

46
00:03:59,310 --> 00:04:01,910
أشعر وكأنني أصبحتُ أكثر نضجاً عاطفياً

47
00:04:01,910 --> 00:04:02,970
هل أنتِ متأكّدة؟

48
00:04:02,970 --> 00:04:05,380
ألا تشعرين بذلك يا أوي-سان؟

49
00:04:05,950 --> 00:04:08,050
...على ذكرِ كلامكِ

50
00:04:08,050 --> 00:04:12,980
...أشعر وكأنني أصبحتُ كذلك، أو ربّما لا

51
00:04:13,480 --> 00:04:15,960
!النجدة، أوي

52
00:04:15,960 --> 00:04:18,730
ماذا فعلتُ لأستحق هذا؟

53
00:04:19,350 --> 00:04:22,240
!لا، النجدة

54
00:04:19,690 --> 00:04:22,240
لنترك هيناتا-سان ونذهب

55
00:04:22,720 --> 00:04:24,880
لنتناول الغداء قبل أن نصعد للأعلى

56
00:04:24,880 --> 00:04:27,160
نعم، أنا أتضوّر جوعاً

57
00:04:27,650 --> 00:04:29,820
!يبدو هذا شهيّاً

58
00:04:29,820 --> 00:04:31,540
!حان وقت الأكل

59
00:04:32,000 --> 00:04:33,790
يا له من كاري فاخر

60
00:04:33,790 --> 00:04:35,460
إنه شهيّ

61
00:04:35,460 --> 00:04:36,590
!تذكّرت

62
00:04:41,830 --> 00:04:45,220
ربحَ أبي هذه في لعبة بنجو وأعطاني إيّاها

63
00:04:47,000 --> 00:04:47,740
ماذا؟

64
00:04:47,740 --> 00:04:49,930
لا يوجد شيء عليها

65
00:04:51,180 --> 00:04:52,520
هذا غريب

66
00:04:52,520 --> 00:04:57,020
ستظهر الصّورة إذا انتظرتِ قليلاً

67
00:04:57,020 --> 00:04:58,020
حقّاً؟

68
00:05:01,250 --> 00:05:04,590
في الواقع، اشتريتُ كاميرا أيضاً

69
00:05:05,600 --> 00:05:07,700
هلّا التقطتُ صورة لكُن أنتن الثلاثة؟

70
00:05:07,700 --> 00:05:08,430
بالتأكيد

71
00:05:08,430 --> 00:05:09,560
!حسناً

72
00:05:09,560 --> 00:05:11,040
ها نحن ذا إذاً

73
00:05:11,240 --> 00:05:13,210
ابتسمن

74
00:05:16,360 --> 00:05:17,930
كيف بدَتْ؟

75
00:05:17,930 --> 00:05:19,340
دعيني أرى

76
00:05:19,340 --> 00:05:20,920
إنها كاميرا فيلم

77
00:05:20,920 --> 00:05:23,070
لا يمكننا رؤيتها مباشرة

78
00:05:23,070 --> 00:05:24,050
فيلم؟

79
00:05:24,660 --> 00:05:26,370
،بخلاف الكاميرا الرقميّة

80
00:05:26,370 --> 00:05:30,300
لا يمكنكِ أن تعرفي إذا التقطتِ صورة جيّدة
حتّى يتمّ تحميض الصورة

81
00:05:30,680 --> 00:05:33,060
ماذا؟! هذا مزعج

82
00:05:33,060 --> 00:05:34,040
لا

83
00:05:34,040 --> 00:05:36,340
هذا ما يجعلها أكثر متعة

84
00:05:36,710 --> 00:05:39,190
،ويمكنكِ التقاط الكثير من الصور

85
00:05:39,190 --> 00:05:41,470
فتُصبح كل صورة ذات قيمة أكبر

86
00:05:41,900 --> 00:05:42,830
نعم

87
00:05:42,830 --> 00:05:46,570
لنلتقط كثيراً من الصور التذكارية اليوم

88
00:05:46,750 --> 00:05:47,750
!حسناً

89
00:05:47,750 --> 00:05:49,200
...المعذرة

90
00:05:49,470 --> 00:05:51,330
!نعم

91
00:05:56,040 --> 00:05:58,370
توجد قلوب في كلّ مكان

92
00:05:58,580 --> 00:06:00,380
لأن اسمه هو "لوكهارت"؟

93
00:06:00,550 --> 00:06:02,590
أهكذا هو الأمر إذاً؟

94
00:06:02,590 --> 00:06:04,210
لا أعرف بصراحة

95
00:06:09,280 --> 00:06:10,890
!هنا

96
00:06:11,040 --> 00:06:13,770
!اصعدي إلى هنا يا أوي

97
00:06:14,350 --> 00:06:16,140
!مستحيل

98
00:06:41,920 --> 00:06:44,080
!إنها قلعة حقيقيّة

99
00:06:44,470 --> 00:06:45,670
مذهل

100
00:06:45,860 --> 00:06:47,470
!أميرة

101
00:06:47,470 --> 00:06:49,430
—قلتُ لكِ من المستحيل أن يكون هناك

102
00:06:49,430 --> 00:06:50,940
!هناك

103
00:06:50,940 --> 00:06:52,440
!حسناء

104
00:06:53,250 --> 00:06:55,310
ما-ما هذا؟

105
00:06:55,310 --> 00:06:56,970
!"كوني أميرة"

106
00:06:57,150 --> 00:06:58,080
!لنفعلها

107
00:06:58,080 --> 00:06:58,600
!حسناً

108
00:07:00,140 --> 00:07:01,020
هيّا، لنذهب

109
00:07:01,020 --> 00:07:03,680
!مـ-مهلاً

110
00:07:04,730 --> 00:07:06,360
هيّا بنا يا هونوكا-سان

111
00:07:11,010 --> 00:07:13,010
!مفاجأة

112
00:07:15,720 --> 00:07:17,370
تبّاً

113
00:07:19,200 --> 00:07:20,870
هذا أشبه بحلم

114
00:07:24,660 --> 00:07:27,020
حسناً، لنلتقط بعضاً من الصور

115
00:07:46,860 --> 00:07:49,650
اقتربا من بعضكما

116
00:07:49,970 --> 00:07:51,590
هـ-هكذا؟

117
00:07:51,590 --> 00:07:53,150
!أقرب

118
00:07:54,270 --> 00:07:56,040
حسناً، ابتسما

119
00:07:58,780 --> 00:08:00,250
المكان مظلم جداً

120
00:08:00,250 --> 00:08:02,540
أليس عليك استخدام الوميض؟

121
00:08:02,540 --> 00:08:05,310
لدى هذه الكاميرا عدسات ساطعة

122
00:08:05,310 --> 00:08:07,160
العدد البؤري لفتحة عدستها
القصوى هو ف/2

123
00:08:07,160 --> 00:08:08,420
ف/2؟

124
00:08:08,710 --> 00:08:12,550
يمكن استخدام سرعة غالق عالية جداً
حتّى وسط هذا الظلام

125
00:08:15,340 --> 00:08:18,430
،تُحفَظ بصيغتي جيه.ب.ي.ج وخام

126
00:08:18,430 --> 00:08:21,310
يمكنك تعديل التعريض الضوئي والتوازن
اللوني لاحقاً أيضاً

127
00:08:27,690 --> 00:08:29,440
!إنها جميلة للغاية

128
00:08:29,440 --> 00:08:31,850
،لا ألتقط كثيراً من الصور للناس

129
00:08:31,850 --> 00:08:34,200
لكن هذا ممتع جداً حقاً

130
00:08:34,520 --> 00:08:37,700
حسناً، سألتقط صورة لكِ الآن

131
00:08:38,430 --> 00:08:39,640
لا أريد

132
00:08:39,640 --> 00:08:42,420
هيّا، لا تقولي ذلك

133
00:08:42,420 --> 00:08:44,960
نادراً ما تحصل الفتاة على فرصة لتصبح أميرة

134
00:08:47,130 --> 00:08:49,870
!هونوكا-تشان، ابتسمي

135
00:08:49,870 --> 00:08:54,470
هونوكا-سان، هل هناك خدعة وراء التقاط
صور لشخص؟

136
00:08:54,470 --> 00:08:55,870
خدعة؟

137
00:08:56,640 --> 00:09:01,970
أعتقد أنه كي تلتقطي صورة طبيعيّة فعليكِ
التقاطها قبل أن يتوتّر الشخص

138
00:09:02,200 --> 00:09:04,530
فهمت

139
00:09:05,690 --> 00:09:06,990
!طبق طائر

140
00:09:09,790 --> 00:09:12,030
...لا أرى طبقاً طائراً

141
00:09:14,330 --> 00:09:16,280
التقطتُ تعبيراً جيّداً لكِ

142
00:09:18,060 --> 00:09:19,410
خدعتِني

143
00:09:19,410 --> 00:09:21,130
طبق طائر؟ أين؟

144
00:09:21,130 --> 00:09:23,370
!عليّ أن ألتقط صورة

145
00:09:24,640 --> 00:09:26,440
،بغضّ النظر عن الطبق الطائر

146
00:09:26,440 --> 00:09:32,430
التقطنا كثيراً من الصور واستمتعنا في يومنا
في قلعة لوكهارت

147
00:09:33,600 --> 00:09:35,200
!كان ذلك ممتعاً

148
00:09:35,200 --> 00:09:36,550
يسرّني أننا أتينا

149
00:09:36,790 --> 00:09:40,410
شكراً لإخبارنا عن هذا المكان يا كوكونا-تشان

150
00:09:40,410 --> 00:09:41,510
العفو

151
00:09:42,750 --> 00:09:44,770
ما الأمر يا هونوكا-تشان؟

152
00:09:45,430 --> 00:09:48,060
ألم يأتِ والدكِ إلى هنا بعد يا هيناتا-تشان؟

153
00:09:48,250 --> 00:09:51,670
راسلَني للتو، لذا أعتقد ينبغي أن
يكون هنا عمّا قريب

154
00:09:51,670 --> 00:09:54,870
لماذا؟

155
00:10:01,550 --> 00:10:03,740
أتيتُ يا هونوكا

156
00:10:04,660 --> 00:10:06,870
أخو هونوكا-تشان؟

157
00:10:09,890 --> 00:10:12,170
يا إلهي، إنه تافه

158
00:10:12,170 --> 00:10:14,620
شكراً على الاعتناء بهونوكا

159
00:10:14,620 --> 00:10:16,380
لـ-لا شكر على واجب

160
00:10:16,890 --> 00:10:18,990
هذه سيّارة رائعة

161
00:10:18,990 --> 00:10:19,930
هل تبيّن لكِ ذلك؟

162
00:10:19,930 --> 00:10:22,250
حصلتُ عليها للتو

163
00:10:22,250 --> 00:10:24,350
تبدو مُشاكسة، أليس كذلك؟

164
00:10:24,350 --> 00:10:26,530
لديها نِظام تعليق ممتاز أيضاً

165
00:10:26,530 --> 00:10:29,470
!هذا يكفي. اسكت

166
00:10:29,470 --> 00:10:30,810
ما الأمر يا هونوكا؟

167
00:10:30,810 --> 00:10:31,950
...عادةً ما تكونين هكذا

168
00:10:31,950 --> 00:10:35,960
"!أوني-تشوان، شكراً لمجيئك لإيصالي"

169
00:10:35,960 --> 00:10:38,070
وتحومين حولي

170
00:10:39,100 --> 00:10:40,950
!لـ-لا أتكلّم هكذا

171
00:10:41,200 --> 00:10:42,820
!توقّف يا غبيّ

172
00:10:42,820 --> 00:10:45,680
جانب مفاجئ من هونوكا-تشان

173
00:10:43,230 --> 00:10:45,680
هل أنتِ خجلانة؟

174
00:10:45,980 --> 00:10:46,950
!لستُ كذلك

175
00:10:46,950 --> 00:10:48,570
!توقّف

176
00:10:46,950 --> 00:10:48,570
أنتِ ظريفة للغاية

177
00:10:51,280 --> 00:10:53,340
حـ-حسناً، إلى اللّقاء

178
00:10:53,340 --> 00:10:54,000
نعم

179
00:10:54,000 --> 00:10:55,240
!لنتنزّه مجدداً لاحقاً

180
00:10:55,240 --> 00:10:56,750
سأرسل لك الصّور

181
00:10:56,750 --> 00:10:57,960
!سأكون في الانتظار

182
00:10:57,960 --> 00:10:58,950
اصمت

183
00:10:58,950 --> 00:11:02,090
بربّك، لا تكوني لئيمة

184
00:11:09,320 --> 00:11:12,380
استهلكتُ كلّ الفيلم

185
00:11:18,920 --> 00:11:22,870
عندما عدنا إلى المنزل، حمَّضنا الفيلم

186
00:11:23,570 --> 00:11:26,440
من الممتع مشاهدة الصّور في هاتفك
،أو في حاسوبك الشخصيّ

187
00:11:26,440 --> 00:11:30,840
لكن هناك نكهة ممتعة خاصّة في مشاهدة
صور ملموسة أيضاً

188
00:11:32,280 --> 00:11:34,620
كثير من الذكريات الممتعة

189
00:11:35,170 --> 00:11:38,410
آمل أن تقدّرها هونوكا-تشان أيضاً

190
00:11:57,330 --> 00:11:58,600
يتبع