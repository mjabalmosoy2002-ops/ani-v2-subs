1
00:00:01,660 --> 00:00:05,230
بسببه، تُوفِّي زبون

2
00:00:06,670 --> 00:00:10,940
ساساكورا ريو، على الأقلّ، مُقتنِع بأنّها غلطته

3
00:01:47,450 --> 00:01:52,840
ثمّة مقولة قديمة في حانات أمريكا

4
00:01:53,380 --> 00:01:55,810
،عندما يفكّر شخصٌ الانتحار

5
00:01:55,810 --> 00:01:59,430
فإنّه يختار واحداً من نوعين من النّاس
ليكون شريكه الأخير

6
00:01:59,430 --> 00:02:01,440
الأوّل هو الكاهن

7
00:02:01,440 --> 00:02:02,850
...والآخر هو

8
00:02:03,850 --> 00:02:05,350
السّاقي

9
00:02:05,690 --> 00:02:07,660
"أشعر برغبة في الموت"

10
00:02:07,660 --> 00:02:11,770
يأتيني الكثير من الزّبائن إلى هنا
ويخبرونني بذلك

11
00:02:12,200 --> 00:02:15,870
في العادة، أسخر من كلامهم وأتجاهلهم

12
00:02:15,870 --> 00:02:20,740
لكن الضّيف الّذي قال ذلك لريو
في ذلك الوقت كان جادّاً

13
00:02:21,230 --> 00:02:25,180
ما نوع المشروب الّذي قدّمه ساساكورا-سان له؟

14
00:02:25,180 --> 00:02:26,660
لا أدري

15
00:02:26,660 --> 00:02:31,050
ربّما شيء شبيه بالخليط الكحوليّ الأصليّ
الّذي ربح المُنافسة به

16
00:02:32,570 --> 00:02:35,460
،لكن بعدها، في اليوم المُوالي

17
00:02:35,460 --> 00:02:39,000
صعد ذلك الزّبون إلى أعلى بناء ناطح للسّحاب

18
00:02:39,000 --> 00:02:42,140
لكن لا يمكن أن تكون هذه
!غلطة ساساكورا-سان

19
00:02:45,630 --> 00:02:48,390
...كلامكِ صحيح. لكن رغم ذلك

20
00:02:48,890 --> 00:02:52,780
"ماذا لو كنتُ قد قدّمتُ مشروباً مختلفاً؟"

21
00:02:52,780 --> 00:02:55,250
هذا ما كان ليفكّر فيه أي شخص

22
00:02:56,740 --> 00:02:59,280
سينباي، ما رأيك بهذا؟

23
00:03:02,500 --> 00:03:05,160
ما هذا بالضّبط؟ متى حدث هذا؟

24
00:03:05,160 --> 00:03:07,300
كانت فكرة الرّئيس

25
00:03:07,300 --> 00:03:10,320
"لن نترك خياراً لساساكورا ريو"

26
00:03:10,320 --> 00:03:13,210
ما يعني بأنّ الرّئيس جادّ بشأن هذا

27
00:03:13,210 --> 00:03:15,710
هيغوتشي! افعليها من جديد

28
00:03:15,710 --> 00:03:18,220
ماذا؟ ألا يكفي هذا؟

29
00:03:18,220 --> 00:03:18,990
!هذا غير كافٍ

30
00:03:18,990 --> 00:03:20,180
حسناً

31
00:03:24,910 --> 00:03:29,170
يسرّني ومن النّادر أن يزورني
المالك في وقتٍ مُبكّر

32
00:03:29,170 --> 00:03:31,570
أجل، هذا ما أعتقده

33
00:03:33,300 --> 00:03:36,320
هل اتّخذت قرارك بشأن الذّهاب
إلى فندق كاردينال؟

34
00:03:36,830 --> 00:03:38,820
لا بدّ أنّك تحدّثت مع الرّئيس كوروشيما

35
00:03:38,820 --> 00:03:42,660
أجل. أمسى يطلب منّي ذلك منذ مدّة

36
00:03:43,750 --> 00:03:48,330
ماكي-كن، ما الّذي يعنيه العمل بالنّسبة لك؟

37
00:03:48,330 --> 00:03:50,080
الطّموح على ما أفترض

38
00:03:50,440 --> 00:03:54,090
الطّمع وحده يمكن أن يجعلك تحصل
على 500 مليون أو مليار ين

39
00:03:54,090 --> 00:03:57,830
الوصول إلى خمسة أو عشرة مليارات
يعتمد على طموحاتك

40
00:03:57,830 --> 00:03:59,860
لكن ماذا بعد ذلك؟

41
00:04:00,680 --> 00:04:06,090
ماكي-كن، أهمّ جزء في العمل هو
تربية الجيل المقبل

42
00:04:06,090 --> 00:04:12,110
لإزالة أي عقبات تسدّ طريق الشّباب
وإرشادهم للطّريق الصّواب

43
00:04:12,460 --> 00:04:14,860
...تربية الجيل المقبل

44
00:04:15,330 --> 00:04:22,620
يبدو أنّ الرّئيس كوروشيما يضمّ طاقمَ
فندق كاردينال الرّئيسيّ بمفرده

45
00:04:23,080 --> 00:04:26,880
أجرى بحثاً حول عملك في باريس
منذ فترة طويلة بالفعل

46
00:04:27,920 --> 00:04:32,900
لا يحاول ذلك الرّجل إجبارك على العمل
في الفندق لأنّه أنانيّ

47
00:04:32,900 --> 00:04:35,630
إنّه يفعل ذلك لأجلك

48
00:04:36,090 --> 00:04:39,330
لكن حينها، ماذا سيحدث لقاعة عدن؟

49
00:04:40,320 --> 00:04:43,140
قَبِلَتْ هذه الحانة بي عندما كنتُ
في ضائقة شديدة

50
00:04:43,140 --> 00:04:44,730
لم أسدِّد ذلك الدَّين بعد

51
00:04:45,160 --> 00:04:48,540
سأغلِق قاعة عدن

52
00:04:56,280 --> 00:05:01,180
.كنتُ أتساءل حول هذا طوال الوقت
لماذا ظلّ يتجنّب الأسئلة؟

53
00:05:02,080 --> 00:05:05,280
لا بدّ أنّه لا يريد تذكُّر الماضي

54
00:05:09,720 --> 00:05:10,540
تفضّل

55
00:05:11,220 --> 00:05:12,800
يُدعى هذا أ-1

56
00:05:13,850 --> 00:05:18,000
ابتُكِرَ لتقديمه في السُّفن الفارهة

57
00:05:18,000 --> 00:05:22,550
وهو دائماً الشّراب الأوّل المُدرَج
في أي دليل أخلاط كحوليّة

58
00:05:22,870 --> 00:05:25,200
إذاً هو خليط كحوليّ بأعلى مستوى

59
00:05:25,870 --> 00:05:29,310
مُبارك لك ترقيتك

60
00:05:29,870 --> 00:05:31,060
شكراً لك

61
00:05:31,820 --> 00:05:34,310
تمّ اختياري لأكون مُدير فرع في أمريكا الشّماليّة

62
00:05:36,810 --> 00:05:41,320
هذا لذيذ. إنّه صافٍ ومُنعِش
لكن يبقى غنيّاً بالفاكهة

63
00:05:42,350 --> 00:05:45,900
حالما أصل إلى أمريكا، لن أتمكّن
من شراب أخلاطك الكحوليّة

64
00:05:45,900 --> 00:05:47,280
سوف أفتقدها

65
00:05:48,250 --> 00:05:51,080
،زرتُ هذا المكان عدّة مرّات الآن

66
00:05:51,460 --> 00:05:54,960
لكن أشعر بأنّك لم ترني إلّا
في أسوأ حالاتي

67
00:06:01,250 --> 00:06:06,100
ساساكورا-كن، هل تعرف ما الّذي يجعل
مُوظّفاً مكتبيّاً يرغب في صعود السّلّم؟

68
00:06:06,680 --> 00:06:08,490
،حسّ المسؤوليّة والغاية

69
00:06:08,490 --> 00:06:11,020
والمديح والأجر اللّذان يتناسبان
مع ذلك العمل

70
00:06:11,020 --> 00:06:13,350
لكن هذا واضح زيادة عن اللُّزوم، أليس كذلك؟

71
00:06:13,790 --> 00:06:15,350
إنّها التّضحية

72
00:06:16,890 --> 00:06:18,610
أريد نفس المشروب ثانية

73
00:06:19,150 --> 00:06:20,370
اثنان منه

74
00:06:24,700 --> 00:06:28,870
لا يستطيع أحدٌ صعود السّلّم الوظيفيّ
من دون بعض التّضحيات

75
00:06:29,240 --> 00:06:33,360
بالطّبع، عليك أن تُكرّس وقتاً أطول
في عملك مُقارنة بالآخرين

76
00:06:33,360 --> 00:06:36,790
وأحياناً تشرب شراباً مُرّاً مع أشخاص
لا تريد أن تفعل ذلك معهم

77
00:06:37,380 --> 00:06:41,390
أحياناً، تبدأ بكره نفسك بسبب
هذا المكر والخبث الذّاتي

78
00:06:42,150 --> 00:06:49,060
لكن مع ذلك، البعض يضرّون بصحّتهم
،ويتورّطون في نِزاعات داخليّة

79
00:06:49,060 --> 00:06:51,520
إلى أن يتلاشوا قبل بلوغ أهدافهم

80
00:06:52,190 --> 00:06:53,120
تفضّل

81
00:06:54,250 --> 00:06:58,090
هاياسي-سان، ما التّضحية الّتي قدّمتها؟

82
00:06:58,520 --> 00:06:59,880
عائلتي

83
00:07:00,300 --> 00:07:03,780
وُلِدَتْ زوجتي الرّاحلة بقلبٍ ضعيف

84
00:07:04,300 --> 00:07:08,830
عندما سافرتُ إلى خارج البلاد في رحلة
عمل، مَرِضَتْ فجأة في المنزل

85
00:07:09,340 --> 00:07:11,970
ماذا كنتُ أفعل في تلك اللّحظة برأيك؟

86
00:07:12,860 --> 00:07:15,730
كنتُ في متجر أنتقي الأشياء
لحفلة عيد ميلاد

87
00:07:16,570 --> 00:07:18,950
زوجة مُوكِّلي

88
00:07:21,040 --> 00:07:23,300
لماذا يريد النّاس صعود السّلّم؟

89
00:07:23,300 --> 00:07:28,800
لأنّك إذا لم تستمرّ في الفوز، فإنّ
كلّ تلك التّضحيات ستذهب سُدى

90
00:07:29,390 --> 00:07:30,890
ليست زوجتي الرّاحلة فحسب

91
00:07:30,890 --> 00:07:35,950
كان لديّ زُملاء سينباي أكثر موهبة
واجتهاداً بكثير في العمل

92
00:07:35,950 --> 00:07:40,480
أنا مَدين لهم كذلك للاستمرار في الفوز

93
00:07:42,680 --> 00:07:46,070
كيميكو، هذا خليط كحوليّ من القمّة

94
00:07:47,640 --> 00:07:49,490
أنا مَدين لك يا عزيزتي

95
00:07:52,590 --> 00:07:55,650
أنا آسف. لم أقصد أن أروي لك
قصّة عاطفيّة سخيفة كهذه

96
00:07:55,650 --> 00:07:56,890
لا مُشكلة

97
00:07:56,890 --> 00:08:01,460
لكن يبدو هذا غريباً بالفعل. لم أروِ
هذه الرّواية لأحد من قبل

98
00:08:01,850 --> 00:08:04,960
كساقٍ، هذا شرفٌ كبيرٌ لي

99
00:08:05,460 --> 00:08:11,490
ربّما قُدِّرَ للنّاس أن يبقوا حبيسي
كافّة الحسرات الّتي تراكمَتْ معهم

100
00:08:12,120 --> 00:08:15,220
وكأنّ هناك شوكة صغيرة
مغروسة في قلبك

101
00:08:16,380 --> 00:08:17,700
هذا ما أفترضه

102
00:08:18,430 --> 00:08:22,980
.حسناً إذاً، أعتقد ينبغي أن أغادر
شكراً جزيلاً لك

103
00:08:25,800 --> 00:08:27,110
مرحباً

104
00:08:27,590 --> 00:08:28,980
مضى وقت طويل

105
00:08:28,980 --> 00:08:30,040
أجل

106
00:08:36,120 --> 00:08:37,870
كيميشيما-سان؟

107
00:08:38,280 --> 00:08:40,620
ظننتُكِ قد ذهبتِ إلى العمل
في مشفى ريفيّ

108
00:08:42,120 --> 00:08:43,960
لقد عُدت

109
00:08:44,390 --> 00:08:46,380
كانت هناك مشكلة مع عائلتي

110
00:08:46,780 --> 00:08:50,880
...في ذلك الوقت، عندما طلبتُ منك الخروج

111
00:08:50,880 --> 00:08:52,890
أنا آسف جدّاً بشأن ذلك

112
00:08:55,430 --> 00:08:59,640
تمّ تعييني في عمل في آخر لحظة

113
00:09:02,460 --> 00:09:07,650
إن لم تمانعي، هلّا سمحتِ لي
بالتّعويض لكِ؟

114
00:09:09,890 --> 00:09:11,660
سيكون ذلك من دواعي سروري

115
00:09:13,660 --> 00:09:18,310
،لكن إذا أسأت لي هذه المرّة
فسوف أضربك حتّى يُغمى عليك، مفهوم؟

116
00:09:18,310 --> 00:09:20,410
حسناً

117
00:09:48,570 --> 00:09:50,440
ماذا؟ أمريكا؟

118
00:09:50,440 --> 00:09:54,280
أجل. سأقضي حوالي خمس سنوات
هناك على الأغلب

119
00:09:54,690 --> 00:09:57,250
لماذا لم تخبرني؟

120
00:09:57,250 --> 00:09:59,790
!لم أكن أحاول إخفاء الأمر

121
00:10:02,790 --> 00:10:07,040
وبعد أن تمكنّا أخيراً من الشّرب
...معاً من جديد

122
00:10:09,270 --> 00:10:13,300
هاياسي-سان، لماذا خرجت لمقابلتي؟

123
00:10:20,980 --> 00:10:25,060
ساساكورا-كن، هل لديك حبيبة؟

124
00:10:25,410 --> 00:10:26,500
ماذا؟

125
00:10:26,500 --> 00:10:28,820
حبيبة؟

126
00:10:29,170 --> 00:10:33,570
أنا آسف. لا ينبغي أن أسأل
عن شيء خاصّ جدّاً

127
00:10:33,570 --> 00:10:39,080
في الواقع، مع الأسف، أنا واقع
في حبِّ عملي فحسب الآن

128
00:10:39,500 --> 00:10:40,790
أنا مثلك

129
00:10:43,920 --> 00:10:48,460
.يبدو أنّه اقترب وقت الإغلاق
أنا آسف لأنّني جعلتُك تتأخّر

130
00:10:55,030 --> 00:10:58,810
هاياسي-سان. ماذا حدث؟

131
00:10:58,810 --> 00:11:02,500
إن لم تمانع، هل يمكنك
الانضمام لي في حانة أخرى؟

132
00:11:07,040 --> 00:11:08,650
هذه حانة زميلي السّينباي

133
00:11:09,030 --> 00:11:11,940
لكنّها ليست حانة أصيلة

134
00:11:14,860 --> 00:11:16,320
تفضّل

135
00:11:18,850 --> 00:11:20,870
سأسافر إلى أمريكا غداً

136
00:11:20,870 --> 00:11:22,190
ماذا؟

137
00:11:22,190 --> 00:11:25,970
إذاً هل من الصّواب الشّرب
في هذا الوقت المتأخّر؟

138
00:11:25,970 --> 00:11:28,130
قد يكون هذا سبب رغبتي في الشّرب

139
00:11:28,780 --> 00:11:30,880
ثمّة شيء كان يُحيّرني مؤخّراً

140
00:11:32,880 --> 00:11:36,480
أعتقد أنت غير مُلاحَق بواسطة مُرابي القروض

141
00:11:36,480 --> 00:11:38,640
النّظرة في وجهك تقول بأنّها
مُشكلة تخصّ النّساء

142
00:11:40,640 --> 00:11:43,820
هذه الحانة صريحة جدّاً مع ضيوفها

143
00:11:44,140 --> 00:11:46,520
إنّها أشبه بمشفى ميداني

144
00:11:46,880 --> 00:11:49,050
مُشكلة تخصُّ النّساء"؟"

145
00:11:49,050 --> 00:11:50,480
لستَ مُخطِئاً

146
00:11:52,530 --> 00:11:54,470
كم أحسدك

147
00:11:55,120 --> 00:11:59,270
زبائني يُطاردون شيئاً أو يهربون
من شيء دوماً

148
00:11:59,270 --> 00:12:02,240
ليس لديهم المجال للتردُّد

149
00:12:03,100 --> 00:12:06,620
في هذه الحالة، لِمَ لا نُقرِّر بهذه؟

150
00:12:07,470 --> 00:12:12,040
في الأيّام الخوالي، كان رمي النّرد
مهارة مطلوبة للسُّقاة

151
00:12:12,040 --> 00:12:17,060
،بهذا الشّكل، تُبقي معصمك رخيّاً وتهزّ الفنجان

152
00:12:17,060 --> 00:12:19,540
كان تمريناً رائعاً لاستخدام الهزّازة

153
00:12:19,540 --> 00:12:23,570
ثمّ تتخيّل حركة النّرد في الفنجان

154
00:12:24,200 --> 00:12:29,720
هذا يساعدك أيضاً في تخيُّل كيفيّة
حركة الثّلج داخل الهزّازة

155
00:12:34,820 --> 00:12:36,660
يُدعى هذا بتكديس النّرد

156
00:12:36,660 --> 00:12:41,700
احتمالات تكديس الخمسة جميعها
هو 1 من 30

157
00:12:42,140 --> 00:12:45,950
هذه الاحتمالات تجعل الأمر يبدو
أقرب إلى حظٍّ منه إلى مهارة

158
00:12:46,240 --> 00:12:53,120
بكلّ تأكيد. لكن أتعلم يا سيّد؟ قد تحفر قبرك بيدك
بالمُراهنة على شيء احتمال نجاحه ضئيل

159
00:12:53,700 --> 00:12:57,340
لكن الحياة تكون أكثر إثارة عندما
تُراهن بشيء كبير

160
00:12:57,340 --> 00:12:59,320
هل تملك أدنى فكرة عن السّبب؟

161
00:12:59,840 --> 00:13:02,850
بدلاً من مُراوغة مُراهناتك والتحسّر
،على الأمر لاحقاً

162
00:13:02,850 --> 00:13:06,350
من السّهل تقبُّل خسارة الكثير
في رِهان ضخم

163
00:13:06,970 --> 00:13:08,590
فهمت

164
00:13:08,590 --> 00:13:10,600
من فضلك ارمِها مرّة أخرى

165
00:13:11,040 --> 00:13:12,490
هذا ما دواعي سروري

166
00:13:14,850 --> 00:13:19,150
،لكن إن لم تتكدّس النّرود الخمسة
فلن أراها من جديد

167
00:13:20,170 --> 00:13:22,370
،لكن إذا تكدّست

168
00:13:23,140 --> 00:13:26,740
،إذا تحقّقَتْ مُعجزة كهذه
فسأذهب لِلقائها

169
00:13:27,410 --> 00:13:30,340
ولو جعلني هذا أخسر التّرقية

170
00:13:38,380 --> 00:13:42,130
النّاس يتظاهرون أحياناً بالتردُّد

171
00:13:42,130 --> 00:13:43,980
مثلك تماماً يا سيّد

172
00:13:44,310 --> 00:13:45,890
يتظاهرون بالتردُّد"؟"

173
00:13:46,230 --> 00:13:49,880
الشّيء المهمّ هو التحلّي بقليل من الثِّقة

174
00:13:49,880 --> 00:13:52,570
لكن الجُبناء لا يمكنهم أن يكونوا
صادقين مع أنفسهم

175
00:13:52,940 --> 00:13:55,150
يحاولون أن يتركوا قراراتهم بين يدي الربّ

176
00:13:56,070 --> 00:13:58,020
قد تكون مُحِقّاً

177
00:13:58,020 --> 00:14:02,650
حسناً. لنرَ ما الّذي يختاره الربّ

178
00:14:03,020 --> 00:14:04,410
انتظر لحظة من فضلك

179
00:14:04,410 --> 00:14:09,090
قبل ذلك، هناك خليط كحوليّ
لطالما أردتُ تجربته

180
00:14:10,240 --> 00:14:12,410
لم أستطع شربه في حانة ساساكورا-كن

181
00:14:12,410 --> 00:14:13,510
ماذا؟

182
00:14:13,510 --> 00:14:16,920
نحن في خطوط الجبهة هنا. ماذا تريد؟

183
00:14:17,880 --> 00:14:19,300
بويلر ميكر

184
00:14:24,300 --> 00:14:28,770
بيرة وبوربون. أيمكنك تولّي الباقي؟

185
00:14:28,770 --> 00:14:29,770
أجل

186
00:14:36,330 --> 00:14:38,890
الشّيء المهمّ هو التحلّي بقليل من الثِّقة

187
00:14:49,210 --> 00:14:53,990
الويسكي لديه نسبة كحول أعلى
،ويحاول أن يطفو على السّطح

188
00:14:53,990 --> 00:14:57,330
لذا تخرج كلّ الرّغوة من البيرة

189
00:14:57,330 --> 00:15:01,960
حسناً، هكذا قد يفسّر ساقٍ مُتحاذِق الأمر

190
00:15:02,340 --> 00:15:06,190
،لكن عندما تشرب هذا الشّيء
فإنّه يغلي بداخلك وتظهر فُقاعات

191
00:15:06,190 --> 00:15:08,000
يمنحك هذا قليلاً من الثِّقة

192
00:15:08,000 --> 00:15:10,470
لهذا سُمِّي بويلر ميكر

193
00:15:19,250 --> 00:15:21,230
إنّه أشبه بمِغلاة

194
00:15:23,090 --> 00:15:25,470
...شيء آخر لطالما أردتُ تجربته

195
00:15:26,160 --> 00:15:27,110
هو هذا

196
00:15:29,200 --> 00:15:32,890
شكراً لك. أشعر وكأنّني أخرجتُ
الشّوكةَ من قلبي

197
00:15:32,890 --> 00:15:36,780
،جيّد. عندما تعلق فيك شوكة
لا ينبغي أن تنتظر لتُزيلها

198
00:15:36,780 --> 00:15:38,630
وُجِدَت الحانات لأجل ذلك

199
00:15:39,050 --> 00:15:43,490
لو كنتُ أعلم ذلك من قبل، لكانت
حياتي أسهل بكثير

200
00:15:44,000 --> 00:15:46,830
ساساكورا-كن، شكراً لك

201
00:15:46,830 --> 00:15:49,260
ماذا عن هذه؟ ألن تلقي نظرة؟

202
00:15:49,600 --> 00:15:52,760
لا. أعرف شعوري الآن

203
00:15:53,480 --> 00:15:57,140
في الواقع، ربّما كنتُ أعلم منذ البداية

204
00:15:59,500 --> 00:16:01,380
شوكة في القلب؟

205
00:16:02,270 --> 00:16:05,770
أتريد الرِّهان؟ يبدو وكأنّك تعاني من شيء

206
00:16:06,260 --> 00:16:09,280
لا أظنّني أستطيع هزيمتك يا كيتاكاتا-سان

207
00:16:09,820 --> 00:16:12,780
عندما يحين الوقت، سأقرِّر بنفسي

208
00:16:16,950 --> 00:16:20,040
ربّما لست بحاجة لتسأل الربّ
في نهاية الأمر

209
00:16:34,840 --> 00:16:37,560
تفضّلي. مشروب الرِّياح المُعاكسة

210
00:16:37,930 --> 00:16:41,810
شكراً لكِ. أردتُ تجربة هذا

211
00:16:44,120 --> 00:16:45,500
!شهيّ

212
00:16:45,830 --> 00:16:50,180
.في بدايته لذعة خفيفة ثمّ مذاق حلو
قد أدمن على هذا المشروب

213
00:16:50,180 --> 00:16:52,070
!شكراً جزيلاً لكِ

214
00:16:52,070 --> 00:16:55,320
يبدو أنّ الأمور قد هُيِّئتْ لحانة المِنضدة

215
00:16:55,740 --> 00:16:58,080
لم يُقرَّر الأمر بعد

216
00:16:58,080 --> 00:17:00,210
...ماذا؟ لكن في النّشرات

217
00:17:00,210 --> 00:17:03,960
لم يوافق ساساكورا-سان بعد

218
00:17:03,960 --> 00:17:05,960
ماذا؟ لم يُوافق؟

219
00:17:05,960 --> 00:17:07,280
كاواكامي-سان

220
00:17:07,280 --> 00:17:09,970
ا-المعذرة

221
00:17:10,490 --> 00:17:15,340
لا أعرف ما هو أكثر ما يصبّ
في صالح ساساكورا-سان

222
00:17:15,340 --> 00:17:17,620
رياح مُعاكِسة آخر على ما أعتقد

223
00:17:19,160 --> 00:17:21,530
وكأنّكِ تركضين ضدّ جهة الرّياح؟

224
00:17:22,040 --> 00:17:25,900
هل تنتظرين الرّياح حتّى تتوقّف
أم تواجهينها بشكل مباشر؟

225
00:17:25,900 --> 00:17:29,470
أو ما شابه! هل أبدو مثل ساساكورا-سان؟

226
00:17:39,100 --> 00:17:43,930
هل تخشى العمل في حانة الفندق
بسبب ما حدث؟

227
00:17:44,250 --> 00:17:47,500
لكن لم تكن تلك غلطتك

228
00:17:48,590 --> 00:17:50,810
!يجب أن أقول هذا الكلام في وجهه

229
00:18:00,550 --> 00:18:01,720
مرحباً

230
00:18:09,060 --> 00:18:10,440
مساء الخير

231
00:18:11,670 --> 00:18:13,120
لم أرك منذ وقت

232
00:18:13,710 --> 00:18:18,160
لم أرك مؤخّراً، لذا كنتُ
أتساءل عن حالكِ

233
00:18:20,160 --> 00:18:21,480
ما طلبكِ؟

234
00:18:22,950 --> 00:18:25,040
لنفترِض أنّ لديك ضيف

235
00:18:25,040 --> 00:18:26,040
ماذا؟

236
00:18:26,800 --> 00:18:29,200
ضيف مستاء جدّاً

237
00:18:30,490 --> 00:18:32,580
لدرجة أنّه يريد الموت

238
00:18:33,600 --> 00:18:40,970
لضيف كهذا، بالنّسبة لساقٍ، ما المشروب
الّذي كنتَ لترغب في تقديمه؟

239
00:18:43,090 --> 00:18:45,440
لا بدّ أنّكِ تكلّمتِ مع كيتاكاتا-سان

240
00:18:47,100 --> 00:18:48,100
أجل

241
00:18:49,540 --> 00:18:51,480
حسناً، ماذا كنتِ لتفعلين أنتِ؟

242
00:18:52,320 --> 00:18:57,950
:لو كنتُ أنا، لأعدتُه إلى رشده وقلتُ
"!كُفّ عن التصرُّف كطفل"

243
00:18:59,040 --> 00:19:00,700
مُخيف

244
00:19:01,330 --> 00:19:04,960
أقصد أنّه لا يمكنك تجاوز هذا
الأمر أبداً ما حييت

245
00:19:06,960 --> 00:19:11,500
،عندما يموت شخصٌ مُقرّبٌ منك
،وتبقى لوحدك من بعده

246
00:19:11,500 --> 00:19:13,720
فإنّك لا تنفك تلوم نفسك

247
00:19:17,010 --> 00:19:20,720
فعلتُ ذلك أيضاً. فقدتُ والِدَي في حادث

248
00:19:20,720 --> 00:19:26,120
قلتُ لنفسي، "لماذا ما زلتُ حيّة؟
"ما الفائدة من العيش؟

249
00:19:27,220 --> 00:19:29,760
ساساكورا-سان، ألا يراودك نفس الشُّعور؟

250
00:19:30,270 --> 00:19:34,600
لا يمكنك العثور على إجابة، لذا لا يمكنك
أن تُقرّر ماذا تفعل تالياً

251
00:19:34,600 --> 00:19:36,500
مثل العمل في حانتنا

252
00:19:37,540 --> 00:19:42,540
الآن، إذا كان هناك ضيف مُضطرب
،لدرجة يفكّر فيها بالانتحار

253
00:19:44,550 --> 00:19:47,080
فهذه هي الإجابة الوحيدة الّتي
أستطيع تقديمها

254
00:19:49,250 --> 00:19:51,230
يُدعى توم وجيري

255
00:19:51,230 --> 00:19:53,580
المعذرة، مثل لذلك القطّ والفأر؟

256
00:19:53,580 --> 00:19:56,600
أجل. ليس بالمعنى الحرفيّ

257
00:19:56,600 --> 00:20:01,760
يبدو لأنّه ابتُكِرَ بواسطة ساقٍ من القرن
التّاسع عشر يُدعى جيري توماس

258
00:20:05,820 --> 00:20:10,270
!ولديه حلاوة خفيفة مثل "الموس" وهو دافئ

259
00:20:10,770 --> 00:20:17,780
كلّ ما يستطيع ساقٍ فعله هو تقديم المشروب
المثاليّ للضّيف الّذي يجلس أمامه

260
00:20:18,180 --> 00:20:27,540
احرصي على ألّا يكون شديداً جدّاً ولا حُلواً جدّاً
ولا حامضاً جدّاً ولا ساخناً جدّاً ولا بارداً جدّاً

261
00:20:28,070 --> 00:20:29,800
لهذا أعددت هذا

262
00:20:30,290 --> 00:20:32,230
هناك أمر آخر

263
00:20:32,720 --> 00:20:36,440
دعي أسئلة الحياة والموت لكاهن

264
00:20:36,440 --> 00:20:38,720
هل هذا شيء علّمك إيّاه مُعلّمك؟

265
00:20:38,720 --> 00:20:40,050
بكلّ تأكيد

266
00:20:41,270 --> 00:20:46,460
ساساكورا-سان، هل توقّفتَ عن القلق
بشأن ما حدث؟

267
00:20:48,000 --> 00:20:49,110
أجل

268
00:20:49,940 --> 00:20:55,250
أنا مُطمئنّة. أظنّني بالغتُ في التّفكير

269
00:21:00,080 --> 00:21:02,360
تفضّلي، استخدمي هذه

270
00:21:02,360 --> 00:21:03,830
شكراً لك

271
00:21:04,780 --> 00:21:06,650
حسناً. إلى اللّقاء

272
00:21:08,770 --> 00:21:10,120
رافقتكِ السّلامة

273
00:21:11,880 --> 00:21:15,560
كاسي-سان. أتذكّر ما كتبته في رسالتك لي

274
00:21:16,090 --> 00:21:21,800
مهما كان السّاقي يُعاني، لا يجوز"
أن يكشف عن تلك المشاعر لضيوفه

275
00:21:22,750 --> 00:21:25,780
الحانة هي حيث يأتي الضّيوف
بحثاً عن ملاذ من المطر

276
00:21:26,180 --> 00:21:28,850
ينبغي أن يعطيهم السّاقي مِظلّة

277
00:21:28,850 --> 00:21:31,490
"لا ينبغي أن يكون هو من يروي حِكايات حزينة

278
00:21:33,040 --> 00:21:36,860
كننتُ قد ظننتُ بأنّني أرحتُ
ضميري منذ زمن بعيد

279
00:21:37,280 --> 00:21:42,990
لكن، ثمّة ضيف جعلني أدرِك
اللّيلة بأنّني لم أفعل

280
00:21:44,540 --> 00:21:47,230
ما زلتُ ساقياً قليل الخبرة

281
00:21:48,020 --> 00:21:49,000
،لكن رغم ذلك

282
00:21:49,830 --> 00:21:55,140
،لديّ ضيف يستطيع تفهّم قلّة الخبرة تلك
ويقلق عليّ بسبب ذلك

283
00:21:56,260 --> 00:22:01,190
كلّ ما يمكنني فعله الآن هو التّعبير
عن هذه العاطفة المليئة بالمشاعر

284
00:22:06,830 --> 00:22:11,870
يا آنسة، شكراً جزيلاً لكِ على اليوم