1
00:00:02,690 --> 00:00:03,600
،واحد

2
00:00:03,600 --> 00:00:04,450
،اثنان

3
00:00:04,450 --> 00:00:05,250
،ثلاثة

4
00:00:05,250 --> 00:00:06,160
،أربعة

5
00:00:06,160 --> 00:00:06,990
،خمسة

6
00:00:06,990 --> 00:00:08,160
...ستّة

7
00:00:08,160 --> 00:00:09,390
!سبعة

8
00:00:11,780 --> 00:00:12,760
ماي

9
00:00:17,770 --> 00:00:18,950
!فعلناها

10
00:00:22,830 --> 00:00:26,040
!لنسرع إلى نافورة المعادن، لابّي

11
00:00:26,040 --> 00:00:28,670
حسناً، هل جميعكم جاهزون لهذا؟

12
00:00:28,670 --> 00:00:32,010
!هيّا بنا

13
00:02:00,720 --> 00:02:01,930
لماذا؟

14
00:02:01,930 --> 00:02:04,040
كيف حدث هذا؟

15
00:02:06,660 --> 00:02:09,850
حافِظ على رباطة جأشك من فضلك
يا أكودايكان-ساما

16
00:02:09,850 --> 00:02:11,420
!أتوسّل إليك أن تهدأ

17
00:02:11,420 --> 00:02:13,570
كيف لي أن أبقى هادئاً؟

18
00:02:13,870 --> 00:02:16,210
،أتباعي هُزِموا واحداً تلو الآخر

19
00:02:16,210 --> 00:02:19,270
!وتمّ انتزاع ستّ نوافير منّي

20
00:02:20,380 --> 00:02:21,480
لماذا...؟

21
00:02:22,110 --> 00:02:27,530
أي قوّة هي هذه الّتي تمتلكها
المُحاربتان الأسطوريّتان، بريكيور؟

22
00:02:28,410 --> 00:02:30,070
!أجبني يا غويان

23
00:02:31,430 --> 00:02:35,340
لا تعبس من فضلك يا أكودايكان-ساما

24
00:02:35,340 --> 00:02:38,720
قوّة الدّمار سوف تفرض السّيادة

25
00:02:38,720 --> 00:02:42,090
،مع إحراز بريكيور تقدُّماً طفيفاً

26
00:02:42,090 --> 00:02:45,600
سوف أُجهِّز لعودة مهيبة

27
00:02:45,600 --> 00:02:48,760
تعني بأنّك ستذهب لهزيمة بريكيور؟

28
00:02:48,760 --> 00:02:52,970
لا، لكن رسمتُ في الواقع خطّةً ممتازة

29
00:02:53,520 --> 00:02:55,320
أتقول خطّة ممتازة؟

30
00:02:55,940 --> 00:03:00,400
أجل. يعتمد الأمر كلّه على إعادة التّدوير

31
00:03:05,160 --> 00:03:09,650
!الأميرة في مأزق! الغرّافة المسروقة

32
00:03:27,360 --> 00:03:29,170
!أحسنتِ يا ساكي

33
00:03:29,770 --> 00:03:31,880
شكراً، شكراً

34
00:03:36,640 --> 00:03:37,950
!بسرعة، موبّو

35
00:03:37,950 --> 00:03:39,200
!بسرعة، بوبّو

36
00:03:39,610 --> 00:03:41,210
ساكي، يعزو الأمر لكِ، لابّي

37
00:03:41,210 --> 00:03:42,740
أرجوكِ، تشوبّي

38
00:03:44,050 --> 00:03:44,720
ساكي

39
00:03:45,130 --> 00:03:45,740
أجل

40
00:03:51,150 --> 00:03:54,560
...واجهنا أزمةً تلو الأخرى، لكن

41
00:03:55,530 --> 00:03:59,050
وحّدنا قِوانا جميعاً وتجاوزناهم كلّهم

42
00:04:00,120 --> 00:04:04,230
!لذا لنُعِد النّافورة الأخيرة إلى طبيعتها معاً

43
00:04:04,930 --> 00:04:05,820
!أجل، لنفعل

44
00:04:05,820 --> 00:04:07,750
!مُوافِقون

45
00:04:12,070 --> 00:04:12,980
ها أنا ذي

46
00:04:26,270 --> 00:04:27,920
!مرحى

47
00:04:27,920 --> 00:04:29,720
!شكراً

48
00:04:57,260 --> 00:04:59,230
!الأميرة فيليا

49
00:04:59,230 --> 00:05:01,340
!سعادة الأميرة، فعلناها

50
00:05:01,340 --> 00:05:04,490
!استرجعنا كافّة النّوافير المستولى عليها

51
00:05:08,950 --> 00:05:11,580
الأميرة قادمة من هنا، لابّي

52
00:05:17,650 --> 00:05:21,740
فلابّي، تشوبّي، أبليتُما حسناً

53
00:05:22,470 --> 00:05:25,560
أشكركما من أعماق قلبي

54
00:05:26,580 --> 00:05:31,090
موب، فوب، لا بدّ أنّكما كنتُما خائفين

55
00:05:31,090 --> 00:05:33,850
لكن كافحتُما ببسالة، دون أن تهربا

56
00:05:36,990 --> 00:05:39,780
!سعادة الأميرة

57
00:05:40,640 --> 00:05:42,420
!أنا مسرور للغاية، لابّي

58
00:05:42,420 --> 00:05:45,400
!أنا مسرورة لأنّكِ بأمان، تشوبّي

59
00:05:45,970 --> 00:05:47,240
أليس هذا رائعاً؟

60
00:05:50,730 --> 00:05:52,250
...ساكي، ماي

61
00:05:52,800 --> 00:05:57,400
بفضلكما، تمكنّا من منع وقوع كارثة خطيرة

62
00:05:57,700 --> 00:06:00,070
كيف أردّ جميلكما؟

63
00:06:00,070 --> 00:06:01,560
تـ-تردّين جميلنا؟

64
00:06:01,840 --> 00:06:05,060
ما دام الجميع سُعداء، فهذا يكفينا

65
00:06:05,060 --> 00:06:06,200
أليس كذلك يا ماي؟

66
00:06:06,200 --> 00:06:07,050
أجل

67
00:06:07,290 --> 00:06:12,340
فلابّي وتشوبّي وموب وفوب
بذلوا ما بوسعهم جميعاً

68
00:06:12,620 --> 00:06:17,270
أنتما لطيفتان حقّاً، وكذلك قويّتان

69
00:06:18,500 --> 00:06:20,470
،لم تفكّرا ببعضكما الآخر فحسب

70
00:06:20,920 --> 00:06:24,040
بل بجميع من حولكما أيضاً

71
00:06:24,400 --> 00:06:27,880
قلبكما الطيّب يُمثّل قوّتما

72
00:06:27,880 --> 00:06:30,250
ماي لطيفة جدّاً، تشوبّي

73
00:06:30,640 --> 00:06:32,980
كانت ساكي لطيفة بعض الشّيء، لابّي

74
00:06:33,580 --> 00:06:35,240
ماذا تقصد بـ"بعض الشّيء"؟

75
00:06:35,510 --> 00:06:39,910
هذا لأنّكِ تنسينني أحياناً، لابّي

76
00:06:40,940 --> 00:06:44,840
فقبل أيّام، ركلتِني من أعلى
السّرير أثناء نومكِ، لابّي

77
00:06:46,020 --> 00:06:49,740
وذات مرّة خلطتِ بيني وبين الملابس المغسولة
وكدتِ تضعينني في الغسّالة، لابّي

78
00:06:50,600 --> 00:06:54,340
فـ-فلابّي، ما الّذي تقوله أمام الأميرة؟

79
00:06:54,340 --> 00:06:57,320
...أ-أصبح مُستهترة قليلاً بين الحين والآخر

80
00:07:01,500 --> 00:07:03,240
أنا آسفة

81
00:07:10,440 --> 00:07:13,730
الأميرة فيليا، أريدكِ أن تخبرينا بشيء

82
00:07:14,520 --> 00:07:15,690
تلك الكلمات

83
00:07:16,410 --> 00:07:18,400
يعتمد الأمر عليكما

84
00:07:18,660 --> 00:07:20,790
،إذا استمررتُما بالشُّعور بعمق تجاههما

85
00:07:20,790 --> 00:07:23,420
فينبغي أن تصلهما تلك المشاعر

86
00:07:24,070 --> 00:07:25,160
،"بـ "تصلهما

87
00:07:25,420 --> 00:07:29,750
هل قصدتِ بأنّنا سنتمكّن من رؤية
ميتشيرو-سان وكاورو-سان؟

88
00:07:30,280 --> 00:07:32,000
نريد رؤيتهما في أسرع وقت مُمكن

89
00:07:32,580 --> 00:07:33,860
كيف نفعل ذلك؟

90
00:07:34,390 --> 00:07:35,940
متى نستطيع؟

91
00:07:36,630 --> 00:07:39,030
أريد رؤية ميتشيرو أيضاً، موبّو

92
00:07:39,030 --> 00:07:41,530
أريد رؤية كاورو أيضاً، بوبّو

93
00:07:42,860 --> 00:07:45,980
،لا أستطيع تصوُّر كلّ شيء

94
00:07:46,350 --> 00:07:48,230
يمكنني الشّعور ببعض الأمور فحسب

95
00:07:49,010 --> 00:07:50,040
الشّعور؟

96
00:07:50,400 --> 00:07:51,440
ما الّذي تشعرين به؟

97
00:07:52,230 --> 00:07:54,040
بنورِ حياتهما

98
00:07:57,600 --> 00:08:01,460
في هذا العالم، هناك الكثير من الكائنات الحيّة

99
00:08:02,050 --> 00:08:04,350
،بأشكال وأحجام مختلفة

100
00:08:04,350 --> 00:08:08,530
لكن جميعها تعيش حياتها وتتألّق بنور خاصّ بها

101
00:08:15,040 --> 00:08:18,610
مثلما تتألّق حياتكما

102
00:08:18,910 --> 00:08:22,300
نور حياة ميتشيرو وكاورو ما زال يتألّق

103
00:08:24,370 --> 00:08:26,050
إنّه خافت، لكنّه ما زال موجوداً

104
00:08:26,050 --> 00:08:29,650
أستطيع الشّعور بنور حياتهما بوضوح

105
00:08:33,300 --> 00:08:36,820
،غير أنّهما تقطنان في أعماق ظلام بارد

106
00:08:36,820 --> 00:08:38,570
لا يصله بصيص ضوء

107
00:08:38,570 --> 00:08:40,050
شلّال الظّلام، صحيح؟

108
00:08:42,410 --> 00:08:44,960
كما قالت شيتاتاري تماماً

109
00:08:45,430 --> 00:08:48,030
"مختومتان على يد أكودايكان"

110
00:08:49,380 --> 00:08:50,680
...أكودايكان

111
00:08:50,680 --> 00:08:53,160
هل سنذهب إلى شلّال الظّلام، بوبّو؟

112
00:08:53,620 --> 00:08:54,770
،أنا خائفة

113
00:08:55,310 --> 00:08:57,150
!...لكن إذا كان من أجل مساعدتهما

114
00:08:57,880 --> 00:09:01,590
هذا صحيح، لابّي. لنتحلَّ بالشّجاعة
!ونذهب لإنقاذهما، لابّي

115
00:09:02,030 --> 00:09:05,010
لكن كيف نذهب لإنقاذهما؟

116
00:09:06,030 --> 00:09:08,320
سنُحيي شجرة العالم

117
00:09:09,590 --> 00:09:12,330
لم تعُد شجرة العالم إلى طبيعتها؟

118
00:09:12,330 --> 00:09:15,450
،ليس بعد، تشوبّي. لاستعادة شجرة العالم

119
00:09:15,450 --> 00:09:19,700
نحتاج قوى النّوافير السّبعة كلّها
والأميرة فيليا، تشوبّي

120
00:09:19,700 --> 00:09:23,520
شجرة العالم هي الشّجرة الّتي
تحكم كلَّ الحياة

121
00:09:23,940 --> 00:09:26,930
،إذا أحيينا شجرة العالم وحيويّتها الوافرة

122
00:09:26,930 --> 00:09:29,060
سوف تضعف قوّةُ الدّمار

123
00:09:30,110 --> 00:09:33,790
إذا فعلنا ذلك، فسوف تتحرّر ميتشيرو وكاورو؟

124
00:09:57,000 --> 00:09:58,470
...هذا جميل

125
00:09:58,470 --> 00:10:01,160
هذه هي قوّة الأميرة، لابّي

126
00:10:01,470 --> 00:10:05,150
إنّها قوّة تجعل كلّ الحيوات تتألّق، تشوبّي

127
00:10:16,380 --> 00:10:19,500
لنسكب هذا في نافورة الشّمس

128
00:10:19,890 --> 00:10:23,550
إذاً أين نافورة الشّمس على أيّ حال؟

129
00:10:23,550 --> 00:10:27,020
لا يبدو أنّها في أيّ مكان في بلاد
النّوافير، تشوبّي

130
00:10:27,450 --> 00:10:29,790
...الحقيقة هي أنّ نافورة الشّمس

131
00:10:31,530 --> 00:10:32,540
سعادة الأميرة؟

132
00:10:33,270 --> 00:10:34,440
هل من مُشكلة؟

133
00:10:35,210 --> 00:10:37,140
أعلم بأنّك هناك

134
00:10:37,770 --> 00:10:39,470
!اكشف عن نفسك

135
00:10:40,040 --> 00:10:42,200
كنتُ قد أوشكت

136
00:10:42,200 --> 00:10:45,910
كدتُ أكتشف مكان نافورة الشّمس

137
00:10:46,510 --> 00:10:49,240
هذا ما أتوقّعه من أميرة بلاد النّوافير

138
00:10:49,750 --> 00:10:50,670
!...أنت

139
00:10:51,210 --> 00:10:52,090
!غويان

140
00:10:52,430 --> 00:10:54,120
لماذا أنت هنا، موبّو؟

141
00:10:54,120 --> 00:10:56,290
لتعذيب الأميرة، بوبّو؟

142
00:10:56,290 --> 00:10:57,840
إطلاقاً

143
00:10:57,840 --> 00:11:03,210
لستُ شنيعاً لدرجة أعذِّب فيها
شخصيّة ملكيّة مُوقَّرة

144
00:11:07,410 --> 00:11:10,520
!فلا أعلم ما قد أفعل

145
00:11:10,860 --> 00:11:14,140
!لن أدعك تمسّ الأميرة بضرّ، لابّي

146
00:11:14,140 --> 00:11:16,070
!سوف نحميها، تشوبّي

147
00:11:22,070 --> 00:11:25,240
!القوّة الرُّوحيّة المزدوجة

148
00:11:36,420 --> 00:11:37,660
!أنيري المستقبل

149
00:11:38,550 --> 00:11:39,830
!مُدّينا بالشّجاعة

150
00:11:47,300 --> 00:11:50,980
!القمر الّذي يملأ السّماوات، كيور برايت

151
00:11:51,870 --> 00:11:55,150
!الرّياح الّتي تُعطِّر الأرض، كيور ويندي

152
00:11:56,460 --> 00:11:57,770
!نحن بريكيور

153
00:11:59,080 --> 00:12:01,530
...إلى من يُدنِّسون النّوافير المُقدّسة

154
00:12:02,470 --> 00:12:05,730
!أوقفوا سلوككم القاسي

155
00:12:05,730 --> 00:12:10,200
،تبدوان أكثر حيويّة من آخر لقاء بيننا

156
00:12:10,200 --> 00:12:13,440
وأصبحت قوّتكما أكبر كذلك

157
00:12:14,570 --> 00:12:16,170
،إذا كنتُما هكذا

158
00:12:16,170 --> 00:12:19,550
فمن الوقاحة ألّا آخذكما على محمل الجدّ

159
00:12:19,830 --> 00:12:21,500
!سوف أواجهكما

160
00:12:25,800 --> 00:12:27,140
!صرفتُ انتباهكما

161
00:12:29,520 --> 00:12:31,950
ما أردتُه كان هذا

162
00:12:32,400 --> 00:12:34,010
،هذه هي غرّافة الجنّي إذاً

163
00:12:34,010 --> 00:12:37,310
والّتي احتوتْ على أنوار الحياة
من بلاد النّوافير؟

164
00:12:37,310 --> 00:12:38,710
!أعدها، لابّي

165
00:12:38,710 --> 00:12:42,190
لن أفعل. من وجدَ شيئاً فهو له

166
00:12:42,880 --> 00:12:46,820
تُشعّ الغرّافة بقوّة أنوار الحياة
المُتجمِّعة في داخلها

167
00:12:46,820 --> 00:12:50,610
ماذا سيحدث إذا أضفتُ إليها طاقةً مُدمِّرة؟

168
00:12:55,710 --> 00:12:59,380
...نُضيف ورقة شجر ذابلة، ثمّ

169
00:12:59,620 --> 00:13:02,870
!نخضّها، نخضّها، نخضّها حتّى تختلط جيّداً

170
00:13:12,190 --> 00:13:13,960
...مستحيل! هذا

171
00:13:14,690 --> 00:13:15,810
...هذا لا يُصدَّق

172
00:13:17,640 --> 00:13:19,520
ها هو! إنّه جاهز

173
00:13:20,630 --> 00:13:22,020
!كاريهان

174
00:13:39,170 --> 00:13:40,100
لماذا؟

175
00:13:40,320 --> 00:13:42,270
!هزمنا كاريهان منذ زمن بعيد

176
00:13:42,270 --> 00:13:45,450
،أجل، تكبّد هزيمة على أيديكما

177
00:13:45,450 --> 00:13:47,620
وعاد إلى ورقة ذابلة

178
00:13:49,290 --> 00:13:52,180
نفس الورقة الذّابلة الّتي أضفتُها للتو

179
00:13:52,740 --> 00:13:56,970
في البلاد الخضراء، تُستعمَل
الأشياء ويُعاد استعمالها، صحيح؟

180
00:13:56,970 --> 00:14:00,850
تعلّمتُ من هذا المثال وأنشأتُ
برنامجَ إعادة تدوير

181
00:14:02,590 --> 00:14:04,310
بريكيور؟

182
00:14:04,960 --> 00:14:06,660
!خضخضة، خضخضة

183
00:14:07,460 --> 00:14:11,610
بما أنّكما اثنتان، فسوف أستخدم لاعبَين أيضاً

184
00:14:18,700 --> 00:14:21,160
!أوليه، تشا-تشا-تشا

185
00:14:21,630 --> 00:14:22,750
!مويرومبا

186
00:14:22,750 --> 00:14:25,700
آسف لو تأخّرتُ عليكما، تشا-تشا

187
00:14:25,700 --> 00:14:28,060
لم أكن أنتظرك أصلاً

188
00:14:30,560 --> 00:14:33,000
!أنا سعيد برؤيتك، سينيور

189
00:14:35,130 --> 00:14:36,480
!ابتعد، لا تلمسني

190
00:14:36,480 --> 00:14:37,790
!سوف أحترق

191
00:14:39,270 --> 00:14:42,000
أنت قابل للاشتعال كعادتك، سينيور

192
00:14:42,000 --> 00:14:45,800
!وأنت حارّ زيادة عن اللّزوم
!لدرجة مُضرّة بالآخرين

193
00:14:45,800 --> 00:14:49,920
هذا لأنّ قلبي يشتعل بالشّغف

194
00:14:49,920 --> 00:14:50,970
كاريتشي

195
00:14:51,290 --> 00:14:53,830
!علاقتنا لا تسمح لك بمُناداتي بلقبٍ هكذا

196
00:14:53,830 --> 00:14:57,860
.كاريهان-دونو، مويرومبا-دونو
،أنتما في نفس الفريق

197
00:14:57,860 --> 00:15:01,080
لذا ألا يمكنكما أن تحاولا
الانسجام على الأقلّ؟

198
00:15:01,080 --> 00:15:04,590
أرفُض! كيف أنسجم مع هذا الفاشل النّاريّ؟

199
00:15:05,840 --> 00:15:09,520
،كذلك أنا. مَن لا يرقص معي
فهو ليس صديقي

200
00:15:09,990 --> 00:15:14,300
لسببٍ ما، لا أتخيّل أنّ هناك من يقبل
بالرّقص معك والذّوبان بين ذراعيك

201
00:15:14,760 --> 00:15:15,670
ماذا؟

202
00:15:16,040 --> 00:15:18,720
لا يُمكن أن يُضاهيني أحدٌ في الرّقص
!تشا-تشا-تشا

203
00:15:19,290 --> 00:15:21,850
!إلّا أنّك ضعيف تشا-تشا-تشا

204
00:15:24,520 --> 00:15:27,790
يمكنكما أن تُشكِّلا ثنائيّاً قويّاً

205
00:15:27,790 --> 00:15:31,830
فأساساً، كلاكما تشتركان في مسألة
أنّكما هُزِمتُما بواسطة بريكيور

206
00:15:32,590 --> 00:15:33,610
!ماذا تقول؟

207
00:15:33,970 --> 00:15:38,830
أليست كراهيّتكما تجاه بريكيور هي نفسها؟

208
00:15:41,700 --> 00:15:44,750
!يمكنكما الآن أن تنتقما

209
00:15:45,090 --> 00:15:49,150
بريكيور، لم أركما منذ مدّة. تغيّرتُما كثيراً

210
00:15:49,420 --> 00:15:52,430
هذه الملابس أنيقة جدّاً، سينيوريتا

211
00:15:52,680 --> 00:15:55,170
سأوفِّر الرّقصة الأخيرة لأجلكما

212
00:16:09,130 --> 00:16:12,140
بداية شيِّقة لمعركة، أليس كذلك؟

213
00:16:12,140 --> 00:16:13,370
!غويان

214
00:16:13,370 --> 00:16:13,920
نعم؟

215
00:16:14,630 --> 00:16:16,360
!أعِد الغرّافة

216
00:16:16,850 --> 00:16:19,030
!قلتُ بأنّني لن أُعيدها

217
00:16:24,630 --> 00:16:25,930
!سعادة الأميرة

218
00:16:25,930 --> 00:16:27,400
هل أنتِ بخير؟

219
00:16:28,870 --> 00:16:30,610
!كيف تجرؤ على أذيّة الأميرة؟

220
00:16:30,880 --> 00:16:32,500
!لن أُسامحك، موبّو

221
00:16:30,880 --> 00:16:32,500
!لن أُسامحك، بوبّو

222
00:16:33,150 --> 00:16:34,210
!قوّة القمر

223
00:16:36,020 --> 00:16:37,090
!قوّة الرّياح

224
00:16:38,520 --> 00:16:41,010
!سبلاش تارن

225
00:16:54,150 --> 00:16:56,120
مُخيف، مُخيف

226
00:16:56,120 --> 00:16:59,100
سوف أستأذن بالرّحيل الآن

227
00:17:00,510 --> 00:17:01,450
!انتظر

228
00:17:01,450 --> 00:17:03,450
!أعِد الغرّافة

229
00:17:04,400 --> 00:17:06,240
...خصمكما هو

230
00:17:06,590 --> 00:17:08,480
!نحن الاثنان، تشا-تشا...

231
00:17:09,720 --> 00:17:11,390
!أفسحا الطّريق

232
00:17:17,530 --> 00:17:20,590
!لا نملك وقتاً لمُقاتلتكما

233
00:17:23,150 --> 00:17:24,300
!تشا-تشا

234
00:17:51,450 --> 00:17:54,870
!يا نور الأرواح! يا بريق الحياة

235
00:17:55,200 --> 00:17:58,340
!أرشِد قلبينا نحو الأمل

236
00:17:59,340 --> 00:18:00,750
...بريكيور

237
00:18:00,750 --> 00:18:03,140
...النّجم اللّولبيّ

238
00:18:04,460 --> 00:18:06,470
!سبلاش

239
00:18:09,380 --> 00:18:10,280
تشا-تشا

240
00:18:21,680 --> 00:18:22,970
ماذا كان ذلك؟

241
00:18:22,970 --> 00:18:24,150
النّجم اللّولبيّ لم ينجح؟

242
00:18:24,500 --> 00:18:26,420
حان دورنا الآن

243
00:18:26,420 --> 00:18:27,720
!هيّا بنا يا كاريتشي

244
00:18:27,720 --> 00:18:28,870
!لا ألقاب

245
00:18:31,110 --> 00:18:32,390
!أيّتها الأوراق الذّابِلة

246
00:18:34,580 --> 00:18:35,840
!أيّتّها اللّهب

247
00:19:02,740 --> 00:19:04,730
!بريكيور، هذه هي النّهاية

248
00:19:04,730 --> 00:19:07,740
تنحَّ جانباً يا كاريتشي. سأجهِز عليهما

249
00:19:07,740 --> 00:19:08,830
!لا، أنا من سيفعل

250
00:19:08,830 --> 00:19:10,660
!لا، دعني أنا

251
00:19:10,660 --> 00:19:11,960
أتريد شِجاراً؟

252
00:19:11,960 --> 00:19:13,200
!أنا جاهز

253
00:19:13,950 --> 00:19:16,510
!كرهتُك منذ اليوم الّذي التقينا فيه

254
00:19:16,510 --> 00:19:18,710
لا تكره، ارقص تشا-تشا-تشا
!على أغنية حبّ

255
00:19:18,710 --> 00:19:20,980
!هلّا توقّفت عن ترديد "تشا-تشا-تشا"؟

256
00:19:19,470 --> 00:19:22,210
يبدو أنّنا وصلنا إلى طريق مسدود

257
00:19:22,690 --> 00:19:23,720
ما الأمر؟

258
00:19:26,310 --> 00:19:27,720
!...الغرّافة

259
00:19:29,850 --> 00:19:32,260
!الأميرة فيليا

260
00:19:54,240 --> 00:19:56,240
ميتشيرو-دونو، كاورو-دونو

261
00:19:56,900 --> 00:20:00,210
لديّ أنباء لكما اليوم

262
00:20:00,770 --> 00:20:04,880
صديقتكما بريكيور في مأزق حقيقيّ

263
00:20:07,150 --> 00:20:12,050
مهما قاومتا، فُرَص بريكيور
في الفوز معدومة

264
00:20:13,940 --> 00:20:17,510
بهذا، أيّام المُحاربتين الأسطوريّتين معدودة

265
00:20:21,170 --> 00:20:24,160
ما زلتُما نائمتين بعمق، أليس كذلك؟

266
00:20:24,630 --> 00:20:30,500
حسناً، عدم إبادة قوّة أكودايكان لكما
بشكل كامل لَهو مُعجزة

267
00:20:33,470 --> 00:20:37,120
لا بدّ أنّه اعتبركما ضروريّتين
لأجل أمر ما في المستقبل

268
00:20:37,120 --> 00:20:40,830
ونوّمكما بدلاً من ذلك

269
00:20:41,850 --> 00:20:44,400
،لكن حتّى بعدم وجودكما

270
00:20:44,400 --> 00:20:49,410
لديّ بيادق آخرون متنوِّعون، بمن فيهم
كاريهان-دونو ومويرومبا-دونو

271
00:20:49,410 --> 00:20:51,050
لذا هذا لا يهمّ فعليّاً

272
00:20:53,040 --> 00:20:55,150
استمتعا براحتكما، وأحلام سعيدة

273
00:20:55,440 --> 00:20:58,470
،حتّى إذا استيقظتُما يوماً

274
00:20:58,470 --> 00:21:02,220
قد لا تجدان صديقتيكما بعدها

275
00:21:28,740 --> 00:21:30,280
...الأميرة فيليا

276
00:21:30,280 --> 00:21:32,090
تماسكي أرجوكِ، تشوبّي

277
00:21:35,540 --> 00:21:37,910
!سعادة الأميرة

278
00:21:38,690 --> 00:21:41,180
أنا آسفة جدّاً يا سعادة الأميرة فيليا

279
00:21:41,180 --> 00:21:43,640
...لو كنّا أكثر قوّة

280
00:21:46,650 --> 00:21:48,880
من المُبكِّر جدّاً الاستسلام

281
00:21:48,880 --> 00:21:51,200
لم ينتهِ هذا بعد

282
00:21:51,460 --> 00:21:54,950
لكن الغرّافة قد سُرِقَتْ، تشوبّي

283
00:21:54,950 --> 00:21:57,160
ماذا نفعل الآن، لابّي؟

284
00:21:58,800 --> 00:22:00,120
فلنذهب

285
00:22:00,970 --> 00:22:02,080
نذهب؟

286
00:22:02,670 --> 00:22:04,800
إلى أين سنذهب؟

287
00:22:08,120 --> 00:22:09,650
!إلى البلاد الخضراء

288
00:23:42,760 --> 00:23:44,970
!علينا استعادة الغرّافة المسروقة

289
00:23:44,970 --> 00:23:46,270
--لنبحث جميعاً

290
00:23:46,730 --> 00:23:48,550
!كوروني يتكلّم؟

291
00:23:48,550 --> 00:23:51,440
ويقول بأنّ الأميرة فيليا هنا

292
00:23:51,440 --> 00:23:53,130
ماذا يعني هذا؟

293
00:23:53,130 --> 00:23:55,500
...انظري... ذلك الضّوء من بعيد

294
00:23:55,910 --> 00:23:58,600
!هذا القوام... مستحيل

295
00:23:57,440 --> 00:23:58,600
!غير ممكن

296
00:23:59,250 --> 00:24:01,490
!نحن بريكيور سبلاش

297
00:24:01,490 --> 00:24:04,420
!أهلاً بعودتكما
!!ميتشيرو وكاورو

298
00:24:04,420 --> 00:24:07,250
سنكون بأفضل هيئة بقوّة الإثارة الهائلة
والتّشويق الهائل