1
00:00:07,540 --> 00:00:09,680
هل أنتم حاهزون، تشوبّي؟

2
00:00:10,190 --> 00:00:12,510
!ليس بعد

3
00:00:12,510 --> 00:00:15,240
هل أنتم جاهزون، تشوبّي؟

4
00:00:15,760 --> 00:00:18,240
!ليس بعد، لابّي

5
00:00:18,640 --> 00:00:21,320
هل أنتم جاهزون، تشوبّي؟

6
00:00:21,320 --> 00:00:24,210
!أنا جاهز

7
00:00:30,980 --> 00:00:34,270
لماذا نؤدّي سنؤدّي مانزاي
هنا في هذا المكان القصيّ؟

8
00:00:34,270 --> 00:00:37,630
لأنّك مُحرَج جدّاً من القيام
بذلك أمام النّاس

9
00:00:37,630 --> 00:00:40,920
هذا المكان مثاليّ لإبراز الشّخصيّة
الحقيقيّة للمرء

10
00:00:41,270 --> 00:00:45,180
ولماذا تُبرِز هذه الجبال الشّخصيّة
الحقيقيّة للمرء

11
00:00:45,180 --> 00:00:51,210
أخبرني أبي بأنّ الحيوانات النّادرة
تظهر في بستان الرّماد هذا

12
00:00:51,510 --> 00:00:54,100
قرأ ذلك في مقالة مجلّة بواسطة
أستاذ كلّية مشهور

13
00:00:54,510 --> 00:00:55,450
حيوانات نادرة؟

14
00:00:55,450 --> 00:00:57,820
!مثل نيسّي وأفاعي تسوتشينوكو

15
00:00:57,820 --> 00:00:59,640
!فلنبدأ

16
00:00:59,640 --> 00:01:03,190
عندما يضحك نيسّي، فإنّه يصدر صوت
(نيشينيشي (ضحك مكبوت

17
00:01:03,520 --> 00:01:06,920
التّلاعب بلفظ "نيسّي" مع ضحك مكبوت؟

18
00:01:07,540 --> 00:01:09,880
حتّى أوراق شجر السّرو لن تهتزّ لذلك

19
00:01:10,380 --> 00:01:12,850
بالإضافة إلى أنّ مثل هذه الأنواع
من الحيوانات النّادرة غير موجودة

20
00:01:12,850 --> 00:01:14,800
بلى، موجودة

21
00:01:14,800 --> 00:01:17,590
على سبيلِ المثال، داخل هذه
...الشّجيرة الّتي قد تجدها

22
00:01:18,020 --> 00:01:20,750
!شيء من هذا القبيل! أمزح فحسب

23
00:02:55,890 --> 00:02:57,540
!وجدتُ فلابّي، موبّو

24
00:02:59,520 --> 00:03:01,060
ما الأمر، بوبّو؟

25
00:03:01,060 --> 00:03:02,160
!وجدتُك، تشوبّي

26
00:03:06,100 --> 00:03:07,830
!انتظرني يا هوشينو-كن

27
00:03:11,790 --> 00:03:12,910
!انتظر

28
00:03:13,560 --> 00:03:14,730
ماذا حدث؟

29
00:03:14,730 --> 00:03:17,440
كأنّني سمعتُ صوت كينتا للتو

30
00:03:17,760 --> 00:03:20,540
أ-أمسكني من أُذنَي، لابّي

31
00:03:20,540 --> 00:03:22,890
كشفنا، تشوبّي

32
00:03:25,550 --> 00:03:27,160
!صدّقيني! هذا حقيقيّ

33
00:03:27,160 --> 00:03:29,340
حقّاً؟ هل أنت متأكّد من أنّك
لم تكن تحلم؟

34
00:03:29,340 --> 00:03:31,400
!رأيتُهم بأمّ عيني

35
00:03:31,400 --> 00:03:33,720
لم يكونوا مخلوقات عاديّة

36
00:03:33,720 --> 00:03:36,360
كانوا حيوانات نادرة من بستان الدّردار

37
00:03:36,360 --> 00:03:39,750
مُحال أن تتواجد حيوانات نادرة كهذه

38
00:03:39,750 --> 00:03:40,550
صحيح؟

39
00:03:40,550 --> 00:03:43,700
أ-أجل، معها حقّ. لا بدّ أنّك
خلطت بينهم وبين شيء آخر

40
00:03:44,050 --> 00:03:48,260
،لا، إذا قال هوشينو-كن بأنّه رآهم
!فهذا يعني بأنّهم حقيقيّون

41
00:03:48,260 --> 00:03:49,830
أليس هذا اكتشافاً مُذهلاً؟

42
00:03:49,830 --> 00:03:50,920
لكن هل هو حقيقيّ؟

43
00:03:51,720 --> 00:03:53,400
أقول لكم بأنّه حقيقيّ

44
00:03:54,410 --> 00:03:57,440
مياساكو! رأيت الحيوانات النّادرة
أيضاً، أليس كذلك؟

45
00:03:57,440 --> 00:04:00,870
أ-أجل، لا أعتقد بأنّه مخطئ

46
00:04:01,160 --> 00:04:03,370
حقّاً؟ مياساكو-كن رآهم أيضاً؟

47
00:04:03,370 --> 00:04:04,780
هل أنت متأكّد؟

48
00:04:04,780 --> 00:04:05,960
أ-أجل

49
00:04:07,800 --> 00:04:08,820
كان شكلهم هكذا

50
00:04:09,660 --> 00:04:13,220
...أحدهم هكذا وهكذا، وهكذا

51
00:04:13,220 --> 00:04:15,380
!صحيح! كانوا كذلك

52
00:04:18,720 --> 00:04:21,380
لم أرَ شيئاً مثيلاً لهم من قبل

53
00:04:21,380 --> 00:04:23,100
ما قد يكونون؟

54
00:04:23,100 --> 00:04:26,170
مهلاً! تُصدِّقنَ هذه الرّسوم
ولا تُصدّقنني؟

55
00:04:27,000 --> 00:04:28,150
ماذا نفعل؟

56
00:04:28,150 --> 00:04:29,610
يجب أن نفعل شيئاً

57
00:04:33,120 --> 00:04:37,630
!الحيوانات النّادرة "ميمينغا" تُسبّب شغباً؟

58
00:04:40,350 --> 00:04:42,170
،كينتوليسكي-دونو

59
00:04:42,170 --> 00:04:45,560
متى ستهزم بريكيور؟

60
00:04:45,560 --> 00:04:50,060
سئمَ أكودايكان-ساما الانتظار

61
00:04:50,060 --> 00:04:51,970
ما زلت لا تفهم يا غويان؟

62
00:04:52,300 --> 00:04:54,770
ألم أقل لك بأنّه لا يوجد معنى

63
00:04:54,770 --> 00:04:57,300
في فوز نِزال مُملّ؟

64
00:04:58,010 --> 00:05:00,980
ما أطمح له هو نِزال عظيم
!يُسجَّل في التّاريخ

65
00:05:00,980 --> 00:05:04,360
ولتحقيق تلك الغاية، أُدرِّب بريكيور

66
00:05:04,940 --> 00:05:07,780
،حالما يحظى ذلكما الاثنان بقوّة كافية

67
00:05:07,780 --> 00:05:10,370
،وتبلغ قوّتهما ذروتها

68
00:05:10,370 --> 00:05:15,210
!سوف أتحدّاهما بجدّية وأفوز

69
00:05:15,770 --> 00:05:19,920
!سيكون نِزالاً أسطوريّاً

70
00:05:24,300 --> 00:05:26,310
أنت! إلى أين ذهبت؟

71
00:05:26,830 --> 00:05:29,220
!استمع إلى النّاس حتّى ينتهوا من الحديث

72
00:05:29,520 --> 00:05:33,550
غويان مُرهَق تماماً

73
00:05:35,910 --> 00:05:39,440
،ماذا نفعل؟ كينتا سيخبر الجميع

74
00:05:39,440 --> 00:05:41,910
وسيصبح هذا حديث المدرسة

75
00:05:42,240 --> 00:05:45,240
ورسم مياساكو-كن ينتشر أيضاً

76
00:05:45,530 --> 00:05:49,200
لا يجوز أن ندع الآخرين يكشفون أمرنا، لابّي

77
00:05:49,200 --> 00:05:52,510
،معه حقّ، تشوبّي. إذا حدث ذلك
فلن نتمكّن من البقاء

78
00:05:52,510 --> 00:05:54,670
في البلاد الخضراء بعد الآن، تشوبّي

79
00:05:54,940 --> 00:05:56,610
يجب أن نفعل شيئاً

80
00:05:56,610 --> 00:05:57,310
ماذا؟

81
00:05:58,190 --> 00:05:59,240
ما هذا؟

82
00:06:01,260 --> 00:06:03,460
هذا ميمينغا بلا شكّ

83
00:06:03,460 --> 00:06:04,550
!ميمينغا؟

84
00:06:04,840 --> 00:06:07,760
أجل، يُشبهون الميمينغا بشكل كبير

85
00:06:08,150 --> 00:06:12,240
قبل مدّة طويلة، تعلّمتُ الإثنولوجيا في الجامعة

86
00:06:12,240 --> 00:06:14,940
...هذه كلمات ياناغيدا كونيكيتشي

87
00:06:14,940 --> 00:06:18,980
إذا اشتهر الميمينغا، فإنّ كثيراً
من النّاس سوف ينجذبون إلى هنا

88
00:06:18,980 --> 00:06:19,770
أجل

89
00:06:19,770 --> 00:06:24,110
إن حدث ذلك، فسيزيد الطّلب
على استئجار القوارب

90
00:06:24,110 --> 00:06:26,820
!سيجعل هذا البلدة نابضة

91
00:06:26,820 --> 00:06:28,280
!هـ-هذا سيّئ

92
00:06:30,390 --> 00:06:32,250
...انتشر ذلك إلى هذا الحدّ

93
00:06:32,250 --> 00:06:33,290
ماذا الآن؟

94
00:06:33,290 --> 00:06:36,510
!والآن لنوزّع هذه على رابطة الحيّ

95
00:06:36,510 --> 00:06:38,710
وستذكر بأنّني أنا من اكتشفهم، صحيح؟

96
00:06:38,710 --> 00:06:39,460
!بالطّبع

97
00:06:40,240 --> 00:06:41,570
فلننطلق

98
00:06:42,750 --> 00:06:44,380
كينتا! انتظر لحظة

99
00:06:44,380 --> 00:06:46,310
يغدو الأمر حماسيّاً

100
00:06:46,310 --> 00:06:48,470
سيترتّب علينا التّفكير في شيء
بالنّسبة للمتجر

101
00:06:48,470 --> 00:06:51,230
!حسناً. لنبدأ بالعصف الذّهنيّ

102
00:06:51,530 --> 00:06:54,340
أو هذا ما تقوله الأسطورة

103
00:06:54,340 --> 00:06:57,340
رغم ذلك، كلّ هذا مجرّد فلكلور

104
00:07:01,350 --> 00:07:03,480
ماذا؟ لا أحد هنا؟

105
00:07:03,850 --> 00:07:07,280
!استمعوا للنّاس حتّى ينتهوا من الكلام

106
00:07:12,730 --> 00:07:16,610
الآن بعد أن انتشر الأمر بهذا الشّكل
الواسع، ماذا سيحدث تالياً؟

107
00:07:16,610 --> 00:07:18,380
!إنّه جاهز

108
00:07:18,730 --> 00:07:19,900
لنرَ، لنرَ

109
00:07:19,900 --> 00:07:21,960
!هذا يشبه ميمينغا

110
00:07:21,960 --> 00:07:23,290
ميمينغا؟

111
00:07:23,290 --> 00:07:26,390
أصبح ميمينغا حديث أهل البلدة

112
00:07:26,390 --> 00:07:30,450
يجب أن ننتهز الفُرصة، لذا أعددنا هذه

113
00:07:30,450 --> 00:07:31,620
!أبواق ميمينغا

114
00:07:35,420 --> 00:07:37,110
!إنّها ظريفة جدّاً

115
00:07:37,110 --> 00:07:39,900
،أليس كذلك؟ هذا ميمينغا ذكر

116
00:07:39,900 --> 00:07:41,480
وهذا ميمينغا أُنثى

117
00:07:42,700 --> 00:07:45,400
لا أستطيع حمل نفسي على أكلهم

118
00:07:46,310 --> 00:07:48,690
!أنا جائع، لابّي

119
00:07:48,690 --> 00:07:50,690
!اعتنيا بنا، تشوبّي

120
00:07:51,180 --> 00:07:52,030
حسناً، حسناً

121
00:07:52,330 --> 00:07:53,610
لحظة فقط

122
00:08:04,600 --> 00:08:06,770
،أعتقد هذا جيّد

123
00:08:06,770 --> 00:08:09,550
لكن شعرتُ وكأنّني آكل شيئاً آخر، لابّي

124
00:08:09,550 --> 00:08:12,140
بئساً. حسناً، حسناً

125
00:08:17,400 --> 00:08:19,950
!حان وقت الأكل، تشوبّي

126
00:08:17,400 --> 00:08:19,950
!حان وقت الأكل، لابّي

127
00:08:20,890 --> 00:08:24,120
أنتما تأكلان بشراهة رغم
الظّرف الّذي نحن فيه

128
00:08:25,680 --> 00:08:29,310
في الحقيقة، لا، لابّي. لا أمتلك
شهيّة، لابّي

129
00:08:31,050 --> 00:08:33,570
لا أستطيع حتّى إدخال الطّعام
في حلقي، تشوبّي

130
00:08:38,960 --> 00:08:41,960
رغم ذلك، أصبحت هذه مُشكلة حقيقيّة

131
00:08:42,360 --> 00:08:45,670
يجب علينا فعل شيء لتهدئة
هذه الفوضى، لابّي

132
00:08:45,670 --> 00:08:48,350
أجل، كنتُ أفكِّر في الشّيء ذاته

133
00:08:48,350 --> 00:08:50,400
...لذا في الأمس، أعددتُ هذه

134
00:08:51,920 --> 00:08:53,840
!الآن فهمت! أحسنتِ يا ماي

135
00:08:55,700 --> 00:08:57,760
ما... هذه، لابّي؟

136
00:09:04,190 --> 00:09:06,170
كنتُما هنا إذاً

137
00:09:06,560 --> 00:09:09,140
لِمَ هذا اللّباس يا كينتا؟

138
00:09:09,140 --> 00:09:11,450
إنَّ رابطة الحيّ الآن

139
00:09:11,450 --> 00:09:14,680
ستذهب في جولة صيد ميمينغا
في بستان الدّردار

140
00:09:14,680 --> 00:09:15,960
صـ-صيد ميمينغا؟

141
00:09:16,380 --> 00:09:18,440
!هذا حماسيٌّ حقّاً

142
00:09:18,440 --> 00:09:22,320
،بما أنّ هوشينو-كن ومياساكو هما من اكتشفاه
فسوف يكونان دليلينا

143
00:09:22,320 --> 00:09:23,960
!هذا مُدهش

144
00:09:23,960 --> 00:09:25,920
!ساكي، ميشو-سان، رافِقانا

145
00:09:26,310 --> 00:09:27,820
...حـ-حسناً

146
00:09:28,190 --> 00:09:29,380
...حسناً، لكن

147
00:09:48,560 --> 00:09:50,750
الكثير من النّاس مشغولون اليوم

148
00:09:51,200 --> 00:09:53,930
هل يُدرِّبون أجسادهم جميعاً؟

149
00:09:54,580 --> 00:09:58,610
سمعتُ بأنّ المرء يكسب السّعادة
إذا لمسَ أذن ميمينغا

150
00:09:58,610 --> 00:10:02,370
سمعتُ بأنّ المرء يصبح ثريّاً
إذا أمسكهم من الذّيل

151
00:10:02,370 --> 00:10:05,550
سمعتُ بأنّ المرء سيصبح منيعاً
أمام نزلات البرد إذا شواهم وأكلهم

152
00:10:05,980 --> 00:10:08,180
...سوف يشوينا، لابّي

153
00:10:08,180 --> 00:10:09,560
أنا خائفة، تشوبّي

154
00:10:09,560 --> 00:10:10,550
!صه

155
00:10:10,550 --> 00:10:14,580
قد يصبح ميمينغا نقطة جذب شهيرة للبلدة

156
00:10:14,580 --> 00:10:17,510
أجل، أعتقد سيُمثّل رمزاً عظيماً

157
00:10:17,510 --> 00:10:20,320
ما رأيك بتغيير اسمنا الثّنائي

158
00:10:20,320 --> 00:10:22,010
إلى "كينتا & ميمينغا"؟

159
00:10:22,010 --> 00:10:24,620
لماذا حذفت اسمي مجدّداً؟

160
00:10:27,140 --> 00:10:30,420
ساكي، متى ينبغي أن أخرِج "الأشياء"؟

161
00:10:30,420 --> 00:10:34,230
...لا أستطيع الجزم، الآن بينما الجميع مُتحمّسون

162
00:10:36,230 --> 00:10:38,240
...رأينا الميمينغا

163
00:10:38,240 --> 00:10:39,700
!هناك

164
00:10:39,700 --> 00:10:40,950
!حسناً

165
00:10:41,260 --> 00:10:45,560
توزّعوا واسلكوا اتِّجاهات مختلفة
!وابحثوا بشكل حثيث

166
00:10:45,560 --> 00:10:46,450
!حسناً

167
00:10:54,680 --> 00:10:56,680
جميعهم يعملون بجدّ

168
00:11:04,940 --> 00:11:07,760
ماذا تفعلون جميعاً هنا؟

169
00:11:07,760 --> 00:11:10,500
ماذا؟ لا أعرف من تكون

170
00:11:12,040 --> 00:11:13,310
هذه الأشياء

171
00:11:13,310 --> 00:11:15,970
،إنّها حيوانات نادرة تُدعى ميمينغا
ونحن نبحث عنهم

172
00:11:16,330 --> 00:11:20,370
"ميمينغا؟ لا، أعتقد اسمهم "فلابّي" و "تشوبّي

173
00:11:20,370 --> 00:11:24,460
لا، أنت مخطئ. هذه حيوانات
نادِرة تُعرَف بميمينغا

174
00:11:24,460 --> 00:11:26,030
لم تسمع عنهم؟

175
00:11:26,030 --> 00:11:30,920
خذ هذه، ساعدنا في صيد الميمينغا

176
00:11:32,070 --> 00:11:33,680
هؤلاء ميمينغا؟

177
00:11:33,680 --> 00:11:36,130
بالفعل. اسمهم ميمينغا

178
00:11:36,620 --> 00:11:38,800
قبل كلّ شيء، المخلوقات
...المعروفة باسم ميمينغا

179
00:11:39,150 --> 00:11:42,100
ذُكِرَتْ أوّل مرّة في الأدب في فترة نارا

180
00:11:42,100 --> 00:11:46,650
--في فترة إيدو، تكاثرت الأساطير حولهم، و

181
00:11:51,120 --> 00:11:53,930
!لماذا لا يصغي أحدٌ للرّواية بأكملها؟

182
00:12:14,620 --> 00:12:16,700
قد يكون من الصّعب قليلاً إخراجهم

183
00:12:17,190 --> 00:12:19,700
سيكون من السيّئ حقّاً أن يكشفونا الآن، لابّي

184
00:12:20,090 --> 00:12:22,670
لا نعلم ما قد يفعلونه لنا، تشوبّي

185
00:12:22,670 --> 00:12:25,660
لِمَ أنتما خائفان؟

186
00:12:26,440 --> 00:12:27,510
...أنت

187
00:12:27,510 --> 00:12:28,350
...المعذرة

188
00:12:28,630 --> 00:12:30,140
كينتوليسكي

189
00:12:31,920 --> 00:12:32,820
!فلابّي

190
00:12:32,820 --> 00:12:33,470
!تشوبّي

191
00:12:35,040 --> 00:12:37,480
!وجدتُ بعض الميمينغا

192
00:12:37,780 --> 00:12:38,610
أين؟

193
00:12:38,610 --> 00:12:39,600
أين هم؟

194
00:12:39,990 --> 00:12:42,070
!لم يكن هناك حاجة لذلك

195
00:12:42,430 --> 00:12:44,780
!أسرعوا وأمسكوهم قبل أن يفلتوا

196
00:12:46,010 --> 00:12:48,030
!انتظرني! أنا قادم في الحال

197
00:12:48,330 --> 00:12:49,870
!ساكي، من هنا

198
00:12:49,870 --> 00:12:50,370
حسناً

199
00:12:53,490 --> 00:12:55,810
يجب أن يكونوا على مقربة من هنا

200
00:12:55,810 --> 00:12:57,620
!يا رجال، لنبذل جهودنا الأخيرة

201
00:12:57,620 --> 00:12:58,900
!أجل

202
00:13:03,150 --> 00:13:04,430
ما-ماذا الآن؟

203
00:13:08,360 --> 00:13:09,250
من هنا

204
00:13:09,720 --> 00:13:10,990
ماذا تقول؟

205
00:13:10,990 --> 00:13:12,710
!لن نقع ضحيّة لخدعتك

206
00:13:25,720 --> 00:13:26,490
--نحن في

207
00:13:30,030 --> 00:13:31,620
~ساكي

208
00:13:32,050 --> 00:13:32,870
فلابّي؟

209
00:13:32,870 --> 00:13:33,970
~ماي

210
00:13:33,970 --> 00:13:35,060
تشوبّي؟

211
00:13:37,180 --> 00:13:39,240
غرفة تدريب الإتقان الخاصّة

212
00:13:39,240 --> 00:13:42,090
أو بعبارة أخرى، غرفتي. يا مرحباً

213
00:13:42,440 --> 00:13:45,130
...لا مجال للنّقاش! فضلاً عن ذلك

214
00:13:45,130 --> 00:13:47,310
!دع فلابّي وتشوبّي يذهبان

215
00:13:47,310 --> 00:13:49,050
ما هذا المكان بالضّبط على أيّ حال؟

216
00:13:49,710 --> 00:13:52,240
هذه البيئة هي ساحة تدريب قتاليّ

217
00:13:52,240 --> 00:13:55,890
مُجهّزة بأحدث معدّات تنمية العضلات

218
00:13:56,300 --> 00:13:59,400
يمكنكما تنمية عضلاتكما بواسطة
أي آلة من اختياركما

219
00:13:59,810 --> 00:14:01,400
!هذا ليس وقت المُزاح

220
00:14:01,400 --> 00:14:03,770
!ليس عندما يكون فلابّي وتشوبّي في خطر

221
00:14:04,240 --> 00:14:08,230
إذاً هذه الأشياء مهمّة جدّاً بالنّسبة لكما؟

222
00:14:08,540 --> 00:14:09,840
!بكلّ تأكيد

223
00:14:09,840 --> 00:14:13,410
!فلابّي وتشوبّي صديقانا العزيزان

224
00:14:13,890 --> 00:14:16,720
،أجل، فهمت. لولاهما

225
00:14:16,720 --> 00:14:20,080
فلن تتمكّنا من التحوُّل ومقاتلتي، أليس كذلك؟

226
00:14:20,420 --> 00:14:21,830
!أوزاينا

227
00:14:36,760 --> 00:14:40,900
،أجل... الآن بعد أن أتيتُما إلى هنا
لا يمكنكما الهرب من دون قتال

228
00:14:41,250 --> 00:14:43,150
!سوف أدرّبكما بملء قلبي

229
00:14:43,150 --> 00:14:44,660
!تحوّلا

230
00:14:47,130 --> 00:14:48,180
!فلابّي

231
00:14:48,180 --> 00:14:49,260
!تشوبّي

232
00:14:48,740 --> 00:14:49,560
...ساكي

233
00:14:49,560 --> 00:14:50,980
...ماي

234
00:14:57,260 --> 00:15:00,210
!القوّة الرّوحيّة المزدوجة

235
00:15:12,220 --> 00:15:13,780
!أنيري المستقبل

236
00:15:14,300 --> 00:15:15,560
!مُدّينا بالشّجاعة

237
00:15:23,630 --> 00:15:27,280
!القمر الّذي يملأ السّماوات، كيور برايت

238
00:15:28,160 --> 00:15:31,440
!الرّياح الّتي تُعطِّر الأرض، كيور ويندي

239
00:15:32,750 --> 00:15:34,080
!نحن بريكيور

240
00:15:35,310 --> 00:15:37,790
...إلى من يُدنِّسون النّوافير المُقدّسة

241
00:15:38,670 --> 00:15:41,950
!أوقفوا سلوككم القاسي

242
00:15:42,310 --> 00:15:43,770
!لنشرع في ذلك

243
00:16:01,700 --> 00:16:03,230
!ممتاز

244
00:16:03,670 --> 00:16:06,770
أشعر بأنّ نِزال اليوم قد يُسجَّل
في كُتُب التّاريخ

245
00:16:06,770 --> 00:16:09,250
!كفى كلاماً يُرضي مصالحك فقط

246
00:16:09,250 --> 00:16:10,550
،قد نكون بخير حاليّاً

247
00:16:10,550 --> 00:16:14,070
لكن يجب أن نفعل شيئاً بشأن
!الجلبة حول فلابّي وتشوبّي

248
00:16:14,070 --> 00:16:16,290
!لا نملك وقتاً نهدره معك

249
00:16:16,600 --> 00:16:20,080
ما زلتُما تتفوّهان بكلام مُراوغ كهذا؟

250
00:16:20,380 --> 00:16:22,590
سيترتّب عليّ منحكما تدريباً إضافيّاً

251
00:16:22,590 --> 00:16:23,630
!أوزاينا

252
00:16:29,600 --> 00:16:30,790
!ماذا كان سبب ذلك؟

253
00:16:31,240 --> 00:16:34,710
فكّرتُ في أن أدعكما ترتديان أثقالاً

254
00:16:34,710 --> 00:16:37,550
لأجل النّزاهة، سوف أرتدي
بعض الأثقال كذلك بالطّبع

255
00:16:37,550 --> 00:16:38,690
!أوزاينا

256
00:16:41,920 --> 00:16:44,060
المقاس مثاليّ

257
00:16:44,060 --> 00:16:46,320
!والآن، ارتدوها أيضاً

258
00:16:46,320 --> 00:16:47,890
...لن نرتدي

259
00:16:47,890 --> 00:16:49,010
!أشياء ثقيلة كهذه...

260
00:16:55,290 --> 00:16:56,650
!حذارِ، موبّو

261
00:16:58,180 --> 00:16:59,280
!قوّة القمر

262
00:17:00,970 --> 00:17:02,160
!قوّة الرّياح

263
00:17:03,330 --> 00:17:05,820
!سبلاش تارن

264
00:17:21,680 --> 00:17:22,620
!أيُّها النُّور

265
00:17:27,050 --> 00:17:27,900
!أيّتها الرّياح

266
00:17:32,070 --> 00:17:34,270
!لم يبدأ أكثر التّدريبات شدّة بعد

267
00:18:01,940 --> 00:18:05,860
!يا قوّة الأرواح! يا بريق الحياة

268
00:18:05,860 --> 00:18:08,730
!أرشدي قلبينا نحو الأمل

269
00:18:09,730 --> 00:18:10,810
...بريكيور

270
00:18:11,150 --> 00:18:13,760
...النّجم اللّولبيّ

271
00:18:14,730 --> 00:18:16,700
!سبلاش

272
00:18:37,290 --> 00:18:39,920
!يجب أن أبحث عن غرفة تدريب جديدة

273
00:18:39,920 --> 00:18:40,460
!ابتعاد

274
00:18:57,010 --> 00:18:58,540
!وجدتُك، لابّي

275
00:18:58,540 --> 00:19:00,160
!وجدتُك، تشوبّي

276
00:19:01,880 --> 00:19:03,400
!هـ-ها هما

277
00:19:03,400 --> 00:19:04,640
!هنا

278
00:19:05,510 --> 00:19:06,490
حقّاً؟

279
00:19:08,180 --> 00:19:09,300
!كينتا

280
00:19:09,690 --> 00:19:10,890
أ-أين هما؟

281
00:19:10,890 --> 00:19:13,040
!الميمينغا هنا في تلك الشّجيرة

282
00:19:17,020 --> 00:19:17,800
!حقّاً؟

283
00:19:18,040 --> 00:19:21,570
جميعكم، آسفتان لأنّنا سبّبنا
مثل هذه المتاعب

284
00:19:21,840 --> 00:19:25,010
ما ظننتُم بأنّه ميمينغا كان
هذه الأشياء في الواقع

285
00:19:26,760 --> 00:19:31,110
كنّا نتمرّن على عرض تحريك
دُمى هنا في الأمس

286
00:19:31,110 --> 00:19:32,540
عرض تحريك دُمى؟

287
00:19:32,540 --> 00:19:33,250
أجل

288
00:19:33,250 --> 00:19:37,250
أردنا تقديم المساعدة في حفلة
في المكتبة حيث يعمل أندو-سان

289
00:19:37,550 --> 00:19:39,160
كنتُما تتمرّنان سرّاً إذاً

290
00:19:39,550 --> 00:19:40,860
كنتُما؟

291
00:19:41,350 --> 00:19:44,560
ما رآه كينتا ومياساكو-كن كان هذه
الأشياء، أليس كذلك؟

292
00:19:46,700 --> 00:19:50,240
...أجل، رأيتُ هذه الأشياء بالفعل، لكن

293
00:19:50,530 --> 00:19:54,040
أ-أجل، قد يكون الأمر كذلك

294
00:19:54,320 --> 00:19:56,800
،خطّطنا حقّاً للاعتراف

295
00:19:56,800 --> 00:19:59,140
...لكن عمّت الفوضى في البلدة بأكملها

296
00:19:59,830 --> 00:20:02,220
!نحن آسفتان حقّاً بشأن ذلك

297
00:20:02,480 --> 00:20:03,450
...ساكي

298
00:20:04,720 --> 00:20:08,500
أعتذر عن المتاعب الّتي سبّبَتْها لكم ابنتي

299
00:20:09,070 --> 00:20:11,810
لا، ساكي-تشان وماي-سان
ليستا المُلامتين هنا

300
00:20:11,810 --> 00:20:13,990
ابني هو من أثار الأمور

301
00:20:14,500 --> 00:20:16,450
كينتا! حريّ بك أن تعتذر

302
00:20:16,450 --> 00:20:18,090
...أ-أبي

303
00:20:18,090 --> 00:20:20,690
لا يا جماعة. أهكذا ينبغي
أن يكون الأمر حقّاً؟

304
00:20:21,530 --> 00:20:26,160
،قبل أن توبّخوا هؤلاء الأطفال
يجب أن تسمعوا نهاية قصّتي

305
00:20:26,740 --> 00:20:28,900
طوال هذا الوقت، كنتُ أقول

306
00:20:28,900 --> 00:20:32,000
أنَّ ميمينغا مخلوقات تسكن
في عالم الفلكلور

307
00:20:32,000 --> 00:20:33,050
ماذا؟

308
00:20:33,050 --> 00:20:34,350
إنّها غير موجودة؟

309
00:20:34,350 --> 00:20:36,120
حسناً، هذا مؤسف

310
00:20:36,690 --> 00:20:39,370
،أنتم المُلامون على هذه الفوضى

311
00:20:39,370 --> 00:20:42,840
لأنّكم لم تستمعوا للنّاس حتّى
ينتهوا من الكلام؟

312
00:20:44,930 --> 00:20:46,960
أجل، كما تقول

313
00:20:47,710 --> 00:20:50,520
بالفعل، أنت تقول الحقيقة

314
00:20:53,810 --> 00:20:58,180
كلّ هذه الجلبة كانت غلطتي، أنا آسف

315
00:20:58,490 --> 00:20:59,520
سامحوني رجاء

316
00:20:59,850 --> 00:21:02,850
لا يا كينتا-كن، لا تقلق بشأن ذلك

317
00:21:02,850 --> 00:21:05,840
هذا صحيح. استمتعتُ بوقتي حقّاً

318
00:21:05,840 --> 00:21:07,560
!كان ذلك حماسيّاً

319
00:21:07,560 --> 00:21:09,730
،عند التّعبير عن ذلك بهذه الطّريقة
فلا يمكنني مخالفتك

320
00:21:10,320 --> 00:21:13,470
مضى وقت منذ ذهبتُ للتمشّي
في الجبال بهذا الشّكل

321
00:21:13,740 --> 00:21:17,050
من اللّطيف أن يجتمع الجميع
بين الحين والآخر، صحيح؟

322
00:21:17,050 --> 00:21:19,890
أجل، أجل. يجدر بنا أن نفعل
شيئاً كهذا من جديد

323
00:21:19,890 --> 00:21:22,160
!هذا مُؤكَّد! لنفعلها

324
00:21:24,190 --> 00:21:26,130
!أنا متشوّق لهذا

325
00:21:26,550 --> 00:21:28,880
،كنتُ قلقة ممّا ستؤول إليه الأمور

326
00:21:28,880 --> 00:21:30,600
لكن يمكنني الاسترخاء أخيراً الآن

327
00:21:30,600 --> 00:21:32,970
لكن ما زال ذلك يؤلمني قليلاً

328
00:21:32,970 --> 00:21:37,480
في النّهاية، انتهى المطاف بنا
بخِداع هوشينو-كن ومياساكو-كن

329
00:21:38,100 --> 00:21:38,980
هذا ما أعتقده

330
00:21:39,270 --> 00:21:41,960
!على أيّ حال، أنقذتُمانا، لابّي

331
00:21:41,960 --> 00:21:43,440
!شكراً، تشوبّي

332
00:21:47,380 --> 00:21:48,500
لنتحرّك

333
00:21:48,500 --> 00:21:49,220
!حسناً

334
00:21:53,130 --> 00:21:55,740
بجدّية! ميمينغا؟

335
00:21:56,000 --> 00:21:58,630
مُحال أن يكون موجوداً

336
00:23:42,300 --> 00:23:44,280
!عيد ميلاد سعيد يا ماي

337
00:23:44,280 --> 00:23:46,320
هذه هديّتي لكِ

338
00:23:46,320 --> 00:23:47,610
!شكراً لكِ يا ساكي

339
00:23:49,040 --> 00:23:49,820
...أنا

340
00:23:49,820 --> 00:23:53,060
لم أتلقَّ رسالة تحدٍّ من قبل

341
00:23:53,530 --> 00:23:54,930
سأحتفظ بها للأبد

342
00:23:54,930 --> 00:23:56,070
!مـ-مهلاً

343
00:23:56,070 --> 00:23:58,040
!كُتِبَتْ هذه بواسطة كينتوليسكي

344
00:23:58,990 --> 00:24:01,240
!نحن بريكيور سبلاش

345
00:24:01,240 --> 00:24:04,680
!ضوضائيّ للغاية
عيد ميلاد مع كينتوليسكي

346
00:24:04,680 --> 00:24:07,090
سنكون بأفضل هيئة بقوّة الإثارة الهائلة
والتّشويق الهائل