1
00:00:01,850 --> 00:00:06,310
ميتشيرو وكاورو كانتا صديقتينا العزيزتين

2
00:00:08,900 --> 00:00:11,270
،كانتا غريبتين قليلاً

3
00:00:11,940 --> 00:00:14,230
لكن تمكنّا من الانسجام معاً جميعاً

4
00:00:16,940 --> 00:00:17,780
صديقتان"؟"

5
00:00:18,370 --> 00:00:20,230
نحن صديقتاكِ يا ساكي؟

6
00:00:20,490 --> 00:00:23,580
!كانت أوّل مرّة تُنادينني فيها باسمي

7
00:00:24,370 --> 00:00:25,750
!أنا مسرورة للغاية

8
00:00:25,750 --> 00:00:29,530
يبدو وكأنّنا أصبحنا صديقات حقيقيّات

9
00:00:29,530 --> 00:00:30,900
!أنا غاية في السّعادة

10
00:00:32,580 --> 00:00:34,560
!سوف أدمّركما

11
00:00:41,900 --> 00:00:43,960
ساكي. ماي

12
00:00:45,550 --> 00:00:48,600
كان تشكيل صداقة معكما مُمتعاً للغاية

13
00:00:49,230 --> 00:00:53,940
سعادة... حزن... منحتمانا مُختلف أشكال السّعادة

14
00:00:54,510 --> 00:00:55,390
!ميتشيرو

15
00:00:55,390 --> 00:00:56,600
!كاورو-سان

16
00:01:03,470 --> 00:01:06,620
ميتشيرو وكاورو حميانا

17
00:01:07,750 --> 00:01:09,960
...لكنّنا

18
00:01:12,770 --> 00:01:15,220
"،إذا استمررت في تعميق الشّعور تجاههما"

19
00:01:15,620 --> 00:01:17,440
"ستتحقّق أمنيتك"

20
00:01:20,540 --> 00:01:21,450
...ثمّ

21
00:01:30,260 --> 00:01:31,710
!أهلاً بعودتكما

22
00:01:32,140 --> 00:01:33,130
ميتشيرو

23
00:01:33,130 --> 00:01:34,170
كاورو-سان

24
00:03:02,560 --> 00:03:06,310
رغم ذلك، كنتُما في خطر حقيقيّ، لابّي

25
00:03:06,310 --> 00:03:08,920
،لكن نجوتما بطريقة ما

26
00:03:08,920 --> 00:03:11,170
!بفضل ميتشيرو وكاورو، لابّي

27
00:03:11,170 --> 00:03:13,240
!أجل، هذا مُؤكّد

28
00:03:13,560 --> 00:03:16,040
لكن كيف تمكّنوا من العودة، لابّي؟

29
00:03:16,480 --> 00:03:17,550
لا أعلم

30
00:03:17,960 --> 00:03:20,330
كنّا غائبتين عن الوعي لبعض الوقت

31
00:03:20,330 --> 00:03:21,720
اسمحوا لي أن أشرح

32
00:03:22,680 --> 00:03:25,500
!أنت، لا تُخِفني هكذا

33
00:03:25,500 --> 00:03:27,890
...الأمر جوهريّاً

34
00:03:31,820 --> 00:03:37,320
مشاعركن العميقة تجاه بعضكن الآخر
قد أنشت قوّةً جديدة

35
00:03:37,320 --> 00:03:42,770
رابطكن المتين وقوّة الأرواح تغلّبتْ
على قوّة التّدمير

36
00:03:43,310 --> 00:03:44,740
وهذا ما في الأمر

37
00:03:45,040 --> 00:03:46,650
قوّة رابطنا؟

38
00:03:46,650 --> 00:03:51,280
على أيّ حال، يسرّنا أن تتمكّن ميتشيرو-سان
وكاورو-سان من العودة

39
00:03:51,280 --> 00:03:51,990
!أجل

40
00:03:54,850 --> 00:03:57,250
!نحن مُمتنّان أيضاً، موبّو

41
00:03:57,250 --> 00:04:00,620
!أنقذتُمانا في نافورة السّماء، بوبّو

42
00:04:00,620 --> 00:04:02,410
!شكراً لكما، موبّو-
!شكراً لكما، بوبّو-

43
00:04:02,410 --> 00:04:03,380
هذا يكفي

44
00:04:03,380 --> 00:04:05,560
لم نفعل شيئاً نستحقّ الشّكر عليه

45
00:04:11,840 --> 00:04:13,270
ماذا؟

46
00:04:13,660 --> 00:04:14,740
مينوري

47
00:04:17,180 --> 00:04:19,860
كاورو-أونيسان؟ من هذه؟

48
00:04:21,760 --> 00:04:23,350
...مـ-مينوري، في الواقع

49
00:04:23,350 --> 00:04:24,890
...إنّهما

50
00:04:27,790 --> 00:04:29,680
!كاورو-أونيسان

51
00:04:30,880 --> 00:04:35,970
عليّ كتابة تقرير عن كِتاب للمدرسة

52
00:04:35,970 --> 00:04:37,900
هلّا علّمتِني الطّريقة؟

53
00:04:39,450 --> 00:04:42,740
إذا فعلتُ ذلك، فسيصبح تقريري أنا

54
00:04:42,740 --> 00:04:45,810
عليكِ أن تقرئيه وتدوّني أفكاركِ الخاصّة عنه

55
00:04:45,810 --> 00:04:49,460
...أفكاري الخاصّة؟ يبدو هذا صعباً

56
00:04:49,700 --> 00:04:51,960
!لكن سأحاول قراءته

57
00:04:52,740 --> 00:04:55,450
ماذا؟ ما الّذي يجري؟

58
00:04:59,480 --> 00:05:03,980
!ليس حلماً
يوم مع الجميع

59
00:05:04,600 --> 00:05:07,510
ألم أطلب منكما العثور على الأميرة؟

60
00:05:07,510 --> 00:05:10,150
ماذا كنتُما تفعلان؟

61
00:05:10,750 --> 00:05:13,610
،الحقيقة هي أنّنا كنّا على وشك الانتصار

62
00:05:13,610 --> 00:05:16,200
حتّى اعترضتْ ميتشيرو وكاورو طريقنا

63
00:05:16,200 --> 00:05:20,540
!كيف سمحتُما لمثليهما أن تُعيقانكما؟

64
00:05:21,170 --> 00:05:24,370
اطمئنّ يا أكودايكان-ساما

65
00:05:24,370 --> 00:05:26,410
،ما دام لدينا الغرّافة هنا

66
00:05:26,410 --> 00:05:29,870
لا يمكنهن إحياء بلاد النّوافير

67
00:05:29,870 --> 00:05:35,420
في هذه الأثناء، سوف أسحق ميتشيرو
وكاورو وبريكيور

68
00:05:35,420 --> 00:05:39,690
أليس كذلك يا كينتوليسكي-دونو
ومويرومبا-دونو؟

69
00:05:40,220 --> 00:05:42,670
!بالطّبع، لن نرحم الخوَنة

70
00:05:42,670 --> 00:05:44,980
!سأطاردهما بأقصى قدراتي

71
00:05:44,980 --> 00:05:47,350
سأقدّم أفضل أداء على الإطلاق

72
00:05:47,620 --> 00:05:49,170
!تشا-تشا-تشا

73
00:05:49,170 --> 00:05:51,990
!هذا ليس استعراضاً، إنّه نِزال جادّ

74
00:05:58,090 --> 00:06:00,090
صرنا في منتصف ديسمبر

75
00:06:00,430 --> 00:06:04,470
قد تكون دراستكن صعبة، لكن
عليكن المُواظبة عليها

76
00:06:01,990 --> 00:06:06,290
يسرّني أنّ الأمور تبدو وكأنّهما
كانا هنا دوماً

77
00:06:04,470 --> 00:06:06,820
لا تسمحنَ لأيّ شيء يلهيكن

78
00:06:06,290 --> 00:06:09,580
أجل. الجميع هنا رحّبنَ بهما بشكل طبيعيّ

79
00:06:09,830 --> 00:06:13,640
بوضع ذلك بالحسبان، ستبدأ الامتحانات
النّهائية غداً أخيراً

80
00:06:13,640 --> 00:06:16,020
أتأمّل منكن بذل قصارى جهدكن

81
00:06:16,020 --> 00:06:16,930
!حاضر

82
00:06:17,230 --> 00:06:19,040
الامتحانات النّهائيّة؟

83
00:06:19,040 --> 00:06:22,270
...لكن ميتشيرو وكاورو عادتا للتو

84
00:06:22,710 --> 00:06:24,110
هل ستكون الأمور على ما يُرام؟

85
00:06:24,110 --> 00:06:27,400
،إذا كان عليكِ طرح هذا السّؤال
فالأفضل أن تدرسي بجدٍّ أكبر

86
00:06:27,400 --> 00:06:28,630
!حـ-حاضرة

87
00:06:31,730 --> 00:06:34,950
...ميتشيرو، كاورو، حريّ بكما أن تبدآ الآن وإلّا

88
00:06:35,740 --> 00:06:36,750
وإلّا ماذا؟

89
00:06:36,750 --> 00:06:39,260
ستحضران دروس حشو للامتحانات

90
00:06:39,260 --> 00:06:41,940
مبدئيّاً، سنعمل على تعويضكما بما فات

91
00:06:41,940 --> 00:06:45,530
هذا صحيح. الأقسام المطلوبة
...لاختبار الرّياضيّات هي

92
00:06:45,530 --> 00:06:48,650
تبدأ من هنا، وتنتهي هنا

93
00:06:48,650 --> 00:06:51,190
...أجل، أجل! ثمّ اختبار الإنجليزيّ

94
00:06:51,190 --> 00:06:52,590
هذه الفقرة هنا؟

95
00:06:52,590 --> 00:06:55,590
من الدّرس 8 حتّى الدّرس 12

96
00:06:55,590 --> 00:06:57,180
هل أنتِ بخير يا ساكي؟

97
00:06:57,180 --> 00:06:59,920
...أجل، بالطّبع

98
00:07:00,310 --> 00:07:03,900
.من الأفضل أن ندرس كلّ شيء
ما رأيكما بالمجيء إلى منزلي اليوم؟

99
00:07:12,730 --> 00:07:15,160
،حتّى لو لم تُساعدانا في الدّراسة

100
00:07:15,540 --> 00:07:18,410
سنتذكّر كلّ شيء في الكتُب حالما نقرأها

101
00:07:18,800 --> 00:07:21,740
فضلاً عن ذلك، الاختبارات لا تهمّنا من الأساس

102
00:07:23,310 --> 00:07:25,750
لكن تلكما الاثنتين لطالما كانتا كذلك

103
00:07:26,740 --> 00:07:30,630
دائماً ما تقلقان بجنون تجاهنا

104
00:07:32,170 --> 00:07:36,720
إنَّ رؤيتهما تُشعرني وكأنّنا
عدنا إلى الدّيار حقّاً

105
00:07:37,170 --> 00:07:38,160
أجل

106
00:07:41,200 --> 00:07:42,330
!ميتشيرو

107
00:07:42,330 --> 00:07:43,600
!كاورو-سان

108
00:07:44,900 --> 00:07:46,600
!بسرعة، بسرعة

109
00:07:53,790 --> 00:07:55,640
!أنا جائع، موبّو

110
00:07:55,640 --> 00:07:57,410
!أريد أن آكل، بوبّو

111
00:07:57,410 --> 00:07:59,290
!أريد طعاماً خفيفاً، لابّي

112
00:07:59,290 --> 00:08:00,700
!وكذلك أنا، تشوبّي

113
00:08:02,410 --> 00:08:04,960
!حسناً، فهمت، فهمت

114
00:08:11,090 --> 00:08:12,420
!شكراً لك، موبّو

115
00:08:12,420 --> 00:08:13,930
!حان وقت الأكل، بوبّو

116
00:08:17,260 --> 00:08:19,430
والآن يمكننا الدّراسة بسلام وهدوء

117
00:08:19,740 --> 00:08:23,160
كاورو-أونيسان، أكملتُ تقرير الكِتاب
!الخاصّ بي. ألقي نظرة

118
00:08:23,160 --> 00:08:26,380
مينوري، ألم أقل لكِ ألّا تدخلي
قبل أن ننتهي من الدّراسة؟

119
00:08:26,380 --> 00:08:27,640
...لكن

120
00:08:27,640 --> 00:08:29,060
لا مُشكلة، أريني

121
00:08:29,060 --> 00:08:29,880
!حسناً

122
00:08:30,190 --> 00:08:31,640
...بئساً

123
00:08:34,870 --> 00:08:36,650
لا بأس

124
00:08:37,560 --> 00:08:40,030
لن نصل إلى نتيجة هكذا

125
00:08:44,420 --> 00:08:45,610
لماذا؟

126
00:08:46,140 --> 00:08:48,970
لماذا ينسجِمن جيّداً معاً هكذا؟

127
00:08:48,970 --> 00:08:53,710
كلّما كان عدد الخصوم أكبر، كان
العرض أروع، سينيور

128
00:08:54,030 --> 00:08:57,930
!أقول لك باستمرار بأنّه ليس عرضاً
!هذا نِزال حقيقيّ

129
00:08:58,660 --> 00:09:02,390
يجب أن نُنزِل العقاب عليهن

130
00:09:09,710 --> 00:09:11,330
لقد استمتعتُ اليوم

131
00:09:12,420 --> 00:09:13,170
أجل

132
00:09:14,500 --> 00:09:17,870
أشعر بسكينة عندما أكون معهما

133
00:09:18,520 --> 00:09:19,950
ما السّبب؟

134
00:09:20,490 --> 00:09:22,010
لا أدري

135
00:09:22,010 --> 00:09:24,370
لكن يراودني نفس شعوركِ

136
00:09:25,600 --> 00:09:26,900
كاورو؟

137
00:09:28,920 --> 00:09:31,880
ألن يكون من اللّطيف أن نبقى هكذا للأبد؟

138
00:09:37,010 --> 00:09:40,090
،الأوقات السّعيدة لا تدوم طويلاً

139
00:09:40,670 --> 00:09:42,460
سينيوريتّا

140
00:09:42,460 --> 00:09:43,840
صحيح

141
00:09:45,170 --> 00:09:50,400
أحتاج شرحاً كاملاً عن سبب
خيانتكما لأكودايكان-ساما

142
00:09:51,810 --> 00:09:53,900
!إنّه وقت العرض

143
00:09:56,240 --> 00:09:57,520
أراكِ غداً

144
00:09:57,520 --> 00:09:58,430
حسناً

145
00:10:01,370 --> 00:10:03,140
كوروني... يركض

146
00:10:03,700 --> 00:10:05,720
وهو ليس بطيئاً أيضاً

147
00:10:05,720 --> 00:10:09,400
مـ-مهلاً! ألن يكون من الأسرع
!أن يركض على أربعة أطراف؟

148
00:10:09,400 --> 00:10:10,800
!الوقت يُداهمنا

149
00:10:10,800 --> 00:10:12,660
!ظهر أولئك من جديد

150
00:10:14,540 --> 00:10:16,430
...يراودني إحساس سيّئ

151
00:10:16,780 --> 00:10:18,680
!ميتشيرو وكاورو في خطر

152
00:10:27,110 --> 00:10:31,880
سأريكما ما الّذي يحدث لأولئك
!الّذين يخونون أكودايكان-ساما

153
00:10:37,660 --> 00:10:38,840
!مهلاً

154
00:10:39,310 --> 00:10:41,520
سيكون خصمكِ أنا

155
00:10:47,640 --> 00:10:51,600
!والآن لنبدأ هذه الحفلة، سينيوريتّا

156
00:11:23,420 --> 00:11:25,770
ما الأمر؟ يمكنكِ الردّ

157
00:11:38,340 --> 00:11:39,980
يبقى النِّزال نِزالاً

158
00:11:40,580 --> 00:11:43,250
ودائماً ما أخوض معاركي بأقصى قوّة

159
00:11:43,820 --> 00:11:46,550
!حتّى لو كان خصومي خوَنة بغيضين

160
00:11:48,140 --> 00:11:49,970
اعتبرونا ما شئتم

161
00:11:52,540 --> 00:11:57,260
لكن لا نعتقد بأنّنا مُخطئتان

162
00:11:57,620 --> 00:11:59,450
لستُما مُخطئتين؟

163
00:11:59,940 --> 00:12:03,230
ألا تشعران بأي التزام تجاه أكودايكان-ساما؟

164
00:12:04,480 --> 00:12:06,870
نشعر بأنّنا مَدينتان بالطّبع

165
00:12:07,170 --> 00:12:09,870
لأنّه أنشأنا

166
00:12:10,790 --> 00:12:15,080
إذاً لماذا خنتُما مُنشئكما أكودايكان-ساما؟

167
00:12:16,290 --> 00:12:18,000
...كلماتكما وتصرّفاتكما

168
00:12:18,650 --> 00:12:22,350
!مُتناقضان تماماً، أليس كذلك؟

169
00:12:26,760 --> 00:12:28,920
أهذه هي حدود قِواكما؟

170
00:12:28,920 --> 00:12:30,810
!كونا جادّتين

171
00:12:34,200 --> 00:12:37,690
حسناً إذاً، من الأفضل أن ألهِب هذه الأجواء

172
00:12:37,690 --> 00:12:43,110
أورا أورا أورا أورا أورا
!أورا أورا أورا أورا

173
00:12:44,750 --> 00:12:45,360
!تشا

174
00:12:58,770 --> 00:13:01,210
يا إلهي. أهذه هي النّهاية بالفعل؟

175
00:13:14,620 --> 00:13:18,390
بالتّأكيد، لعلّ هناك تناقُض
بين كلماتنا وأفعالنا

176
00:13:19,540 --> 00:13:22,020
...لكنّنا

177
00:13:29,570 --> 00:13:34,330
!نريد أن نبقى مع ساكي وماي للأبد...

178
00:13:42,700 --> 00:13:45,170
أصبحتُما جادّتين أخيراً إذاً

179
00:13:46,190 --> 00:13:48,750
!أنا أشتعل حماساً أيضاً، سينيوريتّا

180
00:14:21,910 --> 00:14:23,290
تشا-تشا-تشا

181
00:14:30,500 --> 00:14:32,900
!لن أدعكما تفعلان ذلك، تشا-تشا

182
00:15:08,680 --> 00:15:13,680
تحسّرا على خيانة أكودايكان-ساما
واغرقا في عالم النّسيان

183
00:15:15,270 --> 00:15:16,850
!خذا هذه

184
00:15:21,620 --> 00:15:22,590
!ميتشيرو

185
00:15:22,590 --> 00:15:23,790
!كاورو-سان

186
00:15:25,170 --> 00:15:26,210
!ميتشيرو

187
00:15:26,210 --> 00:15:27,560
!كاورو-سان

188
00:15:33,380 --> 00:15:34,130
!ماذا؟

189
00:15:46,890 --> 00:15:48,520
!ساكي، ماي، بسرعة

190
00:15:48,520 --> 00:15:50,080
!تحوّلي، تشوبّي

191
00:15:52,910 --> 00:15:55,880
!القوّة الرّوحيّة المزدوجة

192
00:16:07,110 --> 00:16:08,360
!أنيري المستقبل

193
00:16:09,270 --> 00:16:10,570
!مدّينا بالشّجاعة

194
00:16:17,870 --> 00:16:21,700
!القمر الّذي يملأ السّماوات، كيور برايت

195
00:16:22,480 --> 00:16:25,870
!الرّياح الّتي تُعطِّر الأرض، كيور ويندي

196
00:16:27,350 --> 00:16:28,530
!نحن بريكيور

197
00:16:29,880 --> 00:16:32,290
...إلى من يُدنِّسون النّوافير المُقدّسة

198
00:16:33,170 --> 00:16:36,500
!أوقفوا سلوككم القاسي

199
00:16:37,310 --> 00:16:38,820
كيف وجدتانا؟

200
00:16:38,820 --> 00:16:40,230
لا يهمّ

201
00:16:40,230 --> 00:16:43,460
الآن، القضاء على الخائنتين
هو الأولويّة القصوى

202
00:16:43,460 --> 00:16:46,480
سنستغرق وقتنا في اللّعب معكما عقب ذلك

203
00:16:49,240 --> 00:16:50,470
!لن ندعكما

204
00:16:50,470 --> 00:16:52,990
!لا تؤذيا ميتشيرو-سان وكاورو-سان

205
00:16:54,060 --> 00:16:56,440
!لنساعد ميتشيرو وكاورو، موبّو-
!لنساعد ميتشيرو وكاورو، بوبّو-

206
00:16:57,030 --> 00:16:58,150
!قوّة القمر

207
00:16:59,920 --> 00:17:01,070
!قوّة الرّياح

208
00:17:02,270 --> 00:17:05,000
!سبلاش تارن

209
00:17:19,080 --> 00:17:21,780
!أنتما تعترضان طريقنا! ابتعدا

210
00:17:21,780 --> 00:17:22,260
!تشا-تشا

211
00:17:26,110 --> 00:17:27,130
...ساكي

212
00:17:30,510 --> 00:17:31,560
...ماي

213
00:17:42,680 --> 00:17:45,410
والآن، لنؤدّب الخائنتين

214
00:17:45,410 --> 00:17:46,490
!إنّه وقت العرض

215
00:17:50,440 --> 00:17:53,250
لن ندعكما تؤذيان ميتشيرو وكاورو

216
00:17:53,930 --> 00:17:56,540
هذا صحيح. لن ندعكما تلمسانهما

217
00:17:56,880 --> 00:17:58,750
...ألم أقل لكما

218
00:17:59,580 --> 00:18:01,900
!ألّا تتدخّلا؟

219
00:18:07,140 --> 00:18:08,910
ألا يمكنكما انتظار دوركما؟

220
00:18:08,910 --> 00:18:12,610
حسناً. سأحترم رغبتكما وأواجهكما أوّلاً

221
00:18:16,280 --> 00:18:18,040
...ظننتُ بأنّنا

222
00:18:18,430 --> 00:18:20,090
خصماكما؟...

223
00:18:24,800 --> 00:18:27,250
!هذا من جديد؟ تشا-تشا

224
00:18:31,110 --> 00:18:32,470
!إطلاق

225
00:18:37,440 --> 00:18:38,850
لماذا؟

226
00:18:38,850 --> 00:18:40,830
...تعلمان بأنّكما لا تستطيعان مُنافستهما

227
00:18:40,830 --> 00:18:42,420
!هذا غير مهمّ

228
00:18:43,430 --> 00:18:47,810
كنّا ننتظركما طوال هذا الوقت

229
00:18:48,600 --> 00:18:50,960
لا نريد أن نخسركما ثانية

230
00:18:51,350 --> 00:18:54,640
لذا سنبقى بجانبكما لتقديم
المساعدة كلّما تعرّضتما لخطر

231
00:18:55,660 --> 00:18:56,600
...ساكي

232
00:18:57,420 --> 00:18:58,290
...ماي

233
00:18:59,190 --> 00:19:01,640
!اشتعلي، اشتعلي، اشتعلي يا عزيزتي

234
00:19:01,640 --> 00:19:03,520
!أرينا عرضاً أخيراً

235
00:19:06,230 --> 00:19:07,120
ما الأمر؟

236
00:19:07,120 --> 00:19:09,960
هذه لحظة خطيرة. من الأفضل
الانسحاب حاليّاً

237
00:19:09,960 --> 00:19:13,650
هل فقدت الشّجاعة الآن، سينيور؟

238
00:19:13,650 --> 00:19:16,580
لا، لحظة. أتكلّم من باب الخبرة

239
00:19:16,580 --> 00:19:18,450
!إذا قاتلتهن الآن، ستُهزَم بكلِّ تأكيد

240
00:19:20,360 --> 00:19:25,090
في هذه الحالة، سأذهب بمفردي
!من أجل وقت عرض مُبهِر

241
00:19:25,090 --> 00:19:27,050
!مويرومبا

242
00:19:25,330 --> 00:19:27,550
!لا، لا تذهب! عُد إلى هنا يا مويرومبا

243
00:19:27,550 --> 00:19:28,280
تشا؟

244
00:19:36,510 --> 00:19:38,120
!افعلاها الآن

245
00:19:58,110 --> 00:20:01,510
!يا نور الأرواح! يا بريق الحياة

246
00:20:02,090 --> 00:20:04,960
!أرشِد قلبينا نحو الأمل

247
00:20:06,100 --> 00:20:07,380
...بريكيور

248
00:20:07,380 --> 00:20:10,220
...النّجم اللّولبيّ

249
00:20:11,340 --> 00:20:13,600
!!سبلاش

250
00:20:24,910 --> 00:20:29,290
مستحيل! يبدو أنّ وقتي للاشتعال
قد حان، سينيوريتّا

251
00:20:40,630 --> 00:20:44,420
لا أصدِّق بأنّ قوّتهن المُتضافِرة
...أصبحت بهذه العظَمة

252
00:20:50,000 --> 00:20:51,600
...ساكي، ماي

253
00:20:52,110 --> 00:20:56,310
بصراحة، أردتُ أن أؤمن
بأنّكما سوف تأتيان

254
00:20:57,060 --> 00:21:00,400
راودني نفس الشّعور. لماذا؟

255
00:21:01,360 --> 00:21:03,030
أليس هذا واضحاً؟

256
00:21:03,030 --> 00:21:05,460
...أجل. ففي النّهاية

257
00:21:06,920 --> 00:21:08,470
!نحن صديقتان...

258
00:21:15,000 --> 00:21:17,670
سأعيد لكُن أوراق اختباراتكن الأخيرة

259
00:21:17,670 --> 00:21:20,400
هيوغا، بذلتِ جهداً ممتازاً

260
00:21:20,690 --> 00:21:21,420
ماذا؟

261
00:21:22,160 --> 00:21:23,870
كـ-كلّ هذا؟

262
00:21:24,420 --> 00:21:26,380
يمكنكِ المُحاولة عند المُحاولة

263
00:21:28,200 --> 00:21:29,840
!مرحى

264
00:21:29,840 --> 00:21:32,530
،لم أتفوّق على علامتكِ والّتي هي 85

265
00:21:32,530 --> 00:21:34,560
لكن بالنّسبة لي، إنّها علامة ممتازة

266
00:21:34,560 --> 00:21:37,210
يعزو كلّ الفضل للدّراسة مع ميتشيرو-سان
وكاورو-سان، أليس كذلك؟

267
00:21:37,210 --> 00:21:38,000
!أجل

268
00:21:38,360 --> 00:21:41,440
على ذكر الأمر، ما العلامة الّتي حصلَتْ
عليها ميتشيرو وكاورو يا تُرى؟

269
00:21:44,310 --> 00:21:45,530
هذا مُذهل

270
00:21:46,040 --> 00:21:49,770
كلّ هذا لأنّنا درسنا معكما، صحيح؟

271
00:21:50,140 --> 00:21:50,790
أجل

272
00:21:51,720 --> 00:21:53,040
شكراً لكما

273
00:21:53,340 --> 00:21:55,840
أنتما تُحرجانني

274
00:23:42,430 --> 00:23:44,480
!انظري إلى جبل القرود هذا

275
00:23:44,480 --> 00:23:46,020
!إنّهم مُنسجمون جيّداً

276
00:23:46,020 --> 00:23:48,520
ساكي، إنّهما يتصرّفان بغرابة

277
00:23:48,520 --> 00:23:49,980
تقصدين ميتشيرو وكاورو؟

278
00:23:49,980 --> 00:23:51,910
ربّما ألغيا الفطور

279
00:23:51,910 --> 00:23:53,810
!مُحال أن يكون هذا صحيحاً

280
00:23:53,810 --> 00:23:58,300
أعتقد نحن الوحيدتان اللّتان نستطيع
الاستماع إلى همومهما

281
00:23:59,100 --> 00:24:01,000
!نحن بريكيور سبلاش

282
00:24:01,000 --> 00:24:04,620
ستختفي تلكما الاثنتان؟
ميتشيرو وكاورو، تتألّمان

283
00:24:04,620 --> 00:24:08,170
سنكون بأفضل هيئة بقوّة الإثارة الهائلة
والتّشويق الهائل