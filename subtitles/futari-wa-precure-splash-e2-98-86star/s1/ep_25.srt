1
00:00:06,940 --> 00:00:08,450
!كلّ شيء مُتلألئ، موبّو

2
00:00:08,450 --> 00:00:09,620
!هذا جميل جدّاً، بوبّو

3
00:00:19,620 --> 00:00:21,310
!أمان

4
00:00:23,110 --> 00:00:24,570
!خروج

5
00:00:24,570 --> 00:00:26,980
...إنّها عطلة الصّيف ويقولون بأنّني تأخّرت

6
00:00:27,990 --> 00:00:29,590
!حسناً، الجميع هنا

7
00:00:33,110 --> 00:00:36,500
في هذا اليوم فقط، ستُقدّمن المُساعدة
،في منزل شاطئ البحر هوشينو

8
00:00:36,500 --> 00:00:38,090
!لذا شكراً سلفاً

9
00:00:39,990 --> 00:00:41,020
!حسناً

10
00:02:08,560 --> 00:02:12,820
!ماذا؟ بريتي كيور حصلتا على قوّة جديدة؟

11
00:02:14,630 --> 00:02:17,780
يبدو أنَّ بعض الأرواح من نافورة السّماء
قد سقطت معهما

12
00:02:18,250 --> 00:02:19,740
من نافورة السّماء؟

13
00:02:20,390 --> 00:02:22,660
لا بدّ أنّ هذا من صنيع ميتشيرو وكاورو

14
00:02:22,660 --> 00:02:25,420
،نظراً لسوء إدارة النّافورة

15
00:02:25,420 --> 00:02:27,750
اكتسبَتْ بريكيور قوّةً جديدة

16
00:02:28,380 --> 00:02:31,360
--شيتاتاري-دونو، لا ينبغي لهذه الاتّهامات

17
00:02:31,360 --> 00:02:32,260
!اصمت

18
00:02:33,780 --> 00:02:36,810
،لن تكون بريكيور ندّتَين لي

19
00:02:36,810 --> 00:02:39,050
مهما كانتا قويّتين

20
00:02:39,650 --> 00:02:42,250
ألا تُوافقني يا أكودايكان-ساما؟

21
00:02:42,810 --> 00:02:46,660
لا تستهيني بأرواح بلاد النّوافير

22
00:02:46,660 --> 00:02:49,780
،مقارنةً بقوّة الدّمار الّتي نمتلكها

23
00:02:49,780 --> 00:02:53,220
قوّتهما تُشكّلان تهديداً كبيراً

24
00:02:53,650 --> 00:02:55,310
احفظي ذلك عن ظهر قلب

25
00:02:56,230 --> 00:02:59,410
يمكنك أن تدع الأمر لي يا أكودايكان-ساما

26
00:03:00,170 --> 00:03:02,230
!وادعاً يا غو-تشان

27
00:03:03,300 --> 00:03:04,740
!غو-تشان؟

28
00:03:21,680 --> 00:03:23,880
!اقتربوا جميعاً

29
00:03:23,880 --> 00:03:25,870
!لا صيف من دون بيت على شاطئ البحر

30
00:03:26,390 --> 00:03:28,610
إذا أردتُم طعاماً شاطئيّاً، فليس
!لديكم إلّا طعام هوشينو

31
00:03:28,610 --> 00:03:29,680
!تفضّلوا

32
00:03:29,970 --> 00:03:33,020
لدينا الياكيسوبا والأوكونومياكي المثاليّتان

33
00:03:33,020 --> 00:03:34,400
!صحن واحد يكفي لثمانية أشخاص

34
00:03:34,400 --> 00:03:35,860
!نحرص على توفيركم للمال

35
00:03:37,210 --> 00:03:40,480
!انتظروا في طابور من فضلكم
!سيجهز عمّا قريب

36
00:03:45,430 --> 00:03:46,570
تفضّل

37
00:03:46,570 --> 00:03:47,560
!شكراً

38
00:03:48,290 --> 00:03:49,670
ثلج مبشور؟

39
00:03:50,110 --> 00:03:51,500
سيُرطّب حلقك فوراً

40
00:03:51,500 --> 00:03:54,780
،حسناً، اثنان ياكيسوبا حجم كبير
آسفة لو تأخّرنا

41
00:03:54,780 --> 00:03:57,330
ماذا؟ يوكو-تشان؟

42
00:03:57,330 --> 00:03:58,090
!عُلِم

43
00:04:00,980 --> 00:04:02,670
هل هذه المعكرونة مناسبة؟

44
00:04:03,160 --> 00:04:04,910
!أ-أجل، شكراً لك

45
00:04:04,910 --> 00:04:06,400
!هذا سيّئ

46
00:04:06,400 --> 00:04:08,770
!نفد القريدس لدينا، افعلي شيئاً

47
00:04:08,770 --> 00:04:10,140
!تفضّل يا سيّدي

48
00:04:10,140 --> 00:04:11,600
أعددتُ بعضاً منه سلفاً

49
00:04:13,060 --> 00:04:15,080
أنتِ ماهرة يا يوكو-تشان

50
00:04:14,620 --> 00:04:16,520
!ومؤتمنة أيضاً

51
00:04:17,250 --> 00:04:18,610
...يوكو

52
00:04:18,610 --> 00:04:20,530
مهتمّة بهذا حقّاً، أليس كذلك؟

53
00:04:20,530 --> 00:04:22,130
...حـ-حسناً

54
00:04:26,870 --> 00:04:28,740
!تبدو الأجواء مُمتعة في الخارج، موبّو

55
00:04:29,780 --> 00:04:32,710
!موب، فوب، لا يمكنكما المغادرة، لابّي

56
00:04:35,210 --> 00:04:37,190
أحسِنا السُّلوك، تشوبّي

57
00:04:37,190 --> 00:04:38,970
لماذا، بوبّو؟

58
00:04:38,970 --> 00:04:40,420
ألا يمكننا المُغادرة، موبّو؟

59
00:04:40,420 --> 00:04:43,580
لستُما معتادين على البلاد الخضراء بعد، لابّي

60
00:04:43,580 --> 00:04:46,290
التجوُّل خطير، لابّي

61
00:04:46,290 --> 00:04:49,560
لماذا أتينا إلى البلاد الخضراء إذاً، بوبّو؟

62
00:04:49,560 --> 00:04:53,010
لـ-لا نعلم، لابّي

63
00:04:53,010 --> 00:04:56,530
لكن قالت لنا الأميرة فيليا
أن نُوحِّد قوانا، تشوبّي

64
00:04:56,530 --> 00:05:00,920
لماذا أنتما في البلاد الخضراء إذاً، موبّو؟

65
00:05:00,920 --> 00:05:03,260
!سؤال ممتاز، لابّي

66
00:05:03,260 --> 00:05:05,380
!وذلك كي ننفّذ مهمّتنا، تشوبّي

67
00:05:06,020 --> 00:05:07,690
مهمّة، بوبّو؟

68
00:05:07,690 --> 00:05:10,930
مهمّتنا هي التّحالف مع بريكيور

69
00:05:10,930 --> 00:05:12,990
واسترجاع النّوافير، تشوبّي

70
00:05:12,990 --> 00:05:15,000
!أنا من ينبغي أن يقول ذلك، لابّي

71
00:05:15,000 --> 00:05:17,240
لكن لن يستغرق الأمر وقتاً طويلاً، تشوبّي

72
00:05:17,240 --> 00:05:19,460
،عندما استرجعنا كافّة النّوافير

73
00:05:19,460 --> 00:05:22,650
فيمكننا العودة إلى بلاد النّوافير، تشوبّي

74
00:05:24,540 --> 00:05:25,760
تفضّلي

75
00:05:25,760 --> 00:05:26,650
!شكراً

76
00:05:28,910 --> 00:05:30,310
هل كلّ شيء بخير؟

77
00:05:30,630 --> 00:05:32,240
أجل، كلّ شيء بحال جيّدة

78
00:05:32,240 --> 00:05:33,350
!نستأذن لحظة

79
00:05:33,350 --> 00:05:34,430
ماذا؟

80
00:05:38,400 --> 00:05:40,770
!فلابّي، لا تُصدِر ضجيجاً

81
00:05:41,650 --> 00:05:42,670
!ساكي

82
00:05:42,670 --> 00:05:44,280
نحتاج مساعدتكما، تشوبّي

83
00:05:44,280 --> 00:05:47,740
موب وفوب أسقطا الحقيبة، لابّي

84
00:05:48,530 --> 00:05:50,030
موب وفوب؟

85
00:05:53,470 --> 00:05:55,930
هل كانا هكذا منذ البارحة؟

86
00:05:55,930 --> 00:05:59,170
أجل. كلّما تكلّمنا معهما، يهربان ويختبئان

87
00:05:59,170 --> 00:06:01,420
وكأنّهما ما زالا يخافان منّا

88
00:06:01,420 --> 00:06:03,670
إنّهما خجولان أمام النّاس

89
00:06:03,670 --> 00:06:06,580
لكن في بلاد النّوافير كانا حيويّين
ومليئين بالنّشاط، لابّي

90
00:06:06,580 --> 00:06:08,470
لا حاجة للقلق، تشوبّي

91
00:06:08,980 --> 00:06:11,300
...آمل ألّا تكون هناك مشكلة، لكن

92
00:06:11,300 --> 00:06:14,090
حسناً يا فلابّي، أدعهما أمانة بين يديك

93
00:06:14,090 --> 00:06:15,920
!اعتمدي عليّ، لابّي

94
00:06:20,420 --> 00:06:22,070
ماذا حدث؟

95
00:06:22,070 --> 00:06:24,190
لا يوجد حتّى زبون واحد هنا

96
00:06:24,630 --> 00:06:26,190
بسبب ذلك

97
00:06:29,820 --> 00:06:31,820
كانت توجد عربة كهذه؟

98
00:06:31,820 --> 00:06:33,160
ميزوشيتا"؟"

99
00:06:33,160 --> 00:06:36,090
!مرحباً، مرحباً بكم

100
00:06:36,090 --> 00:06:39,140
!ثلج مبشور لذيذ من نافورة الماء مباشرة

101
00:06:39,140 --> 00:06:41,000
!لدينا عرض خاصّ الآن

102
00:06:41,000 --> 00:06:42,720
...تقدّموا وكلوا حتّى الشّبع

103
00:06:42,720 --> 00:06:43,960
...لأجلكم، لأجلكم، لأجلكم

104
00:06:43,960 --> 00:06:44,620
!مذهل

105
00:06:44,620 --> 00:06:45,100
!رائع

106
00:06:45,100 --> 00:06:45,960
!هيّا بنا

107
00:06:46,420 --> 00:06:48,010
...حدث ذلك سريعاً

108
00:06:48,540 --> 00:06:50,550
نافورة الماء"؟"

109
00:06:50,550 --> 00:06:53,480
!يعني هذا حرباً

110
00:06:55,390 --> 00:06:57,600
اشتريتُ بعضاً من الثّلج المبشور
من المحلّ الآخر

111
00:06:58,290 --> 00:06:59,390
...هذا

112
00:06:59,390 --> 00:07:01,680
يبدو عاديّاً من الخارج

113
00:07:01,680 --> 00:07:03,590
...صـ-صحيح، لن نستفيد

114
00:07:08,140 --> 00:07:10,070
...مـ-مهلاً لحظة يا عزيزي

115
00:07:10,780 --> 00:07:12,430
!لذيذ

116
00:07:15,000 --> 00:07:17,540
مهلاً، لا ينبغي أن تقول ذلك

117
00:07:21,140 --> 00:07:22,460
!إنّه شهيّ، لابّي

118
00:07:22,460 --> 00:07:24,410
!مهما أكلتُ لا أشبع، تشوبّي

119
00:07:26,450 --> 00:07:29,690
الثّلج المبشور من مياه النّبع جودته ممتازة

120
00:07:29,690 --> 00:07:31,050
إنّه مصدر مُكوّن مختلف تماماً

121
00:07:32,330 --> 00:07:33,960
ماذا سنفعل يا أبي؟

122
00:07:33,960 --> 00:07:35,800
!على هذا المُعدّل، ستسرق كلّ زبائننا

123
00:07:35,800 --> 00:07:37,380
لا نريد أعذاراً

124
00:07:37,380 --> 00:07:39,220
...إذا كانت تريد التحدّي

125
00:07:41,780 --> 00:07:44,090
!عيد الشّكر العظيم قد بدأ

126
00:07:44,090 --> 00:07:46,660
!ستحصلون على ضعف الكمّية بنفس السّعر

127
00:07:46,660 --> 00:07:48,930
!الثّلج المبشور على طريقة هوشينو الخاصّة

128
00:07:48,930 --> 00:07:51,350
!نريد من الجميع (هوشينو) أن يُجرِّبوه
ما رأيكم بذلك؟

129
00:07:51,720 --> 00:07:53,200
ماذا قال؟

130
00:07:53,200 --> 00:07:55,480
المحلّ المُجاور هو حيث تبدأ الإثارة