1
00:00:06,910 --> 00:00:08,570
...هـ-هذا

2
00:00:16,430 --> 00:00:18,840
هنا أخفيتِه إذاً

3
00:00:18,840 --> 00:00:20,660
كانت حيلة رخيصة يا أميرة

4
00:00:20,930 --> 00:00:23,250
لكن وجدتُها أخيراً

5
00:00:58,270 --> 00:01:01,080
...وسنستعيد عالمنا

6
00:01:01,760 --> 00:01:03,500
!بأيدينا هذه...

7
00:03:00,500 --> 00:03:02,790
لم تبقَ زهرة مُتفتِّحة

8
00:03:02,790 --> 00:03:05,240
لم يبقَ طائر واحد يُرفرف

9
00:03:06,630 --> 00:03:09,080
قريباً، لن تهبّ الرّياحُ بعد الآن

10
00:03:09,080 --> 00:03:11,350
ولن يسطع الضّوء ثانية مجدّداً

11
00:03:13,840 --> 00:03:17,300
لُبِّيت رغبة قلبي

12
00:03:18,970 --> 00:03:20,570
...هذا بلا جِدال

13
00:03:20,850 --> 00:03:22,490
!عالم من الدّمار...

14
00:03:22,900 --> 00:03:25,110
باستثناء أنتن الأربعة بالطّبع

15
00:03:27,550 --> 00:03:28,640
ماذا؟

16
00:03:29,940 --> 00:03:33,200
يبدو أنّكن اكتسبتُن قوى جديدة

17
00:03:37,470 --> 00:03:40,570
يبدو أنّكن لا تستسلمن

18
00:03:40,570 --> 00:03:43,300
حتّى بعد كلّ هذه المهلة الّتي منحتُها لكُن

19
00:03:43,800 --> 00:03:45,810
!لن نستسلم أبداً

20
00:03:45,810 --> 00:03:47,930
!لن نخسر أمام أمثالك أبداً

21
00:03:48,960 --> 00:03:52,310
لستُن مُحاربات بريكيور الأسطوريّات عن عبث

22
00:03:52,810 --> 00:03:55,920
،عظيم. سأستخدم كامل قوّتي

23
00:03:55,920 --> 00:03:59,270
!وأبيدكن إبادة كاملة

24
00:04:02,780 --> 00:04:07,280
!بأحسن هيئة
!صديقات للأبد تحت السّماء المُرصَّعة بالنّجوم

25
00:04:29,480 --> 00:04:30,510
!بريكيور

26
00:04:30,510 --> 00:04:31,330
!ميتشيرو

27
00:04:31,330 --> 00:04:32,550
!كاورو

28
00:04:42,820 --> 00:04:46,700
هل ظننتُن بأنّكن تستطِعن تحقيق
شيء بتوحيد قِواكن؟

29
00:04:47,550 --> 00:04:49,150
لا جدوى

30
00:04:49,150 --> 00:04:52,060
لا فُرصة لديكن للفوز عليّ

31
00:04:53,500 --> 00:04:57,300
منذ زمنٍ بعيد، كان الكون مُحاطاً بالظّلام

32
00:04:58,690 --> 00:05:01,710
لكن في لحظات، بدأ كلُّ شيء يتغيّر

33
00:05:02,060 --> 00:05:04,860
تشكّلت الكثير من النّجوم والكواكب

34
00:05:05,370 --> 00:05:09,820
من تلك الكواكب، نشأت الحياة وتكاثرت

35
00:05:10,560 --> 00:05:17,270
ثمّ أمسى الكون أكثر ضجيجاً
وأقلّ استقراراً مع الوقت

36
00:05:17,930 --> 00:05:22,800
لهذا سأدمِّر كلّ شيء وأرجعه
إلى حالته الأصليّة

37
00:05:22,800 --> 00:05:27,700
إلى ظلام عالم أبديّ صامت من الدّمار

38
00:05:28,540 --> 00:05:31,070
المعذرة... نسيتني

39
00:05:32,600 --> 00:05:33,950
...نحن لن

40
00:05:33,950 --> 00:05:35,410
!ندعك تفعل ذلك

41
00:05:36,230 --> 00:05:38,540
كم هذا مؤسف

42
00:05:38,540 --> 00:05:43,170
!حان وقت وداعي الأبديّ لكُن

43
00:05:53,700 --> 00:05:56,750
"بالنّسبة لك، قد نكون "عقبة

44
00:05:56,750 --> 00:05:59,520
!لكنّنا نحاول العيش باستماتة

45
00:06:09,150 --> 00:06:10,360
!اللّعنة عليكن

46
00:06:11,530 --> 00:06:13,090
!يا نور القمر

47
00:06:22,110 --> 00:06:23,460
!يا رياح السّماوات

48
00:06:43,410 --> 00:06:44,480
!فعلناها

49
00:06:45,660 --> 00:06:46,910
!مذهل، بوبّو

50
00:06:46,910 --> 00:06:47,530
!أجل

51
00:06:47,800 --> 00:06:48,920
!ليس بعد، لابّي

52
00:06:48,920 --> 00:06:51,780
!أشعر بقوّة تدميريّة كبيرة، تشوبّي

53
00:06:54,860 --> 00:06:57,870
!لقد تماديتُنّ كثيراً

54
00:07:01,940 --> 00:07:04,130
!لن أتحفّظ بعد الآن

55
00:07:04,600 --> 00:07:06,340
!فلتخلدنَ في النّسيان

56
00:07:32,000 --> 00:07:35,320
أعتقد أنّ المعركة... قد حُسِمت

57
00:07:38,860 --> 00:07:41,910
لم يعُدن يمتلكن قوّة النّهوض

58
00:07:45,350 --> 00:07:46,460
...يجب أن أربح

59
00:07:47,930 --> 00:07:49,770
في بطولة الكُرة اللّيّنة...

60
00:07:49,770 --> 00:07:52,360
في هذا العام، كنّا الوصيف

61
00:07:52,360 --> 00:07:57,410
وعدتُ إيزوميدا-سينباي بأنّنا سنكون
الأبطال في العام المُقبل بالتّأكيد

62
00:07:58,450 --> 00:08:00,720
!عمّاذا تتكلّمين؟

63
00:08:00,720 --> 00:08:03,520
!البلاد الخضراء قد دُمِّرت

64
00:08:04,320 --> 00:08:07,100
أريدح تجربة تحضير الخبز

65
00:08:07,410 --> 00:08:11,090
لأنّ الخبز الّذي أعطتنا إيّاه ساكي
كان لذيذاً جدّاً

66
00:08:12,520 --> 00:08:14,130
...أريد رسم لوحات

67
00:08:14,130 --> 00:08:19,080
،ترسم البسمة في وجوه النّاس
مثل مينوري وماي

68
00:08:20,310 --> 00:08:23,370
أريد العيش في بلاد النّوافير، تشوبّي

69
00:08:24,140 --> 00:08:26,920
!أريد أن أخبر تشوبّي عن مشاعري، لابّي

70
00:08:27,220 --> 00:08:28,580
مشاعر، تشوبّي؟

71
00:08:28,580 --> 00:08:30,650
...في الواقع

72
00:08:30,650 --> 00:08:32,650
!سأخبرك لاحقاً، لابّي

73
00:08:33,290 --> 00:08:38,500
أريد رسم ابتسامة ساكي والجميع

74
00:08:39,040 --> 00:08:41,890
وأملأ مزيداً من كُتُب الرّسم بصور المستقبل

75
00:08:42,540 --> 00:08:43,720
لماذا؟

76
00:08:49,390 --> 00:08:52,110
...لماذا تنهضنَ

77
00:08:52,110 --> 00:08:55,190
!وأنتن تعلمنَ بأنّه لا جدوى؟

78
00:09:01,790 --> 00:09:03,370
...فلتتضافر

79
00:09:03,370 --> 00:09:04,700
!كامل قِوانا، تشوبّي

80
00:09:06,390 --> 00:09:07,460
!قوّة القمر

81
00:09:08,930 --> 00:09:10,080
!قوّة الرّياح

82
00:09:11,530 --> 00:09:12,920
!قوّة الأرض

83
00:09:14,140 --> 00:09:15,670
!قوّة السّماء

84
00:09:21,110 --> 00:09:22,920
!يا نور الأرواح

85
00:09:22,920 --> 00:09:24,680
!يا بريق الحياة

86
00:09:24,680 --> 00:09:26,100
...أرشد قلبينا

87
00:09:26,100 --> 00:09:27,600
!نحو الأمل...

88
00:09:27,840 --> 00:09:31,810
أيّتها الحمقاوات! لا يمكنكن فعل
!شيء يؤثّر بي

89
00:09:33,600 --> 00:09:34,590
...بريكيور

90
00:09:35,030 --> 00:09:37,400
...القلب اللّولبيّ

91
00:09:40,690 --> 00:09:43,470
!سبلاش ستار...

92
00:10:17,050 --> 00:10:19,940
!قِوى التّدمير غير محدودة

93
00:10:20,260 --> 00:10:22,130
!ستتجدّد باستمرار

94
00:10:22,130 --> 00:10:26,380
!فُرصتكن في الفوز هي 1 من 10 آلاف

95
00:10:26,380 --> 00:10:29,040
غويان، لا أنكر بأنّك قويّ

96
00:10:29,040 --> 00:10:31,690
،لكن مهما كانت أي قوّة تدميريّة كبيرة

97
00:10:31,690 --> 00:10:33,580
!بعض الأشياء لا يمكن تدميرها

98
00:10:33,970 --> 00:10:37,870
!لا يمكنك مسح الأمل في قلوبنا

99
00:10:37,870 --> 00:10:39,540
...ومستقبلنا

100
00:10:39,540 --> 00:10:40,920
...وآمال الجميع

101
00:10:41,420 --> 00:10:44,090
!لن نستسلم لك أبداً

102
00:10:52,100 --> 00:10:54,710
!ما-ما هذا؟

103
00:10:55,200 --> 00:10:59,100
!...هذا البريق... إنّه مثل

104
00:11:13,490 --> 00:11:17,320
!قِوى التّدمير خاصّتي لا حدود لها

105
00:11:17,320 --> 00:11:21,120
مع ذلك لا تستطيع تدمير بريكيور وحليفتيهما

106
00:11:21,120 --> 00:11:24,340
...هذا ببساطة... غير ممكن

107
00:11:24,340 --> 00:11:27,170
!هذا ببساطة غير ممكن

108
00:11:28,180 --> 00:11:30,010
لن أفنى لوحدي

109
00:11:30,010 --> 00:11:32,720
!إذا سقطتُ، فسوف آخذكن معي

110
00:11:34,640 --> 00:11:35,790
!بلوم

111
00:11:34,640 --> 00:11:35,790
!إيغريت

112
00:11:39,180 --> 00:11:40,690
!أخبرنَني

113
00:11:44,420 --> 00:11:47,690
...هذا المقدار الّذي لا يُحتمَل من القوّة

114
00:11:48,500 --> 00:11:51,150
هل هو رابط... الأمل الخاص بكن؟

115
00:12:08,510 --> 00:12:09,550
!--هذا

116
00:12:12,830 --> 00:12:14,070
!الأرواح، لابي

117
00:12:14,500 --> 00:12:17,680
!الغرّافة والأرواح عادت، تشوبّي

118
00:13:17,730 --> 00:13:19,300
...شجرة السّماء

119
00:13:19,790 --> 00:13:21,370
عادت إلى الحياة...

120
00:13:26,000 --> 00:13:29,960
يمكنني رؤية شجرة أخرى تتشابك
!مع شجرة السّماء

121
00:13:30,240 --> 00:13:32,050
هل يُعقَل أن يكون هذا...؟

122
00:13:32,460 --> 00:13:34,010
!شجرة العالم، تشوبّي

123
00:13:34,900 --> 00:13:36,830
هذه هي شجرة العالم؟

124
00:13:37,350 --> 00:13:40,350
الشّجرة الّتي تحكم كافّة الحيوات؟

125
00:13:40,350 --> 00:13:44,560
!شجرة العالم وشجرة السّماء اتّصلتا، لابّي

126
00:13:51,400 --> 00:13:53,610
!الأميرة فيليا

127
00:14:07,440 --> 00:14:09,580
...عاد النُّور

128
00:14:10,520 --> 00:14:13,960
...أجل. والنّسيم عليل

129
00:14:14,710 --> 00:14:16,310
...هذا مُطمئن

130
00:14:20,480 --> 00:14:21,570
!ميتشيرو

131
00:14:21,570 --> 00:14:22,560
!كاورو-سان

132
00:14:26,100 --> 00:14:26,980
ما الأمر؟

133
00:14:27,280 --> 00:14:28,390
هل أنتما بخير؟

134
00:14:28,700 --> 00:14:32,110
!الضّوء من بلّورتهما ضَعُفَ فجأة، لابّي

135
00:14:32,570 --> 00:14:35,030
علينا إنقاذهما بسرعة وإلّا، تشوبّي

136
00:14:36,060 --> 00:14:39,280
...حالما اختفت قوّة الدّمار

137
00:14:39,590 --> 00:14:42,240
كنّا نعلم بحدوث هذا...

138
00:14:43,980 --> 00:14:46,160
!ميتشيرو، تماسكي، موبّو

139
00:14:46,560 --> 00:14:49,240
!كاورو، تمالكي نفسكِ، بوبّو

140
00:14:49,240 --> 00:14:53,250
استهلكنا كلّ القوّة الّتي لدينا

141
00:14:53,740 --> 00:14:55,840
لذا لسنا مُتحسّرتين على شيء

142
00:14:55,840 --> 00:14:59,560
!لا تقولي هذا! يبدو هذا وداعاً

143
00:14:59,560 --> 00:15:02,960
ميتشيرو، ألا تُريدين أن تخبزي خبزاً شهيّاً؟

144
00:15:02,960 --> 00:15:06,140
!أريد أكل الخبز الّذي ستُعدّينه

145
00:15:06,510 --> 00:15:10,190
كاورو-سان، لنذهب ونرسم معاً
!في المرّة المُقبِلة

146
00:15:10,450 --> 00:15:13,990
أنا متأكّدة بأنّكِ ستتمكّنين
!من رسم رسمة رائعة

147
00:15:14,840 --> 00:15:16,570
!لذا اصمدي أرجوكِ

148
00:15:17,220 --> 00:15:21,030
!سأمنحكِ قوّتي، لذا تعافي فحسب، موبّو

149
00:15:21,290 --> 00:15:24,410
!سأمنحكِ عشرة أضعاف قوّتي، بوبّو

150
00:15:24,410 --> 00:15:26,540
!لا تختفي، لابّي

151
00:15:26,540 --> 00:15:27,950
!لا ترحلي، تشوبّي

152
00:15:29,050 --> 00:15:30,850
...أنا مسرورة جدّاً

153
00:15:32,100 --> 00:15:33,340
لأنّني التقيتُ بكم جميعاً...

154
00:15:34,000 --> 00:15:36,440
...ساكي، ماي

155
00:15:37,120 --> 00:15:40,060
شكراً جزيلاً على كلّ شيء...

156
00:15:49,370 --> 00:15:50,940
!ميتشيرو! كاورو

157
00:16:03,000 --> 00:16:05,700
الأرواح من البلاد الخضراء، بوبّو؟

158
00:16:07,520 --> 00:16:09,220
يمكنني سماع أصواتهم

159
00:16:13,240 --> 00:16:17,210
...مثلكما تماماً، أرواح هذا العالم

160
00:16:17,830 --> 00:16:20,660
تريد العيش مع هاتين الاثنتين...

161
00:16:21,630 --> 00:16:24,090
!يا أرواح البلاد الخضراء

162
00:16:24,390 --> 00:16:26,320
!مُدّينا بقوّتكِ من فضلكِ

163
00:16:55,080 --> 00:16:56,170
!ميتشيرو

164
00:16:56,580 --> 00:16:57,880
!كاورو-سان

165
00:17:02,010 --> 00:17:03,440
...نحن

166
00:17:04,040 --> 00:17:05,320
على قيد الحياة...

167
00:17:10,650 --> 00:17:11,650
...يا للجمال

168
00:17:12,110 --> 00:17:14,890
تبدو كما... النّجوم

169
00:17:15,500 --> 00:17:19,980
منذ زمن بعيد، كان العالم مُظلِماً
وخالياً من الحياة

170
00:17:20,320 --> 00:17:22,850
،غير أنّ الحياة قد نشأت

171
00:17:22,850 --> 00:17:27,310
ولمعت وتلألأت مع النّجوم
عبر ظُلُمات الفضاء

172
00:17:28,500 --> 00:17:33,740
ومثل النّجوم، قلوبكن الّتي تُعانق
بعضها الآخر

173
00:17:33,740 --> 00:17:36,290
تتلألأ معاً وتتوهّج بريقاً

174
00:17:36,990 --> 00:17:39,050
...صديقات تحت السّماء المُرصّعة بالنّجوم

175
00:17:40,280 --> 00:17:42,500
...أجل، هذا صحيح! نحن

176
00:17:43,060 --> 00:17:44,810
!صديقات تحت السّماء المُرصّعة بالنّجوم

177
00:17:46,300 --> 00:17:50,020
،يا صديقات السّماء المُرصّعة بالنّجوم
أشكركن من أعماق قلبي

178
00:17:51,580 --> 00:17:54,390
أنا ممتنّ لكُن جميعاً حقّاً

179
00:17:55,110 --> 00:17:56,590
...الأميرة فيليا

180
00:17:56,590 --> 00:17:57,780
أين أنتِ....؟

181
00:18:03,150 --> 00:18:06,350
الأميرة هي روح شجرة العالم، لابّي

182
00:18:06,350 --> 00:18:09,660
عادَتْ إلى بلاد النّوافير، تشوبّي

183
00:19:24,030 --> 00:19:26,030
!أنا آسفة يا قائدة

184
00:19:27,820 --> 00:19:29,360
!لا عليكِ

185
00:19:30,060 --> 00:19:33,160
!استرخينَ وريّحن أكتافكن

186
00:19:33,160 --> 00:19:34,190
!عُلِم

187
00:19:38,200 --> 00:19:39,790
!انظروا، انظروا

188
00:19:41,170 --> 00:19:42,620
!مفاجأة

189
00:19:42,940 --> 00:19:45,390
صنعتُها مع كاورو-أونيسان

190
00:19:45,390 --> 00:19:48,440
هي من رسمَتْ هذه اللّوحة

191
00:19:48,440 --> 00:19:50,650
لم أكن أعلم بأنّكِ ترسمين يا كيريو-سان

192
00:19:50,650 --> 00:19:52,130
إنّها رائعة

193
00:19:52,130 --> 00:19:52,990
ماذا؟

194
00:19:53,440 --> 00:19:56,100
في الواقع... ما زلتُ أتعلّم

195
00:19:56,610 --> 00:19:59,560
!سأستخدم هذه لتشجيع ساكي

196
00:19:59,920 --> 00:20:03,180
حسناً! هذا انتقام للعام الماضي

197
00:20:03,180 --> 00:20:05,760
!لنهتف حتّى تخشن أصواتنا

198
00:20:06,050 --> 00:20:09,460
الضّارب (باتّا) سيُحرِز خروجاً، ويذهب
...(لسرِقة (أوباتّا

199
00:20:09,460 --> 00:20:10,280
(جندُب (باتّا

200
00:20:10,680 --> 00:20:13,500
في البداية (باتّا) و (أوباتّا)، والآن (باتّا)؟

201
00:20:13,500 --> 00:20:16,910
لا بأس بالتّلاعب اللّفظي، لكن
!يجب أن تُركّز على التّشجّيع

202
00:20:19,700 --> 00:20:22,510
هل أنتِ من أعدّ هذا الخبز يا ميتشيرو-سان؟

203
00:20:22,510 --> 00:20:25,660
،أجل. كنتُ سأدع ساكي تأكله

204
00:20:25,660 --> 00:20:28,090
...ويُفترَض أن يكون وجهها، لكن

205
00:20:28,090 --> 00:20:29,500
!هناك تشابُه كبير

206
00:20:29,500 --> 00:20:30,250
صحيح؟

207
00:20:30,250 --> 00:20:31,860
!أجل! بكلّ تفصيل

208
00:20:38,820 --> 00:20:41,300
!بسرعة، لابّي، بسرعة، لابّي

209
00:20:43,690 --> 00:20:45,250
لنستعجل، لابّي

210
00:20:45,250 --> 00:20:47,860
!سوف نُشجّع ساكي، لابّي

211
00:20:47,860 --> 00:20:49,010
!عزيزتي

212
00:20:50,080 --> 00:20:51,360
!عزيزي

213
00:20:51,830 --> 00:20:53,420
...فلابّي وتشوبّي

214
00:20:53,420 --> 00:20:55,320
!يحبّان بعضهما، موبّو

215
00:20:55,700 --> 00:20:57,400
!انتهى الإحماء

216
00:20:57,400 --> 00:20:59,350
فليعُد الجميع إلى المقاعد

217
00:20:59,350 --> 00:21:00,120
!عُلِم

218
00:21:02,290 --> 00:21:03,910
!أنتم

219
00:21:03,910 --> 00:21:05,430
!أتيتم أخيراً

220
00:21:05,430 --> 00:21:07,190
!نعتمد على تشجيعكم

221
00:21:07,190 --> 00:21:09,070
!أجل، دعنَ الأمر لنا

222
00:21:09,070 --> 00:21:10,680
ابذلي قصارى جهدكِ يا أوتا

223
00:21:10,680 --> 00:21:11,630
!سأفعل

224
00:21:15,320 --> 00:21:16,810
...إيزوميدا-سينباي

225
00:21:32,520 --> 00:21:33,640
!ساكي

226
00:21:33,640 --> 00:21:34,650
ماي؟

227
00:21:49,090 --> 00:21:53,500
،هذا غريب... كلّما أمسكتُ بيدكِ
أشعر بطاقة تتدفّق في داخلي

228
00:21:53,830 --> 00:21:55,030
كذلك أنا

229
00:21:55,530 --> 00:22:00,520
القيام بهذا يجعلني أشعر وكأنّني
سأكون بخير مهما حدث

230
00:22:03,440 --> 00:22:05,100
حسناً! سوف أغادر

231
00:22:05,560 --> 00:22:07,690
أجل! بالتّوفيق

232
00:24:14,890 --> 00:24:16,610
!إلى جميع من يجلسون أمام التّلفاز

233
00:24:16,610 --> 00:24:18,850
شجّعتمونا لمدّة عام كامل

234
00:24:18,850 --> 00:24:20,490
!شكراً جزيلاً لكم

235
00:24:20,780 --> 00:24:24,350
!ستستمرّ مُغامرات بريكيور لفترة طويلة

236
00:24:24,660 --> 00:24:27,280
حسناً إذاً، لنلتقِ مجدّداً في مكانٍ ما، اتّفقنا؟

237
00:24:27,280 --> 00:24:28,750
!وداعاً