1
00:01:51,950 --> 00:01:53,830
،كما ترى أيّها الزّعيم

2
00:01:55,680 --> 00:01:57,870
.لم نتغيّر أبدًا

3
00:01:58,300 --> 00:02:03,220
عدنا ورغبتنا وطموحنا لحماية
.إيدو لا تزالان قويّتين

4
00:02:04,640 --> 00:02:06,140
.نحن نفس الشّينسينغومي القدماء

5
00:02:06,590 --> 00:02:08,970
!لكنّك بمفردك شخص مختلف كلّيًّا الآن

6
00:02:08,970 --> 00:02:11,710
يامازاكي-سان! ما الّذي حدث لك؟

7
00:02:09,370 --> 00:02:16,830
!!شاهدوا فصل الرّوح الفضّيّة في غرفة مضيئة ومن مسافة آمنة من تلفازكم

8
00:02:11,710 --> 00:02:14,880
!لِمَ تبدو وكأنّك عدت من حرب الفيتنام للتّوّ؟

9
00:02:14,880 --> 00:02:17,140
ماذا؟ هل أبدو مختلفًا إلى ذلك الحدّ؟

10
00:02:17,140 --> 00:02:18,540
!تبدو؟ أنت مختلف بالفعل

11
00:02:18,540 --> 00:02:20,730
!أحسنت يا زاكياما-سان

12
00:02:21,090 --> 00:02:24,000
لم يتمكّن نائب الرّئيس وأوكيتا-سان من التّعامل
!معه، لكنّك قضيت عليه بضربة واحدة

13
00:02:24,000 --> 00:02:27,360
!جيش التّحرير ليسوا أندادًا لنا طالما أنت معنا

14
00:02:27,360 --> 00:02:36,250
!زاكياما! زاكياما

15
00:02:31,260 --> 00:02:34,130
!مهلاً، حتّى ميزان القوى لديهم تغيّر قليلاً

16
00:02:34,130 --> 00:02:36,250
!أصبح ذلك الرّجل العاديّ نواة الفرقة

17
00:02:37,530 --> 00:02:39,840
.توقّفت عن استعمال نقاط الحجب

18
00:02:39,840 --> 00:02:41,880
.أقلعت عن التّدخين

19
00:02:41,880 --> 00:02:45,490
.توقّفت عن التّوقف عن العبث مع هيجيكاتا

20
00:02:45,490 --> 00:02:47,200
.توقّفت عن كوني يامازاكي

21
00:02:47,200 --> 00:02:50,010
!لِمَ هو الوحيد الّذي نما وتجاوز إمكانيّاته؟

22
00:02:50,320 --> 00:02:56,640
!زاكياما! زاكياما

23
00:02:50,690 --> 00:02:52,830
،لست أفهم أنا أيضًا

24
00:02:52,830 --> 00:02:56,640
،لكن إن أردتم رأيي حقًّا
.فأظنّ أنّني حرّرت نفسي أيضًا

25
00:02:57,220 --> 00:03:03,050
حاولت أن أكون مثل الرّئيس
.الّذي أدرك ضعفه وتدرّب بقيود

26
00:03:03,050 --> 00:03:06,650
.لكنّني كنت أضعف بكثير، لذا لم أتحمّل الوزن

27
00:03:07,230 --> 00:03:14,160
،وذات يوم، لاحظت أنّ جسدي ثقيل
.مع أنّني لم أكن أحمل شيئًا

28
00:03:15,180 --> 00:03:19,170
.وأنّني ربّما كنت مقيّدًا طوال الوقت

29
00:03:21,130 --> 00:03:21,670
...لذا

30
00:03:22,560 --> 00:03:24,930
.رميتها كلّها، وهذه هي النّتيجة

31
00:03:24,930 --> 00:03:27,050
!قيود؟ إنّه جسدك

32
00:03:27,050 --> 00:03:28,460
ما الّذي يجري هنا؟

33
00:03:28,460 --> 00:03:31,980
خرج زاكياما من مؤخرة يامازاكي؟
لا، يامازاكي خرج من مؤخرة زاكياما؟

34
00:03:31,980 --> 00:03:34,800
!ماذا تكون بالضّبط؟ ماذا يكون بالضّبط؟

35
00:03:34,800 --> 00:03:38,500
.هذا  أشبه بالقميص الثّقيل الّذي خلعه غوكو

36
00:03:38,500 --> 00:03:42,960
يبدو أنّني وُلِدت مرتديًا قميصًا
.ثقيلاً اسمه يامازاكي ساغارو

37
00:03:42,960 --> 00:03:45,070
!هل قارنته للتّوّ بشيء؟

38
00:03:45,070 --> 00:03:49,490
بمجرّد أن رميته، شعرت بجسدي
.أخفّ من أيّ وقت مضى

39
00:03:49,490 --> 00:03:52,310
أحيانًا يكون خفيفًا لدرجة شعوري
.أنّني قد أطير إلى السّماء

40
00:03:52,310 --> 00:03:55,080
!لا يجدر بك رميه! قد يكون روحك أو ما شابه

41
00:03:55,400 --> 00:03:57,200
.مدهش

42
00:03:57,650 --> 00:04:02,670
حتّى أنت وصلت إلى حالة الفراغ التّامّ
للعقل حيث تستطيع رمي نفسك؟

43
00:04:02,670 --> 00:04:05,210
أيّها الرّئيس، لا تقل لي... أنت أيضًا؟

44
00:04:05,550 --> 00:04:07,510
.أنت، أنا لست هناك

45
00:04:09,390 --> 00:04:10,930
.الرّئيس هنا

46
00:04:10,930 --> 00:04:14,350
انس أمر الفراغ التّامّ للعقل! لم تعد
!هناك أيّ علامة على الرّئيس

47
00:04:14,350 --> 00:04:16,770
لِمَ تحوّل إلى غوريلاّ بعد خلع القميص؟

48
00:04:16,770 --> 00:04:18,730
!يبدو كروث الغوريلاّ الآن

49
00:04:18,730 --> 00:04:23,740
يبدو أنّني وُلِدت مرتديًا
.قميص غوريلاّ ثقيلاً

50
00:04:23,740 --> 00:04:26,360
.تحرّرت الآن أخيرًا من الغوريلاّ

51
00:04:26,360 --> 00:04:29,360
!لا، لم تتحرّر! أصبحت نسخة أكثر تركيزًا للغوريلاّ

52
00:04:30,730 --> 00:04:31,360
أعداء جدد؟

53
00:04:31,780 --> 00:04:35,580
هيّا بنا يا يامازاكي! لنرهم ما يمكننا
!فعله من دون القمصان

54
00:04:35,580 --> 00:04:36,120
!أجل

55
00:04:36,120 --> 00:04:37,430
!مهلاً، مهلاً، مهلاً

56
00:04:37,430 --> 00:04:38,910
!لقد تشابك القميصان

57
00:04:39,790 --> 00:04:41,370
!لقد علق القميصان

58
00:04:42,700 --> 00:04:44,380
!القميص يبكي

59
00:04:44,380 --> 00:04:47,720
،مهلاً، توقّفا! إن كنتما ستخلعانهما
!فاخلعاهما بشكلٍ صحيح

60
00:04:47,720 --> 00:04:49,120
!سوف تمزّقان القميصين

61
00:04:49,120 --> 00:04:50,630
!فكّاهما رجاءً

62
00:04:51,020 --> 00:04:51,880
هكذا؟

63
00:04:52,210 --> 00:04:53,910
!ليس بتلك الطّريقة

64
00:04:53,910 --> 00:04:55,010
.هكذا

65
00:04:55,010 --> 00:04:56,860
!أنت لا تحاول حتّى

66
00:04:56,860 --> 00:04:59,140
هل أنتما غاضبان منهما؟
هل أنتما غاضبان منهما حقًّا؟

67
00:04:59,890 --> 00:05:02,640
!مهلاً! انهار كلّ من الغوريلاّ ورامبو

68
00:05:02,640 --> 00:05:04,900
علمت ذلك! لم يكُن يُفترض
!رمي ذلكما القميصين

69
00:05:04,900 --> 00:05:06,910
!أسرعا وارتدياهما

70
00:05:08,830 --> 00:05:10,530
.لقد ألقى الانفجار بالغوريلاّ بعيدًا

71
00:05:10,890 --> 00:05:13,280
إن فقدناه، فسيذهب الغوريلاّ
!إلى السّماء مباشرة

72
00:05:13,280 --> 00:05:16,780
لا تقلقوا. في الوقت الرّاهن، جعلت
...الغوريلاّ يرتدي مجدّدًا

73
00:05:17,810 --> 00:05:20,000
.قميص أحمقداس

74
00:05:20,000 --> 00:05:22,540
!هيّا بنا! لم تنتهِ المباراة بعد

75
00:05:22,540 --> 00:05:24,450
!سدّدوا نحو الغد

76
00:05:24,450 --> 00:05:27,010
!مهلاً! استحوذ أحمقداس على جسده

77
00:05:27,010 --> 00:05:29,730
لِمَ على قميص يناديه غبيًّا
أن يتحكّم بشخصيّته؟

78
00:05:29,730 --> 00:05:31,240
!هذا أفضل من ذي قبل! اتبعوه

79
00:05:31,240 --> 00:05:32,340
!اسعوا إلى الهدف

80
00:05:32,340 --> 00:05:33,180
!الهدف؟ أين هو؟

81
00:05:33,640 --> 00:05:36,720
لِمَ عدتم يا لصوص الضّرائب بالضّبط؟

82
00:05:36,720 --> 00:05:39,710
!اخرس! لم نحصل على أيّ مال منذ وقت طويل

83
00:05:39,710 --> 00:05:43,190
!نحن نحاول إنقاذ العالم مجّانًا
!لذا أعطنا فرصة

84
00:05:43,190 --> 00:05:45,580
،إن كان هذا كلّ ما لديك
!فالعالم هالك لا محالة

85
00:05:45,580 --> 00:05:48,430
.لا عليك يا هيجيكاتا-سان، اهدأ قليلاً

86
00:05:48,430 --> 00:05:49,480
.تفضّل

87
00:05:49,480 --> 00:05:50,320
.شكرًا

88
00:05:51,310 --> 00:05:53,200
!مهلاً، لِمَ تفسد محاولتي للإقلاع

89
00:05:53,200 --> 00:05:57,520
لن تستطيع العيش لوقت أطول
!والأرض في طريقها إلى الدّمار

90
00:05:57,520 --> 00:05:58,670
.إنّها محقّة

91
00:05:58,670 --> 00:06:02,520
،إن كان الدّمار هو مآلنا جميعًا
.فعلى رئتيك الذّهاب أوّلاً

92
00:06:02,520 --> 00:06:04,960
!لِمَ تقع كلّ المسؤوليّة على رئتيّ؟

93
00:06:04,960 --> 00:06:08,460
!مهلاً! يامازاكي-سان مسرع نحو الدّمار بمفرده

94
00:06:08,460 --> 00:06:11,570
لو لم تتركوا إيدو من دون دفاع
!لما حدث هذا أبدًا

95
00:06:11,570 --> 00:06:15,080
!أنتم من تجاهلتموه
!أنتم من تسبّبتم بدمار العالم

96
00:06:15,080 --> 00:06:17,060
!تبًّا لك! أنت تتحمّل نصف المسؤوليّة

97
00:06:17,060 --> 00:06:18,970
!والنّصف الآخر يقع على رئتيك

98
00:06:18,970 --> 00:06:21,450
!هل الخطأ كلّه خطئي في النّهاية إذًا؟

99
00:06:22,570 --> 00:06:24,430
أنت، ما المضحك؟

100
00:06:24,430 --> 00:06:26,480
هل تدرك الوضع الّذي نحن فيه؟

101
00:06:26,480 --> 00:06:28,000
!أجل يا نائب الرّئيس

102
00:06:29,230 --> 00:06:32,860
،تحطّمت المحطّة ودُمّرت البلدة

103
00:06:32,860 --> 00:06:35,740
!لكنّ هذه البلدة لم تُخدش أبدًا

104
00:06:36,060 --> 00:06:39,180
!إيدو الّتي وقعنا في حبّها موجودة هنا

105
00:06:43,010 --> 00:06:45,000
جيش الباكوفو القديم؟

106
00:06:45,730 --> 00:06:49,380
بعد كلّ ما حدث، ما زالوا يريدون
الموت مع بلادهم؟

107
00:06:49,730 --> 00:06:52,630
!إلى جميع السّفن، استعداد

108
00:06:55,870 --> 00:06:57,260
!نار

109
00:07:03,090 --> 00:07:04,700
مـ-ما الّذي يجري؟

110
00:07:04,700 --> 00:07:07,490
!انفجرت الفوّهات بمجرّد إطلاقنا للنّار

111
00:07:07,980 --> 00:07:09,770
ما هذا الضّباب الأسود؟

112
00:07:10,640 --> 00:07:12,810
.ضباب اللّهب

113
00:07:12,810 --> 00:07:17,100
ستار دخانيّ يتفاعل مع درجات الحرارة
.المرتفعة ويمنع استعمال الأسلحة النّاريّة

114
00:07:17,100 --> 00:07:19,490
.فهمت

115
00:07:19,490 --> 00:07:22,930
.هذه ليست بلاد السّاموراي فحسب

116
00:07:22,930 --> 00:07:26,000
بل هي ملكٌ لكم أيضًا، أليس كذلك؟

117
00:07:27,360 --> 00:07:29,600
.تمّ إخلاء المواطنين

118
00:07:30,670 --> 00:07:32,700
.البلدة فارغة بالكامل

119
00:07:33,420 --> 00:07:34,880
كلّ شيء جاهز

120
00:07:35,810 --> 00:07:36,770
.أيّها القائد

121
00:07:38,400 --> 00:07:41,130
.يمكننا إطلاق العنان لأنفسنا بحرّيّة

122
00:07:41,550 --> 00:07:44,730
.كنينجا، واجبنا هو العيش في الظّلال

123
00:07:44,730 --> 00:07:49,330
لكنّنا لم نعد بحاجة لذلك الآن بعد
.أن فقدنا سيّدنا، نورنا

124
00:07:50,590 --> 00:07:54,830
أظهروا المهارات الّتي شحذتموها
.كما تريدون في وضح النّهار

125
00:07:55,450 --> 00:07:59,530
احفروا في أذهانهم حقيقة
.أنّ هذه البلاد ديار للنّينجا أيضًا

126
00:08:00,750 --> 00:08:05,410
ليس في الظّلال، بل تحت النّور
.الّذي يسطع فوقكم

127
00:08:05,790 --> 00:08:08,410
.عيشوا وموتوا إلى أقصى الدّرجات

128
00:08:10,320 --> 00:08:13,420
هل هذا هو الجواب الّذي توصّلت إليه؟

129
00:08:14,430 --> 00:08:16,510
.لا يوجد جواب صحيح

130
00:08:17,100 --> 00:08:21,180
لكن مثلما حاولت حماية الأميرة
،كصديق لشيغيشيغي

131
00:08:21,580 --> 00:08:25,290
،إن كانت تحاول القتال بصفتها أخت شيغيشيغي

132
00:08:25,290 --> 00:08:27,610
.فلا أملك الحقّ لإيقافها

133
00:08:29,090 --> 00:08:30,690
،في تلك الحالة

134
00:08:32,410 --> 00:08:35,230
.كلّ ما يمكنني فعله هو حماية كلّ شيء

135
00:08:37,450 --> 00:08:41,070
.هذا هو النّور الّذي يسطع فوقي الآن

136
00:08:46,250 --> 00:08:48,160
!سينضمّ الأونيوابان إلى المعركة

137
00:08:51,660 --> 00:08:53,580
.أعطني تقريرًا عن الوضع

138
00:08:53,580 --> 00:08:57,330
ظهر جيش الباكوفو القديم فجأة عند قصر إيدو

139
00:08:57,330 --> 00:09:00,330
.ووجّه ضربة خطيرة لأوّل موجة لنا

140
00:09:05,950 --> 00:09:07,350
!هجوم

141
00:09:18,780 --> 00:09:20,220
الأونيوابان؟

142
00:09:20,220 --> 00:09:21,420
!ساتشان

143
00:09:22,240 --> 00:09:25,240
.يبدو أنّهم خرجوا من الظّلال

144
00:09:25,730 --> 00:09:26,990
!انتهى وقت اللّعب

145
00:09:26,990 --> 00:09:29,700
!سأريكم قوّة النّينجا

146
00:09:29,700 --> 00:09:31,710
...ها أنا قادمة

147
00:09:31,710 --> 00:09:33,960
!غين-سان

148
00:09:31,710 --> 00:09:33,960
!لماذا غين-سان؟

149
00:09:33,960 --> 00:09:36,110
لِمَ تقفزين نحوي بذلك الوجه؟

150
00:09:36,110 --> 00:09:38,730
!بدوت كعدوّ أكثر من العدوّ نفسه

151
00:09:38,730 --> 00:09:39,990
.يا لقسوتك

152
00:09:39,990 --> 00:09:41,970
،لم نلتقِ منذ وقت طويل
ومع ذلك تحرجني هكذا؟

153
00:09:42,590 --> 00:09:45,490
.سوء معاملتك من مستوى آخر

154
00:09:45,490 --> 00:09:48,740
!أنا خنزيرتك مدى الحياة يا سيّدي

155
00:09:48,740 --> 00:09:50,720
يصعب التّعامل مع هذه المنحرفة
.بعد وقت طويل

156
00:09:50,720 --> 00:09:53,970
نسيت كيف أدافع ضدّ هذا، لذا هي تلقي
!بضربات جسديّة. سوف أتقيّأ

157
00:09:54,530 --> 00:09:55,850
.لكنّني وثقت بك

158
00:09:56,890 --> 00:09:58,930
.علمت أنّك ستعود

159
00:09:58,930 --> 00:10:00,930
.لقد بذلت ما في وسعي

160
00:10:00,930 --> 00:10:03,970
كنت واثقة أنّ الأمور ستسير بخير
.إن صمدنا حتّى عودتك

161
00:10:05,020 --> 00:10:06,370
.آسف لتأخّري

162
00:10:06,870 --> 00:10:08,600
.لا داعي للاعتذار

163
00:10:08,600 --> 00:10:11,640
.عدت كبيرًا جدًّا وصلبًا

164
00:10:11,640 --> 00:10:15,680
.لكنّني لست واثقة بشأن هذا الحجم
.قد لا أتمكن من تحمّله

165
00:10:15,680 --> 00:10:17,400
.هذا ليس غين-سان

166
00:10:17,400 --> 00:10:20,300
.غين-سان لا يتباهى إلى تلك الدّرجة

167
00:10:23,490 --> 00:10:28,760
لم أظنّ أنّني سأرى ذلك الأسلوب
.الفكاهيّ مجدّدًا قبل دمار العالم

168
00:10:29,310 --> 00:10:33,690
.وأنا أيضًا لم أظنّ أنّ شرجك سيُدَمّر قبل العالم

169
00:10:34,890 --> 00:10:37,600
!لا! عفّة غين-سان

170
00:10:37,600 --> 00:10:40,150
.تلك عفّة زين-سان وليس غين-سان

171
00:10:41,630 --> 00:10:47,160
لست متفائلاً لدرجة أنّني فكّرت
.أنّ الأمور ستتغيّر بمجرّد عودتك

172
00:10:47,770 --> 00:10:50,540
لكنّ النّظر إلى وجهك الغبيّ

173
00:10:51,820 --> 00:10:54,160
.ساعدني على الهدوء قليلاً

174
00:10:54,160 --> 00:10:56,080
.هذا ما أريد قوله

175
00:10:57,180 --> 00:10:58,830
...رؤيتكم ذكّرتني

176
00:11:01,210 --> 00:11:04,340
،أنّه حتّى وإن كان العالم سينتهي في اليوم الموالي

177
00:11:04,340 --> 00:11:07,840
نحن نوع الحمقى الّذين سيسرعون
.لشراء جامب كالعادة

178
00:11:08,760 --> 00:11:13,600
،وأنّه لا يهمّ إن انتهى العالم أم لا
.أو وصلت إليه أم لا

179
00:11:13,600 --> 00:11:16,320
وأنّني كنت نوع الأشخاص الّذين سيركضون
.بأقصى سرعة على أيّة حال

180
00:11:17,100 --> 00:11:21,060
.لوهلة كنت مستعدًّا لإنهاء الأمور لنفسي

181
00:11:21,530 --> 00:11:25,110
.لكنّكم أريتموني طريق العودة إلى هنا

182
00:11:26,240 --> 00:11:30,120
شكرًا لكم على انتظاري بصفتكم
.نفس الحمقى القدماء

183
00:11:33,410 --> 00:11:34,930
.يا لوقاحتك

184
00:11:34,930 --> 00:11:38,770
مصّ هيجيكاتا-سان غليون العفّة خاصّته إلى
،أن أصبح قادرًا على مصّه كمصّاصة أطفال

185
00:11:38,770 --> 00:11:40,230
وتدعوه نفس الأحمق القديم؟

186
00:11:40,230 --> 00:11:40,750
.اخرس

187
00:11:40,750 --> 00:11:44,160
.ذاك ليس أنا. أنا أُفضّل المجلاّت

188
00:11:44,160 --> 00:11:47,630
إن استمرّ هذا، فلن نتمكّن من شراء
.جامب أو تلك المجلاّت

189
00:11:47,630 --> 00:11:49,090
...في تلك الحالة

190
00:11:50,170 --> 00:11:53,350
!علينا إنقاذ العالم بحلول يوم الإثنين فحسب

191
00:11:55,600 --> 00:11:57,860
.هذا كلام كبير

192
00:11:57,860 --> 00:12:00,350
تريدون إنهاء نهاية العالم خلال نهاية الأسبوع؟

193
00:12:01,010 --> 00:12:03,630
.فلنقم بذلك إذًا

194
00:12:03,630 --> 00:12:06,820
سنحوّل المزحة السّخيفة إلى حقيقة بأيادينا

195
00:12:06,820 --> 00:12:10,280
!وسنضحك إلى أن تؤلمنا جوانبنا

196
00:12:10,830 --> 00:12:12,120
ما رأيك

197
00:12:12,670 --> 00:12:14,490
يا نائبة رئيس الميماواريغومي؟

198
00:12:15,230 --> 00:12:19,690
لا يسعني انتظار رؤية وجهك الغاضب
.عندما يحين الوقت

199
00:12:20,860 --> 00:12:23,250
.سأضحك كيفما أردت

200
00:12:24,640 --> 00:12:28,130
.لكن يبدو أنّ تلك الضّحكات لن تكون رخيصة

201
00:12:33,510 --> 00:12:38,970
.ضباب أسود؟ لن يكون ذلك كافيًا لمحو نيراننا

202
00:12:39,900 --> 00:12:42,770
،كلّما قاومتم، زاد الحزن والغضب الّذي يسبّبه ذلك

203
00:12:44,430 --> 00:12:48,030
.وزادت نيران انتقامنا

204
00:12:48,030 --> 00:12:49,790
السّلاح المتنقّل

205
00:12:51,310 --> 00:12:52,800
...تاكيميكازوتشي

206
00:12:55,250 --> 00:12:56,300
.إطلاق

207
00:13:02,800 --> 00:13:03,820
.إطلاق

208
00:13:13,890 --> 00:13:15,510
.يا إلهي

209
00:13:15,820 --> 00:13:17,580
.هذا سيّئ

210
00:13:17,580 --> 00:13:21,340
.يحاولون إحراق ضباب النّيران من الأعلى

211
00:13:22,320 --> 00:13:23,600
!أيّها الرّئيس

212
00:13:23,930 --> 00:13:25,330
.ليس جوًّا فحسب

213
00:13:25,330 --> 00:13:27,980
.التّعزيزات تتدفّق برًّا أيضًا

214
00:13:31,990 --> 00:13:34,110
!لا، هذا ليس كلّ شيء

215
00:13:34,110 --> 00:13:36,370
...هل يمكن أن يكونوا

216
00:13:36,770 --> 00:13:38,120
!الدّاكيني

217
00:13:39,740 --> 00:13:41,040
!الشّينرا

218
00:13:41,950 --> 00:13:43,290
!الياتو

219
00:13:43,290 --> 00:13:45,500
أجناس المحاربين الثّلاثة هنا؟

220
00:13:45,500 --> 00:13:47,950
ضمّوهم إلى جانبهم؟

221
00:13:48,880 --> 00:13:52,280
هل كنّا نقاتل المقبّلات فحسب كلّ هذا الوقت؟

222
00:13:52,280 --> 00:13:57,550
،يا إلهي. فلننس نهاية الأسبوع
.قد لا نصمد يومًا واحدًا

223
00:13:57,550 --> 00:13:59,660
أخيرًا؟

224
00:14:01,740 --> 00:14:02,770
!غينغاي-سان

225
00:14:03,280 --> 00:14:05,560
.يبدو أنّ دورنا قد حان

226
00:14:05,560 --> 00:14:11,070
إن كانت تلك لعبة العدوّ، فما علينا سوى
.أن نبذل كلّ ما لدينا نحن أيضًا

227
00:14:11,070 --> 00:14:15,320
.لنرهم ما يمكن للأرض فعله

228
00:14:15,760 --> 00:14:17,320
...أيّها الجدّ

229
00:14:18,320 --> 00:14:21,240
نحن أوّلاً إذًا؟

230
00:14:21,620 --> 00:14:23,180
.ما باليد حيلة

231
00:14:23,180 --> 00:14:24,620
،إن لم تكن الفضّة قادرة على إنجاز المهمّة

232
00:14:26,990 --> 00:14:29,460
.فعلى الذّهب أن يقبل التّحدّي

233
00:14:30,060 --> 00:14:32,810
،من تنظيف فوضى أحمق إلى إنقاذ العالم

234
00:14:32,810 --> 00:14:35,720
.سيقوم كين-تشان للأعمال الحرّة بأيّ شيء

235
00:14:35,720 --> 00:14:37,130
!كين-سان

236
00:14:37,130 --> 00:14:38,220
!أنت

237
00:14:38,220 --> 00:14:41,450
.مرحبًا أيّها الشّخصيّة الرّئيسيّة المعيبة

238
00:14:42,080 --> 00:14:47,820
الرّجل الّذي تمّ تشكيلي على هيأته
يعاني المشاكل في إنقاذ العالم؟

239
00:14:47,820 --> 00:14:50,230
.سأهتمّ بنصف العالم

240
00:14:51,360 --> 00:14:55,730
أنا واثق أنّه حتّى قطعة معيبة مثلك
.يمكنها التّعامل مع النّصف الآخر

241
00:14:57,340 --> 00:15:00,430
إنّه لا يتعلّم كالعادة، أليس كذلك؟

242
00:15:00,430 --> 00:15:05,200
.ذهب أو فضّة، جميعنا مجرّد مسنّنات

243
00:15:06,370 --> 00:15:12,250
،لكن إن اتّحدنا جميعًا نحن المسنّنات
.فسيمكننا إدارة آلة العالم

244
00:15:12,250 --> 00:15:17,070
من الآن، محافظة كابوكي هي الرّكن
.الأساسيّ لدفاع البشريّة

245
00:15:19,020 --> 00:15:20,300
...الباقي

246
00:15:20,970 --> 00:15:22,760
.أجل، يمكنك الاعتماد علينا

247
00:15:22,760 --> 00:15:24,800
!أيّها الجدّ! تاما

248
00:15:24,800 --> 00:15:27,100
!ما الّذي تفكرّان به؟

249
00:15:27,900 --> 00:15:29,070
!أيّها الجدّ

250
00:15:32,150 --> 00:15:35,530
ما الهدف من صنع هذه الآلات القاتلة؟

251
00:15:35,530 --> 00:15:40,280
ألم تقل دائمًا أنّك تريد صنع آلة تخدم البشريّة؟

252
00:15:41,020 --> 00:15:47,410
أحببت رؤيتك تستمتع بالتّصليح
.وأنت مغطّى بالزّيت

253
00:15:50,350 --> 00:15:54,930
وبعدها انضممت إلى الحرب بدلا منّي

254
00:15:54,930 --> 00:15:58,090
.ومتّ وتركت هذا العجوز

255
00:15:59,150 --> 00:16:01,540
.حدث الكثير منذ ذلك الوقت

256
00:16:01,540 --> 00:16:04,850
التقيت الكثير من النّاس وخطرت
.ببالي الكثير من الأفكار

257
00:16:05,660 --> 00:16:08,600
،أفكار عن سبب نجاتي

258
00:16:08,600 --> 00:16:11,600
.وعن سبب صنعي للآلات

259
00:16:12,190 --> 00:16:13,360
...والجواب

260
00:16:19,450 --> 00:16:24,450
.أنت والنّاس الّذين أحضرتهم إلى حياتي أروني

261
00:16:24,890 --> 00:16:29,840
.سبب صنعي للآلات هو هذه اللّحظة

262
00:16:30,770 --> 00:16:33,500
!مـ-ما هذا المدفع الضّخم؟

263
00:16:35,810 --> 00:16:40,300
.الآلات موجودة لخدمة ومساعدة النّاس

264
00:16:41,470 --> 00:16:43,300
...هذا هو جوابي

265
00:16:44,700 --> 00:16:49,680
!مدفع نيو أرمسترونغ سايكلون جيت أرمسترونغ غينغاي

266
00:16:49,680 --> 00:16:51,270
!إنّها مجرد مزحة دنيئة

267
00:16:51,270 --> 00:16:53,770
!نما للأرض قضـ*ب

268
00:16:57,150 --> 00:16:59,090
.فات الأوان

269
00:17:00,490 --> 00:17:06,310
منذ اللّحظة الّتي خسرنا أمامك
،في حرب جوي إلى هذه اللّحظة

270
00:17:06,310 --> 00:17:09,980
.كنت أصنع هذا الشّيء في السّرّ تحت الأرض

271
00:17:11,520 --> 00:17:15,250
تاما، كينّوجي. هلاّ قمتما بالأمر؟

272
00:17:15,680 --> 00:17:19,710
.أحتاج مساعدتكما لتشغيل ذلك الشّيء

273
00:17:20,540 --> 00:17:26,000
عندما يربط الذّهب والملكة الآليّة كرتَيْ
،التّحكّم وتصبحان الكرتين الذّهبيّتين

274
00:17:26,000 --> 00:17:28,470
.يمكنهما إطلاق شيء من هذا العمود هنا

275
00:17:28,470 --> 00:17:30,350
!إنّها مجرّد نكتة دنيئة

276
00:17:30,720 --> 00:17:33,920
.لقد قوّينا أنفسنا بالفعل يا غينغاي-ساما

277
00:17:35,330 --> 00:17:39,860
...لا تضيّع هذا المسنّن الذّهبيّ

278
00:17:40,220 --> 00:17:41,170
.أيّها الجدّ

279
00:17:43,150 --> 00:17:44,610
.آسف، وشكرًا لكما

280
00:17:46,860 --> 00:17:51,090
.لم نخسر أمامكم حينها

281
00:17:51,520 --> 00:17:55,580
.بل خسرنا أمام عِلمكم وتقنيتكم، آلاتكم

282
00:17:55,890 --> 00:18:00,570
.لكنّنا امتصصنا تقنيّتكم وتطوّرنا

283
00:18:01,370 --> 00:18:04,630
،كي لا تُؤخَذ منّا الأشياء القيّمة لنا من جديد

284
00:18:04,630 --> 00:18:07,390
.واصلنا إدارة المسنّنات يوميًّا

285
00:18:07,970 --> 00:18:10,890
.أنا مدين لكم على ذلك الوقت أيّها الأمانتو

286
00:18:10,890 --> 00:18:12,930
.سأردّ لكم الدّين الآن

287
00:18:15,010 --> 00:18:18,010
.مع الخردة المعدنيّة الّتي وقعت في حبّها

288
00:18:38,670 --> 00:18:42,120
!يا آلات إيدو

289
00:18:42,120 --> 00:18:44,920
!دعيني أستعير مسنّناتك

290
00:18:45,290 --> 00:18:48,930
!أريهم قوّتك

291
00:18:52,810 --> 00:18:57,270
!هيّا

292
00:19:15,710 --> 00:19:16,430
...مـ

293
00:19:16,880 --> 00:19:19,120
...ما هذا؟ لم يحدث شيء

294
00:19:31,790 --> 00:19:32,830
،إذًا

295
00:19:33,390 --> 00:19:36,430
...الآلة الّتي ستوقف الحرب هي

296
00:19:36,430 --> 00:19:39,440
.أجل، ليس هذا الأنبوب الضّخم

297
00:19:39,440 --> 00:19:41,190
.بل الأنابيب الصّغيرة هذه

298
00:19:41,710 --> 00:19:44,170
.إنّها ما تسمى بالآلات الجزيئيّة

299
00:19:45,010 --> 00:19:47,120
.سميّتها بالنّحل

300
00:19:49,130 --> 00:19:53,400
إن أطلقها هذا الشّيء، سيبقى النّحل في الهواء

301
00:19:53,400 --> 00:19:55,230
.وستخترق أيّ آلة

302
00:19:55,950 --> 00:20:00,330
وسيتحكّم فيروسها في أنظمة الأهداف

303
00:20:01,960 --> 00:20:05,070
.ويوقف وظائفها

304
00:20:05,960 --> 00:20:07,590
...بمعنى آخر

305
00:20:08,130 --> 00:20:10,810
.إنّها آلات تقتل الآلات

306
00:20:11,360 --> 00:20:15,810
لكن لن تكون هناك فائدة من إيقاف
.جيش التّحرير للحظة

307
00:20:16,290 --> 00:20:20,380
إن كنّا سنستعملها، فيجب أن نستعملها
.لنشكّل حاجزًا يغطّي البلاد بأكملها

308
00:20:21,100 --> 00:20:26,610
.أي أنّه لكي تنجو البشريّة، علينا التّخلّي عنكم

309
00:20:26,610 --> 00:20:29,760
...وأيضًا، أهمّ ما يجب تذكّره هو أنّه

310
00:20:29,760 --> 00:20:32,320
،عندما يكون المدفع مجمّدًا

311
00:20:32,320 --> 00:20:36,830
ستحتاج لآلات تتولّى التّحكّم من النّظام، صحيح؟

312
00:20:38,060 --> 00:20:40,750
من يمكنه ذلك غيرنا؟

313
00:20:41,170 --> 00:20:42,500
...كينّوجي

314
00:20:42,840 --> 00:20:44,490
هل تدرك ما تقوله؟

315
00:20:44,490 --> 00:20:49,060
!هذا دور منافٍ للعقل يحتّم قتل نفسك

316
00:20:49,060 --> 00:20:52,010
لكنّ العالم سينتهي إن لم نفعل ذلك، صحيح؟

317
00:20:52,390 --> 00:20:56,480
.كما أنّني لن أقاتل جيش التّحرير

318
00:20:59,230 --> 00:21:00,390
.بل ذلك الرّجل

319
00:21:01,730 --> 00:21:06,420
.حان الوقت أخيرًا لأردّ له دين ذلك اليوم

320
00:21:06,420 --> 00:21:11,470
.إن كان يحاول إنقاذ العالم، فسأنقذه قبله

321
00:21:11,470 --> 00:21:14,660
.هذا هو انتقام ساكاتا كينتوكي

322
00:21:15,150 --> 00:21:18,160
أليست فكرة ذهبيّة يا تاما-سان؟

323
00:21:18,160 --> 00:21:21,310
اللّون الذّهبيّ يشبه لون البراز البنيّ
نوعًا ما، أليس كذلك؟

324
00:21:21,310 --> 00:21:25,570
.مهلاً. أرى أنّك باردة تجاه الآلات كعادتك

325
00:21:25,570 --> 00:21:26,620
...لكن

326
00:21:27,520 --> 00:21:32,170
.في أعماقك، أنت آلة صنعها غينغاي-ساما أيضًا

327
00:21:32,540 --> 00:21:35,930
.لا داعي للقلق يا غينغاي-ساما

328
00:21:36,290 --> 00:21:38,170
.نحن نعلم

329
00:21:38,890 --> 00:21:43,340
.جميع الآلات الّتي صنعت عن حبّ تعلم

330
00:21:44,060 --> 00:21:49,350
نعلم كيف شعرت عندما أدرت
.المسنّنات يومًا بعد يوم

331
00:21:54,970 --> 00:22:00,450
.نعلم أنّ الآلات موجودة لخدمة النّاس

332
00:22:12,250 --> 00:22:15,840
!أيّها الجدّ

333
00:22:15,840 --> 00:22:16,720
!تاما

334
00:22:18,350 --> 00:22:22,140
!تاما

335
00:24:00,820 --> 00:24:12,500
،عزيمة الآلات

336
00:24:00,820 --> 00:24:12,500
.وعزيمة البشر