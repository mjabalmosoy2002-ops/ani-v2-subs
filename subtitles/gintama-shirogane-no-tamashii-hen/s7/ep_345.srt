1
00:00:01,190 --> 00:00:08,380
!!شاهدوا فصل الرّوح الفضّيّة في غرفة مضيئة ومن مسافة آمنة من تلفازكم

2
00:00:04,690 --> 00:00:09,360
.مع أنّ النّهاية اختتام، هي أيضًا تحرير

3
00:00:09,710 --> 00:00:15,120
.بالنّهاية نتحرّر من كلّ ما يقيّدنا

4
00:00:15,740 --> 00:00:18,910
،كحلقة الحروب الغبيّة الأبديّة

5
00:00:18,910 --> 00:00:22,120
.أو بما تسبّبته من حزن ومعاناة

6
00:00:22,670 --> 00:00:27,380
ومع ذلك يا ساكاتا غينتوكي تقف هناك ثابتًا؟

7
00:00:27,760 --> 00:00:31,630
...ترفض النّهاية وتختار مواصلة المعاناة

8
00:00:31,630 --> 00:00:35,390
تختار معاناة الإطاحة بمعلّمك؟

9
00:00:35,710 --> 00:00:38,970
.عليّ أنا أيضًا أن أختار إذًا

10
00:00:39,680 --> 00:00:43,520
.أن أختار معاناة الإطاحة بتلميذي

11
00:00:44,510 --> 00:00:45,270
...هذا

12
00:00:45,640 --> 00:00:48,640
!ثالث وآخر أجنحة ناراكو الثّلاثة، هيتسوغي

13
00:01:01,080 --> 00:01:03,370
معلّم؟ تلميذ؟

14
00:01:03,370 --> 00:01:05,080
.ذلك الهراء غير موجودٍ هنا

15
00:01:07,710 --> 00:01:12,220
.الرّجل الّذي أمامي ليس إلاّ رجلاً شرّيرًا

16
00:01:12,220 --> 00:01:14,220
والرّجل الّذي أمامك

17
00:01:14,220 --> 00:01:17,020
!ليس سوى عميل حرّ

18
00:01:25,580 --> 00:01:27,100
أخذت دمه أنت أيضًا؟

19
00:01:47,180 --> 00:01:48,130
!لا نهاية لهم

20
00:02:10,730 --> 00:02:12,110
هل انتهى الوقت؟

21
00:02:12,770 --> 00:02:15,990
.سأؤمّن طريقًا للهرب. اهربا

22
00:02:15,990 --> 00:02:19,290
.لا يمكننا قتال أوتسورو وجيش التّحرير في آنٍ واحد

23
00:02:19,290 --> 00:02:21,990
.أنا آسفة. لم أفكّر في الأمور جيّدًا

24
00:02:22,910 --> 00:02:26,870
لا يمكننا أن نهزم ذلك الرّجل الخالد

25
00:02:27,310 --> 00:02:30,750
.وجيشه الخالد بمفردنا الآن

26
00:02:38,320 --> 00:02:39,390
.لن يصل

27
00:03:00,660 --> 00:03:02,130
.لا يمكنه أن يصل

28
00:03:08,000 --> 00:03:09,210
...سيفك

29
00:03:10,210 --> 00:03:13,460
.لا يمكنه الوصول إليّ

30
00:03:13,460 --> 00:03:14,960
!أوتسورو

31
00:03:28,940 --> 00:03:30,450
...أوتسورو

32
00:03:31,310 --> 00:03:32,480
!أسرع

33
00:04:20,810 --> 00:04:23,010
.لقد انكسرت نظّارتك

34
00:04:23,010 --> 00:04:28,330
.آمل أن يكون ما أراه خطأ سبّبته نظّارتي أيضًا

35
00:04:28,810 --> 00:04:33,570
لكن للأسف، يبدو أنّ نظّارتي ليست
.الشّيء الوحيد الّذي انكسر

36
00:04:39,830 --> 00:04:40,860
!غين-سان

37
00:04:40,860 --> 00:04:42,090
!نوبوتاس

38
00:04:44,170 --> 00:04:47,710
.أسرع وأوقف أوتسورو وجيش التّحرير

39
00:04:48,370 --> 00:04:50,610
.انسَ أمري

40
00:04:51,260 --> 00:04:54,340
.فعل كلانا أشياءً ما كنّا لنفعلها عادةً

41
00:04:54,910 --> 00:04:59,350
.لم أرد أن أشاهد فرصنا تسوء أكثر فحسب

42
00:04:59,970 --> 00:05:01,740
تذكّري إذًا

43
00:05:02,270 --> 00:05:07,360
،أنّك في نظرنا جزء قيّم من فرصنا أيضًا

44
00:05:08,350 --> 00:05:11,320
.يا نائبة رئيس الميماواريغومي، إيماي نوبومي

45
00:05:11,320 --> 00:05:15,940
.نحتاجك أن تقومي أيضًا بحصّة رئيسك من العمل

46
00:05:15,940 --> 00:05:17,870
.لكن إيّاك والموت هنا

47
00:05:18,370 --> 00:05:20,010
.سيضحك في وجهك

48
00:05:22,190 --> 00:05:24,860
.أنا واثقة أنّه يضحك بالفعل

49
00:05:26,860 --> 00:05:33,530
إيسابورو، يبدو أنّ لي غايةً حتّى
.في عالم أنت لست فيه

50
00:05:34,430 --> 00:05:36,140
...لكنّني لا أدري

51
00:05:36,140 --> 00:05:39,190
،لقد ائتمنتهم على آمالك

52
00:05:39,190 --> 00:05:43,650
.لكنّمي لا أدري كيف أحميهم من ذلك الشّرّ الكبير

53
00:05:45,900 --> 00:05:51,900
لا أدري كيف أحمي إيدو هذه الّتي فقدت
.شرطة النّخبة وشرطة المشاغبين أيضًا

54
00:05:52,240 --> 00:05:55,020
.تمّ إسكات العدوّ بالنّيران المركّزة

55
00:05:55,020 --> 00:05:57,010
.لا توجد أيّ إشارة لبقاء أيّ عدوّ

56
00:05:58,400 --> 00:06:00,250
ما الّذي تقوله؟

57
00:06:00,250 --> 00:06:02,850
.العدوّ لا يزال هناك

58
00:06:07,970 --> 00:06:09,900
.احرقوا كلّ شيء

59
00:06:11,200 --> 00:06:12,430
!انتهى أمرنا

60
00:06:12,430 --> 00:06:16,480
!لهذا السّبب قلت أنّ علينا الاستسلام في الحال

61
00:06:16,480 --> 00:06:21,180
نستسلم ونوبونوبو-ساما كان وسط مفاوضات معهم؟

62
00:06:21,550 --> 00:06:23,840
!لا يمكننا الوثوق في شوغن شكليّ

63
00:06:23,840 --> 00:06:27,190
!أنا واثق أنّه تخلّى عن هذه البلاد وهرب

64
00:06:27,190 --> 00:06:31,980
إن ضيّعنا الوقت هنا، فسنموت
!في الّنهاية مع البلاد أيضًا

65
00:06:34,530 --> 00:06:36,700
.تفضّلوا واهربوا

66
00:06:37,610 --> 00:06:40,190
.لا داعي للقلق على البلاد

67
00:06:40,190 --> 00:06:43,200
.سأعتني بالقصر أثناء غيابكم

68
00:06:43,200 --> 00:06:45,390
.الـ-الأميرة سويو

69
00:06:46,670 --> 00:06:48,710
ماذا فعلت الأميرة سويو؟

70
00:06:49,230 --> 00:06:53,460
لِمَ لم تراقبوها جيّدًا؟
.قلت لكم مرارًا أن تنتبهوا جيّدًا

71
00:06:53,910 --> 00:06:55,470
.نحن آسفون للغاية

72
00:06:55,700 --> 00:06:59,850
،لم نستطع أن نتبعها إلى الحمّام
.فاستغلّت تلك الفرصة

73
00:06:59,850 --> 00:07:01,900
.ابحثوا عنها في الحال

74
00:07:01,900 --> 00:07:02,600
!حاضر

75
00:07:04,880 --> 00:07:06,850
.انتهى أمر هذه البلاد

76
00:07:07,310 --> 00:07:09,940
.لديك عمل واحد الآن

77
00:07:10,480 --> 00:07:11,970
.اهربي أيّتها الأميرة سويو

78
00:07:13,230 --> 00:07:15,500
.ستبتلع نيران الحرب إيدو قريبًا

79
00:07:16,010 --> 00:07:19,110
.جهّزي سفينة تخرجك من الأرض في الحال

80
00:07:20,510 --> 00:07:24,740
.زينزو-سان، أريد أن أقاتل معكم جميعًا

81
00:07:25,130 --> 00:07:27,360
...فأنا في النّهاية

82
00:07:27,360 --> 00:07:31,250
.أخت الشّوغن توكوغاوا شيغيشيغي

83
00:07:31,600 --> 00:07:34,440
.أنت لم تعودي أخت الشّوغن

84
00:07:34,440 --> 00:07:36,970
!انتبه لما تقوله يا زينزو-دونو

85
00:07:37,280 --> 00:07:41,660
أنت مجرّد أخت، وواجبك أن تعيشي
.حياتك وحياة أخيك أيضًا

86
00:07:41,660 --> 00:07:45,750
،وبصفتي الشّخص الّذي فشل في حماية أخيك

87
00:07:45,750 --> 00:07:48,020
.فواجبي هو حمايتك حتّى النّهاية

88
00:07:48,410 --> 00:07:50,770
.ما حدث لأخي ليس خطأك

89
00:07:50,770 --> 00:07:52,110
.انسي الأمر

90
00:07:52,110 --> 00:07:56,330
إن كنت ستغضبين، فسأجرّك حتّى
.وإن اضطررت لصفعك

91
00:07:56,330 --> 00:07:58,570
حقًّا؟ وماذا ستفعل بعد ذلك؟

92
00:07:59,110 --> 00:08:04,770
،هل ستعيش في أرض ليس فيها أيّ وجه مألوف
وتعدّ جميع الأصدقاء الّذين فقدتهم؟

93
00:08:05,230 --> 00:08:09,660
زينزو، استعمال حياتك للتّعويض
.عن خذلان صديقك أمر جيّد

94
00:08:09,660 --> 00:08:14,790
لكن لا تنسَ أنّ لديك أصدقاءً آخرين
.هنا يبذلون وسعهم للعيش

95
00:08:15,760 --> 00:08:18,420
.جامب هي الصّديق الوحيد الّذي لديّ

96
00:08:18,420 --> 00:08:22,140
.وأنا صديقتي الوحيدة هي بيسّاتسو مارغريت

97
00:08:22,620 --> 00:08:23,930
.لكن هذا ما أشعر به

98
00:08:23,930 --> 00:08:27,040
عَيش حياة صديق ميّت

99
00:08:27,040 --> 00:08:31,360
والقتال والموت مع الأصدقاء
الّذين لا يزالون أحياءً

100
00:08:31,360 --> 00:08:33,790
.كلاهما برهان على الصّداقة

101
00:08:35,150 --> 00:08:38,890
زينزو-سان، ذلك الشّخص يقاتل، أليس كذلك؟

102
00:08:39,330 --> 00:08:42,830
.عليّ إذًا... أن أقاتل أنا أيضًا

103
00:08:42,830 --> 00:08:47,610
علينا أن نقاوم ونزحف خارج
.أعماق الحزن والكراهية

104
00:08:48,290 --> 00:08:49,830
!لا يمكننا أن نخسر

105
00:08:50,150 --> 00:08:51,830
!ليس أمامه

106
00:08:53,960 --> 00:08:56,550
.حقًّا؟ فهمت

107
00:08:57,340 --> 00:08:58,770
إلى أين أنت ذاهب؟

108
00:08:58,770 --> 00:09:03,900
إن كانت الأميرة ستبقى، فلن أكون
.ذا فائدة لها بالقرب منها

109
00:09:03,900 --> 00:09:06,220
.اعتني بها يا موموتشي

110
00:09:06,220 --> 00:09:07,420
!زينزو-سان

111
00:09:07,420 --> 00:09:11,230
.سأفعل ما أريد، لذا افعلي ما تريدين أيضًا

112
00:09:11,840 --> 00:09:15,600
.ليس كأميرة، بل كأخته الصّغيرة

113
00:09:21,250 --> 00:09:22,460
...الأميرة

114
00:09:24,320 --> 00:09:26,240
ما الّذي تفكّرين به؟

115
00:09:26,680 --> 00:09:30,480
.عليكم جميعًا أن تخلوا المكان بسرعة

116
00:09:30,480 --> 00:09:33,020
.سأعتني بالقصر بنفسي

117
00:09:33,020 --> 00:09:34,500
!ما هذا الغباء الّذي تتفوّهين به؟

118
00:09:34,500 --> 00:09:37,020
.لا يمكننا أن نترك هذا القصر فارغًا

119
00:09:37,020 --> 00:09:41,880
كيف للبلاد أن تتخلّى عن شعبها
وهم يدافعون عنها؟

120
00:09:41,880 --> 00:09:44,930
لكن ما الّذي يفرض عليك الوصول إلى هذا الحدّ؟

121
00:09:44,930 --> 00:09:47,450
!فقد أخذت هذه البلاد حياة أخيك

122
00:09:47,450 --> 00:09:48,650
...وأنت

123
00:09:48,650 --> 00:09:50,390
.لست أميرة

124
00:09:50,390 --> 00:09:52,890
.أنا أخت توكوغاوا شيغيشيغي

125
00:09:53,370 --> 00:09:55,310
.وسأبقى كذلك إلى الأبد

126
00:10:00,400 --> 00:10:01,790
...إذًا أوتسورو

127
00:10:01,790 --> 00:10:03,900
.آسف. تركته يهرب

128
00:10:03,900 --> 00:10:06,850
.أو ربّما هو من تركني أهرب

129
00:10:06,850 --> 00:10:09,100
.لكن لا بدّ أنّه علق في ذلك الانفجار

130
00:10:09,100 --> 00:10:12,160
لو كان من النّوع الّذي سيموت جرّاء ذلك
.لما كنّا نواجه المشاكل

131
00:10:12,160 --> 00:10:15,670
لم نستطع فعل شيء في النّهاية إذًا؟

132
00:10:15,670 --> 00:10:18,040
لم نستطع حماية شيء؟

133
00:10:18,040 --> 00:10:20,170
أكلّ شيء يجري كما يريد أوتسورو؟

134
00:10:20,170 --> 00:10:22,920
ألم يعد إيقاف الحرب أمرًا ممكنًا؟

135
00:10:22,920 --> 00:10:24,170
!لا تستسلمي

136
00:10:24,550 --> 00:10:27,430
!لم يفت الأوان بعد! ما زال بإمكاننا إيقافها

137
00:10:50,220 --> 00:10:51,160
.أطلقوا

138
00:11:27,330 --> 00:11:29,190
.أخبرتكم

139
00:11:29,190 --> 00:11:34,290
إن بدؤوا الهجوم من السّماء، فلن تبقى لدينا
.فرصة لحصد المجد نحن جنود البرّ

140
00:11:34,290 --> 00:11:37,350
نقاتل على أربعة قرود قذرة؟

141
00:11:37,350 --> 00:11:41,290
،ما يهمّ في الصّيد ليس الطّريدة
.بل الصيّادون الّذين تواجههم

142
00:11:43,920 --> 00:11:45,280
!اركضا

143
00:12:12,670 --> 00:12:17,540
أركض وأركض، لكنّني لا أشعر
.أنّني أصل إلى أيّ مكان

144
00:12:19,070 --> 00:12:20,620
...سيفك

145
00:12:23,290 --> 00:12:25,170
.لا يمكنه أن يصلني

146
00:12:25,420 --> 00:12:31,660
ألم أتقدّم خطوة واحدة منذ ذلك الوقت؟

147
00:12:45,070 --> 00:12:47,070
.لا أظنّ أنّي سأصله أبدًا

148
00:12:49,280 --> 00:12:51,530
!لم ينتهِ الأمر بعد

149
00:12:57,710 --> 00:12:59,840
.لا تنهوا الأمور بأنفسكم

150
00:13:02,850 --> 00:13:06,000
.تابعوا النّظر إلى الأمام وأياديكم على سيوفكم

151
00:13:08,490 --> 00:13:11,590
!قاتلوا أيّتها الأعمال الحرّة

152
00:13:16,490 --> 00:13:18,700
!معنا نحن الشّينسينغومي

153
00:14:58,480 --> 00:15:00,160
مـ-ما الّذي يجري؟

154
00:15:00,160 --> 00:15:03,930
!د-دبّاباتنا تطلق النّار علينا

155
00:15:03,930 --> 00:15:07,120
.أصدقاؤكم ليسوا هنا

156
00:15:08,460 --> 00:15:13,130
.أوقفوا عرباتهم في مكان غريب وكانوا يعيقون المرور

157
00:15:13,130 --> 00:15:16,010
.لذا أصدرنا لم تذاكر مرور وصادرنا عرباتهم

158
00:15:16,010 --> 00:15:18,430
.نحن الآن نحقّق في القضيّة

159
00:15:18,750 --> 00:15:21,760
.لكنّكم لن تفلتوا بسهولة

160
00:15:21,760 --> 00:15:25,180
بسبب خرق قوانين المرور وتدمير
،الملكيّات العامّة وغيره

161
00:15:27,660 --> 00:15:29,650
!أنتم رهن الاعتقال

162
00:15:29,650 --> 00:15:31,650
...أ-أنتم

163
00:15:32,610 --> 00:15:34,130
.الشّرطة

164
00:15:41,470 --> 00:15:42,660
هل عادوا؟

165
00:15:43,650 --> 00:15:47,020
هل عادت شرطة مشاغبي إيدو إلى البلدة؟

166
00:15:51,040 --> 00:15:52,750
!هجوم

167
00:16:01,040 --> 00:16:03,440
لِمَ أنتم واقفون مكانكم؟

168
00:16:03,440 --> 00:16:04,760
.سنترككم

169
00:16:05,500 --> 00:16:07,270
.بدأت المعركة للتّوّ

170
00:16:08,190 --> 00:16:09,770
...هذه البلاد

171
00:16:13,520 --> 00:16:15,020
.لم تنتهِ بعد

172
00:16:17,650 --> 00:16:18,830
!نار

173
00:16:22,660 --> 00:16:23,910
ماذا؟

174
00:16:28,590 --> 00:16:29,910
.يا إلهي

175
00:16:30,750 --> 00:16:35,330
،جمعت الجنود للإطاحة ببلاد نوبونوبو

176
00:16:35,330 --> 00:16:36,920
.لكن انظروا ما الّذي أفعله

177
00:16:36,920 --> 00:16:39,670
.اغربوا عن وجهي أيّها الأغبياء

178
00:16:39,670 --> 00:16:43,650
،كنتم تقاتلون بلادًا فارغةً

179
00:16:43,650 --> 00:16:46,430
.لكنّ أصحابها عادوا الآن

180
00:16:46,960 --> 00:16:50,380
،سواء كنّا سندافع عن هذه البلاد أو ندمّرها

181
00:16:50,380 --> 00:16:54,060
!ذلك قرارنا نحن سكّانها

182
00:16:54,060 --> 00:16:56,200
.لا علاقة لكم بهذه البلاد

183
00:16:56,200 --> 00:16:59,170
!أروهم يا رجال مدى قوّة هذه البلاد الحقيقيّة

184
00:17:16,000 --> 00:17:19,130
،ظننتك فقدت رغبتك في القتال خوفًا

185
00:17:19,130 --> 00:17:22,230
لكنّني سعيد لأراك لا تزال نفس
.الأحمق الّذي لا يمكن توقعّه

186
00:17:22,230 --> 00:17:23,590
.انظروا من يتحدّث

187
00:17:23,590 --> 00:17:27,850
استغرقت وقتًا طويلاً لإخراج بيضتيك
.بعد أن تقلّصتا إلى الدّاخل

188
00:17:28,290 --> 00:17:31,590
عندما يتحوّل عدوّك من بلاد واحدة
،إلى الكون بأسره

189
00:17:31,590 --> 00:17:34,540
.فلا توجد بيضة كبيرة بما يكفي

190
00:17:35,520 --> 00:17:38,270
!آسفون! حاولنا منع هذا، لكنّنا فشلنا

191
00:17:38,270 --> 00:17:44,170
يا إلهي. من الّتي قالت بكلّ غرور
أن ندع إيدو بين يديها؟

192
00:17:44,170 --> 00:17:50,750
وفم من القذر الّذي قال
أنّه سيعود أقوى من أيّ أحد؟

193
00:17:50,750 --> 00:17:54,710
على الأقلّ أصبحت قويًّا بما يكفي
.لأقضي عليك بضربة واحدة

194
00:17:54,710 --> 00:17:57,340
،جمعنا ثوّارًا من جميع أنحاء البلاد

195
00:17:57,340 --> 00:18:00,760
واستعملنا روابط الباكوفو وحصلنا
.على دعم بلدان أخرى

196
00:18:00,760 --> 00:18:03,940
لدينا قوّة سياسيّة أكثر ممّا
.كنّا لنتصورّ من قبل

197
00:18:03,940 --> 00:18:06,940
.لقد اشترينا أيضًا أسلحة متطوّرة وسفنًا حربيّة

198
00:18:06,940 --> 00:18:08,260
حقًّا؟

199
00:18:10,640 --> 00:18:15,230
وكم من الوقت سيصمد كلّ ذلك
أمام الكون بأكمله؟

200
00:18:24,770 --> 00:18:26,740
،حتّى وإن لم نستطع الفوز بالحرب

201
00:18:26,740 --> 00:18:30,320
.فقد نتمكّن من فتح ثغرة نوقفها بها

202
00:18:31,090 --> 00:18:34,620
وأيضًا، قوّتنا السّياسيّة وأسلحتنا ليست
.الأشياء الوحيدة الّتي أصبحت أقوى

203
00:18:34,620 --> 00:18:36,120
!كوندو-سان

204
00:18:36,120 --> 00:18:40,570
هل تظنّون حقًّا أنّنا لم نكن نفعل شيئًا
أثناء غيابنا عن إيدو؟

205
00:18:42,530 --> 00:18:49,050
أقسمنا أن نحمي إيدو بالتّأكيد هذه
.المرّة، وأن نصبح أقوى لفعل ذلك

206
00:18:49,550 --> 00:18:54,080
اجلس وشاهد قوّة الشّينسينغومي
.الّتي ولدت من جديد

207
00:18:55,060 --> 00:18:56,560
...مستحيل، أكان ذلك

208
00:18:56,560 --> 00:18:59,710
،قيد لكبح قوّتي المسرفة

209
00:18:59,710 --> 00:19:05,070
إنّها عصابة رأس من خليط معدنيّ خاصّ
.يضع حملاً عليّ باستمرار ليجعلني أقوى

210
00:19:05,450 --> 00:19:09,200
هل ظننت حقًّا أنّني قد أغيّر زيّي من دون سبب؟

211
00:19:10,070 --> 00:19:14,000
.حان الوقت أخيرًا لأطلق هذه القوّة

212
00:19:14,000 --> 00:19:16,080
...غوري

213
00:19:16,410 --> 00:19:19,500
.لم أشعر برأسي بهذه الخفّة منذ وقت طويل

214
00:19:19,500 --> 00:19:21,280
!بالطّبع هو كذلك! لأنّه فارغ

215
00:19:21,280 --> 00:19:22,590
!"لقد بالغت كثيرًا بذلك "الإطلاق

216
00:19:22,590 --> 00:19:25,570
!من هذا الّذي ينسّق زيّه كاملاً مع الأثقال؟

217
00:19:25,570 --> 00:19:28,220
.ويحي، كدت أنسى خلع هذا أيضًا

218
00:19:29,050 --> 00:19:30,850
!لا تخلع نقاط الحجب

219
00:19:31,180 --> 00:19:34,720
.ما هذا؟ لا يمكنني الشّعور بوزني حتّى

220
00:19:34,720 --> 00:19:38,600
.كما لو أنّني اتّحدت مع الكون

221
00:19:38,600 --> 00:19:40,760
!كوندو-سان

222
00:19:40,760 --> 00:19:44,110
أنت. إلى أين تنظر أيّها الخردة المعدنيّة؟

223
00:19:44,970 --> 00:19:47,110
!ما الّذي تظهره أنت؟ قضيبك؟

224
00:19:51,280 --> 00:19:52,220
.أنا أراها

225
00:19:53,010 --> 00:19:54,120
.أراها

226
00:19:54,120 --> 00:19:55,370
!أراها جميعها

227
00:19:55,870 --> 00:19:58,530
.القذائف واضحة لي، كما لو كانت سلاحفًا بطيئة

228
00:19:58,530 --> 00:20:01,420
!سلحفاتك وقذائفك ومؤخّرتك واضحة أيضًا

229
00:20:02,700 --> 00:20:04,880
.لكن مذهل. إنّه سريع جدًّا

230
00:20:06,350 --> 00:20:07,840
.نقاط الحجب

231
00:20:12,370 --> 00:20:13,510
!لماذا؟

232
00:20:13,510 --> 00:20:15,440
!ماذا حدث يا كوندو-سان؟

233
00:20:15,440 --> 00:20:17,840
لا تقل لي أنّ الحقيقيّ
!كان بداخل نقاط الحجب

234
00:20:17,840 --> 00:20:19,770
!هل دست على قضيبك؟

235
00:20:23,520 --> 00:20:25,080
.ما باليد حيلة

236
00:20:25,080 --> 00:20:27,280
.اعتنوا بكوندو-سان

237
00:20:29,570 --> 00:20:31,600
!هيجيكاتا-سان! أوكيتا-سان

238
00:20:31,600 --> 00:20:34,490
...أردنا ادّخار هذا لنقطة تحوّل

239
00:20:34,490 --> 00:20:38,290
.لكن الآن لا خيار أمامنا سوى إطلاق قوانا نحن أيضًا

240
00:20:39,290 --> 00:20:40,730
...هل يعقل أنّكما

241
00:20:42,800 --> 00:20:46,140
.وصلنا إلى هذا لنحمي إيدو مجدّدًا

242
00:20:46,140 --> 00:20:49,570
!شاهدوا قوانا الجديدة

243
00:20:51,800 --> 00:20:54,300
...هـ-هذا

244
00:20:55,150 --> 00:20:56,640
!تبديد النّيكوتين

245
00:20:57,980 --> 00:20:59,310
.دعوني أشرح

246
00:20:59,310 --> 00:21:02,250
تبديد النّيكوتين الّذي يشمل الإقلاع
عن التّدخين لزيادة سعة الرّئة

247
00:21:02,250 --> 00:21:05,540
،ولجعل مذاق الطّعام أفضل
.هي قوّة هيجيكاتا الجديدة

248
00:21:05,540 --> 00:21:08,330
!كلّ ما فعلته أنّك بدأت تعتني بنفسك

249
00:21:09,680 --> 00:21:11,650
!انفجار المايونيز

250
00:21:13,010 --> 00:21:14,320
.دعوني أشرح

251
00:21:14,320 --> 00:21:18,510
انفجار المايونيز الّذي يشمل تضييع
المايونيز أمام هيجيكاتا

252
00:21:18,510 --> 00:21:21,700
الّذي يعيش فقط من أجل المايونيز
.هي قوّة أوكيتا الجديدة

253
00:21:21,700 --> 00:21:22,960
!هذا ليس شيئًا جديدًا

254
00:21:22,960 --> 00:21:26,130
!في الماضي والآن، كلّ ما فعلته هو أذيّة الرّجل

255
00:21:27,090 --> 00:21:29,150
!هذه هي قوّة الشّينسينغومي الجديدة

256
00:21:29,150 --> 00:21:30,910
!شاهدوا واندهشوا

257
00:21:32,300 --> 00:21:35,980
!مهلاً! لم يتغيّروا أبدًا

258
00:21:37,470 --> 00:21:39,440
.بل أصبحوا أسوأ

259
00:21:39,440 --> 00:21:41,350
.أمر طبيعيّ يا زعيم

260
00:21:42,590 --> 00:21:45,900
.النّاس لا يتغيّرون بتلك السّهولة

261
00:21:45,900 --> 00:21:47,190
...بمعنى آخر

262
00:21:53,370 --> 00:21:58,240
.رغبتنا في حماية إيدو لم تتغيّر أبدًا أيضًا

263
00:21:58,240 --> 00:22:02,060
من أنت؟ شخصيّة جديدة؟

264
00:22:02,060 --> 00:22:03,870
عمّاذا تتحدّث؟

265
00:22:04,970 --> 00:22:06,260
.هذا أنا، زاكياما

266
00:22:06,260 --> 00:22:08,880
!أنت شخص مختلف كلّيًّا الآن

267
00:23:41,610 --> 00:23:47,140
عدنا ورغبتنا وطموحنا لحماية
.إيدو لا تزالان قويّتين

268
00:23:47,140 --> 00:23:48,770
،نحن نفس الشّينسينغومي القدماء

269
00:23:49,190 --> 00:23:52,570
!لِمَ تطوّر وحده أكثر من إمكانيّاته؟

270
00:24:00,910 --> 00:24:05,910
،عادت شرطة المشاغبين

271
00:24:00,910 --> 00:24:05,910
لكن من يدري إن كانوا قد تطوّروا أو تراجعوا؟

272
00:24:05,910 --> 00:24:12,500
،بالمزيد من الأخطار تلوح في الأفق

273
00:24:05,910 --> 00:24:12,500
!يتحرّك الرّجل الذّهبيّ