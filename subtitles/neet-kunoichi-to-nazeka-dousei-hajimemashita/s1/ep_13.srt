1
00:00:00,000 --> 00:00:03,040
Rise-KuN & Lord_Sam0 :محاكاة

2
00:00:03,130 --> 00:00:06,000
سأتوقّف عن الانعزال

3
00:00:07,330 --> 00:00:09,400
لا داعي للقلق يا تسو-تشان

4
00:00:10,170 --> 00:00:11,990
سأبذل قصارى جهدي

5
00:01:17,790 --> 00:01:21,750
أكان البحث عن وظيفة صعبًا لهذه الدّرجة؟

6
00:01:22,170 --> 00:01:24,640
...هذا الرّفض الثّاني عشر

7
00:01:25,400 --> 00:01:28,710
أشعر وكأنّني عديمة الفائدة في هذا العالم

8
00:01:29,830 --> 00:01:34,000
أهذا كلّ ما أستطيع فعله بقدرتي على القتال؟

9
00:01:34,290 --> 00:01:37,990
نمط حياتي ثمين بالنسبة لي

10
00:01:42,170 --> 00:01:43,630
سأفعلها

11
00:01:47,580 --> 00:01:50,500
ليس هناك خيار يا تسو-تشان، أليس كذلك؟

12
00:01:51,540 --> 00:01:53,210
أأنتِ هنا من أجل مقابلة عمل؟

13
00:01:53,210 --> 00:01:56,630
سأذهب لإخبار المديرة، لذا انتظري هنا رجاءً

14
00:01:56,630 --> 00:01:58,080
حـ-حسنٌ

15
00:02:02,080 --> 00:02:04,960
لـ-لـ-لـ-لمَ أنتِ هنا؟

16
00:02:04,960 --> 00:02:07,100
أودُّ إعادة هذا السّؤال لكِ

17
00:02:07,630 --> 00:02:09,670
هذا لا يعنيكِ

18
00:02:11,330 --> 00:02:13,460
ألّا تكفي تعاويذ حاجز المرآة؟

19
00:02:13,580 --> 00:02:14,400
أجل

20
00:02:14,410 --> 00:02:19,500
فحواجز المرآة ضروريّة عند محاربة اليوما كما تعلمين

21
00:02:19,500 --> 00:02:26,670
وإن نفّذت التعاويذ اللّازمة لنشر الحاجز
فستواجه قرية ناتسومي أزمة تهدّد وجودها

22
00:02:26,790 --> 00:02:32,540
ولكنّنا بحاجة إلى نينجا ماهر
لصنع كميّة كبيرة من تعاويذ الحاجز

23
00:02:32,750 --> 00:02:35,900
...الوحيدة الّتي تستطيع فعلها على حدِّ علمي هي

24
00:02:38,920 --> 00:02:44,290
لا أعرف ما ستطلبه تلك الشّيطانة إن عقدت صفقة معها

25
00:02:44,500 --> 00:02:46,330
كـ-كانا-ساما؟

26
00:02:47,790 --> 00:02:49,880
أنتِ موهوبة

27
00:02:49,880 --> 00:02:51,960
حتّى أنّني أودُّ توظيفكِ رسميًا

28
00:02:52,250 --> 00:02:54,000
ربّما سأنجح في ذلك

29
00:02:54,460 --> 00:03:02,830
ليس الأمر وكأنّني سأطلب منها صنع تعاويذ حاجز المرآة
عوضًا عن أجري

30
00:03:03,170 --> 00:03:05,040
أفشيتِ عن كلّ شيء للتّو

31
00:03:06,500 --> 00:03:08,800
مرحبًا، أنا المديرة

32
00:03:09,150 --> 00:03:11,170
لنبدأ المقابلة إذن

33
00:03:11,540 --> 00:03:13,540
ماذا؟ أين المعلمة؟

34
00:03:13,830 --> 00:03:18,900
المالكة مشغولة للغاية، لذا عادةً تأتي إلى هنا مرّة واحدة في الشّهر

35
00:03:18,920 --> 00:03:21,790
هكذا إذن، لم أكن بحاجة للتّوتر

36
00:03:22,250 --> 00:03:23,900
لندخل صلْبَ الموضوع

37
00:03:23,900 --> 00:03:26,600
لمَ تريدين العمل لدينا يا شيزوري-سان؟

38
00:03:28,420 --> 00:03:32,500
حسنٌ، ظننت أنَّ الوقت حان للحصول على وظيفة

39
00:03:32,540 --> 00:03:37,500
حين عملت هنا سابقًا، كان الجميع متأنّقين للغاية

40
00:03:37,500 --> 00:03:40,750
لذا أظنّها وظيفة رائعة

41
00:03:41,040 --> 00:03:43,580
ما خطب هذه الكذبة الواضحة؟

42
00:03:43,580 --> 00:03:45,990
لم يُرِد أحد توظيفكِ على الأغلب، أليس كذلك؟

43
00:03:45,990 --> 00:03:47,130
اخرسي

44
00:03:48,250 --> 00:03:50,960
القتال هو كلّ ما تُجِيدِينه

45
00:03:50,960 --> 00:03:54,750
لم تحصلي على وظيفة بسبب عدم كفائتكِ في جمع المعلومات

46
00:03:55,000 --> 00:03:57,420
إنّهُ موقف لا يستحقّ حتّى السخرية منه

47
00:03:57,920 --> 00:04:00,000
ومع هذا أنتِ مرشّحة للزّعامة؟

48
00:04:00,010 --> 00:04:02,130
يبدو أن عشيرة إيدورا ليست عظيمة

49
00:04:03,130 --> 00:04:04,290
...أنتِ أيضًا يا كانا

50
00:04:05,280 --> 00:04:06,000
ماذا؟

51
00:04:06,290 --> 00:04:09,880
استمتعتِ بكونكِ خادمة رغم أنّكِ زعيمة، أليس كذلك؟

52
00:04:10,800 --> 00:04:12,670
عمَّ تتحدثين؟

53
00:04:12,670 --> 00:04:14,630
أأنتِ في وضع يسمح لكِ بالتحدث عن الآخرين؟

54
00:04:15,750 --> 00:04:20,400
...لا تجمعيني معكِ، فأنا أفعل هذا لإنقاذ قريتي من الأزمة

55
00:04:20,040 --> 00:04:23,420
لكنّكِ تحمستِ لتزيين عجة الأرز بالكاتشب، أليس كذلك؟

56
00:04:26,920 --> 00:04:28,880
واستمتعتِ بالتقاط الصور أيضًا

57
00:04:28,880 --> 00:04:29,460
...هذا

58
00:04:29,460 --> 00:04:31,460
تقمّصتِ دور التسوندري بمثاليّة

59
00:04:31,460 --> 00:04:32,120
-تسونـ

60
00:04:35,290 --> 00:04:35,960
لن أفعلها

61
00:04:37,960 --> 00:04:41,000
هناك الكثير من الماهرين في تقنيّات الحاجز

62
00:04:41,000 --> 00:04:45,620
وعلى عكسكِ، ما زال لديّ الكثير من الطرق الأخرى

63
00:04:46,000 --> 00:04:46,750
كانا؟

64
00:04:47,420 --> 00:04:53,080
ليس الأمر وكأنّني أودُّ العمل هنا على الإطلاق

65
00:04:53,080 --> 00:04:54,040
تمَّ تعيينكِ

66
00:04:54,540 --> 00:04:58,880
بصراحة، أخبرتني المالكة أنّها ستوظّفكما بالفعل

67
00:04:59,500 --> 00:05:02,540
وتمَّ أخذ حالة قرية كانا-سان بعين الاعتبار

68
00:05:06,170 --> 00:05:07,800
شكرًا لحضوركم

69
00:05:07,950 --> 00:05:09,660
سأرحّب بكم

70
00:05:09,900 --> 00:05:11,290
نين نين

71
00:05:13,290 --> 00:05:16,000
أخيرًا بدأت كانا-تشان بالعمل هنا رسميًا

72
00:05:16,000 --> 00:05:17,290
كنتُ أنتظركِ

73
00:05:17,540 --> 00:05:20,140
لـ-لم يكن أمامي خيار، لذا عُدت

74
00:05:20,140 --> 00:05:21,710
كونوا ممتنّين لي

75
00:05:23,210 --> 00:05:25,830
حسنٌ، لا بأس إن كانت كانا بخير مع هذا

76
00:05:26,460 --> 00:05:27,920
الأهمّ من ذلك

77
00:05:27,930 --> 00:05:29,920
يجب أن أتعامل مع مشاكلي

78
00:05:30,170 --> 00:05:32,600
...تمكّنت من الحصول على وظيفة بطريقة ما

79
00:05:32,900 --> 00:05:33,710
...والآن

80
00:05:36,580 --> 00:05:37,920
لقد عُدت

81
00:05:41,290 --> 00:05:42,500
مرحبًا بعودتك

82
00:05:42,670 --> 00:05:45,460
انتظر قليلًا، سأنتهي من التّنظيف الآن

83
00:05:47,360 --> 00:05:48,710
التّنظيف؟

84
00:05:48,720 --> 00:05:50,670
ألم تنتهي من يومكِ الأول في العمل للتّو؟

85
00:05:50,960 --> 00:05:54,580
أجل، ولكن أظنّ أنَّ الوقت حان لتولي الأعمال المنزليّة

86
00:05:55,130 --> 00:05:59,250
ولكن ملامح الإجهاد بادية على وجهكِ

87
00:05:59,250 --> 00:06:01,150
حـ-حقًّا؟

88
00:06:02,050 --> 00:06:04,090
أنا بخير

89
00:06:05,130 --> 00:06:06,580
حالتكِ غير مقنعة

90
00:06:11,170 --> 00:06:12,420
ما رأيك؟

91
00:06:12,710 --> 00:06:14,540
حسنٌ، إنّهُ لذيذ

92
00:06:14,790 --> 00:06:15,850
حقًّا؟

93
00:06:15,850 --> 00:06:17,100
هذا جيّد

94
00:06:17,110 --> 00:06:19,270
أشعر بالارتياح قليلًا

95
00:06:24,080 --> 00:06:26,750
ما رأيكِ بمغادرة هذه الشقّة يا شيزوري؟

96
00:06:28,540 --> 00:06:34,080
إن كان نمط حياتنا يزعج المالكة فما علينا سوى مغادرة هذا المكان فحسب

97
00:06:34,750 --> 00:06:37,100
-وحينها سنعيش كما اعتدنا

98
00:06:36,790 --> 00:06:37,710
لا يمكننا

99
00:06:40,290 --> 00:06:41,710
آسفة يا تسو-تشان

100
00:06:43,830 --> 00:06:46,290
لا يمكننا الاستمرار على نفس المنوال

101
00:06:48,080 --> 00:06:49,330
...شيزوري

102
00:06:50,580 --> 00:06:53,130
...لم أستطع إخبارك سابقًا، ولكن

103
00:06:53,130 --> 00:07:00,040
في الحقيقة واصلت نمط حياتي بالانعزال وإنقاذ المحاربين الضّالين منذ أن صرت نينجا هاربة

104
00:07:01,290 --> 00:07:04,400
معظم الضّالين لديهم دماء محاربين ضئيلة

105
00:07:04,400 --> 00:07:08,990
لذا ستتوقّف اليوما عن مهاجمتهم إن واصلت ذبحهم لمدّة شهر

106
00:07:09,540 --> 00:07:12,040
...وحينها أترك سيّدي

107
00:07:12,040 --> 00:07:17,880
وأذهب لحماية سيّدي التّالي مع استمرار نمط حياة الانعزال

108
00:07:18,170 --> 00:07:20,280
ولكن لا تسيء الفهم

109
00:07:20,290 --> 00:07:23,500
كانت تجمعني علاقة سيّد وخادم معهم فحسب

110
00:07:23,500 --> 00:07:25,540
إنّها مجرّد علاقة عمل

111
00:07:30,790 --> 00:07:33,540
ولكنّك مختلف يا تسو-تشان

112
00:07:33,920 --> 00:07:36,250
مرّت 6 أشهر بالفعل مُنذ أن بدأت حمايتك

113
00:07:36,420 --> 00:07:40,080
إلّا أن اليوما صاروا أقوى بدلًا من توقّفهم

114
00:07:42,460 --> 00:07:45,290
أنت لست مجرّد محارب ضّال يا تسو-تشان

115
00:07:46,790 --> 00:07:50,210
أظنّك تنسب سلالة عالية

116
00:07:51,500 --> 00:07:57,040
ولكنّني لن أستطيع التّعامل مع اليوما وحدي إن استمرّت قوّتهم بالنّمو

117
00:07:57,460 --> 00:08:00,710
كما أن اليوما عالي المستوى سيظهرون حتمًا

118
00:08:02,920 --> 00:08:07,180
أكره الاعتراف بذلك، ولكن معلمتي كانت محقّة

119
00:08:07,620 --> 00:08:09,580
ألستُ مثيرة للشفقة؟

120
00:08:09,580 --> 00:08:15,790
ولكن كيف سنهزم يوما لا تستطيعين التغلب عليه
رغم مستواكِ العالي يا شيزوري؟

121
00:08:16,170 --> 00:08:17,670
باستخدام قوّة السيّد

122
00:08:17,670 --> 00:08:19,330
قوّة السيّد؟

123
00:08:21,540 --> 00:08:26,500
...تدعى هذه القوّة بـ"تشيمياكوكو"، وهي تسمح لأحفاد المحاربين

124
00:08:26,790 --> 00:08:29,710
بالتحكّم في الطّاقة المتدفّقة من الأرض

125
00:08:30,880 --> 00:08:35,920
ممّا يُتِيح لهم منح الطّاقة للنينجا المتعاقدين معهم

126
00:08:36,040 --> 00:08:42,380
لتحسين قدراتهم الجسديّة وتقنيّاتهم وشفاء جراحهم بسرعة

127
00:08:47,420 --> 00:08:50,880
التحكّم في الطّاقة وتوجيه النينجا

128
00:08:51,130 --> 00:08:53,060
هو واجب المحارب

129
00:08:53,600 --> 00:08:54,900
...وهذا واجبي

130
00:08:57,460 --> 00:08:58,900
لا داعي للقلق

131
00:08:58,900 --> 00:09:02,080
لن أسمح لك بالتورط في المعارك أبدًا يا تسو-تشان

132
00:09:02,080 --> 00:09:03,460
شيـ-شيزوري؟

133
00:09:03,460 --> 00:09:10,880
سأصبح أقوى ثمَّ سأتوقّف عن استغلالك يا تسو-تشان

134
00:09:11,500 --> 00:09:13,920
وسأحميك بالطّبع

135
00:09:13,920 --> 00:09:19,820
لكنّني سأعمل وأطبخ وأنظّف وأغسل الملابس

136
00:09:19,820 --> 00:09:23,330
لذلك من الآن فصاعدًا سأبدأ في الاهتمام بكلّ ذلك

137
00:09:24,080 --> 00:09:27,670
إلى متى ستُلقين عدم فائدتكِ عليه؟

138
00:09:29,750 --> 00:09:32,100
لن أسمح لأحد أن يشتكي مني

139
00:09:32,100 --> 00:09:33,630
وسأغدو خاليةً من العيوب

140
00:09:33,630 --> 00:09:36,080
حتّى أحمي نمط حياتنا

141
00:09:36,460 --> 00:09:38,580
...حسنٌ، ولكن

142
00:09:38,580 --> 00:09:42,170
أولًا، سأعمل بجدّ خلال هذا الشّهر حتّى أحصل على راتبي

143
00:09:42,170 --> 00:09:46,080
وفي هذه الأثناء، ستكون مشاهدتك لي كافية يا تسو-تشان

144
00:09:46,710 --> 00:09:51,580
سأريك القوّة الحقيقيّة لشيزوري-ساما، الكونويتشي العبقرية

145
00:09:52,210 --> 00:09:53,420
...شيزوري

146
00:09:53,960 --> 00:09:57,630
،سيبرد حساء الميسو
لذا تناوله بسرعة

147
00:10:05,460 --> 00:10:08,250
ألستُ قادرًا على فعل أيّ شيء؟

148
00:10:09,380 --> 00:10:11,960
رغم أن شيزوري تبذل قصارى جهدها

149
00:10:23,080 --> 00:10:23,960
كلا

150
00:10:26,210 --> 00:10:28,200
الأمر لا يتعلّق بما لا أستطيع فعله

151
00:10:28,300 --> 00:10:29,710
بَلْ بما أودُّ فعله

152
00:10:39,710 --> 00:10:42,540
...من أودُّ حمايته

153
00:10:47,380 --> 00:10:49,040
...من أودُّ حقًّا

154
00:11:56,000 --> 00:12:01,000
رسم: كازوتومو إيشيتومو

155
00:12:11,420 --> 00:12:13,670
هذا هو عالم البشر إذن

156
00:12:14,790 --> 00:12:17,500
أظنّنا سنحظى ببعض المرح

157
00:13:19,960 --> 00:13:25,750
...انطلقت من منتصف المجموعة إلى المقدّمة لتنفيذ حركتها الخاصّة بمثاليّة

158
00:13:30,170 --> 00:13:32,920
ما الّذي تفعلينه؟

159
00:13:33,250 --> 00:13:34,500
الفتاة الكلبة

160
00:13:34,920 --> 00:13:37,330
هل تعنين الفتاة الكلبة من لعبة الهاتف؟

161
00:13:37,830 --> 00:13:43,540
،توقّفت عن اللّعب حتّى أترك نمط حياة الانعزال
ولكنّني بدأت أشعر بالتوتّر الشّديد

162
00:13:43,540 --> 00:13:46,580
لذا تخيّلت الفتاة الكلبة هكذا

163
00:13:46,790 --> 00:13:50,630
سأعيد تخيّل سباق الجائزة الكبرى المكوّن من 20 كلبة الآن

164
00:13:50,630 --> 00:13:56,600
،يتمّ عرض هذا المشهد في اللّعبة بمعدّل 60 إطارًا
وتتنافس فيه 20 كلبة بشراسة

165
00:13:56,600 --> 00:13:58,500
لكنّه ممتع للغاية

166
00:13:59,210 --> 00:14:01,880
هذه وسيلتي الوحيدة للرّاحة

167
00:14:05,380 --> 00:14:06,710
انتهت استراحتي

168
00:14:07,380 --> 00:14:09,500
التقنيّة العقليّة: تدمير الذّات

169
00:14:09,710 --> 00:14:12,790
تدمير الذّات أو بمعنى آخر نكران النفس

170
00:14:12,790 --> 00:14:17,580
إنّها تقنيّة تساعدها على التّخلي عن أفكارها الشخصيّة والتّركيز
على مهمّتها

171
00:14:19,830 --> 00:14:22,750
مرحبًا بعودتك، نين نين

172
00:14:23,210 --> 00:14:24,750
يا له من تحوّل مخيف

173
00:14:25,130 --> 00:14:29,000
في لعبة الفتاة الكلبة S صحيح، سمعت أنّهم سيضيفون شخصيّات نادرة من الفئة

174
00:14:29,000 --> 00:14:30,910
سأسحب بجنون للحصول عليهنّ

175
00:14:32,170 --> 00:14:34,400
مهلًا، توقفا عن ذلك

176
00:14:34,400 --> 00:14:36,670
فمثل هذه الأمور ستنتهي بخلافات بينكما

177
00:14:36,670 --> 00:14:39,040
ها قد أتت التسوندري كانا-تشان

178
00:14:48,960 --> 00:14:55,500
محال، لمَ ظهر يوما عالي المستوى هنا؟

179
00:14:57,790 --> 00:14:59,160
أخطأت مجدّدًا

180
00:14:59,170 --> 00:15:00,490
أهذه مزحة؟

181
00:15:00,500 --> 00:15:02,330
إنّهم ضعفاء للغاية

182
00:15:02,920 --> 00:15:04,830
إنّها أشبه بمهمّة قتل بضربة واحدة

183
00:15:07,080 --> 00:15:11,460
سأستمرّ في الصّيد والقتل حتّى ألتهم جميع أرواح المحاربين

184
00:15:11,460 --> 00:15:14,580
ثمَّ سأعيد ذلك العجوز اللّعين إلى رشده

185
00:15:14,880 --> 00:15:17,750
وكيرا فينتور من ستفعل ذلك

186
00:15:19,960 --> 00:15:22,380
اخرسي، أنتِ مزعجة

187
00:15:24,500 --> 00:15:27,660
ولكن الطعام هنا لذيذ للغاية

188
00:15:27,660 --> 00:15:29,330
أتريدين تناول بعضًا منه يا كيرارا-تشان؟

189
00:15:29,330 --> 00:15:31,130
أدعى كيرا وليس كيرارا

190
00:15:31,130 --> 00:15:34,420
أنا واثقة أنّكِ ستحبين وجبة الدجاج المقلي يا كيرارا-تشان

191
00:15:34,420 --> 00:15:36,790
أنتِ لا تستمعين لي على الإطلاق

192
00:15:37,040 --> 00:15:41,670
إنّهُ اسمك الحقيقي، كما أنَّ اسم كيرارا-تشان لطيف
لذا لا بأس بذلك

193
00:15:41,670 --> 00:15:44,580
وهذا ما يجعلني أكرهه

194
00:15:44,580 --> 00:15:47,040
فهمت

195
00:15:47,630 --> 00:15:50,020
ولكنّكِ بالغتِ في فعلها

196
00:15:50,020 --> 00:15:51,460
لا ينبغي أن تفعلي هذا

197
00:15:51,460 --> 00:15:55,460
فقد تسلّلنا إلى هنا دون علم أحد، لذا علينا أن نكون حذرتان

198
00:15:55,460 --> 00:15:56,330
اخرسي

199
00:15:56,460 --> 00:16:00,670
بالأحرى، حصل كلّ هذا بسبب معلوماتكِ الخاطئة يا كرينا

200
00:16:00,670 --> 00:16:02,200
...حسنٌ، حسنٌ

201
00:16:02,200 --> 00:16:03,920
لا داعي للغضب

202
00:16:03,920 --> 00:16:05,580
آكوما رويد

203
00:16:05,580 --> 00:16:10,630
،يتيح لك الوصول إلى ذاكرت اليوما منخفضة المستوى
كما توجد الكثير من الوظائف الأخرى فيه

204
00:16:10,630 --> 00:16:13,630
بالأحرى، إنّهُ هاتف ذكي إصدار اليوما

205
00:16:18,960 --> 00:16:21,130
إنّهُ ينسب إلى سلالة عالية، أليس كذلك؟

206
00:16:21,130 --> 00:16:22,830
أليس محارب ضّال؟

207
00:16:23,210 --> 00:16:24,830
وجدنا فريسة نادرة، أليس كذلك؟

208
00:16:24,830 --> 00:16:26,500
إنّها فرصتنا الكبرى

209
00:16:26,500 --> 00:16:29,580
لن أسمح له بالهرب مني

210
00:16:32,210 --> 00:16:34,080
لا يمكنك ذلك يا شيزوري-ساما

211
00:16:34,080 --> 00:16:35,460
أرفض قبولها

212
00:16:35,460 --> 00:16:41,710
عليكِ قبول تعويذتي، نظرًا لعدم تمكّنكِ من استخدام حاجز المرآة يا هينا

213
00:16:41,710 --> 00:16:42,960
لا أستطيع قبولها

214
00:16:42,960 --> 00:16:43,880
...لأن

215
00:16:45,170 --> 00:16:47,330
...تعابير وجهكِ يا شيزوري-ساما

216
00:16:48,630 --> 00:16:50,800
توضّح أنّكِ لستِ على ما يرام

217
00:16:50,800 --> 00:16:53,190
لذا عليكِ أخذ قسط من الراحة

218
00:16:53,190 --> 00:16:56,040
أنتِ كثيرة القلق يا هينا

219
00:16:56,240 --> 00:16:57,480
لا داعي للقلق

220
00:16:57,490 --> 00:17:01,580
فأنا أملك كتاب الفتاة الكلبة المصور الّذي صنعته

221
00:17:01,590 --> 00:17:03,790
إنّهُ ممتع بشكل غير متوقّع

222
00:17:03,790 --> 00:17:05,830
لمَ لا تجرّبين ذلك أيضًا يا هينا؟

223
00:17:08,290 --> 00:17:10,330
شيزوري-ساما

224
00:17:11,040 --> 00:17:14,130
هذا كافٍ، فقد بذلتِ قصارى جهدكِ يا شيزوري-ساما

225
00:17:14,130 --> 00:17:20,290
،لا داعي للقلق بشأن التعاويذ
سأبدأ العمل في مقهى نين نين مثل كانا-ساما

226
00:17:20,420 --> 00:17:22,380
...تـ-توقّفي

227
00:17:23,380 --> 00:17:24,380
شيزوري-ساما؟

228
00:17:24,890 --> 00:17:27,280
وصلت بالفعل إلى أقصى حدّي

229
00:17:27,290 --> 00:17:34,180
إن سقطتِ في دوامة سوء الحظ مرّة أخرى، فقد لا أستطيع الصمود

230
00:17:34,180 --> 00:17:35,540
شيزوري-ساما

231
00:17:35,710 --> 00:17:36,750
...الشخصيّة النّادرة

232
00:17:37,580 --> 00:17:41,330
حدث التقاط الشخصيّة النّادرة في لعبة الفتاة الكلبة على وشك الانتهاء

233
00:17:41,330 --> 00:17:44,080
كنت أودُّ الحصول على كلبة شيبا الذهبيّة

234
00:17:45,500 --> 00:17:49,290
رغم أنّني بذلت قصارى جهدي لأجل هذا اليوم

235
00:17:49,300 --> 00:17:52,040
حتّى أنّني واصلت التّوفير وحصلت جميع
المكافآت اليوميّة

236
00:17:52,210 --> 00:17:54,830
وادّخرت جميع جواهري

237
00:17:56,210 --> 00:17:59,460
ارتجفت هينا خوفًا من لاعبة الغاشا

238
00:18:00,790 --> 00:18:07,210
،لنلعب هذه اللّعبة
فعقلكِ لن يتحمّل إجبار نفسكِ على التّراجع

239
00:18:08,960 --> 00:18:12,330
وعدت تسو-تشان بالتوقّف عن الانعزال

240
00:18:12,330 --> 00:18:13,580
شيزوري-ساما

241
00:18:14,580 --> 00:18:16,580
سأبذل المزيد من الجهد

242
00:18:18,830 --> 00:18:20,090
اسمعي يا هينا

243
00:18:20,090 --> 00:18:21,990
حصلت على كلبة شيبا الذهبيّة أخيرًا

244
00:18:21,990 --> 00:18:23,290
ومن أول سحبة أيضًا

245
00:18:23,290 --> 00:18:24,380
تورو-كن

246
00:18:27,710 --> 00:18:33,500
لا تتحدّث عن كلبة شيبا الذهبيّة أمامي

247
00:18:30,420 --> 00:18:33,500
شيزوري-ساما

248
00:18:33,790 --> 00:18:34,990
من أول سحبة؟

249
00:18:35,000 --> 00:18:39,040
هل يستهزئ بي؟

250
00:18:40,460 --> 00:18:42,000
إنّهُ في هذه المدينة، أليس كذلك؟

251
00:18:42,380 --> 00:18:46,510
،غالبًا ما يظهر اليوما ذا المستوى المنخفض في هذه المنطقة

252
00:18:46,550 --> 00:18:47,580
لذا ينبغي أن يكون هنا

253
00:18:58,500 --> 00:18:59,960
رسالة من شيزوري-ساما؟

254
00:19:15,000 --> 00:19:17,580
سآتي إليكِ فورًا يا شيزوري-ساما

255
00:19:17,710 --> 00:19:22,000
سآتيكِ مُسرعًا بغضّ النّظر عن مدى سريّة مهمّتي

256
00:19:22,000 --> 00:19:25,830
حتّى وإن كنتُ في الجانب الآخر من الأرض طالما أمرتِني بذلك

257
00:19:26,040 --> 00:19:28,080
ولكن، ماذا حدث؟

258
00:19:28,500 --> 00:19:35,330
أيعقل أنّها اكتشفت صورة مؤخرتها المؤطّرة الّتي احتفظتُ بها؟

259
00:19:38,290 --> 00:19:45,130
أو ربّما علمت بأنّي أقضي كلّ ليلة في شمّ ملابس الخادمة الّتي كانت ترتديها

260
00:19:49,330 --> 00:19:51,040
...في كلتا الحالتين

261
00:19:51,040 --> 00:19:53,960
تنتظرني مكافأة عظيمة

262
00:19:55,210 --> 00:19:58,630
في البداية، لم أستطع تقبّل نمط حياة شيزوري-ساما الانعزالي

263
00:19:58,630 --> 00:20:02,740
إلّا أنّني صرت قادرًا على خدمتها وتلقّي عقابها أيضًا

264
00:20:02,750 --> 00:20:05,450
إنّها بمثابة نعمة من السّماء

265
00:20:06,960 --> 00:20:13,090
ماذا ستفعل بي إن كانت غاضبة لدرجة استدعائي مباشرة

266
00:20:13,100 --> 00:20:16,500
شيزوري-ساما

267
00:20:20,460 --> 00:20:22,880
شـ-شيزوري-ساما؟

268
00:20:24,460 --> 00:20:26,040
عيناها ميته

269
00:20:26,500 --> 00:20:30,290
دائمًا ما تتدفّق هالة فريدة منها بغضّ النّظر عن كسلها

270
00:20:30,290 --> 00:20:32,080
إلّا أنّني لا أشعر بأيّ شيء الآن

271
00:20:33,290 --> 00:20:35,290
أحقًّا هي شيزوري-ساما؟

272
00:20:35,790 --> 00:20:36,830
شيزوري-ساما

273
00:20:37,420 --> 00:20:39,080
آيامي

274
00:20:39,080 --> 00:20:40,880
لمَ أنتِ خاملة؟

275
00:20:40,880 --> 00:20:44,500
حسنٌ، مُنذ توقّفي عن اللّعب وأنا أشعر بالملل الشّديد

276
00:20:44,880 --> 00:20:47,170
لذا تأمّلت في الفراغ من شدّة الملل

277
00:20:47,330 --> 00:20:48,580
تتأمّلين في الفراغ؟

278
00:20:48,580 --> 00:20:53,040
،بالمناسبة، كنتِ المسؤولة عن الاستخبارات في القرية يا آيامي
أليس كذلك؟

279
00:20:53,290 --> 00:20:56,790
أيمكنكِ التخلّص منه حتّى لا أجده أبدًا؟

280
00:20:57,040 --> 00:21:01,380
فإشعارات الألعاب والإعلانات الجديدة تغريني

281
00:21:01,960 --> 00:21:05,460
هل تدركين ما قلتِه للتّو يا شيزوري-ساما؟

282
00:21:05,790 --> 00:21:09,290
...فمنح جهازكِ لشخص مرتبط بالقرية مثلي

283
00:21:09,450 --> 00:21:10,600
لا بأس

284
00:21:11,290 --> 00:21:14,960
فأنتِ تخفين مكان وجودي عن القرية يا آيامي، أليس كذلك؟

285
00:21:15,250 --> 00:21:16,580
علمتِ بذلك بالفعل؟

286
00:21:16,580 --> 00:21:19,040
وإلّا لكان المغتالون قد جاؤوا إليّ بالفعل

287
00:21:20,040 --> 00:21:25,920
،رغم انزعاجي من تصرّفاتكِ المنحرفة
إلّا أنّكِ تهرعين لنجدتي فور حدوث أيّ شيء

288
00:21:26,130 --> 00:21:29,790
وتطيعين طلباتي دائمًا

289
00:21:30,040 --> 00:21:36,380
حسنٌ، أعني أنّني أثق في ولائكِ على الأقل

290
00:21:43,040 --> 00:21:45,330
ماذا قالت لي للتّو؟

291
00:21:45,500 --> 00:21:46,490
أهذه حقيقة؟

292
00:21:46,500 --> 00:21:48,490
هل قالت شيزوري-ساما ذلك لي؟

293
00:21:48,500 --> 00:21:50,890
بدت وكأنّها تعترف بي

294
00:21:50,900 --> 00:21:53,690
ولكن هذا النوع من الأمور خارج نطاق اختصاصي

295
00:21:53,690 --> 00:21:55,170
عليّ الرد عليها

296
00:21:55,540 --> 00:21:56,750
-شيزوري-سا

297
00:21:58,920 --> 00:22:00,380
عادت لتأمّلها في الفراغ

298
00:22:09,880 --> 00:22:11,000
لقد عُدت

299
00:22:11,540 --> 00:22:14,130
،آسفة يا تسو-تشان
أنت جائع، أليس كذلك؟

300
00:22:14,130 --> 00:22:16,000
سأعد العشاء فورًا

301
00:22:22,250 --> 00:22:26,600
صحيح، أخبرني تسو-تشان أنّهُ سيعود متأخرًا اليوم

302
00:22:27,000 --> 00:22:29,580
إذن سأتناول أيّ شيء فحسب

303
00:22:34,630 --> 00:22:38,210
لم أعد أرى تسو-تشان على الإطلاق في الآونة الأخيرة

304
00:22:52,500 --> 00:22:55,210
وجدت فريستي

305
00:23:56,000 --> 00:24:01,040
رسم: ألديهيدي