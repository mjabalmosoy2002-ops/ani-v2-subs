اسمعي

189
00:11:32,500 --> 00:11:35,600
سأعود حتمًا وأوسعكِ ضربًا

190
00:11:35,600 --> 00:11:38,150
سأعود لتناول الدجاج المقلي، حسنٌ؟

191
00:11:38,150 --> 00:11:41,150
تذكري هذا يا إيدورا شيزوري

192
00:11:42,380 --> 00:11:43,630
...الحاجز

193
00:11:43,630 --> 00:11:45,890
يبدو أنّهما غادرتا فعلًا

194
00:11:45,960 --> 00:11:48,330
هل انتهى الأمر؟

195
00:11:50,170 --> 00:11:51,170
شيزوري-ساما

196
00:11:52,170 --> 00:11:53,290
شيزوري

197
00:11:56,000 --> 00:12:01,000
رسم: تاكوداي كاكوتشي

198
00:12:03,170 --> 00:12:05,710
هذه نتيجة تجاوز حدودها

199
00:12:06,790 --> 00:12:07,700
شيزوري

200
00:12:07,700 --> 00:12:08,580
...شيزوري-ساما

201
00:12:08,880 --> 00:12:12,130
حسنٌ، ستتعافى إن استراحت قليلًا

202
00:12:12,630 --> 00:12:13,880
هذا جيّد

203
00:12:13,880 --> 00:12:15,700
الأهمّ من ذلك

204
00:12:15,700 --> 00:12:16,790
أتسومي تسوكاسا

205
00:12:16,920 --> 00:12:21,080
كيف أتقنت قوّة السيّد في هذا الوقت القصير؟

206
00:12:21,250 --> 00:12:23,540
...حـ-حسنٌ

207
00:12:23,830 --> 00:12:25,330
...كـ-كانا-ساما

208
00:12:25,330 --> 00:12:27,500
...كيف فعلتها؟ هيّا أخبرني

209
00:12:27,500 --> 00:12:28,900
سأشرح لكِ ذلك

210
00:12:30,630 --> 00:12:34,460
كان ذلك من صنعكِ كما توقّعت يا هازوكي سايا

211
00:12:35,920 --> 00:12:37,250
تأخرت في شرح هذا

212
00:12:37,250 --> 00:12:38,580
ولكن قوّة السيّد

213
00:12:38,580 --> 00:12:40,500
تسمح له بالتّحكم في الطّاقة المتدفّقة

214
00:12:40,500 --> 00:12:42,600
لتقوية الشّينوبي

215
00:12:43,100 --> 00:12:47,200
ولا بدَّ من وجود بوّابة لتدفّق الطّاقة لاستخدام هذه القوّة

216
00:12:47,290 --> 00:12:49,050
"والّتي تدعى بـ"تشاكرا وريد التنين

217
00:12:49,050 --> 00:12:51,350
فات الأوان لتعلم الأساسيات بالفعل

218
00:12:51,790 --> 00:12:58,000
المشكلة هي أنَّ بوّابة تشاكرا وريد التنين
تتطلّب سنوات من التّدريب بغضّ النّظر عن سلالة المحارب

219
00:12:58,000 --> 00:13:00,800
ولا يمكن فتحها بين عشيّة وضُحاها

220
00:13:01,920 --> 00:13:05,700
وماذا لو وُجدت تقنيّة محرّمة لفتحها بالقوّة؟

221
00:13:06,880 --> 00:13:10,700
أجل، استخدمت تقنيّتي لتفعيلها قسرًا من ثقب أتسومي-كن

222
00:13:10,700 --> 00:13:11,540
نين نين

223
00:13:11,540 --> 00:13:12,880
...لا، صياغتكِ

224
00:13:14,290 --> 00:13:15,880
يا له من غش

225
00:13:16,290 --> 00:13:18,260
...هذا ما أودُّ قوله، لكن

226
00:13:18,400 --> 00:13:20,600
هناك ثمن تدفعه لقائه، أليس كذلك؟

227
00:13:20,600 --> 00:13:22,400
كما هو متوقع من زعيمة عشيرة ناتسومي

228
00:13:22,750 --> 00:13:26,500
ستختم تشاكرا المستخدم بالكامل مقابل ذلك

229
00:13:26,960 --> 00:13:31,900
ممّا يعني أنّني لم أَعُدْ أستطيع استخدام تقنيّات الشّينوبي

230
00:13:32,920 --> 00:13:37,150
ضحّيتِ بقوّتكِ من أجل شيزوري-ساما وتسوكاسا-سان؟

231
00:13:37,150 --> 00:13:38,900
لم أَعُدْ أفهم

232
00:13:38,900 --> 00:13:41,400
أَلَمْ تحاولي تفريقهما؟

233
00:13:41,500 --> 00:13:43,800
أتتذكر يا أتسومي-كن؟

234
00:13:44,960 --> 00:13:50,200
الوعد الّذي قطعناه في ذلك اليوم حِينَ طلبت مساعدتي

235
00:13:50,460 --> 00:13:53,800
سأحافظ على عقدي مع شيزوري بغضّ النّظر عمَّا يحدث

236
00:13:53,800 --> 00:13:55,800
كنتُ سأفعلها حتّى من دون الوعد

237
00:13:56,200 --> 00:13:58,300
هذا جيّد إذن

238
00:13:59,130 --> 00:14:02,800
اعتني بابنتي شيزوري رجاءً

239
00:14:04,920 --> 00:14:07,880
مـــــــــــــــــاذا

240
00:14:05,330 --> 00:14:07,880
أأنتِ أمها؟

241
00:14:08,960 --> 00:14:12,000
بعد إمعان النّظر، إنّهما متشابهتان إلى حدٍّ ما

242
00:14:12,500 --> 00:14:13,600
لمَ أخفيتِ الأمر؟

243
00:14:13,600 --> 00:14:15,640
فرقة أورابو الّتي كنتُ جزء منها

244
00:14:15,640 --> 00:14:19,510
هي قوّة إيدورا المظلمة والّتي كانوا يهابونها ويتجنّبونها حلفاؤها

245
00:14:20,040 --> 00:14:22,780
لذا، حِينَ رُشِحت شيزوري للزّعامة

246
00:14:22,780 --> 00:14:25,400
اضطررنا لقطع علاقتنا كأم وابنتها

247
00:14:25,580 --> 00:14:26,580
...محال

248
00:14:26,920 --> 00:14:30,100
...كان قرارًا قاسيًا بالنسبة لشيزوري الّتي ما زالت طفلة، ولكن

249
00:14:30,200 --> 00:14:34,780
استمرت علاقتنا كمعلّمة وتلميذة لاحقًا

250
00:14:36,460 --> 00:14:40,900
...إلّا أنّني لم أمنحها شيئًا أموميًا في الحقيقة إطلاقًا

251
00:14:45,630 --> 00:14:47,440
هذا جيّد

252
00:14:47,440 --> 00:14:50,140
حصولي على شيبا الذهبية لم يكن حلمًا

253
00:14:50,700 --> 00:14:51,490
تسو-تشان؟

254
00:14:51,500 --> 00:14:52,500
ماذا تفعلون جميعًا؟

255
00:14:52,500 --> 00:14:53,300
شيزوري

256
00:14:56,880 --> 00:14:58,700
أعتذر لكِ بحقّ

257
00:15:00,000 --> 00:15:01,960
لم تكن لدي أدنى فكرة

258
00:15:02,210 --> 00:15:04,700
كان ينبغي أن أثق بكما أكثر

259
00:15:04,750 --> 00:15:05,500
ماذا؟

260
00:15:05,500 --> 00:15:08,830
مـ-ما الّذي تتحدّثين عنه؟

261
00:15:08,830 --> 00:15:12,100
لم أقلْ إنّهُ خطأكِ ولم ألومكِ أيضًا

262
00:15:12,500 --> 00:15:15,580
...بالأحرى، أنا من يجب أن

263
00:15:16,830 --> 00:15:19,700
أنتما متشابهتان بحقّ

264
00:15:19,700 --> 00:15:21,500
كونا صريحتان

265
00:15:21,500 --> 00:15:22,290
بجديّة

266
00:15:22,750 --> 00:15:26,000
حسنٌ، تمَّ تسوية كلّ شيء بسلام

267
00:15:26,000 --> 00:15:28,290
الأهمّ من ذلك يا شيزوري-ساما وتسوكاسا-سان

268
00:15:28,290 --> 00:15:31,400
أهنّئكما مرّة أخرى على عقّدكما الحقيقيّ

269
00:15:32,040 --> 00:15:33,900
عقد حقيقي؟

270
00:15:40,920 --> 00:15:42,840
سنرحل الآن

271
00:15:42,840 --> 00:15:46,040
فلا ينبغي أن نقاطع متّعتكما المنتظرة

272
00:15:46,040 --> 00:15:47,920
على المتطفّلات الرّحيل

273
00:15:47,920 --> 00:15:49,040
يا للسّخافة

274
00:15:49,050 --> 00:15:49,600
سأرحل

275
00:15:49,600 --> 00:15:51,290
ما الّذي تتحدّثنَ عنه؟

276
00:15:51,420 --> 00:15:54,130
أنتِ تعلمين ما الّذي يلي التّقبيل، أليس كذلك؟

277
00:15:54,130 --> 00:15:55,540
لا ترغميني على قولها

278
00:15:55,540 --> 00:15:57,880
لـ-لـ-لـ-لن يحدث شيء بعد ذلك

279
00:15:57,880 --> 00:16:01,160
ستبقى الأمور على حالها حتّى لو أبرمنا عقدًا حقيقيًّا

280
00:16:01,160 --> 00:16:02,350
أليس كذلك يا تسو-تشان؟

281
00:16:02,350 --> 00:16:04,000
أ-أ-أجل

282
00:16:06,500 --> 00:16:08,800
أبذلي جهدكِ يا شيزوري-ساما

283
00:16:18,250 --> 00:16:20,960
أُغلقت القضيّة

284
00:16:21,130 --> 00:16:24,380
بالنسبة لذلك الشّخص الّذي تمَّ تجاهله

285
00:16:25,040 --> 00:16:31,790
كان يستنشق رائحة شيزوري المتبقّية ليستعيد طاقته ويعود أنثى مجدّدًا

286
00:16:34,580 --> 00:16:35,890
سأغادر الآن يا شيزوري

287
00:16:35,890 --> 00:16:37,290
تأكدي من أخذ قسط من الراحة

288
00:16:37,540 --> 00:16:38,960
حسنٌ، رفقتك السلامة

289
00:16:39,290 --> 00:16:41,210
صباح الخير يا أتسومي-سان

290
00:16:42,200 --> 00:16:43,830
صباح الخير يا أساكورا-سان

291
00:16:44,040 --> 00:16:46,380
ما خطب الأخت؟

292
00:16:46,380 --> 00:16:48,240
صحتها متدهورة قليلًا

293
00:16:48,500 --> 00:16:51,210
لذا أخطّط للعودة مبكّرًا اليوم

294
00:16:51,210 --> 00:16:52,710
هذا جيّد إذن

295
00:16:53,920 --> 00:16:56,750
أَهُوَ حدث رعاية زميلة سّكن؟

296
00:16:56,750 --> 00:16:58,480
حيثُ يُطعمها عصيدة الأرز المُعَدَّة يدويًا

297
00:16:58,480 --> 00:17:01,300
ويمسح ظهرها المثير بمنشفة

298
00:17:01,580 --> 00:17:05,080
رغم إنّنا لم نرها مؤخرًا، إلّا أنَّ هيماري ما زالت كما هي

299
00:17:07,080 --> 00:17:08,300
قادمة

300
00:17:09,920 --> 00:17:11,710
لمَ أتيت اليوم؟

301
00:17:11,710 --> 00:17:15,500
أردتُ شكركِ بشكل صحيح بعد أن تمَّت تسوية كلّ شيء

302
00:17:15,790 --> 00:17:18,210
...إن كنت تعني موضوع قوّة السيّد، فلا داعٍ

303
00:17:18,210 --> 00:17:21,330
سَبَقَ وساعدتِنا في الماضي، أليس كذلك؟

304
00:17:23,250 --> 00:17:26,460
بما أنَّ التشاكرا قد خُتمت فستختفي التقنيّة بالطّبع

305
00:17:26,830 --> 00:17:31,540
اعذرني يا أتسومي-كن، فقد بحثتُ عن خلفيتك

306
00:17:31,540 --> 00:17:34,210
أظنّه أمر طبيعي

307
00:17:34,960 --> 00:17:37,250
فقدت والديك حين كنت طفلًا

308
00:17:37,960 --> 00:17:42,300
ثمَّ تمَّ تبنّيك من قبل عائلة ليس لها صلة بسلالة المحاربين

309
00:17:42,330 --> 00:17:45,500
علاقتكم العائلية كانت جيدة ظاهريًّا

310
00:17:45,710 --> 00:17:49,080
بصراحة، عاملني والداي بالتبنّي وكأنّني ابنهما

311
00:17:49,500 --> 00:17:51,330
ولكن منذُ صغري

312
00:17:51,330 --> 00:17:55,200
كنتُ عرضة للحوادث والأمراض، ولم أكن أودُّ أن أكون عبئًا عليهما

313
00:17:55,250 --> 00:17:57,920
ربّما تأثرت باليوما منخفض المستوى

314
00:17:58,210 --> 00:18:01,400
ممّا جعلك تبتعد عن الآخرين تدريجيًّا

315
00:18:01,630 --> 00:18:06,210
كان الأمر أشبه بعدم وجود ارتباطات وقيم مشتركة بيني وبين الآخرين

316
00:18:06,210 --> 00:18:08,960
لذا، كان ذلك اليوم مجرّد صدفة

317
00:18:09,750 --> 00:18:10,330
ليبدأ القتال

318
00:18:14,630 --> 00:18:16,210
تهانينا على فوزك

319
00:18:16,420 --> 00:18:19,000
شاركت في بطولة قتالية لمجرّد نزوة

320
00:18:19,000 --> 00:18:21,080
...ومن ظهر أمامي بعد فوزي

321
00:18:21,080 --> 00:18:22,920
أنت مذهل أيّها الأخ

322
00:18:25,880 --> 00:18:27,330
مذهل للغاية

323
00:18:28,540 --> 00:18:30,430
إنّها المرّة الأولى الّتي أرى فيها لعبة

324
00:18:30,430 --> 00:18:33,250
وكانت أصوات "بانج"، "باو"، "بوم" رائعة للغاية

325
00:18:33,250 --> 00:18:34,890
أأنت محترف أيّها الأخ؟

326
00:18:34,890 --> 00:18:36,130
أيمكنني لعبها أيضًا؟

327
00:18:36,130 --> 00:18:40,500
حـ-حسنٌ، أتريدين تجربتها؟

328
00:18:40,500 --> 00:18:41,380
ألّا تمانع ذلك؟

329
00:18:41,380 --> 00:18:42,330
مرحى

330
00:18:42,330 --> 00:18:43,920
شكرًا لك أيّها الأخ

331
00:18:45,170 --> 00:18:45,830
شيزوري

332
00:18:45,830 --> 00:18:46,420
ماذا؟

333
00:18:47,040 --> 00:18:48,420
أدعى شيزوري

334
00:18:48,700 --> 00:18:50,210
إيديورا شيزوري

335
00:18:51,080 --> 00:18:57,710
ساعدت شيزوري بعد أن تأذّت وهربت من القرية
إثر انتهاء علاقتنا كأم وابنتها، أليس كذلك؟

336
00:18:58,420 --> 00:19:01,860
لا، هي من ساعدتني

337
00:19:01,860 --> 00:19:03,600
...أيّها... توقّف

338
00:19:05,000 --> 00:19:06,500
لا أستطيع الفوز أبدًا

339
00:19:06,500 --> 00:19:08,170
أرني كيف أفعلها

340
00:19:10,400 --> 00:19:11,890
مئة ضربة على التّوالي

341
00:19:11,890 --> 00:19:12,500
مذهل

342
00:19:12,500 --> 00:19:14,600
كما هو متوقع من محترف، أنت رائع

343
00:19:14,600 --> 00:19:15,710
أرني المزيد

344
00:19:18,710 --> 00:19:20,080
أيّها الأخ؟

345
00:19:21,790 --> 00:19:22,630
ما الخطب؟

346
00:19:22,630 --> 00:19:23,920
هل تتألم؟

347
00:19:24,290 --> 00:19:26,080
أأنت بخير أيّها الأخ؟

348
00:19:26,630 --> 00:19:27,790
لا أعرف

349
00:19:28,040 --> 00:19:31,170
حدث ذلك فجأة حين رأيتكِ تستمتعين

350
00:19:32,790 --> 00:19:33,990
أتساءل لمَ؟

351
00:19:34,130 --> 00:19:35,300
حسمتُ قراري

352
00:19:36,420 --> 00:19:39,080
سأتّخذك سيّدًا لي أيّها الأخ

353
00:19:39,080 --> 00:19:41,290
ماذا؟ سيّدكِ؟

354
00:19:41,670 --> 00:19:44,300
سأحميك حتّى لا تبكي

355
00:19:44,400 --> 00:19:47,250
فأنا من نخبة الكونويتشي في قرية إيدورا

356
00:19:48,830 --> 00:19:50,500
لا أفهم ما تعنين

357
00:19:50,600 --> 00:19:51,460
ولكن شكرًا لكِ

358
00:19:59,330 --> 00:20:00,450
إنّهُ يوما

359
00:20:00,450 --> 00:20:01,540
تراجع أيّها الأخ

360
00:20:02,000 --> 00:20:02,830
شيزوري-تشان

361
00:20:04,830 --> 00:20:06,460
ما هذا بالضّبط؟

362
00:20:08,830 --> 00:20:09,710
ما رأيك؟

363
00:20:13,630 --> 00:20:14,880
شيزوري-تشان

364
00:20:44,460 --> 00:20:45,500
من أنتِ؟

365
00:20:51,330 --> 00:20:52,400
آسفة

366
00:20:58,600 --> 00:21:00,710
...أظنّني كنت

367
00:21:03,000 --> 00:21:04,420
ماذا كنت أفعل؟

368
00:21:04,420 --> 00:21:05,880
كما كان الحال آنذاك

369
00:21:05,880 --> 00:21:10,290
...الفتاة الّتي تحميني وتستمتع بقضاء وقتها معي بحقّ

370
00:21:11,380 --> 00:21:13,790
...هي أفضل شينوبي بالنسبة لي

371
00:21:14,210 --> 00:21:17,500
ظننتك محاربًا ضالًا آنذاك

372
00:21:17,630 --> 00:21:20,830
فخشيت أن تتّخذك شيزوري غير النّاضجة سيّدًا لها

373
00:21:20,830 --> 00:21:23,040
لذا ختمت تلك الذكرى

374
00:21:24,250 --> 00:21:26,630
ولكن لم يكن هناك داعٍ لإلقاء تقنيّتي

375
00:21:26,630 --> 00:21:30,390
لأنّها نستك بسبب الضّرر النّاجم من المعركة بالفعل

376
00:21:30,390 --> 00:21:34,780
ولكنّها صارت أكثر التزامًا بتدريبها

377
00:21:34,790 --> 00:21:38,460
وكأنَّ لديها سيّدًا تخدمه بالفعل

378
00:21:39,000 --> 00:21:41,890
ولكنّها لم تنسَ الألعاب

379
00:21:41,890 --> 00:21:44,800
ربّما هوسها بالألعاب أعمق من تعلُّقها بك

380
00:21:45,830 --> 00:21:48,700
لكنّني أظنّه الخيار المناسب آنذاك

381
00:21:49,460 --> 00:21:51,900
إلّا أن الأمر مختلف الآن

382
00:21:52,210 --> 00:21:54,550
هل ستخبر شيزوري بهذا؟

383
00:21:55,750 --> 00:22:00,750
أن تكون شيزوري آنذاك جزء من شيزوري الحالية يكفيني

384
00:22:01,830 --> 00:22:02,750
فهمت

385
00:22:03,330 --> 00:22:04,600
تصبح على خير

386
00:22:04,600 --> 00:22:06,940
إن كان لديك شيء لا تودّ إخبارها به

387
00:22:06,940 --> 00:22:08,040
تعال وأخبرني

388
00:22:08,040 --> 00:22:09,090
حسنٌ

389
00:22:09,100 --> 00:22:10,890
سأعتذر عن إزعاجكِ حينها

390
00:22:10,890 --> 00:22:11,800
حسنٌ إذن

391
00:22:15,540 --> 00:22:17,170
إنّهُ ليس حبًّا

392
00:22:17,170 --> 00:22:19,580
إن سألت هيماري عن سبب وجودها هنا

393
00:22:19,580 --> 00:22:22,290
"فستقول: "ما باليد حيلة بما أنّك هنا

394
00:22:25,500 --> 00:22:28,080
الأمر ليس كما يبدو، فقد استرحت بالفعل

395
00:22:28,080 --> 00:22:30,000
لكنّني تعافيت تمامًا

396
00:22:30,000 --> 00:22:33,540
...وبما أن الاستلقاء فقط كان مملًا، نويتُ اللّعب لمدّة خمس دقائق

397
00:22:33,710 --> 00:22:35,040
لقد عُدت يا شيزوري

398
00:22:36,830 --> 00:22:38,630
مرحبًا بعودتك يا تسو-تشان

399
00:22:39,130 --> 00:22:41,000
سأنضم لكِ بما أنّكِ بدأتِ بالفعل

400
00:22:41,000 --> 00:22:42,000
حقًّا؟

401
00:22:42,000 --> 00:22:43,380
أجل، لنفعلها

402
00:22:45,960 --> 00:22:48,730
تبدو وكأنّها الحلقة الأخيرة

403
00:22:48,730 --> 00:22:51,250
إلّا أن القصة ستستمر قليلًا

404
00:23:56,040 --> 00:24:01,080
رسم: بونكارا