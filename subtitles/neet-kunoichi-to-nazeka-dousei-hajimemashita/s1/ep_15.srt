196
00:12:21,500 --> 00:12:22,500
سأقتلكِ

197
00:12:23,250 --> 00:12:26,580
سأحرص على قتلكِ مهما كلّف الثّمن

198
00:13:28,630 --> 00:13:32,630
لم يسبق أن استهزأ بي أحدٌ إلى هذه الدّرجة

199
00:13:32,710 --> 00:13:35,630
لا تمانعين إن قطعتها يا كيرنا، أليس كذلك؟

200
00:13:35,790 --> 00:13:38,800
إنّها المرّة الأولى الّتي أرى فيها خادمة

201
00:13:38,800 --> 00:13:40,250
أنتِ ظريفة

202
00:13:40,290 --> 00:13:41,540
حـ-حقًّا؟

203
00:13:41,750 --> 00:13:45,210
حسنٌ، فأنا المبتدئة الأعلى تصنيفًا بعد كلّ شيء

204
00:13:45,210 --> 00:13:46,670
مذهلة

205
00:13:47,210 --> 00:13:49,400
ما الّذي تفعلينه يا كيرنا؟

206
00:13:50,080 --> 00:13:51,750
ساعديني يا كانا-تشان

207
00:13:52,380 --> 00:13:55,710
اتركِ الأمر لزعيمة قرية ناتسومي

208
00:13:55,880 --> 00:13:57,380
ماذا؟ أين هذه القرية؟

209
00:13:57,460 --> 00:14:02,250
ماذا؟ إنّها القرية الّتي ستعتلي قمّة القرى الثلاث الكبرى يومًا ما

210
00:14:02,250 --> 00:14:03,830
بالأحرى، أتسومي تسوكاسا

211
00:14:03,830 --> 00:14:04,500
نعم؟

212
00:14:03,830 --> 00:14:05,880
تعالي يا كيرنا

213
00:14:05,080 --> 00:14:08,540
لا أعرف كيف تمكّنت من استخدام قوّة السيّد

214
00:14:05,880 --> 00:14:07,710
لا

215
00:14:08,790 --> 00:14:10,830
ولكن عالج شيزوري حالًا

216
00:14:11,040 --> 00:14:12,710
ولكن كيف أعالجها؟

217
00:14:12,710 --> 00:14:15,250
عليك وضع يدك على جراحها

218
00:14:15,710 --> 00:14:17,130
هكذا؟

219
00:14:19,830 --> 00:14:21,210
إنّها تعمل فعلًا

220
00:14:22,210 --> 00:14:23,940
سأوفّر لك بعض الوقت

221
00:14:23,940 --> 00:14:26,330
ومن خلاله ابتعد عن هنا وعالجها

222
00:14:26,330 --> 00:14:29,420
إنّهما ليستا يوما عادّيتين يا كانا

223
00:14:29,630 --> 00:14:31,710
خذي تسو-تشان واهربا من هنا

224
00:14:32,960 --> 00:14:34,200
أرفض طلبكِ

225
00:14:34,400 --> 00:14:37,630
لا يجوز لزعيمة عشيرة ناتسومي أن تهرّب

226
00:14:38,420 --> 00:14:40,670
يبدو أنّكِ قادرة على صنع ملامح جادّة

227
00:14:40,670 --> 00:14:42,830
أتريدين الموت يا كانا؟

228
00:14:44,000 --> 00:14:45,750
بالطّبع لا

229
00:14:45,750 --> 00:14:47,710
فلن أقاتل وحدي

230
00:14:50,710 --> 00:14:51,400
هينا؟

231
00:14:51,400 --> 00:14:52,790
محال، أأنتِ هنا أيضًا؟

232
00:14:53,380 --> 00:14:57,000
لطالما ساعدتني يا شيزوري-ساما

233
00:14:58,750 --> 00:15:01,150
لذا، حان دوري لِأَرُدّ جميلكِ

234
00:15:02,170 --> 00:15:03,800
-تكاثر الضعفاء لن يشـ

235
00:15:03,800 --> 00:15:05,600
سأقدّم المساعدة أيضًا

236
00:15:06,540 --> 00:15:07,720
...هذا الصوت

237
00:15:08,140 --> 00:15:09,250
آيامي؟

238
00:15:15,750 --> 00:15:20,050
سأعيد لكِ هذا يا شيزوري-ساما

239
00:15:20,630 --> 00:15:23,330
...إنّهُ هاتفي

240
00:15:23,580 --> 00:15:28,920
جمعت أغلب الجواهر المجانيّة في التطبيق المسمى بالفتاة الكلبة

241
00:15:28,920 --> 00:15:30,300
حين تنتهي المعركة

242
00:15:30,300 --> 00:15:32,650
أنفقيها على الغاشا حتّى تشعري بالرّضا

243
00:15:32,710 --> 00:15:34,200
لمَ فعلتِ كلّ هذا؟

244
00:15:34,790 --> 00:15:36,640
باعتباري أحد أتباعكِ

245
00:15:36,850 --> 00:15:40,400
فأنا آيامي مستعدّة للتّضحية بحياتي لحمايتكِ

246
00:15:44,380 --> 00:15:47,240
المعذرة، شيزوري-ساما؟

247
00:15:47,240 --> 00:15:49,540
ماذا عن عزيمتي؟

248
00:15:49,830 --> 00:15:51,500
شكرًا لكِ يا آيامي

249
00:15:52,880 --> 00:15:53,750
على الرُّحب

250
00:15:54,400 --> 00:15:57,690
حين رأت آيامي ابتسامة شيزوري المشرقة

251
00:15:57,690 --> 00:16:00,000
لم تعد تهتمّ بعد الآن

252
00:16:00,290 --> 00:16:02,080
مهلًا، جميعًا

253
00:16:03,290 --> 00:16:06,420
عليكنَّ أن تَكُنَّ جادّات الآن

254
00:16:07,790 --> 00:16:08,920
هيّا بسرعة

255
00:16:09,080 --> 00:16:10,540
آ-آسف

256
00:16:13,290 --> 00:16:14,440
...هينا

257
00:16:15,200 --> 00:16:16,240
...آيامي

258
00:16:17,200 --> 00:16:18,400
كانا

259
00:16:19,080 --> 00:16:23,040
سأكون المسؤولة هنا
كوني زعيمة عشيرة

260
00:16:23,040 --> 00:16:24,330
حـ-حسنٌ

261
00:16:24,330 --> 00:16:25,750
ما باليد حيلة

262
00:16:26,080 --> 00:16:28,420
هيّا بنا يا فريق كانا

263
00:16:29,250 --> 00:16:31,800
أرني تلك المهزلة مجدّدًا

264
00:16:31,800 --> 00:16:34,380
وسأقتلكِ حينها فورًا

265
00:16:37,420 --> 00:16:39,300
سنتولّى أنا وآيامي الطّليعة

266
00:16:39,300 --> 00:16:42,200
ادعمينا بتقنيّاتكِ من الخلف يا هينا

267
00:16:43,350 --> 00:16:45,750
مهلًا، أهذه تقنيّة المستوى الأساسيّ؟

268
00:16:45,750 --> 00:16:48,990
أأتيتِ إلى هنا وأنتِ لم تتّقني التقنيّات المتوسطة بعد؟

269
00:16:49,330 --> 00:16:51,460
أجل، لم أتقن التقنيّات المتوسطة بعد

270
00:16:51,790 --> 00:16:56,040
ولكنّني سأثبت لكِ أنّني لم آتِ إلى هنا للعبث

271
00:16:57,710 --> 00:16:58,790
تراجعي يا كيرا

272
00:17:02,580 --> 00:17:04,250
أهذا المستوى الأساسيّ؟

273
00:17:06,960 --> 00:17:09,450
ما هو المستوى الأساسيّ بالضّبط؟

274
00:17:09,450 --> 00:17:12,250
أكانت هينا تتمتّع بهذا النّوع من الإمكانات؟

275
00:17:12,460 --> 00:17:15,330
بالأحرى، هذا النّوع من القوّة يفوق قدراتي

276
00:17:17,460 --> 00:17:19,420
أكان ساخنًا؟

277
00:17:19,960 --> 00:17:22,400
آسفة، حاولت كبح نفسي

278
00:17:22,800 --> 00:17:23,800
كبحتِ نفسكِ؟

279
00:17:23,880 --> 00:17:25,630
اسمعي يا هينا

280
00:17:26,250 --> 00:17:31,040
هَلَّا ضربتني بواحدة كبيرة كهذه؟

281
00:17:31,540 --> 00:17:32,170
ماذا؟

282
00:17:34,330 --> 00:17:37,450
سأحاول جذب إحدهما لي

283
00:17:38,960 --> 00:17:41,330
ثمَّ أريدكِ أنّ تضربينا بها

284
00:17:41,460 --> 00:17:43,380
هذه خطتكِ إذن

285
00:17:43,460 --> 00:17:45,580
...مهلًا، إن أصابتكِ

286
00:17:45,710 --> 00:17:48,000
لن تخرجي سالمة إنّ أصابتكِ يا آيامي-سان

287
00:17:48,000 --> 00:17:48,880
...أنا

288
00:17:49,040 --> 00:17:50,400
لا أهتمّ

289
00:17:50,400 --> 00:17:52,460
هاجميني وكأنّكِ تنوين القضاء عليّ

290
00:17:52,580 --> 00:17:54,540
لمَ التمادي إلى هذا الحد

291
00:17:54,750 --> 00:17:56,920
المخاطرة بحياتي لحماية سيّدتي من الخطر

292
00:17:58,290 --> 00:18:01,000
هو واجبي كتابعة مخلصة

293
00:18:01,420 --> 00:18:02,380
لستِ سيئة

294
00:18:05,040 --> 00:18:06,630
...تلك الهجمة الضّخمة

295
00:18:06,960 --> 00:18:09,500
بالطّبع، أراد تلقّي الهجوم فحسب

296
00:18:10,750 --> 00:18:12,800
ها أنا قادم يا أيّتها اليوما عالية المستوى

297
00:18:14,330 --> 00:18:15,790
سأتركها لكِ يا كيرنا

298
00:18:15,790 --> 00:18:17,710
أنت لستِ عادلة

299
00:18:18,000 --> 00:18:22,200
...سأتلقّى هجمة ضخمة

300
00:18:22,750 --> 00:18:24,080
لا

301
00:18:24,290 --> 00:18:26,400
سأتلقّى هجمة ضخمة

302
00:18:26,400 --> 00:18:29,080
ابتعدي

303
00:18:29,660 --> 00:18:30,550
سحقًا

304
00:18:30,550 --> 00:18:33,880
أجميع الكونويتشي مجنونات؟

305
00:18:38,710 --> 00:18:40,790
أعتذر عن تأخّري عليكِ

306
00:18:41,000 --> 00:18:44,500
سأحرص على ألَّا تنسي اسم ناتسومي طوال حياتكِ

307
00:18:46,460 --> 00:18:48,170
أرني ما لديكِ

308
00:18:48,170 --> 00:18:51,580
أسرعي باتّباع تعليمات آيامي يا هينا

309
00:18:51,830 --> 00:18:53,920
...ولكن يا كانا-سان

310
00:18:53,920 --> 00:18:55,960
أتريدين إهدار عزيمتها؟

311
00:18:56,960 --> 00:19:00,920
صحيح، تفعل آيامي-سان هذا من أجل شيزوري-ساما

312
00:19:05,040 --> 00:19:07,250
إنّها مخيفة

313
00:19:07,250 --> 00:19:09,700
ما خطبكِ أيّتها اليوما عالية المستوى؟

314
00:19:09,750 --> 00:19:11,700
الجدار خلفكِ

315
00:19:11,700 --> 00:19:13,950
لم يعد بإمكانكِ الهرب

316
00:19:18,250 --> 00:19:19,170
آيامي-سان

317
00:19:19,170 --> 00:19:20,130
افعليها يا هينا

318
00:19:20,130 --> 00:19:20,670
حسنٌ

319
00:19:21,080 --> 00:19:22,250
لا

320
00:19:22,670 --> 00:19:23,380
ماذا؟

321
00:19:24,580 --> 00:19:26,380
تلقّي الهجوم أيّتها اليوما عالية المستوى

322
00:19:26,750 --> 00:19:29,200
إنّهُ هجوم عزيمة موموتشي آيامي

323
00:19:29,200 --> 00:19:32,710
تابعة شيزوري-ساما المخلصة

324
00:19:43,200 --> 00:19:45,380
هذا مذهل

325
00:19:55,040 --> 00:19:56,130
آيامي-سان

326
00:19:56,330 --> 00:19:59,460
تقنيتكِ مذهلة بحقّ

327
00:20:00,330 --> 00:20:03,960
حتّى أنّكِ جعلتني أستخدم أقوى حاجز لدي

328
00:20:03,960 --> 00:20:05,330
محال

329
00:20:06,210 --> 00:20:10,170
ولكن جهود المخيفة تلك ضاعت هباءً

330
00:20:10,710 --> 00:20:14,200
على أيّ حال، ستشكل قوتكِ النارية خطرًا

331
00:20:14,200 --> 00:20:15,800
لذا سأقضي عليكِ فورًا

332
00:20:15,800 --> 00:20:17,460
وداعًا

333
00:20:22,460 --> 00:20:23,300
كيرنا

334
00:20:23,300 --> 00:20:25,250
أهذا الحضور لآيامي؟

335
00:20:25,830 --> 00:20:27,280
آيامي-سان

336
00:20:27,280 --> 00:20:28,360
هذا جيّد

337
00:20:29,000 --> 00:20:30,580
كنتِ بخير إذن

338
00:20:30,580 --> 00:20:32,130
آيامي-سان؟

339
00:20:32,830 --> 00:20:37,460
أشكركِ على ثقتكِ بي ومهاجمتي بكلّ قوّتكِ يا هينا

340
00:20:37,750 --> 00:20:41,490
اتركِ الباقي لي، واذهبي لدعم زعيمة عشيرة ناتسومي

341
00:20:41,490 --> 00:20:43,290
آ-آيامي-سان

342
00:20:44,820 --> 00:20:47,040
يا لقوّتها الوحشيّة

343
00:20:49,580 --> 00:20:54,380
أنتِ لستِ مجرّد منحرفة عادية
بما أنّكِ قذفتني إلى هذا المدى

344
00:20:56,710 --> 00:21:00,800
أنتِ مسترخية تمامًا، ألم تلاحظي ذلك بعد؟

345
00:21:01,000 --> 00:21:02,630
...تلك المهزلة قبل قليل

346
00:21:02,630 --> 00:21:03,630
انحرفت قليلًا

347
00:21:03,630 --> 00:21:06,380
تعمّدتُ فعلها

348
00:21:06,380 --> 00:21:08,000
...أجل، كله لأجل

349
00:21:09,790 --> 00:21:12,300
كشف كلّ ما في جعبتي

350
00:21:12,670 --> 00:21:13,840
موموتشي إيلم

351
00:21:13,840 --> 00:21:15,680
تفعيل الوضع الذكوريّ

352
00:21:18,750 --> 00:21:24,420
مهلًا، أأنت ر-ر-رجل؟

353
00:21:24,420 --> 00:21:27,750
يبدو أنَّ الوضع الذكوريّ قد كُشِف بالفعل

354
00:21:27,960 --> 00:21:31,000
تقنيّة التّأنيث هي مهارة موموتشي آيامي

355
00:21:31,000 --> 00:21:35,410
أو بالأحرى، إنّها تقنيّة فريدة اخترعها إيلم

356
00:21:35,880 --> 00:21:40,460
تبقيه التقنيّة في الوضع الأنثويّ طالما يمتلك الطّاقة الكافية

357
00:21:40,460 --> 00:21:45,960
ولكن تسبّب التقنيّة تأثيرًا سلبيًّا يستنزف طاقته باستمرار أثناء تفعيلها

358
00:21:47,420 --> 00:21:51,200
الشرط الوحيد لإبطال هذه التقنيّة

359
00:21:51,200 --> 00:21:54,080
هو تلقّي قدر معيّن من الضّرر

360
00:21:57,290 --> 00:22:01,300
سيتوقّف التّأثير السلبيّ بمجرّد توقّف التقنيّة

361
00:22:01,300 --> 00:22:04,790
ممّا يجعل قوّة إيلم الذكوريّ مساوية لنينجا عالي المستوى

362
00:22:04,790 --> 00:22:09,300
ولكن بالنسبة لإيلم، الّذي يرى جميع الرجال نجسين

363
00:22:09,300 --> 00:22:11,460
فهذا الوضع يثير اشمئزازه

364
00:22:11,460 --> 00:22:14,880
ومع ذلك، فإنَّ ولائه لشيزوري يطغى على شعوره

365
00:22:19,830 --> 00:22:22,900
سيتقدّم موموتشي إيلم الآن

366
00:22:31,420 --> 00:22:34,600
حسنٌ، تمَّ علاج أغلب جراحكِ

367
00:22:34,600 --> 00:22:36,830
تحملي قليلًا فحسب يا شيزوري

368
00:22:41,920 --> 00:22:43,830
اسمع يا تسو-تشان

369
00:22:45,420 --> 00:22:47,130
حين تنتهي المعركة

370
00:22:48,080 --> 00:22:50,750
سأغادر الشقّة

371
00:23:56,080 --> 00:24:01,080
رسم: كروهودي آنا