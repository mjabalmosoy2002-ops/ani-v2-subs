189
00:13:02,250 --> 00:13:03,540
بُورِكَتْ جُهُودكنّ

190
00:13:03,830 --> 00:13:06,040
أنهيتن سداد الدّيُون في ثلاثة أيّام

191
00:13:06,040 --> 00:13:07,880
شكرًا على عملكنّ الجادّ

192
00:13:08,210 --> 00:13:10,420
صرنا متعادلين مع حادثة الانفجار الآن

193
00:13:10,670 --> 00:13:13,330
انتهينا يا شيزوري-ساما

194
00:13:13,330 --> 00:13:15,670
لا داعي للعمل بعد الآن

195
00:13:15,670 --> 00:13:19,670
حتّى شيزوري الضعيفة لها سحرها الخاص

196
00:13:20,880 --> 00:13:22,820
انتهى الأمر أخيرًا

197
00:13:22,820 --> 00:13:25,380
...أودُّ العودة واللّعب

198
00:13:25,540 --> 00:13:27,260
انتهى الأمر أخيرًا؟

199
00:13:27,260 --> 00:13:28,300
اسمع من يتكلم

200
00:13:28,500 --> 00:13:32,080
من برأيكِ المسؤول عن استغراقنا لثلاثة أيام؟

201
00:13:32,080 --> 00:13:36,040
أيّتها المنعزلة عديمة الفائدة الّتي سُكِّرَت وفقدت ذاكرتها

202
00:13:37,630 --> 00:13:41,920
،كُونِي شاكرةً لي
فقد أنهينا العمل في ثلاثة أيام بسببي

203
00:13:43,250 --> 00:13:44,880
أسرع وتناولها

204
00:13:46,040 --> 00:13:47,370
لطيفة؟

205
00:13:47,500 --> 00:13:49,670
لستُ سعيدة بسماعي لذلك

206
00:13:51,830 --> 00:13:56,880
يمكنك العودة إلى هنا إن رغبت بذلك

207
00:14:00,670 --> 00:14:06,920
حسنٌ، هذا دليل آخر على أنَّ عشيرة ناتسومي متفوّقة على إيدورا

208
00:14:07,170 --> 00:14:08,960
أنتِ محقّة

209
00:14:08,960 --> 00:14:12,960
فأنتِ حقّقتِ أعلى نسبة مبيعات خلال الثّلاثة أيّام

210
00:14:13,330 --> 00:14:16,330
،حقّقتِ ضعف ما حقَّقَته شيزوري
إنّهُ فوز ساحق

211
00:14:16,330 --> 00:14:18,710
حتّى أنّني أودُّ توظيفكِ رسميًا

212
00:14:20,670 --> 00:14:22,790
أنتِ موهوبة

213
00:14:23,290 --> 00:14:29,880
...موهوبة

214
00:14:33,500 --> 00:14:36,250
إنّها تخطط لشيء ما مجدّدًا، أليس كذلك؟

215
00:14:39,750 --> 00:14:43,920
بالمناسبة، يمكنكنَّ أخذ زيّكنَّ معكنَّ إنّ أردتنّ

216
00:14:44,250 --> 00:14:46,540
ماذا؟ لا نريد هذا الشيء بالطّبع

217
00:14:46,540 --> 00:14:50,000
سأتخلص من زيّكِ إذن يا شيزوري-ساما

218
00:14:49,670 --> 00:14:50,830
اصمتي

219
00:14:51,290 --> 00:14:53,170
ما باليد حيلة

220
00:14:53,170 --> 00:14:56,920
أظنّني سأحتفظ به باعتباره جائزة النّصر السّاحق على إيدورا

221
00:14:57,330 --> 00:15:01,380
المعذرة، أظنّني سأحتفظ به أيضًا

222
00:15:02,210 --> 00:15:03,420
تورو-كن

223
00:15:03,750 --> 00:15:04,580
هينا

224
00:15:04,580 --> 00:15:05,960
بدا سعيدًا

225
00:15:06,290 --> 00:15:08,130
وكذلك تسوكاسا-سان

226
00:15:08,130 --> 00:15:09,130
تسو-تشان؟

227
00:15:09,380 --> 00:15:15,420
أجل، احمرّ وجهه قليلًا بعد أن اعتنى بكِ وأنتِ ثملة

228
00:15:15,630 --> 00:15:17,290
لذا، أظنّه لا يكره الزي

229
00:15:18,040 --> 00:15:20,960
ماذا؟ هكذا إذن

230
00:15:31,130 --> 00:15:34,710
ألا تتذكّرين ما قلتهِ عندما كنتِ ثملة في مقهى الخادمات؟

231
00:15:35,080 --> 00:15:40,420
أجل، فأنا أتكلّم بكلام غير مفهوم حين أثمل

232
00:15:40,630 --> 00:15:43,630
لا داعي للقلق إن أخبرتك شيئًا غريبًا

233
00:15:46,630 --> 00:15:49,250
...إذن، ما قالته حينها

234
00:15:49,580 --> 00:15:53,670
لأنّك شخص عزيز عليّ يا تسو-تشان

235
00:15:57,000 --> 00:15:59,500
ماذا تعني بذلك؟

236
00:16:02,830 --> 00:16:05,420
أتساءل كم سيستغرق من الوقت حتّى يعود

237
00:16:06,330 --> 00:16:07,900
لكن هل ستكون الأمور على ما يرام؟

238
00:16:07,900 --> 00:16:10,400
ألن ينزعج من ارتدائي لهذه الملابس فجأة؟

239
00:16:10,710 --> 00:16:13,180
لا، أخبرتني هينا أنّهُ أحبّ الملابس

240
00:16:13,180 --> 00:16:14,990
...لذا حتمًا سـ

241
00:16:16,500 --> 00:16:19,400
سأعتمد على الزّخم في هذه الحالة

242
00:16:19,960 --> 00:16:22,830
مرحبًا بعودتك يا سيّدي

243
00:16:22,830 --> 00:16:24,210
أمزح

244
00:16:24,960 --> 00:16:26,080
...آسفة

245
00:16:26,080 --> 00:16:30,000
يبدو أنّكِ أخذتِ زيّي يا شيزوري-ساما

246
00:16:30,000 --> 00:16:32,200
...لا أمانع إن تركنا الأمور هكذا

247
00:16:32,200 --> 00:16:33,630
مهلًا يا شيزوري-ساما

248
00:16:33,630 --> 00:16:38,500
ز-زيّي يلتفُّ حول جسد شيزوري-ساما

249
00:16:38,500 --> 00:16:42,250
مـ-ما الّذي يثيركِ؟

250
00:16:42,250 --> 00:16:45,170
شكرًا جزيلًا لكِ

251
00:16:50,170 --> 00:16:51,420
حسبكِ

252
00:16:53,130 --> 00:16:53,920
تسو-تشان؟

253
00:17:16,290 --> 00:17:17,900
لا يمكنك فعل هذا يا تسو-تشان

254
00:17:19,830 --> 00:17:23,540
لا تتهوّر إن صادفت اليوما، واتّصل بي فورًا

255
00:17:26,750 --> 00:17:30,170
آسف، فأنتِ تنقذينني دائمًا

256
00:17:30,580 --> 00:17:34,360
لا أمانع ذلك فأنت تعتني بي كلّ يوم

257
00:17:34,360 --> 00:17:36,750
لذا يمكنك ترك مهامّ القتال عليّ

258
00:17:37,420 --> 00:17:39,800
إذن، ما خطب هذا الزيّ؟

259
00:17:40,800 --> 00:17:42,670
...لا، حسنٌ... هذا

260
00:17:42,830 --> 00:17:46,080
...أجبرتني معلّمتي على أخذه

261
00:17:46,080 --> 00:17:50,460
لم آخذه لإسعادك أو أيّ شيء من هذا القبيل يا تسو-تشان

262
00:17:58,790 --> 00:18:03,600
أجل، اللّحم بالبطاطس خاصّتك هو الألذّ يا تسو-تشان

263
00:18:03,600 --> 00:18:07,800
يصير الطّعام ألذّ بعد التحرّر من قيود العمل كما توقّعت

264
00:18:07,800 --> 00:18:10,790
رغم أن شعور الفوز في اللّعبة يكون استثنائيًّا

265
00:18:11,380 --> 00:18:12,540
ماذا يعني هذا؟

266
00:18:14,630 --> 00:18:19,150
بالمناسبة، ما هو شعوركِ تجاهي يا شيزوري؟

267
00:18:20,130 --> 00:18:22,080
ما هبب يؤالم هتا؟

268
00:18:26,170 --> 00:18:28,710
أهنّاك ما تشتهين أكله على العشاء يوم غد؟

269
00:18:30,460 --> 00:18:32,330
...حسنٌ، دعني أفكر

270
00:18:32,540 --> 00:18:38,630
إذن، استخدم بقايا اليوم لتحضير كاري اللّحم بالبطاطس الخاصّ بتسو-تشان

271
00:18:38,630 --> 00:18:40,170
ألّا تمانعين ذلك؟

272
00:18:40,170 --> 00:18:41,840
فهو لذيذ بعد كلّ شيء

273
00:18:41,850 --> 00:18:45,250
ربّما سأتناوله كلّه حتّى لا يتبقّى منه شيء ليوم غدٍ

274
00:18:45,250 --> 00:18:46,540
حسنٌ، حسنٌ

275
00:18:46,900 --> 00:18:48,200
...يوم غد إذن

276
00:18:48,250 --> 00:18:49,600
عليّ الذهاب للتسوق

277
00:18:49,600 --> 00:18:52,500
فورق الحمام على وشك النّفاذ

278
00:18:52,500 --> 00:18:54,800
أظنّ أن هناك عرض خاصّ في دونكي هوك

279
00:18:55,300 --> 00:18:57,620
سآتي معك إذن

280
00:18:57,620 --> 00:19:00,100
اترك حمل الأغراض عليّ

281
00:19:00,330 --> 00:19:02,040
حسنٌ، آسف حقًّا

282
00:19:02,040 --> 00:19:05,500
سنلعب حين عودتنا في المقابل، حسنٌ؟

283
00:19:05,580 --> 00:19:07,900
لم أتمكّن من اللّعب مُنذ بدأت العمل

284
00:19:07,900 --> 00:19:10,990
لذا سأتأكّد من هزيمتك هذه المرّة يا تسو-تشان

285
00:19:11,210 --> 00:19:12,290
أتطلّع لذلك

286
00:19:12,540 --> 00:19:14,960
تبدو متغطرسًا

287
00:19:14,960 --> 00:19:15,830
لستُ كذلك

288
00:19:15,830 --> 00:19:17,250
بلى بلى

289
00:19:17,250 --> 00:19:18,540
لا، لستُ كذلك

290
00:19:25,540 --> 00:19:26,960
محال، مجدّدًا؟

291
00:19:27,500 --> 00:19:28,700
لا داعي للقلق

292
00:19:28,900 --> 00:19:31,170
فتمّ وضع حاجز المرآة

293
00:19:32,250 --> 00:19:36,000
مرَّ نصف عام بالفعل مُنذ مجيئكِ إلى هنا يا شيزوري

294
00:19:36,750 --> 00:19:39,200
كنتُ أراقبكِ بصمت حتّى هذه اللّحظة
...ولكن

295
00:19:39,500 --> 00:19:41,990
يبدو أنّكِ لا تنوين تغيير وضعكِ

296
00:19:42,170 --> 00:19:44,750
ظننتكِ ستغيّرين نمط عيشكِ حين رأيتني

297
00:19:44,800 --> 00:19:46,000
لكن لم ينجح الأمر

298
00:19:46,300 --> 00:19:47,040
...لذا

299
00:19:47,040 --> 00:19:48,990
حان وقت إنهاء الأمر

300
00:19:49,170 --> 00:19:50,130
المالكة؟

301
00:19:50,540 --> 00:19:53,100
غادري هذا المكان يا شيزوري

302
00:19:54,130 --> 00:19:58,500
مبناي لا يرحّب بكونويتشي مثلكِ

303
00:19:58,540 --> 00:20:03,100
إلى متى ستستمريّن في تجاهل قوّة "السيّد" الخاصّة بأتسومي-كن؟

304
00:20:03,420 --> 00:20:07,300
لا بدَّ وأنّكِ لاحظتِ نسبه

305
00:20:08,790 --> 00:20:11,500
قوّة السيّد؟ والنَّسب؟

306
00:20:12,540 --> 00:20:15,500
ليس لكِ علاقة بالأمر

307
00:20:22,290 --> 00:20:23,540
ليس لي علاقة؟

308
00:20:24,580 --> 00:20:27,700
لا أستطيع التّغاضي عن انتهاكات عقْد الإيجار باعتباري المالكة

309
00:20:30,790 --> 00:20:31,670
شيزوري

310
00:20:32,540 --> 00:20:37,990
ستزداد قوّة اليوما الّتي تطارد أتسومي-كن
بسبب نسبه لسلالة عالية

311
00:20:38,500 --> 00:20:39,900
أعرف ذلك بالفعل

312
00:20:40,460 --> 00:20:44,200
ستندمين حين تفشلين في حمايته

313
00:20:44,250 --> 00:20:47,500
لذا استخدمي قوّته قبل فوات الأوان

314
00:20:53,880 --> 00:20:58,300
أم أنّكِ تريدين الاستمرار في هذا العقْد الأنانيّ؟

315
00:21:00,380 --> 00:21:01,800
أعرف

316
00:21:02,100 --> 00:21:04,250
...ولكن، ولكن

317
00:21:04,460 --> 00:21:08,100
إلى متى ستلقين عدم فائدتكِ عليه؟

318
00:21:12,210 --> 00:21:14,460
اخرسي

319
00:21:18,210 --> 00:21:18,880
هناك

320
00:21:20,420 --> 00:21:21,900
أنتِ ساذجة

321
00:21:29,040 --> 00:21:30,150
فهمتِ؟

322
00:21:30,900 --> 00:21:32,710
هذا حدّ قوّتكِ

323
00:21:32,960 --> 00:21:37,900
حسنٌ، نظرًا لطريقة عيشكِ الفاترة فهذا ليس غريبًا

324
00:21:38,420 --> 00:21:39,900
هذا يكفي، أليس كذلك؟

325
00:21:39,900 --> 00:21:42,040
...أسرعي وغادري المكان

326
00:21:43,000 --> 00:21:45,580
ماذا تفعل يا أتسومي-كن؟

327
00:21:49,750 --> 00:21:50,880
ابتعد

328
00:21:53,250 --> 00:21:54,750
لـ-لا

329
00:21:55,130 --> 00:21:56,460
تسـ-تسو-تشان

330
00:21:57,250 --> 00:22:02,200
،بغضّ النّظر عن كونكِ شينوبي عظيمة
إلّا أنّكِ لا تملكين الحقّ بطرد شيزوري

331
00:22:02,290 --> 00:22:05,840
...نمط حياتي

332
00:22:06,200 --> 00:22:08,130
ثـ-ثمين بالنّسبة لي

333
00:22:11,960 --> 00:22:12,880
...تسو-تشان

334
00:22:15,250 --> 00:22:18,000
سأنسحب اليوم احترامًا لـ أتسومي-كن

335
00:22:18,540 --> 00:22:20,640
سأمنحكِ بعض الوقت

336
00:22:21,560 --> 00:22:23,290
فكري بعناية خلاله

337
00:22:25,830 --> 00:22:28,500
لن أظهر أيّ رحمة في المرّة القادمة

338
00:22:37,170 --> 00:22:38,040
صباح الخير

339
00:22:38,830 --> 00:22:40,050
أنتِ مستيقظة إذن

340
00:22:40,050 --> 00:22:41,420
ماذا عن إصابتكِ؟

341
00:22:42,170 --> 00:22:43,540
أنا بخير

342
00:22:43,880 --> 00:22:45,040
حقًّا؟

343
00:22:45,330 --> 00:22:46,300
-المعذرة

344
00:22:45,830 --> 00:22:46,250
...مهلًا

345
00:22:48,000 --> 00:22:49,460
اسمع يا تسو-تشان

346
00:22:51,330 --> 00:22:53,670
سأتوقّف عن الانعزال

347
00:23:55,500 --> 00:24:00,420
رسم: شيروكيتسوني