1
00:00:06,020 --> 00:00:11,400
تشير حساباتي إلى أنَّنا سنبلغ
.وجهتنا بعد 3 دقائق و40 ثانية

2
00:00:12,060 --> 00:00:15,300
وحين نصل إلى هناك، سيتعيّن علينا
مواجهة المُغتالة وعميلتها؟

3
00:00:17,220 --> 00:00:20,370
بالمناسبة، أين بندقيتك؟

4
00:00:20,800 --> 00:00:23,000
.أعطيتُها لأحد معارفي

5
00:00:23,510 --> 00:00:27,150
،بدا أنّها أرادتها بشدّة
.فرأيتُ أنّ لا مانع من إعطائها لها

6
00:00:27,150 --> 00:00:28,980
!لا يصحّ أن تتعاملي معها باستهتار كهذا

7
00:00:28,980 --> 00:00:31,530
!كانت مِلكًا لسييستا لعلمك

8
00:00:32,430 --> 00:00:36,230
لكن... هل لديك خطّة
لنفوز دون سلاح؟

9
00:00:36,230 --> 00:00:38,780
.ماذا؟ لا، ليس لديّ

10
00:00:38,780 --> 00:00:39,770
ليس لديك؟

11
00:00:40,150 --> 00:00:41,080
...لكن

12
00:00:42,020 --> 00:00:45,520
أنت تملك خطّة، صحيح؟

13
00:00:50,450 --> 00:00:53,280
لن تخبرني إذًا؟

14
00:00:54,430 --> 00:00:55,590
.ها هُما

15
00:00:58,040 --> 00:00:59,450
.هيّا بنا

16
00:01:04,000 --> 00:01:07,550
الحلقة 5
كان ذلك جوابهم النهائي

17
00:01:12,400 --> 00:01:14,100
كيميزوكا؟

18
00:01:14,410 --> 00:01:18,310
ماذا؟ أما زالت تلك الروبوت تعمل؟

19
00:01:20,060 --> 00:01:20,800
.تولّي الأمر

20
00:01:28,700 --> 00:01:30,100
.يريدان قتالًا

21
00:01:30,440 --> 00:01:32,950
.بدء العقاب

22
00:01:40,610 --> 00:01:41,960
!بالغتِ كثيرًا

23
00:01:42,270 --> 00:01:46,200
نسخة سيريوس التجريبية
.مزوّدة بقوة نارية هائلة

24
00:01:46,200 --> 00:01:50,460
أعلم أنّها نالت منكِ مرّة
.لكن هذا الأسلوب في الانتقام وحشي

25
00:02:02,490 --> 00:02:03,600
.سأتولى أمرها

26
00:02:04,040 --> 00:02:06,110
.تراجع يا كيميهيكو

27
00:02:08,570 --> 00:02:11,280
...أنتِ ومصاص الدماء ذاك

28
00:02:11,920 --> 00:02:14,090
!لم يكن أيّ من هذا جزءًا من الخطة

29
00:02:14,410 --> 00:02:16,180
خطة؟

30
00:02:16,180 --> 00:02:18,670
لا أظنّ أنَّ هذه هي الطريقة
.الصحيحة للنظر إلى الأمر

31
00:02:18,670 --> 00:02:21,660
ماذا؟ هل تحاولين توبيخي؟

32
00:02:21,660 --> 00:02:25,420
.لا. لا يحق لي فعل ذلك

33
00:02:25,810 --> 00:02:32,120
لكن سييستا-ساما لم تكُن لتلقي اللوم
.على الآخرين بسبب إخفاقات خطّتها

34
00:02:36,340 --> 00:02:40,430
.الانفعال المفرط إحدى عاداتك السيئة

35
00:02:43,700 --> 00:02:45,620
.كانت سيّدتي تتصرف بالطريقة نفسها

36
00:02:47,000 --> 00:02:50,070
.قابلتُها لأوّل مرة قبل خمس سنوات

37
00:02:50,630 --> 00:02:55,540
.أمرتني منظمة معيّنة باغتيالها

38
00:03:05,450 --> 00:03:07,370
!لا بأس

39
00:03:07,370 --> 00:03:10,170
!اقتليني أو افعلي ما شئت

40
00:03:10,890 --> 00:03:15,570
فشلتُ في اغتيالكِ لذا
!سيقتلونني على أيّ حال

41
00:03:15,570 --> 00:03:17,830
.أخبرتك قبل قليل

42
00:03:17,830 --> 00:03:20,420
.أخبري الجميع أنّني متُ هنا

43
00:03:20,420 --> 00:03:23,140
.عندها لن يقتلوك

44
00:03:24,530 --> 00:03:28,190
ولِم تريدين منّي أن أفعل هذا؟

45
00:03:31,860 --> 00:03:34,190
لِم تعملين في مجال كهذا؟

46
00:03:36,080 --> 00:03:38,200
.بسبب والديّ

47
00:03:38,700 --> 00:03:42,660
.كانا جُنديّين وجاسوسين

48
00:03:43,260 --> 00:03:47,040
.حميا هذا العالم خفية

49
00:03:47,430 --> 00:03:52,400
.لذا أفخر بهما... وبهذا العمل

50
00:03:53,130 --> 00:03:54,420
.فهمت

51
00:03:54,420 --> 00:03:56,220
.مثلي إذًا

52
00:03:57,030 --> 00:04:00,550
.أنا أيضًا أقوم بهذا العمل لأسباب تخصّني

53
00:04:00,550 --> 00:04:04,440
.لذا لا أستطيع أن أدعك تقتلينني هنا

54
00:04:06,630 --> 00:04:11,100
لكن إن كنتِ مثلي
.فلا يجب أن تموتي هنا

55
00:04:11,100 --> 00:04:13,540
لذا ستُساعدينني؟

56
00:04:13,540 --> 00:04:14,480
.نعم

57
00:04:14,870 --> 00:04:18,530
.وأريدك أن تساعديني بعد انتهاء هذا

58
00:04:20,450 --> 00:04:22,320
.هذه هي الصفقة التي أعرضها عليك

59
00:04:23,030 --> 00:04:25,800
.سأنقذ حياتكِ هذه المرّة

60
00:04:26,260 --> 00:04:31,080
.وفي المقابل، ساعديني من حين لآخر

61
00:04:32,710 --> 00:04:35,300
.حاولتُ قتلكِ

62
00:04:35,300 --> 00:04:38,090
وتطلبين منّي أن أساعدك؟

63
00:04:38,940 --> 00:04:40,090
ما قولك؟

64
00:04:41,610 --> 00:04:44,600
...أدركتُ غريزيًا

65
00:04:45,440 --> 00:04:49,490
أنّها لم تكن بحاجة
.إلى مساعدتي في الحقيقة

66
00:04:49,950 --> 00:04:56,040
قالت ذلك فقط كي تجعل
.تقبّلي لمساعدتها أمرًا أيسر

67
00:04:57,970 --> 00:04:59,360
...هذا ليس عادلًا

68
00:05:03,460 --> 00:05:07,510
ما الذي عليّ فعله إذًا؟

69
00:05:12,880 --> 00:05:18,020
ومنحتني هذه القلادة
.كدليل على اتفاقنا

70
00:05:18,780 --> 00:05:22,850
.كانت تحميني دائمًا

71
00:05:22,850 --> 00:05:26,390
لن تستطيع تلك المنظمة إيذائي
.ما دمتُ أعمل مع أحد الضابطين

72
00:05:26,870 --> 00:05:29,070
بل أنّها رتّبت الأمر حتّى

73
00:05:29,070 --> 00:05:33,790
أستطيع العمل مع أحد من
.بقية الضابطين فور وفاتها

74
00:05:33,790 --> 00:05:35,810
وهي كاسي فوبي؟

75
00:05:36,590 --> 00:05:38,150
...وحتّى الآن

76
00:05:38,150 --> 00:05:40,650
...حتّى وهي بهذه الهيئة

77
00:05:40,650 --> 00:05:45,160
!لا تزال تتساهل معي حتّى لا تقتلني

78
00:05:45,160 --> 00:05:46,670
!لماذا؟

79
00:05:47,110 --> 00:05:48,660
!لماذا تتساهلين معي؟

80
00:05:48,660 --> 00:05:51,160
لِماذا لا تواجهينني بجدية؟

81
00:05:51,160 --> 00:05:54,920
لماذا لا تزالين تحاولين حمايتي؟

82
00:05:55,450 --> 00:05:58,460
.لم أستطع فعل أيّ شيء قبل سنة

83
00:05:58,780 --> 00:06:00,400
...لذا قطعتُ عهدًا

84
00:06:00,400 --> 00:06:04,230
مهما حدث خلال فترة
عملي لدى تلك المرأة

85
00:06:04,230 --> 00:06:09,520
!سأهزم سبيس نيابة عنها

86
00:06:09,970 --> 00:06:11,350
...لكنّكِ

87
00:06:18,980 --> 00:06:22,610
!سأفعل كلّ ما يلزم لأنتصر

88
00:06:26,750 --> 00:06:29,990
.توقّعتُ أنّك ستفعلين هذا

89
00:06:30,280 --> 00:06:31,460
.انتهى الأمر

90
00:06:32,250 --> 00:06:33,560
!مهلًا يا شار

91
00:06:34,250 --> 00:06:37,170
هل يمكنك الضغط على الزناد حقًا؟

92
00:06:37,500 --> 00:06:39,310
ما قصدك؟

93
00:06:39,310 --> 00:06:41,640
أتظنّ أنّني سأتردد حقًا؟

94
00:06:41,640 --> 00:06:45,380
حتّى لو كان ذلك جسد
سييستا الحقيقي؟

95
00:06:48,190 --> 00:06:52,060
هي الحقيقية؟

96
00:06:53,550 --> 00:06:55,120
أدركتَ الأمر إذًا؟

97
00:06:56,020 --> 00:06:59,190
متى اكتشفت ذلك يا كيميهيكو؟

98
00:06:59,560 --> 00:07:01,360
.لستُ متأكدًا

99
00:07:01,990 --> 00:07:06,410
.لا أظنّ أنّ هناك سببًا محدّدًا لذلك

100
00:07:07,770 --> 00:07:14,750
حُفظ جسد سييستا-ساما بعد
.المعركة التي وقعت قبل سنة

101
00:07:15,650 --> 00:07:20,390
وزُوّد بقلب اصطناعي

102
00:07:20,390 --> 00:07:24,470
.وذكاء اصطناعي يحمل ذكرياتها

103
00:07:24,470 --> 00:07:26,430
.هكذا وُلدت

104
00:07:28,110 --> 00:07:32,680
...راودني ظن بأنّ الأمر قد يكون كذلك

105
00:07:33,160 --> 00:07:36,600
.فأنا أتذكر رائحتها

106
00:07:37,690 --> 00:07:39,690
لكن ماذا في ذلك؟

107
00:07:40,220 --> 00:07:46,010
...حتّى لو كان هذا جسدها
!فإنّ مهمتي لن تتغيّر

108
00:07:46,700 --> 00:07:51,270
شار! نحن الأربعة إرث
!سييستا الذي خلّفته

109
00:07:51,270 --> 00:07:53,450
،إن كنت تنوين مواصلة أداء واجبها

110
00:07:53,770 --> 00:07:56,320
!فلا يجب أن يموت أحد منّا

111
00:07:57,180 --> 00:07:59,710
!لكنّها كانت من الضابطين

112
00:07:59,710 --> 00:08:02,640
!كان واجبها القضاء على سبيس

113
00:08:03,210 --> 00:08:05,920
...شار! المعلّمة التي أحببتِها

114
00:08:05,920 --> 00:08:10,290
هل كانت ستختار واجبها أم رفاقها؟

115
00:08:11,120 --> 00:08:12,220
!اخرس

116
00:08:22,830 --> 00:08:24,230
...لماذا

117
00:08:24,530 --> 00:08:28,450
لماذا تبتسم بهذه السعادة؟

118
00:08:28,450 --> 00:08:29,450
...هذا

119
00:08:30,200 --> 00:08:31,450
!هذا الشيء

120
00:08:40,830 --> 00:08:42,080
.هذا مؤلم

121
00:08:42,910 --> 00:08:45,040
...أنا... آسفة

122
00:08:52,560 --> 00:08:53,850
لماذا؟

123
00:08:57,040 --> 00:08:59,500
هل أنتِ حمقاء؟

124
00:09:01,700 --> 00:09:03,270
...هذه

125
00:09:05,990 --> 00:09:08,880
...هذه أوّل مرة

126
00:09:10,610 --> 00:09:13,960
...تقولين فيها هذه الكلمات لي

127
00:09:19,200 --> 00:09:20,570
...سيّدتي

128
00:09:26,490 --> 00:09:27,780
!نوتشيس

129
00:09:31,740 --> 00:09:32,810
!سيّدتي

130
00:09:34,500 --> 00:09:39,220
.لهذا وصفتُكِ بالساذجة يا شارلوت

131
00:09:40,100 --> 00:09:43,180
.حسبتُ أنّك أذكى

132
00:09:43,670 --> 00:09:46,190
.لكنّك لا تختلفين عن ذلك الفتى

133
00:09:47,260 --> 00:09:48,290
!نوتشيس

134
00:09:48,690 --> 00:09:50,110
.أنا بخير

135
00:09:50,780 --> 00:09:56,280
يمكن معالجة ضرر بسيط كهذا
.بتفعيل نظام الإيقاف الطارئ لديّ

136
00:09:56,280 --> 00:09:57,560
...لكن

137
00:09:57,560 --> 00:10:03,290
!أولويتكما هي مواجهتها

138
00:10:07,790 --> 00:10:09,700
.سأعود حالًا

139
00:10:18,550 --> 00:10:20,060
ما خطبكما؟

140
00:10:20,060 --> 00:10:24,100
كنتما تتظاهران بأنّكما عدوان قبل
قليل والآن تعملان معًا؟

141
00:10:25,000 --> 00:10:28,820
أنتِ متأكدة من قراركِ
بمواجهتها، صحيح؟

142
00:10:29,120 --> 00:10:31,000
.ستخسرين الكثير إن فعلتِ

143
00:10:34,810 --> 00:10:36,320
.فات الأوان للقلق بشأن ذلك

144
00:10:37,480 --> 00:10:38,830
!سنهاجم من الجانبين أولًا

145
00:10:42,510 --> 00:10:43,560
.بطيء جدًا

146
00:10:50,340 --> 00:10:51,960
.سقط واحد

147
00:11:02,390 --> 00:11:03,790
ماذا ستفعلين الآن؟

148
00:11:03,790 --> 00:11:05,640
.لم يبق سواكِ الآن

149
00:11:06,170 --> 00:11:09,510
هل ستواصلين المقاومة بلا سبب؟

150
00:11:09,510 --> 00:11:11,900
ألا يهمّكِ ما سيحلّ بالعالم؟

151
00:11:12,350 --> 00:11:14,910
!يهمّني طبعًا

152
00:11:15,410 --> 00:11:23,160
لكنّها لم تكن لترغب في أن
!أضحي بأحد لإنقاذ العالم

153
00:11:23,410 --> 00:11:24,650
حقًا؟

154
00:11:24,650 --> 00:11:28,600
،ألم تقل ذلك بنفسها
هي التي ضُحّي بها لإنقاذ العالم؟

155
00:11:29,100 --> 00:11:32,750
قالت أنّكم آخر ما خلّفته؟

156
00:11:32,750 --> 00:11:34,790
هل تدركين معنى ذلك؟

157
00:11:36,510 --> 00:11:40,030
معناه أنّكم مطالبون بمواصلة
مسيرة المحققة العظيمة

158
00:11:40,030 --> 00:11:42,760
.والموت في سبيل العالم

159
00:11:44,270 --> 00:11:45,910
.سأكون صريحة معك

160
00:11:46,520 --> 00:11:48,870
.ناتسوناغي ناغيسا ليست مؤهلة بما يكفي

161
00:11:48,870 --> 00:11:50,520
.إنّها ضعيفة جدًا

162
00:11:51,090 --> 00:11:52,520
،لذا يا شارلوت

163
00:11:53,020 --> 00:11:57,300
عليكِ أن ترثي إرادتها وتصبحي المحققة
.العظيمة الجديدة كواحدة من الضابطين

164
00:11:58,390 --> 00:11:59,910
لطالما نظرتِ إليها بإعجاب، صحيح؟

165
00:12:02,640 --> 00:12:03,850
...لا

166
00:12:05,390 --> 00:12:09,790
!	لم يكن إعجابي بها مقتصرًا على كونها المحققة العظيمة

167
00:12:10,310 --> 00:12:11,990
...أنا

168
00:12:13,330 --> 00:12:18,040
أُعجبت بتلك الفتاة القوية
.والجميلة التي تُدعى سييستا

169
00:12:19,660 --> 00:12:21,340
.كم هذا ممل

170
00:12:26,780 --> 00:12:28,440
.أنت تستخفين بي

171
00:12:37,990 --> 00:12:40,780
أظننتِ أنّك قادرة على
هزيمتي في مواجهة فردية؟

172
00:12:43,530 --> 00:12:45,220
.انتهى وقت اللّهو

173
00:12:47,370 --> 00:12:48,370
!الآن

174
00:12:53,960 --> 00:12:56,630
!إصابة موفقة يا ناغيسا-سان

175
00:12:56,630 --> 00:12:59,010
.أدوات سييستا السبع مذهلة

176
00:12:59,370 --> 00:13:01,510
.لم أشعر بأيّ ارتداد

177
00:13:02,800 --> 00:13:05,510
هل عادت بنفسها؟

178
00:13:06,020 --> 00:13:07,040
لماذا؟

179
00:13:07,520 --> 00:13:10,770
هل ستقفان إلى جانبها؟

180
00:13:10,770 --> 00:13:14,190
!حاولت قتلكما

181
00:13:15,780 --> 00:13:18,360
!نعم! إنّها رفيقتنا

182
00:13:19,140 --> 00:13:22,530
وبعد هذا، سنخوض شجارًا
!كبيرًا بسبب ما فعلته

183
00:13:22,940 --> 00:13:25,500
لا تمانعين، صحيح يا شار-سان؟

184
00:13:25,500 --> 00:13:27,960
.ليست وحدها لعلمك

185
00:13:27,960 --> 00:13:32,000
!أنا ويوي-تشان سنقتلكِ مرّتين

186
00:13:32,750 --> 00:13:35,290
...يوي... ناغيسا

187
00:13:35,630 --> 00:13:38,330
.لا تقلقي. لن يحدث ذلك

188
00:13:39,680 --> 00:13:43,200
أنتِ مستعدة للموت، صحيح يا سايكاوا يوي؟

189
00:13:43,550 --> 00:13:46,280
.وكذلك أنتِ يا ناتسوناغي ناغيسا

190
00:13:46,810 --> 00:13:48,310
.بالطبع

191
00:13:48,310 --> 00:13:51,810
آسفة، لكنّني لن أطلق
.أيّ طلقات تحذيرية

192
00:13:59,820 --> 00:14:00,830
!إلى اليمين

193
00:14:05,590 --> 00:14:07,280
.أدركتُ أنّ عليّ التخلص منك أولًا

194
00:14:36,480 --> 00:14:38,230
!يوي! ناغيسا

195
00:14:56,670 --> 00:14:59,750
أما زلتنّ تتظاهرن بأنّكنّ صديقات؟

196
00:15:00,170 --> 00:15:01,510
.يا للغباء

197
00:15:03,130 --> 00:15:05,130
!ليس غباءً

198
00:15:05,450 --> 00:15:08,890
!نحن الأمل الأخير الذي خلّفته سييستا

199
00:15:08,890 --> 00:15:12,390
!لن يُهزم أحد منّا! ولن يستسلم أحد

200
00:15:12,390 --> 00:15:14,160
!سنفوز معًا

201
00:15:16,030 --> 00:15:17,850
ما خطبكن؟

202
00:15:18,430 --> 00:15:23,440
،رفاق، روابط، صداقة
...مشاعر، إرادة

203
00:15:23,950 --> 00:15:26,660
ما نفع كلّ ذلك للعالم؟

204
00:15:26,980 --> 00:15:28,460
.سايكاوا يوي

205
00:15:28,460 --> 00:15:31,160
.سينجو العالم إن متِ

206
00:15:31,160 --> 00:15:33,670
.شارلوت أريساكا أندرسون

207
00:15:33,670 --> 00:15:37,040
.سينجو العالم إن قتلتِ سايكاوا يوي

208
00:15:37,540 --> 00:15:39,470
.ناتسوناغي ناغيسا

209
00:15:39,470 --> 00:15:44,200
لو كنتِ بقوة المحققة العظيمة
!السابقة، لنجا العالم

210
00:15:44,950 --> 00:15:47,290
فلِم لا تفعل أيّ منكن ذلك؟

211
00:15:47,290 --> 00:15:48,340
ألا تستطعن؟

212
00:15:48,790 --> 00:15:51,090
فهمت. لا تستطعن إذًا؟

213
00:15:51,790 --> 00:15:56,600
إذًا، يجدر بكن على الأقل
...أن تخجلن من عجزكن

214
00:15:57,460 --> 00:16:01,040
وألا تعرقلن من يقاتلون فعلًا
.من أجل إنقاذ العالم

215
00:16:02,800 --> 00:16:04,080
.أنتِ محقة

216
00:16:04,630 --> 00:16:07,700
.لا أظنّ أنَّ ما تقولينه خاطئ

217
00:16:08,110 --> 00:16:11,070
قد يقول بعض النّاس أنَّ
.ما تفعلينه هو التصرف الصحيح

218
00:16:11,520 --> 00:16:15,330
لكن المحققة التي كانت
.على صواب دائمًا قد ماتت

219
00:16:16,280 --> 00:16:21,860
!لذا أريد أن أتخذ قرارًا قد يكون خاطئًا

220
00:16:22,530 --> 00:16:24,280
أريد أن أختار مستقبلًا

221
00:16:24,280 --> 00:16:28,090
يكون فيه أعزّائي إلى جانبي
!يبتسمون معي حين انتهاء كلّ شيء

222
00:16:28,340 --> 00:16:32,250
!لا أريد أن أدع أيّ شخص آخر يموت

223
00:16:34,490 --> 00:16:36,020
.هذه مضيعة للوقت

224
00:16:37,210 --> 00:16:39,710
.هذا يبسّط الأمور إذًا

225
00:16:40,440 --> 00:16:43,070
المنتصر هو من يبقى
.واقفًا حتّى النهاية

226
00:16:43,860 --> 00:16:45,860
.أنتِ شر ويجب تدميرك

227
00:16:49,360 --> 00:16:50,390
!ناغيسا

228
00:16:50,390 --> 00:16:51,480
.لا تقلقي

229
00:16:51,990 --> 00:16:57,300
.لا أستطيع رؤيتها لكنّها تنظر إليّ

230
00:16:57,300 --> 00:16:59,500
.تسمع صوتي

231
00:16:59,500 --> 00:17:03,020
.لذا لا بدّ أن تتفعّل هذه القدرة

232
00:17:04,100 --> 00:17:05,320
.كاسي فوبي

233
00:17:06,150 --> 00:17:09,130
.لقد تجمّدتِ في مكانكِ

234
00:17:16,220 --> 00:17:21,170
لا تظني أنّ بوسعك إيقافي
!بقدرة جديدة تافهة كهذه

235
00:17:22,990 --> 00:17:27,720
هل تحسبنّ أنّكنّ ثلاثًا قادرات حقًا على إيقافي؟

236
00:17:29,520 --> 00:17:30,760
...لحظة

237
00:17:31,930 --> 00:17:33,110
ثلاثة؟

238
00:17:34,080 --> 00:17:36,030
.لم تعد الروبوت قادرة

239
00:17:36,650 --> 00:17:41,540
منذ متى وأنا أقاتل ثلاثة منهم؟

240
00:17:42,240 --> 00:17:44,490
أين هو؟

241
00:17:44,490 --> 00:17:46,910
أين كيميزوكا كيميهيكو؟

242
00:17:49,880 --> 00:17:52,590
.اتخذتِ القرار الصائب

243
00:17:53,180 --> 00:17:56,820
.كانت أولويتكِ القضاء على شار والبقية

244
00:17:57,810 --> 00:18:02,320
كان بوسعك التعامل بسهولة
.مع أيّ شيء قد أحاول فعله

245
00:18:03,590 --> 00:18:06,960
.لكنّك ارتكبتِ خطأ واحدًا

246
00:18:07,740 --> 00:18:09,880
...كيميزوكا كيميهيكو

247
00:18:09,880 --> 00:18:13,550
!ابتلعتَ بذرة كاميليون

248
00:18:16,220 --> 00:18:17,870
آثار جانبية؟

249
00:18:17,870 --> 00:18:19,450
.لا أبالي بها إطلاقًا

250
00:18:20,760 --> 00:18:23,490
...أنا متأكد أنّها ستغضب

251
00:18:24,770 --> 00:18:29,170
لكنّ كلّ ما يهمني الآن هو لكم
.هذه المحققة اللّعينة في وجهها

252
00:18:29,780 --> 00:18:33,510
...شوّهَت العدالة التي أحبّتها رفيقتي

253
00:18:33,510 --> 00:18:36,640
!كلّ ما أريده هو أن ألكمها

254
00:18:37,590 --> 00:18:39,640
أهذا ما تريده حقًا؟

255
00:18:43,380 --> 00:18:44,470
.نعم

256
00:18:45,080 --> 00:18:47,770
.لن أتسبّب في أيّ متاعب لأحد

257
00:18:49,520 --> 00:18:51,180
صحيح؟

258
00:18:52,280 --> 00:18:53,650
...هذه

259
00:18:57,260 --> 00:18:59,130
!قصّتي أنا

260
00:19:08,470 --> 00:19:11,560
،أنت رجل جريء
.تعتقل ضابطة شرطة

261
00:19:12,590 --> 00:19:16,990
ما زلتُ لا أصدّق
.أنّك ابتلعتَ البذرة رغم ذلك

262
00:19:16,990 --> 00:19:17,840
.نعم

263
00:19:18,730 --> 00:19:20,930
.كانت هديّة من مصاص الدماء

264
00:19:22,380 --> 00:19:24,600
.ستموت

265
00:19:26,740 --> 00:19:29,110
.حسنًا، سأتعامل مع الأمر حين يحدث

266
00:19:30,330 --> 00:19:31,940
.فهمت

267
00:19:31,940 --> 00:19:35,120
.حسنًا، اذهب وانضم إليهن إذًا

268
00:19:37,790 --> 00:19:39,170
...سيّدتي

269
00:19:39,780 --> 00:19:41,120
...اسمعيني

270
00:19:41,530 --> 00:19:45,620
...أنا لستُ هي... يا شارلوت

271
00:19:45,620 --> 00:19:46,900
!نوتشيس-سان

272
00:19:46,900 --> 00:19:48,120
هل أنت بخير؟

273
00:19:49,740 --> 00:19:52,600
...أنتن دائمًا تحدثن ضجيجًا كثيرًا

274
00:19:53,510 --> 00:19:57,010
.لن أستطيع أخذ قيلولة هكذا

275
00:19:57,010 --> 00:19:59,760
هل أنت بخير يا نوتشيس؟

276
00:20:01,510 --> 00:20:04,710
.أدّيتُ واجبي وزيادة

277
00:20:05,370 --> 00:20:07,270
ماذا تقصدين؟

278
00:20:07,900 --> 00:20:12,400
كان على كلّ واحد منكم
.التغلب على أمر ما

279
00:20:13,170 --> 00:20:17,130
.أنا مجرّد برنامج صُمّم لمساعدتكم على ذلك

280
00:20:17,920 --> 00:20:22,440
كان على ناتسوناغي ناغيسا أن تعرف حقيقتها

281
00:20:22,440 --> 00:20:24,870
.وتواجه ماضيها

282
00:20:25,650 --> 00:20:29,520
كان على سايكاوا يوي أن
تتقبّل حقيقة وفاة والديها

283
00:20:29,520 --> 00:20:32,220
.وتُقرّر ما ستفعله بحياتها

284
00:20:33,000 --> 00:20:38,100
كان على شارلوت أريساكا أندرسون
أن تتحرّر من واجبها

285
00:20:38,100 --> 00:20:41,100
.وتكتسب إرادة خاصّة بها

286
00:20:41,980 --> 00:20:48,460
أمّا كيميزوكا كيميهيكو فكان عليه
.أن يتخطّى وفاة سييستا-ساما

287
00:20:50,050 --> 00:20:52,680
.أنجزتُ عملي

288
00:20:52,680 --> 00:20:57,590
تستطيع سييستا-ساما الآن
.المضي دون ندم

289
00:21:01,280 --> 00:21:03,050
أهذا صحيح حقًا؟

290
00:21:04,100 --> 00:21:10,580
حتّى لو تحرّرنا من الماضي
،والأشياء التي تقيّدنا

291
00:21:10,970 --> 00:21:13,580
أيعني هذا حقًا أنّها
حظيت بنهاية سعيدة؟

292
00:21:14,470 --> 00:21:15,750
...كيميهيكو

293
00:21:16,590 --> 00:21:19,240
...كانت تبكي

294
00:21:19,670 --> 00:21:22,960
.كانت تبكي وتقول أنّها لم ترد أن تموت

295
00:21:24,490 --> 00:21:28,200
،لو كان هذا حقًا ما أرادته

296
00:21:28,900 --> 00:21:31,800
!لما سمحت لنا برؤيتها تبكي بتلك الطريقة

297
00:21:32,190 --> 00:21:38,190
ألم تُقرّري من تلقاء نفسك
أن ترينا ذلك الجزء يا نوتشيس؟

298
00:21:38,190 --> 00:21:43,950
أردتِنا أن نصحّح الخطأ الذي ارتكبَته
!سييستا حين ضحّت بنفسها

299
00:21:44,270 --> 00:21:48,020
ذلك هو الجواب الحقيقي
!الذي أردتنا أن نتوصل إليه

300
00:21:55,390 --> 00:21:57,950
...كيميهيكو، ما الذي تنوي

301
00:21:58,300 --> 00:22:00,050
.أصغي إليّ يا سييستا

302
00:22:01,650 --> 00:22:03,660
!لن أستسلم بشأنك

303
00:22:04,430 --> 00:22:07,460
،حتّى لو كنتِ راضية بهذه النهاية

304
00:22:08,290 --> 00:22:10,490
!لن أقبلها أبدًا

305
00:22:11,550 --> 00:22:15,260
.ربّما لن يفهم أحد ذلك

306
00:22:15,260 --> 00:22:18,440
!لا ناتسوناغي، ولا سايكاوا، ولا شارلوت

307
00:22:19,210 --> 00:22:23,790
!وربّما ما أنويه يخالف قوانين هذا العالم

308
00:22:24,200 --> 00:22:29,470
!لكنّني سأعيدكِ يومًا ما

309
00:22:29,470 --> 00:22:32,100
!أعدك... أعدكِ أنّني سأفعل

310
00:22:38,840 --> 00:22:41,210
.أنت أحمق يا كيميزوكا

311
00:22:43,320 --> 00:22:45,970
.أنت أحمق يا كيميزوكا

312
00:22:46,540 --> 00:22:50,560
.أنت أحمق يا كيميزوكا

313
00:22:58,510 --> 00:23:01,120
هل أنتم جميعًا حمقى؟

314
00:23:09,280 --> 00:23:11,420
.أشرقت الشمس

315
00:23:12,250 --> 00:23:13,490
.نعم

316
00:23:13,490 --> 00:23:14,680
.من هنا تبدأ

317
00:23:16,110 --> 00:23:18,920
ماتت المحققة بالفعل؟

318
00:23:21,320 --> 00:23:22,270
...لا

319
00:23:22,650 --> 00:23:26,730
...هذه قصّة طويلة جدًا

320
00:23:27,260 --> 00:23:31,480
!عن الطريقة التي سأعيدها بها

321
00:23:34,980 --> 00:23:39,980
الحلقة 6

322
00:23:34,980 --> 00:23:39,980
حارس العالم