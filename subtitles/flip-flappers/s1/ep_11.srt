!أردت إخبارك عن المدرسة وأصدقائي

230
00:18:49,200 --> 00:18:51,380
!أردت نصيحتك لمستقبلي

231
00:18:51,380 --> 00:18:53,290
...و... و

232
00:18:55,190 --> 00:18:56,690
.كلّ شيء بخير الآن

233
00:18:56,690 --> 00:18:58,720
.ليس عليك القلق على شيء بعد الآن

234
00:18:59,560 --> 00:19:00,480
...أمّي

235
00:19:01,840 --> 00:19:04,120
.سأفعل كلّ شيء من أجلك

236
00:19:11,030 --> 00:19:12,890
!سولت

237
00:19:24,140 --> 00:19:25,350
.أكرهك

238
00:19:33,650 --> 00:19:35,080
.شعرك جميل

239
00:19:35,080 --> 00:19:37,110
لِمَ لا تجعلينه يطول مثلي؟

240
00:19:37,840 --> 00:19:39,260
.لن يلائمني

241
00:19:39,260 --> 00:19:40,960
.طبعًا سيلائمك

242
00:19:41,950 --> 00:19:42,770
أترين؟

243
00:19:43,640 --> 00:19:44,580
...ولكن

244
00:19:47,430 --> 00:19:49,110
.إنّه يلائمك كما توقّعت

245
00:19:49,470 --> 00:19:50,560
.أعيديه

246
00:19:50,960 --> 00:19:53,410
.لا. تبدين ظريفة للغاية هكذا

247
00:19:54,390 --> 00:19:56,460
.سيسخر أصدقائي منّي

248
00:19:56,460 --> 00:19:57,510
ماذا؟

249
00:19:57,510 --> 00:20:00,110
.إنّهم غير جديرين بك إذًا

250
00:20:00,500 --> 00:20:03,580
.سأجهّز أصدقاءً جددًا لك

251
00:20:07,340 --> 00:20:08,240
.تعالي

252
00:20:12,330 --> 00:20:14,000
.لا أحبّ هذا المكان

253
00:20:19,740 --> 00:20:22,210
.لا تقلقي حيال شيء

254
00:20:22,210 --> 00:20:26,200
.سأصنع أيّ عالمٍ تريدينه

255
00:20:27,220 --> 00:20:29,320
.كلّ ما أحتاجه هو وجودك بجانبي

256
00:20:32,960 --> 00:20:34,120
هل تحبّين هذا المكان؟

257
00:20:34,700 --> 00:20:36,640
.لنبقى هنا إذًا

258
00:20:37,520 --> 00:20:39,840
.نعم يا أمّي

259
00:20:40,770 --> 00:20:42,840
الكثير غائبون اليوم، أليس كذلك؟

260
00:20:43,010 --> 00:20:46,320
.بالتّفكير بالأمر، من غير المعتاد أن تغيب كوكونا

261
00:20:46,320 --> 00:20:48,850
.نعم. ربّما سينزل الثّلج تاليًا

262
00:20:51,540 --> 00:20:52,590
.مستحيل

263
00:21:06,760 --> 00:21:08,640
ما هذا؟

264
00:21:12,520 --> 00:21:13,850
!سولت-سان

265
00:21:19,160 --> 00:21:20,710
.علينا الحديث

266
00:21:24,340 --> 00:21:26,440
.تبدين محبطةً جدًّا

267
00:21:27,440 --> 00:21:28,570
ياياكا؟

268
00:21:28,570 --> 00:21:29,510
لماذا؟

269
00:21:30,070 --> 00:21:31,990
.لستُ هنا لأنّي أريد

270
00:21:35,010 --> 00:21:36,110
أمورفوس؟

271
00:21:36,520 --> 00:21:38,420
.أنقذي بابيكا

272
00:21:38,760 --> 00:21:40,240
!لا تعبث معي

273
00:21:40,240 --> 00:21:41,620
—لِمَ قد

274
00:21:46,960 --> 00:21:47,910
!أرجوك

275
00:21:51,220 --> 00:21:53,650
هل ستظلّين محبطة إلى الأبد؟

276
00:21:54,750 --> 00:21:55,650
...ولكن

277
00:21:59,510 --> 00:22:00,170
—ما

278
00:22:00,170 --> 00:22:01,360
!اصمتي

279
00:22:02,130 --> 00:22:04,960
!إنّي أسألك ما إذا كنتِ تريدين إنقاذ كوكونا

280
00:22:06,150 --> 00:22:07,110
...هذا

281
00:22:07,110 --> 00:22:10,200
.اسمعي، أنا أريد إنقاذ كوكونا

282
00:22:10,200 --> 00:22:12,980
!لا يهمّني إن كنّا سنواجه والدتها أو أيّا كان

283
00:22:15,020 --> 00:22:16,690
!سأنقذها لأنّها صديقتي

284
00:22:17,130 --> 00:22:18,400
ماذا عنك؟

285
00:22:19,520 --> 00:22:20,830
...أنا

286
00:22:22,020 --> 00:22:22,740
.تبًّا

287
00:22:26,870 --> 00:22:28,590
الخيال المطلق؟

288
00:22:28,590 --> 00:22:30,670
أوّل واحد ذهبت إليه مع كوكونا؟

289
00:22:30,980 --> 00:22:31,650
.اصعدي

290
00:22:31,940 --> 00:22:32,940
.المكان ليس آمنّا هنا

291
00:22:38,990 --> 00:22:42,150
!أخيرًا، حان وقت التّحرّر

292
00:22:50,710 --> 00:22:53,100
.لا يمكننا الهرب إلى الأبد

293
00:22:54,560 --> 00:22:55,890
ما الّذي سنفعله؟

294
00:22:58,860 --> 00:23:00,180
.أنتِ محقّة

295
00:23:00,580 --> 00:23:02,420
—سيكون العالم في خطر إن استمر هذا

296
00:23:02,420 --> 00:23:03,420
!كلاّ

297
00:23:04,870 --> 00:23:07,570
!لا أريد سماع هذا الهراء غير المعتاد

298
00:23:07,570 --> 00:23:09,570
!هذه ليست أنتِ

299
00:23:10,270 --> 00:23:11,650
...أنا

300
00:23:13,050 --> 00:23:15,940
!أريد إنقاذ كوكونا لأنّني أحبّها جدًّا، جدًّا، جدًّا

301
00:23:16,080 --> 00:23:16,840
!حسنًا

302
00:23:16,840 --> 00:23:17,770
!سنصطدم بهم مباشرة

303
00:23:18,190 --> 00:23:19,760
!بلا تدريب

304
00:23:19,760 --> 00:23:20,450
!حسنًا

305
00:23:22,390 --> 00:23:25,830
!هيّا

306
00:23:30,180 --> 00:23:31,940
.لديك مستقبل باهر

307
00:23:31,940 --> 00:23:32,740
.أنا نيونيو

308
00:23:32,740 --> 00:23:33,570
أنتِ نيونيو؟

309
00:23:33,570 --> 00:23:35,510
!تبيع نيو الأصداف على السّاحل-نيو

310
00:23:35,510 --> 00:23:37,290
—تبيع نيو الأصداف على نيا نيو

311
00:23:37,290 --> 00:23:39,060
!نيو هذا