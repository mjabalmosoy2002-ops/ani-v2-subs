1
00:00:04,100 --> 00:00:05,440
!إنّها جوغيونغ

2
00:00:06,060 --> 00:00:07,400
هل رأيتِ المنشور؟

3
00:00:07,970 --> 00:00:10,240
سوهو وسوجين يتواعدان؟

4
00:00:10,780 --> 00:00:12,860
!ظننتُه يحبّ جوغيونغ

5
00:00:13,640 --> 00:00:14,900
هل هجرها؟

6
00:00:14,900 --> 00:00:16,560
بسبب كلّ تلك الإشاعات؟

7
00:00:28,440 --> 00:00:29,780
...سوهو

8
00:00:31,080 --> 00:00:32,080
...أنت

9
00:00:33,380 --> 00:00:34,220
...هل أنت

10
00:00:33,860 --> 00:00:34,980
!سوهو

11
00:00:38,220 --> 00:00:39,440
هل انتظرتني؟

12
00:00:42,360 --> 00:00:43,270
جوغيونغ ليم

13
00:00:43,680 --> 00:00:44,700
هل يمكننا التكلّم؟

14
00:00:49,320 --> 00:00:50,140
!أنتِ

15
00:00:50,140 --> 00:00:53,120
أخبرتِ الجميع بأنّ سوجين سرق
ملابسك، صحيح؟

16
00:00:53,120 --> 00:00:56,140
ثمّ طلبتِ من تشايرين
!وسويا إحداث جلبة

17
00:00:56,140 --> 00:00:58,720
أتغضبين بعد خسارة مهمّة؟

18
00:00:58,720 --> 00:01:01,720
!أنتِ السّبب إذا لُوِّثت سمعتنا أيضاً

19
00:01:01,720 --> 00:01:04,140
ما-ماذا تقصدين؟

20
00:01:04,140 --> 00:01:06,380
لماذا تدّعين البراءة؟

21
00:01:06,380 --> 00:01:10,900
تتصرّفين ببراءة في المدرسة، لكن
!تِلك الإشاعات هي شيء آخر

22
00:01:10,900 --> 00:01:15,140
استخدمتِ صِغار الفنون أولئك كخدَم
!بينما لا تهتمّين سوى لصورتكِ

23
00:01:15,280 --> 00:01:17,140
!ماذا؟ الأمر ليس كذلك

24
00:01:17,140 --> 00:01:18,770
!بل هو كذلك

25
00:01:34,240 --> 00:01:35,140
!أنتِ

26
00:01:44,680 --> 00:01:46,180
وفيتُ بوعدي

27
00:01:46,180 --> 00:01:47,820
والآن دعي جوغيونغ وشأنها

28
00:01:52,940 --> 00:01:55,780
أعي ذلك. اِلعب دورك كما ينبغي فحسب

29
00:01:55,780 --> 00:01:57,430
فأنت حبيبي في نهاية المطاف

30
00:01:57,900 --> 00:02:00,140
فقط حتّى تنتهي انتخابات الإلَهة

31
00:02:12,340 --> 00:02:13,680
!سيوجون هان

32
00:02:16,400 --> 00:02:17,930
ماذا تُرِدن؟

33
00:02:18,400 --> 00:02:20,000
هل تعرف شيئاً؟

34
00:02:20,000 --> 00:02:22,160
ما مشكلة سوهو وسوجين فجأة؟

35
00:02:22,160 --> 00:02:24,520
!جوغيونغ لم تأتِ إلى المدرسة حّى

36
00:02:24,940 --> 00:02:27,520
لم تفعل شيئاً لها، صحيح؟

37
00:02:27,520 --> 00:02:28,760
!ما-ماذا؟

38
00:02:29,940 --> 00:02:30,930
جوغيونغ

39
00:02:30,930 --> 00:02:31,760
...أنا

40
00:02:33,520 --> 00:02:34,620
أحبّك

41
00:02:35,970 --> 00:02:37,440
،أحبّك

42
00:02:38,020 --> 00:02:38,880
يا جوغيونغ

43
00:02:41,100 --> 00:02:41,980
...أنا

44
00:02:44,080 --> 00:02:45,820
!دعني وشأني

45
00:02:49,900 --> 00:02:52,480
لـ-لماذا تسألنَني؟

46
00:02:52,480 --> 00:02:53,960
!اذهبنَ واسألنَ سوهو

47
00:02:53,960 --> 00:02:57,720
!فشلنا في الوصول إلى سوهو وجوغيونغ

48
00:02:59,120 --> 00:03:00,960
إنّها بخير، صحيح؟

49
00:04:56,770 --> 00:05:00,430
أوّلاً، التّلميذة المنتقلة حديثاً في ثانويّة
سيبوم أصبحت إلَهة مُحتمَلة

50
00:05:00,430 --> 00:05:04,640
بفضل صورتها البريئة، ارتقت روز
للشّهرة عبر مواقع التّواصل الاجتماعيّ

51
00:05:04,880 --> 00:05:10,500
لكن بخلاف شخصيّتها عبر الإنترنت، تبيّن
!بأنّها حثالة حقيقيّة في الواقع

52
00:05:10,500 --> 00:05:12,770
!ضحيّة عقدة نقص

53
00:05:12,770 --> 00:05:15,220
أساءت لفظيّاً لزميلتها المُرشّحة
سوجين كانغ

54
00:05:15,220 --> 00:05:17,480
ووصلت لدرجة هدّدتها

55
00:05:17,770 --> 00:05:23,220
،بعد الفشل في مهمّة تلبيق الملابس المدرسيّة
خسارة في المهمّة الثّانية

56
00:05:23,220 --> 00:05:25,680
وسبّبت جلبة في قسم التّمثيل

57
00:05:25,680 --> 00:05:29,930
بدلاً من صورتها النّقيّة، انكشف
!جانبها العدوانيّ والخشن

58
00:05:29,930 --> 00:05:35,180
بالإضافة إلى ذلك، نشرتْ صوراً لها ولإله
سيبوم سوهو لي عبر مواقع التّواصل

59
00:05:35,180 --> 00:05:40,080
وأوهمت الجميع بأنّها كانت
!بداية حبّ جديد

60
00:05:40,140 --> 00:05:44,340
لكن كشف سوهو لي فجأة علاقته
بسوجين كانغ بدلاً من ذلك

61
00:05:44,780 --> 00:05:47,770
!وكان حتّى يتجاهل جوغيونغ ليم

62
00:05:48,580 --> 00:05:54,080
قيل حتّى بأنّ سوهو تخلّى عنها بعد
اكتشاف طبيعتها الحقيقيّة

63
00:05:54,800 --> 00:05:58,520
!واختفى جوغيونغ دون قول أي كلمة؟

64
00:06:00,340 --> 00:06:02,340
إلى أين ذهبتْ خادمتاها؟

65
00:06:01,900 --> 00:06:03,240
سوا كانغ وتشارين آن؟

66
00:06:02,940 --> 00:06:04,880
!مهووسات الفنون أولئك

67
00:06:04,340 --> 00:06:06,780
خادمات بقناع صديقات

68
00:06:08,220 --> 00:06:11,020
عرفتُ من البداية

69
00:06:12,080 --> 00:06:16,300
إذا عملتُ بجدّ، ستحدث لي
مزيد من الأمور السيّئة

70
00:06:17,160 --> 00:06:19,340
ما الّذي فعلتُه؟

71
00:06:20,480 --> 00:06:22,460
أنا فقط

72
00:06:22,460 --> 00:06:24,890
أردتُ أن أعيش حياة مدرسيّة عاديّة

73
00:06:26,220 --> 00:06:29,080
...بسببي، حتّى سويا وتشايرين

74
00:06:37,240 --> 00:06:38,940
!افتحي الباب يا جوغيونغ

75
00:06:38,940 --> 00:06:40,770
!نعلم بأنّكِ هنا

76
00:06:41,440 --> 00:06:42,700
!جو-جو

77
00:06:43,460 --> 00:06:46,840
!لماذا تجاهلتِ مُكالماتنا؟ نحن قلقتان

78
00:06:47,860 --> 00:06:49,080
!أنا آسفة

79
00:06:49,840 --> 00:06:52,060
لماذا تريدين الاستسلام؟

80
00:06:52,060 --> 00:06:54,680
!افتحي الباب فحسب. سنساعدكِ

81
00:06:55,660 --> 00:06:57,180
انتهى الأمر

82
00:06:58,020 --> 00:07:01,020
سوف أعتزل في نهاية المطاف

83
00:07:01,020 --> 00:07:01,900
ماذا؟

84
00:07:01,900 --> 00:07:06,040
إذا اعتزلتِ، فالجميع سيقول
!بأنّ تلك الإشاعات صحيحة

85
00:07:06,040 --> 00:07:09,220
!أجل! هذا ما تريده سوجين بالضّبط

86
00:07:09,740 --> 00:07:11,020
...لكن تعلمان

87
00:07:11,480 --> 00:07:15,160
بأنّني لستُ مُلائمة لأكون إلَهة

88
00:07:15,160 --> 00:07:18,100
سأتوارى عن الأنظار حتّى يهدأ الوضع

89
00:07:18,920 --> 00:07:20,960
...لـ-لكن معاً، ما زال بإمكاننا

90
00:07:20,960 --> 00:07:24,160
!بسببي، نلتُما الكراهية أيضاً

91
00:07:27,040 --> 00:07:29,970
لذا يجدر بكما أن تتظاهرا

92
00:07:29,970 --> 00:07:31,600
!بأنّكما لا تعرفانني أيضاً

93
00:07:31,600 --> 00:07:32,640
ما-ماذا؟

94
00:07:32,640 --> 00:07:34,940
هل أنتِ جادّة؟

95
00:07:36,080 --> 00:07:37,440
!أ-أجل

96
00:07:37,440 --> 00:07:39,500
يجدر بكما

97
00:07:40,340 --> 00:07:41,810
أن تتركاني لوحدي

98
00:07:51,720 --> 00:07:52,960
أجل

99
00:07:52,960 --> 00:07:54,310
هكذا أفضل

100
00:07:55,380 --> 00:07:58,260
لم أتوقّع شيئاً من الأساس

101
00:08:00,320 --> 00:08:02,660
!جوغيونغ ليم، أيّتها الغبيّة

102
00:08:04,300 --> 00:08:07,000
ماذا تقصدين بـ"التّواري عن الأنظار"؟

103
00:08:07,000 --> 00:08:09,080
هل ظننتِ بأنّكِ إذا تذمّرتِ
،بما يكفي، فسوف نقول

104
00:08:09,080 --> 00:08:12,220
"!حسناً، لنقطع العلاقة بيننا فحسب"

105
00:08:12,520 --> 00:08:15,310
!هل خلتِ ذلك حقّاً؟! أيّتها الطّفلة الحمقاء

106
00:08:15,660 --> 00:08:16,780
ماذا؟

107
00:08:16,780 --> 00:08:20,040
...تعرّضتُما لإساءة بسببي، لماذا أنتما

108
00:08:20,040 --> 00:08:22,770
!لا يوجد سبب! لا يوجد سبب يا حمقاء

109
00:08:23,060 --> 00:08:27,020
إذا اختبأتِ بسبب بعض الجهَلة
،الّذين يكتبون تعليقات كراهية

110
00:08:27,020 --> 00:08:29,960
فماذا سيحدث لنا نحن مَن ندعمكِ؟

111
00:08:30,720 --> 00:08:32,900
لا تنفكّين تسألين

112
00:08:34,300 --> 00:08:36,270
!لكن لا يوجد سبب

113
00:08:38,620 --> 00:08:41,810
لا يحتاج النّاس لسببٍ كي يحبّوا شخصاً

114
00:08:41,810 --> 00:08:44,880
يستطيع النّاس أن يحبّوكِ
حتّى من دون سبب مُحدّد

115
00:08:45,420 --> 00:08:47,430
حتّى لو لم تكوني مُميّزة

116
00:08:48,100 --> 00:08:52,560
لم أفكّر في هذا من قبل

117
00:08:53,240 --> 00:08:55,440
،حتّى إن لم أكن جميلة

118
00:08:56,560 --> 00:08:59,040
،وحتّى إن لم أكن مُميّزة

119
00:08:59,040 --> 00:09:00,560
...ربّما

120
00:09:01,140 --> 00:09:05,680
قد يستطيع شخصٌ ومن دون سبب

121
00:09:05,680 --> 00:09:08,100
!أن يحبّني

122
00:09:14,400 --> 00:09:19,270
الإلَهة الحاليّة سوجين والتّلميذة المُنتقِلة
جوغيونغ كلّ واحدة منهما ربحتْ مهمّة

123
00:09:19,270 --> 00:09:21,680
!والنّتيجة مُتقاربة من حيث الإعجابات

124
00:09:22,380 --> 00:09:25,980
المهمّة التّالية ستحدّد من هي
!الإلَهة الجديدة

125
00:09:26,640 --> 00:09:31,220
أنا أرتجف! سيتمّ اختيار الإلَهة
!الجديدة أخيراً

126
00:09:32,000 --> 00:09:33,160
،قريباً جدّاً

127
00:09:33,800 --> 00:09:37,460
!داخل استديو سيبوم، ستُقام المهمّة الأخيرة

128
00:09:37,460 --> 00:09:40,280
!على شكل بثّ حيّ

129
00:09:48,320 --> 00:09:53,120
مهمّة حيث يترتّب عليهما جمع أصوات
!من مُتابعينهما على الهواء

130
00:09:53,760 --> 00:09:55,220
!هذا مُتلِف للأعصاب حقّاً

131
00:09:56,120 --> 00:09:58,960
الميزة الخاصّة في هذه المهمّة هي

132
00:09:59,580 --> 00:10:01,460
!فُرصة احتكار البثّ

133
00:10:02,720 --> 00:10:08,840
فُرصة لعرقلة بثّ المُنافِس والاستيلاء
!على البثّ لمدّة 5 دقائق

134
00:10:08,840 --> 00:10:13,220
!طريقة مُمتازة لخطف المُتابعين

135
00:10:13,220 --> 00:10:17,340
بما أنّ جوغيونغ ليم كانت صامتة
،بشأن الجدل الحاصل مؤخّراً

136
00:10:17,340 --> 00:10:22,580
النّاس يراودهم الفضول بشأن ما لديها
!من قول أثناء البثّ

137
00:10:23,780 --> 00:10:26,340
سيجري هنا، صحيح؟

138
00:10:26,780 --> 00:10:28,680
لكن لا أثر لجوغيونغ ليم

139
00:10:32,220 --> 00:10:33,620
!سيبدأ

140
00:10:34,180 --> 00:10:37,810
!مرحباً! معكم إلَهة الجميع، سوجين

141
00:10:39,020 --> 00:10:42,420
مذهل! هناك الكثير منكم يتابعونني من الآن؟

142
00:10:42,420 --> 00:10:45,100
،إذا ربحتُ في انتخابات هذا العام ثانية

143
00:10:45,100 --> 00:10:47,810
فقد أبدأ بالظّهور على الهواء
عدّة مرّات لاحقاً، ما رأيكم؟

144
00:10:49,020 --> 00:10:52,460
سيكون من الرّائع أن نكثِّف
لقاءاتنا هكذا، صحيح؟

145
00:10:52,460 --> 00:10:55,420
!لذا لا تنسوا التّصويت لي

146
00:10:55,420 --> 00:10:57,930
!لأجل إلَهة سيبوم، سوجين كانغ

147
00:11:05,700 --> 00:11:08,400
يا إلهي، المُرشّحة الأخرى اختفتْ؟

148
00:11:08,400 --> 00:11:09,810
!كم هذا مُملّ

149
00:11:10,180 --> 00:11:11,800
هل استسلمت حقّاً؟

150
00:11:11,800 --> 00:11:12,860
هذا مُملّ

151
00:11:12,860 --> 00:11:13,580
ماذا الآن؟

152
00:11:13,580 --> 00:11:14,560
حسناً، لا تُلام

153
00:11:14,560 --> 00:11:15,380
سخيفة

154
00:11:15,380 --> 00:11:16,310
لماذا انسحبتْ؟

155
00:11:16,600 --> 00:11:19,440
،أتسألون عن السّبب؟ لأنّها مُحرَجة

156
00:11:19,440 --> 00:11:21,140
بما أنّ طبيعتها الحقيقيّة قد فُضِحت

157
00:11:21,810 --> 00:11:24,220
يقشعرّ بدني حقّاً

158
00:11:24,220 --> 00:11:26,400
أي إلَهة تفعل ذلك بالضّبط؟

159
00:11:26,400 --> 00:11:30,560
،ليتها ظلّتْ مُختبئة هكذا من البداية

160
00:11:30,560 --> 00:11:32,340
بدلاً من العبث معي

161
00:11:32,340 --> 00:11:33,520
أهذا صحيح؟

162
00:11:32,960 --> 00:11:34,340
هل السّبب هو تلك الإشاعات؟

163
00:11:34,340 --> 00:11:35,300
مئة بالمئة لول

164
00:11:35,000 --> 00:11:36,140
!قلتُ لكم هذا مُزيّف

165
00:11:35,700 --> 00:11:36,940
يبدو أنّ هذا صحيح

166
00:11:36,940 --> 00:11:37,720
مُخيِّب للآمال

167
00:11:37,440 --> 00:11:38,700
تختبئ خجلاً

168
00:11:38,100 --> 00:11:39,340
براءة مُزيّفة

169
00:11:38,800 --> 00:11:40,560
لكن كنتُ لأفعل المثل

170
00:11:52,020 --> 00:11:53,540
!أرجو القيادة بشكل أسرع

171
00:11:54,220 --> 00:11:55,020
،جوغيونغ

172
00:11:55,460 --> 00:11:56,740
يمكنكِ فعلها، صحيح؟

173
00:11:58,220 --> 00:12:00,390
!ستكونين بخير، التزمي بالخطّة فحسب

174
00:12:00,980 --> 00:12:02,540
تثقين بنا، صحيح؟

175
00:12:05,820 --> 00:12:06,930
!سوجين كانغ

176
00:12:06,930 --> 00:12:08,620
!معكِ حقّ

177
00:12:08,620 --> 00:12:10,760
أيّ إلَهة تتصرّف بهذه الطّريقة؟

178
00:12:10,760 --> 00:12:13,680
لستُ خياراً جيّداً كما تعلمين

179
00:12:13,680 --> 00:12:17,430
منذ البداية وأنا أعلم بأنّني
لا ينبغي أن أنافِس

180
00:12:17,660 --> 00:12:21,520
،بصراحة، حتّى اليوم، وأمام الجميع

181
00:12:21,520 --> 00:12:23,680
!أردتُ أن أختبئ فحسب

182
00:12:23,680 --> 00:12:24,740
...لكن

183
00:12:25,700 --> 00:12:29,430
!أخبرتكِ، صحيح؟ سأقاتل حتّى النّهاية

184
00:12:29,820 --> 00:12:31,700
يراودكم فضول، أليس كذلك؟

185
00:12:31,700 --> 00:12:33,560
بشأن من يكذب

186
00:12:35,640 --> 00:12:36,520
!بئساً

187
00:12:36,520 --> 00:12:37,200
ما الأمر؟

188
00:12:37,200 --> 00:12:38,420
لِمَ إحداث جلبة؟

189
00:12:37,940 --> 00:12:39,620
الإشاعات مُزيّفة؟

190
00:12:39,120 --> 00:12:40,320
!اشرحي من فضلكِ

191
00:12:40,960 --> 00:12:42,100
هذا الحِزام

192
00:12:42,100 --> 00:12:45,340
يُشبه تماماً الّذي ارتدته
سوجين في المهمّة، صحيح؟

193
00:12:45,600 --> 00:12:49,600
فقدتُ الملابس الّتي حضّرتُها
قبل فترة قصيرة من المهمّة

194
00:12:49,600 --> 00:12:53,340
!بدتْ ملابس سوجين تشبه ملابسي تماماً

195
00:12:53,340 --> 00:12:56,540
!وصنعتُ الحزام بنفسي

196
00:12:56,540 --> 00:12:59,600
آنذاك كنتُ خائفة جدّاً من الاعتراف
!بذلك، لكنّها الحقيقة

197
00:12:59,880 --> 00:13:01,600
!سوجين كانغ سرقَتْ ملابسي

198
00:13:01,900 --> 00:13:02,520
!ماذا؟

199
00:13:02,520 --> 00:13:03,500
ماذا يعني هذا؟

200
00:13:03,500 --> 00:13:04,140
بجدّية؟

201
00:13:04,140 --> 00:13:05,920
سوجين سرقت ملابس جوغيونغ؟

202
00:13:05,920 --> 00:13:06,860
سرقتها؟

203
00:13:06,860 --> 00:13:07,820
!حرب الحقيقة

204
00:13:07,820 --> 00:13:09,240
ألم يتشاجرا مؤخّراً؟

205
00:13:09,240 --> 00:13:09,900
هذا هو السّبب إذاً

206
00:13:09,900 --> 00:13:10,680
كان ذلك صحيحاً إذاً؟

207
00:13:13,380 --> 00:13:15,040
!إنّه نفسه تماماً

208
00:13:15,040 --> 00:13:16,760
إذاً سوجين سرقته؟

209
00:13:16,760 --> 00:13:18,900
!مستحيل

210
00:13:18,900 --> 00:13:21,680
!جوغيونغ نشرت هذه الصّورة قبل المهمّة

211
00:13:21,680 --> 00:13:22,520
مذهل... كُشِفَ أمرها

212
00:13:22,520 --> 00:13:23,660
أشعر بصدمة حقيقيّة

213
00:13:23,660 --> 00:13:25,080
هل هي مستعدّة للتّمادي هكذا؟

214
00:13:25,080 --> 00:13:26,980
لكن ما زالت تنكر ذلك

215
00:13:26,440 --> 00:13:28,440
هل لا يزال هذا جزءاً من مكيدة سوجين؟

216
00:13:28,440 --> 00:13:29,600
ماذا عن الإشاعات الأخرى؟

217
00:13:32,320 --> 00:13:35,080
!لماذا تصدِّقون شيئاً كهذا؟

218
00:13:35,080 --> 00:13:38,040
!هذه الإشاعات لا أساس لها من الصحّة
!كلّها مُلفَّقة

219
00:13:38,040 --> 00:13:41,280
...والنّاس ينعتون صديقاتي بالخادِمات الآن

220
00:13:42,440 --> 00:13:44,520
!هذا ليس عدلاً

221
00:13:44,520 --> 00:13:48,600
كلّ هذه الإشاعات الغريبة لُفِّقَتْ
!ونُشِرت بواسطة سوجين كانغ

222
00:13:54,800 --> 00:13:56,100
ستكون بخير، صحيح؟

223
00:13:56,100 --> 00:13:58,360
أجل، إذا سار كلّ شيء وفق خطّتنا

224
00:14:07,160 --> 00:14:10,680
جوغيونغ، هل أنتِ مُصابة بجنون العظمة؟

225
00:14:11,280 --> 00:14:15,180
كفّي عن خِداع الآخرين بتمثيلكِ البريء

226
00:14:15,180 --> 00:14:21,680
قبل كلّ شيء، هل تعتقدين أنّه من المناسب
الإصرار على أنّني سرقتُ لباسكِ فقط لأنّه مشابه؟

227
00:14:22,200 --> 00:14:25,640
والآن تغضبين لأنّني مع سوهو لي

228
00:14:25,640 --> 00:14:28,140
هل فقدتْ صوابها؟ ما الّذي تقولها؟

229
00:14:28,140 --> 00:14:30,540
لم يكن لديّ مانع أن تكون راغبة
في أن تصبح صديقته

230
00:14:30,540 --> 00:14:34,280
لكن بعدها غازلتْ سوهو بل حتّى سيوجون هان

231
00:14:34,280 --> 00:14:38,140
لم أعد أحتمل بصراحة. لهذا ألغى
!سوهو صداقته معها أيضاً

232
00:14:38,360 --> 00:14:42,700
وهناك هذه الإشاعة الّتي تُفيد بأنّ جوغيونغ
تحبّ التردّد على الحانات لإغواء الرّجال

233
00:14:42,700 --> 00:14:44,560
!إنّها صحيحة تماماً

234
00:14:46,600 --> 00:14:48,100
!رأيتُ ذلك

235
00:14:50,720 --> 00:14:51,480
!يا إلهي

236
00:14:51,970 --> 00:14:52,970
حقّاً؟

237
00:14:52,660 --> 00:14:53,760
!تبدو حقيقيّة

238
00:14:59,560 --> 00:15:01,000
،لذا من فضلكِ

239
00:15:02,470 --> 00:15:04,320
،الزمي حدودكِ

240
00:15:04,820 --> 00:15:06,810
يا وجه الفطيرة

241
00:15:39,500 --> 00:15:41,300
جوغيونغ، أين أنتِ الآن؟

242
00:15:41,300 --> 00:15:43,300
في دورة المياه في الطّابق الرّابع

243
00:15:43,300 --> 00:15:45,460
حسناً، أنا قادمة إليكِ

244
00:15:47,760 --> 00:15:49,960
يا وجه الفطيرة

245
00:15:54,200 --> 00:15:55,400
!تشايرين

246
00:15:57,720 --> 00:16:00,140
كنّا نحن من ندعوكِ

247
00:16:00,140 --> 00:16:02,100
والآن يحصل العكس؟

248
00:16:02,560 --> 00:16:04,200
،لم أركِ منذ وقت طويل

249
00:16:04,200 --> 00:16:06,970
يا وجه الفطيرة