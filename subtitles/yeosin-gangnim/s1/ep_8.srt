1
00:00:12,380 --> 00:00:13,640
!سوجين كانغ

2
00:00:14,200 --> 00:00:16,930
ماذا اشتريتِ هذه المرّة أيّتها الشّقيّة؟

3
00:00:16,930 --> 00:00:19,120
!كلّ ما تعرفينه هو التسوُّق

4
00:00:19,520 --> 00:00:21,500
!أتعتقدين بأنّ هذا طبيعيّ فعلاً؟

5
00:00:21,500 --> 00:00:22,930
!اصمتي

6
00:00:23,160 --> 00:00:25,680
يحقُّ لي صرف المال الّذي أكسبه
!كيفما أشاء

7
00:00:26,240 --> 00:00:28,560
لِمَ لا نملك مالاً من الأساس؟

8
00:00:28,560 --> 00:00:31,460
!لأنّكِ تسرفين في الشّرب يومياً

9
00:00:33,480 --> 00:00:35,220
ماذا قلتِ؟

10
00:00:35,220 --> 00:00:36,860
!أيّتها السّاقطة اللّعينة

11
00:00:48,020 --> 00:00:50,740
سئمتُ من ذلك

12
00:00:50,740 --> 00:00:53,810
لهذا أبي لا يعود

13
00:00:55,480 --> 00:00:57,160
ماذا قلتِ؟

14
00:00:57,160 --> 00:00:59,350
!اخرجي! افتحي الباب

15
00:01:00,260 --> 00:01:01,260
!افتحي الباب

16
00:01:17,640 --> 00:01:18,740
سوجين كانغ

17
00:01:25,480 --> 00:01:27,000
ابقي هنا لبعض الوقت

18
00:01:32,080 --> 00:01:34,040
هل شَرِبَتْ أمّكِ ثانية؟

19
00:01:35,220 --> 00:01:36,080
أجل

20
00:01:41,390 --> 00:01:44,390
حريّ بكِ أن تبقي في منزل صديقة اللّيلة

21
00:01:45,180 --> 00:01:47,390
هل يمكنني البقاء معك؟

22
00:01:53,890 --> 00:01:56,200
!ابقَ معي فترة أطول قليلاً فحسب

23
00:01:56,740 --> 00:01:58,620
ليس لديّ إلّا أنت

24
00:01:58,620 --> 00:02:00,280
لا يهتمّ بي سواك

25
00:02:02,540 --> 00:02:04,920
!جوغيونغ ليم، سترى

26
00:02:14,660 --> 00:02:17,430
سوهو لي وسوجين كانغ؟

27
00:02:26,840 --> 00:02:28,600
مـ-مهمّة؟

28
00:02:37,580 --> 00:02:38,760
إذاً سوهو

29
00:02:39,300 --> 00:02:42,200
يجمعه شيء بينه وبين سوجين

30
00:02:43,240 --> 00:02:46,470
...إذاً مُلاطفته لي كانت فقط

31
00:02:46,700 --> 00:02:50,140
اسمعي، كان لطيفاً معكِ من باب الشّفقة فقط

32
00:02:51,040 --> 00:02:53,300
!كفّي عن الكذب على نفسكِ يا جوغيونغ

33
00:02:54,840 --> 00:02:56,930
ماذا توقّعتِ؟

34
00:02:57,120 --> 00:03:00,060
!جوغيونغ! وضعتُ طردكِ على مقعدكِ

35
00:03:12,740 --> 00:03:16,850
حضّرنا لكِ زيّاً رسميّاً. لبّقيه كيفما تشائين

36
00:03:17,180 --> 00:03:20,300
!نتطلّع قُدماً للنّتائج أيّتها المُرشّحة الإلَهة

37
00:05:18,020 --> 00:05:20,580
!المُرشّحتان الإلَهتان

38
00:05:20,200 --> 00:05:21,440
!جميلتان للغاية

39
00:05:21,440 --> 00:05:22,960
!لنلتقط صورة

40
00:05:22,960 --> 00:05:24,620
!الجوّ مُلتهب من الآن

41
00:05:24,620 --> 00:05:26,160
!تشاجرتا في المرّة السّابقة؟

42
00:05:26,160 --> 00:05:28,280
!الإلَهة الجديدة ضدّ الإلَهة الأصليّة

43
00:05:28,280 --> 00:05:29,820
!مجرّد رؤيتهما تُفقِد الصّواب

44
00:05:34,740 --> 00:05:36,580
كيف سأتعامل مع الأمر هذه المرّة؟

45
00:05:36,580 --> 00:05:40,180
هل أبدو أخصّائية أزياء؟ في البداية
...يطلبون منّي الرّقص والآن

46
00:05:41,740 --> 00:05:42,920
!سـ-سوهو لي

47
00:05:44,040 --> 00:05:44,960
جوغيونغ ليم

48
00:05:47,360 --> 00:05:48,680
لنذهب ونتفرّج على فيلم

49
00:05:48,980 --> 00:05:50,080
ما-ماذا؟ اليوم؟

50
00:05:50,080 --> 00:05:50,820
أجل

51
00:05:50,820 --> 00:05:52,940
"صدر الموسم الثّاني من "شقّة وحش

52
00:05:52,940 --> 00:05:55,180
ألم تقولي بأنّ مُعجبي أفلام الرُّعب
ينبغي أن يُرافقوا بعضهم؟

53
00:05:55,180 --> 00:05:56,180
!لن أذهب

54
00:05:56,180 --> 00:05:57,220
لن تذهبي؟

55
00:05:58,180 --> 00:06:01,440
لـ-لا أستطيع. عليّ التّحضير للمهمّة التّالية

56
00:06:01,440 --> 00:06:02,680
!أنا مشغولة جدّاً

57
00:06:02,680 --> 00:06:03,840
عليّ الذّهاب

58
00:06:07,860 --> 00:06:11,430
ماذا الآن؟ لا أستطيع التصرّف
وكأنّ شيئاً لم يحدث

59
00:06:19,980 --> 00:06:20,640
!جوغيونغ ليم

60
00:06:30,860 --> 00:06:31,880
!جوغيونغ ليم

61
00:06:44,060 --> 00:06:45,040
!جوغيونغ ليم

62
00:06:50,100 --> 00:06:52,580
لِمَ أظلّ أهرب

63
00:06:52,580 --> 00:06:54,470
!مرحباً جوغيونغ

64
00:06:58,660 --> 00:07:00,470
غوون، ما هذا المكياج؟

65
00:07:00,470 --> 00:07:03,100
هذا؟ إنّه لون أحمر الشّفاه
الّذي اخترتِه لي

66
00:07:03,100 --> 00:07:05,380
!أستخدمه كلّ يوم مؤخّراً
ما رأيكِ؟

67
00:07:19,420 --> 00:07:21,270
نل نسيت غوون مفاتيحها ثانية؟

68
00:07:23,940 --> 00:07:25,940
!ما-ماذا تفعلين هنا؟

69
00:07:25,940 --> 00:07:27,270
لماذا أنتِ هنا ثانية؟

70
00:07:27,270 --> 00:07:29,850
أتيتُ لأعلّم غوون وضع المكياج

71
00:07:30,140 --> 00:07:32,900
،ستتأخّر في العودة من التّمرين
لذا طلبت منّي المجيء قبلها

72
00:07:32,900 --> 00:07:34,850
قالت بأنّك ستكون موجوداً

73
00:07:34,850 --> 00:07:37,850
بئساً، كان ينبغي أن تخبرني مسبقاً

74
00:07:37,850 --> 00:07:40,300
لماذا؟ هل رأيتَ شيئاً طريفاً؟

75
00:07:40,970 --> 00:07:43,620
!أتدخلين وتتواجدين بمفردكِ مع رجل؟

76
00:07:45,270 --> 00:07:46,280
انتظر لحظة

77
00:07:48,000 --> 00:07:49,640
مهلاً، ماذا تفعلين؟

78
00:07:49,640 --> 00:07:51,060
!لديك رمش فالِت

79
00:07:51,060 --> 00:07:53,220
بشرتك شاحبة. لاحظتُ ذلك فوراً

80
00:07:53,220 --> 00:07:54,600
اهدأ

81
00:07:55,540 --> 00:07:56,720
هل هي جادّة؟

82
00:08:00,140 --> 00:08:01,780
!مـ-مهلاً

83
00:08:01,780 --> 00:08:04,020
!لا يجوز أن تدخلي غرفة رجل هكذا فحسب

84
00:08:04,020 --> 00:08:07,020
ماذا لدينا هنا؟ رأيتُها من خلال
الباب المفتوح جزئيّاً

85
00:08:07,860 --> 00:08:11,020
في البداية، لم تكن تريدها، والآن
!تضعها في منتصف غرفتك

86
00:08:11,180 --> 00:08:13,640
!هذا يكفي! اخرجي

87
00:08:17,080 --> 00:08:20,310
لماذا؟ لنسترخِ قليلاً ريثما تعود غوون

88
00:08:20,310 --> 00:08:21,820
هل فقدتِ صوابكِ؟

89
00:08:21,820 --> 00:08:23,780
!تتدحرجين على سرير رجل

90
00:08:23,780 --> 00:08:25,660
!رجل، رجل، رجل

91
00:08:25,660 --> 00:08:28,660
أي رجل نتحدّث عنه هنا؟ لستَ رجلاً

92
00:08:28,660 --> 00:08:30,560
من المؤكّد أنّك لا تراني كامرأة أيضاً، صحيح؟

93
00:08:30,560 --> 00:08:32,220
مجرّد صديقين"، صحيح؟"

94
00:08:32,760 --> 00:08:33,640
أنتِ

95
00:08:33,840 --> 00:08:35,060
أتمزحين معي؟

96
00:08:35,400 --> 00:08:37,700
أنا رجل أيضاً

97
00:08:38,720 --> 00:08:40,320
...آ-آسفة

98
00:08:42,300 --> 00:08:43,600
!عادت غوون

99
00:08:46,140 --> 00:08:47,400
!تبّاً

100
00:08:47,400 --> 00:08:48,850
!كان ذلك مُبالغاً به

101
00:08:51,060 --> 00:08:53,840
جوغيونغ، هل يمكنني تصوير كلّ شيء؟

102
00:08:53,840 --> 00:08:55,920
!وإلّا سأنسى كلّ شيء ثانية

103
00:08:56,360 --> 00:08:57,470
!نعم، حسناً

104
00:08:59,470 --> 00:09:03,460
،أوّلاً نهيئ البشرة بمُثبِّت لون
باستخدام بِطانة قطنيّة

105
00:09:03,460 --> 00:09:05,520
ثمّ كريم الأساس

106
00:09:05,520 --> 00:09:06,970
...وبعدها الكونسيلر

107
00:09:07,940 --> 00:09:10,970
بما أنّنا نصوّر ذلك، فسأشرح
!العمليّة برمّتها

108
00:09:22,060 --> 00:09:24,400
!هذا جنون! سيوجون، انظر إليّ

109
00:09:27,600 --> 00:09:28,970
غوون حسناء، أليس كذلك؟

110
00:09:31,920 --> 00:09:33,020
...ا-المعذرة

111
00:09:33,880 --> 00:09:35,470
!مهلاً، تراجعي

112
00:09:35,640 --> 00:09:38,480
لا تكن هكذا! انظر إليّ! أنا جميلة، صحيح؟

113
00:09:38,480 --> 00:09:40,720
بالمناسبة، هل تشاجرتِ مع سوهو؟

114
00:09:40,720 --> 00:09:42,480
!لماذا؟ لـ-لا

115
00:09:42,480 --> 00:09:43,800
المسألة ليست كذلك

116
00:09:43,800 --> 00:09:45,720
الشّرح صعب

117
00:09:45,720 --> 00:09:46,900
،تذكّرت يا جوغيونغ

118
00:09:46,900 --> 00:09:49,500
!سأطلب من سيوجون مساعدتكِ في المهمّة التّالية

119
00:09:49,500 --> 00:09:51,310
!لِقاء درس المكياج الّذي أعطيتِني إيّاه

120
00:09:51,660 --> 00:09:53,980
ألا ينبغي أن تكوني أنتِ من يفعل
شيئاً بالمقابل؟

121
00:09:54,310 --> 00:09:57,180
!لأنّك تحبّ ارتداء الملابس كالنّجوم

122
00:09:57,180 --> 00:09:58,560
عملتَ كعارض أزياء أيضاً

123
00:09:58,860 --> 00:10:00,560
حقّاً؟ كنتَ عارض أزياء؟

124
00:10:00,560 --> 00:10:02,460
في الواقع، مجرّد عمل بدوام جزئيّ

125
00:10:02,460 --> 00:10:03,560
هل لديك فكرة؟

126
00:10:03,560 --> 00:10:05,880
كيف يمكنني تلبيق زيّ مدرسيّ
مُوحَّد لأبدو جميلة؟

127
00:10:06,820 --> 00:10:08,350
...في المرّة السّابقة

128
00:10:11,620 --> 00:10:13,140
ما ارتديتِه في المهرجان

129
00:10:13,140 --> 00:10:14,470
بدا جميلاً

130
00:10:15,180 --> 00:10:16,260
في المهرجان؟

131
00:10:18,440 --> 00:10:19,640
!سيفلح ذلك

132
00:10:27,520 --> 00:10:30,240
:المهمّة التّالية
!تلبيق الزيّ المدرسيّ المُوحّد

133
00:10:30,240 --> 00:10:34,280
يجب أن تُظهري شخصيّتكِ بزيّ
!مُوحّد ترتدينه يومياً

134
00:10:34,280 --> 00:10:37,760
!لهذا سأريهم نمطاً جريئاً لم يروه من قبل

135
00:10:37,760 --> 00:10:41,400
بمشدّ يجعل الصّدر يبدو أكبر
!وجزمة ذات أربطة

136
00:10:41,400 --> 00:10:45,020
!لا يبدو ذلك متلائماً مع زيّ مدرسيّ مُوحّد

137
00:10:45,020 --> 00:10:47,540
حوّلتُ القميص إلى قميص فوق البطن

138
00:10:51,340 --> 00:10:55,300
إلى جانب الجزمة الطّويلة الّتي
!تمنحني طابعاً جامحاً

139
00:10:57,520 --> 00:11:02,200
بالإضافة إلى ربطة عنق الزيّ
المدرسيّ النّمطيّة

140
00:11:02,200 --> 00:11:04,900
!الّتي ستُكمل هذا الشّكل الفريد

141
00:11:04,520 --> 00:11:05,760
!مذهل

142
00:11:05,760 --> 00:11:07,500
!تبدين غاية في الرّوعة

143
00:11:07,500 --> 00:11:10,180
لكن ثمّة شيء ما زال ناقصاً

144
00:11:10,180 --> 00:11:12,770
!احتجتُ شيئاً أكثر حداثة

145
00:11:13,120 --> 00:11:15,770
!وهذا ما توصّلتُ إليه

146
00:11:16,220 --> 00:11:17,340
!مفاجأة

147
00:11:18,940 --> 00:11:19,940
ما رأيكما؟

148
00:11:20,770 --> 00:11:23,340
!رائع! غاية في الرّوعة

149
00:11:23,770 --> 00:11:25,660
!تتمتّعين بحسّ الموضة

150
00:11:25,660 --> 00:11:28,380
!تماماً! تبدين كآيدول

151
00:11:33,270 --> 00:11:34,840
الزيّ معكِ، صحيح؟

152
00:11:34,840 --> 00:11:36,340
أجل، هنا

153
00:11:36,340 --> 00:11:40,440
هذه المرّة أنا مستعدّة تحسُّباً
لأيّ عدّ تنازليّ مُفاجئ

154
00:11:40,440 --> 00:11:43,140
أجل، قد يبدأ ذلك دون إخطار مسبق

155
00:11:45,360 --> 00:11:46,340
جوغيونغ ليم

156
00:11:50,480 --> 00:11:52,640
!الأمر ليس كما تعتقدان

157
00:11:55,640 --> 00:11:57,260
أليس لديكِ ما تقولينه لي؟

158
00:11:57,640 --> 00:11:59,120
ماذا؟ لا، ليس لديّ

159
00:11:59,120 --> 00:12:01,120
ماذا تقصد؟

160
00:12:01,840 --> 00:12:04,640
لماذا تتحاشينني باستمرار إذاً؟

161
00:12:04,640 --> 00:12:06,640
...أتحاشاك؟ أنا لا

162
00:12:12,260 --> 00:12:14,200
!قلتُ لا أتحاشاك

163
00:12:19,930 --> 00:12:22,140
أنتِ لا تتحاشينني الآن إذاً؟

164
00:12:22,140 --> 00:12:24,430
!لستُ كذلك! أنا لا أتحاشاك

165
00:12:48,640 --> 00:12:50,760
كيف انتهى المطاف بي إلى هنا تحديداً؟

166
00:12:52,020 --> 00:12:54,310
لكن قد أكون بأمان هنا

167
00:13:01,310 --> 00:13:04,540
ألم أرد التوقّف عن الهرب؟

168
00:13:07,580 --> 00:13:09,800
...لماذا أتصرّف كغبيّة

169
00:13:53,600 --> 00:13:55,440
...متى غلبني النُّعاس

170
00:13:56,200 --> 00:13:57,220
!سـ-سوهو لي؟

171
00:13:59,140 --> 00:14:01,160
إنّه قريب جدّاً

172
00:14:02,850 --> 00:14:05,620
رموشه طويلة

173
00:14:09,800 --> 00:14:11,160
أتهربين من جديد؟

174
00:14:11,840 --> 00:14:13,020
لـ-لستُ كذلك

175
00:14:18,140 --> 00:14:19,340
لماذا إذاً

176
00:14:19,340 --> 00:14:20,880
تجنّبتِني حينها؟

177
00:14:21,140 --> 00:14:23,140
،رأيتُك بعد المهرجان

178
00:14:23,140 --> 00:14:24,820
أمام المتجر

179
00:14:26,340 --> 00:14:29,300
رأيتُك وسوجين تتعانقان

180
00:14:29,300 --> 00:14:31,840
هل أنتما عاشقان؟

181
00:14:33,140 --> 00:14:37,080
سوجين وأنا لم نعُد منسجمتين

182
00:14:37,080 --> 00:14:40,640
إذا كنتُما تتواعدان، فلا ينبغي
أن نلتقي ببعضنا الآخر بعد الآن

183
00:14:41,980 --> 00:14:43,640
ذلك كان السّبب؟

184
00:14:43,940 --> 00:14:47,600
!لا أريد اعتراض طريقكما

185
00:14:47,600 --> 00:14:49,850
من الطّبيعيّ أن تسيئي الفهم إن لم تسألي

186
00:14:50,460 --> 00:14:52,360
الأمر ليس كما تعتقدينه

187
00:14:52,850 --> 00:14:54,500
ولن يكون كذلك أيضاً

188
00:14:57,140 --> 00:14:58,400
هذا مُطمئن

189
00:14:58,850 --> 00:14:59,680
مُطمئن؟

190
00:15:00,640 --> 00:15:03,180
لأنّني لم أعُد أواعد سوجين؟

191
00:15:03,720 --> 00:15:05,140
!لـ-لا

192
00:15:05,140 --> 00:15:09,890
من الجيّد أنّه يمكننا أن نكون صديقَي
!مكتبة مُصوّرة وروايات من جديد

193
00:15:15,970 --> 00:15:18,970
زيّي! أنا متأكّدة بأنّ الحقيبة
كانت معي

194
00:15:30,780 --> 00:15:33,360
أنتِ في وضع حرج يا جوغيونغ

195
00:15:36,800 --> 00:15:39,980
!بحثتُ في الطّريق كلّه ولم أجد شيئاً

196
00:15:43,400 --> 00:15:45,040
!فات الأوان الآن على متابعة البحث

197
00:15:45,720 --> 00:15:46,960
ماذا يجدر بي أن أفعل؟

198
00:15:46,960 --> 00:15:49,200
!بذلتُ مجهوداً كبيراً في ذلك الزيّ

199
00:15:50,700 --> 00:15:53,520
اهدئي! أما من طريقة أخرى؟

200
00:15:53,520 --> 00:15:55,440
...فات الأوان الآن

201
00:15:57,900 --> 00:16:00,860
هـ-هل يمكننا الذّهاب إلى غرفة
الدّعائم الخاصّة بقسم التّمثيل؟

202
00:16:05,780 --> 00:16:07,640
!سوجين تُبدع

203
00:16:26,040 --> 00:16:27,060
سألتقط صورة

204
00:16:57,720 --> 00:16:59,520
ما مشكلة سوجين كانغ؟

205
00:16:59,520 --> 00:17:02,840
!هذا ما كانت جوغيونغ سترتديه حرفياً

206
00:17:02,840 --> 00:17:05,180
أجل، كيف حدث ذلك؟

207
00:17:23,580 --> 00:17:24,840
جوغيونغ ليم؟