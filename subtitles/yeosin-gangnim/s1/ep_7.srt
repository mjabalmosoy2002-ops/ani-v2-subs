1
00:00:23,520 --> 00:00:24,360
!هذا واضح

2
00:00:24,360 --> 00:00:26,120
!سوجين كانغ هي الرّابحة بوضوح

3
00:00:26,640 --> 00:00:28,420
هل استسلمتْ؟

4
00:00:34,020 --> 00:00:35,810
!سوهو لي! صوّرني

5
00:00:36,460 --> 00:00:37,390
ماذا؟

6
00:00:40,480 --> 00:00:41,960
!ما زال عليّ الرّقص

7
00:01:12,020 --> 00:01:13,930
!هـ-هذا جنون

8
00:01:14,060 --> 00:01:16,180
!أ-أجسنتِ صنعاً يا جو-جو

9
00:01:16,180 --> 00:01:17,920
!يا لها من فكرة أصليّة

10
00:01:17,920 --> 00:01:19,810
متى أصبحتِ بهذه المهارة في الرّقص؟

11
00:01:20,040 --> 00:01:22,220
!التّصويت مختلف بشكل كبير

12
00:01:22,220 --> 00:01:25,360
!المركزان الثّالث والرّابع استسلمتا تماماً

13
00:01:25,860 --> 00:01:27,930
!لدينا سوجين هذه المرّة

14
00:01:30,430 --> 00:01:33,000
!لكن! من المبكّر جدّاً الشّعور بأمان بعد

15
00:01:33,000 --> 00:01:34,930
!فأساساً، خصمنا هي سوجين كانغ

16
00:01:34,930 --> 00:01:38,930
،دعونا ألّا نتفوّق من حيث عدد الإعجابات فقط
!بل سنذلّ سوجين كانغ بشكل نهائيّ وللأبد

17
00:01:39,280 --> 00:01:41,580
ماذا؟ لم ينتهِ الأمر بعد؟

18
00:01:41,580 --> 00:01:43,930
لا. ما زالت هناك مهمّتان متبقّيتان

19
00:01:44,680 --> 00:01:47,400
الفوز في المهام يُدمَج مع عدد الإعجابات

20
00:01:47,400 --> 00:01:49,040
لتحديد من ستكون الإلَهة

21
00:01:49,740 --> 00:01:52,140
لا يمكننا أن نجزم مَن سيفوز بعد

22
00:01:54,140 --> 00:01:55,140
ماذا؟

23
00:01:58,300 --> 00:01:59,970
ماذا؟ سيوجون هان؟

24
00:01:59,970 --> 00:02:03,300
هل حدث شيء بينكما؟

25
00:02:03,300 --> 00:02:04,800
!إطلاقاً

26
00:02:04,800 --> 00:02:06,970
!لا يوجد شيء صدِّقاني

27
00:02:06,970 --> 00:02:07,760
!جوغيونغ ليم

28
00:02:07,780 --> 00:02:08,580
نعم؟

29
00:02:08,080 --> 00:02:10,100
هل أنتِ مُتفرِّغة غداً؟

30
00:03:51,430 --> 00:03:53,640
!مذهل

31
00:03:52,780 --> 00:03:53,640
!انظروا إلى هذا

32
00:03:53,280 --> 00:03:54,580
!أريد الرّكوب أيضاً

33
00:03:54,580 --> 00:03:56,440
!بسرعة، هيّا

34
00:03:56,440 --> 00:03:57,600
هل تريدين هذه؟

35
00:03:57,600 --> 00:03:59,180
!اشتريها لي رجاء

36
00:03:59,180 --> 00:03:59,810
!هيّا بنا

37
00:04:06,350 --> 00:04:08,340
!ها أنا ذي! انتهيت

38
00:04:13,680 --> 00:04:14,940
العمل على ما يُرام، صحيح؟

39
00:04:14,940 --> 00:04:16,900
حجزتُ لك هذا المكان، لذا
ابذلي قصارى جهدكِ

40
00:04:16,900 --> 00:04:18,390
وإلّا سوف أُطرَد أيضاً

41
00:04:18,390 --> 00:04:19,840
!هذا ممتع

42
00:04:19,840 --> 00:04:22,390
هل ينبغي أن أصرف المال على الدّروس؟

43
00:04:22,390 --> 00:04:23,340
دروس؟

44
00:04:23,340 --> 00:04:24,540
أي نوع من الدّروس؟

45
00:04:24,540 --> 00:04:26,260
!دروس المكياج

46
00:04:26,260 --> 00:04:28,540
!ينبغي أن أتعلّم استخدامه باحترافيّة

47
00:04:29,060 --> 00:04:31,720
أنتِ قديمة بالفعل، لكنّكِ لا تدرسين إطلاقاً

48
00:04:33,320 --> 00:04:35,430
...حسناً، على ذكر الدّراسة

49
00:04:35,760 --> 00:04:39,180
وأنت؟ لماذا تعمل بجدّ هكذا؟

50
00:04:39,560 --> 00:04:40,920
...أنا؟ في الواقع

51
00:04:41,800 --> 00:04:43,720
أريد أن أكون ثرياً. لماذا؟

52
00:04:43,940 --> 00:04:46,390
أما من شيء تريد فعله؟

53
00:04:47,520 --> 00:04:48,760
لا شيء

54
00:04:49,200 --> 00:04:51,000
ما دام غوون بخير، أنا بخير

55
00:04:53,310 --> 00:04:55,460
يفاجئني أكثر فأكثر

56
00:04:55,460 --> 00:04:57,430
يعتني بأخته جيّداً أيضاً

57
00:04:59,160 --> 00:05:02,850
أنت مختلف تماماً عن انطباعاتي الأولى

58
00:05:03,340 --> 00:05:04,360
من أي ناحية؟

59
00:05:04,360 --> 00:05:06,350
ماذا كان انطباعكِ الأوّل عنّي؟

60
00:05:07,340 --> 00:05:08,600
،في الواقع

61
00:05:10,000 --> 00:05:12,880
!ظننتُك مُثير شغب حقيقيّ

62
00:05:13,560 --> 00:05:18,360
لكن الآن، أدرك بأنّك صادق وأخ طيّب

63
00:05:19,020 --> 00:05:21,600
أنت شخص جيّد في نهاية المطاف

64
00:05:22,300 --> 00:05:25,340
في البداية، لم أتوقّع أن نصبح
!صديقين عزيزين

65
00:05:26,520 --> 00:05:29,060
!لم أتوقّع أن نصبح صديقين عزيزين

66
00:05:31,300 --> 00:05:33,060
!صديقين

67
00:05:34,760 --> 00:05:37,000
...صـ-صديقين

68
00:05:40,940 --> 00:05:42,220
سوهو لي. ماذا تريد؟

69
00:05:42,760 --> 00:05:44,890
أنا هنا لرؤية جوغيونغ بالطّبع

70
00:05:44,890 --> 00:05:47,520
إذا غادرنا باكراً، فيمكننا التمشّي معاً

71
00:05:47,520 --> 00:05:50,390
...وربّما توضيح بعض الأمور

72
00:05:55,560 --> 00:05:56,840
!يا آنسة

73
00:05:58,320 --> 00:05:59,940
!امنحيني ختماً من فضلكِ

74
00:06:01,120 --> 00:06:03,470
صحيح! نسيتُ ذلك

75
00:06:03,470 --> 00:06:04,900
انتظر لحظة

76
00:06:06,100 --> 00:06:06,840
!تفضّل

77
00:06:06,840 --> 00:06:09,600
ماذا تريد أن تأخذ بعد جمعها؟

78
00:06:09,600 --> 00:06:12,220
!هناك! أريد واحداً منهم

79
00:06:16,080 --> 00:06:17,520
!هكذا إذاً

80
00:06:17,520 --> 00:06:20,280
!كم هذا ظريف

81
00:06:23,360 --> 00:06:24,970
!ينبغي أن تجمعي الأختام أيضاً

82
00:06:24,970 --> 00:06:26,660
،كنتُ لأتمنّى ذلك

83
00:06:26,660 --> 00:06:28,900
لكن عليّ أن أعمل هنا

84
00:06:29,400 --> 00:06:31,270
!اذهب واحصل على الدّمية

85
00:06:41,520 --> 00:06:42,920
إلى أين أنت ذاهب؟

86
00:06:42,920 --> 00:06:44,810
لن تحصل على بطاقة أختام، صحيح؟

87
00:06:45,140 --> 00:06:46,260
لا داعي لتعرف

88
00:06:46,260 --> 00:06:47,840
إلى أين أنت ذاهب؟

89
00:06:47,840 --> 00:06:49,430
ألا ينبغي أن تعمل؟

90
00:06:49,430 --> 00:06:50,920
!انتهت مُناوبتي

91
00:06:50,920 --> 00:06:53,420
!فضلاً عن ذلك، لا يجوز أن تتدخّل

92
00:06:53,000 --> 00:06:54,640
!وأنت لا تتدخّل أيضاً

93
00:06:58,760 --> 00:07:00,270
إلى أين ذهبا؟

94
00:07:06,540 --> 00:07:08,680
!مذهل

95
00:07:09,380 --> 00:07:10,840
اللّعنة

96
00:07:15,600 --> 00:07:17,240
بئساً

97
00:07:17,240 --> 00:07:17,720
ماذا؟

98
00:07:27,350 --> 00:07:29,700
!مذهل

99
00:08:07,660 --> 00:08:11,340
أنت مشغول حقّاً بالحصول على تلك
الدّمية لأجل جوغيونغ

100
00:08:11,340 --> 00:08:13,020
هذا غير صحيح

101
00:08:13,020 --> 00:08:14,580
!بل هو كذلك

102
00:08:14,940 --> 00:08:17,320
متى أصبحتُما مُقرّبين

103
00:08:17,320 --> 00:08:18,770
لدرجة أنّكما تعملان معاً حتّى؟

104
00:08:19,720 --> 00:08:21,700
لكنّنا لا نعمل معاً فحسب

105
00:08:21,700 --> 00:08:24,020
!حتّى أنّها رسمَتْ لوحة لي

106
00:08:24,600 --> 00:08:26,240
كان ذلك لأجل مهمّة

107
00:08:26,240 --> 00:08:27,900
ما المُميّز في ذلك؟

108
00:08:30,320 --> 00:08:31,960
لماذا تغار؟

109
00:08:31,960 --> 00:08:33,860
هل تحبّ جوغيونغ فعلاً؟

110
00:08:36,940 --> 00:08:39,350
لماذا تلعب معها؟

111
00:08:40,960 --> 00:08:43,040
أنا لا ألعب معها

112
00:08:43,520 --> 00:08:44,500
،حسناً إذاً

113
00:08:44,500 --> 00:08:47,080
هل هذا يعني بأنّك تحبّها؟

114
00:08:50,740 --> 00:08:52,350
ربّما

115
00:09:03,620 --> 00:09:06,180
!وداعاً! اجمعي تلك الأختام-
!شكراً-

116
00:09:05,460 --> 00:09:06,770
!شكراً

117
00:09:07,360 --> 00:09:09,060
!جوغيونغ ليم! ارسمي على وجهي أيضاً

118
00:09:09,060 --> 00:09:10,560
!سأحصل على ختم حينها، صحيح؟

119
00:09:10,260 --> 00:09:11,260
!أنا أوّلاً

120
00:09:11,260 --> 00:09:13,520
!حصلتُ على هذه، لكن لم تعطيني ختماً بعد

121
00:09:15,540 --> 00:09:17,180
أتيتُ إلى هنا أوّلاً؟

122
00:09:17,580 --> 00:09:19,620
!كنتُ هنا قبل أن تأتي

123
00:09:19,620 --> 00:09:20,780
!انظر إلى هذا

124
00:09:20,780 --> 00:09:21,640
ماذا؟

125
00:09:22,140 --> 00:09:24,480
أنت تخاطر بحياتك لأجل شيء تافه كهذا؟

126
00:09:24,160 --> 00:09:25,100
!مثلك تماماً

127
00:09:29,340 --> 00:09:32,970
هل هما مُقرّبان فعلاً أم لا؟

128
00:09:41,960 --> 00:09:44,620
!انتهينا أخيراً

129
00:09:44,620 --> 00:09:47,140
لكن ماذا يفعل سوهو وسيوجون؟

130
00:09:51,220 --> 00:09:53,340
لم تسنح لي فُرصة للتجوّل

131
00:09:54,020 --> 00:09:55,140
حسناً، أتيتُ إلى هنا للعمل

132
00:10:05,680 --> 00:10:07,890
أردتُ البُكاء، لكن لم أستطع

133
00:10:07,890 --> 00:10:10,020
ظننتُ أنّه لم يكن لديّ الحقّ لفعل ذلك

134
00:10:10,350 --> 00:10:12,840
!ارسمي على وجهي أيضاً
سأحصل على ختم حينها، صحيح؟

135
00:10:12,340 --> 00:10:13,310
!أنا أوّلاً

136
00:10:13,640 --> 00:10:15,680
!حصلتُ على هذه، لكن لم تعطيني ختماً بعد

137
00:10:18,960 --> 00:10:21,540
لم أتوقّع هذا الجانب منه

138
00:10:21,540 --> 00:10:24,800
أتساءل ما إن كان هكذا دوماً

139
00:10:33,260 --> 00:10:35,220
!بئساً

140
00:10:44,980 --> 00:10:46,350
ورقة تاروت؟

141
00:10:51,980 --> 00:10:53,480
سأساعدك

142
00:10:53,480 --> 00:10:54,430
شكراً لكِ

143
00:10:56,900 --> 00:10:59,360
بالمقابل، سأقرأ لكِ بأوراق التّاروت مجّاناً

144
00:10:59,360 --> 00:11:00,770
ما الّذي ينتابكِ فضول بشأنه؟

145
00:11:02,500 --> 00:11:03,940
قراءة بالتّاروت؟

146
00:11:04,680 --> 00:11:07,140
لا يخطر على ذهني شيء معيّن الآن

147
00:11:07,700 --> 00:11:10,340
ألا يريد التّلاميذ جميعهم أن يعرفوا
بختهم في الحبّ؟

148
00:11:17,160 --> 00:11:18,820
لم تبقَ ولا واحدة؟

149
00:11:19,640 --> 00:11:21,700
!لكن جمعتُ كافّة الأختام

150
00:11:21,700 --> 00:11:23,740
سلّمتُ الأخيرة للتو

151
00:11:26,120 --> 00:11:28,800
لماذا أولئك الأطفال سريعون جدّاً؟

152
00:11:33,350 --> 00:11:35,480
استهنتُ بهم

153
00:11:36,020 --> 00:11:37,200
لنذهب إذاً

154
00:11:37,200 --> 00:11:38,700
لا بدّ أنّ جوغيونغ تنتظرنا

155
00:11:40,300 --> 00:11:41,320
...لنرَ

156
00:11:41,840 --> 00:11:44,270
التقطي ثلاث بطاقات تجذب اهتمامكِ

157
00:11:46,480 --> 00:11:48,600
هذه

158
00:11:48,600 --> 00:11:51,810
وهذه

159
00:12:04,320 --> 00:12:08,600
أنتِ في علاقة مُثلّثيّة، ولا تُميّزين
ما إن كانت صداقة أو حبّ

160
00:12:09,100 --> 00:12:11,270
...علاقة

161
00:12:11,270 --> 00:12:12,320
مُثلّثيّة؟

162
00:12:12,320 --> 00:12:14,820
!أنا لا أواعد أحداً أصلاً الآن

163
00:12:14,820 --> 00:12:16,890
لكنّكِ مهتمّة بشخص؟

164
00:12:18,800 --> 00:12:21,680
،تعيشين وضعاً لا تتجرّئين فيه على التخيُّل

165
00:12:21,680 --> 00:12:25,520
مع ذلك لاحظتِ قرب شخص مُرشّح ليكون حبيبكِ

166
00:12:32,180 --> 00:12:34,040
لماذا لا تردّ على هاتفها؟

167
00:12:34,040 --> 00:12:34,980
هل أغلقته؟

168
00:12:34,980 --> 00:12:37,350
كان ينبغي أن تبقى بجانبها
،إن كنتَ قلقاً إلى هذه الدّرجة

169
00:12:37,350 --> 00:12:39,100
بدلاً من التّساؤل

170
00:12:39,900 --> 00:12:43,520
أجل، فشلنا في الحصول على الدّمية
بعد كلّ ذلك العناء

171
00:12:43,520 --> 00:12:46,160
فقط لأنّ جوغيونغ تحبّ تلك الأشياء

172
00:12:46,160 --> 00:12:48,220
لديها سمّاعات رأس ظريفة أيضاً

173
00:12:51,520 --> 00:12:54,470
.ما الأمر؟ أنا في طريقي إلى المنزل
أنهيتُ مُناوبتي

174
00:12:54,470 --> 00:12:55,660
بديل؟

175
00:12:55,660 --> 00:12:56,740
...بئساً

176
00:12:56,740 --> 00:13:00,180
قلتُ لك اعتزلتُ الغناء منذ فترة
!طويلة! انسَ الأمر

177
00:13:00,740 --> 00:13:03,060
لحظة، أنت في فريق الإدارة، صحيح؟

178
00:13:03,300 --> 00:13:05,180
هل تبقّت أي دُمى؟

179
00:13:05,500 --> 00:13:07,180
إحدى تلك الهدايا

180
00:13:08,020 --> 00:13:11,100
شخص مُقرّب منّي بالفعل؟

181
00:13:15,560 --> 00:13:20,180
بلا أيّ سبب

182
00:13:20,620 --> 00:13:23,770
...هل يمكنك أن تري أيضاً

183
00:13:22,140 --> 00:13:26,770
وجدتني بالصّدفة

184
00:13:23,770 --> 00:13:25,520
...ما إن كان ذلك الشّخص

185
00:13:28,040 --> 00:13:35,320
رويداً رويداً، تدخل قلبي

186
00:13:32,600 --> 00:13:33,740
...هذه الأغنية

187
00:13:34,520 --> 00:13:36,720
!عليّ الذّهاب الآن

188
00:13:36,720 --> 00:13:38,100
!شكراً جزيلاً لكِ

189
00:13:36,820 --> 00:13:40,980
والسّيطرة عليه

190
00:13:42,520 --> 00:13:49,640
وأنا أغنّي ثانية

191
00:13:46,100 --> 00:13:47,040
!سوهو لي

192
00:13:47,580 --> 00:13:49,350
أين كنت؟

193
00:13:49,540 --> 00:13:50,320
آسف

194
00:13:49,640 --> 00:13:54,180
وأهمس في أذنك

195
00:13:51,240 --> 00:13:54,180
مضى وقت منذ سمعتُ سيوجون يغنّي

196
00:13:55,840 --> 00:14:02,960
حتّى لو كنتُ أخرق

197
00:14:02,960 --> 00:14:07,760
أجد ضالّتي إليك

198
00:14:09,200 --> 00:14:16,270
وأستدعيك من جديد

199
00:14:16,270 --> 00:14:22,620
وأهمس في أذنك

200
00:14:22,620 --> 00:14:29,660
حتّى لو كنتُ أخرق

201
00:14:29,660 --> 00:14:39,680
أجد ضالّتي إليك

202
00:14:46,320 --> 00:14:47,320
تفضّلي

203
00:14:47,320 --> 00:14:48,940
حصلت على واحدة؟

204
00:14:48,940 --> 00:14:51,020
بذلت قصارى جهدك حقّاً

205
00:14:51,020 --> 00:14:52,460
حصلتُ عليه لأجلك

206
00:14:52,460 --> 00:14:54,920
حصلت عليها لأجلي؟

207
00:14:54,300 --> 00:14:56,380
!قـ-قلت بأنّك أردتِ واحدة

208
00:14:56,380 --> 00:15:00,280
تقصد آنذاك. كنتُ ألاطف ذلك الطّفل فحسب

209
00:15:00,280 --> 00:15:02,180
إنّه زبون في نهاية المطاف

210
00:15:02,580 --> 00:15:03,600
تبّاً

211
00:15:03,600 --> 00:15:05,640
منزلنا ممتلئ سلفاً! لا أستطيع الاحتفاظ به

212
00:15:05,640 --> 00:15:07,420
!إن كنتِ لا تريدينها، فسأتخلّص منها

213
00:15:07,420 --> 00:15:10,100
!سيكون هذا إسرافاً

214
00:15:10,600 --> 00:15:14,140
إنّها إصدار محدود الكمّية. إعادة
!بيعها سيوفّر لي مبلغاً جيّداً

215
00:15:20,970 --> 00:15:24,080
لكن يا سيوجون، أنت مغنٍّ رائع

216
00:15:24,560 --> 00:15:26,930
هل توقّفت عن كونك مُتدرّباً؟

217
00:15:27,140 --> 00:15:28,620
هذا مؤسف

218
00:15:28,620 --> 00:15:30,620
ما زال بمقدوري البدء من جديد

219
00:15:32,760 --> 00:15:33,600
المعذرة

220
00:15:34,700 --> 00:15:36,600
هل يمكنني التقاط صورة معكم أنتم الثّلاثة؟

221
00:15:36,760 --> 00:15:38,880
أعمل في مجلّة أزياء

222
00:15:38,880 --> 00:15:40,600
وتعجبني طريقة لباسكم

223
00:15:41,720 --> 00:15:43,320
لا، شكراً

224
00:15:48,360 --> 00:15:50,520
لنفعلها

225
00:15:54,280 --> 00:15:55,960
!لتخليد صداقتنا الجديدة

226
00:15:59,880 --> 00:16:02,840
!حسناً، الرّجاء اتّخاذ وضعيّة طبيعيّة

227
00:16:03,540 --> 00:16:05,200
!سأبدأ إذاً

228
00:16:07,260 --> 00:16:09,080
ألم تتّخذا وضعية من قبل لالتقاط صورة؟

229
00:16:09,080 --> 00:16:10,360
!ابتسما

230
00:16:09,680 --> 00:16:10,920
!هذا ممتاز

231
00:16:10,920 --> 00:16:12,220
!واحد، اثنان، هيّا

232
00:16:20,440 --> 00:16:22,360
ماذا تريد؟

233
00:16:23,040 --> 00:16:25,310
جوغيونغ، أعيدي لي المجلّة المُصوّرة

234
00:16:25,310 --> 00:16:28,040
!لماذا؟ أنا مُرهقة جدّاً الآن

235
00:16:29,340 --> 00:16:33,720
قال صاحب المتجر بأنّني سأُطرَد
إذا تأخّرتُ في إعادتها ثانية

236
00:16:34,040 --> 00:16:36,040
!إذاً اذهب بنفسك

237
00:16:36,040 --> 00:16:37,900
!لديك يدان وساقان

238
00:16:38,860 --> 00:16:39,680
!أنت

239
00:16:39,680 --> 00:16:42,780
بئساً! من هذه العمّة القبيحة؟

240
00:16:42,780 --> 00:16:44,920
هل يعرف أحدكم؟

241
00:16:44,920 --> 00:16:46,800
!سأسأل الجميع في ستارغرام

242
00:16:46,800 --> 00:16:48,470
...أنت

243
00:16:49,620 --> 00:16:51,300
أنا مُرهقة للغاية

244
00:16:52,860 --> 00:16:55,120
!جويونغ ليم، سترى

245
00:17:04,760 --> 00:17:07,140
سوهو لي وسوجين كانغ؟