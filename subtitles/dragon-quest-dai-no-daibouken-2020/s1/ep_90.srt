1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:53,320 --> 00:01:54,400
انتهى الأمر

20
00:02:00,740 --> 00:02:02,740
!افعل ما تشاء بنا

21
00:02:03,450 --> 00:02:05,410
لن تقاوموا؟

22
00:02:06,200 --> 00:02:11,630
الآن بعد أن مات بوب، لا نملك وسيلة لهزيمتك

23
00:02:12,090 --> 00:02:13,630
فقدنا الأمل

24
00:02:14,250 --> 00:02:19,970
من الواضح أنّ ذلك الفتى كان
مِحوريّاً بالنسبة لمجموعتكم

25
00:02:20,640 --> 00:02:24,100
على ذكر الأمر، احترمَه كيل أيضاً

26
00:02:24,260 --> 00:02:28,440
قال أنّ مثل هؤلاء الأشخاص يمكنهم
،أن يصبحوا قلب وروح فريقهم

27
00:02:28,600 --> 00:02:30,850
لذا ينبغي التخلّص منهم أوّلاً

28
00:02:31,520 --> 00:02:34,690
جهوده وبسالته تستحقّان الاحترام

29
00:02:35,440 --> 00:02:39,950
وحتّى أنّه أجبرني على استخدام جناح العنقاء

30
00:02:40,780 --> 00:02:43,280
جناح العنقاء؟

31
00:02:43,450 --> 00:02:48,290
إنّه هجوم كفّ فائق السّرعة يعكس أيّ تعويذة

32
00:02:48,460 --> 00:02:52,000
ولا يُستثنى من ذلك ميدروا

33
00:02:52,170 --> 00:02:57,590
ما كنتُ لأنجو من تلك الهجمة
لولا استخدام هذه المهارة المُحرّمة

34
00:02:57,760 --> 00:03:01,800
...العنقاء... الطائر الخالد... هذا يعني

35
00:03:02,590 --> 00:03:04,720
عنقاء القيصر

36
00:03:07,600 --> 00:03:11,900
...فهمت! إذاً ميستوفارن وفارن

37
00:03:12,310 --> 00:03:15,860
!فهمت! عرفتُ هويّة ميستوفارن الحقيقيّة

38
00:03:16,020 --> 00:03:22,030
!وإن كنتُ مُحقّاً، من المنطقيّ أن يكون بهذه القوّة

39
00:03:22,740 --> 00:03:25,910
الرّحمة إهانة. اقتلني بسرعة

40
00:03:26,370 --> 00:03:31,000
!لكن تذكّر هذا، سيقتلك فخامته داي

41
00:03:32,290 --> 00:03:33,750
هذا صحيح

42
00:03:33,920 --> 00:03:37,090
داي المهمّ ما زال موجوداً

43
00:03:37,250 --> 00:03:39,170
سأنهي أمركم بسرعة

44
00:03:39,340 --> 00:03:42,930
يمكنكم انتظار داي في الآخرة

45
00:03:43,090 --> 00:03:43,970
!ماذا؟

46
00:03:44,140 --> 00:03:47,310
،مهما ازداد داي قوّةً من مرّات

47
00:03:47,470 --> 00:03:51,980
مُحال أن يتمكّن من قتل ملك الشّياطين فارن

48
00:03:52,140 --> 00:03:53,810
من الطبيعي ألّا يستطيع

49
00:03:54,940 --> 00:03:56,480
كيف له أن يستطيع؟

50
00:03:56,650 --> 00:03:58,820
داي لا يستطيع قتل فارن

51
00:03:59,280 --> 00:04:01,950
...فأساساً، فارن الحقيقيّ

52
00:04:02,110 --> 00:04:03,280
!هنا

53
00:04:03,450 --> 00:04:05,910
!أمام أعيننا

54
00:04:07,160 --> 00:04:09,290
!هذا صحيح يا ميستوفارن

55
00:04:10,160 --> 00:04:13,290
!أنت ملك الشّياطين الحقيقيّ فارن

56
00:04:16,080 --> 00:04:19,210
!كـ-كفاك حماقة

57
00:04:19,670 --> 00:04:25,640
!رأيتَه مع ملك الشّياطين عدّة مرّات بحدّ ذاتك

58
00:04:28,260 --> 00:04:33,390
توقّعتُ أن تكون أنت يا هيونكل أوّل
من يدرك الحقيقة

59
00:04:36,520 --> 00:04:43,530
منذ كشف ميستوفارن عن وجهه، شعرتُ بحضور مألوف

60
00:04:43,700 --> 00:04:47,530
لم يكن سوى حضور ملك الشّياطين فارن

61
00:04:47,780 --> 00:04:51,290
،قد يكون صوته صوت شخص فتيّ

62
00:04:51,450 --> 00:04:55,500
إلّا أنّ سلوكيّاته وأسلوبه القتاليّ
يتماشى مع سلوك وأسلوب فارن

63
00:04:55,960 --> 00:04:59,710
أعتقد بأنّ سبب اضطرار ميستوفارن
،للصمت سنوات

64
00:04:59,880 --> 00:05:03,550
،كان لأنّه إذا سمعَ شخصٌ يألف فارن صوتَه

65
00:05:03,720 --> 00:05:07,300
فقد يدرك أوجه التّشابه بين الاثنين

66
00:05:08,140 --> 00:05:11,890
إذا كان ملك الشّياطين لا يستطيع أن
يكون صامتاً، فيجب على الظلّ أن يصمت

67
00:05:12,310 --> 00:05:14,680
...لكن كان ذلك الظلّ حقّاً

68
00:05:14,850 --> 00:05:16,940
لا تهتمّ بالباقي

69
00:05:17,440 --> 00:05:20,820
دعني أقول بأنّك مُحقّ في أغلب ما قلته

70
00:05:22,070 --> 00:05:25,530
يمكنكم أن تكتشفوا الباقي بعد موتكم

71
00:05:25,990 --> 00:05:32,120
مهلاً. قال كلّ هذا القدر. لمَ لا تخبرنا بالباقي؟

72
00:05:34,120 --> 00:05:35,000
...أنت

73
00:05:35,460 --> 00:05:39,080
أريد سماع المزيد عن هويّتك

74
00:05:39,250 --> 00:05:40,750
كيل

75
00:05:40,920 --> 00:05:42,380
أين أفان؟

76
00:05:44,380 --> 00:05:45,510
لقد مات

77
00:05:47,130 --> 00:05:48,300
!لا

78
00:05:48,470 --> 00:05:51,760
يمكنكم إيجاد يده هناك

79
00:05:52,180 --> 00:05:55,480
!مستحيل! أرجوكم! هذا يكفي

80
00:05:55,640 --> 00:05:56,690
!آنسة مام

81
00:05:56,850 --> 00:05:58,940
مأساة تلو الأخرى

82
00:05:59,100 --> 00:06:05,490
لكن الأهمّ يا كيل، ماذا قصدتَ بذلك؟

83
00:06:08,320 --> 00:06:10,820
قصدتُ ماذا؟

84
00:06:10,990 --> 00:06:15,870
أن تقول شيئاً فظّاً كالرّغبة في معرفة من أكون

85
00:06:17,120 --> 00:06:19,170
،على مرّ هذه القرون

86
00:06:19,330 --> 00:06:24,500
رأيتني أقاتل وأنا بهذا الشّكل بضع مرّات

87
00:06:24,670 --> 00:06:26,510
...وقلتُ لك آنذاك

88
00:06:27,340 --> 00:06:28,880
"لا تهمّ نفسك بالسؤال"

89
00:06:29,760 --> 00:06:35,470
حتّى أنت لن يُصفَح عنك إذا عرفتَ"
"المعنى الحقيقي لهذا الوجه

90
00:06:36,350 --> 00:06:39,230
لستُ مُستثنى من ذلك

91
00:06:39,390 --> 00:06:43,400
لهذا السّبب، عندما حاولتُ الكشف
،عن هذا الوجه من قبل

92
00:06:44,110 --> 00:06:47,490
هدّدت بقتلي، أليس كذلك؟

93
00:06:48,400 --> 00:06:49,780
فلماذا إذاً؟

94
00:06:50,200 --> 00:06:53,580
لا تنسَ أيضاً

95
00:06:54,530 --> 00:07:00,540
،قد أكون مُلزماً بمساعدة ملك الشّياطين
لكن هذا ليس واجبي

96
00:07:02,040 --> 00:07:03,750
هذا صحيح

97
00:07:03,920 --> 00:07:08,300
في جيش الشّياطين، أنت الوحيد المختلف

98
00:07:08,470 --> 00:07:11,840
أنت متكافئ تقريباً مع ملك الشّياطين فارن بنفسه

99
00:07:13,180 --> 00:07:18,850
ما زلتُ أذكر اليوم الّذي ظهرتَ فيه أمامنا أوّل مرّة

100
00:07:28,610 --> 00:07:31,910
إذاً أيّكما هو... الملك فارن؟

101
00:07:32,950 --> 00:07:34,070
أنا

102
00:07:34,490 --> 00:07:35,950
ومن تكون؟

103
00:07:37,040 --> 00:07:40,710
كيلفارن... هو ما يمكنك مناداتي به

104
00:07:41,500 --> 00:07:43,120
كيلفارن؟

105
00:07:44,000 --> 00:07:46,130
إذاً أنت...؟

106
00:07:46,290 --> 00:07:47,500
بالفعل

107
00:07:47,670 --> 00:07:52,050
أنا مبعوث من شخص تعرفه خير معرفة

108
00:07:52,630 --> 00:07:54,390
اختصاصي هو الاغتيالات

109
00:07:54,550 --> 00:07:59,430
ألبس بهذه الطريقة خصّيصاً لأجلك

110
00:07:59,600 --> 00:08:02,190
،كدلالة على الصّداقة منه

111
00:08:02,350 --> 00:08:08,900
تمّ إرسالي لأكون مُعيناً لك في خططك

112
00:08:10,280 --> 00:08:11,700
...مُعين

113
00:08:14,110 --> 00:08:15,660
مُضحك

114
00:08:15,820 --> 00:08:20,620
،وإذا فشِلت خططي

115
00:08:20,790 --> 00:08:25,250
ستحاول اغتيالي فوراً، أليس كذلك؟

116
00:08:26,130 --> 00:08:29,670
مُراقب لخطّتي الّتي تقتضي تدمير عالم السّطح

117
00:08:30,380 --> 00:08:31,970
كيل... فارن

118
00:08:33,090 --> 00:08:37,010
"بصيغة أخرى، اسم مُشفّر يعني "اقتل فارن

119
00:08:37,180 --> 00:08:38,300
هذا مُثير للاهتمام

120
00:08:38,760 --> 00:08:42,640
أنت حقّاً إله العالم السّفلي. أنت وقور جدّاً

121
00:08:45,230 --> 00:08:49,270
هذا الشّخص، مثلك، هو كائن قويّ
من العالم السّفلي

122
00:08:49,570 --> 00:08:51,650
إنّه يدي اليُمنى

123
00:08:51,990 --> 00:08:55,410
أدهشتَني فوراً

124
00:08:55,570 --> 00:08:59,030
أن تظهر أمام ملك الشّياطين ومع
ذلك تحافظ على هدوئك

125
00:08:59,200 --> 00:09:01,830
كان سلوكك الغريب مُبهراً جدّاً

126
00:09:02,000 --> 00:09:03,960
،وفي القرون القليلة المقبلة

127
00:09:04,120 --> 00:09:08,920
بشخصيّتينا المُتعاكستين، تأقلمنا مع بعضنا الآخر

128
00:09:09,250 --> 00:09:13,380
لكن يبدو أنّه كان يُكذَبُ عليّ طوال هذا الوقت

129
00:09:13,550 --> 00:09:16,050
أفهم ما تعنيه

130
00:09:16,430 --> 00:09:20,510
لم تكن خادم ملك الشّياطين فارن فعليّاً

131
00:09:20,680 --> 00:09:21,600
أجل

132
00:09:22,140 --> 00:09:26,900
تعاونتَ معه ببساطة بأمر من سيّدك

133
00:09:27,060 --> 00:09:29,480
،إذا كنتُ أنا فارن الحقيقيّ

134
00:09:29,650 --> 00:09:33,990
فسيعني ذلك أنّك كنتَ تساعد
شخصاً مختلفاً كلّياً

135
00:09:34,530 --> 00:09:39,410
وسيعني أيضاً أنّ علاقتنا الغريبة
ستكون باطلة أيضاً

136
00:09:39,660 --> 00:09:41,080
هل أنا مخطئ؟

137
00:09:41,240 --> 00:09:43,330
أجل. أنت مخطئ

138
00:09:43,700 --> 00:09:47,540
،لا شكّ في إعانتك له

139
00:09:47,710 --> 00:09:50,790
ولا في صداقتنا أيضاً

140
00:09:50,960 --> 00:09:57,220
إذاً لمَ لا تكشف عن سرّك لنا هنا
فحسب يا ميستوفارن؟

141
00:10:11,230 --> 00:10:13,150
!لماذا تفعل ذلك؟

142
00:10:13,320 --> 00:10:15,490
!لستَ حاصد الأرواح

143
00:10:15,650 --> 00:10:21,990
مُنِحتُ اسم ميستوفارن الرّسمي
بعد وصول كيل

144
00:10:22,160 --> 00:10:25,540
!إنّه لا يناديني ميستوفارن

145
00:10:25,700 --> 00:10:28,960
!يناديني باسمي القديم ميستو

146
00:10:30,330 --> 00:10:33,460
!اكشف عن نفسك أيّها المُزيّف

147
00:10:37,880 --> 00:10:40,300
بئساً. كان ذلك خطأ

148
00:10:41,720 --> 00:10:45,850
أهملتُ شيئاً أساسيّاً كتسمية بعضكما للآخر

149
00:10:46,020 --> 00:10:46,890
!أنت

150
00:10:47,980 --> 00:10:49,060
!أفان

151
00:10:49,230 --> 00:10:50,440
!تعويذة تحوُّل

152
00:10:50,600 --> 00:10:51,600
!ماذا؟

153
00:10:51,770 --> 00:10:56,360
باستخدام تعويذة التحوُّل، كان
!يتظاهر بأنّه كيلفارن

154
00:10:56,530 --> 00:10:57,860
هذا صحيح

155
00:10:58,030 --> 00:11:02,870
أتيتُ للانضمام لكم، لكن كان
هيونكل يحلّ اللّغز

156
00:11:03,030 --> 00:11:07,700
لذا ارتأيتُ أن أتّخذ هيئة كيلفارن
وأكشف عن السرّ

157
00:11:08,200 --> 00:11:10,540
...فأساساً، قالها بنفسه

158
00:11:10,830 --> 00:11:15,170
،قد يكون مُلزماً بمساعدة ملك الشّياطين
لكن هذا ليس واجبه

159
00:11:15,340 --> 00:11:17,460
أين كيل؟ ماذا حدث له؟

160
00:11:17,960 --> 00:11:21,680
بما أنّني هنا، هناك جواب وحيد فقط

161
00:11:22,430 --> 00:11:26,010
حاصد الأرواح... كان الشّخص الّذي مات

162
00:11:28,930 --> 00:11:31,480
ميدروا

163
00:11:33,900 --> 00:11:36,480
مزمار حاصد الأرواح

164
00:11:37,150 --> 00:11:40,820
حاصد الأرواح... كان الشّخص الّذي مات

165
00:11:40,990 --> 00:11:44,870
إذا هزمَه داي فالأمر قد انتهى

166
00:11:45,030 --> 00:11:49,620
،قد أكون مُلزماً بمساعدة ملك الشّياطين
لكن هذا ليس واجبي

167
00:11:49,790 --> 00:11:52,170
لستُ مثل ميستو

168
00:11:55,250 --> 00:11:58,590
أريد أن أعرف كيف لستَ مثله

169
00:12:08,350 --> 00:12:11,680
!قفّازه فقط؟! وهو مليء بالرّمل؟

170
00:12:25,490 --> 00:12:26,490
!أفان

171
00:12:27,160 --> 00:12:30,040
يبدو حتّى أنت تفاجأتَ بهذا

172
00:12:30,540 --> 00:12:33,750
هذا رملٌ سحريٌّ أعددتُه

173
00:12:33,920 --> 00:12:38,670
أستخدم التفتّح القمريّ لأجعله
كمُؤشِّر ضدّ الأأعداء

174
00:12:38,840 --> 00:12:42,880
يمكنني استخدام تعويذة التقاء
للوصول إلى حيث تمّ وضع هذا

175
00:12:43,050 --> 00:12:47,180
ويفلح هذا حتّى لو كان البُعد مُغلقاً

176
00:12:47,930 --> 00:12:50,520
،كنتَ لتُدرك لو رميتُه عليك

177
00:12:50,680 --> 00:12:56,020
لذا وضعتُ بعضاً منه داخل قفّازتي
وأمسكتُ بساقك

178
00:12:56,650 --> 00:12:59,230
،لعلّك أردتَ قطع مِعصمي

179
00:12:59,400 --> 00:13:01,650
،لكن سحبتُ يدي في تلك اللّحظة

180
00:13:01,820 --> 00:13:06,410
واسترجعتُ قفّازي وأعدتُ الرّمل إلى هذا البُعد بنجاح

181
00:13:06,950 --> 00:13:10,740
كان آخر رهان لي عندما أمسكَني القاضي

182
00:13:11,160 --> 00:13:15,000
!ليست خدعك الاستعراضيّة الرّخيصة ما فاجأني

183
00:13:15,160 --> 00:13:17,420
!لماذا؟! لماذا ما زلتَ حيّاً؟

184
00:13:17,580 --> 00:13:19,380
!بعد ميغانتي الخاصّة بالقاضي

185
00:13:20,000 --> 00:13:21,210
لا علم

186
00:13:21,380 --> 00:13:23,340
لا يمكنني تسمية هذا إلّا بالمعجزة النّادرة

187
00:13:24,220 --> 00:13:29,010
قد أكون البشريّ الوحيد الّذي واجهَ
تعويذة ميغانتي مرّتين في حياته

188
00:13:29,800 --> 00:13:35,230
لكن بما أنّني نجوت، كلّ ما تبقّى هو
استخدام ما بقي لي من حياتي ضدّك

189
00:13:35,390 --> 00:13:37,310
!ها أنا ذا يا كيلفارن

190
00:13:37,690 --> 00:13:39,150
!ضربة الموج

191
00:13:39,860 --> 00:13:40,940
!إنّه سريع

192
00:13:42,400 --> 00:13:46,990
!ينبغي أن يكون قد تكبّد أضراراً جسيمة
!ومع ذلك ما زال صامداً

193
00:13:47,160 --> 00:13:53,040
!أُدعى بحاصد الأرواح، لكن ولأوّل مرّة، أنا خائف

194
00:13:53,200 --> 00:13:58,250
،استخدمتُ كلّ الفِخاخ الّتي أعرفها ضدّه
!فكيف لا يزال على قيد الحياة؟

195
00:14:01,210 --> 00:14:02,300
ما رأيك؟

196
00:14:02,460 --> 00:14:05,800
استخدمتَ كلّ شفرات الشّبح
خاصّتك، والقاضي قد اختفى

197
00:14:05,970 --> 00:14:08,340
!أشكّ في أنّك حضّرتَ أيّ فخّ آخر

198
00:14:10,220 --> 00:14:12,100
!هذه المرّة، انتهى الأمر فعلاً

199
00:14:18,560 --> 00:14:20,560
لا تقلق بشأني

200
00:14:20,730 --> 00:14:24,400
يمكنني البقاء حتّى ببتر أطرافي أو جذعي

201
00:14:24,940 --> 00:14:29,990
لا أنا بمجنون ولا بانتحاريّ، لذا
!لا داعي لأيّ مخاوف

202
00:14:35,790 --> 00:14:38,250
!ما هذه الكرة؟

203
00:14:39,170 --> 00:14:43,290
ذراع واحدة ينبغي أن تكون كافية للإجهاز عليك

204
00:14:43,460 --> 00:14:49,680
لم أرغب يوماً في أذيّة نفسي، لذا أن تدعني
أستخدم هذا لَهو إنجاز عظيم يا أفان البطل

205
00:14:49,840 --> 00:14:53,470
أنت أحد الرّجال القلائل الّذين يهابهم الملك فارن

206
00:14:53,640 --> 00:14:57,480
سأنفّذ هجمة أخيرة تستحقّها

207
00:14:57,640 --> 00:14:58,940
...تُدعى

208
00:14:59,350 --> 00:15:01,440
!الجحيم الحارق

209
00:15:02,940 --> 00:15:05,480
!يا لها من كرة ناريّة شديدة

210
00:15:05,820 --> 00:15:09,360
!دمي هو من نفس تركيبة حمم العالم السّفلي

211
00:15:09,530 --> 00:15:14,200
!حالما يشتعل، يُصبح لهيباً ذا حرارة حارقة

212
00:15:14,870 --> 00:15:17,790
!هذه هي ورقته الرّابحة الحقيقيّة

213
00:15:17,950 --> 00:15:21,000
أشكّ في أنّها يمكن إيقافها أو تفاديها

214
00:15:21,170 --> 00:15:25,170
!في هذه الحالة، سأستخدم هجمتي العظمى ضدّها

215
00:15:25,340 --> 00:15:27,210
أفان ستراش، صحيح؟

216
00:15:27,380 --> 00:15:29,470
!لا أعتبر هذه تهديداً

217
00:15:29,630 --> 00:15:32,890
!لا تُقارَن بهذه الهجمة

218
00:15:33,050 --> 00:15:37,470
!تقول هذا وأنت تقاتل بجدّية لأوّل مرّة في حياتك

219
00:15:38,560 --> 00:15:40,520
!لن أسمح بالإهانة

220
00:15:40,690 --> 00:15:46,190
!أتحكّم بالحياة والموت على حدّ سواء
!أنا إله الموت

221
00:15:49,030 --> 00:15:50,070
!أحمق

222
00:15:53,780 --> 00:15:58,790
جميل! كنتُ مُحقّاً في استخدام
!هذه الهجمة للقضاء عليك

223
00:16:04,130 --> 00:16:05,130
!مستحيل

224
00:16:05,460 --> 00:16:09,210
أعتقد ينبغي أن تستمرّ في فعل
!أشياء تبرع فيها

225
00:16:09,380 --> 00:16:10,420
!الوداع يا حاصد الأرواح

226
00:16:11,260 --> 00:16:13,720
!أفان ستراش

227
00:16:15,550 --> 00:16:18,060
!هذا مستحيل

228
00:16:18,220 --> 00:16:21,100
كيف تمكّن من النّجاة من جحيمي الحارق؟

229
00:16:21,270 --> 00:16:22,060
!كيف؟

230
00:16:34,280 --> 00:16:35,320
!هادلَر؟

231
00:16:35,740 --> 00:16:36,910
...آنذاك

232
00:16:37,740 --> 00:16:42,080
...رماد هادلَر عند موته بين ذراعيّ

233
00:16:42,830 --> 00:16:47,960
هل حمَتْني من ميغانتي والجحيم الحارق؟

234
00:16:49,590 --> 00:16:53,630
هادلَر، هل حميتَني؟

235
00:17:07,980 --> 00:17:12,530
أنقذني هادلَر بمُعجزة

236
00:17:12,690 --> 00:17:17,320
أظنّه كان يمقت ما فعلتَه يا حاصد الأرواح

237
00:17:17,490 --> 00:17:19,120
!كيف تجرؤ؟

238
00:17:19,280 --> 00:17:23,660
كيف لشيء غامض ومُبهَم مثل
!مُعجزة أن يهزمني؟

239
00:17:24,080 --> 00:17:28,790
كان جسد هادلَر مُكوَّناً من خلايا الشّيطان الّتي
تستطيع إطلاق طاقة ناريّة ظلاميّة

240
00:17:28,960 --> 00:17:33,380
!ظلّتْ كرماد لتقيك من الحرارة

241
00:17:33,550 --> 00:17:36,220
!فهمت. هذا هو التّفسير الوحيد

242
00:17:36,720 --> 00:17:40,260
!...المُعجزة... المُعجزة لا يمكن لها أن

243
00:17:41,930 --> 00:17:43,430
،عندما استخدمتُ أفان ستراش

244
00:17:43,600 --> 00:17:49,060
فإنّ بقايا اللّهب حولي وصلَتْ إلى جسده

245
00:17:51,190 --> 00:17:54,610
أشعلَتْ دمَ الحمم الّذي يجري في عروقه

246
00:17:55,360 --> 00:17:58,910
!هذا سيّئ! هذا سيّئ للغاية

247
00:17:59,450 --> 00:18:02,240
!عمود الجليد! رمح الجليد! رماح الجليد

248
00:18:04,370 --> 00:18:08,210
!هذا سيّئ! سأبقى وحيداً

249
00:18:11,040 --> 00:18:14,300
!أرجوك! أتوسّل إليك! ساعدني

250
00:18:16,050 --> 00:18:19,430
!سيتحوّل كيلفارن إلى رماد

251
00:18:19,590 --> 00:18:23,100
!سأخبره ألّا يكون سيّئاً بعد الآن

252
00:18:24,770 --> 00:18:28,890
!أرجوك! أتوسّل إليك

253
00:18:42,370 --> 00:18:43,580
...أفان

254
00:18:45,200 --> 00:18:46,580
!هل أنت بخير؟

255
00:18:46,750 --> 00:18:50,880
أ-أجل. أظنّني كذلك يا بيرورو

256
00:18:51,500 --> 00:18:54,710
أظنّني ينبغي أن أشكر أفان

257
00:18:54,880 --> 00:18:56,920
!أجل. تماماً

258
00:18:59,680 --> 00:19:01,010
لا داعي للشكر

259
00:19:01,180 --> 00:19:05,560
آسف، لكن لا أثق بك تماماً

260
00:19:05,720 --> 00:19:10,600
لم أواجه من قبل عدوّاً قاسياً ويفتقر
للفضيلة إلى هذا الحدّ

261
00:19:10,770 --> 00:19:12,480
لئيم

262
00:19:12,650 --> 00:19:14,690
أصرُّ على أن تقبل هذه

263
00:19:15,070 --> 00:19:19,450
!بدا أنّك تستمتع بشفراتي الشبحيّة

264
00:19:22,320 --> 00:19:23,740
!أجل! أجل

265
00:19:26,450 --> 00:19:29,250
بواسطة بيرورو، يمكنني إعادة تخزين أنصالي

266
00:19:29,410 --> 00:19:35,340
وكما تعلم، أين الوحيد الّذي يعرف
أين تقع الأنصال الـ 13

267
00:19:35,500 --> 00:19:37,760
!والآن انقلبت الموازين

268
00:19:37,920 --> 00:19:39,670
أخبرتُك

269
00:19:39,840 --> 00:19:42,840
كنتُ متأكّداً مئة بالمئة بأنّ هذا سيحدث

270
00:19:43,550 --> 00:19:47,930
لهذا نصبتُ فخاً لك سلفاً

271
00:19:48,100 --> 00:19:48,930
!ماذا؟

272
00:19:49,270 --> 00:19:52,730
...إذا أردت الحفاظ على الحياة الّتي عفوتُ عنها

273
00:19:52,900 --> 00:19:54,770
فلا تتحرّك إذاً

274
00:19:54,940 --> 00:19:58,610
!إنّه يكذب! لا بدّ وأنّها كذبة

275
00:19:58,780 --> 00:19:59,860
بالفعل

276
00:20:00,320 --> 00:20:04,450
أنت؟ نصبت فخّاً؟ لي أنا؟

277
00:20:04,620 --> 00:20:06,450
!لا تُثِرني على الضّحك

278
00:20:18,670 --> 00:20:21,470
شفرة شبحيّة؟

279
00:20:22,010 --> 00:20:24,300
لماذا هذه هنا؟

280
00:20:24,720 --> 00:20:28,890
هذه من البُعد الآخر والتي كانت عالِقة بي

281
00:20:29,060 --> 00:20:32,810
عادَتْ معي إلى هذا البُعد

282
00:20:32,980 --> 00:20:39,020
كان النصل الخفيّ رقم 14 بعد
الـ 13 الّتي حرّرتَها

283
00:20:39,980 --> 00:20:42,740
لهذا لم تعرف أين كانت

284
00:20:42,900 --> 00:20:46,620
زرعتَها عندما أنقذتَني

285
00:20:46,780 --> 00:20:48,580
...استهترتُ كثيراً

286
00:21:02,880 --> 00:21:05,550
هذا سيّئ. لا يمكن أن يُشفَى

287
00:21:05,720 --> 00:21:11,020
حتّى ولو كان خالداً، لا يوجد مخلوق
حيّ يستطيع العيش بلا رأسه

288
00:21:11,350 --> 00:21:14,190
الخاسر يفقد رأسه

289
00:21:14,350 --> 00:21:18,150
هذا قاسٍ، لكن تلك كانت قواعده

290
00:21:18,310 --> 00:21:22,690
!تبّاً! تبّاً

291
00:21:24,740 --> 00:21:26,530
...إذاً كيل

292
00:21:26,700 --> 00:21:27,660
قد انهزم؟

293
00:21:28,160 --> 00:21:32,660
قرينه الصّغير ذاك عاجز عن فعل شيء

294
00:21:32,830 --> 00:21:35,500
حاصد الأرواح كيلفارن قد مات

295
00:21:36,080 --> 00:21:40,460
،والآن، بسببِ ما قلتَه

296
00:21:40,630 --> 00:21:44,340
أعرف هويّتك الحقيقيّة يا ميستوفارن

297
00:21:45,510 --> 00:21:49,890
وكذلك السرّ الأعظم لملك الشّياطين فارن

298
00:21:52,770 --> 00:21:54,810
ما هذا؟

299
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

300
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

301
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

302
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

303
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

304
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

305
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

306
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

307
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

308
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

309
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

310
00:23:33,740 --> 00:23:38,450
بعد الفوز على كيلفارن، أفان يكشف
،السرّ الأعظم لملك الشّياطين

311
00:23:38,620 --> 00:23:40,710
ويبدأ بتعميمه على الجميع

312
00:23:40,870 --> 00:23:46,460
في هذه الأثناء، داي يقذفَ فارن بعيداً
بواسطة دورورا، لكن تتجمّع سحابة مظلمة

313
00:23:46,630 --> 00:23:53,340
تتلاقى خيوط لغز فارن ويغدو اللّغز الأعظم

314
00:23:53,510 --> 00:23:55,800
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

315
00:23:55,970 --> 00:23:57,470
"حقيقة فارن"

316
00:23:57,640 --> 00:23:59,930
!وتستمرّ المغامرة