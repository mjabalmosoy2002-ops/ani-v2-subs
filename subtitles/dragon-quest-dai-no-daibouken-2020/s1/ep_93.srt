1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:51,150 --> 00:01:56,190
والآن ستشعر بغضبي رويداً

20
00:01:58,200 --> 00:02:01,490
أظنّني توصّلتُ لفكرة مُثيرة للاهتمام

21
00:02:02,240 --> 00:02:03,700
الأميرة ليونا

22
00:02:04,040 --> 00:02:07,330
يجب أن تخدميني

23
00:02:14,840 --> 00:02:16,800
!ما-ماذا؟

24
00:02:17,090 --> 00:02:21,430
بعد أن يُدمَّر العالم السّطحي، سأحافظ على حياتكِ

25
00:02:21,930 --> 00:02:24,310
،يمكنك مراقبة فارس التنّين هذا

26
00:02:24,850 --> 00:02:29,940
أمل العالم السّطحي، وهو يُمزَّق بوحشيّة

27
00:02:31,810 --> 00:02:34,400
ثمّ تقضين بقيّة حياتكِ تخدمينني

28
00:02:34,570 --> 00:02:40,860
ستصبحين مُغنّية العالم السّفلي، تتغنّين بقوّتي ورُعبي

29
00:02:41,030 --> 00:02:46,450
سيكون هذا مُسلّياً أكثر من مجرّد قتلكِ ببساطة

30
00:02:46,620 --> 00:02:50,000
يمكنني التمتُّع بذلك لفترة طويلة

31
00:02:50,710 --> 00:02:52,000
ما رأيكِ؟

32
00:02:52,830 --> 00:02:54,880
!لن... لن أفعل هذا أبداً

33
00:02:55,380 --> 00:03:00,090
!لا تكُن غبيّاً! إذا سقطَ داي، فلن أعيش طويلاً أيضاً

34
00:03:00,260 --> 00:03:04,510
!سأقاتل حتّى النّهاية مع داي

35
00:03:04,890 --> 00:03:06,430
...ليونا

36
00:03:06,930 --> 00:03:08,350
!يا لشجاعتكِ

37
00:03:08,520 --> 00:03:13,360
أن تمتلك شابّة يافعة إرادةً قويّةً كهذه

38
00:03:13,520 --> 00:03:15,770
لم ألتقِ بمثيلٍ لكِ من قبل

39
00:03:16,270 --> 00:03:17,980
ازداد إعجابي بكِ الآن

40
00:03:19,360 --> 00:03:22,860
لكن انظري إلى عزيزكِ داي

41
00:03:23,030 --> 00:03:26,330
إنّه على شفير الموت

42
00:03:26,790 --> 00:03:30,540
لا يوجد "إذا". سوف يموت حتماً

43
00:03:33,750 --> 00:03:39,460
إذا كنتُ سأقتله، فإنّني أريده أن
!يكون مُدمّراً بكل معنى الكلمة

44
00:03:39,630 --> 00:03:43,720
أريده أن يرى عظمَتي وحدود قوّتي

45
00:03:43,890 --> 00:03:47,510
وأن يرى الطبيعة الحقيقيّة للبشر والتي يحبّها حبّاً جمّاً

46
00:03:47,680 --> 00:03:51,440
ينبغي أن يعرف اليأس الحقيقيّ قبل أن يموت

47
00:03:51,600 --> 00:03:55,110
هيّا يا أميرة، أمعني النّظر

48
00:03:55,270 --> 00:03:59,230
!راقبي بطلكِ كيف يُسحَق حتّى الموت

49
00:04:16,170 --> 00:04:16,840
!داي

50
00:04:21,630 --> 00:04:24,680
ما الخطب يا داي؟! ألا يمكنك النّهوض؟

51
00:04:24,840 --> 00:04:29,260
هل ستظلّ تتدحرج كدودة؟

52
00:04:30,930 --> 00:04:34,020
ربّما النّهاية الكارثيّة خاصّتي كانت قويّة جدّاً؟

53
00:04:36,270 --> 00:04:40,110
!هذا سيّئ! لا أستطيع الحركة جيّداأً

54
00:04:40,530 --> 00:04:43,200
!انهض! قاوم

55
00:04:47,070 --> 00:04:49,080
لا. يجب أن أراقب

56
00:04:49,950 --> 00:04:53,160
لا ينبغي أن أشيح بنظري عن مُعاناة داي

57
00:04:53,960 --> 00:04:56,080
!سأقاتل أيضاً

58
00:04:56,370 --> 00:04:58,880
!عليّ أن أفعل شيئاً! أيّ شيء

59
00:04:59,040 --> 00:05:01,250
!أيّ شيء ضدّ ملك الشّياطين

60
00:05:01,420 --> 00:05:05,680
!مُجرّد القيام بذلك سيخفّف من مُعاناة داي

61
00:05:11,430 --> 00:05:13,600
والآن حان وقت هذه

62
00:05:22,820 --> 00:05:25,110
!عنقاء القيصر

63
00:06:12,580 --> 00:06:14,830
ما-ما رأيك؟

64
00:06:15,000 --> 00:06:19,420
ما شعورك وأنت تُجرَح بواسطة
فتاة صغيرة يا ملك الشّياطين؟

65
00:06:19,790 --> 00:06:21,250
!هل رأيت ذلك يا داي؟

66
00:06:21,420 --> 00:06:24,340
لم يكن من المُمكن جرح جسد فارن
،حتّى بواسطة غيغا ستراش

67
00:06:24,500 --> 00:06:29,050
لكن ما لم يكن مُركِّزاً تماماً، لا يستطيع
!الحفاظ على مناعته

68
00:06:29,220 --> 00:06:31,850
!حتّى أنا استطعتُ جرحه

69
00:06:32,010 --> 00:06:34,220
!لا شيء في هذا العالم منيع

70
00:06:34,930 --> 00:06:36,310
!مُحال أن يكون كذلك

71
00:06:36,640 --> 00:06:38,730
!لا تنسَ هذا

72
00:06:39,060 --> 00:06:40,520
...ليونا

73
00:06:40,850 --> 00:06:45,230
إن كنت لا تزال تريد أن تحافظ
!على حياتي فامضِ قُدماً

74
00:06:45,400 --> 00:06:48,740
لكن سأخبر الجميع طيلة حياتي

75
00:06:49,490 --> 00:06:53,660
!بأنّني جرحتُ ملك الشّياطين العظيم فارن

76
00:06:53,830 --> 00:06:57,160
!بأنّني المرأة الأقوى في العالم

77
00:07:05,380 --> 00:07:08,720
!لا! انهض! قِف

78
00:07:09,220 --> 00:07:11,180
...إن لم أقف

79
00:07:11,590 --> 00:07:13,050
...فليونا سوف

80
00:07:23,650 --> 00:07:25,150
!ليونا

81
00:07:43,710 --> 00:07:45,500
سوف تندمين على ذلك

82
00:07:45,880 --> 00:07:49,170
لم تعودي قادرة على المقاومة أو التكلّم

83
00:07:49,340 --> 00:07:51,470
!ليونا

84
00:08:02,310 --> 00:08:03,270
!ماذا؟

85
00:08:03,810 --> 00:08:06,110
!أصبحتْ ليونا جوهرة؟

86
00:08:06,270 --> 00:08:09,110
ما هو شعوركِ أيّتها الأميرة ليونا؟

87
00:08:13,570 --> 00:08:14,570
!ليونا

88
00:08:19,910 --> 00:08:23,160
!أين أنا؟! ماذا حلَّ بي؟

89
00:08:23,330 --> 00:08:28,040
قرّرتِ أن تجرحيني، لذا لن أقتلكِ

90
00:08:28,210 --> 00:08:33,260
لن أرضى ما لم تواجهي مصيراً أسوأ من الموت

91
00:08:33,970 --> 00:08:38,430
استهلكتُ قوّتي السحريّة لتحويلكِ
إلى جوهرة تُدعى بالعين

92
00:08:39,220 --> 00:08:43,730
هناك ثلاثة أشياء فقط يمكنكِ فعلها الآن

93
00:08:43,890 --> 00:08:45,940
الرّؤية والسّمع والتّفكير

94
00:08:46,440 --> 00:08:51,280
لا يمكنكِ الحركة ولا يمكن أن يُسمَع صوتكِ

95
00:08:51,440 --> 00:08:57,240
...مهما رأيتِ من مشاهد شنيعة أمامكِ

96
00:08:57,660 --> 00:09:01,080
لا يمكنكِ أن تشيحي بنظركِ

97
00:09:09,340 --> 00:09:11,000
تهانينا يا داي

98
00:09:11,170 --> 00:09:17,390
رغم أنّ جروحك بليغة، لعلّك
ما زلتَ جديراً بمُقاتلتي

99
00:09:20,430 --> 00:09:22,930
!داي! داي

100
00:09:23,100 --> 00:09:24,930
!ليونا، اصمدي

101
00:09:31,230 --> 00:09:33,490
...راقبي من مكانكِ الآن يا أميرة

102
00:09:34,280 --> 00:09:37,570
بينما يُهزَم البطل فاقداً كلّ الآمال

103
00:09:37,950 --> 00:09:42,580
لا يمكنكِ القتال معه ولا يمكنكِ قتل نفسكِ أيضاً

104
00:09:42,990 --> 00:09:47,920
بصفتكِ قائدة العالم السّطحي، لا توجد إهانة أعظم

105
00:09:49,920 --> 00:09:54,710
سوف أعيدكِ حالما تقرّرين التعهُّد
بخدمتي للأبد

106
00:09:56,340 --> 00:09:57,630
!أعدها حالاً

107
00:09:59,340 --> 00:10:02,100
سيتوجّب عليك إيقافي بقوّة السّحر

108
00:10:02,260 --> 00:10:04,350
اهزمني لتتمكّن من إعادتها

109
00:10:04,520 --> 00:10:08,690
لكن يبدو هذا غير مُرجَّح بوضعك

110
00:10:09,020 --> 00:10:14,650
...عليّ هزيمة فارن! إن لم أهزمه هنا، فليونا

111
00:10:14,980 --> 00:10:18,780
لكن حارس السّماء والأرض الشّيطاني خاصّته مثاليّة

112
00:10:18,950 --> 00:10:20,780
!تخلو من أيّ نقطة ضعف

113
00:10:22,870 --> 00:10:26,540
...فهمت! إن لم تكن هناك نقطة ضعف، فإذاً

114
00:10:27,330 --> 00:10:30,630
هذه النّظرة... فكّرَ في شيء ما

115
00:10:31,540 --> 00:10:34,500
!لكن لا أستطيع فعلها بمفردي

116
00:10:34,880 --> 00:10:40,260
حسناً؟ ما الأمر؟ ألم تصل لطريقة ما للمقاومة؟

117
00:10:41,220 --> 00:10:43,430
لا يهمّ في كلّ الأحوال

118
00:10:44,760 --> 00:10:47,640
سوف تُمزّق رغم كلّ شيء

119
00:10:47,810 --> 00:10:49,190
!النّهاية الكارثيّة؟

120
00:10:50,810 --> 00:10:52,610
لا تتفاجأ كثيراً

121
00:10:52,770 --> 00:10:55,230
حارس السّماء والأرض الشّيطاني

122
00:10:55,400 --> 00:10:59,400
ليس ضروريّاً لعنقاء القيصر أو الجدار الكارثيّ

123
00:10:59,570 --> 00:11:04,160
يمكن لقوّة كفّي الإلهيّة أن تُطلَق
في أيّ وقت أيضاً

124
00:11:04,450 --> 00:11:09,870
لمَ أستخدم مهارتي العُظمى ضدّ شخص
فقدَ إرادته للقتال؟

125
00:11:10,920 --> 00:11:13,250
!سأقطِّعك إرباً

126
00:11:24,640 --> 00:11:27,770
داي. هذا سيّئ

127
00:11:27,930 --> 00:11:30,640
بالكاد يمكنك الوقوف

128
00:11:31,190 --> 00:11:33,940
...أن أكون ضعيفة في وقت كهذا

129
00:11:34,110 --> 00:11:36,570
...أن أضطرّ للمشاهدة فقط

130
00:11:38,280 --> 00:11:41,820
!تماماً يا أميرة! أشعر بعذابكِ

131
00:11:41,990 --> 00:11:47,120
أن أشعر بذلك ولو لدقيقة، ولو لثانية
!حتّى لَهو أمر مُمتع للغاية

132
00:11:53,580 --> 00:11:57,920
يجدر بك أن تعلم بأنّ هجمتي السّابقة
كانت مجرّد ضربة كفّ عاديّة

133
00:11:58,960 --> 00:12:02,930
النّهاية الكارثيّة هي هجمتي العُظمى

134
00:12:03,090 --> 00:12:05,850
أُسخّر كلّ قوّتي فيها

135
00:12:06,640 --> 00:12:08,140
هكذا

136
00:12:08,310 --> 00:12:08,970
!داي

137
00:12:09,680 --> 00:12:12,390
!هل يمكنك تحمّل ضربة ثانية؟

138
00:12:22,360 --> 00:12:23,530
!داي

139
00:12:23,700 --> 00:12:26,570
!النّهاية الكارثيّة

140
00:12:37,630 --> 00:12:40,300
!النّهاية الكارثيّة

141
00:12:56,060 --> 00:12:59,230
آسف بشأن ذلك يا سيّد ملك الشّياطين

142
00:12:59,820 --> 00:13:01,360
...أنت

143
00:13:04,490 --> 00:13:07,620
سيترتّب عليك هزيمتنا جميعاً

144
00:13:09,240 --> 00:13:12,160
!لن ينتهي الأمر ما لم تفعل ذلك

145
00:13:12,330 --> 00:13:13,710
!بوب! والجميع

146
00:13:16,290 --> 00:13:18,040
أيُّها الصّاغِرون

147
00:13:18,540 --> 00:13:19,960
!اغربوا عن وجهي

148
00:13:20,380 --> 00:13:22,260
!...احذروا جميعاً! تلك العين

149
00:13:33,980 --> 00:13:38,980
يبدو أنّ معظمكم مُصابون وبالكاد
استطعتُم الوصول إلى هنا

150
00:13:39,150 --> 00:13:41,940
...أولئك الجديرون بمقاتلتي هم

151
00:13:42,110 --> 00:13:47,530
...داي وبوب وأفان وهيم ولارهارت

152
00:13:47,950 --> 00:13:49,870
أنتم الخمسة فقط

153
00:13:50,200 --> 00:13:52,160
!ما الّذي يجري هنا؟

154
00:13:52,330 --> 00:13:54,790
،عند التعرُّض لضوء عين فارن الثّالثة

155
00:13:54,950 --> 00:13:58,080
فإنّ أيّ شخص لا يقوى على القتال
يتحوّل إلى جوهرة

156
00:13:58,250 --> 00:13:59,960
فعلَ ذلك بليونا أيضاً

157
00:14:02,130 --> 00:14:05,010
!إذاً الجميع موجودون في هذه الأشياء؟

158
00:14:05,670 --> 00:14:08,340
يا لها من قوّة سحر مُرعبة

159
00:14:10,050 --> 00:14:12,310
...أن أقطع كلّ هذه المسافة بلا نفع

160
00:14:12,470 --> 00:14:13,510
!اللّعنة

161
00:14:13,680 --> 00:14:14,810
!أخرجوني

162
00:14:18,900 --> 00:14:22,820
هذا صحيح. كان هيونكل من الأساس في وضع حرج

163
00:14:22,980 --> 00:14:26,820
ومام وبروكينا كانا جريحين من المعركة مع ميستو

164
00:14:26,990 --> 00:14:30,620
مع الأسف، أعتقد أنّ الضّخم وتشيو
لم يكونا قويّين بما يكفي

165
00:14:31,490 --> 00:14:34,240
هناك فرق كبير بين الضّخم وتشيو

166
00:14:34,410 --> 00:14:37,960
لكن أعتقد يغدو الأمر نفسه أمام فارن

167
00:14:38,500 --> 00:14:40,250
هل ما زالوا على قيد الحياة في الدّاخل؟

168
00:14:40,420 --> 00:14:42,630
أجل. لكن لا يستطيعون فعل شيء

169
00:14:42,790 --> 00:14:45,760
عظيم. هذا أفضل في الواقع

170
00:14:46,210 --> 00:14:51,010
!ماذا؟! ألا تكترث لما فعله بأصدقائك؟

171
00:14:51,180 --> 00:14:52,890
!ظننتُك أفضل من هذا

172
00:14:53,050 --> 00:14:54,640
يمكن إعادتهم، صحيح؟

173
00:14:54,810 --> 00:14:57,600
قال فارن أنّ هزيمته ستؤدّي إلى عودتهم

174
00:14:57,770 --> 00:15:02,440
إنّه ملك الشّياطين. لن نتمكّن من
تأمين الحماية لجرحانا

175
00:15:03,270 --> 00:15:04,150
...بوب

176
00:15:04,570 --> 00:15:09,570
حسبما يبدو، هذه المجوهرات لن تُكسَر بسهولة

177
00:15:09,740 --> 00:15:12,030
مام والأميرة بخير في الواقع

178
00:15:12,200 --> 00:15:16,830
ليس علينا القلق من مقتلهم

179
00:15:17,370 --> 00:15:22,250
هذا قاسٍ بعض الشيء، لكن ستكون
هزيمته أسهل بهذه الطريقة

180
00:15:24,880 --> 00:15:28,800
أنت كثير الضّجيج عادة، لذا
،ظننتُك ستكون أكثر عاطفيّة

181
00:15:28,970 --> 00:15:30,680
لكن يبدو أنّك تستطيع استخدام عقلك

182
00:15:30,840 --> 00:15:32,470
!هذا يعتمد على الوضع

183
00:15:32,640 --> 00:15:35,600
!على أيّ حال، إذا خسرنا، سينتهي العالم السّطحي

184
00:15:36,220 --> 00:15:38,890
!ولن يعود أصدقاؤنا

185
00:15:41,980 --> 00:15:43,400
ماتوريف؟

186
00:15:43,980 --> 00:15:47,480
،إذا كان لأجل هزيمته وإنقاذ أصدقائنا

187
00:15:47,650 --> 00:15:50,190
!سأفعل المستحيل

188
00:15:51,280 --> 00:15:52,410
هكذا إذاً

189
00:15:52,990 --> 00:15:57,620
كان يدرّب بوب أثناء غيابي

190
00:15:59,330 --> 00:16:01,580
يُعيدني هذا للذكريات

191
00:16:02,080 --> 00:16:06,840
أشعر وكأنّ ماتوريف هنا بجانبي

192
00:16:13,300 --> 00:16:18,560
سرعان ما نضجوا وتطوّروا جميعاً

193
00:16:19,140 --> 00:16:21,930
!اهدأ. كُن هادئاً

194
00:16:22,100 --> 00:16:24,850
!الآن هو الوقت المناسب للقتال مثل المُرشِد

195
00:16:25,020 --> 00:16:28,980
الآن بعد أن علمنا بأنّه يستطيع عكس
ميدروا، لم يبقَ لديّ إلّا شيء واحد

196
00:16:29,150 --> 00:16:34,490
إنّها هذه العقليّة الحادّة الّتي جعلَتْني
!أنا وأصدقائي نتجاوز العقبات

197
00:16:36,740 --> 00:16:39,990
أعتقد كلّما زاد عدد المشاهدين كان أفضل

198
00:16:40,160 --> 00:16:45,880
عليكم أن تشهدوا سقوط البطل
داي، أمل العالم السّطحي

199
00:16:46,420 --> 00:16:49,210
لكن ينبغي أن تعتزّوا جميعاً

200
00:16:55,180 --> 00:16:58,850
أنتم شهود على التّاريخ

201
00:17:00,720 --> 00:17:02,520
!اصرخي أيّتها السّماوات

202
00:17:16,200 --> 00:17:17,780
!زمجري أيّتها الأرض

203
00:17:29,540 --> 00:17:31,380
...هنا والآن

204
00:17:32,170 --> 00:17:35,130
!عصر الظّلام قد حان

205
00:17:36,090 --> 00:17:39,930
!والآن... فلتشهدوا هذا

206
00:17:40,890 --> 00:17:41,640
!...هذا

207
00:17:41,810 --> 00:17:43,470
!اشفِ فخامته داي

208
00:17:43,640 --> 00:17:44,310
!حسناً

209
00:17:44,480 --> 00:17:46,060
...سنستغلّ هذا الوقت

210
00:17:46,230 --> 00:17:47,600
!للتصدّي له...

211
00:17:47,770 --> 00:17:51,900
لا! لا تندفعوا نحو حارس السّماء
!والأرض الشّيطاني خاصّته

212
00:17:52,690 --> 00:17:57,360
!إنّها المهارة العُظمى لملك الشّياطين
!...حتّى أنتم الثّلاثة لن تستطيعوا

213
00:17:58,950 --> 00:18:00,120
!انتظروا

214
00:18:02,030 --> 00:18:04,370
!ماذا تفعل يا بوب؟! علينا إيقافهم

215
00:18:04,540 --> 00:18:05,960
!اثبت مكانك فحسب

216
00:18:11,590 --> 00:18:13,050
!أفان ستراش

217
00:18:13,210 --> 00:18:14,960
!مخلب القَطْع

218
00:18:15,130 --> 00:18:16,550
!بُرجُمة الهالة

219
00:18:18,550 --> 00:18:20,930
!حارس السّماء والأرض الشّيطاني

220
00:18:38,990 --> 00:18:41,700
!أهذا كلّ ما تستطيعون أنتم الثّلاثة فعله معاً؟

221
00:18:41,870 --> 00:18:47,040
!على الأقلّ غيغا ستراش الخاصّة بداي تمكّنَتْ من جرحي

222
00:18:49,830 --> 00:18:53,710
...رأيتُ ذلك! ردَّ مِخلب القَطْع بقوّة كفّه

223
00:18:53,880 --> 00:18:57,470
...وردعَ أفان ستراش بعنقاء القيصر

224
00:18:57,630 --> 00:19:00,680
!وحطّمَ بُرجُمة الهالة بضربة كفّ

225
00:19:01,220 --> 00:19:04,680
!هجوم ودفاع وسحر في حركة واحدة

226
00:19:04,850 --> 00:19:07,270
!هذه هي مهارة فارن العُظمى إذاً

227
00:19:07,430 --> 00:19:12,230
!لماذا؟! لماذا تخلّيتَ عنهم جميعاً يا بوب؟

228
00:19:12,400 --> 00:19:16,820
...أسلوب فارن لا يُهزَم! أعلم ذلك، ولهذا

229
00:19:20,110 --> 00:19:23,740
--هذا جيّد! إنّهم أحياء! علينا منعهم من

230
00:19:25,200 --> 00:19:29,370
!لماذا لا يقضي عليهم؟ جميعهم في حالة يُرثى لها

231
00:19:29,540 --> 00:19:34,250
!بمقدوره إبادتهم بتعويذة قويّة واحدة

232
00:19:35,290 --> 00:19:37,170
هل يلعب معهم؟

233
00:19:37,800 --> 00:19:41,300
لا، الأمر ليس كذلك. إنّه لا يُبدي أيّ ثغرة

234
00:19:42,840 --> 00:19:44,300
أيُعقَل...؟

235
00:19:44,800 --> 00:19:46,930
حسناً، ماذا الآن؟

236
00:19:47,100 --> 00:19:49,520
هل ستستسلمون وتستنجدون على أرواحكم؟

237
00:19:49,680 --> 00:19:54,860
أم أنّكم ستواجهون من جديد مهارتي المُميتة العُظمى؟

238
00:19:55,020 --> 00:19:59,570
!أمام هذا الخيار، ليس هناك إلّا جواب واحد

239
00:19:59,740 --> 00:20:02,280
!سوف ننتهز فرصتنا

240
00:20:03,410 --> 00:20:04,910
جواب مُوفَّق

241
00:20:05,070 --> 00:20:08,950
لكن يبدو أنّ أحدكم لن يتمكّن من ذلك

242
00:20:11,080 --> 00:20:12,160
!المُعلّم أفان

243
00:20:20,050 --> 00:20:20,760
!المُعلّم

244
00:20:23,130 --> 00:20:28,180
أنا مسرور لأنّك سقطتَ بسرعة يا أفان

245
00:20:28,350 --> 00:20:33,100
بغضّ النّظر عن القوّة القتاليّة، لا يمكن الاستهانة بعقلك

246
00:20:33,270 --> 00:20:35,520
تحرُّكاتك لا يمكن توقّعها

247
00:20:35,690 --> 00:20:38,730
والرّجل الأذكى في العالم السّطحي

248
00:20:38,900 --> 00:20:43,610
لسوء حظّك، ما زال هناك شخص أذكى منّي

249
00:20:47,830 --> 00:20:50,830
!ا-المُعلّم

250
00:20:51,000 --> 00:20:53,540
!...أنا آسف! أنا... أنا

251
00:20:53,710 --> 00:20:59,380
أتفهّم سبب إمساكك بداي رغم
معرفتك بما كان سيحدث

252
00:21:00,460 --> 00:21:04,180
وحدها هجمة البطل ما يستطيع هزيمة ملك الشّياطين

253
00:21:04,630 --> 00:21:10,390
كنتَ تتّبع النصيحة الّتي أسديتُها إلى الأميرة ليونا

254
00:21:12,140 --> 00:21:16,270
مثلما داي هو البطل الوحيد القادر
...على هزيمة ملك الشّياطين

255
00:21:16,440 --> 00:21:19,820
الشّخص الوحيد القادر على تشغيل
...الإمكانيّة الكاملة لداي

256
00:21:19,980 --> 00:21:24,400
هو الشّخص الّذي رافقَه منذ بداية هذه المعركة

257
00:21:24,570 --> 00:21:26,740
بوب... أقصدك أنت

258
00:21:30,830 --> 00:21:34,790
!تعاونا معاً... وحقِّقا النّصر

259
00:21:37,040 --> 00:21:39,460
!مُعلِّم

260
00:21:55,600 --> 00:22:00,480
!المُعلِّم أفان

261
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

262
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

263
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

264
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

265
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

266
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

267
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

268
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

269
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

270
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

271
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

272
00:23:34,070 --> 00:23:36,830
حتّى مع تحوّل فان إلى جوهرة عين

273
00:23:36,990 --> 00:23:39,660
داي وأصدقاؤه يُهزَمون شرّ هزيمة

274
00:23:39,830 --> 00:23:43,920
وحلفاؤه العالقون في مجوهرات العين
لا يستطيعون فعل شيء سوى الصُّراخ

275
00:23:44,080 --> 00:23:47,590
الوضع سيّئ للغاية، وللتغلُّب على
،مهارة ملك الشّياطين العظمى

276
00:23:47,760 --> 00:23:52,800
،حارس السّماء والأرض الشّيطاني
يرسم بوب المُستميت خطّة

277
00:23:52,970 --> 00:23:55,180
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

278
00:23:56,930 --> 00:23:59,060
!وتستمرّ المغامرة