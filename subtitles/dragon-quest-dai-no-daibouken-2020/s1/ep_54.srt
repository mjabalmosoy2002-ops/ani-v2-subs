1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:51,940 --> 00:01:52,820
!دويّ؟

20
00:02:07,710 --> 00:02:09,960
!تـ-تبّاً

21
00:02:10,580 --> 00:02:12,250
--لهيـ

22
00:02:12,420 --> 00:02:13,210
!داي

23
00:02:26,730 --> 00:02:29,100
!هذا صعبٌ للغاية

24
00:02:29,440 --> 00:02:31,520
لا يمكننا الفوز هكذا

25
00:02:31,690 --> 00:02:33,480
!لظى

26
00:03:18,650 --> 00:03:21,360
الدّفاع باستخدام الهالة التنّينيّة

27
00:03:21,530 --> 00:03:23,530
الابن كأبيه

28
00:03:23,700 --> 00:03:29,410
أدرك باران أنّ جسد هدلر يحتوي على نواة سوداء

29
00:03:29,580 --> 00:03:34,750
تهانينا يا ميستوفارن. قد يحظى هدلر بفُرصة

30
00:03:35,590 --> 00:03:40,260
،هجمات وتعويذات فرسان التنّين قويّة جدّاً

31
00:03:40,420 --> 00:03:42,470
وسوف تفعّلها النُّواة على الأرجح

32
00:03:42,970 --> 00:03:48,060
خوفهما من ذلك سيمنعهما من استخدام كامل قوّتهما

33
00:03:48,220 --> 00:03:49,430
!أنتما

34
00:03:50,560 --> 00:03:52,810
!لماذا تتحفّظان؟

35
00:03:53,310 --> 00:03:57,940
هل يُعقل أنّ فارسَي التنّين العظيمين
!قد فقدا شجاعتهما

36
00:03:59,320 --> 00:04:03,410
لا يمكن أن يكون السّبب هو لأنّكما
غير معتادين على القتال معاً

37
00:04:03,570 --> 00:04:06,070
!باران! أين الرّعد الصّاعق خاصّتك؟

38
00:04:09,200 --> 00:04:13,210
!داي، أنت أيضاً! ألا تريد الثأر لمُعلّمك الميّت؟

39
00:04:14,210 --> 00:04:18,630
!ألا تريد الانتقام منّي؟

40
00:04:26,180 --> 00:04:29,180
!فهمت! هدلر لا يعلم

41
00:04:29,350 --> 00:04:31,770
!ربّما إذا أخبرتُه، سيتوقّف عن القتال

42
00:04:32,430 --> 00:04:33,980
...اسمع يا هدلر! لديك

43
00:04:34,140 --> 00:04:35,060
!لا تفعل

44
00:04:36,020 --> 00:04:37,560
!يجب ألّا تخبره

45
00:04:37,730 --> 00:04:39,520
!لمَ لا؟

46
00:04:39,690 --> 00:04:45,240
يمكن للنُواة السّوداء أن تتفعّل بواسطة
القوّة السحريّة الخاصّة بصانعها

47
00:04:45,780 --> 00:04:50,580
حالما يُلاحظ هدلر النّواة السّوداء، سوف
يفعّلها فارن على الفور

48
00:04:51,040 --> 00:04:56,040
سيفعلها لإيقاف هدلر من الثّوران ضدّه

49
00:04:57,500 --> 00:04:58,630
!ما الخطب؟

50
00:04:59,630 --> 00:05:05,470
سنكون بخير. إذا ركّزنا كلّ طاقتنا
على الدّفاع، ينبغي أن ننجو

51
00:05:05,840 --> 00:05:11,100
!لكن أصدقاءك في السطح سيهلكون بالتأكيد

52
00:05:11,430 --> 00:05:13,100
!لماذا تتردّدان؟

53
00:05:14,480 --> 00:05:15,690
...على هذا المُعدّل

54
00:05:15,850 --> 00:05:20,020
كم هذا مُريب. ما الّذي تخطّطان له؟

55
00:05:20,480 --> 00:05:22,150
!لا نخطّط لشيء

56
00:05:22,530 --> 00:05:24,110
!صعق

57
00:05:33,040 --> 00:05:38,420
!كنّا نتحفّظ فقط لتحليل مدى قوّتك

58
00:05:38,580 --> 00:05:42,340
!كما تشاء، سأواجهك بسيفي الأعظم

59
00:05:42,500 --> 00:05:46,340
فهمت. كنتما تختبرانني إذاً

60
00:05:47,010 --> 00:05:48,590
يسرّني سماع ذلك

61
00:05:48,760 --> 00:05:50,300
!ماذا تفعل؟

62
00:05:50,470 --> 00:05:53,140
إنّها مُجازفة، لكن لا أملك خياراً

63
00:05:54,100 --> 00:05:56,560
!سوف أدعه ينفجر هنا

64
00:05:57,770 --> 00:06:02,570
إذا قطعتُ رأسه فلا ينبغي أن تنفجر فوراً

65
00:06:03,070 --> 00:06:06,860
ينبغي أن يستغرق فارن وقتاً لتفجيره أيضاً

66
00:06:07,530 --> 00:06:13,290
حينئذ سأستخدم هالتي التنّينيّة لاحتواء الانفجار

67
00:06:13,450 --> 00:06:15,160
!هذه فكرة جنونيّة

68
00:06:15,750 --> 00:06:21,210
!لا نعلم ما إن كان يمكن احتواؤها بهالة تنّينيّة

69
00:06:21,380 --> 00:06:23,920
!هذا خطير جدّاً

70
00:06:32,760 --> 00:06:34,010
...داي

71
00:06:34,680 --> 00:06:37,390
هل تثق بي؟

72
00:06:44,860 --> 00:06:46,280
ما جوابك؟

73
00:06:49,740 --> 00:06:53,740
أ-أثق بقوّتك أكثر من أي شخص

74
00:06:55,290 --> 00:06:56,700
إجابة جيّدة

75
00:06:57,160 --> 00:07:00,210
وأنا أثق بقوّتك أيضاً

76
00:07:01,460 --> 00:07:05,670
بعد أن رأيتُك تقاتل ذلك العضو في
الحرس الملكيّ وهدلر، أدركت

77
00:07:06,710 --> 00:07:10,470
أنّك أقوى بكثير ممّا كنت وقتما قاتلتني

78
00:07:10,630 --> 00:07:13,510
أنت تبهرني بدرجة تطوّرك

79
00:07:14,850 --> 00:07:17,640
لكن هذا شيء لا يستطيع سوايّ فعله

80
00:07:17,810 --> 00:07:22,400
فقط بمهارات سيفي وغزارة الهالة التنّينيّة

81
00:07:22,810 --> 00:07:25,730
لذا أريدك أن تثق بي هنا

82
00:07:26,440 --> 00:07:31,610
أخرج أصدقاءك من هنا تحسُّباً

83
00:07:32,320 --> 00:07:34,740
اسلك تلك الفتحة نحو السّطح

84
00:07:36,030 --> 00:07:42,000
!مهما حدث لي، أعدك أن أتولّى أمر هدلر

85
00:07:43,000 --> 00:07:45,960
أترك مُقاتلة فارن عليك

86
00:07:46,750 --> 00:07:48,250
عِدني أنّك ستربح

87
00:07:49,340 --> 00:07:52,800
لأجلك ولأجل من يؤمنون بك

88
00:08:08,270 --> 00:08:10,820
!يا لها من قوّة هائلة نمتلكها

89
00:08:11,570 --> 00:08:14,660
!لديك سيفك الأعظم، الرّعد الصّاعق

90
00:08:14,820 --> 00:08:18,280
!وأنا لديّ هجوم الاحتراق القاطع الخارق

91
00:08:18,990 --> 00:08:21,660
كلاهما يشحنان سيفينا بطاقة هائلة

92
00:08:21,830 --> 00:08:26,710
!تنفجر في لحظة التأثير وتدمّر أعداءنا

93
00:08:27,460 --> 00:08:31,670
!بصيغة أخرى، أوّل من يُصيب الهدف يربح

94
00:08:35,890 --> 00:08:37,930
هكذا إذاً

95
00:08:38,100 --> 00:08:40,890
ولا أحد منّا بحاجة لهجمة ثانية

96
00:08:41,850 --> 00:08:45,980
هجمتي وهجمتك قويّتان بما يكفي لحسم الأمور

97
00:08:46,520 --> 00:08:50,320
ربّما... ينبغي أن أساهم أيضاً؟

98
00:08:50,730 --> 00:08:55,860
ربّما استخدام هالتي التنّينيّة للمساعدة
...في احتواء الانفجار

99
00:08:56,030 --> 00:08:57,700
!لا تتدخّل

100
00:09:02,370 --> 00:09:07,170
إذا تدخّلت، فهذا سيزيد من فُرص فشلي

101
00:09:07,460 --> 00:09:09,090
!...لـ-لكن

102
00:09:09,250 --> 00:09:12,880
ألم تقل أنّك تثق بقوّتي؟

103
00:09:17,970 --> 00:09:19,100
!حسناً

104
00:09:19,260 --> 00:09:23,350
!حالما أتحقّق من سلامة بوب والآخرين، سأعود للمساعدة

105
00:09:24,100 --> 00:09:27,440
!عِدني أنّك لن تفشل

106
00:09:28,860 --> 00:09:29,900
أجل

107
00:09:30,440 --> 00:09:32,480
أعدك أنّني سأكون بخير

108
00:09:34,650 --> 00:09:36,070
!ها أنا ذا

109
00:09:36,360 --> 00:09:37,990
!هدلر! حان الوقت

110
00:09:38,160 --> 00:09:41,200
!أرِني قوّة التنّين الحقيقيّة

111
00:09:41,370 --> 00:09:42,790
!اذهب يا داي

112
00:09:45,710 --> 00:09:46,870
!الرّعد الصّاعق

113
00:09:47,040 --> 00:09:48,830
!هجوم الاحتراق القاطع الخارق

114
00:09:49,750 --> 00:09:51,170
!نلتُ منك

115
00:09:53,760 --> 00:09:54,840
!ماذا؟

116
00:09:55,590 --> 00:09:56,800
...انتهى الأمر

117
00:09:57,300 --> 00:09:58,340
!يا هدلر

118
00:10:00,390 --> 00:10:02,180
!فـ-فعلها

119
00:10:05,180 --> 00:10:07,730
!مستحيل! لم تخترق

120
00:10:09,600 --> 00:10:10,230
!احذر

121
00:10:16,610 --> 00:10:18,240
!د-داي؟

122
00:10:23,490 --> 00:10:24,910
!دينو

123
00:11:00,280 --> 00:11:01,410
!ابتعد

124
00:11:03,700 --> 00:11:06,370
!دينو! تماسك يا دينو

125
00:11:06,830 --> 00:11:09,580
!لا! الجرح عميق جدّاً

126
00:11:10,290 --> 00:11:12,790
!إذا لم يُعالَج، قد يموت

127
00:11:16,300 --> 00:11:17,260
!دينو

128
00:11:18,380 --> 00:11:19,880
دينو؟

129
00:11:20,050 --> 00:11:22,640
تقصدني أنا

130
00:11:24,140 --> 00:11:26,430
يبدو أنّها لم تنجح

131
00:11:26,600 --> 00:11:34,810
غريب. كان رعدك الصّاعق أقوى بكثير
عندما قاتلتني

132
00:11:36,520 --> 00:11:38,480
!هذا يكفي! لا تتكلّم

133
00:11:38,650 --> 00:11:40,490
!دعني أعالجك

134
00:11:43,620 --> 00:11:47,950
!لماذا؟ لماذا ما زال رأسي متّصلاً بجسدي؟

135
00:11:48,410 --> 00:11:53,580
شنّ باران هجوماً ضمن المدى المثاليّ لضربة قاتلة

136
00:11:54,290 --> 00:11:57,920
كيف أتلقّى ضربة قاتلة من قائد
فرسان التنّين باران

137
00:11:58,090 --> 00:12:01,420
وما زلتُ أحافظ على رأسي؟

138
00:12:01,930 --> 00:12:03,430
!كيف؟

139
00:12:04,430 --> 00:12:07,930
اسمح لي أن أجيب عن هذا السّؤال

140
00:12:08,310 --> 00:12:09,310
!أنت

141
00:12:09,470 --> 00:12:11,520
!ما زلت على قيد الحياة؟

142
00:12:13,020 --> 00:12:18,230
سيكون من السيّئ جدّاً أن يُقتل حاصد
أرواح. من الطبيعي أن أكون حيّاً

143
00:12:18,400 --> 00:12:20,320
!مرحباً أيّها الرّجل الّذي لا يموت

144
00:12:20,490 --> 00:12:24,610
كيف بقيت حيّاً بعد أن قطعتُك إلى نصفين؟

145
00:12:24,780 --> 00:12:28,990
تماماً. المشكلة تكمن في قطعي
إلى نصفين يا باران

146
00:12:29,160 --> 00:12:29,950
!ماذا؟

147
00:12:30,120 --> 00:12:35,330
الدّماء في عروقي له نفس تركيبة
الحمم في العالم السّفلي

148
00:12:35,710 --> 00:12:40,380
إنّه حارّ جدّاً ويحتوي على حمض قويّ

149
00:12:41,130 --> 00:12:43,880
أقدمتَ على قطعي إلى نصفين

150
00:12:44,050 --> 00:12:48,890
ليتطاير كلّ دمائي على سيفك التنّيني الشيطانيّ

151
00:12:50,770 --> 00:12:52,770
فكما ترى الآن

152
00:12:52,930 --> 00:12:59,070
دمائي أكسدَ سيفك ليُضعف حدّته

153
00:12:59,650 --> 00:13:05,570
حتّى سيف التنّين الشّيطان لا يستطيع
التجدّد بسرعة بعد ذلك الضّرر

154
00:13:05,950 --> 00:13:12,500
أمام شخص قويّ مثل هدلر هنا، يفقد فعاليّته

155
00:13:13,120 --> 00:13:15,920
هذه لعنتي يا باران

156
00:13:16,830 --> 00:13:21,590
حاصد الأرواح دائماً ما يقتل هدفه

157
00:13:22,300 --> 00:13:25,880
لعلّك تجنّبتني، لكن هناك عواقب

158
00:13:26,590 --> 00:13:29,100
لذا هنا يكمن دورك يا هدلر

159
00:13:29,260 --> 00:13:33,470
أشكّ في أنّك تحبّذ أن أنتزع فريستك
منك، لذا أترك الباقي عليك

160
00:13:33,640 --> 00:13:37,770
احرص على هزيمة باران لأجلي

161
00:13:38,230 --> 00:13:43,320
لم أكن أعلم أنّك أُمِرتَ باغتيال باران يا حاصد الأرواح

162
00:13:43,480 --> 00:13:46,240
كلّ شيء يحيط بك غامض

163
00:13:46,610 --> 00:13:48,070
هذا جرح فظيع

164
00:13:48,910 --> 00:13:50,990
بيرورو، هلّا عالجته؟

165
00:13:51,160 --> 00:13:52,870
سيُشفى فوراً

166
00:13:53,040 --> 00:13:55,330
مهلاً، مهلاً. لا تكن كذلك

167
00:13:56,460 --> 00:14:00,340
تعلّم أن تقبل سخاء الآخرين يا هدلر

168
00:14:00,500 --> 00:14:05,880
حالما يموت باران، تكتمل مهمّتي

169
00:14:06,050 --> 00:14:11,220
وثمّة أمر آخر. أنصح في عدم إظهار أي رحمة

170
00:14:11,390 --> 00:14:13,850
ينبغي أن تسحقهما حالاً

171
00:14:14,180 --> 00:14:21,110
لعلّك تريد معركة نزيهة، لكن يحتاج سيفه
بعض الوقت كي يتجدّد

172
00:14:21,900 --> 00:14:24,230
هل بقي لديك ما يكفي من وقت؟

173
00:14:25,230 --> 00:14:26,030
!كيف لك أن...؟

174
00:14:26,190 --> 00:14:28,200
!مرحى! شُفي تماماً

175
00:14:28,360 --> 00:14:31,370
!يوجد جرح صغير آخر هنا

176
00:14:32,280 --> 00:14:34,700
!دعني أتولّى أمره

177
00:14:41,420 --> 00:14:43,090
!يعلمون

178
00:14:43,250 --> 00:14:47,090
،لا يتراجعون كي يحظى هدلر بالمجد

179
00:14:47,260 --> 00:14:50,090
!إنّما تجنّباً لانفجار النّواة السّوداء

180
00:14:50,260 --> 00:14:54,430
وداعاً وبالتوفيق لك يا هدلر. وأنت أيضاً يا باران

181
00:14:54,600 --> 00:14:56,430
مع أنّ هذا لن يُفيد

182
00:14:58,980 --> 00:15:02,770
كنتُ لأفضّل ألّا أربح معركة بمساعدة حاصد الأرواح

183
00:15:02,940 --> 00:15:08,280
لكن لا أملك الوقت الكافي لانتظاركما
حتّى تجهزان للقتال

184
00:15:08,860 --> 00:15:11,950
!لن أتحفّظ يا باران

185
00:15:12,530 --> 00:15:16,580
،لا! إذا أوقفتُ تعويذة الشّفاء الآن
!فقد لا ينجو دينو

186
00:15:17,200 --> 00:15:21,370
لا أستطيع تركه الآن مهما كانت
الهجمة المُوجّهة نحوي

187
00:15:23,500 --> 00:15:27,210
تختار حماية ابنك إذاً. فليكُن ذلك

188
00:15:27,380 --> 00:15:33,680
!لا أستطيع إطالة هذه المعركة أكثر
!يجب أن أحسم الأمور في الحال

189
00:15:35,220 --> 00:15:37,180
!تـ-تجنّبها

190
00:15:37,350 --> 00:15:40,980
!انسَ أمري واستمرّ في القتال

191
00:15:43,350 --> 00:15:44,940
!انفجار

192
00:16:03,670 --> 00:16:05,380
!د-دينو

193
00:16:09,760 --> 00:16:12,510
!أ-أيّها الأحمق! كيف لك أن تكون طائشاً هكذا؟

194
00:16:16,050 --> 00:16:22,390
أنا بخير. شُفيتُ تماماً الآن

195
00:16:24,310 --> 00:16:26,360
...كفّ عن التّظاهر! جرحك

196
00:16:26,520 --> 00:16:27,440
!لقد سئمت

197
00:16:27,610 --> 00:16:28,400
!ماذا؟

198
00:16:29,110 --> 00:16:36,200
كلّ هذه التّغطية عن بعضنا الآخر
...والتأنّي أثناء القتال

199
00:16:36,370 --> 00:16:37,700
!سئمتُ من ذلك

200
00:16:38,910 --> 00:16:41,330
نحن عائلة، أليس كذلك؟

201
00:16:42,710 --> 00:16:43,960
...دينو

202
00:16:44,420 --> 00:16:50,300
!إن كنّا سنقاتل معاً، فلنقاتل كجسد واحد

203
00:16:50,630 --> 00:16:53,510
إذا تعاونّا نحن الاثنان معاً

204
00:16:53,670 --> 00:16:58,890
!فقد نتمكّن من إيجاد قوّة أخيرة جديدة

205
00:16:59,890 --> 00:17:02,020
...قوّة أخيرة

206
00:17:05,190 --> 00:17:08,060
!حسناً! ها أنا ذا يا هدلر

207
00:17:12,030 --> 00:17:13,820
!تبّاً

208
00:17:14,280 --> 00:17:16,070
!هذا لا يعني شيئاً

209
00:17:16,240 --> 00:17:19,660
!يا لها من قوّة إرادة غير محدودة يمتلكها

210
00:17:35,840 --> 00:17:38,930
حسناً. سأفعل ما تقوله

211
00:17:39,100 --> 00:17:40,350
حقّاً؟

212
00:17:42,470 --> 00:17:44,020
!ماذا كان ذلك؟

213
00:17:44,480 --> 00:17:49,230
داي. من منحك هذا الاسم؟

214
00:17:49,400 --> 00:17:51,480
كان جدّي

215
00:17:52,400 --> 00:17:55,070
عندما انجرفتُ نحو جزيرة ديرملين

216
00:17:56,150 --> 00:17:57,280
مَهدي

217
00:17:58,110 --> 00:18:00,580
كانت توجد عليه لافتة اسم

218
00:18:01,030 --> 00:18:03,910
"لم يبقَ عليها سوى حرف "د

219
00:18:04,080 --> 00:18:08,580
...منحني جدّي هذا الاسم وذلك كي

220
00:18:08,750 --> 00:18:13,380
أشارك الحرف الأوّل من اسمي الّذي
منحني إيّه والدايّ الحقيقيّان على الأقلّ

221
00:18:15,210 --> 00:18:17,840
لماذا أشعر بنُعاس شديد؟

222
00:18:18,260 --> 00:18:21,800
أطلقتُ عليك تعويذة تنويم

223
00:18:22,140 --> 00:18:25,060
اترك القتال لي ونَم

224
00:18:26,310 --> 00:18:29,350
!لماذا؟ سأقاتل معك

225
00:18:29,770 --> 00:18:32,150
اثبت مكانك وستُشفى

226
00:18:32,320 --> 00:18:37,400
أنت فارس تنّين. ينبغي أن تكون
قدرتك الشفائيّة قويّة

227
00:18:37,570 --> 00:18:41,450
لـ-لا! كيف تفعل هذا لي؟

228
00:18:42,450 --> 00:18:47,870
قد يتمنّى الأطفال خِلاف ذلك، لكن
هذا ما يجب على الآباء فعله

229
00:18:48,710 --> 00:18:51,460
ستفهم عندما تكبر

230
00:18:51,790 --> 00:18:53,670
!لا تفعل هذا

231
00:18:53,840 --> 00:18:56,880
!سوف... أقاتل معك

232
00:18:57,380 --> 00:18:59,180
داي"، صحيح؟"

233
00:19:00,470 --> 00:19:02,140
إنّه اسم جميل

234
00:19:02,970 --> 00:19:08,770
لكن آمل أن تتذكّر الاسم الّذي منحتُك
إيّاه أنا وأمّك

235
00:19:09,100 --> 00:19:14,400
"دينو" بلغة مملكة ألكيد يعني "تنّين قويّ"

236
00:19:14,900 --> 00:19:20,530
!لماذا؟! لماذا يفعل الجميع هذا لي؟

237
00:19:20,700 --> 00:19:26,040
حتّى المعلّم... حتّى المعلّم استخدم
تعويذة تحصين عليّ

238
00:19:27,040 --> 00:19:28,370
هكذا إذاً

239
00:19:28,870 --> 00:19:32,080
إذاً فعل أفان الشيء ذاته

240
00:19:33,960 --> 00:19:40,880
يبدو أنّ جزءاً منّي في النّهاية تعلّم
كيف يكون بشريّاً

241
00:19:42,680 --> 00:19:45,890
!لا يمكن أن تكون هذه النّهاية

242
00:19:46,720 --> 00:19:47,810
!لا

243
00:19:49,640 --> 00:19:53,020
...هذا ليس

244
00:19:55,230 --> 00:19:56,480
عدلاً

245
00:20:00,690 --> 00:20:04,030
!هيّا! تصبح على خير يا دينو

246
00:20:05,830 --> 00:20:07,280
!اخلد إلى النّوم

247
00:20:13,870 --> 00:20:16,420
!تصبح على خير يا دينو

248
00:20:17,290 --> 00:20:18,880
ما الأمر يا دينو؟

249
00:20:20,380 --> 00:20:22,220
أنت تفعل ذلك بشكل خاطئ

250
00:20:22,630 --> 00:20:26,140
اخلد إلى النّوم يا دينو. تصبح على خير

251
00:20:27,350 --> 00:20:31,980
يا للعجب، لم تتعلّم طريقة تنويمه بشكل صحيح إلى الآن

252
00:20:32,560 --> 00:20:35,560
يبدو أنّكِ محقّة يا سوالا

253
00:20:39,110 --> 00:20:42,780
لم أتعلّم طريقة تنويمه جيّداً

254
00:20:51,540 --> 00:20:55,920
أنت أبٌ في الصّميم يا باران. تخاطر بنفسك لأجله

255
00:20:56,080 --> 00:20:58,840
حضّر نفسك يا هدلر

256
00:20:59,170 --> 00:21:03,050
...أقسمتُ ألّا أستخدم هذه القوّة ثانية، لكن

257
00:21:04,180 --> 00:21:05,720
!سأستخدمها الآن

258
00:21:06,180 --> 00:21:07,470
!...هذا

259
00:21:08,550 --> 00:21:12,640
!لم أنوّم دينو خوفاً على سلامته

260
00:21:13,770 --> 00:21:19,320
!اتّخذتُ هذه الهيئة الفظيعة عندما تقاتلنا من قبل

261
00:21:19,480 --> 00:21:23,240
!لم أرده أن يراها ثانية

262
00:21:28,240 --> 00:21:30,580
!هذه الهيئة! التنّين الشّيطان

263
00:21:37,710 --> 00:21:43,510
فهمت! خطّتك إذاً هي القتال بأقوى
نمط قتالي لفارس التنّين

264
00:21:44,260 --> 00:21:46,510
!عظيم! أقبل بتحدّيك

265
00:21:50,350 --> 00:21:51,680
!مُت يا هدلر

266
00:21:51,850 --> 00:21:54,810
!فلنذهب إلى الجحيم معاً

267
00:21:57,310 --> 00:22:00,310
!ا-اللّعنة عليك

268
00:22:07,200 --> 00:22:12,080
بصراحة كنتُ أخرق

269
00:22:12,240 --> 00:22:18,420
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

270
00:22:18,920 --> 00:22:23,880
وحتّى أنّني استخدمتُ الوحدة كسلاح

271
00:22:24,050 --> 00:22:29,800
بحثتُ في الدّيماس عن جواب بسيط

272
00:22:29,970 --> 00:22:35,640
حتّى لو تخلّيتُ عن الحقّ واللّطف

273
00:22:35,810 --> 00:22:41,770
أريد أن أكون موجوداً بجانبك فحسب

274
00:22:41,940 --> 00:22:47,400
أن أنادي باسمك

275
00:22:47,570 --> 00:22:53,410
هو أصعب من أي تعويذة سحريّة

276
00:22:53,580 --> 00:22:59,210
رغم أنّك مقرّب جدّاً منّي

277
00:22:59,370 --> 00:23:01,830
أحبّك

278
00:23:02,000 --> 00:23:05,130
أدركتُ ذلك أخيراً

279
00:23:05,300 --> 00:23:10,260
أن أنادي باسمك

280
00:23:10,430 --> 00:23:16,680
هو السّبب الّذي وُلدت لأجله

281
00:23:16,850 --> 00:23:22,610
سأتخلّص من هذا اللّيل الطويل

282
00:23:22,770 --> 00:23:25,320
وآتي لرؤيتك

283
00:23:25,480 --> 00:23:30,070
إلى حيث أنت الآن

284
00:23:33,950 --> 00:23:37,620
تبدأ المعركة ضدّ الحرس الملكيّ التّابع لهدلر

285
00:23:37,790 --> 00:23:40,960
في هذه الأثناء، في قصر فارن، باران ينوّم داي

286
00:23:41,120 --> 00:23:44,130
ويتحوّل إلى التنّين الشّيطان من جديد

287
00:23:44,290 --> 00:23:49,090
بعد الهجوم على ابنه، يفجّر باران
جام غضبه على هدلر

288
00:23:49,260 --> 00:23:54,220
يُراقب ملك الشّياطين فارن المعركة
بهدوء من عرشه

289
00:23:54,390 --> 00:23:56,390
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

290
00:23:58,220 --> 00:24:00,180
!وتستمرّ المغامرة