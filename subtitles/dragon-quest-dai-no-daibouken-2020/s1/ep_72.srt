1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:50,650 --> 00:01:51,690
!صعق

20
00:01:59,490 --> 00:02:02,370
يبدو هذا عقيماً

21
00:02:03,700 --> 00:02:06,960
تعويض الهالة المفقودة بالسّحر

22
00:02:07,410 --> 00:02:10,670
...مع الأسف، رايدن ستراش خاصتك

23
00:02:11,340 --> 00:02:15,880
!أضعف بكثير من هجومك الجديد ذاك

24
00:02:26,310 --> 00:02:28,190
!لماذا تغمد سيفك؟

25
00:02:28,350 --> 00:02:31,980
!فهمت! لديه ذلك الغمد الجديد

26
00:02:33,570 --> 00:02:37,530
!هذا الغمد هو سلاح جديد صُنِع بواسطة لون بيروك

27
00:02:38,240 --> 00:02:42,070
لا يمكن لسيفي أن يصبح أقوى

28
00:02:42,490 --> 00:02:47,660
!لكن بهذا الغمد، يمكنني تعزيز قوّة سيفي السّحري

29
00:02:47,830 --> 00:02:48,870
ماذا؟

30
00:02:49,370 --> 00:02:52,920
...إذا أغمدتُ سيفي السحريّ هكذا

31
00:02:53,380 --> 00:02:56,840
!تتضخّم القوّة السحريّة في الداخل

32
00:02:57,300 --> 00:03:02,800
!عندما أسحبه من جديد، ستصبح التّعويذة ميزته المثلى

33
00:03:03,550 --> 00:03:08,140
!إذاً ستصبح صعق خاصّته تعويذة رعد؟

34
00:03:15,480 --> 00:03:17,030
تعويذة عودة؟

35
00:03:24,530 --> 00:03:26,660
لماذا انتقل إلى هناك؟

36
00:03:26,830 --> 00:03:30,910
يستغرق تضخيم قوّة السّحر وقتاً

37
00:03:31,080 --> 00:03:33,420
فعلَ ذلك لكسب الوقت

38
00:03:33,580 --> 00:03:35,290
هذا ليس كلّ شيء

39
00:03:35,880 --> 00:03:41,680
داي واثق بأنّ هجمته التالية ستكون قويّة جدّاً

40
00:03:42,180 --> 00:03:48,520
!باعدَ بينه وبيننا وذلك كي لا نتأذّى بها

41
00:03:50,100 --> 00:03:53,190
!داي، لن أحاول إيقافك بعد الآن

42
00:03:53,350 --> 00:03:58,480
!أؤمن بقوّتك تلك التي تصنع المُعجزة تلو الأخرى

43
00:03:58,650 --> 00:04:01,490
!هاجمه بكل ما أوتيت من قوّة

44
00:04:19,210 --> 00:04:20,010
...عشرة

45
00:04:21,380 --> 00:04:22,260
...تسعة

46
00:04:23,220 --> 00:04:29,220
،إذا كان يستطيع استخدام تعويذة رعد
فثمّة هجمة واحدة فقط سوف يستخدمها

47
00:04:29,390 --> 00:04:33,350
!الهديّة الأخيرة من أبيه الرّاحل، الرّعد الصّاعق

48
00:04:34,190 --> 00:04:37,940
...بمقدوري إيقافه الآن، لكن

49
00:04:44,570 --> 00:04:45,950
!ما أهمّية ذلك؟

50
00:04:47,410 --> 00:04:50,120
!فاستخدام هذه الهجمة سيقتلني على أيّ حال

51
00:04:53,790 --> 00:04:59,840
!إذاً سأستخدم هذه الثّواني القليلة لتعزيز قوّتي

52
00:05:04,970 --> 00:05:06,130
...خمسة

53
00:05:06,720 --> 00:05:07,970
...أربعة

54
00:05:08,600 --> 00:05:09,680
...ثلاثة

55
00:05:10,510 --> 00:05:11,520
...اثنان

56
00:05:12,140 --> 00:05:13,230
...واحد

57
00:05:21,980 --> 00:05:22,860
!صفر

58
00:05:40,420 --> 00:05:42,500
الرّعد الصّاعق

59
00:05:42,670 --> 00:05:48,340
!توقعت! سوف أواجهها بهجمتي الأخيرة العظمى

60
00:05:48,800 --> 00:05:51,720
...سأستهلك كلّ حياتي

61
00:05:53,140 --> 00:05:55,480
!هجوم الاحتراق القاطع الخارق

62
00:05:55,640 --> 00:05:57,890
هجوم الاحتراق القاطع الخارق

63
00:06:10,530 --> 00:06:11,620
!هيّا

64
00:06:15,330 --> 00:06:18,080
!انظر إلى هذه

65
00:06:27,800 --> 00:06:31,890
!تحطّم قبل هذه الهجمة التي تحتوي على حياتي

66
00:06:32,050 --> 00:06:33,760
!لن تتمكّن من تحطيمها

67
00:06:33,930 --> 00:06:38,480
!هذا ما أدّتْ إليه كلّ معركة

68
00:06:40,940 --> 00:06:46,360
!هذه أعظم هجمة يمكنني تنفيذها

69
00:06:51,070 --> 00:06:52,410
!مستحيل

70
00:07:01,920 --> 00:07:03,420
غيغا ستراش

71
00:07:03,590 --> 00:07:08,170
!غيغا ستراش

72
00:07:33,780 --> 00:07:35,990
...غيغا ستراش

73
00:07:36,160 --> 00:07:38,080
!أحسنت صنعاً

74
00:07:45,750 --> 00:07:48,630
...كلّ ما لديّ

75
00:07:48,800 --> 00:07:50,470
!قد هُزِم

76
00:08:11,110 --> 00:08:12,990
!لقد ربح

77
00:08:14,530 --> 00:08:18,080
!ربحَ حقّاً! فعلَها داي

78
00:08:28,960 --> 00:08:31,050
انتهى الأمر يا هادلَر

79
00:08:31,210 --> 00:08:34,970
...كشيطان خارق، بعد أن انهزمَ هادلَر

80
00:08:36,050 --> 00:08:38,430
سيتحوّل إلى رماد

81
00:08:41,520 --> 00:08:44,480
...آلبيناس... الآن قد فهمت

82
00:08:44,940 --> 00:08:50,020
لماذا كنتِ مستعدّة للتضحية بحياتكِ لمنع حدوث هذا

83
00:08:55,240 --> 00:08:56,530
...هادلَر

84
00:08:57,620 --> 00:08:59,660
لا تقل أيّ كلمة يا داي

85
00:09:00,580 --> 00:09:02,330
خسرت

86
00:09:02,790 --> 00:09:05,040
خسرتُ من جديد

87
00:09:06,040 --> 00:09:10,000
لطالما كنتُ أخسر أمام أفان وتلاميذه

88
00:09:11,840 --> 00:09:14,840
لكن مع ذلك أنا راضٍ

89
00:09:15,220 --> 00:09:18,720
هجمة أفان مع قوّة باران

90
00:09:20,850 --> 00:09:23,180
مُحال أن أتمكّن من هزيمة ذلك

91
00:09:24,520 --> 00:09:28,060
هل كانت تلك هجمة أخرى ابتكرتَها أثناء تدريبك؟

92
00:09:28,230 --> 00:09:29,270
لا

93
00:09:29,730 --> 00:09:31,650
ابتكرتُها الآن

94
00:09:32,480 --> 00:09:33,570
الآن؟

95
00:09:34,320 --> 00:09:39,740
شعرتُ أنّني بحاجة للقوّة التي حصلتُ
...عليها من المُعلّم وأبي

96
00:09:39,910 --> 00:09:42,490
وإلّا ما كنتُ لأستطيع هزيمتك

97
00:09:43,330 --> 00:09:45,710
لذلك جرّبتُها في اللّحظة الأخيرة

98
00:09:52,050 --> 00:09:57,430
إذاً في خضمِّ كلّ ذلك طوّرتَ أقوى هجمة على الإطلاق

99
00:09:59,430 --> 00:10:04,140
لا أصدّق بأنّني خلتُ أنّني هزمتُك

100
00:10:05,480 --> 00:10:07,100
...هادلَر

101
00:10:07,640 --> 00:10:09,190
لا أتحسّر على شيء

102
00:10:09,650 --> 00:10:12,110
في الواقع، أنا مُمتنّ

103
00:10:12,900 --> 00:10:20,120
بدأت حياتي عندما كنتُ في أدنى مستوايّ
حينما عجزتُ عن هزيمتك

104
00:10:20,620 --> 00:10:25,540
كانت قصيرة، لكن كانت مُرضية بحقّ

105
00:10:28,080 --> 00:10:31,840
!الودع يا داي البطل

106
00:10:34,840 --> 00:10:36,420
...كأمنية أخيرة

107
00:10:36,840 --> 00:10:42,180
...دعني ألمس اليد الّتي هزمتني على الأقلّ من فضلك

108
00:10:42,350 --> 00:10:46,640
قبل أن يصبح جسدي رماداً

109
00:11:07,290 --> 00:11:08,370
!ما هذا؟

110
00:11:15,920 --> 00:11:17,340
!ما هذا؟

111
00:11:21,090 --> 00:11:22,390
!مزمار؟

112
00:11:26,470 --> 00:11:27,810
!كيلفارن

113
00:11:30,810 --> 00:11:33,810
آمل أن تكونوا قد استمتعتم بذلك يا أصدقائي

114
00:11:33,980 --> 00:11:37,860
كان ذلك اللّحن مرثاة بسيطة منّي

115
00:11:38,030 --> 00:11:42,860
للشخصين اللّذين قدّما كلّ شيء لاستعراض معركة مدهشة

116
00:11:43,240 --> 00:11:45,330
هذه لهما

117
00:11:45,490 --> 00:11:47,620
!داي! ابتعد من هناك

118
00:11:51,370 --> 00:11:53,500
!خارت قواه

119
00:11:54,960 --> 00:11:56,590
!فات الأوان

120
00:11:56,960 --> 00:11:59,960
!تعالي يا نيران العالم السّفلي

121
00:12:03,430 --> 00:12:04,760
!داي

122
00:12:29,160 --> 00:12:32,580
ما رأيكم؟ أليس فخّي القاتل مُذهلاً؟

123
00:12:32,750 --> 00:12:34,080
!يا للروعة

124
00:12:34,420 --> 00:12:35,750
!فخّ قاتل"؟"

125
00:12:36,710 --> 00:12:38,540
!إنّه فخّ مُميت

126
00:12:38,710 --> 00:12:45,890
قصر فارن مليء بالفخاخ المتنوّعة التي نصبتُها

127
00:12:46,590 --> 00:12:48,720
هذا أحدهم

128
00:12:49,680 --> 00:12:51,680
!تسعة ديناري

129
00:12:51,850 --> 00:12:56,770
إنّها تدعني أستدعي أقوى لهب من
!العالم السّفلي متى شئت

130
00:12:56,940 --> 00:12:58,820
إنّها تعويذة الإنشاء العُظمى

131
00:12:59,690 --> 00:13:06,160
بصراحة، كان بمقدوري تفعيلها في
لحظة دخولكم قصر فارن

132
00:13:06,530 --> 00:13:08,530
!كان ينتظر

133
00:13:09,080 --> 00:13:12,370
!ينتظر إرهاق داي وهادلَر

134
00:13:12,790 --> 00:13:17,290
!حقير! أتجرؤ على تدنيس نِزال مُوقّر؟

135
00:13:17,460 --> 00:13:21,250
!هيونكل! انسَ أمر كيلفارن الآن

136
00:13:21,420 --> 00:13:23,630
!بسرعة! علينا مساعدة داي

137
00:13:23,800 --> 00:13:25,760
لا جدوى أيّتها الآنسة الصّغيرة

138
00:13:26,260 --> 00:13:30,430
ألا ترين أنّ الأوان قد فات بالفعل؟

139
00:13:31,390 --> 00:13:37,190
تجتمع النّيران المُلتهِمة الثّمانية عند النقطة المركزيّة

140
00:13:37,350 --> 00:13:41,400
فتحترق كلّ المخلوقات الحيّة ضمن نطاقها

141
00:13:41,570 --> 00:13:45,900
لا قوّة تستطيع الإفلات منها

142
00:13:46,070 --> 00:13:47,490
!لا

143
00:13:47,660 --> 00:13:51,620
سيموت مع البطل، لذا ينبغي أن يكون هادلَر مسروراً

144
00:14:00,290 --> 00:14:03,670
!لا تحسب أنّ ذلك سيفلح بسهولة

145
00:14:16,270 --> 00:14:17,480
!بوب

146
00:14:17,640 --> 00:14:21,440
!عرفتُ أنّ شيئاً كهذا سوف يحدث

147
00:14:22,610 --> 00:14:27,490
!ما دمتُ هنا، لا تتوقّع أنّ مخطّطاتك ستنجح

148
00:14:39,000 --> 00:14:43,040
!ما دمتُ هنا، لا تتوقّع أنّ مخطّطاتك ستنجح

149
00:14:43,210 --> 00:14:45,460
!بوب؟! أهذا أنت؟

150
00:14:45,630 --> 00:14:48,170
!أجل! داي بخير

151
00:14:48,590 --> 00:14:51,760
!دخلتَ قبل إغلاق الفخّ؟

152
00:14:51,930 --> 00:14:56,140
!توقعتُ أنّ فارن سيُقدِم على شيء ما

153
00:14:56,560 --> 00:15:01,600
،لعلّ هادلَر وحرسه الملكيّ وقورون

154
00:15:01,770 --> 00:15:04,020
!لكن هذا قصر فارن

155
00:15:04,440 --> 00:15:09,240
!لا نثق بمعركة نزيهة مع جيش الشّياطين

156
00:15:09,860 --> 00:15:11,320
...بوب

157
00:15:12,030 --> 00:15:14,780
...ذلك الفتى الشقيّ دائماً

158
00:15:17,620 --> 00:15:19,120
حسناً

159
00:15:21,170 --> 00:15:23,130
اختفى كيلفارن؟

160
00:15:23,290 --> 00:15:27,090
!لماذا يفعل ذلك بعد أن أُحبِطَ فخّه؟

161
00:15:37,350 --> 00:15:41,640
هذا سيّئ! تعويذة رمح الجليد خاصّتي
!لا تستطيع احتواءها فترة طويلة

162
00:15:42,230 --> 00:15:44,900
!فليسرع أحدكم ويفعل شيئاً

163
00:15:45,060 --> 00:15:46,480
!حسناً

164
00:15:46,650 --> 00:15:48,030
!رمح الجليد

165
00:15:51,740 --> 00:15:55,120
!هذا سيّئ! تعويذة رمح الجليد خاصّتي غير كافية

166
00:15:55,280 --> 00:15:57,950
!لكن بوب يحتويها

167
00:15:58,120 --> 00:16:02,210
!قوّة بوب السحريّة أقوى بكثير من قوّتي

168
00:16:04,380 --> 00:16:05,290
!بوب

169
00:16:05,710 --> 00:16:09,050
!أما من شيء... أما من شيء آخر يمكننا فعله؟

170
00:16:09,210 --> 00:16:11,050
...على هذا المُعدّل، هم سوف

171
00:16:12,550 --> 00:16:14,300
!تنحّيا جانباً

172
00:16:18,010 --> 00:16:19,640
!ستستخدم الصّليب العظيم؟

173
00:16:19,810 --> 00:16:23,560
!لا يمكن لهذا الفخّ أن يُكسَر بوسائل عاديّة

174
00:16:23,730 --> 00:16:26,940
!لا بدّ من تدميره بالقوّة العُظمى

175
00:16:27,520 --> 00:16:34,160
من حيث الطاقة النّاتجة، لا هجمة
!تتفوّق على الصّليب العظيم

176
00:16:37,660 --> 00:16:42,790
!بوب! سيستخدم هيونكل الصّليب العظيم! انتبه

177
00:16:44,290 --> 00:16:47,960
!ها أنا ذا يا بوب! توقّع قليلاً من الألم

178
00:16:54,130 --> 00:16:55,760
!الصّليب العظيم

179
00:17:19,990 --> 00:17:21,200
!مستحيل

180
00:17:21,910 --> 00:17:25,670
!كيف لهذا أن يردع صليبي العظيم؟

181
00:17:25,830 --> 00:17:29,500
!أنتم! لم يحدث شيء هنا

182
00:17:31,300 --> 00:17:36,090
لم تؤثّر على الدّاخل؟

183
00:17:37,680 --> 00:17:41,430
...هل يُعقل أنّ... سبب انسحاب حاصد الأرواح

184
00:17:43,060 --> 00:17:46,890
ألا ترى التّعابير الجميلة التي ترتسم
في وجوه البشر؟

185
00:17:47,400 --> 00:17:53,150
حتّى أنا لا أستطيع مُنافستك من حيث الوحشيّة

186
00:17:53,690 --> 00:17:57,360
أنت غالباً الأكثر وحشيّة في العالم السّفلي

187
00:17:57,530 --> 00:17:59,820
هذا شرف لي

188
00:18:02,410 --> 00:18:05,080
!ماذا نفعل؟! ماذا عسانا نفعل؟

189
00:18:06,000 --> 00:18:11,920
ليونا، لا يمكننا الوقوف مكتوفي الأيدي
!ونراقبهم يحترقون

190
00:18:12,250 --> 00:18:13,590
!ليونا؟

191
00:18:14,260 --> 00:18:16,800
!هذا مستحيل

192
00:18:16,970 --> 00:18:21,970
!الأميرة تعلم ذلك! لهذا بقيتْ صامتة

193
00:18:22,310 --> 00:18:25,310
!لا يسعنا فعل شيء

194
00:18:25,470 --> 00:18:26,140
!لا

195
00:18:31,270 --> 00:18:36,570
حتّى طاقة الهالة العظمى الخاصّة
بالصّليب العظيم قد رُدِعت

196
00:18:36,860 --> 00:18:38,740
...معنى هذا

197
00:18:38,900 --> 00:18:44,580
أنّ الفخّ لا يمكن كسره إلّا بوسائل سحريّة

198
00:18:45,200 --> 00:18:50,420
وإلّا فلا يوجد ما يعلّل عدم تأثير الصّليب العظيم به

199
00:18:50,580 --> 00:18:54,380
يحتوي بوب اللّهب في الدّاخل بقوّته السحريّة

200
00:18:54,550 --> 00:19:00,180
لكن هنا، لا أحد منّا يمتلك القوّة السحريّة المُكافئة لها

201
00:19:00,630 --> 00:19:05,640
معنى هذا أنّ هناك طريقة وحيدة لنا لإنقاذهما

202
00:19:05,810 --> 00:19:10,140
!علينا هزيمة كيلفارن، الشّخص الّذي يستخدم التّعويذة

203
00:19:10,520 --> 00:19:15,860
!يعرف ذلك خير معرفة، لهذا انسحب

204
00:19:16,030 --> 00:19:19,240
إلى مكان عميق في قصر فارن

205
00:19:19,400 --> 00:19:23,280
!إنّ البحث عنه وهزيمته الآن سيستغرق وقتاً طويلاً

206
00:19:23,450 --> 00:19:29,000
!لقد بدّدَ الأمل الوحيد لإنقاذهما

207
00:19:39,300 --> 00:19:42,970
...معه حقّ. أنا وليونا لا نمتلك القوّة السحريّة

208
00:19:44,760 --> 00:19:47,350
!ليونا! استخدمي بريق

209
00:19:47,720 --> 00:19:54,230
،كما في كهف المِحَن، ولو كانت ناقصة
...ينبغي لإطلاق تعويذة بريق

210
00:19:55,610 --> 00:19:58,190
هذا غير جيّد... يا مام

211
00:19:59,440 --> 00:20:00,820
لا تنسي

212
00:20:00,990 --> 00:20:05,070
لإيقاف قصر فارن

213
00:20:05,240 --> 00:20:08,580
استخدمتُ بريق سلفاً

214
00:20:09,120 --> 00:20:14,630
هذا المكان متأثّر سلفاً بتعويذة بريق

215
00:20:15,460 --> 00:20:20,260
لن تؤثّر تعويذات التّطهير إذا استخدمها
نفس الشّخص مرّتين

216
00:20:20,420 --> 00:20:22,680
سيكون ذلك مجرّد هدر للقوّة السحريّة

217
00:20:25,260 --> 00:20:29,310
!كيف... كيف لكِ أن تكوني بهذا الهدوء يا ليونا؟

218
00:20:29,470 --> 00:20:30,850
!لستُ هادئة

219
00:20:42,610 --> 00:20:47,030
لكن يجب علينا البقاء ثابتين في وقت كهذا

220
00:20:47,620 --> 00:20:52,330
علينا التّركيز والتّفكير بما يمكننا فعله

221
00:20:53,410 --> 00:20:57,130
عدوّنا بعيد عنّا

222
00:20:57,290 --> 00:21:00,300
!ويمتلك عقلاً عبقريّاً شرّيراً

223
00:21:06,890 --> 00:21:09,310
أنا آسفة يا ليونا

224
00:21:17,860 --> 00:21:19,940
لا جدوى يا مام

225
00:21:20,110 --> 00:21:22,740
!فالقوّة الجسديّة لن تنفع

226
00:21:22,900 --> 00:21:26,740
لو كانت قبضتاكِ أو هجمة الموج خاصّتي
تؤثّر بتلك النّيران

227
00:21:26,910 --> 00:21:31,160
لما غادرَ كيلفارن دون القضاء علينا

228
00:21:32,370 --> 00:21:36,120
!داي، بوب! لا تستسلما

229
00:21:36,290 --> 00:21:38,960
تروقهم مُقاومتهم العقيمة

230
00:22:07,240 --> 00:22:12,120
بصراحة كنتُ أخرق

231
00:22:12,280 --> 00:22:18,460
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

232
00:22:18,960 --> 00:22:23,920
وحتّى أنّني استخدمتُ الوحدة كسلاح

233
00:22:24,090 --> 00:22:29,840
بحثتُ في الدّيماس عن جواب بسيط

234
00:22:30,010 --> 00:22:35,680
حتّى لو تخلّيتُ عن الحقّ واللّطف

235
00:22:35,850 --> 00:22:41,810
أريد أن أكون موجوداً بجانبك فحسب

236
00:22:41,980 --> 00:22:47,440
أن أنادي باسمك

237
00:22:47,610 --> 00:22:53,450
هو أصعب من أي تعويذة سحريّة

238
00:22:53,620 --> 00:22:59,250
رغم أنّك مقرّب جدّاً منّي

239
00:22:59,420 --> 00:23:01,880
أحبّك

240
00:23:02,040 --> 00:23:05,170
أدركتُ ذلك أخيراً

241
00:23:05,340 --> 00:23:10,300
أن أنادي باسمك

242
00:23:10,470 --> 00:23:16,720
هو السّبب الّذي وُلدت لأجله

243
00:23:16,890 --> 00:23:22,650
سأتخلّص من هذا اللّيل الطويل

244
00:23:22,810 --> 00:23:25,360
وآتي لرؤيتك

245
00:23:25,520 --> 00:23:30,110
إلى حيث أنت الآن

246
00:23:33,740 --> 00:23:37,240
وقعَ داي وبوب في فخّ كيلفارن

247
00:23:37,410 --> 00:23:40,660
تُطبِق عليهما نيران العالم السّفلي الهائجة

248
00:23:40,830 --> 00:23:44,250
،مع انحسار لياقتهما وبدء كلّ شيء بالضياع

249
00:23:44,420 --> 00:23:47,460
يُشرق شعاع من الأمل على بوب

250
00:23:47,630 --> 00:23:52,720
هل يستطيع داي وبوب الهرب من فخّ كيلفارن المُميت؟

251
00:23:52,890 --> 00:23:55,350
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

252
00:23:57,510 --> 00:23:59,770
!وتستمرّ المغامرة