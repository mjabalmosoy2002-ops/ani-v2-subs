1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:26,350 --> 00:02:28,640
...رابطي ببوب

20
00:02:30,520 --> 00:02:31,810
!...أصدقائي

21
00:02:41,990 --> 00:02:43,160
أين أنا؟

22
00:02:43,870 --> 00:02:45,120
!لارهارت

23
00:02:46,120 --> 00:02:50,290
أثرتَ وضعاً سيّئاً. مثلما فعلنا جميعنا

24
00:02:50,460 --> 00:02:51,460
!ماذا؟

25
00:02:58,170 --> 00:03:02,090
يبدو أنّنا في قلب قصر فارن بحدّ ذاته

26
00:03:02,430 --> 00:03:05,430
سقطنا من القمّة وعلِقنا هنا

27
00:03:05,600 --> 00:03:06,970
!ماذا؟

28
00:03:15,360 --> 00:03:17,820
!قبضة الانكسار

29
00:03:35,380 --> 00:03:36,460
هذا سيّئ

30
00:03:36,630 --> 00:03:40,630
لا بدّ وأنّ جدران القلب مُشابهة
لجدران مفاعل القوّة الشيطانيّة تلك

31
00:03:41,090 --> 00:03:45,100
تمتصُّ كلّ القوّة السحريّة ولديها
قدرة تجديديّة هائلة

32
00:03:45,260 --> 00:03:48,430
!...لكن أن تمتصّ تعويذة الشّفاء المُفرِط

33
00:03:51,480 --> 00:03:55,190
،نظراً إلى عودتنا إلى طبيعتنا جميعاً

34
00:03:55,360 --> 00:03:58,280
،إمّا داي قد وجّه ضربة حاسمة لملك الشّياطين

35
00:03:58,440 --> 00:04:00,650
أو أنّه قطعَ جريان قوّة السّحر

36
00:04:01,070 --> 00:04:03,990
،إذا حطّمَتْ معركتهما العنيفة قصرَ فارن

37
00:04:04,160 --> 00:04:07,870
فلا يملك فارن قوّة السّحر الكافية
للحفاظ عليه بعد الآن

38
00:04:08,030 --> 00:04:12,120
سوف نسقط نحو السّطح جميعاً مع هذا
القلب ونُقتَل نتيجة الاصطدام

39
00:04:14,670 --> 00:04:18,380
!غير معقول! بعد قطع كلّ هذا الشّوط؟

40
00:04:25,260 --> 00:04:27,390
!ما رأيكم بهذا؟

41
00:04:27,970 --> 00:04:31,850
!ميدروا

42
00:04:41,570 --> 00:04:45,070
!لم أفلح! ولا حتّى هذا

43
00:04:45,240 --> 00:04:51,370
،عند مواجهة هدف يمتصُّ قوّةَ السّحر
حتّى ميدروا لن تفلح

44
00:04:53,250 --> 00:04:54,250
!بوب

45
00:04:55,330 --> 00:04:59,420
أنا بخير. دختُ قليلاً فحسب

46
00:05:00,630 --> 00:05:03,170
!لكن ما زال عقلي صامداً

47
00:05:07,260 --> 00:05:10,510
حتّى هذا الشيء لا يمكن أن يكون منيعاً

48
00:05:10,680 --> 00:05:12,890
!لا بدّ من وجود مخرج

49
00:05:13,680 --> 00:05:14,680
...إنّ داي

50
00:05:17,560 --> 00:05:18,810
...بطلُنا داي

51
00:05:22,230 --> 00:05:27,110
!يخاطر بكلّ شيء للقتال، ولماذا؟

52
00:05:27,700 --> 00:05:32,580
!لا يفعل هذا كي يموت موتاً بلا معنى هنا

53
00:05:42,340 --> 00:05:44,670
!اللّعنة

54
00:05:52,850 --> 00:05:56,430
!جميعنا جرّبنا هجمات الهالة، لكن لم يفلح شيء

55
00:05:56,980 --> 00:05:58,270
!هذا غير صحيح

56
00:06:00,230 --> 00:06:06,400
،انظروا. في حين أنّ قوّة السّحر لا تؤثّر
!تستطيع هجمات الهالة الإضرار به

57
00:06:06,570 --> 00:06:08,610
!المُشكلة هي القوّة

58
00:06:09,200 --> 00:06:14,330
علينا ضرب هذا الجدار بضربة تفوق
!قوّته التجديديّة

59
00:06:14,490 --> 00:06:16,790
!حينئذ يمكننا الإفلات بتعويذة عودة

60
00:06:16,960 --> 00:06:20,710
!لكن لم نعُد نمتلك تلك القوّة

61
00:06:21,330 --> 00:06:25,760
دورورا الخاصّة بداي هي الشيء الوحيد
الّذي استطاع اختراق القلب

62
00:06:27,670 --> 00:06:31,510
لا يمكن للقوّة التدميريّة البسيطة
أن تخترق هذا الجدار

63
00:06:32,010 --> 00:06:34,930
كانت دورورا فارس التنّين قادرة على فعل ذلك

64
00:06:35,100 --> 00:06:38,140
!بسبب طاقة هالتها القاهرة

65
00:06:44,860 --> 00:06:48,240
!مهلاً! ما زال الوقت مبكّراً جدّاً على فقدان الأمل

66
00:06:48,400 --> 00:06:51,620
ثمذ شيء... ثمّة شيء نسيناه

67
00:06:51,780 --> 00:06:55,790
شيء يمكننا فعله
،رغم أنّه ليس بقوّة دورورا

68
00:06:56,200 --> 00:07:00,000
!...إلّا أنّه يستطيع إطلاق هالة بأقصى قوّة

69
00:07:01,830 --> 00:07:03,840
!وجدتُها! وجدتُها

70
00:07:07,420 --> 00:07:08,970
!الصّليب العظيم

71
00:07:09,130 --> 00:07:10,630
!الصّليب العظيم؟

72
00:07:10,800 --> 00:07:11,680
!هكذا إذاً

73
00:07:11,840 --> 00:07:12,840
!فهمت

74
00:07:13,010 --> 00:07:17,930
لا تكُن غبيّاً يا بوب! لا يستطيع
!هيونكل استخدامه بوضعه

75
00:07:18,100 --> 00:07:20,560
!اهدئي يا مام

76
00:07:20,730 --> 00:07:24,270
من الشّخص الّذي علّمَ هيونكل تلك المهارة؟

77
00:07:26,610 --> 00:07:27,610
!هذا صحيح

78
00:07:30,400 --> 00:07:34,530
!المُعلّم أفان هو المُستخدِم الأصليّ للصّليب العظيم

79
00:07:35,990 --> 00:07:37,790
أليس كذلك يا مُعلّم؟

80
00:07:39,750 --> 00:07:41,370
!هيّا يا مُعلّم! بسرعة

81
00:07:46,290 --> 00:07:50,340
!أحسنت صنعاً يا بوب! أنت سريع البديهة

82
00:07:50,510 --> 00:07:53,090
!أحسنتَ صنعاً في إدراك ذلك

83
00:07:53,260 --> 00:07:57,850
!حسناً إذاً، أظنّني ينبغي أن أتولّى الأمور من هنا

84
00:07:58,010 --> 00:07:59,430
!بمُحاولة واحدة سريعة

85
00:07:59,600 --> 00:08:04,150
!مرحى! عليك به يا مُعلّم! مرحى، مرحى

86
00:08:04,310 --> 00:08:05,400
!توقّف

87
00:08:06,110 --> 00:08:07,360
!لا تدعه يا بوب

88
00:08:08,360 --> 00:08:11,070
!هل تريد أن نخسر مُعلّمنا ثانية؟

89
00:08:12,900 --> 00:08:14,700
لا يستطيع أفان فعلها

90
00:08:15,120 --> 00:08:20,200
الصّليب العظيم هو ملاذ أخير للّحظة
الّتي تعجز فيها عن استخدام سيفك

91
00:08:20,370 --> 00:08:22,750
هذه هي المهارة الّتي علّمني إيّاها أفان

92
00:08:22,910 --> 00:08:25,380
إنّها جوهريّاً سلاحٌ سرّي

93
00:08:26,210 --> 00:08:29,090
أنا الوحيد القادر على استخدامه بذلك المستوى

94
00:08:30,090 --> 00:08:33,930
أو بالأحرى، أستطيع استخدامه والنّجاة

95
00:08:35,510 --> 00:08:36,720
هذا صحيح

96
00:08:37,390 --> 00:08:41,180
يمكن أن يصبح الصّليب العظيم هجمة مُدمِّرة ذاتيّاً

97
00:08:41,350 --> 00:08:45,190
...لإطلاق عنانها بأقصى قوّة والنّجاة

98
00:08:45,650 --> 00:08:51,650
بالفعل يا هيونكل، هذه بالفعل مهارة
إعجازيّة اكتسبتَها في المعارك

99
00:08:52,440 --> 00:08:54,900
يمكنك اعتبارها إلهيّة

100
00:08:55,610 --> 00:08:57,910
،قد لا أتمكّن من فعلها

101
00:08:58,070 --> 00:09:01,830
!لكن الآن، سأجرّب المستحيل

102
00:09:02,000 --> 00:09:03,460
!مُعلّم -
!مُعلّم -

103
00:09:03,620 --> 00:09:05,830
!ليس عليك فعل ذلك

104
00:09:06,000 --> 00:09:07,670
!لا سيّما إذا فعلتُها بدلاً عنك

105
00:09:07,830 --> 00:09:10,380
!...لا يمكنك يا هيونكل! إذا فعلت ذلك

106
00:09:10,550 --> 00:09:15,180
لكن لا بدّ أن يضع أحدٌ حياته على المحكّ ويفعلها

107
00:09:15,680 --> 00:09:16,680
أليس كذلك يا مام؟

108
00:09:16,840 --> 00:09:17,510
!...لكن

109
00:09:25,560 --> 00:09:26,980
!الوقت يُداهمنا! سأفعلها أنا

110
00:09:27,150 --> 00:09:28,560
!لا، سأفعلها أنا

111
00:09:34,740 --> 00:09:35,650
!...إنّ هيم الصّغير

112
00:09:35,820 --> 00:09:36,570
!مستحيل

113
00:09:39,450 --> 00:09:40,990
أتذكّره جيّداً

114
00:09:42,160 --> 00:09:45,040
إنّه ذلك الشيء الّذي استخدمته عليّ، صحيح؟

115
00:09:45,830 --> 00:09:48,250
...أقوم بالتّقليد هنا فحسب، لكن

116
00:09:48,420 --> 00:09:50,210
!أعتقد كان بهذا الشّكل

117
00:09:58,010 --> 00:10:00,430
!يستخدم هيم الصّليب العظيم؟

118
00:10:02,810 --> 00:10:04,970
!لا! لا يستطيع جسد هيم تحمُّل ذلك

119
00:10:05,140 --> 00:10:07,640
!توقّف يا هيم! سأفعلها أنا

120
00:10:07,810 --> 00:10:09,600
!دع الأمر لي فحسب

121
00:10:09,770 --> 00:10:11,360
!لا يستطيع أحدٌ فعلها

122
00:10:11,520 --> 00:10:14,570
!إن مُتَّ هنا، فلن أتمكّن أبداً من هزيمتك

123
00:10:14,730 --> 00:10:16,190
!كفاك حماقة

124
00:10:17,650 --> 00:10:18,860
!هيم

125
00:10:20,280 --> 00:10:22,280
...بصراحة

126
00:10:23,580 --> 00:10:27,540
!أعجبتُ بكم! أيُّها البشر

127
00:10:27,710 --> 00:10:31,420
!وأصدقاؤكم كذلك

128
00:10:31,580 --> 00:10:36,010
!أعجبتُ بكم جميعاً! الجميع هنا بلا استثناء

129
00:10:36,590 --> 00:10:41,220
جميعكم ترغبون في التّضحية بأرواحكم
!كي تحموا روابطكم

130
00:10:42,140 --> 00:10:45,060
!أنتم كأصدقائي تماماً

131
00:10:45,560 --> 00:10:51,310
!لا أريد أن أرى أيّاً منكم حزيناً ثانية

132
00:10:53,060 --> 00:10:53,610
!هيم

133
00:10:54,360 --> 00:10:56,690
!لا تستهن بي

134
00:10:57,990 --> 00:11:02,070
...إن كنت لا تُقهَر... إن كنت لا تُقهَر

135
00:11:02,700 --> 00:11:06,790
!فأنا لا أُقهَر أيضاً

136
00:11:24,470 --> 00:11:25,430
!عودة

137
00:11:51,620 --> 00:11:53,790
!إنّه سقوط قصر فارن

138
00:11:58,380 --> 00:12:03,590
هيم الصّغير، قاتلتَ ببسالة! لن ننسى
!أبداً ما قمتَ به

139
00:12:07,600 --> 00:12:13,060
لذلك، تقاعد الرّقم 12 من مغاوير
!ملك الوحوش البرّية للأبد

140
00:12:18,860 --> 00:12:22,700
تهانينا. تقاعدَ رقمُك

141
00:12:22,860 --> 00:12:26,120
مهلاً. هذا لئيم أيّها القائد

142
00:12:26,740 --> 00:12:29,490
ما زلتُ حيّاً هنا

143
00:12:46,050 --> 00:12:47,510
!أنتم

144
00:12:48,890 --> 00:12:51,310
!بوب! مام

145
00:12:51,470 --> 00:12:53,350
!الأميرة

146
00:12:53,520 --> 00:12:55,020
!هل الجميع بخير؟

147
00:12:55,940 --> 00:12:57,360
!إنّها الملكة فلورا

148
00:13:01,570 --> 00:13:02,940
!الأميرة

149
00:13:03,110 --> 00:13:04,530
!آسفة لأنّني أقلقتُكم

150
00:13:04,700 --> 00:13:06,700
!بوب -
!ميرلي -

151
00:13:07,410 --> 00:13:09,830
!يسرّني أنّكم بخير -
شكراً -

152
00:13:09,990 --> 00:13:14,120
هيونكل. هذا رائع حقّاً

153
00:13:15,750 --> 00:13:17,170
!هذا لأنّني كنتُ هنا

154
00:13:21,380 --> 00:13:23,880
هذا مُطمئن. جميعكم بأمان

155
00:13:24,050 --> 00:13:28,430
!بالفعل! يسرّني بأنّنا نجونا جميعاً

156
00:13:28,590 --> 00:13:29,600
أجل

157
00:13:34,430 --> 00:13:35,730
أفان؟

158
00:13:36,020 --> 00:13:36,940
نعم؟

159
00:13:41,070 --> 00:13:43,360
!الملكة فلورا! تماسكي

160
00:13:43,530 --> 00:13:44,400
تذكّرت

161
00:13:44,570 --> 00:13:47,860
لم تكن تعلم بأنّ المُعلّم حيّ يُرزَق -
!الملكة فلورا، هل أنتِ بخير؟

162
00:13:48,030 --> 00:13:50,450
لا ألومها على غيابها عن الوعي -
!تمالكي نفسكِ -

163
00:13:56,620 --> 00:13:57,870
!أين داي؟

164
00:13:58,330 --> 00:14:00,000
!ماذا حدث لداي؟

165
00:14:07,010 --> 00:14:09,300
ما زال هناك... في الأعلى

166
00:14:13,430 --> 00:14:14,350
هكذا إذاً

167
00:14:14,850 --> 00:14:18,190
من جديد، كلّ شيء يعتمد عليه

168
00:14:18,940 --> 00:14:21,440
إنّه في مكان لا يستطيع أيّ منّا بلوغه

169
00:14:21,900 --> 00:14:26,610
!ذهبَ بمفرده! اللّعنة

170
00:14:31,740 --> 00:14:34,290
بوب، كُن فخوراً

171
00:14:35,660 --> 00:14:38,080
جميعنا بذلنا أقصى طاقتنا

172
00:14:38,710 --> 00:14:42,420
حقّقنا المُعجزات في الأعلى وكسرنا حدود قدراتنا

173
00:14:42,590 --> 00:14:44,880
لهذا ما زلنا جميعنا هنا

174
00:14:45,050 --> 00:14:48,420
لهذا داي قادر على القتال هناك في الأعلى

175
00:14:49,800 --> 00:14:52,140
ينبغي أن تكون أكثر اعتزازاً

176
00:14:56,850 --> 00:14:58,140
أجل

177
00:15:00,060 --> 00:15:01,150
معك حقّ

178
00:15:01,600 --> 00:15:07,280
استفاد داي من دعمنا وصعدَ نحو السّماء

179
00:15:07,650 --> 00:15:09,780
كلّ ما يمكننا فعله الآن هو الانتظار

180
00:15:10,530 --> 00:15:12,870
انتظروا... وآمنوا

181
00:15:13,030 --> 00:15:16,830
لا تقلقوا. مولايّ داي سينتصر

182
00:15:17,330 --> 00:15:21,920
فهو ابن مولايّ باران، إله الحرب

183
00:15:22,710 --> 00:15:23,750
!فارن

184
00:15:23,920 --> 00:15:24,840
!داي

185
00:15:32,550 --> 00:15:33,760
فُز

186
00:15:34,100 --> 00:15:35,890
!عليك أن تفوز يا داي

187
00:15:36,060 --> 00:15:37,810
!ثمّ تعود

188
00:15:37,970 --> 00:15:41,520
!لا يهمّ مظهرك! عُد إلينا فحسب

189
00:15:42,400 --> 00:15:45,190
!عُد يا داي

190
00:15:58,080 --> 00:15:59,700
!العالم السّطحي؟

191
00:16:00,960 --> 00:16:02,420
!أين فارن؟

192
00:16:02,870 --> 00:16:05,330
!ما زال... حيّاً

193
00:16:05,790 --> 00:16:07,710
!يجب أن أهزمه

194
00:16:18,430 --> 00:16:20,810
لا أستطيع... الفوز

195
00:16:20,980 --> 00:16:23,350
ليس بوضعي هذا

196
00:16:25,810 --> 00:16:28,320
ليتني أمتلك كلتا الذّراعين

197
00:16:30,030 --> 00:16:33,570
لا. أشكُّ في قدرتي على الفوز

198
00:16:33,910 --> 00:16:36,280
حتّى بكلتا الذّراعين

199
00:16:36,450 --> 00:16:38,490
،أصبح وحشاً حقيقيّاً

200
00:16:38,660 --> 00:16:42,000
يضحّي بكلّ شيء لأجل النّصر

201
00:16:44,170 --> 00:16:47,040
!يجب أن أضحّي بكلّ شيء أيضاً

202
00:17:08,810 --> 00:17:13,030
!هذه الموجة الشّديدة! هل يُعقَل أن يكون فارن...؟

203
00:17:13,440 --> 00:17:16,490
!يُطلِق عنان قوّة عين الحاكم؟

204
00:17:16,660 --> 00:17:18,570
!هل خصمه بتلك القوّة؟

205
00:17:19,280 --> 00:17:22,040
!ابن فارس التنّين ذاك؟

206
00:17:24,960 --> 00:17:28,790
!هذه الطاقة الشّديدة! ما الّذي فعله فارن؟

207
00:17:39,260 --> 00:17:40,180
!فارن؟

208
00:17:41,930 --> 00:17:44,890
داي... ابن التنّين

209
00:17:45,060 --> 00:17:46,390
أحسنت صنعاً

210
00:17:46,560 --> 00:17:50,360
القوّة الّتي تمتلكها من خارج هذا العالم

211
00:17:51,980 --> 00:17:53,280
أعي ذلك جيّداً الآن

212
00:17:53,440 --> 00:17:58,030
كي أهزمك، يجب أن أصبح وحشاً حقيقيّاً أيضاً

213
00:18:00,490 --> 00:18:04,250
سلكَ هادلَر طريقَ اللّاعودة سابقاً

214
00:18:04,410 --> 00:18:07,620
واكتسبَ قوّة تُنافس قوّة جسدي السّابق

215
00:18:07,790 --> 00:18:08,500
!...أنا أيضاً

216
00:18:10,330 --> 00:18:13,340
!...حتّى لو عنى ذلك عدم الرُّجوع

217
00:18:13,500 --> 00:18:17,130
!...لأجل النصر! لأجل تلك الكلمة الثّمينة، يجب عليّ أن

218
00:19:04,220 --> 00:19:07,770
!أنت قويّ! وكذلك هيئتك الحقيقيّة

219
00:19:07,930 --> 00:19:09,190
أنت تهينني

220
00:19:09,350 --> 00:19:12,020
!جسدي هو هذا الّذي هنا

221
00:19:13,020 --> 00:19:17,110
هذه الهيئة الأخرى هي هيئة وحش
حقيقيّ أرفقتُه بجسدي

222
00:19:17,280 --> 00:19:20,450
!عندما كشفتُ عن عيني الثّالثة، عين الحاكم

223
00:19:20,610 --> 00:19:23,820
!إنّها الهيئة الّتي تُدعى بالحاكم الأعلى

224
00:19:26,580 --> 00:19:28,330
الحاكم الأعلى؟

225
00:19:30,960 --> 00:19:34,000
!...تماماً! قلعة صخرة السّيادة! تلك الهيئة

226
00:19:36,300 --> 00:19:41,630
!بالفعل! بُنيَتْ بصورتي الّتي أكون فيها بهيئتي العُظمى

227
00:19:42,970 --> 00:19:44,180
!من المؤكّد أنّك تتذكّر

228
00:19:44,350 --> 00:19:48,470
بمنح قوّة عين الحاكم خاصّتي
،لقارع الطّبول ذاك

229
00:19:48,640 --> 00:19:52,020
!تطوّرَتْ إلى الوحش غوروا

230
00:19:53,940 --> 00:19:57,480
،عرفتُ بأنّني إذا طوّرتُ جسدي بنفس الطريقة

231
00:19:57,650 --> 00:20:00,490
!فسوف أصبح هكذا

232
00:20:06,370 --> 00:20:10,450
وعرفتُ بأنّني، وبصفتي مصدر
القوّة السحريّة، إذا فعلتُها

233
00:20:10,620 --> 00:20:14,040
!بنفسي، فلن أتمكّن من العودة

234
00:20:14,580 --> 00:20:17,210
لم تكن قلعة صخرة الحاكم إلّا مجرّد دُمية

235
00:20:17,380 --> 00:20:20,130
!تجسّد حلمي المستحيل

236
00:20:20,670 --> 00:20:24,300
!لكن أفضّل هذا على الهزيمة! أيّ شيء عدا الهزيمة

237
00:20:24,470 --> 00:20:29,220
بهذا الشّكل، يمكن صون الاسم العظيم
!لملك الشّياطين فارن

238
00:20:29,390 --> 00:20:34,190
!إذاً لهذا استخدمتَ قوّة كنتَ قد ختمتَ عليها بنفسك؟

239
00:20:34,350 --> 00:20:36,310
!فقط لأجل النّصر؟

240
00:20:38,110 --> 00:20:41,490
!اخترتَ طرح هويّتك جانباً

241
00:20:41,940 --> 00:20:44,610
مثلما... فعلتُ أنا؟

242
00:20:46,780 --> 00:20:48,780
!فليكُن ذلك

243
00:20:51,950 --> 00:20:58,250
حكم العالم الثُّلاثي كوحش حقيقيّ
!مُرعِب هو خيار مقبول

244
00:20:58,880 --> 00:21:01,670
!داي! فارس التنّين

245
00:21:01,840 --> 00:21:06,430
...المهمّ أن أهزمك... هزيمتُك الآن

246
00:21:06,970 --> 00:21:09,100
!هي الأهمّ بالنسبة لي الآن

247
00:21:16,060 --> 00:21:20,820
!تحطّم واغرُب عن وجهي يا داي

248
00:21:28,700 --> 00:21:31,910
!الهالة التنّينيّة ذات القوّة الكاملة

249
00:21:42,550 --> 00:21:45,420
!دورورا

250
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

251
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

252
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

253
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

254
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

255
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

256
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

257
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

258
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

259
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

260
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

261
00:23:34,120 --> 00:23:38,580
لمقاتلة داي التنّينيّ، اتّخذَ فارن
هيئة الحاكم الأعلى

262
00:23:38,750 --> 00:23:43,040
يستخدم المُنافِسان آخر ذرّة من قوّتهما
!بهدف تحقيق النّصر فقط

263
00:23:43,210 --> 00:23:47,760
،بسيف تنّين الشّيطان الخاص بأبيه
!يتقدّم داي لإنهاء المعركة

264
00:23:47,920 --> 00:23:53,260
المعركة بين البطل وملك الشّياطين
!تقترب من نهايتها حقّاً

265
00:23:53,430 --> 00:23:55,550
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

266
00:23:58,100 --> 00:24:00,180
!وتستمرّ المغامرة