1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:57,990 --> 00:02:00,530
!ماذا تفعل؟

20
00:02:05,330 --> 00:02:06,580
!ابتعد عنّي

21
00:02:11,420 --> 00:02:12,920
!ثمّة مشكلة

22
00:02:13,420 --> 00:02:16,010
!فقدَ هذان الاثنان عقلهما

23
00:02:16,170 --> 00:02:20,180
ينبغي أن يكونا قد فقدا الأمل
!تماماً من الفوز في المعركة

24
00:02:20,340 --> 00:02:24,260
!لا ينبغي أن تكون هناك فائدة من مُهاجمتي

25
00:02:24,640 --> 00:02:30,150
،حتّى من دون وجود وسيلة للقتال
!يُهاجمانني باستمرار

26
00:02:30,310 --> 00:02:33,900
!وكأنّهما قطيع من الموتى الأحياء

27
00:02:34,480 --> 00:02:37,860
!هذا غير منطقيّ! هذا يفوق استيعابي

28
00:02:38,030 --> 00:02:39,700
!كما قال بوب؟

29
00:02:39,860 --> 00:02:45,240
هل البشر مخلوقات تمتلك دافعاً
!عاطفياً عسير الفهم؟

30
00:02:46,410 --> 00:02:49,250
!يكفي! لا تلمسني أيُّها المقرف

31
00:02:51,040 --> 00:02:51,960
!لماذا؟

32
00:02:52,540 --> 00:02:55,750
!لماذا أنتما مُلِحّان عبثاً؟

33
00:02:55,920 --> 00:02:58,550
!ما الجدوى من مقاتلتي؟

34
00:02:58,720 --> 00:03:02,140
إذا هزمناك، سيزول الحاجز

35
00:03:02,680 --> 00:03:05,930
وعندما يزول الحاجز، سنذهب لتجميد الأعمدة

36
00:03:06,100 --> 00:03:08,020
كلّ شيء يسير بشكل مثاليّ

37
00:03:08,180 --> 00:03:09,730
أين المشكلة؟

38
00:03:13,520 --> 00:03:16,530
!اغربا عن وجهي

39
00:03:35,130 --> 00:03:41,430
ظنّني تأقلمتُ عليها في اللّحظة الأخيرة

40
00:03:41,590 --> 00:03:43,890
لأنّك استخدمتَها كثيراً

41
00:03:44,050 --> 00:03:48,350
أظنُّني عبقريّاً حقّاً

42
00:03:49,600 --> 00:03:53,400
!أنت دوماً عبقريّ يا بوب

43
00:03:54,900 --> 00:03:55,810
!إنّه عالق

44
00:03:59,070 --> 00:04:03,410
!سيفي يغرس في جسد فارن بمحض إرادته

45
00:04:07,990 --> 00:04:10,790
،إذا شُفيَتْ قلوبه الثّلاثة

46
00:04:10,950 --> 00:04:14,960
سيُجدّد ذِراعه ويستخدم حارس السّماء
!والأرض الشّيطاني

47
00:04:15,130 --> 00:04:19,590
!سيفي يُقاتل ليمنعه من فعل ذلك

48
00:04:20,710 --> 00:04:24,220
!لا أحد يستسلم

49
00:04:24,380 --> 00:04:28,680
!لا يمكنني الاستسلام أيضاً

50
00:04:28,850 --> 00:04:31,980
!أيُّها الأحمق

51
00:04:33,100 --> 00:04:34,270
!داي

52
00:04:37,520 --> 00:04:39,570
اكتفيتُ منكما

53
00:04:40,360 --> 00:04:42,740
أدركتُ الأمر الآن

54
00:04:42,900 --> 00:04:44,570
ليس العالم السّطحي فقط

55
00:04:44,740 --> 00:04:51,040
أنتم البشر عقبة لا تُحتمَل بالنسبة لي أيضاً

56
00:04:51,200 --> 00:04:55,210
،إذا كان لديكم حلم مستحيل كهذا

57
00:04:55,370 --> 00:04:58,000
!فسوف أمحوه هنا والآن

58
00:04:58,420 --> 00:05:01,130
سأتجاهل مُوقِّت العدّ التنازليّ

59
00:05:01,300 --> 00:05:05,050
!وأضرب العمود في الأسفل بقوّتي السحريّة

60
00:05:05,590 --> 00:05:10,430
!هذه المرّة ستضطرّان لفقدان الامل

61
00:05:13,180 --> 00:05:16,520
!تحرّك! يا جسدي

62
00:05:16,690 --> 00:05:21,730
!داي وبوب يقاتلان مُتجاوزين حدودهما القصوى

63
00:05:21,900 --> 00:05:25,700
أيّ نوع من الأصدقاء سنكون إذا
!لم نخاطر بحياتنا أيضاً؟

64
00:05:25,860 --> 00:05:28,410
!لماذا قطعنا كلّ هذه المسافة إلى هنا؟

65
00:05:29,160 --> 00:05:31,740
!أرجوكم! أرجوكم

66
00:05:32,490 --> 00:05:36,160
!لنتحرّك كي نساعدهما

67
00:05:36,670 --> 00:05:40,880
!أرجوكم! لنتحرّك

68
00:05:48,130 --> 00:05:50,050
!ما-ماذا؟

69
00:05:50,220 --> 00:05:51,260
!ماذا...؟

70
00:05:53,140 --> 00:05:55,100
!ا-العيون؟

71
00:05:57,020 --> 00:05:57,980
!العيون قد...؟

72
00:05:59,060 --> 00:06:00,110
!...العيون

73
00:06:08,660 --> 00:06:11,580
!إنّه خائف! فارن خائف

74
00:06:11,740 --> 00:06:13,370
من الطبيعي أن يكون كذلك

75
00:06:13,790 --> 00:06:16,290
!هذه... مُعجزة

76
00:06:16,450 --> 00:06:20,670
!مُعجزة؟! مستحيل! لا توجد مُعجزات

77
00:06:21,040 --> 00:06:26,260
!هذا صحيح! لا يمكن للعيون أن تتحرّك من تلقاء نفسها

78
00:06:27,170 --> 00:06:33,010
لا بدّ أنّ شخصاً في مكان ما يتحكّم
!بالعيون ويسخر منّي

79
00:06:33,430 --> 00:06:36,100
!هذا هو الاحتمال الوحيد

80
00:06:39,350 --> 00:06:41,610
!هناك

81
00:06:45,940 --> 00:06:47,990
!مؤلم

82
00:06:48,150 --> 00:06:49,240
!ليونا

83
00:06:50,200 --> 00:06:51,450
!عُدت

84
00:06:51,620 --> 00:06:52,870
!كان أنتِ إذاً

85
00:06:53,030 --> 00:06:56,910
الأميرة ليونا. كان هذا من صنيعك

86
00:06:58,330 --> 00:07:01,000
،قد تكونين ملكيّة

87
00:07:01,170 --> 00:07:05,250
لكن أن تمتلكي قوّة سحريّة كافية
...للتحكّم بالعيون

88
00:07:05,420 --> 00:07:07,710
!استهنتُ بكِ

89
00:07:07,880 --> 00:07:12,800
لحظة. مُحال أن أمتلك مثل هذه القوّة

90
00:07:13,430 --> 00:07:18,680
...إذا... إذا كان هناك شيء يسبّب مُعجزة كهذه

91
00:07:24,150 --> 00:07:26,780
!د-دمعة الآلهة

92
00:07:26,940 --> 00:07:27,980
!ماذا؟

93
00:07:28,360 --> 00:07:31,110
!كان لديكِ شيء كهذا؟

94
00:07:31,280 --> 00:07:35,030
!امتلكتِ شيئاً قويّاً كهذا؟

95
00:07:35,200 --> 00:07:39,080
!من أين حصلتِ على هذا؟

96
00:07:40,910 --> 00:07:42,170
!ليونا

97
00:07:48,460 --> 00:07:49,670
هكذا إذاً

98
00:07:49,840 --> 00:07:53,390
!إنّه الهُلام الّذي كان يسافر معكم

99
00:07:53,550 --> 00:07:54,760
!غوميتشان

100
00:07:56,010 --> 00:07:57,310
...هذا الشّيء

101
00:07:58,180 --> 00:08:00,230
!...هذا الشّيء

102
00:08:00,390 --> 00:08:01,140
!توقّف

103
00:08:02,520 --> 00:08:04,020
!دع غوميتشان

104
00:08:04,190 --> 00:08:05,110
!هذا صحيح

105
00:08:05,270 --> 00:08:09,860
ملك الشّياطين العظيم يفقد صوابه
!لأجل مجرّد هُلام؟ أين كبرياؤك؟

106
00:08:10,280 --> 00:08:12,530
أنتم لا تعلمون حقّاً

107
00:08:13,200 --> 00:08:15,740
هذا ليس هُلاماً

108
00:08:16,070 --> 00:08:17,080
لا

109
00:08:17,450 --> 00:08:19,490
إنّه ليس حتّى مخلوق حيّ

110
00:08:19,660 --> 00:08:20,580
!ماذا؟

111
00:08:20,750 --> 00:08:23,670
هذه... أداة

112
00:08:24,540 --> 00:08:27,710
أداة حيّة صنعَتْها الآلهة

113
00:08:27,880 --> 00:08:31,550
تُعرَف بـ"دمعة الآلهة" في العالم السُّفلي

114
00:08:32,300 --> 00:08:35,800
،تحتوي على جزء يسير من قوّة الآلهة

115
00:08:35,970 --> 00:08:38,300
،وتُلبِّي أمنية لحاملها

116
00:08:38,470 --> 00:08:40,350
لتُحقِّق المُعجزات

117
00:08:40,520 --> 00:08:46,310
إنّها تكسر التّوازن بين العوالم الثّلاثة
مراراً وتكراراً

118
00:08:46,480 --> 00:08:51,690
فهي تسمح للضعيف باكتساب قوّة عظيمة فجأة

119
00:08:51,860 --> 00:08:56,780
!أنت تكذب! كان غوميتشان صديقي منذ زمن بعيد

120
00:08:56,950 --> 00:09:01,040
!كنّا أصدقاء منذ التقينا في جزيرة ديرملين

121
00:09:03,200 --> 00:09:05,250
!لا يمكن أن يكون أداة

122
00:09:05,420 --> 00:09:08,630
،لا أعلم لماذا اتّخذ هذه الهيئة

123
00:09:08,790 --> 00:09:15,470
لكن وحدها قوّة الآلهة تستطيع اختراق
قوّة جواهر العين السحريّة خاصّتي

124
00:09:15,630 --> 00:09:19,180
هذه بالفعل دمعة الآلهة

125
00:09:21,310 --> 00:09:26,730
الآن قد فهمت سبب دحر جيش
الشّياطين الّذي لا يُقهَر

126
00:09:27,060 --> 00:09:29,980
الفارس التنّين ودمعة الآلهة

127
00:09:30,150 --> 00:09:34,400
امتلكتُم تُراثَين من الآلهة

128
00:09:34,860 --> 00:09:41,700
قوّة الآلهة الإعجازيّة جعلَتكم تتجاوزون
خطراً مُطلَقاً مِراراً

129
00:09:42,370 --> 00:09:44,000
مخطئ

130
00:09:46,410 --> 00:09:51,800
صحيح أنّ قوّة غوميتشان الغريبة ساعدتنا مرّات عديدة

131
00:09:52,170 --> 00:09:53,090
...لكن

132
00:09:53,420 --> 00:09:56,260
لم نعتمد على مُعجزات أبداً

133
00:09:56,630 --> 00:10:01,890
كلّما تمّ إنقاذنا، يكون دوماً شيئاً صغيراً

134
00:10:04,560 --> 00:10:07,310
!لعلّه أداة، لكن لديه روح

135
00:10:07,480 --> 00:10:09,190
!كان غوميتشان مَن ساعدنا

136
00:10:09,900 --> 00:10:13,360
!بهذا الجسد الضّئيل، يستخدم كلّ قوّته

137
00:10:13,780 --> 00:10:17,280
!أرجوك! لا تزهق روح صديقنا

138
00:10:18,660 --> 00:10:20,530
!لا تقتل غوميتشان

139
00:10:21,410 --> 00:10:22,620
بالفعل

140
00:10:22,780 --> 00:10:26,080
يبدو أنّه لا يحقّق إلّا الأمنيات الصّغيرة

141
00:10:26,410 --> 00:10:30,630
حتّى أداة عاديّة تستطيع فعل هذا

142
00:10:31,130 --> 00:10:31,790
...لكن

143
00:10:32,540 --> 00:10:36,760
!هذا فقط لأنّكم لم تعرفوا كيفيّة استخدامه

144
00:10:36,920 --> 00:10:38,800
...الآن بعد أن عرفتُم قوّته الحقيقيّة

145
00:10:38,970 --> 00:10:39,510
!لا تفعل

146
00:10:39,680 --> 00:10:41,720
...لا أستطيع...

147
00:10:42,140 --> 00:10:45,970
!أن أدعه وشأنه

148
00:10:59,110 --> 00:11:01,990
!تحطّم! فلتختفِ وتزُل

149
00:11:02,160 --> 00:11:06,830
!لا يمكن أن تبقى دمعة الآلهة في عالم البشر

150
00:11:07,790 --> 00:11:11,370
!هذا صحيح! لن يبقى حتّى جزء منها

151
00:11:12,000 --> 00:11:14,670
!غوميتشان

152
00:11:25,930 --> 00:11:27,970
جزيرة ديرملين؟

153
00:11:39,190 --> 00:11:40,820
جزيرة ديرملين؟

154
00:11:42,110 --> 00:11:44,240
هذا صحيح يا داي

155
00:11:44,820 --> 00:11:47,160
إنّه حيث التقينا أوّل مرّة

156
00:11:49,330 --> 00:11:50,960
جزيرة ذكرياتنا

157
00:11:51,330 --> 00:11:54,290
!غوميتشان! أنت تتكلّم

158
00:11:54,460 --> 00:11:57,210
هكذا إذاً. كان ذلك صحيحاً

159
00:11:57,380 --> 00:12:02,720
،عندما عَلِقَ بوب بين الحياة والموت
قال بأنّه سمع صوتك

160
00:12:04,140 --> 00:12:06,010
أين نحن إذاً؟

161
00:12:06,180 --> 00:12:08,180
داخل وعيك

162
00:12:08,350 --> 00:12:13,520
هنا داخل عقولنا، توقّف الزمن لأجلنا

163
00:12:13,690 --> 00:12:15,310
حقّاً؟

164
00:12:15,900 --> 00:12:17,570
...غوميتشان

165
00:12:17,730 --> 00:12:22,610
هذا غير صحيح، أليس كذلك؟ بأنّك
أداة مصنوعة بواسطة الآلهة

166
00:12:23,280 --> 00:12:24,450
أنا آسف

167
00:12:24,820 --> 00:12:27,660
أنا... دمعة الآلهة

168
00:12:29,200 --> 00:12:33,620
لكن كنّا صديقين طوال هذا الوقت

169
00:12:33,790 --> 00:12:35,880
منذ كنتُ صغيراً

170
00:12:36,290 --> 00:12:40,760
ضحِكنا وبكينا ولعِبنا معاً

171
00:12:41,170 --> 00:12:46,090
الآن بعد أن انتهى الأمر، أعرف الحقيقة بنفسي

172
00:12:46,800 --> 00:12:53,180
،دمعة واحدة ذرفَتْها الآلهة لأجل الضّعيف
لأجل مخلوقات عالم السّطح المُعذَّبة

173
00:12:54,230 --> 00:12:57,690
قالوا بأنّها دمعة الآلهة

174
00:12:57,860 --> 00:13:03,740
الأداة الفريدة من نوعها في العالم
والّتي تحقّق أمنية حاملها

175
00:13:04,400 --> 00:13:06,610
هذا هو أنا

176
00:13:07,410 --> 00:13:08,620
أنا آسف

177
00:13:10,160 --> 00:13:11,660
لا عليك

178
00:13:12,080 --> 00:13:14,160
أنا متفاجئ قليلاً فحسب

179
00:13:14,460 --> 00:13:18,210
لا يهمّ ما تكون بالضبط

180
00:13:18,380 --> 00:13:21,340
تبقى صديقنا

181
00:13:21,500 --> 00:13:25,470
أنت حقّاً الشّخص الّذي ظننتُه أن يكون

182
00:13:25,630 --> 00:13:28,300
يسرّني بأنّني سمعتُ أمنيتك

183
00:13:28,470 --> 00:13:30,510
أمنيتي؟

184
00:13:30,680 --> 00:13:34,680
لا تتذكّر. كنتَ لا تزال صغيراً آنذاك

185
00:13:35,140 --> 00:13:39,560
سبب امتلاك دمعة الآلهة روحاً هو كي تتمكّن
من تحديد الأمنيات الشرّيرة

186
00:13:39,730 --> 00:13:41,320
وعدم تحقيقها

187
00:13:41,480 --> 00:13:47,410
بعد تلبية أمنيتي السّابقة، خُلِقتُ
من جديد على جزيرة ديرملين

188
00:13:47,570 --> 00:13:51,780
كان المكان الأطهر في العالم

189
00:13:51,950 --> 00:13:54,950
جزيرة مليئة بالوحوش؟

190
00:13:55,290 --> 00:14:00,340
فهمت. لا يوجد إنسان طيّب تماماً

191
00:14:00,500 --> 00:14:03,050
لعلّ إشاعات الهُلام المعدنيّ الذهبيّ

192
00:14:03,210 --> 00:14:07,430
كانت تحريفاً لأسطورة دمعة الآلهة

193
00:14:08,180 --> 00:14:14,470
هربتُ إلى جزيرة ديرملين تجنّباً لأرواح البشر الجشعة

194
00:14:14,640 --> 00:14:16,430
حينئذ التقيتُ بك

195
00:14:17,810 --> 00:14:19,190
أنا؟

196
00:14:19,770 --> 00:14:22,520
داي، فكّر في الماضي

197
00:14:26,280 --> 00:14:28,320
حاول أن تتذكّر

198
00:14:30,570 --> 00:14:32,740
منذ زمن بعيد

199
00:14:34,040 --> 00:14:37,370
وحتّى قبل ذلك

200
00:14:54,680 --> 00:14:55,970
من هناك؟

201
00:15:02,440 --> 00:15:04,440
لا تخف

202
00:15:10,150 --> 00:15:11,410
تعال إلى هنا

203
00:15:19,120 --> 00:15:21,540
كُن صديقي

204
00:15:34,600 --> 00:15:36,720
هذا صحيح يا داي

205
00:15:36,890 --> 00:15:38,640
كان أنت

206
00:15:39,310 --> 00:15:44,730
كانت أمنيتك ما جعلَتْني هكذا

207
00:15:45,650 --> 00:15:46,900
...إذاً

208
00:15:47,320 --> 00:15:49,780
لبّيتَ أمنيتي

209
00:15:50,240 --> 00:15:56,370
لبّيتَ أمنيتي... بامتلاك صديق

210
00:15:57,830 --> 00:15:58,950
...طوال هذا الوقت

211
00:15:59,790 --> 00:16:03,210
!كنتَ تلبّيها طوال هذا الوقت

212
00:16:04,960 --> 00:16:09,010
!طوال هذا الوقت... لأجلي

213
00:16:14,010 --> 00:16:15,260
...لكن

214
00:16:15,680 --> 00:16:18,060
حان وقت الوداع

215
00:16:18,760 --> 00:16:19,850
!غوميتشان؟

216
00:16:20,020 --> 00:16:21,020
لا تقلق

217
00:16:21,430 --> 00:16:24,350
سأصبح دمعة الآلهة ثانية فحسب

218
00:16:24,520 --> 00:16:30,110
لكن يستغرق التجدّد مثلما استغرقَ تحقيق أمنية

219
00:16:30,570 --> 00:16:33,610
لذا سيستغرق ذلك أكثر من عقد

220
00:16:33,780 --> 00:16:38,780
وعندما أعود، سأكون قد نسيتُ كلّ شيء

221
00:16:39,450 --> 00:16:43,580
لن أتذكّرك أو أتذكّر أيّ أحد آخر

222
00:16:43,750 --> 00:16:47,540
هذا هو أسفي الحقيقي الوحيد

223
00:16:47,710 --> 00:16:49,090
غوميتشان

224
00:16:49,750 --> 00:16:53,550
خارت كلّ قوايّ على أيّ حال

225
00:16:54,010 --> 00:16:56,510
...أثناء مُغامراتي معك

226
00:16:56,680 --> 00:17:00,850
كنتُ أحقّق أمنيات الجميع دون إدراك ذلك

227
00:17:01,020 --> 00:17:06,600
هذا غالباً سبب انكماش جسدي فجأة

228
00:17:07,440 --> 00:17:09,820
لكن لا مشكلة

229
00:17:10,820 --> 00:17:12,490
قضينا وقتاً ممتعاً

230
00:17:13,070 --> 00:17:18,160
قضينا وقتاً ممتعاً حقّاً... طوال الرّحلة

231
00:17:18,620 --> 00:17:19,910
...داي

232
00:17:25,540 --> 00:17:31,250
!لـ-لا! لا تختفِ يا غوميتشان! لا تختفِ

233
00:17:31,880 --> 00:17:34,380
...أخيراً يا داي

234
00:17:34,920 --> 00:17:38,140
...لأجلك... ولأجل الجميع

235
00:17:38,300 --> 00:17:40,220
سأحاول استخدام قوّتي

236
00:17:40,600 --> 00:17:43,180
ماذا تتمنّى؟

237
00:17:43,980 --> 00:17:46,690
هل من شيء تريدني أن أحقّقه؟

238
00:17:46,850 --> 00:17:48,190
أمنية؟

239
00:17:48,350 --> 00:17:52,780
...أكثر ما أتمنّاه الآن

240
00:17:53,690 --> 00:17:55,070
...هو

241
00:17:55,990 --> 00:17:58,200
أن تتوحّد قلوبنا

242
00:17:58,820 --> 00:18:03,950
...لو أستطيع توحيد قلوب الجميع في العالم

243
00:18:04,120 --> 00:18:05,540
قلوبهم؟

244
00:18:05,870 --> 00:18:08,120
ولو لفترة قصيرة فقط

245
00:18:08,290 --> 00:18:10,290
مثل ميرلي وبوب

246
00:18:10,460 --> 00:18:15,300
،لو أستطيع إخبار النّاس حول العالم بما نعرفه

247
00:18:15,460 --> 00:18:17,130
...رُبّما حينها

248
00:18:17,630 --> 00:18:19,090
...رُبّما فقط

249
00:18:19,800 --> 00:18:21,470
سأجرّب ذلك

250
00:18:21,930 --> 00:18:23,810
بآخر ما تبقّى من قوّتي

251
00:18:24,930 --> 00:18:30,020
لكن إذا لم أستطع فعل ذلك، سامحني أرجوك

252
00:18:33,070 --> 00:18:35,530
وداعاً يا داي

253
00:18:35,690 --> 00:18:39,820
!غوميتشان! غوميتشان! غوميتشان

254
00:18:40,200 --> 00:18:43,370
!غوميتشان

255
00:18:53,040 --> 00:18:56,670
اقتربَ وقت التفجير

256
00:18:58,550 --> 00:19:03,510
هذه المرّة وبكلّ يقين... آمالكم قد حُبُطَت

257
00:19:07,810 --> 00:19:10,520
!انهض يا داي

258
00:19:11,310 --> 00:19:14,610
!وصلَتنا أفكارك

259
00:19:14,770 --> 00:19:20,400
حتّى في الأراضي الشّماليّة المُقفرة
!هذه، ما زال هناك بطل، لذا لا تقلق

260
00:19:20,570 --> 00:19:23,160
!رغم أنّني لستُ حقيقيّاً

261
00:19:24,780 --> 00:19:27,620
!تـ... تحقّقت

262
00:19:27,790 --> 00:19:30,830
!سمعنا كلّ أصواتك الداخليّة

263
00:19:31,000 --> 00:19:34,590
ذلك وصلَ إلى كلّ الأشخاص الّذين
!تعرفهم على الأرجح

264
00:19:34,750 --> 00:19:37,630
!يبدو أنّ غوميتشان كان كنزاً مذهلاً بالفعل

265
00:19:37,800 --> 00:19:40,380
!كان يجدر بنا أن نمسك به مهما كلّف الأمر

266
00:19:40,550 --> 00:19:44,680
!هيّا! إلى قمّة العمود

267
00:19:45,100 --> 00:19:46,260
!داي

268
00:19:47,220 --> 00:19:48,310
!هنا أبّولو

269
00:19:48,640 --> 00:19:52,140
!أعمل على تجميد العمود في جزيرة فالجي

270
00:19:52,310 --> 00:19:56,110
!هنا مارين! أتولّى العمود في بابنيكا الغربيّة

271
00:19:56,270 --> 00:19:59,070
!لا تستسلم حتّى النّهاية يا داي

272
00:20:00,190 --> 00:20:01,150
...داي

273
00:20:01,740 --> 00:20:03,070
...الجميع

274
00:20:28,890 --> 00:20:33,020
!أشعر... بأفكار النّاس من كلّ أنحاء العالم

275
00:20:33,190 --> 00:20:34,810
...صلواتنا

276
00:20:35,310 --> 00:20:40,320
!العالم مُوحّد... كجسد واحد

277
00:20:43,610 --> 00:20:45,110
سمعتُ ذلك

278
00:20:45,780 --> 00:20:47,490
!الأميرة -
!نعم -

279
00:20:47,660 --> 00:20:49,620
!أسمع أصوات من كلّ أنحاء العالم

280
00:20:49,990 --> 00:20:51,790
!جميعهم متوجّهون نحو الأعمدة

281
00:20:51,950 --> 00:20:54,960
!ماذا؟! أيّ هراء هذا؟

282
00:20:55,120 --> 00:20:59,710
ميرلي، سمعتِ ذلك، صحيح؟! نحن
!لا نتوهّم ذلك، صحيح؟

283
00:20:59,880 --> 00:21:06,550
أجل يا بوب! الجميع... الجميع يقولون
!بأنّهم يسمعون ذلك

284
00:21:06,720 --> 00:21:09,600
!مذهل... مذهل

285
00:21:09,760 --> 00:21:13,850
!يكفي! كفّوا عن كلامكم الفارغ

286
00:21:14,020 --> 00:21:19,060
!أصوات من حول العالم؟! هذا غير مُمكن

287
00:21:20,020 --> 00:21:22,570
!ما هذا الضّوء؟

288
00:21:23,860 --> 00:21:25,360
إنّه غوميتشان

289
00:21:25,950 --> 00:21:30,950
...في اللّحظة الأخيرة، غوميتشان حقّقَ

290
00:21:31,830 --> 00:21:33,250
!أمنيتي

291
00:21:33,790 --> 00:21:39,040
لتوحيد العالم. لتوحيد قلوب الجميع في العالم

292
00:21:39,380 --> 00:21:42,800
!تِلك كانت أمنيتي

293
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

294
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

295
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

296
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

297
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

298
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

299
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

300
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

301
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

302
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

303
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

304
00:23:34,070 --> 00:23:37,160
حقّقَ غوميتشان أمنيةَ داي واختفى

305
00:23:37,330 --> 00:23:39,710
وصلَتْ أافكار داي إلى سكّان العالم

306
00:23:39,870 --> 00:23:44,340
توجّه ديرولين وأبّولو والآخرون لإيقاف
النُّوى السّوداء حول العالم

307
00:23:44,500 --> 00:23:50,470
لكن بينما يحاول فارن تفجيرها، يُطوَّق العالم بالنُّور

308
00:23:50,630 --> 00:23:53,470
تُرى ماذا سيحلُّ بالعالم السّطحي؟

309
00:23:53,640 --> 00:23:56,220
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

310
00:23:58,100 --> 00:24:00,230
!وتستمرّ المغامرة