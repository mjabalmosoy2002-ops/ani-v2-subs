1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:52,900 --> 00:01:56,320
...هذه حكاية أفان، البطل

20
00:01:56,490 --> 00:02:02,120
من أيّام شبابه كعضو في تنظيم كارل

21
00:02:06,330 --> 00:02:08,750
!لقد حان الوقت

22
00:02:09,540 --> 00:02:14,380
!حان الوقت لإحكام قبضتي على العالم

23
00:02:17,670 --> 00:02:20,090
!انطلقوا يا وحوشي

24
00:02:20,260 --> 00:02:23,310
!احرقوا قُراهم! دمّروا بلدانهم

25
00:02:23,470 --> 00:02:26,770
!أبيدوا البشر التّافهين

26
00:02:29,190 --> 00:02:33,650
...ضدّ ملك الشّياطين العظيم هادلَر وفيلق وحوشه

27
00:02:33,820 --> 00:02:38,360
لم يستطع البشر فعل شيء سوى الارتعاد خوفاً

28
00:02:39,700 --> 00:02:46,330
لكن كانت هناك مملكة واحدة وقفت بحزم
في وجه غزو جيش الشّياطين

29
00:02:46,910 --> 00:02:50,170
...تحت فارسهم القائد الجديد، روكا

30
00:02:50,330 --> 00:02:57,050
تنظيم كارل النّخبة واجه جيش
الشّياطين كقوّة لا نظير لها

31
00:02:58,670 --> 00:03:02,890
!اللّعنة عليك يا مملكة كارل

32
00:03:09,390 --> 00:03:11,190
!إنّها الأميرة فلورا

33
00:03:13,730 --> 00:03:16,610
!اسمعوني جميعاً

34
00:03:17,730 --> 00:03:22,110
مهما سحقَ جيشُ الشّياطين عالمنا
،وأحرقَ بلداتنا

35
00:03:22,280 --> 00:03:24,240
!لا يوجد ما يدعو للخوف

36
00:03:25,490 --> 00:03:29,000
!ملك الشّياطين هو من يخاف

37
00:03:29,160 --> 00:03:33,670
!فنحن البشر نمتلك قوّة الاتّحاد

38
00:03:33,830 --> 00:03:37,550
!لهذا سوف أنضمّ للمعركة

39
00:03:38,090 --> 00:03:41,130
!سوية مع تنظيم كارل الفخور

40
00:03:41,300 --> 00:03:43,510
!الأميرة شجاعة للغاية

41
00:03:43,930 --> 00:03:45,850
!سوف نقاتل أيضاً

42
00:03:46,010 --> 00:03:52,810
بالنيابة عن ملكها طريح الفراش، قادت
الأميرة فلورا مملكة كارل

43
00:03:53,310 --> 00:03:56,520
،بحُسنها وشجاعتها

44
00:03:56,690 --> 00:04:01,190
كانت فلورا إلاهة الأمل بالنسبة للعالم

45
00:04:06,950 --> 00:04:09,450
قولاً سديداً يا أميرة

46
00:04:09,620 --> 00:04:11,870
أقوم بعملي فحسب

47
00:04:12,500 --> 00:04:14,580
أنت من ينبغي الإطراء عليه

48
00:04:14,750 --> 00:04:16,130
مع التّنظيم ككلّ

49
00:04:16,290 --> 00:04:20,460
على ذكر التّنظيم، أرى أنّه مفقود من جديد

50
00:04:20,630 --> 00:04:21,840
!أفان

51
00:04:23,130 --> 00:04:26,640
لم يتغيّر طبع أفان

52
00:04:26,800 --> 00:04:28,310
!سأذهب لإحضاره

53
00:04:28,470 --> 00:04:32,640
كيف يجرؤ على التغيّب عن حضور
!الأميرة أمام العامّة

54
00:04:32,810 --> 00:04:35,150
!لا بأس يا روكا

55
00:04:35,310 --> 00:04:37,940
!لا، على العكس! سأذهب لتأديبه

56
00:04:38,110 --> 00:04:40,280
!أعرف تماماً أين يكون

57
00:04:43,740 --> 00:04:46,530
ثمّة شيء مفقود

58
00:04:46,700 --> 00:04:48,580
هذا الحساء سيّئ

59
00:04:48,740 --> 00:04:53,210
!يا للهول! لكن أعددتُه خصّيصاً لك يا سيّد أفان

60
00:04:53,370 --> 00:04:56,790
المشكلة تكمن في النكهة

61
00:04:56,960 --> 00:05:03,050
إذا طحنتِ سويقة أقحوان ومزجتها
معه، فينبغي أن يتماشيان معاً

62
00:05:03,880 --> 00:05:09,470
،الأقحوان نافع للأمراض والجروح
فضلاً عن مكوّناته الغذائيّة الغنيّة

63
00:05:09,640 --> 00:05:13,640
وبالنسبة لنكهتنا السرّية، نضيف رشّة
من بذور الرّشاقة

64
00:05:15,890 --> 00:05:18,440
!معلوماتك وافرة يا سيّد أفان

65
00:05:18,610 --> 00:05:21,150
هلّا تذوّقت حسائي في المرّة المقبلة؟

66
00:05:21,320 --> 00:05:22,030
!أفان

67
00:05:22,190 --> 00:05:25,400
أراك هنا يا روكا. بماذا يمكنني خدمتك؟

68
00:05:25,570 --> 00:05:27,320
!كُفّ عن ادّعاء البراءة

69
00:05:27,490 --> 00:05:31,790
...أتيت في الوقت. بعض الخبز مع هذا الحساء

70
00:05:31,950 --> 00:05:33,450
!تعال

71
00:05:34,620 --> 00:05:37,960
!لا! سيّد أفان

72
00:05:39,540 --> 00:05:42,750
!عجباً، ما خطبك؟

73
00:05:42,920 --> 00:05:46,010
!تغيّبت عن واجب حراسة لأجل درس طبخ؟

74
00:05:46,170 --> 00:05:48,390
أعتذر عن ذلك

75
00:05:48,930 --> 00:05:54,850
لكن بصفتِك الأقوى في التّنظيم، أنت تكفي كحارس

76
00:05:55,020 --> 00:05:58,690
تحسين الطعام الّذي يأكله الجميع

77
00:05:58,850 --> 00:06:02,110
أفضل بكثير بالنسبة لي لخدمة البلد

78
00:06:08,030 --> 00:06:13,330
أنت صديقي، لكن لا أعلم لماذا تمّ
تعيينك في تنظيم كارل

79
00:06:13,490 --> 00:06:15,410
غالباً لأنّني أدرس

80
00:06:15,830 --> 00:06:19,670
تنحدر عائلة زينوار من سُلالة طويلة من العُلماء

81
00:06:20,040 --> 00:06:24,000
!اسمع! نحن في عصر الحروب الآن

82
00:06:24,960 --> 00:06:29,300
!لا أحد يعلم متى قد يستهدف ملك الشّياطين بلدنا

83
00:06:29,470 --> 00:06:31,010
أنت مُحقّ

84
00:06:31,180 --> 00:06:36,100
!لا جدوى من الاكتفاء بالدّراسة وتملّق الفتيات لك

85
00:06:36,270 --> 00:06:38,520
!عليك أن تتمرّن على مهاراتك بالسّيف

86
00:06:38,690 --> 00:06:43,610
أجل، هذا مهمّ، لكن من المؤكّد أنّك
تنوي الحصول على عائلة يوماً ما

87
00:06:43,770 --> 00:06:47,740
فقد تحظى بطفل ظريف يتشبّه بك

88
00:06:47,900 --> 00:06:50,990
...إن كنت لا تُجيد الطبخ على الأقلّ

89
00:06:51,160 --> 00:06:55,410
!أكرّس حياتي للسيف! لستُ بحاجة لعائلة

90
00:06:55,870 --> 00:06:58,790
هل أنت متأكّد من ذلك؟

91
00:06:58,960 --> 00:07:00,750
ستندم على ذلك

92
00:07:00,920 --> 00:07:07,130
!إذا تزوّجتُ يوماً، سأجري في البلد بأكمله عارياً

93
00:07:08,170 --> 00:07:12,840
!اسمع، تمرّن على الدّفاع عن نفسك على الأقلّ

94
00:07:13,010 --> 00:07:17,560
وضعيّتك القتاليّة قد تتطلّب جهداً، لكن
!يمكنك على الأقلّ التمرّن على التّلويح

95
00:07:20,440 --> 00:07:23,060
فهمت يا روكا

96
00:07:23,770 --> 00:07:25,610
...كما قلت

97
00:07:27,070 --> 00:07:29,320
هناك حرب قادمة

98
00:07:31,950 --> 00:07:33,660
!ما الأمر يا أميرة؟

99
00:07:34,030 --> 00:07:35,490
!ما هذا؟

100
00:07:35,660 --> 00:07:37,660
!ظهرت كتابة بالدماء للتو

101
00:07:37,830 --> 00:07:39,290
!أيّ لغة هي هذه؟

102
00:07:39,450 --> 00:07:41,210
إنّها لغة الظلاميّين

103
00:07:42,250 --> 00:07:45,960
إنّها تعويذة تواصل أرسِلت عبر المرايا

104
00:07:46,130 --> 00:07:48,670
...مُحتوى الكتابة

105
00:07:49,130 --> 00:07:52,380
...اللّيلة، سوف آتي للحصول على الأميرة"

106
00:07:52,550 --> 00:07:55,890
لتقديمها قُرباناً لإله العالم السّفلي

107
00:07:56,050 --> 00:07:56,890
"ملك الشّياطين

108
00:07:57,060 --> 00:07:57,850
!ماذا؟

109
00:07:58,010 --> 00:07:59,140
!ملك الشّياطين يريد الأميرة؟

110
00:07:59,310 --> 00:08:01,560
!هذه حالة طارئة! عزّزوا الحراسة

111
00:08:01,730 --> 00:08:02,810
...أفان

112
00:08:08,650 --> 00:08:12,320
!القائد روكا، حرس القلعة على أهبة الاستعداد

113
00:08:12,610 --> 00:08:13,740
!جيّد

114
00:08:13,910 --> 00:08:17,200
!حسناً يا ملك الشّياطين! تعال إن كنت تجرؤ

115
00:08:17,370 --> 00:08:20,040
روكا، أين أفان؟

116
00:08:20,200 --> 00:08:21,000
أفان؟

117
00:08:21,160 --> 00:08:26,170
قال أنّ لديه عمل مهمّ وذهب إلى الغابة

118
00:08:26,330 --> 00:08:27,460
الغابة؟

119
00:08:28,040 --> 00:08:31,920
!لا شيء أهمّ من سلامتك

120
00:08:32,090 --> 00:08:36,760
!أعدكِ بأنّنا سنحميكِ حتّى من دون ذلك الجبان

121
00:08:37,260 --> 00:08:39,350
!ليس عليكِ القلق

122
00:08:40,930 --> 00:08:42,890
!تبّاً لك يا أفان الأحمق

123
00:08:43,060 --> 00:08:47,730
!قد لا تكون قويّاً، لكن لم أتوقّعك أن تهرب

124
00:08:47,900 --> 00:08:50,650
!اعتباراً من اليوم، علاقتنا انتهت

125
00:08:57,280 --> 00:08:58,320
!انظروا هناك

126
00:09:01,830 --> 00:09:03,370
!ما هذا الضّوء؟

127
00:09:08,380 --> 00:09:10,170
!إنّه ملك الشّياطين

128
00:09:10,340 --> 00:09:12,260
!استعدّوا جميعاً

129
00:09:14,050 --> 00:09:15,180
أيّها القذرون

130
00:09:15,340 --> 00:09:17,340
!أستدعيكم يا وحوشي

131
00:09:17,510 --> 00:09:18,680
!الفُظ

132
00:09:19,050 --> 00:09:21,850
!اهزموا البشر

133
00:09:36,070 --> 00:09:38,620
!يا قائد! الوحوش يهاجمون

134
00:09:38,780 --> 00:09:41,370
!ماذا؟! من أين أتوا؟

135
00:09:49,790 --> 00:09:51,000
!تبّاً

136
00:09:56,550 --> 00:09:59,260
!اللّعنة! إنّه قويّ جدّاً

137
00:09:59,430 --> 00:10:01,470
الأميرة فلورا

138
00:10:02,470 --> 00:10:05,890
!أتيتُ لآخذكِ

139
00:10:06,060 --> 00:10:08,850
!أنتِ تنظرين إلى ملك الشّياطين بشخصه

140
00:10:10,940 --> 00:10:14,690
!يا ملك الشّياطين، أعرف مخطّطك

141
00:10:14,860 --> 00:10:19,200
!قُربان لإله العالم السّفلي هو مجرّد رواية مُلفّقة

142
00:10:19,360 --> 00:10:20,200
ماذا؟

143
00:10:20,660 --> 00:10:24,410
...بخطفي بأيّ وسيلة ممكنة

144
00:10:24,580 --> 00:10:30,420
تنوي تثبيط معنويات شعبي وتسريع
!هيمنتك على العالم

145
00:10:31,130 --> 00:10:32,670
!لامعة الذّكاء

146
00:10:32,840 --> 00:10:35,760
أنتِ صغيرة، لكن تبقين حاكمة

147
00:10:35,920 --> 00:10:38,970
سيوفّر عليّ هذا كثيراً من العناء

148
00:10:39,130 --> 00:10:41,180
!والآن اركعي أمامي

149
00:10:42,010 --> 00:10:43,140
!أرفض

150
00:10:48,430 --> 00:10:52,730
!يمكنني قتلكِ هنا والآن إن أردتِ ذلك

151
00:10:57,610 --> 00:10:58,820
!سموّكِ

152
00:10:59,240 --> 00:11:02,570
هل سيكون استسلاماً أم موتاً؟

153
00:11:02,740 --> 00:11:05,120
ماذا تفضّلين؟

154
00:11:06,580 --> 00:11:09,250
!هيّا! اختاري

155
00:11:10,620 --> 00:11:13,130
هذا سيّئ

156
00:11:18,510 --> 00:11:21,550
!أفان

157
00:11:34,770 --> 00:11:39,320
!يمكنني قتلكِ هنا والآن إن أردتِ ذلك

158
00:11:40,070 --> 00:11:41,200
!سموّكِ

159
00:11:41,360 --> 00:11:44,700
هل سيكون استسلاماً أم موتاً؟

160
00:11:44,870 --> 00:11:47,240
ماذا تفضّلين؟

161
00:11:48,620 --> 00:11:51,460
!هيّا! اختاري

162
00:11:52,750 --> 00:11:55,290
هذا سيّئ

163
00:12:00,630 --> 00:12:01,930
!أفان

164
00:12:02,090 --> 00:12:03,890
من أنت؟

165
00:12:04,260 --> 00:12:05,550
يا سيّد ملك الشّياطين

166
00:12:06,050 --> 00:12:11,020
عليك أن تكون أكثر رقّة عندما تحاول إغواء آنسة

167
00:12:13,650 --> 00:12:16,690
!لستُ بحاجة لكلامك الفارغ

168
00:12:26,490 --> 00:12:31,660
يحتاج مُسدّس رصاص السّحر هذا لتطوير أكبر

169
00:12:37,290 --> 00:12:38,710
!ما الأمر؟

170
00:12:39,340 --> 00:12:41,510
!ماذا فعلت؟

171
00:12:42,260 --> 00:12:47,640
نثرتُ عليه قليلاً من مادّة التخثير فحسب

172
00:12:47,800 --> 00:12:49,310
تخثير؟

173
00:12:49,810 --> 00:12:53,140
إنّه مُركّب سرّي أعددتُه

174
00:12:53,310 --> 00:12:59,480
الوحوش الّذين يُصابون به يفقدون
صوابهم ويهاجمون بعضهم الآخر

175
00:13:00,530 --> 00:13:03,440
!الوحوش في الخارج يقاتلون بعضهم

176
00:13:03,820 --> 00:13:06,530
نثرتُ بعضاً على الوحوش في الخارج أيضاً

177
00:13:07,240 --> 00:13:13,410
وبهذا أمسى فيلقك، فيلق الوحوش
الموثوق، عديم الجدوى

178
00:13:14,080 --> 00:13:18,460
!فهمت! ذهبَ إلى الغابة بحثاً عن فراشات السمّ

179
00:13:18,630 --> 00:13:20,590
!لا بأس بك أيّها المحتال

180
00:13:29,430 --> 00:13:35,060
!أيّها المُنحطّ! أتجرؤ على إهانتي بحِيلك الماكرة؟

181
00:13:35,230 --> 00:13:36,770
!ستدفع ثمن هذا

182
00:13:37,190 --> 00:13:40,190
سأدفع ثمن هذا؟

183
00:13:42,650 --> 00:13:43,940
ماذا؟

184
00:13:44,110 --> 00:13:47,610
!أشعر بهالة من هذا الرّجل الضعيف؟

185
00:13:48,110 --> 00:13:51,950
!أنت من سيدفع الثّمن يا ملك الشّياطين

186
00:13:56,210 --> 00:13:58,000
!رأيتُ هذا سابقاً

187
00:13:58,170 --> 00:14:01,460
!هذا التّعبير في وجه أفان

188
00:14:01,750 --> 00:14:03,760
كان ذلك قبل ثلاث سنوات

189
00:14:04,340 --> 00:14:09,470
نتيجة تعطّشي الفتيّ للمُغامرة، تسلّلتُ
إلى خارج القلعة بمفردي

190
00:14:30,530 --> 00:14:35,580
كان أفان هو من أنقذني عندما هوجمت
بواسطة وحش في الغابة

191
00:14:40,880 --> 00:14:45,840
أخبرتُه من أكون وأوصيتُ به للتنظيم

192
00:14:47,010 --> 00:14:52,350
ومع ذلك، حالما انضمّ، بدأ بارتداء
تلك النظّارة عديمة القيمة

193
00:14:52,680 --> 00:14:56,600
وتظاهرَ بأنّه لا يجيد القتال إطلاقاً

194
00:14:57,640 --> 00:15:01,900
بدا وكأنّه كان يقمع قوّته الهائلة

195
00:15:02,060 --> 00:15:04,230
لكن هذا واضح

196
00:15:04,400 --> 00:15:10,320
تصرّف بذلك الشّكل لأنّه لم يرد التّباهي

197
00:15:11,280 --> 00:15:15,910
أنا آسف يا أميرة. لكن ما زلتُ عضواً في التّنظيم

198
00:15:16,080 --> 00:15:20,790
إذا استدعت الحاجة، سأستخدم كامل
قوّتي لحمايتكِ وحماية مملكة كارل

199
00:15:20,960 --> 00:15:23,250
...لكن حتّى يحين ذلك الوقت

200
00:15:23,420 --> 00:15:24,630
فهمت

201
00:15:24,790 --> 00:15:29,090
سأحتفظ بما أعرفه عنك سرّاً

202
00:15:31,550 --> 00:15:35,930
!أتعني أنّ الوقت قد حان يا أفان؟

203
00:15:38,220 --> 00:15:44,400
أيّها الأحمق! مُحال أن تجرؤ على مواجهتي، صحيح؟

204
00:15:44,560 --> 00:15:46,270
لا أريد القتال

205
00:15:46,440 --> 00:15:47,360
...لكن

206
00:15:47,530 --> 00:15:53,780
لا أتحمّل رؤية شخص يؤذي الآخرين
لتحقيق مآربه وأقف مكتوف اليدين

207
00:15:56,030 --> 00:15:58,660
!لا تعتقدني ساذجاً إلى هذا الحدّ

208
00:16:02,210 --> 00:16:03,750
!سئمتُ منك

209
00:16:03,920 --> 00:16:05,040
!شعلة

210
00:16:06,960 --> 00:16:08,130
!ماذا؟

211
00:16:08,630 --> 00:16:10,970
!يستطيع استخدام تعويذات؟

212
00:16:11,130 --> 00:16:12,180
!لهيب

213
00:16:14,390 --> 00:16:19,180
!بالنسبة لبشريّ، يستخدم سحراً مُتقدّماً جدّاً

214
00:16:21,100 --> 00:16:24,600
!مذهل! لم أتوقّع أن يكون أفان بهذه القوّة

215
00:16:24,770 --> 00:16:26,270
!يمكنك فعلها يا أفان

216
00:16:30,610 --> 00:16:31,440
!ماذا؟

217
00:16:43,500 --> 00:16:45,540
!انتهى الأمر! سعير

218
00:16:50,000 --> 00:16:55,090
!ليس استعراضاً سيّئاً. لكن تبقى بشريّاً

219
00:16:55,890 --> 00:17:01,850
!مقارنة بسحري، سحرك تافه

220
00:17:02,270 --> 00:17:04,480
!يستطيع استخدام تعويذة انفجار حتّى؟

221
00:17:05,440 --> 00:17:08,810
!لا! إذا راوغت، سيضرب الأميرة

222
00:17:17,450 --> 00:17:20,950
!أحمق! أتفضّل لقاء حتفك؟

223
00:17:28,670 --> 00:17:32,300
!في هذه الحالة... فلتمُت

224
00:17:43,930 --> 00:17:46,100
!أيّها القذر

225
00:17:49,190 --> 00:17:50,020
!روكا

226
00:17:51,690 --> 00:17:53,530
نلتُ منه

227
00:17:53,690 --> 00:17:57,450
لا يستطيع إطلاق تلك التّعويذة الآن، صحيح؟

228
00:17:59,700 --> 00:18:03,450
!لا مشكلة! تعويذة دويّ ستفي بالغرض

229
00:18:03,620 --> 00:18:06,500
!سأحرقكم جميعاً

230
00:18:06,660 --> 00:18:07,870
...كيف تجرؤ

231
00:18:08,460 --> 00:18:10,500
!كيف تجرؤ على أذيّة صديقي؟

232
00:18:10,670 --> 00:18:12,090
!ستدفع ثمن هذا

233
00:18:12,590 --> 00:18:13,630
!دويّ

234
00:18:20,470 --> 00:18:23,100
!ما هذا الضّوء المُبهر؟

235
00:18:33,020 --> 00:18:34,400
!فعلها

236
00:18:34,900 --> 00:18:37,780
!هزمَ ملك الشّياطين

237
00:18:39,110 --> 00:18:40,950
!مرحى

238
00:18:43,740 --> 00:18:46,580
لا. ما زال ملك الشّياطين حيّاً

239
00:18:48,660 --> 00:18:51,210
...فلو مات فعلاً

240
00:18:52,380 --> 00:18:55,050
لأصبحت تلك الذّراع رماداً

241
00:18:56,010 --> 00:18:58,010
هذا برهان على أنّه لا يزال حيّاً

242
00:19:00,300 --> 00:19:02,680
!دقيق المُلاحظة

243
00:19:03,220 --> 00:19:07,480
أظنّني سأنسحب حاليّاً

244
00:19:08,180 --> 00:19:15,360
!لكن لن تهزمني بهذه القوّة الضّئيلة! أبداً

245
00:19:20,950 --> 00:19:22,320
معه حقّ

246
00:19:22,620 --> 00:19:27,620
بقوّتي الحالية، لا يمكنني هزيمة ملك الشّياطين

247
00:19:36,340 --> 00:19:39,130
ستغادر إذاً يا أفان؟

248
00:19:39,800 --> 00:19:42,890
هذا رمز السّلام الخاص بك

249
00:19:43,260 --> 00:19:47,260
حتّى يأتي اليوم الّذي تهزم فيه
...ملك الشّياطين وتنقذ العالم

250
00:19:48,430 --> 00:19:50,890
سوف أحتفظ بهذا

251
00:19:51,810 --> 00:19:54,270
سأحاول العودة سريعاً

252
00:19:55,190 --> 00:19:57,230
خُذ هذه معك كذلك

253
00:19:57,400 --> 00:20:01,740
إنّها تميمة كارل الّتي تناقلتها أجيال العائلة الملكيّة

254
00:20:01,900 --> 00:20:04,910
أنا متأكّدة أنّها ستفيدك يوماً ما

255
00:20:05,070 --> 00:20:06,370
حسناً إذاً

256
00:20:06,870 --> 00:20:08,910
اِقبلي بهذا من فضلك

257
00:20:09,540 --> 00:20:15,460
إنّه حجر مُقدّس صُنِع باستخدام العمليّة
السرّية الخاصّة بعائلة زينوار

258
00:20:15,630 --> 00:20:20,260
أنا الوحيد المُتبقّي الّذي يستطيع صنع هذا

259
00:20:20,420 --> 00:20:25,140
هل ستعطينني شيئاً قيّماً كهذا؟ متأكّد؟

260
00:20:26,430 --> 00:20:28,060
اعتبريها مُقايضة

261
00:20:36,020 --> 00:20:37,310
!روكا

262
00:20:37,650 --> 00:20:39,730
!أنا قادم معك يا أفان

263
00:20:39,900 --> 00:20:44,110
!يجب أن أردّ الاعتبار من ملك الشّياطين على ما فعله

264
00:20:44,280 --> 00:20:51,000
،لا يمكنك! من دون قائد التّنظيم
من سيحمي مملكة كارل؟

265
00:20:51,160 --> 00:20:55,710
لا مشكلة! يمكننا ترك الأمر للّذين درّبتُهم

266
00:20:55,880 --> 00:20:59,590
بالإضافة إلى ذلك، لا يمكننا تحقيق
شيء بمجرّد الدّفاع عن أنفسنا

267
00:20:59,750 --> 00:21:01,760
!علينا أن نبادر بالهجوم

268
00:21:01,920 --> 00:21:03,880
!خير وسيلة للدفاع هي الهجوم

269
00:21:04,470 --> 00:21:08,430
لكن لا يوجد ما يضمن بأن نفوز

270
00:21:08,600 --> 00:21:10,890
نحن نواجه ملك الشّياطين

271
00:21:11,270 --> 00:21:15,560
رأيتُ أملاً في سيف النّور الّذي لديك

272
00:21:15,730 --> 00:21:18,230
!لكن كان ذلك مُصادفة

273
00:21:18,400 --> 00:21:23,990
،سواء كانت مُصادفة أو ما زال ناقصاً
!هذا لا ينكر أنّه طرد ملك الشّياطين

274
00:21:24,490 --> 00:21:27,660
!أنا أؤمن بهذا النّور

275
00:21:38,670 --> 00:21:43,550
...بعد تدريب مُكثّف، تلك الضربة المُبهِرة

276
00:21:43,710 --> 00:21:47,260
قد اكتملت لتصبح أفان ستراش

277
00:21:53,350 --> 00:21:54,890
...أفان

278
00:21:55,480 --> 00:21:56,850
!ستراش

279
00:22:07,200 --> 00:22:12,080
بصراحة كنتُ أخرق

280
00:22:12,240 --> 00:22:18,420
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

281
00:22:18,920 --> 00:22:23,880
وحتّى أنّني استخدمتُ الوحدة كسلاح

282
00:22:24,050 --> 00:22:29,800
بحثتُ في الدّيماس عن جواب بسيط

283
00:22:29,970 --> 00:22:35,640
حتّى لو تخلّيتُ عن الحقّ واللّطف

284
00:22:35,810 --> 00:22:41,770
أريد أن أكون موجوداً بجانبك فحسب

285
00:22:41,940 --> 00:22:47,400
أن أنادي باسمك

286
00:22:47,570 --> 00:22:53,410
هو أصعب من أي تعويذة سحريّة

287
00:22:53,580 --> 00:22:59,210
رغم أنّك مقرّب جدّاً منّي

288
00:22:59,370 --> 00:23:01,830
أحبّك

289
00:23:02,000 --> 00:23:05,130
أدركتُ ذلك أخيراً

290
00:23:05,300 --> 00:23:10,260
أن أنادي باسمك

291
00:23:10,430 --> 00:23:16,680
هو السّبب الّذي وُلدت لأجله

292
00:23:16,850 --> 00:23:22,610
سأتخلّص من هذا اللّيل الطويل

293
00:23:22,770 --> 00:23:25,320
وآتي لرؤيتك

294
00:23:25,480 --> 00:23:30,070
إلى حيث أنت الآن

295
00:23:33,870 --> 00:23:37,160
لاكتساب تعويذة التّطهير العظيمة
،الأسطوريّة بريق

296
00:23:37,330 --> 00:23:41,750
تتحدّى ليونا والآخرون كهف المِحن
حيث تتجوّل الوحوش

297
00:23:41,920 --> 00:23:46,340
في هذه الأثناء، يستعين داي بمساعدة
نوفا كي يتدرّب بسيفه

298
00:23:46,500 --> 00:23:53,050
بينما يتعلّم بوب قوّة غامضة مخفيّة
في شارات أفان

299
00:23:53,220 --> 00:23:55,720
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

300
00:23:57,560 --> 00:23:59,680
!وتستمرّ المغامرة