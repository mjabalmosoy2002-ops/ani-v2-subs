1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:50,650 --> 00:01:54,440
!والآن! خذ هذه

20
00:01:57,570 --> 00:01:58,950
!فارن-ساما

21
00:02:02,410 --> 00:02:06,120
!مرحى! فعلَها داي

22
00:02:12,040 --> 00:02:13,710
!الآن يا مام

23
00:02:14,550 --> 00:02:16,880
!هذه فرصتنا للشفاء

24
00:02:18,380 --> 00:02:19,760
!نور الشفاء الكامل؟

25
00:02:19,930 --> 00:02:21,550
!بسرعة! حالاً

26
00:02:32,360 --> 00:02:37,900
...تقول الأسطورة أنّ العنقاء يُبعث من رماده، لكن

27
00:02:40,200 --> 00:02:43,160
كان ذلك أكثر ممّا توقّعت

28
00:02:43,620 --> 00:02:46,120
الهالة التنّينيّة

29
00:02:46,700 --> 00:02:51,460
قدرة مُرعبة من حيث الهجوم والدّفاع

30
00:02:52,830 --> 00:02:55,000
لا أستطيع الفوز وأنا أعزل

31
00:02:56,960 --> 00:02:59,590
يجب أن أستخدم سلاحي

32
00:03:00,880 --> 00:03:04,180
سلاحي الأسطوري الثّمين

33
00:03:07,220 --> 00:03:09,230
السّماوات تهتزّ

34
00:03:09,390 --> 00:03:14,020
سيحمل ملك الشّياطين العظيم
فارن أكثر الأسلحة رُعباً أخيراً

35
00:03:14,190 --> 00:03:16,530
كيف عرفت؟

36
00:03:16,690 --> 00:03:18,570
...هذا واضح

37
00:03:19,570 --> 00:03:20,860
لأنّني أنا من صنعتُه

38
00:03:29,330 --> 00:03:30,370
...هذا

39
00:03:33,380 --> 00:03:38,420
هذا هو سلاحي، عصا الشّراهة

40
00:03:39,340 --> 00:03:40,880
عصا الشّراهة؟

41
00:03:41,340 --> 00:03:43,760
النّتيجة محسومة

42
00:03:43,930 --> 00:03:47,930
الآن بعد أن صار كِلانا يحمل سلاحاً
،من صناعة لون بيروك

43
00:03:48,100 --> 00:03:51,390
ستُحدّد قوّتنا الفرديّة نتيجة هذه المعركة

44
00:03:51,940 --> 00:03:54,190
!صنعَه لون بيروك؟

45
00:03:54,350 --> 00:03:55,560
!أنت تكذب

46
00:03:56,230 --> 00:03:59,110
الرّجل ظلاميّ

47
00:03:59,570 --> 00:04:01,740
،نظراً إلى شخصيّته العسيرة

48
00:04:01,900 --> 00:04:07,330
حقيقة إعطائه أسلحة بشريّة لكم هي
أبعد سيناريو مُمكن

49
00:04:07,490 --> 00:04:13,500
منذ زمن بعيد، قدّمتُ له عدداً من الأسلحة
كسيف درع الشّيطان

50
00:04:13,870 --> 00:04:18,130
اختارَ فارن عصا الشّراهة سلاحاً خاصّاً له

51
00:04:18,300 --> 00:04:20,170
أي نوع من الأسلحة هو؟

52
00:04:20,510 --> 00:04:22,970
سمعتُم بالعصا الجسديّة، صحيح؟

53
00:04:23,130 --> 00:04:27,390
أجل. يحوّل القوّة السحريّة إلى نظيرتها من القوّة الهجوميّة

54
00:04:27,550 --> 00:04:29,470
يعمل هذا بنفس المبدأ

55
00:04:30,520 --> 00:04:36,770
لكن في حين أنّ العصا الجسديّة محدودة من
،حيث القوّة السحريّة التي تستطيع تحويلها

56
00:04:36,940 --> 00:04:39,770
لا تتقيّد عصا الشّراهة بأي حدود

57
00:04:39,940 --> 00:04:44,400
عندما يحملها ملك الشّياطين فارن
،العظيم بقوّته السحريّة الهائلة

58
00:04:44,570 --> 00:04:50,450
تصبح السّلاح الأعظم والأكثر تدميراً

59
00:04:52,410 --> 00:04:54,210
...والآن راقبوا

60
00:04:54,370 --> 00:04:56,790
تحفته العُظمى

61
00:05:04,550 --> 00:05:07,220
!اشربي! قوّتي السحريّة لكِ

62
00:05:29,910 --> 00:05:33,080
والآن... عاود المحاولة

63
00:06:36,270 --> 00:06:37,560
!انكسر؟

64
00:06:37,730 --> 00:06:40,900
!سيف داي القاهر المصنوع من الأوريكالكوم؟

65
00:06:45,400 --> 00:06:48,700
فقدتَ إرادتك للقتال

66
00:06:48,860 --> 00:06:53,620
لم يسبق أن صمدَ أمامي شخص هذه
المدّة في معركة

67
00:06:55,240 --> 00:06:56,790
...يمكنك أن تعتزّ بنفسك

68
00:06:57,500 --> 00:06:59,160
في الحياة الأخرى

69
00:07:00,330 --> 00:07:04,380
!داي! ما الأمر؟! انهض! تحرّك

70
00:07:04,880 --> 00:07:07,210
!انهض! عليك أن تنهض

71
00:07:07,380 --> 00:07:12,720
!لا أريد أن أراك هكذا قبل أن أموت

72
00:07:13,890 --> 00:07:17,680
!هذا آخر شيء سترونه في حياتكم

73
00:07:17,850 --> 00:07:20,690
!الجدار الكارثيّ

74
00:07:22,270 --> 00:07:24,400
!اشعروا به بأنفسكم

75
00:07:33,370 --> 00:07:36,410
!هيونكل! كروكوداين

76
00:07:37,080 --> 00:07:40,000
أنت معي في هذا يا كروكوداين؟

77
00:07:40,160 --> 00:07:45,040
!أجل! تنتمي حياتي لداي وأصدقائه سلفاً

78
00:07:45,210 --> 00:07:46,090
!أنتما

79
00:07:46,250 --> 00:07:47,130
!...مستحيل

80
00:07:47,300 --> 00:07:49,010
!أنتما، ابتعدا

81
00:07:50,010 --> 00:07:52,220
!لا يهمّ أين نكون

82
00:07:52,380 --> 00:07:55,970
...إن كنّا سنموت، فنريد أن نموت هنا

83
00:07:56,390 --> 00:08:00,180
!ونحن نحميك ولو للحظة إضافيّة واحدة

84
00:08:00,350 --> 00:08:03,900
!على الأٌقلّ دعنا نختار المكان الّذي نموت فيه

85
00:08:04,060 --> 00:08:05,360
!...لكن

86
00:08:18,740 --> 00:08:19,540
!هيونكل

87
00:08:19,700 --> 00:08:21,000
!أيّها الضّخم

88
00:08:26,960 --> 00:08:27,880
!داي

89
00:08:29,880 --> 00:08:32,090
لا جدوى. لا جدوى

90
00:08:33,550 --> 00:08:38,260
حالما يتمّ إطلاقه، لا أحد يستطيع إيقاف الجدار الكارثيّ

91
00:08:41,220 --> 00:08:42,430
...مام

92
00:08:43,180 --> 00:08:44,810
لديّ طلب

93
00:08:44,980 --> 00:08:46,020
...يدكِ

94
00:08:47,150 --> 00:08:51,740
هلّا أمسكتِ يدي حتّى آخر لحظة؟

95
00:09:22,640 --> 00:09:24,600
!مـ-مستحيل

96
00:09:24,770 --> 00:09:25,560
!هو؟

97
00:09:26,600 --> 00:09:28,900
!أنقذنا؟

98
00:09:41,790 --> 00:09:43,500
هذه مفاجأة

99
00:09:43,660 --> 00:09:50,460
ليس لأنّك ما زلت حيّاً فقط، بل
...لأنّك اصطففت مع البطل

100
00:09:51,250 --> 00:09:52,670
يا هدلر

101
00:09:53,300 --> 00:09:56,050
لم أصطفّ معه

102
00:09:56,510 --> 00:10:01,550
كلّ ما في الأمر أنّني لم أرد شخصاً
آخر أن يقتل داي وأصدقائه

103
00:10:02,310 --> 00:10:04,270
...فإذا هلكَ داي

104
00:10:04,770 --> 00:10:10,020
فذلك سيجعل تحوّلي إلى وحش بلا جدوى

105
00:10:10,190 --> 00:10:13,070
ولن يكون لديّ أيّ سبب للعيش

106
00:10:13,230 --> 00:10:17,030
إذاً لا تخف. فموتك وشيك

107
00:10:18,320 --> 00:10:23,580
النّواة السّوداء قد انصهرت سلفاً في جسدك

108
00:10:23,740 --> 00:10:28,330
الآن بعد أن أزيلت، لم يبقَ أمامك وقت طويل للعيش

109
00:10:29,750 --> 00:10:32,790
...لكن السّبب الرئيسي وراء موتك

110
00:10:33,550 --> 00:10:38,550
هو لأنّني سأعدمك هنا والآن

111
00:10:38,970 --> 00:10:44,760
لعلّي كنتُ سخيّاً، لمنحِك الفُرصة
،تلو الأخرى على مرّ السّنين

112
00:10:45,220 --> 00:10:50,650
لكن لستُ غفوراً لدرجة أبتسم فيها
عندما تُسرَق منّي فريستي

113
00:10:51,440 --> 00:10:57,150
لذلك، عليك ألّا تقلق بشأن سبب العيش

114
00:11:05,290 --> 00:11:06,740
نحن أحرار أخيراً

115
00:11:06,910 --> 00:11:08,580
...وجود هدلر-ساما

116
00:11:09,080 --> 00:11:10,000
!من هذا الاتّجاه

117
00:11:10,160 --> 00:11:11,170
!حسناً

118
00:11:15,590 --> 00:11:16,500
!ماذا؟

119
00:11:16,670 --> 00:11:20,170
!لماذا فارن-ساما هدلر-ساما...؟

120
00:11:20,340 --> 00:11:22,760
!يجب أن نساعد هدلر-ساما

121
00:11:22,930 --> 00:11:23,760
!لا تفعلوا

122
00:11:24,850 --> 00:11:26,560
!حقل هلاك هالة الدّمى الشيطانيّة

123
00:11:31,270 --> 00:11:34,110
حركة واحدة وسأثقب نُواتك

124
00:11:34,690 --> 00:11:36,320
...أولئك الأربعة

125
00:11:36,480 --> 00:11:39,400
!ما الّذي يجري هنا يا ميستوفارن؟

126
00:11:39,570 --> 00:11:44,700
أنقذَ هدلر داي وأصدقاءه من
فارن-ساما وسمح لهم بالإفلات

127
00:11:45,160 --> 00:11:48,450
بالتالي، سيتمّ إعدامه

128
00:11:48,620 --> 00:11:49,540
!ماذا؟

129
00:11:49,700 --> 00:11:51,620
لن تتدخّلوا

130
00:11:51,790 --> 00:11:55,080
اشهدوا نهاية مولاكم

131
00:11:55,250 --> 00:11:56,170
!لا

132
00:11:56,340 --> 00:11:57,590
!هدلر-ساما

133
00:12:00,300 --> 00:12:01,720
!إنّه سريع

134
00:12:01,880 --> 00:12:04,430
!مُت يا هدلر

135
00:12:04,590 --> 00:12:09,520
!تبّاً! هل سينتهي كلّ شيء هنا؟

136
00:12:09,680 --> 00:12:12,560
!من دون مُقاتلة أتباع أفان؟

137
00:12:12,730 --> 00:12:14,150
!هنا؟

138
00:12:15,020 --> 00:12:17,270
!اللّعنة

139
00:12:19,730 --> 00:12:21,280
!ما-ماذا؟

140
00:12:22,700 --> 00:12:26,780
أفضّل ألّا أُقتَل على يدك مرّتين

141
00:12:27,370 --> 00:12:31,120
...إذا كنتَ مُستميتاً على زهقِ روحي

142
00:12:31,910 --> 00:12:35,120
!فلا أملك خياراً سوى هزيمتك هنا

143
00:12:38,290 --> 00:12:44,340
!لا تستهن بي يا ملك الشّياطين العظيم

144
00:13:04,450 --> 00:13:05,950
!مستحيل

145
00:13:06,110 --> 00:13:09,200
!تصدّى لهجمتي؟

146
00:13:09,700 --> 00:13:16,290
!منحتُه جسداً يزداد قوّة في كلّ مرّة ينبعث فيها

147
00:13:16,710 --> 00:13:20,920
لكن لا يمكن أن ينبعث من دون هالتي الشّيطانيّة

148
00:13:23,720 --> 00:13:28,050
،الآن بعد أن أصبح شيطاناً خارقاً

149
00:13:28,220 --> 00:13:32,970
!ظننتُ أنّ هذه القوّة قد فُقِدت

150
00:13:33,680 --> 00:13:37,850
لكنّه عاد من حفرة الموت

151
00:13:38,310 --> 00:13:44,860
!والآن يبدو أنّه قد يصبح قويّاً بما يكفي لمُنافستي

152
00:13:45,400 --> 00:13:47,200
!توقّف يا هدلر

153
00:13:47,360 --> 00:13:50,990
ألا تكترث لما يحدث لخدمِك؟

154
00:13:51,280 --> 00:13:52,660
لا أكترث

155
00:13:53,080 --> 00:13:55,120
افعلوا ما تشاؤوا

156
00:13:57,170 --> 00:14:02,170
إذا مُتّ، سيموتون على أيّ حال

157
00:14:02,340 --> 00:14:06,170
!الحرس الملكيّ التّابع لهدلر يتوحّد

158
00:14:06,340 --> 00:14:10,300
!هدفنا الوحيد هو هزيمة أتباع أفان

159
00:14:12,100 --> 00:14:18,520
لا أحد من خدمي يخشى الموت
!ما دام ذلك يخدم غايتنا

160
00:14:18,690 --> 00:14:20,360
مُذهل

161
00:14:20,690 --> 00:14:24,480
!كان ذلك قولاً سديداً يا هدلر-ساما

162
00:14:25,030 --> 00:14:31,030
!فارن! أنت من سيموت اليوم

163
00:14:38,250 --> 00:14:44,550
أتظنّ حقّاً أنّك تستطيع هزيمتي بزيادة
!هزيلة في القوّة؟

164
00:14:45,380 --> 00:14:48,720
لو كان الأمر يقتصر على ذلك
لشككتُ في قدرتي على هزيمتك

165
00:14:48,880 --> 00:14:52,260
!لكن في وضعك الحالي، تختلف الحكاية

166
00:14:53,760 --> 00:14:59,350
أعتقد أنّ العصا تمتصّ القوّة السحريّة
!وتحوّلها إلى قوّة هجوميّة

167
00:14:59,520 --> 00:15:04,980
معنى هذا أنّ مُجرّد حملها يستنزف
!قوّتك السحريّة باستمرار

168
00:15:05,940 --> 00:15:11,030
استطعتُ كسر سيف داي، لكن
...ليس سيف الأوريكالكوم هذا

169
00:15:11,200 --> 00:15:12,410
!فهمتُ الآن

170
00:15:12,570 --> 00:15:18,910
!مُقاتلة داي وأصدقائه استنزفت قوّتي السحريّة

171
00:15:20,870 --> 00:15:23,250
!يبدو أنّك فهمت

172
00:15:23,420 --> 00:15:29,970
بانحسار قوّتك السحريّة في صِراع
!قوّة، أمتلك الأفضليّة

173
00:15:34,300 --> 00:15:35,100
!لا

174
00:15:35,260 --> 00:15:36,350
!حذارِ

175
00:15:36,850 --> 00:15:42,400
!لا نعلم ماذا سنفعل إذا حرّرتَ هذه القيود

176
00:15:44,560 --> 00:15:46,190
!معك حقّ

177
00:15:46,360 --> 00:15:52,530
عليك أن تحتسب أنّ حركة واحدة منك
...ستؤدّي إلى حرقك بالكامل

178
00:15:52,700 --> 00:15:54,200
يا سيّد حاصد الأرواح

179
00:15:54,370 --> 00:15:57,540
دُمية متغطرسة تافهة

180
00:16:10,800 --> 00:16:14,090
!عنقاء القيصر

181
00:16:25,190 --> 00:16:29,690
في العادة، كان هذا ليحوّلني إلى رماد

182
00:16:29,860 --> 00:16:34,280
!يبدو أنّ قوّتك السحريّة تضعف بالفعل

183
00:16:37,240 --> 00:16:39,490
!لن أفوّت هذه الفرصة

184
00:16:40,410 --> 00:16:42,330
!هجوم الاحتراق القاطع الخارق الخاص بك؟

185
00:16:44,960 --> 00:16:47,540
!استعدّ للموت

186
00:16:51,760 --> 00:16:52,550
!...هذا

187
00:16:55,800 --> 00:16:57,010
!زابويرا؟

188
00:16:57,180 --> 00:17:01,600
أتجرؤ على نكران جميلي بعد أن
!جعلتُك شيطاناً خارقاً؟

189
00:17:03,600 --> 00:17:04,810
انسَ الأمر

190
00:17:04,980 --> 00:17:08,110
هذه التّعويذة تشلّ حركتي، لكنّها تُقيّدك كذلك

191
00:17:08,270 --> 00:17:09,900
!هذا المُتطفّل التّافه

192
00:17:10,070 --> 00:17:13,740
!هذه فُرصتك يا ملك الشّياطين

193
00:17:13,900 --> 00:17:16,450
أحسنتَ صنعاً يا زابويرا

194
00:17:16,950 --> 00:17:19,700
ثبّته مكانه

195
00:17:19,870 --> 00:17:21,160
!مولاي

196
00:17:23,790 --> 00:17:25,080
!هدلر-ساما

197
00:17:25,540 --> 00:17:27,830
انقلبت الموازين الآن

198
00:17:29,340 --> 00:17:31,000
!هدلر-ساما

199
00:17:37,590 --> 00:17:39,930
!تبّاً

200
00:17:41,390 --> 00:17:42,180
!بلوك؟

201
00:17:56,150 --> 00:17:57,280
!أين هدلر؟

202
00:18:00,120 --> 00:18:02,120
!ما-ماذا؟

203
00:18:04,410 --> 00:18:06,330
!بلوك

204
00:18:08,620 --> 00:18:10,000
...أنتم

205
00:18:10,170 --> 00:18:13,250
...اعتنوا... بهدلر-ساما

206
00:18:18,010 --> 00:18:20,850
!بلوك

207
00:18:32,320 --> 00:18:33,770
!غبيّ

208
00:18:34,110 --> 00:18:36,610
!ماذا تعني بـ"اعتنوا بهدلر-ساما"؟

209
00:18:37,110 --> 00:18:40,780
!لا أصدّق أنّ هذه كانت كلماتك الأولى؟

210
00:18:41,740 --> 00:18:43,330
...بلوك

211
00:18:51,670 --> 00:18:53,340
هربوا أخيراً إذاً

212
00:18:53,500 --> 00:18:57,550
لم يتوقّع أحد أن يمتلك القلعة مثل هذه القدرة

213
00:18:57,720 --> 00:18:59,220
...القلعة

214
00:18:59,380 --> 00:19:00,840
هكذا إذاً

215
00:19:01,010 --> 00:19:03,760
مُناورة القلعة

216
00:19:03,930 --> 00:19:05,680
مُناورة القلعة؟

217
00:19:05,850 --> 00:19:07,350
،في لعبة الشّطرنج

218
00:19:07,520 --> 00:19:13,480
هناك نقلة يتمّ فيها تبادل بين الملك والقلعة

219
00:19:14,150 --> 00:19:18,070
وُلِد ذلك المُحارب من قلعة

220
00:19:18,530 --> 00:19:22,570
لا عجب في أن تمتلك تلك القطعة مثل هذه القدرة

221
00:19:23,660 --> 00:19:28,250
لكن كنتُ على وشك إنهاء هدلر

222
00:19:28,870 --> 00:19:31,620
...لو كانت هذه لعبة شطرنج

223
00:19:32,380 --> 00:19:36,880
!لكانت هذه المُناورة غشّاً من بعد كشّ الملك

224
00:19:49,060 --> 00:19:52,140
!داي؟! أين داي؟

225
00:19:52,310 --> 00:19:55,310
!ظننتُه سقطَ معنا

226
00:19:55,480 --> 00:19:57,610
!هل يُعقل أنّه ما زال...؟

227
00:20:05,160 --> 00:20:07,950
!هل هذا ما تكلّم عنه هيونكل؟

228
00:20:08,120 --> 00:20:12,620
التنّين الأمّ المُقدّسة

229
00:20:12,790 --> 00:20:18,300
إذاً هذا ما قيل بأنّه يظهر عندما تنتهي حياة فارس تنّين

230
00:20:21,340 --> 00:20:23,180
...هذه المعركة

231
00:20:23,800 --> 00:20:26,050
!مِلكي أنا

232
00:20:31,640 --> 00:20:33,440
!بوب، انظر

233
00:20:35,900 --> 00:20:36,980
!داي؟

234
00:20:38,270 --> 00:20:39,610
!لحظة

235
00:20:39,780 --> 00:20:41,570
!لم يمُت داي بعد

236
00:20:41,740 --> 00:20:45,660
!مُحال أن يموت داي

237
00:20:45,820 --> 00:20:46,990
!انتظر

238
00:20:48,200 --> 00:20:52,370
!لا تأخذه بعيداً

239
00:20:53,830 --> 00:20:54,750
!انظروا

240
00:21:03,760 --> 00:21:04,970
!سلاحهما؟

241
00:21:05,470 --> 00:21:10,430
لم يعودا إلى حاملهما، بل للسيّد لون بيروك؟

242
00:21:10,600 --> 00:21:13,100
!هل يُعقَل أن يكون داي والآخرون...؟

243
00:21:18,270 --> 00:21:23,240
أشكّ في مجيء أيّ شخص لمحاولة إحباط مخطّطاتي

244
00:21:23,530 --> 00:21:30,280
،حتّى ولو أنجبت التنّين الأمّ فارس تنّين جديد

245
00:21:30,450 --> 00:21:35,080
يستغرق نضوجه بالكامل قروناً

246
00:21:35,410 --> 00:21:42,380
بينما أحتاج لأقلّ من عشرة أيّام لحرق
عالم السّطح وجعله رماداً

247
00:21:42,550 --> 00:21:48,590
كلّ ما علينا هو الحذر من أي مُقاومة
يائسة من طرف هدلر

248
00:21:49,720 --> 00:21:52,180
تعالوا يا أتباعي

249
00:21:54,270 --> 00:21:59,020
حان وقت تدمير العالم

250
00:22:07,240 --> 00:22:12,120
بصراحة كنتُ أخرق

251
00:22:12,280 --> 00:22:18,460
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

252
00:22:18,960 --> 00:22:23,920
وحتّى أنّني استخدمتُ الوحدة كسلاح

253
00:22:24,090 --> 00:22:29,840
بحثتُ في الدّيماس عن جواب بسيط

254
00:22:30,010 --> 00:22:35,680
حتّى لو تخلّيتُ عن الحقّ واللّطف

255
00:22:35,850 --> 00:22:41,810
أريد أن أكون موجوداً بجانبك فحسب

256
00:22:41,980 --> 00:22:47,440
أن أنادي باسمك

257
00:22:47,610 --> 00:22:53,450
هو أصعب من أي تعويذة سحريّة

258
00:22:53,620 --> 00:22:59,250
رغم أنّك مقرّب جدّاً منّي

259
00:22:59,420 --> 00:23:01,880
أحبّك

260
00:23:02,040 --> 00:23:05,170
أدركتُ ذلك أخيراً

261
00:23:05,340 --> 00:23:10,300
أن أنادي باسمك

262
00:23:10,470 --> 00:23:16,720
هو السّبب الّذي وُلدت لأجله

263
00:23:16,890 --> 00:23:22,650
سأتخلّص من هذا اللّيل الطويل

264
00:23:22,810 --> 00:23:25,360
وآتي لرؤيتك

265
00:23:25,520 --> 00:23:30,110
إلى حيث أنت الآن

266
00:23:34,030 --> 00:23:38,910
،بعد أن هُزِموا من قِبل ملك الشّياطين العظيم فارن
،يفلت أبطالنا بفضل هدلر

267
00:23:39,080 --> 00:23:41,540
لكنّهم تفرّقوا جميعاً

268
00:23:41,710 --> 00:23:44,080
،تأخذ التنين الأمّ داي فجأة

269
00:23:44,250 --> 00:23:47,130
!بينما يُجرَف بوب ومام إلى مملكة كارل

270
00:23:47,300 --> 00:23:49,340
،وبينما يدعو بوب لسلامة أصدقائه

271
00:23:49,510 --> 00:23:53,840
يدرك أنّ فارن قد شرع في هجومه على العالم

272
00:23:54,010 --> 00:23:56,310
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

273
00:23:58,140 --> 00:24:00,060
!وتستمرّ المغامرة