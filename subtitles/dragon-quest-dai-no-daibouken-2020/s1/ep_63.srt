1
00:00:19,120 --> 00:00:22,450
بروابطك مع أصدقائك

2
00:00:22,620 --> 00:00:26,210
التي يعتنقها قلبك

3
00:00:26,380 --> 00:00:29,920
كلمح البصر
في رمشة عين

4
00:00:30,090 --> 00:00:33,300
تخاطر بها كلّها

5
00:00:33,470 --> 00:00:38,930
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,930 --> 00:00:44,850
مراراً وتكراراً
أمام قدرك المشتعل

7
00:00:45,020 --> 00:00:48,770
إذا كان هذا ما تختاره

8
00:00:48,940 --> 00:00:52,190
حتّى لو آلمك

9
00:00:52,650 --> 00:00:55,950
حتّى لو تعثّرت

10
00:00:56,110 --> 00:00:58,870
استمرّ حتّى آخر رحلتك

11
00:00:59,030 --> 00:01:04,080
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,420 --> 00:01:11,710
تستطيع النهوض
أنت الأشجع

13
00:01:14,840 --> 00:01:18,720
تستطيع النهوض
أنت الأشجع

14
00:01:18,890 --> 00:01:22,560
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,720 --> 00:01:26,310
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,520 --> 00:01:29,980
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,150 --> 00:01:34,150
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,610 --> 00:01:40,200
أنت الأشجع

19
00:01:53,380 --> 00:01:55,090
!لنعُد إلى الأدراج بسرعة

20
00:02:07,230 --> 00:02:08,570
!هل الجميع بخير؟

21
00:02:08,570 --> 00:02:10,480
أجل

22
00:02:10,480 --> 00:02:12,030
أنا بخير

23
00:02:12,030 --> 00:02:13,190
...لكن

24
00:02:17,360 --> 00:02:19,740
هذه مشكلة

25
00:02:21,200 --> 00:02:26,500
استغرقنا عشر ساعات. مع الأسف، علينا العودة

26
00:02:27,750 --> 00:02:30,380
الملكة فلورا، لنستمرّ في التقدّم

27
00:02:30,380 --> 00:02:31,460
ماذا؟

28
00:02:31,460 --> 00:02:32,630
!ليونا؟

29
00:02:32,630 --> 00:02:38,380
لا يوجد ما يضمن أن نجد طريقاً للعودة
في غضون عشر ساعات

30
00:02:38,760 --> 00:02:41,600
لنغتنم فرصتنا لإيجاد بريق

31
00:02:41,600 --> 00:02:44,640
!لكن حينئذ ستستغرق العودة وقتاً أطول

32
00:02:44,640 --> 00:02:47,100
،لدينا حجران مُقدّسان فقط

33
00:02:47,100 --> 00:02:51,980
لكن إذا استخدمنا بريق، فقد يطرد ذلك خبائث هذا الكهف

34
00:02:51,980 --> 00:02:55,700
ينبغي لذلك أن يسمح لـ"إخلاء" الخاصّة
بالملكة فلورا بإخراجنا

35
00:02:55,700 --> 00:02:59,950
لكن سيتطلّب الأمر معجزة للنجاح

36
00:03:01,320 --> 00:03:07,290
أملنا هو تحقيق المُعجزة العظيمة وهي هزيمة فارن

37
00:03:07,290 --> 00:03:11,830
فكيف نأمل فعل ذلك ونحن لا نستطيع
تحقيق معجزة صغيرة كهذه أوّلاً؟

38
00:03:23,510 --> 00:03:25,720
!لا وقت لمقاتلتهم

39
00:03:26,100 --> 00:03:28,150
!هيّا بنا جميعاً

40
00:03:28,150 --> 00:03:29,600
!حسناً -
!هيّا -

41
00:03:30,430 --> 00:03:35,230
كنتُ محقّة في اختياركِ يا ليونا

42
00:03:35,900 --> 00:03:41,820
تمتلك كلماتكِ قوّة تمدّ الناس بالطاقة

43
00:03:45,700 --> 00:03:47,030
بقي عشر ساعات

44
00:03:49,870 --> 00:03:53,370
!أنا متأكّدة أنّنا نستطيع الحصول على بريق

45
00:03:54,540 --> 00:03:58,050
!أفان ستراش

46
00:04:11,060 --> 00:04:12,270
!جيّد

47
00:04:12,770 --> 00:04:16,360
!تعلّمت إطلاق نوع السّهم السّريع المُتتابع

48
00:04:16,360 --> 00:04:21,320
لكن لا أعتقد أنّ هذا يكفي لصدّ عنقاء
القيصر الخاصّة بفارن

49
00:04:22,320 --> 00:04:27,370
عندما خرقتُ تعويذته من قبل، استخدمتُ النوع الانفجاري

50
00:04:28,330 --> 00:04:33,210
الآن بعدما صرتُ لا أحمل سلاحي ولا أستطيع
،استخدام هجماتي بهالتي التنّينيّة

51
00:04:33,210 --> 00:04:39,880
أحتاج هجمة بسرعة نوع السّهم وقوّة النّوع الانفجاري

52
00:04:42,260 --> 00:04:43,330
ما الأمر؟

53
00:04:43,330 --> 00:04:46,140
نوفا، هلّا جهّزت نفسك؟

54
00:04:49,970 --> 00:04:53,400
!فكّرتُ بهجمة جديدة للتو

55
00:04:53,400 --> 00:04:55,440
هجمة جديدة؟

56
00:04:56,730 --> 00:05:01,530
هل اكتشفت نوعاً ثالثاً من أفان ستراش؟

57
00:05:01,530 --> 00:05:03,990
الأمر ليس مذهلاً إلى هذا الحدّ

58
00:05:05,450 --> 00:05:08,620
فليكُن نصل الهالة الخاص بك بأقصى قوّته

59
00:05:09,450 --> 00:05:10,780
حسناً

60
00:05:12,330 --> 00:05:13,870
!هيّا

61
00:05:17,460 --> 00:05:21,300
تبدو نفس الوقفة

62
00:05:21,920 --> 00:05:23,460
...لحظة

63
00:05:30,850 --> 00:05:32,680
!ها أنا ذا

64
00:05:56,250 --> 00:05:58,210
هل أنت جادّ...؟

65
00:05:59,040 --> 00:06:03,630
!لو لم يكن سلاحي نصل الهالة لكان رأسي قد قُطِع

66
00:06:03,630 --> 00:06:05,970
آسف بشأن ذلك

67
00:06:05,970 --> 00:06:07,390
!لكن نجح هذا

68
00:06:07,390 --> 00:06:11,510
!إنّه جزء صغير من ترسانتنا، لكن حصلنا على قوّة جديدة

69
00:06:12,180 --> 00:06:15,270
جزء صغير"؟"

70
00:06:15,270 --> 00:06:20,650
بالنسبة لي، يبدو لي وكأنّك ابتكرتَ هجمة جديدة مُرعبة

71
00:06:20,650 --> 00:06:22,230
أتظنّ ذلك؟

72
00:06:23,570 --> 00:06:25,820
تُذهلني باستمرار

73
00:06:26,190 --> 00:06:28,950
لا أصدّق أنّني حاولتُ مُنافستك

74
00:06:30,160 --> 00:06:31,870
هذا ليس بالأمر الجلل

75
00:06:34,540 --> 00:06:37,330
!أجل. لنواصل التدريب

76
00:06:37,790 --> 00:06:39,580
!هيّا بنا إذاً

77
00:06:57,680 --> 00:07:00,320
هذا هو الطابق 25

78
00:07:00,320 --> 00:07:03,400
الطابق الّذي توجد فيه تعويذة بريق

79
00:07:14,120 --> 00:07:18,330
أشعر بقوّة غريبة من المنطقة الوسطى

80
00:07:18,330 --> 00:07:21,420
لا بدّ وأنّه مذبح الطقوس

81
00:07:24,540 --> 00:07:26,430
هل سأصلّي هنا إذاً؟

82
00:07:26,430 --> 00:07:27,760
هكذا يبدو

83
00:07:27,760 --> 00:07:29,260
ارتدي شارة أفان خاصّتك

84
00:07:29,260 --> 00:07:30,260
حسناً

85
00:07:37,260 --> 00:07:38,390
!سأبدأ

86
00:07:44,310 --> 00:07:45,570
حان الوقت أخيراً

87
00:07:45,570 --> 00:07:46,770
أجل

88
00:07:49,820 --> 00:07:51,700
!أشعر بوجود وحوش

89
00:07:53,360 --> 00:07:55,490
هذا لا يدعو للاستغراب

90
00:07:55,990 --> 00:07:57,330
ليونا

91
00:07:57,330 --> 00:08:00,920
دعي الوحوش علينا. ركّزي على الطقوس

92
00:08:00,920 --> 00:08:02,040
!حسناً

93
00:08:09,000 --> 00:08:10,460
!ها هم قادمون

94
00:08:27,020 --> 00:08:27,980
!...اللّعنة

95
00:08:36,490 --> 00:08:37,490
!هناك المزيد

96
00:08:43,120 --> 00:08:45,090
يا لها من مجموعة ترحيب

97
00:08:45,090 --> 00:08:49,260
لماذا يقطن كثير من الوحوش في كهف
صنعه إله البشر؟

98
00:08:49,260 --> 00:08:55,810
وفقاً لنصوص حكيم قديمة، الطابق
الأدنى في كهف المِحن

99
00:08:55,810 --> 00:08:57,430
متّصل بالعالم السّفلي

100
00:08:58,890 --> 00:09:00,970
!لن تقتربوا أكثر

101
00:09:05,390 --> 00:09:07,020
...الأميرة ليونا

102
00:09:11,940 --> 00:09:14,400
!بدأت طقوس الإرث

103
00:09:18,990 --> 00:09:24,500
يا إله البشر، امنحني هذه التّعويذة الأسطوريّة

104
00:09:24,500 --> 00:09:29,540
...كلمة القوّة المُشبعة بالقوّة المُقدّسة

105
00:09:30,630 --> 00:09:32,250
!بريق

106
00:09:36,880 --> 00:09:37,760
!ليونا

107
00:09:38,970 --> 00:09:40,430
!الأميرة ليونا

108
00:09:40,430 --> 00:09:42,810
!هذه ليست ناراً حقيقيّة

109
00:09:43,180 --> 00:09:46,730
!إنّها طاقة روحيّة. لهب الرّوح

110
00:09:46,730 --> 00:09:48,320
!هذا وهم إذاً؟

111
00:09:48,320 --> 00:09:53,320
لا. لا بدّ وأنّ هذا اختبار تركَه إله البشر

112
00:09:53,320 --> 00:09:57,660
...إذا كانت ليونا غير جديرة باستخدام بريق

113
00:09:57,660 --> 00:10:02,410
فسوف تحرقها هذه النّار

114
00:10:02,410 --> 00:10:03,490
!لا

115
00:10:05,580 --> 00:10:06,960
!ليونا

116
00:10:06,960 --> 00:10:10,040
!ليونا، كوني قويّة! حافظي على إرادة شديدة

117
00:10:41,780 --> 00:10:47,620
أنت يا من تسعى للحصول على بريق، هِب روحك

118
00:10:48,210 --> 00:10:50,960
!ر... روحي؟

119
00:10:50,960 --> 00:10:56,390
اكشف عن جذرِ روحك الّتي تسعى
للحصول على قوّة التّطهير

120
00:10:56,390 --> 00:11:02,890
هل لديك هدف جدير بهذه القوّة العظيمة أم لا؟

121
00:11:02,890 --> 00:11:07,560
!لا أستطيع الإجابة عن سؤال صعب كهذا فجأة

122
00:11:07,560 --> 00:11:13,150
!لديّ سبب واحد للسعي خلف قوّة التّطهير

123
00:11:13,730 --> 00:11:15,690
!لأنّني مؤمنة

124
00:11:15,690 --> 00:11:19,160
!بالعالم الّذي وُلدتُ وترعرعتُ فيه! في كلّ بلدانه

125
00:11:19,160 --> 00:11:22,990
!وفي كلّ النّاس الّذين يعيشون فيه

126
00:11:23,450 --> 00:11:25,540
!لا لهزيمة الشرّ

127
00:11:25,540 --> 00:11:32,000
!بل للإثبات بأنّ الأشياء التي ورثناها لم تكن خطأ

128
00:11:32,540 --> 00:11:35,340
!لأجل ذلك، أحتاج للقوّة! هذا كلّ ما في الأمر

129
00:11:50,850 --> 00:11:51,820
!اللّهب

130
00:11:51,820 --> 00:11:53,730
!ما هذا الضوء الأبيض؟

131
00:11:53,730 --> 00:11:58,320
!هذه هي إرادة رؤية الحقيقة والسّعي خلف الصّواب

132
00:11:58,690 --> 00:12:00,610
هذه قوّة ليونا

133
00:12:01,110 --> 00:12:03,990
!نور روح العدالة

134
00:12:10,080 --> 00:12:12,580
!أنتنّ! اقتربن منّي

135
00:12:28,220 --> 00:12:30,180
!بريق

136
00:12:36,650 --> 00:12:38,700
!عمود من نور؟

137
00:12:38,700 --> 00:12:40,660
!لا بدّ وأنّها ليونا

138
00:12:40,660 --> 00:12:42,320
!هيّا بنا نرجع

139
00:13:03,720 --> 00:13:05,130
!غبيّ

140
00:13:14,690 --> 00:13:16,190
!هذا سيّئ

141
00:13:16,190 --> 00:13:19,700
...مهما استهلكتُ قوّتي السحريّة

142
00:13:19,700 --> 00:13:22,610
...مهما عاقبتُ نفسي

143
00:13:24,990 --> 00:13:26,570
...إنّها

144
00:13:27,410 --> 00:13:29,490
!لا تتوهّج إطلاقاً

145
00:13:50,260 --> 00:13:54,220
...رغم أنّ خاصّته كانت مؤقّتة أيضاً

146
00:13:54,850 --> 00:13:57,270
كان والد داي فارس تنّين

147
00:13:57,270 --> 00:13:59,990
ليونا هي أميرة بابنيكا

148
00:13:59,990 --> 00:14:05,440
ووالدا مام كانا المحارب والكاهنة من فريق المعلّم أفان

149
00:14:05,690 --> 00:14:12,530
وهيونكل هو مقاتل محترف تدرّب بواسطة
الخير والشرّ منذ طفولته

150
00:14:14,290 --> 00:14:15,920
!أنا الوحيد

151
00:14:15,920 --> 00:14:18,580
!أنا المختلف الوحيد

152
00:14:21,040 --> 00:14:23,210
!لستُ مثلهم

153
00:14:43,440 --> 00:14:47,610
ما الأمر يا بوب؟ قل شيئاً

154
00:14:48,110 --> 00:14:51,910
أتيت إلى هنا بحثاً عن نصيحة، صحيح؟

155
00:14:53,910 --> 00:14:55,240
ما الأمر؟

156
00:14:57,450 --> 00:14:58,580
...في الواقع

157
00:15:04,670 --> 00:15:05,840
لا أستطيع إخبارك

158
00:15:05,840 --> 00:15:09,140
...قد تكون مُرشدي، لكن هذا

159
00:15:09,140 --> 00:15:11,680
حسناً، لا جدوى من هذا

160
00:15:11,680 --> 00:15:15,270
كيف أعطيك نصيحة وأنت لا تقول شيئاً؟

161
00:15:15,270 --> 00:15:18,060
لستُ بصّاراً

162
00:15:18,060 --> 00:15:19,350
أعلم ذلك

163
00:15:21,230 --> 00:15:27,490
أعلم أنّ طلب النّصيحة منك لن يحلّ ما يؤرقني

164
00:15:27,490 --> 00:15:30,860
هذه مشكلتي الشخصيّة

165
00:15:31,200 --> 00:15:32,540
...لكن

166
00:15:32,540 --> 00:15:36,170
أشكّ في أن يكون شيئاً أستطيع إيجاد حلّ له

167
00:15:36,170 --> 00:15:39,750
أنا مجرّد ابن عادي لتاجر أسلحة

168
00:15:39,750 --> 00:15:43,880
في النّهاية، اصطدمتُ بجدار لا يمكنني تجاوزه أخيراً

169
00:15:44,590 --> 00:15:47,250
أعتقد أنّ هذا كلّ ما في الأمر

170
00:15:47,630 --> 00:15:49,890
...لكن... مع ذلك

171
00:15:49,890 --> 00:15:53,560
!لا أريد أن أشكّل عبئاً على الآخرين

172
00:15:53,560 --> 00:15:57,310
!لا أعرف ماذا ينبغي أن أفعل بعد الآن

173
00:15:57,770 --> 00:16:00,680
لذا انتهى المطاف بي هنا

174
00:16:07,780 --> 00:16:11,620
آسف. أشعر بالفخر بعض الشيء

175
00:16:11,620 --> 00:16:13,860
بالفخر؟

176
00:16:14,160 --> 00:16:17,670
لا أملك فكرة عمّا تمرّ به

177
00:16:17,670 --> 00:16:23,340
لكن رؤية الطفل الشقيّ الغرّ الّذي
درّبتُه يصل إلى هذا المستوى

178
00:16:23,340 --> 00:16:25,800
يجعلني سعيداً وحزيناً في نفس الوقت

179
00:16:25,800 --> 00:16:28,920
أشعر بوخز في الدّاخل

180
00:16:29,380 --> 00:16:32,560
،لم أمتلك زوجة أو طفلاً

181
00:16:32,560 --> 00:16:37,350
لكن أعتقد هذا ما يشعر به الآباء

182
00:16:37,350 --> 00:16:38,970
...المُرشد

183
00:16:39,560 --> 00:16:42,020
،الآن بعد أن علّمتُك ميدروا

184
00:16:42,020 --> 00:16:46,520
من حيث القتال، تفوّقتَ عليّ غالباً

185
00:16:47,270 --> 00:16:52,860
لو كنتُ أمتلك شارة ماتوريف، لأعطيتُك
!إيّاها منذ زمن طويل

186
00:16:58,410 --> 00:16:59,740
بوب؟

187
00:17:00,040 --> 00:17:03,840
آسف أيّها المُرشد لأنيني بهذا الشكل

188
00:17:03,840 --> 00:17:07,130
سوف... سوف أجد الحلّ بنفسي

189
00:17:08,040 --> 00:17:09,550
انتظر

190
00:17:09,960 --> 00:17:14,430
اسمع. هذه آخر نصيحة منّي لك

191
00:17:14,430 --> 00:17:16,300
آخر"؟"

192
00:17:17,550 --> 00:17:19,390
آمن بنفسك

193
00:17:19,390 --> 00:17:22,020
أؤمن بنفسي؟

194
00:17:22,680 --> 00:17:27,360
لو كنتَ مجرّد طفل مُدلّل، لما وصلتَ إلى هنا

195
00:17:27,360 --> 00:17:31,700
،لأنّك كنتَ ابن تاجر أسلحة، كان أفان مُلهمك

196
00:17:31,700 --> 00:17:35,200
وضاعفتَ جهودك أكثر من الجميع للوصول إلى هنا

197
00:17:35,700 --> 00:17:37,450
تحلَّ ببعض الثّقة

198
00:17:37,450 --> 00:17:39,370
أنت قويّ

199
00:17:40,120 --> 00:17:43,910
أنا فخور بمناداتك تلميذي

200
00:17:52,590 --> 00:17:57,840
بوب، أنا متأكّد بأنّني أعرف ما تمرّ ب

201
00:17:59,050 --> 00:18:03,650
لعلّ هذه العقبة الكبرى في حياتك

202
00:18:03,650 --> 00:18:04,850
...لكن

203
00:18:05,480 --> 00:18:08,280
...إذا استطعت التغلّب عليها

204
00:18:08,280 --> 00:18:14,400
سوف تصل إلى مكان لم أستطع الوصول إليه

205
00:18:20,490 --> 00:18:23,790
!اكتسبنا تعويذة تطهير العظيمة، بريق

206
00:18:28,580 --> 00:18:32,090
...سننجح في خطّتنا لإنقاذ هيونكل وكروكوداين

207
00:18:32,090 --> 00:18:36,550
!ثمّ سنرسل فريق البطل إلى قصر فارن

208
00:18:38,720 --> 00:18:41,980
عادت الأميرة بالسّلامة

209
00:18:41,980 --> 00:18:43,640
!فعلتِها يا ليونا

210
00:18:43,640 --> 00:18:47,100
أجل! كان ذلك سهلاً جدّاً، أليس كذلك؟

211
00:18:49,770 --> 00:18:56,530
ينبغي لهذا الحجر المُقدّس أن يتوهّج كشارة أفان الآن

212
00:18:56,530 --> 00:18:57,820
!أجل

213
00:19:00,950 --> 00:19:02,580
!كان ذلك لا يُصدّق

214
00:19:02,580 --> 00:19:08,120
صحيح. ليونا أميرة ملكيّة وحتّى هي تسعى جاهدة

215
00:19:08,460 --> 00:19:12,420
!يجب أن أضاعف جهودي عشر مرّات على الأقلّ

216
00:19:17,630 --> 00:19:21,430
ماذا عنك؟ هل سار تدريبك على ما يُرام؟

217
00:19:21,430 --> 00:19:26,810
!على ما يُرام؟ اخترع هجمة جديدة بسهولة

218
00:19:26,810 --> 00:19:28,890
!هذا مذهل

219
00:19:30,230 --> 00:19:34,820
الآن كلّ ما أحتاجه هو سيف يستطيع
...تحمّل هالتي التنّينيّة

220
00:19:34,820 --> 00:19:38,530
ليت لدينا سيف داي الخاص بك

221
00:19:38,530 --> 00:19:41,040
!الملكة فلورا! حالة طارئة

222
00:19:41,040 --> 00:19:44,410
!يقترب ظلاميّ من الحصن

223
00:19:44,410 --> 00:19:45,830
!ماذا؟

224
00:19:52,460 --> 00:19:55,540
!لحظة! إنّه ليس عدوّاً

225
00:19:58,920 --> 00:20:01,060
يا له من ترحيب عدائيّ

226
00:20:01,060 --> 00:20:05,520
!بالفعل! أنتم تهينون مُنقذكم هنا

227
00:20:05,520 --> 00:20:06,640
!لون بيروك

228
00:20:07,100 --> 00:20:09,360
!هيّا! أفسحوا الطريق

229
00:20:09,360 --> 00:20:13,520
!سموّكِ! تسرّني رؤيتكِ بالسّلامة

230
00:20:14,440 --> 00:20:16,990
استخدم ملك الشّياطين العصا، أليس كذلك؟

231
00:20:16,990 --> 00:20:19,490
أجل. عصا النّهم

232
00:20:19,490 --> 00:20:22,120
هل صنعته حقّاً يا لون بيروك؟

233
00:20:22,120 --> 00:20:26,910
أجل. فارن لا يمكن أن يُقهَر حقّاً

234
00:20:26,910 --> 00:20:31,040
وجهاً لوجه، لن تتمكّن منه

235
00:20:31,040 --> 00:20:34,300
لهذا قطعتُ كلّ الطريق إلى هنا

236
00:20:34,300 --> 00:20:36,960
كيف وجدتنا حتّى؟

237
00:20:37,500 --> 00:20:39,430
سألتُ هذا

238
00:20:39,430 --> 00:20:41,220
!لحظة! هل هذا...؟

239
00:20:42,840 --> 00:20:44,010
هذا صحيح

240
00:20:44,010 --> 00:20:49,520
أتى هذا إليّ مع رمح درع الشّيطان الخاص بهيونكل

241
00:20:50,020 --> 00:20:56,520
جاءتني هذه الأسلحة سعياً لقوّة أعظم
لأجل المعركة المقبلة

242
00:20:57,560 --> 00:21:00,190
فقبلتُ طلبها

243
00:21:10,290 --> 00:21:14,370
هذا سيف داي المولود من جديد

244
00:21:18,840 --> 00:21:20,540
هل يمكنني سحبه؟

245
00:21:20,540 --> 00:21:22,670
اسأله بنفسك

246
00:21:27,640 --> 00:21:30,560
...الإحساس به بيدي

247
00:21:30,890 --> 00:21:33,020
لقد افتقدتُ هذا

248
00:21:33,520 --> 00:21:36,810
!أرني نفسك يا سيفي

249
00:22:07,220 --> 00:22:12,270
بصراحة كنتُ أخرق

250
00:22:12,270 --> 00:22:18,600
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

251
00:22:19,060 --> 00:22:24,070
وحتّى أنّني استخدمتُ الوحدة كسلاح

252
00:22:24,070 --> 00:22:30,000
بحثتُ في الدّيماس عن جواب بسيط

253
00:22:30,000 --> 00:22:35,830
حتّى لو تخلّيتُ عن الحقّ واللّطف

254
00:22:35,830 --> 00:22:41,970
أريد أن أكون موجوداً بجانبك فحسب

255
00:22:41,970 --> 00:22:47,600
أن أنادي باسمك

256
00:22:47,600 --> 00:22:53,600
هو أصعب من أي تعويذة سحريّة

257
00:22:53,600 --> 00:22:59,400
رغم أنّك مقرّب جدّاً منّي

258
00:22:59,400 --> 00:23:02,030
أحبّك

259
00:23:02,030 --> 00:23:05,320
أدركتُ ذلك أخيراً

260
00:23:05,320 --> 00:23:10,450
أن أنادي باسمك

261
00:23:10,450 --> 00:23:16,880
هو السّبب الّذي وُلدت لأجله

262
00:23:16,880 --> 00:23:22,800
سأتخلّص من هذا اللّيل الطويل

263
00:23:22,800 --> 00:23:25,510
وآتي لرؤيتك

264
00:23:25,510 --> 00:23:30,220
إلى حيث أنت الآن

265
00:23:34,050 --> 00:23:36,850
،مع ابتكار داي هجمة جديدة

266
00:23:36,850 --> 00:23:41,690
يصل لون بيروك، جالباً سيف داي المُعافى
وأسلحة جديدة أخرى

267
00:23:41,690 --> 00:23:46,450
المعنويّات عالية، لكن مام وأيمي ليستا على طبيعتهما

268
00:23:46,450 --> 00:23:50,030
وما زال بوب يعاني لجعل شارة أفان خاصّته تتوهّج

269
00:23:50,030 --> 00:23:53,870
مع اقتراب المعركة، تزداد الأمور إرهاقاً

270
00:23:53,870 --> 00:23:56,170
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

271
00:23:57,960 --> 00:24:00,040
!وتستمرّ المغامرة