1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:52,440 --> 00:01:55,530
...إذاً آلة القتال من العالم السّفلي تلك

20
00:01:55,690 --> 00:01:59,160
!جرّت المُعلّم وكيلفارن إلى بُعد مختلف؟

21
00:01:59,570 --> 00:02:02,990
لا يستطيع أحد التدخّل في مبارزة
تستخدم القاضي

22
00:02:03,490 --> 00:02:08,040
،عندما يُهزَم شخص، يفقد صوابه

23
00:02:08,210 --> 00:02:14,550
ويدمّر القاضي نفسه ذاتيّاً ولا يعود
إلى هذا البُعد سوى الفائز

24
00:02:14,710 --> 00:02:15,960
!ماذا يجب أن نفعل؟

25
00:02:17,630 --> 00:02:22,390
!أسألك ماذا يجب أن نفعل لإنقاذ مُعلّمنا

26
00:02:26,180 --> 00:02:31,860
في الواقع... أعتقد إذا أردت أن تعرف، فليس
لديك خيار سوى سؤالي

27
00:02:32,020 --> 00:02:36,400
!إن لم تخبرنا، سوف نهزمك ونجبرك على إخبارنا

28
00:02:39,200 --> 00:02:41,910
!ها أنا ذا يا ميستوفارن

29
00:02:42,070 --> 00:02:43,490
!انتظر يا داي

30
00:02:44,830 --> 00:02:46,790
!ميستوفارن لا يعلم

31
00:02:46,950 --> 00:02:50,210
،أو بالأحرى، بحسب ما قاله للتو

32
00:02:50,370 --> 00:02:53,960
!لا توجد طريقة عمليّة لإنقاذ المعلّم من القاضي

33
00:02:54,590 --> 00:02:59,470
تمّ استخدامه لحسم النّزاعات
!في العالم السّفلي منذ القِدَم

34
00:02:59,630 --> 00:03:03,010
لا يمكن التدخّل من الخارج ولا بأيّ شكل

35
00:03:05,510 --> 00:03:09,730
بعبارة أخرى، إنّه يدّعي للتو بمعرفة طريقة

36
00:03:09,890 --> 00:03:15,230
!كي يُبقينا هنا ويُلحِق بك أكبر ضرر ممكن

37
00:03:16,020 --> 00:03:20,990
!بهذا الشّكل، حتّى لو خسر، سيحظى فارن بأفضليّة أكبر

38
00:03:21,700 --> 00:03:23,570
!لا تقع ضحيّة لخدعة العدوّ

39
00:03:24,280 --> 00:03:26,330
!آمن بقوّة المعلّم أفان

40
00:03:26,490 --> 00:03:31,210
!علينا الوصول إلى ملك الشّياطين في أسرع وقت

41
00:03:32,420 --> 00:03:33,670
...ليونا

42
00:03:34,630 --> 00:03:35,840
هذا قاسٍ

43
00:03:43,260 --> 00:03:44,590
هذا صحيح

44
00:03:44,760 --> 00:03:47,810
أعلم بأنّ ما تقولينه صحيح

45
00:03:48,390 --> 00:03:51,020
...لكن أن نغادر دون أدنى محاولة

46
00:03:54,400 --> 00:03:56,610
!كيف تتأمّلين منّا أن نفعل ذلك؟

47
00:03:58,570 --> 00:03:59,820
...مام

48
00:04:00,280 --> 00:04:01,360
هذا صحيح

49
00:04:01,990 --> 00:04:05,820
ميستوفارن هو عدوّ علينا هزيمته على أيّ حال

50
00:04:11,460 --> 00:04:15,000
!لا أتوقّع أقلّ من هذا من أتباع أفان

51
00:04:15,170 --> 00:04:16,880
!والآن، تعالوا

52
00:04:19,130 --> 00:04:20,460
!انتظر

53
00:04:21,840 --> 00:04:22,720
!داي

54
00:04:42,610 --> 00:04:43,950
...هذه

55
00:04:55,540 --> 00:04:57,750
!ريشة المُعلّم أفان

56
00:05:05,630 --> 00:05:06,510
!ليونا؟

57
00:05:06,680 --> 00:05:09,300
كيف حصلت الأميرة على ريش المُعلّم؟

58
00:05:14,270 --> 00:05:16,810
لا تستهن بي

59
00:05:18,310 --> 00:05:23,150
صِناعة التّعويذات والاغتيالات ليس كلّ ما أستطيع فعله

60
00:05:25,400 --> 00:05:26,990
...والآن

61
00:05:27,530 --> 00:05:28,450
!انتهى الأمر

62
00:05:39,000 --> 00:05:40,960
!أفان ستراش؟

63
00:05:41,130 --> 00:05:43,170
!هذه هي الأصليّة إذاً

64
00:05:43,340 --> 00:05:47,880
هجوم من أفان. تكبّد كيلفارن ضرراً بقيمة 78

65
00:05:48,050 --> 00:05:51,930
هذا الضّرر الكبير من خدش واحد؟

66
00:05:53,680 --> 00:05:55,560
...إذاً، آنذاك

67
00:05:56,480 --> 00:05:57,390
هذا صحيح

68
00:05:57,560 --> 00:06:02,440
لو أردتُ حقّاً، لاستطعتُ جرحك بشكل كبير

69
00:06:03,730 --> 00:06:07,900
لكن بدلاً من ذلك، فضّلتُ كسر قناعك فقط

70
00:06:08,070 --> 00:06:13,290
أوّلاً، لم أرد استهلاك كلّ طاقتي هناك

71
00:06:13,450 --> 00:06:19,670
ثانياً، أردتُ أن يُوجَّه غضبك نحوي فقط

72
00:06:21,290 --> 00:06:25,090
هذا هو الظرف الّذي أردتُه حرفيّاً

73
00:06:25,590 --> 00:06:31,600
...يمكنني البقاء هنا أقاتلك للأبد

74
00:06:31,930 --> 00:06:36,350
!ما دام داي والآخرون يهزمون فارن في الوقت الحالي

75
00:06:36,640 --> 00:06:37,600
،بالإضافة إلى ذلك

76
00:06:37,930 --> 00:06:44,190
أخبرتُ وريثي بأهدافي، والّتي سيسعى لتحقيقها بدوره

77
00:06:44,770 --> 00:06:48,030
وريثك؟

78
00:06:49,780 --> 00:06:55,580
الشخص الوحيد القادر على لمّ شمل
...الجميع وجعلهم فرقة عدالة

79
00:06:56,240 --> 00:06:57,790
هو أنت

80
00:06:58,710 --> 00:07:00,370
...أترك الأمر لكِ

81
00:07:03,170 --> 00:07:04,880
!يا أميرة ليونا

82
00:07:09,800 --> 00:07:11,220
!اسمعوا جميعاً

83
00:07:11,380 --> 00:07:16,510
أعطاني المُعلّم ريشه وهو على دراية
بأنّ هذا قد يحدث

84
00:07:17,180 --> 00:07:21,100
...لقيادة أتباع أفان نحو النّصر

85
00:07:21,730 --> 00:07:26,270
...باسم البطل العظيم أفان، والعدالة للعالم السّطحي

86
00:07:26,440 --> 00:07:30,360
!أنا، الأميرة ليونا، سأقودكم جميعاً الآن

87
00:07:31,570 --> 00:07:35,950
!جميعكم يجب أن تقاتلوا لأجل البطل

88
00:07:38,580 --> 00:07:42,460
جميعكم يجب أن تقاتلوا لأجل البطل

89
00:07:44,080 --> 00:07:44,830
ماذا؟

90
00:07:46,040 --> 00:07:48,250
ماذا تقصد بذلك؟

91
00:07:48,420 --> 00:07:49,800
اسمعي يا أميرة

92
00:07:50,510 --> 00:07:52,630
،اعتباراً من هذه اللّحظة

93
00:07:52,800 --> 00:07:59,890
يعتمد كلّ شيء على إيصال داي
إلى فارن بأفضل وسيلة ممكنة

94
00:08:00,430 --> 00:08:05,730
يجب أن تسخّر فرقتنا كلّ جهودها في
سبيل هذه القضيّة

95
00:08:06,060 --> 00:08:10,440
يمتلك ملك الشّياطين غالباً قوّة تفوق تصوّرنا

96
00:08:10,610 --> 00:08:15,450
الهجمة من سيف البطل هي سلاحنا الأعظم ضدّه

97
00:08:16,910 --> 00:08:20,000
،عندما واجهتُ ملك الشّياطين هادلَر

98
00:08:20,620 --> 00:08:26,290
فعلَ أصدقائي ما بوسعهم لإيصالي
إلى حجرة ملك الشّياطين

99
00:08:29,090 --> 00:08:31,260
!انسَ أمري واذهب فحسب يا أفان

100
00:08:31,420 --> 00:08:33,840
!سيّد أفان، بالتوفيق لك

101
00:08:34,010 --> 00:08:36,720
!صِل إلى ملك الشّياطين بسرعة فحسب

102
00:08:40,850 --> 00:08:44,270
يمتلك جميع أتباعي قلوباً طيّبة

103
00:08:44,440 --> 00:08:49,190
إنّها ميزة رائعة. لكن قد تقسو الحرب علينا

104
00:08:49,360 --> 00:08:56,160
أحياناً، يجب أن نمسح دموعنا
ونركّز على تحقيق النّصر

105
00:08:57,870 --> 00:09:02,290
في هذه الأوقات، يجب أن تستمرّي
في قيادة الجميع يا أميرة

106
00:09:02,450 --> 00:09:05,750
أعتقد بأنّكِ الوحيدة التي تمتلكين مثل هذه القوّة

107
00:09:07,750 --> 00:09:10,340
أنا... الوحيدة؟

108
00:09:10,500 --> 00:09:14,470
تؤمنين إيماناً راسخاً بالعدالة

109
00:09:14,630 --> 00:09:19,930
وكحاكمة، لديكِ مُقوّمات القيادة

110
00:09:20,720 --> 00:09:23,730
،حتّى لو استشطتِ غضباً في بعض الأوقات

111
00:09:23,890 --> 00:09:28,520
ستفعلين ما يجب فعله لتوجيه النّاس
نحو الطريق الصّحيح

112
00:09:28,690 --> 00:09:31,520
أعتقد بأنّكِ شُجاعة جدّاً

113
00:09:32,150 --> 00:09:35,320
لهذا أريدكِ أن تحملي هذا الرّيش

114
00:09:35,700 --> 00:09:39,240
،إذا هاجم عدوٌّ قويٌّ الآخرين

115
00:09:39,410 --> 00:09:43,330
سأواجه ذلك الخصم مثلما فعل هيونكل

116
00:09:44,950 --> 00:09:48,500
بعد ذلك، يجب أن تقودي الآخرين

117
00:09:48,670 --> 00:09:55,260
أريدكِ أن تحملي هذا الرّيش كدليل على إيماني بكِ

118
00:09:56,220 --> 00:09:57,550
اطمأننت

119
00:09:58,640 --> 00:09:59,720
...ظننتُ

120
00:09:59,890 --> 00:10:05,390
ظننتُك تخطّط للتضحية بنفسك لأجل داي ثانية

121
00:10:06,600 --> 00:10:07,890
...في الواقع

122
00:10:09,150 --> 00:10:10,560
!بالطبع لا

123
00:10:10,730 --> 00:10:14,860
أحضرتُكِ معي ببساطة وذلك
كي نتكلّم على انفراد

124
00:10:15,570 --> 00:10:19,160
لا أنوي الموت مرّتين

125
00:10:19,320 --> 00:10:22,240
بالإضافة إلى ذلك، أعطيتُكِ نصف ريشي فقط

126
00:10:22,410 --> 00:10:25,290
النصف فقط لأيّ أمر قد يقع

127
00:10:29,040 --> 00:10:31,920
أعتذر لأنّني أثرتُ قلقكِ

128
00:10:32,250 --> 00:10:35,210
وبالطبع، مخاطر الموت تبقى قائمة

129
00:10:35,840 --> 00:10:38,930
!لكن... لا أنوي الموت عبثاً

130
00:10:39,090 --> 00:10:43,470
،إذا كنتُ سأخاطر بحياتي للقتال
"فسيكون ذلك "لأجل البطل

131
00:10:45,970 --> 00:10:47,270
صحيح؟

132
00:10:50,940 --> 00:10:53,650
!هيّا! لنسرع بالتقدّم

133
00:10:53,820 --> 00:10:57,490
سأعلّمكِ كيفيّة ردع الفِخاخ في الطريق

134
00:10:57,650 --> 00:10:58,490
!حاضرة

135
00:11:01,240 --> 00:11:02,450
هذا صحيح

136
00:11:03,030 --> 00:11:07,250
!لم يعطني المُعلّم هذا الرّيش لاستخدامه كسلاح

137
00:11:07,660 --> 00:11:12,460
!تركَه لي كمنارة تضيء طريق التّلاميذ نحو العدالة

138
00:11:13,130 --> 00:11:15,300
!ما زال المُعلّم يكافح حتّى الآن

139
00:11:15,460 --> 00:11:18,130
!يجب أن نقاتل كما يفعل هو

140
00:11:20,010 --> 00:11:21,680
...المُعلّم

141
00:11:22,300 --> 00:11:25,310
والجميع... يقاتلون لأجلي؟

142
00:11:25,720 --> 00:11:29,180
...أبي، أمّي، والعمّ ماتوريف

143
00:11:29,480 --> 00:11:34,520
جميعهم تعاونوا معاً هكذا لقيادة البطل نحو النصر

144
00:11:34,900 --> 00:11:38,070
،إذا أردنا تسمية أنفسنا بفريق البطل

145
00:11:38,230 --> 00:11:41,240
يجب علينا فعل ما فعلوه

146
00:11:41,400 --> 00:11:45,580
وإلّا لماذا يقاتل المُعلّم الآن؟

147
00:11:47,370 --> 00:11:49,950
يمكنكم أن تصرخوا قدر ما تشاؤون

148
00:11:53,170 --> 00:11:54,710
!ها أنا قادم

149
00:12:06,260 --> 00:12:07,180
!بوب

150
00:12:07,350 --> 00:12:08,470
!الأميرة

151
00:12:08,640 --> 00:12:10,640
!سأثبّته

152
00:12:10,810 --> 00:12:11,940
!بوب

153
00:12:12,100 --> 00:12:15,900
قد يتفوّق عليّ خصمي هنا، لكن
!سأفعل ما يمكنني فعله

154
00:12:16,560 --> 00:12:19,900
!أنا عنيد بما يكفي لاكتشاف ثغرة

155
00:12:20,070 --> 00:12:22,950
،قد لا أكون بمثل براعة المُعلّم أو المُرشِد

156
00:12:23,110 --> 00:12:25,570
!لكن يمكنني أن أفعل ما فعله هيونكل على الأقلّ

157
00:12:26,030 --> 00:12:29,910
!لديّ أسبابي الخاصّة الّتي تدفعني لذلك

158
00:12:33,620 --> 00:12:36,580
!مهلاً! لا تسئ الفهم يا بوب

159
00:12:36,750 --> 00:12:41,130
المقارنة بهيونكل لن تستميلني للوقوع في حبّك

160
00:12:41,300 --> 00:12:42,550
!مام

161
00:12:42,720 --> 00:12:47,140
!لا تقلّد الآخرين وافرض شخصيّتك أمامي

162
00:12:49,100 --> 00:12:53,350
يستطيع ميستوفارن عَكس تعويذات
مُوجّهة بشكل مستقيم

163
00:12:53,520 --> 00:12:56,810
...لكن إذا دعمَتْني مام بقوّتها

164
00:12:57,730 --> 00:13:03,280
عجباً! دائماً ما تدفعينني لفعل ما يحلو لكِ

165
00:13:07,160 --> 00:13:11,290
!يمكنك الذّهاب! نحن الاثنان سنتولّى هذا الأمر

166
00:13:11,450 --> 00:13:15,080
!الأميرة وغومي، اذهبا مع داي

167
00:13:16,420 --> 00:13:17,330
!داي

168
00:13:17,500 --> 00:13:22,010
بوب ومام يقاتلان وذلك كي أتابع طريقي

169
00:13:22,170 --> 00:13:23,300
...في هذه الحالة

170
00:13:24,630 --> 00:13:28,550
!حسناً! هيّا بنا يا غوميتشان

171
00:13:28,720 --> 00:13:29,760
!إلى فارن

172
00:14:01,590 --> 00:14:03,920
!توقّف يا داي

173
00:14:10,090 --> 00:14:11,680
هل أنت متأكّد؟

174
00:14:12,310 --> 00:14:18,440
تُرّهات الصّداقة خاصّتكم تلك... قد تقود لِلقاء حتفكم

175
00:14:22,020 --> 00:14:23,980
هل أنت متأكّد؟

176
00:14:34,660 --> 00:14:36,330
!ماذا تنتظر؟

177
00:14:36,500 --> 00:14:40,170
!قاتلنا معاً كلّ هذا الطريق وما زلت لا تثق بنا؟

178
00:14:40,540 --> 00:14:41,790
!ليونا

179
00:14:42,500 --> 00:14:45,340
أنا آسفة. كنتُ قاسية جداً

180
00:14:47,380 --> 00:14:49,590
قودي داي لأجلنا، اتّفقنا؟

181
00:14:52,930 --> 00:14:53,640
!داي

182
00:14:55,220 --> 00:14:56,060
!حسناً

183
00:14:58,390 --> 00:15:01,060
...ستتوقّف عن الهرب

184
00:15:01,770 --> 00:15:05,150
عندما تسمع صرخات صديقيك

185
00:15:05,570 --> 00:15:08,360
!لن تبتعد أكثر

186
00:15:10,950 --> 00:15:12,070
...والآن

187
00:15:12,240 --> 00:15:18,080
لنُرِه قوّة العاشقين المُتضافرة، حسناً؟

188
00:15:18,410 --> 00:15:19,830
!قبلة

189
00:15:20,000 --> 00:15:23,210
!أنت تغترّ بنفسك! انظر أمامك

190
00:15:24,210 --> 00:15:28,550
يبدو أنّ بوب ومام قد أصلحا الأمور بينهما

191
00:15:29,130 --> 00:15:31,050
ينبغي أن يكونا بخير

192
00:15:34,390 --> 00:15:35,560
أجل

193
00:15:36,260 --> 00:15:40,140
ما كنتُ لأقلق لو كانا يواجهان عدوّاً عاديّاً

194
00:15:40,310 --> 00:15:44,730
!لكنّه ميستوفارن، العمود العظيم الأخير

195
00:15:45,270 --> 00:15:50,070
!اسمع! إيّاك والظنّ بأنّك ستتمكّن من اللّحاق بداي

196
00:15:50,530 --> 00:15:52,450
حسناً، كيف سنقاتل؟

197
00:15:52,610 --> 00:15:55,700
!شتّت انتباهه. وسأجهز عليه

198
00:15:57,370 --> 00:15:59,160
حقّاً؟

199
00:15:59,330 --> 00:16:03,250
أظنّكِ لا تثقين بقوّتي حقّاً

200
00:16:03,670 --> 00:16:05,330
الأمر ليس كذلك

201
00:16:05,500 --> 00:16:08,050
أشكّ في أنّه يستطيع عكس تعويذة ميدروا

202
00:16:08,800 --> 00:16:12,510
لكن تذكّر مرآة شاهال. من الأفضل توخّي الحذر

203
00:16:14,090 --> 00:16:15,220
...الأهمّ

204
00:16:15,390 --> 00:16:20,480
ينبغي لقبضة الانكسار خاصّتي أن
تتمكّن من إلحاق ضرر بميستوفارن

205
00:16:20,640 --> 00:16:22,270
قبضة الانكسار خاصّتكِ؟

206
00:16:23,440 --> 00:16:25,690
،داخل ثياب الظلّ الخاص بميستوفارن

207
00:16:25,860 --> 00:16:31,900
لا أعلم ما إن كان بشريّاً أو ظلاميّاً، لكن
رأيتُ وجهاً يشبه وجوهنا

208
00:16:32,990 --> 00:16:36,950
،معنى هذا بأنّه ليس كائناً حيّاً بطاقة شرّيرة

209
00:16:37,120 --> 00:16:39,990
!إنّما كائناً حيّاً بجسد

210
00:16:40,790 --> 00:16:42,210
!هكذا إذاً

211
00:16:42,370 --> 00:16:45,830
...إذاً سأشغله بتعويذاتي

212
00:16:46,000 --> 00:16:50,760
...وسأمزّق ثيابه وأضربه بقبضة الانكسار خاصّتي

213
00:16:50,920 --> 00:16:52,130
!عُلِم

214
00:16:52,590 --> 00:16:56,220
!إنّها بسيطة، لكن غالباً الهجمة الأكثر فعاليّة

215
00:16:56,390 --> 00:16:57,760
!لنعتمد ذلك

216
00:16:59,100 --> 00:17:01,220
حمقاوان جاهلان

217
00:17:01,390 --> 00:17:04,060
،بمقدوري اللّحاق بداي بسهولة

218
00:17:04,230 --> 00:17:08,190
لكن قلتُ بأنّ الحديقة البيضاء ستكون قبركم

219
00:17:11,280 --> 00:17:13,690
...سأدع داي يعود إلى هنا

220
00:17:14,030 --> 00:17:17,530
باستخدام موتكما كطعم

221
00:17:18,950 --> 00:17:20,330
!كلام فارغ

222
00:17:20,490 --> 00:17:23,500
!ستندم إذا استهنتَ بنا

223
00:17:23,660 --> 00:17:28,540
...قد تكون الأقوى في جيش الشّياطين، لكنّك لن

224
00:17:28,710 --> 00:17:32,380
"أربح بسهولة. سوف نصمد..."

225
00:17:32,550 --> 00:17:34,300
هذا ما ستقولينه؟

226
00:17:37,260 --> 00:17:39,640
أنتما من تتفوّهان بكلام فارغ

227
00:17:40,010 --> 00:17:43,060
ربّما كان شخص بقدرة لون بيروك لينجح

228
00:17:43,220 --> 00:17:47,310
لكن لن تتمكّنا حتّى من تنفيذ حيلة الإلهاء بنجاح

229
00:17:47,480 --> 00:17:49,400
إليكما توقّعاتي

230
00:17:49,560 --> 00:17:54,110
سأقتلكما من دون أن أخطو خطوة واحادة

231
00:17:54,280 --> 00:18:00,450
سيُوقف هذا تقدُّم داي ليجبره على العودة إلى هنا

232
00:18:01,120 --> 00:18:02,540
!...أيُّها

233
00:18:02,700 --> 00:18:05,870
...لا تفترض أنّ كلّ شيء سيسير

234
00:18:07,370 --> 00:18:09,920
!وفقاً لخطّتك

235
00:18:10,920 --> 00:18:13,420
!يد هالة الدمى الشيطانية

236
00:18:24,470 --> 00:18:27,270
!سئمتُ من خدعك الهزليّة

237
00:18:27,980 --> 00:18:31,270
!ليست مشكلة إن كنت تعرف آليّة عملها

238
00:18:31,440 --> 00:18:32,900
!خذ هذه

239
00:18:35,570 --> 00:18:36,740
!فرقعة

240
00:18:43,580 --> 00:18:45,660
يا لها من تعويذات تافهة

241
00:18:45,830 --> 00:18:49,370
لا تستحقّ حتّى امتصاصها وعكسها

242
00:18:50,330 --> 00:18:52,670
!أجل! أنا متأكّد من أنّها كذلك

243
00:18:52,840 --> 00:18:57,130
!أستخدم تعويذة أضعف لإبقائك مشغولاً

244
00:19:10,770 --> 00:19:14,900
!الآن فرصتكِ يا مام

245
00:19:19,530 --> 00:19:20,910
...قبضة

246
00:19:21,240 --> 00:19:22,780
!الانكسار

247
00:19:32,790 --> 00:19:34,130
!هل أفلح ذلك؟

248
00:19:41,010 --> 00:19:42,510
...لكن

249
00:19:48,060 --> 00:19:48,930
!مام

250
00:19:56,690 --> 00:19:58,730
!بوب! مام

251
00:20:03,530 --> 00:20:05,620
مُحال لقبضة الانكسار خاصّتي

252
00:20:05,780 --> 00:20:08,740
!ألّا تنجح على شيء ذي جسد مادّي

253
00:20:14,960 --> 00:20:17,500
!إنّه يعصرنا حتّى الموت

254
00:20:17,670 --> 00:20:19,800
!بوب

255
00:20:20,510 --> 00:20:25,470
!انسَ أمرنا! اذهب إلى فارن

256
00:20:25,640 --> 00:20:26,680
!اذهب

257
00:20:30,600 --> 00:20:36,770
يا للهول! كان يخفّف عنّا فقط كي
!نتمكّن من مناداته

258
00:20:36,940 --> 00:20:40,150
!وذلك كي يسمعنا داي

259
00:20:44,780 --> 00:20:49,240
!لكن حالما يعود داي، سيقتلنا

260
00:20:49,410 --> 00:20:52,250
!لا جدوى من المجيء لإنقاذنا

261
00:20:54,330 --> 00:20:57,170
تحقّق توقُّعي

262
00:20:58,380 --> 00:21:00,050
!اللّعنة

263
00:21:01,210 --> 00:21:06,640
!لا تأتِ! أتوسّل إليك ألّا تعود

264
00:21:45,470 --> 00:21:46,800
!هيونكل

265
00:21:47,180 --> 00:21:51,010
!تـ... تمكّن من النّجاة

266
00:21:52,850 --> 00:21:56,100
!...لا! هذا

267
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

268
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

269
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

270
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

271
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

272
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

273
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

274
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

275
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

276
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

277
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

278
00:23:33,740 --> 00:23:36,040
يجب على الجميع أن يقاتلوا لأجل البطل

279
00:23:36,200 --> 00:23:38,910
،قيادة ليونا تلمّ شمل الأبطال معاً

280
00:23:39,080 --> 00:23:41,920
ليقعوا في مأزق مواجهة ميستوفارن

281
00:23:42,080 --> 00:23:47,380
،يظهر لارهارت، مُرتدياً رمح درع الشّيطان
وينقذ بوب ومام

282
00:23:47,550 --> 00:23:51,010
يحكي لارهارت عن وعده لباران

283
00:23:51,180 --> 00:23:53,840
ويكتشف داي نوايا أبيه

284
00:23:54,010 --> 00:23:56,220
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

285
00:23:57,970 --> 00:24:00,230
!وتستمرّ المغامرة