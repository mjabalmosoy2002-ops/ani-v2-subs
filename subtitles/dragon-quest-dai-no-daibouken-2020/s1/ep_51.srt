1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:06,080 --> 00:02:09,120
!ما الأمر، فخامتك هادلَر؟

20
00:02:13,500 --> 00:02:18,180
كان تحوّلي إلى شيطان خارق سريعاً

21
00:02:18,550 --> 00:02:21,180
فرضَ جهداً عليّ

22
00:02:22,300 --> 00:02:26,730
إذا استمررتُ في القتال، لن أصمد طويلاً

23
00:02:27,600 --> 00:02:30,560
هل هزيمة داي وأصدقائه يستحقّ ذلك؟

24
00:02:30,730 --> 00:02:32,520
!أجل

25
00:02:32,690 --> 00:02:35,280
!سأدفع حياتي ثمناً لذلك مسروراً

26
00:02:35,440 --> 00:02:37,280
!أريد أن أعرف

27
00:02:37,440 --> 00:02:44,530
أريد أن أعرف كم سأصبح قوياً إذا
!تخلّيتُ عن كلّ شيء لأجل القوّة

28
00:02:45,290 --> 00:02:48,500
القوّة هي مجد أجوف

29
00:02:48,660 --> 00:02:52,130
مهما كان الشخص قوياً، هناك
دوماً من هو أقوى منه

30
00:02:52,290 --> 00:02:55,840
...فرسان التنّين، الملك فارن

31
00:02:56,000 --> 00:03:00,760
لا أعرف إلى أي مستوى أستطيع الوصول

32
00:03:05,720 --> 00:03:10,100
لكن أرغب في الموت ككائن أكثر
قوّة من أتباع أفان

33
00:03:11,270 --> 00:03:13,690
،تمكّنتُ من قتل أفان

34
00:03:13,860 --> 00:03:18,490
لكن لا ينفك تلاميذه يظهرون ويهدّونني

35
00:03:18,940 --> 00:03:23,700
قتلتُ أفان فحسب. لم أهزمه

36
00:03:23,870 --> 00:03:28,700
لا أتحمّل الموت وأنا لا أزال خاسراً أمامه

37
00:03:30,160 --> 00:03:31,830
...فخامتك هادلَر

38
00:03:32,210 --> 00:03:33,630
سامحوني

39
00:03:34,040 --> 00:03:38,590
وُلدتم من سحر مُحرّم. لا يمكنكم العيش إذا متّ أنا

40
00:03:38,760 --> 00:03:40,010
!هذا لا يهمّ

41
00:03:40,170 --> 00:03:42,220
!فنحن أحجارك

42
00:03:42,380 --> 00:03:45,680
!استخدمنا لتحقيق طموحاتك

43
00:03:46,430 --> 00:03:48,720
...إذا كان هذا يعني الموت لأجلك

44
00:03:51,140 --> 00:03:54,060
!فأنا جاهز أن أتحطّم إلى قطع

45
00:03:58,280 --> 00:04:00,030
...هيم... عيناك

46
00:04:04,410 --> 00:04:07,370
لماذا يخرج ماء من عينيّ؟

47
00:04:08,120 --> 00:04:09,750
!لستُ بشرياً

48
00:04:11,160 --> 00:04:14,250
!هيم... يبكي؟

49
00:04:18,380 --> 00:04:21,510
سامحني، فخامتك هادلَر

50
00:04:21,880 --> 00:04:23,470
!فينبرين؟

51
00:04:25,890 --> 00:04:29,180
لهذا يُدعى هذا المكان بميدان الموت

52
00:04:29,640 --> 00:04:31,430
!لنسرع ونجد تشيو

53
00:04:37,860 --> 00:04:38,980
!تشيو

54
00:04:40,070 --> 00:04:43,150
!هل أنت بخير؟! من الأفضل أن تكون حيّاً

55
00:04:43,320 --> 00:04:44,990
!تشيو! تماسك

56
00:04:48,780 --> 00:04:52,450
أنقذتموني جميعاً إذاً

57
00:04:52,620 --> 00:04:54,120
عمّاذا تتكلّم؟

58
00:04:56,540 --> 00:04:59,210
وجدتُ هذه لأجلك. كن ممتنّاً

59
00:05:00,130 --> 00:05:03,720
،حالما أمدّ الجميع بالمعلومات الجديدة التي اكتشفتُها

60
00:05:03,880 --> 00:05:06,550
سيمتنّون لي كثيراً

61
00:05:06,720 --> 00:05:08,850
!أحمق! هذا يكفي

62
00:05:11,810 --> 00:05:14,560
!غبيّ يتخطّى الحدود هكذا

63
00:05:15,100 --> 00:05:19,650
!سألقّنك درساً عندما نعود للمنزل

64
00:05:20,650 --> 00:05:24,320
يظنّ أنّنا نحن من طردنا المُعتدي عليه

65
00:05:24,490 --> 00:05:25,070
أجل

66
00:05:25,240 --> 00:05:28,570
بحسب جروحه، كان الفيل هو من هاجمه

67
00:05:30,330 --> 00:05:31,620
ما الأمر؟

68
00:05:35,750 --> 00:05:39,000
!بوب، خذ تشيو والآخرين واذهبوا

69
00:05:39,170 --> 00:05:40,920
ماذا؟ ما الخطب؟

70
00:05:41,630 --> 00:05:45,260
حتّى مع هؤلاء، ما زال بمقدوري أخذ الجميع

71
00:05:45,590 --> 00:05:47,010
انسَ أمرنا

72
00:05:47,180 --> 00:05:50,350
عد إلى القاعدة وداوِ جروحهم

73
00:05:50,510 --> 00:05:53,470
...كفاك حماقة! قد تكون قوياً، لكن

74
00:05:55,640 --> 00:05:57,600
!أرجوك يا بوب

75
00:05:59,730 --> 00:06:00,730
...حسناً

76
00:06:02,020 --> 00:06:04,400
!لا أعرف ما الأمر، لكن كن حذراً

77
00:06:10,570 --> 00:06:11,950
لماذا فعلت ذلك؟

78
00:06:12,950 --> 00:06:16,450
!اخرج! أعلم أنّك تختبئ هناك

79
00:06:18,750 --> 00:06:20,540
لم أركما منذ وقت

80
00:06:24,130 --> 00:06:25,090
!باران؟

81
00:06:27,970 --> 00:06:30,840
ظننتُ أنني أخفيتُ وجودي كلّياً

82
00:06:31,550 --> 00:06:33,890
تحسّنت يا هيونكل

83
00:06:35,390 --> 00:06:39,140
كنتَ حكيماً بإعادة ذلك السّاحر إلى المنزل

84
00:06:39,310 --> 00:06:43,320
فقد حياته سابقاً بسببي

85
00:06:43,690 --> 00:06:47,690
لو رآني، فقد لا يتمكّن من الوقوف حتّى

86
00:06:47,860 --> 00:06:52,320
!هل أتيت لحسم الأمور مع داي؟

87
00:06:52,870 --> 00:06:54,700
!ابتعد عن داي

88
00:06:54,870 --> 00:06:59,580
البشر على وشك حشد كلّ قواهم

89
00:06:59,750 --> 00:07:02,080
!لمهاجمة ملك الشّياطين فارن

90
00:07:02,250 --> 00:07:05,130
!يجب أن يكون داي على رأسهم

91
00:07:05,300 --> 00:07:08,050
!رأيي من رأيه يا باران

92
00:07:08,210 --> 00:07:10,550
!لهذا اخترتُ البقاء هنا

93
00:07:11,220 --> 00:07:16,430
!سأخاطر بحياتي لمنع وقوع تلك المعركة ثانية

94
00:07:17,310 --> 00:07:22,190
يمكنكما المخاطرة بحياتي، لكن لا تستطيعان هزيمتي

95
00:07:22,350 --> 00:07:23,190
!ماذا؟

96
00:07:23,360 --> 00:07:24,900
اهدآ

97
00:07:25,070 --> 00:07:29,650
لا يهمّني أمركما ولا حتّى أمر داي

98
00:07:31,450 --> 00:07:34,950
...هدفي هو ملك الشّياطين عينه

99
00:07:35,950 --> 00:07:37,740
!فارن فقط

100
00:07:38,080 --> 00:07:41,290
!ملك الشّياطين فارن؟! أتيت للنيل منه؟

101
00:07:41,460 --> 00:07:42,330
!لماذا؟

102
00:07:43,000 --> 00:07:45,920
لستُ مُلزماً بالشرح لكما

103
00:07:46,460 --> 00:07:50,260
لا يجوز أن يبقى حيّاً. هذا كل ما في الأمر

104
00:07:50,420 --> 00:07:51,720
!انتظر يا باران

105
00:07:52,130 --> 00:07:55,220
!إذاً تقاطعت أهدافنا

106
00:07:55,390 --> 00:07:59,140
!لنضع الماضي خلفنا ونتعاون معاً

107
00:08:01,640 --> 00:08:04,270
!أنت من أنقذ تشيو، أليس كذلك؟

108
00:08:04,440 --> 00:08:08,900
!بوجودك في صفّنا، فستكون قوّتنا لا نظير لها

109
00:08:09,480 --> 00:08:10,110
!أرجوج

110
00:08:11,070 --> 00:08:12,450
!لأجل داي

111
00:08:14,030 --> 00:08:15,660
!كروكوداين! ابتعد

112
00:08:21,450 --> 00:08:24,330
!أفضّل الموت على ذلك

113
00:08:30,510 --> 00:08:31,510
!كروكوداين

114
00:08:45,310 --> 00:08:47,770
!أنا فارس التنّين باران

115
00:08:50,900 --> 00:08:52,650
!لا تهيناني

116
00:08:53,900 --> 00:08:58,580
!البشر هم أيضاً عدوّ يجب هزيمته

117
00:08:58,740 --> 00:09:01,120
!أفضّل الموت على مساعدتهم

118
00:09:02,040 --> 00:09:04,250
أنقذتُ الجرذ فقط

119
00:09:04,410 --> 00:09:09,340
لأنّني تعثّرتُ به أثناء بحثي عن مدخل لمعقل فارن

120
00:09:09,710 --> 00:09:11,170
كانت مجرّد نزوة

121
00:09:12,340 --> 00:09:15,380
أعلم الآن أنّ المدخل تحت الماء

122
00:09:15,550 --> 00:09:19,550
يدّعون أنّه حتّى فارس تنّين لا يستطيع اختراقه

123
00:09:19,720 --> 00:09:22,100
سوف نرى ذلك

124
00:09:22,270 --> 00:09:24,350
!انتظر يا باران

125
00:09:24,520 --> 00:09:29,690
!إذا ذهبت بمفردك فسوف يركّز العدوّ هجومه عليك

126
00:09:29,860 --> 00:09:31,150
وبعد؟

127
00:09:31,320 --> 00:09:35,530
!سأواجه أتباع فارن ولو كان عددهم بالمئات

128
00:09:35,700 --> 00:09:39,910
من الآن فصاعداً هي معركة بين فارس
التنّين الحقيقيّ وملك الشّياطين

129
00:09:40,080 --> 00:09:42,660
ستندلع معركة تفوق استيعابكم

130
00:09:43,700 --> 00:09:45,870
عودا إذا أردتما العيش

131
00:09:48,420 --> 00:09:50,000
عودا إلى داي

132
00:09:50,630 --> 00:09:51,880
!...هاتان العينان

133
00:09:52,050 --> 00:09:54,920
!لم يعد باران الذي عرفتُه في السّابق

134
00:09:55,090 --> 00:09:55,970
!هل يُعقل أنه...؟

135
00:10:03,180 --> 00:10:08,270
قاعدة عمليّاتنا أصبحت مشفى ميدانياً

136
00:10:08,440 --> 00:10:10,650
ما زال بمقدورنا إعادة تنظيم صفوفنا

137
00:10:10,810 --> 00:10:12,610
تشيو والآخرون بخير

138
00:10:12,770 --> 00:10:15,780
تلقّوا العلاج وهم نائمون الآن

139
00:10:15,940 --> 00:10:16,860
!هذا مُطمئن

140
00:10:17,400 --> 00:10:21,070
...بقي أن يعود هيونكل وكروكوداين بسلام

141
00:10:21,240 --> 00:10:24,790
!بوب، كيف تركتهما لوحدهما؟

142
00:10:24,950 --> 00:10:30,790
في الواقع، أصبح جادّاً فجأة

143
00:10:30,960 --> 00:10:32,750
فلم أستطع أن أعارضه

144
00:10:32,920 --> 00:10:35,800
لماذا يتصرّف هيونكل هكذا؟

145
00:10:38,380 --> 00:10:39,680
ما الأمر؟

146
00:10:40,050 --> 00:10:41,590
لستُ متأكّداً

147
00:10:45,680 --> 00:10:46,680
!انتظر

148
00:10:47,100 --> 00:10:49,390
!لن أسمح لك بالمتابعة أكثر

149
00:10:50,270 --> 00:10:51,940
هذا يكفي

150
00:10:52,110 --> 00:10:55,980
لم آتِ إلى هنا لضربكما

151
00:10:56,150 --> 00:11:01,280
!عرفت... لا بل أدركتُ هدفك أخيراً

152
00:11:02,240 --> 00:11:05,660
!تنوي أن تضحّي بحياتك لأجل داي

153
00:11:06,080 --> 00:11:10,580
ولا حتّى فارس تنّين يستطيع أن يخرج
من معركة مع ملك الشّياطين فارن سليماً

154
00:11:10,750 --> 00:11:13,960
من المؤكّد أنّك تعلم ذلك

155
00:11:14,710 --> 00:11:17,420
!لكن لن أسمح بالأمر

156
00:11:17,590 --> 00:11:23,340
لن أدعك تخوض معركة يائسة كهذه
!ولو كان ذلك لأجل داي

157
00:11:23,510 --> 00:11:28,730
إذا كان لأجل داي، ألن يكون السّماح
لي بالذّهاب أكثر نفعاً؟

158
00:11:28,890 --> 00:11:30,270
فلماذا تمنعني؟

159
00:11:30,440 --> 00:11:33,770
!إن ذهبت بمفردك، سوف تموت

160
00:11:33,940 --> 00:11:36,480
!لا أستطيع السّماح بحدوث ذلك

161
00:11:36,820 --> 00:11:38,030
...لا

162
00:11:38,440 --> 00:11:41,910
أأتمنك على مولايّ باران ومولايّ دينو

163
00:11:42,660 --> 00:11:46,030
...رمح درع الشّيطان الّذي أحمله هذا

164
00:11:49,540 --> 00:11:51,920
!لا يسمح بحدوث ذلك

165
00:11:55,250 --> 00:11:56,630
لارهارت؟

166
00:11:56,790 --> 00:11:59,550
أتحاول أن تقنعني بالعدول عن ذلك؟

167
00:12:01,340 --> 00:12:06,260
أوتظنّ أنّني سأًصغي إليك وأطيعك؟

168
00:12:06,430 --> 00:12:07,220
!أبداً

169
00:12:08,600 --> 00:12:15,060
مع الأسف، خياري الوحيد هو هزيمتك
قبل أن يكشفنا هادلَر

170
00:12:15,230 --> 00:12:16,900
ما هذه الوضعيّة؟

171
00:12:17,070 --> 00:12:20,320
أيضع سلاحه جانباً في وجه معركة؟

172
00:12:20,490 --> 00:12:21,900
ما الّذي ينوي فعله؟

173
00:12:27,950 --> 00:12:30,870
!هالته... اختفت

174
00:12:42,510 --> 00:12:46,140
!اختفت هالة هيونكل تماماً

175
00:12:46,720 --> 00:12:51,060
إنّه كبركة ساكنة بلا أمواج

176
00:12:52,310 --> 00:12:55,850
!أترمي سلاحك أثناء مواجهة باران؟! هل جُننت؟

177
00:12:56,560 --> 00:12:58,770
لا تقلق يا كروكوداين

178
00:12:58,940 --> 00:13:04,030
فضلاً عن ذلك، يبدو أنّ باران يدرك
مدى خطورة هذه المهارة

179
00:13:04,200 --> 00:13:05,280
!ماذا؟

180
00:13:05,860 --> 00:13:08,700
!لا أشعر بأي هالة من هيونكل

181
00:13:09,660 --> 00:13:11,790
!بدأ باران بقمع هالته

182
00:13:11,950 --> 00:13:13,370
!ما الّذي يجري؟

183
00:13:13,870 --> 00:13:17,170
!الآن هالتي هي الأقوى هنا

184
00:13:17,630 --> 00:13:20,040
فهمت. هذه حركة تضحية بالنفس

185
00:13:20,210 --> 00:13:21,340
!تضحية بالنفس؟

186
00:13:22,090 --> 00:13:26,930
إنّ إطلاق عنان هجمة قويّة يخلق ثغرة لأي شخص

187
00:13:27,090 --> 00:13:30,850
تنوي أن تسخّر تلك الهجمة لخلق تلك الثّغرة

188
00:13:31,010 --> 00:13:33,020
التي سوف تستغلّها لهجوم مُضادّ

189
00:13:33,180 --> 00:13:39,400
عندما قرأتُ كتاب مُعلّمي أفان، كانت هناك
مهارة واحدة خلتُها مستحيلة بالنسبة لي

190
00:13:39,940 --> 00:13:44,030
قبل خمسة عشر عاماً، عندما قاتل
،أفان ملك الشّياطين هادلَر

191
00:13:44,190 --> 00:13:45,990
اكتسب هذه التقنيّة

192
00:13:46,610 --> 00:13:49,620
...إنّها التقنيّة العظمى بأسلوب أفان

193
00:13:50,070 --> 00:13:51,870
!وضعيّة الأعزل

194
00:13:52,040 --> 00:13:53,450
وضعيّة الأعزل؟

195
00:13:53,620 --> 00:13:58,710
،أمام هجمة قويّة من عدوّ، لتجنّب ضربة قاتلة

196
00:13:58,880 --> 00:14:03,880
على المرء إخفاء هالته كلّياً وتجنّب قوّة الهجمة

197
00:14:04,050 --> 00:14:09,840
لكن لا يستطيع بلوغ مثل هذه الحالة
بسلاح ونيّة للقتل

198
00:14:10,010 --> 00:14:13,930
لذا اختار أفان أن يضع سيفه جانباً

199
00:14:20,520 --> 00:14:22,320
!تعال يا هادلَر

200
00:14:22,480 --> 00:14:25,860
!أحمق! هل استسلمت؟

201
00:14:27,200 --> 00:14:29,160
!هذه هي النّهاية

202
00:14:32,990 --> 00:14:34,450
...أفان

203
00:14:34,620 --> 00:14:36,410
!ستراش

204
00:14:40,210 --> 00:14:43,750
استخدم أفان وضعيّة الأعزل وأفان ستراش

205
00:14:43,920 --> 00:14:49,470
بدمج التقنيّتين العُظمتين السّالبة
والموجبة معاً، هزم هادلَر

206
00:14:49,630 --> 00:14:53,510
بينما أنا من الناحية الأخرى، كنتُ
دائماً ما أحمل سلاحي للانتقام

207
00:14:54,060 --> 00:14:57,980
أن أطرح سلاحي جانباً وأفرض
...على نفسي حالة الأعزل هذه

208
00:14:58,430 --> 00:15:01,020
بدت لي فكرة سخيفة دوماً

209
00:15:01,480 --> 00:15:06,190
رغم ذلك يا باران، ربّما تكون هذه المهارة
الوحيدة التي ستشكّل تأثيراً

210
00:15:06,860 --> 00:15:11,860
باستخدام وضعيّة الأعزل، سأخلق ثغرة
وأشنّ هجوماً مُضادّاً

211
00:15:12,950 --> 00:15:14,030
!فهمت

212
00:15:14,200 --> 00:15:19,620
كلّما كانت الهجمة أقوى، كانت الثّغرة
التي تخلقها وضعيّة الأعزل أكبر

213
00:15:19,790 --> 00:15:25,460
،بالنسبة لشخص هائل القوّة كباران
!إنّها مهارة مرعبة حقّاً

214
00:15:25,960 --> 00:15:31,430
لهذا حاول قمع هالته للقتال

215
00:15:31,930 --> 00:15:36,180
أنت تُمسي خصماً مرعباً يا هيونكل

216
00:15:36,350 --> 00:15:41,770
حاولتُ قمع هالتي، لكن لا أستطيع إخفاءها كلّياً

217
00:15:42,730 --> 00:15:46,980
لا يمكن بلوغ هذه الحالة إلّا بأقوى عزيمة

218
00:15:48,110 --> 00:15:50,740
هيونكل؟ من يقاتل؟

219
00:15:52,910 --> 00:15:54,070
!...ذلك الرّجل

220
00:15:57,330 --> 00:16:00,250
!ماذا؟! بدأ باران بتعزيز هالته

221
00:16:02,870 --> 00:16:05,630
صحيح. هذا خيارك الوحيد

222
00:16:05,790 --> 00:16:09,260
سوف تهاجم ثمّ تتراجع

223
00:16:09,710 --> 00:16:14,260
حالما تتحمّل هجمتي المُضادّة، سوف
تستخدم هجمتك الثّانية

224
00:16:14,430 --> 00:16:17,760
هذا إذا استطعت تحمّل هجمتي المُضادّة

225
00:16:17,930 --> 00:16:20,350
!هل باران جادّ في تعريض نفسه للخطر أيضاً؟

226
00:16:20,520 --> 00:16:24,060
هيونكل، لقد أظهرت لي عزيمتك

227
00:16:25,310 --> 00:16:28,900
كما تشاء، سأواجه تلك المهارة

228
00:16:34,780 --> 00:16:37,240
!ها أنا قادم يا هيونكل

229
00:16:37,780 --> 00:16:43,790
لارهارت، لم يمضِ يوم لم أفكّر فيك به

230
00:16:43,960 --> 00:16:47,290
ستكون هذه الهجمة أفضل ما لديّ

231
00:16:47,460 --> 00:16:49,920
،إذا فشلتُ في إيقاف باران

232
00:16:50,090 --> 00:16:53,420
فيمكنك أن تسخر من طيشي في الحياة الأخرى

233
00:16:53,590 --> 00:16:56,970
!فارس التنّين باران؟! أهذا هو؟

234
00:16:57,140 --> 00:17:01,350
الفارّ من جيش الشّياطين، ووالد داي

235
00:17:01,520 --> 00:17:04,940
لا أحد يعلم متى سينقلب على فخامته هادلَر

236
00:17:05,100 --> 00:17:09,230
هذا مثاليّ. يمكننا القضاء عليهما معاً هنا

237
00:17:09,400 --> 00:17:11,150
!لا تفعلي ذلك يا آلبيناس

238
00:17:11,320 --> 00:17:16,160
قد يكونان عدوّينا، لكن لا يجوز أن تقاطعي نزالاً

239
00:17:16,320 --> 00:17:19,200
قد يستشيط فخامته هادلَر غضباً

240
00:17:19,370 --> 00:17:21,540
سأتحمّل كامل المسؤوليّة

241
00:17:21,700 --> 00:17:25,000
كلّ هذا لأجل فخامته هادلَر

242
00:17:25,160 --> 00:17:29,040
!يجب استئصال كلّ المخاطر

243
00:17:47,810 --> 00:17:48,770
!أنا قادم

244
00:18:10,290 --> 00:18:11,790
!آلبيناس

245
00:18:13,420 --> 00:18:14,550
!ماذا حدث؟

246
00:18:15,260 --> 00:18:16,170
!هل نلتِ منهما؟

247
00:18:17,010 --> 00:18:18,430
!...هذا الجرح

248
00:18:19,720 --> 00:18:21,890
لهذا أُعجبتَ به

249
00:18:22,890 --> 00:18:24,020
...هيونكل

250
00:18:24,180 --> 00:18:26,560
يا له من محارب مرعب

251
00:18:26,730 --> 00:18:28,060
!آلبيناس

252
00:18:28,730 --> 00:18:30,730
لم يعد خطراً الآن

253
00:18:30,900 --> 00:18:33,400
الأمور بحسن خاتمتها

254
00:18:34,860 --> 00:18:37,030
...كان أنت يا باران إذاً

255
00:18:37,190 --> 00:18:39,570
من أنقذني من ذلك الانفجار

256
00:18:41,410 --> 00:18:43,330
!انتظر! هيونكل

257
00:18:43,870 --> 00:18:45,540
!أين هيونكل؟

258
00:19:00,090 --> 00:19:02,930
!هيونكل

259
00:19:05,060 --> 00:19:06,390
فات الأوان

260
00:19:06,560 --> 00:19:09,440
سيعيش، لكن لن يقاتل أبداً

261
00:19:09,600 --> 00:19:10,900
...كيف

262
00:19:11,060 --> 00:19:14,730
!ما الّذي فعل هذا به؟

263
00:19:15,610 --> 00:19:20,200
...في تلك اللّحظة، قاطع جيش الشّياطين معركتنا

264
00:19:20,360 --> 00:19:21,780
وهاجم

265
00:19:22,870 --> 00:19:28,500
كان كلّ تركيزي على مهاجمة هيونكل
فلم أستطع فعل شيء آخر

266
00:19:29,620 --> 00:19:33,540
كنتُ أنا وهيونكل لنؤخذ على حين غرة ونموت

267
00:19:34,000 --> 00:19:35,380
...حينها قام هيونكل بـ

268
00:19:35,540 --> 00:19:37,510
!الإبرة الألف

269
00:19:39,970 --> 00:19:41,130
!سكرايد الدمويّ

270
00:19:46,930 --> 00:19:51,730
استخدم هيونكل وضعيّة الأعزل خاصّته
...على جيش الشّياطين بدلاً من ذلك

271
00:19:51,890 --> 00:19:53,770
ليدحرهم

272
00:19:56,520 --> 00:20:00,530
وهو يعرف خير معرفة بأنّه سيتلقّى
هجمتي بكامل قوّتها

273
00:20:01,320 --> 00:20:03,740
لم تكن كلماته مجرّد ترّهات

274
00:20:04,120 --> 00:20:08,040
كان مستعدّاً للمخاطرة بحياته لإنقاذ حياتي

275
00:20:10,160 --> 00:20:11,370
...هيونكل

276
00:20:12,830 --> 00:20:17,250
كروكوداين، ماذا يجب أن أفعل؟

277
00:20:17,550 --> 00:20:20,710
كيف عساني أن أردّ جميل هذا الرّجل؟

278
00:20:20,880 --> 00:20:22,630
!لا تسألني

279
00:20:23,050 --> 00:20:25,430
،هذا يُخجلني يا باران

280
00:20:25,590 --> 00:20:29,770
!لكن في أعماقي، أردتُك أن تقاتل فارن

281
00:20:29,930 --> 00:20:33,060
!ظننتُ أنّ ذلك سينفع البشر

282
00:20:33,690 --> 00:20:39,280
!عرفتُ أنّه لم يكن هناك جدوى من محاولة إيقافك

283
00:20:39,730 --> 00:20:40,940
...ومع ذلك

284
00:20:41,110 --> 00:20:43,110
...ومع ذلك، هيونكل قد

285
00:20:43,280 --> 00:20:46,570
!لا أستحقّ أن أقول شيئاً

286
00:20:46,950 --> 00:20:51,620
!قد يكون لئيماً، لكنّه رجل أفتخر أن أدعوه صديقاً

287
00:20:52,620 --> 00:20:55,500
!فقط احترم ما كان يحاول فعله

288
00:21:00,050 --> 00:21:01,380
هكذا إذاً

289
00:21:03,260 --> 00:21:05,180
القلعة العظيمة، قصر فارن

290
00:21:05,340 --> 00:21:08,890
تقع بوّابة قلعة الشّيطان تحت الماء

291
00:21:09,050 --> 00:21:11,970
أبلى تشيو حسناً في إيجادها

292
00:21:12,140 --> 00:21:15,270
...أظنّني عليّ الذهاب إلى هناك

293
00:21:15,980 --> 00:21:19,900
بينما يقاتل الجميع حرس هادلَر الملكيّ على السّطح

294
00:21:20,070 --> 00:21:21,900
!انتظر لحظة يا داي

295
00:21:22,650 --> 00:21:25,820
حتّى فارس التنّين لا يستطيع تدمير البوّابة

296
00:21:25,990 --> 00:21:28,660
من الخطير جدّاً أن تذهب بمفردك

297
00:21:28,820 --> 00:21:31,740
تحتاج شخصاً ليرافقك

298
00:21:32,160 --> 00:21:35,250
!سأذهب أنا. دعي الأمر لي

299
00:21:35,920 --> 00:21:38,750
!وجودك مهمّ للتصدّي للحرس الملكيّ

300
00:21:38,920 --> 00:21:40,170
!سأذهب بدلاً عنك

301
00:21:44,630 --> 00:21:46,630
!سأذهب أنا

302
00:21:51,760 --> 00:21:52,890
!باران؟

303
00:22:07,240 --> 00:22:12,120
بصراحة كنتُ أخرق

304
00:22:12,280 --> 00:22:18,460
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

305
00:22:18,960 --> 00:22:23,920
وحتّى أنّني استخدمتُ الوحدة كسلاح

306
00:22:24,090 --> 00:22:29,840
بحثتُ في الدّيماس عن جواب بسيط

307
00:22:30,010 --> 00:22:35,680
حتّى لو تخلّيتُ عن الحقّ واللّطف

308
00:22:35,850 --> 00:22:41,810
أريد أن أكون موجوداً بجانبك فحسب

309
00:22:41,980 --> 00:22:47,440
أن أنادي باسمك

310
00:22:47,610 --> 00:22:53,450
هو أصعب من أي تعويذة سحريّة

311
00:22:53,620 --> 00:22:59,250
رغم أنّك مقرّب جدّاً منّي

312
00:22:59,420 --> 00:23:01,880
أحبّك

313
00:23:02,040 --> 00:23:05,170
أدركتُ ذلك أخيراً

314
00:23:05,340 --> 00:23:10,300
أن أنادي باسمك

315
00:23:10,470 --> 00:23:16,720
هو السّبب الّذي وُلدت لأجله

316
00:23:16,890 --> 00:23:22,650
سأتخلّص من هذا اللّيل الطويل

317
00:23:22,810 --> 00:23:25,360
وآتي لرؤيتك

318
00:23:25,520 --> 00:23:30,110
إلى حيث أنت الآن

319
00:23:33,740 --> 00:23:36,580
يفاجئ ظهور باران الجميع

320
00:23:36,740 --> 00:23:41,040
في وسط تردّده، يشدّ داي الرّحال
في مهمّة تعاونيّة مع باران

321
00:23:41,210 --> 00:23:45,250
داي وباران يتفرّقان عن الآخرين متوجّهين
صوب بوّابة قلعة الشّيطان

322
00:23:45,420 --> 00:23:48,050
ما الّذي ينتظرهما يا ترى؟

323
00:23:48,210 --> 00:23:52,470
يتوجّهان إلى معقل جيش الشّيطان
ويدور في رأسيهما أمور كثيرة

324
00:23:52,640 --> 00:23:54,800
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

325
00:23:56,810 --> 00:23:59,100
!وتستمرّ المغامرة