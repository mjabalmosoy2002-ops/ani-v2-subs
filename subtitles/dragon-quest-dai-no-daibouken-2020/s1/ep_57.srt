1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:53,480 --> 00:01:55,780
لذا سأمنحكم فُرصة

20
00:01:56,240 --> 00:01:59,240
هذان الاثنان لن يتدخّلا

21
00:01:59,780 --> 00:02:03,040
سأقاتلكم بمُفردي

22
00:02:03,200 --> 00:02:05,000
هذه هي مُكافأتكم

23
00:02:05,870 --> 00:02:07,160
ما رأيكم؟

24
00:02:07,330 --> 00:02:09,460
من المؤكّد أنّكم لن ترفضوا

25
00:02:09,880 --> 00:02:11,040
!بالطبع لا

26
00:02:11,750 --> 00:02:15,130
كنّا سنقاتل حتّى لو قاتل معك ميستوفارن
!وحاصد الأرواح

27
00:02:15,300 --> 00:02:18,720
!لهذا قطعنا كلّ المسافة إلى هنا

28
00:02:18,880 --> 00:02:20,140
عظيم إذاً

29
00:02:21,430 --> 00:02:23,390
فلنبدأ

30
00:02:28,440 --> 00:02:30,440
كدتُ أنسى

31
00:02:31,690 --> 00:02:32,940
ذاك الرّجل

32
00:02:33,730 --> 00:02:39,450
كانت قدرته على القتال مُدهشة
وارتقى للأساطير فعلاً

33
00:02:39,610 --> 00:02:44,490
لكن مع الأسف، يبدو أنّ قلبه كان إنسانيّاً جدّاً

34
00:02:44,950 --> 00:02:50,330
اسمحوا لي أن أمنحه نهاية ملائمة لبشريّ على الأقلّ

35
00:03:03,680 --> 00:03:05,470
!اهربوا جميعاً

36
00:03:05,640 --> 00:03:07,060
!إنّها تعويذة سعير

37
00:03:09,390 --> 00:03:10,270
!أبي

38
00:03:15,770 --> 00:03:17,440
ألم يكن ذلك مُرضياً؟

39
00:03:17,610 --> 00:03:20,650
أم أنّك تمنّيت أن تودّعه بنفسك؟

40
00:03:23,490 --> 00:03:24,620
!لا تفعل يا داي

41
00:03:36,460 --> 00:03:41,720
يا للعجب! كان بطلكم الثّمين أوّل السّاقطين

42
00:03:42,220 --> 00:03:47,890
لم يبقَ هُناك من لديه القوّة الكافية لأذيّتي

43
00:03:49,640 --> 00:03:52,060
!أسقطَ داي بضربة واحدة؟

44
00:03:52,440 --> 00:03:55,150
!ماذا كانت تلك القوّة؟

45
00:03:55,310 --> 00:04:00,240
يا للخيبة. وبعد أن منحتُه فُرصة

46
00:04:00,400 --> 00:04:04,450
هل ستتبع أباك أيّها البطل؟

47
00:04:05,780 --> 00:04:07,620
!تحرّكوا جميعاً

48
00:04:10,700 --> 00:04:12,120
!لن أدعك

49
00:04:12,290 --> 00:04:14,210
!سعير

50
00:04:21,010 --> 00:04:25,300
!والآن اشفي داي بينما أتصدّى له بتعويذتي

51
00:04:25,470 --> 00:04:26,260
!داي

52
00:04:35,650 --> 00:04:37,190
!بوب

53
00:04:40,730 --> 00:04:41,900
!بوب

54
00:04:45,410 --> 00:04:51,370
مـ-مستحيل! أحرقَ هذه الملابس الّتي
!حِيكَتْ بواسطة السّحر

55
00:04:52,250 --> 00:04:54,710
!بجذوة من النّار

56
00:04:54,870 --> 00:04:58,710
هل تعويذة سعير الخاصّة بملك الشّياطين
!أقوى بكثير من تعويذتي؟

57
00:04:59,590 --> 00:05:01,590
تعويذة سعير؟

58
00:05:01,960 --> 00:05:04,840
لم تكن تلك تعويذة سعير

59
00:05:05,880 --> 00:05:07,300
كانت شرارة

60
00:05:08,510 --> 00:05:09,510
!شرارة؟

61
00:05:09,810 --> 00:05:11,970
،حتّى بنفس التّعويذة

62
00:05:12,140 --> 00:05:18,100
،اعتماداً على القوّة السحريّة للمُستخدِم
يمكن أن يكون التأثير هائلاً

63
00:05:18,440 --> 00:05:22,400
بصيغة أخرى، مُقارنة تعويذة شرارة
،خاصّتي بتعويذة سعير خاصّتك

64
00:05:22,570 --> 00:05:26,530
تعويذتي أقوى بكثير

65
00:05:26,700 --> 00:05:27,820
!ماذا؟

66
00:05:28,280 --> 00:05:30,580
يا له من فارق في القوّة

67
00:05:30,740 --> 00:05:35,580
تمكّنتم من كسر هجوم جيش الشّياطين
مراراً وتكراراً

68
00:05:35,750 --> 00:05:40,590
،لذا ظننتُ أنّكم أقوى بقليل من ذلك
لكن كنتُ مخطئاً

69
00:05:40,960 --> 00:05:43,550
،حتّى بتلك الضّربة الّتي وجّهتُها لداي

70
00:05:43,710 --> 00:05:49,260
أطلقتُ قليلاً من هالتي لمُطابقة هجمته فحسب

71
00:05:49,590 --> 00:05:51,350
هكذا تماماً

72
00:06:03,280 --> 00:06:05,530
!هالة شيطانيّة مضغوطة بشكل مُكثّف؟

73
00:06:05,690 --> 00:06:07,530
!أصابَ داي بهذه؟

74
00:06:07,700 --> 00:06:12,740
لا يبدو هذا مُبشِّراً! يجب أن نُقاتل
!جسداً واحداً إذا أردنا الفوز

75
00:06:13,160 --> 00:06:15,540
!كيف حال داي؟! هل داي بخير يا مام؟

76
00:06:15,870 --> 00:06:20,080
...قلبه ينبض. لكن تلقّى ضرراً جسيماً

77
00:06:20,630 --> 00:06:24,130
!أصيبَ في مكان الجرح السّابق

78
00:06:26,130 --> 00:06:27,590
!عالجيه بسرعة فحسب

79
00:06:28,680 --> 00:06:29,880
!أعمل على ذلك

80
00:06:30,510 --> 00:06:31,760
يكفي

81
00:06:33,010 --> 00:06:38,310
...بقدر ما أستمتع بمشاهدتكم أيُّها الضّعفاء تُعانون

82
00:06:38,480 --> 00:06:40,690
لم يعد يعنيني ذلك

83
00:06:41,310 --> 00:06:47,400
يبدو أنّني أخطأتُ في منحكم طعمَ الأمل

84
00:06:47,690 --> 00:06:52,820
حتّى لو كان داي في صفّكم، فلن يغيّر ذلك شيئاً

85
00:06:53,530 --> 00:06:59,830
كتعويض، اسمحوا لي أن أقتلكم بلا ألم

86
00:07:15,350 --> 00:07:17,850
هذه تعويذة سعير خاصّتي

87
00:07:18,180 --> 00:07:22,350
...من قوّتها الّتي لا يمكن تخيّلها وشكلها البهيّ

88
00:07:22,520 --> 00:07:25,860
لديها اسمها القديم الخاصّ في العالم السّفلي

89
00:07:26,480 --> 00:07:28,740
عنقاء القيصر

90
00:07:35,080 --> 00:07:36,120
!هيونكل

91
00:07:37,990 --> 00:07:41,000
!ينبغي أن يتمكّن درعي من تحمّلها قليلاً

92
00:07:41,160 --> 00:07:42,290
!داوي داي بسرعة

93
00:07:45,670 --> 00:07:46,290
!تبّاً

94
00:07:46,460 --> 00:07:47,460
!هجمة ثانية؟

95
00:07:47,630 --> 00:07:49,510
!مستحيل! إنّه سريع جدّاً

96
00:08:07,400 --> 00:08:08,780
!لا أملك وقتاً للشفاء

97
00:08:10,490 --> 00:08:13,360
!جميعكم! انتقلوا للهجوم

98
00:08:25,580 --> 00:08:28,210
!يا ملك الشّياطين، حضّر نفسك

99
00:08:38,810 --> 00:08:41,020
!سكرايد الدّموي

100
00:08:44,140 --> 00:08:45,600
يا لها من عيون برّاقة

101
00:08:45,770 --> 00:08:47,270
هذا مُقزّز

102
00:08:47,650 --> 00:08:51,070
كنتَ أكثر روعة بكثير في السّابق

103
00:08:59,120 --> 00:09:00,990
!اللّعنة عليك

104
00:09:08,630 --> 00:09:09,630
!كروكوداين

105
00:09:11,880 --> 00:09:12,920
!احذري

106
00:09:17,970 --> 00:09:18,930
!هيونكل

107
00:09:20,430 --> 00:09:22,350
!توقّف يا فارن

108
00:09:29,270 --> 00:09:30,650
!انجحي أرجوكِ

109
00:09:30,820 --> 00:09:34,820
إذا لم أستطع هزيمته بهذه، ستنفد
!تعويذاتي التي قد تفلح عليه

110
00:09:35,490 --> 00:09:37,160
!انجحي أرجوكِ

111
00:09:37,320 --> 00:09:39,320
!ميدروا

112
00:09:42,450 --> 00:09:43,450
!ماذا؟

113
00:09:43,620 --> 00:09:44,830
هذه ارتداد

114
00:09:51,130 --> 00:09:52,670
!عليّ إبطالها

115
00:09:58,220 --> 00:09:59,470
!بوب؟

116
00:10:08,900 --> 00:10:10,860
!بوب، هل أنت بخير؟

117
00:10:11,020 --> 00:10:15,190
تبّاً! ردّ تعويذتي بتعويذة ارتداد

118
00:10:15,360 --> 00:10:17,570
!لا أستطيع استخدام ميدروا بعد الآن

119
00:10:17,740 --> 00:10:21,200
!متى أطلقَ تعويذة ارتداد؟

120
00:10:21,570 --> 00:10:23,370
سحره بمستوى مختلف كلّياً

121
00:10:24,790 --> 00:10:27,210
لا يقوم بالشّحن قبل استخدام سحره

122
00:10:27,370 --> 00:10:31,540
يستطيع إطلاق تعويذات دون استغراق وقت في شحنها

123
00:10:32,340 --> 00:10:37,880
هذا يسمح له بفعل شيئين في الوقت
الّذي نفعل فيه نحن شيئاً واحداً

124
00:10:38,050 --> 00:10:43,430
بينما نهاجم، يستطيع هو الهجوم والدّفاع معاً

125
00:10:52,480 --> 00:10:54,900
مام، هل يمكنكِ حمل داي؟

126
00:10:55,860 --> 00:10:58,700
سأنتقل بكم إلى حيث يوجد الضّخم

127
00:10:58,860 --> 00:11:00,410
حينئذ سنستخدم تعويذة عودة للخروج من هنا

128
00:11:01,280 --> 00:11:02,280
...بوب

129
00:11:02,450 --> 00:11:05,290
لا أريد سماع أيّ اعتراض هذه المرّة

130
00:11:05,450 --> 00:11:08,120
لهذا يُدعى بإله العالم السّفلي

131
00:11:08,290 --> 00:11:11,580
إنّه بمستوى مختلف عنّا تماماً

132
00:11:11,750 --> 00:11:17,170
إذا أردنا مقاتلته من جديد، نحتاج لإعادة
!تنظيم أنفسنا وإلّا سنهلك

133
00:11:20,840 --> 00:11:21,840
حسناً

134
00:11:22,640 --> 00:11:24,850
!ها أنا ذا! تعالي إلى هنا

135
00:11:25,010 --> 00:11:26,180
!وداعاً

136
00:11:30,310 --> 00:11:31,310
!عودة

137
00:11:34,110 --> 00:11:36,190
!ماذا؟

138
00:11:42,860 --> 00:11:44,740
!ما-ماذا حدث؟

139
00:11:44,910 --> 00:11:49,830
مساكين. تزداد الأمور يأساً

140
00:11:50,790 --> 00:11:52,750
ألم تكن تعلم؟

141
00:11:53,540 --> 00:11:56,880
لا أحد يستطيع الإفلات من ملك الشّياطين

142
00:12:08,970 --> 00:12:14,270
قصر فارن محميّ بقوّة سحر الملك فارن

143
00:12:14,440 --> 00:12:16,940
لا يمكنكم الهرب منه بتعويذة عودة

144
00:12:18,440 --> 00:12:21,400
،قد يكون التحرّك داخل قصر فارن ممكناً

145
00:12:21,570 --> 00:12:26,450
لكن لا يستطيع أحد الدّخول ولا يستطيع أحد المُغادرة

146
00:12:26,620 --> 00:12:31,580
لا أحد سوى مُحاربي جيش الشّياطين
المُنعمين بتعويذة خاصّة

147
00:12:31,750 --> 00:12:33,040
!تبّاً

148
00:12:33,210 --> 00:12:39,090
لو حاولتُم القتال بدلاً من الهرب، لرُبّما
تمكّنتم من العيش فترة أطول

149
00:12:40,510 --> 00:12:42,300
لكن أعتقد النّتيجة هي ذاتها في النّهاية

150
00:12:42,470 --> 00:12:45,590
في كلّ الأحوال، أنتم عاجزون عن فعل شيء

151
00:12:45,760 --> 00:12:48,760
!قُضي عليكم جميعاً! قُضي عليكم

152
00:12:50,850 --> 00:12:52,560
!ما مشكلتك؟

153
00:12:52,730 --> 00:12:55,230
!قلتُ قُضي عليكم جميعاً

154
00:12:56,940 --> 00:12:59,230
!قُضي! عليكم! جميعاً

155
00:13:01,280 --> 00:13:02,650
انتهى الأمر

156
00:13:02,820 --> 00:13:04,900
حان وقت حسم المسألة

157
00:13:11,290 --> 00:13:12,540
...خدشتُه

158
00:13:13,000 --> 00:13:13,910
...آنذاك

159
00:13:15,750 --> 00:13:17,000
!بقبضة الانكسار خاصّتي

160
00:13:17,170 --> 00:13:20,590
!فهمت! عندما هاجمتم جميعاً وقتذاك

161
00:13:25,300 --> 00:13:27,970
يا لها من صدمة. إنّها معجزة

162
00:13:28,300 --> 00:13:29,470
!نجحَ ذلك

163
00:13:29,640 --> 00:13:33,060
!يبقى ملك الشّياطين كائناً حيّاً

164
00:13:33,220 --> 00:13:36,100
...بما أنّني أصبتُه بقبضة الانكسار خاصّتي

165
00:13:37,400 --> 00:13:39,360
أتريدين التّجربة؟

166
00:13:40,610 --> 00:13:44,820
هذه بالفعل فُرصة العمر

167
00:13:44,990 --> 00:13:49,490
لن يتدخّل خدمي وأنا جريح

168
00:13:49,870 --> 00:13:52,540
ستكون هجماتي أبطأ

169
00:13:53,040 --> 00:13:57,960
لكن تعلمين بالتأكيد أنّ الظلاميّين يستطيعون التجدّد

170
00:14:00,460 --> 00:14:03,960
إن لم تسرعي، ستزول فرصتكِ

171
00:14:04,760 --> 00:14:09,390
لا يمكننا الهرب وأنا الوحيدة القادرة على القتال

172
00:14:09,550 --> 00:14:11,720
ماذا ستفعلين؟

173
00:14:12,060 --> 00:14:13,430
!عليّ أن أجرّب ذلك

174
00:14:14,770 --> 00:14:15,430
!لا تفعلي

175
00:14:25,440 --> 00:14:29,240
لا يمكنكِ يا مام! أتظنّين حقّاً أنّه يمكن
!هزيمته بهذه البساطة؟

176
00:14:29,990 --> 00:14:31,450
يا لك من حادّ الذّكاء

177
00:14:31,620 --> 00:14:35,450
السّاحر الصّغير هو أبرز شخصيّة في
هذه المعركة بالفعل

178
00:14:35,620 --> 00:14:39,870
!كنتَ تعبث معي! كان بمقدورك التجدّد في أيّ وقت

179
00:14:40,040 --> 00:14:45,090
!يا لقسوتك! هل تستمتع باللّعب معنا هكذا؟

180
00:14:45,380 --> 00:14:46,710
أستمتع بذلك

181
00:14:48,090 --> 00:14:53,760
استخدام القوّة المُذهلة التي اكتسبتها
،للّعب مع الضّعيف

182
00:14:53,930 --> 00:14:56,100
أليس هذا ممتعاً؟

183
00:14:56,270 --> 00:14:58,980
ألا يُشعركِ هذا بالتفوّق؟

184
00:14:59,140 --> 00:15:00,480
عمّاذا تتكلّم؟

185
00:15:00,650 --> 00:15:05,320
القوّة هي القانون الأساسيّ الأجمل
والأنقى والأبسط

186
00:15:05,480 --> 00:15:08,860
القوّة هي الحقّ" شعار حياة كلّ الخلائق"

187
00:15:09,030 --> 00:15:11,660
الظلاميّون... والتّنانين... وكلّ الخلائق

188
00:15:11,820 --> 00:15:17,250
وحدهم البشر من يستخدمون منطقاً
رنّاناً لنكران الحقيقة

189
00:15:17,580 --> 00:15:21,080
القوّة هي الحقيقة التي تسود في كلّ مكان

190
00:15:21,250 --> 00:15:26,300
حتّى لو امتلكت القوّة، هذا لا يمنحك
!الحقّ لزعزعة السّلام

191
00:15:26,460 --> 00:15:29,130
!السّلام الّذي يرغبه الجميع في عالم السّطح

192
00:15:32,680 --> 00:15:35,220
أنتِ جاهلة

193
00:15:35,390 --> 00:15:41,560
الحقيقة هي السّلام الّذي تتحكّم به قوّة أعظم

194
00:15:41,730 --> 00:15:43,150
أجل

195
00:15:43,940 --> 00:15:46,610
بواسطة قوّة الآلهة

196
00:15:49,320 --> 00:15:56,530
موطني، العالم السّفلي، هو عالم يقع
تحت بلادكم على بُعد مسافة طويلة

197
00:15:56,700 --> 00:16:01,620
أينما نظرتم لن تروا إلّا حمم تغلي وأرض قاحلة

198
00:16:02,250 --> 00:16:04,210
،وفوق ذلك، الشّمس

199
00:16:04,380 --> 00:16:08,670
مصدر كلّ الحياة، لا تصل إلى العالم السّفلي

200
00:16:08,840 --> 00:16:12,180
الشّمس... يا لها من قوّة عظيمة

201
00:16:12,340 --> 00:16:17,050
،لكن الآلهة منحت الشّمس وعالم السّطح للبشر

202
00:16:17,220 --> 00:16:20,350
لتنفي الظلاميّين والتّنانين إلى العالم السّفلي

203
00:16:20,520 --> 00:16:25,020
فقط لأنّ البشر كانوا أضعف منّا

204
00:16:27,980 --> 00:16:32,780
إذا كانت هذه هي العدالة، فقوّتنا
إذاً هي العدالة أيضاً

205
00:16:32,950 --> 00:16:36,870
لهذا قضيتُ آلاف السّنين أبني قوّتي

206
00:16:37,030 --> 00:16:41,450
تحضيراً لإبادة عالم السّطح

207
00:16:41,620 --> 00:16:44,750
قريباً، سيزول عالم السّطح

208
00:16:44,920 --> 00:16:47,340
...ثمّ، في عالمنا السّفلي

209
00:16:48,090 --> 00:16:50,710
سوف تشرق الشّمس

210
00:16:51,670 --> 00:16:54,220
...عندما يحدث ذلك، أنا

211
00:16:55,380 --> 00:16:59,060
سأكون حقّاً إله العالم السّفلي

212
00:16:59,220 --> 00:17:02,770
...الحماقة التي ارتكبتها الآلهة

213
00:17:03,390 --> 00:17:05,980
سوف يتمّ تصحيحها

214
00:17:11,230 --> 00:17:14,950
!لـ-لا يمكننا الفوز! يفكّر بمقياس مختلف كلّياً

215
00:17:15,110 --> 00:17:20,700
!لآلاف السّنين، لم يعتبر عالمَ السّطح سوى مجرّد غطاء

216
00:17:20,870 --> 00:17:22,580
...نحن مجرّد

217
00:17:23,000 --> 00:17:28,500
!نحن مجرّد بشر! مُحال أن نحلم بالفوز

218
00:17:29,590 --> 00:17:31,880
استسلمتم أخيراً

219
00:17:32,340 --> 00:17:35,260
كان ذلك ممتعاً أكثر ممّا توقّعت

220
00:17:35,420 --> 00:17:38,800
أبليتم بلاء عظيماً يا أبطال عالم السّطح

221
00:17:38,970 --> 00:17:40,720
!لن أستسلم

222
00:17:41,600 --> 00:17:43,060
!د-داي؟

223
00:17:43,850 --> 00:17:49,480
!حتّى لو استسلم الجميع في العالم، لن أستسلم أنا

224
00:17:49,900 --> 00:17:52,320
!لن أستسلم أبداً

225
00:17:52,480 --> 00:17:54,570
يا لها من حيويّة مدهشة

226
00:17:54,740 --> 00:17:59,450
لكن ماذا قلت؟ لا أظنّني سمعتُك جيّداً

227
00:18:00,320 --> 00:18:05,870
!لن أستسلم أبداً. حتّى لو فقد الجميع الأمل

228
00:18:06,040 --> 00:18:09,960
!لن أستسلم حتّى الرّمق الأخير

229
00:18:11,090 --> 00:18:14,300
إذاً سمعتُك بشكل صحيح في المرّة الأولى

230
00:18:14,460 --> 00:18:19,680
ظننتُ أنّه من غير المُمكن أن تقول كلاماً
كهذا في مواجهة قوّتي

231
00:18:19,840 --> 00:18:23,600
أعلم حجم قوّتك القاهرة

232
00:18:23,760 --> 00:18:25,850
!لكن هذا لا يهمّ

233
00:18:28,390 --> 00:18:33,610
!قلتَ أنّ القوّة هي العدالة، لكنّك مخطئ

234
00:18:33,770 --> 00:18:36,780
...ليس هذا ما علّمني إيّاه جدّي

235
00:18:37,360 --> 00:18:39,410
...أو ما علّمني إيّاه المُعلّم أفان

236
00:18:39,570 --> 00:18:42,910
!أو ما علّمني إيّاه أبي عن العدالة

237
00:18:43,080 --> 00:18:46,080
!أنت مخطئ بخصوص كلّ شيء

238
00:18:49,370 --> 00:18:50,750
!داي

239
00:18:58,130 --> 00:19:02,180
!نهضوا من جديد؟! بعد أن كانوا على حافّة الموت؟

240
00:19:03,510 --> 00:19:05,180
حسناً إذاً

241
00:19:05,810 --> 00:19:12,190
أعترف بقوّة روحك والّتي مدّت أصدقاءك
البائسين بالقوّة

242
00:19:12,360 --> 00:19:15,230
لكن لا يمكنك قتلي بروحك

243
00:19:15,400 --> 00:19:18,150
،إذا أردت تغيير رأيي بشأن العدالة

244
00:19:18,320 --> 00:19:21,700
فاستخدم قوّتك إذاً لا كلماتك

245
00:19:21,860 --> 00:19:23,240
!هذا ما سأفعله

246
00:19:24,950 --> 00:19:27,660
!هذه كلّ قوّتي

247
00:19:27,830 --> 00:19:30,250
!عنقاء القيصر

248
00:19:31,040 --> 00:19:34,880
!أفان ستراش

249
00:19:37,590 --> 00:19:38,960
!خرقَها

250
00:19:40,090 --> 00:19:41,130
!بطيء للغاية

251
00:19:44,470 --> 00:19:45,760
!داي

252
00:19:58,780 --> 00:20:00,070
!الملك فارن

253
00:20:00,240 --> 00:20:03,700
تمكّنَ من التصدّي لهجمتي الثّانية

254
00:20:03,860 --> 00:20:09,750
ليس ذلك فحسب، بل قهرَتْ قوّته عنقاء
القيصر خاصّتي ووصلت إليّ

255
00:20:10,620 --> 00:20:11,910
!عظيم

256
00:20:14,040 --> 00:20:14,710
!تعويذات دويّ؟

257
00:20:36,770 --> 00:20:39,940
!وكأنّها عاصفة من تعويذات دويّ

258
00:20:40,110 --> 00:20:44,660
!يستخدم فارن تعويذات أضعف ويقاتل بالعدد

259
00:20:44,820 --> 00:20:48,780
!رغم ذلك، كلّ تعويذة مُدمّرة بمثل تدمير تعويذة انفجار

260
00:20:51,000 --> 00:20:52,080
!داي

261
00:20:58,090 --> 00:21:05,260
جلالة الملك فارن، أرى أن تتوقّف عن اللّعب
وتسمح لنا بالقتال جميعاً

262
00:21:05,430 --> 00:21:07,850
ماذا؟ هُراء

263
00:21:09,010 --> 00:21:13,850
أتظنّ حقّاً أنّه سيجرحني أكثر؟

264
00:21:16,560 --> 00:21:17,940
!داي

265
00:21:30,080 --> 00:21:33,870
!الآن! خذ هذه

266
00:21:38,420 --> 00:21:39,710
!جلالة الملك فارن

267
00:22:07,150 --> 00:22:12,030
بصراحة كنتُ أخرق

268
00:22:12,200 --> 00:22:18,370
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

269
00:22:18,870 --> 00:22:23,840
وحتّى أنّني استخدمتُ الوحدة كسلاح

270
00:22:24,000 --> 00:22:29,760
بحثتُ في الدّيماس عن جواب بسيط

271
00:22:29,930 --> 00:22:35,600
حتّى لو تخلّيتُ عن الحقّ واللّطف

272
00:22:35,770 --> 00:22:41,730
أريد أن أكون موجوداً بجانبك فحسب

273
00:22:41,900 --> 00:22:47,360
أن أنادي باسمك

274
00:22:47,530 --> 00:22:53,370
هو أصعب من أي تعويذة سحريّة

275
00:22:53,530 --> 00:22:59,160
رغم أنّك مقرّب جدّاً منّي

276
00:22:59,330 --> 00:23:01,790
أحبّك

277
00:23:01,960 --> 00:23:05,090
أدركتُ ذلك أخيراً

278
00:23:05,250 --> 00:23:10,220
أن أنادي باسمك

279
00:23:10,380 --> 00:23:16,640
هو السّبب الّذي وُلدت لأجله

280
00:23:16,810 --> 00:23:22,560
سأتخلّص من هذا اللّيل الطويل

281
00:23:22,730 --> 00:23:25,270
وآتي لرؤيتك

282
00:23:25,440 --> 00:23:30,030
إلى حيث أنت الآن

283
00:23:33,990 --> 00:23:36,240
أفان ستراش الخاصّة بداي تفجّر فارن

284
00:23:36,410 --> 00:23:42,210
مُعترِفاً بقوّة داي، يستدعي ملك الشّياطين
فارن سلاحاً أسطوريّاً للتصدّي له

285
00:23:42,370 --> 00:23:45,460
تهزّ قوّته السّماوات والأرض

286
00:23:45,630 --> 00:23:49,760
فارن يدفع داي للخلف بسهولة ويوجّه ضربة قاضية

287
00:23:49,920 --> 00:23:53,510
هل يلتمس داي وأصدقاؤه الأمل
في وجه هلاك محتوم؟

288
00:23:53,680 --> 00:23:55,970
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

289
00:23:57,930 --> 00:23:59,930
!وتستمرّ المغامرة