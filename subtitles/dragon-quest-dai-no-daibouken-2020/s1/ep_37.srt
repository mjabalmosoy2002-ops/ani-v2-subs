1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أنا أحترق لأنّي أحرقت بالفعل

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:50,610 --> 00:01:55,030
!الشّيطان الخارق لا يُقهَر

20
00:01:55,190 --> 00:01:57,150
!مام، اضربيه على المعدة

21
00:01:57,320 --> 00:01:59,990
!ينبغي لهذا أن يُجبره على إخراج داي

22
00:02:03,990 --> 00:02:05,330
!لن تفعلي

23
00:02:06,500 --> 00:02:07,830
!كانت تلك الرّكلة تمويهاً

24
00:02:08,000 --> 00:02:11,790
!قبضة الانكسار بأسلوب المُعلّم المُحارب

25
00:02:25,970 --> 00:02:28,310
!مرحى! حرّرَتْ داي

26
00:02:43,200 --> 00:02:45,620
!داي! يسرّني أنّه حيّ

27
00:02:45,790 --> 00:02:48,580
لا بُدّ وأنَّ الفضل يعزو للملابس الجديدة

28
00:02:48,750 --> 00:02:50,920
!مام، يبدو أنَّ داي بخير

29
00:02:52,710 --> 00:02:56,340
!تشيو، استخدم إحدى أدواتك لعِلاجِ داي

30
00:02:56,510 --> 00:02:58,760
!حسناً! اعتمدي عليّ

31
00:03:07,680 --> 00:03:09,020
!...هـ-هذا

32
00:03:09,520 --> 00:03:11,690
!...جسدي الخالد

33
00:03:11,850 --> 00:03:14,440
!كيف؟! كيف؟

34
00:03:28,160 --> 00:03:30,500
تلك الفتاة مُدهشة

35
00:03:33,540 --> 00:03:35,960
!مام قويّة إلى حدّ لا يُصدّق

36
00:03:36,130 --> 00:03:39,630
!وتِلك الهجمة الخاصّة مُذهلة

37
00:03:43,590 --> 00:03:45,050
هل أنت مذهول؟

38
00:03:45,220 --> 00:03:49,020
هذا هو جوهر أسلوب المُعلّم المُحارب الخاصّ
،بكبير المُعلّمين بروكينا

39
00:03:49,180 --> 00:03:53,810
!والهجمة العُظمى للآنسة مام، قبضة الانكسار

40
00:03:53,980 --> 00:03:57,860
!هذا صحيح. قبضة الانكسار

41
00:03:58,020 --> 00:04:02,860
مام، كان تطوّركِ أكثر من مُذهل

42
00:04:03,030 --> 00:04:09,160
أتقنتِ في أيّام ما يتعلّمه مُمارِس
فنون قتاليّة عاديّ في سنوات

43
00:04:09,330 --> 00:04:14,120
كلّ ما بقي هو أن أُعلّمكِ المهارة العُظمى
،لأسلوب المُعلّم المُحارب الخاص بي

44
00:04:14,290 --> 00:04:17,000
لكن أنا مريضٌ وواهن

45
00:04:17,170 --> 00:04:20,460
يُؤلمني ألّا أستطيع أن أريكِ بنفسي

46
00:04:23,800 --> 00:04:25,470
هل خيّبتُ أملكِ؟

47
00:04:25,640 --> 00:04:28,100
لـ-لا، بالطبع لا

48
00:04:28,260 --> 00:04:31,430
المعذرة يا كبير المُعلّمين؟ ما هو مرضُك؟

49
00:04:36,690 --> 00:04:38,900
وخزة في المؤخّرة

50
00:04:39,070 --> 00:04:40,110
!ماذا؟

51
00:04:41,150 --> 00:04:44,450
وكيف لوخزة في المؤخّرة أن تجعلك تكحّ؟

52
00:04:48,410 --> 00:04:54,160
لكن أنا متأكّد أنّكِ تستطيعين إتقانها
يا مام. لا تقلقي

53
00:04:55,830 --> 00:04:58,420
أي نوع من المهارات هي يا كبير المُعلّمين؟

54
00:04:58,920 --> 00:05:03,260
إنّها مزيج ما بين تعويذة مُعيّنة وأسلوب المُعلّم المُحارب

55
00:05:03,590 --> 00:05:05,130
...لكن يا كبير المُعلّمين

56
00:05:06,970 --> 00:05:12,430
كنتُ كاهنة مُحاربة. لا أستطيع
استخدام التّعويذات الهجوميّة

57
00:05:12,600 --> 00:05:16,850
التّعويذات الهجوميّة ليست الطريقة
الوحيدة لهزيمةِ عدوّ

58
00:05:18,520 --> 00:05:20,070
...تلك التّعويذة هي

59
00:05:21,070 --> 00:05:22,230
شِفاء

60
00:05:22,400 --> 00:05:23,320
!شِفاء؟

61
00:05:30,990 --> 00:05:32,290
!ها أنا ذا

62
00:05:32,450 --> 00:05:38,630
شِفاء هي تعويذة تُعزّز سحريّاً الوظائف
الحيويّة للجسد

63
00:05:38,790 --> 00:05:43,260
لكن تماماً مثلما تذبل النّباتات
،عندما تُعطى مكوّنات غذائيّة فائضة

64
00:05:43,420 --> 00:05:49,010
كذلك سحر الشّفاء المُفرِط يمكن
أن يدمّر أنسجة الجسد

65
00:05:49,760 --> 00:05:56,560
منذ زمن بعيد، مثل سحر الشّفاء المُفرِط هذا
"كان يُهَابُ ويُعرَفُ باسم "شِفاء مُفرِط

66
00:05:56,730 --> 00:05:58,100
...شِفاء مُفرِط

67
00:05:58,270 --> 00:06:01,310
وحدهم الكهنة والحُكماء الأقوى

68
00:06:01,480 --> 00:06:06,700
من يستطيعون امتلاك شِفاء مُفرِط
كورقة رابحة ضدّ الوحوش

69
00:06:06,860 --> 00:06:10,280
لكن مع الوقت، اختفى مُستخدِمو التّعويذة جميعهم

70
00:06:10,450 --> 00:06:15,250
مقدار قوّة السّحر الّذي يستهلكه شِفاء
مُفرِط يفوق تعويذة الشّفاء النصفيّ

71
00:06:15,410 --> 00:06:20,460
لكن، باستخدام تعويذات الشّفاء بالقتال
،بأسلوب المُعلّم المُحارِب

72
00:06:20,630 --> 00:06:26,670
تطوّرتُ تقنيّةً لتوليد قوّة مُدمِّرة في لحظة التّأثير

73
00:06:26,840 --> 00:06:31,010
عندما يتمّ استخدامها، تخلقُ تأثيراً
قاهِراً مُضادّاً للوحوش

74
00:06:31,180 --> 00:06:34,260
وذلك بتطبيق صدمة قاتِلة لجسدِ العدوّ

75
00:06:35,720 --> 00:06:38,180
!قاتِلة لجسدِ العدوّ؟

76
00:06:39,140 --> 00:06:41,310
مهارة مُرعِبة بحقّ

77
00:06:41,480 --> 00:06:44,020
أجل. إنّها مهارة مُرعِبة

78
00:06:44,190 --> 00:06:49,700
فقط أولئك الّذين يفهمون كم هي مُرعبة
هم من يستطيعون تعلّمها

79
00:06:49,860 --> 00:06:53,740
لُقِّبتُ بكبير المُعلّمين منذ عقود

80
00:06:53,910 --> 00:07:00,460
لكنّكِ يا مام، أوّل شخص ارتأيتُ أنّه
يستحقّ التّعليم

81
00:07:01,960 --> 00:07:03,210
...كبير المُعلّمين

82
00:07:03,630 --> 00:07:09,720
مثلما ائتمنَكِ مُعلّمكِ الأوّل أفان ومنحكِ
،مُسدّس رصاص السّحر

83
00:07:10,470 --> 00:07:14,890
أنا أيضاً أثِق بقلبكِ العادل والطيّب

84
00:07:15,060 --> 00:07:19,350
لهذا سأعلّمكِ إيّاها يا مام

85
00:07:22,230 --> 00:07:24,480
!شكراً لك يا كبير المُعلّمين

86
00:07:25,980 --> 00:07:27,360
ألستُ رائعاً؟

87
00:08:00,480 --> 00:08:02,230
!هذه هي الآنسة مام التي أعرفها

88
00:08:03,440 --> 00:08:05,190
!داي، استيقظت

89
00:08:05,360 --> 00:08:07,150
هل تمَّ إنقاذي؟

90
00:08:07,320 --> 00:08:09,190
!أجل! بفضل مام

91
00:08:09,650 --> 00:08:10,690
!كُن مُمتنّاً

92
00:08:28,340 --> 00:08:31,720
هذا مُذهِل. لم أتوقّع أن تتمكّني من القتال هكذا

93
00:08:32,720 --> 00:08:33,590
!داي

94
00:08:33,760 --> 00:08:37,800
!ألا يُفترض أن يكون لديك أداة ما؟

95
00:08:37,970 --> 00:08:40,930
!إن كان كذلك، سارِع وعالِج داي

96
00:08:41,770 --> 00:08:43,690
!حسناً

97
00:08:45,100 --> 00:08:48,270
سأعطيك عشبة طبّية، لذا كُن مُمتنّاً

98
00:08:49,110 --> 00:08:49,940
!خُذ

99
00:08:50,110 --> 00:08:52,030
هذه عشبة ترياق

100
00:08:54,570 --> 00:08:55,200
!خُذ

101
00:08:55,360 --> 00:08:57,280
!هذه عشبة سامّة

102
00:08:59,160 --> 00:09:00,580
!ما هذا؟! اختفَتْ

103
00:09:00,740 --> 00:09:04,580
!دائماً ما أحمل خمسة أعشاب دوائيّة

104
00:09:05,210 --> 00:09:06,000
!تذكّرت

105
00:09:06,620 --> 00:09:11,960
استخدمتُها كلّها عندما تعرّضتُ لهجوم بواسطة
!الخفافيش الصّغيرة في الجبال

106
00:09:12,130 --> 00:09:15,760
من يستخدم خمسة أعشاب طبّية كاملة
!على كائنات ضعيفة كهذه؟

107
00:09:20,680 --> 00:09:22,180
!انتهى الأمر

108
00:09:32,070 --> 00:09:33,150
!يا للهول

109
00:09:34,610 --> 00:09:39,820
!جيّد! يبدو أنَّ عقلي ما زال مُتّقِداً

110
00:09:40,370 --> 00:09:43,700
!لديك نوعان من الهجمات

111
00:09:43,870 --> 00:09:46,580
هجمات عندما تتوهّج يداكِ، وهجمات
عندما لا تتوهّجان

112
00:09:47,120 --> 00:09:51,170
بصيغة أخرى، تلك الهجمة لا يُمكن
استخدامها بكامل جسدكِ

113
00:09:51,340 --> 00:09:56,800
،استنتجتُ أنّه لا يُمكن تنفيذها إلّا بيديكِ
!وفي لحظة التأثير فقط

114
00:09:56,970 --> 00:10:00,010
!استسلمي! هذه مادّة مُخاطيّة خاصّة

115
00:10:00,180 --> 00:10:01,810
!لا تُزال بسهولة

116
00:10:02,260 --> 00:10:04,350
!حان وقتُ الاستسلام

117
00:10:06,350 --> 00:10:06,980
!يا للهول

118
00:10:07,140 --> 00:10:08,980
!...إذا كانت لا تستطيع استخدام يديها المُتوهّجتين

119
00:10:11,900 --> 00:10:13,020
!ماذا عسانا أن نفعل؟

120
00:10:17,150 --> 00:10:19,070
!أليس لديك أي شيء؟

121
00:10:19,240 --> 00:10:23,330
!لي أو لداي! شيء ما لاسترجاع لياقتنا

122
00:10:24,910 --> 00:10:26,290
...هذا

123
00:10:26,450 --> 00:10:28,000
!جوزة قطرة الدّموع

124
00:10:28,160 --> 00:10:29,580
!ما هذه؟! أهي مُفيدة؟

125
00:10:29,750 --> 00:10:34,090
اسم على مُسمّى، إنّها تسترجع اللّياقة
!بقدر قطرة دمعة عصفور دوريّ

126
00:10:35,260 --> 00:10:37,010
!لا جدوى منها

127
00:10:37,170 --> 00:10:40,130
!لا، إنّها كافية! هذا كُل ما أحتاجه

128
00:10:42,050 --> 00:10:43,260
!استسلمي

129
00:10:43,680 --> 00:10:48,560
من دون تلك الهجمة، لا تمتلكين شيئاً
!يستطيع أذيّة جسدي الخالد

130
00:10:48,730 --> 00:10:51,400
!موتي يا صغيرة

131
00:10:51,560 --> 00:10:53,110
!مام

132
00:10:53,270 --> 00:10:57,440
!أرجوك يا تشيو، أوصلني أنا والجوزة إلى هناك

133
00:11:00,740 --> 00:11:02,410
!بسرعة

134
00:11:12,580 --> 00:11:14,840
!موتي أيّتها الصّغيرة

135
00:11:25,430 --> 00:11:26,260
!مام

136
00:11:47,740 --> 00:11:50,080
!اهربي! اخرجي من هناك يا مام

137
00:11:50,620 --> 00:11:53,370
!داي، إن كنت تخطّط لشيء، فأسرِع

138
00:11:58,880 --> 00:12:01,470
أنت أثقل بكثير ممّا تبدو

139
00:12:01,630 --> 00:12:02,510
آسف

140
00:12:02,680 --> 00:12:07,350
لكن لا أستطيع إهدار اللّياقة للتسلّق إلى هناك

141
00:12:08,010 --> 00:12:11,230
!أحتاج لتحريرها كلّها دُفعة واحدة في النّهاية

142
00:12:12,770 --> 00:12:15,900
،بعد رؤيتي مام تُقاتِل

143
00:12:16,060 --> 00:12:20,740
أدركتُ كم كنتُ مُسرِفاً عندما كنتُ
أستخدم قوّة شارتي

144
00:12:21,570 --> 00:12:26,320
كنتُ أقاتل بكامل قوّتي

145
00:12:26,490 --> 00:12:29,540
لهذا دائماً ما أستهلك طاقتي خلال وقتٍ قصير

146
00:12:31,080 --> 00:12:33,410
،مثل قبضتا مام المُتوهّجتان

147
00:12:33,580 --> 00:12:38,920
يجب أن أركّز وأحرّر كلّ طاقتي
!في لحظة التأثير

148
00:12:40,050 --> 00:12:42,670
،ولو كان قليلاً من القوّة

149
00:12:43,170 --> 00:12:46,010
...إذا استخدمتُها في اللّحظة الأخيرة

150
00:12:47,390 --> 00:12:49,810
!يمكنني هزيمته

151
00:13:00,650 --> 00:13:03,990
سبّبتِ لي بعض المتاعب

152
00:13:06,950 --> 00:13:10,200
ينتابُني فضول بشأن تلك الهجمة
،الغريبة التي استخدمتِها

153
00:13:10,490 --> 00:13:14,290
!لكن شخص خطير مثلكِ يجب القضاء عليه فوراً

154
00:13:20,920 --> 00:13:21,800
!داي؟

155
00:13:21,960 --> 00:13:23,880
!إنّه ذاهب نحو سيف الأبطال

156
00:13:24,260 --> 00:13:27,260
!هكذا إذاً! يخطّط داي لفعل شيء ما

157
00:13:30,930 --> 00:13:34,350
يجب أن أفعل المستحيل لإلهاء هذا الوحش

158
00:13:36,060 --> 00:13:38,230
كم أنتم مثاليّون كفئران تجارُب

159
00:13:38,400 --> 00:13:42,190
تُقاومون باستماتة رغم أنّكم تعلمون
أنّكم سوف تموتون

160
00:13:42,360 --> 00:13:45,320
!أنتِ لستِ أكثر من مجرّد قُمامة

161
00:13:45,990 --> 00:13:51,950
!لا يوجد أحدٌ قُمامة! كائناً من كان

162
00:13:52,120 --> 00:13:56,540
!إن كنت لا تفهم ذلك، فأنت القُمامة الحقيقيّة

163
00:13:58,040 --> 00:14:01,960
اسمعني يا زامزا، أنت أداة

164
00:14:02,130 --> 00:14:07,300
ليس أنت فقط. كلّ مخلوق في هذا
العالم هو أداة لي

165
00:14:07,470 --> 00:14:12,510
اكسب القوّة والمعرفة. استخدمهما لمنفعتي

166
00:14:12,680 --> 00:14:13,220
...أبي

167
00:14:13,390 --> 00:14:16,810
!وإلّا لن تكون أكثر من مُجرّد قُمامة

168
00:14:17,690 --> 00:14:18,900
أليس كذلك؟

169
00:14:19,060 --> 00:14:24,980
فالأداة عديمة الفائدة ليسَتْ إلّا قُمامة، صحيح؟

170
00:14:33,240 --> 00:14:34,450
...أنا

171
00:14:34,790 --> 00:14:37,080
!أنا لستُ قُمامة

172
00:14:37,250 --> 00:14:40,120
!قوّتي وعقلي هُما الأعظم

173
00:14:40,710 --> 00:14:45,670
أستطيع أن أكون قائد الفيلق الغامض
أو الوحوش البرّية الشيطانيّة إذا أردت

174
00:14:45,840 --> 00:14:48,010
!كيف تجرئين على السخرية منّي؟

175
00:14:51,760 --> 00:14:53,260
!مام

176
00:14:53,430 --> 00:14:54,510
!آنسة مام

177
00:14:55,310 --> 00:14:57,810
!تشيو! أعطني الجوزة بسرعة

178
00:14:57,980 --> 00:14:58,640
!حسناً

179
00:15:06,110 --> 00:15:07,360
هل أعطَتْ مفعولها؟

180
00:15:09,450 --> 00:15:14,410
أجل. أشعر بعودة قوّتي ولو قليلاً فقط

181
00:15:18,910 --> 00:15:22,960
!يا سيف الأبطال، مُدّني بقوّتك

182
00:15:25,040 --> 00:15:25,840
!ماذا؟

183
00:15:26,000 --> 00:15:28,420
!الفتى الشقيّ! متى وصل إلى السّيف؟

184
00:15:29,840 --> 00:15:30,840
!تعويذة شرارة

185
00:15:31,010 --> 00:15:32,930
!من أين أتيت؟

186
00:15:33,090 --> 00:15:34,510
!أطلِق تعويذة شرارة فحسب

187
00:15:34,680 --> 00:15:37,930
،لديّ ما يكفي من قوّة سحريّة لتعويذة شرارة

188
00:15:38,100 --> 00:15:39,310
!لكن هذا لن يُفيد

189
00:15:39,480 --> 00:15:40,770
أطلقها نحو مام

190
00:15:41,690 --> 00:15:42,480
بسرعة

191
00:15:47,900 --> 00:15:48,730
!حسناً

192
00:15:49,820 --> 00:15:50,820
!مام

193
00:15:52,530 --> 00:15:53,530
!شرارة

194
00:15:55,070 --> 00:15:56,950
!تصدّي لها بالمادّة المُخاطيّة

195
00:15:58,580 --> 00:15:59,290
!لا

196
00:15:59,450 --> 00:16:02,080
!قبضة الانكسار

197
00:16:08,420 --> 00:16:09,340
!الآن

198
00:16:09,510 --> 00:16:13,380
!سأركّز كلّ ما لديّ في هذه اللّحظة

199
00:16:13,760 --> 00:16:14,840
...أفان

200
00:16:15,930 --> 00:16:17,510
!ستراش

201
00:16:37,700 --> 00:16:38,780
!كيف ذلك؟

202
00:16:41,660 --> 00:16:42,790
!هل نجحَتْ؟

203
00:16:57,800 --> 00:16:58,800
!ربِحنا

204
00:17:00,510 --> 00:17:01,890
!ماذا؟

205
00:17:02,640 --> 00:17:06,730
!مستحيل! أنا الشّيطان الخارق المُطلَق

206
00:17:06,900 --> 00:17:09,230
!كيف لهؤلاء القُمامة أن...؟

207
00:17:21,290 --> 00:17:22,410
!هنيئاً

208
00:17:22,580 --> 00:17:23,500
!فعلوها

209
00:17:23,660 --> 00:17:25,410
!هزموه

210
00:17:32,460 --> 00:17:35,300
كيف؟ كيف لهذا أن يكون مُمكناً؟

211
00:17:35,680 --> 00:17:38,640
أين كان الخطأ في حساباتي؟

212
00:17:38,800 --> 00:17:41,600
كان من المُحال أن أخسر

213
00:17:42,890 --> 00:17:44,230
!كيف؟

214
00:17:45,430 --> 00:17:48,850
لا أحد يدري. حاول أن تسأل الجرذ

215
00:17:49,020 --> 00:17:51,150
هذا الجرذ المُحاصَر هنا

216
00:17:52,110 --> 00:17:53,530
الجرذ؟

217
00:17:56,700 --> 00:17:57,910
هكذا إذاً

218
00:17:58,070 --> 00:18:02,950
ما قادَ إلى هزيمتي كان افتراضي أنّ
المخلوقات الأضعف قُمامة

219
00:18:03,120 --> 00:18:05,830
كان الخطأ في قلبي أنا

220
00:18:10,750 --> 00:18:14,260
أحسنت صُنعاً يا داي! كانت هجمة
!أفان ستراش مُذهلة

221
00:18:14,840 --> 00:18:18,340
...أجل. يعزو الفضل لسيف الأبطال

222
00:18:23,260 --> 00:18:26,140
!ماذا؟! لا! سيف الأبطال

223
00:18:26,640 --> 00:18:30,940
حتّى السّيف الأسطوري لا يستطيع
!تحمُّل قوّة داي؟

224
00:18:31,110 --> 00:18:33,400
!لا! هذا مستحيل

225
00:18:33,570 --> 00:18:38,200
،سيف الأبطال، مثل تاج الأبطال الّذي أعطيتُك إيّاه

226
00:18:38,360 --> 00:18:41,950
!مصنوع من المعدن الأسطوريّ، أوريكالكوم

227
00:18:42,120 --> 00:18:45,410
!يُقال أنّ أوريكالكوم معدن أبديّ

228
00:18:45,580 --> 00:18:47,540
!لماذا إذاً؟

229
00:18:49,540 --> 00:18:54,460
آسف لتخييبِ أملكم. هذا مُزيّف بشكلٍ مُتقَن

230
00:18:54,630 --> 00:18:59,430
فسيف الأبطال الحقيقيّ قد قُدِّم لهدلر-ساما سلفاً

231
00:18:59,590 --> 00:19:00,720
!ماذا؟

232
00:19:00,890 --> 00:19:02,930
...و-و

233
00:19:03,100 --> 00:19:08,600
!إذا استطعتُ تقديم هذا، تكتمل مُهمّتي

234
00:19:08,770 --> 00:19:11,480
!إلى أبي

235
00:19:13,110 --> 00:19:14,900
!ماذا فعلتَ بالضبط؟

236
00:19:16,190 --> 00:19:18,610
أرسلته إلى أبي

237
00:19:18,940 --> 00:19:22,780
يحتوي على نتائج بحثي حول الشّيطان الخارق

238
00:19:22,950 --> 00:19:25,870
وكذلك كلّ معرفتي

239
00:19:26,040 --> 00:19:32,170
بهذا، يستطيع أبي مُتابعة وإكمال البحث

240
00:19:32,330 --> 00:19:36,840
!أحمق! أبوك هو زابويرا

241
00:19:37,000 --> 00:19:40,220
!هل تعتقد أنّه سيكون مُمتنّاً لك على ذلك؟

242
00:19:43,050 --> 00:19:45,510
أعي ذلك تماماً

243
00:19:45,680 --> 00:19:49,930
أبي يرى الجميع باستثناء نفسه أدوات للاستخدام

244
00:19:50,100 --> 00:19:53,440
أشكّ في أنّه سيبكي حتّى لو مُتّ

245
00:19:54,060 --> 00:19:59,280
لكن بالرّغمِ من أنّه كذلك، يبقى أبي

246
00:19:59,440 --> 00:20:00,740
!زامزا

247
00:20:05,320 --> 00:20:09,500
هذا هو مصير أولئك الّذين يُصبِحون شياطين خارقين

248
00:20:09,660 --> 00:20:13,000
عندما ينهزِمون، حتّى الجثّة تختفي

249
00:20:13,170 --> 00:20:15,000
يتفتّتون كرماد أسود

250
00:20:18,300 --> 00:20:23,050
ربّما هذه عقوبة للعبثِ بالحياة التي منحَتْها الآلهة

251
00:20:23,680 --> 00:20:24,930
...زامزا

252
00:20:25,090 --> 00:20:27,300
لا تشفقوا عليّ

253
00:20:27,720 --> 00:20:31,390
أنا راضٍ عمّا آلَتْ ‘ليه الأمور

254
00:20:31,850 --> 00:20:37,060
لِلحظةٍ عابِرة، امتلكتُ الجسد الأقوى في العالم

255
00:20:37,230 --> 00:20:40,990
وتمكّنتُ من مُقاتلتكم

256
00:20:41,400 --> 00:20:42,860
...لكن يوماً ما

257
00:20:43,030 --> 00:20:47,700
سيأتي يوماً ما شيطان خارق لهزيمتِكم

258
00:20:47,870 --> 00:20:52,330
لم... لم تذهب معركتي سُدى

259
00:20:52,500 --> 00:20:57,840
هذا صحيح. لم يكن ذلك... عبثاً

260
00:21:04,050 --> 00:21:08,430
يبدو أنّه أراد أن يحظى بإطراء والده

261
00:21:09,010 --> 00:21:15,770
مهما قال من كلام، في أعماقه، لا بُدّ
وأنّه أراد أن ينال حبّ أبيه

262
00:21:18,270 --> 00:21:19,360
أتفهّم ذلك

263
00:21:21,070 --> 00:21:25,280
أتفهّم شعوره بعض الشيء

264
00:21:35,040 --> 00:21:39,840
!أحسنت صنعاً! أحسنت صنعاً يا زامزا

265
00:21:40,000 --> 00:21:44,470
،لم تعِش إلّا 200 سنة قصيرة

266
00:21:44,630 --> 00:21:47,220
!لكن كانت قيّمة جدّاً

267
00:21:47,380 --> 00:21:48,930
!كُن فخوراً في الحياة الآخرة

268
00:21:49,140 --> 00:21:51,510
بحثُك سيُنتِج

269
00:21:51,680 --> 00:21:55,680
!الشرّير الأقوى والأعظم في جيش الشّياطين

270
00:22:04,280 --> 00:22:07,240
حتّى لو واجهت الشّيطان والمنطق في صفّك

271
00:22:07,400 --> 00:22:11,200
قد يكون مجرّد تبرير

272
00:22:11,370 --> 00:22:15,290
حتّى الآن، حتّى الآن ما زلتُ أتردّد

273
00:22:15,450 --> 00:22:19,330
إلى أي مدى سنصل؟

274
00:22:19,500 --> 00:22:22,630
سمعتُ صوتاً أشبه بهمسِ ملاك

275
00:22:22,800 --> 00:22:26,550
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

276
00:22:26,720 --> 00:22:30,260
مُعرّض للحبِّ والحزن

277
00:22:30,430 --> 00:22:34,560
على الدّربِ المُغطّى بالاعتزاز

278
00:22:36,270 --> 00:22:38,600
لحظات عابِرة من الجُبن

279
00:22:40,150 --> 00:22:42,400
نداء الاستغاثة الذي تحفّظتُ عليه

280
00:22:43,980 --> 00:22:47,990
قبضتُ يدي المُرتعدة

281
00:22:48,570 --> 00:22:53,580
ذلك الوعد البسيط

282
00:22:53,740 --> 00:22:57,370
تلك الذّكريات التّافهة الصّغيرة

283
00:22:57,540 --> 00:22:59,670
ما زالت تسكن قلبي

284
00:22:59,830 --> 00:23:03,840
كجمرٍ يُبقيني مُشتعلاً

285
00:23:04,000 --> 00:23:08,340
شُعاع شفّاف من النُّور

286
00:23:08,510 --> 00:23:11,510
يُنير الدّرب أمامي

287
00:23:11,680 --> 00:23:16,180
قلّما أستطيع فعله

288
00:23:16,350 --> 00:23:22,400
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

289
00:23:31,860 --> 00:23:33,490
داي، البطل الصّغير

290
00:23:34,030 --> 00:23:39,710
كانت مُغامرته مع أصدقائه مليئة
بالمعارك ضدّ أعداء أقوياء

291
00:23:39,870 --> 00:23:42,960
في الحلقة القادمة، نظرة للخلف
إلى درب مُغامرة داي

292
00:23:43,130 --> 00:23:45,500
!وتستمرّ المغامرة