1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:51,520 --> 00:01:53,780
!ضربة صليب إمبراطور النجوم

20
00:02:26,100 --> 00:02:28,770
!كـ-كروكوداين

21
00:02:33,650 --> 00:02:36,150
وجدتني يا كروكوداين

22
00:02:36,320 --> 00:02:39,200
أعلم جيّداً كم أنت عنيد

23
00:02:40,450 --> 00:02:43,410
!لكن من الحماقة أن تستهدفني بمفردي

24
00:02:43,580 --> 00:02:46,790
!ما زلتُ أخفي خطّة في جُعبتي

25
00:02:46,950 --> 00:02:48,040
لا تُخفي شيئاً

26
00:02:48,580 --> 00:02:54,710
أعرفك خير معرفة. بعد كلّ ذلك سوف
تهرب إلى مكان بعيد جدّاً

27
00:02:54,880 --> 00:03:00,970
حقيقة زحفك إلى هنا هي دليل على
أنّ طاقتك السحريّة وأدواتك قد نفدت

28
00:03:01,130 --> 00:03:05,680
هذا يعني أنّ هجمة لون بيروك استنزفت قوّتك السحريّة

29
00:03:05,850 --> 00:03:07,850
وبالكاد تستطيع النّجاة

30
00:03:08,730 --> 00:03:10,600
!نفدت خياراتك تماماً الآن

31
00:03:12,520 --> 00:03:15,360
!اللّعنة عليك أيُّها التّمساح الوغد

32
00:03:15,520 --> 00:03:18,320
!متى أصبحت ذكيّاً هكذا؟

33
00:03:18,820 --> 00:03:22,280
!عليّ فعل شيء ما! لا بدّ من وجود طريقة

34
00:03:22,740 --> 00:03:27,120
!لا يمكن أن أخسر في معركة ذكاء مع هذا الأبله

35
00:03:27,290 --> 00:03:31,960
!إنّه مجرّد ساذج! هذه فُرصتي! لا بدّ من وجود سبيل

36
00:03:33,330 --> 00:03:35,880
زابويرا... قد انتهى

37
00:03:42,050 --> 00:03:42,930
كروكوداين

38
00:03:44,050 --> 00:03:47,720
معك حقّ. نفدت خياراتي

39
00:03:47,890 --> 00:03:52,230
لا أملك خياراً سوى الموت على يدك هنا

40
00:03:52,640 --> 00:03:58,020
نظراً إلى كلّ ما فعلتُه، هذا طبيعيّ

41
00:03:58,400 --> 00:04:00,940
!لكن كلّ ما فعلتُه كان لأنّني خائف

42
00:04:01,110 --> 00:04:05,820
!مقارنة بقادة الفيلق الآخرين، كنتُ ضعيفاً للغاية

43
00:04:05,990 --> 00:04:11,960
كان اللّجوء للمخطّطات الطريقة الوحيدة
!الّتي أستطيع النّجاة بها

44
00:04:12,120 --> 00:04:12,960
...زابويرا

45
00:04:13,120 --> 00:04:16,540
،بهزيمة الزومبي الشّيطان الخارق

46
00:04:16,960 --> 00:04:21,670
أدركتُ بأنّني لا أستطيع النّجاة
دون الاعتماد على الآخرين

47
00:04:22,090 --> 00:04:25,640
...الآن بعد أن عرفتُ ذلك، أتوسّل إليك

48
00:04:25,800 --> 00:04:27,680
!اعفُ عنّي أرجوك

49
00:04:27,850 --> 00:04:31,480
!أقسم بأنّني لن أساعد جيش الشّياطين ثانية

50
00:04:31,640 --> 00:04:34,270
!أنت الوحيد الّذي أستطيع الوثوق به

51
00:04:35,060 --> 00:04:40,030
!تخلّى عنّي جيش الشّياطين والبشر لن يقبلوني

52
00:04:40,440 --> 00:04:41,360
!أتوسّل إليك

53
00:04:48,490 --> 00:04:53,910
تماماً أيّها السّخيف السّاذج. اِبقَ مُشوَّشاً هكذا

54
00:04:56,750 --> 00:05:00,550
صحيح، لم يتبقَّ لي أيّ قوّة سحريّة أو لياقة

55
00:05:00,710 --> 00:05:05,720
لكن ما زالت لديّ مئات السّموم
الّتي تتدفّق في جسدي

56
00:05:06,130 --> 00:05:11,680
مزجتُ للتو سُمّاً سيحوّله إلى دُمية لي

57
00:05:12,390 --> 00:05:14,810
مجرّد خدش وأنتصر

58
00:05:14,980 --> 00:05:18,730
!هيّا! اسقط في الفخّ يا كروكوداين

59
00:05:21,230 --> 00:05:23,070
حسناً يا زابويرا

60
00:05:23,740 --> 00:05:24,490
تعال

61
00:05:26,200 --> 00:05:29,030
!وقعتَ في الفخّ أيُّها الأحمق

62
00:05:29,200 --> 00:05:32,700
!أنت حقّاً ساذج ميؤوس منه أيّها الأبله

63
00:05:32,870 --> 00:05:37,620
!لا، أنت مجرّد موطئ قدم تجاه حياتي الجديدة

64
00:05:38,750 --> 00:05:39,500
!نلتُ منك

65
00:05:42,550 --> 00:05:44,210
مِقبض فأسه...؟

66
00:05:49,680 --> 00:05:52,970
!أيُّها الحقير! كنتَ تُمثّل

67
00:05:54,980 --> 00:05:56,270
!كروكوداين

68
00:05:56,430 --> 00:05:57,690
زابويرا

69
00:05:57,850 --> 00:06:02,820
قد لا أكون ذكيّاً، لكن تعلّمتُ شيئاً واحداً منك

70
00:06:03,230 --> 00:06:04,150
...وهو

71
00:06:04,320 --> 00:06:08,950
!في هذا العالم، بعض الأشخاص لا أمل منهم

72
00:06:09,320 --> 00:06:11,700
--انتظر لحظة! كروكود

73
00:06:20,830 --> 00:06:23,300
!كروكوداين

74
00:06:25,420 --> 00:06:28,720
!هزمتَ هذا العفريت العجوز أخيراً إذاً

75
00:06:29,430 --> 00:06:34,600
!لم يكن داخل الزّومبي لذا كنّا نبحث عنه

76
00:06:34,760 --> 00:06:37,520
!حسناً! أحسنت صنعاً

77
00:06:42,230 --> 00:06:43,400
كروكوداين؟

78
00:06:43,980 --> 00:06:44,980
...أيُّها العجوز

79
00:06:45,570 --> 00:06:49,030
،آنذاك عندما كان هناك قادة الفيالق الستّة

80
00:06:49,200 --> 00:06:52,780
قوّة السّحر العظيمة الخاصّة بزابويرا
جعلَتْه شخصاً مُوقَّراً

81
00:06:53,240 --> 00:06:58,080
لكن عندما أعمَتْه طموحاته، ولم يفعل
،شيئاً سوى استغلال الآخرين

82
00:06:58,250 --> 00:07:02,210
أصبحَ طُفيليّاً وضيعاً في نهاية المطاف

83
00:07:02,790 --> 00:07:04,880
لو كان مثل داي فحسب

84
00:07:05,050 --> 00:07:10,220
...وتولّدت لديه ذرّة رغبة في التطوّر من خلال قوّته

85
00:07:10,680 --> 00:07:13,090
الطمع صفة فظيعة

86
00:07:13,600 --> 00:07:18,310
لو لم أكن أوّل من يقاتل داي، فمن
يعلم ماذا كنتُ لأصبح؟

87
00:07:18,480 --> 00:07:23,060
كان زابويرا تجسيداً للقذارة. ولذلك أشفق عليه

88
00:07:25,150 --> 00:07:27,650
أنت رجل مُحترم يا صديقي

89
00:07:28,610 --> 00:07:31,400
لكنّه ليس مثلك

90
00:07:31,570 --> 00:07:37,410
،حتّى لو ظلَّ صديقي، ملك الوحوش البرّية عدوّاً

91
00:07:37,580 --> 00:07:42,620
كان ليخاطر بحياته ليحسّن نفسه
ويغدو جديراً بالاحترام

92
00:07:42,790 --> 00:07:44,000
هذا رأيي على الأقلّ

93
00:07:45,170 --> 00:07:46,090
...العجوز

94
00:07:47,960 --> 00:07:49,050
شكراً لك

95
00:07:49,760 --> 00:07:52,220
هيّا بنا... نعود إلى الآخرين

96
00:07:59,600 --> 00:08:01,020
!هل هو شيطان؟

97
00:08:01,180 --> 00:08:03,560
!لا يمكننا الفوز! إنّه قويّ للغاية

98
00:08:03,730 --> 00:08:05,730
...حتّى بكلّ هذه الأعداد

99
00:08:08,110 --> 00:08:10,740
!يجب علينا الانقضاض عليه معاً

100
00:08:10,900 --> 00:08:13,110
استسلموا. لا جدوى من ذلك

101
00:08:13,700 --> 00:08:14,660
!ماذا؟

102
00:08:14,820 --> 00:08:16,070
!من قال ذلك؟

103
00:08:19,330 --> 00:08:21,450
هذا الشّخص لي

104
00:08:22,460 --> 00:08:26,790
مهما تكاثرتُم عليه، لن تنتصروا

105
00:08:27,420 --> 00:08:30,460
إنّه فريستي. لا يحظى به أحد

106
00:08:30,630 --> 00:08:31,460
!هيم؟

107
00:08:31,920 --> 00:08:33,630
ما بك يا هيونكل؟

108
00:08:33,800 --> 00:08:37,260
تبدو كطائر أصيبَ بواسطة أنبوب رِماية

109
00:08:37,680 --> 00:08:41,850
بحسب معلوماتي، لم تُشعرك رؤية وجهي بأيّ شيء

110
00:08:42,310 --> 00:08:45,270
!هل أنت البيدق هيم حقّاً؟

111
00:08:45,440 --> 00:08:51,280
صنعَ هادلَر حرسه الملكيّين باستخدام
سحر مُحرَّم على قطع من الأوريكالكوم

112
00:08:51,990 --> 00:08:56,110
بصيغة أخرى، الآن بعد أن مات هادلَر
،وتوقّف جريان طاقته السحريّة

113
00:08:56,280 --> 00:08:59,950
!لا ينبغي أن تبقى على قيد الحياة

114
00:09:00,120 --> 00:09:01,620
!فلماذا إذاً؟

115
00:09:01,790 --> 00:09:03,330
لا أعلم

116
00:09:04,960 --> 00:09:09,630
بعد أن هزمتني، سقطتُ أرضاً من قصر فارن

117
00:09:09,790 --> 00:09:12,760
كان ينبغي أن أموت حتماً

118
00:09:14,220 --> 00:09:17,890
شعرتُ بوعيي ينسلّ نحو الظّلام

119
00:09:20,180 --> 00:09:24,430
شعرتُ شعور الموت بحدّ ذاته

120
00:09:25,310 --> 00:09:26,350
...لكن

121
00:09:26,520 --> 00:09:31,150
من خلال ذلك الظّلام، دوى شيء في داخلي

122
00:09:32,070 --> 00:09:37,450
كانت صيحات أصدقائي ومولايّ هادلَر
المُحتضرين في معركتهم الأخيرة

123
00:09:38,280 --> 00:09:42,200
عرفتُ بأنّ أصدقائي ماتوا. وبأنّ مولايّ هادلَر قد مات

124
00:09:43,200 --> 00:09:45,580
كنّا قد خسرنا جميعاً

125
00:09:47,540 --> 00:09:50,540
...في تلك اللّحظة، من أعماق قلبي

126
00:09:51,170 --> 00:09:52,750
!شعرتُ بأنّني لا يمكن أن أموت

127
00:09:52,920 --> 00:09:54,880
...حتّى لو لم يبقَ غيري

128
00:09:55,510 --> 00:10:01,720
توجّبَ عليّ مواصلة العيش وحمل
!إرادة مولايّ هادلَر وأصدقائي

129
00:10:04,100 --> 00:10:10,150
ترتّبَ عليّ ردّ الاعتبار منكم وإلّا
!سيذهب موتي هباء

130
00:10:14,230 --> 00:10:15,440
هكذا الأمر إذاً

131
00:10:16,360 --> 00:10:20,160
عندما استفقت، كانت الفجوة في صدري قد زالت

132
00:10:20,320 --> 00:10:21,530
!إنّها مُعجزة

133
00:10:21,700 --> 00:10:24,990
!مُعجزة صنعَتْها روح خالدة

134
00:10:25,660 --> 00:10:30,330
إذاً لم يعُد هيم دُمية تتحكّم بها
قوّة هادلَر السحريّة؟

135
00:10:30,500 --> 00:10:31,960
!أيُعقَل...؟

136
00:10:33,710 --> 00:10:36,760
لوهلة تساءلتُ من يكون

137
00:10:36,920 --> 00:10:40,470
!تبيّن بأنّه ذلك الفاشل، العبد الوضيع لهادلَر

138
00:10:40,640 --> 00:10:46,180
إذاً هذا الفاشل الّذي على شفير الموت
!يريد أن يحلّ مكاننا؟ يا للمهزلة

139
00:10:46,350 --> 00:10:49,770
!سنقضي عليك قبل تلاميذ آفان

140
00:10:49,940 --> 00:10:51,900
!مُت يا قطعة الخردة

141
00:10:55,940 --> 00:11:00,030
حمقى. كنتُ لأدعكم على قيدِ الحياة
لو ابتعدتُم عن طريقي

142
00:11:01,450 --> 00:11:04,740
!لكن الآن، يبدو أنّني لا أستطيع

143
00:11:06,200 --> 00:11:08,290
اعترضتُم طريقي بلا شكّ

144
00:11:08,450 --> 00:11:14,210
...لكن أن تستخفّ وتهين حثالة مثلكم بمولايّ هادلَر

145
00:11:14,380 --> 00:11:17,210
!فلن أغفر لكم على الإطلاق

146
00:11:46,530 --> 00:11:48,450
!شـ-شعر فضّي؟

147
00:11:48,620 --> 00:11:50,210
...هيم يشبه

148
00:11:50,960 --> 00:11:52,120
!هادلَر

149
00:12:58,360 --> 00:12:59,230
...هذا

150
00:13:18,330 --> 00:13:21,300
لمَ عليّ القيام بهذا؟

151
00:13:22,130 --> 00:13:25,800
...هذا تقريباً يشبه مولايّ هادلَر

152
00:13:26,800 --> 00:13:27,760
...هيم

153
00:13:27,930 --> 00:13:32,060
أظنّك أكثر من يشبهني

154
00:13:34,850 --> 00:13:37,150
!وكأنّها إعادة تجسيد لهادلَر

155
00:13:37,480 --> 00:13:41,650
!وتلك الطاقة التي بعثَها هيم كانت هالة بالتأكيد

156
00:13:41,820 --> 00:13:43,860
الهالة هي طاقة حياة

157
00:13:44,030 --> 00:13:48,240
لا ينبغي لدُمية مُشبعة بحياة اصطناعيّة
أن تتمكّن من استخدامها

158
00:13:48,410 --> 00:13:49,240
!هذا صحيح

159
00:13:49,620 --> 00:13:53,330
!هيم الآن هو كائن حيّ فرديّ جديد

160
00:13:53,830 --> 00:13:56,870
!لا بُدّ وأنَّ حياة هادلَر قد دخلتْ هيم

161
00:13:57,790 --> 00:14:00,500
!في نفس الوقت، إنّها ولادة عدوّ قويّ

162
00:14:00,670 --> 00:14:03,250
لن تُجدي هجماتنا الهوائيّة بعد الآن

163
00:14:03,420 --> 00:14:08,470
...وهجمات الهالة من جسده المصنوع من الأوريكالكوم

164
00:14:09,220 --> 00:14:12,810
!ستكون بقوّة نصل الهالة الخاص بداي

165
00:14:14,100 --> 00:14:15,140
...والآن

166
00:14:15,890 --> 00:14:18,060
فلنبدأ يا هيونكل

167
00:14:18,520 --> 00:14:21,400
يبدو أنّك بالكاد تستطيع الوقوف

168
00:14:22,440 --> 00:14:27,240
برغم ضعفهم، قاتلتَ كلّ أولئك
الأعداء. لا بُدّ وأنَّك مُستنزَف

169
00:14:27,780 --> 00:14:29,860
لكن لن أتحفّظ البتّة

170
00:14:30,370 --> 00:14:34,990
!بالنسبة لي، أنت عقبة لا بُدَّ من استئصالها

171
00:14:35,370 --> 00:14:38,540
شعرتُ بذلك من أوّل مرّة تقاتلنا فيها

172
00:14:39,210 --> 00:14:42,630
،منذ أن وهبَني مولايّ هادلَر كلّ شيء لهزيمة داي

173
00:14:42,790 --> 00:14:45,550
ليس لي إلّا هدفاً واحداً في هذا العالم

174
00:14:46,010 --> 00:14:48,470
!وهو أنت يا هيونكل

175
00:14:50,590 --> 00:14:51,680
!خذ هذه

176
00:14:51,840 --> 00:14:55,350
...منّي ومن كلّ الحرس الملكيّ

177
00:14:55,520 --> 00:14:57,520
...كلّ كبريائنا وغضبنا

178
00:14:57,890 --> 00:14:59,980
!في هذه القبضة

179
00:15:18,160 --> 00:15:19,040
شكراً

180
00:15:19,210 --> 00:15:21,540
أبليتَ حسناً يا غارودا

181
00:15:22,920 --> 00:15:26,590
تمكنّا من الدِّفاع عن دائرة السّحر

182
00:15:27,210 --> 00:15:29,840
أحسنتم صنعاً جميعاً

183
00:15:30,630 --> 00:15:35,600
بدائرة السّحر هذه، يمكننا إرسال المساعدة
إلى قصر فارن في أيّ وقت

184
00:15:36,060 --> 00:15:40,690
،وإذا تأذّى أيّ شخص من فريق داي
يمكننا إعادته إلى هنا

185
00:15:40,850 --> 00:15:45,190
!هذا صحيح! لم يعُد يُحيط بقصر فارن أيّ حاجز

186
00:15:45,650 --> 00:15:50,740
معنى ذلك أنّ أيّ شخص يستطيع التّحليق
!يمكنه الوصول إلى قصر فارن

187
00:15:50,900 --> 00:15:55,530
رغم ذلك، نحن مُرهَقون من معركة
الدّفاع عن دائرة السّحر

188
00:15:55,700 --> 00:15:58,410
لا يوجد أحدٌ سليم صحّياً بما يكفي لإرساله

189
00:16:00,540 --> 00:16:01,250
!حسناً

190
00:16:02,330 --> 00:16:03,790
!دعوا هذا الأمر لي

191
00:16:06,380 --> 00:16:09,130
هذا صحيح -
ما زالت روحه تنبض بالحيويّة -

192
00:16:09,300 --> 00:16:12,380
!أصدقائي! سنواجه ملك الشّياطين فارن

193
00:16:12,550 --> 00:16:17,310
إرسال الجرحى أو الضّعفاء لن يؤدّي
!إلّا إلى وقوع المزيد من الضّحايا

194
00:16:17,930 --> 00:16:23,060
ومن المغاوير، فقط بابي وباتاكو ودونادونا
من يستطيعون التّحليق

195
00:16:23,230 --> 00:16:26,020
إنّه الأضعف بيننا غالباً

196
00:16:26,190 --> 00:16:26,900
صحيح

197
00:16:27,440 --> 00:16:31,070
من الواضح بأنّني أنا من سيذهب
بصِفتي قائد المغاوير

198
00:16:31,240 --> 00:16:32,450
!لذا بقي اثنان

199
00:16:32,610 --> 00:16:36,530
حالما نختار عضوين آخرين، سنترك
!هذا المكان لكم جميعاً

200
00:16:37,030 --> 00:16:39,040
سيّد كروكوداين، ستذهب، صحيح؟

201
00:16:39,200 --> 00:16:41,500
بالطبع! وهل من حاجة للسؤال؟

202
00:16:41,660 --> 00:16:45,250
...آسف. ليتني أستطيع الذّهاب، لكن

203
00:16:45,420 --> 00:16:49,960
لا بأس. عليك أن تعتني بلون بيروك

204
00:16:50,550 --> 00:16:54,630
بقي شخص واحد. ويُفضّل أن يكون
...قادراً على الشّفاء

205
00:16:54,800 --> 00:17:03,100
!أنا، أنا، أنا، أنا، أنا، أنا

206
00:17:03,890 --> 00:17:06,810
...لا أعرف السّبب، لكن أشعر بضغط هائل

207
00:17:07,610 --> 00:17:09,520
!أختار السيّد وحش

208
00:17:10,320 --> 00:17:11,480
...لكن

209
00:17:11,650 --> 00:17:14,240
!حسناً! صاروا ثلاثة

210
00:17:14,400 --> 00:17:15,280
!على ذكر الأمر

211
00:17:16,320 --> 00:17:17,070
!يا رفاق

212
00:17:17,240 --> 00:17:20,990
تخلّصوا من أيّ أداة شفاء لديكم هنا

213
00:17:30,290 --> 00:17:32,760
!سيّد كروكوداين، بسرعة

214
00:17:32,920 --> 00:17:33,840
!حسناً

215
00:17:37,220 --> 00:17:38,470
!نعتمد عليكم

216
00:17:39,930 --> 00:17:43,310
أعتقد لا يمكنني التوقّف عن تقديم الشّفاء لميرلي

217
00:17:43,470 --> 00:17:44,730
...هذا مؤسف، لكن

218
00:17:45,810 --> 00:17:46,890
...هيونكل

219
00:17:55,950 --> 00:17:58,240
من جديد، عدتُ إلى هنا

220
00:17:58,860 --> 00:18:01,580
!لكن في هذا الوقت تحديداً لن أخسر

221
00:18:02,330 --> 00:18:04,540
هذا هو قصر فارن إذاً

222
00:18:04,700 --> 00:18:05,410
تشيو

223
00:18:06,000 --> 00:18:08,620
ينبغي أن نرسل هؤلاء الثّلاثة

224
00:18:08,790 --> 00:18:10,630
أنت على حقّ غالباً

225
00:18:10,790 --> 00:18:11,960
!أحسنتم صنعاً جميعاً

226
00:18:12,130 --> 00:18:17,050
عودوا إلى وادي لوروي وانتظروا
!عودتنا مع الآخرين

227
00:18:17,680 --> 00:18:22,390
!لا تقلقوا! أعِدُكم بأنّنا سننتصر ونعود إليكم

228
00:18:22,560 --> 00:18:23,600
!أنا لا أكذب أبداً

229
00:18:24,180 --> 00:18:26,350
!أقسم بشارتي كمغوار

230
00:18:32,270 --> 00:18:36,360
ما زال ضعيفاً، لكنّه رحِب الصّدر

231
00:18:37,240 --> 00:18:41,320
قد يصبح هذا القزم الصّغير شخصاً عظيماً يوماً ما

232
00:18:41,780 --> 00:18:42,910
!حسناً إذاً

233
00:18:43,410 --> 00:18:45,370
أين الآخرون يا تُرى؟

234
00:18:54,800 --> 00:18:58,050
كانت ضربة مُوفّقة، أليس كذلك يا هيونكل؟

235
00:19:01,300 --> 00:19:04,890
!لم أستطع الاستجابة لذلك إطلاقاً

236
00:19:05,060 --> 00:19:07,600
!سرعة وقوّة هيم لا يمكن مُجاراتهما

237
00:19:07,770 --> 00:19:12,230
هذه هالة إذاً. يا لها من قدرة رائعة

238
00:19:12,650 --> 00:19:16,820
وكأنّ غضبي المُتصاعد يتحوّل بشكل
!مُباشر إلى قوّة

239
00:19:20,360 --> 00:19:24,450
لا تقل لي بأنّ الأمر انتهى بهذه السّرعة

240
00:19:24,620 --> 00:19:26,580
!ماذا لديك لي غير ذلك؟

241
00:19:31,290 --> 00:19:33,170
...أعتقد أنّ الأمر انتهى حقّاً

242
00:19:33,330 --> 00:19:34,920
حتّى بالنسبة لك

243
00:19:35,540 --> 00:19:36,710
!هذا مستحيل

244
00:19:37,170 --> 00:19:41,380
،بكلّ الهالة التي أنفقتُها في القتال

245
00:19:41,840 --> 00:19:47,770
!لستُ ندّاً لهيم بمقدار الهالة الحديثة الفيّاضة هذا

246
00:19:48,770 --> 00:19:52,190
كيف لي أن أقاتل؟ كيف؟

247
00:19:54,900 --> 00:19:58,650
!لا! أفقد الإحساس بجسدي

248
00:20:00,030 --> 00:20:03,320
!لا أحتمل الخسارة هنا

249
00:20:06,030 --> 00:20:08,620
...دي... بوب

250
00:20:10,160 --> 00:20:12,540
...مام

251
00:20:22,550 --> 00:20:26,180
...هيونكل... هيونكل

252
00:20:28,010 --> 00:20:29,310
...هيونكل

253
00:20:33,560 --> 00:20:36,610
!هيّا! انهض فحسب

254
00:20:37,270 --> 00:20:38,440
!هيونكل

255
00:20:44,490 --> 00:20:45,740
هيونكل

256
00:20:46,070 --> 00:20:49,660
ما زلتَ لا تنفّذ ما أمليتُه عليك

257
00:20:50,200 --> 00:20:53,040
ما... أمليتَه عليّ؟

258
00:20:53,210 --> 00:20:54,420
أجل

259
00:20:54,580 --> 00:20:59,000
إنَّ الهزيمة بعد تجربة كلّ شيء
ليست شيئاً يدعو للخجل

260
00:20:59,920 --> 00:21:04,630
لكن ما زال هناك ما تستطيع فعله

261
00:21:05,630 --> 00:21:10,220
إذا كنتَ ستخسر، فجرّب كلّ شيء أوّلاً ثمّ اخسر

262
00:21:11,390 --> 00:21:15,730
خِلاف ذلك، لن تصبح نسخة أقوى من نفسك

263
00:21:16,350 --> 00:21:20,820
ابذل كلّ ما لديك وقاتل حتّى النّهاية

264
00:21:20,980 --> 00:21:23,570
هذا ما يصنع المُحارب الحقيقيّ

265
00:21:34,120 --> 00:21:38,830
هذا صحيح! هكذا يجب أن يكون
الأمر يا مُنافسي الأبديّ

266
00:21:39,000 --> 00:21:40,670
هذا غريب جدّاً

267
00:21:41,710 --> 00:21:43,380
كنتُ أمقته

268
00:21:44,220 --> 00:21:46,970
وحتّى أنّني أردتُ قتله ذات مرّة

269
00:21:50,100 --> 00:21:51,470
...مُعلّم

270
00:21:51,890 --> 00:21:55,520
كلّما سقطت، يجعلني شيء ما أنهض من جديد

271
00:21:55,890 --> 00:21:58,650
!لطالما كنتَ أنت دوماً

272
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

273
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

274
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

275
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

276
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

277
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

278
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

279
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

280
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

281
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

282
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

283
00:23:34,120 --> 00:23:38,250
عادَ هيم من شفير الموت ليظهر أمام هيونكل

284
00:23:38,410 --> 00:23:43,580
أُشبِعَ هيم بروحِ هادلَر وتطوّر إلى محارب عظيم

285
00:23:43,750 --> 00:23:46,960
،بعد إنفاق كلّ هالته، يعاني هيونكل

286
00:23:47,130 --> 00:23:49,260
لكنّه يجازف المُجازفة الأخيرة في نهاية المطاف

287
00:23:49,420 --> 00:23:50,880
هيونكل أم هيم

288
00:23:51,050 --> 00:23:54,180
من يمتلك الإرادة الأقوى؟

289
00:23:54,350 --> 00:23:56,600
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

290
00:23:58,430 --> 00:24:00,560
!وتستمرّ المغامرة