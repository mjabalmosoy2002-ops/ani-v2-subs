1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:53,360 --> 00:01:57,860
أفضّل الموت على تشكيل عبء على داي والآخرين

20
00:01:58,030 --> 00:01:59,740
لعلّك على حقّ

21
00:02:00,990 --> 00:02:05,830
تنتمي حياتي لهم، لكن إذا كان هذا
...سيشكّل عبئاً عليهم

22
00:02:06,370 --> 00:02:08,250
!أرجوك! لا تذهب

23
00:02:09,330 --> 00:02:12,290
!أرجوك توقّف عن السّير بسرور نحو أحضان الموت

24
00:02:16,420 --> 00:02:20,550
ستُعدَمان بعد يومين ظهراً

25
00:02:20,720 --> 00:02:23,560
!حسناً! اقتلونا فحسب

26
00:02:23,720 --> 00:02:28,940
!نفضّل الموت على استخدامنا في مكيدة ما

27
00:02:30,940 --> 00:02:34,900
لكنّ المُحاربين أمثالكما قيّمون

28
00:02:35,070 --> 00:02:37,400
لا سيّما أنت يا هيونكل

29
00:02:41,700 --> 00:02:45,990
اقبل هذه الهالة الشيطانيّة واخدمني

30
00:02:46,950 --> 00:02:48,290
!إنّه يهدر وقته

31
00:02:50,370 --> 00:02:52,080
دعني أفكّر في الأمر

32
00:02:52,250 --> 00:02:52,960
!ماذا؟

33
00:02:53,340 --> 00:02:54,840
حسناً

34
00:02:56,460 --> 00:02:59,050
!هيونكل! أيّها الوغد

35
00:03:03,680 --> 00:03:08,480
!هل ستبيع روحك لميستوفارن كي تعيش؟

36
00:03:09,020 --> 00:03:10,390
...ظننتُ

37
00:03:10,770 --> 00:03:15,940
!ظننتُك رجلاً جديراً بالاحترام

38
00:03:16,110 --> 00:03:19,740
!ظننتُك صديقي

39
00:03:20,320 --> 00:03:25,120
!لم أتوقّع أن تخوننا في اللّحظات الأخيرة

40
00:03:27,160 --> 00:03:28,540
كروكوداين

41
00:03:29,290 --> 00:03:31,750
...إذا كنت تعتبرني صديقك

42
00:03:31,920 --> 00:03:34,960
فأحتاجك أن تثق بي مهما كلّف الأمر

43
00:03:35,130 --> 00:03:36,590
!ماذا؟

44
00:03:37,000 --> 00:03:39,050
لا مانع أن أموت مُعتزّاً

45
00:03:39,380 --> 00:03:44,680
...لكن ينتابني إحساس جديد. حتّى اللّحظة الأخيرة

46
00:03:46,350 --> 00:03:50,270
أريد التشبّث بفرصة للبقاء

47
00:04:06,320 --> 00:04:07,780
ارحل

48
00:04:18,210 --> 00:04:19,590
...أنا

49
00:04:19,760 --> 00:04:21,130
ماذا...؟

50
00:04:23,220 --> 00:04:24,970
!علينا إنقاذهما

51
00:04:25,430 --> 00:04:26,680
بالطبع

52
00:04:26,850 --> 00:04:30,060
لكن من الواضح أنّ إعلان الإعدام هذا فخّ

53
00:04:30,850 --> 00:04:35,480
مع علمنا بذلك، يجب أن نكون مستعدّين
لتسخير كافّة قوّاتنا

54
00:04:36,560 --> 00:04:40,570
!سأفعل المستحيل! فالعالم سيفنى على أيّ حال

55
00:04:42,780 --> 00:04:48,200
يجب علينا أن نزحف بجيشنا تحت
راية البطل من جديد

56
00:04:49,030 --> 00:04:53,960
أجل! حالما يصحو داي، لندعه يلقي
!خطبة على مسامع الجميع

57
00:04:55,670 --> 00:04:57,670
،إن كان مستعدّاً لفعل ذلك

58
00:04:57,830 --> 00:05:01,590
!فأنا متأكّد أنّ الجميع سيتحمّسون للقتال ثانية

59
00:05:01,760 --> 00:05:05,220
!أجل. داي هو بطل أمل الجميع

60
00:05:05,380 --> 00:05:07,050
معك حقّ -
أجل -

61
00:05:07,220 --> 00:05:09,550
!أنا متأكّدة أنّه سيمدّ الجميع بالشجاعة

62
00:05:10,970 --> 00:05:12,680
...جميعهم

63
00:05:12,850 --> 00:05:15,140
!ما زالوا يريدونني أن أستمرّ في القتال

64
00:05:15,310 --> 00:05:17,690
!سأذهب وأطمئنّ على داي

65
00:05:19,940 --> 00:05:21,320
انظر يا غوميتشان

66
00:05:21,940 --> 00:05:27,740
انظر كم يمتلك مغاوير ملك الوحوش
البرّية من أعضاء الآن

67
00:05:27,910 --> 00:05:30,830
!لدينا حتّى عشرة أعضاء الآن

68
00:05:42,300 --> 00:05:44,920
!حالة طارئة! داي اختفى

69
00:05:45,380 --> 00:05:46,630
!ماذا؟

70
00:05:53,140 --> 00:05:57,690
لماذا يتأمّل منّي الجميع أن أفعل المستحيل؟

71
00:06:01,610 --> 00:06:04,320
قوّتي غير كافية

72
00:06:05,690 --> 00:06:07,900
!أنا عاجز عن فعل شيء

73
00:06:09,490 --> 00:06:13,200
!فخامة البطل

74
00:06:13,370 --> 00:06:15,540
!أين أنت يا داي؟

75
00:06:15,700 --> 00:06:18,790
...لا أصدّق أنّ داي هرب

76
00:06:18,960 --> 00:06:22,340
لا يمكنك لومه. ما زال طفلاً

77
00:06:22,500 --> 00:06:26,880
فقدَ والده أمام ناظريه مع سلاحه الأعظم

78
00:06:27,510 --> 00:06:32,140
إذا كان هذا ما يدور في ذهنه، فلماذا لم يتكلّم معنا؟

79
00:06:32,300 --> 00:06:36,140
لأنّه لا يفهم تماماً ما يعذّبه

80
00:06:37,480 --> 00:06:40,270
لم يهرب خشية من المعركة

81
00:06:41,270 --> 00:06:47,820
يخشى وزن لقبه. يخشى عدم معرفته
بما إن كان يستطيع الارتقاء لذلك

82
00:06:48,950 --> 00:06:55,040
لكن، بقدر ما هو أمر قاسٍ، لن يكون بطلاً
حقيقيّاً إذا لم يستطع التغلّب على نفسه

83
00:06:55,370 --> 00:06:56,620
!أنتِ مخطئة

84
00:06:57,910 --> 00:06:59,830
!إنّه بطل حقيقيّ

85
00:07:08,090 --> 00:07:09,840
ما الأمر؟

86
00:07:10,340 --> 00:07:11,380
ما خطبكِ؟

87
00:07:12,180 --> 00:07:14,470
لعلّ أمرنا قد انتهى

88
00:07:15,350 --> 00:07:18,100
لا أصدّق أن يتركنا داي

89
00:07:23,690 --> 00:07:25,610
يا إلهي

90
00:07:25,770 --> 00:07:29,570
"في البداية داي، والآن لدينا "خارج إطار الشخصيّة، الجزء 2

91
00:07:29,740 --> 00:07:34,070
لم أتوقّع أن أراكِ واهنة باكية إطلاقاً

92
00:07:34,240 --> 00:07:36,200
لا أحد يعلم ما الّذي ينتظرنا في الحياة

93
00:07:36,370 --> 00:07:38,200
!كفاك سخرية أيّها الأحمق

94
00:07:42,210 --> 00:07:43,710
لا تقلقي

95
00:07:44,540 --> 00:07:47,920
لا شيء يدعو للقلق

96
00:07:48,090 --> 00:07:49,420
!انظري إليّ فحسب

97
00:07:49,590 --> 00:07:54,220
أوّل شخص يهرب من الخطر ما زال واقفاً هنا

98
00:07:57,100 --> 00:07:58,720
لذا ستكون الأمور بخير

99
00:07:58,890 --> 00:08:02,440
رفقة هيونكل والضّخم، وبالطبع داي

100
00:08:03,650 --> 00:08:04,940
بوب

101
00:08:05,480 --> 00:08:07,940
سألقي نظرة في مكان آخر

102
00:08:12,820 --> 00:08:15,950
ربّما استخدم "عودة" للابتعاد؟

103
00:08:16,700 --> 00:08:18,330
عودة؟

104
00:08:28,750 --> 00:08:31,630
إذاً أنا في تيران

105
00:08:31,800 --> 00:08:33,550
!إله التّنانين

106
00:08:33,720 --> 00:08:38,010
!أرجوك! عسى أن يهزمَ البطلُ العظيم ملكَ الشّياطين

107
00:08:41,020 --> 00:08:43,140
!أرجوك! أيّها البطل العظيم

108
00:08:44,140 --> 00:08:45,650
أنا آسف

109
00:08:45,810 --> 00:08:47,440
أنا آسف جدّاً

110
00:08:47,610 --> 00:08:50,280
لا أستطيع تلبية صلواتك

111
00:08:50,570 --> 00:08:53,030
خادم إلهك أخبرني

112
00:08:53,990 --> 00:08:57,370
ملك الشّياطين فارن أقوى من إله

113
00:08:57,990 --> 00:09:02,250
لا يستطيع أحد لمسه

114
00:09:08,040 --> 00:09:09,750
...ماذا ينبغي لي

115
00:09:12,260 --> 00:09:14,380
ماذا ينبغي لي أن أفعل؟

116
00:09:23,680 --> 00:09:27,230
حالياً، أظنّك تستطيع البكاء قليلاً

117
00:09:41,030 --> 00:09:42,040
بوب

118
00:09:43,200 --> 00:09:45,120
سأنضمّ لك

119
00:09:45,290 --> 00:09:48,670
المشي تحت ضوء القمر قد يفيدك

120
00:10:08,230 --> 00:10:12,070
كيف عرفت بأنّني هنا؟

121
00:10:13,900 --> 00:10:15,990
مهلاً، لا تنسَ

122
00:10:16,150 --> 00:10:21,620
كنتُ رفقتك منذ البداية في جزيرة ديرملين

123
00:10:21,780 --> 00:10:25,540
لذا لا يوجد مكان يمكنك الذّهاب إليه ولا يمكنني أنا

124
00:10:25,700 --> 00:10:29,870
تعويذات عودة مقتصرة على الأماكن التي زرتها

125
00:10:32,170 --> 00:10:36,010
فضلاً عن ذلك، عندما كنتُ أتعوّد
...على استخدام تعويذة عودة

126
00:10:36,380 --> 00:10:39,010
انتهى المطاف بي في مكان مهمّ بالنسبة لي

127
00:10:39,930 --> 00:10:42,930
غابة الشّياطين التي التقينا فيها بمام أوّل مرّة

128
00:10:45,560 --> 00:10:51,440
لذا ارتأيتُ أنّ نفس الشيء سيحدث
إذا حلّقتَ بعيداً بشكل عشوائي

129
00:10:52,560 --> 00:10:56,610
هذا هو المكان الّذي التقيتَ فيه بأبيك أوّل مرّة

130
00:10:59,320 --> 00:11:00,490
لستَ غاضباً؟

131
00:11:02,450 --> 00:11:03,700
...أنا

132
00:11:05,370 --> 00:11:07,450
!هربت

133
00:11:07,830 --> 00:11:11,210
!في الوقت الذي ينبغي لنا فيه أن نتعاون جميعاً

134
00:11:12,420 --> 00:11:17,380
!رغم أنّني علمتُ بأنّ هيونكل وكروكوداين في خطر

135
00:11:17,800 --> 00:11:19,840
!هربتُ من المعركة

136
00:11:23,300 --> 00:11:26,100
أتيت لتوبّخني

137
00:11:26,260 --> 00:11:28,350
"أتعتبر نفسك بطلاً؟"

138
00:11:28,520 --> 00:11:30,270
"جبان"

139
00:11:32,560 --> 00:11:34,520
مهلاً يا أبله

140
00:11:34,900 --> 00:11:38,440
كيف لي أن أنتقد شخصاً آخر من هذه النّاحية؟

141
00:11:38,610 --> 00:11:43,990
عندما يتعلّق الأمر بالهرب، فأنا أكثر منك خبرة

142
00:11:46,780 --> 00:11:49,160
لا يستطيع أحد لومك

143
00:11:49,330 --> 00:11:51,620
قاتلتَ بأقصى طاقتك

144
00:11:52,250 --> 00:11:55,840
فقدتَ والدك وسلاحك

145
00:11:56,590 --> 00:11:59,880
بذلتَ... قصارى جهدك

146
00:12:00,260 --> 00:12:02,970
!قصارى جهدي لا يكفي

147
00:12:12,980 --> 00:12:18,820
حتّى بهذه القوّة، لم أستطع فعل
!شيء لملك الشّياطين

148
00:12:19,610 --> 00:12:23,610
!تركتُ أبي يموت، وتركتُ الجميع يتأذّون

149
00:12:27,370 --> 00:12:31,790
كنتُ أعتقد أنّ الأبطال رائعين

150
00:12:31,960 --> 00:12:33,580
كنتُ أقدّسهم

151
00:12:35,120 --> 00:12:39,750
حتّى التقيتُ بليونا، ثمّ بالمعلّم أفان

152
00:12:40,630 --> 00:12:43,470
وناداني الجميع بالبطل

153
00:12:44,720 --> 00:12:49,010
!لهذا حاولتُ أن أصبح قويّاً قدر المستطاع لأجل الجميع

154
00:12:50,430 --> 00:12:51,430
...لكن

155
00:12:52,560 --> 00:12:55,980
كلّ قوّتي لم تكن كافية البتّة

156
00:12:56,850 --> 00:12:59,230
!لا سيّما ضدّ ملك الشّياطين فارن

157
00:13:00,150 --> 00:13:04,950
ومع ذلك، ما زالوا يعتقدون أنّني أستطيع فعل شيء

158
00:13:05,530 --> 00:13:08,830
ما زالوا يعتقدون بأنّني بطل حقيقيّ

159
00:13:10,620 --> 00:13:12,910
لقد سئمت

160
00:13:13,370 --> 00:13:17,040
...إذا استمرّوا جميعاً في القتال مؤمنين بي

161
00:13:17,290 --> 00:13:20,550
...سيموتون جميعاً مثل أبي في النّهاية

162
00:13:21,840 --> 00:13:24,260
...جميعهم

163
00:13:26,510 --> 00:13:30,300
حسناً إذاً. لن أحاول مجادلتك

164
00:13:32,640 --> 00:13:37,480
لكن حتّى ولو لن تأتي، سأقاتل ملك الشّياطين ثانية

165
00:13:37,650 --> 00:13:38,730
!ماذا؟

166
00:13:39,690 --> 00:13:42,230
لطالما كنتَ قويّاً

167
00:13:42,400 --> 00:13:44,070
بخلافي أنا

168
00:13:44,440 --> 00:13:48,110
كنتُ دائماً ما أخشى الأقوياء وألوذ بالفرار

169
00:13:48,740 --> 00:13:53,240
وها أنا ذا أقاتل إله العالم السّفلي

170
00:13:53,410 --> 00:13:55,080
يا للمفاجأة

171
00:13:55,830 --> 00:13:57,210
...بوب

172
00:13:57,370 --> 00:14:00,130
أوصلتني معاركي إلى هذا الحدّ

173
00:14:00,920 --> 00:14:06,760
قطع كلّ هذه المسافة معك ومع مام وهيونكل
والآخرين هو من الأمور التي أعتزّ بها

174
00:14:07,630 --> 00:14:09,300
،إذا توقّفتُ عند هذا الحدّ

175
00:14:09,470 --> 00:14:16,350
فإنّ كلّ أيّامي التي خضتُ قتالاً فيها واستجماعي
الشّجاعة، ستذهب أدراج الرّياح

176
00:14:17,890 --> 00:14:18,810
داي

177
00:14:19,350 --> 00:14:23,400
حتّى الآن، لم نقاتل إلّا لأجل شخص آخر

178
00:14:23,570 --> 00:14:29,610
للثأر للمعلّم أفان. لاستعادة السّلام لعائلاتنا

179
00:14:29,780 --> 00:14:34,450
حسناً، لم يعد هذا سبب قتالنا الوحيد

180
00:14:34,870 --> 00:14:36,660
ليس لأجل الآخرين فحسب

181
00:14:36,830 --> 00:14:40,830
علينا أن نستمرّ في القتال لأجل أنفسنا

182
00:14:41,630 --> 00:14:43,710
لأجل أنفسنا؟

183
00:14:43,880 --> 00:14:48,420
!أجل. هذه معركتنا الآن

184
00:14:49,720 --> 00:14:52,260
هذه... معركتنا

185
00:14:52,720 --> 00:14:55,390
اتّخذ قرارك

186
00:14:58,230 --> 00:14:59,890
سوف أقاتل

187
00:15:00,940 --> 00:15:02,360
...بوب

188
00:15:02,520 --> 00:15:05,530
وما زلتُ مؤمناً

189
00:15:06,360 --> 00:15:09,700
لا أبالي إن كنتَ بطلاً حقيقيّاً أم لا

190
00:15:09,860 --> 00:15:12,700
!أؤمن لأنّك داي

191
00:15:13,700 --> 00:15:17,790
!وما أهمّية البطل؟! من يأبه لفارس تنّين؟

192
00:15:20,620 --> 00:15:22,250
...بالنسبة لي

193
00:15:23,000 --> 00:15:24,380
!ستبقى دوماً داي

194
00:15:32,220 --> 00:15:33,220
ماذا يجدر بي أن أفعل؟

195
00:15:35,050 --> 00:15:36,600
...لمَ أزعج نفسي بالسؤال

196
00:15:37,720 --> 00:15:39,930
بعد أن قرّرتُ سلفاً؟

197
00:15:55,950 --> 00:15:57,620
لا، لم أستطع إيجاد شيء

198
00:15:57,990 --> 00:16:00,870
بوب، ألم تجد داي؟

199
00:16:02,040 --> 00:16:03,210
هدوء من فضلكم

200
00:16:06,420 --> 00:16:08,750
المسرح لك

201
00:16:22,690 --> 00:16:24,770
ترتّب عليّ الذهاب لتصفية ذهني

202
00:16:25,520 --> 00:16:27,860
آسف لإقلاقكم جميعاً

203
00:16:29,860 --> 00:16:33,530
أيّها الجمع، ملك الشّياطين فارن قويّ

204
00:16:33,700 --> 00:16:37,450
وفقاً لتنّين الأمّ المقدّس، إنّه أقوى من إله

205
00:16:37,620 --> 00:16:41,790
لا أستطيع الجزم بأنّنا إذا قاتلناه سنفوز

206
00:16:43,040 --> 00:16:45,040
أنا أضعف من فارن

207
00:16:45,210 --> 00:16:47,040
لا أملك سلاحاً خاصّاً

208
00:16:47,500 --> 00:16:54,010
لكن لا أستطيع الوقوف مكتوف الأيدي والسّماح
!له بسحق العالم بالقوّة

209
00:16:55,050 --> 00:16:58,510
...إذا كان هناك شيء واحد أمتلكه أقوى من أيّ شيء

210
00:16:59,310 --> 00:17:01,180
!فهو هذا الإيمان

211
00:17:03,640 --> 00:17:05,980
...لذا إذا كنتم تقبلونني

212
00:17:06,650 --> 00:17:08,940
!فمدّوني بقوّتكم جميعاً

213
00:17:13,690 --> 00:17:14,360
!داي

214
00:17:21,160 --> 00:17:22,120
أنت

215
00:17:23,700 --> 00:17:25,080
تأخّرت كثيراً

216
00:17:28,630 --> 00:17:29,840
آسف

217
00:17:39,100 --> 00:17:43,390
في ظهيرة يوم غد، سننطلق لإنقاذ هيونكل وكروكوداين

218
00:17:43,850 --> 00:17:48,560
نحن متوجّهون نحو فخّ، لذا يجب أن نكون مستعدّين

219
00:17:48,980 --> 00:17:53,940
لأجل ذلك، يجب علينا الحصول على تعويذة
التّطهير العظيمة، بريق

220
00:17:54,360 --> 00:17:55,900
بريق؟

221
00:17:56,070 --> 00:18:02,700
.إنّها أعظم من تعويذة وميض الخاصّة بأفان
تستطيع ختم قوّة سحر الظلاميّين

222
00:18:04,200 --> 00:18:07,670
قلتَ أنّ قصر فارن لديه حقل وقائيّ

223
00:18:07,830 --> 00:18:11,340
أجل. يمنعنا من استخدام تعويذات عودة للدخول

224
00:18:12,000 --> 00:18:16,260
،إذا نجحت بريق، فستمسح حقل قصر فارن

225
00:18:16,420 --> 00:18:18,550
ما يسمح بالدّخول بتعويذة عودة

226
00:18:18,720 --> 00:18:20,180
!مذهل

227
00:18:20,340 --> 00:18:24,180
لكن هذه تعويذة حتّى أفان لم يستطع اكتسابها

228
00:18:25,310 --> 00:18:27,560
إن لم يكن المعلّم أفان يستطيع استخدامها، فمن...؟

229
00:18:28,100 --> 00:18:30,270
تلميذ أفان الخامس

230
00:18:30,440 --> 00:18:32,360
!مهلاً لحظة

231
00:18:34,030 --> 00:18:35,610
!آسف

232
00:18:35,780 --> 00:18:41,990
لكن تلاميذ أفان يتلقّون شارات أفان من المعلّم أفان

233
00:18:42,490 --> 00:18:44,700
!لا يوجد سوى أربعة منّا

234
00:18:52,460 --> 00:18:56,130
!إنّها نفسها! شارة أفان

235
00:18:56,300 --> 00:18:58,970
...ماذا؟ إذاً التّلميذ الخامس

236
00:18:59,470 --> 00:19:03,390
صُنعت هذه بواسطة صقل حجر نادر
يُدعى بالحجر المُقدّس

237
00:19:03,550 --> 00:19:06,100
وتركيزها بالسّحر

238
00:19:06,270 --> 00:19:08,520
هذه ميراث عائلة أفان

239
00:19:08,680 --> 00:19:11,400
هو الوحيد الّذي يعرف كيف يصنعها

240
00:19:11,560 --> 00:19:17,360
تمتلك هذه قوّة تضخيم القوّة المُقدّسة
وردع القوّة الشيطانيّة

241
00:19:17,530 --> 00:19:19,320
إنّها تعمل كمُعلّقات سحريّة

242
00:19:20,700 --> 00:19:22,620
...لحظة... إذاً

243
00:19:22,780 --> 00:19:24,120
!طوال هذا الوقت...؟

244
00:19:24,620 --> 00:19:25,450
أجل

245
00:19:25,620 --> 00:19:31,620
حمتكم هذه الشّارات خلال كافّة معارككم

246
00:19:31,790 --> 00:19:33,250
لم أكن أعلم

247
00:19:34,540 --> 00:19:37,670
لم أفكّر في الأمر حتّى

248
00:19:38,170 --> 00:19:42,050
...المعلّم أفان... كان المعلّم أفان دوماً

249
00:19:42,640 --> 00:19:45,510
كان يحرسنا

250
00:19:46,890 --> 00:19:52,980
لطالما افترضتُ أنّنا قطعنا هذه المسافة
...بفضل قوّتنا فقط، لكن

251
00:19:54,150 --> 00:19:56,820
،لولا شارات أفان هذه

252
00:19:56,980 --> 00:19:59,650
لكنّا قد خسرنا بعض المعارك بفارق طفيف

253
00:20:00,900 --> 00:20:04,240
...لطالما كان المعلّم أفان يمنح قوّته

254
00:20:04,870 --> 00:20:06,120
لنا

255
00:20:09,790 --> 00:20:13,710
أعطاني أفان هذه كمُعلّقة سحريّة

256
00:20:14,420 --> 00:20:21,260
فيما بعد، أتى بفكرة تقديمها لتلاميذه عند التخرّج

257
00:20:23,220 --> 00:20:24,340
الأميرة ليونا

258
00:20:24,510 --> 00:20:26,050
!نعم؟

259
00:20:26,970 --> 00:20:30,810
أريدكِ أن تكوني التلميذة الخامسة لأفان

260
00:20:31,100 --> 00:20:32,230
!أنا؟

261
00:20:32,850 --> 00:20:36,150
أعتقد أنّ أفان كان ليختاركِ

262
00:20:36,310 --> 00:20:41,150
وأعتقد أنّ بمقدورك اكتساب تعويذة بريق

263
00:20:41,490 --> 00:20:45,660
غير أنّ هذا سيتطلّب اجتيازكِ اختباراً صعباً

264
00:20:45,820 --> 00:20:47,370
!ماذا؟! ليونا

265
00:20:47,950 --> 00:20:50,540
هل ستقبلين بهذا يا أميرة ليونا؟

266
00:20:53,620 --> 00:20:54,460
أجل

267
00:20:54,620 --> 00:20:56,880
!ليونا! هذا جنون

268
00:20:57,040 --> 00:20:59,800
داي، سوف أفعلها

269
00:21:00,250 --> 00:21:04,090
...بصراحة، حتّى الآن

270
00:21:05,010 --> 00:21:10,390
لطالما كنتُ مُحبطة من عدم قدرتي على مُشاركتك ألمك

271
00:21:11,060 --> 00:21:14,100
ينبغي أن أقاتل مثل بوب ومام

272
00:21:15,480 --> 00:21:18,770
!أقبل بذلك! مهما كان الاختبار الّذي ينتظرني

273
00:21:19,190 --> 00:21:23,900
بهذا الشّكل، سأكون عضوة حقيقيّة في فريقك

274
00:21:24,280 --> 00:21:25,950
هذا ما أؤمن به

275
00:21:33,450 --> 00:21:36,870
سيكون الاختبار مواجهة كهف المِحن

276
00:21:38,380 --> 00:21:41,500
إنّه متاهة تعجّ بالوحوش

277
00:21:41,670 --> 00:21:44,880
هناك فقط ستستطيعين تعلّم تعويذة بريق

278
00:21:45,050 --> 00:21:46,010
حسناً

279
00:21:46,180 --> 00:21:52,220
لكن هل يمكنني أن أصبح تلميذة المعلّم
أفان من دون تلقّي تعليمه؟

280
00:21:53,430 --> 00:21:56,640
هلّا حدّثتكِ قليلاً عن أفان؟

281
00:21:58,060 --> 00:21:59,560
أجل من فضلك

282
00:22:07,200 --> 00:22:12,080
بصراحة كنتُ أخرق

283
00:22:12,240 --> 00:22:18,420
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

284
00:22:18,920 --> 00:22:23,880
وحتّى أنّني استخدمتُ الوحدة كسلاح

285
00:22:24,050 --> 00:22:29,800
بحثتُ في الدّيماس عن جواب بسيط

286
00:22:29,970 --> 00:22:35,640
حتّى لو تخلّيتُ عن الحقّ واللّطف

287
00:22:35,810 --> 00:22:41,770
أريد أن أكون موجوداً بجانبك فحسب

288
00:22:41,940 --> 00:22:47,400
أن أنادي باسمك

289
00:22:47,570 --> 00:22:53,410
هو أصعب من أي تعويذة سحريّة

290
00:22:53,580 --> 00:22:59,210
رغم أنّك مقرّب جدّاً منّي

291
00:22:59,370 --> 00:23:01,830
أحبّك

292
00:23:02,000 --> 00:23:05,130
أدركتُ ذلك أخيراً

293
00:23:05,300 --> 00:23:10,260
أن أنادي باسمك

294
00:23:10,430 --> 00:23:16,680
هو السّبب الّذي وُلدت لأجله

295
00:23:16,850 --> 00:23:22,610
سأتخلّص من هذا اللّيل الطويل

296
00:23:22,770 --> 00:23:25,320
وآتي لرؤيتك

297
00:23:25,480 --> 00:23:30,070
إلى حيث أنت الآن

298
00:23:33,910 --> 00:23:36,740
،عندما غزا ملك الشّياطين هادلَر العالم

299
00:23:36,910 --> 00:23:41,500
تنظيم كارل، بقيادة الأميرة فلورا، واجه
وببسالة جيشه الشّيطانيّ

300
00:23:41,670 --> 00:23:45,790
حمى أفان مملكة كارل مع قائدها، روكا

301
00:23:45,960 --> 00:23:50,340
بمواجهة مصيريّة مع هادلَر، تحرّكت عجلات قدره

302
00:23:50,510 --> 00:23:54,050
كشف السّتار عن أيّام شباب أفان

303
00:23:54,220 --> 00:23:56,600
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

304
00:23:58,390 --> 00:24:00,560
!وتستمرّ المغامرة