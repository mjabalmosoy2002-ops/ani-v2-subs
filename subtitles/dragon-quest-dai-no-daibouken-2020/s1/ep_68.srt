1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:56,490 --> 00:02:00,410
!لا يا ميرلي! أرجوكِ! افتحي عينيكِ

20
00:02:00,570 --> 00:02:03,370
!لا يمكنكِ أن تموتي! لا يمكنك

21
00:02:03,540 --> 00:02:08,620
!لا تموتي لأجل شخص مثلي أرجوكِ

22
00:02:14,670 --> 00:02:19,090
!بوب ساحر ومع ذلك يستخدم طاقة شفاء؟

23
00:02:20,300 --> 00:02:21,640
...كـ

24
00:02:22,600 --> 00:02:24,470
!كحكيم

25
00:02:30,810 --> 00:02:32,900
!ماذا؟

26
00:02:33,070 --> 00:02:36,900
!من أين لذلك الطفل أن يمتلك كلّ هذه القوّة السحرية؟

27
00:02:37,070 --> 00:02:38,950
!ماذا حدث؟

28
00:02:40,700 --> 00:02:43,120
!لن تتدخّل أكثر

29
00:02:47,700 --> 00:02:50,960
!إنّها على قيدِ الحياة! قلبها ينبض

30
00:02:51,120 --> 00:02:54,590
!زالَ السمّ! قد تكون حيّة

31
00:02:55,000 --> 00:02:58,760
يعزو الفضل لطاقة شفاء بوب الهائلة

32
00:02:59,420 --> 00:03:04,010
إنّها أقوى من تعويذتي إحياء. قد تكون بمستوى انبعاث

33
00:03:04,180 --> 00:03:05,680
!مذهل يا بوب

34
00:03:08,020 --> 00:03:12,650
!آنسة أيمي، لا تدعيها تموت! أرجوكِ

35
00:03:12,810 --> 00:03:13,730
!حسناً

36
00:03:13,900 --> 00:03:16,190
!حسناً! لنفعلها

37
00:03:17,980 --> 00:03:22,320
!هذا لأجل ميرلي! هيّا بنا جميعاً

38
00:03:55,860 --> 00:03:57,520
!أجل! أفلحَ ذلك

39
00:03:57,690 --> 00:03:59,650
ضوء أخضر

40
00:04:00,360 --> 00:04:03,910
ضوء الشّجاعة هذا هو لميرلي

41
00:04:04,360 --> 00:04:08,410
كانت أشجع بكثير ممّا كنتُ أنا

42
00:04:10,040 --> 00:04:11,500
...لن

43
00:04:11,960 --> 00:04:14,210
!لن أخذلها

44
00:04:28,390 --> 00:04:29,430
أخيراً

45
00:04:29,600 --> 00:04:33,190
!فعلوها! أعمدة الضّوء الخمسة

46
00:04:33,810 --> 00:04:37,690
!والآن سوف تتألّق! تعويذة التّطهير المُطلقة

47
00:04:48,870 --> 00:04:50,830
!بريق

48
00:05:12,100 --> 00:05:13,270
ما هذا؟

49
00:05:16,350 --> 00:05:17,690
!بوب، الآن

50
00:05:18,980 --> 00:05:19,860
!عودة

51
00:05:35,160 --> 00:05:36,500
!مرحى

52
00:05:37,000 --> 00:05:40,540
!مرحى! فعلوها

53
00:05:45,380 --> 00:05:46,590
...أولئك

54
00:05:46,760 --> 00:05:50,180
غادروا لمواجهة ملك الشّياطين

55
00:05:51,470 --> 00:05:53,470
فعلوها أخيراً

56
00:05:58,020 --> 00:06:02,320
!انطلقوا أيّها الأبطال العظماء! اهزموا ملك الشّياطين

57
00:06:02,480 --> 00:06:05,650
!تحيا العدالة

58
00:06:08,070 --> 00:06:12,080
!جميعكم، اصطفّوا حول دائرة السّحر

59
00:06:12,240 --> 00:06:15,080
!سيكون وحوش العدوّ أضعف هناك

60
00:06:19,500 --> 00:06:20,250
!حاضر

61
00:06:30,180 --> 00:06:32,550
نجحَ ذلك. أين نحن؟

62
00:06:32,720 --> 00:06:37,270
هنا حيث قاتلنا فارن وخسرنا في السّابق

63
00:06:37,430 --> 00:06:40,020
إنّها قمّة قصر فارن

64
00:06:40,190 --> 00:06:43,520
كان مُدمّراً تماماً، لكن تمّ إصلاحه

65
00:06:45,780 --> 00:06:46,780
رِفاق

66
00:06:47,530 --> 00:06:50,490
!لن أختلق أيّ أعذار سخيفة

67
00:06:50,660 --> 00:06:54,200
!سأعوّض عن المتاعب الّتي سبّبتُها بالقتال

68
00:07:01,790 --> 00:07:04,170
مام، حاولي أن تفهمي

69
00:07:04,340 --> 00:07:09,170
كان بوب واقعاً في حبّك منذ التقى بك

70
00:07:09,720 --> 00:07:13,930
عملَ بجدّ ليقطع كلّ هذه المسافة إلى هنا

71
00:07:14,100 --> 00:07:17,140
يعزو مُعظم الفضل لكِ غالباً

72
00:07:18,220 --> 00:07:24,360
!مـ-من المفاجئ استيعاب كلّ هذا فوراً

73
00:07:25,520 --> 00:07:26,780
!لستُ جاهزة

74
00:07:30,110 --> 00:07:34,240
ليونا، ربّما ينبغي أن نبقى متلاصقين معاً

75
00:07:34,410 --> 00:07:36,240
...إنّه حصن العدوّ، لذا

76
00:07:36,410 --> 00:07:40,040
!داي! لمَ لا تؤجّل هذا الحديث لوقت لاحق؟

77
00:07:40,210 --> 00:07:44,500
!كلّ ما في الأمر أنّني لا أتحمّل مثل هذه الأجواء

78
00:07:44,880 --> 00:07:49,670
لكن من المؤكّد أنّنا لا نملك وقتاً
!لنهدره. لنسرع يا داي

79
00:07:49,840 --> 00:07:51,720
!مهلكِ! أيّهما؟

80
00:07:55,550 --> 00:07:57,810
...بريق

81
00:07:57,970 --> 00:08:01,640
هديّة قديمة من إله البشر

82
00:08:01,810 --> 00:08:06,480
تمكّنوا من تنفيذ خدعة مثيرة للاهتمام

83
00:08:06,650 --> 00:08:10,030
الملك فارن، هل أنت بخير؟

84
00:08:11,700 --> 00:08:17,490
أشعر بتأثير طفيف، لكنّه لا يقمع قوّتي السحريّة

85
00:08:17,660 --> 00:08:21,620
لكن لا أستطيع تحريك قصر فارن الآن

86
00:08:21,790 --> 00:08:23,830
ومجاله قد زال

87
00:08:24,290 --> 00:08:29,340
إنّ نقل قوّتي السحريّة إلى قصر
فارن محجوب غالباً

88
00:08:29,840 --> 00:08:32,970
سيأتي مزيد من الضيوف المزعجين الآن

89
00:08:33,130 --> 00:08:35,300
أعتقد هذا الأمر يتطلّبني أنا

90
00:08:37,180 --> 00:08:41,220
انتظر لحظة. لدينا ضيوف آخرون

91
00:08:42,100 --> 00:08:47,310
هذه الهالة. أتذكّرها

92
00:08:47,940 --> 00:08:49,900
...هذه هي حركتك إذاً

93
00:09:04,460 --> 00:09:05,580
!هادلَر

94
00:09:20,510 --> 00:09:22,680
!هادلَر! ماذا فعلتَ لهم؟

95
00:09:22,850 --> 00:09:27,650
آسف، لكن سيترتّب عليهم مواجهة الحرس الملكيّ

96
00:09:28,900 --> 00:09:30,060
!ماذا تريد؟

97
00:09:30,900 --> 00:09:33,610
ليس لي إلّا أمنية واحدة

98
00:09:34,110 --> 00:09:38,570
!نِزال فرديّ ضدّك! هذا كل ما أريده

99
00:09:38,740 --> 00:09:41,410
!نـ-نزال ضدّي؟

100
00:10:01,220 --> 00:10:04,180
!تبّاً! ماذا كان ذلك؟

101
00:10:05,060 --> 00:10:08,690
!هل هذا مكان آخر من قصر فارن؟

102
00:10:09,310 --> 00:10:10,650
تماماً

103
00:10:12,020 --> 00:10:15,650
هذا قسم الذّيل من قصر فارن

104
00:10:16,150 --> 00:10:18,860
تعويذة عودة خاصّتي هي ما أحضرك إلى هنا

105
00:10:19,030 --> 00:10:21,320
!أنت الحصان سيغما

106
00:10:21,490 --> 00:10:23,830
شرف لي أن تتذكّرني

107
00:10:24,870 --> 00:10:31,040
لا أريد أيّ تدخّل بينما يحسم مولايّ
هادلَر الأمور مع داي

108
00:10:31,460 --> 00:10:34,460
سوف أتعامل معك

109
00:10:34,630 --> 00:10:36,130
...إذاً مام والآخرون

110
00:10:38,050 --> 00:10:42,100
مثلك، إنّهم في مكان ما من القلعة

111
00:10:51,560 --> 00:10:53,690
هذا هو الجناح الخلفيّ الأيمن

112
00:10:54,400 --> 00:10:56,610
هذا حماسيّ يا هيونكل

113
00:10:58,610 --> 00:10:59,570
...هيم

114
00:10:59,740 --> 00:11:03,830
تمكنَّ كلانا من النّجاة وها نحن سنتقاتل من جديد

115
00:11:04,660 --> 00:11:08,960
رؤية وجهك المعدنيّ لا يُشعرني بأيّ شيء

116
00:11:09,830 --> 00:11:12,130
يا لها من ردّة فعل مُملّة

117
00:11:12,460 --> 00:11:14,130
الوقت يُداهمني

118
00:11:17,260 --> 00:11:18,920
!قاتلني بسرعة فحسب

119
00:11:19,090 --> 00:11:22,640
!حسنٌ إذاً! دعني أحقّق لك أمنيتك

120
00:11:27,020 --> 00:11:29,350
...الملكة آلبيناس

121
00:11:29,980 --> 00:11:32,690
!الأقوى في الحرس الملكيّ

122
00:11:34,150 --> 00:11:39,650
كم أنتِ بائسة. أن تواجهيني بمفردكِ

123
00:11:39,820 --> 00:11:45,830
انتهت الخطّة بهذا الشكل فحسب. لا تبغضينا

124
00:11:46,580 --> 00:11:49,620
هذه خطّتكم إذاً لضمان النّصر

125
00:11:50,410 --> 00:11:54,960
رأيتُ سيغما يواجه بوب وهيم يواجه هيونكل

126
00:11:55,670 --> 00:11:58,590
بمرأة تستطيع عكس التّعويذات، سيغما واجهَ بوب

127
00:11:58,760 --> 00:12:02,840
ويمتلك هيم الخبرة العليا في مقاتلة هيونكل

128
00:12:03,550 --> 00:12:06,510
فلا يبقى سواكِ ضدّي

129
00:12:09,810 --> 00:12:12,730
تحليلكِ لاستراتيجيّتنا صحيحة

130
00:12:12,890 --> 00:12:16,360
رغم أنّكِ اقترفتِ خطأ طفيفاً

131
00:12:16,520 --> 00:12:21,650
بمعزل عن داي، الخطران الحقيقيّان الوحيدان
هما بوب وهيونكل

132
00:12:21,820 --> 00:12:24,860
عملي هو مواجهة الآخرين

133
00:12:25,740 --> 00:12:30,160
كان من المُفترض أن أختطف تلك الفتاة
،الأخرى التي كانت معكِ

134
00:12:30,330 --> 00:12:34,040
لكن تدخّل ذلك المخلوق الغريب

135
00:12:34,210 --> 00:12:36,040
مخلوق غريب؟

136
00:12:38,380 --> 00:12:39,500
!اسمع يا داي

137
00:12:39,670 --> 00:12:45,930
سوف نضع كلّ شيء على المحكّ
!الآن لمواجهة رجُل لرجُل نهائيّة

138
00:12:47,470 --> 00:12:49,470
!مهلاً لحظة

139
00:12:49,640 --> 00:12:51,430
!توقّفا

140
00:12:51,600 --> 00:12:54,270
فوّتوا واحدة منهم

141
00:12:54,440 --> 00:12:55,900
...ليونا

142
00:12:56,730 --> 00:12:57,900
!غوميتشان

143
00:12:58,060 --> 00:13:01,690
!عندما أصابنا النّور، ظهرَ غوميتشان

144
00:13:09,030 --> 00:13:12,410
حماني غوميتشان من تعويذة العدوّ

145
00:13:12,580 --> 00:13:16,620
يبدو أنّ تعويذة عودة أحضرتنا جميعاً إلى هنا

146
00:13:16,790 --> 00:13:18,460
هكذا إذاً

147
00:13:20,250 --> 00:13:24,970
على أيّ حال يا داي، لا يمكنك قبول
!مثل هذا النّزال السّخيف

148
00:13:26,300 --> 00:13:28,760
!هادلَر، هذا ينطبق عليك أيضاً

149
00:13:29,260 --> 00:13:31,810
!انتفضتَ ضدّ فارن، أليس كذلك؟

150
00:13:31,970 --> 00:13:36,270
!إنّ مقاتلة داي هنا سوف تخدم فارن

151
00:13:36,440 --> 00:13:40,690
!إذا أردت حسم الأمور، فانتظر لوقت آخر فحسب

152
00:13:41,610 --> 00:13:42,860
!هذا غير ممكن

153
00:13:46,200 --> 00:13:49,780
لم يبقَ لي... مزيد من الوقت

154
00:13:53,910 --> 00:13:55,330
هذا صحيح

155
00:13:55,790 --> 00:13:57,790
...إنّ هادلَر

156
00:14:07,380 --> 00:14:10,640
يبدو أنّه لن يتراجع

157
00:14:11,760 --> 00:14:13,220
!سوف أقدّم المساعدة إذاً

158
00:14:13,390 --> 00:14:15,640
!ليونا، تراجعي

159
00:14:16,640 --> 00:14:21,900
!عـ-عمّاذا تتكلّم يا داي؟! ليس عليك تلبية طلبه

160
00:14:22,070 --> 00:14:23,650
...ينبغي لنا معاً

161
00:14:31,280 --> 00:14:32,620
...داي

162
00:14:34,700 --> 00:14:35,790
أنا آسف

163
00:14:36,200 --> 00:14:39,460
لكن سوف تحتدّ الأمور

164
00:14:39,960 --> 00:14:41,920
لذا أريدكِ أن تتراجعي

165
00:14:42,750 --> 00:14:45,090
أمسى وضع هادلَر ميؤوساً منه

166
00:14:47,010 --> 00:14:53,100
تمتلك الشّياطين الخارقة تجديداً فوريّاً، لكنّه لا يزال جريحاً

167
00:14:54,260 --> 00:14:56,970
بقي أمام هادلَر القليل من الوقت

168
00:14:57,310 --> 00:15:03,940
مع ذلك يفضّل المخاطرة بما بقي من حياته
للقتال حفاظاً على شرفه

169
00:15:05,480 --> 00:15:09,650
واختارني خصماً له

170
00:15:10,860 --> 00:15:13,740
أعلم أنّ علينا هزيمة فارن

171
00:15:14,280 --> 00:15:16,790
كنتُ لأفضّل عدم القتال أيضاً

172
00:15:17,620 --> 00:15:18,790
...لكن

173
00:15:19,250 --> 00:15:21,370
...إن لم أقبل تحدّيه

174
00:15:22,290 --> 00:15:25,170
أشعر وكأنّني لن أتمكّن من اعتبار نفسي رجلاً

175
00:15:27,710 --> 00:15:29,010
أنا آسف

176
00:15:29,470 --> 00:15:32,340
يمكنكِ أن توبّخيني لاحقاً

177
00:15:37,140 --> 00:15:38,600
...عجباً

178
00:15:38,770 --> 00:15:43,860
كيف نضجَ بهذه السّرعة؟

179
00:15:51,900 --> 00:15:57,120
!هادلَر، سوف أواجهك بكلّ ذرّة من قوّتي

180
00:15:57,910 --> 00:15:59,620
شكراً لك

181
00:16:02,120 --> 00:16:08,460
!راقب هذا يا ملك الشّياطين فارن
!هذه معركة هادلَر الأخيرة

182
00:16:08,630 --> 00:16:12,590
!لكن فلتعلم جيّداً أنّه لا يُسمَح لأحد بالتدخّل

183
00:16:12,760 --> 00:16:16,800
!فالقيام بذلك سوف يكلّفك حياتك

184
00:16:17,510 --> 00:16:19,720
حسنٌ إذاً يا هادلَر

185
00:16:19,890 --> 00:16:23,020
قاتل حتّى تُشبع رغبتك

186
00:16:23,390 --> 00:16:26,270
عسى ألّا تتحسّر على شيء

187
00:16:26,770 --> 00:16:30,190
هادلَر، أليس هناك ما يُضعفك؟

188
00:16:32,570 --> 00:16:34,910
تقصد تعويذة بريق؟

189
00:16:35,070 --> 00:16:42,040
...أشعر ببعض التأثير، لكن بالنسبة لشخص قويّ مثلي

190
00:16:46,000 --> 00:16:49,550
!كما ترى، أنا بخير تماماً

191
00:16:49,920 --> 00:16:54,510
فهمت. يعني أنّ هذا ينطبق على ملك
الشّياطين فارن كذلك

192
00:16:54,680 --> 00:16:59,180
الشيء الوحيد المتأثّر بالتعويذة هو قصر فارن

193
00:16:59,350 --> 00:17:02,560
تبقى قوّة سحر فارن غير متأثّرة

194
00:17:02,730 --> 00:17:04,480
أسفي عليك

195
00:17:04,640 --> 00:17:07,100
لا، أنا مطمئنّ في الواقع

196
00:17:07,860 --> 00:17:12,570
!كنتُ لأمتعض لو أنّ تعويذة بريق تؤثّر بكم

197
00:17:14,700 --> 00:17:18,280
هذا يُلامس المشاعر أيّها الطفل الشقيّ

198
00:17:19,660 --> 00:17:21,200
!ها أنا ذا

199
00:17:22,330 --> 00:17:23,580
!حسناً

200
00:17:25,830 --> 00:17:28,290
ربّما يجدر بنا أن نبتعد

201
00:17:28,460 --> 00:17:29,840
!هيّا بنا يا غوميتشان

202
00:17:49,610 --> 00:17:51,150
لقد بدأ

203
00:17:51,730 --> 00:17:54,650
النّزال بين مولايّ هادلَر والبطل داي

204
00:17:54,820 --> 00:17:56,320
...نزال

205
00:17:56,490 --> 00:18:00,950
لم تعُد هناك أيّ تعويذة شفاء قادرة
على مساعدة مولايّ هادلَر

206
00:18:01,120 --> 00:18:03,870
جسده الوحشيّ سوف يتفسّخ فحسب

207
00:18:04,750 --> 00:18:10,000
تسخير آخر ما تبقّى من حياته في معركة
،ضدّ البطل داي

208
00:18:10,170 --> 00:18:15,760
ومعركة نزيهة ضدّ منافسه المُختار، هو
أمنية مولايّ هادلَر

209
00:18:18,840 --> 00:18:20,340
اسمعوني

210
00:18:20,510 --> 00:18:23,640
لن يصمد جسدي فترة أطول

211
00:18:24,020 --> 00:18:28,060
اخترتُ البطل كخصم أخير لي

212
00:18:31,110 --> 00:18:32,190
!مولايّ هادلَر

213
00:18:33,520 --> 00:18:37,190
لا أرغب في مقاتلة ملك الشّياطين

214
00:18:37,360 --> 00:18:40,820
لكن لا أستطيع أن أصطفّ مع فريق داي أيضاً

215
00:18:42,830 --> 00:18:48,830
أنا من سلبَ ما كان أثمن شيء منهم

216
00:18:49,580 --> 00:18:53,420
!هذا لا يترك لي سوى طريق واحد

217
00:18:53,590 --> 00:18:57,510
مُقاتلة أكثر شخص يُحفّزني

218
00:18:57,670 --> 00:19:00,630
!وترك بصمتي الأخيرة

219
00:19:00,800 --> 00:19:04,350
وذلك الخصم ليس ملك الشّياطين

220
00:19:04,510 --> 00:19:06,470
...لـ-لكن

221
00:19:06,640 --> 00:19:09,350
!لمَ أنتِ مُتردّدة يا آلبيناس؟

222
00:19:09,810 --> 00:19:12,730
إن لم نقُم بهذا

223
00:19:12,900 --> 00:19:17,490
فلن نكون إلّا فاشلين وسيذهب موت
بلوك وفينبرين أدراج الرّياح

224
00:19:19,030 --> 00:19:24,780
إن لم نهزم منافسينا ونتباهى بشرف
،حرَس هادلَر الملكيّ

225
00:19:25,240 --> 00:19:27,870
!بأيّ وجه سننظر إليهما في الحياة الآخرة؟

226
00:19:28,410 --> 00:19:30,710
!لنبذل كلّ جهدنا بنار المجد

227
00:19:30,870 --> 00:19:34,000
سوف نهزم الأبطال ثمّ نقاتل ملك الشّياطين

228
00:19:34,170 --> 00:19:36,670
!سوف نريهم أجمعين

229
00:19:37,380 --> 00:19:38,300
...هيم

230
00:19:38,880 --> 00:19:43,010
أظنّك أكثر من يشبهني

231
00:20:29,270 --> 00:20:36,440
إ-إذاً أنتم تضحّون بأنفسكم من أجل
!تلبية الوصيّة الأخيرة لهادلَر؟

232
00:20:36,610 --> 00:20:39,900
!هيم وسيغما وأنت كذلك؟

233
00:20:44,360 --> 00:20:49,330
آلبيناس، لنوقف هذا. لا ينبغي أن نقاتل

234
00:20:50,120 --> 00:20:51,160
نوقف هذا؟

235
00:20:51,330 --> 00:20:54,960
...هذا صحيح! شعوركم تجاه هادلَر

236
00:20:55,120 --> 00:20:59,210
!لا يختلف عن شعورنا تجاه أصدقائنا

237
00:20:59,670 --> 00:21:03,470
قد نكون أعداء، لكن لا أستطيع مقاتلة
!شخص يخالجه ذلك الشّعور

238
00:21:03,630 --> 00:21:06,140
!لا جدوى من معركة بيننا

239
00:21:10,010 --> 00:21:11,770
!أرجوكِ يا آلبيناس

240
00:21:11,930 --> 00:21:17,940
،إن كنتم تهتمّون لبعضكم الآخر فعلاً
!فالآن ينبغي لنا إذاً أن نوقف القتال

241
00:21:18,110 --> 00:21:21,480
!سنساعدكم قدر ما نستطيع

242
00:21:21,650 --> 00:21:22,690
...لهذا السّبب

243
00:21:29,620 --> 00:21:33,660
مام، يسرّني أنّه ينتابكِ هذا الشّعور

244
00:21:34,080 --> 00:21:35,500
...آلبيناس

245
00:21:36,040 --> 00:21:40,670
يسرّني بأنّكِ من النوع السّاذج الّذي أمقته

246
00:21:41,550 --> 00:21:44,720
!الآن يمكنني قتلكِ بلا رحمة

247
00:21:47,890 --> 00:21:50,140
!الإبر الألف

248
00:22:07,200 --> 00:22:12,080
بصراحة كنتُ أخرق

249
00:22:12,240 --> 00:22:18,420
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

250
00:22:18,920 --> 00:22:23,880
وحتّى أنّني استخدمتُ الوحدة كسلاح

251
00:22:24,050 --> 00:22:29,800
بحثتُ في الدّيماس عن جواب بسيط

252
00:22:29,970 --> 00:22:35,640
حتّى لو تخلّيتُ عن الحقّ واللّطف

253
00:22:35,810 --> 00:22:41,770
أريد أن أكون موجوداً بجانبك فحسب

254
00:22:41,940 --> 00:22:47,400
أن أنادي باسمك

255
00:22:47,570 --> 00:22:53,410
هو أصعب من أي تعويذة سحريّة

256
00:22:53,580 --> 00:22:59,210
رغم أنّك مقرّب جدّاً منّي

257
00:22:59,370 --> 00:23:01,830
أحبّك

258
00:23:02,000 --> 00:23:05,130
أدركتُ ذلك أخيراً

259
00:23:05,300 --> 00:23:10,260
أن أنادي باسمك

260
00:23:10,430 --> 00:23:16,680
هو السّبب الّذي وُلدت لأجله

261
00:23:16,850 --> 00:23:22,610
سأتخلّص من هذا اللّيل الطويل

262
00:23:22,770 --> 00:23:25,320
وآتي لرؤيتك

263
00:23:25,480 --> 00:23:30,070
إلى حيث أنت الآن

264
00:23:33,700 --> 00:23:38,910
لم تستطع مام التأثير بمشاعر آلبيناس
الّتي لا تفكّر سوى بهادلَر

265
00:23:39,080 --> 00:23:44,790
،بعد أن قرّرت التّضحية بكلّ شيء لأجله
آلبيناس تهاجم بتعنّت

266
00:23:44,960 --> 00:23:48,460
حِدّة آلبيناس تُحرِج مام وتضعها في مأزق

267
00:23:48,630 --> 00:23:50,260
هل تستطيع مام التأثير بآلبيناس؟

268
00:23:50,420 --> 00:23:53,180
!سيوضع مُحارب الحبّ تحت الاختبار

269
00:23:53,340 --> 00:23:55,800
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

270
00:23:57,890 --> 00:23:59,770
!وتستمرّ المغامرة