1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:52,820 --> 00:01:53,940
...داي

20
00:01:54,740 --> 00:01:57,280
يبدو أنّه قُضي علينا الآن

21
00:02:00,200 --> 00:02:01,200
!اللّعنة

22
00:02:03,700 --> 00:02:07,580
،هذا سيّئ. حتّى لو ظللتُ أتصدّى للنيران

23
00:02:07,750 --> 00:02:09,750
!لن تصمد لياقتي

24
00:02:10,080 --> 00:02:15,380
!على الرّغم من ذلك، يدايّ مشغولتان تماماً

25
00:02:15,880 --> 00:02:18,010
...أعتقد هذه هي النّهاية

26
00:02:20,720 --> 00:02:22,010
!بوب

27
00:02:22,430 --> 00:02:23,640
آسف

28
00:02:23,810 --> 00:02:26,020
...استعجلتُ ودخلتُ إلى هنا

29
00:02:28,020 --> 00:02:30,100
لكن عجزتُ عن فعل أيّ شيء

30
00:02:31,400 --> 00:02:35,530
يبدو أنّ... هذه هي... النّهاية

31
00:02:36,280 --> 00:02:37,400
بوب

32
00:02:40,990 --> 00:02:42,120
!أنا آسف

33
00:02:45,830 --> 00:02:47,700
!تبّاً

34
00:02:51,040 --> 00:02:52,670
!أيّها الحمقى

35
00:02:54,540 --> 00:02:55,920
!هادلَر؟

36
00:02:58,010 --> 00:02:59,720
...أنتما

37
00:03:00,050 --> 00:03:02,340
!تعتبران نفسيكما من تلاميذ أفان؟

38
00:03:04,510 --> 00:03:08,730
...أن تموتا في مكان كهذا

39
00:03:08,890 --> 00:03:11,440
...وتعتبرا نفسيكما رغم ذلك من تلاميذه

40
00:03:11,600 --> 00:03:14,770
!ستخيّبان أمل أفان في الحياة الآخرة

41
00:03:15,110 --> 00:03:15,770
!ماذا؟

42
00:03:15,940 --> 00:03:17,280
!انظرا إليّ

43
00:03:17,730 --> 00:03:22,740
...تلاميذ أفان الّذين ضحّيتُ بحياتي وأنا أحاول هزيمتهم

44
00:03:22,910 --> 00:03:26,950
!يتمتّعون بأكثر الأرواح جرأة وبسالة

45
00:03:27,120 --> 00:03:28,660
!كانوا مُحاربي الأمل

46
00:03:29,580 --> 00:03:33,790
!إرادة حديديّة لا تلين حتّى الرّمق الأخير

47
00:03:33,960 --> 00:03:35,500
...أليس

48
00:03:36,090 --> 00:03:42,300
أليس من المُفترض أن يكون هذا السّلاح
!الأعظم الّذي يمتلكه تلميذ أفان؟

49
00:03:45,510 --> 00:03:46,560
...هادلَر

50
00:03:47,430 --> 00:03:51,850
!الحقير! هو من قتلَ المُعلّم أفان

51
00:03:53,230 --> 00:03:54,440
...ومع ذلك

52
00:03:54,980 --> 00:03:57,900
!قال ما كان ليقوله المُعلّم

53
00:03:58,650 --> 00:04:01,450
!والآن افعلا شيئاً بشأن ذلك

54
00:04:01,900 --> 00:04:04,910
!ما أعرفه هو أنّني قاتلتُ تلاميذ أفان

55
00:04:05,910 --> 00:04:10,540
لا تجعلوا منّي مجرّد مُهرّج خسرَ
!أمام مجموعة من الاستعراضيّين

56
00:04:14,000 --> 00:04:16,420
عدوّنا يوبّخنا

57
00:04:17,090 --> 00:04:22,550
بعد أن قاتلنا، فهمَ هادلَر ما يعنيه
...أن نكون تلاميذ أفان

58
00:04:23,430 --> 00:04:25,220
!أكثر ممّا نفهم نحن

59
00:04:28,050 --> 00:04:31,270
!في هذه الحالة، من يأبه إن كنّا لا نستطيع فعل شيء

60
00:04:31,430 --> 00:04:35,600
!سنقاوم حتّى النّهاية

61
00:04:42,280 --> 00:04:43,360
!بوب

62
00:04:48,660 --> 00:04:51,410
حسناً. ماذا الآن؟

63
00:04:52,250 --> 00:04:57,420
!هذا لا يغيّر من حقيقة بأنّ خياراتنا قد نفدت

64
00:05:02,380 --> 00:05:05,300
!لحظة... هناك ملاذ آخر

65
00:05:05,470 --> 00:05:06,680
!ملاذ؟

66
00:05:06,840 --> 00:05:10,510
داي، ما زال بإمكانك إطلاق تعويذات، صحيح؟

67
00:05:10,680 --> 00:05:11,970
أجل، بإمكاني

68
00:05:12,140 --> 00:05:14,770
لكن لستُ متأكّداً بشأن التّصويب

69
00:05:14,940 --> 00:05:17,600
...بالإضافة إلى ذلك، قوّة سحري ليست

70
00:05:17,770 --> 00:05:19,860
!ليس عليك التّصويب نحو شيء

71
00:05:20,900 --> 00:05:23,070
كلّ ما عليك هو إطلاق تعويذة واحدة فقط

72
00:05:23,570 --> 00:05:24,690
!عودة

73
00:05:25,950 --> 00:05:29,780
!أطلِق "عودة" هناك، وحلّق نحو الأعلى

74
00:05:30,450 --> 00:05:33,700
!إذا فعلتُ ذلك، سأصطدم بجدار النّيران ذاك

75
00:05:33,870 --> 00:05:36,370
!ستكون السّماء ظاهرة عندما تفعل ذلك

76
00:05:37,250 --> 00:05:38,960
!بفضل ميدروا خاصّتي

77
00:05:39,130 --> 00:05:40,340
!هكذا إذاً

78
00:05:40,500 --> 00:05:42,840
!أجل! ميدروا

79
00:05:43,000 --> 00:05:45,090
!يمكنها نسف كلّ شيء بعيداً

80
00:05:46,800 --> 00:05:53,350
!ينجح هذا الفخّ بتركيز ثمانية نيران في نقطة واحدة

81
00:05:54,060 --> 00:06:00,440
معنى هذا بأنّني إذا أطلقتُ ميدروا للأعلى
...حيث تجمّعت النّيران

82
00:06:00,610 --> 00:06:04,530
!ينبغي أن تفرّقها لتجعل السّماء مرئيّة بلمح البصر

83
00:06:06,070 --> 00:06:08,030
!لنراهن على تلك اللّحظة

84
00:06:09,030 --> 00:06:09,700
!حسناً

85
00:06:10,320 --> 00:06:13,790
!اسمع! استخدم "عودة" للتحليق عالياً عندما ترى السّماء

86
00:06:14,240 --> 00:06:17,080
!سأتمسّك بك فوراً

87
00:06:17,370 --> 00:06:22,670
إنّ استخدام ميدروا سوف يستهلك
كامل قوّتي السحريّة غالباً

88
00:06:22,840 --> 00:06:24,840
لذا هذا هو خيارنا الأفضل

89
00:06:25,210 --> 00:06:26,340
عُلِم

90
00:06:34,930 --> 00:06:37,140
!ما الّذي تنتظرانه؟

91
00:06:38,100 --> 00:06:41,270
!إن كانت هناك طريقة، جرّباها قبل أن تموتا

92
00:06:42,690 --> 00:06:44,770
انسيا أمري

93
00:06:45,030 --> 00:06:48,150
مصيري أن أغدو جثّة قريباً على أيّ حال

94
00:06:48,740 --> 00:06:51,820
!احرصا على الخروج بسلام

95
00:06:52,200 --> 00:06:53,410
!حسناً

96
00:06:57,160 --> 00:06:58,200
!جميعكم

97
00:06:59,250 --> 00:06:59,960
!بوب؟

98
00:07:01,170 --> 00:07:05,380
!سنُقدِم على محاولتنا الأخيرة! صلّوا لأجلنا

99
00:07:05,550 --> 00:07:06,380
!بوب

100
00:07:10,720 --> 00:07:12,340
!ها أنا ذا

101
00:07:18,100 --> 00:07:18,730
!بوب؟

102
00:07:24,900 --> 00:07:30,860
تبّاً! إذا ضعّفتُ سحري الجليديّ ولو
!قليلاً، سوف أُقهَر

103
00:07:31,030 --> 00:07:33,530
!اللّعنة

104
00:07:38,620 --> 00:07:44,000
!هذا سيّئ! لا أستطيع استخدام ميدروا هكذا

105
00:07:46,460 --> 00:07:48,210
!اللّعنة

106
00:08:05,650 --> 00:08:06,860
!هادلَر...؟

107
00:08:07,110 --> 00:08:08,570
!بقوّته السحريّة...؟

108
00:08:14,910 --> 00:08:17,030
!ماذا تفعل بالضبط؟

109
00:08:17,200 --> 00:08:20,450
!تجاهلني! أفعل ما أريد فعله

110
00:08:22,000 --> 00:08:25,630
!هذه فرصتك! استخدم تعويذتك

111
00:08:26,130 --> 00:08:26,880
!هادلَر؟

112
00:08:28,000 --> 00:08:30,670
!وهبتُ حياتي لهذه المعركة

113
00:08:30,840 --> 00:08:36,010
!لن أدع فخّ كيلفارن يفسدها

114
00:08:36,180 --> 00:08:40,010
...إذا انتهت معركتي، معركة زملائي

115
00:08:40,560 --> 00:08:43,600
،دون أيّ مُنتصِر

116
00:08:43,770 --> 00:08:47,440
!فلن يبقى أحد حيّاً ليُحدِّث العالم عنهم

117
00:08:49,270 --> 00:08:51,400
!بسرعة يا بوب

118
00:08:51,860 --> 00:08:56,990
!نهضت هذه الجثّة! اعتبروها ضربة حظّ

119
00:09:11,420 --> 00:09:14,590
!داي! ها نحن ذا

120
00:09:14,920 --> 00:09:16,130
!نعم

121
00:09:16,430 --> 00:09:18,090
!افعلها

122
00:09:18,640 --> 00:09:22,140
!ميدروا

123
00:09:38,660 --> 00:09:39,700
!السّماء

124
00:09:40,410 --> 00:09:41,700
!فتحَتْ

125
00:09:43,620 --> 00:09:45,080
!الآن

126
00:09:45,250 --> 00:09:46,250
...أسرع

127
00:10:00,850 --> 00:10:01,930
!عودة

128
00:10:28,500 --> 00:10:29,370
...داي

129
00:10:30,830 --> 00:10:32,540
أين بوب؟

130
00:10:34,090 --> 00:10:36,090
...لحظة

131
00:10:36,260 --> 00:10:37,010
!ماذا حدث؟

132
00:10:37,420 --> 00:10:38,420
!أين بوب؟

133
00:10:49,440 --> 00:10:50,400
!بوب

134
00:10:52,020 --> 00:10:53,230
مام؟

135
00:10:54,900 --> 00:10:56,440
أخفقت

136
00:10:56,860 --> 00:11:00,360
لم أتوقّع أن ينتهي الأمر هكذا

137
00:11:01,610 --> 00:11:02,530
آسف

138
00:11:04,410 --> 00:11:09,000
لا أرى... مستقبلي... معك

139
00:11:11,210 --> 00:11:16,210
!بوب

140
00:11:22,680 --> 00:11:24,390
اكتملت

141
00:11:24,850 --> 00:11:28,270
اكتملت ورقة الألماسات التّسعة

142
00:11:28,810 --> 00:11:32,980
حان وقت قول الوداع أيُّها السّاحر الصّغير

143
00:11:34,190 --> 00:11:36,440
...النّجدة... فليفعل

144
00:11:40,070 --> 00:11:41,950
!فليفعل أحدٌ شيئاً ما

145
00:11:43,950 --> 00:11:48,080
أعشق هذه اللّحظة الأخيرة

146
00:11:48,580 --> 00:11:53,370
الجميع يركّزون على الألماسة الوسطى
ويختفي في ظُلمات العالم السّفلي

147
00:11:53,540 --> 00:11:57,090
لم يبقَ حتّى ذرّة من الرّماد

148
00:11:58,880 --> 00:12:02,470
كما المُفرقعات، أحبّ النّهاية المليئة بالعواطف

149
00:12:02,630 --> 00:12:04,220
...أنت بمزاج متفائل

150
00:12:05,010 --> 00:12:07,430
نظراً إلى نجاةِ أحدهم

151
00:12:07,600 --> 00:12:10,140
لديّ مزيد من فِخاخ القتل

152
00:12:10,310 --> 00:12:16,230
لديّ فِخاخ بعددِ الأوراق المُبعثرة في
كلّ أنحاء قصر فارن

153
00:12:16,400 --> 00:12:22,070
في الواقع، نحن محظوظون لأنّ لدينا
ذلك الفتى الآن

154
00:12:22,820 --> 00:12:26,950
أنت تحترمه كثيراً رغم كونه بشريّاً

155
00:12:27,120 --> 00:12:29,790
يجب ألّا تستهن بالبشر

156
00:12:29,950 --> 00:12:33,870
من حيث إمكانيّة النموّ، إمكانيّة بوب
أعظم من إمكانيّة داي

157
00:12:34,460 --> 00:12:40,300
لن يصل أيّ منهم إلى هذا المكان
أبداً. سأتولّى أمرهم جميعاً

158
00:12:40,460 --> 00:12:44,470
واحداً تلو الآخر، رويداً رويداً. صحيح؟

159
00:12:46,050 --> 00:12:49,430
!بمناسبة القضاء على بوب. بصحّتك

160
00:12:49,600 --> 00:12:51,430
!بصحّتك

161
00:13:03,320 --> 00:13:04,700
!هادلَر؟

162
00:13:10,160 --> 00:13:14,910
يبدو أنّك تستمتع بمقاومتك العقيمة كذلك

163
00:13:15,080 --> 00:13:16,370
!أيُّها الأحمق

164
00:13:16,540 --> 00:13:19,840
!لا تستسلم! قِف وحاول مجدّداً

165
00:13:20,000 --> 00:13:24,590
نفدت طاقتي السحريّة ولياقتي

166
00:13:25,220 --> 00:13:28,300
لكن تمكّنتُ من إنقاذ داي

167
00:13:28,470 --> 00:13:29,640
أعتقد هذا يكفي

168
00:13:29,800 --> 00:13:31,930
!أيّها الأحمق الصّغير

169
00:13:32,270 --> 00:13:35,440
...لو لم تتردّد

170
00:13:35,850 --> 00:13:40,020
!لتمكّنتَ من الخروج سالماً كذلك

171
00:13:40,190 --> 00:13:41,230
!لماذا فعلت ذلك؟

172
00:13:44,150 --> 00:13:47,570
آسف. تجمّدتُ عندما رأيتُك

173
00:13:49,070 --> 00:13:50,370
ماذا؟

174
00:13:51,160 --> 00:13:56,460
في تلك اللّحظة، رؤيتك تحاول مُستميتاً
...أن تساعدنا كي ننجو

175
00:13:56,830 --> 00:14:00,000
لم تعُد تبدو غريباً بالنسبة لي

176
00:14:03,550 --> 00:14:08,680
عرفتُ بأنّك لن تنجو في كلّ الأحوال

177
00:14:09,340 --> 00:14:13,600
لكن لم أستطع... تركك والرّحيل ببساطة

178
00:14:14,430 --> 00:14:16,350
!أعني انظر إلى حالك

179
00:14:16,980 --> 00:14:19,350
قاتلتَ لأجل شرفك

180
00:14:20,440 --> 00:14:22,980
تعاونتَ مع زملائك

181
00:14:23,650 --> 00:14:24,900
عملتَ بجدّ

182
00:14:25,650 --> 00:14:30,200
...لمقاتلتِنا بنزاهة، فعلتَ

183
00:14:30,530 --> 00:14:32,950
!فعلتَ كلّ ما بوسعك باستماتة

184
00:14:36,250 --> 00:14:39,080
فكيف هذا يجعلك مختلفاً عنّا؟

185
00:14:41,080 --> 00:14:42,630
!نحن متشابهون

186
00:14:43,710 --> 00:14:44,960
...بوب

187
00:14:45,130 --> 00:14:46,340
...أنت

188
00:14:47,550 --> 00:14:51,010
...رؤيتك تتبدّد هكذا

189
00:14:51,390 --> 00:14:54,010
لم أستطع حمل نفسي على تجاهلك

190
00:14:54,310 --> 00:14:55,810
مددتُ يدي لك

191
00:14:56,930 --> 00:15:00,190
لهذا السّبب... لم أستطع الإمساك بداي

192
00:15:01,690 --> 00:15:03,520
أنا أخرق

193
00:15:04,070 --> 00:15:08,240
لأنّني أموت مُحاولاً إنقاذ عدوّي اللّدود

194
00:15:09,200 --> 00:15:12,530
قد يوبّخني المُعلّم أفان في الحياة الآخرة

195
00:15:13,410 --> 00:15:16,370
لا. مُحال أن يوبّخني

196
00:15:17,580 --> 00:15:20,040
سيتفهّم شعوري

197
00:15:20,410 --> 00:15:22,540
!بوب

198
00:15:31,720 --> 00:15:33,260
هادلَر؟

199
00:15:38,520 --> 00:15:41,480
هل... تبكي؟

200
00:15:42,810 --> 00:15:46,320
بوب... لا أصدّق ذلك

201
00:15:47,150 --> 00:15:49,280
...أن تهبَ حياتك

202
00:15:49,690 --> 00:15:51,610
!لأجل شخص مثلي

203
00:15:54,620 --> 00:15:55,830
!سامحني

204
00:15:59,120 --> 00:16:01,080
عمّاذا تتكلّم؟

205
00:16:01,540 --> 00:16:05,170
لولا وجودك هنا، ما كنتُ لأستطيع استخدام ميدروا

206
00:16:06,880 --> 00:16:09,260
شكراً لك يا هادلَر

207
00:16:13,550 --> 00:16:16,140
دموعك تتبخّر فوراً

208
00:16:16,800 --> 00:16:19,220
إنّه مكان سيّئ جدّاً للموت فيه

209
00:16:20,100 --> 00:16:24,730
لكن لنذهب معاً! فالمعلّم أفان
!ينتظرنا في الحياة الآخرة

210
00:16:30,070 --> 00:16:31,320
!يا إله

211
00:16:31,820 --> 00:16:33,990
!يا إله البشر

212
00:16:34,490 --> 00:16:37,620
!كظلاميّ، هذه صلاتي الأولى

213
00:16:37,780 --> 00:16:44,790
...إن كنت تمتلك حقّاً القوّة لتتسيّد أرواح البشر

214
00:16:44,960 --> 00:16:46,540
!فأنقذه

215
00:16:46,710 --> 00:16:51,050
!أنقذ هذا الرّجل العظيم

216
00:16:51,550 --> 00:16:58,680
!أرجوك لا تدعه يموت لأجل وحش مثلي

217
00:16:59,640 --> 00:17:02,680
!أيّها الإله

218
00:17:04,690 --> 00:17:07,560
!وها هي النّهاية الفخمة

219
00:17:08,110 --> 00:17:10,860
!فلتنطفئ أيّها القذر

220
00:17:13,400 --> 00:17:14,490
!تبّاً

221
00:17:15,150 --> 00:17:16,820
!لا

222
00:17:18,950 --> 00:17:20,620
!بوب

223
00:17:47,600 --> 00:17:48,600
بوب؟

224
00:17:51,520 --> 00:17:54,280
ما هذا؟

225
00:17:55,110 --> 00:17:57,490
مهلاً، مهلاً يا بوب

226
00:17:57,660 --> 00:18:00,240
لا نريدك أن تذهب إلى الحياة الآخرة

227
00:18:03,580 --> 00:18:07,040
حتّى لو فعلت، لن تجدني أنتظرك هناك

228
00:18:09,880 --> 00:18:11,340
...مستحيل

229
00:18:11,960 --> 00:18:13,300
هل هذا حلم؟

230
00:18:14,130 --> 00:18:15,510
...لا

231
00:18:16,050 --> 00:18:17,260
...ظننتُ

232
00:18:25,180 --> 00:18:26,230
!مستحيل

233
00:18:33,730 --> 00:18:35,110
كيف؟

234
00:18:38,700 --> 00:18:40,030
!كيف؟

235
00:18:50,630 --> 00:18:53,250
!مـ-معلّم؟

236
00:18:54,670 --> 00:18:55,710
!غير ممكن

237
00:18:57,130 --> 00:18:58,470
!لا بدّ وأنّني أحلم

238
00:18:59,010 --> 00:19:00,430
...أو

239
00:19:00,800 --> 00:19:02,760
!أهذه هي الحياة الآخرة فعلاً؟

240
00:19:13,650 --> 00:19:17,490
سيتوجّب عليك الانتظار قليلاً لتُشفى يا بوب

241
00:19:20,150 --> 00:19:24,530
...يبدو أنّني مَدين لك بالامتنان

242
00:19:25,080 --> 00:19:26,040
يا هادلَر

243
00:19:26,200 --> 00:19:30,500
هل... هل أنت أفان حقّاً؟

244
00:19:32,210 --> 00:19:37,960
أنا متفاجئ. لم أتوقّعك أنت بالذّات أن تنقذ تلميذي

245
00:19:38,920 --> 00:19:42,800
هادلَر الّذي عرفتُه من غير المُمكن
أن يفعل شيئاً كهذا

246
00:19:43,090 --> 00:19:47,640
يبدو أنّك لم تعد نفس الرّجل

247
00:19:47,810 --> 00:19:51,140
الّذي عرفتُه في السّابق يا ملِك الظّلام هادلَر

248
00:19:51,310 --> 00:19:52,850
...أنت

249
00:19:53,560 --> 00:19:59,820
أعلم أنّه من الغريب أن أقول هذا لشخص
...قاتلتُه في الماضي مراراً

250
00:19:59,990 --> 00:20:00,990
...لكن صدّقني

251
00:20:01,150 --> 00:20:04,160
!هل تنوي أن تقول، "شكراً لك"؟

252
00:20:05,370 --> 00:20:08,740
!أنت رقيق! رقيق كعادتك

253
00:20:09,790 --> 00:20:11,960
!أنت تثير اشمئزازي

254
00:20:25,850 --> 00:20:30,600
...لن تتدخّل ثانية هذه المرّة

255
00:20:32,100 --> 00:20:33,890
!يا حاصد الأرواح اللّعين

256
00:20:46,780 --> 00:20:48,910
...كيلفارن الوغد ذاك

257
00:20:49,410 --> 00:20:50,490
!هادلَر؟

258
00:20:55,500 --> 00:20:58,040
أعتقد أنّ ذلك كان

259
00:20:58,210 --> 00:21:02,550
آخر ذرّة من قوّتي فعلاً

260
00:21:03,220 --> 00:21:05,380
...هادلَر... أنت

261
00:21:06,800 --> 00:21:08,600
اسمعني يا أفان

262
00:21:09,140 --> 00:21:12,220
ملِك الشّياطين فارن رجل خطير

263
00:21:12,680 --> 00:21:16,060
انسَ الرّحمة. كُن بارداً كالجليد

264
00:21:17,860 --> 00:21:20,900
...إنّها قوّتك

265
00:21:21,070 --> 00:21:24,860
التي يحتاجها تلاميذك للمعركة المُقبلة

266
00:21:33,160 --> 00:21:35,580
كانوا عظيمين

267
00:21:36,500 --> 00:21:39,920
تلاميذك أولئك

268
00:21:40,750 --> 00:21:47,640
لدرجة... أنّهم تمكّنوا من... تغييري تماماً

269
00:21:49,430 --> 00:21:51,430
...بقوّتك

270
00:21:51,600 --> 00:21:55,600
قُدهم... نحو النّصر

271
00:21:56,440 --> 00:21:57,850
!هادلَر

272
00:21:58,690 --> 00:21:59,940
...هكذا

273
00:22:00,980 --> 00:22:02,650
...يمكنك أن

274
00:22:03,110 --> 00:22:05,990
تُظهِر امتنانك لي

275
00:22:13,370 --> 00:22:14,700
...هادلَر

276
00:22:15,000 --> 00:22:16,660
بوب

277
00:22:17,120 --> 00:22:20,290
...يبدو أنّ إلهكم أنتم البشر

278
00:22:20,670 --> 00:22:24,130
لديه حسّ السخرية الشعريّة

279
00:22:26,880 --> 00:22:29,840
...مُقابِل حياتي

280
00:22:30,930 --> 00:22:35,520
...استردَّ إلهكم الكنزَ الّذي سبقَ وسرقتُه

281
00:22:36,140 --> 00:22:39,730
وأعاده إليكم

282
00:22:41,150 --> 00:22:42,980
...ليس ذلك فحسب

283
00:22:45,860 --> 00:22:48,780
...تركني إلهكم أموت

284
00:22:50,070 --> 00:22:51,700
...هنا

285
00:22:52,830 --> 00:22:58,330
بين ذراعَي... هذا الرّجل

286
00:23:06,380 --> 00:23:07,260
هادلَر

287
00:23:08,550 --> 00:23:12,430
في لحظاتك الأخيرة، كنتَ واحداً منّا

288
00:23:13,930 --> 00:23:15,560
...كنتَ

289
00:23:16,220 --> 00:23:17,680
صديقنا

290
00:23:19,600 --> 00:23:20,770
...هادلَر

291
00:23:33,700 --> 00:23:37,120
كان أفان من أنقذَ بوب وهادلَر

292
00:23:37,290 --> 00:23:40,540
كان يُعتقَد بأنّه مات وهو يحمي داي وبوب

293
00:23:40,710 --> 00:23:43,630
،من قائد الشّياطين هادلَر، لكن مع عودته

294
00:23:43,790 --> 00:23:47,550
تلاميذ أفان حائرون ومبتهجون في نفس الوقت

295
00:23:47,710 --> 00:23:53,680
سوية مع أعظم حليف مُمكن، يتوجّه
الفريق إلى قصر فارن

296
00:23:53,840 --> 00:23:55,890
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

297
00:23:57,890 --> 00:23:59,980
!وتستمرّ المغامرة