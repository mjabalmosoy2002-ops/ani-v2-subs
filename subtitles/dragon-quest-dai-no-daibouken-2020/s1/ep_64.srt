1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:55,820 --> 00:01:57,570
!ولا حتّى خدش واحد

20
00:01:58,110 --> 00:01:59,620
!وكأنّه جديد كلّياً

21
00:02:02,120 --> 00:02:06,540
يسرّني أنّك بخير. الآن يمكننا القتال معاً من جديد

22
00:02:07,080 --> 00:02:11,000
هذه المرّة قد تكون المعركة الأخيرة بالفعل

23
00:02:11,170 --> 00:02:13,750
سأستخدم كلّ ما أستطيع من قوّة

24
00:02:13,920 --> 00:02:16,010
آمل أن تدعمني

25
00:02:17,880 --> 00:02:19,680
شكراً لك يا لون بيروك

26
00:02:20,840 --> 00:02:24,140
!تهانينا يا داي! هذا تعزيز هائل لقوّتك

27
00:02:24,770 --> 00:02:29,560
والآن يمكنك استخدام هالتك التنّينيّة
وتمّ تحسين سيف داي، صحيح؟

28
00:02:29,730 --> 00:02:32,110
سيف داي لا يصبح أقوى

29
00:02:33,230 --> 00:02:36,280
أنا من عليه أن يصبح أقوى

30
00:02:36,440 --> 00:02:38,150
بشأن ذلك يا داي

31
00:02:38,740 --> 00:02:41,110
أجريتُ تعديلاً إضافيّاً من عندي

32
00:02:42,030 --> 00:02:45,080
بقي سيفك على حاله كما كان

33
00:02:45,240 --> 00:02:49,920
لكن في المعارك، ينبغي أن تُظهِر قوّة أعظم

34
00:02:50,330 --> 00:02:53,040
السرّ ليس في السّيف بذاته

35
00:02:53,210 --> 00:02:54,290
بل في الغمد

36
00:02:54,460 --> 00:02:55,500
الغمد؟

37
00:02:57,260 --> 00:03:00,430
دوّنتُ التفاصيل هنا

38
00:03:00,590 --> 00:03:02,800
اقرأها كلّها قبل المعركة

39
00:03:06,720 --> 00:03:08,980
حسناً، سأقرأها

40
00:03:09,390 --> 00:03:12,310
...لقد عزّزتُ رمح درع الشّيطان، لكن

41
00:03:13,020 --> 00:03:15,110
سمعتُ أنّ هيونكل قد تعرّض للأسر

42
00:03:18,530 --> 00:03:19,650
هكذا إذاً

43
00:03:21,820 --> 00:03:24,160
أتفهّم الوضع

44
00:03:24,320 --> 00:03:29,960
أنا مندهش من أنّكم قرّرتم اجتياح قصر
فارن بالرغم من كلّ هذه الظروف

45
00:03:30,540 --> 00:03:34,170
يبدو هذا طيشاً أكثر من كونه شجاعة

46
00:03:36,210 --> 00:03:38,710
أعتقد هكذا هم البشر

47
00:03:38,880 --> 00:03:40,720
من هذا الشّخص؟

48
00:03:40,880 --> 00:03:46,760
صنعتُ أسلحة لرفاق داي، لذا ينبغي
لهذا أن يسهّل القتال

49
00:03:46,930 --> 00:03:48,560
لرفاقي؟

50
00:03:48,720 --> 00:03:51,560
!أجل! سترون بأعينكم

51
00:03:59,610 --> 00:04:04,530
.هذا هو رمح درع الشّيطان الجديد
...هذا فأس وهذه عصا

52
00:04:04,700 --> 00:04:06,700
لحظة. أين بوب؟

53
00:04:06,870 --> 00:04:10,540
ماذا؟ لم أره منذ مدّة

54
00:04:12,540 --> 00:04:15,000
يبدو بأنّه ذهب إلى الغابة خلف الحصن

55
00:04:15,170 --> 00:04:18,090
هكذا إذاً. أعتقد أنّ بوب يتدرّب أيضاً

56
00:04:18,250 --> 00:04:20,130
هذا لي إذاً؟

57
00:04:20,300 --> 00:04:22,550
...أجل. هذا سلاحكِ الجديد

58
00:04:24,380 --> 00:04:25,720
قبضة درع الشّيطان

59
00:04:26,550 --> 00:04:28,140
قبضة درع الشّيطان؟

60
00:04:28,310 --> 00:04:31,180
سيعمل بشكل أفضل بيدكِ غير المُهيمِنة

61
00:04:32,850 --> 00:04:36,440
حصل الجميع على أسلحة جديدة

62
00:04:36,610 --> 00:04:38,230
هناك واحد لك أيضاً

63
00:04:38,400 --> 00:04:42,150
!ماذا؟! سلاح جديد من حِرفيّ العالم السّفلي؟

64
00:04:42,320 --> 00:04:44,280
!لا. أنا من صنعتُ هذا

65
00:04:45,490 --> 00:04:47,620
!نانتشاكو الشّائك

66
00:04:48,280 --> 00:04:49,580
!خذ

67
00:04:50,240 --> 00:04:53,000
!سيمزّق هذا أيّ عدوّ

68
00:04:55,210 --> 00:04:58,920
يبدو أنّه سيمزّق يديّ أيضاً

69
00:04:59,340 --> 00:05:01,510
لكن أشكرك على التفكير بي

70
00:05:01,670 --> 00:05:03,050
!مؤلم

71
00:05:06,680 --> 00:05:09,970
!لا داعي للعاطفيّة

72
00:05:10,310 --> 00:05:15,770
لون بيروك، لماذا تساعدنا نحن البشر؟

73
00:05:15,940 --> 00:05:20,070
لم أكن في صفّ ملك الشّياطين من الأساس

74
00:05:20,270 --> 00:05:23,030
فعلتُ ببساطة ما طُلِب منّي فعله

75
00:05:23,190 --> 00:05:27,950
نتيجة ذلك، أصبحت عصا النّهم السّلاح
الأقوى في العالم

76
00:05:28,110 --> 00:05:31,540
لكن هذا لأنّ ملك الشّياطين بحدّ ذاته قويّ جدّاً

77
00:05:31,700 --> 00:05:36,120
ببسيط العبارة، حتّى السكّين تصبح أكثر قوّة بين يديه

78
00:05:36,750 --> 00:05:40,380
إنّه أكثر زبون مُضجِر قد يحظى به صانع أسلحة

79
00:05:40,670 --> 00:05:43,300
لماذا أساعدكم؟

80
00:05:43,460 --> 00:05:48,390
تبدو مساعدة الضّعيف أكثر متعة. هل
هذا كافٍ للإجابة عن سؤالك؟

81
00:05:53,600 --> 00:05:55,640
يا له من غريب أطوار

82
00:05:56,350 --> 00:05:57,600
بالفعل

83
00:05:57,770 --> 00:06:00,020
لكنّه ليس شخصاً سيّئاً

84
00:06:00,520 --> 00:06:05,190
،حسناً! لننقذ كروكوداين وهيونكل
!ونسلّمهما هذين السّلاحين

85
00:06:05,570 --> 00:06:06,490
!أليس كذلك يا رفاق؟

86
00:06:08,200 --> 00:06:13,080
...إذاً سآخذ هذا الفأس إلى السيّد كروكوداين

87
00:06:14,290 --> 00:06:16,250
أو هذا ما خلتُه

88
00:06:16,410 --> 00:06:17,370
!كوماتشا

89
00:06:19,000 --> 00:06:20,960
يستطيع جنديّ فصيلي حمله

90
00:06:21,130 --> 00:06:23,340
...إذاً سأحمل الرّمح والعصا

91
00:06:24,710 --> 00:06:26,010
آنسة أيمي؟

92
00:06:26,300 --> 00:06:28,630
دعيني آخذ هذا الرّمح

93
00:06:30,180 --> 00:06:34,310
أريد أن أسلّمه للرجل الّذي أحبّه شخصيّاً

94
00:06:37,350 --> 00:06:38,600
إنّها جادّة

95
00:06:39,310 --> 00:06:41,650
أنا واقعة في حبّ هيونكل

96
00:06:43,690 --> 00:06:46,530
في البداية، بدا مُخيفاً جداً

97
00:06:46,690 --> 00:06:51,780
فأساساً إنّه قائد الفيلق الّذي دمّر بلدنا

98
00:06:51,950 --> 00:06:54,870
...لكن بدأتُ أدرك تدريجيّاً

99
00:06:55,370 --> 00:06:58,330
بأنّه طاهر وحسّاس

100
00:06:58,500 --> 00:07:03,540
وبأنّ قلبه كما الزجاج، حادّ لكن هشّ

101
00:07:03,710 --> 00:07:06,710
وجدتُ نفسي أنجذب نحوه رويداً رويداً

102
00:07:07,260 --> 00:07:12,140
قبل المعركة السّابقة، أخذتُ هذا الرّمح منه

103
00:07:12,800 --> 00:07:16,970
لم أرده أن يقاتل. كي لا يتأذّى

104
00:07:18,680 --> 00:07:20,640
!لم أكن أعلم

105
00:07:21,390 --> 00:07:24,270
لكن أدركتُ أنّني كنتُ مخطئة

106
00:07:24,440 --> 00:07:28,150
كلّ ما فعلتُه كان زيادة معاناته

107
00:07:28,320 --> 00:07:31,320
...إذا كان العيش في ساحة معركة هو ما يرغبه

108
00:07:31,490 --> 00:07:34,530
...إذا كان قدره هو أن يذبل في الجحيم

109
00:07:35,080 --> 00:07:37,240
!فعليّ أن أتقبّل ذلك بصدر رحب

110
00:07:37,410 --> 00:07:39,450
!سأذهب معه إلى الجحيم

111
00:07:42,790 --> 00:07:46,800
مام، لا تمانعين أن أعطيه هذا، صحيح؟

112
00:07:50,090 --> 00:07:52,630
إذاً أعتقد سآخذ هذا إلى بوب

113
00:07:54,390 --> 00:07:55,430
...مام

114
00:07:57,220 --> 00:08:01,730
سنساندكِ، لذا احرصي على تسليمه له

115
00:08:01,890 --> 00:08:04,810
وأفصحي له عن مشاعركِ عندما تفعلين

116
00:08:04,980 --> 00:08:07,770
فعلتُ ذلك سلفاً، لكنّه رفضني

117
00:08:07,940 --> 00:08:10,940
لماذا يرفض حسناء مثلكِ؟

118
00:08:11,110 --> 00:08:12,360
ماذا يجدر بنا أن نفعل؟

119
00:08:12,530 --> 00:08:14,950
!يا له من انقلاب للأحداث! هذا حماسيّ

120
00:08:16,700 --> 00:08:18,490
ليس هذا ما قصدت

121
00:08:18,660 --> 00:08:21,450
هل هذا مهمّ؟ يحقّ للناس أن يحبّوا ما يحلو لهم

122
00:08:21,620 --> 00:08:25,960
بالإضافة إلى ذلك، تغفل مام جاذبيّتها الخاصّة

123
00:08:26,460 --> 00:08:29,380
هذه فرصة مؤاتية لها كي تنمو كشخص

124
00:08:29,920 --> 00:08:32,840
كلماتكِ وتعابير وجهكِ غير متطابقين

125
00:08:33,800 --> 00:08:34,840
ماذا؟

126
00:08:38,680 --> 00:08:40,100
ما الّذي يجري؟

127
00:08:40,270 --> 00:08:42,430
!لا شيء! لا داعي للقلق بشأن أيّ شيء

128
00:08:42,600 --> 00:08:46,770
إذا أُقحِمَتْ ميرلي، ستزداد الأمور سوءاً

129
00:08:46,940 --> 00:08:50,980
الملكة فلورا، الطعام جاهز للجميع الآن

130
00:08:52,150 --> 00:08:55,950
!حالما نأكل، تفقّدوا أسلحتكم مرّة أخيرة

131
00:08:56,110 --> 00:08:58,780
ثمّ ارتاحوا أكبر قدر ممكن

132
00:08:59,530 --> 00:09:01,410
!غداً، سنذهب للحرب

133
00:09:14,010 --> 00:09:15,630
...لم أكن أعلم

134
00:09:16,180 --> 00:09:18,720
أنّ الآنسة أيمي تكنّ تلك المشاعر تجاه هيونكل

135
00:09:19,220 --> 00:09:20,970
ماذا عنّي؟

136
00:09:21,430 --> 00:09:23,640
كيف هو شعوري؟

137
00:09:27,400 --> 00:09:32,440
وفقاً للمُجلّد القديم، خمسة أنواع من قوّة
الرّوح مطلوبة لتعويذة بريق

138
00:09:32,860 --> 00:09:38,620
الأنواع الخمسة هي الشّجاعة والحبّ والثّبات والعدالة

139
00:09:39,070 --> 00:09:43,410
والخامسة كانت باهتة جدّاً يصعب تمييزها

140
00:09:44,200 --> 00:09:47,870
داي هو الشّجاعة ومام هي الحبّ

141
00:09:48,040 --> 00:09:49,830
...ليونا هي العدالة

142
00:09:50,000 --> 00:09:53,130
بينما "الثّبات" تبدو ككلمة مُخصّصة لهيونكل

143
00:09:53,920 --> 00:09:55,670
وتبقى خاصّتي لغزاً

144
00:09:55,840 --> 00:09:59,720
هل أستحقّ كلمة كهذه من الأساس؟

145
00:10:00,350 --> 00:10:03,930
لم أصل إلى هنا إلّا بشقّ الأنفس

146
00:10:04,100 --> 00:10:08,140
كان ذلك لأجل الجميع، لا، لأجلها تحديداً

147
00:10:08,560 --> 00:10:09,560
بوب

148
00:10:12,230 --> 00:10:13,530
!مام؟

149
00:10:24,870 --> 00:10:26,200
!مام؟

150
00:10:26,700 --> 00:10:29,040
آسفة على مقاطعة تدريبك

151
00:10:29,210 --> 00:10:30,580
لا، لا عليكِ

152
00:10:31,460 --> 00:10:33,840
لا يمكنني أن أدعها تعلم

153
00:10:34,000 --> 00:10:38,930
بحقيقة أنّني عاديّ. وبأنّني مختلف عن الآخرين

154
00:10:39,470 --> 00:10:43,760
هذه العصا التي صنعها لك لون بيروك مع التّعليمات

155
00:10:43,930 --> 00:10:45,470
!لون بيروك؟

156
00:10:45,640 --> 00:10:48,850
أصلحَ وأحضر سلاحَي داي وهيونكل

157
00:10:49,020 --> 00:10:52,520
وصنع أسلحة لنا ولكروكوداين أيضاً

158
00:10:52,690 --> 00:10:54,940
مذهل. هذا لطف منه حقّاً

159
00:10:55,110 --> 00:10:57,740
بسيف داي سنكون بأحسن حال

160
00:10:57,900 --> 00:11:00,950
لنرَ ما نوع هذا السّلاح

161
00:11:02,410 --> 00:11:03,910
المعذرة... بوب

162
00:11:05,330 --> 00:11:08,330
هل يمكنني التكلّم معك حول أمر؟

163
00:11:08,500 --> 00:11:10,540
ماذا تريدين فجأة؟

164
00:11:12,380 --> 00:11:14,590
بخصوص... هيونكل

165
00:11:16,050 --> 00:11:20,010
أنا حقّاً لا أعلم مشاعري تجاهه

166
00:11:20,970 --> 00:11:27,600
أخبرتُك أنّني لا أعرف مشاعري تجاه هيونكل كرجل

167
00:11:28,310 --> 00:11:32,600
لم أفكّر حقّاً بالرجال بهذه الطريقة من قبل

168
00:11:33,940 --> 00:11:38,070
لكن عندما قالت الآنسة أيمي أنّها تحبّ هيونكل

169
00:11:38,230 --> 00:11:40,570
تسارع نبضات قلبي

170
00:11:41,030 --> 00:11:43,490
هل يُعقَل أنّني أغار منها؟

171
00:11:43,660 --> 00:11:49,450
أم أنّني مرتبكة فقط لأنّ شخصاً
آخر غيرنا يفهمه؟

172
00:11:50,160 --> 00:11:51,830
...ربّما أنا حقّاً

173
00:11:52,000 --> 00:11:53,420
اصمتي

174
00:11:54,210 --> 00:11:56,170
!قلتُ اصمتي

175
00:11:56,340 --> 00:11:59,880
كيف ينبغي لي أن أعرف عمّا لا تعرفينه
!عن نفسكِ يا غبيّة؟

176
00:12:01,090 --> 00:12:02,550
...ليس عليك أن تعرف

177
00:12:02,720 --> 00:12:06,850
أمامنا معركة غداً لا نعلم إن كنّا سنعود منها

178
00:12:07,010 --> 00:12:09,470
!فتتكلّمين عن الحبّ فجأة؟

179
00:12:10,020 --> 00:12:14,770
!لا يهمّني سواء كنتِ تحبّين هيونكل أو أيّ أحد

180
00:12:21,740 --> 00:12:23,450
أنا آسفة يا بوب

181
00:12:23,610 --> 00:12:29,120
لم أفكّر بحجم التّدريب الّذي كنتَ
تمارسه لأجل يوم غد

182
00:12:29,990 --> 00:12:33,750
أنت الوحيد الّذي أستطيع التحدّث معه
عن هذه الأمور

183
00:12:34,620 --> 00:12:35,500
!أنا آسفة

184
00:12:45,300 --> 00:12:46,930
!أنا حقّاً غبيّ

185
00:12:47,430 --> 00:12:52,930
!أتتني لأنّها وثِقت بي، فرددتُ في وجهها

186
00:12:54,190 --> 00:12:59,520
!لهذا لا أستطيع أن أدع حجرة صغيرة واحدة تتوهّج

187
00:13:00,320 --> 00:13:04,780
!تبّاً

188
00:13:18,540 --> 00:13:20,460
عصايّ الجديدة؟

189
00:13:20,630 --> 00:13:22,340
هذه لي؟

190
00:13:22,880 --> 00:13:24,300
"القضيب الأسود"

191
00:13:24,470 --> 00:13:28,140
تمتصّ هذه العصا القوّة السحريّة وتحوّلها"
"إلى طاقة جسديّة

192
00:13:28,300 --> 00:13:32,970
وتستطيع أيضاً بسط وتغيير الشّكل"
وفقاً لإرادة المُستخدم"؟

193
00:13:43,900 --> 00:13:46,280
!مذهل! هذا الشيء مذهل

194
00:13:46,450 --> 00:13:49,570
!إنّها جوهريّاً نفس عصا النّهم الخاصّة بفارن

195
00:13:49,740 --> 00:13:51,870
!ويمكنها تغيير شكلها أيضاً

196
00:13:52,040 --> 00:13:55,910
يجب أن أشبعها بالقوّة السحريّة

197
00:13:56,080 --> 00:14:00,250
إذا كانت تلك القوّة السحريّة البسيطة تستطيع
...أن تتحوّل إلى تلك القوّة المُدمّرة

198
00:14:00,420 --> 00:14:03,800
فينبغي لهذا أن يكون مُفيداً للهجمات الجسديّة

199
00:14:04,340 --> 00:14:07,300
يتوجّب عليّ فعلها. كلّ شيء أو لا شيء

200
00:14:07,470 --> 00:14:10,850
كلّ ما فعلتُه لم ينجح في جعل شارة أفان تتوهّج

201
00:14:11,430 --> 00:14:14,970
!أملي الوحيد هو أن أكتشف شيئاً أثناء القتال

202
00:14:16,180 --> 00:14:18,850
الجميع يعتمدون عليّ

203
00:14:19,020 --> 00:14:22,360
يمكنني فعل شيء في اللّحظة الأخيرة

204
00:14:23,020 --> 00:14:25,400
!عليّ الإيمان بذلك

205
00:14:26,990 --> 00:14:30,320
أصدقائي، اقترب وقت المعركة

206
00:14:30,660 --> 00:14:33,660
!آمل أن تبذلوا قصارى جهدكم جميعاً

207
00:14:36,370 --> 00:14:37,460
...على ذكر ذلك

208
00:14:37,620 --> 00:14:40,580
قال بعض الجنود أنّه سيكون من الصّعب

209
00:14:40,750 --> 00:14:45,130
تمييز وحوش أمثالنا عن الأعداء في خضمِّ المعركة

210
00:14:46,380 --> 00:14:49,550
!لذا صنعتُ شارات لمغاوير ملك الوحوش البرّية

211
00:14:49,720 --> 00:14:51,510
لديّ واحدة لكل منكم

212
00:14:59,350 --> 00:15:02,060
ودايغو هو الرّقم عشرة

213
00:15:02,440 --> 00:15:04,400
لحظة، هذا غريب

214
00:15:04,570 --> 00:15:05,940
هناك 11 منكم

215
00:15:06,110 --> 00:15:06,690
!مرحباً

216
00:15:08,990 --> 00:15:10,780
!مـ-معلّم؟

217
00:15:10,950 --> 00:15:12,820
!أنت المعلّم بروكينا

218
00:15:12,990 --> 00:15:15,950
معلّم؟ هذا لستُ أنا

219
00:15:16,120 --> 00:15:19,710
أنا مساعد مغاوير ملك الوحوش البرّية رقم 11

220
00:15:19,870 --> 00:15:22,670
!الوحش الغامض، السيّد وحش

221
00:15:23,750 --> 00:15:26,420
لستَ بحاجة لتنكّر

222
00:15:27,170 --> 00:15:31,090
تبدو مساعدة تلاميذي سرّاً رائعة

223
00:15:31,260 --> 00:15:34,850
!وأيضاً، أحتاج لعلامة كذلك

224
00:15:35,010 --> 00:15:36,680
!كما الآخرين

225
00:15:36,850 --> 00:15:38,180
...بئساً

226
00:15:39,020 --> 00:15:44,110
سيتمّ تنفيذ الإعدام في وادي لوروي. رأينا
وحوش جيش الشّياطين محتشدين هناك

227
00:15:44,270 --> 00:15:48,900
هناك جبال من كافّة الأطراف. إذا
حوصِرنا،لا يمكننا الهرب

228
00:15:49,280 --> 00:15:55,120
التّضاريس تشكّل عقبة، لكن المشكلة الكبرى
ستكون عندما يتمّ إطلاق بريق

229
00:15:55,280 --> 00:15:58,790
لن يتمكّن تلاميذ أفان الخمسة القتال

230
00:15:58,950 --> 00:16:03,000
علينا ردع العدوّ بكلّ ما أوتينا من قوّة

231
00:16:03,170 --> 00:16:05,290
سيكون هذا عملي

232
00:16:05,460 --> 00:16:07,170
...سأقود كلّ الجنود

233
00:16:07,340 --> 00:16:10,800
هل سيكون جيش مُرقّع كافياً؟

234
00:16:13,800 --> 00:16:15,010
ما مقصدك؟

235
00:16:15,930 --> 00:16:19,270
ما أقصده هو ما إن ستتمكّنون من الصّمود

236
00:16:19,430 --> 00:16:24,560
إذا اختُرِقَ الخطّ بينما هُم عُزَّل، ستموتون جميعاً

237
00:16:26,230 --> 00:16:27,610
!من طلب رأيك؟

238
00:16:27,770 --> 00:16:31,860
!لسنا هنا في نزوة مثلك

239
00:16:32,030 --> 00:16:33,650
...أنا مستعدّ للمخاطرة بحياتي

240
00:16:34,530 --> 00:16:37,490
لا تفترض أنّك ستفوز بالمخاطرة بحياتك فقط

241
00:16:37,660 --> 00:16:38,580
ستموت عبثاً فحسب

242
00:16:38,740 --> 00:16:39,450
!ماذا؟

243
00:16:39,620 --> 00:16:40,870
!يكفي يا نوفا

244
00:16:41,040 --> 00:16:45,460
استرخِ يا فتى. أنا لا أحاول إهانتك

245
00:16:46,790 --> 00:16:50,090
أسأل ما إن كنتم بحاجة ليد العون

246
00:16:50,840 --> 00:16:51,880
يد العون؟

247
00:16:52,380 --> 00:16:53,970
ستقاتل بنفسك؟

248
00:16:54,130 --> 00:16:58,720
فكّرتُ في أن أتبعكم حتّى النّهاية

249
00:17:11,690 --> 00:17:13,030
داي

250
00:17:13,190 --> 00:17:14,490
ماذا تفعلين؟

251
00:17:14,650 --> 00:17:17,370
أحضّر أعشاباً طبّية للجميع

252
00:17:17,530 --> 00:17:19,080
ماذا تفعل أنت؟

253
00:17:19,740 --> 00:17:23,000
لم أستطع الاسترخاء بما يكفي للنوم

254
00:17:23,160 --> 00:17:26,000
ينبغي لي ذلك، صحيح؟

255
00:17:27,420 --> 00:17:29,670
إذاً ما رأيك بتجربة هذه؟

256
00:17:30,130 --> 00:17:35,340
هذه فاكهة الحلم. ستساعدك في
النّوم وشفاء الإعياء

257
00:17:36,760 --> 00:17:39,890
يُقال بأنّ أصحاب القلوب النقيّة

258
00:17:40,050 --> 00:17:44,770
سيتمكّنون من حلم ما يتمنّون حلمه فعلاً

259
00:17:45,180 --> 00:17:48,310
أنا متأكّدة أنّك سترى حلماً جميلاً

260
00:17:50,610 --> 00:17:53,110
شكراً يا ميرلي. تصبحين على خير

261
00:17:53,280 --> 00:17:55,190
تصبح على خير يا داي

262
00:17:58,700 --> 00:18:01,200
عسى أن تحظى براحة جيّدة اللّيلة

263
00:18:01,370 --> 00:18:08,580
ففي يوم غد، ستخوض معركة تفوق تصوّري حتّى

264
00:19:16,440 --> 00:19:19,320
لا تحزني يا أمّي

265
00:19:19,700 --> 00:19:21,950
لقد اتّخذتُ قراري

266
00:19:22,530 --> 00:19:25,120
سأخاطر بكلّ شيء لأجل هذه المعركة

267
00:19:29,870 --> 00:19:31,870
أعدكِ بأنّني لن أخسر

268
00:19:49,890 --> 00:19:50,810
!داي

269
00:19:51,520 --> 00:19:54,560
تبدو أكثر مرحاً. هل حدث أمرٌ جيّد؟

270
00:19:54,940 --> 00:19:56,570
حلمتُ بأمّي

271
00:19:56,730 --> 00:19:58,190
أمّك؟

272
00:19:58,360 --> 00:20:01,200
كانت أمّي جميلة جدّاً

273
00:20:01,360 --> 00:20:05,570
أردتُ شكر ميرلي على فاكهة الحلم
التي أعطتني إيّاها، لكنّها ليست هنا

274
00:20:05,740 --> 00:20:08,490
غادرتْ مبكّراً مع الآخرين

275
00:20:08,660 --> 00:20:09,750
سوف تقاتل أيضاً

276
00:20:10,160 --> 00:20:11,290
!حتّى ميرلي؟

277
00:20:11,460 --> 00:20:14,000
عارضتُ ذلك، لكن كانت مُصِرّة

278
00:20:14,170 --> 00:20:20,800
بما أنّ العالم سيفنى، فقد فضّلت القتالَ
معنا حتّى لو كانت ضعيفة

279
00:20:21,340 --> 00:20:22,630
هكذا إذاً

280
00:20:22,970 --> 00:20:24,300
أين مام وبوب؟

281
00:20:24,470 --> 00:20:26,800
لا أعرف ماذا يفعلان

282
00:20:31,480 --> 00:20:32,980
مام، هل أنتِ في الدّاخل؟

283
00:20:33,310 --> 00:20:34,020
بوب؟

284
00:20:34,690 --> 00:20:39,110
آسف بشأن البارحة. فقدتُ رباطة جأشي وصرخت

285
00:20:39,280 --> 00:20:41,440
لم أفكّر بمشاعركِ

286
00:20:41,820 --> 00:20:42,610
أنا آسف

287
00:20:42,780 --> 00:20:46,070
لا تقلق. كانت غلطتي أنا

288
00:20:46,620 --> 00:20:48,740
لننسَ أنّ ذلك قد حدث

289
00:20:48,910 --> 00:20:51,000
ولنركّز على اليوم

290
00:20:51,500 --> 00:20:55,580
لا يمكنك أن تفصحي لهيونكل عن مشاعركِ
إن لم تنقذيه أوّلاً

291
00:20:56,460 --> 00:20:57,210
صحيح

292
00:20:58,460 --> 00:21:02,380
بينما تصلّين لهيونكل، صلّي لي يا مام

293
00:21:02,550 --> 00:21:05,970
صلِّي كي لا أفشل في تلك اللّحظة الهامّة

294
00:21:06,140 --> 00:21:07,010
ماذا؟

295
00:21:08,890 --> 00:21:10,890
يبدوان عاديّين

296
00:21:11,060 --> 00:21:12,890
خاب أملكِ؟

297
00:21:13,060 --> 00:21:14,230
!آسف لو تأخّرتُ عليكما

298
00:21:14,390 --> 00:21:15,100
حان الوقت أخيراً

299
00:21:21,440 --> 00:21:25,530
أعلم أنّكم تعلمون هذا جميعاً، لكن
سأقولها على أيّ حال

300
00:21:25,700 --> 00:21:28,660
الفشل ليس خياراً مُتاحاً لنا

301
00:21:28,820 --> 00:21:34,040
إذا افترضتُم أنّه ستنسح لنا فرصة ثانية
لاحقاً، فسوف نخسر

302
00:21:35,830 --> 00:21:39,250
!ستكون هذه معركتنا الأخيرة! مفهوم؟

303
00:21:39,420 --> 00:21:41,300
!حسناً! هيّا بنا جميعاً

304
00:21:42,460 --> 00:21:43,710
!حسناً

305
00:22:07,200 --> 00:22:12,080
بصراحة كنتُ أخرق

306
00:22:12,240 --> 00:22:18,420
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

307
00:22:18,920 --> 00:22:23,880
وحتّى أنّني استخدمتُ الوحدة كسلاح

308
00:22:24,050 --> 00:22:29,800
بحثتُ في الدّيماس عن جواب بسيط

309
00:22:29,970 --> 00:22:35,640
حتّى لو تخلّيتُ عن الحقّ واللّطف

310
00:22:35,810 --> 00:22:41,770
أريد أن أكون موجوداً بجانبك فحسب

311
00:22:41,940 --> 00:22:47,400
أن أنادي باسمك

312
00:22:47,570 --> 00:22:53,410
هو أصعب من أي تعويذة سحريّة

313
00:22:53,580 --> 00:22:59,210
رغم أنّك مقرّب جدّاً منّي

314
00:22:59,370 --> 00:23:01,830
أحبّك

315
00:23:02,000 --> 00:23:05,130
أدركتُ ذلك أخيراً

316
00:23:05,300 --> 00:23:10,260
أن أنادي باسمك

317
00:23:10,430 --> 00:23:16,680
هو السّبب الّذي وُلدت لأجله

318
00:23:16,850 --> 00:23:22,610
سأتخلّص من هذا اللّيل الطويل

319
00:23:22,770 --> 00:23:25,320
وآتي لرؤيتك

320
00:23:25,480 --> 00:23:30,070
إلى حيث أنت الآن

321
00:23:34,030 --> 00:23:38,330
من المُقرّر إعدام هيونكل وكروكوداين في وادي لوروي

322
00:23:38,500 --> 00:23:43,210
يحين الوقت ويظهر قصر فارن وميستوفارن يقترب من هيونكل

323
00:23:43,380 --> 00:23:47,920
يستخدم ميستوفارن الهالة الشيطانيّة في محاولة
لجعل هيونكل خادمه

324
00:23:48,090 --> 00:23:52,800
هل يستطيع هيونكل وكروكوداين الإفلات من هذا المأزق؟

325
00:23:52,970 --> 00:23:55,300
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

326
00:23:55,470 --> 00:23:57,310
"هيونكل الشّيطانيّ"

327
00:23:57,470 --> 00:23:59,680
!وتستمرّ المغامرة