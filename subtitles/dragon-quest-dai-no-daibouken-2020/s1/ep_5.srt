1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,430
لو راقبتني، لسحرتُك

12
00:01:04,600 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,610
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,780 --> 00:01:17,610
أنا أحترق لأنّي أحرقت بالفعل

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:51,980 --> 00:01:53,320
!أزيز

20
00:02:06,540 --> 00:02:07,710
!سيّد أفان

21
00:02:12,040 --> 00:02:14,170
هل الجميع بخير؟

22
00:02:20,840 --> 00:02:21,600
!معلّم

23
00:02:22,890 --> 00:02:25,180
لم أظنّ أنّه امتلك القوة لذلك

24
00:02:28,140 --> 00:02:30,100
معلّم، هل أنت بخير؟

25
00:02:30,940 --> 00:02:35,360
أنا أتألَّم كثيرًا، لكن لا أملك وقتاً لذلك الآن

26
00:02:35,820 --> 00:02:38,860
إنّه أقوى ممّا كان عليه عندما كان ملك الشياطين

27
00:02:39,740 --> 00:02:43,660
ليس ذلك فقط، يُسانده ملِك الشّياطين العظيم

28
00:02:45,240 --> 00:02:49,120
عدوُّنا يفوق توقّعاتنا بكثير

29
00:02:49,660 --> 00:02:51,540
...بقوّتِنا الحاليّة

30
00:02:53,040 --> 00:02:54,170
لا يمكننا الفوز

31
00:02:54,500 --> 00:02:55,250
!لا يمكن

32
00:02:55,420 --> 00:02:59,760
...لهذا السّبب... هدلر، قائد الشّياطين

33
00:03:00,550 --> 00:03:02,550
يجب أن يُهزَم هنا

34
00:03:03,350 --> 00:03:06,260
...وأيضًا يا داي-كن وبوب

35
00:03:07,140 --> 00:03:11,520
أطلب منكما أن تهزما ملِك الشّياطين
!العظيم فارن يوماً ما

36
00:03:19,320 --> 00:03:23,200
استخففتُ بك. أحسنتَ صنعاً أيّها البطل أفان

37
00:03:23,530 --> 00:03:24,620
...أيُعقَل

38
00:03:25,280 --> 00:03:26,830
!معلّم، هل تنوي أن تموت؟

39
00:03:27,410 --> 00:03:29,370
!معلّم، سأقاتل معك

40
00:03:31,040 --> 00:03:32,080
!جلجلة

41
00:03:35,130 --> 00:03:36,250
!ما-ما هذا؟

42
00:03:36,420 --> 00:03:37,710
!إنّها جلجلة

43
00:03:37,880 --> 00:03:38,920
!جلجلة؟

44
00:03:39,340 --> 00:03:41,840
إنّها تعويذةٌ دفاعيّةٌ رفيعة المُستوى

45
00:03:42,010 --> 00:03:46,930
!تحوّل الجسدَ إلى فولاذ وتردع أي هجوم سحريّ

46
00:03:47,810 --> 00:03:49,270
...لكن إذا بقينا هكذا

47
00:03:49,430 --> 00:03:50,930
!لا نستطيع الحركة

48
00:03:52,350 --> 00:03:54,400
ينبغي أن تكونوا بأمان جميعاً الآن

49
00:03:54,810 --> 00:03:58,480
يمكنكم مُشاهدة معركتي الأخيرة من أماكنكم

50
00:03:58,860 --> 00:04:01,070
!...بـ"أخيرة" تعني

51
00:04:01,240 --> 00:04:04,820
!لا تفعل هذا! سأقاتل معك

52
00:04:05,320 --> 00:04:10,950
يا لحماقتك يا أفان. تستهلِك قوّتَك
السحريّة المتبقّية على تلاميذك

53
00:04:24,130 --> 00:04:25,680
!...هذه

54
00:04:26,600 --> 00:04:29,430
!شارتا أفان! شهادتا تخرّج

55
00:04:29,600 --> 00:04:30,810
!تخرّج؟

56
00:04:30,970 --> 00:04:34,900
أعطي هذه للتلاميذ الذين أؤمن
أنّهم مُدرّبون بشكل كامل

57
00:04:35,060 --> 00:04:39,190
داي، أنت تمتلِك إمكانيّات استثنائيّة

58
00:04:43,280 --> 00:04:46,660
يؤسفني أنّ تدريبنا كان مُقتصِراً على ثلاثة أيّام

59
00:04:47,030 --> 00:04:49,330
...لو استمررنا للأيام الأربعة المتبقية

60
00:04:50,120 --> 00:04:53,290
فأنا متيقّنٌ أنّك كنتَ لتصبح بطلاً

61
00:04:54,000 --> 00:04:55,210
!معلّم أفان

62
00:04:55,750 --> 00:04:57,960
لهذا السّبب أعطيك هذه

63
00:04:58,130 --> 00:05:02,260
استمرّ في تدريبِك وكُن بطلاً حقيقيّاً

64
00:05:02,630 --> 00:05:05,430
!...معلّم، أنا

65
00:05:06,050 --> 00:05:06,970
بوب

66
00:05:07,140 --> 00:05:08,680
!لا تفعل

67
00:05:10,350 --> 00:05:13,060
!لا تفعل يا معلّم! لا أريد ذلك

68
00:05:13,810 --> 00:05:19,190
!كفّ عن كونِك مروعًا هكذا! لم ينتهِ تدريبُنا بعد

69
00:05:19,940 --> 00:05:20,900
...بوب

70
00:05:21,440 --> 00:05:26,030
!لا يهمّني إن كنتَ البطل من قبل
!لماذا تفعل كلّ هذا؟

71
00:05:26,570 --> 00:05:29,570
!قلتَ بنفسِك أنّك لا تستطيع هزيمته

72
00:05:30,410 --> 00:05:35,000
ولأنّني لا أستطيع هزيمته يجب أن أخاطِر بحياتي

73
00:05:36,830 --> 00:05:38,500
،بالإضافةِ إلى ذلك يا بوب

74
00:05:38,670 --> 00:05:44,130
أعتقِد أنَّ القوّة التي نكتسبها من خلال
التّدريب ينبغي أن تُستخدَم لمساعدةِ الآخرين

75
00:05:44,710 --> 00:05:51,390
ربما وُهِبَتْ قوّتي إليّ من الآلهة
لحمايتكم في هذا اليوم

76
00:05:51,760 --> 00:05:53,850
!لا تفعل هذا يا معلّم

77
00:05:54,020 --> 00:05:56,850
أنا متأكّدٌ أنّك ستتفهّم يومًا ما

78
00:05:57,020 --> 00:06:00,360
لذا احتفِظ بهذه إلى أن يأتي ذلك اليوم

79
00:06:02,270 --> 00:06:05,360
!معلّم

80
00:06:05,530 --> 00:06:11,070
عجباً. لم تتخرّجا رسميّاً بعد وأنتما
بهذه الانفعاليّة من الآن

81
00:06:12,240 --> 00:06:18,670
.عليكما أن تجتهدا أكثر وأكثر كي تصبحا بطلين يستحقّانهما

82
00:06:20,580 --> 00:06:24,460
براس-سان وغوميتشان، شكراً لكما على كلِّ شيء

83
00:06:25,050 --> 00:06:27,470
!سيّد أفان، لا تتهوّر

84
00:06:28,680 --> 00:06:33,100
لا تقلق. لن أخسر

85
00:06:38,310 --> 00:06:40,440
هل انتهيتَ من توديع تلاميذك؟

86
00:06:41,480 --> 00:06:43,610
!دعنا نتقاتل يا هدلر

87
00:06:45,230 --> 00:06:46,280
حسناً

88
00:06:46,610 --> 00:06:52,030
لكن استهلاكك لآخر ما تبقّى لك من قوّتك السحريّة
لاستخدام "جلجلة" قد حدّد مصيرك

89
00:06:52,200 --> 00:06:56,160
!أنت أيضًا استخدمت معظم قوّتك السحرية

90
00:07:13,090 --> 00:07:13,970
!ها أنا ذا

91
00:07:21,850 --> 00:07:22,730
!أحمق

92
00:07:24,690 --> 00:07:25,940
...في الوضع الرّاهن

93
00:07:27,190 --> 00:07:28,530
...حتّى بالمهارات القتاليّة وحدها

94
00:07:30,530 --> 00:07:32,240
...لديّ أكثر ممّا يكفي

95
00:07:33,030 --> 00:07:34,570
...من قوّة

96
00:07:34,740 --> 00:07:37,580
...لتمزيقك

97
00:07:37,740 --> 00:07:40,290
!إرباً

98
00:07:49,420 --> 00:07:50,340
!معلّم

99
00:07:50,550 --> 00:07:52,470
!تحرّك! تحرّك

100
00:08:10,320 --> 00:08:12,200
!مُت يا أفان

101
00:08:19,370 --> 00:08:20,040
!...أنت

102
00:08:27,460 --> 00:08:29,380
!تعويذة؟! مستحيل

103
00:08:30,510 --> 00:08:33,300
!ينبغي أن تكون قوّتك السحريّة قد نفدت

104
00:08:33,470 --> 00:08:36,090
تتطلّب هذه التّعويذة كمّيةً قليلةً جداً من القوّة السحريّة

105
00:08:36,510 --> 00:08:41,890
لكنّها بدلاً من ذلك، تحوّل طاقةَ الحياة
!إلى قوّةٍ انفجاريّة لهزيمةِ الأعداء

106
00:08:43,480 --> 00:08:45,850
!...لحظة! هذه التعويذة

107
00:08:48,480 --> 00:08:51,110
!توقّف! لا تفعل

108
00:08:52,900 --> 00:08:55,530
!ستموت! ستقتلك أنت أيضاً يا أفان

109
00:08:55,910 --> 00:08:57,570
!أتريد ذلك حقّاً؟

110
00:09:03,080 --> 00:09:06,750
!بوب، داي! أترك الباقي لكما

111
00:09:07,250 --> 00:09:09,880
!توقّف

112
00:09:15,220 --> 00:09:16,380
!ميغانتي

113
00:09:48,170 --> 00:09:49,290
!معلّم

114
00:09:50,540 --> 00:09:53,420
استخدمَ السيّد أفان تعويذةَ ميغانتي

115
00:09:53,840 --> 00:09:55,010
ميغانتي؟

116
00:09:55,340 --> 00:10:01,930
استخدمَ التعويذة المُدمِّرة الأخيرة التي
تستهلِك حياتَه لإنقاذِ حلفائه

117
00:10:02,430 --> 00:10:05,430
...سيّد أفان، أنت حقّاً

118
00:10:05,600 --> 00:10:10,110
ضحّى المعلّم بحياتِه لحمايتِنا

119
00:10:11,400 --> 00:10:12,820
...معلّم

120
00:10:28,410 --> 00:10:29,920
!هل هذا المعلّم؟

121
00:10:37,010 --> 00:10:38,090
!هدلر؟

122
00:10:41,850 --> 00:10:43,760
!لا! أين المعلّم؟

123
00:10:53,900 --> 00:10:56,650
!أمسيتَ ضعيفاً بحقّ يا أفان

124
00:10:57,820 --> 00:11:03,740
،استهلكتَ حياتك لاستخدامِ ميغانتي
!ومع ذلك لم تستطع هزيمتي

125
00:11:05,540 --> 00:11:10,120
!والآن لم يعد هناك ما يُخشى
!لا أحد يعارض جيش الشياطين الآن

126
00:11:11,500 --> 00:11:14,040
!إنّه وحشٌ حقيقيّ

127
00:11:14,210 --> 00:11:15,380
...مستحيل

128
00:11:20,260 --> 00:11:22,510
اللّعنة عليك يا أفان

129
00:11:30,020 --> 00:11:35,860
يجب أن أبيد تلميذيك هنا والآن

130
00:11:38,570 --> 00:11:44,160
لا تقلقا! آثار "جلجلة" الخاصّة بالسيّد
!أفان ما زالت سارية

131
00:11:44,320 --> 00:11:46,780
!ستردع أي هجوم

132
00:11:46,950 --> 00:11:48,200
لا تكن واثِقاً هكذا

133
00:11:48,490 --> 00:11:53,330
عدم قدرتكم على الحركة مُلائم جدّاً

134
00:11:54,330 --> 00:11:55,170
!ماذا؟

135
00:11:55,340 --> 00:11:57,340
!يستطيع استخدام "رشقة" أيضاً؟

136
00:11:57,500 --> 00:12:03,260
.رشقتي الناريّة هي نار جحيميّة خالِصة
تظلّ مشتعِلة إلى أن يُدَمَّر هدفي

137
00:12:03,430 --> 00:12:08,390
أطلقها ببساطة، وفي اللّحظة التي ينتهي
فيها مفعول "جلجلة"، ستتحوّلون إلى رماد

138
00:12:08,930 --> 00:12:10,890
!لا تفعل! أرجوك

139
00:12:11,230 --> 00:12:16,110
،ينبغي أن تكونوا سُعداء. عندما تموتون
يمكنكم الانتقال إلى الحياةِ الآخرة

140
00:12:16,480 --> 00:12:20,690
معلّمكم العزيز ينتظركم هناك

141
00:12:22,150 --> 00:12:25,820
!هذا صحيح! فعلها المعلّم لأجلنا

142
00:12:25,990 --> 00:12:27,950
!وهبَ حياته كي نتمكّن من النجاة

143
00:12:31,200 --> 00:12:35,710
!إن متنا هنا، فلماذا ضحّى بحياتِه إذاً؟

144
00:12:44,630 --> 00:12:49,140
!حافظتُ على حياتي لأنّ المعلّم أهداني إيّاها

145
00:12:59,900 --> 00:13:03,700
!ماذا؟! هل سيكسر "جلجلة" من تلقاءِ نفسه؟

146
00:13:08,370 --> 00:13:10,790
!من يكون؟

147
00:13:16,790 --> 00:13:18,670
!"كسرَ "جلجلة

148
00:13:18,840 --> 00:13:22,920
!أيّها الطفل الشقيّ! فلتحترق

149
00:13:23,090 --> 00:13:25,380
!طلقة

150
00:13:26,840 --> 00:13:27,640
!تكسير

151
00:13:36,850 --> 00:13:38,440
!استخدم داي سِحراً؟

152
00:13:38,600 --> 00:13:40,150
!وهو أقوى من سِحري

153
00:13:40,650 --> 00:13:42,230
...نيراني

154
00:13:43,070 --> 00:13:46,110
!إذاً سأسحقك حتّى الموت

155
00:13:47,610 --> 00:13:49,070
!مُت

156
00:14:03,840 --> 00:14:06,170
!ما هذه القوّة؟

157
00:14:08,760 --> 00:14:11,760
!...مستحيل! هـ-هذه الشارة

158
00:14:22,770 --> 00:14:24,030
!تنّين؟

159
00:14:28,240 --> 00:14:29,660
!ما هذا الضوء؟

160
00:14:29,820 --> 00:14:35,330
!تذكّرت! استخدمَ داي سحراً قويّاً في المعركة من قبل

161
00:14:35,790 --> 00:14:39,120
!ظهرَتْ تِلك العلامة على جبينِه حينها

162
00:14:39,540 --> 00:14:45,380
!شارة تنّين؟! هل هذا الفتى فارِس تنّين؟

163
00:14:45,550 --> 00:14:46,960
!مستحيل

164
00:14:49,720 --> 00:14:50,550
...كيف تجرؤ

165
00:14:51,930 --> 00:14:53,890
!كيف تجرؤ على قتلِ المعلّم؟

166
00:14:54,810 --> 00:14:56,060
!لن أسامحك

167
00:14:57,520 --> 00:15:00,560
!لا تغترّ يا فتى

168
00:15:10,280 --> 00:15:11,280
!أجل

169
00:15:11,860 --> 00:15:17,040
...هذا مستحيل! ربّما تلقّيتُ ضرراً جسيماً من ميغانتي

170
00:15:17,580 --> 00:15:20,540
...وقد يكون تلميذاً من تلاميذ أفان

171
00:15:20,710 --> 00:15:26,050
!لكن كيف يمكن أن يتغلّب عليّ مجرّد طفل؟

172
00:15:30,050 --> 00:15:31,380
!مُت

173
00:15:35,050 --> 00:15:36,560
!مُت! مُت

174
00:15:41,600 --> 00:15:42,600
!خذ هذه

175
00:15:44,310 --> 00:15:45,940
!دويّ

176
00:15:52,320 --> 00:15:52,990
!داي

177
00:15:57,540 --> 00:16:02,460
ما رأيك بهذه؟ استخدمتُ آخر قوايّ
السحريّة على تِلك التّعويذة

178
00:16:03,290 --> 00:16:05,290
من المؤكَّد أنّه مات الآن

179
00:16:09,090 --> 00:16:12,630
!داي! لا تقلْ لي أنّه قتلَك أيضاً

180
00:16:13,130 --> 00:16:17,560
!هذا صحيح! من المُحال أن أخسر

181
00:16:31,150 --> 00:16:32,240
!مستحيل

182
00:16:48,880 --> 00:16:52,130
!لن أخسر! لا سيّما أمامك

183
00:17:02,140 --> 00:17:04,480
!مُت

184
00:17:04,850 --> 00:17:06,150
!داي! فوقك

185
00:17:06,520 --> 00:17:09,190
...استشعِر مدى قوّةِ هجمة المعلِّم

186
00:17:13,030 --> 00:17:15,400
!بنفسِك

187
00:17:17,910 --> 00:17:18,780
!ماذا؟

188
00:17:18,950 --> 00:17:19,990
...أفان

189
00:17:23,040 --> 00:17:26,120
!ستراش

190
00:17:39,100 --> 00:17:44,140
!اللّعنة عليك يا فتى! لن أنسى اسمك وهذا الإذلال

191
00:17:44,480 --> 00:17:48,310
!أقسم أنّني سأقتلك! يا داي

192
00:18:15,050 --> 00:18:16,970
!داي، هل أنت بخير؟

193
00:18:18,340 --> 00:18:20,220
جدّي، غوميتشان

194
00:18:21,470 --> 00:18:22,390
!أين هدلر؟

195
00:18:23,100 --> 00:18:28,730
مع الأسف، يبدو أنّه هرب. رأيتُه
يستخدم جناحَ كيميرا

196
00:18:28,890 --> 00:18:30,190
هكذا إذاً

197
00:18:36,030 --> 00:18:39,450
...معلّم

198
00:18:40,490 --> 00:18:41,820
!معلّم

199
00:18:58,590 --> 00:19:04,850
ظلّت دائرة النّور السحريّة موجودة
حتّى بعد رحيل السيّد أفان

200
00:19:05,010 --> 00:19:07,480
لا يزال يحمينا حتّى الآن

201
00:19:07,980 --> 00:19:10,770
هذا لأنّ المعلّم مذهل

202
00:19:10,940 --> 00:19:12,060
...بوب

203
00:19:12,520 --> 00:19:14,820
داي، ماذا ستفعل الآن؟

204
00:19:15,860 --> 00:19:20,240
هل ستستمرّ في تدريبك على السّحرِ تحت جناحي؟

205
00:19:20,400 --> 00:19:21,700
...أم

206
00:19:22,620 --> 00:19:23,570
...أنا

207
00:19:27,450 --> 00:19:32,790
كلّفَني المعلّم بمهمّة. أن أهزم ملِك
الشّياطين العظيم فارن يوماً ما

208
00:19:35,130 --> 00:19:38,170
...لهذا السّبب... أنا

209
00:19:51,810 --> 00:19:55,110
أرى أنّك تلقّيتَ ضرباً مُبرحاً يا هدلر

210
00:19:55,610 --> 00:20:01,530
سامحني يا ملِك الشّياطين العظيم لجعلِك
تراني وأنا بهذه الحالة

211
00:20:01,700 --> 00:20:03,820
هذا غير مهمّ

212
00:20:04,240 --> 00:20:10,910
فقد دفنتَ البطل أفان. اعتبرها جروح شرف

213
00:20:11,370 --> 00:20:12,290
أجل

214
00:20:12,790 --> 00:20:16,130
وضعتُ كامل ثِقتي بك

215
00:20:16,590 --> 00:20:21,880
بموتِ مُنافسك أفان، لا أحد يستطيع
إيقاف جيش شياطيني

216
00:20:22,050 --> 00:20:26,890
تابِع وحقِّق حلمَك بإسقاطِ العالم

217
00:20:27,050 --> 00:20:27,760
!حاضر

218
00:20:32,440 --> 00:20:34,730
صحيح أنَّ أفان قد مات

219
00:20:35,100 --> 00:20:39,900
لكن ذلك الفتى داي يشكّل تهديدًا أكبر

220
00:20:40,820 --> 00:20:48,280
...قدرته على قهري أنا هدلر قائد الشياطين رغم كوني جريحًا

221
00:20:48,620 --> 00:20:53,080
وتلك العلامة على جبينِه. شارة التنِّين

222
00:20:54,330 --> 00:20:57,790
...إن كان فارس تنّين حقّاً

223
00:20:57,960 --> 00:21:03,420
...وبتدريبِ أفان، إذا تمكّنَ من بلوغ قوّة بطل

224
00:21:04,220 --> 00:21:09,010
!فسوف يصبح أقوى بكثير من أفان

225
00:21:09,600 --> 00:21:13,100
والجروح التي تلقّيتُها منه دليلٌ على ذلك

226
00:21:14,060 --> 00:21:18,980
الجرح الذي ألحقه داي بي يُشفى بشكل
أبطأ من الجرح الذي ألحقه أفان

227
00:21:19,570 --> 00:21:24,530
!في تِلك اللّحظة، تفوّق سيفُ داي على سيفِ معلّمه

228
00:21:29,240 --> 00:21:36,000
إذا تركتُه يعيش، فسيغدو عدوّاً مُرعِباً بالتأكيد

229
00:21:44,340 --> 00:21:48,590
!يجب أن أسحقه! بينما لا يزال غِرّاً

230
00:21:54,680 --> 00:21:58,150
!بجيشِ شياطيني العظيم

231
00:22:20,080 --> 00:22:25,840
اللّطف هو سِحر النّاس اللُّطفاء

232
00:22:26,010 --> 00:22:32,850
ألا أملك خياراً إذاً سوى أن أكون شخصاً عاديّاً؟

233
00:22:33,010 --> 00:22:36,060
لستُ أدري

234
00:22:38,350 --> 00:22:44,020
حتّى لو تغيّر المكان الذي أعتبره موطِناً

235
00:22:44,190 --> 00:22:46,570
اسمعيني يا أُمّاه

236
00:22:46,740 --> 00:22:52,700
لن أبدِّل أولئك الذين أحميهم

237
00:22:53,160 --> 00:22:57,370
أتساءل ماذا كنتِ لتقولي

238
00:22:57,540 --> 00:23:01,580
قد أكون جباناً وصاغِراً أحياناً

239
00:23:01,750 --> 00:23:08,050
ماذا كنتِ لتقولي لي عندما أتردّد؟

240
00:23:08,220 --> 00:23:13,890
بخلافِ الحاضر الذي سعيتُ وراءه

241
00:23:14,050 --> 00:23:19,180
أنا متأكّدٌ أنّكِ كنت لتضحكي على خبيةِ أملي

242
00:23:33,700 --> 00:23:38,000
،بالعزيمةِ الجديدةِ في قلبهما
يغادر داي وبوب جزيرةَ ديرملين

243
00:23:38,160 --> 00:23:41,920
محطّتهما الأولى هي غابة الشّيطان
في مملكةِ روموس

244
00:23:42,080 --> 00:23:45,000
يلتقي داي وبوب بالفتاةِ مام

245
00:23:45,170 --> 00:23:48,670
خُطى الوحوش المُروّعة تدنو

246
00:23:48,840 --> 00:23:52,380
أيستطيع داي وأصدقاؤه عبور الغابة بأمان؟

247
00:23:52,890 --> 00:23:55,970
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

248
00:23:58,020 --> 00:23:59,930
!وتستمرّ المُغامرة