1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

13
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

14
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

15
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

16
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

17
00:01:37,550 --> 00:01:40,140
أنت الأشجع

18
00:01:56,700 --> 00:01:57,860
!ما هذا؟

19
00:01:58,030 --> 00:01:58,910
!انظروا

20
00:02:02,330 --> 00:02:04,120
!اهربوا جميعاً -
!اركض أسرع -

21
00:02:16,970 --> 00:02:18,430
!بلدة بولتوس

22
00:02:22,720 --> 00:02:25,770
سامحوني على سلوكي السيّئ، لكن الوقت يُداهمني

23
00:02:26,220 --> 00:02:30,520
أتيتُ بأنباء من ملكة مملكة كارل، فلورا

24
00:02:37,110 --> 00:02:39,950
أليس هذا المكان بارداً جدّاً؟

25
00:02:40,110 --> 00:02:41,410
!لا تلوميني

26
00:02:41,740 --> 00:02:44,620
!جيش الشّياطين يهيج في كلّ أنحاء العالم

27
00:02:44,790 --> 00:02:45,990
هكذا إذاً

28
00:02:46,160 --> 00:02:47,120
!أنتما

29
00:02:48,000 --> 00:02:49,750
!اصطدنا سمكاً

30
00:02:49,920 --> 00:02:51,290
!جميل

31
00:02:55,090 --> 00:02:56,920
ما هذا؟

32
00:02:57,460 --> 00:02:58,970
عظام طائر؟

33
00:03:04,260 --> 00:03:05,680
!اهربوا

34
00:03:12,730 --> 00:03:15,900
!أين البطل الحقيقيّ بالضبط؟

35
00:03:23,450 --> 00:03:26,580
يا لها من قدرة تدميريّة هائلة

36
00:03:26,740 --> 00:03:29,250
!الملك فارن عظيم حقّاً

37
00:03:30,000 --> 00:03:35,790
أراك هنا يا مولايّ، قائد الشّياطين ميستوفارن

38
00:03:36,170 --> 00:03:39,590
انظر إلى تلك الحفرة

39
00:03:39,760 --> 00:03:45,760
!أنا، زابويرا، أخشى حقّاً قوّة الملك فارن

40
00:03:45,930 --> 00:03:51,730
وحتّى أنّه منحني منصب نائب القائد
في جيش الشّياطين

41
00:03:51,890 --> 00:03:56,270
يسرّني أنّني قطعتُ علاقتي بذلك الأحمق هدلر

42
00:03:58,020 --> 00:03:59,280
زابويرا

43
00:03:59,440 --> 00:04:00,530
نعم؟

44
00:04:00,690 --> 00:04:04,740
،عندما حوّلتَ هدلر إلى شيطان خارق

45
00:04:05,120 --> 00:04:09,120
!ألم تلحظ النّواة السّوداء المزروعة فيه؟

46
00:04:09,490 --> 00:04:14,330
لاحظتُها. لكن تركتُها وشأنها

47
00:04:14,500 --> 00:04:18,170
عرفتُ أنّه سيموت لأجل الملك فارن
،في النّهاية على أيّ حال

48
00:04:18,340 --> 00:04:23,300
وما دام الانفجار لن يطالني، فلم يعنِني الأمر

49
00:04:28,850 --> 00:04:29,720
عفواً؟

50
00:04:31,350 --> 00:04:32,680
!أيّها القذر

51
00:04:32,850 --> 00:04:36,270
!لا يحقّ لك التكلّم بسوء عن هدلر

52
00:04:38,110 --> 00:04:41,490
،أعترف بدورك في إنقاذ الملك فارن

53
00:04:41,650 --> 00:04:46,990
لكن لا أثق أبداً بجرذان مجارير
كلّ همّهم هو نجاحهم فقط

54
00:04:47,530 --> 00:04:52,450
دائماً ما ينقلبون على أسيادهم متى
استدعت الحاجة لذلك

55
00:04:54,080 --> 00:04:57,290
عندما تفعل، فلن أتردّد في قتلك

56
00:05:01,840 --> 00:05:04,760
!قُل ما تشاء

57
00:05:04,930 --> 00:05:07,970
امتلاك القوّة لا يعني كلّ شيء

58
00:05:08,140 --> 00:05:11,600
المهمّ هو أن أكون آخر الصّامدين

59
00:05:13,600 --> 00:05:19,230
أعِدُك أنّني سأجد طريقة لأكون آخر من يضحك

60
00:05:36,540 --> 00:05:37,620
...لقد

61
00:05:38,170 --> 00:05:39,790
فعلتُها

62
00:05:40,130 --> 00:05:42,000
هل جُرِفتُ إلى هنا؟

63
00:05:46,010 --> 00:05:49,680
سبحتِ كلّ هذه المسافة بينما تحملينني؟

64
00:05:49,840 --> 00:05:53,010
لا تنفكّين تذهلينني

65
00:06:01,610 --> 00:06:03,190
!دبّ أكبر؟

66
00:06:03,730 --> 00:06:05,900
!سيكون الأمر سيّئاً من دون قوّتي السحريّة

67
00:06:07,150 --> 00:06:10,410
!لكن عليّ حمايتها مهما كلّف الأمر

68
00:06:13,870 --> 00:06:18,040
!أنا هنا! سأسقطك ولو كلّفني ذلك الموت

69
00:06:26,800 --> 00:06:27,720
!ماذا؟

70
00:06:27,880 --> 00:06:30,430
!وجدتهما أيّها الجنديّ رقم ثمانية

71
00:06:31,800 --> 00:06:33,470
!سيّد بوب

72
00:06:33,640 --> 00:06:34,600
!آنسة مام

73
00:06:36,350 --> 00:06:39,600
حمقى. لا تخيفوني هكذا

74
00:06:39,770 --> 00:06:43,610
!تماسك! سأنقلك إلى حصن الغابة

75
00:06:43,770 --> 00:06:45,320
!أحسنت صنعاً في إيجادهما

76
00:06:46,570 --> 00:06:48,030
حصن الغابة؟

77
00:06:48,190 --> 00:06:52,240
تمّ إنقاذنا بواسطة تنظيم كارل. نحن مُتمركزون هناك الآن

78
00:06:52,410 --> 00:06:54,620
!نجا تنظيم كارل

79
00:06:54,780 --> 00:06:56,200
!وكذلك الملكة فلورا

80
00:07:00,080 --> 00:07:02,330
مضى أربعة أيّام إذاً

81
00:07:02,920 --> 00:07:06,710
!كان جيش الشّياطين يستخدم قلعة الشّياطين الطائرة

82
00:07:06,880 --> 00:07:09,220
لإسقاط قنابل في كلّ أنحاء العالم

83
00:07:09,380 --> 00:07:11,430
على هدف واحد في كلّ يوم

84
00:07:11,590 --> 00:07:15,890
،في البداية، تساءلتُ لماذا لم يكونوا يهاجمون العواصم

85
00:07:16,060 --> 00:07:18,730
لكن بعد الاستماع لروايتكم، عرفتُ الآن

86
00:07:18,890 --> 00:07:20,390
لا يهمّ المكان

87
00:07:20,560 --> 00:07:26,320
يريد ملك الشّياطين تدمير عالم السّطح، وليس غزوه

88
00:07:29,110 --> 00:07:32,490
!لكن على الأقلّ عدتُما بالسّلامة

89
00:07:32,660 --> 00:07:35,450
...أنا متأكّدة أنّ داي وهيونكل وكروكوداين أيضاً

90
00:07:35,620 --> 00:07:37,830
آمل ذلك حقّاً

91
00:07:38,500 --> 00:07:40,540
رأينا ذلك

92
00:07:41,000 --> 00:07:44,500
التنّين الأمّ المُقدّسة الأسطوريّة أخذت داي بعيداً

93
00:07:44,670 --> 00:07:48,840
بينما تلقّى هيونكل والضّخم ضربة مباشرة
من هجمة ملك الشّياطين

94
00:07:49,630 --> 00:07:53,430
لو لم يأتِ هدلر، لكنتُ أنا ومام
وغومي في عداد الموتى

95
00:07:54,680 --> 00:07:56,350
تلقّينا هزيمة نكراء

96
00:07:57,140 --> 00:07:58,470
بالفعل

97
00:07:59,100 --> 00:08:00,270
هذا سيّئ

98
00:08:00,430 --> 00:08:05,560
بوب ومام شعرا برُعب ملك الشّياطين عن كثب

99
00:08:11,110 --> 00:08:15,990
أعتقد... لا شيء يمكننا فعله لإيقافهم

100
00:08:17,160 --> 00:08:19,910
لا يجب أن تقول كلاماً كهذا

101
00:08:24,420 --> 00:08:28,920
كلاكما تلميذا أفان، أليس كذلك؟

102
00:08:31,130 --> 00:08:32,260
!الملكة فلورا

103
00:08:32,420 --> 00:08:34,180
...ماذا؟! إذاً هذا الشخص هو

104
00:08:34,340 --> 00:08:38,640
أجل. نجَتْ من سقوط كارل مع حفنة من الفُرسان

105
00:08:38,810 --> 00:08:42,980
وكانت تتحيّن فُرصة للردّ على جيش الشّياطين

106
00:08:44,520 --> 00:08:47,770
أحضرتنا إلى هنا إلى هذا الحصن

107
00:08:48,270 --> 00:08:50,480
بوب. مام

108
00:08:50,650 --> 00:08:52,530
سمعتُ ما حدث

109
00:08:53,030 --> 00:08:58,160
،إن كنتُما حقّاً تحملان إرادة أفان

110
00:08:58,320 --> 00:09:00,540
يجب ألّا تُظهرا هذا الضّعف

111
00:09:01,790 --> 00:09:03,960
هل عرفتِ المعلّم أفان؟

112
00:09:04,120 --> 00:09:07,330
كان أفان عضواً في تنظيمنا

113
00:09:07,500 --> 00:09:13,720
خاطر بحياته لحمايتنا مع الفارس القيادي، روكا

114
00:09:16,010 --> 00:09:18,850
أجل. مع أبيك

115
00:09:24,310 --> 00:09:30,060
...لكن عندما قادَ هدلر جيشه في هجوم على عالمنا

116
00:09:31,020 --> 00:09:32,820
مرضَ أبي

117
00:09:32,980 --> 00:09:38,360
كأميرة، كان عليّ قيادة جيشي لمقاتلته

118
00:09:39,950 --> 00:09:45,160
لتعزيز معنويات أتباعي، ترتّب عليّ
اتّخاذ موقف حازم وشديد

119
00:09:45,910 --> 00:09:51,840
لكن لم أكن واثقة من قدرتنا على مُقارعة
القوى الخارقة لملك الشّياطين

120
00:09:52,380 --> 00:09:53,710
كنتُ مرتعدة

121
00:09:54,260 --> 00:09:58,340
لم أكن أنا فحسب. كان الجميع في القصر خائفين

122
00:09:58,800 --> 00:10:02,390
!هذا سيّئ! من المُحال أن نتمكّن من هزيمة ملك الشّياطين

123
00:10:02,560 --> 00:10:06,890
في هذه المرحلة، لن نكسب شيئاً من المقاومة اليائسة

124
00:10:07,440 --> 00:10:09,270
حينئذ تكلّم أفان

125
00:10:09,440 --> 00:10:11,150
!كلّا، كلّا، كلّا

126
00:10:11,560 --> 00:10:13,730
عمّاذا تتكلّمون؟

127
00:10:13,900 --> 00:10:17,240
إن لم نفعل شيئاً فحينها لن نكسب شيئاً حقّاً

128
00:10:17,400 --> 00:10:20,740
إذا كان كلّ ما نستطيع فعله هو المقاومة
اليائسة فمسارنا واضح إذاً

129
00:10:21,370 --> 00:10:23,660
!يا أصدقائي، لنقاوم مقاومة يائسة

130
00:10:44,140 --> 00:10:46,930
انفجرتُ ضحكاً

131
00:10:47,100 --> 00:10:49,390
وأمام الجميع

132
00:10:49,940 --> 00:10:51,730
...حينها أدركت

133
00:10:51,900 --> 00:10:57,030
أنّ هذا الرّجل هو بطل بالفطرة يستطيع
أن يمنح أملاً للجميع

134
00:10:59,700 --> 00:11:03,580
،لهذا متى وجدتُ نفسي أفقد الأمل

135
00:11:03,740 --> 00:11:06,790
أكرّس نفسي للمقاومة قدر ما أستطيع

136
00:11:06,950 --> 00:11:10,330
ما زلتُ أؤمن بما قاله

137
00:11:13,590 --> 00:11:15,960
...المعذرة... سموّكِ

138
00:11:19,420 --> 00:11:21,090
...المُعلّم

139
00:11:21,260 --> 00:11:23,970
أعلم. لقد مات، أليس كذلك؟

140
00:11:25,470 --> 00:11:27,770
...فلو كان حيّاً في مكان ما

141
00:11:28,270 --> 00:11:32,480
لما وقف مكتوف الأيدي وسمح لموطنه أن يُدَمَّر

142
00:11:32,650 --> 00:11:35,860
أنا متأكّدة أنّه كان لينقذنا لو استطاع

143
00:11:37,400 --> 00:11:40,530
...فهمت. كانت

144
00:11:41,110 --> 00:11:45,030
كانت واقعة في حبّ المعلّم أفان

145
00:11:56,710 --> 00:12:00,470
!أرغب أن... أقاوم

146
00:12:00,630 --> 00:12:01,970
أنا أيضاً

147
00:12:03,050 --> 00:12:06,140
أعلم أنّني لا أستطيع أن أكون المعلّم أفان

148
00:12:06,300 --> 00:12:09,100
رغم ضعفي، أنا تلميذه

149
00:12:11,230 --> 00:12:12,390
شكراً لكما

150
00:12:12,560 --> 00:12:15,560
لكن لم يحن الوقت بعد. ارتاحا

151
00:12:17,860 --> 00:12:19,690
لديّ خطّة

152
00:12:20,070 --> 00:12:22,240
اتركا قوّتكما تتعافى حاليّاً

153
00:12:22,530 --> 00:12:23,700
مفهوم؟

154
00:12:26,780 --> 00:12:28,120
إنّها امرأة عظيمة

155
00:12:28,280 --> 00:12:32,040
هناك شيء مُطمئن... شيء مؤثّر جدّاً فيها

156
00:12:32,210 --> 00:12:33,160
أليس كذلك؟

157
00:12:33,330 --> 00:12:37,000
أفهم سبب احترامكِ الشّديد لها يا ليونا

158
00:12:37,170 --> 00:12:40,050
إذاً هي والمعلّم أفان كانا معاً

159
00:12:40,210 --> 00:12:42,880
...تتمتّع بجاذبيّة ونضج لدرجة

160
00:12:45,300 --> 00:12:46,510
!أيّها المُنحرف

161
00:12:47,220 --> 00:12:49,680
!الأميرة ليونا! تعالي إلى غرفة القيادة

162
00:12:49,850 --> 00:12:52,020
!جيش الشّياطين يتحرّك تجاه رينغايا

163
00:13:10,450 --> 00:13:11,910
...كم هذا مُملّ

164
00:13:12,290 --> 00:13:16,080
فالأمور تسير بسلاسة

165
00:13:16,250 --> 00:13:18,500
!أتّفق تماماً

166
00:13:18,670 --> 00:13:20,500
أشكّ في ذلك

167
00:13:24,970 --> 00:13:26,760
بطاقة جالبة للنحس

168
00:13:26,930 --> 00:13:30,430
تظهر هذه البطاقة في كلّ مرّة

169
00:13:30,600 --> 00:13:34,980
أتعني أنّ من يستطيع مُقاومتي ما زال موجوداً؟

170
00:13:35,140 --> 00:13:35,940
لستُ متأكّداً

171
00:13:36,100 --> 00:13:39,810
أيّاً كان ما يعنيه هذا، من الواضح بأنّه مُعضلة

172
00:13:39,980 --> 00:13:44,070
لم تخطئ بطاقاتي يوماً

173
00:13:44,240 --> 00:13:46,240
لنستدرجهم للخروج إذاً

174
00:13:46,400 --> 00:13:50,330
لهذا أسرنا ذلكما الاثنين

175
00:13:51,990 --> 00:13:54,910
!سموّك! في الخارج! انظري للسّماء

176
00:13:56,830 --> 00:13:58,460
!التنّين الأم المُقدّسة

177
00:13:58,620 --> 00:14:01,790
،هنا في تيران، حيث نعبد إله التّنانين

178
00:14:01,960 --> 00:14:07,130
تنتهي حياة فارس تنّين الآن

179
00:14:07,300 --> 00:14:08,720
!هل يُعقل أن يكون البطل؟

180
00:14:33,120 --> 00:14:34,540
أين أنا؟

181
00:14:36,450 --> 00:14:39,250
هل... نجوت؟

182
00:14:40,040 --> 00:14:43,000
لا. لقد متّ

183
00:14:45,460 --> 00:14:46,590
!من هناك؟

184
00:14:46,760 --> 00:14:49,880
أنا التنّين الأم المُقدّسة

185
00:14:50,340 --> 00:14:54,760
أشرِف على حياة وموت فرسان التنّين
كخادمة للآلهة

186
00:14:55,100 --> 00:14:56,680
التنّين الأم المُقدّسة؟

187
00:14:57,230 --> 00:14:58,520
تذكّرت

188
00:14:58,940 --> 00:15:04,730
،عندما يموت فارس تنّين، لنقل قوّة الشّارة

189
00:15:04,900 --> 00:15:07,240
يظهر تنّين أسطوريّ

190
00:15:07,610 --> 00:15:13,410
اتّخذتَ شكلاً نجميّاً واندمجت معي

191
00:15:13,570 --> 00:15:18,160
قريباً ستُحمَل روحك إلى عالم الآلهة

192
00:15:18,750 --> 00:15:19,710
...إذاً

193
00:15:20,290 --> 00:15:24,380
سيحلّ مكاني فارس تنّين جديد؟

194
00:15:26,050 --> 00:15:28,550
لن يكون هناك فارس تنّين جديداً

195
00:15:30,170 --> 00:15:32,340
أنت الفارس الأخير

196
00:15:32,510 --> 00:15:35,010
!لـ-لماذا؟

197
00:15:35,180 --> 00:15:40,520
آلهة البشر والظلاميّين والتّنانين خلقوا فُرسان التنّين

198
00:15:40,690 --> 00:15:46,400
لهزيمة أيّ شرّ يُزعزع توازن العالم

199
00:15:46,690 --> 00:15:53,450
لكن على مدى وقت طويل، تطوّرت قوّة هذا الشرّ

200
00:15:53,610 --> 00:15:59,660
يمتلك ملك الشّياطين فارن قوّة أعظم من إله

201
00:16:00,660 --> 00:16:06,210
حتّى بقوّة فارس تنّين، لم يعد بالإمكان مُعاقبة الشرّ

202
00:16:06,380 --> 00:16:09,510
في الواقع، ربّما التغلّب على فرسان التنّين

203
00:16:09,670 --> 00:16:14,800
هو ما جعل الشرّ قويّاً جدّاً

204
00:16:14,970 --> 00:16:16,260
...لكن

205
00:16:16,430 --> 00:16:21,930
لهذا سأختتم تاريخ فرسان التنّين

206
00:16:22,100 --> 00:16:26,610
لم أعد أمتلك قوّة إنجاب فارس جديد على أيّ حال

207
00:16:26,770 --> 00:16:31,900
هناك قوّة شيطانيّة تُنهي حياتي

208
00:16:33,650 --> 00:16:38,530
إذاً لن يكون هناك أحداً يستطيع إيقاف
ملك الشّياطين فارن؟

209
00:16:42,540 --> 00:16:46,540
يمكنك أن تنسى معاركك الصّعبة الآن

210
00:16:46,880 --> 00:16:52,010
يمكن لروحك أن تعود رفقتي إلى السّماوات

211
00:16:58,720 --> 00:17:00,350
ثمّة خطأ ما

212
00:17:00,890 --> 00:17:03,140
لديك روحان

213
00:17:10,230 --> 00:17:10,900
...أ

214
00:17:13,900 --> 00:17:15,360
!أبي

215
00:17:15,910 --> 00:17:17,620
التنّين الأمّ

216
00:17:17,950 --> 00:17:20,910
أنا الفارس الحقيقيّ الأخير، باران

217
00:17:21,080 --> 00:17:25,460
هذا الفتى، داي، وُلِد منّي ومن امرأة بشريّة

218
00:17:25,620 --> 00:17:28,880
الموت الّذي شعرتِ به كان موتي

219
00:17:29,040 --> 00:17:31,590
!ماذا؟! هذا غير ممكن

220
00:17:31,750 --> 00:17:34,340
لم تنتهِ حياة هذا الفتى بعد

221
00:17:34,510 --> 00:17:38,840
من فضلك، أطلب منك منح هذا الفتى فُرصة أخرى

222
00:17:39,010 --> 00:17:40,050
...أبي

223
00:17:40,220 --> 00:17:44,430
لا يستطيع أحد هزيمة ملك الشّياطين
مهما كان قويّاً

224
00:17:44,600 --> 00:17:50,270
حتّى لو أحييتُه، لن يُعاني إلّا من جحيم مؤلم ثانية

225
00:17:50,440 --> 00:17:52,230
لا أتّفق معك

226
00:17:52,940 --> 00:17:57,240
يمتلك هذا الفتى قوّة لا يملكها فارس تنّين عاديّ

227
00:17:57,410 --> 00:17:59,700
شيء ما يفوق مفهوم القوّة

228
00:18:00,160 --> 00:18:01,200
...لكن

229
00:18:01,370 --> 00:18:06,120
تستطيع فُرسان التنّين البقاء لجيل واحد فقط

230
00:18:06,290 --> 00:18:09,380
فكيف استطاع فارس تنّين إنجاب طفل؟

231
00:18:09,750 --> 00:18:16,170
لا بدّ وأنّ الآلهة أدركوا حدود فرسان
التنّين ومنحونا هذا الأمل

232
00:18:16,670 --> 00:18:20,180
...في هذا العالم حيث تحكم القوّة كلّ شيء

233
00:18:20,340 --> 00:18:22,930
قد يستطيع هزيمة الشرّ بروحه

234
00:18:23,600 --> 00:18:28,690
ربّما لهذا سمح الآلهة بولادة هذا الفتى

235
00:18:30,100 --> 00:18:32,270
أرجوكِ يا أمّاه

236
00:18:36,690 --> 00:18:37,740
حسناً إذاً

237
00:18:38,450 --> 00:18:43,450
سأمنح آخر ذرّة من قوّتي لداي

238
00:18:47,750 --> 00:18:48,960
داي

239
00:18:49,420 --> 00:18:54,000
،من الآن فصاعداً، ستُدوّن تاريخ فرسان التنّين

240
00:18:54,300 --> 00:18:56,800
لتُربّي طفلاً مع المرأة التي تحبّ

241
00:18:56,960 --> 00:19:00,720
ولكي تفعل ذلك، يجب أن تهزم فارن

242
00:19:00,890 --> 00:19:02,930
أعلم أنّك تستطيع فعلها

243
00:19:03,100 --> 00:19:04,810
!لا يمكنني

244
00:19:04,970 --> 00:19:06,390
...أنا

245
00:19:06,560 --> 00:19:09,100
!أنا لستُ قويّاً إلى هذه الدّرجة

246
00:19:09,270 --> 00:19:11,350
!لستُ قويّاً مثلك

247
00:19:12,230 --> 00:19:14,440
لستَ وحدك

248
00:19:14,610 --> 00:19:15,900
لديك أصدقاؤك

249
00:19:16,070 --> 00:19:17,280
!أبي

250
00:19:17,690 --> 00:19:20,150
...وسوالا وأنا

251
00:19:20,320 --> 00:19:21,950
سنكون دائماً بجانبك

252
00:19:22,110 --> 00:19:24,080
!انتظر! لا ترحل

253
00:19:24,660 --> 00:19:27,330
!أبي

254
00:19:46,890 --> 00:19:48,180
...أبي

255
00:19:49,310 --> 00:19:50,680
لا ترحل أرجوك

256
00:19:53,020 --> 00:19:55,820
!أحضروا شخصاً يستطيع استخدام تعويذة عودة

257
00:19:55,980 --> 00:19:57,820
!انقلوه إلى الملكة فلورا

258
00:19:57,980 --> 00:19:59,110
!حاضر

259
00:20:10,660 --> 00:20:12,830
لنتركهما على انفراد

260
00:20:19,880 --> 00:20:21,630
هذا مُطمئن

261
00:20:21,800 --> 00:20:25,390
...شكراً لك... على بقائك حيّاً

262
00:20:29,270 --> 00:20:30,560
الملكة فلورا

263
00:20:31,180 --> 00:20:35,560
داي نائم. شُفيت جروحه

264
00:20:35,730 --> 00:20:38,520
هكذا إذاً. هذا جيّد

265
00:20:38,690 --> 00:20:40,320
أنباء سارّة بحقّ

266
00:20:40,900 --> 00:20:44,110
لكن يؤسفني أن أحمل أنباء سيّئة جدّاً

267
00:20:45,530 --> 00:20:50,370
رسالة من جيش الشّياطين أُرسِلت
...إلى البلدان في أرجاء العالم

268
00:20:50,540 --> 00:20:52,830
تستخدم تعويذة تواصُل بالمرايا

269
00:20:56,880 --> 00:20:59,710
إلى البشر الحمقى حول العالم"

270
00:21:00,840 --> 00:21:04,630
،بعد بضعة أيّام، جيشنا، جيش الشّياطين

271
00:21:04,800 --> 00:21:10,100
سيُبدّد عالم السّطح هذا الّذي تقطنونه

272
00:21:10,430 --> 00:21:14,310
لا وسيلة لديكم لإيقافنا

273
00:21:14,730 --> 00:21:19,190
اقبلوا بهذا القدر وموتوا مع عالمكم

274
00:21:19,520 --> 00:21:22,780
،للاحتفال بهذا الإنجاز العظيم

275
00:21:22,940 --> 00:21:26,160
،الخائنان اللّذان ساعدا البطل المهزوم وحزبه

276
00:21:26,320 --> 00:21:31,740
السيّاف الشّيطاني هيونكل وملك الوحوش
البرّية، سيُعدَمان

277
00:21:31,910 --> 00:21:36,670
يستطيع المُهتمّون بهذا الأمر أن يشهدوا
هذا كذكرى يحملونها إلى الحياة الأخرى

278
00:21:36,830 --> 00:21:39,500
،سيموتان ظهراً بعد يومين

279
00:21:39,670 --> 00:21:42,800
في الجبال الشماليّة لمملكة كارل

280
00:21:42,960 --> 00:21:44,090
"هذا كلّ شيء

281
00:21:44,260 --> 00:21:46,880
!يُعدَمان؟! أوغاد

282
00:21:47,050 --> 00:21:50,810
إذاً هيونكل وكروكوداين مُحتجَزان بواسطة جيش الشّياطين

283
00:21:52,010 --> 00:21:54,180
!سنعقد اجتماعاً في الحال

284
00:22:07,240 --> 00:22:12,120
بصراحة كنتُ أخرق

285
00:22:12,280 --> 00:22:18,460
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

286
00:22:18,960 --> 00:22:23,920
وحتّى أنّني استخدمتُ الوحدة كسلاح

287
00:22:24,090 --> 00:22:29,840
بحثتُ في الدّيماس عن جواب بسيط

288
00:22:30,010 --> 00:22:35,680
حتّى لو تخلّيتُ عن الحقّ واللّطف

289
00:22:35,850 --> 00:22:41,810
أريد أن أكون موجوداً بجانبك فحسب

290
00:22:41,980 --> 00:22:47,440
أن أنادي باسمك

291
00:22:47,610 --> 00:22:53,450
هو أصعب من أي تعويذة سحريّة

292
00:22:53,620 --> 00:22:59,250
رغم أنّك مقرّب جدّاً منّي

293
00:22:59,420 --> 00:23:01,880
أحبّك

294
00:23:02,040 --> 00:23:05,170
أدركتُ ذلك أخيراً

295
00:23:05,340 --> 00:23:10,300
أن أنادي باسمك

296
00:23:10,470 --> 00:23:16,720
هو السّبب الّذي وُلدت لأجله

297
00:23:16,890 --> 00:23:22,650
سأتخلّص من هذا اللّيل الطويل

298
00:23:22,810 --> 00:23:25,360
وآتي لرؤيتك

299
00:23:25,520 --> 00:23:30,110
إلى حيث أنت الآن

300
00:23:34,030 --> 00:23:38,950
هيونكل وكروكوداين المفقودان مُحتجزَان
بواسطة جيش الشّياطين

301
00:23:39,120 --> 00:23:43,130
وداي قد عاد بعد الفُراق عن والده، باران

302
00:23:43,290 --> 00:23:49,920
ريثما تُشفى جروح داي، تعذّبه ذكريات
هزيمته على يد فارن

303
00:23:50,090 --> 00:23:54,390
رغم ذلك، يؤمن بوب والآخرون بأنّ داي سينهض من جديد

304
00:23:54,550 --> 00:23:57,060
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

305
00:23:58,810 --> 00:24:00,600
!وتستمرّ المغامرة