1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أشتعل حماساً

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:52,190 --> 00:01:53,690
شكراً على المجيء

20
00:01:54,070 --> 00:01:55,240
كنتُ في الانتظار

21
00:01:56,700 --> 00:02:00,620
مضَتْ سنواتٌ منذ اجتمعنا نحن الثّلاثة

22
00:02:00,780 --> 00:02:06,200
أن يتطلّب الأمرُ جميعنا فلا بدّ
أنّه يحدث شيء مهمّ ما

23
00:02:06,370 --> 00:02:09,670
هل حان الوقتُ لحرقِ العالم؟

24
00:02:11,920 --> 00:02:14,880
ابني، دينو، على قيدِ الحياة

25
00:02:15,840 --> 00:02:17,340
!مولايّ دينو؟

26
00:02:17,510 --> 00:02:22,760
البطل داي، الذي يُقاتِل جيشَ الشّياطين
هو ابني، دينو

27
00:02:22,930 --> 00:02:25,140
يا له من تحوُّل قاسٍ للأحداث

28
00:02:25,310 --> 00:02:28,730
قاتلتُ بالفعل الفريقَ الذي يقوده

29
00:02:29,560 --> 00:02:35,690
كان رابطُ توحّدهم أقوى ممّا توقّعت
وتكبّدتُ بعض الجروح

30
00:02:36,690 --> 00:02:38,530
!جُرِحت؟

31
00:02:38,700 --> 00:02:42,450
لهذا أتيتَ إلى نقطةِ آرغو إذاً

32
00:02:42,620 --> 00:02:47,950
هنا تقع نافورةُ المُعجزات التي تُشفي
فُرسان التنّين

33
00:02:49,540 --> 00:02:51,630
لم يكن ذلك سببي الوحيد

34
00:02:51,790 --> 00:02:54,090
يقصدُ زوجتَه

35
00:02:54,630 --> 00:03:00,430
نتفهّم الأمر يا مولايّ باران. تحتاج
مساعدتنا لاستعادةِ مولايّ دينو

36
00:03:00,930 --> 00:03:04,890
تماماً. لدى ابني بعض الحُلفاء المُزعجين

37
00:03:05,060 --> 00:03:08,520
إنّهم مُستعدّون للمُخاطرة بحياتهم لأجلِ داي البطل

38
00:03:08,680 --> 00:03:12,810
لا سيّما قائدا الفيلقين اللّذان خانا
جيشَ الشّياطين

39
00:03:12,980 --> 00:03:17,610
ملِك الوحوش البرّية كروكوداين والسيّاف الشيطانيّ
هيونكل لا يُستهان بهما

40
00:03:17,780 --> 00:03:18,990
!تمزح بالتأكيد

41
00:03:19,150 --> 00:03:24,700
لا قائد فيلق لجيشِ الشّياطين سِواك
!يستطيع الوقوف في وجهِنا

42
00:03:25,450 --> 00:03:32,420
لعلّكم فرسان التنّين الأقوى من بين جميع
،الظلاميّين والوحوش

43
00:03:32,830 --> 00:03:37,710
لكن قد يمتلِك البشر قوّةً مُرعبةً عندما
يكونون مُستعدّين للموت

44
00:03:38,550 --> 00:03:44,220
إذا قاومَ حُلفاؤه، يجب عليكم أنتم
الثّلاثة أن تسحقوه

45
00:03:45,390 --> 00:03:48,060
في هذه الأثناء، سوف أستعيد ابني

46
00:03:48,220 --> 00:03:48,930
!حاضر

47
00:03:49,520 --> 00:03:53,060
يجب أن أحضِّر للمعركة. انتظروني هنا

48
00:03:55,150 --> 00:03:58,110
مولايّ باران يُبالغ في حذرِه

49
00:03:58,280 --> 00:04:02,030
إنّهم حفنة من البشر ومجموعة خوَنة

50
00:04:02,200 --> 00:04:04,070
!صُن لسانك يا غالداندي

51
00:04:04,240 --> 00:04:08,660
بالفعل. يُقال أنّ الأسد لا يتردّد
عند قتله أرنباً

52
00:04:08,830 --> 00:04:15,630
لا تنسَ أنّ حذره هو ما جعلَ فيلق
التنّين المجيد لا يُهزَم

53
00:04:16,670 --> 00:04:18,550
أعي ذلك بالفعل

54
00:04:24,800 --> 00:04:29,180
...سوالا، هذه المرّة سأعيد دينو

55
00:04:29,850 --> 00:04:32,480
!من قبضةِ أولئك البشر الأوغاد

56
00:04:39,190 --> 00:04:43,820
!سيتوجّه فيلقُ التنّين الآن إلى مملكةِ تيران

57
00:04:43,990 --> 00:04:48,410
عندما ينضمُّ إلينا ابني دينو، ستغدو
!قوّتنا مُطلَقة

58
00:04:48,580 --> 00:04:49,120
!حاضر

59
00:04:49,620 --> 00:04:51,370
!اتبعوني

60
00:05:01,460 --> 00:05:02,840
يا للمفاجأة

61
00:05:03,010 --> 00:05:06,050
تساءلتُ عندما سمعتُ الجميع ينادونك
بـ"الأميرة" من تكونين بالضبط

62
00:05:06,430 --> 00:05:08,970
أنتِ حاكمةُ بابنيكا

63
00:05:09,140 --> 00:05:16,310
خلاف ذلك، لن يصغي ملِك تيران إلينا
بسهولة مهما كانت مملكته صغيرة

64
00:05:20,400 --> 00:05:22,280
سيُقابلكم جلالته الآن

65
00:05:22,440 --> 00:05:26,820
إنّه يشعر بتوعّك ويطلب منكم أن تعفوه
من رؤيته في قاعتِه

66
00:05:26,990 --> 00:05:28,110
لا مُشكلة

67
00:05:29,160 --> 00:05:32,790
سأنتظر في الخارج. نادوني عندما تنتهون

68
00:05:35,160 --> 00:05:36,920
هكذا إذاً

69
00:05:37,370 --> 00:05:41,210
إذاً تلك العاصفة الخارقة سبّبها فارسُ التنّين

70
00:05:41,670 --> 00:05:46,050
وهذا الطفل هو ابنُ فارس التنّين

71
00:05:46,590 --> 00:05:50,390
لعلّها إشارة نفسيّة انتزعَتْ ذكرياته

72
00:05:50,550 --> 00:05:51,930
إشارة نفسيّة؟

73
00:05:52,100 --> 00:05:57,310
إنّها كموجةٍ ذهنيّةٍ مُنبعثة من شارة التنّين

74
00:05:57,480 --> 00:05:59,940
كيف علينا استعادة ذاكرته؟

75
00:06:00,110 --> 00:06:01,820
لا أعلم

76
00:06:02,150 --> 00:06:04,990
نحن نعبد إلهَ التّنانين فحسب

77
00:06:05,150 --> 00:06:10,530
نعرف فارسَ التنّين، لكن لا نعرف حجمَ قِواه

78
00:06:10,910 --> 00:06:12,280
هكذا إذاً

79
00:06:12,450 --> 00:06:16,080
إذاً هلّا سمحتَ لنا باستخدام هذه
القلعة كملجأ لداي؟

80
00:06:16,620 --> 00:06:18,790
ما زلتُم تريدون القتال؟

81
00:06:18,960 --> 00:06:19,960
أجل

82
00:06:20,130 --> 00:06:25,460
قد يعتبِر شعبُ تيران هجومَ باران
،كمشيئة إلهيّة

83
00:06:25,630 --> 00:06:27,970
لكنّه عُدوان ضدّ البشريّة

84
00:06:28,130 --> 00:06:30,510
سنُقاوم العُدوان

85
00:06:30,680 --> 00:06:35,600
هكذا إذاً. كنتُ قد سمعتُ عن شجاعةِ
أميرة بابنيكا

86
00:06:39,270 --> 00:06:40,100
كانار

87
00:06:40,270 --> 00:06:41,350
!أمرُك

88
00:06:41,520 --> 00:06:45,400
ساعِد الأميرة ليونا

89
00:06:45,570 --> 00:06:46,650
حاضر جلالتك

90
00:06:47,360 --> 00:06:49,320
شكراً لك يا جلالة الملِك

91
00:06:51,110 --> 00:06:54,870
أخبريني، هل أنتِ العرَّافة الشّهيرة؟

92
00:06:55,040 --> 00:06:57,500
أجل. أنا نابارا

93
00:06:57,660 --> 00:06:59,040
وهذه الفتاة؟

94
00:06:59,210 --> 00:07:01,540
حفيدتي ميرلي

95
00:07:01,710 --> 00:07:03,290
اقتربي

96
00:07:05,800 --> 00:07:07,050
أمرُك

97
00:07:16,350 --> 00:07:19,020
تمتلكين قوّةً تفوق قوّةَ جدّتكِ

98
00:07:19,180 --> 00:07:24,270
بالفعل. أصبحَتْ تشعر مؤخّراً بأشياء
لا أستطيع الشُّعور بها

99
00:07:25,940 --> 00:07:32,320
قوّتكِ ستكشف لكِ قريباً أموراً فظيعة
ومُروّعة سوف تحدث

100
00:07:32,490 --> 00:07:33,030
!ماذا؟

101
00:07:33,200 --> 00:07:36,370
لا تمقتي قوّتكِ

102
00:07:36,530 --> 00:07:40,250
ستُساهم في نهايةِ المطاف في إنقاذِ البشريّة

103
00:07:40,410 --> 00:07:43,540
ثِقي بأنَّ ذلك اليوم سوف يأتي وابقي قويّة

104
00:07:43,880 --> 00:07:45,250
أمرُك

105
00:07:49,210 --> 00:07:50,260
!ما الخطب؟

106
00:07:50,420 --> 00:07:55,050
!إنَّها قادمة! طاقة غضب شديد
!نحو هذا البلد مُباشرة

107
00:07:55,220 --> 00:07:56,600
!تقصدين باران؟

108
00:07:56,760 --> 00:07:58,220
!سيأتي من الآن؟

109
00:07:58,390 --> 00:07:59,930
!وهذا ليس كلّ شيء

110
00:08:00,310 --> 00:08:03,850
!طاقات مُشابِهة أخرى... عددها ثلاثة

111
00:08:05,440 --> 00:08:06,980
!ماذا تفعلون؟

112
00:08:07,150 --> 00:08:09,440
!أخرجوني! أخرجوني من هنا

113
00:08:09,610 --> 00:08:11,530
أليس من المُبالَغة زجّه في السّجن؟

114
00:08:11,700 --> 00:08:16,120
لكن هذا هو المكان الأعمق والأكثر
تحصيناً في القلعة

115
00:08:16,280 --> 00:08:16,780
...لكن

116
00:08:16,950 --> 00:08:19,580
!أخرجوني! أخرجوني

117
00:08:21,540 --> 00:08:24,750
أيّتها الآنسة الصّغيرة، أتعرفين معنى "دمغ"؟

118
00:08:25,960 --> 00:08:29,880
،إنّه عندما تُفقَس بيضةٌ ويخرج منها حيوان

119
00:08:30,050 --> 00:08:33,090
ويعتبِر هذا الحيوان أنَّ أوّل شيء يراه هو والده

120
00:08:33,970 --> 00:08:38,470
باران أرجعَ داي إلى شخص كأنّه وُلِدَ حديثاً

121
00:08:38,970 --> 00:08:45,940
إذا واجهَ داي باران الآن، فسوف يقبله
على الأرجح كأبٍ له

122
00:08:46,350 --> 00:08:50,150
يحملان نفس العلامة كدليلٍ قاطِع

123
00:08:50,320 --> 00:08:54,400
هذا قاسٍ، لكن هذه هي الطريقة
الوحيدة لمنعِ ذلك

124
00:08:55,410 --> 00:08:59,580
سنتولّى الباقي. احمِ الملِك من فضلِك

125
00:08:59,740 --> 00:09:02,700
يؤسفني ألّا أستطيع تقديم المزيد

126
00:09:07,380 --> 00:09:08,540
...داي

127
00:09:13,920 --> 00:09:18,180
إنّهم مُتوجِّهون مُباشرة نحو تيران
من الجهة الجنوبيّة الشرقيّة

128
00:09:18,340 --> 00:09:20,310
هل يمكنكِ أن تُرينا إيّاهم أيّتُها السيّدة العجوز؟

129
00:09:20,470 --> 00:09:21,350
أستطيع ذلك

130
00:09:35,400 --> 00:09:36,990
!من هؤلاء؟

131
00:09:37,160 --> 00:09:40,450
هؤلاء هم مصادِر الطّاقة الثّلاثة غير باران؟

132
00:09:40,620 --> 00:09:43,160
!هل يُعقل أن يكونوا أسياد التنّين؟

133
00:09:43,330 --> 00:09:44,160
أسياد التنّين؟

134
00:09:44,330 --> 00:09:47,920
أقوى فرسان تنّين يخدمون باران

135
00:09:48,080 --> 00:09:53,710
بقيادتِهم للتنانين، يُقال بأنّهم أنداد
حتّى لقادةِ الفيالق

136
00:09:54,300 --> 00:09:57,130
تقصد أنّه أحضر معه ثلاثة أشخاص
كلّ واحد منهم بمثلِ قوّتك؟

137
00:09:57,880 --> 00:10:01,640
قد لا نكون أقوياء بما يكفي لردعِهم

138
00:10:01,810 --> 00:10:05,230
كانت مُقاتلة باران بحدِّ ذاتها صعبة

139
00:10:05,600 --> 00:10:08,190
ليتَ هيونكل هنا

140
00:10:15,400 --> 00:10:18,570
قُضي علينا. هذه نهاية الأمر على ما أعتقِد

141
00:10:18,740 --> 00:10:19,950
بوب؟

142
00:10:20,120 --> 00:10:23,080
آسف، لكن لستُ مستعدّاً للموت عبثاً

143
00:10:23,240 --> 00:10:27,750
سأنسحب الآن. افعلوا ما تشاؤون

144
00:10:27,910 --> 00:10:30,500
!ما الذي تقوله فجأة؟

145
00:10:30,670 --> 00:10:32,840
أقول أنّني سأخرج من هنا

146
00:10:33,000 --> 00:10:38,260
إن كانوا بتلك القوّة، فلا جدوى من
!المُقاومة. يا للهراء

147
00:10:38,420 --> 00:10:41,550
!بوب، هل تفهم ما تقوله؟

148
00:10:41,720 --> 00:10:44,260
!أنتم من لا تفهمون

149
00:10:44,850 --> 00:10:48,270
داي بهذا الشّكل ونحن ننهار

150
00:10:48,430 --> 00:10:50,810
كيف سنُواجه أقوى فيلق على الإطلاق؟

151
00:10:50,980 --> 00:10:54,570
تفكيركم بالقتالِ الآن هو ضربٌ من الجنون

152
00:10:54,730 --> 00:10:58,900
ظننتُ أنَّ القِتال لأجلِ أصدقائك
،حتّى عندما يكون الأمل معدوماً

153
00:10:59,070 --> 00:11:02,070
كان ما آمنتُم به أنتم تلاميذ آفان

154
00:11:02,490 --> 00:11:06,740
،إذا وقعَ داي في قبضتِهم الآن
!سيفنى عالمُ البشر

155
00:11:06,910 --> 00:11:09,960
!هذا صحيح! أنت أعزّ صديق لداي على حدِّ علمي

156
00:11:10,120 --> 00:11:13,130
!هل ترغب حقّاً في تركِ داي والهرب الآن؟

157
00:11:14,630 --> 00:11:18,050
لا تقلقوا بشأنِه. إنّه ليس بشريّاً حتّى

158
00:11:18,210 --> 00:11:22,720
إنّه واحدٌ منهم. لمَ لا نُعيده إليهم؟

159
00:11:22,890 --> 00:11:24,680
!سيعتنون به جيّداً

160
00:11:30,980 --> 00:11:33,810
حسناً. اغرب عن وجهي

161
00:11:33,980 --> 00:11:36,270
لن يقبل بمُساعدة أمثالك

162
00:11:38,530 --> 00:11:41,450
!هذا يُريحني إذاً. شكراً

163
00:11:41,610 --> 00:11:42,780
!بوب

164
00:11:42,950 --> 00:11:44,280
!انتظر يا بوب

165
00:11:44,450 --> 00:11:46,660
!لا تتبعه يا كروكوداين

166
00:11:46,830 --> 00:11:50,120
نحتاجك هنا للدفاعِ عن هذا المكان

167
00:11:50,290 --> 00:11:51,460
!...لكن

168
00:11:55,750 --> 00:11:56,500
...سعادة الأميرة

169
00:11:57,590 --> 00:12:01,840
لطالما أُعجِبتُ بتلاميذ آفان

170
00:12:02,340 --> 00:12:06,550
،لو بقي المُعلِّم آفان على قيدِ الحياة
لتمنّيتُ التعلُّم منه

171
00:12:07,680 --> 00:12:12,850
آمنتُ بأنَّ بوب سيبقى معنا لأنّه تلميذ آفان

172
00:12:18,780 --> 00:12:22,320
أين شجاعتُك يا بوب؟

173
00:12:22,860 --> 00:12:24,110
بوب؟

174
00:12:27,240 --> 00:12:29,540
بوب؟ من...؟

175
00:12:34,120 --> 00:12:35,330
!بوب

176
00:12:36,880 --> 00:12:37,920
ميرلي؟

177
00:12:38,630 --> 00:12:40,210
هل كنتَ تكذب؟

178
00:12:40,380 --> 00:12:44,380
عندما قلتَ أنّ داي كان صديقك
!حتّى لو كان وحشاً

179
00:12:44,550 --> 00:12:48,390
هل كانَتْ تلك الكلمات... تلك الدّموع... كذِباً؟

180
00:12:55,400 --> 00:12:57,650
أكرهك

181
00:12:59,270 --> 00:13:01,150
!لم أعد أحبُّك

182
00:13:07,200 --> 00:13:12,500
أتذكّر عندما لكمَتْني مام وقالَتْ
أنّني أثير اشمئزازها

183
00:13:13,660 --> 00:13:16,920
!لكن هذا مُختلِف عن ذلك الوقت

184
00:13:17,080 --> 00:13:21,550
.لو حاولتُ الذهاب بمُفردي، لمنعتموني
لهذا اضطررتُ لقولِ ذلك الكلام

185
00:13:21,710 --> 00:13:22,460
!أنا آسف

186
00:13:23,090 --> 00:13:27,050
اعتنوا بداي جميعاً! سأوقفهم
!ولو كان ذلك على جثّتي

187
00:13:27,220 --> 00:13:31,970
قد لا أربح، لكن سأقضي على واحد
!أو اثنين قبل أن أموت

188
00:13:34,270 --> 00:13:37,100
!لذا اهتمّوا بالباقي

189
00:13:54,500 --> 00:13:55,660
!توقّفوا مكانكم

190
00:13:59,380 --> 00:14:01,170
!لن تتقدّموا خطوة أخرى

191
00:14:03,670 --> 00:14:06,050
!انظروا من أتى لإيقافنا

192
00:14:06,220 --> 00:14:07,720
هل الآخرون يتربّصون؟

193
00:14:07,880 --> 00:14:09,680
لا، لا يبدو كذلك

194
00:14:09,840 --> 00:14:13,140
!هل جُنِنت؟! أم أنّك غبيّ؟

195
00:14:16,430 --> 00:14:17,850
!النّصر للأسرع

196
00:14:18,020 --> 00:14:20,190
!غالداندي، لا تستهِن به

197
00:14:20,360 --> 00:14:23,400
يمتلِك تعويذات أقوى ممّا تتوقّع

198
00:14:23,900 --> 00:14:25,530
!هذا الضّعيف الهزيل؟

199
00:14:27,820 --> 00:14:28,700
!ضعضعة

200
00:14:37,620 --> 00:14:38,960
!فلتُسحَقوا

201
00:14:39,460 --> 00:14:42,000
!أرجو أن تُسحَقوا

202
00:14:51,640 --> 00:14:54,640
!تبّاً! صعدَ أحدُهم وأفلت

203
00:15:03,230 --> 00:15:06,650
!يا لها من تنانين ضعيفة! مُثيرة للشفقة

204
00:15:07,900 --> 00:15:11,570
أنت شُجاع لمُحاولتك إيقافنا بمُفردنا

205
00:15:11,740 --> 00:15:14,660
مولايّ باران، دع هذا الأمر لي

206
00:15:14,830 --> 00:15:19,370
سوف نلحق بك، لذا ينبغي أن تُسرع
نحو مولايّ دينو

207
00:15:19,540 --> 00:15:22,170
عظيم. سأدع هذا الأمر لكم

208
00:15:23,130 --> 00:15:25,290
لكن لا تستهينوا به

209
00:15:25,460 --> 00:15:29,510
سبقَ وقلتُ ذلك، البشر المُستعدُّون للموت

210
00:15:29,670 --> 00:15:33,010
قد يُظهِرون قوّةً مُرعِبة

211
00:15:33,180 --> 00:15:38,100
الجرذ المُحاصر قد يعضّ قطّاً" لا أحد"
يعلم ما قد يفعله المُستميت

212
00:15:38,270 --> 00:15:40,560
أليس هذا ما يقوله البشر؟

213
00:15:41,480 --> 00:15:42,770
سوف أسبقكم

214
00:15:44,610 --> 00:15:45,940
!انتظر

215
00:15:50,150 --> 00:15:51,150
!تبّاً

216
00:15:51,320 --> 00:15:53,410
!اِلزم مكانك يا فتى

217
00:15:53,870 --> 00:15:58,080
تافه مثلك لا يحلم حتّى بالوقوفِ
!في وجه باران

218
00:15:58,240 --> 00:16:00,710
!اصمت! سعير

219
00:16:06,840 --> 00:16:08,300
!بنفخةٍ واحدة؟

220
00:16:10,800 --> 00:16:13,590
!هذا ليس كلّ ما لديك، أليس كذلك؟

221
00:16:14,140 --> 00:16:19,520
هل خلتَ أنّ بمقدورِك مُقاتلة أسياد
!التنّين بهذه؟

222
00:16:23,730 --> 00:16:26,400
!هل تُحاول أن تثرني على الضّحك؟

223
00:16:32,150 --> 00:16:33,950
!أنت واهنٌ جدّاً يا فتى

224
00:16:34,110 --> 00:16:35,820
هذا يكفي يا بوراهورن

225
00:16:35,990 --> 00:16:37,120
ماذا؟

226
00:16:37,490 --> 00:16:39,830
إنّه ليس أكثر من مجرّد غرّ

227
00:16:39,990 --> 00:16:44,750
لا تدعه يُعاني. أسقطْه على هذا وأنهِ الأمر

228
00:16:46,290 --> 00:16:51,130
أعتقد ذلك. كدُمية، ليس مُسلّياً جدّاً لِلّعب به

229
00:17:06,350 --> 00:17:07,360
!غالداندي؟

230
00:17:08,770 --> 00:17:12,530
!سآخذ هذه الدّمية إن كنتُما لا تريدانها

231
00:17:12,900 --> 00:17:19,280
إنّه فريسةٌ بشريّةٌ دسِمة! ليس من المُمتع
!الّا نستغرق وقتَنا في قتلِه

232
00:17:19,450 --> 00:17:20,740
قاسٍ كعادتك حسبما أرى

233
00:17:21,660 --> 00:17:25,460
!إنّهم أقوياء! سوف يقتلونني

234
00:17:25,920 --> 00:17:31,840
تبّاً! إن كنتُ سأموت، فيجب عليّ
!ضربهم مرّة أو مرّتين على الأقلّ

235
00:17:32,000 --> 00:17:34,670
!وإلّا فما الفائدة من موتي؟

236
00:17:38,930 --> 00:17:42,100
بئساً. هل متَّ من الآن يا فتى؟

237
00:17:42,270 --> 00:17:45,140
!هـ-هذا مؤلم! انتهى أمري

238
00:17:45,310 --> 00:17:50,060
!أرجوك! أنهِ الأمر بعضِّ رأسي وقطعه فحسب

239
00:17:50,650 --> 00:17:51,860
!ضعيف

240
00:17:52,020 --> 00:17:55,440
!مُوافق بما أنّك طلبتَ بلطف

241
00:17:58,320 --> 00:17:59,740
!لهيب

242
00:18:05,500 --> 00:18:07,870
أعتقد يمكنك فعل أي شيء عندما
تكون مُستميتاً

243
00:18:09,290 --> 00:18:13,670
لا أصدِّق ذلك. قتلَ هذا الفتى الثّعبانَ
الأثيريّ المُفضَّل لغالداندي

244
00:18:14,170 --> 00:18:16,880
الجرذ عضّ القطّ بالفعل

245
00:18:17,380 --> 00:18:20,050
لكن تترافق مُقاومته مع حسابٍ عسير

246
00:18:20,470 --> 00:18:25,020
بهذا تولّيتُ أمر تنانينهم. تبدأ
المعركة الحقيقيّة الآن

247
00:18:31,610 --> 00:18:34,610
!هذا... هذا مستحيل

248
00:18:35,280 --> 00:18:37,700
!كيف لك أن تموت؟

249
00:18:39,450 --> 00:18:40,870
ما الأمر؟

250
00:18:43,450 --> 00:18:46,700
!يا للقسوة! هذا كثير

251
00:18:50,250 --> 00:18:53,250
!لماذا تبكي يا وجه الطائر؟

252
00:18:53,420 --> 00:18:57,010
!قتلتَ كثيراً من البشر

253
00:18:57,880 --> 00:19:00,510
قتلتُ كثيراً من البشر؟

254
00:19:00,930 --> 00:19:07,930
كان هذا الثُّعبان الأثيريّ رود
!الصّديق الوحيد الذي وثِقتُ به

255
00:19:08,100 --> 00:19:10,480
!كان بمثابة أخي

256
00:19:10,640 --> 00:19:13,980
لطالما كنّا معاً مهما حدث

257
00:19:14,150 --> 00:19:18,240
...كيف تُقارن تنّيني الحبيب

258
00:19:18,400 --> 00:19:21,950
!ببعض البشر القذرين

259
00:19:24,870 --> 00:19:26,790
!ما هذا الرِّيش؟

260
00:19:27,240 --> 00:19:28,120
!لا أستطيع نزعه

261
00:19:28,450 --> 00:19:30,120
!سأقطِّعك إرباً

262
00:19:30,290 --> 00:19:33,750
!لدرجة أنّك لن تتمكّن من إيجاد أجزائك

263
00:19:34,210 --> 00:19:35,920
!ا-ابتعد عنِّي

264
00:19:38,050 --> 00:19:42,220
!هذه هي! كلّهم في الأرضِ الآن

265
00:19:42,390 --> 00:19:43,510
!ضعضعة

266
00:19:46,930 --> 00:19:48,270
!تعويذتي لا تنجح؟

267
00:19:48,430 --> 00:19:51,390
لم تعد قادراً على استخدامِ مثل
هذه التّعويذات القويّة بعد الآن

268
00:19:51,560 --> 00:19:55,560
فقوّتك السحريّة تتسرّب الآن

269
00:19:55,940 --> 00:19:56,730
!تقصد...؟

270
00:19:57,110 --> 00:20:01,820
هذا صحيح. هذا الرّيش الأبيض يستنزف
!القوّة السحريّة للعدوّ

271
00:20:03,200 --> 00:20:03,860
!اللَّعنة

272
00:20:04,030 --> 00:20:07,660
وهذا الرّيش الأحمر يستنزف اللّياقة

273
00:20:07,830 --> 00:20:09,870
هل فهمت؟

274
00:20:10,040 --> 00:20:14,630
!سأجعلُك دُمية فارغة قبل أن أقطِّعك

275
00:20:14,790 --> 00:20:17,500
!سأبثُّ الرُّعب في داخلك

276
00:20:18,960 --> 00:20:19,840
!سعير

277
00:20:21,670 --> 00:20:23,180
!ثمّ شُعلة

278
00:20:24,760 --> 00:20:25,550
!كُفَّ عن المُقاومة

279
00:20:32,440 --> 00:20:35,270
!هذا سيّئ! أشعر بالوهن

280
00:20:36,480 --> 00:20:38,480
لن أدعك تموت بسهولة

281
00:20:38,650 --> 00:20:40,690
!سأطيلُ هذا

282
00:20:43,530 --> 00:20:45,280
!خذ هذه وهذه وهذه

283
00:20:45,450 --> 00:20:47,450
!هل يؤلمك ذلك؟! أنا متأكّدٌ أنّه كذلك

284
00:20:47,620 --> 00:20:52,160
فقدَ صوابه. حتّى نحن لا نستطيع إيقافه الآن

285
00:20:52,330 --> 00:20:56,210
كان ليموت الفتى بلا ألمٍ لو لم يُقاوم

286
00:20:56,380 --> 00:20:57,630
فتى مسكين

287
00:21:01,340 --> 00:21:05,510
!أنت أشجع ممّا توقّعت. هذا يستفزّني

288
00:21:05,680 --> 00:21:09,850
عليّ أن أقاوم! مُستغلّاً ما بقي
!لي من لياقة وقوّة سحر

289
00:21:10,010 --> 00:21:11,430
!عليّ فعل شيء ما

290
00:21:12,980 --> 00:21:16,060
!تروقني تعابير الوجه هذه

291
00:21:16,230 --> 00:21:19,270
!وجدتُها. سأفعل ما فعلتَه برود

292
00:21:19,440 --> 00:21:21,860
!سأفجّر رأسك مثله

293
00:21:23,610 --> 00:21:25,610
!هذه هي! هذه هي النّظرات

294
00:21:25,780 --> 00:21:27,950
!حافِظ عليها

295
00:21:38,710 --> 00:21:40,040
!من هناك؟

296
00:21:49,090 --> 00:21:53,470
عظيم. أنقِذتُ على يدِ آخر رجل
تمنّيتُ أن ينقذني

297
00:21:54,350 --> 00:21:56,730
آسف لتخييبِ أملك

298
00:22:04,320 --> 00:22:07,280
حتّى لو واجهت الشّيطان والمنطق في صفّك

299
00:22:07,450 --> 00:22:11,240
قد يكون مجرّد تبرير

300
00:22:11,410 --> 00:22:15,330
حتّى الآن، حتّى الآن ما زلتُ أتردّد

301
00:22:15,500 --> 00:22:19,380
إلى أي مدى سنصل؟

302
00:22:19,540 --> 00:22:22,670
سمعتُ صوتاً أشبه بهمسِ ملاك

303
00:22:22,840 --> 00:22:26,590
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

304
00:22:26,760 --> 00:22:30,300
مُعرّض للحبِّ والحزن

305
00:22:30,470 --> 00:22:34,600
على الدّربِ المُغطّى بالاعتزاز

306
00:22:36,310 --> 00:22:38,640
لحظات عابِرة من الجُبن

307
00:22:40,190 --> 00:22:42,440
نداء الاستغاثة الذي تحفّظتُ عليه

308
00:22:44,020 --> 00:22:48,030
قبضتُ يدي المُرتعدة

309
00:22:48,610 --> 00:22:53,620
ذلك الوعد البسيط

310
00:22:53,780 --> 00:22:57,410
تلك الذّكريات التّافهة الصّغيرة

311
00:22:57,580 --> 00:22:59,710
ما زالت تسكن قلبي

312
00:22:59,870 --> 00:23:03,880
كجمرٍ يُبقيني مُشتعلاً

313
00:23:04,040 --> 00:23:08,380
شُعاع شفّاف من النُّور

314
00:23:08,550 --> 00:23:11,550
يُنير الدّرب أمامي

315
00:23:11,720 --> 00:23:16,220
قلّما أستطيع فعله

316
00:23:16,390 --> 00:23:22,440
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

317
00:23:33,700 --> 00:23:36,580
وصلَ هيونكل في آخر لحظة لإنقاذِ بوب

318
00:23:36,740 --> 00:23:40,410
بوجودِ أكثر حليف مُحتمل في صفِّه
،ضدّ غالداندي وبوراهورن

319
00:23:40,580 --> 00:23:42,580
يحظيان بأفضليّة

320
00:23:49,130 --> 00:23:52,930
،تبدأ المعركة الشّرِسة بين هيونكل ولارهارت
!آخر سيّد تنّين

321
00:23:53,090 --> 00:23:55,680
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

322
00:23:57,770 --> 00:23:59,480
!وتستمرّ المغامرة