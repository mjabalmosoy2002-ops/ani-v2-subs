1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:05,040 --> 00:02:06,200
!لهيب

20
00:02:19,220 --> 00:02:20,390
!ما هذا؟

21
00:02:39,070 --> 00:02:41,870
الملكة فلورا، ماذا كان ذلك؟

22
00:02:47,040 --> 00:02:47,700
توقّفت

23
00:02:48,960 --> 00:02:52,710
تعويذة بريق الخاصّة بالأميرة ليونا
،كانت تضبطها

24
00:02:52,880 --> 00:02:57,050
لكن الهدير من قصر فارن لم يتوقّف

25
00:02:57,210 --> 00:02:59,260
إلّا أنّه توقّف تماماً الآن

26
00:02:59,420 --> 00:03:00,800
!...إذاً هذا يعني

27
00:03:01,430 --> 00:03:05,970
لا بدّ أنّ داي والآخرين دمّروا جزءاً
مركزيّاً من قصر فارن

28
00:03:06,140 --> 00:03:07,890
!مرحى

29
00:03:08,060 --> 00:03:10,020
!فعلاها

30
00:03:10,310 --> 00:03:11,770
!ممتاز

31
00:03:11,940 --> 00:03:14,190
!هذا هو فريق البطل

32
00:03:14,360 --> 00:03:16,320
لم ننتهِ بعد

33
00:03:16,480 --> 00:03:19,240
هذا لا يعني بأنّ ملك الشّياطين قد انهزم

34
00:03:19,400 --> 00:03:23,660
لكن فقد قصرُ فارن قدراته الوظيفيّة

35
00:03:24,620 --> 00:03:29,960
لن تُهاجَم بلادنا بواسطة جيش
الشّياطين بعد الآن

36
00:03:39,170 --> 00:03:41,550
...نظراً إلى أنّه لا يتساقط

37
00:03:41,720 --> 00:03:46,470
لا بدّ وأنَّ قصر فارن بحدِّ ذاته
بُني من مواد تجعله يعوم

38
00:03:46,640 --> 00:03:48,180
هكذا يبدو

39
00:03:49,020 --> 00:03:49,930
لا

40
00:03:50,310 --> 00:03:54,690
عوضاً عن السّقوط... يبدو أنّه يصعد

41
00:03:56,610 --> 00:03:58,280
ببطء شديد

42
00:03:59,280 --> 00:04:00,650
رويداً رويداً

43
00:04:21,090 --> 00:04:22,050
...داي

44
00:04:23,260 --> 00:04:25,300
...الشّعاران في يديك

45
00:04:28,310 --> 00:04:30,430
هذا صحيح يا ليونا

46
00:04:30,600 --> 00:04:31,730
!إنّه حيّ

47
00:04:34,640 --> 00:04:36,650
!أبي ما زال حيّاً

48
00:04:38,520 --> 00:04:41,190
!هنا، في يدي اليُسرى

49
00:04:49,700 --> 00:04:55,920
لم يكن المُعلّم أو لارهارت فقط
!من ساعداني من وراء الموت

50
00:04:56,540 --> 00:04:57,920
...كان أبي

51
00:04:58,840 --> 00:05:01,420
!كان أبي هنا

52
00:05:03,340 --> 00:05:09,180
أن يكون والدك شعاراً ويعيش داخلك
يبدو أمراً مستحيلاً

53
00:05:09,550 --> 00:05:12,060
لكن يمكنني تصديق ذلك

54
00:05:12,520 --> 00:05:16,310
!أعني بأنّك تبدو سعيداً جدّاً يا داي

55
00:05:30,410 --> 00:05:32,990
!...إنّه ذاك -
!غوروا؟ -

56
00:05:34,790 --> 00:05:39,250
قال بأنّه الطبّال غوروا

57
00:05:40,130 --> 00:05:41,500
لقد تعثّر

58
00:05:42,050 --> 00:05:46,760
أعتقد وحش الطبلة هذا هو حقيقته

59
00:05:46,930 --> 00:05:50,010
قال بأنّ فارن مدّه بالقوّة

60
00:05:50,180 --> 00:05:55,810
لكن هل يستطيع فارن تحويل
وحش صغير كهذا فعلاً؟

61
00:05:55,980 --> 00:05:58,730
لن أستغرب لو كان يستطيع ذلك

62
00:05:58,900 --> 00:06:01,480
فقوّته السحريّة لا يمكن استيعابها

63
00:06:04,480 --> 00:06:08,610
!هيّا بنا! إلى قمّة برج السّيادة

64
00:06:09,240 --> 00:06:13,160
لكن دُمِّرت السّلالم وكلّ شيء

65
00:06:38,270 --> 00:06:39,480
لا يوجد شيء هنا

66
00:06:39,640 --> 00:06:41,230
انظري فوقك

67
00:06:51,320 --> 00:06:52,910
!سعير

68
00:06:58,830 --> 00:07:00,330
!خذ هذه

69
00:07:01,370 --> 00:07:02,830
!خلف رأسه

70
00:07:17,470 --> 00:07:20,520
!هذا الشّخص قويّ جدّاً

71
00:07:21,140 --> 00:07:25,480
...قاتلَ لون بيروك ثمّ قاتلني أنا ومام

72
00:07:25,650 --> 00:07:28,610
!كان يقاتل طوال اليوم

73
00:07:28,780 --> 00:07:31,860
ومع ذلك لا يبدو مُتعَباً إطلاقاً

74
00:07:32,030 --> 00:07:33,780
معك حقّ غالباً

75
00:07:34,620 --> 00:07:38,160
وجّهتُ له عدّة ضربات قاتلة بالفعل

76
00:07:38,330 --> 00:07:39,660
مع ذلك انظرا

77
00:07:40,370 --> 00:07:42,750
سلاحي هو الّذي تضرّر

78
00:07:42,920 --> 00:07:45,920
يبدو لي أنّه لم يتلقّ أيّ ضرر

79
00:07:46,090 --> 00:07:47,750
تماماً

80
00:07:47,920 --> 00:07:53,470
،لا يمكن إصابتكم بأيّ هجمة
ولا أتلقّى أيّ ضرر بهجماتكم

81
00:07:53,640 --> 00:07:58,430
تبدو المعركة متّزنة، لكن النتائج واضحة

82
00:07:58,600 --> 00:08:01,640
...معه حقّ. إذا قاتلنا فترة طويلة

83
00:08:01,810 --> 00:08:06,360
سوف نُرهَق، ممّا يسمح لميستوفارن
أن يهاجمنا وينتصر

84
00:08:06,520 --> 00:08:10,190
علينا أن نكشف عن سرّ قوّته الّتي لا تُقهَر

85
00:08:10,360 --> 00:08:13,450
حتّى هجماتي لا تستطيع قتله هكذا

86
00:08:14,660 --> 00:08:15,950
ماذا الآن؟

87
00:08:40,560 --> 00:08:44,690
هذه هي القبّة التي كانت في قمّة برج السّيادة

88
00:08:45,980 --> 00:08:50,690
يبدو أنّ القلعة فوقها قد دُمِّرت
بواسطة دورورا خاصّتك

89
00:08:51,320 --> 00:08:52,860
...دورورا

90
00:08:53,650 --> 00:08:56,360
إنّها تعويذة قويّة حقّاً

91
00:08:57,450 --> 00:09:01,120
هل برأيك تمكّنتْ من القضاء على فارن أيضاً؟

92
00:09:01,290 --> 00:09:04,660
لا. لعلّه تلقّى بعض الضرر منها

93
00:09:05,170 --> 00:09:07,000
لكنّه أقوى من ذلك بكثير

94
00:09:07,170 --> 00:09:08,380
بالطبع

95
00:09:12,960 --> 00:09:14,420
!تراجعي يا ليونا

96
00:09:17,550 --> 00:09:19,140
!فارن -
!هذا هو -

97
00:09:19,760 --> 00:09:23,850
مُبارك تدمير قلعتي

98
00:09:24,180 --> 00:09:29,810
لا داعي للتحفّظ أكثر بما أنّك
قادر على فعل ذلك

99
00:09:31,320 --> 00:09:33,820
سوف أبيدك هنا

100
00:09:35,200 --> 00:09:38,360
!هذا فارن، ملك الشّياطين؟

101
00:09:38,530 --> 00:09:39,530
!إنّه قادم

102
00:09:39,950 --> 00:09:44,620
لطالما كان فارن مُسترخياً، لكن
!أشعر الآن بنيّة خبيثة

103
00:09:45,080 --> 00:09:48,330
!سيُهاجمنا فارن بكامل قوّته

104
00:10:22,580 --> 00:10:24,290
لا أصدّق ذلك

105
00:10:24,450 --> 00:10:28,370
مجرّد إطلاق عنان قوّته السحريّة
!يخلق هذا القدر من الضغط؟

106
00:10:28,540 --> 00:10:31,040
!هذا فارن بقوّة كاملة

107
00:10:34,250 --> 00:10:38,930
،عندما هزمني في المرّة الماضية
!فعل ذلك بمنتهى السّهولة

108
00:10:40,840 --> 00:10:42,550
هل أملك فرصة ضدّه؟

109
00:10:42,720 --> 00:10:47,480
...لعلّ قوّتي تعزّزت بشعارين، لكن قوّتي الحالية

110
00:10:47,640 --> 00:10:49,770
داي

111
00:10:49,940 --> 00:10:52,730
دعني أخمّن ما تفكّر فيه

112
00:10:53,310 --> 00:10:58,990
"هل يمكنني مُجاراته حقّاً بشعارين؟"

113
00:11:00,610 --> 00:11:05,080
شِعارا تنّين توأمان. هذا ما أطلق عليهما

114
00:11:05,700 --> 00:11:07,250
شِعارا تنّين توأمان؟

115
00:11:08,250 --> 00:11:11,500
،عندما تنتهي حياة فارس تنّين

116
00:11:11,960 --> 00:11:18,380
فإنّ شعاره ينتقل إلى الحياة الجديدة
التي تسكن داخل التنّين الأمّ

117
00:11:19,470 --> 00:11:22,430
الخطر الّذي يشكّله فارس تنّين

118
00:11:22,590 --> 00:11:27,560
سببه غالباً الغريزة القتاليّة المُحتواة داخل الشّعار

119
00:11:28,430 --> 00:11:30,520
يحتوي شعار التنّين

120
00:11:30,690 --> 00:11:37,190
على مجموع مهارات فرسان التنّين
المُتراكمة على مدى قرون

121
00:11:37,480 --> 00:11:41,070
وتُنقَل إلى الفارس التّالي

122
00:11:41,780 --> 00:11:42,740
،بصيغة أخرى

123
00:11:42,910 --> 00:11:49,200
يُولَد فرسان التنّين بمهارات
الفرسان السّابقين القتاليّة

124
00:11:49,370 --> 00:11:52,040
إنّهم عباقرة القتال

125
00:11:52,460 --> 00:11:56,170
أنت ابن باران، فارس تنّين

126
00:11:56,540 --> 00:11:58,760
لديك شعارك الخاص

127
00:11:58,920 --> 00:12:05,180
لديك قوّتك الخاصّة، لكنّك لم ترث المهارات

128
00:12:05,720 --> 00:12:07,010
...لكن الآن

129
00:12:07,180 --> 00:12:11,230
انتقل شعار باران إليك كما ينبغي

130
00:12:11,390 --> 00:12:14,940
،منحَك قدرات قتاليّة فائقة

131
00:12:15,230 --> 00:12:18,150
ليُتمم ذلك شِعارَي التنّين التوأمين

132
00:12:18,730 --> 00:12:20,690
،بقوّتك الفطريّة

133
00:12:20,860 --> 00:12:26,240
والخبرة القتاليّة لفرسان التنّين
السّابقين، وُلِد فارس خارق

134
00:12:26,410 --> 00:12:27,740
...بعبارة أخرى يا داي

135
00:12:28,160 --> 00:12:30,250
أنت ذلك الفارس الخارق

136
00:12:30,870 --> 00:12:34,920
لم أعد أستطيع التنبّؤ بقوّتك

137
00:12:35,380 --> 00:12:38,210
قد تتفوّق حتّى على التنّين الشّيطان

138
00:12:41,550 --> 00:12:43,590
،أنا، ملك الشّياطين فارن

139
00:12:43,760 --> 00:12:47,680
أؤمن بأنّني لا أخشى شيئاً
في ثلاثي العوالم

140
00:12:47,850 --> 00:12:52,230
لكن لا يمكن الاستهانة بما هو غير مُتوقَّع

141
00:12:53,230 --> 00:12:58,270
!الإبادة الفوريّة! هذا هو قراري

142
00:13:08,620 --> 00:13:13,410
!الإبادة الفوريّة! هذا هو قراري

143
00:13:19,210 --> 00:13:21,960
!ليونا، تراجعي حالياً -
...لكن

144
00:13:23,340 --> 00:13:26,930
أطيعي تحذيراته يا أميرة بابنيكا

145
00:13:27,680 --> 00:13:29,600
!فالاقتراب يعني الموت

146
00:13:29,760 --> 00:13:33,930
في نهاية المطاف، لا شيء يمكن
!فعله أمام هذه الهجمة

147
00:13:40,820 --> 00:13:42,110
ما الخطب؟

148
00:13:42,280 --> 00:13:44,780
ألن تقاوم؟

149
00:13:44,940 --> 00:13:48,570
!إنّه سريع! والتأثير أقوى بكثير من السّابق

150
00:13:48,910 --> 00:13:49,700
...لكن

151
00:13:49,870 --> 00:13:53,040
!داي! ما الأمر؟! قاوم

152
00:13:53,830 --> 00:13:57,620
هكذا إذاً. لا بدّ وأنّه لا يستطيع
!توجيه هجمته الأولى بعد

153
00:13:58,420 --> 00:14:00,960
فارن كسرَ سيفه في السّابق

154
00:14:01,130 --> 00:14:04,460
ودورورا خاصّته لم تؤثّر عليه إطلاقاً

155
00:14:06,470 --> 00:14:10,890
داي مُتردّد ولا يستطيع معرفة كيفيّة القتال

156
00:14:11,550 --> 00:14:13,100
كـ-كيف أقاتل؟

157
00:14:13,560 --> 00:14:15,430
بسيفي؟ أم بتعويذاتي؟

158
00:14:15,600 --> 00:14:21,270
هل تملّكك الخوف؟ هذا مُخيّب، لكنّه ملائم لي

159
00:14:21,440 --> 00:14:23,270
!فلتمُت الآن

160
00:14:23,440 --> 00:14:25,610
!كيف أقاتل؟ -
!داي -

161
00:14:25,780 --> 00:14:30,320
!ليس عليك أن تشغل تفكيرك! الكمه فحسب

162
00:14:52,220 --> 00:14:53,430
!أصبتُه

163
00:14:54,600 --> 00:14:57,850
!لقد سقط! سقطَ ملك الشّياطين

164
00:14:58,020 --> 00:15:00,850
!تمكّنتُ من إصابته بالضربة الأولى

165
00:15:01,440 --> 00:15:04,940
!هذا صحيح! الانشغال في التّفكير قد يعرقلني

166
00:15:05,270 --> 00:15:08,030
!ما كنتُ لأتمكّن من هزيمته بالقتال بشكل عاديّ

167
00:15:08,690 --> 00:15:14,160
كان خياري الوحيد هو ضربه بكلّ
قوّتي والبحث عن ثغرة

168
00:15:15,490 --> 00:15:19,000
!كانت ليونا تحاول أن تخبرني بذلك

169
00:15:19,500 --> 00:15:21,670
!ليونا! شكراً على النصيحة المُفيدة

170
00:15:22,420 --> 00:15:26,800
لكن من غير اللّائق بالنسبة لأميرة
أن تطلب من شخص لكم أحد

171
00:15:27,800 --> 00:15:31,840
!على رسلك! كنتُ أحاول مساعدتك على الاسترخاء

172
00:15:43,480 --> 00:15:48,650
ظننتُني نلتُ منه... لكن لم أفعل

173
00:15:49,360 --> 00:15:51,280
...حركات داي

174
00:15:51,450 --> 00:15:54,160
...حركاته غير المُتوقَّعة

175
00:15:54,910 --> 00:15:56,080
كنتُ على حقّ

176
00:15:56,240 --> 00:16:02,790
!ورثَ سنوات الغريزة القتاليّة من فرسان التنّين

177
00:16:03,500 --> 00:16:04,380
!داي

178
00:16:04,540 --> 00:16:06,960
!أعلم! أهاجم فحسب

179
00:16:07,130 --> 00:16:11,630
!سأصيبه بكلّ شيء! بأفضل هجماتي

180
00:16:12,130 --> 00:16:14,590
!هيّا يا سيفي

181
00:16:21,980 --> 00:16:24,310
!لنبدأ بضربة الأرض

182
00:16:24,480 --> 00:16:28,480
!أيّها الفتى! أنت تستهين بي

183
00:16:32,110 --> 00:16:33,490
!لا ينكسر؟

184
00:16:33,650 --> 00:16:34,700
!هذا يفلح

185
00:16:48,880 --> 00:16:49,710
!ضربة الأرض

186
00:16:56,510 --> 00:17:00,680
هذا مُبهر يا داي! أنت متكافئ
!مع ملك الشّياطين

187
00:17:02,560 --> 00:17:04,690
!هذا يفلح! يمكنني القتال

188
00:17:04,850 --> 00:17:07,480
...هالتي التنّينيّة وقوّتي وسرعتي

189
00:17:07,650 --> 00:17:10,730
كلّها أعلى بكثير ممّا كانت عليه
!بشعار واحد

190
00:17:10,900 --> 00:17:13,900
!أشعر وكأنّ جسدي ليس ملكي

191
00:17:14,280 --> 00:17:17,740
عرفتُ بأنّه بهذه القوّة

192
00:17:17,910 --> 00:17:20,870
منذ أطلق عنان دورورا خاصّته

193
00:17:21,040 --> 00:17:27,080
من المرجّح أنّ فرسان التنّين يستطيعون
إطلاق دورورا فقط بشكل تنّين الشّيطان

194
00:17:27,250 --> 00:17:31,550
لأنّ أشكالهم العاديّة لا تستطيع تحمّل القوّة

195
00:17:32,630 --> 00:17:37,840
لهذا عليهم أن يتحوّلوا إلى شكل
التنّين الشّيطان لاستخدام التّعويذة

196
00:17:38,010 --> 00:17:41,220
وكأنّها وظيفة أمان ذاتيّة

197
00:17:44,350 --> 00:17:47,650
لكنّه استخدمها بوضعه الرّاهن

198
00:17:47,810 --> 00:17:52,320
قوّة داي مكافئة لقوّة تنّين شيطان أو أكبر حتّى

199
00:17:54,070 --> 00:17:58,490
!ما أنا مهتمّ به ليس تلك القوّة على السّطح

200
00:17:58,860 --> 00:18:01,740
!ستكشف هذه الهجمة عمّا أريد معرفته

201
00:18:02,370 --> 00:18:03,410
!هذه الوضعيّة

202
00:18:03,580 --> 00:18:05,750
!الجدار الكارثي

203
00:18:10,330 --> 00:18:15,510
بخلاف ما سبق، هذا جداري
!الكارثي بكامل قوّته

204
00:18:15,670 --> 00:18:18,130
!إنّها سريعة! لا يمكنني تفاديها

205
00:18:18,590 --> 00:18:20,090
!والآن ماذا؟

206
00:18:24,180 --> 00:18:25,520
!هذه هالة

207
00:18:26,560 --> 00:18:28,600
!إنّها شيء شبيه بهالة

208
00:18:28,770 --> 00:18:32,820
!إنّها تنطلق للأعلى بينما تقترب بسرعة فائقة

209
00:19:30,710 --> 00:19:32,670
!مرّ من خلالها

210
00:19:33,000 --> 00:19:35,500
!من خلال قوّة الجدار الكارثيّ

211
00:19:37,250 --> 00:19:42,130
هذه الصّدمات... التحمَ الملك فارن مع داي

212
00:19:43,090 --> 00:19:45,300
أعتقد ينبغي أن أحسم هذا الأمر

213
00:19:46,310 --> 00:19:50,180
!مام، عالجي لارهارت قبل أن يُنهَك

214
00:19:50,350 --> 00:19:54,110
أكره الإقرار بذلك، لكنّه الشخص
!الوحيد القادر على مُجاراة ميستوفارن

215
00:19:54,270 --> 00:19:55,360
!سأكسب الوقت

216
00:19:55,520 --> 00:19:56,820
!بوب -
!لا تفعل -

217
00:19:56,980 --> 00:20:01,530
لا يبدو أنّك تتعلّم درسك. لستَ
!قويّاً بما يكفي لإيقافي

218
00:20:06,950 --> 00:20:07,830
!بوب

219
00:20:16,790 --> 00:20:21,220
أعتقد هذه المرّة الثّانية التي
!أحميك فيها هكذا

220
00:20:21,380 --> 00:20:22,970
!أنت؟ -
إنّه صديق -

221
00:20:26,760 --> 00:20:30,850
تغلّبَ على الموت ووُلِد من جديد كصديق جديد لنا

222
00:20:33,390 --> 00:20:38,020
!هيونكل! أنت بخير! هذا جيّد

223
00:20:38,730 --> 00:20:39,610
أنا آسفة

224
00:20:40,070 --> 00:20:41,860
لا عليكِ. لا تقلقي

225
00:20:42,030 --> 00:20:43,450
!أحمق

226
00:20:43,990 --> 00:20:47,240
!ماذا... ماذا تعني بـ"لا تقلقي"؟

227
00:20:47,410 --> 00:20:51,500
!كنتُ... أعني كنّا قلقين جدّاً عليك

228
00:20:52,960 --> 00:20:57,080
إذا غادرتَ بمفردك ثانية، أقسم
!بأنّني سأركل مؤخّرتك

229
00:21:01,130 --> 00:21:02,550
سامحني يا بوب

230
00:21:02,720 --> 00:21:06,590
لكن أشكّ في أنّني سأحتاج
لفعل ذلك ثانية

231
00:21:06,760 --> 00:21:11,560
وصلت التّعزيزات والعدوّ أقلّ منّا عدداً

232
00:21:14,310 --> 00:21:18,150
...حتّى لو تحمّلها بهالته التنّينيّة

233
00:21:18,400 --> 00:21:22,400
كان ليتلقّى ضرراً جسيماً من الموجة الاهتزازيّة

234
00:21:23,240 --> 00:21:24,360
...لكن

235
00:21:24,530 --> 00:21:30,240
بحماية نفسه بهالة تنّينيّة مشابهة
،من حيث الطبيعة لجداري الكارثي

236
00:21:30,410 --> 00:21:35,250
مرَّ من خلالها من دون أن يتأثّر
بالموجة الاهتزازيّة

237
00:21:36,000 --> 00:21:37,880
،ليس داي بنفسه فقط

238
00:21:38,040 --> 00:21:44,880
بل كلّ أصدقائه لم يُظهِروا مثل
هذه المهارة والإبداع

239
00:21:45,050 --> 00:21:46,800
أنا متيقّن من ذلك

240
00:21:46,970 --> 00:21:49,090
الغرائز القتاليّة المُنتقِلة

241
00:21:49,260 --> 00:21:52,600
من فارس تنّين لآخر منذ زمن الآلهة

242
00:21:53,100 --> 00:21:57,190
!قد بدأت تتجذّر داخله

243
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

244
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

245
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

246
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

247
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

248
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

249
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

250
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

251
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

252
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

253
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

254
00:23:33,700 --> 00:23:35,910
داي يتصدّى لجدار فارن الكارثيّ

255
00:23:36,080 --> 00:23:39,790
ويُقاتل بمهارات تنافس أو حتّى
تتفوّق على ملك الشّياطين

256
00:23:39,960 --> 00:23:43,920
في هذه الأثناء، تشتدّ مبارزة أفان وكيلفارن حِدّة

257
00:23:44,080 --> 00:23:49,050
،يزداد أفان غضباً من قساوة كيلفارن
بينما يحافظ كيلفارن على هدوء مُخيف

258
00:23:49,210 --> 00:23:52,930
في نهاية المطاف، يصل نِزالهما إلى نهايته

259
00:23:53,090 --> 00:23:55,260
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

260
00:23:57,310 --> 00:23:59,890
!وتستمرّ المغامرة