1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,430
لو راقبتني، لسحرتُك

12
00:01:04,600 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,610
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,780 --> 00:01:17,610
أنا أحترق لأنّي أحرقت بالفعل

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:51,570 --> 00:01:52,570
!خذ هذه

20
00:01:52,730 --> 00:01:54,110
!صعق

21
00:02:07,000 --> 00:02:08,290
!نجحَتْ

22
00:02:10,710 --> 00:02:12,920
!فعلناها! مرحى! مرحى

23
00:02:14,130 --> 00:02:19,180
كما توقّعت، درعه سليم، لكن أنا واثق
أنّه احترق تماماً في الدّاخل

24
00:02:20,720 --> 00:02:24,390
!يستحقّ ذلك بعد أن استهان بنا، أليس كذلك يا داي؟

25
00:02:32,110 --> 00:02:32,980
!بوب

26
00:02:35,860 --> 00:02:38,700
!حتّى صعق لم تنجح؟

27
00:02:38,860 --> 00:02:41,110
لا، نجحَتْ

28
00:02:41,740 --> 00:02:45,700
!لكنّه تحمّل الضرر الناتج عنها

29
00:02:46,120 --> 00:02:49,080
!حتّى من دون درعه، هيونكل قويّ

30
00:02:50,080 --> 00:02:52,040
أخطأتُ في تقييمكما

31
00:02:52,210 --> 00:02:56,510
،إن كنتما قادرين على فعل هذا
فلا حاجة للتحفُّظ

32
00:02:58,220 --> 00:02:59,300
!ها أنا ذا

33
00:03:00,550 --> 00:03:02,340
!داي، مرّة أخرى

34
00:03:02,510 --> 00:03:05,010
!فات الأوان! يد هالة الدمى الشيطانية

35
00:03:05,180 --> 00:03:06,220
...صعـ

36
00:03:06,720 --> 00:03:08,390
!ذاك الشيء المُقيِّد ثانية

37
00:03:10,560 --> 00:03:11,560
!الوداع

38
00:03:13,230 --> 00:03:15,650
!سكرايد الدمويّ

39
00:03:18,400 --> 00:03:22,030
لا يمكننا هزيمته. لا بالسّيف ولا بالسّحر

40
00:03:24,030 --> 00:03:26,080
!داي

41
00:03:29,330 --> 00:03:30,580
انتهى الأمر

42
00:03:35,290 --> 00:03:37,750
!أجل، لا بدّ أنّه مخرج

43
00:03:39,050 --> 00:03:40,970
!تماسك يا داي

44
00:03:41,300 --> 00:03:42,510
...لا

45
00:03:42,680 --> 00:03:45,510
!أجبني يا داي! داي

46
00:03:45,680 --> 00:03:49,600
لا تُتعب نفسك. سكرايد الدمويّ هجمة قاتِلة

47
00:03:49,770 --> 00:03:50,980
انتهى أمره

48
00:03:51,140 --> 00:03:52,730
!اصمت

49
00:03:52,890 --> 00:03:58,610
!هذه غلطتي أنا! تسبّبتُ بمقتلِ داي

50
00:03:59,780 --> 00:04:01,450
اِلحق به في الحياة الآخرة

51
00:04:02,030 --> 00:04:03,700
!انتظر يا هيونكل

52
00:04:07,080 --> 00:04:08,740
!متى خرجتِ؟

53
00:04:09,080 --> 00:04:10,870
!هيونكل، كيف طاوعك قلبُك؟

54
00:04:11,410 --> 00:04:14,920
!ضربتَ زميلاً لك من تلاميذ أفان

55
00:04:15,330 --> 00:04:19,760
!عن أيّ زميل تتحدثين. إنّه تلميذ قاتل أبي

56
00:04:19,920 --> 00:04:24,090
!مخطئ! لم يكن المعلّم أفان قاتل أبيك

57
00:04:24,260 --> 00:04:25,430
!كفى كذِباً

58
00:04:25,590 --> 00:04:27,140
!إنَّها الحقيقة

59
00:04:28,050 --> 00:04:30,520
وجدتُ هذه داخل صندوق في غرفةٍ سرّيّة

60
00:04:31,890 --> 00:04:32,730
...هذه

61
00:04:33,350 --> 00:04:34,770
!صدَفة روح

62
00:04:35,400 --> 00:04:38,520
!تحتوي على رسائل الموتى

63
00:04:39,190 --> 00:04:44,240
إنّها من أبيك. كلمات فارس الجحيم
بارتوس الأخيرة قبل موته

64
00:04:44,610 --> 00:04:47,530
!كلمات أبي الأخيرة؟! مستحيل

65
00:04:47,700 --> 00:04:49,830
!كيف يوجد شيء كهذا؟

66
00:04:51,240 --> 00:04:52,830
هذا غير ممكن

67
00:04:53,290 --> 00:04:56,670
!مُحال أن يموت

68
00:04:59,880 --> 00:05:01,050
!إنّه حيّ

69
00:05:05,800 --> 00:05:11,560
في تلك اللّحظة، مالَ بجسدِه للخلف
!وتجنّب إصابةً في قلبِه

70
00:05:14,350 --> 00:05:16,690
...لا يمكننا... هزيمته

71
00:05:18,230 --> 00:05:21,900
لا يمكن هزيمته بالسيف. ولا يمكن هزيمته بالسحر

72
00:05:22,690 --> 00:05:24,490
لا بالسيف ولا بالسحر

73
00:05:24,650 --> 00:05:26,030
!لا يمكننا هزيمته

74
00:05:30,370 --> 00:05:31,490
...داي

75
00:05:32,120 --> 00:05:36,250
!استمِع يا هيونكل للحقيقةِ التي تركَها أبوك

76
00:05:39,210 --> 00:05:42,840
!ما حدث فعلاً في يوم سقوط القصر التّحأرضي

77
00:05:43,840 --> 00:05:46,590
...هيونكل... ابني

78
00:05:46,970 --> 00:05:47,720
!أبي؟

79
00:05:51,430 --> 00:05:54,220
ابني العزيز هيونكل

80
00:05:54,560 --> 00:06:00,110
أترك هذه الرسالة كي تعرف الحقيقة

81
00:06:00,730 --> 00:06:04,150
في اليوم الذي شنّ فريقُ البطل
،هجوماً على القصرِ التّحأرضيّ

82
00:06:04,320 --> 00:06:08,110
!قاتلتُ أفان البطل بصفتي حارس بوّابة الجحيم

83
00:06:09,360 --> 00:06:11,740
لكنّ أفان كان قويّاً

84
00:06:19,880 --> 00:06:22,040
هيّأتُ نفسي للموت

85
00:06:22,380 --> 00:06:23,550
...ثمّ

86
00:06:26,800 --> 00:06:29,050
!ما الأمر؟! اقتلني

87
00:06:29,720 --> 00:06:30,720
دعنا لا نفعل ذلك

88
00:06:30,890 --> 00:06:33,970
!ماذا؟! هل ستذلّني برحمتِك؟

89
00:06:36,890 --> 00:06:40,230
من الواضح أنّ هذه صُنِعَتْ من قِبَل طفل

90
00:06:40,400 --> 00:06:44,730
يبدو هذا مُستبعَداً، لكن لديك عائلة

91
00:06:45,980 --> 00:06:50,070
عندما أدركتُ ذلك، لم أستطع قتلك

92
00:06:53,200 --> 00:06:57,500
!هزمتَني. ليس بالقوّة فقط، بل بالقلبِ كذلك

93
00:06:57,950 --> 00:07:00,420
والآن افتح البوّابة لو سمحت

94
00:07:00,580 --> 00:07:03,790
الشخص الوحيد الذي أتيتُ لأجلِه هو هدلر

95
00:07:05,050 --> 00:07:08,760
!أيّها البطل! أودّ أن أطلب منك طلباً

96
00:07:10,380 --> 00:07:11,930
فأخبرتُه

97
00:07:12,300 --> 00:07:15,680
كيف وجدتُ وربّيتُ طفلاً بشريّاً

98
00:07:16,180 --> 00:07:21,730
وأنّه حتّى لو عفا عنّي ومات
هدلر، سوف أختفي عن الوجود

99
00:07:22,480 --> 00:07:26,270
!أيّها البطل أفان! اعتنِ بابني أرجوك

100
00:07:26,440 --> 00:07:29,650
!ربِّه ليصبح محارباً صالحاً وقويّاً

101
00:07:29,820 --> 00:07:34,660
!أطلب منك أن تُريه الدفء البشريّ الحقيقيّ

102
00:07:35,160 --> 00:07:36,080
حسناً

103
00:07:37,700 --> 00:07:41,080
قَبِلَ أفان-دونو بكلِّ لباقة

104
00:07:42,080 --> 00:07:45,920
ثمّ مضى لمواجهةِ هدلر

105
00:07:50,920 --> 00:07:52,510
...بعد ذلك بفترة قصيرة

106
00:07:55,470 --> 00:07:58,720
!دوتْ أصداء صيحة موت هدلر في أرجاء القصر

107
00:08:00,600 --> 00:08:04,100
ومع ذلك... بقيتُ على قيد الحياة

108
00:08:12,200 --> 00:08:13,660
!هدلر-ساما

109
00:08:13,820 --> 00:08:15,570
!نجوت؟

110
00:08:15,740 --> 00:08:17,330
،في لحظةِ موتي

111
00:08:17,490 --> 00:08:21,370
تمّ إنقاذي بواسطةِ القوى الشيطانيّة
!الخاصّة بإله العالم السّفلي، فارن

112
00:08:21,710 --> 00:08:24,120
!إله العالم السفليّ، فارن؟

113
00:08:24,290 --> 00:08:30,840
يجب عليّ الآن أن أنام لثلاثة عشر عاماً
!لتكوين قوّتي وبناء جيش شيطاني جديد

114
00:08:31,010 --> 00:08:35,470
!جيش أعظم بكثير من جيش الشّياطين الحالي

115
00:08:35,840 --> 00:08:40,180
!لكن قبل أن أفعل ذلك، يجب أن أعدمك

116
00:08:40,680 --> 00:08:42,060
!أ-أنا؟

117
00:08:42,560 --> 00:08:45,020
!أنت فاشل تماماً

118
00:08:45,190 --> 00:08:48,690
!بحسِّ العدالة والشّهامة المُثير للشفقة الذي لديك

119
00:08:48,860 --> 00:08:51,860
!دفء البشر يجعلك ضعيفاً

120
00:08:52,400 --> 00:08:57,620
وعلاوة على ذلك، سمحتَ لأفان
!بعبور بوّابة الجحيم

121
00:08:58,070 --> 00:09:00,080
،عندما أبني جيشي الشيطانيّ الجديد

122
00:09:00,240 --> 00:09:04,710
!لن يكون فيه مكانٌ للأخطاء أمثالك

123
00:09:08,500 --> 00:09:12,460
حسناً يا أفان، استمتع بلحظةِ سلامك

124
00:09:12,840 --> 00:09:17,260
عندما يكتمِل جيشي الشّيطانيّ، ستكون
!أوّل من أستهدفه

125
00:09:19,850 --> 00:09:22,310
...هـ-هيونكل

126
00:09:26,390 --> 00:09:27,520
!أبي؟

127
00:09:29,400 --> 00:09:30,110
!أبي

128
00:09:35,110 --> 00:09:36,610
...هيونكل

129
00:09:36,860 --> 00:09:40,910
كنتُ قد فقدتُ القدرة على إخبارك بالحقيقة

130
00:09:41,240 --> 00:09:46,710
لذا أخفيتُ هذه الرّسالة سرّاً
داخل صدَفة الرُّوح هذه

131
00:09:47,040 --> 00:09:50,960
على أمل أن تسمعها يوماً ما

132
00:09:53,420 --> 00:09:57,300
هيونكل، آمل أن تعيش كإنسان

133
00:09:57,470 --> 00:10:00,430
!ويجب ألّا تكره أفان-دونو

134
00:10:00,600 --> 00:10:06,640
على العكس، اِكره هذا الوحش الأحمق
الذي قرّر تربية طفل بشريّ

135
00:10:07,390 --> 00:10:09,900
لكن فلتعلم أنّني كنتُ سعيداً

136
00:10:10,060 --> 00:10:16,780
لفترة قصيرة، شعرت هذه الجثّة الباردة بالدّفء

137
00:10:17,320 --> 00:10:20,530
...من فضلك دعني أقول هذا الكلام مرّة أخرى

138
00:10:21,450 --> 00:10:26,500
...هيونكل... شكراً لك على الذكريات

139
00:10:26,660 --> 00:10:28,620
!أبي

140
00:10:30,580 --> 00:10:34,750
!إذاً كان هدلر الشّخص الذي قتل أبي؟

141
00:10:35,510 --> 00:10:41,260
...وكان أفان يعلم أنّني ظننتُه قتلَ أبي

142
00:10:41,640 --> 00:10:44,510
!ومع ذلك اعتنى بي؟

143
00:10:46,270 --> 00:10:47,140
...أكاذيب

144
00:10:48,230 --> 00:10:49,940
!كلّها أكاذيب

145
00:10:53,520 --> 00:10:55,780
...سيف... وسحر

146
00:10:57,490 --> 00:10:58,990
!داي؟

147
00:10:59,860 --> 00:11:02,200
...سيف... وسحر

148
00:11:02,530 --> 00:11:04,080
!انتظر! داي

149
00:11:05,030 --> 00:11:08,660
ثمّة مشكلة ما. وكأنّه لا يعلم من أكون

150
00:11:08,960 --> 00:11:12,040
!هل يُعقل أنّه ليس واعيًا حتّى؟

151
00:11:13,170 --> 00:11:13,840
!داي؟

152
00:11:14,000 --> 00:11:18,340
مستحيل! أُصيب مباشرة بسكرايد
!الدّمويّ وما زال حيّاً؟

153
00:11:24,890 --> 00:11:27,390
مسدّس رصاص السّحر

154
00:11:29,890 --> 00:11:32,400
سكرايد الدمويّ

155
00:11:35,190 --> 00:11:38,150
أتذكّر أنَّ المعلّم أفان ذكرَ هذا

156
00:11:38,320 --> 00:11:44,820
أحياناً يستطيع الفنّان القتاليّ الاستمرار
في القتال حتّى بعد أن يُغمى عليه

157
00:11:45,580 --> 00:11:48,290
وكأنَّ غريزته القتاليّة هي التي تحرّكه

158
00:11:49,080 --> 00:11:51,580
!لا بدَّ أنّ هذا ما يحدث مع داي

159
00:11:51,750 --> 00:11:55,340
!داي، لا تفعل! سيقتلك

160
00:11:56,130 --> 00:11:59,340
!اللَّعنة عليك. سأقضي عليك حتماً هذه المرّة

161
00:11:59,510 --> 00:12:03,130
!توقّف! سمعتَ ما قالَه أبوك

162
00:12:03,300 --> 00:12:07,220
!ملِك الشّياطين هدلر هو من ينبغي أن تكرهه

163
00:12:07,390 --> 00:12:09,180
!كفَّ عن استخدامِ سيفك بغرض الشرّ

164
00:12:09,350 --> 00:12:10,680
!يكفي

165
00:12:12,560 --> 00:12:14,940
!لا مجال للتراجع بالنسبة لي

166
00:12:15,310 --> 00:12:17,940
!أنا قائد فيلق الخالدين التابع لجيشِ الشّياطين

167
00:12:18,360 --> 00:12:24,490
بجسدي المُغلّف بهذا الدرع الشّيطاني، أنا
!المُحارب الانتقاميّ، هيونكل

168
00:12:25,660 --> 00:12:26,990
...هيونكل

169
00:12:35,830 --> 00:12:37,090
!ها أنا قادم يا داي

170
00:12:45,550 --> 00:12:47,220
...سحر وسيف

171
00:12:47,390 --> 00:12:49,930
!هذا سيئ! إنّه ليس بسرعته المعتادة

172
00:12:50,100 --> 00:12:51,060
!هذه هي النّهاية

173
00:12:51,220 --> 00:12:53,520
!سحر... وسيف

174
00:12:55,440 --> 00:12:58,650
!ماذا؟! درعي الأعظم؟

175
00:12:59,770 --> 00:13:01,990
!سيفه يشتعل؟

176
00:13:02,740 --> 00:13:04,860
!"هذا لهب تعويذة "شرارة

177
00:13:05,030 --> 00:13:07,820
!لا أحد يستطيع تغليف سلاح ما بالسّحر

178
00:13:08,450 --> 00:13:14,040
إن كان هناك من يستطيع، فهو
!بالتأكيد يفوق البشر

179
00:13:24,380 --> 00:13:28,890
أجل! استطاع داي ابتكار هجمة جديدة
!في لحظة المأزق هذه

180
00:13:29,050 --> 00:13:32,770
...عندما لم ينجح السّحر والسّيف وحدهما، استخدمهما معاً

181
00:13:32,930 --> 00:13:34,230
!في سيفٍ سحريّ

182
00:13:34,390 --> 00:13:35,690
!اللَّعنة عليك

183
00:13:50,740 --> 00:13:52,160
!أحسنت! الآن

184
00:14:00,630 --> 00:14:01,250
!يا للهول

185
00:14:03,550 --> 00:14:05,970
!لن أخطئ هذه المرّة

186
00:14:06,380 --> 00:14:07,970
!يجب أن أفعل شيئاً

187
00:14:09,430 --> 00:14:11,680
!...الغيوم الرعديّة التي استدعيتُها

188
00:14:12,060 --> 00:14:16,600
!داي، البرق! أنزِل البرق

189
00:14:16,770 --> 00:14:19,190
...برق

190
00:14:19,350 --> 00:14:22,860
!استسلم! سأنهي الأمر بهذه الهجمة

191
00:14:23,020 --> 00:14:26,320
...برق... أنزِل

192
00:14:26,490 --> 00:14:28,150
!أنزِل البرق

193
00:14:28,320 --> 00:14:31,990
!خذ هذه! سكرايد الدمويّ

194
00:14:35,910 --> 00:14:36,700
!ماذا؟

195
00:14:36,870 --> 00:14:38,960
...رايدن

196
00:14:41,290 --> 00:14:43,590
!ستراش

197
00:14:55,260 --> 00:14:56,890
!فعلَها

198
00:14:57,060 --> 00:15:01,350
سواء كانت ناقصة أم لا، إنّها هجمة تدمج
!بين أفان ستراش وصعق

199
00:15:01,520 --> 00:15:04,230
...حتّى هيونكل لا يستطيع تحمّلها

200
00:15:10,320 --> 00:15:12,320
!هل هو خالد؟

201
00:15:23,420 --> 00:15:25,670
!انتصرنا! انتصرنا

202
00:15:32,510 --> 00:15:34,640
!هذا سيئ. انتهى أمري

203
00:15:34,970 --> 00:15:37,010
!داي، هذا يكفي

204
00:15:38,350 --> 00:15:39,600
!مام؟

205
00:15:39,930 --> 00:15:43,980
!داي، انتهى الأمر! لقد فزت

206
00:15:44,810 --> 00:15:50,030
أرجوك... لا أريد رؤية تلاميذ أفان
يقاتلون بعضهم بعضًا

207
00:15:53,070 --> 00:15:54,200
دموع؟

208
00:16:07,460 --> 00:16:09,380
!مام؟ هيونكل؟

209
00:16:09,760 --> 00:16:11,170
ماذا كنتُ أفعل؟

210
00:16:11,340 --> 00:16:12,510
...داي

211
00:16:12,970 --> 00:16:14,010
لماذا؟

212
00:16:14,760 --> 00:16:16,550
أنا عدوّكم

213
00:16:16,720 --> 00:16:18,430
لست عدوّنا

214
00:16:22,140 --> 00:16:23,600
...هذه

215
00:16:29,190 --> 00:16:31,940
احتفظتِ بها طوال هذا الوقت؟

216
00:16:32,110 --> 00:16:37,490
عرفتُ أنّ اللّحظة المناسبة
التي أعيدها لك فيها ستأتي

217
00:16:39,200 --> 00:16:43,500
...هذا الحنان... هذا الدفء العطوف

218
00:16:44,620 --> 00:16:45,960
...إنّها

219
00:16:47,460 --> 00:16:49,170
كأمٍّ مُقدَّسة

220
00:16:55,640 --> 00:16:57,720
!داي، هل أنت بخير؟

221
00:16:58,510 --> 00:17:01,930
بوب، غوميتشان... هل ربحت؟

222
00:17:02,100 --> 00:17:03,230
هذا صحيح

223
00:17:03,390 --> 00:17:04,310
...أنا

224
00:17:04,940 --> 00:17:06,230
خسرت

225
00:17:06,400 --> 00:17:07,860
هيونكل

226
00:17:13,990 --> 00:17:18,410
!ماذا تفعلين يا مام؟
!ماذا لو هاجمنا من جديد؟

227
00:17:18,570 --> 00:17:20,790
لا داعي للقلق

228
00:17:20,950 --> 00:17:23,830
وألا ينبغي أن أتلقّى العلاج أوّلاً؟

229
00:17:31,090 --> 00:17:32,460
!ما زلتُ أستخدم الشّفاء النصفيّ

230
00:17:32,630 --> 00:17:33,710
هذا يكفي

231
00:17:33,880 --> 00:17:39,470
!انظر إلى حالك يا هيونكل! تخسر ثمّ تُحضن

232
00:17:39,640 --> 00:17:42,060
!هذا مثيرٌ للشفقة لدرجة مضحكة

233
00:17:42,220 --> 00:17:45,020
!أنت... فلازارد

234
00:17:45,180 --> 00:17:49,270
!هذا صحيح! الأقوى بين قادة الفيالق الستّة

235
00:17:49,440 --> 00:17:52,400
!جنرال لهب الثّلج فلازارد

236
00:17:52,570 --> 00:17:56,200
ما خطب هذا الشّخص؟! كتلتان
!من النّار والثلج ملتصقتان

237
00:17:56,360 --> 00:17:58,110
!ماذا تفعل هنا؟

238
00:17:58,280 --> 00:18:04,080
!أليس هذا واضحاً؟! فكّرت في زيارتك وقتلك

239
00:18:05,750 --> 00:18:09,130
تعلم أنّني لم أحبّك يوماً

240
00:18:09,830 --> 00:18:15,170
!بشريّ يحاول نَيل كلّ المجد لنفسه؟! ولا بالأحلام

241
00:18:15,720 --> 00:18:20,140
حتّى لو ربحت، كنتُ أنوي قتلك ونسب إنجازك لنفسي

242
00:18:20,300 --> 00:18:23,350
!لكن خسارتك كانت نتيجة أفضل بكثير

243
00:18:23,510 --> 00:18:29,310
!سأقول أنّكم قتلتم بعضكم الآخر وأتستّر على عارك

244
00:18:30,230 --> 00:18:32,230
!يمكنك أن تبكي وتشكرني

245
00:18:35,280 --> 00:18:36,030
!ما هذا؟

246
00:18:37,700 --> 00:18:41,070
!أيقظتُ للتو هذا البركان الخامد

247
00:18:41,240 --> 00:18:44,660
!قريباً سيفيض هذا المكان بالحمم البركانيّة

248
00:18:44,830 --> 00:18:45,830
!ماذا؟

249
00:18:50,920 --> 00:18:53,000
!اللَّعنة عليك يا فلازارد

250
00:18:53,750 --> 00:18:57,170
!بئساً! يبدو أنّه غير مُرحَّب بي

251
00:18:57,510 --> 00:18:59,840
!أظنُّني سأتراجع الآن

252
00:19:00,010 --> 00:19:00,890
!رِفاق

253
00:19:01,550 --> 00:19:05,350
!استمتعوا بسباحتكم في الحمم

254
00:19:07,980 --> 00:19:09,810
!هذا سيئ! لا يمكننا الهرب

255
00:19:10,270 --> 00:19:11,600
!...إذا استطعنا الصُّعود هناك

256
00:19:11,770 --> 00:19:13,940
!استُنزفت قوانا تماماً

257
00:19:30,460 --> 00:19:31,500
!هيونكل

258
00:19:31,670 --> 00:19:35,750
!لن أدع أحداً منكم يموت هنا

259
00:19:36,840 --> 00:19:41,470
!كروكوداين، فهمتُ شعورك أخيراً

260
00:19:41,880 --> 00:19:45,300
آمل أن أتمكّن من الاعتذار منك في الحياة الآخرة

261
00:19:45,470 --> 00:19:48,680
...لكن حاليّاً، ولو للِحظة عابِرة

262
00:19:48,850 --> 00:19:52,900
!مدّني بقوّتك الهائلة

263
00:19:56,650 --> 00:19:58,780
!توقّف! لا تفعل يا هيونكل

264
00:20:07,660 --> 00:20:11,160
!هيونكل

265
00:20:11,750 --> 00:20:15,750
شكراً لكم. فتحت عينيّ أخيرًا

266
00:20:16,340 --> 00:20:20,590
...ليتني أستطيع مساعدتكم أنتم الثّلاثة أكثر من ذلك

267
00:20:21,170 --> 00:20:23,930
لكن يبدو أنّ نهايتي قد حانت

268
00:20:25,550 --> 00:20:26,760
!هيونكل

269
00:20:26,930 --> 00:20:29,140
!حذارِ! لن يصمد هذا المكان

270
00:20:29,310 --> 00:20:29,930
!مام

271
00:20:30,100 --> 00:20:32,100
!الصخور تتساقط علينا! علينا الهرب

272
00:20:32,270 --> 00:20:34,560
!...لكن هيونكل ما زال

273
00:20:35,060 --> 00:20:38,270
...الوداع يا داي وبوب

274
00:20:39,610 --> 00:20:42,070
...وداعاً... يا مام

275
00:20:42,900 --> 00:20:45,160
!هيونكل

276
00:20:54,040 --> 00:20:56,630
وهكذا انتهى فيلق الخالدين

277
00:20:56,790 --> 00:21:02,470
هيونكل-ساما، على الأقلّ دع موروغ
المتواضع هذا يرشدك إلى الحياة الآخرة

278
00:21:07,140 --> 00:21:09,930
سمعتُ أنّ القصر التّحأرضيّ قد دُمِّر

279
00:21:10,430 --> 00:21:14,190
يبدو أنّ البركان الخامد ثار فجأة

280
00:21:14,350 --> 00:21:16,480
بركان خامد يثور؟

281
00:21:17,940 --> 00:21:20,860
كم هذا مؤسف

282
00:21:21,650 --> 00:21:23,740
حسناً، لا يهمّ

283
00:21:23,900 --> 00:21:29,200
أخذ البطل الجديد معه، لذا يمكن
القول أنّه لم يكن عملًا سيّئًا

284
00:21:29,740 --> 00:21:31,290
...الجرأة

285
00:21:35,460 --> 00:21:40,040
كم تُرعبني رؤية رجل متعطّش للمجد

286
00:21:40,460 --> 00:21:45,300
حسناً! بعد موت هيونكل، أعتقد أنَّ
السّيطرة على قارّة هولكيا

287
00:21:45,470 --> 00:21:47,300
!هي عملي الآن

288
00:21:48,840 --> 00:21:54,890
بالطبع، كلّ ما عليّ فعله هو إيجاد
!الأميرة ليونا وقتلها

289
00:21:55,060 --> 00:21:58,100
!يا له من عمل يسير

290
00:22:20,040 --> 00:22:25,800
اللّطف هو سِحر النّاس اللُّطفاء

291
00:22:25,970 --> 00:22:32,810
ألا أملك خياراً إذاً سوى أن أكون شخصاً عاديّاً؟

292
00:22:32,970 --> 00:22:36,020
لستُ أدري

293
00:22:38,310 --> 00:22:43,980
حتّى لو تغيّر المكان الذي أعتبره موطِناً

294
00:22:44,150 --> 00:22:46,530
اسمعيني يا أُمّاه

295
00:22:46,690 --> 00:22:52,660
لن أبدِّل أولئك الذين أحميهم

296
00:22:53,120 --> 00:22:57,330
أتساءل ماذا كنتِ لتقولي

297
00:22:57,500 --> 00:23:01,540
قد أكون جباناً وصاغِراً أحياناً

298
00:23:01,710 --> 00:23:08,010
ماذا كنتِ لتقولي لي عندما أتردّد؟

299
00:23:08,170 --> 00:23:13,850
بخلافِ الحاضر الذي سعيتُ وراءه

300
00:23:14,010 --> 00:23:19,140
أنا متأكّدٌ أنّكِ كنت لتضحكي على خبيةِ أملي

301
00:23:34,030 --> 00:23:37,040
بعد هزيمتهم هيونكل، داي ورفيقاه

302
00:23:37,200 --> 00:23:41,710
إلى جانب باداك، يلتقون آمي، واحدة
من فرقة بابنيكا الثلاثيّة

303
00:23:42,040 --> 00:23:45,500
سوياً، يتوجّهون صوبَ قرية فالجي
حيث تنتظرهم ليونا

304
00:23:45,670 --> 00:23:51,130
لكن كانت الجزيرة مُحاصَرة سلفاً من طرف
عدوّهم الجديد، فيلق لهب الثّلج

305
00:23:52,260 --> 00:23:54,890
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

306
00:23:57,680 --> 00:23:59,560
!وتستمرّ المغامرة