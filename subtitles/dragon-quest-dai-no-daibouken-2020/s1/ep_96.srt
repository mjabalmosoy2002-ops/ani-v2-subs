1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:50,650 --> 00:01:54,070
لا يسعنى سوى الشّعور بالرّضا التامّ

20
00:01:55,070 --> 00:01:59,160
من الطبيعي أن تشعر بذلك
يا ملك الشّياطين فارن

21
00:02:03,330 --> 00:02:07,500
التزمتَ بهذه الخطّة المُحكَمة لآلاف السّنين

22
00:02:07,660 --> 00:02:10,500
والأمور الآن أثمرت أخيراً

23
00:02:10,670 --> 00:02:14,500
يؤلمني الاعتراف بذلك، لكن أبهرتني

24
00:02:15,090 --> 00:02:20,220
هذا هو صوت الشّخص الّذي تشاطرتُ معه العالم السُّفلي

25
00:02:22,600 --> 00:02:24,890
فيلزار، ملك الهاوية

26
00:02:40,410 --> 00:02:44,080
...فيلزار؟! أليس فيلزار هذا

27
00:02:46,200 --> 00:02:48,500
هذا لطفٌ منك يا فيلزار

28
00:02:48,660 --> 00:02:53,090
لم أتوقّع أن تأتي وتهنّئني

29
00:02:54,380 --> 00:02:59,930
يبدو أنّ الإشاعات بأنّك لا تستطيع
مُغادرة العالم السّفلي صحيحة

30
00:03:03,180 --> 00:03:04,430
...تلك المعركة

31
00:03:05,600 --> 00:03:08,770
...لولا تلك المعركة مع فارس التنّين

32
00:03:09,140 --> 00:03:14,770
!بروحي الخالدة، بوسعي العودة في نهاية المطاف

33
00:03:15,270 --> 00:03:16,190
...لكن

34
00:03:16,360 --> 00:03:20,780
أخذتْ أرواحُ سيليستا روحي المُنهزِمة

35
00:03:20,950 --> 00:03:24,830
وقيّدتها فوراً، لتتركني بهذه الحال

36
00:03:29,960 --> 00:03:34,750
،رغم أنّها لا تمتلك مهارات هجوميّة
إلّا أنّ لديها قوّة غامضة

37
00:03:42,180 --> 00:03:47,720
!اللّعنة عليهم أجمعين! فارس التنّين! والأرواح

38
00:03:48,140 --> 00:03:52,690
!وامتلاكها ميراث الآلهة يجعلها أكثر إحباطاً

39
00:03:52,850 --> 00:03:54,400
استعجلت

40
00:03:55,110 --> 00:04:00,150
بالطبع، بفضل ذلك، تمكّنتُ من التحرُّك بصمت

41
00:04:00,320 --> 00:04:05,280
هذا لأنّني عرفتُ بأنّك خطّطتَ
لتدمير العالم السّطحي

42
00:04:05,450 --> 00:04:07,490
أردتُ العالم السّطحي أيضاً

43
00:04:08,160 --> 00:04:11,710
أردتُ التصرُّف قبل أن تصبح جاهزاً للهجوم

44
00:04:13,370 --> 00:04:19,170
والآن، رغم شلّ حركتك، ما زلت
تمتلك ذلك الطموح

45
00:04:19,340 --> 00:04:24,090
مع الأسف، كيل، ذلك الحاصد
الّذي أرسلتَه قد مات

46
00:04:24,260 --> 00:04:24,930
!ماذا؟

47
00:04:25,090 --> 00:04:28,100
قُتِلَ بواسطة أبطال العالم السّطحي

48
00:04:28,260 --> 00:04:35,060
أنا متأكّد بأنّك أوكلتَه بقطعِ رأسي
إن لزمَ الأمر، لكنّه فشل

49
00:04:37,440 --> 00:04:38,770
...هذا الرّهان

50
00:04:39,440 --> 00:04:41,740
يبدو أنّني ربحت

51
00:04:44,360 --> 00:04:46,660
ر... رهان؟

52
00:04:48,030 --> 00:04:49,160
!كان ذلك رهاناً؟

53
00:04:50,040 --> 00:04:54,710
هذا صحيح. نحن في الأصل عدوّان في العالم السُّفلي

54
00:04:55,120 --> 00:04:57,750
لكنّنا نتشارك نفس الكراهيّة

55
00:04:58,380 --> 00:05:00,250
!نمقت الآلهة

56
00:05:00,800 --> 00:05:06,220
نبذونا ومنحوا السّلام لبشر العالم السّطحي فقط

57
00:05:06,380 --> 00:05:08,350
!ظلمهم لا يُغتفَر

58
00:05:08,760 --> 00:05:12,890
كان الخيار الوحيد لنا هو أن يصبح
!واحدٌ منّا إلهاً

59
00:05:15,100 --> 00:05:18,360
لذلك أنهينا عداوتنا

60
00:05:18,520 --> 00:05:21,230
كان ذلك قبل قرون

61
00:05:21,400 --> 00:05:25,030
حينئذ اقترحتُ رِهاناً بسيطاً

62
00:05:25,200 --> 00:05:27,610
،أن يسير كلُّ واحد منّا على خُطى خطّته

63
00:05:27,780 --> 00:05:31,410
ومن يخسر يخدم الفائز

64
00:05:32,660 --> 00:05:37,330
بالطبع، كما ترون كيف أرسلَ فيلزار
،كيل كي يقتلني

65
00:05:37,500 --> 00:05:40,960
لا أحد منّا كان يثِق بالآخر بالمُطلَق

66
00:05:41,880 --> 00:05:48,800
،حتّى بعد سقوط فيلزار وتقييده
استمرَّ كيل في مُراقبتي

67
00:05:49,510 --> 00:05:55,020
حتّى بذلك الوضع، لم يتخلَّ فيلزار
عن العالم السّطحي أبداً

68
00:05:55,180 --> 00:06:01,980
في الواقع، أخشى ألّا أملك خياراً
سوى الاعتراف بالهزيمة

69
00:06:02,150 --> 00:06:04,690
،هزمتَ فارس التنّين الحالي

70
00:06:04,860 --> 00:06:08,740
وتسعى للحصول حتّى على الشّمس

71
00:06:08,910 --> 00:06:12,830
أنت حقّاً رجلٌ مُرعب يا ملك الشّياطين فارن

72
00:06:13,740 --> 00:06:15,160
شكراً لك

73
00:06:15,330 --> 00:06:21,080
رغم أنّ العالم السّطحي سيزول، إلّا أنّ
هذا لن يكون سيّئاً بالنسبة لك

74
00:06:21,670 --> 00:06:25,920
من دون العالم السّطحي، سينهار
توازن العوالم الثّلاثة

75
00:06:26,090 --> 00:06:27,840
،لاحقاً، إن أحببت

76
00:06:28,010 --> 00:06:33,010
يمكنني اجتياح سيليستا وكسر
الختم الّذي يُقيّدك

77
00:06:34,220 --> 00:06:37,560
ماذا؟ هل جرحتُ كبرياءك؟

78
00:06:41,480 --> 00:06:45,730
!هذه حقّاً مُحادثة تفوق استيعابنا نحن الفانون

79
00:06:46,320 --> 00:06:51,200
...أرواح خالدة وآلهة

80
00:06:51,620 --> 00:06:54,410
!يتكلّمان على مستوى مُختلف تماماً

81
00:06:54,580 --> 00:06:56,750
!هذا أعلى من طاقتنا بكثير

82
00:06:56,910 --> 00:07:00,710
إذاً هذا داي، ابن الشّخص الّذي
قضى عليّ، باران

83
00:07:01,540 --> 00:07:05,090
إنّه كما الجثّة. عيناه خاليتان من الحياة

84
00:07:05,800 --> 00:07:10,510
،حتّى بالنظر إلى هزيمته على يدك
يبدو مُثيراً جدّاً للشفقة

85
00:07:11,010 --> 00:07:14,510
إنّه لا يُساوي نصف باران آنذاك

86
00:07:16,060 --> 00:07:17,520
أبي؟

87
00:07:18,770 --> 00:07:21,350
فيلزار فاشل حقّاً

88
00:07:21,520 --> 00:07:26,820
في الوقت الرّاهن، داي أقوى
من باران من كلّ ناحية

89
00:07:27,150 --> 00:07:29,320
كلّ ما يفتقر إليه هو ذلك التعطّش للدماء

90
00:07:30,200 --> 00:07:36,080
لم تكن هناك أيّ حدود لتعطُّش باران
للدماء. كان شيئاً لا نظير له

91
00:07:40,830 --> 00:07:44,250
!راودني ذلك! راودني ذلك أخيراً

92
00:07:45,290 --> 00:07:46,710
!أشعر بحقيقة الأمر الآن

93
00:07:47,500 --> 00:07:49,460
...أعدائي اللّدودون القُدماء

94
00:07:50,170 --> 00:07:52,760
...العقبة التي شكّلتها الآلهة

95
00:07:53,180 --> 00:07:56,430
!كلّهم يركعون أمامي

96
00:07:57,850 --> 00:08:00,730
!هذ نصر مُطلَق

97
00:08:04,270 --> 00:08:07,150
انتهى... الأمر

98
00:08:15,620 --> 00:08:16,950
!لا تستسلم

99
00:08:18,410 --> 00:08:21,620
!...هذا الصّوت! مستحيل

100
00:08:23,540 --> 00:08:24,540
!ميرلي

101
00:08:24,710 --> 00:08:29,590
!لا تستسلم! لا تفقد الأمل يا بوب

102
00:08:30,460 --> 00:08:32,550
!أنتِ حيّة يا ميرلي؟

103
00:08:32,720 --> 00:08:34,130
!والآخرون كذلك؟

104
00:08:39,430 --> 00:08:41,520
!الملكة فلورا والآخرون بخير؟

105
00:08:41,680 --> 00:08:42,430
أجل

106
00:08:42,600 --> 00:08:43,810
جميعنا بأمان

107
00:08:43,980 --> 00:08:47,520
تمكنّا من الإفلات من الانفجار

108
00:08:48,110 --> 00:08:49,650
كانت صدمة حقيقيّة

109
00:08:50,400 --> 00:08:54,900
استيقظتْ فجأة وحذّرتنا من الخطر

110
00:08:55,910 --> 00:08:58,870
كيف عرفتِ بأنّ العمود كان يسقط؟

111
00:08:59,030 --> 00:09:03,290
!وكيف أستطيع سماع صوتكِ أصلاً؟

112
00:09:03,460 --> 00:09:08,500
عندما كنتُ غائبة عن الوعي، عرفتُ بطريقة ما

113
00:09:08,670 --> 00:09:10,750
عرفتُ كلّ ما عرفتَه

114
00:09:11,130 --> 00:09:16,090
لهذا السّبب، عندما بلغَ خوفك
ذروته، استيقظت

115
00:09:16,260 --> 00:09:21,060
إذاً عندما كان داي يتصدّى لفارن
!بواسطة صعق، أفلتوا جميعاً

116
00:09:21,220 --> 00:09:24,390
لكن كيف حصلتِ على قدرة مُبهرة كهذه؟

117
00:09:24,980 --> 00:09:29,730
لا بدّ وأنَّ السّبب هو لأنّني
لم أنفك أفكِّر فيك

118
00:09:30,980 --> 00:09:35,780
يبدو أنّ بوب لم يكن الوحيد الّذي
وُلِد من جديد في تلك اللّحظة

119
00:09:36,490 --> 00:09:40,870
ميرلي أيضاً أيقظت إمكانيّاتها غير المُستغَلّة

120
00:09:41,030 --> 00:09:46,750
نعلم بأنّكم جميعاً في مأزق حقيقيّ

121
00:09:46,920 --> 00:09:49,460
!لكن لا يجوز أن تستسلموا

122
00:09:49,790 --> 00:09:53,340
!لا تفقدوا الأمل حتّى الرّمق الأخير

123
00:09:54,840 --> 00:09:56,380
...ميرلي

124
00:09:59,590 --> 00:10:03,010
يبدو أنّهم أفلتوا بالفعل

125
00:10:03,180 --> 00:10:06,230
لكن لم يؤخّروا موتهم إلّا لفترة وجيزة

126
00:10:08,980 --> 00:10:10,900
هذا صحيح يا ميرلي

127
00:10:11,060 --> 00:10:15,360
إذا كنتِ تعرفين ما رأيتُه، فلا بُدّ
أنّكِ تعلمين هذا أيضاً

128
00:10:15,990 --> 00:10:17,530
الأمر انتهى

129
00:10:18,200 --> 00:10:20,620
انتهى فعلاً

130
00:10:21,160 --> 00:10:24,580
...العالم الّذي نعيش فيه

131
00:10:25,370 --> 00:10:27,870
!على وشك أن يزول للأبد

132
00:10:30,290 --> 00:10:31,920
أنا آسف

133
00:10:32,090 --> 00:10:34,880
!لم نكن أقوياء بما يكفي

134
00:10:35,300 --> 00:10:38,170
...لكن... حقّاً

135
00:10:38,720 --> 00:10:42,300
!لا يسعنا فعل شيء حقّاً

136
00:10:42,680 --> 00:10:45,220
!لا! ما زالت هناك وسيلة

137
00:10:58,530 --> 00:11:00,240
ما زالت هناك وسيلة؟

138
00:11:00,410 --> 00:11:04,620
!الآن، لون بيروك ونوفا مُتوجّهان إلى العمود

139
00:11:04,780 --> 00:11:08,120
!لهذا لا يجوز أن تستسلم بعد

140
00:11:08,290 --> 00:11:10,160
!لون بيروك مُتوجّه إلى العمود؟

141
00:11:15,090 --> 00:11:18,510
جيّد. جمّدَتْها تعويذةُ عمود الجليد تماماً

142
00:11:18,670 --> 00:11:20,590
كنتُ مُحِقّاً

143
00:11:21,340 --> 00:11:24,350
،رغم أنّها تشحن قوّةً سحريّة

144
00:11:24,510 --> 00:11:29,100
النُّواة السّوداء هي في الأساس قنبلة ميكانيكيّة

145
00:11:29,680 --> 00:11:32,270
لن تنفجر ما لم تتفعّل

146
00:11:32,600 --> 00:11:36,320
،بينما تستطيع تعويذات أخرى تفجيرها

147
00:11:36,480 --> 00:11:40,360
إلّا أنّ تعويذة عمود الجليد تُجمّد سطحَ القنبلة

148
00:11:40,530 --> 00:11:45,530
!...هكذا إذاً! إذا جمّدنا كُلَّ النُّوى السّوداء

149
00:11:48,240 --> 00:11:49,290
إنّه فارن

150
00:11:49,750 --> 00:11:52,000
كم أنت أحمق يا لون بيروك

151
00:11:52,290 --> 00:11:56,290
لأنّك تساعد البشر في مُقاومتهم العقيمة

152
00:11:56,460 --> 00:11:59,380
أنت تُلوِّث اسمَ حِرفيّ العالم السُّفلي

153
00:11:59,550 --> 00:12:02,970
ما أدراك بأنّها عقيمة؟

154
00:12:03,130 --> 00:12:04,930
الجواب بسيط جدّاً

155
00:12:05,090 --> 00:12:07,390
الأعمدة قد تنشطَّتْ بالفعل

156
00:12:07,560 --> 00:12:09,810
حدثَ ذلك بصورة آنيّة

157
00:12:10,560 --> 00:12:12,480
،إذا انفجرَتْ واحدة فقط

158
00:12:12,640 --> 00:12:15,810
فإنَّ الحرارة الشّديدة ستكتسح العالمَ السّطحي

159
00:12:15,980 --> 00:12:19,480
غالباً ستُفجِّر النُّوى المُتبقّية

160
00:12:19,650 --> 00:12:23,820
...بصيغة أخرى، ما لم تُجمِّدوا النُّوى الستّة جميعها

161
00:12:23,990 --> 00:12:26,870
لا يمكنكم إيقاف انفجارها

162
00:12:27,870 --> 00:12:31,040
هل يمكنكم فعل ذلك بالوقت القصير المُتبقِّي؟

163
00:12:31,200 --> 00:12:32,660
لون بيروك

164
00:12:32,830 --> 00:12:35,790
!لا تُقحِم نفسك في هذا الصّراع العقيم

165
00:12:35,960 --> 00:12:41,090
إن أحببت، يمكنني استدعاؤك إلى
هنا، إلى قصر فارن

166
00:12:41,420 --> 00:12:44,720
سيكون هذا المكان بمأمن من الانفجارات

167
00:12:44,880 --> 00:12:46,340
كفاك مُزاحاً

168
00:12:46,720 --> 00:12:48,100
أرفُض عرضك

169
00:12:48,640 --> 00:12:50,770
،خلال القرون العديدة الّتي قضيتُها

170
00:12:51,140 --> 00:12:55,100
عشتُ أكثر فترة مُباركة تحت جناحك

171
00:12:55,440 --> 00:12:57,400
هذا ينطبق على الثّروة أيضاً

172
00:12:57,980 --> 00:12:59,070
...لكن

173
00:12:59,230 --> 00:13:01,150
كانت أكثر فترة مُملّة أعيشها

174
00:13:01,320 --> 00:13:05,490
وأعمق شعور يراودني بهدر الوقت

175
00:13:06,160 --> 00:13:09,660
لا أريد أن أعيش بتلك الطريقة ثانية أبداً

176
00:13:09,830 --> 00:13:14,620
مقارنة بذلك، الأسابيع القليلة الّتي مضت
،منذ لقائي بداي وأصدقائه

177
00:13:15,040 --> 00:13:19,340
رغم أنّها قصيرة، كانت فترة مُرضية تماماً

178
00:13:20,170 --> 00:13:25,340
كانت برّاقة بحجم بريق الأوقات
الأخرى من حياتي مُجتمِعة

179
00:13:25,840 --> 00:13:29,050
،إذا خُيِّرتُ لارتكاب نفس الخطأ ثانية

180
00:13:29,220 --> 00:13:32,180
،أختار بدلاً من ذلك مشاركة قدَر هؤلاء البشر

181
00:13:32,350 --> 00:13:34,270
الّذين أصبحتُ مُولَعاً بهم

182
00:13:35,640 --> 00:13:36,850
!مُعلّم

183
00:13:41,110 --> 00:13:42,780
أيُّها الوقح

184
00:13:42,940 --> 00:13:46,490
...أن تعتبر خدمتي خطأ

185
00:13:46,650 --> 00:13:51,330
!سأضع حدّاً لتلك الفكرة الخرقاء الآن

186
00:14:09,550 --> 00:14:12,640
أنت. ماذا تفعل؟

187
00:14:14,060 --> 00:14:16,980
هل سمعت ذلك يا داي؟

188
00:14:17,390 --> 00:14:22,940
يبدو أنّنا لا نملك وقتاً للاستلقاء والبُكاء

189
00:14:23,110 --> 00:14:29,450
!إن لم تكُن فُرصنا معدومة، عليّ تقديم المُساعدة إذاً

190
00:14:29,860 --> 00:14:33,280
!"يمكنني إطلاق "عودة" و"عمود الجليد

191
00:14:37,120 --> 00:14:38,370
!بوب

192
00:14:38,710 --> 00:14:45,300
أحمق. بإسقاط عمود فارن، تبخّرت
دائرة النّور السحريّة

193
00:14:45,460 --> 00:14:49,470
،ولحماية قصر فارن من الانفجار

194
00:14:49,630 --> 00:14:52,970
تصدّيتُ لها بقوّتي السّحريّة ثانية

195
00:14:53,140 --> 00:14:56,930
ما زلتُم لا تملكون وسيلة للعودة إلى العالم السّطحي

196
00:14:57,730 --> 00:15:00,520
ما زالت فُرصتكم معدومة

197
00:15:01,810 --> 00:15:05,480
كنتُ مُحِقّاً! تستطيع تعويذات
!عمود الجليد إيقاف النُّوى السّوداء

198
00:15:05,650 --> 00:15:08,530
!سأطلق "عودة" وأتوجّه إلى عمود رينغايا

199
00:15:09,240 --> 00:15:11,740
!دعوا روموس الشماليّة الغربيّة لي

200
00:15:11,910 --> 00:15:14,620
!انتظر! خذنا معك

201
00:15:14,780 --> 00:15:18,120
أوّلاً أنزِلنا في قلعة روموس

202
00:15:18,290 --> 00:15:22,580
سنرى ما إن كان هناك أيّ شخص من البلاد
الأخرى يستطيع استخدام عودة

203
00:15:22,750 --> 00:15:25,000
،نحتاج شخصاً يستطيع الوصول إلى بابنيكا الغربيّة

204
00:15:25,170 --> 00:15:28,260
شخصاً لجزيرة فالجي، وشخصاً لأورزام الجنوبيّة

205
00:15:28,420 --> 00:15:31,380
!ابحثوا بحثاً حثيثاً

206
00:15:31,550 --> 00:15:32,220
!حاضر

207
00:15:33,850 --> 00:15:37,010
الوقت يُداهمنا وتنقصنا الأيدي العاملة

208
00:15:37,180 --> 00:15:41,140
شخص يستطيع فوراً الوصول إلى
...الأعمدة واستخدام عمود الجليد

209
00:15:41,310 --> 00:15:44,270
!اللّعنة! ليتني أستطيع استخدام عودة

210
00:15:44,440 --> 00:15:46,230
!لاستطعتُ الذّهاب إلى بابنيكا

211
00:15:46,730 --> 00:15:49,030
،ميرلي، بقوّتكِ

212
00:15:49,190 --> 00:15:52,740
هل أنتِ قادرة على تحذير النّاس
حول العالم من الخطر؟

213
00:15:52,910 --> 00:15:55,370
هذا أعلى من قدراتي

214
00:15:55,530 --> 00:15:56,410
هكذا إذاً

215
00:15:57,080 --> 00:15:58,370
بالطبع

216
00:15:58,700 --> 00:16:03,080
مجرّد القدرة على التّواصل مع بوب أمر إعجازي

217
00:16:03,250 --> 00:16:04,580
!بوب

218
00:16:04,750 --> 00:16:07,750
!بوب، ما الخطب؟

219
00:16:08,000 --> 00:16:10,550
!ماذا يجدر بي أن أفعل؟

220
00:16:11,010 --> 00:16:15,430
ما الّذي تأمل تلك الحشرات الصّغيرة
المُتبقّية هناك أن تفعله؟

221
00:16:15,760 --> 00:16:18,060
لم تبقَ لهم إلّا دقائق

222
00:16:18,430 --> 00:16:20,430
فات الأوان

223
00:16:20,810 --> 00:16:21,770
هل أنت متأكّد؟

224
00:16:23,100 --> 00:16:24,440
...بوب

225
00:16:26,230 --> 00:16:30,940
إذاً أخيراً، يتذكّر ملك الشّياطين العظيم اسمي

226
00:16:31,440 --> 00:16:33,280
ما رأيك بهذا؟

227
00:16:36,820 --> 00:16:40,540
!لمَ لا تستسلم فحسب؟

228
00:16:41,500 --> 00:16:44,540
!أنتم! أما من أحد؟

229
00:16:45,080 --> 00:16:48,210
!أحد يستطيع الوصول إلى بابنيكا أو أورزام الآن

230
00:16:48,380 --> 00:16:52,090
!فليكشف عن نفسه! كائناً من يكون

231
00:16:53,550 --> 00:16:55,180
هذا سيّئ

232
00:16:56,300 --> 00:16:59,720
،تمكّنتُ من تجميد واحدة أخرى

233
00:17:00,350 --> 00:17:03,230
لكن لم أصل إلى أورزام

234
00:17:03,520 --> 00:17:06,100
...عليّ التّحليق إلى هناك، لكن

235
00:17:06,440 --> 00:17:08,610
...لا! ما الّذي

236
00:17:08,770 --> 00:17:11,820
!ألم أتعلّم شيئاً من اللّقاء بداي؟

237
00:17:11,980 --> 00:17:15,200
!ما زالت هناك ثلاثة أعمدة

238
00:17:15,530 --> 00:17:18,700
!كيف لي أن أستسلم هنا؟

239
00:17:21,410 --> 00:17:23,790
!سأزحف إلى هناك إن لَزِمَ الأمر

240
00:17:24,290 --> 00:17:26,040
!إلى أورزام

241
00:17:27,380 --> 00:17:29,670
لا يمكنك هزيمة ما لا يُهزَم

242
00:17:29,840 --> 00:17:34,590
كلّما قبلتَ ذلك أسرع، كان الأمر أسهل

243
00:17:34,970 --> 00:17:37,340
انظر إلى داي

244
00:17:38,840 --> 00:17:41,600
داي؟

245
00:17:42,640 --> 00:17:45,940
كم مدّة عمره برأيك؟

246
00:17:47,600 --> 00:17:52,020
،إنّه ابن فارس تنّين وبشريّ

247
00:17:52,190 --> 00:17:55,490
لذا أعتقد أنّ مدّة عمره مُكافئة لمدّة عمرنا نحن البشر

248
00:17:55,650 --> 00:17:59,740
أو ربّما يستطيع أن يعيش عمراً أطول بكثير

249
00:18:00,410 --> 00:18:02,200
عمّاذا تتكلّم؟

250
00:18:02,910 --> 00:18:04,330
يا ملك الشّياطين

251
00:18:04,870 --> 00:18:07,330
كم من العمر تستطيع أن تعيش؟

252
00:18:07,920 --> 00:18:09,290
آلاف السّنين؟

253
00:18:09,750 --> 00:18:11,340
عشرات آلاف السّنين؟

254
00:18:12,000 --> 00:18:14,050
أم أنّك لا تموت؟

255
00:18:14,960 --> 00:18:18,430
...أنت وذل الوحش فيلزار

256
00:18:18,800 --> 00:18:21,300
أنا واثق بأنّكما تعيشان حياة مديدة

257
00:18:22,140 --> 00:18:27,560
مقارنة بذلك، حياتنا نحن البشر

258
00:18:27,730 --> 00:18:30,350
أشبه بومضة ألعاب ناريّة

259
00:18:31,110 --> 00:18:33,980
،بينما كنتُ أستمع لـ لون بيروك للتو

260
00:18:34,730 --> 00:18:36,440
تذكّرت

261
00:18:36,900 --> 00:18:38,700
...آنذاك عندما كنتُ طفلاً

262
00:18:40,530 --> 00:18:43,950
أظنّني كنتُ في الخامسة أو السّادسة في ذلك الوقت

263
00:18:45,040 --> 00:18:48,540
ذات ليلة، فكّرتُ في الموت

264
00:18:48,960 --> 00:18:52,630
ماذا يحدث لنا عندما نموت؟
إلى أين ننتقل؟

265
00:18:53,420 --> 00:18:56,510
كلّما فكّرتُ في الأمر أكثر، زادَ خوفي

266
00:18:56,670 --> 00:18:59,470
في منتصف اللّيل، أجهشت بالبُكاء

267
00:19:00,090 --> 00:19:02,930
سارعَ والدايّ إليّ لتفقُّدي

268
00:19:03,720 --> 00:19:06,060
"لماذا يموت النّاس؟"

269
00:19:06,350 --> 00:19:08,810
"!لماذا لا يستطيعون العيش للأبد؟"

270
00:19:09,640 --> 00:19:13,900
كنتُ حائراً جدّاً. لم أستطع التوقُّف عن البُكاء

271
00:19:14,480 --> 00:19:16,440
...حينئذ أمّي

272
00:19:17,490 --> 00:19:19,780
ضمَّتْني أمّي

273
00:19:20,570 --> 00:19:22,820
...ثمّ قالت لي

274
00:19:23,780 --> 00:19:26,990
الجميع سيموتون يوماً ما

275
00:19:27,290 --> 00:19:30,290
...لهذا... لهذا

276
00:19:30,960 --> 00:19:34,040
يكرّس الجميع كلّ قوّتهم في الحياة

277
00:19:36,090 --> 00:19:37,510
هذا ما قالَتْه

278
00:19:49,850 --> 00:19:55,690
،مُقارنة بأمثالكم يا مَن تعيشون في العلالي

279
00:19:56,110 --> 00:20:02,530
حياتنا نحن البشر ليست إلّا ومضة، صحيح؟

280
00:20:04,910 --> 00:20:12,000
لكن لهذا السّبب، حتّى لو كان ذلك
!لا يغيّر شيئاً، سنظلّ نُكافح

281
00:20:13,120 --> 00:20:17,210
!كرّسنا كلّ قوّتنا في الحياة حتّى النّهاية

282
00:20:17,880 --> 00:20:23,680
!سواء بقي من عمرنا 50 عاماً أو 5 دقائق

283
00:20:24,300 --> 00:20:26,970
،إنّها ليست إلّا ومضة

284
00:20:27,140 --> 00:20:29,430
...لكن كومضة برّاقة

285
00:20:29,810 --> 00:20:33,310
!سنشتعل بريقاً ونعيش حتّى الرّمق الأخير

286
00:20:34,020 --> 00:20:38,150
!هكذا نعيش نحن البشر

287
00:20:38,690 --> 00:20:44,240
!لذا أمعِن النّظر أيُّها الوغد

288
00:20:51,500 --> 00:20:52,660
...بوب

289
00:20:53,120 --> 00:20:55,040
تماماً يا بوب

290
00:20:55,670 --> 00:20:57,920
هذا بوب الّذي أحبُّه

291
00:20:58,460 --> 00:21:01,010
!واصل المُحاولة حتّى النّهاية

292
00:21:11,520 --> 00:21:15,850
...متى شعرتُ باليأس فعلاً

293
00:21:16,650 --> 00:21:21,110
...متى شعرتُ برغبة الاستسلام

294
00:21:22,820 --> 00:21:26,280
تساعدني دوماً بجرعة الأمل الأخيرة تلك

295
00:21:28,200 --> 00:21:32,500
تساعدني دوماً على النّهوض

296
00:21:34,330 --> 00:21:36,710
...أنت صديقي الأعظم

297
00:21:37,080 --> 00:21:38,460
!يا بوب

298
00:21:43,260 --> 00:21:45,380
...أنا مسرور جدّاً لأنّني

299
00:21:46,470 --> 00:21:48,090
!التقيتُ بك

300
00:21:49,140 --> 00:21:50,300
!داي

301
00:22:11,120 --> 00:22:17,750
أخبرني، إلى أين أنت ذاهب بمفردك؟

302
00:22:20,630 --> 00:22:28,300
أحدّق بك من الخلف بينما تمضي بعيداً

303
00:22:30,300 --> 00:22:36,100
أخبرني، إلى أين أنت ذاهب بمفردك؟

304
00:22:39,900 --> 00:22:45,320
ندّعي الصّلابة ونتّبع أهواءنا

305
00:22:45,480 --> 00:22:49,740
وبدأنا بهذه الحكاية معاً

306
00:22:50,240 --> 00:22:56,040
هناك شيء يلمع وراء الأفق

307
00:22:56,200 --> 00:23:02,420
كنّا نبحث عن شيء ما

308
00:23:04,040 --> 00:23:09,260
في السّماء البعيدة، يتراقص في الهواء

309
00:23:09,430 --> 00:23:15,060
تغرّد الطّيور كما لو أنّها تنير المستقبل

310
00:23:15,220 --> 00:23:20,850
الوعد الّذي يربطنا، المغامرة التي نتشاركها

311
00:23:21,020 --> 00:23:27,030
من جديد في هذا العالم

312
00:23:33,780 --> 00:23:37,830
صيحة روح بوب دفعَتْ داي
إلى النّهوض على قدميه

313
00:23:38,000 --> 00:23:40,790
،ورغم أنّ الوضع ظلَّ بائساً

314
00:23:40,960 --> 00:23:46,090
إلّا أنّ داي وبوب يستمرّان في مُهاجمة
فارن ليُحيّرا ملك الشّياطين

315
00:23:46,250 --> 00:23:48,460
ليبدأ فارن بالتردُّد رويداً

316
00:23:48,630 --> 00:23:53,140
حينئذ، تبدأ جوهرة من مُجوهرات العين بالتوهُّج

317
00:23:53,300 --> 00:23:55,890
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

318
00:23:57,680 --> 00:23:59,810
!وتستمرّ المغامرة