1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:53,150 --> 00:01:54,280
!نلتُ منك

20
00:01:55,690 --> 00:01:58,530
!باران... يسقط

21
00:02:13,500 --> 00:02:15,920
!ماذا كان ذلك؟

22
00:02:16,090 --> 00:02:18,010
!أفان ستراش؟

23
00:02:18,510 --> 00:02:21,970
هل كان ذلك... الفتى البطل؟

24
00:02:22,140 --> 00:02:29,060
كـ-كيف يوجد هذا العدد الكبير من
!النّاس أقوى منّي؟

25
00:02:29,900 --> 00:02:33,400
!اللّعنة

26
00:02:36,530 --> 00:02:39,660
لم أسحب سيفي دون تفكير من قبل

27
00:02:39,820 --> 00:02:42,950
!شعرتُ بوحدة إرادتي وإرادة سيفي

28
00:02:43,120 --> 00:02:45,620
!نسيتُ أمر الختم تماماً

29
00:02:45,790 --> 00:02:49,290
...كلّ ما استطعتُ التفكير به كان الإنقاذ

30
00:02:51,750 --> 00:02:54,250
هذا سيفك إذاً

31
00:02:54,750 --> 00:02:56,130
مدهش

32
00:03:00,550 --> 00:03:06,930
بسيفينا، ولا حتّى بوّابة قلعة الشّيطان ستصمد

33
00:03:09,020 --> 00:03:10,390
!هيّا بنا يا داي

34
00:03:10,850 --> 00:03:13,900
!ركّز كامل قوّتك في هذه الضربة

35
00:03:14,060 --> 00:03:15,070
!حسناً

36
00:03:26,700 --> 00:03:28,080
!فعلناها

37
00:03:37,300 --> 00:03:38,960
!...هذا الاهتزاز

38
00:03:43,840 --> 00:03:45,640
اخترقاها

39
00:03:45,800 --> 00:03:50,310
خُتِمت تلك البوّابة بواسطة قوّة ملك الشّياطين

40
00:03:56,270 --> 00:03:58,480
أرسِل شخصاً آخر

41
00:03:58,650 --> 00:03:59,530
حاضر

42
00:04:01,110 --> 00:04:03,530
كم هذا مُدهش

43
00:04:04,700 --> 00:04:08,450
!فعلناها! فُتح المدخل إلى قصر فارن

44
00:04:08,620 --> 00:04:10,620
كان نجاحنا محتوماً

45
00:04:10,790 --> 00:04:17,170
فقوّة فارسَي تنّين متضافرتين هي قوّة
لا ينبغي لها أن تتواجد

46
00:04:17,340 --> 00:04:21,760
تحطيم البوّابة ليس هدفنا. ابقَ يقظاً

47
00:04:23,380 --> 00:04:26,890
!تعال! هدفنا هو ملك الشّياطين فارن

48
00:04:29,430 --> 00:04:33,100
...هذا الاهتزاز لا يمكن أن يعني إلّا

49
00:04:33,270 --> 00:04:35,810
!أنّ داي وباران اخترقا بوّابة قلعة الشّيطان

50
00:04:45,610 --> 00:04:47,070
!مات فينبرين

51
00:04:47,620 --> 00:04:49,700
!اللّعنة

52
00:04:49,870 --> 00:04:52,580
!لحظة! إلى أين أنت ذاهب يا هيم؟

53
00:04:52,750 --> 00:04:54,290
!للثأر لفينبرين

54
00:04:54,460 --> 00:04:56,210
!لن تفعل

55
00:04:57,170 --> 00:04:58,210
!...لكن

56
00:04:58,540 --> 00:05:03,340
هل نسيت عهدك لفخامته هادلَر يا هيم؟

57
00:05:14,560 --> 00:05:16,060
معكِ حقّ

58
00:05:17,850 --> 00:05:24,610
هدفنا هنا هو السّماح لفخامته هادلَر أن يقاتل
!داي وباران من أعماق قلبه

59
00:05:24,780 --> 00:05:25,610
!ماذا؟

60
00:05:25,780 --> 00:05:26,530
!...معنى هذا

61
00:05:28,910 --> 00:05:31,330
!سنتولّى أمركم هنا

62
00:05:35,540 --> 00:05:41,550
ينوي هادلَر مقاتلة داي وباران، فارسَي
التنّين، في آن واحد؟

63
00:05:49,890 --> 00:05:51,180
!هادلَر؟

64
00:05:51,350 --> 00:05:52,890
!إنّه بمفرده؟

65
00:06:10,740 --> 00:06:13,370
!مستحيل! ما الّذي جاء به إلى هنا؟

66
00:06:13,540 --> 00:06:17,410
!ممتاز. هذا ما أريده تماماً

67
00:06:19,080 --> 00:06:20,420
!هيونكل

68
00:06:20,580 --> 00:06:25,710
!تماسكوا. علينا أن نهزمهم ونتبع داي وباران

69
00:06:27,970 --> 00:06:33,010
!كلّ ذلك الضرر ومع ذلك أتى إلى ساحة المعركة؟

70
00:06:33,430 --> 00:06:36,770
هل هو بشريّ حقّاً؟

71
00:06:36,930 --> 00:06:42,480
لا بدّ وأنّه خالد. مثلنا تماماً

72
00:06:44,070 --> 00:06:49,110
!هذا ضربٌ من الجنون يا هيونكل. بالكاد تستطيع الوقوف

73
00:06:50,660 --> 00:06:53,330
!ذاك الأحمق الطائش العظيم

74
00:06:53,490 --> 00:06:55,120
!أيّها المتوحّش الضخم

75
00:06:55,700 --> 00:06:59,460
!لقد سئمتُ منك

76
00:07:08,010 --> 00:07:12,260
!هيونكل، هل أنت متأكّد من هذا؟
!من المؤكّد أنّ مجيئك إلى هنا لم يكن سهلاً

77
00:07:12,430 --> 00:07:13,800
لا تقلقي بشأني

78
00:07:13,970 --> 00:07:19,520
هذا صحيح! كلّ ما يستطيع فعله هو
!الوقوف على أيّ حال

79
00:07:19,680 --> 00:07:21,190
!لا داعي لتقلقي

80
00:07:21,350 --> 00:07:22,310
!بوب

81
00:07:22,480 --> 00:07:24,770
قِف مكانك فحسب

82
00:07:25,940 --> 00:07:29,440
مجرّد وقوفك خلفنا يكفي

83
00:07:30,280 --> 00:07:33,910
تبقى تلميذ أفان أقدم منّا

84
00:07:36,410 --> 00:07:37,790
...بوب

85
00:07:38,580 --> 00:07:41,250
...حتّى لو لم تستطع فعل شيء

86
00:07:41,410 --> 00:07:47,300
مجرّد مجيئك مدّنا بكثير من الشّجاعة

87
00:07:47,460 --> 00:07:49,170
لن نخسر

88
00:07:49,840 --> 00:07:52,090
استرخِ وقف مكانك فحسب

89
00:07:52,550 --> 00:07:58,390
أشكرك، لكن الوقوف مكتوف الأيدي
مُرهِق أكثر في الواقع

90
00:07:58,560 --> 00:07:59,810
سأنتهز فرصتي

91
00:07:59,970 --> 00:08:01,940
!تعلّم كيف تتقبّل إطرااء

92
00:08:05,770 --> 00:08:07,150
الفيل مفقود

93
00:08:07,980 --> 00:08:08,980
هل مات؟

94
00:08:09,400 --> 00:08:12,490
غالباً. لا بدّ وأنّ داي وباران قد انتصرا

95
00:08:12,650 --> 00:08:13,910
داي وباران؟

96
00:08:14,070 --> 00:08:17,280
يبدو أنّهم كشفوا خطّتنا سلفاً

97
00:08:17,990 --> 00:08:21,370
هادلَر ينتظر داي وباران

98
00:08:21,540 --> 00:08:25,130
ينوي مُقاتلة فارسَي تنّين؟

99
00:08:25,290 --> 00:08:27,090
هل هو واثق من نصره؟

100
00:08:27,250 --> 00:08:29,250
أم ينوي أن يموت؟

101
00:08:29,420 --> 00:08:30,130
...أم

102
00:08:30,710 --> 00:08:32,470
كلاهما معاً؟

103
00:08:33,130 --> 00:08:36,800
!علينا أن نسرع! ركّزوا على هزيمتهم

104
00:08:36,970 --> 00:08:39,060
!هذا كلامنا نحن

105
00:08:40,180 --> 00:08:44,190
!لستم الوحيدين الّذين لا يقبلون بالخسارة هنا

106
00:08:44,350 --> 00:08:48,400
!نرغب في إبادتكم جميعاً الآن

107
00:08:48,570 --> 00:08:53,950
!لذا لنرَ من يتمكّن من الذهاب إلى قائده أوّلاً

108
00:08:56,160 --> 00:08:58,870
حسناً، من سيهاجمني أوّلاً؟

109
00:09:00,290 --> 00:09:02,580
الوقت يداهمني

110
00:09:03,370 --> 00:09:06,040
هل هذه مزحة ما يا هادلَر؟

111
00:09:06,330 --> 00:09:12,010
أتعتقدنا ضعيفين لدرجة أنّك تستطيع الفوز بسهولة؟

112
00:09:13,130 --> 00:09:14,590
بالطبع لا

113
00:09:14,760 --> 00:09:18,890
فرسان التنّين هم أعظم مخلوقات خلقتها الآلهة

114
00:09:19,050 --> 00:09:25,270
،الشّخص الّذي كان تحت خدمتي، باران
جعلني أعيش حياتي خائفاً

115
00:09:25,440 --> 00:09:29,940
ارتعدتُ عندما علمتُ أنّك ستأتي لتهديد عرشي

116
00:09:30,480 --> 00:09:36,200
ثمّ عندما علمتُ أنّ داي فارس
تنّين، تملّكني الخوف أكثر فأكثر

117
00:09:36,650 --> 00:09:41,950
تخيّلتُ تعاونكما معاً لهزيمتي

118
00:09:43,240 --> 00:09:46,500
وتحوّل ذلك الخوف إلى حقيقة الآن

119
00:09:46,660 --> 00:09:53,550
.ومع ذلك، أرى نفسي أتطلّع لهذه المعركة
!ما أغرب الحياة

120
00:09:53,960 --> 00:09:58,510
نوى مقاتلتنا منذ البداية

121
00:09:58,840 --> 00:10:02,680
كان عصيان فينبرين غير مُتوقّع

122
00:10:02,850 --> 00:10:05,480
،يبدو أنّ في مكان ما بداخلي

123
00:10:05,640 --> 00:10:11,860
ما زالت هناك بعض النرجسيّة والرّغبة للمجد

124
00:10:12,020 --> 00:10:16,990
تجلّت في شخصيّة فينبرين من خلال السّحر المُحرّم

125
00:10:17,570 --> 00:10:21,570
ينمو الأطفال مُتشبّهين بآبائهم

126
00:10:23,700 --> 00:10:26,660
!والآن سوف أهزم داي البطل

127
00:10:26,830 --> 00:10:31,790
...وباران، إن أردت الدّفاع عن داي

128
00:10:31,960 --> 00:10:34,880
!فسأقضي عليكما معاً

129
00:10:35,460 --> 00:10:36,630
!أحمق

130
00:10:36,800 --> 00:10:38,930
!كفاك ثِقة مُفرطة بالنفس

131
00:10:40,220 --> 00:10:43,220
يبدو أنّ قوّتك قد ازدادت بطريقة ما

132
00:10:43,850 --> 00:10:48,180
لكن لا تتوقّع أنّك تستطيع مواجهة
!فارسَي تنّين في آن واحد

133
00:10:48,810 --> 00:10:52,690
!سأقتلك هنا وبنفسي

134
00:11:11,500 --> 00:11:14,380
!انتظر! هادلَر ليس مُفرط الثّقة

135
00:11:14,960 --> 00:11:17,380
!لقد أصبح شيطاناً خارقاً

136
00:11:17,550 --> 00:11:18,800
شيطان خارق؟

137
00:11:19,300 --> 00:11:24,140
!إنّه قويّ بما يكفي حقّاً لمقاتلتنا معاً

138
00:11:24,640 --> 00:11:28,810
!علينا أن نقاتل معاً! إنّها الطريقة الأكيدة لهزيمته

139
00:11:28,980 --> 00:11:30,230
هُراء

140
00:11:30,390 --> 00:11:34,650
!هل تُفضّل أن نقاتله معاً بعدما قاله؟

141
00:11:34,810 --> 00:11:37,820
!ألا تتمتّع بكبرياء كفارس تنّين؟

142
00:11:37,980 --> 00:11:40,610
لو كنتُ أستطيع الفوز بالكبرياء وحده، لفعلت

143
00:11:41,780 --> 00:11:46,830
!قلتَ بنفسك أنّ هدفنا هو ملك الشّياطين فارن

144
00:11:51,000 --> 00:11:57,250
ستبدأ إذاً. ذروة هذه المعركة

145
00:11:57,880 --> 00:12:00,470
من لديه اليد الطّولى؟

146
00:12:00,630 --> 00:12:03,760
،لعلّ هادلَر قد أصبح قويّاً جدّاً

147
00:12:04,140 --> 00:12:08,850
لكن أمام داي وباران وبكامل قوّتهما، لا يستطيع الفوز

148
00:12:09,520 --> 00:12:14,810
كان ابتعاده عن الحرس الملكيّ انتحاراً بكل معنى الكلمة

149
00:12:14,980 --> 00:12:16,810
أتقول انتحار؟

150
00:12:16,980 --> 00:12:19,440
،على ما يبدو بالنسبة لي

151
00:12:19,610 --> 00:12:24,570
ينوي استخراج قوّته لأقصى حدودها
من خلال اليأس

152
00:12:24,740 --> 00:12:27,410
حيلة ذكيّة من هادلَر

153
00:12:27,580 --> 00:12:30,660
،لكن إذا هُزِم هادلَر

154
00:12:30,830 --> 00:12:34,750
سيتمكّن التنّينان من الدّخول إلى القلعة

155
00:12:34,920 --> 00:12:36,290
لن يحدث هذا

156
00:12:36,460 --> 00:12:37,540
سيّدي؟

157
00:12:37,710 --> 00:12:42,170
هذه استحالة يا ميستوفارن

158
00:12:42,590 --> 00:12:47,430
ذلكما الاثنان لن يريا وجهي أبداً

159
00:12:49,060 --> 00:12:50,890
أسأتُ الحكم عليك يا داي

160
00:12:51,060 --> 00:12:53,850
...كنتُ قد ظننتُك قد نضجت كمُحارب

161
00:12:54,560 --> 00:12:58,610
لكنّك ما زلت بعيداً كلّ البُعد عن
!مُستوى فارس تنّين حقيقيّ

162
00:12:59,110 --> 00:13:03,570
إذا كان القلق بشأن الكبرياء يثنيني
،عن فعل ما يجب فعله

163
00:13:03,740 --> 00:13:06,820
فلا أريد إذاً أن أكون فارس تنّين حقيقيّ

164
00:13:07,200 --> 00:13:09,160
فضلاً عن أنّني بشريّ جزئيّاً

165
00:13:09,330 --> 00:13:11,910
دماء أمّي تجري في عروقي

166
00:13:14,410 --> 00:13:20,840
لطالما قاتلتُ لأجل أولئك المُحيطين
حولي، وأبذل قصارى جهدي

167
00:13:21,340 --> 00:13:27,470
بالنسبة لي، الحرص على هزيمة هادلَر
!وفارن هو أهمّ من كبريائي

168
00:13:28,720 --> 00:13:29,850
...داي

169
00:13:30,390 --> 00:13:34,060
بسرعة. من سيقاتل؟

170
00:13:34,430 --> 00:13:36,980
أم أنّكما ستقاتلانني معاً؟

171
00:13:40,360 --> 00:13:42,570
!سأقاتلك أنا يا هادلَر

172
00:13:43,320 --> 00:13:47,820
لن تصغي للمنطق، لذا لا أملك خياراً

173
00:13:47,990 --> 00:13:51,580
ستدرك ذلك خلال ثوانٍ فقط

174
00:13:51,740 --> 00:13:54,450
سيهاجمني داي أوّلاً إذاً

175
00:13:54,620 --> 00:13:56,160
!ها أنا قادم

176
00:13:58,120 --> 00:13:59,540
!يحمل هادلَر سيفاً؟

177
00:14:13,180 --> 00:14:19,060
!جيّد يا داي! تحسّنتَ منذ معركتنا السّابقة

178
00:14:29,360 --> 00:14:31,280
!داي ليس ضعيفاً

179
00:14:31,450 --> 00:14:35,620
!قوّة الهجمات التي ينفّذها تنافس قوّة هجماتي

180
00:14:36,330 --> 00:14:37,830
يا لك من سخيّ

181
00:14:38,620 --> 00:14:44,420
تقاتل بدلاً عن أبيك الّذي لا يملك
خبرة في مقاتلتي

182
00:14:44,590 --> 00:14:46,260
...لكن يا داي

183
00:14:46,630 --> 00:14:52,050
!لا تخل أنّك تعرف مدى قوايّ أيضاً

184
00:14:55,640 --> 00:14:57,020
!سلاح بيده اليُسرى؟

185
00:14:57,180 --> 00:14:58,890
!سلسلة الجحيم

186
00:15:05,400 --> 00:15:06,320
!دويّ

187
00:15:23,500 --> 00:15:25,420
!أفان ستراش

188
00:15:25,590 --> 00:15:27,170
!انفجار

189
00:15:34,510 --> 00:15:35,600
!داي

190
00:15:37,850 --> 00:15:39,100
!داي

191
00:15:40,060 --> 00:15:41,600
!هل أنت بخير؟

192
00:15:46,150 --> 00:15:47,820
ماذا قلتُ لك؟

193
00:15:48,480 --> 00:15:49,780
فهمتُ الآن

194
00:15:50,780 --> 00:15:55,370
أصبح هادلَر عدوّاً مُتمكّناً

195
00:15:58,910 --> 00:16:05,420
أحسنت يا داي. أنت لا تنفك تُدهشني

196
00:16:05,880 --> 00:16:07,300
أوجّه نفس الكلام إليك

197
00:16:07,460 --> 00:16:11,380
أبطلَ هجمتي، سترش، كلّياً بتعويذة نفجار

198
00:16:11,970 --> 00:16:15,850
سيتجدّد مثل هذا الجرح خلال وقت قصير

199
00:16:18,810 --> 00:16:21,680
!هذا... مستحيل

200
00:16:21,850 --> 00:16:25,560
!أنا متأكّد من ذلك! جمر الجحيم! نُواة سوداء

201
00:16:25,980 --> 00:16:27,150
!ما الخطب؟

202
00:16:27,320 --> 00:16:32,150
!كيف لملك الشّياطين فارن أن يفعل شيئاً همجيّاً كهذا؟

203
00:16:32,700 --> 00:16:36,370
!أن يزرع شيئاً كهذا داخل خادمه

204
00:16:36,910 --> 00:16:38,580
!نُواة سوداء؟

205
00:16:38,740 --> 00:16:42,870
!أخفيتَ شيئاً كهذا في جسد هادلَر؟

206
00:16:43,040 --> 00:16:45,290
هل فهمت الآن؟

207
00:16:45,920 --> 00:16:51,550
قلتُ ذلكما الاثنان لن يريا وجهي أبداً

208
00:16:52,050 --> 00:16:55,050
،حتّى لو سقطَ هادلَر

209
00:16:55,220 --> 00:17:00,310
،إذا تفجّرت النُّواة السّوداء في جسده

210
00:17:00,890 --> 00:17:05,140
على الأقلّ، ستتعادل النتيجة

211
00:17:05,690 --> 00:17:11,360
تتعادل؟ ستُدمّر ميدان الموت بأكمله

212
00:17:11,730 --> 00:17:17,870
ربّما، لكن هذا لن يطال قصر فارن

213
00:17:18,870 --> 00:17:24,540
فهُم يتقاتلون في الحدود الخارجيّة

214
00:17:28,580 --> 00:17:30,710
!ذاك الشيء... هو قنبلة؟

215
00:17:30,880 --> 00:17:32,210
هذا صحيح

216
00:17:32,590 --> 00:17:36,220
قنبلة خارقة القوّة من العالم السّفليّ
تُدعى النّواة السّوداء

217
00:17:36,380 --> 00:17:41,720
لا، بل هي سلاح كابوس يفوق تعريف القنبلة

218
00:17:42,310 --> 00:17:44,350
وما أدراك بذلك؟

219
00:17:44,520 --> 00:17:48,060
رأيتُ واحدة في العالم السّفلي من قبل

220
00:17:48,690 --> 00:17:53,230
النُّواة السّوداء هي حجر يُدعى بالبلّورة السّوداء

221
00:17:53,400 --> 00:17:57,150
يوجد في أعماق العالم السّفلي ويمتصّ
القوّة إلى ما لا نهاية

222
00:17:57,320 --> 00:18:00,070
يتمّ تسخيرها كسلاح باستخدام سحر أسود

223
00:18:00,450 --> 00:18:03,660
،لكن نظراً إلى قوّتها التدميريّة الهائلة

224
00:18:03,830 --> 00:18:10,790
حتّى مخلوقات الشرّ التي تستخدم السّحر المُحرّم
بشكل عفويّ يهابون استخدام النُّواة السّوداء

225
00:18:12,040 --> 00:18:17,170
قبل ثلاثة عشر عاماً، عندما عاثَ هادلَر
،فساداً في العالم السّطحي كملك شياطين

226
00:18:17,340 --> 00:18:23,350
قاتلتُ فيلزار، ملك الهاوية في العالم السّفلي

227
00:18:23,680 --> 00:18:30,610
استخدمَ فيلزار نُواة سوداء أثناء القتال
في إحدى قارّات العالم السُّفلي

228
00:18:30,770 --> 00:18:32,060
ماذا حدث؟

229
00:18:32,230 --> 00:18:35,400
تبخّرت القارّة بأسرِها

230
00:18:38,070 --> 00:18:43,740
أثناء محاولته قتلي، دمّرَ مستوطنته بنفسه

231
00:18:44,120 --> 00:18:50,420
حتّى فيلزار رفض استخدام نُواة سوداء بعد ذلك

232
00:18:51,040 --> 00:18:57,590
ولا عجب من ذلك نظراً إلى طموحه لحكم
العالم السّفلي والسّطحي معاً

233
00:18:58,340 --> 00:19:01,640
فما المغزى إذا لم يبقَ هناك ما يُحكَم؟

234
00:19:02,220 --> 00:19:06,560
...لكن أن يستخدم فارن نُواة سوداء

235
00:19:06,720 --> 00:19:12,270
يبدو أنّ خطّته ليست حكم العالم السّطحي

236
00:19:12,440 --> 00:19:14,480
إنّما إبادته

237
00:19:15,070 --> 00:19:19,740
لم أكن أنوي جعل هادلَر بيدقاً أضحّي به

238
00:19:20,280 --> 00:19:23,660
،لكن عندما أنقذتُه من حافّة الموت

239
00:19:23,820 --> 00:19:28,080
زرعتُها داخله كضمان

240
00:19:28,250 --> 00:19:34,340
ثمّ راح وحوّل نفسه إلى شيطان خارق

241
00:19:34,840 --> 00:19:38,130
كان هذا شيئاً حتّى أنا لم أتوقّعه

242
00:19:38,300 --> 00:19:44,720
تعزيز قوّته وكسر حدودها خلّف أثراً
عكسيّاً على النُّواة السّوداء

243
00:19:45,600 --> 00:19:49,680
قد تنفجر تلك القنبلة في أي لحظة

244
00:19:50,850 --> 00:19:57,360
تجلّى ذلك في هادلَر كنوبات من الألم المُبرِح

245
00:19:57,530 --> 00:20:04,410
وبالطبع، يظنُّ هو أنّ السّبب يعزو لتحوّله
إلى شيطان خارق فحسب

246
00:20:05,160 --> 00:20:08,370
...إنّ معرفة نتيجة معركة

247
00:20:09,540 --> 00:20:11,620
هي أمر مُملّ بالفعل

248
00:20:12,670 --> 00:20:16,420
لكن يجب أن نتابعها حتّى النِّهاية

249
00:20:17,130 --> 00:20:19,760
،بالنسبة لرجُلي ويدي اليُمنى

250
00:20:19,920 --> 00:20:24,890
قد يكون هذا استعراضه العظيم الأخير

251
00:20:27,220 --> 00:20:29,010
...هادلَر

252
00:20:29,180 --> 00:20:34,600
الصّحوة كمُحارب حقيقيّ قد قصّر عمرك في النّهاية

253
00:20:34,770 --> 00:20:36,560
يا للسخرية

254
00:20:37,190 --> 00:20:41,740
...كنتُ لأفضّل أن تنتصر وتنجو

255
00:20:42,240 --> 00:20:46,530
لكن إذا سقطت، فارحل على الأقلّ ببريق من المجد

256
00:20:46,700 --> 00:20:52,120
يكفيك شرفاً أن تعلم أنّ موتك سيكون
لأجل الملك العظيم فارن

257
00:20:57,630 --> 00:21:00,300
إذا انفجرت، سنكون في ورطة

258
00:21:00,460 --> 00:21:01,800
ماذا نفعل؟

259
00:21:01,960 --> 00:21:02,920
لا أعلم

260
00:21:03,090 --> 00:21:03,800
!ماذا؟

261
00:21:03,970 --> 00:21:08,760
لكن لا يمكننا استخدام تعويذات أو سيوف سحريّة

262
00:21:08,930 --> 00:21:10,850
سنقاتل باستخدام القوّة الصّرفة فقط

263
00:21:11,020 --> 00:21:14,190
!هذا مستحيل! لا يمكننا الفوز هكذا

264
00:21:14,350 --> 00:21:16,350
!أصغِ لي فحسب

265
00:21:16,980 --> 00:21:20,730
أشبِعت تلك النُّواة السّوداء بقوّة سحريّة عظيمة

266
00:21:21,360 --> 00:21:26,990
لا بدَّ وأنّها امتصَّت القوّة السحريّة المُعزّزة
الخاصّة بهادلَر واستنزفتها

267
00:21:27,700 --> 00:21:33,200
مجرّد ضربها بتعويذة قويّة قد يُفجّرها

268
00:21:34,000 --> 00:21:36,250
هل انتهيتما من التّخطيط؟

269
00:21:36,420 --> 00:21:40,210
!سأواجهكما معاً! ها أنا قادم

270
00:21:50,430 --> 00:21:51,180
!...هذا

271
00:21:51,350 --> 00:21:52,640
!يا للهول! إنّه قادم

272
00:22:07,280 --> 00:22:12,160
بصراحة كنتُ أخرق

273
00:22:12,330 --> 00:22:18,500
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

274
00:22:19,000 --> 00:22:23,960
وحتّى أنّني استخدمتُ الوحدة كسلاح

275
00:22:24,130 --> 00:22:29,890
بحثتُ في الدّيماس عن جواب بسيط

276
00:22:30,050 --> 00:22:35,720
حتّى لو تخلّيتُ عن الحقّ واللّطف

277
00:22:35,890 --> 00:22:41,860
أريد أن أكون موجوداً بجانبك فحسب

278
00:22:42,020 --> 00:22:47,490
أن أنادي باسمك

279
00:22:47,650 --> 00:22:53,490
هو أصعب من أي تعويذة سحريّة

280
00:22:53,660 --> 00:22:59,290
رغم أنّك مقرّب جدّاً منّي

281
00:22:59,460 --> 00:23:01,920
أحبّك

282
00:23:02,080 --> 00:23:05,210
أدركتُ ذلك أخيراً

283
00:23:05,380 --> 00:23:10,340
أن أنادي باسمك

284
00:23:10,510 --> 00:23:16,770
هو السّبب الّذي وُلدت لأجله

285
00:23:16,930 --> 00:23:22,690
سأتخلّص من هذا اللّيل الطويل

286
00:23:22,860 --> 00:23:25,400
وآتي لرؤيتك

287
00:23:25,570 --> 00:23:30,150
إلى حيث أنت الآن

288
00:23:33,780 --> 00:23:38,540
لتجنُّب تدمير النُّواة السّوداء وتنبيه
،هادلَر بوجودها

289
00:23:38,700 --> 00:23:41,750
يجب على داي وباران أن يهاجما بحذر

290
00:23:41,920 --> 00:23:45,130
من ناحية أخرى، هادلَر يهاجم داي وباران بتعنُّت

291
00:23:45,290 --> 00:23:48,300
يتهيّأ هادلَر لهجوم الاحتراق القاطع الخارق

292
00:23:48,460 --> 00:23:53,760
أمام احتمالات النّصر الهزيلة، يجازف
باران مُجازفة مُميتة

293
00:23:53,930 --> 00:23:56,350
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

294
00:23:58,390 --> 00:24:00,100
!وتستمرّ المغامرة