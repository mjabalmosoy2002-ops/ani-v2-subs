1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:03,830 --> 00:02:05,160
!هيونكل

20
00:02:05,330 --> 00:02:07,160
!يبدو أنّك استيقظت

21
00:02:09,250 --> 00:02:11,670
...هيم... والجميع

22
00:02:11,840 --> 00:02:13,210
ماذا حدث؟

23
00:02:13,380 --> 00:02:16,050
أخفتَنا عندما لم تعد تستجيب

24
00:02:16,210 --> 00:02:21,090
لو لم يأتِ غريب الأطوار هذا، لما استيقظت أبداً

25
00:02:21,260 --> 00:02:24,470
!ظلّ السيّد وحش يطلق عليك تعويذات شفاء

26
00:02:28,270 --> 00:02:29,390
هكذا إذاً

27
00:02:29,810 --> 00:02:31,980
تمكّنتُ من النجاة من جديد إذاً

28
00:02:34,400 --> 00:02:37,860
ساعدني هذا الرّجل أيضاً

29
00:02:38,030 --> 00:02:42,870
راودني شعور غريب عندما تمّت
معالجة جسدي بواسطة تعويذة شفاء

30
00:02:43,030 --> 00:02:45,160
!لكن عدتُ بكامل نشاطي

31
00:02:45,330 --> 00:02:48,410
أنت تمتلك الآن جسد كائن حيّ

32
00:02:48,710 --> 00:02:53,750
جوهريّاً، شبيه بهُلام معدنيّ
أو هُلام الملك المعدنيّ

33
00:02:53,920 --> 00:02:56,550
لهذا تفلح تعويذةُ شفاء

34
00:02:57,260 --> 00:02:59,510
إذاً أنا مثل تلك المخلوقات؟

35
00:02:59,670 --> 00:03:04,810
لكن بالنسبة لك، لن تتعافى بشكل كامل أبداً

36
00:03:06,350 --> 00:03:07,100
!ماذا؟

37
00:03:08,350 --> 00:03:11,900
،نظراً للضرر الجسيم الّذي نتج عن المعارك المتكرّرة

38
00:03:12,060 --> 00:03:16,610
تكبّدت عظامك إصابة غير قابلة للعلاج

39
00:03:16,780 --> 00:03:20,030
،يمكنك ربّما السّير بشكل طبيعي

40
00:03:20,200 --> 00:03:22,610
لكن لن تقاتل مجدّداً

41
00:03:23,740 --> 00:03:25,370
توقّعتُ هذا

42
00:03:25,660 --> 00:03:29,410
ثيابك طريف، لكنّك لست غريباً عاديّاً

43
00:03:29,580 --> 00:03:32,960
لا، أنا مجرّد عضو في مغاوير ملك الوحوش البرّية

44
00:03:34,250 --> 00:03:36,550
لكن هذا غير مهمّ

45
00:03:37,960 --> 00:03:40,670
فقد اكتسبتُ أمراً رائعاً بالمقابل

46
00:03:41,470 --> 00:03:42,680
صديق جديد

47
00:03:43,890 --> 00:03:48,560
!هذا صحيح. تلقّى كلّ جروحه بسببي

48
00:03:49,140 --> 00:03:50,100
كروكوداين

49
00:03:51,310 --> 00:03:54,190
...أعلم بأنّني سأشكّل عبئاً

50
00:03:54,600 --> 00:03:59,110
لكن هل يمكنك أن تأخذني إلى داخل
تلك القلعة حيث يقاتل داي والآخرون؟

51
00:03:59,280 --> 00:04:00,030
!ماذا؟

52
00:04:00,190 --> 00:04:03,110
!ينبغي أن تعود إلى الملكة فلورا

53
00:04:03,280 --> 00:04:08,160
قدّمتُ كلّ شيء لهذه المعركة. يجب أن أكملها

54
00:04:08,910 --> 00:04:12,710
...عندما يُسقِط سيفُ داي فارن

55
00:04:12,870 --> 00:04:14,540
أريد رؤية تلك اللّحظة

56
00:04:17,500 --> 00:04:20,880
حسناً، حسناً. سأحملك على كتفي

57
00:04:21,050 --> 00:04:24,340
ولو رفضتُ ذلك، ستزحف بنفسك، أليس ذلك؟

58
00:04:24,510 --> 00:04:25,890
لنذهب معاً

59
00:04:26,050 --> 00:04:29,850
!إن لزم الأمر، سأكون درعاً لحمايتك

60
00:04:33,020 --> 00:04:33,980
هيم؟

61
00:04:34,140 --> 00:04:35,940
يمكنك أن تستند على كتفي

62
00:04:36,100 --> 00:04:41,990
حتّى يأتي اليوم الّذي تُشفى فيه بشكل
،كامل عندما نحسم الأمور ثانية

63
00:04:42,150 --> 00:04:45,110
لا أريدك أن تموت أمامي

64
00:04:45,490 --> 00:04:50,660
حاليّاً، سأتولّى أمر كلّ الأعداء الّذين كان
من المفترض أن تقضي عليهم

65
00:04:53,160 --> 00:04:58,170
هكذا إذاً. هيم صديقه الجديد

66
00:04:58,880 --> 00:04:59,880
!قولاً سديداً

67
00:05:00,960 --> 00:05:04,760
!كنتَ عدوّاً في السّابق، لكنّك وحش بروح نبيلة

68
00:05:04,930 --> 00:05:06,260
!أنت تروقني

69
00:05:06,430 --> 00:05:09,970
!يمكنك الانضمام لمغاوير ملك الوحوش البرّية الخاص بي

70
00:05:10,140 --> 00:05:13,140
!ماذا؟! ما الّذي يثرثر حوله هذا القزم؟

71
00:05:13,310 --> 00:05:15,440
!"لستُ قزماً! نادِني بـ"القائد

72
00:05:18,400 --> 00:05:20,360
حريّ بك أن تصغي إلى ما يقوله

73
00:05:20,520 --> 00:05:24,070
فهو شخص تعلّمنا جميعاً احترامه

74
00:05:24,240 --> 00:05:25,450
بجدّية؟

75
00:05:25,610 --> 00:05:26,280
تماماً

76
00:05:26,450 --> 00:05:29,950
...دعني أرى... لا أحمل علامة، لذا

77
00:05:31,660 --> 00:05:33,330
تدبّر أمرك بهذه

78
00:05:35,330 --> 00:05:37,120
!ما هذه؟! لا أستطيع إزالتها

79
00:05:37,290 --> 00:05:39,080
بالطبع. فهي فرشاة سحريّة

80
00:05:39,250 --> 00:05:40,210
!أيُّها الوغد

81
00:05:40,380 --> 00:05:42,800
"!لستُ "وغداً"! قُل "قائد

82
00:05:42,960 --> 00:05:45,840
!...لم أصبح تابعك أيّها الوغد

83
00:05:46,010 --> 00:05:48,430
!"قلتُ لا تقل "وغد" بل قل "قائد

84
00:05:48,590 --> 00:05:51,930
ألم يصل للآخرين بعد؟

85
00:05:52,100 --> 00:05:57,560
ينبغي أن يكون أعظم شخص نافع يرجونه

86
00:05:58,940 --> 00:06:01,770
فارس البرّ لارهارت

87
00:06:09,360 --> 00:06:11,280
إذاً هذا... لارهارت

88
00:06:12,080 --> 00:06:14,870
أنت تشبه أباك

89
00:06:15,750 --> 00:06:18,160
!كيف عدت من الموت؟

90
00:06:18,330 --> 00:06:22,130
!والأهمّ، لماذا ترتدي رمح درع الشّيطان؟

91
00:06:22,290 --> 00:06:24,250
كان لي من الأساس

92
00:06:24,840 --> 00:06:27,550
ما أهمّية استخدامي له من عدمه؟

93
00:06:27,720 --> 00:06:32,390
ليس هذا ما قصدت! هيونكل...! أقصد ماذا حلَّ به؟

94
00:06:32,550 --> 00:06:38,310
نفّذَ واجبه واستهلك كامل قوّته قبل السّقوط

95
00:06:39,190 --> 00:06:39,850
!...إذاً

96
00:06:40,020 --> 00:06:43,480
لا تقلقوا. ذلك الرّجل خالد

97
00:06:46,320 --> 00:06:47,860
!بربّك! لقد أخفتنا

98
00:06:48,030 --> 00:06:52,990
إذاً ارتديت هذا الدّرع لتقاتل بدلاً من هيونكل؟

99
00:06:53,660 --> 00:06:56,580
لماذا... لماذا تقاتل لأجلنا؟

100
00:06:56,750 --> 00:06:59,330
لا. ليس لأجلكم

101
00:07:06,050 --> 00:07:09,260
أنا، لارهارت، أقاتل لأجلك فقط

102
00:07:09,420 --> 00:07:14,890
،للتعهّد بالولاء الأبديّ لك، يا خليفة فارس التنّين

103
00:07:15,060 --> 00:07:17,520
...أتيتُ لأقف أمامك

104
00:07:17,680 --> 00:07:18,850
مولايّ دينو

105
00:07:19,020 --> 00:07:21,020
!ماذا؟! لأجلي أنا؟

106
00:07:21,190 --> 00:07:21,850
!أجل سيّدي

107
00:07:22,020 --> 00:07:24,610
تريد أن تكون حليفنا إذاً؟

108
00:07:24,770 --> 00:07:27,030
ليس حليفك. بل تابعك

109
00:07:27,190 --> 00:07:28,190
!تابعي؟

110
00:07:28,360 --> 00:07:31,450
اطلب منّي أن أموت وسأفعل بكلّ سرور

111
00:07:31,610 --> 00:07:35,490
اطلب منّي أن أقاتل وسأواجه حتّى الآلهة

112
00:07:35,660 --> 00:07:40,210
ويمكنك استخدامي كما يحلو
لك لتصنع العالم الّذي تريد

113
00:07:41,290 --> 00:07:43,460
ماذا الآن؟ إنّه تابعي

114
00:07:52,930 --> 00:07:53,970
!ميستوفارن

115
00:07:55,350 --> 00:07:57,930
نجوت من ضربة من مخلب القَطْع الخاص بي

116
00:07:58,100 --> 00:08:00,980
لا بأس بك يا ميستوفارن، يا مركز
ثِقل جيش الشّياطين

117
00:08:01,350 --> 00:08:03,810
!أيُّها الحقير

118
00:08:04,560 --> 00:08:06,440
هيّا يا مولايّ دينو

119
00:08:07,020 --> 00:08:10,280
يمكنك أن توجّه لي الأمر الأوّل

120
00:08:11,700 --> 00:08:14,070
اطلب منّي هزيمته

121
00:08:15,820 --> 00:08:17,080
!ستدفع الثّمن

122
00:08:17,240 --> 00:08:20,200
ناجٍ مُلطّخ بالعار من أسياد التنّين

123
00:08:20,370 --> 00:08:24,670
!يخوننا ويكشّر عن أنيابه ضدّي؟ يا لها من مزحة

124
00:08:25,130 --> 00:08:27,380
!سأمزّقك إرباً

125
00:08:27,540 --> 00:08:32,720
دعني أكون واضحاً فحسب، لم يكن أسياد
التنّين جزءاً من جيش الشّياطين

126
00:08:32,880 --> 00:08:36,220
كنّا خدماً مُباشرين لفارس التنّين

127
00:08:36,390 --> 00:08:40,100
!أسياد التنّين الثّلاثة للبرّ والبحر والسّماء

128
00:08:40,270 --> 00:08:43,440
!لم نقاتل لحساب جيش الشّياطين يوماً

129
00:08:43,600 --> 00:08:46,770
!قاتلنا لأجل فخامته باران وحده دون سواه

130
00:08:47,190 --> 00:08:50,230
!المزحة الحقيقيّة أن تقول بأنّنا خنّاكم

131
00:08:51,320 --> 00:08:53,280
!هيّا يا مولايّ دينو. بسرعة

132
00:08:53,450 --> 00:08:55,200
!لكن ميستوفارن قويّ

133
00:08:55,700 --> 00:08:57,450
!ينبغي أن أقاتل أيضاً

134
00:08:59,910 --> 00:09:01,700
!أنت

135
00:09:05,790 --> 00:09:06,540
!لارهارت

136
00:09:06,710 --> 00:09:07,830
!أحمق! أنت أعزل

137
00:09:08,420 --> 00:09:09,840
ما هذا؟

138
00:09:10,000 --> 00:09:13,670
كيف ستمزّقني إرباً بالضبط؟

139
00:09:13,840 --> 00:09:14,970
!أحمق

140
00:09:15,130 --> 00:09:16,260
!هكذا

141
00:09:19,760 --> 00:09:20,720
!احذر

142
00:09:24,350 --> 00:09:25,270
!ماذا؟

143
00:09:31,320 --> 00:09:32,940
هل رضيت؟

144
00:09:34,110 --> 00:09:38,160
لمَ القلق على شخص لا يمكن إصابته؟

145
00:09:38,320 --> 00:09:39,990
...لـ-لكن

146
00:09:40,160 --> 00:09:42,910
ماذا حدث هناك بالضبط؟

147
00:09:43,080 --> 00:09:43,870
سراب

148
00:09:45,040 --> 00:09:46,960
ما رأيناه يُثقَب

149
00:09:47,120 --> 00:09:50,250
كان الظلّ الّذي تركه لارهارت
بعد التحرّك بسرعة فائقة

150
00:09:50,420 --> 00:09:52,250
بتعبير آخر، سراب

151
00:09:52,840 --> 00:09:56,470
رغم ذلك، ما زال لا يستخدم كامل قوّته حتّى

152
00:09:57,430 --> 00:09:58,930
إنّه وحش

153
00:09:59,090 --> 00:10:02,810
كيف تمكّن هيونكل من هزيمته حتّى؟

154
00:10:04,680 --> 00:10:06,140
إنّه قويّ

155
00:10:06,310 --> 00:10:09,650
قد يكون حتّى بمستوى لون بيروك

156
00:10:27,790 --> 00:10:28,830
مولايّ دينو

157
00:10:29,290 --> 00:10:35,840
ينبغي أن تكون مهمّتك هزيمة الملك
فارن لأجل البشر في العالم السّطحي

158
00:10:36,010 --> 00:10:40,090
يجب عليك السّعي وراء تحقيق
ذلك الهدف دون أدنى تردّد

159
00:10:40,260 --> 00:10:43,300
أنا مستعدّ لوهب حياتي لأجل ذلك

160
00:10:43,470 --> 00:10:48,730
،كانت تلك أمنية والدك، مولايّ باران
والّتي تركها في وصيّته الأخيرة

161
00:10:48,890 --> 00:10:50,020
!وصيّة أبي؟

162
00:10:50,190 --> 00:10:55,480
عندما بُعِثتُ من الموت بواسطة
...دماء التنّين الخاص بمولايّ باران

163
00:11:06,910 --> 00:11:11,420
كانت هناك رسالة تُرِكت داخل تابوتي

164
00:11:12,460 --> 00:11:16,420
كانت وصيّة مولايّ باران الأخيرة والتي تركها لي

165
00:11:17,670 --> 00:11:22,180
منحتك كلّ دماء التنّين، لكن أشكّ"
"في أنّ الآخرين سينجون

166
00:11:22,340 --> 00:11:28,810
،الفُرص ضئيلة، لكن إذا كان ينبغي أن تنبعث"

167
00:11:28,980 --> 00:11:33,100
"فأريدك أن تساعد دينو كما لو أنّك تساعدني

168
00:11:33,690 --> 00:11:38,440
في ذلك الوقت، أعتقد بأنّه إمّا ملك"
الشّياطين أو دينو بحدّ ذاته

169
00:11:38,610 --> 00:11:42,910
"سيُسقطني ولن يكون لي وجود بعدها

170
00:11:43,530 --> 00:11:50,660
كان مولايّ باران مستعدّاً سلفاً
للتضحية بنفسه لأجلك

171
00:11:51,080 --> 00:11:52,500
...أبي

172
00:11:54,670 --> 00:11:56,250
لارهارت

173
00:11:57,590 --> 00:12:01,930
ربّيتُك منذ كنت صغيراً

174
00:12:02,090 --> 00:12:06,300
أعلم بأنّك تضمر مشاعر كراهيّة شديدة تجاه البشر

175
00:12:06,470 --> 00:12:09,770
...ورغم معرفتي بذلك، سوف أسألك

176
00:12:09,930 --> 00:12:13,940
،إذا قال دينو بأنّ أمنيته هي حماية البشر

177
00:12:14,100 --> 00:12:17,610
هلّا قبلته وأطعته من فضلك؟

178
00:12:18,440 --> 00:12:25,160
أعتقد بأنّ ذلك الفتى يمتلك القوّة لتغيير البشريّة عينها

179
00:12:25,320 --> 00:12:30,370
هذا طلبي الأخير، لكن القرار قرارك

180
00:12:31,910 --> 00:12:36,460
إلى ابني الآخر، لارهارت

181
00:13:07,160 --> 00:13:10,950
كان... كان بمثابة الأب بالنسبة لي

182
00:13:11,410 --> 00:13:12,250
شكراً لك

183
00:13:13,660 --> 00:13:17,790
لارهارت، أحببتَ أبي من أعماق قلبك أيضاً

184
00:13:19,000 --> 00:13:20,500
...مولايّ دينو

185
00:13:21,050 --> 00:13:24,170
حسناً إذاً. سوف آمرك

186
00:13:24,340 --> 00:13:27,760
!ساعد بوب ومام واهزموا ميستوفارن

187
00:13:27,930 --> 00:13:29,850
!حاضر -
...وأيضاً -

188
00:13:30,010 --> 00:13:32,270
لديّ طلب آخر

189
00:13:33,140 --> 00:13:36,890
أرجوك... لا تنادِني دينو بعد الآن

190
00:13:37,350 --> 00:13:43,030
سماع ذلك الاسم يؤلمني. يذكّرني بأبي

191
00:13:44,650 --> 00:13:47,820
!عُلِم يا مولايّ داي، البطل

192
00:13:49,030 --> 00:13:50,950
!هيّا بنا يا ليونا وغوميتشان

193
00:13:51,120 --> 00:13:51,950
!حسناً

194
00:13:52,120 --> 00:13:53,750
!بوب! مام

195
00:13:53,910 --> 00:13:56,540
!هذه المرّة، سأترك الأمور على عاتقكما حقّاً

196
00:13:56,710 --> 00:13:58,880
!سوف أهزم فارن

197
00:13:59,040 --> 00:14:01,000
!أجل! هكذا هي المعنويات

198
00:14:01,170 --> 00:14:04,760
!لن نخطئ من جديد! اطمئنّ واسبقنا

199
00:14:04,920 --> 00:14:06,970
آمل ذلك بالتأكيد

200
00:14:08,510 --> 00:14:12,010
!سوف آمركما، لا تعترضا طريقي

201
00:14:12,180 --> 00:14:15,310
!يا إلهي! شخصيّة أخرى من تلك الشخصيّات

202
00:14:15,480 --> 00:14:19,480
!لكنّه مُنقِذ واعد! قد يفلح هذا

203
00:14:21,270 --> 00:14:26,280
...قد أنظر فعلاً لاحتمال

204
00:14:26,610 --> 00:14:29,410
القتال بكامل قوّتي

205
00:14:31,990 --> 00:14:34,830
!عدوّي الحقيقيّ موجود أمامنا

206
00:14:34,990 --> 00:14:37,250
...وللوصول إليه، الجميع

207
00:14:37,410 --> 00:14:41,710
...تلقّوا جروحاً بليغة... ووضعوا كلّ شيء على المحكّ

208
00:14:42,290 --> 00:14:45,380
!وذلك كي يتمكّنوا من الحفاظ على قوّتي

209
00:14:45,550 --> 00:14:46,960
!قوّتي بكاملها

210
00:14:47,340 --> 00:14:50,930
!والآن سوف أضرب ملك الشّياطين فارن بها

211
00:14:51,550 --> 00:14:56,470
!مهما كان العدوّ قويّاً

212
00:14:56,640 --> 00:14:57,770
!ها هو

213
00:15:08,990 --> 00:15:11,610
!هذا هو... برج السّيادة

214
00:15:11,780 --> 00:15:13,490
هذا صحيح

215
00:15:14,240 --> 00:15:16,870
اصعد بسرعة يا داي

216
00:15:18,290 --> 00:15:21,420
نفد مشروبي للتو

217
00:15:22,670 --> 00:15:24,420
...هذا الصوت! إنّه ملك الشياطين

218
00:15:24,590 --> 00:15:25,840
!فارن...

219
00:15:26,000 --> 00:15:32,590
لن أقول كلاماً ينمّ عن غرور مثل "أحسنت
"صنعاً بالوصول إلى هنا

220
00:15:32,760 --> 00:15:37,180
...نموّك ومُنقِذوك المتعدّدين

221
00:15:37,350 --> 00:15:40,940
كلّ ذلك فاق توقُّعاتي

222
00:15:41,350 --> 00:15:44,310
كل من ميستوفارن وكيلفارن

223
00:15:44,480 --> 00:15:49,190
يتصدّى لهما أصدقائك في هذه اللّحظة

224
00:15:49,360 --> 00:15:52,410
لم يبقَ لي أحد

225
00:15:53,070 --> 00:15:54,320
داي

226
00:15:54,490 --> 00:15:58,620
أرحّب بكم كمُتحدٍّ غير مسبوق

227
00:15:58,790 --> 00:16:04,330
اصعد سلالم برج السّيادة وتعال إليّ

228
00:16:05,000 --> 00:16:07,800
سأمنحك ترحيباً يليق بك

229
00:16:11,510 --> 00:16:13,050
هذه هي السّلالم

230
00:16:13,220 --> 00:16:16,680
ليونا، غوميتشان، توخّيا الحذر من هنا

231
00:16:26,270 --> 00:16:30,610
لست وحدك إذاً يا داي

232
00:16:31,650 --> 00:16:36,950
تلك المرأة... إنّها أميرة مملكة بابنيكا

233
00:16:38,490 --> 00:16:43,710
حسناً، يمكنك مرافقة من تشاء

234
00:16:43,870 --> 00:16:50,510
لكن يبدو أنّ فرسان التنّين لديهم
عادة جلب البليّة للنساء

235
00:16:52,970 --> 00:16:55,590
أعتقد بأنّ هذا غير مهمّ

236
00:16:57,970 --> 00:16:59,060
!داي

237
00:17:08,980 --> 00:17:10,980
ماذا تنتظر يا داي؟

238
00:17:13,530 --> 00:17:15,860
ليونا، استعيدي هذا السكّين

239
00:17:16,990 --> 00:17:23,000
هذا السكّين الّذي أعطيتِني إيّاه، إنّه آخر
سكّين من عائلة بابنيكا الملكيّة، صحيح؟

240
00:17:23,160 --> 00:17:24,660
...لهذا أردتُ

241
00:17:24,830 --> 00:17:27,080
!ماذا أصابك فجأة يا داي؟

242
00:17:27,250 --> 00:17:30,000
!لا تصغِ إلى ما يقوله فارن

243
00:17:30,550 --> 00:17:34,470
!إنّه يعبث معكم منذ ما قبل المعركة

244
00:17:35,010 --> 00:17:36,760
أعلم بانّه كذلك

245
00:17:37,760 --> 00:17:38,890
إذاً لماذا...؟

246
00:17:39,050 --> 00:17:42,890
أنا لا أفعل هذا لأنّني أقول الوداع

247
00:17:43,060 --> 00:17:44,480
بل العكس تماماً

248
00:17:44,640 --> 00:17:45,640
العكس؟

249
00:17:46,140 --> 00:17:52,360
،الآن، بغضّ النّظر عن ريش المُعلّم
أنتِ عزلاء من النّاحية الجوهريّة

250
00:17:52,530 --> 00:17:57,570
سأستخدم هالتي التنّينيّة بكامل قوّتها
وذلك كي لا أستخدم هذا السكّين

251
00:17:58,110 --> 00:18:02,990
لذا إذا حملتِه، فهذا يعني بأنّكِ
تحملين سلاحاً على الأقلّ، صحيح؟

252
00:18:04,200 --> 00:18:07,750
إذاً تعني بأنّني يجدر أن أعتني بنفسي؟

253
00:18:07,920 --> 00:18:09,420
نحن نقاتل فارن هنا

254
00:18:09,580 --> 00:18:13,630
لا يوجد ما يضمن فوزي أو حتّى حمايتك

255
00:18:13,920 --> 00:18:15,210
...لهذا

256
00:18:15,380 --> 00:18:17,220
!أريدكِ أن تقاتلي معي

257
00:18:17,380 --> 00:18:20,550
!إذا كنتِ ستواجهين الخطر، فواجهيه معي

258
00:18:25,310 --> 00:18:28,140
آسف. أطلب منكِ فوق طاقتكِ -
!كلّا -

259
00:18:32,020 --> 00:18:33,400
كلّا

260
00:18:33,940 --> 00:18:34,940
أنا مسرورة

261
00:18:49,500 --> 00:18:53,840
هذا أشبه بأوّل مرّة التقينا فيها

262
00:18:56,130 --> 00:19:00,180
آنذاك، أرفقتُ السكّين بك

263
00:19:00,340 --> 00:19:04,010
وألم نكن نحن الثّلاثة في جزيرة ديرملين؟

264
00:19:04,180 --> 00:19:06,270
!أنا وأنت وغوميتشان

265
00:19:14,690 --> 00:19:20,450
،واجهت صعوبة أمام عقرب واحد
والآن تقاتل ملك الشّياطين

266
00:19:21,200 --> 00:19:22,280
أجل

267
00:19:22,450 --> 00:19:25,660
كان قلبي ينبض بسرعة

268
00:19:25,830 --> 00:19:31,210
،كنّا سنذهب فقط إلى كهف في جزيرتي
لكن شعرتُ وكأنّ صدري سينفجر

269
00:19:31,370 --> 00:19:33,920
ماذا عن الآن؟ هل ينبض قلبك سريعاً؟

270
00:19:34,090 --> 00:19:35,880
لستُ أدري

271
00:19:36,050 --> 00:19:37,960
...قلبي ينبض

272
00:19:38,130 --> 00:19:41,180
لكن هذا مختلف عن السّابق

273
00:19:43,590 --> 00:19:48,850
لا أشعر إلّا بضيق في قلبي

274
00:19:52,560 --> 00:19:55,610
الأمر مختلف عن ذلك الوقت

275
00:19:56,360 --> 00:20:00,820
لم يعد داي مجرّد فتى مُغامِر بعد الآن

276
00:20:01,610 --> 00:20:07,280
لا يزال ضئيلاً، لكنّه بطل يحمل آمال كلّ البشر

277
00:20:07,450 --> 00:20:11,000
لا بدّ وأنّه يشعر بضغط هائل على كتفيه

278
00:20:11,620 --> 00:20:12,960
عليّ مساعدته

279
00:20:14,830 --> 00:20:21,380
.لا. حتّى لو لم يسعني فعل شيء
عليّ أن أخفّف عن عبئه بأيّ وسيلة

280
00:20:21,550 --> 00:20:27,600
وذلك كي يستطيع داي السّفر إلى كلّ
أنحاء العالم بقلب نيّر من جديد

281
00:20:45,820 --> 00:20:46,870
!ليونا

282
00:20:48,080 --> 00:20:48,910
!داي

283
00:20:51,000 --> 00:20:52,290
!ليونا

284
00:20:57,380 --> 00:21:00,880
هذا انقلاب مفاجئ للأحداث

285
00:21:01,050 --> 00:21:05,970
لم أتوقّع أن تتصرّف من تلقاء نفسها

286
00:21:06,140 --> 00:21:10,970
...لكن إذا هوجِمت، حينها هي

287
00:21:11,140 --> 00:21:14,060
!ماذا كان ذلك؟! ما الّذي أمسك بليونا؟

288
00:21:14,230 --> 00:21:17,400
!هل كان ذلك من صنيع فارن؟

289
00:21:24,990 --> 00:21:25,820
!...هذا

290
00:21:25,990 --> 00:21:27,280
!داي

291
00:21:30,790 --> 00:21:32,040
!ساعدني يا داي

292
00:21:32,200 --> 00:21:32,910
!ليونا

293
00:21:52,640 --> 00:21:54,640
!ما هذا؟

294
00:21:57,350 --> 00:21:59,020
!هل هو حيّ؟

295
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

296
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

297
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

298
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

299
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

300
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

301
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

302
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

303
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

304
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

305
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

306
00:23:33,780 --> 00:23:38,120
داي وليونا يسارعان لصعود برج
السّيادة لمواجهة ملك الشّياطين فارن

307
00:23:38,290 --> 00:23:41,960
لكن تُهاجَم ليونا فجأة بواسطة لوامس غامضة

308
00:23:42,120 --> 00:23:46,250
يلحقها داي ليصل إلى قلب قصر فارن

309
00:23:46,420 --> 00:23:50,470
هناك يجد شيئاً حتّى فارن لم يكن يتوقّعه

310
00:23:50,630 --> 00:23:53,510
ماذا سيحدث لداي وليونا؟

311
00:23:53,680 --> 00:23:56,010
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

312
00:23:58,350 --> 00:24:00,560
!وتستمرّ المغامرة