1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أشتعل حماساً

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:53,190 --> 00:01:53,860
!زابويرا

20
00:01:54,030 --> 00:01:54,690
مولايّ؟

21
00:01:54,860 --> 00:01:57,570
!استدعِ فيلقك الغامض حالاً

22
00:01:57,740 --> 00:01:58,360
!ماذا؟

23
00:01:58,530 --> 00:02:00,950
!سأستدعي حرّاسي النخبة كذلك

24
00:02:01,120 --> 00:02:07,870
سنحشد قوّاتنا المتبقّيين ونشنّ هجوماً
!شاملاً على داي

25
00:02:08,040 --> 00:02:13,340
انتظر لحظة يا مولايّ هادلَر! فشِلت
!تلك الخطّة سلفاً

26
00:02:13,500 --> 00:02:17,510
لا يُمكن هزيمة فريق داي بأي تكتيك بسيط

27
00:02:17,670 --> 00:02:21,350
الخيار الأفضل سيكون الاغتيال من خلال التّخطيط

28
00:02:22,470 --> 00:02:25,560
دع الأمر لي

29
00:02:25,720 --> 00:02:29,390
المُنتصِر ليس الشخص القويّ

30
00:02:29,560 --> 00:02:35,820
المُنتصِر هو من ينجو حتّى النّهاية
بأي وسيلة مُتاحة

31
00:02:53,380 --> 00:02:54,960
دعها تنام

32
00:02:55,130 --> 00:02:59,670
كانت تستخدِم تعويذة شفا كامل
بلا توقّف لمُداواة جروحنا

33
00:03:02,340 --> 00:03:06,810
كانت معركة صعبة. نحن محظوظون لأنّنا نجونا

34
00:03:09,390 --> 00:03:10,190
ما الأمر؟

35
00:03:10,350 --> 00:03:12,810
لم تنتهِ المعركة بعد

36
00:03:12,980 --> 00:03:16,530
لعلَّ باران قد رحل، لكن ما زال هناك
قادة الفيلق الآخرين

37
00:03:17,610 --> 00:03:22,910
لن نملك فُرصة إذا هوجِمنا الآن. سأبقى يقِظاً

38
00:03:23,070 --> 00:03:24,990
!لا يُمكنك وأنت بهذا الوضع

39
00:03:25,160 --> 00:03:26,370
هذا صحيح

40
00:03:26,540 --> 00:03:28,870
ينبغي لأنصاف الموتى أن يتروّوا

41
00:03:29,040 --> 00:03:29,960
بوب

42
00:03:30,120 --> 00:03:32,580
دعوا واجِب الحِراسة عليّ

43
00:03:32,750 --> 00:03:38,000
عمّاذا تتكلّم؟ إن كنّا أنصاف موتى فأنت ميّت أصلاً يا بوب

44
00:03:38,170 --> 00:03:40,550
!أنت أكثر من يحتاج للرّاحة

45
00:03:40,720 --> 00:03:43,510
،في الواقع، لا أعرف السّبب

46
00:03:43,680 --> 00:03:48,010
لكن أشعر بحالٍ أفضل ممّا كنتُ عليه قبل الموت

47
00:03:48,180 --> 00:03:49,680
كفاك تبجُّحاً

48
00:03:50,270 --> 00:03:53,690
تأكّد بنفسك إن كان تبجّحاً

49
00:03:59,280 --> 00:04:00,530
هل كانت هذه تعويذة وهيج؟

50
00:04:00,690 --> 00:04:05,030
هذا مستحيل ما لم تُركّز قوّتك السحريّة جيّداً

51
00:04:05,200 --> 00:04:09,240
رأيتم؟ أنا في أحسن حالاتي اليوم

52
00:04:09,750 --> 00:04:13,540
حسناً. يبدو أنّك الأفضل حالاً بيننا جميعاً

53
00:04:13,710 --> 00:04:19,000
لا تقلقوا بشأنِ ذلك. إن ساءت الأمور، سأصرخ

54
00:04:21,670 --> 00:04:27,600
يُقال أنّ شرب دماء التنّين الأسطوريّ يمنح الخلود

55
00:04:27,760 --> 00:04:33,060
ربّما جعلَ دماءُ باران جسدَ بوب أقوى من السّابق

56
00:04:33,230 --> 00:04:34,770
مُذهل

57
00:04:35,480 --> 00:04:38,980
إذاً إن شربتُم دمائي فسوف تُصبحون أقوى جميعاً؟

58
00:04:40,610 --> 00:04:43,530
قالَ باران أنّ دمك أقرب إلى دم إنسان

59
00:04:43,700 --> 00:04:49,160
ظننتُ أنّني إذا امتلكتُ تلك القوّة، قد
أحمي الجميع من الموت

60
00:04:52,290 --> 00:04:56,710
لا تقلق يا داي. لن نموت بسهولة

61
00:04:56,880 --> 00:04:59,170
وبمن في ذلك بوب

62
00:05:02,880 --> 00:05:04,590
لا تقلق

63
00:05:04,760 --> 00:05:08,510
هذا أقلّ ما يمكنني فعله لأكون مُفيداً

64
00:05:09,720 --> 00:05:14,810
فشِلَ هجومي الانتحاريّ وانتهى
الأمر بإنقاذي بواسطة هدفي

65
00:05:14,980 --> 00:05:17,020
يا للإحراج

66
00:05:17,190 --> 00:05:18,940
!لن أخفق في المرّة المُقبِلة

67
00:05:21,530 --> 00:05:24,150
لن أطلق ميغانتي ثانية

68
00:05:24,320 --> 00:05:26,910
قصدتُ فقط أنّني لن أخطئ

69
00:05:28,620 --> 00:05:31,120
عرفتُ أنّ بوب كان يضغط على نفسه

70
00:05:31,280 --> 00:05:35,370
سأبقى حتّى النّهاية. وعدتُ بذلك
في الطرف الآخر، أليس كذلك؟

71
00:05:37,250 --> 00:05:39,130
ألا تتذكّر؟

72
00:05:39,290 --> 00:05:41,420
أنت حقّاً غامض

73
00:05:43,590 --> 00:05:45,550
هل أنت حارِس أو ما شابه؟

74
00:05:46,050 --> 00:05:48,890
أرجوك لا تضغط على نفسِك أكثر من ذلك

75
00:05:51,510 --> 00:05:53,600
!من هناك؟! اكشف عن نفسِك

76
00:05:54,430 --> 00:05:57,060
تبدو الأمور عسيرة. أتحتاج مساعدة؟

77
00:05:57,770 --> 00:05:59,900
!هـ-هذا الصّوت

78
00:06:03,400 --> 00:06:04,690
!مام

79
00:06:06,070 --> 00:06:09,610
!أ-أهذا... أنتِ حقّاً؟

80
00:06:09,950 --> 00:06:13,830
هل نسيتَ وجه صديقتك بهذه السّرعة؟

81
00:06:13,990 --> 00:06:16,000
!لم أنسَ بالطبع

82
00:06:17,120 --> 00:06:21,080
هذه هي مام إذاً، إحدى تلميذات أفان

83
00:06:21,250 --> 00:06:24,710
يبدو بوب سعيداً جدّاً برؤيتها

84
00:06:25,420 --> 00:06:26,420
...لكن

85
00:06:26,590 --> 00:06:29,510
ماذا عن تدريبكِ على الفنون القتاليّة؟

86
00:06:29,680 --> 00:06:30,430
ماذا؟

87
00:06:30,590 --> 00:06:32,260
هل تدرّبتِ جيّداً الآن؟

88
00:06:32,430 --> 00:06:36,270
التّدريب. توقّفتُ قبل أن أكمله

89
00:06:36,430 --> 00:06:38,270
قلقتُ عليكم جميعاً

90
00:06:40,230 --> 00:06:43,770
مام تتوقّف عن فعل شيء قبل أن تُكمله؟

91
00:06:43,940 --> 00:06:46,820
لا أعرف السّبب، لكن لستُ مرتاحة لها

92
00:06:47,820 --> 00:06:51,030
أشعر بهالة شرّيرة حولها

93
00:06:52,700 --> 00:06:56,790
!يا إلهي! لا بدّ وأنّني أغار منها

94
00:06:57,910 --> 00:06:58,830
ما الأمر؟

95
00:06:59,000 --> 00:07:01,040
!لـ-لا شيء! انسي الأمر

96
00:07:01,210 --> 00:07:06,170
!لنذهب ونرَ داي وليونا والآخرين! سيتفاجؤون

97
00:07:10,430 --> 00:07:15,180
لا داعي يا بوب. إنّهم مُرهَقون من القتال ونائمون، صحيح؟

98
00:07:15,350 --> 00:07:17,180
دعنا لا نُوقظهم

99
00:07:17,350 --> 00:07:20,890
بالإضافةِ إلى أنّني أريد البقاء هنا فترة أطول

100
00:07:24,770 --> 00:07:27,820
ر-رائحة حلوة

101
00:07:27,980 --> 00:07:30,400
أشعر بدُوار

102
00:07:36,410 --> 00:07:37,290
...بوب

103
00:07:38,330 --> 00:07:43,000
لـ-لا أصدّق ذلك. لا يُمكن لمام أن تفعل هذا

104
00:07:44,080 --> 00:07:45,380
...بوب

105
00:07:46,130 --> 00:07:47,460
...مام

106
00:07:49,210 --> 00:07:50,220
!طابَتْ ليلتك

107
00:07:51,840 --> 00:07:53,390
!ماذا تفعلين يا مام؟

108
00:07:54,390 --> 00:07:56,550
أحضرتُ صديقاً معي

109
00:07:56,720 --> 00:07:57,310
!ماذا؟

110
00:07:57,470 --> 00:07:58,640
سأُعرّفك

111
00:08:00,600 --> 00:08:02,640
!هـ-هادلَر؟

112
00:08:02,810 --> 00:08:04,060
!...إذاً أنت

113
00:08:09,440 --> 00:08:10,780
!سمعتُ عنك

114
00:08:10,940 --> 00:08:13,450
أنا الأُسقُف الغامض زابويرا

115
00:08:13,610 --> 00:08:18,580
كنتَ تحرُس، لذا استعرتُ شكل
مام بتعويذة تحوُّل

116
00:08:18,740 --> 00:08:23,040
سمعتُ أنّك مُولع بهذه الفتاة

117
00:08:23,420 --> 00:08:25,710
...أ-أيّها المحتال

118
00:08:28,040 --> 00:08:29,750
نجحَتْ إذاً

119
00:08:29,920 --> 00:08:30,760
أجل

120
00:08:31,920 --> 00:08:33,840
!لا أستطيع الحركة

121
00:08:34,010 --> 00:08:36,800
!ماذا فعلت بي؟

122
00:08:38,640 --> 00:08:44,100
يحتوي جسدي على مئات من السّموم

123
00:08:44,270 --> 00:08:50,190
حقنتُ مخالبي بأكثر سمّ عصبيّ فعّال

124
00:08:51,230 --> 00:08:52,860
!...رِفاق

125
00:08:53,360 --> 00:08:56,660
!استسلِم! لا يمكنك حتّى الصُّراخ الآن

126
00:08:57,280 --> 00:08:58,370
...فضلاً عن ذلك

127
00:08:58,530 --> 00:09:02,870
،بفضلِ العطر الشيطانيّ الذي كنتُ أنشره

128
00:09:03,040 --> 00:09:06,620
!الجميع غارِقون في نوم عميق جدّاً

129
00:09:06,790 --> 00:09:10,750
يمكنك أن تغتالهم جميعاً الآن يا مولايّ هادلَر

130
00:09:10,920 --> 00:09:12,170
جيّد

131
00:09:13,920 --> 00:09:18,800
لكن لم أتوقّع أن يُقاوم هذا الشّخص العطرَ الشيطانيّ

132
00:09:18,970 --> 00:09:21,970
لعلّه اكتسبَ قوّة خاصّة ما

133
00:09:22,140 --> 00:09:24,930
هذا ليس مُستغرباً من أحد تلاميذ أفان

134
00:09:25,100 --> 00:09:29,770
يكتسِبون القوى في غفلةٍ عنك ويكشّرون عن أنيابهم

135
00:09:30,570 --> 00:09:33,610
يجب أن أقتله هنا

136
00:09:34,030 --> 00:09:35,860
خاب أملي يا هادلَر

137
00:09:36,030 --> 00:09:36,610
!ماذا؟

138
00:09:36,990 --> 00:09:40,780
لطالما كنتَ شديداً قاسياً، لكن لم
تلجأ للحِيل الرّخيصة يوماً

139
00:09:40,950 --> 00:09:47,330
تقاتلنا من قبل، لكن كنتَ دائماً ما تتحلّى
!بكبرياء ملِك الشّياطين

140
00:09:47,670 --> 00:09:53,050
فتلجأ الآن للحِيل الرّخيصة التي يستعمِلها
!هذا العفريت العجوز

141
00:09:53,630 --> 00:09:55,970
!إلى أي مُستوى سقطت العظَمة؟

142
00:09:56,130 --> 00:09:58,640
!اصمُت

143
00:09:58,800 --> 00:10:04,270
لا أريد الفشل من جديد! لا أملك الفرصة
!لأكون نيّقاً في خياراتي الآن

144
00:10:04,970 --> 00:10:09,730
ردّدَ كروكوداين الكلامَ ذاته من قبل

145
00:10:10,150 --> 00:10:12,860
!لكن في النّهاية، أدركَ الحقيقة

146
00:10:13,360 --> 00:10:19,410
!هناك أمور أهمّ من الفوز أو الخسارة

147
00:10:20,910 --> 00:10:23,700
!أتعتقد أنّك تستطيع وعظ مولايّ هادلَر؟

148
00:10:24,120 --> 00:10:26,620
!سأقضي عليك بنفسي

149
00:10:26,790 --> 00:10:29,870
!بضع وخزات إضافيّة وستموت حتماً بعدها

150
00:10:32,750 --> 00:10:35,460
!حان وقتُ الموت

151
00:10:37,170 --> 00:10:37,760
!ماذا؟

152
00:10:40,050 --> 00:10:42,760
!أبعِد كفّيك القذرين عنه

153
00:10:42,930 --> 00:10:45,600
!مـ-من تكون؟

154
00:10:46,810 --> 00:10:50,270
!المُرشِد... ماتوريف

155
00:11:02,120 --> 00:11:04,200
!مـ-من تكون؟

156
00:11:04,370 --> 00:11:06,450
!المُرشِد... ماتوريف

157
00:11:08,200 --> 00:11:13,790
أحمق، تسمح لهما بخِداعك. عليك
أن تُصقِل بصيرتك أكثر

158
00:11:13,960 --> 00:11:14,960
آسف أيُّها المُرشِد

159
00:11:15,130 --> 00:11:21,630
تذكّر، يجب على السّاحر أن يكون دوماً
الأعلى ذكاء في المجموعة

160
00:11:22,140 --> 00:11:24,220
،حتّى عندما يتعب الجميع

161
00:11:24,390 --> 00:11:28,730
عليك أن تبقى هادئاً وتقرأ وتحلّل الوضع

162
00:11:28,890 --> 00:11:33,100
على الأقلّ هذا كان ما فعلتُه أثناء العمل مع أفان

163
00:11:33,940 --> 00:11:36,020
!الآن تذكّرت

164
00:11:36,570 --> 00:11:40,190
!كنتَ في صفِّ أفان وقاومتَني

165
00:11:40,360 --> 00:11:44,280
!وصفتَ نفسك بالسّاحر البشريّ العظيم الأقوى

166
00:11:44,450 --> 00:11:47,830
مرحباً، تبدو بخير يا ملِك الشّياطين الرّديء

167
00:11:47,990 --> 00:11:49,330
!ماذا قلت؟

168
00:11:49,500 --> 00:11:54,080
عاندتَ الموت لذا تترتّب عليّ الآن مهمّة التنظيف

169
00:11:54,250 --> 00:11:58,000
بالإضافة إلى أنّك قتلتَ أحد أصدقائي الوحيدين

170
00:11:58,170 --> 00:12:01,510
كان رجلاً طيّباً. كان كذلك حقّاً

171
00:12:01,670 --> 00:12:05,260
ولم يكن حتّى بثُلث سنّي

172
00:12:05,430 --> 00:12:09,520
روكا... أفان... كلّ الطيّبين ماتوا

173
00:12:09,680 --> 00:12:13,310
بينما يعيش مُحتالون مثلي ومثلك

174
00:12:13,480 --> 00:12:15,610
يا له من عالم قبيح

175
00:12:18,730 --> 00:12:24,450
دعني أطرح عليك هذا العرض. سأرسلك إلى
الحياة الآخرة، لذا اذهب واعتذِر من أفان

176
00:12:24,610 --> 00:12:26,240
!اصمت أيّها العجوز الأحفورة

177
00:12:27,120 --> 00:12:30,700
!سأجعلكم رماداً جميعاً

178
00:12:31,330 --> 00:12:32,250
لهيب

179
00:12:33,830 --> 00:12:34,500
!ماذا؟

180
00:12:36,830 --> 00:12:38,090
ترياق

181
00:12:38,250 --> 00:12:40,170
!تعويذتان في آن واحد؟

182
00:12:42,720 --> 00:12:47,510
لن يُشفى فوراً. أصابوه بسمٍّ قويّ

183
00:12:48,970 --> 00:12:50,430
!لا تغترّ

184
00:12:52,640 --> 00:12:54,390
!ما رأيك بهذا؟

185
00:12:55,900 --> 00:12:57,730
!لظى

186
00:12:59,440 --> 00:13:02,940
!مـ-مستحيل! هذا غير مُمكن

187
00:13:04,450 --> 00:13:06,110
!لظى

188
00:13:15,210 --> 00:13:19,880
!كـ-كيف لمجرّد بشريّ أن يستخدم لظى؟

189
00:13:20,040 --> 00:13:24,880
!أتظنّ أنّك تحمل براءة اختراع؟ لا تغترّ بنفسك

190
00:13:27,930 --> 00:13:32,390
!أنا أخسر! هل قوّته السحريّة أعظم من قوّتي؟

191
00:13:33,600 --> 00:13:34,890
!زابويرا

192
00:13:35,060 --> 00:13:37,310
!ساعدني بسرعة

193
00:13:39,230 --> 00:13:41,110
!هذه لأجل ذراعي

194
00:13:41,270 --> 00:13:42,440
!لهيب

195
00:14:03,460 --> 00:14:08,510
!ليتني كنتُ أصغر! لا يستطيع جسدي تحمّل التّعويذة

196
00:14:09,180 --> 00:14:12,560
!لـ-لا! مُرشدي في خطر

197
00:14:12,720 --> 00:14:16,730
!في هذه الحالة، سيموت جميع من في الكوخ أيضاً

198
00:14:16,890 --> 00:14:21,190
!لا! استيقظوا جميعاً! استيقظوا أرجوكم

199
00:14:21,360 --> 00:14:25,990
!الضّخم! هيونكل! الأميرة! داي

200
00:14:26,440 --> 00:14:28,070
!داي

201
00:14:32,160 --> 00:14:34,330
يبدو أنّك أنهِكتَ تماماً

202
00:14:34,490 --> 00:14:38,830
!في النّهاية، أنت من سوف يرى أفان

203
00:14:50,680 --> 00:14:51,930
!فعلناها

204
00:15:04,070 --> 00:15:05,230
!داي؟

205
00:15:08,610 --> 00:15:10,610
!داي

206
00:15:10,780 --> 00:15:13,070
!يُفترض أن تكون نائماً

207
00:15:13,240 --> 00:15:16,040
!سمعتُ بوب يناديني

208
00:15:16,200 --> 00:15:17,450
!هذا مستحيل

209
00:15:17,620 --> 00:15:22,460
!ارحل يا هادلَر! لن أدع صديقاً آخر يموت

210
00:15:22,630 --> 00:15:24,630
!اللّعنة عليك

211
00:15:24,790 --> 00:15:27,510
!لا مزيد من خسارة الأصدقاء

212
00:15:27,670 --> 00:15:31,840
!لهيب

213
00:15:56,330 --> 00:15:58,870
،ركّز كلّ قوّته في قبضته

214
00:15:59,040 --> 00:16:03,080
وعكسَ تعويذة لهيب خاصّتهما بتعويذة لهيب خاصّته

215
00:16:03,540 --> 00:16:06,090
حتّى أنا لا أستطيع فعل ذلك

216
00:16:08,420 --> 00:16:09,260
!هل أنت بخير؟

217
00:16:09,420 --> 00:16:10,670
أ-أجل

218
00:16:10,840 --> 00:16:12,050
!فعلتَها

219
00:16:12,220 --> 00:16:16,760
أصبتَهما بكلّ طاقة الحرارة تلك. قُضي
على هادلَر بكلِّ تأكيد

220
00:16:16,930 --> 00:16:20,850
لا أعلم. إنّه عنيد جدّاً

221
00:16:22,730 --> 00:16:26,020
آسف. توجّب عليك إنقاذي من جديد

222
00:16:26,860 --> 00:16:31,530
لكن... لكن أتعلم؟ أنا مُمتنٌّ لما قلتَه

223
00:16:31,690 --> 00:16:34,530
"لن أدع صديقاً آخر يموت"

224
00:16:38,620 --> 00:16:40,450
يا لكما من عاطفيّين

225
00:16:41,330 --> 00:16:43,120
ماذا حدث؟

226
00:16:43,790 --> 00:16:45,580
!...هـ-هذا

227
00:16:45,750 --> 00:16:50,710
!هل نمنا ولم نشعر بانفجار بهذا الحجم؟

228
00:16:50,880 --> 00:16:52,920
أتى زابويرا وهادلَر

229
00:16:53,090 --> 00:16:54,510
!ما-ماذا؟

230
00:17:01,310 --> 00:17:04,230
تمكّنتُ من الإفلاتِ بتعويذة عودة

231
00:17:04,390 --> 00:17:06,560
!أولئك الأطفال الأشقياء القذرون

232
00:17:07,360 --> 00:17:10,780
أشكُّ في أنّ هادلَر نجا من ذلك

233
00:17:10,940 --> 00:17:14,610
!بعد كلّ المساعدة التي قدّمتُها له! يا له من ضعيف

234
00:17:14,780 --> 00:17:17,530
...سأضطرّ للتملّق لميستوفارن

235
00:17:20,910 --> 00:17:22,700
!مولايّ هادلَر؟

236
00:17:22,870 --> 00:17:26,620
!زابويرا، لن أدعك تخونني

237
00:17:26,790 --> 00:17:30,210
!أنت وأنا في نفس المركب الآن

238
00:17:30,380 --> 00:17:35,550
!إذا حاولتَ العمل لحسابِ شخص آخر، سأقتلك

239
00:17:36,050 --> 00:17:42,970
!أعلم بشأنِ بحثك السرّي حول الشّياطين الخارقة

240
00:17:43,140 --> 00:17:46,730
!ماذا؟ -
!حان الوقت لاستخدام ذلك البحث لصالحي -

241
00:17:46,890 --> 00:17:47,600
!لماذا؟

242
00:17:47,770 --> 00:17:52,020
!يتطوّر تلاميذ أفان بسرعة فائقة! فائقة جدّاً

243
00:17:52,730 --> 00:17:57,200
هذا الجسد الذي منحَني إيّاه الملِك فارن
!لا يكفي لمجاراتهم

244
00:17:57,860 --> 00:18:00,490
!أحتاج قوّة أعظم

245
00:18:00,660 --> 00:18:04,410
!قوّة كقوّة التنّين الشّيطان باران

246
00:18:04,580 --> 00:18:12,000
أحتاج أعظم قوّة ولا نظير لها في العالم

247
00:18:13,090 --> 00:18:17,510
فهمت. هذا يُفسّر وجود الشّارة في يدك

248
00:18:17,680 --> 00:18:19,260
إنّها قوّة هائلة

249
00:18:19,680 --> 00:18:21,970
أنا حيٌّ بفضلِك

250
00:18:22,560 --> 00:18:27,180
نحن آسفون. وقعنا في فخّ زابويرا دوناً عن غيره

251
00:18:27,350 --> 00:18:29,230
لا تلُم نفسك

252
00:18:29,400 --> 00:18:34,280
فهناك شخص قد سيطرَتْ عليه مشاعره
وغلبته العواطف

253
00:18:36,650 --> 00:18:41,280
لا أصدّق أنّ هادلَر شاركَ في مكيدة زابويرا

254
00:18:41,450 --> 00:18:43,660
لطالما كان يُفضِّل القوّة الصّرفة

255
00:18:43,830 --> 00:18:46,370
لعلّه أدرك أنّ القوّة الصّرفة لن تفلح

256
00:18:46,540 --> 00:18:51,960
بما أنّه تبيّن أنَّ البطل هو ابن فارس التنّين الأسطوري

257
00:18:52,290 --> 00:18:54,550
لا بدّ وأنّه كان مُستميتاً جدّاً

258
00:18:54,710 --> 00:18:58,170
أعتقد أنّ أمراً جللاً يحدث داخل جيش الشّياطين

259
00:19:00,090 --> 00:19:04,220
أيُّها المُرشِد، كنتَ تعلم أنَّ داي هو
فارس تنّين، أليس كذلك؟

260
00:19:04,390 --> 00:19:04,890
أجل

261
00:19:05,060 --> 00:19:08,180
!كان ينبغي أن تخبرنا مُسبقاً

262
00:19:08,350 --> 00:19:11,810
بالإضافة إلى أنَّه كان بمقدورِك المجيء
!في وقتٍ أسبق، أليس كذلك؟

263
00:19:13,980 --> 00:19:20,650
ارتأيتُ أنّ قدرَ فارس التنّين سيؤذيكم معنويّاً

264
00:19:20,820 --> 00:19:23,370
لا يسعني فعل شيء حيال ذلك

265
00:19:23,530 --> 00:19:28,540
وجدتُ أنّ شخصاً واحداً فقط بمقدوره
المساعدة، فنقّبتُ عن هذا

266
00:19:28,700 --> 00:19:30,790
!ما هذا الكتاب المليء بالغُبار...؟

267
00:19:31,920 --> 00:19:34,210
!هذه العلامة... هل هي...؟

268
00:19:34,380 --> 00:19:35,590
!علامة المُعلّم أفان

269
00:19:35,750 --> 00:19:38,920
هذا صحيح. هذا هو كتاب أفان الشّهير

270
00:19:39,090 --> 00:19:40,130
!كتاب أفان؟

271
00:19:40,590 --> 00:19:42,720
،أفان، البطل الذي أنقذ العالم

272
00:19:42,890 --> 00:19:47,680
دوّنَ مهاراته وتعويذاته وأفكاره لأجيال المُستقبل

273
00:19:47,850 --> 00:19:50,770
إنّه الكتاب الوحيد المُدوّن بخطِّ يده

274
00:19:50,940 --> 00:19:54,150
لم أكن أعلم بوجود مثل هذا الكتاب

275
00:19:54,310 --> 00:19:57,780
كان محفوظاً في مكتبةِ كارل، موطنه الأصليّ

276
00:19:57,940 --> 00:20:00,490
ارتأيتُ أنّكم ستكونون بحاجته أكثر منّي

277
00:20:01,400 --> 00:20:04,320
،تفقّدوا جزء الهواء، الصّفحة 192

278
00:20:05,950 --> 00:20:11,160
وجزء الأرض يحكي عن مهارات القتال. بينما
يغطّي جزء البحر تعويذات ومهارات الهالة

279
00:20:11,330 --> 00:20:14,500
ويحكي كتاب الهواء عن الرّوح

280
00:20:15,040 --> 00:20:16,250
...المعذرة

281
00:20:16,540 --> 00:20:18,840
"...إلى... و"

282
00:20:21,010 --> 00:20:24,300
ليونا، هل يمكنكِ قراءته؟ هناك كثير
من الكلمات لا أستطيع قراءتها

283
00:20:26,100 --> 00:20:28,680
إلى الجرحى والتّائهين"

284
00:20:29,180 --> 00:20:32,940
الهزيمة ليست السّقوط بسبب الجروح

285
00:20:33,100 --> 00:20:37,610
الهزيمة هي عندما تخسر نفسك بعد السّقوط

286
00:20:38,360 --> 00:20:40,360
كُن قويّ القلب

287
00:20:40,820 --> 00:20:47,200
فكّر بهدوء بأهدافك وقدراتك

288
00:20:48,120 --> 00:20:51,160
جميعنا مُقيّدون بحدود قدراتنا

289
00:20:51,330 --> 00:20:55,040
،عندما يفعل كلّ واحد منّا ما يستطيع فعله

290
00:20:55,210 --> 00:21:01,590
،حتّى عندما نكون على حافّة اليأس
"سيُضاء الطريق نحو النّصر

291
00:21:02,470 --> 00:21:06,470
وكأنّ المُعلّم حاضر بيننا يُطمئننا

292
00:21:07,090 --> 00:21:10,060
كانت هذه الكلمات كلّ ما نحتاج سماعه

293
00:21:11,140 --> 00:21:12,480
...أفان

294
00:21:12,640 --> 00:21:17,690
إنّه الكتاب المناسب لمبتدئين أغرار صغار أمثالكم

295
00:21:17,860 --> 00:21:19,360
احتفظوا به جيّداً

296
00:21:19,520 --> 00:21:21,480
شكراً لك يا ماتوريف

297
00:21:22,400 --> 00:21:25,280
"...أهدافك وقدراتك"

298
00:21:26,950 --> 00:21:28,490
لنعد إلى بابنيكا

299
00:21:29,450 --> 00:21:33,290
أريد أن أبذل قصارى جهدي

300
00:21:33,450 --> 00:21:37,750
أن أفعل شيئاً لأجل العالم عوضاً
عن مجرّد القتال معكم

301
00:21:38,460 --> 00:21:40,880
!شيء لا يستطيع سوايّ فعله

302
00:21:52,770 --> 00:21:55,890
!داي! سنذهب

303
00:21:56,440 --> 00:21:57,560
!حسناً

304
00:22:04,360 --> 00:22:07,320
حتّى لو واجهت الشّيطان والمنطق في صفّك

305
00:22:07,490 --> 00:22:11,280
قد يكون مجرّد تبرير

306
00:22:11,450 --> 00:22:15,370
حتّى الآن، حتّى الآن ما زلتُ أتردّد

307
00:22:15,540 --> 00:22:19,420
إلى أي مدى سنصل؟

308
00:22:19,580 --> 00:22:22,710
سمعتُ صوتاً أشبه بهمسِ ملاك

309
00:22:22,880 --> 00:22:26,630
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

310
00:22:26,800 --> 00:22:30,340
مُعرّض للحبِّ والحزن

311
00:22:30,510 --> 00:22:34,640
على الدّربِ المُغطّى بالاعتزاز

312
00:22:36,350 --> 00:22:38,690
لحظات عابِرة من الجُبن

313
00:22:40,230 --> 00:22:42,480
نداء الاستغاثة الذي تحفّظتُ عليه

314
00:22:44,070 --> 00:22:48,070
قبضتُ يدي المُرتعدة

315
00:22:48,650 --> 00:22:53,660
ذلك الوعد البسيط

316
00:22:53,830 --> 00:22:57,450
تلك الذّكريات التّافهة الصّغيرة

317
00:22:57,620 --> 00:22:59,750
ما زالت تسكن قلبي

318
00:22:59,920 --> 00:23:03,920
كجمرٍ يُبقيني مُشتعلاً

319
00:23:04,090 --> 00:23:08,420
شُعاع شفّاف من النُّور

320
00:23:08,590 --> 00:23:11,590
يُنير الدّرب أمامي

321
00:23:11,760 --> 00:23:16,270
قلّما أستطيع فعله

322
00:23:16,430 --> 00:23:22,480
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

323
00:23:33,740 --> 00:23:37,830
بعد العودة إلى بابنيكا، يستعدّ داي
وأصدقاؤه لمعركتهم التّالية

324
00:23:38,000 --> 00:23:41,540
،يسمعون ببطولة فنون قتاليّة تُقام في روموس

325
00:23:41,710 --> 00:23:46,380
،بعد أن علما أنّ الفائز يربح أداة أسطوريّة
يتوجّه داي وبوب إلى روموس

326
00:23:46,920 --> 00:23:50,090
،بينما يقف مُنافس في المُدرّج ويتلقّى التشجيع

327
00:23:50,510 --> 00:23:53,550
داي وبوب يحدّقان باندهاش

328
00:23:54,010 --> 00:23:56,180
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

329
00:23:58,430 --> 00:24:00,600
!وتستمرّ المغامرة