1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:56,610 --> 00:02:00,070
إذا قاتلتُ هيم، حتّى أنا قد أخسر

20
00:02:00,240 --> 00:02:02,530
كفاك تواضُعاً يا لارهارت

21
00:02:02,700 --> 00:02:06,290
في معركة فرديّة، قد تربح

22
00:02:06,460 --> 00:02:11,540
لكن في المعركة، هناك توافقيّة
ونقاط قوّة وضعف

23
00:02:11,710 --> 00:02:12,670
لارهارت

24
00:02:12,840 --> 00:02:19,630
تستخدم سرعتك الفائقة ومهاراتك لهزيمة
الأعداء بالطلقات المُدمّرة والصّدمات

25
00:02:19,800 --> 00:02:22,640
أنت لا تقاتل بمهارات هالة

26
00:02:22,800 --> 00:02:24,180
هكذا إذاً

27
00:02:24,350 --> 00:02:30,560
،لا يزال هيم عديم الخبرة في المهارات
لكن يمتلك تلك الهالة الضخمة

28
00:02:30,730 --> 00:02:36,070
وهي هالة النّور، أكثر شيء يؤذي ميستوفارن

29
00:02:36,780 --> 00:02:39,150
أي عدوّ لدود جوهريّاً

30
00:02:39,320 --> 00:02:40,990
...ميستوفارن

31
00:02:41,570 --> 00:02:45,660
أشعر بالاستياء قليلاً بهزيمتك هكذا

32
00:02:45,830 --> 00:02:49,370
كان جيش الشّياطين مليئاً بالشخصيّات المزعجة

33
00:02:49,540 --> 00:02:53,920
لكن كنتَ الوحيد الّذي بدا أنّه
يحترم فخامته هادلَر

34
00:02:54,090 --> 00:02:55,250
هادلَر؟

35
00:02:56,590 --> 00:02:58,340
!هذا مستحيل

36
00:02:58,720 --> 00:03:03,680
هل تقول لي بأنّ هالتك وحياتك
!هما هديّة منه قبل موته؟

37
00:03:03,850 --> 00:03:05,600
!هكذا هو الأمر

38
00:03:05,760 --> 00:03:09,390
مع أنّني لا أمتلك شرحاً أكثر منطقيّة

39
00:03:10,230 --> 00:03:11,940
أريد الأمر أن يكون كذلك فحسب

40
00:03:12,100 --> 00:03:16,320
هل يعني أنّ إرادة هادلَر وهبت هيم الحياة؟

41
00:03:16,480 --> 00:03:18,030
...كيف ذلك

42
00:03:22,570 --> 00:03:24,910
!هذا ما أظنّه أيضاً يا هيم الصّغير

43
00:03:25,870 --> 00:03:27,700
!المُعجزات ليست للشرّ

44
00:03:27,870 --> 00:03:31,540
أنت العضو رقم 12 في مغاوير
!ملك الوحوش البرّية الصّالح

45
00:03:32,710 --> 00:03:34,380
!هذا كلّ ما في الأمر

46
00:03:51,640 --> 00:03:54,100
شكراً جزيلاً يا قائد

47
00:03:54,270 --> 00:03:56,020
!لا تُثيروني على الضّحك

48
00:03:56,190 --> 00:04:00,320
!مجرّد دُمية يدّعي بأنّه هادلَر المولود من جديد؟

49
00:04:00,490 --> 00:04:02,820
!نسيتَ مكانتك أيّها التّافه

50
00:04:03,280 --> 00:04:08,160
أنا، ميستوفارن، سأستخدم كلّ قوّتي
!لتحطيمك وجعلك أشلاء

51
00:04:09,040 --> 00:04:11,830
!آسف، لكن هذا غير ممكن

52
00:04:12,330 --> 00:04:15,330
...أن تحطّم جسدي المصنوع من أوريكالكوم هو شيء

53
00:04:16,290 --> 00:04:18,800
!شخص وحيد في العالم يستطيع فعله

54
00:04:19,670 --> 00:04:21,470
ماذا؟ أنا؟

55
00:04:34,190 --> 00:04:35,560
!مؤلم

56
00:04:41,990 --> 00:04:43,530
مذهل

57
00:04:45,030 --> 00:04:46,820
!أحسنت صنعاً يا هيم الصّغير

58
00:04:47,620 --> 00:04:52,580
لا! على هذا المنوال...! هذا
!البيدق أقوى ممّا توقّعت

59
00:04:52,750 --> 00:04:57,080
!مع الأسف، لا أملك خياراً
!يجب أن أستخدم تلك القوّة

60
00:04:57,670 --> 00:05:00,500
!الملك فارن

61
00:05:01,210 --> 00:05:05,130
!الملك فارن! ألا تسمعني؟

62
00:05:05,510 --> 00:05:06,970
!لا

63
00:05:07,140 --> 00:05:09,350
،لعلّه يقاتل داي

64
00:05:09,510 --> 00:05:15,440
لكن لا أعتقد بأنّ الملك فارن سيكون
مُركِّزاً جدّاً لدرجة عدم سماعي

65
00:05:15,600 --> 00:05:20,650
لحظة! هل يُعقَل بأنّ داي يضغط
!على الملك فارن إلى ذلك الحدّ؟

66
00:05:39,330 --> 00:05:40,960
ما الخطب يا داي؟

67
00:05:41,420 --> 00:05:43,300
لماذا تتردّد؟

68
00:05:43,460 --> 00:05:47,760
هل هو... هل فارن، ملك الشّياطين
بهذا الضّعف فعلاً؟

69
00:05:48,430 --> 00:05:51,390
أم أنّ تعويذة بريق تؤثّر به؟

70
00:05:51,560 --> 00:05:55,350
لا. بالكاد مسّت هادلَر

71
00:05:55,520 --> 00:05:58,600
لا يمكن أن تؤثّر بفارن إلى هذه الدّرجة

72
00:05:59,400 --> 00:06:03,650
إذاً... أصبحتُ أقوى بكثير عن السّابق؟

73
00:06:04,230 --> 00:06:06,240
كيف هو شعورك؟

74
00:06:06,400 --> 00:06:10,200
أن تهزم عدوّاً سبقَ وهزمك

75
00:06:10,370 --> 00:06:13,660
أسألك كيف هو شعورك

76
00:06:14,200 --> 00:06:21,210
تشكّك فيما إذا كان هذا أنا حقّاً
أم أنّك لا تستوعب تطوّرك

77
00:06:21,840 --> 00:06:23,380
...لكن قريباً جدّاً

78
00:06:23,550 --> 00:06:26,340
قريباً جدّاً ستشعر بالبهجة الشّديدة

79
00:06:26,800 --> 00:06:28,220
أشعر... بالبهجة الشّديدة؟

80
00:06:28,380 --> 00:06:30,720
أن تغرق في قوّتك

81
00:06:30,890 --> 00:06:36,100
إنّه شعور أفضل من شرب أيّ خمر أخّاذ

82
00:06:37,680 --> 00:06:41,940
مع أنّ الأطفال لن يفهموا بهجة الخمر

83
00:06:51,240 --> 00:06:52,740
!ينتقل ميستوفارن للوضع الهجومي

84
00:06:54,280 --> 00:07:00,540
دون إذن باستخدام تلك القوّة، يجب
!أن أستخدم ما أمتلك من قوّة

85
00:07:00,920 --> 00:07:04,210
!سأكرّس كلّ هالتي الشيطانيّة في هذه اليد

86
00:07:04,380 --> 00:07:05,800
!ها أنا ذا

87
00:07:05,960 --> 00:07:08,210
!كفّ هالة الشيطان المطلق

88
00:07:11,380 --> 00:07:18,180
يا للهول! ورقته الرّابحة الأخيرة هي
!تركيز كلّ هالته الشيطانيّة في يده

89
00:07:19,310 --> 00:07:23,560
!هيم. لا تدع هذا يمسّك! يجب أن تتفاداه

90
00:07:23,730 --> 00:07:27,900
!لا يمكنك تفادي هذا! سوف أسحقك

91
00:07:29,650 --> 00:07:31,320
!هذا الغبيّ! إنّه لا يتفادى

92
00:07:31,490 --> 00:07:33,280
!هذا طيش يا هيم الصّغير

93
00:07:34,410 --> 00:07:35,330
!لحظة

94
00:07:35,490 --> 00:07:37,120
!هذه الوضعيّة

95
00:07:56,680 --> 00:07:57,510
!رأيت؟

96
00:07:57,680 --> 00:08:01,940
!حتّى الأوريكالكوم لا يستطيع تحمّل قوّة كفّي

97
00:08:02,100 --> 00:08:03,270
!يا للهول

98
00:08:03,440 --> 00:08:05,610
!فلتتحطّم إلى أشلاء الآن

99
00:08:05,770 --> 00:08:07,020
!لا داعي

100
00:08:07,190 --> 00:08:12,700
أخبرتُك بأنّ شخصاً وحيداً فقط
!يستطيع تحطيم هذا الجسد

101
00:08:13,240 --> 00:08:16,950
!أفضل ما يمكنك فعله هو تحطيم ذراع واحدة

102
00:08:17,120 --> 00:08:20,040
!ما يجعلني أقترب منك أكثر

103
00:08:21,410 --> 00:08:24,920
!ورقتي الرّابحة هي هجومي بيُسرايّ

104
00:08:25,080 --> 00:08:27,460
!بُرجُمة الهالة

105
00:08:27,630 --> 00:08:32,840
!مـ-مستحيل! مجرّد بيدق يهزمني؟

106
00:08:33,300 --> 00:08:35,260
!هذا مستحيل

107
00:08:37,600 --> 00:08:40,220
!ممتاز -
!أحسنت صنعاً يا هيم الصّغير -

108
00:08:46,440 --> 00:08:49,730
إنّه تلقّي الضّرر لإلحاق ضرر أكبر

109
00:08:49,900 --> 00:08:53,780
فضلاً عن ذلك، يمكن لذراعي أن
تُشفَى بتعويذة شفاء

110
00:08:54,110 --> 00:08:55,740
حان وقت الإجهاز عليه

111
00:08:55,910 --> 00:08:59,740
لا ضرورة لذلك. إنّه عاجز عن القتال بالفعل

112
00:08:59,910 --> 00:09:02,410
الأهمّ، اخلع قناعه

113
00:09:02,700 --> 00:09:04,000
قناعه؟

114
00:09:04,460 --> 00:09:07,710
...ا-الملك فارن

115
00:09:14,300 --> 00:09:18,180
لا. يفقد داي المُبادرة

116
00:09:18,760 --> 00:09:21,390
إنّها ثقة فارن الغريبة

117
00:09:22,100 --> 00:09:27,060
أنا على يقين بأنّه يقاتل بكامل قوّته

118
00:09:28,480 --> 00:09:31,520
لا يمكنه أن يتحفّظ إطلاقاً

119
00:09:32,480 --> 00:09:36,030
!فلماذا هو واثق جدّاً؟

120
00:09:36,200 --> 00:09:38,740
!داي! كُن قويّاً

121
00:09:38,910 --> 00:09:43,790
!يمكن الفوز ببساطة من خلال الهدوء
!ابقَ عدوانيّاً

122
00:09:47,250 --> 00:09:49,380
!ليونا، لا تكشفي عن نفسكِ

123
00:09:49,540 --> 00:09:50,290
!ماذا؟

124
00:09:52,050 --> 00:09:55,010
!سوف أكشف عنه الآن

125
00:09:55,170 --> 00:09:59,970
...السّتار الغامض الّذي يُخفي قوّتك
!ما دامت الفرصة سانحة

126
00:10:02,430 --> 00:10:03,970
!هذا الطّائر المُلتهب

127
00:10:04,140 --> 00:10:06,060
!عنقاء القيصر

128
00:10:06,600 --> 00:10:10,270
!رأيتُ هذا قبلاً! يمكنني تبديده بأفان ستراش

129
00:10:12,980 --> 00:10:14,110
!هجمة مُتزامِنة

130
00:10:29,330 --> 00:10:31,380
ما-ماذا حدث؟

131
00:10:31,920 --> 00:10:35,800
بدا وكأنّهما اصطدما ببعضهما

132
00:10:38,340 --> 00:10:39,260
!أين داي؟

133
00:10:39,760 --> 00:10:40,890
...داي

134
00:10:45,390 --> 00:10:48,180
فارس التنّين العظيم

135
00:10:48,350 --> 00:10:53,060
حتّى بهجمتي العُظمى، لم أستطع هزيمته

136
00:11:01,450 --> 00:11:02,570
!داي

137
00:11:22,800 --> 00:11:24,300
...الملك فارن

138
00:11:24,850 --> 00:11:27,640
أتقول أن أخلع قناعه؟

139
00:11:27,810 --> 00:11:29,100
...ميستوفارن

140
00:11:29,270 --> 00:11:32,850
لطالما كانت هويّته يحيطها الغموض

141
00:11:33,350 --> 00:11:35,820
أعتقد بأنّ هويّته

142
00:11:35,980 --> 00:11:40,820
مرتبِطة بشكل مُباشر بسرّ ملك الشّياطين فارن

143
00:11:40,990 --> 00:11:42,530
سرّ ملك الشّياطين؟

144
00:11:42,700 --> 00:11:46,240
كان لا يتكلّم إطلاقاً

145
00:11:46,530 --> 00:11:49,450
،بعبارة أخرى، الوجه الّذي يخفيه

146
00:11:49,620 --> 00:11:52,210
،أو صوته، بحسب من يسمعه

147
00:11:52,370 --> 00:11:57,340
هو سرّ عظيم لا يريد فارن كشفه لأحد

148
00:11:57,920 --> 00:11:58,960
هل أنت جادّ؟

149
00:11:59,380 --> 00:12:03,930
،عندما كنتُ في جيش الشّياطين
كان فارن يفضّلني

150
00:12:04,090 --> 00:12:11,060
من بين قادة الفيالق الستّة، كنتُ
أكثر من يتفاعل مع فارن غالباً

151
00:12:11,230 --> 00:12:15,770
وكان ميستوفارن مُعلّمي بخصوص الهالة الشّيطانيّة

152
00:12:15,940 --> 00:12:18,110
،إذا استطعتُ رؤية وجهه الحقيقيّ

153
00:12:18,270 --> 00:12:23,780
قد أتمكّن من الحصول على لمحة عن السرّ
الّذي كان يخفيه ميستوفارن لزمن طويل

154
00:12:23,950 --> 00:12:27,620
...إذا استطعنا نقل ذلك إلى داي بينما يقاتل فارن

155
00:12:27,780 --> 00:12:32,120
!فهمت! قد يمنحه ذلك أفضليّة في معركتهما الأخيرة

156
00:12:32,500 --> 00:12:34,040
أنا موافق على ذلك

157
00:12:34,210 --> 00:12:37,000
في كلّ الأحوال، لن يتمكّن هذا الشّخص من المُقاومة

158
00:12:37,170 --> 00:12:39,590
يمكننا القضاء عليه متى أردنا

159
00:12:39,750 --> 00:12:43,420
إنَّ خلع هذا الثّوب لن يكون بالأمر الجلل

160
00:12:44,010 --> 00:12:45,300
..."ثوب"

161
00:12:45,680 --> 00:12:46,720
ها أنا ذا

162
00:12:49,930 --> 00:12:51,100
!ا-انتظر

163
00:12:52,230 --> 00:12:53,390
!انتظر لحظة

164
00:12:53,560 --> 00:12:57,150
ما الأمر أيّها الضخم؟ لماذا تصرخ؟

165
00:12:57,310 --> 00:13:02,360
أعتقد بأنّ الكشف عن قناع ميستوفارن
!قد يكون غاية في الخطورة

166
00:13:02,530 --> 00:13:04,320
خطورة؟ ماذا تقصد؟

167
00:13:04,490 --> 00:13:07,530
"لا تخلعوا ثوب ظلّ ميستوفارن"

168
00:13:08,990 --> 00:13:12,830
،قُبيل أن نأتي إلى هنا من السّطح

169
00:13:13,000 --> 00:13:17,710
أرادني لون بيروك أن أوصل لكم هذه الرّسالة

170
00:13:18,250 --> 00:13:20,000
ثوب الظلّ؟

171
00:13:20,170 --> 00:13:21,130
هذا صحيح

172
00:13:21,300 --> 00:13:22,760
ما هو هذا؟

173
00:13:23,460 --> 00:13:26,930
تقصد الملابس التي يرتديها ميستوفارن؟

174
00:13:27,090 --> 00:13:29,430
لستُ متأكّداً من ذلك بحدّ ذاتي

175
00:13:29,600 --> 00:13:33,350
...يمكنني التّعبير عن الأمر بعبارات مُبهمة فقط

176
00:13:33,520 --> 00:13:38,810
لكن لا شكّ في أنّ هناك شيئاً قاهراً في قوّته

177
00:13:38,980 --> 00:13:45,530
هناك سبب واحد فقط وراء تكافؤ
القتال بيني وبينه لتلك المدّة الطويلة

178
00:13:45,700 --> 00:13:49,240
مثلما كنتُ أنا، كذلك هو لم يكن بكامل قوّته

179
00:13:49,820 --> 00:13:53,200
كانت معركة بين شخصين مُتحفّظين

180
00:13:53,370 --> 00:13:55,080
حتّى في تلك المعركة العنيفة؟

181
00:13:55,960 --> 00:13:58,290
أثناء معركتنا أدركت

182
00:13:58,460 --> 00:14:02,000
حتّى لو أراد أن يقاتل بكامل قوّته، لا يستطيع

183
00:14:02,170 --> 00:14:04,550
ربّما لسبب مختلف عن سببي

184
00:14:04,920 --> 00:14:08,380
ما قاله عندما غادرَ كان دليلاً

185
00:14:08,930 --> 00:14:13,140
ربّما لو قاتلتَ بكامل قوّتك"

186
00:14:13,310 --> 00:14:16,180
"لما استغرقت معركتنا هذه المدّة الطويلة

187
00:14:16,350 --> 00:14:20,230
"بالطبع، نفس الكلام ينطبق عليّ"

188
00:14:20,400 --> 00:14:25,940
إذاً يا لون بيروك، أتقصد بأنّ ميستوفارن
ما زال يخفي قوّته الحقيقيّة؟

189
00:14:26,110 --> 00:14:27,990
أجل. ثمّة شيء هناك

190
00:14:28,150 --> 00:14:31,410
لا تفعلوا شيئاً قد يجبره على
القتال بكامل قوّته

191
00:14:31,570 --> 00:14:35,200
لا تخلعوا ثوب الظلّ الخاص به

192
00:14:35,660 --> 00:14:37,960
بعبارة أخرى، وصفَ لون بيروك

193
00:14:38,120 --> 00:14:42,460
أيّاً كان ما يحتوي قوّة ميستوفارن الخارقة

194
00:14:42,630 --> 00:14:45,090
"على أنّه "ثوب الظلّ

195
00:14:45,250 --> 00:14:47,510
والمقصود به قناعه؟

196
00:14:47,670 --> 00:14:48,880
لستُ متأكّداً

197
00:14:49,050 --> 00:14:53,350
لكن استعمال هيم لكلمة ثوب ذكّرَتْني

198
00:14:57,350 --> 00:15:01,980
إذاً قصدَ لون بيروك أنّه إذا
،كانت هناك فُرصة لهزيمته

199
00:15:02,150 --> 00:15:05,860
فافعلوها قبل أن يكشف عن قوّته الحقيقيّة

200
00:15:06,030 --> 00:15:06,780
أجل

201
00:15:06,940 --> 00:15:09,570
لديهم وجهة نظر سديدة يا هيونكل

202
00:15:09,740 --> 00:15:13,240
من المؤكّد أنّ ميستوفارن شخص لا يُقهَر

203
00:15:13,410 --> 00:15:18,160
ولون بيروك هو حِرفيّ العالم السّفلي الأسطوري

204
00:15:18,330 --> 00:15:23,710
أليس من الممكن أن يكون أقرب إلى
سرّ ملك الشّياطين وميستوفارن منك؟

205
00:15:23,880 --> 00:15:25,960
هذا ممكن

206
00:15:26,130 --> 00:15:29,420
لا يمكننا تجاهل تحذير من لون بيروك

207
00:15:29,590 --> 00:15:31,930
!أنتم! ماذا أفعل؟

208
00:15:32,090 --> 00:15:35,720
!لا أمانع الإجهاز عليه أو الكشف عن وجهه

209
00:15:38,100 --> 00:15:39,430
هيونكل

210
00:15:40,690 --> 00:15:42,190
!لا بدّ وأنّ ذلك داي

211
00:15:42,350 --> 00:15:45,900
!المعركة الأخيرة مع فارن قد بدأت بالفعل

212
00:15:52,360 --> 00:15:55,620
!هيم، من الأفضل أن نقضي عليه هنا

213
00:15:56,120 --> 00:15:57,990
ماذا عن هويّته الحقيقيّة؟

214
00:15:58,160 --> 00:16:01,910
ينبغي أن نصغي لأيّ تحذير من لون بيروك

215
00:16:02,080 --> 00:16:04,880
بالإضافة إلى أنّنا علينا أن نسرع

216
00:16:05,040 --> 00:16:09,460
حاليّاً، ينبغي أن نقضي على قوّات
جيش الشّياطين قدر الإمكان

217
00:16:09,630 --> 00:16:11,220
بالتأكيد

218
00:16:14,470 --> 00:16:17,260
أجل، هذا هو الخيار الصّائب

219
00:16:17,430 --> 00:16:23,020
حتّى لو أبادت هذه الضربة المُقبلة
ميستوفارن مع سرّه

220
00:16:23,190 --> 00:16:27,480
لعلّ الرّغبة في معرفتها نابعة
من مشاعري الشخصيّة

221
00:16:27,650 --> 00:16:31,650
لأنّه كان مُعلّمي، بالرّغم من أنّ
ذلك كان لأهداف الشرّ

222
00:16:31,820 --> 00:16:34,110
الآن، الأولويّة للنصر

223
00:16:34,280 --> 00:16:37,620
!وداعاً يا ميستوفارن! آمل أن ترقد بسلام

224
00:16:40,160 --> 00:16:42,660
!الملك فارن! الملك فارن

225
00:16:43,080 --> 00:16:44,370
!سامحني

226
00:16:47,340 --> 00:16:51,670
!من المؤكّد أنّ تلك كانت هجمة فارن الحاسِمة

227
00:16:51,960 --> 00:16:55,180
!وتمكّن داي من النّجاة منها

228
00:16:55,340 --> 00:16:56,390
!لكن كيف؟

229
00:16:57,140 --> 00:17:00,850
كلّ ما استطعتُ رؤيته كان اللّحظة
الّتي اشتبكا فيها معاً

230
00:17:01,020 --> 00:17:02,640
هذا لا يُصدَّق

231
00:17:02,810 --> 00:17:06,060
أن تغوص في عنقاء القيصر الخاص بي

232
00:17:06,230 --> 00:17:07,150
!ماذا؟

233
00:17:07,310 --> 00:17:10,150
...في تلك اللّحظة أنت

234
00:17:10,320 --> 00:17:12,570
!عنقاء القيصر

235
00:17:16,280 --> 00:17:21,330
تصدّيت لضربتَي عنقاء القيصر وعصا النّهم

236
00:17:21,910 --> 00:17:25,540
تصدّيت لعصاي والتهمتك النّيران

237
00:17:25,710 --> 00:17:32,380
مع درايتك بأنّ كلا الطريقتين تؤدّيان
إلى ضرر، اخترتَ الغوص في اللّهب

238
00:17:33,170 --> 00:17:34,880
تصرّف متهوّر حسبما بدا

239
00:17:35,050 --> 00:17:40,180
لكن داخل العنقاء يوجد المكان الوحيد
الّذي يمكنك ضربي بنجاح من خلاله

240
00:17:42,060 --> 00:17:48,400
،عرفتُ بأنّني سأتأذّى في كلتا الحالتين
لذا اخترتُ الطريقة التي يمكنني الردّ بها

241
00:17:50,150 --> 00:17:51,650
!داي، هل أنت بخير؟

242
00:17:54,780 --> 00:17:56,400
إنّه ليس كذلك بالطبع

243
00:17:56,570 --> 00:17:58,950
فتعويذة ملك الشّياطين الأقوى أصابته

244
00:17:59,120 --> 00:18:00,370
نتيجة طبيعيّة

245
00:18:00,530 --> 00:18:06,830
لعلّك تمكّنت من إصابتي، لكن
عنقاء القيصر أصابتك مباشرة

246
00:18:07,000 --> 00:18:09,880
فلو لم تتأذّ لخدشَ ذلك كبريائي

247
00:18:10,040 --> 00:18:11,750
!والآن حان وقت هجمة أخرى

248
00:18:12,420 --> 00:18:14,960
!لن تحظى بالفرصة

249
00:18:16,090 --> 00:18:18,130
!حان دوري الآن

250
00:18:18,300 --> 00:18:22,390
...قبل أن يتجدّد ذلك الجرح في كتفك

251
00:18:22,560 --> 00:18:24,970
!سأستخدم هجمتي الحاسمة

252
00:18:25,680 --> 00:18:29,400
!هذه المرّة يا فارن، دورك لتدافع عن نفسك

253
00:18:29,560 --> 00:18:36,940
،وإذا كنتُ قد خطّطتُ لهذا بشكل صائب
!أنا متأكّد بأنّني أستطيع هزيمتك بهذه

254
00:18:44,540 --> 00:18:47,960
!هذا مُثير! دعني أرى هجمتك هذه إذاً

255
00:18:53,040 --> 00:18:54,340
!دورورا؟

256
00:18:58,550 --> 00:19:03,220
أحمق. هل نسيت بأنّ دورورا لم تؤثّر بي؟

257
00:19:03,390 --> 00:19:05,930
!لا! دورورا ستفلح

258
00:19:07,640 --> 00:19:11,650
!قاتلتُ أبي في السّابق، لذا أعرف ذلك جيّداً

259
00:19:11,810 --> 00:19:15,070
!دورورا هي تعويذة لا يستطيع إيقافها أيّ دفاع

260
00:19:15,650 --> 00:19:19,110
!حالما تُطلَق، هناك طريقتان فقط للنجاة منها

261
00:19:19,400 --> 00:19:21,950
!تحمّلها أو تجنّبها

262
00:19:22,620 --> 00:19:28,790
لكن عندما أتيتَ أوّل مرّة، حتّى
ملابسك لم تتضرّر

263
00:19:29,620 --> 00:19:34,540
،سواء كنت ملك شيطان أم لا، إذا تحمّلتَها
لن تخرج منها سليماً تماماً

264
00:19:35,210 --> 00:19:40,260
لكن إذا تجنّبتها بتعويذة عودة، فلن
!تخرج من تحت الأنقاض

265
00:19:41,010 --> 00:19:46,100
السرّ في كيفيّة نجاتك من دورورا
...خاصّتي لا بدّ وأنّه يكمن

266
00:19:46,260 --> 00:19:47,930
!في عصا النّهم

267
00:19:49,680 --> 00:19:53,520
ليست نظريّة سيّئة. لكن ماذا لو كنتَ مخطئاً؟

268
00:19:53,690 --> 00:19:58,110
دورورا هي تعويذة تستهلك كمّيات
هائلة من قوّة السّحر

269
00:19:58,280 --> 00:20:00,570
أشكّ في قدرتك على استخدامها أكثر من مرّتين

270
00:20:00,740 --> 00:20:06,950
استخدمتَها مرّة، لذا ماذا لو رددتُ بالهجوم
بعد أن تستهلك كلّ قوّتك السحريّة؟

271
00:20:07,120 --> 00:20:09,040
أعرف ذلك سلفاً

272
00:20:09,200 --> 00:20:13,420
حالما أستخدم هذه، ستُستهلَك كامل قوّتي السحريّة

273
00:20:15,710 --> 00:20:18,460
!لكن أعلم بأنّك لن تردّ

274
00:20:22,340 --> 00:20:24,930
!خذ هذه! دورورا

275
00:20:35,520 --> 00:20:37,400
!أوقفَ دورورا بعصاه

276
00:20:37,570 --> 00:20:38,860
!توقّعت

277
00:20:39,020 --> 00:20:41,570
،نصل عصا النّهم خاصّتي

278
00:20:41,740 --> 00:20:47,530
يمكن أن تنفجر لتصبح جدار طاقة
يستطيع صدّ أيّ تعويذة

279
00:20:47,870 --> 00:20:49,620
،كما افترضتَ تماماً

280
00:20:50,120 --> 00:20:56,540
نجوتُ من دورورا خاصّتك باستخدام
!عصا النّهم للتصدّي لها

281
00:21:03,170 --> 00:21:06,090
!إذا استطعتُ تحمّل هذا، سأربح

282
00:21:09,810 --> 00:21:11,020
!نلتُ منك

283
00:21:11,470 --> 00:21:12,270
!ليونا

284
00:21:14,140 --> 00:21:14,810
!ماذا؟

285
00:21:14,980 --> 00:21:16,520
!الرّيشة الفضّية

286
00:21:18,980 --> 00:21:20,270
!اللّعنة عليك

287
00:21:20,440 --> 00:21:21,610
!وواحدة أخرى

288
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

289
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

290
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

291
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

292
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

293
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

294
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

295
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

296
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

297
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

298
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

299
00:23:34,120 --> 00:23:39,660
يختفي ملك الشّياطين وسط نور
دورورا الثّانية الخاصّة بداي

300
00:23:39,830 --> 00:23:44,790
تصِل الصّدمة إلى الحديقة البيضاء حيث
يأمل الآخرون الاجتماع مع داي ثانية

301
00:23:44,960 --> 00:23:50,170
لكن، رغم أنّ ميستوفارن سقط
أمامهم، ينهض من جديد

302
00:23:50,340 --> 00:23:53,800
ويصل إلى الثّوب الّذي يغطّيه

303
00:23:53,970 --> 00:23:56,310
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

304
00:23:58,180 --> 00:24:00,140
!وتستمرّ المغامرة