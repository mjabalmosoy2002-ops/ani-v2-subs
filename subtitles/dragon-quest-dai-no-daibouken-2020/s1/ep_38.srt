1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أنا أحترق لأنّي أحرقت بالفعل

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:54,280 --> 00:01:59,530
تنوي الأميرة ليونا عقد قمّة عالميّة للتخطيط
للمعركة ضدّ جيش الشّياطين

20
00:01:59,700 --> 00:02:00,740
قمّة عالميّة؟

21
00:02:00,910 --> 00:02:02,160
هذا صحيح

22
00:02:02,330 --> 00:02:08,210
تجمع الملوك والقادة من كلّ أنحاء العالم
في اجتماع عالمي

23
00:02:08,370 --> 00:02:09,710
ليونا تخطّط لذلك؟

24
00:02:11,250 --> 00:02:16,420
حتّى اللّحظة، لم يتعاون القادة معاً، الشيء
الّذي استغلّه جيش الشّياطين

25
00:02:17,550 --> 00:02:23,890
نتيجة ذلك، سقطت أورزام ورينغايا وكارل

26
00:02:24,060 --> 00:02:28,730
،لكن بنداء من القائدة الشابّة، الأميرة ليونا

27
00:02:28,890 --> 00:02:35,980
قرّر القادة الباقون التّعاون والتّخطيط
معاً لمواجهة جيش الشّياطين

28
00:02:36,150 --> 00:02:37,240
!رائع

29
00:02:37,400 --> 00:02:39,030
!هذا أمر غاية في الأهمّية

30
00:02:40,910 --> 00:02:44,370
هذا ما قصدته ليونا بشيء لا يستطيع فعله سواها

31
00:02:44,530 --> 00:02:47,410
متى وأين ستُعقد قمّة العالم؟

32
00:02:51,790 --> 00:02:55,000
...أنوي المغادرة اللّيلة، لكن يا داي

33
00:02:55,170 --> 00:02:57,460
هل تودّ الانضمام لي؟

34
00:02:59,970 --> 00:03:04,180
،اسمع، إذا كان سيحضر أشخاص مهمّون في القمّة

35
00:03:04,350 --> 00:03:07,390
فقد يعرف أحدهم شيئاً عن الأسلحة الأسطوريّة

36
00:03:07,560 --> 00:03:08,430
!هذا صحيح

37
00:03:08,600 --> 00:03:12,810
جلالتك، سنغادر إلى بابنيكا فوراً بتعويذة
!عودة الخاصّة ببوب

38
00:03:12,980 --> 00:03:14,270
عظيم

39
00:03:14,440 --> 00:03:16,110
...في هذه الحالة -
لحظة -

40
00:03:17,940 --> 00:03:23,030
شكراً لك. لولاك، لكنّا في عداد الموتى

41
00:03:25,200 --> 00:03:27,410
أنت بطل حقيقيّ بالفعل

42
00:03:28,160 --> 00:03:30,540
أثبتّم لنا أنّ هناك دوماً شخص أقوى

43
00:03:30,710 --> 00:03:35,000
سنتدرّب تحضيراً للمواجهة المقبلة مع جيش الشّياطين

44
00:03:35,960 --> 00:03:40,170
!لماذا؟! بعد أدائي الرّائع هناك

45
00:03:41,880 --> 00:03:44,850
!جميعكم! ألن تمدحوني؟

46
00:03:45,010 --> 00:03:46,600
!كفّ عن ذلك

47
00:03:46,930 --> 00:03:47,810
!من فعل ذلك؟

48
00:03:47,970 --> 00:03:50,100
يكفي. أنت تصغّر من شأنك

49
00:03:50,270 --> 00:03:52,940
!كيف تجرؤ أيّها الشّبح الوضيع؟

50
00:03:53,440 --> 00:03:56,980
!لا أعتقد أنّه يحقّ لك التكلّم معي باستخفاف هكذا

51
00:03:57,150 --> 00:03:58,780
متأكّد؟

52
00:03:58,940 --> 00:04:00,280
!ماذا؟

53
00:04:01,190 --> 00:04:05,120
أليس هذا واضحاً؟ إنّه كبير المُعلّمين بروكينا

54
00:04:05,280 --> 00:04:06,450
!ماذا؟

55
00:04:12,500 --> 00:04:13,250
!مرحباً

56
00:04:14,620 --> 00:04:15,830
!كبير المُعلّمين

57
00:04:16,000 --> 00:04:18,750
!هذا العجوز هو كبير المُعلّمين؟

58
00:04:19,090 --> 00:04:20,840
!السيّد بروكينا، القبضة المُقدّسة

59
00:04:21,010 --> 00:04:23,510
!كـ-كبير المُعلّمين! لماذا كنت متنكّراً؟

60
00:04:23,680 --> 00:04:27,050
أصابني الفضول لأعرف إلى أي حدّ تطوّرتُما

61
00:04:27,220 --> 00:04:29,970
أنتما حقّاً تلميذا القبضة المُقدّسة بروكينا؟

62
00:04:30,140 --> 00:04:32,560
،لم أتوقّع حدوث كلّ ذلك

63
00:04:32,730 --> 00:04:36,900
لكن في النّهاية، تمكّنتُ من رؤية ثمار تدريب مام

64
00:04:38,770 --> 00:04:40,400
!قُضي عليّ

65
00:04:40,570 --> 00:04:44,110
كانت الخبرة ضروريّة لك، أليس كذلك يا تشيو؟

66
00:04:44,610 --> 00:04:46,780
،لثلاث سنوات منذ تبنّيتُك

67
00:04:46,950 --> 00:04:52,790
كان سبب عدم تحسّنك هو أنّك دائماً ما تتباهى

68
00:04:52,950 --> 00:04:59,460
لكن ذلك الهجوم الذي شننتَه عندما كنتَ
مُستميتاً كان مُذهلاً، أليس كذلك؟

69
00:04:59,630 --> 00:05:01,510
لقد تطوّرت

70
00:05:01,670 --> 00:05:02,670
!كبير المُعلّمين

71
00:05:02,840 --> 00:05:05,550
!أنت بطل حقيقيّ أيضاً

72
00:05:05,720 --> 00:05:08,510
!تتحلّى بأعظم جرأة في روموس

73
00:05:11,350 --> 00:05:12,770
...أنتم

74
00:05:13,480 --> 00:05:17,770
هكذا هو الأمر يا تشيو. دع الشّهرة تسعى لك

75
00:05:17,940 --> 00:05:20,230
لا أن تسعى لها أنت

76
00:05:22,190 --> 00:05:25,280
!كبير المُعلّمين

77
00:05:26,450 --> 00:05:28,110
إنّه مُعلّم بارع حقّاً

78
00:05:28,280 --> 00:05:29,320
أجل

79
00:05:29,490 --> 00:05:30,910
لننطلق

80
00:05:36,080 --> 00:05:40,000
كبير المُعلّمين، أريد السّفر مع الآنسة مام

81
00:05:40,170 --> 00:05:43,380
لا تتردّد إذا أعطوك الإذن

82
00:05:43,550 --> 00:05:45,630
!حسناً، شكراً لك على كلّ شيء

83
00:05:48,090 --> 00:05:49,840
!انتظروا أنتم الثّلاثة

84
00:05:50,010 --> 00:05:50,970
تشيو؟

85
00:05:51,140 --> 00:05:54,680
...إن كنتُم مصرّين، يمكنني تقديم المساعدة

86
00:05:54,850 --> 00:05:55,680
عودة

87
00:05:56,430 --> 00:05:57,940
!مهلاً

88
00:05:58,100 --> 00:06:01,650
!لحظة! انتظروني

89
00:06:02,110 --> 00:06:03,020
...بوب

90
00:06:03,190 --> 00:06:04,820
كان ذلك لئيماً

91
00:06:05,690 --> 00:06:08,740
حسناً، لم يتعلّم درس مُعلّمه

92
00:06:09,320 --> 00:06:12,580
رغم ذلك، إنه شخص مثير للاهتمام

93
00:06:12,740 --> 00:06:14,160
!انتظروا

94
00:06:14,580 --> 00:06:16,250
،إذا نظرتُ إليه

95
00:06:16,410 --> 00:06:22,880
تبدو مخاوفي بشأن كوني بشريّاً من عدمه تافهة

96
00:06:24,250 --> 00:06:27,630
أعتقد بمقدورنا الاستفادة من أمثاله

97
00:06:28,010 --> 00:06:32,260
!انتظروا! دعوني أنضمّ لفريقكم

98
00:06:38,230 --> 00:06:41,400
!ميستوفارن؟! كيف وجدت هذا المكان؟

99
00:06:41,560 --> 00:06:46,440
إذاً كان مخبأك في هذه الجزيرة القريبة
جدّاً من ميدان الموت

100
00:06:47,320 --> 00:06:49,030
أين هدلر؟

101
00:06:49,200 --> 00:06:50,160
...في الواقع

102
00:06:50,530 --> 00:06:51,910
أين هو؟

103
00:06:53,870 --> 00:06:55,910
زابويرا، دعه يدخل

104
00:06:56,450 --> 00:06:58,040
!هدلر-ساما؟

105
00:06:58,200 --> 00:07:01,120
لا يهمّ. أريد أن أتكلّم معه

106
00:07:08,920 --> 00:07:11,430
مُثير للشفقة، أليس كذلك؟

107
00:07:12,220 --> 00:07:18,640
هذا هو الرّجل الذي فشل في فُرصته
الأخيرة لقتل داي وانهزم

108
00:07:20,270 --> 00:07:25,730
ميستوفارن، أنت أكثر تابع موثوق لدى الملك فارن

109
00:07:25,900 --> 00:07:31,610
أعلم أنّك تحت أمرتي، لكن مع ذلك
تمتلك صلاحيّات أكبر

110
00:07:32,410 --> 00:07:36,910
إذا أردت إبلاغ الملك فارن بهزيمتي، فليكُن

111
00:07:37,240 --> 00:07:41,330
أعلم أنّني لستُ في مركزٍ يخوّلني
!لذلك، لكن أودّ أن أطلب منك معروفاً

112
00:07:41,830 --> 00:07:47,460
ريثما أتحوّل إلى شيطان خارق، هلّا قاتلت البشر؟

113
00:07:48,920 --> 00:07:56,140
شارف التحوّل على الاكتمال، لكن البشر
يُخطّطون لأمر جلل

114
00:07:56,720 --> 00:08:02,600
بلغَني أنّ القادة من كلّ أنحاء العالم
يحتشدون في بابنيكا

115
00:08:02,770 --> 00:08:07,650
تريدني أن أسحقهم لأجلك؟ لتكسب الوقت؟

116
00:08:09,480 --> 00:08:11,990
هل سيخدم ذلك الملك فارن؟

117
00:08:12,490 --> 00:08:14,450
علمتُ بهزيمة زامزا

118
00:08:14,950 --> 00:08:20,290
الشّياطين الخارقة هي مخلوقات ناقصة لا تستطيع
استخدام التّعويذات بعد التحوّل

119
00:08:20,450 --> 00:08:24,620
وجدنا حلّاً لهذا العيب سلفاً

120
00:08:24,790 --> 00:08:31,510
تضيع قوّة السّحر أثناء عمليّة التحوّل
من ظلاميّ إلى شيطان خارق

121
00:08:31,670 --> 00:08:36,970
الحلّ هو تحويل هذا الجسد إلى شيطان
!خارق من البداية

122
00:08:37,350 --> 00:08:38,510
ماذا؟

123
00:08:38,930 --> 00:08:43,520
هدلر، هل ستتخلّى عن جسدك الظلاميّ؟

124
00:08:43,690 --> 00:08:46,020
ستواصل حياتك كوحش؟

125
00:08:46,190 --> 00:08:47,110
أجل

126
00:08:47,270 --> 00:08:51,110
سوف تخسر خلودك. هل أنت راضٍ عن ذلك؟

127
00:08:51,280 --> 00:08:58,160
تلاميذ أفان هم أعداء يستحقّون هذه
التّضحية. أعي ذلك جيّداً الآن

128
00:08:58,700 --> 00:09:03,460
!لم أعد بحاجة للمكانة أو الشرف أو حتّى هذه الحياة

129
00:09:03,620 --> 00:09:10,460
يجب أن أهزمهم ولو كلّفني ذلك جسدي
!وإلّا فحياتي لا تعني شيئاً

130
00:09:13,130 --> 00:09:13,880
حسنٌ إذاً

131
00:09:15,130 --> 00:09:19,010
،هدلر، بالرّغم من امتلاك الجسد والقدرات الأقوى

132
00:09:19,180 --> 00:09:22,270
،سبب استمرار أتباع أفان في هزيمتك

133
00:09:22,430 --> 00:09:25,850
كان ضعف إرادتك وكبريائك

134
00:09:26,140 --> 00:09:28,560
لكن يجب أن تتخلّى عن هذه الأمور

135
00:09:28,730 --> 00:09:34,320
بالتغلّب على نقطة ضعفك الأبرز، سوف,
تصبح المُحارب الأعظم

136
00:09:35,400 --> 00:09:37,950
سيكون الملك فارن مسروراً

137
00:09:38,110 --> 00:09:41,080
دع بابنيكا لي

138
00:09:41,240 --> 00:09:42,620
شكراً لك

139
00:09:46,160 --> 00:09:48,580
هل يمكن الوثوق به حقّاً؟

140
00:09:48,750 --> 00:09:54,300
لا نملك خياراً. أكثر ما أحتاج له هو الوقت

141
00:09:54,460 --> 00:10:00,350
!لا يهمّني من يفعل ذلك ما دمتُ أمتلك فرصة أخيرة

142
00:10:05,270 --> 00:10:09,190
هذه بلد جميلة جدّاً

143
00:10:09,350 --> 00:10:11,480
!مرحباً، عدتُم

144
00:10:15,400 --> 00:10:18,240
من هذا العملاق بالضبط؟

145
00:10:18,400 --> 00:10:19,700
!كروكوداين

146
00:10:20,450 --> 00:10:24,410
!مام! سمعتُ أنّكِ قاتلتِ ببسالة

147
00:10:24,580 --> 00:10:27,370
!عودتكِ أشبه بإعطاء عصا حديديّة لغول

148
00:10:27,540 --> 00:10:32,040
!لا تتكلّم عن عصيّ حديديّة وغيلان أمام فتاة

149
00:10:33,090 --> 00:10:34,630
!آسف بشأن ذلك

150
00:10:39,180 --> 00:10:41,010
ما هذا الشّيء؟

151
00:10:41,180 --> 00:10:45,140
هذا زميلي التّلميذ تشيو. انضمّ إلينا مؤخراً

152
00:10:51,690 --> 00:10:56,070
هل أنتم متأكّدون أنّ هذا الجرذ الصّغير
جاهز ليكون جزءاً من الفريق؟

153
00:10:57,190 --> 00:11:00,410
هل هو صديق آخر للآنسة مام؟

154
00:11:00,570 --> 00:11:04,780
مهلاً مهلاً أيّها الضخم. لقد ساعدنا حقّاً

155
00:11:05,330 --> 00:11:09,120
ذوق الآنسة مام سيّئ للغاية

156
00:11:09,290 --> 00:11:11,790
وأين الأميرة والقادة الآخرون؟

157
00:11:11,960 --> 00:11:15,340
قمّة العالم تُعقد... هناك

158
00:11:15,920 --> 00:11:19,670
مُصلّى بابنيكا العظيم. إنّهم مجتمعون هناك

159
00:11:30,770 --> 00:11:36,650
فاجأني لطف ميست بتساهله مع هدلر

160
00:11:36,820 --> 00:11:37,940
!معك حقّ

161
00:11:38,110 --> 00:11:42,660
،لكن، إذا كان يحمل مفتاح فارن

162
00:11:42,820 --> 00:11:47,540
فهذا يعني أنّ الملك فارن هو من أذن بهذا الهجوم

163
00:12:05,720 --> 00:12:07,810
أهلاً بعودتكم جميعاً

164
00:12:09,430 --> 00:12:10,680
!ومام

165
00:12:12,190 --> 00:12:12,980
!ليونا

166
00:12:13,140 --> 00:12:16,360
أرى أنّكِ أصبحتِ أقوى. نعتمد عليكِ

167
00:12:16,520 --> 00:12:21,530
أنت مدهشة أيضاً يا ليونا. وحّدتِ القادة
من كلّ أنحاء العالم

168
00:12:21,690 --> 00:12:24,410
مع الأسف، ليس جميعهم

169
00:12:24,570 --> 00:12:28,030
لم نسمع شيئاً عن قادة البلاد التي سقطت

170
00:12:28,530 --> 00:12:32,830
في رينغايا، لم نتمكّن إلّا من إنقاذ الجنرال باوسون

171
00:12:33,000 --> 00:12:35,000
لم نستطع إيجاد أحد في أورزام

172
00:12:35,580 --> 00:12:40,210
وملكة مملكة كارل، فلورا، ما زالت مفقودة

173
00:12:40,380 --> 00:12:45,220
لا تقلقوا. إنّها معروفة بكونها امرأة شجاعة وجريئة

174
00:12:45,390 --> 00:12:46,510
أنا متأكّدة أنّها بخير

175
00:12:46,680 --> 00:12:49,760
أكثر جرأة من الأميرة؟

176
00:12:49,930 --> 00:12:51,810
وقد تكون حتّى أقوى من داي

177
00:12:51,980 --> 00:12:53,940
!سمعتُك يا بوب

178
00:12:55,690 --> 00:13:00,270
هل يعرف أحد في قمّة العالم شيئاً عن السّيوف الأسطوريّة؟

179
00:13:00,440 --> 00:13:04,150
ما رأيك أن تسأل ملك تيران، فولكين؟

180
00:13:04,490 --> 00:13:06,780
مشهور بمعرفته الواسعة

181
00:13:08,740 --> 00:13:11,620
سيف أقوى من سيف الأبطال

182
00:13:11,790 --> 00:13:14,080
غير موجود على الأرجح

183
00:13:14,250 --> 00:13:15,210
!ماذا؟

184
00:13:15,370 --> 00:13:21,550
،المعدن المُستخدَم في ذلك السّيف، أوريكالكوم
صُنِع من طرف الآلهة

185
00:13:22,090 --> 00:13:26,760
أعطي جزء يسير للبشر وصُنِع منه معدّات أسطوريّة

186
00:13:26,930 --> 00:13:28,970
!ماذا عن سيف تنّين الشّيطان؟

187
00:13:29,140 --> 00:13:32,220
صُنِع ذلك السّيف بواسطة الآلهة

188
00:13:32,390 --> 00:13:35,310
إنّه ليس سيفاً من عالم البشر

189
00:13:35,480 --> 00:13:37,230
هكذا إذاً

190
00:13:38,230 --> 00:13:41,150
هل من سيوف قويّة أخرى؟

191
00:13:41,770 --> 00:13:43,360
استدعِ ميرلي

192
00:13:43,530 --> 00:13:46,400
!ميرلي في بابنيكا؟

193
00:13:53,660 --> 00:13:56,660
سأتمكّن من مساعدة بوب والآخرين من الآن

194
00:13:57,670 --> 00:14:01,920
الآن يا داي، تخيّل الشيء الذي تبحث عنه

195
00:14:02,090 --> 00:14:06,010
وعندما أخبرك، ارمِ هذه الشّعلة

196
00:14:15,270 --> 00:14:16,310
الآن

197
00:14:22,480 --> 00:14:26,610
...لا... ن... كير... كس

198
00:14:27,610 --> 00:14:28,950
ما هذا؟

199
00:14:29,110 --> 00:14:31,280
قرية لانكيركس

200
00:14:31,450 --> 00:14:35,500
قرية صغيرة تقع شمال تيران وبينغارنا

201
00:14:35,950 --> 00:14:37,540
كيف سنصل إلى هناك؟

202
00:14:37,710 --> 00:14:40,040
هل نستعير سفينة منطاد ليونا؟

203
00:14:40,210 --> 00:14:42,540
أم نستخدم "عودة" إلى مكان قريب ما؟

204
00:14:43,000 --> 00:14:45,550
بمقدورنا استخدام "عودة" للوصول إلى هناك مباشرة

205
00:14:45,710 --> 00:14:47,340
!حقّاً؟

206
00:14:47,510 --> 00:14:49,760
بوب، هل زرتَ تلك القرية سابقاً؟

207
00:14:49,930 --> 00:14:53,010
لم أذهب إلى هناك. غادرتُها

208
00:14:53,180 --> 00:14:54,430
إنّها مسقط رأسي

209
00:14:54,600 --> 00:14:57,060
!إنّها موطنك الأصليّ؟

210
00:14:57,230 --> 00:15:00,690
!تدير عائلتك متجر أسلحة، صحيح؟ قد يكون هناك

211
00:15:01,940 --> 00:15:07,240
في الواقع، هربتُ من دياري لأصبح تلميذ المعلّم أفان

212
00:15:18,160 --> 00:15:19,790
يا له من هبوط فظيع

213
00:15:19,960 --> 00:15:23,000
لا تلوميني. فأنا أحمل الكثير

214
00:15:23,670 --> 00:15:24,750
آسفة بشأن هذا

215
00:15:24,920 --> 00:15:26,880
لجعلكِ ترافقيننا

216
00:15:27,050 --> 00:15:30,470
ارتأينا أنّ وجودكِ هنا قد يفيدنا

217
00:15:30,630 --> 00:15:34,720
لا عليكِ. فأنا أريد مساعدتكم جميعاً

218
00:15:34,890 --> 00:15:35,760
من هنا

219
00:15:40,770 --> 00:15:42,270
هذا جيّد

220
00:15:42,770 --> 00:15:47,650
إنّها ليست كتلك المزيّفة. إنّها لطيفة ودافئة

221
00:15:48,530 --> 00:15:51,490
حبّ بوب لها ليس مُستغرباً

222
00:15:54,990 --> 00:15:57,030
يبدو أنه مكان جميل

223
00:15:57,200 --> 00:16:01,580
إنها قرية صغيرة. لم يتغيّر شيء إطلاقاً

224
00:16:05,630 --> 00:16:09,550
المتجر للأمام. سأنتظر هنا

225
00:16:09,710 --> 00:16:11,130
هل أنت متأكّد؟

226
00:16:11,300 --> 00:16:13,430
إذا رآني أبي، ستكون مشكلة

227
00:16:13,590 --> 00:16:15,800
هل تلك السيّدة تعمل في متجر الأسلحة؟

228
00:16:24,730 --> 00:16:25,520
!أمّي

229
00:16:25,690 --> 00:16:27,820
!بوب؟

230
00:16:27,980 --> 00:16:29,190
!أهذا أنت حقّاً؟

231
00:16:32,570 --> 00:16:33,950
!بوب

232
00:16:37,740 --> 00:16:38,490
!أمّي

233
00:16:38,660 --> 00:16:40,200
!بوب

234
00:16:40,370 --> 00:16:41,700
!أمّي، أنا آسف

235
00:16:42,290 --> 00:16:44,040
!أنا آسف -
!لا عليك يا بوب

236
00:16:44,870 --> 00:16:46,250
...بوب

237
00:16:46,420 --> 00:16:49,300
لا بدّ وأنّه اشتاق لها

238
00:16:52,590 --> 00:16:53,930
!أبي؟

239
00:16:54,550 --> 00:16:57,050
!عزيزي، عاد بوب

240
00:16:58,050 --> 00:16:59,350
...بوب

241
00:17:02,600 --> 00:17:04,190
!أبي

242
00:17:06,440 --> 00:17:10,530
!تهرب دون أن تقول كلمة لأكثر من عام

243
00:17:10,690 --> 00:17:13,990
!أتظنّ نفسك تستطيع العودة وكأنّ شيئاً لم يكن؟

244
00:17:14,400 --> 00:17:16,570
!أيّها الابن الجاحد -
!عزيزي، توقّف -

245
00:17:16,740 --> 00:17:17,990
!سيّدي! اهدأ

246
00:17:18,820 --> 00:17:21,660
!...أيُّها

247
00:17:23,960 --> 00:17:27,830
لم أدرك أنّه لدينا زبائن. آسف بشأن ذلك

248
00:17:28,000 --> 00:17:32,380
لا أصدّق أنّ ابني الغبيّ يساعد البطل

249
00:17:32,550 --> 00:17:34,380
لكنّه ساعدنا كثيراً

250
00:17:34,550 --> 00:17:38,090
نحن على قيد الحياة بفضل بوب أصلاً

251
00:17:38,260 --> 00:17:39,850
!إنّه أكثر صديق نعتمد عليه

252
00:17:40,010 --> 00:17:40,970
حقّاً؟

253
00:17:41,140 --> 00:17:43,930
...حسناً يا سيّدي، بشأن ما قلناه

254
00:17:44,100 --> 00:17:46,190
أجل. سيف أسطوريّ

255
00:17:46,350 --> 00:17:48,480
لن تجدوا واحداً في متجري

256
00:17:48,650 --> 00:17:51,610
لكن قد تجدوا شيئاً في منزل لون

257
00:17:51,770 --> 00:17:52,730
لون؟

258
00:17:52,900 --> 00:17:54,940
إنّه ظلاميّ التقيتُه مؤخّراً

259
00:17:55,110 --> 00:17:58,910
!أبي! هل اسم الظلاميّ هو لون بيروك؟

260
00:17:59,070 --> 00:18:00,320
أجل. ماذا يعني؟

261
00:18:00,490 --> 00:18:01,490
تعرفه؟

262
00:18:01,660 --> 00:18:03,080
سمعتُ من هيونكل

263
00:18:03,240 --> 00:18:08,040
الحِرفيّ الأسطوريّ الّذي صنع رمح وسيف
...درع الشّيطان يُدعى

264
00:18:08,210 --> 00:18:09,290
!لون بيروك

265
00:18:09,460 --> 00:18:10,130
!...إذاً

266
00:18:10,290 --> 00:18:12,170
!...أجل، إذا سألناه

267
00:18:12,340 --> 00:18:13,380
وما أدراك؟

268
00:18:14,300 --> 00:18:17,300
إنّه يقيم في الغابة كناسك

269
00:18:17,470 --> 00:18:20,300
لا يحبّ مقابلة النّاس

270
00:18:24,390 --> 00:18:25,430
انصرفوا

271
00:18:26,060 --> 00:18:30,100
لن أكرّس قلبي لصنع سلاح مجدّداً

272
00:18:30,270 --> 00:18:34,070
ناهيكم عن مسعى لا طائل منه مثل
السّيف الأعظم في العالم

273
00:18:34,230 --> 00:18:34,980
!...لكن

274
00:18:35,150 --> 00:18:40,910
تصبّ اهتماماتي أكثر في النتائج التي تحقّقها أسلحتي

275
00:18:41,320 --> 00:18:45,240
لكن مؤخّراً، نَقُصَ عدد مُستخدمي الأسلحة الأقوياء

276
00:18:45,790 --> 00:18:47,370
،مهما كان السّلاح قويّاً

277
00:18:47,540 --> 00:18:50,750
إن كان المُستخدم سيّئاً، سيبقى مجرّد زينة

278
00:18:50,920 --> 00:18:53,000
تلك السّيوف هناك

279
00:18:53,460 --> 00:18:57,210
صنعتُها لتأمين نقود للشرب، لكنّها
أفضل من سيف عاديّ

280
00:18:57,380 --> 00:18:59,340
خذوا سيفاً وغادروا

281
00:19:16,820 --> 00:19:19,280
أفضل من سيف عاديّ لا يكفي

282
00:19:19,450 --> 00:19:24,830
حتّى سيف درع الشّيطان الّذي صنعتَه
أنت لم يتحمّل قوّتي وتحطّم

283
00:19:24,990 --> 00:19:25,870
ماذا؟

284
00:19:26,040 --> 00:19:30,540
!أرجوك! اصنع سيفاً أقوى من سيف الشّيطان

285
00:19:30,710 --> 00:19:34,460
!وإلّا لن أتمكّن من مجاراة سيف تنّين الشّيطان

286
00:19:34,630 --> 00:19:36,800
!سيف تنّين الشّيطان؟

287
00:19:37,340 --> 00:19:38,880
!قاتلت بذلك السّلاح؟

288
00:19:39,050 --> 00:19:41,130
!وماذا كانت النتيجة؟

289
00:19:41,300 --> 00:19:43,180
كانت تعادُلاً

290
00:19:43,340 --> 00:19:47,890
كسرتُ سيفهم، لكن تداعى سيفي

291
00:19:48,060 --> 00:19:49,430
لذا أعتقد أنّني خسرت

292
00:19:49,600 --> 00:19:54,020
!كسرته؟ كسرتَ سيف تّين الشّيطان بسيفي؟

293
00:19:54,190 --> 00:19:55,230
أجل

294
00:19:57,780 --> 00:19:59,690
!مذهل! بديع

295
00:20:00,110 --> 00:20:01,990
لون، ما المضحك في الأمر؟

296
00:20:02,150 --> 00:20:04,030
!كيف لي ألّا أفرح؟

297
00:20:04,200 --> 00:20:08,700
سيف تنّين الشّيطان صُنِع بواسطة الآلهة
!كأعظم سيف في العالم

298
00:20:08,870 --> 00:20:14,210
إنّه السّلاح المُطلَق الّذي قضيتُ أكثر
!من قرن أسعى له

299
00:20:14,380 --> 00:20:19,300
فأسمع الآن أنّ سيف الشّيطان الّذي صنعتُه
!بيدي من معدن أقلّ جودة حطّمَه

300
00:20:19,460 --> 00:20:21,340
!أدهشتني يا فتى

301
00:20:23,590 --> 00:20:27,810
بوجودِك كمُستخدم له، أستطيع صناعة
!السّيف الأعظم في العالم

302
00:20:27,970 --> 00:20:33,560
إذا صنعتُه من نفس المادّة، فسوف
!يتفوّق على سيف تنّين الشّيطان

303
00:20:33,730 --> 00:20:35,560
!إذاً أسرع من فضلك

304
00:20:35,730 --> 00:20:39,020
"اهدأ، قلتُ "نفس المادّة

305
00:20:40,940 --> 00:20:44,110
نفس مادّة سيف تنّين الشّيطان. أوريكالكوم

306
00:20:44,280 --> 00:20:45,950
ابحثوا لي عن أوريكالكوم

307
00:20:46,120 --> 00:20:46,950
!ماذا؟

308
00:20:47,120 --> 00:20:51,620
لستُ خيميائيّاً. من دون مادّة، لا أستطيع صناعة سلاح

309
00:20:51,790 --> 00:20:54,290
يا إلهي. عدنا للمربّع الأوّل

310
00:20:54,460 --> 00:20:57,170
لكن علينا البحث عن بعض الأوريكالكوم

311
00:20:57,330 --> 00:20:59,710
...القول أسهل من الفعل

312
00:21:02,670 --> 00:21:04,180
!تاج الأبطال

313
00:21:04,340 --> 00:21:07,260
!قال الملك روموس أنّه مصنوع من الأوريكالكوم

314
00:21:07,430 --> 00:21:09,100
!إلى جزيرة ديرملين

315
00:21:13,480 --> 00:21:15,640
!جدّي! أين؟! أين هو؟

316
00:21:15,810 --> 00:21:17,270
ما الخطب؟

317
00:21:17,440 --> 00:21:19,020
!تاج الأبطال الخاصّ بي

318
00:21:19,190 --> 00:21:21,110
ينبغي أن يكون هناك

319
00:21:22,280 --> 00:21:23,860
!أين؟! هذا

320
00:21:24,030 --> 00:21:25,240
!بئساً! ليس هو

321
00:21:25,400 --> 00:21:27,070
!لحظة! وجدتُه

322
00:21:27,240 --> 00:21:29,200
!هذا هو الأوريكالكوم إذاً

323
00:21:29,950 --> 00:21:31,120
!هيّا بنا

324
00:21:31,290 --> 00:21:33,910
!وداعاً يا جدّي -
!نستأذن

325
00:21:34,080 --> 00:21:34,750
!عودة

326
00:21:34,910 --> 00:21:37,290
!نظّفا مخلّفاتكما

327
00:22:04,320 --> 00:22:07,280
حتّى لو واجهت الشّيطان والمنطق في صفّك

328
00:22:07,450 --> 00:22:11,240
قد يكون مجرّد تبرير

329
00:22:11,410 --> 00:22:15,330
حتّى الآن، حتّى الآن ما زلتُ أتردّد

330
00:22:15,500 --> 00:22:19,380
إلى أي مدى سنصل؟

331
00:22:19,540 --> 00:22:22,670
سمعتُ صوتاً أشبه بهمسِ ملاك

332
00:22:22,840 --> 00:22:26,590
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

333
00:22:26,760 --> 00:22:30,300
مُعرّض للحبِّ والحزن

334
00:22:30,470 --> 00:22:34,600
على الدّربِ المُغطّى بالاعتزاز

335
00:22:36,310 --> 00:22:38,640
لحظات عابِرة من الجُبن

336
00:22:40,190 --> 00:22:42,440
نداء الاستغاثة الذي تحفّظتُ عليه

337
00:22:44,020 --> 00:22:48,030
قبضتُ يدي المُرتعدة

338
00:22:48,610 --> 00:22:53,620
ذلك الوعد البسيط

339
00:22:53,780 --> 00:22:57,410
تلك الذّكريات التّافهة الصّغيرة

340
00:22:57,580 --> 00:22:59,710
ما زالت تسكن قلبي

341
00:22:59,870 --> 00:23:03,880
كجمرٍ يُبقيني مُشتعلاً

342
00:23:04,040 --> 00:23:08,380
شُعاع شفّاف من النُّور

343
00:23:08,550 --> 00:23:11,550
يُنير الدّرب أمامي

344
00:23:11,720 --> 00:23:16,220
قلّما أستطيع فعله

345
00:23:16,390 --> 00:23:22,440
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

346
00:23:33,990 --> 00:23:39,660
لون بيروك، الحِرفيّ الأعظم في العالم
السّفلي سيصنع سيفاً لداي

347
00:23:39,830 --> 00:23:44,250
،في بابنيكا، تُعقد قمّة قادة العالم برئاسة ليونا

348
00:23:44,420 --> 00:23:47,090
لكن لا تتوحّد آراؤهم

349
00:23:47,250 --> 00:23:53,220
مع تشكُّل ضباب مشؤوم، تقترب خطوات
أقدام جيش الشّياطين العملاقة

350
00:23:53,720 --> 00:23:55,760
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

351
00:23:57,930 --> 00:23:59,730
!وتستمرّ المغامرة