1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:50,650 --> 00:01:51,820
!وواحدة أخرى

20
00:02:54,040 --> 00:02:56,590
هـ-هل أفلح ذلك؟

21
00:02:56,760 --> 00:02:57,800
أجل

22
00:02:59,050 --> 00:03:00,130
!داي

23
00:03:00,680 --> 00:03:02,340
أنا بخير

24
00:03:02,510 --> 00:03:04,850
أشعر بفتور الهمّة فحسب

25
00:03:07,100 --> 00:03:11,140
عرفتُ بأنّ استخدام دورورا مرّتين
على التّوالي سيُنهكني

26
00:03:11,310 --> 00:03:15,770
لكن كنتُ قادراً على فعلها لأنّكِ
فهمتِ ما كنتُ أفكّر فيه

27
00:03:16,530 --> 00:03:17,690
شكراً لك

28
00:03:19,860 --> 00:03:24,450
لا أصدّق بأنّك استخدمت دورورا
مرّتين على التّوالي

29
00:03:25,030 --> 00:03:29,830
عندما أدركتُ بأنّ فارن استخدم عصا النّهم
،للنجاة من دورورا خاصّتي

30
00:03:30,000 --> 00:03:34,880
عرفتُ بأنّه لن يتمكّن من تحمّلها
مرّتين على التّوالي

31
00:03:35,460 --> 00:03:39,720
ارتأيتُ أنّ هذا قد يكون مُمكناً
إذا شفيتِ قوّتي السحريّة

32
00:03:39,880 --> 00:03:41,470
هكذا إذاً

33
00:03:41,630 --> 00:03:47,560
ما كان ذلك ليفلح لو تفاداها، لكن لو كان
،يستخدم عصاه للتصدّي لها

34
00:03:47,720 --> 00:03:52,270
لو أطلقتَ واحدة ثانية مع الاحتفاظ
،بطاقة الضربة الأولى

35
00:03:52,440 --> 00:03:55,190
لكانت تُساوي دورورا اثنتين

36
00:03:57,650 --> 00:04:01,360
من المُحال... أن ينجو من ذلك

37
00:04:06,830 --> 00:04:10,910
كان ذلك سريعاً لدرجة أنّ الحقيقة
لم يتمّ استيعابها بعد

38
00:04:11,660 --> 00:04:15,580
لطالما كان هناك فارس تنّين واحد فقط

39
00:04:16,290 --> 00:04:19,500
...إصابة شيء بدورورا مرّتين على التّوالي

40
00:04:19,670 --> 00:04:23,430
إنّها قوّة مُدمِّرة ينبغي أن تكون
مستحيلة في الأحوال العاديّة

41
00:04:23,590 --> 00:04:25,390
هذا لأنّه فارن

42
00:04:27,550 --> 00:04:33,730
لا أحد سوى فارن يستطيع التصدّي لتعويذة دورورا

43
00:04:34,190 --> 00:04:36,310
...لأنّ فارن قويّ جدّاً

44
00:04:36,480 --> 00:04:43,030
قوّته هي السّبب الذي جعله ينتهي
بتلقّيه هجمة بتلك القوّة

45
00:04:44,150 --> 00:04:48,990
أعتقد أن يكون المرء قويّاً جدّاً
لا يُعتبَر كلّ شيء

46
00:04:54,330 --> 00:04:58,880
!هيّا! قِف مُعتزّاً يا بطل! لقد ربحت

47
00:05:00,090 --> 00:05:02,460
!لقد هزمتَ ملك الشّياطين

48
00:05:05,930 --> 00:05:11,010
كان ذلك هائلاً. كانت أكبر صدمة
شعرتُ بها اليوم

49
00:05:11,520 --> 00:05:15,310
...إمّا سبّبَها داي... أو

50
00:05:15,480 --> 00:05:16,480
!ينبغي أن نسرع

51
00:05:16,650 --> 00:05:19,020
ماذا بشأنه؟

52
00:05:19,610 --> 00:05:21,730
دعه فحسب

53
00:05:21,900 --> 00:05:26,990
.نعلم بأنّه لا يستطيع المُقاومة
لا داعي لقتله

54
00:05:27,410 --> 00:05:29,120
أليس كذلك يا هيونكل؟

55
00:05:29,280 --> 00:05:32,540
ليس علينا القضاء عليه، أليس كذلك؟

56
00:05:33,660 --> 00:05:38,630
أنتِ مُتسامِحة جدّاً يا مام! كم
!مرّة قاتلنا هذا الوحش؟

57
00:05:38,790 --> 00:05:41,840
!ينبغي أن نقضي عليه هنا وإلّا ندمنا

58
00:05:42,000 --> 00:05:44,920
!تعلمين بأنّ كلامي صحيح، أليس كذلك؟

59
00:05:45,090 --> 00:05:49,430
لكن إذا خسرَ داي أمام فارن
!فسيكون ذلك عديم الجدوى

60
00:05:50,100 --> 00:05:52,100
...حتّى لو قتلنا ميستوفارن

61
00:05:55,230 --> 00:05:56,850
هل تتشاجران؟

62
00:05:57,020 --> 00:06:00,270
!روح التّعاون الجماعي بينكم سيّئة

63
00:06:00,440 --> 00:06:03,150
...كان الحرس الملكيّ

64
00:06:16,250 --> 00:06:19,620
!لا ينبغي أن يحرك ساكناً

65
00:06:19,790 --> 00:06:21,330
!هل هو خالد؟

66
00:06:22,090 --> 00:06:27,260
!رأيتِ؟! هل ما زلتِ تريدين أن ترحميه الآن؟

67
00:06:27,420 --> 00:06:28,510
!هيم

68
00:06:28,680 --> 00:06:33,970
!ليس عليك إخباري! سأقضي عليه حالاً

69
00:06:34,890 --> 00:06:36,560
...الملك فارن

70
00:06:36,980 --> 00:06:38,480
سامحني

71
00:06:39,060 --> 00:06:40,940
سامحني أرجوك

72
00:06:41,230 --> 00:06:44,020
!كُفّ عن ثرثرتك عديمة الجدوى

73
00:07:09,220 --> 00:07:12,430
سامحني أيُّها الملك فارن

74
00:07:13,350 --> 00:07:14,800
...للمرّة الأولى

75
00:07:15,470 --> 00:07:18,350
...دون إذنك

76
00:07:18,520 --> 00:07:21,390
كشفتُ عن هذا الوجه

77
00:07:21,560 --> 00:07:23,480
...هـ-هذا

78
00:07:23,650 --> 00:07:25,610
!وجه فارن

79
00:07:25,770 --> 00:07:29,440
بشريّ؟ لا. ظلاميّ

80
00:07:29,610 --> 00:07:36,660
الوجه الحقيقيّ الّذي حتّى لون بيروك
قد خشيَه هو هذا الشابّ النّحيل؟

81
00:07:37,080 --> 00:07:39,620
هذا الحضور... أعرفه

82
00:07:55,220 --> 00:07:58,680
!كلّ هذه القوّة... من دفعة واحدة فقط؟

83
00:08:00,850 --> 00:08:02,310
كم هذا مُرعِب

84
00:08:03,020 --> 00:08:05,520
فعلتُ شيئاً مُرعِباً حقّاً

85
00:08:06,520 --> 00:08:12,570
حتّى أنا لا أستطيع الإفلات من العقوبة
الشّديدة من الملك فارن هذه المرّة

86
00:08:12,950 --> 00:08:15,910
وقد يصل الأمر للإعدام المحتوم

87
00:08:16,660 --> 00:08:20,830
!الكشف عن هذا الوجه هو جريمة عظيمة

88
00:08:21,000 --> 00:08:24,250
!...وأن أفعله دون إذن الملك فارن

89
00:08:24,420 --> 00:08:27,840
!أيّها الحقير! هل تحاول استفزازي؟

90
00:08:28,000 --> 00:08:30,760
!ما المُميّز في هذا الوجه المُغترّ؟

91
00:08:30,920 --> 00:08:32,170
!توقّف يا هيم

92
00:08:35,140 --> 00:08:37,010
!يا لها من نيّة خبيثة قاهرة

93
00:08:37,970 --> 00:08:40,640
لستَ أحمق كما توقّعت

94
00:08:40,810 --> 00:08:43,600
لقد شعرتَ بقوّتي

95
00:08:43,770 --> 00:08:50,150
ماذا؟! هل... هل يؤثّر عليّ ضغطه؟

96
00:08:50,320 --> 00:08:56,160
بواسطة... بواسطة هذا الرّجل
العاديّ... طبيعيّ الشّكل؟

97
00:08:56,700 --> 00:09:02,370
كانت هالته الشيطانيّة أقوى بكثير
!عندما كان يضع قناعه

98
00:09:03,040 --> 00:09:06,710
ممتاز. فلتخَف

99
00:09:07,580 --> 00:09:09,670
أنا خائف أيضاً

100
00:09:09,840 --> 00:09:12,170
!تـ-تبّاً لك

101
00:09:12,710 --> 00:09:15,590
!ثرثر كما تشاء بعد أن تتذوّق هذا

102
00:09:15,760 --> 00:09:17,390
!توقّف! لا تفعلها يا هيم

103
00:09:17,760 --> 00:09:19,760
!بُرجُمة الهالة

104
00:09:20,560 --> 00:09:21,220
!ماذا؟

105
00:09:29,770 --> 00:09:31,190
!أيُعقَل هذا؟

106
00:09:31,360 --> 00:09:33,400
!ذِراع الأوريكالكوم الخاصّة بهيم

107
00:09:35,740 --> 00:09:40,700
!لقد لواها! بالقوّة! وبشكل عفويّ

108
00:09:41,280 --> 00:09:45,710
وليس باستخدام قوّة خصمه ضدّه
!كما كنتُ لأفعل أنا

109
00:09:45,870 --> 00:09:48,170
!مزّقها بالقوّة الخالصة

110
00:09:51,250 --> 00:09:53,170
!ذراعي

111
00:09:56,800 --> 00:09:59,970
مدهش جدّاً يا لارهارت

112
00:10:00,140 --> 00:10:04,600
إنّ الضربة العاديّة كانت لتحطّم
تلك الذّراع أو تبعجها

113
00:10:07,980 --> 00:10:15,070
شظايا الأوريكالكوم المُحطّمة هذه
هي دليل على قوّتك

114
00:10:16,150 --> 00:10:17,070
...لكن

115
00:10:25,330 --> 00:10:28,460
...أنت وذلك البيدق

116
00:10:28,790 --> 00:10:33,590
قد تكونان مُحاربين بأعلى مستوى
في عالم السّطح هذا

117
00:10:33,750 --> 00:10:38,300
لكن لا يمكنك أن تحلم بمُجاراتي بهذا الشّكل

118
00:10:38,880 --> 00:10:43,300
هذا هو وجه أقوى رجل في العالم السّفلي

119
00:10:43,470 --> 00:10:44,010
!ماذا؟

120
00:10:44,180 --> 00:10:49,190
ما-ماذا عن فارن؟! أليس من المُفترض
!أن يكون فارن أعظم منك؟

121
00:10:52,060 --> 00:10:54,690
الملك فارن رجل عظيم

122
00:10:55,320 --> 00:10:59,950
حكمته وقوّته السحريّة لا نظير لهما بالفعل

123
00:11:00,110 --> 00:11:05,950
لكن من حيث الجسد المتين، أنا
أفضل منه حاليّاً

124
00:11:06,870 --> 00:11:08,000
هذا صحيح

125
00:11:08,330 --> 00:11:11,080
أنا أقوى من الملك فارن

126
00:11:13,330 --> 00:11:18,170
أنا الأقوى في جيش الشّياطين

127
00:11:35,150 --> 00:11:37,570
حسناً! استخدمتُ شفاء كامل عليك

128
00:11:37,730 --> 00:11:38,820
!شكراً

129
00:11:39,440 --> 00:11:44,200
أنا قلق على الآخرين. لنعد مُسرعين
إلى الحديقة البيضاء

130
00:11:47,290 --> 00:11:49,540
ماذا؟ ماذا؟

131
00:11:49,700 --> 00:11:51,870
!ما-ما الأمر يا داي؟

132
00:11:52,040 --> 00:11:56,540
كلّ ما في الأمر أنّني أشعر بضعف بسيط

133
00:11:57,170 --> 00:12:00,760
ينبغي أن أُشفَى بشكل أفضل من السّابق

134
00:12:00,920 --> 00:12:03,930
!لم تُشفَ بشكل كامل؟! بتعويذة شفاء كامل؟

135
00:12:04,090 --> 00:12:05,390
هذا ما أعتقده

136
00:12:05,550 --> 00:12:08,720
لكن هذا أفضل عندما أطلق دورورا

137
00:12:08,890 --> 00:12:10,180
!عمّاذا تتكلّم؟

138
00:12:10,350 --> 00:12:13,810
!إذاً تعافيتَ بالشّكل الّذي تتعافى فيه عادةً

139
00:12:14,440 --> 00:12:18,820
من المستحيل ألّا تتعافى لياقتك بشكل
كامل من تعويذة شفاء كامل

140
00:12:21,490 --> 00:12:24,030
لحظة. قد يكون هذا مُمكناً

141
00:12:24,200 --> 00:12:24,860
ماذا؟

142
00:12:25,030 --> 00:12:26,820
ذكرَ هيونكل ذلك

143
00:12:26,990 --> 00:12:31,700
لا يمكن شفاء ضرر من هالة شيطانيّة
بسحر من نوع شفاء

144
00:12:31,870 --> 00:12:36,330
قد يكون من المُمكن أنّ الهالة
التنّينيّة مُشابهة

145
00:12:37,170 --> 00:12:42,050
إذا ألحقَ الارتداد من دورورا المُزدوجة
تلك بقايا أضرار بك

146
00:12:42,220 --> 00:12:45,010
...لا تتأثّر بسحر من نوع شفاء

147
00:12:45,180 --> 00:12:47,260
ماذا سنفعل بشأن ذلك؟

148
00:12:47,430 --> 00:12:48,850
...في الواقع

149
00:12:49,260 --> 00:12:51,390
هزمنا فارن بالفعل

150
00:12:51,560 --> 00:12:56,980
إمّا أن ندعه يُشفى بشكل طبيعيّ
أو ننتظر حتّى ينجح سحر الشّفاء

151
00:12:57,150 --> 00:12:59,480
كلّ ما يمكننا فعله هو ترك الأمر للوقت

152
00:12:59,650 --> 00:13:02,400
كم سيستغرق ذلك وقتاً برأيك؟

153
00:13:02,860 --> 00:13:04,820
لا داعي للعجلة

154
00:13:04,990 --> 00:13:10,120
قد يكون ميستوفارن قويّاً، لكن
لا يمكن أن يكون أقوى من فارن

155
00:13:10,540 --> 00:13:14,250
،إذا كان لارهارت يتعاون مع الآخرين
فسيكونون بخير

156
00:13:15,540 --> 00:13:18,460
إنّ الأولويّة هي لاستعادة قوّتك بشكل كامل

157
00:13:18,630 --> 00:13:23,090
يمكننا التّفكير في بوب والمعلّم
أفان والآخرين عقب ذلك

158
00:13:23,260 --> 00:13:27,010
إذا ذهبتَ لتقديم المُساعدة وأنت بهذا
الوضع، فسوف تُعيقهم فحسب

159
00:13:27,180 --> 00:13:29,550
أنتِ دائماً صريحة جدّاً يا ليونا

160
00:13:30,890 --> 00:13:33,930
لكن أعتقد أنّ هذا ما يجعلكِ أهلاً للثِقة

161
00:13:34,890 --> 00:13:37,600
!مهلاً! أيّ مديح هذا؟

162
00:13:44,740 --> 00:13:45,900
لماذا؟

163
00:13:46,860 --> 00:13:49,780
ما زلتُ أشعر برجفة في قلبي

164
00:13:50,370 --> 00:13:51,450
...ما زال ينتابني

165
00:13:51,620 --> 00:13:56,750
هذا الإحساس الفظيع... بأنّ شيئاً
سيّئاً سوف يحدث

166
00:13:58,000 --> 00:13:59,250
!ماذا؟

167
00:13:59,420 --> 00:14:02,250
!أنت أقوى من فارن؟

168
00:14:02,750 --> 00:14:04,460
!كفاك هُراء

169
00:14:04,630 --> 00:14:09,760
ماذا؟ هل تقول بأنّك الزعيم الحقيقيّ
!لجيش الشّياطين؟

170
00:14:10,260 --> 00:14:12,720
!وبأنّك أعلى من فارن؟

171
00:14:14,890 --> 00:14:16,270
!قُل شيئاً

172
00:14:17,600 --> 00:14:19,850
،بذكائك الهزيل

173
00:14:20,020 --> 00:14:24,480
لن تفهموا حتّى لو شرحتُ علاقتي بالملك فارن

174
00:14:25,030 --> 00:14:27,780
لكن سأجيب عن سؤالك الأوّل

175
00:14:29,030 --> 00:14:31,410
كلامك صحيح

176
00:14:31,570 --> 00:14:34,240
...إذاً... أنت فعلاً

177
00:14:34,410 --> 00:14:37,210
قد يكون... أقوى فعلاً

178
00:14:37,660 --> 00:14:40,080
!هذه القوّة تفوق استيعاب البشر

179
00:14:40,670 --> 00:14:42,920
!قد تكون أعظم من قوّة فارن

180
00:14:43,090 --> 00:14:45,590
كونوا مُمتنّين بينما تموتون

181
00:14:46,170 --> 00:14:48,510
قد تعيشون لقرون

182
00:14:48,670 --> 00:14:52,050
دون أن تحصلوا على الفُرصة
لتُقتَلوا على يد أمثالي

183
00:14:52,220 --> 00:14:55,640
هِبة الموت هذه هي أكثر ممّا تستحقّونه بكثير

184
00:14:57,390 --> 00:14:58,980
!لا شيء سيفلح

185
00:14:59,140 --> 00:15:02,690
!لكن لن نسقط بسهولة

186
00:15:04,820 --> 00:15:07,940
،قد يبدو أنّنا ضعفاء أمامه

187
00:15:08,110 --> 00:15:10,860
...لكن إذا استطعنا عرقلته

188
00:15:11,030 --> 00:15:13,950
!ما زال لدينا خيارنا الأخير

189
00:15:19,710 --> 00:15:21,330
!ميدروا

190
00:15:24,210 --> 00:15:28,590
!أشعر بأنّ آمالاً كبيرة معقودة عليّ

191
00:15:28,760 --> 00:15:30,680
!يا له من ضغط

192
00:15:31,010 --> 00:15:34,800
إذا استخدمتُها بشكل مُباشر، فقد يعكسها فحسب

193
00:15:34,970 --> 00:15:37,060
!وهو ليس بطيئاً أيضاً

194
00:15:40,060 --> 00:15:41,020
!أنت

195
00:15:41,480 --> 00:15:44,360
عالجني إذا كنتُ أستطيع القتال ثانية

196
00:15:44,980 --> 00:15:48,280
سأثبّته بطريقة ما

197
00:15:48,440 --> 00:15:52,320
عندما أفعل، أطلِق تعويذتك الضّخمة تلك

198
00:15:52,490 --> 00:15:54,490
...مُحال أن أستطيع -
!أيّها الأحمق -

199
00:15:54,660 --> 00:15:56,700
!لا وقت للتردّد

200
00:15:56,870 --> 00:16:00,620
!ألا ترى؟! سيقتلنا جميعاً

201
00:16:12,760 --> 00:16:15,140
يبدو أنّكم ما زلتم جاهزين للقتال

202
00:16:15,300 --> 00:16:17,680
شجاعتكم تستحقّ الثّناء

203
00:16:17,850 --> 00:16:22,640
حتّى في وجه قوّة قاهرة، لم يفقد
أيّ واحد منكم الأمل

204
00:16:22,810 --> 00:16:27,520
تمكّنتُم من مقاتلة الملك فارن مرّة في السّابق

205
00:16:36,030 --> 00:16:37,370
!شكراً

206
00:16:37,530 --> 00:16:39,490
والآن حان وقت حركتك القاضية

207
00:16:39,660 --> 00:16:42,870
لا تنسَ ما قلتُه لك

208
00:16:43,040 --> 00:16:47,880
قد تكون كائناً حيّاً معدنيّاً، لكن
!لا أستطيع التّضحية بك

209
00:16:49,130 --> 00:16:53,970
إذا تردّدتَ هكذا فستنتهي ميّتاً
مع تلك الفتاة التي تحبّها

210
00:16:54,130 --> 00:16:56,800
إذا كانت حياتي هي كلّ ما يكلّفه
ذلك، فاعتبرها صفقة

211
00:16:57,850 --> 00:17:02,180
!وما أدرى عدوٌ عشوائيّ مثلك بذلك؟

212
00:17:02,350 --> 00:17:04,480
هذا جليّ يا صاحبي

213
00:17:04,640 --> 00:17:07,610
!كفى جِدالاً واستعدّا

214
00:17:07,770 --> 00:17:10,020
!جميعنا نعتمد عليكما

215
00:17:12,400 --> 00:17:13,530
...أنتم

216
00:17:14,820 --> 00:17:16,660
لكم ذلك

217
00:17:17,410 --> 00:17:19,910
،لا أعرف ما الّذي يخطّطان له

218
00:17:20,080 --> 00:17:23,120
لكن أعتقد سأشارك في هذا الرّهان

219
00:17:23,290 --> 00:17:26,330
!ها هي ذي! إنّها الجولة الثّانية

220
00:17:26,500 --> 00:17:29,540
!الجميع باستثناء نحن، ابقوا بعيدين

221
00:17:29,710 --> 00:17:31,420
!التزموا بالهجمات عن بُعد

222
00:17:48,770 --> 00:17:53,150
...هجمات لارهارت وهيم الآنيّة

223
00:17:53,320 --> 00:17:54,150
!لا تحقّق الإصابة...

224
00:17:55,650 --> 00:17:57,820
!ليست مسألة أنّها لا تحقّق الإصابة

225
00:18:00,370 --> 00:18:04,660
!كما في السّابق، بعض الهجمات تُحدِث تأثيراً

226
00:18:04,830 --> 00:18:05,540
...ومع ذلك

227
00:18:07,420 --> 00:18:10,000
...تبّاً! في هذه الحالة

228
00:18:10,170 --> 00:18:12,590
ما رأيك بهذا؟

229
00:18:20,890 --> 00:18:23,220
كان ذلك سريعاً

230
00:18:23,600 --> 00:18:27,640
!اللّعنة! لا أستطيع تثبيته في مكانه

231
00:18:50,080 --> 00:18:54,130
هجوم ملك الوحوش البرّية القاهر
!الخاص به لا يُعرقله إطلاقاً

232
00:18:59,470 --> 00:19:00,800
!كروكوداين

233
00:19:04,010 --> 00:19:06,390
هل أنت بخير؟ -
أجل -

234
00:19:06,680 --> 00:19:09,890
لم أتوقّع أن تُنقذني أنت

235
00:19:12,980 --> 00:19:16,070
!ليتني أستطيع التحرّك بحرّية

236
00:19:17,570 --> 00:19:19,110
!إنّه قويّ جدّاً

237
00:19:19,320 --> 00:19:20,860
،أكره إحباط الجميع

238
00:19:21,030 --> 00:19:24,870
!لكن لا يوجد وقت لتجهيز تعويذة ميدروا

239
00:19:26,080 --> 00:19:27,290
يا له من وجه صافٍ

240
00:19:27,450 --> 00:19:28,700
!ماذا؟

241
00:19:28,870 --> 00:19:32,630
!ما الّذي تتحدّثين عنه في وقت كهذا؟

242
00:19:32,790 --> 00:19:37,000
!لديك ميول دائم للوسيمين، أليس كذلك؟

243
00:19:37,170 --> 00:19:38,800
!ليس هذا ما قصدت

244
00:19:38,960 --> 00:19:43,220
تلقّى ضربات عديدة حتّى عندما
كان يضع قناعه

245
00:19:43,390 --> 00:19:46,810
وحتّى أنّني أصبتُه في وجهه بقبضة الانكسار

246
00:19:47,470 --> 00:19:50,430
!ومع ذلك لم يظهر خدش عليه

247
00:19:50,600 --> 00:19:52,480
معكِ حقّ

248
00:19:52,650 --> 00:19:53,850
!إنّه صافٍ تماماً

249
00:19:54,020 --> 00:19:55,190
مام

250
00:19:56,020 --> 00:19:57,020
!كبير المُعلّمين

251
00:19:57,190 --> 00:20:00,400
لا، أنا الآن بيست-كن

252
00:20:01,400 --> 00:20:03,110
...هل هذا الرّجل

253
00:20:03,280 --> 00:20:05,830
المهمّ، هل هذا صحيح؟

254
00:20:05,990 --> 00:20:09,120
ضربتِه في وجهه بقبضة الانكسار

255
00:20:09,290 --> 00:20:10,000
أجل

256
00:20:10,160 --> 00:20:12,420
هكذا إذاً. فهمت

257
00:20:12,580 --> 00:20:16,710
أظنّني كشفتُ سرَّ خلوده

258
00:20:18,090 --> 00:20:20,630
الخلود وعدم قابليّة التّدمير أمران مختلفان

259
00:20:20,800 --> 00:20:25,300
قد يكون ميستوفارن قويّاً ومنيعاً
،للأضرار حسبما يظهر

260
00:20:25,470 --> 00:20:29,270
لكن قبضة الانكسار تُنهِك الوظائف الحيويّة

261
00:20:29,430 --> 00:20:32,690
بحكم العادة، ينبغي أن تكون قد ظهرت علامة ما عليه

262
00:20:33,190 --> 00:20:35,270
هناك تفسير وحيد فقط

263
00:20:35,440 --> 00:20:41,360
جسده غير حيّ. إنّه بلا وظائف حيويّة

264
00:20:41,530 --> 00:20:42,490
!ماذا؟

265
00:20:42,650 --> 00:20:46,450
بوب، سأمنحك فُرصة لإطلاق ميدروا

266
00:20:46,620 --> 00:20:50,040
!انتظر! هذا جنون -
لا تقلق -

267
00:20:51,330 --> 00:20:56,790
لكن أعاني من مرض الكاحل اللّامع

268
00:20:56,960 --> 00:21:02,880
لا أستطيع القتال لفترة طويلة، لذا
استغلّ تلك الفرصة

269
00:21:03,260 --> 00:21:06,640
ألم يكن مرض بروكينا مختلفاً؟

270
00:21:06,800 --> 00:21:10,720
!انسَ ذلك! لا أملك وقتاً للتفكير في ذلك

271
00:21:17,520 --> 00:21:18,650
ما هذا؟

272
00:21:18,810 --> 00:21:21,780
والآن سيكسب مهرّجٌ الوقت؟

273
00:21:21,940 --> 00:21:24,780
...سرّ خلودك

274
00:21:25,150 --> 00:21:27,160
...لا بدّ وأنّه

275
00:21:32,830 --> 00:21:35,460
تعويذة الزمن المُتوقِّف السرّية

276
00:21:43,420 --> 00:21:45,930
أتعلم بالتّعويذة السرّية؟

277
00:21:49,720 --> 00:21:50,930
!أنت

278
00:21:51,430 --> 00:21:52,970
!من تكون؟

279
00:21:57,140 --> 00:21:59,480
!بيست-كن

280
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

281
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

282
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

283
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

284
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

285
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

286
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

287
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

288
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

289
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

290
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

291
00:23:33,990 --> 00:23:37,540
يُدرِك بروكينا سرّ ميستوفارن غير المُقنَّع

292
00:23:37,700 --> 00:23:41,290
،بينما يُربِك ميستوفارن بحركاته المرنة

293
00:23:41,460 --> 00:23:44,250
يبحث بوب عن ثغرة لإطلاق ميدروا

294
00:23:44,420 --> 00:23:47,760
ما هو سرّ ميستوفارن الّذي يشرحه بروكينا؟

295
00:23:47,920 --> 00:23:52,680
وهل يستطيع بوب تحقيق النّصر
بتعويذة ميدروا خاصّته؟

296
00:23:52,840 --> 00:23:55,300
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

297
00:23:57,600 --> 00:23:59,930
!وتستمرّ المغامرة