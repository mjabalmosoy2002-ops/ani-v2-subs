1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:07,290 --> 00:02:08,540
وصل

20
00:02:08,710 --> 00:02:10,500
!قصر فارن

21
00:02:11,420 --> 00:02:16,010
!أبقوهما مُقيّدين هناك طوال اللّيل؟ إنّهم عديمو الرّحمة

22
00:02:17,510 --> 00:02:18,970
...هيونكل

23
00:02:19,300 --> 00:02:23,010
!سيّد كروكوداين، سنخرجك من هناك

24
00:02:33,650 --> 00:02:34,520
توقّفت

25
00:02:44,580 --> 00:02:46,200
...الشّمس

26
00:02:47,950 --> 00:02:48,910
...الآن

27
00:02:49,750 --> 00:02:55,000
في أوجّها، بأشدّ بريقها

28
00:02:57,420 --> 00:02:58,800
إنّه الظّهر

29
00:03:04,890 --> 00:03:08,810
ميرلي، هل كلّ هؤلاء قوّات العدوّ؟

30
00:03:10,100 --> 00:03:11,350
أجل

31
00:03:11,520 --> 00:03:15,440
...قائد فيلق الظلّ والوحوش المُصفّحة

32
00:03:15,610 --> 00:03:17,280
!هناك 36 منهم

33
00:03:17,570 --> 00:03:22,030
أشعر بمقدار هائل من الضغط ينبعث
...من قصر فارن

34
00:03:22,200 --> 00:03:24,320
لكن هذا كلّ شيء بالنسبة للبرّ

35
00:03:25,200 --> 00:03:28,250
...ينبغي أن نكون قادرين على تولّي هذا العدد

36
00:03:28,750 --> 00:03:30,790
باستثناء ميستوفارن

37
00:03:31,670 --> 00:03:35,290
هيونكل، أنا متأكّدة بأنّك لم تنسَ

38
00:03:35,460 --> 00:03:41,510
هل ستشرب الهالة الشيطانيّة في هذا
الكأس وتخدمني أم لا؟

39
00:03:42,880 --> 00:03:44,340
ماذا تختار؟

40
00:03:44,510 --> 00:03:47,060
!إذا أردت إجابة، فحرّرني إذاً

41
00:03:49,430 --> 00:03:50,770
لكَ ذلك

42
00:03:57,400 --> 00:04:00,940
تذكّر، حالما تشرب هذا، ينتهي الأمر

43
00:04:01,110 --> 00:04:04,990
ستكون قد بعتَ روحك للشيطان ثانية

44
00:04:07,330 --> 00:04:09,700
!لا تفعلها يا هيونكل

45
00:04:12,960 --> 00:04:16,670
!هيونكل

46
00:04:18,090 --> 00:04:19,760
...كروكوداين

47
00:04:19,920 --> 00:04:24,630
لا تنسَ... ما قلتُه لك... أرجوك

48
00:04:50,450 --> 00:04:53,210
هيونكل، أعرفك

49
00:04:53,370 --> 00:04:58,710
أنا متأكّد بأنّك فكّرتَ بأنّك ستتظاهر
بالاستسلام كطريقة لخداعي

50
00:04:58,880 --> 00:05:03,920
مع الأسف، هالتي الشّيطانيّة لا يسهل قهرها

51
00:05:04,090 --> 00:05:09,140
مهما كانت نيّتك، أنت تنتمي لي الآن

52
00:05:27,700 --> 00:05:31,330
!ما الّذي يجري؟! ماذا حدث للسيّد هيونكل؟

53
00:05:31,490 --> 00:05:35,750
!شربَ من ذلك الكأس الغريب فتغيّر تماماً

54
00:05:36,580 --> 00:05:37,920
!إنّها هالة شيطانيّة

55
00:05:38,080 --> 00:05:39,130
!ماذا؟

56
00:05:39,290 --> 00:05:42,460
!أشعر بوجود شرّير من هيونكل

57
00:05:42,630 --> 00:05:46,050
!إنّه متأثّر غالباً بهالة العدوّ الشيطانيّة

58
00:05:47,010 --> 00:05:50,550
!قبلَ أن يتملّكه الشرّ؟

59
00:05:50,850 --> 00:05:53,680
!كيف لتلميذ أفان أن يفعل ذلك؟

60
00:05:59,350 --> 00:06:00,610
!هيونكل

61
00:06:01,110 --> 00:06:03,110
شعور جميل، أليس كذلك؟

62
00:06:03,280 --> 00:06:05,860
،إذا قيلَ لك أن تقطع رأس أحد

63
00:06:06,030 --> 00:06:10,820
فإنّك تشعر برغبة في فعلها بسهولة
كما لو أنّك تقطف زهرة، صحيح؟

64
00:06:13,660 --> 00:06:15,040
كما ينبغي لك

65
00:06:15,200 --> 00:06:18,620
أخيراً عدتَ إلى حيث تنتمي

66
00:06:18,790 --> 00:06:24,420
كفاك سخافة! مُحال أن يفقد قلبه
!الصّالح بهذه السّهولة

67
00:06:24,590 --> 00:06:26,340
كروكوداين

68
00:06:26,510 --> 00:06:30,760
لديك القدرة على التحكّم بالهالة أيضاً
ولو كان ذلك بشكل محدود

69
00:06:30,930 --> 00:06:34,100
ألا تشعر بها بالنّظر إليه؟

70
00:06:35,310 --> 00:06:38,140
!لا أستطيع الشّعور بهالة نوره

71
00:06:38,310 --> 00:06:42,270
!إنّه مُطوّق تماماً بهالة شيطانيّة

72
00:06:43,520 --> 00:06:48,570
حـ-حتّى الآن، آخر بقايا هالة النّور
!الخاصّة بهيونكل تُستهلَك

73
00:06:51,360 --> 00:06:56,620
يبدو أنّه استهان بهالتي الشيطانيّة

74
00:06:56,790 --> 00:07:00,620
،ظنَّ بأنّه إذا تظاهر بالاستسلام وقبلَ هالتي

75
00:07:00,790 --> 00:07:05,210
يستطيع حينئذ التغلّب عليها بهالة النّور خاصّته

76
00:07:05,800 --> 00:07:07,340
!يا له من أحمق

77
00:07:07,510 --> 00:07:12,090
!هناك أشياء في العالم لا يمكن التغلّب عليها

78
00:07:12,260 --> 00:07:15,060
!لا حدود لقوّة الظلام

79
00:07:18,270 --> 00:07:22,690
...هيونكل، يبدو أنّ رهانك الأخير

80
00:07:22,850 --> 00:07:25,360
انتهى بالفشل

81
00:07:27,730 --> 00:07:31,950
لا تزال فاتر الهمّة على ما يبدو يا هيونكل

82
00:07:32,110 --> 00:07:36,620
شفَتْ قوّةُ الظّلام جراحك

83
00:07:36,790 --> 00:07:42,830
سببُ هذا الخمول هو لأنّك ما زلت
تحتفظ بذرّة وعي

84
00:07:43,000 --> 00:07:47,250
دعني أخبرك كيف تصبح محارباً كاملاً ثانية

85
00:07:48,380 --> 00:07:50,970
خذ هذا واعدم كروكوداين

86
00:07:53,590 --> 00:07:58,220
إنّ قتل صديق سابق سيخمد وعيك

87
00:07:58,930 --> 00:08:05,440
ستفقد هالة النّور خاصّتك وتصبح من جديد
سيّاف الشّيطان الشرّير الحقيقيّ

88
00:08:06,310 --> 00:08:08,230
!افعلها الآن

89
00:08:13,780 --> 00:08:14,950
!هيونكل

90
00:08:22,370 --> 00:08:24,790
!لا! لا يجوز أن تخرجي إلى هناك بعد

91
00:08:24,960 --> 00:08:26,880
!...لكن هيونكل

92
00:08:27,040 --> 00:08:29,000
!نعلم ذلك

93
00:08:29,170 --> 00:08:33,760
لا يُفترض أن نندفع ما لم يُنقذ داي
!والآخران ذلكما الاثنين

94
00:08:34,130 --> 00:08:37,640
!لا يستطيعون إنقاذهما هكذا

95
00:08:39,600 --> 00:08:40,390
!تبّاً

96
00:08:45,600 --> 00:08:50,650
!ماذا يمكنني أن أفعل؟! هيونكل عدوّ الآن

97
00:08:51,360 --> 00:08:52,150
!لحظة

98
00:08:52,570 --> 00:08:54,070
كروكوداين

99
00:08:54,700 --> 00:08:57,240
...إذا كنت تعتبرني صديقاً

100
00:08:57,410 --> 00:09:00,580
أريدك أن تثق بي مهما كلّف الأمر

101
00:09:04,710 --> 00:09:08,790
!هذا صحيح! ما زال يكافح

102
00:09:08,960 --> 00:09:12,760
!هناك معركة يائسة تستعرّ داخله

103
00:09:13,170 --> 00:09:14,630
...عليّ

104
00:09:14,920 --> 00:09:18,260
!عليّ أن أؤمن به

105
00:09:19,010 --> 00:09:21,600
!هيونكل! تماسك

106
00:09:21,770 --> 00:09:23,680
!لا تدع هالة الشّيطان تستحوذ عليك

107
00:09:24,730 --> 00:09:28,860
!ما الأمر؟ اقتله! اقتله

108
00:09:31,230 --> 00:09:33,490
!أؤمن بك

109
00:09:33,650 --> 00:09:39,320
!حتّى لو قُطِّعتُ إلى أشلاء، سأؤمن بك حتّى آخر لحظة

110
00:09:40,870 --> 00:09:44,500
!لذا كافح! كافح ذلك الشرّ الّذي داخلك

111
00:09:44,660 --> 00:09:48,830
!اقتله يا هيونكل! لا تصغِ لهرائه

112
00:09:49,000 --> 00:09:51,130
!هيونكل

113
00:10:01,930 --> 00:10:03,010
!ماذا؟

114
00:10:17,490 --> 00:10:18,740
!هيونكل

115
00:10:21,120 --> 00:10:23,910
لقد... مات

116
00:10:31,380 --> 00:10:33,590
يا للأحمق

117
00:10:33,750 --> 00:10:38,470
لو قبلتَ الأمر فحسب، لعدتَ إلى جيش الشّياطين

118
00:10:38,630 --> 00:10:42,850
،لم يستطع تحمّل الهالتين المُتشابكتين
ما أدّى إلى مقتله

119
00:10:44,680 --> 00:10:48,350
!اختفت طاقة حياة هيونكل

120
00:10:50,400 --> 00:10:56,440
والآن لم يعد بمقدورنا جمع تلاميذ أفان الخمسة

121
00:10:56,610 --> 00:11:00,990
!ماذا يفعل داي؟! انتظرتُ طويلاً بما يكفي

122
00:11:02,120 --> 00:11:04,280
!ماذا تفعل؟! أفلتني

123
00:11:04,450 --> 00:11:06,370
ألا تفهم يا فتى؟

124
00:11:06,870 --> 00:11:11,960
سبب عدم ظهورهم هو لأنّهم يفهمون هيونكل

125
00:11:12,130 --> 00:11:12,960
ماذا؟

126
00:11:13,130 --> 00:11:15,250
هذا هو طبعه فحسب

127
00:11:15,420 --> 00:11:19,470
الحياة بحدّ ذاتها ليست إلّا سلاح
إضافيّ يستخدمه

128
00:11:20,970 --> 00:11:23,800
هذا مُخيّب، لكن فليكُن ذلك

129
00:11:24,350 --> 00:11:27,520
دعني أمنحك صديقاً يرافقك إلى الحياة الآخرة

130
00:11:29,770 --> 00:11:31,100
!هيونكل

131
00:11:36,270 --> 00:11:38,860
!ما-ماذا؟

132
00:11:39,400 --> 00:11:40,900
!مستحيل

133
00:11:41,530 --> 00:11:46,080
أشعر براحة كبيرة حقّاً يا ميستوفارن

134
00:11:46,530 --> 00:11:52,040
الآن أشعر بأنّني أستطيع قطع رأسك بسهولة

135
00:11:53,630 --> 00:11:55,080
...كما لو أنّني

136
00:11:59,210 --> 00:12:01,670
!أقطف زهرة

137
00:12:13,100 --> 00:12:14,770
...هيونكل

138
00:12:14,940 --> 00:12:16,190
!لقد عاد

139
00:12:16,360 --> 00:12:21,740
مستحيل! أنا متأكّد بأنّني شعرتُ
!بأنّ طاقة حياتك تختفي

140
00:12:21,900 --> 00:12:23,490
!كيف لا تزال حيّاً؟

141
00:12:23,660 --> 00:12:25,370
المسألة بسيطة جدّاً

142
00:12:26,490 --> 00:12:30,410
كانت هالتان مُتعارضتان تتصارعان داخلي

143
00:12:30,580 --> 00:12:31,790
...و

144
00:12:32,460 --> 00:12:34,290
!ربحَتْ إحداهما

145
00:12:34,460 --> 00:12:39,090
!ما شعرتَ به كان الهالة التي خسِرَتْ

146
00:12:41,380 --> 00:12:42,510
!مستحيل

147
00:12:56,350 --> 00:12:57,650
!هيونكل

148
00:12:57,810 --> 00:13:02,070
أهذا مُمكن؟! لماذا هالة نورك قويّة
!إلى هذه الدّرجة؟

149
00:13:02,240 --> 00:13:09,160
لا أنكر بأنّ هالة نوري قُمِعَتْ بواسطة
هالتك الشّيطانيّة

150
00:13:09,330 --> 00:13:14,830
وقُهِرَتْ بواسطة قوّتك الشرّيرة فكانت تُخمَد تقريباً

151
00:13:15,330 --> 00:13:20,500
!لكن نتيجة ذلك، ازدادت هالة نوري قوّة

152
00:13:20,920 --> 00:13:26,470
رغبتي في عدم الاستسلام للشرّ جعلَتْ
!هالة نوري أكثر قوّة حتّى

153
00:13:26,630 --> 00:13:30,260
!وبالمقابل، قمعَتْ هالتك الشيطانيّة

154
00:13:30,680 --> 00:13:34,730
!كيف تجرؤ؟! كانت تلك نيّتك منذ البداية

155
00:13:34,890 --> 00:13:39,940
استغللتَ هالتي الشّيطانيّة لتساهم
!في تعزيز قوّتك الخاصّة

156
00:13:40,770 --> 00:13:46,900
أخبرتَني ذات مرّة بأنّ التخلّي عن هالتي
الظلاميّة جعلَني أضعف

157
00:13:47,240 --> 00:13:52,120
لكن لم يكن ذلك لأنّني لم أستطع استخدام
!كلتا القوّتين المُتعارضتين في آن واحد

158
00:13:52,950 --> 00:13:57,500
عندما كنتُ شرّيراً، كرهتُ قوّة النّور
التي كان أفان قد منحني إيّاها

159
00:13:57,670 --> 00:14:01,960
عندما كنتُ خيّراً، سعيتُ للتغلّب على
قوّة الظّلام في داخلي

160
00:14:02,130 --> 00:14:05,510
!أدّى هذا للتعزيز السّريع لكلتَي الهالتين

161
00:14:06,130 --> 00:14:09,140
عندما قلتَ لي أن أقبل قوّتك الشّيطانيّة

162
00:14:09,300 --> 00:14:15,560
اعتبرتُها فُرصة أخيرة لأتألّق أكثر
!حتّى من ذي قبل

163
00:14:15,730 --> 00:14:16,810
!هذا كلام فارغ

164
00:14:16,980 --> 00:14:23,650
!أتعني بأنّ هالة نورك قد قمعَتْ هالتي الشّيطانيّة؟

165
00:14:23,820 --> 00:14:26,990
!من غير الممكن أن تستطيع فعل ذلك

166
00:14:27,150 --> 00:14:29,610
أنا متأكّد بأنّك شعرت بها سلفاً

167
00:14:29,780 --> 00:14:35,240
الهالة الشّيطانيّة داخلي والّتي غُلِّفَتْ
!بشكل كامل بواسطة هالة نوري

168
00:14:39,420 --> 00:14:41,750
!اصمت

169
00:15:02,150 --> 00:15:04,520
!يقضي على المُدرّعين وهو أعزل؟

170
00:15:11,950 --> 00:15:12,950
!مذهل

171
00:15:13,120 --> 00:15:14,780
إنّها قوّة الهالة

172
00:15:14,950 --> 00:15:15,620
!ماذا؟

173
00:15:15,790 --> 00:15:20,080
هالته الّتي تفيض جعلَتْ جسده أقسى من الفولاذ

174
00:15:20,250 --> 00:15:24,710
يبدو أنّ قوّته تعزّزت إلى ما يفوق الخيال

175
00:15:24,880 --> 00:15:28,210
هل كنت تعلم بأنّ هذه خطّة هيونكل من البداية؟

176
00:15:28,380 --> 00:15:29,420
تماماً

177
00:15:29,590 --> 00:15:34,350
كانت مُجازفة خطيرة، لكنّها أفلحت لحسنّ الحظّ

178
00:15:34,510 --> 00:15:37,600
أنا متأكّد بأنّهم يعتقدون ذلك أيضاً

179
00:15:37,770 --> 00:15:40,390
من هم؟

180
00:15:40,850 --> 00:15:42,520
...كيف تجرؤ

181
00:15:42,690 --> 00:15:47,530
!كيف تجرؤ... لا يُمكن لوجهي أن يُمَسّ

182
00:15:48,900 --> 00:15:52,950
!عجيب أمرك، دائماً ما تضغط على نفسك لأقصى الحدود

183
00:15:53,110 --> 00:15:57,030
!كيف تنوي أن تعوّض عن خوفي الشّديد عليك؟

184
00:15:57,200 --> 00:16:01,960
كروكوداين، سأتولّى أمر هؤلاء وأخرجك من هنا

185
00:16:02,120 --> 00:16:05,040
!كيف تجرؤ؟

186
00:16:05,210 --> 00:16:10,590
!سأمزّقكما إرباً هنا والآن

187
00:16:10,760 --> 00:16:12,510
أمزّقكما"؟"

188
00:16:12,930 --> 00:16:19,060
ميستوفارن، يبدو أنّ حواسك تضعف عندما تنفعل

189
00:16:38,120 --> 00:16:39,330
...د

190
00:16:42,540 --> 00:16:43,750
!داي

191
00:16:45,670 --> 00:16:47,750
ما زال حيّاً إذاً

192
00:16:47,920 --> 00:16:49,710
ماذا قلتُ لك؟

193
00:16:49,880 --> 00:16:53,670
تبصيري لا يخطئ

194
00:16:53,840 --> 00:16:55,970
أشعر بروح داخله

195
00:16:56,340 --> 00:16:59,810
وكأنّه شخص مختلف تماماً

196
00:17:02,560 --> 00:17:04,600
جدّدت عزيمتك؟

197
00:17:04,770 --> 00:17:05,770
!داي

198
00:17:11,110 --> 00:17:15,450
!بوب! مام! وحتّى الأميرة ليونا

199
00:17:17,070 --> 00:17:19,830
أتينا من تحت الأرض كما تفعل أيُّها الضّخم

200
00:17:19,990 --> 00:17:23,160
لكن ترتّب علينا استخدام سحري النّاري بدلاً من ذلك

201
00:17:23,330 --> 00:17:24,960
!دعوا هذا الأمر لي

202
00:17:33,090 --> 00:17:35,840
داي، أنا متفاجئ من أنّك لم تتسرّع

203
00:17:36,010 --> 00:17:38,220
عرفتُ فوراً

204
00:17:38,680 --> 00:17:44,480
شعرتُ بهالة النّور داخلك تزداد قوّة

205
00:17:45,140 --> 00:17:50,400
قلقنا في بادئ الأمر، لكن سرعان ما انتقلنا
!إلى هجوم من تحت الأرض

206
00:17:50,730 --> 00:17:53,230
هكذا إذاً. شكراً لك

207
00:17:53,400 --> 00:17:55,950
آمنت بي أيضاً

208
00:17:59,160 --> 00:18:04,160
لم يكن داي الوحيد الّذي آمن بك يا هيونكل

209
00:18:05,660 --> 00:18:06,830
...مام

210
00:18:07,000 --> 00:18:13,050
أردنا أن نهاجم في اللّحظة الّتي تملّكك الظّلام فيها

211
00:18:13,210 --> 00:18:15,380
لكنّها منعتنا

212
00:18:16,800 --> 00:18:21,680
لا يمكن أن يقبل هيونكل هالة شيطانيّة
لو لم يكن يعلم بأنّه يستطيع هزيمتها

213
00:18:22,180 --> 00:18:25,220
لنثق به ونرَ ما يحدث

214
00:18:26,390 --> 00:18:27,310
فهمت؟

215
00:18:27,480 --> 00:18:28,770
لكن كنتُ مُحقّة

216
00:18:28,940 --> 00:18:31,310
أجل. قطعتُ وعداً

217
00:18:31,480 --> 00:18:34,440
بأنّني لن أقاتل إلّا بقوّة النّور

218
00:18:37,780 --> 00:18:39,910
!ما زال بعضهم يستطيع القتال

219
00:18:46,000 --> 00:18:46,750
!نوفا

220
00:18:46,910 --> 00:18:49,370
!نفد صبرنا يا داي

221
00:18:49,540 --> 00:18:51,540
!الجميع جاهزون للانفجار

222
00:18:57,550 --> 00:18:59,380
!إنّه وقت اللّعب

223
00:18:59,550 --> 00:19:01,680
!هاجموا جميعكم

224
00:19:12,020 --> 00:19:14,690
!سنُشفي غليلنا بمُقاتلتهم

225
00:19:16,360 --> 00:19:19,490
لحظة، لماذا تتركون القتال لهم؟

226
00:19:19,990 --> 00:19:22,910
الأمر معقّد بعض الشيء

227
00:19:23,070 --> 00:19:26,450
هيونكل، أما زلت تمتلك شارة أفان؟

228
00:19:26,620 --> 00:19:27,500
بالطبع

229
00:19:28,120 --> 00:19:33,500
لن أتخلّى عنها ولو على جثّتي

230
00:19:34,210 --> 00:19:37,510
!أمسكها بيدك وركّز إرادتك

231
00:19:37,670 --> 00:19:40,670
أركّز... إرادتي؟

232
00:19:41,050 --> 00:19:43,050
هذا ليس أمراً صعباً

233
00:19:43,220 --> 00:19:48,890
فقط ركّز أفكارك على ما يمنحك الرّغبة في القتال

234
00:19:51,100 --> 00:19:54,020
!كم أنا بغيض

235
00:19:54,190 --> 00:19:59,150
لوهلة تمنّيتُ ألّا تتوهّج شارة هيونكل

236
00:19:59,320 --> 00:20:03,990
،وأنّه إذا لم يستطع هيونكل فعلها
سيمنحني ذلك بعض السّكينة

237
00:20:11,830 --> 00:20:14,460
!مذهل! شارة أفان تتوهّج

238
00:20:16,340 --> 00:20:20,050
!لا بدّ وأنّ الشّارة تستجيب لقدرة تحمّلك

239
00:20:20,760 --> 00:20:23,130
!جميعنا جاهزون الآن

240
00:20:23,470 --> 00:20:26,430
!لدينا خمسة تلاميذ وخمس شارات

241
00:20:26,600 --> 00:20:30,020
!تعويذة التّطهير العظيمة بريق جاهزة

242
00:20:38,480 --> 00:20:40,820
!اللّعنة عليك يا داي! اللّعنة عليك يا هيونكل

243
00:20:40,990 --> 00:20:45,160
!أذللتُماني مراراً

244
00:20:45,320 --> 00:20:48,160
ما الأمر يا ميستوفارن؟

245
00:20:48,330 --> 00:20:49,740
!ملك الشّيطان

246
00:20:49,910 --> 00:20:52,540
لماذا أنت غاضب جدّاً؟

247
00:20:52,710 --> 00:20:58,670
بقوّتك تستطيع إبادتهم جميعاً بسهولة

248
00:20:59,380 --> 00:21:05,760
ليس وكأنّ مقاومتهم ستُمكّنهم من الدّخول
إلى قصر فارن

249
00:21:06,550 --> 00:21:11,140
استغرق وقتك وأري أولئك الّذين يُقاومونني

250
00:21:11,310 --> 00:21:14,190
ماهيّة المُعاناة الحقيقيّة

251
00:21:14,350 --> 00:21:17,400
!أمرك! سامحني

252
00:21:18,150 --> 00:21:22,110
...كما أمرت، سوف أريك

253
00:21:22,280 --> 00:21:25,610
!مشهداً وهم يتعذّبون ألماً

254
00:21:25,780 --> 00:21:28,280
!سأمزّقكم إرباً إرباً

255
00:21:28,450 --> 00:21:30,950
!حقل هلاك هالة الدمى الشيطانية

256
00:21:34,960 --> 00:21:38,750
إنّهم مشغولون... بأمور أخرى

257
00:21:39,710 --> 00:21:42,170
لا يملكون وقتاً لك

258
00:21:44,920 --> 00:21:46,880
...إذا أردت اللّعب

259
00:21:47,050 --> 00:21:51,010
!فسألعب معك إذاً يا ميستوفارن

260
00:21:51,180 --> 00:21:53,350
!أ-أنت

261
00:22:07,150 --> 00:22:12,030
بصراحة كنتُ أخرق

262
00:22:12,200 --> 00:22:18,370
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

263
00:22:18,870 --> 00:22:23,840
وحتّى أنّني استخدمتُ الوحدة كسلاح

264
00:22:24,000 --> 00:22:29,760
بحثتُ في الدّيماس عن جواب بسيط

265
00:22:29,930 --> 00:22:35,600
حتّى لو تخلّيتُ عن الحقّ واللّطف

266
00:22:35,770 --> 00:22:41,730
أريد أن أكون موجوداً بجانبك فحسب

267
00:22:41,900 --> 00:22:47,360
أن أنادي باسمك

268
00:22:47,530 --> 00:22:53,370
هو أصعب من أي تعويذة سحريّة

269
00:22:53,530 --> 00:22:59,160
رغم أنّك مقرّب جدّاً منّي

270
00:22:59,330 --> 00:23:01,790
أحبّك

271
00:23:01,960 --> 00:23:05,090
أدركتُ ذلك أخيراً

272
00:23:05,250 --> 00:23:10,220
أن أنادي باسمك

273
00:23:10,380 --> 00:23:16,640
هو السّبب الّذي وُلدت لأجله

274
00:23:16,810 --> 00:23:22,560
سأتخلّص من هذا اللّيل الطويل

275
00:23:22,730 --> 00:23:25,270
وآتي لرؤيتك

276
00:23:25,440 --> 00:23:30,030
إلى حيث أنت الآن

277
00:23:33,660 --> 00:23:36,660
يجتمع تلاميذ أفان الخمسة أخيراً

278
00:23:36,830 --> 00:23:40,210
تبدأ طقوس بريق، وليونا في منتصفها

279
00:23:40,370 --> 00:23:44,460
يحاول ميستوفارن إيقاف التّعويذة، لكن
يُحبط لون بيروك مُحاولته

280
00:23:44,630 --> 00:23:49,970
يقاتل كروكوداين والآخرون لحماية
التّلاميذ الخمسة من جيش الشّياطين

281
00:23:50,130 --> 00:23:53,760
باعتماد الجميع عليهم، هل ستنجح
تعويذة التّطهير العظيمة؟

282
00:23:53,930 --> 00:23:56,180
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

283
00:23:58,060 --> 00:24:00,060
!وتستمرّ المغامرة