1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:50,650 --> 00:01:52,610
!ما هذا؟

20
00:01:54,320 --> 00:01:56,110
!هل هو حيّ؟

21
00:02:00,160 --> 00:02:01,200
!تبّاً

22
00:02:08,290 --> 00:02:09,460
!توقّف

23
00:02:09,630 --> 00:02:15,130
!توقّف! أنت! ما خطبك؟

24
00:02:16,260 --> 00:02:19,630
!توقّف! أرجوك

25
00:02:19,800 --> 00:02:20,680
!أنت

26
00:02:22,800 --> 00:02:25,180
!مـ-من تكون بالتّحديد؟

27
00:02:25,350 --> 00:02:27,640
!أنا داي! من تكون أنت؟

28
00:02:27,810 --> 00:02:30,190
!داي؟! أنت داي؟

29
00:02:32,520 --> 00:02:36,610
!أجبني! من تكون؟! ما ذلك الشيء؟

30
00:02:36,780 --> 00:02:38,820
!لماذا أمسكَ بليونا؟

31
00:02:40,070 --> 00:02:44,280
!لـ-لا أستطيع الإجابة على كلّ ذلك فوراً

32
00:02:50,040 --> 00:02:52,210
أنا غوروا الطبّال

33
00:02:52,710 --> 00:02:56,300
أشرف على قلب قصر فارن

34
00:02:57,630 --> 00:03:00,090
تقود قصر فارن من هنا؟

35
00:03:02,260 --> 00:03:06,060
!إذاً ما هذا الوحش؟! لماذا أخذ ليونا؟

36
00:03:06,220 --> 00:03:08,520
هذا ليس وحشاً

37
00:03:08,930 --> 00:03:12,020
،صحيح بأنّه يشبه كائناً حيّاً

38
00:03:12,190 --> 00:03:16,320
لكنّه مفاعل قوّة شيطانيّة نصفها آليّ

39
00:03:17,900 --> 00:03:20,490
لحظة. أيتحكّم هذا بقصر فارن؟

40
00:03:20,650 --> 00:03:21,950
تماماً

41
00:03:22,110 --> 00:03:27,080
مفاعل القوّة الشيطانيّة هو القلب
الّذي يقود قصر فارن

42
00:03:27,990 --> 00:03:32,290
مفاعل القوّة الشيطانيّة يسحب قوّتي السحريّة

43
00:03:32,460 --> 00:03:36,670
وينقلها عبر كافّة أرجاء قصر فارن

44
00:03:36,840 --> 00:03:39,550
...إنّه مُحرّك حيّ. لكن

45
00:03:40,260 --> 00:03:44,680
،بسبب تلك التّعويذة التي تطلقها الفتاة، بريق

46
00:03:44,850 --> 00:03:49,770
فقدَ القدرة على سحب قوّتي السحريّة

47
00:03:50,730 --> 00:03:55,480
خرجَ عن السّيطرة بسبب تعطّشه للقوّة السحريّة

48
00:03:55,650 --> 00:04:01,950
لهذا بسطَ مفاعل القوّة الشيطانيّة
لوامسه بحثاً عن القوّة السحريّة

49
00:04:02,610 --> 00:04:06,490
لهذا استهدفَ ليونا بسبب قوّتها السحريّة المرتفعة؟

50
00:04:07,200 --> 00:04:11,200
لكن... أنا وبوب هنا أيضاً

51
00:04:12,330 --> 00:04:15,880
!فهمت! ريش المُعلّم أفان

52
00:04:16,590 --> 00:04:22,510
برحيل المعلّم أفان، تمتلك ليونا حاليّاً
!مصدر القوّة السحريّة الأعظم

53
00:04:24,010 --> 00:04:27,010
ليونا! هذا الشيء ينجذب للقوّة السحريّة

54
00:04:27,180 --> 00:04:30,390
!الخاصّة بالرّيش الّذي أعطاكِ إيّاه المُعلّم

55
00:04:30,560 --> 00:04:32,930
!حاولي إسقاط الرّيش كلّه

56
00:04:33,810 --> 00:04:36,400
!لا أستطيع! لا يمكنني الحركة

57
00:04:44,110 --> 00:04:46,990
!اللّعنة! عليّ تدميره

58
00:04:47,160 --> 00:04:51,160
!إذا فعلت ذلك، فسيُعاقبني الملك فارن

59
00:04:51,330 --> 00:04:53,620
!إذاً أوقف هذا الشّيء

60
00:04:53,790 --> 00:04:55,330
!أحاول ذلك

61
00:04:55,870 --> 00:05:00,130
،من أجل التحكّم بمفاعل القوّة الشيطانيّة

62
00:05:00,300 --> 00:05:04,420
!منحَني الملك فارن قوّة التحكّم بالجاذبيّة الهائلة

63
00:05:05,050 --> 00:05:07,890
!أنا أستخدمها في هذه اللّحظة

64
00:05:08,350 --> 00:05:10,470
!لكنّه لا يتوقّف إطلاقاً

65
00:05:10,640 --> 00:05:13,850
هذه دلالة على مدى هيَجان مفاعل
!القوّة الشيطانيّة

66
00:05:14,020 --> 00:05:19,230
!إذا أوقفتُ نبض الجاذبيّة من معدتي، ينتهي الأمر

67
00:05:19,730 --> 00:05:23,570
ستؤكَل تلك الفتاة بواسطة مفاعل
!القوّة الشيطانيّة وتموت

68
00:05:24,440 --> 00:05:30,990
في العادة، أيّ مخلوق يُمسَك به
!بواسطة تلك اللّوامس يتمّ امتصاصه

69
00:05:31,160 --> 00:05:34,750
!ينبغي لك أن تشكرني فعليّاً

70
00:05:36,000 --> 00:05:38,290
!انسَ الأمر! سوف أفعلها أنا

71
00:05:45,010 --> 00:05:45,760
!داي

72
00:05:46,720 --> 00:05:49,550
!ماذا كان ذلك؟! إنّه أشبه بجدار خفيّ

73
00:05:50,180 --> 00:05:51,640
!ابتعد عن طريقي

74
00:05:55,100 --> 00:05:58,310
يبدو قويّاً جدّاً

75
00:05:58,730 --> 00:06:01,570
على هذا المُعدّل، سيُدمّر مفاعل القوّة الشيطانيّة

76
00:06:01,730 --> 00:06:06,030
!إذا حدث ذلك، سوف يعدمني الملك فارن حتماً

77
00:06:06,820 --> 00:06:07,860
...وجدتُها

78
00:06:14,740 --> 00:06:17,710
!هذا سيّئ! لا شيء يفلح

79
00:06:17,870 --> 00:06:21,540
...في هذه الحالة، هناك خطورة على ليونا

80
00:06:23,210 --> 00:06:26,260
لكن يترتّب عليّ قطعه إلى نصفين
!بواسطة أفان ستراش

81
00:06:26,670 --> 00:06:27,970
!ليونا

82
00:06:28,130 --> 00:06:30,010
!سأخرجكِ من هناك

83
00:06:30,720 --> 00:06:32,140
!...أفان

84
00:06:41,650 --> 00:06:43,190
!ما الّذي يجري؟

85
00:06:43,360 --> 00:06:45,360
!أشعر بثِقل كبير

86
00:06:46,990 --> 00:06:52,030
آسف، لكن أصبتُك بنبض الجاذبيّة

87
00:06:52,370 --> 00:06:57,370
بالتفكير في الأمر الآن، لستُ مُلزماً
بمساعدة تلك الفتاة

88
00:06:57,540 --> 00:07:02,080
!إذا كنتُ أستطيع قتل البطل، سأُكافَا على إنجازي

89
00:07:02,250 --> 00:07:05,670
!إنّها فُرصتي للخروج من حياة القاع

90
00:07:06,960 --> 00:07:11,090
!...يا للهول! إذا كان يوجّه نبض الجاذبيّة نحوي

91
00:07:14,050 --> 00:07:15,140
!داي

92
00:07:15,930 --> 00:07:17,600
!ليونا

93
00:07:22,730 --> 00:07:24,230
!ليونا

94
00:07:28,940 --> 00:07:31,490
!تبّاً

95
00:07:32,110 --> 00:07:35,280
...أنت قويّ جدّاً. لكن

96
00:07:39,000 --> 00:07:45,500
كُلِّفت بمهمّة إحكام السّيطرة على
مفاعل القوّة الشيطانيّة العملاق ذاك

97
00:07:45,670 --> 00:07:49,380
!لا تستطيع قوّتك هزيمة قوّتي

98
00:07:49,550 --> 00:07:51,220
!تبّاً

99
00:07:51,380 --> 00:07:56,640
على ذكرِ ذلك، كيف يُفترض بي القضاء عليه؟

100
00:08:00,310 --> 00:08:02,520
!وجدتُها

101
00:08:02,690 --> 00:08:07,230
!اللّعنة! انهض! انهض

102
00:08:07,400 --> 00:08:12,070
...أسرع وإلّا ليونا سوف... ليونا سوف

103
00:08:12,950 --> 00:08:14,990
!فات الأوان

104
00:08:15,160 --> 00:08:20,660
لن يستغرق امتصاصها وموتها
!إلّا بضع ثوانٍ إضافيّة

105
00:08:21,580 --> 00:08:27,250
وإذا طعنتُك بهذا السّيف، حتّى
!أنت لن تستطيع النّجاة

106
00:08:27,840 --> 00:08:32,840
!إذا هزمتُ البطل، سوف يثني عليّ الملك فارن

107
00:08:33,010 --> 00:08:36,970
!أستطيع فعل أيّ شيء إذا عزمتُ عليه

108
00:08:39,510 --> 00:08:43,020
أن يُقتَل بواسطة ضعيف صاغر مثل غوروا

109
00:08:43,180 --> 00:08:46,440
...قبل لحظات من المعركة الأخيرة

110
00:08:47,110 --> 00:08:51,110
هذه نهاية مأساويّة جدّاً بالنسبة لبطل

111
00:08:52,900 --> 00:08:53,820
لا

112
00:08:54,530 --> 00:08:57,660
لم ينتهِ الأمر بعد

113
00:08:57,820 --> 00:09:00,240
...والآن، بهذا

114
00:09:00,410 --> 00:09:04,210
!ينتهي أمرك

115
00:09:13,510 --> 00:09:16,380
!ما زلت تحاول المُقاومة؟

116
00:09:16,550 --> 00:09:18,850
!اثبت مكانك ومُت فحسب

117
00:09:21,310 --> 00:09:23,430
!اللّعنة

118
00:09:29,610 --> 00:09:34,190
...اللّعنة... شعار التنّين

119
00:09:34,530 --> 00:09:37,610
...هل هذه... هل هذه حقّاً

120
00:09:37,780 --> 00:09:41,120
!كلّ القوّة التي أمتلكها؟

121
00:09:41,280 --> 00:09:44,950
!حتّى بينما أستهلك كلّ ما يوجد داخلي؟

122
00:09:46,960 --> 00:09:50,460
!أهذا كلّ ما يستطيع فارس تنّين فعله؟

123
00:09:51,630 --> 00:09:57,680
!هل فرسان التنّين... بهذا الضّعف حقّاً؟

124
00:09:57,840 --> 00:10:01,930
!أريد أن أحمي شخصاً يهمّني أمره

125
00:10:02,100 --> 00:10:05,350
!ألا أمتلك القوّة لفعل ذلك؟

126
00:10:07,310 --> 00:10:12,020
دموع الإحباط. لكنّها ليست غلطتك

127
00:10:12,190 --> 00:10:14,530
!كلّ ما في الأمر هو أنّني أذكى

128
00:10:14,860 --> 00:10:18,740
!والآن مُت بواسطة سيفك

129
00:10:18,910 --> 00:10:22,330
!وداعاً

130
00:10:38,470 --> 00:10:39,630
!أبي؟

131
00:10:49,100 --> 00:10:50,600
...هذا

132
00:10:51,690 --> 00:10:54,820
!عندما ماتت أمّي؟

133
00:10:55,780 --> 00:10:57,690
!سوالا

134
00:11:00,110 --> 00:11:04,660
حياة فارس التنّين هي حياة معركة لا تنتهي

135
00:11:08,620 --> 00:11:09,830
!أبي

136
00:11:11,500 --> 00:11:14,340
...سلوك هذا الطريق الدمويّ

137
00:11:15,170 --> 00:11:20,010
يبدو أنّ الكثير من النّساء عانت من نهاية مأساويّة

138
00:11:20,340 --> 00:11:24,350
مع الأسف، كانت أمّك من بينهن

139
00:11:26,810 --> 00:11:27,810
...لكن

140
00:11:27,970 --> 00:11:31,600
أيّاً كان الماضي، تبقى أنت هو أنت

141
00:11:32,400 --> 00:11:34,190
...بيديك

142
00:11:34,360 --> 00:11:40,150
تأكّد ما إن كنت تستطيع إنهاء المصير
المُحزّن لفُرسان التنّين يا داي

143
00:11:41,950 --> 00:11:45,160
!تذكّر عندما أنقذتَ ليونا أوّل مرّة

144
00:11:45,660 --> 00:11:49,290
!أنت لست فارس تنّين عاديّاً

145
00:11:49,660 --> 00:11:55,340
!أنت تحمل روحي. أنت فارس خارق جديد

146
00:11:55,630 --> 00:11:59,170
!قِف! انهض يا داي

147
00:12:02,130 --> 00:12:03,340
!أبي

148
00:12:06,050 --> 00:12:07,390
!هذا صحيح

149
00:12:07,760 --> 00:12:12,770
كانت أوّل مرّة يستيقظ فيها شعاري
!هي عندما أنقذتُ ليونا

150
00:12:13,390 --> 00:12:14,940
!استخرجها

151
00:12:15,100 --> 00:12:19,780
!تلك القوّة المجهولة داخلي! كما في ذلك الوقت

152
00:12:20,320 --> 00:12:23,740
...قوّتي وقوّة أبي

153
00:12:26,570 --> 00:12:31,120
!أكبر من هذا بكثير

154
00:12:37,380 --> 00:12:39,050
!ما هذا؟

155
00:13:02,650 --> 00:13:06,280
!...هـ-هذا

156
00:13:13,540 --> 00:13:18,250
!شعار تنّين... في كلّ قبضة؟

157
00:13:18,630 --> 00:13:20,710
...القوّة في يدي اليسرى

158
00:13:21,710 --> 00:13:23,090
!هي قوّة أبي

159
00:13:23,630 --> 00:13:25,930
سأكون معك

160
00:13:27,050 --> 00:13:29,260
في المعركة المقبلة

161
00:13:30,050 --> 00:13:33,470
،سنكون معاً دوماً

162
00:13:34,430 --> 00:13:36,440
لا نفترق أبداً

163
00:13:36,890 --> 00:13:41,570
!في ذل كالوقت، قوّة تاج أبي دخلَتْني

164
00:13:41,860 --> 00:13:46,280
!لهذا رأيتُ أمّي، رغم أنّني لم ألتقِ بها أبداً

165
00:13:46,740 --> 00:13:49,910
!كانت روح أبي تُطمئنني

166
00:13:50,410 --> 00:13:53,950
!داخلي... طوال هذا الوقت

167
00:13:54,120 --> 00:13:56,210
!لطالما كان أبي موجوداً

168
00:13:59,880 --> 00:14:03,420
هكذا إذاً. قوّة باران

169
00:14:03,590 --> 00:14:06,170
شعارا تنّين

170
00:14:06,840 --> 00:14:10,510
!إنّهما... شعارا تنّين توأمان

171
00:14:11,890 --> 00:14:14,020
!اللّعنة

172
00:14:23,940 --> 00:14:26,940
!نبض الجاذبيّة خاصّتي لا يفلح

173
00:14:34,120 --> 00:14:36,330
!وميض الشّعار

174
00:14:57,390 --> 00:15:00,270
!...حتّى حاجز مفاعل القوّة الشيطانيّة

175
00:16:42,750 --> 00:16:46,130
شعارا التنّين التوأمان يشكّلان خطراً

176
00:16:47,000 --> 00:16:49,920
ما يُنذِر بحاصِد أرواح

177
00:16:50,760 --> 00:16:55,640
دائماً ما تتحقّق التكهّنات بصورة سيّئة

178
00:16:56,300 --> 00:16:57,550
!ليونا

179
00:16:59,390 --> 00:17:00,680
...لا

180
00:17:01,560 --> 00:17:03,140
!هل تأخّرتُ كثيراً؟

181
00:17:14,610 --> 00:17:16,240
!هذا جيّد

182
00:17:17,780 --> 00:17:19,240
!إنّها بخير

183
00:17:22,160 --> 00:17:27,420
قد تكون ملابسها مُمزّقة، لكنّها سليمة تماماً

184
00:17:31,210 --> 00:17:32,840
!ليونا، استيقظي

185
00:17:35,010 --> 00:17:36,260
...داي

186
00:17:39,100 --> 00:17:40,350
...أنا

187
00:17:40,510 --> 00:17:41,930
أنتِ بخير

188
00:17:42,100 --> 00:17:48,850
قال غوروا بأنّ ذلك الشيء سيمتصّ
جسدكِ، لذا كنتُ قلقاً جدّاً

189
00:17:49,730 --> 00:17:52,110
اهتممت بالأمر، أليس كذلك؟

190
00:17:53,730 --> 00:17:54,820
!شكراً لك

191
00:17:55,280 --> 00:17:58,030
لكن ملابسي مهترئة

192
00:17:58,200 --> 00:18:02,700
وعندما تمَّ الإمساك بي أوّل مرّة، شعرتُ بوهن

193
00:18:02,870 --> 00:18:08,500
مفاعل القوّة الشيطانيّة يمتصّ القوّة
السحريّة من المخلوقات فعلاً

194
00:18:09,500 --> 00:18:10,710
لذا كيف...؟

195
00:18:10,880 --> 00:18:11,790
لا أدري

196
00:18:15,670 --> 00:18:18,510
داي، هل يمكنك أن تستدير؟

197
00:18:18,880 --> 00:18:20,180
لماذا؟

198
00:18:20,340 --> 00:18:21,720
!استدِر بسرعة فحسب

199
00:18:21,890 --> 00:18:23,430
!حـ-حسناً

200
00:18:26,980 --> 00:18:28,060
!داي

201
00:18:31,610 --> 00:18:33,860
!انكمشَ غوميتشان؟

202
00:18:36,030 --> 00:18:38,280
كان غوميتشان داخل ملابسي

203
00:18:38,450 --> 00:18:40,660
!داخل ملابسكِ؟! أين في الدّاخل؟

204
00:18:41,240 --> 00:18:43,580
!لـ-لا يهمّ أين

205
00:18:45,200 --> 00:18:47,790
لا بدّ وأنَّ غوميتشان قد حماني

206
00:18:48,960 --> 00:18:52,500
،ربّما عندما كنتُ داخل مفاعل القوّة الشيطانيّة

207
00:18:52,670 --> 00:18:56,260
كان غوميتشان يبعث قوّة سحريّة طوال الوقت

208
00:18:56,420 --> 00:18:59,930
هذا ما حماني من الامتصاص

209
00:19:00,090 --> 00:19:02,890
هذا ما سبّبَ الانكماش؟

210
00:19:04,180 --> 00:19:09,850
لكن ساعدَنا فوميتشان في معارك
عديدة حتّى الآن

211
00:19:10,270 --> 00:19:13,060
هل يمتلك غوميتشان قوّة غامضة؟

212
00:19:13,690 --> 00:19:16,480
،شفاء لياقة داي

213
00:19:16,650 --> 00:19:20,820
وانتشال بوب من شفير الموت

214
00:19:20,990 --> 00:19:24,160
ومع تشيو، الهجوم بجسدٍ مُتصلِّب

215
00:19:25,120 --> 00:19:27,870
وبالنسبة لي، بعث قوّة سحريّة

216
00:19:29,120 --> 00:19:32,080
ما هي قوّة غوميتشان الحقيقيّة بالضبط؟

217
00:19:35,090 --> 00:19:36,710
لننسَ الأمر

218
00:19:37,090 --> 00:19:40,090
دعنا لا نسأل عن الشّخص الّذي أنقذ أرواحنا

219
00:19:40,760 --> 00:19:45,050
فضلاً عن ذلك، غوميتشان ظريف بهذا الحجم الصّغير

220
00:19:45,680 --> 00:19:49,350
لندع غوميتشان يرتاح حاليّاً

221
00:19:52,440 --> 00:19:54,190
!قلتُ لا تنظر

222
00:19:55,230 --> 00:19:58,860
!أردتُ فقط معرفة أين سيُوضَع غوميتشان بالضبط

223
00:20:05,700 --> 00:20:06,780
!غوروا؟

224
00:20:07,410 --> 00:20:10,450
!لم تتركا لي خياراً

225
00:20:11,000 --> 00:20:15,460
سوف أصبُّ كلّ قوّتي السحريّة
داخل مفاعل القوّة الشيطانيّة

226
00:20:15,630 --> 00:20:17,920
!وأسقطكما معي

227
00:20:18,090 --> 00:20:19,880
!توقّف! لن يفلح هذا

228
00:20:20,050 --> 00:20:22,510
!لا أملك أيّ خيار آخر

229
00:20:22,680 --> 00:20:26,220
!أقسم بأنّني سأدمّركما

230
00:20:26,390 --> 00:20:27,850
يكفي

231
00:20:28,600 --> 00:20:30,100
!الملك فارن؟

232
00:20:30,270 --> 00:20:32,020
هذا يكفي

233
00:20:32,350 --> 00:20:37,730
،حتّى لو ضاعت قوّة المفاعل الشيطانيّة
لن أحمّلك المسؤوليّة

234
00:20:38,150 --> 00:20:44,240
يبدو أنّ عجلات القدر العظيم قد اصطفّت مع البطل

235
00:20:45,240 --> 00:20:49,030
،لو صعدَ برج السّيادة دون مصاعب

236
00:20:49,200 --> 00:20:52,750
ما كان داي ليشكّل خطراً عليّ

237
00:20:53,080 --> 00:20:57,670
هناك مفاعل قوّة شيطانيّة أخرى في العالم السُّفلي

238
00:20:57,840 --> 00:21:00,710
!لا تستفزّ داي أكثر

239
00:21:02,050 --> 00:21:05,010
...قد يكون أمراً منك يا جلالة الملك فارن

240
00:21:05,340 --> 00:21:10,180
!لكن لا أستطيع التّراجع الآن

241
00:21:10,970 --> 00:21:12,680
!ليونا، تراجعي

242
00:21:15,190 --> 00:21:17,480
!شعارا تنّين؟

243
00:21:21,900 --> 00:21:23,440
!هذه الوضعيّة

244
00:21:24,320 --> 00:21:25,780
!أحذّرك

245
00:21:25,950 --> 00:21:28,700
!هذه ليست تعويذة عاديّة

246
00:21:29,740 --> 00:21:33,200
...إنّها الأقوى لدى أبي... الأقوى لدى فارس التنّين

247
00:21:33,870 --> 00:21:36,250
...الورقة الرّابحة

248
00:21:37,210 --> 00:21:38,960
!الأقوى والأعظم

249
00:21:41,710 --> 00:21:43,210
!دورورا

250
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

251
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

252
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

253
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

254
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

255
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

256
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

257
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

258
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

259
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

260
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

261
00:23:34,070 --> 00:23:38,870
دورورا المُنطلِقة من شعارَي التنّين التوأمين
أبادت مفاعل القوّة الشيطانيّة

262
00:23:39,040 --> 00:23:43,250
وأخيراً داي وليونا يبلغان قمّة برج السّيادة

263
00:23:43,420 --> 00:23:48,340
وهناك ينتظرهما ملك الشّياطين فارن مليئاً بنيّة مُميتة

264
00:23:48,510 --> 00:23:51,180
،يخشى داي مواجهته الثّانية مع فارن

265
00:23:51,340 --> 00:23:53,590
بالإضافة إلى عصا النّهم

266
00:23:53,760 --> 00:23:56,260
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

267
00:23:58,270 --> 00:24:00,600
!وتستمرّ المغامرة