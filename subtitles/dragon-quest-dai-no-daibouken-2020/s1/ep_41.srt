1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أنا أحترق لأنّي أحرقت بالفعل

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:50,610 --> 00:01:53,230
!أختار... نور العدالة

20
00:02:02,450 --> 00:02:04,200
ماذا كانت تلك الهجمة؟

21
00:02:04,370 --> 00:02:07,620
!حطّم حقل هلاك هالة الدمى الشيطانية؟

22
00:02:07,790 --> 00:02:11,590
!كانت تشبه ضربة الهواء الخاصّة بداي

23
00:02:11,750 --> 00:02:12,750
!ماذا؟

24
00:02:13,250 --> 00:02:17,510
...تلك الهجمة التي استخدمتُها نتيجة يأسي

25
00:02:18,720 --> 00:02:21,890
كانت هجمة الهواء الخاصّة بتقنيّة الرّمح
بأسلوب أفان

26
00:02:22,220 --> 00:02:26,390
تقنيّة الهواء الذي لا يستطيع استخدامها
...سوى مُحارب العدالة الحقيقي

27
00:02:26,850 --> 00:02:29,980
!كنتُ قادراً على استخدامها أخيراً

28
00:02:30,310 --> 00:02:32,730
!فعلتها يا هيونكل

29
00:02:33,270 --> 00:02:36,490
!تقنيّة أسلوب أفان العُظمى، تقنيّة الهواء

30
00:02:37,400 --> 00:02:40,360
يعزو الفضل لكِ يا مام

31
00:02:42,620 --> 00:02:48,620
أنقذني صوتكِ من جاذبيّة قوّة الظّلام العظيمة

32
00:02:49,000 --> 00:02:50,170
...هيونكل

33
00:02:52,330 --> 00:02:55,090
أقسم لكِ الآن

34
00:02:55,670 --> 00:03:01,180
حتّى لو كلّفني ذلك الموت، سأتبع
!إرادة العدالة حتّى آخر أنفاسي

35
00:03:02,550 --> 00:03:06,350
!مهلاً! عاصفة الهالة الخاصّة به لم تتوقّف بعد

36
00:03:11,230 --> 00:03:13,360
!اللَّعنة عليك يا هيونكل

37
00:03:24,660 --> 00:03:25,740
!وجه رجل؟

38
00:03:27,200 --> 00:03:28,450
!ميستوفارن

39
00:03:30,960 --> 00:03:32,170
!رأيتم ذلك

40
00:03:50,310 --> 00:03:52,310
!مؤلم! مؤلم

41
00:03:53,560 --> 00:03:56,520
!قوّته أعظم حتّى من السابق

42
00:03:59,400 --> 00:04:01,950
!أيّها القذر

43
00:04:02,110 --> 00:04:07,830
!أتجرؤ... أتجرؤ على الكشف عن وجهي؟

44
00:04:08,490 --> 00:04:13,170
!الوجه الذي يجب ألّا أكشفه لأحد

45
00:04:13,330 --> 00:04:17,790
!مـ-مهلاً! لم أرَ شيئاً

46
00:04:17,960 --> 00:04:19,130
!اصمت

47
00:04:19,710 --> 00:04:20,880
!مؤلم

48
00:04:21,420 --> 00:04:26,090
إنّه غاضب؟! ميستوفارن الهادئ والرّزين تحديداً؟

49
00:04:26,260 --> 00:04:29,810
!ما السرّ الّذي يحمله هذا الوجه؟

50
00:04:30,140 --> 00:04:33,350
...تبّاً! لو أستطيع استخدام هجمة الهواء من جديد

51
00:04:39,770 --> 00:04:42,030
!لمَ لا أستطيع استخدام هالة العدالة؟

52
00:04:42,190 --> 00:04:44,240
!قدراتك ناقصة

53
00:04:44,400 --> 00:04:48,490
!ما الّذي يمكنك فعله لإيقافي؟

54
00:04:51,580 --> 00:04:57,670
أقلّ ما يمكنني فعله لأجل فارن-ساما هو
التسبُّب بمُعاناة أسوأ من الجحيم

55
00:04:57,830 --> 00:05:01,920
!لسكّان هذا البلد قبل أن يلقوا حتفهم

56
00:05:02,300 --> 00:05:08,470
!ابكوا! اصرخوا! وتمزّقوا

57
00:05:17,560 --> 00:05:20,940
!القلعة العملاقة لا تتحرّك

58
00:05:21,110 --> 00:05:23,190
!لا بُدّ وأنّهم يُشغلونها

59
00:05:23,360 --> 00:05:24,400
!سعادة الأميرة

60
00:05:27,360 --> 00:05:30,450
!ساعدوا القادة على الهرب قبل أن يجدنا العدوّ

61
00:05:30,620 --> 00:05:31,370
!حاضر

62
00:05:31,540 --> 00:05:32,950
!ماذا؟

63
00:05:33,120 --> 00:05:36,620
!لمَ لا تستخدمين قوّة بلدك لمُواجهتهم؟

64
00:05:36,790 --> 00:05:40,170
!هل ستهربين؟! هل ستتخلّين عن بلدكِ؟

65
00:05:41,880 --> 00:05:45,130
البلد نكرة بلا شعبها

66
00:05:45,670 --> 00:05:47,970
!الأولويّة لنجاتنا

67
00:05:50,140 --> 00:05:53,010
!لن أهرب! سأقاتل حتّى النهاية

68
00:05:53,180 --> 00:05:54,720
!انظر حولك

69
00:05:55,310 --> 00:05:58,650
!سفينتك وقوّاتك قد أبيدوا بواسطة ذلك العملاق

70
00:05:58,810 --> 00:05:59,650
!انظروا هناك

71
00:06:04,650 --> 00:06:05,900
!وحش؟

72
00:06:08,660 --> 00:06:10,120
أنتم هنا إذاً

73
00:06:10,280 --> 00:06:11,200
!شرارة

74
00:06:16,580 --> 00:06:17,410
!وهيج

75
00:06:19,170 --> 00:06:20,420
!تعويذة إحباط

76
00:06:23,300 --> 00:06:24,210
!وجدونا

77
00:06:34,600 --> 00:06:35,600
!إذاً هذا...؟

78
00:06:35,770 --> 00:06:37,810
أجل. لقد اكتمل

79
00:06:38,310 --> 00:06:41,270
هذا هو السّيف الأقوى في العالم

80
00:06:41,440 --> 00:06:42,860
ماذا ستسمّيه؟

81
00:06:46,190 --> 00:06:51,320
صُنِع هذا السيف لداي. إنّه فريد من نوعه

82
00:06:52,530 --> 00:06:55,080
...لذلك، اسمه

83
00:06:59,080 --> 00:07:02,500
!لا يمكن أن يكون سوى سيف داي

84
00:07:04,500 --> 00:07:06,250
سيف داي

85
00:07:06,760 --> 00:07:11,180
!السّيف الّذي صُنِع خصّيصاً لي

86
00:07:37,410 --> 00:07:41,210
!وكأنّه رُسِم بواسطة يدي

87
00:07:41,540 --> 00:07:42,830
!...بهذا

88
00:07:48,960 --> 00:07:50,130
ما الأمر؟

89
00:07:51,260 --> 00:07:52,380
!ماذا؟

90
00:07:53,640 --> 00:07:59,140
!ما هذا السّيف؟! إنّه مُقفل ولا أستطيع سحبه

91
00:07:59,310 --> 00:08:00,560
أخبرتُك

92
00:08:01,060 --> 00:08:03,400
لهذا السّيف روح

93
00:08:03,560 --> 00:08:06,480
يختار متى وأين يقاتل

94
00:08:07,110 --> 00:08:10,440
ماذا؟ إنّه نيِّق

95
00:08:10,610 --> 00:08:12,950
ستفهم السّبب قريباً

96
00:08:13,110 --> 00:08:15,160
...لكن إذا لم أستطع سحبه

97
00:08:15,490 --> 00:08:19,700
،عندما تحتاج للقوّة الحقيقيّة في المعركة

98
00:08:20,040 --> 00:08:27,090
سيستجيب سيف داي لروحك ويكسر ختمه

99
00:08:28,920 --> 00:08:30,260
فهمت

100
00:08:40,350 --> 00:08:42,180
فخامتك ميستوفارن

101
00:08:42,890 --> 00:08:45,650
ظلّ، هل وجدتهم؟

102
00:08:45,810 --> 00:08:50,020
أجل. قادة العالم موجودون في المُصلّى العظيم

103
00:08:50,900 --> 00:08:51,780
!وجدوهم

104
00:08:51,940 --> 00:08:56,950
جيّد. خذ قلعة الحاكم الحجريّة واسحق القادة

105
00:08:57,120 --> 00:08:58,620
أمرك سيّدي

106
00:08:59,160 --> 00:09:00,200
!يا للهول

107
00:09:15,930 --> 00:09:17,050
!إنّها تتحرّك

108
00:09:17,220 --> 00:09:18,970
!إنّها متّجهة إلى هنا

109
00:09:19,430 --> 00:09:21,720
!ادخلوا جميعاً

110
00:09:28,150 --> 00:09:29,270
!حسناً

111
00:09:29,440 --> 00:09:32,610
أخبرني عن أدائه عندما تسنح لك الفرصة

112
00:09:32,780 --> 00:09:36,740
!أكيد! شكراً جزيلاً لك يا لون بيروك

113
00:09:36,910 --> 00:09:37,910
!ولكما كذلك

114
00:09:38,320 --> 00:09:40,660
...داي... ابننا

115
00:09:41,080 --> 00:09:43,240
اعتنِ ببوب لأجلنا

116
00:09:43,410 --> 00:09:47,370
إذا وقف عائقاً في وجهك، اطرحه جانباً يا داي

117
00:09:47,540 --> 00:09:49,290
لا تقلق بشأنه

118
00:09:49,460 --> 00:09:53,800
!بوب أقوى بكثير ممّا تعتقد

119
00:09:57,220 --> 00:09:59,090
حسناً، سأغادر

120
00:10:04,470 --> 00:10:05,390
!عودة

121
00:10:20,200 --> 00:10:22,990
!تبّاً! عليّ أن أفعل شيئاً

122
00:10:27,290 --> 00:10:30,170
!يستخدم يد هالة إضافيّة على هيونكل؟

123
00:10:30,330 --> 00:10:34,750
!بالنسبة لك، سأمزّقك تمزيقاً بيدي

124
00:10:36,460 --> 00:10:39,590
!لماذا أشغل بالك إلى هذا الحدّ؟

125
00:10:39,760 --> 00:10:42,140
هل لأنّني بدأتُ أتعلّم

126
00:10:42,300 --> 00:10:46,020
تقنيّة الهواء بأسلوب أفان التي تستطيع
إبادة هالة الشّيطان؟

127
00:10:46,430 --> 00:10:47,810
...أم لأنّني

128
00:10:49,060 --> 00:10:54,110
!الوحيد القادر على كشف سرّ وجهك؟

129
00:10:54,480 --> 00:10:55,820
!هيونكل

130
00:11:00,990 --> 00:11:04,580
!مُت! لن تتفوّه بأي كلمة أخرى

131
00:11:10,210 --> 00:11:11,960
!هيونكل

132
00:11:25,930 --> 00:11:27,100
!من يجرؤ؟

133
00:11:27,970 --> 00:11:30,310
!من يكون برأيك؟

134
00:11:30,890 --> 00:11:34,520
إذا كان هناك شخص آخر يستطيع
...كسر يد الهالة

135
00:11:34,690 --> 00:11:36,650
!فلا يوجد سواه

136
00:11:42,030 --> 00:11:42,990
!داي

137
00:11:56,130 --> 00:11:58,250
هذا أنت إذاً يا داي

138
00:11:58,630 --> 00:12:02,630
بالفعل، إتقانك لضربة الهواء يجعلك الوحيد

139
00:12:02,800 --> 00:12:05,550
القادر على قطع هالة الشّيطان خاصّتي

140
00:12:05,720 --> 00:12:08,260
...هذا صحيح، لكن

141
00:12:10,270 --> 00:12:12,190
!لماذا بسكّين بابنيكا؟

142
00:12:13,390 --> 00:12:16,860
كنتَ تبحث عن سيف جديد إذاً

143
00:12:17,150 --> 00:12:18,270
عظيم

144
00:12:19,230 --> 00:12:24,320
هل يستطيع هذا السّيف تحمّل قوّة فارس تنّين؟

145
00:12:26,030 --> 00:12:28,080
!تعال وأرني

146
00:12:29,870 --> 00:12:32,040
!ماذا تنتظر؟ أرِني

147
00:12:34,670 --> 00:12:35,710
!لا داعي

148
00:12:35,880 --> 00:12:36,670
!ماذا؟

149
00:12:36,830 --> 00:12:41,380
!يقول سيفي أنّك لا تستحقّ أن أريك

150
00:12:41,550 --> 00:12:44,380
!أيّها الشقيّ. تباً لك ولغطرستك

151
00:12:44,550 --> 00:12:48,100
!فليبتلعك وتموت بواسطة حقل الهلاك الخاصّ بي أيضاً

152
00:12:50,720 --> 00:12:52,730
...تقنيّة السّيف بأسلوب أفان

153
00:12:54,190 --> 00:12:55,900
!ضربة الهواء

154
00:13:01,400 --> 00:13:02,570
!يمكنني التحرّك

155
00:13:05,820 --> 00:13:07,120
!هل الجميع بخير؟

156
00:13:12,200 --> 00:13:15,370
...لو استخدم هذه القوّة بسيفه الجديد

157
00:13:17,330 --> 00:13:21,130
!ما خطب سيفك الجديد؟! ألم يكتمل؟

158
00:13:21,300 --> 00:13:23,260
...الأمر ليس كذلك. هذا السّيف

159
00:13:24,220 --> 00:13:24,840
!احذر

160
00:13:35,140 --> 00:13:36,270
!هيونكل

161
00:13:36,770 --> 00:13:38,690
!تِرسُه عِبارة عن عقافة؟

162
00:13:39,020 --> 00:13:42,110
!كم سلاحاً تمتلك بالضبط؟

163
00:13:42,280 --> 00:13:44,490
!داي، دعه لي

164
00:13:44,650 --> 00:13:46,360
!لكنّك جريح

165
00:13:46,530 --> 00:13:47,280
!انظر

166
00:13:50,330 --> 00:13:52,120
!إنّها متوجّهة نحو المُصلّى العظيم

167
00:13:52,660 --> 00:13:56,330
لا تؤثّر أي قوّة عاديّة على قلعة الحاكم الحجريّة

168
00:13:56,500 --> 00:13:58,710
...لكن بقوّتك

169
00:13:59,500 --> 00:14:01,210
!تصرّفاتكم عقيمة

170
00:14:06,510 --> 00:14:10,850
!بدأ فعلاً يتعلّم تقنيّة الهواء

171
00:14:13,260 --> 00:14:14,770
!انطلق يا داي

172
00:14:15,600 --> 00:14:19,600
!هذا صحيح يا داي! ما زال بمقدورنا القتال هنا

173
00:14:19,770 --> 00:14:21,440
!احمِ ليونا والآخرين

174
00:14:26,110 --> 00:14:27,030
!حسناً

175
00:14:30,280 --> 00:14:32,620
!راقبوا هذا جميعاً

176
00:14:32,780 --> 00:14:36,830
!هذه هي قوّة السّيف الّذي صاغه لون بيروك

177
00:14:42,500 --> 00:14:46,380
!ظلّ، أسرع واسحق المُصلّى العظيم

178
00:14:46,550 --> 00:14:47,130
!أمرك

179
00:14:56,810 --> 00:14:59,140
لم يعد هناك مفرّ

180
00:15:01,020 --> 00:15:04,860
هل الجميع... هل هُزِم الجميع؟

181
00:15:11,700 --> 00:15:15,030
سامحوني يا زملائي القادة

182
00:15:15,200 --> 00:15:17,450
،لو كنتُ أعلم أنّهم بهذه القوّة

183
00:15:17,620 --> 00:15:23,250
لركّزتُ على الإخلاء بدلاً من مواجهتهم

184
00:15:23,710 --> 00:15:26,880
،لو كنتُ سأموت بمفردي نتيجة طيشي فلا مشكلة

185
00:15:27,050 --> 00:15:30,760
...لكن أن أقحمكم جميعاً معي في هذا الأمر

186
00:15:31,220 --> 00:15:32,680
لَهو أمر مُخزٍ

187
00:15:33,260 --> 00:15:36,560
أيّها الملك بينغارنا، الوقت مبكّر جدّاً على الاستسلام

188
00:15:36,720 --> 00:15:42,730
!هذا صحيح! الاستسلام أمامنا هو الخزيّ الحقيقيّ

189
00:15:46,520 --> 00:15:47,730
معكما حقّ

190
00:16:27,020 --> 00:16:28,020
!داي

191
00:16:29,190 --> 00:16:31,530
!حسناً يا سيفي

192
00:16:31,690 --> 00:16:35,740
!حان الوقت لتمدّني بقوّتك الآن

193
00:16:46,420 --> 00:16:47,460
!ماذا؟

194
00:16:47,630 --> 00:16:50,710
!يواجه هذا العملاق بسيف؟

195
00:16:50,880 --> 00:16:55,380
!ها هو ذا! هذا هو سيف داي الأقوى

196
00:17:01,520 --> 00:17:05,100
!أحمق! لا يستطيع السّيف قطع قلعة

197
00:17:05,270 --> 00:17:10,940
!شقيّ وقح! سأسحقك مع الآخرين

198
00:17:18,990 --> 00:17:20,160
!إنّها تُفتَح

199
00:17:54,440 --> 00:17:56,360
!ما-ماذا حدث؟

200
00:18:04,370 --> 00:18:06,460
!ماذا؟

201
00:18:14,260 --> 00:18:19,340
مستحيل! قطعتَ قلعة الحاكم الحجريّة
!الخاصّة بجيش الشّياطين؟

202
00:18:19,510 --> 00:18:21,050
!كيف فعل ذلك؟

203
00:18:23,640 --> 00:18:25,980
!هذا هو السّيف الأقوى إذاً

204
00:18:37,280 --> 00:18:43,580
!مذهل! مجرّد هجمة عاديّة كانت أشبه بشقّ السّماء

205
00:18:43,740 --> 00:18:48,500
!ماذا كان ليحدث لو استخدمتُ كامل قوّتي؟

206
00:18:49,710 --> 00:18:51,710
!اللّعنة عليك

207
00:18:57,670 --> 00:18:59,340
!افتحوا كلّ حُجُرات المدافع

208
00:18:59,510 --> 00:19:04,100
!حوّلوه إلى رماد بقوّة قلعة الحاكم الحجريّة

209
00:19:04,260 --> 00:19:06,180
!لا أعتقد ذلك

210
00:19:06,640 --> 00:19:08,640
!الهالة التنّينيّة

211
00:19:11,850 --> 00:19:15,690
!الهالة التنّينيّة الخاصّة بداي تغلّف سيفه

212
00:19:25,330 --> 00:19:27,160
!أطلقوا

213
00:19:55,060 --> 00:19:56,820
!أين؟! إلى أين ذهب؟

214
00:19:58,320 --> 00:20:01,860
!الحُجرة المركزيّة؟! تحت هذا العرش مُباشرة؟

215
00:20:07,330 --> 00:20:10,450
!خذ هذه

216
00:20:14,540 --> 00:20:17,800
!فخامتك ميستوفارن

217
00:21:10,310 --> 00:21:12,430
!قطعَ القلعة العملاقة إلى نصفين

218
00:21:12,600 --> 00:21:13,930
!يا للهول

219
00:21:14,100 --> 00:21:16,270
!مرحى! تستحقّ هذا

220
00:21:23,740 --> 00:21:24,950
!مذهل

221
00:21:25,110 --> 00:21:27,410
!داي؟! أين داي؟

222
00:21:34,830 --> 00:21:35,580
!هناك

223
00:21:45,800 --> 00:21:46,930
!بطل حقيقيّ

224
00:21:47,090 --> 00:21:48,390
!فعلها

225
00:22:04,320 --> 00:22:07,280
حتّى لو واجهت الشّيطان والمنطق في صفّك

226
00:22:07,450 --> 00:22:11,240
قد يكون مجرّد تبرير

227
00:22:11,410 --> 00:22:15,330
حتّى الآن، حتّى الآن ما زلتُ أتردّد

228
00:22:15,500 --> 00:22:19,380
إلى أي مدى سنصل؟

229
00:22:19,540 --> 00:22:22,670
سمعتُ صوتاً أشبه بهمسِ ملاك

230
00:22:22,840 --> 00:22:26,590
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

231
00:22:26,760 --> 00:22:30,300
مُعرّض للحبِّ والحزن

232
00:22:30,470 --> 00:22:34,600
على الدّربِ المُغطّى بالاعتزاز

233
00:22:36,310 --> 00:22:38,640
لحظات عابِرة من الجُبن

234
00:22:40,190 --> 00:22:42,440
نداء الاستغاثة الذي تحفّظتُ عليه

235
00:22:44,020 --> 00:22:48,030
قبضتُ يدي المُرتعدة

236
00:22:48,610 --> 00:22:53,620
ذلك الوعد البسيط

237
00:22:53,780 --> 00:22:57,410
تلك الذّكريات التّافهة الصّغيرة

238
00:22:57,580 --> 00:22:59,710
ما زالت تسكن قلبي

239
00:22:59,870 --> 00:23:03,880
كجمرٍ يُبقيني مُشتعلاً

240
00:23:04,040 --> 00:23:08,380
شُعاع شفّاف من النُّور

241
00:23:08,550 --> 00:23:11,550
يُنير الدّرب أمامي

242
00:23:11,720 --> 00:23:16,220
قلّما أستطيع فعله

243
00:23:16,390 --> 00:23:22,440
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

244
00:23:33,990 --> 00:23:38,080
أظهرَ سيفُ داي قوّته الحقيقيّة وقطعَ
قلعة الحاكم الحجريّة إلى نصفين

245
00:23:38,540 --> 00:23:42,920
يهاجم ميستوفارن الغاضب الفريقَ
بقوّته العميقة

246
00:23:43,080 --> 00:23:48,510
يظهر كيلفارن فجأة، لكن يختفي من جديد
بعد التهكّم من بوب

247
00:23:48,670 --> 00:23:52,930
...نتيجة غضبه، بوب يلحق بكيلفارن ليجد

248
00:23:53,430 --> 00:23:55,470
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

249
00:23:57,180 --> 00:23:59,310
!وتستمرّ المغامرة