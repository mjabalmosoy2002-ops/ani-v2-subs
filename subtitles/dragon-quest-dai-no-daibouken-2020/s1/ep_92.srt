1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:54,820 --> 00:02:01,160
إذاً أصبحت مُعلِّم الظّلام الخاص بي
!لترعاني كي أكون جسدك المثاليّ

20
00:02:01,330 --> 00:02:03,910
!تأخّرتَ في اكتشاف ذلك

21
00:02:04,700 --> 00:02:10,920
،عندما وجدتُك بعد أن تركتَ أفان
خطرت على ذهني فكرة

22
00:02:11,080 --> 00:02:16,010
مهما كان قويّاً، يبقى هذا الجسد جسد الملك فارن

23
00:02:16,170 --> 00:02:18,300
إنّه ليس لي

24
00:02:18,470 --> 00:02:24,510
حتّى لو وجدتُ بديلاً، قد لا يكون
مُتوافقاً مع قوّتي الشّيطانيّة

25
00:02:24,680 --> 00:02:28,390
لكن إذا أردتُ رعاية جسد من الصّفر

26
00:02:28,560 --> 00:02:34,650
،وتدريبه على استخدام قوّة الشّيطان العظمى
فسيكون البديل المثاليّ

27
00:02:35,070 --> 00:02:38,950
،فإذا حان الوقت لعودة جسد الملك فارن

28
00:02:39,110 --> 00:02:42,700
سيكون السِّلاح المثاليّ بالنسبة لي

29
00:02:43,490 --> 00:02:44,790
سلاح؟

30
00:02:44,950 --> 00:02:48,910
كلّ ما كنتُه بالنسبة لك مجرّد سلاح

31
00:02:49,080 --> 00:02:52,580
هذا صحيح. أنت سلاحي. أداتي

32
00:02:52,750 --> 00:02:57,840
مررتُ بفترات فكّرتُ في قتلك، لكن
يسرّني أنّني حافظتُ على حياتك

33
00:02:58,010 --> 00:03:00,630
!في النّهاية، خدمتني جيّداً

34
00:03:06,970 --> 00:03:08,060
!هيونكل

35
00:03:09,600 --> 00:03:12,940
!وجدتُها! وجدتُ روحك

36
00:03:13,560 --> 00:03:16,570
هيونكل، ستموت الآن

37
00:03:16,730 --> 00:03:21,820
بخلاف تلك الفتاة، لن يكون محو روحك مؤقّتاً

38
00:03:22,240 --> 00:03:27,080
!سوف تتبدّد هذه الرّوح وستصبح دُمية حيّة

39
00:03:27,240 --> 00:03:30,750
!ثمّ أخيراً سنصبح واحداً

40
00:03:30,910 --> 00:03:36,880
!روحي وجسدك سيصنعان محارباً يُنافس ميستوفارن

41
00:03:37,250 --> 00:03:42,880
!اعتبره شرفاً لك! ستكون خليفة الملك فارن

42
00:03:46,850 --> 00:03:47,930
...هذا

43
00:03:49,770 --> 00:03:52,350
!هالة ضوء؟

44
00:03:52,520 --> 00:03:58,190
!هيونكل، ركّزتَ هالة الضّوء في روحك؟

45
00:03:58,610 --> 00:04:04,910
،لا أستطيع التحرّك جيّداً على أيّ حال
لذا كان هذا كلّ ما أستطيع فعله

46
00:04:05,070 --> 00:04:10,250
لكن مُحال أن تتمكّن من جمع كلّ
!القوّة في لمح البصر

47
00:04:10,910 --> 00:04:17,420
ليس ما لم تعلم بأنّني سوف أستحوذ
!عليك! كيف عرفت؟

48
00:04:18,250 --> 00:04:21,260
راودني إحساس فحسب

49
00:04:21,420 --> 00:04:24,840
كنتَ عازماً على اختياري

50
00:04:26,720 --> 00:04:29,970
!هيونكل

51
00:04:38,270 --> 00:04:39,610
!هيونكل -
!هل أنت بخير؟ -

52
00:04:39,770 --> 00:04:40,780
!أين ميستو؟

53
00:04:47,280 --> 00:04:48,950
...لقد مات

54
00:04:49,120 --> 00:04:50,910
داخلي

55
00:04:52,620 --> 00:04:57,710
!إذاً الصّراع الأبديّ بين المُعلّم وتلميذ الظّلام قد انتهى

56
00:04:57,880 --> 00:05:00,090
ينبغي أن يكون مسروراً

57
00:05:00,250 --> 00:05:04,760
تمكّنَ من الموت في الجسد المثاليّ
الّذي رعاه عبر السّنين

58
00:05:13,640 --> 00:05:14,890
مُعلّم

59
00:05:15,980 --> 00:05:19,480
ما أكون... بالنسبة لك؟

60
00:05:21,690 --> 00:05:23,320
أليس هذا واضحاً؟

61
00:05:24,400 --> 00:05:25,900
أنت فخري

62
00:05:47,010 --> 00:05:49,890
!لماذا؟ لماذا لا تُهاجم؟

63
00:05:50,050 --> 00:05:52,390
!ألا يُفترض أن يكون هذا الجسد الأعظم؟

64
00:05:53,350 --> 00:05:54,720
انتظر فحسب

65
00:06:01,610 --> 00:06:02,980
مُعلّم

66
00:06:03,440 --> 00:06:05,820
استيقظتِ يا مام

67
00:06:06,360 --> 00:06:07,820
!أين ميستو؟

68
00:06:08,360 --> 00:06:11,450
لا تقلقي. رحلَ عن هذا العالم

69
00:06:11,620 --> 00:06:14,580
نفيتَه، أليس كذلك يا مُعلّم؟

70
00:06:14,740 --> 00:06:17,410
باستخراجه من جسدي

71
00:06:20,250 --> 00:06:23,210
شيء من هذا القبيل

72
00:06:23,380 --> 00:06:26,260
بالطبع، ما كنتُ لأستطيع فعلها لولا تعاون الجميع

73
00:06:32,720 --> 00:06:37,890
حريّ بك ألّا تدعها تعلم بارتباطك
الشّيطانيّ بميستو

74
00:06:38,390 --> 00:06:39,560
...هيونكل

75
00:06:39,730 --> 00:06:43,190
أرى بوضوح مدى أهمّية مام بالنسبة لك

76
00:06:43,360 --> 00:06:44,980
أعي ذلك تماماً

77
00:06:46,190 --> 00:06:47,110
...لكن

78
00:06:48,030 --> 00:06:50,240
...لكن بوب

79
00:06:51,030 --> 00:06:56,120
بوب وكبير المُعلّمين قُتِلا بواسطة ميستو

80
00:07:16,350 --> 00:07:18,270
استيقظتِ يا مام

81
00:07:26,190 --> 00:07:28,740
ماذا تفعلان هنا بالضبط؟

82
00:07:28,900 --> 00:07:34,200
أليس هذا واضحاً؟ نحن نُشفى. إنّه وقت الشّفاء

83
00:07:35,580 --> 00:07:40,870
قبل أن أتنكّر بهيئة كيلفارن، أنقذتُهما
من تعويذة ميدروا

84
00:07:41,540 --> 00:07:45,090
تركتُ جسديهما الغائبين عن الوعي
،في الخلف وتنكّرت

85
00:07:45,250 --> 00:07:49,210
لكن وسط كلّ تلك الجلبة، لم
أحصل على فُرصة للشرح

86
00:07:49,920 --> 00:07:53,010
يبدو أنّهما استيقظا للتو أيضاً

87
00:07:53,180 --> 00:07:56,510
...لم يقصدا إقلاقكِ أساساً

88
00:07:56,850 --> 00:08:00,350
مام، أنتِ لا تصغين إليّ

89
00:08:01,060 --> 00:08:03,230
مام؟ مام؟

90
00:08:03,400 --> 00:08:05,980
لمَ أنتِ مُنفعلة هكذا؟

91
00:08:06,150 --> 00:08:10,820
لحظة. هل تقولين لنفسكِ "أنا من كان
"!ينبغي أن أشفي بوب

92
00:08:10,990 --> 00:08:12,820
هذا ما تفكّرين فيه، صحيح؟

93
00:08:17,950 --> 00:08:19,830
!أيّها الغبيّ

94
00:08:20,000 --> 00:08:21,750
!مام، اهدئي

95
00:08:21,910 --> 00:08:23,210
!...نتفهّم ذلك، لكن

96
00:08:23,370 --> 00:08:26,840
يا إلهي. وبعد أن عالجتُه أيضاً

97
00:08:27,000 --> 00:08:31,130
هل أنت متأكّد بأنّها ما زالت
لا تحوي بقايا شرّ داخلها؟

98
00:08:31,300 --> 00:08:35,050
لا. ذلكما الاثنان هكذا دوماً

99
00:08:35,220 --> 00:08:37,760
لكنّها تكون غلطة بوب دوماً

100
00:08:39,600 --> 00:08:42,810
...لكن على ذكر ذلك يا قائد

101
00:08:43,770 --> 00:08:47,110
يبدو أنّ الأعشاب الطبّية لا تنفع معي

102
00:08:47,270 --> 00:08:49,650
ألا يمكنك استخدام أيّ سحر شفاء؟

103
00:08:49,820 --> 00:08:52,240
!أحم! لا أستطيع

104
00:08:54,200 --> 00:08:58,910
!حسناً! لنذهب ونساعد فخامته داي
!هل أنتم جاهزون؟

105
00:08:59,490 --> 00:09:01,160
...المعذرة

106
00:09:01,540 --> 00:09:04,290
لستُ جاهزاً

107
00:09:06,170 --> 00:09:07,710
يا إلهي

108
00:09:07,880 --> 00:09:09,460
مام

109
00:09:09,630 --> 00:09:13,170
أعني... كنتُ قلقة للغاية

110
00:09:13,340 --> 00:09:14,880
إنّه غبيّ دوماً

111
00:09:15,050 --> 00:09:18,800
كانت مُحاولتكِ إخفاء اطمئنانكِ عنيفة

112
00:09:19,180 --> 00:09:21,180
!هيّا! انهض فحسب

113
00:09:21,350 --> 00:09:23,020
!تعويذة شفاء

114
00:09:24,350 --> 00:09:25,560
!أطلقها بنفسك

115
00:09:25,730 --> 00:09:31,360
ليس هو فحسب، لكن أيّ شخص تعرّض لإصابات
خطيرة ينبغي أن يبقى هنا أو يعود

116
00:09:31,520 --> 00:09:35,110
لا. بعد كلّ هذا، لا توجد رجعة

117
00:09:35,280 --> 00:09:39,160
لا أقصد سرقة عبارة هيونكل، لكن
أريد إكمال هذه المعركة حتّى نهايتها

118
00:09:39,320 --> 00:09:41,580
ولو كلّفك ذلك حياتك؟

119
00:09:42,830 --> 00:09:45,660
بصراحة، أنا خائف من المتابعة

120
00:09:45,830 --> 00:09:50,880
حتّى بجسد ميستوفارن، كانت قوّة فارن شبه مثاليّة

121
00:09:51,040 --> 00:09:56,930
هناك في الأعلى، يمتلك الآن القوّة
السحريّة وذكاء الجسد الكهل كذلك

122
00:09:57,090 --> 00:10:00,050
،أعلم كم جسديهما مُرعبان وهما مُنفصلان

123
00:10:00,220 --> 00:10:04,180
لذا أفضّل عدم مواجهتهما معاً

124
00:10:05,390 --> 00:10:06,980
لمَ ستذهب إذاً؟

125
00:10:07,140 --> 00:10:10,190
أسألك ذات السّؤال يا لارهارت

126
00:10:12,230 --> 00:10:16,240
لم تستطع فعل شيء أمام ميستوفارن

127
00:10:16,690 --> 00:10:20,570
،بعد أن علمتَ بأنّ هناك مَن هو أقوى
لمَ ما زلت ترغب في الذّهاب؟

128
00:10:21,990 --> 00:10:23,200
سؤال سخيف

129
00:10:23,700 --> 00:10:28,670
حتّى لو كنتُ عاجزاً عن فعل شيء، هذا
لا يهمّ ما دام فخامته داي سيربح

130
00:10:29,120 --> 00:10:34,130
أن أموت لأجل ذلك الهدف لَهو واجبي
كقائد أسياد التّنانين

131
00:10:34,670 --> 00:10:37,760
إذا لم أكن سوى مجرّد درع لفخامته
داي، فليكُن ذلك إذاً

132
00:10:37,920 --> 00:10:40,680
هذا بحدِّ ذاته يجعل الأمر جديراً

133
00:10:41,050 --> 00:10:42,470
ها أنت ذا إذاً

134
00:10:42,640 --> 00:10:44,760
أنت مثلنا

135
00:10:46,180 --> 00:10:52,520
لا أحد هنا يعتقد بأنّه يستطيع
مواجهة ملك الشّياطين

136
00:10:53,480 --> 00:10:55,280
لكن اتّخذنا قرارنا

137
00:10:55,650 --> 00:10:58,860
سواء كنّا سنفوز أو نخسر، سنذهب

138
00:11:01,450 --> 00:11:04,740
!لأنّ... داي هناك في الأعلى

139
00:11:11,580 --> 00:11:14,540
كلّما كان هناك دروع أكثر، كان أفضل

140
00:11:15,960 --> 00:11:17,510
وجهة نظر سديدة

141
00:11:19,130 --> 00:11:20,380
هيّا بنا

142
00:11:21,130 --> 00:11:22,470
!إلى داي

143
00:11:42,530 --> 00:11:44,910
ينبغي أن يستغرق ذلك حوالي خمس ثوانٍ

144
00:11:45,990 --> 00:11:51,330
...خمسة... أربعة... ثلاثة
اثنان... واحد... صفر

145
00:11:58,130 --> 00:11:59,800
!ما الأمر يا داي؟

146
00:12:01,630 --> 00:12:05,470
!أنا... أنا أُشفَى! جسدي يُشفَى

147
00:12:05,640 --> 00:12:06,430
!ماذا؟

148
00:12:09,180 --> 00:12:11,390
ينبغي أن تكون قد شُفيت تماماً الآن

149
00:12:11,560 --> 00:12:14,690
!هل كانت تلك تعويذة ليونا، شفاء كامل؟

150
00:12:14,850 --> 00:12:15,730
هذا صحيح

151
00:12:16,940 --> 00:12:21,440
تعويذة الشّفاء الكامل الّتي استُخدِمت
...عليك بينما لم تتأثّر بسحر من نوع شفاء

152
00:12:21,610 --> 00:12:23,740
أعطَتْ مفعولها أخيراً

153
00:12:24,160 --> 00:12:29,910
ظننتُك ستتعافى قريباً، وقد كنتُ مُحِقّاً

154
00:12:30,450 --> 00:12:34,580
عندما تُقاتل مُتخطّياً حدودك بهالة
،مُشابهة للهالة الشيطانيّة

155
00:12:34,750 --> 00:12:38,710
قد تحدث هذه الارتدادات على الجسد أحياناً

156
00:12:38,880 --> 00:12:42,340
قد تموت الكائنات الضّعيفة جرّاء ذلك حتّى

157
00:12:42,510 --> 00:12:43,880
،يختلف الأمر من شخص لآخر

158
00:12:44,050 --> 00:12:50,560
لكن يمكن تقدير تعافي شخص
من عينيه ولون بشرته

159
00:12:50,850 --> 00:12:53,480
!لماذا انتظرتَ حدوث ذلك؟

160
00:12:54,190 --> 00:12:55,810
الجواب واضح

161
00:12:56,810 --> 00:12:59,940
!وذلك كي يتمكّن من مقاتلتي وأنا بكامل قوّتي

162
00:13:01,570 --> 00:13:02,820
!ماذا؟

163
00:13:05,780 --> 00:13:07,870
أنت بصير حقّاً يا داي

164
00:13:08,030 --> 00:13:11,620
مضى وقت طويل منذ استخدمتُ هذا الجسد

165
00:13:11,870 --> 00:13:17,460
سيكون سحق عدوّ ليس في أفضل حالاته مُملّاً

166
00:13:17,880 --> 00:13:22,920
إن كنّا سنتقاتل، أفضّل أن يكون
ذلك بعد أن تُشفَى تماماً

167
00:13:25,300 --> 00:13:28,800
!هذه إهانة لنا! هل تحاول أن تتباهى؟

168
00:13:28,970 --> 00:13:31,310
!لن تُجدي مثل هذه التّهديدات معنا

169
00:13:34,230 --> 00:13:36,940
ما خطبي؟ لا أستطيع التكلُّم

170
00:13:37,560 --> 00:13:42,190
!كلّ ما فعله كان التّحديق بي فيتجمّد جسدي هكذا

171
00:13:42,940 --> 00:13:48,030
أنا لا أحاول التّهديد أو التّباهي يا أميرة

172
00:13:48,450 --> 00:13:53,370
أتطلّع فعلاً لمقاتلة داي

173
00:13:53,790 --> 00:13:56,330
تعويذة الزمن المُتوقِّف السرّية قد كُسِرت

174
00:13:56,500 --> 00:14:00,250
قبل الكسوف الشمسيّ الكامل المُقبل
،بعد بضعة قرون

175
00:14:00,880 --> 00:14:04,260
سأبقى عالقاً بهذه الهيئة

176
00:14:04,420 --> 00:14:08,510
سلبت منّي بضعة قرون من وقتي الخالد

177
00:14:08,840 --> 00:14:13,350
إن لم تدفع الثّمن، فكأنّني تعرّضتُ للسرقة

178
00:14:13,510 --> 00:14:18,560
أنت مُلزَم بتسليتي قدر ما تستطيع

179
00:14:18,730 --> 00:14:20,900
!إنّه الشرّ المُطلَق

180
00:14:23,230 --> 00:14:25,440
أفهم ما يعنيه بعض الشيء

181
00:14:25,610 --> 00:14:30,160
!داي، لا تكن غبيّاً! لا تصغِ إليه

182
00:14:31,240 --> 00:14:35,540
الآن بهذه الهيئة، أنت أقوى من السّابق، صحيح؟

183
00:14:35,700 --> 00:14:36,870
بالطبع

184
00:14:37,040 --> 00:14:39,710
أكثر بكثير من السّابق

185
00:14:42,880 --> 00:14:46,880
امتلاك هذه القوّة في هذا العالم أمر مُملّ للغاية

186
00:14:47,630 --> 00:14:50,890
،ليس وكأنّني أستمتع بالقتال

187
00:14:51,050 --> 00:14:55,220
لكن أتفهّم هذا الشّعور بعض الشيء

188
00:14:55,390 --> 00:14:56,810
...داي

189
00:14:57,770 --> 00:14:59,310
أنت مثلي يا داي

190
00:14:59,480 --> 00:15:01,400
لا تدّعِ خِلاف ذلك

191
00:15:01,850 --> 00:15:05,110
مُنحدراً من مُحاربين، يجري في عروقك دماء المعارك

192
00:15:05,270 --> 00:15:09,860
يمكنك محاولة إخفاء ذلك، لكن
طبيعتك الحقيقيّة تكشف نفسها

193
00:15:10,030 --> 00:15:14,450
...ابن تنّين انجذب بحماقة نحو البشر

194
00:15:14,620 --> 00:15:20,670
سأخلع هذا القناع الّذي تختبئ خلفه
!وأجعلك تتذوّق الجحيم

195
00:15:21,120 --> 00:15:22,880
!ليونا، ابتعدي

196
00:15:24,710 --> 00:15:25,920
لا تقلقي

197
00:15:26,090 --> 00:15:28,420
مهما حدث، سأبقى أنا

198
00:15:28,590 --> 00:15:30,510
أنا داي الجميع

199
00:15:55,620 --> 00:16:00,460
كما قلتُ آنفاً، لم أقاتل بهذا
الجسد منذ آلاف السّنين

200
00:16:00,620 --> 00:16:04,790
لا أستطيع التحفّظ، لذا قد ينتهي الأمر بسرعة فائقة

201
00:16:04,960 --> 00:16:07,380
آمل أن تسامحني إن كان الأمر كذلك

202
00:16:07,550 --> 00:16:10,590
!الكلام المُبالغ فيه قبل المعركة ليس أسلوبي

203
00:16:13,840 --> 00:16:15,470
!صعق

204
00:16:27,150 --> 00:16:29,190
!هذه غيغا ستراش

205
00:16:35,030 --> 00:16:39,040
!هذه أقوى هجمة يمكنني تنفيذها

206
00:16:41,830 --> 00:16:42,910
!صحيح

207
00:16:43,080 --> 00:16:46,290
أستمتع بهذا معك

208
00:16:46,580 --> 00:16:48,590
أنت جريء وعقلانيّ

209
00:16:48,750 --> 00:16:54,220
في حين أنّك تبدو طائشاً، إلّا أنّك
تستخدم أكثر الهجمات منطقيّة

210
00:16:55,430 --> 00:16:57,850
...لقياس قوّته

211
00:16:58,010 --> 00:17:05,060
لمعرفة الفارق بين قوّتينا، استخدام
هجمتي الأقوى هي خير وسيلة

212
00:17:05,940 --> 00:17:11,530
وتستغرق هذه الهجمة وقتاً للتحضير، لذا من الصّعب
استخدامها في معركة عن قُرب

213
00:17:12,440 --> 00:17:14,110
!هذا نهج المواجهة المُباشرة

214
00:17:15,070 --> 00:17:20,830
إذاً ينبغي أن أريك مهارة جديرة بهجمتك

215
00:17:32,170 --> 00:17:36,840
من المُدهش أن تعي مباشرة خطر هذه الوقفة

216
00:17:37,010 --> 00:17:40,390
يُدعى هذا بحارس السّماء والأرض الشّيطاني

217
00:17:40,560 --> 00:17:42,890
حارس السّماء والأرض الشّيطاني؟

218
00:17:43,350 --> 00:17:48,310
في نظري، يبدو وكأنّه اتّخذ وقفة بسيطة

219
00:17:48,770 --> 00:17:51,820
لكن مُحال أن تكون بتلك البساطة

220
00:17:51,980 --> 00:17:55,070
!داي يتصبّب عرقاً

221
00:17:55,860 --> 00:17:59,620
والآن فلندع مهارتينا العُظمَتين تتشابكان

222
00:17:59,780 --> 00:18:02,330
مَن منّا سيسقط؟

223
00:18:04,000 --> 00:18:05,410
ما الخطب يا داي؟

224
00:18:05,580 --> 00:18:07,370
هل ستتراجع الآن؟

225
00:18:07,540 --> 00:18:11,040
ينبغي ان أخبرك بأنّ حكمك صحيح

226
00:18:11,210 --> 00:18:16,420
...غيغا ستراش هي بالفعل أقوى هجمة لتستخدمها

227
00:18:16,590 --> 00:18:18,880
للفوز أو الخسارة

228
00:18:19,050 --> 00:18:20,220
!هذا صحيح

229
00:18:20,390 --> 00:18:24,100
!غيغا ستراش هي أقوى هجمة لديّ

230
00:18:24,520 --> 00:18:25,680
...هذا

231
00:18:28,980 --> 00:18:30,900
...خياري

232
00:18:31,190 --> 00:18:32,480
!الوحيد

233
00:18:34,230 --> 00:18:37,320
!إنّه لا يتفادى! هل سيحاول تلقّيها؟

234
00:18:39,490 --> 00:18:41,950
!غيغا ستراش

235
00:18:42,120 --> 00:18:43,620
!جناح العنقاء

236
00:18:44,790 --> 00:18:46,450
!النهاية الكارثية

237
00:18:47,080 --> 00:18:48,870
!عنقاء القيصر

238
00:19:11,940 --> 00:19:16,190
اسمحي لي بالشّرح بينما تُشفَى يدي

239
00:19:16,360 --> 00:19:19,700
لماذا سقطَ داي في تلك اللّحظة؟

240
00:19:19,860 --> 00:19:23,530
هذا هو سرّ حارس السّماء والأرض الشّيطاني

241
00:19:23,700 --> 00:19:26,240
السّماء" هي الهجمة"

242
00:19:26,410 --> 00:19:28,200
الأرض" هي الدّفاع"

243
00:19:28,370 --> 00:19:32,710
و"شيطانيّ" هي تذكير باستخدام السّحر

244
00:19:34,250 --> 00:19:35,630
أرى بأنّك فهمتِ

245
00:19:36,130 --> 00:19:41,590
يمكنني أن أهاجم وأدافع وأستخدم
السّحر في لحظة واحدة

246
00:19:42,680 --> 00:19:47,180
هذه الوقفة المنيعة هي حارس
السّماء والأرض الشّيطاني

247
00:19:47,430 --> 00:19:51,560
كعجوز، اثنان من الثّلاثة هما كُل
ما يمكنني فعله

248
00:19:51,730 --> 00:19:56,980
لكن هذا الجسد الفتيّ يسمح لي
بالقتال بهذه الطريقة

249
00:19:57,570 --> 00:20:02,700
بهذه المهارة العُظمى، مهما كانت الهجمة
،الّتي يستخدمها المرء فتّاكة

250
00:20:02,860 --> 00:20:05,320
تصبح عديمة الجدوى

251
00:20:05,740 --> 00:20:07,490
مُحال أن يفوز بالطبع

252
00:20:07,660 --> 00:20:12,160
غيغا ستراش هي خليط من السّحر
والهجوم المُعتمِد على السّيف السحريّ

253
00:20:12,330 --> 00:20:16,000
لكن يستطيع خصمه إضافة الدّفاع إلى ذلك

254
00:20:17,920 --> 00:20:22,930
،أيّ شخص ينقضّ على تلك الوقفة تُبطَل هجمته

255
00:20:23,090 --> 00:20:27,760
ويُمزَّق آنيّاً بواسطة هجومه وسحره

256
00:20:42,110 --> 00:20:46,820
أرى حتّى الأميرة ذات الإرادة القويّة تعجز عن التّعبير

257
00:20:47,660 --> 00:20:49,290
يا له من وجه جميل

258
00:20:49,870 --> 00:20:51,080
!توقّف

259
00:20:52,580 --> 00:20:56,460
!ابتعد... عن ليونا

260
00:21:11,140 --> 00:21:14,810
،قد تكون محميّاً بواسطة هالتك التنّينيّة

261
00:21:14,980 --> 00:21:17,980
لكن لا شيء لا تستطيع النّهاية الكارثيّة قطعه

262
00:21:18,270 --> 00:21:22,570
لا نصل في العالم يستطيع مُجاراة
هجمة من طرف كفّي

263
00:21:23,360 --> 00:21:25,110
أتساءل ما إن كنت تُدرك

264
00:21:26,240 --> 00:21:31,040
يقع هذا الجرح في نفس المكان
في جسدي والّذي أصبتَه سابقاً

265
00:21:31,910 --> 00:21:36,540
والآن ستشعر بغضبي رويداً

266
00:21:38,750 --> 00:21:42,170
لديّ فكرة مُثيرة

267
00:21:42,710 --> 00:21:44,220
الأميرة ليونا

268
00:21:44,590 --> 00:21:47,890
يجب أن تكوني خادمة لي

269
00:22:11,080 --> 00:22:17,710
أخبرني، إلى أين أنت ذاهب بمفردك؟

270
00:22:20,580 --> 00:22:28,260
أحدّق بك من الخلف بينما تمضي بعيداً

271
00:22:30,260 --> 00:22:36,060
أخبرني، إلى أين أنت ذاهب بمفردك؟

272
00:22:39,850 --> 00:22:45,280
ندّعي الصّلابة ونتّبع أهواءنا

273
00:22:45,440 --> 00:22:49,700
وبدأنا بهذه الحكاية معاً

274
00:22:50,200 --> 00:22:56,000
هناك شيء يلمع وراء الأفق

275
00:22:56,160 --> 00:23:02,380
كنّا نبحث عن شيء ما

276
00:23:04,000 --> 00:23:09,220
في السّماء البعيدة، يتراقص في الهواء

277
00:23:09,380 --> 00:23:15,010
تغرّد الطّيور كما لو أنّها تنير المستقبل

278
00:23:15,180 --> 00:23:20,810
الوعد الّذي يربطنا، المغامرة التي نتشاركها

279
00:23:20,980 --> 00:23:26,980
من جديد في هذا العالم

280
00:23:33,740 --> 00:23:39,040
حتّى غيغا ستراش الخاصّة بداي لم تفلح
ضدّ حارس السّماء والأرض الشّيطاني

281
00:23:39,200 --> 00:23:43,290
يحاول فارن أن يجعل ليونا خادمته
ليُشعِر داي باليأس

282
00:23:43,460 --> 00:23:47,960
مُواجِهاً مُقاومة شرسة، يُظهِر آثار
غضب شديد للمرّة الأولى

283
00:23:48,130 --> 00:23:52,470
مع وقوع داي في ورطة من جديد، يصل بوب والآخرون

284
00:23:52,640 --> 00:23:54,800
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

285
00:23:54,970 --> 00:23:56,640
"جوهرة العين"

286
00:23:56,810 --> 00:23:59,310
!وتستمرّ المغامرة