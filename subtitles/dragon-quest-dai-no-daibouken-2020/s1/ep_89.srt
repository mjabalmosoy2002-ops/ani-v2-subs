1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:01:42,100 --> 00:01:50,480
تعويذة الزمن المُتوقِّف السرّية

20
00:01:55,900 --> 00:02:01,620
لكن لا يمكن لمُهرّج بسيط أن يعرف اسم هذه التّعويذة

21
00:02:01,780 --> 00:02:03,740
من هذا الرّجل بالضبط؟

22
00:02:03,910 --> 00:02:06,910
لحظة، أليس هو هنا لأجل الشّفاء فقط؟

23
00:02:07,080 --> 00:02:09,330
!هذا جنون يا كبير المُعلّمين

24
00:02:10,130 --> 00:02:11,130
...كبير المُعلّمين

25
00:02:12,500 --> 00:02:13,840
...أعتمد عليك

26
00:02:15,300 --> 00:02:16,510
يا بوب

27
00:02:39,860 --> 00:02:41,160
...هذه الحركة

28
00:02:41,320 --> 00:02:42,320
!مُذهل

29
00:02:42,490 --> 00:02:46,700
!وكأنّه يُقاتل ريشة

30
00:02:46,870 --> 00:02:52,670
،بالنسبة لشخص يستطيع التحرّك هكذا
الاقتراب هو أكثر أمانً

31
00:02:52,830 --> 00:02:55,880
!يُقاتل وكأنّه يحفظ الفنون القتاليّة عن ظهر قلب

32
00:02:57,260 --> 00:02:59,050
!كُفّ عن التعلُّق بي

33
00:03:00,090 --> 00:03:01,130
!بوب

34
00:03:01,300 --> 00:03:02,640
!الآن فُرصتك

35
00:03:03,300 --> 00:03:05,560
!حسناً! أعلم ذلك

36
00:03:07,350 --> 00:03:13,400
...ميدروا... ميدروا... بميدروا خاصّتي

37
00:03:14,650 --> 00:03:18,360
!بوب، لماذا تُطلِق تعويذتَي عمود جليد؟

38
00:03:18,530 --> 00:03:19,780
!ماذا؟

39
00:03:23,030 --> 00:03:24,120
...في الواقع

40
00:03:24,570 --> 00:03:27,830
هناك ضغط كبير على كتِفَي

41
00:03:29,160 --> 00:03:34,750
فقد كان كلّ شيء يعتمد دوماً في
النّهاية على داي أو هيونكل؟

42
00:03:35,210 --> 00:03:39,090
سأفعل ما يمكنني فعله ثمّ أسقط
أرضاً، وهو أمر لا أمانعه

43
00:03:39,590 --> 00:03:46,100
لأنّه لم يعتمد عليّ أحدٌ كملاذ أخير هكذا

44
00:03:46,260 --> 00:03:48,140
...أعلم أنّ هذا مُثير للشفقة

45
00:03:48,640 --> 00:03:52,520
لكن لا أستطيع الحركة كما أفعل عادة

46
00:03:55,230 --> 00:03:58,400
!غبيّ! هذا يُثبت كم أصبحتَ قويّاً

47
00:03:58,900 --> 00:04:03,070
كيف لك ألّا تستخدم القوّة الّتي
!عملتَ جاهداً لاكتسابها؟

48
00:04:04,070 --> 00:04:06,780
!حتّى كبير المُعلمين يفعل ما بوسعه

49
00:04:10,200 --> 00:04:11,250
!إصابة مُباشرة؟

50
00:04:15,710 --> 00:04:16,590
!بئساً

51
00:04:17,590 --> 00:04:19,130
!أيُعقَل هذا؟

52
00:04:20,550 --> 00:04:24,720
بهذا الجسد الذابِل الجافّ المُدرّب جيّداً

53
00:04:24,890 --> 00:04:31,180
يمكنني العَوم كورقة شجر في الرّياح
!وامتصاص قوّة هجمات العدوّ

54
00:04:31,640 --> 00:04:34,600
إنّها إحدى المهارات المُطلَقة لأسلوب قتالي

55
00:04:35,310 --> 00:04:40,030
وتلك الضربة قد قطعت الشكّ باليقين

56
00:04:41,150 --> 00:04:44,320
جسدُك بارد بصورة عجيبة

57
00:04:45,110 --> 00:04:47,120
كما ذلك الوقت

58
00:04:47,280 --> 00:04:52,000
منذ أكثر من عقد، عندما قاتَلنا
!ملك الشّياطين هادلَر

59
00:04:52,160 --> 00:04:52,950
!ماذا؟

60
00:04:53,620 --> 00:04:57,210
!هادلَر؟! ما أدراك بهادلَر؟

61
00:04:58,460 --> 00:05:04,220
...قاتلتُ ملك الشّياطين منذ زمن بعيد

62
00:05:04,380 --> 00:05:05,550
رفقة أفان

63
00:05:05,720 --> 00:05:07,140
!ماذا؟

64
00:05:09,010 --> 00:05:14,980
آنذاك، أطلقَ أفان تعويذة أسطوريّة
للمرّة الأولى والأخيرة

65
00:05:15,140 --> 00:05:16,560
...كانت تلك التّعويذة

66
00:05:17,600 --> 00:05:20,360
!تعويذة الزمن المُتوقّف السرّية

67
00:05:21,020 --> 00:05:24,820
كان ذلك قبل 17 عاماً

68
00:05:25,530 --> 00:05:30,660
،آنذاك، أفان البطل سافرَ مع روكا
مُحارب ليرا، والكاهن

69
00:05:30,830 --> 00:05:33,580
في رحلة لهزيمة ملك الشّياطين

70
00:05:33,750 --> 00:05:35,870
!تعويذة الزمن المُتوقِّف السرّية؟

71
00:05:37,500 --> 00:05:38,920
ما هي هذه بالضبط؟

72
00:05:40,090 --> 00:05:41,630
إنّها تُوقف الزمن

73
00:05:41,800 --> 00:05:42,880
،بصيغة أخرى

74
00:05:43,050 --> 00:05:48,590
إنّها تعويذة تُوقِف زمن الشّخص
وتثبّته مكانه إلى أجل غير مُسمّى

75
00:05:49,220 --> 00:05:54,180
من يُصابُ بها تُشَلُّ حركته تماماً
،وكأنّ تعويذة تحصين قد أُطلِقت

76
00:05:54,350 --> 00:05:57,310
ويصبح منيعاً لأيّ قوّة

77
00:05:57,480 --> 00:06:04,530
لكن بخلاف تحصين، تتوقّف الوظائف الحيويّة أيضاً

78
00:06:05,030 --> 00:06:09,410
فأساساً، أوقفت زمنه بحدِّ ذاته

79
00:06:09,570 --> 00:06:13,330
وهي ليست مجرّد تعويذة لحماية النفس

80
00:06:13,790 --> 00:06:16,450
يمكنها أن تختم على عدوّ أيضاً

81
00:06:16,960 --> 00:06:21,380
تنوي إذاً هزيمة هادلَر، ملك الشّياطين
بهذه يا سيّد أفان؟

82
00:06:21,540 --> 00:06:24,840
أهزمه. لكن لا أستطيع قتله

83
00:06:25,010 --> 00:06:30,840
لكن سيُختَم عليه للأبد وذلك كي
يعمّ السّلام في العالم من جديد

84
00:06:31,010 --> 00:06:33,510
...يعمّ السّلام في العالم

85
00:06:33,680 --> 00:06:38,890
بحثتُ حول هذه التّعويذة باستخدام
مُجلّدات قديمة لذا ينبغي أن تنجح

86
00:06:39,060 --> 00:06:41,480
لكن اليوم فُرصتنا الأخيرة لإطلاقها

87
00:06:42,190 --> 00:06:46,400
أثناء كسوف شمسيّ كامل يحدث مرّة
في كلّ عدّة قرون

88
00:06:46,570 --> 00:06:48,740
...مرّة في كلّ عدّة قرون

89
00:06:52,160 --> 00:06:57,540
!حسناً! أحسنت أيّها البطل الذكيّ
!اكتشاف جيّد لهذه التّعويذة

90
00:06:58,120 --> 00:07:04,000
لطالما احترمتُ ذكاءك! أليس كذلك؟

91
00:07:04,540 --> 00:07:07,300
!لنعمل على هذا إذاً

92
00:07:07,460 --> 00:07:12,300
!لننتهز فُرصة العمر هذه

93
00:07:12,470 --> 00:07:14,010
...مع الأسف

94
00:07:14,180 --> 00:07:16,390
لن نكون جميعنا

95
00:07:18,100 --> 00:07:20,020
...روكا... ليرا

96
00:07:20,600 --> 00:07:24,480
لا يمكنني إقحامكما في هذه المعركة معي

97
00:07:24,650 --> 00:07:25,440
...ما

98
00:07:27,110 --> 00:07:30,150
!ماذا؟! عمّاذا تتكلّم؟

99
00:07:30,320 --> 00:07:33,370
قلتُ ما قصدتُه تماماً

100
00:07:33,530 --> 00:07:37,450
أعني بأنّ هذا الفريق يجب أن يُحَلّ مؤقّتاً

101
00:07:39,290 --> 00:07:41,710
سيّد أفان، لماذا تقول ذلك؟

102
00:07:42,330 --> 00:07:45,670
هذه التّعويذة السرّية لم تُفهَم أبعادها جيّداً بعد

103
00:07:45,920 --> 00:07:51,880
إنّها تستخدم قوّةَ الطبيعة لذا ينبغي
أن تؤثّر بملك الشّياطين

104
00:07:52,050 --> 00:07:52,880
...لكن

105
00:07:53,050 --> 00:07:57,930
لا أعلم ما إن كنتُ أستطيع تحمّل
الآثار الرجعيّة للتعويذة

106
00:07:58,470 --> 00:08:00,390
...في أسوأ الحالات

107
00:08:00,560 --> 00:08:03,230
!ستتأثّر بالزمن المُتجمِّد؟...

108
00:08:04,650 --> 00:08:06,820
،حتّى لو اكتسبنا السّلام

109
00:08:06,980 --> 00:08:10,570
لا جدوى منه إذا لم يستمتع به أحد

110
00:08:10,940 --> 00:08:14,030
أريدكم أن تدعوا هذا الأمر لي

111
00:08:14,780 --> 00:08:16,320
!أحمق

112
00:08:16,990 --> 00:08:20,120
ماذا؟! إنّهما يتشاجران؟

113
00:08:20,290 --> 00:08:25,580
دائماً ما يتشاجران. لكن هذه المرّة
بجدّية أكبر من المعتاد

114
00:08:25,960 --> 00:08:31,460
لمَ لا نستطيع التعاون جميعاً معاً
!للقتال كما كنّا نفعل دوماً؟

115
00:08:31,630 --> 00:08:32,720
كما العادة

116
00:08:33,470 --> 00:08:37,260
!لن أضحّي بك فقط كي نفوز

117
00:08:37,970 --> 00:08:40,600
لا أستطيع السّماح بذلك يا روكا

118
00:08:40,770 --> 00:08:41,810
!ماذا؟

119
00:08:41,980 --> 00:08:44,520
استيعابك بطيء فعلاً

120
00:08:45,020 --> 00:08:49,480
عليك أن تنجو لتعتني بالمرأة التي تحبّها

121
00:08:52,240 --> 00:08:54,860
أتعلم بأمرنا؟

122
00:08:55,610 --> 00:09:00,410
!مخطئ! لستُ جادّاً حيال هذه الفتاة

123
00:09:00,580 --> 00:09:02,450
!هذه الفتاة"؟" -
!أجل -

124
00:09:03,790 --> 00:09:05,830
!انتظري! لم أقصد من هذه النّاحية

125
00:09:07,210 --> 00:09:09,750
لم تكن جادّاً فعلاً إذاً؟

126
00:09:09,920 --> 00:09:11,500
دعني أشرح

127
00:09:11,670 --> 00:09:14,800
...هذا سيّئ. عليك أن تتحمّل المسؤوليّة

128
00:09:15,380 --> 00:09:17,090
بما أنّك ستكون أباً

129
00:09:23,560 --> 00:09:25,390
...أ-أايُّها

130
00:09:26,900 --> 00:09:32,320
سيّد أفان، كنتَ تعلم بأنّني حامل بطفلنا؟

131
00:09:32,780 --> 00:09:35,280
لم أخبر روكا حتّى

132
00:09:35,610 --> 00:09:38,490
روكا خجول جدّاً

133
00:09:38,660 --> 00:09:41,240
حتّى لو عَلِمَ بذلك، سيُحاول إخفاء الأمر

134
00:09:41,410 --> 00:09:48,330
"لطالما كان يقول "أعيش على السّيف
"أو "لن أقع أبداً في حبّ فتاة

135
00:09:49,250 --> 00:09:53,130
أعلم بأنّه مُزعج، لكن اعتني به رجاء

136
00:09:54,380 --> 00:09:59,890
أعتقد بأنّ الطفل المولود في زمن
حرب يستحقُّ العيش بسلام

137
00:10:02,220 --> 00:10:06,430
امنحيه اسماً جميلاً يا ليرا

138
00:10:06,810 --> 00:10:08,310
سيّد أفان

139
00:10:14,070 --> 00:10:15,780
هكذا هو طبعه

140
00:10:16,820 --> 00:10:18,110
!ماتوريف

141
00:10:18,280 --> 00:10:24,040
سيُخاطر بحياته لحماية الطفل الّذي سيُولَد

142
00:10:25,200 --> 00:10:27,500
ولديه الجرأة ليتكلّم عن الخجل

143
00:10:27,960 --> 00:10:30,920
إنّه بمثل غباء أيّ شخص آخر

144
00:10:32,630 --> 00:10:34,420
دعيه لي فحسب

145
00:10:34,590 --> 00:10:37,010
لا أملك عائلة أحزن عليها

146
00:10:37,170 --> 00:10:40,680
سأحرص على ألّا يموت أفان

147
00:10:40,840 --> 00:10:44,470
سأحرص على ألّا أدع النساء يبكين

148
00:10:47,100 --> 00:10:49,710
هيّا بنا يا بروكينا

149
00:11:12,460 --> 00:11:18,130
أنا آسف يا كبير المُعلّمين لإقحامك
في معركة خطيرة كهذه

150
00:11:18,300 --> 00:11:21,010
لا تقلق بشأني

151
00:11:22,930 --> 00:11:26,100
بمرضي، لم يبقَ لي الكثير على أيّ حال

152
00:11:26,260 --> 00:11:27,680
هذا الكلام من جديد

153
00:11:28,520 --> 00:11:29,770
أعتمد عليك

154
00:11:30,140 --> 00:11:33,440
شتّت انتباه ملك الشّيطاين فحسب ولو لوهلة

155
00:11:34,190 --> 00:11:38,860
فهذا إنجاز وحدك، مُتقن الفنون القتاليّة
الأفضل، يستطيع تحقيقه

156
00:11:40,610 --> 00:11:43,280
هل أنا مشهور أو ما شابه؟

157
00:11:43,450 --> 00:11:49,120
أجل. مثلي، أنت أحد العجائز الأقلّاء
الشّهيرين في العالم

158
00:11:55,340 --> 00:11:57,960
سأتولّى أمر الباقي

159
00:11:58,550 --> 00:12:00,010
بالتوفيق لك

160
00:12:14,060 --> 00:12:18,820
تقنيّة ستراش والسّيف خاصّتي
ما زالت غير مكتملة

161
00:12:19,400 --> 00:12:25,410
هذه هي الطريقة الوحيدة لتحقيق
!السّلام هنا والآن

162
00:12:36,830 --> 00:12:37,960
!لهيب

163
00:12:39,300 --> 00:12:40,920
!عاصفة

164
00:12:43,340 --> 00:12:44,380
!دويّ

165
00:13:11,580 --> 00:13:13,910
!تعويذة الزمن المُتوقِّف السرّية

166
00:13:21,380 --> 00:13:22,590
!لا

167
00:13:23,050 --> 00:13:26,760
...لستُ قويّاً بما يكفي بعد كي

168
00:13:56,290 --> 00:14:01,420
،هادلَر وأفان تجمَّدا

169
00:14:01,590 --> 00:14:03,340
ولم ترمش لهما عين

170
00:14:03,500 --> 00:14:10,220
ولأكثر من عام، بقي زمنهما مُتوقّفاً

171
00:14:11,760 --> 00:14:17,390
وهكذا، حقّقَ البطل سلاماً قصيراً للعالم

172
00:14:18,230 --> 00:14:21,940
،عندما أتيتِ إليّ سعياً للتدريب

173
00:14:22,110 --> 00:14:24,900
شعرتُ حقّاً بأنّ يد القدَر قد تدخّلتْ

174
00:14:26,360 --> 00:14:27,240
هذا صحيح

175
00:14:27,780 --> 00:14:32,490
...الطفل المولود من صلب روكا وليرا

176
00:14:33,530 --> 00:14:36,200
كان أنتِ يا مام...

177
00:14:37,620 --> 00:14:38,920
...كبير المُعلّمين

178
00:14:39,870 --> 00:14:41,130
هكذا إذاً

179
00:14:41,540 --> 00:14:45,800
إذاً كان كبير المُعلّمين عضواً في
فريق المُعلّم أفان

180
00:14:46,170 --> 00:14:49,050
عرفتُ بأنّه أقوى ممّا بدا

181
00:14:49,590 --> 00:14:51,260
الآن قد فهمت

182
00:14:51,430 --> 00:14:53,890
،بما أنّك كنتَ حليف أفان

183
00:14:54,060 --> 00:14:57,270
فلا عجب في أنّك تعرف هذه التّعويذة السرّية

184
00:14:58,850 --> 00:15:00,310
،لكن يا كبير المُعلّمين

185
00:15:00,480 --> 00:15:05,780
ألا يُفترض لتعويذة الزمن المُتوقّف
السرّية أن تُوقِف هدفها؟

186
00:15:05,940 --> 00:15:10,200
إذا أُطلِقَتْ عليه، ألا ينبغي ميستوفارن
أن يتوقّف عن الحركة؟

187
00:15:10,360 --> 00:15:11,780
الأمر ليس كذلك

188
00:15:11,950 --> 00:15:17,580
إنّه يستخدم قوّة تلك التّعويذة السرّية للقتال

189
00:15:17,750 --> 00:15:19,370
هذا ما أعتقده

190
00:15:19,540 --> 00:15:23,170
،لا أعلم كيف يفعلها

191
00:15:23,330 --> 00:15:29,670
لكن ما زال يستطيع التحرّك رغم إطلاق
تعويذة الزمن المُتوقِّف السرّية عليه

192
00:15:30,220 --> 00:15:33,140
زمنه بحدِّ ذاته مُتوقِّف

193
00:15:33,300 --> 00:15:37,010
وأصبح جسده نتيجة ذلك لا يُقهَر

194
00:15:37,180 --> 00:15:41,810
لذا هو لا يتلقّى أيّ ضرر ومنيع
أمام أيّ هجمة جسديّة

195
00:15:41,980 --> 00:15:47,190
هذا أشبه بالقتال أثناء الخضوع
لتأثيرات تعويذة تحصين

196
00:15:51,030 --> 00:15:52,740
هذا صحيح

197
00:15:53,570 --> 00:15:55,740
لكن ألا ترى؟

198
00:15:55,910 --> 00:16:00,370
حكمت على نفسك بالموت

199
00:16:01,620 --> 00:16:04,750
يمكنني القتال أثناء توقُّف زمني

200
00:16:05,380 --> 00:16:09,550
هذا يعني... بأنّني منيع تماماً

201
00:16:11,130 --> 00:16:12,590
!معه حقّ

202
00:16:12,760 --> 00:16:16,640
العدوّ الّذي ما زال يستطيع الهجوم
تحت تأثير تعويذة تحصين

203
00:16:16,800 --> 00:16:18,510
!هو شخص لا يُهزَم

204
00:16:18,680 --> 00:16:21,140
لا تخف يا بوب

205
00:16:21,930 --> 00:16:25,310
التّعويذة الّتي ورّثَها ماتوريف لك

206
00:16:25,480 --> 00:16:27,570
تُعَدُّ استثناء

207
00:16:28,570 --> 00:16:30,650
،في ذلك اليوم

208
00:16:30,820 --> 00:16:35,110
لم يستطع ماتوريف فعل شيء بينما
يرى أفان يضحّي بنفسه

209
00:16:35,280 --> 00:16:41,830
وبعد أن أضناه تأنيب الضّمير، التّعويذة
...التي ابتكرَها للمعركة الأخيرة كانت

210
00:16:42,000 --> 00:16:43,870
!تعويذة الإبادة القصوى...

211
00:16:44,250 --> 00:16:45,790
!ميدروا

212
00:16:45,960 --> 00:16:47,130
أجل

213
00:16:47,920 --> 00:16:50,000
أنت مجرّد ورقة شجر جافّة

214
00:16:50,630 --> 00:16:52,920
إن أمسكتُ بك، سأبيدك

215
00:16:53,260 --> 00:16:58,390
إذا كان التّفادي هو كلّ ما تستطيع
فعله، فإنّ لارهارت خصمٌ أقوى

216
00:17:00,390 --> 00:17:02,810
!فلتتمزّق إلى أشلاء أيُّها المُهرّج

217
00:17:02,980 --> 00:17:03,770
!كبير المُعلّمين

218
00:17:12,940 --> 00:17:15,360
!لحظة هي كلّ ما أحتاجه

219
00:17:15,530 --> 00:17:19,240
!أعد إليّ القوّة التي كنتُ أمتلكها

220
00:17:19,950 --> 00:17:24,460
!هنا من جديد! لإنقاذ الجيل المُقبل

221
00:17:32,090 --> 00:17:33,300
!مُذهل

222
00:17:33,460 --> 00:17:37,550
لو لم يكن ميستوفارن، لأجهزَتْ عليه
!تلك الهجمة الأولى

223
00:17:38,090 --> 00:17:41,810
لم أكن أعلم بأنَّ كبير المُعلّمين
!يقاتل هكذا وهو بكامل قوّته

224
00:17:44,600 --> 00:17:45,690
!بوب

225
00:17:45,850 --> 00:17:50,650
!أنا أتحرّق للبدء! لن تخفق هذه الطلقة

226
00:17:53,320 --> 00:17:54,400
!بوب

227
00:17:55,070 --> 00:17:57,570
كانوا مُذهلين حقّاً

228
00:17:58,160 --> 00:18:00,700
!كلّ أصدقاء المُعلّم القدامى

229
00:18:01,780 --> 00:18:07,080
جميعنا هنا الآن بفضل العُظماء
!الّذين أتوا قبلنا

230
00:18:07,540 --> 00:18:11,960
،إن لم أستطع تحقيق هذه الإصابة،
!فلستُ تلميذ أفان

231
00:18:13,210 --> 00:18:14,960
!سوف أفعلها

232
00:18:16,420 --> 00:18:21,640
!سأصيبه بميدروا هذه ولو على جثّتي

233
00:18:23,060 --> 00:18:29,650
نهضَ على قدميه من جديد. هذا
العِناد هو ما يجعله تلميذ أفان

234
00:18:34,820 --> 00:18:37,490
!كفى مُقاومة عقيمة

235
00:18:40,620 --> 00:18:41,990
!اللّعنة عليك

236
00:18:48,000 --> 00:18:49,000
!حسناً

237
00:18:55,880 --> 00:18:57,130
!كبير المُعلّمين

238
00:18:59,680 --> 00:19:03,550
:أسلوب المُعلّم المُحارب
!ضربة انبثاق تنين الأرض

239
00:19:05,510 --> 00:19:07,270
!بوب، الآن

240
00:19:15,190 --> 00:19:16,230
!حسناً

241
00:19:25,160 --> 00:19:26,660
!كانت فاشلة

242
00:19:28,910 --> 00:19:29,960
!كبير المُعلّمين

243
00:19:30,790 --> 00:19:32,040
هكذا إذاً

244
00:19:32,460 --> 00:19:37,420
كان من المُمكن لتلك التّعويذة أن تهزمني

245
00:19:37,800 --> 00:19:41,930
يمكنني أن أصمد لدقيقة فقط بكامل قوّتي

246
00:19:42,760 --> 00:19:46,310
العمر له حقّه فعلاً

247
00:19:47,260 --> 00:19:51,560
المدّة أقصر حتّى ممّا كانت
عندما قاتلتُ هادلَر

248
00:19:54,270 --> 00:19:59,690
خطّتكم الإعجازيّة لقلب موازين
المعركة... قد انتهت

249
00:20:00,070 --> 00:20:03,950
أم أنّك ستُطلِق تعويذتك وتضحّي به؟

250
00:20:04,120 --> 00:20:04,990
!كبير المُعلّمين

251
00:20:05,160 --> 00:20:08,790
هذا لا يهمّ يا بوب. أطلِق التّعويذة

252
00:20:08,950 --> 00:20:12,790
لم يبقَ الكثير لأعيش على أيّ حال

253
00:20:12,960 --> 00:20:15,580
!هذا أفضل من أن تموتوا جميعكم

254
00:20:18,800 --> 00:20:21,970
!أعلم ذلك يا كبير المُعلّمين

255
00:20:24,550 --> 00:20:25,890
!بوب

256
00:20:26,640 --> 00:20:28,600
كفى خِداعاً

257
00:20:29,560 --> 00:20:33,440
أنتم تلاميذ العدالة لا يمكنكم فعل ذلك أبداً

258
00:20:33,600 --> 00:20:34,900
!بل أستطيع

259
00:20:35,060 --> 00:20:37,190
!أعلم بأنّني أستطيع الآن

260
00:20:38,520 --> 00:20:40,360
...وهذه المرّة

261
00:20:41,360 --> 00:20:47,490
سندع كبير المُعلّمين والمُعلّم يستمتعان
!بالسّلام الّذي اكتسبناه

262
00:20:48,030 --> 00:20:49,200
ماذا؟

263
00:20:49,660 --> 00:20:51,250
!ها أنا ذا

264
00:20:51,750 --> 00:20:54,290
!ميدروا

265
00:20:57,840 --> 00:20:58,880
!عودة

266
00:21:07,140 --> 00:21:08,680
!لا يستطيع تجنُّب ذلك

267
00:21:08,850 --> 00:21:11,770
!أصيبيه! بخِّريه

268
00:21:14,520 --> 00:21:15,690
!لقد ربحنا

269
00:21:45,590 --> 00:21:46,840
!كبير المُعلّمين

270
00:21:47,260 --> 00:21:48,300
!بوب

271
00:21:49,050 --> 00:21:51,390
!اختفيا

272
00:22:11,030 --> 00:22:17,670
أخبرني، إلى أين أنت ذاهب بمفردك؟

273
00:22:20,540 --> 00:22:28,220
أحدّق بك من الخلف بينما تمضي بعيداً

274
00:22:30,220 --> 00:22:36,020
أخبرني، إلى أين أنت ذاهب بمفردك؟

275
00:22:39,810 --> 00:22:45,230
ندّعي الصّلابة ونتّبع أهواءنا

276
00:22:45,400 --> 00:22:49,660
وبدأنا بهذه الحكاية معاً

277
00:22:50,160 --> 00:22:55,950
هناك شيء يلمع وراء الأفق

278
00:22:56,120 --> 00:23:02,330
كنّا نبحث عن شيء ما

279
00:23:03,960 --> 00:23:09,170
في السّماء البعيدة، يتراقص في الهواء

280
00:23:09,340 --> 00:23:14,970
تغرّد الطّيور كما لو أنّها تنير المستقبل

281
00:23:15,140 --> 00:23:20,770
الوعد الّذي يربطنا، المغامرة التي نتشاركها

282
00:23:20,940 --> 00:23:26,940
من جديد في هذا العالم

283
00:23:34,030 --> 00:23:38,700
يختفي بوب وبروكينا بعد تلقّي الميدروا
الّتي عكسَها ميستوفارن

284
00:23:38,870 --> 00:23:43,540
،يكتشف هيونكل سرَّ ميستوفارن
لكن يظهر كيلفارن

285
00:23:43,710 --> 00:23:46,050
وتُمسي هزيمة أفان جليّة

286
00:23:46,210 --> 00:23:48,460
،بعد أن يخيّم اليأس على الأبطال

287
00:23:48,630 --> 00:23:54,430
تنكشف العلاقة الّتي دامت قرون
بين الاثنين اللّذين يحملان اسم فارن

288
00:23:54,600 --> 00:23:56,810
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

289
00:23:58,600 --> 00:24:00,560
!وتستمرّ المغامرة