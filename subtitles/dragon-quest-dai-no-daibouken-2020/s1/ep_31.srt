1
00:00:10,920 --> 00:00:15,680
أحبّ نفسي حقاً

2
00:00:15,840 --> 00:00:20,100
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

3
00:00:20,270 --> 00:00:23,890
لا يهمّ إلى أين تقودنا هذه الرحلة

4
00:00:32,740 --> 00:00:36,070
منذ متى كان ذلك؟

5
00:00:36,240 --> 00:00:38,990
أمسى الصدق أنيناً

6
00:00:39,160 --> 00:00:41,540
أصبح الصمود قوّة

7
00:00:41,700 --> 00:00:44,830
ألم تجدها بعد؟

8
00:00:45,000 --> 00:00:49,210
ليست الثقة، بل ذاتك الحقيقية

9
00:00:50,500 --> 00:00:54,720
لا بدّ أنّ هناك شيء نسيتُه
وما زلتُ لم أجده

10
00:00:54,880 --> 00:00:59,050
كلمات أريد قولها وما زلتُ لم أقلها

11
00:00:59,220 --> 00:01:04,390
لو راقبتني، لسحرتُك

12
00:01:04,560 --> 00:01:09,400
أحبّ نفسي حقاً

13
00:01:09,570 --> 00:01:13,570
أما من مشكلة إذا ظللتُ أؤمن بذلك؟

14
00:01:13,740 --> 00:01:17,610
أشتعل حماساً

15
00:01:17,780 --> 00:01:22,700
لا يهمّ إلى أين تقودنا هذه الرحلة

16
00:01:22,870 --> 00:01:27,670
سأفتح عينيّ فحسب

17
00:01:27,830 --> 00:01:31,420
وأسرح في حلمي

18
00:01:31,590 --> 00:01:33,760
وأتعمّق في حلمي

19
00:01:51,020 --> 00:01:53,070
!لن أستسلم

20
00:01:53,230 --> 00:01:54,990
!أنا هو أنا

21
00:01:55,650 --> 00:01:57,860
!أنا داي البطل

22
00:02:00,320 --> 00:02:05,330
!ما زلتَ تُقاوم أباك؟! أحمق

23
00:02:05,500 --> 00:02:08,830
...لستَ

24
00:02:10,040 --> 00:02:12,420
!لستَ أبي

25
00:02:21,140 --> 00:02:22,470
!ماذا؟

26
00:02:22,640 --> 00:02:26,770
ضربَني بينما كنتُ أحمي نفسي
!بهالتي التنّينيّة؟

27
00:02:31,060 --> 00:02:31,690
!ماذا؟

28
00:02:36,860 --> 00:02:39,570
!شارةُ داي في قبضتِه؟

29
00:02:39,990 --> 00:02:43,120
!ماذا؟! مستحيل! هذا غير مُمكن

30
00:02:43,660 --> 00:02:47,330
في آلاف السّنوات من تاريخ فارس التنّين

31
00:02:47,500 --> 00:02:51,960
أن يشعّ ضوء الشّارة ليظهر في مكان
...آخر غير الجبين

32
00:02:52,130 --> 00:02:54,460
!لم يحدث هذا من قبل

33
00:02:55,590 --> 00:02:56,550
!أيُعقَل أنّه...؟

34
00:02:57,710 --> 00:02:59,760
!روح البشر؟

35
00:02:59,930 --> 00:03:03,050
!أهذه إرادة سوالا؟

36
00:03:10,640 --> 00:03:12,100
...داي

37
00:03:12,560 --> 00:03:18,570
!ما-ما الّذي يجري؟! لماذا شارة التنِّين في قبضتِه؟

38
00:03:18,740 --> 00:03:22,820
أعتقِد أنَّ داي فعلَها بإرادتِه الخاصَّة

39
00:03:22,990 --> 00:03:23,870
!ماذا؟

40
00:03:24,030 --> 00:03:26,790
...الإفلات من تحكُّم باران الذهنيّ

41
00:03:27,410 --> 00:03:29,870
...واكتساب قوّة أعظم من قوّته

42
00:03:30,040 --> 00:03:35,880
ارتأى أنّه يترتّب عليه نقل قوّة شارته من جبينه

43
00:03:36,590 --> 00:03:41,170
لعلّ قوّة هالته الكاملة أضعف، لكن
،عندما يتمُّ تركيزها في نقطة واحدة

44
00:03:41,340 --> 00:03:43,890
!تُصبِح كلّ هجمة أقوى

45
00:03:46,260 --> 00:03:49,390
!هل مُعجزة كهذه مُمكنة؟

46
00:03:49,560 --> 00:03:53,770
أشكُّ في أن يستطيع فارس تنِّين عاديّ فعل ذلك

47
00:03:53,940 --> 00:03:56,570
حتّى باران يبدو مذهولاً

48
00:03:56,730 --> 00:04:00,150
!حضِّر نفسك يا باران

49
00:04:01,110 --> 00:04:02,240
!ماذا؟

50
00:04:02,400 --> 00:04:05,280
!سلبت منّي أشياء كثيرة

51
00:04:05,570 --> 00:04:06,580
...أشيائي

52
00:04:07,330 --> 00:04:10,000
!أشيائي العزيزة

53
00:04:10,370 --> 00:04:15,330
!حتّى لو كنتَ أبي، لن أُسامحك أبداً

54
00:04:16,290 --> 00:04:18,670
!سوف أسحقك

55
00:04:32,770 --> 00:04:36,610
!صُن لسانك يا فتى

56
00:05:01,130 --> 00:05:02,300
!مُذهِل

57
00:05:02,710 --> 00:05:04,880
...أنا أخمِّن، لكن

58
00:05:05,050 --> 00:05:10,680
أعتقد أنَّ دماء نصف البشريّ الخاص
بداي هو ما حقّق هذه المُعجزة

59
00:05:11,470 --> 00:05:15,060
،مشاعره لصديقِه أوقدت ناراً في قلبِه البشريّ

60
00:05:15,230 --> 00:05:18,150
ليدفع بقوى التنِّين والظّلام إلى قبضتِه

61
00:05:18,520 --> 00:05:21,440
!وهذا ما منحَ داي قدرة التحكُّم بقوّته

62
00:05:26,450 --> 00:05:28,620
!تعني الآن أنَّ داي...؟

63
00:05:28,780 --> 00:05:35,160
ينبغي أن يكون قد اكتسب السّيطرة الكاملة
على قوّة شارة التنّين

64
00:05:39,750 --> 00:05:40,960
...سوالا

65
00:05:41,130 --> 00:05:46,550
حتّى أنتِ... هل تقولين أنّني مخطئ؟

66
00:05:47,050 --> 00:05:48,010
!اللّعنة عليك

67
00:05:55,810 --> 00:05:57,690
!الهالة التنّينيّة

68
00:06:26,590 --> 00:06:27,840
!مستحيل

69
00:06:28,010 --> 00:06:33,640
أجل! معك حقّ! باتت كلّ هجمة من
!هجمات داي أقوى

70
00:06:35,060 --> 00:06:36,350
...لكن

71
00:06:46,860 --> 00:06:51,160
!هذا هُراء! مُحال لطفل أن يهزم والده

72
00:06:52,200 --> 00:06:56,450
!حان وقتُ التّراجع أو فتحتُ فجوة في جسدِك

73
00:06:57,450 --> 00:07:02,630
،إذا أطلقتُ شعاعَ شارتي بكامل قوّته
!يُمكن أن يقطع جبلاً

74
00:07:03,590 --> 00:07:05,460
!وماذا لو كان كذلك؟

75
00:07:06,090 --> 00:07:08,800
!هل أنت متأكّد يا دينو؟

76
00:07:09,930 --> 00:07:11,130
...اسمي

77
00:07:11,470 --> 00:07:13,390
!اسمي داي

78
00:07:17,020 --> 00:07:18,310
!خذ هذه

79
00:07:33,870 --> 00:07:35,660
!جلالتك، ماذا كان ذلك؟

80
00:07:36,160 --> 00:07:38,370
فارسا التنِّين

81
00:07:41,250 --> 00:07:42,540
كُفّ عن التحفُّظ

82
00:07:44,330 --> 00:07:45,590
!ماذا؟

83
00:07:46,250 --> 00:07:48,130
...الآخرون خصوم سهلة

84
00:07:49,130 --> 00:07:51,630
!لكن أنا لستُ كذلك

85
00:07:53,800 --> 00:07:58,810
!لا تغترّ بنفسك أيّها الطفل الشقيّ

86
00:07:59,390 --> 00:08:03,060
!لا يا داي! لا تُغضِب باران أكثر

87
00:08:03,230 --> 00:08:06,980
!لم يُظهِر كامل قوّته بعد

88
00:08:08,020 --> 00:08:09,690
...مُذهِل يا داي

89
00:08:10,320 --> 00:08:12,240
قد نملك فرصة

90
00:08:13,570 --> 00:08:14,660
!ميرلي

91
00:08:16,200 --> 00:08:18,410
الأميرة ليونا، دعيني أستخدم شفاء

92
00:08:18,580 --> 00:08:21,540
انسي أمري. عالِجي كروكوداين وهيونكل

93
00:08:21,710 --> 00:08:23,870
...حسناً. لكن... المعذرة

94
00:08:24,670 --> 00:08:26,710
دعي بوب لي

95
00:08:28,210 --> 00:08:33,340
لم أستخدمها قبلاً، لكن أريد تجربة تعويذة عليه

96
00:08:45,940 --> 00:08:47,150
!سـ-ستبدأ

97
00:08:47,310 --> 00:08:51,570
!أعظم معركة في العالم لا يُمكن لنا أن نستوعبها

98
00:09:17,010 --> 00:09:18,340
!اختفيا

99
00:09:18,510 --> 00:09:19,300
!في الأعلى

100
00:10:13,150 --> 00:10:14,150
!هل فعلَها؟

101
00:10:14,320 --> 00:10:15,570
!لا! انتبِه

102
00:10:16,240 --> 00:10:17,280
!انتهى الأمر

103
00:10:23,370 --> 00:10:25,660
!لا تسخر منِّي

104
00:10:47,310 --> 00:10:48,350
!جلالتك

105
00:10:48,520 --> 00:10:53,310
مُذهِل. هذه هي شراسةُ فرسان التنِّين إذاً

106
00:10:53,480 --> 00:10:54,940
هل سنكون بخير؟

107
00:10:55,320 --> 00:10:57,610
يجب أن نتّخذ قراراً

108
00:10:59,280 --> 00:11:02,950
أيُّ فارس تنِّين بينهما هو من على صواب

109
00:11:16,380 --> 00:11:17,670
!داي؟

110
00:11:17,840 --> 00:11:21,970
!كنتُ مُحقّاً. سيهلك داي على هذا المنوال

111
00:11:22,140 --> 00:11:23,800
!ماذا تعني؟

112
00:11:23,970 --> 00:11:29,180
حتّى اللّحظة، كان باران يتحفَّظ وذلك
كي لا يقتل داي

113
00:11:29,640 --> 00:11:34,190
حتَّى معنا، كان على الأرجح يتحفَّظ
لأنَّنا كنّا حُلفاء

114
00:11:34,360 --> 00:11:38,820
!لكنّه الآن تنِّين شيطان، وحش شيطاني فتَّاك

115
00:11:38,990 --> 00:11:43,780
إذا استُفزِّ بما يكفي، سيقتل أي شخص كائناً من كان

116
00:11:44,280 --> 00:11:45,200
!أتقصد...؟

117
00:11:45,910 --> 00:11:49,120
!حتّى لو كان ابنه

118
00:11:56,880 --> 00:11:58,460
!فلتحترِق

119
00:11:59,420 --> 00:12:01,470
!مع هذا البلد

120
00:12:05,850 --> 00:12:06,720
!لا

121
00:12:06,890 --> 00:12:08,350
!هذه دورورا؟

122
00:12:30,950 --> 00:12:32,290
...يدا باران

123
00:12:32,460 --> 00:12:34,040
!إنّه فم تنِّين

124
00:12:34,870 --> 00:12:36,460
!يا لها من طاقة

125
00:12:36,630 --> 00:12:41,550
فهمت! دورورا تضغط كمّيات هائلة من الهالة التنّينيّة

126
00:12:41,710 --> 00:12:43,590
!وتُطلقها كتعويذة

127
00:12:44,300 --> 00:12:45,890
!خذ هذه

128
00:12:46,640 --> 00:12:49,260
!انتبه! تفاداها يا داي

129
00:12:53,480 --> 00:12:54,810
!لن أدعك

130
00:12:55,230 --> 00:12:56,980
!دورورا

131
00:13:16,330 --> 00:13:21,590
!يا لها من قوّة! هذه لم تعُد تعويذة حتّى

132
00:13:22,550 --> 00:13:23,760
!أين داي؟

133
00:13:24,670 --> 00:13:26,510
!هل قضى عليه؟

134
00:13:46,490 --> 00:13:49,740
"فهمت. راوغتَ بتعويذة "عودة

135
00:13:49,910 --> 00:13:51,530
لديك غريزة ممتازة

136
00:13:52,120 --> 00:13:56,330
أفلتَ من حقل طاقة دورورا بتعويذة
!عودة قصيرة مُفاجئة

137
00:13:58,830 --> 00:14:00,710
!لن أخفق في المرّة الثانية

138
00:14:07,090 --> 00:14:08,180
!طيران

139
00:14:09,760 --> 00:14:14,560
!داي، لا يمكنك هزيمة باران في الهواء
!لديه أجنحة

140
00:14:18,900 --> 00:14:21,110
لماذا يختار التّحليق؟

141
00:14:21,270 --> 00:14:22,570
بسببِنا

142
00:14:23,440 --> 00:14:26,440
،إذا أطلق باران تلك التّعويذة الهائلة نحو هذا المكان

143
00:14:26,610 --> 00:14:29,410
!فسنصبح نحن وشعب تيران رماداً

144
00:14:29,820 --> 00:14:32,240
!لهذا حلّقَ داي نحو السّماء

145
00:14:32,410 --> 00:14:33,080
!...لكن

146
00:14:33,240 --> 00:14:38,410
حتّى أثناء غضبه، داي يبقى داي الذي نعرفه ضمنيّاً

147
00:14:39,540 --> 00:14:42,090
!إنّه ليس وحشاً مثل باران

148
00:14:43,250 --> 00:14:44,340
!داي

149
00:14:44,750 --> 00:14:46,630
!اشفينا بسرعة

150
00:14:47,420 --> 00:14:50,640
كلّ ما أريده هو النُّهوض! لا أستطيع
!البقاء مكتوف الأيدي

151
00:14:50,800 --> 00:14:51,640
!حسناً

152
00:14:53,640 --> 00:14:56,060
أرى أنَّك استسلمت

153
00:14:57,520 --> 00:14:59,350
!هذه ستُنهي الأمر

154
00:15:13,570 --> 00:15:16,620
!ماذا تظنُّ نفسك أنَّك تفعل؟

155
00:15:17,830 --> 00:15:19,540
!سأتحمّلها

156
00:15:21,250 --> 00:15:26,420
حتّى أنت لا تستطيع إطلاق تعويذة
!بتِلك القوّة أكثر من مرّتين

157
00:15:27,000 --> 00:15:29,510
...إذا تحمّلتُ هذه

158
00:15:29,670 --> 00:15:30,970
!سأفوز

159
00:15:32,510 --> 00:15:33,850
!ماذا؟

160
00:15:34,010 --> 00:15:35,350
!هذا جنون يا داي

161
00:15:35,760 --> 00:15:37,270
!أحمق

162
00:15:37,430 --> 00:15:43,650
لا يوجد كائن يستطيع تحمُّل دورورا
!خاصّة بفارس تنّين بكامل قوّتها

163
00:15:44,610 --> 00:15:47,280
!لم تُستخدَم من قبل على فارس تنِّين

164
00:15:48,150 --> 00:15:51,200
!أنا فارس تنِّين أيضاً

165
00:15:52,280 --> 00:15:54,950
!كفاك هُراء يا فتى

166
00:15:55,200 --> 00:15:57,080
!تجنّبها يا داي

167
00:15:57,240 --> 00:15:59,750
!فات الأوان على ذلك

168
00:16:01,080 --> 00:16:02,960
!خذ هذه واغرب عن وجهي

169
00:16:03,120 --> 00:16:05,460
!دورورا

170
00:16:08,840 --> 00:16:11,590
!يا أيُّها التنِّين في داخلي، حان وقتُ الاستيقاظ

171
00:16:12,090 --> 00:16:14,760
!ركِّز كلّ ما لديّ لهزيمتِه

172
00:16:15,220 --> 00:16:17,560
!الهالة التنّينيّة

173
00:16:35,240 --> 00:16:36,370
!داي؟

174
00:16:36,740 --> 00:16:37,620
!داي

175
00:16:49,300 --> 00:16:51,010
!لم يبقَ شيء

176
00:16:54,840 --> 00:16:56,140
!ما المُضحك في الأمر؟

177
00:16:57,470 --> 00:16:58,430
!أيُّها الوحش

178
00:17:12,400 --> 00:17:15,320
!تـ-تحمّلها! تِلك التّعويذة الخارقة

179
00:17:16,490 --> 00:17:17,570
!مستحيل

180
00:17:17,740 --> 00:17:18,780
!باران

181
00:17:19,240 --> 00:17:21,660
!لم يبقَ لك شيء الآن

182
00:17:28,500 --> 00:17:30,250
!خذ هذه

183
00:17:32,000 --> 00:17:34,220
...أفان

184
00:17:35,170 --> 00:17:36,840
!ستراش

185
00:17:48,650 --> 00:17:50,690
!سكّين ليونا؟

186
00:17:57,660 --> 00:17:59,410
مسكين

187
00:17:59,570 --> 00:18:03,660
عندما يقاتل فارسا تنِّين بعضهما الآخر
،بكامل قوّة هالتهما التنّينيّة

188
00:18:04,290 --> 00:18:09,330
لا تستطيع الأسلحة والدّروع العاديّة
!تحمّل القوّة وتحترق

189
00:18:09,500 --> 00:18:13,670
في حالتِك أنت، ركّزتَ كلّ قوّتك في ذراعِك اليُمنى

190
00:18:13,840 --> 00:18:18,590
لا يستطيع سِلاح في العالم تحمُّل
مثل هذه القوّة الهائلة

191
00:18:18,760 --> 00:18:19,970
!لا

192
00:18:20,140 --> 00:18:21,050
...لكن

193
00:18:21,800 --> 00:18:23,060
!هذا

194
00:18:25,020 --> 00:18:27,600
!نصل تنّين الشّيطان الخاص بي مُختلِف

195
00:18:28,270 --> 00:18:32,520
هذا هو السّيفُ الوحيدُ في العالم الّذي
!يستطيع تحمُّل الهالة التنّينيّة

196
00:18:33,770 --> 00:18:34,900
!تبّاً

197
00:18:35,070 --> 00:18:40,410
وحده هذا السّيف يستطيع تحمُّل تلويحة
!فارس تنِّين بكامل قوّتها

198
00:18:41,070 --> 00:18:46,200
،قد لا أمتلك القوّة السحريّة لإطلاق دورورا
!لكن النّصر حليفي

199
00:18:47,000 --> 00:18:49,040
!سأقطعك إلى نصفين

200
00:18:53,210 --> 00:18:54,170
!أنت؟

201
00:18:54,340 --> 00:18:57,170
!لن أدعك

202
00:18:59,680 --> 00:19:04,470
!كنتُ أُعرَف بملِك الوحوش البرّية
!لا أنوي البقاء مُستلقياً

203
00:19:10,390 --> 00:19:12,690
!تماسكوا جميعاً

204
00:19:14,980 --> 00:19:18,190
!سأعالج بوب

205
00:19:21,360 --> 00:19:23,570
!توقّفَ قلبُه

206
00:19:24,530 --> 00:19:28,450
لا أعلم إن كنتُ أستطيع استخدام
مثل هذه التّعويذة الضّخمة

207
00:19:28,830 --> 00:19:33,170
...لكن إن لم أنجح، بوب سوف

208
00:19:34,880 --> 00:19:36,590
أيّتها الآلهة، أنعمي علينا

209
00:19:37,210 --> 00:19:44,050
باسمك، استردّي روح هذه الحياة التي احترقت

210
00:19:52,650 --> 00:19:53,600
!...تلك التّعويذة

211
00:19:56,860 --> 00:19:57,440
!إحياء

212
00:20:01,400 --> 00:20:06,120
إنّها إحياء! تعويذة البعث التي قيل
!أنّها تُعيد الموتى

213
00:20:06,280 --> 00:20:07,910
!هل يُمكن إنقاذ بوب إذاً؟

214
00:20:08,740 --> 00:20:10,120
لا أعلم

215
00:20:10,290 --> 00:20:15,420
حتّى بوجودِ كاهنة خبيرة، نسبة النّجاح
!هي أقل من 50 بالمئة

216
00:20:15,580 --> 00:20:18,170
يعتمِد الأمر إذاً على مُستوى سحر الأميرة

217
00:20:19,170 --> 00:20:21,920
!عُد إلينا يا بوب

218
00:20:27,350 --> 00:20:31,430
إذا أردتَ قطع ذِراعي، عليك استخدام الرَّعد الصّاعِق

219
00:20:31,930 --> 00:20:32,770
!اللَّعنة عليك

220
00:20:39,230 --> 00:20:40,440
!تعويذة صعق؟

221
00:20:42,280 --> 00:20:44,450
!كروكوداين

222
00:20:46,410 --> 00:20:49,740
!أحمق! مُت بهدوء كأي كائن ضعيف

223
00:20:50,410 --> 00:20:55,040
ولا حتّى الآلهة تستطيع التدخُّل في هذه
!المعركة بين أب وابنه

224
00:20:55,960 --> 00:20:58,840
!حضِّر نفسك يا داي

225
00:21:31,240 --> 00:21:32,580
!لم أنتهِ

226
00:21:32,750 --> 00:21:36,330
لا أستطيع البقاء مكتوف الأيدي. ما دمتُ
أستطيع التحرُّك، فهذا يكفي

227
00:21:37,880 --> 00:21:40,340
!كروكوداين، استيقظ! انهض

228
00:21:41,420 --> 00:21:42,630
هيونكل

229
00:21:42,800 --> 00:21:44,300
علينا مُساعدة داي

230
00:21:44,470 --> 00:21:47,930
مُدّني بقوّتك. لديّ خطّة

231
00:21:48,090 --> 00:21:49,300
!ماذا؟

232
00:22:04,240 --> 00:22:07,200
حتّى لو واجهت الشّيطان والمنطق في صفّك

233
00:22:07,360 --> 00:22:11,160
قد يكون مجرّد تبرير

234
00:22:11,330 --> 00:22:15,250
حتّى الآن، حتّى الآن ما زلتُ أتردّد

235
00:22:15,410 --> 00:22:19,290
إلى أي مدى سنصل؟

236
00:22:19,460 --> 00:22:22,590
سمعتُ صوتاً أشبه بهمسِ ملاك

237
00:22:22,750 --> 00:22:26,510
ربّما كان وهم مُنتحِل ما زال
يتردّد في أذنيّ

238
00:22:26,670 --> 00:22:30,220
مُعرّض للحبِّ والحزن

239
00:22:30,390 --> 00:22:34,520
على الدّربِ المُغطّى بالاعتزاز

240
00:22:36,230 --> 00:22:38,560
لحظات عابِرة من الجُبن

241
00:22:40,100 --> 00:22:42,360
نداء الاستغاثة الذي تحفّظتُ عليه

242
00:22:43,940 --> 00:22:47,950
قبضتُ يدي المُرتعدة

243
00:22:48,530 --> 00:22:53,530
ذلك الوعد البسيط

244
00:22:53,700 --> 00:22:57,330
تلك الذّكريات التّافهة الصّغيرة

245
00:22:57,500 --> 00:22:59,620
ما زالت تسكن قلبي

246
00:22:59,790 --> 00:23:03,790
كجمرٍ يُبقيني مُشتعلاً

247
00:23:03,960 --> 00:23:08,300
شُعاع شفّاف من النُّور

248
00:23:08,470 --> 00:23:11,470
يُنير الدّرب أمامي

249
00:23:11,640 --> 00:23:16,140
قلّما أستطيع فعله

250
00:23:16,310 --> 00:23:22,350
أحافِظ على المُستقبل الذي تمكّنتُ
من إمساكه بإحكام من خلال إيماني

251
00:23:33,950 --> 00:23:38,910
أخذَ داي يُدافع فقط، لكن بفضلِ المُساندة
من هيونكل، يتمكَّن من الصُّمود

252
00:23:39,080 --> 00:23:43,460
في هذه الأثناء، تستمرّ ليونا في استخدام
إحياء على بوب باستماتة

253
00:23:44,170 --> 00:23:46,170
تقترِب نهاية المعركة

254
00:23:46,340 --> 00:23:49,010
هل سيتمكّن داي من هزيمةِ أبيه باران؟

255
00:23:49,630 --> 00:23:52,550
سيقطع البرق الرّوابط بين الأب والابن

256
00:23:53,140 --> 00:23:55,510
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

257
00:23:57,390 --> 00:23:59,390
!وتستمرّ المغامرة