1
00:00:19,060 --> 00:00:22,390
بروابطك مع أصدقائك

2
00:00:22,560 --> 00:00:26,150
التي يعتنقها قلبك

3
00:00:26,310 --> 00:00:29,860
كلمح البصر
في رمشة عين

4
00:00:30,030 --> 00:00:33,240
تخاطر بها كلّها

5
00:00:33,400 --> 00:00:38,870
مراراً وتكراراً
أمام قدرك المشتعل

6
00:00:40,870 --> 00:00:44,790
ستواجهه من جديد

7
00:00:44,960 --> 00:00:48,710
إذا كان هذا ما تختاره

8
00:00:48,880 --> 00:00:52,130
حتّى لو آلمك

9
00:00:52,590 --> 00:00:55,880
حتّى لو تعثّرت

10
00:00:56,050 --> 00:00:58,800
استمرّ حتّى آخر رحلتك

11
00:00:58,970 --> 00:01:04,020
ثانية ومن جديد
إلى المستقبل الذي تبنيه

12
00:01:07,350 --> 00:01:11,650
تستطيع النهوض
أنت الأشجع

13
00:01:14,780 --> 00:01:18,660
تستطيع النهوض
أنت الأشجع

14
00:01:18,820 --> 00:01:22,490
حلّق نحو العالم
لا تتوقّف أبداً

15
00:01:22,660 --> 00:01:26,250
شدّ عزمك أكثر
أنت الأشجع

16
00:01:26,420 --> 00:01:29,920
حلّق نحو العالم
لا تتوقّف أبداً

17
00:01:30,090 --> 00:01:34,090
شدّ عزمك أكثر
أنت الأشجع

18
00:01:37,550 --> 00:01:40,140
أنت الأشجع

19
00:02:02,580 --> 00:02:05,200
!آمل أن تكون مستعدّاً لهذا

20
00:02:12,500 --> 00:02:14,920
!عويل فأس الدوّامة

21
00:02:15,840 --> 00:02:17,050
!خذ هذه

22
00:02:20,300 --> 00:02:23,100
!أنا من سيكون خصمك

23
00:02:23,680 --> 00:02:26,350
!إيّاكِ والظنّ أنكِ ستهزمينني بتلك السّهولة

24
00:03:12,270 --> 00:03:15,360
!هذه هي قوّة التنّين الشّيطان إذاً

25
00:03:15,730 --> 00:03:19,150
!خصم جدير بحقّ

26
00:03:30,330 --> 00:03:33,040
...يبدو أنّك ما زلت لا تفهم

27
00:03:33,630 --> 00:03:35,420
!هدلر

28
00:03:58,900 --> 00:04:03,360
التنّين الشّيطان لا يتوقّف حتّى يموت خصمه

29
00:04:03,530 --> 00:04:06,660
إنّها الهيئة القتاليّة العظمى لفارس تنّين

30
00:04:09,290 --> 00:04:11,790
،الآن بعد أن اتّخذتُ هذا الشّكل

31
00:04:11,960 --> 00:04:15,880
!لا فُرصة لك مهما حاولت جاهداً

32
00:04:25,970 --> 00:04:27,300
!اللّعنة عليك

33
00:04:39,650 --> 00:04:44,320
والآن لن تتمكّن من استخدام سيفك
أو تعويذات شديدة لمدّة من الزمن

34
00:04:45,950 --> 00:04:48,740
!إنّه قويّ... قويّ جدّاً

35
00:04:48,910 --> 00:04:53,710
صُنِع جسد هذا الشّيطان الخارق
!بما يوازي قدرات التنّين الشيطان

36
00:04:54,290 --> 00:04:57,750
!ينبغي أن ينافس بل وحتّى يتفوّق على باران

37
00:04:58,210 --> 00:04:59,880
!لماذا؟

38
00:05:00,050 --> 00:05:03,550
!لماذا لا أستطيع فعل شيء له؟

39
00:05:06,300 --> 00:05:07,470
إنّه قويّ

40
00:05:08,180 --> 00:05:10,930
حتّى هدلر ضعيف أمامه

41
00:05:11,310 --> 00:05:15,350
يبدو وكأنّ هدلر عبثَ بوكر حيوان

42
00:05:16,140 --> 00:05:20,480
كلّ حيوان يستشيط غضباً إذا عُبِث بوكره

43
00:05:21,020 --> 00:05:24,950
يُظهِر قوّة استثنائيّة لحماية صغاره

44
00:05:25,110 --> 00:05:27,200
وينفّذ عقوبة قاسية

45
00:05:27,360 --> 00:05:29,780
كذلك الأمر هنا

46
00:05:30,950 --> 00:05:34,250
أعتقد هذا يحسم المسألة

47
00:05:34,700 --> 00:05:36,120
حسنٌ إذاً

48
00:05:37,790 --> 00:05:40,500
سوف تفجّر النّواة السّوداء؟

49
00:05:40,670 --> 00:05:46,300
والآن بعد أن عجز هدلر عن الفوز، هذه ليست إلّا رحمة

50
00:05:46,470 --> 00:05:48,050
ألا توافقني؟

51
00:05:50,260 --> 00:05:56,430
كلّ ما سأفعله هو إطلاق قوّتي السحريّة
من هذا الإصبع فتنفجر النّواة

52
00:05:56,810 --> 00:06:00,520
...عندما يحتكّ باران مع هدلر

53
00:06:01,440 --> 00:06:04,990
حينئذ ينتهي كلّ شيء

54
00:06:17,870 --> 00:06:21,040
أما زلت تريد القتال يا هدلر؟

55
00:06:24,090 --> 00:06:28,510
أتحاول استخدام هجوم الاحتراق القاطع
الخارق بذراع مكسورة؟

56
00:06:29,090 --> 00:06:30,800
!هذا عقيم تماماً

57
00:06:33,760 --> 00:06:35,890
!قُل ما تشاء

58
00:06:36,060 --> 00:06:41,060
مجرّد انتظار الموت في الأرض
!سيكون أسوأ من هذا الألم

59
00:06:41,730 --> 00:06:47,030
!على الأقلّ، يمكنني المُحاولة

60
00:06:47,610 --> 00:06:48,900
كما تشاء

61
00:06:50,570 --> 00:06:52,030
!أقبل بتحدّيك

62
00:07:59,180 --> 00:08:02,980
كم هذا مُخيّب يا باران

63
00:08:03,140 --> 00:08:09,780
أن تتوقّف فجأة بعد كلّ ما حقّقتَه

64
00:08:13,950 --> 00:08:18,740
كانت جهودك الأخيرة مُدهشة للغاية يا هدلر

65
00:08:18,910 --> 00:08:20,540
لكن لا تخف

66
00:08:20,700 --> 00:08:27,090
كما تأمّلت، حتّى في الموت ما زال
بمقدورك هزيمة باران

67
00:08:27,500 --> 00:08:29,800
هنا وفي هذه اللحّظة

68
00:08:31,510 --> 00:08:34,260
!تحطّمي إلى أشلاء أيّتها النّواة السّوداء

69
00:08:43,480 --> 00:08:44,690
!ماذا؟

70
00:08:47,560 --> 00:08:48,980
!مستحيل

71
00:08:49,150 --> 00:08:52,820
...أطلقتُ قوّتي السحريّة، ومع ذلك

72
00:08:52,990 --> 00:08:55,610
لماذا لا تنفجر النّواة؟

73
00:08:58,030 --> 00:09:01,830
استهنتَ بي يا ملك الشّياطين فارن

74
00:09:02,000 --> 00:09:03,330
...لماذا برأيك

75
00:09:03,750 --> 00:09:08,210
قبلتُ بتحدّي هدلر الأخير؟

76
00:09:09,590 --> 00:09:13,090
!كان لأنّني أنتظر هذه الفرصة

77
00:09:16,340 --> 00:09:20,220
وذلك كي أتمكّن من منع انفجار النّواة
!السّوداء بهالتي التنّينيّة

78
00:09:24,310 --> 00:09:26,440
أحسنت صنعاً يا باران

79
00:09:26,600 --> 00:09:30,770
كان مستعدّاً للانفجار إذاً

80
00:09:33,360 --> 00:09:35,860
...ما

81
00:09:36,490 --> 00:09:38,620
!ما هذا الشيء؟

82
00:09:38,780 --> 00:09:42,040
!ماذا كان ذلك الشيء يفعل داخلي؟

83
00:09:42,200 --> 00:09:46,790
بصفتك ظلاميّ، لا بدّ وأنّك سمعت عنها

84
00:09:47,290 --> 00:09:49,250
!تُدعى نُواة سوداء

85
00:09:49,420 --> 00:09:51,380
!نُواة سوداء؟

86
00:09:52,420 --> 00:09:54,170
...هذا

87
00:09:54,340 --> 00:09:56,170
!هذا مستحيل

88
00:09:56,340 --> 00:10:00,970
!كانت القنبلة الأسطوريّة اللّعينة داخلي؟

89
00:10:01,350 --> 00:10:04,560
!من؟! من يفعل شيئاً كهذا؟

90
00:10:04,720 --> 00:10:06,270
من غيره؟

91
00:10:06,430 --> 00:10:08,020
كان سيّدك

92
00:10:08,190 --> 00:10:11,400
،الشّخص الّذي وعدك بالعالم السّطحي

93
00:10:11,560 --> 00:10:15,780
!بينما كانت نيّته الحقيقيّة تدميره بلا شفقة

94
00:10:15,940 --> 00:10:17,570
!الملك فارن؟

95
00:10:17,740 --> 00:10:19,280
!فهمتُ الآن

96
00:10:19,450 --> 00:10:26,450
!كنتَ أنت وداي تتحفّظان بسبب النُّواة السّوداء

97
00:10:27,790 --> 00:10:29,250
...ماذا عن

98
00:10:29,420 --> 00:10:32,960
!ماذا عن معركة نزيهة؟

99
00:10:33,130 --> 00:10:38,550
كان من غير الممكن أن تتمكّنا من الفوز
!بمثل هذه الشروط

100
00:10:39,090 --> 00:10:42,640
...ضحّيتُ بجسدي

101
00:10:42,800 --> 00:10:47,560
!ضحّيتُ بحياتي لأخوض هذه المعركة

102
00:10:55,020 --> 00:10:56,530
...هدلر

103
00:10:57,240 --> 00:11:00,780
كم أنت مسكين يا هدلر

104
00:11:00,950 --> 00:11:03,320
ليس باليد حيلة يا كيلفارن

105
00:11:03,620 --> 00:11:10,420
لم أتوقّع أن تكون قوّة هالة باران
كتنّين شيطان بهذا الحجم

106
00:11:10,790 --> 00:11:15,960
تصدّى لقوّتي السحريّة. كم هذا مُذهل

107
00:11:16,130 --> 00:11:20,930
لكن بصفتي صانع النُّواة، كلّ ما أحتاجه هو الاقتراب منها

108
00:11:21,090 --> 00:11:24,550
وتفجيرها بلا أيّ مشاكل

109
00:11:28,890 --> 00:11:30,350
حسناً إذاً

110
00:11:30,520 --> 00:11:35,520
سأذهب بنفسي وأسحقهما مع النّواة

111
00:11:35,690 --> 00:11:41,860
أيها الملك فارن، إذا ذهبتَ بشخصك إلى هناك فهذا سيُخزينا

112
00:11:42,030 --> 00:11:43,700
أليس كذلك يا ميستو؟

113
00:11:45,870 --> 00:11:47,660
وها قد فعلها

114
00:11:52,080 --> 00:11:54,580
!باران، ماذا تفعل؟

115
00:11:54,750 --> 00:11:59,590
أزيل النّواة عنك قبل أن يُقدم فارن على حركته التّالية

116
00:12:08,180 --> 00:12:09,770
!ميستوفارن؟

117
00:12:09,930 --> 00:12:12,140
أتى للقضاء علينا

118
00:12:13,900 --> 00:12:15,480
...ميستوفارن

119
00:12:15,650 --> 00:12:17,150
...هل

120
00:12:17,320 --> 00:12:19,610
!هل تتّفق مع رأي الملك فارن؟

121
00:12:20,530 --> 00:12:23,490
!هل أتيت لتتخلّص منّي كأداة غير نافعة؟

122
00:12:23,910 --> 00:12:25,700
...هل كنتُ

123
00:12:25,870 --> 00:12:29,870
!هل كنتُ مجرّد بيدق لكم أيضاً؟

124
00:12:32,000 --> 00:12:33,160
...هدلر

125
00:12:33,330 --> 00:12:37,130
ليس لديّ إلّا جواب واحد عن سؤالك

126
00:12:44,340 --> 00:12:48,850
كلام ملك الشّياطين مُطلق ولا يُعلى عليه

127
00:12:51,430 --> 00:12:55,480
فهمت. هذه هي إجابتك إذاً

128
00:12:55,900 --> 00:12:59,230
تأخّرت كثيراً يا ميستوفارن

129
00:12:59,400 --> 00:13:02,820
!حتّى بوجودك هنا، لا يمكن أن أنهزم

130
00:13:02,990 --> 00:13:04,740
لا تكن واثقاً من نفسك

131
00:13:04,900 --> 00:13:11,080
يمكنني القضاء عليكما من دون أن ألمسكما حتّى

132
00:13:15,960 --> 00:13:18,710
!ما هذا الاهتزاز القويّ؟

133
00:13:19,670 --> 00:13:23,090
أيّها الملك فارن، هلّا منحتني الإذن؟

134
00:13:23,590 --> 00:13:26,090
أمنحك يا ميستوفارن

135
00:14:14,430 --> 00:14:15,640
!...هذا

136
00:14:15,810 --> 00:14:17,440
!الشّكل الحقيقي لميستوفارن؟

137
00:14:20,440 --> 00:14:24,570
!فلترحلا مع النُّواة السّوداء

138
00:14:30,990 --> 00:14:32,910
!تمّ تفعيل النُّواة؟

139
00:14:33,330 --> 00:14:34,490
!مستحيل

140
00:14:34,660 --> 00:14:39,540
ينبغي لهالتي التنّينيّة الشيطانيّة أن
!تردع أي قوّة سحر

141
00:14:39,920 --> 00:14:45,250
كان ذلك ليتطلّب اقتراب قوّة
...فارن السحريّة كي

142
00:14:46,840 --> 00:14:47,880
!أيُعقل أنّه...؟

143
00:14:48,050 --> 00:14:49,340
!انفجري

144
00:14:58,560 --> 00:14:59,850
!سوف تنفجر

145
00:15:00,020 --> 00:15:06,230
وحدها قوّة سحر صانع النّواة السّوداء
!التي تستطيع تفجيرها

146
00:15:06,690 --> 00:15:10,530
!ميستوفارن! هل هذا يعني أنّ شكلك الحقيقيّ...؟

147
00:15:10,700 --> 00:15:12,780
لا جدوى من السّؤال

148
00:15:13,120 --> 00:15:16,700
خلال لحظات، كلاكما سوف ترحلان عن هذا العالم

149
00:15:16,870 --> 00:15:22,330
الآن بعد أن رأيتما هذا الوجه، لا يُسمح
لكما بالاستمرار في العيش

150
00:15:40,600 --> 00:15:43,600
!ما هذا الاهتزاز الغريب؟

151
00:15:43,770 --> 00:15:47,320
!لا أعلم، لكن ينتابني إحساس سيّئ حيال هذا

152
00:15:47,480 --> 00:15:50,400
!أنت! أين تنظر؟

153
00:15:54,240 --> 00:15:57,120
!جميعكم! اجتمعوا في مكان واحد

154
00:15:57,290 --> 00:15:59,950
!يحدث شيء ما لميدان الموت

155
00:16:05,000 --> 00:16:06,380
!ماذا؟

156
00:16:11,420 --> 00:16:13,630
!ما الأمر؟! ميرلي

157
00:16:13,800 --> 00:16:16,390
!وميض أبيض يبتلع الجميع

158
00:16:16,550 --> 00:16:18,640
!سوف يختفي الجميع

159
00:16:18,810 --> 00:16:20,100
!حتّى بوب

160
00:16:20,270 --> 00:16:21,430
!لا

161
00:16:21,600 --> 00:16:23,190
!اهدئي

162
00:16:30,070 --> 00:16:32,240
هل للأمر علاقة بهذا الاهتزاز؟

163
00:16:32,700 --> 00:16:34,530
!سعادة الأميرة! أمر طارئ

164
00:16:35,700 --> 00:16:38,660
!بدأ ميدان الموت بالاهتزاز فجأة

165
00:16:39,080 --> 00:16:41,830
!وكأنّه... بركان نشط

166
00:16:42,000 --> 00:16:42,710
!ماذا؟

167
00:16:42,870 --> 00:16:45,370
!هل يحدث شيء من جديد؟

168
00:16:49,300 --> 00:16:50,130
!الأميرة ليونا

169
00:16:50,300 --> 00:16:52,970
!يجب أن نذهب لإنقاذ الأبطال

170
00:16:53,470 --> 00:16:54,680
!توقّفوا

171
00:16:56,220 --> 00:16:57,300
من...؟

172
00:17:01,770 --> 00:17:03,060
!أنت

173
00:17:03,230 --> 00:17:05,480
!أنت بخير

174
00:17:05,650 --> 00:17:08,190
!يجب أن نغادر هذا المكان فوراً

175
00:17:08,360 --> 00:17:09,230
!بسرعة

176
00:17:09,400 --> 00:17:10,480
!عُلِم

177
00:17:15,200 --> 00:17:18,620
!هذا سيّئ! الانفجار محتوم

178
00:17:21,120 --> 00:17:24,750
وداعاً يا هدلر وباران

179
00:17:24,910 --> 00:17:28,420
الرّجلان اللّذان حازا على احترام الملك فارن بشخصه

180
00:17:28,580 --> 00:17:32,590
...سوف يُحفر اسماكما في قلبي

181
00:17:32,760 --> 00:17:34,510
للأبد

182
00:18:17,470 --> 00:18:18,970
هذا الاهتزاز

183
00:18:19,140 --> 00:18:22,430
سوف ينتقل قصر فارن أخيراً إذاً؟

184
00:18:22,600 --> 00:18:23,680
هذا صحيح

185
00:18:32,440 --> 00:18:34,730
عدتَ لتغطية نفسك بهذه السّرعة؟

186
00:18:34,900 --> 00:18:36,990
وجهك الحقيقيّ أروع بكثير

187
00:18:37,150 --> 00:18:39,160
!أروع بكثير! أروع بكثير

188
00:18:39,530 --> 00:18:43,490
لا ينبغي لتلك القوّة أن تنكشف أكثر من اللّازم

189
00:18:43,660 --> 00:18:46,410
أمرك يا جلالة ملك الشّياطين

190
00:18:46,580 --> 00:18:50,120
أبليت بلاء عظيماً يا ميستوفارن

191
00:18:50,670 --> 00:18:51,880
انتهى الأمر

192
00:18:52,040 --> 00:18:53,590
بالمُطلَق

193
00:18:53,880 --> 00:18:58,800
...البطل وباران وكلّ المُزعجين الآخرين قد سُحِقوا

194
00:18:58,970 --> 00:19:01,090
مع ميدان الموت

195
00:19:01,260 --> 00:19:03,720
نحن كلّ من بقي إذاً

196
00:19:03,890 --> 00:19:04,930
أجل

197
00:19:05,100 --> 00:19:06,520
...نحن

198
00:19:07,640 --> 00:19:10,640
وقصر فارن بنفسه

199
00:19:10,810 --> 00:19:15,230
حان الوقت الآن لإبادة عالم السّطح

200
00:19:18,490 --> 00:19:22,620
سأزيل الحاجز المُحيط بقصر فارن الآن

201
00:19:22,780 --> 00:19:27,580
الصّخور المتبقّية التي كانت تغطّيه ستنهار جميعها

202
00:19:28,450 --> 00:19:31,290
لكن هناك الكثير من الصّخور المتبقّية

203
00:19:33,000 --> 00:19:37,710
،مع انفجار النّواة السّوداء، باستثناء قصر فارن

204
00:19:37,880 --> 00:19:42,090
ينبغي أن تتحوّل كلّ الصّخور إلى رماد

205
00:19:44,010 --> 00:19:45,510
أيُعقل...؟

206
00:19:45,680 --> 00:19:51,390
ميستوفارن، اطلب من مقلات الشّيطان
أن يبحثوا عن أيّ ناجين

207
00:19:51,560 --> 00:19:52,480
!أمرك

208
00:20:11,540 --> 00:20:13,710
!ناجين! تمّ العثور على ناجين

209
00:20:14,670 --> 00:20:16,670
!أربعة ناجون في الجناح الأيسر

210
00:20:17,170 --> 00:20:18,960
أتباع أفان

211
00:20:19,130 --> 00:20:22,680
نجوا؟ من ذلك الانفجار؟

212
00:20:23,970 --> 00:20:28,100
كم هم محظوظون بنجاتهم

213
00:20:28,510 --> 00:20:30,100
!هل نجونا؟

214
00:20:30,270 --> 00:20:32,440
كان ذلك الانفجار عجيباً

215
00:20:32,600 --> 00:20:34,230
من أنقذنا؟

216
00:20:34,400 --> 00:20:36,940
كان غالباً الضّخم هنا

217
00:20:37,110 --> 00:20:41,240
من غيره لديه القوّة لإنقاذنا بدفننا جميعاً أحياء؟

218
00:20:42,570 --> 00:20:46,200
كفّ عن الشّكوى. ما زلنا أحياء على الأقلّ

219
00:20:46,780 --> 00:20:50,580
ارتأيتُ أنّ تحت الأرض هو المكان
الأكثر أماناً على الأرجح

220
00:20:50,910 --> 00:20:54,540
لذا حفرتُ حفرة كبيرة في الأرض
بما يكفي لاختبائنا فيها

221
00:20:54,710 --> 00:20:58,670
فكرة سديدة. كانت غالباً الطريقة الوحيدة
لتجنّب ذلك الانفجار

222
00:20:58,840 --> 00:21:01,710
اختفى الحرس الملكيّ بأكمله

223
00:21:02,050 --> 00:21:05,430
يبدو أنّه لم ينجُ سوانا

224
00:21:06,640 --> 00:21:08,100
!قرار حكيم

225
00:21:08,260 --> 00:21:09,510
!تأخّرت

226
00:21:11,180 --> 00:21:13,180
لكن أين نحن؟

227
00:21:13,350 --> 00:21:15,600
هذا المكان مختلف عن ميدان الموت

228
00:21:15,770 --> 00:21:18,440
هذا قصر فارن غالباً

229
00:21:18,810 --> 00:21:23,110
دمّر الانفجار ميدانَ الموت وعرّى ما تحته

230
00:21:23,280 --> 00:21:25,910
!...إذاً ذلك الشيء الّذي هناك

231
00:21:26,660 --> 00:21:29,620
!لا بدّ وأنّه قصر ملك الشّياطين فارن

232
00:21:36,750 --> 00:21:37,960
!غير ممكن

233
00:21:38,130 --> 00:21:39,250
!بوب؟

234
00:21:40,210 --> 00:21:45,590
هل هذا يعني أنّنا حلّقنا في السّماء
مع قصر فارن فحسب؟

235
00:22:07,150 --> 00:22:12,030
بصراحة كنتُ أخرق

236
00:22:12,200 --> 00:22:18,370
واستغرقتُ وقتاً طويلاً للوصول إلى هنا

237
00:22:18,870 --> 00:22:23,840
وحتّى أنّني استخدمتُ الوحدة كسلاح

238
00:22:24,000 --> 00:22:29,760
بحثتُ في الدّيماس عن جواب بسيط

239
00:22:29,930 --> 00:22:35,600
حتّى لو تخلّيتُ عن الحقّ واللّطف

240
00:22:35,770 --> 00:22:41,730
أريد أن أكون موجوداً بجانبك فحسب

241
00:22:41,900 --> 00:22:47,360
أن أنادي باسمك

242
00:22:47,530 --> 00:22:53,370
هو أصعب من أي تعويذة سحريّة

243
00:22:53,530 --> 00:22:59,160
رغم أنّك مقرّب جدّاً منّي

244
00:22:59,330 --> 00:23:01,790
أحبّك

245
00:23:01,960 --> 00:23:05,090
أدركتُ ذلك أخيراً

246
00:23:05,250 --> 00:23:10,220
أن أنادي باسمك

247
00:23:10,380 --> 00:23:16,640
هو السّبب الّذي وُلدت لأجله

248
00:23:16,810 --> 00:23:22,560
سأتخلّص من هذا اللّيل الطويل

249
00:23:22,730 --> 00:23:25,270
وآتي لرؤيتك

250
00:23:25,440 --> 00:23:30,030
إلى حيث أنت الآن

251
00:23:33,950 --> 00:23:40,540
أبادت النّواة السّوداء ميدان الموت
وكشفت عن الشّكل الحقيقيّ لقصر فارن

252
00:23:40,710 --> 00:23:43,880
،بوب والآخرون الّذين نجوا يسارعون للبحث عن داي

253
00:23:44,040 --> 00:23:47,800
لكن يعثرون على مُخلّفات معركة
باران وهدلر المُروّعة

254
00:23:47,960 --> 00:23:53,510
يباشر ملك الشّياطين بتحرّكاته
التّالية الخالية من الرّحمة ضدّهم

255
00:23:53,930 --> 00:23:56,140
في الحلقة القادمة من
،دراغون كويست، مغامرة داي

256
00:23:56,310 --> 00:23:57,970
"القلب الموروث"

257
00:23:58,140 --> 00:24:00,180
!وتستمرّ المغامرة