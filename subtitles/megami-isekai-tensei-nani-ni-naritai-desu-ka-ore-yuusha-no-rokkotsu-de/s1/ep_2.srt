1
00:00:02,760 --> 00:00:07,520
!تفضّلوا

2
00:00:07,520 --> 00:00:09,550
!أنت! تفضّل إحداها

3
00:00:10,140 --> 00:00:12,240
!ثلاث شاحنات قادمة

4
00:00:12,610 --> 00:00:14,450
!تفضّلوا بالمرور

5
00:00:26,090 --> 00:00:29,970
.كانت حياة عادية

6
00:00:29,970 --> 00:00:31,480
،لكن ربما لأنها كانت عادية

7
00:00:31,480 --> 00:00:34,390
...كنتُ منجذبًا للأشياء البرّاقة

8
00:00:38,880 --> 00:00:41,730
،لم تكن لي حبيبة طيلة حياتي

9
00:00:41,940 --> 00:00:46,610
لكنّي فعلتُ كل ما بوسعي
.لأقترب من ذلك الضوء الساطع

10
00:00:46,860 --> 00:00:49,090
،واصلت البحث عن الحبيبة المثالية

11
00:00:49,090 --> 00:00:51,840
...حتى في النصوص القديمة

12
00:00:52,250 --> 00:00:53,160
!أيها الطبيب

13
00:00:57,500 --> 00:00:59,210
...وأخيرًا

14
00:00:59,850 --> 00:01:01,710
انضممتُ إلى بعثة

15
00:01:01,710 --> 00:01:04,060
!تنقيب ثورية تبحث عن حضارة قديمة

16
00:01:04,940 --> 00:01:06,180
!الإلهة

17
00:01:06,180 --> 00:01:08,020
.لكن لسبب ما، لم يحرّك فيّ ذلك شيئًا

18
00:01:08,570 --> 00:01:10,720
،طاردتُ ذلك الضوء الساطع إلى أقاصي الأرض

19
00:01:10,720 --> 00:01:12,440
.ولسبب ما، لم يكن ذلك مُرضيًا

20
00:01:12,440 --> 00:01:14,350
...ثم التقيت

21
00:01:14,350 --> 00:01:15,230
.توقف

22
00:01:16,440 --> 00:01:17,540
ما الأمر؟

23
00:01:17,540 --> 00:01:20,140
هل قصة بعثة التنقيب عن الآثار حقيقية؟

24
00:01:25,060 --> 00:01:26,860
!لقد اختلقتُها

25
00:01:28,280 --> 00:01:29,990
.أكره الكذب

26
00:03:06,570 --> 00:03:07,460
!ريسباون

27
00:03:09,800 --> 00:03:11,710
!أنا حيّ

28
00:03:11,960 --> 00:03:15,820
يكون الشاي لذيذًا جدًا
.بعد عودتي للحياة بكامل أطرافي

29
00:03:16,470 --> 00:03:18,500
ما رأيك بحياتي؟

30
00:03:18,500 --> 00:03:21,420
.قضيتَ حياتك كاملة تعيش كأوتاكو مثير للشفقة

31
00:03:21,420 --> 00:03:25,560
على الأقلّ، لم تقضها حبيس غرفتك
.مدمنًا على ألعاب الفيديو

32
00:03:25,560 --> 00:03:27,250
!أفضّل العالم الخارجيّ الرائع

33
00:03:27,250 --> 00:03:30,370
،عندما كنتُ طفلًا
!كنتُ أذهب إلى صالة الألعاب ثلاث مرات في الأسبوع

34
00:03:30,370 --> 00:03:32,700
".أرفض اعتبار ذلك "العالم الخارجيّ الرائع

35
00:03:32,700 --> 00:03:35,010
!أحب كذلك الألعاب الرومانسية التي تُلعب في البيت

36
00:03:35,010 --> 00:03:35,940
.فهمت

37
00:03:35,940 --> 00:03:37,710
...يا لبرودتك

38
00:03:38,290 --> 00:03:42,280
بالمناسبة، كم بلغ مقياس إعجابك بي حتى الآن؟

39
00:03:42,280 --> 00:03:43,820
،إن كان الرقم الأعلى هو مائة

40
00:03:43,820 --> 00:03:45,920
.أعتقد حوالي 95 بالمائة

41
00:03:45,920 --> 00:03:47,600
!نسبة عالية بشكل مفاجئ

42
00:03:47,600 --> 00:03:49,290
!أنتِ جميلة اليوم كالعادة

43
00:03:50,570 --> 00:03:52,540
!صارت النسبة 96 بالمائة

44
00:03:52,540 --> 00:03:53,940
!هذه اللعبة في غاية السهولة

45
00:03:53,940 --> 00:03:56,340
!أنت أجملهنّ جميعًا أيتها الإلهة

46
00:03:57,610 --> 00:03:59,390
.صارت النسبة 98 بالمائة

47
00:04:00,210 --> 00:04:02,720
وماذا سيحصل بعد بلوغها مائة بالمائة؟

48
00:04:02,720 --> 00:04:05,930
سأُغرم بك بشدّة لدرجة
أنّي سأحوّلك إلى حيوان محنّط

49
00:04:05,930 --> 00:04:08,020
.وسأعلقك على الجدار

50
00:04:12,420 --> 00:04:14,560
.أعتقد أنها ليست لعبة رومانسية

51
00:04:19,860 --> 00:04:22,290
ستصبح سلطعون ناسك هذه المرة، صحيح؟

52
00:04:22,290 --> 00:04:24,030
!أجل، أنا سلطعون الناسك

53
00:04:24,740 --> 00:04:26,520
مجرّد سلطون ناسك عادي؟

54
00:04:26,520 --> 00:04:31,040
هل تجسّد أحد كوحش سلطعون الناسك من قبل؟

55
00:04:32,050 --> 00:04:33,040
.البعض

56
00:04:35,460 --> 00:04:37,360
،لا أريدك أن تُلتهم على الفور

57
00:04:37,360 --> 00:04:42,740
لذا سأمنحك جميع الخصائص الممكنة
.دون إطالة فترة انتظارك

58
00:04:42,740 --> 00:04:44,580
...حسنًا، سأذهـ

59
00:04:45,890 --> 00:04:47,800
نسيت هذا، أليس كذلك؟

60
00:04:55,940 --> 00:04:56,940
!سلطعون الناسك

61
00:05:11,530 --> 00:05:14,000
!مفاجأة

62
00:05:14,000 --> 00:05:16,250
!لقد عدت

63
00:05:16,740 --> 00:05:18,040
.أعلم

64
00:05:22,090 --> 00:05:23,200
.ريسباون

65
00:05:24,320 --> 00:05:26,720
.كان الأمر جيدًا معظم الوقت

66
00:05:26,720 --> 00:05:30,520
جيد بقدر ما تسمح حياة
.سلطعون الناسك على ما أفترض

67
00:05:30,520 --> 00:05:32,740
كان الأمر يسير على ما يرام
،إلى أن هزمتُ غلاسراي

68
00:05:32,740 --> 00:05:35,820
.حاكم المطهر، ومنعته من تدمير العالم

69
00:05:35,820 --> 00:05:37,320
...لكن بعد ذلك

70
00:05:38,360 --> 00:05:40,700
.لنرَ بأعيننا

71
00:05:44,880 --> 00:05:47,660
.أول ما أتذكره هو خروجي من البيضة

72
00:05:47,660 --> 00:05:50,210
،التُهم العديد من إخوتي

73
00:05:50,210 --> 00:05:53,860
.لكنّي تمكنتُ من الفرار وأخذني البطل رايتسانبيل

74
00:05:53,860 --> 00:05:56,920
!هيّا، رافقني في مغامرتي

75
00:05:56,920 --> 00:05:59,300
لِم قد يتحالف رايتسانبيل مع سلطعون ناسك؟

76
00:05:59,300 --> 00:06:03,600
الإضافات التي منحتني إيّاها
.جعلتني مرتبطًا بالبطل

77
00:06:03,600 --> 00:06:05,600
.أنا المسؤولة عمّا حدث لك إذًا

78
00:06:05,600 --> 00:06:08,400
،وبفضل الخاصية الأخرى التي منحتني

79
00:06:08,400 --> 00:06:11,690
"سلاح البطل النهائيّ"

80
00:06:11,690 --> 00:06:13,940
!صرتُ سلطون الناسك النهائيّ

81
00:06:15,120 --> 00:06:17,600
لكن بعد تدمير أحد الجبال وشقّ البحر

82
00:06:17,600 --> 00:06:21,700
...وشقّ السحب، عاد البطل إلى رشده

83
00:06:22,210 --> 00:06:24,780
لماذا سلطعون الناسك؟

84
00:06:24,780 --> 00:06:27,380
.يفترض أن يكون ذلك أول سؤال يسأله

85
00:06:26,650 --> 00:06:29,820
لماذا سلطعون الناسك؟

86
00:06:27,380 --> 00:06:29,850
،حاول التخلّص منّي

87
00:06:29,850 --> 00:06:34,710
"لكنكِ منحتني خاصية "السلاح الملعون
.ما منعه من ذلك

88
00:06:34,710 --> 00:06:38,630
.أعتقد أن إله هذا العالم سيغضب منّي قريبًا

89
00:06:38,630 --> 00:06:41,740
،لذا أعادني إلى البحر بدلًا من ذلك

90
00:06:41,740 --> 00:06:43,300
.لكنّي كنتُ لا أزال أنتمي له

91
00:06:43,300 --> 00:06:46,890
يسرّني أنه عثر على طريقة
.ستجاوز بها اللعنة

92
00:06:46,890 --> 00:06:51,310
،والتقيتُ لاكتوشا، إلهة البحر
.في معبد تحت الماء

93
00:06:51,310 --> 00:06:54,060
.كانت تملك صدرًا أكبر من صدرك

94
00:06:54,840 --> 00:06:56,560
.ستُعلّق على الجدار لاحقًا

95
00:06:56,560 --> 00:06:59,310
.بئسًا. اعتقدتُ أنها نسيت أمر تلك المزحة

96
00:06:59,310 --> 00:07:02,620
،أنقذتُ لاكتوشا من آسريها

97
00:07:02,620 --> 00:07:05,820
.وقررتُ تحويل المعبد إلى عشّ حبّنا

98
00:07:05,820 --> 00:07:07,690
.يا لك من منحرف

99
00:07:07,690 --> 00:07:11,400
.لكن عندها ظهر الحاكم العظيم، ليفاياكُن

100
00:07:11,400 --> 00:07:12,990
.لم تعد الأسماء مبتكرة

101
00:07:12,990 --> 00:07:18,450
،أصبتُ بشدّة، لكنّي اقتلعتُ عينه اليُمنى

102
00:07:18,450 --> 00:07:22,340
ليفاياكُن المسكين، اقتلع سلطعون ناسك
.عينه اليُمنى

103
00:07:22,340 --> 00:07:28,350
ثم أنقذني المعلم السلمون الأحمر
.الذي كان يتشمّس

104
00:07:29,180 --> 00:07:30,980
هل أنت بخير؟

105
00:07:30,980 --> 00:07:32,060
.توقف

106
00:07:32,650 --> 00:07:36,320
،إلى حدّ الآن
.تكاد تكون هذه القصة الخيالية غير منطقية

107
00:07:36,320 --> 00:07:38,780
.لكن السمكة مبالغ فيها

108
00:07:38,780 --> 00:07:40,020
حقًا؟

109
00:07:40,620 --> 00:07:46,350
بدأتُ التدريب على يديه
.لهزيمة ليفاياكُن الشرير

110
00:07:46,350 --> 00:07:49,120
...وبعد موته، اكتسبتُ قدرتي النهائية

111
00:07:49,120 --> 00:07:53,650
!ركلة رعد هاديس: لهيب فولاذ المطهر

112
00:07:53,650 --> 00:07:56,630
.لا أدري كيف توصّلت سمكة إلى تلك القدرة

113
00:07:56,630 --> 00:07:59,120
وهل سنتجاوز موت معلمك؟

114
00:07:59,120 --> 00:08:03,440
كان الوقت قد حان أخيرًا
!لمواجهة ليفاياكُن من جديد

115
00:08:03,440 --> 00:08:05,700
!قطعتُ رأسه بمخالبي وانتصرت

116
00:08:05,700 --> 00:08:09,470
كنتُ أفضّل أن تنتصر
."بـ"ركلة رعد هاديس: لهيب فولاذ المطهر

117
00:08:09,470 --> 00:08:13,100
!ثم تمكّنتُ من مواعدة لاكتوشا

118
00:08:13,510 --> 00:08:15,310
اتخذت سلطعون ناسك خليلًا لها؟

119
00:08:15,310 --> 00:08:17,880
.أرى أن لإلهة البحر بعض الرغبات الغريبة

120
00:08:17,880 --> 00:08:19,850
هل تشعرين بالغيرة؟

121
00:08:20,280 --> 00:08:23,300
.سأخرج أحشاءك ثم أعلقك على الجدار

122
00:08:23,300 --> 00:08:26,030
.ارتفع مستوى النهاية التعيسة

123
00:08:26,030 --> 00:08:31,160
لماذا عدت إن كنتَ قد نلتَ
نهاية سعيدة برفقة حبيبتك؟

124
00:08:31,160 --> 00:08:32,640
...الأمر هو

125
00:08:37,250 --> 00:08:42,360
بما أنّي كنتُ أحمل خاصيتي
،"سلاح البطل المطلق" و"يستطيع البطل وحده استخدامه"

126
00:08:42,360 --> 00:08:46,190
،عندما حاولت لاكتوشا استخدامي
!لقيت حتفها

127
00:08:46,190 --> 00:08:49,290
...شكرًا لك... على كل شيء

128
00:08:49,290 --> 00:08:52,760
!لاكتوشا

129
00:08:53,050 --> 00:08:54,730
كرهتُ البطل

130
00:08:54,730 --> 00:08:57,840
لأنه رماني في البحر وهو يعلم
.أن أمرًا كهذا قد يحدث

131
00:08:57,840 --> 00:09:00,340
.يجب أن تلومني أنا على منحك تلك الخواصّ

132
00:09:00,340 --> 00:09:03,250
.لكن شكرًا لك لتأويلك الأمر بهذه الطريقة

133
00:09:03,250 --> 00:09:06,720
!وأخيرًا، بدأ نزالي ضد البطل رايتسانبيل

134
00:09:06,720 --> 00:09:08,490
كيف سارت النزال؟

135
00:09:08,490 --> 00:09:10,440
،ضربنا بعضنا بقوة بقبضتينا

136
00:09:10,440 --> 00:09:11,610
!ثم فقدنا الوعي معًا

137
00:09:12,340 --> 00:09:15,070
...استخدمتما قبضيتكما

138
00:09:16,330 --> 00:09:19,350
.ذلك مخلب وليست قبضة

139
00:09:20,760 --> 00:09:23,490
.اعترفنا بقوة بعضنا وتقبّلنا كل منّا الآخر

140
00:09:23,490 --> 00:09:26,150
.ونسينا الماضي

141
00:09:26,150 --> 00:09:28,390
.نسيت ما قلتُه لك أيضًا

142
00:09:28,390 --> 00:09:30,240
.أشعر بالأسف على لاكتوشا

143
00:09:30,240 --> 00:09:31,650
.نسيتُ أمرها أيضًا

144
00:09:31,650 --> 00:09:32,840
.عجبًا

145
00:09:33,780 --> 00:09:39,350
،أريدك أن تهزم غلاسراي، حاكم المطهر
.الذي يهدد هذا العالم

146
00:09:39,780 --> 00:09:41,160
.بيديك

147
00:09:41,160 --> 00:09:42,400
.مخالبك. كما أخبرتك

148
00:09:42,400 --> 00:09:45,280
!سأفعل ذلك بيديّ يا صديقي

149
00:09:45,280 --> 00:09:47,020
!سأعهد لك بقوتي

150
00:09:47,020 --> 00:09:49,130
عهد بكل شيء لسلطعون ناسك؟

151
00:09:49,130 --> 00:09:53,280
!سأنتقم لموت البطل رايتسانبيل

152
00:09:52,620 --> 00:09:55,670
أين؟ أين أنت؟

153
00:09:53,320 --> 00:09:54,210
!أنت

154
00:09:54,210 --> 00:09:56,970
!يمكنك رؤيتي

155
00:09:56,970 --> 00:09:58,780
.سلطعون الناسك ضئيل الحجم

156
00:09:57,540 --> 00:09:58,780
!يا هذا

157
00:09:58,780 --> 00:10:01,090
.وذكّرني متى مات البطل

158
00:10:01,090 --> 00:10:05,330
،بعد أن عهد لي بقوته بثوانٍ
!قتله أتباع غلاسراي

159
00:10:05,330 --> 00:10:07,330
.هذا ما يجنيه لأنه عهد لك بالأمور

160
00:10:07,330 --> 00:10:09,540
!أيها الوغد! أيها الوغد

161
00:10:09,540 --> 00:10:12,050
!احترق بنار المطهر

162
00:10:12,050 --> 00:10:13,670
.يواجه صعوبة في إصابتك

163
00:10:17,810 --> 00:10:21,400
!"ركلة رعد هاديس: لهيب فولاذ المطهر"

164
00:10:25,150 --> 00:10:28,860
دمّرتُ غلاسراي في المستوى الذريّ

165
00:10:28,860 --> 00:10:32,460
"ب"ركلة رعد هاديس: لهيب فولاذ المطهر
.وانتصرت في المعركة

166
00:10:33,700 --> 00:10:37,410
.استخدمت "ركلة رعد هاديس: لهيب فولاذ المطهر" أخيرًا

167
00:10:37,410 --> 00:10:39,210
.إنها تقنية قوية جدًا

168
00:10:39,210 --> 00:10:42,960
.كان موته شبيهًا بموت المعلم السلمون الأحمر

169
00:10:42,960 --> 00:10:45,650
"استخدمت "ركلة رعد هاديس: لهيب فولاذ المطهر

170
00:10:45,650 --> 00:10:47,730
ضد المعلم السلمون الأحمر، أليس كذلك؟

171
00:10:48,710 --> 00:10:52,120
!هيّا، أرني ما تعلمتَه

172
00:10:52,120 --> 00:10:53,130
!حسنًا

173
00:10:56,100 --> 00:10:58,060
لماذا استخدمتها ضدّي؟

174
00:11:01,770 --> 00:11:04,320
،حققت السلام في العالم

175
00:11:04,320 --> 00:11:06,350
لكن العالم لم يتقبّلني

176
00:11:06,350 --> 00:11:08,480
.كبطل لأنّي كنتُ سلطعون ناسك

177
00:11:08,480 --> 00:11:09,650
.بالطبع

178
00:11:09,650 --> 00:11:13,490
ثم متّ جرّاء الشيخوخة
.دون أن تتحقق أحلامي

179
00:11:13,490 --> 00:11:18,400
إن كنتَ قد أنقذت العالم
.فأرى أنك حققت أحلامك كبطل

180
00:11:18,400 --> 00:11:21,430
.لم تستخدمني فتاة

181
00:11:22,450 --> 00:11:24,620
.إذًا في النهاية، كل شيء متعلق بالشهوة

182
00:11:24,620 --> 00:11:25,870
.تذكرت

183
00:11:25,870 --> 00:11:28,600
.أحضرتُ لكِ هدية: السلمون الأحمر المعلّب

184
00:11:28,600 --> 00:11:29,920
.لنتناول بعضه

185
00:11:30,800 --> 00:11:32,500
!تناوليني

186
00:11:32,810 --> 00:11:34,820
!السلمون الأحمر

187
00:11:35,920 --> 00:11:38,040
.لا أفهم لماذا تودّ تناول هذا

188
00:11:44,880 --> 00:11:47,140
.بلغت النسبة مائة بالمائة

189
00:11:47,260 --> 00:11:48,170
.حان وقت التحنيط

190
00:11:48,170 --> 00:11:49,650
!نهاية تعيسة بالتأكيد

191
00:11:50,240 --> 00:11:51,810
ما زالت هذه المزحة مستمرّة؟

192
00:11:51,810 --> 00:11:54,090
!حنطيني بهيئة سلطعون الناسك على الأقل

193
00:11:54,090 --> 00:11:56,780
.أحببتَ تلك الهيئة إذًا

194
00:11:56,780 --> 00:11:57,820
.حسنًا

195
00:12:02,080 --> 00:12:05,420
...هذه الزاوية... رائعة

196
00:12:08,100 --> 00:12:09,880
.سأضعك في هذا الصندوق

197
00:12:10,200 --> 00:12:13,430
!أيتها الإلهة! لا أستطيع الرؤية

198
00:12:17,920 --> 00:12:20,970
.هذا السمك المعلّب لذيذ

199
00:12:23,400 --> 00:12:26,980
.يجب أن أجعله يتجسّد مرة أخرى قريبًا

200
00:12:29,730 --> 00:12:32,030
.حدّد إلى أين تريد الذهاب بعد هذا

201
00:12:33,190 --> 00:12:36,940
.لا يُجيب. يبدو أنه مجرّد سلطعون ناسك محنّط

202
00:12:53,660 --> 00:12:57,130
...الإلهة تغيّر ثيابها

203
00:13:00,600 --> 00:13:01,550
.ريسباون

204
00:13:03,280 --> 00:13:05,920
!أشعر على طبيعتي أكثر في هذا الجسد

205
00:13:05,920 --> 00:13:07,680
.الجسد البشري هو الأفضل

206
00:13:07,680 --> 00:13:09,780
فاجأتني لأنك كنت قادرًا على التحرك
.رغم تحنيطك

207
00:13:09,780 --> 00:13:11,960
!قوة الإرادة

208
00:13:11,960 --> 00:13:14,520
.بل الأمر أقرب لهوس الانحراف

209
00:13:14,520 --> 00:13:19,280
.حفّزت كل تلك الأصوات التي كنتِ تصدرينها مخيّلتي

210
00:13:19,280 --> 00:13:21,380
...إن كنتَ ستتصرّف كسلطعون ناسك ماكر

211
00:13:23,410 --> 00:13:25,640
.ربما سأحوّلك إلى معجون

212
00:13:25,640 --> 00:13:30,010
!حان وقت تجسّدي التالي

213
00:13:42,820 --> 00:13:45,350
."الباب الأيمن لقلعة ملك الشياطين"

214
00:13:45,350 --> 00:13:47,930
!يبدو هذ رائعًا
!الباب الأيمن لقلعة ملك الشياطين

215
00:13:47,930 --> 00:13:52,820
.يجب أن تلتزم بقولك أن الجسد البشري هو الأفضل

216
00:13:53,210 --> 00:13:55,820
إذًا؟ أهناك خواصّ تودّ إضافتها؟

217
00:13:55,820 --> 00:13:57,520
هل يمكنني أن أكون بابًا أوتوماتيكيًا؟

218
00:13:57,520 --> 00:13:58,650
.لا

219
00:14:04,560 --> 00:14:05,990
هذا الباب مجددًا؟

220
00:14:06,530 --> 00:14:08,700
نستعين ببنك المشاهد ونحن في الحلقة الثانية؟

221
00:14:08,700 --> 00:14:11,330
.إنه باب إعادة التجسّد الوحيد لدينا

222
00:14:11,330 --> 00:14:15,290
ويعاني كل استوديو في مجال الأنمي
.من نقصٍ في الموظّفين

223
00:14:15,290 --> 00:14:18,030
...فهمت... ما باليد حيلة إذًا

224
00:14:19,400 --> 00:14:21,230
.ينبغي أن تكون تعلّمت توقع هذا

225
00:14:37,120 --> 00:14:38,620
!الباب الأيمن

226
00:14:43,100 --> 00:14:44,990
.أودّ طلب المزيد

227
00:14:44,990 --> 00:14:47,860
من أين أطلب؟

228
00:14:48,200 --> 00:14:52,700
!أيتها الإلهة

229
00:14:51,040 --> 00:14:52,420
.أهلًا بعودتك

230
00:14:54,410 --> 00:14:56,680
.هذا كرسيّ متحرك إذًا

231
00:14:56,680 --> 00:14:58,340
.أستطيع التحكم به بإرادتي

232
00:14:58,340 --> 00:14:59,640
.أنا جائعة

233
00:14:59,640 --> 00:15:03,400
سأعدّ لنا بعض الأرز المقليّ
!لتناوله مع ما بقي من كاري البارحة

234
00:15:12,060 --> 00:15:15,330
.لا تتحكم في غرفتي بفرقعة أصابعك رجاءً

235
00:15:15,330 --> 00:15:17,780
!بدأتُ أشعر أنّي في بيتي

236
00:15:17,780 --> 00:15:20,320
.بدأتُ أشعر أنك استوليتَ على غرفتي

237
00:15:22,320 --> 00:15:26,570
كان من السيئ لعب دور
.الباب الأيمن لقلعة ملك الشياطين

238
00:15:26,570 --> 00:15:27,580
.هذا واضح

239
00:15:31,100 --> 00:15:34,520
.يمكنني الاستماع إلى تقريرك

240
00:15:34,520 --> 00:15:37,200
.لكن واصل الطهي

241
00:15:37,200 --> 00:15:38,880
...حسنًا

242
00:15:43,010 --> 00:15:45,260
في بادئ الأمر، كنتُ في غرفة العرش
،داخل قلعة ملك الشياطين

243
00:15:45,260 --> 00:15:46,880
!أعمل بجدّ كباب

244
00:15:46,880 --> 00:15:48,680
تعمل بجدّ كباب؟

245
00:15:55,500 --> 00:15:57,360
.فهمت. كنتَ بابًا مفخخًا إذًا

246
00:15:57,360 --> 00:16:00,480
!قلعة ملك الشياطين مليئة بالغبار

247
00:16:00,770 --> 00:16:03,580
كما أنّي أعاني من حساسية القطط
.لذا كنتُ أعطس باستمرار

248
00:16:03,580 --> 00:16:05,600
.الأسود قطط بطبعها، أجل

249
00:16:06,120 --> 00:16:07,080
.تذكرت

250
00:16:07,080 --> 00:16:09,050
!كان بعض الوحوش يبدون أقوياء جدًا

251
00:16:09,050 --> 00:16:09,860
...كان أحدهم يُدعى

252
00:16:09,860 --> 00:16:12,170
..."الجنرال الذي لا يُهزم"

253
00:16:12,170 --> 00:16:15,580
!غارينزا

254
00:16:15,580 --> 00:16:16,700
!مرحبًا

255
00:16:16,700 --> 00:16:20,630
!أتيتُ للقاء ملك الشياطين

256
00:16:34,680 --> 00:16:36,140
كيف لا يزال على قيد الحياة؟

257
00:16:36,140 --> 00:16:38,890
!كانت قوته حقيقيّة

258
00:16:39,600 --> 00:16:42,290
،كان جنرالًا، لكن فور إمساكه بفأسيه الحربيين

259
00:16:42,290 --> 00:16:45,480
!كان يندفع نحو صفوف العدوّ وحيدًا

260
00:16:45,480 --> 00:16:46,400
!ساخن

261
00:16:46,400 --> 00:16:48,130
.ركّز من فضلك

262
00:16:48,130 --> 00:16:49,740
.أنت تُفسك قصة بسالته

263
00:16:52,540 --> 00:16:54,580
...عمومًا، لقي حتفه بعدما

264
00:17:00,570 --> 00:17:01,700
!سحقته

265
00:17:01,700 --> 00:17:03,750
.قضيتَ عليه إذًا

266
00:17:13,180 --> 00:17:15,530
قتلتُ معظم جنرالات ملك الشياطين
.بالطريقة ذاتها

267
00:17:15,530 --> 00:17:19,680
.يُفاجئني أنه لم يرمك في في مكبّ النفايات بعد ذلك

268
00:17:19,680 --> 00:17:21,940
كنتُ أملك قدرة مميّزة

269
00:17:21,940 --> 00:17:25,940
.منعت اشتباه جيش ملك الشياطين بي

270
00:17:25,940 --> 00:17:27,980
!نضيف الكاري

271
00:17:28,840 --> 00:17:30,590
.رائحة طيّبة

272
00:17:31,020 --> 00:17:34,030
لكن هل أضفتُ تلك الخاصية؟

273
00:17:34,030 --> 00:17:36,990
.بل كانت قدرة الباب الأيسر

274
00:17:36,990 --> 00:17:39,990
...كان بابًا واعيًا أيضًا، لكن

275
00:17:41,040 --> 00:17:43,100
.لم تنشأ بيننا صداقة

276
00:17:43,100 --> 00:17:49,060
!أحمق! عليك أن تخدم ملك الشياطين بولاء

277
00:17:49,060 --> 00:17:51,040
!لا يحتاج هذا العالم إلى ملك شياطين

278
00:17:51,040 --> 00:17:52,570
!بل يحتاجه

279
00:17:52,570 --> 00:17:53,680
!لا يحتاجه

280
00:17:54,000 --> 00:17:54,890
!اخرس

281
00:17:54,890 --> 00:17:56,080
!اخرس أنت

282
00:17:56,510 --> 00:17:58,700
.يفاجئني أن ملك الشياطين لم يُجنّ

283
00:17:58,700 --> 00:18:02,910
.منعته تلك القدرة من الاشتباه بنا

284
00:18:04,440 --> 00:18:09,570
لذا كان يرى أن كلامنا صادر
.عن أصوات غامضة داخل رأسه

285
00:18:09,570 --> 00:18:11,320
ألن يصيبه ذلك بالجنون؟

286
00:18:12,320 --> 00:18:16,350
وهكذا بدأت هزائم جيوش ملك الشياطين
.تتوالى على أيدي البشر

287
00:18:17,280 --> 00:18:18,320
،هذا متوقع

288
00:18:18,320 --> 00:18:22,560
.بعد أن سحق بابٌ جميع قادتهم

289
00:18:23,120 --> 00:18:26,080
.احرص على أن تكون السلطة زاهية الألوان

290
00:18:26,080 --> 00:18:26,840
!حسنًا

291
00:18:28,050 --> 00:18:29,840
!سأحقق لنا النصر

292
00:18:29,840 --> 00:18:34,100
.ثم وصل البطل يوراليكتوغروليت

293
00:18:35,540 --> 00:18:37,080
أنت وحدك؟

294
00:18:37,080 --> 00:18:38,420
.يبدو أن الجميع يكرهونك

295
00:18:40,720 --> 00:18:42,180
!ارحل يا ملك الشياطين

296
00:18:45,810 --> 00:18:48,080
!إليك هذا

297
00:18:54,120 --> 00:18:55,720
ماذا؟

298
00:18:55,720 --> 00:18:57,320
تجدّد ملك الشياطين

299
00:18:57,320 --> 00:18:59,860
.وصار أكثر قوة كلما اقترب من الموت

300
00:18:59,860 --> 00:19:02,700
.كان يملك قدرة خارقة تُدعى النموّ اللانهائي

301
00:19:03,150 --> 00:19:06,580
!بل هناك من يحبني

302
00:19:06,580 --> 00:19:07,290
!بئسًا

303
00:19:10,960 --> 00:19:12,620
!أثّر به ذلك حقًا

304
00:19:12,620 --> 00:19:13,720
...ثم

305
00:19:17,040 --> 00:19:20,460
أطلق الباب الأيسر فجأة
،هجومًا سحريًا من الخلف

306
00:19:20,460 --> 00:19:22,270
!وكان البطل عرضةً لخطر محدق

307
00:19:23,380 --> 00:19:25,690
!كان البطل سيلقى حتفه

308
00:19:25,690 --> 00:19:28,810
!لكن كل ما بوسعي فعله هو أن أفتح وأغلق

309
00:19:31,560 --> 00:19:34,900
لم أتوقع أن يكون الباب الأيسر
.قادرًا على الهجوم

310
00:19:34,900 --> 00:19:36,050
أليس كذلك؟

311
00:19:36,050 --> 00:19:39,280
أخبرته أن من غير المنطقيّ
!أن تكون الأبواب قادرة على استخدام السحر

312
00:19:39,280 --> 00:19:41,410
.لا أعتقد أنه يحقّ لك التذمّر

313
00:19:41,410 --> 00:19:44,540
.لكن ما حدث بعدها كان أسوء

314
00:19:44,540 --> 00:19:47,480
لم تهزم ملك الشياطين لتكون نهايتك سعيدة؟

315
00:19:47,480 --> 00:19:49,170
...ما حدث

316
00:19:49,170 --> 00:19:51,590
!هيّا مُت

317
00:19:53,120 --> 00:19:55,300
!توقف وإلّا قتلتك

318
00:19:56,090 --> 00:20:01,970
أحدث هذا... لأنّ الجميع يكرهونني؟

319
00:20:08,540 --> 00:20:10,360
حالفك الحظّ وهزمته؟

320
00:20:10,360 --> 00:20:14,720
!أجل

321
00:20:14,720 --> 00:20:16,200
البطل وبطلاته الـ12

322
00:20:16,200 --> 00:20:20,130
.ذوات المظهر المميّز ابتهجوا بنصرهم المفاجئ

323
00:20:20,130 --> 00:20:22,410
.أضيف عنصر الحريم بعد تفكير لاحق

324
00:20:22,410 --> 00:20:25,790
.لكن كانت إحداهنّ تملك أذنيّ قطة

325
00:20:25,790 --> 00:20:28,410
!هاهاها! مياو

326
00:20:28,410 --> 00:20:30,580
ألم تقل أن تعاني من حساسية القطط؟

327
00:20:35,410 --> 00:20:36,620
.أفسدت الأمر

328
00:20:36,620 --> 00:20:37,750
!أجل

329
00:20:38,600 --> 00:20:41,430
ما خطبك أيها الباب اللعين؟

330
00:20:41,430 --> 00:20:43,680
!أيها الباب القذر عديم الفائدة

331
00:20:43,680 --> 00:20:44,680
!لا تتكلم

332
00:20:44,680 --> 00:20:46,560
!إنها غلطتكنّ

333
00:20:46,560 --> 00:20:48,140
!تحتشدن قرب المخرج

334
00:20:48,140 --> 00:20:50,730
!لا

335
00:20:51,180 --> 00:20:54,460
،خضنا أنا والبطلات الغاضبات معركة ملحمية

336
00:20:54,460 --> 00:20:56,330
.ودمّرتُ قلعة ملك الشياطين

337
00:20:56,330 --> 00:21:01,300
.فقدتُ هويّتي كباب قلعة ملك الشياطين واختفيتُ من الوجود

338
00:21:04,020 --> 00:21:05,990
.والآن، لنتناول العشاء

339
00:21:05,990 --> 00:21:06,920
.مهلًا

340
00:21:06,920 --> 00:21:07,450
!أجل

341
00:21:08,490 --> 00:21:11,000
.لم أرَ هذه الطاولة من قبل

342
00:21:11,000 --> 00:21:13,400
!إنها هدية
!الباب الأيسر لقلعة ملك الشياطين

343
00:21:13,400 --> 00:21:15,530
.حوّلته إلى طاولة

344
00:21:15,530 --> 00:21:18,510
.تستحق الثناء لأنك لا تُهدر الأشياء

345
00:21:19,000 --> 00:21:19,670
،والآن

346
00:21:20,210 --> 00:21:21,430
.لنأكل

347
00:21:21,740 --> 00:21:23,150
!لنأكل

348
00:21:29,180 --> 00:21:29,900
!لذيذ

349
00:21:33,240 --> 00:21:34,530
،إن كان يروقك

350
00:21:34,530 --> 00:21:36,860
!سأعدّ لكِ مأكولات كهذه يوميًا

351
00:21:36,860 --> 00:21:39,800
.أحتاج إلى الأرز المقليّ بالكاري مرة في الأسبوع فقط

352
00:21:39,800 --> 00:21:40,940
.حسنًا، حسنًا