1
00:00:21,970 --> 00:00:22,660
.حسنًا

2
00:00:23,260 --> 00:00:24,670
.سأطرح عليك سؤالاً آخر

3
00:00:25,310 --> 00:00:27,470
هل أعرف هذا الرّجل؟

4
00:01:58,250 --> 00:02:00,470
.أعتقد أنّك لا تعرفه

5
00:02:00,850 --> 00:02:01,730
لا أعرفه؟

6
00:02:03,260 --> 00:02:05,970
.إذًا فلا علاقة للأمر بالنّاس الّذين حولي

7
00:02:06,560 --> 00:02:07,270
ما رأيك بهذا؟

8
00:02:07,660 --> 00:02:12,310
سامحك فرصة للفوز بسرّ صغير
.بعد أن عرفتَ ماضِيّ الآن

9
00:02:12,770 --> 00:02:14,740
فرصة للفوز بسرّ؟

10
00:02:16,140 --> 00:02:17,470
.يمكنك إنشاء غرفة هروب

11
00:02:17,850 --> 00:02:21,510
.سأخبرك بالسّرّ إن أثارت إعجابي

12
00:02:23,560 --> 00:02:24,150
.حسنًا

13
00:02:27,250 --> 00:02:31,050
.خطوتي التّالي هي تجهيز غرفة هروب

14
00:02:46,200 --> 00:02:47,850
.هذه المنازل القديمة فارغة

15
00:02:48,060 --> 00:02:49,070
.ربّما أستطيع استعمالها

16
00:02:49,830 --> 00:02:50,970
.لكنّي بحاجة للتّحقّق منها

17
00:02:52,520 --> 00:02:56,970
يضمّ متجر أقفال أبي الكثير من أجزاء الخردة
.الّتي يمكنني توفير مال كثير باستعمالها

18
00:02:58,840 --> 00:03:02,070
.سيكون عليّ شراء بقيّة الأغراض من مركز التّسوّق

19
00:03:10,550 --> 00:03:12,860
.يا ريشينغ، سأنشئ غرفة هروب

20
00:03:13,110 --> 00:03:14,470
.حسنًا، أنا قادم

21
00:03:25,730 --> 00:03:27,700
.سيفي هذا الكوخ القديم بالغرض

22
00:03:28,120 --> 00:03:28,970
.كما أنّه منعزل قليلاً

23
00:03:30,380 --> 00:03:30,970
هل أنت جاهز؟

24
00:03:32,850 --> 00:03:33,970
.لنقم بهذا

25
00:03:35,550 --> 00:03:37,970
.هذا كوخ تقليديّ قديم الطّراز

26
00:03:38,680 --> 00:03:43,050
،وضعتُ دُرجين متطابقين هنا
.وهما التّصميم الأساسيّ لغرفة الهروب

27
00:03:44,140 --> 00:03:45,100
.إنّهما متطابقان

28
00:03:45,480 --> 00:03:48,510
.يمكن الحصول على مفتاحين، ألف وباء، إن سُحبا

29
00:03:49,020 --> 00:03:52,970
سيكون من الضّروريّ الجمع بين
.المفتاحين لفتح قفل الخزانة

30
00:03:54,490 --> 00:03:56,310
،بسبب مبدأ الحثّ لجهاز التّحكم عن بعد في التّلفاز

31
00:03:56,870 --> 00:03:59,030
يمكن الحصول على المفتاح جيم
لمغادرة غرفة الهروب

32
00:03:59,270 --> 00:04:01,640
فقط عند سحب مقبضَيْ الدُّرجين
.في نفس الوقت

33
00:04:02,770 --> 00:04:06,050
كما أنّ الدُّرجين مثبّتين
.في الغرفتين في كلا الجانبين

34
00:04:06,530 --> 00:04:08,650
لذلك لا يستطيع شخص
.واحد سحبهما في نفس الوقت

35
00:04:09,400 --> 00:04:13,300
والخيط الّذي يمكن استخدامه لسحب المقابض
.في نفس الوقت مغلق في خزانة بجانب الدُّرج

36
00:04:16,430 --> 00:04:20,950
هذان الفخّان فقط كافيان لأخذ
.نصف ساعة من وقت شخص غير خبير

37
00:04:25,540 --> 00:04:26,930
.اسمع يا ريشينغ

38
00:04:27,820 --> 00:04:28,430
ماذا؟

39
00:04:34,090 --> 00:04:37,390
هل سبق وأخبرك أيّ أحد من قبل أنّ رقيق؟

40
00:04:39,290 --> 00:04:41,430
خدعتني للمجيء إلى هنا لأيّ سبب؟

41
00:04:44,670 --> 00:04:46,430
.قل أنّي أنثويّ فحسب

42
00:04:46,760 --> 00:04:47,470
.كلاّ

43
00:04:47,870 --> 00:04:49,180
.ذلك ليس ما قصدت

44
00:04:49,360 --> 00:04:51,410
لكنّي هكذا. ما الّذي ستفعله؟

45
00:04:52,800 --> 00:04:54,180
.كانت مجرّد ملاحظة

46
00:04:54,300 --> 00:04:55,850
.لنواصل، لنواصل

47
00:05:01,670 --> 00:05:02,160
.تفضّل

48
00:05:06,080 --> 00:05:06,430
.بصحّتك

49
00:05:14,250 --> 00:05:15,090
.ريشينغ

50
00:05:15,090 --> 00:05:15,500
ماذا؟

51
00:05:15,780 --> 00:05:18,470
.انتهيت من غرفة الهروب هذه بفضلك

52
00:05:19,070 --> 00:05:21,250
.ويبدو أنّك على معرفة بغرف الهروب

53
00:05:22,130 --> 00:05:23,880
هل قمت بشيء مشابه لهذا من قبل؟

54
00:05:25,580 --> 00:05:27,120
.على الإطلاق، شكرًا لك

55
00:05:27,120 --> 00:05:28,930
.أنت من صمّم غرفة الهروب هذه

56
00:05:29,370 --> 00:05:30,780
.ساعدتك فحسب

57
00:05:32,420 --> 00:05:36,050
.الخطوة التّالية هي إبلاغ شينمانغ بالأمر

58
00:05:42,960 --> 00:05:44,190
ما الّذي تفعله هنا مجدّدًا؟

59
00:05:44,820 --> 00:05:46,350
.ليس مرحّبًا بك هنا اليوم

60
00:05:47,990 --> 00:05:48,760
أين شينمانغ؟

61
00:05:49,840 --> 00:05:50,600
ماذا؟

62
00:05:51,110 --> 00:05:53,390
هل تخبرني أنّ لديك حبيبة جديدة بهذه البساطة؟

63
00:05:54,070 --> 00:05:55,000
.أردت الحديث معها بشأن أمر ما

64
00:05:55,590 --> 00:05:56,290
أين هي؟

65
00:06:02,690 --> 00:06:03,870
صعدت وحدك؟

66
00:06:04,090 --> 00:06:04,680
.نعم

67
00:06:05,180 --> 00:06:06,150
.أنا هنا من أجلك

68
00:06:06,920 --> 00:06:08,160
من أجلي؟

69
00:06:09,110 --> 00:06:10,680
.يا له من شرف عظيم

70
00:06:10,680 --> 00:06:12,050
.بربّك

71
00:06:12,200 --> 00:06:15,850
.أنا هنا لإخبارك أنّ غرفة الهروب جاهزة

72
00:06:15,960 --> 00:06:16,890
متى ستأتين؟

73
00:06:19,070 --> 00:06:20,890
.ربّما غدًا مساءً

74
00:06:20,890 --> 00:06:21,380
.حسنًا

75
00:06:47,770 --> 00:06:48,950
هل نبدأ الآن؟

76
00:06:49,150 --> 00:06:51,480
.تمتلئ غرفة أسرار أيو بالزّبائن في حوالي الثّامنة

77
00:06:51,480 --> 00:06:52,680
.عليّ العودة قبل ذلك

78
00:06:53,340 --> 00:06:54,340
لا راحة في نهاية الأسبوع؟

79
00:06:55,080 --> 00:06:56,460
!رئيستك فظيعة

80
00:06:56,630 --> 00:06:57,630
!أعلم

81
00:06:57,860 --> 00:07:01,970
قبل أيّام، وضعت مادّة رغويّة
!في منعّم الشّعر سرًّا

82
00:07:02,350 --> 00:07:05,390
لم نستطع التّخلّص من
.الرّغوة على رؤوسنا جرّاء ذلك

83
00:07:05,920 --> 00:07:10,850
لم نساعدها عندما التقطتَ
.تلك الصّور، لذلك انتقمت منّا

84
00:07:11,510 --> 00:07:12,720
كيف أمكنها ذلك؟

85
00:07:13,190 --> 00:07:14,810
لماذا لم تستقيلي فحسب؟

86
00:07:16,340 --> 00:07:17,500
.لا أستطيع

87
00:07:17,500 --> 00:07:19,740
.إنّها تقدّم لنا طعامًا ومسكنًا بالمجّان، إضافة لمكافآت

88
00:07:20,120 --> 00:07:21,950
.لا يمكنني العثور على عمل أفضل في أيّ مكان آخر

89
00:07:21,950 --> 00:07:23,530
مكافآت أيضًا؟

90
00:07:24,390 --> 00:07:28,250
كانت الأربعة آلاف يوان الّتي عرضتها
!شو أيو مجرّد راتب أساسيّ

91
00:07:28,820 --> 00:07:29,600
.نعم

92
00:07:29,910 --> 00:07:32,390
.أتقاضى حوالي 7000 في الشّهر

93
00:07:32,860 --> 00:07:34,090
أليست لديك مكافآت؟

94
00:07:34,090 --> 00:07:35,200
مكافآت؟

95
00:07:35,390 --> 00:07:37,760
.إنّها أشبه بخرافة بالنّسبة لي

96
00:07:37,890 --> 00:07:38,990
.لم يذكر أيّ أحد ذلك لي

97
00:07:40,610 --> 00:07:43,220
،لهذا السّبب رئيستنا لئيمة

98
00:07:43,220 --> 00:07:46,180
.بإمكاننا مسامحتها لأنّها تدفع لنا الكثير

99
00:07:46,620 --> 00:07:48,430
.كلاّ! لا تسامحنها

100
00:07:48,800 --> 00:07:50,990
كيف لها الإفلات بأفعال لئيمة كهذه دائمًا؟

101
00:07:51,560 --> 00:07:53,390
كيف تبيعين روحك بالمال هكذا؟

102
00:07:55,800 --> 00:07:57,050
ماذا عساي أفعل؟

103
00:07:57,400 --> 00:08:01,340
أحتاج للمال لشراء الحقائب والأحذية
.وموادّ التّجميل والمجوهرات

104
00:08:01,770 --> 00:08:03,770
هل ستصرف عليّ إن استقلت؟

105
00:08:05,600 --> 00:08:10,980
بعد سماع ما قلتِه، أعتقد أيضًا
.أنّ من الممكن مسامحة شو أيو على أفعالها

106
00:08:11,180 --> 00:08:13,270
.في الحقيقة، هناك شيء تخافه أيضًا

107
00:08:13,570 --> 00:08:15,690
،إن تجاوزت الحدود وقمنا بإضراب

108
00:08:15,690 --> 00:08:17,320
،سيكون عليها إغلاق غرفة أسرار أيو

109
00:08:18,080 --> 00:08:19,700
.وهذا سيتسبّب لها بالخسارة

110
00:08:20,080 --> 00:08:22,590
.ثمّ ستأتي للتّوسّل إلينا في الحال

111
00:08:22,060 --> 00:08:22,910
.مهلاً لحظة

112
00:08:22,910 --> 00:08:24,300
.هذا ليس سبب مجيئك إلى هنا

113
00:08:22,910 --> 00:08:24,300
...ففي أحد المرّات

114
00:08:24,920 --> 00:08:26,640
.لنتحدّث عن هذا

115
00:08:27,120 --> 00:08:28,680
.ظننتُ أنّه ليس لديك وقت

116
00:08:29,970 --> 00:08:31,980
.صحيح، لقد نسيت

117
00:08:32,200 --> 00:08:32,750
.حسنًا

118
00:08:32,940 --> 00:08:33,910
.لنقم بهذا

119
00:08:35,820 --> 00:08:36,780
.القواعد هي نفسها عندكم

120
00:08:37,430 --> 00:08:38,710
.اتّصلي بك إن احتجت تلميحًا

121
00:08:38,870 --> 00:08:39,630
.سأكون في الخارج

122
00:08:40,680 --> 00:08:42,180
.لذلك ادخلي وابدئي اللّعب

123
00:08:56,090 --> 00:08:57,210
.تطلّب الأمر منّي 40 دقيقة

124
00:08:57,360 --> 00:08:58,510
ليس سيّئًا، صحيح؟

125
00:08:59,490 --> 00:09:00,500
.أنت سريعة

126
00:09:00,860 --> 00:09:04,210
.إنّه تصميم جيّد، وخاصّة المفتاحان

127
00:09:04,210 --> 00:09:05,750
.أخذ الأمر منّي وقتًا بالفعل

128
00:09:06,960 --> 00:09:08,610
ما رأيك؟

129
00:09:09,060 --> 00:09:09,900
هل نالت إعجابك؟

130
00:09:11,820 --> 00:09:14,710
.أبليت حسنًا بالموارد الّتي كانت لديك

131
00:09:14,710 --> 00:09:15,650
.عمل ممتاز

132
00:09:18,250 --> 00:09:19,980
.وضعتُ المكافأة في الغرفة

133
00:09:19,980 --> 00:09:21,680
.اذهب وخذها. عليها المغادرة

134
00:09:30,650 --> 00:09:31,580
صورة تخرّج؟

135
00:09:32,270 --> 00:09:35,910
.إنّها جامعتي، لكنّها ليست دفعتي

136
00:09:37,570 --> 00:09:38,430
شو أيو؟

137
00:09:41,020 --> 00:09:42,150
هو جي؟

138
00:10:03,600 --> 00:10:04,590
لماذا؟

139
00:10:11,930 --> 00:10:13,510
لماذا يواصلون إخفاء الأمر عليّ؟

140
00:10:15,650 --> 00:10:17,480
.هو جي وشو أيو يعرفان بعضهما لوقت طويل

141
00:10:17,780 --> 00:10:20,930
.لا بدّ أنّه الأمر الّذي أرادت شينمانغ إخباري به

142
00:10:22,500 --> 00:10:23,200
ما الخطب؟

143
00:10:23,950 --> 00:10:25,110
.لا تبدو في حالة جيّدة

144
00:10:25,110 --> 00:10:25,960
ماذا حدث؟

145
00:10:32,140 --> 00:10:32,890
.حسنًا

146
00:10:33,830 --> 00:10:36,430
.ساعدني على تحليل الأمر من وجد نظر خارجيّة

147
00:10:41,920 --> 00:10:43,150
.فهمت

148
00:10:45,000 --> 00:10:47,190
.لا بدّ أنّ لهو جي سرًّا ما

149
00:10:48,540 --> 00:10:50,430
هل يعقل أنّه العقل المدبّر لكلّ هذا؟

150
00:10:52,920 --> 00:10:53,640
.لا

151
00:10:54,120 --> 00:10:57,080
.أخبرتني شينمانغ أنّها تظنّ أنّي لا أعرف الجاني

152
00:10:58,070 --> 00:10:59,720
.هذا يعني أنّه ليس هو جي

153
00:11:00,840 --> 00:11:03,280
إذًا لماذا أخفى هو جي هذه الأمور عنّي؟

154
00:11:06,690 --> 00:11:09,170
.ربّما هو مجبر على ذلك

155
00:11:10,000 --> 00:11:12,580
.بالتّفكير في الأمر، تخرّجنا جميعًا في 2006

156
00:11:13,250 --> 00:11:17,550
.ارتدنا أنا وشينمانغ وشو أيو وهو جي نفس الجامعة

157
00:11:18,840 --> 00:11:20,140
.كمّا أنا شينمانغ في نفص الفصل

158
00:11:20,560 --> 00:11:21,880
.وكذلك هو جي وشو أيو

159
00:11:23,540 --> 00:11:26,730
ما العلاقة بيننا الّتي يحاولون إخفاءها؟

160
00:11:27,520 --> 00:11:28,800
هل فكّرت في الأمر؟

161
00:11:29,340 --> 00:11:30,020
ماذا؟

162
00:11:30,020 --> 00:11:32,430
،بما أنّ شينمانغ قالت أنّها لا تعرف ذلك الشّخص

163
00:11:33,590 --> 00:11:36,390
.ربّما لم تدرك وجوده فحسب

164
00:11:38,120 --> 00:11:41,970
.وهو جي كان يحاول حمايتك فحسب

165
00:11:42,110 --> 00:11:43,270
لم أدرك وجوده؟

166
00:11:44,560 --> 00:11:46,930
إن وُجد شخص كهذا، فكيف لا أدرك ذلك؟

167
00:11:48,440 --> 00:11:52,930
على سبيل المثال، ماذا لو كنتُ خلف كلّ هذا؟

168
00:12:07,760 --> 00:12:10,110
.يعرف يان يوتشو أنّنا كنّا زملاء دراسة الآن

169
00:12:11,270 --> 00:12:12,200
أخبرته بذلك؟

170
00:12:13,120 --> 00:12:13,670
.نعم

171
00:12:14,460 --> 00:12:15,310
أين هو الآن؟

172
00:12:16,130 --> 00:12:17,870
.أعتقد أنّه في طريقه لمواجهتك

173
00:12:19,230 --> 00:12:20,370
!هذا جنونيّ

174
00:12:20,600 --> 00:12:21,680
!كفّي عن إحداث المزيد من الفوضى

175
00:12:22,410 --> 00:12:23,300
وماذا عساي أفعل؟

176
00:12:23,660 --> 00:12:24,680
ماذا تريدني أن أفعل؟

177
00:12:25,830 --> 00:12:27,990
.لا تتدخّلي فحسب

178
00:12:28,560 --> 00:12:30,160
.تصرّفي أنّك لا تعرفين أيّ شيء

179
00:12:31,730 --> 00:12:37,140
يمكنني فعل ذلك، لكنّي أريدك أن تخبرني
.مباشرة ما الّذي حدث حينها بالضّبط

180
00:12:38,170 --> 00:12:43,440
في الجامعة، كنّا أنا وأنت وشو أيو
.ويان يوتشو على وفاق تامّ

181
00:12:43,970 --> 00:12:45,870
.حتّى أنّنا أسّسنا مجموعة محبّي غرف الهروب

182
00:12:46,890 --> 00:12:48,740
.كان وقت صبًا جميل

183
00:12:49,550 --> 00:12:51,470
.وقتها، كان اسمه يان يوشانغ

184
00:12:51,830 --> 00:12:54,200
.كان هو وشو أيو مقرّبان من بعض

185
00:12:54,810 --> 00:12:56,360
.تلك هي بداية الكابوس

186
00:12:58,490 --> 00:13:01,810
.إلى أن مات والد شو أيو في تلك الحادثة

187
00:13:02,270 --> 00:13:04,890
.تعرفين جيّدًا إن كانت حادثة أم لا

188
00:13:06,060 --> 00:13:07,640
.أتمنّى لو كانت حادثة

189
00:13:08,260 --> 00:13:12,060
كان والد شو أيو محاصرًا في غرفة
.هروب عندما أصيب بنوبة قلبيّة

190
00:13:13,150 --> 00:13:16,840
.غرفة الهروب تلك كانت من تصميم يان يوشانغ

191
00:13:19,150 --> 00:13:21,390
.كما أنّه كان لديه دافع

192
00:13:22,620 --> 00:13:27,650
.أعتقد أنّني أعرف ما هو دافعه

193
00:13:28,900 --> 00:13:32,230
.لاحقًا، أصيب يان يوشانغ وصارت له شخصيّة أخرى

194
00:13:33,240 --> 00:13:35,680
.وبعد تلك الإصابة، نسي ما حدث بالكامل

195
00:13:36,490 --> 00:13:38,220
،حاولت إخباره بالحقيقة

196
00:13:39,050 --> 00:13:42,560
لكنّها كانت كثيرة عليه وفقد ذاكرته
.ثانية في كلّ مرّة يسمع فيها بشأن هذا

197
00:13:44,490 --> 00:13:47,890
،ولكي يُعالج من مرضه
.سمح له والداه بالتّغيّب سنة عن دراسته

198
00:13:48,900 --> 00:13:53,910
وحرقوا جميع الصّور الّتي كانت له
.معنا لدفعه على نسيان الماضي بالكامل

199
00:13:55,270 --> 00:13:57,090
،ظننتُ أنّ كلّ شيء انتهى

200
00:13:57,890 --> 00:14:00,120
لكنّه عاد بشكل غير متوقّع

201
00:14:01,170 --> 00:14:02,390
.وباسم آخر

202
00:14:11,700 --> 00:14:13,120
تفاجأت أكثر

203
00:14:13,890 --> 00:14:17,640
عندما فتحت شو أيو غرفة أسرار أيو
.بعد تركها للجامعة

204
00:14:19,440 --> 00:14:20,540
.يا لها من مصادفة

205
00:14:21,340 --> 00:14:23,390
.قابل الاثنان بعضهما ثانية

206
00:14:23,730 --> 00:14:30,770
تقصد أنّ شو أيو تريد الانتقام؟

207
00:14:32,110 --> 00:14:33,900
كانت غرفة الهروب السّبب غير المباشر
.لوفاة والدها

208
00:14:34,250 --> 00:14:35,460
،حتّى إن لجأت للقضاء

209
00:14:35,710 --> 00:14:37,300
،فسيُحاكم بتهمة القتل غير العمد

210
00:14:37,490 --> 00:14:39,580
.ناهيك عن أن يان يوشانغ مريض نفسيّ

211
00:14:40,470 --> 00:14:43,010
،أعتقد أنّ شو أيو تريده أن يتذكّر الماضي

212
00:14:43,890 --> 00:14:45,600
ويؤنّبه ضميره

213
00:14:45,940 --> 00:14:47,150
.قبل القيام بحركتها

214
00:14:48,900 --> 00:14:50,760
،لكنّه سيفقد ذاكرته ثانية إن أخبرته بالأمر مباشرة

215
00:14:51,610 --> 00:14:56,060
لهذا السّبب فعلت شو أيو
كلّ ما باستطاعتها للتّقرّب منه

216
00:14:56,060 --> 00:14:58,090
.وكشف الحقيقة شيئًا فشيئًا

217
00:14:59,650 --> 00:15:01,390
هذا ما تفكّر فيه؟

218
00:15:02,240 --> 00:15:03,330
.كلاهما صديقاي

219
00:15:04,460 --> 00:15:06,800
.أريد فقط محاولة تفادي حدوث مأساة ثانية

220
00:15:09,840 --> 00:15:12,780
.استمعي لي ولا تتدخّلي

221
00:15:13,550 --> 00:15:15,490
،لا تتحدّثي عن الماضي مع يان يوتشو ثانية

222
00:15:16,480 --> 00:15:17,390
...وإلاّ

223
00:15:18,530 --> 00:15:20,700
،عندما يستعيد يان يوتشو ذاكرته

224
00:15:22,160 --> 00:15:24,710
.ستقوم شو أيو بحركتها في الحال

225
00:15:44,110 --> 00:15:48,510
.ربّما الوقت هو أفضل دواء لشفاء النّدوب

226
00:15:55,360 --> 00:15:57,710
ولكن، هل سيكون لقاء الاثنين المقدّر

227
00:15:59,120 --> 00:16:01,630
هو ما سيفتح النّدوب ثانية؟