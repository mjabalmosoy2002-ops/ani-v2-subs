1
00:00:17,080 --> 00:00:18,370
هل فكّرت في الأمر؟

2
00:00:18,740 --> 00:00:19,390
ماذا؟

3
00:00:19,980 --> 00:00:22,360
،بما أنّ شينمانغ قالت أنّها لا تعرف ذلك الشّخص

4
00:00:23,750 --> 00:00:26,550
.ربّما لم تدرك وجوده فحسب

5
00:00:27,380 --> 00:00:31,810
.وهو جي كان يحاول حمايتك فحسب

6
00:00:32,190 --> 00:00:33,220
لم أدرك وجوده؟

7
00:00:34,810 --> 00:00:37,090
إن وُجد شخص كهذا، فكيف لا أدرك ذلك؟

8
00:00:38,310 --> 00:00:42,770
على سبيل المثال، ماذا لو كنتُ خلف كلّ هذا؟

9
00:02:17,730 --> 00:02:19,000
كيف يعقل أن يكون هذا؟

10
00:02:19,630 --> 00:02:20,930
.لم أفكّر أبدًا أنّه قد يكون أنت

11
00:02:21,830 --> 00:02:23,470
لماذا قلت ذلك؟

12
00:02:25,230 --> 00:02:26,350
.كان مجرّد مثال

13
00:02:26,830 --> 00:02:28,110
.ما زال ينقصك شخص

14
00:02:28,890 --> 00:02:31,970
من عساه يكون باستثنائك؟

15
00:02:32,000 --> 00:02:33,180
.أنت بنفسك

16
00:02:34,770 --> 00:02:39,430
ألم تفكّر أبدًا أنّه كان هنالك
واحد آخر في العالم؟

17
00:02:42,070 --> 00:02:43,180
ما هذا الهراء الّذي تقوله؟

18
00:02:46,290 --> 00:02:47,220
.انس الأمر

19
00:02:47,790 --> 00:02:49,390
!عليّ الآن مواجهة هو جي

20
00:02:50,700 --> 00:02:54,110
،بهذا الدّليل الضّعيف ضدّه الآن
.باستطاعته إيجاد عذر بسهولة

21
00:02:54,900 --> 00:02:55,560
.معك حقّ

22
00:02:56,460 --> 00:03:00,010
،عليّ الحصول على دلائل أكثر
.بل ودامغة لدفعه على الاعتراف

23
00:03:00,450 --> 00:03:01,670
.تعال معي

24
00:03:18,100 --> 00:03:20,490
،هذه ليست شركة المراسلات الّتي تعاقدنا معها

25
00:03:19,900 --> 00:03:22,030
.يوتشو، وصلك بريد

26
00:03:21,580 --> 00:03:23,660
وهو نفس الظّرف كما
.في الرّسالة المجهولة الّتي تلقّيتها

27
00:03:25,440 --> 00:03:26,790
.لا بدّ من دلائل أخرى

28
00:03:36,840 --> 00:03:37,520
...هذه

29
00:03:38,400 --> 00:03:40,940
انتقل هو جي إلى فريقه
.قبل أسبوع من مجيئي إلى هنا

30
00:03:40,600 --> 00:03:42,920
.في الحقيقة، أتيت قبل ثلاثة أشهر من قدومك

31
00:03:42,920 --> 00:03:44,160
.أتى خصّيصًا من أجلي

32
00:03:45,210 --> 00:03:46,350
،بالتّفكير في الأمر

33
00:03:46,630 --> 00:03:50,270
نصحني هو جي ألاّ أدخل عندما مررنا
.قرب غرفة أسرار أيو للمرّة الأولى

34
00:03:49,510 --> 00:03:50,620
.هذا المكان غريب

35
00:03:50,620 --> 00:03:52,130
.علينا المغادرة بعد توقّف المطر

36
00:03:51,880 --> 00:03:55,500
بعد ذلك، أرادني أن أظلّ بعيدًا
.منها دائمًا ومن شو أيو

37
00:03:55,720 --> 00:03:57,500
.حتّى أنّه اقترح أن أواعد شي يو

38
00:03:58,030 --> 00:03:59,970
.لم أفكّر في الأمر مليًّا وقتها

39
00:03:59,430 --> 00:04:01,270
،إن كنت تريد حبيبة

40
00:04:01,270 --> 00:04:03,010
.أعتقد أنّ شي يو ستكون خيارًا أفضل

41
00:04:03,010 --> 00:04:04,530
لكن يبدو الآن

42
00:04:07,100 --> 00:04:08,390
.أنّه فعلها عن قصد

43
00:04:08,620 --> 00:04:13,690
إنّه مثل جاسوس ينظر إليّ
.كلّ يوم ويراقب كلّ تحرّكاتي

44
00:04:13,850 --> 00:04:15,520
.بدأ كلّ شيء يتّضح الآن

45
00:04:15,520 --> 00:04:16,380
.توقّف

46
00:04:17,280 --> 00:04:18,970
،إن كان هنالك خطب ما بهو جي

47
00:04:19,080 --> 00:04:21,210
.لكان قد دمّر الدّليل منذ مدّة

48
00:04:21,810 --> 00:04:23,990
،لكنّه أبقاها في مكان يسهل العثور عليه

49
00:04:24,530 --> 00:04:25,580
لماذا في رأيك؟

50
00:04:26,640 --> 00:04:28,760
لماذا تواصل القول أنّه ليس هو جي؟

51
00:04:30,560 --> 00:04:32,180
،هل يعقل أن يكون الأمر كما قلت

52
00:04:33,120 --> 00:04:36,670
وأنّه هناك أنا آخر يقوم بهذه الشّرور كلّ يوم؟

53
00:04:38,810 --> 00:04:41,680
إن صحّ ذلك، فلماذا هناك أنا آخر؟

54
00:04:41,980 --> 00:04:42,590
.أخبرني

55
00:04:42,590 --> 00:04:43,470
أين هو؟

56
00:04:47,910 --> 00:04:49,060
،بما أنّه أنت

57
00:04:50,140 --> 00:04:51,600
.فلا بدّ أنّه ليس بعيدًا

58
00:04:53,270 --> 00:04:54,990
.إنّه إلى جانبك

59
00:04:56,620 --> 00:04:58,230
أيمكنك التّصرّف بجدّيّة؟

60
00:04:58,820 --> 00:05:01,530
أليس هذا كافيًا لإثبات
أنّ هنالك خطبًا  بهو جي؟

61
00:05:03,430 --> 00:05:05,370
.لا أفهم ما الّذي تفكّر به

62
00:05:06,100 --> 00:05:07,140
.سأوضّح الأمر

63
00:05:08,340 --> 00:05:08,880
...هو جي

64
00:05:11,990 --> 00:05:12,730
شين ريشينغ؟

65
00:05:16,590 --> 00:05:17,470
شين ريشينغ؟

66
00:05:18,210 --> 00:05:19,150
ماذا؟

67
00:05:21,770 --> 00:05:24,570
شين ريشينغ، هل تلعب الغمّيضة معي؟

68
00:05:26,770 --> 00:05:27,640
.هذا غريب

69
00:05:28,050 --> 00:05:29,370
لماذا لا أجد رقم هاتفه؟

70
00:05:29,820 --> 00:05:30,850
.اتّصلت به من قبل

71
00:05:31,640 --> 00:05:33,290
.هذا سخيف

72
00:05:33,290 --> 00:05:34,540
أنا آخر؟

73
00:05:34,960 --> 00:05:35,760
مرحبًا، شينمانغ؟

74
00:05:36,770 --> 00:05:37,480
.أريد أن أسألك عن شيء

75
00:05:38,580 --> 00:05:39,470
.تفضّل

76
00:05:39,580 --> 00:05:42,020
هل تتذكرين الرّجل الّذي كنت
معه في غرفة الهروب الآن؟

77
00:05:42,350 --> 00:05:43,160
ماذا؟

78
00:05:43,160 --> 00:05:44,390
أيّ رجل؟

79
00:05:44,750 --> 00:05:46,010
ألم تكن وحدك؟

80
00:05:48,100 --> 00:05:49,960
مرحبًا؟

81
00:05:50,590 --> 00:05:51,430
يان يوتشو؟

82
00:05:52,020 --> 00:05:54,450
مرحبًا؟ يان يوتشو؟

83
00:06:04,230 --> 00:06:05,040
.سيّدي

84
00:06:05,040 --> 00:06:05,790
.مرحبًا

85
00:06:06,270 --> 00:06:07,050
...عفوًا

86
00:06:07,240 --> 00:06:09,070
هل لديكم عامل يُدعى شين ريشينغ؟

87
00:06:10,710 --> 00:06:11,600
.لا

88
00:06:11,770 --> 00:06:12,610
.أنا آسف

89
00:06:12,770 --> 00:06:13,930
.لا يوجد شخص بهذا الاسم هنا

90
00:06:16,620 --> 00:06:18,320
ألم تفكّر أبدًا

91
00:06:19,130 --> 00:06:21,160
أنّ هنالك أنت آخر في العالم؟

92
00:06:25,970 --> 00:06:26,920
.مستحيل

93
00:06:27,950 --> 00:06:28,790
كيف يعقل هذا؟

94
00:06:30,450 --> 00:06:31,370
.مستحيل

95
00:06:31,800 --> 00:06:32,620
كيف يعقل هذا؟

96
00:06:33,560 --> 00:06:34,460
.هذا مستحيل

97
00:08:16,850 --> 00:08:17,930
لماذا؟

98
00:08:19,220 --> 00:08:20,450
لماذا يحدث هذا؟

99
00:08:22,600 --> 00:08:23,970
تتذكّر الأمر الآن؟

100
00:08:23,720 --> 00:08:24,220
عزيزي؟

101
00:08:24,260 --> 00:08:25,070
أتذكّر ماذا؟

102
00:08:25,930 --> 00:08:26,870
.لا فكرة لديّ

103
00:08:27,220 --> 00:08:28,210
.لا أعرف أيّ شيء

104
00:08:29,290 --> 00:08:31,830
لا تعرف أنّ هناك أنت آخر؟

105
00:08:34,530 --> 00:08:35,430
.أعرف

106
00:08:35,650 --> 00:08:36,440
!لا

107
00:08:36,680 --> 00:08:37,810
!ذلك ليس صحيحًا

108
00:08:37,920 --> 00:08:38,900
!لم أفعل ذلك

109
00:08:38,900 --> 00:08:40,050
!لم أفعل ذلك حقًّا

110
00:08:40,480 --> 00:08:41,890
لم تفعل ذلك؟

111
00:08:43,190 --> 00:08:44,980
أيعقل أنّ ذلك من صنيعي أنا؟

112
00:08:45,910 --> 00:08:46,530
.لا

113
00:08:47,330 --> 00:08:48,810
!نعم! نعم

114
00:08:48,980 --> 00:08:53,300
!من صنيعك أنت

115
00:08:55,760 --> 00:08:59,410
.وجودك خطأ

116
00:08:59,670 --> 00:09:01,020
!يان يوشانغ

117
00:09:28,660 --> 00:09:29,500
.استيقظت أخيرًا

118
00:09:30,050 --> 00:09:30,780
أمّي؟

119
00:09:31,770 --> 00:09:33,080
ما خطبي؟

120
00:09:34,040 --> 00:09:35,240
،يا بنيّ

121
00:09:35,700 --> 00:09:36,910
.أنت في الخارج دائمًا

122
00:09:37,910 --> 00:09:39,540
.فقدت وعيك في الشّارع

123
00:09:39,890 --> 00:09:42,470
.عثر عليك أحد المارّة الطّيّبين واتّصل بالشّرطة

124
00:09:43,240 --> 00:09:44,750
فقدت وعيي في الشّارع؟

125
00:09:46,780 --> 00:09:47,400
.نعم

126
00:09:48,140 --> 00:09:50,410
.لكن عليّ إبلاغ الشّركة غدًا

127
00:09:50,410 --> 00:09:51,930
عمّ تتحدّث؟

128
00:09:52,440 --> 00:09:54,070
.إنّك تعمل هناك لشهر

129
00:09:57,220 --> 00:09:58,150
.هذا صحيح

130
00:09:58,750 --> 00:10:00,550
.كنتُ أعمل لمدّة طويلة

131
00:10:01,870 --> 00:10:03,520
لكن لماذا لا أتذكّر شيئًا؟

132
00:10:04,250 --> 00:10:05,750
.ربّما هي انتكاسة من مشكلتك السّابقة

133
00:10:07,320 --> 00:10:08,600
.عليك أن ترتاح جيّدًا

134
00:10:09,150 --> 00:10:10,770
.لم يحدث ما هو أسوأ لحسن الحظّ

135
00:10:40,060 --> 00:10:41,100
...أنت

136
00:10:41,660 --> 00:10:42,620
هو جي؟

137
00:10:43,860 --> 00:10:45,700
.تهانينا، أنت على حقّ

138
00:10:46,790 --> 00:10:47,970
.لكن لن تحصل على أيّ مكافأة

139
00:10:55,940 --> 00:10:58,020
،أنا مسرور لأنّي تذكّرت اسمه

140
00:10:58,420 --> 00:10:59,680
.وإلاّ لكان الأمر محرجًا

141
00:11:07,530 --> 00:11:09,770
.لا يتوجد سوى رسائل بيني وبين أمّي هنا

142
00:11:11,170 --> 00:11:13,900
.ولديّ أرقام هو جي وزملاء آخرين

143
00:11:15,860 --> 00:11:17,770
ماذا فعلت في الشّهر الماضي؟

144
00:11:21,400 --> 00:11:22,740
من الخبّازة؟

145
00:11:24,680 --> 00:11:25,510
هو جي؟

146
00:11:25,510 --> 00:11:25,850
ماذا؟

147
00:11:27,440 --> 00:11:29,450
هل تعرف من تكون الخبّازة؟

148
00:11:31,000 --> 00:11:32,890
.أعتقد أنّها زميلة لنا تُدعى شي يو

149
00:11:43,310 --> 00:11:44,600
!أعرف من تكون

150
00:11:47,540 --> 00:11:49,000
.هذا الشّعور رائع

151
00:11:49,830 --> 00:11:53,720
يمكنني تذكّر أشياء كثيرة
.في الحال بمجرّد تلميح بسيط

152
00:11:55,040 --> 00:11:56,600
،بينما أواصل التّفكير بالأمر

153
00:11:57,250 --> 00:12:00,270
.فإنّ أجزاءً من ذاكرتي تواصل الظّهور

154
00:12:06,610 --> 00:12:11,050
.لكن ما زال هناك فجوات لا يمكنني ملؤها

155
00:12:11,250 --> 00:12:11,990
.يوتشو

156
00:12:14,650 --> 00:12:16,380
.يفترض أنّهم زملائي

157
00:12:17,060 --> 00:12:18,380
ما أسماؤهم؟

158
00:12:19,830 --> 00:12:20,640
...مرحبًا

159
00:12:20,640 --> 00:12:21,900
إلى أين أنتم ذاهبون؟

160
00:12:22,480 --> 00:12:23,970
.ما زلنا نناقش الأمر

161
00:12:23,970 --> 00:12:25,240
إلى أين نذهب؟

162
00:12:25,720 --> 00:12:28,350
،أوصي بغرفة الهروب
.لكن أخشى أنّك لست جريئًا كفاية

163
00:12:29,270 --> 00:12:30,880
.لم لا؟ لنذهب

164
00:12:55,260 --> 00:12:56,350
.مرحبًا

165
00:12:57,190 --> 00:12:58,350
.أهلا بك يا سيّد تشاو

166
00:13:01,480 --> 00:13:02,820
.الغرف كلّها مشغولة الآن

167
00:13:03,310 --> 00:13:04,870
.انتظروا لحظة رجاءً

168
00:13:14,350 --> 00:13:14,810
.تشاو

169
00:13:14,810 --> 00:13:15,180
ماذا؟

170
00:13:15,180 --> 00:13:15,930
أتأتي إلى هنا كثيرًا؟

171
00:13:16,500 --> 00:13:18,270
.لا، أتيتُ مرّة واحدة من قبل فحسب

172
00:13:19,230 --> 00:13:20,790
.لكنّها نادتك باسمك قبل قليل

173
00:13:20,790 --> 00:13:22,000
كانت تقصدك أنت، صحيح؟

174
00:13:22,700 --> 00:13:23,790
.تفاجأت أيضًا

175
00:13:24,680 --> 00:13:27,730
.بالتّفكير في الأمر، تشاو هو اسمي العائلي

176
00:13:28,040 --> 00:13:28,900
،مرّ وقت طويل مذ كنت هنا

177
00:13:28,900 --> 00:13:30,320
.لكنّها تذكّرت اسمي العائليّ

178
00:13:30,680 --> 00:13:32,100
.تشاو هو اسمه العائليّ

179
00:13:33,120 --> 00:13:33,930
.مفهوم

180
00:13:35,430 --> 00:13:38,060
.سمعتُ أنّ الكثير يأتون لأجلها

181
00:13:38,220 --> 00:13:40,660
.هناك من يأتي فقط لسماع عبارة التّوديع

182
00:13:42,130 --> 00:13:43,770
ما خطبهم؟

183
00:13:44,360 --> 00:13:46,220
.اسمها شو أيو

184
00:13:49,260 --> 00:13:53,460
ألا تعتقدون أنّها هادئة مثلما يوحي اسمها؟

185
00:13:54,060 --> 00:13:58,980
،إنّها أشبه برئيسة في أفلام رعب
.جميلة ولكن يصعب التّقرّب منها

186
00:13:59,580 --> 00:14:00,330
فعلاً؟

187
00:14:00,920 --> 00:14:03,200
.لكن أعتقد أنّها طريفة

188
00:14:06,960 --> 00:14:08,140
طريفة؟

189
00:14:08,420 --> 00:14:09,270
.اشرح أكثر

190
00:14:10,550 --> 00:14:12,070
.مجرّد شعور

191
00:14:13,190 --> 00:14:14,410
.هذا غريب

192
00:14:15,250 --> 00:14:16,660
كيف يراودني شعور كهذا؟

193
00:14:18,090 --> 00:14:19,530
.حان دوركم أيّها السّادة

194
00:14:20,650 --> 00:14:22,780
.هل لديك غرفة لرجال حقيقيّين مثلنا

195
00:14:23,730 --> 00:14:26,450
هل تريدون غرفة حماسيّة؟

196
00:14:26,600 --> 00:14:28,920
نعم، هل لديك غرفة قادرة
على زرع الرّعب في قلوبنا؟

197
00:14:30,160 --> 00:14:32,600
هل هذا الرّجل ماسوشيّ أم ماذا؟

198
00:14:32,920 --> 00:14:35,860
.ليست لدينا غرف مخيفة لهذا الحدّ هنا

199
00:14:36,520 --> 00:14:37,950
.لا نريد وقوع حوادث

200
00:14:38,770 --> 00:14:41,800
.لكن هناك غرفة حماسيّة متوفّرة الآن

201
00:14:42,090 --> 00:14:43,450
أتريدون أن تتحدّوها؟

202
00:14:43,450 --> 00:14:44,220
.حاضر

203
00:14:44,220 --> 00:14:44,890
.لنقم بذلك

204
00:14:45,420 --> 00:14:46,020
.حسنًا

205
00:14:46,670 --> 00:14:48,360
.زمن اللّعبة ساعة كاملة

206
00:14:48,360 --> 00:14:49,290
.الثّمن 80 يوان للشّخص

207
00:14:49,290 --> 00:14:50,380
.يمكنك الدّفع بعد خروجكم

208
00:14:50,890 --> 00:14:53,700
،إن أردتم وقتًا إضافيًّا
.فستحصلون على نصف ساعة أخرى

209
00:14:54,780 --> 00:14:56,170
.هذه وثيقة إخلاء مسؤوليّة

210
00:14:56,410 --> 00:15:01,040
المصابون بأمراض قلب أو ارتفاع ضغط أو فوبيا
.الأماكن المغلقة قد لا تناسبهم هذه اللّعبة

211
00:15:01,940 --> 00:15:03,390
.وقّعوا هنا رجاءً

212
00:15:04,650 --> 00:15:06,970
،زارنا السّيّد تشاو من قبل
.لذلك ليس عليه التّوقيع ثانية

213
00:15:08,390 --> 00:15:09,970
.حسنًا، سألقي نظرة

214
00:15:11,370 --> 00:15:12,640
سيّد وانغ شينشين؟

215
00:15:13,670 --> 00:15:14,280
.هذا أنا

216
00:15:15,900 --> 00:15:17,030
سيّد ليو كاي؟

217
00:15:17,460 --> 00:15:18,600
.إنّه أنا

218
00:15:23,410 --> 00:15:25,040
سيّد يان يوتشو؟

219
00:15:27,320 --> 00:15:28,340
