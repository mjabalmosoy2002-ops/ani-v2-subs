1
00:00:22,590 --> 00:00:23,720
ما هذا؟

2
00:00:24,260 --> 00:00:25,640
.حلمتُ بها بالفعل

3
00:00:27,260 --> 00:00:28,640
خيط أضواء؟

4
00:00:30,550 --> 00:00:31,680
.الكهرباء مقطوعة

5
00:00:33,090 --> 00:00:34,470
.لا توجد تغطية

6
00:00:34,760 --> 00:00:36,970
.لا أذكر وجود قفل بتوليفة كلمة مرور على بابي

7
00:00:37,630 --> 00:00:38,970
.لا أستطيع فتح النّوافذ

8
00:00:39,760 --> 00:00:40,970
.أنا لا أغلقها أبدًا

9
00:00:44,630 --> 00:00:46,550
متى صار زجاجًا مقوّى؟

10
00:02:31,840 --> 00:02:32,970
.إنّه لزج

11
00:02:33,800 --> 00:02:34,970
ما هذا؟

12
00:02:38,590 --> 00:02:41,970
.صار حبّ الماضي كرهًا

13
00:02:42,550 --> 00:02:46,470
متى سيُحلّ هذا؟

14
00:02:47,420 --> 00:02:49,930
أيعقل أن تكون التّعويذة الّتي ألقتها شو أيو عليّ؟

15
00:02:51,010 --> 00:02:52,580
.كابوس غرفة الهروب

16
00:02:53,470 --> 00:02:55,050
.يبدو أنّ الإشاعات حقيقيّة

17
00:02:56,800 --> 00:02:57,420
!أبي

18
00:02:57,420 --> 00:02:58,120
!أمّي

19
00:02:58,120 --> 00:03:00,470
!أهنالك أحد بالخارج؟ لا أستطيع الخروج

20
00:03:00,630 --> 00:03:01,720
!أبي

21
00:03:01,720 --> 00:03:03,000
أيسمعني أيّ أحد؟

22
00:03:03,000 --> 00:03:04,470
!افتحا لي الباب

23
00:03:10,130 --> 00:03:11,930
ما الّذي يحدث بالضّبط؟

24
00:03:22,970 --> 00:03:25,600
.هذا مؤلم! هذا ليس حلمًا إذًا

25
00:03:30,970 --> 00:03:34,050
متى سيُحلّ هذا؟

26
00:03:37,970 --> 00:03:39,240
!حسنًا

27
00:03:39,240 --> 00:03:40,550
!سأحلّه

28
00:03:41,300 --> 00:03:43,180
!إنّه مجرّد قفل بتوليفة

29
00:03:43,760 --> 00:03:45,970
!لا أهتمّ ما أنت

30
00:03:46,420 --> 00:03:48,100
!أرني أفضل ما لديك

31
00:03:51,970 --> 00:03:53,510
.كلمة مرور من خمسة أرقام

32
00:03:53,510 --> 00:03:55,260
.ثمّة مئات آلاف الاحتمالات

33
00:03:55,260 --> 00:03:56,510
.مستحيل تخمينها

34
00:03:57,420 --> 00:04:02,050
يبدو أنّ لا شيء قد تغيّر في الغرفة
.سوى خيوط الأضواء والكلمات

35
00:04:03,550 --> 00:04:04,930
.كلمة مرور من خمسة أرقام

36
00:04:06,420 --> 00:04:08,470
.أسود

37
00:04:10,760 --> 00:04:12,800
،باستعمال طريقة مفاتيح الإدخال التّسعة

38
00:04:13,470 --> 00:04:14,970
...فمن الواضح

39
00:04:17,470 --> 00:04:20,550
.أنّ كلمة السّرّ هي هذه

40
00:04:27,380 --> 00:04:30,260
.هذا كلّ شيء في أخبار اللّيلة

41
00:04:30,670 --> 00:04:32,300
.شكرًا على المشاهدة

42
00:04:32,760 --> 00:04:34,970
.نراكم المرّة القادمة

43
00:04:54,670 --> 00:04:56,850
لماذا حلمت بغرفة الهروب البارحة؟

44
00:04:59,380 --> 00:05:01,370
لستُ مهووسًا بها، صحيح؟

45
00:05:01,370 --> 00:05:02,150
.يوتشو

46
00:05:02,150 --> 00:05:03,330
.سأغادر

47
00:05:03,330 --> 00:05:04,640
.لا تنس تناول فطورك

48
00:05:12,720 --> 00:05:13,850
...حسنًا

49
00:05:14,220 --> 00:05:15,470
...إنّك

50
00:05:16,130 --> 00:05:18,470
.ثمّة طرد لك يا يوتشو

51
00:05:18,970 --> 00:05:20,430
.حسنًا. أنا قادم

52
00:05:21,470 --> 00:05:23,470
...دقيقة من فضلك، سيأتي في

53
00:05:30,510 --> 00:05:31,970
.ما الأمر؟ دعيني أرى

54
00:05:33,510 --> 00:05:34,760
.أظنّها وثائق من نوع ما

55
00:05:37,010 --> 00:05:38,850
من قد يرسل وثائق في البريد السّريع الآن؟

56
00:05:40,630 --> 00:05:42,100
.المُرسل مجهول

57
00:05:57,970 --> 00:05:59,510
ما الخطب يا يوتشو؟

58
00:05:59,630 --> 00:06:00,970
.غادر ساعي البريد سلفًا

59
00:06:02,880 --> 00:06:04,010
.لا شيء

60
00:06:16,260 --> 00:06:17,390
.يوتشو

61
00:06:18,800 --> 00:06:20,010
.صباح الخير يا سيّدي

62
00:06:21,510 --> 00:06:23,250
.نادني هو جي فحسب

63
00:06:23,250 --> 00:06:24,590
.كفّ عن مناداتي سيّدي

64
00:06:24,590 --> 00:06:26,010
.لستُ رئيسك كما تعلم

65
00:06:26,840 --> 00:06:28,180
.حسنًا يا هو جي

66
00:06:28,470 --> 00:06:30,470
هل رأيت كابوسًا البارحة؟

67
00:06:31,340 --> 00:06:32,710
.لا تقل لي أنّ كابوسًا راودك أيضًا

68
00:06:33,720 --> 00:06:34,850
.لا أصدّق

69
00:06:35,470 --> 00:06:38,900
في حلمي ليلة الأمس، كنتُ محاصرًا
.في غرفة الهروب الّتي ذهبنا إليها البارحة

70
00:06:38,900 --> 00:06:41,430
.حدّقت بي شو أيو على التّلفاز وضحكم فحسب

71
00:06:41,630 --> 00:06:42,850
.استيقظت مذعورًا

72
00:06:43,090 --> 00:06:44,350
.يبدو ذلك مخيفًا بالفعل

73
00:06:45,090 --> 00:06:47,220
.حلمتُ أنّ غرفتي تحوّلت لغرفة هروب

74
00:06:47,670 --> 00:06:49,800
.لكنّي استطعتُ الخروج في النّهاية

75
00:06:51,090 --> 00:06:52,220
.أحسنت

76
00:06:53,090 --> 00:06:54,350
لن يحدث أيّ شيء، صحيح؟

77
00:06:54,630 --> 00:06:56,000
ماذا قد يحدث؟

78
00:06:56,000 --> 00:06:57,680
.أنا ما زلتُ حيًّا مع أنّي لم أخرج

79
00:06:58,300 --> 00:06:59,510
.لا تبالغ في التّفكير

80
00:07:00,050 --> 00:07:03,140
أعتقد أنّنا كنّا منغمسين جدًّا
.في اللّعبة البارحة فحسب

81
00:07:03,260 --> 00:07:05,170
.لذا ليس من الغريب أن نحلم بها

82
00:07:05,170 --> 00:07:06,300
.معك حقّ

83
00:07:06,970 --> 00:07:09,970
.ربّما لهذا السّبب توجد إشاعات عنها

84
00:07:11,720 --> 00:07:13,390
.انس الأمر. علينا العمل

85
00:07:13,630 --> 00:07:15,760
.ما زال عليّ إرسال بعض الرّسائل الإلكترونيّة

86
00:07:24,470 --> 00:07:26,890
،ربّما هذا يفسّر الحلم

87
00:07:28,090 --> 00:07:29,720
لكن ماذا عن الطّرد؟

88
00:07:32,720 --> 00:07:35,390
.صار حبّ الماضي كرهًا

89
00:07:35,670 --> 00:07:37,930
متى سيُحلّ هذا؟

90
00:07:39,130 --> 00:07:40,980
.ما زلت لا أعرف ما المقصود

91
00:07:41,470 --> 00:07:43,550
.لا أعتقد أنّ لا معنى لذلك

92
00:07:44,420 --> 00:07:48,100
.لكنّها قد تكون جملة ترحيب جيّدة

93
00:07:49,300 --> 00:07:51,970
.مرحبًا يا سيّد يان

94
00:07:53,510 --> 00:07:54,970
.تذكّرتِ اسمي

95
00:07:56,010 --> 00:07:57,800
ألم نتقابل البارحة فحسب؟

96
00:07:58,840 --> 00:07:59,970
.هذا صحيح

97
00:08:00,130 --> 00:08:01,600
.أذكر اسمك أيضًا

98
00:08:03,050 --> 00:08:06,180
.لكنّي هنا لاحتساء كوب قهوة فحسب

99
00:08:07,090 --> 00:08:08,220
لديك قهوة، صحيح؟

100
00:08:08,420 --> 00:08:11,930
.بالطّبع، رغم أنّ هذا ليس مقهى

101
00:08:13,840 --> 00:08:16,430
.لديك آلة إعداد قهوة، ولكن لا توجد قائمة

102
00:08:17,130 --> 00:08:18,300
كيف يعرف النّاس ذلك؟

103
00:08:18,470 --> 00:08:21,100
طلبتَ واحدة للتّوّ، صحيح؟

104
00:08:23,300 --> 00:08:25,850
.توقّعتُ ذلك بما أنّي شممت رائحة قهوة

105
00:08:27,840 --> 00:08:29,390
.نفس الشّيء ينطبق على لافتتك

106
00:08:29,630 --> 00:08:30,970
.لا معلومات عليها

107
00:08:31,340 --> 00:08:36,260
.سيجلب القدر أولئك الّذين قدّر لهم أن يكونوا هنا

108
00:08:38,630 --> 00:08:41,180
تقصدين أنّ القدر أحضري إليك؟

109
00:08:41,630 --> 00:08:45,510
.سيّد يان، أحضرك القدر لكوب القهوة هذا

110
00:08:48,470 --> 00:08:49,200
.لا أصدّق

111
00:08:49,200 --> 00:08:50,250
.غرفة الهروب هذه مخيفة

112
00:08:49,300 --> 00:08:50,720
.تهانينا

113
00:08:50,250 --> 00:08:50,830
!كنتُ خائفة

114
00:08:50,830 --> 00:08:52,140
.لم نكن نعلم كم عدد الطّوابق الموجودة

115
00:08:52,140 --> 00:08:54,620
لا يعقل أن يكون الدّرج بلا نهاية، صحيح؟

116
00:08:54,620 --> 00:08:57,180
.لكنّ العلامات الّتي وضعناها كانت كلّها هناك

117
00:08:55,590 --> 00:08:57,200
أهو القدر؟

118
00:08:57,200 --> 00:08:59,470
على أيّ حال، كان تمثيلي رائعًا، صحيح؟

119
00:08:59,470 --> 00:09:01,850
.مِن هنا رجاءً

120
00:08:59,720 --> 00:09:03,470
!كنتُ أعلم بخداعك لنا

121
00:09:03,630 --> 00:09:05,090
!بربّك

122
00:09:05,090 --> 00:09:06,330
لماذا لم تقولي ذلك في الدّاخل؟

123
00:09:06,330 --> 00:09:07,790
.لن أستعمل مصعدي في الأيّام القادمة

124
00:09:06,970 --> 00:09:08,300
.شكرًا على زيارتكم

125
00:09:07,790 --> 00:09:08,890
!مع السّلامة

126
00:09:09,470 --> 00:09:10,910
.ربّما سنجرّب الأمر ثانية لاحقًا

127
00:09:09,970 --> 00:09:11,970
".لن أترككم أبدًا"

128
00:09:10,910 --> 00:09:13,000
.لا أريد. هذا مخيف جدًّا

129
00:09:13,000 --> 00:09:14,850
.لديك زبائن آخرون هنا

130
00:09:15,630 --> 00:09:16,760
.بالطّبع

131
00:09:17,010 --> 00:09:21,640
هل ظننت أنّكما كنتما زبونينا الوحيدين؟

132
00:09:21,970 --> 00:09:22,930
.لا

133
00:09:23,220 --> 00:09:25,590
كلّ ما هنالك أنّ المكان كان هادئًا
.جدًّا في المرّتين اللّتين كنتُ فيها هنا

134
00:09:25,840 --> 00:09:27,930
.لذلك ظننتُ أنّ زبائنك قليلون

135
00:09:28,760 --> 00:09:31,470
،يوجد هنا أزيد من عشرين غرفة

136
00:09:31,760 --> 00:09:34,040
،حتّى إن كان هنالك عشرات الزّبائن في الدّاخل

137
00:09:34,040 --> 00:09:35,430
.فلا يمكنك رؤيتهم

138
00:09:36,630 --> 00:09:39,180
.وغرفة هروبي معروفة جدًّا

139
00:09:39,420 --> 00:09:41,970
.يُقال أنّ من يزورنا يصير أذكى

140
00:09:43,590 --> 00:09:46,080
أليس الأمر بسبب الشّائعات
الّتي تقول أنّك تسحرين النّاس؟

141
00:09:46,080 --> 00:09:47,600
.ذلك جزء من الأمر

142
00:09:51,670 --> 00:09:53,010
.رأيتُ كُلمًا ليلة البارحة

143
00:09:55,300 --> 00:09:56,470
عنّي؟

144
00:09:58,630 --> 00:10:01,140
.ذكر الكثير من زبائننا المعتادون أنّهم حلموا بي

145
00:10:01,630 --> 00:10:03,300
.اعتدتُ على هذا

146
00:10:04,550 --> 00:10:06,720
.لكنّي حلمتُ أنّي محاصر في غرفة هروب

147
00:10:07,130 --> 00:10:08,640
.يحدث ذلك كثيرًا أيضًا

148
00:10:09,550 --> 00:10:12,970
هذا النّوع من الأحلام لا يهدّد الحياة، صحيح؟

149
00:10:14,420 --> 00:10:15,760
.لا أدري

150
00:10:16,300 --> 00:10:19,300
.لا أذكر أنّ زبونًا ميتًا أتى لإخباري بذلك

151
00:10:21,300 --> 00:10:22,510
.أمزح فحسب

152
00:10:23,260 --> 00:10:25,220
.لا يحلم معظم النّاس بي

153
00:10:25,970 --> 00:10:28,760
ولكن لا يوجد أيّ خطب

154
00:10:28,760 --> 00:10:30,570
بأن يحلم النّاس بالآخرين في عادة، صحيح؟

155
00:10:30,570 --> 00:10:33,140
.في الحقيقة، لديّ قوّة خارقة

156
00:10:33,510 --> 00:10:35,470
.يمكنني دخول أحلام الآخرين كما أشاء

157
00:10:36,380 --> 00:10:37,760
.أنت تمزحين ثانية

158
00:10:38,090 --> 00:10:39,220
أرأيت؟

159
00:10:39,380 --> 00:10:41,300
.صرتَ أذكى بكثير الآن

160
00:10:41,470 --> 00:10:42,760
.الشّائعات حقيقيّة

161
00:10:44,510 --> 00:10:45,640
ماذا عن هذه الرّسالة؟

162
00:10:46,420 --> 00:10:47,800
أتعرفين أيّ شيء عنها؟

163
00:10:57,340 --> 00:10:58,470
!بربّك

164
00:10:58,470 --> 00:11:00,180
أصار لي منافس الآن؟

165
00:11:00,550 --> 00:11:03,350
.إنّهم يهدّدون زبائني بمثل هذه الطّريقة الدّنيئة

166
00:11:06,220 --> 00:11:09,470
إن كنتُ أنا، لكتبتُ شيئًا مثل

167
00:11:09,840 --> 00:11:12,640
بإمكان غرفة الهروب جعلك أذكى
.أو تحسّن شخصيّتك

168
00:11:13,630 --> 00:11:15,470
.آسفة، لا أعرف شيئًا عن هذا

169
00:11:18,470 --> 00:11:20,760
.حسنًا. انس الأمر

170
00:11:20,970 --> 00:11:22,100
.الفاتورة لو سمحت

171
00:11:29,760 --> 00:11:30,910
.آسف

172
00:11:30,910 --> 00:11:34,180
،طلبتُ كوب قهوة فحسب
.وأضعت الكثير من وقتك

173
00:11:35,010 --> 00:11:36,390
.لم أكن مشغولة أساسًا

174
00:11:36,760 --> 00:11:38,970
.يمكنك العودة لشرب القهوة متى تشاء

175
00:11:39,380 --> 00:11:40,510
.عليّ الذّهاب

176
00:11:40,510 --> 00:11:41,640
.مع السّلامة

177
00:11:42,050 --> 00:11:43,350
.شكرًا على قدومك

178
00:11:44,050 --> 00:11:45,930
.لن أتركك أبدًا

179
00:11:56,720 --> 00:11:58,220
من أرسل تلك الرّسالة يا ترى؟

180
00:11:59,760 --> 00:12:01,800
.بدت كنصيحة بحسن نيّة

181
00:12:04,090 --> 00:12:05,350
.لا ينبغي أن تكون شو أيو

182
00:12:06,470 --> 00:12:09,680
كانت لترغب في المزيد من الزّبائن
.بما أنّها مالك غرفة الهروب

183
00:12:10,050 --> 00:12:11,660
.لا سبب يدفعها لفعل هذا

184
00:12:27,470 --> 00:12:29,470
هل أبالغ في التّفكير؟

185
00:12:45,880 --> 00:12:47,680
ما الّذي أحلم به؟

186
00:12:51,470 --> 00:12:52,600
!كلاّ

187
00:12:57,840 --> 00:12:58,970
!ليس ثانية

188
00:13:10,130 --> 00:13:11,970
.إنّها أحجية الآن

189
00:13:17,420 --> 00:13:20,370
.هذا كلّ شيء في أخبار اللّيلة

190
00:13:20,370 --> 00:13:22,050
.شكرًا على المشاهدة

191
00:13:22,050 --> 00:13:24,220
.نراكم المرّة القادمة

192
00:13:28,970 --> 00:13:30,220
رأيت كابوسًا ثانية؟

193
00:13:30,380 --> 00:13:32,470
نعم. وأنت؟

194
00:13:32,970 --> 00:13:34,740
كيف لي أن أرى مثل تلك الأحلام؟

195
00:13:35,300 --> 00:13:38,100
كنتُ مشغولاً جدًّا البارحة ولم يكن
.لي وقت للتّفكير بأيّ شيء

196
00:13:38,100 --> 00:13:39,700
.نمتُ مباشرة بعد عودتي للمنزل

197
00:13:40,550 --> 00:13:42,680
هل أنا الوحيد الّذي تراوده هذه الأحلام؟

198
00:13:43,470 --> 00:13:45,970
.أنت منغمس في الأمر كثيرًا فحسب

199
00:13:46,420 --> 00:13:48,390
ربّما عليك لعب بعض ألعاب الفيديو
،قبل الخلود للنّوم

200
00:13:48,390 --> 00:13:49,550
.لتهدّئ ذهنك فحسب

201
00:13:50,880 --> 00:13:52,010
.سأجرّب ذلك

202
00:13:53,720 --> 00:13:55,470
.وجدتك يا هو جي

203
00:13:56,220 --> 00:13:57,350
!شي يو

204
00:13:57,510 --> 00:13:59,050
ماذا أحضرت اليوم؟

205
00:14:02,470 --> 00:14:04,220
أتريد أن تخمّن؟

206
00:14:05,260 --> 00:14:06,050
.ربّما لا

207
00:14:06,260 --> 00:14:07,510
.إنّها مختلفة في كلّ مرّة

208
00:14:10,630 --> 00:14:11,430
!كعك

209
00:14:11,550 --> 00:14:12,680
أتريد بعضه؟

210
00:14:13,300 --> 00:14:14,430
.شكرًا لك

211
00:14:18,760 --> 00:14:19,970
!إنّه لذيذ

212
00:14:21,840 --> 00:14:22,970
أتريد أيضًا؟

213
00:14:22,970 --> 00:14:24,220
.حسنًا

214
00:14:24,880 --> 00:14:26,010
.شكرًا لك

215
00:14:26,220 --> 00:14:27,550
ما رأيك؟

216
00:14:28,550 --> 00:14:29,680
.إنّه لذيذ

217
00:14:29,890 --> 00:14:31,100
فعلاً؟

218
00:14:31,800 --> 00:14:32,930
.أعددته بنفسي

219
00:14:33,390 --> 00:14:34,700
.ممتاز

220
00:14:34,700 --> 00:14:36,800
لا يوجد الكثير من الفتيات
.بمثل هذه المهارات الآن

221
00:14:39,970 --> 00:14:41,100
هل أنت جديد هنا؟

222
00:14:41,550 --> 00:14:42,630
ما اسمك؟

223
00:14:42,630 --> 00:14:43,720
.يان يوتشو

224
00:14:43,720 --> 00:14:46,140
.ي-ا-ن" يان، "ي-و-ت-ش-و" يوتشو"

225
00:14:46,390 --> 00:14:47,620
.أنا اسمي شي يو

226
00:14:47,620 --> 00:14:49,050
.ش-ي" شي، "ي-و" يو"

227
00:14:49,220 --> 00:14:50,590
.أنا من قسم المبيعات

228
00:14:50,840 --> 00:14:51,880
.جيّد

229
00:14:51,880 --> 00:14:54,220
.أعتقد أنّ بإمكانك فتح مخبزة

230
00:14:55,630 --> 00:14:59,260
.تسريحة شعرك مميّزة يا يان

231
00:14:59,720 --> 00:15:01,680
تلك ليست حدود شعرك، صحيح؟

232
00:15:03,670 --> 00:15:04,800
.إنّها ندبة

233
00:15:04,970 --> 00:15:06,340
.ما عاد الشّعر ينمو هناك

234
00:15:07,420 --> 00:15:09,890
.وقعت عن الدّرج عندما كنت في الجامعة

235
00:15:10,090 --> 00:15:11,220
.وضعوا لي عدّة غُرز

236
00:15:12,130 --> 00:15:13,430
.آمل أنّك كنت بخير

237
00:15:14,260 --> 00:15:16,850
.بالطّبع لا. فقدت ذاكرتي وقتها

238
00:15:18,970 --> 00:15:20,100
...إنّ سنوات

239
00:15:26,090 --> 00:15:27,800
ما خطبك يا يان؟

240
00:15:27,800 --> 00:15:28,930
.يوتشو

241
00:15:33,800 --> 00:15:34,930
...هذا

242
00:15:36,760 --> 00:15:38,050
ظُفر؟