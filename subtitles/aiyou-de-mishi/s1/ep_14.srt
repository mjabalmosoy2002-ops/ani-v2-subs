1
00:00:22,050 --> 00:00:23,130
.كنّا زميلَيْ دراسة

2
00:00:23,870 --> 00:00:24,480
.نعم

3
00:00:27,640 --> 00:00:30,010
.كنّا مقرّبين من بعض

4
00:00:31,300 --> 00:00:32,330
.تواعدنا مرّة

5
00:00:34,890 --> 00:00:37,120
،إن استطعت حبسي بغرفة الهروب من تصميمك

6
00:00:37,440 --> 00:00:38,440
.ستفوز

7
00:00:39,730 --> 00:00:43,870
.ستكون الحقيقة الّتي تريد معرفتها هي جائزتك

8
00:02:30,260 --> 00:02:30,790
.يوتشو

9
00:02:31,500 --> 00:02:32,500
أنت في مزاج جيّد، صحيح؟

10
00:02:34,110 --> 00:02:34,830
أذلك واضح؟

11
00:02:35,120 --> 00:02:35,760
.بالطّبع

12
00:02:36,120 --> 00:02:37,320
.إنّك تبتسم وأنت تسير

13
00:02:40,330 --> 00:02:41,910
.فعلتُ شيئًا أسعدني كثيرًا اليوم

14
00:02:42,170 --> 00:02:42,830
.لكن لا يستحقّ الذّكر

15
00:02:43,520 --> 00:02:44,760
أله علاقة بشو أيو؟

16
00:02:45,620 --> 00:02:47,200
.يبدو أنّ علاقتكما تتطوّر بسرعة

17
00:02:48,730 --> 00:02:49,800
.الأمر ليس كما تظنّ

18
00:02:49,830 --> 00:02:50,800
تعرف ما أظنّ؟

19
00:02:51,790 --> 00:02:53,440
ألم تقل أنّ صداقتكما خالصة؟

20
00:02:54,930 --> 00:02:56,950
.نعم، خالصة تمامًا

21
00:02:57,060 --> 00:02:59,410
.خالصة لدرجة أنّك أمضيت اللّيلة في منزلها

22
00:03:01,190 --> 00:03:03,040
.لا أدري كيف أشرح لك

23
00:03:05,520 --> 00:03:07,310
اعتدنا أن نكون عازبين

24
00:03:07,640 --> 00:03:09,110
نظهر إعجابنا بإلهتنا

25
00:03:09,500 --> 00:03:10,970
.لكنّك حصلت على حبيبة فجأة

26
00:03:11,400 --> 00:03:13,330
.تركتني في الوراء ولم تنظر خلفك حتّى

27
00:03:14,350 --> 00:03:16,650
ألا تشعر بالأسى عليّ؟

28
00:03:19,410 --> 00:03:24,910
.أنا وشو أيو عدوّان الآن في الحقيقة

29
00:03:26,590 --> 00:03:27,700
أتظنّني بهذا الغباء؟

30
00:03:28,080 --> 00:03:29,460
.أنا جادّ

31
00:03:31,130 --> 00:03:31,520
.تعال

32
00:03:32,730 --> 00:03:33,400
ماذا؟

33
00:03:34,700 --> 00:03:35,830
ألستما عدوّان؟

34
00:03:36,150 --> 00:03:38,220
.قف هنا واصرخ في وجهها أمامي

35
00:03:38,700 --> 00:03:39,950
.سأصدّقك عندما تفعل ذلك

36
00:03:40,120 --> 00:03:40,450
...لكن

37
00:03:42,340 --> 00:03:43,580
.نحن أشخاص محترمون

38
00:03:43,870 --> 00:03:45,660
.ليس من الاحترام فعل ذلك علنًا

39
00:03:45,790 --> 00:03:48,230
كيف لي أن أصدّقك إن كنت
لا تجرؤ على فعل ذلك؟

40
00:03:49,350 --> 00:03:50,750
لن أتفوّه بأيّ شتائم إذًا، مفهوم؟

41
00:03:50,910 --> 00:03:51,350
.مفهوم

42
00:04:05,140 --> 00:04:06,620
!أيّتها الشّرّيرة شو أيو

43
00:04:06,700 --> 00:04:08,020
!يا لك من بخيلة

44
00:04:08,250 --> 00:04:10,000
!انتظري فحسب! سأتعامل معك لاحقًا

45
00:04:11,100 --> 00:04:11,870
.فعلتها بالفعل

46
00:04:12,240 --> 00:04:13,040
.أحسنت

47
00:04:13,610 --> 00:04:15,000
.أخبرتك

48
00:04:20,750 --> 00:04:23,830
.سيّد يان، أعجبني ما قلته

49
00:04:24,540 --> 00:04:27,600
.ادخل واجلس، أريد سماع المزيد

50
00:04:27,040 --> 00:04:27,600
!لنغادر

51
00:04:28,990 --> 00:04:29,820
لماذا لم تدخل؟

52
00:04:29,820 --> 00:04:30,790
!أخبرتك أنّنا عدوّان

53
00:04:31,040 --> 00:04:32,450
كيف لي أن أدخل مكان عدوّ؟

54
00:04:32,450 --> 00:04:33,370
هل تصدّقني الآن؟

55
00:04:34,110 --> 00:04:34,750
.أصدّقك

56
00:04:39,060 --> 00:04:40,020
ماذا حدث؟

57
00:04:40,830 --> 00:04:41,870
.لا تسأل عن التّفاصيل

58
00:04:42,810 --> 00:04:46,950
أبقتني في غرفة هروب لأزيد
.من ساعدة هذا الصّباح

59
00:04:47,100 --> 00:04:47,850
!أغضبني ذلك

60
00:04:49,520 --> 00:04:50,670
كيف أنتقم منها في رأيك؟

61
00:04:52,020 --> 00:04:53,580
لماذا ذهبت إليها باكرًا في الصّباح؟

62
00:04:54,110 --> 00:04:55,600
.أخبرتك ألاّ تسأل عن التّفاصيل

63
00:04:55,890 --> 00:04:56,460
.حسنًا

64
00:04:57,360 --> 00:05:00,250
يمكنك أن تحبسها أيضًا إن كنت
.تريد الانتقام منها

65
00:05:01,120 --> 00:05:02,470
.أنت تلهمني

66
00:05:04,150 --> 00:05:05,540
.أبي صانع أقفال

67
00:05:05,820 --> 00:05:07,580
.يمكنني تصميم غرفة هروب أفضل من غرفها

68
00:05:09,870 --> 00:05:11,580
!فكرة ممتازة! سأقوم بذلك

69
00:05:11,850 --> 00:05:12,540
أتريد الانضمام لي؟

70
00:05:13,470 --> 00:05:14,870
.حسنًا. يبدو ذلك ممتعًا

71
00:05:15,940 --> 00:05:17,920
.لكن عليّ العودة للعمل الآن

72
00:05:19,560 --> 00:05:21,120
.ستكون خطة طويلة

73
00:05:21,550 --> 00:05:22,410
.سأقوم ببعض التّحضيرات أوّلاً

74
00:05:22,830 --> 00:05:24,120
.سأتّصل بك عندما أكون جاهزًا لأبدأها

75
00:05:24,470 --> 00:05:25,970
.حسنًا، موافق

76
00:05:34,150 --> 00:05:36,190
.أنا خادمتك قد جهّزت لك مكوّنات طعام فاخرة

77
00:05:36,750 --> 00:05:38,170
.أدعوك الآن لزيارة منزلي

78
00:05:38,660 --> 00:05:39,830
.سأكون في انتظارك

79
00:05:41,360 --> 00:05:42,780
.لا بدّ أنّه فخّ

80
00:05:43,710 --> 00:05:46,640
،أنا مريض اليوم
.لذلك لن أحضر. عليّ الذّهاب

81
00:05:48,780 --> 00:05:50,220
.لن أسديها هذه الخدمة

82
00:05:50,520 --> 00:05:51,750
تريد استعادة الصّور؟

83
00:05:52,070 --> 00:05:52,910
!مستحيل

84
00:05:54,180 --> 00:05:56,410
هل سيكون الدّاخل مخيفًا؟

85
00:05:56,460 --> 00:05:58,400
.لا داعي للخوف. أنا هنا معك

86
00:06:02,500 --> 00:06:03,910
!وصلت أخيرًا

87
00:06:04,190 --> 00:06:05,720
!افتقدتك كثيرًا

88
00:06:06,400 --> 00:06:07,930
لم تأكل بعد، صحيح؟

89
00:06:08,420 --> 00:06:10,370
.سأقدّم لك الطّعام

90
00:06:11,300 --> 00:06:12,940
.كلّ شيء جاهز من أجلك

91
00:06:14,200 --> 00:06:15,330
.أرى أنّك تحسنين التّصرّف

92
00:06:15,700 --> 00:06:16,990
.سأبقى للأكل معك

93
00:06:18,800 --> 00:06:21,430
.حضّرت الكثيري من الأطباق اليوم

94
00:06:21,830 --> 00:06:23,240
.لا بدّ أنّك ستحبّها

95
00:06:30,490 --> 00:06:32,540
.لا بدّ أنّ هذا كلّف شو أيو الكثير

96
00:06:35,500 --> 00:06:36,750
!أيّتها الخادمة

97
00:06:37,120 --> 00:06:38,560
هل لديك مشكلة مع ضيفي؟

98
00:06:39,260 --> 00:06:39,830
.على الإطلاق

99
00:06:40,660 --> 00:06:42,710
.تفضّل بالجلوس يا صيفي المحترم

100
00:06:50,300 --> 00:06:51,700
.تمّ تحضير هذه الأطباق لك خصّيصًا

101
00:06:52,270 --> 00:06:53,750
.استمتع بها رجاءً

102
00:06:56,470 --> 00:06:59,870
.لا يعقل أنّك وضعت مخدّرًا ما في الطّعام

103
00:07:02,840 --> 00:07:04,890
!كيف لا تثق بي؟

104
00:07:07,910 --> 00:07:09,290
.سأجرّب كلّ طبق

105
00:07:09,640 --> 00:07:10,590
أيناسبك هذا؟

106
00:07:12,020 --> 00:07:14,870
.تتناسب المأكولات البحريّة مع النّبيذ الأبيض

107
00:07:15,370 --> 00:07:17,370
.هيّا، جرّب هذا

108
00:07:19,890 --> 00:07:20,830
.ليس سيّئًا

109
00:07:23,030 --> 00:07:24,080
.شبعت

110
00:07:25,940 --> 00:07:28,600
.اتّضح أنّ لكل طبق نبيذه الخاصّ

111
00:07:29,320 --> 00:07:30,770
.يا لها من طريقة فاخرة للأكل

112
00:07:31,580 --> 00:07:33,000
.أنا ثمل قليلاً

113
00:07:33,000 --> 00:07:36,700
سيّدي، هل أعجبتك الوجبة؟

114
00:07:36,750 --> 00:07:37,960
.نعم

115
00:07:38,280 --> 00:07:43,830
سيّدي، احذف تلك الصّوت مقابل
.هذه الخدمة الممتازة الّتي قدّمتها لك

116
00:07:45,090 --> 00:07:46,120
الصّور؟

117
00:07:46,790 --> 00:07:47,890
.سأفكّر في ذلك

118
00:07:48,880 --> 00:07:49,810
!حصلت على هاتفه

119
00:07:51,740 --> 00:07:53,700
.لم تحاولا تخديري، لكنّهما جعلتاني ثملاً

120
00:07:54,780 --> 00:07:56,170
.شربت أنواعًا عدّة من النّبيذ اليوم

121
00:07:56,900 --> 00:07:58,830
.وأنا بطيء نوعًا ما الآن

122
00:07:59,000 --> 00:07:59,630
!حصلت عليه

123
00:08:01,290 --> 00:08:04,740
.لا يمكنك فتحه حتّى إن حصلت عليه

124
00:08:07,150 --> 00:08:08,190
!سأحطّمه إذًا

125
00:08:08,750 --> 00:08:09,970
!وسأشتري لك هاتفًا جديدًا

126
00:08:10,640 --> 00:08:13,200
.سيكون عليك تحطيم الحاسوب في غرفتي أيضًا

127
00:08:13,410 --> 00:08:16,270
وبالمناسبة، هناك نسخ في حاسوبي في العمل

128
00:08:17,720 --> 00:08:20,140
.وفي قرص الصّلب المحمول

129
00:08:19,560 --> 00:08:20,180
!سيّدي

130
00:08:20,400 --> 00:08:22,210
.أتوسّل إليك! أسدني خدمة

131
00:08:22,620 --> 00:08:25,240
!إن تسرّبت الصّور، فسأصير أضحوكة للجميع

132
00:08:25,660 --> 00:08:27,940
.سيضحك عليّ كلّ ضيوفي

133
00:08:28,780 --> 00:08:29,950
.سأفعل أيّ شيء تقوله

134
00:08:30,120 --> 00:08:31,870
.ولن أغضبك ثانية أبدًا

135
00:08:36,420 --> 00:08:36,990
.خذيه

136
00:08:37,810 --> 00:08:38,830
.لا توجد نسخ أخرى

137
00:08:47,980 --> 00:08:49,560
.صرنا متعادلين الآن

138
00:08:52,850 --> 00:08:53,650
.شكرًا على الطّعام

139
00:09:03,090 --> 00:09:04,080
...حسنًا

140
00:09:04,420 --> 00:09:05,580
.ما زلت أعتقد أنّ ذلك ليس كافيًا

141
00:09:06,810 --> 00:09:09,880
،نعم، قلتُ أنّي سأصمّم غرفة هروب لحبسها

142
00:09:10,650 --> 00:09:12,040
.لتعرف ما هو شعور التّعرّض للحبس

143
00:09:14,080 --> 00:09:14,950
!سأقوم بذلك الآن

144
00:09:20,040 --> 00:09:23,620
،جرّبت الكثير من غرف الهروب
.سيكون من السّهل تصميم واحدة

145
00:09:24,770 --> 00:09:27,010
.تعلّمت الكثير عن الأقفال من أبي

146
00:09:27,510 --> 00:09:28,640
.سيفيدني ذلك الآن

147
00:09:33,430 --> 00:09:35,170
.عليّ القيام ببعض البحوث الآن

148
00:09:41,440 --> 00:09:44,070
.لا أعرف متى سيختفي فقداني للذّاكرة

149
00:09:45,020 --> 00:09:48,220
ولا أعرف كم شخصًا قد نسيت
.دون أن أدرك ذلك

150
00:09:58,500 --> 00:09:59,840
كنّا في نفس الجامعة؟

151
00:10:02,310 --> 00:10:04,190
.ويبدو أنّنا كنّا نعرف بعضنا

152
00:10:07,040 --> 00:10:09,200
لماذا تظاهرت شينمانغ أنّها لا تعرفني؟

153
00:10:10,780 --> 00:10:11,970
ما الّذي تحاول إخفاءه؟

154
00:10:20,410 --> 00:10:21,810
.أعطني معلومات الاتّصال بشينمانغ

155
00:10:38,200 --> 00:10:39,870
.استمتعت كثيرًا البارحة

156
00:10:40,330 --> 00:10:42,600
.كانت قلقة بشدّة عندما غادرت

157
00:10:42,600 --> 00:10:44,290
.كانت تسألنا ماذا تفعل طوال الوقت

158
00:10:45,280 --> 00:10:48,750
لا بدّ أنّك شعرت بحالة جيّدة
.عندما قدّمت لك الطّعام

159
00:10:49,300 --> 00:10:50,330
.هذه فرصة ممتازة

160
00:10:50,700 --> 00:10:53,350
.عليك انتهازها للتّخلّص من غرورها

161
00:10:53,730 --> 00:10:55,910
تقصدين أنّها مغرورة؟

162
00:10:56,870 --> 00:10:57,580
!نعم

163
00:10:58,290 --> 00:11:02,140
،إنّها أغنى وأكثر ذكاءً منّا
.لذلك تنفّذ مقابل علينا

164
00:11:03,320 --> 00:11:05,540
قبل بضعة أيّام مثلاً، أكلت كلّ شيء

165
00:11:05,660 --> 00:11:09,870
في بطّيخة اشتريتها عن طريق صنع
.ثقب صغير فيها

166
00:11:11,630 --> 00:11:12,890
فعلت ذلك بالفعل؟

167
00:11:13,290 --> 00:11:14,160
!أجل

168
00:11:14,490 --> 00:11:18,300
هل يمكنك تخيّل كيف كان وجهي عندما
فتحت البطّيخة ووجدتها فارغة؟

169
00:11:18,500 --> 00:11:20,160
!حملتها للمنزل كلّ ذلك الطّريق

170
00:11:20,570 --> 00:11:22,160
...وقبل فترة ليست بعيدة، قمنا

171
00:11:21,440 --> 00:11:22,160
.مهلاً لحظة

172
00:11:22,940 --> 00:11:24,860
.يمكننا الحديث عن ذلك في المستقبل

173
00:11:26,190 --> 00:11:27,470
.إنّها تمطر بغزارة

174
00:11:28,400 --> 00:11:29,750
.علينا الحديث عن أمور جادّة

175
00:11:33,670 --> 00:11:35,200
.حسنًا يا سيّد يان

176
00:11:36,030 --> 00:11:36,600
.قل ما لديك

177
00:11:37,380 --> 00:11:40,250
لا بدّ أنّك تذكرين أنّي كنت زميلة دراستك، صحيح؟

178
00:11:44,570 --> 00:11:45,290
.نعم

179
00:11:45,720 --> 00:11:46,830
كيف لي أن أنسى؟

180
00:11:47,360 --> 00:11:49,870
.كنّا في نفس الفصل في الجامعة

181
00:11:50,130 --> 00:11:53,910
لماذا تصرّفت وكأنّنا غريبان عند لقائنا الأوّل؟

182
00:11:55,500 --> 00:11:57,450
هذا لأنّي أعرف أنّك فقدت
،ذاكرتك بسبب إصابتك

183
00:11:57,750 --> 00:11:59,160
.وأنّك لن تتذكّرني

184
00:12:00,060 --> 00:12:01,850
.كان عليّ تقديم نفسي في كلّ الأحوال

185
00:12:02,780 --> 00:12:03,660
.إنّك تخفين شيئًا ما عنّي

186
00:12:05,450 --> 00:12:06,530
كيف يعقل ذلك؟

187
00:12:06,790 --> 00:12:08,750
.لم نكن نعرف بعضنا جيّدًا من الأساس

188
00:12:08,920 --> 00:12:10,410
ماذا بإمكاني أن أخفيه عنك؟

189
00:12:10,410 --> 00:12:13,950
.لكن أظنّنا كنّا مقرّبين حسب معرفتي

190
00:12:14,710 --> 00:12:18,040
.سبق وتواعدنا، لذلك كان من المحرج أن أراك ثانية

191
00:12:18,320 --> 00:12:19,000
.هذا هو السّبب

192
00:12:21,680 --> 00:12:22,880
ما مدى تقدّم علاقتنا؟

193
00:12:24,710 --> 00:12:26,680
.قبّلنا بعضنا فحسب

194
00:12:27,260 --> 00:12:28,750
.لا يمكنني كبح يداي دائمًا عندما أقبّل أحد ما

195
00:12:29,580 --> 00:12:31,500
.هذا يعني أنّ لمستك

196
00:12:36,060 --> 00:12:36,830
.حسنًا

197
00:12:37,500 --> 00:12:39,040
.ذلك صحيح

198
00:12:39,910 --> 00:12:41,700
.وجدت صورة في ألبوم صوري

199
00:12:42,480 --> 00:12:44,160
.كنّا نحضن بعضنا

200
00:12:44,590 --> 00:12:47,450
.هكذا عرفت بأمر علاقتنا

201
00:12:47,910 --> 00:12:49,200
!إنّك تختلق ذلك

202
00:12:49,800 --> 00:12:53,000
.ووجدت فحصًا طبّيًّا لك

203
00:12:53,830 --> 00:12:54,660
.كنتِ حبلى

204
00:12:56,350 --> 00:12:59,870
أفهم أنّك كنت تحاولين حماية نفسك
.عندما قلت أنّنا قبّلنا بعضنا فحسب

205
00:13:01,410 --> 00:13:02,950
.أعلم انّك ضحّيت بالكثير من أجلي

206
00:13:03,460 --> 00:13:07,540
أحببتني بشدّة حتّى بعد
.أن عرفت أنّي معجب بأخرى

207
00:13:08,700 --> 00:13:09,500
.مهلاً، مهلاً، مهلاً

208
00:13:09,640 --> 00:13:10,320
.كفّ عن هذا

209
00:13:10,790 --> 00:13:12,130
.أعترف أنّي كذبت

210
00:13:12,200 --> 00:13:12,640
.حسنًا

211
00:13:13,610 --> 00:13:14,530
.أخبريني بالحقيقة

212
00:13:15,460 --> 00:13:16,740
ما الّذي تخفينه عنّي؟

213
00:13:16,840 --> 00:13:20,030
.لا يمكنني إخبارك لأنّي لا أريد أذيّتك

214
00:13:21,690 --> 00:13:24,120
هل حدث شيء ما فظيع بيننا؟

215
00:13:24,440 --> 00:13:26,450
.كفّ عن سؤالي لأنّي لا أستطيع إخبارك

216
00:13:26,840 --> 00:13:28,250
.أعلم أنّي سأخبرك عاجلاً أم آجلاً

217
00:13:28,250 --> 00:13:29,660
.لكن لا يمكنني إخبارك هكذا

218
00:13:30,310 --> 00:13:31,570
.لا خيار لديّ

219
00:13:32,290 --> 00:13:33,610
.سأسأل زملاء دراستي الآخرين

220
00:13:34,380 --> 00:13:36,830
.لا داعي لذلك. لن تعرف أيّ شيء

221
00:13:37,330 --> 00:13:38,760
.قلّة فقط ممّن يعرفون هذا السّرّ

222
00:13:39,210 --> 00:13:41,410
.قلت أنّك ستخبريني عاجلاً أم آجلاً

223
00:13:41,730 --> 00:13:42,520
متى؟

224
00:13:44,140 --> 00:13:44,800
.لا أدري

225
00:13:45,370 --> 00:13:47,330
،ربّما بعد أيّام أو بعد سنوات

226
00:13:47,860 --> 00:13:50,620
.أو ربّما على سرير موتك أو موتي

227
00:13:51,830 --> 00:13:56,600
هل تعرفين من اقترف تلك الهجمات حولي؟

228
00:13:57,100 --> 00:14:00,300
.إنّه مجرّد تخمين لكنّي أفكّر في اسم معيّن

229
00:14:00,500 --> 00:14:02,290
.واثقة تسعين بالمائة أنّه هو

230
00:14:02,290 --> 00:14:02,840
من؟

231
00:14:03,650 --> 00:14:04,300
.آسفة

232
00:14:04,950 --> 00:14:06,790
.لكنّ الأمر متعلّق بالسّرّ

233
00:14:06,910 --> 00:14:07,780
.لا يمكنني إخبارك

234
00:14:09,530 --> 00:14:12,000
تعرفين من يكون، لكنّك
!ستجلسين وستراقبين فحسب

235
00:14:12,360 --> 00:14:13,470
!قد يواصل أذيّة النّاس

236
00:14:13,470 --> 00:14:14,230
تعرفين ذلك، صحيح؟

237
00:14:14,230 --> 00:14:15,450
.لا يمكنني فعل أيّ شيء حيال ذلك

238
00:14:15,690 --> 00:14:17,040
.ليس لديّ القوّة لإيقافه

239
00:14:17,380 --> 00:14:20,000
،حتّى إن عرفتَ من يكون
.لن تتمكّن من إيقافه أيضًا

240
00:14:20,890 --> 00:14:24,040
.وإن عرفت، سيتسبّب ذلك بمشاكل أكبر

241
00:14:24,450 --> 00:14:26,620
.لذلك لا يمكنني إخبارك

242
00:14:29,780 --> 00:14:30,370
.حسنًا

243
00:14:31,290 --> 00:14:32,580
.سأطرح عليك سؤالاً وحدًا فحسب

244
00:14:33,780 --> 00:14:36,980
هل أعرف هذا الرّجل؟

245
00:16:06,030 --> 00:16:08,210
.يان، سمعت أنّك من أنقذني

246
00:16:08,780 --> 00:16:10,690
.لا أعرف كيف أشكرك

247
00:16:11,090 --> 00:16:15,280
بالطّبع عليّ مساعدتك عندما تكونين
.بالحاجة لذلك بصفتي صديقك

248
00:16:16,310 --> 00:16:20,500
وفي ذلك اليوم، لو أنّي عدت
...إليك باكرًا، ما كنتِ لـ

249
00:16:20,730 --> 00:16:22,520
.لا تقل ذلك يا يان

250
00:16:23,360 --> 00:16:26,160
،بعد خروجي من المستشفى
سأبذل قصارى جهدي

251
00:16:26,540 --> 00:16:30,410
.لإعداد أشهى الحلويّات كهديّة لك لأشكرك

252
00:16:30,590 --> 00:16:33,080
،لن أتوقّع أشهى الحلويّات

253
00:16:33,420 --> 00:16:36,190
أعطني ثاني أشهى الحلويّات
.وسأكون راضيًا

254
00:16:37,600 --> 00:16:40,370
.عملنا معًا لوقت طويل يا هو

255
00:16:40,570 --> 00:16:41,870
.لا يمكن مقارنة يان بك

256
00:16:42,340 --> 00:16:45,210
.لذلك السّبب لا تحتاج هديّة شكر على الإطلاق