1
00:00:18,260 --> 00:00:20,420
متى سينتهي هذا الحزن؟

2
00:00:21,190 --> 00:00:23,880
،توقّف المطر البارد أخيرًا

3
00:00:24,030 --> 00:00:25,610
.وهذا مناسب تمامًا لجنازة الزّهرة

4
00:00:27,270 --> 00:00:29,570
،غبت طوال ثلاث سنوات

5
00:00:30,240 --> 00:00:32,990
.حان وقت الاستيقاظ

6
00:00:34,700 --> 00:00:38,170
.كان أبي هو عائلتي الوحيدة مذ كنتُ طفلة

7
00:00:38,940 --> 00:00:41,140
،لا تفضّلني السّماء

8
00:00:41,680 --> 00:00:44,150
.أو ربّما تفضّلني كثيرًا

9
00:00:46,290 --> 00:00:51,290
.مات أبي الّذي هو عائلتي الوحيدة في حادثة

10
00:00:52,770 --> 00:00:56,770
.بكيت كثيرًا ومطوّلاً

11
00:00:58,880 --> 00:01:00,970
.لكنّ البكاء لم يحلّ المشكلة

12
00:01:01,880 --> 00:01:05,640
لذلك قرّرت ألاّ أبكي

13
00:01:05,840 --> 00:01:08,200
.وان أقوّي نفسي في مواجهة الحياة

14
00:01:09,990 --> 00:01:13,500
.ما زال يعيش في قلبي كمصدر شجاعة لي

15
00:01:14,360 --> 00:01:17,970
.وما أستطيع فعله هو التّذكّر

16
00:01:18,330 --> 00:01:19,910
.أحبّني أبي

17
00:01:20,720 --> 00:01:22,590
.ترك لي الكثير من الأشياء

18
00:01:22,950 --> 00:01:24,790
.لكنّي لم أجدها في وقت أبكر فحسب

19
00:01:25,970 --> 00:01:30,360
لا بدّ أنّه أمل أنّه لن تكون هنالك
.عراقيل كثيرة في طريق تقدّمي

20
00:01:31,910 --> 00:01:33,810
،بعد أن تعلّمتُ كيف أدير الملكيّات

21
00:01:34,120 --> 00:01:35,910
.حوّلت المنزل القديم إلى غرفة هروب

22
00:01:36,470 --> 00:01:38,290
.صارت شعبيّتها أكبر أكثر فأكثر

23
00:01:39,080 --> 00:01:42,330
.وصرت سيّدة ثريّة في عيون النّاس

24
00:01:43,700 --> 00:01:47,840
أتى العديد من الرّجال اليافعين إلى
.هنا فقط للفوز باستحساني

25
00:01:48,930 --> 00:01:51,770
.لكنّ حبّي كان متحفّظًا دائمًا

26
00:01:52,950 --> 00:01:56,080
،رغم أنّ الرّجل اليافع الّذي أحبّه تركني

27
00:01:56,890 --> 00:01:59,940
.لم يتغيّر قلبي أبدًا

28
00:02:01,760 --> 00:02:05,390
.اليوم هو آخر أيّام عملي

29
00:03:40,250 --> 00:03:42,290
هل كان على الخدعة أن تكون واضحة هكذا؟

30
00:03:44,180 --> 00:03:45,470
.لعبة توافق ألوان

31
00:03:46,000 --> 00:03:47,470
.تتّبع صيغة واضحة

32
00:03:50,050 --> 00:03:51,970
.لاحظت بطاقات الألوان هذه منذ مدّة

33
00:03:55,900 --> 00:03:56,850
.فُتحت الحجرة

34
00:03:58,410 --> 00:03:59,770
.ثمّة مفتاح في الدّاخل

35
00:04:03,710 --> 00:04:05,550
!علقت يدي

36
00:04:06,620 --> 00:04:07,470
ما ذلك الصّوت؟

37
00:04:10,160 --> 00:04:11,800
!ساعدني يا يان يوتشو

38
00:04:11,800 --> 00:04:13,470
.لا تهلع. أنا أعمل على حلّها

39
00:04:14,320 --> 00:04:15,810
!إنّه يقترب أكثر فأكثر

40
00:04:14,950 --> 00:04:15,810
!لا تهلع رجاءً

41
00:04:15,810 --> 00:04:16,840
!يدي

42
00:04:18,230 --> 00:04:18,950
.لا تستجيب

43
00:04:20,090 --> 00:04:21,100
.ظننتُها مجرّد لعبة

44
00:04:21,820 --> 00:04:22,700
ما الّذي يحدث؟

45
00:04:23,680 --> 00:04:24,780
.ليس لديّ أيّ تلميحات هنا

46
00:04:25,120 --> 00:04:26,490
.انظر إن كانت هناك أيّ تلميحات حولك

47
00:04:26,490 --> 00:04:27,930
!تلميحات! تلميحات

48
00:04:28,200 --> 00:04:30,480
اسمع، ما الّذي على غطاء تلك الحجرة؟

49
00:04:30,480 --> 00:04:31,150
غطاء؟

50
00:04:31,670 --> 00:04:34,210
.مفتوح، مغلق، مفتوح

51
00:04:36,910 --> 00:04:39,950
،يوتشو، جرّب مشغّل، مطفأ
!مشغّل، مطفأ، مشغّل، مطفأ

52
00:04:39,950 --> 00:04:41,080
...مشغّل، مطفأ، مشغّل

53
00:04:46,240 --> 00:04:48,010
.أخيرًا... سحبتُ يدي

54
00:04:50,190 --> 00:04:51,320
مطّاط؟

55
00:04:51,930 --> 00:04:53,640
.سأقاضيكم إن ألحقتم بي أذى حقيقيّ

56
00:04:56,680 --> 00:04:58,700
.خرجت أخيرًا

57
00:05:01,070 --> 00:05:03,560
.أنفقت المالكة الكثير من المال على الدّيكور

58
00:05:03,700 --> 00:05:05,180
.انغمست في الأمر بالكامل

59
00:05:05,750 --> 00:05:08,550
.هذه المدعوّة شو أيو ثريّة بالفعل

60
00:05:10,730 --> 00:05:13,190
هل يُعقل أنّ هذا الباب هو المخرج؟

61
00:05:13,990 --> 00:05:14,600
.نعم

62
00:05:15,480 --> 00:05:17,970
يجدر أن يكون الممرّ المؤدّي
.للقاعة خلف هذا الباب

63
00:05:18,700 --> 00:05:20,970
لا أظنّ أنّ شو أيو ستسمح لنا
.بالخروج بهذه السّهولة

64
00:05:23,790 --> 00:05:24,760
.لنعثر على دليل آخر

65
00:05:26,490 --> 00:05:27,370
.فساتين

66
00:05:28,930 --> 00:05:30,050
.المزيد من الفساتين

67
00:05:35,720 --> 00:05:37,120
.كلّها مستحضرات تجميل

68
00:05:38,160 --> 00:05:40,000
ربّما يكون الدّليل في العلامات التّجاريّة؟

69
00:05:40,970 --> 00:05:41,460
!انظر

70
00:05:42,350 --> 00:05:45,510
"وجدت نُسخة لرواية "جين إير
.ومذكّرات مقفلة على السّرير

71
00:05:47,840 --> 00:05:48,460
.تحقّق منها

72
00:05:50,160 --> 00:05:52,470
."مُزّقت الصّفحتان 147 و148 من رواية "جين إير

73
00:05:53,370 --> 00:05:54,330
.جرّب كلمَتَيْ السّرّ هاتين

74
00:05:57,330 --> 00:05:58,440
.إنّها 148

75
00:05:59,240 --> 00:06:00,560
.لنر ما كُتب في المذكّرات

76
00:06:01,690 --> 00:06:04,110
.يبدو أنّها سيرة شو أيو الذّاتيّة الخياليّة

77
00:06:17,710 --> 00:06:19,590
.أتى هذا الرّجل وحده

78
00:06:20,970 --> 00:06:22,490
،قال أنّه أتى من أجل غرفة الهروب

79
00:06:23,300 --> 00:06:24,840
.لكنّه حاول أذيّتي

80
00:06:32,840 --> 00:06:38,600
.قاومته بكلّ قوّتي... لكنّي فشلن

81
00:06:42,990 --> 00:06:44,400
.قام بإخفائي

82
00:06:45,380 --> 00:06:46,970
.لا يستطيع أحد إيجادي

83
00:06:55,400 --> 00:06:56,250
أرأيت؟

84
00:06:57,520 --> 00:06:59,370
.لا يستطيع أحد إيجادي

85
00:07:04,720 --> 00:07:06,520
.الظّلام دامس

86
00:07:08,200 --> 00:07:10,970
.أتمنّى لو يجدني أحد ما

87
00:07:12,420 --> 00:07:14,970
هذا ليس حقيقيّ، صحيح؟

88
00:07:15,420 --> 00:07:16,700
أنت خائف؟

89
00:07:17,150 --> 00:07:18,750
.ظننتُ أنّك هادئ على الدّوام

90
00:07:19,330 --> 00:07:22,660
بدت القصّة في المذكّرات
.وكأنّها ظهرت أمام عينيّ

91
00:07:23,530 --> 00:07:24,970
.شعرتُ أنّها حقيقيّة بشكل لا يُصدّق

92
00:07:25,570 --> 00:07:28,180
.أنت منغمس في هذه التّجربة كثيرًا فحسب
.اقرأ المزيد من الكتب

93
00:07:28,750 --> 00:07:31,110
.إنّها شبه حقيقيّة في رأيي

94
00:07:32,040 --> 00:07:33,490
.إنّها فاحشة الثّراء

95
00:07:34,230 --> 00:07:37,610
كتبت قصّة طويلة كهذه
.لكنّ جزءًا منها فقط كان الدّليل

96
00:07:37,970 --> 00:07:39,770
أيّ جزء يا ترى؟

97
00:07:39,770 --> 00:07:41,340
.أتمنّى لم يجدني أحد ما

98
00:07:41,850 --> 00:07:42,750
يجدني؟

99
00:07:43,350 --> 00:07:44,470
.علينا إيجاد شو أيو

100
00:07:45,080 --> 00:07:45,580
!صحيح

101
00:07:46,380 --> 00:07:49,150
.آخر جملة في القصّة هي الدّليل

102
00:07:50,700 --> 00:07:51,660
.لنجرّب العثور عليها

103
00:08:02,300 --> 00:08:03,700
تبًّا! لماذا انطفأت الأضواء ثانية؟

104
00:08:04,290 --> 00:08:05,550
هل لمستَ شيئًا ما؟

105
00:08:05,550 --> 00:08:07,040
.سحبت حبل المصباح

106
00:08:10,450 --> 00:08:11,620
ما... ما هذا؟

107
00:08:12,210 --> 00:08:13,760
.هذه هي شو أيو الّتي كنّا نبحث عنها

108
00:08:13,970 --> 00:08:16,620
من أين أتت هذه الجثّة؟

109
00:08:17,510 --> 00:08:18,960
.أظنّ أنّها كانت مخبّأة في الفراش

110
00:08:20,380 --> 00:08:23,960
لا بدّ أنّ مفتاح تشغيل المصباح
.هو ما يشغّل آليّة الفراش أيضًا

111
00:08:25,320 --> 00:08:27,950
...ذلك الشّيء في يدها يشبه

112
00:08:28,250 --> 00:08:28,980
.جاهز تحكّم عن بعد

113
00:08:30,990 --> 00:08:32,260
.لا تقل لي أنّك ستلمسها

114
00:08:32,260 --> 00:08:35,090
.ذلك لا يهمّ. إنّه مجرّد غرض تمثيليّ

115
00:08:35,450 --> 00:08:36,730
.أنت جيّد

116
00:08:38,650 --> 00:08:44,970
الثّلاثاء

117
00:08:50,230 --> 00:08:51,560
ما معنى هذا؟

118
00:08:52,310 --> 00:08:54,010
.إنّها شو أيو في الكاميرا

119
00:08:54,470 --> 00:08:56,840
.وهي لا تتحرّك وكأنّها ميتة

120
00:08:59,010 --> 00:09:00,470
.القصّة مكتملة الآن

121
00:09:01,210 --> 00:09:04,130
.لم يغادر القاتل بعد مقتل شو أيو

122
00:09:07,930 --> 00:09:08,600
الثّلاثاء

123
00:09:09,700 --> 00:09:13,920
.ربّما لم يغادر القاتل أبدًا

124
00:09:16,180 --> 00:09:17,460
ما زال القاتل هنا؟

125
00:09:18,040 --> 00:09:19,160
.لا بدّ أنّك تمزح

126
00:09:20,200 --> 00:09:24,650
.هنالك روح مريضة نفسيًّا خلف كلّ قصّة قتل

127
00:09:26,300 --> 00:09:29,190
.لنواصل البحث عن الأدلّة

128
00:09:32,740 --> 00:09:35,690
.تحقّقنا حتّى تحت فستانها ولم نجد شيئًا

129
00:09:38,600 --> 00:09:40,030
.يكان الوقت ينتهي

130
00:09:40,320 --> 00:09:41,700
.ربّما علينا الذّهاب

131
00:09:41,870 --> 00:09:43,280
.قمنا بكلّ ما بوسعنا

132
00:09:43,980 --> 00:09:46,550
.أعتقد أنّ بإمكاننا طلب بعض التّلميحات

133
00:09:47,760 --> 00:09:50,120
.ربّما ما زالت هنالك فرصة

134
00:09:52,550 --> 00:09:53,940
مرحبًا؟ هل يسمعني أحد؟

135
00:09:54,740 --> 00:09:56,240
.نحتاج لبضت التّلميحات

136
00:09:57,860 --> 00:09:58,480
مرحبًا؟

137
00:09:58,480 --> 00:10:00,780
.حسنًا. سأوافيكما في الحال

138
00:10:02,850 --> 00:10:03,730
ماذا قالت؟

139
00:10:04,020 --> 00:10:05,460
.قالت أنّها ستوافينا في الحال

140
00:10:06,200 --> 00:10:07,330
لماذا ستأتي؟

141
00:10:11,420 --> 00:10:13,110
.مرحبًا، ليس عليك المجيء

142
00:10:14,140 --> 00:10:15,530
.لا نستطيع إيجاد أيّ أدلّة لحلّ مشكلة التّلفاز

143
00:10:16,000 --> 00:10:17,250
.أخبرينا بما علينا فعله فحسب

144
00:10:19,250 --> 00:10:19,930
.يوتشو

145
00:10:22,690 --> 00:10:24,200
.إنّها قادمة بالفعل

146
00:10:25,430 --> 00:10:28,430
الثّلاثاء

147
00:10:27,470 --> 00:10:28,430
...يا إلهي

148
00:10:28,430 --> 00:10:29,170
...إنّها... إنّها... إنّها

149
00:10:29,170 --> 00:10:30,360
هل ستخرج زاحفة منه؟

150
00:10:30,800 --> 00:10:34,170
سأركع أمامها إن كانت تستطيع
.الخروج زحفًا من هناك

151
00:10:34,430 --> 00:10:41,430
الثّلاثاء

152
00:10:35,910 --> 00:10:39,440
.قبّلني وسأتركك ترحل

153
00:10:52,030 --> 00:10:53,720
.تهانينا لكليكما

154
00:10:54,870 --> 00:10:57,930
لم أتوقّع أن تتحلّيان بالشّجاعة
.للقيام بآخر خطوة

155
00:10:58,500 --> 00:11:00,630
!كانت الخطوة الأخيرة سخيفة

156
00:11:00,930 --> 00:11:04,930
ستحصلان على مكافأة خاصّة
.بما أنّكما نجحتما

157
00:11:05,990 --> 00:11:07,960
.هذه ملصقات خاصّة بغرفة أسرار أيو

158
00:11:08,270 --> 00:11:09,870
.إنّها لا تُباع في أيّ مكان

159
00:11:13,980 --> 00:11:15,580
.هذا الملصق رائع

160
00:11:15,750 --> 00:11:18,610
.حسنًا، أنهيتما اللّعبة في الوقت المحدّد

161
00:11:19,200 --> 00:11:22,270
.المجموع هو 320 يوان إضافة للوقت الإضافيّ

162
00:11:22,910 --> 00:11:24,390
.اتبعاني رجاءً إلى المكتب الأماميّ للدّفع

163
00:11:24,390 --> 00:11:25,600
!هذا سخيف

164
00:11:26,140 --> 00:11:27,660
.إنّه ليس الثّمن الّتي اتّفقنا عليه

165
00:11:27,930 --> 00:11:29,260
سخيف؟

166
00:11:29,970 --> 00:11:32,530
فُتح هذا المكان لكما بشكل خاصّ
.في ساعات الإغلاق

167
00:11:32,640 --> 00:11:34,800
ما الضّرر من دفع ضعف الثّمن؟

168
00:11:35,240 --> 00:11:37,640
...هذا ليس عدلاً، سأقدّم شكوى

169
00:11:38,310 --> 00:11:39,530
.لا نريد المشاكل

170
00:11:39,740 --> 00:11:40,410
.انس الأمر

171
00:11:40,740 --> 00:11:42,260
.أصررنا على اللّعب

172
00:11:44,790 --> 00:11:47,140
.اليوم هو يوم حظّك

173
00:11:47,840 --> 00:11:50,040
.وداعنا لزبائننا مميّز جدًّا

174
00:11:50,570 --> 00:11:52,590
.لا نقول وداعًا أو شكرًا على قدومكم

175
00:11:53,150 --> 00:11:54,780
...وداعنا المعتاد هو

176
00:11:55,440 --> 00:11:57,310
".لن نترككم أبدًا"

177
00:11:58,110 --> 00:11:59,210
،أيّها المحترمان

178
00:12:00,430 --> 00:12:02,810
.لن أترككما أبدًا

179
00:12:05,490 --> 00:12:08,810
.حسنًا، لا تتركيني إذًا رجاءً

180
00:12:13,220 --> 00:12:14,310
.لقد عدت

181
00:12:14,310 --> 00:12:16,060
لماذا تأخّرت؟ هل تعشّيت؟

182
00:12:16,060 --> 00:12:16,860
.نعم

183
00:12:16,990 --> 00:12:18,640
.أنا متعب قليلاً وسأذهب إلى غرفتي

184
00:12:26,510 --> 00:12:27,590
.أسود

185
00:12:30,210 --> 00:12:31,350
.أسود

186
00:12:33,090 --> 00:12:33,970
.أسود

187
00:12:40,850 --> 00:12:41,740
...هذا

188
00:12:59,390 --> 00:13:04,680
أُنيرت المدينة

189
00:13:05,770 --> 00:13:11,160
لا مكان للضّمير للاختباء في الظّلمة

190
00:13:11,600 --> 00:13:17,490
لا أفتقد الشّمس الّتي لم أرها من قبل

191
00:13:17,690 --> 00:13:24,180
كالسّير في ليلة بيضاء معك

192
00:13:24,180 --> 00:13:27,470
واقع وحلم

193
00:13:27,470 --> 00:13:30,780
الرّوح مفقودة في الضّباب

194
00:13:30,780 --> 00:13:36,870
وحده سرّ قد يكشف عن سرّ آخر

195
00:13:37,240 --> 00:13:45,850
بالألم والخلاص والوحدة، تجاوزت العبث

196
00:13:45,850 --> 00:13:49,240
تحرّر من الماضي

197
00:14:18,480 --> 00:14:19,310
ما هذا؟

198
00:14:19,940 --> 00:14:21,170
.حلمتُ بها بالفعل

199
00:14:24,330 --> 00:14:26,830
.ما كان عليّ التّفكير كثيرًا بها

200
00:14:31,400 --> 00:14:32,770
خيط أضواء؟

201
00:14:34,000 --> 00:14:35,970
.لا أتذكّر أبدًا وجود شيء كهذا في غرفتي

202
00:14:39,090 --> 00:14:40,150
.الكهرباء مقطوعة

203
00:14:45,020 --> 00:14:46,670
.لكن الأضواء مُنارة في المنازل الأخرى

204
00:14:47,160 --> 00:14:49,020
.ربّما المفتاح معطّل في منزلي

205
00:14:52,370 --> 00:14:54,220
.لا توجد تغطية

206
00:14:55,500 --> 00:14:56,400
.هذا غريب

207
00:14:58,400 --> 00:14:59,060
!أبي

208
00:14:59,410 --> 00:15:00,090
!أمّي

209
00:15:02,960 --> 00:15:03,830
!الباب مغلق

210
00:15:07,010 --> 00:15:09,140
.لا أذكر وجود قفل بتوليفة كلمة مرور على بابي

211
00:15:09,740 --> 00:15:10,400
.مهلاً لحظة

212
00:15:13,370 --> 00:15:15,510
.هذه غرفتي

213
00:15:20,950 --> 00:15:22,600
.لا أستطيع فتح النّوافذ

214
00:15:22,600 --> 00:15:23,640
.أنا لا أغلقها أبدًا

215
00:15:26,810 --> 00:15:27,640
.هذا مؤلم

216
00:15:29,140 --> 00:15:31,330
متى صار زجاجًا مقوّى؟