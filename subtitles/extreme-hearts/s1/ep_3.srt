1
00:00:00,000 --> 00:00:04,980
القلوب الفائقة
يوم نهائيّات جولات المجموعات التّمهيديّة لكاناغاوا

2
00:00:01,890 --> 00:00:03,700
هل أحضرت كلّ شيء؟

3
00:00:03,700 --> 00:00:04,590
.نعم

4
00:00:04,590 --> 00:00:05,660
!لا داعي للقلق

5
00:00:13,880 --> 00:00:16,140
،إن فزنا بنهائيّ المجموعة هذا

6
00:00:16,140 --> 00:00:18,740
،فسنحصل على فرصة لاعتلاء المسرح
.وإن كان ذلك لمدّة وجيزة

7
00:00:20,360 --> 00:00:23,190
سنتمكّن أخيرًا من الوقوف
.في خطّ البداية إن فزنا اليوم

8
00:00:24,520 --> 00:00:25,660
!لنبذل جهدنا

9
00:01:57,320 --> 00:02:01,440
إنّنا في نهائيّات المجموعات للقلوب
!الفائقة هنا في كاناغاوا

10
00:02:02,970 --> 00:02:04,680
.انتهت مباراتان بالفعل

11
00:02:04,680 --> 00:02:09,200
فاز فريق لينك دول بالمباراة الأولى، وهو
.فريق قويّ في سنته الثّالثة من المنافسات

12
00:02:10,000 --> 00:02:10,990
!مرحبًا بالجميع

13
00:02:12,680 --> 00:02:15,820
وفاز فريق فلام أكسيس بالمباراة
.الثّانية، وهو فريق فرقة موسيقيّة

14
00:02:15,820 --> 00:02:18,460
.لقد تأهّلن للنّهائيّات

15
00:02:19,830 --> 00:02:23,330
،يشاركن في هذه المنافسة للسّنة الثّالثة

16
00:02:23,330 --> 00:02:25,680
.ووصلن إلى أفضل 8 العام الماضي في كاناغاوا

17
00:02:25,680 --> 00:02:28,180
هل سيتمكّنّ من أن يصبحن ممثّلات
كاناغاوا هذه السّنة؟

18
00:02:28,180 --> 00:02:31,950
إنّها مجموعة فنّانات المسرح
!من تشيغاساكي، سمايل باور

19
00:02:32,500 --> 00:02:33,960
!حسنًا! لنقم بهذا

20
00:02:33,960 --> 00:02:35,450
!أجل

21
00:02:35,450 --> 00:02:39,530
وسيواجهن الفرقة غير عاديّة تتكوّن
،من المغنّيّة والملحّنة هاياما هيوري

22
00:02:39,530 --> 00:02:43,660
ورياضيّتان من مستوى وطنيّ
.في كرة القاعدة وكرة السّلّة

23
00:02:43,660 --> 00:02:46,440
فريق رايز الّذي يسعى للقيام
.بأوّل أداء مباشر له

24
00:02:49,280 --> 00:02:50,720
!لنخض مباراة جيّدة

25
00:02:50,720 --> 00:02:52,240
!بالتّأكيد

26
00:02:53,250 --> 00:02:57,060
.خطّتنا مثاليّة. تمّ تحليل كلّ نقاط ضعفهنّ

27
00:02:57,350 --> 00:03:00,430
سنحقّق فوزًا ساحقًا هنا وسنصعد
،للمسرح ونعلن عن أدائنا التّالي

28
00:03:00,430 --> 00:03:02,480
!وسنحصل على مكافأة من مديرنا

29
00:03:02,890 --> 00:03:04,390
...لكن إن خسرنا

30
00:03:04,390 --> 00:03:07,570
.لن تكون هناك حفلة وستعدن للمنزل ركضًا

31
00:03:08,630 --> 00:03:10,350
!سنفوز مهما كلّف الأمر

32
00:03:10,350 --> 00:03:11,320
!أجل

33
00:03:11,550 --> 00:03:14,820
!ستبدأ مباراة سمايل بور ضدّ رايز الآن

34
00:03:17,330 --> 00:03:18,400
!جيّد

35
00:03:20,830 --> 00:03:23,100
.الأولى هي الرّقم 7 مايهارا-تشان

36
00:03:23,490 --> 00:03:27,090
إنّها القائدة الّتي تعزّز المباراة
.بتمريراتها ومساعداتها

37
00:03:27,620 --> 00:03:30,340
!علينا أوّل منع تمريرات مايهارا-تشان

38
00:03:32,610 --> 00:03:34,570
.التّالية هي الرّقم 10 كوداكا-تشان

39
00:03:34,800 --> 00:03:39,110
تجعلها قدرتها على الحركة والتّسجيل
...لاعبة متميّزة بحقّ، ولكن

40
00:03:39,650 --> 00:03:43,280
.إنّها قصيرة وضعيفة
!سنكون بخير إن حاصرناها فحسب

41
00:03:43,280 --> 00:03:45,610
...وفي النّهاية، الرّقم 5 هاياما-تشان

42
00:03:47,710 --> 00:03:49,880
.إنّها سريعة. هذا كلّ شيء

43
00:03:49,880 --> 00:03:52,510
.إنّها مجرّد هاوية بدون الأخريتين

44
00:03:52,700 --> 00:03:56,300
!لقد درسننا بشكل جيّد. يا له من شرف

45
00:04:16,760 --> 00:04:18,720
.أجل! هذه البداية

46
00:04:19,230 --> 00:04:20,890
!مِن تمريرة قرب السّلّة

47
00:04:20,890 --> 00:04:26,480
قامت كوداكا من رايز بتسديدة سلام دانك
.بجسدها الّذي لا يتجاوز 151 سنتيمترًا

48
00:04:25,250 --> 00:04:26,670
!أحسنت يا سا-تشان

49
00:04:26,670 --> 00:04:27,290
!أجل

50
00:04:27,290 --> 00:04:29,880
!أظهرت كوداكا ساكي قوّتها من البداية

51
00:04:30,100 --> 00:04:31,280
.آسفة، أرخيت دفاعاتي

52
00:04:31,280 --> 00:04:32,500
!لا تقلقي. بإمكاننا استعادة الكرة

53
00:04:48,190 --> 00:04:49,890
!أجل، أربعة

54
00:04:56,740 --> 00:04:58,390
!مستحيل

55
00:04:58,910 --> 00:05:02,990
!تصحّح كوداكا من رايز خطأ هاياما

56
00:05:02,990 --> 00:05:05,200
.آسفة يا سا-تشان. شكرًا لك

57
00:05:05,560 --> 00:05:06,980
!لا بأس

58
00:05:06,980 --> 00:05:09,990
!حسنًا، وقت الدّفاع! لنحافظ على هدوئنا

59
00:05:10,510 --> 00:05:14,980
!ركّزن على الرّقم 10! لا تدعيها تتحرّر يا أكّي

60
00:05:49,800 --> 00:05:51,680
!بإمكانها تسديد رميات ثلاثيّة أيضًا؟

61
00:05:51,680 --> 00:05:55,260
!كلاّ... ما هذه إلاّ البداية

62
00:06:00,750 --> 00:06:04,130
!تحرز لاعبة سمايل باور المتميّزة مايدا نقطتان

63
00:06:04,130 --> 00:06:04,900
!أجل

64
00:06:04,900 --> 00:06:06,140
!ها قد بدأنا

65
00:06:16,370 --> 00:06:19,770
!تحرز هاشيموتو من سمايل سلّة مذهلة

66
00:06:20,040 --> 00:06:21,770
!إنّهنّ يقلّلن الفارق

67
00:06:21,980 --> 00:06:23,710
!ذلك رائع يا يوكا-تشان

68
00:06:23,710 --> 00:06:25,770
!جيّد، جيّد، يسير كلّ شيء حسب الخطّة

69
00:06:26,300 --> 00:06:29,690
.نعم. آمل أن سير كلّ شيء حسب الخطّة

70
00:06:29,690 --> 00:06:33,030
.لا داعي للقلق، لا مجال للخطأ في خطط إمي-تشان

71
00:06:33,030 --> 00:06:35,040
!يمكنكنّ الاعتماد عليّ

72
00:06:35,040 --> 00:06:37,830
.نهاية الرّبع الثّاني قريبة

73
00:06:37,830 --> 00:06:40,600
هل يستطيع فريق رايز المحافظة على تقدّمه؟

74
00:06:49,640 --> 00:06:52,670
!تحرز توموناغا من سمايل سلّة تقلب الموازين

75
00:06:53,000 --> 00:06:56,190
!وبهذا ينتهي الرّبع الثّاني

76
00:06:56,190 --> 00:06:59,180
!سمايل باور في المقدّمة الآن

77
00:06:59,720 --> 00:07:02,750
.تفضّلن. لا تنسين أن تشربن

78
00:07:02,750 --> 00:07:03,380
.أكيد

79
00:07:03,380 --> 00:07:04,130
.شكرًا

80
00:07:04,130 --> 00:07:05,310
!جيّد، جيّد

81
00:07:05,310 --> 00:07:09,270
بدأتنّ جميعًا بالاعتياد على حركات
!كوداكا-تشان ومايهارا-تشان

82
00:07:09,270 --> 00:07:11,830
.لا بدّ أنّ قدرة تحمّلهنّ انخفضت الآن

83
00:07:11,830 --> 00:07:14,170
آمل أن يكنّ قد أُنهكن
.في النّصف الثّاني من المباراة

84
00:07:14,170 --> 00:07:16,640
.لديهنّ لاعبتان حقيقيّتنا فحسب

85
00:07:16,640 --> 00:07:19,040
،ما يجعل الثّالثة مجرّد عبء لا يعتمد عليه

86
00:07:19,040 --> 00:07:21,080
.ولاعبتان آليّتان لإكمال عدد اللاّعبات

87
00:07:21,570 --> 00:07:23,570
!لنرهم كلّ ما لدينا في النّصف الثّاني

88
00:07:23,910 --> 00:07:25,230
!أكيد

89
00:07:26,020 --> 00:07:28,730
ما الوضع؟ هل بدأت تعتادين؟

90
00:07:28,730 --> 00:07:31,330
.نعم، أعتقد أنّني بدأت أعتاد الأمر

91
00:07:31,650 --> 00:07:34,490
حسنًا، النّصف الثّاني هو فرصتك
.لتتألّقي يا هيورين

92
00:07:37,320 --> 00:07:38,160
!أكيد

93
00:07:38,440 --> 00:07:42,800
.سيبدأ الآن الرّبع الثّالث
!الكرة مع كوداكا من فريق رايز

94
00:07:45,300 --> 00:07:48,430
!لكنّها محاصرة أكثر حتّى من النّصف الأوّل

95
00:07:48,880 --> 00:07:49,930
!يوكا

96
00:07:58,940 --> 00:07:59,720
.ساكي-سان

97
00:07:59,720 --> 00:08:00,710
!ممتاز

98
00:08:10,620 --> 00:08:12,330
!تنقلب الصّدارة

99
00:08:13,820 --> 00:08:18,380
أُحبطت محاولة سمايل باور للتّسجيل
!عندما سلبت هاياما الكرة لصالح رايز

100
00:08:18,380 --> 00:08:21,110
،بمساعدة من اللاّعبات الآليّات
!انتهى المطاف بالكرة في يد كوداكا

101
00:08:21,420 --> 00:08:24,130
!ظهرت هاياما-تشان من العدم

102
00:08:24,130 --> 00:08:26,360
!لا، كانت مجرّد مصادفة

103
00:08:26,790 --> 00:08:29,110
صادف أن كانت في المكان المناسب
.في الوقت المناسب

104
00:08:38,120 --> 00:08:39,870
!مستحيل

105
00:08:43,580 --> 00:08:45,460
...الرّقم 5 هاياما-سان

106
00:08:45,870 --> 00:08:47,260
!عليّ تغيير وتيرة اللّعب

107
00:08:47,260 --> 00:08:48,880
...بتمريرات قصيرة وآمنة

108
00:08:48,880 --> 00:08:49,870
!هارو-تشان

109
00:08:59,990 --> 00:09:01,210
...نقطتان، هذه بداية

110
00:09:06,020 --> 00:09:06,770
!ماذا؟

111
00:09:10,200 --> 00:09:10,970
!سوميكا-سان

112
00:09:11,310 --> 00:09:12,170
!ممتاز

113
00:09:24,840 --> 00:09:25,610
!هيورين

114
00:09:32,710 --> 00:09:35,220
!تسجّل مايهارا من رايز ثلاث نقاط

115
00:09:35,220 --> 00:09:37,230
!إنّهنّ في المقدّمة الآن بعشر نقاط

116
00:09:37,460 --> 00:09:41,540
أمّنت هاياما من رايز عودة
.لفريقها بعد سلب الكرة بشكل مذهل

117
00:09:41,540 --> 00:09:44,780
إنّها مسيطرة على كلتا الشّبكتين
،بحركاتها المذهلة وقفزاتها

118
00:09:44,780 --> 00:09:46,970
!ما يعزّز تقدّم فريقها أكثر

119
00:09:47,580 --> 00:09:49,230
!ما زال في جعبتنا الكثير

120
00:09:49,460 --> 00:09:50,940
!لنقلب الموازين

121
00:09:58,740 --> 00:10:00,670
ما خطبها؟

122
00:10:00,670 --> 00:10:03,230
!صارت أسرع في النّصف الثّاني

123
00:10:16,580 --> 00:10:18,350
!لن أسمح لك بمواصلة فعل هذا

124
00:10:25,780 --> 00:10:28,780
!مصيبة، مصيبة! ما العمل؟

125
00:10:28,780 --> 00:10:29,740
...كلاّ

126
00:10:39,030 --> 00:10:41,420
،بعد أن بدأت هاياما-تشان باللّعب بفعاليّة

127
00:10:41,420 --> 00:10:44,630
صار من غير الممكن إيقاف مايهارا-تشان
...وكوداكا-تشان ثانية

128
00:10:44,630 --> 00:10:48,200
!كلاّ، خطّتي المثاليّة

129
00:10:48,200 --> 00:10:50,790
!ماذا الآن أيّتها القائدة إمي؟

130
00:10:51,540 --> 00:10:54,990
حركات هاياما-تشان الوحيدة
.هي المرتدّات وسلب الكرة

131
00:10:54,990 --> 00:10:56,630
،لا يمكنها تسجيل النّقاط

132
00:10:56,630 --> 00:10:59,380
لذلك واصلن محاصرة
!مايهارا-تشان وكوداكا-تشان

133
00:11:07,950 --> 00:11:11,630
.هيورين مبتدئة في الرّياضة بالفعل

134
00:11:11,630 --> 00:11:13,890
.لكنّ ذلك لا يجعل منها عبئًا في الفريق

135
00:11:14,910 --> 00:11:19,040
!تسجّل هاياما نقاطًا لصالح رايز
!صار الفارق الآن أوسع

136
00:11:20,130 --> 00:11:24,560
بإمكانها التّفكير بجدّيّة حيال
،ما تفتقر له وما يحتاجه الفريق

137
00:11:24,560 --> 00:11:26,600
.ثمّ تعمل بجدّ لتحقيق ذلك

138
00:11:27,570 --> 00:11:31,160
لهذا السّبب علينا أيضًا العمل بجدّ
.لمجاراة هيورين

139
00:11:32,130 --> 00:11:35,420
إنّها زميلة فريق يُعتمد عليها
،ومنافِسة جديرة

140
00:11:38,830 --> 00:11:41,400
والشّخص الّذي منحنا حلمًا جديدًا

141
00:11:41,400 --> 00:11:43,420
.رغم أنّنا تخلّينا عن المنافسة من قبل

142
00:11:43,930 --> 00:11:46,680
!لهذا السّبب أحبّك يا هيورين

143
00:11:46,680 --> 00:11:50,150
.شكرًا لك! أحبّك أيضًا يا سومي-تشان

144
00:11:55,970 --> 00:11:58,680
!إمي-تشين، ما العمل الآن؟

145
00:12:00,750 --> 00:12:02,440
!سأدخل

146
00:12:02,790 --> 00:12:05,460
،فشلتُ في التّخطيط
!لكنّني سأعوّض عن ذلك بالقوّة

147
00:12:05,460 --> 00:12:07,960
ماذا؟ فريق سمايل يخسر؟

148
00:12:07,960 --> 00:12:11,560
!تنضمّ القائدة هوجو من سمايل باور للّعب

149
00:12:11,560 --> 00:12:13,260
!هل باستطاعتهنّ قلب الموازين؟

150
00:12:13,260 --> 00:12:15,950
.خصمهنّ فريق جديد بدأ هذه السّنة

151
00:12:15,950 --> 00:12:17,960
.ويبدو أنّهنّ لم يحظين ببدايتهنّ كفنّانات أيضًا

152
00:12:18,520 --> 00:12:21,370
.لديهنّ ثلاثة عضوات فحسب

153
00:12:22,250 --> 00:12:25,460
...يراقب الجميع الرّقمين 7 و10، ولكن

154
00:12:26,060 --> 00:12:28,230
.الرّقم 5 ليست سيّئة أيضًا

155
00:12:30,300 --> 00:12:32,470
.نعم، إنّها تقفز كثيرًا

156
00:12:33,380 --> 00:12:35,650
...تبدو حركاتها مبتدئة قليلاً، ولكن

157
00:12:37,730 --> 00:12:39,510
.قد تكون لاعبة ممتازة

158
00:12:40,180 --> 00:12:43,860
!من الجيّد رؤية وجه جديد

159
00:12:43,650 --> 00:12:47,280
بطلات القلوب الفائقة
نهائيّات كاناغاوا قبل سنتين
المركز الثّاني في منافسات شرق اليابان العام الماضي
مجموعة فنّانات الرّياضات الفائقة
ماي-بي

160
00:12:47,280 --> 00:12:52,790
قائدة ماي-بي
أفضل لاعبة في كاناغاوا
ساكوراي أوزوكي

161
00:12:49,700 --> 00:12:52,200
!لنرَ إن كنّ سيلعبن معنا يومًا ما

162
00:12:53,030 --> 00:12:55,790
.انتهت المباراة

163
00:12:56,160 --> 00:13:00,410
قاتل فريق سمايل باور حتّى النّهاية
.ولكنّهنّ هزمن لسوء الحظّ

164
00:13:00,810 --> 00:13:02,700
الفريق الّذي تأهّل إلى نهائيّات المنافسة

165
00:13:02,700 --> 00:13:05,500
واستحقّ فرصة للأداء على المسرح اليوم

166
00:13:05,500 --> 00:13:06,840
!هو فريق رايز

167
00:13:13,390 --> 00:13:16,040
!كان المنافسة محتدمة في النّهاية

168
00:13:16,040 --> 00:13:18,190
.لاحقننا بكلّ عزم

169
00:13:18,190 --> 00:13:21,680
بالكاد حافظنا على طبيعتنا
.الّتي حقّقناها في منتصف المباراة

170
00:13:26,390 --> 00:13:29,710
.ولكن... أنا جدّ سعيدة لفوزنا

171
00:13:32,530 --> 00:13:35,200
!حسنًا، لنخرج ونغيّر ملابسنا

172
00:13:35,200 --> 00:13:37,200
!علينا الاستعداد لصعود المسرح

173
00:13:37,550 --> 00:13:38,650
!نعم

174
00:13:47,060 --> 00:13:49,350
.هذا هو المسرح إذًا

175
00:13:52,410 --> 00:13:55,640
أليس هنالك... الكثير من النّاس؟

176
00:13:55,640 --> 00:13:56,830
...نعم

177
00:14:06,450 --> 00:14:07,650
.شكرًا جزيلاً لك

178
00:14:07,650 --> 00:14:08,460
.نعم

179
00:14:13,800 --> 00:14:15,450
.حسنًا، لنستعدّ

180
00:14:15,740 --> 00:14:17,220
ما-ماذا؟

181
00:14:20,520 --> 00:14:22,850
هل تشعران... بالتّوتّر؟

182
00:14:22,850 --> 00:14:24,380
.لا... لا أدري

183
00:14:24,380 --> 00:14:27,120
.هذا الضّغط مختلف عن الضّغط في المباريات

184
00:14:27,120 --> 00:14:29,300
.أشعر... بالحرج نوعًا ما

185
00:14:30,020 --> 00:14:32,170
.لكنّك تبدين عاديّة يا هيورين

186
00:14:32,170 --> 00:14:34,230
.لقد اعتدتُ على هذا

187
00:14:34,490 --> 00:14:37,440
،أديّت في مواقف سيّارات الأسواق المركزيّة

188
00:14:37,440 --> 00:14:41,230
وفي متاجر التّسوّق وعدّة أماكن
.أخرى وأنا في الإعداديّة

189
00:14:41,230 --> 00:14:42,310
.فهمت

190
00:14:42,310 --> 00:14:43,970
!أردت رؤية ذلك

191
00:14:44,260 --> 00:14:46,440
.لم تكن هنالك غرف انتظار أو أماكن للتّدرّب

192
00:14:46,440 --> 00:14:49,750
.كان عليّ تغيير ملابسي في زوايا الممرّات أحيانًا

193
00:14:50,080 --> 00:14:55,360
لهذا السّبب أنا سعيدة جدًّا لأنّ فريق رايز
.سيحظى بأوّل أداء له على مسرح حقيقيّ

194
00:14:57,360 --> 00:15:00,370
!حسنًا، لنضع أغراضنا جانبًا ونتدرّب

195
00:15:00,370 --> 00:15:05,370
اختتمت جميع المباريات في نهائيّات
.المجموعات للقلوب الفائقة

196
00:15:06,030 --> 00:15:08,920
العروض الخاصّة من أداء الفرق الفائزة

197
00:15:08,920 --> 00:15:11,880
.ستُقام في ساحة الطّعام في المبنى الشّرقي

198
00:15:12,110 --> 00:15:16,150
ما زالت هنالك أماكن في المناطق
.المجّانيّة في الطّابقين الثّاني والثّالث

199
00:15:16,150 --> 00:15:18,450
.استمتعوا بوقتكم

200
00:15:24,540 --> 00:15:29,400
تقدّم كون للموسيقى عروض الفائزات
!في القلوب الفائقة الخاصّة

201
00:15:29,950 --> 00:15:34,110
سنبدأ الآن عروض العشر دقائق السّتّة

202
00:15:34,110 --> 00:15:36,920
من أداء الفرق الّتي فازت
.في نهائيّات المجموعات اليوم

203
00:15:37,410 --> 00:15:41,420
قبل أن نبدأ، ألقوا نظرة رجاءً
.على اللّوحات الّتي على طاولاتكم

204
00:15:42,010 --> 00:15:46,200
لنبدأ التّصويت. من هو فريقكم المفضّل؟

205
00:15:46,200 --> 00:15:47,270
!تفضّلوا

206
00:15:50,850 --> 00:15:53,820
.مهلاً، هذا مثير للاهتمام

207
00:15:54,360 --> 00:15:58,900
المركز الأوّل لفريق لينك دول المحبوب
.صاحب المركز الثّاني في كاناغاوا العام الماضي

208
00:15:59,670 --> 00:16:01,450
.المركز الثّاني لفلام أكسيس

209
00:16:02,160 --> 00:16:06,800
راديكال أليس في المركز الثّالث
.ويكتسبن الزّخم في الآونة الأخيرة

210
00:16:06,800 --> 00:16:10,150
.المركز الرّابع لفرقة الكوميديا قلوب الكنز

211
00:16:10,150 --> 00:16:13,490
المركز الخامس لفريق ميكّو المكوّن
.من فنّانات حصلن على بدايتهنّ هذه السّنة

212
00:16:13,490 --> 00:16:17,140
...وفي المركز الأخير

213
00:16:17,140 --> 00:16:18,640
!فريق رايز بصوت واحد

214
00:16:19,040 --> 00:16:22,610
.حسنًا، هذه هي بدايتهنّ على المسرح في النّهاية

215
00:16:22,610 --> 00:16:23,950
.بالفعل

216
00:16:24,220 --> 00:16:27,720
،خلال عرض كلّ مجموعة
...إن أعجبكم ما تشاهدونه

217
00:16:27,720 --> 00:16:29,280
!"اضغطوا على زرّ "إعجاب

218
00:16:29,280 --> 00:16:32,390
...رغم أنّ تواجدنا في المركز الأخير ليس مفاجأة

219
00:16:32,390 --> 00:16:35,710
لم أدرك أنّنا سنُصنّف حسب أدائنا
.على المسرح أيضًا

220
00:16:36,490 --> 00:16:38,360
!مرحبًا بالجميع

221
00:16:39,440 --> 00:16:41,820
!نحن لينك دول

222
00:16:43,730 --> 00:16:48,720
!"استمعوا لأغنيتنا الأولى! "سودا الأحلام

223
00:16:48,720 --> 00:16:50,820
!هيّا، سيبدأن الغناء

224
00:16:51,160 --> 00:16:55,260
كنتُ أقول لنفسي، "سيكون من الجيّد
...إن فزنا وصعدنا المسرح"، ولكن

225
00:16:56,190 --> 00:17:00,010
الكلمات المختصرة الّتي نتبادلها

226
00:17:00,010 --> 00:17:03,080
يمكن أن تجعلني سعيدة

227
00:17:03,080 --> 00:17:04,490
أو كما الآن

228
00:17:04,490 --> 00:17:08,330
اجعل قلبي يتسابق إلى ما لا نهاية

229
00:17:06,000 --> 00:17:10,210
...الغناء على ذلك المسرح، والتّعرّض للحكم

230
00:17:08,850 --> 00:17:15,590
الوقت الّذي قضيناه معًا ينقضي بشدّة

231
00:17:13,290 --> 00:17:17,270
.لا يمكنني الفشل مهما كلّف الأمر

232
00:17:15,590 --> 00:17:18,960
مع مشاعري بالمحبة تجاهك وابتسامتك

233
00:17:18,960 --> 00:17:21,980
هو ما أحلم به

234
00:17:23,100 --> 00:17:26,980
لا أستطيع قول "أنا أحبّك" بصراحة

235
00:17:26,980 --> 00:17:29,360
لأنّ قلبي

236
00:17:29,360 --> 00:17:34,940
نكهة خفيفة مكربنة يشوبها الشّوق

237
00:17:35,220 --> 00:17:43,880
غدًا، سأقع في الحبّ أكثر

238
00:17:46,410 --> 00:17:48,430
!شكرًا جزيلاً لكم

239
00:17:52,380 --> 00:17:54,860
!شكرًا لكنّ يا لينك دول

240
00:17:57,650 --> 00:18:00,960
.هيّا بنا يا سومي-تشان وسا-تشان

241
00:18:04,930 --> 00:18:05,850
.أكيد

242
00:18:19,580 --> 00:18:20,950
!مرحبًا

243
00:18:20,950 --> 00:18:22,820
.مرحبًا

244
00:18:23,080 --> 00:18:25,070
!سررنا بلقاء الجميع

245
00:18:25,070 --> 00:18:27,340
.نحن فرقة رايز واسمي هاياما هيوري

246
00:18:27,340 --> 00:18:29,000
.وأنا مايهارا سوميكا

247
00:18:29,000 --> 00:18:30,410
.وأنا كوداكا ساكي

248
00:18:30,870 --> 00:18:35,210
.كم أودّ أن تستمعوا جميعًا لأغنيتنا اليوم

249
00:18:35,480 --> 00:18:36,890
،في الحقيقة

250
00:18:36,890 --> 00:18:42,290
.حظيت ببدايتي الفنّيّة كمغنّية وملحّنة مسبقًا

251
00:18:42,610 --> 00:18:47,220
.لكن لم أحظى بأيّ تفاعل وطُردت من وكالتي

252
00:18:48,700 --> 00:18:52,640
...ومع ذلك، أردت مواصلة الغناء بشكل احترافيّ

253
00:18:53,010 --> 00:18:57,730
وحينها اكتشفت فرصة القلوب الفائقة

254
00:18:58,350 --> 00:19:03,000
وحصلت على دعم سوميكا-تشان
.وسا-تشان، حليفتيّ القويّتين

255
00:19:03,590 --> 00:19:08,630
عملنا نحن الثّلاثة على تحسين
.مختلف الأشياء للوصول لهذه الخشبة

256
00:19:08,630 --> 00:19:09,530
صحيح؟

257
00:19:09,530 --> 00:19:10,580
!نعم

258
00:19:11,570 --> 00:19:15,870
والآن، سنقدّم لكم أغنيتنا المليئة
.بذكرياتنا وآمالنا للمستقبل

259
00:19:16,380 --> 00:19:17,650
.استمعوا رجاءً

260
00:19:18,500 --> 00:19:20,140
".حلم الارتقاء"

261
00:19:22,450 --> 00:19:27,330
في ذلك الوقت، عندما قطعنا وعدنا

262
00:19:27,330 --> 00:19:31,840
العهود الّتي تبادلناها معًا

263
00:19:31,840 --> 00:19:36,930
حتّى يحين أوان تحقيقها

264
00:19:48,500 --> 00:19:53,160
حتّى في الأيّام الّتي نتنهّد فيها ونتعثّر

265
00:19:53,160 --> 00:19:56,270
الأمنية الّتي لا يمكننا التّخلّي عنها

266
00:19:59,120 --> 00:20:01,100
لاحظتُ

267
00:20:01,100 --> 00:20:03,930
أنّه هناك دائمًا

268
00:20:03,930 --> 00:20:09,840
الباب المؤدّي للمستقبل الّذي أحبّه

269
00:20:10,170 --> 00:20:12,870
من المكان الّذي نحن فيه الآن

270
00:20:12,870 --> 00:20:15,110
سنبدأ بالأشياء الّتي يمكننا فعلها

271
00:20:15,440 --> 00:20:17,930
إذا بدأنا في الرّكض دون تردّد

272
00:20:17,930 --> 00:20:22,370
متأكّدة أنّه يمكننا تغيير عالمنا

273
00:20:22,370 --> 00:20:23,230
دائمًا

274
00:20:23,230 --> 00:20:28,240
النّجوم الّتي نتطلّع إليها بعيدة جدًّا

275
00:20:28,240 --> 00:20:30,890
لكن لا بأس

276
00:20:30,890 --> 00:20:33,900
سنتغلّب على أيّ حدود

277
00:20:33,900 --> 00:20:38,780
سنحوّل قلوبنا المتعثّرة ودموعنا

278
00:20:38,780 --> 00:20:41,650
إلى قوّة

279
00:20:41,650 --> 00:20:44,590
لسنا وحدنا أبدًا

280
00:20:44,590 --> 00:20:49,200
اليوم وغدًا، نأمل

281
00:20:49,200 --> 00:20:51,680
أنّنا سنغنّي

282
00:20:51,680 --> 00:20:55,010
في الطّريق إلى حلمنا

283
00:20:55,920 --> 00:20:58,870
،عندما كنت أكتب الأغاني لأغنّيها وحدي

284
00:20:58,870 --> 00:21:01,230
.كان كلّ ما أفكّر فيه هو نفسي

285
00:21:01,860 --> 00:21:03,900
.لكنّ الأمر مختلف تمامًا الآن

286
00:21:04,300 --> 00:21:07,010
...كلّ الشّجاعة والسّعادة الّتي لديّ الآن

287
00:21:07,010 --> 00:21:09,430
.كلّ الأشياء السّعيدة والممتعة الّتي حدثت

288
00:21:10,070 --> 00:21:12,530
أريد تحويل كلّ ذلك إلى أغنية
.تجعل الجميع يشعرون بها

289
00:21:12,530 --> 00:21:15,340
.أريد من الجميع أن يستمعوا ويستمتعوا

290
00:21:15,340 --> 00:21:18,320
!أريد الابتسام مع الجميع

291
00:21:18,320 --> 00:21:19,240
دائمًا

292
00:21:19,240 --> 00:21:21,640
سأركض معك

293
00:21:21,640 --> 00:21:23,930
سأغنّي معك

294
00:21:23,930 --> 00:21:26,890
شغفنا

295
00:21:26,890 --> 00:21:29,900
سنكون صادقات معه معًا

296
00:21:29,900 --> 00:21:32,230
سنؤمن ونواصل

297
00:21:32,230 --> 00:21:34,840
نحو مستقبلنا

298
00:21:34,840 --> 00:21:37,690
سننجح بكلّ تأكيد

299
00:21:37,690 --> 00:21:40,430
لا شيء مستحيل

300
00:21:40,430 --> 00:21:45,230
اليوم وغدًا، نأمل

301
00:21:45,230 --> 00:21:50,590
أنّنا سنغنّي، للسّماء وما بعدها

302
00:21:50,590 --> 00:21:51,890
يومًا ما

303
00:21:51,890 --> 00:21:56,340
سنصل إلى هناك، سنغنّي

304
00:22:14,080 --> 00:22:15,940
!شكرًا جزيلاً لكم

305
00:23:50,780 --> 00:23:52,810
!كـ-كنت متوتّرة جدًّا

306
00:23:52,810 --> 00:23:54,350
!كان قلبي يدقّ بسرعة

307
00:23:54,350 --> 00:23:55,680
!لكنّني استمتعت

308
00:23:55,680 --> 00:23:58,830
!أنا سعيدة أنّ الجميع استمتعوا

309
00:23:58,830 --> 00:24:01,500
!على أيّ حال، سنقابل وجهًا جديدًا الحلقة القادمة

310
00:24:01,500 --> 00:24:02,880
.أتساءل كيف سيكون ذلك

311
00:24:02,880 --> 00:24:04,230
!أتطلّع قدمًا لذلك