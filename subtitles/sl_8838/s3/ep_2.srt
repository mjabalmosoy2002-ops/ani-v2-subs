1
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

2
00:01:30,440 --> 00:01:33,410
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

3
00:01:33,410 --> 00:01:35,200
هل سمعتُما الرّواية؟

4
00:01:35,200 --> 00:01:38,490
أجل، عن المرأة الفظيعة الّتي
أشعلتْ تمرُّداً، صحيح؟

5
00:01:38,490 --> 00:01:42,620
سمعتُ بأنّ الأخ الأصغر الإمبراطوريّ قادَ
الحرس الملكيّ لإسقاط المُتمرّدين

6
00:01:42,960 --> 00:01:47,600
لكن هل سمعتُما أيضاً كيف خلّفتْ روران
الشّرّيرة ندبةً في وجهه؟

7
00:01:47,600 --> 00:01:50,210
!كم هذا مُروِّع

8
00:01:53,630 --> 00:01:54,590
مولايّ جينشي

9
00:01:55,260 --> 00:01:59,270
الحلقة 50: عباءة جرذ النّار

10
00:01:59,270 --> 00:01:59,850
يتمّ توزيع هذا في الشّوارع

11
00:02:00,180 --> 00:02:04,790
يكتبون ما يحلو لهم عن تمرُّد شي وعلاقتك بالأمر

12
00:02:07,100 --> 00:02:08,240
دعهم وشأنهم

13
00:02:08,240 --> 00:02:11,150
عُلِم. وأيضاً، هذا من الفتاة

14
00:02:11,660 --> 00:02:13,480
ماذا؟ من ماوماو؟

15
00:02:15,610 --> 00:02:17,110
بيت الزنجار

16
00:02:17,850 --> 00:02:21,910
تُغلق الصّيدليّة عندما يفتح بيت الزنجار

17
00:02:22,500 --> 00:02:24,870
،لا يأتينا عددٌ جيّد من الزّبائن ليلاً

18
00:02:25,190 --> 00:02:27,380
والزّيت المطلوب لإضاءة المكان ليس رخيصاً

19
00:02:31,620 --> 00:02:32,870
يا عجوز

20
00:02:32,870 --> 00:02:33,630
ماذا؟

21
00:02:33,890 --> 00:02:36,140
هذه مبيعات اليوم. اعتني بها

22
00:02:36,140 --> 00:02:37,510
حسناً

23
00:02:37,510 --> 00:02:39,590
تشو-يو، سنعود إلى المنزل

24
00:02:40,180 --> 00:02:42,390
ماذا؟ من الآن؟

25
00:02:45,420 --> 00:02:47,780
...البرد قارس

26
00:02:48,940 --> 00:02:51,000
ألن تأكل؟

27
00:02:51,000 --> 00:02:52,990
حسناً

28
00:02:53,630 --> 00:02:54,950
مُؤلم

29
00:02:54,950 --> 00:02:56,510
!اخلع هذا الغطاء

30
00:02:56,510 --> 00:02:58,900
!مؤلم! أنتِ فظيعة

31
00:02:58,900 --> 00:03:00,980
اصمت. ارتدِ هذا

32
00:03:04,290 --> 00:03:06,380
أضيفي مزيداً من اللّحم

33
00:03:06,380 --> 00:03:08,330
إذاً اكسب مالاً أكثر

34
00:03:08,840 --> 00:03:12,130
،أتقاضى ما يكفي من مال للاهتمام بتشو-يو

35
00:03:12,130 --> 00:03:14,370
لكن لا أنوي إسراف أيّ منها

36
00:03:14,370 --> 00:03:17,930
نمش، أنتِ تجنين الكثير من المال

37
00:03:17,930 --> 00:03:19,850
لِمَ لا تُطعمين نفسكِ شيئاً أفضل؟

38
00:03:20,130 --> 00:03:23,730
أحمق، نحن نستأجر من تلك السّيّدة العجوز

39
00:03:23,730 --> 00:03:25,890
كم يُكلّفني ذلك برأيك؟

40
00:03:27,740 --> 00:03:29,580
...تبّاً... البرد شديد

41
00:03:29,580 --> 00:03:32,320
أعتقد بأنّ تلك السّترة المحشوّة رقيقة جدّاً

42
00:03:33,460 --> 00:03:35,940
.سنذهب للتسوُّق وشراء الملابس غداً
تعال معي

43
00:03:35,940 --> 00:03:37,240
!حقّاً؟

44
00:03:37,240 --> 00:03:39,420
...مرحى

45
00:03:39,420 --> 00:03:41,910
...مؤلم

46
00:03:46,400 --> 00:03:47,740
ابقَ قريباً

47
00:03:50,670 --> 00:03:53,710
يقسم الشّارع الرّئيسيّ المدينةَ العاصمة
إلى نصفين شرق وغرب

48
00:03:54,020 --> 00:03:56,840
كلّما اتّجهنا شمالاً، أصبحت المتاجر أفخر

49
00:03:57,180 --> 00:03:59,840
وإذا اتّجهنا جنوباً، يبدأ المستوى بالانحدار

50
00:04:00,970 --> 00:04:04,430
هناك كثير من باعة الشّوارع المشبوهين في الأزقّة

51
00:04:05,200 --> 00:04:07,150
قلتُ ابقَ قريباً

52
00:04:11,280 --> 00:04:12,300
هنا

53
00:04:12,300 --> 00:04:14,610
ماذا؟ أشياء مُستعملة؟

54
00:04:14,610 --> 00:04:18,560
كُن منطقيّاً. والآن، أين السّترات المحشوّة
...بمقاس أطفال

55
00:04:20,530 --> 00:04:21,960
ما هذا؟

56
00:04:26,180 --> 00:04:28,940
...يبدو كثياب من ثقافة أُخرى

57
00:04:28,940 --> 00:04:31,210
يبدو رخيصاً بعض الشّيء

58
00:04:31,850 --> 00:04:32,330
!مؤلم

59
00:04:32,780 --> 00:04:33,990
...مؤلم

60
00:04:33,990 --> 00:04:37,050
أتعتقدان بأنّه يبدو رخيصاً؟

61
00:04:37,050 --> 00:04:42,340
أوليس كذلك؟ ألا يستخدم النّاس ألوانَ
برّاقة على ملابس النّساء؟

62
00:04:42,340 --> 00:04:44,800
في العادة، أجل

63
00:04:45,260 --> 00:04:48,640
لكن ارتُدي هذا اللّباس بواسطة عذراء سماويّة

64
00:04:48,640 --> 00:04:50,140
عذراء سماويّة؟

65
00:04:50,580 --> 00:04:55,360
أتريدان سماع قصّة العذراء السّماويّة
الّتي اختفت في البُحيرة؟

66
00:04:56,540 --> 00:04:57,480
!أجل

67
00:04:57,480 --> 00:05:00,530
يعشق مالكُ هذا المتجر حقّاً رِواء القصص

68
00:05:00,950 --> 00:05:03,200
أتذكّر بأنّ أبي كان ينغمس فيها أيضاً

69
00:05:07,310 --> 00:05:10,980
وقعتْ هذه القصّة في قرية كائنة في الغرب

70
00:05:12,230 --> 00:05:16,320
ذات يوم، ساعدَ قرويٌّ فتاةً تائهة

71
00:05:16,960 --> 00:05:21,910
كانت الفتاة الحسناء ذات شعر
ذهبيّ وبشرة شاحبة

72
00:05:22,550 --> 00:05:25,530
وقع القرويُّ في الحُبّ من أوّل نظرة

73
00:05:27,060 --> 00:05:31,880
الفتاةُ شكرَتِ القرويَّ بنسجِ ثياب له

74
00:05:33,020 --> 00:05:36,300
الثّياب المُطرّز بشكل غامض

75
00:05:36,300 --> 00:05:40,040
بيعَ بأضعاف سعر الملابس الأُخرى

76
00:05:40,770 --> 00:05:45,910
مضتْ أشهر، وبدأت الفتاةُ تبكي قائلة
بأنّها تريد العودة إلى المنزل

77
00:05:45,910 --> 00:05:48,980
لكن كان القرويّ واقعاً في الحُبّ
وطلبَ الزّواج منها عدّة مرّات

78
00:05:48,980 --> 00:05:52,140
قَبِلَتِ الفتاةُ أخيراً

79
00:05:53,520 --> 00:05:58,140
لكن ذات يوم، أتتْ عائلةُ الفتاة
إلى القرية بحثاً عنها

80
00:05:58,590 --> 00:06:01,230
لم يُرِد القرويّون التخلِّي عنها

81
00:06:01,950 --> 00:06:06,720
لذا أخبؤوا الفتاة، وتعاونوا على نكران
معرفة أيّ شيء عنها

82
00:06:07,580 --> 00:06:12,280
غادرت العائلة، لكن بدتْ مُرتابة

83
00:06:12,980 --> 00:06:17,560
لذا قرّرَ القرويُّ أن يُعجِّل في إجراءات الزّفاف

84
00:06:18,110 --> 00:06:22,400
،بعد أن شعرتْ بأنّ عائلتها قريبة
حاولت الفتاةُ المُقاومة، لكن بلا جدوى

85
00:06:22,860 --> 00:06:25,110
،جعلَها القرويُّ تُطهِّر نفسها في النّبع

86
00:06:25,110 --> 00:06:30,070
وجعلَها ترتدي ثيابها التّقليديّ
الّذي نسجَتْه بنفسها

87
00:06:30,870 --> 00:06:35,750
لم تتوقّف دموع الفتاة لتغمر كامل جسدها

88
00:06:38,260 --> 00:06:43,380
أطلقتْ نداء استنجاد أخير للسّماح لها
بالعودة إلى عائلتها

89
00:06:43,700 --> 00:06:45,370
...إذا رفضوا

90
00:06:56,600 --> 00:07:02,940
:كان كُلّ ما بقي هو قطعة قماش
الإزار الّذي وضعَتْه على رأسها

91
00:07:03,320 --> 00:07:05,420
...عادت الفتاةُ إلى السّماوات

92
00:07:05,420 --> 00:07:08,380
هذا ما اعتقده القرويّون

93
00:07:08,990 --> 00:07:14,000
وكانت هذه إحدى الملابس الّتي طُرِّزَتْ
بواسطتها، العذراء السّماويّة

94
00:07:15,810 --> 00:07:19,100
!نمش، هذا مُذهل

95
00:07:19,100 --> 00:07:20,250
لِمَ لا تشترينه؟

96
00:07:20,600 --> 00:07:25,010
تبدين في مثل سنّ العذراء السّماويّة تقريباً

97
00:07:25,010 --> 00:07:26,220
سأمنحكِ حسماً جيّداً

98
00:07:26,530 --> 00:07:27,370
!بئساً

99
00:07:27,370 --> 00:07:29,300
هناك رقم إضافيّ

100
00:07:29,300 --> 00:07:34,350
ماذا؟ ألا تُصدِّقين الأسطورة؟
روحكِ ليست شاعريّة

101
00:07:34,630 --> 00:07:38,880
شاعريّة؟ شاهدتُ بالفعل عذراءً سماويّة
بشكل مُباشر

102
00:07:38,880 --> 00:07:40,360
تختفي في كتلة من الماء

103
00:07:43,320 --> 00:07:45,240
هل يمكنني لمسه؟

104
00:07:45,240 --> 00:07:48,060
أجل، لكن لا تُفسديه

105
00:07:48,700 --> 00:07:52,380
،هناك كثير من الأشياء الغريبة والمُذهلة في العالم

106
00:07:52,380 --> 00:07:55,200
لكن هناك دوماً منطق وراءها

107
00:07:55,550 --> 00:07:57,610
،عندما يكون ذلك المنطق من الصّعب التحقُّق منه

108
00:07:57,610 --> 00:08:02,590
يعتمد النّاس على لعنات وسحر وأحياناً
أشباح لتفسير ذلك

109
00:08:04,030 --> 00:08:05,840
...هذا الشّكل

110
00:08:07,120 --> 00:08:10,180
ماذا ستقول إذا استطعتُ بيع هذا
الثّياب بعشرة أضعاف السّعر؟

111
00:08:10,180 --> 00:08:15,850
،عشرة أضعاف؟ إذا استطعتِ فعل ذلك
فيمكنكِ الحصول على كُلّ ما لديّ مجّاناً

112
00:08:17,430 --> 00:08:18,900
هل سمعت هذا يا تشو-يو؟

113
00:08:18,900 --> 00:08:22,980
عشرة أضعاف؟ أيُعقَل هذا؟

114
00:08:22,980 --> 00:08:25,210
عمّاذا تتكلّمين يا نمش؟

115
00:08:26,310 --> 00:08:28,920
سيّدي، سأستعير هذا الثّياب وهذا الفحم

116
00:08:28,920 --> 00:08:30,730
!مهلاً! ماذا تفعلين؟

117
00:08:38,870 --> 00:08:42,000
!توقّفي! أنتِ تحرقين أداتي الثّمينة

118
00:08:44,260 --> 00:08:46,040
لم... تحترق؟

119
00:08:46,040 --> 00:08:46,960
ماذا؟

120
00:08:46,960 --> 00:08:48,820
هذا فحم، صحيح؟

121
00:08:48,820 --> 00:08:50,010
ما الّذي يجري؟

122
00:08:50,340 --> 00:08:52,960
...يا فتاة، ما الّذي

123
00:08:52,960 --> 00:08:55,000
أنت من قلتَها بنفسك

124
00:08:55,680 --> 00:08:58,930
!طُرِّزَ هذا الثّياب بواسطة عذراء سماويّة

125
00:08:59,230 --> 00:09:00,350
!عذراء سماويّة؟

126
00:09:00,350 --> 00:09:05,460
والآن، كما رأيتم، لمسَه الفحم، لكنّه
!لم يحترق، ولم يُسفَع حتّى

127
00:09:05,460 --> 00:09:07,950
...هذا الثّياب الغامض

128
00:09:07,950 --> 00:09:09,550
...تمتمة، تمتمة

129
00:09:10,700 --> 00:09:12,530
!تمتمة، تمتمة

130
00:09:12,530 --> 00:09:19,110
،"أ-أجل! هذه هي "عباءة جرذ النّار
!المُطرَّزة بواسطة عذراء سماويّة أسطوريّة

131
00:09:19,790 --> 00:09:21,220
!دعني ألقي نظرة بإمعان

132
00:09:21,220 --> 00:09:22,180
!كم ثمنها؟

133
00:09:22,180 --> 00:09:23,700
!سأدفع عشرة! عشرة

134
00:09:23,700 --> 00:09:25,170
!لا، 20

135
00:09:25,170 --> 00:09:26,590
!سـ-سأدفع 50

136
00:09:27,380 --> 00:09:30,040
نمش، أشعر بحرّ شديد

137
00:09:30,040 --> 00:09:31,460
اخلعهم جميعهم إذاً

138
00:09:31,460 --> 00:09:34,760
أنت من قرّرَ ارتداءها كُلّها بدلاً من حملها

139
00:09:35,120 --> 00:09:41,320
كنتُ لأتمنّى ألواناً أقلّ بهرَجة، لكن لا ينبغي
أن أشتكي، بما أنّها كانت مجّانيّة

140
00:09:42,010 --> 00:09:44,440
لماذا لم تحترق تلك العباءة؟

141
00:09:45,000 --> 00:09:47,550
هل تعرف ممّا تُصنع الملابس؟

142
00:09:47,550 --> 00:09:51,260
قطن وقِنَّب؟ وأحياناً حشرات؟

143
00:09:51,260 --> 00:09:54,570
"أجل. لكن ذلك الثّياب صُنِع من "حجر

144
00:09:54,570 --> 00:09:58,040
حجر؟! كهذا الحجر؟

145
00:09:58,460 --> 00:10:01,310
تأتي الحجارة بأشكال عديدة

146
00:10:01,310 --> 00:10:04,500
الملابس المصنوعة من حجر ليفيّ
لا تحترق بسهولة

147
00:10:05,240 --> 00:10:08,760
القماش المُقاوم للنّار المصنوع من الأسبتوس
،لديه أسماء عديدة

148
00:10:08,760 --> 00:10:11,630
"وأحدها هو "عباءة جرذ النّار

149
00:10:12,590 --> 00:10:17,230
رُبّما يكون هناك ممّن يعلمون بذلك، لكن
قلّ من النّاس رأوا واحداً بالفعل

150
00:10:18,260 --> 00:10:21,500
إذاً، ماذا عن قصّة العذراء السّماويّة؟

151
00:10:21,500 --> 00:10:25,300
نصفها صحيح ونصفها كاذب على الأغلب

152
00:10:25,300 --> 00:10:26,520
ما معنى ذلك؟

153
00:10:27,600 --> 00:10:30,850
ميّزتُ التّطريز في الثّياب

154
00:10:31,440 --> 00:10:34,740
هذا نصٌّ من لغة أجنبيّة كان أبي
يكتب بها كثيراً

155
00:10:34,740 --> 00:10:37,660
يمكن تنميطها بسهولة لتبدو بشكل لبلابيّ

156
00:10:38,360 --> 00:10:42,660
العذراء السّماويّة" كانت غالباً فتاة"
من بلد أجنبيّ

157
00:10:43,230 --> 00:10:47,280
لا يمكن معرفة ما إن كانت تائهة
،فعلاً أو مُختطَفة

158
00:10:47,280 --> 00:10:50,630
لكنّها نسجتْ تلك الملابس رغبةً منها
في العودة إلى عائلتها

159
00:10:51,360 --> 00:10:54,630
،بنسجِ رسالةٍ بلغة لا يستطيع القرويّ قراءتها

160
00:10:55,030 --> 00:10:58,040
أرسلتْ سرّاً نداءً للآخرين من بلدها طلباً للمُساعدة

161
00:10:59,640 --> 00:11:03,490
فهمت. |ذاً هكذا أتتْ عائلتها لإحضارها

162
00:11:03,490 --> 00:11:05,100
...ثمّ في يوم الزّفاف

163
00:11:05,700 --> 00:11:09,420
،زعمتْ تطهير نفسها وبلّلتْ ملابسها الدّاخليّة

164
00:11:09,420 --> 00:11:12,110
ثمّ ارتدتْ ثياب أسبتوس فوق ذلك

165
00:11:13,120 --> 00:11:16,090
هل تعلم؟ الوعاء الخشبيّ الّذي يحتوي على ماء

166
00:11:16,090 --> 00:11:18,240
لا يحترق حتّى يجفّ كُلّ الماء

167
00:11:18,240 --> 00:11:20,080
كان هذا مُشابهاً

168
00:11:20,080 --> 00:11:24,930
،وبإضافة ثوب مُقاوم للنّار فوق زيّها الأبيض

169
00:11:24,930 --> 00:11:27,580
قد يحترق الجزء الخارجيّ بشكل مُبهر
دون أذيّة بشرتها ولو قليلاً

170
00:11:28,490 --> 00:11:32,090
ثمّ كان كُلّ ما يترتّب عليها فعله هو القفز
في الماء قبل أن تحترق

171
00:11:32,460 --> 00:11:35,170
لماذا لم تخبري مالكَ المتجر بالأمر؟

172
00:11:35,490 --> 00:11:37,480
لأنّ روحه تتمتّع بشاعريّة

173
00:11:38,430 --> 00:11:40,200
ما معنى ذلك؟

174
00:11:42,000 --> 00:11:43,940
...فتاة من الغرب

175
00:11:43,940 --> 00:11:47,390
هل تستطيع فتاةٌ عاديّة إرسال رسائل
،سرّية باستخدام التّطريز

176
00:11:47,740 --> 00:11:51,460
والجري في الأرجاء أثناء إشعال النّار بنفسها؟

177
00:11:52,030 --> 00:11:55,400
فتاة تُجيد القراءة والكتابة، ولديها
...معرفة بالأسبتوس

178
00:11:55,960 --> 00:12:00,030
هل يمكن لفتاة كهذه أن تتجوّل
في بلد أجنبيّ بمُفردها؟

179
00:12:01,510 --> 00:12:04,490
المنطقة الغربيّة محفوفة دوماً بالنِّزاعات
الصّغيرة مع دُول أُخرى

180
00:12:05,190 --> 00:12:10,780
على ذِكر الأمر، المبعوثتان اللّتان أتتا
إلى لي كانتا مشبوهتين أيضاً

181
00:12:11,640 --> 00:12:15,960
بدتْ إحداهما ذات صِلة بعشيرة شي

182
00:12:16,990 --> 00:12:21,440
رُبّما كانت العذراء السّماويّة جاسوسة
أو ما شابه أيضاً

183
00:12:22,270 --> 00:12:23,460
أيّاً يكن

184
00:12:24,430 --> 00:12:26,450
نـ-نمش؟

185
00:12:36,780 --> 00:12:38,650
!أهلاً وسهلاً

186
00:12:38,650 --> 00:12:40,450
!ما-ما هذا؟

187
00:12:40,450 --> 00:12:43,750
!شاوماو، هذا فخامته جينشي

188
00:12:43,750 --> 00:12:45,550
!هل تخلطين بينه وبين شخص آخر؟

189
00:12:50,150 --> 00:12:51,370
تفضّلا بالدّخول

190
00:12:53,380 --> 00:12:56,420
،يبدو أفضل الآن بعد إزالة القطب

191
00:12:56,420 --> 00:12:58,820
لكن خلّفَ ذلك علامة

192
00:12:58,820 --> 00:13:01,090
ظننتُ بأنّكِ تحتاجين شيئاً منّي

193
00:13:01,090 --> 00:13:02,010
تذكّرت

194
00:13:02,390 --> 00:13:03,970
ألقِ نظرة إلى هذا رجاء

195
00:13:04,530 --> 00:13:05,530
ما هذا؟

196
00:13:05,530 --> 00:13:10,970
سرقَ لصٌّ هذا من حصن شي
وباعه إلى متجر

197
00:13:10,970 --> 00:13:12,750
كيف وجدتِه؟

198
00:13:12,750 --> 00:13:15,320
وجدتُه في مكتبة بالصّدفة البحتة

199
00:13:15,320 --> 00:13:19,470
جمع أوكيو كافّة الكُتُب المُباعة الأُخرى لأجلي

200
00:13:20,520 --> 00:13:23,570
أوكيو، هل يمكنني ترك هذا الشّخص لك؟

201
00:13:23,570 --> 00:13:26,820
بالتّأكيد. احتجنا مُساعدة على أيّ حال

202
00:13:26,820 --> 00:13:29,690
لكن تشو-يو يعرف من يكون، صحيح؟

203
00:13:29,690 --> 00:13:31,910
...هذه مُشكلة

204
00:13:31,910 --> 00:13:33,880
في هذه الحالة، سأغيِّر اسمي

205
00:13:34,270 --> 00:13:36,580
لا ارتباط لي باسمي السّابق

206
00:13:36,580 --> 00:13:39,840
ما رأيك بـ... سازين؟

207
00:13:40,470 --> 00:13:44,220
.إذاً، هذه الكُتُب الّتي باعها "سازين" هذا
ما مدى أهمّيتها؟

208
00:13:44,220 --> 00:13:47,540
أعتقد بأنّ هناك مزيداً من المُجلّدات من هذه
السّلسلة مُتبقّية في الحصن

209
00:13:47,540 --> 00:13:49,680
أحتاج مُساعدة في إيجادهم

210
00:13:49,980 --> 00:13:51,140
ما السّبب؟

211
00:13:51,530 --> 00:13:53,360
...بسبب

212
00:13:54,360 --> 00:13:55,770
هذا

213
00:13:55,770 --> 00:13:57,000
!ما هذا؟

214
00:13:57,000 --> 00:14:01,150
جراد مشويّ. مع أنّ مُعظمهم جنادب

215
00:14:01,150 --> 00:14:03,410
!مـ-مقرف! لـ-لن آكل هذا

216
00:14:03,750 --> 00:14:05,680
لم أطلب منك ذلك

217
00:14:06,480 --> 00:14:09,450
سمعتُ بأنّه وقع تفشٍّ كبير للجنادب
في العام الفائت

218
00:14:09,900 --> 00:14:13,330
هل سمعتَ بتقارير عن أضرار حشرات
من القُرى الزراعيّة؟

219
00:14:15,040 --> 00:14:17,190
تلقّيتُ تلك التّقارير

220
00:14:17,190 --> 00:14:19,300
كانت القُرى الشّماليّة أكثر ما تضرّر

221
00:14:19,960 --> 00:14:23,300
لكن ليس لدرجة التسبُّب بوفيّات

222
00:14:23,870 --> 00:14:26,740
من أجل التّعويض عن ذلك، أرسلنا لهم
جزءاً من المؤونات

223
00:14:26,740 --> 00:14:29,180
المُخزَّنة في بينان-شو، المنطقة الجنوبيّة

224
00:14:29,480 --> 00:14:30,980
من بينان-شو؟

225
00:14:30,980 --> 00:14:31,810
أجل

226
00:14:32,340 --> 00:14:37,190
طلبنا المُساعدة من عشيرة بي، فقبِلوا بسخاء

227
00:14:37,720 --> 00:14:39,070
هكذا إذاً

228
00:14:39,070 --> 00:14:43,180
لكن يُمكن لأوبئة الحشرات أن تدوم سنوات عديدة

229
00:14:43,180 --> 00:14:46,660
إذا تكرّر ذلك، فستكون مُصيبة

230
00:14:47,020 --> 00:14:48,860
...صحيح، لكن

231
00:14:49,660 --> 00:14:55,170
يقول النّاس أحياناً بأنّ أوبئة الجراد تقع عندما يفشل
الإمبراطور في الحُكم بشكل صحيح

232
00:14:56,270 --> 00:15:01,290
خُرافات سخيفة بالتّأكيد، لكن في العام
...الّذي يلي تدمير عشيرة شي

233
00:15:01,290 --> 00:15:03,320
ماذا سيكون رأي النّاس؟

234
00:15:04,180 --> 00:15:09,180
الكُتُب المُتداولة في الشّوارع قد تبدأ
بنشر كلام مُعاكس تماماً

235
00:15:09,960 --> 00:15:13,060
أنا متأكّدة بأنّ فخامته جينشي يعي هذا أيضاً

236
00:15:13,060 --> 00:15:15,610
أوبئة الجراد هي حدثٌ طبيعيّ

237
00:15:16,040 --> 00:15:18,050
ماذا كنتِ لتفعلي؟

238
00:15:18,050 --> 00:15:23,440
إضرام نار لجذبها؟ وسحقها واحدة تِلو الأُخرى؟

239
00:15:23,440 --> 00:15:26,110
لهذا السّبب أبحث عن هذا

240
00:15:26,700 --> 00:15:31,390
تُرِكت هذه الكُتُب بواسطة الصّيدلانيّ
الّذي كان في الحصن قبلي

241
00:15:31,390 --> 00:15:34,580
سمعتُ بأنّ الصّيدلانيّ كان يبحث
عن طريقة لإيقاف أوبئة الجراد

242
00:15:35,250 --> 00:15:36,330
حقّاً؟

243
00:15:36,330 --> 00:15:39,250
لم يحتوِ هذا الكِتاب على أيّ شيء حول الجراد

244
00:15:39,510 --> 00:15:42,250
لا بُدّ من وجود مُجلّد حشرات ثانٍ

245
00:15:42,250 --> 00:15:44,800
أعتقد لا يزال موجوداً في الحصن

246
00:15:46,850 --> 00:15:49,970
،لا أعرف إلى أيّ مدى وصلَ فقي بحثه

247
00:15:49,970 --> 00:15:51,600
لكن أعتقد بأنّ الأمر يستحقّ إلقاء نظرة

248
00:15:53,220 --> 00:15:54,010
غاوشون

249
00:15:54,010 --> 00:15:58,020
أجل. سأحرص على أن نحصل
عليه في غضون أيّام قليلة

250
00:15:58,470 --> 00:16:01,760
حسناً، أوصلتُ الرّسالة على الأقلّ

251
00:16:04,430 --> 00:16:05,750
هل أنتَ مُرهَق؟

252
00:16:06,450 --> 00:16:07,210
ماذا؟

253
00:16:07,610 --> 00:16:11,240
أجل، لسبب ما. لكن أنا بخير

254
00:16:13,690 --> 00:16:16,450
سينهار إذا استمرّ هذا

255
00:16:17,360 --> 00:16:18,420
ما الأمر؟

256
00:16:18,980 --> 00:16:20,750
ينبغي أن ينام

257
00:16:21,170 --> 00:16:27,260
إذا كان مُتعَباً جدّاً، فيجدر بن أن يُعيّن
نائباً وينال قسطاً من الرّاحة

258
00:16:28,010 --> 00:16:31,320
مولايّ جينشي، لِمَ لا تنال قسطاً من الرّاحة؟

259
00:16:31,320 --> 00:16:32,970
لـ-لمَ هذا الكلام فجأة؟

260
00:16:32,970 --> 00:16:36,250
سأحضِّر لك سريراً فوراً. نَم قليلاً من فضلك

261
00:16:36,250 --> 00:16:37,180
هـ-هنا؟

262
00:16:37,480 --> 00:16:39,270
هل تُواجه مُشكلة في النّوم بمُفردك؟

263
00:16:41,270 --> 00:16:43,700
—أنا أمزح فحسب. انتظر رجاء

264
00:16:43,700 --> 00:16:45,440
هذا صحيح. لن أنام بمُفردي

265
00:16:48,900 --> 00:16:51,780
فهمت. أعتقد بأنّه يشعر بالوحدة

266
00:16:53,930 --> 00:16:57,390
فهمت. أمهلني لحظة من فضلك

267
00:16:59,470 --> 00:17:00,710
حقّاً؟

268
00:17:01,250 --> 00:17:03,420
أحتاج بعض الوقت للتّحضير

269
00:17:03,420 --> 00:17:04,420
أعلم

270
00:17:05,340 --> 00:17:07,510
ثلاثون دقيقة

271
00:17:07,510 --> 00:17:09,610
هذا كُلّ ما يتطلّبه الأمر؟

272
00:17:11,490 --> 00:17:12,800
هنا

273
00:17:13,180 --> 00:17:15,750
ارتح هنا رجاء

274
00:17:15,750 --> 00:17:19,040
العمل مُهمّ، لكن الرّاحة ضروريّة أيضاً

275
00:17:19,550 --> 00:17:23,770
إن رغبتَ في الاستحمام، فلدينا حمّام
عشبيّ جاهز في غرفة الحمّام

276
00:17:24,170 --> 00:17:26,270
من فضلك ارتدِ لِباس النّوم هذا

277
00:17:26,660 --> 00:17:27,460
حسناً

278
00:17:28,350 --> 00:17:30,490
،لم تعُد ابتسامة عذراء سماويّة

279
00:17:30,880 --> 00:17:33,480
لكن يبقى جميلاً من عالم آخر

280
00:17:36,690 --> 00:17:38,760
لن أنام لوحدي، صحيح؟

281
00:17:39,230 --> 00:17:40,210
هذا صحيح

282
00:17:40,510 --> 00:17:41,890
سأذهب للاستحمام

283
00:17:43,070 --> 00:17:44,090
من فضلك

284
00:17:53,630 --> 00:17:56,160
ما تلك الفتيات اللّواتي يرتدينَ لِباساً فاضحاً؟

285
00:17:56,160 --> 00:17:58,720
إنّهن مُدلِّكات مُحترفات، هل تكره التّدليك؟

286
00:18:00,430 --> 00:18:02,710
هل يمنحنَ خدمة تدليك حصراً فقط؟

287
00:18:02,710 --> 00:18:04,800
في أغلب الأوقات، وهناك المزيد

288
00:18:04,800 --> 00:18:06,580
لا يهمّ، لا أريد الاستحمام

289
00:18:06,580 --> 00:18:08,190
هل تحتاج مُساعدة في تبديل ملابسك؟

290
00:18:08,630 --> 00:18:09,990
أستطيع فعل ذلك بنفسي

291
00:18:16,540 --> 00:18:18,870
إنّه مفتول العضلات كعادته

292
00:18:19,190 --> 00:18:22,620
بالإضافة إلى كُلّ أعماله، يُخصّص
وقتاً للتّدريب كذلك

293
00:18:25,290 --> 00:18:26,190
من فضلك

294
00:18:26,950 --> 00:18:28,930
يُساعد على النّوم؟

295
00:18:29,760 --> 00:18:31,480
شراب مُنشِّط

296
00:18:34,950 --> 00:18:37,450
لماذا تُنشّطينني؟

297
00:18:37,450 --> 00:18:41,680
سمعتُ بأنّ هذه خير وسيلة لعلاج إعياء رجل

298
00:18:42,540 --> 00:18:44,860
هل تفهمين ما يعنيه هذا؟

299
00:18:45,310 --> 00:18:47,410
ما الّذي يعنيه غير ذلك؟

300
00:18:50,790 --> 00:18:55,200
رُبّما كان من غير المُلائم استعمال طريقة
مُباشرة، حتّى مع رجُل؟

301
00:18:55,580 --> 00:18:57,200
حسناً، فخامتك جينشي

302
00:18:57,200 --> 00:18:58,580
أجل

303
00:18:59,630 --> 00:19:00,950
...ما هو

304
00:19:01,300 --> 00:19:03,000
...المعذرة

305
00:19:04,830 --> 00:19:07,400
ما هو نوعك المُفضّل من النّساء؟

306
00:19:07,400 --> 00:19:08,380
ماذا؟

307
00:19:12,550 --> 00:19:13,510
...ما

308
00:19:15,630 --> 00:19:17,480
...هذا

309
00:19:18,250 --> 00:19:22,330
أخبرتني مولاتي سويرين بأنّك تُفضّل
الفتيات اللّواتي في مثل سنّك

310
00:19:22,330 --> 00:19:24,850
جميعهن عفيفات، لذا اطمئنّ من فضلك

311
00:19:26,390 --> 00:19:28,690
هل تلفت إحداهن إعجابك؟

312
00:19:28,980 --> 00:19:33,110
أنا مُرهق فحسب حقّاً. دعيني أنام أرجوكِ

313
00:19:33,110 --> 00:19:34,320
—حسناً، أيّ فتاة

314
00:19:34,320 --> 00:19:35,610
!أقصد ما أعنيه حرفيّاً

315
00:19:38,230 --> 00:19:40,110
هل ترغب في الاستمتاع بدلاً عنه؟

316
00:19:40,110 --> 00:19:43,830
زوجتي مُتحفِّظة جدّاً، وابنتي صعبة الإرضاء

317
00:19:44,080 --> 00:19:48,830
فهمت. عرض محظيّة على رجل مُتزوّج
أمر يصعب تحقيقه

318
00:19:49,170 --> 00:19:50,720
هل تعرفين ما هو شعور

319
00:19:50,720 --> 00:19:54,010
أن تقول ابنتي "أبي، أنت قذر. لا تستحمّ قبلي"؟

320
00:19:54,320 --> 00:19:55,780
أفهمك

321
00:19:56,190 --> 00:19:57,760
أقصد مشاعر الابنة

322
00:20:06,820 --> 00:20:09,550
حسناً، أستأذن بالانصراف

323
00:20:16,380 --> 00:20:18,660
بوسعكِ أن تغنّي لي تهويدةً على الأقلّ

324
00:20:30,960 --> 00:20:32,810
لستُ مُغنّية

325
00:20:32,810 --> 00:20:33,940
لا أُبالي

326
00:20:41,860 --> 00:20:48,400
نَم يا صغيري نَم

327
00:20:48,750 --> 00:20:55,190
أين هي؟ إنّها تبكي

328
00:20:56,060 --> 00:21:02,890
الطّيور الصّغيرة بريئة للغاية

329
00:21:03,510 --> 00:21:10,280
تُحلّق إلى مكان بعيد

330
00:21:10,770 --> 00:21:17,440
نَم يا صغيري نَم

331
00:21:17,840 --> 00:21:25,680
استرخِ اللّيلة، وأراك ثانية غداً

332
00:21:32,650 --> 00:21:34,670
يبدو مرتاحاً تماماً الآن

333
00:21:34,670 --> 00:21:38,350
.وقد أكلَ ثلاثة أطباق من العصيدة بعد الاستيقاظ
لا بُدّ أنّه بصحّةٍ جيّدة

334
00:21:38,350 --> 00:21:39,560
ماوماو

335
00:21:41,220 --> 00:21:42,820
بايرين

336
00:21:42,820 --> 00:21:45,280
لِمَ لا تقبلين ذلك فحسب؟

337
00:21:47,240 --> 00:21:49,060
لا يهمّ

338
00:22:06,540 --> 00:22:07,530
...استمتع رجاء

339
00:23:44,990 --> 00:23:59,920
الحلقة القادمة

