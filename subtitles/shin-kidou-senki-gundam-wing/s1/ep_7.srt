1
00:00:12,030 --> 00:00:15,320
مجرّد نبض تواصل جامح

2
00:00:15,530 --> 00:00:18,990
أقف في المطر الجارح

3
00:00:19,160 --> 00:00:22,620
أريد إظهار مشاعري المتّقدة الخالدة

4
00:00:22,750 --> 00:00:27,790
!عن طريق جسدي بالكامل اللّيلة

5
00:00:33,840 --> 00:00:40,680
أتشبّث بكتفيك المبلّلين لمنحك الدّفء والرّاحة

6
00:00:40,850 --> 00:00:48,020
ما الّذي تسعى إليه هذه الأصابع المرتعشة؟

7
00:00:48,650 --> 00:00:55,200
أريد حماية النّظرة الصّادقة في عينك

8
00:00:55,950 --> 00:01:02,750
مؤمنة بالحبّ الّذي سيُحيلُ الحزنَ قوّة

9
00:01:02,830 --> 00:01:06,370
مجرّد نبض تواصل جامح

10
00:01:06,500 --> 00:01:10,090
أقف في المطر الجارح

11
00:01:10,250 --> 00:01:13,670
أريد إظهار مشاعري المتّقدة الخالدة

12
00:01:13,800 --> 00:01:18,510
!عن طريق جسدي بالكامل اللّيلة

13
00:01:22,720 --> 00:01:24,950
غادر البشر الأرض بآمال عالية

14
00:01:24,950 --> 00:01:28,600
.ليبدؤوا حياة جديدة في مستعمرات الفضاء

15
00:01:30,020 --> 00:01:32,690
لكنّ تحالف اتّحاد الكرة الأرضيّة
...اكتسب قوّة عسكريّة

16
00:01:32,690 --> 00:01:39,030
واستولى على مستعمرة تلو الأخرى
.باسم العدالة والسّلام

17
00:01:40,780 --> 00:01:43,280
.العام 195 بعد المستعمرات

18
00:01:43,280 --> 00:01:45,850
.العمليّة نيزك

19
00:01:47,000 --> 00:01:50,500
،بغرض صدّ طغيان التّحالف
جلب ثوّار المستعرات

20
00:01:50,500 --> 00:01:54,750
ترسانات جديدة للأرض وقد
.موّهوها على أنّها شُهب

21
00:01:55,750 --> 00:02:00,590
.لكن علم المقرّ الرّئيسيّ للتّحالف بهذه العمليّة

22
00:02:00,970 --> 00:02:02,490
.كما توقّعت

23
00:02:02,490 --> 00:02:05,390
.هنالك آخرون يهاجمون منشآت أوز إضافة لي

24
00:02:07,100 --> 00:02:09,350
.أتمنّى لو أستطيع لقاءهم جميعًا

25
00:02:10,270 --> 00:02:11,900
.لا علاقة لي

26
00:02:26,750 --> 00:02:29,960
هذا تقرير قاعدة إدواردز الجديدة
.عن وصول المكّوك

27
00:02:30,540 --> 00:02:33,630
.وصلتنا أعداد معتبرة، بما فيها المركبات الأرضيّة

28
00:02:34,290 --> 00:02:35,250
.فهمت

29
00:02:36,050 --> 00:02:36,930
.شكرًا لكم

30
00:02:38,840 --> 00:02:43,300
نشرتُ إشاعات بدهاء تفيد أنّ كلّ الضّبّاط
مهمّين من منظّمة أوز

31
00:02:43,300 --> 00:02:45,720
.سيكونون في إدواردز الجديدة

32
00:02:45,720 --> 00:02:48,730
على الأقلّ سيكون خبر تواجدنا
.أنا وأنت هناك صحيحًا

33
00:02:49,600 --> 00:02:51,200
هل ستذهب وتقوم بدور الطّعم بنفسك؟

34
00:02:52,100 --> 00:02:54,610
.اكتمل التّموضع بنسبة مائة بالمائة

35
00:02:54,610 --> 00:02:56,880
.لن نحتاج لتوسيعه أكثر من ذلك

36
00:02:57,550 --> 00:02:59,020
.زيكس في نايروبي إذًا

37
00:02:59,740 --> 00:03:01,700
ألا يجدر بنا استعماله لشيء أكثر أهمّيّة؟

38
00:03:02,450 --> 00:03:05,490
.ليس لدينا الكثير من جنود أوز في نايروبي

39
00:03:05,490 --> 00:03:07,150
.نتوقّع نشوب معركة حامية هناك

40
00:03:07,620 --> 00:03:08,620
.فهمت

41
00:03:12,750 --> 00:03:17,420
سيكفّ النّاس عن الشّكّ وسيكرّسون
.حياتهم للمستقبل الجديد

42
00:03:18,510 --> 00:03:20,050
.قبلت بالمهمّة

43
00:03:20,840 --> 00:03:24,390
.سيجتمع قادة أوز في إدواردز الجديدة

44
00:03:28,220 --> 00:03:30,820
!اختفى تروا ثانية؟

45
00:03:30,820 --> 00:03:33,680
.نعم، لكنّه قال أنّه سيعود قريبًا

46
00:03:33,680 --> 00:03:37,060
!لا ينفكّ ذلك المشاكس على الرّحيل

47
00:03:37,060 --> 00:03:40,110
ما كنتُ في العادة لأتردّد
.في طرد شخص مثله

48
00:03:40,110 --> 00:03:42,850
.لكنّه بارع للغاية ولا يمكنك التّخلّص منه

49
00:03:43,320 --> 00:03:44,360
!سُحقًا

50
00:03:44,360 --> 00:03:46,540
سأجعله يعمل بجهد أكثر لقاء
!المال الّذي يتقاضاه عند عودته

51
00:03:48,410 --> 00:03:52,370
تروا، لماذا تختفي هكذا دائمًا؟

52
00:04:00,590 --> 00:04:04,840
لا أصدّق أنّ السّيّد كاتر غادر
.فجأة إلى منتجع بمفرده

53
00:04:04,840 --> 00:04:06,340
.ما يزال يافعًا

54
00:04:06,340 --> 00:04:10,440
لا بدّ أنّه كان متعبًا من رؤية
.وجوه رجال عجائز مثلنا

55
00:04:11,080 --> 00:04:11,930
!أيّها الأحمقان

56
00:04:12,430 --> 00:04:14,640
ترَكنا السّيّد كاتر هنا

57
00:04:14,640 --> 00:04:17,770
.ليذهب في مهمّة ما بمفرده

58
00:04:17,770 --> 00:04:18,420
!مستحيل

59
00:04:18,420 --> 00:04:19,820
أأنت جادّ أيّها القائد؟

60
00:04:19,820 --> 00:04:23,570
.كان قلقًا على سلامتنا، لذلك تركنا خلفه

61
00:04:23,570 --> 00:04:26,410
!لكنّ ذلك سيعرّض حياة السّيّد كاتر للخطر

62
00:04:26,660 --> 00:04:30,780
.لم أستطع رفض اهتمامه بسلامتنا

63
00:04:30,780 --> 00:04:34,870
.لكنّي أتمنّى لو تطلب النّصح منّي يا سيّد كاتر

64
00:04:41,920 --> 00:04:44,210
هل هذا فندق ستارلي في سان فرانسيسكو؟

65
00:04:44,210 --> 00:04:46,010
.أرغب في حجز غرفة

66
00:04:46,010 --> 00:04:48,370
أنا وحدي، فهل هذه مشكلة؟

67
00:04:56,670 --> 00:04:57,650
!هل كان...؟

68
00:05:04,230 --> 00:05:05,970
!مرحبًا! التقينا ثانية

69
00:05:08,950 --> 00:05:10,860
.مِن الطّريف أنّنا في نفس المكان ثانية

70
00:05:11,450 --> 00:05:13,080
.سأقوم بهذا وحدي

71
00:05:13,080 --> 00:05:14,350
.وكذلك أنا

72
00:05:14,350 --> 00:05:16,620
.لكن سيكون الوضع أفضل إن ساعدنا بعضنا

73
00:05:16,620 --> 00:05:17,360
أتظنّ ذلك؟

74
00:05:18,080 --> 00:05:19,420
!اثنان أفضل من واحد دائمًا

75
00:05:29,850 --> 00:05:31,310
!هجوم العدوّ

76
00:05:33,270 --> 00:05:34,730
!هجوم العدوّ؟

77
00:05:44,790 --> 00:05:45,780
مقصورة الشّحن؟

78
00:05:50,320 --> 00:05:51,160
...هذه

79
00:05:56,540 --> 00:05:58,870
.مرحبًا! حمّل مقاتلتك أيضًا

80
00:05:59,380 --> 00:06:01,210
.سآتي وأتولّى أمر مقصورة الطّيّار

81
00:06:01,210 --> 00:06:02,210
!ديو

82
00:06:03,090 --> 00:06:06,300
لن أسمح بفشل المهمّة
!هذه المرّة بكلّ تأكيد

83
00:06:06,300 --> 00:06:07,630
فما رأيك أن تثق بي قليلاً؟

84
00:06:08,280 --> 00:06:09,970
.افعل ما يحلو لك

85
00:06:10,260 --> 00:06:11,760
.يا له من إنسان

86
00:06:11,760 --> 00:06:13,770
.لقد تذكّر اسمي قبل كلّ شيء

87
00:06:26,570 --> 00:06:29,900
حسنًا، ستكون هذه معركة مميّزة، صحيح؟

88
00:06:29,900 --> 00:06:33,410
لا أظنّك تفهم ما مدى أهمّيّة
.هذه المهمّة

89
00:06:33,410 --> 00:06:34,930
.بالطّبع أفهم

90
00:06:34,930 --> 00:06:38,310
.حانت أخيرًا فرصتنا لتدمير منظّمة أوز

91
00:06:38,310 --> 00:06:39,960
.الأمر مختلف هذه المرّة

92
00:06:39,960 --> 00:06:42,420
.سوف نقضي على كلّ قادة أوز

93
00:06:42,840 --> 00:06:45,380
.نعم. ثمّ سأتمكّن من العودة للفضاء

94
00:07:01,730 --> 00:07:06,070
في قاعدة إدواردز الجديدة، سيجتمع
قادة تحالف المجال الأرضيّ المتّحد

95
00:07:06,070 --> 00:07:11,570
بمن فيهم المشير نوفينتا كقائد عامّ والجنرال
،سيبتم، قائد قوّات التّحالف الفضائيّة

96
00:07:11,570 --> 00:07:18,000
،والجنرال فينتي، قائد قوّات التّحالف الأرضيّة
.وآخرون من كبار القادة في مؤتمر

97
00:07:18,660 --> 00:07:25,590
وبالطّبع، سيحضر العقيد تيريز
.والمقدّم ليدي أن من المميّزين أيضًا

98
00:07:26,670 --> 00:07:30,010
لكنّ تيريز نشر معلومات مزيّفة
في العالم بأسره بشكل سرّيّ

99
00:07:30,010 --> 00:07:37,970
تقول أنّ هذا الاجتماع هو اجتماع عامّ
.لكبار ضبّاط أوز بل قادة التّحالف

100
00:07:38,470 --> 00:07:40,360
.لنرَ كيف سيُثمر المستقبل

101
00:07:40,930 --> 00:07:43,850
.سأسلك أيّ طريق تقرّره

102
00:07:44,190 --> 00:07:47,980
.إنّ نجاح خططي للإصلاح منوط بالتّحالف

103
00:07:48,770 --> 00:07:49,940
.ذلك ما سيحدّد المستقبل

104
00:07:54,320 --> 00:07:55,530
.أيّها الملازم زيكس

105
00:07:55,530 --> 00:07:58,740
.تطلب قاعدة نايروبي تقديم معلومات عنّا

106
00:07:58,740 --> 00:08:00,580
أخبرهم أنّنا نقوم بمناورات تدريبيّة

107
00:08:00,580 --> 00:08:03,920
.ونُجري محاكاة لمعركة جوّيّة فوق مومباسا

108
00:08:04,330 --> 00:08:04,880
!عُلم

109
00:08:05,420 --> 00:08:06,540
.نوين

110
00:08:06,540 --> 00:08:09,340
قد تجعلك هذه المعركة
.تشعرين بالسّوء لاحقًا

111
00:08:09,340 --> 00:08:11,400
.أثق بك يا زيكس

112
00:08:11,400 --> 00:08:15,800
.إن قلتَ أنّه هجوم مهمّ، فسأقاتل

113
00:08:16,760 --> 00:08:18,660
...التّحالف وأوز

114
00:08:18,660 --> 00:08:21,720
لن يتغيّر العالم للأفضل إن حلّ
.أحدهما محلّ الآخر

115
00:08:21,720 --> 00:08:25,150
فلماذا علينا أن نقاتل من الأساس يا زيكس؟

116
00:08:26,730 --> 00:08:32,150
تَشكّل التّحالف لردع القوّة العسكريّة
.لبلدان مختلفة حول العالم

117
00:08:32,150 --> 00:08:36,990
.لكنّنا أمسينا قوّة عسكريّة معتبرة أيضًا

118
00:08:37,570 --> 00:08:43,370
أنفقنا الكثير من المال والجهد على
.السّباق للتّسلّح وتطوير الأسلحة

119
00:08:43,710 --> 00:08:47,000
لا يجب على التّحالف أن يتّجه
.صوب ذلك الهدف

120
00:08:48,790 --> 00:08:49,920
علينا إذًا التّقليل من قوّاتنا؟

121
00:08:50,540 --> 00:08:52,860
.ستكون تلك البداية فحسب

122
00:08:52,860 --> 00:08:57,140
هدفنا الرّئيسيّ هو نزع السّلاح
.من جانب واحد

123
00:09:00,470 --> 00:09:01,510
.أوافق هذا الرّأي

124
00:09:01,510 --> 00:09:02,850
!جنرال فينتي؟

125
00:09:02,850 --> 00:09:05,180
.نزفنا دماءً جميعنا في مرحلة أو أخرى

126
00:09:05,180 --> 00:09:09,830
لم نستطع تجنّب ذلك لبناء تحالف
.مثاليّ على أرض الواقع

127
00:09:09,830 --> 00:09:13,730
.لكن تغيّرت أهدافنا لسبب ما

128
00:09:13,730 --> 00:09:16,820
.حان الوقت لنضع حدًّا لعصر إراقة الدّماء هذا

129
00:09:17,700 --> 00:09:19,780
.ليتنا نستطيع إيقاف الأمر

130
00:09:19,780 --> 00:09:23,040
لكن كيف تنصح أن نتعامل
مع الحوادث الأخيرة؟

131
00:09:23,040 --> 00:09:27,330
كنّا عُرضة لهجوم بِذل الغاندانيوم
.المتنقّلة المصنوعة في الفضاء

132
00:09:28,170 --> 00:09:31,880
تسبّبت البذل غير قابلة للتّدمير
.في أزمة فعليّة للأرض

133
00:09:32,460 --> 00:09:35,010
ما رأي المميّزين في ذلك؟
.فلقد قاتلتموهم من قبل

134
00:09:35,800 --> 00:09:38,840
نعتقد أنّ المستعمرات قد صنعتها
.لأسباب تدميريّة محضة

135
00:09:40,890 --> 00:09:41,850
سيّد تيريز؟

136
00:09:42,850 --> 00:09:45,520
.كلّ ما نحتاج إليه الآن هو ممثّل من التّحالف

137
00:09:45,520 --> 00:09:47,140
ممثّل؟

138
00:09:47,140 --> 00:09:50,730
.شخص ما ليوضّح المشاعر الحقيقيّة للتّحالف

139
00:09:51,820 --> 00:09:55,820
من الطّبيعيّ بالنّسبة للمستعمرات
.أن تشعر بالقلق ناحيتنا

140
00:09:56,360 --> 00:10:02,160
ولتدارك هذا، علينا فتح مجال
.الحوار مع المستعمرات

141
00:10:02,660 --> 00:10:03,990
.أوافقك الرّأي

142
00:10:03,990 --> 00:10:07,620
لنبدأ صفحة جديدة في التّاريخ
.من خلال تحاورنا

143
00:10:08,170 --> 00:10:10,520
.الأمر ليس بين المستعمرات فحسب

144
00:10:10,520 --> 00:10:15,090
علينا أن نركّز انتباهنا أيضًا على
.المزيد من الحوار بين بلدان العالم

145
00:10:19,010 --> 00:10:22,090
لـ-لكن ماذا عن مشكلة تلك البذل المتنقّلة؟

146
00:10:22,090 --> 00:10:24,680
،بمجرّد أن يفهموا رغبتنا في السّلام

147
00:10:24,680 --> 00:10:27,700
لن يعود هنالك أيّ سبب لدى
.المستعمرات للتّسبّب في أيّ دمار

148
00:10:27,700 --> 00:10:29,060
.لنتحاور

149
00:10:29,060 --> 00:10:32,520
أنا واثق أنّنا سنستطيع لعثور
.على الطّريق الصّحيح مرّة أخرى

150
00:10:33,440 --> 00:10:34,330
.كما توقّعت

151
00:10:35,020 --> 00:10:37,550
.يوشك المستقبل أن يسلك طريقًا خاطئًا

152
00:10:37,550 --> 00:10:38,280
هل نذهب؟

153
00:10:38,280 --> 00:10:41,070
.كلاّ، لننتظر وصول آخِر الممثّلين

154
00:10:41,450 --> 00:10:45,620
والآن، أودّ التّركيز في تفاصيل
.مفاوضات السّلام

155
00:10:45,870 --> 00:10:47,000
...سنبدأ

156
00:10:48,540 --> 00:10:50,580
!ما الّذي يحدث هنا؟

157
00:10:50,580 --> 00:10:52,670
!أيّها المشير! نتعرّض للهجوم

158
00:10:52,670 --> 00:10:54,840
!تتعرّض هذه القاعدة للهجوم

159
00:10:54,840 --> 00:10:55,710
!ماذا؟

160
00:10:57,630 --> 00:10:58,300
...هؤلاء

161
00:11:18,650 --> 00:11:21,320
.خطّ الدّفاع هذا ليس كالبقيّة

162
00:11:24,070 --> 00:11:25,390
.هنالك المزيد منهم بعشر مرّات

163
00:11:25,390 --> 00:11:27,450
.أكثر بكثير ممّا توقّعنا

164
00:11:27,450 --> 00:11:29,660
!لا مجال للعودة

165
00:11:48,140 --> 00:11:49,930
!أخذنا وقتًا طويلاً في اختراقهم

166
00:11:54,730 --> 00:11:56,820
!لنتقدّم بعزم أكبر

167
00:12:14,250 --> 00:12:16,500
.ليدي، وصل جميع الممثّلون

168
00:12:19,440 --> 00:12:20,050
!حالاً

169
00:12:23,380 --> 00:12:24,510
!أيّها الملازم زيكس

170
00:12:24,510 --> 00:12:27,300
!تلقّينا أوامر للبدء في عمليّة الفجر

171
00:12:27,300 --> 00:12:29,350
!عُلم، لتبدأ كلّ الوحدات بالنّزول

172
