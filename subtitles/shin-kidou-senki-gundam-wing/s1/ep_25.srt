1
00:01:24,560 --> 00:01:25,390
.كاتر

2
00:01:26,140 --> 00:01:27,020
ما الّذي يحدث؟

3
00:01:27,730 --> 00:01:29,560
.أخبر الآخرين من أجلي

4
00:01:30,270 --> 00:01:31,980
.أخبرهم أن يظلّوا بعيدين

5
00:01:32,650 --> 00:01:33,820
...وإلاّ

6
00:01:34,490 --> 00:01:35,950
.فسأقتلهم

7
00:01:37,910 --> 00:01:40,530
!أخبرتك ألاّ تقترب أكثر

8
00:01:43,580 --> 00:01:45,540
!أهذا كلّ ما لديك لتقوله؟

9
00:01:52,960 --> 00:01:57,630
،إن كان كلّ شيء قد جُنّ
.فسأقاتل مؤمنًا بنفسي فقط

10
00:01:58,260 --> 00:02:01,220
.كاتر، سوف أقتلك

11
00:03:17,420 --> 00:03:19,170
.لن يصمد الدّرع أكثر

12
00:03:21,680 --> 00:03:22,510
...هيرو

13
00:03:23,720 --> 00:03:25,930
لماذا نقاتل بعضنا؟

14
00:03:26,760 --> 00:03:28,930
.لقد انضمّت المستعمرات إلى أوز

15
00:03:29,730 --> 00:03:31,600
.المستعمرات عدوّنا

16
00:03:32,770 --> 00:03:36,570
.إنّها عدوّكما أيضًا الآن يا تروا وهيرو

17
00:03:37,280 --> 00:03:39,570
.فقد سكّان الفضاء صوابهم

18
00:03:39,570 --> 00:03:41,950
.لهذا السّبب سأدمّر كلّ شيء

19
00:03:42,570 --> 00:03:44,780
هذا طبيعيّ، صحيح يا هيرو؟

20
00:04:00,010 --> 00:04:01,130
.ستموت يا هيرو

21
00:04:02,180 --> 00:04:04,550
.لكنّي لا أريد هزيمة حلفائي

22
00:04:05,220 --> 00:04:07,810
.رجاءً يا هيرو، اهرب في الحال

23
00:04:09,100 --> 00:04:10,640
!هل تستمع لي؟

24
00:04:11,730 --> 00:04:12,560
.كاتر

25
00:04:13,350 --> 00:04:14,980
.لن أغادر

26
00:04:14,980 --> 00:04:16,860
.هنالك مستعمرة تحتاج للدّفاع

27
00:04:37,840 --> 00:04:38,630
.هيرو

28
00:04:40,840 --> 00:04:44,220
.ما عدت أطيق تلك المستعمرة

29
00:04:47,350 --> 00:04:52,770
فقدنا الاتّصال ببذلة فاييت الّتي يقودها تورا
!بارتون ووحدة الأسد، الّتي تقاتل الغاندام

30
00:04:53,850 --> 00:04:56,230
قد تكون الوحدة بأكملها بما في
.ذلك ميركوري، قد أبيدت بالكامل

31
00:04:56,940 --> 00:04:57,690
والمستعمرة؟

32
00:04:58,980 --> 00:05:00,820
هل ما تزال المستعمرة هناك؟

33
00:05:00,820 --> 00:05:03,650
.نعم، لقد نجت من أيّ ضرر يُذكر

34
00:05:04,150 --> 00:05:06,570
.هذا يعني أنّ المعركة ما تزال متواصلة

35
00:05:07,490 --> 00:05:12,750
سوف يقاتل ربّان الغاندام الوفيّ
.لحماية المستعمرات

36
00:05:12,750 --> 00:05:15,620
.نأمل أن يستطيعوا إيقاف الغاندام الجديدة

37
00:05:16,330 --> 00:05:18,920
.وصلتنا صور من السّفينة الأمّ لوحدة الأسد

38
00:05:21,460 --> 00:05:22,210
.جيّد

39
00:05:22,210 --> 00:05:25,340
أرسلوا هذه الآن إلى مهندسي الغاندام
.في القاعدة القمريّة

40
00:05:25,340 --> 00:05:27,590
علينا أن نكون قادرين على اكتشاف
.شيء ما منهم

41
00:05:27,590 --> 00:05:29,970
...لكن أيّتها العقيد

42
00:05:29,970 --> 00:05:32,640
.لا يمكننا الاتّصال بالقاعدة القمريّة حاليًّا

43
00:05:32,640 --> 00:05:33,470
!ماذا؟

44
00:05:37,190 --> 00:05:38,310
!يا رئيس المهندسين توباروف

45
00:05:38,310 --> 00:05:41,570
تلقّينا أوامر من حصن بالج بإعادة
.تشغيل الاتّصالات

46
00:05:42,190 --> 00:05:43,650
.لا تهتمّ

47
00:05:43,650 --> 00:05:49,030
علينا اتّباع الأوامر من الدّوق ديرمايل
.لتسريع تصنيع الدُّمى المتنقّلة

48
00:05:49,990 --> 00:05:53,740
.يبدو أنّ هنالك بعض الاضطرابات داخل رومفلر

49
00:05:54,580 --> 00:05:56,830
.لا يمكن أن نثق في النّاس

50
00:05:56,830 --> 00:06:00,580
نحن ندخل عصرًا ستكون فيه الدّمى
.المتنقّلة محاربينا الجدد

51
00:06:02,300 --> 00:06:05,510
تبدون هادئين أيّها العجائز نظرًا
إلى أنّ الوقت لن يطول

52
00:06:05,510 --> 00:06:09,300
.قبل أن ينفد الهواء ونبدأ بفقدان وعينا

53
00:06:09,800 --> 00:06:13,010
.لم نحصل حتّى على انتقامنا من أوز

54
00:06:13,010 --> 00:06:15,180
.يا لها من طريقة سيّئة لنموت بها

55
00:06:15,180 --> 00:06:20,270
أتمنّى لو أمكنني رؤية تلك
.الغاندام الجديدة أيضًا

56
00:06:21,020 --> 00:06:25,650
.لم نُكمل إنهاء تحديث منجل الموت وشينلونغ

57
00:06:25,650 --> 00:06:27,280
.يا للخسارة

58
00:06:28,570 --> 00:06:30,450
.ذلك ما كنتُ سأقوله

59
00:06:40,290 --> 00:06:43,500
.ما كنتُ لأعتقد أبدًا أنّي سأموت هكذا

60
00:06:47,510 --> 00:06:49,550
.أخبرني يا ووفي

61
00:06:49,550 --> 00:06:53,050
بذلة منجل الموت خاصّتي تبدو رائعة، صحيح؟

62
00:06:53,640 --> 00:06:56,890
!كنتُ لأدمّر أوز بهذه في وقت وجيز

63
00:06:57,890 --> 00:06:59,020
ما الخطب؟

64
00:06:59,730 --> 00:07:01,480
هل متّ سلفًا؟

65
00:07:02,060 --> 00:07:03,610
.يا ووفي

66
00:07:03,610 --> 00:07:05,650
.لا تذهب وتتركني

67
00:07:05,650 --> 00:07:07,690
.ابق معي حتّى النّهاية

68
00:07:10,450 --> 00:07:13,320
.توقّفَ عن التّنفّس بالكامل

69
00:07:13,320 --> 00:07:15,530
.إنّه في وضع حياة معلّقة

70
00:07:16,330 --> 00:07:19,500
.هذا الشّخص لا يصدّق

71
00:07:19,500 --> 00:07:21,580
.إنّه يأبى الاستسلام

72
00:07:24,500 --> 00:07:26,250
.هذا منطقيّ تمامًا

73
00:07:26,250 --> 00:07:28,300
من قد يرغب في الموت هكذا؟

74
00:07:29,510 --> 00:07:30,970
...الغاندام

75
00:07:31,680 --> 00:07:35,600
.لا يجب على الغاندام أن تخسر الآن

76
00:07:44,770 --> 00:07:46,520
.كنتُ لأطلب منك أن تخرج من بذلتك المتنقّلة

77
00:07:47,270 --> 00:07:48,940
.لكنّك ما كنتَ لتفعل ذلك

78
00:07:49,530 --> 00:07:51,900
.لذلك سأضطرّ لقتلك فحسب

79
00:07:52,360 --> 00:07:54,240
.باشر بذلك إذًا

80
00:07:54,240 --> 00:07:56,620
.لن أقف هنا وأثرثر مع العدوّ

81
00:07:57,740 --> 00:07:59,330
.وداعًا يا هيرو

82
00:08:11,340 --> 00:08:12,220
.كاتر

83
00:08:13,050 --> 00:08:16,140
لماذا لا تدرك فداحة الخطأ الّذي ترتكبه؟

84
00:08:16,760 --> 00:08:17,850
!تروا

85
00:08:18,510 --> 00:08:20,850
.لا طائل من هذه المعركة

86
00:08:29,070 --> 00:08:30,400
!اهرب يا تروا

87
00:08:30,400 --> 00:08:31,440
!بذلة فاييت ستنفجر

88
00:08:32,030 --> 00:08:33,240
.هكذا إذًا

89
00:08:33,740 --> 00:08:34,860
.هذه هي النّهاية

90
00:08:38,870 --> 00:08:40,040
!تروا

91
00:08:43,000 --> 00:08:44,210
!كلاّ يا هيرو

92
00:08:44,210 --> 00:08:45,170
!أنقذ تروا

93
00:08:58,140 --> 00:08:58,850
!تروا

94
00:09:01,310 --> 00:09:02,520
.كاتر

95
00:09:02,520 --> 00:09:06,060
.لا يهمّ كيف انضّمت المستعرات إلى أوز

96
00:09:06,690 --> 00:09:10,360
علينا أن نتذكّر دائمًا أنّ ذلك علامة
.على نهاية الحرب

97
00:09:11,230 --> 00:09:15,030
.ذلك يعني أيضًا أنّ مهمّاتنا قد انتهت

98
00:09:16,240 --> 00:09:19,240
من المؤسف أنّ المستعمرات
الّتي قاتلنا من أجلها

99
00:09:19,240 --> 00:09:22,040
.قد غيّرت وجهات نظرها

100
00:09:22,660 --> 00:09:24,750
.لكنّ ذلك ما يحدث في الحروب

101
00:09:24,750 --> 00:09:26,250
.علينا القبول بذلك

102
00:09:27,330 --> 00:09:29,880
السّؤال الوحيد الّذي يطرح نفسه
.هو ماذا يحدث للجنود

103
00:09:30,590 --> 00:09:33,210
.ما الّذي يحدث داخل قلوبنا

104
00:09:34,170 --> 00:09:39,350
،بالنّسبة لنا نحن طيّارو الغاندام
.فقد تدرّبنا بشكل مثاليّ للغاية كجنود

105
00:09:40,300 --> 00:09:42,720
،عندما نقدّم كلّ شيء في المعركة

106
00:09:42,720 --> 00:09:46,310
نبدأ في التّفكير أنّ بإمكاننا
.تغيير الوقت وحدنا

107
00:09:47,440 --> 00:09:50,360
كاتر، لست الوحيد الّذي يشعر
.بتلك الطّريقة

108
00:09:50,360 --> 00:09:51,690
.جميعنا كذلك

109
00:09:52,440 --> 00:09:56,360
لكن كلّما كنت طيّبًا، زاد الثّمن
.الّذي عليك أن تدفعه

110
00:09:57,110 --> 00:10:00,780
.علينا القتال بين أنفسنا، داخل قلوبنا

111
00:10:00,780 --> 00:10:04,250
وعلينا أن نكون صارمين للوصول
.للاستنتاجات الصّحيحة

112
00:10:05,040 --> 00:10:08,250
حتّى إن عنى ذلك أنّ معاركنا
.حتّى الآن كانت بلا معنى

113
00:10:08,710 --> 00:10:10,500
.علينا الاعتراف بالحقائق

114
00:10:12,130 --> 00:10:16,170
.أصبحنا نحن الخمسة جنودًا بلا فائدة

115
00:10:17,510 --> 00:10:20,430
.لذلك يا كاتر، لنتقبّل الأمر

116
00:10:21,220 --> 00:10:23,970
.عُد ذلك الشّخص الطّيّب الّذي كنتَه في السّابق

117
00:10:25,350 --> 00:10:29,900
.آمل فقط أن يدفعك شيء ما لتهدأ

118
00:10:29,900 --> 00:10:31,480
...أن يدفعك شيء ما

119
00:10:36,150 --> 00:10:37,110
!تروا

120
00:10:41,870 --> 00:10:43,370
!اتركني يا هيرو

121
00:10:43,370 --> 00:10:44,410
!سوف يموت تروا

122
00:10:46,120 --> 00:10:47,250
.وأنت من ستكون قد قتلتَه

123
00:10:48,580 --> 00:10:49,460
...هيرو

124
00:10:55,000 --> 00:10:56,460
.لقد فقدتَ صوابك

125
00:10:57,050 --> 00:10:58,170
.سوف أقتلك

126
00:10:59,300 --> 00:11:01,680
.أسرع واقتلني إذًا

127
00:11:01,680 --> 00:11:03,470
!ثمّ أسرع لإنقاذ تروا

128
00:11:03,470 --> 00:11:06,140
!يا لها من طريقة قتال تعزوها الحماسة

129
00:11:06,890 --> 00:11:09,640
!أعتقد أنّ موت تروا كان هباءً لا غير

130
00:11:17,740 --> 00:11:18,860
.كاتر

131
00:11:18,860 --> 00:11:21,070
...سوف... أقوم

132
00:11:21,660 --> 00:11:22,660
.بقتلك

133
00:11:25,580 --> 00:11:26,490
.هيرو

134
00:11:27,240 --> 00:11:28,450
!هيرو

135
00:11:36,960 --> 00:11:41,430
.لا تقسو على كاتر كثيرًا يا هيرو

136
00:11:51,730 --> 00:11:55,360
،بقوّة مؤسّسة رومفلر الماليّة

137
00:11:55,360 --> 00:11:58,280
أمست ثورة المهارات التّكنولوجيّة
.في الفضاء ممكنة

138
00:12:02,820 --> 00:12:05,570
،بصفتنا الطّبقة الحاكمة المستقبليّة
سوف ننشر الدّمى المتنقّلة

139
00:12:05,570 --> 00:12:08,990
.في مناطقّ النّزاع في كلّ بلد

140
00:12:08,990 --> 00:12:11,960
بالتّالي أيّها السّادة، سنظهر للعالم بأسره

141
00:12:11,960 --> 00:12:16,460
.مدى قوّتنا وسنفرد النّظام فيه

142
00:12:17,090 --> 00:12:22,630
ألم يحن الأوان بعد لنعيد إنشاء عهد
يرتكز على التّقاليد والشّكليّات

143
00:12:22,630 --> 00:12:25,180
!لنتمكّن من حكم العالم كما يجب؟

144
00:12:33,230 --> 00:12:35,650
.تيريز، إنّ أوز تعتمد عليك

145
00:12:37,360 --> 00:12:38,690
.أيّها الدّوق ديرمايل

146
00:12:38,690 --> 00:12:42,610
لا يمكنني دعم الطّريق الّذي تسلكه
.مؤسّسة رومفلر حاليًّا

147
00:12:43,030 --> 00:12:43,820
!ماذا؟

148
00:12:44,450 --> 00:12:46,410
.أمست التّقاليد أثرًا من الماضي

149
00:12:46,410 --> 00:12:50,540
إنّها تاريخ التّعاطف الّذي بُني
.على مشاعر النّاس الحقيقيّة

150
00:12:50,990 --> 00:12:56,000
أعترف أنّ القتال في الحروب
.يمكن أن يكون جميلاً بالفعل

151
00:12:56,000 --> 00:12:58,290
وأرغب أيضًا في الإعراب عن
ندمي على الأرواح

152
00:12:58,290 --> 00:13:01,300
الّتي فقدناها بجذب انتباهكم
.لِكَم أنّ حياة المرء لا تقدّر بثمن

153
00:13:02,090 --> 00:13:06,590
أعتقد أنّ ما تحتاجه البشريّة ليس النّصر المطلق

154
00:13:06,590 --> 00:13:09,810
.بل سلوكًا وأسلوبًا معيّنًا في القتال

155
00:13:10,260 --> 00:13:15,190
أخشى أنّ عهد الأسلحة الخالية من
الحياة المسمّاة الدّمى المتنقّلة

156
00:13:15,190 --> 00:13:20,770
أو عهد رومفلر بعبارات أخرى، قد يكون
.مصدر حرج لأجيال المستقبل

157
00:13:21,320 --> 00:13:28,780
اعتدتُ الاعتقاد أنّ مُثُل سكّان المستعمرات
كنهجهم المسالم الجدير بالثّناء

158
00:13:28,780 --> 00:13:33,500
كان مجرّد شكاوى مثيرة للشّفقة
.وليدة جهلهم للتّقاليد

159
00:13:34,500 --> 00:13:36,330
.يا منجل الموت

160
00:13:36,330 --> 00:13:38,210
.لا تستسلمي بسهولة

161
00:13:38,710 --> 00:13:40,790
ستكونين بخير، صحيح؟

162
00:13:41,380 --> 00:13:43,380
.أوشك بدأ الاختبار الثّاني

163
00:13:54,140 --> 00:13:59,230
!سُحقًا

164
00:14:00,940 --> 00:14:01,570
ما هذا؟

165
00:14:03,610 --> 00:14:04,690
...هذه الأشياء اللاّمعة

166
00:14:05,690 --> 00:14:06,780
.إنّها دموعي

167
00:14:08,360 --> 00:14:10,530
،لكن من تلك الظّروف

168
00:14:10,530 --> 00:14:13,660
.وُلد محاربون جدد تجاوزوا حتّى مُثُلي

169
00:14:14,290 --> 00:14:16,790
.أنا أقصد طيّاري الغاندام بكلامي

170
00:14:19,120 --> 00:14:20,080
!أبي؟

171
00:14:20,080 --> 00:14:21,710
!أبي

172
00:14:25,760 --> 00:14:28,300
أنت تخشى الموت، صحيح؟

173
00:14:29,130 --> 00:14:31,800
!إذًا ما كان عليك أن تقاتل من الأساس

174
00:14:33,310 --> 00:14:38,940
تبدو التّقاليد مبهمة إلى جانب
.مشاعرهم النّقيّة

175
00:14:39,440 --> 00:14:41,480
،من وجهة نظر تاريخيّة

176
00:14:41,480 --> 00:14:46,570
فإنّ المحاربين الّذين فقدوا ما يحمونه
.وتعرّضوا للخيانة، يُعتبرون خاسرين

177
00:14:46,570 --> 00:14:48,950
.لكنّهم لا يدركون ذلك

178
00:14:48,950 --> 00:14:53,740
ليس ذلك فحسب، لكنّهم احتفظوا
.بإرادة قويّة لمواصلة القتال

179
00:14:56,620 --> 00:15:01,120
أقوم بكلّ ما في وسعي في حالة حدوث
.شيء خارج المألوف" بالفعل"

180
00:15:10,220 --> 00:15:14,720
،إن كان كلّ شيء قد جُنّ
.فسأقاتل مؤمنًا بنفسي فقط

181
00:15:15,680 --> 00:15:19,350
عواطف من يتّسمون بالجمال
.كانت مليئة دائمًا بالحزن

182
00:15:19,350 --> 00:15:22,690
وشرف التّقاليد يختفي بين أصداء
.صرخة الضّعفاء

183
00:15:23,060 --> 00:15:28,280
مكانة المنتصرين في الحرب ستتهاوى
،في التّاريخ ليصبوا خاسرين

184
00:15:28,280 --> 00:15:30,990
.وحينها فقط يمكنهم إنشاء طاقة جديدة

185
00:15:31,740 --> 00:15:33,570
تيريز، ما الّذي ترمي إليه؟

186
00:15:34,410 --> 00:15:37,290
.أريد أن أكون خاسرًا

187
00:15:37,870 --> 00:15:41,920
تقول أنّك تريد من مقرّ رومفلر الرّئيسيّ

188
00:15:41,920 --> 00:15:45,210
أن يأخذ قيادة أوز منك؟

189
00:15:50,880 --> 00:15:54,090
.لا نرغب في إراقة أيّة دماء

190
00:15:54,090 --> 00:15:56,470
كما أنّ علينا أخذ خدمتك لنا
.في عين الاعتبار

191
00:15:56,470 --> 00:16:00,100
!ها أنا ذا أعلن حجزك في مقرّ قيادة رومفلر

192
00:16:05,810 --> 00:16:08,690
بذلك المسدّس النّفيس
،الّذي نسي معنى الحرب

193
00:16:08,690 --> 00:16:12,400
ما كنتُ لأشعر بأيّ عاطفة حتّى
.إن أطلقت النّار به على قلب عدوّ

194
00:16:13,240 --> 00:16:15,660
الأمر ليس وكأنّ الشّخص النّقيّ
.لا يملك أيّ وجهة

195
00:16:15,660 --> 00:16:18,370
.بل أنّ باله حرّ

196
00:16:21,500 --> 00:16:24,540
تدخل القاعدة القمريّة نطاق إطلاق
.النّار لمدافع بالج الشّعاعيّة

197
00:16:27,000 --> 00:16:30,960
فوج من دمى الثّور المتنقّلة أُرسل
.من القاعدة القمريّة يقترب منّا

198
00:16:31,340 --> 00:16:32,880
!إنّها جاهزة للهجوم

199
00:16:32,880 --> 00:16:34,890
!عاد الاتّصال بالقاعدة القمريّة

200
00:16:35,390 --> 00:16:36,930
.ليدي أن

201
00:16:36,930 --> 00:16:41,060
لم يكن نقل بالج في خطط اليوم، صحيح؟

202
00:16:41,060 --> 00:16:44,350
.كانت الدّمى المتنقّلة جاهزة تمامًا لمهاجمتك

203
00:16:45,060 --> 00:16:47,020
.سلاح بلا رحمة

204
00:16:47,020 --> 00:16:48,570
أهذا ما هو عليه الدّمى المتنقّلة؟

205
00:16:48,860 --> 00:16:50,480
.بالضّبط

206
00:16:54,110 --> 00:16:58,910
لقد أنتجنا جنودًا ممتازين سيسمحون
.لرومفلر بنشر النّظام على الأرض

207
00:17:00,450 --> 00:17:04,370
أصبحت أعرف الآن لماذا يكره
.السّيّد تيريز الدّمى المتنقّلة

208
00:17:05,170 --> 00:17:05,830
ماذا قلت؟

209
00:17:06,120 --> 00:17:08,420
.لقد وقع السّيّد تيريز في حبّ الشّعب

210
00:17:08,420 --> 00:17:10,880
.وبموت الشّعب

211
00:17:10,880 --> 00:17:14,340
هنالك شيء ما بشأن الموت يناشد
.بشدّة عواطف النّاس

212
00:17:14,340 --> 00:17:19,180
،العواطف الّتي يمنحها الأموات
.تؤكّد أو ترفض القتال

213
00:17:19,180 --> 00:17:22,810
.تقود العواطف السّامية لخياراتٍ قصوى

214
00:17:22,810 --> 00:17:27,060
.تلقّي الموت هو سلوك الجنديّ الحقيقيّ

215
00:17:31,230 --> 00:17:34,490
أليس هكذا يفكّر الضّعفاء؟

216
00:17:34,950 --> 00:17:39,410
لقد أنشأنا هذه الدّمى المتنقّلة الخالدة
وسنبني مستقبلاً للقتال

217
00:17:39,410 --> 00:17:43,410
يتجاهل الموت وبحيث لن يكون
.هذا الأخير عاملاً من العوامل

218
00:17:46,000 --> 00:17:47,080
.توباروف

219
00:17:47,080 --> 00:17:48,630
هل تدرك الأمر؟

220
00:17:48,630 --> 00:17:51,500
.إنّ الدّمى المتنقّلة لا تسمو فوق الموت

221
00:17:51,500 --> 00:17:55,670
.إنّها مجرّد بدائل لأولئك الّذين يخشون الموت

222
00:17:56,090 --> 00:17:59,140
.لا يمكن للمرء الدّخول في حرب متوقّعًا الهزيمة

223
00:18:00,180 --> 00:18:02,560
.لا يهمّ إن انتصرت أم انهزمت

224
00:18:02,560 --> 00:18:05,810
.تُصقل العواطف بمواصلة القتال

225
00:18:05,810 --> 00:18:09,600
.وسيأتي يوم ستُكافأ فيه الأرواح الّتي فُقدت

226
00:18:10,230 --> 00:18:12,820
.لا أفهم ما الّذي ترمين إليه

227
00:18:13,280 --> 00:18:16,280
!لهذا السّبب أنت وأنا عدوّان

228
00:18:24,660 --> 00:18:27,410
.مُروا الدّمى المتنقّلة أن تهاجم حصن بالج

229
00:18:27,410 --> 00:18:30,080
سوف يستهدفون هذه القاعدة
!بالمدافع الشّعاعيّة

230
00:18:33,000 --> 00:18:35,300
.لن يدركوا أنّ حصن بالج هو الطّعم

231
00:18:35,300 --> 00:18:38,510
لا أستطيع توقّع الضّرر الّذي ستُكبّدُه
.مدافع بالج الشّعاعيّة للقاعدة القمريّة

232
00:18:43,430 --> 00:18:45,100
.انجُ من هذا يا حصن بالج

233
00:18:45,100 --> 00:18:46,560
.لن يطول الأمر

234
00:18:49,770 --> 00:18:51,980
!عبرت عشر بذل أسد خطّ دفاعنا

235
00:18:51,980 --> 00:18:55,230
إنّها تهاجم البوّابات حيث خرج معظم
!الحرس لإيقاف بالج

236
00:18:55,530 --> 00:18:58,860
.يعرفون أين توجد كلّ دمانا المتنقّلة

237
00:18:58,860 --> 00:19:00,450
.يجعل هذا الأمر مثيرًا للاهتمام

238
00:19:08,370 --> 00:19:09,540
إلى أين ستذهبين أيّتها العقيد؟

239
00:19:10,580 --> 00:19:12,500
!سوف أحرّر طيّاري الغاندام

240
00:19:13,500 --> 00:19:15,710
.نرغب أنا وتيريز في ذلك

241
00:19:25,510 --> 00:19:27,020
.العدوّ لا يلاحقنا

242
00:19:28,730 --> 00:19:30,100
!أ-أيّها القائد

243
00:19:30,100 --> 00:19:31,190
ماذا هنالك؟

244
00:19:32,060 --> 00:19:34,400
!البذل المتنقّلة الجديدة تتحرّك

245
00:19:44,950 --> 00:19:46,200
.آمل ألاّ أكون قد تأخّرت

246
00:19:48,950 --> 00:19:52,420
.سنعدمهم في كلّ الأحوال حتّى إن لم تتأخّري

247
00:19:52,920 --> 00:19:55,380
.إذًا أطلب منك أن تعدمني أيضًا

248
00:19:55,840 --> 00:19:59,090
.الفشل يعني الموت المؤكّد في أوز في الماضي

249
00:20:06,760 --> 00:20:08,640
.أطلق عليّ النّار يا توباروف

250
00:20:08,640 --> 00:20:10,430
.أكّد ما تؤمن به

251
00:20:10,850 --> 00:20:12,390
.ليدي أن

252
00:20:12,390 --> 00:20:14,310
.كنتِ متساهلة للغاية

253
00:20:15,480 --> 00:20:17,320
.كجنديّة، نعم

254
00:20:17,320 --> 00:20:20,360
.لكنّي عشت حياة صارمة كمواطنة

255
00:20:47,010 --> 00:20:48,890
.إنّها مكتملة بنسبة 70% فقط

256
00:20:48,890 --> 00:20:50,310
!لا نستطيع القتال بها كما يجب

257
00:20:50,850 --> 00:20:52,770
.من المدهش أنّنا على قيد الحياة

258
00:20:52,770 --> 00:20:54,270
.فلا تشتكي

259
00:20:54,940 --> 00:20:55,730
!أتريد الهرب؟

260
00:20:56,150 --> 00:20:57,560
.بعد أن نردّ لهم الصّاع صاعين

261
00:21:43,400 --> 00:21:47,530
إنّ سحركم أيّها الطّيّارون قد أدخل
.كلّ شيء في فوضى

262
00:21:48,490 --> 00:21:52,950
تعاني قلوبكم النّقيّة في عالم
.لا يمكن العثور فيه على إجابات

263
00:21:53,700 --> 00:21:57,000
إنّ من يفكّرون بحنان بشأنكم
،في ذلك الوضع

264
00:21:57,000 --> 00:21:59,750
.قد أدركوا كم أنّهم بلا حول ولا قوّة

265
00:21:59,750 --> 00:22:01,380
.لقد أصبحوا متسرّعين وقد سُحقوا

266
00:22:02,420 --> 00:22:07,470
لكن لا تكفّوا عن السّطوع
.أيّها المحاربون الشّجعان

267
00:22:07,470 --> 00:22:10,890
.ودعوني أواصل حبّي لكم

268
00:23:27,380 --> 00:23:29,380
في الحلقة القادمة

269
00:23:32,220 --> 00:23:39,020
دخل جنود أوز المعروفين بـ"فصيل تيريز" في
.معركة مع رومفلر بعد سماعهم باحتجازه

270
00:23:39,520 --> 00:23:44,110
تملك دمى العذراء المتنقّلة الّتي أُرسلت
.إلى الأرض قدرات هجوم هائلة

271
00:23:44,110 --> 00:23:49,860
تسعى المؤسّسة لتدمير الغاندام وحلفائها
.الّذين تراهم كرمز للمعارضة

272
00:23:49,860 --> 00:23:51,990
.وقد أمروا بإعدام طيّاري الغاندام

273
00:23:52,490 --> 00:23:55,830
في الحلقة السّادسة والعشرين
،"من "جناح الغاندام

274
00:23:55,830 --> 00:23:57,910
."اللّهب الأبديّ للشّهب"