1
00:01:22,600 --> 00:01:30,270
بعدما ضمّت مؤسّسة رومفلر ريلينا بيسكرافت
كممثّلة رئيسيّة لها ورمز للسّلام

2
00:01:30,270 --> 00:01:34,610
اكتسبت دعم النّاس وتختبئ تحت ذريعة
.جعل الأمّة العالميّة حقيقة واقعة

3
00:01:37,610 --> 00:01:44,450
وفي الفضاء، ثار مواطنون مسلّحون يعارضون
حكم أوز المستعمر في كلّ مستعمرة

4
00:01:44,750 --> 00:01:48,370
.وبدؤوا حركة استقلاليّة تُدعى النّاب الأبيض

5
00:01:50,170 --> 00:01:52,550
.العام 195 بعد المستعمرات

6
00:01:52,550 --> 00:01:58,680
لقد احتدمت الحروب وتدفع
.بهذا العصر إلى تغييرات جذريّة

7
00:02:04,520 --> 00:02:07,310
.أودّ تقديم إعلان للعالم

8
00:02:08,480 --> 00:02:15,280
ابتداءً من هذا اليوم، سأصبح أنا ريلينا بيسكرافت

9
00:02:16,360 --> 00:02:20,240
.أنا لا أقوم بهذا من أجل رومفلر

10
00:02:20,530 --> 00:02:24,700
أنظر إلى هذا الأمر كخطوة أولى
.على طريق مليء بالإيجابيّة

11
00:02:25,240 --> 00:02:28,160
.طريق يمكننا السّير عليه معًا يدًا بيد

12
00:02:28,160 --> 00:02:31,670
طريق حيث ستتوقّف فيه الحروب
.ويمكننا تحقيق السّلام

13
00:02:32,380 --> 00:02:36,590
أطلب منكم أن تتخلّوا عن أسلحتكم
.وتتوقّفوا عن القتال

14
00:02:36,590 --> 00:02:40,430
.أنا واثقة أنّنا جميعًا نتمنّى نفس المستقبل

15
00:02:41,800 --> 00:02:45,850
.دعونا نتقدّم معًا نحو هذه الأهداف

16
00:02:46,430 --> 00:02:50,140
أنا هنا أعلن نزع الحدود الوطنيّة

17
00:02:50,140 --> 00:02:52,190
الّتي تسّبت بالحروب حول العالم

18
00:02:52,190 --> 00:02:57,780
.وأعلم الأرض كدولة واحدة، الأمّة العالميّة

19
00:03:13,170 --> 00:03:14,290
...ريلينا

20
00:03:28,270 --> 00:03:32,690
من الأفضل أن نفكّر في التّقاعد
.بمجرّد أن تصبح الأمّة العالميّة حقيقة

21
00:03:33,350 --> 00:03:34,810
.ذلك ليس حتّى مضحكًا

22
00:03:35,360 --> 00:03:37,780
...سوف ننشغل أكثر

23
00:03:38,070 --> 00:03:41,320
.بالعمل في قوّات جيش جلالة الملكة

24
00:03:45,530 --> 00:03:48,700
إذًا فقد تمّ تحديد ميدان قتالنا التّالي؟

25
00:03:48,700 --> 00:03:49,750
.ذلك ما يبدو

26
00:04:03,630 --> 00:04:05,970
أنت جنديّ أيضًا، صحيح؟

27
00:04:05,970 --> 00:04:08,640
أليس عليك الذّهاب معهم؟

28
00:04:08,970 --> 00:04:11,230
.بالنّسبة لي، انتهت الحرب

29
00:04:13,850 --> 00:04:17,400
.لقد دُمرّت بلادي، لذلك لم يعد لي ما أحميه

30
00:04:18,230 --> 00:04:20,940
.لقد فقدت ثانية الدّافع للقتال

31
00:04:22,200 --> 00:04:23,700
.معك حقّ

32
00:04:23,700 --> 00:04:25,700
.أتمنّى فقط أن يقودنا كلّ هذا للسّلام

33
00:04:26,570 --> 00:04:27,830
السّلام؟

34
00:04:28,580 --> 00:04:30,700
أهكذا يجب أن يكون؟

35
00:04:30,700 --> 00:04:34,920
.كلاّ، لا يجب أن يأتي السّلام بهذه السّهولة

36
00:04:39,840 --> 00:04:41,170
.المعذرة

37
00:04:41,170 --> 00:04:43,170
أنت هو العقيد زيكس، صحيح؟

38
00:04:43,170 --> 00:04:44,550
.تبحث عن الشّخص الخطأ

39
00:04:44,550 --> 00:04:46,840
إذًا هل أنت السّفير ملياردو؟

40
00:04:49,010 --> 00:04:50,680
.دعني أعرّفك بنفسي

41
00:04:50,680 --> 00:04:54,850
أنا أقاتل لتحرير سكّان المستعمرات

42
00:04:54,850 --> 00:04:58,400
.مع ثوريّي النّاب الأبيض وأدعى كانز

43
00:04:58,860 --> 00:04:59,980
.حسنًا إذًا

44
00:05:00,320 --> 00:05:05,240
أنت لست راضٍ بالمستعمرات فحسب
.لذلك تودّ أن تبدأ صورة على الأرض

45
00:05:05,990 --> 00:05:07,490
.أنت شخص ممتع

46
00:05:07,820 --> 00:05:09,950
.هذا متوقّع بما أنّها كلمات كونت البرق

47
00:05:10,450 --> 00:05:13,660
.أنا آسف، لكن ليس لديّ ما أحدّثك به

48
00:05:14,160 --> 00:05:15,410
.دعني وشأني

49
00:05:15,870 --> 00:05:20,380
واضح أنّ ذلك مشاكل في الوثوق
.بمجموعتنا وهذا ليس مفاجئًا

50
00:05:22,130 --> 00:05:26,680
.بالكاد تبنّينا معتقدات قائدنا هيرو يوي

51
00:05:26,680 --> 00:05:29,930
...وأنا أفهم أنّه في مرحلة ما

52
00:05:29,930 --> 00:05:31,890
كنتَ متعاطفًا مع استقلال المستعمرات

53
00:05:32,140 --> 00:05:35,180
.عندما أتيتَ كبيسكرافت من مملكة سانك

54
00:05:36,270 --> 00:05:39,060
ماذا تطلب منّي أن أفعل؟

55
00:05:39,690 --> 00:05:42,230
.نريدك أن تعود للفضاء الخارجيّ

56
00:05:43,070 --> 00:05:45,030
.وأحضر الغاندام معك

57
00:05:46,400 --> 00:05:47,490
أحضر الغاندام؟

58
00:05:49,620 --> 00:05:50,700
.نعم

59
00:05:50,700 --> 00:05:53,620
.الغاندام هي رمز الثّورة

60
00:05:53,620 --> 00:05:56,830
.لذلك نحن بحاجة لك وللغاندام خاصّتك

61
00:06:11,760 --> 00:06:14,810
،بإعلان الملكة ريلينا للأمّة العالميّة

62
00:06:14,810 --> 00:06:19,100
فإنّ العالم في طريقه للقضاء
.على هذه الحروب الّتي لا معنى لها

63
00:06:19,480 --> 00:06:21,360
.هذا أمر رائع

64
00:06:21,980 --> 00:06:25,940
!ولكن، لا تنتهي مسؤوليّاتنا هنا

65
00:06:26,190 --> 00:06:29,490
لقد نسي المتمرّدون في الفضاء
الحماية الّتي وفّرناها

66
00:06:29,490 --> 00:06:32,370
!ومالوا للثّورة

67
00:06:32,660 --> 00:06:34,700
علينا التّعامل مع هؤلاء المتمرّدين

68
00:06:34,700 --> 00:06:38,540
!والمواصلة في تحقيق السّلام على الأرض

69
00:06:38,870 --> 00:06:41,580
.أستسمحك عذرًا أيّها الدّوق ديرمايل

70
00:06:42,000 --> 00:06:44,420
ماذا لديك أيّها الماركيز ويريج؟

71
00:06:44,920 --> 00:06:47,970
ما الّذي يعطيك السّلطة داخل رومفلر؟

72
00:06:48,630 --> 00:06:51,430
.أنا لا أفهم تمامًا مقصدك

73
00:06:51,680 --> 00:06:57,890
أليست ممثّلتنا وقائدتنا الجديدة هي الملكة ريلينا؟

74
00:06:59,390 --> 00:07:00,730
.أيّها الدّوق ديرمايل

75
00:07:00,730 --> 00:07:06,980
أجد أنّه من غير المحترم جدًّا
.أن تقف هناك وتخبرنا بخططنا

76
00:07:08,740 --> 00:07:11,700
،فكما حدث مع تيريز كوشرينادا

77
00:07:11,700 --> 00:07:16,290
لن أكون الوحيد الّذي يفكٍّ أنّ عليك التّخلّي
.عن منصبك في رومفلر بشكل طوعيّ

78
00:07:16,700 --> 00:07:20,830
.لكنّنا لن نجبرك كما فعلتَ معه

79
00:07:21,210 --> 00:07:24,880
أقترح أن نسلك الطّريق الدّيمقراطيّ
.ونصوّت على هذه المسألة

80
00:07:28,510 --> 00:07:30,550
.حججك صحيحة

81
00:07:30,550 --> 00:07:36,220
لكن بغرض تفادي اقتراف الخطأ
،الّذي اقترفه ذلك الدّكتاتور

82
00:07:36,220 --> 00:07:39,850
.فلن أتنحّى عن منصبي

83
00:07:39,850 --> 00:07:44,770
وطبعًا سأكون جاهزًا للقيام بذلك
.بمجرّد أن يصبح ضروريًّا

84
00:07:45,270 --> 00:07:46,480
.مفهوم

85
00:07:46,820 --> 00:07:48,820
.تقول أنّ هذا ليس الوقت المناسب

86
00:07:49,280 --> 00:07:50,610
.هذا صحيح

87
00:07:50,990 --> 00:07:54,280
هل أنت راضٍ الآن أيّها الماركيز ويريج؟

88
00:07:56,080 --> 00:07:57,660
.كلّ الرّضا

89
00:08:00,660 --> 00:08:01,660
...والآن

90
00:08:03,500 --> 00:08:05,880
.أتمنّى فقط أن يقود هذا للسّلام

91
00:08:09,590 --> 00:08:16,260
جلب الدّوق ديرمايل الملكة ريلينا
.للواجهة للتّشبّث بمنصبه

92
00:08:16,850 --> 00:08:21,100
لكنّ كان لذلك تأثير معاكس
.وجعل وضعه غير مستقر

93
00:08:21,100 --> 00:08:26,940
في الوقت الحاليّ، أزيد من نصف مؤسّسة
.رومفلر يدعمون الملكة ريلينا

94
00:08:28,270 --> 00:08:33,280
سننصّب الملكة ريلينا ملكة على الأمّة
.العالميّة في الواقع كما في الاسم

95
00:08:34,860 --> 00:08:36,950
...هل أنت واثقة أنّنا نقوم بالصّواب

96
00:08:37,530 --> 00:08:38,990
يا آنسة دوروثي؟

97
00:08:39,370 --> 00:08:40,200
.نعم

98
00:08:40,870 --> 00:08:44,330
.هذا لأنّ على عصرنا أن يُقاد نحو الاتّجاه الصّحيح

99
00:08:55,470 --> 00:08:56,890
أهذا صحيح؟

100
00:08:56,890 --> 00:08:58,680
لقد رفض ووفي؟

101
00:08:58,970 --> 00:09:01,140
.لديه أولويّاته الخاصّة

102
00:09:01,850 --> 00:09:05,100
.لا يمكن لأيّ أحد أن يجبره على فعل أيّ شيء

103
00:09:05,810 --> 00:09:09,570
.ولكن يا تروا بارتون، أنا ممتنّة لقدومك معنا

104
00:09:10,440 --> 00:09:13,940
أشكّ أنّني سأكون ذا عون بدون
.أيّ ذكريات من الماضي

105
00:09:14,700 --> 00:09:19,030
.لكنّني مرتاح فقط بتواجدي هنا معكم

106
00:09:19,580 --> 00:09:20,620
...تروا

107
00:09:23,370 --> 00:09:26,750
سنتّجه إلى قمر وينر الاصطناعيّ
للموارد الطّبيعيّة

108
00:09:26,750 --> 00:09:30,460
.ونقوم بتعديلاتنا الفضائيّة الأخيرة لصخرة الرّمال

109
00:09:31,250 --> 00:09:33,210
.إنّها مسافة بعيدة

110
00:09:33,210 --> 00:09:34,670
.شكرًا لقيامك بالقيادة

111
00:09:35,300 --> 00:09:37,640
.أنا من عليها أن تشكركما

112
00:09:37,640 --> 00:09:39,800
.أقدّر لكما هذا كلاكما

113
00:09:46,100 --> 00:09:48,560
...السّلام والحرّيّة

114
00:09:56,030 --> 00:09:59,410
ما الّذي حدث للجميع مؤخّرًا على أيّة حال؟

115
00:09:59,870 --> 00:10:04,500
.ومع ذلك، كنت مثلهم حتّى وقت وجيز

116
00:10:10,290 --> 00:10:11,920
!غادروا

117
00:10:12,290 --> 00:10:14,630
!ليس لديّ ما أناقشه معكم

118
00:10:16,470 --> 00:10:21,390
،إن أصررت على عدم تعاونك
!فسنلجأ لوسائل أخرى

119
00:10:22,050 --> 00:10:23,970
هكذا إذًا؟

120
00:10:24,430 --> 00:10:26,770
!أتعتقدون أن تهديدي سيغيّر رأيي؟

121
00:10:28,940 --> 00:10:31,230
!هيّا، انتهى وقتكم

122
00:10:32,230 --> 00:10:35,780
...شعرنا أنّنا بحاجة للغاندام كرمز لمجموعتنا

123
00:10:36,400 --> 00:10:38,530
.يا للأسف يا ديو ماكسويل

124
00:10:39,660 --> 00:10:41,410
.أمست الغاندام عدوّة لنا الآن

125
00:10:42,070 --> 00:10:46,370
،إن كنت تخاف على حياتك
.فلا تقم بإغضابي

126
00:10:47,830 --> 00:10:49,920
!غادروا الآن

127
00:10:57,420 --> 00:10:59,170
!مرحبًا يا هيلدي

128
00:10:59,170 --> 00:11:00,300
.لم ألاحظ وجودك

129
00:11:00,800 --> 00:11:03,260
.أنا متفاجئة بعثورهم على هذا المكان

130
00:11:03,850 --> 00:11:06,470
.كما يقال، الشّرّ يجذب الشّرّ

131
00:11:07,060 --> 00:11:09,600
.ليس لديّ خيار آخر سوى الرّحيل الآن

132
00:11:10,060 --> 00:11:12,190
هل عليك ذلك؟

133
00:11:12,480 --> 00:11:13,360
.نعم

134
00:11:13,810 --> 00:11:17,650
.سبّبت لك ولهذه البلدة الكثير من الإزعاج سلفًا

135
00:11:18,490 --> 00:11:20,450
هل يمكنني المجيء معك؟

136
00:11:20,860 --> 00:11:21,610
...لا أظنّ ذلك

137
00:11:22,030 --> 00:11:22,700
...كلاّ

138
00:11:23,660 --> 00:11:28,000
ما زال بمقدورك الانضمام للنّاب الأبيض، صحيح؟

139
00:11:28,410 --> 00:11:30,790
.أنت تقاتل من أجل المستعمرات

140
00:11:33,040 --> 00:11:37,170
.أستطيع العودة للجيش والقتال مجدّدًا

141
00:11:41,090 --> 00:11:42,680
...د-ديو

142
00:11:43,760 --> 00:11:44,890
!غبيّة

143
00:11:45,470 --> 00:11:49,480
،لقد حقّقتِ راحة البال أخيرًا
فلماذا قد تتخلّين عنها الآن؟

144
00:11:50,230 --> 00:11:51,850
.اسمعي يا هيلدي

145
00:11:51,850 --> 00:11:54,100
.أنا لا أثق بهم

146
00:11:54,100 --> 00:11:57,440
.إنّهم يذكّرونني بأوز قبل وقت ليس ببعيد

147
00:11:57,690 --> 00:12:00,820
.لكن لا أحد يشكرك على ما قدّمته

148
00:12:01,450 --> 00:12:05,030
!سوف تُعامل كبطل مع النّاب الأبيض على الأقلّ

149
00:12:05,870 --> 00:12:07,990
.أنا لست مهتمًّا بذلك

150
00:12:08,580 --> 00:12:12,160
.سأواصل ما أفعله بإله الموت

151
00:12:14,080 --> 00:12:15,880
.إنّها معركة وحيدة

152
00:12:18,050 --> 00:12:19,050
.نعم

153
00:12:19,050 --> 00:12:21,260
هذا هو الطّريق الّذي اخترنا نحن
.طيّارو الغاندام أن نسير عليه

154
00:12:21,880 --> 00:12:25,590
.لا يجب علينا إقحام المستعمرات في الحرب

155
00:12:27,010 --> 00:12:30,180
.أنتم لطفاء للغاية

156
00:12:34,770 --> 00:12:36,560
!هكذا ننجو

157
00:13:14,600 --> 00:13:16,520
!الأمّة العالميّة مجرّد هراء

158
00:13:17,060 --> 00:13:20,190
هل يعتقدون أنّ بإمكانهم خداعنا
!بشيء كهذا؟

159
00:13:20,190 --> 00:13:22,070
...لكن أيّها العقيد سيديتشي

160
00:13:22,610 --> 00:13:26,360
.يقولون إنّ ريلينا بيسكرافت تؤمن بالسّلام حقًّا

161
00:13:27,870 --> 00:13:30,910
.لا يمكن أن تمتلك تلك الفتاة كلّ ذلك التّأثير

162
00:13:30,910 --> 00:13:34,200
.إنّنا نتحدّث عن أوز ومؤسّسة رومفلر

163
00:13:34,200 --> 00:13:37,330
!لا تنس أبدًا من كانا يضطهدنا حتّى الآن

164
00:13:37,330 --> 00:13:38,790
!حاضر

165
00:13:38,790 --> 00:13:42,170
.إنّ مستعمراتنا بلاد واحدة مستقلّة

166
00:13:42,170 --> 00:13:48,800
لذا علينا إنهاء هذه السّفينة الحربيّة بسرعة
.بهدف جعل سكّان الأرض يدركون الأمر

167
00:13:49,430 --> 00:13:52,060
ما الوضع في القاعدة القمريّة
الّتي استولينا عليها؟

168
00:13:52,100 --> 00:13:55,850
إنّنا نجمع المخزون الكبير
من أجزاء بذل العذراء المُحدّثة

169
00:13:55,850 --> 00:13:58,150
.الّتي تُركت في مصنع توباروف للدّمى المتنقّلة

170
00:13:58,150 --> 00:14:02,230
.ستُضاف إلى قوّة النّاب الأبيض العسكريّة

171
00:14:11,410 --> 00:14:14,330
هذا ما حصلت عليها المستعمرات
.بعد تسليح نفسها

172
00:14:14,330 --> 00:14:19,370
على الأرجح أنّها استُعملت كمحطّة لأوز أيضًا
.وتمّت مهاجمتها من النّاب الأبيض

173
00:14:20,250 --> 00:14:23,090
.هذا تنتهي المعارك هذه الأيّام، هذا عاديّ

174
00:14:24,920 --> 00:14:26,340
.لقد قُضي عليهم

175
00:14:27,420 --> 00:14:30,140
هل يتّجه الفضاء في الطّريق الخطأ؟

176
00:14:30,840 --> 00:14:34,180
كان التّحالف السّابق هو أوّل
.من أحضر الأسلحة للفضاء

177
00:14:34,520 --> 00:14:37,730
.ثمّ قامت أوز السّابقة بصنع الأسلحة في الفضاء

178
00:14:38,310 --> 00:14:41,610
.اضطهدت رومفلر المواطنين وسيطرت عليهم

179
00:14:42,310 --> 00:14:44,940
إن كان كلّ شيء وليد منظّمات الأرض

180
00:14:44,940 --> 00:14:47,990
،بما فيها ثورة النّاب الأبيض

181
00:14:48,700 --> 00:14:52,120
إذًا فإنّه لمثير للشّفقة ما أدّى
.إليه تدخّل الإنسان

182
00:14:52,740 --> 00:14:55,740
من قد يدعم مجموعة ببدايات معيبة كهذه؟

183
00:14:56,290 --> 00:15:00,080
.لهذا السّبب استسلمت الآنسة ريلينا لرومفلر

184
00:15:00,080 --> 00:15:03,340
كما علينا أن نكون المحاربين
.الّذين سيساعدون على تنفيذ خططها

185
00:15:04,550 --> 00:15:05,800
!التقط وجود طاقة

186
00:15:10,380 --> 00:15:12,430
!لقد أصيب مخزون طاقتنا

187
00:15:12,430 --> 00:15:14,810
!لقد هاجموا دون التّأكّد إن كنا أعداءً أم حلفاء

188
00:15:14,810 --> 00:15:15,850
!أوز؟

189
00:15:17,770 --> 00:15:21,310
.لن يفلت النّاب الأبيض بفعلته هذه المرّة

190
00:15:21,310 --> 00:15:23,810
!سوف يرون مهدن قوّاتنا الفضائيّة

191
00:15:24,270 --> 00:15:26,860
!هنالك بذل متنقّلة تنطلق من مكّوك العدوّ

192
00:15:26,860 --> 00:15:29,190
!"هاجموا محافظين على التّشكيلة "في

193
00:15:29,190 --> 00:15:31,610
!فلتهاجم الدّمى المتنقّلة من الجناح الأيسر المكّوك

194
00:15:31,610 --> 00:15:32,610
!عُلم

195
00:15:33,700 --> 00:15:35,160
!تروا، تصرّف بعقلانيّة

196
00:15:35,160 --> 00:15:37,200
!من الحماقة الذّهاب وحدك

197
00:15:37,200 --> 00:15:39,660
.أعتقد أنّني أتذكّر ما العمل

198
00:15:39,660 --> 00:15:41,040
.سوف أحاول

199
00:15:41,040 --> 00:15:41,790
!تروا

200
00:15:51,220 --> 00:15:52,970
!بذلة ثور بيضاء؟

201
00:15:53,340 --> 00:15:54,470
!ما يكون؟

202
00:16:05,650 --> 00:16:07,190
!إنّه قويّ

203
00:16:07,650 --> 00:16:08,690
!لكن كيف؟

204
00:16:29,000 --> 00:16:29,840
.كاتر

205
00:16:29,840 --> 00:16:32,170
!سيدمّر هذا المكّوك نفسه بعد بضعة دقائق

206
00:16:32,170 --> 00:16:34,380
!اتّجه مباشرة إلى منطقة المعركة بعد مغادرتك

207
00:16:34,380 --> 00:16:35,260
!عُلم

208
00:16:43,270 --> 00:16:44,230
!ها هم أولاء

209
00:16:52,150 --> 00:16:54,360
!هيّا يا صخرة الرّمال

210
00:16:58,950 --> 00:17:01,450
.أنت لستِ مجهّزة للفضاء

211
00:17:15,090 --> 00:17:15,760
!آنسة نوين

212
00:17:19,100 --> 00:17:21,140
!ماذا؟! بذلة غاندام؟

213
00:17:21,810 --> 00:17:24,350
!إذًا فالنّاب الأبيض لديهم غاندام؟

214
00:17:25,600 --> 00:17:27,270
!لينتشر الجميع

215
00:17:27,270 --> 00:17:29,190
!انتشروا وحاصروهم

216
00:18:14,650 --> 00:18:15,610
...تروا

217
00:18:18,700 --> 00:18:19,780
!كاتر

218
00:18:19,780 --> 00:18:21,280
!ماذا تظنّ نفسك فاعلاً؟

219
00:18:21,280 --> 00:18:23,240
!سوف ينفجر دلك المكّوك

220
00:18:25,540 --> 00:18:29,790
لن تصل صخرة الرّمال إلى تروا في الوقت
!المناسب اعتمادًا على ورنيّاتها فحسب

221
00:18:29,790 --> 00:18:31,170
!سيكون عليّ انتهاز هذه الفرصة

222
00:18:31,170 --> 00:18:32,630
!كاتر

223
00:18:40,800 --> 00:18:42,260
!كاتر

224
00:19:04,410 --> 00:19:05,410
...كاثرين

225
00:19:06,450 --> 00:19:07,450
!تروا

226
00:19:38,110 --> 00:19:40,950
هل تلعبون مع هذه الآلات البلهاء؟

227
00:19:41,280 --> 00:19:43,450
.يا لي من شخص لطيف

228
00:19:43,990 --> 00:19:48,410
.أنا هنا لإنقاذ الشّخص الّذي دمّرك يا حاصدة الأرواح

229
00:19:50,540 --> 00:19:51,830
!سحقًا لكِ يا بذل الغاندام

230
00:20:48,050 --> 00:20:50,180
من ذلك الشّخص؟

231
00:20:51,520 --> 00:20:53,020
!ماذا؟

232
00:20:53,020 --> 00:20:55,400
!هل نسيت أمري بهذه السّرعة؟

233
00:20:55,400 --> 00:20:57,400
!أنا أحد أفضل أصدقائك

234
00:20:59,020 --> 00:20:59,860
.أنا آسف

235
00:21:00,860 --> 00:21:03,320
!أنا أمزح، كنت أمزح فحسب

236
00:21:03,740 --> 00:21:05,820
يا إلهي، ألا حسّ دعابة لديك؟

237
00:21:06,280 --> 00:21:07,450
!ديو

238
00:21:07,450 --> 00:21:09,280
!هل ستقاتل معنا بالفعل؟

239
00:21:09,740 --> 00:21:10,790
.أكيد

240
00:21:10,790 --> 00:21:14,000
.لأنّه إن قاتلنا، فلن يضطرّ المواطنون لذلك

241
00:21:14,000 --> 00:21:15,370
!ديو ماكسويل

242
00:21:17,710 --> 00:21:18,790
...أنا ممتنّة لك

243
00:21:19,460 --> 00:21:20,340
.من أعماق قلبي

244
00:21:20,800 --> 00:21:23,260
.لا يجب تعليق الكثير من الآمال على هذا

245
00:21:23,670 --> 00:21:26,220
.أنا لم أكرّس نفسي بشكل خاصّ

246
00:21:53,620 --> 00:21:54,870
...إن ماتت

247
00:21:55,210 --> 00:21:59,380
بإمكاننا القضاء على الأمّة العالميّة
.وكذلك هذا السّلام المزيّف

248
00:22:02,050 --> 00:22:03,000
.ريلينا

249
00:22:03,920 --> 00:22:05,590
.سوف أقتلك

250
00:22:12,600 --> 00:22:16,690
يُتبع

251
00:23:33,010 --> 00:23:36,680
.يخطّط هيرو لاغتيال قائدة مؤسّسة رومفلر

252
00:23:36,680 --> 00:23:43,020
بينما ريلينا الّتي تواصل استقطاب الدّاعمين توشك
.على أن تخطو أولى خطواتها نحو سلام حقيقيّ

253
00:23:43,020 --> 00:23:48,780
،لكن وبصفته القائد الجديد للنّاب الأبيض
...لا يفهم ملياردو نوايا الأرض

254
00:23:48,780 --> 00:23:51,070
.ويفرض أوامر بالقضاء عليها

255
00:23:51,990 --> 00:23:54,990
،"في الحلقة 40 من "جناح الغاندام

256
00:23:54,990 --> 00:23:56,990
."القائد الجديد"