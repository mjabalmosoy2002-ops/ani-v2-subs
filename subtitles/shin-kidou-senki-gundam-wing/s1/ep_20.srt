3
00:00:19,160 --> 00:00:22,620
أريد إظهار مشاعري المتّقدة الخالدة

4
00:00:22,750 --> 00:00:27,790
!عن طريق جسدي بالكامل اللّيلة

5
00:00:33,840 --> 00:00:40,680
أتشبّث بكتفيك المبلّلين لمنحك الدّفء والرّاحة

6
00:00:40,850 --> 00:00:48,020
ما الّذي تسعى إليه هذه الأصابع المرتعشة؟

7
00:00:48,650 --> 00:00:55,200
أريد حماية النّظرة الصّادقة في عينك

8
00:00:55,950 --> 00:01:02,750
مؤمنة بالحبّ الّذي سيُحيلُ الحزنَ قوّة

9
00:01:02,830 --> 00:01:06,370
مجرّد نبض تواصل جامح

10
00:01:06,500 --> 00:01:10,090
أقف في المطر الجارح

11
00:01:10,250 --> 00:01:13,670
أريد إظهار مشاعري المتّقدة الخالدة

12
00:01:13,800 --> 00:01:18,510
!عن طريق جسدي بالكامل اللّيلة

13
00:01:26,930 --> 00:01:28,980
،في العام 175 بعد المستعمرات

14
00:01:29,360 --> 00:01:31,980
.اُغتيل قائد المستعمرات

15
00:01:32,190 --> 00:01:37,110
.أُرسلت خمس بذل غاندام للانتقام

16
00:01:37,110 --> 00:01:39,180
ولكن مذ أن أخذت نشاطات
أوز في الفضاء

17
00:01:39,180 --> 00:01:43,660
،طابعًا متعاونًا بَدل السّاعي للسّيطرة

18
00:01:43,660 --> 00:01:46,660
.قرّرت المستعمرات قبول أوز

19
00:01:49,820 --> 00:01:52,140
.السّنة 195 بعد المستعمرات

20
00:01:52,140 --> 00:01:54,770
بينما تتقدّم أوز للسّيطرة على
الأرض والفضاء الخارجيّ

21
00:01:54,770 --> 00:01:58,930
تمّ وسم الغاندام على أنّها بذل متمرّدين
.وعُزلت عن المجتمع

22
00:01:59,160 --> 00:02:02,910
أصبح على الغاندام وطيّاريها بعدما
لم يعد لهم مكان يعودون إليه

23
00:02:02,910 --> 00:02:08,140
أن يقاتلوا لسبب ليتواجدوا
.في هذا العالم المتغيّر

24
00:02:11,480 --> 00:02:13,560
!إنّها بذلة فضائيّة

25
00:02:13,560 --> 00:02:15,620
!تمّ تحديد البذلة الفضائيّة كهدف أيضًا

26
00:02:16,570 --> 00:02:17,930
!ألغه بسرعة

27
00:02:22,280 --> 00:02:24,660
.سأقضي على كلّ العراقيل

28
00:02:35,970 --> 00:02:38,070
!هل قلت القاعدة القمريّة؟

29
00:02:38,070 --> 00:02:38,930
.صحيح

30
00:02:39,380 --> 00:02:43,620
يتمّ جلب كمّيّات كبيرة من خليط معدن
.الغاندانيوم إلى مصنع القاعدة القمريّة

31
00:02:44,350 --> 00:02:47,910
على الأرجح أنّ ذلك بغرض صنع
.نوع جديد من البذل المتنقّلة

32
00:02:47,910 --> 00:02:49,190
علام تنوي إذًا؟

33
00:02:49,830 --> 00:02:51,260
.ابقَ هنا فحسب

34
00:02:51,260 --> 00:02:52,270
.ستعترض طريقي

35
00:02:52,560 --> 00:02:54,010
!ما الّذي تعنيه؟

36
00:02:55,770 --> 00:03:00,530
سأحتاج للوقت لاستعادة عافيتي
.نظرًا لكلّ ما حدث

37
00:03:00,530 --> 00:03:04,660
لكن ما رأيك أن تكون لطيفًا
معي قليلاً من وقت لآخر؟

38
00:03:05,250 --> 00:03:07,830
لماذا لا تذهب للمدرسة بدلاً منّي؟

39
00:03:07,830 --> 00:03:11,170
.لقد سبق وتولّيتُ أمر القبول باسمك

40
00:03:11,170 --> 00:03:12,770
!ماذا؟

41
00:03:12,770 --> 00:03:14,520
!لا بدّ أنّك تمزح

42
00:03:14,520 --> 00:03:17,960
!أعلم أنّ اسمك سيجلب الانتباه، ومع ذلك لماذا؟

43
00:03:17,960 --> 00:03:21,430
.ارتح وتحسّن بدل كلّ هذه الشّكوى

44
00:03:23,630 --> 00:03:25,120
.لا تبالغ

45
00:03:25,120 --> 00:03:27,100
.وكأنّه سيصغي لي

46
00:03:27,100 --> 00:03:29,350
.سوف يبالغ في الأمر بالتّأكيد

47
00:03:29,720 --> 00:03:34,060
سأقرّر بمجرّد أن أصل للقمر إن كنتُ
.سأسرق النّموذج الجديد أو سأدمّره

48
00:03:39,570 --> 00:03:42,840
بما أنّ القمر لا يملك إلاّ سُدس
،جاذبيّة الأرض

49
00:03:42,840 --> 00:03:46,340
.كان غير مناسب ليسكنه البشر

50
00:03:47,420 --> 00:03:50,020
،وبُعيد إكمال بناء المستعمرات الفضائيّة

51
00:03:50,020 --> 00:03:55,140
بدأت أعمال بناء منشآت بحوث قمريّة
.ومصانع ضخمة من مختلف الأنواع

52
00:03:55,760 --> 00:04:00,880
تطوّر القمر بعدها ليصبح وجهة
.سياحيّة محبوبة لذا سكّان الأرض

53
00:04:00,880 --> 00:04:04,250
.لقد ازدهر إلى أن أوقفه التّحالف

54
00:04:06,710 --> 00:04:10,180
،بعد أن قضت أوز على جيش التّحالف

55
00:04:10,180 --> 00:04:13,210
تمّ السّماح للقمر بأن يصبح
.وجهة سياحيّة ثانية

56
00:04:13,210 --> 00:04:18,150
رأى النّاس هذا كعلامة على
.عودة السّلام للفضاء

57
00:04:22,070 --> 00:04:24,990
أصبح النّاس الآن قادرين على
.السّفر بين المستعمرات

58
00:04:25,340 --> 00:04:29,190
يبدو أنّ أوز قد فردت سيطرتها
.على أماكن عدّة من الفضاء الخارجيّ

59
00:04:29,190 --> 00:04:33,960
إنّها تمنح الكثير من الهدايا هذه
.الأيّام لمحاولة الفوز بودّ النّاس

60
00:04:33,960 --> 00:04:37,200
.سيكون الباقي أسهل بمجرّد أن يثقوا في أوز

61
00:04:37,200 --> 00:04:41,010
سيتمّ السّيطرة على الموارد والعمالة
.من طرف أوز قريبًا

62
00:04:42,290 --> 00:04:46,150
.فلنبنِ لأوز وغدًا حقيقيًّا ليبقيها مشغولة

63
00:04:52,170 --> 00:04:55,810
يبدو نظام دفاع بذلة ميركوري
.مثيرًا للإعجاب

64
00:04:55,810 --> 00:04:59,650
ستبدأ بذلة فاييت أيضًا بأخذ شكلها
.النّهائيّ بمجرّد بناء الهيكل

65
00:05:00,860 --> 00:05:03,210
.إكمالها أمسى مسألة وقت فحسب

66
00:05:03,210 --> 00:05:06,820
!لا أنوي العمل تحت إمرة أوز للأبد

67
00:05:07,190 --> 00:05:09,930
.هذا مشروع ليدي أن من النّاحية الرّسميّة

68
00:05:09,930 --> 00:05:14,540
لكنّهم سيختارون طيّاري بذل منتقلة
.من بين سكّان المستعمرات

69
00:05:14,780 --> 00:05:17,640
.قد يصبح كلّ هذا مثيرًا للاهتمام

70
00:05:17,640 --> 00:05:20,500
.أشكّ في نجاح هذا الأمر

71
00:05:20,750 --> 00:05:24,150
.لن يُتعب هيرو نفسه بعمليّة الاختيار

72
00:05:24,150 --> 00:05:27,700
.إنّه من النّوع الّذي ينقضّ على الحناجر مباشرة

73
00:05:28,220 --> 00:05:33,180
في كلّ الأحوال، سننهي البذل المتنقّلة
.القوّية الّتي أرادتها أوز بشدّة

74
00:05:33,700 --> 00:05:37,640
ثمّ سنثبت أنّ أوز يمكن
!أن تُدمّر على يد أسلحتها

75
00:05:44,690 --> 00:05:48,210
هل تفكّر أوز بالفعل في إنشاء دولة في الفضاء؟

76
00:05:48,710 --> 00:05:51,250
،بما أنّنا أحرار الآن من سيطرة التّحالف

77
00:05:51,250 --> 00:05:55,950
أمسى السّكّان قادرين على التّواصل
.بين المستعمرات ومع الأرض

78
00:05:55,950 --> 00:05:58,350
.والفضل في ذلك يعود لأوز

79
00:05:58,350 --> 00:06:02,340
لكن لا أرى لماذا عليهم أن يحاولوا
.السّيطرة على مستقبلنا

80
00:06:02,600 --> 00:06:06,290
ربّما، لكن نظرًا لحجم المستعمرات
،الفضائيّة الحاليّ

81
00:06:06,290 --> 00:06:09,730
سيكون من الغريب لنا ألاّ نفكّر
.في إنشاء دولة

82
00:06:09,730 --> 00:06:12,350
.صحيح، لكن مشكلتنا ها هنا

83
00:06:18,640 --> 00:06:19,500
.أيّتها العقيد

84
00:06:19,500 --> 00:06:23,400
.يواجه ممثّلو المستعمرات مشاكل مع تلك الوثيقة

85
00:06:23,750 --> 00:06:25,100
.يبدو هذا طبيعيًّا

86
00:06:25,600 --> 00:06:29,640
.لقد شهِدوا كيف استعمل التّحالف الأسلحة بتهوّر

87
00:06:29,640 --> 00:06:34,130
وفي نظرهم، صانع البذل المتنقّلة
.يشبه تاجرًا للموت

88
00:06:34,990 --> 00:06:38,620
تحبّ البلدان الّتي تدعم أوز التّكنولوجيا الفضائيّة

89
00:06:38,620 --> 00:06:41,530
فقط لأنّ بإمكانها استعمالها لتحسين
.قوّتها العسكريّة

90
00:06:41,530 --> 00:06:44,500
لا أظنّ أنّ سكّان المستعمرات
.المسالمين سيوافقون على هذا

91
00:06:45,360 --> 00:06:48,890
.يمكنهم اعتبار مخطّطنا للتّسلّح كرادع

92
00:06:49,420 --> 00:06:52,850
.سيتمّ اتّخاذ استعدادات لجلب ما يفتقر له الفضاء

93
00:06:53,320 --> 00:06:54,720
ما يفتقر له الفضاء؟

94
00:06:55,870 --> 00:06:57,560
.النّظام العامّ اللاّئق

95
00:06:59,480 --> 00:07:02,650
.آسفة لجعلكم تنتظرون

96
00:07:03,260 --> 00:07:06,480
هل تسنّت لكم الفرصة لمراجعة الوثيقة؟

97
00:07:06,730 --> 00:07:11,050
أعتقد أنّ أحد الأسباب الّتي دفعت الأرض
لاعتبار المستعمرات الفضائيّة كتهديد

98
00:07:11,050 --> 00:07:15,100
.هو أنّ هذه الأخيرة افتقرت لبنية منتظمة

99
00:07:15,690 --> 00:07:18,950
أعتقد أن إنشاء دولة هو خطوة
.نحو الطّريق السّويّ

100
00:07:19,520 --> 00:07:22,290
لكنّكم تواجهون مشاكل مع الصّناعات الكبرى؟

101
00:07:22,290 --> 00:07:23,720
.بالضّبط

102
00:07:23,720 --> 00:07:28,510
أنّى للسّلام العالميّ أن يوجد بناءً
على فكرة احتياجنا للتّسلّح كرادع؟

103
00:07:29,010 --> 00:07:31,660
.تعلّمنا من التّاريخ خلاف ذلك

104
00:07:31,660 --> 00:07:36,210
.يمكننا إنشاء نظام عامّ مختلف عن الأرض

105
00:07:36,740 --> 00:07:40,150
نحن فخورين لأنّ هذه التّكنولوجيا
ستكون مصدر رأس مالنا

106
00:07:40,150 --> 00:07:43,020
!لكن ليس علينا اللّجوء للقوّة العسكريّة

107
00:07:43,020 --> 00:07:47,360
في قلبي، أشعر أنّ هذه الحرب
.قد وضعت أوزارها بالفعل

108
00:07:48,840 --> 00:07:50,890
.أوز منظّمة عسكريّة

109
00:07:50,890 --> 00:07:55,570
بذلنا جهودًا للقضاء على نزاعات
.متكرّرة على الأرض

110
00:07:55,570 --> 00:07:58,400
كان هدفُ تحالف المجال الأرضيّ المتّحد

111
00:07:58,400 --> 00:08:01,310
هو إحلال السّلام دون الاعتماد
.على القوّة العسكريّة

112
00:08:01,310 --> 00:08:02,580
.كما اقترحتم تمامًا

113
00:08:03,490 --> 00:08:06,040
.لكن فكّروا ما كانت نتائج هذه المخطّطات

114
00:08:06,540 --> 00:08:09,160
.لا داعي للقتال المتهوّر

115
00:08:09,760 --> 00:08:14,470
لكن لا يمكنكم مناقشة جمال البشريّة
.دون الاعتراف بالرّغبة في القتال

116
00:08:14,820 --> 00:08:19,520
هل أنا الوحيدة الّتي تحترم
إرادة الإنسان للقتال؟

117
00:08:35,680 --> 00:08:38,410
.لم أتوقّع أن تعيد أوز ترميمها لهذه الدّرجة

118
00:08:38,830 --> 00:08:41,810
!لكن لا يمكنني السّماح بمنح هذه الغاندام لأوز

119
00:08:45,140 --> 00:08:46,040
من هناك؟

120
00:08:46,500 --> 00:08:48,420
.ذلك ما كنتُ سأسألك إيّاه

121
00:08:48,420 --> 00:08:52,670
لا بدّ أنّك خبيرة من نوع ما لتسلّلك
.إلى هنا ليلاً وزرع متفجّرات

122
00:08:53,120 --> 00:08:55,760
.سلّمينا مفتاح التّفجير

123
00:08:56,250 --> 00:08:58,000
.لا أهتمّ لما سيحدث

124
00:08:58,000 --> 00:08:59,890
!لن تحصلوا على هذه الغاندام

125
00:09:05,520 --> 00:09:06,270
!ماذا؟

126
00:09:06,750 --> 00:09:09,230
!لم تنجح كلّ تلك المتفجّرات حتّى في خدشها

127
00:09:09,230 --> 00:09:12,570
هذا محبِط، لكنّ الغاندام مثيرة
!للاهتمام بالفعل

128
00:09:13,330 --> 00:09:16,140
!سُحقًا! إنّها عدائيّة للغاية

129
00:09:16,140 --> 00:09:17,810
!لقد اكتشفت أوز مكاننا

130
00:09:17,810 --> 00:09:18,980
!لنغادر المكان

131
00:09:18,980 --> 00:09:20,080
!سوف لن نهرب

132
00:09:20,080 --> 00:09:22,520
علينا على الأقلّ أنّ نكون بنفس
!شجاعة تلك السّيّدة

133
00:09:22,930 --> 00:09:26,040
علينا استعادة بذلة غاندام
!السّيّد كاتر مهما كلّفنا ذلك

134
00:09:27,290 --> 00:09:28,990
!لتتحرّك قوّات بذل الأسد

135
00:09:28,990 --> 00:09:31,130
!العدوّ في الحظيرة مع الغاندام 04

136
00:09:37,600 --> 00:09:38,390
!ها هي

137
00:09:45,060 --> 00:09:48,610
بالكاد تمكّنّا من التّسلّل للدّاخل
.وانظروا ماذا يحدث الآن

138
00:09:48,610 --> 00:09:51,020
!لا تنجح خطط عبدول إطلاقًا

139
00:09:51,020 --> 00:09:53,510
!ماذا كان ذلك؟! هل قلتَ شيئًا ما؟

140
00:09:53,510 --> 00:09:57,240
أنا في عجلة، لذا أحضر غاندام
!السّيّد كاتر إلى هنا بسرعة

141
00:10:00,110 --> 00:10:02,080
!ما الّذي يؤخّرك يا أودا؟

142
00:10:06,120 --> 00:10:08,260
!لا تقاتل على مقربة منّي

143
00:10:08,260 --> 00:10:10,580
!لم يكن الاستيلاء على هذه النّاقلة سهلاً

144
00:10:10,580 --> 00:10:12,420
!لستُ المُلام

145
00:10:12,420 --> 00:10:15,550
كان يفترض بنا الانتظار حتّى تعيد
!أوز ترميم الغاندام

146
00:10:15,840 --> 00:10:18,590
!لم أتوقّع أن تتطوّر الأمور بهذه السّرعة

147
00:10:19,010 --> 00:10:20,450
!بسرعة يا أحمد

148
00:10:20,450 --> 00:10:21,710
!سمعتك

149
00:10:36,820 --> 00:10:37,930
كيف سار الأمر؟

150
00:10:37,930 --> 00:10:39,830
!نجحنا! هذا ممتاز

151
00:10:39,830 --> 00:10:41,410
!تمّت المهمّة

152
00:10:42,040 --> 00:10:42,780
!ما هذا؟

153
00:10:49,750 --> 00:10:50,770
ما الخطب؟

154
00:10:50,770 --> 00:10:51,730
لماذا توقّفتم؟

155
00:10:52,860 --> 00:10:53,540
!كلاّ

156
00:10:55,880 --> 00:10:57,510
!لا تفكّروا حتّى في القتال

157
00:10:57,870 --> 00:11:00,940
!إنّها تلك المرأة اللّعينة ثانية

158
00:11:00,940 --> 00:11:02,470
!انظر، إنّه أودا

159
00:11:03,290 --> 00:11:05,140
!لا أظنّنا أعداءً

160
00:11:05,440 --> 00:11:06,890
.أوافقك الرّأي

161
00:11:06,890 --> 00:11:10,730
لكنّ الشّخص الّذي أعرفه كان
.ليحاول تدمير الغاندام

162
00:11:11,150 --> 00:11:14,780
.والشّخص الّذي أعرفه كان ليحزن على دمارها

163
00:11:15,410 --> 00:11:18,690
.نأمل أن نرمّمها لنقوم بإسعاده

164
00:11:18,950 --> 00:11:21,440
هل تعرف طيّار غاندام أيضًا؟

165
00:11:21,440 --> 00:11:24,380
نحن جزء من قوّات ماغاناك
.التّابعة للشّرق الأوسط

166
00:11:24,380 --> 00:11:27,660
!دعي هذه الغاندام بين أيدينا رجاءً

167
00:11:28,370 --> 00:11:31,000
.يبدو الطّيّار الّذي تعرفونه فتى جيّدًا

168
00:11:31,690 --> 00:11:33,420
.وكذلك الطّيّار الّذي تعرفينه

169
00:11:41,810 --> 00:11:46,050
حسنًا، من الأفضل أن أذهب وأحضر
.ما تركه الفتى الآخر خلفه

170
00:11:57,890 --> 00:12:03,210
تعود الصّور التّالية لحدث أُقيم اليوم
.مهمّ للغاية لدفاع المستعمرات

171
00:12:05,030 --> 00:12:10,200
سيتنافس هؤلاء المتطوّعون الشّباب على
.فرصة للقتال من أجل أمان المستعمرات

172
00:12:10,990 --> 00:12:13,830
لماذا يتّبع الجميع كلّ كلمة تقولها أوز؟

173
00:12:14,890 --> 00:12:19,840
أبلى الشّباب حسنًا في اختبار إطلاق
.صُمّم ليُحاكي معركة حقيقيّة

174
00:12:22,130 --> 00:12:27,010
في الاختبار التّالي، ستوضع عراقيل تمثّل
.العدوّ في طريق كلّ بذلة متنقّلة

175
00:12:27,440 --> 00:12:29,180
.القنابل زائفة

176
00:12:29,180 --> 00:12:30,750
.لكن لها تأثير حقيقيّ

177
00:12:30,750 --> 00:12:31,720
!كونوا حذرين

178
00:12:31,720 --> 00:12:32,350
!حاضر

179
00:12:34,780 --> 00:12:35,820
!ها هم أولاء

180
00:12:35,820 --> 00:12:37,060
!ابدؤوا الهجوم

181
00:12:49,700 --> 00:12:51,320
.يا لها من كارثة

182
00:12:51,320 --> 00:12:53,160
.لكنّهم مجرّد هواة

183
00:13:07,300 --> 00:13:08,660
!ما هذا؟

184
00:13:08,660 --> 00:13:10,720
!ما خطبه؟

185
00:13:11,240 --> 00:13:12,660
.هذا طيّار الاختبار 1

186
00:13:12,660 --> 00:13:14,140
.انتهيت من الاختبار

187
00:13:14,140 --> 00:13:17,660
!طيّار الاختبار 1، أكّد لنا اسمك

188
00:13:17,660 --> 00:13:20,110
.أنا تروا بارتون

189
00:13:20,570 --> 00:13:23,070
!أيّتها العقيد، تروا بارتون استثنائيّ

190
00:13:23,710 --> 00:13:25,940
،رغم أنه خاض بعض معارك المحاكاة

191
00:13:25,940 --> 00:13:29,840
إلاّ أنّه ما كان ليقوم بمناورات كهذه
!في معركته الأولى

192
00:13:30,540 --> 00:13:31,540
ما الّذي ترمي إليه؟

193
00:13:31,940 --> 00:13:34,320
.لا بدّ أنه خاض تدريبًا مسبقًا

194
00:13:34,320 --> 00:13:36,000
!ومن مستوى مرتفع للغاية أيضًا

195
00:13:36,420 --> 00:13:39,190
لكن تمّ التّحقّق من ماضيه، صحيح؟

196
00:13:39,190 --> 00:13:41,630
.نعم، ولم تكن هنالك أيّ مشاكل

197
00:13:41,630 --> 00:13:44,500
.يبدو لي إذًا أنّه موهوب بالفطرة

198
00:13:45,080 --> 00:13:47,970
.موهبة لم تُمنح له الفرصة لإظهارها من قبل

199
00:13:48,270 --> 00:13:51,900
لكن أليس من الممكن أن يكون
!قد أُرسل لتدمير أوز؟

200
00:13:51,900 --> 00:13:53,930
!حتّى أنّه قد يكون طيّار غاندام

201
00:13:54,500 --> 00:13:57,140
.سنكتشف الأمر قريبًا

202
00:13:58,240 --> 00:13:59,200
.تروا بارتون

203
00:13:59,200 --> 00:14:00,540
.لديك اختبار آخر

204
00:14:00,540 --> 00:14:02,860
!دمّر الهدف التّالي بالكامل

205
00:14:03,340 --> 00:14:04,170
...هذه

206
00:14:08,740 --> 00:14:09,870
ماذا؟

207
00:14:17,790 --> 00:14:19,630
ما الخطب يا تروا بارتون؟

208
00:14:19,630 --> 00:14:21,080
!أطلق على الهدف

209
00:14:25,720 --> 00:14:26,610
!أيّتها العقيد

210
00:14:26,610 --> 00:14:29,070
!إنّه طيّار غاندام كما توقّعت

211
00:14:29,070 --> 00:14:30,180
!سأتخلّص منه

212
00:14:32,180 --> 00:14:33,770
.أعرني ذلك المدفع الشّعاعيّ

213
00:14:33,770 --> 00:14:34,640
!ماذا؟

214
00:14:36,390 --> 00:14:38,110
.إنّها مصنوعة من خليط معدن الغاندانيوم

215
00:14:38,710 --> 00:14:40,600
.لن تجدي بندقيّة بذلة أسد نفعًا

216
00:14:41,070 --> 00:14:45,230
الغاندام المسؤولة عن سوء التّفاهم
بين الأرض والمستعمرات

217
00:14:45,230 --> 00:14:49,610
وسبّبت الدّمار ستُدمّر على يد مواطن
.من المستعمرات يسعى للسّلام

218
00:14:50,200 --> 00:14:52,820
!سيّداتي وسادتي، كونوا شهداء على هذا

219
00:14:54,030 --> 00:14:55,610
.يا حاصدة الأرواح

220
00:14:55,610 --> 00:14:57,040
.لا تستسلمي بسهولة

221
00:14:57,630 --> 00:14:59,970
ستكونين بخير، أليس كذلك؟

222
00:14:59,970 --> 00:15:01,500
ستكونين بخير، صحيح؟

223
00:15:01,950 --> 00:15:03,960
.سأبدأ الاختبار الثّاني

224
00:15:19,770 --> 00:15:20,860
.سُحقًا

225
00:15:21,390 --> 00:15:25,190
!سُحقًا

226
00:15:28,400 --> 00:15:32,450
.لم تتغيّر موجات دماغ تروا بارتون ولا نبضه

227
00:15:32,450 --> 00:15:34,170
.إنّه إذًا الطّيّار المثاليّ

228
00:15:34,170 --> 00:15:36,620
.لكن ما زالت تساورني شكوك حوله

229
00:15:37,090 --> 00:15:39,800
.واضح أنّ ذلك الفتى عازم على التّعاون مع أوز

230
00:15:40,350 --> 00:15:43,080
.أصحاب المواهب الفذّة قادرون على فهمنا

231
00:15:46,670 --> 00:15:47,550
ما هذه؟

232
00:15:50,490 --> 00:15:51,470
...إنّها

233
00:15:52,870 --> 00:15:53,930
.دموعي

234
00:16:06,020 --> 00:16:07,860
.النّوع الجديد من البذل المتنقّلة

235
00:16:10,060 --> 00:16:11,820
.ما زالت العديد من الأجزاء قيد التّصميم

236
00:16:12,440 --> 00:16:13,940
.سأدمّرها جميعها

237
00:16:24,540 --> 00:16:27,750
يا طيّار الاختبار 1، ترغب العقيد
.ليدي أن بالحديث معك

238
00:16:27,750 --> 00:16:28,710
!انتظر هناك

239
00:16:30,380 --> 00:16:31,300
.عُلم

240
00:16:33,250 --> 00:16:34,930
!العقيد ليدي أن

241
00:16:34,930 --> 00:16:36,140
!هذا خطير

242
00:16:36,140 --> 00:16:39,010
!ما زال من المحتمل أن يكون طيّار غاندام

243
00:16:40,340 --> 00:16:43,480
.أظنّ أنّه سيكون من الحكمة لقاؤه بنفسي

244
00:16:44,710 --> 00:16:47,580
.أتى محاولاً فهم أوز

245
00:16:47,580 --> 00:16:50,340
.سيكون من الفظاظة عدم لقائه

246
00:16:50,340 --> 00:16:52,980
.أنا واثقة أنّ لدينا الكثير لنتحدّث عنه

247
00:16:52,980 --> 00:16:55,040
.كلانا شخص يحبّ الفضاء الخارجيّ

248
00:16:55,040 --> 00:16:55,950
!أيّتها العقيد

249
00:16:56,400 --> 00:16:59,530
أيّها الملازم نيكول، ما سبب خوفك؟

250
00:17:00,000 --> 00:17:01,240
خوفي؟

251
00:17:02,850 --> 00:17:05,270
لنضع حدًّا للقتال، موافق؟

252
00:17:11,620 --> 00:17:13,030
.سررت بلقائك

253
00:17:13,030 --> 00:17:14,760
.أنا ليدي أن

254
00:17:15,280 --> 00:17:16,610
.هذه هي ليدي أن

255
00:17:16,610 --> 00:17:20,470
.القائد العامّ لعمليّات أوز الفضائيّة

256
00:17:21,060 --> 00:17:26,480
لديك خبرة في البذل المتنقّلة العاملة في عملك
.في إصلاح الجدار الخارجيّ للمستعمرات

257
00:17:26,480 --> 00:17:30,690
نتائج اختبارك المميّزة اليوم
.أذهلت جنود أوز بالكامل

258
00:17:31,210 --> 00:17:34,560
لطالما شعرت أنّي أملك ما يتطلّبه
.الأمر لأكون جنديًّا

259
00:17:34,560 --> 00:17:36,280
فهل يعني هذا أنّي مقبول؟

260
00:17:36,820 --> 00:17:39,370
لنعمل معًا لإحلال السّلام
.في الفضاء الخارجيّ

261
00:17:40,030 --> 00:17:44,490
آمُل فقط أن تكون قدراتي مفيدة
.في هزيمة قوّات التّحالف الفضائيّة

262
00:17:45,210 --> 00:17:47,830
.لم أفكّر أبدًا في إحلال السّلام في الفضاء

263
00:17:48,470 --> 00:17:52,050
.وبعدها فكّرت أنّي الشّخص المناسب لأوز

264
00:17:52,720 --> 00:17:53,760
الشّخص المناسب لأوز؟

265
00:17:54,360 --> 00:17:59,620
أذهلني كيف فردت أوز سيطرتها على الفضاء
.بشكل تدريجيّ بينما تتظاهر بالصّداقة

266
00:17:59,620 --> 00:18:03,350
قد يرى النّاس هذا كعمل شنيع
.لكنّه يناسبني

267
00:18:03,890 --> 00:18:04,980
فرد السّيطرة؟

268
00:18:04,980 --> 00:18:06,430
ماذا تعني بـ"عمل شنيع"؟

269
00:18:07,020 --> 00:18:09,470
.أوز هي مكان يتمّ الاعتراف فيه بالماكرين

270
00:18:10,210 --> 00:18:11,150
.هذا ما هي عليه

271
00:18:11,680 --> 00:18:12,670
.كلاّ

272
00:18:13,970 --> 00:18:14,860
...أنت مخطئ

273
00:18:18,730 --> 00:18:20,160
!هذا ليس صحيحًا

274
00:18:22,530 --> 00:18:23,520
!أيّتها العقيد

275
00:18:24,620 --> 00:18:26,130
!تحتاج لترتاح قليلاً

276
00:18:27,280 --> 00:18:28,480
.رجاءً أيّتها العقيد

277
00:18:28,480 --> 00:18:29,570
.من هنا

278
00:18:31,610 --> 00:18:33,140
ماذا حدث لها؟

279
00:18:33,140 --> 00:18:35,920
.ربّما تكون قد خدعت العقيد، لكن لم تخدعني

280
00:18:35,920 --> 00:18:37,300
.تروا بارتون

281
00:18:37,300 --> 00:18:42,250
أمرتك العقيد أن تعود بعد ساعتين
.لتختبر بذل أوز المتنقّلة الجديدة

282
00:18:42,250 --> 00:18:44,130
...لكنّ العقيد كانت

283
00:18:44,130 --> 00:18:46,930
تكون العقيد ليدي أن أقوى
.بكثير وهي ترتدي زيّها

284
00:18:47,510 --> 00:18:50,370
.قد تفكّر في قتل بشخص مشكوك في أمره مثلك

285
00:19:02,910 --> 00:19:05,990
أنا هي ليدي أن من أوز؟

286
00:19:06,700 --> 00:19:08,650
أم أنّي أعمل لدى السّيّد تيريز؟

287
00:19:22,050 --> 00:19:24,510
لم تأخذي وقتًا لتعثري على طيّاريك، صحيح؟

288
00:19:24,510 --> 00:19:29,240
اُختير هؤلاء الخمسة من مواطني
.المستعمرات كطيّارين محتملين

289
00:19:29,240 --> 00:19:31,400
.وهذا هو تروا بارتون

290
00:19:31,400 --> 00:19:32,970
.إنّه مميّز

291
00:19:32,970 --> 00:19:35,480
.سيكون قادرًا على قيادة أيّ بذلة

292
00:19:35,860 --> 00:19:39,070
.لن تكون بذلنا المتنقّلة هذه سهلة للقيادة

293
00:19:39,490 --> 00:19:41,610
.سمعتُ أنّها أفضل من الغاندام

294
00:19:41,610 --> 00:19:42,530
.لا أطيق الانتظار

295
00:19:43,810 --> 00:19:44,990
ما مدى تقدّمكم؟

296
00:19:45,430 --> 00:19:51,090
بذلة ميركوري منتهية بنسبة 80 بالمائة
.وبذلة فاييت بنسية 50 بالمائة

297
00:19:51,090 --> 00:19:54,170
ما الهدف وراء تطوير نموذجين؟

298
00:19:54,170 --> 00:19:57,170
صّممنا هذين النّموذجين

299
00:19:57,170 --> 00:20:02,540
،كمبدأين متعارضين في القتال
.إنّهما يشكّلان الدّفاع والهجوم المطلقين

300
00:20:02,540 --> 00:20:07,570
أضفنا إلى بذلة فاييت أكبر مدفع شعاعيّ
.ممكن دون التّأثير على حركيّتها

301
00:20:07,570 --> 00:20:12,640
وأضفنا لبذلة ميركوري درعًا دفاعيًّا
.قادر على صدّ مدفع شعاعيّ كهذا

302
00:20:13,080 --> 00:20:15,990
لمن ستكون الغلبة إن تعاركا؟

303
00:20:15,990 --> 00:20:19,580
في العادة، ستكون الغلبة لصاحبة
.الطّيّار الأفضل

304
00:20:19,580 --> 00:20:20,490
!كفاك عبثًا

305
00:20:21,110 --> 00:20:23,960
إذًا فالسّباق لتحديد تفوّق البذل المتنقّلة

306
00:20:23,960 --> 00:20:27,700
لا فائدة منه بما أنّ قيمتهما تعتمد
مباشرة على قدرات الطّيّار؟

307
00:20:29,010 --> 00:20:32,150
.أنت ذكيّ. يمكنني أن أرى لماذا اختارتك أوز

308
00:20:32,150 --> 00:20:33,200
!معك حقّ

309
00:20:33,200 --> 00:20:35,140
!اخرس يا تروا

310
00:20:35,140 --> 00:20:36,060
!دعه وشأنه

311
00:20:36,060 --> 00:20:38,110
.سوف يقود واحدة من هاتين البذلتين

312
00:20:38,110 --> 00:20:39,480
.سأسمح له بطرح الأسئلة

313
00:20:39,480 --> 00:20:41,410
.حا-حاضر

314
00:20:41,410 --> 00:20:44,250
أيّ اختبار ستقومون بعرضه لنا اليوم؟

315
00:20:44,250 --> 00:20:45,180
!صحيح

316
00:20:45,460 --> 00:20:47,930
.سأريكم نظام ميركوري الدّفاعيّ

317
00:20:47,930 --> 00:20:53,390
إنّه النّظام الأحدث، بحيث يخلق مجالاً كهربائيًّا
.يسمح له بعكس أيّ شعاع أطلقه العدوّ

318
00:20:54,180 --> 00:20:55,340
وبذلة فاييت؟

319
00:20:55,670 --> 00:20:58,000
.ما زالت بذلة فاييت قيد التّطوير

320
00:20:58,000 --> 00:21:00,620
.إنّها ليست مشحونة بالطّاقة من الأساس

321
00:21:00,620 --> 00:21:01,900
ما هذا؟

322
00:21:01,900 --> 00:21:03,320
!بذلة فاييت تتحرّك

323
00:21:11,540 --> 00:21:13,340
!شغّلوا درع ميركوري

324
00:21:13,340 --> 00:21:14,340
!في الحال

325
00:21:26,540 --> 00:21:27,340
!أيّتها العقيد

326
00:21:54,580 --> 00:21:56,250
هل أنت بخير؟

327
00:21:56,250 --> 00:21:57,480
...هذا مؤلم

328
00:21:57,480 --> 00:21:58,690
ماذا أخبرتك؟

329
00:21:58,690 --> 00:22:01,390
سلاحي، إنّه مميّز، صحيح؟

330
00:22:01,390 --> 00:22:02,590
.هذا أكيد

331
00:22:02,870 --> 00:22:04,990
!حتّى أنّه أتى سعيًا خلفنا

332
00:22:04,990 --> 00:22:06,420
!يا له من سلاح

333
00:22:12,970 --> 00:22:16,890
يُـتـبـع

334
00:22:24,820 --> 00:22:30,990
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

335
00:22:32,450 --> 00:22:38,710
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

336
00:22:39,500 --> 00:22:43,380
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

337
00:22:43,630 --> 00:22:46,840
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

338
00:22:47,340 --> 00:22:53,390
حبّ فحسب! إنّه يثير أعصابي

339
00:22:55,180 --> 00:23:02,150
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

340
00:23:02,520 --> 00:23:09,650
حبّ فحسب! أنا دائمة التّفكير به

341
00:23:10,700 --> 00:23:17,080
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

342
00:23:18,000 --> 00:23:21,080
... حبّ فحسب ...

343
00:23:27,920 --> 00:23:29,920
في الحلقة القادمة

344
00:23:31,680 --> 00:23:34,680
.تقترب بذلة متنقّلة بيضاء من المستعمرات

345
00:23:35,190 --> 00:23:37,890
بمجرّد أن تمّ التّعرّف عليها على
،أنّها تالغيس التّابعة لزيكس

346
00:23:38,240 --> 00:23:41,890
.أمرت ليدي أن تروا وهيرو بمهاجمتها

347
00:23:42,240 --> 00:23:46,180
.يعود كاتر المصاب إلى قصر وينر

348
00:23:46,180 --> 00:23:50,170
لكنّه يحزن كثيرًا عندما يكتشف أنّ والده

349
00:23:50,170 --> 00:23:52,100
.يتعرّض للّوم والانتقاد من طرف الشّعب

350
00:23:52,940 --> 00:23:56,400
،"في الحلقة الواحدة العشرين من "جناح الغاندام

351
00:23:56,400 --> 00:23:57,880
."كاتر الحزين"