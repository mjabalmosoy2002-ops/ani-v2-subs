1
00:00:12,030 --> 00:00:15,320
مجرّد نبض تواصل جامح

2
00:00:15,530 --> 00:00:18,990
أقف في المطر الجارح

3
00:00:19,160 --> 00:00:22,620
أريد إظهار مشاعري المتّقدة الخالدة

4
00:00:22,750 --> 00:00:27,790
!عن طريق جسدي بالكامل اللّيلة

5
00:00:33,840 --> 00:00:40,680
أتشبّث بكتفيك المبلّلين لمنحك الدّفء والرّاحة

6
00:00:40,850 --> 00:00:48,020
ما الّذي تسعى إليه هذه الأصابع المرتعشة؟

7
00:00:48,650 --> 00:00:55,200
أريد حماية النّظرة الصّادقة في عينك

8
00:00:55,950 --> 00:01:02,750
مؤمنة بالحبّ الّذي سيُحيلُ الحزنَ قوّة

9
00:01:02,830 --> 00:01:06,370
مجرّد نبض تواصل جامح

10
00:01:06,500 --> 00:01:10,090
أقف في المطر الجارح

11
00:01:10,250 --> 00:01:13,670
أريد إظهار مشاعري المتّقدة الخالدة

12
00:01:13,800 --> 00:01:18,510
!عن طريق جسدي بالكامل اللّيلة

13
00:01:22,560 --> 00:01:24,050
.قُبلت المهمّة

14
00:01:43,650 --> 00:01:45,500
.ذلك ما فعله هيرو

15
00:01:45,500 --> 00:01:46,460
.لقد قتل نفسه

16
00:01:47,170 --> 00:01:48,840
!هذا وعد منّي

17
00:01:48,840 --> 00:01:51,840
.ستقاتل الغاندام خاصّتي ثانية يومًا ما

18
00:01:59,430 --> 00:02:03,620
بعد التّخطيط لانقلاب بهدف إسقاط
،تحالف المجال الأرضيّ المتّحد

19
00:02:03,620 --> 00:02:07,850
واصلت أوز خلق كارثة تلو الأخرى
.في مسعاها لتدمير التّحالف

20
00:02:08,540 --> 00:02:12,060
،بما أنّ للتّحالف كيان في كلّ بلاد

21
00:02:12,060 --> 00:02:14,800
.نتوقّع نزايد أعداد الضّحايا

22
00:02:16,820 --> 00:02:17,940
...ريلينا

23
00:02:19,910 --> 00:02:20,880
!استعدتَ وعيك

24
00:02:20,880 --> 00:02:23,080
!مهلاً، سأحضر تروا

25
00:02:23,590 --> 00:02:24,560
تروا؟

26
00:02:25,890 --> 00:02:27,650
!عليك أن تتروّ

27
00:02:28,930 --> 00:02:30,790
!تروا، لقد استيقظ صديقك

28
00:02:36,340 --> 00:02:38,590
!لا بدّ أنّك جائع

29
00:02:38,590 --> 00:02:40,200
.سأذهب لإعداد بعض الحساء

30
00:02:42,070 --> 00:02:43,330
أين أنا؟

31
00:02:43,330 --> 00:02:45,540
.هذا مخيّم سيرك متنقّل

32
00:02:46,380 --> 00:02:47,770
.أنا أختبئ هنا

33
00:02:48,610 --> 00:02:50,070
لماذا أنقذتني؟

34
00:02:50,070 --> 00:02:52,140
.كان من المفترض أن أموت

35
00:02:52,620 --> 00:02:54,730
.لقد مُتَّ منذ زمن بعيد

36
00:02:56,220 --> 00:03:02,040
تجاهلت القوّات الّتي تثأر من أوز
نصيحتنا بشأن نزع السّلاح

37
00:03:02,040 --> 00:03:04,740
وتتسبّب بمذابح لا ضرورة
.منها حول العالم

38
00:03:05,960 --> 00:03:09,490
.مرّ شهر، ولم تلمس أوز المستعمرات

39
00:03:10,270 --> 00:03:12,980
.إنّها تقاتل البلدان العسكريّة على الأرض فحسب

40
00:03:15,640 --> 00:03:16,960
!مرّ شهر؟

41
00:03:17,780 --> 00:03:19,870
.أنت ميت سلفًا في نظر أوز

42
00:03:23,250 --> 00:03:25,720
.ما عدتَ مرتبطًا بالمستعمرات

43
00:03:26,620 --> 00:03:28,270
.وضعي ليس بتلك البساطة

44
00:03:28,790 --> 00:03:30,070
وجدوك؟

45
00:03:30,070 --> 00:03:31,140
.لا

46
00:03:31,140 --> 00:03:34,020
.لكن لم تصلنا مهمّة واحدة مذّاك اليوم

47
00:03:34,560 --> 00:03:35,230
.فهمت

48
00:03:39,630 --> 00:03:41,590
.لستُ واثقًا ما العمل

49
00:03:41,590 --> 00:03:45,030
ماذا إن استعملت أوز المستعمرات كدرع ثانية؟

50
00:03:47,840 --> 00:03:49,870
أو هل عليّ أن أتّبع خطاك؟

51
00:03:50,550 --> 00:03:52,530
.في تلك الحالة، لديّ تحذير لك

52
00:03:53,980 --> 00:03:55,250
.الأمر مؤلم بشدّة

53
00:04:00,800 --> 00:04:04,130
أعتقد أنّ هذه أوّل مرّة على الأرجح
.الّتي أسمع فيها تروا يضحك هكذا

54
00:04:04,570 --> 00:04:07,670
.لديّ طلب، الأوّل منذ مجيئي للأرض

55
00:04:07,670 --> 00:04:12,100
ما الّذي حدث حول العالم
وأنا فاقد لوعيي؟

56
00:04:13,900 --> 00:04:14,810
.هكذا إذًا

57
00:04:34,490 --> 00:04:36,460
.يا لها من صفقةِ جناحٍ قويّة

58
00:04:44,900 --> 00:04:45,660
!اركبوا بسرعة

59
00:04:46,150 --> 00:04:47,400
!بسرعة يا سالي

60
00:04:47,930 --> 00:04:49,530
!لنغادر جميعًا

61
00:04:59,140 --> 00:05:00,100
.هذه سالي

62
00:05:00,100 --> 00:05:01,730
!تمّت الانفجارات بنجاح. نحن نتراجع

63
00:05:06,120 --> 00:05:07,610
!ما هذه الجلبة؟

64
00:05:07,610 --> 00:05:09,070
.مقاتلو حرب عصابات أيّها العقيد بونت

65
00:05:09,660 --> 00:05:11,010
!اتبعوهم

66
00:05:11,010 --> 00:05:12,750
!سنسحقهم هذه المرّة

67
00:05:12,750 --> 00:05:13,160
!حاضر

68
00:05:17,930 --> 00:05:21,320
،في منطقة جبليّة مستقلّة في الصّين القديمة

69
00:05:21,320 --> 00:05:25,120
.اُغتيل قائد سياسيّ عرضَ إقامة السّلام

70
00:05:25,120 --> 00:05:29,350
.دعا إلى نزع السّلاح وعارضَ الجيش الحاليّ

71
00:05:31,980 --> 00:05:36,390
.استهدفه جيش التّحالف خلال انقلاب

72
00:05:37,220 --> 00:05:41,100
كان العقيد بونت، المتزعّم، معارضًا
لمبادرة السّلام هذه

73
00:05:41,100 --> 00:05:45,380
وقال أنّه يجب تقوية الجيش لكي
.تحقّق البلاد الاستقلال

74
00:05:46,080 --> 00:05:48,530
،وبما أنّ أوز تفكّك صفوف التّحالف الآن

75
00:05:48,530 --> 00:05:52,490
ازدادت الحروب الأهليّة
.في بلدان مستقلّة كهذه

76
00:05:59,600 --> 00:06:00,750
!نلنا منهم

77
00:06:02,410 --> 00:06:03,700
ما الخطب يا سالي؟

78
00:06:04,110 --> 00:06:05,440
.لا تقلق بشأن ذلك

79
00:06:06,480 --> 00:06:07,600
.آسف

80
00:06:07,600 --> 00:06:12,470
هذه أوّل مرّة تعودين فيها لموطنك
.منذ مدّة وقد وضعناك في خطر محدق

81
00:06:12,470 --> 00:06:13,340
.لا تعتذر

82
00:06:13,340 --> 00:06:14,600
.كان ذلك قراري

83
00:06:15,190 --> 00:06:16,240
!يا رفاق

84
00:06:16,240 --> 00:06:17,540
هل أنتم بخير؟

85
00:06:17,540 --> 00:06:19,390
!نعم، نجحنا نجاحًا باهرًا

86
00:06:25,930 --> 00:06:26,920
!ماذا؟

87
00:06:26,920 --> 00:06:29,020
!هذه بذل الأسد، بذل برّيّة متنقّلة

88
00:06:36,740 --> 00:06:39,290
!أمر العقيد بونت ألاّ نسمح لأحد بالهروب

89
00:06:43,090 --> 00:06:44,070
!حمقى

90
00:06:49,420 --> 00:06:50,340
!وجدناهم

91
00:06:50,340 --> 00:06:51,260
!إنّهم يتسلّقون المنحدر

92
00:06:52,820 --> 00:06:54,920
!ذلك السّلاح بلا فائدة في وجه البذل

93
00:06:55,260 --> 00:06:56,970
!هدفي هو تدمير الكاميرا الأساسيّة

94
00:06:57,530 --> 00:06:59,880
!لن أقول لك ضعي سلاحك أرضًا

95
00:06:59,880 --> 00:07:00,730
!بل سأقتلك

96
00:07:02,330 --> 00:07:03,890
!أخبرتك، لا فائدة من ذلك

97
00:07:08,110 --> 00:07:08,940
الدّعم؟

98
00:07:10,910 --> 00:07:12,320
!هذه غاندام

99
00:07:12,940 --> 00:07:13,830
غاندام؟

100
00:07:13,830 --> 00:07:14,700
ماذا؟

101
00:07:14,950 --> 00:07:15,780
!نار

102
00:07:15,780 --> 00:07:16,870
!نار! نار

103
00:07:19,820 --> 00:07:21,580
.لا أنوي القتال

104
00:07:22,420 --> 00:07:23,460
.أسرعوا بالتّراجع

105
00:07:25,960 --> 00:07:28,210
!لا يمكننا هزيمة ذلك الشّيء

106
00:07:28,630 --> 00:07:30,970
!لا تستخفّوا بناتاكو

107
00:07:36,300 --> 00:07:37,220
!سُحقًا

108
00:07:45,140 --> 00:07:46,240
...إنّها غاندام

109
00:07:50,750 --> 00:07:52,740
ما الّذي تفعله غاندام هنا؟

110
00:07:55,990 --> 00:07:57,830
.لا يجدر بالضّعفاء أمثالكم أن يقاتلوا

111
00:07:58,410 --> 00:07:59,450
!ماذا قلت؟

112
00:08:02,860 --> 00:08:05,980
!لماذا تقاتلون عدوًّا لا فرصة لكم أمامه؟

113
00:08:05,980 --> 00:08:08,470
!لأنّها معركة علينا خوضها

114
00:08:08,900 --> 00:08:10,420
هل أمركم أحد بذلك؟

115
00:08:10,670 --> 00:08:11,660
!كلاّ

116
00:08:11,660 --> 00:08:13,380
!نتصرّف بملء إرادتنا

117
00:08:15,210 --> 00:08:16,390
.لا أفهم

118
00:08:20,010 --> 00:08:22,240
.تبدو متعبًا نوعًا ما

119
00:08:22,880 --> 00:08:24,800
.تعال معنا واسترح

120
00:08:24,800 --> 00:08:25,530
!سالي

121
00:08:25,530 --> 00:08:26,670
.لا مشكلة

122
00:08:26,670 --> 00:08:28,670
.نعلم أنّه ليس عدوًّا

123
00:08:28,670 --> 00:08:29,360
ما قولك؟

124
00:08:31,920 --> 00:08:33,320
!كانت بذلة غاندام؟

125
00:08:33,320 --> 00:08:34,450
!أأنت واثق؟

126
00:08:34,910 --> 00:08:35,680
!نعم

127
00:08:35,680 --> 00:08:37,070
!سأظهر البيانات على الشّاشة

128
00:08:40,170 --> 00:08:41,870
.هذه بذلة غاندام بالفعل

129
00:08:43,170 --> 00:08:46,050
حتّى أوز تواجه مشاكل في السّيطرة
.على هذه الغاندام

130
00:08:46,050 --> 00:08:47,760
!سأعود للقاعدة

131
00:08:47,760 --> 00:08:48,700
.حسنًا

132
00:08:53,680 --> 00:08:55,050
أنمتَ جيّدًا ليلة البارحة؟

133
00:08:55,360 --> 00:08:56,400
.نعم

134
00:08:56,400 --> 00:08:59,680
لم تكن بحاجة للمساعدة
.في إحضار الطّعام

135
00:09:00,250 --> 00:09:01,640
.أنا أردّ لكم المعروف

136
00:09:01,640 --> 00:09:03,520
!نحن من ندين لك بمعروف

137
00:09:04,260 --> 00:09:05,910
.لم أكن أنا من أنقذكم

138
00:09:05,910 --> 00:09:06,480
.بل ناتاكو

139
00:09:06,670 --> 00:09:07,940
ناتاكو؟

140
00:09:07,940 --> 00:09:09,600
هل ذلك هو اسم الغاندام؟

141
00:09:11,000 --> 00:09:11,960
...حسنًا

142
00:09:17,700 --> 00:09:19,030
.هذا هو الأخير

143
00:09:26,580 --> 00:09:28,130
.من الأفضل أن تنتبه لِما تقوله

144
00:09:29,110 --> 00:09:30,770
!توقّفوا رجاءً، أتوسّل إليكم

145
00:09:30,770 --> 00:09:31,930
!أطبق فمك

146
00:09:31,930 --> 00:09:34,700
كنتُ أطلب منكم دفع ثمن
!ما أكلتموه فحسب

147
00:09:34,700 --> 00:09:37,470
!عليك أن تكون ممتنًّا لنا لامتلاكك هذا المحلّ

148
00:09:37,470 --> 00:09:38,550
أتفهم؟

149
00:09:39,790 --> 00:09:43,080
!تريد مالاً من الجنود الّذي يوفّرون الحماية؟

150
00:09:43,080 --> 00:09:45,710
وما الّذي تحمونه على أيّ حال؟

151
00:09:45,710 --> 00:09:46,390
!ماذا؟

152
00:09:47,200 --> 00:09:51,110
كلّ ما تفعلونه هو ملازمتكم لبونت
.والدّوس على جهود البلاد نحو السّلام

153
00:09:51,600 --> 00:09:53,070
ما الّذي قلتِه؟

154
00:09:54,870 --> 00:09:55,820
!أيّتها الحقيرة

155
00:10:05,880 --> 00:10:08,080
!هذا لأنّك تعارضيننا

156
00:10:15,960 --> 00:10:17,220
!أيّها الوغد

157
00:10:18,130 --> 00:10:20,720
.يكفي! لقد هُزمتم

158
00:10:26,040 --> 00:10:28,060
!ما-ما الّذي دهاكم؟

159
00:10:28,060 --> 00:10:29,120
...اهدأ

160
00:10:29,120 --> 00:10:29,810
!سُحقًا

161
00:10:30,610 --> 00:10:32,260
!سننال منكم المرّة القادمة

162
00:10:34,950 --> 00:10:36,530
.شكرًا لك يا ووفي

163
00:10:36,530 --> 00:10:38,130
.لقد أنقذتنا ثانية

164
00:10:38,130 --> 00:10:39,800
.أنت ضعيفة جدًّا على القتال

165
00:10:41,950 --> 00:10:43,830
.لا حقّ لي في القتال

166
00:10:44,330 --> 00:10:45,420
...ووفي

167
00:10:45,720 --> 00:10:47,310
.أنا مجرّد جبان

168
00:10:47,310 --> 00:10:50,420
.لا يمكنني فهم كيف تنعت نفسك بالجبان

169
00:10:51,000 --> 00:10:52,550
.هذا لأنّي خسرت

170
00:10:52,550 --> 00:10:54,650
.خسرتُ في مواجهة رجل أقوى منّى

171
00:10:54,650 --> 00:10:58,380
أنا جبان لا يمكنه قتال
.إلاّ من هم أضعف منه

172
00:10:59,140 --> 00:11:00,990
ألهذا السّبب استسلمت؟

173
00:11:00,990 --> 00:11:03,790
ألم تكن تقاتل من أجل المستعمرات؟

174
00:11:03,790 --> 00:11:05,060
للظّفر بالسّلام ثانية؟

175
00:11:05,840 --> 00:11:08,390
.لا يحقّ لي القتال مع ناتاكو

176
00:11:08,390 --> 00:11:10,230
!أنقذت حياتي البارحة

177
00:11:10,880 --> 00:11:12,350
.هذا لأنّكم ضعفاء

178
00:11:12,930 --> 00:11:14,000
.معك حقّ

179
00:11:14,000 --> 00:11:15,410
.نحن ضعفاء

180
00:11:15,410 --> 00:11:17,010
!لكنّنا لا نستسلم

181
00:11:17,010 --> 00:11:18,940
!ينضمّ النّاس لنا للقتال لأنّنا ضعفاء

182
00:11:20,730 --> 00:11:22,240
.كما فعلتَ أنت

183
00:11:25,430 --> 00:11:28,460
.لا يحقّ لي القتال مع ناتاكو

184
00:11:31,310 --> 00:11:32,700
...ووفي

185
00:11:39,620 --> 00:11:44,350
حدّدنا من هذه البيانات أنّ هذه المنطقة
.ربّما تكون مقرّ مقاتلي حرب العصابات

186
00:11:45,430 --> 00:11:46,690
.فهمت

187
00:11:46,690 --> 00:11:48,770
.عرفنا أخيرًا أين يختبئون

188
00:11:48,770 --> 00:11:50,090
.لكن لديهم الغاندام

189
00:11:50,620 --> 00:11:52,650
.إنّ الغاندام قوية للغاية في المعارك

190
00:11:53,110 --> 00:11:55,860
إن قاتلناها مباشرة، فستلحق أضرارًا
.جسيمة لقوّاتنا

191
00:11:56,410 --> 00:12:00,860
لماذا لا نطلب مساعدة أوز ونجهّز
لهجوم مشترك نظرًا لهذا الوضع؟

192
00:12:01,630 --> 00:12:03,170
!لا أوافق

193
00:12:03,170 --> 00:12:06,390
سيُعطي ذلك أوز عذرًا لغرس
.جذور لهم في بلادنا

194
00:12:06,390 --> 00:12:08,110
ماذا عن حكومتنا الذّاتيّة؟

195
00:12:08,110 --> 00:12:12,500
.علينا القتال وحدنا لنثبت أنفسنا لمواطنينا

196
00:12:12,500 --> 00:12:14,120
هل ما تزال تفضّل هذه الفكرة؟

197
00:12:15,060 --> 00:12:16,810
.أيّها الرّائد ناناكي

198
00:12:16,810 --> 00:12:21,400
ما كنتُ لأريد المخاطرة بخسارة
.حتّى واحد من نخبة جنودك

199
00:12:21,400 --> 00:12:26,360
شكرًا على ذلك، لكنّنا أقسمنا بأرواحنا
.لهذه البلاد عندما أعلنّا الاستقلال

200
00:12:26,360 --> 00:12:27,750
!هذا صحيح أيّها العقيد

201
00:12:27,750 --> 00:12:29,810
!علينا حماية بلادنا بأنفسنا

202
00:12:29,810 --> 00:12:31,600
!هذا ما يجعلنا بلادًا مستقلّة

203
00:12:31,920 --> 00:12:32,620
!جيّد

204
00:12:32,620 --> 00:12:34,680
!أفهم عزمكم جميعًا

205
00:12:34,680 --> 00:12:37,850
لنقضِ على مقاتلي حروب العصابات
!بقوّاتنا الخاصّة

206
00:12:37,850 --> 00:12:39,480
!من أجل موطننا

207
00:12:39,480 --> 00:12:40,070
!حاضر

208
00:12:50,200 --> 00:12:52,160
كيف سار الأمر يا سالي؟

209
00:12:52,160 --> 00:12:54,920
.ماذا؟ ظننتُ أنّ ذلك الفتى ذهب معك

210
00:12:54,920 --> 00:12:56,330
.حدث قتال بسيط

211
00:12:56,330 --> 00:12:57,380
.فهمت

212
00:12:57,960 --> 00:13:00,210
حسنًا، على الأرجح أنّه لن يترك
.ذلك الشّيء خلفه

213
00:13:01,420 --> 00:13:02,170
.معك حقّ

214
00:13:02,920 --> 00:13:06,340
سيكون من الرّائع إن قاتل
.معنا ذلك الفتى

215
00:13:06,800 --> 00:13:10,140
لا يجب على أيّ أحد أن يجبره
.على القتال في الوقت الحاليّ

216
00:13:10,140 --> 00:13:11,010
لماذا؟

217
00:13:12,020 --> 00:13:14,060
.إنّه مرتبك كثيرًا الآن

218
00:13:14,060 --> 00:13:18,650
،كان يُتوقّع الكثير منه خلال الحرب
.لكنّه لم يرتقي لتلك التّطلّعات

219
00:13:18,650 --> 00:13:20,650
.لذلك يظنّ نفسه خاسرًا

220
00:13:20,650 --> 00:13:22,650
.أفهم ما تقولينه

221
00:13:22,650 --> 00:13:25,200
.أنت طبيبة الجيش

222
00:13:25,200 --> 00:13:26,360
...سابقًا

223
00:13:27,200 --> 00:13:27,910
!ماذا؟

224
00:13:34,330 --> 00:13:36,290
!إنّه جيش الحكومة! إنّهم يهاجمون

225
00:13:36,920 --> 00:13:38,380
!ردّوا الهجوم

226
00:13:47,840 --> 00:13:51,510
أكّدت الحوّامات وجود قاذفات
!صواريخ لبذل متنقّلة قتاليّة

227
00:13:52,180 --> 00:13:55,810
سنطلق مدافع الصّواريخ ثمّ سنرسل
.قوّات البذل المتنقّلة

228
00:13:56,690 --> 00:13:57,600
!عُلم

229
00:13:57,600 --> 00:13:59,100
!استعداد، إطلاق

230
00:14:05,780 --> 00:14:09,820
تجاهلوا الغطاء النّاري وركّزوا على البذل
.المتنقّلة الّتي تتقدّم لفرض السّيطرة

231
00:14:16,960 --> 00:14:19,000
!يا وحدة الحوّامات، أين الغاندام؟

232
00:14:24,380 --> 00:14:25,590
!انظر هناك

233
00:14:26,300 --> 00:14:28,300
!أيّها الرّائد ناناكي! عثرنا على الغاندام

234
00:14:31,640 --> 00:14:32,430
!أيّها الرّائد

235
00:14:32,430 --> 00:14:33,930
!الغاندام لا تبادلنا القتال

236
00:14:33,930 --> 00:14:34,680
!جارِ إرسال بثّ عن الأمر

237
00:14:35,600 --> 00:14:37,060
!هنالك شبكة تمويه عليها

238
00:14:37,060 --> 00:14:38,140
!الطّيّار ليس على متنها

239
00:14:38,730 --> 00:14:39,600
!أيّها العقيد بونت

240
00:14:39,600 --> 00:14:41,270
.لا تردّ الغاندام الهجوم

241
00:14:41,270 --> 00:14:43,230
!يمكننا الفوز في هذه المعركة

242
00:14:43,820 --> 00:14:44,440
.جيّد

243
00:14:44,440 --> 00:14:45,900
.ستنضمّ لكم القوّات الرّئيسيّة

244
00:14:47,740 --> 00:14:49,820
.يبدو أنّ الأمور في صالحنا الآن

245
00:14:50,740 --> 00:14:53,290
.لصالحي أنا، ولصالحكم أنتم

246
00:14:58,620 --> 00:14:59,870
!ها هي

247
00:15:00,150 --> 00:15:02,730
لتتقدّم قوّات البذل المتنقّلة
.نحو الغاندام لمحاصرتها

248
00:15:02,730 --> 00:15:04,920
!إلى كافّة وحدات الإطلاق

249
00:15:04,920 --> 00:15:06,840
.صوّبي على الغاندام وتأهّبي للإطلاق

250
00:15:07,660 --> 00:15:08,590
!احذر

251
00:15:08,590 --> 00:15:09,470
ما الخطب؟

252
00:15:09,470 --> 00:15:10,970
!معك وحدة الإسناد

253
00:15:10,970 --> 00:15:11,760
!نتعرّض للهجوم

254
00:15:18,850 --> 00:15:20,190
!هذه بذل الحَمَل التّابعة لأوز

255
00:15:21,060 --> 00:15:22,020
!أيّها العقيد بونت

256
00:15:22,020 --> 00:15:24,060
!تنفّذ أوز هجومًا على قوّاتنا

257
00:15:24,060 --> 00:15:25,190
قوّاتنا؟

258
00:15:25,190 --> 00:15:28,570
!لكن أيّها الرّائد ناناكي، أوز جزء من قوّاتنا

259
00:15:28,570 --> 00:15:33,950
أرسلوا قوّات الإسناد لمساعدتنا
.على حماية بلادنا من خطر الغاندام

260
00:15:34,580 --> 00:15:37,370
لكن استاء عدد من الجنود من دعم أوز

261
00:15:37,370 --> 00:15:39,580
.وخانونا وانضمّوا إلى مقاتلي حرب العصابات

262
00:15:39,580 --> 00:15:41,080
!أيّها العقيد! ما الّذي تقوله؟

263
00:15:41,580 --> 00:15:43,360
.ما حدث تمامًا

264
00:15:44,170 --> 00:15:47,800
،بمجرّد أن تفرد أوز سيطرتها
.سيعود السّلام إلى بلادنا

265
00:15:47,800 --> 00:15:49,920
.أعتقد أنّ هذا سيكون شعور المواطنين أيضًا

266
00:15:50,340 --> 00:15:51,470
!هذا غباء

267
00:15:51,470 --> 00:15:54,470
من المستحيل أن يرغب المواطنون
!بحكم أوز لهم

268
00:15:54,470 --> 00:15:57,180
قالت أوز أنّها ستحترم رغبة
.بلادنا في حكم أنفسنا بأنفسنا

269
00:15:57,680 --> 00:16:00,430
.وسيحتفظون بي كقائد للدّولة بالطّبع

270
00:16:01,100 --> 00:16:04,360
!شكرًا على مساعدتك حتّى الآن يا ناناكي

271
00:16:04,360 --> 00:16:05,770
!أيّها العقيد بونت

272
00:16:05,770 --> 00:16:08,690
ألا يمكنك أن تفكّر في أيّ شيء
آخر عدا منصبك؟

273
00:16:13,110 --> 00:16:15,200
!سُحقًا! يا له من خائن

274
00:16:15,200 --> 00:16:17,370
!لقد باع بونت البلاد لأوز

275
00:16:17,990 --> 00:16:19,080
.حدث هذا ثانية

276
00:16:19,290 --> 00:16:22,160
تكرار لحروب لا طائل منها على يد
!أشخاص لا طائل منهم

277
00:16:31,340 --> 00:16:32,130
!أجل

278
00:16:32,130 --> 00:16:33,620
!ستفي طلقة أخرى بالغرض

279
00:16:41,760 --> 00:16:42,480
!مهلاً

280
00:16:43,850 --> 00:16:45,500
!تمالك نفسك

281
00:16:46,610 --> 00:16:47,900
.هذا أنت

282
00:16:47,900 --> 00:16:50,780
.أعتقد أنّي أصبت لأنّي ضعيف

283
00:16:51,570 --> 00:16:52,700
...لكنّك قويّ

284
00:16:53,240 --> 00:16:54,420
.دمّر أوز

285
00:16:54,420 --> 00:16:55,680
...أتوسّل إليك

286
00:16:59,830 --> 00:17:00,790
ووفي؟

287
00:17:01,400 --> 00:17:02,620
!مستحيل

288
00:17:04,670 --> 00:17:06,040
.ووفي، اهرب

289
00:17:06,040 --> 00:17:07,380
.الأمر ميؤوس منه

290
00:17:07,380 --> 00:17:09,450
!يمكننا صدّ العدوّ لبعض الوقت، لذلك أسرع

291
00:17:10,300 --> 00:17:12,050
!ما الّذي تقولينه يا سالي؟

292
00:17:12,050 --> 00:17:15,050
!أيّها الفتى، لماذا لا تقاتل وتساعدنا؟

293
00:17:15,050 --> 00:17:16,760
.لا أملك القوّة

294
00:17:17,140 --> 00:17:19,220
!لا تردّد هذا الهراء في وجهي

295
00:17:19,220 --> 00:17:22,140
...لو كان لديّ نصف قوّتك

296
00:17:22,140 --> 00:17:22,600
!تحرّكا

297
00:17:26,850 --> 00:17:28,940
هل أنت بخير يا فتى؟

298
00:17:29,400 --> 00:17:30,730
.ساعدني

299
00:17:30,730 --> 00:17:31,730
.أنهِ الأمر من أجلي

300
00:17:32,280 --> 00:17:34,990
...ضع حدًّا لهذا البؤس

301
00:17:37,950 --> 00:17:42,290
...تُحوّل الحروب أرواح النّاس لمجرّد ألعاب

302
00:17:42,290 --> 00:17:43,910
!لهذا نحتاج لإيمانٍ قويّ

303
00:17:48,380 --> 00:17:50,000
!سالي، ما الّذي تفعلينه؟

304
00:17:50,380 --> 00:17:53,460
ووفي، لديك كلّ ما تحتاج
.لتساعد على إنقاذ الضّعفاء

305
00:17:54,090 --> 00:17:57,050
!آمُل ألاّ تنسى امتلاكك لقلب طيب

306
00:18:03,430 --> 00:18:05,640
!سالي، هل فقدتِ عقلك؟

307
00:18:08,270 --> 00:18:13,320
.أدركتُ أنّ شفاء قلبك أهمّ بكثير من حياتي

308
00:18:13,650 --> 00:18:14,900
.أنا واثقة من ذلك

309
00:18:20,570 --> 00:18:21,660
!اهربي يا سالي

310
00:18:22,330 --> 00:18:23,120
!ووفي

311
00:18:26,160 --> 00:18:29,130
!ناتاكو، لا يحقّ لي أن أقودك

312
00:18:29,130 --> 00:18:31,330
...لكنّي الآن أطلب منك

313
00:18:31,330 --> 00:18:32,840
!أن تمنحيني قوّتك

314
00:18:33,920 --> 00:18:35,630
.نكاد ننتهي

315
00:18:36,130 --> 00:18:38,560
.نحتاج لتأمين الغاندام فحسب

316
00:18:39,640 --> 00:18:40,340
!أيّها العقيد

317
00:18:40,340 --> 00:18:41,760
!بدأت بذلة الغاندام تتحرّك

318
00:18:41,760 --> 00:18:42,550
!ماذا؟

319
00:18:47,430 --> 00:18:48,230
!لقد تحرّكت

320
00:19:10,120 --> 00:19:12,330
.لقد سحقت خمس بذل حَمَل بكلّ سهولة

321
00:19:12,330 --> 00:19:15,670
أيّها العقيد، لم يبقَ لنا الآن
!إلاّ بضعة بذل حَمَل أخرى

322
00:19:15,670 --> 00:19:17,400
!اجعلها غطاءً لنا ونحن نتراجع

323
00:19:18,800 --> 00:19:20,220
.لن تفلت منّي

324
00:19:42,030 --> 00:19:42,990
.ووفي

325
00:19:46,490 --> 00:19:50,930
رحيل بونت لن يوقف أوز عن
.محاولة السّيطرة على هذه البلاد

326
00:19:50,930 --> 00:19:52,620
هل ستواصلين القتال؟

327
00:19:53,790 --> 00:19:56,750
.العدالة... أمست كلمة رخيصة المعنى الآن

328
00:19:57,210 --> 00:20:00,200
قال كلّ من التّحالف وأوز أنّ السّلام
.والعدالة كانا هدفهما

329
00:20:01,220 --> 00:20:03,180
.لديّ حسّي الخاصّ بالعدالة

330
00:20:03,720 --> 00:20:06,350
.يملك الجميع حسّهم الخاصّ بالعدالة

331
00:20:06,640 --> 00:20:08,140
.حتّى أنت

332
00:20:08,850 --> 00:20:09,850
.تملك عدالتك الخاصّة

333
00:20:12,230 --> 00:20:14,310
من يقفون إلى جانب الحقّ
.يجب أن يكونوا أقوياء أيضًا

334
00:20:15,940 --> 00:20:19,490
.لا يحقّ للضّعفاء أن يستغلّوا قوّة ناتاكو

335
00:20:19,490 --> 00:20:21,150
.كنتَ مختلفًا هذه المرّة

336
00:20:21,860 --> 00:20:23,610
.كانت القوّة تملأ قلبك

337
00:20:24,620 --> 00:20:26,750
ما نفع القوّة إن لم يكن مصدرها القلب؟

338
00:20:28,370 --> 00:20:31,960
ووفي، عندما تكون قادرًا
على القتال مع ناتاكو

339
00:20:31,960 --> 00:20:33,040
.ساعدني ثانية أرجوك

340
00:20:33,920 --> 00:20:36,000
ما زلتِ تريدين القتال رغم ضعفكم؟

341
00:20:37,000 --> 00:20:39,340
.أهمّ شيء هو أنّ قلبي قويّ

342
00:20:42,300 --> 00:20:43,470
!اسمعوا

343
00:20:43,470 --> 00:20:45,590
!اجتمعوا حولي

344
00:20:46,600 --> 00:20:48,560
!تمّ تأكيد عرضنا التّالي

345
00:20:48,560 --> 00:20:49,930
!استعدوّا للخبر

346
00:20:49,930 --> 00:20:51,800
!حصلنا على طلب من  إحدى قواعد أوز

347
00:20:52,310 --> 00:20:53,100
من أوز؟

348
00:20:53,100 --> 00:20:56,610
.أريد تجربة شيء جديد احتفالاً بذلك

349
00:20:56,610 --> 00:21:00,360
ليكن شيئًا مميّزًا وحماسيًّا
.قد يستمتع به جنود أوز

350
00:21:01,150 --> 00:21:03,740
هل يمكنك أن تدع هذا العرض الجديد لي؟

351
00:21:04,450 --> 00:21:05,660
هل لديك أيّة أفكار؟

352
00:21:06,030 --> 00:21:08,830
نعم، وأظنّ أنّ وقعَ صداها
.سيكون كبيرًا لدى الجنود

353
00:21:08,830 --> 00:21:09,620
!جيّد

354
00:21:09,620 --> 00:21:12,620
لا بدّ أنّها فكرة جيّدة بما أنّ تروا
.يكون هادئًا في العادة

355
00:21:13,960 --> 00:21:15,170
!حسنًا، هذا جيّد

356
00:21:15,170 --> 00:21:16,210
!الأمر بين يديك يا تروا

357
00:21:17,500 --> 00:21:19,170
.سأترك الطّعام ومفاتيح السّيّارة

358
00:21:19,880 --> 00:21:21,590
.ابقَ هنا وركّز على أن تتحسّن

359
00:21:23,300 --> 00:21:24,630
ما الّذي ستفعله؟

360
00:21:24,630 --> 00:21:27,820
لم يوافق كلّ من في مستعمرتي
.على القتال باستعمال الغاندام

361
00:21:29,180 --> 00:21:33,270
بدأ هجوم الغاندام من طرف
.مجموعة صغيرة كانت واثقة من الأمر

362
00:21:34,140 --> 00:21:35,640
.كنتُ واحدًا منهم

363
00:21:36,230 --> 00:21:39,020
ليس هنالك خطأ بالتّصرّف
.حسب ما تمليه مشاعرك

364
00:21:39,440 --> 00:21:40,650
.ذلك ما علّموني إيّاه على الأقل

365
00:21:41,400 --> 00:21:44,400
.لا يجدر بي منح أوز عذرًا لغزو المستعمرات

366
00:21:45,030 --> 00:21:46,610
.لم يكن الأمر عقلانيًّا

367
00:21:47,410 --> 00:21:49,370
.لذلك فعلتُ ما فعلتَ أنت

368
00:21:49,660 --> 00:21:50,660
.تبعت مشاعري

369
00:21:54,330 --> 00:21:57,080
أهذا ما ستستعمله في العرض؟

370
00:21:57,830 --> 00:22:00,540
.أعد أنّ الأمر سيكون منقطع النّظير

371
00:22:01,170 --> 00:22:02,840
!هذا هو المطلوب

372
00:22:02,840 --> 00:22:05,010
.ليكن عرض حياتك

373
00:22:08,050 --> 00:22:10,220
...أجل. سيكون آخر

374
00:22:10,890 --> 00:22:12,390
.عرض لي

375
00:22:13,720 --> 00:22:16,730
يُـتـبـع

376
00:22:24,780 --> 00:22:30,950
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

377
00:22:32,410 --> 00:22:38,670
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

378
00:22:39,460 --> 00:22:43,340
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

379
00:22:43,590 --> 00:22:46,800
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

380
00:22:47,300 --> 00:22:53,350
حبّ فحسب! إنّه يثير أعصابي

381
00:22:55,140 --> 00:23:02,110
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

382
00:23:02,480 --> 00:23:09,610
حبّ فحسب! أنا دائمة التّفكير به

383
00:23:10,660 --> 00:23:17,040
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

384
00:23:17,950 --> 00:23:21,040
... حبّ فحسب ...

385
00:23:27,880 --> 00:23:29,880
في الحلقة القادمة

386
00:23:30,720 --> 00:23:32,890
.الكثير من ضبّاط أوز يافعون ومتهوّرون

387
00:23:33,140 --> 00:23:36,270
ألا يوجد أحد هناك يمكنه
التّعامل مع الحرب بهدوء؟

388
00:23:36,560 --> 00:23:39,020
قوّتهم العسكريّة المفرطة
تخرج عن السّيطرة

389
00:23:39,020 --> 00:23:41,770
.مسبّبة في مجزرة لا ضرورة منها تلو الأخرى

390
00:23:41,770 --> 00:23:44,690
.بدأت أوز تقدّمها نحو الفضاء الخارجيّ

391
00:23:44,690 --> 00:23:47,690
ويتّجه تروا صوب معركته الأخيرة
.بهدف إنقاذ المستعمرات

392
00:23:48,610 --> 00:23:51,660
لكنّ كاثرين تقف أمام الشّابّ
.الّذي يعجّل في موته

393
00:23:52,360 --> 00:23:55,490
،"في الحلقة الثّالثة عشر من "جناح الغاندام

394
00:23:55,490 --> 00:23:57,700
."دموع كاثرين"