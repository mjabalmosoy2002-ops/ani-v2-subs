.يتوقّع الجنرال سيبتِم مجيئك

180
00:12:27,890 --> 00:12:31,810
يا والدي، ألا تدرك أنّ عيد مولدي وشيك؟

181
00:12:33,060 --> 00:12:36,310
كان لأيّ فتاة عاديّة أن تفقد
.رشدها بسبب هذا

182
00:12:39,320 --> 00:12:40,690
.طائرة عسكريّة

183
00:12:40,690 --> 00:12:44,240
.لكان هذا المكان ميناءً فضائيًّا لولاهم

184
00:12:47,660 --> 00:12:49,320
.حان الوقت للعودة للمنزل

185
00:12:51,540 --> 00:12:52,790
!جثّة

186
00:13:00,710 --> 00:13:02,270
زيّ عسكريّ؟

187
00:13:02,270 --> 00:13:03,670
.إنّه جنديّ

188
00:13:04,380 --> 00:13:05,840
!من الأفضل طلب المساعدة

189
00:13:10,760 --> 00:13:14,060
أتقول أنّه قد أُطيح بثلاثة من بذلك المتنقّلة؟

190
00:13:14,390 --> 00:13:15,390
.نعم

191
00:13:15,390 --> 00:13:18,020
.ليس من عادتك أن تكون متهوّرًا

192
00:13:18,560 --> 00:13:21,400
.ستكون تهدئة ضبّاط التّحالف أمرًا صعبًا

193
00:13:22,230 --> 00:13:25,490
.لقد كنّا نواجه بذلة متنقّلة مصنوعة من الغاندانيوم

194
00:13:25,820 --> 00:13:27,030
ماذا قلت؟

195
00:13:27,030 --> 00:13:30,370
.تخيّل فقط إن كانت من صنع المستعمرات

196
00:13:31,770 --> 00:13:35,470
ما كان شيء كهذا ليحدث أبدًا

197
00:13:35,470 --> 00:13:37,460
.إن كنّا في أوز منذ خمسة عشر عامًا

198
00:13:37,960 --> 00:13:39,670
.إذًا فقد كانت مقاتلة غاندام بالفعل

199
00:13:40,140 --> 00:13:42,130
.لا يمكنني تخيّل عكس ذلك

200
00:13:42,130 --> 00:13:45,210
.كان نظام مراقبة التّحالف أكثر من كافٍ

201
00:13:45,590 --> 00:13:49,390
.إنّ مارينا، سفينة التّحالف، في طريقها لجمع الأدلّة

202
00:13:49,390 --> 00:13:52,030
.سأوكل تلك المهمّة لرجالي

203
00:13:52,030 --> 00:13:54,980
.سأرسل أخصائِـيَّ للبحث تحت البحر

204
00:13:54,980 --> 00:13:56,270
.تولّ الأمر بعد ذلك

205
00:13:56,270 --> 00:13:56,640
.حسنًا

206
00:13:57,060 --> 00:14:00,610
أنا واثق أنّك مدرك لهذا
.ولكنّها فترة مهمّة للغاية

207
00:14:00,610 --> 00:14:02,980
.لا تفعل شيئًا لإغضاب التّحالف

208
00:14:03,530 --> 00:14:04,860
.عُلم وسيُنفّذ

209
00:14:09,990 --> 00:14:10,700
.معذرة على تأخّري

210
00:14:10,910 --> 00:14:12,330
.العقيد تيريز

211
00:14:12,330 --> 00:14:18,280
بلغني أنّ مساعدك قد فقد ثلاث بذل
.متنقّلة عند دخولهم الغلاف الجوّيّ

212
00:14:18,280 --> 00:14:18,710
.نعم

213
00:14:19,040 --> 00:14:19,830
ما قصدك بهذا؟

214
00:14:19,830 --> 00:14:24,590
كلّفْتنا خسارة ثلاث بذل متنقّلة
!لإحكام السّيطرة على متمرّد لا غير

215
00:14:24,590 --> 00:14:29,050
وكنّا قادرين على منع المتمرّدين
.من التّقدّم في خططهم

216
00:14:29,050 --> 00:14:31,460
!أنا لا أتحدّث عن النّتائج

217
00:14:31,460 --> 00:14:34,930
!أنت تهدر الموارد القتاليّة العسكريّة الثّمينة

218
00:14:35,270 --> 00:14:36,980
موارد قتاليّة ثمينة؟

219
00:14:36,980 --> 00:14:39,270
هل تتحدّث عن جنودنا؟

220
00:14:39,270 --> 00:14:42,560
أم أنّك تتحدّث عن البذل المتنقّلة؟

221
00:14:42,560 --> 00:14:44,730
!هل تسخر منّي يا هذا؟

222
00:14:44,730 --> 00:14:45,900
.هدوء

223
00:14:45,900 --> 00:14:48,490
.قد يحدث هذا ثانية أيّها العقيد تيريز

224
00:14:48,490 --> 00:14:49,740
.كن حذرًا أكثر

225
00:14:49,740 --> 00:14:50,530
.حاضر

226
00:14:51,070 --> 00:14:56,290
والآن، سننتقل إلى جدولنا الأساسيّ
.وهو تعطيل التّعاون بين المستعمرات

227
00:14:58,040 --> 00:15:01,540
أمسى التّحالف العسكريّ راضيًا كثيرًا
.عن نفسه خلال السّلام

228
00:15:01,540 --> 00:15:05,920
سيُبنى المستقبل الجديد على يد
.منظّمتي أنا، أوز

229
00:15:07,970 --> 00:15:09,220
.إنّه مجرّد فتى

230
00:15:15,560 --> 00:15:17,980
.لا تتحرّك، سيّارة الإسعاف قادمة

231
00:15:18,680 --> 00:15:19,940
هل رأيته؟

232
00:15:20,480 --> 00:15:21,900
رأيت ماذا؟

233
00:15:23,400 --> 00:15:24,310
!هناك في الأسفل

234
00:15:32,290 --> 00:15:33,220
!بسرعة

235
00:15:33,220 --> 00:15:34,820
مهلاً، من أنت؟

236
00:15:36,200 --> 00:15:36,830
!ماذا؟

237
00:15:38,160 --> 00:15:39,330
!مهلاً

238
00:15:49,670 --> 00:15:51,010
...اسمي

239
00:15:51,720 --> 00:15:53,890
.اسمي هو ريلينا دارليان

240
00:15:56,890 --> 00:15:58,060
ما اسمك أنت؟

241
00:16:15,490 --> 00:16:17,080
!أنتعرّض للهجوم؟

242
00:16:27,840 --> 00:16:29,340
.ها قد وصل ديو

243
00:16:29,340 --> 00:16:31,210
!لقد دمّرت المحرّك الرّئيسيّ

244
00:16:31,210 --> 00:16:34,050
كلّ ما عليّ فعله الآن هو شقّ
!طريقي خارجًا من هنا

245
00:16:36,720 --> 00:16:38,100
!معكم قاعدة دوفر

246
00:16:38,100 --> 00:16:40,520
!نحن نتعرّض لهجوم مفاجئ من العدوّ

247
00:16:41,060 --> 00:16:42,940
!هجوم عدوّ؟! من يهاجم؟

248
00:16:42,940 --> 00:16:43,640
!لا أعرف

249
00:16:48,150 --> 00:16:50,610
.أصبح الموت مصيركم الآن بما أنّكم رأيتموني

250
00:16:50,610 --> 00:16:53,280
اقتضت مهمّتي على تدمير
.الميناء الفضائيّ فحسب

251
00:16:53,280 --> 00:16:54,700
.سأدمّر كلّ شيء

252
00:17:02,750 --> 00:17:04,610
.هذه المعركة 001

253
00:17:04,870 --> 00:17:07,380
.ليُسجَّل في التّقرير أنّي الطّيّار تروا

254
00:17:07,710 --> 00:17:11,690
هل أنت واثق أن كبسولة المتمرّد
سقطت في هذه المنطقة؟

255
00:17:11,690 --> 00:17:12,300
.نعم

256
00:17:12,300 --> 00:17:13,380
.لكن لا يوجد أيّ شيء هنا

257
00:17:15,510 --> 00:17:16,130
!هجوم

258
00:17:19,390 --> 00:17:21,220
!ما الّذي يحدث هنا؟

259
00:17:21,220 --> 00:17:22,600
!هجوم عدوّ! هجوم عدوّ

260
00:17:25,020 --> 00:17:26,100
!نحن محاصرون

261
00:17:26,100 --> 00:17:26,900
!من يكونون؟

262
00:17:26,900 --> 00:17:28,290
!أيّها القائد

263
00:17:28,290 --> 00:17:28,860
!ماذا؟

264
00:17:31,820 --> 00:17:33,650
.ألقوا أسلحتكم واستسلموا

265
00:17:33,650 --> 00:17:35,780
.ثمّ سأُبقي على حياتكم

266
00:17:35,780 --> 00:17:36,990
!نار! نار

267
00:17:46,870 --> 00:17:47,960
.هذا كاتر

268
00:17:47,960 --> 00:17:49,210
.لقد دمّرت القائد

269
00:17:50,670 --> 00:17:51,920
...أخبرتكم

270
00:17:51,920 --> 00:17:53,550
.وجب عليكم الاستسلام

271
00:18:17,280 --> 00:18:19,030
.اسمي ووفِيْ

272
00:18:19,030 --> 00:18:20,910
.أنا لا أختبئ في أيّ مكان

273
00:18:20,910 --> 00:18:23,410
.ستنتهي هذه المعركة في غضون لحظات

274
00:18:25,700 --> 00:18:27,710
ألم تصل وحدة البحث بعد؟

275
00:18:27,710 --> 00:18:30,500
.قالوا إنّهم لن يصلوا قبل ساعتين

276
00:18:30,500 --> 00:18:32,460
ما الّذي يؤخّرهم هكذا؟

277
00:18:32,460 --> 00:18:34,050
.ما من داعٍ للارتباك

278
00:18:34,050 --> 00:18:35,710
.لن تبارح مقاتلة الغاندام مكانها

279
00:18:36,170 --> 00:18:38,670
.ولا تنسوا أنّها ترقد عميقًا هنا

280
00:18:38,670 --> 00:18:42,390
سيأخذ بحث قوّات مارينا الكثير
.من الوقت ليكتمل

281
00:18:42,390 --> 00:18:43,220
...لكن

282
00:18:43,220 --> 00:18:46,020
لماذا لا تلقي نظرة على شيء مثير للاهتمام؟

283
00:18:47,020 --> 00:18:48,230
ما هذا؟

284
00:18:48,230 --> 00:18:50,690
.التقطت سفينة مراقبة تابعة لأوز هذه الصّور

285
00:18:51,520 --> 00:18:54,980
ألا تظنّ أنّها تشبه كثيرًا الّتي قابلناها؟

286
00:18:54,980 --> 00:18:56,990
!إذًا فهنالك مقاتلتان منها؟

287
00:18:57,190 --> 00:18:59,360
.كلاّ، بل هنالك أكثر من ذلك

288
00:19:00,200 --> 00:19:04,080
وصلني تقرير يفيد أنّ مصنع بذل
أوز المتنقّلة والميناء الفضائيّ

289
00:19:04,080 --> 00:19:08,620
وقوّات البحث عن الكبسولة مثلنا

290
00:19:08,620 --> 00:19:10,750
.تعرّضوا لهجوم وأُبيدوا بالكامل

291
00:19:10,750 --> 00:19:12,080
.هنالك أربعة منها

292
00:19:12,080 --> 00:19:15,550
إنّها خمسة إن احتسبنا المقاتلة
.الّتي غرقت سلفًا

293
00:19:15,550 --> 00:19:16,460
!خمسة؟

294
00:19:16,460 --> 00:19:17,590
خمس مقاتلات غاندام؟

295
00:19:18,840 --> 00:19:20,780
.الحظّ يحالفنا بالتّأكيد

296
00:19:20,780 --> 00:19:24,260
لقد نجونا من لقائنا لواحدة
.من مقاتلات الغاندام

297
00:19:35,610 --> 00:19:39,070
.أنا متفاجئة لأنّ الآنسة ريلينا لم تحضر بعد

298
00:19:39,070 --> 00:19:42,240
.ما زلنا في بداية العام الدّراسيّ

299
00:19:42,240 --> 00:19:44,120
.لا يمكنك لومها

300
00:19:44,120 --> 00:19:47,870
لقد عادت من الفضاء الخارجيّ
.البارحة قبل كلّ شيء

301
00:19:47,870 --> 00:19:49,200
.أنا أحسدها بالفعل

302
00:19:49,200 --> 00:19:52,420
أودّ فعلاً أن أذهب في رحلة للفضاء
.الخارجيّ ولو لمرّة واحدة

303
00:19:52,920 --> 00:19:57,250
أظنّ أنّ ذلك هو ما تحصلين عليه
.إن كنتِ أغنى طالبات المدرسة

304
00:19:57,250 --> 00:20:01,220
لقد تذكّرت، أليس عيد مولد الآنسة ريلينا غدًا؟

305
00:20:01,220 --> 00:20:02,840
.هذا صحيح

306
00:20:02,840 --> 00:20:06,640
أتساءل من ستدعو الآنسة ريلينا
!إلى حفلة عيد مولدها؟

307
00:20:07,430 --> 00:20:10,760
!آنسة ريلينا -
!صباح الخير -

308
00:20:11,810 --> 00:20:12,890
.صباح الخير

309
00:20:24,320 --> 00:20:26,420
!ماذا؟ هذا هو

310
00:20:27,330 --> 00:20:28,740
.سكوت من فضلكم

311
00:20:28,740 --> 00:20:31,870
.يسرّني أن أقدّم لكم طالبًا جديدًا في فصلنا

312
00:20:33,790 --> 00:20:35,960
.اسمي هيرو يوي. سررت بلقائكم

313
00:20:36,630 --> 00:20:38,790
.أنا واثقة أنّه هو

314
00:20:39,130 --> 00:20:42,140
.اجلس إلى جانب الآنسة ريلينا يا هيرو

315
00:20:42,140 --> 00:20:45,930
.يمكنك أن تسألها أيّ سؤال يخطر على بالك

316
00:20:48,850 --> 00:20:50,890
.والآن، لنبدأ درسنا

317
00:20:53,600 --> 00:20:55,440
.سررتُ بلقائك يا هيرو

318
00:21:13,040 --> 00:21:15,230
المعذرة يا آنسة ريلينا؟

319
00:21:16,670 --> 00:21:17,960
.تفضّل

320
00:21:20,840 --> 00:21:23,130
.غدًا عيد ميلادي

321
00:21:23,130 --> 00:21:25,130
.أتمنّى أن تتمكّن من الحضور للحفلة

322
00:21:42,030 --> 00:21:44,140
هذا فظيع

323
00:21:49,820 --> 00:21:51,370
.سوف أقتلك

324
00:22:07,090 --> 00:22:09,480
!أيّ نوع من النّاس يكون؟

325
00:22:14,270 --> 00:22:17,020
يُـتـبـع

326
00:22:24,940 --> 00:22:31,120
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

327
00:22:32,580 --> 00:22:38,830
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

328
00:22:39,620 --> 00:22:43,500
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

329
00:22:43,750 --> 00:22:46,970
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

330
00:22:47,470 --> 00:22:53,510
حبّ فحسب! إنّه يثير أعصابي

331
00:22:55,310 --> 00:23:02,270
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

332
00:23:02,650 --> 00:23:09,780
حبّ فحسب! أنا دائمة التّفكير به

333
00:23:10,820 --> 00:23:17,200
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

334
00:23:18,120 --> 00:23:21,080
... حبّ فحسب ...

335
00:23:27,960 --> 00:23:30,050
في الحلقة القادمة

336
00:23:30,880 --> 00:23:35,930
أرسلت سفينة التّحالف مارينا قوّات
.للعثور على مقاتلة الغاندام الغارقة

337
00:23:36,720 --> 00:23:42,770
لكنّ زيكس من منظّمة أوز عثر عليها
.أوّلاً باستعمال بذلة السّرطان المتنقّلة

338
00:23:43,650 --> 00:23:46,650
على هيرو أن يدمّر مقاتلة الغاندام
.قبل أن يضع أيّ أحد يديه عليها

339
00:23:47,030 --> 00:23:51,570
لكن تظهر مقاتلة غاندام أخرى
.في أعماق المحيط المظلمة

340
00:23:52,320 --> 00:23:55,030
،"في الحلقة الثّانية في "جناح الغاندام

341
00:23:55,530 --> 00:23:57,490
."مقاتلة الغاندام المسمّاة حاصدة الأرواح"