1
00:01:29,360 --> 00:01:29,810
!أيّتها العقيد

2
00:02:01,390 --> 00:02:02,810
!انظر هناك

3
00:02:03,720 --> 00:02:05,520
!إنّها بذلة متنقّلة تابعة للتّحالف

4
00:02:25,410 --> 00:02:26,700
.ها قد استيقظت

5
00:02:26,700 --> 00:02:27,750
كيف تشعر؟

6
00:02:29,170 --> 00:02:31,710
هذا قمر اصطناعيّ بغرض التّنجيم
.عن موارد طبيعيّة

7
00:02:32,500 --> 00:02:35,630
ما الّذي كنت تفعله في تلك البذلة المتنقّلة؟

8
00:02:35,630 --> 00:02:38,550
.لا تبدو كجنديّ تابع للتّحالف

9
00:02:39,090 --> 00:02:39,680
...أنا

10
00:02:40,050 --> 00:02:42,220
.لا تحاول التّحرّك الآن

11
00:02:42,640 --> 00:02:45,720
،إن واصلت طوفك في الفضاء
.لكنت قد لقيت حتفك

12
00:02:47,230 --> 00:02:47,930
...لماذا

13
00:02:49,140 --> 00:02:50,900
لماذا أنقذت حياتي؟

14
00:02:51,270 --> 00:02:52,730
.أنا طبيبة

15
00:02:52,730 --> 00:02:54,770
.لا علاقة لي بأوز أو التّحالف

16
00:02:55,360 --> 00:02:58,860
كما أنّ هذه منطقة محايدة
.خارج سيطرة كِلا الجانبين

17
00:03:00,360 --> 00:03:01,660
.سامحيني

18
00:03:01,660 --> 00:03:04,530
.لم أشكرك حتّى على إنقاذ حياتي

19
00:03:05,620 --> 00:03:08,370
هل تعرفين أين يمكنني تأجير مكّوك؟

20
00:03:08,370 --> 00:03:09,370
!إيّاك

21
00:03:09,370 --> 00:03:12,790
لا يمكنني أن أسمح لمريض في
.وضعك أن يبتعد عن نظري

22
00:03:12,790 --> 00:03:14,590
!انسي وضعي

23
00:03:14,960 --> 00:03:16,170
.اهدأ

24
00:03:16,590 --> 00:03:19,970
،أفهم أنّك في عجلة من أمرك
!لكنّ ذلك ليس جيّدًا لصحّتك

25
00:03:20,760 --> 00:03:23,850
.ما تحتاج إليه حقًّا هو إراحة جسدك وذهنك

26
00:03:28,560 --> 00:03:30,850
.يمكنني الاهتمام بتوفير مكّوك لك

27
00:03:30,850 --> 00:03:31,600
أتعدني أنّك ستنتظر؟

28
00:03:32,190 --> 00:03:33,310
.نعم

29
00:03:33,310 --> 00:03:34,810
.آسف على طلبي

30
00:03:35,440 --> 00:03:36,980
.لا مشكلة في ذلك

31
00:03:36,980 --> 00:03:39,320
.لكن عليك أن ترتاح

32
00:03:39,820 --> 00:03:40,740
.عِدني

33
00:03:49,660 --> 00:03:50,200
.لا فائدة

34
00:03:50,580 --> 00:03:52,040
.الهدف يتسارع

35
00:03:52,040 --> 00:03:53,670
.بذل الأسد لا يمكنها مجاراته

36
00:03:54,960 --> 00:03:57,880
لم يتغيّر المسار، ما زال متّجهًا
.إلى منطقة الخليج

37
00:03:58,380 --> 00:04:01,010
.بذل الأسد ليست ندًّا له كما توقّعت

38
00:04:01,010 --> 00:04:05,010
تفيد التّقارير أنّ الهدف قد
.يكون بذلة تالغيس

39
00:04:05,010 --> 00:04:06,720
!لا أهتمّ ماذا يكون

40
00:04:06,720 --> 00:04:10,350
لا يمكننا السّماح لبذلة متنقّلة
.مسلّحة بالاقتراب أكثر

41
00:04:10,850 --> 00:04:13,560
يمكننا على الأرجح التّخلّص منها
.باستعمال الدّمى المتنقّلة

42
00:04:13,560 --> 00:04:14,190
...ولكن

43
00:04:15,940 --> 00:04:20,570
لقد أكمل العلماء العمل على البذل
.المتنقّلة الجديدة وهي جاهزة

44
00:04:21,530 --> 00:04:24,820
أرغب في تجربة قدرات بِذلتَيْ
.فاييت وميركوري

45
00:04:24,820 --> 00:04:27,530
!غبيّ! لا يمكننا اختبارهما في معركة حقيقيّة

46
00:04:28,200 --> 00:04:30,410
من توصي أن يكون الطّيّار الآخر؟

47
00:04:30,410 --> 00:04:32,790
.اسمحي لي بذلك أيّتها العقيد ليدي أن

48
00:04:33,250 --> 00:04:36,000
.لا بدّ أن يكون طيّارًا ممتازًا للقيام باختبار كامل

49
00:04:36,000 --> 00:04:38,000
.وإلاّ فسيكون عقبة في الطّريق

50
00:04:38,000 --> 00:04:39,590
!ماذا قلت؟

51
00:04:39,590 --> 00:04:40,710
.فهمت

52
00:04:40,710 --> 00:04:41,460
!أيّتها العقيد

53
00:04:41,800 --> 00:04:42,880
.تروا بارتون

54
00:04:42,880 --> 00:04:44,930
.آمرك بتدمير تالغيس

55
00:04:46,140 --> 00:04:46,760
.حاضر

56
00:04:56,190 --> 00:04:56,770
!اخرج

57
00:05:10,280 --> 00:05:11,740
ما رأيك؟

58
00:05:12,040 --> 00:05:14,870
كيف وجدتِ بِذلتَيْ فاييت وميركوري؟

59
00:05:14,870 --> 00:05:16,080
!إنّهما رائعتان

60
00:05:16,080 --> 00:05:18,960
.إنّهما حقًّا تظهران مواهبكم كمصمّمين للغاندام

61
00:05:18,960 --> 00:05:22,510
.كنتِ على حقّ بترك الأمر بين أيدينا

62
00:05:22,510 --> 00:05:24,300
!لكنّ هذا خطير

63
00:05:24,300 --> 00:05:28,590
لماذا تسمحين لطيّار الغاندام
ذاك بقيادة ميركوري؟

64
00:05:28,590 --> 00:05:29,850
.ذلك هو السّبب بالتّحديد

65
00:05:30,350 --> 00:05:33,980
يجدر بأوز أن تكون على علم
.بقدراته كطيّار أكثر من غيرها

66
00:05:34,390 --> 00:05:38,480
هل يمكن لجهاز التّدمير الذّاتي لميركوري
أن يُفعّل من بذلة فاييت الّتي يقودها تروا؟

67
00:05:38,480 --> 00:05:41,070
.نعم، كما طلبتِ تمامًا

68
00:05:41,480 --> 00:05:46,200
تروا، لديك الإذن بتدمير ميركوري
!إن تصرّف الطّيّار بشكل مشبوه

69
00:05:46,490 --> 00:05:47,990
.لن يكون ذلك ضروريًّا

70
00:05:49,120 --> 00:05:52,660
.لقد قاتل تالغيس في سيبيريا من قبل

71
00:05:52,660 --> 00:05:54,790
.سيعتبر هذه فرصة لإنهاء تلك المعركة

72
00:05:56,210 --> 00:06:00,380
لن تكون المستعمرات الآن درعًا
.لمنعه من إنهاء ذلك

73
00:06:01,630 --> 00:06:03,460
كيف أمكنك معرفة ذلك؟

74
00:06:03,880 --> 00:06:06,970
.الأمر ليس صعبًا بما أنّي جنديّ لدى أوز

75
00:06:07,930 --> 00:06:10,510
.من الجيّد أنّه دمّر نفسه ذاتيًّا

76
00:06:10,510 --> 00:06:12,760
.كنت أعيش في المستعمرات حينها

77
00:06:12,760 --> 00:06:14,060
.لذلك ما كنتُ لأنجو

78
00:06:14,600 --> 00:06:16,390
.يجب أن أكون ممتنّة أنا أيضًا

79
00:06:16,390 --> 00:06:19,650
.لقد عثرتُ على تابع ممتاز مثلك

80
00:06:50,550 --> 00:06:51,300
ما رأيك؟

81
00:06:52,010 --> 00:06:53,260
.ليست سيّئة

82
00:06:53,260 --> 00:06:55,470
أدوات التّشغيل مشابهة تمامًا نوعًا ما
.لما كانت عليه في الغاندام

83
00:06:56,060 --> 00:06:57,180
.ذلك ليس مفاجئًا

84
00:06:58,850 --> 00:07:00,350
.يا طيّار الغاندام

85
00:07:00,940 --> 00:07:02,900
كيف كنتَ لتقاتل دمية متنقّلة؟

86
00:07:08,610 --> 00:07:13,030
كنتُ لأتسلّل أوّلاً خلف العدوّ
.لأحرص ألاّ أكون في مدى نيرانها

87
00:07:16,700 --> 00:07:18,160
.لا تبالغ

88
00:07:18,160 --> 00:07:19,870
.وإلاّ سأضطرّ لتفجيرك

89
00:07:23,500 --> 00:07:28,880
نقطة ضعف الدّمى المتنقّلة أنّ لها
.نفس القدرات كالنّماذج بطيّار

90
00:07:29,420 --> 00:07:33,390
إنّها متشابهة حتّى في حركيّتها
.وزمن ردود أفعالها

91
00:07:33,390 --> 00:07:36,430
يعتمد الباقي على مدى إتقان
.الطّيّار البشريّ في قتالها

92
00:07:37,060 --> 00:07:40,940
بشكل شخصيّ، وجدت وقتًا
.أصعب مع ألغام الفضاء

93
00:07:44,150 --> 00:07:45,980
.لا نحتاج للدّمى المتنقّلة

94
00:07:45,980 --> 00:07:48,030
.سأتولّى تلك البذلة البيضاء وحدي

95
00:07:50,950 --> 00:07:52,360
.لحقنا بها

96
00:07:52,360 --> 00:07:53,780
.سنرسل الدّمى المتنقّلة

97
00:08:03,460 --> 00:08:05,210
لماذا هو في الفضاء الخارجيّ؟

98
00:08:06,090 --> 00:08:07,130
.نلتَ منّي

99
00:08:18,930 --> 00:08:19,930
!الدّمى المتنقّلة

100
00:08:30,070 --> 00:08:32,860
.زمن ردود فعلي أبطأ قليلاً من زمنها

101
00:08:44,620 --> 00:08:47,290
لكنّي أستطيع التّعويض عن ذلك
...في القتال القريب

102
00:08:56,640 --> 00:08:57,220
!ماذا؟

103
00:09:01,020 --> 00:09:01,810
!هنالك اثنان منهم

104
00:09:08,980 --> 00:09:10,230
!لقد عكست الشّعاع

105
00:09:21,910 --> 00:09:23,750
!عليّ تولّي أمر هذه أيضًا

106
00:10:00,910 --> 00:10:04,910
إنّهما يدمّران الدّمى المتنقّلة
.في نفس الوقت الّذي يقاتلانني فيه

107
00:10:05,620 --> 00:10:09,420
لا يستطيع الكثير من الطّيّارين
.القيام بذلك في الفضاء الخارجيّ

108
00:10:11,750 --> 00:10:14,880
.ليس لديّ وقت للّعب معكما

109
00:10:14,880 --> 00:10:16,630
.اسحباني فحسب

110
00:10:24,180 --> 00:10:26,730
.ما كنتُ لأتوقّع أن تتسلّل إلى أوز

111
00:10:26,730 --> 00:10:29,270
.أنا الضّابط تروا بارتون

112
00:10:29,270 --> 00:10:32,150
.لا أعتقد أنّنا تقابلنا من قبل يا زيكس ماركيس

113
00:10:38,450 --> 00:10:40,110
.سأقدّم نفسي

114
00:10:40,110 --> 00:10:42,830
.اسمي هو ملياردو بيسكرافت

115
00:10:43,530 --> 00:10:46,580
.أتيتُ من الأرض كسفير نوايا حسنة

116
00:10:59,050 --> 00:11:03,850
أغلبيّة النّاس الّذين يعيشون في الفضاء
.إمّا تقنيّون أو عمّال

117
00:11:03,850 --> 00:11:06,770
وبتحمّلهم لمحيط أقلّ من محيط
،الأرض المتوازن

118
00:11:07,270 --> 00:11:10,190
فقد أثبتوا أنّهم يملكون الشّجاعة
.لتحسين أوضاعهم

119
00:11:10,190 --> 00:11:12,350
.نجَم عن هذا قّوة جديدة

120
00:11:12,860 --> 00:11:15,730
.عائلة وينر هي الّتي تدعم هذه الرّوح

121
00:11:18,570 --> 00:11:22,660
هاجر سيّد عائلة وينر وأصبح
أيقونة مركزيّة في المفاوضات

122
00:11:22,660 --> 00:11:29,160
مع تحالف المجال الأرضيّ المتّحد للقتال
.من أجل حقوق سكّان المستعمرات

123
00:11:30,000 --> 00:11:34,630
،حتّى منذ أن حُلّ جيش التّحالف

124
00:11:34,630 --> 00:11:39,670
واجه أوز من أجل المستعمرات مع حفاظه
.دائمًا على مكانته كمناشد للسّلام

125
00:11:40,630 --> 00:11:42,260
.المعذرة يا سيّد وينر

126
00:11:44,010 --> 00:11:44,720
!ماذا؟

127
00:11:45,260 --> 00:11:47,180
!عاد كاتر للمنزل؟

128
00:11:49,020 --> 00:11:51,140
كم كان عمرك في تلك الصّورة؟

129
00:11:52,100 --> 00:11:55,610
.أقدّر لك إحضاري إلى هنا

130
00:11:55,610 --> 00:11:57,230
.لا مشكلة في ذلك

131
00:11:57,230 --> 00:11:59,150
.احتجتُ للمجيء على أيّ حال

132
00:12:05,950 --> 00:12:07,910
.كنتَ ولدًا عاصيًا للغاية

133
00:12:08,240 --> 00:12:10,500
!ما زلت أؤمن أنّي على صواب

134
00:12:11,040 --> 00:12:14,420
العيش في الفضاء الخارجيّ
!صعب على النّاس

135
00:12:15,000 --> 00:12:17,920
!توريط نفسك في حرب هو مضيعة وقت

136
00:12:19,170 --> 00:12:24,470
لهذا السّبب كنّا نبحث عن حلول عن طريق
.النّقاش مع تحالف المجال الأرضيّ المتّحد

137
00:12:25,470 --> 00:12:29,680
.لكنّك ذهبت إلى الأرض على متن بذلة متنقّلة

138
00:12:29,680 --> 00:12:32,600
.بل وأعطيتَهم عذرًا ليهاجموا المستعمرات

139
00:12:32,600 --> 00:12:35,940
لكن على أحدٍ ما أن يقاتل
.وإلاّ فلن تنتهي الحرب

140
00:12:35,940 --> 00:12:36,520
!وإذًا؟

141
00:12:36,940 --> 00:12:37,900
!هل انتهت؟

142
00:12:38,520 --> 00:12:41,190
!هل أنهت معركتك الحرب؟

143
00:12:43,360 --> 00:12:45,160
ماذا كان بإمكانك تحقيقه؟

144
00:12:45,160 --> 00:12:46,870
!ما كان لطفل مثلك تحقيقه؟

145
00:12:47,620 --> 00:12:51,330
أقلّ ما يمكنك فعله كوريث للعائلة
.هو الإصغاء لكلام والدك

146
00:12:51,700 --> 00:12:53,250
.أعمِل عقلك

147
00:12:53,250 --> 00:12:56,130
.أعتقد أنّه سيكبر ليكون وريثًا ممتازًا

148
00:12:56,130 --> 00:12:58,090
.إيريا، لا تبدئي بهذا معي

149
00:12:58,380 --> 00:12:59,550
.أبي

150
00:12:59,880 --> 00:13:02,590
من الخطأ التّفكير في أنّ طفلاً
.لا يملك القدرة

151
00:13:03,170 --> 00:13:06,590
!سيصبح أخي الصّغير وريثًا ممتازًا

152
00:13:08,550 --> 00:13:11,270
.إنّ أبي يدرك الأمر في داخله

153
00:13:11,930 --> 00:13:15,140
.ذلك النّقاش مع أوز لن يقودنا لأيّ حلول

154
00:13:16,270 --> 00:13:21,440
لكنّه يظنّ أنّ الأمور ستكون على ما يرام
.إن عملت المستعمرات كلّها كيدٍ واحدة

155
00:13:22,230 --> 00:13:24,700
لماذا لم تخبريني أنّك أختي؟

156
00:13:25,200 --> 00:13:29,320
سمعتُ من أبي أنّ أخي الصّغير
.كان طيّار غاندام

157
00:13:29,320 --> 00:13:31,120
.لكنّه غضب كثيرًا

158
00:13:31,120 --> 00:13:33,870
.لم أستطع أن أقرّر إن كان عليّ قول أيّ شيء

159
00:13:33,870 --> 00:13:37,370
سمعتُ أنّ أخواتي قد تموضعن
.في أقمار اصطناعيّة مختلة للموارد

160
00:13:38,170 --> 00:13:40,040
.جميعنا نشجّعك

161
00:13:40,880 --> 00:13:42,670
.وأبي ليس استثناءً

162
00:13:45,050 --> 00:13:50,260
،بعد أن غادرتَ مباشرة
.كان أبي أكثر من يقلق عليك

163
00:13:50,260 --> 00:13:51,510
فعلاً؟

164
00:13:53,470 --> 00:13:58,230
صحيح أنّي منحتُ ملجأ للمعلّم إتش
.الّذي كان هاربًا من التّحالف

165
00:13:58,770 --> 00:14:03,400
،لكن من وجهة نظر عائلتنا
.لا نحتاج للبذل المتنقّلة لإحلال السّلام

166
00:14:03,650 --> 00:14:07,070
ومع ذلك، تجاهلني كاتر وانتهى
.به المطاف متعاونًا مع المعلّم

167
00:14:19,880 --> 00:14:23,960
.لا تقود الحلول العدوانيّة إلاّ للمزيد من المشاكل

168
00:14:25,090 --> 00:14:27,220
.لكنّ كاتر لا يرى ذلك فحسب

169
00:14:29,800 --> 00:14:32,470
.هنا بُنيت بذلتي الغاندام

170
00:14:36,640 --> 00:14:40,440
لكن اضطررت لتدميرها على الأرض
.بسبب عدم كفاءتي

171
00:14:41,940 --> 00:14:43,730
ما الّذي ستفعله؟

172
00:14:43,730 --> 00:14:45,530
.المعلّم ليس هنا

173
00:14:45,530 --> 00:14:47,900
.عليّ صناعة غاندام أخرى وأقاتل

174
00:14:48,780 --> 00:14:49,700
...كاتر

175
00:14:50,820 --> 00:14:54,870
هل يمكنك فعلاً أن تقاتل من أجل
سكّان المستعمرات؟

176
00:14:57,160 --> 00:15:00,620
تمّ الإمساك بطيّار غاندام آخر
.كان يقاتل مثلك

177
00:15:00,620 --> 00:15:02,840
.دُمّرت بذلته الغاندام لتكون عبرة لغيرها

178
00:15:03,460 --> 00:15:06,300
.استمتع سكّان المستعمرات بذلك

179
00:15:06,880 --> 00:15:10,760
ما عاد أيّ أحد في الفضاء يعتبر
.الغاندام حليفة له

180
00:15:11,890 --> 00:15:14,390
كاتر، هل أنت واثق أنّه ما زال
بإمكانك القتال؟

181
00:15:16,430 --> 00:15:19,770
لم أكن أقاتل ليتمّ الاعتراف
.بي من طرف السّكّان

182
00:15:20,440 --> 00:15:24,110
.لكنّي أؤمن أنّهم سيرون الحقيقة يومًا ما

183
00:15:27,320 --> 00:15:31,240
على الأرجح أنّي عاطفيّ الآن
.دون وجود صخرة الرّمال معي

184
00:15:33,120 --> 00:15:34,490
.آسفة

185
00:15:34,490 --> 00:15:37,370
.أنا أختك، لكنّي كنتُ قاسية دائمًا معك

186
00:15:37,830 --> 00:15:38,540
...أختي

187
00:15:39,250 --> 00:15:41,790
.نحن نحبّك جميعًا

188
00:15:41,790 --> 00:15:45,290
.لذلك لا تحزن يا عزيزي كاتر

189
00:15:45,790 --> 00:15:47,880
.شكرًا لك يا أختي إيريا

190
00:15:54,890 --> 00:15:58,430
إذًا كيف تعرّفون أيّها الرّجال النّبلاء
التّطوّر المستقبليّ؟

191
00:15:58,430 --> 00:16:00,310
لماذا تحتاجون الأسلحة للدّفاع؟

192
00:16:00,850 --> 00:16:02,100
.سيّد وينر

193
00:16:02,100 --> 00:16:03,980
.أفهم وجهة نظرك

194
00:16:03,980 --> 00:16:06,480
.لكنّنا في وضع استراتيجيّ خطير سلفًا

195
00:16:06,480 --> 00:16:09,900
ويريد سكّان المستعمرات أن يكونوا
.مسؤولين عن أمنهم

196
00:16:10,400 --> 00:16:11,400
!أمنهم؟

197
00:16:11,400 --> 00:16:12,780
!هذا أمن؟

198
00:16:12,780 --> 00:16:15,280
.رأيتم هذه الأسلحة ودجّجتم أنفسكم

199
00:16:15,280 --> 00:16:17,870
كيف تجرؤون على استعمال كلمات
مثل "الأمن" و"السّلام"؟

200
00:16:18,490 --> 00:16:23,080
ما كان التّطوّر في هذه المستعمرة
.ليكون ممكنًا دون مساعدتك الماليّة

201
00:16:23,420 --> 00:16:27,670
ولكنّ الازدهار الحاليّ هو نتيجة
.لمجهودات السّكّان

202
00:16:27,670 --> 00:16:30,010
.أنا أشكّك في دكتاتوريّتك المتواصلة

203
00:16:30,380 --> 00:16:32,670
!متى تصرّفتُ بدكتاتوريّة؟

204
00:16:32,670 --> 00:16:37,140
أنا أعارض تدخّل أوز فحسب لنحافظ
.على السّلام في المستعمرة

205
00:16:37,140 --> 00:16:41,390
إذا كان هنالك من هم متّهمون
!بالدّكتاتوريّة في المستعمرة فهُم أنتم

206
00:16:49,270 --> 00:16:50,610
.سيّد وينر

207
00:16:50,610 --> 00:16:53,900
في هذه المرحلة، لا يجب أن نسمح
.بسيطرتك الحصريّة

208
00:16:54,280 --> 00:16:58,490
لنقرّر في أمر عرضٍ عادلٍ بشأن
.السّلطة القضائيّة في هذه المنطقة

209
00:16:59,200 --> 00:17:02,960
.صناعة الأسلحة ووسائل القتل

210
00:17:03,290 --> 00:17:05,460
!لماذا عليّ أن أقدّم تعاوني؟

211
00:17:05,460 --> 00:17:09,540
!تخلّي على حقوقك يا عائلة وينر

212
00:17:09,540 --> 00:17:12,420
!المستعمرة ملك لنا نحن العمّال

213
00:17:12,420 --> 00:17:15,880
!تحيا أوز

214
00:17:18,890 --> 00:17:20,930
لماذا يحتجّون؟

215
00:17:20,930 --> 00:17:23,310
.أصبح الرّأي العامّ أقوى

216
00:17:23,310 --> 00:17:25,520
ويقولون أنّه ليس علينا احتكار
.الموارد الطّبيعيّة

217
00:17:25,520 --> 00:17:26,440
.هذا سخيف

218
00:17:26,980 --> 00:17:30,360
صحيح أنّنا نمتلك الكثير من أقمار
.الموارد الطّبيعيّة

219
00:17:30,360 --> 00:17:32,780
.لكنّنا لم نحتكر الموارد أبدًا

220
00:17:32,780 --> 00:17:36,780
بل نحن نهبها إن جاز التّعبير
.من أجل ازدهار السّكّان في الفضاء

221
00:17:36,780 --> 00:17:38,990
!لكنّ الجميع يعرفون ذلك

222
00:17:39,700 --> 00:17:41,830
.مشاعر النّاس قد تغيّرت

223
00:17:42,450 --> 00:17:45,540
.بشأنك وبشأن والدنا

224
00:17:47,960 --> 00:17:52,670
.لكنّنا... لكنّنا نقوم بالصّواب فحسب

225
00:17:59,510 --> 00:18:00,890
.تصويت بالإجماع

226
00:18:00,890 --> 00:18:04,730
من الآن فصاعدًا، أمسى قمر الموارد
.الطّبيعيّة هذا تحت سلطة أوز

227
00:18:10,810 --> 00:18:14,650
!لن تصنعون الأسلحة على هذا القمر

228
00:18:25,250 --> 00:18:26,410
!هل أنت جادّ؟

229
00:18:26,410 --> 00:18:28,460
!فصل أبي القمر؟

230
00:18:29,040 --> 00:18:31,590
!نعم، وهو في تسارع

231
00:18:31,590 --> 00:18:34,250
!قد يعطّل هذا الوظائف في المستعمرة بأكملها

232
00:18:34,880 --> 00:18:36,920
!هذه هي حقيقته

233
00:18:36,920 --> 00:18:40,800
إنّه مستعدّ للتّضحيّة بمستقبل
.المستعمرة من أجل صالحه

234
00:18:40,800 --> 00:18:43,510
!وما من شيء سيوقفه

235
00:18:43,930 --> 00:18:46,220
!هل علينا السّماح بحدوث هذا؟

236
00:18:50,440 --> 00:18:52,610
،بما أنّه لا توجد اعتراضات

237
00:18:52,610 --> 00:18:55,650
سننتقل في الحال لأخذ أيّ خطوات لازمة

238
00:18:55,650 --> 00:18:57,900
.للحفاظ على سلام مستعمرتنا

239
00:19:05,290 --> 00:19:07,410
!أبي، عليك إيقاف هذا

240
00:19:07,410 --> 00:19:09,580
!لن يحلّ هذا أيّ شيء

241
00:19:09,580 --> 00:19:11,040
!سوف يسعون خلفك

242
00:19:11,460 --> 00:19:14,960
أتنصحانني بالجلوس بلا حراك
!والسّماح لأوز بغزو المستعمرة؟

243
00:19:14,960 --> 00:19:16,960
!لستُ على خطأ

244
00:19:16,960 --> 00:19:18,010
!أبي

245
00:19:18,010 --> 00:19:19,090
!كاتر

246
00:19:19,090 --> 00:19:22,050
عدني ألاّ تقاتل في تلك البذل
.المتنقّلة بعد الآن

247
00:19:22,510 --> 00:19:24,470
.لن يحلّ العنف أيّ شيء

248
00:19:25,010 --> 00:19:26,180
...أبي

249
00:19:32,560 --> 00:19:33,610
!غبيّان

250
00:19:33,610 --> 00:19:35,070
!ابتعدا من هنا

251
00:19:35,070 --> 00:19:37,570
المدفع الشّعاعيّ اللّعين مصوّب
!على هذا القمر الاصطناعيّ

252
00:19:37,820 --> 00:19:39,530
!اهرب رجاءً يا أبي

253
00:19:40,780 --> 00:19:43,450
.كاتر، أنا أهرب فعلاً

254
00:19:43,990 --> 00:19:45,740
.أنا لا أحاول القتال

255
00:19:46,450 --> 00:19:50,120
.لا نهاية لهذا القتال، لذلك عليّ الهروب

256
00:19:50,620 --> 00:19:53,460
.إن كان الموت مصيري، فلا بأس بذلك

257
00:19:53,790 --> 00:19:57,500
لستُ معلّقًا بالفضاء كثيرًا لدرجة
!أن أبيع نفسي

258
00:19:57,800 --> 00:19:59,840
!أبي

259
00:20:12,940 --> 00:20:13,980
!أبي؟

260
00:20:13,980 --> 00:20:15,650
!أبي

261
00:20:23,280 --> 00:20:23,990
!كاتر

262
00:20:36,790 --> 00:20:38,170
...أبي

263
00:20:39,210 --> 00:20:40,170
.كاتر

264
00:20:40,590 --> 00:20:42,720
.قاتَل والدنا ببسالة

265
00:20:43,340 --> 00:20:45,220
.لم يكن يهرب

266
00:20:45,970 --> 00:20:48,010
لقد قاتل بكلّ شجاعة، صحيح؟

267
00:20:50,310 --> 00:20:52,350
.أختي إيريا، حاولي ألاّ تتحرّكي

268
00:20:52,350 --> 00:20:53,390
.ستزيدين الأمر سوءًا لا غير

269
00:20:55,440 --> 00:20:57,440
.أنت شخص طيّب يا كاتر

270
00:20:58,110 --> 00:21:00,280
.وكان أبي طيّبًا أيضًا

271
00:21:00,900 --> 00:21:04,950
!لكن ما الّذي فعله أبي ليستحقّ أن يُقتل؟

272
00:21:10,080 --> 00:21:12,290
.الطّيّبون هم من يذرفون الدّموع

273
00:21:12,870 --> 00:21:14,370
.لكن لا أحد يفهمهم

274
00:21:15,330 --> 00:21:17,500
.والمستعمرة راضية الآن

275
00:21:18,170 --> 00:21:20,170
!أنتم راضون الآن

276
00:21:21,670 --> 00:21:23,550
.لن أنسى هذا أبدًا

277
00:21:24,760 --> 00:21:29,760
وسأحرص على ألاّ ينسى النّاس
.هذا اليوم أيضًا

278
00:22:08,300 --> 00:22:09,800
...الفضاء الخارجيّ

279
00:22:10,600 --> 00:22:12,060
...هدوء تامّ

280
00:22:13,430 --> 00:22:16,890
يُـتـبـع

281
00:23:28,050 --> 00:23:30,050
في الحلقة القادمة

282
00:23:32,970 --> 00:23:35,510
.غاصت الحقبة في أعماق الارتباك

283
00:23:36,010 --> 00:23:38,930
تتّجه المستعمرات صوب طريق
.يقودها نحو التّسلّح

284
00:23:39,230 --> 00:23:44,730
غادر زيكس الأرض وأكّد وجود شخصيّة
.ليدي أن السّاعية للسّلام

285
00:23:45,110 --> 00:23:47,900
،وفي سعيها لتحقيق مُثُل تيريز

286
00:23:47,900 --> 00:23:52,160
تتصرّف ليدي أن بمحض إرادتها
.ضدّ أوامر مؤسّسة رومفلر

287
00:23:52,740 --> 00:23:56,240
،"في الحلقة الثّانية والعشرين من "جناح الغاندام

288
00:23:56,240 --> 00:23:58,240
."القتال من أجل الاستقلال"