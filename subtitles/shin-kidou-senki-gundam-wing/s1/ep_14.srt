1
00:00:12,030 --> 00:00:15,320
مجرّد نبض تواصل جامح

2
00:00:15,530 --> 00:00:18,990
أقف في المطر الجارح

3
00:00:19,160 --> 00:00:22,620
أريد إظهار مشاعري المتّقدة الخالدة

4
00:00:22,750 --> 00:00:27,790
!عن طريق جسدي بالكامل اللّيلة

5
00:00:33,840 --> 00:00:40,680
أتشبّث بكتفيك المبلّلين لمنحك الدّفء والرّاحة

6
00:00:40,850 --> 00:00:48,020
ما الّذي تسعى إليه هذه الأصابع المرتعشة؟

7
00:00:48,650 --> 00:00:55,200
أريد حماية النّظرة الصّادقة في عينك

8
00:00:55,950 --> 00:01:02,750
مؤمنة بالحبّ الّذي سيُحيلُ الحزنَ قوّة

9
00:01:02,830 --> 00:01:06,370
مجرّد نبض تواصل جامح

10
00:01:06,500 --> 00:01:10,090
أقف في المطر الجارح

11
00:01:10,250 --> 00:01:13,670
أريد إظهار مشاعري المتّقدة الخالدة

12
00:01:13,800 --> 00:01:18,510
!عن طريق جسدي بالكامل اللّيلة

13
00:01:23,150 --> 00:01:27,390
الهجمات الّتي تشنّها بذل الغاندام
القادمة من المستعمرات الفضائيّة

14
00:01:27,390 --> 00:01:30,030
.تعكس نوايا المستعمرات الانتقاميّة

15
00:01:30,630 --> 00:01:35,030
أخفت أوز نفسها في جيش التّحالف

16
00:01:35,030 --> 00:01:39,650
.وكانت مهمّة الغاندام الهجومَ عليهم

17
00:01:43,570 --> 00:01:45,880
.إنّه العام 195 بعد المستعمرات

18
00:01:46,380 --> 00:01:49,420
.استولت أوز أخيرًا على زمام الأمور

19
00:01:50,010 --> 00:01:53,690
،وبوجود جيش من نخبة الجنود تحت إمرته

20
00:01:53,690 --> 00:01:56,730
بدأ تيريز كوشرينادا بالقضاء
.على جيش التّحالف

21
00:01:57,220 --> 00:02:01,000
تسبّبت المعركة بين أوز والبذل
المتنقّلة المرسَلة للأرض

22
00:02:01,000 --> 00:02:03,560
.بالكثير من التّداعيّات الخطيرة على الأرض

23
00:02:10,800 --> 00:02:13,400
!ألا تعتقد أنّ حياتك أكثر قيمة من ذلك؟

24
00:02:14,130 --> 00:02:15,390
تدمّر نفسك ذاتيًّا؟

25
00:02:15,390 --> 00:02:16,790
!ما الّذي تفكّر به؟

26
00:02:16,790 --> 00:02:18,240
...كيف كان ليفكّر والداك

27
00:02:18,690 --> 00:02:20,290
.سبق وأخبرتك

28
00:02:20,290 --> 00:02:24,120
السّبيل لعيش حياة جيّدة هو
.بالتّصرّف بحسب مشاعرنا

29
00:02:44,980 --> 00:02:46,360
.عليك أن تهتمّ أكثر

30
00:02:46,360 --> 00:02:47,100
.حسنًا

31
00:02:47,660 --> 00:02:49,140
.أقصد بجسدك

32
00:02:55,070 --> 00:02:55,520
...هذه

33
00:02:59,270 --> 00:03:01,280
.سيلفيا نوفينتا

34
00:03:01,280 --> 00:03:02,800
.إنّها في مارسيليا

35
00:03:02,800 --> 00:03:04,450
أواثق أنّك تريد أن تبدأ هناك؟

36
00:03:04,820 --> 00:03:05,450
.نعم

37
00:03:14,480 --> 00:03:16,050
.يبدو أنّنا سنصل في الموعد

38
00:03:20,300 --> 00:03:22,080
ما الخطب؟

39
00:03:26,070 --> 00:03:28,170
.عرض بذل الأسد

40
00:03:28,170 --> 00:03:31,160
.إنّها القوّة الأساسيّة للتّحالف وأوز

41
00:03:31,160 --> 00:03:35,690
لماذا كانت رومفلر حازمة بشأن
استعمال البذل المتنقّلة؟

42
00:03:35,690 --> 00:03:38,480
.لأنّ النّاس يخافون الآلات الكبيرة

43
00:03:38,480 --> 00:03:41,030
لكنّهم معجبون بها بشدّة
.في نفس الوقت

44
00:03:41,580 --> 00:03:43,580
.تسير البذل المتنقّلة باستقامة أيضًا

45
00:03:43,580 --> 00:03:46,620
لا بدّ أنّ المؤسّسة فضّلت معركة بسمات بشريّة

46
00:03:46,620 --> 00:03:48,990
.بَدل معركة تُشنّ بالأزرار والمفاتيح

47
00:03:49,700 --> 00:03:52,710
لا يوجد اختلاف بينهما فيما
.يخصّ قتل الأشخاص

48
00:03:52,710 --> 00:03:56,660
وإن كان هنالك اختلاف، فسيكون
.أشبه بلعبة تتلاعب بأرواح النّاس

49
00:03:56,660 --> 00:04:00,920
في الحروب، الموت المجنون
.هو أشرف طريقة للموت

50
00:04:02,330 --> 00:04:04,840
قلّة فقط ممّن يعرفون
أنّ الفوضى الّتي سبّبتها أوز

51
00:04:04,840 --> 00:04:09,390
.تسير حسب خطط مؤسّسة رومفلر

52
00:04:09,710 --> 00:04:13,250
وهنالك اجتماع لمؤسّسة رومفلر
وضيوف مدعوّين

53
00:04:13,250 --> 00:04:15,600
.سيُقام في ضواحي بريمن

54
00:04:17,510 --> 00:04:21,920
أُنشئت مؤسّسة رومفلر من العائلات
.الملكيّة الأوروبيّة

55
00:04:21,920 --> 00:04:24,370
،وبقوّتهم الماليّة الهائلة وعلاقاتهم

56
00:04:24,370 --> 00:04:26,920
صبّ الأرستقراطيّون طاقتهم
.في تطوير الأسلحة

57
00:04:26,920 --> 00:04:30,110
لقد زوّدوا التّحالف بالبذل المتنقّلة

58
00:04:30,110 --> 00:04:34,390
.وأصبحوا أقوياء كفاية لإنجاح الانقلاب الأخير

59
00:04:38,310 --> 00:04:39,710
ما الخطب؟

60
00:04:39,710 --> 00:04:40,960
.عليك أن تسامحيني

61
00:04:44,080 --> 00:04:48,100
.أنا لا ألومك، نظرًا لما فعلتُه سابقًا

62
00:04:50,330 --> 00:04:52,050
يوجد خلف ذلك الباب

63
00:04:52,050 --> 00:04:56,050
أشخاص مسؤولين عن موت
.والدك ومملكة سانك

64
00:04:56,050 --> 00:04:58,190
...لكن ليس عليك فعل أيّ شيء اليوم

65
00:04:58,490 --> 00:04:59,820
.أنا أفهم

66
00:05:00,330 --> 00:05:03,430
أعد أن أتصرّف بشكل لائق لعاهلة

67
00:05:03,430 --> 00:05:05,650
.مملكة سانك المناشدة للسّلام

68
00:05:08,910 --> 00:05:11,470
في الماضي، طلب تحالف
المجال الأرضيّ المتّحد

69
00:05:11,470 --> 00:05:15,200
تمويلاً ومساعدات ضخمة
.من أجل سلام العالم

70
00:05:15,660 --> 00:05:19,170
لم نتردّد في التّعاون معهم
.من أجل سلام العالم

71
00:05:19,560 --> 00:05:23,430
لكنّ التّحالف بدأ يسعى للسّلام
.عبر الحوار فحسب

72
00:05:23,430 --> 00:05:28,370
هنالك عدّة نزاعات على الأرض
.لا يمكن للحوار وحده حلّها

73
00:05:28,370 --> 00:05:32,140
أليس ما تحتاجه البشريّة بحقّ
هو نظام مُسيطِر؟

74
00:05:32,390 --> 00:05:35,890
.هكذا بالضّبط سيتمّ تطبيق السيّطرة الآن

75
00:05:35,890 --> 00:05:38,920
.هكذا سيتمّ الحفاظ على السّلام

76
00:05:39,450 --> 00:05:42,250
.كان التّحالف يفتقر للموهبة الضّروريّة

77
00:05:42,250 --> 00:05:45,000
.يتطلّب الحُكم امتلاك العديد من المسؤوليّات

78
00:05:45,000 --> 00:05:47,900
.لكنّهم حاولوا الهروب من تلك المسؤوليّات

79
00:05:47,900 --> 00:05:51,380
.لدينا التّقاليد المطلوبة لنحكم عصرًا

80
00:05:51,380 --> 00:05:56,240
لقد أُفسد العالم بالأفكار النّاقصة
.كالمساواة والحرّيّة

81
00:05:56,240 --> 00:06:00,330
.حان الوقت لنأخذ زمام السّيطرة مرّة أخرى

82
00:06:04,360 --> 00:06:07,970
لا أصدّق أنّ أوز تستعمل هذه
.الوسائل للسّيطرة على العالم

83
00:06:08,500 --> 00:06:11,730
حافظت مؤسّسة رومفلر
بأفكار كهذه لنفسها

84
00:06:11,730 --> 00:06:15,370
بينما كانت تُخفي وجودها
.ومساعيها داخل التّحالف

85
00:06:15,820 --> 00:06:18,710
استغلّت أوز هذا الوضع

86
00:06:18,710 --> 00:06:21,940
،قائلة أنّها ستحقّق السّلام للعالم
.إن لم يستطع التّحالف ذلك

87
00:06:22,430 --> 00:06:24,400
ستستمرّ الحرب إذًا؟

88
00:06:24,400 --> 00:06:28,140
على أوز أن تستمرّ بالفوز بهدف
.الاستمرار في الحكم

89
00:06:28,140 --> 00:06:31,870
.مكافآت النّصر ونجاح أوز سيكونان متوازيين

90
00:06:32,820 --> 00:06:34,790
إنّ حَلَّ أوز للسّياسات السّابقة

91
00:06:34,790 --> 00:06:37,740
.كان ثورة ضدّ سوء استعمال وفقر النّظام

92
00:06:37,740 --> 00:06:40,200
البلدان المشكّلة لمؤسّسة رومفلر

93
00:06:40,200 --> 00:06:42,830
سترغب بالمشاركة فقط في حروب
.فوزهم فيها مضمون

94
00:06:43,470 --> 00:06:48,600
لذلك تحتاج أوز لقوّات بذلٍ متنقّلة
.قويّة لكي تواصل وجودها

95
00:06:49,910 --> 00:06:52,250
.لكنّ الغاندام يمكنها هزيمة أوز

96
00:06:52,250 --> 00:06:55,410
.ترى أوز الغاندام على أنّها خطر حقيقيّ

97
00:06:55,830 --> 00:06:59,210
وبتهديدهم بمهاجمة المستعمرات
...بشكل مباشر

98
00:06:59,210 --> 00:07:01,070
.أسكتت أوز الغاندام تمامًا

99
00:07:01,570 --> 00:07:05,800
تحاول مؤسّسة رومفلر تدمير الغاندام
.في أسرع وقت ممكن

100
00:07:07,210 --> 00:07:10,580
.سيضحّون بأرواحٍ من أجل فرض السّيطرة

101
00:07:10,580 --> 00:07:14,910
.لكنّ هيرو ضحّى بحياته لإنقاذ الآخرين

102
00:07:14,910 --> 00:07:16,720
.لن يفهموا أبدًا

103
00:07:18,440 --> 00:07:21,980
.أودّ أن أُقدّم لكم قاهر التّحالف

104
00:07:21,980 --> 00:07:24,500
هذا الرّجل المحترم فارس شجاع يقاتل من أجلنا

105
00:07:24,500 --> 00:07:27,950
.في مسعاه اللاّنهائيّ لتحقيق سلام العالم

106
00:07:28,420 --> 00:07:31,920
!عضو في مؤسّسة رومفلر وقائد أوز

107
00:07:35,810 --> 00:07:37,760
!تيريز كوشرينادا

108
00:07:41,070 --> 00:07:47,200
يعتقد البعض أنّ قوّة أوز العسكريّة وقوات
.البذل المتنقّلة قد تتسبّب في حكم مفرط

109
00:07:47,200 --> 00:07:51,860
.عبارة "حُكم" مرتبطة دائمًا بالقمع والغطرسة

110
00:07:52,250 --> 00:07:57,910
أظنّ أنّه طريقة لفرد السّيطرة
.على الطّموحات

111
00:07:58,360 --> 00:08:01,000
.منح الإله الحرّيّة للبشريّة

112
00:08:01,000 --> 00:08:04,230
لذلك ما تحتاجه البشريّة هو نظام
.فوق نظام الإله

113
00:08:04,230 --> 00:08:08,630
ما كان الإله ليتوقّع هذا العالم
.بحروبه الّتي لا تنتهي

114
00:08:09,020 --> 00:08:12,590
.أنا واثق أنّ الإله سيفهم الخطوات الّتي نأخذها

115
00:08:19,040 --> 00:08:20,330
.لنغادر

116
00:08:20,330 --> 00:08:22,370
.لا فائدة من البقاء

117
00:08:22,370 --> 00:08:25,430
.يرى هؤلاء النّاسُ الحربَ كما يحلو لهم

118
00:08:25,430 --> 00:08:27,230
.لا شيء ممّا سنقوله سيغيّر ذلك

119
00:08:27,630 --> 00:08:29,190
آنسة ريلينا؟ آنسة ريلينا؟

120
00:08:32,180 --> 00:08:34,290
.أنتم مخطئون جميعًا

121
00:08:34,740 --> 00:08:37,910
.وستعود الغاندام لتصلح أخطاءكم

122
00:08:38,310 --> 00:08:41,810
من أجل أولئك الّذين تمّ الدّوس
.عليهم بهذا التّزييف

123
00:08:41,810 --> 00:08:43,880
!آنسة ريلينا، توقّفي

124
00:08:43,880 --> 00:08:45,500
!كلاّ، لم أنتهِ بعد

125
00:08:45,990 --> 00:08:48,120
.أنا أتوسّل إليك يا آنسة ريلينا

126
00:08:48,440 --> 00:08:50,090
!لا طائل من الحديث معهم

127
00:08:55,330 --> 00:08:57,730
.شكرًا لك أيّتها الملازم لوكريزيا نوين

128
00:09:08,870 --> 00:09:10,980
.أعتذر يا صاحب السّعادة

129
00:09:10,980 --> 00:09:11,480
.أستأذن

130
00:09:14,410 --> 00:09:17,980
سامحوني، إنّها الأخت الصّغرى
.لصديق قمتُ بدعوته

131
00:09:17,980 --> 00:09:20,410
ما كان هدفها من ذلك؟

132
00:09:21,080 --> 00:09:24,720
.لا بدّ أنّها شعر بقلقنا من الغاندام

133
00:09:24,720 --> 00:09:26,160
.تقول لنا أن نظلّ واثقين

134
00:09:26,160 --> 00:09:29,290
بذِكر الغاندام، أريد الحديث
.عن زيكس ماركيس

135
00:09:29,290 --> 00:09:32,830
أنا على علم بمواهبه، ولكنّك
.تعطيه حرّيّة أكثر ممّا يستحق

136
00:09:32,830 --> 00:09:33,720
ما القصد؟

137
00:09:34,310 --> 00:09:39,370
سمعتُ أنّه يعيد بناء بذلة الغاندام
.الّتي دُمرت ذاتيًّا في بحيرة فيكتوريا

138
00:09:40,570 --> 00:09:45,480
من الجنون إصلاح البذلة المتنقّلة
!الّتي نعتبرها خطرًا علينا

139
00:09:46,020 --> 00:09:50,330
على تلك الغاندام أن تُدمّر
!كتحذير للمستعمرات

140
00:09:50,690 --> 00:09:53,060
.أفهم ما تقولونه

141
00:09:53,060 --> 00:09:57,610
إن قرّرت المؤسّسة ذلك، فسأخبر
.العقيد زيكس أن يدمّرها في الحال

142
00:10:03,200 --> 00:10:07,300
أنا متفاجئ أنّ الإشاعات عن الغاندام
.كانت منتشرة هكذا

143
00:10:07,990 --> 00:10:12,000
إنّها تُظهر ضآلة حجم الضّرر
.الّذي تسبّبته لأوز

144
00:10:12,390 --> 00:10:14,960
...لكنّ سعادته لم يبدُ موافقًا

145
00:10:15,450 --> 00:10:17,830
.ما باليد حيلة إن كانت الأوامر من فوق

146
00:10:18,160 --> 00:10:20,680
هل ستتّبع الأوامر وتدمّر الغاندام؟

147
00:10:24,150 --> 00:10:25,470
كيف حال ريلينا؟

148
00:10:25,470 --> 00:10:27,190
.إنّها مليئة بالحيويّة

149
00:10:27,190 --> 00:10:28,390
.من الصّعب مرافقتها

150
00:10:28,960 --> 00:10:30,590
ما مدى معرفتها؟

151
00:10:30,590 --> 00:10:35,320
يبدو أنّ والدها الّذي ربّاها، السّيّد
.دارليان، قد أخبرها قبل أن يموت

152
00:10:35,900 --> 00:10:41,040
أخبرتُها أنّك جنديّ محترم جدير بالثّقة
.تربّيتَ في مملكة سانك

153
00:10:41,690 --> 00:10:46,530
قلتُ لها أيضًا أنّك كنتَ وحيدًا عندما
.دمّرت الغاندام 01 نفسها ذاتيًّا

154
00:10:47,330 --> 00:10:50,020
.وأنّك تعيد بناء الغاندام

155
00:10:50,020 --> 00:10:56,050
وهذا ما جعلها تعتقد أنّ طيّار الغاندام
.هيرو يوي، ما زال على قيد الحياة

156
00:10:56,310 --> 00:10:59,480
.هيرو يوي... هذا هو اسم الطّيّار إذًا

157
00:10:59,810 --> 00:11:04,010
.كان للآنسة ريلينا علاقة به أيضًا مثلك أنت

158
00:11:04,600 --> 00:11:05,780
.فهمت

159
00:11:05,780 --> 00:11:07,270
.شكرًا على الأخبار يا نوين

160
00:11:07,690 --> 00:11:11,200
لن تخبرها بنفسك؟

161
00:11:11,200 --> 00:11:11,940
.حوّل وانتهى

162
00:11:14,030 --> 00:11:15,640
!كيف يمكنني ذلك؟

163
00:11:15,960 --> 00:11:21,610
أنا زيكس ماركيس من المنظّمة المسؤولة
.على إراقة الدّماء هذه

164
00:11:27,590 --> 00:11:31,740
أستطيع إضرام النّار في هذه القلعة
.وإحراقها عن بكرة أبيها

165
00:11:32,360 --> 00:11:35,500
.لكن ما كان الإله ليغفر لي فعلة كهذه

166
00:11:36,380 --> 00:11:40,470
.ربّما سأُعاقب بسبب تهجّمي على الإله

167
00:11:41,330 --> 00:11:43,680
.لا بدّ إذًا من التّجهيز لعقاب لائق

168
00:11:44,150 --> 00:11:47,190
.ما الإله إلاّ كيان خياليّ خلقه البشر

169
00:12:01,190 --> 00:12:04,650
عارض المشير نوفينتا من تحالف
المجال الأرضيّ المتّحد

170
00:12:04,650 --> 00:12:08,920
.التّوسّع في مجال التّسلّح لردع المتمرّدين

171
00:12:08,920 --> 00:12:12,460
قدّم طلبًا للتّقليل من التّسلّح ونزع السّلاح

172
00:12:12,760 --> 00:12:15,930
.إلى بلدان الأرض والمستعمرات

173
00:12:15,930 --> 00:12:17,460
.لكنّ وفاته السّابقة لأوانها وضعت حدًّا لذلك

174
00:12:18,040 --> 00:12:22,050
اختارت أوز ذلك اليوم ليكون
فجر عصر جديد

175
00:12:22,050 --> 00:12:25,670
.وخدعت الغاندام للإطاحة بمكّوك نوفينتا

176
00:12:25,670 --> 00:12:28,510
.لكنّي لن أسمح لهذا بعرقلة عرضنا للسّلام

177
00:12:28,510 --> 00:12:29,970
!أ-أيّها المشير

178
00:12:37,590 --> 00:12:39,820
!لا تتهوّر أيّها الشّاب

179
00:12:40,440 --> 00:12:46,030
ونتيجة لهذه المأساة، فُقد أيّ
.سعي نحو السّلام للأبد

180
00:12:53,760 --> 00:12:54,730
.آنسة سيلفيا

181
00:12:54,730 --> 00:12:56,880
!عليك الهروب في الحال

182
00:12:57,410 --> 00:13:00,090
.أقدّر قلقك عليّ أيّها النّقيب

183
00:13:00,970 --> 00:13:05,430
ما زال الكثير من جنود تحالف المجال
.الأرضيّ المتّحد هنا في مارسيليا

184
00:13:06,200 --> 00:13:10,260
.على الأرجح أنّ لأوز خططًا لمهاجمتنا

185
00:13:12,790 --> 00:13:17,460
ظننتُ أنّ المدينة قد تكون محميّة
.لأنّ للتّحالف قاعدة هنا

186
00:13:17,460 --> 00:13:20,760
لكنّ القاعدة تشكّل الآن أكبر
.تهديد للمدينة

187
00:13:20,760 --> 00:13:21,900
.ستكون ساحة معركة

188
00:13:22,240 --> 00:13:24,060
.نعم، أعلم

189
00:13:24,060 --> 00:13:29,740
لكنّ نسيان ذكرياتي عن حياتي مع
.جدّي قد أخذ أكثر ممّا توقّعت

190
00:13:30,660 --> 00:13:32,860
.كان المشير نوفينتا من خيرة الرّجال

191
00:13:33,450 --> 00:13:36,680
فكّر دائمًا كيف يساعد العالم
.على تحقيق السّلام

192
00:13:37,180 --> 00:13:41,300
صحيح أنّ جدّي ما عاد معنا هنا
.لكنّ قلبه ما زال كذلك

193
00:13:41,810 --> 00:13:45,180
سأعيش حياتي متذكّرة
.أنّه هنا في قلوبنا

194
00:13:45,180 --> 00:13:46,510
...آنسة سيلفيا

195
00:13:48,250 --> 00:13:49,220
.أنا آسفة

196
00:13:51,620 --> 00:13:53,030
!أيّها النّقيب، نتعرّض لهجوم

197
00:13:53,030 --> 00:13:53,790
أهي أوز؟

198
00:13:53,790 --> 00:13:55,990
!نعم! عشر بذل حَمَل

199
00:13:55,990 --> 00:13:59,830
يعتقدون أنّ بإمكانهم السّيطرة
!على هذا المكان بعشر بذل متنقّلة؟

200
00:13:59,830 --> 00:14:00,810
!أيّها النّقيب

201
00:14:01,490 --> 00:14:04,150
.لا تقلقي، لن نستسلم بتلك السّهولة

202
00:14:04,600 --> 00:14:06,870
.اذهبي لمكان آمن

203
00:14:13,320 --> 00:14:16,110
استمرّوا في منع بذل الحَمَل من دخول
!المناطق السّكنيّة، وباشروا الهجوم

204
00:14:16,110 --> 00:14:17,370
!ردّي الهجوم يا بذل الأسد

205
00:14:30,860 --> 00:14:32,500
!هذا أشبه بقتال حرب عصابات

206
00:14:32,500 --> 00:14:34,500
!سندمّر كلّ بذل الأسد

207
00:14:34,500 --> 00:14:35,390
!خلفهم

208
00:14:50,780 --> 00:14:52,120
!ما الّذي فعلته؟

209
00:14:54,580 --> 00:14:55,270
!ماذا؟

210
00:14:58,720 --> 00:15:01,570
بذل الأسد التّابعة للتّحالف تنسحب
!إلى القنوات التّحأرضيّة

211
00:15:01,570 --> 00:15:03,230
.على الأرجح أنّها القوّات الرّئيسيّة

212
00:15:03,230 --> 00:15:05,000
!إلى كلّ بذل الحَمَل، تجمّعي

213
00:15:05,000 --> 00:15:06,730
.القنوات التّحأرضيّة

214
00:15:06,730 --> 00:15:08,380
.قرار واضح

215
00:15:09,100 --> 00:15:10,840
.لا تقلق بشأني

216
00:15:10,840 --> 00:15:12,590
.سأقف في طريقك بذراعي هذه

217
00:15:13,410 --> 00:15:17,050
لا يجب أن نسمح لأوز أن تعرف
.أنّ الغاندام في المدينة

218
00:15:19,390 --> 00:15:21,350
!بقي القليل منّا فحسب

219
00:15:22,340 --> 00:15:23,560
هل انتهى أمرنا؟

220
00:15:25,770 --> 00:15:27,920
!أسرعوا إلى النّقطة 211 من القنوات

221
00:15:27,920 --> 00:15:28,230
!حاضر

222
00:15:50,330 --> 00:15:51,470
!سيلفيا نوفينتا

223
00:16:04,890 --> 00:16:05,700
من أنت؟

224
00:16:10,120 --> 00:16:12,650
!دخلت بذل الحَمَل القنوات

225
00:16:12,650 --> 00:16:14,490
.لا خيار أمامنا سوى الاستسلام

226
00:16:15,860 --> 00:16:16,830
!أيّها القائد

227
00:16:17,730 --> 00:16:18,790
ما هذا؟

228
00:16:20,910 --> 00:16:22,410
.إنّها غاندام

229
00:16:22,410 --> 00:16:23,870
ما الّذي تفعله هنا؟

230
00:16:24,330 --> 00:16:26,640
!بذل الحَمَل على بُعد شارع منّا

231
00:16:27,130 --> 00:16:29,480
!سنتوقّف عن التّراجع ونهاجم فور قدومهم

232
00:16:29,480 --> 00:16:30,090
!أيّها القائد؟

233
00:16:30,590 --> 00:16:32,720
...على الأرجح أنّه لا يمكننا توفير وقت كثير

234
00:16:32,720 --> 00:16:34,550
.لكنّنا سنقاوم حتّى عودة الطّيّار

235
00:16:34,550 --> 00:16:35,590
.سنتدبّر أمرنا

236
00:16:35,590 --> 00:16:37,320
هل سنحمي الغاندام؟

237
00:16:37,320 --> 00:16:39,140
!نعم، ستكون دعمًا لنا

238
00:16:49,400 --> 00:16:50,650
!واصلوا الإطلاق! لا تتساهلوا

239
00:16:52,030 --> 00:16:52,860
.لقد أتى

240
00:17:07,020 --> 00:17:09,250
.الباقي بين يديك أيّتها الغاندام

241
00:17:12,330 --> 00:17:14,120
!كلّ بذل الأسد في القنوات قد دُمّرت

242
00:17:14,120 --> 00:17:15,100
!سوف نخرج

243
00:17:16,990 --> 00:17:18,080
!إنّها غاندام

244
00:17:18,790 --> 00:17:20,180
!لماذا هي هنا؟

245
00:17:30,150 --> 00:17:32,360
.سأتخلّص منك قبل مجيء البقيّة

246
00:17:38,480 --> 00:17:42,330
.لن أتدخّل في معركة بين أوز والتّحالف

247
00:17:42,710 --> 00:17:46,290
لا يمكنني المخاطرة بالسّماح
!لأيّ أحد برؤية الغاندام

248
00:17:49,070 --> 00:17:51,230
!دُمرّت خمس بذل حَمَل

249
00:17:51,230 --> 00:17:52,930
هل هذه معجزة؟

250
00:17:53,390 --> 00:17:56,520
لمن تكون هذه البذلة المتنقّلة المجهولة؟

251
00:17:57,080 --> 00:18:00,350
!مهمًا كان، فأنا شديد الامتنان له

252
00:18:03,100 --> 00:18:04,070
هيرو؟

253
00:18:05,220 --> 00:18:07,220
قلت أنّ اسمك هيرو يوي؟

254
00:18:12,080 --> 00:18:13,570
.هيرو يوي إذًا

255
00:18:14,280 --> 00:18:16,310
.هذا هو قبل جدّي

256
00:18:17,890 --> 00:18:19,280
أردتَ الحديث معي؟

257
00:18:23,980 --> 00:18:26,870
.كنتُ أنا من قتل المشير نوفينتا

258
00:18:27,180 --> 00:18:28,120
!ماذا؟

259
00:18:28,760 --> 00:18:30,270
.لقد أخطأت

260
00:18:30,270 --> 00:18:33,100
أطحتُ بمكّوك المشير نوفينتا
.عن طريق الخطأ

261
00:18:33,100 --> 00:18:37,270
وأدّى ذلك إلى قتله وقتل
.مناشدين آخرين للسّلام

262
00:18:41,240 --> 00:18:42,580
!كيف أمكنك ذلك؟

263
00:18:42,580 --> 00:18:43,560
!كيف؟

264
00:18:44,110 --> 00:18:47,030
هذا هو الشّيء الوحيد الّذي يمكنني
.فعله من أجلك الآن

265
00:18:47,710 --> 00:18:49,020
...سيلفيا نوفينتا

266
00:18:53,690 --> 00:18:55,660
.لا أستطيع تصويب خطئي

267
00:18:56,360 --> 00:19:01,130
أتمنّى أن يُمحى الغضب الّذي يشعر
به من أحبّوا المشير وندمُ روحه

268
00:19:01,130 --> 00:19:03,870
.بطريقة ما إن ضغطتِ على ذلك الزّناد

269
00:19:04,230 --> 00:19:06,270
!يا لك من جبان

270
00:19:06,270 --> 00:19:09,080
على الأرجح أنّك ترغب بسلك الطّريق
!الأسهل للخروج من وضعك هذا

271
00:19:09,740 --> 00:19:12,170
هذا هو الجواب الوحيد الّذي
.يمكنني تقديمه لك الآن

272
00:19:15,050 --> 00:19:16,090
!جبان

273
00:19:17,910 --> 00:19:19,090
!جبان

274
00:19:20,110 --> 00:19:23,720
.افهمي أنّي لم آتِ إلى هنا لأجعلك تعانين

275
00:19:24,580 --> 00:19:28,320
.سوف أزور جدّتك

276
00:19:28,320 --> 00:19:30,190
.سمعتُ أنّها في صقلية

277
00:19:31,460 --> 00:19:32,230
.نعم

278
00:19:32,830 --> 00:19:34,930
.هنا يبدأ كلّ شيء

279
00:19:34,930 --> 00:19:38,070
سيذهب إلى كلّ فرد من العائلة
.طالبًا أن يقدّموا حكمهم عليه

280
00:19:39,170 --> 00:19:42,660
.كلّ ما يفعله شامل وتمّ التّفكير به جيّدًا

281
00:19:42,970 --> 00:19:44,620
.كلّ ما يقوم به هيرو يوي

282
00:19:44,960 --> 00:19:47,750
!ما الحروب إلاّ عمليّات قتل بغيضة

283
00:19:47,750 --> 00:19:50,830
!كيف يمكنك أن تكون واضحًا بشأنها؟

284
00:19:52,910 --> 00:19:55,040
.إنّها الطّريقة الوحيدة الّتي يمكنني العيش بها

285
00:20:09,070 --> 00:20:09,890
!ابدأ

286
00:20:21,280 --> 00:20:24,950
تمّ تدمير الغاندام 01 حسب
.الأوامر أيّها المفتّش آخت

287
00:20:25,290 --> 00:20:27,280
.رأيتُ الانفجار

288
00:20:27,280 --> 00:20:29,890
لكن هل ستمانعون إن جمعتُ البقايا؟

289
00:20:29,890 --> 00:20:33,160
ألستَ راضيًا بالوثائق الّتي قدّمناها؟

290
00:20:33,660 --> 00:20:36,930
.أُفضّل التّأكّد من البقايا بأمّ عينيّ

291
00:20:36,930 --> 00:20:39,430
بما أنّي بحاجة لتجهيز وثيقة بنفسي

292
00:20:39,430 --> 00:20:43,380
.لإرضاء مسؤولي مؤسّسة رومفلر المتشدّدين

293
00:20:43,730 --> 00:20:44,830
.كما تريد

294
00:20:48,770 --> 00:20:51,680
لا أتخيّل أنّي سأجد أيّ شيء
.خارج المألوف

295
00:20:52,140 --> 00:20:56,270
ليس من المرجّح أن يكون زيكس
.ماركيس غير مبالٍ بالتّفاصيل

296
00:20:56,840 --> 00:21:00,940
لم تتبقّ أيّة أجزاء تابعة للغاندام
.في قاعدة بحيرة فيكتوريا

297
00:21:01,810 --> 00:21:04,660
.يحبّ زيكس البذل المتنقّلة

298
00:21:04,660 --> 00:21:08,740
لا أصدّق أنّه غيّر من أساليبه
.نزولاً لطلب منّا

299
00:21:09,370 --> 00:21:12,760
ما الّذي سيستفيده من معارضة
مؤسّسة رومفلر؟

300
00:21:12,760 --> 00:21:15,070
.لا أدري ما الّذي يفكّر به

301
00:21:15,660 --> 00:21:18,670
.لكنّ رومفلر تفرد سيطرتها على هذا العصر

302
00:21:19,030 --> 00:21:21,570
،وبهدف الارتقاء إلى مناصب عليا

303
00:21:21,570 --> 00:21:24,800
نحتاج لأن نُثبت أنّ زيكس قد
.خان الأوامر الرّسميّة

304
00:21:25,340 --> 00:21:28,480
يحاول المفتّش العثور على عيوب تخصّك

305
00:21:28,480 --> 00:21:31,260
.ليكون على وفاق مع مؤسّسة رومفلر

306
00:21:31,750 --> 00:21:35,230
.لن يجد أيّ شيء مختلفًا عمّا في الوثائق

307
00:21:35,680 --> 00:21:38,730
.آسف لأنّني ورّطتُك في عرضي الصّغير هذا

308
00:21:39,290 --> 00:21:44,360
فكّرتُ في أنّها ستكون خسارة حقيقيّة
.إنّ دمّرنا الغاندام 01 في هذه المرحلة

309
00:21:44,990 --> 00:21:49,320
لكنّنا دمّرنا معظم الأجزاء
.الاحتياطيّة لبذلة تالغيس

310
00:21:49,760 --> 00:21:52,870
في تلك الحالة، سيكون عليّ
.أن أكون أكثر حذرًا معها

311
00:21:53,400 --> 00:21:57,290
لا يمكن لأيّ طيّار أن يؤذي
.تالغيس والعقيد زيكس

312
00:21:57,540 --> 00:22:00,750
.ليس صحيحًا. هنالك رجل واحد على الأقلّ

313
00:22:13,770 --> 00:22:17,390
يُـتـبـع

314
00:22:25,110 --> 00:22:31,280
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

315
00:22:32,740 --> 00:22:39,000
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

316
00:22:39,790 --> 00:22:43,670
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

317
00:22:43,920 --> 00:22:47,130
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

318
00:22:47,630 --> 00:22:53,680
حبّ فحسب! إنّه يثير أعصابي

319
00:22:55,470 --> 00:23:02,440
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

320
00:23:02,810 --> 00:23:09,950
حبّ فحسب! أنا دائمة التّفكير به

321
00:23:10,990 --> 00:23:17,370
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

322
00:23:18,290 --> 00:23:21,370
... حبّ فحسب ...

323
00:23:28,210 --> 00:23:30,220
في الحلقة القادمة

324
00:23:31,630 --> 00:23:33,590
.من المفترض أن تكون الحرب قاسية

325
00:23:34,270 --> 00:23:37,980
لكنّ هيرو وضع مصيره بين
.يدي السّيّدة نوفينتا

326
00:23:37,980 --> 00:23:40,770
كما أنّ زيكس يتوق لمعركة
.حاسمة كمحارب

327
00:23:41,510 --> 00:23:44,610
تدعو نوين هيرو إلى القطب
.الجنوبيّ حيث ينتظر زيكس

328
00:23:44,970 --> 00:23:48,010
.ويلاحقهم المفتّش آخت بقوّاته الخاصّة

329
00:23:48,450 --> 00:23:51,840
عودة الغاندام للحياة ستشعل
.شرارة جديدة خاصّة بها

330
00:23:52,540 --> 00:23:55,860
في الحلقة الخامسة عشر
،"من "جناح الغاندام

331
00:23:55,860 --> 00:23:57,940
."إلى أرض المعركة، القطب الجنوبيّ"