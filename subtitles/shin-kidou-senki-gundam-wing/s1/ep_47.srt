1
00:01:34,050 --> 00:01:37,410
.يا رفاقي الجنود، هذا العالم ينتمي للمحاربين

2
00:01:37,410 --> 00:01:40,950
ذلك النّقاء هو ما يجعل ساحة
.المعارك غاية في الجمال

3
00:01:41,430 --> 00:01:44,450
لننهِ معركة البشريّة الأخيرة

4
00:01:44,450 --> 00:01:46,910
!ونبعد أهوال الحرب عن موطننا

5
00:01:51,340 --> 00:01:53,540
.هذه المعركة هي لحظة هامّة لتاريخنا

6
00:01:54,680 --> 00:01:59,040
يجب أن تكون موضوعًا على النّاس
.أن يناقشوه لأجيال قادمة

7
00:02:00,680 --> 00:02:01,980
،ومن أجل ذلك

8
00:02:02,510 --> 00:02:06,350
.على العديد من المحاربين هنا أن يضحّوا بحياتهم

9
00:02:07,390 --> 00:02:11,850
كلّ قوّات الدّمى المتنقّلة قد دخلت المعركة
.مع قوّات العدوّ الرّئيسيّة ووحدة الإنزال

10
00:02:12,520 --> 00:02:15,040
.ما هذه المعرك إلاّ البداية

11
00:02:15,040 --> 00:02:21,870
علينا أن ندفع سكّان الأرض ليعرفوا
!كم أنّ عزمنا قويّ في الفضاء

12
00:02:29,410 --> 00:02:30,690
تحقّق من النّظام؟

13
00:02:30,690 --> 00:02:31,770
.نعم

14
00:02:37,550 --> 00:02:38,520
...هيرو

15
00:02:39,180 --> 00:02:41,610
.سأبقى هنا حتّى نهاية المعركة

16
00:02:41,610 --> 00:02:42,260
ماذا؟

17
00:02:42,840 --> 00:02:46,040
سيكون من الصّعب على تيريز تدمير
.سفينة الميزان حاليًّا

18
00:02:46,830 --> 00:02:49,230
.لذلك عندما يعيد الأوان، سأقوم بذلك بنفسي

19
00:02:49,900 --> 00:02:52,690
.أعتقد أنّ علينا إيقاف هذه المعركة

20
00:02:53,130 --> 00:02:57,190
الدّكتاتوريّون وحدهم من يعتقدون أنّه
!يجب التّضحية بالأرواح لتحقيق السّلام

21
00:02:57,790 --> 00:03:01,740
.لكنّ زيكس وتيريز جاهزان للتّضحية بروحيهما

22
00:03:02,140 --> 00:03:04,870
.لهذا السّبب لا نيّة لي في إيقافهم

23
00:03:05,210 --> 00:03:05,990
!مهلاً

24
00:03:06,710 --> 00:03:08,330
!ابقي هنا معي

25
00:03:08,330 --> 00:03:09,310
!ماذا؟

26
00:03:10,420 --> 00:03:12,880
ستحميني يا هيرو؟

27
00:03:13,950 --> 00:03:18,340
لا أريد أن أشعر أنّني أدين لزيكس
.بأيّ شيء عندما نتقاتل

28
00:03:25,060 --> 00:03:31,100
إن هُزمت هذه السّفينة الحربيّة بالفعل في هذه
.المعركة، فلن يكون لديك أيّ سبب لقتاله

29
00:03:37,480 --> 00:03:40,070
.يبدو أنّ الجانبين متساويين حتّى الآن

30
00:03:40,380 --> 00:03:42,530
والآن، مع من علينا أن نقاتل؟

31
00:03:43,180 --> 00:03:47,380
يبدو الوضع متساويًا فقط لأنّ سفينة الميزان
.لم تطلق سلاحها الرّئيسيّ بعد

32
00:03:47,920 --> 00:03:51,150
إنّهم يضطرّوا للقيام بعمليّات إصلاح
.في كلّ مرّة يطلقونه فيها

33
00:03:51,460 --> 00:03:53,640
وهذا يساعد الجانب الّذي يقاتل من أجل الأرض

34
00:03:53,640 --> 00:03:57,350
،لكن بمجرّد أن يتمّ إصلاحه
.ستكون الأفضليّة للنّاب الأبيض

35
00:03:57,350 --> 00:04:01,690
.يمثّل النّاب الأبيض آراء جزء من المستعمرات

36
00:04:01,690 --> 00:04:04,790
.إنّه لا يمثّل كلّ المستعمرات

37
00:04:05,200 --> 00:04:08,760
أنا واثق أنّ العديد من النّاس في
.المستعمرات يأملون في السّلام

38
00:04:09,310 --> 00:04:14,180
ولكن هل ستكون مساعدة تيريز
في صالح الفضاء؟

39
00:04:14,510 --> 00:04:18,410
.يقاتل تيريز ضدّ سفينة الميزان والدّمى المتنقّلة

40
00:04:18,410 --> 00:04:20,010
.وليس المستعمرات

41
00:04:20,620 --> 00:04:21,810
.معك حقّ

42
00:04:22,120 --> 00:04:24,910
.التّهديد الفعليّ الآن هو سفينة الميزان

43
00:04:26,630 --> 00:04:27,820
.لا بأس

44
00:04:28,160 --> 00:04:30,240
.تملك سفينة الميزان الكثير من القوّة

45
00:04:30,240 --> 00:04:33,260
لكن ماذا عن هيرو والآنسة ريلينا؟

46
00:04:33,570 --> 00:04:36,210
.حسب معرفتي به، فسيكونان بخير

47
00:04:36,800 --> 00:04:38,540
حسنًا، هل اتّخذنا قرارنا إذًا؟

48
00:04:38,820 --> 00:04:39,820
.نعم

49
00:04:39,820 --> 00:04:42,880
.فلتتّجه بيسمليون مباشرة نحو سفينة الميزان

50
00:04:50,070 --> 00:04:53,050
!إنّهم يدورون حول منطقة المعركة ويتّجهون نحونا

51
00:04:53,450 --> 00:04:54,770
!أغبياء

52
00:04:54,770 --> 00:04:58,140
!ما زالت الغاندام ترانا كأعداء حتّى الآن؟

53
00:04:59,990 --> 00:05:01,510
.ذلك ليس مفاجئًا

54
00:05:01,510 --> 00:05:05,050
.من وجهة نظرهم، كلّ قوّة عدوّ لهم

55
00:05:05,360 --> 00:05:06,760
!هذا وضع لا يدعو للضّحك

56
00:05:06,760 --> 00:05:09,390
لا يمكننا تحمّل جعل دمى جبهتنا
!الأماميّة المتنقّلة تواجههم

57
00:05:09,920 --> 00:05:11,540
!لا وسيلة لنا لإيقافهم

58
00:05:12,250 --> 00:05:13,250
.أنا سأواجههم

59
00:05:13,250 --> 00:05:14,390
!ماذا؟

60
00:05:14,390 --> 00:05:14,960
!أنت؟

61
00:05:15,620 --> 00:05:17,990
.سآخذ ثلاثة بذل عذراء معي

62
00:05:17,990 --> 00:05:19,010
!ثلاثة فقط؟

63
00:05:19,010 --> 00:05:20,340
!مستحيل

64
00:05:21,010 --> 00:05:22,670
.إنّها كافية لإبقائي على قيد الحياة

65
00:05:23,580 --> 00:05:24,540
!أيّها القائد ملياردو

66
00:05:28,320 --> 00:05:29,370
!أيّها الطّاقم

67
00:05:29,370 --> 00:05:30,850
!ألم يتمّ إصلاح المدفع حتّى الآن؟

68
00:05:33,220 --> 00:05:36,150
.آنسة نوين، ابقي واحرسي بيسمليون

69
00:05:36,150 --> 00:05:40,650
لا تقارن بذل الثّور بالبذل الأخرة
.وأعتقد أنّنا نعرف خصمنا

70
00:05:41,000 --> 00:05:42,060
.عُلم

71
00:05:46,640 --> 00:05:48,230
!يبدو أنّهم قادمون

72
00:05:48,940 --> 00:05:49,790
!إنّه هو

73
00:05:49,790 --> 00:05:51,660
!لكن لا ترافقه إلاّ ثلاث بذل عذراء

74
00:05:51,660 --> 00:05:52,700
!سيكون هذا سهلاً

75
00:05:53,350 --> 00:05:54,790
.سألقّنكم درسًا

76
00:05:54,790 --> 00:05:57,400
!هكذا يجب استعمال الدّمى المتنقّلة

77
00:05:58,020 --> 00:05:59,240
!هيّا بنا

78
00:05:59,550 --> 00:06:00,950
!تمهّل يا ديو

79
00:06:03,290 --> 00:06:04,260
!ماذا؟

80
00:06:08,390 --> 00:06:09,120
!ديو

81
00:06:21,510 --> 00:06:24,320
.قتال الدّمى المتنقّلة مملّ بكلّ تأكيد

82
00:06:26,010 --> 00:06:26,900
.يا صاحب السّعادة

83
00:06:26,900 --> 00:06:29,410
.دخلت الغاندام المعركة مع إبيون

84
00:06:30,250 --> 00:06:33,150
.تكره تلك الغاندام زيكس بكلّ تأكيد

85
00:06:33,610 --> 00:06:36,400
.أودّ شكرهم على مساعدتهم

86
00:06:36,400 --> 00:06:39,420
.لكنّهم لا يقاتلون إلى جانبي

87
00:06:40,630 --> 00:06:41,820
.كن حذرًا

88
00:06:42,890 --> 00:06:44,120
.شكرًا لك يا ليدي

89
00:06:44,560 --> 00:06:46,550
.لكنّ أهدافنا متشابهة

90
00:06:46,920 --> 00:06:49,690
.يجب إسقاط سفينة الميزان

91
00:06:53,890 --> 00:06:54,390
!ماذا؟

92
00:06:57,980 --> 00:06:58,560
...إنّها

93
00:07:08,950 --> 00:07:11,320
!لماذا لا تهاجم إلاّ كاتر؟

94
00:07:12,130 --> 00:07:14,030
!هدفها هو تقليل عددنا

95
00:07:14,640 --> 00:07:17,290
!ربّما تعتقد أنّه من السّهل هزيمتي

96
00:07:18,160 --> 00:07:20,250
!أنا أحاول سحق العقل المدبّر أوّلاً

97
00:07:20,570 --> 00:07:23,300
...في تلك الحالة، إن أبقيتها قريبة منّي

98
00:07:23,810 --> 00:07:25,290
!ديو! ووفي

99
00:07:25,290 --> 00:07:25,790
!حسنًا

100
00:07:30,480 --> 00:07:32,010
!لن أسمح لكم بترتيب تشكيلتكم

101
00:07:49,460 --> 00:07:51,230
.ممتاز يا ملياردو

102
00:07:51,230 --> 00:07:53,910
.البذل المتنقّلة موجودة حيث تريدها

103
00:07:55,900 --> 00:07:58,850
حتّى وحدة الإنزال خاصّتنا لا يمكنها
.الاقتراب من سفينة الميزان

104
00:08:00,040 --> 00:08:03,390
أما زال إم أو-2 لم يتحرّك خلال المعركة؟

105
00:08:03,390 --> 00:08:04,330
.نعم

106
00:08:04,330 --> 00:08:06,500
.إنّهم يقبلون البذل المتنقّلة المتضرّرة فحسب

107
00:08:06,980 --> 00:08:09,800
.ظننت أنّهم قد يمتلكون سلاحًا جديدًا

108
00:08:09,800 --> 00:08:11,620
.ربّما تكون مجرّد قاعدة مؤن

109
00:08:12,150 --> 00:08:14,710
.حسنًا، سنحرّك سفينة الميزان

110
00:08:14,710 --> 00:08:15,720
!مهلاً رجاءً

111
00:08:16,510 --> 00:08:20,720
هل ستدمّر هذا المشهد الجميل
للصِّدام الجاري بين هاتين القوّتين؟

112
00:08:21,390 --> 00:08:25,850
.رفض القائد ملياردو عرض تيريز لمنازلته

113
00:08:27,430 --> 00:08:30,730
!جهّزوا مسارًا سيوصلنا إلى الأرض حول إم أو-2

114
00:08:31,700 --> 00:08:33,600
!ولا تنسوا إعلام القائد

115
00:08:40,650 --> 00:08:43,110
.كان ذلك القرار الصّحيح

116
00:08:43,680 --> 00:08:49,340
لكن هل يمكنك إخبار النّاس في الفضاء أنّ هذا
القرار قرار حزين للغاية أيضًا يا ملياردو؟

117
00:08:52,620 --> 00:08:54,110
.لا مشكلة

118
00:08:54,890 --> 00:08:58,760
علينا الآن أن نري الأرض كم أنّ الوضع
.محزن هنا في الفضاء

119
00:08:59,600 --> 00:09:01,250
!تترك سفينة الميزان جبهة المعركة

120
00:09:01,560 --> 00:09:03,230
!إنّها متّجهة إلى إم أو-2

121
00:09:03,840 --> 00:09:09,070
يملك إم أو-2 قوّة عسكريّة صغيرة
.ولا يمكنه التّحركّ من تلقاء نفسه

122
00:09:09,070 --> 00:09:13,240
أعتقد أنّ سفينة الميزان ستدور حول
.إم أو-2 وتتّجه مباشرة للأرض

123
00:09:13,710 --> 00:09:14,950
!لنذهب خلفها

124
00:09:15,330 --> 00:09:16,600
!ما الفائدة من ذلك؟

125
00:09:16,600 --> 00:09:18,990
!لا نملك الأسلحة المناسبة لتدمير سفينة الميزان

126
00:09:19,300 --> 00:09:20,940
.بالطّبع نملكها

127
00:09:21,420 --> 00:09:23,790
.نملك ما يكفي لتدمير مدفع سفينة الميزان الرّئيسيّ

128
00:09:24,470 --> 00:09:25,780
!مهلاً! مستحيل

129
00:09:26,560 --> 00:09:28,530
!أخلوا كلّ المدنيّين

130
00:09:28,530 --> 00:09:30,290
!سيحتضنهم إم أو-2

131
00:09:30,900 --> 00:09:31,920
.فهمت

132
00:09:32,700 --> 00:09:34,430
.أعتقد أنّك على حقّ

133
00:09:35,270 --> 00:09:36,080
!حسنًا

134
00:09:36,080 --> 00:09:38,000
!سننتقل إلى حجرة القيادة الثّانويّة

135
00:09:45,040 --> 00:09:47,850
.أعتقد أنّ ذلك هو القرار المنطقيّ

136
00:09:47,850 --> 00:09:50,360
!لكنّني لن أسمح لكم بالإطاحة بسفينة الميزان

137
00:09:53,890 --> 00:09:55,570
!إنّهم يسعون خلف بيسمليون

138
00:09:56,000 --> 00:09:57,270
!سنوقفهم

139
00:10:07,730 --> 00:10:09,920
!كيف أمكنها تفادي هجوم ناتاكو؟

140
00:10:09,920 --> 00:10:10,700
!لا فائدة من هذا

141
00:10:11,440 --> 00:10:15,200
.تشكّل الدّمى المتنقّلة الثّلاثة درعًا واحدًا

142
00:10:15,570 --> 00:10:18,170
!علينا الاقتراب وتدميرها بشكل منفصل

143
00:10:25,750 --> 00:10:27,220
!نوين! ابتعدي عن طريقي

144
00:10:27,690 --> 00:10:28,650
.زيكس

145
00:10:29,090 --> 00:10:31,560
.لا رغبة لي في قتالك

146
00:10:32,660 --> 00:10:33,390
...ولكن

147
00:10:36,160 --> 00:10:37,860
!نوين! ابتعدي

148
00:10:38,360 --> 00:10:39,780
!لن أبتعد

149
00:10:39,780 --> 00:10:42,200
!حتّى إن اقتضى ذلك قتلك

150
00:10:43,070 --> 00:10:44,030
!نوين

151
00:10:44,970 --> 00:10:46,120
!زيكس

152
00:10:47,770 --> 00:10:48,740
!آنسة نوين

153
00:10:51,420 --> 00:10:53,010
!ما الّذي تنتظرينه؟

154
00:10:56,450 --> 00:10:57,880
!ماذا تفعلين؟ أطلقي

155
00:10:58,620 --> 00:10:59,610
!آنسة نوين

156
00:11:16,820 --> 00:11:18,530
!لا أفهم

157
00:11:19,640 --> 00:11:22,830
!لماذا ما زلت ضعيفًا هكذا؟

158
00:11:30,720 --> 00:11:31,680
...زيكس

159
00:11:43,580 --> 00:11:46,140
!توشك بيسمليون على الاصطدام بنا

160
00:11:46,140 --> 00:11:47,430
!ماذا؟

161
00:11:48,120 --> 00:11:49,070
!تفادوها

162
00:11:49,070 --> 00:11:50,770
!لا نقدر! لا يوجد وقت كافٍ

163
00:11:51,230 --> 00:11:52,820
!أطلقوا كلّ المدافع

164
00:11:53,130 --> 00:11:54,730
!أسقطوا تلك السّفينة

165
00:11:59,230 --> 00:12:00,670
!أواثقة من الاصطدام بهم؟

166
00:12:01,120 --> 00:12:03,030
!ذلك هو السّبيل لتدمير سلاحهم الأساسيّ

167
00:12:03,530 --> 00:12:05,720
!استعملوا معزّزات بي جي واي أيضًا

168
00:12:05,720 --> 00:12:07,490
!حطّموا المحرّك إن اقتضى الأمر

169
00:12:07,760 --> 00:12:08,700
!عُلم

170
00:12:14,480 --> 00:12:15,070
!اسمعوا

171
00:12:15,070 --> 00:12:16,630
!هل فقدوا صوابهم؟

172
00:12:17,140 --> 00:12:18,040
.كلاّ

173
00:12:18,040 --> 00:12:19,090
!إنّه الخيار الوحيد المتبقّي

174
00:12:23,520 --> 00:12:25,550
!أنا أحيّي شجاعتكم

175
00:12:27,850 --> 00:12:29,060
!سوف يصطدمون بنا

176
00:12:29,450 --> 00:12:30,900
!أوقفوا كلّ المحرّكات

177
00:12:31,300 --> 00:12:33,270
!ليستعدّ الجميع للاصطدام

178
00:12:35,800 --> 00:12:37,270
ما الأمر يا هيرو؟

179
00:12:38,310 --> 00:12:40,060
.انبطحي واحمي رأسك

180
00:12:40,930 --> 00:12:42,530
!سوف تصطدم بنا بيسمليون

181
00:12:45,380 --> 00:12:47,630
!تضرّر المحرّكان 1 و3

182
00:12:47,630 --> 00:12:49,580
!لسنا مضطرّين الآن لإيقاف تشغيلهما

183
00:12:50,030 --> 00:12:52,040
!أروني بعض الحماس

184
00:13:19,550 --> 00:13:22,300
!أعطوني تقرير الأضرار

185
00:13:22,300 --> 00:13:24,400
!أسرعوا وأخمدوا النّيران في خزّان الوقود

186
00:13:26,920 --> 00:13:29,910
.المدفع الرّئيسيّ قد دمّر بالكامل

187
00:13:30,420 --> 00:13:33,120
.لم ينفجر لأنّه لم يكن مشحونًا

188
