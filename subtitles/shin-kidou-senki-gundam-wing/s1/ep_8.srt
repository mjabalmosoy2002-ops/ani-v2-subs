150
00:10:45,200 --> 00:10:46,500
.لكنّي أصدّقه

151
00:10:46,860 --> 00:10:48,120
.أنا فخورة به

152
00:10:48,120 --> 00:10:52,420
أريد أن أتبجّح وأقول أنّي أعرف هيرو
.الّذي منع الانفجار

153
00:11:12,270 --> 00:11:15,150
!عليّ أن أعترف أنّك مميّز يا هيرو

154
00:11:22,410 --> 00:11:24,390
.كانت مهمّة بائسة

155
00:11:24,390 --> 00:11:27,240
!لقد... لقد فشلتُ تمامًا

156
00:11:39,510 --> 00:11:43,090
.أنا آسفة لعدم مقدرتي على إبادة الغاندام

157
00:11:43,090 --> 00:11:44,010
فعلاً؟

158
00:11:44,010 --> 00:11:45,840
.هذا ليس من طباعك

159
00:11:45,840 --> 00:11:48,640
كيف كنتِ تنوين تدميرهم؟

160
00:11:49,220 --> 00:11:55,110
حاولت تفعيل أجهزة التّدمير الذّاتيّ
.في صواريخ قاعدة إدواردز الجديدة

161
00:11:55,730 --> 00:11:56,710
وماذا بعد؟

162
00:11:56,710 --> 00:12:00,440
.أبطل الغاندام القنابل وأوقفوا الانفجار

163
00:12:00,440 --> 00:12:02,360
.أنقذ الغاندام الوضع

164
00:12:04,240 --> 00:12:06,720
.الأرض منطقة محصورة

165
00:12:06,720 --> 00:12:08,600
.ليس علينا تلويثها بلا تفكير

166
00:12:10,670 --> 00:12:12,830
.البشر ضعفاء وواهنون

167
00:12:13,250 --> 00:12:15,450
.يستطيع أيّ أحد قتل أحد آخر

168
00:12:16,000 --> 00:12:18,000
.لكن ليس علينا إساءة استعمال هذه الإمكانيّة

169
00:12:18,770 --> 00:12:21,550
.علينا شكر الغاندام هذه المرّة

170
00:12:22,760 --> 00:12:24,260
...وأيّضًا يا ليدي

171
00:12:24,260 --> 00:12:26,760
.عليك أن تتعلّمي المزيد عن منظّمة أوز

172
00:12:27,510 --> 00:12:29,600
أتعلّم المزيد عن أوز؟

173
00:12:39,460 --> 00:12:43,710
لا توجد إشارات للاستسلام
.حتّى بعد كلّ هذه الأضرار

174
00:12:43,710 --> 00:12:47,200
.العميد دايغو أونيغل رجل عنيد بالفعل

175
00:12:48,020 --> 00:12:51,130
.لكن آمل أن يكون رجلاً بغيضًا أيضًا

176
00:12:51,130 --> 00:12:53,160
.وإلاّ شعر زيكس بحزم أقلّ

177
00:12:53,820 --> 00:12:55,210
!كيف تجرؤون؟

178
00:12:55,960 --> 00:12:59,400
تتوقّعون من مقرّ التّحالف الرّئيسيّ
أن يسقط بهذه السّهولة؟

179
00:12:59,400 --> 00:13:01,960
لن أسمح لأوز بالاقتراب خطوة
!واحدة من هذه القاعدة

180
00:13:02,320 --> 00:13:05,630
أوافقك الرّأي على أنّ الأمن
.في هذه القاعدة ممتاز

181
00:13:07,220 --> 00:13:10,780
لكن إن كان رجالك غير منتبهين
لوهلة قصيرة

182
00:13:10,780 --> 00:13:12,390
.لكانت هذه القاعدة قد سقطت في الحال

183
00:13:13,460 --> 00:13:14,850
!زيكس ماركيس

184
00:13:16,790 --> 00:13:18,560
.إذًا تعرف أنّه كان أنا

185
00:13:19,460 --> 00:13:24,110
كنتَ حذرًا منّي خلال أيّام التّحالف

186
00:13:24,110 --> 00:13:26,200
لذلك ظننتُ أنّك تستطيع
.تمييزي من البقيّة

187
00:13:27,620 --> 00:13:29,140
!كانت تلك دواعي ذلك العصر

188
00:13:29,140 --> 00:13:31,370
!جعلتني الحرب أقوم بأشياء كتلك

189
00:13:31,370 --> 00:13:36,540
لم تكن إبادة مملكة سانك رغبة
.خاصّة لي بل قرار التّحالف

190
00:13:36,830 --> 00:13:41,090
لم يكن لمملكة سانك أيّ نوايا
.لمقاومة التّحالف

191
00:13:41,090 --> 00:13:44,140
.لكنّك دبّرتَ لهجوم ودمّرت المملكة

192
00:13:44,140 --> 00:13:48,200
عارضتْ عدّة دول توسيع القوّات العسكريّة

193
00:13:48,200 --> 00:13:49,760
.التّابعة لتحالف المجال الأرضيّ المتّحد

194
00:13:50,470 --> 00:13:52,260
.كانت مملكة سانك إحدى المعارضين

195
00:13:52,720 --> 00:13:56,440
قلت أنّ بإمكانك إبادة مصدر
التّمرّد بتدمير العائلة المالكة

196
00:13:56,440 --> 00:13:59,280
.لأنّها تؤثّر على البلدان المجاورة

197
00:13:59,830 --> 00:14:01,610
!قدتَ الهجوم بشكل شخصيّ

198
00:14:12,330 --> 00:14:14,660
...ملياردو بيسكرافت

199
00:14:22,850 --> 00:14:27,550
لترقد بسلام يا ملياردو بيسكرافت
.المُخَوَّن والغاضب

200
00:14:36,890 --> 00:14:38,390
...أتعلّم المزيد عن أوز

201
00:14:38,390 --> 00:14:42,140
أيعقل أن يكون ذلك
لأنّي لا أفهم السّيّد تيريز؟

202
00:14:42,520 --> 00:14:43,690
.مستحيل

203
00:14:43,940 --> 00:14:45,070
.أيّها القائد

204
00:14:45,070 --> 00:14:49,490
ثمّة ناقلتان من قوّات 505 الدّاعمة
.تريد الاتّصال بنا

205
00:14:49,490 --> 00:14:51,070
أيّ نوع من النّاقلات؟

206
00:14:51,070 --> 00:14:53,280
.الحَمَل، من قوّاتنا الخاصّة

207
00:14:53,280 --> 00:14:54,830
.قُبل الاتّصال

208
00:14:54,830 --> 00:14:57,410
!معكم الأنف الكبير، ابدؤوا الاتصال

209
00:14:58,250 --> 00:14:59,040
.مهلاً

210
00:14:59,040 --> 00:15:01,130
من أيّ قاعدة أتوا؟

211
00:15:01,330 --> 00:15:02,420
.لحظة

212
00:15:02,420 --> 00:15:04,130
.قاعدة إدواردز الجديدة

213
00:15:04,130 --> 00:15:06,090
!أغبياء! هؤلاء أعداء

214
00:15:13,100 --> 00:15:15,470
!تتّجه النّاقلة الأخرى للسّفينة الأمّ هذه

215
00:15:15,930 --> 00:15:17,180
!أسقطوها

216
00:15:24,400 --> 00:15:26,360
.بدأ الوقود ينفد منّي

217
00:15:26,360 --> 00:15:29,280
.لن تتسبّب النّاقلة بانفجار كبير

218
00:15:29,280 --> 00:15:31,790
.لذلك سأغادر على متن البذلة المتنقّلة

219
00:15:45,290 --> 00:15:46,340
!إنّها بذلة غاندام

220
00:15:46,340 --> 00:15:47,800
!الغاندام هنا

221
00:15:47,800 --> 00:15:49,720
!ماذا؟! على السّفينة؟

222
00:15:49,720 --> 00:15:50,970
!قاتلوه ببِدل الأسد

223
00:16:08,110 --> 00:16:10,150
!دُمرت عشرون بذلة أسد

224
00:16:10,150 --> 00:16:11,490
!ما مشكلتكم؟

225
00:16:11,490 --> 00:16:14,320
!أطيحوا به في البحر ونالوا منه بالسّرطان

226
00:16:14,320 --> 00:16:15,870
!أين سفينة السّيّد تيريز؟

227
00:16:15,870 --> 00:16:17,830
!في الأسطول الأيسر

228
00:16:17,830 --> 00:16:18,450
!جيّد

229
00:16:20,540 --> 00:16:21,500
!هذه

230
00:16:24,920 --> 00:16:25,960
!إنّها غاندام

231
00:16:25,960 --> 00:16:28,500
!لقد خرجت من النّاقلة الّتي هوت

232
00:16:28,840 --> 00:16:29,460
!ماذا؟

233
00:16:33,180 --> 00:16:35,890
!دمّرت الغاندام الّتي على السّفينة الجسر

234
00:16:35,890 --> 00:16:38,390
!دُمّرت 70 بالمائة من بِدل الأسد

235
00:16:38,390 --> 00:16:40,060
!ألا يمكننا استعمال بِدل الحَمَل؟

236
00:16:40,070 --> 00:16:42,690
!كلاّ، ستُستهدف كلّ مصاعدنا

237
00:16:43,940 --> 00:16:46,650
لِمَ الآن في هذا اليوم السّعيد
!لبداية الجديدة؟

238
00:16:46,980 --> 00:16:48,190
!أيّتها المقدّم ليدي أن

239
00:16:48,190 --> 00:16:50,310
!ما تزال الغاندام تهاجم السّفينة

240
00:16:51,070 --> 00:16:53,610
!سبق وأخبرتكم، أطيحوا به في البحر

241
00:16:53,610 --> 00:16:56,160
.لا تعلموني بكلّ حركة يقوم بها

242
00:16:56,160 --> 00:16:57,620
!اتبعوا أوامري فحسب

243
00:16:58,160 --> 00:16:59,080
!حاضر

244
00:16:59,080 --> 00:17:02,000
!الغاندام في خطّ الإقلاع المنجنيقيّ الآن

245
00:17:02,000 --> 00:17:02,620
!جيّد

246
00:17:02,620 --> 00:17:05,110
أرسلوا بذلة أسد وأطيحوا
!بتلك الغاندام في البحر

247
00:17:32,440 --> 00:17:33,610
كيف هي التّجهيزات؟

248
00:17:33,610 --> 00:17:34,650
!اكتملت

249
00:17:36,990 --> 00:17:40,370
يجدر بها أن تتحرّك كبِدل الحَمَل بوجود
!إمكانية التّنقل المتقدّمة هذه

250
00:17:41,540 --> 00:17:44,410
جيّدة ما دمتُ أستطيع الطّيران
!فوق الغاندام الأخرى

251
00:17:44,410 --> 00:17:46,710
!تلك الغاندام تهاجم سفينة السّيّد تيريز؟

252
00:17:46,710 --> 00:17:48,330
!ليس لوقت طويل

253
00:17:58,590 --> 00:17:59,970
!وصلتُ لوجهتي

254
00:17:59,970 --> 00:18:01,420
!هيّا بنا يا ناتاكو

255
00:18:24,160 --> 00:18:26,310
!لا تكن واثقًا من نفسك يا طيّار الغاندام

256
00:18:27,080 --> 00:18:29,580
!لن تقترب من تلك السّفينة أكثر من هذا

257
00:18:31,340 --> 00:18:34,000
!لا أحد بإمكانه إيقافي

258
00:18:51,610 --> 00:18:54,190
!لم أتوقّع هذه المقاومة

259
00:18:54,190 --> 00:18:55,730
!لكنّ الأمر انتهى الآن

260
00:18:55,730 --> 00:18:56,780
!مت

261
00:18:59,570 --> 00:19:01,730
.الاستسلام للمشاعر حركة غبيّة

262
00:19:10,040 --> 00:19:11,080
!ابتعدي

263
00:19:11,080 --> 00:19:14,670
.واضح تمامًا أمامك أنّك لن تهزميني أبدًا

264
00:19:14,920 --> 00:19:17,380
!لم أعلم أنّ بِدل الغاندام قويّة لهذا الحدّ

265
00:19:17,380 --> 00:19:18,740
!سُحقًا

266
00:19:22,850 --> 00:19:24,050
!سيّد تيريز

267
00:19:24,720 --> 00:19:27,140
!يبدو أنّ رئيسك يريد مقاتلتي

268
00:19:27,850 --> 00:19:29,020
!لا أمانع ذلك

269
00:19:29,020 --> 00:19:30,690
!سأوقفه عند حدّه

270
00:19:31,190 --> 00:19:32,900
!هذا خطير يا سيّد تيريز

271
00:19:32,900 --> 00:19:34,190
!ابتعد من هنا

272
00:19:34,190 --> 00:19:35,150
...ليدي أن

273
00:19:39,490 --> 00:19:41,110
.دعي أمره لي

274
00:19:41,610 --> 00:19:42,890
...سيّد تيريز

275
00:19:54,250 --> 00:19:56,590
.أنت هو تيريز الحقيقيّ إذًا

276
00:20:08,390 --> 00:20:10,140
.سأقبل بكلّ فرح

277
00:20:20,610 --> 00:20:21,820
.اسمي هو ووفي

278
00:20:22,110 --> 00:20:24,240
.أنا تيريز كوشرينادا

279
00:20:50,220 --> 00:20:51,430
.النّزال لي

280
00:20:53,090 --> 00:20:53,890
!اقتلني

281
00:20:58,270 --> 00:20:59,850
.كان قتالاً جيّدًا

282
00:21:00,320 --> 00:21:04,200
اقتلني الآن وإلاّ واصلت العودة
!حتّى أنال منك

283
00:21:04,950 --> 00:21:06,700
.يبدو هذا مثيرًا للإعجاب

284
00:21:06,700 --> 00:21:08,330
.آمُل أن نتقاتل ثانية

285
00:21:09,580 --> 00:21:10,730
!سُحقًا

286
00:21:23,170 --> 00:21:26,280
سيّدي تيريز، لماذا تركتَ
ذلك الطّيّار يهرب؟

287
00:21:27,300 --> 00:21:29,640
.إنّه طيّار بذلة متنقّلة

288
00:21:29,640 --> 00:21:32,640
.رأيتُ أنّه من العدل منحه فرصة أخرى

289
00:21:33,640 --> 00:21:36,910
مغادرته للبذلة المتنقّلة ونزاله
.لي كان تصرّفًا نبيلاً

290
00:21:37,350 --> 00:21:39,710
أمسى واضحًا لي لماذا
!هو طيّار جيّد لبذلة غاندام

291
00:21:40,480 --> 00:21:44,360
سأقاتله في المرّة القادمة في مجال
.اختصاصه، ببذلة متنقّلة

292
00:21:44,860 --> 00:21:45,860
...سيّد تيريز

293
00:21:57,750 --> 00:22:00,170
هل أنهى ذلك الفتى مهمّته بالفعل؟

294
00:22:00,170 --> 00:22:01,750
!أنت! هل تسمعني؟

295
00:22:06,630 --> 00:22:07,680
.فهمت

296
00:22:07,680 --> 00:22:08,390
.لننسَ الأمر

297
00:22:13,350 --> 00:22:16,940
يُـتـبـع

298
00:22:24,780 --> 00:22:30,950
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

299
00:22:32,410 --> 00:22:38,670
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

300
00:22:39,460 --> 00:22:43,340
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

301
00:22:43,590 --> 00:22:46,800
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

302
00:22:47,300 --> 00:22:53,350
حبّ فحسب! إنّه يثير أعصابي

303
00:22:55,140 --> 00:23:02,110
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

304
00:23:02,480 --> 00:23:09,610
حبّ فحسب! أنا دائمة التّفكير به

305
00:23:10,660 --> 00:23:17,040
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

306
00:23:17,950 --> 00:23:21,040
... حبّ فحسب ...

307
00:23:27,880 --> 00:23:29,880
في الحلقة القادمة

308
00:23:30,840 --> 00:23:33,180
انهار تحالف المجال الأرضيّ المتّحد

309
00:23:33,180 --> 00:23:35,310
.ويسلك العالم الآن طريقًا نحو الفوضى

310
00:23:35,890 --> 00:23:40,050
يواصل هيرو وديو قتال أوز
.الّتي كان سببًا وراء الفوضى

311
00:23:40,520 --> 00:23:43,560
يتّجه زيكس إلى مملكة سانك
ببذلة تالغيس خاصّته

312
00:23:43,560 --> 00:23:46,980
.لاستعادة مسقط رأس عائلة بيسكرافت

313
00:23:47,700 --> 00:23:51,240
.ولكنّ تالغيس بذلة متنقّلة خطيرة للغاية

314
00:23:51,990 --> 00:23:54,940
،في الحلقة التّاسعة من جناح الغاندام

315
00:23:54,940 --> 00:23:56,580
."لوحة لبلاد مدمَّرة"