1
00:01:24,600 --> 00:01:26,800
!هذا ليس الوقت المناسب للقتال

2
00:01:27,010 --> 00:01:29,560
!من الخطير جدًّا البقاء على هذه السّفينة

3
00:01:30,110 --> 00:01:31,960
.كاتر رابربا وينر

4
00:01:31,960 --> 00:01:33,600
.عرفتُ أنّه كان أنت

5
00:01:33,600 --> 00:01:38,030
!أنت أكثر طيّاري الغاندام ضلالاً حتّى الآن

6
00:02:02,710 --> 00:02:03,350
!ابتعد

7
00:02:22,820 --> 00:02:23,490
!هذا هو

8
00:02:30,340 --> 00:02:31,620
!تصويب سيّئ

9
00:02:31,620 --> 00:02:32,710
!أنا هنا

10
00:02:33,090 --> 00:02:34,130
!اخرس

11
00:02:39,950 --> 00:02:45,450
كان هناك وقت يمكن فيه خسارة
.المعارك وربحها بضغطة زرّ

12
00:02:46,020 --> 00:02:50,920
هذه الدّمى المتنقّلة هي أصل
.تلك الرّوح المكروهة

13
00:02:51,560 --> 00:02:55,320
.وسفينة الميزان امتداد لها

14
00:02:56,600 --> 00:02:59,420
،عندما تُجرّد الحروب من الإنسانيّة

15
00:02:59,420 --> 00:03:01,900
يصبح النّصر والهزيمة بائسين

16
00:03:02,520 --> 00:03:06,290
.ولا يعود الإله يمدّ يد العون

17
00:03:07,840 --> 00:03:09,770
!كفّ عن خطاباتك الفاخرة

18
00:03:10,240 --> 00:03:14,980
مات العديد من النّاس هباءً
!بسبب المعارك الّتي خضتها أنت

19
00:03:19,390 --> 00:03:22,840
،إن كنت ستقاتل أيّ أحد
!فقاتلني أنا وحدي إذًا

20
00:03:25,420 --> 00:03:26,880
.أنت محقّ تمامًا

21
00:03:33,670 --> 00:03:35,150
!هل أنت جاهز للأسوأ؟

22
00:03:35,550 --> 00:03:36,740
.بالطّبع

23
00:03:36,740 --> 00:03:39,000
.لن أتهاون معك هذه المرّة

24
00:03:39,000 --> 00:03:40,060
!كفاك كلامًا

25
00:03:51,150 --> 00:03:54,380
.لقد تحدّيت الموت عدّة مرّات حتّى الآن

26
00:03:55,050 --> 00:03:56,750
.لن تكون هذه المرّة مختلفة

27
00:04:08,530 --> 00:04:11,100
إذًا، ما الّذي لديكم في جعبتكم؟

28
00:04:12,000 --> 00:04:15,530
.أوّلاً، نريدك أن تأخذنا إلى بيسمليون

29
00:04:16,080 --> 00:04:17,310
!إلى بيسمليون؟

30
00:04:17,810 --> 00:04:21,660
سيحصل زيكس على مبتغاه
.ما لم نفعل شيئًا لإيقافه

31
00:04:21,660 --> 00:04:26,910
نريد تغيير مسار سفينة الميزان، لكن علينا
.أن نكون على متن بيسمليون للقيام بلك

32
00:04:28,050 --> 00:04:31,870
عندما قلت "سيحصل زيكس على
!مبتغاه"، فهل قصدت...؟

33
00:04:32,360 --> 00:04:36,230
!صحيح، إنّه يستهدف الأرض بكلّ ما لديه

34
00:04:36,760 --> 00:04:41,880
سنتمكّن من التّكفير عن خطايانا في اللّحظة
.الّتي سنستطيع فيها إيقاف خططه الشّرّيرة

35
00:04:42,840 --> 00:04:45,090
!حسنًا إذًا، اتبعوني

36
00:04:49,010 --> 00:04:51,600
هل حسبتم مسار الموجة بعد؟

37
00:04:51,600 --> 00:04:52,140
.نعم

38
00:04:52,770 --> 00:04:56,650
يمكننا دخول غلاف الأرض الجوّيّ
.إن واصلنا على مسارنا الحاليّ

39
00:04:57,750 --> 00:05:01,670
هنالك احتمال 69 بالمائة أنّنا سنقوم بهبوط
.اضطراريّ في نصف الكرة الأرضيّة الشّماليّ

40
00:05:02,860 --> 00:05:06,950
تُقدّر الطّاقة المحرَّرة بحوالي
.ستّة آلاف ميغا طنّ

41
00:05:09,630 --> 00:05:12,330
هل سمعت ذلك أيّها القائد ملياردو؟

42
00:05:12,800 --> 00:05:15,250
.سيكون ذلك كافيًا يا كانز

43
00:05:15,730 --> 00:05:20,920
إن هوت سفينتا بيسمليون والميزان
،وتحطّمتا على الكوكب الأخضر

44
00:05:20,920 --> 00:05:25,220
.فستختفي الفصول وسيُبتلون بشتاء أبديّ

45
00:05:26,810 --> 00:05:30,300
ولكنّ هذه الحسابات مبنيّة على افتراض

46
00:05:30,300 --> 00:05:33,180
.أنّ نظام قيادة بيسمليون سيظلّ منطفئًا

47
00:05:33,550 --> 00:05:36,180
.كانت بيسمليون سفينتي

48
00:05:36,820 --> 00:05:39,260
.سوف تفهم نواياي

49
00:05:39,260 --> 00:05:40,150
.حاضر

50
00:05:41,890 --> 00:05:44,610
هل يمكنك قول ذلك أيضًا
عن طيّاري الغاندام؟

51
00:05:45,060 --> 00:05:46,370
!بالطّبع

52
00:05:46,370 --> 00:05:50,570
.سيقومون بكلّ شيء ليحاولوا إيقافي

53
00:05:51,070 --> 00:05:52,770
.إذًا فأنت تنتظرهم

54
00:05:53,610 --> 00:05:58,500
لا يتصرّف أولئك الطّيّارون بطريقة
.يُنظر لها على أنّ لا مفرّ منها أو محتومة

55
00:05:58,500 --> 00:06:01,920
.وذلك هو ما يجعلهم محترفين في القتال

56
00:06:01,920 --> 00:06:05,810
!مثلي أنا زيكس ماركيز

57
00:06:06,190 --> 00:06:06,970
!أجل

58
00:06:12,190 --> 00:06:13,890
!مهلاً يا هيرو

59
00:06:15,260 --> 00:06:17,850
لماذا عليك الذّهاب؟

60
00:06:20,870 --> 00:06:22,650
!سفينة الميزان ستسقط

61
00:06:22,650 --> 00:06:25,900
!لا يوجد أيّ سبب لمواصلة القتال

62
00:06:26,270 --> 00:06:31,500
أخي ملياردو بيسكرافت
!والنّاب الأبيض قد هُزموا

63
00:06:32,610 --> 00:06:36,140
.أراهن أنّ زيكس لا يعتقد أنّه خسر

64
00:06:36,620 --> 00:06:42,780
وأيضًا، أشكّ أنّ زيكس أو تيريز
.سيتوقّفان عن القتال في هذه المعركة

65
00:06:43,160 --> 00:06:44,200
ماذا؟

66
00:06:44,200 --> 00:06:46,010
.لذلك السّبب عليّ الذّهاب وقتالهما

67
00:06:47,560 --> 00:06:51,760
!تعتقد أنّك إن ذهبت، فستنتهي الحرب؟

68
00:06:56,540 --> 00:06:59,770
.سأهزم زيكس، ثم سأسعى خلف تيريز

69
00:07:00,340 --> 00:07:02,030
.ثمّ ستنتهي الحرب

70
00:07:02,590 --> 00:07:07,150
.وبعد ذلك، سيحلّ السّلام أخيرًا إن نجوتِ

71
00:07:08,150 --> 00:07:12,020
هذا هو الشّيء الوحيد الّذي
.يمكنني فعله من أجلك

72
00:07:14,050 --> 00:07:15,120
...هيرو

73
00:07:15,820 --> 00:07:18,220
.وعدتُ أن أحميك

74
00:07:18,820 --> 00:07:24,210
،لكن بهدف حمايتك وحماية المجال الأرضيّ
.فلا خيار لديّ سوى القتال

75
00:07:25,130 --> 00:07:26,090
...مستحيل

76
00:07:27,030 --> 00:07:28,330
.دعيني أقاتل

77
00:07:28,330 --> 00:07:30,240
!كلاّ! أرفض

78
00:07:30,240 --> 00:07:33,430
هيرو، أنت تنوي أن تموت، صحيح؟

79
00:07:35,840 --> 00:07:37,060
.ثقي بي

80
00:07:48,850 --> 00:07:49,820
!هيرو

81
00:08:05,270 --> 00:08:08,640
.أنا أثق بك فعلاً يا هيرو

82
00:08:13,050 --> 00:08:15,380
.وداعًا يا ريلينا

83
00:08:23,090 --> 00:08:24,320
!هيرو

84
00:08:31,730 --> 00:08:32,920
!ما هذا المكان؟

85
00:08:32,920 --> 00:08:34,570
.غرفة التّحكّم بالدّمى المتنقّلة

86
00:08:35,430 --> 00:08:38,770
.كلاّ، أنا واثق أنّ هذا هو النّظام صفر

87
00:08:39,200 --> 00:08:40,540
.صحيح

88
00:08:40,540 --> 00:08:44,250
لقد وصلنا جهاز التّحكّم بالدّمى
.المتنقّلة مع النّظام صفر

89
00:08:45,140 --> 00:08:46,830
.بتّ تعرف الآن

90
00:08:46,830 --> 00:08:50,800
!تفعّل رغبتي للقتال كلّ الدّمى المتنقّلة

91
00:08:55,250 --> 00:08:56,260
ما الغاية؟

92
00:08:56,730 --> 00:08:59,990
.كاتر وينر، أنا أتحدّاك لنزال

93
00:09:00,430 --> 00:09:03,770
لقد خسرت المعركة عندما استعمل
.كلانا النّظام صفر

94
00:09:03,770 --> 00:09:06,270
.لكنّني أتساءل ماذا سيحدث هذه المرّة

95
00:09:07,470 --> 00:09:10,730
.لقد قرّرتَ أنّ بإمكانك القتال دون النّظام صفر

96
00:09:11,270 --> 00:09:13,660
.ما كنت لأقاتل إن كان الأمر بيدي

97
00:09:13,660 --> 00:09:18,560
لكن ما لم أواصل القتال، فلن تستسلمون
.ولن تنتهي هذه الحرب أبدًا

98
00:09:18,560 --> 00:09:20,100
!هذا صحيح تمامًا

99
00:09:20,100 --> 00:09:22,890
،والآن، لنحدّد ما الأكثر تقدّمًا

100
00:09:23,530 --> 00:09:26,460
!النّظام صفر أم الوعي البشريّ

101
00:09:27,120 --> 00:09:28,550
وإن رفضت؟

102
00:09:37,930 --> 00:09:40,230
!لماذا تحبّين الحرب لهذا الحدّ؟

103
00:09:40,700 --> 00:09:42,180
!لماذا علينا فعل هذا؟

104
00:09:42,630 --> 00:09:44,630
.أنت لطيف يا كاتر

105
00:09:44,940 --> 00:09:47,390
ما الأسباب الّتي تدفعك للقتال؟

106
00:09:47,970 --> 00:09:49,520
!أقاتل من أجل عائلتي

107
00:09:49,520 --> 00:09:53,440
!عليّ القتال لمنع أحزان عائلتي

108
00:09:54,050 --> 00:09:55,930
.قام أبي بذلك

109
00:09:55,930 --> 00:09:59,370
!قاتل لكي لا أشعر بالحزن، ومات

110
00:10:00,350 --> 00:10:03,580
لهذا السّبب سأموت مقاتلة
!في معركة جميلة

111
00:10:04,790 --> 00:10:07,290
!إذًا فأنت تكرهين الحرب أيضًا

112
00:10:11,960 --> 00:10:12,960
!على العكس

113
00:10:12,960 --> 00:10:16,220
!الحرب ليست المُلامة على الدّمار والمجازر

114
00:10:16,220 --> 00:10:20,470
!يوجد الأعداء الّذين علينا هزيمتهم في قلوبنا

115
00:10:20,550 --> 00:10:23,940
.أنا أؤمن بالسّلام لأنّه يتجاوز الحرب

116
00:10:24,340 --> 00:10:26,760
!أنا أؤمن بالقلب الّذي يأمل في السّلام

117
00:10:26,760 --> 00:10:28,230
!دعني أطرح عليك سؤالاً إذًا

118
00:10:28,230 --> 00:10:31,270
.تقول أنّك تقاتل من أجل الجميع

119
00:10:31,980 --> 00:10:34,610
لكن ما الّذي فعله الجميع
من أجلك في المقابل؟

120
00:10:34,610 --> 00:10:38,180
لا أقاتل من أجل الحصول
.على مقابل من أيّ نوع

121
00:10:39,220 --> 00:10:42,030
!لذلك السّبب ستظلّ هاويًا دائمًا

122
00:10:48,800 --> 00:10:50,670
.توقّفي رجاءً يا دوروثي

123
00:10:52,870 --> 00:10:55,310
.خانت المستعمرات الغاندام

124
00:10:55,310 --> 00:10:58,750
.قتل سكّان المستعمرات والدك

125
00:10:58,750 --> 00:11:03,100
كما أنّ المستعمرات المسلّحة
قد أعلنت استقلالها عن الأرض

126
00:11:03,100 --> 00:11:05,450
.قبل أن تدرك بالفعل ما الّذي يحدث

127
00:11:06,330 --> 00:11:10,190
إنّ معاركك حتّى الآن كانت
!جميعها مجرّد مضيعة للوقت

128
00:11:10,990 --> 00:11:16,310
إنّ تعاطفك نحو الآخرين، تعاطفك المفرط
!تُجاههم، قد أدّى لولادة هذه النّتيجة السّيّئة

129
00:11:26,540 --> 00:11:28,280
هل صعد الجميع؟

130
00:11:28,280 --> 00:11:29,470
.كلّ شيء على ما يرام

131
00:11:29,470 --> 00:11:30,560
.جيّد

132
00:11:30,560 --> 00:11:32,460
.لنتّجه مباشرة إلى إم أو-2

133
00:11:33,010 --> 00:11:35,130
.أجب يا هيرو

134
00:11:35,130 --> 00:11:36,120
!هيرو

135
00:11:36,120 --> 00:11:39,500
.سنزعجهم فقط إن اتّصلنا بهم الآن

136
00:11:39,500 --> 00:11:41,930
.لكنّ هيرو قد انطلق في مهمّة انتحاريّة

137
00:11:46,800 --> 00:11:48,650
!هيرو! أجب رجاءً

138
00:11:48,650 --> 00:11:50,010
!أتوسّل إليك

139
00:11:50,600 --> 00:11:52,330
.انسي أمري يا ريلينا

140
00:11:52,770 --> 00:11:54,580
.الحياة بخسة

141
00:11:54,580 --> 00:11:55,810
!وخاصّة حياتي

142
00:12:10,890 --> 00:12:12,680
.أنا قادم يا كاتر

143
00:12:26,930 --> 00:12:29,080
.وصلتَ يا تروا

144
00:12:29,080 --> 00:12:31,270
.آسف، لكن عليّ الذّهاب

145
00:12:31,840 --> 00:12:34,580
.أخشى أنّك ستكمل وحد هنا

146
00:12:34,580 --> 00:12:36,830
.لا بأس، يمكنني تولّي الأمر

147
00:12:36,830 --> 00:12:37,900
.مفهوم

148
00:12:40,180 --> 00:12:42,340
.لكن لا تتسبّب في قتل نفسك

149
00:12:42,950 --> 00:12:44,750
.وأنت أيضًا يا ديو

150
00:13:12,980 --> 00:13:14,770
.لا مجال للتّراجع

151
00:13:15,720 --> 00:13:20,730
،ما دام سيصل أحدنا إلى بيسمليون
.فبإمكاننا إذًا متابعة مهمّتنا

152
00:13:21,460 --> 00:13:23,900
.لذلك لا تهتمّوا لنا إن رُمي بأحد ما

153
00:13:25,030 --> 00:13:26,980
.لا داعي للقلق

154
00:13:26,980 --> 00:13:29,120
.لديّ ما يكفي يشغل بالي

155
00:13:35,000 --> 00:13:36,420
!هيّا بنا

156
00:13:46,680 --> 00:13:49,350
!لا أحد عاقلاً قد يحلّق عبر هذا

157
00:13:55,190 --> 00:13:57,350
.أنا نادم الآن لأنّني وجدتهم

158
00:13:57,880 --> 00:13:59,080
!انتبهوا

159
00:13:59,080 --> 00:14:01,320
!إله الموت والكوارث قادم

160
00:14:05,530 --> 00:14:07,030
!ما هذا؟

161
00:14:12,310 --> 00:14:13,950
!دع هؤلاء لنا

162
00:14:13,950 --> 00:14:16,400
!شكرًا، ذلك ما سأفعله

163
00:14:17,750 --> 00:14:21,770
لم نكن أقوياء بما يكفي ليحالفنا
،أيّ حظّ في توحيه الفضاء الخارجيّ

164
00:14:21,770 --> 00:14:24,040
.لكنّ الأرض قد توحّدت

165
00:14:24,040 --> 00:14:26,170
هل تلك الفتاة وراء هذا؟

166
00:14:26,170 --> 00:14:27,090
...أم

167
00:14:27,660 --> 00:14:28,770
!يا رفاق

168
00:14:28,770 --> 00:14:31,980
!لا تموتوا حتّى نرى السّيّد كاتر

169
00:14:31,980 --> 00:14:32,990
!عُلم

170
00:14:35,700 --> 00:14:37,420
لماذا تتهاون؟

171
00:14:37,420 --> 00:14:39,720
أم أنّك لا تقوى على فعلها؟

172
00:14:39,720 --> 00:14:41,980
!لكنّني على كعسك تمامًا

173
00:14:43,690 --> 00:14:45,440
!ذلك النّقاء

174
00:14:45,440 --> 00:14:46,440
!ذلك القلب الضّعيف

175
00:14:46,440 --> 00:14:47,900
!تلك الطّبية

176
00:14:48,220 --> 00:14:50,990
!لا عجب أنّكم هُزمتم يا طيّاري الغاندام

177
00:14:54,050 --> 00:14:55,760
.ربّما تكونين محقّة

178
00:14:55,760 --> 00:14:59,070
لكن هذه هي طريقة القتال
!الوحيدة الّتي أعرفها

179
00:14:59,070 --> 00:15:02,240
،ولكن بسبب خوضنا لمعارك خاسرة

180
00:15:02,240 --> 00:15:05,340
كنّا قادرين على إبعاد أهوال
!الحرب عن المستعمرات

181
00:15:05,760 --> 00:15:08,250
!لن تغيّر أيّ شيء هكذا

182
00:15:08,250 --> 00:15:10,050
!ماذا كان عليّ فعله إذًا؟

183
00:15:10,400 --> 00:15:15,220
كان عليك أن تصبح قائد المستعمرات
!وتشعل حربًا خلاّبة بنفسك

184
00:15:15,220 --> 00:15:16,770
!مثل السّيّد ملياردو

185
00:15:17,240 --> 00:15:19,210
...دوروثي، أنت مخطئة

186
00:15:20,070 --> 00:15:23,800
وكان عليك إشعال فتيل هذه
.الحرب أمام كلّ البشريّة

187
00:15:23,800 --> 00:15:27,940
حرب بائسة لن يرغبوا أبدًا
!في رؤيتها ثانية

188
00:15:29,380 --> 00:15:32,910
هل تقولين أنّ هذه هي الغاية
من هذه الحرب؟

189
00:15:33,220 --> 00:15:34,510
.هذا صحيح

190
00:15:34,510 --> 00:15:39,550
لا يمكن وضع حدّ للحروب بتجريد
!النّاس من الأسلحة ببساطة

191
00:15:39,550 --> 00:15:42,920
.عليك أوّلاً تغيير قلوب البشريّة

192
00:15:42,920 --> 00:15:49,380
إن لم تفعل ذلك، فسيُقضى
!على البشريّة تمامًا كما حدث مع أبي

193
00:15:50,940 --> 00:15:52,840
.أنت شخص طيّب

194
00:15:53,170 --> 00:15:54,350
.أكثر طبية منّي

195
00:15:54,730 --> 00:15:57,440
!وهل يفترض بذلك أن يُسعدني؟

196
00:15:57,810 --> 00:16:01,310
ما الطّيبة إلاّ عائق عندما تكون
!الغاية هي النّجاة

197
00:16:01,850 --> 00:16:05,910
.من الملائم أكثر للنّاس أن يركّزوا على النّجاة

198
00:16:06,350 --> 00:16:08,390
...د-دوروثي

199
00:16:08,890 --> 00:16:12,020
.أنت تمامًا كما كنتُ في السّابق

200
00:16:12,360 --> 00:16:16,780
.تكرهين طيبتك، وكراهيتك الخاصّة للحرب

201
00:16:17,270 --> 00:16:21,170
.لا يجب عليك مقاتلة طيبتك على الإطلاق

202
00:16:21,700 --> 00:16:23,560
.ذلك ما علّمنيه تروا

203
00:16:24,640 --> 00:16:28,130
.عليك أن تحاولي تقبّل كلّ شيء حولك

204
00:16:28,130 --> 00:16:31,240
.لأنّ البشريّة تحتاج للطّيبة

205
00:16:31,680 --> 00:16:35,970
.فبدونها، لا سبب للبشريّة لتستمرّ

206
00:16:37,680 --> 00:16:39,150
توافقينني الرّأي، صحيح؟

207
00:16:40,120 --> 00:16:45,980
إنّ البشر الّذين لا يفكّرون إلى بنجاتهم
.هم أشكالُ حياة أدنى من الحيوانات

208
00:16:46,610 --> 00:16:50,160
.لا يمكنهم حتّى الإحساس بالآخرين

209
00:16:57,970 --> 00:16:59,190
ما الخطب؟

210
00:16:59,190 --> 00:17:00,910
لماذا لا تستعمل تنّينك؟

211
00:17:03,440 --> 00:17:06,260
!لأنّني أريد قتالك بعدل وإنصاف

212
00:17:06,260 --> 00:17:06,880
!هذا هو السّبب

213
00:17:07,470 --> 00:17:09,290
.هذا ليس من عادتك

214
00:17:09,290 --> 00:17:10,370
لماذا التّردّد؟

215
00:17:11,070 --> 00:17:13,840
أنت من تقول هذا؟
لماذا لم تقتلني باكرًا إذًا؟

216
00:17:14,660 --> 00:17:19,680
لم أستطع قتل واحد
.من القلائل الّذين يفهمونني

217
00:17:19,670 --> 00:17:21,290
!كفاك هراءً

218
00:17:24,040 --> 00:17:25,940
!أنا أمقتك

219
00:17:26,500 --> 00:17:28,150
!تعال ونل منّي إذًا

220
00:17:35,480 --> 00:17:39,710
لا تقدر سوى على النّظر
!بتعالٍ للآخرين هكذا

221
00:17:40,210 --> 00:17:42,730
!لا تقاتل إلاّ لإرضاء غرورك

222
00:17:42,730 --> 00:17:46,650
!كم شخصًا قد مات من أجلك في رأيك؟

223
00:17:47,160 --> 00:17:48,210
هل أخبرك؟

224
00:17:49,060 --> 00:17:53,880
.إنّهم 99,822 شخصًا حتّى البارحة

225
00:17:53,880 --> 00:17:54,640
!ماذا؟

226
00:17:55,330 --> 00:17:57,680
ليدي، كم عدد الأموات اليوم؟

227
00:17:58,770 --> 00:18:02,700
تأكّدنا أنّ العدد هو 82
من جنود النّاب الأبيض

228
00:18:03,240 --> 00:18:04,640
.و105 من جنودنا

229
00:18:05,570 --> 00:18:06,700
.هكذا إذًا

230
00:18:07,110 --> 00:18:09,190
أطلعيني على أسمائهم
.في وقت لاحق من اليوم

231
00:18:09,190 --> 00:18:10,980
.حاضرة. سأفعل

232
00:18:12,510 --> 00:18:13,360
!أيّها الوغد

233
00:18:13,920 --> 00:18:18,920
.أنا أذكر كلّ من ضحّى بحياته في المعارك

234
00:18:18,920 --> 00:18:24,930
نوفينتا وسيبتم وغينتي ودارليان
.ووالكر وأوتّو وبونت

235
00:18:25,490 --> 00:18:27,830
كيف لي أن أنساهم؟

236
00:18:28,230 --> 00:18:30,040
...كيف لك أن تكون

237
00:18:30,470 --> 00:18:34,880
لا يسعني إلاّ أن أحزن
.على أرواح من قاتلوا

238
00:18:35,170 --> 00:18:38,900
.لكن حاول على الأقلّ أن تفهم ذلك

239
00:18:39,770 --> 00:18:42,590
.لم يمت أيّ واحد منهم هباءً

240
00:18:42,590 --> 00:18:43,100
!...وأيضًا

241
00:18:51,650 --> 00:18:53,730
!كان ذلك جميلاً يا ووفي

242
00:18:54,420 --> 00:18:56,190
!...تيريز! يا لك من

243
00:19:01,620 --> 00:19:04,450
.ووفي، صديقي الأبديّ

244
00:19:04,490 --> 00:19:07,450
.شرّفني القتال معكم أيّها الطيّارون

245
00:19:08,240 --> 00:19:11,160
.كلاّ، لا يمكن أن يكون هذا صحيحًا

246
00:19:11,160 --> 00:19:13,170
!لن أسمح بحدوث هذا

247
00:19:14,610 --> 00:19:18,190
.ملياردو، سأكون بانتظارك في الجانب الآخر

248
00:19:24,850 --> 00:19:26,610
!سُحقًا

249
00:19:28,260 --> 00:19:29,950
...لم أتوقّع الفوز

250
00:19:39,170 --> 00:19:40,080
.أيّتها العقيد

251
00:19:40,080 --> 00:19:41,020
.أعطنا أوامرك

252
00:19:43,700 --> 00:19:45,920
!اتّصلوا بالنّاب الأبيض

253
00:19:46,410 --> 00:19:50,910
!تعلن الأمّة العالميّة استسلامها في الحال

254
00:19:51,180 --> 00:19:52,620
أ-أيّتها العقيد؟

255
00:19:52,620 --> 00:19:55,320
!هذا مهين! لا تجعلوني أكرّر كلامي

256
00:19:55,870 --> 00:19:57,200
!أرسلوا لهم الرّسالة

257
00:19:57,200 --> 00:19:58,090
!حاضر

258
00:19:59,150 --> 00:20:02,020
.كنت رائعًا يا سيّد تيريز

259
00:20:05,860 --> 00:20:08,890
.هذه هي الطّريقة الصّحيحة، هذا جيّد

260
00:20:08,890 --> 00:20:10,810
.ها أنت ذي يا دوروثي

261
00:20:11,870 --> 00:20:15,800
.اتّصلت بنا الأرض للتّوّ وأعلنت استسلامها

262
00:20:17,140 --> 00:20:18,960
أعلنت الأرض استسلامها؟

263
00:20:18,960 --> 00:20:24,830
كما أبلغتنا وحدة مراقبة المعركة
.أنّ تيريز كوشرينادا قد مات في المعركة

264
00:20:24,830 --> 00:20:26,660
!مـ-مستحيل! هذا غير ممكن

265
00:20:27,050 --> 00:20:28,810
.النّصر لنا

266
00:20:29,180 --> 00:20:32,510
لكنّ خططنا بدفع هذه السّفينة
.نحو الأرض لم تتغيّر

267
00:20:33,110 --> 00:20:34,990
.تلك هي أوامر القائد ملياردو

268
00:20:35,960 --> 00:20:38,080
!سنبدأ الاندفاع الأخير

269
00:20:38,080 --> 00:20:39,960
.أخلوا المكان حسب تقديركم

270
00:20:40,490 --> 00:20:41,670
.أدعو لكم بالسّلامة

271
00:20:43,330 --> 00:20:45,140
.لم تسر الأمور كما يجب

272
00:20:45,700 --> 00:20:50,100
بطريقة ما، على الأرجح أنّ ما كنتم
.تسعون إليه كان صحيحًا

273
00:20:50,470 --> 00:20:53,530
.لكنّه ما زال لن يجلب السّلام الحقيقيّ

274
00:20:54,440 --> 00:20:55,730
...كنتُ فقط

275
00:20:55,730 --> 00:20:56,750
.ذلك محزن

276
00:20:57,220 --> 00:20:58,820
.امرأة تعجز عن البكاء

277
00:21:00,750 --> 00:21:02,810
استسلمت الأرض؟

278
00:21:03,380 --> 00:21:04,150
!مستحيل

279
00:21:04,920 --> 00:21:07,200
.لم ينتهِ الأمر بك يا جماعة

280
00:21:07,200 --> 00:21:12,120
تخطّط النّاب الأبيض إلى توجيه سفينتا
.الميزان وبيسمليون للتّصادم بالأرض

281
00:21:12,860 --> 00:21:14,180
!فلنعد

282
00:21:14,180 --> 00:21:16,850
!إن ذهبنا الآن، فسنكون قادرين على إيقافهم

283
00:21:16,850 --> 00:21:18,830
.ذلك مستحيل

284
00:21:19,300 --> 00:21:21,450
!لا يمكننا الجزم ما لم نجرّب

285
00:21:21,450 --> 00:21:24,660
هنالك شخص واحد يمكنه
!جعل المستحيل ممكنًا

286
00:21:24,660 --> 00:21:25,380
!هيرو؟

287
00:21:25,770 --> 00:21:26,700
.نعم

288
00:21:26,700 --> 00:21:29,890
.لكن من المستحيل إخباره بذلك الآن

289
00:21:29,890 --> 00:21:31,890
!لنسرع بالذّهاب إلى هيرو

290
00:21:32,450 --> 00:21:33,660
.لا يمكننا

291
00:21:33,660 --> 00:21:36,930
استعملنا طاقة الدّفع
.من أجل الانطلاقة المبدئيّة

292
00:21:36,930 --> 00:21:37,600
!ريلينا

293
00:21:38,120 --> 00:21:40,070
!سأذهب وحدي في تلك الحالة

294
00:21:42,290 --> 00:21:43,030
!توقّفي رجاءً

295
00:21:43,290 --> 00:21:44,780
!دعاني

296
00:21:44,780 --> 00:21:47,740
!هيرو! هيرو

297
00:21:53,930 --> 00:21:55,160
.وصل أخيرًا

298
00:23:33,280 --> 00:23:37,640
بدأت المعارك على يد النّاس
.ويحقّق النّاس السّلام عبر القتال

299
00:23:38,100 --> 00:23:41,190
لكن كم من الأرواح ستُزهق نتيجة لذلك؟

300
00:23:42,020 --> 00:23:45,220
وما الغاية من دفع سفينتَيْ الميزان
وبيسمليون لتصطدما بالأرض؟

301
00:23:45,760 --> 00:23:51,760
في المراحل الأخيرة من المعركة، تترقّب
.بذلتا الغاندام فجر عصر جديد

302
00:23:52,580 --> 00:23:55,160
،"في الحلقة الأخيرة من "جناح الغاندام

303
00:23:55,430 --> 00:23:56,790
."المنتصر الأخير"