1
00:00:12,030 --> 00:00:15,320
مجرّد نبض تواصل جامح

2
00:00:15,530 --> 00:00:18,990
أقف في المطر الجارح

3
00:00:19,160 --> 00:00:22,620
أريد إظهار مشاعري المتّقدة الخالدة

4
00:00:22,750 --> 00:00:27,790
!عن طريق جسدي بالكامل اللّيلة

5
00:00:33,840 --> 00:00:40,680
أتشبّث بكتفيك المبلّلين لمنحك الدّفء والرّاحة

6
00:00:40,850 --> 00:00:48,020
ما الّذي تسعى إليه هذه الأصابع المرتعشة؟

7
00:00:48,650 --> 00:00:55,200
أريد حماية النّظرة الصّادقة في عينك

8
00:00:55,950 --> 00:01:02,750
مؤمنة بالحبّ الّذي سيُحيلُ الحزنَ قوّة

9
00:01:02,830 --> 00:01:06,370
مجرّد نبض تواصل جامح

10
00:01:06,500 --> 00:01:10,090
أقف في المطر الجارح

11
00:01:10,250 --> 00:01:13,670
أريد إظهار مشاعري المتّقدة الخالدة

12
00:01:13,800 --> 00:01:18,510
!عن طريق جسدي بالكامل اللّيلة

13
00:01:30,360 --> 00:01:34,280
نحن جاهزون لإطلاق هجوم شامل
!من الصّواريخ على المستعمرات

14
00:01:34,280 --> 00:01:36,740
!لا يمكنكم القتال، صحيح؟

15
00:01:37,070 --> 00:01:39,200
.قُبلت المهمّة

16
00:02:21,470 --> 00:02:24,330
.لا مخرج من هنا بالفعل بسبب كلّ هذا الأمن

17
00:02:24,870 --> 00:02:27,230
،كما أنّه بهدف سرقة ناقلة

18
00:02:27,230 --> 00:02:29,740
.عليّ عبور الصّحراء للوصول إلى المطار

19
00:02:32,440 --> 00:02:33,250
...إنّه

20
00:02:46,060 --> 00:02:47,660
.نحن في نفس الوضع

21
00:02:47,660 --> 00:02:51,270
.أنت عالق أيضًا وكلّ هذه الطّائرات تبحث عنّا

22
00:02:51,870 --> 00:02:54,230
.هنالك عاصفة رمليّة ضخمة قادمة

23
00:02:54,230 --> 00:02:56,230
.سنعبر الصّحراء حينها

24
00:02:58,040 --> 00:02:59,830
أتريد الانضمام لنا؟

25
00:02:59,830 --> 00:03:01,100
.نعم

26
00:03:01,100 --> 00:03:03,070
.لن أرفض بعض العطف

27
00:03:03,490 --> 00:03:05,240
.وأحتاج لوقت للتّفكير

28
00:03:16,390 --> 00:03:18,750
.جمعنا ما يمكننا جمعه

29
00:03:18,750 --> 00:03:21,550
.لكنّ الأجزاء المهمّة قد دُمّرت بالكامل

30
00:03:21,550 --> 00:03:22,750
.ظننتُ ذلك

31
00:03:22,750 --> 00:03:23,930
.لذلك السّبب دمّرها ذاتيًّا

32
00:03:24,420 --> 00:03:28,160
حتّى الغاندام انتهى بها المطاف
.كمجرّد كتلة من الخردة المعدنيّة

33
00:03:28,160 --> 00:03:30,140
.أو بالأحرى، خردة من الغاندانيوم

34
00:03:30,400 --> 00:03:32,670
.تصميم هذه الغاندام مستوحى من تالغيس

35
00:03:33,260 --> 00:03:36,570
لذلك فالتّكنولوجيا الأساسيّة المستعملة
.في بذلة تالغيس ستنطبق عليها

36
00:03:36,570 --> 00:03:37,570
زيكس؟

37
00:03:37,980 --> 00:03:39,270
.نوين

38
00:03:39,270 --> 00:03:43,020
هل ستمانعين إن أخذتُ هذه الغاندام
معي إلى قاعدة بحيرة فيكتوريا؟

39
00:03:44,660 --> 00:03:46,580
هل تنوي إصلاحها؟

40
00:03:46,580 --> 00:03:47,620
...نعم

41
00:03:48,650 --> 00:03:50,320
لماذا؟

42
00:03:50,320 --> 00:03:52,820
.ربّما ما زال ذلك الطّيّار يشغل بالي

43
00:03:53,630 --> 00:03:55,840
.لكنّ طيّار الغاندام قد مات

44
00:03:56,300 --> 00:03:58,690
.يساورني شعور أنّه قيد الحياة

45
00:03:58,690 --> 00:04:01,180
.هذا مستحيل تمامًا بعد ذلك الانفجار

46
00:04:01,670 --> 00:04:03,300
.لكن آمل أن يكون قيد الحياة

47
00:04:03,300 --> 00:04:08,260
،بما أنّ طيّار بذلة متنقّل مثله
.قُدّر لي أن أقاتله

48
00:04:09,010 --> 00:04:10,730
!أنا في غاية الأسف

49
00:04:11,180 --> 00:04:12,310
...صاحب السّعادة تيريز

50
00:04:12,970 --> 00:04:16,150
ما كان عليّ التّصرّف من تلقاء نفسي
.لأخطّك لهجوم مباشر على المستعمرات

51
00:04:16,810 --> 00:04:18,700
.أمسى ذلك من الماضي

52
00:04:19,180 --> 00:04:24,280
نعرف الآن أنّ هجمات الغاندام مُخطَّط لها
.من طرف أشخاص معيّنين، للانتقام منّا

53
00:04:25,180 --> 00:04:27,750
.ما زال هدفنا هو تدمير كلّ الغاندام

54
00:04:28,190 --> 00:04:30,240
.لكنّ داعميهم يقلقونني

55
00:04:30,530 --> 00:04:31,750
في الفضاء الخارجيّ، صحيح؟

56
00:04:32,030 --> 00:04:35,300
أفضّل أن أمنع العدوّ من امتلاك
.المزيد من القوّة

57
00:04:35,300 --> 00:04:37,260
هل يمكنني الاعتماد عليك يا ليدي أن؟

58
00:04:37,260 --> 00:04:38,170
.أجل

59
00:04:38,170 --> 00:04:39,870
.سأبيدهم دفعة واحدة

60
00:04:41,520 --> 00:04:43,260
سيّد تيريز؟

61
00:04:43,920 --> 00:04:47,470
لن يتحمّل سكّان المستعمرات
.المسالمون أيّ سياسة عسكريّة

62
00:04:48,120 --> 00:04:50,720
.يمكنك التّخلّص من بعض شكليّاتك

63
00:04:51,650 --> 00:04:54,710
أعلني عن رحلتك للفضاء الخارجيّ
.في طريقك إلى موسكو

64
00:04:54,710 --> 00:04:58,690
يعيش الكثير من النّبلاء الّذين
.يفهمون أوز في موسكو

65
00:04:59,730 --> 00:05:01,690
.سيكونون قادرين على مساعدتك

66
00:05:03,530 --> 00:05:04,610
!حاضرة

67
00:05:09,870 --> 00:05:11,770
.لا شيء على الرّادار

68
00:05:12,290 --> 00:05:14,560
.لا يعني ذلك أيّ شيء

69
00:05:14,560 --> 00:05:16,000
.انتشروا وانتبهوا من العدوّ

70
00:05:19,540 --> 00:05:22,540
!سُحقًا، لا يمكنني رؤية شيء في هذه العاصفة

71
00:05:22,540 --> 00:05:24,680
ما الّذي قد يكون هناك؟

72
00:05:24,680 --> 00:05:27,620
هنالك قاعدة عسكريّة تابعة
لبلدان الشّرق الأوسط

73
00:05:27,620 --> 00:05:29,510
غير منتسبة لتحالف المجال الأرضيّ
.المتّحد أو أوز

74
00:05:30,090 --> 00:05:31,700
.لنلتجئ هناك

75
00:05:31,700 --> 00:05:32,520
قاعدة؟

76
00:05:33,080 --> 00:05:34,280
.لا مشاكل هنا

77
00:05:34,280 --> 00:05:35,260
.ولا هنا أيضًا

78
00:05:35,260 --> 00:05:36,550
.ولا هنا

79
00:05:37,060 --> 00:05:38,190
.عُلم

80
00:05:41,570 --> 00:05:42,880
!قاعدة عسكريّة؟

81
00:05:48,640 --> 00:05:49,720
.لننطلق

82
00:05:51,640 --> 00:05:52,710
!مـ-مهلاً

83
00:05:54,580 --> 00:05:57,210
تنتمي هذه القاعدة لقوّات
.ماغاناك التّابعة لموطننا

84
00:05:57,210 --> 00:05:58,910
إنّها قاعدتكم؟

85
00:06:08,190 --> 00:06:10,590
.من الجيّد عودتك يا كاتر

86
00:06:11,300 --> 00:06:14,060
.لم أرك منذ مدّة يا سادا أول

87
00:06:14,060 --> 00:06:17,300
كانت المهمّات صعبة عليك
.منذ مجيئك للأرض

88
00:06:17,300 --> 00:06:21,000
أنا مدين لقوّات ماغاناك على
.المساعدة الّتي قدّموها

89
00:06:21,000 --> 00:06:22,930
كيف لي أن أشكرك؟

90
00:06:22,930 --> 00:06:26,110
،كان ذلك قرارًا خاصًّا بهم
.أرادوا مساعدتك

91
00:06:26,580 --> 00:06:31,070
،إن كانت لدينا قوّة أكبر
.لتسبّبنا بضرر أكثر لأوز

92
00:06:31,070 --> 00:06:32,940
!مشاكل أوز لا تنتهي

93
00:06:32,940 --> 00:06:36,270
ما كان أيّ شخص عاقل ليستعمل
!المستعمرات كدرع

94
00:06:36,270 --> 00:06:38,790
.نحن الملامون لأنّنا لم نوقفهم

95
00:06:39,060 --> 00:06:41,250
.نعم، نحن الملامون تمامًا

96
00:06:42,000 --> 00:06:43,920
.كلاّ يا كاتر

97
00:06:43,920 --> 00:06:46,060
.لن يلومكم أيّ أحد

98
00:06:46,060 --> 00:06:47,850
.تعال، من هنا

99
00:06:47,850 --> 00:06:51,530
سيّد كاتر، سوف نبدأ بإصلاحات
.البذل المتنقّلة

100
00:06:51,530 --> 00:06:52,930
.حسنًا، شكرًا لكم

101
00:06:52,930 --> 00:06:54,370
...لحظة يا رشيد

102
00:06:54,370 --> 00:06:55,460
.أعرف ما ستقوله

103
00:06:55,460 --> 00:06:57,600
.سنصلح بذلتا الغاندام أيضًا

104
00:06:58,480 --> 00:06:59,560
لا تمانع، صحيح؟

105
00:06:59,940 --> 00:07:01,810
.هذا يناسبني تمامًا

106
00:07:01,810 --> 00:07:03,270
.أقدّر لكم هذا

107
00:07:03,950 --> 00:07:05,980
.لم أقدّم نفسي بعد

108
00:07:06,390 --> 00:07:08,950
.أنا كاتر رابربا وينر

109
00:07:08,950 --> 00:07:10,150
وينر؟

110
00:07:10,150 --> 00:07:13,700
أنت وريث عائلة وينر؟

111
00:07:13,700 --> 00:07:16,730
القوّة المؤثّر والماليّة للبلدان العربيّة؟

112
00:07:16,730 --> 00:07:19,500
لا عجب أنّ الجميع هنا يتطلّع
.إليك في هذا المكان

113
00:07:19,930 --> 00:07:22,030
.عائلتنا مناشدة للسّلام

114
00:07:22,030 --> 00:07:24,710
.حرمتُ نفسي من إرثها وأتيتُ إلى هنا

115
00:07:24,710 --> 00:07:26,170
فعلاً؟

116
00:07:26,170 --> 00:07:27,720
.يتطلّب الأمر أشخاص من كلّ الأصناف

117
00:07:28,330 --> 00:07:30,670
.أنا ديو. ديو ماكسويل

118
00:07:31,020 --> 00:07:35,140
.قد أهرب أو أختبئ، لكنّي لا أكذب أبدًا

119
00:07:45,010 --> 00:07:48,390
أُبلغنا أنّ المستعمرات قد أرسلت
.بذلاً متنقّلة للأرض

120
00:07:48,390 --> 00:07:48,980
!هذه هي

121
00:07:49,360 --> 00:07:52,700
صحيح أنّ عددًا من البذل المتنقّلة

122
00:07:52,700 --> 00:07:55,240
أُرسلت إلى الأرض وحاولت
.تدمير أهداف معيّنة

123
00:07:55,590 --> 00:08:00,800
لكنّ أوز تأخذ حاليًّا إجراءات لكشف
.المتمرّدين للحفاظ على سلام العالم

124
00:08:00,800 --> 00:08:03,830
إنّها مسألة وقت فحسب قبل
.أن نحلّ هذه المشكلة

125
00:08:04,250 --> 00:08:06,550
!لا تناسبها تلك الوردة على الإطلاق

126
00:08:20,960 --> 00:08:22,160
.شكرًا لك

127
00:08:22,160 --> 00:08:23,230
.العفو

128
00:08:25,730 --> 00:08:27,570
!كم هي ظريفة

129
00:08:32,540 --> 00:08:33,740
.المعذرة

130
00:08:33,740 --> 00:08:35,030
هل لديك دعوة؟

131
00:08:35,430 --> 00:08:36,410
.كلاّ

132
00:08:36,410 --> 00:08:40,490
سامحيني، لكنّ هذه الحفلة مفتوحة
.للضّيوف المدعوّين فحسب

133
00:08:42,200 --> 00:08:43,740
...سيّدة كاترينا

134
00:08:44,670 --> 00:08:46,970
هل تعرفين أيًّا من الضّيوف الآخرين؟

135
00:08:46,970 --> 00:08:49,170
.ريلينا، أتيتِ باكرًا

136
00:08:49,520 --> 00:08:51,310
!مركيز وريدج

137
00:08:51,310 --> 00:08:55,770
أنا جدّ آسف، لم تكن لي أدنى
.فكرة أنّها من معارفك

138
00:08:55,770 --> 00:08:57,140
.لا داعي للقلق

139
00:08:57,530 --> 00:08:59,620
هل ندخل يا ريلينا؟

140
00:08:59,620 --> 00:09:01,600
.الحفلة على وشك أن تبدأ

141
00:09:07,720 --> 00:09:08,440
...المعذرة

142
00:09:08,700 --> 00:09:10,820
.لا داعي لذلك

143
00:09:10,820 --> 00:09:13,010
.يمتلئ هذا المكان بالعجائز

144
00:09:13,010 --> 00:09:15,280
.الشّباب اليافعين من أمثالك قلائل

145
00:09:15,280 --> 00:09:17,050
.سيّد وريدج

146
00:09:17,050 --> 00:09:18,880
.رفيقتك شابّة جميلة

147
00:09:18,880 --> 00:09:21,410
.أنا ريلينا. سررت بلقائك

148
00:09:21,750 --> 00:09:24,210
أتسمحين لي بهذه الرّقصة يا آنستي؟

149
00:09:24,560 --> 00:09:26,260
.لن أسمح بذلك

150
00:09:26,260 --> 00:09:28,260
.الرّقصة الأولى من نصيبي أنا

151
00:09:28,660 --> 00:09:32,000
إن لم تمانعي، فهل تسمحين
لي بهذه الرّقصة؟

152
00:09:32,000 --> 00:09:34,870
.لماذا قد أمانع، سأكون ممتنّة لذلك

153
00:09:34,870 --> 00:09:36,970
.هذا من دواعي سروري

154
00:09:37,840 --> 00:09:38,640
!ما هذا؟

155
00:09:38,940 --> 00:09:41,100
.المدخل تحت الحراسة

156
00:09:41,470 --> 00:09:44,060
.لا مشاكل في البوّابة الخلفيّة أو عبر القناة

157
00:09:44,060 --> 00:09:46,640
.لا يلتقط الرّادار أيّ شيء في السّماء

158
00:09:46,640 --> 00:09:47,570
.عُلم

159
00:09:47,570 --> 00:09:49,020
.واصلوا الحراسة

160
00:09:49,020 --> 00:09:52,250
.يمكنني رؤية تأثير بيسكرافت فيك

161
00:09:53,190 --> 00:09:55,450
هل تعرف عائلة بيسكرافت؟

162
00:09:55,750 --> 00:09:57,400
.بالطّبع أعرفها

163
00:10:01,990 --> 00:10:03,490
.شكرًا لك

164
00:10:04,660 --> 00:10:09,600
كنتُ مقرّبًا من عائلة بيسكرافت
.المالكة في مملكة سانك

165
00:10:09,600 --> 00:10:12,550
وهذا إلى أن أقيلت العائلة
.عن العرش منذ 13 سنة

166
00:10:12,940 --> 00:10:15,900
لماذا أقيلت عائلة بيسكرافت عن العرش؟

167
00:10:15,900 --> 00:10:21,590
،الأمر سخيف، فبينما يأمل البعض في السّلام
.نرى الآخرين يحاولون الاستفادة من النّزاعات

168
00:10:22,180 --> 00:10:26,390
،كانت عائلة بيسكرافت من الصّنف الأوّل
.بينما الآخر هو تحالف المجال الأرضيّ المتّحد

169
00:10:26,920 --> 00:10:30,730
تدخّلت محادثاتهم من أجل السّلام
في مساعي التّحالف؟

170
00:10:31,060 --> 00:10:36,360
نعم، وحتّى مؤسّسة رومفلر الّتي عارضت
.التّحالف، بدأت بتطوير الأسلحة

171
00:10:36,360 --> 00:10:37,720
!سُحقًا لأوز

172
00:10:37,720 --> 00:10:38,850
أوز؟

173
00:10:38,850 --> 00:10:43,660
.دعوتُ تيريز اليوم لأسأله عن نواياه

174
00:10:43,660 --> 00:10:45,080
!لكنّه أرسل من ينوب عنه

175
00:10:51,880 --> 00:10:52,910
ما الخطب؟

176
00:10:52,910 --> 00:10:54,960
.لا تقلقوا، أنا ضيفة أيضًا

177
00:10:58,550 --> 00:11:00,820
.أرشدني إلى مركيز وريدج

178
00:11:00,820 --> 00:11:04,590
،عليّ مقابلته شخصيًّا
.نيابة عن صاحب السّعادة تيريز

179
00:11:09,350 --> 00:11:12,630
.لا مكان للورود على الأزياء العسكريّة

180
00:11:12,630 --> 00:11:16,570
ستكون الوردة مناسبة أكثر على ثوب
!شخص لطيف مثلك يا ريلينا

181
00:11:17,540 --> 00:11:18,890
.مركيز وريدج

182
00:11:18,890 --> 00:11:21,600
.أتيتُ نيابة عن تيريز كوشرينادا

183
00:11:21,600 --> 00:11:23,570
.اسمي ليدي أن

184
00:11:23,570 --> 00:11:25,530
.أحتاج للحديث معك

185
00:11:25,780 --> 00:11:29,240
قبل ذلك، هلاّ أعطيتني تلك الوردة؟

186
00:11:29,240 --> 00:11:31,290
.أودّ إعطاءها لحفيدتي

187
00:11:32,620 --> 00:11:34,120
!ريلينا دارليان

188
00:11:34,120 --> 00:11:35,090
!ماذا تفعلين هنا؟

189
00:11:35,780 --> 00:11:39,730
.جدّي، لن تبدو الورود جيّدة عليّ أيضًا

190
00:11:39,730 --> 00:11:42,550
!سأبدو أفضل لو كنتُ مغمورة بدماء أوز

191
00:11:44,300 --> 00:11:45,850
!هذا من أجل والدي

192
00:11:50,100 --> 00:11:51,100
!سُحقًا

193
00:11:54,310 --> 00:11:55,420
!اتبعوها

194
00:11:56,740 --> 00:11:57,910
!أيّها الماركيز

195
00:11:57,910 --> 00:12:00,820
الوقوف في طريقكم هو أقلّ
!ما يمكنني فعله

196
00:12:01,510 --> 00:12:04,280
!لا يمكنني مجاراة شجاعتها

197
00:12:05,620 --> 00:12:06,980
!كيف تجرؤ؟

198
00:12:06,980 --> 00:12:09,040
.جميعنا معجبون بتلك الفتاة

199
00:12:09,040 --> 00:12:10,080
!إلى المخرج الرّئيسيّ

200
00:12:10,080 --> 00:12:10,710
!حاضر

201
00:12:11,250 --> 00:12:15,890
.نحتاج لشجاعتها لكي نتقدّم للأمام

202
00:12:16,230 --> 00:12:19,120
.هنالك الكثير لأتعلّمه

203
00:12:30,160 --> 00:12:31,260
!الطّريق آمن؟

204
00:12:31,260 --> 00:12:31,940
!أجل

205
00:12:43,640 --> 00:12:44,800
!مهرجان

206
00:12:44,800 --> 00:12:46,210
!هذا حماسيّ

207
00:12:46,210 --> 00:12:49,980
إنّهم يحتفلون بعودتنا نحن جنود
.ماغاناك الأربعين

208
00:12:49,980 --> 00:12:51,080
فعلاً؟

209
00:12:51,080 --> 00:12:55,310
.تُعارض البلاد جيش التّحالف وتدافع عن نفسها

210
00:12:55,790 --> 00:12:57,960
.الماغاناك هي قوّات الجبهات الأماميّة

211
00:12:58,290 --> 00:12:59,450
أهذا صحيح؟

212
00:13:02,330 --> 00:13:03,960
!حسنًا، سأذهب

213
00:13:04,370 --> 00:13:05,470
!لا تدفعي

214
00:13:05,700 --> 00:13:08,860
أنتم أقرب إلى أبطال من كونكم
.جنود جبهة أماميّة

215
00:13:08,860 --> 00:13:11,200
.الجميع متّحدون بالكامل الآن

216
00:13:11,200 --> 00:13:13,520
.لهذا السّبب تجد هذه البلاد متفائلة

217
00:13:14,240 --> 00:13:18,020
هذه البلاد موحّدة وستواصل
.هكذا حتّى النّهاية

218
00:13:19,010 --> 00:13:20,480
ماذا عنّا؟

219
00:13:20,950 --> 00:13:22,780
.هنالك أمور كثيرة أريد محادثتك عنها

220
00:13:22,780 --> 00:13:24,220
أموافق يا كاتر؟

221
00:13:24,220 --> 00:13:25,010
.أجل

222
00:13:25,010 --> 00:13:26,450
.لديّ أسئلة أنا أيضًا

223
00:13:30,760 --> 00:13:32,620
.إنّنا وحدنا الآن

224
00:13:33,230 --> 00:13:34,420
هنالك خمسة إذًا؟

225
00:13:34,420 --> 00:13:35,460
.صحيح

226
00:13:35,460 --> 00:13:37,500
.نحن الخمسة الّذين التقينا في إدواردز الجديدة

227
00:13:38,230 --> 00:13:39,710
.أتيتُ إلى هنا من المستعمرات

228
00:13:40,330 --> 00:13:41,440
.وكذلك أنا

229
00:13:42,170 --> 00:13:45,270
،نحن الخمسة متشابهون للغاية
ألا تظنّ ذلك؟

230
00:13:46,110 --> 00:13:48,110
.بذلنا المتنقّلة ومهمّاتنا

231
00:13:48,110 --> 00:13:51,080
هذا دون أن نذكر هدف تدمير
.أوز الّذي نتشاركه

232
00:13:51,080 --> 00:13:53,550
.دمّرت أوز السّلام في المستعمرات

233
00:13:53,550 --> 00:13:54,810
.هذه مهمّة انتقام

234
00:13:55,290 --> 00:13:57,520
.كنتُ أقاتل تحت هذه الأوامر

235
00:13:57,520 --> 00:13:58,520
.وأنا أيضًا

236
00:13:58,520 --> 00:14:01,460
.وحينها مُنحتُ البذلة المتنقّلة

237
00:14:01,460 --> 00:14:02,150
.وكذلك أنا

238
00:14:02,720 --> 00:14:05,130
.لا تقلق بشأن المستعمرات

239
00:14:05,130 --> 00:14:06,980
".دمّروهم أوّلاً"

240
00:14:06,980 --> 00:14:08,930
".هذه هي مسؤوليّتكم"

241
00:14:09,300 --> 00:14:10,540
.تمامًا

242
00:14:10,540 --> 00:14:11,620
.نعم، كلمة بكلمة

243
00:14:12,000 --> 00:14:14,720
قاتلتُ دائمًا مُصدّقًا أنّ الموت أفضل لي

244
00:14:15,270 --> 00:14:16,580
.من العيش تحت حكم أوز

245
00:14:16,870 --> 00:14:18,080
.وأنا أيضًا

246
00:14:18,080 --> 00:14:19,170
...لكن قتل النّفس

247
00:14:19,970 --> 00:14:21,850
.ذلك ما فعله هيرو

248
00:14:21,850 --> 00:14:22,990
.لقد قتل نفسه

249
00:14:23,450 --> 00:14:25,580
.لا نيّة للمستعمرات في القتال

250
00:14:25,580 --> 00:14:27,580
.لا يمكن التّضحيّة بالمستعمرات

251
00:14:28,120 --> 00:14:30,420
.كان صديقك المثل الأعلى الأفضل

252
00:14:30,420 --> 00:14:34,140
.ما كنتُ لأتخيّل أنّ هيرو بذلك العناد

253
00:14:34,460 --> 00:14:38,550
كانت المستعمرات هدفًا واضحًا
.بمجرّد بدأ عمل الغاندام

254
00:14:43,460 --> 00:14:46,660
معركة حيث البلاد ليست
.موحّدة كجسد واحد

255
00:14:46,970 --> 00:14:49,740
لا يوجد ما هو أكثر صعوبة
.من جنديّ وحيد

256
00:14:49,740 --> 00:14:50,740
!أيّها القائد

257
00:14:52,240 --> 00:14:53,510
!تعال إلى المقرّ

258
00:14:53,510 --> 00:14:55,710
.قوّات البذل المتنقّلة لأوز قادمة

259
00:14:55,710 --> 00:14:56,500
!ماذا؟

260
00:14:57,140 --> 00:14:58,960
!ألق نظرة على هذا يا رشيد

261
00:14:59,450 --> 00:15:01,170
!يبدو أنّها قوّاتهم الاستطلاعيّة

262
00:15:01,320 --> 00:15:03,190
ما رأيك يا رشيد؟

263
00:15:03,190 --> 00:15:06,020
.سيتورّط المدنيّون إن بدأنا القتال هنا

264
00:15:06,020 --> 00:15:09,220
حسنًا، واصلوا المراقبة إذًا
.ولكن أرسلوا جنودًا تحت الأرض

265
00:15:09,220 --> 00:15:09,760
!حاضر

266
00:15:12,130 --> 00:15:14,090
أهذا مهرجان من نوع ما؟

267
00:15:14,460 --> 00:15:17,370
...مرّ بعض الأصدقاء الرُّحّل على القرية

268
00:15:17,370 --> 00:15:18,600
هل من خطب ما؟

269
00:15:18,600 --> 00:15:22,970
هل يمكنك السّماح لقوّاتنا بالاستراحة
ومشاركتنا الطّعام والشّراب؟

270
00:15:22,970 --> 00:15:24,970
.سنقوم بما نستطيع

271
00:15:25,340 --> 00:15:26,480
.شكرًا لكم

272
00:15:26,980 --> 00:15:28,490
.أنتم مخيفون للغاية

273
00:15:28,850 --> 00:15:32,570
سمعنا أنّ متمرّدي الشّرق الأوسط
.يختبئون هنا في هذه المنطقة

274
00:15:32,820 --> 00:15:34,030
.نحن هنا لأسباب وقائيّة

275
00:15:43,220 --> 00:15:44,080
!سُحقًا لهم

276
00:15:49,260 --> 00:15:50,230
!حسنًا

277
00:15:50,230 --> 00:15:51,470
.لقد غادرت أوز

278
00:15:51,470 --> 00:15:52,470
!تحقّقوا من تلك الصّناديق

279
00:15:58,170 --> 00:15:58,980
ماذا وجدت؟

280
00:15:58,980 --> 00:16:00,480
.لا يمكننا تحريكها

281
00:16:00,480 --> 00:16:02,950
.تمّ تجهيزها لتنفجر بأقلّ حركة

282
00:16:02,950 --> 00:16:04,550
رشيد، ما الخطب؟

283
00:16:04,550 --> 00:16:05,750
.سيّد كاتر

284
00:16:05,750 --> 00:16:07,490
.تتظاهر أوز بالغباء

285
00:16:07,490 --> 00:16:09,690
!بينما كانت تزرع عشرين قنبلة حول المدينة

286
00:16:10,080 --> 00:16:10,960
!ماذا؟

287
00:16:10,960 --> 00:16:13,620
نحتاج للتّخلّص منها جميعها
!إن كانت قنابل مؤقّتة

288
00:16:13,620 --> 00:16:15,410
.إنّها مجهّزة لتنفجر إن حرّكناها

289
00:16:18,760 --> 00:16:20,900
.ممّا يعني أنّهم سيجبروننا على الظّهور

290
00:16:21,470 --> 00:16:24,770
.جهّزوا القنابل لتنفجر في منتصف اللّيل

291
00:16:24,770 --> 00:16:27,300
.لا بدّ أنّهم يأملون بمعركة ليليّة

292
00:16:27,300 --> 00:16:30,240
.إذًا فأوز تجهّز لمعركة معنا خلال اللّيل

293
00:16:30,240 --> 00:16:33,510
.أو أنّهم يعتقدون أنّنا سنستسلم قبل ذلك

294
00:16:33,910 --> 00:16:36,600
أليست الغاندام سبب هذه المشكلة؟

295
00:16:36,980 --> 00:16:38,050
!هذا صحيح

296
00:16:38,050 --> 00:16:39,350
.لا بدّ أنّهم يسعون خلفنا

297
00:16:39,720 --> 00:16:41,680
.هجومهم مخطّط له بشكل جيّد

298
00:16:42,180 --> 00:16:44,810
على الأرجح أنّهم كانوا يراقبون
.هذه البلدة منذ مدّة

299
00:16:46,750 --> 00:16:48,270
!استمعوا جميعًا

300
00:16:48,720 --> 00:16:51,830
اكتشفت أوز أمر هذه البلدة
.وتخطّط للهجوم

301
00:16:51,830 --> 00:16:54,740
أشكّ أنّنا قادرون على مواصلة
.خداعهم لأكثر من هذا

302
00:16:55,130 --> 00:16:58,280
لذلك، سنصوّب على منطقة واحدة
من خطّ حصارهم

303
00:16:58,280 --> 00:17:00,700
!ونقاوم بينما نساعد المدنيّين على الهرب

304
00:17:00,700 --> 00:17:03,760
.بقي واجب نبيل آخر

305
00:17:03,760 --> 00:17:06,670
.علينا إخراج بذلتَيْ الغاندام من هنا

306
00:17:07,110 --> 00:17:11,310
!الغاندام أبطال وصلوا إلى الأرض لتدمير أوز

307
00:17:11,810 --> 00:17:15,380
لا تستطيع الغاندام القتال في هذه
.المعركة بسبب دهاء أوز

308
00:17:15,490 --> 00:17:19,100
لكن سيحين يوم ستنقذنا
!فيه الغاندام جميعًا

309
00:17:19,820 --> 00:17:22,720
كونوا شاكرين لأنّ بإمكانكم
!ردّ المعروف مقدّمًا

310
00:17:23,090 --> 00:17:24,520
!أتفهمون؟

311
00:17:25,090 --> 00:17:26,270
!أجل

312
00:17:28,730 --> 00:17:29,940
!لتتّجه كلّ الوحدات للمعركة

313
00:17:45,650 --> 00:17:48,320
!هجوم بذل حوّامة من قوّات الشّرق الأوسط

314
00:17:48,320 --> 00:17:49,840
!أطلقوا النّار يا قوّات تراغوس

315
00:18:00,090 --> 00:18:02,630
!بذل العدوّ الحوّامة سريعة للغاية

316
00:18:02,630 --> 00:18:04,630
!انتقلي للخلف يا بذل تراغوس الحوّامة

317
00:18:04,630 --> 00:18:06,030
!القتال القريب خطير أيضًا

318
00:18:06,030 --> 00:18:06,870
!حاضر

319
00:18:19,660 --> 00:18:23,050
بذل تراغوس جاهزة لإطلاق على
!مخارج العدوّ التّحأرضيّة

320
00:18:23,050 --> 00:18:24,120
!ماذا؟

321
00:18:26,910 --> 00:18:28,870
!هل ظننتُم أنّ ذلك هو مخرجنا الوحيد؟

322
00:18:38,590 --> 00:18:39,430
!نلنا منهم

323
00:18:39,720 --> 00:18:40,930
!عند البوّابة الشّماليّة

324
00:18:40,930 --> 00:18:43,680
!هنالك أنواع متعدّدة من ناقلات العدوّ

325
00:18:43,680 --> 00:18:44,560
.أحسنتم

326
00:18:44,560 --> 00:18:45,810
.دمّروها في الحال

327
00:18:45,810 --> 00:18:46,390
!حاضر

328
00:18:46,850 --> 00:18:47,980
.لا داعي للعجلة

329
00:18:47,980 --> 00:18:50,270
.لم يحرسوا بوّابة الجبل الشّماليّة

330
00:18:50,270 --> 00:18:51,860
!لا تفترقوا عن عائلاتكم

331
00:18:54,570 --> 00:18:57,740
خذ هذه إلى البوّابة الشّماليّة
.حيث ينتظر عبدول

332
00:18:57,740 --> 00:18:58,900
.شكرًا لك

333
00:18:58,900 --> 00:19:00,780
.آسف لعدم مقدرتي على فعل شيء في المقابل

334
00:19:01,410 --> 00:19:03,240
.أشعر بالخزي

335
00:19:06,160 --> 00:19:07,120
من أجلي؟

336
00:19:07,450 --> 00:19:09,080
!الغاندام أبطالنا

337
00:19:09,080 --> 00:19:10,670
.إيّاك أن تنسَ ذلك

338
00:19:10,830 --> 00:19:13,290
!أعلم أنّنا سنقاتل معًا ثانية يومًا ما

339
00:19:13,290 --> 00:19:14,500
!من أجل المستقبل

340
00:19:17,170 --> 00:19:18,550
!يا كاتر

341
00:19:18,550 --> 00:19:19,420
نعم؟

342
00:19:19,760 --> 00:19:21,890
!لديّ زهور من أجلك

343
00:19:22,430 --> 00:19:23,890
!هذا وعد منّي

344
00:19:23,890 --> 00:19:27,180
.ستقاتل الغاندام خاصّتي ثانية يومًا ما

345
00:19:27,180 --> 00:19:31,100
العمليّات المخادعة قد اكتملت
!ونحن نهرب إلى الهضاب

346
00:19:35,520 --> 00:19:37,570
.لا يجب السّماح بوجود خسائر مدنيّة

347
00:19:37,570 --> 00:19:39,900
!سيكون ذلك عارًا على اسم قوّات ماغاناك

348
00:19:40,860 --> 00:19:43,780
!أمّنوا الطّريق لناقلة السّيّد كاتر

349
00:20:02,010 --> 00:20:04,300
!يا قوّات ماغاناك، تجمّعي في الأمام

350
00:20:04,300 --> 00:20:06,350
!لا تسمحوا للعدوّ بتجاوز حاجزنا

351
00:20:07,810 --> 00:20:08,560
...كاتر

352
00:20:08,560 --> 00:20:09,100
نعم؟

353
00:20:10,350 --> 00:20:13,560
هل يمكنك أن تلفّ في السّماء مرّة فحسب؟

354
00:20:13,850 --> 00:20:15,360
.لا يمكنني مساعدتهم الآن

355
00:20:15,610 --> 00:20:17,520
.لكنّي أودّ فعل شيء ما

356
00:20:18,980 --> 00:20:19,480
.أكيد

357
00:20:28,700 --> 00:20:29,830
!تماسكوا

358
00:20:29,830 --> 00:20:30,870
!واصلوا الإطلاق

359
00:20:32,250 --> 00:20:33,420
...سيّد كاتر

360
00:20:40,170 --> 00:20:42,090
!جيّد! تمّت المهمّة

361
00:20:42,800 --> 00:20:45,180
!انسحبي في الحال يا قوّات ماغاناك

362
00:20:55,600 --> 00:20:58,360
.إلى اللّقاء يا قوّات ماغاناك

363
00:20:58,570 --> 00:21:02,820
ستكون أفكار المستعمرات متّحدة
.في لقائنا القادم

364
00:21:03,570 --> 00:21:04,700
!اعتمدوا على ذلك

365
00:21:10,040 --> 00:21:11,200
!ها هي ذي

366
00:21:18,380 --> 00:21:20,340
!فتاة سخيفة! لا تتحرّكي

367
00:21:20,340 --> 00:21:20,960
!اتركوني

368
00:21:22,460 --> 00:21:23,260
!من أنت؟

369
00:21:23,840 --> 00:21:26,010
.سأهتمّ بأمرها انطلاقًا من هنا

370
00:21:26,010 --> 00:21:28,090
.لدينا أوامر خاصّة من العقيد ليدي أن

371
00:21:28,090 --> 00:21:29,430
.لا يمكنني أخذ أوامر منك أيّتها الملازم

372
00:21:33,850 --> 00:21:37,980
.هذه الأوامر من صاحب السّعادة تيريز

373
00:21:38,310 --> 00:21:39,770
هل أنت راضٍ؟

374
00:21:39,770 --> 00:21:40,770
!أجل

375
00:21:40,770 --> 00:21:42,150
!عذرًا على سوء الفهم

376
00:21:49,450 --> 00:21:51,160
.تتصرّفين بتهوّر

377
00:21:51,160 --> 00:21:53,500
.أتساءل من أين ورثتِ طبعك هذا

378
00:21:54,200 --> 00:21:55,410
أنت عضوة في أوز، صحيح؟

379
00:22:03,760 --> 00:22:04,880
من أنت؟

380
00:22:05,590 --> 00:22:07,220
.أتيتُ من أجلك

381
00:22:07,680 --> 00:22:09,470
.آنسة ريلينا بيسكرافت

382
00:22:12,560 --> 00:22:17,060
يُـتـبـع

383
00:22:25,110 --> 00:22:31,280
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

384
00:22:32,740 --> 00:22:39,000
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

385
00:22:39,790 --> 00:22:43,670
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

386
00:22:43,920 --> 00:22:47,130
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

387
00:22:47,630 --> 00:22:53,680
حبّ فحسب! إنّه يثير أعصابي

388
00:22:55,470 --> 00:23:02,440
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

389
00:23:02,810 --> 00:23:09,950
حبّ فحسب! أنا دائمة التّفكير به

390
00:23:10,990 --> 00:23:17,370
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

391
00:23:18,290 --> 00:23:21,370
... حبّ فحسب ...

392
00:23:28,210 --> 00:23:30,220
في الحلقة القادمة

393
00:23:32,050 --> 00:23:35,350
.على المرء استعمال الأسلحة ليستعيد السّلام

394
00:23:36,010 --> 00:23:39,560
يقابل ووفي سالي بو في ساحة
.معركة تملؤها التّناقضات

395
00:23:40,440 --> 00:23:42,350
يقول ووفي أنّه لا يجدر
.على الضّعفاء أن يقاتلوا

396
00:23:43,020 --> 00:23:44,440
...لكن بعد تلك الكلمات

397
00:23:44,440 --> 00:23:46,780
.تشعر سالي بتعقيد مقاتل قلق

398
00:23:47,860 --> 00:23:51,950
يعود ووفي إلى سينلونغ غاندام
.خاصّته وهو ضائع في مشاعره

399
00:23:53,070 --> 00:23:56,120
،"في الحلقة الثّانية عشر من "جناح الغاندام

400
00:23:56,120 --> 00:23:58,200
."مقاتلون حائرون"