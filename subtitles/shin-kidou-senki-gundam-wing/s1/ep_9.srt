.ستُمسي أوز حينها مكروهة

178
00:11:58,510 --> 00:12:00,530
.ستكون هدفًا للعالم بأسره

179
00:12:00,950 --> 00:12:02,280
...سيّد تيريز

180
00:12:02,590 --> 00:12:05,090
.إن من يُكرهون يجب أن يظلّوا أقوياء

181
00:12:05,760 --> 00:12:08,350
.سيكون هذا تحفيزًا مثاليًّا لأوز

182
00:12:16,670 --> 00:12:20,340
.سيّد كاتر، إن حدث لك أيّ شيء

183
00:12:20,340 --> 00:12:23,810
كيف كنّا لنشرح الأمر لوالدك
في المستعمرة؟

184
00:12:23,810 --> 00:12:26,140
ألا تثق بنا يا سيّدي؟

185
00:12:26,550 --> 00:12:28,390
.الأمر ليس كذلك

186
00:12:28,390 --> 00:12:31,650
.هدفنا الوحيد هنا هو حمايتك

187
00:12:31,650 --> 00:12:33,350
!هل تدرك ذلك؟

188
00:12:33,350 --> 00:12:34,560
!سيّد كاتر

189
00:12:34,950 --> 00:12:36,190
.نـ-نعم

190
00:12:36,190 --> 00:12:38,220
.حسنًا، هذا يكفي

191
00:12:38,220 --> 00:12:39,950
!لكن أيّها القائد رشيد

192
00:12:40,600 --> 00:12:44,030
وعد السّيّد كاتر أنّه لن يغادر
.بمفرده بعد الآن

193
00:12:44,360 --> 00:12:46,230
.نعم، أعد بذلك

194
00:12:47,770 --> 00:12:50,700
.حسنًا، لا وقت للوقوف هنا

195
00:12:50,700 --> 00:12:52,800
حمّلوا الأسلحة في بِدلكم المتنقّلة
.أو ما شابه

196
00:12:54,010 --> 00:12:56,250
.شكرًا لك يا رشيد

197
00:12:56,250 --> 00:12:59,840
.أنا منزعج منك أيضًا، فلا تنسَ ذلك

198
00:12:59,840 --> 00:13:01,070
.حا-حاضر

199
00:13:01,070 --> 00:13:02,340
كيف سرى الأمر؟

200
00:13:02,750 --> 00:13:04,750
.كنّا خمس بِدل في المجمل

201
00:13:04,750 --> 00:13:07,300
.أنا واثق أنّ جميعها كانت من الغاندام

202
00:13:07,300 --> 00:13:09,180
جميعها من الغاندام؟

203
00:13:09,180 --> 00:13:12,350
طيّاروها عنيفون وخطيرون
.لكنّهم أشخاص لطفاء

204
00:13:12,930 --> 00:13:15,020
كيف لك أن تكون واثقًا من ذلك؟

205
00:13:15,570 --> 00:13:17,300
.ذلك واضح لي

206
00:13:18,100 --> 00:13:20,530
.أنبأتني بذلك روح الفضاء الخارجيّ

207
00:13:20,530 --> 00:13:22,050
روح الفضاء الخارجيّ؟

208
00:13:23,440 --> 00:13:25,280
...روح الفضاء الخارجيّ

209
00:13:36,380 --> 00:13:38,540
!يا إلهي منكما

210
00:13:38,540 --> 00:13:40,980
أتستمتعان بالجلوس هناك فحسب؟

211
00:13:40,980 --> 00:13:42,570
.لم تقولا كلمة واحدة طوال ساعتين

212
00:13:43,320 --> 00:13:44,580
ما الّذي تريدينه؟

213
00:13:44,580 --> 00:13:45,720
.تحيّة لطيفة

214
00:13:45,720 --> 00:13:48,140
.ظننتُ أنّه من اللّطيف إحضار هذا لكما

215
00:13:48,860 --> 00:13:50,850
.كلاه قبل أن يبرد

216
00:13:54,070 --> 00:13:57,140
.سأتركه هنا، لذلك بالهناء والشّفاء

217
00:13:57,140 --> 00:13:59,690
.ولا تنسَ غسل الأطباق بعد انتهائكما

218
00:13:59,690 --> 00:14:02,110
عليك أن تتعلّم كيف تحسن
.التّصرّف بينما لا تزال يافعًا

219
00:14:02,110 --> 00:14:02,900
!إلى اللّقاء

220
00:14:05,810 --> 00:14:09,140
أظنّ أنّ الأشخاص الهادئين
.لا يصادقون إلاّ الهادئين

221
00:14:17,020 --> 00:14:18,490
.قد لا تكون أفضل قهوة

222
00:14:20,760 --> 00:14:22,950
.لا يحقّ لي أن أقود ناتاكو

223
00:14:24,500 --> 00:14:25,430
فعلاً؟

224
00:14:28,770 --> 00:14:29,940
.شكرًا لك

225
00:14:41,900 --> 00:14:44,380
لقد استقرّ نبضك الآن

226
00:14:44,380 --> 00:14:47,480
.لكنّ نظام دورتك الدّمويّة غير منتظم

227
00:14:47,480 --> 00:14:49,860
تقصد أنّ عليّ أن أكون سعيدًا
.لأنّي على قيد الحياة

228
00:14:50,260 --> 00:14:53,020
زيكس، ما الّذي حدث؟

229
00:14:53,860 --> 00:14:56,420
.لقد استخففتُ ببذلة تالغيس

230
00:14:56,930 --> 00:15:00,090
.إنّها تتجاهل سلامة الطّيّار بالكامل

231
00:15:00,090 --> 00:15:03,090
لديها تصميم جريء

232
00:15:03,090 --> 00:15:04,800
يتخطّى المعدّات المتقدّمة
.المعاصرة بمراحلة كثيرة

233
00:15:05,260 --> 00:15:07,360
تتجاهل الطّيّار؟

234
00:15:07,360 --> 00:15:10,410
إنّها تأخذ في الحسبان كلّ أنواع
أنماط المعارك

235
00:15:10,410 --> 00:15:14,810
وتجعل من الممكن لبذلة واحدة
.أن تظفر بالنّصر بمفردها

236
00:15:14,810 --> 00:15:16,880
.أو هكذا وجدتُها على الأقلّ

237
00:15:17,420 --> 00:15:19,750
.لكنّي أصبحتُ جبانًا

238
00:15:19,750 --> 00:15:23,760
كلما حاولتُ استخدام قدرات
،البذلة المتنقّلة

239
00:15:23,760 --> 00:15:25,490
.زاد شكّي في قدراتي أنا

240
00:15:25,830 --> 00:15:29,590
أسأل نفسي وأقول أهذا كلّ
ما تستطيعه يا زيكس؟

241
00:15:31,130 --> 00:15:35,360
.إنّها بذلة بغرض النّزال بَدل القتال

242
00:15:35,360 --> 00:15:39,200
تحتاج طيّارًا شجاعًا لإظهار
.إمكانيّاتها الحقيقيّة

243
00:15:39,200 --> 00:15:41,180
طيّارًا شجاعًا؟

244
00:15:41,180 --> 00:15:43,920
.شجاع كفاية ليخاطر بالموت بغرض النّصر

245
00:15:45,510 --> 00:15:49,010
ما زال أمامي وقت طويل
.لأذهب وأواجه مخاوفي

246
00:15:49,480 --> 00:15:52,410
.والآن، عليّ العودة إلى مملكة سانك

247
00:15:52,410 --> 00:15:53,820
!عليك أن ترتاح

248
00:15:53,820 --> 00:15:56,930
.لكان أيّ شخص عاديّ أن يكون ميتًا الآن

249
00:15:56,930 --> 00:16:00,100
سأغادر، لكن عليك البقاء هنا
.وأخذ قسط من الرّاحة

250
00:16:00,490 --> 00:16:01,560
.لكن عليّ الذّهاب

251
00:16:02,630 --> 00:16:04,980
.سأوافق فقط إن لم تقد تالغيس

252
00:16:04,980 --> 00:16:06,030
!نوين

253
00:16:06,400 --> 00:16:09,240
.بذلة تالغيس أساسيّة لنا

254
00:16:09,680 --> 00:16:12,490
.أنا واثق أنّ تصميمها هو نفسه تصميم الغاندام

255
00:16:12,490 --> 00:16:13,450
الغاندام؟

256
00:16:14,070 --> 00:16:19,880
كما أخبرتك، أعتقد أنّ الغاندام قد ورثت
.التّصميم المتهوّر لبذلة تالغيس

257
00:16:19,880 --> 00:16:21,300
.إنّها أصل البِدل المتنقّلة

258
00:16:21,840 --> 00:16:26,240
لهذا السّبب من الضّروريّ لي
.أن أقود تالغيس لهزيمة الغاندام

259
00:16:30,590 --> 00:16:33,420
.لا تنفع تالغيس إلاّ للمهمّات الانتحاريّة

260
00:16:33,420 --> 00:16:36,330
.أمسيتُ الآن أدرك نوايا الغاندام

261
00:16:36,330 --> 00:16:39,680
إنّهم يبحثون عن مكان ملائم
.ليلاقوا فيه حتفهم

262
00:16:40,300 --> 00:16:43,960
أعرف أنّه من الصّعب عليك
الاستلقاء دون حركة

263
00:16:43,960 --> 00:16:46,630
،بينما مملكة سانك قريبة منك
.لكن عليك أن تصغي لكلامي

264
00:16:46,630 --> 00:16:48,320
.سنهاجم غدًا مساءً

265
00:16:48,800 --> 00:16:51,030
!حاضرة! عُلم

266
00:17:09,660 --> 00:17:10,890
!ما الخطب؟

267
00:17:10,890 --> 00:17:12,670
!لقد غادرت تالغيس

268
00:17:12,670 --> 00:17:13,630
!ماذا؟

269
00:17:18,640 --> 00:17:21,310
!ما الّذي تفعله؟! عد في الحال يا أوتّو

270
00:17:21,680 --> 00:17:26,520
بذلة تالغيس هذه قادرة على السّيطرة
!على المقرّ الرّئيسيّ لمملكة سانك

271
00:17:27,110 --> 00:17:29,900
!يجدر بي معرفة ذلك فأنا أفهم قوّة تالغيس

272
00:17:30,180 --> 00:17:31,360
!توقّف! ستموت

273
00:17:32,150 --> 00:17:35,380
سيكون شرفًا لي أن أضحّي بحياتي
.من أجلك أيّها الملازم

274
00:17:35,380 --> 00:17:38,940
!اسمح لي أن أساعدك في تحقيق أحلامك

275
00:17:38,940 --> 00:17:42,580
أريد فعل هذا من أجلك يا ملازم زيكس
!وليس من أجل أوز

276
00:17:43,130 --> 00:17:44,300
...أوتّو

277
00:17:44,870 --> 00:17:47,620
!سأظفر بالنّظر مقابل حياتي

278
00:17:47,620 --> 00:17:49,590
!كلامك غير منطقيّ يا أوتّو

279
00:17:49,940 --> 00:17:51,800
!عد في الحال يا أوتّو

280
00:17:57,540 --> 00:18:00,300
.أتيتُ كلّ هذه المسافة مطاردة رجلاً فحسب

281
00:18:00,650 --> 00:18:02,260
هل أنت متفاجئ يا والدي؟

282
00:18:02,910 --> 00:18:05,820
،لكن لم أستطع منع نفسي
.أردتُ رؤيته بشدّة

283
00:18:06,540 --> 00:18:08,730
أتفهم ما أشعر به يا أبي؟

284
00:18:11,960 --> 00:18:16,650
أحتاج لدعم هيرو إلى أن أتجاوز
.خزني على فقدانك

285
00:18:16,650 --> 00:18:18,410
...لكنّه لا ينفكّ عن الهرب

286
00:18:24,950 --> 00:18:26,070
!هيرو؟

287
00:18:38,380 --> 00:18:39,410
!جيّد

288
00:18:39,410 --> 00:18:41,220
!يبدو أنّي وصلتُ أوّلاً

289
00:18:48,940 --> 00:18:50,820
!ما الّذي أخّرك يا هيرو؟

290
00:18:50,820 --> 00:18:52,360
!لا تقلق، تركتُ لك القليل

291
00:19:03,440 --> 00:19:05,220
!لا يمكنني رؤية شيء

292
00:19:15,320 --> 00:19:16,800
.انتهت المهمّة

293
00:19:25,500 --> 00:19:27,010
!لا تقف في طريقي

294
00:19:27,010 --> 00:19:29,560
!لا أعرف إلى متى يمكنني تحمّل هذا

295
00:19:38,860 --> 00:19:39,900
!أسرع

296
00:19:39,900 --> 00:19:40,490
!حاضر

297
00:19:41,050 --> 00:19:43,550
،ليتني كنتُ قادرًا على قيادة تالغيس

298
00:19:43,550 --> 00:19:45,700
!لما كان هذا ليحدث حينها

299
00:19:45,700 --> 00:19:48,290
!يقترب نموذج البذلة المتنقّلة الجديد بسرعة

300
00:19:48,290 --> 00:19:50,350
!وجّهوا أشعة اللّيزر كلّها نحو تلك البذلة

301
00:19:58,930 --> 00:20:02,050
!يحيا الملك زيكس

302
00:20:12,410 --> 00:20:13,580
...أوتّو

303
00:20:51,720 --> 00:20:55,850
أخذ منّي الأمر ثلاثة عشر سنة
.لأعود إلى هذه الأرض

304
00:20:57,090 --> 00:20:59,070
.سامحني يا أبي

305
00:20:59,590 --> 00:21:02,810
وكانت هنالك الكثير من إراقة
الدّماء في طريقي

306
00:21:03,490 --> 00:21:08,030
واستطعتُ فقط أن أعيش أسلوب حياة
.عارض تعاليمك المسالمة

307
00:21:08,030 --> 00:21:10,930
.يداي ملطّختان بالدّماء

308
00:21:11,470 --> 00:21:15,440
لستُ مناسبًا تمامًا لأكون قائدًا
.لعائلة بيسكرافت الملكيّة

309
00:21:24,510 --> 00:21:29,010
لكنّي واثق أنّها ستكون قادرة على
.قيادة البلاد بالطّريقة الّتي أردتَها

310
00:21:29,610 --> 00:21:31,470
.سأقاتل لتحقيق ذلك

311
00:21:31,790 --> 00:21:33,350
.لقد خذلتُك

312
00:21:33,350 --> 00:21:34,500
.سامحني رجاءً

313
00:21:44,110 --> 00:21:45,570
!تعرّضت للهجوم؟

314
00:21:45,570 --> 00:21:47,330
!أهذا من صنيع المستعمرات؟

315
00:21:47,330 --> 00:21:48,260
!هذا مخيف

316
00:21:50,880 --> 00:21:51,830
!هيرو

317
00:21:52,110 --> 00:21:53,610
!صباح الخير أيّتها الآنسة

318
00:21:53,610 --> 00:21:54,910
.يا له من يوم جميل

319
00:21:55,300 --> 00:21:57,570
.لدينا دروس لنحضرها

320
00:22:02,520 --> 00:22:05,450
.دعني أظلّ قربك لوقت أطول

321
00:22:05,450 --> 00:22:08,120
.أريد أن أكون قويّة مثلك تمامًا

322
00:22:13,470 --> 00:22:16,940
يُـتـبـع

323
00:22:24,780 --> 00:22:30,950
لقد اتّصلتُ به فجأة، فقط لأنّ الجوّ كان صحوًا

324
00:22:32,410 --> 00:22:38,670
لكنّه جعلني أنتظر، فكيف يجرؤ على معاملتي هكذا

325
00:22:39,460 --> 00:22:43,340
أعرف أنّه يلتقط أنفساه جرّاء الرّكض إلى هنا

326
00:22:43,590 --> 00:22:46,800
!لكنّ ذلك هو أقلّ ما يمكنه فعله من أجلي

327
00:22:47,300 --> 00:22:53,350
حبّ فحسب! إنّه يثير أعصابي

328
00:22:55,140 --> 00:23:02,110
أنا أغيظه فحسب لأنّه يروق لي في الحقيقة

329
00:23:02,480 --> 00:23:09,610
حبّ فحسب! أنا دائمة التّفكير به

330
00:23:10,660 --> 00:23:17,040
...آسفة لأنّي بالغتُ في الأمور نوعًا ما

331
00:23:17,950 --> 00:23:21,040
... حبّ فحسب ...

332
00:23:27,880 --> 00:23:29,880
في الحلقة القادمة

333
00:23:32,600 --> 00:23:35,390
لا تتسبّب المعارك الّتي تخاطر
.بالأرواح إلاّ بالأخطاء

334
00:23:35,390 --> 00:23:38,310
ما معنى موت أوتّو إذًا؟

335
00:23:39,230 --> 00:23:41,940
،تعلن ليدي أن عن خطّة لنقل بِدل الثّور

336
00:23:41,940 --> 00:23:44,230
،وهي بِدل متنقّلة فضائيّة
.إلى القاعدة السّيبيريّة

337
00:23:44,580 --> 00:23:48,010
.ولكنّ هذا ليس إلاّ مقدّمة لإبادة الغاندام

338
00:23:48,700 --> 00:23:52,170
يكون القرار الأخير لهيرو في هذه
.المعركة ضدّ زيكس

339
00:23:52,600 --> 00:23:55,580
،في الحلقة العاشرة من جناح الغاندام

340
00:23:55,580 --> 00:23:57,580
."هيرو الّذي شتّتت الهزيمة ذهنه"