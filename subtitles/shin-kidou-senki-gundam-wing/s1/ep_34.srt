1
00:01:29,060 --> 00:01:32,320
روّجت رومفلر بغرض تسهيل
...سيطرتها على العالم

2
00:01:32,320 --> 00:01:37,450
إلى منظّمةِ أوز جديدة تتأسّس قوّتها
.الرّئيسيّة من الدّمى المتنقّلة آليّة القيادة

3
00:01:39,660 --> 00:01:43,290
ظهرت تغييرات مؤكّدة في المؤسّسة

4
00:01:43,290 --> 00:01:45,830
.بعد تصرّف تيريز كوشرينادا المعارض

5
00:01:45,830 --> 00:01:48,250
.بما فيها تجريده من كلّ سلطاته

6
00:01:48,710 --> 00:01:53,800
كانت المؤسّسة توسّع نطاق حكمها بسرعة
.بفضل الدّمى المتنقّلة عالية المهارة

7
00:01:55,300 --> 00:01:57,050
.السّنة 195 بعد المستعمرات

8
00:01:57,430 --> 00:02:00,010
،بعد أن قبلت المستعمرات الفضائيّة بالمؤسّسة

9
00:02:00,010 --> 00:02:04,600
تمّ إصدار أوامر بإعدام طيّاري
.الغاندام المعزولين

10
00:02:05,520 --> 00:02:09,850
بالنّسبة لهم، كان المستقبل
.يأخذ مسارًا للخلف

11
00:02:17,900 --> 00:02:18,950
.لا تموتوا

12
00:02:19,660 --> 00:02:21,240
!واصلوا القتال وانجوا من هذه المعركة

13
00:02:22,370 --> 00:02:26,870
.لا يجب أن تموتوا أيّها الطّيّارون

14
00:02:47,770 --> 00:02:48,640
هل هذه النّهاية؟

15
00:02:50,940 --> 00:02:52,150
...ريلينا

16
00:03:05,740 --> 00:03:07,700
!يحيا السّيّد تيريز

17
00:03:35,690 --> 00:03:36,520
!أنت

18
00:03:36,980 --> 00:03:39,280
.احم السّيّد تيريز

19
00:03:39,690 --> 00:03:40,740
.أتوسّل إليك

20
00:03:56,170 --> 00:03:57,840
.أيّها الدّوق ديرمايل

21
00:03:57,840 --> 00:03:58,710
ماذا هنالك؟

22
00:03:59,260 --> 00:04:02,220
هل تأكّد تدمير فصيل تيريز؟

23
00:04:02,220 --> 00:04:04,930
.كلاّ... ليس تمامًا

24
00:04:04,930 --> 00:04:05,680
!كيف ذلك؟

25
00:04:06,100 --> 00:04:10,640
كيف أمكنهم تحمّل هجومنا بينما أرسلنا
مثل هذه القوّة العسكريّة القويّة؟

26
00:04:10,640 --> 00:04:11,850
.بفضل غاندام

27
00:04:12,440 --> 00:04:13,440
ماذا؟

28
00:04:13,440 --> 00:04:15,560
.انضمّت الغاندام 01 إليهم

29
00:04:15,560 --> 00:04:18,070
.لقد فقدنا نصف الدّمى المتنقّلة

30
00:04:18,070 --> 00:04:20,610
.والوضع قد سادته الفوضى

31
00:04:20,610 --> 00:04:25,530
على هذا المعدّل، فإنّها مسألة وقت
.فحسب قبل تحرير تيريز كوشرينادا

32
00:04:25,780 --> 00:04:28,240
ماذا نفعل الآن يا سيّدي الدّوق؟

33
00:04:31,330 --> 00:04:36,500
أخبرهم بالتّوجّه إلى لوكسمبورغ دفعة
.واحدة للقضاء على الغاندام وفصيل تيريز

34
00:04:36,500 --> 00:04:37,460
.حاضر

35
00:04:40,000 --> 00:04:44,220
.ما تيريز إلاّ مجرّد وهم يبهر جنود الفصيل

36
00:04:44,760 --> 00:04:48,850
.بنفس الطّريقة الّتي ترمز بها الغاندام للمتمرّدين

37
00:04:48,850 --> 00:04:53,180
يجب القيام بكلّ شيء لمنع
.الاثنين من ضمّ قوّاتهما

38
00:05:13,580 --> 00:05:16,710
.تأكيد التّحقّق من الصّوت والبصمة

39
00:05:17,330 --> 00:05:19,460
.اذكر اسمك

40
00:05:26,720 --> 00:05:28,220
.هيرو يوي

41
00:05:29,140 --> 00:05:31,220
.تمّ تأكيد الهويّة

42
00:05:31,220 --> 00:05:32,680
.ادخل رجاءً

43
00:05:55,750 --> 00:05:58,120
.شكرًا على مجيئك يا هيرو يوي

44
00:06:02,090 --> 00:06:06,220
أرحّب بك ترحيبًا من القلب
.يا رسول السّلام العزيز

45
00:06:06,590 --> 00:06:07,680
.أنت تيريز

46
00:06:07,680 --> 00:06:09,720
.يجدر بذلك أن يكون واضحًا

47
00:06:09,720 --> 00:06:12,100
.والآن، تفضّل بإطلاق النّار عليّ

48
00:06:12,100 --> 00:06:13,890
.أنهِ هذه المعركة

49
00:06:20,190 --> 00:06:21,810
ما الخطب؟

50
00:06:21,810 --> 00:06:24,860
.لن تنتهي الحرب ما دام فيّ عرق ينبض

51
00:06:25,320 --> 00:06:27,530
أليس هذا سبب مجيئك إلى هنا؟

52
00:06:27,990 --> 00:06:30,160
.أخبرني لماذا سمحت لي بالدّخول

53
00:06:30,160 --> 00:06:34,330
لقد برمجت الحاسوب لقبول بياناتك
.قبل بضعة شهور

54
00:06:34,330 --> 00:06:35,490
...ظننتُ أنّه يومًا ما

55
00:06:35,490 --> 00:06:40,500
سأتمكّن من الحديث معك ومع بقيّة
.طيّاري الغاندام مطوّلاً

56
00:06:40,920 --> 00:06:42,710
.أنا لستُ مهتمًّا بالحديث

57
00:06:42,710 --> 00:06:44,000
.بالطّبع لا

58
00:06:44,000 --> 00:06:47,090
يجب عليكم أيّها الطّيّارون التّفكير
.في الحفاظ على السّلام فحسب

59
00:06:47,090 --> 00:06:48,220
.السّلام للأرض

60
00:06:48,220 --> 00:06:51,680
.أو بالأحرى، السّلام للكون بأسره

61
00:06:53,800 --> 00:06:56,220
.القتال هو اهتمامي الوحيد

62
00:06:56,220 --> 00:06:59,890
.السّلام مجرّد نتيجة تأتي بعد نهاية القتال

63
00:06:59,890 --> 00:07:01,020
.أخبرني إذًا

64
00:07:01,020 --> 00:07:02,690
من هو عدوّك؟

65
00:07:03,440 --> 00:07:04,570
أهو أنا؟

66
00:07:04,570 --> 00:07:05,480
أم هو أوز؟

67
00:07:05,480 --> 00:07:06,860
أم تُراه رومفلر؟

68
00:07:06,860 --> 00:07:11,490
،أو ربّما يكون موطنك البعيد
المستعمرات الّتي خانتك؟

69
00:07:11,860 --> 00:07:15,490
.كلّ من يقف في طريقي ويحاول قلتي

70
00:07:15,490 --> 00:07:16,830
.ذلك هو عدوّي

71
00:07:17,120 --> 00:07:20,160
...في تلك الحالة، لن تنتهي معاركك

72
00:07:20,160 --> 00:07:22,790
.بما أنّ القدر بحدّ ذاته هو عدوّك

73
00:07:23,290 --> 00:07:24,630
.ربّما

74
00:07:24,630 --> 00:07:26,170
.لكنّني سأواصل القتال

75
00:07:26,170 --> 00:07:28,130
.ذلك هو خياري الوحيد

76
00:07:28,130 --> 00:07:30,510
.كما أنّني جاهز للموت في سبيل ذلك

77
00:07:31,050 --> 00:07:34,430
ألست جاهزًا لقبول قدرك بعد؟

78
00:07:34,430 --> 00:07:38,970
من وجهة النّظر تلك، فإنّ ريلينا بيسكرافت
.هي شخص أقوى بكثير منك

79
00:07:41,440 --> 00:07:46,270
.أنا متفاجئ أنّه حتّى أنت قد تعبت من القتال

80
00:07:46,270 --> 00:07:50,400
هذا محزن، لكن لا يستطيع أحد
.تغيير مسار الزّمن

81
00:07:50,400 --> 00:07:52,450
.يُفترض أنّك تستطيع ذلك

82
00:07:53,070 --> 00:07:55,910
.امتلكتَ ذات يوم القوّة لتغيير التّاريخ

83
00:07:55,910 --> 00:07:58,450
.ليس عليك إلاّ أن تفعل ذلك ثانية

84
00:07:59,330 --> 00:08:01,410
.لا نيّة لي للقيام بذلك

85
00:08:01,410 --> 00:08:02,120
.فهمت

86
00:08:02,710 --> 00:08:07,960
كان أكثر ما يسعدني في الحياة
.هو تمكّني من الحديث معك

87
00:08:11,630 --> 00:08:14,140
.والآن أمسيت أفهم

88
00:08:14,140 --> 00:08:17,390
.يجب أن يتزامن موتي مع موتك

89
00:08:17,390 --> 00:08:21,020
بما أنّنا التقينا الآن، دعنا نضع
.نفسينا بين أيدي الرّبّ

90
00:08:21,480 --> 00:08:23,560
.أنت خاسر مسكين

91
00:08:24,190 --> 00:08:25,980
.ذلك لا يهمّني

92
00:08:26,400 --> 00:08:28,730
.جندي لا يمانع الموت

93
00:08:28,730 --> 00:08:33,200
ذلك هو أصحّ تصرّف يمكن
.لشخص أن يتّخذه للقتال

94
00:08:34,030 --> 00:08:37,200
لكن لسوء الحظّ، أنت لا تعرف
.ضدّ من يجب أن تقاتل

95
00:08:37,200 --> 00:08:39,660
.وذلك يضعك في نفس الكفّة معي

96
00:08:39,660 --> 00:08:42,160
.بلغت معركتي نهايتها أيضًا

97
00:08:42,580 --> 00:08:44,120
.لم تنتهِ معركتك

98
00:08:44,920 --> 00:08:48,590
حتّى ونحن نتكلم الآن، ثمّة عدد لا يحصى
.من الجنود يضحّون بحياتهم من أجلك

99
00:08:49,170 --> 00:08:52,840
!يمكنني أن أجزم لك أنّ معركتك لم تنتهِ

100
00:08:55,220 --> 00:08:56,890
...إن كان ثمّة ما قد انتهى

101
00:08:56,890 --> 00:08:59,470
...أو بالأحرى، إن كان ثمّة ما يجب أن ينتهي

102
00:08:59,470 --> 00:09:03,560
.فهي مقاومتي البائسة وغير المفيدة

103
00:09:06,310 --> 00:09:07,560
.هيرو يوي

104
00:09:07,560 --> 00:09:11,610
.أنا أتوسّل إليك، لا تخيّب رجائي أكثر من فضلك

105
00:09:12,360 --> 00:09:14,780
.يجب ألاّ تكون في نفس الوضع الّذي أنا فيه

106
00:09:21,080 --> 00:09:25,160
.لديّ مرشد سيريك كيف تعيش

107
00:09:54,530 --> 00:09:56,110
.معك الفزّاعة 5

108
00:09:56,110 --> 00:09:57,240
.تمّ تأكيد مكان الجناح صفر

109
00:09:57,570 --> 00:09:59,660
.سوف نواصل عمليّتنا

110
00:10:04,450 --> 00:10:06,250
.ستفي هذه الكمّيّة من المتفجّرات بالغرض

111
00:10:06,580 --> 00:10:08,920
.إنّها كافية لتفجير ثلاث بذل أسد

112
00:10:08,920 --> 00:10:11,130
.جيّد، عد إلى بذلة الأسد خاصّتك

113
00:10:11,790 --> 00:10:13,840
.سوف يفجّرونها إذًا

114
00:10:14,260 --> 00:10:15,420
.هذا طبيعيّ

115
00:10:15,420 --> 00:10:19,010
،بسبب أوز، أو بالأحرى بسبب رومفلر

116
00:10:19,010 --> 00:10:23,060
فإنّ أيّ غاندام تحول بينهم
.وبين هدفهم بالغزو

117
00:10:23,930 --> 00:10:26,520
.لنريهم ما مدى قيمتها الحقيقيّة

118
00:10:29,560 --> 00:10:32,440
.حسنًا، سوف نشرع بتفجير الجناح صفر

119
00:10:32,940 --> 00:10:34,860
!هنالك جسم يقترب بسرعة هائلة

120
00:10:34,860 --> 00:10:35,400
!ماذا؟

121
00:10:37,320 --> 00:10:38,400
!إنّها تالغيس

122
00:10:38,400 --> 00:10:39,610
!لقد وصل كونت البرق

123
00:10:54,920 --> 00:10:56,170
!سُحقًا

124
00:10:59,630 --> 00:11:01,090
!هذه الفزّاعة 5

125
00:11:01,090 --> 00:11:02,800
!يا حصن بالج، تالغيس هنا

126
00:11:08,310 --> 00:11:10,100
لماذا الهرب من المعركة؟

127
00:11:10,100 --> 00:11:14,110
هل أنست الدّمى المتنقّلة الجنود كيف يقاتلون؟

128
00:11:14,650 --> 00:11:18,190
أم أنّ معتقداتي قد أكل عليها الدّهر وشرب؟

129
00:11:19,740 --> 00:11:21,160
.احترس يا زيكس

130
00:11:21,160 --> 00:11:24,120
هنالك ناقلة دمى متنقّلة فائقة
.السّرعة متّجهة لك

131
00:11:28,910 --> 00:11:31,460
،حسب هذه المعلومة
.فيبدو أنّهم كانوا يتوقّعونني

132
00:11:34,040 --> 00:11:37,130
،بالنّظر إلى كم يعتمدون على الدّمى المتنقّلة

133
00:11:37,130 --> 00:11:39,760
.فإنّ هذه خطّة قتال واضحة وضوح الشّمس

134
00:11:53,100 --> 00:11:54,940
تعزيزات دمى متنقّلة؟

135
00:11:54,940 --> 00:11:56,570
.إنّهم مستعدّون تمامًا

136
00:12:18,800 --> 00:12:19,510
المزيد من القوّات؟

137
00:12:26,390 --> 00:12:27,930
.فهمت

138
00:12:27,930 --> 00:12:30,350
.يبدو أنّهم بالغوا في تقدير قدراتي

139
00:12:31,390 --> 00:12:34,060
،إلى الوحدات من 7 إلى 12
!انتشري وحاصري البقيّة

140
00:12:34,520 --> 00:12:37,020
!لن أدعك تهرب يا كونت البرق

141
00:12:53,330 --> 00:12:54,620
.تالغيس

142
00:12:54,620 --> 00:12:57,290
.لقد وصلت لهذا الحدّ بفضلك

143
00:13:02,420 --> 00:13:04,170
.أنا ممتنّ تمامًا

144
00:13:10,560 --> 00:13:12,060
!الفراق صعب

145
00:13:19,690 --> 00:13:20,650
...ولكن

146
00:13:20,940 --> 00:13:23,570
!أولويّتي الآن هي القتال خلال هذه الحرب

147
00:13:31,990 --> 00:13:33,790
!الوداع يا تالغيس

148
00:13:42,670 --> 00:13:45,630
!فلترقدي بسلام يا صديقتي الجديرة

149
00:13:57,390 --> 00:13:58,980
!لقد دمّر نفسه؟

150
00:13:58,980 --> 00:14:00,560
هل سيستسلم؟

151
00:14:00,560 --> 00:14:02,440
!لن أقبل بهذا

152
00:14:07,450 --> 00:14:08,950
.فهمت

153
00:14:08,950 --> 00:14:11,370
.إنّه يريد الانتقال إلى الجناح صفر

154
00:14:12,490 --> 00:14:15,160
.لقد فقدت رشدك أخيرًا يا كونت البرق

155
00:14:18,670 --> 00:14:21,210
.أنا أغيّر هدف الدّمى المتنقّلة

156
00:14:21,210 --> 00:14:22,040
...بل وأفضل

157
00:14:22,800 --> 00:14:26,510
لماذا لا أعطيه ميتة مناسبة أكثر؟

158
00:14:33,220 --> 00:14:37,480
بمجرّد أن تلتقي بخالقك، فعليك أن تلعن
!نفسك على حكمك المتفائل هذا

159
00:14:45,780 --> 00:14:47,570
.تقرير من الفزّاعة 5

160
00:14:47,570 --> 00:14:48,860
!تمّت المهمّة

161
00:14:49,450 --> 00:14:52,160
...لقد فجّرنا الجناح صفر وتالغيس

162
00:14:52,160 --> 00:14:54,830
.كما أعدمنا زيكس ماركيز أيضًا

163
00:15:03,540 --> 00:15:07,090
.ومع ذلك، أراكم قد استخففتم بالجناح صفر

164
00:15:26,650 --> 00:15:29,360
!يا له من وقت استجابة مذهل

165
00:15:30,110 --> 00:15:31,570
!ويا لروعة القدرات القتاليّة هذه

166
00:15:49,090 --> 00:15:52,930
على المحارب المثاليّ مثلك
أن يقدر على تجنّب

167
00:15:52,930 --> 00:15:55,550
.التّعرّض للخداع من طرف تلك الآلة المكروهة

168
00:15:56,350 --> 00:16:00,890
أتمنّى أن يكون الطّريق الّذي سلكته
...هو الصّائب يا زيكس

169
00:16:00,890 --> 00:16:02,270
.بل... يا ملياردو

170
00:16:02,730 --> 00:16:07,110
أنت هو نجل بيسكرافت المناسب
.لقيادة النّاس للسّلام

171
00:16:14,820 --> 00:16:16,240
نموذج جديد؟

172
00:16:16,780 --> 00:16:19,370
.نعم، وقد أطلقتُ عليها اسم إبيون

173
00:16:19,370 --> 00:16:22,250
تملك هذه البذلة القدرة على أن تُريَ الطّيّار

174
00:16:22,250 --> 00:16:25,790
.صورة العدوّ الّذي يقاتله ومستقبل الطّيّار

175
00:16:26,340 --> 00:16:30,010
للأسف، لم يكن هناك أيّ مستقبل
.بالنّسبة لي لأختار منه

176
00:16:30,010 --> 00:16:34,130
،إن قدتَ هذه البذلة وانتهى بك المطاف مثلي

177
00:16:34,130 --> 00:16:36,640
.فدعنا نتخلّى عن حياتنا معًا

178
00:16:37,300 --> 00:16:39,350
لماذا صنعت هذا الشّيء؟

179
00:16:40,060 --> 00:16:44,850
لطالما ظننت أنّ البشر يشعرون
.بوجودهم من خلال المعارك المستمرّة

180
00:16:44,850 --> 00:16:47,900
ومع ذلك، لم أتمكّن من التّوصّل
.إلى أيّ استنتاجات

181
00:16:47,900 --> 00:16:50,320
.انتهت معركتي الآن

182
00:16:50,730 --> 00:16:53,740
.لكن ما زلت لم أعثر على السّبب للقتال

183
00:16:54,450 --> 00:16:59,700
،للعثور على ذلك السّبب
.فكّرت في أنّ الغاندام هي الأنسب

184
00:16:59,950 --> 00:17:04,410
بالإضافة إلى ذلك، أودّ منح بركاتي
.لكلّ من الفائزين والخاسرين

185
00:17:04,410 --> 00:17:07,290
.وتسمح لي هذه البذلة بفعل ذلك

186
00:17:07,290 --> 00:17:09,250
هل تدّعي أنّك بنيت إلهًا أو ما شابه؟

187
00:17:10,590 --> 00:17:11,800
.ربّما أكون قد فعلت

188
00:17:11,800 --> 00:17:17,680
،طالما أنّ المحارب لديه إرادة حقيقيّة للقتال
.فستقضي إبيون على كلّ أشكال الإلهاء

189
00:17:18,350 --> 00:17:21,220
لا يوجد شيء أكثر نُبلاً وجمالاً
.من محارب بدون أيّ إلهاءات

190
00:17:21,770 --> 00:17:25,390
.يمكن للمرء أن يقول أنّه أقرب ما أمكن للإله

191
00:17:26,190 --> 00:17:28,060
.لا أؤمن بوجود إله

192
00:17:28,400 --> 00:17:32,480
!أرني قدراتك في المعارك في مستقبلك

193
00:17:52,000 --> 00:17:53,090
.هيرو يوي

194
00:17:53,090 --> 00:17:55,340
.عليّ تحذيرك من شيء واحد

195
00:17:55,340 --> 00:17:57,970
.لا يجب أن تكون فائزًا عندما تقود تلك البذلة

196
00:17:58,590 --> 00:18:01,220
.الغاندام إبيون ليست سلاحًا

197
00:18:01,220 --> 00:18:03,930
.أتمنّى أن تعود كخاسر

198
00:18:04,310 --> 00:18:06,140
.أتمنّى نفس الشّيء

199
00:18:06,140 --> 00:18:10,610
.هيرو، لن أسمح لك بالموت إلى أن تقتلني أوّلاً

200
00:18:11,190 --> 00:18:13,570
.لقد أبطلت خاصيّة التّدمير الذّاتيّ

201
00:18:36,170 --> 00:18:37,220
!سُحقًا

202
00:18:37,220 --> 00:18:38,630
!هنالك العديد منها

203
00:18:39,010 --> 00:18:40,430
...ديرمايل

204
00:18:40,430 --> 00:18:42,600
!لقد أرسل قوّات إضافيّة

205
00:18:45,850 --> 00:18:47,020
!لا تستسلموا

206
00:18:47,020 --> 00:18:48,520
!النّتيجة غير مهمّة

207
00:18:48,850 --> 00:18:50,980
!المهمّ هو مواصلة القتال

208
00:18:51,610 --> 00:18:54,690
!جسم فائق السّرعة يقترب من الخلف

209
00:18:54,690 --> 00:18:55,530
المزيد من القوّات؟

210
00:19:15,550 --> 00:19:16,800
!ما هذه؟

211
00:19:16,800 --> 00:19:18,050
!أهي غاندام؟

212
00:19:18,470 --> 00:19:20,510
!إنّها غير مسجّلة! لا وجود لها في بياناتنا

213
00:19:39,950 --> 00:19:40,700
!مهلاً

214
00:19:40,700 --> 00:19:42,740
هل هي حليفة لنا؟

215
00:19:51,500 --> 00:19:52,330
!ها هي ذي

216
00:20:01,630 --> 00:20:03,390
أهم أعداء؟

217
00:20:03,390 --> 00:20:06,300
.كلاّ، لقد أُمروا بالقتال فحسب

218
00:20:06,300 --> 00:20:08,140
!هجوم

219
00:20:09,930 --> 00:20:12,520
إذًا هل هم العدوّ؟

220
00:20:12,520 --> 00:20:13,310
...كلاّ

221
00:20:20,860 --> 00:20:22,030
...الأمر سيّان

222
00:20:22,650 --> 00:20:24,780
.إنّها مثل الجناح صفر

223
00:20:32,210 --> 00:20:33,830
.سأتخلّص منهم جميعًا

224
00:20:35,540 --> 00:20:38,710
!كلّ من يقاتل عدوّ لي

225
00:21:00,780 --> 00:21:01,650
.هيرو

226
00:21:01,650 --> 00:21:02,990
.أريدك أن تعدني

227
00:21:03,740 --> 00:21:05,410
.احم السّيّد تيريز

228
00:21:05,410 --> 00:21:06,450
.أتوسّل إليك

229
00:21:12,750 --> 00:21:16,460
للأسف، لم يكن هناك أيّ مستقبل
.بالنّسبة لي لأختار منه

230
00:21:17,750 --> 00:21:20,090
...مستقبلي

231
00:21:20,590 --> 00:21:21,710
...موتي

232
00:21:43,280 --> 00:21:45,570
هل ترى مستقبلك؟

233
00:21:49,450 --> 00:21:50,530
...فهمت

234
00:21:51,700 --> 00:21:53,370
.لنبدأ إذًا

235
00:21:57,960 --> 00:21:59,000
...تيريز

236
00:21:59,500 --> 00:22:02,920
...لا أملك الحقّ للقيام بذلك

237
00:23:32,260 --> 00:23:37,890
،للرّدّ على الضّغط المتزايد من رومفلر
.ينطلق كاتر لاستعادة صخرة الرّمال

238
00:23:37,890 --> 00:23:43,560
،يذهب زيكس للقاء ووفي الّذي عاد لمستعمرته
.آملاً أن ينضمّ لصفوف طيّاري الغاندام

239
00:23:44,310 --> 00:23:48,690
لكن مرّة أخرى، يظنّ ووفي الّذي اُختير
لقيادة الغاندام ألترون المنتهية

240
00:23:48,690 --> 00:23:52,360
.أنّ زيكس عدوّ له ويبدأ بمهاجمته

241
00:23:52,910 --> 00:23:56,240
،"في الحلقة 35 من "جناح الغاندام

242
00:23:56,240 --> 00:23:57,740
."عودة ووفي"