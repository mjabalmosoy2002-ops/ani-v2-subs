1
00:00:00,500 --> 00:00:03,940
كان سو-تشان يتصرّف بغرابة مؤخراً

2
00:00:03,940 --> 00:00:04,900
غرابة" كيف؟"

3
00:00:05,200 --> 00:00:09,690
يظلّ يطري عليّ بينما يظلّ شارداً في مكان ما

4
00:00:10,270 --> 00:00:11,430
ماذا ينبغي أن أفعل؟

5
00:00:13,360 --> 00:00:14,530
...ماذا ينبغي

6
00:00:19,560 --> 00:00:22,280
!أخبرني أين هي بالضبط فحسب؟

7
00:00:22,280 --> 00:00:23,210
!لا أستطيع

8
00:00:23,580 --> 00:00:26,130
!لا ينبغي أن تراها الآن

9
00:00:26,130 --> 00:00:28,000
!أتعتقد أنّه يحقّ لك القرار؟

10
00:00:28,270 --> 00:00:29,750
حسناً، إيقاف

11
00:00:35,290 --> 00:00:37,260
هذا النصّ مضرّ بمعدتي

12
00:02:20,470 --> 00:02:22,810
سو-تشان، هل تؤلمك معدتك؟

13
00:02:22,810 --> 00:02:24,970
أنا بخير. لا شيء

14
00:02:26,170 --> 00:02:28,920
بالمناسبة يا تاماكي-كن، أنت ممثّل بارع

15
00:02:28,920 --> 00:02:30,200
حقاً؟

16
00:02:30,200 --> 00:02:32,530
أجل، أنت بارع جداً

17
00:02:32,530 --> 00:02:34,550
أتفاجأ كلّما قمنا بالتصوير

18
00:02:36,550 --> 00:02:41,930
تاماكي-كن، هل تتذكّر الموافقة على خروجنا
معاً في يوم عطلتنا؟

19
00:02:42,140 --> 00:02:44,800
أجل. هل استجدّ شيء؟

20
00:02:44,800 --> 00:02:46,680
لا، الأمر ليس كذلك

21
00:02:47,180 --> 00:02:50,160
ثمّة شيء مهمّ أريد أن أخبرك به

22
00:02:50,160 --> 00:02:52,900
ماذا؟ هل سوف تشتكي؟

23
00:02:52,900 --> 00:02:54,660
وفي يوم عطلتنا تحديداً؟

24
00:02:54,660 --> 00:02:56,250
مُحال أن أفعل ذلك

25
00:02:57,320 --> 00:02:59,880
أريد أن أحظى بمحادثة هادئة ولطيفة

26
00:03:00,940 --> 00:03:03,600
لا أستطيع إخفاء ذلك للأبد

27
00:03:03,600 --> 00:03:05,970
يجب أن أخبره حول أيا-تشان

28
00:03:07,480 --> 00:03:08,540
هذه المرّة

29
00:03:08,540 --> 00:03:10,720
!لماذا أخفيت الأمر؟

30
00:03:11,710 --> 00:03:14,000
وثقتُ بك

31
00:03:14,000 --> 00:03:15,210
!ما-ماذا؟

32
00:03:16,020 --> 00:03:17,960
أنا أتمرّن على مشهدنا التالي

33
00:03:21,860 --> 00:03:23,720
سأشتري شيء أشربه

34
00:03:30,790 --> 00:03:32,090
تفضّل

35
00:03:32,750 --> 00:03:35,230
شكراً لك

36
00:03:35,970 --> 00:03:38,720
أنت سوغو-كن من آيدوليش 7، أليس كذلك؟

37
00:03:39,300 --> 00:03:41,020
أجل

38
00:03:41,020 --> 00:03:42,490
!سو-تشان

39
00:03:42,900 --> 00:03:44,030
أنا قادم معك

40
00:03:45,060 --> 00:03:47,400
صباح الخير

41
00:03:47,400 --> 00:03:50,340
أنت تاماكي-كن من آيدوليش 7

42
00:03:50,340 --> 00:03:51,330
خذ هذا

43
00:03:51,330 --> 00:03:52,000
شكراً

44
00:03:54,790 --> 00:03:55,500
ماذا؟

45
00:03:55,500 --> 00:03:59,740
تشبه ابنتي بعض الشيء

46
00:03:59,740 --> 00:04:01,850
ابنتك؟

47
00:04:01,850 --> 00:04:04,360
أجل. إنها فتاة ظريفة ومهذّبة

48
00:04:04,360 --> 00:04:06,200
إنّها متّزنة وناضجة

49
00:04:06,200 --> 00:04:09,970
أنت بعيد كلّ البعد عن أبي

50
00:04:09,970 --> 00:04:11,830
هل تعمل لصالح المحطّة التلفزيونيّة؟

51
00:04:11,830 --> 00:04:15,480
لا. أتيتُ لمشاهدة ابني يعمل اليوم

52
00:04:15,480 --> 00:04:17,020
لديك ابن أيضاً؟

53
00:04:17,020 --> 00:04:20,990
أجل. يعمل مع البالغين هنا بتفانٍ

54
00:04:20,990 --> 00:04:22,350
أنا فخور به

55
00:04:22,870 --> 00:04:24,740
أنت فخور بابنك؟

56
00:04:25,260 --> 00:04:27,520
لا بدّ أنه أمر جيّد

57
00:04:28,520 --> 00:04:31,510
أن يمتلك الابن فتى مثلك

58
00:04:36,350 --> 00:04:37,830
!حسناً

59
00:04:37,830 --> 00:04:38,860
عُلم

60
00:04:38,860 --> 00:04:39,850
...أوساكا

61
00:04:39,850 --> 00:04:42,060
كما في أوساكا في "ف.س.سي"؟

62
00:04:43,060 --> 00:04:45,470
أجل. ماذا في ذلك؟

63
00:04:45,730 --> 00:04:47,850
أعرف شخصاً من أوساكا

64
00:04:47,850 --> 00:04:50,100
كان شابّاً في فرقة موسيقيّة

65
00:04:51,720 --> 00:04:54,660
توفّي قبل سنوات قليلة

66
00:04:54,660 --> 00:04:57,440
هل تعرف أوساكا ساتوشي؟

67
00:04:57,440 --> 00:04:59,150
!تعرف عمّي؟

68
00:05:01,240 --> 00:05:03,120
سو-تشان، هيّا بنا

69
00:05:03,120 --> 00:05:04,720
...حسناً

70
00:05:04,720 --> 00:05:06,040
وداعاً

71
00:05:08,910 --> 00:05:12,410
هذا صحيح. كنتُ أعرفه

72
00:05:14,410 --> 00:05:19,000
كان رجلاً عاديّاً يفتقر موهبة التفوّق على زيرو

73
00:05:19,980 --> 00:05:23,420
بخلاف عزيزي تين

74
00:05:23,860 --> 00:05:26,460
كوجو-سان، أين كنت؟

75
00:05:27,450 --> 00:05:28,680
في الأرجاء

76
00:05:29,090 --> 00:05:33,680
تين، أنت نجم سيغيّر العالم كاسم وكحقيقة

77
00:05:35,310 --> 00:05:40,690
كنتُ أبحث عن النجم الذي سيتفوّق على زيرو

78
00:05:41,210 --> 00:05:44,940
كنتُ محقّاً عندما وجدتُك

79
00:05:45,430 --> 00:05:47,450
أعلّق آمالاً كبيرة عليك في المستقبل

80
00:05:47,750 --> 00:05:50,050
زيرو هو أثرٌ من الماضي

81
00:05:50,050 --> 00:05:53,950
لا تدع أداء الشوارع أو الكتابات على الجدران تزعجك

82
00:05:54,910 --> 00:05:56,210
شكراً لك

83
00:06:00,620 --> 00:06:02,160
أتفوّق على زيرو؟

84
00:06:02,970 --> 00:06:09,720
عندما أحقّق هذا الحلم أخيراً، هل ستكون سعيداً حقّاً؟

85
00:06:11,650 --> 00:06:12,680
يا شباب

86
00:06:12,680 --> 00:06:14,260
حصلنا على هديّة

87
00:06:15,640 --> 00:06:18,520
فواكه كثيرة

88
00:06:18,730 --> 00:06:19,810
من أرسل الهديّة؟

89
00:06:19,810 --> 00:06:23,910
أرسلته فرقة ري:فالي لنا لدرسنا الأخير

90
00:06:24,790 --> 00:06:26,450
سأحضر شوكاً

91
00:06:27,050 --> 00:06:31,730
ري:فالي متواضعون جداً رغم كونهم نجوماً كباراً

92
00:06:31,730 --> 00:06:34,550
ورغم أنّهم يعيشون ظروفاً صعبة الآن

93
00:06:34,550 --> 00:06:37,640
...مشكلات صوت مومو-سان، رسالة التهديد

94
00:06:38,200 --> 00:06:39,630
إنّهم في موقف صعب جدّاً

95
00:06:39,630 --> 00:06:41,470
آمل أن يكون مومو-سان بخير

96
00:06:41,470 --> 00:06:43,250
آمل أن أتمكّن من فعل شيء لأجله

97
00:06:44,020 --> 00:06:47,160
أهو شريك يوكي القديم في نهاية المطاف؟

98
00:06:47,160 --> 00:06:48,880
لكن ألم يعد هذا في الماضي الآن؟

99
00:06:53,780 --> 00:06:56,470
مرحى! مرحى!" بهذا الشكل؟"

100
00:06:56,710 --> 00:07:01,970
،إذا ذكّرناهما بأغنيتهم الخالدة
سيتذكّرون الرّابط بينهم

101
00:07:04,710 --> 00:07:06,780
أغنيتهم الخالدة؟

102
00:07:10,690 --> 00:07:12,030
!لديّ فكرة جيّدة

103
00:07:12,570 --> 00:07:14,500
يا شباب، أصغوا جيّداً

104
00:07:17,040 --> 00:07:18,330
هذه فكرة سديدة

105
00:07:18,330 --> 00:07:19,200
أجل

106
00:07:19,200 --> 00:07:20,080
لنفعلها

107
00:07:20,080 --> 00:07:22,410
ريكو، فكرة ممتازة

108
00:07:22,410 --> 00:07:25,630
تستطيع كلّ مجموعة التركيز على ذلك أثناء التّمرين

109
00:07:25,880 --> 00:07:28,300
!لنفعل ذلك فوراً

110
00:07:28,560 --> 00:07:30,020
!أجل

111
00:07:37,800 --> 00:07:40,410
حسناً. لنأخذ استراحة

112
00:07:40,410 --> 00:07:42,880
حسناً. سأحضر شيئاً للشرب

113
00:07:42,880 --> 00:07:44,210
هذا ساخن جداً

114
00:07:44,210 --> 00:07:46,090
سو-تشان، هلّا أعطيتني منشفتك؟

115
00:07:46,090 --> 00:07:46,840
بالتأكيد

116
00:07:46,840 --> 00:07:48,550
تاماكي-كن، هل تريد شراباً رياضياً؟

117
00:07:48,550 --> 00:07:49,400
أجل

118
00:07:49,400 --> 00:07:50,470
وأنت يا تسوناشي-سان؟

119
00:07:50,470 --> 00:07:51,560
ماء لو سمحت

120
00:07:56,990 --> 00:07:57,740
!لا تفعل

121
00:07:58,810 --> 00:08:00,940
...إن لم يكن ماء، فأي شيء ينفع

122
00:08:04,740 --> 00:08:08,120
لديّ منه أيضاً

123
00:08:08,630 --> 00:08:13,880
أمّي المتوفّاة صنعته لي ولأيا

124
00:08:14,510 --> 00:08:17,190
من أين لك هذه يا سو-تشان؟

125
00:08:18,950 --> 00:08:20,470
هل رأيت أيا؟

126
00:08:20,910 --> 00:08:22,390
تاماكي-كن، ثمّة سبب وراء ذلك

127
00:08:22,390 --> 00:08:23,470
!هل رأيتها؟

128
00:08:24,620 --> 00:08:27,560
متى؟ أين؟

129
00:08:29,290 --> 00:08:32,150
!لماذا لم تخبرني؟

130
00:08:32,150 --> 00:08:33,190
!لا أعلم

131
00:08:33,190 --> 00:08:35,600
التقيتُها مرّتين فقط في محطّة التلفزيون

132
00:08:35,600 --> 00:08:37,210
...لم أتمكّن أبداً من إيقافها

133
00:08:37,210 --> 00:08:38,800
!أهذا كلّ شيء حقّاً؟

134
00:08:38,800 --> 00:08:39,830
يكفي يا تاماكي-كن

135
00:08:39,830 --> 00:08:41,480
قالت أنها لا تستطيع رؤيتك

136
00:08:41,480 --> 00:08:42,080
!ماذا؟

137
00:08:42,320 --> 00:08:43,880
!هذا ما أخبرتني به

138
00:08:44,790 --> 00:08:46,420
...هناك سبب يمنعها من ذلك

139
00:08:46,420 --> 00:08:49,200
!لكن لماذا أخفيت الأمر؟

140
00:08:49,200 --> 00:08:51,560
!لماذا لم تخبرني بالضبط؟

141
00:08:52,370 --> 00:08:56,890
!تعرف أكثر من الجميع أنّني أبحث عنها

142
00:08:56,890 --> 00:08:58,300
!هذا لأنّني أعلم

143
00:08:58,300 --> 00:09:01,740
!لم أرد الحديث عن الأمر فجأة وإزعاجك

144
00:09:04,680 --> 00:09:08,200
إذا تخلّيت عن هذه التمثيليّة التي تتولّى
،بطولتها أثناء التصوير

145
00:09:08,200 --> 00:09:10,070
ستضرّ بسمعتك من جديد

146
00:09:10,440 --> 00:09:11,320
...لذلك أنا

147
00:09:11,940 --> 00:09:19,200
ظننت أنّني سأعتزل العمل ثانية إذا
سمعتُ عن أيا؟

148
00:09:19,440 --> 00:09:20,620
تاماكي-كن؟

149
00:09:20,620 --> 00:09:24,040
كنتُ أبلي بلاء حسناً

150
00:09:25,370 --> 00:09:31,140
كنتُ أفعل ما بوسعي كي لا أضايقك أو أتأخّر

151
00:09:31,760 --> 00:09:37,110
حتّى أنت قلت أنّني كنتُ أبلي بلاء حسناً

152
00:09:37,800 --> 00:09:38,690
...لكن مع ذلك

153
00:09:40,050 --> 00:09:42,470
لم تثق بي حقّاً؟

154
00:09:43,210 --> 00:09:48,540
ظننتَ أنّني سأعتزل العمل وأتوقّف
عن الإصغاء لك؟

155
00:09:49,450 --> 00:09:51,810
أهذا ما ظننتَه؟

156
00:09:55,430 --> 00:09:56,390
حسناً

157
00:09:57,420 --> 00:09:59,330
لنتابع الدرس

158
00:09:59,330 --> 00:10:00,240
ماذا؟

159
00:10:01,730 --> 00:10:05,420
لن أترك عملي. إنّه عملي

160
00:10:06,300 --> 00:10:08,750
حتّى لو رغبتُ في ضربك

161
00:10:09,830 --> 00:10:10,210
أنا آسف

162
00:10:10,210 --> 00:10:12,440
لكن سأعتزل ميتزو

163
00:10:12,440 --> 00:10:15,020
يمكنك مشاركة شخص تثق به

164
00:10:15,020 --> 00:10:16,530
أنت مخطئ. الأمر ليس كذلك

165
00:10:16,530 --> 00:10:19,840
لنتابع الدرس

166
00:10:19,840 --> 00:10:22,510
لن أرقص في هذه الأجواء

167
00:10:22,910 --> 00:10:24,140
أخي

168
00:10:24,420 --> 00:10:28,140
سوغو-كن، هلّا تركتنا لحظة؟

169
00:10:28,140 --> 00:10:28,980
...لكن

170
00:10:28,980 --> 00:10:32,230
لا بأس. دع الأمر لي

171
00:10:35,390 --> 00:10:37,540
ما الذي فعلتُه؟

172
00:10:38,510 --> 00:10:39,710
سوغو-سان؟

173
00:10:41,310 --> 00:10:44,610
ماذا حدث؟ سمعتُ صوت تاماكي

174
00:10:44,610 --> 00:10:47,500
سمعتُ صراخاً. هل حدث شيء؟

175
00:10:49,820 --> 00:10:50,970
ماذا حدث؟

176
00:10:52,410 --> 00:10:53,330
تاماكي-كن

177
00:10:53,860 --> 00:10:55,320
لقد سئمت

178
00:10:55,320 --> 00:10:57,880
سأعتزل كلّ شيء حالما ينتهي هذا العمل

179
00:10:58,320 --> 00:11:00,930
كلّاً من ميتزو وآيدوليش 7

180
00:11:00,930 --> 00:11:03,920
ماذا عن معجبيك وزملائك؟

181
00:11:03,920 --> 00:11:05,300
!لا يهمّني

182
00:11:05,300 --> 00:11:08,130
!لم أبدأ بفعل هذا إلّا لأجد أيا

183
00:11:08,130 --> 00:11:10,560
!الآن بعد أن وجدتُها، لا أحتاجهم

184
00:11:10,560 --> 00:11:14,110
!الناس لا يثقون بك لأنّك تقول كلاماً كهذا

185
00:11:16,320 --> 00:11:19,570
ليس سوغو-كن من يخرّب عملك الدّؤوب

186
00:11:19,910 --> 00:11:21,910
ألا تعتقد أنّ سلوكك هذا هو السّبب؟

187
00:11:21,910 --> 00:11:26,430
لكن رغم ذلك! عملتُ بجدّ

188
00:11:26,430 --> 00:11:27,860
،عملتُ ب جدّ

189
00:11:29,210 --> 00:11:32,210
وما زال لم يثق بي

190
00:11:32,920 --> 00:11:38,210
أردتُ فقط أن يقبلني سو-تشان

191
00:11:40,850 --> 00:11:41,970
...تاماكي-كن

192
00:11:42,290 --> 00:11:46,650
،عرفتُ أنّه لم يكن إعجابه بي صحيحاً

193
00:11:47,930 --> 00:11:52,550
لكن رأيتُ أنني إذا ضاعفتُ جهودي، فقد
يصبح ذلك حقيقة يوماً ما

194
00:11:52,550 --> 00:11:54,970
سأكون سعيداً جداً إذا حدث ذلك

195
00:11:56,490 --> 00:12:01,990
لكن لا يزال سو-تشان يعتبرني عديم الجدوى

196
00:12:03,770 --> 00:12:11,480
مهما فعلت، مهما بذلتُ من جهد، يظلّ
ينظر إليّ تلك النظرة

197
00:12:12,680 --> 00:12:15,370
ألا يمكن قول نفس الكلام عنك؟

198
00:12:15,370 --> 00:12:16,030
ماذا؟

199
00:12:16,890 --> 00:12:22,350
تعتقد أنّه لن يفهمك أبداً بعد خلاف واحد

200
00:12:23,120 --> 00:12:27,600
لعلّ سوغو-كن فعل ما بوسعه ليفهمك

201
00:12:28,980 --> 00:12:31,730
لا يوجد أعضاء فرقة متوافقون تماماً من البداية

202
00:12:32,730 --> 00:12:35,110
فقط بفهم بعضهم الآخر رويداً رويداً

203
00:12:35,110 --> 00:12:37,150
يصبحون أفضل شركاء

204
00:12:38,090 --> 00:12:39,710
كنّا نفس الشيء

205
00:12:41,670 --> 00:12:42,990
حتّى تريغر؟

206
00:12:42,990 --> 00:12:47,510
أجل. لطالما كانت الأجواء متوتّرة بيننا
في غرف استراحتنا في البداية

207
00:12:47,510 --> 00:12:49,560
كنتُ أتنهّد بمفردي كلّ يوم

208
00:12:50,210 --> 00:12:52,840
اشتقتُ لأصدقائي حقّاً في الدّيار

209
00:12:52,840 --> 00:12:54,860
وهل الأمور مختلفة الآن؟

210
00:12:56,250 --> 00:12:58,540
كيف نبدو لك؟

211
00:13:01,970 --> 00:13:06,380
إذاً تلك القصّة التي حدّثتني عنها حول
رجال الإطفاء كانت عن تاماكي

212
00:13:06,380 --> 00:13:08,960
لماذا لم تخبر تاما؟

213
00:13:08,960 --> 00:13:11,260
أنت شريكه، أليس كذلك؟

214
00:13:11,260 --> 00:13:12,840
أنا آسف

215
00:13:12,840 --> 00:13:15,630
كان سوغو-سان يحاول فعل ما بوسعه
...لأجل تاماكي فحسب

216
00:13:15,630 --> 00:13:16,980
ريكو، اصمت

217
00:13:17,800 --> 00:13:20,440
عليك أن تتعلّم الاستناد على الناس يا سو

218
00:13:20,440 --> 00:13:22,960
،إنه ليس غاضباً لأنك لم تخبره

219
00:13:23,380 --> 00:13:26,100
إنه حزين لأنّك لم تستطع

220
00:13:26,100 --> 00:13:29,200
ألا تعتبرنا أصدقاءك؟

221
00:13:29,200 --> 00:13:30,580
—هذا ليس

222
00:13:30,820 --> 00:13:34,450
علمَ تاما أنّك كنت تخفي شيئاً

223
00:13:34,700 --> 00:13:35,460
ماذا؟

224
00:13:35,770 --> 00:13:38,220
ظنّ أنّ شيئاً حدث مع عائلتك

225
00:13:38,220 --> 00:13:39,890
كان قلقاً عليك

226
00:13:40,400 --> 00:13:41,460
كان؟

227
00:13:42,350 --> 00:13:46,550
يفكّر تاما بك أكثر بكثير ممّا تعتقد

228
00:13:47,570 --> 00:13:54,350
بما أنّه لم يكن مقرّباً من عائلته، يعتبرك
أخاً له وجزءاً من عائلته

229
00:13:55,230 --> 00:13:56,260
...عائلة

230
00:13:57,430 --> 00:13:58,800
فهمت

231
00:13:58,800 --> 00:14:03,690
بما أنّك لطيف جداً ومُعين، فأنت بمثابة
أخ أكبر بالنسبة لي أيضاً

232
00:14:04,240 --> 00:14:09,140
كيف؟ أنت من النوع المكتفي ذاتياً يا سو

233
00:14:09,140 --> 00:14:10,740
وكذلك أنا على ما أعتقد

234
00:14:11,020 --> 00:14:13,610
أنت متيقّظ ومتأهّب دوماً

235
00:14:13,610 --> 00:14:16,640
هذه نقطة قوّتك الفريدة

236
00:14:16,640 --> 00:14:23,550
لكن عندما يتعلّق الأمر بنا وبتاما، ليس
عليك أن تكون حذراً

237
00:14:23,550 --> 00:14:27,610
بدلاً من فعل كلّ شيء بمفردك، أخبرنا عن الأمر

238
00:14:27,610 --> 00:14:29,340
هل نحن غير موثوقين إلى هذا الحدّ؟

239
00:14:29,800 --> 00:14:34,640
...كنتُ أخشى أن أزعج أو أؤذي أحداً

240
00:14:34,890 --> 00:14:38,840
لا عليك. اعتمادك عليّ يسعدني

241
00:14:38,840 --> 00:14:40,600
نفس الأمر ينطبق على ريكو وتاما

242
00:14:40,600 --> 00:14:41,530
!أجل

243
00:14:41,530 --> 00:14:43,390
لستَ وحيداً

244
00:14:43,390 --> 00:14:47,700
أنت سِبع من آيدوليش 7 ونصف ميتزو

245
00:14:52,140 --> 00:14:53,000
معك حقّ

246
00:14:55,690 --> 00:15:00,250
عليّ تحمّل مسؤولية أذيّة تاماكي-كن

247
00:15:01,920 --> 00:15:03,000
...عمّي

248
00:15:03,390 --> 00:15:07,600
كيف ألّفت الموسيقى مع زملائك في الفرقة؟

249
00:15:09,250 --> 00:15:13,260
ما الذي يعنيه الاعتماد على الناس؟ امتلاك أصدقاء؟

250
00:15:15,050 --> 00:15:17,490
إذا جلستُ هنا أقلق على ذلك، سأعود
لكوني مكتفياً ذاتياً

251
00:15:17,490 --> 00:15:18,570
يجب أن أتغيّر

252
00:15:19,090 --> 00:15:21,020
لا يمكنني عيش حياتي وحيداً

253
00:15:26,110 --> 00:15:27,190
نعم؟

254
00:15:27,190 --> 00:15:29,800
أريد أن نتكلّم. هلّا أعطيتني من وقتك قليلاً؟

255
00:15:29,800 --> 00:15:33,510
مهما قلت الآن، هذا لن يغيّر شيئاً

256
00:15:33,510 --> 00:15:35,380
هل أنت متأكّد أنك لن تفتح الباب؟

257
00:15:39,100 --> 00:15:40,210
حسناً

258
00:15:47,530 --> 00:15:49,350
!ما-ماذا تفعل يا سو-تشان؟

259
00:15:49,350 --> 00:15:50,380
—هل تكسر الـ

260
00:15:52,610 --> 00:15:55,300
آسف لتحطيم بابك

261
00:15:56,690 --> 00:15:58,330
سأسدّد ثمنه لاحقاً

262
00:15:58,330 --> 00:16:03,540
هـ-هل أنت متأكّد أنك لست متطرّفاً ما
بدلاً من فتى ثريّ؟

263
00:16:04,210 --> 00:16:05,770
أنا هنا لأنّ لديّ طلب

264
00:16:05,980 --> 00:16:06,730
طلب؟

265
00:16:06,960 --> 00:16:08,940
لا تفكّك ميتزو من فضلك

266
00:16:08,940 --> 00:16:10,360
هل تهدّدني؟

267
00:16:10,360 --> 00:16:12,920
أعدك أننا سنجد أيا-تشان

268
00:16:12,920 --> 00:16:15,420
لذا هلّا أعدت النظر في الأمر؟

269
00:16:15,420 --> 00:16:17,760
ستجدها؟ كيف؟

270
00:16:17,760 --> 00:16:19,110
سأفعل المستحيل

271
00:16:19,110 --> 00:16:21,540
أعدك أننا سنجدها غداً

272
00:16:21,540 --> 00:16:23,720
غداً؟

273
00:16:23,720 --> 00:16:27,670
تذكرت. هذا يوم العطلة الذي اتّفقنا على قضائه معاً

274
00:16:33,980 --> 00:16:35,320
!صباح الخير

275
00:16:35,320 --> 00:16:36,930
مرحباً

276
00:16:37,180 --> 00:16:39,850
شكراً على الهديّة قبل أيام

277
00:16:39,850 --> 00:16:42,700
أوصي بشدّة بالفاكهة من ذلك المكان

278
00:16:42,700 --> 00:16:43,310
هل كانت لذيذة؟

279
00:16:43,560 --> 00:16:45,290
جداً

280
00:16:45,290 --> 00:16:48,850
تاماكي وسوغو طلبا منّا أن نخبركما أنه كان لذيذاً أيضاً

281
00:16:48,850 --> 00:16:51,820
وطلب تاماكي المزيد كذلك

282
00:16:51,820 --> 00:16:54,240
روكويا-سان، أعتقد لست بحاجة لتخبرهما بذلك

283
00:16:54,690 --> 00:16:58,490
بما أنّها أعجبتكم إلى هذا الحدّ، فقد
كان ذلك جديراً إذاً

284
00:16:59,250 --> 00:17:01,120
هل أتيتم إلى هنا اليوم فقط لتشكرونا؟

285
00:17:01,120 --> 00:17:03,660
في الواقع أردنا مناقشة أمر معكما

286
00:17:04,230 --> 00:17:05,170
ما هو؟

287
00:17:05,170 --> 00:17:07,820
نريد أن يكون حفلنا السرّي مع تريغر

288
00:17:07,820 --> 00:17:10,440
الفصل الافتتاحي بدلاً من أن يكون أثناء الحدث

289
00:17:11,360 --> 00:17:12,860
لا مانع لدينا بشأن ذلك

290
00:17:12,860 --> 00:17:15,630
ألن يكون من الوقاحة جعل حفلكم السرّي
في الفصل الافتتاحي؟

291
00:17:15,630 --> 00:17:17,150
لا تقلق بشأن ذلك

292
00:17:17,150 --> 00:17:19,030
هل هذا يعني أنّكما موافقان؟

293
00:17:19,030 --> 00:17:21,040
بالتأكيد. سنبلغ الطاقم

294
00:17:22,690 --> 00:17:25,050
لدينا سؤال آخر

295
00:17:25,050 --> 00:17:25,770
إيوري؟

296
00:17:26,100 --> 00:17:28,950
إنه بخصوص شريك يوكي-سان

297
00:17:28,950 --> 00:17:30,900
ما هو؟

298
00:17:31,200 --> 00:17:33,340
اختفى شريكك

299
00:17:33,340 --> 00:17:37,160
لأنّه تقرّب منكما مُنتج عدوانيّ، صحيح؟

300
00:17:37,160 --> 00:17:38,240
صحيح

301
00:17:38,240 --> 00:17:41,910
إن لم يكن لديك مانع، هلّا قلت لنا ما اسمه؟

302
00:17:42,200 --> 00:17:43,890
قد يساعدنا هذا في اكتشاف شيء

303
00:17:44,810 --> 00:17:46,890
اسم المنتج كان

304
00:17:48,290 --> 00:17:49,130
كوجو

305
00:17:49,420 --> 00:17:50,460
كوجو؟

306
00:17:50,810 --> 00:17:51,470
ماذا؟

307
00:17:51,930 --> 00:17:55,510
كوجو؟ تقصد والد تين الحالي؟

308
00:17:55,780 --> 00:17:59,050
الرجل الذي أخذ تين-ني منّا؟

309
00:17:59,350 --> 00:18:01,550
أجل، بذاته

310
00:18:02,100 --> 00:18:04,740
،لم يكن متلائماً معنا تماماً

311
00:18:04,740 --> 00:18:08,060
لكن يبدو أنّه يتلاءم جيداً مع تين-كن الكامل

312
00:18:08,460 --> 00:18:11,940
يوكي-سان، لماذا لم تختر العمل مع كوجو-سان؟

313
00:18:12,310 --> 00:18:15,630
كوجو شخصٌ مبتسم، لكنه شديد

314
00:18:16,430 --> 00:18:19,330
لا، كلمة "شديد" لا تكفي لوصفه

315
00:18:19,330 --> 00:18:20,910
بل هو أقرب إلى رجل مهووس

316
00:18:20,910 --> 00:18:22,450
مهووس؟

317
00:18:22,450 --> 00:18:23,990
...تلك الإصابة

318
00:18:26,730 --> 00:18:33,480
أعتقد كوجو من دبّرها كي يستحوذ علينا

319
00:18:33,930 --> 00:18:35,220
...مستحيل

320
00:18:36,410 --> 00:18:39,470
لماذا يثق تين-ني بشخص مثله؟

321
00:18:39,890 --> 00:18:41,210
توخّوا الحذر

322
00:18:41,840 --> 00:18:44,060
لديه جانب مظلم

323
00:18:46,680 --> 00:18:49,110
،أعتذر عن فعل هذا الآن

324
00:18:49,110 --> 00:18:51,940
لكن تلقّينا تعليمات في اللحظات الأخيرة من الداعم

325
00:18:51,940 --> 00:18:54,210
الداعم؟ تقصد ف.س.سي؟

326
00:18:54,210 --> 00:18:55,320
أجل

327
00:18:55,320 --> 00:19:01,030
يريدونك أن تذكر هذا أثناء المحادثة في النهاية

328
00:19:01,030 --> 00:19:02,360
ما هذا؟

329
00:19:03,130 --> 00:19:05,200
لماذا يريدنا الداعم أن نفعل هذا؟

330
00:19:05,200 --> 00:19:06,900
ليتني أعلم ذلك أيضاً

331
00:19:06,900 --> 00:19:10,210
هذا ليس معايير شركة أو ما شابه، صحيح؟

332
00:19:12,140 --> 00:19:15,210
لا، ليست كذلك

333
00:19:15,210 --> 00:19:16,750
لا مشكلة. سنقولها

334
00:19:18,090 --> 00:19:20,260
إن كان هذا رأيك فحسناً يا ريو

335
00:19:25,620 --> 00:19:31,020
البثّ المباشر الخاص للغرفة السرّية
سوف ينتهي

336
00:19:31,360 --> 00:19:35,050
مهما فعلنا ذلك من مرّات، دائماً
ما يجعلني البثّ الحيّ متوتّراً

337
00:19:35,470 --> 00:19:38,610
،بما أنّ الطقس لا يزال بارداً في الخارج
فاحرصوا على أن تبقوا دافئين

338
00:19:38,610 --> 00:19:45,180
بالمناسبة، سمعتُ تاماكي-كن من آيدوليش 7
قد مرض بعد قبول سلسلة مفاتيح

339
00:19:45,180 --> 00:19:47,620
توخّوا الحذر جميعاً

340
00:19:47,620 --> 00:19:49,980
بعد قبول سلسلة مفاتيح؟

341
00:19:49,980 --> 00:19:50,660
ما معنى هذا؟

342
00:19:50,890 --> 00:19:53,830
هلّا امتنعت عن الغوص في هذا الموضوع
في فقرة الاختتام؟

343
00:19:54,130 --> 00:19:57,350
ربّما ذكّرته السلسلة بشيء ما

344
00:19:57,350 --> 00:20:00,260
أعتقد أنه مصاب بعدوى... العاطفة

345
00:20:01,460 --> 00:20:05,770
كما أعتقد أنّك مصاب بميول غاكو
لقول كلام محرج يا ريو

346
00:20:05,770 --> 00:20:07,930
هـ-هل كان ذلك محرجاً؟

347
00:20:07,930 --> 00:20:10,480
أبداً. كان رائعاً

348
00:20:10,480 --> 00:20:11,320
حقاً؟

349
00:20:11,730 --> 00:20:15,430
أعتقد سأحرص على ألّا أدع عادة
عاكو تنتقل لي أيضاً

350
00:20:15,430 --> 00:20:16,020
ماذا؟

351
00:20:16,260 --> 00:20:19,400
رفاق، لا تنسوا أن تغسلوا أيديكم
وتُغرغروا بالماء جيداً

352
00:20:19,400 --> 00:20:20,210
أنت

353
00:20:20,210 --> 00:20:22,330
نراكم في الأسبوع المقبل

354
00:20:25,470 --> 00:20:27,070
تاماكي-نيتشان؟

355
00:20:30,300 --> 00:20:32,080
مرض من سلسلة مفاتيح؟

356
00:20:32,620 --> 00:20:34,960
إنه ليس بخير؟ لماذا؟

357
00:20:35,250 --> 00:20:37,290
...ماذا أفعل؟ إنّ أخي

358
00:20:45,180 --> 00:20:46,680
!ما الذي يجري؟

359
00:20:46,680 --> 00:20:50,730
كنتُ أتساءل لماذا أحضرتني لرؤية
تريغر في يوم عطلتنا

360
00:20:50,730 --> 00:20:54,510
!ما كلّ هذا الهراء حول سلسلة مفاتيح ومرضي؟

361
00:20:54,510 --> 00:20:57,470
قد يؤدّي هذا إلى ظهور أيا-تشان

362
00:20:57,470 --> 00:20:59,520
كيف أقنعتهم بفعل ذلك حتّى؟

363
00:20:59,830 --> 00:21:01,270
...في الواقع

364
00:21:01,270 --> 00:21:04,110
تريدهم أن يناقشوا هذه المذكّرة أثناء
الحيّ المباشر؟

365
00:21:04,110 --> 00:21:07,090
راعي "ليلة سرّية" هو ف.س.سي

366
00:21:08,300 --> 00:21:10,470
الرئيس هو أبي

367
00:21:10,470 --> 00:21:12,080
هذا أمر منه

368
00:21:12,080 --> 00:21:14,620
سمعتُ أنك لم تنسجم معه

369
00:21:14,830 --> 00:21:17,000
ألا يتجادل الأطفال مع آبائهم طوال الوقت؟

370
00:21:17,610 --> 00:21:18,710
...لكن

371
00:21:18,710 --> 00:21:21,050
هذه تعليمات من داعمكم

372
00:21:21,460 --> 00:21:24,200
—لا تقلق. سأحرض على ألّا تقع في ورطة

373
00:21:26,110 --> 00:21:26,650
—لماذا

374
00:21:26,650 --> 00:21:29,230
!إلى أي درجة عقلك صغير؟

375
00:21:29,660 --> 00:21:32,510
!أنت غبيّ كشخص التحق بالكلّية

376
00:21:32,510 --> 00:21:33,150
!غبيّ؟

377
00:21:34,630 --> 00:21:36,350
هذا يكفي

378
00:21:37,740 --> 00:21:41,040
كانت تلك الرسالة لأيا-تشان، صحيح؟

379
00:21:41,040 --> 00:21:43,740
لكن لا أعلم لماذا قالوا أنّها كانت
تعليمات من داعمنا

380
00:21:43,990 --> 00:21:46,710
عائلة سو-تشان تدير ف.س.سي

381
00:21:46,710 --> 00:21:47,450
!تاماكي-كن

382
00:21:47,740 --> 00:21:49,700
ماذا؟ حقاً؟

383
00:21:49,960 --> 00:21:52,300
شكراً جزيلاً لكم على دعمكم

384
00:21:52,300 --> 00:21:55,330
لا، لقد تمّ التبرّؤ منّي ولا تربطني أي صلة بهم

385
00:22:01,130 --> 00:22:01,960
مرحباً؟

386
00:22:04,540 --> 00:22:05,160
ماذا؟

387
00:22:06,950 --> 00:22:07,990
حقاً؟

388
00:22:11,350 --> 00:22:12,100
!تاماكي-كن

389
00:22:12,370 --> 00:22:14,320
ماذا يجري مع ريو؟

390
00:22:14,320 --> 00:22:15,390
تأخّر

391
00:22:18,310 --> 00:22:19,400
المعذرة

392
00:22:19,740 --> 00:22:22,400
شكراً ثانية على هديّة أخرى

393
00:22:22,400 --> 00:22:23,770
لا عليك

394
00:22:23,770 --> 00:22:24,860
زورونا متى شئتم

395
00:22:28,580 --> 00:22:29,700
...ألم يكن ذلك

396
00:22:36,250 --> 00:22:37,460
!ني-تشان

397
00:22:38,420 --> 00:22:39,320
!أيا

398
00:23:55,590 --> 00:24:00,250
الحلقة القادمة