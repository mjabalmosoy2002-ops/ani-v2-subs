1
00:00:07,480 --> 00:00:10,730
ما الّذي يفعله هاتشيجو-سينباي كلّ يوم؟

2
00:00:13,150 --> 00:00:14,150
أردتِ التّحدّث معي؟

3
00:00:14,150 --> 00:00:14,950
.نعم

4
00:00:15,410 --> 00:00:15,990
ما الأمر؟

5
00:00:16,410 --> 00:00:18,780
!أريد أن أسألك شيئًا عن هاتشيجو-سينباي

6
00:00:18,780 --> 00:00:19,620
.أنت قريبة جدًّا

7
00:00:21,200 --> 00:00:22,450
حسنًا، ما الأمر؟

8
00:00:23,120 --> 00:00:28,210
هل تظنّ أنّ هاتشيجو-سينباي
سيأخذ سؤالي على محمل الجدّ؟

9
00:00:28,790 --> 00:00:30,130
تقصدين بيرد؟

10
00:00:30,460 --> 00:00:33,090
.إذًا فلا يهمّ إن كنتِ أنت من تسألين أو أحدًا آخر

11
00:00:33,970 --> 00:00:37,050
.ما يهمّ هو إن كان السّؤال يمتّعه أم لا

12
00:00:37,800 --> 00:00:40,850
لذلك أحتاج أن يكون السّؤال ممتعًا له، صحيح؟

13
00:00:41,350 --> 00:00:42,640
!اجعلني شريكتك رجاءً

14
00:00:42,640 --> 00:00:43,560
ماذا؟

15
00:00:43,560 --> 00:00:44,890
هل توافق؟

16
00:00:44,890 --> 00:00:47,150
.سأحصل على إذن من الأمن العامّ

17
00:00:47,150 --> 00:00:49,310
...لـ-لكنّ الرّئيسة سوف

18
00:00:49,570 --> 00:00:51,480
.لا علاقة لأختي بهذا

19
00:00:51,780 --> 00:00:53,440
.إنّه قراري أنا

20
00:00:53,440 --> 00:00:54,450
.حسنًا

21
00:00:54,740 --> 00:00:55,490
!مهلاً يا جيرو

22
00:00:56,360 --> 00:00:58,780
.أوّلاً، أريدكم أن تقوموا بشيء من أجلي

23
00:00:59,280 --> 00:01:02,750
...أعطوني لائحة بأعمال بيرد وتصاريحه وقراراته

24
00:01:03,040 --> 00:01:05,410
.كلّ شيء تعرفونه عنه

25
00:01:05,710 --> 00:01:07,920
.لا فكرة لي عمّا يفعله في حياته اليوميّة

26
00:01:10,590 --> 00:01:11,960
!أختي

27
00:01:11,960 --> 00:01:14,590
.سأذهب لإحضار العشاء

28
00:01:14,590 --> 00:01:15,970
!حسنًا

29
00:01:16,720 --> 00:01:20,100
...إذًا فقد كان هنا

30
00:01:24,560 --> 00:01:25,770
،في المستقبل

31
00:01:25,770 --> 00:01:29,350
عند حدوث شيء ما يتعذّر
،على الشّرطة العاديّة إنجازه

32
00:01:29,350 --> 00:01:32,480
."يلجؤون إلى قوّة مشروع "أكتيف

33
00:01:33,860 --> 00:01:38,820
،هذه هي قصّة "أكتيف" التّابع لليابان
.وحدة الهجوم المنتقل الثّالث

34
00:02:56,690 --> 00:03:00,030
،قال جيرو أنّه عندما عمل كجزء من لوغوس

35
00:03:00,030 --> 00:03:02,570
.كان يتمّ الاهتمام بأمور عدّة لم يكن يعرف بشأنها

36
00:03:02,950 --> 00:03:06,290
وبعدها قال ذلك الوغد أنّه إن كان
،بيرد يعمل مع إيناغي-سان

37
00:03:06,290 --> 00:03:08,580
...فسيكون ذلك منطقيًّا

38
00:03:09,290 --> 00:03:10,330
!هذه سخافة

39
00:03:10,790 --> 00:03:12,500
.ما كان إيناغي-سان ليقوم بذلك

40
00:03:14,000 --> 00:03:15,880
كيف هي الأوضاع بشأن اجتماع القمّة؟

41
00:03:16,170 --> 00:03:16,710
...أجل

42
00:03:17,250 --> 00:03:20,840
أيّها الحاكم، يبدو أنّه لن يتدخّل أحد بشكل عنيف

43
00:03:20,840 --> 00:03:22,680
.نظرًا لنسب تأييدك السّاحقة

44
00:03:23,090 --> 00:03:25,010
ماذا عن مصعد الفضاء؟

45
00:03:25,010 --> 00:03:26,600
.لا توجد مشاكل

46
00:03:26,600 --> 00:03:28,640
،إن نجح هذا الاختبار

47
00:03:28,640 --> 00:03:31,390
.سيصبح المشروع بين أيدينا بالفعل

48
00:03:31,390 --> 00:03:32,230
.فهمت

49
00:03:32,520 --> 00:03:33,730
.تابعوا العمل إذًا

50
00:03:33,730 --> 00:03:34,440
.حاضرة

51
00:03:35,270 --> 00:03:39,690
على هذا المعدّل، قد أستطيع
.زيادة سرعة خطّة تطوير المدينة

52
00:03:40,780 --> 00:03:41,780
أنت؟

53
00:03:41,780 --> 00:03:43,530
.مرحبًا أيّها الحاكم

54
00:03:43,530 --> 00:03:44,450
كيف حالك؟

55
00:03:44,700 --> 00:03:48,540
.طلبتُ منك ألاّ تتّصل بي

56
00:03:48,950 --> 00:03:51,410
!وذلك الرّمز خطير للغاية

57
00:03:51,410 --> 00:03:54,330
.لا تقلق. أخذت احتياطاتي

58
00:03:54,330 --> 00:03:56,590
.الأهمّ من هذا الآن، هو أنّ الأمور تسير على ما يرام

59
00:03:57,340 --> 00:03:59,460
إذًا فأنت تراقبني؟

60
00:03:59,460 --> 00:04:00,800
.لا تقلق

61
00:04:00,800 --> 00:04:02,800
.إنّه مجرّد إجراء وقائيّ

62
00:04:03,050 --> 00:04:06,970
أنت قلق من أنّ ارتباطنا
بسفارة كاروبانوبا لن يكون كافيًا؟

63
00:04:08,560 --> 00:04:10,020
الوقاية أمر مهمّ، أليس كذلك؟

64
00:04:10,390 --> 00:04:12,390
هل اتّصلت للتّحدّث بشأن أمر كهذا؟

65
00:04:12,390 --> 00:04:15,480
.آسف، آسف. سأدخل صلب الموضوع

66
00:04:15,850 --> 00:04:20,070
.خطّة تطوير مدينتك جميلة، لكنّها ليست ممتعة كثيرًا

67
00:04:20,070 --> 00:04:21,490
.لستُ مهتمًّا برأيك

68
00:04:21,490 --> 00:04:24,530
!لذلك فكّرتُ في هذه الخطّة بدل ذلك

69
00:04:24,530 --> 00:04:25,700
ما رأيك؟

70
00:04:28,990 --> 00:04:31,200
هذا جنون.... هل أنت جادّ؟

71
00:04:31,200 --> 00:04:32,700
هذا ممتع، صحيح؟

72
00:04:32,700 --> 00:04:33,910
!لا تعبث معي

73
00:04:33,910 --> 00:04:35,710
!أنت شيطان مجنون

74
00:04:35,710 --> 00:04:39,170
،وأنت بعت روحك لذلك الشّيطان
.لذلك لا يحقّ لك أن تشتكي

75
00:04:39,380 --> 00:04:44,800
،أعلم. فكّر في شيء ممتع أكثر
!وربّما سأتوقّف عن هذا

76
00:04:48,850 --> 00:04:49,640
!تشينجو

77
00:04:50,010 --> 00:04:51,140
هل أنت هنا يا تشينجو؟

78
00:04:51,970 --> 00:04:52,980
.المعذرة

79
00:04:53,560 --> 00:04:55,640
."احصل على الموافقة للغرض "بي

80
00:04:55,940 --> 00:04:57,150
.مفهوم

81
00:05:00,020 --> 00:05:01,570
...إن أردت

82
00:05:03,150 --> 00:05:04,280
.هيّا، تفضّل

83
00:05:05,400 --> 00:05:06,740
ما الّذي اكتشفته؟

84
00:05:06,990 --> 00:05:08,740
.سبق وأخبرتك مرارًا

85
00:05:08,740 --> 00:05:11,200
.يعمل بيرد مع الحاكم

86
00:05:11,200 --> 00:05:12,580
ما دليلك؟

87
00:05:12,580 --> 00:05:15,160
وهل هنالك سبب يدفعهما للعمل معًا؟

88
00:05:15,160 --> 00:05:18,380
.لقد عرفتُ ذلك الرّجل طوال حياتي

89
00:05:18,380 --> 00:05:19,540
—آسف، لكنّي لا أجد نظريّتك مقـ

90
00:05:19,540 --> 00:05:21,340
.السّبب هو ثقتك العمياء به

91
00:05:21,340 --> 00:05:22,500
!ماذا قلت؟

92
00:05:22,500 --> 00:05:24,920
.الأهمّ الآن، بيرد شخص ذكيّ للغاية

93
00:05:25,340 --> 00:05:27,300
تظاهر أنّه ذراعي الأيمن

94
00:05:27,300 --> 00:05:29,680
.بينما وجد ذراعًا يسرى أخرى لنفسه

95
00:05:30,010 --> 00:05:31,350
تقصد إيناغي-سان؟

96
00:05:31,350 --> 00:05:32,850
!هذا مستحيل

97
00:05:32,850 --> 00:05:33,810
...لكن

98
00:05:34,270 --> 00:05:37,060
حسب معرفتي لشخصيّة سينباي، من الممكن

99
00:05:37,060 --> 00:05:40,270
.أنّه قد جهّز شخصًا ثانيًا كإجراء وقائيّ

100
00:05:41,150 --> 00:05:42,820
،لم أنتهِ بعد

101
00:05:42,820 --> 00:05:44,940
.لكن إليك المعلومات الّتي طلبتَها

102
00:05:44,940 --> 00:05:46,780
.لديّ بايانات مصوّرة أيضًا

103
00:05:46,780 --> 00:05:47,650
.شكرًا

104
00:05:50,620 --> 00:05:51,830
.عرفتُ هذا

105
00:05:52,530 --> 00:05:57,620
انظر إلى الوثيقة ثانية لترى
.إن كان هنالك أيّ شيء من أجله

106
00:05:57,620 --> 00:05:59,170
.لا يهمّ كم مرّة سأقرأها، فلن تتغيّر

107
00:05:59,370 --> 00:06:03,090
إن سمحت الفرصة، يمكن لشخص موهوب
.الحصول على نتائج جيّدة في أيّ وضع

108
00:06:03,090 --> 00:06:07,670
.لكنّه حصل على فرص كثيرة جدًّا في وقت قصير

109
00:06:07,670 --> 00:06:10,550
.لا تقل لي أنّك لم تجد هذا غريبًا أبدًا

110
00:06:11,220 --> 00:06:13,220
.أنا واثق أنّ الأمن العامّ يشتبه بالأمر أيضًا

111
00:06:13,470 --> 00:06:16,560
.وإلاّ ما كانوا ليدعوني أنظر في الأمر

112
00:06:16,810 --> 00:06:18,060
إذًا فهو يعرف؟

113
00:06:18,890 --> 00:06:22,610
!ما كان عليّ إخبارك بشأن إيناغي-سان من الأساس

114
00:06:22,900 --> 00:06:25,030
ستتظاهر بالجهل؟

115
00:06:25,900 --> 00:06:28,990
سمح الحاكم بارتكاب جرائم بشكل متعمّد

116
00:06:28,990 --> 00:06:31,110
.بهدف تحقيق مُثُله

117
00:06:32,700 --> 00:06:35,040
هل ستكون أختي على ما يرام؟

118
00:06:35,490 --> 00:06:38,160
...ماذا إن كان ما قاله شيماجيرو-سان حقيقة

119
00:06:38,160 --> 00:06:40,960
.إنّها مجرّد نظريّة. لا تقلقي بشأن هذا

120
00:06:42,750 --> 00:06:44,960
...في الحقيقة، في آخر إجازة لها

121
00:06:45,300 --> 00:06:48,050
—أختي، العشاء سوف يبـ

122
00:06:48,050 --> 00:06:49,800
!ما الّذي حدث؟

123
00:06:49,800 --> 00:06:52,090
لماذا غرفتك في فوضى هكذا؟

124
00:06:52,090 --> 00:06:55,640
،لا-لا بأس، أنا لا أبعثر الأمور
.بل أقوم بالتّنظيف

125
00:06:55,930 --> 00:06:56,970
.أنت تكذبين

126
00:06:56,970 --> 00:06:59,520
!كنت لتطلبي منّي المساعدة إن كنت ستنظّفينها

127
00:06:59,520 --> 00:07:01,350
.كلاّ، ليس اليوم

128
00:07:01,650 --> 00:07:02,770
ما هذا الصّندوق؟

129
00:07:02,770 --> 00:07:03,770
...هذا

130
00:07:04,940 --> 00:07:06,360
فستان زفاف؟

131
00:07:06,360 --> 00:07:07,400
لِمَ؟ لِمَ؟

132
00:07:07,400 --> 00:07:08,740
...حسنًا، إنّه

133
00:07:09,110 --> 00:07:12,200
.أنا...كنتُ فتاة صغيرة سخيفة فيما مضى

134
00:07:12,490 --> 00:07:14,870
مهلاً، هل كنت تقومين بالكوسبلاي؟

135
00:07:14,870 --> 00:07:16,030
!كلاّ

136
00:07:16,410 --> 00:07:17,790
ما السّبب إذًا؟

137
00:07:17,790 --> 00:07:20,500
،على الأرجح أنّك لا تتذكّرين لأنّك كنت صغيرة

138
00:07:20,790 --> 00:07:23,960
.لكنّي كنت على وشك الزّواج من إيناغي-كُن

139
00:07:24,670 --> 00:07:25,750
!هل أنت جادّة؟

140
00:07:25,750 --> 00:07:26,550
.نعم

141
00:07:27,340 --> 00:07:29,970
...أعني، حاولت معرفة الحقيقة منها مرّات عدّة

142
00:07:30,470 --> 00:07:33,300
.لكنّي لم أتخيّل أنّهما كانا مقرّبين لتلك الدّرجة

143
00:07:33,640 --> 00:07:34,640
...لذلك

144
00:07:34,640 --> 00:07:35,550
!حسنًا

145
00:07:35,970 --> 00:07:37,430
.آسف لمجيئي دون سابق إنذار

146
00:07:37,430 --> 00:07:39,350
.كان جيرو يتصرّف بغباء

147
00:07:39,350 --> 00:07:40,680
.ليس تمامًا

148
00:07:41,350 --> 00:07:43,850
.ظننتُ أنّ ذلك ممكن أيضًا

149
00:07:43,850 --> 00:07:44,730
أنت أيضًا؟

150
00:07:44,730 --> 00:07:47,270
.وصلتني رسالة من الأمن العامّ قبل مدّة

151
00:07:47,270 --> 00:07:48,440
من الأمن العامّ؟

152
00:07:48,440 --> 00:07:50,610
عن إيناغي-سان وليس جيرو؟

153
00:07:50,990 --> 00:07:51,490
.نعم

154
00:07:52,320 --> 00:07:53,780
!مرحبًا

155
00:07:54,070 --> 00:07:56,830
أنا يامابوكي. لديّ حجز هنا من أجل
."وليمة الكبد والبصل"

156
00:07:57,030 --> 00:07:58,580
!كنّا في انتظارك

157
00:07:59,740 --> 00:08:01,000
.من هنا

158
00:08:09,630 --> 00:08:11,260
!مرحبًا يا مادوكا-تشان

159
00:08:11,260 --> 00:08:12,010
.مرحبًا

160
00:08:12,300 --> 00:08:13,840
...بشأن تلك المهمّة

161
00:08:12,300 --> 00:08:13,840
ماذا حدث في تلك المهمّة؟

162
00:08:14,590 --> 00:08:15,640
.آسفة

163
00:08:15,640 --> 00:08:19,140
،أردتُ أن أحرص ألاّ يكون الأمر حقيقة
.لذلك طلبتُ خدمة من مادوكا-تشان

164
00:08:19,430 --> 00:08:20,640
هل أنت جادّة؟

165
00:08:20,640 --> 00:08:22,140
سأخبركما بكلّ صراحة

166
00:08:22,140 --> 00:08:27,400
أنّي لم أستطع العثور على أيّ دليل
.يربط الحاكم إيناغي بالجرائم

167
00:08:27,400 --> 00:08:28,360
.فهمت

168
00:08:28,360 --> 00:08:32,240
.ولكن، كنتُ مندهشة بميزاته القياديّة

169
00:08:32,240 --> 00:08:33,450
بإمكاني أن أرى

170
00:08:33,860 --> 00:08:36,570
.لماذا كدتِ تتزوّجينه أيّها الرّئيسة

171
00:08:36,570 --> 00:08:38,830
عرفتِ ذلك أيضًا؟

172
00:08:38,830 --> 00:08:40,660
.لم يفت الأوان بعد

173
00:08:40,660 --> 00:08:42,750
.مستحيل! لقد مرّ وقت طويل

174
00:08:42,750 --> 00:08:46,370
بالمناسبة يا مادوكا، هل تحرّيتِ
أمر فوانغ تشوان ونيوهي؟

175
00:08:46,370 --> 00:08:48,170
مجموعتا المافيا الصّينيّة الجديدتان؟

176
00:08:48,170 --> 00:08:50,500
.ألحّ عليّ جيرو أن ألقي نظرة عليهما

177
00:08:51,880 --> 00:08:53,220
.لم أفكّر في ذلك

178
00:08:57,640 --> 00:09:00,680
...آسف. عندما كنتِ واثقة أخيرًا

179
00:09:00,680 --> 00:09:04,180
.كلاّ، أريد أن أكون واثقة في هذه المرحلة

180
00:09:04,180 --> 00:09:05,060
.صحيح

181
00:09:08,060 --> 00:09:09,610
ما الأمر يا إيناغي-كُن؟

182
00:09:09,610 --> 00:09:11,610
.أردت رؤية وجهك

183
00:09:11,610 --> 00:09:12,110
ماذا؟

184
00:09:12,110 --> 00:09:13,690
.حسنًا، سأذهب الآن

185
00:09:15,200 --> 00:09:17,570
...تبقّت عشرة أيّام على اجتماع قمّة طوكيو

186
00:09:17,910 --> 00:09:21,200
.حلمي الكبير يوشك أخيرًا أن يبلغ خطّ البداية

187
00:09:21,200 --> 00:09:24,910
.من الآن فصاعدًا، سيكون العالم منظّمًا حول المدن

188
00:09:25,330 --> 00:09:27,580
هذا ما قلتَه في كتابك، صحيح؟

189
00:09:27,870 --> 00:09:29,500
.أظنّ أنّ ذلك سيكون رائعًا

190
00:09:29,750 --> 00:09:30,420
.أجل

191
00:09:30,750 --> 00:09:32,500
.سوف أحقّق ذلك

192
00:09:33,260 --> 00:09:34,420
...ولكي يحدث هذا

193
00:09:35,720 --> 00:09:37,970
.رين، أريدك أن تكوني زوجتي

194
00:09:38,260 --> 00:09:38,970
ماذا؟

195
00:09:40,760 --> 00:09:44,640
.لقد أدركت كم أحتاج إليك

196
00:09:44,640 --> 00:09:46,270
من أين خطر علي بالك هذا؟

197
00:09:46,600 --> 00:09:48,400
.أعرف أنّ هذه أنانيّة منّي

198
00:09:48,400 --> 00:09:51,520
.لكنّه لا زال من مُثُلي الثّابتة

199
00:09:53,480 --> 00:09:54,070
.تفضّل

200
00:09:54,400 --> 00:09:57,360
.حدث اضطراب سياسيّ في البلاد

201
00:09:57,360 --> 00:09:59,240
.تمّ تجريد رئيس المكتب السّياسيّ من سلطاته

202
00:09:59,240 --> 00:10:00,780
...هكذا إذًا، حسنًا

203
00:10:03,330 --> 00:10:05,700
هكذا إذًا... لقد سمعته؟

204
00:10:05,950 --> 00:10:07,000
.أنا آسف

205
00:10:07,000 --> 00:10:11,380
،إن كان إيناغي-سان متورّطًا في مؤامرة كبيرة ما

206
00:10:11,380 --> 00:10:13,380
.فأنا أريد مساعدته

207
00:10:14,590 --> 00:10:16,920
أنا امرأة فظيعة، صيحح؟

208
00:10:17,670 --> 00:10:21,390
.أنا أشتبه برجل عرض عليّ الزّواج مرّتين

209
00:10:22,180 --> 00:10:24,100
.لم يتغيّر إيناغي-كُن

210
00:10:25,220 --> 00:10:26,680
.نعم، هذا صحيح

211
00:10:27,350 --> 00:10:27,980
.أجل

212
00:10:28,440 --> 00:10:30,230
...كان صريحًا كما كان آخر مرّة أيضًا

213
00:10:31,610 --> 00:10:33,650
ماذا؟ أذهب معك إلى أمريكا؟

214
00:10:33,650 --> 00:10:36,320
،نعم. قام ناغانوما-سينسي بالكثير من العمل

215
00:10:36,320 --> 00:10:38,740
وسأكون قادرًا على المشاركة
.في برنامج تبادل سياسيّ

216
00:10:38,740 --> 00:10:41,490
...لن أحصل على فرصة كهذه ثانية، لذلك

217
00:10:42,570 --> 00:10:45,410
.أريدك أن ترافقيني بصفتك زوجتي

218
00:10:46,540 --> 00:10:50,250
لكن من المفترض أن أذهب
...إلى وكالة الشّرطة الوطنيّة

219
00:10:50,250 --> 00:10:51,750
.أعرف أنّ هذه أنانيّة منّي

220
00:10:51,750 --> 00:10:54,670
.لكنّ ذهابي معك هو من مُثُلي

221
00:10:57,630 --> 00:10:59,760
،فكّرتُ في الأمر طويلاً

222
00:10:59,760 --> 00:11:02,680
،لكنّ كلانا قرّر أن يتّبع أحلامه

223
00:11:02,680 --> 00:11:03,760
...وفي النّهاية

224
00:11:03,760 --> 00:11:05,560
،هذا ما حدث إذًا

225
00:11:06,180 --> 00:11:09,060
.قد يكون الأمر أنّه مجبر على اتّخاذ قرار مهمّ

226
00:11:09,520 --> 00:11:11,770
.لا أدري إن كان هذا جيّدًا أم سيّئًا

227
00:11:11,770 --> 00:11:14,060
لكنّه كان يلجأ إليّ دائمًا

228
00:11:14,060 --> 00:11:17,650
.في كلّ مرّة لا يكون فيها واثقًا ممّا يجب أن يفعل

229
00:11:18,150 --> 00:11:20,200
...لذلك ربّما هذا أيضًا

230
00:11:20,200 --> 00:11:22,280
!لا بدّ أنّه أمر جيّد

231
00:11:22,820 --> 00:11:25,700
.إنّه الشّخص الّذي منحني طريقًا أسير فيه

232
00:11:26,330 --> 00:11:27,870
.لم يتغيّر أبدًا

233
00:11:28,160 --> 00:11:30,620
.وهذه المرّة، سيمنح الجميع طريقًا ليسيروا فيه

234
00:11:31,290 --> 00:11:33,330
طريق ليسيروا فيه؟

235
00:11:33,330 --> 00:11:34,040
!أجل

236
00:11:44,050 --> 00:11:47,260
"،ميهو، فكّرتُ في هذا مرّات عدّة"

237
00:11:47,260 --> 00:11:49,390
".لكنّي لم أصل إلاّ لنتيجة واحدة"

238
00:11:49,390 --> 00:11:51,020
"،أنا سعيد لأنّك معجبة بي"

239
00:11:51,020 --> 00:11:54,690
".لكنّي لا أتصوّر أن نتشارك مستقبلاً معًا"

240
00:11:55,230 --> 00:11:57,480
"لذلك أنا جدّ آسف، لكنّي لا أظنّ"

241
00:11:57,480 --> 00:11:59,690
".أنّ علينا مقابلة بعضنا ثانية"

242
00:11:58,650 --> 00:11:59,690
...فهمت

243
00:11:59,690 --> 00:12:01,110
.ملاحظة مهمّة

244
00:12:01,490 --> 00:12:04,780
.أجل، إنّها نقطة تحوّل حاسمة للحاكم

245
00:12:01,950 --> 00:12:02,900
إرسال

246
00:12:04,780 --> 00:12:07,200
.إنّه اجتماع قمّة المدينة قبل كلّ شيء

247
00:12:07,200 --> 00:12:08,740
.هذه هي نقطة البداية

248
00:12:09,040 --> 00:12:10,830
...في الحقيقة، نقطة التّحوّل قبل ذلك

249
00:12:11,160 --> 00:12:14,330
كيف يتعامل مع الأشياء الّتي قد تمنع بدايته؟

250
00:12:14,830 --> 00:12:17,540
بعبارات أبسط، كيف يجعل بيرد صامتًا؟

251
00:12:17,540 --> 00:12:18,290
!اسمع

252
00:12:18,290 --> 00:12:22,260
ظننتُ أنّ عمل إيناغي-سان
!مع هاتشيجو مجرّد نظريّة

253
00:12:22,590 --> 00:12:24,720
!هل بإمكانكما أن تصمتا؟

254
00:12:24,720 --> 00:12:27,010
أنا على وشك أن أقرّر الضّغط على زرّ

255
00:12:27,010 --> 00:12:28,350
!يقف عليه مصير مسألة بالغة الأهمّيّة

256
00:12:32,980 --> 00:12:34,060
ما الأمر؟

257
00:12:34,060 --> 00:12:36,310
،كنتُ أبحث في أمر المافيا الصّينيّة

258
00:12:36,310 --> 00:12:38,310
.ووصلتني رسالة من امرأة غامضة

259
00:12:38,310 --> 00:12:38,860
امرأة؟

260
00:12:38,860 --> 00:12:43,650
لا أعرف من تكون، لكنّها ادّعت
.امتلاكها لبيانات مهمّة

261
00:12:43,650 --> 00:12:44,610
.كوني حذرة

262
00:12:44,610 --> 00:12:45,360
.حسنًا

263
00:12:45,610 --> 00:12:47,070
.كان هنالك من يراقب

264
00:12:47,370 --> 00:12:50,450
تمّ إخبارهم أن يمنحوا الوثائق
.لأيّ أحد يبحث عنها

265
00:12:50,450 --> 00:12:51,290
.أجل

266
00:12:53,500 --> 00:12:54,460
أهي أنت؟

267
00:12:54,460 --> 00:12:55,040
.نعم

268
00:12:55,830 --> 00:12:58,790
.أخبروني أن أعطي هذا لك

269
00:13:01,090 --> 00:13:02,260
من أين حصلتِ على هذا؟

270
00:13:02,670 --> 00:13:04,470
.في خزانة عملات معيّنة

271
00:13:04,470 --> 00:13:05,130
ممّن؟

272
00:13:05,130 --> 00:13:06,130
.لا أدري

273
00:13:06,130 --> 00:13:07,930
.لقد أرسلوا لي التّعليمات عبر الإنترنيت

274
00:13:07,930 --> 00:13:08,600
.وداعًا

275
00:13:10,180 --> 00:13:11,260
أفعى؟

276
00:13:11,260 --> 00:13:12,720
ما هذا؟

277
00:13:13,020 --> 00:13:15,190
...يبدو أنّه رمز

278
00:13:15,480 --> 00:13:18,610
.سأفتح ملفّ الشّريط المصوّر الّذي هنا باستعماله

279
00:13:20,020 --> 00:13:21,110
!كوباري-سان؟

280
00:13:21,110 --> 00:13:22,650
ما الّذي يفعله هذا هنا؟

281
00:13:22,650 --> 00:13:26,280
ألم يكن الشّخص الّذي حاول
مهاجمة الحاكم السّابق؟

282
00:13:26,280 --> 00:13:26,820
.نعم

283
00:13:27,360 --> 00:13:28,660
.لكنّه ميت الآن

284
00:13:30,330 --> 00:13:31,530
.سأشغّل الشّريط

285
00:13:31,870 --> 00:13:33,450
مـ-من أنت؟

286
00:13:33,450 --> 00:13:36,960
كلّ ما سأقوله هو أنّي شخص يعرف
.الحاكم تيراو حقّ المعرفة

287
00:13:37,290 --> 00:13:39,500
.سأعطيك تعليمات الآن

288
00:13:39,500 --> 00:13:40,290
المندوب؟

289
00:13:40,590 --> 00:13:42,340
أوجدتَ الويلوير؟

290
00:13:40,750 --> 00:13:44,760
هذه محادثة دارت بين العميل والمجرم؟

291
00:13:42,340 --> 00:13:43,630
...نـ-نعم

292
00:13:43,630 --> 00:13:47,090
.حسنًا. سبق وأخبرتك بمطالب الحاكم

293
00:13:44,760 --> 00:13:45,630
.على الأرجح

294
00:13:45,630 --> 00:13:48,510
.إنّ صوت العميل معدّل بشكل مكثّف

295
00:13:47,090 --> 00:13:48,510
وماذا عن ابنتي؟

296
00:13:48,510 --> 00:13:50,800
.سأرى إن كان بإمكاني تعديله

297
00:13:48,840 --> 00:13:51,300
.سأعطيك كامل دعمي

298
00:13:51,640 --> 00:13:55,640
لكن لا يجب عليك أن تقول كلمة
.أخرى خارج علاقتك بناغانوما

299
00:13:55,640 --> 00:13:57,190
.هذا هو شرطي

300
00:13:57,480 --> 00:13:59,690
سوف تفي بوعدك بالفعل؟

301
00:13:59,690 --> 00:14:01,020
.لا تقلق

302
00:14:01,400 --> 00:14:03,940
.مهما حدث، خذ هذه واذهب لمكتب حكومة طوكيو

303
00:14:06,400 --> 00:14:08,200
...إيناغي-سان

304
00:14:08,780 --> 00:14:10,110
...لكنّ هذا ليس كافيًا

305
00:14:10,110 --> 00:14:13,330
،كلاّ، لم أجرّبه لأرى إن كانت هنالك تعديلات أخرى

306
00:14:13,330 --> 00:14:15,950
.لذلك لا يمكن تقديمه كدليل بعد

307
00:14:17,500 --> 00:14:18,120
...كوروكي-كُن

308
00:14:23,130 --> 00:14:24,550
من أطلق النّار؟

309
00:14:24,550 --> 00:14:26,010
.لم نكن نحن

310
00:14:26,010 --> 00:14:26,880
...هل هذا

311
00:14:29,300 --> 00:14:31,260
قاعة الاجتماعات

312
00:14:29,300 --> 00:14:31,260
تمّت الموافقة على مشروع القانون

313
00:14:31,260 --> 00:14:34,220
!بتصويت الأغلبيّة

314
00:14:36,310 --> 00:14:37,680
!انتحر هاتشيجو؟

315
00:14:37,680 --> 00:14:39,140
!هذا مستحيل

316
00:14:39,140 --> 00:14:45,070
لكنّ حمض الجثّة النّوويّ يطابق
.حمض هاتشيجو النّووي من المتجر

317
00:14:45,070 --> 00:14:48,240
،يبدو أنّه يملك جنسيّة من دولة كاروبانوبا

318
00:14:48,240 --> 00:14:52,660
لكنّ مموّله فقد سلطاته
.خلال الاضطراب السّياسيّ الأخير

319
00:14:52,660 --> 00:14:57,950
أُمر أن يعود للبلاد، وكان من الواضح
.أنّه سيُعدم إن عاد

320
00:14:58,410 --> 00:14:59,750
.فهمت

321
00:15:00,670 --> 00:15:01,500
...أيّتها الرّئيسة

322
00:15:02,080 --> 00:15:04,090
.تحليل البيانات الّتي طلبتها

323
00:15:04,090 --> 00:15:05,040
.شكرًا لك

324
00:15:05,040 --> 00:15:05,800
بيانات؟

325
00:15:05,800 --> 00:15:06,460
.نعم

326
00:15:06,460 --> 00:15:10,260
إنّها بيانات نُسخت من حاسوب
.مساعد الحاكم إيناغي الشّخصيّ

327
00:15:10,260 --> 00:15:13,010
هل هذا قانونيّ؟

328
00:15:13,390 --> 00:15:16,720
،طلبتُ من المديرة أن تستعيد الملفّات المحذوفة

329
00:15:17,020 --> 00:15:18,220
.وقد تضمّنت على هذا

330
00:15:19,770 --> 00:15:20,810
!مستحيل

331
00:15:20,810 --> 00:15:22,060
!لا بدّ أنّه خطأ ما

332
00:15:22,480 --> 00:15:24,730
!سوف أتحدّث إلى إيناغي-سان وأعرف بنفسي

333
00:15:24,730 --> 00:15:26,190
.مهلاً يا كوروكي-كُن

334
00:15:27,030 --> 00:15:28,360
.اهدأ

335
00:15:29,190 --> 00:15:33,070
،إن كانت تلك الحادثة تربط إيناغي-كُن بلوغوس

336
00:15:33,070 --> 00:15:36,830
.لذا فإنّ انتحار هاتشيجو هو كما قال شيماجيرو-كُن

337
00:15:36,830 --> 00:15:38,950
!تقولين هذا الآن أيّتها الرّئيسة؟

338
00:15:39,580 --> 00:15:42,040
في الوقت الحاليّ، أنا أتحدّث

339
00:15:42,040 --> 00:15:44,830
.بصفتي ضابطة شرطة وليس كصديقة لك

340
00:15:47,090 --> 00:15:47,880
...لكن

341
00:15:48,210 --> 00:15:52,090
.لا توجد طريقة لنتحقّق بها انتحار هاتشيجو

342
00:15:52,340 --> 00:15:53,840
إنّ كاروبانوبا الآن

343
00:15:53,840 --> 00:15:57,470
هي البلاد الّتي تحوز على اهتمام
.الحكومة اليابانيّة بالكامل

344
00:15:57,760 --> 00:16:00,520
هل عثرت على شيء يا هاياشيدا-سان؟

345
00:16:00,520 --> 00:16:01,640
هل من دلائل؟

346
00:16:01,640 --> 00:16:02,690
.طبعًا لا

347
00:16:02,690 --> 00:16:05,190
...لو كان لدينا دليل، لكنّا الآن

348
00:16:05,190 --> 00:16:07,150
".اعثر على المتّهم في حالة الشّكّ"

349
00:16:07,820 --> 00:16:11,490
.أيّتها الرّئيسة، سوف أتّبع مبادئ الشّرطة

350
00:16:11,490 --> 00:16:12,240
.نعم

351
00:16:12,570 --> 00:16:14,410
.ساعدوني جميعًا

352
00:16:14,410 --> 00:16:15,990
.لديّ فكرة

353
00:16:19,450 --> 00:16:22,660
آسفة لأنّي اتّصلتُ بك في هذا
.الوقت المتأخّر يا إيناغي-كُن

354
00:16:23,000 --> 00:16:26,040
.ما كنتُ لأرفض أيّ شيء تطلبينه

355
00:16:26,040 --> 00:16:27,130
.شكرًا لك

356
00:16:27,130 --> 00:16:31,760
لكن في المرّة القادمة، أريد أن أعرف
.ما سنفعله مسبقًا

357
00:16:31,760 --> 00:16:34,720
.لا زلت أرتدي ملابسي العاديّة

358
00:16:34,720 --> 00:16:35,800
.أنا آسفة

359
00:16:41,140 --> 00:16:42,810
.أنت جميلة للغاية يا رين

360
00:16:43,810 --> 00:16:45,810
.تبدو الرّئيسة جميلة

361
00:16:46,270 --> 00:16:47,020
.نعم

362
00:16:47,270 --> 00:16:51,030
لكن هل كانت هذه هي الطّريقة الوحيدة؟

363
00:16:52,030 --> 00:16:54,610
.لا يجب أن تكون هنالك أيّ أكاذيب في الحبّ

364
00:16:55,110 --> 00:17:00,240
إيناغي كوتارو-سان، أنت على وشك الزّواح
.من يامابوكي رين-سان

365
00:17:00,240 --> 00:17:05,420
هل تعد أن تجيب على أسئلة
زوجتك بكلّ صدق ودون كذب؟

366
00:17:06,250 --> 00:17:06,870
.نعم

367
00:17:07,290 --> 00:17:09,920
.لنستمع إذًا لكلمات العروس للعريس

368
00:17:11,880 --> 00:17:15,720
.ما كنتُ أتوّقع أن أقف إلى جانبك مرتدية هذا

369
00:17:15,720 --> 00:17:16,880
.ولا أنا

370
00:17:17,180 --> 00:17:18,680
.شكرًا يا رين

371
00:17:18,930 --> 00:17:22,770
.إيناغي-كُن، أجب عمّا سأسألك إيّاه دون كذب

372
00:17:24,270 --> 00:17:29,190
،سمعتَ بشأن موت بيرد من لوغوس
المعروف باسم هاتشيجو توموكي، صحيح؟

373
00:17:29,190 --> 00:17:29,810
.نعم

374
00:17:30,270 --> 00:17:31,690
.أخبروني أنّها حالة انتحار

375
00:17:31,690 --> 00:17:35,450
لكنّ أوّل رسالة أرستلها سفارة كاروبانوبا لمحطّة أزابو

376
00:17:35,450 --> 00:17:37,950
.هي أنّ هنالك من حاول التّسلّل

377
00:17:38,570 --> 00:17:41,830
،لكن قبل أن تصل الشّرطة إلى هناك
.تلقّوا أمرًا بالانسحاب

378
00:17:41,830 --> 00:17:44,580
.ثمّ أخبروهم أنّ أحد الموظّفين قد انتحر

379
00:17:44,870 --> 00:17:46,250
ما هي شكوكك؟

380
00:17:46,710 --> 00:17:51,290
هل عيّنتَ المافيا الصّينيّة لمهاجمة السّفارة؟

381
00:17:51,290 --> 00:17:53,500
مهلاً... ما الغرض من هذا السّؤال؟

382
00:17:54,010 --> 00:17:56,590
،احتجت لقوّة هاتشيجو

383
00:17:56,590 --> 00:17:59,180
.الرّجل الّذي تسبّب بحادثة لوغوس

384
00:17:59,180 --> 00:18:03,220
،حتّى بعد أن أصبحت الحاكم
،عرضتَ عليه ويلوير

385
00:18:03,220 --> 00:18:07,350
.وسمحت له بارتكاب الجرائم لتعميق مُثُلك

386
00:18:07,350 --> 00:18:12,070
،لكنّي لم أعد بحاجة إليه بعد الآن
لذلك تخلّصتُ منه، أهذا ما تقصدينه؟

387
00:18:12,070 --> 00:18:13,360
.لا تقلق

388
00:18:13,690 --> 00:18:16,740
.مهما حدث، خذ هذه واذهب لمكتب حكومة طوكيو

389
00:18:16,740 --> 00:18:18,650
هذا صوتك، صحيح؟

390
00:18:19,530 --> 00:18:20,620
.إنّه يبدو كصوتي

391
00:18:21,120 --> 00:18:24,740
هذه هي الصّورة الّتي مُنحت لنا
.مع بيانات الصّوت تلك

392
00:18:25,120 --> 00:18:28,330
.إنّها على الأرجح رمز من أعطى الأوامر لكوباري-سان

393
00:18:29,080 --> 00:18:33,800
.نفس الرّمز عُثر عليه في حاسوب مساعدك

394
00:18:33,800 --> 00:18:36,960
،حتّى إن كان ذلك أنا من يتحدّث مع كوباري-سان

395
00:18:36,960 --> 00:18:39,260
.فأنا أخبره بالذّهاب لمكتب حكومة طوكيو فحسب

396
00:18:39,590 --> 00:18:43,300
،أنا مجرّد وسيط لا يعرف تفاصيل العقد

397
00:18:43,300 --> 00:18:46,020
.أذكّره أنّ عليه الوفاء بدوره في الصّفقة

398
00:18:46,220 --> 00:18:47,730
ماذا بشأن هذا؟

399
00:18:47,980 --> 00:18:50,480
،خلال حادثة أتامي

400
00:18:50,480 --> 00:18:54,440
.ظهرتَ في أحد صور مختلس النّظر

401
00:18:54,690 --> 00:18:59,320
وكما هو جليّ، أنت تتحدّث إلى ثالث
.أهمّ رجل في عالم الجريمة

402
00:18:59,610 --> 00:19:02,530
.استعملنا قراءة الشّفاه لنعرف عمّاذا تتحدّثان

403
00:19:02,910 --> 00:19:04,410
.هذا ها قلتَه

404
00:19:04,740 --> 00:19:07,500
"النّموذج الخفيّ جاهز، صحيح؟"

405
00:19:07,790 --> 00:19:09,710
"...ربّما حيّ يامانوتي للمهاجرين"

406
00:19:10,000 --> 00:19:12,540
استعملت ذلك لإغراء ضابط سابق في دولة كاروبانوبا

407
00:19:13,000 --> 00:19:15,210
ليهاجم المدنيّين، صحيح؟

408
00:19:15,750 --> 00:19:18,550
.أنت تقابل أشخاصًا كُثر بصفتك الحاكم

409
00:19:19,260 --> 00:19:23,850
،لا أستطيع تحرّي أمر ماضيهم الشّخصيّ جميعًا
.لكنّي سأكون حذرًا من الآن فصاعدًا

410
00:19:24,180 --> 00:19:26,850
وأذكر أنّ قراءة الشّفاه

411
00:19:26,850 --> 00:19:29,890
.لديها نسبة دقّة بحوالي ثلاثين بالمائة

412
00:19:30,180 --> 00:19:33,020
هكذا جهّزت كلّ شيء، صحيح؟

413
00:19:33,770 --> 00:19:35,480
،لكنّ الآن هو أسوأ وقت ممكن

414
00:19:35,480 --> 00:19:38,780
.قال هاتشيجو توموكي شيئًا فاق توقّعاتك بكثير

415
00:19:39,610 --> 00:19:41,570
.لم تستطع الاستمرار معه بالطّبع

416
00:19:41,860 --> 00:19:47,080
لذلك قلقتَ لفترة قبل أن تبدأ في تنفيذ
.الخطّة الاحتياطيّة الّتي جهّزتَها

417
00:19:47,540 --> 00:19:48,330
...كان ذلك

418
00:19:48,540 --> 00:19:50,500
.اغتيال هاتشيجو توموكي

419
00:19:50,500 --> 00:19:51,210
.نعم

420
00:19:51,210 --> 00:19:54,920
.سوف يتغيّر مصيرك تمامًا اعتمادًا على نجاح ذلك

421
00:19:54,920 --> 00:19:58,920
.لذلك السّبب أتيتَ إليّ

422
00:19:59,760 --> 00:20:00,840
هل لديك دليل؟

423
00:20:01,090 --> 00:20:02,220
.حدسي

424
00:20:02,590 --> 00:20:04,550
.لذلك أنت حرّ في إنكاره

425
00:20:04,800 --> 00:20:08,010
.لكن لا تكذب عليّ هنا لو سمحت

426
00:20:09,470 --> 00:20:11,230
.هذا ما توقّعتُه منك يا رين

427
00:20:11,230 --> 00:20:12,350
.أنت على حقّ

428
00:20:13,140 --> 00:20:17,570
لكن ما الّذي يمكنهم فعله بي بشكل قانونيّ؟

429
00:20:17,570 --> 00:20:20,650
بما في ذلك كلّ حوادث الويلوير الأخيرة؟

430
00:20:21,280 --> 00:20:24,410
.أخبرتُه بخطّتي كحاكم فحسب

431
00:20:24,820 --> 00:20:27,580
.جهّز هاتشيجو-كُن لكلّ شيء دون كلمة منّي

432
00:20:28,030 --> 00:20:30,200
.لقد أخذ كلّ شيء في اعتباره

433
00:20:30,540 --> 00:20:33,040
لذلك بإمكانك إبقاء أفعالك قانونيّة؟

434
00:20:33,040 --> 00:20:34,170
ما دليلك؟

435
00:20:34,620 --> 00:20:35,960
،في بلاد تحكمها القوانين

436
00:20:39,550 --> 00:20:43,340
كنتِ على رأس المتخرّجين من القسم
.القانونيّ، لذلك تعرفين هذا تمام المعرفة

437
00:20:43,340 --> 00:20:45,760
!أرجوك! سلّم نفسك يا إيناغي-كُن

438
00:20:45,970 --> 00:20:48,430
.لا داعي لذلك، كما أنّه مستحيل

439
00:20:48,720 --> 00:20:52,980
.أنا حاكم موهوب ومحبوب للغاية

440
00:20:52,980 --> 00:20:56,270
،ولكي يكون كلّ هؤلاء النّاس سعداء

441
00:20:56,270 --> 00:21:00,020
.لا خيار أمامك سوى منحي حياتك الشّخصيّة والمهنيّة

442
00:21:01,530 --> 00:21:04,650
،اقترب موعد اجتماع قمّة المدينة
.وهي لحظتي لأتألّق فيها

443
00:21:04,650 --> 00:21:06,070
!أيّها الوغد إيناغي

444
00:21:06,070 --> 00:21:06,570
ماذا؟

445
00:21:07,030 --> 00:21:08,740
لا عبارات احترام هذه المرّة يا كوروكي؟

446
00:21:08,740 --> 00:21:10,410
.لا بدّ أنّك رجل مهمّ الآن

447
00:21:10,410 --> 00:21:11,620
!اخرس

448
00:21:11,620 --> 00:21:14,250
!لقد دعمتك دائمًا في بالي

449
00:21:14,250 --> 00:21:15,460
...لكنّك

450
00:21:15,670 --> 00:21:16,830
.لا تقلق

451
00:21:17,290 --> 00:21:19,710
.أنا جاهز لأسمّي هذا تمرين تدريب

452
00:21:19,710 --> 00:21:21,710
!سأكشف ما فعلت

453
00:21:21,710 --> 00:21:23,090
.أنت تشبه رين

454
00:21:23,090 --> 00:21:27,430
،لقد ورثتَ مجموعة قوانين
.وكلّ ما تقوم به هو اتّباعها

455
00:21:27,430 --> 00:21:29,510
،من أجل صالح اليابان... كلاّ

456
00:21:29,510 --> 00:21:33,430
.بل صالح العالم بأكمله، سأغيّر المجتمع

457
00:21:33,430 --> 00:21:35,810
.دوري كإنسان محتلف

458
00:21:35,810 --> 00:21:37,140
!كفاك عبثًا

459
00:21:37,140 --> 00:21:39,900
!مهما كانت مُثُلك، يبقى الخطأ خطأً

460
00:21:39,900 --> 00:21:42,110
!لن أغفر لك هذا أبدًا

461
00:21:42,900 --> 00:21:44,570
.لم تنضج أبدًا

462
00:21:45,820 --> 00:21:47,990
.لم يعد هنالك من يقف في طريقي

463
00:21:47,990 --> 00:21:50,030
!كوروكي-كُن

464
00:21:48,910 --> 00:21:49,490
.وداعًا

465
00:21:50,030 --> 00:21:50,830
!كوروكي-سان

466
00:21:50,830 --> 00:21:52,620
.كان هذا تسلية ممتعة

467
00:21:56,410 --> 00:21:57,920
!لقد استفاق

468
00:21:59,130 --> 00:22:01,960
كوروكي-سان، أتعرف أين أنت؟

469
00:22:04,010 --> 00:22:05,420
ماذا يفعل جيرو هنا؟

470
00:22:06,670 --> 00:22:08,010
هاياشيدا-سان؟

471
00:22:08,300 --> 00:22:09,930
...ذلك الوغد المخادع

472
00:22:09,930 --> 00:22:12,260
ما الّذي تريد فعله للحاكم؟

473
00:22:13,930 --> 00:22:15,060
.يا إلهي

474
00:22:15,390 --> 00:22:17,940
.لا يجب تمجيد المُثُل العليا

475
00:22:18,520 --> 00:22:22,320
،كنتُ مثلاً أعلى في السّابق
.لذلك أعرف ما أتحدّث عنه

476
00:23:54,160 --> 00:23:56,120
في الحلقة القادمة

477
00:23:55,120 --> 00:23:56,370
.أوهاكونياباتشينينكو

478
00:23:56,370 --> 00:23:58,410
!كلاّ، هذا ليس وقت التّحيّة المبتهجة

479
00:23:58,410 --> 00:23:59,700
.سأقوم أنا بالأمر إذًا

480
00:23:59,700 --> 00:24:00,960
.أوهاكونياباتشينينكو

481
00:24:00,960 --> 00:24:02,210
!هاياشيدا-سان من الأمن العامّ؟

482
00:24:02,210 --> 00:24:03,330
!كان هذا غير متوقّع

483
00:24:03,330 --> 00:24:04,830
في الحلقة القادمة، تنتظرنا المزيد
.من الأحداث غير المتوقّعة

484
00:24:04,830 --> 00:24:07,290
!مـ-مهلاً، هل أنت العدوّ الأخير؟