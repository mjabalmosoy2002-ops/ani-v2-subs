هاكاتا-تينجين

378
00:18:28,620 --> 00:18:30,290
!لا يمكنكم استعمال ذلك

379
00:18:30,290 --> 00:18:31,420
!من يهتمّ؟

380
00:18:31,420 --> 00:18:32,880
!أعطِ التّرخيص يا رئيس الوزراء

381
00:18:32,880 --> 00:18:34,340
...حـ-حسنًا

382
00:18:34,340 --> 00:18:35,800
.جيّد، مُنحنا التّرخيص

383
00:18:35,800 --> 00:18:36,760
.تأكيد التّرخيص

384
00:18:37,010 --> 00:18:38,340
!أنا أرخّص بذلك

385
00:18:38,340 --> 00:18:39,130
.عُلم

386
00:18:39,430 --> 00:18:40,970
أتسمعني يا أوسكار 2؟

387
00:18:40,970 --> 00:18:42,600
!نعم، شكرًا

388
00:18:42,600 --> 00:18:45,810
!تغيير الوضع إلى خاصّيّة الإبادة الكاملة الصّادمة

389
00:18:45,810 --> 00:18:47,480
.إطلاق سوسانو

390
00:18:48,020 --> 00:18:50,390
!شاهد معرفة المجموعة

391
00:18:54,730 --> 00:18:55,980
إذًا فلديهم ذلك؟

392
00:18:55,980 --> 00:18:58,780
.إيناغي-سان، سأقوم بأفضل خُدعي

393
00:18:59,740 --> 00:19:02,950
!اللّكمة الأماميّة

394
00:19:06,580 --> 00:19:07,950
!مذهل

395
00:19:09,250 --> 00:19:12,380
!مهلاً... لا فائدة من الهرب أيّها الوغد

396
00:19:13,540 --> 00:19:15,500
مستحيل! هل هذه هي المتفجّرات؟

397
00:19:18,920 --> 00:19:20,340
ماذا ستفعل الآن؟

398
00:19:20,340 --> 00:19:23,010
يمكن لوحدة سترايك أن تقاتل عن قرب فحسب، صحيح؟

399
00:19:23,010 --> 00:19:26,510
،"لكن إن هاجمت وانفجرت "إيمايج ماستر

400
00:19:26,510 --> 00:19:28,060
ماذا سيحدث لك؟

401
00:19:28,350 --> 00:19:30,520
،إمّا سأصبح ضحيّة للانفجار وأموت

402
00:19:30,520 --> 00:19:32,940
.أو يُلقى بي في الفضاء

403
00:19:33,310 --> 00:19:35,520
.أظنّ أنّ الأمر لا يهمّ في كلتا الحالتين

404
00:19:36,520 --> 00:19:38,990
.لم يكن صاروخ الطّوارئ هناك

405
00:19:39,280 --> 00:19:41,950
.لذلك فعليّ تدميره هنا في كلّ الأحوال

406
00:19:41,950 --> 00:19:42,780
!كوروكي-سان

407
00:19:42,780 --> 00:19:43,570
!كوروكي-كُن

408
00:19:43,780 --> 00:19:47,290
.كما أنّ سوسانو تستنزف الكثير من البطّاريّة

409
00:19:47,740 --> 00:19:50,120
...حتّى إن نجوت، لديّ خمس دقائق أخرى فحسب

410
00:19:51,540 --> 00:19:52,290
.مع السّلامة

411
00:19:52,750 --> 00:19:54,500
!أنا ممتنّ لكم جميعًا

412
00:19:54,500 --> 00:19:56,590
ما-ما الّذي تفعله؟

413
00:19:56,590 --> 00:19:59,170
ماذا عن الصّرافة الّتي تدين لي
!بها من مشروب البارحة؟

414
00:19:59,170 --> 00:20:00,800
—والجبن الأزرق الّذي

415
00:20:00,800 --> 00:20:03,260
.آسف أيّها الأبله

416
00:20:03,260 --> 00:20:05,550
...أنت تتصرّف ببلاهة دائمًا، أنا

417
00:20:05,850 --> 00:20:07,140
.حسنًا، لا تهتمّ

418
00:20:07,640 --> 00:20:11,430
!كوروكي

419
00:20:26,700 --> 00:20:30,410
سيتلقّى كوروكي ترقية بعد الوفاة

420
00:20:30,410 --> 00:20:32,080
ليصبح مشرفًا أوّل؟

421
00:20:33,080 --> 00:20:36,790
.لكن إن متّ، فلن يبقَ لك شيء

422
00:20:36,790 --> 00:20:38,130
!أيّها الرّئيس

423
00:20:38,130 --> 00:20:39,500
!***لقد تأخّرت أيّها الـ

424
00:20:39,500 --> 00:20:41,130
!كنّا بانتظارك

425
00:20:41,130 --> 00:20:43,840
.أيّتها المديرة، لا أظنّ ذلك مناسبًا لجنازة

426
00:20:44,130 --> 00:20:46,010
.تمهّل، لا تقل ذلك

427
00:20:46,010 --> 00:20:47,430
.هذه ليست جنازة

428
00:20:48,300 --> 00:20:49,760
!آسف، لقد تأخّرت

429
00:20:49,760 --> 00:20:50,680
كيف؟

430
00:20:51,020 --> 00:20:52,100
...الكسول الفظّ

431
00:20:53,140 --> 00:20:55,310
.توقّعت أن تكون الوحيد الّذي لم يسمع الخبر

432
00:20:55,310 --> 00:20:57,150
ما-ما الّذي تتحدّث عنه؟

433
00:20:57,690 --> 00:20:59,480
.اتّصل بي جيرو

434
00:20:59,900 --> 00:21:01,900
،لقد ناقشت الأمر مع يامابوكي-كُن

435
00:21:02,190 --> 00:21:06,990
لكن هنالك فرصة أن يكون بيرد قد وضع فخًّا
.في قاعدة مصعد الفضاء

436
00:21:07,530 --> 00:21:09,910
،افصل وحدة العودة أوّلاً

437
00:21:09,910 --> 00:21:11,490
.واتركها في نقطة مختلفة

438
00:21:12,250 --> 00:21:15,920
لذلك استعملت آخر ما في بطّاريّتي
،لأحمي نفسي من الانفجار

439
00:21:15,920 --> 00:21:17,540
.والاندفاع إلى الوحدة

440
00:21:18,460 --> 00:21:21,210
جيرو مفيد للغاية، صحيح؟

441
00:21:21,210 --> 00:21:24,010
مـ-مهلاً، أين بيرد إذًا؟

442
00:21:24,010 --> 00:21:25,550
لم تسمع بهذا أيضًا؟

443
00:21:27,510 --> 00:21:29,350
.مرّ وقت طويل يا سينباي

444
00:21:29,350 --> 00:21:32,680
.أخشى أنّك قد هبطت في قاعدة يوكوتا

445
00:21:32,680 --> 00:21:35,100
.لقد تلاعبتُ بنظام الطّيران الآليّ

446
00:21:35,940 --> 00:21:38,980
هل أنت سعيد بامتلاكك لأصدقاء يا ميثوس؟

447
00:21:39,360 --> 00:21:41,520
لديك أصدقاء أيضًا، صحيح؟

448
00:21:44,690 --> 00:21:46,990
لقد تبعنا صديقتك

449
00:21:46,990 --> 00:21:48,990
.للعثور عليك

450
00:21:48,990 --> 00:21:50,160
."اسمها الرّمزيّ هو "إيْ-كو

451
00:21:50,370 --> 00:21:54,540
هل تذكر عندما اقترحت إمكانيّة وجود "قرد"؟

452
00:21:54,830 --> 00:21:56,460
."لا أصّق أنّك اخترت "إيْب

453
00:21:56,460 --> 00:21:57,330
...سينباي

454
00:21:58,120 --> 00:22:01,130
ماذا كنت بالنّسبة لك؟

455
00:22:01,130 --> 00:22:02,800
عمّاذا تتحدّثين؟

456
00:22:02,800 --> 00:22:04,710
.كنتِ جزءًا لا غنى عنه

457
00:22:04,710 --> 00:22:05,550
.فهمت

458
00:22:06,510 --> 00:22:08,430
!شكرًا على إجابتك

459
00:22:13,060 --> 00:22:14,640
!وهذا ما حدث

460
00:22:14,930 --> 00:22:16,600
...فـ-فهمت

461
00:22:16,980 --> 00:22:19,100
وماذا عن "إيْب"؟

462
00:22:19,100 --> 00:22:21,610
.سنتعامل معه لاحقًا

463
00:22:21,610 --> 00:22:23,320
...أمّا الآن

464
00:22:22,770 --> 00:22:27,530
الاحتفال بعودة المفتّش كوروكي بأمان

465
00:22:23,820 --> 00:22:24,980
!إنّه ضيفنا المميّز

466
00:22:24,980 --> 00:22:27,530
!لقد عاد ضيف اليوم المميّز

467
00:22:27,530 --> 00:22:28,740
!كوروكي-سان

468
00:22:29,030 --> 00:22:31,160
!لنقلها معًا جميعًا يا رفاق

469
00:22:31,490 --> 00:22:32,990
...استعداد

470
00:22:32,990 --> 00:22:35,540
!مرحبًا بك

471
00:22:35,910 --> 00:22:39,080
عطور جنائز

472
00:22:37,830 --> 00:22:39,080
.أحسنت عملاً