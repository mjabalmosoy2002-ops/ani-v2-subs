1
00:00:04,600 --> 00:00:07,270
حديقة إينوكاشيرا

2
00:00:17,240 --> 00:00:18,280
.مرحبًا

3
00:00:19,120 --> 00:00:20,290
ما الأمر؟

4
00:00:20,290 --> 00:00:22,290
.أنا لا أراك هنا كثيرًا

5
00:00:22,290 --> 00:00:23,410
.لقد قرأت هذا

6
00:00:23,410 --> 00:00:25,500
خطة طوكيو الجديدة
إيناغي كوتارو

7
00:00:24,080 --> 00:00:25,500
أيمكنك أن توقّعه لي؟

8
00:00:25,500 --> 00:00:27,960
على رسلك، أيّ نوع من المزاح هو هذا؟

9
00:00:27,960 --> 00:00:29,710
.كلاّ، لقد أدهشني بالفعل

10
00:00:30,000 --> 00:00:32,420
،إن طلب منك شرطيّ أن يحصل على توقيعك

11
00:00:32,420 --> 00:00:34,470
فسيتسبّب لك ذلك في مشكلة لأنّك الحاكم، صحيح؟

12
00:00:35,090 --> 00:00:38,220
.توقيع كتاب لشخص أعرفه محرج نوعًا ما

13
00:00:39,180 --> 00:00:42,730
كيف تسير خطّة خصخصة الشّرطة
المذكورة في الكتاب؟

14
00:00:43,310 --> 00:00:46,150
.يجب أخذ كلّ خطوة على حدى

15
00:00:46,440 --> 00:00:48,730
.العديد ممّن يكبروننا سنّا لا يحبّون التّغيير

16
00:00:49,150 --> 00:00:50,440
.هنالك أعداء في كلّ مكان

17
00:00:51,820 --> 00:00:54,700
بالمناسبة، كيف هما والداك مؤخّرًا؟

18
00:00:54,700 --> 00:00:57,450
.إنّهما على ما يرام أينما كانا

19
00:00:57,450 --> 00:01:00,740
وصلتني رسالة قبل مدّة ذكرا فيها أنّهما
.ذاهبين لمشاهدة الشّفق القطبيّ

20
00:01:01,450 --> 00:01:02,700
.هذا من شيمهما بالفعل

21
00:01:02,910 --> 00:01:03,700
.إلى اللّقاء

22
00:01:03,700 --> 00:01:06,170
!شكرًا يا إيناغي-سان

23
00:01:06,170 --> 00:01:06,870
!أراك لاحقًا

24
00:01:08,830 --> 00:01:10,500
أعداء في كلّ مكان إذًا؟

25
00:01:11,590 --> 00:01:14,050
إلى كوروكي تاكيرو-سان
حاكم مدينة طوكيو
إيناغي كوتارو

26
00:01:17,800 --> 00:01:19,050
،في المستقبل

27
00:01:19,050 --> 00:01:22,600
عند حدوث شيء ما يتعذّر
،على الشّرطة العاديّة إنجازه

28
00:01:22,600 --> 00:01:25,640
."يلجؤون إلى قوّة مشروع "أكتيف

29
00:01:26,730 --> 00:01:31,820
،هذه هي قصّة "أكتيف" التّابع لليابان
.وحدة الهجوم المنتقل الثّالث

30
00:02:49,520 --> 00:02:52,060
لماذا قد أساعد الحاكم؟

31
00:02:52,060 --> 00:02:53,560
!ولِمَ لا؟

32
00:02:53,560 --> 00:02:56,780
!فكّر في شيء ما قد يجعل حياته أسهل

33
00:02:56,780 --> 00:02:58,490
.النّاس لا يتغيّرون

34
00:02:58,490 --> 00:03:00,240
،مهما حدث

35
00:03:00,240 --> 00:03:03,320
.فإنّهم يحاولون العودة للنُّظم القديمة في النّهاية

36
00:03:03,700 --> 00:03:06,950
وخير دليل على هذا هو استمراركم
في استعمال أوروتشي، صحيح؟

37
00:03:07,700 --> 00:03:09,660
...حسنًا، أظنّ ذلك

38
00:03:09,660 --> 00:03:11,580
،بهدف تدمير الأشياء الّتي يتشبّثون بها

39
00:03:11,580 --> 00:03:14,080
.قوموا بالأمور بالقوّة واستعدّوا للمعارضة

40
00:03:14,080 --> 00:03:17,300
أواثق أنّه لا يمكنك التّفكير بشيء أقلّ حدّة يا جيرو؟

41
00:03:17,300 --> 00:03:19,090
.أنا لستُ جيرو

42
00:03:19,760 --> 00:03:21,090
.لا بأس بلقبي

43
00:03:21,090 --> 00:03:22,680
."لقب "ميثوس

44
00:03:22,680 --> 00:03:24,510
عمّاذا تتحدّث؟

45
00:03:24,510 --> 00:03:27,640
ألا تأكل هنا وما إلى ذلك لأنّك أخي الصّغير؟

46
00:03:27,640 --> 00:03:29,600
.أنا لم أطلب ذلك

47
00:03:29,600 --> 00:03:30,890
.لا بأس إذًا

48
00:03:30,890 --> 00:03:32,690
.سأبقى هنا للأبد فحسب

49
00:03:34,440 --> 00:03:37,730
.اسمحوا لي على الأقلّ باستعمال الإنترنيت

50
00:03:37,730 --> 00:03:38,940
ما العمل؟

51
00:03:38,940 --> 00:03:41,740
قد تكون فرصة جيّدة لجمع المعلومات
.عن المسألة الأخرى

52
00:03:41,740 --> 00:03:43,070
.لكن ليس هنا

53
00:03:43,070 --> 00:03:44,160
...ربّما بشكل خارجيّ

54
00:03:47,450 --> 00:03:49,040
.نعم، هذا هاياشيدا

55
00:03:50,080 --> 00:03:52,500
.أجل، كوروكي-كُن موجود هنا

56
00:03:53,870 --> 00:03:56,210
،البارحة على السّاعة 21:35

57
00:03:56,210 --> 00:03:58,880
ظهر هذا الويلوير في هيكاريغاوكا
.في منطقة نيريما

58
00:03:59,130 --> 00:04:03,840
نعتقد أنّه يسعى خلف أسرار مهنة شركة
.أوميدا للهندسة الكهربائيّة الموجودة هناك

59
00:04:04,130 --> 00:04:05,470
هل هرب؟

60
00:04:05,760 --> 00:04:07,930
،لقد حاصروه بطائرات الهيليكوبتر

61
00:04:08,260 --> 00:04:11,060
.لكنّ الرّياح حول المباني منعتهم من الاقتراب أكثر

62
00:04:11,730 --> 00:04:16,150
قبل عشرة دقائق، استعمل أسلاكًا
.للقفز بين المباني وهرب

63
00:04:16,150 --> 00:04:18,020
.كما يفعل العنكبوت

64
00:04:18,020 --> 00:04:21,320
لهذا تستعمل الشّرطة المحلّيّة عبارة
.حادثة العنكبوت" لتصف الأمر"

65
00:04:21,570 --> 00:04:25,030
"ألم يستعملوا "عنكبوت" لأنّه "جاسوس
بسبب تقارب نطق الكلمتين في الإنجليزيّة؟

66
00:04:30,490 --> 00:04:33,620
أجل، عمّاذا كنّا نتحدّث؟

67
00:04:33,620 --> 00:04:35,040
.حادثة العنكبوت

68
00:04:35,040 --> 00:04:36,380
.هذا صحيح

69
00:04:36,380 --> 00:04:40,840
يبدو أنّ الويلوير كان يُصغي لمحادثات
.ويأخذ صورًا من خارج المبنى

70
00:04:40,840 --> 00:04:42,170
.هذه طريقة قديمة

71
00:04:42,170 --> 00:04:47,550
ربّما لم يُحصّنوا أنفسهم من احتماليّة
.قيام شخص ما بالاستماع لهم من الخارج

72
00:04:47,550 --> 00:04:50,100
.نموذج الويلوير مبنيّ على نموذج أجنبيّ

73
00:04:50,100 --> 00:04:51,850
أجنبيّ؟

74
00:04:51,850 --> 00:04:52,680
.نعم

75
00:04:52,680 --> 00:04:56,190
.يبدو أنّه يستعمل أداة مصّ خاصّة من نوع ما

76
00:04:56,190 --> 00:04:59,110
.كم أرغب في رؤية كيفية قيامهم بذلك

77
00:04:59,110 --> 00:05:01,280
!سأكون سعيدًا للغاية إن حصلنا عليها

78
00:05:01,860 --> 00:05:04,240
هل هذه مسألة عاجلة؟

79
00:05:04,240 --> 00:05:05,740
.كلاّ، على الإطلاق

80
00:05:05,740 --> 00:05:08,700
.لا داعي لأن تحضر من أجل أمر كهذا

81
00:05:08,700 --> 00:05:10,870
.ظننتُ أنّه يجب أن تكون على اطّلاع فحسب

82
00:05:10,870 --> 00:05:12,330
لماذا؟

83
00:05:12,330 --> 00:05:14,080
.هذه قضيّة ويلوير

84
00:05:14,080 --> 00:05:16,250
،بما أنّها قضيّة تجسّس صناعيّ

85
00:05:16,250 --> 00:05:20,420
.فهم ليسوا واثقين حتّى من طلب مساعدتنا

86
00:05:20,420 --> 00:05:24,130
،لكن إن طلبوا المساعدة
علينا أن نكون جاهزين في الحال، صحيح؟

87
00:05:24,130 --> 00:05:25,010
.صحيح

88
00:05:25,010 --> 00:05:27,220
.لذلك أردتك أن تكون متأهّبًا على الأقلّ

89
00:05:27,220 --> 00:05:29,050
.فهمت

90
00:05:30,140 --> 00:05:33,680
عدم إشراك الوحدة 8 في مرحلة
.التّحقيق يعتبر مشكلة

91
00:05:33,970 --> 00:05:40,230
إنّ حكومة مدينة طوكيو ترغب بالفعل في امتلاك
.وحدة مستقلّة لتولّي أمر قضايا الويلوير هذه

92
00:05:40,230 --> 00:05:42,980
أهذا ما كنتَ تتحدّث عنه عندما
انتقلت الوحدة 8

93
00:05:42,980 --> 00:05:45,240
من الشّرطة الوطنيّة إلى شرطة العاصمة؟

94
00:05:45,240 --> 00:05:47,570
،هذا أفضل خيار لطوكيو

95
00:05:47,570 --> 00:05:50,160
.لكنّ البلديّات الأخرى قد لا تُعجب بالأمر

96
00:05:50,530 --> 00:05:53,080
،في الوقت الحاليّ، نعتمد على المساعدة الخاصّة

97
00:05:53,080 --> 00:05:56,120
كما هو الحال مع سينا-كُن، لكن
.لا يوجد ما يكفي من أمثاله

98
00:05:56,540 --> 00:06:02,000
هل تعرفين أيّ شرطيّين أو ضبّاط جيش
سابقين يعرفون كيفية استعمال الويلوير؟

99
00:06:02,000 --> 00:06:03,840
.هذا سؤال صعب

100
00:06:03,840 --> 00:06:07,170
.نحن أوّل منظّمة من نوعنا في قوّات الشّرطة

101
00:06:07,170 --> 00:06:08,260
.فهمت

102
00:06:09,050 --> 00:06:10,970
.سيّدي الحاكم، حان الوقت

103
00:06:10,970 --> 00:06:13,010
.حسنًا. آسف يا رين

104
00:06:13,470 --> 00:06:14,680
.سأعود في الحال

105
00:06:15,140 --> 00:06:16,770
عَثر فصيل مُؤيّد من حزبين

106
00:06:16,770 --> 00:06:20,060
على شيء آخر يريدون أن يشتكوا
.منه بشأن هذه المسألة

107
00:06:20,060 --> 00:06:21,060
شيء آخر؟

108
00:06:21,060 --> 00:06:24,440
.يريدون أن يتخلّصوا من مباني طوكيو الشّاهقة

109
00:06:24,440 --> 00:06:25,440
ماذا؟

110
00:06:25,440 --> 00:06:27,610
.أفهم حقيقة شعورهم

111
00:06:28,030 --> 00:06:32,620
تصميم مدينة طوكيو الحاليّ كان ردّة فعل
.تشكّلت بسبب ظاهرة الرّمال المتحرّكة

112
00:06:32,620 --> 00:06:35,120
.يظنّون أنّها فرصة جيّدة لإعطائها تصميمًا مناسبًا

113
00:06:35,120 --> 00:06:38,000
هذا ما تقوله دائمًا يا إيناغي-كُن، صحيح؟

114
00:06:38,000 --> 00:06:41,000
.على رسلك، ما كنتُ لأقول شيئًا جذريًّا كهذا

115
00:06:41,000 --> 00:06:43,790
.لكنّي أوافق على أنّها بحاجة لإعادة تصميم

116
00:06:43,790 --> 00:06:46,840
أراهن أنّه ستكون هنالك معارضة كبيرة
.لمسألة تغيير تصميم المدينة

117
00:06:47,210 --> 00:06:51,720
،هنالك حركاتٌ معارِضة كثيرة
.كبلدة سوا أثناء حادثة الوحش

118
00:06:51,720 --> 00:06:55,310
.لكن إن تحدّثنا بواقعيّة، فعلينا التّصرّف في الحال

119
00:06:55,310 --> 00:06:59,310
أريد أن أمنح لسكّان المدينة مثلاً أعلى
.يمكنهم أن يتّحدوا حوله

120
00:06:59,310 --> 00:07:01,480
هنالك أكثر من مثل أعلى واحد، صحيح؟

121
00:07:01,480 --> 00:07:03,980
تهتمّ السّياسة بتحويل كلّ شيء
.إلى مثل أعلى واحد

122
00:07:03,980 --> 00:07:06,110
.يمكننا الحصول على مجموعة قوانين واحدة فقط

123
00:07:06,110 --> 00:07:07,400
.فهمت

124
00:07:07,400 --> 00:07:09,530
إذًا فالسّياسة هي ما تصنع القوانين؟

125
00:07:09,530 --> 00:07:11,280
.قلتَ ذلك من قبل

126
00:07:11,280 --> 00:07:13,280
قاعة اجتماعات

127
00:07:11,490 --> 00:07:15,990
.أنا أقدّم مقترح منعٍ للإنشاءات الشّاهقة

128
00:07:15,990 --> 00:07:19,330
إنّ المباني الشّاهقة الّتي هي قيد الإنشاء
.ستتوقّف في الحال

129
00:07:19,330 --> 00:07:21,290
!لا تكن غبيًّا

130
00:07:21,290 --> 00:07:27,050
إنّ المدن الأخرى مثل كيوطو قد منعت
.الإنشاءات الشّاهقة لأسباب جماليّة

131
00:07:27,050 --> 00:07:28,710
!من تظنّ نفسك؟

132
00:07:28,710 --> 00:07:29,880
!علينا الاستفادة من فضائنا قدر الإمكان

133
00:07:29,880 --> 00:07:31,220
!لا يمكن القيام بهذا لملكيّات خاصّة

134
00:07:31,220 --> 00:07:34,340
إيناغي
كوتارو

135
00:07:31,590 --> 00:07:34,340
!سكوت! سكوت

136
00:07:35,720 --> 00:07:36,970
.أخبريني يا أختي

137
00:07:37,890 --> 00:07:41,440
كيف يسير التّحقيق بشأن هاتشيجو-شينباي؟

138
00:07:41,730 --> 00:07:42,600
ماذا؟

139
00:07:42,600 --> 00:07:46,520
أرسلت منظّمة الشّرطة الجنائيّة الدّوليّة
.رسالة تقول أنّ والداه مفقودان

140
00:07:46,520 --> 00:07:49,190
.يبدو أنّه حصل على جنسيّة في مكان ما

141
00:07:49,730 --> 00:07:54,450
،استعملها ليعود إلى اليابان
...لذلك فإنّ الأمن العام قد

142
00:07:55,240 --> 00:07:57,830
!انسي هذا! تظاهري أنّك لم تسمعي ما قلت

143
00:07:58,490 --> 00:08:00,370
.لكنّي سمعته

144
00:08:00,370 --> 00:08:02,370
سمعتِه؟

145
00:08:02,370 --> 00:08:04,790
...آسفة، كنتُ شاردة نوعًا ما

146
00:08:04,790 --> 00:08:08,340
.هنالك شيء ما أريد أن أسأله إيّاه

147
00:08:08,340 --> 00:08:12,220
هل هنالك أيّ طريقة أستطيع رؤيته بها كما السّابق؟

148
00:08:12,220 --> 00:08:13,590
كما السّابق؟

149
00:08:13,590 --> 00:08:15,390
.أقصد في المنزل الآمن

150
00:08:15,390 --> 00:08:18,510
تقصدين أن نطلب من شيماجيرو-كُن أن يبحث عنه؟

151
00:08:18,810 --> 00:08:20,350
ما الّذي يفعله؟

152
00:08:20,680 --> 00:08:24,440
.إنّه يساعدنا في الكثير من القضايا

153
00:08:24,440 --> 00:08:25,520
فعلاً؟

154
00:08:25,520 --> 00:08:26,730
.هذا مفاجئ

155
00:08:31,490 --> 00:08:33,990
خطّة لمساعدة الحاكم؟

156
00:08:33,990 --> 00:08:35,450
.يا لك من شخص ملّح على عمله

157
00:08:35,450 --> 00:08:37,070
.لا تقل ذلك

158
00:08:37,410 --> 00:08:41,040
ما رأيك إذًا عن الويلوير العنكبوت؟

159
00:08:41,330 --> 00:08:44,040
لم يطلبوا منكم التّحقيق في أمره بعد، صحيح؟

160
00:08:44,040 --> 00:08:48,540
لكنّه سيكون مصدر إزعاج إن اضطررتُ للتّعامل
.مع هذا بينما عليّ مساعدة إيناغي-سان

161
00:08:48,790 --> 00:08:52,300
هل يحتاج الحاكم لمساعدتك من الأساس؟

162
00:08:52,300 --> 00:08:54,720
.لا تتحدّث لأخيك الأكبر هكذا

163
00:08:55,760 --> 00:09:00,850
،إن كان المجرم جاسوسًا صناعيًّا محترفًا
.عيِّنوه لتجبروه على الخروج من مخبئه

164
00:09:00,850 --> 00:09:02,640
تقصد أن نخدعه؟

165
00:09:03,020 --> 00:09:05,100
...هنالك قيود كثيرة تمنعنا من ذلك

166
00:09:05,100 --> 00:09:08,560
.لا يحتاج الضّابط المحقّق لينصب الفخّ بنفسه

167
00:09:09,110 --> 00:09:13,400
.أوّلاً، سأرى إن كان بيرد وراء حادثة الويلوير

168
00:09:13,400 --> 00:09:15,400
.حسنًا. شكرًا يا جيرو

169
00:09:15,700 --> 00:09:16,610
.ميثوس

170
00:09:21,740 --> 00:09:23,790
،مواصفات الآلة منخفضة نوعًا ما

171
00:09:23,790 --> 00:09:25,290
.لكن أستطيع أن أجعلها تعمل

172
00:09:26,080 --> 00:09:27,870
!مرحبًا

173
00:09:27,870 --> 00:09:29,920
ما الّذي يمكنني أن أفعله من أجلك؟

174
00:09:30,250 --> 00:09:31,420
...دعيني أرى

175
00:09:31,420 --> 00:09:34,880
.أوّلاً، لنرَ إن كان العنكبوت يستقبل مهمّات عبر الإنترنيت

176
00:09:35,170 --> 00:09:36,340
.فهمت

177
00:09:37,510 --> 00:09:41,470
!ما الّذي تفعله بالدّوراياكي خاصّتي؟

178
00:09:42,970 --> 00:09:44,890
.سأدفع لك ثمنه لاحقًا

179
00:09:44,890 --> 00:09:46,350
!هذه ليست المشكلة

180
00:09:46,350 --> 00:09:48,600
وما الّذي تفعله في مكتبي؟

181
00:09:48,600 --> 00:09:51,690
.جيرو مواطن متعاون

182
00:09:51,690 --> 00:09:54,820
.استعمال حاسوبك يسهّل الأمور كثيرًا

183
00:09:54,820 --> 00:09:56,320
عمّاذا تتحدّث؟

184
00:09:56,740 --> 00:09:58,910
،كما أنّي أساعدكم

185
00:09:58,910 --> 00:10:01,580
لكن حسب عقد بيننا، ولستُ موظّفًا
.دائمًا من منظّمتكم

186
00:10:01,580 --> 00:10:02,950
فعلاً؟

187
00:10:02,950 --> 00:10:07,120
قال إيناغي-سان أنّه أراد أن يقوم بشيء ما
.على الأقل من أجل طوكيو

188
00:10:09,170 --> 00:10:13,210
لقد ذُكر اسم الحاكم في اجتماع المدراء
.التّنفيذيّين الّذي أتيتُ منه للتّوّ

189
00:10:13,210 --> 00:10:15,590
إنّ عمّال البناء كانوا غاضبين

190
00:10:15,590 --> 00:10:17,970
.لأنّ هنالك مفاوضات قد بدأت بشأن قانون جديد

191
00:10:18,510 --> 00:10:31,190
يتفاوض الحاكم إيناغي مع المتظاهرين

192
00:10:18,760 --> 00:10:20,510
أيمكنكم رؤية هذا؟

193
00:10:20,510 --> 00:10:22,430
إنّ النّاس يتظاهرون على المنع

194
00:10:22,430 --> 00:10:24,600
.الّذي لحق بالبنايات الشّاهقة

195
00:10:24,970 --> 00:10:27,980
ستُقام غدًا مظاهرة

196
00:10:27,980 --> 00:10:31,190
قرب برج تاكاو حيث تجري المفاوضات
.حول القانون الجديد

197
00:10:31,480 --> 00:10:34,650
.إنّهم يتشاركون مشاعرهم مباشرة مع قادة المدينة

198
00:10:32,110 --> 00:10:34,650
بناء طوكيو الكبرى
يفتح الطّريق للمستقبل

199
00:10:34,650 --> 00:10:38,150
!لا يفهم السّياسيّون الواقع على الإطلاق

200
00:10:38,150 --> 00:10:39,360
!لا يفهمون

201
00:10:39,360 --> 00:10:43,120
!نحن عمّال البناء من أنشأ طوكيو كما هي الآن

202
00:10:43,120 --> 00:10:44,370
!نحن أنشأناها

203
00:10:44,620 --> 00:10:46,660
ماذا أفعل الآن؟

204
00:10:46,660 --> 00:10:49,210
وجدتَ طريقة للتّواصل مع العنكبوت؟

205
00:10:50,210 --> 00:10:52,960
.إنّه يتفاوض بشكل مباشر فقط

206
00:10:52,960 --> 00:10:54,460
يريدنا أن نقابله؟

207
00:10:54,790 --> 00:10:56,170
—إذًا اذهب أنت يا جيرو

208
00:10:56,170 --> 00:10:57,550
،لنكن واضحين فقط

209
00:10:57,550 --> 00:11:01,300
.إنّه جاسوس صناعيّ لا علاقة له ببيرد

210
00:11:01,300 --> 00:11:03,600
.لذلك لن أساعدك أكثر من هذا

211
00:11:04,760 --> 00:11:05,810
.حسنًا، ستذهب أنت

212
00:11:05,810 --> 00:11:07,930
."شعارنا هو "النّظافة والسلامة

213
00:11:07,930 --> 00:11:10,600
.اطلب هذا من مدنيّين متعاونين آخرين

214
00:11:10,600 --> 00:11:12,230
آخرين؟

215
00:11:12,520 --> 00:11:14,150
...حسنًا، هناك

216
00:11:20,280 --> 00:11:21,660
هل هذا كبد بالثّوم؟

217
00:11:21,660 --> 00:11:23,870
.كلاّ، هذا ثوم بالكبد

218
00:11:24,700 --> 00:11:26,160
أنت محقّقة؟

219
00:11:26,370 --> 00:11:30,250
،تتطلّب قضيّتنا قدرات لا يتوفّر عليها مكتبنا

220
00:11:30,250 --> 00:11:32,580
.لذلك نرغب منك أن تقوم بالأمر بدلاً منّا

221
00:11:34,580 --> 00:11:37,460
هل يقبل مكتبكم أيّ قضيّة؟

222
00:11:37,460 --> 00:11:39,960
.كلاّ، يتوقّف ذلك على المال

223
00:11:39,960 --> 00:11:41,380
.وأنا كذلك

224
00:11:41,380 --> 00:11:43,340
.سأتقاضى جيّدًا مقابل هذا

225
00:11:43,340 --> 00:11:47,600
.حتّى إن لم تدفعوا أنتم، فسيدفع آخرون

226
00:11:47,600 --> 00:11:49,720
،لمعلوماتك فحسب، إن فعلتَ ذلك

227
00:11:49,720 --> 00:11:52,100
.ستضرّ بسمعتك في هذا القطاع

228
00:11:52,850 --> 00:11:55,190
.لا بأس، ليس عليك أن تصدّقني

229
00:11:57,110 --> 00:11:59,480
.حسنًا. سأقبل بالمهمّة

230
00:11:59,480 --> 00:12:01,570
.جهّزي المال، وانتظري مكالمتي

231
00:12:04,610 --> 00:12:06,410
!حسنًا! نلنا منه

232
00:12:06,740 --> 00:12:08,620
!انتظر فحسب أيّها العنكبوت

233
00:12:15,710 --> 00:12:18,290
ألا تعرف قاعدةَ "أبلغ وأعلم وشاور"؟

234
00:12:18,290 --> 00:12:20,590
لماذا نصبتَ الفخّ من تلقاء نفسك؟

235
00:12:20,880 --> 00:12:23,590
...معك حقّ

236
00:12:23,590 --> 00:12:24,760
.أنا آسف

237
00:12:24,760 --> 00:12:27,010
.لديّ مهمّة أخرى بعد هذا

238
00:12:27,260 --> 00:12:28,760
.لا داعي للقلق بشأن هذا

239
00:12:28,760 --> 00:12:30,220
.حظًّا سعيدًا في عملك

240
00:12:30,220 --> 00:12:32,480
.شكرًا جزيلاً. مع السّلامة

241
00:12:36,650 --> 00:12:40,530
هل شركة بالي الّتي يسعى خلفها
العنكبوت هي متعاون مدنيّ أيضًا؟

242
00:12:40,820 --> 00:12:41,900
...حسنًا

243
00:12:41,900 --> 00:12:43,700
.إنّهم لا يعرفون شيئًا

244
00:12:43,700 --> 00:12:47,120
لقد اخترتُهم كطُعم لأنّهم كانوا مناسبين
.كهدف لجاسوس صناعيّ

245
00:12:47,120 --> 00:12:49,330
.شيماجيرو-كُن، هذه مشكلة

246
00:12:51,040 --> 00:12:53,710
،اعتقلوا العنكبوت قبل أن يسرق الأسرار

247
00:12:53,710 --> 00:12:55,670
.ولن تكون هنالك مشكلة

248
00:12:57,330 --> 00:12:58,880
،المعذرة أيّتها الرّئيسة

249
00:12:58,880 --> 00:13:01,380
لماذا لا نفكّر في الأمر بهذه الطّريقة؟

250
00:13:01,380 --> 00:13:04,970
قدّم لنا متعاون مدنيّ معلومةً

251
00:13:04,970 --> 00:13:09,510
.تفيد أنّ العنكبوت قد يستهدف شركة معيّنة

252
00:13:09,510 --> 00:13:11,720
.بعبارات أخرى، لن تكون هذه عملية خداع

253
00:13:11,720 --> 00:13:13,480
.بل عملية مراقبة

254
00:13:13,890 --> 00:13:15,640
أقلتَ مراقبة؟

255
00:13:16,390 --> 00:13:17,650
.حسنًا

256
00:13:17,650 --> 00:13:20,940
يستطيع كوروكي-كُن أن يدفع لشركة
.مادوكا-تشان مباشرة

257
00:13:21,440 --> 00:13:23,740
إذًا، متى سنستهدف العنكبوت؟

258
00:13:23,740 --> 00:13:24,610
.اليوم

259
00:13:24,610 --> 00:13:25,990
.إذًا لن ينفع الأمر

260
00:13:26,240 --> 00:13:29,490
.الوحدة 8 ستكون متأهّبة أمام برج تاكاو قريبًا

261
00:13:30,030 --> 00:13:30,950
متأهّبة؟

262
00:13:31,200 --> 00:13:33,450
.المظاهرة المعارضة للقانون الجديد

263
00:13:33,450 --> 00:13:35,660
.لقد أتى المتظاهرون وهم يرتدون الويلوير

264
00:13:35,660 --> 00:13:36,710
!صوّتوا بـ"لا" للقانون الجديد

265
00:13:36,710 --> 00:13:38,370
!لا تسلبونا أعمالنا

266
00:13:38,370 --> 00:13:40,130
!صوّتوا بـ"لا" للقانون الجديد

267
00:13:40,130 --> 00:13:43,130
...لا يزالون يسيرون بشكل سلميّ في الوقت الحاليّ

268
00:13:43,130 --> 00:13:45,670
،لكنّهم يستعملون دروع ويلوير قويّة

269
00:13:45,670 --> 00:13:47,510
.لذلك فالجميع على أعصابه

270
00:13:47,760 --> 00:13:49,340
ماذا عن العنكبوت إذًا؟

271
00:13:49,640 --> 00:13:51,260
.أظنّ أنّنا سننتظر حتّى تنتهي المظاهرة

272
00:13:51,600 --> 00:13:53,720
.كلاّ، لن يكون الوقت كافيًا

273
00:13:53,720 --> 00:13:56,100
.إن كان سيتّبع نمطه المعتاد، فسيتحرّك بسرعة

274
00:13:56,100 --> 00:13:58,560
...أفهم ما يقوله نوبوجيرو-كُن، لكن

275
00:13:58,560 --> 00:13:59,520
."اسمه "جيرو

276
00:13:59,520 --> 00:14:01,230
أليس "شيماجيرو-كُن"؟

277
00:14:02,020 --> 00:14:03,440
."اسمي هو "ميثوس

278
00:14:03,440 --> 00:14:13,950
يتفاوض الحاكم إيناغي مع المتظاهرين

279
00:14:03,690 --> 00:14:07,240
يجتمع المتظاهرون حول
.مبنى بلديّة المدينة في برج تاكاو

280
00:14:07,650 --> 00:14:12,450
ينوي برلمان المدينة مناقشة
،قانون البناء الجديد في المساء

281
00:14:12,450 --> 00:14:13,950
.لكنّهم لا يزالون في فترة الاستراحة

282
00:14:19,670 --> 00:14:21,210
.حسنًا، شكرًا

283
00:14:21,210 --> 00:14:23,670
.نحن لا نعمل معك

284
00:14:23,670 --> 00:14:26,420
.سأدعوكما للعشاء، لذلك ساعدانا

285
00:14:26,420 --> 00:14:29,930
.يعود أعضاء من البرلمان إلى قاعة الاجتماعات

286
00:14:26,420 --> 00:14:37,140
يتفاوض الحاكم إيناغي مع المتظاهرين

287
00:14:30,300 --> 00:14:33,680
.لقد تأخّروا كثيرًا، لكنّهم يعيدون عقد الجلسة

288
00:14:33,890 --> 00:14:37,140
.أصبحت أصوات المتظاهرين أعلى بكثير

289
00:14:38,770 --> 00:14:42,770
لكنّنا لا نستطيع تجاهل العنكبوت، صحيح؟

290
00:14:43,020 --> 00:14:45,280
.سأرسل هاروكا-تشان لتتعامل معه

291
00:14:45,280 --> 00:14:46,990
لماذا لم ترسليني؟

292
00:14:46,990 --> 00:14:49,820
.دروع الويلوير للمتظاهرين أقوى من دروعنا بكثير

293
00:14:50,360 --> 00:14:53,280
.نحن بحاجتك هنا

294
00:15:01,170 --> 00:15:01,580
طلب الإذن

295
00:15:01,580 --> 00:15:02,500
تمّت الموافقة

296
00:15:07,090 --> 00:15:08,720
.تشغيل وضع التّخفّي

297
00:15:10,170 --> 00:15:13,430
.هذه أوسكار 3، أنا أراقب الوضع

298
00:15:14,300 --> 00:15:17,600
.بهذا ينتهي بيان الفصيل المساند للمنع

299
00:15:17,600 --> 00:15:18,770
!أيّها الرّئيس، ابدأ التّصويت

300
00:15:18,770 --> 00:15:21,980
أتتجاهلون أصوات العمّال لإنشاء تصويت بالقوّة؟

301
00:15:22,650 --> 00:15:26,270
!سوف نقتحم البرلمان ونقول ما لدينا مباشرة

302
00:15:28,570 --> 00:15:29,740
،أوسكار 4

303
00:15:29,740 --> 00:15:32,360
.تجهيز الوحدة كوتيتسوجين ناناكامادو

304
00:15:33,490 --> 00:15:35,910
.فوناساكا-سان، هؤلاء مدنيّون

305
00:15:35,910 --> 00:15:39,120
كن حذرًا معهم بشكل كبير رجاءً
.عند استعمال القوّة

306
00:15:39,120 --> 00:15:41,120
.ضع جسد على المحكّ لإيقافهم

307
00:15:41,120 --> 00:15:42,120
.مفهوم

308
00:15:44,290 --> 00:15:45,500
.والآن دورك يا كوروكي-كُن

309
00:15:46,420 --> 00:15:47,090
!نعم

310
00:15:47,090 --> 00:15:48,800
.استعدّي أيضًا يا إميليا-تشان

311
00:15:49,050 --> 00:15:50,760
!حسنًا، مفهوم

312
00:15:50,760 --> 00:15:55,090
أيّتها الرّئيسة، لدينا رسالة من مساعد
.الحاكم إيناغي، شينجو-سان

313
00:15:55,090 --> 00:15:57,760
.أخبريه أنّنا نطبّق إجراءات الأمن في الوقت الحاليّ

314
00:15:57,760 --> 00:15:59,060
...حسنًا، إنّه

315
00:16:00,270 --> 00:16:02,350
.لسنا بحاجة لحماية الوحدة 8

316
00:16:02,350 --> 00:16:03,810
.لا تتدخّلوا رجاءً

317
00:16:04,060 --> 00:16:04,770
ماذا؟

318
00:16:04,770 --> 00:16:06,980
لن ننشر قوّاتنا؟ لماذا؟

319
00:16:06,980 --> 00:16:09,400
،الرّئيسة تتحدّث معه الآن

320
00:16:09,400 --> 00:16:11,190
.لكنّهم لم يعطونا الإذن

321
00:16:11,190 --> 00:16:13,490
!لنذهب! اتبعوني

322
00:16:14,950 --> 00:16:16,740
.بدأ المتظاهرون بالاندفاع

323
00:16:16,740 --> 00:16:17,740
!مهلاً

324
00:16:19,370 --> 00:16:21,870
!هل الحاكم... هل إيناغي-سان من قال ذلك؟

325
00:16:22,080 --> 00:16:23,830
.ستنسحب الوحدة 8 في الحال

326
00:16:24,040 --> 00:16:25,500
.لا تتدخّلوا رجاءً

327
00:16:25,500 --> 00:16:27,920
هل هذا هو أمر الحاكم بالفعل؟

328
00:16:27,920 --> 00:16:28,290
.نعم

329
00:16:28,880 --> 00:16:33,800
إنّ الحاكم قلق بشأن تصادم الوحدة 8
.مع المدنيّين لأجل مصلحة الشّرطة

330
00:16:34,260 --> 00:16:37,220
.لقد اشتكى النّاس سلفًا من أفعال الوحدة 9

331
00:16:37,220 --> 00:16:41,930
إن حدث أيّ شيء، فقد يشكّل ذلك مشكلة
.لوحدة الهجوم المتنقّل الثّالث بأكملها

332
00:16:41,930 --> 00:16:43,020
...هذا

333
00:16:43,350 --> 00:16:44,810
...انظروا، هذا

334
00:16:45,020 --> 00:16:47,020
!هنالك من خرج من المبنى

335
00:16:47,480 --> 00:16:48,360
!إنّه الحاكم

336
00:16:48,360 --> 00:16:49,570
!إنّه الحاكم إيناغي

337
00:16:49,860 --> 00:16:50,690
!كلاّ

338
00:16:51,530 --> 00:16:53,780
.كلاّ. لننتظر قليلاً

339
00:16:54,030 --> 00:16:55,860
.أنا إيناغي، حاكم طوكيو

340
00:16:56,160 --> 00:17:00,990
أتيتُ إلى هنا لأزيل أيّ سوء فهم وأقدّم
.حلاًّ ديموقراطيًّا لهذه المسألة

341
00:17:00,990 --> 00:17:02,660
ماذا تقصد بسوء الفهم؟

342
00:17:02,660 --> 00:17:08,210
كنتُ أنوي معارضة تمرير القانون
.الذّي يمنع إنشاء المباني الشّاهقة

343
00:17:08,500 --> 00:17:12,960
.لكنّ قوانين المجتمع الدّيموقراطيّ يجب أن تُدعم

344
00:17:13,210 --> 00:17:15,630
،إن كانت هذه هي الدّيموقراطيّة
!فعليكم سماع أصواتنا أيضًا

345
00:17:15,630 --> 00:17:17,390
.سوف نسمع أصواتكم

346
00:17:17,720 --> 00:17:19,470
.لكن قبل ذلك، أريد أن أطرح عليكم سؤالاً

347
00:17:19,470 --> 00:17:22,310
لماذا ترتدون الويلوير خاصّتكم؟

348
00:17:22,520 --> 00:17:24,270
أليست هذه محاولة لتخويفنا؟

349
00:17:24,270 --> 00:17:26,350
!هذه هي أزياء عملنا

350
00:17:26,350 --> 00:17:27,350
!هذا صحيح

351
00:17:27,350 --> 00:17:28,310
!كلاّ

352
00:17:30,480 --> 00:17:33,740
،لقد حاولتم دخول البرلمان بهذه الويلوير

353
00:17:33,740 --> 00:17:35,610
.وأنتم على علم تامّ بقوّتها

354
00:17:35,610 --> 00:17:37,280
ماذا عن الوحدة 8؟

355
00:17:37,280 --> 00:17:39,030
ذلك تخويف أيضًا، صحيح؟

356
00:17:39,740 --> 00:17:42,620
.لا يوجد هنا إلاّ حرس أمن عاديّين

357
00:17:42,870 --> 00:17:44,120
.الوحدة 8 غير موجودة

358
00:17:44,450 --> 00:17:47,080
!أنا أرجوكم أن تبقوا هنا

359
00:17:47,540 --> 00:17:50,670
وإلاّ لن يكون لدينا خيار آخر سوى التّضييق
.على استعمالات الويلوير بشدّة

360
00:17:50,670 --> 00:17:51,540
!اخرس

361
00:17:51,840 --> 00:17:55,840
!أنت تحاول إقناعنا بالقيام بما تريده

362
00:17:56,090 --> 00:17:57,840
مـ-من هؤلاء؟

363
00:17:57,840 --> 00:18:00,010
!هذا هو مكان عملنا

364
00:18:00,430 --> 00:18:02,680
أتريدون الانضمام لنا؟

365
00:18:02,680 --> 00:18:03,680
!إذًا تحدّثوا إليّ لاحقًا

366
00:18:03,680 --> 00:18:04,810
!على العكس تمامًا

367
00:18:05,060 --> 00:18:07,270
!أنتم مصدر إزعاج

368
00:18:07,270 --> 00:18:08,100
ماذا؟

369
00:18:09,060 --> 00:18:12,570
،إن تمّ التشديد في استعمال الويلوير بسببكم

370
00:18:12,570 --> 00:18:15,650
!فسيُصبح أداء عملنا صعبًا

371
00:18:15,650 --> 00:18:19,570
كيف لي أن أعمل دون الويلوير
في هذا العمر؟

372
00:18:19,570 --> 00:18:21,030
!هذا صحيح

373
00:18:21,030 --> 00:18:22,530
!مـ-مهلاً

374
00:18:22,530 --> 00:18:25,120
.نحن نحاول إنقاذ أعمالنا أيضًا

375
00:18:25,120 --> 00:18:27,540
إذًا فهذا يعني أنّكم ستفعلون ما تشاؤون؟

376
00:18:27,540 --> 00:18:29,830
حتّى التّسبّب في المشاكل للآخرين؟

377
00:18:29,830 --> 00:18:31,000
...كلاّ، لكن

378
00:18:31,000 --> 00:18:32,880
—لقد قدّمنا المعاملات الورقيّة

379
00:18:32,880 --> 00:18:35,210
!أنهوا تظاهركم في الحال

380
00:18:35,920 --> 00:18:38,880
!عودوا لمنازلكم! عودوا لمنازلكم! عودوا لمنازلكم

381
00:18:39,300 --> 00:18:40,510
.انظروا لهذا

382
00:18:40,510 --> 00:18:42,850
،ظهرت مجموعة أخرى أمام المتظاهرين

383
00:18:42,850 --> 00:18:44,060
.وهي تقوم بإيقافهم

384
00:18:44,350 --> 00:18:46,470
كلاهما مجموعة من المدنيّين. ما هذا؟

385
00:18:48,020 --> 00:18:51,190
!قائد المتظاهرين قد أطفأ الويلوير الّذي يرتديه

386
00:18:51,190 --> 00:18:53,520
.سوف يتحدّث مع الحاكم إيناغي مباشرة

387
00:18:53,860 --> 00:18:56,480
.لقد ظهروا في الوقت المناسب

388
00:18:56,480 --> 00:18:59,490
أنا سعيدة لأنّهم سيكونون قادرين
.على حلّ المشكلة بسلام

389
00:18:59,490 --> 00:19:02,070
!معكم أوسكار 3! لقد ظهر العنكبوت

390
00:19:03,030 --> 00:19:05,240
...لكنّ بطّاريّتي في حالة سيّئة

391
00:19:05,240 --> 00:19:08,200
.أوسكار 3، هذه مركبة قيادة الهجوم المتنقّل

392
00:19:08,450 --> 00:19:11,330
.أوسكار 4 في طريقه إليك

393
00:19:11,330 --> 00:19:13,710
.أرسلي إحداثيّات مكانك وبياناتك

394
00:19:13,710 --> 00:19:14,670
.عُلم

395
00:19:14,670 --> 00:19:16,840
.أوسكار 3، إرسال البيانات

396
00:19:18,460 --> 00:19:19,630
.انتهى التّحويل

397
00:19:20,630 --> 00:19:21,680
!عليّ تغيير ملابسي

398
00:19:22,300 --> 00:19:25,050
أوسكار 4، هل وصلتك المعلومات؟

399
00:19:25,050 --> 00:19:27,310
.معكم أوسكار 4. كلّ شيء جاهز

400
00:19:27,520 --> 00:19:30,140
.كيوكاي-سان، أرغب باستعمال فأسي الواسعة

401
00:19:30,140 --> 00:19:33,560
ماذا؟ أتقصد الفأس الحربيّة الاهتزازيّة؟

402
00:19:33,560 --> 00:19:35,940
.أجل، الفأس الواسعة

403
00:19:35,940 --> 00:19:37,530
إنّها فأس حربيّة، صحيح؟

404
00:19:37,530 --> 00:19:39,110
.يمكنك تسميتُها كذلك

405
00:19:39,110 --> 00:19:41,740
...فكّر فوناساكا-سان باسم خاصّ لها

406
00:19:41,740 --> 00:19:44,820
.إنّه تحت الكثير من الضّغط

407
00:19:44,820 --> 00:19:48,040
.لديك الإذن باستعمال الفأس الواسعة

408
00:19:48,040 --> 00:19:48,870
!عُلم

409
00:19:48,870 --> 00:19:51,370
!الفأس الواسعة دوريو، تجهيز

410
00:19:55,080 --> 00:19:56,090
!حدّدتُ مكان العنكبوت

411
00:19:56,960 --> 00:19:58,300
أهذه الوحدة 8؟

412
00:19:58,300 --> 00:20:00,840
!الانتقال للوضع 2

413
00:20:03,800 --> 00:20:05,180
.لقد كنتُ في انتظار هذا

414
00:20:07,260 --> 00:20:08,560
!رمي

415
00:20:10,390 --> 00:20:12,940
.معك الشّرطة. استسلم بسلام

416
00:20:12,940 --> 00:20:13,730
!حسنًا

417
00:20:17,060 --> 00:20:18,570
!أنا... أنا أستسلم

418
00:20:18,570 --> 00:20:21,690
!لذلك... لا تقتلني رجاءً

419
00:20:22,110 --> 00:20:24,110
.أجل، خيار ممتاز

420
00:20:24,410 --> 00:20:27,830
كما تعلمون جميعًا، وحدة الهجوم المتنقّل الثّالث

421
00:20:27,830 --> 00:20:30,830
.لا يمكنها أن تغطّي البلاد بأكملها وحدها

422
00:20:31,080 --> 00:20:32,620
،إنهم يقومون بكلّ جهدهم

423
00:20:32,620 --> 00:20:35,000
.لكن البنية القانونيّة للبلاد لا تتوافق معهم

424
00:20:35,330 --> 00:20:37,080
،لهذا السّبب

425
00:20:37,080 --> 00:20:40,210
،إضافة لشركة سينارز
،الّتي هي أوّل متعاونينا المدنيّين

426
00:20:40,500 --> 00:20:45,680
تطوّع هؤلاء الأشخاص ليكونوا جزءًا من منظّمة
."مناهضة الجريمة التّطوّعيّة "سوبارو

427
00:20:46,680 --> 00:20:49,310
،وكشكر منّا على لطفهم هذا

428
00:20:49,680 --> 00:20:54,520
أحب ّأن أعدهم أنّهم سيتمكّنون من
استعمال الويلوير بشكل أسهل

429
00:20:54,810 --> 00:20:56,730
إضافة لدعم كامل لأيّ متطوّع

430
00:20:56,730 --> 00:21:00,480
حصل على التّراخيص المطلوبة
.من حكومة طوكيو وشرطة العاصمة

431
00:21:00,820 --> 00:21:05,240
لقد أُنشئ نظام ترخيص المتطوّعين
بشكل سريع، أليس كذلك؟

432
00:21:05,240 --> 00:21:06,160
.نعم

433
00:21:06,160 --> 00:21:10,080
.كما أنّ منع المباني الشّاهقة قد رُفض بسهولة

434
00:21:10,080 --> 00:21:12,500
ما الّذي كان يفكّر به البرلمان؟

435
00:21:12,830 --> 00:21:16,920
لا أظنّ أنّ ذلك القانون كان
.من المفترض أن يمرّ من الأساس

436
00:21:17,290 --> 00:21:17,880
ماذا؟

437
00:21:18,080 --> 00:21:20,130
إذًا فتلك المظاهرة كان مخطّطًا لها؟

438
00:21:20,130 --> 00:21:22,380
.ليس المظاهرة فحسب، بل كلّ شيء

439
00:21:22,670 --> 00:21:24,550
.لقد كانت هنالك ثلاث جهات متورّطة

440
00:21:24,840 --> 00:21:27,180
،عضو برلمان يقدّم قانونًا مستحيلاً

441
00:21:27,550 --> 00:21:30,850
،وعامل يستعمل الويلوير ليقود المظاهرة

442
00:21:31,100 --> 00:21:35,100
.ومستعمل ويلوير ليجمع قوّة أمن من المدنيّين

443
00:21:35,690 --> 00:21:37,600
هذه الجهات الثّلاثة عبارة عن نقاط مختلفة

444
00:21:37,600 --> 00:21:40,900
على نفس الخطّ الّذي رسمه أحد ما، ألا تظنّ ذلك؟

445
00:21:40,900 --> 00:21:42,480
هل هو هاتشيجو؟

446
00:21:42,480 --> 00:21:43,650
.ليس هو فحسب

447
00:21:44,190 --> 00:21:46,820
طلبتَ منّي أن أجد طريقة

448
00:21:46,820 --> 00:21:49,620
لجعل الأمور أسهل على الحاكم، صحيح؟

449
00:21:49,990 --> 00:21:53,200
.إنّ الحاكم هو أكبر مستفيد من هذا

450
00:21:53,910 --> 00:21:54,950
ما الّذي تحاول قوله؟

451
00:21:54,950 --> 00:21:58,670
.إنّ الحاكم أو مساعده هو من خطّط لكلّ هذا

452
00:21:58,670 --> 00:22:02,000
.اسمع، لا تتحدّث هكذا دون امتلاك دليل

453
00:22:02,000 --> 00:22:03,960
،عندما كانت لوغوس لا تزال فعّالة

454
00:22:03,960 --> 00:22:06,630
.جرت أمور عديدة لم أكن أعرف بشأنها

455
00:22:06,630 --> 00:22:10,010
ظننتُ أنّ ذلك من صنيع دوغ
،أو ربّما الياكوزا أو المافيا

456
00:22:10,010 --> 00:22:12,220
...لكن إن كان بيرد يعمل مع إيناغي

457
00:22:12,220 --> 00:22:13,430
!لا تقل كلمة أخرى

458
00:22:15,390 --> 00:22:16,180
كوروكي-سان؟

459
00:22:16,890 --> 00:22:19,270
هيناتا-تشان، ما الأمر؟

460
00:22:19,270 --> 00:22:21,270
هل أستطيع التّحدّث معك؟

461
00:22:21,270 --> 00:22:21,940
التّحدّث معي؟

462
00:22:23,150 --> 00:22:23,860
.نعم

463
00:23:54,120 --> 00:23:55,620
في الحلقة القادمة

464
00:23:55,240 --> 00:23:56,830
.أوهاكونياباتشينينكو

465
00:23:57,120 --> 00:24:00,040
بدأت الأمور تصبح أكثر ظلمة، صحيح؟

466
00:24:00,040 --> 00:24:03,420
.أيّها العمّ فوناساكا، ساعد أختي في مشاكلها

467
00:24:03,420 --> 00:24:05,790
.العمّ"... أعجبني هذا"

468
00:24:05,790 --> 00:24:06,790
...أيّها العمّ

469
00:24:07,090 --> 00:24:07,880
أيّها العمّ؟

470
00:24:07,880 --> 00:24:08,460
!نعم