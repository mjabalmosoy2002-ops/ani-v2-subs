1
00:00:05,820 --> 00:00:07,770
.لقد اجتاز الفحص النّفسيّ

2
00:00:08,450 --> 00:00:11,610
،لا توجد علامات لأيّ انحرافات أو عنف أثناء المراقبة

3
00:00:12,180 --> 00:00:15,140
لكنّ التّقارير أوضحت بالفعل عدم
.القدرة على التّكيّف مع المجتمع

4
00:00:15,140 --> 00:00:16,830
...بالطّبع

5
00:00:16,820 --> 00:00:19,620
.إنّه لم يكن جزءًا من مجتمع عاديّ مذ أن كان طفلاً

6
00:00:21,080 --> 00:00:23,580
.يوافقك الكثير من أعضاء اللّجنة في هذا

7
00:00:24,160 --> 00:00:25,920
،"في المقابل، فإنّ هاتشيكو الملقّب بـ"بيرد

8
00:00:25,920 --> 00:00:28,540
.يقولون أنّه يريد أن يكون جزءًا من المجتمع

9
00:00:28,790 --> 00:00:30,670
...لذلك فإنّ الإذن الّذي مُنح لنا

10
00:00:31,010 --> 00:00:33,340
.يمكن التّفكير في أنّه تجربة

11
00:00:33,760 --> 00:00:37,050
...تجربة إن كانت اليابان ستتقبّله أو ستمحوه

12
00:00:37,510 --> 00:00:40,930
.حسنًا، سيكون ذلك خياره هو

13
00:00:49,690 --> 00:00:50,900
...أختي

14
00:00:50,900 --> 00:00:52,990
.لا تقلقي. هذا المكان آمن

15
00:00:52,990 --> 00:00:54,490
.سبق وأتيتُ إلى هنا مرّات عدّة

16
00:00:54,780 --> 00:00:55,990
.إنّه شخص مثير للإعجاب

17
00:00:57,110 --> 00:00:58,410
.ها قد وصلنا

18
00:00:58,410 --> 00:00:59,450
.حـ-حسنًا

19
00:01:03,660 --> 00:01:06,170
".شابّ شاب شعر رأسه"

20
00:01:07,210 --> 00:01:09,840
.نمط الصّوت وكلمة السّرّ متطاقبان

21
00:01:09,840 --> 00:01:11,420
.تفضّلوا رجاءً

22
00:01:11,420 --> 00:01:12,420
.شكرًا

23
00:01:16,380 --> 00:01:19,260
مرحبًا! كيف حالك اليوم؟

24
00:01:20,010 --> 00:01:22,720
!أحضرتُ بعض الأشياء لك أيّها الفتى اليافع

25
00:01:31,690 --> 00:01:32,900
،في المستقبل

26
00:01:32,900 --> 00:01:36,360
عند حدوث شيء ما يتعذّر
،على الشّرطة العاديّة إنجازه

27
00:01:36,360 --> 00:01:39,360
."يلجؤون إلى قوّة مشروع "أكتيف

28
00:01:40,740 --> 00:01:45,700
،هذه هي قصّة "أكتيف" التّابع لليابان
.وحدة الهجوم المنتقل الثّالث

29
00:03:04,160 --> 00:03:05,330
ماذا أحضرت الآن؟

30
00:03:06,160 --> 00:03:08,040
.لا شيء من هذا ممتع على الأطلاق

31
00:03:08,040 --> 00:03:09,790
!لا تتصرّف هكذا

32
00:03:10,040 --> 00:03:11,540
.أحضرتُ تشينشيرورين هذه المرّة

33
00:03:12,460 --> 00:03:13,540
—أنا واثق أنّك اليوم ستخـ

34
00:03:13,540 --> 00:03:16,210
،حسنًا، إن لم تلعب معي

35
00:03:16,210 --> 00:03:17,750
.فسأظلّ هنا للأبد

36
00:03:18,800 --> 00:03:20,550
.إذًا، سأبدأ بشرح مبدأ اللّعبة

37
00:03:19,170 --> 00:03:20,090
ما رأيك؟

38
00:03:20,550 --> 00:03:23,390
من المفترض أنّه الفتى الّذي كان
.شريك هاتشيجو توموكي

39
00:03:24,930 --> 00:03:26,600
،لا أعرف كيف أصف الأمر

40
00:03:26,930 --> 00:03:30,430
.لكنّه مختلف تمامًا عن هاتشيجو-سينباي

41
00:03:30,980 --> 00:03:31,730
.فهمت

42
00:03:33,100 --> 00:03:35,360
.هذا فوزي الثّاني بعد الثّلاثين على التّوالي

43
00:03:36,320 --> 00:03:39,110
.يبدو أنّ الحظّ قد هجرك تمامًا

44
00:03:39,440 --> 00:03:42,990
لماذا يلعب كوروكي-سان ألعابًا معه؟

45
00:03:39,440 --> 00:03:42,990
!سُحقًا! كنتُ واثقًا من استطاعتي على الفوز بهذه

46
00:03:42,990 --> 00:03:44,820
.لنلعب مرّة أخرى

47
00:03:42,990 --> 00:03:47,450
من الأفضل أن يتقبّله المجتمع
.لضمان عدم حدوث انتكاسة

48
00:03:47,450 --> 00:03:50,410
،قال كوروكي-كُن أنّه لينجح ذلك

49
00:03:50,410 --> 00:03:52,460
.يحتاج ميثوس ليكون صديقًا مع أحدهم

50
00:03:52,460 --> 00:03:53,670
ماذا؟

51
00:03:53,870 --> 00:03:56,790
يبدو مخيفًا نوعًا ما، لكنّه لطيف، أليس كذلك؟

52
00:03:56,790 --> 00:03:57,420
.نعم

53
00:03:59,090 --> 00:04:00,010
ماذا؟

54
00:04:00,010 --> 00:04:01,470
،رأيتُ هذا حينها أيضًا

55
00:04:01,470 --> 00:04:04,090
.لكنّك تبدين منضبطة وأنت تعملين

56
00:04:04,970 --> 00:04:07,510
لماذا أنت فاشلة في الحياة عندما تكونين في المنزل؟

57
00:04:08,060 --> 00:04:10,390
هل أنا فاشلة بالفعل؟

58
00:04:10,640 --> 00:04:11,850
.نعم، فاشلة

59
00:04:11,850 --> 00:04:13,230
كيف أكون فاشلة؟

60
00:04:13,230 --> 00:04:14,390
!أخبريني

61
00:04:14,390 --> 00:04:16,980
!حسنًا، كبداية، فشلت في إدراك أنّك فاشلة

62
00:04:16,980 --> 00:04:17,730
فشلت؟

63
00:04:18,980 --> 00:04:20,440
...أخبرني أيّها الفتى

64
00:04:21,070 --> 00:04:22,650
أأنت مهتمّ بالخارج؟

65
00:04:24,240 --> 00:04:25,200
.هذا لا يهمّ

66
00:04:25,530 --> 00:04:27,530
.عادت ليكو لطبيعتها

67
00:04:27,910 --> 00:04:30,450
.الفوضى الّتي تسبّبتم بها قد انتهت

68
00:04:31,790 --> 00:04:35,000
—هرب هاتشيجو خارج البلاد بطرق غير قانونيّة

69
00:04:35,000 --> 00:04:36,080
!لا أهتمّ

70
00:04:45,010 --> 00:04:46,430
...ذلك الوغد

71
00:04:56,350 --> 00:04:57,100
—بلا سائق

72
00:04:57,100 --> 00:04:58,190
!أنت بطيء للغاية

73
00:04:58,190 --> 00:04:59,940
!تحرّك بسرعة

74
00:04:59,940 --> 00:05:02,530
.أنا أعتذر على ما حدث البارحة

75
00:04:59,940 --> 00:05:05,450
اسطوانات دوريوغو

76
00:05:02,530 --> 00:05:05,450
.كلاّ، لقد احتجتِ ذلك لحلّ القضيّة

77
00:05:05,450 --> 00:05:08,160
،كلاّ، أنا لم أستعمل غناءك بلا إذن فحسب

78
00:05:08,160 --> 00:05:10,530
!بل جعلتُك تنظّف الفوضى الّتي تبعت ذلك

79
00:05:10,530 --> 00:05:11,620
.عليّ إهداؤك شيئًا ما

80
00:05:11,620 --> 00:05:15,330
.إنّها مسؤوليّتي نوعًا ما لأنّي استدعيتُ الوحدة 9

81
00:05:15,330 --> 00:05:18,000
!لكن لا زلت أشعر بالسّوء

82
00:05:18,000 --> 00:05:19,460
!المعذرة يا أسامي-تشان

83
00:05:19,460 --> 00:05:21,300
.علينا أن نذهب

84
00:05:21,300 --> 00:05:23,260
."حسنًا أيّتها "العظيمة

85
00:05:23,550 --> 00:05:28,340
إذًا سوف نتّجه إلى دافوس من أجل
.المؤتمر العالميّ لمكافحة الإرهاب

86
00:05:28,340 --> 00:05:32,470
سيتمّ تعيين كوروكي-كُن كمسؤول
.عن وحدة الهجوم الثّالث

87
00:05:32,470 --> 00:05:33,890
!مفهوم

88
00:05:33,890 --> 00:05:35,890
.اهتمّ باليابان الغربيّة أيضًا

89
00:05:35,890 --> 00:05:38,060
!دعوا الأمر لي

90
00:05:38,060 --> 00:05:39,350
..."أيّتها "العظيمة

91
00:05:40,940 --> 00:05:42,610
...المعذة أيّتها الرّئيسة

92
00:05:42,610 --> 00:05:45,740
.وضعتُ كلّ المراجع الّتي ستحتاجينها هنا

93
00:05:46,320 --> 00:05:47,950
!خذيها رجاءً

94
00:05:47,950 --> 00:05:49,360
.شـ-شكرًا لك

95
00:05:49,360 --> 00:05:50,700
.اهتمّي بنفسك

96
00:05:51,450 --> 00:05:54,490
رئيس مؤقّت؟ أنت؟

97
00:05:54,490 --> 00:05:55,250
.نعم

98
00:05:54,490 --> 00:05:58,960
الوحدة 8

99
00:05:55,250 --> 00:05:58,960
إن حدث أمر ما، فعليك
...أن تمتثل لأوامري... و

100
00:06:00,330 --> 00:06:02,500
لماذا تبدو غير راضٍ؟

101
00:06:02,840 --> 00:06:06,800
.حسنًا، ستعمل شركتي كما ينصّ العقد ببساطة

102
00:06:08,090 --> 00:06:11,010
هذا هو كرسيّ الرّئيسة؟

103
00:06:11,010 --> 00:06:12,640
.إنّه لا يختلف كثيرًا عن غيره في الحقيقة

104
00:06:12,640 --> 00:06:14,310
.إنّه ملكية حكوميّة قبل كلّ شيء

105
00:06:14,310 --> 00:06:18,980
المعذرة، هنالك شخص ما من وسائل الإعلام
.يرغب في التّحدّث مع الرّئيس المؤقّت

106
00:06:18,980 --> 00:06:19,940
!حسنًا

107
00:06:21,270 --> 00:06:22,190
.خذها كلّها

108
00:06:23,730 --> 00:06:24,940
آخذها كلّها؟

109
00:06:28,400 --> 00:06:30,410
!كوميري-تشان! مرحبًا بك

110
00:06:30,410 --> 00:06:32,030
ماذا؟ كوروكي-سان؟

111
00:06:32,030 --> 00:06:34,160
.أنا الرّئيس المؤقّت الآن

112
00:06:34,160 --> 00:06:35,240
.فهمت

113
00:06:35,740 --> 00:06:37,000
.قد يكون هذا أفضل

114
00:06:37,750 --> 00:06:40,290
.أريد أن أسألك عن شيء بيني وبينك

115
00:06:40,620 --> 00:06:43,750
،بشأن تلك الحادثة الّتي أطاحت بكلّ أنظمة المدينة

116
00:06:43,750 --> 00:06:45,550
...حادثة لوغوس

117
00:06:46,000 --> 00:06:49,340
.هنالك شائعة تقول أنّ فتى قاصرًا كان متورّطًا فيها

118
00:06:49,340 --> 00:06:50,840
فعلاً؟

119
00:06:51,180 --> 00:06:54,810
من الصّعب تخيّل أنّ قاصر تسبّب
...بكلّ هذه الفوضى، لكن

120
00:06:55,430 --> 00:06:57,470
،حسنًا، إن كان هنالك شيء أستطيع قوله

121
00:06:57,470 --> 00:06:59,770
.فهو أنّه ما زال بالإمكان البدء من جديد  في ذلك السّنّ

122
00:07:00,310 --> 00:07:01,270
وهذا كلام بيني وبينك فقط، مفهوم؟

123
00:07:01,520 --> 00:07:04,690
،بينما نحن نتكلّم بيني وبينك فقط
!دعني أسألك شيئًا عن الحاكم إيناغي

124
00:07:04,690 --> 00:07:06,440
هذا ما تسعين إليه إذًا، صحيح؟

125
00:07:07,320 --> 00:07:09,530
!أنا أعتمد عليك أيّها الرّئيس المؤقّت

126
00:07:10,240 --> 00:07:11,450
!أحسنتم العمل اليوم

127
00:07:11,450 --> 00:07:13,370
!حسنًا، نخب الرّئيس المؤقّت

128
00:07:13,370 --> 00:07:14,410
!في صحّتكم

129
00:07:19,120 --> 00:07:23,080
أواثق أنّ هذه فكرة صائبة
مع أنّه ينقصنا موظّفون؟

130
00:07:31,260 --> 00:07:32,550
.تقديم تقرير

131
00:07:32,550 --> 00:07:34,720
.الطّريق السّريع 6، النّقطة باء، لا شيء

132
00:07:35,010 --> 00:07:36,970
.تمّ تحديد مركبة يُعتقد أنّها الهدف

133
00:07:36,970 --> 00:07:37,970
.سوف نطاردها

134
00:07:37,970 --> 00:07:39,020
!لا تستخفّوا بنا

135
00:07:43,270 --> 00:07:44,310
.تمّت مشاهدة الهدف

136
00:07:44,900 --> 00:07:46,150
!لا يركبها أيّ أحد

137
00:07:46,150 --> 00:07:48,730
إنّها تطابق التّقرير. مركبة بلا سائق
تتمّ قيادتها عن بعد؟

138
00:07:49,820 --> 00:07:51,650
!كلاّ! هنالك أحد المشاة على الطّريق

139
00:07:55,570 --> 00:07:57,780
!فقدتم الهدّف؟

140
00:07:58,830 --> 00:08:01,660
...أعتقد أنّ علينا الاتّصال بالوحدة 8

141
00:08:05,710 --> 00:08:06,380
.مرحبًا

142
00:08:06,380 --> 00:08:07,790
ما الأمر الآن؟

143
00:08:07,790 --> 00:08:09,750
.هنالك أمر أردتُ أن أسألك عنه

144
00:08:10,050 --> 00:08:12,340
...الويلوير الّذي استعملتَه من قبل

145
00:08:12,340 --> 00:08:14,130
هل كان لديك واحد ثانٍ جاهز؟

146
00:08:14,720 --> 00:08:16,050
فري ديلتا؟

147
00:08:16,600 --> 00:08:17,260
.كلاّ

148
00:08:17,260 --> 00:08:19,720
لم تُعطه لشخص آخر ثانية، صحيح؟

149
00:08:20,600 --> 00:08:22,430
لم تعطي أوامر من هنا؟

150
00:08:22,430 --> 00:08:25,560
هل الأمن ضعيف إلى هذا الحدّ في هذا السّجن؟

151
00:08:25,560 --> 00:08:27,190
!هذا منزل آمن

152
00:08:27,650 --> 00:08:31,780
إذًا هنالك شخص ما في مكان ما
يستعمل نفس الويلوير

153
00:08:31,780 --> 00:08:33,900
.للتّسبّب في مشاكل

154
00:08:34,150 --> 00:08:35,570
أأنا محقّ في كلامي؟

155
00:08:37,820 --> 00:08:38,580
ما رأيك؟

156
00:08:39,200 --> 00:08:40,990
.هذا هو فري ديلتا بالتّأكيد

157
00:08:41,660 --> 00:08:44,160
.لكنّه لا يبدو أنّه معدّل كالّذي كان لديّ

158
00:08:44,460 --> 00:08:46,630
من يكون في اعتقادك وما الّذي يخطّط له؟

159
00:08:46,630 --> 00:08:49,380
لماذا عليّ أن أجيب على ذلك؟

160
00:08:50,460 --> 00:08:51,550
.هذا صحيح

161
00:08:51,880 --> 00:08:53,670
.إلى اللّقاء إذًا. سأعود لاحقًا

162
00:08:58,260 --> 00:08:59,300
!الإشارة

163
00:08:59,300 --> 00:09:00,220
!اضغط على الفرامل

164
00:09:04,560 --> 00:09:05,480
!سُحقًا

165
00:09:05,770 --> 00:09:07,150
.معكم السّيّارة رقم 4

166
00:09:06,190 --> 00:09:09,940
لماذا تتغيّر إشارات المرور دائمًا لتناسب المركبة؟

167
00:09:07,150 --> 00:09:10,440
.فقدنا الهدف قرب المدرسة الابتدائيّة الشّرقيّة
.نطلب الدّعم في الحال

168
00:09:11,190 --> 00:09:13,400
.درّاجة ناريّة غامضة تجول بتهوّر في المدينة

169
00:09:13,690 --> 00:09:17,360
استطاعت التّخلّص من مطاردة وحدة
.المرور المتنقّلة التّابعة للشّرطة مرّات عدّة

170
00:09:17,610 --> 00:09:19,240
ما هو هدفها؟

171
00:09:19,530 --> 00:09:22,040
هل ستخرج اللّيلة أيضًا؟

172
00:09:22,370 --> 00:09:24,450
.بهذا ينتهي تقريري من مكان الحادث

173
00:09:25,000 --> 00:09:28,630
.لا أصدّق أنّنا لا نستطيع الخروج إلى هناك

174
00:09:28,630 --> 00:09:32,050
...كبرياء المسؤولين في تحقيقات المرور يمنعهم

175
00:09:32,050 --> 00:09:35,170
،ألهذا السّبب لم يطلبوا منّا دعمًا بعد

176
00:09:35,170 --> 00:09:36,840
رغم أنّها مسألة تتعلّق بالويلوير؟

177
00:09:36,840 --> 00:09:38,050
،ومع ذلك

178
00:09:38,050 --> 00:09:41,010
.إنّها ليست حادثة بمعنى الكلمة

179
00:09:41,010 --> 00:09:43,770
.نعم، إنّها انتهاكات مروريّة فحسب

180
00:09:44,470 --> 00:09:45,980
،بالتّفكير بالأمر

181
00:09:45,980 --> 00:09:48,480
.قال رجال وحدة المرور المتنقّلة شيئًا غريبًا

182
00:09:48,770 --> 00:09:52,690
تتغيّر إشارات المرور للّون الأخضر
.حيثما تذهب الدّرّاجة

183
00:09:52,690 --> 00:09:57,150
هل هذا يعني أنّ هنالك من اخترق النّظام
ويتحكّم في إشارات المرور؟

184
00:09:57,150 --> 00:09:58,660
،كلاّ، بشأن ذلك

185
00:09:58,910 --> 00:10:02,120
.قال مركز مراقبة المرور أنّ ذلك لم يحدث

186
00:10:02,490 --> 00:10:05,120
،لا يوجد أثر لأيّ اختراق

187
00:10:05,120 --> 00:10:08,330
.والإشارات تعمل بشكل عاديّ

188
00:10:08,330 --> 00:10:09,540
...هذا يعني

189
00:10:09,870 --> 00:10:12,790
أنّهم يتحكّمون بالإشارات مباشرة في عين المكان؟

190
00:10:12,790 --> 00:10:14,460
!حسنًا أيّتها الضّابطة الدّوريّة كابوراغي

191
00:10:14,460 --> 00:10:15,300
!نـ-نعم

192
00:10:15,590 --> 00:10:17,380
.سوف تذهبين لاستجواب النّاس في عين المكان

193
00:10:17,380 --> 00:10:20,390
...ماذا؟! أنا سأخرج لعين المكان؟ أنا... أنا

194
00:10:20,390 --> 00:10:22,390
.أمنحك الإذن باستعمال نظّاراتك

195
00:10:26,100 --> 00:10:27,730
كيف الأحوال مؤخّرًا؟

196
00:10:27,730 --> 00:10:29,270
...جيّدة، على ما أظنّ

197
00:10:29,640 --> 00:10:31,230
هلّي بطرح سؤال عليكما؟

198
00:10:32,520 --> 00:10:35,320
.أعتقد أنّ باستطاعتها فعل هذا

199
00:10:36,070 --> 00:10:37,190
!المعذرة

200
00:10:37,190 --> 00:10:37,900
!ماذا؟

201
00:10:38,150 --> 00:10:39,700
...هل رأيتم

202
00:10:38,450 --> 00:10:39,700
أهلاً، أأنت بمفردك؟

203
00:10:39,700 --> 00:10:41,490
.أعرف مكانًا يمكنك جني الكثير منه

204
00:10:41,820 --> 00:10:43,700
هل سبق وسمعتنّ عن "الدّرّاجة الشّبح"؟

205
00:10:42,240 --> 00:10:43,700
هل أنت من مجلّة ما أو قناة تلفزيّة؟

206
00:10:43,700 --> 00:10:45,040
!هذا مضحك

207
00:10:47,040 --> 00:10:49,580
سألت في كلّ أرجاء المدينة

208
00:10:49,580 --> 00:10:51,460
ولم يرَ أحد أيّ شخص مشبوه

209
00:10:51,460 --> 00:10:55,000
قرب لوحة التّحكّم في الإشارات
.أثناء حوادث الويلوير الدّرّاجة

210
00:10:55,000 --> 00:10:56,250
.أحسنتِ عملاً

211
00:10:56,250 --> 00:10:58,720
أنا مندهشة أنّك جمعتِ هذا القدر
!من المعلومات من شهود عيان

212
00:10:58,720 --> 00:11:04,350
أجل، العديد من الأشخاص الّذين يقومون بوقفات
.طويلة في محطّات التّزوّد في سباق الحياة قد ساعدوني

213
00:11:04,350 --> 00:11:06,930
،إن سمعتك الصّحافة تقولين هذا
!سيكون هنالك جلبة كبيرة

214
00:11:07,270 --> 00:11:08,930
.سوف أستعيد هذه

215
00:11:08,930 --> 00:11:10,940
...كلاّ! أرجوك لا

216
00:11:09,680 --> 00:11:10,940
.آسفة

217
00:11:10,940 --> 00:11:12,850
.أوامر الرّئيس المؤقّت

218
00:11:12,850 --> 00:11:13,860
!هذا صحيح

219
00:11:13,860 --> 00:11:15,860
...لا تحتاجين للاعتماد عليها

220
00:11:15,860 --> 00:11:17,690
ماذا هنالك؟

221
00:11:17,690 --> 00:11:20,820
.تقارير شهود طلبتُ من أحد معارفي أن يجمعها

222
00:11:21,200 --> 00:11:22,610
.بشأن ذلك الويلوير

223
00:11:22,610 --> 00:11:23,780
.شكرًا

224
00:11:25,990 --> 00:11:28,120
...إذًا فويلوير الدّرّاجة ذاك

225
00:11:28,370 --> 00:11:32,370
.تتحوّل الإشارات للّون الأخضر أينما ذهب

226
00:11:32,750 --> 00:11:34,880
.يقول مركز مراقبة المرور أنّه لا يوجد خطأ

227
00:11:35,130 --> 00:11:37,880
.ولا توجد علامات لتعديل الإشارات بشكل مباشر

228
00:11:38,130 --> 00:11:39,170
كيف يحدث ذلك إذًا؟

229
00:11:42,260 --> 00:11:43,890
يستعمل مركز المراقبة

230
00:11:44,180 --> 00:11:47,510
بيانات الطّرقات على مستويات حركات المرور

231
00:11:47,510 --> 00:11:50,850
.بغرض تعديل الإشارات لتجنّب الازدحام

232
00:11:51,520 --> 00:11:55,610
إن قام أحدهم بإعادة كتابة بيانات
...تدفّق حركة المرور

233
00:11:56,190 --> 00:11:57,150
فما الّذي سيحدث؟

234
00:11:58,110 --> 00:11:59,230
هل يمكنني أن أريك ذلك؟

235
00:11:59,230 --> 00:12:01,150
أتستطيع فعل هذا؟

236
00:12:01,150 --> 00:12:02,030
!مهلاً

237
00:12:01,400 --> 00:12:02,820
...كلاّ

238
00:12:02,820 --> 00:12:05,740
!لن أسمح لك باستعمال الإنترنيت

239
00:12:12,290 --> 00:12:14,120
.استيقظ، طلع الصّباح

240
00:12:16,750 --> 00:12:18,040
بقيت هنا طوال اللّيل؟

241
00:12:18,750 --> 00:12:22,340
.كنتُ أتجوّل في كلّ مكان حتّى فاتني آخر قطار

242
00:12:22,880 --> 00:12:25,550
.صباح الخير

243
00:12:25,550 --> 00:12:26,850
كيف سار الأمر؟

244
00:12:26,850 --> 00:12:32,310
،قال قسم تحقيق المرور أنّ هذه قضيّتهم
.وأنّهم لا يحتاجوننا

245
00:12:32,310 --> 00:12:35,230
إذًا لماذا لا ندّعي أنّنا نحقّق في أمر

246
00:12:35,230 --> 00:12:36,900
شاشات مراقبة حركات المرور؟

247
00:12:36,900 --> 00:12:38,150
...فهمت

248
00:12:38,440 --> 00:12:39,360
!حسنًا

249
00:12:39,360 --> 00:12:42,650
!وحدة الهجوم المتنقّل الثّالث الثّامنة، انطلقي

250
00:12:42,650 --> 00:12:45,110
أردتَ قول ذلك فحسب، صحيح؟

251
00:12:53,830 --> 00:12:57,920
إن كنّا نحقّق في أمر شاشات مراقبة
حركات المرور، فلماذا نتابع هذا؟

252
00:12:59,670 --> 00:13:03,510
على الأرجح أنّ الرّئيس المؤقّت
.أراد فعل ذلك فحسب

253
00:13:03,840 --> 00:13:06,590
.كوروكي-سان، ظهرت الدّرّاجة الشّبح

254
00:13:08,300 --> 00:13:10,850
!يصبح الحظّ السّعيد مفيدًا في أوقات كهذه

255
00:13:11,510 --> 00:13:13,350
.هذه الوحدة المتنقّلة 105

256
00:13:13,350 --> 00:13:15,350
.نتّجه جنوبًا في الطّريق السّريع 16

257
00:13:15,350 --> 00:13:16,060
...أعيد

258
00:13:18,020 --> 00:13:19,150
!كنتَ على حقّ

259
00:13:19,150 --> 00:13:21,780
!البيانات لا تتناسب مع حركات المرور الحقيقيّة

260
00:13:21,780 --> 00:13:24,030
.حسنًا، سأذهب وأحلّ القضيّة

261
00:13:24,280 --> 00:13:26,280
.كلاّ. لا تملك الإذن بذلك

262
00:13:26,280 --> 00:13:27,990
.هذا لا يهمّ. بإمكاننا الحصول عليه لاحقًا

263
00:13:27,990 --> 00:13:29,070
.بل هذا مهمّ

264
00:13:29,070 --> 00:13:30,660
—إن كانت هنالك مشكلة، فسوف

265
00:13:30,660 --> 00:13:34,040
.غدوتَ مملاًّ منذ أن أصبحت مدنيًّا

266
00:13:34,040 --> 00:13:34,950
ماذا قلت؟

267
00:13:34,950 --> 00:13:36,660
—موظّفو القطاع العامّ هم من لديهم راتب ثابت

268
00:13:36,660 --> 00:13:39,460
!أنت من ألقى بذلك الرّاتب الثّابت عرض الحائط

269
00:13:40,380 --> 00:13:42,500
...هذا وقت مناسب لأطرح عليك هذا السّؤال

270
00:13:42,500 --> 00:13:44,550
لماذا تركت الشّرطة؟

271
00:13:44,550 --> 00:13:46,170
.كنتَ تترقّى بسرعة كبيرة

272
00:13:46,170 --> 00:13:47,590
.سبق وأخبرتك

273
00:13:47,590 --> 00:13:50,720
قمتُ بذلك لأتحمّل مسؤولية الانطلاق
—بلا إذن خلال حادثة لوغوس

274
00:13:50,720 --> 00:13:53,390
!قال رئيس الشّرطة أنّه لا داعي لذلك

275
00:13:53,390 --> 00:13:53,970
...هذا

276
00:13:53,970 --> 00:13:56,100
.أنت ضعيف ذهنيًّا

277
00:13:56,100 --> 00:13:57,690
.تهرب كلّما ساءت الأمور

278
00:13:58,020 --> 00:13:59,060
.أراهن أنّي أعرف السّبب

279
00:13:59,060 --> 00:14:01,560
!أردتَ الابتعاد عن الملازم أوشيكوتشي

280
00:14:01,560 --> 00:14:03,440
!أيّها الوغد

281
00:14:03,440 --> 00:14:05,490
لقد تركتَ مسيرتك المهنيّة
.السّريعة مع وزارة الدّفاع

282
00:14:05,490 --> 00:14:07,280
.وتركتَ مسيرتك المهنيّة السّريعة مع الشّرطة

283
00:14:07,280 --> 00:14:09,110
!ما الّذي تحاول تحقيقه؟

284
00:14:09,110 --> 00:14:10,570
!هذا ليس من شأنك

285
00:14:10,570 --> 00:14:14,370
!إذًا لماذا أنت مرتاح هكذا بشأن التّرقيات؟

286
00:14:14,370 --> 00:14:15,660
!ما الّذي تعنيه بمرتاح؟

287
00:14:14,990 --> 00:14:16,960
.توقّفا أنتما الاثنان

288
00:14:15,660 --> 00:14:18,080
!هذا ما أكره فيك

289
00:14:16,960 --> 00:14:18,080
!اسمعا

290
00:14:18,670 --> 00:14:21,170
.الويلوير بدون سائق قد اختفى

291
00:14:22,210 --> 00:14:23,000
.حسنًا

292
00:14:25,090 --> 00:14:25,760
.مرحبًا

293
00:14:25,760 --> 00:14:27,050
ماذا هنالك؟

294
00:14:27,300 --> 00:14:29,090
.كنتَ على حقّ

295
00:14:29,380 --> 00:14:31,720
.تمّ تعديل بيانات حركة المرور

296
00:14:32,050 --> 00:14:33,010
.هكذا إذًا

297
00:14:33,010 --> 00:14:36,020
لكن ما الّذي يحاول ذلك الويلوير فعله؟

298
00:14:36,020 --> 00:14:38,060
،إنّه يظهر في كلّ أرجاء المدينة

299
00:14:38,060 --> 00:14:40,440
.وكأنّه يريد أنّ يعبث معنا فحسب

300
00:14:40,850 --> 00:14:43,400
.إنّه يُسابقنا لبعض الوقت ثمّ يختفي

301
00:14:43,860 --> 00:14:46,400
أماكن ظهوره عشوائيّة للغاية
.ولا نستطيع استعمال نقاط التّفتيش

302
00:14:46,730 --> 00:14:49,320
...ليتنا نستطيع أن نتوقّع أين سيظهر ثانية

303
00:14:49,610 --> 00:14:50,780
ماذا عن طرق العبور؟

304
00:14:52,030 --> 00:14:54,370
.تتبّعوا الطّرق الّتي مرّ عليها

305
00:14:58,710 --> 00:14:59,830
كيف يسير الأمر؟

306
00:14:59,830 --> 00:15:03,670
،لقد تعقّبنا طرف العبور الّتي استعملها الهدف

307
00:15:03,670 --> 00:15:06,630
.ثمّ استبعدنا كلّ شيء عدا الّتي استعملها مرّات عدّة

308
00:15:06,630 --> 00:15:07,710
.هذا ما بقي لنا

309
00:15:12,340 --> 00:15:13,470
رايدر"؟"

310
00:15:13,470 --> 00:15:15,100
تعني راكب، فهل هذا لأنّه يستعمل درّاجة؟

311
00:15:15,100 --> 00:15:17,350
!إنّه يعبث معنا

312
00:15:17,680 --> 00:15:20,060
ألا يعني هذا أنّ الأمر قد انتهى؟

313
00:15:20,060 --> 00:15:22,650
."أعتقد أنّ الحرف التّالي سيكون "إس" أي "راكبون

314
00:15:22,900 --> 00:15:24,860
،أو بما أنّها بلا سائق

315
00:15:24,860 --> 00:15:27,480
."قد يكون حرف "إل" في "رايدرليس" أي "بلا راكب

316
00:15:27,480 --> 00:15:30,360
بإمكانه التّوجّه شرقًا أسفل يمين الشّاشة؟

317
00:15:30,360 --> 00:15:32,360
هل علينا إخبار مقرّ الشّرطة الرّئيسيّ؟

318
00:15:33,530 --> 00:15:37,200
"بإمكاننا إخبارهم بمسألة "رايدر
.وإشارات المرور الخضراء

319
00:15:37,200 --> 00:15:39,540
.لدينا الكثير من العمل بالنّسبة للأشياء الأخرى

320
00:15:39,540 --> 00:15:42,170
.حسنًا. سنطلعهم بذلك عندما نتاكّد

321
00:15:42,420 --> 00:15:43,790
.إذًا، اهتمّي بالاتّصال بهم

322
00:15:44,040 --> 00:15:45,130
إلى أين أنت ذاهب؟

323
00:15:45,130 --> 00:15:46,670
.ذاهب لسماع البقيّة

324
00:15:46,670 --> 00:15:47,710
لسماع البقيّة؟

325
00:15:47,710 --> 00:15:48,630
ممّن؟

326
00:15:48,630 --> 00:15:49,460
.لا أدري

327
00:15:50,630 --> 00:15:52,340
.كنتَ على حقّ

328
00:15:52,340 --> 00:15:56,100
."تتبّعنا طريق العبور، وظهرت العبارة "رايدر

329
00:15:56,100 --> 00:15:57,060
هكذا إذًا؟

330
00:15:57,060 --> 00:15:59,430
...أتساءل أين سيظهر الآن

331
00:15:59,430 --> 00:16:01,560
!وأيّ حرف سيكون

332
00:16:02,890 --> 00:16:06,110
هل تستفيد شيئًا من عدم إخباري بكلّ شيء؟

333
00:16:06,110 --> 00:16:08,230
.أكره القيام بالأمور على هذا النّحو

334
00:16:08,230 --> 00:16:10,440
.أخبرني بكلّ المعلومات عنه

335
00:16:10,820 --> 00:16:11,990
.معك حقّ

336
00:16:14,820 --> 00:16:18,790
،إن كنت تقصد هاتشيجو... بل بيرد

337
00:16:19,290 --> 00:16:21,540
.فما خفي كان أعظم

338
00:16:22,120 --> 00:16:24,870
،لقد ارتادت نفس المدرسة مع هويّة بيرد العموميّة

339
00:16:24,870 --> 00:16:27,250
.تلميذ الثّانوية هاتشيبجو توموكي

340
00:16:28,040 --> 00:16:29,170
.لا تقلقي

341
00:16:29,170 --> 00:16:31,340
.لن يؤذيك

342
00:16:31,710 --> 00:16:34,090
.أنا سعيدة بلقائك

343
00:16:34,680 --> 00:16:36,970
.كلاّ، هذا ليس أوّل لقاء لنا

344
00:16:38,010 --> 00:16:40,470
.كنتُ أبحث في أمر بيرد عندما عثرتُ عليك

345
00:16:41,470 --> 00:16:45,350
كيف كان هاتشيجو-سينباي الّذي عرفتَه؟

346
00:16:46,440 --> 00:16:48,310
.هذه هي ملفّات تحقيقاتنا

347
00:16:48,610 --> 00:16:50,070
.راجعاها معًا

348
00:16:50,070 --> 00:16:51,110
أهذا مسموح؟

349
00:16:51,110 --> 00:16:52,860
.لا زلنا نراقبك من باب الحيطة

350
00:16:53,150 --> 00:16:54,900
.ما كان عليه قول ذلك

351
00:16:55,280 --> 00:16:58,700
لكن أليس هذا أحد أسلحته؟

352
00:17:01,950 --> 00:17:04,120
.لا تنظر إلى أيّ شيء لا تحتاجه

353
00:17:04,540 --> 00:17:06,040
."الحرف التّالي سيكون "إي

354
00:17:06,920 --> 00:17:08,040
.من الجهة الغربيّة

355
00:17:08,420 --> 00:17:10,250
.إنّه في يسار هذه الشّاشة

356
00:17:10,250 --> 00:17:12,050
الحرف "إي" في اليسار؟

357
00:17:12,050 --> 00:17:13,510
إيرايدر"؟"

358
00:17:14,590 --> 00:17:17,970
لقد تعرّفنا على النّقطة التّالية الّتي ستظهر
،فيها الدّرّاجة النّاريّة الّتي بلا سائق

359
00:17:17,970 --> 00:17:20,180
.باستعمال طرق العبور هذه حتّى الآن

360
00:17:20,180 --> 00:17:22,560
.نعتقد أنّ المجرم يقوم بهذا من أجل المتعة

361
00:17:22,560 --> 00:17:25,600
"سنقوم بإنشاء حاجز حول منطقة "إل

362
00:17:25,600 --> 00:17:27,100
.ونوزّع رجالنا هناك

363
00:17:27,100 --> 00:17:27,810
!حاضر

364
00:17:29,650 --> 00:17:31,730
.هذا الفريق ألِف. نحن في موضعنا

365
00:17:31,730 --> 00:17:34,440
.الفريقان باء وسين سيصلان قريبًا

366
00:17:33,320 --> 00:17:36,570
.يحاصر قسم المرور المتنقّل النّقطة "إل" إذًا

367
00:17:36,570 --> 00:17:39,990
.سنذهب نحن إلى النّقطة "إي" في الجانب الآخر

368
00:17:39,990 --> 00:17:42,660
لا يوجد أيّ ضرر في مراقبة الجانبين معًا، صحيح؟

369
00:17:42,660 --> 00:17:45,290
