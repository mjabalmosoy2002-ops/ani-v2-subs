1
00:00:07,020 --> 00:00:08,940
!الجوّ ساخن

2
00:00:08,940 --> 00:00:12,020
...إنّه يصبح أسخن يومًا بعد يوم

3
00:00:12,020 --> 00:00:14,390
.يقولون أنّ صيف هذا العام سيكون ساخنًا

4
00:00:14,390 --> 00:00:16,920
.آسفات لأنّنا نأتي إلى هنا من أجل التّكييف

5
00:00:16,920 --> 00:00:19,490
.أعرف أنّكما لا تتحمّلان الحرارة بسبب طبيعتكما

6
00:00:19,490 --> 00:00:22,540
!هذا صحيح! لا داعي لتكوني خجولة يا يوكّي

7
00:00:22,540 --> 00:00:23,810
.لكنّ هذا مزعج نوعًا ما

8
00:00:23,810 --> 00:00:27,320
.جوّ هذا العام ساخن بشكل عامّ
.ولي ليس لهما فحسب

9
00:00:27,320 --> 00:00:28,420
.هذا صحيح

10
00:00:28,420 --> 00:00:30,940
،مع اقتراب ذروة الصّيف

11
00:00:30,940 --> 00:00:34,010
،علينا أن نأخذ بالاعتبار ما يمكن للدّيمي
،وخاصّة هيكاري ويوكي

12
00:00:34,010 --> 00:00:35,390
.فعله لكي يتجاوزوه

13
00:00:35,390 --> 00:00:36,580
.هذه فكرة جيّدة

14
00:00:36,580 --> 00:00:39,610
.أنا قلقة بشأن كيفية قضاء الصّيف في كلّ عام

15
00:00:39,610 --> 00:00:42,730
إنّ الوضع صعب للغاية عليك
وعلى هيكاري مسبقًا، صحيح؟

16
00:00:42,730 --> 00:00:45,480
!سينسي، هذا رائع! لنقم بذلك الآن! الآن

17
00:00:45,480 --> 00:00:46,720
.ليس الآن

18
00:00:46,720 --> 00:00:48,490
ماذا؟ لِمَ لا؟

19
00:00:48,490 --> 00:00:49,860
.لقد تأخّر الوقت

20
00:00:50,130 --> 00:00:52,750
.كما أنّي أريد التّفكير بالأمر بمفردي أوّلاً

21
00:00:52,750 --> 00:00:53,760
غدًا إذًا؟

22
00:00:53,760 --> 00:00:55,190
...حسنًا، لنرَ

23
00:00:55,190 --> 00:00:56,660
ماذا عن يوم السّبت؟

24
00:00:56,660 --> 00:00:59,290
.سيكون لدينا الكثير من الوقت يوم السّبت

25
00:00:59,290 --> 00:01:01,040
!أنا موافقة

26
00:01:00,740 --> 00:01:04,830
كيف يمكن لمصّاصي الدّماء ونساء الثّلج
قضاء فصل الصّيف بشكل مريح

27
00:02:41,760 --> 00:02:43,070
...يا تيتسو-سينسي

28
00:02:44,550 --> 00:02:47,440
،سوف نلعب كرة القدم بعد المدرسة
.لكن ينقصنا اللاّعبون

29
00:02:47,440 --> 00:02:49,030
هل يمكنك اللّعب كحارسنا؟

30
00:02:49,030 --> 00:02:50,370
.كلاّ، لن ألعب

31
00:02:50,370 --> 00:02:52,500
لِمَ لا؟ ليس لديك شيء آخر لتفعله، صحيح؟

32
00:02:52,500 --> 00:02:55,020
من هم المدرّسون بالضّبط في اعتقادك؟

33
00:02:55,420 --> 00:02:57,710
.في كلّ الأحوال، لا أستطيع اليوم

34
00:02:57,710 --> 00:03:01,620
أنا أعمل على خطّة لمساعدة يوكي
.وهيكاري على تجاوز الصّيف بشكل مريح

35
00:03:01,620 --> 00:03:03,120
ماذا؟ ذلك مجدّدًا؟

36
00:03:03,440 --> 00:03:04,000
ماذا؟

37
00:03:04,000 --> 00:03:06,630
أصبحتَ مدرّس الدّيمي-تشان الخاصّ، صحيح؟

38
00:03:06,630 --> 00:03:08,400
ماذا؟ فعلاً؟

39
00:03:08,400 --> 00:03:09,810
!نعم، أنت كذلك

40
00:03:09,810 --> 00:03:13,540
!أنت الوحيد الّذي يتحدّثن معه بشأن أجسادهنّ

41
00:03:14,210 --> 00:03:15,490
فعلاً؟

42
00:03:15,490 --> 00:03:16,500
.هذا صحيح

43
00:03:17,460 --> 00:03:19,260
...نائب المدير

44
00:03:19,640 --> 00:03:20,560
.مرحبًا

45
00:03:20,560 --> 00:03:26,260
تقديم الإرشاد لتلميذاتنا أنصاف البشر
.هو أمر جيّد للغاية

46
00:03:26,260 --> 00:03:30,370
.لكنّ العمل بشكل مبالغ فيه قد يسبّب المشاكل

47
00:03:30,370 --> 00:03:34,480
عليك أن تعير انتباهًا أكثر للتّلاميذ
.الّذين ليسوا أنصاف بشر أيضًا

48
00:03:34,480 --> 00:03:35,810
...صـ-صحيح

49
00:03:36,370 --> 00:03:40,680
كلاّ، أظنّ أنّ تيتسو-سينسي يهتمّ
!بالتّلاميذ غير الدّيمي جيّدًا أيضًا

50
00:03:41,030 --> 00:03:42,560
.يا-يا سيّدي

51
00:03:42,560 --> 00:03:47,560
إذًا لماذا تعتمد التّلميذات أنصاف البشر
على تاكاهاشي-سينسي وحده؟

52
00:03:47,780 --> 00:03:48,830
...ذلك

53
00:03:50,790 --> 00:03:52,770
.أنت تبذل جهدًا مبالغًا فيه

54
00:03:53,460 --> 00:03:56,480
،إن كبحتَ جماحك بعض الشّيء

55
00:03:56,480 --> 00:03:59,550
فإنّ اعتماد أنصاف البشر عليك
.سيقلّ بشكل طبيعيّ

56
00:03:59,870 --> 00:04:00,950
—لكنّي

57
00:04:00,950 --> 00:04:03,070
هل تظنّ أنّ امتلاك هؤلاء التّلميذات

58
00:04:03,070 --> 00:04:07,010
لأيّ أحد آخر غيرك ليعتمدن عليه أمر جيّد؟

59
00:04:07,700 --> 00:04:12,600
،قد يأخذ الأمر بعض الوقت
،لكن بدل الاعتماد عليك وحدك

60
00:04:12,020 --> 00:04:16,360
كيف يمكن لمصّاصي الدّماء ونساء الثّلج
قضاء فصل الصّيف بشكل مريح
تاكاهاشي تيتسوو

61
00:04:12,600 --> 00:04:16,360
يمكنهمنّ حلّ مشاكلهنّ عن طريق
.التّفاعل مع بقيّة النّاس

62
00:04:16,660 --> 00:04:18,860
ألن يكون ذلك مسارًا طبيعيًّا أكثر؟

63
00:04:21,970 --> 00:04:25,220
.ذلك... قد يكون صحيحًا

64
00:04:27,340 --> 00:04:30,570
.لكنّي أفهم وجهة نظر نائب المدير

65
00:04:31,600 --> 00:04:34,080
.تيتسو-سينسي ليس المدرّس الوحيد في المدرسة

66
00:04:34,080 --> 00:04:36,790
إن كان بمقدورهنّ الرّجوع لأشخاص
كثيرين، ألن يكون ذلك أفضل؟

67
00:04:36,790 --> 00:04:39,590
هل سيصبح الحال هكذا إن توقّف
تيتسو-سينسي عن المحاولة؟

68
00:04:39,590 --> 00:04:40,740
ألا تظنّ ذلك؟

69
00:04:40,740 --> 00:04:42,170
.هذا ما قاله نائب المدير

70
00:04:42,700 --> 00:04:44,240
!ساتاكي-كُن

71
00:04:44,240 --> 00:04:46,270
...أرجوك يا ساتاكي

72
00:04:46,270 --> 00:04:48,170
!ساتاكي-كيون

73
00:04:48,790 --> 00:04:51,920
،إن توقّف عن المحاولة
فهل سيلتجئن لي بدلاً منه؟

74
00:04:51,920 --> 00:04:54,440
حسنًا، لا أدري إن كنّ سيلتجئن
.إليك أنت على وجه الخصوص

75
00:04:58,540 --> 00:04:59,230
.آسف

76
00:04:59,680 --> 00:05:01,730
.كنتُ أحاول تمريرها

77
00:05:01,730 --> 00:05:03,720
هذا ما قاله؟

78
00:05:03,720 --> 00:05:06,440
بالتّفكير بالأمر، إنّهنّ لم يطلبن
.مساعدتي أبدًا أيضًا

79
00:05:06,440 --> 00:05:07,680
.نعم، أراهن على ذلك

80
00:05:07,680 --> 00:05:09,830
.قد تكونين آخر خيار لهنّ

81
00:05:09,830 --> 00:05:10,500
ماذا؟

82
00:05:10,500 --> 00:05:12,270
!آ-آسف

83
00:05:12,270 --> 00:05:17,010
على أيّ حال، أتساءل ما الأشياء التّي تحتاج
.الدّيمي-تشان النّصح بشأنها

84
00:05:17,010 --> 00:05:20,960
لا يختلف أنصاف البشر عن البشر
العاديّين، صحيح؟

85
00:05:20,960 --> 00:05:24,390
قالت كوساكابي وتاكاناشي أنّهما
.لا يتحمّلان الحرّ كثيرًا

86
00:05:24,390 --> 00:05:26,970
لقد كان يتساءل عن طريقة ليتجاوزن
."الصّيف بشكل "مريح

87
00:05:26,970 --> 00:05:30,080
هل عليهنّ بالفعل الاعتماد على تاكاهاشي
حتّى بشأن أصغر الأشياء كهذه؟

88
00:05:30,970 --> 00:05:31,810
!ربّما هذه هي

89
00:05:32,740 --> 00:05:35,280
،تشرب تاكاناشي الكثير من عصير الطّماطم

90
00:05:35,280 --> 00:05:37,670
.لذلك ربّما يمكنك أن تسأليها ما النّوع الأفضل

91
00:05:37,670 --> 00:05:39,350
.ابحث عن ذلك في الإنترنت

92
00:05:39,350 --> 00:05:41,240
!وكأنّ التّعليقات على الإنترنت تجدي نفعًا

93
00:05:41,240 --> 00:05:41,900
!اخرس

94
00:05:43,840 --> 00:05:44,570
أتعلمون؟

95
00:05:45,490 --> 00:05:47,860
هل علينا أن نعتبر الدّيمي

96
00:05:47,860 --> 00:05:50,540
بشرًا كبقيّتنا تمامًا؟

97
00:05:50,540 --> 00:05:51,120
ماذا؟

98
00:05:51,120 --> 00:05:53,030
...مهلاً، هذا

99
00:05:53,030 --> 00:05:54,750
هل تقولين أنّهنّ لسن كذلك؟

100
00:05:54,750 --> 00:05:56,290
!هذا تمييز

101
00:05:56,290 --> 00:05:57,570
فعلاً؟

102
00:05:57,570 --> 00:06:01,890
،سابقًا، قلتَ أنّهنّ مثل البشر العاديّين

103
00:06:01,890 --> 00:06:05,300
لكنّ ذلك يعني أنّ هنالك شيئًا ما
مختلفًا بشأنهنّ، صحيح؟

104
00:06:06,260 --> 00:06:09,060
...تجاهُل ذلك ومعاملتهنّ كأنّهنّ بشر عاديّون

105
00:06:09,060 --> 00:06:12,050
ألن يكون ذلك هو التّمييز الحقيقيّ؟

106
00:06:12,500 --> 00:06:13,890
أظنّ أنّ تاكاهاشي

107
00:06:13,890 --> 00:06:17,920
.يدرك ذلك تمامًا، بما فيها تلك الجوانب منهنّ

108
00:06:18,400 --> 00:06:21,690
ولهذا السّبب على الأرجح يجدنه
.أسهل ليضعن ثقتهنّ فيه

109
00:06:22,060 --> 00:06:24,410
ماذا عنّا نحن؟

110
00:06:24,410 --> 00:06:27,520
هل يمكن لإحدى الدّيمي أن تطلب النّصح منّا

111
00:06:27,520 --> 00:06:30,490
ونحن نعتقد أنّهنّ بشر عاديّون
على نحو أعمى؟

112
00:06:30,820 --> 00:06:33,620
ألن يخيفهنّ ذلك؟ ويتطلّب حزمًا؟

113
00:06:34,340 --> 00:06:36,650
،ربّما يردن أن يكنّ مرتاحات أكثر

114
00:06:36,650 --> 00:06:39,290
في طلب المساعدة أو الحديث
.عن أمور أنصاف البشر

115
00:06:39,860 --> 00:06:44,670
أظنّ أنّنا لا نعرف بالفعل أيّ شيء
...عنهنّ على الإطلاق

116
00:06:45,620 --> 00:06:49,270
.على الأقلّ، هذا ما كان يدور في بالي

117
00:06:51,200 --> 00:06:52,230
.نعم، ربّما

118
00:06:52,890 --> 00:06:54,600
...مهلاً، هل ذلك يعني

119
00:06:54,600 --> 00:06:57,990
السّبب الّذي يدفع الدّيمي-تشان
...للحديث مع تاكاهاشي فقط

120
00:06:57,990 --> 00:07:00,940
ليس لأنّ تيتسو-سينسي يبذل
...جهدًا مبالغًا فيه. بل لأنّه

121
00:07:03,390 --> 00:07:04,550
...في الحقيقة

122
00:07:05,960 --> 00:07:07,880
لقد فكّرتِ في الأمر مليًّا بالفعل، صحيح؟

123
00:07:07,880 --> 00:07:08,550
.نعم، نعم

124
00:07:08,550 --> 00:07:09,200
.أما متفاجئة

125
00:07:09,200 --> 00:07:10,150
.سأضربكم

126
00:07:11,920 --> 00:07:15,050
حسنًا، ما كنتُ لآخذ كّل هذا بعين الاعتبار

127
00:07:15,050 --> 00:07:17,430
.إن لم يكن هنالك أنصاف بشر حولي أبدًا

128
00:07:17,430 --> 00:07:18,470
.نعم

129
00:07:18,470 --> 00:07:22,150
أحيانًا، ربّما علينا أن نسأل
.تيتسو-سينسي بشأن هذه الأمور

130
00:07:22,150 --> 00:07:23,130
.أوافقك الرّأي

131
00:07:23,440 --> 00:07:26,580
لكن ربّما يقلق أيضًا بشأن أمور
.غريبة وصغيرة كهذه

132
00:07:26,580 --> 00:07:27,800
!لا بأس بذلك

133
00:07:27,800 --> 00:07:29,660
.إنّ تيتسو-سينسي يُعتمد عليه

134
00:07:29,660 --> 00:07:30,970
.لا أدري

135
00:07:30,970 --> 00:07:34,600
أعتقد أنّ الاعتماد كثيرًا على شخص ما
.قد يعقّد الأمور في واقع الأمر

136
00:07:35,890 --> 00:07:37,890
...أبذل جهدًا مبالغًا فيه

137
00:07:35,890 --> 00:07:38,270
كيف يمكن لمصّاصي الدّماء ونساء الثّلج
قضاء فصل الصّيف بشكل مريح
تاكاهاشي تيتسوو

138
00:07:37,890 --> 00:07:39,680
!سينسي

139
00:07:40,140 --> 00:07:41,390
!مرحبًا

140
00:07:41,980 --> 00:07:43,440
...أ-أهلاً

141
00:07:43,650 --> 00:07:46,620
هل كنتَ تفكّر في خطّة لتساعدنا
على تحمّل فصل الصّيف؟

142
00:07:46,620 --> 00:07:48,400
هل يمكنني سماعها أيضًا؟

143
00:07:48,720 --> 00:07:52,150
....نـ-نعم... أعني

144
00:07:53,380 --> 00:07:54,280
...حسنًا

145
00:08:01,760 --> 00:08:02,830
.آسف

146
00:08:03,200 --> 00:08:06,210
.اليوم... لديّ... بعض الأمور

147
00:08:20,960 --> 00:08:23,380
ما كان خطب سينسي؟

148
00:08:23,380 --> 00:08:25,390
هل كان لديه عمل مفاجئ؟

149
00:08:25,390 --> 00:08:28,210
.لم يبدُ الأمر كذلك

150
00:08:28,210 --> 00:08:30,380
ما الخطب يا يوكّي؟

151
00:08:30,380 --> 00:08:32,210
،في هذه المرّة أيضًا

152
00:08:32,210 --> 00:08:35,300
أظنّنا قد أصبحنا معتادات
على وجود تاكاهاتشي-سينسي

153
00:08:35,300 --> 00:08:39,350
ليفكّر بأمور من أجلنا والقيام بأشياء
.مختلفة من أجلنا أيضًا

154
00:08:39,350 --> 00:08:42,930
.بل ربّما أصبحنا نتوقّع منه ذلك

155
00:08:42,930 --> 00:08:43,960
ما الّذي تقصدينه؟

156
00:08:44,490 --> 00:08:49,250
.ما أقصده هو أنّه ربّما كنّا نستغلّ نيّته الطّيّبة

157
00:08:49,520 --> 00:08:52,260
هل تعتقدين أنّنا أصبحنا عبئًا عليه؟

158
00:08:52,260 --> 00:08:54,610
!كلاّ، هذا مستحيل

159
00:08:54,610 --> 00:08:57,090
...منذ مدّة، سألتُ سينسي

160
00:08:57,590 --> 00:09:00,340
،بعد حديثي معك في كلّ هذه اللّقاءات

161
00:09:00,340 --> 00:09:04,820
أصبحتُ أعرف أنّ بعض الأساطير حول
،مصّاصي الدّماء مصدرها هو صفاتهم

162
00:09:01,350 --> 00:09:04,100
أساطير مصدرها الصّفات
مصّ الدّماء —
كره النّور —
النّفور من الثّوم —

163
00:09:04,100 --> 00:09:10,570
أساطير مصدرها اعتقادات دينيّة
نفور من الصّلبان —
لا انعكاسات في المرآة —

164
00:09:04,820 --> 00:09:09,460
،بينما هناك أخرى ذات مصدر دينيّ
.نشأت عن طريق خوف البشر

165
00:09:09,460 --> 00:09:10,570
!فهمت

166
00:09:10,570 --> 00:09:13,690
وما الّذي نستفيده من معرفتنا لهذا؟

167
00:09:15,250 --> 00:09:16,070
!أنّه ممتع

168
00:09:16,070 --> 00:09:17,410
.تلك كانت ردّة فعله

169
00:09:17,700 --> 00:09:20,230
إذًا فهو يريد معرفة أشياءٍ فحسب؟

170
00:09:20,230 --> 00:09:22,640
.نعم، نعم. لذلك كلّ شيء على ما يرام

171
00:09:22,640 --> 00:09:26,330
إذًا لماذا تصرّف كذلك سابقًا؟

172
00:09:26,870 --> 00:09:29,670
ربّما حدث شيء ما مع مدرّس آخر؟

173
00:09:30,130 --> 00:09:33,840
.إن كان هذا هو السّبب، فلا يمكننا التّدخّل

174
00:09:35,470 --> 00:09:38,800
!إن لم نستطع سؤال سينسي، فيمكننا سؤال ساكّي

175
00:09:39,750 --> 00:09:40,930
.سأعود قريبًا

176
00:09:41,380 --> 00:09:42,580
!هيكاري-تشان

177
00:09:42,580 --> 00:09:45,060
...لا أظنّ أنّ ذلك سيساعد

178
00:09:47,230 --> 00:09:49,150
!عن إذنكم

179
00:09:51,620 --> 00:09:53,120
هل من خطب ما؟

180
00:09:53,120 --> 00:09:54,490
—هل ساكّي

181
00:09:54,780 --> 00:09:57,600
أقصد هل ساتو-سينسي هنا؟
.أريد أن أسألها حول أمر ما

182
00:09:57,600 --> 00:10:01,210
أعتقد أنّ ساتو-سينسي تعمل
.في ساحة المدرسة

183
00:10:01,210 --> 00:10:04,130
.إنّها في ساحة المدرسة؟ شكرًا جزيلاً لك

184
00:10:04,130 --> 00:10:06,200
!سأذهب إليها إذًا

185
00:10:09,510 --> 00:10:12,920
.علينا أن نفكّر كيف ننسجم مع الدّيمي-تشان أيضًا

186
00:10:13,430 --> 00:10:16,410
.حسنًا، جميعنا مختلفون

187
00:10:16,410 --> 00:10:19,370
.ولا مشكلة لنا في الحديث مع بعضنا بعضًا

188
00:10:19,370 --> 00:10:20,450
...فهمت

189
00:10:20,450 --> 00:10:23,580
تبدين لئيمة نوعًا ما، لكنّك تقولين
—أمورًا ذكيّة أحيانًا

190
00:10:23,580 --> 00:10:24,060
ماذا؟

191
00:10:24,300 --> 00:10:27,770
أعني... هل هذا هو ما تقصدينه بالاختلاف؟

192
00:10:27,770 --> 00:10:30,250
.كانت تلك مجرّد إهانة منك لي

193
00:10:32,690 --> 00:10:35,150
أ-أهلاً، لِمَ العجلة؟

194
00:10:35,150 --> 00:10:36,870
هل رأيتم ساكّي؟

195
00:10:36,870 --> 00:10:38,500
تقصدين ساتو-سينسي؟

196
00:10:38,500 --> 00:10:39,170
.نعم

197
00:10:39,170 --> 00:10:41,870
إنّها تقوم بتشذيب الأشجار
.في الجانب الآخر من ملعب

198
00:10:41,870 --> 00:10:42,930
!ممتاز

199
00:10:42,930 --> 00:10:45,250
.مهلاً يا تاكاناشي

200
00:10:46,050 --> 00:10:48,710
...اسمعي، الأمر يخصّ تيتسو-سينسي

201
00:10:49,420 --> 00:10:50,710
سينسي؟

202
00:10:53,010 --> 00:10:54,500
.هذا ما حدث

203
00:10:54,960 --> 00:10:56,630
...فهمت

204
00:10:57,040 --> 00:10:57,760
.حسنًا

205
00:10:58,090 --> 00:11:00,100
.سأحاول القيام بأمر ما أيضًا

206
00:11:00,100 --> 00:11:01,720
.شكرًا لك يا ساتاكّي

207
00:11:03,100 --> 00:11:04,510
ساتاكّي"؟"

208
00:11:05,010 --> 00:11:06,800
!ما كان ذلك؟

209
00:11:06,800 --> 00:11:08,900
بدا ذلك كنوع من الوحوش، صحيح؟

210
00:11:08,900 --> 00:11:09,990
.نعم

211
00:11:09,700 --> 00:11:12,900
،لقد قلتُ بالفعل أنّي أردتُ لقبًا
!لكن بحقّكم

212
00:11:10,740 --> 00:11:12,900
.محظوظ... لديه لقب الآن

213
00:11:15,450 --> 00:11:18,610
.حسنًا... هذا ما قاله نائب المدير

214
00:11:18,610 --> 00:11:19,790
.نعم

215
00:11:19,790 --> 00:11:22,660
...إذًا، لهذا السّبب تاكاهاشي-سينسي

216
00:11:22,660 --> 00:11:26,300
.ربّما كنّا نستغلّه بالفعل

217
00:11:26,300 --> 00:11:28,370
.كلاّ، هذا ليس صحيحًا أبدًا

218
00:11:28,730 --> 00:11:30,830
.هنالك أربعة أنصاف بشر في هذه المدرسة

219
00:11:30,830 --> 00:11:35,420
وأظنّ أنّنا محظوظات لتواجد
.تاكاهاشي-سينسي هنا أيضًا

220
00:11:35,730 --> 00:11:39,540
لقد تمّ إنقاذنا جميعًا مرّات عدّة
بسبب تلك الحقيقة، صحيح؟

221
00:11:39,540 --> 00:11:40,740
.أجل، بالطّبع

222
00:11:40,740 --> 00:11:42,190
.مرّات عدّة

223
00:11:42,190 --> 00:11:45,680
لكنّ نائب المدير لم يكن عليه
...قول ذلك له

224
00:11:46,090 --> 00:11:48,530
،يمكن أن يكون نائب المدير صارمًا

225
00:11:48,530 --> 00:11:50,950
.لكنّه رجل محترم ويدفعه شغف التّعليم

226
00:11:50,950 --> 00:11:53,070
.ما قاله لم يكن خاطئًا

227
00:11:53,070 --> 00:11:56,940
.ولا أظنّ أنّه قصد إحباط تاكاهاشي-سينسي بالكامل

228
00:11:56,940 --> 00:11:59,810
ماذا يمكننا أن نفعل؟

229
00:11:59,810 --> 00:12:02,800
لا أدري إن كنتُ أستطيع أن أبدأ
.بالحديث لشخص آخر فحسب

230
00:12:02,800 --> 00:12:04,610
.وسيجعلهم ذلك غير مرتاحين أيضًا

231
00:12:06,980 --> 00:12:08,120
!وجدتُها

232
00:12:10,330 --> 00:12:12,970
!لنجعل سينسي يشعر بتحسّن

233
00:12:21,140 --> 00:12:23,090
.أنت تبذل جهدًا مبالغ فيه

234
00:12:23,340 --> 00:12:25,300
...ربّما أكون كذلك

235
00:12:26,260 --> 00:12:29,240
،في البداية، كنتُ مهتمًّا بأنصاف البشر فحسب

236
00:12:29,240 --> 00:12:31,860
.أكره الاعتراف بهذا، لكنّه كان اهتمامًا خاصًّا محض

237
00:12:31,860 --> 00:12:36,140
لكن مع الوقت، أدركتُ أنّ الدّيمي-تشان
.لديهنّ مشاكلهنّ الخاصّة

238
00:12:36,140 --> 00:12:38,400
.وأردتُ مساعدتهنّ

239
00:12:38,770 --> 00:12:40,570
.أمِلتُ أن أستطيع دعمهنّ

240
00:12:40,860 --> 00:12:44,110
.لكن ربّما كان ذلك غير ضروريّ

241
00:12:44,440 --> 00:12:47,920
هؤلاء الفتيات لديهنّ فهم أفضل
.للأشياء ممّا ظننت

242
00:12:47,920 --> 00:12:51,660
ظننتُ أنّي ساعدتُ يوكي بشأن
.همومها حول طبيعتها الخاصّة

243
00:12:52,400 --> 00:12:56,000
لكن ربّما لم يكن عليّ فعل
.أيّ شيء من ذلك أيضًا

244
00:12:56,930 --> 00:13:01,180
ربّما كان تجاوزها للأمر بنفسها
.ليجعلها أكثر قوّة

245
00:13:01,180 --> 00:13:03,990
،وإن احتاجت الاعتماد على أحد ما
فمن الأفضل لها

246
00:13:03,990 --> 00:13:08,290
أن تكون قادرة على أن تثق بعائلتها
.وأصدقائها وآخرون غيرهم

247
00:13:08,820 --> 00:13:11,930
هل تطفّلت عليهنّ كثيرًا؟

248
00:13:12,590 --> 00:13:16,020
حاول سوما دراسة أنصاف البشر
.من وجهة نظر باحث

249
00:13:16,440 --> 00:13:19,010
.بالطّبع، يفيد هذا أنصاف البشر

250
00:13:19,010 --> 00:13:20,090
ويمكنه أيضًا

251
00:13:20,090 --> 00:13:23,490
.أن يكون مفتاح معرفة شيء قد يغيّر العالم

252
00:13:24,400 --> 00:13:27,300
هنالك أكثر من طريقة واحدة
.لمساعدة أنصاف البشر

253
00:13:27,300 --> 00:13:29,080
،بدل قيامي بالأمر كمدرّس

254
00:13:29,080 --> 00:13:32,620
ربّما عليّ الحفاظ على مسافة
.بصفتي باحثًا قد يكون خيارًا متاحًا

255
00:13:34,470 --> 00:13:36,620
...هذه من هيكاري

256
00:13:39,140 --> 00:13:40,180
.بطيء

257
00:13:44,340 --> 00:13:45,880
!حسنًا، لقد بدأ

258
00:13:45,880 --> 00:13:47,220
ماذا؟ بدأ بالفعل؟

259
00:13:49,440 --> 00:13:53,720
حسنًا، ستقوم يوكّي بالتّعبير عن شكرها
.في البداية لمدرّسنا المهموم

260
00:13:53,720 --> 00:13:56,240
.أ-أنا لستُ جاهزة لهذا

261
00:13:56,800 --> 00:13:58,550
...لست جاهزة لهذا

262
00:14:00,250 --> 00:14:01,400
—لـ-لستُ جاهزة لهذا

263
00:14:01,400 --> 00:14:03,030
!حسنًا، ابدئي

264
00:14:03,980 --> 00:14:07,760
...المعذرة يا تاكاهاشي-سينسي

265
00:14:07,760 --> 00:14:10,000
.هذه يوكي. كوساكابي

266
00:14:10,000 --> 00:14:12,240
.شكرًا على كلّ ما فعلته

267
00:14:12,240 --> 00:14:15,500
،وأيضًا، أعلم أنّك قد تكون... حسنًا

268
00:14:15,500 --> 00:14:20,350
،قلقًا أنّك كنت شغوفًا كثير بشأننا

269
00:14:20,350 --> 00:14:22,770
.أو أنّك قد تكون قد بالغت باهتمامك

270
00:14:22,770 --> 00:14:27,070
كالمرّة الّتي أتيتُ فيها طالبة لنصيحتك
.بشأن صفاتي الجسديّة

271
00:14:27,530 --> 00:14:32,160
،حتّى لو لم أطلب، كان الوقت ليحلّ المشكلة

272
00:14:32,160 --> 00:14:35,300
.وربّما كان ذلك ليكون أفضل بالنّسبة لي

273
00:14:35,300 --> 00:14:38,110
...أنا لا أنكر تلك الاحتمالات بالتّأكيد

274
00:14:38,110 --> 00:14:42,160
لكنّي لا أقول أنّي أعتقد أنّ ذلك
!ما كان يجب عليه أن يكون

275
00:14:42,160 --> 00:14:47,010
أقصد فقط أنّه لا يوجد احتمال مستحيل
!الحدوث بالحديث عن الاحتمالات

276
00:14:47,010 --> 00:14:49,260
...ما أقصده هو

277
00:14:49,260 --> 00:14:54,100
أ-أنا ممتنّة كثيرًا لكلّ النّصائح
!الّتي منحتني إيّاها

278
00:14:54,100 --> 00:14:55,900
هنالك شيء واحد يمكنني قوله بلا شكّ

279
00:14:55,900 --> 00:15:00,690
وهو أنّه بفضلك أنت، حُلّت
!همومي بشأن بنيتي الجسديّة

280
00:15:00,690 --> 00:15:03,980
لذلك السّبب تمكّنت من تناول
،مثلّجات معكم في ذلك اليوم

281
00:15:03,980 --> 00:15:07,270
ممّا عنى أنّه بإمكاني قضاء
!المزيد من الوقت الممتع معهنّ

282
00:15:07,270 --> 00:15:10,550
...وأيضًا، هنالك

283
00:15:12,720 --> 00:15:14,710
.أشعر أنّ عقلي قد فرغ فجأة

284
00:15:14,710 --> 00:15:16,420
!حسنًا! أنت التّالية يا ماتشي

285
00:15:22,600 --> 00:15:25,060
.تاكاهاشي-سينسي، هذه ماتشي

286
00:15:25,060 --> 00:15:28,210
مرحبًا. كيف حالك؟

287
00:15:28,210 --> 00:15:31,180
،لم يمرّ وقت طويل منذ أن قابلك

288
00:15:31,180 --> 00:15:34,330
.لكنّي أشعر وكأنّه كان وقتًا طويلاً بالفعل

289
00:15:34,330 --> 00:15:38,700
.وذلك لأنّك فعلت الكثير من الأشياء من أجلي

290
00:15:38,700 --> 00:15:40,520
.شكرًا جزيلاً لك

291
00:15:40,520 --> 00:15:43,300
بالتّفكير بالأمر، كنتَ دائمًا

292
00:15:43,300 --> 00:15:46,320
.حريصًا على الاستماع منذ أن تقابلنا أوّل مرّة

293
00:15:46,320 --> 00:15:53,000
جعلني ذلك أدرك كم أنّ الحديث بحرّيّة
.مع شخص ما عن الدّولاهان أمر لطيف

294
00:15:53,000 --> 00:15:56,010
.وأنت لست لطيفًا فحسب

295
00:15:56,010 --> 00:16:00,720
.لقد وبّختني أيضًا عندما تصرّفت بشكل غير لائق

296
00:16:00,720 --> 00:16:05,290
.يمكنك أن تقول أنّ ذلك هو عملك كمدرّس

297
00:16:05,290 --> 00:16:09,360
،لكن في كلّ حياتي الّتي عشتها

298
00:16:09,360 --> 00:16:14,610
لم يعاملني أيّ مدرّس بشكل مباشر
!من قبل على أنّي دولاهان

299
00:16:14,610 --> 00:16:17,940
أنا واثقة أنّك ستتصرّف بنفس الطّريقة

300
00:16:17,940 --> 00:16:22,610
.حيال أيّ تلميذ سواء كان ديمي أم لا

301
00:16:22,610 --> 00:16:26,990
،حتّى إن لم يكن لديك اهتمام خاصّ بالدّيمي

302
00:16:26,990 --> 00:16:30,210
،أنا واثقة أنّنا إن كنّا أيّ تلميذات جديدات

303
00:16:30,210 --> 00:16:33,480
فستعاملنا بنفس الطّريقة
...الّتي تعاملنا بها الآن

304
00:16:34,400 --> 00:16:40,810
...أتمنّى أن تواصل الاهتمام بنا
.كلاّ، بل بكلّ أنواع التّلاميذ

305
00:16:40,810 --> 00:16:43,780
،أتمنّى أن تنصحنا عندما نواجه المشاكل

306
00:16:43,780 --> 00:16:47,540
.ووبّخنا عندما نقوم بأشياء خاطئة

307
00:16:47,540 --> 00:16:50,640
سآتي لرؤيتك في غرفة مادةّ الأحياء
.التّطبيقيّة ثانية

308
00:16:50,640 --> 00:16:52,470
.شكرًا جزيلاً لك

309
00:16:53,360 --> 00:16:55,570
!ماذا؟ لقد صفّقتُ دون تفكير

310
00:16:55,570 --> 00:16:58,290
!ماتشي، أنت متحدّثة ممتازة
!يا لك من تلميذة مشرّفة

311
00:16:58,290 --> 00:16:59,860
أ-أتظنّين ذلك؟

312
00:16:59,860 --> 00:17:01,300
.حسنًا، أنت التّالية يا ساكّي

313
00:17:01,300 --> 00:17:02,740
ماذا؟ أنا أيضًا؟

314
00:17:02,190 --> 00:17:03,620
!هيّا، هيّا

315
00:17:02,740 --> 00:17:05,180
...مهلاً يا يوكي-تشان! يا إلهي

316
00:17:05,180 --> 00:17:07,940
كنتُ أحاول إبقاء صوتي بعيدًا
...عن التّسجيل

317
00:17:09,970 --> 00:17:14,130
.أهلاً يا تاكاهاشي-سينسي، هذه ساتو
.شكرًا على كلّ عملك الدّؤوب

318
00:17:14,130 --> 00:17:17,450
،الفتيات هنّ النّجمات هنا
.لذلك سأكون بسيطة في حديثي

319
00:17:19,900 --> 00:17:25,970
أنا أعتمد عليك كثيرًا، بصفتي
!مدرّسة وسقّوبة أيضًا

320
00:17:25,970 --> 00:17:30,860
أكنّ احترامًا كبيرًا للطّريقة الّتي تتولّى
!بها الأمور بكلّ نزاهة

321
00:17:30,860 --> 00:17:34,020
.شكرًا لك على مساعدتك الدّائمة

322
00:17:34,020 --> 00:17:39,180
.وسأعتمد عليك لتواصل إرشادك وتشجيعك

323
00:17:40,720 --> 00:17:42,680
هل كان ذلك رسميًّا كثيرًا؟

324
00:17:44,090 --> 00:17:47,730
،إن أزعجك أيّ شيء

325
00:17:47,730 --> 00:17:50,350
،سأكون سعيدة للاستماع لك كزميلة

326
00:17:50,350 --> 00:17:54,670
،رغم أنّي لا أزال حديثة العهد
!لذلك لا تتردّد بالحديث معي

327
00:17:54,670 --> 00:17:56,130
!سوف أقوم بدعمك

328
00:17:56,130 --> 00:18:00,740
أنا واثقة أنّ بعض الأمور ليست سهلة
...لنناقشها بشكل عاديّ، لذلك

329
00:18:01,950 --> 00:18:03,130
...لذلك

330
00:18:04,890 --> 00:18:07,240
لماذا لا نخرج لاحتساء شراب؟

331
00:18:09,610 --> 00:18:10,800
...أمزح فحسب

332
00:18:10,800 --> 00:18:12,780
!وبهذا نُنهي رسالة الفيديو

333
00:18:12,780 --> 00:18:15,610
!ماذا؟ ألن تتحدّثي يا هيكاري-تشان؟

334
00:18:15,610 --> 00:18:16,740
.هيكاري، هذا ليس منصفًا

335
00:18:16,740 --> 00:18:17,860
!هيّا

336
00:18:17,860 --> 00:18:18,990
!النّهاية

337
00:18:28,760 --> 00:18:30,210
!سينسي

338
00:18:30,970 --> 00:18:32,840
هـ-هيكاري؟

339
00:18:34,620 --> 00:18:36,080
لـ-لماذا أنت هنا؟

340
00:18:36,080 --> 00:18:39,460
.أرسلتُ لك فيديو سابقًا، لكنّه كان ضخمًا

341
00:18:39,460 --> 00:18:43,260
لذلك تساءلت إن كنتَ قادرًا
.على مشاهدته، ثمّ رأيتُك هنا

342
00:18:43,260 --> 00:18:44,560
.رأيتُك من هناك

343
00:18:44,560 --> 00:18:45,770
مِن كلّ تلك المسافة؟

344
00:18:45,770 --> 00:18:47,360
...نعم، نعم

345
00:18:47,360 --> 00:18:49,110
.المعذرة

346
00:18:54,260 --> 00:18:55,490
هل شاهدتَه؟

347
00:18:55,490 --> 00:18:57,910
.نعم. شكرًا لك

348
00:18:57,910 --> 00:18:59,400
.سأشكر الأخريات أيضًا

349
00:18:59,400 --> 00:19:01,160
.أخبرني ساتاكّي بما حدث

350
00:19:01,160 --> 00:19:03,600
...ساتاكّي؟ صحيح

351
00:19:03,600 --> 00:19:06,900
.ظننتُ أنّك ستكون محبطًا

352
00:19:06,900 --> 00:19:08,250
...نعم، على ما أظنّ

353
00:19:08,610 --> 00:19:11,840
.لكنّ الفيديو جعلني سعيدًا للغاية

354
00:19:11,840 --> 00:19:13,480
.أشعر بتحسّن الآن

355
00:19:13,480 --> 00:19:17,130
.لكنّي ما أزال أظنّ أنّي قد أكون قد بالغت

356
00:19:17,560 --> 00:19:20,140
.أو ربّما عليّ الحفاظ على وتيرة معيّنة مع الجميع

357
00:19:20,140 --> 00:19:21,510
.كلاّ، على الإطلاق

358
00:19:22,510 --> 00:19:25,360
.لا يمكن اعتبار "المحاولة" مبالغة في أيّ ظرف

359
00:19:25,360 --> 00:19:29,480
إنّ إخبار شخص يحاول بذل كلّ جهده
.أنه قد "بالغ كثيرًا" ليس صحيحًا

360
00:19:29,860 --> 00:19:32,980
،إنّ من يحاول بذل جهده
،يمكنه الحصول على دعم الآخرين

361
00:19:32,980 --> 00:19:36,690
.لذلك تُكافَؤ مجهوداته ويظهر امتنانه

362
00:19:37,010 --> 00:19:39,920
،إن أرادوا الحفاظ على نفس الوتيرة كذلك الشّخص

363
00:19:39,920 --> 00:19:43,070
.فعليهم أن يحاولوا بذل جهد أكثر

364
00:19:46,780 --> 00:19:48,600
!سينسي

365
00:19:49,050 --> 00:19:53,570
!شكرًا جزيلاً على محاولتك لبذل جهدك كلّ يوم

366
00:19:53,570 --> 00:19:57,620
،عندما يتعلّق الأمر بالمجهود
.فلا يوجد من يجاريك في ذلك

367
00:19:57,620 --> 00:20:06,600
لذلك سأحاول بذل جهدي أيضًا، لأردّ لك
!وللجميع كلّ ما فعلتم من أجلي

368
00:20:10,400 --> 00:20:14,150
انتهيت! كانت تلك هي رسالة
!الفيديو السّرّيّة منّي

369
00:20:23,420 --> 00:20:24,690
...رويدك، رويدك

370
00:20:24,690 --> 00:20:25,530
.توقّفي

371
00:20:26,550 --> 00:20:28,520
.ستدفعيني للبكاء

372
00:20:34,180 --> 00:20:35,500
!يا نائب المدير

373
00:20:36,990 --> 00:20:39,090
.أريد التّحدّث معك

374
00:20:39,090 --> 00:20:41,310
.نعم، أردت التّحدّث معك أيضًا

375
00:20:41,840 --> 00:20:47,170
طلبت منك سابقًا أن تعيد النّظر
.في تعاملك مع أنصاف البشر

376
00:20:47,170 --> 00:20:49,080
—نعم، بشأن ذلك... أنا

377
00:20:49,080 --> 00:20:50,770
.لنؤجّل ذلك

378
00:20:50,770 --> 00:20:51,440
ماذا؟

379
00:20:51,440 --> 00:20:55,040
.بعدما قلتُه لك سابقًا. اسمح لي بقول هذا

380
00:20:55,040 --> 00:20:57,350
لكنّي أريدك أن تواصل إظهار

381
00:20:57,350 --> 00:21:00,210
.نفس الكفاءة الّتي تُظهرها دائمًا

382
00:21:00,210 --> 00:21:01,320
ماذا؟

383
00:21:07,950 --> 00:21:09,570
.إنّه ثقيل نوعًا ما

384
00:21:09,570 --> 00:21:11,450
.لن يعود كذلك عندما تعتادين عليه

385
00:21:11,450 --> 00:21:13,410
.لم أعلم أنّ بشرتك كانت باردة هكذا

386
00:21:13,410 --> 00:21:14,420
تفاجأتِ؟

387
00:21:14,420 --> 00:21:16,120
.أراهن أنّ الصّيف صعب عليك

388
00:21:16,390 --> 00:21:17,630
ماذا عن ذراعي؟

389
00:21:18,250 --> 00:21:19,140
!أربع نقاط

390
00:21:19,140 --> 00:21:19,840
لماذا؟

391
00:21:20,410 --> 00:21:24,820
،ما دام هنالك تلاميذ مُلهَمون بأفعالك

392
00:21:24,820 --> 00:21:27,880
.فإنّ إنكار جهودك سيكون أمرًا خاطئًا

393
00:21:37,810 --> 00:21:41,150
الحياة الجديدة الّتي خطوتُ فيها هذا
الرّبيع مع الدّيمي-تشان

394
00:21:41,150 --> 00:21:43,400
.كانت محفّزة ومحمّسة

395
00:21:43,970 --> 00:21:48,870
كيف يعيش الدّيمي حياتهم وكيف يفكّرون

396
00:21:48,870 --> 00:21:54,230
...وأيضًا تفكير من هم حولهم وكيف تغيّروا

397
00:21:55,000 --> 00:21:57,210
!أريد أن أعيد التّفكير فيها جميعها أكثر وأكثر

398
00:22:01,250 --> 00:22:01,960
،أخيرًا

399
00:22:02,740 --> 00:22:04,040
!حلّ الصّيف

400
00:23:35,770 --> 00:23:38,230
:"في الحلقة القادمة من "لقاءات مع الفتيات الوحوش

401
00:23:38,230 --> 00:23:39,800
."تريد الدّيمي-تشان السّباحة"