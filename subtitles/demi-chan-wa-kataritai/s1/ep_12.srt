1
00:01:44,290 --> 00:01:45,540
.أنت مستيقظ

2
00:01:47,730 --> 00:01:49,170
...صباح الخير

3
00:01:50,020 --> 00:01:51,870
آسفة! هل أيقظتك؟

4
00:01:51,870 --> 00:01:55,020
كلاّ، لا بأس. هل تحتاجين لشيء ما؟

5
00:01:55,020 --> 00:01:57,260
!نعم! لديّ سؤال

6
00:01:57,260 --> 00:02:00,090
.مذهل، إنّ عيناك تلمعان بالفعل

7
00:02:00,090 --> 00:02:04,240
هل يمكن لهذا أن يكون السّبب في مقدرة
مصّاصي الدّماء على الرّؤية في اللّيل؟

8
00:02:04,240 --> 00:02:07,980
.نعم، إنّ هذا يشبه وضع الحيوانات اللّيليّة

9
00:02:08,640 --> 00:02:13,160
فهذه الحيوانات تملك طبقة تشبه
.المرآة في خلفيّة العين

10
00:02:12,150 --> 00:02:14,280
المشيميّة

11
00:02:12,570 --> 00:02:14,280
البساط

12
00:02:13,020 --> 00:02:14,280
الشّبكيّة

13
00:02:13,160 --> 00:02:16,860
تعكس تلك الطّبقة النّور
،الّذي يدخل عبر شبكيّة العين

14
00:02:13,520 --> 00:02:14,280
الصّلبة

15
00:02:16,860 --> 00:02:20,360
.ويسمح لها بالرّؤية بوضوح بوجود ولو ضوء خافت

16
00:02:20,700 --> 00:02:23,830
إذًا فذلك اللّمعان الّذي نراه
...دائمًا في صورها

17
00:02:23,830 --> 00:02:27,580
.إنّ عيونها تعكس النّور المسلّط عليها من البشر

18
00:02:27,580 --> 00:02:29,940
!مذهل، هذا ممتع

19
00:02:29,940 --> 00:02:34,080
على الأرجح أنّ مصّاصي الدّماء
.يستطيعون الرّؤية ليلاً لنفس السّبب

20
00:02:34,080 --> 00:02:36,630
!أنا سعيدة لأنّي سألتك عن هذا

21
00:02:36,630 --> 00:02:40,480
لكنّ تلك الميزة نفسها تجعل
.العيون حسّاسة للضّوء السّاطع

22
00:02:40,480 --> 00:02:43,800
أعلم! لهذا السّبب ليس مسموحًا
!بالتقاط صور بالوميض في حدائق الحيوان

23
00:02:43,800 --> 00:02:45,390
...حسنًا، ذلك صحيح أيضًا، لكن

24
00:02:46,030 --> 00:02:48,860
.عليك أن تحذري لكي لا تؤذي عينيك

25
00:02:48,860 --> 00:02:52,830
إنّ السّبب الّذي يجعل مصّاصي الدّماء
.لا يتحمّلون أشعة الشّمس مشابه على الأرجح

26
00:02:53,680 --> 00:02:56,390
،في يوم مشمس كاليوم على وجه الخصوص

27
00:02:56,390 --> 00:02:58,410
،عليك أن تحذري من نوبات الدّوار

28
00:02:58,410 --> 00:03:00,930
.وحماية نفسك من حروق الشّمس أيضًا

29
00:03:00,930 --> 00:03:01,490
.أجل

30
00:03:01,840 --> 00:03:02,580
—وأيضًا

31
00:03:02,580 --> 00:03:03,590
سينسي؟

32
00:03:04,070 --> 00:03:06,530
.أنا أعرف ذلك مسبقًا

33
00:03:06,530 --> 00:03:09,650
كم سنة وأنا مصّاصة دماء في رأيك؟

34
00:03:09,650 --> 00:03:11,330
.صحيح... آسف

35
00:03:12,370 --> 00:03:14,560
...كلّ ما هنالك... هو

36
00:03:14,560 --> 00:03:18,000
.راودني حلم سابقًا هاجمتني فيه مصّاصة دماء

37
00:03:20,730 --> 00:03:21,730
هل كان مخيفًا؟

38
00:03:21,730 --> 00:03:23,100
.كان منطقيًّا كثيرًا

39
00:03:23,870 --> 00:03:25,400
كيف أشرح الأمر؟

40
00:03:25,400 --> 00:03:29,070
لقد جعلني أفكّر في ميول مصّاصي الدّماء
للهجوم في الظّلام

41
00:03:29,070 --> 00:03:31,520
.كان شيئًا حدث بشكل طبيعيّ للغاية

42
00:03:31,970 --> 00:03:33,640
نحقّق أهدافنا

43
00:03:33,640 --> 00:03:37,570
عن طريق إخفاء نقاط الضّعف بينما
...نستعمل نقاط قوّتنا بأكملها

44
00:03:37,570 --> 00:03:39,440
،كالحيوانات تمامًا

45
00:03:39,440 --> 00:03:43,280
لا بدّ أنّ تلك هي أكثر طريقة مريحة
.لمصّاصي الدّماء ليواصلوا العيش

46
00:03:43,600 --> 00:03:47,780
،عندما أفكّر بالأمر من تلك النّاحية
أشعر أنّ مصّاصي الدّماء العصريّين

47
00:03:47,780 --> 00:03:51,790
الّذين يكيّفون أنفسهم على العيش كالبشر
.يعيشون حياة محصورة للغاية

48
00:03:51,790 --> 00:03:54,420
لذلك انتهى بي المطاف وأنا أعطيك
.محاضرة لم تكوني بحاجة لها

49
00:03:54,420 --> 00:03:57,800
.كلاّ، أنا سعيدة للغاية لأنّك قلق بشأني

50
00:03:58,840 --> 00:04:02,680
!ولكن، أنت مخطئ بشأن أمر واحد

51
00:04:02,680 --> 00:04:03,780
!قف

52
00:04:04,250 --> 00:04:05,430
!اخلع معطفك

53
00:04:05,740 --> 00:04:07,140
...حسنًا، حسنًا، حسنًا

54
00:04:09,770 --> 00:04:10,920
!انظر

55
00:04:10,920 --> 00:04:15,270
مصّاصو الدّماء العصريّون يمكنهم
!الصّيد بكلّ راحة أيضًا

56
00:04:15,580 --> 00:04:19,080
تنساب عباءة مصّاصة الدّماء البيضاء

57
00:04:19,080 --> 00:04:23,560
!بينما تبحث عن فريستها

58
00:04:24,240 --> 00:04:25,160
...هل هذا

59
00:04:25,160 --> 00:04:27,390
!أجل! وقت الهجوم

60
00:04:27,660 --> 00:04:29,160
.سروالك الدّاخلي ظاهر

61
00:04:30,440 --> 00:04:32,420
!آسف! أنا جدّ آسف

62
00:04:32,420 --> 00:04:35,670
...كان ذلك كلامًا فظًّا للغاية منّي

63
00:04:35,670 --> 00:04:37,630
...إذًا فأنت

64
00:04:37,630 --> 00:04:40,370
!عليك القيام بشيء سخيف أيضًا

65
00:04:40,370 --> 00:04:41,590
هل أنت مجنونة؟

66
00:04:41,590 --> 00:04:43,980
!تصرّف كمصّاصي الدّماء أيضًا

67
00:04:44,370 --> 00:04:45,300
مصّاصو الدّماء؟

68
00:04:46,510 --> 00:04:50,220
.هسيس... سوف أمصّ دماءك

69
00:04:50,520 --> 00:04:51,850
.عيناه لا تلمعان

70
00:04:51,850 --> 00:04:53,930
!إنّه مصّاص دماء مزيّف! اقبضوا عليه

71
00:04:53,930 --> 00:04:54,980
...أيّتها

72
00:04:59,410 --> 00:05:02,190
...صحيح، لديّ طلب أخير منك

73
00:05:02,980 --> 00:05:06,210
هل يمكننا استعارة حمّام سباحة
المدرسة هذا السّبت؟

74
00:05:06,210 --> 00:05:08,850
.إنّ مسبح المدرسة مسبح خارجيّ

75
00:05:08,850 --> 00:05:10,530
ألن يكون المسبح الدّاخليّ أفضل؟

76
00:05:10,530 --> 00:05:11,660
!لا، لا بأس

77
00:05:12,820 --> 00:05:15,120
...حسنًا، أعتقد أنّ ذلك لن يكون مستحيلاً

78
00:05:15,120 --> 00:05:16,000
!فعلاً؟

79
00:05:16,000 --> 00:05:18,130
.لكنّ حضور مدرّس ما أمر ضروريّ

80
00:05:18,400 --> 00:05:19,460
.لا بأس بذلك

81
00:05:19,770 --> 00:05:21,590
.حسنًا، سأطلب إذنَ المدير

82
00:05:21,880 --> 00:05:23,480
!أجل

83
00:05:23,480 --> 00:05:25,630
.لا يعني ذلك أنّ القرار قد اتّخذ

84
00:05:25,630 --> 00:05:29,040
.أعلم! رشّ، رشّ، رشّ

85
00:05:30,240 --> 00:05:31,350
!تاكاهاشي-سينسي

86
00:05:33,500 --> 00:05:34,610
—أردتُ أن أسألك عن

87
00:05:34,980 --> 00:05:37,840
!أفهم من هذا أنّك رأيت ملابس أختي الدّاخليّة؟

88
00:05:37,190 --> 00:05:40,900
!رأى سينسي ملابسي الدّاخليّة
~لن أستطيع الزّواج أبدًا بعد الآن

89
00:05:37,840 --> 00:05:40,900
!هلاّ شرحت لي ما هذا لو سمحت؟

90
00:05:41,250 --> 00:05:44,630
.فهمت الآن... أنا آسفة لحدوث هذا باستمرار

91
00:05:44,630 --> 00:05:48,050
.كلاّ، كان خطئي أنا أيضًا هذه المرّة

92
00:05:48,050 --> 00:05:49,090
.آسف على ذلك

93
00:05:49,090 --> 00:05:52,160
على أيّ حال، ما الّذي أردتَ أن تسألنيه؟

94
00:05:52,160 --> 00:05:53,920
.صحيح، كدتُ أنسى

95
00:05:53,920 --> 00:05:57,860
ما في الأمر هو أنّ هيكاري أرادت
.أن تسبح في المسبح

96
00:05:57,860 --> 00:05:58,970
فعلاً؟

97
00:05:58,970 --> 00:06:01,540
.أشعة الشّمس قاسية على مصّاصي الدّماء كما تعلمين

98
00:06:01,540 --> 00:06:04,420
أولن تكون السّباحة في الخارج
غير مريحة أكثر لها؟

99
00:06:04,420 --> 00:06:09,090
!رأى سينسي ملابسي الدّاخليّة
~لن أستطيع الزّواج أبدًا بعد الآن
سمعتُ القصّة بأكملها
.من تاكاهاشي-سينسي للتّوّ

100
00:06:04,780 --> 00:06:10,090
لم أظنّ أنّه سيكون الخيار الأمثل أن أستمرّ
.في هذا دون طلب إذنك وإذن والديكما

101
00:06:10,460 --> 00:06:11,710
.لا أرى أيّ مشكلة

102
00:06:11,710 --> 00:06:13,600
...حسنًا، توقّعت هذا

103
00:06:13,600 --> 00:06:14,390
!مهلاً، لا تمانعين؟

104
00:06:14,760 --> 00:06:17,490
.إن كان ذلك ما تريده، فلا بأس

105
00:06:17,490 --> 00:06:19,240
...إنّ أختي شخص

106
00:06:19,240 --> 00:06:22,980
إنّ قضاء يوم صيفيّ، وهي تلهو
.فحسب ليس غير معتاد بالنّسبة لها

107
00:06:23,510 --> 00:06:25,150
.دعها تفعل ما يحلو لها

108
00:06:26,490 --> 00:06:27,490
هكذا إذًا؟

109
00:06:30,600 --> 00:06:32,870
لماذا لا نخرج لاحتساء شراب في وقت ما؟

110
00:06:33,250 --> 00:06:36,010
ماذا إن خرجنا معًا بالفعل؟

111
00:06:36,010 --> 00:06:37,790
ماذا عليّ أن أشرب؟

112
00:06:37,790 --> 00:06:40,330
أحبّ الجعة، لكن قد يجعلني ذلك
.أبدو كرجل عجوز

113
00:06:40,330 --> 00:06:42,050
كوكتيل؟ مشروب تشوهاي؟

114
00:06:42,050 --> 00:06:44,290
!يبدو مشروب اللّيمون كشراب رجل عجوز أيضًا

115
00:06:44,290 --> 00:06:48,380
الأهمّ الآن، ماذا إن حدث شيء ما
!بسبب تأثير الكحول؟

116
00:06:47,260 --> 00:06:48,380
أوغاكي-سان

117
00:06:48,380 --> 00:06:49,590
ساتو ساكيي

118
00:06:48,720 --> 00:06:51,120
!ما رأيك يا أوغاكي-سان؟

119
00:06:51,120 --> 00:06:53,470
هل يمكننا الحديث بشأن هذا غدًا؟

120
00:06:53,470 --> 00:06:55,890
أوغاكي-سان

121
00:06:53,820 --> 00:06:55,000
.تصبحين على خير

122
00:06:55,000 --> 00:06:55,890
!ماذا؟ مهلاً

123
00:06:55,890 --> 00:06:57,400
!أوغاكي-سان

124
00:07:00,190 --> 00:07:03,730
...لن يفيدني التّوتّر بهذا الشّكل بأيّ شيء

125
00:07:04,390 --> 00:07:05,540
!حسنًا

126
00:07:07,780 --> 00:07:09,570
!سأظلّ إيجابيّة فحسب

127
00:07:09,570 --> 00:07:11,070
!سأفعلها! الآن

128
00:07:11,070 --> 00:07:14,480
سأحاول استدراجه ولو اضطررت
!لاستعمال القليل من تأثيري الجنسيّ

129
00:07:14,480 --> 00:07:15,980
!تاكاهاشي-سينسي

130
00:07:15,980 --> 00:07:17,580
.صباح الخير

131
00:07:17,940 --> 00:07:19,630
!صباح الخير

132
00:07:20,640 --> 00:07:23,060
،في ذلك اليوم، خلال ذلك الفيديو

133
00:07:23,060 --> 00:07:25,160
...أنا... قمتُ، قمتُ، قمتُ

134
00:07:25,160 --> 00:07:25,920
ساتو-سينسي؟

135
00:07:25,920 --> 00:07:26,760
نعم؟

136
00:07:26,760 --> 00:07:29,460
هل أنت متفرّغة يوم السّبت؟

137
00:07:33,810 --> 00:07:36,100
!مرحى

138
00:07:37,440 --> 00:07:39,520
!لا تقفزن برؤوسكنّ أوّلاً

139
00:07:37,940 --> 00:07:39,520
!المياه باردة

140
00:07:39,890 --> 00:07:43,110
!سينسي! هل زيّي للسّباحة يبدو ظريفًا؟

141
00:07:39,890 --> 00:07:43,110
!يا له من شعور رائع! أنا في النّعيم

142
00:07:43,110 --> 00:07:45,690
.نعم، نعم. ظريف للغاية

143
00:07:45,690 --> 00:07:46,360
!مرحى

144
00:07:46,360 --> 00:07:47,360
الجوّ ليس ساخنًا بالنّسبة لك؟

145
00:07:47,360 --> 00:07:49,650
.لا، أنا بخير

146
00:07:50,160 --> 00:07:52,050
.إن احتجتنّ لشيء ما، أخبرنني فحسب

147
00:07:52,050 --> 00:07:53,160
!حسنًا

148
00:07:53,160 --> 00:07:54,820
.شكرًا لك على مراقبتهنّ

149
00:07:54,820 --> 00:07:56,950
.شكرًا لك أيضًا

150
00:07:57,970 --> 00:08:00,880
.حسنًا، سأترك الباقي لك

151
00:08:00,880 --> 00:08:02,410
!حسنًا... ماذا؟

152
00:08:02,990 --> 00:08:04,890
!سوف تغادر؟

153
00:08:04,890 --> 00:08:09,420
نعم. هذه فرصة جيّدة لكنّ
.كفتيات لتقضينها معًا

154
00:08:09,420 --> 00:08:11,990
.ستأتي إيموري برفقة كيمورا لاحقًا أيضًا

155
00:08:11,990 --> 00:08:14,370
.سأكون في غرفة مادّة الأحياء التّطبيقيّة

156
00:08:14,370 --> 00:08:16,660
.أحضري لي المفتاح فحسب عندما تنتهون

157
00:08:16,660 --> 00:08:18,220
.سأغادر إذًا

158
00:08:18,220 --> 00:08:19,070
!مـ-مهلاً

159
00:08:19,070 --> 00:08:19,940
ماذا؟

160
00:08:21,400 --> 00:08:23,060
ألن تظلّ لوقت أطول؟

161
00:08:23,680 --> 00:08:25,400
...حـ-حسنًا

162
00:08:25,840 --> 00:08:27,310
!ها هي قادمة

163
00:08:28,450 --> 00:08:29,720
!أجل

164
00:08:29,720 --> 00:08:31,330
!حسنًا! هيكاري

165
00:08:31,330 --> 00:08:32,090
—هجو

166
00:08:33,610 --> 00:08:34,930
!لقد أخفقت

167
00:08:34,930 --> 00:08:37,730
يا إلهي، ما كان ذلك؟

168
00:08:37,730 --> 00:08:39,460
!يوكّي

169
00:08:37,730 --> 00:08:40,310
فهمت... طلبت هيكاري-تشان هذا؟

170
00:08:40,310 --> 00:08:40,870
.نعم

171
00:08:41,430 --> 00:08:45,700
.لكن... الشّمس قويّة جدًّا اليوم

172
00:08:45,700 --> 00:08:47,440
هل ستكون بخير؟

173
00:08:47,780 --> 00:08:48,570
...حسنًا

174
00:08:48,570 --> 00:08:50,230
!يوكّي! التقطيها

175
00:08:50,230 --> 00:08:51,760
!حسنًا! ارميها

176
00:08:53,650 --> 00:08:55,130
.أظنّ أنّها ستكون بخير

177
00:08:56,420 --> 00:08:58,000
...فهمت

178
00:09:00,370 --> 00:09:03,910
حسنًا، لماذا لا تذهب وتمرح قليلاً أيضًا؟

179
00:09:03,910 --> 00:09:05,640
...ماذا؟ كلاّ

180
00:09:05,640 --> 00:09:07,100
...أنا أعني

181
00:09:07,890 --> 00:09:09,650
،بدل أن أستمتع أنا بوقتي

182
00:09:09,970 --> 00:09:13,730
.أردتك أنت أن تحظين ببعض المرح

183
00:09:15,090 --> 00:09:19,100
،عندما سألتني هيكاري بشأن استعمال المسبح

184
00:09:19,100 --> 00:09:25,110
أدركتُ أنّك لم تتمكّني على الأرجح
.من القيام بأمور مثل السّباحة بزيّ سباحة

185
00:09:25,110 --> 00:09:26,650
.هذا صحيح

186
00:09:26,650 --> 00:09:29,540
،هنالك أشخاص دائمًا في المسابح والشّواطئ

187
00:09:29,540 --> 00:09:31,310
.لذلك تجدني متردّدة نوعًا ما

188
00:09:31,310 --> 00:09:35,080
لهذا السّبب فكّرتُ أنّه إن كان مسبح
،المدرسة محجوزًا للفتيات فقط

189
00:09:35,080 --> 00:09:37,130
.فيمكنك أن تأخذي راحتك وتستمتعين ولو لمرّة

190
00:09:37,440 --> 00:09:39,280
.رغمّ أنّ هذا لسوء حظّ الفتية

191
00:09:41,680 --> 00:09:43,170
!ساتاكي

192
00:09:43,170 --> 00:09:44,300
!إيّاك أن تقع

193
00:09:44,300 --> 00:09:45,430
!لا داعي للقلق

194
00:09:45,990 --> 00:09:49,310
،بعد سماعي أنّ الفتيات حجزن المسبح
فكيف لي أن أجلس دون حراك؟

195
00:09:51,360 --> 00:09:52,890
...والآن، هذا مشهد

196
00:09:54,030 --> 00:09:56,090
!هيّا يا أوكاوا! اصعد إلى هنا

197
00:09:56,090 --> 00:09:58,080
.كلاّ، سأظلّ هنا

198
00:09:58,080 --> 00:10:00,200
فعلاً؟

199
00:10:00,590 --> 00:10:02,450
!ها هي واحدة أخرى

200
00:10:02,450 --> 00:10:06,390
.لهذا السّبب كنتُ في عجلة من أمري سابقًا

201
00:10:06,390 --> 00:10:09,700
آسف لأنّي جعلتُ الأمر يبدو
.وكأنّي ألقي بحمل العمل عليك

202
00:10:09,700 --> 00:10:10,990
!مستحيل

203
00:10:10,990 --> 00:10:13,420
.أنا أقدّر تفكيرك هذا

204
00:10:13,810 --> 00:10:16,660
،أنا ممتنّة كفاية لأنّك لاحظتَ ذلك

205
00:10:16,660 --> 00:10:18,760
...لكنّ القيام بترتيب كلّ هذا لي

206
00:10:19,210 --> 00:10:20,660
...أنا فعلاً

207
00:10:23,110 --> 00:10:24,390
...أحبّ

208
00:10:27,330 --> 00:10:28,870
...الفرصة لاستعمال تأثيري الجنسيّ

209
00:10:28,870 --> 00:10:31,860
.حسنًا، سوف أعود الآن

210
00:10:31,860 --> 00:10:33,330
.استمتعي بوقتك

211
00:10:33,330 --> 00:10:36,090
!كلاّ! لا أظنّ أنّ بقاءك سيكون مشكلة

212
00:10:36,090 --> 00:10:37,330
...لكن

213
00:10:37,330 --> 00:10:42,100
يبدو أنّ تأثيري الجنسيّ لا يؤثّر
!عليك بقدر ما يؤثّر على الآخرين

214
00:10:42,820 --> 00:10:44,930
...ذلك

215
00:10:44,930 --> 00:10:46,440
...أظنّ ذلك

216
00:10:46,440 --> 00:10:47,730
فعلاً؟

217
00:10:47,730 --> 00:10:50,150
...ربّما لديّ مقاومة ما له

218
00:10:50,150 --> 00:10:52,980
.ارتديتُ زيّ سباحة ظريفًا للغاية

219
00:10:52,980 --> 00:10:55,310
!عليك البقاء لتتمكّن من رؤيته

220
00:10:57,790 --> 00:10:58,640
!انظر

221
00:10:58,640 --> 00:11:00,660
أرأيت؟

222
00:11:06,250 --> 00:11:07,700
!ساتاكي

223
00:11:15,090 --> 00:11:18,020
.نعم، إنّه جدّ ظريف

224
00:11:18,650 --> 00:11:20,900
!جذّابة للغاية

225
00:11:21,320 --> 00:11:23,610
!هذا محرج للغاية

226
00:11:23,610 --> 00:11:25,870
تاكاهاشي-سينسي، هل ترغب بالسّباحة أيضًا؟

227
00:11:25,870 --> 00:11:28,040
.سيكون هذا تمرينًا جيّدًا

228
00:11:28,390 --> 00:11:31,490
.كلاّ... أنا لستُ سبّاحًا جيّدًا

229
00:11:31,790 --> 00:11:33,920
هل تقصد أنّك لا تستطيع السّباحة؟

230
00:11:32,380 --> 00:11:33,920
!هيّا! أنا جاهزة

231
00:11:34,280 --> 00:11:35,700
لأنّ اسمك يعني "رجل الحديد"؟

232
00:11:37,740 --> 00:11:39,640
...أمزح فحسب

233
00:11:42,300 --> 00:11:44,630
ما الخطب يا يوكّي؟

234
00:11:45,250 --> 00:11:47,190
.دخلت... مياه بأنفي فحسب

235
00:11:50,260 --> 00:11:51,740
،تاكاهاشي-سينسي

236
00:11:51,740 --> 00:11:54,860
ما الّذي قد تفعله إن اعترفت تلميذة بحبّها لك؟

237
00:11:56,720 --> 00:12:00,300
...رأيتُ هذا في مسلسل على التّلفاز و

238
00:12:00,300 --> 00:12:04,870
حسنًا، بغضّ النّظر عن إمكانية
...كون تلك التّلميذة مجنونة

239
00:12:04,870 --> 00:12:08,080
.أظنّ أنّي لن أستطيع مبادلتها المشاعر

240
00:12:08,370 --> 00:12:12,960
.لا أرى تلميذات الثّانويّة إلاّ أطفالاً

241
00:12:12,960 --> 00:12:14,790
.وفوق كلّ ذلك، إنّهنّ تلميذاتي

242
00:12:15,950 --> 00:12:17,540
.فهمت

243
00:12:20,100 --> 00:12:20,920
...أنا

244
00:12:22,200 --> 00:12:26,260
.أنا لستُ طفلة ولستُ تلميذة

245
00:12:29,220 --> 00:12:31,520
.نعم، أعلم ذلك

246
00:12:33,680 --> 00:12:36,980
ألا توجد أيّ أمواج لأنّنا في مسبح؟

247
00:12:43,570 --> 00:12:44,950
ما الّذي تفعلانه؟

248
00:12:44,950 --> 00:12:46,680
!هيّا، العبا معنا

249
00:12:46,680 --> 00:12:48,700
.آسفتان، نحتاج لاستراحة

250
00:12:49,020 --> 00:12:50,520
.حسنًا

251
00:12:50,520 --> 00:12:54,100
مع كلّ ذلك اللّعب، لا أعرف
.لماذا لا يشعرن بالتّعب

252
00:12:54,100 --> 00:12:55,560
.هذا صحيح

253
00:12:55,560 --> 00:12:58,000
.أشعر بالتّعب بسرعة هذه الأيّام

254
00:12:58,000 --> 00:13:00,090
.ربّما بدأت أفقد لياقتي

255
00:13:00,530 --> 00:13:02,000
!حظًّا سعيدًا يا يوكي-تشان

256
00:13:02,000 --> 00:13:02,850
!أنا لها

257
00:13:02,850 --> 00:13:04,500
أهلاً! هل تستمتعين؟

258
00:13:04,500 --> 00:13:08,150
نعم! ألن تسبح يا تاكاهاشي-سينسي؟

259
00:13:08,150 --> 00:13:09,140
...كلاّ

260
00:13:09,140 --> 00:13:10,600
!هيّا

261
00:13:10,600 --> 00:13:13,480
!لا أبالي لأيّ شيء

262
00:13:15,060 --> 00:13:17,440
...لا يمكنني الانضمام لذلك

263
00:13:18,150 --> 00:13:19,520
!أنا آسفة

264
00:13:19,520 --> 00:13:20,800
.لا مشكلة

265
00:13:21,650 --> 00:13:25,750
هذا رائع يا كيوكو. يمكنك الحديث
بينما تلعبين معنا؟

266
00:13:26,480 --> 00:13:27,790
!يوكّي

267
00:13:27,790 --> 00:13:29,490
!قادمة

268
00:13:30,400 --> 00:13:34,800
.هذا ممتع. إنّه كمشاهدة فنّان يقوم بعمله

269
00:13:34,800 --> 00:13:37,460
.كلّ ما أفعله هو تحريك جسدي

270
00:13:37,460 --> 00:13:39,800
،المشكلة الوحيدة هي عندما أكون بعيدة هكذا

271
00:13:39,800 --> 00:13:42,610
.أبدأ بالشّعور وكأنّه ليس جسدي

272
00:13:42,610 --> 00:13:46,160
.الأمر أشبه بلعب لعبة فيديو على ما أظنّ

273
00:13:46,160 --> 00:13:47,510
.فهمت

274
00:13:47,890 --> 00:13:51,640
،إن كانت هنالك دورة ألعاب كهذه
.فستحتلّين المركز الأوّل بكلّ تأكيد

275
00:13:51,640 --> 00:13:53,080
أتظنّ ذلك؟

276
00:13:53,080 --> 00:13:56,830
.هنالك اثنان آخران من الدّولاهان في العالم

277
00:13:56,830 --> 00:13:59,090
ستحصلين على الميداليّة البرونزيّة
.حتّى إن كنتِ الأخيرة

278
00:13:59,090 --> 00:14:00,590
!هذا صحيح

279
00:14:03,520 --> 00:14:05,220
هل تظنّ

280
00:14:05,220 --> 00:14:08,860
أنّ الأساطير عن الدّولاهان مختلفة
عن بقيّة الدّيمي؟

281
00:14:08,860 --> 00:14:14,080
أقصد مثل فكرة ربط الدّولاهان دائمًا
بصورة الفارس على صهوة حصان؟

282
00:14:14,080 --> 00:14:16,980
هذا صحيح. لا يملك الكثير من الدّيمي

283
00:14:16,980 --> 00:14:21,640
.أساطير تحدّد طبقة أو مهنة ما لهم كالفارس

284
00:14:21,640 --> 00:14:24,180
.حاولت التّفكير في الأمر

285
00:14:24,180 --> 00:14:28,230
،ربما قبل زمنٍ بعيد
،كان الدولاهان العظيم فارسًا بارعًا

286
00:14:28,230 --> 00:14:31,340
وكانت صورته هي الّتي علقت
.في الأذهان على مرّ التّاريخ

287
00:14:31,830 --> 00:14:33,890
...فهمت

288
00:14:33,890 --> 00:14:36,750
إن كان هنالك دولاهان فارس
،بتلك القوّة والحيويّة

289
00:14:36,750 --> 00:14:38,270
.أنا واثق أنّه لكان ليغدو أسطورة

290
00:14:38,270 --> 00:14:42,470
،وإن كان هذا قد بدأ معه
.فإنّ خصوصيّة الصّورة تبدو منطقيّة

291
00:14:42,470 --> 00:14:46,050
،عند التّفكير في الأمر على هذا النّحو
.تصبح الأساطير الأخرى مناسبة أيضًا

292
00:14:46,050 --> 00:14:49,850
،معروف عن الدّولاهان أنّهم نُذراء موت

293
00:14:49,850 --> 00:14:52,820
.ممّا يعني أنّ الدّولاهان هو آخر شيء يمكن رؤيته

294
00:14:52,820 --> 00:14:57,410
ربّما تكون فكرة رمي حوض من الدّماء
على أولئك الّذين يقفون على عتبتهم

295
00:14:57,410 --> 00:15:02,300
.هو ما يبدو عليه موت الأشخاص الّذين قتولهم

296
00:15:02,300 --> 00:15:04,620
سمعتُ أيضًا أنّ أولئك

297
00:15:04,620 --> 00:15:07,500
.الّذين رأوا دولاهان فُقعت أعينهم وما شابه

298
00:15:07,500 --> 00:15:10,550
.بالتّفكير في الأمر الآن، كلّ الأساطير متشابهة

299
00:15:10,550 --> 00:15:12,070
!أنا لها

300
00:15:12,070 --> 00:15:13,010
!هيّا

301
00:15:13,720 --> 00:15:15,720
لكن أليست هنالك قصص أخرى؟

302
00:15:16,450 --> 00:15:19,940
.كعدم مقدرة الدّولاهان على تجاوز نهر متدفّق

303
00:15:20,390 --> 00:15:22,440
ما معنى تلك في رأيك؟

304
00:15:22,800 --> 00:15:24,000
لا بدّ أنّ ذلك

305
00:15:24,000 --> 00:15:27,600
.لنفس السّبب الّذي يبقيني هنا أمام المسبح

306
00:15:28,200 --> 00:15:29,810
.نعم، صحيح

307
00:15:29,810 --> 00:15:33,520
من المخيف التّفكير فيما قد يحدث
.إن أسقطتِ رأسك في الماء

308
00:15:33,520 --> 00:15:36,360
،سيكون الأمر أقلّ خطورة في المسبح

309
00:15:36,360 --> 00:15:38,710
...لكن إن حدث ذلك في نهر جارٍ

310
00:15:39,950 --> 00:15:42,460
.فستكون النّهاية. لا مهرب منها

311
00:15:42,820 --> 00:15:44,340
أظنّ أنّ ذلك يعني

312
00:15:44,340 --> 00:15:49,120
أنّ حتّى الدّولاهان ما كانوا
.ليخاطروا بمطاردة أحد ما نحو نهر

313
00:15:49,120 --> 00:15:52,140
.أحبّ تلك الأسطورة. لديها صلة بي

314
00:15:52,140 --> 00:15:53,260
...ماتشي

315
00:15:53,600 --> 00:15:57,420
أنت مشغولة بالحديث وقد
.توقّف جسدك عن الحركة

316
00:15:57,420 --> 00:15:59,500
.آسفة

317
00:15:59,500 --> 00:16:03,200
...على أيّ حال! إنّ الاستماع لكما جعلني أفكّر

318
00:16:03,200 --> 00:16:05,770
لم تنزلي تحت الماء من قبل، صحيح؟

319
00:16:05,770 --> 00:16:08,750
تحت الماء... تقصدين رأسي؟

320
00:16:08,750 --> 00:16:09,730
.نعم

321
00:16:09,730 --> 00:16:11,450
.هذا صحيح، لم أفعل ذلك

322
00:16:11,450 --> 00:16:14,660
!يا للخسارة

323
00:16:14,660 --> 00:16:18,950
.يبدو كلّ شيء جميلاً تحت الماء

324
00:16:18,950 --> 00:16:21,660
!لا أصدّق أنّك لم ترينه من قبل

325
00:16:21,660 --> 00:16:24,290
!يا لها من خسارة

326
00:16:32,520 --> 00:16:34,610
...بدأت أشعر بالتّوتّر

327
00:16:34,610 --> 00:16:37,170
إلى من يتحدّث سينسي؟

328
00:16:37,170 --> 00:16:38,590
.والد ماتشي

329
00:16:38,590 --> 00:16:41,500
أراد سينسي أن يطلب الإذن منه
.قبل أن تنزل تحت الماء

330
00:16:41,500 --> 00:16:45,140
هل هذا ضروريّ بالفعل رغم أنّ الأمر
لن يدوم إلاّ بضعة ثوانٍ؟

331
00:16:45,140 --> 00:16:46,770
.إنّه مهمّ للغاية

332
00:16:47,040 --> 00:16:49,450
،حتّى وإن كنتِ تعرفين أنّك ستحصلين على الإذن

333
00:16:49,450 --> 00:16:52,470
.فالاتّصال به وطلبه أمر مهمّ للغاية

334
00:16:53,040 --> 00:16:56,080
سينسي، لماذا تغمرين جسدك
بالكامل تحت الماء فيما عدا رأسك؟

335
00:16:56,080 --> 00:16:59,810
ما أزال محرجة من رؤية الأخرين
...لي بزيّ السّباحة

336
00:16:59,810 --> 00:17:00,800
!اهتممتُ بذلك

337
00:17:01,470 --> 00:17:02,950
!نحن جاهزون للأمر

338
00:17:03,250 --> 00:17:05,270
.سوف أحمل رأسك يا ماتشي

339
00:17:05,270 --> 00:17:06,500
.حسنًا

340
00:17:07,760 --> 00:17:09,460
هل جميعكنّ جاهزات؟

341
00:17:09,460 --> 00:17:10,590
!نعم

342
00:17:10,590 --> 00:17:11,940
.حسنًا، لنبدأ

343
00:17:11,940 --> 00:17:13,010
...واحد، اثنان

344
00:17:55,080 --> 00:17:56,800
كيف كان ذلك؟ هل تمكّنتِ من الرّؤية؟

345
00:17:57,720 --> 00:17:59,890
!كان ذلك جميلاً للغاية

346
00:18:00,580 --> 00:18:03,550
.فعلاً؟ لم أفهم ما قلته، لكن طوبا لك

347
00:18:03,550 --> 00:18:05,850
!ماتشي، لننزل معًا بعد هذا

348
00:18:05,850 --> 00:18:07,130
!ثمّ معي أنا

349
00:18:07,130 --> 00:18:07,690
!أكيد

350
00:18:08,040 --> 00:18:10,890
.مهلاً، على رسلك. المبالغة في الأمر قد تكون خطيرة

351
00:18:09,100 --> 00:18:11,260
لماذا لا تنزلان تحت الماء معنا؟

352
00:18:11,260 --> 00:18:12,540
.إنّ ذلك جميل للغاية

353
00:18:12,540 --> 00:18:14,930
...فعلاً... لا

354
00:18:14,930 --> 00:18:16,470
!حسنًا، لنقم بذلك

355
00:18:16,470 --> 00:18:17,700
.يوكي، أمسكي بيدها الأخرى

356
00:18:16,470 --> 00:18:17,700
شـ-شيزوكا؟

357
00:18:17,700 --> 00:18:18,450
!حسنًا

358
00:18:18,450 --> 00:18:20,850
...لنبدأ! واحد، اثنان

359
00:18:18,450 --> 00:18:20,980
!ما... يوكي؟ لا... مهلاً، مهلاً

360
00:18:18,450 --> 00:18:21,530
!لا يمكنك الإفلات من الأمر

361
00:18:20,850 --> 00:18:21,530
!هيّا

362
00:19:05,240 --> 00:19:06,870
ماذا؟ ما زلتِ هنا؟

363
00:19:08,360 --> 00:19:09,420
.لقد أصبت بحرقة شمس

364
00:19:13,440 --> 00:19:14,690
هل ستكونين بخير؟

365
00:19:14,690 --> 00:19:17,760
.سأكون بخير. سأكون أفضل بعد استراحة ليوم

366
00:19:17,760 --> 00:19:19,550
ألهذا السّبب اقترحتِ يوم السّبت؟

367
00:19:19,890 --> 00:19:21,510
كنتَ قلقًا بشأني؟

368
00:19:22,040 --> 00:19:23,200
.أكيد

369
00:19:24,250 --> 00:19:26,100
.سينسي، شكرًا لك

370
00:19:27,260 --> 00:19:29,050
،منذ أن خطّطتُ لهذا

371
00:19:29,050 --> 00:19:32,770
أعطيتَ الأولويّة لاستمتاعي بوقتي، صحيح؟

372
00:19:33,160 --> 00:19:36,800
،فكرة ذهاب مصّاصة دماء إلى المسبح
...تحت أشعة شمس الصّيف

373
00:19:36,800 --> 00:19:38,850
،إن لم تمنحني هيماري-تشان الإذن

374
00:19:38,850 --> 00:19:41,110
.لكنتُ خائفًا للغاية من السّماح لك بذلك

375
00:19:41,440 --> 00:19:45,340
،حسنًا، إن طلبتُ الذّهاب لمسبح داخليّ
.لاستطاع الجميع أن يرى حقيقتي

376
00:19:45,340 --> 00:19:49,040
،وفي المرّة التّالية الّتي سنلعب فيها
لما كنّ ليتصرّفنّ على طبيعتهنّ حولي، صحيح؟

377
00:19:49,670 --> 00:19:51,250
.ما كنتُ لأريد ذلك

378
00:19:52,430 --> 00:19:53,500
.لا

379
00:19:53,910 --> 00:19:54,900
!إلى اللّقاء إذًا

380
00:19:54,900 --> 00:19:57,070
.نعم. أراك يوم الاثنين

381
00:20:21,950 --> 00:20:23,240
!صباح الخير يا سينسي

382
00:20:23,630 --> 00:20:24,860
.أجل، صباح الخير

383
00:20:28,310 --> 00:20:30,150
...أخبرني يا سينسي

384
00:20:30,150 --> 00:20:34,540
لقد التقينا هنا لأوّل مرّة، صحيح؟

385
00:20:35,050 --> 00:20:37,750
.حينها، كانت زهور الكرز متفتّحة بالكامل

386
00:20:37,750 --> 00:20:41,120
وهل تذكر يا سينسي ما قلتَه لي قبل البارحة؟

387
00:20:41,120 --> 00:20:44,260
لا بدّ أنّ مصّاصي الدّماء يعيشون
.حياة محاصرة في المجتمع العصريّ

388
00:20:44,760 --> 00:20:47,100
لكن هل تعرف ما هو رأيي؟

389
00:20:47,100 --> 00:20:49,640
،إنّ امتلاك أشخاص نبكي معهم ونحن حزانى

390
00:20:49,640 --> 00:20:52,100
...ونضحك معهم ونحن نستمتع بوقتنا

391
00:20:52,570 --> 00:20:54,140
،حتّى إن كان ذلك مقيّدًا نوعًا ما

392
00:20:54,140 --> 00:20:57,960
فقضاء الوقت مع أولئك الأشخاص نفيس أكثر

393
00:20:57,960 --> 00:20:59,150
.وأكثر متعة بكثير

394
00:20:59,490 --> 00:21:02,860
!لذلك أظنّ أنّ مصّاصي الدّماء الحاليّين سعداء

395
00:21:03,600 --> 00:21:04,610
.فهمت

396
00:21:04,610 --> 00:21:06,390
!حسنًا، سأكمل طريقي إذًا

397
00:21:06,390 --> 00:21:07,990
.مهلاً، انتظري لحظة

398
00:21:07,990 --> 00:21:08,700
ماذا؟

399
00:21:08,990 --> 00:21:11,290
.اكتبي اسمك قبل دخولك

400
00:21:09,660 --> 00:21:11,290
لائحة التّلاميذ المتأخّرين

401
00:21:15,470 --> 00:21:17,440
يا سينسي، هل تذكر؟

402
00:21:17,440 --> 00:21:19,040
.نعم، كفاك من ذلك. اكتبيه

403
00:21:19,040 --> 00:21:20,530
!لو سمحت! استمع لي

404
00:21:20,530 --> 00:21:21,600
حسنًا، ماذا؟

405
00:21:21,600 --> 00:21:24,840
،لم ترد هيماري أن تصفّف شعري
!وقالت أنّ عليّ القيام بذلك بمفردي

406
00:21:24,840 --> 00:21:28,290
،غادرت من دوني. وبعدها
!تأخّرت وأنا أصفّف شعري

407
00:21:28,290 --> 00:21:29,920
.فهمت. اكتبي اسمك الآن

408
00:21:30,970 --> 00:21:34,300
!أرجوك يا سيّدي القاضي

409
00:21:34,300 --> 00:21:36,560
.في البداية، كان الأمر بدافع الاهتمام فحسب

410
00:21:36,560 --> 00:21:39,520
.ظننت أنّ الأمر سيجدي نفعًا

411
00:21:37,590 --> 00:21:39,520
.بدأت أشكّل صلة مع هؤلاء الفتيات

412
00:21:39,930 --> 00:21:43,490
.وبدأت أشعر برغبة بمساعدتهنّ

413
00:21:43,490 --> 00:21:47,200
،لكنّي تعلّمت منهنّ مرّات كثيرة

414
00:21:47,810 --> 00:21:50,780
.وحصلتُ على مساعدة أكثر منهنّ

415
00:21:51,850 --> 00:21:53,620
.لن أتحدّث معهنّ بما يكفي

416
00:21:54,210 --> 00:21:57,730
حتّى أبي قال أنّه ليس عليّ الاعتماد
!على هيماري طوال الوقت

417
00:21:57,730 --> 00:21:59,970
!الجميع لئيمون للغاية

418
00:21:59,970 --> 00:22:03,100
هذه ثالث مرّة، لذلك ستبقين بعد
.المدرسة وتساعدين في التّنظيف

419
00:22:03,100 --> 00:22:05,860
!أرجوك! أيّ شيء عدا ذلك

420
00:22:05,860 --> 00:22:08,780
.حسنًا، لديّ اجتماع هيئة تدريس لأذهب إليه

421
00:22:08,780 --> 00:22:11,300
!سينسي

422
00:22:14,420 --> 00:22:17,170
أحتاج للمزيد من اللّقاءات

423
00:22:17,770 --> 00:22:19,880
!مع هؤلاء الدّيمي-تشان