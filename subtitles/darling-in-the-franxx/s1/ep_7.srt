1
00:00:03,670 --> 00:00:07,730
،بعد التقبيل الناجح مع المستعمرة الزراعيّة 26

2
00:00:08,620 --> 00:00:12,570
مُنحت الفرقة 13 إجازة خاصّة

3
00:00:19,240 --> 00:00:22,080
!إنه المحيط

4
00:00:23,230 --> 00:00:24,710
إنّهما بغاية الطفوليّة

5
00:00:24,710 --> 00:00:27,070
قضاء استراحة لا يعني
أن بمقدورك أن تتحمّس

6
00:00:27,070 --> 00:00:28,310
لا ألومهما

7
00:00:28,310 --> 00:00:31,460
فهذه أوّل مرة نرى فيها محيطاً
يمكن السباحة فيه

8
00:00:31,460 --> 00:00:35,230
لكن لم أعلم ببقاء مكان
سليم كهذا في السّطح

9
00:00:37,380 --> 00:00:39,150
،منذ أن تمّ تعييننا في الفرقة

10
00:00:39,150 --> 00:00:42,350
ونحن نعيش حياةً مليئة بالتوتُّر
والقلق الشّديدين

11
00:00:42,350 --> 00:00:45,530
،لكن هذا المنظر كان خالياً تماماً من ذلك

12
00:00:50,540 --> 00:00:53,570
أنتم! لا تبتعدوا كثيراً

13
00:00:54,690 --> 00:00:57,470
قالَتْ نانا أنّها ستأتي لتقلنا في صباح الغد

14
00:00:57,890 --> 00:01:00,250
أتعتقدين أنّ هذا نوع ما من التدريبات أيضاً؟

15
00:01:00,250 --> 00:01:01,260
من يدري؟

16
00:01:03,890 --> 00:01:04,330
...لكن

17
00:01:04,810 --> 00:01:07,180
،يبدو هذا خالياً من الكيوريو

18
00:01:07,180 --> 00:01:09,960
وبما أنّنا هنا على أي حال، فلنقضِ وقتاً ممتعاً

19
00:01:09,960 --> 00:01:11,840
نـ-نعم

20
00:01:13,110 --> 00:01:14,590
!هيّا بنا يا حبيبي

21
00:01:15,540 --> 00:01:18,230
!على مهلكِ قليلاً يا زيرو تو

22
00:01:16,180 --> 00:01:18,650
يسرّني أنّ هيرو قد تحسّن الآن

23
00:01:18,230 --> 00:01:19,650
!بسرعة

24
00:01:18,650 --> 00:01:20,980
قلِقنا عن فراغ

25
00:01:20,980 --> 00:01:23,670
ولكن الآن تِلك الإشاعة عن
،زيرو تو قد بَطُلَتْ

26
00:01:23,670 --> 00:01:25,810
وأصبح هيرو طفيليّاً بشكلٍ رسميّ

27
00:01:26,140 --> 00:01:28,230
كلّها أنباء سارّة، ألا تعتقدين ذلك؟

28
00:01:28,230 --> 00:01:31,780
عقب تلك المعركة، أصبح كلاهما شريكين رسميّين

29
00:01:30,500 --> 00:01:31,780
!خذ هذا

30
00:01:32,320 --> 00:01:34,670
،ما زلتُ أشكّك بزيرو تو

31
00:01:33,370 --> 00:01:35,190
هيّا يا حبيبي

32
00:01:34,670 --> 00:01:39,050
لكن نظرة واحدة إلى هيرو تجعل من الواضح
أنّها ما يحتاجه هو بالضبط

33
00:01:40,650 --> 00:01:41,450
أجل

34
00:01:41,970 --> 00:01:43,490
أنا مسرورة حقّاً

35
00:03:15,420 --> 00:03:21,590
من كان يتوقّع أنّ ذلك النموذج الخاصّ
الفاشل يمتلك كلّ هذه القدرة؟

36
00:03:21,590 --> 00:03:25,300
بالفعل. ليته أظهرَ لنا هذا منذ البداية

37
00:03:25,660 --> 00:03:29,650
بحثُ فتاتنا السّخيف عن رجُل
قد انتهى أخيراً

38
00:03:29,650 --> 00:03:31,650
ينبغي أن نكون سُعداء بهذا

39
00:03:31,650 --> 00:03:35,560
لكن هذا لا يغيّر من حقيقة أنّها ما زالت
يجب أن تخضع للرقابة عن كثب

40
00:03:35,870 --> 00:03:41,320
أعلن هاهنا عن إعطاء الأولويّة
لمراقبة المستعمرة الزراعيّة 13

41
00:03:41,320 --> 00:03:46,990
الرمز 016 مُكلّف بإحضار فتاتنا
إلى الشقّ العظيم بسلام

42
00:03:46,990 --> 00:03:48,830
لقد حان الوقت أخيراً

43
00:03:49,990 --> 00:03:51,850
مراقبة خاصّة؟

44
00:03:52,270 --> 00:03:57,030
هذا لأنّ زيرو تو أصبحت الآن ضمن نطاق
المستعمرة الزراعيّة 13 رسمياً؟

45
00:03:57,030 --> 00:04:02,550
أحد قوّات أيب الخاصّة أصبح
طفيليّاً خاصّاً بمستعمرة زراعيّة

46
00:04:03,140 --> 00:04:05,700
لم يسبق أن حدث هذا، لكن
كان القرار البديهيّ

47
00:04:07,750 --> 00:04:10,640
زيرو تو. تسرّني رؤيتك بحال جيّدة

48
00:04:11,080 --> 00:04:13,600
يعزو كلّ الفضل لجهود حبيبي

49
00:04:14,270 --> 00:04:16,860
لم يكن هناك أي داعٍ لتأتي
إلى هنا. سنكون على ما يُرام

50
00:04:16,860 --> 00:04:18,110
لا تكوني كذلك

51
00:04:18,110 --> 00:04:19,470
هل ستغادر بهذه السرعة؟

52
00:04:18,810 --> 00:04:21,490
هيرو، هذا البروفيسور فرانكس

53
00:04:19,470 --> 00:04:21,490
حصلتُ على ما أتيتُ لأجله

54
00:04:21,490 --> 00:04:23,820
مُبتكِر الفرانكس

55
00:04:21,830 --> 00:04:23,820
يبدو أنّ حضوري لم يكن ضرورياً

56
00:04:24,790 --> 00:04:26,070
...المُبتكِر

57
00:04:26,410 --> 00:04:27,740
—وهذا

58
00:04:27,740 --> 00:04:29,290
لا حاجة للتعريف عنّا

59
00:04:29,290 --> 00:04:33,290
سنلتقي ببعضنا الآخر حتماً يوماً ما

60
00:04:34,090 --> 00:04:37,290
هذه أوّل مرّة ينجو فيها شخص مع زيرو تو

61
00:04:38,920 --> 00:04:40,050
هذا هو شكلك إذاً

62
00:04:40,930 --> 00:04:43,670
أقرّ بأنّكم أثرتم اهتمامي

63
00:04:44,340 --> 00:04:45,180
بروفيسور

64
00:04:45,610 --> 00:04:52,750
اعتباراً من اليوم، يُنقَل ستريليزيا والرمز 002
إلى نِطاق المستعمرة الزراعيّة 13

65
00:04:52,750 --> 00:04:55,540
أعلم. أخبرني العجائز بذلك سلفاً

66
00:04:56,540 --> 00:04:57,190
،وبالتالي

67
00:04:57,640 --> 00:05:04,010
يتمّ تعيين الرمز 016 هاهنا رسمياً
شريكاً للرمز 002

68
00:05:04,010 --> 00:05:05,620
!حـ-حاضر

69
00:05:05,620 --> 00:05:07,910
!حبيبي! أنا سعيدة جداً

70
00:05:08,590 --> 00:05:10,740
!لا أستطيع التنفّس يا زيرو تو

71
00:05:11,210 --> 00:05:12,410
بروفيسور

72
00:05:13,130 --> 00:05:16,290
سأكون بخير بوجودي مع حبيبي
سنفعل هذا معاً

73
00:05:17,190 --> 00:05:20,820
في أغلب الأوقات، يحتاج المرء لعناصر
خارجيّة كي يتكيّف مع بيئته

74
00:05:20,820 --> 00:05:22,550
أعتقد أنّ هذا هو الغرض
من الأمر الخاصّ هذا

75
00:05:23,340 --> 00:05:24,300
،ناهيك عن ذلك

76
00:05:24,760 --> 00:05:27,720
إرسال الأطفال إلى الشاطئ بمفردهم؟

77
00:05:27,720 --> 00:05:31,310
أفكار البروفيسور صادمة دوماً

78
00:05:31,740 --> 00:05:32,810
!ها أنا ذي

79
00:05:33,390 --> 00:05:34,270
!ارميها

80
00:05:34,270 --> 00:05:37,580
!استعداد... هيّا

81
00:05:39,520 --> 00:05:41,780
الشّاطئ جميل، أليس كذلك؟

82
00:05:41,780 --> 00:05:42,520
أجل

83
00:05:45,220 --> 00:05:46,610
،لسبب ما

84
00:05:46,610 --> 00:05:49,390
تبدو الفتيات أظرف بنسبة 50%. هذا لغز

85
00:05:49,390 --> 00:05:51,530
نعم، هذا مُمتع حقّاً للناظرين

86
00:05:51,950 --> 00:05:55,750
ماذا؟ هل أنت منّا يا غورو؟

87
00:05:56,060 --> 00:05:59,770
حسبتُ أنّ أصحاب الأرقام الثنائيّة
مثلك فاضِلون لدرجة التكلُّف

88
00:05:59,770 --> 00:06:01,540
لكن يبدو أنّ أفكارنا مشتركة أكثر ممّا توقّعت

89
00:06:01,540 --> 00:06:04,460
ما-ماذا تقول؟ أنا شابّ أيضاً

90
00:06:04,460 --> 00:06:07,250
كيف يُفترَض بي أن أتجاهل هذا المنظر المدهش؟

91
00:06:08,010 --> 00:06:10,250
هل أنتِ بخير؟

92
00:06:10,250 --> 00:06:12,270
آسفة. كنتُ أنظر للأعلى طوال الوقت

93
00:06:12,270 --> 00:06:14,170
هذا الخيط على وشك أن ينحل

94
00:06:14,170 --> 00:06:16,730
!يا للهول! اربطيه لي أرجوكِ

95
00:06:17,090 --> 00:06:19,060
!يحيا الشّاطئ

96
00:06:20,370 --> 00:06:22,710
إلى أيّ مدى ستذهبين؟

97
00:06:24,490 --> 00:06:26,710
أنتما، انظرا إلى ذلكما الاثنين

98
00:06:30,980 --> 00:06:33,550
السّباحة في المحيط منعشة للغاية

99
00:06:34,260 --> 00:06:35,910
ومذاقه مالح حقّاً

100
00:06:36,690 --> 00:06:38,370
إنّه بحر حقيقي هذه المرة، أليس كذلك

101
00:06:39,010 --> 00:06:39,990
يا حبيبي؟

102
00:06:43,660 --> 00:06:44,420
حبيبي؟

103
00:06:44,420 --> 00:06:47,290
...آ-آسف، كلّ ما في الأمر أنّ رؤيتكِ بزي سباحة

104
00:06:47,290 --> 00:06:47,940
غريب؟

105
00:06:47,940 --> 00:06:52,510
،لا، تبدين جميلة! لكن لسببٍ ما
...أشعر بالخجل قليلاً

106
00:06:52,510 --> 00:06:54,910
لكنّك رأيتني عارية من قبل

107
00:06:54,910 --> 00:06:56,640
!لـ-لم يكن ذلك عن قصد

108
00:06:57,740 --> 00:07:01,020
أنت من ساعدني على الوصول
إلى هنا يا حبيبي

109
00:07:01,430 --> 00:07:04,270
لم يسبق أن سبحتُ في محيط

110
00:07:05,870 --> 00:07:08,280
أنت جناحايّ، صحيح؟

111
00:07:08,660 --> 00:07:12,280
بوجودي معك، أستطيع التّحليق
في أي مكان أريد

112
00:07:12,280 --> 00:07:13,670
قل لي يا حبيبي

113
00:07:14,210 --> 00:07:17,040
سنبقى معاً دوماً، صحيح؟

114
00:07:18,790 --> 00:07:19,770
...دوماً

115
00:07:21,790 --> 00:07:23,460
الرمز 016

116
00:07:23,860 --> 00:07:26,140
دعني أسدي إليك بنصيحة

117
00:07:26,140 --> 00:07:27,090
نـ-نعم؟

118
00:07:27,510 --> 00:07:29,860
لا تدعها تستهلك عواطفك أيضاً

119
00:07:30,590 --> 00:07:35,100
هذا إذا أردتَ أن تكون شريكها دوماً

120
00:07:35,100 --> 00:07:38,550
وإلّا ستكون أنت من يعاني لاحقاً

121
00:07:39,100 --> 00:07:42,380
فأنا وأنت تجاوزنا حدّاً معاً

122
00:07:48,510 --> 00:07:51,070
مذاقك يجعل نبضات قلبي تتسارع حقّاً

123
00:07:54,020 --> 00:07:55,610
هل كنتَ تتأمّل قبلة؟

124
00:07:56,740 --> 00:07:59,620
القبلة هي إعلان بأنّ الشخص
الآخر ينتمي إليك

125
00:08:00,150 --> 00:08:03,650
لذا لا ينبغي أن تقبّل سوى
الشّخص الذي تحبّه، مفهوم؟

126
00:08:03,650 --> 00:08:05,380
حبّ؟ قبلة؟

127
00:08:05,950 --> 00:08:09,860
لحظة... هل سبقَ وفعلتَ هذا
مع شخص غيري ربّما؟

128
00:08:09,860 --> 00:08:11,900
...ماذا؟ فـ-في الواقع

129
00:08:15,290 --> 00:08:16,140
حبيبي؟

130
00:08:20,060 --> 00:08:21,540
!أمسكتُك

131
00:08:23,620 --> 00:08:24,560
إتشيغو؟

132
00:08:27,100 --> 00:08:28,210
هل يهمك؟

133
00:08:28,210 --> 00:08:29,070
!ماذا؟

134
00:08:30,650 --> 00:08:32,260
أعني المحيط

135
00:08:32,260 --> 00:08:34,080
ألن تسبحي؟

136
00:08:34,080 --> 00:08:35,950
لطالما كنتِ بارعة في السّباحة

137
00:08:35,950 --> 00:08:38,010
هذا ما قصدتِه إذاً؟

138
00:08:38,010 --> 00:08:41,160
...في الواقع، أجل

139
00:08:41,910 --> 00:08:45,180
أحمل هذا الكتاب، لذا لا تقلقي بشأني واذهبي

140
00:08:47,590 --> 00:08:48,930
شكراً يا إيكونو

141
00:08:56,140 --> 00:08:58,680
أتيتِ إلى هنا فقط كي تقرئي؟

142
00:08:59,010 --> 00:09:01,880
إجبار نفسي على أجواء المرح
لا يلائمني كثيراً

143
00:09:01,880 --> 00:09:03,430
ليس لديّ أي اعتراض

144
00:09:04,580 --> 00:09:06,440
!استسلم فحسب

145
00:09:05,230 --> 00:09:06,440
أليس هذا رائعاً؟

146
00:09:06,440 --> 00:09:08,010
!تباً

147
00:09:06,990 --> 00:09:11,190
الشابّ الذي بدا وكأنّه أراد الموت
منذ فترة ليست ببعيدة

148
00:09:08,010 --> 00:09:11,190
!كفّوا عن ذلك أرجوكم

149
00:09:11,510 --> 00:09:14,950
أمسى جزءاً من المجموعة ثانية الآن

150
00:09:14,950 --> 00:09:17,590
لا تتوقّع تأكيداً منّي

151
00:09:17,590 --> 00:09:19,410
أنا لستُ مثلك

152
00:09:19,410 --> 00:09:21,910
على رسلك. كنتُ أخاطب نفسي فحسب

153
00:09:22,440 --> 00:09:25,290
أهذا كلّ ما أردتَ الحديث عنه؟
هل انتهينا الآن إذاً؟

154
00:09:25,290 --> 00:09:26,620
لا

155
00:09:27,210 --> 00:09:29,630
وجدتُ شيئاً غريباً

156
00:09:31,330 --> 00:09:33,100
ما الذي أصابكم فجأة؟

157
00:09:33,100 --> 00:09:35,760
،لم أكن أنوي التطفُّل

158
00:09:35,760 --> 00:09:38,010
لكنّهما لم يصغيا إليّ

159
00:09:38,010 --> 00:09:39,970
ما-ما الأمر؟

160
00:09:41,410 --> 00:09:42,640
ما هي القبلة؟

161
00:09:42,640 --> 00:09:43,600
!ماذا؟

162
00:09:43,600 --> 00:09:45,380
!كـ-كنتم تستمعون؟

163
00:09:45,380 --> 00:09:49,990
لم أسمع بكلمة "قبلة" من قبل
!لكنّها تبدو سحريّة

164
00:09:51,610 --> 00:09:53,890
إلى أين تظنُّ نفسك ذاهباً يا عزيزي هيرو-كن؟

165
00:09:53,890 --> 00:09:55,860
هل أنت متأكّد أنّك لا تخفي عنّا شيئاً؟

166
00:09:55,860 --> 00:09:58,000
ما الذي كنتُما تفعلانه؟

167
00:09:58,000 --> 00:09:59,780
!لـ-لا شيء

168
00:09:59,780 --> 00:10:01,160
!هـ-هيّا، ساعدني

169
00:10:01,160 --> 00:10:02,080
...هيرو

170
00:10:02,700 --> 00:10:04,180
أريد أن أعرف أيضاً

171
00:10:04,690 --> 00:10:05,750
ما هي القبلة؟

172
00:10:05,750 --> 00:10:07,330
!حتّى أنت أيضاً

173
00:10:08,450 --> 00:10:11,210
أ-أنا بحدِّ ذاتي لا أفهمها

174
00:10:11,210 --> 00:10:15,400
إ-إنها عندما يلصق شخصٌ فمه
بفمِ شخص آخر

175
00:10:15,400 --> 00:10:16,470
!فمه؟

176
00:10:16,470 --> 00:10:19,810
!يُستخدَم الفم لشيء آخر غير الأكل؟

177
00:10:19,810 --> 00:10:21,720
ألا تتنفّس منه أحياناً؟

178
00:10:21,720 --> 00:10:24,390
وماذا يحدث عندما تقبّل أو أياً يكن؟

179
00:10:25,850 --> 00:10:29,390
تـ-تشعر برقّة ودفء

180
00:10:30,230 --> 00:10:31,400
...و

181
00:10:32,670 --> 00:10:34,260
جعل ذلك نبضات قلبي تتسارع

182
00:10:34,260 --> 00:10:36,400
!لـ-لكن لم نقبّل بعضنا قبل قليل

183
00:10:36,400 --> 00:10:38,510
أريد تجربة ذلك

184
00:10:39,280 --> 00:10:41,600
!ما هذا؟ أريد حقّاً أن أجرّب الشعور

185
00:10:41,600 --> 00:10:44,280
!تبّاً لك! سبقتَنا في فعل شيء مجدّداً

186
00:10:45,240 --> 00:10:47,580
!دعني أقبّلك

187
00:10:48,020 --> 00:10:50,570
انتظر! ينبغي أن تفعل ذلك
!مع الشخص الذي تحبّه

188
00:10:50,570 --> 00:10:52,370
ماذا يعني "الشخص الذي تحبّه" بالضبط؟

189
00:10:51,680 --> 00:10:52,370
!توقّف

190
00:10:52,370 --> 00:10:53,460
ماذا تفعلون؟

191
00:10:53,460 --> 00:10:55,340
...لا توقفني

192
00:10:58,030 --> 00:10:59,170
!مؤلم

193
00:10:59,170 --> 00:11:01,590
هل تعلمين ماذا تعني "قبلة" يا إتشيغو؟

194
00:11:02,500 --> 00:11:04,970
حيث يلامس فاها شخصين بعضهما الآخر

195
00:11:04,970 --> 00:11:05,930
...لـ

196
00:11:05,930 --> 00:11:07,540
!لـ-لا أعرف

197
00:11:08,190 --> 00:11:09,350
!أنتم

198
00:11:11,770 --> 00:11:13,940
هل لي بلحظة؟

199
00:11:25,750 --> 00:11:27,960
هل أنت متأكّد؟

200
00:11:27,960 --> 00:11:31,330
أجل. سترونه في نهاية هذا الطريق

201
00:11:31,660 --> 00:11:34,600
!هذا أشبه باستكشاف. كم هذا مثير

202
00:11:34,600 --> 00:11:37,970
لكن المكان مظلم جداً لدرجة تُخيفني قليلاً

203
00:11:38,810 --> 00:11:41,510
لم يكن هناك حاجة لمجيئكِ
معنا إن كنتِ لا تريدين

204
00:11:42,290 --> 00:11:45,100
!أنت! لا تتكلّم مع كوكورو بهذا الشكل

205
00:11:46,420 --> 00:11:47,940
،على الأقلّ

206
00:11:47,940 --> 00:11:50,410
لا أضمن سلامتكم من الآن فصاعداً

207
00:11:55,480 --> 00:11:58,390
هل هناك علاقة وطيدة أكثر من علاقة شريكين؟

208
00:11:59,110 --> 00:12:02,540
في الواقع، رؤيتكما تجعلني أتساءل

209
00:12:02,540 --> 00:12:05,990
"تتحدّث عن "قُبَل" و "حبّ شخص

210
00:12:06,420 --> 00:12:08,740
ما كلّ هذا؟

211
00:12:09,390 --> 00:12:11,470
حتّى أنا لا أفهمها أيضاً

212
00:12:12,610 --> 00:12:14,090
"تجعل نبضات قلبك تتسارع"

213
00:12:14,090 --> 00:12:17,220
،أستمتع بوجودي مع إتشيغو

214
00:12:17,220 --> 00:12:19,010
لكن هذا يؤلم أحياناً أيضاً

215
00:12:19,710 --> 00:12:22,180
ربّما لستُ مثلكم

216
00:12:26,530 --> 00:12:27,390
إتشيغو؟

217
00:12:28,730 --> 00:12:31,290
ما الأمر؟ وجهكِ أحمر

218
00:12:31,290 --> 00:12:32,820
حـ-حقّاً؟

219
00:12:32,820 --> 00:12:34,480
يمكننا رؤيته الآن

220
00:12:54,500 --> 00:12:56,120
ما هذا المكان؟

221
00:13:04,450 --> 00:13:06,590
أشبه بمدينة صغيرة أو ما شابه

222
00:13:06,590 --> 00:13:08,640
مدينة؟ هذه؟

223
00:13:08,640 --> 00:13:11,640
!إنها مختلفة تماماً عن المدن التي يعيش فيها البالغون

224
00:13:12,010 --> 00:13:14,650
أتعتقدون أنه يعيش أناسٌ هنا؟

225
00:13:14,650 --> 00:13:15,850
من يدري؟

226
00:13:16,180 --> 00:13:20,610
لم أسمع أبداً بشخص يعيش خارج المستعمرات الزراعيّة

227
00:13:28,150 --> 00:13:31,260
هل من أحد هنا؟

228
00:13:38,220 --> 00:13:40,890
هذا ليس ما كنتُ أتوقّعه

229
00:13:40,890 --> 00:13:43,730
وما الذي كنتَ تتوقّعه بالضبط؟

230
00:13:43,730 --> 00:13:44,800
!أعني انظري

231
00:13:44,800 --> 00:13:49,180
!هذا ليس مختلفاً كثيراً عن دار إقامتنا

232
00:13:49,650 --> 00:13:52,810
نعم. كأنّهم استخدموا هذا كنموذج

233
00:13:52,810 --> 00:13:55,560
لبناءِ البيئة التي نعيش فيها

234
00:13:56,000 --> 00:13:57,450
لكن لماذا؟

235
00:13:57,450 --> 00:13:58,300
لا تسأليني

236
00:13:59,390 --> 00:14:02,190
ماذا؟ أين كوكورو؟

237
00:14:24,540 --> 00:14:26,070
رضيع؟

238
00:14:26,070 --> 00:14:27,170
!كوكورو

239
00:14:32,660 --> 00:14:35,060
لا تبتعدي بمفردك رجاء

240
00:14:35,620 --> 00:14:36,980
قلتُ لكِ، صحيح؟

241
00:14:36,980 --> 00:14:39,690
لا أضمن سلامتك

242
00:14:39,690 --> 00:14:42,360
آ-آسفة

243
00:14:53,830 --> 00:14:56,950
......قبلة... فم بفم

244
00:15:02,540 --> 00:15:04,500
لقد فعلتُها مع حبيبي

245
00:15:06,090 --> 00:15:07,460
...زيرو تو

246
00:15:07,460 --> 00:15:10,140
فـ-فعلتِ ماذا؟

247
00:15:10,140 --> 00:15:10,890
قبلة

248
00:15:13,170 --> 00:15:14,930
أظنّكم غير جاهزين لها بعد

249
00:15:16,990 --> 00:15:20,710
لـ-لقد فعلتُها أيضاً

250
00:15:20,710 --> 00:15:22,770
حقّاً؟ مع من؟

251
00:15:22,770 --> 00:15:26,400
القبلة هي شيء تشاركينه
مع شخص مميّز بالنسبة إليكِ

252
00:15:26,970 --> 00:15:29,860
هل الشّخص الذي قبّلتِه مميّز بالنسبة إليكِ؟

253
00:15:29,860 --> 00:15:31,740
...فـ-في الواقع

254
00:15:31,740 --> 00:15:32,910
إتشيغو؟

255
00:15:46,100 --> 00:15:48,510
أنا مُنهكة

256
00:15:48,510 --> 00:15:50,270
مشينا في الأرجاء كثيراً

257
00:15:50,270 --> 00:15:52,790
سأشعر بألم عضلي غداً

258
00:15:53,390 --> 00:15:56,400
إذاً ماذا كان هذا المكان على أي حال؟

259
00:15:56,400 --> 00:16:00,270
على الأقلّ، يمكننا أن نجزم بأنه
كان جزءاً من حضارة

260
00:16:00,270 --> 00:16:03,890
إذاً عاش أناسٌ هنا في الماضي؟

261
00:16:03,890 --> 00:16:05,110
لقد هجروه

262
00:16:08,070 --> 00:16:12,530
،عاش البشر في السّطح في السابق
لكنّهم هجروه من بعد ذلك

263
00:16:13,180 --> 00:16:16,930
يوجد كثير من الأماكن مثل هذا حول العالم

264
00:16:22,910 --> 00:16:25,250
!الطعام جاهز

265
00:16:25,250 --> 00:16:26,700
!انظروا، لحم

266
00:16:26,700 --> 00:16:27,990
هل يمكنني البدء بالأكل الآن؟

267
00:16:26,940 --> 00:16:28,710
أتضوّر جوعاً

268
00:16:27,990 --> 00:16:28,710
يمكنني، صحيح؟

269
00:16:28,710 --> 00:16:30,750
يبدو هذا لذيذاً

270
00:16:29,710 --> 00:16:32,970
متى وصلت هذه الأشياء إلى هنا؟

271
00:16:34,720 --> 00:16:37,210
...ساخن، ساخن، ساخن

272
00:16:35,460 --> 00:16:37,720
يا إلهي، كن حذراً

273
00:16:37,720 --> 00:16:38,820
هل أنت بخير؟

274
00:16:38,820 --> 00:16:40,030
أنا بخير. بخير

275
00:16:40,030 --> 00:16:40,720
خذي

276
00:16:40,720 --> 00:16:42,520
كلي أيضاً

277
00:16:47,780 --> 00:16:50,730
إنّها تُشوى

278
00:16:50,730 --> 00:16:51,820
!دعني أجرّب أيضاً

279
00:16:51,820 --> 00:16:53,030
حبيبي

280
00:16:53,030 --> 00:16:55,380
أنا ذاهبة لمزيد من السباحة، حسناً؟

281
00:16:55,380 --> 00:16:57,200
في هذه الظُلمة؟

282
00:16:57,200 --> 00:16:57,900
أجل

283
00:17:02,160 --> 00:17:05,150
!لا أستطيع أكل المزيد! سينفجر بطني

284
00:17:05,150 --> 00:17:08,420
عجباً يا ميكو، الجميع يروننا. أين آداب سلوكك؟

285
00:17:08,800 --> 00:17:11,800
بعد أن مشيتُ كثيراً اليوم، لم أعد أهتمّ

286
00:17:11,800 --> 00:17:16,850
!انظري إلى نظراتهم الحسودة

287
00:17:18,740 --> 00:17:21,270
!كلّنا مشينا نفس المسافة

288
00:17:21,270 --> 00:17:22,660
!هـ-هلاميّ للغاية

289
00:17:22,660 --> 00:17:24,270
نعم، نعم، واصلا الكلام

290
00:17:25,470 --> 00:17:28,020
لماذا برأيكم هجرت البشريّة السّطح؟

291
00:17:28,020 --> 00:17:30,980
تقصد ما قالَتْه زيرو تو قبل قليل؟

292
00:17:30,980 --> 00:17:35,410
حسناً، لا بدّ وأنّهم كانت لديهم أسبابهم
لعدمِ قدرتهم على العيش هنا

293
00:17:35,410 --> 00:17:38,900
لكن توجد مساحات أكثر ومناظر خلّابة

294
00:17:39,330 --> 00:17:41,880
تفاجأتُ لمعرفتي بوجود عالم كهذا هنا

295
00:17:41,880 --> 00:17:44,570
لكن لدينا هذا في ميستيلتين أيضاً

296
00:17:44,570 --> 00:17:47,780
ناهيكم عن أنّ العالم الخارجي مليء بالكيوريو

297
00:17:48,410 --> 00:17:52,290
،لو لم تبدأ البشريّة باستخراجِ طاقة الحمم

298
00:17:52,290 --> 00:17:54,610
فهل كان الكيوريو سيظهر يا ترى؟

299
00:17:54,610 --> 00:17:56,790
هل تشكّك بالبابا والبقيّة؟

300
00:17:56,790 --> 00:18:01,850
قرّروا الانتقال إلى مستعمرات زراعيّة
لحماية البشريّة من الكيوريو

301
00:18:01,850 --> 00:18:04,140
أليس هذا سبباً مذهلاً؟

302
00:18:09,870 --> 00:18:11,900
!البابا والآخرون رائعون بحقّ

303
00:18:12,250 --> 00:18:15,340
أعني أنّ البالغين كانوا يعيشون في
،أماكن الهواء الطلق الباهتة هذه

304
00:18:15,340 --> 00:18:18,820
لكنّهم يعيشون الآن في مدنٍ برّاقة ساطعة

305
00:18:18,820 --> 00:18:20,160
أجل، معك حقّ

306
00:18:20,160 --> 00:18:22,780
!ونحن من نحمي نمطَ حياتهم

307
00:18:22,780 --> 00:18:25,450
!نحن نافعون لهم

308
00:18:25,450 --> 00:18:29,740
إن استمررنا في قتلِ الكيوريو
،فسنحظى بالطعام

309
00:18:29,740 --> 00:18:31,620
!وسيلتفت البابا إلينا

310
00:18:31,620 --> 00:18:34,640
!ويوماً ما، سنغدو بالغين حتماً أيضاً

311
00:18:34,640 --> 00:18:35,380
!أجل، أجل

312
00:18:37,330 --> 00:18:39,610
أتوافقني الرأي يا هيرو؟

313
00:18:39,610 --> 00:18:41,390
...نـ-نعم

314
00:18:41,390 --> 00:18:43,950
لمَ تبدو غير مُبالٍ هكذا؟

315
00:18:43,950 --> 00:18:45,640
نحن زملاء في الفريق، ألسنا كذلك؟

316
00:18:46,660 --> 00:18:47,730
زملاء في الفريق؟

317
00:18:47,730 --> 00:18:51,100
ماذا؟ هل قلتُ كلاماً غريباً؟

318
00:18:55,070 --> 00:18:57,150
،بغضّ النظر عن زورومي

319
00:18:57,540 --> 00:19:00,010
أنتما العضوان الأحدث

320
00:19:00,010 --> 00:19:02,880
حريّ بكما أن تؤدّيا حصّتكما
وحصّة ناومي من العمل

321
00:19:02,880 --> 00:19:06,910
بالنسبة إلي، أنا مطمئنّةٌ جداً لأنّكما معنا

322
00:19:06,910 --> 00:19:10,000
ففي نهاية المطاف، ساعدتنا زيرو تو كثيراً

323
00:19:10,810 --> 00:19:12,080
كما سمعت

324
00:19:13,700 --> 00:19:14,590
هيرو

325
00:19:15,090 --> 00:19:21,090
اسمح لي بالترحيب بك وبزيرو تو
رسميّاً في الفرقة 13

326
00:19:21,090 --> 00:19:23,970
بصِفتي القائدة، سأجهِدك كثيراً في العمل

327
00:19:23,970 --> 00:19:25,460
لذا من الأفضل أن تكون مستعدّاً

328
00:19:27,060 --> 00:19:29,290
!يا رفاق... شكراً لكم

329
00:19:29,290 --> 00:19:30,370
سأبذل قصارى جهدي

330
00:19:30,370 --> 00:19:31,690
!حسناً

331
00:19:41,400 --> 00:19:43,650
!انظروا! إنه سلطعون

332
00:19:43,650 --> 00:19:44,740
ماذا؟ أين؟

333
00:19:44,740 --> 00:19:45,770
هل هو صالح للأكل؟

334
00:19:45,770 --> 00:19:47,810
هل أنت قادر على أكل المزيد؟

335
00:19:47,810 --> 00:19:49,200
!يوجد واحد هناك أيضاً

336
00:19:49,800 --> 00:19:51,470
!انتظر يا سلطعون

337
00:20:04,960 --> 00:20:07,470
آسف. هل أيقظتكِ؟

338
00:20:10,220 --> 00:20:12,170
لم أستطع النوم لسببٍ ما

339
00:20:12,590 --> 00:20:16,360
مثلي. شعرتُ وكأنني سأهدر وقتي إذا نمت

340
00:20:24,810 --> 00:20:27,620
انظر يا هيرو! يمكنك رؤية الكثير
!من النجوم في السّماء

341
00:20:30,130 --> 00:20:31,450
معكِ حقّ

342
00:20:31,770 --> 00:20:33,260
إنه الجوزاء

343
00:20:34,930 --> 00:20:35,750
،في الماضي

344
00:20:36,240 --> 00:20:39,730
كان يُعدُّ الجوزاء البرج الفلكي
الشتوي الأبرز

345
00:20:39,730 --> 00:20:40,760
حقّاً؟

346
00:20:41,990 --> 00:20:45,820
كنت تحدّثني عن النجوم كثيراً
عندما كنّا صغاراً أيضاً

347
00:20:45,820 --> 00:20:47,060
حقّاً؟

348
00:20:47,060 --> 00:20:47,890
!أجل

349
00:20:48,210 --> 00:20:52,660
قد أكون غبيّة، لكن أتذكّر
!كلّ ما علّمتني إيّاه

350
00:20:56,450 --> 00:20:58,730
إذاً... هل نسيت ذلك النجم أيضاً؟

351
00:21:00,540 --> 00:21:01,730
تقصدين نجم إتشيغو؟

352
00:21:02,690 --> 00:21:05,700
،النجم الخامس عشر من الجوزاء
نفس رقم رمزكِ

353
00:21:05,700 --> 00:21:09,910
قرأتُ في كتاب أنه مظلم جداً لدرجة أنه
من الصعب رؤيته بالعين المجرّدة

354
00:21:09,910 --> 00:21:11,740
أظنّكِ لا تستطيعين رؤيته فعلاً

355
00:21:12,100 --> 00:21:16,050
وعدنا بعضنا الآخر أن نراه معاً يوماً ما
بعد مغادرة غاردين أيضاً

356
00:21:17,410 --> 00:21:19,940
ما-ماذا؟ تتذكّره جيّداً

357
00:21:19,940 --> 00:21:20,820
مؤلم

358
00:21:24,300 --> 00:21:26,760
يمكننا أن نبحث عن النجم مجدّداً يوماً ما

359
00:21:26,760 --> 00:21:30,230
لأنّنا سنستمرّ في القتال في نفس الفريق

360
00:21:30,230 --> 00:21:31,010
أجل

361
00:21:31,630 --> 00:21:35,460
تصرّفتُ بتسلُّط وقلتُ أنّه حريّ
،بك أن تكون مستعدّاً قبلاً

362
00:21:36,190 --> 00:21:39,270
لكن على بقيّتنا أن نفعل ما بوسعنا أيضاً

363
00:21:40,770 --> 00:21:42,230
...فكما تعلم

364
00:21:42,700 --> 00:21:44,620
،سوف أبذل قصارى جهدي كقائدة

365
00:21:45,220 --> 00:21:50,130
.لذا لا تعطِ زيرو تو كلّ اهتمامك
انظر إليّ أيضاً

366
00:21:52,620 --> 00:21:53,450
...أعتبر

367
00:21:55,220 --> 00:21:58,620
أعتبر القبلةَ التي تشاركناها أثناء
!معركة المُحاكاة شيئاً مميّزاً

368
00:21:58,620 --> 00:22:00,380
...لذلك أنا

369
00:22:00,380 --> 00:22:01,880
—أريد أن أبقى معك للأبـ

370
00:22:01,180 --> 00:22:03,170
!انظري يا إتشيغو! شهُب

371
00:22:08,370 --> 00:22:11,510
بذيلها الطّويل، أشعلت الشُّهب
درباً في السّماء

372
00:22:12,270 --> 00:22:19,400
منجذِبة بفعلِ الجاذبيّة، سطعَتْ
تلك النّجوم ببريقٍ مثلنا تماماً

373
00:22:19,850 --> 00:22:23,650
النّور الذي أطلقَتْه بدا بالنسبة إليّ
كأشعّة أمل لطيفة

374
00:22:25,230 --> 00:22:27,900
يُقال أنّه إذا تمنّيت أمنية لدى
رؤية شهاب، فإنّها تتحقّق

375
00:22:28,380 --> 00:22:30,530
ما هي أمنيتك؟

376
00:22:31,810 --> 00:22:33,650
حاولتُ قولها قبل قليل

377
00:22:36,450 --> 00:22:38,700
هيرو الغبيّ

