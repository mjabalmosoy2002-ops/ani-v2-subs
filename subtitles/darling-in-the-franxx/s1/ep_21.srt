1
00:00:01,250 --> 00:00:03,810
هذه إرادةُ فيرم

2
00:00:03,810 --> 00:00:10,410
كيان النجم هو كتلة حياةٍ بمقدورها
زعزعة سلام الكون

3
00:00:10,410 --> 00:00:16,870
وبالتالي، برمجناهُ بحيث إذا تولّت أميرةُ
الكيوريو عمليّةَ الزرع، سوف ينفجر

4
00:00:17,280 --> 00:00:18,240
البابا؟

5
00:00:18,840 --> 00:00:20,870
لقد انقضى الأمر

6
00:00:20,870 --> 00:00:25,250
سوف ينفجر هذا الكوكب دون
أن يبقى له أثر

7
00:00:25,250 --> 00:00:26,800
ما الذي يجري؟

8
00:00:26,800 --> 00:00:28,090
من أنت؟

9
00:00:28,090 --> 00:00:31,960
امتصصنا العديد من الكائنات الحيّة من كلّ
أنحاء الكون

10
00:00:31,960 --> 00:00:35,090
وساعدناهم على التحرُّر من قشور أجسادهم

11
00:00:35,560 --> 00:00:40,770
والوقتُ قد حان لكم أيُّها البشر لتقبلوا بتطوّركم

12
00:00:41,170 --> 00:00:42,530
ما-ماذا؟

13
00:00:44,630 --> 00:00:48,150
،يوجدُ شكلٌ من اللذّة رقيق ودائم

14
00:00:49,590 --> 00:00:51,780
وسوف تخوضون تجربتَه الآن

15
00:00:58,160 --> 00:00:59,410
!تبّاً

16
00:01:01,970 --> 00:01:02,910
!زيرو تو

17
00:01:16,840 --> 00:01:18,290
سأجرب حظي

18
00:01:26,340 --> 00:01:27,490
ما هذا؟

19
00:01:27,910 --> 00:01:29,950
منذ متى كنتِ حيّة بالضبط؟

20
00:01:30,610 --> 00:01:34,240
كنتِ تعيشين بمفردكِ منذ ما قبل
وجود البشر؟

21
00:01:44,930 --> 00:01:45,990
...حبيبي

22
00:01:56,510 --> 00:01:59,590
!القيادة! اسمعوني رجاء، القيادة

23
00:02:00,570 --> 00:02:02,560
!البابا

24
00:02:06,180 --> 00:02:10,090
مـ-مهلاً! من ينبغي أن نُقاتل هنا؟

25
00:02:10,090 --> 00:02:13,540
!الكيوريو بالطبع! لطالما كان الأمر كذلك

26
00:02:13,540 --> 00:02:16,900
لكن قالَت أنّ من أتى من السّماء
هم من الغُزاة

27
00:02:17,770 --> 00:02:20,120
لا يهمّ من يكون العدوّ

28
00:02:20,120 --> 00:02:22,320
كلّ ما يمكنني فعله هو القتال

29
00:02:24,550 --> 00:02:29,830
بما أنّ وظيفة التفجير توقّفت حالما
...اتّصل الرمز 016

30
00:02:30,550 --> 00:02:32,180
إنه رمز خفيّ؟

31
00:02:32,180 --> 00:02:33,590
رمز خفيّ؟

32
00:02:33,590 --> 00:02:35,350
إنّه يستهدف وضعَ الاندفاع

33
00:02:35,830 --> 00:02:40,680
أعدّوه بحيث تسبّب الحمولة الزائدة
للوضع انفجاراً داخليّاً

34
00:02:42,790 --> 00:02:44,470
نالوا منّي

35
00:02:45,130 --> 00:02:46,720
!نالوا منّي عن جدارة

36
00:02:47,030 --> 00:02:50,440
إذا انفجر هذا الشيء، فسيُدمَّر الكوكب معه

37
00:02:50,440 --> 00:02:53,280
والرمز 016 منعَ ذلك؟

38
00:02:53,280 --> 00:02:55,450
كلّ ما فعلَه هو إبطاء ذلك

39
00:02:56,070 --> 00:02:58,570
...في الوضع الرّاهن، سيصل مرحلةَ الحرج بعد

40
00:03:05,930 --> 00:03:09,160
هذا مقدار الوقت الذي أكسبَنا إيّاه حبيبي؟

41
00:03:09,560 --> 00:03:11,050
الرمز 002؟

42
00:03:14,760 --> 00:03:16,750
أليس من الخطير جدّاً البقاء هنا؟

43
00:03:17,140 --> 00:03:19,090
ماذا ينبغي أن نفعل غير ذلك؟

44
00:03:20,900 --> 00:03:24,590
اهدؤوا. ينبغي أن نفترض أنّنا لن نتلقّى
مزيداً من الأوامر من الأعلى

45
00:03:24,590 --> 00:03:26,600
يجب علينا تولّي هذا الأمر بأنفسنا

46
00:03:26,600 --> 00:03:29,750
ألم يكونوا يقولون كلاماً غريباً في
الرّسالة السّابقة؟

47
00:03:29,750 --> 00:03:33,310
أجل، بشأن استخدامِ كيان النجم كقنبلة
أو ما شابه

48
00:03:33,630 --> 00:03:35,830
قالوا أيضاً أنَّ كلّ الكوكب سينفجر

49
00:03:36,980 --> 00:03:39,030
نعم، لم يكن ذلك طبيعيّاً

50
00:03:39,030 --> 00:03:40,890
ماذا يعني ذلك؟

51
00:03:40,890 --> 00:03:43,740
ألم يكن من المُفترَض لذلك الشيء
أن يضع حدّاً للحرب؟

52
00:03:47,010 --> 00:03:48,820
ينبغي أن نذهب ونرى بأنفسنا

53
00:03:48,820 --> 00:03:52,750
إن كانت القنبلة حقيقيّة، لا نملك
الوقت للوقوفِ هنا

54
00:03:53,120 --> 00:03:56,170
أجل. أنا قلقٌ أيضاً على هيرو
وزيرو تو

55
00:03:56,170 --> 00:03:58,630
صحيح... حسناً

56
00:03:59,070 --> 00:04:00,010
...سنعود

57
00:04:00,380 --> 00:04:02,020
!إلى الشقِّ العظيم

58
00:04:08,580 --> 00:04:09,750
لا جدوى

59
00:04:10,470 --> 00:04:12,660
فيرم قد هزموني

60
00:04:13,080 --> 00:04:15,770
لقد خسِرنا

61
00:04:16,150 --> 00:04:19,530
وماذا يعني "فيرم"؟

62
00:04:19,530 --> 00:04:24,280
،من أولئك الناس الذين أتوا من السّماء
الذين قاتلتموهم؟

63
00:04:24,770 --> 00:04:27,030
عندما اتّصلتُ بكِ، شعرتُ بذلك

64
00:04:27,590 --> 00:04:30,310
شعرتُ بمضيّ زمن غير معقول من الزمن

65
00:04:30,310 --> 00:04:31,780
متى بدأ كلّ ذلك؟

66
00:04:40,530 --> 00:04:44,710
نادَتْني بالمزيّفة

67
00:04:45,460 --> 00:04:46,650
ماذا كانت تقصد؟

68
00:04:48,470 --> 00:04:52,550
،إنها الناجية الوحيدة من الكيوريو العاقل

69
00:04:53,130 --> 00:04:55,850
وأنتِ نسختها

70
00:04:58,310 --> 00:05:02,500
مضت أكثر من ستّين مليون سنة الآن

71
00:05:04,320 --> 00:05:11,830
سكَنَّا في هذا الكوكب كحضارة
أكثر تطوّراً بكثير من حضارتِكم

72
00:05:13,240 --> 00:05:16,020
لكن ذات يوم، وصل فيرم

73
00:05:16,530 --> 00:05:19,450
،كان عِبارة عن عقلٍ جماعي بلا أجسام ملموسة

74
00:05:19,450 --> 00:05:23,630
وأرادوا منّا الانضمام إليهم

75
00:05:23,630 --> 00:05:24,770
الانضمام إليهم؟

76
00:05:24,770 --> 00:05:27,170
كانوا يطلبون منّا أن نتخلّى عن أجسامنا

77
00:05:28,260 --> 00:05:33,350
رفضنا، فاندلعَتْ حرب

78
00:05:33,350 --> 00:05:36,150
،أثناء تلك الحرب التي دامَتْ قروناً

79
00:05:36,150 --> 00:05:39,360
أعدنا تشكيل أنفسنا لنُصبح أسلِحة خالدة

80
00:05:39,850 --> 00:05:43,360
وتطوّرنا إلى ما تُطلقون عليه بالكيوريو

81
00:05:43,990 --> 00:05:46,610
،وعندما دحرنا الفيرم أخيراً

82
00:05:46,610 --> 00:05:50,620
كان القِتال والحروب هو كلّ ما بقي من حضارتنا

83
00:05:51,560 --> 00:05:54,520
وحتّى أننا خسرنا قدرتَنا على التّناسل

84
00:05:56,550 --> 00:05:59,690
لكن لم تنتهِ الأمور عند هذا

85
00:06:00,500 --> 00:06:05,220
العدوّ الذي دحرناه لم يكن سوى
مجرّد طليعة فيرم

86
00:06:05,220 --> 00:06:07,270
،من دون شكل خلقيّ

87
00:06:07,270 --> 00:06:11,290
يستمرّون في التوسّع مُضيفين أسلحة الكواكب
التي يلتهمونها إلى ترسانتِهم

88
00:06:11,770 --> 00:06:12,850
...لا

89
00:06:13,190 --> 00:06:16,320
،استعداداً لعودة فيرم الحتميّة

90
00:06:16,320 --> 00:06:18,040
اختبأنا تحت الأرض

91
00:06:18,950 --> 00:06:22,860
،الضعيف حوّل نفسه إلى طاقة

92
00:06:22,860 --> 00:06:29,110
والقويّ اندمجَ ليتطوّر إلى أسلحةٍ أقوى

93
00:06:31,120 --> 00:06:37,780
هكذا بنى الكيوريو العقلاء كيانَ النجم
والذي هو كتلة جماعية من الكيوريو

94
00:06:38,230 --> 00:06:41,110
وحدهم الكيوريو العقلاء من يستطيعون تشغيله

95
00:06:41,860 --> 00:06:46,810
أميرة الكيوريو قد عاشَتْ على الأرجح ملايين
السّنين لتحقيقِ ذلك الهدف

96
00:06:48,150 --> 00:06:53,490
زيرو تو، صُنِعتِ لتشغيل كيان النجم بالنيابة
عن الجنسِ البشريّ

97
00:06:54,150 --> 00:06:57,270
صنعتُكِ من حمضِها النووي الرّيبي

98
00:06:58,780 --> 00:07:00,290
،حتّى لو كان النصرُ مستحيلاً

99
00:07:00,730 --> 00:07:04,210
أردتُ هزيمة أكبر قدر منهم

100
00:07:04,790 --> 00:07:06,280
لكن هذه هي النّهاية

101
00:07:07,140 --> 00:07:08,780
انتهى الأمر

102
00:07:10,680 --> 00:07:12,280
أهي النّهاية حقّاً؟

103
00:07:14,470 --> 00:07:16,370
!ألا يمكنكِ فعل المزيد حقّاً؟

104
00:07:18,280 --> 00:07:19,370
حقّاً

105
00:07:23,030 --> 00:07:26,590
وُلِدَت العديد من النماذج الخاصّة لكن
فشِلت في البقاء

106
00:07:26,590 --> 00:07:30,050
كنتِ التّجربة الناجحة الوحيدة

107
00:07:30,510 --> 00:07:35,700
في نهاية المطاف، بفكرةِ استخدامها إمّا
،كقوّات احتياطيّة أو سُداة

108
00:07:35,700 --> 00:07:38,450
صنعتُ نسخاً بواسطةِ خلاياكِ أيضاً

109
00:07:38,450 --> 00:07:40,730
لكنّها لم ترِث دماءَ الكيوريو

110
00:07:44,580 --> 00:07:46,650
نـ... سخي؟

111
00:07:49,160 --> 00:07:50,780
الناين

112
00:07:59,220 --> 00:08:00,540
...أنتم

113
00:08:03,540 --> 00:08:05,040
لماذا أنتم هنا؟

114
00:08:11,550 --> 00:08:15,930
عودوا إلى مهمّتكم واتبعوا أوامر البابا

115
00:08:15,930 --> 00:08:18,250
—لا جدوى من هذا الآن! القنبلة

116
00:08:18,250 --> 00:08:22,020
هذا ليس قرارك. إنّه قرار البابا

117
00:08:22,340 --> 00:08:25,170
!ولا يمكننا التّواصل معه

118
00:08:25,170 --> 00:08:27,730
!علينا أن نحلّل الوضع ونتّخذ قراراتنا الخاصّة

119
00:08:28,070 --> 00:08:32,860
قراراتنا الخاصّة؟ أتعتقدون أنفسكم
مميّزين أو ما شابه؟

120
00:08:32,860 --> 00:08:35,530
!كلامُ البابا مُطلَق

121
00:08:39,140 --> 00:08:40,370
الوحوش اللّعينة

122
00:08:40,800 --> 00:08:43,460
!اقتلوهم جميعاً

123
00:08:55,540 --> 00:08:57,340
إنّهم معتوهون

124
00:08:58,690 --> 00:09:00,220
!إتشيغو! هذه فرصتنا

125
00:09:00,220 --> 00:09:02,500
!نـ-نعم! لنسرع

126
00:09:05,730 --> 00:09:06,820
!كوكورو

127
00:09:08,330 --> 00:09:09,450
هيّا بنا

128
00:09:09,450 --> 00:09:10,650
حـ-حسناً

129
00:09:12,860 --> 00:09:15,190
ما خطبهم؟

130
00:09:15,190 --> 00:09:16,570
!ديلتا! إلى يسارك

131
00:09:17,210 --> 00:09:17,950
!ماذا؟

132
00:09:20,530 --> 00:09:21,430
!ديلتا

133
00:09:21,430 --> 00:09:22,490
!إبسيلون

134
00:09:24,600 --> 00:09:26,120
!اصمدا

135
00:09:26,120 --> 00:09:27,960
!سنقضي عليهم حالاً

136
00:09:28,820 --> 00:09:31,590
!لا! لا أريد أن أموت

137
00:09:31,590 --> 00:09:33,710
!سـ-ساعدوني

138
00:09:40,690 --> 00:09:42,810
...تبّاً لكم

139
00:09:43,720 --> 00:09:45,750
!تبّاً لكم

140
00:09:53,220 --> 00:09:54,360
حسناً، سأذهب

141
00:09:55,270 --> 00:09:56,110
إلى أين؟

142
00:09:56,760 --> 00:09:58,810
لإعادةِ حبيبي

143
00:09:59,450 --> 00:10:00,620
لا تضغطي على نفسكِ

144
00:10:00,980 --> 00:10:03,430
حبيبي ينتظرني

145
00:10:04,600 --> 00:10:06,010
ما الذي يمكنكِ فعله؟

146
00:10:06,770 --> 00:10:10,730
فيرم فخّخوا كيانَ النجم على الأرجح

147
00:10:11,400 --> 00:10:15,480
حتّى لو استعدته، ستقعين ضحية
لهم في النّهاية

148
00:10:16,020 --> 00:10:17,300
وماذا إن كان كذلك؟

149
00:10:18,420 --> 00:10:20,830
أميرة الكيوريو؟ فيرم؟

150
00:10:20,830 --> 00:10:22,400
لا يهمّني

151
00:10:22,400 --> 00:10:25,750
لا يهمّني إن كنتُ مزيّفة أو وحشاً
أو أيّاً يكن

152
00:10:26,420 --> 00:10:30,070
،حبيبي وأنا وعدنا أن نكون معاً للأبد

153
00:10:30,630 --> 00:10:33,360
وأنّ سيحضر أحدُنا الآخر إذا تفرّقنا

154
00:10:35,250 --> 00:10:41,110
لكن تعلّمنا أنّ الباب إلى نقطة الدّخول
لا يفتح إلّا للرمز 001

155
00:10:41,110 --> 00:10:43,490
سأذهب معها

156
00:10:43,490 --> 00:10:44,520
بروفِسور؟

157
00:11:03,060 --> 00:11:04,260
...أنتم

158
00:11:04,260 --> 00:11:05,930
!زيرو تو

159
00:11:11,650 --> 00:11:16,970
اتّصال 016 قد أخّر مخطّطاتهم
ولو لوقتٍ قصير

160
00:11:17,430 --> 00:11:21,660
إنه حتماً عامِلٌ مجهولٌ بالنسبة إلى فيرم

161
00:11:22,530 --> 00:11:26,360
...أميرة الكيوريو و 016 وأنت

162
00:11:26,360 --> 00:11:29,140
أنتم الثّلاثة معاً قد تُحدِثون مُعجزة

163
00:11:29,730 --> 00:11:31,100
حقّاً؟

164
00:11:31,100 --> 00:11:34,660
إنّها نظرة تفاؤلية جداً لا تستند
إلى أي أساس

165
00:11:35,330 --> 00:11:36,630
يدعوها البعض أملاً أعمى

166
00:11:37,480 --> 00:11:38,920
...مع ذلك

167
00:11:39,350 --> 00:11:41,800
إنّها أفضل بكثير من عدمِ امتلاك أي فرصة

168
00:11:43,910 --> 00:11:46,310
!تبّاً، إنهم لا يعرفون الاستسلام

169
00:11:47,370 --> 00:11:48,470
!أتى آخر

170
00:11:50,680 --> 00:11:52,180
!إنّه مُنهار

171
00:11:52,180 --> 00:11:54,000
!سحقاً! نحن مضطرّون لسلوك طريق بديل

172
00:11:54,000 --> 00:11:55,440
!لن نلحق بالوقت هكذا

173
00:12:01,010 --> 00:12:02,310
تراجعوا جميعاً

174
00:12:02,310 --> 00:12:03,660
ما الذي تفكّرين فيه يا إيكونو؟

175
00:12:04,690 --> 00:12:07,410
!فوتوشي! سنفتح طريقاً

176
00:12:07,410 --> 00:12:08,290
!حسناً

177
00:12:08,290 --> 00:12:11,960
...انتظري يا إيكونو! إن فعلتِ ذلك

178
00:12:19,370 --> 00:12:20,260
هل أنتِ بخير؟

179
00:12:22,710 --> 00:12:23,430
!إيكونو

180
00:12:23,980 --> 00:12:25,180
!شعركِ

181
00:12:25,860 --> 00:12:26,850
!تبّاً

182
00:12:26,850 --> 00:12:28,350
!اذهبي يا إتشيغو

183
00:12:28,720 --> 00:12:30,010
كيف أفعل؟

184
00:12:32,610 --> 00:12:33,850
سأبقى في الخلف

185
00:12:34,180 --> 00:12:35,700
اسبقوني جميعاً

186
00:12:35,700 --> 00:12:37,480
!مُحال

187
00:12:37,480 --> 00:12:40,960
!لن تضحّي بحياتكِ! سنبقى معك

188
00:12:40,960 --> 00:12:41,930
...ميكو

189
00:12:42,370 --> 00:12:43,820
كوكورو

190
00:12:45,170 --> 00:12:48,810
أتّفق معهم. ينبغي أن نقاتل معاً هنا

191
00:12:50,080 --> 00:12:53,580
على أي حال، نحتاج للقوّة العامِلة للتصدّي لهؤلاء

192
00:12:53,910 --> 00:12:57,230
!تماماً! تحرّكي بسرعة

193
00:12:57,230 --> 00:12:58,090
...إتشيغو

194
00:12:59,540 --> 00:13:00,590
عُلِم

195
00:13:00,590 --> 00:13:03,660
أحضري هيرو لأجلنا يا زيرو تو

196
00:13:03,660 --> 00:13:07,590
بعد أن نُنقذ العالم، لنقم مأدبة
!ضخمة معاً

197
00:13:07,590 --> 00:13:11,510
سنعدُّ كثيراً من حلويّاتكِ المفضّلة أيضاً

198
00:13:12,130 --> 00:13:13,350
حسناً

199
00:13:13,880 --> 00:13:15,710
!اعتني بكلوروفيتوم

200
00:13:15,710 --> 00:13:17,600
!وإيّاك والموت

201
00:13:17,600 --> 00:13:18,730
!هيّا بنا

202
00:13:21,090 --> 00:13:23,610
ما باليد حيلة، إنها أوامر القائد

203
00:13:23,970 --> 00:13:26,530
!ميكو! سننجو مهما كلّف الأمر

204
00:13:26,530 --> 00:13:27,960
!بالطبع

205
00:13:29,480 --> 00:13:30,780
!ها هم قادمون

206
00:13:42,130 --> 00:13:43,840
لماذا؟

207
00:13:43,840 --> 00:13:45,930
لماذا ما زلت تُقاوم؟

208
00:13:46,360 --> 00:13:49,780
لم تكن هذه معركتكم

209
00:13:50,440 --> 00:13:52,140
كنتُ مثلكم

210
00:13:53,160 --> 00:13:55,510
كنتُ مثل شعبكم

211
00:13:55,510 --> 00:13:58,870
لم أشكّ لِلَحظة أنّ هدفي في الحياةِ هو القتال

212
00:13:59,370 --> 00:14:01,650
ولم أكن أخشى الموت

213
00:14:02,600 --> 00:14:04,400
لكن أتعرفين ماذا تعلّمت؟

214
00:14:04,400 --> 00:14:06,770
هذه ليست حياة

215
00:14:06,770 --> 00:14:08,660
اللّقاء بزيرو تو ساعدني على الفهم

216
00:14:09,820 --> 00:14:16,520
الوقت الذي قضيناه نبكي ونضحك ونقع
،في حبّ بعضنا ثمينٌ جداً

217
00:14:16,520 --> 00:14:18,630
وأدركتُ أنني أردتُ حمايته

218
00:14:21,620 --> 00:14:24,240
لكن إذا اندفعنا نحو الموت، سنخسر كلّ شيء

219
00:14:24,240 --> 00:14:26,260
سيضيع كلّ شيء

220
00:14:26,260 --> 00:14:29,760
!لن أقبل بذلك! لن أستسلم أبداً

221
00:14:30,450 --> 00:14:33,390
!وعدتُها أن أبقى معها للأبد

222
00:14:35,140 --> 00:14:37,840
لن أعيش لأقاتل بعد الآن

223
00:14:37,840 --> 00:14:40,150
سأقاتل لأعيش

224
00:14:54,530 --> 00:14:56,790
هل هذا هرينغهورني؟

225
00:14:57,380 --> 00:14:59,240
من يُشغّله؟

226
00:15:06,250 --> 00:15:09,400
...بابا، قُل شيئاً

227
00:15:10,020 --> 00:15:11,930
ماذا سنفعل؟

228
00:15:14,140 --> 00:15:15,880
!تبّاً! سيلحق بنا

229
00:15:15,880 --> 00:15:17,430
كم بقي يا زيرو تو؟

230
00:15:18,900 --> 00:15:20,190
!رأيته

231
00:15:28,200 --> 00:15:28,940
!هناك

232
00:15:31,860 --> 00:15:32,950
يتوافدون باستمرار

233
00:15:33,360 --> 00:15:35,940
!هيّا! أحضري هيرو لأجلنا

234
00:15:35,940 --> 00:15:38,080
حريّ بكما أن تعودا معاً

235
00:15:38,080 --> 00:15:41,040
!إن لم يعُد أحدكما، فلن أسامحكما

236
00:15:41,690 --> 00:15:43,040
...أنتما

237
00:15:44,040 --> 00:15:45,380
!لن تمرّ

238
00:15:56,050 --> 00:16:00,140
!اللّعنة

239
00:16:06,650 --> 00:16:08,330
!إتشيغو! غورو

240
00:16:17,660 --> 00:16:21,210
كُل. إنّه ذراع سيّدك

241
00:16:27,630 --> 00:16:28,890
!بروفِسور؟

242
00:16:29,590 --> 00:16:30,630
لماذا؟

243
00:16:31,030 --> 00:16:33,540
تحتوي تلك على خلايا الأميرة

244
00:16:34,310 --> 00:16:37,640
،لم تحوّلني إلى كيوريو كما أردت
لكن سيَفي هذا بالغرض

245
00:16:41,380 --> 00:16:42,690
اذهبي بسرعة

246
00:16:43,170 --> 00:16:44,090
بروفِسور؟

247
00:16:44,580 --> 00:16:47,290
هذا أقلّ ما يمكنني فعله للتكفير

248
00:16:47,290 --> 00:16:50,150
لن أطلب الغفران. اكرهيني لو أردتِ

249
00:16:50,580 --> 00:16:52,730
فأنا أستحقّ ذلك بعد ما فعلتُه بكِ

250
00:17:15,570 --> 00:17:17,050
هل تريدني أن أركبك؟

251
00:17:20,100 --> 00:17:21,140
حسناً

252
00:17:24,040 --> 00:17:24,890
أنت

253
00:17:26,410 --> 00:17:31,570
هل أخذتني إلى المستعمرة 13
لتجمعني مع حبيبي؟

254
00:17:33,130 --> 00:17:34,630
لا أدري

255
00:17:35,110 --> 00:17:38,650
لم أكن أتوقّع أن تعيدا إشعال ما كنتما
تمتلكانه أصلاً

256
00:17:38,650 --> 00:17:42,330
كانت مجرّد نزوة عالِم، رغبة

257
00:17:42,870 --> 00:17:44,360
هذا طبعُك

258
00:17:46,790 --> 00:17:49,080
بروفِسور، ينبغي أن أقول هذا قبل الذهاب

259
00:17:51,090 --> 00:17:55,880
شكراً لك على صناعتي ومساعدتي
في اللّقاءِ مع حبيبي

260
00:17:59,340 --> 00:18:03,130
متى أصبحَتْ بشريّة إلى هذا الحدّ؟

261
00:18:30,170 --> 00:18:31,140
شكراً لك

262
00:18:37,240 --> 00:18:38,370
...ستريليزيا

263
00:18:43,830 --> 00:18:45,970
انتظرني يا حبيبي

264
00:18:55,620 --> 00:18:59,610
!حبيبي

265
00:18:59,610 --> 00:19:02,340
!أنا هنا لأجلك! وفيتُ بوعدي

266
00:19:02,340 --> 00:19:03,530
!حبيبي

267
00:19:04,140 --> 00:19:07,030
!استيقظ! افتح عينيك

268
00:19:07,030 --> 00:19:10,070
!لماذا لا تقول شيئاً؟ تكلّم معي

269
00:19:10,070 --> 00:19:11,940
...أنت، أنت

270
00:19:12,950 --> 00:19:14,920
!أنت! أنت! أنت! أنت

271
00:19:14,920 --> 00:19:16,570
!أتكلّم معك يا حبيبي

272
00:19:24,660 --> 00:19:25,880
...لا

273
00:19:33,560 --> 00:19:36,070
لم ينجح هذا إذاً

274
00:19:37,010 --> 00:19:41,070
لن أقبل بهذا أبداً

275
00:19:47,750 --> 00:19:50,710
لن أستسلم أبداً

276
00:19:53,430 --> 00:19:55,700
انتظرني يا حبيبي

277
00:20:00,840 --> 00:20:05,550
أهذا هو معنى الحياة بالنسبة إليكم؟

278
00:20:05,550 --> 00:20:09,500
اعتقدنا أنّه بالتخلّي عن روابطنا
،والقبول بالعزلة

279
00:20:09,500 --> 00:20:12,760
نصطفي أنفسنا ونصبح أقوى

280
00:20:13,300 --> 00:20:14,560
...لكن

281
00:20:14,900 --> 00:20:20,070
ربّما بعض الأرواح لا تسطع إلّا
بالانسجام مع أرواح أخرى

282
00:20:21,690 --> 00:20:23,030
عظيم

283
00:20:23,450 --> 00:20:27,510
سأمنحكما كلّ ذرّة متبقّية لديّ من قوّتي

284
00:20:27,930 --> 00:20:30,790
وسواء استطعتما السّيطرة على نفسيكما
أم لا هو أمر عائد إليكما

285
00:20:34,200 --> 00:20:40,690
أضع مُستقبلَ هذا الكوكب بين أيديكما

286
00:20:45,650 --> 00:20:46,580
...حبيبي

287
00:20:47,930 --> 00:20:48,850
حبيبي

288
00:20:53,890 --> 00:20:55,110
زيرو تو؟

289
00:21:02,470 --> 00:21:04,820
وفيتُ بوعدي

290
00:21:06,340 --> 00:21:07,560
كنتُ واثقاً من ذلك

291
00:21:08,730 --> 00:21:10,610
ساعدني الجميع

292
00:21:11,330 --> 00:21:12,150
نعم

293
00:21:18,630 --> 00:21:21,960
اشتقتُ إليكِ يا زيرو تو

294
00:21:23,060 --> 00:21:25,250
كذلك أنا يا حبيبي

295
00:21:49,990 --> 00:21:50,990
!ما هذا؟

296
00:21:56,010 --> 00:22:00,310
أيّها البشر، سنغادر مرّة أخرى

297
00:22:00,310 --> 00:22:06,130
قرّروا فيما إن أردتم القِتال أو القبول بدماركم

298
00:22:08,760 --> 00:22:12,200
ستريليزيا يرفض كلّ محاولات التدخّل

299
00:22:12,200 --> 00:22:15,270
تحرّر من برنامجنا؟

300
00:22:17,850 --> 00:22:21,770
الآن، أشعر بقربِك أكثر من أي
وقتٍ سبق

301
00:22:22,210 --> 00:22:25,610
أعرف ما تفكّر فيه خير معرفة

302
00:22:26,580 --> 00:22:29,200
،مهما حدث من الآن فصاعداً

303
00:22:29,200 --> 00:22:32,450
!سيبقى قلبانا واحداً يا حبيبي

304
00:22:55,540 --> 00:22:57,930
!أراها... إنّي أراها

305
00:22:57,930 --> 00:23:01,270
،ما أجملك

306
00:23:01,270 --> 00:23:03,270
،يا صنيعتي

307
00:23:03,810 --> 00:23:07,030
!ستريليزيا أباث

308
00:23:14,200 --> 00:23:16,120
لا نملك خياراً

309
00:23:16,120 --> 00:23:19,300
سنلجأ لرمحِ الحياة المصنوع من الكيوريو

310
00:23:19,300 --> 00:23:23,670
أردنا المزيد، لكن سننسحب حالياً

311
00:23:32,150 --> 00:23:35,180
لكن اعلموا جيداً أننا سنعود

312
00:23:35,180 --> 00:23:39,180
وعندما نفعل، سنحضر جيشَنا الكامل

313
00:23:39,180 --> 00:23:41,190
ونسحق هذا الكوكب على بكرة أبيه

314
00:23:42,170 --> 00:23:43,290
...بابا

315
00:23:51,370 --> 00:23:53,320
نجحنا يا زيرو تو

316
00:23:55,050 --> 00:23:56,830
زيرو تو؟