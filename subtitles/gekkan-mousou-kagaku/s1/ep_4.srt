1
00:00:04,850 --> 00:00:10,240
ربما يمكننا جعل مقالة الشهر القادم
"الرئيسيّة عن "تشريح الكابّا

2
00:00:10,240 --> 00:00:13,240
نشرنا قصّة عن الكابّا قبل فترة قصيرة

3
00:00:13,240 --> 00:00:15,170
ربما عن الأجسام الطائر المجهولة أو النبوءات إذاً

4
00:00:15,170 --> 00:00:18,700
كانت تلك قصصاً من ختام العام الفائت

5
00:00:18,700 --> 00:00:21,660
لمَ لا نجمعها إذاً في مقالة "مُحارب
نبوءة الجسم الطائر المجهول"؟

6
00:00:21,660 --> 00:00:24,590
...بدلاً عن إعادة استعمال القصص القديمة

7
00:00:24,590 --> 00:00:27,970
لمَ لا نقوم بالتحرّي وننشر موضوعاً جديداً؟

8
00:00:27,970 --> 00:00:30,820
جديد؟ مثل ماذا؟

9
00:00:32,160 --> 00:00:37,020
ماذا عن كشف حقيقة شركة
وايت بيغاسوس" الغامضة؟"

10
00:00:37,330 --> 00:00:39,140
وايت بيغاسوس"؟"

11
00:00:39,460 --> 00:00:42,960
...الثنائيّ اللذان كانا يتربّصان بنا دوماً مؤخراً

12
00:00:42,960 --> 00:00:45,990
أعتقد أنّ هناك صلة بينهم وبين
"شركة "وايت بيغاسوس

13
00:00:45,990 --> 00:00:47,170
يمكننا اكتشاف هويّاتهم

14
00:00:47,170 --> 00:00:49,950
وكتابة مقالة ننشرها في المجلّة
!في الآن ذاته

15
00:00:49,950 --> 00:00:53,070
لكن لا يليق ذلك بمجلّة
موسو العلميّة الشهريّة، صحيح؟

16
00:00:54,720 --> 00:00:56,340
مرحباً

17
00:00:57,270 --> 00:00:59,450
ذلك ليس مقبولاً سيّدتي رئيسة التحرير؟

18
00:01:00,060 --> 00:01:03,510
اترك تلك الأشياء لمجلّات الأعمال

19
00:01:03,860 --> 00:01:08,060
نحتاج لمقالة رئيسيّة لإصدار الشهر القادم
تقوم بإرضاء مُعلننا الجديد

20
00:01:08,060 --> 00:01:10,860
!إنّها القطّة المحشوّة التي تجلب السعادة

21
00:01:10,860 --> 00:01:13,180
سننشر هذا الإعلان أيضاً؟

22
00:01:16,230 --> 00:01:17,830
ربما عليك تجربة الأمر

23
00:01:17,830 --> 00:01:19,310
...ربما

24
00:01:28,080 --> 00:01:30,490
"ما تسعى وراءه سيتملّص منك"

25
00:01:30,490 --> 00:01:33,160
،إذا خلدت للنوم واستيقظت باكراً"
"فلن يصيبك المرض أبداً

26
00:01:33,830 --> 00:01:39,140
حاولوا تعزيز مبيعاتنا بما يكفي
بحيث يكون راعينا راضياً

27
00:01:42,520 --> 00:01:47,040
وكيف نفعل ذلك دون سبقٍ ما؟

28
00:01:47,300 --> 00:01:51,090
ماذا لو نشرنا قصّة عن الرجل الوحش الغامض؟

29
00:01:51,430 --> 00:01:53,370
أيّ رجل وحش؟

30
00:01:53,880 --> 00:01:54,800
من أمامي

31
00:01:54,800 --> 00:01:56,160
!هذه فكرة

32
00:01:56,160 --> 00:01:59,390
!ليست فكرة! كيف أنا رجل وحش؟

33
00:01:59,390 --> 00:02:01,810
لأنّك تتحوّل لرجل نمر

34
00:02:01,810 --> 00:02:04,540
!لكنّي لا أتذكّر حصول ذلك

35
00:02:04,900 --> 00:02:08,070
ناهيك عن أنّي أستيقظ
بإنهاك عضليّ منتشر

36
00:02:08,070 --> 00:02:09,440
ولا أتذكّر سببه

37
00:02:09,440 --> 00:02:10,820
!أرفض قطعاً

38
00:02:10,820 --> 00:02:13,160
ماذا نفعل حيال قصّتنا الرئيسيّة إذاً؟

39
00:02:13,160 --> 00:02:16,050
ستفي "نبوءات الكابّا العظيمة" بالغرض

40
00:02:16,050 --> 00:02:18,550
ذلك إن عزّزت مبيعاتنا حقّاً

41
00:02:19,900 --> 00:02:23,290
!علينا التحرّي ونشر قصّة لائقة حقّاً

42
00:02:23,630 --> 00:02:26,110
لكن "وايت بيغاسوس" رُفِضت

43
00:02:26,110 --> 00:02:28,200
!"سنختار الخطّة ب إذاً، "لوخ نس

44
00:02:28,200 --> 00:02:29,380
لوخ نس"؟"

45
00:02:29,750 --> 00:02:32,390
!سنبحث عن نوسّي، وحش لوخ نس

46
00:04:12,240 --> 00:04:14,480
!أنّ نوسّي موجودةٌ حقّاً

47
00:04:14,480 --> 00:04:16,330
ذلك مُستحيل

48
00:04:16,330 --> 00:04:21,010
بحثت في البيانات، ويبدو أنّ البحيرة عميقة جدّاً

49
00:04:21,010 --> 00:04:24,200
بمساحة كافية ليختبئ فيها
ديناصور من العصر القديم

50
00:04:24,200 --> 00:04:26,540
أنت تقرأ مجلّات كهذه يا غورو؟

51
00:04:26,930 --> 00:04:29,820
راودني فضولٌ حيال مقالة خيم الهرم الفضائيّ

52
00:04:29,820 --> 00:04:31,510
التي قِيل أنّها تجمع القوّة الكونيّة

53
00:04:32,660 --> 00:04:35,870
أهذا الجزء الذي يذكر كلام حارس الأرض؟

54
00:04:35,870 --> 00:04:38,520
"أتى الكثير من الأشخاص بأمل رؤية نوسّي"

55
00:04:38,520 --> 00:04:42,390
مما حوّل لوخ نس إلى منطقة شعبيّة"
"للقاء الأزواج الشبّان

56
00:04:42,750 --> 00:04:44,010
!صدقاً؟

57
00:04:44,490 --> 00:04:47,900
هنالك شيء مثير حيال رحلات التخييم، فربما لا عجب

58
00:04:49,060 --> 00:04:50,120
!فلنذهب

59
00:04:54,840 --> 00:04:55,590
!انظر

60
00:04:58,030 --> 00:05:00,640
تارو، فلتستخرج رخصة

61
00:05:00,640 --> 00:05:04,770
لستُ بحاجتها، سأحصل على سائق خاصّ بنهاية المطاف

62
00:05:04,770 --> 00:05:06,030
سنمضي الآن

63
00:05:10,680 --> 00:05:12,660
أتعتقد أنّهم يسعون وراء إحدى الـ "موبارتس"؟

64
00:05:12,660 --> 00:05:14,000
آمل ذلك

65
00:05:14,000 --> 00:05:17,220
لمَ يعرفون كيف يجدونها برأيك؟

66
00:05:17,220 --> 00:05:19,300
أهي قوّة خاصّة بذاك الموتاريان؟

67
00:05:19,300 --> 00:05:24,120
أيّاً يكن، سنكون متواجدين لأخذ
الـ "موبارتس" عندما يعثرون عليها

68
00:05:30,350 --> 00:05:32,980
لنشترِ المؤن في طريقنا

69
00:05:36,100 --> 00:05:39,400
توجد الكثير من المكوّنات التي
!لم يسبق ورأيتها

70
00:05:39,900 --> 00:05:42,490
لعلّها محطّة مجهولة لسبب

71
00:05:42,490 --> 00:05:44,370
!انظرا لهذه

72
00:05:45,750 --> 00:05:47,640
كيف تُؤكل يا ترى؟

73
00:05:47,640 --> 00:05:49,500
هل نقوم بالشوي؟

74
00:05:49,500 --> 00:05:51,820
أأنت جاد؟

75
00:05:51,820 --> 00:05:54,130
ذلك شائع عندما تذهب للتخييم، صحيح؟

76
00:05:54,130 --> 00:05:57,750
تقوم بالشواء وبيدك جعّة عندما
!تشاهد رياضات وحسب

77
00:05:57,750 --> 00:05:59,710
!ليست طريقة مناسبة لإبراز مهاراتك في الطهي

78
00:06:00,900 --> 00:06:02,980
!إذا كنّا سنخيّم، فيجب أن نعدّ الكاري

79
00:06:02,980 --> 00:06:06,340
هل يوفّر الكاري فرصة لإبراز
مهاراتك في الطهو لذاك الحدّ؟

80
00:06:06,340 --> 00:06:07,810
!لا تقلّل من الكاري

81
00:06:08,100 --> 00:06:09,930
...ربما

82
00:06:19,860 --> 00:06:22,500
لديهم جزرٌ غريب حقّاً

83
00:06:22,500 --> 00:06:25,680
!لا بأس بالكاري، لكن لا تنسيا حلوى الخطميّ

84
00:06:27,930 --> 00:06:29,220
سيفي هذا بالغرض، صحيح؟

85
00:06:29,220 --> 00:06:30,040
على الأرجح

86
00:06:41,050 --> 00:06:43,830
لا يوجد شيءٌ في هذه الأرجاء

87
00:06:43,830 --> 00:06:48,490
تكمن جاذبيّة التخييم في ابتعاده
عن صخب المدينة

88
00:06:48,490 --> 00:06:52,720
مع ذلك... لا يوجد أحدٌ هنا حقّاً

89
00:06:56,440 --> 00:06:58,690
!هذا وعرٌ جدّاً

90
00:06:58,690 --> 00:07:01,070
!ويبشّر بالخير

91
00:07:04,400 --> 00:07:08,190
مرحباً بكم في أرض تخييم لوخ نس

92
00:07:09,030 --> 00:07:10,360
...مؤخرتي تؤلمني

93
00:07:10,360 --> 00:07:12,520
...جسدي متصلّب في كلّ مكان

94
00:07:14,870 --> 00:07:18,930
...لا أرى أيّ مخيّمين هنا

95
00:07:18,930 --> 00:07:21,670
حسناً، هذا الوضع المُعتاد

96
00:07:24,920 --> 00:07:26,130
أليس ذلك جميلاً؟

97
00:07:26,930 --> 00:07:30,560
حسناً... عندما تكلّمت عن قدوم
الكثير من الناس لأجل نوسّي

98
00:07:33,770 --> 00:07:35,760
!ما كانت المقالة عنه بالضبط؟

99
00:07:35,760 --> 00:07:40,430
كان ذلك محض تفكير حالم من طرفي

100
00:07:41,060 --> 00:07:42,280
!أي أخبار زائفة؟

101
00:07:42,280 --> 00:07:44,440
ليست زائفة، إنّها حالمة

102
00:07:44,730 --> 00:07:46,200
...المعذرة

103
00:07:46,200 --> 00:07:50,490
هل كانت نوسّي زائفة... أقصد، تفكير حالم أيضاً؟

104
00:07:50,800 --> 00:07:54,290
لا، كان هناك شاهد عيان رآها

105
00:07:54,290 --> 00:07:56,160
حمداً لله

106
00:07:56,160 --> 00:08:01,600
نحن من مجلّة تُدعى مجلّة موسو العلميّة
الشهريّة، وأتينا لكتابة مقالة عن نوسّي

107
00:08:01,600 --> 00:08:03,420
نودّ سماع ما لديك عنها

108
00:08:03,720 --> 00:08:06,820
حسناً، سأجلس معكم فورما أنهي عملي

109
00:08:06,820 --> 00:08:09,260
!سننصب خيمتنا وننتظرك

110
00:08:12,750 --> 00:08:16,440
!هذا فائق علميّاً

111
00:08:17,140 --> 00:08:21,210
!خيمة الهرم الكونيّ التي تجمع القوّة الكونيّة

112
00:08:21,680 --> 00:08:22,890
اشتريتها بالفعل؟

113
00:08:24,360 --> 00:08:25,780
...حسنٌ

114
00:08:26,400 --> 00:08:29,610
اشتريت معدّات تخييم إضافيّة أيضاً

115
00:08:29,610 --> 00:08:31,630
يُفترض أنّ لدينا كلّ ما نحتاجه

116
00:08:31,630 --> 00:08:34,280
...يا للأسى

117
00:08:34,280 --> 00:08:37,400
...كلّ ما وجدته هو شاب بمفرده وعائلتين

118
00:08:37,750 --> 00:08:40,300
مما يعني أنّ لا أمل لي بلقاء أيّ أحد

119
00:08:40,300 --> 00:08:43,290
!تارو-سان، سأترك الكاري لك

120
00:08:43,880 --> 00:08:45,630
فلتقم أنت بطهوه

121
00:08:46,980 --> 00:08:48,430
ما الخطب؟

122
00:08:48,430 --> 00:08:51,260
لا يوجد أحد أبرز مهاراتي في الطهو له

123
00:08:51,260 --> 00:08:53,530
سأرى ما إن كان باستطاعتي صيد نوسّي

124
00:08:58,230 --> 00:09:00,750
كم حجم نوسّي برأيك؟

125
00:09:00,750 --> 00:09:03,820
أعتقد أنّها هائلة الحجم، بصفتها ديناصوراً

126
00:09:04,190 --> 00:09:06,640
!سأذهب للبحث عنها أيضاً

127
00:09:09,930 --> 00:09:11,710
كاري إذاً؟

128
00:09:15,970 --> 00:09:18,010
يبدو أنّهم بدؤوا البحث

129
00:09:18,010 --> 00:09:20,010
!لا بدّ أنّهم يسعون وراء "موبارتس" حقّاً

130
00:09:22,040 --> 00:09:24,080
!آمل أن يجدوها سريعاً

131
00:09:37,200 --> 00:09:38,850
...هذا يصبح مُريباً

132
00:09:39,210 --> 00:09:41,510
كان عليّ ألّا آتي

133
00:09:52,420 --> 00:09:53,750
مرحباً

134
00:09:54,370 --> 00:09:57,240
أأتيت للبحث عن نوسّي؟

135
00:09:57,240 --> 00:09:59,440
!حسناً، أجل

136
00:09:59,440 --> 00:10:01,590
بالمناسبة، أأنتِ بمفردك؟

137
00:10:03,780 --> 00:10:06,070
نوسّي موجودةٌ حقّاً

138
00:10:07,030 --> 00:10:10,290
لكن لا أحد يصدّقني

139
00:10:10,290 --> 00:10:12,570
أنا يمكنني تصديقكِ

140
00:10:12,570 --> 00:10:15,030
!حقّاً؟! ذلك رائع

141
00:10:19,420 --> 00:10:21,490
...نوسّي من لوخ نس

142
00:10:24,100 --> 00:10:26,950
ربما لن أجدها بتلك السهولة

143
00:10:27,330 --> 00:10:28,230
ماذا؟

144
00:10:32,580 --> 00:10:34,930
ماذا يفعل بمفرده؟

145
00:10:37,320 --> 00:10:42,700
ترجع أقدم رؤية لنوسّي
إلى ما قبل ألف عام

146
00:10:43,310 --> 00:10:46,740
واستمرّت بلاغات رؤيتها مُذ حينها

147
00:10:46,740 --> 00:10:48,540
هل رأيتِها بنفسكِ يا ساوكو-تشان؟

148
00:10:48,540 --> 00:10:50,630
أجل، رأيتها

149
00:10:57,180 --> 00:10:59,720
لديكم خيمة باهرة

150
00:10:59,720 --> 00:11:02,560
إن أردت، يمكنك امتصاص
الطاقة الكونيّة داخلها

151
00:11:02,560 --> 00:11:07,730
لا، سأمتنع، غرائب نوسّي تكفيني بحدّ ذاتها

152
00:11:08,040 --> 00:11:11,190
رأيتها بنفسك إذاً؟

153
00:11:11,190 --> 00:11:13,650
لم أرها

154
00:11:13,650 --> 00:11:16,610
بل كانت ياسوكو-تشان من رأتها

155
00:11:17,080 --> 00:11:18,570
ياسوكو-تشان؟

156
00:11:20,660 --> 00:11:22,320
ومن تلك؟

157
00:11:22,320 --> 00:11:24,790
...حدث الأمر قبل 10 أعوام

158
00:11:24,790 --> 00:11:29,540
قالت ياسوكو-تشان أنّها رأت
مخلوقاً عملاقاً في البحيرة

159
00:11:30,180 --> 00:11:32,290
وكانت تلك نوسّي

160
00:11:32,670 --> 00:11:34,790
لكن لم يصدّقها أحد

161
00:11:35,420 --> 00:11:40,850
فأبحرت ياسوكو-تشان بمفردها للإمساك بنوسّي

162
00:11:42,980 --> 00:11:45,140
أنا على يقين من وجود نوسّي

163
00:11:54,850 --> 00:11:59,940
في الصباح التالي، وجدتها على ضفّة البحيرة
بعدما جرفتها المياه

164
00:12:00,260 --> 00:12:01,160
!ياسوكو-تشان

165
00:12:05,470 --> 00:12:07,990
...رأيت... نوسّي

166
00:12:08,570 --> 00:12:10,830
إنّها تعيش في لوخ نس حقّاً

167
00:12:16,950 --> 00:12:18,450
...نوسّي

168
00:12:22,910 --> 00:12:27,430
ماتت جرّاء الإصابات التي لحقت بها بعد ذلك

169
00:12:27,930 --> 00:12:33,010
لكن لم يرَ أو يسمع أحدٌ نوسّي مُذ حينها

170
00:12:34,060 --> 00:12:35,760
سيحترق الكاري

171
00:12:35,760 --> 00:12:36,820
!ويحي

172
00:12:38,080 --> 00:12:44,280
إن استطعتم إيجاد نوسّي، فربما
ستستطيع نوسّي الرقود بسلام

173
00:12:49,040 --> 00:12:49,960
من هنا

174
00:12:49,960 --> 00:12:52,580
من هنا يا تارو-سان

175
00:12:52,580 --> 00:12:55,670
إلى أين نذهب يا ياسوكو-تشان؟

176
00:12:58,260 --> 00:13:00,570
إلى أين يتوجّه تارو؟

177
00:13:08,360 --> 00:13:10,290
وما الذي نبحث عنه هنا؟

178
00:13:10,290 --> 00:13:12,450
انظر في الماء

179
00:13:12,450 --> 00:13:13,770
هنا؟

180
00:13:13,770 --> 00:13:16,280
...أرى أحجاراً فحسب

181
00:13:16,280 --> 00:13:17,610
ليست أحجاراً

182
00:13:23,030 --> 00:13:24,910
ما الذي يفعله؟

183
00:13:25,720 --> 00:13:26,870
!جيرو-سان

184
00:13:27,700 --> 00:13:30,170
ما الذي يفعله تارو-سان هناك؟

185
00:13:31,260 --> 00:13:32,320
لا أعلم

186
00:13:36,210 --> 00:13:39,050
...ماذا؟ يوجد شيءٌ ما

187
00:13:41,130 --> 00:13:42,900
ما هذا؟

188
00:13:45,040 --> 00:13:46,660
ياسوكو-تشان، أهذا هو؟

189
00:13:46,660 --> 00:13:47,830
!أجل

190
00:13:48,960 --> 00:13:50,470
لكن ما هذا؟

191
00:13:50,470 --> 00:13:52,000
إنّه شيءٌ هام

192
00:13:52,530 --> 00:13:54,410
—به، يمكنك

193
00:13:53,440 --> 00:13:54,410
!تارو-سان

194
00:13:54,900 --> 00:13:57,080
أليست تلك "موبارتس"؟

195
00:13:58,110 --> 00:13:59,590
هذا الشيء؟

196
00:13:59,590 --> 00:14:01,490
اسمح لي بإلقاء نظرة

197
00:14:03,070 --> 00:14:06,880
من الغريب ألّا يُصاب تارو بتوعّك
"من "موبارتس

198
00:14:06,880 --> 00:14:10,130
لعلّه قد طُهّر سلفاً؟

199
00:14:10,130 --> 00:14:12,990
ياسوكو-تشان، هل هذا الشيء "موبارتس"؟

200
00:14:14,130 --> 00:14:16,180
مع من تتكلّم يا تارو؟

201
00:14:17,560 --> 00:14:19,700
...ياسوكو-تشان... أيمكن

202
00:14:19,700 --> 00:14:21,260
!أنتم

203
00:14:23,410 --> 00:14:25,890
!"سلمّونا الـ "موبارتس

204
00:14:25,890 --> 00:14:27,730
!إنّهما هما من جديد

205
00:14:27,730 --> 00:14:30,770
!من صالحكم أن تسلّموها بلا مقاومة

206
00:14:31,270 --> 00:14:33,880
!هذا الشيء مهمٌّ لـ ياسوكو-تشان

207
00:14:33,880 --> 00:14:35,940
!لن أسمح لكما بالحصول عليه

208
00:14:36,780 --> 00:14:38,560
...سأريكم في تلك الحالة

209
00:14:39,230 --> 00:14:40,840
!من تواجهونه

210
00:14:41,210 --> 00:14:43,650
!إنّه الـ "موبارتس" من قبل

211
00:14:43,650 --> 00:14:46,160
!قاموا بسرقته حقّاً إذاً

212
00:14:47,430 --> 00:14:48,910
!تحوّل

213
00:15:03,840 --> 00:15:05,710
!يمكنه التحوّل أيضاً؟

214
00:15:07,220 --> 00:15:09,050
!ما الأمر؟ صُدمتم، صحيح؟

215
00:15:09,050 --> 00:15:11,820
!ناهيك عن أنّه عاقل، بخلاف تارو

216
00:15:11,820 --> 00:15:14,350
!لا تجعلني أبدو على خطأ

217
00:15:14,350 --> 00:15:17,350
!"هيّا، سلّموا الـ "موبارتس

218
00:15:17,350 --> 00:15:20,310
!أخبرتكما، هذا يخصّ ياسوكو-تشان

219
00:15:22,450 --> 00:15:25,320
!تحوّل

220
00:15:35,120 --> 00:15:37,710
!اسمع، كيف يُفترض بي التحوّل؟

221
00:15:37,710 --> 00:15:39,000
!أخبرني! أخبرني! أخبرني

222
00:15:39,000 --> 00:15:41,370
!"غورو! نحتاج الـ "موبارتس

223
00:15:41,370 --> 00:15:42,750
!حسناً

224
00:15:43,630 --> 00:15:45,930
!هكذا

225
00:15:48,000 --> 00:15:49,340
هكذا إذاً؟

226
00:16:08,630 --> 00:16:09,490
!تعال

227
00:16:13,190 --> 00:16:15,590
!معركة بين رجلين وحشين

228
00:16:16,600 --> 00:16:18,620
!وجدتها! عليّ التقاط صورة

229
00:16:26,800 --> 00:16:27,950
!نوين

230
00:16:27,950 --> 00:16:29,550
...ذاك الوغد

231
00:16:38,850 --> 00:16:40,350
!نوين

232
00:16:43,220 --> 00:16:44,730
...تبّاً لك

233
00:16:47,240 --> 00:16:48,410
!إنّهما سريعان جدّاً

234
00:16:51,780 --> 00:16:53,250
هذا سيّئ

235
00:16:55,970 --> 00:16:58,870
!ونفد الفيلم الآن! يا إلهي

236
00:16:59,190 --> 00:17:03,040
هذا سيّئ... لم أتصوّر أن يكون ذاك
الموتاريان أقوى من نوين

237
00:17:03,040 --> 00:17:05,110
!هكذا يا تارو-سان

238
00:17:07,060 --> 00:17:07,880
!نوين

239
00:17:08,290 --> 00:17:10,760
!أعرف

240
00:17:13,420 --> 00:17:15,470
!لا تعبث معي

241
00:17:33,780 --> 00:17:34,820
!فاز

242
00:17:35,120 --> 00:17:36,120
!حصلت عليها

243
00:17:39,290 --> 00:17:41,990
!سنهرب من هنا يا نوين

244
00:17:41,990 --> 00:17:43,330
!انتظر

245
00:17:56,550 --> 00:17:58,360
!لا تقترب! ارحل

246
00:17:59,270 --> 00:18:00,520
!اصعد

247
00:18:11,060 --> 00:18:14,520
...سرقوا "موبارتس" أخرى منّا

248
00:18:19,420 --> 00:18:23,700
...أبليتَ حسناً اليوم، مما يجعل الأمر مؤسفاً

249
00:18:36,220 --> 00:18:38,310
هل استيقظت يا تارو-سان؟

250
00:18:36,220 --> 00:18:38,590
!مؤلم

251
00:18:38,590 --> 00:18:40,390
ما الذي آل الأمر إليه؟

252
00:18:40,390 --> 00:18:43,660
"سرقا قطعة الـ "موبارتس

253
00:18:43,660 --> 00:18:46,230
هل خسرتُ إذاً؟

254
00:18:46,540 --> 00:18:50,040
كنتَ تفوز، لكنّهما تمكّنا
من سرقتها منّي

255
00:18:50,040 --> 00:18:51,180
!آسف

256
00:18:51,180 --> 00:18:52,780
ما هذا؟

257
00:18:52,780 --> 00:18:55,610
سقطت مغشيّاً عليك
بعد نفاد طاقتك يا تارو

258
00:18:55,610 --> 00:18:57,750
فلا يمكنك لومه

259
00:18:59,060 --> 00:19:01,110
"!ظهور رجال وحوش غامضين"

260
00:19:01,110 --> 00:19:05,140
لن تكون مقالة يمكننا نشرها...
بهذه الصوّر المشوّشة

261
00:19:05,140 --> 00:19:06,430
هذا أنا؟

262
00:19:06,430 --> 00:19:07,630
أجل

263
00:19:07,630 --> 00:19:09,410
ماذا عن هذا إذاً؟

264
00:19:09,410 --> 00:19:11,300
ماذا؟ ما هذا؟

265
00:19:15,140 --> 00:19:17,320
!أعتقد أنّها نوسّي

266
00:19:17,320 --> 00:19:19,270
!نوسّي لوخ نس

267
00:19:20,140 --> 00:19:22,260
!نوسّي حقيقيّة إذاً

268
00:19:22,260 --> 00:19:24,890
!مرحى! إنّه سبقٌ كبير

269
00:19:24,890 --> 00:19:28,100
!لا بدّ أنّ رئيسة التحرير ستُسرّ كثيراً

270
00:19:25,730 --> 00:19:27,060
جدّياً؟

271
00:19:28,100 --> 00:19:30,320
!وكذلك الراعي

272
00:19:30,320 --> 00:19:33,930
لنستعمل هذه للحصول على نظرة أدقّ

273
00:19:33,930 --> 00:19:37,410
!سأضع حقوق اسمي على الصورة

274
00:19:37,850 --> 00:19:39,590
ما هذا؟

275
00:19:39,590 --> 00:19:40,910
...إنّه

276
00:19:41,940 --> 00:19:43,770
!رمح ياسوكو-تشان

277
00:19:46,630 --> 00:19:48,500
أنا آسف يا ياسوكو-تشان

278
00:19:49,170 --> 00:19:51,580
كان شيئاً مهمّاً لكِ، وقد سُرِق

279
00:19:51,580 --> 00:19:52,880
ليست مشكلة

280
00:19:53,320 --> 00:19:55,650
بما أنّك استطعت إيجاد نوسّي

281
00:19:55,650 --> 00:19:58,250
كانت تلك نوسّي حقّاً إذاً؟

282
00:19:58,250 --> 00:20:02,640
سننشر مقالة رئيسيّة عنها في إصدار الشهر
!القادم من مجلّة موسو العلميّة الشهريّة

283
00:20:02,970 --> 00:20:05,350
شكراً لك يا تارو-سان

284
00:20:09,140 --> 00:20:10,900
!انتظري يا ياسوكو-تشان

285
00:20:11,580 --> 00:20:12,790
...شكراً لك

286
00:20:14,110 --> 00:20:15,690
!انتظري

287
00:20:18,330 --> 00:20:20,660
!الوداع

288
00:20:23,780 --> 00:20:27,460
استطاع رؤية ياسوكو-تشان؟

289
00:20:27,460 --> 00:20:29,670
إنّها حالة لديه

290
00:20:29,670 --> 00:20:33,540
أي أنّ تارو-سان كان يخاطب شبحاً؟

291
00:20:33,540 --> 00:20:36,630
أشكّ باعتقاده أنّها كانت شبحاً

292
00:20:37,980 --> 00:20:39,830
!ياسوكو-تشان

293
00:20:41,350 --> 00:20:44,570
بدت مثابرةً جدّاً أيضاً

294
00:20:49,050 --> 00:20:51,520
"هذه ليست "موبارتس

295
00:20:52,570 --> 00:20:54,010
!ليست كذلك؟

296
00:20:54,010 --> 00:20:56,650
يبدو أنّها عظمة مخلوقٍ ما

297
00:20:56,650 --> 00:20:58,280
عظمة؟

298
00:20:58,280 --> 00:21:01,190
...بعدما بذلناه من جهد

299
00:21:12,540 --> 00:21:14,790
!بيع كامل

300
00:21:14,790 --> 00:21:16,820
...نخب بيع كامل لإصدار

301
00:21:17,890 --> 00:21:22,200
أعتقد أنّ هذه قد تكون المرّة الأولى
لمجلّة موسو العلميّة الشهريّة

302
00:21:22,200 --> 00:21:26,100
علينا طباعة المزيد! أين هي رئيسة التحرير؟

303
00:21:26,400 --> 00:21:30,050
بالتفكير في الأمر، تأتي كاثرين وترحل من نفسها دوماً

304
00:21:30,050 --> 00:21:31,850
لا تستطيعان التواصل معها؟

305
00:21:31,850 --> 00:21:35,160
لا نعرف شيئاً عن حياتها الشخصيّة

306
00:21:41,200 --> 00:21:43,990
لا تزال "موبارتس" واحدة فحسب

307
00:21:44,510 --> 00:21:47,490
...لكن لدينا عدد الموتاريان الأكبر

308
00:21:48,160 --> 00:21:52,730
مما سيضمن لنا الحصول
"على كافّة الـ "موبارتس

309
00:23:25,760 --> 00:23:29,870
إذا كان كونك معجباً حماسيّاً يجعل
حياتك أفضل، فأرى أنّ عليك الاستمرار بذلك

310
00:23:29,870 --> 00:23:32,640
حتّى لو اقتضى ذلك القلق حيال
التقاعد وتغيير المسار المهنيّ وما شابه

311
00:23:32,640 --> 00:23:37,660
:الإصدار الخامس من مجلّة الأوهام الشهريّة
ما الذي تبكي لأجله؟ أمير الجليد

312
00:23:37,660 --> 00:23:39,740
!في الحلقة القادمة، سنعوي بظرافة