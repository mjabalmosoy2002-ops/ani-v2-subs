1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,910
"وأقول "أريد أن أصير أقوى

5
00:01:01,910 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,860 --> 00:03:38,820
كان لوفي يعاني بعد فقدانه
.لأخيه إيس في الحرب ضدّ البحريّة

38
00:03:38,820 --> 00:03:42,070
!ملك القراصنة؟

39
00:03:42,470 --> 00:03:45,490
،وحينها، أتى ملك الظّلام للقاء لوفي

40
00:03:45,490 --> 00:03:47,840
.الّذي كان بالكاد يستطيع الوقوف على قدميه

41
00:03:48,490 --> 00:03:50,700
.إليك اقتراحي الثّاني إذًا

42
00:03:51,200 --> 00:03:55,100
في تلك الأثناء، يكتشف بقيّة طاقم
قبّعة القشّ ما حدث للوفي

43
00:03:55,100 --> 00:03:57,920
.وأدركوا كم أنّ الأمر كان صعبًا عليه

44
00:04:01,960 --> 00:04:06,530
!لقاء! السّيّاف العظيم ميهوك"
"!صراع زورو المميت العنيد

45
00:04:34,170 --> 00:04:37,400
،هذه جزيرة كورايغانا في الغراند لاين

46
00:04:37,400 --> 00:04:39,800
.أطلال مملكة شيكّيارو

47
00:04:40,350 --> 00:04:42,840
حيث توجد بقايا قلعة قديمة من
...المملكة الّتي هلكت منذ مدّة

48
00:04:43,520 --> 00:04:48,800
.والّتي صارت مأهولة منذ بضع سنوات الآن

49
00:04:48,800 --> 00:04:52,850
!لا أصدّق أنّ موريا-ساما مات في الحرب

50
00:05:02,530 --> 00:05:05,820
.إنّك تزعجين أذنيّ. اذهبي لمكان آخر للبكاء

51
00:05:06,290 --> 00:05:10,110
يا لقسوتك وأنت تقول ذلك وهناك
.من هو محطّم بالكامل أمامك

52
00:05:10,110 --> 00:05:14,710
!قل شيئًا لطيفًا وأحضر لي كوب شكولاطة ساخنة

53
00:05:14,710 --> 00:05:17,030
!أنا ضيفتك

54
00:05:17,030 --> 00:05:18,880
.لم أدعوك أبدًا

55
00:05:18,880 --> 00:05:22,050
.لقد كنتما تعيشان هنا بكون بدون في غيابي

56
00:05:22,450 --> 00:05:23,380
...وأيضًا

57
00:05:24,530 --> 00:05:26,550
.هذا المقال ليس موثوقًا

58
00:05:27,000 --> 00:05:31,470
!ماذا؟! إذًا فلا تظنّ أنّ موريا-ساما قد مات في الحرب؟

59
00:05:31,960 --> 00:05:37,600
،لا أدري إن كان ميتًا أم حيًّا
...لكنّ ما أذكره على الأقلّ

60
00:05:37,600 --> 00:05:41,820
.هو أنّ موريا كان حيًّا في ساحة المعركة

61
00:05:42,480 --> 00:05:46,490
إن لم يكن ميتًا، فلماذا قالوا أنّه مات؟

62
00:05:46,490 --> 00:05:47,610
.لا أدري

63
00:05:51,160 --> 00:05:54,120
!كـ-كيف استيقظت؟

64
00:05:54,120 --> 00:05:57,290
!الزم فراشك، أنت معدوم الفائدة

65
00:05:57,290 --> 00:06:00,060
!ما الّذي تنوي فعله بتلك السّيوف؟

66
00:06:02,000 --> 00:06:04,920
هل ستضغط على نفسك ثانية؟

67
00:06:04,920 --> 00:06:09,120
.لا يمكنك هزيمة قرود الرّبّاح تلك
...سوف تقتلك هذه المرّة

68
00:06:09,120 --> 00:06:10,470
!اخرسي

69
00:06:10,470 --> 00:06:13,060
!هذا ليس من شأنك

70
00:06:13,060 --> 00:06:14,880
!كيف أمكنك قول ذلك لي؟

71
00:06:14,880 --> 00:06:18,560
ألا يمكنك النّظر أنّني حملتك طوال
!الطّريق إلى هنا؟

72
00:06:19,810 --> 00:06:21,520
!"يا "عين الصّقر

73
00:06:25,440 --> 00:06:28,150
!أرأيت؟! لا يمكنك حتّى المشي

74
00:06:28,950 --> 00:06:32,700
لماذا أنت مستعجل لهذه الدّرجة؟
.أنت مصاب

75
00:06:33,950 --> 00:06:38,680
.لأنّك أخبرتني ما حدث للوفي

76
00:06:38,680 --> 00:06:40,040
!كيف لي ألاّ أحرّك ساكنًا؟

77
00:06:41,170 --> 00:06:42,780
.على الأرجح أنّه ما زال حيًّا

78
00:06:42,780 --> 00:06:46,420
.لكنّني أفترض أنّه كان مصدومًا بشدّة

79
00:06:47,050 --> 00:06:48,610
...إنّ "قبضة النّار" إيس

80
00:06:49,840 --> 00:06:52,090
.مات أمام عينيْ قبّعة القشّ

81
00:06:52,470 --> 00:06:57,640
!لم أكن أعلم حتّى أن حربًا ضخمة كهذه قد حدثت

82
00:06:57,640 --> 00:07:02,230
!هل أنت واثق أنّ لوفي بخير؟
!أين هو الآن؟

83
00:07:02,230 --> 00:07:04,380
!أخبرني المزيد

84
00:07:05,360 --> 00:07:08,190
.أخبرتك بكلّ ما أعرف

85
00:07:11,360 --> 00:07:13,700
.آسف على إزعاجك إذًا

86
00:07:14,830 --> 00:07:15,870
!انتظر

87
00:07:15,870 --> 00:07:20,330
حتّى إن استطعت الوصول إلى الشّاطئ
،دون لقاء قرود الرّبّاح تلك

88
00:07:20,330 --> 00:07:23,200
فكيف ستعبر البحر؟

89
00:07:25,700 --> 00:07:27,500
،إن كنت تريد قاربًا صغيرًا

90
00:07:27,500 --> 00:07:30,050
.فهناك واحد في الجانب الغربيّ لهذه القلعة

91
00:07:31,800 --> 00:07:33,640
.شكرًا على كلّ شيء

92
00:07:37,180 --> 00:07:38,930
!ماذا؟

93
00:07:38,930 --> 00:07:42,850
!أيّها الغبيّ! لن أهتمّ بك بعد الآن

94
00:07:42,850 --> 00:07:46,260
!لن أنقذك أبدًا

95
00:07:52,780 --> 00:07:56,950
،رغم أنّك فقدت أخاك للتّوّ يا لوفي

96
00:07:56,950 --> 00:08:00,160
!أعلم أنّك ستفي بوعدك

97
00:08:00,580 --> 00:08:04,330
لذلك السّبب سأكون هناك
!...أيضًا مهما كلّف الأمر

98
00:08:14,680 --> 00:08:16,750
!ها أنت ذي

99
00:08:16,750 --> 00:08:19,310
.كنت أعلم أنّك لن تتركيني وشأني بسهولة

100
00:08:30,610 --> 00:08:33,400
!هجوم "الغول الثّور: المخالب الجريئة"؟

101
00:08:38,910 --> 00:08:40,830
."كان ذلك هجوم "إعصار التّنّين

102
00:08:40,830 --> 00:08:44,000
!إنّها تقلّد مهاراتي في أسلوب السّيوف الثّلاثة

103
00:08:54,050 --> 00:08:55,800
!أيّتها القرود الغبيّة

104
00:08:59,050 --> 00:09:02,930
كيف لك أن تكوني مسرورة للغاية
!بتقليدك لمهارات شخص آخر؟

105
00:09:03,890 --> 00:09:07,650
!لا تعبثي معي

106
00:09:08,550 --> 00:09:12,400
!سُحقًا! لا يمكنه العبث معي

107
00:09:12,400 --> 00:09:15,570
!قمتُ بالكثير من أجله

108
00:09:15,570 --> 00:09:20,030
!آمل أن يموت ويريحنا! إنّه يستحقّ ذلك

109
00:09:21,200 --> 00:09:24,710
لماذا لا تذهبين للبحث عن رورونوا
بما أنّك قلقة عليه لهذه الدّرجة؟

110
00:09:24,710 --> 00:09:28,710
!أتمزح معي؟! لماذا قد أقلق على ذلك المغفّل؟

111
00:09:28,710 --> 00:09:32,460
.حسنًا، لا أظنّ أنّه سيموت بتلك السّهولة

112
00:09:32,880 --> 00:09:40,180
اسمع، كان مصابًا بشدّة سلفًا
!حينما أرسله كوما إلى هنا

113
00:09:40,180 --> 00:09:44,730
لذلك قد يفقد حياته إن قاتل
.قرود الرّبّاح تلك ثانية

114
00:09:44,730 --> 00:09:48,270
!سُحقًا! سُحقًا! سُحقًا لك

115
00:09:48,270 --> 00:09:50,740
إن مات، فسأعلق مع هذا الرّجل

116
00:09:50,740 --> 00:09:55,280
الّذي لا يبدي أيّ اهتمام للحيوانات المحشوّة الظّريفة

117
00:09:55,280 --> 00:09:59,240
والّذي يرفض إحضار شطيرة
!وشكولاطة ساخنة لي

118
00:09:59,240 --> 00:10:04,340
لا أريد أن أظلّ عالقة هنا مع قاسي
!القلب "عين الصّقر" ذاك

119
00:10:04,780 --> 00:10:07,580
!لا أتحمّل ذلك

120
00:10:15,650 --> 00:10:18,100
!العوالم الثّلاثة آلاف

121
00:10:27,890 --> 00:10:28,730
...ما الّذي

122
00:10:29,060 --> 00:10:32,400
...النّدوب في الظّهر هي عار السّيّاف

123
00:10:33,190 --> 00:10:34,190
!مثير للإعجاب

124
00:10:49,160 --> 00:10:52,420
هل ما زلت على قيد الحياة؟

125
00:10:53,120 --> 00:10:57,920
،لا بدّ أنّه وصل للشّاطئ الآن
...لكنّني لا أرى أيّ أثر له

126
00:10:57,920 --> 00:11:01,010
!ربّما ضاع ثانية

127
00:11:04,720 --> 00:11:05,850
...قاطع

128
00:11:06,970 --> 00:11:08,230
!الغيلان

129
00:11:16,940 --> 00:11:21,030
!كفّ عن وضع بصاق عليه
!أين تعلّمت هذا العلاج الشّعبيّ؟

130
00:11:25,450 --> 00:11:29,040
!قرود لعينة، إنّها تسخر منّي بالفعل

131
00:11:29,710 --> 00:11:32,790
!لن أصل للبحر أبدًا على هذه الوتيرة

132
00:11:42,010 --> 00:11:43,380
..."عين الصّقر"

133
00:11:44,390 --> 00:11:46,700
مرّ وقت طويل مذ غادرتَ القلعة

134
00:11:46,700 --> 00:11:49,270
وابتعدت لهذه المسافة فحسب يا رورونوا؟

135
00:11:49,680 --> 00:11:54,770
.يبدو أنّ القارب الّذي أعطيتك إيّاه صار بلا فائدة الآن

136
00:11:54,770 --> 00:11:56,310
!اخرس

137
00:11:56,310 --> 00:12:00,860
.سأستعمل الألواح وأسبح مستندًا عليها فحسب

138
00:12:01,650 --> 00:12:05,570
من الجيّد أنّ تهتمّ لأمر صديقك
.لهذه الدّرجة، لكنّها قويّة

139
00:12:06,410 --> 00:12:11,410
إنّها تُدعى هيوماندريل، وهي قردة ربّاح
.تتطوّر عن طريق تقليد البشر

140
00:12:11,410 --> 00:12:13,210
هيوماندريل؟

141
00:12:13,680 --> 00:12:18,210
لكانت قردة مُحِبّة لو أنّها كبرت
.قرب بشر مسالمين

142
00:12:18,210 --> 00:12:20,260
...لكن على هذه الجزيرة

143
00:12:21,210 --> 00:12:25,300
.كانت هنالك حرب حتّى سبع سنوات مضت

144
00:12:26,300 --> 00:12:31,680
عندما أتيت للعيش هنا، كانت رائحة
الدّماء والدّخان ما زالت تعمّ المكان

145
00:12:31,680 --> 00:12:34,480
.وكانت الجثث متناثرة على الأرض

146
00:12:35,600 --> 00:12:40,730
وقد كبرت قردة الرّبّاح هذه وهي
تشاهد أولئك البشر العنيفين

147
00:12:40,730 --> 00:12:45,450
وتعلّمت كيف تستعمل الأسلحة
.وصارت محاربة الغابة

148
00:12:46,570 --> 00:12:50,120
بإمكان البشر التّفوّق على الحيوانات
.باستعمال الأسلحة والحكمة

149
00:12:50,120 --> 00:12:54,000
.لكن عندما تستعمل الحيوانات الأسلحة، تصير أقوى

150
00:12:54,000 --> 00:12:57,880
.إنّها تشكّل خصومًا ممتازة لشابّ يافع متغطرس

151
00:12:57,880 --> 00:12:59,130
أتقصدني بكلامك؟

152
00:12:59,600 --> 00:13:01,770
.لا يوجد سواك هنا

153
00:13:01,770 --> 00:13:04,320
.أوشكت الشّمس أن تغرب. عد لقلعتي

154
00:13:04,320 --> 00:13:06,550
.لن تزعجك هناك

155
00:13:07,680 --> 00:13:11,100
!لا تمل عليّ الأوامر

156
00:13:11,100 --> 00:13:13,230
!عليّ أن أبحر

157
00:13:14,140 --> 00:13:17,600
.فهمت. افعل ما يحلو لك

158
00:13:20,230 --> 00:13:23,360
،لا أهتمّ إن كانت محاربة الغابة أو ما شابه

159
00:13:23,360 --> 00:13:26,820
!لا وقت لديّ لأضيّعه

160
00:13:28,070 --> 00:13:30,410
!سأهزم كلّ واحد منها

161
00:13:30,410 --> 00:13:34,080
سُحقًا! إلى أين ذهب؟

162
00:13:35,660 --> 00:13:38,170
!ذلك ما ظننت! ما زالت هنا

163
00:13:41,170 --> 00:13:42,590
!مـ-مهلاً

164
00:14:03,360 --> 00:14:07,360
في هاراهيتّانيا في جزيرة ناكامورا
...في الغراند لاين

165
00:14:09,570 --> 00:14:11,990
ما الّذي يفعله ساتان-ساما؟

166
00:14:12,520 --> 00:14:15,830
ما الّذي حلّ بالطّقس الّذي سيلعن
قبيلة طويلي الأذرع حتّى الموت؟

167
00:14:15,830 --> 00:14:17,080
.المكان هادئ للغاية

168
00:14:17,080 --> 00:14:19,790
.ضعوا ثقتكم به

169
00:14:19,790 --> 00:14:24,290
أنا واثق أنّ ساتان-ساما سيوجّه

170
00:14:24,290 --> 00:14:27,130
!ضربة قاضية لقبيلة الأذرع الطّويلة اللّعينة

171
00:14:29,380 --> 00:14:32,470
!أيّها الحضور، شكرًا على الانتظار

172
00:14:32,470 --> 00:14:34,470
هل انتهى الطّقس أخيرًا؟

173
00:14:34,470 --> 00:14:36,310
!هذا هو ساتان-ساما

174
00:14:36,310 --> 00:14:39,540
...لقد انتهيت. ما دمتم تملكون هذه

175
00:14:40,600 --> 00:14:42,000
ما هذه؟

176
00:14:42,000 --> 00:14:43,480
!فستكونون بخير

177
00:14:43,910 --> 00:14:46,530
مهلاً... ما هذه؟

178
00:14:46,530 --> 00:14:48,150
...هذا

179
00:14:48,150 --> 00:14:49,650
!أعلم

180
00:14:49,650 --> 00:14:50,700
ماذا؟

181
00:14:51,820 --> 00:14:54,210
!أصغوا إليّ جميعًا

182
00:14:54,210 --> 00:14:57,880
صنع ساتان-ساما تميمة لنا

183
00:14:57,880 --> 00:15:00,790
!ستسمح لنا بلعن قبيلة طويلي الأذرع حتّى الموت

184
00:15:00,790 --> 00:15:02,080
ماذا؟

185
00:15:02,520 --> 00:15:04,530
،بهذه التّميمة

186
00:15:04,530 --> 00:15:08,880
حتّى قبيلة طويلي الأذرع الضّارية
!لن تستطيع الاقتراب منّا

187
00:15:08,880 --> 00:15:12,010
!سيموتون بمجرّد رؤيتنا

188
00:15:12,010 --> 00:15:13,390
...عفوًا، ذلك

189
00:15:13,390 --> 00:15:14,350
!فهمت

190
00:15:14,350 --> 00:15:15,430
!هذا هو ساتان-ساما

191
00:15:15,880 --> 00:15:21,320
!حسنًا جميعًا، لنضع هذه التّمائم في أماكن مختلفة

192
00:15:21,320 --> 00:15:25,070
...كلاّ، لحظة... إنّها لا تُستعمل هكذا

193
00:15:30,030 --> 00:15:33,320
!عـ-عـ-عفوًا! انتظروا جميعًا

194
00:15:35,200 --> 00:15:37,200
!لقد وضعناها جميعها

195
00:15:37,200 --> 00:15:39,200
!نعم، أحسنتم عملاً

196
00:15:39,790 --> 00:15:41,620
!صرنا آمنين الآن

197
00:15:41,620 --> 00:15:43,710
!شكرًا جزيلاً يا ساتان-ساما

198
00:15:44,290 --> 00:15:45,210
...عفوًا

199
00:15:45,210 --> 00:15:46,630
!أيّها الزّعيم، لدينا مشكلة

200
00:15:47,510 --> 00:15:49,550
!قـ-قبيلة طويلي الأذرع هنا

201
00:15:50,180 --> 00:15:53,550
.إنّهم أشبه بالعثّ المنجذب للنّار

202
00:15:53,550 --> 00:15:57,560
!ستختفي قبيلة طويلي الأذرع اليوم

203
00:15:59,180 --> 00:16:03,560
.كما كنتُ أقول، عفوًا... إنّها ليس تمائم

204
00:16:03,560 --> 00:16:06,480
!إنّها مقطوعة موسيقيّة ألّفتها بنفسي

205
00:16:06,980 --> 00:16:08,270
ماذا؟

206
00:16:08,270 --> 00:16:10,150
!ماذا؟

207
00:16:16,270 --> 00:16:17,790
!نحن هالكون

208
00:16:18,740 --> 00:16:22,660
سيأخذون الطّعام القليل الّذي بقي لدينا

209
00:16:23,190 --> 00:16:26,580
إضافة للرّجال والنّساء وسيقومون
...بكلّ ما يشاؤون به

210
00:16:26,580 --> 00:16:28,240
.لا خيار أمامنا

211
00:16:29,090 --> 00:16:31,260
!بل لديكم خيار

212
00:16:31,620 --> 00:16:33,070
!ساتان-ساما

213
00:16:35,180 --> 00:16:38,330
.استمعوا لهذه الأغنية جميعًا

214
00:16:46,600 --> 00:16:48,360
ما هذه الأغنية؟

215
00:16:48,890 --> 00:16:52,730
!إنّه يملأ جسدي بالحيويّة

216
00:16:55,680 --> 00:16:58,520
ما هذه الأشياء؟ تعويذة من نوع ما؟

217
00:16:58,520 --> 00:17:04,420
يصعب معرفة ما يفكّر به هؤلاء الأشخاص
.أصحاب المفصل الواحد في أذرعهم

218
00:17:08,500 --> 00:17:10,800
ماذا؟ من أنتم؟

219
00:17:13,280 --> 00:17:18,430
!بدءًا من اليوم، لن نسمح لكم باستضعافنا

220
00:17:18,430 --> 00:17:19,350
ماذا؟

221
00:17:19,350 --> 00:17:22,020
!لقد قرّرنا أن نقاتل

222
00:17:22,020 --> 00:17:24,480
!صحيح! لن تأخذوا أيّ شيء منّا بعد الآن

223
00:17:24,480 --> 00:17:27,480
!سنحمي ما لنا بأيدينا نحن

224
00:17:27,480 --> 00:17:30,020
!نحن لا نخشى أيّ شيء

225
00:17:30,940 --> 00:17:32,320
!هذا هو المطلوب

226
00:17:32,320 --> 00:17:36,400
.يبدون مختلفين عن العادة

227
00:17:37,200 --> 00:17:41,620
...لا أدري ما الّذي حلّ بكم
!لكن لنوسعهم ضربًا

228
00:17:41,620 --> 00:17:43,120
!نالوا منهم

229
00:17:48,040 --> 00:17:51,670
!شكرًا جزيلاً لك يا ملك الشّياطين ساتان-ساما

230
00:17:53,440 --> 00:18:00,050
لم أحلم أبدًا أن نتمكّن من وضعهم
!في أقفاص ذات يوم

231
00:18:00,050 --> 00:18:05,140
لا أدري ما السّبب، لكن عندما
...سمعت المقطوعة الّتي ألّفتَها

232
00:18:05,140 --> 00:18:07,940
،ملأت الشّجاعة والقوّة قلبي

233
00:18:07,940 --> 00:18:11,440
!وحملتُ الأسلحة وقاتلت لأوّل مرّة في حياتي

234
00:18:12,560 --> 00:18:15,240
...وبطبيعة الحال

235
00:18:15,240 --> 00:18:18,560
.انتهى الأمر بفشلنا وقمت أنت بهزيمتهم أخيرًا

236
00:18:18,560 --> 00:18:23,450
!لكنّ من اختُطفوا عادوا بسلام بفضلك

237
00:18:24,910 --> 00:18:28,290
.إطلاقًا، ساعدتُ قليلاً فحسب

238
00:18:29,050 --> 00:18:33,380
لن تساعد الآلهة أو الشّياطين أيّ أحد
.يأبى أن يقاتل بنفسه

239
00:18:33,380 --> 00:18:37,420
،بما أنّنا نعيش في أوقات كهذه
...أردت أن أحرص

240
00:18:37,420 --> 00:18:41,180
أنّ بإمكانكم الوقوف بأنفسكم
!في وجه الشّرّ بدوني

241
00:18:41,180 --> 00:18:46,680
!يا لرحمته! أظنّ أنّ بإمكاننا التّغيّر من الآن فصاعدًا

242
00:18:46,680 --> 00:18:49,640
!شكرًا جزيلاً لك يا ساتان-ساما

243
00:18:50,570 --> 00:18:53,270
.أعتقد أنّني أدّيت واجبي ناحيتهم

244
00:18:53,860 --> 00:18:57,860
.والآن... لا أصدّق تلك الأخبار

245
00:18:57,860 --> 00:19:03,280
.لوفي-سان، آمل أنّك بخير
!إنّها أخبار تحطّم القلب

246
00:19:03,720 --> 00:19:05,910
...رغم أنّ لا قلب لي

247
00:19:05,910 --> 00:19:09,210
!لوفي-سان، لنغنّ أغنية معًا

248
00:19:09,210 --> 00:19:12,250
!سأذهب إلى هناك لإنقاذ قلبك الآن

249
00:19:12,250 --> 00:19:16,050
!سُحقًا! لا أصدّق أنّ لهم شيطانًا كحارس شخصيّ

250
00:19:16,050 --> 00:19:21,380
لو استطعنا إحضار هؤلاء البشر
،ذوي المفصل الواحد في أذرعهم لموطننا

251
00:19:21,380 --> 00:19:25,100
لاستطعنا جني ثروة عن طريق
.عرضهم على متفرّجين

252
00:19:25,100 --> 00:19:26,680
...حسنًا

253
00:19:26,680 --> 00:19:30,190
يملك سكّان قبيلة طويلي الأذرع
.مفصلين في أذرعهم

254
00:19:30,190 --> 00:19:33,770
!بإمكاننا جني ثروة بعرضهم على متفرّجين

255
00:19:33,770 --> 00:19:35,610
!مـ-مهلاً لحظة

256
00:19:36,020 --> 00:19:40,820
لا يمكنكم ذلك! ستكونون بذلك تعاملونهم
!بنفس طريقة معاملتهم لكم

257
00:19:40,820 --> 00:19:42,070
ماذا؟

258
00:19:42,070 --> 00:19:44,280
!استمعوا جميعًا

259
00:19:45,330 --> 00:19:50,160
!ماذا؟! ندعهم يذهبون؟
!سيهاجموننا ثانية هكذا

260
00:19:50,160 --> 00:19:51,750
.لا تقلق

261
00:19:51,750 --> 00:19:54,880
.وقّعت عقد شيطان معهم

262
00:19:56,540 --> 00:19:59,090
.اسمعوا أنتم الثّلاثة

263
00:19:59,090 --> 00:20:01,440
إن خلفتم بوعدك معي

264
00:20:01,440 --> 00:20:04,970
،واقترفتم عملاً خاطئًا في حقّ هذه البلاد ثانية

265
00:20:04,970 --> 00:20:09,220
!فسآكل قلوبكم

266
00:20:11,980 --> 00:20:15,150
!شكرًا لسماحك لنا بالذّهاب

267
00:20:15,150 --> 00:20:17,070
!سنعود لموطننا في الحال

268
00:20:17,070 --> 00:20:20,780
!لن نأتي لهذه البلاد ثانية

269
00:20:20,780 --> 00:20:26,820
اسمعوا جميعًا. إنّ الدّمار والسّرقة
.لا يولّدان سوى الكراهية

270
00:20:26,820 --> 00:20:32,370
،إن قام أحد ما بالمثل لبلادكم
.أنا واثق أنّكم ستشعرون بالسّوء

271
00:20:32,370 --> 00:20:36,750
لا يهمّ إن كان لديكم مفصل واحد
.أو مفصلين في أذرعكم

272
00:20:36,750 --> 00:20:41,090
!جميعنا بشر! لذلك دعونا نعامل بعضنا بطيبة

273
00:20:41,090 --> 00:20:43,470
!أيّها الشّيطان-ساما

274
00:20:45,970 --> 00:20:47,800
!حسنًا

275
00:20:47,800 --> 00:20:49,550
!ماذا؟

276
00:20:49,550 --> 00:20:52,140
!ماذا؟! ما الّذي يحدث هنا؟

277
00:20:52,140 --> 00:20:53,980
!هيّا بنا

278
00:20:53,980 --> 00:20:56,770
!إنّنا لا نؤمن بالشّياطين

279
00:20:56,770 --> 00:21:00,650
!أنت قويّ، لكن لست قويًّا كثيرًا وأنت مربوط

280
00:21:00,650 --> 00:21:03,990
...إن عدنا ومعنا هيكل عظميّ متكلّم

281
00:21:03,990 --> 00:21:06,030
!فسنتمكّن من جني ثورة

282
00:21:06,030 --> 00:21:10,370
!تمهّلوا لحظة! عليّ الذّهاب لمكان ما

283
00:21:10,370 --> 00:21:11,830
!ساتان-ساما

284
00:21:12,450 --> 00:21:16,330
!مصيبة! اختُطف ساتان-ساما

285
00:21:16,330 --> 00:21:20,630
!أيّها النّاس، استعدّوا لاستدعاء شيطان آخر

286
00:21:20,630 --> 00:21:25,130
هذا صحيح! بإمكاننا استدعاء
!شياطين بملابسنا الدّاخليّة

287
00:21:27,960 --> 00:21:30,500
!لوفي-سان، غنّ عندما تشعر بالحزن

288
00:21:31,160 --> 00:21:35,070
!ذلك هو دور الموسيقيّين! لذلك انتظرني

289
00:21:35,070 --> 00:21:38,270
!سوف... سوف أكون هناك

290
00:21:38,270 --> 00:21:42,570
...لوفي-سان، لوفي-سان، قبل ذلك

291
00:21:42,570 --> 00:21:44,800
!النّجدة

292
00:21:53,490 --> 00:21:55,960
ما الّذي ستفعله يا لوفي-كُن؟

293
00:21:55,960 --> 00:22:00,790
!ر-ريلي، ما الّذي قلته للتّوّ؟

294
00:22:01,820 --> 00:22:03,800
!ألم تكوني تستمعين؟

295
00:22:03,800 --> 00:22:05,050
!الأمر ليس كذلك

296
00:22:05,730 --> 00:22:08,010
!لا أستطيع فهم نيّتك

297
00:22:09,200 --> 00:22:13,890
.تعلم ما الّذي يدور في ذهن لوفي الآن

298
00:22:14,290 --> 00:22:18,140
!ووفقًا لإجابتك، فلن أستطيع مسامحتك

299
00:22:18,140 --> 00:22:19,690
!إنّها محقّة

300
00:22:19,690 --> 00:22:22,100
،كيف تجرؤ على قول شيء كهذا

301
00:22:22,100 --> 00:22:24,280
وأنت تعلم ما حدث له؟

302
00:22:24,280 --> 00:22:26,610
.أنت شخص قاسٍ

303
00:22:26,610 --> 00:22:28,600
."لهذا السّبب قلتُ أنّه "اقتراح

304
00:22:29,400 --> 00:22:32,870
.عليك أن تقرّر يا لوفي-كُن ما الّذي تريده

305
00:22:39,720 --> 00:22:43,220
...لا أريد أن أدع أصدقائي

306
00:22:45,300 --> 00:22:48,760
!يواجهون ما واجهوه من قبل ثانية

307
00:22:51,840 --> 00:22:56,310
،إن قمتُ ما أخبرتني به
فسأتمكّن من حماية أصدقائي؟

308
00:22:57,240 --> 00:23:00,230
.أعتقد أنّ الأمر يستحقّ المحاولة

309
00:23:00,820 --> 00:23:03,860
.لكن عليك أن تدرك أنّه سيكون أمامك الكثير لتقوم به

310
00:23:07,790 --> 00:23:09,030
.مفهوم

311
00:23:10,120 --> 00:23:11,990
.اتّخذت قراري

312
00:23:14,120 --> 00:23:16,290
.سأعود

313
00:23:17,510 --> 00:23:18,930
!إلى مارينفورد

314
00:23:25,420 --> 00:23:30,340
،بعد معرفة سانجي بوفاة إيس
.استعدّ بسرعة للعودة إلى أرخبيل شابوندي

315
00:23:30,340 --> 00:23:33,770
.لكن حينها، كانت الملكة إيفان-سان قد عادت

316
00:23:33,770 --> 00:23:36,680
!وحلّ الفرح على مملكة كاماباكّا بأكملها

317
00:23:36,680 --> 00:23:40,450
تمكّن سانجي أخيرًا من أن يكون رجلاً
!ثانية، لكن هنالك خطر جديد يواجهه

318
00:23:40,450 --> 00:23:41,940
:في الحلقة القادمة من وان بيس

319
00:23:41,940 --> 00:23:45,270
"!كارثة لسانجي! عودة الملكة إلى المملكة"

320
00:23:45,270 --> 00:23:47,520
!ملك القراصنة، لن يكون إلاّ أنا

321
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة