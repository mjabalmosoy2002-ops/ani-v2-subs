1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,860 --> 00:03:24,820
كان لوفي يعاني بعد فقدانه
.لأخيه إيس في الحرب ضدّ البحريّة

38
00:03:24,820 --> 00:03:28,070
!ملك القراصنة؟

39
00:03:28,470 --> 00:03:31,490
،وحينها، أتى ملك الظّلام للقاء لوفي

40
00:03:31,490 --> 00:03:33,840
.الّذي كان بالكاد يستطيع الوقوف على قدميه

41
00:03:34,490 --> 00:03:36,700
.إليك اقتراحي الثّاني إذًا

42
00:03:37,200 --> 00:03:41,100
في تلك الأثناء، يكتشف بقيّة طاقم
قبّعة القشّ ما حدث للوفي

43
00:03:41,100 --> 00:03:43,920
.وأدركوا كم أنّ الأمر كان صعبًا عليه

44
00:03:47,960 --> 00:03:52,530
!لقاء! السّيّاف العظيم ميهوك"
"!صراع زورو المميت العنيد

45
00:04:20,170 --> 00:04:23,400
،هذه جزيرة كورايغانا في الغراند لاين

46
00:04:23,400 --> 00:04:25,800
.أطلال مملكة شيكّيارو

47
00:04:26,350 --> 00:04:28,840
حيث توجد بقايا قلعة قديمة من
...المملكة الّتي هلكت منذ مدّة

48
00:04:29,520 --> 00:04:34,800
.والّتي صارت مأهولة منذ بضع سنوات الآن

49
00:04:34,800 --> 00:04:38,850
!لا أصدّق أنّ موريا-ساما مات في الحرب

50
00:04:48,530 --> 00:04:51,820
.إنّك تزعجين أذنيّ. اذهبي لمكان آخر للبكاء

51
00:04:52,290 --> 00:04:56,110
يا لقسوتك وأنت تقول ذلك وهناك
.من هو محطّم بالكامل أمامك

52
00:04:56,110 --> 00:05:00,710
!قل شيئًا لطيفًا وأحضر لي كوب شكولاطة ساخنة

53
00:05:00,710 --> 00:05:03,030
!أنا ضيفتك

54
00:05:03,030 --> 00:05:04,880
.لم أدعوك أبدًا

55
00:05:04,880 --> 00:05:08,050
.لقد كنتما تعيشان هنا بكون بدون في غيابي

56
00:05:08,450 --> 00:05:09,380
...وأيضًا

57
00:05:10,530 --> 00:05:12,550
.هذا المقال ليس موثوقًا

58
00:05:13,000 --> 00:05:17,470
!ماذا؟! إذًا فلا تظنّ أنّ موريا-ساما قد مات في الحرب؟

59
00:05:17,960 --> 00:05:23,600
،لا أدري إن كان ميتًا أم حيًّا
...لكنّ ما أذكره على الأقلّ

60
00:05:23,600 --> 00:05:27,820
.هو أنّ موريا كان حيًّا في ساحة المعركة

61
00:05:28,480 --> 00:05:32,490
إن لم يكن ميتًا، فلماذا قالوا أنّه مات؟

62
00:05:32,490 --> 00:05:33,610
.لا أدري

63
00:05:37,160 --> 00:05:40,120
!كـ-كيف استيقظت؟

64
00:05:40,120 --> 00:05:43,290
!الزم فراشك، أنت معدوم الفائدة

65
00:05:43,290 --> 00:05:46,060
!ما الّذي تنوي فعله بتلك السّيوف؟

66
00:05:48,000 --> 00:05:50,920
هل ستضغط على نفسك ثانية؟

67
00:05:50,920 --> 00:05:55,120
.لا يمكنك هزيمة قرود الرّبّاح تلك
...سوف تقتلك هذه المرّة

68
00:05:55,120 --> 00:05:56,470
!اخرسي

69
00:05:56,470 --> 00:05:59,060
!هذا ليس من شأنك

70
00:05:59,060 --> 00:06:00,880
!كيف أمكنك قول ذلك لي؟

71
00:06:00,880 --> 00:06:04,560
ألا يمكنك النّظر أنّني حملتك طوال
!الطّريق إلى هنا؟

72
00:06:05,810 --> 00:06:07,520
!"يا "عين الصّقر

73
00:06:11,440 --> 00:06:14,150
!أرأيت؟! لا يمكنك حتّى المشي

74
00:06:14,950 --> 00:06:18,700
لماذا أنت مستعجل لهذه الدّرجة؟
.أنت مصاب

75
00:06:19,950 --> 00:06:24,680
.لأنّك أخبرتني ما حدث للوفي

76
00:06:24,680 --> 00:06:26,040
!كيف لي ألاّ أحرّك ساكنًا؟

77
00:06:27,170 --> 00:06:28,780
.على الأرجح أنّه ما زال حيًّا

78
00:06:28,780 --> 00:06:32,420
.لكنّني أفترض أنّه كان مصدومًا بشدّة

79
00:06:33,050 --> 00:06:34,610
...إنّ "قبضة النّار" إيس

80
00:06:35,840 --> 00:06:38,090
.مات أمام عينيْ قبّعة القشّ

81
00:06:38,470 --> 00:06:43,640
!لم أكن أعلم حتّى أن حربًا ضخمة كهذه قد حدثت

82
00:06:43,640 --> 00:06:48,230
!هل أنت واثق أنّ لوفي بخير؟
!أين هو الآن؟

83
00:06:48,230 --> 00:06:50,380
!أخبرني المزيد

84
00:06:51,360 --> 00:06:54,190
.أخبرتك بكلّ ما أعرف

85
00:06:57,360 --> 00:06:59,700
.آسف على إزعاجك إذًا

86
00:07:00,830 --> 00:07:01,870
!انتظر

87
00:07:01,870 --> 00:07:06,330
حتّى إن استطعت الوصول إلى الشّاطئ
،دون لقاء قرود الرّبّاح تلك

88
00:07:06,330 --> 00:07:09,200
فكيف ستعبر البحر؟

89
00:07:11,700 --> 00:07:13,500
،إن كنت تريد قاربًا صغيرًا

90
00:07:13,500 --> 00:07:16,050
.فهناك واحد في الجانب الغربيّ لهذه القلعة

91
00:07:17,800 --> 00:07:19,640
.شكرًا على كلّ شيء

92
00:07:23,180 --> 00:07:24,930
!ماذا؟

93
00:07:24,930 --> 00:07:28,850
!أيّها الغبيّ! لن أهتمّ بك بعد الآن

94
00:07:28,850 --> 00:07:32,260
!لن أنقذك أبدًا

95
00:07:38,780 --> 00:07:42,950
،رغم أنّك فقدت أخاك للتّوّ يا لوفي

96
00:07:42,950 --> 00:07:46,160
!أعلم أنّك ستفي بوعدك

97
00:07:46,580 --> 00:07:50,330
لذلك السّبب سأكون هناك
!...أيضًا مهما كلّف الأمر

98
00:08:00,680 --> 00:08:02,750
!ها أنت ذي

99
00:08:02,750 --> 00:08:05,310
.كنت أعلم أنّك لن تتركيني وشأني بسهولة

100
00:08:16,610 --> 00:08:19,400
!هجوم "الغول الثّور: المخالب الجريئة"؟

101
00:08:24,910 --> 00:08:26,830
."كان ذلك هجوم "إعصار التّنّين

102
00:08:26,830 --> 00:08:30,000
!إنّها تقلّد مهاراتي في أسلوب السّيوف الثّلاثة

103
00:08:40,050 --> 00:08:41,800
!أيّتها القرود الغبيّة

104
00:08:45,050 --> 00:08:48,930
كيف لك أن تكوني مسرورة للغاية
!بتقليدك لمهارات شخص آخر؟

105
00:08:49,890 --> 00:08:53,650
!لا تعبثي معي

106
00:08:54,550 --> 00:08:58,400
!سُحقًا! لا يمكنه العبث معي

107
00:08:58,400 --> 00:09:01,570
!قمتُ بالكثير من أجله

108
00:09:01,570 --> 00:09:06,030
!آمل أن يموت ويريحنا! إنّه يستحقّ ذلك

109
00:09:07,200 --> 00:09:10,710
لماذا لا تذهبين للبحث عن رورونوا
بما أنّك قلقة عليه لهذه الدّرجة؟

110
00:09:10,710 --> 00:09:14,710
!أتمزح معي؟! لماذا قد أقلق على ذلك المغفّل؟

111
00:09:14,710 --> 00:09:18,460
.حسنًا، لا أظنّ أنّه سيموت بتلك السّهولة

112
00:09:18,880 --> 00:09:26,180
اسمع، كان مصابًا بشدّة سلفًا
!حينما أرسله كوما إلى هنا

113
00:09:26,180 --> 00:09:30,730
لذلك قد يفقد حياته إن قاتل
.قرود الرّبّاح تلك ثانية

114
00:09:30,730 --> 00:09:34,270
!سُحقًا! سُحقًا! سُحقًا لك

115
00:09:34,270 --> 00:09:36,740
إن مات، فسأعلق مع هذا الرّجل

116
00:09:36,740 --> 00:09:41,280
الّذي لا يبدي أيّ اهتمام للحيوانات المحشوّة الظّريفة

117
00:09:41,280 --> 00:09:45,240
والّذي يرفض إحضار شطيرة
!وشكولاطة ساخنة لي

118
00:09:45,240 --> 00:09:50,340
لا أريد أن أظلّ عالقة هنا مع قاسي
!القلب "عين الصّقر" ذاك

119
00:09:50,780 --> 00:09:53,580
!لا أتحمّل ذلك

120
00:10:01,650 --> 00:10:04,100
!العوالم الثّلاثة آلاف

121
00:10:13,890 --> 00:10:14,730
...ما الّذي

122
00:10:15,060 --> 00:10:18,400
...النّدوب في الظّهر هي عار السّيّاف

123
00:10:19,190 --> 00:10:20,190
!مثير للإعجاب

124
00:10:35,160 --> 00:10:38,420
هل ما زلت على قيد الحياة؟

125
00:10:39,120 --> 00:10:43,920
،لا بدّ أنّه وصل للشّاطئ الآن
...لكنّني لا أرى أيّ أثر له

126
00:10:43,920 --> 00:10:47,010
!ربّما ضاع ثانية

127
00:10:50,720 --> 00:10:51,850
...قاطع

128
00:10:52,970 --> 00:10:54,230
!الغيلان

129
00:11:02,940 --> 00:11:07,030
!كفّ عن وضع بصاق عليه
!أين تعلّمت هذا العلاج الشّعبيّ؟

130
00:11:11,450 --> 00:11:15,040
!قرود لعينة، إنّها تسخر منّي بالفعل

131
00:11:15,710 --> 00:11:18,790
!لن أصل للبحر أبدًا على هذه الوتيرة

132
00:11:28,010 --> 00:11:29,380
..."عين الصّقر"

133
00:11:30,390 --> 00:11:32,700
مرّ وقت طويل مذ غادرتَ القلعة

134
00:11:32,700 --> 00:11:35,270
وابتعدت لهذه المسافة فحسب يا رورونوا؟

135
00:11:35,680 --> 00:11:40,770
.يبدو أنّ القارب الّذي أعطيتك إيّاه صار بلا فائدة الآن

136
00:11:40,770 --> 00:11:42,310
!اخرس

137
00:11:42,310 --> 00:11:46,860
.سأستعمل الألواح وأسبح مستندًا عليها فحسب

138
00:11:47,650 --> 00:11:51,570
من الجيّد أنّ تهتمّ لأمر صديقك
.لهذه الدّرجة، لكنّها قويّة

139
00:11:52,410 --> 00:11:57,410
إنّها تُدعى هيوماندريل، وهي قردة ربّاح
.تتطوّر عن طريق تقليد البشر

140
00:11:57,410 --> 00:11:59,210
هيوماندريل؟

141
00:11:59,680 --> 00:12:04,210
لكانت قردة مُحِبّة لو أنّها كبرت
.قرب بشر مسالمين

142
00:12:04,210 --> 00:12:06,260
...لكن على هذه الجزيرة

143
00:12:07,210 --> 00:12:11,300
.كانت هنالك حرب حتّى سبع سنوات مضت

144
00:12:12,300 --> 00:12:17,680
عندما أتيت للعيش هنا، كانت رائحة
الدّماء والدّخان ما زالت تعمّ المكان

145
00:12:17,680 --> 00:12:20,480
.وكانت الجثث متناثرة على الأرض

146
00:12:21,600 --> 00:12:26,730
وقد كبرت قردة الرّبّاح هذه وهي
تشاهد أولئك البشر العنيفين

147
00:12:26,730 --> 00:12:31,450
وتعلّمت كيف تستعمل الأسلحة
.وصارت محاربة الغابة

148
00:12:32,570 --> 00:12:36,120
بإمكان البشر التّفوّق على الحيوانات
.باستعمال الأسلحة والحكمة

149
00:12:36,120 --> 00:12:40,000
.لكن عندما تستعمل الحيوانات الأسلحة، تصير أقوى

150
00:12:40,000 --> 00:12:43,880
.إنّها تشكّل خصومًا ممتازة لشابّ يافع متغطرس

151
00:12:43,880 --> 00:12:45,130
أتقصدني بكلامك؟

152
00:12:45,600 --> 00:12:47,770
.لا يوجد سواك هنا

153
00:12:47,770 --> 00:12:50,320
.أوشكت الشّمس أن تغرب. عد لقلعتي

154
00:12:50,320 --> 00:12:52,550
.لن تزعجك هناك

155
00:12:53,680 --> 00:12:57,100
!لا تمل عليّ الأوامر

156
00:12:57,100 --> 00:12:59,230
!عليّ أن أبحر

157
00:13:00,140 --> 00:13:03,600
.فهمت. افعل ما يحلو لك

158
00:13:06,230 --> 00:13:09,360
،لا أهتمّ إن كانت محاربة الغابة أو ما شابه

159
00:13:09,360 --> 00:13:12,820
!لا وقت لديّ لأضيّعه

160
00:13:14,070 --> 00:13:16,410
!سأهزم كلّ واحد منها

161
00:13:16,410 --> 00:13:20,080
سُحقًا! إلى أين ذهب؟

162
00:13:21,660 --> 00:13:24,170
!ذلك ما ظننت! ما زالت هنا

163
00:13:27,170 --> 00:13:28,590
!مـ-مهلاً

164
00:13:49,360 --> 00:13:53,360
في هاراهيتّانيا في جزيرة ناكامورا
...في الغراند لاين

165
00:13:55,570 --> 00:13:57,990
ما الّذي يفعله ساتان-ساما؟

166
00:13:58,520 --> 00:14:01,830
ما الّذي حلّ بالطّقس الّذي سيلعن
قبيلة طويلي الأذرع حتّى الموت؟

167
00:14:01,830 --> 00:14:03,080
.المكان هادئ للغاية

168
00:14:03,080 --> 00:14:05,790
.ضعوا ثقتكم به

169
00:14:05,790 --> 00:14:10,290
أنا واثق أنّ ساتان-ساما سيوجّه

170
00:14:10,290 --> 00:14:13,130
!ضربة قاضية لقبيلة الأذرع الطّويلة اللّعينة

171
00:14:15,380 --> 00:14:18,470
!أيّها الحضور، شكرًا على الانتظار

172
00:14:18,470 --> 00:14:20,470
هل انتهى الطّقس أخيرًا؟

173
00:14:20,470 --> 00:14:22,310
!هذا هو ساتان-ساما

174
00:14:22,310 --> 00:14:25,540
...لقد انتهيت. ما دمتم تملكون هذه

175
00:14:26,600 --> 00:14:28,000
ما هذه؟

176
00:14:28,000 --> 00:14:29,480
!فستكونون بخير

177
00:14:29,910 --> 00:14:32,530
مهلاً... ما هذه؟

178
00:14:32,530 --> 00:14:34,150
...هذا

179
00:14:34,150 --> 00:14:35,650
!أعلم

180
00:14:35,650 --> 00:14:36,700
ماذا؟

181
00:14:37,820 --> 00:14:40,210
!أصغوا إليّ جميعًا

182
00:14:40,210 --> 00:14:43,880
صنع ساتان-ساما تميمة لنا

183
00:14:43,880 --> 00:14:46,790
!ستسمح لنا بلعن قبيلة طويلي الأذرع حتّى الموت

184
00:14:46,790 --> 00:14:48,080
ماذا؟

185
00:14:48,520 --> 00:14:50,530
،بهذه التّميمة

186
00:14:50,530 --> 00:14:54,880
حتّى قبيلة طويلي الأذرع الضّارية
!لن تستطيع الاقتراب منّا

187
00:14:54,880 --> 00:14:58,010
!سيموتون بمجرّد رؤيتنا

188
00:14:58,010 --> 00:14:59,390
...عفوًا، ذلك

189
00:14:59,390 --> 00:15:00,350
!فهمت

190
00:15:00,350 --> 00:15:01,430
!هذا هو ساتان-ساما

191
00:15:01,880 --> 00:15:07,320
!حسنًا جميعًا، لنضع هذه التّمائم في أماكن مختلفة

192
00:15:07,320 --> 00:15:11,070
...كلاّ، لحظة... إنّها لا تُستعمل هكذا

193
00:15:16,030 --> 00:15:19,320
!عـ-عـ-عفوًا! انتظروا جميعًا

194
00:15:21,200 --> 00:15:23,200
!لقد وضعناها جميعها

195
00:15:23,200 --> 00:15:25,200
!نعم، أحسنتم عملاً

196
00:15:25,790 --> 00:15:27,620
!صرنا آمنين الآن

197
00:15:27,620 --> 00:15:29,710
!شكرًا جزيلاً يا ساتان-ساما

198
00:15:30,290 --> 00:15:31,210
...عفوًا

199
00:15:31,210 --> 00:15:32,630
!أيّها الزّعيم، لدينا مشكلة

200
00:15:33,510 --> 00:15:35,550
!قـ-قبيلة طويلي الأذرع هنا

201
00:15:36,180 --> 00:15:39,550
.إنّهم أشبه بالعثّ المنجذب للنّار

202
00:15:39,550 --> 00:15:43,560
!ستختفي قبيلة طويلي الأذرع اليوم

203
00:15:45,180 --> 00:15:49,560
.كما كنتُ أقول، عفوًا... إنّها ليس تمائم

204
00:15:49,560 --> 00:15:52,480
!إنّها مقطوعة موسيقيّة ألّفتها بنفسي

205
00:15:52,980 --> 00:15:54,270
ماذا؟

206
00:15:54,270 --> 00:15:56,150
!ماذا؟

207
00:16:02,270 --> 00:16:03,790
!نحن هالكون

208
00:16:04,740 --> 00:16:08,660
سيأخذون الطّعام القليل الّذي بقي لدينا

209
00:16:09,190 --> 00:16:12,580
إضافة للرّجال والنّساء وسيقومون
...بكلّ ما يشاؤون به

210
00:16:12,580 --> 00:16:14,240
.لا خيار أمامنا

211
00:16:15,090 --> 00:16:17,260
!بل لديكم خيار

212
00:16:17,620 --> 00:16:19,070
!ساتان-ساما

213
00:16:21,180 --> 00:16:24,330
.استمعوا لهذه الأغنية جميعًا

214
00:16:32,600 --> 00:16:34,360
ما هذه الأغنية؟

215
00:16:34,890 --> 00:16:38,730
!إنّه يملأ جسدي بالحيويّة

216
00:16:41,680 --> 00:16:44,520
ما هذه الأشياء؟ تعويذة من نوع ما؟

217
00:16:44,520 --> 00:16:50,420
يصعب معرفة ما يفكّر به هؤلاء الأشخاص
.أصحاب المفصل الواحد في أذرعهم

218
00:16:54,500 --> 00:16:56,800
ماذا؟ من أنتم؟

219
00:16:59,280 --> 00:17:04,430
!بدءًا من اليوم، لن نسمح لكم باستضعافنا

220
00:17:04,430 --> 00:17:05,350
ماذا؟

221
00:17:05,350 --> 00:17:08,020
!لقد قرّرنا أن نقاتل

222
00:17:08,020 --> 00:17:10,480
!صحيح! لن تأخذوا أيّ شيء منّا بعد الآن

223
00:17:10,480 --> 00:17:13,480
!سنحمي ما لنا بأيدينا نحن

224
00:17:13,480 --> 00:17:16,020
!نحن لا نخشى أيّ شيء

225
00:17:16,940 --> 00:17:18,320
!هذا هو المطلوب

226
00:17:18,320 --> 00:17:22,400
.يبدون مختلفين عن العادة

227
00:17:23,200 --> 00:17:27,620
...لا أدري ما الّذي حلّ بكم
!لكن لنوسعهم ضربًا

228
00:17:27,620 --> 00:17:29,120
!نالوا منهم

229
00:17:34,040 --> 00:17:37,670
!شكرًا جزيلاً لك يا ملك الشّياطين ساتان-ساما

230
00:17:39,440 --> 00:17:46,050
لم أحلم أبدًا أن نتمكّن من وضعهم
!في أقفاص ذات يوم

231
00:17:46,050 --> 00:17:51,140
لا أدري ما السّبب، لكن عندما
...سمعت المقطوعة الّتي ألّفتَها

232
00:17:51,140 --> 00:17:53,940
،ملأت الشّجاعة والقوّة قلبي

233
00:17:53,940 --> 00:17:57,440
!وحملتُ الأسلحة وقاتلت لأوّل مرّة في حياتي

234
00:17:58,560 --> 00:18:01,240
...وبطبيعة الحال

235
00:18:01,240 --> 00:18:04,560
.انتهى الأمر بفشلنا وقمت أنت بهزيمتهم أخيرًا

236
00:18:04,560 --> 00:18:09,450
!لكنّ من اختُطفوا عادوا بسلام بفضلك

237
00:18:10,910 --> 00:18:14,290
.إطلاقًا، ساعدتُ قليلاً فحسب

238
00:18:15,050 --> 00:18:19,380
لن تساعد الآلهة أو الشّياطين أيّ أحد
.يأبى أن يقاتل بنفسه

239
00:18:19,380 --> 00:18:23,420
،بما أنّنا نعيش في أوقات كهذه
...أردت أن أحرص

240
00:18:23,420 --> 00:18:27,180
أنّ بإمكانكم الوقوف بأنفسكم
!في وجه الشّرّ بدوني

241
00:18:27,180 --> 00:18:32,680
!يا لرحمته! أظنّ أنّ بإمكاننا التّغيّر من الآن فصاعدًا

242
00:18:32,680 --> 00:18:35,640
!شكرًا جزيلاً لك يا ساتان-ساما

243
00:18:36,570 --> 00:18:39,270
.أعتقد أنّني أدّيت واجبي ناحيتهم

244
00:18:39,860 --> 00:18:43,860
.والآن... لا أصدّق تلك الأخبار

245
00:18:43,860 --> 00:18:49,280
.لوفي-سان، آمل أنّك بخير
!إنّها أخبار تحطّم القلب

246
00:18:49,720 --> 00:18:51,910
...رغم أنّ لا قلب لي

247
00:18:51,910 --> 00:18:55,210
!لوفي-سان، لنغنّ أغنية معًا

248
00:18:55,210 --> 00:18:58,250
!سأذهب إلى هناك لإنقاذ قلبك الآن

249
00:18:58,250 --> 00:19:02,050
!سُحقًا! لا أصدّق أنّ لهم شيطانًا كحارس شخصيّ

250
00:19:02,050 --> 00:19:07,380
لو استطعنا إحضار هؤلاء البشر
،ذوي المفصل الواحد في أذرعهم لموطننا

251
00:19:07,380 --> 00:19:11,100
لاستطعنا جني ثروة عن طريق
.عرضهم على متفرّجين

252
00:19:11,100 --> 00:19:12,680
...حسنًا

253
00:19:12,680 --> 00:19:16,190
يملك سكّان قبيلة طويلي الأذرع
.مفصلين في أذرعهم

254
00:19:16,190 --> 00:19:19,770
!بإمكاننا جني ثروة بعرضهم على متفرّجين

255
00:19:19,770 --> 00:19:21,610
!مـ-مهلاً لحظة

256
00:19:22,020 --> 00:19:26,820
لا يمكنكم ذلك! ستكونون بذلك تعاملونهم
!بنفس طريقة معاملتهم لكم

257
00:19:26,820 --> 00:19:28,070
ماذا؟

258
00:19:28,070 --> 00:19:30,280
!استمعوا جميعًا

259
00:19:31,330 --> 00:19:36,160
!ماذا؟! ندعهم يذهبون؟
!سيهاجموننا ثانية هكذا

260
00:19:36,160 --> 00:19:37,750
.لا تقلق

261
00:19:37,750 --> 00:19:40,880
.وقّعت عقد شيطان معهم

262
00:19:42,540 --> 00:19:45,090
.اسمعوا أنتم الثّلاثة

263
00:19:45,090 --> 00:19:47,440
إن خلفتم بوعدك معي

264
00:19:47,440 --> 00:19:50,970
،واقترفتم عملاً خاطئًا في حقّ هذه البلاد ثانية

265
00:19:50,970 --> 00:19:55,220
!فسآكل قلوبكم

266
00:19:57,980 --> 00:20:01,150
!شكرًا لسماحك لنا بالذّهاب

267
00:20:01,150 --> 00:20:03,070
!سنعود لموطننا في الحال

268
00:20:03,070 --> 00:20:06,780
!لن نأتي لهذه البلاد ثانية

269
00:20:06,780 --> 00:20:12,820
اسمعوا جميعًا. إنّ الدّمار والسّرقة
.لا يولّدان سوى الكراهية

270
00:20:12,820 --> 00:20:18,370
،إن قام أحد ما بالمثل لبلادكم
.أنا واثق أنّكم ستشعرون بالسّوء

271
00:20:18,370 --> 00:20:22,750
لا يهمّ إن كان لديكم مفصل واحد
.أو مفصلين في أذرعكم

272
00:20:22,750 --> 00:20:27,090
!جميعنا بشر! لذلك دعونا نعامل بعضنا بطيبة

273
00:20:27,090 --> 00:20:29,470
!أيّها الشّيطان-ساما

274
00:20:31,970 --> 00:20:33,800
!حسنًا

275
00:20:33,800 --> 00:20:35,550
!ماذا؟

276
00:20:35,550 --> 00:20:38,140
!ماذا؟! ما الّذي يحدث هنا؟

277
00:20:38,140 --> 00:20:39,980
!هيّا بنا

278
00:20:39,980 --> 00:20:42,770
!إنّنا لا نؤمن بالشّياطين

279
00:20:42,770 --> 00:20:46,650
!أنت قويّ، لكن لست قويًّا كثيرًا وأنت مربوط

280
00:20:46,650 --> 00:20:49,990
...إن عدنا ومعنا هيكل عظميّ متكلّم

281
00:20:49,990 --> 00:20:52,030
!فسنتمكّن من جني ثورة

282
00:20:52,030 --> 00:20:56,370
!تمهّلوا لحظة! عليّ الذّهاب لمكان ما

283
00:20:56,370 --> 00:20:57,830
!ساتان-ساما

284
00:20:58,450 --> 00:21:02,330
!مصيبة! اختُطف ساتان-ساما

285
00:21:02,330 --> 00:21:06,630
!أيّها النّاس، استعدّوا لاستدعاء شيطان آخر

286
00:21:06,630 --> 00:21:11,130
هذا صحيح! بإمكاننا استدعاء
!شياطين بملابسنا الدّاخليّة

287
00:21:13,960 --> 00:21:16,500
!لوفي-سان، غنّ عندما تشعر بالحزن

288
00:21:17,160 --> 00:21:21,070
!ذلك هو دور الموسيقيّين! لذلك انتظرني

289
00:21:21,070 --> 00:21:24,270
!سوف... سوف أكون هناك

290
00:21:24,270 --> 00:21:28,570
...لوفي-سان، لوفي-سان، قبل ذلك

291
00:21:28,570 --> 00:21:30,800
!النّجدة

292
00:21:39,490 --> 00:21:41,960
ما الّذي ستفعله يا لوفي-كُن؟

293
00:21:41,960 --> 00:21:46,790
!ر-ريلي، ما الّذي قلته للتّوّ؟

294
00:21:47,820 --> 00:21:49,800
!ألم تكوني تستمعين؟

295
00:21:49,800 --> 00:21:51,050
!الأمر ليس كذلك

296
00:21:51,730 --> 00:21:54,010
!لا أستطيع فهم نيّتك

297
00:21:55,200 --> 00:21:59,890
.تعلم ما الّذي يدور في ذهن لوفي الآن

298
00:22:00,290 --> 00:22:04,140
!ووفقًا لإجابتك، فلن أستطيع مسامحتك

299
00:22:04,140 --> 00:22:05,690
!إنّها محقّة

300
00:22:05,690 --> 00:22:08,100
،كيف تجرؤ على قول شيء كهذا

301
00:22:08,100 --> 00:22:10,280
وأنت تعلم ما حدث له؟

302
00:22:10,280 --> 00:22:12,610
.أنت شخص قاسٍ

303
00:22:12,610 --> 00:22:14,600
."لهذا السّبب قلتُ أنّه "اقتراح

304
00:22:15,400 --> 00:22:18,870
.عليك أن تقرّر يا لوفي-كُن ما الّذي تريده

305
00:22:25,720 --> 00:22:29,220
...لا أريد أن أدع أصدقائي

306
00:22:31,300 --> 00:22:34,760
!يواجهون ما واجهوه من قبل ثانية

307
00:22:37,840 --> 00:22:42,310
،إن قمتُ ما أخبرتني به
فسأتمكّن من حماية أصدقائي؟

308
00:22:43,240 --> 00:22:46,230
.أعتقد أنّ الأمر يستحقّ المحاولة

309
00:22:46,820 --> 00:22:49,860
.لكن عليك أن تدرك أنّه سيكون أمامك الكثير لتقوم به

310
00:22:53,790 --> 00:22:55,030
.مفهوم

311
00:22:56,120 --> 00:22:57,990
.اتّخذت قراري

312
00:23:00,120 --> 00:23:02,290
.سأعود

313
00:23:03,510 --> 00:23:04,930
!إلى مارينفورد

314
00:23:11,420 --> 00:23:16,340
،بعد معرفة سانجي بوفاة إيس
.استعدّ بسرعة للعودة إلى أرخبيل شابوندي

315
00:23:16,340 --> 00:23:19,770
.لكن حينها، كانت الملكة إيفان-سان قد عادت

316
00:23:19,770 --> 00:23:22,680
!وحلّ الفرح على مملكة كاماباكّا بأكملها

317
00:23:22,680 --> 00:23:26,450
تمكّن سانجي أخيرًا من أن يكون رجلاً
!ثانية، لكن هنالك خطر جديد يواجهه

318
00:23:26,450 --> 00:23:27,940
:في الحلقة القادمة من وان بيس

319
00:23:27,940 --> 00:23:31,270
"!كارثة لسانجي! عودة الملكة إلى المملكة"

320
00:23:31,270 --> 00:23:33,520
!ملك القراصنة، لن يكون إلاّ أنا

321
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة