1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:01:55,810 --> 00:01:59,620
،حلم زيف وسانجي"
".أول بلو الوهميّ

26
00:02:03,850 --> 00:02:05,020
!غين

27
00:02:05,560 --> 00:02:09,990
،لا يهمّ كم كان قويًّا في الماضي
.ما هو إلاّ طبّاخ الآن

28
00:02:10,390 --> 00:02:12,760
.من السّهل تفجير رأسه

29
00:02:14,260 --> 00:02:17,100
،تريد إنقاذ هذا الرّجل
صحيح يا سانجي-سان؟

30
00:02:17,100 --> 00:02:20,370
.أرجوك، غادر السّفينة بدون قتال

31
00:02:20,900 --> 00:02:23,710
.لا أريد قتلك

32
00:02:26,540 --> 00:02:28,010
أغادر السّفينة؟

33
00:02:28,710 --> 00:02:30,250
!مستحيل

34
00:02:32,210 --> 00:02:35,180
.كم تبدو غبيًّا أيّها العجوز اللّعين

35
00:02:35,550 --> 00:02:38,850
على حالتك هذه، لن تُعتبر قدوة
.حسنة للطبّاخين المقاتلين

36
00:02:39,720 --> 00:02:42,690
.لا أحتاج لمحاضرة من شقيّ صغير

37
00:02:42,720 --> 00:02:45,060
ما الّذي تجنيه من مناداتي
!الشّقيّ الصّغير أيّها الوغد؟"

38
00:02:45,060 --> 00:02:47,400
!كفّ عن معاملتي كطفل

39
00:02:47,700 --> 00:02:49,060
...يا لسانجي

40
00:02:49,060 --> 00:02:51,600
لن يتخلّى عن المالك، صحيح؟

41
00:02:51,930 --> 00:02:55,300
.غين! وجّه ذلك المسدّس نحوي

42
00:02:56,440 --> 00:02:58,510
!هل أنت غبيّ؟! ستموت

43
00:02:58,510 --> 00:02:59,370
...ربّما

44
00:03:00,140 --> 00:03:02,410
!سانجي-سان... لماذا؟

45
00:03:03,010 --> 00:03:08,250
،إن كنتَ ترغب في الموت بشدّة
...فسأقتلك بطريقة لبقة

46
00:03:09,350 --> 00:03:13,960
لا تتحرّك إن كنتَ لا تريد
.أن يُفجّر رأس مالك مطعمكم

47
00:03:15,720 --> 00:03:19,030
!هديّة اللّآلئ الطّبيعيّة القصوى

48
00:03:21,360 --> 00:03:24,430
!سانجي! لماذا لم تتفاداه؟

49
00:03:25,270 --> 00:03:29,500
إن تفاديتها، لقام ذلك التّابع
.بالضّغط على الزّناد

50
00:03:30,570 --> 00:03:33,210
،لماذا؟ إن تركتَ هذا المطعم

51
00:03:33,210 --> 00:03:35,640
.فسينجو الجميع بحياته
!هذا مسلّم به، صحيح؟

52
00:03:35,640 --> 00:03:37,780
!هذا المطعم هو كنز ذلك العجوز اللّعين

53
00:03:41,580 --> 00:03:45,620
سلبتُ ذلك العجوز
...اللّعين كلّ شيء

54
00:03:48,560 --> 00:03:49,690
...قوّته

55
00:03:52,260 --> 00:03:53,360
...حلمه

56
00:03:56,230 --> 00:04:01,270
لذلك لا أريد أن يخسر ذلك
!العجوز اللّعين أيّ شيء آخر

57
00:04:02,300 --> 00:04:03,470
!انتبه يا سانجي

58
00:04:03,470 --> 00:04:06,540
!صنجا اللّآلئ

59
00:04:06,810 --> 00:04:08,110
!سانجي

60
00:04:13,350 --> 00:04:14,850
أول بلو؟

61
00:04:14,850 --> 00:04:15,710
!نعم

62
00:04:15,710 --> 00:04:20,220
إنّه بحر أسطوريّ. إنّه موجود
!في مكان ما بكلّ تأكيد

63
00:04:26,730 --> 00:04:31,700
لا تكن سخيفًا! رغم أنّ هنالك
.أسطورة كهذه بالفعل

64
00:04:31,700 --> 00:04:37,600
نحن طبّاخو سُفن، لذلك حلمنا
.جميعًا بذلك البحر في مرحلة ما

65
00:04:37,600 --> 00:04:42,070
!فعلًا؟ سأجد ذلك البحر بالفعل يومًا ما

66
00:04:42,340 --> 00:04:44,580
...تقول أنّك ستجده، ولكن

67
00:04:44,580 --> 00:04:48,550
هل تعلم أيّ نوع من الأماكن
هو أول بلو من الأساس؟

68
00:04:48,550 --> 00:04:50,450
!بالطّبع أعرف! لا تعتبرني جاهلًا

69
00:04:51,180 --> 00:04:54,890
الأزرق الشّرقيّ والأزرق الغربيّ
...والأزرق الشّماليّ والأزرق الجنوبيّ

70
00:04:54,890 --> 00:04:59,260
إنّه بحر حيث يعيش سمك
...من كلّ هذه البحار

71
00:04:59,260 --> 00:05:00,990
.هذا هو أول بلو

72
00:05:01,190 --> 00:05:04,460
إنّه جنّة لا تُقاوم بالنّسبة
!لطبّاخي السّفن

73
00:05:06,700 --> 00:05:07,930
!هذا هو حلمي

74
00:05:08,530 --> 00:05:13,200
صحيح! ستجد طعامًا بحريًّا
.من كلّ العالم في ذلك البحر

75
00:05:13,200 --> 00:05:15,940
سيكون الطّبّاخون متحمّسين
!لفرصة إظهار مهاراتهم

76
00:05:15,940 --> 00:05:19,980
نعم. إنّه أمر يستحقّ المرء
.المخاطرة بحياته من أجله

77
00:05:19,980 --> 00:05:21,810
...هذا إن وُجد بحر كهذا بالفعل

78
00:05:22,780 --> 00:05:26,180
...مستحيل لبحرٍ معجزة كأول بلو أن يوجد بالفعل

79
00:05:26,180 --> 00:05:28,350
...الأمر واضح إن فكّرتَ فيه قليلًا

80
00:05:29,020 --> 00:05:32,860
على الأرجح أنّه كذبة كبيرة
...من طبّاخ حالم في مكان ما

81
00:05:33,060 --> 00:05:36,990
.والآن، كفانا من القصص السّخيفة
!اجمع الأطباق يا سانجي

82
00:05:40,900 --> 00:05:45,000
يا إلهي، ما هذه الخسارة؟
...سيضيع طعام كثير

83
00:05:45,000 --> 00:05:49,000
.بالكاد لمسوا هذا الطّبق
.كنتُ واثقًا أنّهم سيحبّونه

84
00:05:49,000 --> 00:05:51,610
.زبائن هذه الأيّام مدلّلون كثيرًا

85
00:05:51,940 --> 00:05:54,610
.كفّوا عن أكل بقايا الزّبائن

86
00:05:54,940 --> 00:05:57,480
.رميتُ الطّعام الّذي بدا فاسدًا قبل قليل

87
00:05:57,480 --> 00:06:01,050
يُظهر قول أشياء كهذه أنّك ما زلت
.في منتصف طريقك كطبّاخ

88
00:06:01,280 --> 00:06:04,390
.لا تنسَ أنّنا طبّاخو سُفن

89
00:06:04,620 --> 00:06:09,760
،البحر مكان لا يمكن التّنبّؤ به
.لذا من الأفضل ألاّ نضيّع الطّعام

90
00:06:10,290 --> 00:06:12,430
لماذا لا تتناول بعضه أيضًا؟

91
00:06:12,430 --> 00:06:13,900
!لا أريد

92
00:06:15,960 --> 00:06:19,170
!حافظوا على الهدوء جميعًا
!اهدؤوا رجاءً

93
00:06:23,470 --> 00:06:24,210
!قراصنة

94
00:06:26,310 --> 00:06:27,440
!قراصنة؟

95
00:06:31,680 --> 00:06:37,280
...تلك السّفينة... القراصنة الطبّاخون
!سفينة السّاق الحمراء زيف

96
00:06:38,450 --> 00:06:40,920
!إذًا فقد عادوا من الغراند لاين

97
00:06:53,530 --> 00:06:58,710
،أظنّ أنّك السّاق الحمراء زيف
قائد القراصنة. كيف أساعدك؟

98
00:06:59,810 --> 00:07:00,810
!اسرقوا

99
00:07:02,380 --> 00:07:06,080
!اسلبوهم كلّ أغراضهم الثّمينة

100
00:07:10,420 --> 00:07:12,850
!سُحقًا! سوف أُقتل

101
00:07:13,290 --> 00:07:15,620
!لن أُقتل على يد أوغاد مثلهم

102
00:07:18,320 --> 00:07:19,460
ما قصّة هذا الفتى؟

103
00:07:19,930 --> 00:07:23,930
.يا فتى. لا تلوّح بأشياء كهذه
.هذا أمر خطير

104
00:07:24,200 --> 00:07:26,930
.أنا أنزف. إنّها إصابة خطيرة

105
00:07:26,930 --> 00:07:30,440
!اخرسا! لن أُقتل على يد أوغاد مثلكم

106
00:07:31,600 --> 00:07:32,600
!سانجي

107
00:07:32,600 --> 00:07:34,910
!توقّف! لا تقاتلهم

108
00:07:36,140 --> 00:07:39,880
.يبدو أنّه لا يهاب الموت
!اقتلوا ذلك الشقيّ بسرعة

109
00:07:39,880 --> 00:07:42,710
لا أريد الموت! إن كنتُ سأُقتل
،علي أيديكم يا أوغاد

110
00:07:42,710 --> 00:07:44,950
!فأفضّل قتلكم أوّلًا

111
00:07:48,350 --> 00:07:49,120
!سانجي

112
00:07:50,320 --> 00:07:52,160
.فعلتَها أيّها القائد

113
00:07:52,160 --> 00:07:53,390
.لا رحمة عندك

114
00:08:03,800 --> 00:08:06,040
!لن أموت

115
00:08:08,140 --> 00:08:09,240
...أنا

116
00:08:10,770 --> 00:08:14,710
!سأجد أول بلو يومًا ما

117
00:08:19,280 --> 00:08:21,220
!"قال "أول بلو

118
00:08:21,690 --> 00:08:24,520
!يا له من حلم طموح

119
00:08:24,820 --> 00:08:30,160
أخبره أيّها القائد... أنّ ذلك ليس
.موجودًا حتّى في الغراند لاين

120
00:08:31,660 --> 00:08:33,930
...ذلك الغبيّ! ما زال يردّد ذلك الهراء

121
00:08:46,210 --> 00:08:47,710
...سوف

122
00:08:48,850 --> 00:08:53,480
لن أُقتل على يد قراصنة
!أوغاد في مكان كهذا

123
00:08:55,220 --> 00:09:00,820
!لننسحب أيّها القائد
!هذه العاصفة أكبر ممّا توقّعنا

124
00:09:01,520 --> 00:09:05,690
!هيّا يا رجال! أسرعوا واحملوا الكنز للسّفينة

125
00:09:05,690 --> 00:09:07,160
!سوف ننسحب

126
00:09:24,780 --> 00:09:25,810
!سانجي

127
00:09:25,810 --> 00:09:26,380
!تبًّا

128
00:09:26,750 --> 00:09:27,950
!أيّها القائد

129
00:09:34,790 --> 00:09:36,090
!شقيّ لعين

130
00:09:40,230 --> 00:09:41,330
!أيّها القائد

131
00:09:41,660 --> 00:09:44,330
!لماذا قد تفعل هذا لأجل ذلك الشّقيّ؟

132
00:11:19,190 --> 00:11:23,360
.أراك استيقظتَ أخيرًا أيّها الشّقيّ
.أنت محظوظ جدًّا

133
00:11:23,990 --> 00:11:26,400
...أيّها القرصان! هذا مؤلم

134
00:11:26,860 --> 00:11:31,770
!من المستحيل أن تستطيع الحركة
.فتلك ركلاتي أنا الّتي تلقّيتَها

135
00:11:32,300 --> 00:11:33,440
ماذا عن السّفن؟

136
00:11:33,700 --> 00:11:36,470
.من يدري؟ كان البحر هائجًا

137
00:11:36,470 --> 00:11:38,840
.ما كنتُ لأتفاجأ إن دُمّرت بالكامل

138
00:11:39,380 --> 00:11:42,380
نحن الوحيدان اللّذان
.انتهى بنا المطاف هنا

139
00:11:42,680 --> 00:11:46,320
لا يوجد حيوانات أو فاكهة
.على هذا الجبل الصّخريّ

140
00:11:46,980 --> 00:11:49,790
،على الأقلّ هناك سمك في البحر

141
00:11:49,790 --> 00:11:53,260
،لكن بسبب نحت الأمواج لهذه الصّخرة

142
00:11:53,260 --> 00:11:56,130
لن نتمكّن من الصّعود ثانية
إذا ما نزلنا. أليس هذا حزينًا؟

143
00:11:57,260 --> 00:12:00,960
!هذا كلّه خطؤك أنت
!سأقتلك

144
00:12:01,360 --> 00:12:04,600
واصل الشّكوى. لا خيار آخر أمامنا
.سوى انتظار قدوم المساعدة

145
00:12:04,600 --> 00:12:07,670
إن لم يأتِ أيّ أحد، فسنجفّ
.ونتحوّل لهيكلين عظميّين

146
00:12:07,940 --> 00:12:10,640
...هيكل عظميّ؟! أنا

147
00:12:11,340 --> 00:12:14,610
.حصّتك في ذلك الكيس هناك

148
00:12:17,280 --> 00:12:19,820
ذلك هو الطّعام الّذي انجرف
.معنا لحسن الحظّ

149
00:12:19,820 --> 00:12:23,050
إنّها مؤونة طعام لخمسة أيّام
.تقريبًا إن أكلتَ باعتدال

150
00:12:23,690 --> 00:12:27,820
.استعمل عقلك وكل
.من الجيّد أنّ كلانا طبّاخين

151
00:12:32,160 --> 00:12:35,230
!مهلًا! أتلك حصّتك أنت؟

152
00:12:35,230 --> 00:12:38,100
إنّها ضخمة... أكبر بثلاثة أضعاف
.على الأقلّ من حصّتي

153
00:12:42,870 --> 00:12:49,480
.بالطّبع! أنا رجل بالغ
.تحتاج معدتي لطعام أكثر منك

154
00:12:50,080 --> 00:12:53,110
يجدر بك أن تكون ممتنًّا
.لأنّني تشاركت الطّعام معك

155
00:12:54,220 --> 00:12:57,080
.لا تتوقّع أيّة شفقة منّي

156
00:12:59,820 --> 00:13:01,490
!عجوز لعين

157
00:13:09,760 --> 00:13:12,430
.انتبه للجانب الآخر من البحر

158
00:13:12,670 --> 00:13:14,670
.أعلمني بمجرّد أن ترى سفينة ما

159
00:13:15,440 --> 00:13:18,410
،وحتّى ذلك الحين
لن نتواصل معًا على الإطلاق

160
00:13:18,410 --> 00:13:20,870
.لأنّ ذلك سيكون إضاعة للطّاقة

161
00:13:20,870 --> 00:13:22,480
.حظًّا سعيدًا

162
00:13:23,180 --> 00:13:24,680
!عجوز لعين

163
00:13:24,840 --> 00:13:27,150
.لن أعلمه حتّى إن رأيت سفينة

164
00:13:27,450 --> 00:13:30,580
.سأكون بخير. لديّ مؤونة خمسة أيّام

165
00:13:30,850 --> 00:13:34,620
إن كانت لديّ خمسة أيّام، فستمرّ
.سفينة أو سفينتين بكلّ تأكيد

166
00:13:35,190 --> 00:13:40,590
لكن من باب الحيطة، سأقسّم
.الطّعام ليدوم عشرين يومًا الآن

167
00:13:40,960 --> 00:13:43,360
وخلال عشرين يومًا، فمرور
.سفينة على الأقلّ أمر أكيد

168
00:13:44,400 --> 00:13:48,300
.سأكون بخير. سأنجو بكلّ تأكيد
!هذا أمر هيّن

169
00:14:01,810 --> 00:14:03,620
.لم تمرّ أيّ سفينة اليوم

170
00:14:04,880 --> 00:14:07,690
هذا صحيح. عليّ أن أكون
.صبورًا بضعة أيّام أخرى

171
00:14:14,630 --> 00:14:16,390
...لا أريد الموت

172
00:14:32,840 --> 00:14:36,150
...هذه آخر كسرة خبز
...لقد نال منها العفن

173
00:14:49,960 --> 00:14:54,970
يا إلهي، ما هذه الخسارة؟
...سيضيع طعام كثير

174
00:14:55,900 --> 00:14:58,840
.كفّوا عن أكل بقايا الزّبائن

175
00:14:58,840 --> 00:15:01,570
.رميتُ الطّعام الّذي بدا فاسدًا قبل قليل

176
00:15:02,310 --> 00:15:04,640
لماذا لا تتناول بعضه أيضًا؟

177
00:15:05,440 --> 00:15:08,980
!لا أريد

178
00:15:30,300 --> 00:15:31,970
...كسرة خبزي الأخيرة

179
00:16:10,240 --> 00:16:14,380
...أتساءل إن كان ذلك العجوز اللّعين مات

180
00:16:32,830 --> 00:16:34,660
...ما زال حيًّا

181
00:16:35,400 --> 00:16:37,430
...ولديه طعام أيضًا

182
00:16:38,370 --> 00:16:39,530
...ما زال لديه الكثير

183
00:16:41,530 --> 00:16:44,370
!هناك طعام كثير بذلك القدر

184
00:16:48,710 --> 00:16:51,240
.سآخذه مهما كلّف الأمر

185
00:16:51,680 --> 00:16:54,410
!كان كلّ هذا خطأه من البداية

186
00:16:55,350 --> 00:16:57,320
!أريد أن أعيش

187
00:17:05,060 --> 00:17:07,260
!لماذا أتيتَ إلى هنا أيّها الشّقيّ الصّغير؟

188
00:17:10,260 --> 00:17:12,460
هل رأيتَ سفينة أو ما شابه؟

189
00:17:16,370 --> 00:17:18,970
.أتيتُ لأسرق طعامك

190
00:17:19,300 --> 00:17:24,340
.إن ظننتَ أنّك تستطيع قتلي، فتفضّل
.سأموت إن لم آكل على كلّ حال

191
00:17:26,910 --> 00:17:28,950
لا أصدّق أنّ لديك كلّ هذا
...الطّعام لك وحدك

192
00:17:48,800 --> 00:17:53,200
ألم أخبرك ألاّ نتواصل معًا
إلى أن نرى سفينة ما؟

193
00:17:54,840 --> 00:17:59,080
...لماذا؟ كلّ هذا كنز

194
00:18:00,140 --> 00:18:04,650
من الغريب أنّه ليس بإمكاننا
.الأكل رغم كلّ ذلك المال

195
00:18:08,620 --> 00:18:12,760
...مهلًا... كان هذا الكيس ممتلئًا بالكنز

196
00:18:19,560 --> 00:18:22,530
!ما هذا؟! ما معنى هذا؟

197
00:18:22,870 --> 00:18:26,740
أين طعامك؟ ألم تأكل
أيّ شيء كلّ هذا الوقت؟

198
00:18:26,740 --> 00:18:28,740
!أخبرني! قل شيئًا

199
00:18:40,350 --> 00:18:42,180
ماذا حدث لساقك؟

200
00:18:52,760 --> 00:18:53,930
...حينها

201
00:18:58,170 --> 00:19:01,870
...لم يكن ذلك حُلمًا
...لكي تنقذ حياتي، فأنت

202
00:19:07,240 --> 00:19:10,710
ماذا عن الطّعام؟ هل أعطيتني
كلّ الطّعام الّذي كان معك؟

203
00:19:12,610 --> 00:19:13,650
.هذا صحيح

204
00:19:14,350 --> 00:19:18,620
بدون تلك السّاق، لن تستطيع
!أن تكون قرصانًا بعد الآن

205
00:19:18,620 --> 00:19:20,050
...ذلك صحيح

206
00:19:21,120 --> 00:19:24,290
!لماذا؟ لم أطلب مساعدتك

207
00:19:24,290 --> 00:19:27,700
لا أستطيع التّفكير في أيّ سبب
!قد يدفعك لتكون لطيفًا معي

208
00:19:29,400 --> 00:19:32,300
!لماذا؟ لماذا فعلتَ ذلك؟

209
00:19:32,300 --> 00:19:38,640
.لأنّك... تملك نفس حلمي

210
00:19:40,310 --> 00:19:41,810
...أول بلو

211
00:19:43,340 --> 00:19:47,250
لكن... حتّى رجالك قالوا
...أنّه غير موجود

212
00:19:47,250 --> 00:19:48,420
!بالطّبع هو موجود

213
00:19:49,020 --> 00:19:52,120
اتّجه صوب الغراند لاين
.عندما يحين الوقت المناسب

214
00:19:52,320 --> 00:19:55,060
.أول بلو موجود بالفعل

215
00:19:55,890 --> 00:19:59,430
،كما ترى، ما عدتُ أستطيع أن أكون قرصانًا

216
00:19:59,430 --> 00:20:02,130
لكن بإمكانك أنت الذّهاب
.وإيجاده هذه المرّة

217
00:20:04,300 --> 00:20:06,330
!مهلًا! لا تمت أيّها العجوز

218
00:20:06,630 --> 00:20:10,740
لا تفعل ما يحلو لك
!ولا تمت كما يحلو لك

219
00:20:11,970 --> 00:20:13,470
...أتساءل

220
00:20:15,370 --> 00:20:18,940
أتساءل كم مات من النّاس
...وهم يلعنون هذا البحر

221
00:20:18,940 --> 00:20:21,610
...هذا البحر الشّاسع

222
00:20:23,350 --> 00:20:27,850
سبق وواجهت أزمات كهذه
.حيث لم أجد ما آكله

223
00:20:27,850 --> 00:20:29,590
...وفي كلّ مرّة كنتُ أتمنّى

224
00:20:30,420 --> 00:20:34,690
لو كان هنالك مطعم
...في عرض البحر

225
00:20:34,690 --> 00:20:35,690
مطعم؟

226
00:20:35,690 --> 00:20:39,160
كنتُ أفكّر أنّه إن أمكنني مغادرة
،هذا المكان حيًّا

227
00:20:39,160 --> 00:20:44,070
...فسأبني مطعمًا كآخر أهداف حياتي

228
00:20:44,270 --> 00:20:48,170
.حسنًا، سأساعدك في هذا
!لذلك لا تمت

229
00:20:49,570 --> 00:20:52,840
ذلك مستحيل على شقيّ
!صغير ضعيف مثلك

230
00:20:52,840 --> 00:20:54,510
!سأصبح أقوى أيضًا

231
00:20:55,680 --> 00:20:58,450
!لذلك... لا تمت

232
00:21:13,600 --> 00:21:15,830
!إلى هنا

233
00:21:16,600 --> 00:21:20,500
!النّجدة! ساعدوا العجوز

234
00:21:20,870 --> 00:21:23,770
!ساعدوا العجوز اللّعين

235
00:21:26,740 --> 00:21:33,620
...أنا هنا! أنا هنا! أنا هنا

236
00:21:42,660 --> 00:21:49,130
تخلّى ذلك العجوز اللّعين
.عن ساقه لأعيش أنا

237
00:21:49,500 --> 00:21:50,770
!ماذا؟

238
00:21:53,100 --> 00:21:57,710
حتّى أنا... لا أستطيع ردّ جميل
العجوز اللّعين

239
00:21:57,710 --> 00:22:00,210
!إلاّ إذا خاطرتُ بحياتي من أجله أيضًا

240
00:22:06,080 --> 00:22:10,150
لماذا تقف يا سانجي-سان؟

241
00:22:12,220 --> 00:22:16,060
لكي يبقى هذا المكان مطعمًا
...لأطول فترة ممكنة

242
00:22:17,790 --> 00:22:20,000
ذلك الغبيّ... هل يحاول
التّسبّب في مقتله؟

243
00:22:23,400 --> 00:22:25,300
!شقيّ لعين

244
00:22:26,500 --> 00:22:29,470
.يا لها من جملة لبقة

245
00:22:29,470 --> 00:22:32,270
...لكنّ هذا المطعم سيُغلق الآن

246
00:22:32,870 --> 00:22:36,040
!وسيتحوّل لسفينة قراصنة

247
00:22:38,810 --> 00:22:41,420
!توقّف أيّها الغبيّ! لا تتورّط معهم

248
00:22:42,380 --> 00:22:43,880
!ما الّذي يحاول فعله؟

249
00:22:46,290 --> 00:22:49,560
...غومو غومو نوو

250
00:22:49,790 --> 00:22:51,560
!فأس المعركة

251
00:22:56,000 --> 00:23:10,240
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

252
00:23:10,240 --> 00:23:17,180
ولطالما بحثت عن ذلك المكان الإعجازيّ

253
00:23:17,180 --> 00:23:24,360
لكي لا يسبقني أحد آخر إليه

254
00:23:26,890 --> 00:23:38,370
إن كان العالم سيتغيّر

255
00:23:38,370 --> 00:23:45,380
قبل أن أحقّق حلمي

256
00:23:45,380 --> 00:23:52,450
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

257
00:23:52,450 --> 00:24:05,830
لكي لا تمحى ذكرياتي

258
00:24:11,470 --> 00:24:13,840
رغم أنّهم يصفون أنفسهم
،بأقوى قراصنة الأزرق الشّرقيّ

259
00:24:13,840 --> 00:24:15,910
.كان ذلك بسبب تعدادهم فحسب
أليس كذلك أيّها العمّ؟

260
00:24:15,910 --> 00:24:17,240
.أنت تتكلّم بصراحة كبيرة

261
00:24:17,240 --> 00:24:19,580
اسمع. يبدو أنّ غين لا يستطيع
.هزيمة سانجي أيضًا

262
00:24:19,580 --> 00:24:21,250
.ليس تمامًا

263
00:24:21,250 --> 00:24:23,910
ما تلك الأسلحة الّتي تبدو
مثل سِيَخ الدّانغو؟

264
00:24:23,910 --> 00:24:25,550
ألم يكن من رجاله؟

265
00:24:25,920 --> 00:24:27,480
:في الحلقة القادمة من ون بيس

266
00:24:27,480 --> 00:24:31,420
،الشّيطان الهادئ والقاسي"
".غين، قائد قوّات أسطول القراصنة

267
00:24:31,690 --> 00:24:33,890
!ملك القراصنة، لن يكون إلاّ أنا