1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:20,450 --> 00:02:22,770
!وصلتَ أخيرًا

29
00:02:24,430 --> 00:02:30,880
"عاد الشّيتشيبوكاي السّابق، "فارس البحر
!جينبي، إلى طاقم قبّعة القشّ أخيرًا

30
00:02:32,440 --> 00:02:35,420
،احتفالاً بصعود جينبي على متن سفينتنا

31
00:02:37,860 --> 00:02:38,840
!أجل

32
00:02:39,570 --> 00:02:44,600
بينما كان كينييمون والبقيّة يضعون
،خطّة لدخول أونيغاشيما

33
00:02:44,600 --> 00:02:48,930
كان طاقم قبّعة القشّ يتقدّمونهم
.ويهاجمون حصن العدوّ

34
00:02:57,130 --> 00:03:01,030
"!ورقة كايدو الرّابحة! ظهور التّوبي روبّو"

35
00:03:20,900 --> 00:03:22,760
...بوّابة توري هذه

36
00:03:22,760 --> 00:03:26,640
إنّها العقبة الأولى في طريقنا
.لنغير على أونيغاشيما

37
00:03:26,640 --> 00:03:29,660
عقبة؟ أهنالك حرّاس؟

38
00:03:29,660 --> 00:03:31,640
.ليس الحرّاس فحسب

39
00:03:31,640 --> 00:03:36,190
ثمّة أطنان من المدافع والأسلحة
.الأخرى مجهّزة هناك

40
00:03:36,190 --> 00:03:39,340
.إنّها أشبه بحصن صغير

41
00:03:41,130 --> 00:03:43,950
.كما أنّ اليوم هو مهرجان النّار

42
00:03:43,950 --> 00:03:47,470
.أتوقّع أنّ مجموعة من الجنود يقيمون وليمة

43
00:03:47,470 --> 00:03:51,870
حينها، ماذا لو تمّ إبلاغهم بالغارة؟

44
00:03:51,870 --> 00:03:55,390
.سنكون فريسة سهلة لهم إن تقدّمنا أكثر

45
00:03:55,390 --> 00:03:56,670
!ذلك ليس جيّدًا

46
00:03:56,670 --> 00:03:57,750
...في كلّ الأحوال

47
00:03:58,310 --> 00:04:01,010
!علينا إعلام الجميع بشأن هذا بسرعة

48
00:04:01,010 --> 00:04:05,530
لحسن الحظّ، يبدو أنّ الحرّاس
!في البوّابة لم يلاحظونا بعد

49
00:04:05,530 --> 00:04:07,140
...عفوًا

50
00:04:07,140 --> 00:04:13,190
ألم تكن هنالك سفينة متّجهة إلى هناك قبل قليل؟

51
00:04:13,190 --> 00:04:14,250
ماذا؟

52
00:04:17,900 --> 00:04:19,510
...مهلاً

53
00:04:19,880 --> 00:04:22,030
.سفينة قبّعة القشّ ليست هنا

54
00:04:23,090 --> 00:04:24,380
!ماذا؟

55
00:04:24,380 --> 00:04:27,180
!مستحيل! لوفي-دونو

56
00:04:27,680 --> 00:04:29,390
!هل لوفي-دونو هناك؟

57
00:04:29,390 --> 00:04:33,640
!لو-دونو! وجّه السّفينة إلى هناك
!علينا إنقاذهم في الحال

58
00:04:33,640 --> 00:04:35,980
!كلاّ، بإمكاني الوصول أبكر إن سبحت

59
00:04:35,980 --> 00:04:39,600
كاواماتسو-سان! من الخطير
...أن تذهب وحدك. سأذهب

60
00:04:39,600 --> 00:04:41,560
!لو-دونو! السّفينة، بسرعة

61
00:04:41,560 --> 00:04:43,110
!أنتم في طريقي

62
00:04:43,110 --> 00:04:46,590
...فاكهة المطّاط

63
00:04:47,240 --> 00:04:48,180
...أهذا

64
00:04:50,870 --> 00:04:53,600
...يا لهم من حمقى

65
00:04:53,600 --> 00:04:56,270
!يقومون دائمًا بما يناسبهم

66
00:05:00,250 --> 00:05:02,940
!مهلاً، ما الّذي تفعلونه؟
...أطيحوا به

67
00:05:10,910 --> 00:05:13,060
...الصّقر

68
00:05:14,910 --> 00:05:17,520
!الأحمر

69
00:05:51,260 --> 00:05:53,200
...الحرّاس عند بوّابة توري

70
00:05:53,760 --> 00:05:56,190
!قضي عليهم بالكامل

71
00:05:58,000 --> 00:06:02,270
!انظروا كم هنالك من أسلحة
...لو أنّنا هوجمنا بها

72
00:06:02,270 --> 00:06:06,910
...صحيح، أتساءل كم كنّا سنفقد من المحاربين

73
00:06:07,320 --> 00:06:10,590
بإمكاننا الذّهاب جميعًا، صحيح؟

74
00:06:14,660 --> 00:06:16,520
!إلى أونيغاشيما

75
00:06:18,080 --> 00:06:20,250
!حسنًا يا رفاق! أحسنتم

76
00:06:20,250 --> 00:06:21,230
.كان ذلك جيّدًا

77
00:06:21,230 --> 00:06:22,360
!أحسنتم

78
00:06:22,360 --> 00:06:24,690
!أبليتم حسنًا يا رفاق

79
00:06:24,690 --> 00:06:27,280
!كان عليكم المساعدة قليلاً

80
00:06:27,280 --> 00:06:29,970
...يا لهم من أوغاد

81
00:06:36,890 --> 00:06:40,640
...لكن لا يوجد أيّ ساكي

82
00:06:40,640 --> 00:06:42,750
.سأبحث عن القليل

83
00:06:42,750 --> 00:06:46,020
.حاسّة شمّك ليست جيّدة رغم أنّك طبّاخ

84
00:06:46,020 --> 00:06:50,200
.لم أكن مدركًا أنّ كرات الطّحالب لها أنوف

85
00:06:53,530 --> 00:06:54,470
.طبّاخ حقير

86
00:06:54,470 --> 00:06:55,320
.كرة طحالب غبيّة

87
00:06:55,320 --> 00:06:56,430
!طبّاخ رديء

88
00:06:56,430 --> 00:06:57,060
!رأس طحلب

89
00:06:57,060 --> 00:07:01,190
!لا أنف لديّ لأنّني هيكل عظميّ

90
00:07:01,190 --> 00:07:02,630
.نعلم ذلك

91
00:07:03,190 --> 00:07:08,530
لا أصدّق أنّ مئات الجنود قد سقطوا
...على يد حفنة منهم فحسب

92
00:07:08,530 --> 00:07:12,310
!إنّهم أقوياء للغاية

93
00:07:12,720 --> 00:07:14,280
،لكن في أحيان أخرى

94
00:07:14,280 --> 00:07:16,990
...قد يكونون مهملين جدًّا

95
00:07:16,990 --> 00:07:20,160
.كم يصعب فهمهم

96
00:07:23,060 --> 00:07:26,400
!إنّ وجودهم معنا لأمر مطمئن

97
00:07:26,690 --> 00:07:30,420
...التّعاون مع هؤلاء الأشخاص الرّائعين

98
00:07:30,770 --> 00:07:33,410
!هذا هو المتوقّع من كين-سان

99
00:07:34,070 --> 00:07:36,260
!يا لك من رجل

100
00:07:36,260 --> 00:07:38,500
!لوفي-دونو

101
00:07:58,160 --> 00:07:59,660
!هذا بارد

102
00:07:59,660 --> 00:08:02,830
!مهلاً! ألا يمكنك حمل برميل حتّى؟

103
00:08:02,830 --> 00:08:06,250
!لهذا السّبب أكره الشّرب معكم يا هؤلاء

104
00:08:19,410 --> 00:08:21,770
!أيّها الشّوغن-ساما

105
00:08:21,770 --> 00:08:24,350
.اتبع أصوات الكفوف المصفّقة

106
00:08:24,350 --> 00:08:27,060
!أنتنّ هناك! ها أنا قادم

107
00:08:33,710 --> 00:08:38,530
أيّها الشّوغن-ساما، أنت في مزاج
.جيّد اليوم على وجه الخصوص

108
00:08:38,530 --> 00:08:42,040
!صحيح! حدث أمر جيّد لك، صحيح؟

109
00:08:42,680 --> 00:08:44,930
كيف عرفتنّ؟

110
00:08:44,930 --> 00:08:47,920
!ماذا؟ ما هو؟

111
00:08:47,920 --> 00:08:53,800
...كانت هنالك خردة في طريقي دائمًا

112
00:08:53,800 --> 00:08:58,220
...لكنّني تخلّصت منها اليوم أخيرًا

113
00:08:58,860 --> 00:09:02,770
أنت سعيد لأنّك تخلّصت من بعض القمامة؟

114
00:09:02,770 --> 00:09:05,200
!الشّوغن-ساما غريب جدًّا

115
00:09:05,200 --> 00:09:06,400
!صحيح؟

116
00:09:07,410 --> 00:09:09,830
!هل أنا بتلك الغرابة؟

117
00:09:09,830 --> 00:09:11,420
!نعم، أنت كذلك

118
00:09:11,420 --> 00:09:13,750
!لكنّ ذلك ظريف نوعًا ما

119
00:09:13,750 --> 00:09:15,760
!صحيح؟

120
00:09:18,630 --> 00:09:20,870
!لماذا لا تقتربن أكثر؟

121
00:09:20,870 --> 00:09:26,120
!أنا شوغن بلاد وانو، كوروزومي أوروتشي

122
00:09:28,040 --> 00:09:29,740
!أنت

123
00:09:30,020 --> 00:09:32,150
!أريد المزيد من حساء الفاصولياء الحمراء

124
00:09:32,150 --> 00:09:33,760
!انتظر لحظة رجاءً

125
00:09:33,760 --> 00:09:36,530
...تريده بيغ مام الآن أيضًا

126
00:09:36,530 --> 00:09:38,590
بيغ مام؟

127
00:09:38,590 --> 00:09:40,640
وهل يهمّ ذلك؟

128
00:09:41,030 --> 00:09:44,520
.إنّها ليلة المهرجان الذّهبيّ السّنويّ

129
00:09:44,520 --> 00:09:48,310
.إنّه حدث ضخم حيث بالإمكان الرّقص والاستمتاع

130
00:09:48,310 --> 00:09:51,110
من في مركزه؟

131
00:09:51,940 --> 00:09:53,320
!كوين

132
00:09:53,320 --> 00:09:55,320
!نعم! أنا

133
00:09:55,320 --> 00:09:58,740
مَن مِن كبار النّجوم يحبّ الغناء والرّقص؟

134
00:09:59,200 --> 00:10:00,780
!كوين

135
00:10:00,780 --> 00:10:02,950
!نعم! أنا

136
00:10:02,950 --> 00:10:05,870
...وفوق ذلك، إن صرت أنحف، فسأكون

137
00:10:06,600 --> 00:10:08,580
.محبوبًا جدًّا

138
00:10:12,540 --> 00:10:16,130
إن كنت تفهم، فأعطني حساء
!الفاصولياء الحمراء أيّها المغفّل

139
00:10:33,500 --> 00:10:36,530
...ثمّة حماسة في كلّ مكان

140
00:10:36,530 --> 00:10:40,840
...هذا جيّد. هكذا يجب أن تكون الولائم

141
00:10:40,840 --> 00:10:44,550
!أجل! لا أطيق الانتظار حتّى رؤية العرض اللّيلة

142
00:10:44,550 --> 00:10:46,720
لكن ما الّذي يفعله؟

143
00:10:46,720 --> 00:10:47,580
من؟

144
00:10:47,580 --> 00:10:49,410
من في رأيك؟

145
00:10:49,410 --> 00:10:51,790
!أنا أتحدّث عن ابني

146
00:10:55,150 --> 00:10:57,880
!عليه أن يحضر! إنّها وليمة

147
00:10:57,880 --> 00:10:59,850
!سـ-سأذهب للبحث عنه

148
00:10:59,850 --> 00:11:01,090
!كايدو-ساما

149
00:11:01,090 --> 00:11:05,640
،وصل كلّ التّوبي روبّو السّتّة
!لذلك اسمح لهم بمقابلتك

150
00:11:05,640 --> 00:11:08,230
التّوبي روبّو؟

151
00:11:08,230 --> 00:11:13,860
،لا أذكر أنّني استدعيتهم
.لكن لا بأس، لنعرّفهم بلينلين

152
00:11:13,860 --> 00:11:15,730
إلى أين ذهبت؟

153
00:11:15,730 --> 00:11:21,970
.لكن... بيغ مام ذهبت لارتداء الكيمونو الآن

154
00:11:22,420 --> 00:11:26,240
!كايدو-ساما! وصل التّوبي روبّو

155
00:11:29,100 --> 00:11:30,540
!أدخلوهم

156
00:12:55,430 --> 00:12:57,460
اليوم يوم عاديّ لطالما انتظرناه

157
00:12:57,460 --> 00:12:59,460
ها هو ذا البطل براكيو

158
00:12:59,460 --> 00:13:02,800
...الطّاعون

159
00:13:07,930 --> 00:13:12,220
!كوين

160
00:13:16,060 --> 00:13:18,270
!شكرًا جميعًا على الانتظار

161
00:13:20,190 --> 00:13:22,820
!إنّه المهرجان الذّهبيّ السّنويّ

162
00:13:22,820 --> 00:13:25,610
!لنستمتع بوقتنا

163
00:13:28,870 --> 00:13:36,460
!زوم، زوم، زوم، زوم

164
00:13:36,460 --> 00:13:39,920
إن أصبحتُ أنحف، فسأكون محبوبًا جدًّا

165
00:13:39,920 --> 00:13:42,750
...لذلك لا أفقد وزني، وذلك ما أدعوه

166
00:13:42,750 --> 00:13:43,800
!فانك

167
00:13:47,300 --> 00:13:51,010
!زوم، زوم، زوم، زوم

168
00:13:51,010 --> 00:13:54,810
...قد أكون بدينًا، لكنّها كلّها عضلات

169
00:13:54,810 --> 00:13:57,560
...بإمكاني الغناء والرّقص، وذلك ما أدعوه

170
00:13:57,560 --> 00:13:58,480
!فانك

171
00:13:58,940 --> 00:14:03,150
!حسنًا يا أونيغاشيما

172
00:14:03,150 --> 00:14:05,400
!هل تستمتعون بوقتكم؟

173
00:14:06,990 --> 00:14:08,700
!هيّا ينا يا رفاق

174
00:14:08,700 --> 00:14:11,370
!سأرى من الحاضر هنا

175
00:14:11,370 --> 00:14:14,350
!اصرخوا من أعماقكم

176
00:14:16,710 --> 00:14:18,640
منتظرين اللّحظة حين يحين دوركم

177
00:14:18,640 --> 00:14:20,580
!هل سئمتم الانتظار أيّها المنتظرون؟

178
00:14:24,300 --> 00:14:26,520
خسرتم الرّهان، لكنّكم تضحكون الآن

179
00:14:26,520 --> 00:14:28,130
!اضحكوا فحسب أيّها المسرورون

180
00:14:32,050 --> 00:14:34,060
هديّة مفخمة، هديّة السمايل

181
00:14:34,060 --> 00:14:36,420
!هيّا أسمعوني زئيركم أيّها الموهوبون

182
00:14:39,940 --> 00:14:41,770
!"أصحاب القوّة الجوهريّة يُدعون "النّجوم

183
00:14:41,770 --> 00:14:43,720
!أنتم الأفضل يا رفاق

184
00:14:47,440 --> 00:14:49,500
والسّتّة الأفضل، ها قد أتى أولئك الأشدّاء

185
00:14:49,500 --> 00:14:52,570
بخطورتهم اللاّمحدودة وقوّتهم اللاّنهائيّة

186
00:14:52,570 --> 00:14:55,330
!التّوبي روبّو

187
00:15:05,600 --> 00:15:06,880
!أمزح فحسب

188
00:15:06,880 --> 00:15:10,180
!لم أسمعهم يردّون، أسمعتموهم؟

189
00:15:10,180 --> 00:15:13,010
،انسوا أمر أولئك الحمقى الوقحين
!انسوا، انسوا، انسوا

190
00:15:13,010 --> 00:15:15,140
!والآن دور الوحوش

191
00:15:15,140 --> 00:15:17,140
!الأرقام

192
00:15:24,500 --> 00:15:26,370
!إنّهم في كلّ مكان

193
00:15:26,370 --> 00:15:27,530
من يهتمّ؟

194
00:15:27,530 --> 00:15:29,820
!والآن دور رجال أوروتشي! هيّا بنا

195
00:15:29,820 --> 00:15:32,950
!أوّلاً، فرقة السّاموراي، الميماواري-غومي

196
00:15:33,670 --> 00:15:36,390
!أونيوابانشو

197
00:15:37,590 --> 00:15:40,620
!إنّه يناديك يا فوكوروكوجو

198
00:15:40,620 --> 00:15:43,540
أليس عليك الذّهاب؟

199
00:15:43,540 --> 00:15:45,000
.بربّك

200
00:15:45,000 --> 00:15:49,610
...إنّ واجبي هو حمايتك في كلّ الأوقات

201
00:15:49,610 --> 00:15:51,840
!لا تكن رسميًّا كثيرًا

202
00:15:51,840 --> 00:15:54,800
،وفق استراتيجيّتي المثاليّة

203
00:15:54,800 --> 00:15:56,970
!مات الأكازايا

204
00:15:56,970 --> 00:16:00,530
!ما عاد هنالك ما يدعو للخوف

205
00:16:00,530 --> 00:16:03,140
!اليوم هو مهرجان النّار! استرخوا

206
00:16:03,140 --> 00:16:06,940
!استمتعوا به حتّى إن قُتلتم يا رفاق

207
00:16:10,250 --> 00:16:13,850
!استمتعوا أو موتوا

208
00:16:15,880 --> 00:16:19,330
إضافة لذلك، لدينا بعض الضّيوف
!المميّزين هذه السّنة

209
00:16:19,330 --> 00:16:22,000
!سمعتُ أنّهم قريبون بالفعل

210
00:16:22,000 --> 00:16:22,890
!ماذا؟

211
00:16:22,890 --> 00:16:25,640
!إنّهم أبناء بيغ مام

212
00:16:29,690 --> 00:16:32,340
.يأبى كوين أن يصمت-أرينسو

213
00:16:32,920 --> 00:16:37,050
!هل سمعتموه يصف التّوبي روبّو بالوقحين-أرينسو؟

214
00:16:37,050 --> 00:16:41,600
...كفّي عن إنهاء جملك بتلك العبارة
!أهذا ما تفعلينه الآن؟

215
00:16:41,600 --> 00:16:42,830
...كم هذا محرج

216
00:16:42,830 --> 00:16:48,110
.بربّك يا بي-تان، أنت خجول جدًّا-أرينسو

217
00:16:46,060 --> 00:16:48,110
!لا تنادني بي-تان

218
00:16:50,210 --> 00:16:53,190
،إن مات كوين

219
00:16:53,710 --> 00:16:57,570
من تظنّون سيصبح أحد كبار النّجوم مكانه؟

220
00:16:58,010 --> 00:17:02,230
أتظنّ أنّه سيكون أنت؟

221
00:17:03,100 --> 00:17:07,060
.لستُ مهتمًّا أن أصبح من كبار النّجوم

222
00:17:07,060 --> 00:17:12,740
.سأقدّر إن انسحبتَ من هذه المنافسة

223
00:17:12,860 --> 00:17:15,840
،بي-تان، لا يمكنك المنافسة أيضًا
صحيح؟ ستنسحب؟

224
00:17:16,440 --> 00:17:22,040
.فقد تركت ذلك المدعوّ مقنّع السّوبا بالهرب

225
00:17:23,560 --> 00:17:25,350
!اسمع يا هذا

226
00:17:25,350 --> 00:17:29,710
!إن عبثت مع بي-تان، فسأوسعك ضربًا يا ساساكي

227
00:17:29,710 --> 00:17:31,860
!توقّفي يا أختي الكبيرة

228
00:17:31,860 --> 00:17:33,250
!أأمرتني بالتّوقّف؟

229
00:17:33,250 --> 00:17:34,440
!لا تغضبي عليّ

230
00:17:34,440 --> 00:17:36,820
...أقلت ألاّ أغضب عليك؟! أيّها الـ

231
00:17:37,360 --> 00:17:39,930
.أنتما تزعجانني أيّها الشّقيّان

232
00:17:39,930 --> 00:17:43,140
.ماذا؟ إنّهما ظريفان نوعًا ما

233
00:17:44,390 --> 00:17:48,540
.أول-تشان الّتي تغضب على كلّ شيء المفضّلة عندي

234
00:17:48,540 --> 00:17:53,090
لا يهمّ كم أخبرها أن تختار على
.من تغضب، فهي لا تدرك ذلك

235
00:17:53,090 --> 00:17:54,440
.ليست ظريفة إطلاقًا

236
00:17:54,440 --> 00:17:57,110
!أنا ظريفة

237
00:17:57,110 --> 00:17:59,090
...هذا يكفي

238
00:17:59,090 --> 00:18:00,720
...حسنًا

239
00:18:00,720 --> 00:18:04,100
لماذا تمّ استدعاؤنا وتركنا ننتظر؟

240
00:18:04,100 --> 00:18:08,770
طرأ عمل عاجل! عندما يقول
،كايدو-سان أنّ الأمر مهمّ

241
00:18:08,770 --> 00:18:11,730
...فإنّه نفس الموضوع دائمًا

242
00:18:15,790 --> 00:18:18,950
أهي مسألة عائليّة ثانية-أرينسو؟

243
00:18:25,800 --> 00:18:27,370
هل كايدو غبيّ؟

244
00:18:27,370 --> 00:18:29,460
!لا تغضبي عليه

245
00:18:34,840 --> 00:18:39,990
!يا كينييمون! عثرنا على العدوّ

246
00:18:41,820 --> 00:18:44,010
ألحق بنا الجميع؟

247
00:18:45,350 --> 00:18:47,510
!يا رأس الطّحلب

248
00:18:47,510 --> 00:18:49,350
من أين حصلت على ذلك؟

249
00:18:49,350 --> 00:18:51,690
!وجدتَ ساكي يا زورو

250
00:18:52,460 --> 00:18:55,480
.أخبرتكم أنّ بإمكاني إيجاده من رائحته

251
00:18:55,480 --> 00:18:57,280
...إنّها غريزته

252
00:18:57,280 --> 00:19:01,360
.كلّ ما يفكّر فيه هو السّاكي والسّيوف

253
00:19:01,360 --> 00:19:05,870
!كلّ شيء جاهز

254
00:19:10,680 --> 00:19:15,500
!لوفي! سنشرب بدونك إن لم تأتِ بسرعة

255
00:19:15,500 --> 00:19:16,550
.زورو سيفعل

256
00:19:16,550 --> 00:19:17,840
!لن أشرب

257
00:19:17,840 --> 00:19:19,170
!حسنًا

258
00:19:19,170 --> 00:19:21,010
.تفضّل أيّها الزّعيم-سان

259
00:19:21,890 --> 00:19:23,470
.شكرًا لك

260
00:19:27,870 --> 00:19:31,630
.أتمنّى لو كان لدينا وقت لنغنّي أغنية

261
00:19:33,750 --> 00:19:38,040
لم أتشارك كأس ساكي في مزاج
.جيّد كهذا من قبل

262
00:19:38,040 --> 00:19:39,780
.جينبي

263
00:19:42,760 --> 00:19:44,120
!كنّا في انتظارك

264
00:19:45,090 --> 00:19:46,630
!نعم

265
00:19:46,630 --> 00:19:53,360
!لا أطيق الانتظار حتّى أبحر برفقتكم جميعًا أيضًا

266
00:19:55,100 --> 00:19:57,880
!حسنًا! هل أنتم جاهزون؟

267
00:19:57,880 --> 00:19:58,770
!يا رفاق

268
00:19:58,770 --> 00:20:00,380
!أجل

269
00:20:03,490 --> 00:20:07,600
...احتفالاً بانضمام

270
00:20:07,600 --> 00:20:11,520
...جينبي على متن سفينتنا

271
00:20:11,520 --> 00:20:13,730
!شكرًا لك يا لوفي-دونو

272
00:20:14,290 --> 00:20:17,190
...اخترقتم الحاجز الأوّل بسرعة

273
00:20:14,940 --> 00:20:15,650
ما هذا؟

274
00:20:17,580 --> 00:20:20,070
!أقدّر لكم ذلك

275
00:20:29,180 --> 00:20:31,790
!ماذا؟! الحيويّة تملأ الجميع

276
00:20:31,790 --> 00:20:36,140
لا بدّ أنّ إسقاط هذا الحصن
!قد عزّز معنويّات الجميع

277
00:20:36,140 --> 00:20:39,600
.سيصلون إلى أونيغاشيما بسرعة كبيرة

278
00:20:47,990 --> 00:20:53,200
لن نضيّع هذه الفرصة الّتي منحنا
!إيّاها لوفيتارو والبقيّة

279
00:20:53,200 --> 00:20:56,190
!نعم! لن نسمح لعدوّنا بالتّأهّب

280
00:20:56,190 --> 00:20:59,920
!يُعتمد على طاقم قبّعة القشّ فعلاً

281
00:20:59,920 --> 00:21:01,190
!صحيح

282
00:21:01,190 --> 00:21:08,060
،مذ أن قابلت ذلك الفتى
!لم ينفكّ عن تغيير اليأس لأمل

283
00:21:09,490 --> 00:21:11,450
!يا ساموراي كوزكي

284
00:21:11,930 --> 00:21:14,120
!أيّها المحاربون المخلصون

285
00:21:14,910 --> 00:21:16,460
!اتبعوني

286
00:21:16,700 --> 00:21:18,920
!كلّ السّفن إلى أونيغاشيما

287
00:21:25,130 --> 00:21:27,140
!اندفعوا

288
00:21:46,110 --> 00:21:47,740
ماذا تفعل؟

289
00:21:50,630 --> 00:21:52,200
.لوفي

290
00:21:52,200 --> 00:21:53,620
!يا لوفي

291
00:21:53,620 --> 00:21:54,400
.لنتوقّف

292
00:21:54,420 --> 00:21:54,910
ماذا؟

293
00:21:56,220 --> 00:21:57,980
!لنقم بهذا معهم

294
00:21:58,430 --> 00:22:00,750
!وليمة ونخب

295
00:22:02,250 --> 00:22:05,320
!بعد أن نطيح بكايدو

296
00:22:05,840 --> 00:22:09,220
!وإيساع بيغ مام وأوروتشي ضربًا

297
00:22:09,220 --> 00:22:11,720
،بعد أن ننتصر في هذه المعركة

298
00:22:11,720 --> 00:22:14,770
...فسنقيم أكبر

299
00:22:15,740 --> 00:22:18,600
!وليمة على الإطلاق

300
00:22:25,650 --> 00:22:27,340
!إنّك مندفع دائمًا

301
00:22:27,340 --> 00:22:29,510
.نامي-سان محقّة

302
00:22:29,510 --> 00:22:30,470
فعلاً؟

303
00:22:30,470 --> 00:22:34,970
.حسنًا، لطالما كان الأمر هكذا
.سنضيّع الوقت بالشّكوى لا غير

304
00:22:34,970 --> 00:22:36,260
!نعم، نعم

305
00:22:36,260 --> 00:22:38,640
!لا يحقّ لك أن تومئ برأسك

306
00:22:38,640 --> 00:22:40,830
،نحن لا نمانع ذلك

307
00:22:40,830 --> 00:22:43,820
لكن ماذا عنك أيّها الزّعيم-سان؟

308
00:22:46,060 --> 00:22:48,720
!تعرفون إجابتي

309
00:22:50,840 --> 00:22:54,850
!أنا معكم

310
00:22:59,520 --> 00:23:01,600
!هيّا بنا يا رفاق

311
00:23:01,600 --> 00:23:04,580
!اتبعوا السّاموراي

312
00:23:04,580 --> 00:23:07,820
!حاضر يا قبطان

313
00:23:18,140 --> 00:23:22,750
أونيغاشيما معقل لجمجمة ضخمة
!تنذر بالشّؤم بشكل كبير

314
00:23:22,750 --> 00:23:29,760
انطلق كلّ الأكازايا إلى ساحة المعركة
!حاملين أماني أودن في قلوبهم

315
00:23:29,760 --> 00:23:36,470
بعد تفاديهم لعدّة عقبات، لم يعد
!للسّاموراي من تراجع وبدؤوا التّسلّل

316
00:23:36,470 --> 00:23:37,640
:في الحلقة القادمة من وان بيس

317
00:23:37,640 --> 00:23:41,640
!جدّيّة محاربي السّاموراي"
"!نزول طاقم قبّعة القشّ في أونيغاشيما

318
00:23:41,640 --> 00:23:45,650
!ملك القراصنة، لن يكون إلاّ أنا