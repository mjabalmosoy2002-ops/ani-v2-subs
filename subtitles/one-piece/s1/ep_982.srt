1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:06,450 --> 00:02:08,770
!وصلتَ أخيرًا

29
00:02:10,430 --> 00:02:16,880
"عاد الشّيتشيبوكاي السّابق، "فارس البحر
!جينبي، إلى طاقم قبّعة القشّ أخيرًا

30
00:02:18,440 --> 00:02:21,420
،احتفالاً بصعود جينبي على متن سفينتنا

31
00:02:23,860 --> 00:02:24,840
!أجل

32
00:02:25,570 --> 00:02:30,600
بينما كان كينييمون والبقيّة يضعون
،خطّة لدخول أونيغاشيما

33
00:02:30,600 --> 00:02:34,930
كان طاقم قبّعة القشّ يتقدّمونهم
.ويهاجمون حصن العدوّ

34
00:02:43,130 --> 00:02:47,030
"!ورقة كايدو الرّابحة! ظهور التّوبي روبّو"

35
00:03:06,900 --> 00:03:08,760
...بوّابة توري هذه

36
00:03:08,760 --> 00:03:12,640
إنّها العقبة الأولى في طريقنا
.لنغير على أونيغاشيما

37
00:03:12,640 --> 00:03:15,660
عقبة؟ أهنالك حرّاس؟

38
00:03:15,660 --> 00:03:17,640
.ليس الحرّاس فحسب

39
00:03:17,640 --> 00:03:22,190
ثمّة أطنان من المدافع والأسلحة
.الأخرى مجهّزة هناك

40
00:03:22,190 --> 00:03:25,340
.إنّها أشبه بحصن صغير

41
00:03:27,130 --> 00:03:29,950
.كما أنّ اليوم هو مهرجان النّار

42
00:03:29,950 --> 00:03:33,470
.أتوقّع أنّ مجموعة من الجنود يقيمون وليمة

43
00:03:33,470 --> 00:03:37,870
حينها، ماذا لو تمّ إبلاغهم بالغارة؟

44
00:03:37,870 --> 00:03:41,390
.سنكون فريسة سهلة لهم إن تقدّمنا أكثر

45
00:03:41,390 --> 00:03:42,670
!ذلك ليس جيّدًا

46
00:03:42,670 --> 00:03:43,750
...في كلّ الأحوال

47
00:03:44,310 --> 00:03:47,010
!علينا إعلام الجميع بشأن هذا بسرعة

48
00:03:47,010 --> 00:03:51,530
لحسن الحظّ، يبدو أنّ الحرّاس
!في البوّابة لم يلاحظونا بعد

49
00:03:51,530 --> 00:03:53,140
...عفوًا

50
00:03:53,140 --> 00:03:59,190
ألم تكن هنالك سفينة متّجهة إلى هناك قبل قليل؟

51
00:03:59,190 --> 00:04:00,250
ماذا؟

52
00:04:03,900 --> 00:04:05,510
...مهلاً

53
00:04:05,880 --> 00:04:08,030
.سفينة قبّعة القشّ ليست هنا

54
00:04:09,090 --> 00:04:10,380
!ماذا؟

55
00:04:10,380 --> 00:04:13,180
!مستحيل! لوفي-دونو

56
00:04:13,680 --> 00:04:15,390
!هل لوفي-دونو هناك؟

57
00:04:15,390 --> 00:04:19,640
!لو-دونو! وجّه السّفينة إلى هناك
!علينا إنقاذهم في الحال

58
00:04:19,640 --> 00:04:21,980
!كلاّ، بإمكاني الوصول أبكر إن سبحت

59
00:04:21,980 --> 00:04:25,600
كاواماتسو-سان! من الخطير
...أن تذهب وحدك. سأذهب

60
00:04:25,600 --> 00:04:27,560
!لو-دونو! السّفينة، بسرعة

61
00:04:27,560 --> 00:04:29,110
!أنتم في طريقي

62
00:04:29,110 --> 00:04:32,590
...فاكهة المطّاط

63
00:04:33,240 --> 00:04:34,180
...أهذا

64
00:04:36,870 --> 00:04:39,600
...يا لهم من حمقى

65
00:04:39,600 --> 00:04:42,270
!يقومون دائمًا بما يناسبهم

66
00:04:46,250 --> 00:04:48,940
!مهلاً، ما الّذي تفعلونه؟
...أطيحوا به

67
00:04:56,910 --> 00:04:59,060
...الصّقر

68
00:05:00,910 --> 00:05:03,520
!الأحمر

69
00:05:37,260 --> 00:05:39,200
...الحرّاس عند بوّابة توري

70
00:05:39,760 --> 00:05:42,190
!قضي عليهم بالكامل

71
00:05:44,000 --> 00:05:48,270
!انظروا كم هنالك من أسلحة
...لو أنّنا هوجمنا بها

72
00:05:48,270 --> 00:05:52,910
...صحيح، أتساءل كم كنّا سنفقد من المحاربين

73
00:05:53,320 --> 00:05:56,590
بإمكاننا الذّهاب جميعًا، صحيح؟

74
00:06:00,660 --> 00:06:02,520
!إلى أونيغاشيما

75
00:06:04,080 --> 00:06:06,250
!حسنًا يا رفاق! أحسنتم

76
00:06:06,250 --> 00:06:07,230
.كان ذلك جيّدًا

77
00:06:07,230 --> 00:06:08,360
!أحسنتم

78
00:06:08,360 --> 00:06:10,690
!أبليتم حسنًا يا رفاق

79
00:06:10,690 --> 00:06:13,280
!كان عليكم المساعدة قليلاً

80
00:06:13,280 --> 00:06:15,970
...يا لهم من أوغاد

81
00:06:22,890 --> 00:06:26,640
...لكن لا يوجد أيّ ساكي

82
00:06:26,640 --> 00:06:28,750
.سأبحث عن القليل

83
00:06:28,750 --> 00:06:32,020
.حاسّة شمّك ليست جيّدة رغم أنّك طبّاخ

84
00:06:32,020 --> 00:06:36,200
.لم أكن مدركًا أنّ كرات الطّحالب لها أنوف

85
00:06:39,530 --> 00:06:40,470
.طبّاخ حقير

86
00:06:40,470 --> 00:06:41,320
.كرة طحالب غبيّة

87
00:06:41,320 --> 00:06:42,430
!طبّاخ رديء

88
00:06:42,430 --> 00:06:43,060
!رأس طحلب

89
00:06:43,060 --> 00:06:47,190
!لا أنف لديّ لأنّني هيكل عظميّ

90
00:06:47,190 --> 00:06:48,630
.نعلم ذلك

91
00:06:49,190 --> 00:06:54,530
لا أصدّق أنّ مئات الجنود قد سقطوا
...على يد حفنة منهم فحسب

92
00:06:54,530 --> 00:06:58,310
!إنّهم أقوياء للغاية

93
00:06:58,720 --> 00:07:00,280
،لكن في أحيان أخرى

94
00:07:00,280 --> 00:07:02,990
...قد يكونون مهملين جدًّا

95
00:07:02,990 --> 00:07:06,160
.كم يصعب فهمهم

96
00:07:09,060 --> 00:07:12,400
!إنّ وجودهم معنا لأمر مطمئن

97
00:07:12,690 --> 00:07:16,420
...التّعاون مع هؤلاء الأشخاص الرّائعين

98
00:07:16,770 --> 00:07:19,410
!هذا هو المتوقّع من كين-سان

99
00:07:20,070 --> 00:07:22,260
!يا لك من رجل

100
00:07:22,260 --> 00:07:24,500
!لوفي-دونو

101
00:07:44,160 --> 00:07:45,660
!هذا بارد

102
00:07:45,660 --> 00:07:48,830
!مهلاً! ألا يمكنك حمل برميل حتّى؟

103
00:07:48,830 --> 00:07:52,250
!لهذا السّبب أكره الشّرب معكم يا هؤلاء

104
00:08:05,410 --> 00:08:07,770
!أيّها الشّوغن-ساما

105
00:08:07,770 --> 00:08:10,350
.اتبع أصوات الكفوف المصفّقة

106
00:08:10,350 --> 00:08:13,060
!أنتنّ هناك! ها أنا قادم

107
00:08:19,710 --> 00:08:24,530
أيّها الشّوغن-ساما، أنت في مزاج
.جيّد اليوم على وجه الخصوص

108
00:08:24,530 --> 00:08:28,040
!صحيح! حدث أمر جيّد لك، صحيح؟

109
00:08:28,680 --> 00:08:30,930
كيف عرفتنّ؟

110
00:08:30,930 --> 00:08:33,920
!ماذا؟ ما هو؟

111
00:08:33,920 --> 00:08:39,800
...كانت هنالك خردة في طريقي دائمًا

112
00:08:39,800 --> 00:08:44,220
...لكنّني تخلّصت منها اليوم أخيرًا

113
00:08:44,860 --> 00:08:48,770
أنت سعيد لأنّك تخلّصت من بعض القمامة؟

114
00:08:48,770 --> 00:08:51,200
!الشّوغن-ساما غريب جدًّا

115
00:08:51,200 --> 00:08:52,400
!صحيح؟

116
00:08:53,410 --> 00:08:55,830
!هل أنا بتلك الغرابة؟

117
00:08:55,830 --> 00:08:57,420
!نعم، أنت كذلك

118
00:08:57,420 --> 00:08:59,750
!لكنّ ذلك ظريف نوعًا ما

119
00:08:59,750 --> 00:09:01,760
!صحيح؟

120
00:09:04,630 --> 00:09:06,870
!لماذا لا تقتربن أكثر؟

121
00:09:06,870 --> 00:09:12,120
!أنا شوغن بلاد وانو، كوروزومي أوروتشي

122
00:09:14,040 --> 00:09:15,740
!أنت

123
00:09:16,020 --> 00:09:18,150
!أريد المزيد من حساء الفاصولياء الحمراء

124
00:09:18,150 --> 00:09:19,760
!انتظر لحظة رجاءً

125
00:09:19,760 --> 00:09:22,530
...تريده بيغ مام الآن أيضًا

126
00:09:22,530 --> 00:09:24,590
بيغ مام؟

127
00:09:24,590 --> 00:09:26,640
وهل يهمّ ذلك؟

128
00:09:27,030 --> 00:09:30,520
.إنّها ليلة المهرجان الذّهبيّ السّنويّ

129
00:09:30,520 --> 00:09:34,310
.إنّه حدث ضخم حيث بالإمكان الرّقص والاستمتاع

130
00:09:34,310 --> 00:09:37,110
من في مركزه؟

131
00:09:37,940 --> 00:09:39,320
!كوين

132
00:09:39,320 --> 00:09:41,320
!نعم! أنا

133
00:09:41,320 --> 00:09:44,740
مَن مِن كبار النّجوم يحبّ الغناء والرّقص؟

134
00:09:45,200 --> 00:09:46,780
!كوين

135
00:09:46,780 --> 00:09:48,950
!نعم! أنا

136
00:09:48,950 --> 00:09:51,870
...وفوق ذلك، إن صرت أنحف، فسأكون

137
00:09:52,600 --> 00:09:54,580
.محبوبًا جدًّا

138
00:09:58,540 --> 00:10:02,130
إن كنت تفهم، فأعطني حساء
!الفاصولياء الحمراء أيّها المغفّل

139
00:10:19,500 --> 00:10:22,530
...ثمّة حماسة في كلّ مكان

140
00:10:22,530 --> 00:10:26,840
...هذا جيّد. هكذا يجب أن تكون الولائم

141
00:10:26,840 --> 00:10:30,550
!أجل! لا أطيق الانتظار حتّى رؤية العرض اللّيلة

142
00:10:30,550 --> 00:10:32,720
لكن ما الّذي يفعله؟

143
00:10:32,720 --> 00:10:33,580
من؟

144
00:10:33,580 --> 00:10:35,410
من في رأيك؟

145
00:10:35,410 --> 00:10:37,790
!أنا أتحدّث عن ابني

146
00:10:41,150 --> 00:10:43,880
!عليه أن يحضر! إنّها وليمة

147
00:10:43,880 --> 00:10:45,850
!سـ-سأذهب للبحث عنه

148
00:10:45,850 --> 00:10:47,090
!كايدو-ساما

149
00:10:47,090 --> 00:10:51,640
،وصل كلّ التّوبي روبّو السّتّة
!لذلك اسمح لهم بمقابلتك

150
00:10:51,640 --> 00:10:54,230
التّوبي روبّو؟

151
00:10:54,230 --> 00:10:59,860
،لا أذكر أنّني استدعيتهم
.لكن لا بأس، لنعرّفهم بلينلين

152
00:10:59,860 --> 00:11:01,730
إلى أين ذهبت؟

153
00:11:01,730 --> 00:11:07,970
.لكن... بيغ مام ذهبت لارتداء الكيمونو الآن

154
00:11:08,420 --> 00:11:12,240
!كايدو-ساما! وصل التّوبي روبّو

155
00:11:15,100 --> 00:11:16,540
!أدخلوهم

156
00:12:41,430 --> 00:12:43,460
اليوم يوم عاديّ لطالما انتظرناه

157
00:12:43,460 --> 00:12:45,460
ها هو ذا البطل براكيو

158
00:12:45,460 --> 00:12:48,800
...الطّاعون

159
00:12:53,930 --> 00:12:58,220
!كوين

160
00:13:02,060 --> 00:13:04,270
!شكرًا جميعًا على الانتظار

161
00:13:06,190 --> 00:13:08,820
!إنّه المهرجان الذّهبيّ السّنويّ

162
00:13:08,820 --> 00:13:11,610
!لنستمتع بوقتنا

163
00:13:14,870 --> 00:13:22,460
!زوم، زوم، زوم، زوم

164
00:13:22,460 --> 00:13:25,920
إن أصبحتُ أنحف، فسأكون محبوبًا جدًّا

165
00:13:25,920 --> 00:13:28,750
...لذلك لا أفقد وزني، وذلك ما أدعوه

166
00:13:28,750 --> 00:13:29,800
!فانك

167
00:13:33,300 --> 00:13:37,010
!زوم، زوم، زوم، زوم

168
00:13:37,010 --> 00:13:40,810
...قد أكون بدينًا، لكنّها كلّها عضلات

169
00:13:40,810 --> 00:13:43,560
...بإمكاني الغناء والرّقص، وذلك ما أدعوه

170
00:13:43,560 --> 00:13:44,480
!فانك

171
00:13:44,940 --> 00:13:49,150
!حسنًا يا أونيغاشيما

172
00:13:49,150 --> 00:13:51,400
!هل تستمتعون بوقتكم؟

173
00:13:52,990 --> 00:13:54,700
!هيّا ينا يا رفاق

174
00:13:54,700 --> 00:13:57,370
!سأرى من الحاضر هنا

175
00:13:57,370 --> 00:14:00,350
!اصرخوا من أعماقكم

176
00:14:02,710 --> 00:14:04,640
منتظرين اللّحظة حين يحين دوركم

177
00:14:04,640 --> 00:14:06,580
!هل سئمتم الانتظار أيّها المنتظرون؟

178
00:14:10,300 --> 00:14:12,520
خسرتم الرّهان، لكنّكم تضحكون الآن

179
00:14:12,520 --> 00:14:14,130
!اضحكوا فحسب أيّها المسرورون

180
00:14:18,050 --> 00:14:20,060
هديّة مفخمة، هديّة السمايل

181
00:14:20,060 --> 00:14:22,420
!هيّا أسمعوني زئيركم أيّها الموهوبون

182
00:14:25,940 --> 00:14:27,770
!"أصحاب القوّة الجوهريّة يُدعون "النّجوم

183
00:14:27,770 --> 00:14:29,720
!أنتم الأفضل يا رفاق

184
00:14:33,440 --> 00:14:35,500
والسّتّة الأفضل، ها قد أتى أولئك الأشدّاء

185
00:14:35,500 --> 00:14:38,570
بخطورتهم اللاّمحدودة وقوّتهم اللاّنهائيّة

186
00:14:38,570 --> 00:14:41,330
!التّوبي روبّو

187
00:14:51,600 --> 00:14:52,880
!أمزح فحسب

188
00:14:52,880 --> 00:14:56,180
!لم أسمعهم يردّون، أسمعتموهم؟

189
00:14:56,180 --> 00:14:59,010
،انسوا أمر أولئك الحمقى الوقحين
!انسوا، انسوا، انسوا

190
00:14:59,010 --> 00:15:01,140
!والآن دور الوحوش

191
00:15:01,140 --> 00:15:03,140
!الأرقام

192
00:15:10,500 --> 00:15:12,370
!إنّهم في كلّ مكان

193
00:15:12,370 --> 00:15:13,530
من يهتمّ؟

194
00:15:13,530 --> 00:15:15,820
!والآن دور رجال أوروتشي! هيّا بنا

195
00:15:15,820 --> 00:15:18,950
!أوّلاً، فرقة السّاموراي، الميماواري-غومي

196
00:15:19,670 --> 00:15:22,390
!أونيوابانشو

197
00:15:23,590 --> 00:15:26,620
!إنّه يناديك يا فوكوروكوجو

198
00:15:26,620 --> 00:15:29,540
أليس عليك الذّهاب؟

199
00:15:29,540 --> 00:15:31,000
.بربّك

200
00:15:31,000 --> 00:15:35,610
...إنّ واجبي هو حمايتك في كلّ الأوقات

201
00:15:35,610 --> 00:15:37,840
!لا تكن رسميًّا كثيرًا

202
00:15:37,840 --> 00:15:40,800
،وفق استراتيجيّتي المثاليّة

203
00:15:40,800 --> 00:15:42,970
!مات الأكازايا

204
00:15:42,970 --> 00:15:46,530
!ما عاد هنالك ما يدعو للخوف

205
00:15:46,530 --> 00:15:49,140
!اليوم هو مهرجان النّار! استرخوا

206
00:15:49,140 --> 00:15:52,940
!استمتعوا به حتّى إن قُتلتم يا رفاق

207
00:15:56,250 --> 00:15:59,850
!استمتعوا أو موتوا

208
00:16:01,880 --> 00:16:05,330
إضافة لذلك، لدينا بعض الضّيوف
!المميّزين هذه السّنة

209
00:16:05,330 --> 00:16:08,000
!سمعتُ أنّهم قريبون بالفعل

210
00:16:08,000 --> 00:16:08,890
!ماذا؟

211
00:16:08,890 --> 00:16:11,640
!إنّهم أبناء بيغ مام

212
00:16:15,690 --> 00:16:18,340
.يأبى كوين أن يصمت-أرينسو

213
00:16:18,920 --> 00:16:23,050
!هل سمعتموه يصف التّوبي روبّو بالوقحين-أرينسو؟

214
00:16:23,050 --> 00:16:27,600
...كفّي عن إنهاء جملك بتلك العبارة
!أهذا ما تفعلينه الآن؟

215
00:16:27,600 --> 00:16:28,830
...كم هذا محرج

216
00:16:28,830 --> 00:16:34,110
.بربّك يا بي-تان، أنت خجول جدًّا-أرينسو

217
00:16:32,060 --> 00:16:34,110
!لا تنادني بي-تان

218
00:16:36,210 --> 00:16:39,190
،إن مات كوين

219
00:16:39,710 --> 00:16:43,570
من تظنّون سيصبح أحد كبار النّجوم مكانه؟

220
00:16:44,010 --> 00:16:48,230
أتظنّ أنّه سيكون أنت؟

221
00:16:49,100 --> 00:16:53,060
.لستُ مهتمًّا أن أصبح من كبار النّجوم

222
00:16:53,060 --> 00:16:58,740
.سأقدّر إن انسحبتَ من هذه المنافسة

223
00:16:58,860 --> 00:17:01,840
،بي-تان، لا يمكنك المنافسة أيضًا
صحيح؟ ستنسحب؟

224
00:17:02,440 --> 00:17:08,040
.فقد تركت ذلك المدعوّ مقنّع السّوبا بالهرب

225
00:17:09,560 --> 00:17:11,350
!اسمع يا هذا

226
00:17:11,350 --> 00:17:15,710
!إن عبثت مع بي-تان، فسأوسعك ضربًا يا ساساكي

227
00:17:15,710 --> 00:17:17,860
!توقّفي يا أختي الكبيرة

228
00:17:17,860 --> 00:17:19,250
!أأمرتني بالتّوقّف؟

229
00:17:19,250 --> 00:17:20,440
!لا تغضبي عليّ

230
00:17:20,440 --> 00:17:22,820
...أقلت ألاّ أغضب عليك؟! أيّها الـ

231
00:17:23,360 --> 00:17:25,930
.أنتما تزعجانني أيّها الشّقيّان

232
00:17:25,930 --> 00:17:29,140
.ماذا؟ إنّهما ظريفان نوعًا ما

233
00:17:30,390 --> 00:17:34,540
.أول-تشان الّتي تغضب على كلّ شيء المفضّلة عندي

234
00:17:34,540 --> 00:17:39,090
لا يهمّ كم أخبرها أن تختار على
.من تغضب، فهي لا تدرك ذلك

235
00:17:39,090 --> 00:17:40,440
.ليست ظريفة إطلاقًا

236
00:17:40,440 --> 00:17:43,110
!أنا ظريفة

237
00:17:43,110 --> 00:17:45,090
...هذا يكفي

238
00:17:45,090 --> 00:17:46,720
...حسنًا

239
00:17:46,720 --> 00:17:50,100
لماذا تمّ استدعاؤنا وتركنا ننتظر؟

240
00:17:50,100 --> 00:17:54,770
طرأ عمل عاجل! عندما يقول
،كايدو-سان أنّ الأمر مهمّ

241
00:17:54,770 --> 00:17:57,730
...فإنّه نفس الموضوع دائمًا

242
00:18:01,790 --> 00:18:04,950
أهي مسألة عائليّة ثانية-أرينسو؟

243
00:18:11,800 --> 00:18:13,370
هل كايدو غبيّ؟

244
00:18:13,370 --> 00:18:15,460
!لا تغضبي عليه

245
00:18:20,840 --> 00:18:25,990
!يا كينييمون! عثرنا على العدوّ

246
00:18:27,820 --> 00:18:30,010
ألحق بنا الجميع؟

247
00:18:31,350 --> 00:18:33,510
!يا رأس الطّحلب

248
00:18:33,510 --> 00:18:35,350
من أين حصلت على ذلك؟

249
00:18:35,350 --> 00:18:37,690
!وجدتَ ساكي يا زورو

250
00:18:38,460 --> 00:18:41,480
.أخبرتكم أنّ بإمكاني إيجاده من رائحته

251
00:18:41,480 --> 00:18:43,280
...إنّها غريزته

252
00:18:43,280 --> 00:18:47,360
.كلّ ما يفكّر فيه هو السّاكي والسّيوف

253
00:18:47,360 --> 00:18:51,870
!كلّ شيء جاهز

254
00:18:56,680 --> 00:19:01,500
!لوفي! سنشرب بدونك إن لم تأتِ بسرعة

255
00:19:01,500 --> 00:19:02,550
.زورو سيفعل

256
00:19:02,550 --> 00:19:03,840
!لن أشرب

257
00:19:03,840 --> 00:19:05,170
!حسنًا

258
00:19:05,170 --> 00:19:07,010
.تفضّل أيّها الزّعيم-سان

259
00:19:07,890 --> 00:19:09,470
.شكرًا لك

260
00:19:13,870 --> 00:19:17,630
.أتمنّى لو كان لدينا وقت لنغنّي أغنية

261
00:19:19,750 --> 00:19:24,040
لم أتشارك كأس ساكي في مزاج
.جيّد كهذا من قبل

262
00:19:24,040 --> 00:19:25,780
.جينبي

263
00:19:28,760 --> 00:19:30,120
!كنّا في انتظارك

264
00:19:31,090 --> 00:19:32,630
!نعم

265
00:19:32,630 --> 00:19:39,360
!لا أطيق الانتظار حتّى أبحر برفقتكم جميعًا أيضًا

266
00:19:41,100 --> 00:19:43,880
!حسنًا! هل أنتم جاهزون؟

267
00:19:43,880 --> 00:19:44,770
!يا رفاق

268
00:19:44,770 --> 00:19:46,380
!أجل

269
00:19:49,490 --> 00:19:53,600
...احتفالاً بانضمام

270
00:19:53,600 --> 00:19:57,520
...جينبي على متن سفينتنا

271
00:19:57,520 --> 00:19:59,730
!شكرًا لك يا لوفي-دونو

272
00:20:00,290 --> 00:20:03,190
...اخترقتم الحاجز الأوّل بسرعة

273
00:20:00,940 --> 00:20:01,650
ما هذا؟

274
00:20:03,580 --> 00:20:06,070
!أقدّر لكم ذلك

275
00:20:15,180 --> 00:20:17,790
!ماذا؟! الحيويّة تملأ الجميع

276
00:20:17,790 --> 00:20:22,140
لا بدّ أنّ إسقاط هذا الحصن
!قد عزّز معنويّات الجميع

277
00:20:22,140 --> 00:20:25,600
.سيصلون إلى أونيغاشيما بسرعة كبيرة

278
00:20:33,990 --> 00:20:39,200
لن نضيّع هذه الفرصة الّتي منحنا
!إيّاها لوفيتارو والبقيّة

279
00:20:39,200 --> 00:20:42,190
!نعم! لن نسمح لعدوّنا بالتّأهّب

280
00:20:42,190 --> 00:20:45,920
!يُعتمد على طاقم قبّعة القشّ فعلاً

281
00:20:45,920 --> 00:20:47,190
!صحيح

282
00:20:47,190 --> 00:20:54,060
،مذ أن قابلت ذلك الفتى
!لم ينفكّ عن تغيير اليأس لأمل

283
00:20:55,490 --> 00:20:57,450
!يا ساموراي كوزكي

284
00:20:57,930 --> 00:21:00,120
!أيّها المحاربون المخلصون

285
00:21:00,910 --> 00:21:02,460
!اتبعوني

286
00:21:02,700 --> 00:21:04,920
!كلّ السّفن إلى أونيغاشيما

287
00:21:11,130 --> 00:21:13,140
!اندفعوا

288
00:21:32,110 --> 00:21:33,740
ماذا تفعل؟

289
00:21:36,630 --> 00:21:38,200
.لوفي

290
00:21:38,200 --> 00:21:39,620
!يا لوفي

291
00:21:39,620 --> 00:21:40,400
.لنتوقّف

292
00:21:40,420 --> 00:21:40,910
ماذا؟

293
00:21:42,220 --> 00:21:43,980
!لنقم بهذا معهم

294
00:21:44,430 --> 00:21:46,750
!وليمة ونخب

295
00:21:48,250 --> 00:21:51,320
!بعد أن نطيح بكايدو

296
00:21:51,840 --> 00:21:55,220
!وإيساع بيغ مام وأوروتشي ضربًا

297
00:21:55,220 --> 00:21:57,720
،بعد أن ننتصر في هذه المعركة

298
00:21:57,720 --> 00:22:00,770
...فسنقيم أكبر

299
00:22:01,740 --> 00:22:04,600
!وليمة على الإطلاق

300
00:22:11,650 --> 00:22:13,340
!إنّك مندفع دائمًا

301
00:22:13,340 --> 00:22:15,510
.نامي-سان محقّة

302
00:22:15,510 --> 00:22:16,470
فعلاً؟

303
00:22:16,470 --> 00:22:20,970
.حسنًا، لطالما كان الأمر هكذا
.سنضيّع الوقت بالشّكوى لا غير

304
00:22:20,970 --> 00:22:22,260
!نعم، نعم

305
00:22:22,260 --> 00:22:24,640
!لا يحقّ لك أن تومئ برأسك

306
00:22:24,640 --> 00:22:26,830
،نحن لا نمانع ذلك

307
00:22:26,830 --> 00:22:29,820
لكن ماذا عنك أيّها الزّعيم-سان؟

308
00:22:32,060 --> 00:22:34,720
!تعرفون إجابتي

309
00:22:36,840 --> 00:22:40,850
!أنا معكم

310
00:22:45,520 --> 00:22:47,600
!هيّا بنا يا رفاق

311
00:22:47,600 --> 00:22:50,580
!اتبعوا السّاموراي

312
00:22:50,580 --> 00:22:53,820
!حاضر يا قبطان

313
00:23:04,140 --> 00:23:08,750
أونيغاشيما معقل لجمجمة ضخمة
!تنذر بالشّؤم بشكل كبير

314
00:23:08,750 --> 00:23:15,760
انطلق كلّ الأكازايا إلى ساحة المعركة
!حاملين أماني أودن في قلوبهم

315
00:23:15,760 --> 00:23:22,470
بعد تفاديهم لعدّة عقبات، لم يعد
!للسّاموراي من تراجع وبدؤوا التّسلّل

316
00:23:22,470 --> 00:23:23,640
:في الحلقة القادمة من وان بيس

317
00:23:23,640 --> 00:23:27,640
!جدّيّة محاربي السّاموراي"
"!نزول طاقم قبّعة القشّ في أونيغاشيما

318
00:23:27,640 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا