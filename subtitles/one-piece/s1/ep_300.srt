1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,480 --> 00:02:27,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:29,640 --> 00:02:31,810
.أخذ هذا وقتًا طويلاً بالفعل

33
00:02:31,810 --> 00:02:33,800
.لكنّني وصلت أخيرًا

34
00:02:33,800 --> 00:02:36,770
،بمجرّد أن أعبر هذه البوّابات
...فيمكنني أن أكون للحكومةِ

35
00:02:36,770 --> 00:02:40,480
!كلاّ، بل للعالم بأسره بطلاً

36
00:02:42,040 --> 00:02:45,360
لوتشي إذًا؟ إذًا فأنت تواجه
وقتًا عصيبًا ضدّه؟

37
00:02:45,890 --> 00:02:49,320
.أين هي نيكو روبين؟ أحضرت مفتاحين معي

38
00:02:49,720 --> 00:02:50,950
هل أساعدك؟

39
00:02:50,950 --> 00:02:52,820
...لا. الأهمّ من ذلك

40
00:02:53,590 --> 00:02:55,770
.أوقف روبين أرجوك

41
00:02:56,990 --> 00:03:00,890
بإمكانك الذّهاب لبوّابات العدالة
.عبر ذلك الباب خلف رجل الحمامة

42
00:03:00,890 --> 00:03:02,920
.أُخذت روبين إلى هناك سلفًا

43
00:03:03,520 --> 00:03:05,970
.سأقوم أنا بإيقافه

44
00:03:07,040 --> 00:03:09,590
!سأدع الأمر لك بشكل خارق أيّها الوغد

45
00:03:14,960 --> 00:03:16,520
!شكرًا على الانتظار

46
00:03:21,100 --> 00:03:24,570
...ذراعاي وساقاي وعنقي
،إن أمكنني التّحكّم في مداها

47
00:03:24,570 --> 00:03:26,440
!أستطيع التّلويح بسيفيّ بكلّ قوّة

48
00:03:29,400 --> 00:03:32,250
.أنا سيّاف يستعمل أسلوب السّيوف الأربعة

49
00:03:32,250 --> 00:03:35,120
أستطيع الآن الاستفادة من قوى
!الزّرافة خاصّتي بالكامل

50
00:03:35,820 --> 00:03:38,580
!ما عدت تملك أيّ فرصة أمامي

51
00:03:42,080 --> 00:03:45,000
...قوى الزّرافة قويّة جدًّا

52
00:03:45,530 --> 00:03:49,090
...بإمكانك تخزين عنقك الّذي يعرقلك

53
00:03:49,540 --> 00:03:52,720
...بإمكانك استعمال أسلوب السّيوف الأربعة

54
00:03:53,930 --> 00:03:55,220
!كلاّ

55
00:03:57,240 --> 00:03:58,270
!ماذا؟

56
00:03:58,840 --> 00:04:01,230
!أوقف هجمات سيفيّ؟

57
00:04:03,440 --> 00:04:08,950
لا شيء من ذلك... بإمكانه
.أن يكون أساسًا لهزيمتي

58
00:04:12,300 --> 00:04:16,700
الإله الشّيطانيّ زورو! وُلد تجسّد"
"!أسورا من الرّوح القتاليّة

59
00:04:35,190 --> 00:04:40,690
.يا له من ردّ عديم الفائدة
!أرني "أساسك" إذًا

60
00:04:42,920 --> 00:04:44,830
...أسلوب السّيوف الثّلاثة

61
00:04:46,000 --> 00:04:47,190
...هجوم

62
00:04:48,280 --> 00:04:49,240
النّمر

63
00:04:52,080 --> 00:04:53,200
!سوف يحلّق نحوي

64
00:04:53,200 --> 00:04:54,570
!الدّوّار

65
00:04:55,200 --> 00:04:56,310
!فنّ الورق

66
00:05:04,230 --> 00:05:07,300
!غير ممكن...! واثق أنّني كشفت هجومه

67
00:05:12,010 --> 00:05:13,930
...هل يعقل

68
00:05:17,130 --> 00:05:20,960
!أيعقل فعلاً أنّه توقّع ردّة فعلي؟

69
00:05:23,580 --> 00:05:25,900
لماذا أنت متفاجئ هكذا؟

70
00:05:26,590 --> 00:05:30,820
...لا تخبرني أنّك لم تُقطع من قبل

71
00:05:32,820 --> 00:05:35,600
فهمت... يبدو أنّك لم تكن
.مجرّد متباهٍ فحسب

72
00:05:35,600 --> 00:05:39,590
.قلّلت من شأنك قليلاً
.لكن لن يحدث ذلك بعد الآن

73
00:05:39,590 --> 00:05:45,310
،أتقنتُ القوى السّتّ. وفوق ذلك
.لديّ الآن قوى الزّرافة الجامحة

74
00:05:45,310 --> 00:05:49,540
...التّقنيات والقوّة والسّرعة
!محال أن تستطيع هزيمتي في أيّ منها

75
00:05:49,540 --> 00:05:51,420
!لن أمنحك أيّ ثغرات أخرى للهجوم

76
00:05:52,670 --> 00:05:54,090
!ساق العاصفة: شوريكن

77
00:06:01,110 --> 00:06:02,230
!برج إطلاق الزّرافة

78
00:06:04,910 --> 00:06:05,980
!سُحقًا

79
00:06:08,440 --> 00:06:10,840
...بإمكان عنقي أن يصبح سوطًا

80
00:06:10,840 --> 00:06:12,150
!سوط الجَلد

81
00:06:20,150 --> 00:06:21,580
...وإليك الآن النّسخة الأسرع

82
00:06:21,580 --> 00:06:22,700
!سوط الجَلد الشّرس

83
00:06:25,210 --> 00:06:28,210
!ما رأيك؟! أما زال بإمكانك التّباهي؟

84
00:06:31,820 --> 00:06:36,510
،لن تتوقّف هجمات السّيوف الأربعة
!لذلك استسلم فحسب

85
00:06:38,500 --> 00:06:39,800
!الجَلد الغاضب

86
00:06:45,210 --> 00:06:46,140
!...ها أنا ذا

87
00:06:49,890 --> 00:06:51,890
!يا له من هجوم شرس

88
00:06:51,890 --> 00:06:55,610
حسنًا! ما الخطب؟! كلّ ما
!تستطيع فعله هو التّصدّي لي

89
00:06:55,610 --> 00:06:58,150
!لا يمكنك هزيمتي

90
00:07:02,310 --> 00:07:03,740
.ما أنتم إلاّ قراصنة

91
00:07:03,740 --> 00:07:07,620
كانت مجابهتكم لحكومة
!العالم خطأ من الأساس

92
00:07:08,820 --> 00:07:12,960
بما أنّ الأمر آل لهذا الآن، سيتوجّب
...عليك الموت باسم العدالة

93
00:07:12,960 --> 00:07:14,420
!تمامًا كتلك المرأة

94
00:07:20,840 --> 00:07:22,480
...وغد

95
00:07:40,670 --> 00:07:42,810
!ما كان ذلك؟

96
00:07:42,810 --> 00:07:46,790
لوهلة، بدا لي كإله شيطانيّ
!بثلاثة وجوه وستّ أذرع

97
00:07:47,350 --> 00:07:50,710
!ما بال هذا الرّجل؟

98
00:07:52,800 --> 00:07:54,990
.بدأتَ تنجرف في حماسك

99
00:07:55,900 --> 00:07:58,130
.أنت تثرثر كثيرًا

100
00:07:58,640 --> 00:08:00,380
سئمت الاستماع لي؟

101
00:08:01,070 --> 00:08:04,700
،سأستعمل إذًا تقنية ساق العاصفة
،تقطيع السّماء

102
00:08:04,700 --> 00:08:06,360
...الّتي قطّعت هذا البرج

103
00:08:10,080 --> 00:08:12,860
!وأنهي هذه المعركة بتقطيعك لنصفين

104
00:08:13,210 --> 00:08:16,280
.لذلك استسلم. لا مهرب لك

105
00:08:16,280 --> 00:08:19,490
إنّها تقنية من مستوى مختلف
!تمامًا عمّا أظهرته لك قبل قليل

106
00:08:25,150 --> 00:08:26,200
...غبيّ

107
00:08:28,410 --> 00:08:31,170
.أنت من عليه الاستسلام

108
00:08:37,510 --> 00:08:40,080
...هالة الشّيطان... أسلوب السّيوف التّسعة

109
00:08:43,780 --> 00:08:45,100
!أسورا

110
00:08:49,520 --> 00:08:51,730
!...الإله الشّيطانيّ الّذي رأيته قبل قليل

111
00:08:51,730 --> 00:08:54,480
كيف له أن يظهر وهمًا قويًّا
!كهذا بروحه القتاليّة فحسب؟

112
00:08:54,970 --> 00:08:57,440
!مذهل! لكنّ الأوان قد فات

113
00:08:57,800 --> 00:09:01,570
.أنت من فات الأوان عليه

114
00:09:02,080 --> 00:09:07,390
انتظر حتّى تتفادى تقنية ساق
.العاصفة هذه قبل أن تتباهى

115
00:09:08,410 --> 00:09:10,060
!تقطيع السّماء

116
00:09:33,270 --> 00:09:34,270
...هجومي القاطع

117
00:09:35,490 --> 00:09:37,820
!تحوّل إلى ضباب؟

118
00:09:39,170 --> 00:09:41,030
!لا أمانع وجود العقبات

119
00:09:41,730 --> 00:09:44,780
!اخترت السّير على درب أسورا

120
00:09:55,960 --> 00:09:58,710
!أسورا: الضّباب الفضّيّ

121
00:10:48,550 --> 00:10:49,800
...لديّ

122
00:10:50,640 --> 00:10:53,430
.رسالة لك من زعيم غالي-لا الأصغر

123
00:10:54,850 --> 00:10:59,020
...عندما ترى... أولئك الأشخاص، أخبرهم

124
00:11:00,950 --> 00:11:03,860
.قال أنّكم مطرودون

125
00:11:24,380 --> 00:11:28,970
!اعتبرتكم أصدقائي طوال هذا الوقت

126
00:11:33,550 --> 00:11:35,110
باولي، صحيح؟

127
00:11:36,090 --> 00:11:38,440
.فهمت... أنا في ورطة

128
00:11:39,320 --> 00:11:44,900
مهارات الاغتيال ليست مفيدة
.جدًّا في الوظائف الأخرى

129
00:11:46,060 --> 00:11:48,740
.ما زال بإمكانك العمل في حديقة حيوانات

130
00:11:53,810 --> 00:11:55,620
...بربّك

131
00:12:25,180 --> 00:12:26,290
.آسف

132
00:12:43,990 --> 00:12:46,430
!يا رأس الطّحلب! أين المفتاح؟

133
00:12:46,430 --> 00:12:47,590
...نعم

134
00:12:48,590 --> 00:12:50,020
.حصلتُ عليه توًّا

135
00:12:50,990 --> 00:12:52,550
.فهمت

136
00:12:53,320 --> 00:12:55,550
.على أيّ حال، يبدو أنّ قتالكما كان حاميًا

137
00:12:55,550 --> 00:12:59,000
ألم تتسبّبا في انزلاق البرج أكثر؟
أسنكون بخير؟

138
00:12:59,000 --> 00:13:02,560
.من يهتمّ؟ ذلك ليس مهمًّا

139
00:13:04,960 --> 00:13:08,900
.على أيّ حال، لدينا الآن كلّ المفاتيح

140
00:13:14,030 --> 00:13:15,410
.نعم

141
00:13:15,960 --> 00:13:18,040
.لنسرع إلى روبين

142
00:13:23,400 --> 00:13:26,500
!اركضا

143
00:13:27,240 --> 00:13:31,510
!اركضا فحسب! واصلا الرّكض بسرعة

144
00:13:31,510 --> 00:13:36,950
من واجبنا أن ننجو لكي لا نُقلق
!أخانا وقبّعة القشّ علينا

145
00:13:37,680 --> 00:13:42,830
!اركضا لنعيش! حتّى إن كسر ذلك رجليكما

146
00:13:42,830 --> 00:13:44,060
!أجل

147
00:13:45,820 --> 00:13:47,570
!اركضا

148
00:13:47,570 --> 00:13:49,980
!نعتمد عليكما أيّها العملاقان

149
00:13:49,980 --> 00:13:54,680
يا رفاق... إن كنتم ستركبون فوقنا
!فحسب، فالتزموا الصّمت على الأقلّ

150
00:13:55,610 --> 00:13:57,450
!نعم، أوافقه الرّأي

151
00:13:57,960 --> 00:14:01,960
!انطلقا! باسم إلباف

152
00:14:01,960 --> 00:14:03,460
!اخرس

153
00:14:05,920 --> 00:14:08,690
!بسرعة يا جدّتي! أسرعي! أسرعي

154
00:14:08,690 --> 00:14:13,010
!يا تشيمني! أنا عجوز! أظهري بعض اللّطف

155
00:14:13,010 --> 00:14:17,470
يا إلهي، لا أستطيع مواصلة
.الرّكض ما لم أشرب

156
00:14:17,940 --> 00:14:19,050
!يا ويحي

157
00:14:23,550 --> 00:14:25,760
!...يا لكثرة مطالبك

158
00:14:25,760 --> 00:14:27,130
!يا جدّتي

159
00:14:27,130 --> 00:14:29,060
!عليّ أن أسرع، صحيح؟ أعلم ذلك

160
00:15:20,200 --> 00:15:21,780
!اتّصل الجسر بالجانبين أخيرًا

161
00:15:22,820 --> 00:15:24,590
!لا يمكنني الكفّ عن الضّحك

162
00:15:24,590 --> 00:15:28,170
!أنتم يا حرّاس بوّابات العدالة
!هل أنتم جاهزون؟

163
00:15:28,170 --> 00:15:31,510
نعم! سفينة المرافقة أمام
...العمود الثّالث مسبقًا و

164
00:15:31,510 --> 00:15:34,300
!هذا ليس قصدي! لماذا لا تخرجون لتحيّتي؟

165
00:15:34,300 --> 00:15:36,500
!سيعبر البطل العظيم سباندام الجسر

166
00:15:36,500 --> 00:15:37,930
!حا-حاضر! سنخرج في الحال

167
00:15:38,470 --> 00:15:41,000
يا لهم من أغبياء! لا يمكنهم فعل
!أيّ شيء من تلقاء أنفسهم

168
00:15:41,980 --> 00:15:44,470
.يا نيكو روبين. انظري إلى هناك

169
00:15:45,310 --> 00:15:49,140
.تلك البوّابة الصّغيرة هي المدخل الحقيقيّ

170
00:15:49,630 --> 00:15:54,940
عند المرور منها، سنعبر الحدّ
.بين النّعيم والجحيم

171
00:15:55,380 --> 00:15:58,900
وتلك هي اللّحظة الّتي سيُحفر
!فيها اسمي في التّاريخ

172
00:16:29,890 --> 00:16:33,590
يا ويحي. هل كنتِ تحاولين الهرب؟

173
00:16:36,100 --> 00:16:40,110
.أنا أتعاطف معك في الحقيقة على الأقلّ

174
00:16:40,610 --> 00:16:44,320
لكن ما باليد حيلة، صحيح؟
.لا قيمة لحياتك

175
00:16:45,890 --> 00:16:47,470
.أسرعي وموتي

176
00:16:50,500 --> 00:16:52,290
!تلك الحقيرة

177
00:16:55,640 --> 00:16:57,050
...لا أريد الموت

178
00:16:57,650 --> 00:16:59,010
!...لا أريد الموت

179
00:16:59,720 --> 00:17:01,970
!لا أريد الموت

180
00:17:15,610 --> 00:17:17,900
!نلت كفايتك أيّتها الحقيرة

181
00:17:17,900 --> 00:17:20,030
...هيّا قفي على قدميك

182
00:17:21,200 --> 00:17:24,660
!ماذا؟ إنّها لا تتحرّك. ما الّذي يحدث؟

183
00:17:30,290 --> 00:17:34,410
!إنّها تعضّ الجسر الحجريّ

184
00:17:34,960 --> 00:17:38,050
!إنّها لا تدري متى تستسلم
!كم هذا مزعج

185
00:17:38,570 --> 00:17:41,270
!إنّه لمن المزعج كيف تتشبّث بالحياة

186
00:17:41,270 --> 00:17:43,150
!هذا مثير للشّفقة وبذيء

187
00:17:43,150 --> 00:17:47,900
أنت مجرمة! الطّريقة الوحيدة
!لإسعاد الآخرين هي بموتك

188
00:17:47,900 --> 00:17:51,250
لماذا عليك التّصرّف ببؤس
!هكذا حتّى النّهاية؟

189
00:17:51,830 --> 00:17:55,440
...أخشى الموت كثيرًا

190
00:17:59,350 --> 00:18:00,810
!...لا أريد الموت

191
00:18:01,650 --> 00:18:03,400
...أنقذوني يا رفاق

192
00:18:06,430 --> 00:18:07,810
!...لوفي

193
00:18:11,580 --> 00:18:12,540
!مسدّس الإصبع

194
00:18:14,130 --> 00:18:15,710
!أخبرتك أنّ ذلك لا ينفع ضدّي

195
00:18:17,070 --> 00:18:18,000
!اللّوتس الصّفراء

196
00:18:20,650 --> 00:18:21,880
!يا قبّعة القشّ

197
00:18:22,780 --> 00:18:23,550
...كلاّ

198
00:18:24,460 --> 00:18:28,100
مهمّتي هي عبور ذلك الباب
!بأسرع وقت ممكن

199
00:18:31,740 --> 00:18:35,170
.لا فائدة. لا يمكنك عبوره

200
00:18:35,170 --> 00:18:36,650
!اخرس

201
00:18:36,650 --> 00:18:38,050
...المطرقة

202
00:18:38,050 --> 00:18:38,730
!الجسد الحديديّ

203
00:18:38,730 --> 00:18:40,570
!القويّة

204
00:18:55,960 --> 00:18:58,560
...ماذا؟ لم يتزحزح شبرًا واحدًا

205
00:18:59,460 --> 00:19:01,960
مع أنّه هجوم كان قويًّا كفاية
.ليرمي بتشابابا بعيدًا

206
00:19:03,260 --> 00:19:06,820
فهمت. أتيتَ بعد هزيمة فوكورو؟

207
00:19:06,820 --> 00:19:11,500
لكنّي آسف. مستوى قوّتي يفوق
.مستواه هو بخمسة أضعاف

208
00:19:21,270 --> 00:19:24,080
.من المذهل أنّك تمكّنت من هزيمة فوكورو

209
00:19:24,080 --> 00:19:27,400
يمكن القول أنّك تقف
.على حدود البشر الخارقين

210
00:19:27,400 --> 00:19:30,910
.كما توقّعت، إنّه أقوى كثير من البقيّة بشكل لا يصدّق

211
00:19:31,490 --> 00:19:33,530
.لكن... مت

212
00:19:33,530 --> 00:19:34,910
...فاكهة المطّاط

213
00:19:35,360 --> 00:19:36,620
!المسدّس النّفّاث

214
00:19:50,190 --> 00:19:52,050
...ما الّذي قمتَ

215
00:19:52,860 --> 00:19:55,730
!ما ذلك البخار؟

216
00:20:00,490 --> 00:20:02,230
.المستوى الثّاني

217
00:20:11,990 --> 00:20:14,910
.لن يدوم هذا طويلاً

218
00:20:14,910 --> 00:20:17,960
!لكنّني سأوقفه، لذلك تقدّم يا فرانكي

219
00:20:19,640 --> 00:20:21,120
!روبين تنتظر

220
00:20:22,080 --> 00:20:23,590
!حسنًا يا قبّعة القشّ

221
00:20:23,590 --> 00:20:26,890
،لا أدري ما الّذي يحدث
!لكن أطح به بذلك

222
00:20:31,370 --> 00:20:33,880
...قلتُ أنّني لن أسمح لك بالمرور

223
00:20:35,510 --> 00:20:36,520
ألم أفعل؟

224
00:20:36,520 --> 00:20:39,730
!مهلاً! أنت من مستعملي القدرات أيضًا؟

225
00:20:40,100 --> 00:20:42,770
.أوّلاً، سأقتلك يا فرانكي

226
00:20:46,480 --> 00:20:47,530
!السّوط النّفّاث

227
00:20:56,080 --> 00:20:58,900
هل نسيت يا قبّعة القشّ لوفي؟

228
00:20:58,900 --> 00:21:03,670
.أطحت بك أرضًا بهجوم واحد بهذه الهيئة

229
00:21:04,670 --> 00:21:07,880
.نعم، ذلك... أصبحت أفضل بعد أكل اللّحم

230
00:21:09,270 --> 00:21:10,470
!انتقال آنيّ

231
00:21:10,930 --> 00:21:11,510
!مسدّس الإصبع

232
00:21:13,800 --> 00:21:15,350
...فاكهة المطّاط

233
00:21:15,350 --> 00:21:16,180
!الجسد الحديديّ

234
00:21:17,680 --> 00:21:19,390
!البازوكا النّفّاثة

235
00:21:26,020 --> 00:21:26,980
!فرانكي

236
00:21:27,990 --> 00:21:29,440
!أنقذ روبين رجاءً

237
00:21:31,150 --> 00:21:33,980
!أنا لها بشكل خارق

238
00:21:45,000 --> 00:21:47,810
!أيّتها الحقيرة! ما زلت لا تستوعبين؟
!قلتُ أنّ هذا بلا فائدة

239
00:21:47,810 --> 00:21:49,380
!كم مرّة عليّ إخبارك؟

240
00:21:49,940 --> 00:21:52,220
!لم يعد لك أيّ أمل

241
00:21:53,120 --> 00:21:55,370
!لن أبارح مكاني

242
00:21:55,370 --> 00:21:59,100
!سيأتون جميعًا لإنقاذي بكلّ تأكيد

243
00:22:32,880 --> 00:22:35,590
.استمعوا جيّدًا يا رجال البحريّة
!شاهدوا جيّدًا

244
00:22:35,910 --> 00:22:39,260
هذه الخطوة العظيمة للبطل سباندام

245
00:22:39,260 --> 00:22:42,220
...الّذي سيُحفر اسمه في التّار

246
00:22:42,650 --> 00:22:45,190
!ما... ماذا؟! من هذا؟

247
00:22:45,710 --> 00:22:47,400
:في الحلقة القادمة من وان بيس

248
00:22:47,400 --> 00:22:50,820
!يرتعد سباندام خوفًا"
"!بطل يقف على برج القانون

249
00:22:50,820 --> 00:22:53,050
!ملك القراصنة، لن يكون إلاّ أنا

250
00:22:55,990 --> 00:23:00,990
نلقاكم في الحلقة القادمة