1
00:00:10,480 --> 00:00:25,040
يوجد قوس قزح وراء الأمطار الغزيرة

2
00:00:33,170 --> 00:00:36,680
سأعرف أنّ الجواب السّهل كذبة

3
00:00:37,930 --> 00:00:42,290
أعد ألاّ أتراجع أمام الصّراخ

4
00:00:42,290 --> 00:00:46,880
أحتاجك وحدك لتفهم الغد

5
00:00:46,880 --> 00:00:51,770
أعطيتني أفضل لحظات حياتي

6
00:00:53,190 --> 00:01:01,790
...ماذا أبدو؟ ملَكًا أم شيطانًا

7
00:01:01,790 --> 00:01:06,710
ما وراء الفجر، ما وراء الفجر

8
00:01:06,710 --> 00:01:12,230
ثمّة الكثير ممّا أريد أن أخبرك به

9
00:01:12,230 --> 00:01:17,050
مليء بالحبّ، بالحبّ

10
00:01:17,050 --> 00:01:22,870
الّذي لا يمكن كتابته في رسالة

11
00:01:19,100 --> 00:01:21,180
عزيزتي بوني

12
00:01:22,870 --> 00:01:31,400
يد صغيرة تبحث عن الأبديّة

13
00:01:40,570 --> 00:01:42,330
المقرّ الرّئيسيّ للجيش الثّوريّ
[بالتيغو]

14
00:01:51,560 --> 00:01:52,840
!نحتاج للدّعم

15
00:01:53,020 --> 00:01:55,800
!إنّ ثورة تومي في الأزرق الجنوبيّ تكاد تُقمع

16
00:01:55,800 --> 00:01:58,230
!نحتاج لتعزيزات في الحال رجاءً

17
00:02:02,280 --> 00:02:03,620
!أكرّر

18
00:02:03,620 --> 00:02:06,520
!إنّ ثورة تومي في الأزرق الجنوبيّ تكاد تُقمع

19
00:02:06,520 --> 00:02:09,330
!نحتاج لتعزيزات في الحال رجاءً

20
00:02:09,330 --> 00:02:10,640
!هذا مستحيل

21
00:02:10,640 --> 00:02:15,030
!سفينتنا مليئة سلفًا بالمصابين من مملكة غوا

22
00:02:18,590 --> 00:02:21,160
.أنا سأذهب يا إيفا-تشان

23
00:02:23,290 --> 00:02:24,780
!توقّف يا كوما

24
00:02:24,780 --> 00:02:28,210
إنّك تضغط على نفسك كثيرًا
...منذ ذلك اليوم المشؤوم

25
00:02:31,380 --> 00:02:32,500
!كوما

26
00:02:34,190 --> 00:02:35,380
!لا تذهب

27
00:02:40,000 --> 00:02:42,800
الأزرق الجنوبيّ
تومي

28
00:02:43,990 --> 00:02:45,100
!سُحقًا

29
00:02:45,100 --> 00:02:47,220
.هذه نهايتكم أيّها المتمرّدون

30
00:03:05,490 --> 00:03:07,620
اختُطفت جيني؟

31
00:03:07,820 --> 00:03:11,870
ذلك صحيح، يبدو أنّ تنّينًا سماويًّا
...وضع عينيه عليها

32
00:03:13,420 --> 00:03:18,170
وأخذوها على متن سفينة تابعة
.للحكومة ليتّخذها زوجة له

33
00:03:42,700 --> 00:03:45,200
.صدمة الدّبّ

34
00:04:02,730 --> 00:04:04,370
الجيش الثّوريّ؟

35
00:04:05,220 --> 00:04:07,500
...مـ-مذهل

36
00:04:11,950 --> 00:04:15,270
!لقد أثمرت هذه الأعوام الثّلاثة من الكفاح

37
00:04:15,270 --> 00:04:17,730
!شكرًا لكم أيّها الجيش الثّوريّ

38
00:04:21,910 --> 00:04:25,440
!إنّهم أبطال الشّعوب

39
00:04:33,750 --> 00:04:36,920
!وصلت تعزيزات مفاجئة وسُحقت قوّاتنا

40
00:04:39,360 --> 00:04:41,510
!أنا آسف

41
00:04:41,510 --> 00:04:44,130
!أنا آسف بالفعل

42
00:04:48,770 --> 00:04:51,160
.هذا أنا يا دراغون

43
00:04:51,450 --> 00:04:52,640
...أنا متعب

44
00:04:53,120 --> 00:04:54,850
.سأعود على متن سفينة

45
00:05:02,430 --> 00:05:07,270
"!وعد لجيني! يصير كوما والدًا"

46
00:05:10,130 --> 00:05:15,460
مرّت سنتان على اختطاف إحدى
قادة الجيش الثّوريّ جيني

47
00:05:15,460 --> 00:05:18,060
.لتصير زوجة لتنّين سماويّ

48
00:05:33,250 --> 00:05:34,520
...أنا جدّ آسفة

49
00:05:39,920 --> 00:05:42,900
.وصلنا يا بوني

50
00:05:53,840 --> 00:05:56,990
!كوما! إنّها مكالمة من جيني

51
00:05:58,220 --> 00:06:00,030
!أفسحوا الطّريق

52
00:06:00,850 --> 00:06:04,840
!جيني

53
00:06:02,430 --> 00:06:03,630
أخي الكبير؟

54
00:06:07,070 --> 00:06:08,930
!مرحبًا يا كوماتشي

55
00:06:08,930 --> 00:06:11,390
!عدت أخيرًا إلى العالم السّفليّ

56
00:06:11,390 --> 00:06:14,420
!كنّا قلقين جدًّا عليك

57
00:06:14,420 --> 00:06:16,770
!جيني... أنا سعيد جدًّا لأنّك بخير

58
00:06:18,470 --> 00:06:19,480
...نعم

59
00:06:19,920 --> 00:06:22,440
،لكنّي مريضة

60
00:06:22,800 --> 00:06:25,470
.لذلك قرّروا التّخلّص منّي

61
00:06:26,210 --> 00:06:27,650
!يا لحظّي، صحيح؟

62
00:06:27,980 --> 00:06:29,260
أنت مريضة؟

63
00:06:31,400 --> 00:06:32,950
ماذا تقصدين يا جيني؟

64
00:06:33,550 --> 00:06:36,410
،أتمنّى لو أستطيع رؤيتكم ثانية

65
00:06:36,410 --> 00:06:39,270
.لكنّي اتّصلت بكم فقط لأودّعكم

66
00:06:39,270 --> 00:06:40,360
!ماذا؟

67
00:06:40,590 --> 00:06:42,250
!ما الّذي تقولينه يا جيني؟

68
00:06:42,690 --> 00:06:45,340
!ظننتُ أنّي لن أراك ثانية

69
00:06:45,340 --> 00:06:47,840
!أين أنت؟ سأوافيك في الحال

70
00:06:53,120 --> 00:06:55,470
.أنا آسفة يا كوماتشي

71
00:06:55,470 --> 00:06:58,790
.سأموت عمّا قريب

72
00:07:04,010 --> 00:07:05,810
ستموتين؟

73
00:07:06,600 --> 00:07:08,820
ماذا؟ لماذا ستموتين؟

74
00:07:09,090 --> 00:07:11,510
!سأنقذك

75
00:07:13,220 --> 00:07:14,870
!أنا قادم إليك الآن

76
00:07:17,550 --> 00:07:19,200
،كوماتشي

77
00:07:19,560 --> 00:07:23,710
،أنا مسرورة لأنّك تريد إنقاذي
.لكن ليس عليك أن تأتي

78
00:07:24,060 --> 00:07:26,710
،سوف ننقذك يا جيني

79
00:07:28,460 --> 00:07:30,520
!لذلك أخبرينا أين أنت فحسب

80
00:07:34,310 --> 00:07:35,550
!ابتعدوا عن طريقي

81
00:07:35,550 --> 00:07:36,680
كوما؟

82
00:07:36,860 --> 00:07:38,350
!إلى أين أنت ذاهب؟

83
00:07:38,760 --> 00:07:42,140
.ثمّة مكان واحد فقط تعتبره منزلها

84
00:07:42,720 --> 00:07:45,370
...دراغون، أخي الكبير

85
00:07:47,820 --> 00:07:51,280
،اعتنيا بعزيزنا كوماتشي رجاءً
.إنّ طيبة قلبه لا تعرف الحدود

86
00:08:00,870 --> 00:08:03,080
...وتذكّر يا كوماتشي

87
00:08:04,680 --> 00:08:06,040
...سأظلّ دائمًا

88
00:08:07,190 --> 00:08:08,730
...دائمًا

89
00:08:12,990 --> 00:08:14,220
...أحبّك

90
00:08:24,770 --> 00:08:27,480
كوما؟ هل عدت؟

91
00:08:27,480 --> 00:08:29,730
جيني هنا، صحيح؟ أين هي؟

92
00:08:29,730 --> 00:08:31,360
...إنّها هنا، لكن

93
00:08:33,640 --> 00:08:37,320
!جيني

94
00:08:43,140 --> 00:08:46,330
لماذا؟ ماذا حدث؟

95
00:08:46,330 --> 00:08:49,840
...إنّ وجهها وسائر جسدها

96
00:08:49,840 --> 00:08:55,720
،قالت أنّها إذا تعرّضت لنور طبيعيّ
.ستصير بشرتها زرقاء وصلبة كالحجر

97
00:08:55,920 --> 00:08:59,680
مسكينة... ما هذا المرض الّذي نزل بها؟

98
00:09:02,580 --> 00:09:04,230
!كوماتشي

99
00:09:04,770 --> 00:09:06,690
!هذا لذيذ جدًّا

100
00:09:08,650 --> 00:09:10,400
!كوماتشي

101
00:09:13,010 --> 00:09:16,410
!لنتزوّج يا كوماتشي

102
00:09:25,580 --> 00:09:27,580
!سأجعلك أسعد رجل في العالم

103
00:09:29,700 --> 00:09:31,160
!كوماتشي

104
00:09:37,400 --> 00:09:40,260
،أرادت أن تحظى ابنتها بمستقبل

105
00:09:40,260 --> 00:09:42,720
.حتّى إن لم تكن هي جزءًا منه

106
00:09:46,410 --> 00:09:52,230
أبحرت تحت نور الشّمس لتصل
.إلى هنا بآخر ما تبقّى لها من قوّة

107
00:09:58,710 --> 00:10:01,490
.لا تقلقي يا جيني

108
00:10:01,490 --> 00:10:04,330
.سأعتني بابنتك

109
00:10:13,500 --> 00:10:15,340
جيني

110
00:10:19,590 --> 00:10:22,600
جيني

111
00:10:47,330 --> 00:10:49,730
!كلاّ

112
00:10:49,730 --> 00:10:52,540
!زاوية الرّضّاعة ليست صحيحة

113
00:10:52,540 --> 00:10:55,370
و-و-وهكذا؟

114
00:10:56,050 --> 00:10:58,130
!أنا آسف

115
00:10:58,130 --> 00:11:00,530
!ستخنق بوني-تشان هكذا

116
00:11:00,530 --> 00:11:02,430
!دعني أنا أقوم بذلك

117
00:11:02,430 --> 00:11:06,000
!ضعها في فقص فولاذيّ عندما تنام

118
00:11:06,000 --> 00:11:09,570
.أنت ضخم، قد تسحقها عن طريق الخطأ

119
00:11:24,960 --> 00:11:27,540
.يا لظرافتها

120
00:11:27,540 --> 00:11:30,340
!لدى بوني-تشان شهيّة كبيرة

121
00:11:30,340 --> 00:11:33,720
!إنّها نهمة مثل جيني تمامًا

122
00:11:37,710 --> 00:11:38,960
!هذا غير كافٍ

123
00:11:41,830 --> 00:11:43,470
.بالتّأكيد

124
00:11:47,280 --> 00:11:51,180
!أشحتُ نظري عنها لوهلة وقد صارت هناك سلفًا

125
00:11:58,610 --> 00:12:01,360
!نعم، هذا جيّد يا بوني

126
00:12:06,550 --> 00:12:09,080
!أ-أبي

127
00:12:10,830 --> 00:12:12,330
!أبي

128
00:12:16,420 --> 00:12:19,170
!نعم، هذا أنا أبوك

129
00:13:56,850 --> 00:13:59,880
!مرحبًا يا بوني

130
00:14:00,330 --> 00:14:02,070
!لقد عدت

131
00:14:04,340 --> 00:14:06,150
.مرحبًا بك

132
00:14:32,550 --> 00:14:33,600
كوما؟

133
00:14:40,900 --> 00:14:45,360
لماذا تسدّ كلّ نوافذ الكنيسة؟

134
00:14:48,010 --> 00:14:49,570
!أغلقا الباب

135
00:14:52,600 --> 00:14:53,780
...انظرا لهذا

136
00:14:54,570 --> 00:14:56,370
!حجارة زرقاء؟

137
00:14:56,370 --> 00:14:58,220
...لكنّ هذا

138
00:14:58,220 --> 00:14:59,760
—المرض الّذي قتل جيني

139
00:14:59,760 --> 00:15:00,790
!توقّف

140
00:15:00,790 --> 00:15:02,670
!سأستدعي الطّبيب

141
00:15:04,140 --> 00:15:05,500
...شكرًا

142
00:15:08,050 --> 00:15:09,510
...حسنًا

143
00:15:09,850 --> 00:15:11,810
هذا بسبب تعرّضها للنّور؟

144
00:15:11,810 --> 00:15:13,100
فعلاً؟

145
00:15:13,100 --> 00:15:14,300
.نعم

146
00:15:16,880 --> 00:15:18,780
—لنخرج ونرَ

147
00:15:18,780 --> 00:15:20,480
!لا تتفوّه بالسّخافات

148
00:15:21,260 --> 00:15:24,480
...إنّه ليس تسمّم الرّصاص الأبيض

149
00:15:24,640 --> 00:15:27,930
.أنا آسفة، لكنّ هذه الأعراض غريبة عليّ

150
00:15:27,930 --> 00:15:29,370
...فهمت

151
00:15:29,500 --> 00:15:31,580
أبي؟

152
00:15:33,470 --> 00:15:35,710
.ستكونين بخير يا بوني

153
00:15:36,760 --> 00:15:39,120
!تريد ترك الجيش الثّوريّ؟

154
00:15:39,120 --> 00:15:42,580
!هل أصيبت بوني بنفس المرض بالفعل؟

155
00:15:42,580 --> 00:15:43,930
...نعم

156
00:15:43,930 --> 00:15:45,840
...لا أعرف ما العمل

157
00:15:46,520 --> 00:15:48,000
.لكنّي أريد البقاء إلى جانبها

158
00:15:48,810 --> 00:15:52,440
.مفهوم. عش حياتك بلا أيّ ندم

159
00:15:52,440 --> 00:15:55,760
سنسأل أطبّاء من كلّ أنحاء
.العالم قدر المستطاع

160
00:15:56,120 --> 00:15:58,160
.شكرًا لك يا دراغون

161
00:15:59,140 --> 00:16:03,420
قبل سبع سنوات

162
00:16:00,530 --> 00:16:04,630
...مرّ وقت وبلغت بوني الخامسة من عمرها

163
00:16:10,290 --> 00:16:11,890
!اهربوا

164
00:16:11,890 --> 00:16:14,250
!وإلاّ فستلتهمنا مصّاصة الدّماء

165
00:16:18,240 --> 00:16:21,960
بوني
‫(5 سنوات)

166
00:16:19,050 --> 00:16:21,960
!ارجعوا إلى هنا أيّها الأوغاد الصّغار

167
00:16:23,980 --> 00:16:26,470
!لا يمكنك الخروج أكثر

168
00:16:27,250 --> 00:16:29,620
!لا يخرج مصّاصو الدّماء في العلن

169
00:16:29,620 --> 00:16:32,130
!انظري إلى هذا الصّليب اللاّمع

170
00:16:33,690 --> 00:16:35,190
!هذا مؤلم

171
00:16:35,190 --> 00:16:37,050
!ألا ترى أنّنا في كنيسة أصلاً؟

172
00:16:39,060 --> 00:16:41,020
!سآتي لألقّنكم درسًا في الخارج

173
00:16:41,020 --> 00:16:43,080
!تمهّلي يا بوني

174
00:16:43,080 --> 00:16:44,730
.أبي

175
00:16:44,990 --> 00:16:49,630
رؤيتك عند المدخل وحدها تبعث
...القشعريرة في بدني

176
00:16:49,630 --> 00:16:52,760
.يا لك من جبان
.أنا أمزح معهم فحسب

177
00:16:52,760 --> 00:16:55,200
...لا تمازحيهم هكذا

178
00:16:55,200 --> 00:16:57,060
.فهمت

179
00:16:57,400 --> 00:17:00,660
.لا أحبّ أن أراك حزينًا على أيّ حال

180
00:17:00,660 --> 00:17:02,540
!بوني

181
00:17:03,600 --> 00:17:06,270
!كبرت وصرت فتاة طيّبة

182
00:17:06,270 --> 00:17:08,080
!اتركني أيّها البكّاء

183
00:17:09,290 --> 00:17:11,000
...إنّ أولئك الأولاد

184
00:17:11,580 --> 00:17:16,330
!سخروا مجدّدًا من الحجارة الّتي على وجهي

185
00:17:17,180 --> 00:17:19,540
!هل هي غريبة لهذه الدّرجة؟

186
00:17:19,540 --> 00:17:21,970
...أنا مريضة، لذلك ما بيدي حيلة

187
00:17:22,270 --> 00:17:23,990
!تقصدين تلك الجواهر؟

188
00:17:23,990 --> 00:17:25,090
!أنت تخيفني

189
00:17:25,090 --> 00:17:27,650
.إنّهم يغارون منكِ فقط لأنّها جميلة

190
00:17:27,650 --> 00:17:28,880
ماذا؟

191
00:17:30,150 --> 00:17:31,610
!أتظنّ ذلك؟

192
00:17:31,790 --> 00:17:34,980
!نعم، أنا أحبّها

193
00:17:38,050 --> 00:17:43,230
بوني، إلى أين ترغبين بالذّهاب عندما تُشفين؟

194
00:17:45,490 --> 00:17:47,290
!هل تعرف بأمر جُزر السّماء؟

195
00:17:47,290 --> 00:17:49,670
جُزر في السّماء؟ وهل توجد حقًّا؟

196
00:17:49,670 --> 00:17:52,380
!بالطّبع! قرأت عنها في كتاب

197
00:17:55,610 --> 00:17:56,930
!انظر

198
00:17:56,930 --> 00:18:01,820
،جُزر السّماء قريبة جدًّا من الشّمس
!لذلك ربّما يكون نيكا هناك أيضًا

199
00:18:01,820 --> 00:18:04,770
.أراهن أنّنا سنسعد كثيرًا بالذّهاب إلى هناك

200
00:18:06,020 --> 00:18:07,890
!نيكا؟

201
00:18:13,710 --> 00:18:16,150
!ها هي ذي! رقصة نيكا

202
00:18:20,070 --> 00:18:22,910
!سيكون الذّهاب للسّماء مغامرة مذهلة

203
00:18:22,910 --> 00:18:25,140
!ربّما سنقوم بذلك عندما تبلغين العشرين

204
00:18:25,140 --> 00:18:26,040
!حسنًا

205
00:18:26,390 --> 00:18:28,610
وأين ستذهبين في سنّ التّاسعة عشرة؟

206
00:18:28,610 --> 00:18:30,130
!جزيرة البرمائيّين

207
00:18:35,690 --> 00:18:40,390
أخشى أنّ ابنتك تعاني من مرض حراشف
.الياقوت الأزرق الّذي لا علاج له

208
00:18:40,390 --> 00:18:42,040
هل تعرف بأمره؟

209
00:18:42,040 --> 00:18:43,100
.نعم

210
00:18:43,100 --> 00:18:45,870
آسف، هلا تكلّمت بصوت أخفت؟

211
00:18:45,870 --> 00:18:48,560
.إنّه مرض نادر ظهر حديثًا فحسب

212
00:18:48,560 --> 00:18:54,330
تظهر الحجارة عندما تتعرّض البشرة لنور
.الشّمس أو القمر أو أيّ نور طبيعيّ

213
00:18:54,710 --> 00:19:00,260
لكنّ حجب كلّ النّور عن المريض
.لن يوقف المرض من التّقدّم مع الوقت

214
00:19:00,260 --> 00:19:01,160
ماذا؟

215
00:19:01,160 --> 00:19:02,710
!لن تُشفى أبدًا؟

216
00:19:02,710 --> 00:19:05,690
!ابنتي بوني... ستنجو، أليس كذلك؟

217
00:19:07,980 --> 00:19:12,030
...سأكون صريحًا معك، أمام ابنتك

218
00:19:12,130 --> 00:19:13,840
.خمس سنوات أخرى لتعيشها على الأكثر

219
00:19:15,420 --> 00:19:19,300
على الأرجح أنّها ستفارق الحياة
.قبل أن تتمّ عامها العاشر

220
00:19:19,730 --> 00:19:22,350
لا يوجد ما يمكنك فعله؟

221
00:19:22,350 --> 00:19:25,530
.لا نعرف كيف نعالج المرض

222
00:19:25,530 --> 00:19:26,760
...العاشرة من عمرها

223
00:19:32,040 --> 00:19:33,610
...ولكن

224
00:19:33,980 --> 00:19:36,860
...إنّها مليئة بالحياة

225
00:19:46,320 --> 00:19:50,660
!ألا توجد أيّ طريقة لعلاجها بالفعل؟

226
00:19:58,920 --> 00:20:00,920
!بوني؟ ألم تكوني نائمة؟

227
00:20:00,920 --> 00:20:03,970
!لقد سمعتك

228
00:20:05,510 --> 00:20:06,880
ماذا؟

229
00:20:07,160 --> 00:20:08,910
.قلتَ العاشرة من عمرها

230
00:20:09,740 --> 00:20:11,770
العاشرة؟ عمّا تتكلّمين؟

231
00:20:11,950 --> 00:20:14,230
.سمعتك تتحدّث عن عندما أبلغ العاشرة

232
00:20:14,230 --> 00:20:16,900
ماذا؟ هل تبكي؟

233
00:20:16,960 --> 00:20:19,360
كنت تتكلّم عنّي، صحيح؟

234
00:20:19,360 --> 00:20:21,530
...ذلك صحيح

235
00:20:21,530 --> 00:20:24,320
...في عيد مولدك العاشر

236
00:20:24,320 --> 00:20:27,000
...فإنّ مرضك يا بوني سوف

237
00:20:27,000 --> 00:20:30,790
قال ذلك الطّبيب أنّك لن تتحسّني
.حتّى تبلغي العاشرة

238
00:20:31,410 --> 00:20:32,500
فعلاً؟

239
00:20:32,500 --> 00:20:37,210
.حزنتُ لأنّه قيل لي أنّ الأمر سيأخذ وقتًا

240
00:20:37,600 --> 00:20:39,390
!ممتاز

241
00:20:39,390 --> 00:20:42,170
سأشفى عندما أبلغ العاشرة؟

242
00:20:42,170 --> 00:20:45,140
بإمكاننا السّفر معًا بعدها؟

243
00:20:45,210 --> 00:20:48,930
.بالطّبع! ستكونين أفضل عندما تبلغين العاشرة

244
00:20:48,930 --> 00:20:51,090
!ممتاز

245
00:20:51,240 --> 00:20:53,940
كلاّ... ما الّذي فعلت؟

246
00:20:54,890 --> 00:20:58,790
،وفي أحد الأيّام بعد سنة

247
00:20:59,250 --> 00:21:03,400
.غرقت مملكة سوربي في كابوس مرّة أخرى

248
00:21:04,470 --> 00:21:06,110
!كوما

249
00:21:06,110 --> 00:21:08,810
!كوماتشي! ساعدنا

250
00:21:08,810 --> 00:21:11,370
!عاد الملك بيكوري لسابق عهده

251
00:21:11,370 --> 00:21:13,700
!كما كان قبل 16 سنة

252
00:21:13,700 --> 00:21:16,960
إنّه يريد حرق كلّ من يشكّل عبئًا
!على البلاد في نظره

253
00:21:16,960 --> 00:21:21,710
!لا يملك ذلك الرّجل ذرّة إنسانيّة
!تُقام المجازر في الشّوارع

254
00:21:42,320 --> 00:21:47,570
ما عدت أستطيع حماية أحد ثانية

255
00:21:47,570 --> 00:21:52,370
إنّ تلاشي الصّوت خطئي أنا

256
00:21:52,370 --> 00:21:54,660
ما عاد لديّ وقت حتّى للنّظر للأسف

257
00:21:54,660 --> 00:21:57,250
ثمّة آثار حصى على راحَتَيَّ

258
00:21:57,250 --> 00:22:01,040
ابدئي بالتّحرّك ثانية يا سفينتي

259
00:22:01,040 --> 00:22:06,130
مع أنّي لا أستطيع الطّيران في السّماء الواسعة

260
00:22:06,130 --> 00:22:12,180
بإمكاني إضاءة البحر العميق

261
00:22:12,180 --> 00:22:12,970
نحن

262
00:22:12,970 --> 00:22:15,480
ودائمًا، لا يمكننا السّماح أن تكون هذه النّهاية

263
00:22:15,480 --> 00:22:18,100
ودائمًا، لا يمكننا أن نُهزم

264
00:22:18,100 --> 00:22:21,900
لدينا شيء ما هنا لحمايته

265
00:22:21,900 --> 00:22:24,320
قد لا يكون هذا ما توقّعتُه

266
00:22:24,320 --> 00:22:27,110
لكن لا يمكننا أن نتوقّف هنا

267
00:22:27,110 --> 00:22:32,450
سننطلق الآن ونتشارك الوحدة

268
00:22:32,450 --> 00:22:35,160
لا داعي للخوف

269
00:22:35,160 --> 00:22:39,120
لستُ نفس الشّخص الّذي كنتُه يومها

270
00:22:39,120 --> 00:22:42,920
لا يستطيع أحد الوقوف في طريقي

271
00:22:42,920 --> 00:22:44,210
والآن، ابتعدوا

272
00:22:44,210 --> 00:22:46,780
اغزُ العالم، آمن بالمستقبل

273
00:22:46,780 --> 00:22:49,320
عدّ اللّيالي

274
00:22:49,320 --> 00:22:52,030
ماذا رأيت؟ ماذا تعلّمت؟

275
00:22:52,030 --> 00:22:55,680
لإدراك ما هو مهمّ

276
00:23:04,570 --> 00:23:08,570
ينطلق كوما في رحلة لإنقاذ
.حياة ابنته المحبوبة

277
00:23:08,570 --> 00:23:12,990
.يلتقي بعالِم عبقريّ في نهاية العالم

278
00:23:12,990 --> 00:23:15,580
هل ذلك الرّجل شيطان أم قدّيس؟

279
00:23:15,780 --> 00:23:20,830
ما هو الشّرط الغريب والكبير الّذي
عُرض على كوما لقاء علاج بوني؟

280
00:23:20,830 --> 00:23:22,580
:في الحلقة القادمة من وان بيس

281
00:23:22,580 --> 00:23:26,130
!الغاية هي إنقاذ ابنته بوني"
"!المسالم الخجول كوما

282
00:23:26,130 --> 00:23:28,710
!ملك القراصنة، لن يكون إلاّ أنا