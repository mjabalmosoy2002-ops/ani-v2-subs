1
00:00:00,000 --> 00:00:11,040
يوجد قوس قزح وراء الأمطار الغزيرة

2
00:00:19,170 --> 00:00:22,680
سأعرف أنّ الجواب السّهل كذبة

3
00:00:23,930 --> 00:00:28,290
أعد ألاّ أتراجع أمام الصّراخ

4
00:00:28,290 --> 00:00:32,880
أحتاجك وحدك لتفهم الغد

5
00:00:32,880 --> 00:00:37,770
أعطيتني أفضل لحظات حياتي

6
00:00:39,190 --> 00:00:47,790
...ماذا أبدو؟ ملَكًا أم شيطانًا

7
00:00:47,790 --> 00:00:52,710
ما وراء الفجر، ما وراء الفجر

8
00:00:52,710 --> 00:00:58,230
ثمّة الكثير ممّا أريد أن أخبرك به

9
00:00:58,230 --> 00:01:03,050
مليء بالحبّ، بالحبّ

10
00:01:03,050 --> 00:01:08,870
الّذي لا يمكن كتابته في رسالة

11
00:01:05,100 --> 00:01:07,180
عزيزتي بوني

12
00:01:08,870 --> 00:01:17,400
يد صغيرة تبحث عن الأبديّة

13
00:01:26,570 --> 00:01:28,330
المقرّ الرّئيسيّ للجيش الثّوريّ
[بالتيغو]

14
00:01:37,560 --> 00:01:38,840
!نحتاج للدّعم

15
00:01:39,020 --> 00:01:41,800
!إنّ ثورة تومي في الأزرق الجنوبيّ تكاد تُقمع

16
00:01:41,800 --> 00:01:44,230
!نحتاج لتعزيزات في الحال رجاءً

17
00:01:48,280 --> 00:01:49,620
!أكرّر

18
00:01:49,620 --> 00:01:52,520
!إنّ ثورة تومي في الأزرق الجنوبيّ تكاد تُقمع

19
00:01:52,520 --> 00:01:55,330
!نحتاج لتعزيزات في الحال رجاءً

20
00:01:55,330 --> 00:01:56,640
!هذا مستحيل

21
00:01:56,640 --> 00:02:01,030
!سفينتنا مليئة سلفًا بالمصابين من مملكة غوا

22
00:02:04,590 --> 00:02:07,160
.أنا سأذهب يا إيفا-تشان

23
00:02:09,290 --> 00:02:10,780
!توقّف يا كوما

24
00:02:10,780 --> 00:02:14,210
إنّك تضغط على نفسك كثيرًا
...منذ ذلك اليوم المشؤوم

25
00:02:17,380 --> 00:02:18,500
!كوما

26
00:02:20,190 --> 00:02:21,380
!لا تذهب

27
00:02:26,000 --> 00:02:28,800
الأزرق الجنوبيّ
تومي

28
00:02:29,990 --> 00:02:31,100
!سُحقًا

29
00:02:31,100 --> 00:02:33,220
.هذه نهايتكم أيّها المتمرّدون

30
00:02:51,490 --> 00:02:53,620
اختُطفت جيني؟

31
00:02:53,820 --> 00:02:57,870
ذلك صحيح، يبدو أنّ تنّينًا سماويًّا
...وضع عينيه عليها

32
00:02:59,420 --> 00:03:04,170
وأخذوها على متن سفينة تابعة
.للحكومة ليتّخذها زوجة له

33
00:03:28,700 --> 00:03:31,200
.صدمة الدّبّ

34
00:03:48,730 --> 00:03:50,370
الجيش الثّوريّ؟

35
00:03:51,220 --> 00:03:53,500
...مـ-مذهل

36
00:03:57,950 --> 00:04:01,270
!لقد أثمرت هذه الأعوام الثّلاثة من الكفاح

37
00:04:01,270 --> 00:04:03,730
!شكرًا لكم أيّها الجيش الثّوريّ

38
00:04:07,910 --> 00:04:11,440
!إنّهم أبطال الشّعوب

39
00:04:19,750 --> 00:04:22,920
!وصلت تعزيزات مفاجئة وسُحقت قوّاتنا

40
00:04:25,360 --> 00:04:27,510
!أنا آسف

41
00:04:27,510 --> 00:04:30,130
!أنا آسف بالفعل

42
00:04:34,770 --> 00:04:37,160
.هذا أنا يا دراغون

43
00:04:37,450 --> 00:04:38,640
...أنا متعب

44
00:04:39,120 --> 00:04:40,850
.سأعود على متن سفينة

45
00:04:48,430 --> 00:04:53,270
"!وعد لجيني! يصير كوما والدًا"

46
00:04:56,130 --> 00:05:01,460
مرّت سنتان على اختطاف إحدى
قادة الجيش الثّوريّ جيني

47
00:05:01,460 --> 00:05:04,060
.لتصير زوجة لتنّين سماويّ

48
00:05:19,250 --> 00:05:20,520
...أنا جدّ آسفة

49
00:05:25,920 --> 00:05:28,900
.وصلنا يا بوني

50
00:05:39,840 --> 00:05:42,990
!كوما! إنّها مكالمة من جيني

51
00:05:44,220 --> 00:05:46,030
!أفسحوا الطّريق

52
00:05:46,850 --> 00:05:50,840
!جيني

53
00:05:48,430 --> 00:05:49,630
أخي الكبير؟

54
00:05:53,070 --> 00:05:54,930
!مرحبًا يا كوماتشي

55
00:05:54,930 --> 00:05:57,390
!عدت أخيرًا إلى العالم السّفليّ

56
00:05:57,390 --> 00:06:00,420
!كنّا قلقين جدًّا عليك

57
00:06:00,420 --> 00:06:02,770
!جيني... أنا سعيد جدًّا لأنّك بخير

58
00:06:04,470 --> 00:06:05,480
...نعم

59
00:06:05,920 --> 00:06:08,440
،لكنّي مريضة

60
00:06:08,800 --> 00:06:11,470
.لذلك قرّروا التّخلّص منّي

61
00:06:12,210 --> 00:06:13,650
!يا لحظّي، صحيح؟

62
00:06:13,980 --> 00:06:15,260
أنت مريضة؟

63
00:06:17,400 --> 00:06:18,950
ماذا تقصدين يا جيني؟

64
00:06:19,550 --> 00:06:22,410
،أتمنّى لو أستطيع رؤيتكم ثانية

65
00:06:22,410 --> 00:06:25,270
.لكنّي اتّصلت بكم فقط لأودّعكم

66
00:06:25,270 --> 00:06:26,360
!ماذا؟

67
00:06:26,590 --> 00:06:28,250
!ما الّذي تقولينه يا جيني؟

68
00:06:28,690 --> 00:06:31,340
!ظننتُ أنّي لن أراك ثانية

69
00:06:31,340 --> 00:06:33,840
!أين أنت؟ سأوافيك في الحال

70
00:06:39,120 --> 00:06:41,470
.أنا آسفة يا كوماتشي

71
00:06:41,470 --> 00:06:44,790
.سأموت عمّا قريب

72
00:06:50,010 --> 00:06:51,810
ستموتين؟

73
00:06:52,600 --> 00:06:54,820
ماذا؟ لماذا ستموتين؟

74
00:06:55,090 --> 00:06:57,510
!سأنقذك

75
00:06:59,220 --> 00:07:00,870
!أنا قادم إليك الآن

76
00:07:03,550 --> 00:07:05,200
،كوماتشي

77
00:07:05,560 --> 00:07:09,710
،أنا مسرورة لأنّك تريد إنقاذي
.لكن ليس عليك أن تأتي

78
00:07:10,060 --> 00:07:12,710
،سوف ننقذك يا جيني

79
00:07:14,460 --> 00:07:16,520
!لذلك أخبرينا أين أنت فحسب

80
00:07:20,310 --> 00:07:21,550
!ابتعدوا عن طريقي

81
00:07:21,550 --> 00:07:22,680
كوما؟

82
00:07:22,860 --> 00:07:24,350
!إلى أين أنت ذاهب؟

83
00:07:24,760 --> 00:07:28,140
.ثمّة مكان واحد فقط تعتبره منزلها

84
00:07:28,720 --> 00:07:31,370
...دراغون، أخي الكبير

85
00:07:33,820 --> 00:07:37,280
،اعتنيا بعزيزنا كوماتشي رجاءً
.إنّ طيبة قلبه لا تعرف الحدود

86
00:07:46,870 --> 00:07:49,080
...وتذكّر يا كوماتشي

87
00:07:50,680 --> 00:07:52,040
...سأظلّ دائمًا

88
00:07:53,190 --> 00:07:54,730
...دائمًا

89
00:07:58,990 --> 00:08:00,220
...أحبّك

90
00:08:10,770 --> 00:08:13,480
كوما؟ هل عدت؟

91
00:08:13,480 --> 00:08:15,730
جيني هنا، صحيح؟ أين هي؟

92
00:08:15,730 --> 00:08:17,360
...إنّها هنا، لكن

93
00:08:19,640 --> 00:08:23,320
!جيني

94
00:08:29,140 --> 00:08:32,330
لماذا؟ ماذا حدث؟

95
00:08:32,330 --> 00:08:35,840
...إنّ وجهها وسائر جسدها

96
00:08:35,840 --> 00:08:41,720
،قالت أنّها إذا تعرّضت لنور طبيعيّ
.ستصير بشرتها زرقاء وصلبة كالحجر

97
00:08:41,920 --> 00:08:45,680
مسكينة... ما هذا المرض الّذي نزل بها؟

98
00:08:48,580 --> 00:08:50,230
!كوماتشي

99
00:08:50,770 --> 00:08:52,690
!هذا لذيذ جدًّا

100
00:08:54,650 --> 00:08:56,400
!كوماتشي

101
00:08:59,010 --> 00:09:02,410
!لنتزوّج يا كوماتشي

102
00:09:11,580 --> 00:09:13,580
!سأجعلك أسعد رجل في العالم

103
00:09:15,700 --> 00:09:17,160
!كوماتشي

104
00:09:23,400 --> 00:09:26,260
،أرادت أن تحظى ابنتها بمستقبل

105
00:09:26,260 --> 00:09:28,720
.حتّى إن لم تكن هي جزءًا منه

106
00:09:32,410 --> 00:09:38,230
أبحرت تحت نور الشّمس لتصل
.إلى هنا بآخر ما تبقّى لها من قوّة

107
00:09:44,710 --> 00:09:47,490
.لا تقلقي يا جيني

108
00:09:47,490 --> 00:09:50,330
.سأعتني بابنتك

109
00:09:59,500 --> 00:10:01,340
جيني

110
00:10:05,590 --> 00:10:08,600
جيني

111
00:10:33,330 --> 00:10:35,730
!كلاّ

112
00:10:35,730 --> 00:10:38,540
!زاوية الرّضّاعة ليست صحيحة

113
00:10:38,540 --> 00:10:41,370
و-و-وهكذا؟

114
00:10:42,050 --> 00:10:44,130
!أنا آسف

115
00:10:44,130 --> 00:10:46,530
!ستخنق بوني-تشان هكذا

116
00:10:46,530 --> 00:10:48,430
!دعني أنا أقوم بذلك

117
00:10:48,430 --> 00:10:52,000
!ضعها في فقص فولاذيّ عندما تنام

118
00:10:52,000 --> 00:10:55,570
.أنت ضخم، قد تسحقها عن طريق الخطأ

119
00:11:10,960 --> 00:11:13,540
.يا لظرافتها

120
00:11:13,540 --> 00:11:16,340
!لدى بوني-تشان شهيّة كبيرة

121
00:11:16,340 --> 00:11:19,720
!إنّها نهمة مثل جيني تمامًا

122
00:11:23,710 --> 00:11:24,960
!هذا غير كافٍ

123
00:11:27,830 --> 00:11:29,470
.بالتّأكيد

124
00:11:33,280 --> 00:11:37,180
!أشحتُ نظري عنها لوهلة وقد صارت هناك سلفًا

125
00:11:44,610 --> 00:11:47,360
!نعم، هذا جيّد يا بوني

126
00:11:52,550 --> 00:11:55,080
!أ-أبي

127
00:11:56,830 --> 00:11:58,330
!أبي

128
00:12:02,420 --> 00:12:05,170
!نعم، هذا أنا أبوك

129
00:13:42,850 --> 00:13:45,880
!مرحبًا يا بوني

130
00:13:46,330 --> 00:13:48,070
!لقد عدت

131
00:13:50,340 --> 00:13:52,150
.مرحبًا بك

132
00:14:18,550 --> 00:14:19,600
كوما؟

133
00:14:26,900 --> 00:14:31,360
لماذا تسدّ كلّ نوافذ الكنيسة؟

134
00:14:34,010 --> 00:14:35,570
!أغلقا الباب

135
00:14:38,600 --> 00:14:39,780
...انظرا لهذا

136
00:14:40,570 --> 00:14:42,370
!حجارة زرقاء؟

137
00:14:42,370 --> 00:14:44,220
...لكنّ هذا

138
00:14:44,220 --> 00:14:45,760
—المرض الّذي قتل جيني

139
00:14:45,760 --> 00:14:46,790
!توقّف

140
00:14:46,790 --> 00:14:48,670
!سأستدعي الطّبيب

141
00:14:50,140 --> 00:14:51,500
...شكرًا

142
00:14:54,050 --> 00:14:55,510
...حسنًا

143
00:14:55,850 --> 00:14:57,810
هذا بسبب تعرّضها للنّور؟

144
00:14:57,810 --> 00:14:59,100
فعلاً؟

145
00:14:59,100 --> 00:15:00,300
.نعم

146
00:15:02,880 --> 00:15:04,780
—لنخرج ونرَ

147
00:15:04,780 --> 00:15:06,480
!لا تتفوّه بالسّخافات

148
00:15:07,260 --> 00:15:10,480
...إنّه ليس تسمّم الرّصاص الأبيض

149
00:15:10,640 --> 00:15:13,930
.أنا آسفة، لكنّ هذه الأعراض غريبة عليّ

150
00:15:13,930 --> 00:15:15,370
...فهمت

151
00:15:15,500 --> 00:15:17,580
أبي؟

152
00:15:19,470 --> 00:15:21,710
.ستكونين بخير يا بوني

153
00:15:22,760 --> 00:15:25,120
!تريد ترك الجيش الثّوريّ؟

154
00:15:25,120 --> 00:15:28,580
!هل أصيبت بوني بنفس المرض بالفعل؟

155
00:15:28,580 --> 00:15:29,930
...نعم

156
00:15:29,930 --> 00:15:31,840
...لا أعرف ما العمل

157
00:15:32,520 --> 00:15:34,000
.لكنّي أريد البقاء إلى جانبها

158
00:15:34,810 --> 00:15:38,440
.مفهوم. عش حياتك بلا أيّ ندم

159
00:15:38,440 --> 00:15:41,760
سنسأل أطبّاء من كلّ أنحاء
.العالم قدر المستطاع

160
00:15:42,120 --> 00:15:44,160
.شكرًا لك يا دراغون

161
00:15:45,140 --> 00:15:49,420
قبل سبع سنوات

162
00:15:46,530 --> 00:15:50,630
...مرّ وقت وبلغت بوني الخامسة من عمرها

163
00:15:56,290 --> 00:15:57,890
!اهربوا

164
00:15:57,890 --> 00:16:00,250
!وإلاّ فستلتهمنا مصّاصة الدّماء

165
00:16:04,240 --> 00:16:07,960
بوني
‫(5 سنوات)

166
00:16:05,050 --> 00:16:07,960
!ارجعوا إلى هنا أيّها الأوغاد الصّغار

167
00:16:09,980 --> 00:16:12,470
!لا يمكنك الخروج أكثر

168
00:16:13,250 --> 00:16:15,620
!لا يخرج مصّاصو الدّماء في العلن

169
00:16:15,620 --> 00:16:18,130
!انظري إلى هذا الصّليب اللاّمع

170
00:16:19,690 --> 00:16:21,190
!هذا مؤلم

171
00:16:21,190 --> 00:16:23,050
!ألا ترى أنّنا في كنيسة أصلاً؟

172
00:16:25,060 --> 00:16:27,020
!سآتي لألقّنكم درسًا في الخارج

173
00:16:27,020 --> 00:16:29,080
!تمهّلي يا بوني

174
00:16:29,080 --> 00:16:30,730
.أبي

175
00:16:30,990 --> 00:16:35,630
رؤيتك عند المدخل وحدها تبعث
...القشعريرة في بدني

176
00:16:35,630 --> 00:16:38,760
.يا لك من جبان
.أنا أمزح معهم فحسب

177
00:16:38,760 --> 00:16:41,200
...لا تمازحيهم هكذا

178
00:16:41,200 --> 00:16:43,060
.فهمت

179
00:16:43,400 --> 00:16:46,660
.لا أحبّ أن أراك حزينًا على أيّ حال

180
00:16:46,660 --> 00:16:48,540
!بوني

181
00:16:49,600 --> 00:16:52,270
!كبرت وصرت فتاة طيّبة

182
00:16:52,270 --> 00:16:54,080
!اتركني أيّها البكّاء

183
00:16:55,290 --> 00:16:57,000
...إنّ أولئك الأولاد

184
00:16:57,580 --> 00:17:02,330
!سخروا مجدّدًا من الحجارة الّتي على وجهي

185
00:17:03,180 --> 00:17:05,540
!هل هي غريبة لهذه الدّرجة؟

186
00:17:05,540 --> 00:17:07,970
...أنا مريضة، لذلك ما بيدي حيلة

187
00:17:08,270 --> 00:17:09,990
!تقصدين تلك الجواهر؟

188
00:17:09,990 --> 00:17:11,090
!أنت تخيفني

189
00:17:11,090 --> 00:17:13,650
.إنّهم يغارون منكِ فقط لأنّها جميلة

190
00:17:13,650 --> 00:17:14,880
ماذا؟

191
00:17:16,150 --> 00:17:17,610
!أتظنّ ذلك؟

192
00:17:17,790 --> 00:17:20,980
!نعم، أنا أحبّها

193
00:17:24,050 --> 00:17:29,230
بوني، إلى أين ترغبين بالذّهاب عندما تُشفين؟

194
00:17:31,490 --> 00:17:33,290
!هل تعرف بأمر جُزر السّماء؟

195
00:17:33,290 --> 00:17:35,670
جُزر في السّماء؟ وهل توجد حقًّا؟

196
00:17:35,670 --> 00:17:38,380
!بالطّبع! قرأت عنها في كتاب

197
00:17:41,610 --> 00:17:42,930
!انظر

198
00:17:42,930 --> 00:17:47,820
،جُزر السّماء قريبة جدًّا من الشّمس
!لذلك ربّما يكون نيكا هناك أيضًا

199
00:17:47,820 --> 00:17:50,770
.أراهن أنّنا سنسعد كثيرًا بالذّهاب إلى هناك

200
00:17:52,020 --> 00:17:53,890
!نيكا؟

201
00:17:59,710 --> 00:18:02,150
!ها هي ذي! رقصة نيكا

202
00:18:06,070 --> 00:18:08,910
!سيكون الذّهاب للسّماء مغامرة مذهلة

203
00:18:08,910 --> 00:18:11,140
!ربّما سنقوم بذلك عندما تبلغين العشرين

204
00:18:11,140 --> 00:18:12,040
!حسنًا

205
00:18:12,390 --> 00:18:14,610
وأين ستذهبين في سنّ التّاسعة عشرة؟

206
00:18:14,610 --> 00:18:16,130
!جزيرة البرمائيّين

207
00:18:21,690 --> 00:18:26,390
أخشى أنّ ابنتك تعاني من مرض حراشف
.الياقوت الأزرق الّذي لا علاج له

208
00:18:26,390 --> 00:18:28,040
هل تعرف بأمره؟

209
00:18:28,040 --> 00:18:29,100
.نعم

210
00:18:29,100 --> 00:18:31,870
آسف، هلا تكلّمت بصوت أخفت؟

211
00:18:31,870 --> 00:18:34,560
.إنّه مرض نادر ظهر حديثًا فحسب

212
00:18:34,560 --> 00:18:40,330
تظهر الحجارة عندما تتعرّض البشرة لنور
.الشّمس أو القمر أو أيّ نور طبيعيّ

213
00:18:40,710 --> 00:18:46,260
لكنّ حجب كلّ النّور عن المريض
.لن يوقف المرض من التّقدّم مع الوقت

214
00:18:46,260 --> 00:18:47,160
ماذا؟

215
00:18:47,160 --> 00:18:48,710
!لن تُشفى أبدًا؟

216
00:18:48,710 --> 00:18:51,690
!ابنتي بوني... ستنجو، أليس كذلك؟

217
00:18:53,980 --> 00:18:58,030
...سأكون صريحًا معك، أمام ابنتك

218
00:18:58,130 --> 00:18:59,840
.خمس سنوات أخرى لتعيشها على الأكثر

219
00:19:01,420 --> 00:19:05,300
على الأرجح أنّها ستفارق الحياة
.قبل أن تتمّ عامها العاشر

220
00:19:05,730 --> 00:19:08,350
لا يوجد ما يمكنك فعله؟

221
00:19:08,350 --> 00:19:11,530
.لا نعرف كيف نعالج المرض

222
00:19:11,530 --> 00:19:12,760
...العاشرة من عمرها

223
00:19:18,040 --> 00:19:19,610
...ولكن

224
00:19:19,980 --> 00:19:22,860
...إنّها مليئة بالحياة

225
00:19:32,320 --> 00:19:36,660
!ألا توجد أيّ طريقة لعلاجها بالفعل؟

226
00:19:44,920 --> 00:19:46,920
!بوني؟ ألم تكوني نائمة؟

227
00:19:46,920 --> 00:19:49,970
!لقد سمعتك

228
00:19:51,510 --> 00:19:52,880
ماذا؟

229
00:19:53,160 --> 00:19:54,910
.قلتَ العاشرة من عمرها

230
00:19:55,740 --> 00:19:57,770
العاشرة؟ عمّا تتكلّمين؟

231
00:19:57,950 --> 00:20:00,230
.سمعتك تتحدّث عن عندما أبلغ العاشرة

232
00:20:00,230 --> 00:20:02,900
ماذا؟ هل تبكي؟

233
00:20:02,960 --> 00:20:05,360
كنت تتكلّم عنّي، صحيح؟

234
00:20:05,360 --> 00:20:07,530
...ذلك صحيح

235
00:20:07,530 --> 00:20:10,320
...في عيد مولدك العاشر

236
00:20:10,320 --> 00:20:13,000
...فإنّ مرضك يا بوني سوف

237
00:20:13,000 --> 00:20:16,790
قال ذلك الطّبيب أنّك لن تتحسّني
.حتّى تبلغي العاشرة

238
00:20:17,410 --> 00:20:18,500
فعلاً؟

239
00:20:18,500 --> 00:20:23,210
.حزنتُ لأنّه قيل لي أنّ الأمر سيأخذ وقتًا

240
00:20:23,600 --> 00:20:25,390
!ممتاز

241
00:20:25,390 --> 00:20:28,170
سأشفى عندما أبلغ العاشرة؟

242
00:20:28,170 --> 00:20:31,140
بإمكاننا السّفر معًا بعدها؟

243
00:20:31,210 --> 00:20:34,930
.بالطّبع! ستكونين أفضل عندما تبلغين العاشرة

244
00:20:34,930 --> 00:20:37,090
!ممتاز

245
00:20:37,240 --> 00:20:39,940
كلاّ... ما الّذي فعلت؟

246
00:20:40,890 --> 00:20:44,790
،وفي أحد الأيّام بعد سنة

247
00:20:45,250 --> 00:20:49,400
.غرقت مملكة سوربي في كابوس مرّة أخرى

248
00:20:50,470 --> 00:20:52,110
!كوما

249
00:20:52,110 --> 00:20:54,810
!كوماتشي! ساعدنا

250
00:20:54,810 --> 00:20:57,370
!عاد الملك بيكوري لسابق عهده

251
00:20:57,370 --> 00:20:59,700
!كما كان قبل 16 سنة

252
00:20:59,700 --> 00:21:02,960
إنّه يريد حرق كلّ من يشكّل عبئًا
!على البلاد في نظره

253
00:21:02,960 --> 00:21:07,710
!لا يملك ذلك الرّجل ذرّة إنسانيّة
!تُقام المجازر في الشّوارع

254
00:21:28,320 --> 00:21:33,570
ما عدت أستطيع حماية أحد ثانية

255
00:21:33,570 --> 00:21:38,370
إنّ تلاشي الصّوت خطئي أنا

256
00:21:38,370 --> 00:21:40,660
ما عاد لديّ وقت حتّى للنّظر للأسف

257
00:21:40,660 --> 00:21:43,250
ثمّة آثار حصى على راحَتَيَّ

258
00:21:43,250 --> 00:21:47,040
ابدئي بالتّحرّك ثانية يا سفينتي

259
00:21:47,040 --> 00:21:52,130
مع أنّي لا أستطيع الطّيران في السّماء الواسعة

260
00:21:52,130 --> 00:21:58,180
بإمكاني إضاءة البحر العميق

261
00:21:58,180 --> 00:21:58,970
نحن

262
00:21:58,970 --> 00:22:01,480
ودائمًا، لا يمكننا السّماح أن تكون هذه النّهاية

263
00:22:01,480 --> 00:22:04,100
ودائمًا، لا يمكننا أن نُهزم

264
00:22:04,100 --> 00:22:07,900
لدينا شيء ما هنا لحمايته

265
00:22:07,900 --> 00:22:10,320
قد لا يكون هذا ما توقّعتُه

266
00:22:10,320 --> 00:22:13,110
لكن لا يمكننا أن نتوقّف هنا

267
00:22:13,110 --> 00:22:18,450
سننطلق الآن ونتشارك الوحدة

268
00:22:18,450 --> 00:22:21,160
لا داعي للخوف

269
00:22:21,160 --> 00:22:25,120
لستُ نفس الشّخص الّذي كنتُه يومها

270
00:22:25,120 --> 00:22:28,920
لا يستطيع أحد الوقوف في طريقي

271
00:22:28,920 --> 00:22:30,210
والآن، ابتعدوا

272
00:22:30,210 --> 00:22:32,780
اغزُ العالم، آمن بالمستقبل

273
00:22:32,780 --> 00:22:35,320
عدّ اللّيالي

274
00:22:35,320 --> 00:22:38,030
ماذا رأيت؟ ماذا تعلّمت؟

275
00:22:38,030 --> 00:22:41,680
لإدراك ما هو مهمّ

276
00:22:50,570 --> 00:22:54,570
ينطلق كوما في رحلة لإنقاذ
.حياة ابنته المحبوبة

277
00:22:54,570 --> 00:22:58,990
.يلتقي بعالِم عبقريّ في نهاية العالم

278
00:22:58,990 --> 00:23:01,580
هل ذلك الرّجل شيطان أم قدّيس؟

279
00:23:01,780 --> 00:23:06,830
ما هو الشّرط الغريب والكبير الّذي
عُرض على كوما لقاء علاج بوني؟

280
00:23:06,830 --> 00:23:08,580
:في الحلقة القادمة من وان بيس

281
00:23:08,580 --> 00:23:12,130
!الغاية هي إنقاذ ابنته بوني"
"!المسالم الخجول كوما

282
00:23:12,130 --> 00:23:14,710
!ملك القراصنة، لن يكون إلاّ أنا