1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:07,370
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

3
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

4
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

5
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

6
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

7
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

8
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

9
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

10
00:00:40,950 --> 00:00:42,570
!وان بيس

11
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

12
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

13
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

14
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

15
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

16
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

17
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

18
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

19
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

20
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

21
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

22
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

23
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

24
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

25
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

26
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

27
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

28
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

29
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

30
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

31
00:02:30,680 --> 00:02:33,990
هل أنتم مجانين؟! لا تظنّوا أنّكم ستنجون

32
00:02:33,990 --> 00:02:35,850
!بعد جعلكم للعالم بأسره عدوًّا لكم

33
00:02:36,500 --> 00:02:40,690
سأطارد تلك المرأة حتّى
...أقاصي الأرض وأقضي عليها

34
00:02:41,190 --> 00:02:43,360
!أريد أن أعيش

35
00:02:46,820 --> 00:02:53,690
!الرّشّاش النّفّاث

36
00:03:31,220 --> 00:03:32,080
!لوفي

37
00:03:32,730 --> 00:03:33,870
!...لوفي

38
00:03:36,010 --> 00:03:37,830
!...العمود الأوّل

39
00:03:41,000 --> 00:03:43,370
.هـ-هذا تقرير إلى كلّ السّفن

40
00:03:43,370 --> 00:03:44,920
!تقرير إلى كلّ السّفن

41
00:03:45,500 --> 00:03:49,090
...السّيّد روب لوتشي من السّي بي 9

42
00:03:49,440 --> 00:03:52,930
الّذي كان يواجه القرصان
...قبّعة القشّ لوفي

43
00:03:53,810 --> 00:03:56,930
!قد هُزم

44
00:04:02,700 --> 00:04:03,730
...لوفي

45
00:04:07,610 --> 00:04:08,920
...انتهى الأمر

46
00:04:09,880 --> 00:04:12,200
.سنكون بخير الآن

47
00:04:16,660 --> 00:04:20,580
!سنعود معًا جميعًا

48
00:04:21,400 --> 00:04:26,050
!روبين

49
00:04:41,890 --> 00:04:46,930
!ومن عُرض البحر، يظهر صديق"
"!رابط قراصنة قبّعة القشّ الأقوى

50
00:04:49,790 --> 00:04:50,490
...هـ

51
00:04:50,870 --> 00:04:52,740
!هـ-هذا غير ممكن

52
00:04:53,120 --> 00:04:56,080
يُعتبر السّيّد روب لوتشي
قائد السّي بي 9 الحاليّ

53
00:04:56,080 --> 00:04:58,510
.الأقوى في تاريخ سايفر بول

54
00:04:58,510 --> 00:05:04,640
يصعب التّصديق أنّ حتّى
!...هو قد هُزم على يد قرصان

55
00:05:22,140 --> 00:05:26,110
!فاز لوفي

56
00:05:52,860 --> 00:05:54,840
.لقد أقلقني عليه لوهلة

57
00:05:54,840 --> 00:05:57,260
!نجحت أخيرًا إذًا يا قبّعة القشّ

58
00:05:57,710 --> 00:05:58,930
!لوفي

59
00:06:01,060 --> 00:06:04,390
يا رفاق! لنصعد سفينة الهروب
!في الحال! سوف نشدّ رحالنا

60
00:06:06,280 --> 00:06:08,610
!فعلتَها يا لوفي

61
00:06:11,310 --> 00:06:13,610
!فعلتَها يا قبّعة القشّ

62
00:06:14,820 --> 00:06:18,030
!أ-أيّها المغفّلون! بإمكانهم سماعنا

63
00:06:18,370 --> 00:06:20,940
!لا بأس بذلك! سنُعلمه بذلك

64
00:06:20,940 --> 00:06:22,910
!أنتم! لمن هذه الأصوات؟

65
00:06:23,350 --> 00:06:26,710
لا ندري! إنّها تصدر من مكان ما
!عبر حلزون الاتّصال

66
00:06:26,710 --> 00:06:28,880
!أخي

67
00:06:36,080 --> 00:06:38,270
...ماذا؟! هذا الصّوت

68
00:06:49,100 --> 00:06:54,220
،توقّفوا! لو أنّنا غادرنا فحسب
!لكنّا أمواتًا في أنظارهم الآن

69
00:06:54,220 --> 00:06:55,650
...يا رفاق

70
00:06:56,320 --> 00:06:57,450
...هؤلاء

71
00:07:01,450 --> 00:07:04,990
أيعقل أنّهم القراصنة الّذين أطحنا
بهم عند البوّابة الرّئيسيّة؟

72
00:07:04,990 --> 00:07:09,790
كلاّ، لا يمكن... أنا واثق أنّهم
!وقعوا جميعًا من الجرف

73
00:07:09,790 --> 00:07:11,460
.من المستحيل أن يكونوا قد نجوا

74
00:07:18,420 --> 00:07:21,170
!سُحقًا! إنّه هجوم مدفع

75
00:07:21,170 --> 00:07:23,390
!أخي

76
00:08:01,870 --> 00:08:03,890
!أيّها الغبيّ! لا تدفع

77
00:08:03,890 --> 00:08:04,980
!لا تتحرّك

78
00:08:04,980 --> 00:08:06,310
!سنسقط

79
00:08:06,310 --> 00:08:07,360
!ستنقطع الحبال

80
00:08:07,360 --> 00:08:10,390
!أيّها الأوغاد! حبال غالي-لا لا تنقطع أبدًا

81
00:08:11,580 --> 00:08:13,480
يا إلهي، مع أنّي أخبرتكم
...أن تلزموا الصّمت

82
00:08:14,480 --> 00:08:16,960
!جميعنا بخير

83
00:08:16,960 --> 00:08:20,730
!تكبّد العملاقان جلّ نيران المدفع

84
00:08:21,490 --> 00:08:24,460
.مدهش! إنّهم أشدّاء بالفعل

85
00:08:24,460 --> 00:08:27,160
!يا جدّتي! جميعهم على قيد الحياة

86
00:08:28,410 --> 00:08:31,060
!سودوم وغومورا بخير أيضًا

87
00:08:31,060 --> 00:08:32,460
!سعيد لسماعي لهذا

88
00:08:32,460 --> 00:08:36,650
،حسنًا، إن أطلنا البقاء هنا أكثر
!فستعود السّفن الحربيّة ثانيةً

89
00:08:36,650 --> 00:08:38,140
!لنسرع ونغادر المكان

90
00:08:38,140 --> 00:08:43,050
،على أيّ حال... لدينا وسيلة هرب
!لذلك لا تقلق علينا

91
00:08:43,050 --> 00:08:44,690
!سنراك بعد أن نخرج من هنا أحياء

92
00:08:44,690 --> 00:08:45,880
!هذا صحيح

93
00:08:45,880 --> 00:08:46,930
!لنسرع

94
00:08:47,460 --> 00:08:50,140
!عليكم الإسراع والتّسلّق بسرعة

95
00:08:50,430 --> 00:08:52,880
!إنّ الدّماء تتدفّق صعودًا إلى رأسي

96
00:08:52,880 --> 00:08:55,150
!بل نزولاً في الواقع

97
00:08:55,670 --> 00:08:57,420
!حسنًا، تسلّقوا

98
00:08:58,230 --> 00:08:59,910
!تسلّقوا ببطء

99
00:08:59,910 --> 00:09:01,170
!سوف نسقط

100
00:09:02,070 --> 00:09:03,910
!لا تهتزّوا

101
00:09:04,440 --> 00:09:07,080
!...يا رفاق...! يا أغبياء

102
00:09:07,080 --> 00:09:11,080
!لم أكن قلقًا عليكم يا رفاق! يا لكم من أغبياء

103
00:09:12,620 --> 00:09:18,040
!هؤلاء الأغبياء أحياء
!أنا... أنا جدّ سعيد بذلك

104
00:09:20,070 --> 00:09:22,750
.نعم. يا لها من راحة بالفعل

105
00:09:23,370 --> 00:09:26,220
لكن لا فائدة إن متّ هنا، صحيح؟

106
00:09:28,110 --> 00:09:29,910
.نعم. معك حقّ

107
00:09:31,310 --> 00:09:33,810
!هل علينا التّوجّه للبوّابة الرّئيسيّة في الحال؟

108
00:09:34,200 --> 00:09:37,230
،افعلوا ذلك لاحقًا. أمّا الآن
.علينا تركيز جهودنا هنا

109
00:09:37,230 --> 00:09:41,240
!ما الّذي تفعلونه جميعًا؟
!واصلوا تنفيذ واجبكم بسرعة

110
00:09:41,240 --> 00:09:42,240
!حاضر

111
00:09:46,820 --> 00:09:50,540
!يا هؤلاء! هلمّوا عليّ بالقدر الّذي تشاؤون

112
00:09:51,450 --> 00:09:54,170
!جوّ الصّاعقة

113
00:09:57,090 --> 00:09:58,590
!فخّ النّمر

114
00:09:59,090 --> 00:10:00,840
!قاطع الغول

115
00:10:01,810 --> 00:10:03,300
!مدفع العنقاء

116
00:10:08,360 --> 00:10:10,060
!مائة زهرة

117
00:10:18,350 --> 00:10:21,270
!راقبوا قبّعة القشّ في العمود الأوّل

118
00:10:21,270 --> 00:10:23,620
...حا-حاضر، لكن

119
00:10:25,240 --> 00:10:29,380
يبدو أنّ قبّعة القشّ لوفي
!مصاب إصابات خطيرة أيضًا

120
00:10:29,380 --> 00:10:32,750
!إنّه لا يتحرّك على الإطلاق

121
00:10:34,440 --> 00:10:35,370
!ماذا قال؟

122
00:10:57,770 --> 00:10:59,730
!يا لوفي

123
00:11:00,070 --> 00:11:03,760
!ما الّذي تفعله؟! أسرع وغادر ذلك المكان

124
00:11:03,760 --> 00:11:05,610
!علينا أن نهرب وإلاّ فلن ننجو

125
00:11:12,500 --> 00:11:15,820
!ما الخطب؟! نكاد ننتهي

126
00:11:15,820 --> 00:11:17,790
!استعمل قوى المطّاط لترمي بنفسك إلى هنا

127
00:11:17,790 --> 00:11:20,080
!سأحملك بمجرّد أن تأتي إلى هنا

128
00:11:25,800 --> 00:11:28,580
نحن محاصرون بين البحر
!ومجموعة سفن حربيّة

129
00:11:28,580 --> 00:11:30,970
!سوف نُقتل إن بقينا هنا

130
00:11:31,500 --> 00:11:35,000
يبدو أنّ القراصنة يحاولون الهرب
.باستعمال سفينة المرافقة

131
00:11:35,000 --> 00:11:35,980
.نعم

132
00:11:36,310 --> 00:11:38,940
!لوفي

133
00:11:46,870 --> 00:11:51,490
!لوفي! أيمكنك سماعي يا لوفي؟

134
00:11:53,930 --> 00:11:55,350
...لا-لا أستطيع

135
00:11:59,480 --> 00:12:00,500
...إنّ جسدي

136
00:12:06,690 --> 00:12:08,630
.يأبى أن يتحرّك

137
00:12:09,360 --> 00:12:10,810
يأبى أن يتحرّك...؟

138
00:12:11,950 --> 00:12:15,890
!لا تكن سخيفًا! هزمتَ العدوّ

139
00:12:15,890 --> 00:12:20,350
!استعدنا روبين أيضًا
!كلّ ما بقي لنا هو العودة

140
00:12:20,350 --> 00:12:22,770
!أرجوك! ابذل جهدًا أكبر

141
00:12:29,880 --> 00:12:30,530
!أوسوبّ

142
00:12:33,490 --> 00:12:36,670
!لنأخذ السّفينة إلى العمود حيث لوفي

143
00:12:36,670 --> 00:12:38,450
!يا رفاق! أسرعوا على متن السّفينة

144
00:12:39,770 --> 00:12:40,370
!أطلقوا

145
00:12:53,260 --> 00:12:54,970
!...كلاّ! سفينة هروبنا

146
00:12:59,810 --> 00:13:02,950
...مصيبة...! الوضع ميؤوس منه الآن

147
00:13:02,950 --> 00:13:06,570
فيما عدا تلك السّفينة، فلا توجد
!طريقة أخرى للهرب من هنا

148
00:13:13,200 --> 00:13:17,030
!كوكورو-سان... تشيمني... غونبي... تشوبّر

149
00:13:38,710 --> 00:13:40,720
...مـ-مستحيل

150
00:13:54,150 --> 00:13:55,530
!سأموت

151
00:14:00,700 --> 00:14:02,870
!إنّهم بخير بطريقة ما

152
00:14:03,410 --> 00:14:04,620
!ابتعدوا عن طريقي

153
00:14:04,620 --> 00:14:06,010
!هذا ممتاز

154
00:14:14,760 --> 00:14:17,800
!سانجي-كُن! أين كنت طوال هذا الوقت؟

155
00:14:20,160 --> 00:14:22,900
.أنا آسف بشأن ذلك
.كان عليّ تولّي أمر ما

156
00:14:25,030 --> 00:14:27,810
.ولكنّ حالنا هذا فظيع
!نحن في وضع لا نحسد عليه

157
00:14:28,500 --> 00:14:30,590
،بما أنّنا أنقذنا روبين-تشان

158
00:14:30,590 --> 00:14:33,530
ظننت أنّهم لن يهاجموا هذه
...المنطقة. لكنّ السّفينة

159
00:14:35,320 --> 00:14:38,570
!هذه نهايتكم يا أوغاد
...دع العجوز الآن و

160
00:14:38,570 --> 00:14:41,160
!لا وقت لذلك

161
00:14:41,700 --> 00:14:43,710
!ركل حوريّة البحر

162
00:14:48,990 --> 00:14:50,000
.أطلقوا

163
00:14:56,610 --> 00:14:58,290
!إنّهم يطلقون على رجالهم أيضًا

164
00:14:58,290 --> 00:15:00,100
!حاصروهم في العمود الثّاني

165
00:15:00,470 --> 00:15:01,310
!أطلقوا

166
00:15:04,730 --> 00:15:07,570
!انتبهوا! اركضوا! اركضوا

167
00:15:09,040 --> 00:15:09,960
!أطلقوا

168
00:15:51,370 --> 00:15:54,950
!سُحقًا! لقد هدموا الجسر بأكمله أخيرًا

169
00:15:54,950 --> 00:15:56,470
!إنّنا محاصرون على هذا العمود

170
00:15:56,470 --> 00:15:58,850
!ليست لدينا أيّ خيارات أخرى

171
00:15:58,850 --> 00:16:01,330
!لا خيار أمامنا سوى قتالهم جميعًا من هنا

172
00:16:01,330 --> 00:16:05,240
لا تكوني غبيّة! سينهالون علينا
!بأمواج من الأشخاص الأقوياء

173
00:16:05,240 --> 00:16:09,360
!جهّزوا كلّ المدافع لتطلق على العمود الأوّل

174
00:16:22,840 --> 00:16:26,270
!أجهزوا على قبّعة القشّ لوفي في الحال

175
00:16:33,300 --> 00:16:35,940
!لوفي

176
00:16:48,810 --> 00:16:51,120
لوفي في خطر! علينا إحضاره
!إلى هنا على الأقل

177
00:16:51,610 --> 00:16:53,460
!...هذا سيّئ

178
00:16:53,860 --> 00:16:55,570
!لوفي

179
00:16:56,420 --> 00:16:58,980
،لن ينجح هذا. فبسبب المسافة البعيدة

180
00:16:58,980 --> 00:17:02,800
.سأسقطه في البحر حتّى إن حاولت سحبه

181
00:17:02,800 --> 00:17:04,760
!لوفي

182
00:17:05,340 --> 00:17:08,160
!هذا سيّئ. إنّهم في وضع خطير

183
00:17:08,160 --> 00:17:12,200
!فاز قبّعة القشّ، لكن لا يستطيع النّهوض
!يبدو أنّ حياته في خطر

184
00:17:12,200 --> 00:17:13,060
!ماذا؟

185
00:17:13,060 --> 00:17:14,310
!قبّعة القشّ

186
00:17:14,310 --> 00:17:16,220
!يا قبّعة القشّ

187
00:17:17,650 --> 00:17:20,650
!قف يا قبّعة القشّ

188
00:17:20,650 --> 00:17:23,060
!تماسك يا فتى

189
00:17:23,060 --> 00:17:24,600
!يا أخي القرصان

190
00:17:25,760 --> 00:17:28,290
!لوفي! قف! أرجوك

191
00:17:28,290 --> 00:17:30,950
!ألا يوجد ما يمكنك فعله يا لوفي؟

192
00:17:30,950 --> 00:17:32,310
!لوفي

193
00:17:32,310 --> 00:17:33,460
!يا قبّعة القشّ

194
00:17:33,460 --> 00:17:36,850
!يا قبّعة القشّ! تماسك

195
00:17:36,850 --> 00:17:38,670
!يا قبّعة القشّ

196
00:17:43,450 --> 00:17:45,760
!...مصيبة... الوضع خطير فعلاً

197
00:17:48,150 --> 00:17:49,520
!لوفي

198
00:17:51,390 --> 00:17:53,600
!افعل شيئًا يا لوفي

199
00:17:54,280 --> 00:17:55,490
!يا قبّعة القشّ

200
00:17:55,490 --> 00:17:58,070
!تماسك يا قبّعة القشّ

201
00:17:58,570 --> 00:18:00,980
!يا قبّعة القشّ

202
00:18:06,280 --> 00:18:07,410
!...ها هو ثانية

203
00:18:08,010 --> 00:18:08,870
!من هذا؟

204
00:18:10,680 --> 00:18:14,620
!أنت! هل تريد أن تُقتل؟
!هذا ليس وقتًا مناسبًا لتشرد

205
00:18:15,390 --> 00:18:18,110
صوت من هذا الّذي أسمع؟

206
00:18:18,900 --> 00:18:22,590
...صـ-صحيح! هذا نفس ذلك الصّوت

207
00:18:30,970 --> 00:18:32,500
!ما الّذي يحدث؟

208
00:18:32,500 --> 00:18:33,810
!يا قبّعة القشّ

209
00:18:33,810 --> 00:18:35,170
!قبّعة القشّ

210
00:18:35,170 --> 00:18:37,920
...الأمر واضح! إنّ أتباعي

211
00:18:37,920 --> 00:18:42,050
!كلاّ! ليست تلك الأصوات
!أنا أسمع هذا الصّوت منذ مدّة

212
00:18:42,050 --> 00:18:42,950
!ماذا؟

213
00:18:55,480 --> 00:18:57,070
في الأسفل...؟

214
00:18:58,740 --> 00:19:00,670
أنظر إلى الأسفل؟

215
00:19:11,950 --> 00:19:15,980
.لستُ مخطئًا. يمكنني سمعاه
ماذا؟ من الأسفل؟

216
00:19:21,480 --> 00:19:22,360
من هذا؟

217
00:19:24,140 --> 00:19:25,440
ما هذا الشّيء؟

218
00:19:31,620 --> 00:19:33,180
!يخبرنا الصّوت أن ننظر للأسفل

219
00:19:33,180 --> 00:19:35,290
!عمّ تتحدّث أيّها الرّنّة-تشان؟

220
00:19:35,790 --> 00:19:40,360
بعد خمس ثوانٍ، أطلقوا على قبّعة
!القشّ لوفي في العمود الأوّل

221
00:19:40,360 --> 00:19:41,380
...إنّ لوفي سوف

222
00:19:41,380 --> 00:19:43,000
!يا قبّعة القشّ

223
00:19:47,760 --> 00:19:51,980
...يا لك من... فعلاً، يا لك من

224
00:20:00,230 --> 00:20:04,020
!اقفزوا للبحر

225
00:20:04,020 --> 00:20:05,150
!أربع ثوانٍ

226
00:20:05,760 --> 00:20:07,570
!إلى البحر

227
00:20:08,490 --> 00:20:09,360
!أوسوبّ؟

228
00:20:09,890 --> 00:20:12,530
روبين! هل يمكنك رمي لوفي إلى البحر؟

229
00:20:12,530 --> 00:20:13,450
!دع الأمر لي

230
00:20:13,450 --> 00:20:15,580
!غبيّ! هل تحاول دفعنا للانتحار؟

231
00:20:16,250 --> 00:20:18,620
!إنّ اليأس لن ينقذنا

232
00:20:19,270 --> 00:20:20,110
!ثلاث

233
00:20:20,870 --> 00:20:24,130
!النّجدة هنا! لقد أتت لنجدتنا

234
00:20:24,500 --> 00:20:28,010
!ما زال لدينا صديق آخر، صحيح؟

235
00:20:29,060 --> 00:20:29,970
!اثنتان

236
00:20:30,400 --> 00:20:32,620
!تشوبّر! أنظرت للأسفل؟

237
00:20:32,620 --> 00:20:33,930
!نظرت

238
00:20:37,730 --> 00:20:39,640
!مائة زهرة

239
00:20:46,370 --> 00:20:47,360
!واحدة

240
00:20:47,360 --> 00:20:49,020
!زهرة العائق

241
00:20:51,270 --> 00:20:53,160
!أنا أتحرّك! أهذا من صنيع روبين؟

242
00:20:56,410 --> 00:20:58,040
!إلى البحر

243
00:20:58,690 --> 00:20:59,960
!...إلى البحر

244
00:20:59,960 --> 00:21:01,960
!إلى البحر

245
00:21:06,700 --> 00:21:09,210
!اتبعوا لوفي

246
00:21:10,180 --> 00:21:11,510
!قادمون

247
00:21:12,810 --> 00:21:15,140
!ونحن قادمون

248
00:21:15,890 --> 00:21:17,970
!إلى البحر

249
00:21:18,400 --> 00:21:21,020
!قفز القراصنة إلى البحر

250
00:21:21,020 --> 00:21:24,690
غباء! من المستحيل أن يستطيعوا
.الهرب بعد قفزهم إلى هذا البحر

251
00:21:25,350 --> 00:21:28,060
!هل فقد القراصنة عقولهم؟

252
00:21:41,660 --> 00:21:43,980
!لنعد يا رفاق

253
00:21:53,320 --> 00:21:54,300
!أطلقوا

254
00:22:01,870 --> 00:22:04,640
!إلى أحضان بحار المغامرات

255
00:22:07,610 --> 00:22:12,610
!اصعدوا على متن ميري

256
00:22:15,220 --> 00:22:18,740
!ميري

257
00:22:20,330 --> 00:22:22,210
!أتيت لأخذكم

258
00:22:31,800 --> 00:22:34,380
.كنتُ وحيدة طوال هذا الوقت

259
00:22:35,200 --> 00:22:37,760
...لا أصدّق أنّ ما قاله ساول تحقّق

260
00:22:39,050 --> 00:22:39,930
...أصدقاء

261
00:22:40,450 --> 00:22:43,230
أنا أقدّرهم على إنقاذهم لي
.من كلّ أعماق قلبي

262
00:22:44,810 --> 00:22:46,480
:في الحلقة القادمة من وان بيس

263
00:22:46,480 --> 00:22:50,940
!هروب الجميع العظيم"
"!طريق النّصر من نصيب القراصنة

264
00:22:50,940 --> 00:22:53,160
!ملك القراصنة، لن يكون إلاّ أنا

265
00:22:56,070 --> 00:23:01,120
نلقاكم في الحلقة القادمة