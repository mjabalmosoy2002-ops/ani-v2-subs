1
00:00:00,650 --> 00:00:04,320
بوجود الضّعف كحليف لي

2
00:00:04,320 --> 00:00:07,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,950 --> 00:00:10,660
من المؤسف البقاء في مكان كهذا

4
00:00:10,660 --> 00:00:14,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,200 --> 00:00:18,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,870 --> 00:00:22,500
إن كان قلبي أيضًا ضائعًا

7
00:00:22,500 --> 00:00:25,210
فلن أتمكّن من إيجادك

8
00:00:25,210 --> 00:00:29,260
لا لطفك ولا قوّتك

9
00:00:29,260 --> 00:00:35,060
أعلم مسبقًا

10
00:00:35,060 --> 00:00:36,970
إنّ بزوغ الفجر وشيك

11
00:00:36,970 --> 00:00:40,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,150 --> 00:00:44,320
سأندفع عبر الطّريق بأكمله

13
00:00:44,320 --> 00:00:47,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,070 --> 00:00:51,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,570 --> 00:00:54,330
بوجود العالم كعدوّ لي

16
00:00:54,330 --> 00:00:58,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,790 --> 00:01:01,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,580 --> 00:01:06,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:15,970 --> 00:01:21,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:30,540 --> 00:01:35,140
".وقت المغادرة، بلاد وانو وطاقم قبّعة القشّ"

21
00:01:38,880 --> 00:01:40,340
!هذه الدّانغو لذيذة

22
00:01:41,590 --> 00:01:44,050
!وكذلك حساء الفاصولياء الحمراء

23
00:01:49,560 --> 00:01:52,020
!سمك ولحم وخضار

24
00:01:52,440 --> 00:01:56,060
!منتجاتي طازجة! تعالوا لتجربتها

25
00:02:13,550 --> 00:02:16,670
.لنعد بالوقت للوراء قليلاً

26
00:02:17,900 --> 00:02:22,320
توجد شواهد قبور لكوزكي أودن وكينييمون والبقيّة

27
00:02:22,520 --> 00:02:24,720
.عند أطلال قلعة أودن في كوري

28
00:02:42,910 --> 00:02:44,880
،وبنفسه النّاريّ

29
00:02:45,010 --> 00:02:48,030
.محا كايدو المكان بأكملها من على وجه الأرض

30
00:02:49,950 --> 00:02:54,870
.كان مكان قلعته الأولى عندما صار دايميو كوري

31
00:02:55,890 --> 00:02:58,790
!أنا الدّايميو

32
00:03:42,110 --> 00:03:43,690
!لوفي

33
00:03:44,680 --> 00:03:46,380
!مرحبًا

34
00:03:46,800 --> 00:03:48,300
.لوفيتارو-سان

35
00:03:48,550 --> 00:03:51,510
مرحبًا! ما الّذي أتى بكم جميعًا هكذا؟

36
00:03:51,680 --> 00:03:54,430
.أتينا لإخبار أودن-ساما أنّنا انتصرنا

37
00:03:54,560 --> 00:03:58,230
.إضافة لأشياء أخرى نريد قولها له

38
00:03:58,430 --> 00:04:00,940
وأنت-غارا، ما الّذي تفعله هنا؟

39
00:04:01,150 --> 00:04:02,830
.أتيت لرؤية أودن

40
00:04:07,530 --> 00:04:09,820
.إذًا فقد التقى بمنقذ بلاد وانو

41
00:04:09,950 --> 00:04:13,160
.لا بدّ أنّ ذلك أسعد أودن-ساما كثيرًا

42
00:04:13,520 --> 00:04:14,740
!هكذا إذًا

43
00:04:19,710 --> 00:04:20,920
...أودن-ساما

44
00:04:21,210 --> 00:04:25,670
،بفضل لوفيتارو-دونو ورفاقه
هُزم كايدو وأوروتشي

45
00:04:25,800 --> 00:04:28,420
.وحرّرنا بلاد وانو

46
00:04:40,390 --> 00:04:44,280
.وصار ابنك مومونوسكي-ساما الشّوغن الآن

47
00:04:44,570 --> 00:04:49,110
سنقيم على هذه الأرض بلادًا يعيش
.فيها الجميع بسلام

48
00:04:49,250 --> 00:04:50,900
.نعدك بهذا

49
00:04:56,010 --> 00:04:59,330
...ليت أشورا وإيزو ظلاّ معنا

50
00:05:16,850 --> 00:05:18,350
.إنّهما معنا بالفعل

51
00:05:18,720 --> 00:05:22,840
.إنّهما في قلوبنا تمامًا مثل أودن-ساما

52
00:05:23,240 --> 00:05:25,250
.نعم، بلا أدنى شكّ

53
00:05:25,610 --> 00:05:29,570
.لا بدّ أنّهم يحتفلون بشدّة في العالم الآخر

54
00:05:31,490 --> 00:05:36,030
!لا أحد يعدّ الأودن أفضل من أودن-ساما

55
00:05:37,480 --> 00:05:42,500
.أتذكّر جيّدًا مذاق الأودن الّذي أكلناه معًا

56
00:05:55,070 --> 00:05:59,600
نعم... كان مذاق الأودن الّذي يعدّه
.لا نظير له بعد التّدريب

57
00:05:59,740 --> 00:06:03,060
.هذا رائع! جعل هذا لعابي يسيل

58
00:06:03,200 --> 00:06:04,520
!وأنا كذلك

59
00:06:04,640 --> 00:06:07,810
.سنطلب من سانجي-كُن أن يطبخه لنا

60
00:06:08,940 --> 00:06:12,030
.علينا إذًا تخزين ما نحتاج من مكوّنات

61
00:06:12,160 --> 00:06:15,610
.فكرة ممتازة! خزّنوا أكثر قدر ممكن

62
00:06:16,110 --> 00:06:17,160
.لوفي-دونو

63
00:06:19,160 --> 00:06:20,450
هل ستغادرون؟

64
00:06:22,450 --> 00:06:23,410
.نعم

65
00:06:25,340 --> 00:06:26,620
،مقابل كلّ ما قدّمتموه لنا

66
00:06:27,040 --> 00:06:29,960
اسمحوا لنا أن نقول لكم ونيابة عن الجميع

67
00:06:30,460 --> 00:06:32,130
.شكرًا جزيلاً لكم

68
00:06:36,050 --> 00:06:39,010
.لا داعي لهذا، نحن أصدقاء

69
00:06:41,350 --> 00:06:43,220
!لوفي

70
00:06:46,730 --> 00:06:47,940
!كاروت

71
00:06:48,080 --> 00:06:51,520
!حان وقت الوداع، صحيح؟
!لا أريد، لا أريد، لا أريد

72
00:06:54,990 --> 00:06:58,360
!لا أريد الافتراق عن نامي أبدًا، أبدًا، أبدًا

73
00:06:58,520 --> 00:07:01,230
...كاروت –
ماذا الخطب؟ –

74
00:07:01,870 --> 00:07:03,160
...سأعود

75
00:07:03,790 --> 00:07:05,540
.إلى بلادي موكومو

76
00:07:05,660 --> 00:07:09,340
.سنحمي أنا وواندا والبقيّة موطننا

77
00:07:13,840 --> 00:07:15,380
.مياغي، تريستان

78
00:07:15,760 --> 00:07:17,300
.شكرًا على كلّ شيء

79
00:07:17,430 --> 00:07:22,680
.شكرًا لمشاركتك معنا معرفتك الطّبّيّة الواسعة

80
00:07:22,850 --> 00:07:25,350
.اعتن بنفسك أيّها الطّبيب تشوبّر

81
00:07:26,600 --> 00:07:31,150
بالمناسبة يا كاروت-سان، لقد ركبت سفينة ساني سرًّا

82
00:07:31,270 --> 00:07:34,030
.لأنّك أردت رؤية البحر

83
00:07:34,150 --> 00:07:35,360
كيف وجدته؟

84
00:07:35,900 --> 00:07:37,530
!كان الأروع

85
00:07:37,820 --> 00:07:41,700
...رأيت جُزرًا مجهولة وقابلت أشخاصًا رائعين

86
00:07:41,980 --> 00:07:44,220
،كما أنّي خفت كما لم أخف من قبل

87
00:07:44,380 --> 00:07:47,210
.لكن أشعر أنّي صرت أقوى الآن

88
00:07:47,350 --> 00:07:49,750
سأقدّر مغامراتنا معًا

89
00:07:53,090 --> 00:07:55,460
!لبقيّة حياتي

90
00:07:57,590 --> 00:07:59,630
هلّي أن أمنحكم آخر غارتشو؟

91
00:07:59,760 --> 00:08:01,220
!غارتشو

92
00:08:01,340 --> 00:08:05,260
.استمتعنا كثيرًا بالحديث في غرفة الفتيات

93
00:08:05,390 --> 00:08:07,730
.نعم، كانت لحظات رائعة

94
00:08:07,860 --> 00:08:09,230
.ولك أيضًا يا أخي تشو

95
00:08:09,940 --> 00:08:11,350
!هذا يدغدغني

96
00:08:11,480 --> 00:08:13,440
.لكنّه من دواعي سروري يا كاروت

97
00:08:13,570 --> 00:08:17,460
!غارتشو

98
00:08:18,260 --> 00:08:21,530
.بالمناسبة، قابلتُ زورو قبل مجيئي إلى هنا

99
00:08:21,700 --> 00:08:22,870
وبعد؟

100
00:09:09,810 --> 00:09:11,600
!اشربا

101
00:09:24,620 --> 00:09:26,050
ما الّذي تفعله؟

102
00:09:26,430 --> 00:09:28,430
.أتشارك شرابًا معهما

103
00:09:30,430 --> 00:09:32,140
.سأسكب السّاكي من أجلكم

104
00:09:32,810 --> 00:09:36,110
هل زيّنت القبور بهذه الزّهور؟

105
00:09:36,540 --> 00:09:37,440
!نعم

106
00:09:38,520 --> 00:09:40,570
.وساعدني أختي الكبيرة أيضًا

107
00:09:42,820 --> 00:09:45,770
.أرى أنّك هنا يا زوروجورو-سان

108
00:09:46,240 --> 00:09:47,160
!نعم

109
00:10:11,180 --> 00:10:13,210
.ارقد بسلام

110
00:10:13,930 --> 00:10:15,870
،بمجرّد أن يُبنى المعبد الجميل

111
00:10:15,990 --> 00:10:19,470
.سآتي لزيارتك كلّ يوم يا أبي

112
00:10:19,660 --> 00:10:22,000
لن تشعر بالوحدة، صحيح؟

113
00:10:22,320 --> 00:10:23,570
صحيح؟ صحيح؟

114
00:10:33,830 --> 00:10:35,710
لماذا أنت هنا؟

115
00:10:35,870 --> 00:10:39,180
هل هذه علامة على أنّ وقت رحيلك قد حان؟

116
00:10:39,630 --> 00:10:40,460
.نعم

117
00:10:41,710 --> 00:10:43,420
.سأشتاق إليكم

118
00:10:52,320 --> 00:10:56,770
.إذًا فقد حان الوقت لتوديع إرث والدي إنما

119
00:10:58,650 --> 00:10:59,730
.نعم

120
00:11:06,400 --> 00:11:07,450
.سأحتفظ به

121
00:11:08,780 --> 00:11:10,410
.بالطّبع

122
00:11:12,080 --> 00:11:16,580
...عندما واجهت كايدو به

123
00:11:22,410 --> 00:11:23,880
!أسلوب السّيوف الثّلاثة

124
00:11:24,420 --> 00:11:27,430
!إعصار تنّين الحبل الأسود العظيم

125
00:11:46,070 --> 00:11:51,160
...كما توقّعت، ذلك السّيف

126
00:11:53,330 --> 00:11:55,830
!أسلوب أودن للسّيفين

127
00:11:56,450 --> 00:11:59,680
!هو سيف أودن، صحيح؟

128
00:12:05,000 --> 00:12:06,350
...هكذا إذًا

129
00:12:07,230 --> 00:12:11,800
.لا بدّ أنّ كايدو شعر بوجود والدي

130
00:12:12,130 --> 00:12:13,640
...هذا محتمل

131
00:12:14,440 --> 00:12:18,720
إنما القادر على تقطيع حتّى أعماق الجحيم"...؟"

132
00:12:21,480 --> 00:12:23,610
.كان أودن رجلاً مذهلاً

133
00:12:24,740 --> 00:12:28,070
.لقد روّض هذا السّيف بشكل مثاليّ

134
00:12:28,850 --> 00:12:33,680
.وكذلك أنت. لقد أنقذت بلادنا

135
00:12:34,120 --> 00:12:36,400
.استطعت ذلك بتسخير قوّة إنما

136
00:12:36,990 --> 00:12:39,530
.كلاّ، لم أفرض سيطرتي عليه بالكامل

137
00:12:40,210 --> 00:12:44,060
حسب ما يبدو لي، فإنّ إنما سعيد

138
00:12:44,400 --> 00:12:46,710
.لعثوره على سيّد جديد

139
00:12:50,930 --> 00:12:54,120
.سأصير أقوى بكثير

140
00:13:11,070 --> 00:13:13,070
!مهلاً، مهلاً، مهلاً، مهلاً

141
00:13:13,360 --> 00:13:16,280
!اشرح لي هذا أيّها الصّبيّ فرانكي

142
00:13:16,780 --> 00:13:20,250
هل وجدت خطأ ما أيّها المعلّم؟

143
00:13:20,450 --> 00:13:22,210
!بالطبع وجدت

144
00:13:22,350 --> 00:13:25,210
!ماذا؟ هذا هراء فحسب

145
00:13:25,360 --> 00:13:26,920
!أيّها الوغد

146
00:13:27,260 --> 00:13:31,610
.أنت من طلب منّي معاينة الإصلاحات

147
00:13:31,750 --> 00:13:35,890
!أخبرك بما أراه فحسب أيّها الوغد

148
00:13:36,260 --> 00:13:40,310
!كلّ شيء مثاليّ أيّها التلميذ الجّاحد

149
00:13:41,430 --> 00:13:45,420
كان بإمكانك على الأقلّ ترك شيء
!صغير لي كي أصلحه

150
00:13:45,560 --> 00:13:47,520
!أيّها الغبيّ اللّعين

151
00:13:47,900 --> 00:13:50,480
!أتريدني أن أعتذر على ذلك؟

152
00:13:50,620 --> 00:13:52,710
.أنهيت كلّ شيء بشكل مثاليّ

153
00:13:52,840 --> 00:13:56,200
لا أتوقّع أقلّ من هذا من نجّار سفينة
.طاقم قبّعة القشّ

154
00:13:56,450 --> 00:13:59,520
!مع السّلامة أيّها المغفّل

155
00:14:00,720 --> 00:14:03,660
!اعتن بنفسك أيّها الغبيّ

156
00:14:03,830 --> 00:14:05,370
!ماذا تقول؟

157
00:14:08,790 --> 00:14:11,050
مرحبًا! ما هذا التّأخّر؟

158
00:14:11,200 --> 00:14:14,470
!نعم! حاضر، حاضر! سآتي في الحال

159
00:14:14,930 --> 00:14:17,120
.هذا لك. شكرًا على الانتظار

160
00:14:17,260 --> 00:14:18,140
.لنرَ

161
00:14:18,470 --> 00:14:20,880
ما رأيك في هذا الثّوب؟

162
00:14:21,130 --> 00:14:22,680
.يبدو رائعًا عليك

163
00:14:23,260 --> 00:14:25,000
!أنت أنيق يا أوسوهاتشي-سان

164
00:14:25,140 --> 00:14:27,400
!أنت الأكثر وسامة في بلاد وانو

165
00:14:27,560 --> 00:14:29,230
!انظر إليّ

166
00:14:29,690 --> 00:14:32,690
هل يمكنني مساعدتك يا آنستي؟

167
00:14:34,080 --> 00:14:35,570
.هذا ليس سيّئًا

168
00:14:35,700 --> 00:14:37,280
.لا، لم آتي لأجل ذلك

169
00:14:37,410 --> 00:14:41,490
.لا داعي لإخباري بالمزيد
.لديّ ما تحتاج إليه

170
00:14:41,660 --> 00:14:43,850
.يناسبك هذا اللّون كثيرًا

171
00:14:44,200 --> 00:14:47,160
!أوسوهاتشي-سان –
.يا معذّب قلوب العذارى –

172
00:14:47,290 --> 00:14:50,170
.الرّجل الّذي يحبّ الأحمر ويحبّه الأحمر

173
00:14:50,380 --> 00:14:52,340
!أحببت هذا

174
00:14:53,590 --> 00:14:56,000
.احذري أن تقعي في حبّي

175
00:14:56,130 --> 00:14:58,180
!كلاّ، كلاّ

176
00:14:58,590 --> 00:15:01,420
.أريد لفائف من الثّوب الأسود

177
00:15:01,560 --> 00:15:03,560
.ولتكن كبيرة وكثيرة

178
00:15:04,230 --> 00:15:08,150
ثوب أسود؟ لأيّ سبب؟

179
00:15:08,720 --> 00:15:10,230
...إنّه سرّ

180
00:15:10,620 --> 00:15:12,000
.لا تخبر أيّ أحد

181
00:15:12,120 --> 00:15:15,360
...وشوشة... وشوشة

182
00:15:16,180 --> 00:15:17,940
هل تخطّط لصناعة ذلك الشّيء؟

183
00:15:18,070 --> 00:15:21,330
!سأجهّز لك أفضل ما لدينا من أثواب

184
00:15:21,470 --> 00:15:23,290
.شكرًا جزيلاً

185
00:15:32,090 --> 00:15:33,300
!ممتاز

186
00:15:33,450 --> 00:15:35,260
.هذا يكفي لليوم

187
00:15:37,470 --> 00:15:38,960
.شكرًا جزيلاً

188
00:15:39,380 --> 00:15:43,180
!بائع الصّوبا سانغورو

189
00:15:43,320 --> 00:15:46,520
!كم هذا لذيذ –
!أحببت هذه الوصفة  –

190
00:15:46,650 --> 00:15:48,900
.كان هذا ممتازًا –
!شكرًا لك –

191
00:15:49,850 --> 00:15:51,230
هل أعجبك؟

192
00:15:51,400 --> 00:15:52,560
!بالطّبع

193
00:15:52,690 --> 00:15:54,190
.سرّني هذا

194
00:15:55,780 --> 00:15:57,110
!مرحبًا يا تشوجي

195
00:15:57,340 --> 00:16:00,380
هل أنت بخير أيّها الصّغير؟

196
00:16:01,680 --> 00:16:03,460
!أيّها المشاكس الصّغير

197
00:16:07,750 --> 00:16:08,960
هل من مشكلة؟

198
00:16:09,120 --> 00:16:10,580
.لا، على الإطلاق

199
00:16:11,050 --> 00:16:15,550
لم أشكرك أبدًا على إنقاذك
.لحياتي في أونيغاشيما

200
00:16:15,670 --> 00:16:18,050
.تذكّرت ذلك للتّوّ

201
00:16:18,220 --> 00:16:21,900
.لا داعي للقلق حيال هذا، هذا طبيعيّ

202
00:16:25,680 --> 00:16:28,730
هل ستعود إلى هذا الشّارع؟

203
00:16:31,190 --> 00:16:33,610
،عندما آكل الصّوبا خاصّتك

204
00:16:33,730 --> 00:16:36,690
.أشعر وكأنّ بإمكاني العمل بجدّ غدًا

205
00:16:36,820 --> 00:16:39,350
!يا له من ثناء

206
00:16:39,820 --> 00:16:41,750
.لكن عليّ مواصلة رحلتي

207
00:16:43,090 --> 00:16:44,870
...سانغورو-سان، أنا

208
00:16:46,040 --> 00:16:47,240
!يا بائع الصّوبا

209
00:16:48,080 --> 00:16:49,410
!حبّ، حبّ، حبّ

210
00:16:49,540 --> 00:16:51,420
هلاّ قدّمت لي طبقًا؟

211
00:16:51,540 --> 00:16:55,520
!أتيت لرؤيتي يا روبين-تشان

212
00:16:55,680 --> 00:16:57,550
.لتكن ساخنة رجاءً

213
00:16:57,800 --> 00:17:00,420
.من دواعي سروري يا روبين-تشان

214
00:17:00,600 --> 00:17:03,640
.وأنا كذلك إن أمكن

215
00:17:03,800 --> 00:17:04,760
.أجل، في الحال

216
00:17:15,270 --> 00:17:17,110
!شكرًا للجميع

217
00:17:17,380 --> 00:17:20,860
.أنصح بالنّفخ على الزّبديّة ليبرد الحساء

218
00:17:21,210 --> 00:17:23,910
إنّه للطف منك أن تحضّري لنا هذا الطّعام
!المنشّط يا أوتسورو-سان

219
00:17:24,030 --> 00:17:25,410
!شكرًا لك

220
00:17:29,200 --> 00:17:30,790
!سأستمتع بتناوله

221
00:17:31,000 --> 00:17:33,250
!حساء فاصولياء حمراء

222
00:17:33,460 --> 00:17:35,460
.لا بدّ أنّك تتضوّرين جوعًا

223
00:17:35,830 --> 00:17:37,340
!هذا لا شيء

224
00:17:37,460 --> 00:17:39,170
!بالهناء والشّفاء

225
00:17:40,090 --> 00:17:42,010
.إنّه لذيذ جدًّا

226
00:17:47,180 --> 00:17:49,140
!يا لروعته

227
00:17:59,360 --> 00:18:00,850
.شكرًا على الحساء

228
00:18:09,360 --> 00:18:12,370
إنّك تعدّين أفضل حساء فاصولياء حمراء
!في العالم يا أوتسورو-سان

229
00:18:14,330 --> 00:18:16,290
!جيّد! تناولي الموتشي أيضًا

230
00:18:16,500 --> 00:18:17,380
!نعم

231
00:18:24,760 --> 00:18:27,010
.أعجبني هذا كثيرًا

232
00:18:27,180 --> 00:18:29,730
.تاما، كلي حتّى تشبعين

233
00:18:29,890 --> 00:18:30,760
!نعم

234
00:18:38,440 --> 00:18:40,030
ما الخطب يا تاما؟

235
00:18:41,440 --> 00:18:44,740
،عندما أفكّر أنّكم ستغادرون قريبًا

236
00:18:45,070 --> 00:18:47,700
.يضيق عليّ صدري

237
00:18:50,780 --> 00:18:53,580
...إيس في البداية، وأنت الآن

238
00:18:53,790 --> 00:18:55,910
كلّ الأشخاص الّذين أحبّهم

239
00:18:56,080 --> 00:18:59,630
.يغادرون الواحد تلو الآخر

240
00:19:01,130 --> 00:19:01,840
.تاما

241
00:19:04,130 --> 00:19:07,630
،قدّمتِ لي الطّعام الوحيد الّذي كان لديك

242
00:19:09,260 --> 00:19:11,930
.وهذا أمر لن أنساه ما حييت

243
00:19:22,440 --> 00:19:23,570
!ولا أنا

244
00:19:24,030 --> 00:19:28,070
.لن أنساك أبدًا، لا أنت ولا أصدقاؤك

245
00:19:28,280 --> 00:19:29,110
!ممتاز

246
00:19:29,280 --> 00:19:30,740
سأغادر، مفهوم؟

247
00:19:30,870 --> 00:19:32,280
!نعم

248
00:19:32,450 --> 00:19:34,450
.سنلتقي ثانية يا تاما

249
00:19:53,810 --> 00:19:57,980
!أخي الكبير! شكرًا جزيلاً لك

250
00:20:00,520 --> 00:20:03,360
،أتمنّى أن أكبر وأصير فتاة قويّة

251
00:20:03,520 --> 00:20:06,990
!قويّة مثلك ومثل إيس

252
00:20:15,350 --> 00:20:18,560
.سنعود الآن للحاضر

253
00:20:22,960 --> 00:20:25,210
هل حضّرت هذه الكرات لي؟

254
00:20:25,340 --> 00:20:28,670
.لكن لا يمكنني أن أضمن نجاحها

255
00:20:28,820 --> 00:20:32,140
.أقدّر لك مراعاتك. شكرًا أيّها الطّبيب تشوبّر

256
00:20:32,390 --> 00:20:36,270
!لوفي، نحن جاهزون للإبحار

257
00:20:37,260 --> 00:20:38,210
.حسنًا

258
00:20:38,700 --> 00:20:41,440
هل واثق أنك تريد المغادرة الآن؟

259
00:20:41,800 --> 00:20:46,500
،لا يعرف مومو-تشان وكينييمون بهذا
.إنّهما الوحيدان اللّذان لم نودّعهما

260
00:20:46,650 --> 00:20:48,360
.هذا صحيح

261
00:20:48,640 --> 00:20:51,400
.لا داعي من التّفكير كثيرًا في الأمر

262
00:20:51,560 --> 00:20:53,700
.يا قساوتك يا رأس الطّحلب

263
00:20:53,840 --> 00:20:55,620
.اخرس يا ذا الحاجب اللّولبيّ

264
00:20:59,120 --> 00:21:05,380
خضنا مغامرات معهما أكثر من غيرهما
.من بين كلّ سكّان بلاد وانو

265
00:21:05,500 --> 00:21:09,010
.صحيح، من المحزن فعلاً الرّحيل هكذا

266
00:21:14,510 --> 00:21:17,100
لوفي! ما الّذي سنفعله؟

267
00:21:22,540 --> 00:21:25,560
.لا داعي للقلق. سيأتي إلينا بنفسه

268
00:21:51,300 --> 00:21:55,300
انتهى الوقت

269
00:21:55,300 --> 00:21:59,140
هنالك من ضحك ثانية

270
00:21:59,310 --> 00:22:06,770
لا بأس، فإنّ الغمّيضة الآن انتهت

271
00:22:06,770 --> 00:22:11,030
تعال معي
(سنراها قريبًا)

272
00:22:11,190 --> 00:22:14,780
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

273
00:22:14,950 --> 00:22:19,160
شيء ما سيتغيّر
(سنراها قريبًا)

274
00:22:19,330 --> 00:22:23,410
كن قويًّا، ما زال هنالك وقت
(3-2-1)

275
00:22:31,460 --> 00:22:35,550
لكنّنا شباب، لذلك فنحن أحرار

276
00:22:35,550 --> 00:22:40,010
لنعش جميعًا أحلامنا الأكثر حماقة

277
00:22:40,180 --> 00:22:43,930
سننير الطّريق المظلم أمامنا

278
00:22:44,100 --> 00:22:48,060
لنقف على أقدامنا ونحاول

279
00:22:48,230 --> 00:22:52,150
لنكتشف معًا أصقاع العالم

280
00:22:52,150 --> 00:22:56,530
أنا وأنت، سنحلّق بعيدًا

281
00:23:04,540 --> 00:23:08,540
يغادر لوفي العاصمة بعد تحقيق أمنية
،شعب بلاد وانو كالعاصفة

282
00:23:08,670 --> 00:23:10,740
.بدون قول كلمة واحدة

283
00:23:11,300 --> 00:23:14,260
وفي مواجهة هذا الموقف الّذي يرى فيه
،مومونوسكي إهانة لصداقتهما الطّويلة

284
00:23:14,400 --> 00:23:16,840
.يصير غير قادر على كبح غضبه

285
00:23:16,970 --> 00:23:21,510
،ومع اقتراب موعد المغادرة
ما الّذي يشعر به لوفي بالتّحديد؟

286
00:23:22,560 --> 00:23:23,970
:في الحلقة القادمة من وان بيس

287
00:23:24,100 --> 00:23:27,120
"!أسدل السّتار! عهد لوفي ومومونوسكي"

288
00:23:27,250 --> 00:23:29,800
!ملك القراصنة، لن يكون إلاّ أنا