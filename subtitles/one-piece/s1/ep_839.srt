1
00:00:03,010 --> 00:00:06,520
قلبي يخفق عند التّفكير بك

2
00:00:06,560 --> 00:00:09,940
قوّة لا حصر لها تندفع

3
00:00:09,980 --> 00:00:15,730
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

4
00:00:15,780 --> 00:00:17,320
نحن الأمل

5
00:00:23,370 --> 00:00:30,210
فرحتنا لتطاير مشاعرنا الصّادقة بيننا

6
00:00:30,250 --> 00:00:37,460
ألمنا عندما ضحكنا لنواسي حزننا

7
00:00:37,510 --> 00:00:44,350
نصل بينها في مهبّ الرّياح آه

8
00:00:44,390 --> 00:00:51,100
إنّه يرفرف أعلى فأعلى

9
00:00:51,140 --> 00:00:54,270
لمَ تخلّيت عن بحثتك؟

10
00:00:54,310 --> 00:00:57,690
ولمَ تواصل القتال لوحدك؟

11
00:00:57,730 --> 00:01:00,570
أخبرني، أيّ مستقبل أعددت له؟

12
00:01:00,610 --> 00:01:04,120
هل حقّقت حلمك؟

13
00:01:04,530 --> 00:01:08,040
قلبي يخفق عند التّفكير بك

14
00:01:08,080 --> 00:01:11,790
قوّة لا حصر لها تندفع

15
00:01:11,830 --> 00:01:17,340
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

16
00:01:17,380 --> 00:01:18,550
نحن الأمل

17
00:01:18,750 --> 00:01:22,130
عند نهاية العالم الواسعة والزٍّرقاء

18
00:01:22,170 --> 00:01:24,680
هناك مكان أريد أن أذهب إليه معك

19
00:01:24,720 --> 00:01:27,470
طريق البحر الّذي نسلك

20
00:01:27,510 --> 00:01:34,230
قُرّر قبل وقت طويل

21
00:01:44,910 --> 00:01:48,410
صوتك الّذي لم يصل لي بعد

22
00:01:48,450 --> 00:01:52,040
يسحق قلبي العاجز

23
00:01:52,080 --> 00:01:55,290
أريدك

24
00:01:55,330 --> 00:02:00,130
لذا سأجدّد الثّقة في الصّباح عندما يأتي النّور

25
00:02:00,170 --> 00:02:03,970
أغمض عينيك وأنصت جيّدًا

26
00:02:04,010 --> 00:02:07,470
ولنبحث عن إجابتك

27
00:02:07,510 --> 00:02:13,270
طريق البحر الّذي لم تره أبدًا يستمرّ دائمًا

28
00:02:13,310 --> 00:02:14,310
نحن الأمل

29
00:02:14,480 --> 00:02:17,860
عند نهاية العالم الواسعة والزٍّرقاء

30
00:02:17,900 --> 00:02:20,360
هناك مكان أريد أن أذهب إليه معك

31
00:02:20,400 --> 00:02:23,150
سنكون أبد الدّهر

32
00:02:23,190 --> 00:02:30,330
قُرّر قبل وقت طويل

33
00:02:33,700 --> 00:02:37,940
.في حفل الشّاي الجحيميّ، صرخت بيغ مام أخيرًا

34
00:02:38,710 --> 00:02:43,840
أثناء ذلك الارتباك، أنقذ سانجي أفراد عائلة فينسموك

35
00:02:43,840 --> 00:02:49,200
وأطلق بيجي قاذف السّمّ القاتل
...كي إكس على بيغ مام، لكن

36
00:02:56,480 --> 00:02:59,210
!فشلت المهمّة

37
00:03:05,650 --> 00:03:09,640
!لا! نحن على السّطح! لا مهرب لنا

38
00:03:12,830 --> 00:03:14,940
!لا نملك الفرصة للفوز أيضًا

39
00:03:19,920 --> 00:03:26,240
"!الجيش الشرّير! تحوّل! جيرما 66"

40
00:03:27,170 --> 00:03:30,620
!القلعة بالحجم الكامل

41
00:04:07,800 --> 00:04:09,070
!ماذا؟

42
00:04:58,180 --> 00:05:00,820
!الأب الكبير

43
00:05:03,750 --> 00:05:07,320
!رائع

44
00:05:07,320 --> 00:05:09,690
!ما ذلك؟

45
00:05:09,690 --> 00:05:12,510
!افتحوا البوّابة

46
00:05:15,910 --> 00:05:19,520
!أيّها الحلفاء! دعونا نحتمي في القلعة حاليًّا

47
00:05:19,520 --> 00:05:21,380
!حسنًا، أسرعوا

48
00:05:21,380 --> 00:05:22,810
!أجل، أريد الدّخول

49
00:05:23,170 --> 00:05:26,380
!قراصنة الدّبّابة النّاريّة! احموهم

50
00:05:26,380 --> 00:05:27,520
!ريرو

51
00:05:26,380 --> 00:05:27,520
!حاضر

52
00:05:29,610 --> 00:05:30,940
!سحقًا

53
00:05:40,640 --> 00:05:43,790
!بيجي! رأيت ذلك بأمّ عينيّ

54
00:05:43,790 --> 00:05:46,480
!لا أصدّق أنّك كنت تتآمر لقتل ماما

55
00:05:46,480 --> 00:05:49,920
أذلك ما كان يسعى له من البداية؟

56
00:05:51,280 --> 00:05:53,760
!ادخل إلى القلعة-ريرو

57
00:05:53,760 --> 00:05:57,390
!قلعة! تحضير المدفع

58
00:05:59,480 --> 00:06:01,930
!إطلاق المدفع

59
00:06:04,250 --> 00:06:06,540
!رائع

60
00:06:06,540 --> 00:06:09,250
!إنّه روبوت! روبوت قلعة

61
00:06:09,250 --> 00:06:11,400
!كيف تتحمّس في ظرف كهذا؟

62
00:06:11,840 --> 00:06:15,330
إلى متى نستطيع أن نصمد؟

63
00:06:30,980 --> 00:06:34,180
!ستنفجر طبلتا أذني-نين

64
00:06:38,450 --> 00:06:39,470
موتشي؟

65
00:06:53,010 --> 00:06:55,700
!ما عدت أسمع صراخًا-نين

66
00:06:55,700 --> 00:06:58,560
!أنا بخير الآن-نين

67
00:07:04,520 --> 00:07:05,410
...أذلك

68
00:07:06,250 --> 00:07:07,750
!تاماتيباكو

69
00:07:08,190 --> 00:07:11,790
!الكنز الّذي توارث لأجيال في جزيرة البرمائيّين

70
00:07:15,770 --> 00:07:17,720
!تاماتيباكو المشهور

71
00:07:20,270 --> 00:07:23,080
!تنحّوا، تنحّوا، تنحّوا

72
00:07:23,080 --> 00:07:26,520
!دعوني أهرب أوّلًا

73
00:07:30,330 --> 00:07:31,860
!ماذا؟

74
00:07:34,780 --> 00:07:36,550
!حسنًا

75
00:07:36,550 --> 00:07:38,610
ما-ما هذا بالضّبط؟

76
00:07:46,560 --> 00:07:50,080
!من يعبث مع غاستينو-ساما؟

77
00:07:58,010 --> 00:07:59,630
!أخي

78
00:08:00,100 --> 00:08:01,720
!سيقتلني

79
00:08:05,740 --> 00:08:09,620
!اجتمع كلّ أولئك الأشقياء

80
00:08:09,620 --> 00:08:14,010
!اهربي! سيقتلوني بالتّأكيد

81
00:08:19,070 --> 00:08:22,530
!أخي! شكرًا

82
00:08:25,010 --> 00:08:26,320
!هيّا

83
00:08:37,480 --> 00:08:41,910
!سيهاجمون! أغلقوا البوّابة الآن

84
00:08:41,910 --> 00:08:44,890
!لا! لم تأت نامي والبقيّة بعد

85
00:08:53,460 --> 00:08:55,340
!اصعدوا إلى هنا

86
00:08:55,340 --> 00:08:57,050
!أسرعوا

87
00:08:57,050 --> 00:08:58,190
!رفاق

88
00:08:59,400 --> 00:09:01,360
!لن أدعكم

89
00:09:04,720 --> 00:09:07,040
!احموهم-ريرو! أسرعوا-ريرو

90
00:09:15,650 --> 00:09:16,600
!نامي

91
00:09:17,690 --> 00:09:20,110
!سأعصرك حتّى تموتي

92
00:09:20,110 --> 00:09:21,300
!نامي-سان

93
00:09:21,740 --> 00:09:22,590
!نامي

94
00:09:24,360 --> 00:09:27,010
!سنقاتلك

95
00:09:35,420 --> 00:09:38,690
!مؤلم، مؤلم! ساخن

96
00:09:37,400 --> 00:09:38,690
!لا يمكنك الهرب الآن

97
00:09:38,690 --> 00:09:40,320
!أخي تشو

98
00:09:43,320 --> 00:09:45,370
!جنّيّ

99
00:09:56,770 --> 00:09:58,770
!مؤلم! مؤلم! مؤلم

100
00:09:58,770 --> 00:10:00,130
!تشوبّر

101
00:10:02,070 --> 00:10:03,300
!كاروت

102
00:10:04,990 --> 00:10:06,140
!نامي-سان

103
00:11:06,480 --> 00:11:09,740
!هيّا بنا! جيرما 66

104
00:12:26,170 --> 00:12:28,610
!أطلقوا! أطلقوا

105
00:13:39,080 --> 00:13:42,230
!أيّها الأوغاد المزعجون

106
00:13:44,850 --> 00:13:47,320
!جميعكم، احترقوا حتّى الموت

107
00:14:03,290 --> 00:14:05,330
!أ-أذلك...؟

108
00:15:23,680 --> 00:15:27,620
!جيرما 66! إنّهم الأفضل- ريرو

109
00:15:28,270 --> 00:15:32,250
!جيرما الّذين رأيتهم في القصص المصوّرة

110
00:15:32,250 --> 00:15:36,300
!الحقيقيّون هنا الآن

111
00:15:37,180 --> 00:15:39,360
.تكنولوجيا جيرما العلميّة

112
00:15:39,360 --> 00:15:44,270
!تلك دروع متذكّرة للشّكل! حتّى أنّها مقاومة للنّار

113
00:15:44,740 --> 00:15:48,600
!سأقيّدهم بالحلوى خاصّتي مجدّدًا

114
00:15:49,420 --> 00:15:52,480
!موجة الحلوى

115
00:16:06,720 --> 00:16:10,140
!اركعوا أمام قوّة جيرما العلميّة

116
00:16:26,930 --> 00:16:29,270
!أيّها البراغيث الخسيسة

117
00:16:44,740 --> 00:16:48,500
.لديك جسد ضخم لكنّك لستَ قويًّا

118
00:17:31,980 --> 00:17:33,210
!نامي-سان

119
00:17:34,850 --> 00:17:36,650
!هل أنتم بخير؟

120
00:17:36,650 --> 00:17:37,840
!أنا بخير

121
00:17:38,690 --> 00:17:40,070
!سانجي-كن

122
00:17:40,070 --> 00:17:42,260
!أنت مسرور لأنّك بخير يا نامي-سان

123
00:17:44,740 --> 00:17:47,180
...فاكهة المطّاط

124
00:17:47,530 --> 00:17:49,770
!السّوط النفّاث

125
00:17:49,770 --> 00:17:50,870
!لوفي

126
00:17:50,870 --> 00:17:52,480
!أسرعوا

127
00:17:52,510 --> 00:17:53,940
!من هنا

128
00:17:55,150 --> 00:17:58,190
!عليكم الانسحاب أيضًا-ريرو

129
00:18:16,190 --> 00:18:20,190
!الكنز المخفيّ الأسطوريّ، تاماتيباكو

130
00:18:20,190 --> 00:18:25,200
!ابتعدت كثيرًا حتّى لا يجدوني
!أحببت كم أنّ الوضع فوضويّ-نين

131
00:18:25,200 --> 00:18:30,010
...لنستغلّ هذه الفرصة لاستبدال ما يوجد في الدّاخل

132
00:19:10,450 --> 00:19:14,680
!ما زالت عرضة للهجوم! ما زال بإمكاننا قتلها

133
00:19:15,750 --> 00:19:18,060
!هذه فرصتنا الأخيرة

134
00:19:20,380 --> 00:19:22,570
!إطلاق المدفع

135
00:19:28,780 --> 00:19:30,070
!سحقًا

136
00:19:30,560 --> 00:19:32,540
!جدار الحلوى

137
00:19:33,180 --> 00:19:34,810
!بيروسبيرو

138
00:19:34,810 --> 00:19:37,100
...هذا مؤلم

139
00:19:37,600 --> 00:19:40,250
جيرما إلى جانبكم أيضًا؟

140
00:19:41,440 --> 00:19:44,340
!استعدّوا لهذا أيّها الجرذان

141
00:19:44,730 --> 00:19:47,800
!لن تضحك طويلًا

142
00:19:55,930 --> 00:19:58,970
!قلعة! تحرّك

143
00:20:16,430 --> 00:20:20,000
!سأطلق عليها من الخلف إلى أن تنفد رصاصاتنا

144
00:20:21,170 --> 00:20:23,630
!اذهبي إلى الجحيم يا بيغ مام

145
00:20:24,570 --> 00:20:25,550
...إطلاق

146
00:20:26,570 --> 00:20:28,050
!المدفع

147
00:20:30,820 --> 00:20:32,580
!ماذا حدث؟

148
00:20:33,160 --> 00:20:37,660
!أبي، دُمّرت المدافع على اليسار

149
00:20:37,660 --> 00:20:41,040
،حُشيت كلّ المدافع في القلعة بالموتشي

150
00:20:41,390 --> 00:20:43,430
!ولا نستطيع إطلاقها

151
00:20:47,420 --> 00:20:49,510
!كـ-كاتاكوري

152
00:20:50,300 --> 00:20:54,490
!في تلك الحالة، سيدهسها الأب الكبير

153
00:21:15,260 --> 00:21:16,560
!كيف سار الأمر؟

154
00:21:26,270 --> 00:21:29,720
!لديّ إعلان للجميع في القلعة

155
00:21:39,100 --> 00:21:42,330
...اغتيال بيغ مام

156
00:21:47,520 --> 00:21:49,700
.باء بالفشل

157
00:22:00,540 --> 00:22:04,560
.أطراف الأب الكبير مقيّدة بالحلوى

158
00:22:06,000 --> 00:22:09,230
!لا نستطيع حتّى الحراك الآن

159
00:22:11,260 --> 00:22:16,090
سنحاصر من قبل قراصنة اليونكو بيغ مام

160
00:22:16,090 --> 00:22:21,450
.ونضطرّ لخوض معركة يائسة تحت الحصار

161
00:22:22,930 --> 00:22:24,570
...لا

162
00:23:10,570 --> 00:23:13,260
!عادت بيغ مام إلى صوابها أخيرًا

163
00:23:13,260 --> 00:23:18,260
!كوحش ثائر، تهاجم الأب الكبير للإطاحة بلوفي والبقيّة

164
00:23:18,260 --> 00:23:23,600
،في نفس الأثناء، سانجي ووالده، جادج
يواجهان بعضهما. أيّ كلمات ستدور بينهما؟

165
00:23:23,620 --> 00:23:27,710
!الصّراع الدّائم طويلًا بين الأب والابن آل إلى نهاية

166
00:23:27,710 --> 00:23:28,910
:في الحلقة القادمة من وان بيس

167
00:23:28,910 --> 00:23:31,360
"!قطع علاقة الأب والابن! سانجي وجادج"

168
00:23:31,360 --> 00:23:33,970
!ملك القراصنة، لن يكون إلّا أنا