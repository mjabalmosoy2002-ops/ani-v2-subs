1
00:02:34,210 --> 00:02:39,090
،بعد أن فشلوا في قتل بيغ مام
حوصر لوفي وحلفاؤه

2
00:02:39,270 --> 00:02:42,980
.لكنّ انهيار قصر هول كيك سمح لهم بالهرب

3
00:02:43,590 --> 00:02:46,930
!لا أعرف من فعل هذا لكن عليّ شكره

4
00:02:46,970 --> 00:02:49,660
!لم نكن بحاجة لقتلها

5
00:02:50,220 --> 00:02:51,600
،والآن

6
00:02:51,600 --> 00:02:54,900
...قراصنة اليونكو بيغ مام

7
00:02:54,900 --> 00:02:56,750
!أُبيدوا

8
00:02:56,980 --> 00:03:03,110
ولكنّ تمّ إنقاذ بيغ مام وعائلتها
.بفضل قدرة سترويزن

9
00:03:08,700 --> 00:03:10,620
...ماما

10
00:03:10,990 --> 00:03:12,580
!ماما

11
00:03:14,580 --> 00:03:17,590
أمّا لوفي وجماعته الّذين هربوا
...من قصر هول كيك

12
00:03:17,950 --> 00:03:21,900
.انفصلوا عن مجموعة بيجي وتوجّهوا إلى ساني

13
00:03:22,360 --> 00:03:24,780
.حسنًا، لنهرب إذًا

14
00:03:24,780 --> 00:03:28,070
.سنفترق عنكم هنا يا قبّعة القشّ

15
00:03:30,470 --> 00:03:34,330
.أثناء ذلك، شكّل كاتاكوري والبقيّة وحدات لمطاردهم

16
00:03:34,330 --> 00:03:37,700
!سننفصل إلى مجموعتين ونطاردهم

17
00:03:37,700 --> 00:03:43,500
!ستسعى مجموعة خلف رأس قبّعة القشّ
!والمجموعة الأخرى ستستعيد بيجي

18
00:03:47,860 --> 00:03:51,090
.وهناك قوّة منفصلة تهاجم جيرما أيضًا

19
00:03:51,440 --> 00:03:54,760
!حسنًا... برولي، تعالي معي

20
00:03:55,090 --> 00:03:57,100
...ولكن، في خضمّ كلّ ذلك

21
00:04:01,820 --> 00:04:04,320
!اسمعوا! اخرجوا من المدينة

22
00:04:04,320 --> 00:04:05,670
!سموذي

23
00:04:06,300 --> 00:04:08,420
!اهربوا إلى أبعد مكان ممكن

24
00:04:12,020 --> 00:04:13,160
!في وقت كهذا؟

25
00:04:19,730 --> 00:04:26,150
"!رمح إلباف! هجوم بيغ مام الطّائر"

26
00:04:32,180 --> 00:04:36,180
!أين كعكة الزّفاف؟

27
00:04:51,450 --> 00:04:53,740
!نوبات جوع الملكة؟

28
00:04:53,740 --> 00:04:57,970
!تعاني نوبة أخرى في فترة وجيزة كهذه

29
00:05:01,310 --> 00:05:05,880
تذكّرت كعكة الزّفاف الّتي دُمّرت
!ولم تستطع أكلها

30
00:05:12,280 --> 00:05:14,890
!ما الّذي في يد ماما؟

31
00:05:20,300 --> 00:05:21,900
.فات الأوان

32
00:05:29,670 --> 00:05:31,070
!كلاّ

33
00:05:39,510 --> 00:05:41,200
!أخي أوبيرا

34
00:05:41,200 --> 00:05:43,360
!هيّا! تماسك

35
00:05:43,760 --> 00:05:45,620
!هل يعقل أنّها أخذت عمرك؟

36
00:05:45,620 --> 00:05:47,090
!أخي

37
00:05:48,140 --> 00:05:52,590
!وقف أخي أوبيرا في طريق ماما لإيقافها

38
00:05:53,780 --> 00:05:56,780
!لا يستطيع أحد الاقتراب من ماما

39
00:06:07,050 --> 00:06:10,230
...علينا فعل شيء ما

40
00:06:10,250 --> 00:06:11,920
!أين هي؟

41
00:06:12,860 --> 00:06:16,570
!كعكة الزّفاف

42
00:06:28,970 --> 00:06:32,010
!أسرعوا جميعًا! سيسعون خلفنا قريبًا

43
00:06:33,110 --> 00:06:34,250
!نامي

44
00:06:34,250 --> 00:06:38,590
!إنّك تركبين على ظهر جينبي
!كفّي عن إلقاء الأوامر لنا

45
00:06:38,590 --> 00:06:40,130
!لا بأس بذلك

46
00:06:40,450 --> 00:06:43,170
!لأنّ نامي-سان ظريفة جدًّا

47
00:06:43,170 --> 00:06:45,410
...ظريفة ورقيقة

48
00:06:48,040 --> 00:06:52,730
سيأتي مطاردون من قراصنة بيغ مام
!للسّعي خلفنا قريبًا! علينا أن نسرع

49
00:06:53,320 --> 00:06:54,940
!اعتمد عليّ

50
00:06:54,940 --> 00:07:00,740
إنّ الرّكض عبر هذه المنطقة
!وغابة الإغواء هي أقصر طريق إلى ساني

51
00:07:06,840 --> 00:07:08,290
!تعلمون ما العمل

52
00:07:08,760 --> 00:07:13,380
الطّريقة الوحيدة لإيقاف هجمات نوبات
!جوع ماما هي منحها الطّعام الّذي تشتهيه

53
00:07:17,050 --> 00:07:20,500
!ما نحتاج إليه هو... كعكة الزّفاف

54
00:07:20,500 --> 00:07:25,640
!أين رئيس الطّهاة؟
!إنّه الوحيد الّذي بإمكانه إعادة خبزها

55
00:07:26,000 --> 00:07:28,770
...إ-إنّ... سترويزن-ساما

56
00:07:29,730 --> 00:07:31,770
...أنقذ حياة الجميع

57
00:07:33,300 --> 00:07:36,690
...لكنّ الحظّ لم يحالفه على النّزول بأمان

58
00:07:41,550 --> 00:07:45,020
!إنّه بحاجة لأيّام عديدة ليُشفى

59
00:07:48,470 --> 00:07:52,340
،إن استمرّ الوضع هكذا
!ستُدمَّر مدينة الحلوى! غاو

60
00:07:52,790 --> 00:07:55,820
!ما الّذي بإمكاننا فعله لإيقاف ماما؟

61
00:07:58,700 --> 00:08:02,280
!لا يجب أن نسمح لها بأن تهيج في العاصمة

62
00:08:12,290 --> 00:08:14,750
!أين هي؟

63
00:08:28,140 --> 00:08:29,040
...هل ينوي

64
00:08:29,460 --> 00:08:31,640
!أعتقد أنّ لديه فكرة ما

65
00:08:31,640 --> 00:08:34,250
!هذا هو المتوقّع من بيروسبيرو-ساما! غاو

66
00:08:36,020 --> 00:08:39,470
...ماما! كعكة الزّفاف

67
00:08:39,960 --> 00:08:42,110
!لم تختفي

68
00:08:45,660 --> 00:08:49,600
!كان لدينا كعكة احتياطيّة يا ماما

69
00:08:50,790 --> 00:08:52,190
!أخي بيروس

70
00:08:52,190 --> 00:08:54,280
!كلاّ! عمّ تتحدّث؟

71
00:08:54,880 --> 00:08:59,170
...إ-إنّها معدّة من مكوّنات مختارة

72
00:09:00,050 --> 00:09:03,630
...وهي لذيذة وتذوب في الفم

73
00:09:03,630 --> 00:09:07,510
!إنّها أفضل كعكة زفاف على الإطلاق

74
00:09:08,480 --> 00:09:15,410
أريدك أن تأكليها بشدّة، لكنّ طاقم
!قبّعة القشّ سرقوها وهربوا

75
00:09:15,410 --> 00:09:20,380
إنّهم الآن في طريقهم إلى السّاحل
!الجنوب غربيّ ليحاولوا الهرب

76
00:09:22,110 --> 00:09:24,000
...كعكة

77
00:09:24,580 --> 00:09:26,390
...الزّفاف

78
00:09:26,770 --> 00:09:31,100
!هذا صحيح! إنّها معهم! لعق

79
00:09:32,020 --> 00:09:34,560
.أفترض أنّها تستمع لي لدرجة ما

80
00:09:34,980 --> 00:09:39,280
،إن ذهبت خلف قبّعة القشّ
!فسيكون ذلك كقتل عصفورين بحجر واحد

81
00:09:43,320 --> 00:09:45,570
هل بإمكانه إقناعها بذلك؟

82
00:09:59,120 --> 00:10:02,190
،إن كنتَ تكذب

83
00:10:02,190 --> 00:10:06,100
!فستدفع الثّمن بسنوات عمرك

84
00:10:11,870 --> 00:10:12,940
!زوس

85
00:10:13,880 --> 00:10:15,140
!حاضر يا ماما

86
00:10:25,160 --> 00:10:30,220
!كعكة الزّفاف

87
00:10:40,830 --> 00:10:42,750
!أنا في ورطة

88
00:10:42,750 --> 00:10:47,930
،حتّى إن أمسكت ماما بطاقم قبّعة القشّ
!فلن تكون لديهم أيّ كعكة

89
00:10:47,930 --> 00:10:51,640
!ماذا عليّ أن أفعل؟ –
...ظننتُ أنّ ذلك كان ذكيًّا، لكن –

90
00:10:55,450 --> 00:10:59,060
!أنا هالك لا محالة عندما تعود ماما

91
00:10:59,410 --> 00:11:01,270
!لكنّك وفّرت لنا الوقت

92
00:11:01,270 --> 00:11:04,900
علينا إعداد الكعكة الآن
!وإلاّ انتهى أمر هذه الجزيرة أيضًا

93
00:11:05,920 --> 00:11:10,520
.ذلك مستحيل... فكّري في الأمر يا سموذي

94
00:11:10,520 --> 00:11:17,080
حتّى رئيس الطّهاة سترويزن احتاج
!لأيّام لإعداد تلك الكعكة

95
00:11:17,770 --> 00:11:23,330
المكوّنات النّادرة الّتي جمعناها
!عن طريق نهبها من بلدان أخرى انتهت

96
00:11:23,730 --> 00:11:29,300
!والشّخص الّذي بإمكانه خبزها في غيبوبة
!لا يمكنه خبز الكعكة

97
00:11:31,330 --> 00:11:37,270
ولكنّ الإشكال الأكبر هو أنّ ماما
!لم تتذوّق الكعكة حتّى

98
00:11:37,270 --> 00:11:39,350
...إذًا فهذه المرّة، علينا توفير

99
00:11:40,680 --> 00:11:47,400
الكعكة اللّذيذة الّتي لم تُأكل من قبل
.الّتي تشوّقت ماما لأكلها لأيّام

100
00:11:47,820 --> 00:11:52,580
!من بإمكانه إعداد شيء كهذا؟

101
00:11:53,140 --> 00:11:54,440
.هذا سيّئ

102
00:11:55,060 --> 00:11:57,160
!ستُدمّر هذه الجزيرة على الأقلّ

103
00:11:57,860 --> 00:12:00,600
.وما ينتظرنا... مجهول

104
00:12:14,410 --> 00:12:16,860
!أتريدون أن أساعدكم؟

105
00:12:26,890 --> 00:12:28,320
!بودينغ

106
00:12:28,320 --> 00:12:31,450
!إنّها بودينغ-ساما –
!بودينغ-ساما –

107
00:12:31,990 --> 00:12:36,040
!كانت كعكة الزّفاف كعكة شيفون بالشّكولاطة

108
00:12:36,430 --> 00:12:40,990
بإمكاني إعداد أيّ شيء بنكهة الشّكولاطة
!بنفس مستوى رئيس الطّهاة، ما لم أكن أفضل

109
00:12:40,990 --> 00:12:46,050
كما أنّ أختي شيفون خبيرة
!في إعداد كعك الشّيفون

110
00:12:46,050 --> 00:12:49,920
!لذلك بإمكاننا معًا إعداد تلك الكعكة

111
00:12:49,920 --> 00:12:52,050
!أواثقة يا بودينغ؟

112
00:12:52,050 --> 00:12:56,540
!لكنّ شيفون زوجة بيجي الّذي صار عدوّنا الآن

113
00:12:58,400 --> 00:13:00,700
!سأرغمها على ذلك

114
00:13:00,700 --> 00:13:02,440
!هذه هي بودينغ الشّرّيرة

115
00:13:02,440 --> 00:13:05,940
!ماذا؟! تتصرّف بودينغ-ساما كقاطعة طريق

116
00:13:07,560 --> 00:13:10,480
...في الحقيقة، مكوّنات الكعكة

117
00:13:10,480 --> 00:13:14,340
جُمعت معًا في بلدة الشّكولاطة
،على جزيرة الكاكاو

118
00:13:14,340 --> 00:13:15,950
.بوّابة منطقتنا

119
00:13:16,850 --> 00:13:20,160
!لذلك يوجد هناك كمّيّات إضافيّة للمكوّنات النّادرة

120
00:13:21,520 --> 00:13:22,700
!أخي بيروس

121
00:13:22,700 --> 00:13:26,500
بمجرّد أن تقضي ماما على طاقم
!قبّعة القشّ، قُدها إلى بلدة الشّكولاطة

122
00:13:27,320 --> 00:13:29,840
!سأنهي هذه المسألة

123
00:13:30,530 --> 00:13:33,760
!أواثقة من ذلك؟! ستنقذيننا هكذا بودينغ

124
00:13:35,640 --> 00:13:38,770
!تعرّضت للإهانة من سانجي

125
00:13:39,110 --> 00:13:41,680
!يا لها من عين جميلة

126
00:13:42,390 --> 00:13:44,690
...إن استطاعت ماما القضاء عليهم

127
00:13:45,570 --> 00:13:48,320
.فعليّ تقديم مكافأة لها

128
00:13:53,180 --> 00:13:54,650
!انتظر فحسب

129
00:13:55,140 --> 00:13:56,110
!يا سانجي

130
00:13:58,470 --> 00:13:59,370
ما الخطب؟

131
00:13:59,370 --> 00:14:01,700
...شعرتُ برعشة في قلبي

132
00:14:02,330 --> 00:14:05,090
أعتقد أنّ هنالك فتاة ظريفة
...تتحدّث عنّي كالمعتاد

133
00:14:05,090 --> 00:14:07,250
!يمكنني رؤية غابة الإغواء

134
00:14:07,810 --> 00:14:11,720
!هل سندخل تلك الغابة ثانية؟
.آمل أن نخرج على خير

135
00:14:13,030 --> 00:14:14,510
ماذا يوجد هناك؟

136
00:14:16,200 --> 00:14:19,060
!لا، توقّف يا كين-تشان

137
00:14:19,460 --> 00:14:21,970
هل أنت بخير يا كين-تشان؟

138
00:14:21,970 --> 00:14:26,790
هذا مؤلم! إنّ الخياطة تؤلم-جو
...يا ليدي تري

139
00:14:26,790 --> 00:14:32,530
.أنا آسفة... لكنّ جزئيك سيلتئمان معًا قريبًا
!مثلنا نحن تمامًا

140
00:14:32,790 --> 00:14:36,720
!هذا مؤلم! تريّثي عليّ

141
00:14:41,520 --> 00:14:43,620
!ماذا؟ كلاّ! كيف؟

142
00:14:44,560 --> 00:14:46,310
!أنت هناك

143
00:14:47,480 --> 00:14:49,190
!أنت

144
00:14:49,940 --> 00:14:53,290
!أنت حيّ يا كينغباوم

145
00:14:54,820 --> 00:14:56,920
!سرّتني رؤيتك ثانية

146
00:14:56,920 --> 00:14:58,120
!يا كين

147
00:15:03,120 --> 00:15:04,850
...ا... ا

148
00:15:05,750 --> 00:15:08,290
!اذهبوا بعيدًا عنّي

149
00:15:08,920 --> 00:15:11,520
!سأجعلكم تدفعون الثّمن أيّها الأوغاد

150
00:15:11,870 --> 00:15:15,150
!كين-تشان –
!ليدي تري –

151
00:15:18,230 --> 00:15:20,410
!لا تنظر للخلف! انطلق للأمام مباشرة

152
00:15:20,880 --> 00:15:22,950
!سُحقًا

153
00:15:23,270 --> 00:15:27,660
ماذا؟ ظننتُ أنّهم أخذوا منك
.فيفر كارد لولا يا نامي

154
00:15:28,060 --> 00:15:30,830
.ذلك صحيح. لكنّي قصصتها لنصفين من قبل

155
00:15:30,830 --> 00:15:32,090
!فكرة ذكيّة

156
00:15:32,090 --> 00:15:34,000
!إنّنا ننطلق بسرعة

157
00:15:34,340 --> 00:15:37,920
،بما أنّه سيّد غابة الإغواء
!فبإمكانه الانتقال في خطّ مستقيم

158
00:15:38,220 --> 00:15:41,640
!جيّد! واصل التّقدّم إلى ساني بكامل سرعتك

159
00:15:41,640 --> 00:15:42,950
!واصل

160
00:15:42,950 --> 00:15:48,320
!إنّكم أشبه بطاعون-جو
!غادروا هذه البلاد بسرعة-جو

161
00:15:48,320 --> 00:15:49,780
هل قلتَ شيئًا ما؟

162
00:15:50,750 --> 00:15:53,500
!افعل ما تأمرك به نامي-سان

163
00:15:59,890 --> 00:16:04,870
!هدفنا أمامنا مباشرة! أطيحوا بهم

164
00:16:04,870 --> 00:16:08,080
!أجل

165
00:16:09,270 --> 00:16:11,060
!إنّ العدوّ خلفنا

166
00:16:12,710 --> 00:16:14,000
!تقدّموا

167
00:16:14,000 --> 00:16:16,590
!أجل

168
00:16:17,190 --> 00:16:18,930
!أسرع يا كينغباوم

169
00:16:18,930 --> 00:16:20,840
!أنا أنطلق بأسرع ما يمكنني-جو

170
00:16:20,840 --> 00:16:23,590
!إن أمسكوا بك، فسأنزع ذلك الخيط

171
00:16:23,590 --> 00:16:24,970
!أنت فظيعة

172
00:16:29,540 --> 00:16:31,350
!مرّ شيء ما فوق رؤوسنا

173
00:16:34,550 --> 00:16:36,480
...ذلك الصّوت –
!لا يُعقل –

174
00:16:39,880 --> 00:16:41,570
!ماذا؟

175
00:16:42,130 --> 00:16:48,730
!كعكة الزّفاف

176
00:16:49,560 --> 00:16:52,380
!بيغ مام

177
00:16:56,210 --> 00:16:58,010
!أعطوني إيّاها

178
00:17:20,710 --> 00:17:22,910
!أطيحوا بهم

179
00:17:34,470 --> 00:17:38,850
إنّ الجنود النّسخ صُنعوا ليكونوا
.مقاتلين لا يهابون الموت

180
00:17:39,770 --> 00:17:46,240
ونحن قراصنة بيغ مام لنستولي
!على تلك القوّة العسكريّة

181
00:18:18,840 --> 00:18:23,950
!وجدت الغرفة الّتي يصنعون فيها الجنود النّسخ

182
00:18:33,540 --> 00:18:37,210
...أجل! عرش بدون ملك

183
00:18:38,080 --> 00:18:40,350
...كم هذا محزن

184
00:18:40,710 --> 00:18:42,610
!فكّكوه في الحال

185
00:18:43,340 --> 00:18:44,820
.هنالك ملك بالفعل

186
00:18:47,410 --> 00:18:48,410
...أنت

187
00:19:01,790 --> 00:19:03,970
!ما-ماذا؟

188
00:19:04,220 --> 00:19:05,300
!تخفّي

189
00:19:16,160 --> 00:19:21,520
لا يُسمح لكم بالتّقدّم أكثر من هذا
!أيّها المسخ ذا الشّعر الأشعث

190
00:19:22,380 --> 00:19:25,360
!احترق! احترق! احترق

191
00:19:27,180 --> 00:19:28,660
!احترق بالكامل

192
00:19:39,400 --> 00:19:42,020
!لا تتمادى كثيًا

193
00:19:43,610 --> 00:19:47,930
!شكرًا لقيامكم بما يحلو لكم في مملكتنا

194
00:19:48,390 --> 00:19:49,890
...كلاّ

195
00:20:07,420 --> 00:20:11,120
!كيف تجرؤون على الاستخفاف بنا؟

196
00:20:11,120 --> 00:20:16,290
!يا قراصنة بيغ مام! لن نسامحكم على هذا أبدًا

197
00:20:17,520 --> 00:20:20,710
.سندفع لكم مع الفوائد

198
00:20:29,880 --> 00:20:31,180
!بيغ مام

199
00:20:33,680 --> 00:20:35,910
!لوفي، تحكّم في نفسك

200
00:20:35,910 --> 00:20:38,180
!اخرس –
!انتظر –

201
00:20:38,180 --> 00:20:40,310
!دعني يا جينبي

202
00:20:40,310 --> 00:20:46,150
!العودة إلى ساني هي هدفنا
!لا تنس ذلك

203
00:20:51,630 --> 00:20:54,410
!تقترب بيغ مام منّا

204
00:20:55,410 --> 00:20:57,160
!ما الّذي أتى بماما إلى الجبهة الأماميّة؟

205
00:20:57,160 --> 00:20:59,620
!وانظروا إليها... إنّها ليست على طبيعتها

206
00:21:00,070 --> 00:21:02,080
!هذا لا يُعقل! إنّها في نوبة جوع

207
00:21:02,450 --> 00:21:06,290
!كعكة الزّفاف

208
00:21:06,290 --> 00:21:08,750
!أضِعها يا كينغباوم

209
00:21:08,750 --> 00:21:10,510
!ذلك مستحيل-جو

210
00:21:10,510 --> 00:21:12,850
!لا شيء مستحيل –
!كيف أستطيع ذلك؟ –

211
00:21:12,850 --> 00:21:15,740
!اهربوا –
!يا كين –

212
00:21:17,100 --> 00:21:20,940
!أسرع نحو ساني

213
00:21:41,930 --> 00:21:44,710
!قبّعة القشّ

214
00:21:44,710 --> 00:21:47,210
!أعطني الكعكة

215
00:21:47,900 --> 00:21:51,050
!اخرسي! لا أدري ما الّذي تتحدّثين عنه

216
00:21:52,090 --> 00:21:54,000
...إنّها

217
00:21:54,180 --> 00:21:59,220
!كعكتي

218
00:22:00,930 --> 00:22:02,640
!تماسك يا كينغباوم

219
00:22:08,040 --> 00:22:12,150
!تذوّقوا رمح إلباف

220
00:22:12,150 --> 00:22:13,450
!إلباف؟

221
00:22:17,720 --> 00:22:19,100
!انتبهوا من هجومها

222
00:22:31,260 --> 00:22:34,550
!سيادة إيكوكو

223
00:23:10,830 --> 00:23:15,120
!إنّ بيغ مام تطير وعي على أعقابهم
!وغابة الإغواء أمامهم

224
00:23:15,120 --> 00:23:20,000
،مع تزايد الضّغط في هذا الوضع الخاسر
!تفكّر نامي في خطّة للعثور على مهرب

225
00:23:20,000 --> 00:23:23,270
.في تلك الأثناء، تلمع دمعة واحدة في عين بودينغ

226
00:23:23,270 --> 00:23:24,930
لكن هل هي حقيقيّة أم لا؟

227
00:23:24,930 --> 00:23:27,270
!سيُكشف عن أفكارها الحقيقيّة قريبًا

228
00:23:27,270 --> 00:23:28,730
:في الحلقة القادمة من وان بيس

229
00:23:28,730 --> 00:23:31,640
"!عزيمة بودينغ! غابة الإغواء تشتعل"

230
00:23:31,640 --> 00:23:34,040
!ملك القراصنة، لن يكون إلاّ أنا