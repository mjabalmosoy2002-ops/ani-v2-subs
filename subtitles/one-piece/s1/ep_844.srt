1
00:02:48,210 --> 00:02:53,090
،بعد أن فشلوا في قتل بيغ مام
حوصر لوفي وحلفاؤه

2
00:02:53,270 --> 00:02:56,980
.لكنّ انهيار قصر هول كيك سمح لهم بالهرب

3
00:02:57,590 --> 00:03:00,930
!لا أعرف من فعل هذا لكن عليّ شكره

4
00:03:00,970 --> 00:03:03,660
!لم نكن بحاجة لقتلها

5
00:03:04,220 --> 00:03:05,600
،والآن

6
00:03:05,600 --> 00:03:08,900
...قراصنة اليونكو بيغ مام

7
00:03:08,900 --> 00:03:10,750
!أُبيدوا

8
00:03:10,980 --> 00:03:17,110
ولكنّ تمّ إنقاذ بيغ مام وعائلتها
.بفضل قدرة سترويزن

9
00:03:22,700 --> 00:03:24,620
...ماما

10
00:03:24,990 --> 00:03:26,580
!ماما

11
00:03:28,580 --> 00:03:31,590
أمّا لوفي وجماعته الّذين هربوا
...من قصر هول كيك

12
00:03:31,950 --> 00:03:35,900
.انفصلوا عن مجموعة بيجي وتوجّهوا إلى ساني

13
00:03:36,360 --> 00:03:38,780
.حسنًا، لنهرب إذًا

14
00:03:38,780 --> 00:03:42,070
.سنفترق عنكم هنا يا قبّعة القشّ

15
00:03:44,470 --> 00:03:48,330
.أثناء ذلك، شكّل كاتاكوري والبقيّة وحدات لمطاردهم

16
00:03:48,330 --> 00:03:51,700
!سننفصل إلى مجموعتين ونطاردهم

17
00:03:51,700 --> 00:03:57,500
!ستسعى مجموعة خلف رأس قبّعة القشّ
!والمجموعة الأخرى ستستعيد بيجي

18
00:04:01,860 --> 00:04:05,090
.وهناك قوّة منفصلة تهاجم جيرما أيضًا

19
00:04:05,440 --> 00:04:08,760
!حسنًا... برولي، تعالي معي

20
00:04:09,090 --> 00:04:11,100
...ولكن، في خضمّ كلّ ذلك

21
00:04:15,820 --> 00:04:18,320
!اسمعوا! اخرجوا من المدينة

22
00:04:18,320 --> 00:04:19,670
!سموذي

23
00:04:20,300 --> 00:04:22,420
!اهربوا إلى أبعد مكان ممكن

24
00:04:26,020 --> 00:04:27,160
!في وقت كهذا؟

25
00:04:33,730 --> 00:04:40,150
"!رمح إلباف! هجوم بيغ مام الطّائر"

26
00:04:46,180 --> 00:04:50,180
!أين كعكة الزّفاف؟

27
00:05:05,450 --> 00:05:07,740
!نوبات جوع الملكة؟

28
00:05:07,740 --> 00:05:11,970
!تعاني نوبة أخرى في فترة وجيزة كهذه

29
00:05:15,310 --> 00:05:19,880
تذكّرت كعكة الزّفاف الّتي دُمّرت
!ولم تستطع أكلها

30
00:05:26,280 --> 00:05:28,890
!ما الّذي في يد ماما؟

31
00:05:34,300 --> 00:05:35,900
.فات الأوان

32
00:05:43,670 --> 00:05:45,070
!كلاّ

33
00:05:53,510 --> 00:05:55,200
!أخي أوبيرا

34
00:05:55,200 --> 00:05:57,360
!هيّا! تماسك

35
00:05:57,760 --> 00:05:59,620
!هل يعقل أنّها أخذت عمرك؟

36
00:05:59,620 --> 00:06:01,090
!أخي

37
00:06:02,140 --> 00:06:06,590
!وقف أخي أوبيرا في طريق ماما لإيقافها

38
00:06:07,780 --> 00:06:10,780
!لا يستطيع أحد الاقتراب من ماما

39
00:06:21,050 --> 00:06:24,230
...علينا فعل شيء ما

40
00:06:24,250 --> 00:06:25,920
!أين هي؟

41
00:06:26,860 --> 00:06:30,570
!كعكة الزّفاف

42
00:06:42,970 --> 00:06:46,010
!أسرعوا جميعًا! سيسعون خلفنا قريبًا

43
00:06:47,110 --> 00:06:48,250
!نامي

44
00:06:48,250 --> 00:06:52,590
!إنّك تركبين على ظهر جينبي
!كفّي عن إلقاء الأوامر لنا

45
00:06:52,590 --> 00:06:54,130
!لا بأس بذلك

46
00:06:54,450 --> 00:06:57,170
!لأنّ نامي-سان ظريفة جدًّا

47
00:06:57,170 --> 00:06:59,410
...ظريفة ورقيقة

48
00:07:02,040 --> 00:07:06,730
سيأتي مطاردون من قراصنة بيغ مام
!للسّعي خلفنا قريبًا! علينا أن نسرع

49
00:07:07,320 --> 00:07:08,940
!اعتمد عليّ

50
00:07:08,940 --> 00:07:14,740
إنّ الرّكض عبر هذه المنطقة
!وغابة الإغواء هي أقصر طريق إلى ساني

51
00:07:20,840 --> 00:07:22,290
!تعلمون ما العمل

52
00:07:22,760 --> 00:07:27,380
الطّريقة الوحيدة لإيقاف هجمات نوبات
!جوع ماما هي منحها الطّعام الّذي تشتهيه

53
00:07:31,050 --> 00:07:34,500
!ما نحتاج إليه هو... كعكة الزّفاف

54
00:07:34,500 --> 00:07:39,640
!أين رئيس الطّهاة؟
!إنّه الوحيد الّذي بإمكانه إعادة خبزها

55
00:07:40,000 --> 00:07:42,770
...إ-إنّ... سترويزن-ساما

56
00:07:43,730 --> 00:07:45,770
...أنقذ حياة الجميع

57
00:07:47,300 --> 00:07:50,690
...لكنّ الحظّ لم يحالفه على النّزول بأمان

58
00:07:55,550 --> 00:07:59,020
!إنّه بحاجة لأيّام عديدة ليُشفى

59
00:08:02,470 --> 00:08:06,340
،إن استمرّ الوضع هكذا
!ستُدمَّر مدينة الحلوى! غاو

60
00:08:06,790 --> 00:08:09,820
!ما الّذي بإمكاننا فعله لإيقاف ماما؟

61
00:08:12,700 --> 00:08:16,280
!لا يجب أن نسمح لها بأن تهيج في العاصمة

62
00:08:26,290 --> 00:08:28,750
!أين هي؟

63
00:08:42,140 --> 00:08:43,040
...هل ينوي

64
00:08:43,460 --> 00:08:45,640
!أعتقد أنّ لديه فكرة ما

65
00:08:45,640 --> 00:08:48,250
!هذا هو المتوقّع من بيروسبيرو-ساما! غاو

66
00:08:50,020 --> 00:08:53,470
...ماما! كعكة الزّفاف

67
00:08:53,960 --> 00:08:56,110
!لم تختفي

68
00:08:59,660 --> 00:09:03,600
!كان لدينا كعكة احتياطيّة يا ماما

69
00:09:04,790 --> 00:09:06,190
!أخي بيروس

70
00:09:06,190 --> 00:09:08,280
!كلاّ! عمّ تتحدّث؟

71
00:09:08,880 --> 00:09:13,170
...إ-إنّها معدّة من مكوّنات مختارة

72
00:09:14,050 --> 00:09:17,630
...وهي لذيذة وتذوب في الفم

73
00:09:17,630 --> 00:09:21,510
!إنّها أفضل كعكة زفاف على الإطلاق

74
00:09:22,480 --> 00:09:29,410
أريدك أن تأكليها بشدّة، لكنّ طاقم
!قبّعة القشّ سرقوها وهربوا

75
00:09:29,410 --> 00:09:34,380
إنّهم الآن في طريقهم إلى السّاحل
!الجنوب غربيّ ليحاولوا الهرب

76
00:09:36,110 --> 00:09:38,000
...كعكة

77
00:09:38,580 --> 00:09:40,390
...الزّفاف

78
00:09:40,770 --> 00:09:45,100
!هذا صحيح! إنّها معهم! لعق

79
00:09:46,020 --> 00:09:48,560
.أفترض أنّها تستمع لي لدرجة ما

80
00:09:48,980 --> 00:09:53,280
،إن ذهبت خلف قبّعة القشّ
!فسيكون ذلك كقتل عصفورين بحجر واحد

81
00:09:57,320 --> 00:09:59,570
هل بإمكانه إقناعها بذلك؟

82
00:10:13,120 --> 00:10:16,190
،إن كنتَ تكذب

83
00:10:16,190 --> 00:10:20,100
!فستدفع الثّمن بسنوات عمرك

84
00:10:25,870 --> 00:10:26,940
!زوس

85
00:10:27,880 --> 00:10:29,140
!حاضر يا ماما

86
00:10:39,160 --> 00:10:44,220
!كعكة الزّفاف

87
00:10:54,830 --> 00:10:56,750
!أنا في ورطة

88
00:10:56,750 --> 00:11:01,930
،حتّى إن أمسكت ماما بطاقم قبّعة القشّ
!فلن تكون لديهم أيّ كعكة

89
00:11:01,930 --> 00:11:05,640
!ماذا عليّ أن أفعل؟ –
...ظننتُ أنّ ذلك كان ذكيًّا، لكن –

90
00:11:09,450 --> 00:11:13,060
!أنا هالك لا محالة عندما تعود ماما

91
00:11:13,410 --> 00:11:15,270
!لكنّك وفّرت لنا الوقت

92
00:11:15,270 --> 00:11:18,900
علينا إعداد الكعكة الآن
!وإلاّ انتهى أمر هذه الجزيرة أيضًا

93
00:11:19,920 --> 00:11:24,520
.ذلك مستحيل... فكّري في الأمر يا سموذي

94
00:11:24,520 --> 00:11:31,080
حتّى رئيس الطّهاة سترويزن احتاج
!لأيّام لإعداد تلك الكعكة

95
00:11:31,770 --> 00:11:37,330
المكوّنات النّادرة الّتي جمعناها
!عن طريق نهبها من بلدان أخرى انتهت

96
00:11:37,730 --> 00:11:43,300
!والشّخص الّذي بإمكانه خبزها في غيبوبة
!لا يمكنه خبز الكعكة

97
00:11:45,330 --> 00:11:51,270
ولكنّ الإشكال الأكبر هو أنّ ماما
!لم تتذوّق الكعكة حتّى

98
00:11:51,270 --> 00:11:53,350
...إذًا فهذه المرّة، علينا توفير

99
00:11:54,680 --> 00:12:01,400
الكعكة اللّذيذة الّتي لم تُأكل من قبل
.الّتي تشوّقت ماما لأكلها لأيّام

100
00:12:01,820 --> 00:12:06,580
!من بإمكانه إعداد شيء كهذا؟

101
00:12:07,140 --> 00:12:08,440
.هذا سيّئ

102
00:12:09,060 --> 00:12:11,160
!ستُدمّر هذه الجزيرة على الأقلّ

103
00:12:11,860 --> 00:12:14,600
.وما ينتظرنا... مجهول

104
00:12:28,410 --> 00:12:30,860
!أتريدون أن أساعدكم؟

105
00:12:40,890 --> 00:12:42,320
!بودينغ

106
00:12:42,320 --> 00:12:45,450
!إنّها بودينغ-ساما –
!بودينغ-ساما –

107
00:12:45,990 --> 00:12:50,040
!كانت كعكة الزّفاف كعكة شيفون بالشّكولاطة

108
00:12:50,430 --> 00:12:54,990
بإمكاني إعداد أيّ شيء بنكهة الشّكولاطة
!بنفس مستوى رئيس الطّهاة، ما لم أكن أفضل

109
00:12:54,990 --> 00:13:00,050
كما أنّ أختي شيفون خبيرة
!في إعداد كعك الشّيفون

110
00:13:00,050 --> 00:13:03,920
!لذلك بإمكاننا معًا إعداد تلك الكعكة

111
00:13:03,920 --> 00:13:06,050
!أواثقة يا بودينغ؟

112
00:13:06,050 --> 00:13:10,540
!لكنّ شيفون زوجة بيجي الّذي صار عدوّنا الآن

113
00:13:12,400 --> 00:13:14,700
!سأرغمها على ذلك

114
00:13:14,700 --> 00:13:16,440
!هذه هي بودينغ الشّرّيرة

115
00:13:16,440 --> 00:13:19,940
!ماذا؟! تتصرّف بودينغ-ساما كقاطعة طريق

116
00:13:21,560 --> 00:13:24,480
...في الحقيقة، مكوّنات الكعكة

117
00:13:24,480 --> 00:13:28,340
جُمعت معًا في بلدة الشّكولاطة
،على جزيرة الكاكاو

118
00:13:28,340 --> 00:13:29,950
.بوّابة منطقتنا

119
00:13:30,850 --> 00:13:34,160
!لذلك يوجد هناك كمّيّات إضافيّة للمكوّنات النّادرة

120
00:13:35,520 --> 00:13:36,700
!أخي بيروس

121
00:13:36,700 --> 00:13:40,500
بمجرّد أن تقضي ماما على طاقم
!قبّعة القشّ، قُدها إلى بلدة الشّكولاطة

122
00:13:41,320 --> 00:13:43,840
!سأنهي هذه المسألة

123
00:13:44,530 --> 00:13:47,760
!أواثقة من ذلك؟! ستنقذيننا هكذا بودينغ

124
00:13:49,640 --> 00:13:52,770
!تعرّضت للإهانة من سانجي

125
00:13:53,110 --> 00:13:55,680
!يا لها من عين جميلة

126
00:13:56,390 --> 00:13:58,690
...إن استطاعت ماما القضاء عليهم

127
00:13:59,570 --> 00:14:02,320
.فعليّ تقديم مكافأة لها

128
00:14:07,180 --> 00:14:08,650
!انتظر فحسب

129
00:14:09,140 --> 00:14:10,110
!يا سانجي

130
00:14:12,470 --> 00:14:13,370
ما الخطب؟

131
00:14:13,370 --> 00:14:15,700
...شعرتُ برعشة في قلبي

132
00:14:16,330 --> 00:14:19,090
أعتقد أنّ هنالك فتاة ظريفة
...تتحدّث عنّي كالمعتاد

133
00:14:19,090 --> 00:14:21,250
!يمكنني رؤية غابة الإغواء

134
00:14:21,810 --> 00:14:25,720
!هل سندخل تلك الغابة ثانية؟
.آمل أن نخرج على خير

135
00:14:27,030 --> 00:14:28,510
ماذا يوجد هناك؟

136
00:14:30,200 --> 00:14:33,060
!لا، توقّف يا كين-تشان

137
00:14:33,460 --> 00:14:35,970
هل أنت بخير يا كين-تشان؟

138
00:14:35,970 --> 00:14:40,790
هذا مؤلم! إنّ الخياطة تؤلم-جو
...يا ليدي تري

139
00:14:40,790 --> 00:14:46,530
.أنا آسفة... لكنّ جزئيك سيلتئمان معًا قريبًا
!مثلنا نحن تمامًا

140
00:14:46,790 --> 00:14:50,720
!هذا مؤلم! تريّثي عليّ

141
00:14:55,520 --> 00:14:57,620
!ماذا؟ كلاّ! كيف؟

142
00:14:58,560 --> 00:15:00,310
!أنت هناك

143
00:15:01,480 --> 00:15:03,190
!أنت

144
00:15:03,940 --> 00:15:07,290
!أنت حيّ يا كينغباوم

145
00:15:08,820 --> 00:15:10,920
!سرّتني رؤيتك ثانية

146
00:15:10,920 --> 00:15:12,120
!يا كين

147
00:15:17,120 --> 00:15:18,850
...ا... ا

148
00:15:19,750 --> 00:15:22,290
!اذهبوا بعيدًا عنّي

149
00:15:22,920 --> 00:15:25,520
!سأجعلكم تدفعون الثّمن أيّها الأوغاد

150
00:15:25,870 --> 00:15:29,150
!كين-تشان –
!ليدي تري –

151
00:15:32,230 --> 00:15:34,410
!لا تنظر للخلف! انطلق للأمام مباشرة

152
00:15:34,880 --> 00:15:36,950
!سُحقًا

153
00:15:37,270 --> 00:15:41,660
ماذا؟ ظننتُ أنّهم أخذوا منك
.فيفر كارد لولا يا نامي

154
00:15:42,060 --> 00:15:44,830
.ذلك صحيح. لكنّي قصصتها لنصفين من قبل

155
00:15:44,830 --> 00:15:46,090
!فكرة ذكيّة

156
00:15:46,090 --> 00:15:48,000
!إنّنا ننطلق بسرعة

157
00:15:48,340 --> 00:15:51,920
،بما أنّه سيّد غابة الإغواء
!فبإمكانه الانتقال في خطّ مستقيم

158
00:15:52,220 --> 00:15:55,640
!جيّد! واصل التّقدّم إلى ساني بكامل سرعتك

159
00:15:55,640 --> 00:15:56,950
!واصل

160
00:15:56,950 --> 00:16:02,320
!إنّكم أشبه بطاعون-جو
!غادروا هذه البلاد بسرعة-جو

161
00:16:02,320 --> 00:16:03,780
هل قلتَ شيئًا ما؟

162
00:16:04,750 --> 00:16:07,500
!افعل ما تأمرك به نامي-سان

163
00:16:13,890 --> 00:16:18,870
!هدفنا أمامنا مباشرة! أطيحوا بهم

164
00:16:18,870 --> 00:16:22,080
!أجل

165
00:16:23,270 --> 00:16:25,060
!إنّ العدوّ خلفنا

166
00:16:26,710 --> 00:16:28,000
!تقدّموا

167
00:16:28,000 --> 00:16:30,590
!أجل

168
00:16:31,190 --> 00:16:32,930
!أسرع يا كينغباوم

169
00:16:32,930 --> 00:16:34,840
!أنا أنطلق بأسرع ما يمكنني-جو

170
00:16:34,840 --> 00:16:37,590
!إن أمسكوا بك، فسأنزع ذلك الخيط

171
00:16:37,590 --> 00:16:38,970
!أنت فظيعة

172
00:16:43,540 --> 00:16:45,350
!مرّ شيء ما فوق رؤوسنا

173
00:16:48,550 --> 00:16:50,480
...ذلك الصّوت –
!لا يُعقل –

174
00:16:53,880 --> 00:16:55,570
!ماذا؟

175
00:16:56,130 --> 00:17:02,730
!كعكة الزّفاف

176
00:17:03,560 --> 00:17:06,380
!بيغ مام

177
00:17:10,210 --> 00:17:12,010
!أعطوني إيّاها

178
00:17:34,710 --> 00:17:36,910
!أطيحوا بهم

179
00:17:48,470 --> 00:17:52,850
إنّ الجنود النّسخ صُنعوا ليكونوا
.مقاتلين لا يهابون الموت

180
00:17:53,770 --> 00:18:00,240
ونحن قراصنة بيغ مام لنستولي
!على تلك القوّة العسكريّة

181
00:18:32,840 --> 00:18:37,950
!وجدت الغرفة الّتي يصنعون فيها الجنود النّسخ

182
00:18:47,540 --> 00:18:51,210
...أجل! عرش بدون ملك

183
00:18:52,080 --> 00:18:54,350
...كم هذا محزن

184
00:18:54,710 --> 00:18:56,610
!فكّكوه في الحال

185
00:18:57,340 --> 00:18:58,820
.هنالك ملك بالفعل

186
00:19:01,410 --> 00:19:02,410
...أنت

187
00:19:15,790 --> 00:19:17,970
!ما-ماذا؟

188
00:19:18,220 --> 00:19:19,300
!تخفّي

189
00:19:30,160 --> 00:19:35,520
لا يُسمح لكم بالتّقدّم أكثر من هذا
!أيّها المسخ ذا الشّعر الأشعث

190
00:19:36,380 --> 00:19:39,360
!احترق! احترق! احترق

191
00:19:41,180 --> 00:19:42,660
!احترق بالكامل

192
00:19:53,400 --> 00:19:56,020
!لا تتمادى كثيًا

193
00:19:57,610 --> 00:20:01,930
!شكرًا لقيامكم بما يحلو لكم في مملكتنا

194
00:20:02,390 --> 00:20:03,890
...كلاّ

195
00:20:21,420 --> 00:20:25,120
!كيف تجرؤون على الاستخفاف بنا؟

196
00:20:25,120 --> 00:20:30,290
!يا قراصنة بيغ مام! لن نسامحكم على هذا أبدًا

197
00:20:31,520 --> 00:20:34,710
.سندفع لكم مع الفوائد

198
00:20:43,880 --> 00:20:45,180
!بيغ مام

199
00:20:47,680 --> 00:20:49,910
!لوفي، تحكّم في نفسك

200
00:20:49,910 --> 00:20:52,180
!اخرس –
!انتظر –

201
00:20:52,180 --> 00:20:54,310
!دعني يا جينبي

202
00:20:54,310 --> 00:21:00,150
!العودة إلى ساني هي هدفنا
!لا تنس ذلك

203
00:21:05,630 --> 00:21:08,410
!تقترب بيغ مام منّا

204
00:21:09,410 --> 00:21:11,160
!ما الّذي أتى بماما إلى الجبهة الأماميّة؟

205
00:21:11,160 --> 00:21:13,620
!وانظروا إليها... إنّها ليست على طبيعتها

206
00:21:14,070 --> 00:21:16,080
!هذا لا يُعقل! إنّها في نوبة جوع

207
00:21:16,450 --> 00:21:20,290
!كعكة الزّفاف

208
00:21:20,290 --> 00:21:22,750
!أضِعها يا كينغباوم

209
00:21:22,750 --> 00:21:24,510
!ذلك مستحيل-جو

210
00:21:24,510 --> 00:21:26,850
!لا شيء مستحيل –
!كيف أستطيع ذلك؟ –

211
00:21:26,850 --> 00:21:29,740
!اهربوا –
!يا كين –

212
00:21:31,100 --> 00:21:34,940
!أسرع نحو ساني

213
00:21:55,930 --> 00:21:58,710
!قبّعة القشّ

214
00:21:58,710 --> 00:22:01,210
!أعطني الكعكة

215
00:22:01,900 --> 00:22:05,050
!اخرسي! لا أدري ما الّذي تتحدّثين عنه

216
00:22:06,090 --> 00:22:08,000
...إنّها

217
00:22:08,180 --> 00:22:13,220
!كعكتي

218
00:22:14,930 --> 00:22:16,640
!تماسك يا كينغباوم

219
00:22:22,040 --> 00:22:26,150
!تذوّقوا رمح إلباف

220
00:22:26,150 --> 00:22:27,450
!إلباف؟

221
00:22:31,720 --> 00:22:33,100
!انتبهوا من هجومها

222
00:22:45,260 --> 00:22:48,550
!سيادة إيكوكو

223
00:23:24,830 --> 00:23:29,120
!إنّ بيغ مام تطير وعي على أعقابهم
!وغابة الإغواء أمامهم

224
00:23:29,120 --> 00:23:34,000
،مع تزايد الضّغط في هذا الوضع الخاسر
!تفكّر نامي في خطّة للعثور على مهرب

225
00:23:34,000 --> 00:23:37,270
.في تلك الأثناء، تلمع دمعة واحدة في عين بودينغ

226
00:23:37,270 --> 00:23:38,930
لكن هل هي حقيقيّة أم لا؟

227
00:23:38,930 --> 00:23:41,270
!سيُكشف عن أفكارها الحقيقيّة قريبًا

228
00:23:41,270 --> 00:23:42,730
:في الحلقة القادمة من وان بيس

229
00:23:42,730 --> 00:23:45,640
"!عزيمة بودينغ! غابة الإغواء تشتعل"

230
00:23:45,640 --> 00:23:48,040
!ملك القراصنة، لن يكون إلاّ أنا