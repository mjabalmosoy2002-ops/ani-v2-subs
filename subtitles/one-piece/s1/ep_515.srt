1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:21,460 --> 00:03:27,360
كان لوفي مكتئبًا بعد فقدانه
.لأخيه إيس في الحرب ضدّ البحريّة

38
00:03:27,360 --> 00:03:30,570
!أيّ ملك قراصنة سأكون؟

39
00:03:30,570 --> 00:03:34,790
!أنا جدّ ضعيف

40
00:03:36,160 --> 00:03:39,010
.لكنّه أدرك أهمّيّة الصّداقة

41
00:03:39,930 --> 00:03:45,090
وعاد إلى مارينفورد نزولاً عند
.اقتراح لملك الظّلام ريلي

42
00:03:46,510 --> 00:03:49,380
وصلت رسالته إلى بقيّة طاقم قبّعة القشّ

43
00:03:49,380 --> 00:03:53,180
عبر أخبار تصرّف لوفي الغامض

44
00:03:53,180 --> 00:03:55,680
.وبدأ كلّ واحد منهم باتّخاذ مبادرة من نفسه

45
00:03:58,030 --> 00:04:01,500
.يريد لوفي أن يصير ملك القراصنة

46
00:04:01,500 --> 00:04:05,360
!لذلك عليّ تحسين مهاراتي كملاّحة

47
00:04:06,800 --> 00:04:11,750
.يا لوفي. ما زالت حياة ثاوزند ساني طويلة

48
00:04:13,030 --> 00:04:18,550
أنت هو القبطان الوحيد الّذي يمكنه
."جعلها "سفينة الأحلام

49
00:04:21,710 --> 00:04:25,730
...لوفي، إن أمكنني رؤيتك ثانية

50
00:04:26,760 --> 00:04:29,810
فسوف أدعمك أفضل دعم في العالم

51
00:04:29,810 --> 00:04:33,010
!بإمكان طبّاخ أن يمنحه لتصير ملك القراصنة

52
00:04:38,160 --> 00:04:42,520
!سأصير أقوى وأقوى بكثير"
".عهد زورو لقبطانه

53
00:04:44,150 --> 00:04:49,070
في مملكة تينا غينا على جزيرة كينزان
...في الغراند لاين

54
00:04:49,070 --> 00:04:52,530
!اقترب أنت واقتربوا أنتم

55
00:04:55,240 --> 00:04:58,040
!ثمّة الكثير من النّاس هنا
!ما الّذي أتوا لمشاهدته؟

56
00:04:58,530 --> 00:05:01,710
.سمعت أنّهم عثروا على مخلوق غريب

57
00:05:01,710 --> 00:05:06,960
!اقتربوا لتروه! عرض المخلوق الغامض

58
00:05:07,730 --> 00:05:10,880
!لا صدر! لا لحم

59
00:05:11,390 --> 00:05:12,840
!لا عيون

60
00:05:13,260 --> 00:05:16,800
!يبدو مهيكل عظميّ حقيقيّ

61
00:05:16,800 --> 00:05:19,660
!كما أنّ لديه مفصل واحد في ذراعيه

62
00:05:19,660 --> 00:05:23,810
!أتساءل إن كان هنالك مخلوق أندر منه

63
00:05:23,810 --> 00:05:27,150
!مهلاً، كفّ عن الكذب يا هذا

64
00:05:27,150 --> 00:05:30,400
ماذا؟ ما الخطأ في هذا؟

65
00:05:30,400 --> 00:05:34,060
!إنّه لا يتحرّك إطلاقًا

66
00:05:34,060 --> 00:05:36,320
إنّه مجرّد دمية، صحيح؟

67
00:05:39,700 --> 00:05:42,220
.اتّخذ لوفي-سان قراره

68
00:05:42,220 --> 00:05:44,900
.حسنًا، عليّ القيام بأمر ما أيضًا

69
00:05:44,900 --> 00:05:47,830
!أيّها الهيكل العظميّ، لا تعبث معنا

70
00:05:47,830 --> 00:05:50,510
!عليّ القيام بأمر ما

71
00:05:51,090 --> 00:05:54,680
!أدركت الأمر الآن، صحيح؟ هذا صحيح. تحرّك

72
00:05:54,680 --> 00:05:56,390
!علينا أن نريهم شيئًا ما

73
00:05:56,840 --> 00:05:59,280
...ما الّذي بإمكاني فعله للمساعدة

74
00:05:59,280 --> 00:06:03,850
!أخبرك للتّوّ! يكفي أن تتحرّك! تحرّك فقط

75
00:06:04,360 --> 00:06:05,940
!ما الّذي يحدث؟

76
00:06:14,820 --> 00:06:20,080
...عندما رآني لأوّل مرّة، لم يخف منّي إطلاقًا

77
00:06:20,080 --> 00:06:22,910
.وطلب منّي أن أنضمّ إليهم

78
00:06:23,660 --> 00:06:25,830
...دعك من كلّ ذلك الآن

79
00:06:26,870 --> 00:06:28,290
!وانضمّ لطاقمي

80
00:06:28,880 --> 00:06:30,420
.حسنًا، موافق

81
00:06:34,470 --> 00:06:36,430
،طوال خمسين عامًا

82
00:06:36,930 --> 00:06:42,220
كنت أهيم في المياه المظلمة فحسب وما
.من كلمات لتصف مدى فرحتي بسماع ذلك

83
00:06:44,890 --> 00:06:48,310
.سرق ذلك الرّجل ظلّي

84
00:06:48,980 --> 00:06:51,140
!لا تتصرّف وكأنّك غريب

85
00:06:51,140 --> 00:06:54,030
!إن كنت تحتاج لظلّك، فسأستعيده لك

86
00:07:18,180 --> 00:07:24,390
!أنا سعيد لكوني حيًّا

87
00:07:25,310 --> 00:07:26,890
!بالطّبع أنت سعيد

88
00:07:27,600 --> 00:07:30,110
أيمكنني الانضمام لطاقمك؟

89
00:07:30,110 --> 00:07:31,480
.نعم، أكيد

90
00:07:31,480 --> 00:07:33,730
!ماذا؟! كان ذلك سريعًا

91
00:07:33,730 --> 00:07:35,490
!لقد انضمّ

92
00:07:39,160 --> 00:07:42,710
...لا يمكنني شرح كم بدوت ساطعًا لي

93
00:07:44,210 --> 00:07:50,040
لأنّ 50 عامًا من انتظار حدوث معجزة
.قد آتت أُكلها في تلك اللّحظة

94
00:07:50,040 --> 00:07:51,420
!نريد استعادة مالنا

95
00:07:51,420 --> 00:07:52,500
!نعم، نعم

96
00:07:52,500 --> 00:07:57,550
!تبًّا! ظننتُ أنّ بإمكاننا جني المال منه
.لم يعد أمامنا خيار

97
00:07:57,550 --> 00:07:59,970
...علينا أن نجبره على

98
00:07:59,970 --> 00:08:00,970
ماذا؟

99
00:08:04,350 --> 00:08:06,100
...إ-إنّه يتحرّك

100
00:08:12,040 --> 00:08:14,050
‫40 درجة!

101
00:08:15,780 --> 00:08:17,480
!ماذا؟

102
00:08:17,480 --> 00:08:19,320
!هذا صعب

103
00:08:19,320 --> 00:08:22,070
!إنّه يتكلّم ويتحرّك بالفعل

104
00:08:22,070 --> 00:08:23,240
!كم هذا مخيف

105
00:08:23,240 --> 00:08:24,700
!ما ذلك الشّيء؟

106
00:08:24,700 --> 00:08:29,710
،عندما أجرّب زاوية أقلّ من 45
!أنزلق كما توقّعت

107
00:08:29,710 --> 00:08:32,630
...لكن عندما سأتجاوز ذلك

108
00:08:33,800 --> 00:08:37,680
.فربّما سأستطيع مساعدة لوفي-سان أكثر

109
00:08:38,840 --> 00:08:41,720
...لا، ربّما عليّ التّفكير في طريقة أخرى

110
00:08:47,100 --> 00:08:48,770
!إنّه يحمل غيتارًا

111
00:08:48,770 --> 00:08:49,770
!ما الّذي سيفعله؟

112
00:08:49,770 --> 00:08:52,030
!ماذا يحدث هذه المرّة؟

113
00:08:52,030 --> 00:08:55,610
!ليس عليك فعل أيّ شيء
!يكفي أنّك مسخ

114
00:08:55,610 --> 00:08:59,900
!قلتَ مسخ؟ نادني بما يحلو لك

115
00:08:59,900 --> 00:09:04,030
!ما عادت "الوحدة" كلمةً في قاموسي

116
00:09:06,970 --> 00:09:10,660
لكن أيّها الحضور، أليس من المملّ أن تنظروا فحسب؟

117
00:09:11,040 --> 00:09:12,580
ما هذا الإيقاع؟

118
00:09:12,580 --> 00:09:14,290
!إنّه يجعل قلبي ينبض أكثر

119
00:09:20,380 --> 00:09:23,500
...سأقدّم لكم أغنيتي الجديدة

120
00:09:23,500 --> 00:09:26,560
!جامح حتّى العظام

121
00:09:32,770 --> 00:09:37,400
في تلك الأثناء، قرب الجسر العملاق
...في الأزرق الشّرقيّ

122
00:09:38,480 --> 00:09:41,370
ما الّذي جعلك تغيّرين رأيك؟

123
00:09:41,370 --> 00:09:43,530
.صرت موافقة الآن على الذّهاب لبالتيغو معنا

124
00:09:44,320 --> 00:09:46,400
.حسنًا، أسعدنا سماع ذلك في كلّ الأحوال

125
00:09:46,400 --> 00:09:50,040
.لطالما أراد دراغون-سان أن يلتقي بك

126
00:09:50,660 --> 00:09:53,350
.لم أكن أعلم بوجود أشخاص مثلكم

127
00:09:53,350 --> 00:09:55,670
.أتمنّى لو أنّكم أتيتم لرؤيتي باكرًا

128
00:09:56,420 --> 00:09:57,680
!أ-أنا آسف

129
00:09:57,680 --> 00:10:01,610
.لم نكن نعلم أنّك كنت حليفة لكروكودايل

130
00:10:02,510 --> 00:10:04,680
.أمزح فحسب. كنت أعبث معكم فحسب

131
00:10:04,680 --> 00:10:09,170
.لا أقصد الإهانة، لكنّي سعيد لأنّ الأمور سارت هكذا

132
00:10:10,140 --> 00:10:14,520
!سننطلق! سننطق إلى بالتيغو

133
00:10:39,420 --> 00:10:44,570
اذهبي وقابلي أصدقاءَ أنا واثق أنّهم بانتظارك
!في مكان ما من البحر يا روبين

134
00:10:47,430 --> 00:10:49,560
!مكافأتها 79 مليون بيري؟

135
00:10:49,560 --> 00:10:52,220
مكافأة مرتفعة كهذه على رأس
!فتاة في الثّامنة؟

136
00:10:52,220 --> 00:10:55,300
يقولون أنّها ناجية من شياطين أوهارا

137
00:10:55,300 --> 00:10:57,440
.الّذين كانوا ينوون تدمير العالم

138
00:10:57,440 --> 00:10:59,360
أوهارا؟

139
00:10:59,360 --> 00:11:04,340
لا أدري كيف، لكنّهم قالوا أنّها أغرقت
.ستّ سفن حربيّة للبحريّة

140
00:11:04,340 --> 00:11:06,110
.لهذا السّبب مكافأتها مرتفعة

141
00:11:08,140 --> 00:11:12,040
إنّها ابنة الشّيطان الّتي
.لا يجب السّماح لها بالعيش

142
00:11:14,500 --> 00:11:16,710
.حسنًا! انتظري هناك فحسب

143
00:11:17,580 --> 00:11:19,790
لماذا أتيتم لإنقاذي؟

144
00:11:19,790 --> 00:11:23,160
!متى طلبتُ منكم أن تنقذوني؟

145
00:11:29,090 --> 00:11:32,630
!كلّ ما أريده... هو الموت فحسب

146
00:11:35,350 --> 00:11:38,030
.أدرك تمامًا الآن هويّة عدوّ روبين

147
00:11:39,780 --> 00:11:41,980
.أطلق على ذلك العلم

148
00:11:50,530 --> 00:11:51,620
!مستحيل

149
00:11:51,620 --> 00:11:53,330
!هل أنتم مجانين؟

150
00:11:53,330 --> 00:11:56,750
لا تظنّوا أنّكم ستنجون بعد جعلكم
!للعالم بأسره عدوًّا لكم

151
00:11:56,750 --> 00:12:01,830
!تلك غايتي من الأساس

152
00:12:04,500 --> 00:12:06,090
!روبين

153
00:12:06,600 --> 00:12:09,630
!ما زلنا لم نسمعك تقولينها

154
00:12:12,740 --> 00:12:16,100
!قولي أنّك تريدين أن تعيشي

155
00:12:23,110 --> 00:12:30,780
إن كان من المسموح لي بالفعل
...البوح بأمنيتي أخيرًا، فأنا

156
00:12:33,400 --> 00:12:35,990
!أريد أن أعيش

157
00:12:36,330 --> 00:12:40,450
!خذوني للبحر معكم

158
00:12:47,420 --> 00:12:51,510
.روبين-سان، ادخلي. الجوّ بارد هنا

159
00:12:52,000 --> 00:12:57,220
.سأبقى هنا. أنا قرصانة وأنتم ثوريّون

160
00:12:57,220 --> 00:12:59,320
.لا أستطيع أن أثق بكم بسهولة

161
00:13:00,230 --> 00:13:03,650
.لا يمكنني ببساطة الدّخول لحجرة بلا مخارج

162
00:13:03,650 --> 00:13:07,610
!رجاءً! لا نحمل تجاهك أيّ عداء

163
00:13:07,610 --> 00:13:12,740
دعوني أبقى هنا. هكذا عشت أيّامي
.عندما كنت وحدي

164
00:13:12,740 --> 00:13:15,240
.آسف. مفهوم

165
00:13:15,240 --> 00:13:18,060
!أنت، أحضر كلّ ما تستطيع حمله من الأغطية

166
00:13:18,060 --> 00:13:20,750
!إضافة لمشروب وطعام ساخنين أيضًا

167
00:13:21,360 --> 00:13:23,080
...لكنّ كلّ شيء جاهز في الدّاخل

168
00:13:23,080 --> 00:13:26,000
!بسرعة! وأحضر أيضًا واقية من الرّياح وأريكة

169
00:13:26,000 --> 00:13:26,910
!حاضر

170
00:13:28,920 --> 00:13:32,550
لوفي، أتظنّ أنّ بإمكاني أن أصير أقوى

171
00:13:32,550 --> 00:13:35,140
عن طريق السّباحة مع تيّار الزّمن

172
00:13:35,140 --> 00:13:37,510
تحت راية والدك؟

173
00:13:40,140 --> 00:13:43,140
...لم أعتقد أبدًا أنّني قد أريد أن أصير أقوى

174
00:13:44,310 --> 00:13:46,370
.من أجل شخص آخر

175
00:14:02,410 --> 00:14:07,110
...في تلك الأثناء، في أرخبيل بوين في الغراند لاين

176
00:14:10,210 --> 00:14:12,800
ما الأمر هذه المرّتن يا أوسوبّن؟

177
00:14:12,800 --> 00:14:15,890
!أوّلاً، عليّ فقدان وزني! ثمّ الزّيادة من قوّتي

178
00:14:15,890 --> 00:14:18,100
!نعم، من الأفضل فعل ذلك

179
00:14:18,100 --> 00:14:20,180
!ثمّ سأصير أقوى

180
00:14:20,180 --> 00:14:23,140
!نعم، هذه هي الطّريقة الوحيدة لمغادرة هذه الجزيرتن

181
00:14:23,470 --> 00:14:25,900
!وسأصير أقوى بكثير

182
00:14:25,900 --> 00:14:27,980
!نعم، هذا جيّد أيضنن

183
00:14:27,980 --> 00:14:30,400
!ثمّ أقوى، وأقوى بكثير

184
00:14:30,400 --> 00:14:32,570
!ماذا؟ إ-إلى ذلك الحدّن؟

185
00:14:32,570 --> 00:14:36,190
!أقوى بكثير وكثير وكثير وكثير وكثير

186
00:14:36,190 --> 00:14:37,820
!مذهل، صرت جادًّا للغايتن

187
00:14:39,500 --> 00:14:41,520
...صرت هكذا فجأة

188
00:14:42,950 --> 00:14:45,750
ما الّذي قرأته في تلك الصّحيفتن؟

189
00:14:50,880 --> 00:14:54,720
.تلقّيت رسالة من قبطاننا

190
00:14:54,720 --> 00:14:56,630
رسالة؟

191
00:14:56,630 --> 00:14:59,720
.عمّ تتحدّث؟ اصعد بسرعة

192
00:14:59,720 --> 00:15:00,890
!ماذا؟

193
00:15:02,350 --> 00:15:04,930
نحن أصدقاء الآن، صحيح؟

194
00:15:15,440 --> 00:15:18,110
!لوفي

195
00:15:19,950 --> 00:15:26,370
أو-أوسوبّ...؟ إ-إذًا... أتيت؟

196
00:15:26,790 --> 00:15:31,460
!اهزمه! سنعود جميعًا معًا يا لوفي

197
00:15:31,460 --> 00:15:34,790
!لا جدال في ذلك

198
00:15:36,720 --> 00:15:38,050
...ظننتُ

199
00:15:38,050 --> 00:15:45,540
أنّ بإمكان لوفي أن يصير ملك
.القراصنة بدون مساعدتي

200
00:15:46,930 --> 00:15:48,940
!وصلنا أخيرًا إلى هنا

201
00:15:50,230 --> 00:15:55,480
،بمجرّد أن نقطع النّصف الثّاني من العالم
...سيتسنّى لنا رؤية هذا الجدار ثانية

202
00:15:55,480 --> 00:15:58,900
!وحينها... سأكون ملك القراصنة

203
00:15:59,680 --> 00:16:01,720
.لكنّي كنت مخطئًا

204
00:16:02,200 --> 00:16:05,780
.ثمّة العديد من الأعداء يفوقونه قوّة

205
00:16:05,780 --> 00:16:08,070
.قد يُهزم لوفي

206
00:16:08,070 --> 00:16:11,670
!إنّه يضغط على نفسه ويطلب المساعدة

207
00:16:11,670 --> 00:16:13,210
...لهذا السّبب

208
00:16:13,210 --> 00:16:17,200
!يحتاج إلى دعمي

209
00:16:20,880 --> 00:16:24,760
!يا هراكلسن، أريد أن أصير أقوى

210
00:16:24,760 --> 00:16:29,020
...أقوى بكثير وكثير وكثير

211
00:16:30,480 --> 00:16:33,110
...أخبرني أيّها المعلّم هراكلسن

212
00:16:33,770 --> 00:16:35,770
ماذا؟ الـ-المعلّمن؟

213
00:16:35,770 --> 00:16:39,700
.كان الفضول يراودني بشأن سلاحك

214
00:16:39,700 --> 00:16:43,910
.أنت قويّ بما يكفي للعيش في جزيرة خطيرة كهذه

215
00:16:43,910 --> 00:16:45,320
!أريد تعلّم الكثير منك

216
00:16:45,320 --> 00:16:47,790
قويّ؟ هل أنت معلّمن قويّ؟

217
00:16:47,790 --> 00:16:50,790
!نعم، أنت معلّم قويّ

218
00:16:50,790 --> 00:16:54,000
...و... اسمي هو

219
00:16:54,000 --> 00:16:55,290
!هراكلسن

220
00:16:55,290 --> 00:16:57,420
!يا له من اسم رائع

221
00:16:58,090 --> 00:17:01,470
!حـ-حسنًا، لماذا لا تجلس يا أوسوبّن؟

222
00:17:01,470 --> 00:17:03,140
!حاضر يا معلّم

223
00:17:04,020 --> 00:17:05,800
!اسمع يا تلميذي أوسوبّن

224
00:17:06,720 --> 00:17:09,760
ثمّة العديد من النّباتات في هذه الغابة

225
00:17:09,760 --> 00:17:14,400
تسمّى المتفجّرات الخضراء
.والّتي تنمو بعدوانيّة في الحال

226
00:17:15,770 --> 00:17:17,900
.وهذه هي الحبوبن

227
00:17:18,570 --> 00:17:20,820
المتفجٍّرات الخضراء؟

228
00:17:20,820 --> 00:17:25,490
.لكلّ واحدة منها استعمال فعّالن

229
00:17:25,490 --> 00:17:27,240
استعمال فعّال؟

230
00:17:27,240 --> 00:17:29,290
!انتظرني يا لوفي

231
00:17:31,650 --> 00:17:35,830
!اركض يا أوسوبّن! ستجعلك هذه الغابة أقوى

232
00:17:36,750 --> 00:17:38,840
،بهدف جعلك ملك القراصنة

233
00:17:39,450 --> 00:17:42,760
!سأصير ملك القنّاصين الحقيقيّ

234
00:17:49,640 --> 00:17:53,690
...في تلك الأثناء في جزيرة كورايغانا في الغراند لاين

235
00:17:53,690 --> 00:17:55,840
.في أطلال مملكة شيكّيارو

236
00:17:56,980 --> 00:17:57,820
!أرجوك

237
00:18:05,520 --> 00:18:07,870
!درّبني كسيّاف

238
00:18:08,700 --> 00:18:11,000
!خاب ظنّي فيك يا رورونوا

239
00:18:13,160 --> 00:18:16,000
هل تطلب من عدوّ الإرشاد؟

240
00:18:16,750 --> 00:18:18,080
.عار عليك

241
00:18:19,920 --> 00:18:22,920
.اخرج من هنا.  لا وقت لديّ لرجل مملّ مثلك

242
00:18:23,440 --> 00:18:27,510
.أظنّ أنّني بالغت في تقديرك

243
00:18:29,470 --> 00:18:32,520
.ما الّذي تفعله؟ هذا محرج فحسب

244
00:18:33,440 --> 00:18:35,440
!أريد أن أصير أقوى

245
00:18:35,440 --> 00:18:38,810
هزمتك مجموعة من قردة الرّبّاح

246
00:18:38,810 --> 00:18:41,470
،ولم تستطيع الذّهاب للبحر
.فعدت إلى هنا

247
00:18:41,470 --> 00:18:43,990
.ليس لديّ ما أعلّمه لشخص مثلك

248
00:18:47,660 --> 00:18:48,910
.هزمت تلك القردة

249
00:18:50,440 --> 00:18:51,700
هزمها؟

250
00:18:53,120 --> 00:18:55,660
!أنت الوحيد المتبقّي هنا لأهزمه

251
00:18:55,660 --> 00:19:02,090
لكنّي لستُ غبيًّا لتلك الدّرجة
!لأظنّ أنّي جيّد كفاية لهزيمتك

252
00:19:02,090 --> 00:19:04,120
.لا أفهم

253
00:19:04,120 --> 00:19:06,950
.ما زلت تراني كعدوّ لك

254
00:19:06,950 --> 00:19:10,100
لماذا إذًا تحني رأسك لي وتطلب الإرشاد؟

255
00:19:10,980 --> 00:19:12,850
لأيّ سبب؟

256
00:19:13,960 --> 00:19:15,930
!أريد هزيمتك

257
00:19:23,930 --> 00:19:28,610
تطلب منّي أن أدرّبك كسيّاف يريد قتلي؟

258
00:19:29,100 --> 00:19:32,660
.أنت غريب. وما تطلبه مجرّد هراء

259
00:19:32,660 --> 00:19:35,580
.رغم ذلك، ما تفعله ما زال محرجًا

260
00:19:35,580 --> 00:19:40,130
يبدو أنّك عثرت على شيء أكثر
.أهمّيّة من طموحك

261
00:19:41,710 --> 00:19:45,670
.يا فتاة الأشباح، عالجيه

262
00:19:46,600 --> 00:19:49,470
!أنت، لا تمل عليّ الأوامر

263
00:19:50,060 --> 00:19:52,970
.سيبدأ التّدريب عندما تٌشفى

264
00:19:52,970 --> 00:19:57,480
!تبًّا! لا ينفكّ الجميع يطلبون منّي الكثير

265
00:19:57,480 --> 00:20:00,040
!هيّا، تحرّك بسرعة

266
00:20:02,020 --> 00:20:03,520
.يا له من مغفّل أخرق

267
00:20:04,320 --> 00:20:07,360
،عندما يبتلع رجل مثلك كرامته

268
00:20:07,360 --> 00:20:10,450
.يكون ذلك دائمًا من أجل شخص آخر

269
00:20:11,570 --> 00:20:15,080
شطب على "3 أ" وكتب عوضها "2 س"؟

270
00:20:15,080 --> 00:20:18,250
!صحيح! ثمّة وشم على ذراعه اليمنى

271
00:20:18,250 --> 00:20:23,480
وعدنا بعضنا أن نلتقي ثانية
.في مكان معيّنة بعد 3 أيّام

272
00:20:24,540 --> 00:20:26,340
.لكن لم نستطع الوفاء بدلك

273
00:20:26,950 --> 00:20:30,500
!"إذًا "3 أ" تعني "3 أيّام

274
00:20:30,500 --> 00:20:33,730
لكن تمّ شطب "3 أ" و"2 س"...؟

275
00:20:34,810 --> 00:20:35,680
!سنتان

276
00:20:35,680 --> 00:20:36,770
!إنّها تعني سنتان

277
00:20:36,770 --> 00:20:40,980
.سيكون اللّقاء بعد سنتين بدل 3 أيام

278
00:20:40,980 --> 00:20:45,400
.وتمّ القيام بكلّ شيء آخر فقط لجلب الاهتمام له

279
00:20:45,400 --> 00:20:51,530
.هذه رسالة موجّهة لنا حصرًا. اتّخذ لوفي قراره

280
00:20:52,360 --> 00:20:56,240
حتّى إن أسرعنا إلى هناك الآن، فلن نكون
.جيّدين كفاية للإبحار في العالم الجديد

281
00:20:56,240 --> 00:20:58,900
.عليّ أن نتوقّف ونصير أقوى

282
00:20:59,790 --> 00:21:02,710
!ثمّ سنلتقي ثانية مهما كلّ الأمر

283
00:21:09,840 --> 00:21:12,840
!أنت، أخبرتك أن ترتاح

284
00:21:24,980 --> 00:21:26,280
!...أنت

285
00:21:28,990 --> 00:21:31,240
!لا جدوى

286
00:21:32,070 --> 00:21:35,700
!مـ-من تكون؟

287
00:21:35,700 --> 00:21:37,700
!أنا مونكي د. لوفي

288
00:21:38,410 --> 00:21:40,620
!الرّجل الّذي سيصبح ملك القراصنة

289
00:21:41,690 --> 00:21:45,830
وحتّى اليوم الّذي أهزمه فيه
...وأصبح السّيّاف الأقوى

290
00:21:45,830 --> 00:21:50,960
!فلن... أهزم أبدًا
...هل لديك أيّ مشكلة في ذلك

291
00:21:52,840 --> 00:21:54,760
!يا ملك القراصنة؟

292
00:21:57,350 --> 00:21:58,180
!لا

293
00:21:59,510 --> 00:22:02,230
.لا يوجد وقت كاف لكلّ شيء على أيّ حال

294
00:22:02,730 --> 00:22:04,140
.لنبدأ

295
00:22:08,400 --> 00:22:10,610
.قلتَ أنّك هزمت قردة الرّبّاح

296
00:22:11,240 --> 00:22:14,990
لقد حصلت على مهارات المسايفة
.عن طريق تقليد البشر

297
00:22:15,610 --> 00:22:19,450
.ثمّة رُتب بينها ولديها سيّد

298
00:22:19,450 --> 00:22:23,330
.إنّه القائد الّذي يحكم كلّ قردة الرّبّاح على الجزيرة

299
00:22:26,710 --> 00:22:27,750
...ذلك السّيف

300
00:22:27,750 --> 00:22:31,210
.لقد أتقن حمله عن طريق تقليدي

301
00:22:31,210 --> 00:22:34,340
.إنّه مختلف عن بقيّة القردة الّتي قاتلتها

302
00:22:34,340 --> 00:22:35,880
!يبدو ذلك ممتعًا

303
00:22:36,550 --> 00:22:39,390
!سأصير أقوى وأقوى بكثير

304
00:22:59,120 --> 00:23:02,950
!لنلتقِ ثانية في أرخبيل شابوندي بعد سنتين

305
00:23:11,460 --> 00:23:15,260
قرّر طاقم قبّعة القشّ أن يصيروا
.أقوى ويجتمعوا ثانية بعد سنتين

306
00:23:15,260 --> 00:23:18,760
،وصل لوفي إلى جزيرة روسكاينا غير المأهولة

307
00:23:18,760 --> 00:23:20,850
حيث سيبدأ التّدرّب على قوّته الجديدة

308
00:23:20,850 --> 00:23:23,290
بهدف مواجهة أعداء جدد ومغامرات جديدة

309
00:23:23,290 --> 00:23:26,100
!تنتظره في العالم الجديد

310
00:23:26,100 --> 00:23:27,390
:في الحلقة القادمة من وان بيس

311
00:23:27,390 --> 00:23:31,120
"!يبدأ تدريب لوفي! إلى حيث تواعدنا بعد سنتين"

312
00:23:31,120 --> 00:23:33,520
!ملك القراصنة، لن يكون إلاّ أنا

313
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة