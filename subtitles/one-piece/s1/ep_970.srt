1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:00,840 --> 00:02:04,070
!تمّ حلّ قراصنة روجر

29
00:02:04,510 --> 00:02:11,300
،بعض وصولهم للجزيرة الأخيرة لافتيل
.تمّ حلّ قراصنة روجر

30
00:02:11,770 --> 00:02:17,540
وعلِم أودن الّذي عاد إلى بلاد وانو
.أنّ أوروتشي قد حلّ محلّ الشّوغن

31
00:02:22,030 --> 00:02:25,380
!أنا أفهم كيف يقوم أوروتشي بأعماله

32
00:02:25,780 --> 00:02:29,950
!يا رفاق! احموا عائلتي

33
00:02:31,250 --> 00:02:32,600
!أودن-سان

34
00:02:33,750 --> 00:02:36,330
!احموا كوري

35
00:02:40,170 --> 00:02:44,840
"!أخبار محزنة! بداية عصر القراصنة العظيم"

36
00:02:48,740 --> 00:02:50,310
!أودن-سان

37
00:02:50,310 --> 00:02:53,140
!هل ستذهب لمهاجمة أوروتشي؟

38
00:02:56,060 --> 00:02:59,960
.توكي، ليس عليك الخوف بعد الآن

39
00:03:01,070 --> 00:03:02,880
!لا! لا تذهب

40
00:03:03,150 --> 00:03:05,380
!ما من رادع لأوروتشي

41
00:03:05,780 --> 00:03:10,350
أعرف كيف تشعر، لكن من الخطير
!جدًّا أن تهاجم دون خطّة

42
00:03:11,700 --> 00:03:13,640
...سأترك كوري لكم

43
00:03:18,380 --> 00:03:23,790
،لا أفهم الأمور المعقّدة
.لكن أظنّ أنّ هذا ما حدث

44
00:03:24,340 --> 00:03:26,820
!استولى مخبول على بلاد وانو

45
00:03:27,300 --> 00:03:28,820
،وبمساعدة قرصان قويّ

46
00:03:28,820 --> 00:03:34,120
استغلّ المخبول الضّعيف فترة العزلة
...الّتي ضمنت له عدم تدخّل أحد

47
00:03:42,190 --> 00:03:44,150
...وهو يحاول الآن

48
00:03:45,700 --> 00:03:48,730
!تحويل هذه البلاد إلى جحيم

49
00:03:56,080 --> 00:03:57,310
!اشربوا

50
00:03:57,310 --> 00:03:58,560
!ارقصوا

51
00:03:58,890 --> 00:04:00,730
!غنّوا

52
00:04:00,960 --> 00:04:03,690
!ابتهجوا

53
00:04:17,850 --> 00:04:20,580
...إنّها بلاد جميلة

54
00:04:21,110 --> 00:04:24,500
!لن أسمح له بتحويلها إلى جحيم

55
00:04:37,210 --> 00:04:38,310
!مـ-مهلاً

56
00:04:38,640 --> 00:04:39,660
!نـ-نعم

57
00:04:39,660 --> 00:04:43,600
!حالة طارئة! يتّجه كوزكي أودن نحو عاصمة الزّهور

58
00:04:43,600 --> 00:04:45,820
!أبلغوا أوروتشي-ساما بهذا في الحال

59
00:04:50,930 --> 00:04:54,320
!أوروتشي-ساما! أجب رجاءً! أوروتشي-ساما

60
00:05:03,400 --> 00:05:04,630
!أكان هذا...؟

61
00:05:04,860 --> 00:05:06,360
!أودن-ساما؟

62
00:05:06,360 --> 00:05:08,490
!هل عاد أودن-ساما؟

63
00:05:08,490 --> 00:05:10,590
!إنّه الوريث الشّرعيّ

64
00:05:10,590 --> 00:05:12,720
!هل سيصبح الشّوغن؟

65
00:05:13,830 --> 00:05:17,470
!ستنتهي سطوة أوروتشي

66
00:05:19,750 --> 00:05:22,230
!غادر يا كوزكي أودن

67
00:05:22,500 --> 00:05:25,190
!هذه قلعة الشّوغن أوروتشي-ساما

68
00:05:25,510 --> 00:05:28,860
!لا يمكنك الدّخول بدون إذن

69
00:06:00,250 --> 00:06:02,270
!أيّها الشّوغن أوروتشي! أخل المكان رجاءً

70
00:06:02,270 --> 00:06:05,100
!ماذا؟ عمّ تتحدّث؟

71
00:06:05,400 --> 00:06:08,920
!غزا كوزكي أدون القلعة

72
00:06:08,920 --> 00:06:10,190
!ماذا؟

73
00:06:20,180 --> 00:06:22,180
...أوروتشي

74
00:06:22,400 --> 00:06:25,040
!...أوروتشي

75
00:06:27,330 --> 00:06:28,580
!أوروتشي

76
00:06:29,030 --> 00:06:31,600
!...أوروتشي

77
00:06:34,120 --> 00:06:36,840
!أوروتشي

78
00:06:44,640 --> 00:06:48,150
!مـ-مهلاً لحظة! أودن-سا... أ-أودن

79
00:06:48,150 --> 00:06:52,530
،فكّر مليًّا! إن قمت بتقطيعي
!لن يسمح كايدو بأن يمرّ هذا مرور الكرام

80
00:06:54,550 --> 00:06:57,910
!فكّر فيما سيحدث لهذه البلاد

81
00:07:00,730 --> 00:07:02,430
.سأفعل

82
00:07:04,690 --> 00:07:06,710
!بعد أن أقطّعك

83
00:07:09,690 --> 00:07:12,550
...نسيت... أنّه

84
00:07:16,820 --> 00:07:18,510
!مجنون

85
00:07:25,080 --> 00:07:27,810
!أوروتشي

86
00:07:27,810 --> 00:07:31,400
!إيّاك

87
00:07:55,410 --> 00:07:56,380
!ماذا؟

88
00:07:56,660 --> 00:07:58,840
!ما هذا؟

89
00:08:00,580 --> 00:08:03,010
!أهو زجاج؟! لا

90
00:08:06,520 --> 00:08:09,440
!اخرج يا أوروتشي

91
00:08:11,350 --> 00:08:14,290
!أوروتشي

92
00:08:17,430 --> 00:08:21,240
...لا داعي للخوف يا أوروتشي-ساما

93
00:08:24,930 --> 00:08:28,600
.ثق بتقنية الحاجز خاصّتي

94
00:08:33,540 --> 00:08:37,920
.نظريًّا، لن تسمح حواجزي باقتراب أيّ احد

95
00:08:38,100 --> 00:08:41,940
!لا فائدة من قوّتك يا أودن

96
00:08:44,200 --> 00:08:45,970
.هذا صحيح

97
00:08:45,970 --> 00:08:50,020
إن كنتَ قرصانًا، فأنا واثق أنّك ألفت

98
00:08:50,020 --> 00:08:54,840
!رؤية القوى الخارقة لفواكه الشّيطان

99
00:08:59,220 --> 00:09:00,650
!إذًا فأنت مستعمل قوى

100
00:09:02,350 --> 00:09:06,410
هذا صحيح. يسمّيهم النّاس في هذه
...البلاد بمستعملي السّحر

101
00:09:13,020 --> 00:09:20,400
،يا أودن، إن كان الغضب والعنف هما الجواب
!لكان دايميو المناطق الأخرى قاموا بذلك سلفًا

102
00:09:20,400 --> 00:09:23,130
!لا يستطيع أحد قتلي

103
00:09:27,790 --> 00:09:30,180
!أوروتشي

104
00:09:37,970 --> 00:09:40,320
!أوروتشي

105
00:09:41,680 --> 00:09:48,280
سمعتُ أنّ والدي قد جعلك
...لسبب ما نائبًا للشّوغن

106
00:09:48,730 --> 00:09:50,950
!حتّى عودتي

107
00:09:57,280 --> 00:10:00,710
!بالتّالي، أعد العرش لي الآن

108
00:10:00,710 --> 00:10:04,340
،لم أكن أنوي أن أصبح عالي الشّأن

109
00:10:04,340 --> 00:10:07,970
لكن بمقدوري جعل هذه البلاد
!أفضل ممّا فعلت أنت

110
00:10:11,930 --> 00:10:14,940
،حسنًا، لسوء الحظّ

111
00:10:14,940 --> 00:10:18,900
.هذا ليس ما قاله والدك سوكياكي

112
00:10:20,090 --> 00:10:21,780
ماذا تعني؟

113
00:10:27,600 --> 00:10:30,120
!من الجيّد رؤيتك ثانية يا أودن

114
00:10:30,120 --> 00:10:31,950
!ماذا؟! والدي؟

115
00:10:31,950 --> 00:10:33,700
...كيف تكون حيًّا

116
00:10:36,820 --> 00:10:41,090
...إنّ من وثق به الدّايميو وبقيّة الحمقى كان

117
00:10:42,280 --> 00:10:43,420
!أنا

118
00:10:45,070 --> 00:10:50,530
لقد صدّقوا كذبة من هذه العجوز
!الّتي حوّلت نفسها بقوى فاكهة النّسخ

119
00:10:52,210 --> 00:10:57,270
صدّقت البلاد بأكملها الأمر
!وجعلوني آخذ مكان الشّوغن

120
00:10:57,270 --> 00:11:02,150
!لذلك لستُ مضطرًّا لتبادل الأماكن معك

121
00:11:02,150 --> 00:11:07,910
صار الآن من المستحيل معرفة
...ما كان يفكّر به سوكياكي الحقيقيّ

122
00:11:08,220 --> 00:11:11,080
!ما الّذي فعلته بوالدي؟

123
00:11:11,080 --> 00:11:14,930
!هل مات فعلاً جرّاء المرض؟

124
00:11:33,180 --> 00:11:38,730
يومها، فوق الحشود الّتي كانت تنظر
،إلى القلعة وتهتف لعودة عشيرة كوزكي

125
00:11:38,960 --> 00:11:41,730
.وبلت سهام مسمّمة عليهم من حيث لا يدرون

126
00:11:41,730 --> 00:11:46,070
جُرح شخصان وفقدا نظرهما
.بعد نوبة من التّقيّؤ الدّامي

127
00:11:46,300 --> 00:11:49,320
بينما بقيّة سكّان البلدة الّذين
...احتموا من الفوضى

128
00:11:51,470 --> 00:11:57,180
!رأوا تنّينًا ضخمًا عاليًا في سماء العاصمة الحالكة

129
00:12:03,860 --> 00:12:08,380
كبر كرجل جامح، لكنّه صار
،دايميو كوري وخاض غمار البحر

130
00:12:08,380 --> 00:12:12,650
ووقف على قدم المساواة أمام
...أقوى قراصنة العالم

131
00:12:18,290 --> 00:12:22,400
.ثمّ عاد إلى موطنه بعد أن صار أقوى بكثير

132
00:12:22,400 --> 00:12:26,130
!كوزكي أودن المنيع

133
00:12:28,800 --> 00:12:33,300
.لا داعي للقلق. سينقذ أودن-ساما هذه البلاد

134
00:12:34,230 --> 00:12:35,240
!أودن-ساما

135
00:12:35,240 --> 00:12:38,050
!أودن-ساما! كنّا في انتظارك

136
00:12:38,050 --> 00:12:39,710
!أودن-ساما

137
00:12:39,900 --> 00:12:45,900
توقّعوه أن يكون منقذ النّاس
...الّذين عانوا سطوة الشّرّ

138
00:12:48,200 --> 00:12:49,590
أودن-ساما؟

139
00:12:49,910 --> 00:12:53,390
...بعد عدّة ساعات، كان كوزكي أودن

140
00:12:53,620 --> 00:12:57,390
...عاريًا أمام قلعة الشّوغن أوروتشي

141
00:13:02,920 --> 00:13:04,770
.ويتصرّف كالأبله

142
00:13:27,710 --> 00:13:31,630
!عرفت أنّك ستنجح

143
00:13:41,180 --> 00:13:43,350
!فجل، غانمو

144
00:13:45,210 --> 00:13:47,150
!تشيكوا وبيض

145
00:13:48,980 --> 00:13:53,070
!واحد، اثنان، ثلاثة، تفضّلوا بالأكل

146
00:13:53,250 --> 00:13:55,710
...ما كان الأودن ليُسمّى أودن

147
00:13:57,220 --> 00:13:59,790
!إن لم يكن يغلي

148
00:14:03,870 --> 00:14:06,750
.ضحك أتباع أوروتشي وكايدو عليه

149
00:14:12,280 --> 00:14:15,050
...واحد، اثنان، ثلاثة

150
00:14:15,370 --> 00:14:21,620
بعد أن عفّر وجهه بالتّراب وجنى بعض
.المال، عاد الرّجل الضّخم لمنزله

151
00:14:25,840 --> 00:14:33,650
،عودة كوزكي أودن، وريث بلاد وانو الشّرعيّ
.كانت آخر أمل للبلاد، إن جاز التّعبير

152
00:14:34,050 --> 00:14:38,490
.لكنّ النّاس خُذلوا بالكامل وخاب أملهم كثيرًا

153
00:14:39,770 --> 00:14:44,370
.حتّى أنّهم أمسوا غاضبين في النّهاية

154
00:14:47,750 --> 00:14:51,460
!سيّد كوري السّخيف، كوزكي أودن

155
00:14:51,460 --> 00:14:55,340
!سمّرته نظرة الثّعبان في مكانه من الخوف

156
00:14:55,340 --> 00:14:59,260
!إن ضحكتم، ستخسرون! هيّا بنا

157
00:15:03,040 --> 00:15:04,810
!كونبو، مهمّ

158
00:15:06,790 --> 00:15:08,690
!الكونبو مهمّ

159
00:15:10,770 --> 00:15:14,740
!العنصر الضّروريّ للمذاق هو المرق

160
00:15:14,740 --> 00:15:17,250
...ما كان الأودن ليُسمّى أودن

161
00:15:18,760 --> 00:15:22,080
!إن لم يكن يغلي

162
00:15:22,310 --> 00:15:25,660
،ظهر أودن في العاصمة مرّة كلّ أسبوع

163
00:15:25,660 --> 00:15:29,380
وتصرّف بهرج أمام القلعة
.لجني مقدار صغير من المال

164
00:15:30,570 --> 00:15:32,100
.حتّى في الأيّام الماطرة

165
00:15:33,200 --> 00:15:34,590
.أو الأيّام العاصفة

166
00:15:35,740 --> 00:15:37,300
.أو الأيّام المثلِجة

167
00:15:43,160 --> 00:15:45,220
!إنّنا نتوسّلك يا أودن-ساما

168
00:15:45,500 --> 00:15:47,980
!أخبرنا بالحقيقة رجاءً

169
00:15:50,420 --> 00:15:54,270
!ما الّذي تحدّثتما عنه أنت وأوروتشي؟
!لماذا تفعل هذا؟

170
00:15:54,780 --> 00:16:00,030
حتّى سكّان كوري الّذين آمنوا بك
.كلّ هذا الوقت تخلّوا عنك أخيرًا

171
00:16:03,680 --> 00:16:06,080
ما الّذي تعنيه بلماذا؟

172
00:16:06,080 --> 00:16:09,080
.أرقص عاريًا وأجني المال كلّ أسبوع

173
00:16:09,080 --> 00:16:12,000
!ذلك هو عملي

174
00:16:12,780 --> 00:16:15,960
وصلت أخبار تصرّفه الغريب
.في العاصمة إلى كوري أيضًا

175
00:16:17,410 --> 00:16:21,800
!دايكون وغانمو وتشيكاوا وبيض

176
00:16:21,800 --> 00:16:26,060
!كونياكو وتشيكاوابو وهانبن وبطاطس

177
00:16:26,060 --> 00:16:31,100
!ولا تنسوا معكرونة الشيراتاكي أيضًا

178
00:16:32,420 --> 00:16:35,730
!لا تصر رجلاً مثله! هذا مثير للشّفقة

179
00:16:35,730 --> 00:16:40,740
،إن صرت كلب أوروتشي
!شقّ بطنك كساموراي

180
00:16:41,010 --> 00:16:45,160
!كونبو، مهمّ! الحياة، مهمّة

181
00:16:45,160 --> 00:16:49,300
!العنصر الضّروريّ للمذاق هو المرق

182
00:16:56,860 --> 00:16:59,400
...بعد سنة

183
00:17:03,300 --> 00:17:04,430
!والدي

184
00:17:05,200 --> 00:17:08,080
.أحضر لك مبعوث الشّوغن هذا

185
00:17:08,080 --> 00:17:10,230
.حسنًا

186
00:17:11,380 --> 00:17:12,730
.شكرًا لك

187
00:17:27,060 --> 00:17:29,180
...روجر

188
00:17:30,400 --> 00:17:32,500
...إرادة موروثة

189
00:17:32,870 --> 00:17:36,340
...تعاقب الأزمنة... أحلام النّاس

190
00:17:41,490 --> 00:17:44,930
.لا رادع لهذه الأشياء

191
00:17:44,930 --> 00:17:48,660
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

192
00:17:54,210 --> 00:17:58,040
هل قلت أنّك ستموت قريبًا يا روجر؟

193
00:17:58,520 --> 00:18:02,240
.نعم، إنّها مسألة وقت فحسب

194
00:18:06,810 --> 00:18:11,950
هل تعرف ما الّذي تدعوني به
حكومة العالم هذه الأيّام؟

195
00:18:13,650 --> 00:18:15,540
".غولد روجر"

196
00:18:16,480 --> 00:18:20,570
ماذا؟ أهذا اسمك الحقيقيّ؟

197
00:18:20,570 --> 00:18:22,340
!لا، لا

198
00:18:23,120 --> 00:18:26,760
.اسمي هو غول د. روجر

199
00:18:26,940 --> 00:18:31,370
.أقابل أشخاصًا يحملون "د" في أسمائهم أحيانًا

200
00:18:35,630 --> 00:18:38,690
.لديّ عضو في طاقمي يحمله أيضًا
.اسمه تيتش

201
00:18:39,840 --> 00:18:42,480
ما الّذي يرمز له حرف "د"؟

202
00:18:44,890 --> 00:18:47,240
أتريد معرفة ذلك؟

203
00:18:51,100 --> 00:18:54,010
.حسنًا، سأخبرك

204
00:18:54,190 --> 00:18:57,430
...إنّها قصّة قديمة

205
00:18:59,860 --> 00:19:04,420
بعد تلقّي أودن لصحيفة أجنبيّة
...من الشّوغن أوروتشي

206
00:19:33,890 --> 00:19:38,370
...ركض بمحاذاة السّاحل وبكى بحرقة ثمّ ضحك

207
00:19:38,370 --> 00:19:40,960
...ثمّ بكى ثانية

208
00:19:47,660 --> 00:19:49,680
!روجر

209
00:20:46,550 --> 00:20:49,900
.حسنًا، لننهِ هذا الأمر بسرعة

210
00:21:05,860 --> 00:21:08,270
!يا ملك القراصنة

211
00:21:08,270 --> 00:21:11,300
!أين أخفيت كلّ الكنوز الّتي وجدتها؟

212
00:21:11,300 --> 00:21:15,470
!حصلت عليه، صحيح؟! ذلك الكنز الأسطوريّ

213
00:21:16,040 --> 00:21:19,640
!ذلك الكنز الأسطوريّ

214
00:21:19,960 --> 00:21:23,330
!الوان بيس

215
00:21:30,470 --> 00:21:35,240
!كنزي؟ سأعطيكم إيّاه إن أردتموه

216
00:21:35,420 --> 00:21:37,080
!جدوه

217
00:21:41,230 --> 00:21:44,960
تركت كلّ ما هو موجود
!في هذا العالم فيه

218
00:21:56,410 --> 00:21:59,100
،قبل 24 سنة من اليوم الحاليّ

219
00:21:59,100 --> 00:22:03,810
جنّ جنون العالم حيال إعدام
،ملك القراصنة غولد روجر

220
00:22:04,630 --> 00:22:10,690
وبهدف الحصول على الثّروة الهائلة وكنز
،وان بيس العظيم الّذي تركه خلفه

221
00:22:10,690 --> 00:22:15,410
.خاض النّاس من شتّى الأنواع غمار البحر

222
00:22:16,680 --> 00:22:20,970
.وكانت تلك بداية عصر القراصنة العظيم

223
00:22:35,780 --> 00:22:37,720
!روجر

224
00:22:40,710 --> 00:22:44,330
!أنت مذهل

225
00:22:48,050 --> 00:22:51,150
!عشت حياة لا مثيل لها

226
00:23:04,350 --> 00:23:11,460
كُشفت خطّة أوروتشي الشّائنة! إنّه يستعمل
!أيّ وسيلة ممكنة لشروره وانفجر غضب أودن أخيرًا

227
00:23:11,460 --> 00:23:17,180
،ولإنقاذ البلاد، يواجه أودن والأكازايا كايدو
.عدوّهم المتآمر للهيمنة على البلاد

228
00:23:17,180 --> 00:23:22,240
توشك الغارة الأسطوريّة الّتي ستتغنّى بها
!الأجيال القادمة أن تبدأ

229
00:23:22,410 --> 00:23:27,140
:في الحلقة القادمة من وان بيس
"!غارة! أودن والأكازايا التّسعة"

230
00:23:27,140 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا