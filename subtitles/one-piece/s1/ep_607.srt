00:13:30,840 --> 00:13:32,370
...أ-أنت

195
00:13:34,730 --> 00:13:36,810
!ترافالغار لو

196
00:13:37,930 --> 00:13:39,240
!ما الّذي يحدث؟

197
00:13:39,240 --> 00:13:41,310
!لماذا هو هنا؟

198
00:13:46,750 --> 00:13:48,480
!ومن يهتمّ لذلك

199
00:13:48,480 --> 00:13:50,410
!إنّه خائن في كلّ الأحوال

200
00:13:51,530 --> 00:13:52,600
.غرفة

201
00:13:54,530 --> 00:13:54,950
!ماذا؟

202
00:13:57,730 --> 00:14:00,150
!ما هذا؟! ما الّذي حدث؟

203
00:14:00,150 --> 00:14:02,330
!ماذا يجري؟! ما الّذي فعلته؟

204
00:14:34,460 --> 00:14:36,910
!لا يمكنك الهرب يا قبّعة القشّ

205
00:14:40,970 --> 00:14:42,330
!لا يمكنني التّنفّس

206
00:14:42,330 --> 00:14:44,590
!يا لمثابرته

207
00:14:49,570 --> 00:14:50,850
!أستطيع التّنفّس الآن

208
00:14:55,770 --> 00:14:58,260
!سأسلبك أنفاسك

209
00:15:01,810 --> 00:15:03,330
!لا يمكنك التّنفّس، صحيح؟

210
00:15:03,330 --> 00:15:06,140
!صرت أبطأ يا قبّعة القشّ

211
00:15:06,140 --> 00:15:09,900
!خذ! خذ! خذ! خذ! خذ

212
00:15:15,710 --> 00:15:18,450
!خذ! خذ! خذ! خذ! خذ

213
00:15:21,240 --> 00:15:22,490
!خذ! خذ

214
00:15:22,910 --> 00:15:25,660
!مت وأرحنا يا قبّعة القشّ

215
00:15:26,410 --> 00:15:28,000
!تمهّل

216
00:15:28,920 --> 00:15:31,290
!ابق بعيدًا عنّي

217
00:15:41,960 --> 00:15:43,600
!كم هذا مزعج

218
00:15:43,600 --> 00:15:45,540
!يمكنك استعمال الهاكي

219
00:15:56,000 --> 00:15:58,700
.عليّ القبض عليه بسرعة

220
00:16:00,430 --> 00:16:02,200
!قبل أن أختنق حتّى الموت

221
00:16:04,030 --> 00:16:05,680
.صحيح يا قبّعة القشّ

222
00:16:05,680 --> 00:16:07,540
تريد الإمساك بي، صحيح؟

223
00:16:07,710 --> 00:16:08,860
!أخشى أنّ ذلك مستحيل

224
00:16:08,860 --> 00:16:12,180
،لا يهمّ كم تبلغ قوّتك

225
00:16:12,180 --> 00:16:13,960
،بمجرّد أن أزيل الأوكسجين

226
00:16:13,960 --> 00:16:17,550
!فلن تتمكّن من التّنفّس وستموت بسرعة

227
00:16:20,380 --> 00:16:23,470
!لذلك أمسكني إن استطعت

228
00:16:33,690 --> 00:16:38,620
يقاتل السّاق السّوداء من طاقم قبّعة
!القشّ ضدّ منتحل شخصيّة فيرغو

229
00:16:38,620 --> 00:16:39,860
!علينا مساعدته

230
00:16:40,210 --> 00:16:41,610
!ما الّذي تفعلونه؟

231
00:16:41,610 --> 00:16:42,490
!من الأفضل أن تهربوا

232
00:16:43,130 --> 00:16:46,230
إنّهم يحاولون عرقلة تقدّمكم
!والسّماح للغاز بالدّخول ثانية

233
00:16:46,230 --> 00:16:47,130
!ماذا؟

234
00:16:51,370 --> 00:16:52,640
!ألم أقل لكم؟

235
00:16:55,510 --> 00:16:57,800
!الغاز السّامّ يتدفّق ثانية

236
00:16:57,800 --> 00:16:58,770
!اهربوا

237
00:17:04,400 --> 00:17:06,020
...فهمت

238
00:17:06,830 --> 00:17:11,050
.إنّه مصنوع من الحديد أو ما شابه

239
00:17:12,360 --> 00:17:14,060
.لا تتدخّل

240
00:17:15,650 --> 00:17:17,320
.هذه مشكلتنا

241
00:17:17,740 --> 00:17:21,610
.أنت من الأشخاص الّذين يكرههم قبطاننا بشدّة

242
00:17:29,820 --> 00:17:31,040
...إنّه

243
00:17:37,670 --> 00:17:39,050
!قويّ للغاية

244
00:17:40,710 --> 00:17:43,300
!أيّها السّاق السّوداء

245
00:17:43,630 --> 00:17:45,210
!ستُغلق البوّابة

246
00:17:45,210 --> 00:17:46,350
!تعال إلى هنا بسرعة

247
00:17:47,070 --> 00:17:50,210
!الغاز السّام خلفك مباشرة

248
00:17:50,210 --> 00:17:51,350
!بسرعة

249
00:18:07,960 --> 00:18:10,830
!لماذا لا تستسلم فحسب يا قبّعة القشّ؟

250
00:18:12,270 --> 00:18:15,130
.أمامك خياران لا ثالث لهما

251
00:18:15,620 --> 00:18:18,920
إمّا أن تغادر هذه الغرفة وأنت
...تجرّ أذيال الهزيمة

252
00:18:19,100 --> 00:18:21,100
.أو تصير ضحيّة

253
00:18:24,510 --> 00:18:30,870
!أريد أن أري قوّة شينوكوني للسّماسرة في هذه التّجربة

254
00:18:33,210 --> 00:18:38,980
!إنّ قتلك حرقًا ليس ما أسعى إليه

255
00:18:40,210 --> 00:18:41,740
!كاراكوني

256
00:18:45,230 --> 00:18:47,200
!لا أستطيع التّنفّس ثانية

257
00:18:48,520 --> 00:18:51,050
!يا قبّعة القشّ، سأدعك تذهب هذه المرّة

258
00:18:51,050 --> 00:18:52,370
...لذلك

259
00:18:57,650 --> 00:19:00,510
!سأمسك بك

260
00:19:01,170 --> 00:19:03,120
تريد الموت، صحيح؟

261
00:19:03,850 --> 00:19:05,940
،إن كنت أعجز عن التّنفّس

262
00:19:07,560 --> 00:19:10,390
!فسأوسعك ضربًا بنفس واحد إذًا

263
00:19:10,390 --> 00:19:11,610
ماذا؟

264
00:19:11,610 --> 00:19:13,100
عمّ تتحدّث؟

265
00:19:13,280 --> 00:19:15,100
!لون التّسلّح، التّصليب

266
00:19:17,510 --> 00:19:18,620
!لا فائدة

267
00:19:18,620 --> 00:19:20,650
!سأمنحك الموت الّذي اخترته بنفسك

268
00:19:22,270 --> 00:19:24,190
!مت يا قبّعة القشّ

269
00:19:34,650 --> 00:19:36,080
...فاكهة المطّاط

270
00:19:36,700 --> 00:19:38,750
!المدفع الرّشّاش النّفّاث

271
00:19:43,410 --> 00:19:45,320
!ما هذا؟! جدار؟

272
00:19:45,320 --> 00:19:46,580
.كاماكورا

273
00:19:47,550 --> 00:19:48,670
.أدهشني هذا

274
00:19:48,670 --> 00:19:51,680
!وحدك من يستطيع كسر هذا الجدار

275
00:19:57,530 --> 00:19:59,270
هل أكلت فاكهة شيطان؟

276
00:20:01,120 --> 00:20:03,190
!سُحقًا أيّها الوغد المطّاطيّ

277
00:20:05,740 --> 00:20:07,510
.عليك الذّهاب أيّها السّيّد

278
00:20:07,510 --> 00:20:09,260
.لا فائدة من هذا القتال

279
00:20:09,860 --> 00:20:11,230
.معك حقّ

280
00:20:12,150 --> 00:20:15,750
!نحن وسط عرض توضيحيّ مهمّ الآن

281
00:20:15,750 --> 00:20:17,660
!ما الّذي تفعله؟! هل ستهرب؟

282
00:20:17,660 --> 00:20:19,390
!وداعًا يا قبّعة القشّ

283
00:20:19,390 --> 00:20:21,070
!أطلق العنان لنفسك كما تشاء

284
00:20:21,070 --> 00:20:26,130
!لديّ سلفًا فكرة عن كيفية جعلكم فئران تجارب حتمًا

285
00:20:26,130 --> 00:20:28,020
!تطلّع لذلك

286
00:20:30,260 --> 00:20:30,840
!انتظر

287
00:20:31,920 --> 00:20:33,830
.لن أدعك تذهب خلفه

288
00:20:34,430 --> 00:20:37,470
،فإن حدث مكروه ما للسّيّد

289
00:20:38,810 --> 00:20:40,920
.فسيقتلني جوكر

290
00:20:42,500 --> 00:20:44,690
!إنّه الرّجل الطّائر الّذي رأيته في الحرب، صحيح؟

291
00:20:44,690 --> 00:20:46,610
!ما قصّة ذلك الرّجل؟

292
00:21:05,790 --> 00:21:07,910
!مهلاً، ما الّذي يحدث؟

293
00:21:07,910 --> 00:21:09,210
!ترافالغار؟

294
00:21:09,860 --> 00:21:11,390
!هذا سيّئ

295
00:21:11,390 --> 00:21:13,170
!ابعثا رسالة طوارئ لكلّ المباني

296
00:21:13,170 --> 00:21:13,890
!بسرعة

297
00:21:13,890 --> 00:21:14,850
!حالاً

298
00:21:18,010 --> 00:21:20,390
!"هذا المبنى "د"! هذا المبنى "د

299
00:21:20,390 --> 00:21:23,230
!هذه رسالة طوارئ لكلّ مباني المختبر الثّالث

300
00:21:23,230 --> 00:21:24,840
!ما هذا؟

301
00:21:24,840 --> 00:21:26,320
!"هذا المبنى "د

302
00:21:26,320 --> 00:21:29,670
!هذه رسالة طوارئ لكلّ مباني المختبر الثّالث

303
00:21:29,670 --> 00:21:33,320
الشّيتشيبوكاي الملكيّ ترافالغار لو

304
00:21:33,860 --> 00:21:39,140
!دخل للتّوّ إلى غرفة تصنيع إس إيْ دي

305
00:21:42,310 --> 00:21:43,690
!ماذا؟

306
00:21:43,690 --> 00:21:45,750
!هل فقد ذلك الوغد صوابه؟

307
00:21:46,370 --> 00:21:48,090
،إذا ما فتح ذلك الصّندوق

308
00:21:49,340 --> 00:21:52,210
!فستكون العواقب وخيمة حتّى هو لا يمكنه تفاديها

309
00:21:56,580 --> 00:21:57,300
...هل

310
00:21:57,590 --> 00:21:59,180
.أصبح كلّ شيء واضحًا الآن

311
00:22:02,390 --> 00:22:03,500
...ما-ما الّذي

312
00:22:05,810 --> 00:22:07,230
!ثمّة مشكلة أخرى

313
00:22:10,730 --> 00:22:13,870
...يريد اختطاف السّيّد وإس إيْ دي

314
00:22:14,300 --> 00:22:16,990
.صرت الآن أدري ما هو مرادكم

315
00:22:22,850 --> 00:22:24,100
!فيرغو

316
00:22:29,340 --> 00:22:30,660
...لو

317
00:22:30,660 --> 00:22:34,380
.شكّل تحالفًا مع قبّعة القشّ كإجراء دفاعيّ

318
00:22:34,380 --> 00:22:38,640
.انضمّ للشّيتشيبوكاي ليتمكّن من دخول تلك الغرفة

319
00:22:40,470 --> 00:22:42,100
!ذلك الشّقيّ

320
00:22:43,850 --> 00:22:48,250
!إنّه يفكّر في أسوأ ما قد يحدث

321
00:22:50,380 --> 00:22:52,080
...هل يحاول

322
00:22:54,070 --> 00:22:56,150
!إفساد العالم الجديد؟

323
00:23:10,850 --> 00:23:13,480
.استطاع لو دخول غرفة تصنيع إس إيْ دي

324
00:23:13,480 --> 00:23:17,270
.بدأ أخيرًا خطّته الّتي ستهزّ العالم الجديد بكامله

325
00:23:17,760 --> 00:23:21,460
....ولكن بعدها، عضو الشّيتشيبوكاي الخسيس

326
00:23:21,460 --> 00:23:25,950
الّذي كان يتلاعب ببانك هازارد من
!خلف الكواليس يخرج عن صمته أخيرًا

327
00:23:26,180 --> 00:23:27,810
:في الحلقة القادمة من وان بيس

328
00:23:27,810 --> 00:23:30,400
"!عقل السّوق السّوداء المدبّر! يبدأ دوفلامينغو تحرّكاته"

329
00:23:30,400 --> 00:23:32,020
!ملك القراصنة، لن يكون إلاّ أنا

330
00:23:36,030 --> 00:23:41,030
!!نراكم في الحلقة القادمة