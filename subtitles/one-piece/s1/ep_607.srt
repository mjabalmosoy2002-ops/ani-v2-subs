00:13:44,840 --> 00:13:46,370
...أ-أنت

195
00:13:48,730 --> 00:13:50,810
!ترافالغار لو

196
00:13:51,930 --> 00:13:53,240
!ما الّذي يحدث؟

197
00:13:53,240 --> 00:13:55,310
!لماذا هو هنا؟

198
00:14:00,750 --> 00:14:02,480
!ومن يهتمّ لذلك

199
00:14:02,480 --> 00:14:04,410
!إنّه خائن في كلّ الأحوال

200
00:14:05,530 --> 00:14:06,600
.غرفة

201
00:14:08,530 --> 00:14:08,950
!ماذا؟

202
00:14:11,730 --> 00:14:14,150
!ما هذا؟! ما الّذي حدث؟

203
00:14:14,150 --> 00:14:16,330
!ماذا يجري؟! ما الّذي فعلته؟

204
00:14:48,460 --> 00:14:50,910
!لا يمكنك الهرب يا قبّعة القشّ

205
00:14:54,970 --> 00:14:56,330
!لا يمكنني التّنفّس

206
00:14:56,330 --> 00:14:58,590
!يا لمثابرته

207
00:15:03,570 --> 00:15:04,850
!أستطيع التّنفّس الآن

208
00:15:09,770 --> 00:15:12,260
!سأسلبك أنفاسك

209
00:15:15,810 --> 00:15:17,330
!لا يمكنك التّنفّس، صحيح؟

210
00:15:17,330 --> 00:15:20,140
!صرت أبطأ يا قبّعة القشّ

211
00:15:20,140 --> 00:15:23,900
!خذ! خذ! خذ! خذ! خذ

212
00:15:29,710 --> 00:15:32,450
!خذ! خذ! خذ! خذ! خذ

213
00:15:35,240 --> 00:15:36,490
!خذ! خذ

214
00:15:36,910 --> 00:15:39,660
!مت وأرحنا يا قبّعة القشّ

215
00:15:40,410 --> 00:15:42,000
!تمهّل

216
00:15:42,920 --> 00:15:45,290
!ابق بعيدًا عنّي

217
00:15:55,960 --> 00:15:57,600
!كم هذا مزعج

218
00:15:57,600 --> 00:15:59,540
!يمكنك استعمال الهاكي

219
00:16:10,000 --> 00:16:12,700
.عليّ القبض عليه بسرعة

220
00:16:14,430 --> 00:16:16,200
!قبل أن أختنق حتّى الموت

221
00:16:18,030 --> 00:16:19,680
.صحيح يا قبّعة القشّ

222
00:16:19,680 --> 00:16:21,540
تريد الإمساك بي، صحيح؟

223
00:16:21,710 --> 00:16:22,860
!أخشى أنّ ذلك مستحيل

224
00:16:22,860 --> 00:16:26,180
،لا يهمّ كم تبلغ قوّتك

225
00:16:26,180 --> 00:16:27,960
،بمجرّد أن أزيل الأوكسجين

226
00:16:27,960 --> 00:16:31,550
!فلن تتمكّن من التّنفّس وستموت بسرعة

227
00:16:34,380 --> 00:16:37,470
!لذلك أمسكني إن استطعت

228
00:16:47,690 --> 00:16:52,620
يقاتل السّاق السّوداء من طاقم قبّعة
!القشّ ضدّ منتحل شخصيّة فيرغو

229
00:16:52,620 --> 00:16:53,860
!علينا مساعدته

230
00:16:54,210 --> 00:16:55,610
!ما الّذي تفعلونه؟

231
00:16:55,610 --> 00:16:56,490
!من الأفضل أن تهربوا

232
00:16:57,130 --> 00:17:00,230
إنّهم يحاولون عرقلة تقدّمكم
!والسّماح للغاز بالدّخول ثانية

233
00:17:00,230 --> 00:17:01,130
!ماذا؟

234
00:17:05,370 --> 00:17:06,640
!ألم أقل لكم؟

235
00:17:09,510 --> 00:17:11,800
!الغاز السّامّ يتدفّق ثانية

236
00:17:11,800 --> 00:17:12,770
!اهربوا

237
00:17:18,400 --> 00:17:20,020
...فهمت

238
00:17:20,830 --> 00:17:25,050
.إنّه مصنوع من الحديد أو ما شابه

239
00:17:26,360 --> 00:17:28,060
.لا تتدخّل

240
00:17:29,650 --> 00:17:31,320
.هذه مشكلتنا

241
00:17:31,740 --> 00:17:35,610
.أنت من الأشخاص الّذين يكرههم قبطاننا بشدّة

242
00:17:43,820 --> 00:17:45,040
...إنّه

243
00:17:51,670 --> 00:17:53,050
!قويّ للغاية

244
00:17:54,710 --> 00:17:57,300
!أيّها السّاق السّوداء

245
00:17:57,630 --> 00:17:59,210
!ستُغلق البوّابة

246
00:17:59,210 --> 00:18:00,350
!تعال إلى هنا بسرعة

247
00:18:01,070 --> 00:18:04,210
!الغاز السّام خلفك مباشرة

248
00:18:04,210 --> 00:18:05,350
!بسرعة

249
00:18:21,960 --> 00:18:24,830
!لماذا لا تستسلم فحسب يا قبّعة القشّ؟

250
00:18:26,270 --> 00:18:29,130
.أمامك خياران لا ثالث لهما

251
00:18:29,620 --> 00:18:32,920
إمّا أن تغادر هذه الغرفة وأنت
...تجرّ أذيال الهزيمة

252
00:18:33,100 --> 00:18:35,100
.أو تصير ضحيّة

253
00:18:38,510 --> 00:18:44,870
!أريد أن أري قوّة شينوكوني للسّماسرة في هذه التّجربة

254
00:18:47,210 --> 00:18:52,980
!إنّ قتلك حرقًا ليس ما أسعى إليه

255
00:18:54,210 --> 00:18:55,740
!كاراكوني

256
00:18:59,230 --> 00:19:01,200
!لا أستطيع التّنفّس ثانية

257
00:19:02,520 --> 00:19:05,050
!يا قبّعة القشّ، سأدعك تذهب هذه المرّة

258
00:19:05,050 --> 00:19:06,370
...لذلك

259
00:19:11,650 --> 00:19:14,510
!سأمسك بك

260
00:19:15,170 --> 00:19:17,120
تريد الموت، صحيح؟

261
00:19:17,850 --> 00:19:19,940
،إن كنت أعجز عن التّنفّس

262
00:19:21,560 --> 00:19:24,390
!فسأوسعك ضربًا بنفس واحد إذًا

263
00:19:24,390 --> 00:19:25,610
ماذا؟

264
00:19:25,610 --> 00:19:27,100
عمّ تتحدّث؟

265
00:19:27,280 --> 00:19:29,100
!لون التّسلّح، التّصليب

266
00:19:31,510 --> 00:19:32,620
!لا فائدة

267
00:19:32,620 --> 00:19:34,650
!سأمنحك الموت الّذي اخترته بنفسك

268
00:19:36,270 --> 00:19:38,190
!مت يا قبّعة القشّ

269
00:19:48,650 --> 00:19:50,080
...فاكهة المطّاط

270
00:19:50,700 --> 00:19:52,750
!المدفع الرّشّاش النّفّاث

271
00:19:57,410 --> 00:19:59,320
!ما هذا؟! جدار؟

272
00:19:59,320 --> 00:20:00,580
.كاماكورا

273
00:20:01,550 --> 00:20:02,670
.أدهشني هذا

274
00:20:02,670 --> 00:20:05,680
!وحدك من يستطيع كسر هذا الجدار

275
00:20:11,530 --> 00:20:13,270
هل أكلت فاكهة شيطان؟

276
00:20:15,120 --> 00:20:17,190
!سُحقًا أيّها الوغد المطّاطيّ

277
00:20:19,740 --> 00:20:21,510
.عليك الذّهاب أيّها السّيّد

278
00:20:21,510 --> 00:20:23,260
.لا فائدة من هذا القتال

279
00:20:23,860 --> 00:20:25,230
.معك حقّ

280
00:20:26,150 --> 00:20:29,750
!نحن وسط عرض توضيحيّ مهمّ الآن

281
00:20:29,750 --> 00:20:31,660
!ما الّذي تفعله؟! هل ستهرب؟

282
00:20:31,660 --> 00:20:33,390
!وداعًا يا قبّعة القشّ

283
00:20:33,390 --> 00:20:35,070
!أطلق العنان لنفسك كما تشاء

284
00:20:35,070 --> 00:20:40,130
!لديّ سلفًا فكرة عن كيفية جعلكم فئران تجارب حتمًا

285
00:20:40,130 --> 00:20:42,020
!تطلّع لذلك

286
00:20:44,260 --> 00:20:44,840
!انتظر

287
00:20:45,920 --> 00:20:47,830
.لن أدعك تذهب خلفه

288
00:20:48,430 --> 00:20:51,470
،فإن حدث مكروه ما للسّيّد

289
00:20:52,810 --> 00:20:54,920
.فسيقتلني جوكر

290
00:20:56,500 --> 00:20:58,690
!إنّه الرّجل الطّائر الّذي رأيته في الحرب، صحيح؟

291
00:20:58,690 --> 00:21:00,610
!ما قصّة ذلك الرّجل؟

292
00:21:19,790 --> 00:21:21,910
!مهلاً، ما الّذي يحدث؟

293
00:21:21,910 --> 00:21:23,210
!ترافالغار؟

294
00:21:23,860 --> 00:21:25,390
!هذا سيّئ

295
00:21:25,390 --> 00:21:27,170
!ابعثا رسالة طوارئ لكلّ المباني

296
00:21:27,170 --> 00:21:27,890
!بسرعة

297
00:21:27,890 --> 00:21:28,850
!حالاً

298
00:21:32,010 --> 00:21:34,390
!"هذا المبنى "د"! هذا المبنى "د

299
00:21:34,390 --> 00:21:37,230
!هذه رسالة طوارئ لكلّ مباني المختبر الثّالث

300
00:21:37,230 --> 00:21:38,840
!ما هذا؟

301
00:21:38,840 --> 00:21:40,320
!"هذا المبنى "د

302
00:21:40,320 --> 00:21:43,670
!هذه رسالة طوارئ لكلّ مباني المختبر الثّالث

303
00:21:43,670 --> 00:21:47,320
الشّيتشيبوكاي الملكيّ ترافالغار لو

304
00:21:47,860 --> 00:21:53,140
!دخل للتّوّ إلى غرفة تصنيع إس إيْ دي

305
00:21:56,310 --> 00:21:57,690
!ماذا؟

306
00:21:57,690 --> 00:21:59,750
!هل فقد ذلك الوغد صوابه؟

307
00:22:00,370 --> 00:22:02,090
،إذا ما فتح ذلك الصّندوق

308
00:22:03,340 --> 00:22:06,210
!فستكون العواقب وخيمة حتّى هو لا يمكنه تفاديها

309
00:22:10,580 --> 00:22:11,300
...هل

310
00:22:11,590 --> 00:22:13,180
.أصبح كلّ شيء واضحًا الآن

311
00:22:16,390 --> 00:22:17,500
...ما-ما الّذي

312
00:22:19,810 --> 00:22:21,230
!ثمّة مشكلة أخرى

313
00:22:24,730 --> 00:22:27,870
...يريد اختطاف السّيّد وإس إيْ دي

314
00:22:28,300 --> 00:22:30,990
.صرت الآن أدري ما هو مرادكم

315
00:22:36,850 --> 00:22:38,100
!فيرغو

316
00:22:43,340 --> 00:22:44,660
...لو

317
00:22:44,660 --> 00:22:48,380
.شكّل تحالفًا مع قبّعة القشّ كإجراء دفاعيّ

318
00:22:48,380 --> 00:22:52,640
.انضمّ للشّيتشيبوكاي ليتمكّن من دخول تلك الغرفة

319
00:22:54,470 --> 00:22:56,100
!ذلك الشّقيّ

320
00:22:57,850 --> 00:23:02,250
!إنّه يفكّر في أسوأ ما قد يحدث

321
00:23:04,380 --> 00:23:06,080
...هل يحاول

322
00:23:08,070 --> 00:23:10,150
!إفساد العالم الجديد؟

323
00:23:24,850 --> 00:23:27,480
.استطاع لو دخول غرفة تصنيع إس إيْ دي

324
00:23:27,480 --> 00:23:31,270
.بدأ أخيرًا خطّته الّتي ستهزّ العالم الجديد بكامله

325
00:23:31,760 --> 00:23:35,460
....ولكن بعدها، عضو الشّيتشيبوكاي الخسيس

326
00:23:35,460 --> 00:23:39,950
الّذي كان يتلاعب ببانك هازارد من
!خلف الكواليس يخرج عن صمته أخيرًا

327
00:23:40,180 --> 00:23:41,810
:في الحلقة القادمة من وان بيس

328
00:23:41,810 --> 00:23:44,400
"!عقل السّوق السّوداء المدبّر! يبدأ دوفلامينغو تحرّكاته"

329
00:23:44,400 --> 00:23:46,020
!ملك القراصنة، لن يكون إلاّ أنا

330
00:23:50,030 --> 00:23:55,030
!!نراكم في الحلقة القادمة