1
00:00:10,480 --> 00:00:25,040
يوجد قوس قزح وراء الأمطار الغزيرة

2
00:00:33,170 --> 00:00:36,680
سأعرف أنّ الجواب السّهل كذبة

3
00:00:37,930 --> 00:00:42,290
أعد ألاّ أتراجع أمام الصّراخ

4
00:00:42,290 --> 00:00:46,830
أحتاجك وحدك لتفهم الغد

5
00:00:46,930 --> 00:00:51,620
أعطيتني أفضل لحظات حياتي

6
00:00:53,190 --> 00:01:01,790
...ماذا أبدو؟ ملَكًا أم شيطانًا

7
00:01:01,790 --> 00:01:06,710
ما وراء الفجر، ما وراء الفجر

8
00:01:06,710 --> 00:01:12,230
ثمّة الكثير ممّا أريد أن أخبرك به

9
00:01:12,230 --> 00:01:17,050
مليء بالحبّ، بالحبّ

10
00:01:17,050 --> 00:01:22,870
الّذي لا يمكن كتابته في رسالة

11
00:01:19,100 --> 00:01:21,180
عزيزتي بوني

12
00:01:22,870 --> 00:01:31,400
يد صغيرة تبحث عن الأبديّة

13
00:01:42,570 --> 00:01:43,920
!مهلاً

14
00:01:47,080 --> 00:01:49,380
أأنت بخير يا كوما؟

15
00:01:49,380 --> 00:01:50,340
!كوما

16
00:01:51,000 --> 00:01:52,150
.أنا بخير

17
00:01:52,370 --> 00:01:54,470
!هذا لا شيء

18
00:01:54,870 --> 00:01:56,310
.يا لشجاعتك يا كوما

19
00:01:58,920 --> 00:02:01,700
!أنا من تسري في عروقه دماء الباكانير

20
00:02:01,700 --> 00:02:03,160
!أمّا زوجتي فلا

21
00:02:03,160 --> 00:02:05,190
!دعوها وطفلنا وشأنهما

22
00:02:07,590 --> 00:02:09,290
.أمّك ماتت

23
00:02:09,510 --> 00:02:11,410
.إنّها في السّماء الآن

24
00:02:11,720 --> 00:02:13,610
...أعتقد أنّها

25
00:02:14,240 --> 00:02:15,870
.في مكان أفضل الآن

26
00:02:16,680 --> 00:02:19,410
.أنت قويّ يا كوما

27
00:02:20,030 --> 00:02:22,810
.عليك تحمّل كلّ شيء وتنجو

28
00:02:24,170 --> 00:02:26,000
!إله الشّمس نيكا

29
00:02:26,280 --> 00:02:29,130
...سيأتي من أجلك وسيأخذك بعيدًا معه

30
00:02:29,130 --> 00:02:32,090
.بينما ستداعب الشّمس والبحر وجهك

31
00:02:33,880 --> 00:02:35,130
!اخرسوا-إي

32
00:02:39,140 --> 00:02:41,010
!أعلم أنّكم كنتم تنتظرون هذا

33
00:02:41,010 --> 00:02:45,450
الحدث الّذي يقام كلّ ثلاث
!سنوات لاختبار مهاراتكم

34
00:02:45,450 --> 00:02:47,420
...حلبة مسابقة هذه السّنة

35
00:02:47,420 --> 00:02:50,220
.هي جزيرة لا تنتمي لتحالف حكومة العالم

36
00:02:50,220 --> 00:02:51,840
!غود فالي

37
00:02:52,140 --> 00:02:53,770
!وجدناه

38
00:02:53,770 --> 00:02:55,660
!لا يمكنك الهرب

39
00:02:56,730 --> 00:02:58,530
!مهلاً لحظة

40
00:03:01,110 --> 00:03:02,850
!أنا أختار الحياة

41
00:03:02,850 --> 00:03:04,880
!فماذا عنكم أنتم؟

42
00:03:10,310 --> 00:03:14,790
!فصل محذوف من التّاريخ"
"!يأس غود فالي

43
00:03:18,300 --> 00:03:20,260
الأزرق الغربيّ - غود فالي

44
00:03:23,970 --> 00:03:27,850
!تمّ تحرير فرائس اليوم في البرّيّة

45
00:03:27,850 --> 00:03:32,840
الأرانب الثّلاثة عشر فائقة النُّدرة الّتي سلف
!وقدّمناها تعادل 10 آلاف نقطة لكلّ واحد

46
00:03:32,840 --> 00:03:36,020
كما أنّ هنالك 150 من الأرانب
!متوسّطة النُّدرة

47
00:03:36,360 --> 00:03:39,290
!سيتمّ تقديم نقاط إضافيّة على القتل الفوريّ

48
00:03:39,290 --> 00:03:44,110
وجهّزنا مكافآت من العيار الثّقيل
!في انتظار الفائز الأوّل

49
00:03:45,120 --> 00:03:46,990
.شاهدوا أيّها الأطفال

50
00:03:47,190 --> 00:03:49,080
.لا تتوقّع الفوز يا غارلينغ

51
00:03:49,350 --> 00:03:51,410
!ستحظى عائلة مانماير بهذه الجائزة

52
00:03:55,630 --> 00:03:58,710
!لا داعي للعجلة! احترموا القواعد

53
00:04:01,670 --> 00:04:04,450
!كيف يُسمح بشيء فظيع مثل هذا؟

54
00:04:04,450 --> 00:04:06,370
!ليوقظني أحد ما من هذا الكابوس

55
00:04:06,500 --> 00:04:09,680
!لا يجدر بالبشر أن يعاملوا البشر الآخرين كألعاب

56
00:04:11,680 --> 00:04:12,890
!بنيّ

57
00:04:15,100 --> 00:04:17,820
!على خطّتنا أن تنجح بكلّ تأكيد

58
00:04:17,890 --> 00:04:19,280
!تحمّسوا

59
00:04:19,840 --> 00:04:20,730
.حاضر

60
00:04:23,650 --> 00:04:26,310
سيبدأ نبلاء العالم المائتين

61
00:04:26,310 --> 00:04:29,390
.مطارَدتهم بعد ساعة من الآن

62
00:04:29,390 --> 00:04:32,120
!اهربوا إن أردتم النّجاة

63
00:04:36,080 --> 00:04:37,920
مقرّ البحريّة الرّئيسيّ

64
00:04:37,920 --> 00:04:39,780
غود فالي؟

65
00:04:39,780 --> 00:04:42,260
لماذا عليّ الذّهاب لجزيرة معزولة كهذه؟

66
00:04:42,490 --> 00:04:44,350
...لا يمكنني إخبارك

67
00:04:44,440 --> 00:04:46,390
!أتوسّل إليك يا غارب –
.لا –

68
00:04:46,950 --> 00:04:48,730
،لا شيء أكيد بعد

69
00:04:48,920 --> 00:04:51,100
.لكنّ السّلامة أولى من النّدم

70
00:04:51,380 --> 00:04:54,060
هل تتحدّث عن رحلة التّنانين
!السّماويّين الصّغيرة؟

71
00:04:54,300 --> 00:04:58,270
لقد حذّرتكم. ما كان عليكم
.العبث مع هاتشينوسو

72
00:04:58,680 --> 00:05:01,010
.كان ذلك كنزًا من جزيرة القراصنة

73
00:05:01,010 --> 00:05:03,610
.من الطّبيعيّ أن يحاولوا استعادته

74
00:05:04,350 --> 00:05:06,860
.أتساءل كيف تسرّبت تلك المعلومات

75
00:05:07,230 --> 00:05:09,670
لم تُفرّطوا في إجراءات الأمن، أليس كذلك؟

76
00:05:09,820 --> 00:05:11,080
فلِمَ القلق إذًا؟

77
00:05:11,820 --> 00:05:13,370
...في الحقيقة

78
00:05:14,450 --> 00:05:16,620
.لم نتوقّع تدخّل روجر في الأمر

79
00:05:16,620 --> 00:05:17,790
!ابدأ بذلك في المرّة القادمة

80
00:05:18,130 --> 00:05:19,250
!أنا في طريقي

81
00:05:19,450 --> 00:05:22,130
!غادر قراصنة روكس الميناء

82
00:05:23,130 --> 00:05:24,840
جزيرة القراصنة في العالم الجديد - هاتشينوسو

83
00:05:25,120 --> 00:05:27,770
!سُحقًا! لقد سبقونا إليه

84
00:05:27,920 --> 00:05:29,800
!سنذهب أيضًا! أسرعوا

85
00:05:30,340 --> 00:05:33,360
!إنّه يوم مهمّ لعالم القراصنة

86
00:05:33,720 --> 00:05:36,940
!حسنًا! لتبدأ اللّعبة

87
00:05:48,870 --> 00:05:51,280
!انظروا للبحر

88
00:05:54,290 --> 00:05:57,830
.تحاصر البحريّة الجزيرة
.لم أرَ كلّ هذا العدد من السّفن من قبل

89
00:05:58,970 --> 00:06:02,610
،يريدون منع أيّ أحد من الهرب

90
00:06:02,810 --> 00:06:05,920
وحذف هذا الفصل القاسي بالكامل

91
00:06:05,980 --> 00:06:07,930
!من التّاريخ

92
00:06:08,680 --> 00:06:13,260
ما هذه الإبادة الجماعيّة بحق السّكّان
.الأصليّين إلاّ لعبة قذرة لاحتكار الموارد

93
00:06:14,050 --> 00:06:16,890
الأرانب المائة ألف على هذه الجزيرة

94
00:06:16,890 --> 00:06:19,420
سيُذبَحون بالكامل قبل نهاية لعبتهم

95
00:06:19,420 --> 00:06:21,360
!خلال ثلاثة أسابيع

96
00:06:22,910 --> 00:06:24,270
هل تصدّقون هذا؟

97
00:06:25,190 --> 00:06:28,320
هل هذه هي الحياة الحقيقيّة
!بالفعل أم أنّها جحيم؟

98
00:06:32,500 --> 00:06:33,450
...لكن

99
00:06:33,630 --> 00:06:35,770
،إن نجونا في هذه الأسابيع الثّلاثة

100
00:06:35,830 --> 00:06:38,020
!فسيقومون بتحريرنا

101
00:06:38,960 --> 00:06:40,980
!ستقودك سذاجتك إلى الهلاك

102
00:06:40,980 --> 00:06:44,720
!لم ينجُ أيّ أحد من هذه اللّعبة من قبل
!لا أحد على الإطلاق

103
00:06:45,380 --> 00:06:48,510
!لماذا يمنحوننا الأمل إن كان مجرّد كذبة؟

104
00:06:48,510 --> 00:06:51,760
!لأنّ الأمل هو ما يجعلكم تعانون وتهربون

105
00:06:51,980 --> 00:06:54,510
ما كان إعدام شخص سبق واستسلم

106
00:06:54,810 --> 00:06:56,220
!ليكون ممتعًا لهم

107
00:06:57,410 --> 00:07:01,750
!النّجاة من هذه اللّعبة ما هو إلاّ حلم أجوف

108
00:07:01,750 --> 00:07:04,820
!علينا الخروج من اللّعبة بحدّ ذاتها

109
00:07:05,180 --> 00:07:07,150
...كلاّ، مستحيل

110
00:07:15,570 --> 00:07:19,130
حصل القدّيس غارلينغ على مائة
!ألف نقطة سلفًا

111
00:07:19,130 --> 00:07:21,540
!هل يسعى خلف الأرانب الأكثر قيمة فقط؟

112
00:07:27,080 --> 00:07:28,630
!أنا حرّ أخيرًا

113
00:07:29,420 --> 00:07:30,510
!يا فكّك القويّ

114
00:07:30,670 --> 00:07:32,540
!من الجيّد تواجدك معنا أيّها البرمائيّ القرش

115
00:07:32,960 --> 00:07:36,470
.شكرًا لك. هذه أوّل مرّة يُثني فيها عليّ أحد ما

116
00:07:36,470 --> 00:07:39,370
ما الوضع يا جيني؟

117
00:07:40,560 --> 00:07:42,640
.ثمّة شيء ما ليس في محلّه

118
00:07:42,920 --> 00:07:45,410
.واثقة أنّهم حصلوا على المعلومة

119
00:07:45,510 --> 00:07:48,510
لكن لا توجد أيّ إشارات سواء
.من البحريّة أو القراصنة

120
00:07:48,510 --> 00:07:50,150
لماذا؟

121
00:07:50,360 --> 00:07:52,360
ما الّذي تحاولين فعله؟

122
00:07:53,610 --> 00:07:56,830
!ألا ترى؟ أحاول التّلاعب بالمعلومات

123
00:07:57,280 --> 00:08:00,650
!جوائز المنافسة هي طريق خروجنا من هنا

124
00:08:00,650 --> 00:08:02,030
جوائز؟

125
00:08:02,290 --> 00:08:05,900
لديهم واحدة من أقوى فواكه
الشّيطان تسمح لآكلها

126
00:08:05,900 --> 00:08:08,330
!بالتّحوّل إلى التّنّين الأزوريّ الخرافيّ

127
00:08:08,660 --> 00:08:10,170
!وذلك ليس كلّ شيء

128
00:08:10,300 --> 00:08:14,010
،على هذه الجزيرة فاكهة الكفّ أيضًا

129
00:08:14,180 --> 00:08:17,180
وهي قادرة على إرسال آكلها
!والآخرين لجُزر أخرى

130
00:08:17,490 --> 00:08:20,430
،إن أكل واحد منّا أيًّا من هاتين الفاكهتين

131
00:08:20,430 --> 00:08:24,900
بإمكان عشرات النّاس الهرب
!من هذه الجحيم والبحريّة

132
00:08:25,070 --> 00:08:26,520
...هذا مستحيل

133
00:08:26,520 --> 00:08:30,900
.الجوائز في مركز الجزيرة
.سيقتلوننا إن اقتربنا منها

134
00:08:31,140 --> 00:08:34,580
!أنا محترفة سرقة وتنصّت وتجسّس

135
00:08:34,670 --> 00:08:38,590
.سرّبتُ بعض المعلومات قبل أسبوعين

136
00:08:38,940 --> 00:08:43,200
يفترض أن تأتي حشود من القراصنة
ليعيثوا فسادًا في هذه الجزيرة

137
00:08:43,200 --> 00:08:44,920
.للحصول على الكنز

138
00:08:46,460 --> 00:08:49,970
.لكنّ ذلك لن يكون كافيًا لضمان نجاحنا

139
00:08:50,040 --> 00:08:54,840
على أحدنا أن يكون طُعمًا لجذب
.التّنانين السّماويّين

140
00:08:55,800 --> 00:08:57,100
طُعم؟

141
00:08:59,820 --> 00:09:01,010
.أنا أتطوّع لذلك

142
00:09:04,180 --> 00:09:05,390
!كوما

143
00:09:05,390 --> 00:09:09,450
سيسمح لي جسدي الضّخم والشّديد
.بالنّجاة أطول من الآخرين

144
00:09:09,450 --> 00:09:10,360
...كما أنّي

145
00:09:11,640 --> 00:09:14,740
.لا أريد رؤية أيّ أحد آخر يموت

146
00:09:17,150 --> 00:09:19,240
!مرحى

147
00:09:19,240 --> 00:09:21,230
!أحسنت القول يا كوما

148
00:09:21,230 --> 00:09:23,460
!لن أسمح لهم بقتلك

149
00:09:23,560 --> 00:09:25,910
!سنغادر غود فالي معًا

150
00:09:32,580 --> 00:09:35,380
عدالة

151
00:09:35,950 --> 00:09:36,840
ماذا؟

152
00:09:40,250 --> 00:09:41,940
أرى سفينة قادمة من الشّرق

153
00:09:42,220 --> 00:09:45,560
روكس

154
00:09:42,520 --> 00:09:44,840
!وهي لقراصنة روكس

155
00:10:00,330 --> 00:10:02,990
قراصنة روكس؟ لماذا؟

156
00:10:02,990 --> 00:10:04,700
!وليسوا الوحيدين أيضًا

157
00:10:04,880 --> 00:10:07,660
!ثمّة عدّة سفن قادمة
!جميعها لقراصنة مشهورين

158
00:10:07,930 --> 00:10:10,320
.لم نسمع أيّ شيء عن هذا
ما الّذي يسعون خلفه؟

159
00:10:10,320 --> 00:10:11,440
!أطلقوا

160
00:10:17,010 --> 00:10:18,930
!إنّكم تضيّعون ذخيرتكم أيّها البحريّة

161
00:10:20,860 --> 00:10:23,970
!اتبعوني يا قراصنة روكس

162
00:10:25,740 --> 00:10:29,380
!لا تتسرّع كثيرًا يا روكس
!من قال أنّي أحد أتباعك لتأمرني؟

163
00:10:29,380 --> 00:10:30,520
!غبيّ

164
00:10:30,950 --> 00:10:33,980
!لا تبدأ بهذا أنت أيضًا يا نيوغيت

165
00:10:35,510 --> 00:10:37,530
!يا لجرأتك يا ستوسي

166
00:10:37,530 --> 00:10:39,990
.لا يحقّ لك قول ذلك يا غلوريوسا

167
00:10:40,150 --> 00:10:42,250
!الغنيمة لمن سبق

168
00:10:42,400 --> 00:10:43,740
أيناسبكم ذلك؟

169
00:10:47,020 --> 00:10:49,040
عمّ تتحدّثون؟

170
00:10:49,390 --> 00:10:51,330
.الكنز لي أنا

171
00:10:51,920 --> 00:10:54,290
!لن يكون لك أيّ نفع به يا لينلين

172
00:10:55,500 --> 00:10:57,500
!ذلك الكنز من نصيبي

173
00:10:59,920 --> 00:11:03,230
!واثق أنّ الغبيّ روكس نسي لماذا نحن هنا

174
00:11:03,230 --> 00:11:05,100
!علينا التّأكّد من الكنز أوّلاً

175
00:11:05,290 --> 00:11:08,150
!كفّ عن التّصرّف كأنّك القائد هنا

176
00:11:08,220 --> 00:11:10,350
!سأطيح بكم جميعًا

177
00:11:10,350 --> 00:11:13,400
.سأسرق ما أسعى خلفه وأغادر بكلّ صمت

178
00:11:13,400 --> 00:11:15,820
.كفاكم من أحلام اليقظة

179
00:11:15,820 --> 00:11:19,000
.يبدو أنّ روجر يسعى خلفه أيضًا
...إنّه آخر من قد أدعه

180
00:11:19,000 --> 00:11:20,360
!اصمت أيّها الفتى

181
00:11:21,100 --> 00:11:22,830
!معركة اليوم حاسمة

182
00:11:22,830 --> 00:11:25,450
!أتينا جميعًا وذلك الهدف نصب أعيننا

183
00:11:25,570 --> 00:11:27,420
!لنسوِّ هذا الأمر الآن وللأبد

184
00:11:31,200 --> 00:11:33,280
!نزل قراصنة روكس على الجزيرة

185
00:11:33,280 --> 00:11:34,480
قراصنة؟

186
00:11:34,480 --> 00:11:36,110
!تحرّكوا أيّها البحريّة

187
00:11:36,110 --> 00:11:39,010
!إن حدث لنا أيّ شيء، ستدفعون الثّمن-إي

188
00:11:39,200 --> 00:11:40,340
!لديّ تقرير

189
00:11:40,580 --> 00:11:44,280
!تظهر أطقم قراصنة من كلّ الجهات
!إنّنا محاصرون

190
00:11:44,280 --> 00:11:47,810
!كيف عرفوا؟ كانت تلك المعلومات سرّيّة

191
00:11:48,050 --> 00:11:49,980
!نحن نجهل مسعاهم

192
00:11:50,340 --> 00:11:52,230
!احذروا في السّاحل الغربيّ

193
00:11:52,390 --> 00:11:54,500
!نزل قراصنة روجر هناك

194
00:12:00,730 --> 00:12:05,310
ألديكم أيّ فكرة بما شعرتُ به
!طول هذه السّنة؟

195
00:12:05,310 --> 00:12:07,020
.يبدو أنّ الأمور تزداد حماسة

196
00:12:07,020 --> 00:12:10,770
لن تكون لك أيّ امتيازات كقبطان
!هذه المرّة يا روجر

197
00:12:10,770 --> 00:12:13,000
!لننطلق يا رجال

198
00:12:14,780 --> 00:12:18,140
!ليتراجع رجال البحريّة لحماية التّنانين السّماويّين

199
00:12:18,140 --> 00:12:21,260
!يا للغباء! ما كانت الغاية من الحصار؟

200
00:12:21,260 --> 00:12:23,840
!تقدّموا أيّها الفرسان المقدّسون –
!حاضرة –

201
00:12:32,260 --> 00:12:35,880
.علينا سرقة الجوائز قبل أن ينزلوا

202
00:12:35,880 --> 00:12:38,020
!أسرع يا كوما –
.حاضر –

203
00:12:38,310 --> 00:12:39,980
روجر وروكس؟

204
00:12:40,150 --> 00:12:42,520
.قد يكون هذا كثيرًا علينا

205
00:12:42,670 --> 00:12:44,350
!وصلت التّعزيزات

206
00:12:49,660 --> 00:12:51,370
أين هو؟

207
00:12:51,570 --> 00:12:55,290
!أخبروني أين أجد روجر

208
00:12:55,880 --> 00:12:57,290
!لقد نجونا

209
00:12:59,960 --> 00:13:02,030
!أخلوا المكان في أسرع وقت ممكن

210
00:13:04,750 --> 00:13:06,840
!رائع! سبقناهم لها

211
00:13:10,570 --> 00:13:12,220
لا يوجد أحد هنا، صحيح؟

212
00:13:12,630 --> 00:13:15,070
!لنفتح هذه الصّناديق الصّغيرة

213
00:13:15,470 --> 00:13:16,690
!حسنًا

214
00:13:17,100 --> 00:13:18,940
!مرحى

215
00:13:18,940 --> 00:13:20,400
!نجحنا

216
00:13:20,640 --> 00:13:22,360
هذه فاكهة شيطان إذًا؟

217
00:13:22,360 --> 00:13:26,540
،لا أستطيع التّمييز بينهما
!لذلك دعنا نكتشف بعد أكلهما

218
00:13:26,730 --> 00:13:28,240
علينا أكلها؟

219
00:13:34,910 --> 00:13:35,830
!إيفا-تشان

220
00:13:37,580 --> 00:13:39,040
!ليس بهذه السّرعة

221
00:13:40,330 --> 00:13:41,290
.إيفا-تشان

222
00:13:43,580 --> 00:13:45,640
.سآخذ هذه أيضًا

223
00:13:47,180 --> 00:13:48,390
!كُلها يا كوما

224
00:13:54,020 --> 00:13:56,230
!أعطني إيّاها يا فتى

225
00:13:56,230 --> 00:13:57,750
!لا تفكّر

226
00:14:03,110 --> 00:14:05,740
!كُل الفاكهة وأنقذ نفسك

227
00:14:10,440 --> 00:14:12,390
،إن نجا ولو واحد منّا فقط

228
00:14:16,590 --> 00:14:19,330
!فسنكون قد فزنا

229
00:14:22,490 --> 00:14:25,430
!ممتاز! هيّا يا كوما

230
00:14:27,350 --> 00:14:28,550
...إيفا-تشان

231
00:14:29,390 --> 00:14:30,470
!كوما

232
00:14:36,890 --> 00:14:39,230
...فتى الباكانير

233
00:14:41,230 --> 00:14:46,070
الموت أو العبوديّة هما فقط
.ما قُدّر لكم في هذه الحياة

234
00:14:46,420 --> 00:14:49,200
.هذا ما قرّره التّاريخ لأمثالكم

235
00:14:54,060 --> 00:14:55,700
هل أنت شخص مهمّ يا سيّدي؟

236
00:14:57,700 --> 00:15:01,750
أن تولد مهمًّا في نظر العالم
...هو أمر غريب بالفعل

237
00:15:01,750 --> 00:15:06,710
ولا فائدة من أن يولد المرء من الأساس
.إن كان سيكون عبدًا منذ ولادته

238
00:15:07,610 --> 00:15:11,970
إن حصلتُ على قوّة بعد
،أكلي لهذه الفاكهة

239
00:15:12,550 --> 00:15:14,930
،فأريد أن أكون مثل نيكا

240
00:15:14,930 --> 00:15:17,570
...وأستعملها لإنقاذ أكبر عدد

241
00:15:17,840 --> 00:15:20,140
!من هؤلاء الأقلّ حظًّا

242
00:15:20,540 --> 00:15:24,030
.لذلك السّبب على أمثالكم أن يختفوا

243
00:15:27,390 --> 00:15:29,020
!انتظر يا روكس

244
00:15:29,020 --> 00:15:30,710
!ابتعد عن طريقي يا روجر

245
00:15:31,080 --> 00:15:35,160
ستختفي هذه الأحداث بين
.طيّات التّاريخ المظلم

246
00:15:35,780 --> 00:15:42,290
مملكة سوربي
الأزرق الجنوبيّ

247
00:15:37,360 --> 00:15:39,480
.أسطورة غارب البطوليّة

248
00:15:39,480 --> 00:15:42,290
!أهذا كلّ ما للأخبار أن ينشروه؟

249
00:15:42,550 --> 00:15:45,190
.ذلك بالضّبط ما يريده مَن على قمّة العالم

250
00:15:45,330 --> 00:15:48,050
.هذا الصّحفيّ مورغانز مجرّد حثالة

251
00:15:48,370 --> 00:15:52,860
في النّهاية، ما زلنا لا نعرف ماذا
.حدث على تلك الجزيرة بالفعل

252
00:15:52,960 --> 00:15:56,440
أتنوي الصّلاة طويلاً يا كوما؟

253
00:15:57,980 --> 00:16:02,100
أنا أفكّر في الأرواح الأخرى
...الّتي لم أستطع إنقاذها

254
00:16:02,290 --> 00:16:03,780
!كفّ عن ذلك

255
00:16:03,890 --> 00:16:08,480
أنقذت أكثر من خمسمائة شخص
!في خضمّ كلّ تلك الفوضى

256
00:16:08,480 --> 00:16:11,440
!إنّه محقّ يا كوماتشي! كنتَ رائعًا

257
00:16:11,440 --> 00:16:13,730
!كان الجميع يبكون دموع امتنان لك

258
00:16:13,730 --> 00:16:15,580
!بمن فيهم أنا

259
00:16:16,820 --> 00:16:17,830
...ولكن

260
00:16:18,890 --> 00:16:22,150
منحتَ أولئك الأشخاص حرّيّتهم
.بيديك هاتين

261
00:16:22,150 --> 00:16:23,830
!يداك الآن يدا تحرير

262
00:16:24,260 --> 00:16:25,790
تحرير؟

263
00:16:26,040 --> 00:16:27,130
يداي؟

264
00:16:27,540 --> 00:16:29,150
.أنت قويّ

265
00:16:29,250 --> 00:16:31,890
!عليك تحمّل كلّ شيء وتنجو

266
00:16:31,960 --> 00:16:34,010
!سيأتي محارب التّحرير

267
00:16:38,200 --> 00:16:40,810
تدير عائلتك كنيسة؟

268
00:16:40,810 --> 00:16:43,310
.هذا يفسّر الكثير بشأن شخصيّتك

269
00:16:48,980 --> 00:16:51,900
!حسنًا، أظنّني سأُبحر

270
00:16:51,900 --> 00:16:54,070
!حان الوقت للاستمتاع بحرّيّتي

271
00:16:54,390 --> 00:16:57,370
!لن أنسى وجهك أبدًا يا إيفا-تشان

272
00:16:58,800 --> 00:17:00,830
!يستحيل على أيّ أحد نسيانه

273
00:17:00,830 --> 00:17:05,830
أمّا أنا فسأظلّ هنا مع كوماتشي
!وأكتشف ماذا أفعل بمستقبلي يا أخي

274
00:17:06,100 --> 00:17:08,290
!هذه فكرة ممتازة

275
00:17:09,780 --> 00:17:12,760
!مع السّلامة يا صديقيّ

276
00:17:18,040 --> 00:17:18,970
!حسنًا

277
00:17:19,740 --> 00:17:23,730
أنا أكبر منك بأربع سنوات. لذلك من
.واجبي الحرص على إطعامك

278
00:17:26,550 --> 00:17:28,060
!لنذهب لتقطيع الحطب

279
00:17:31,540 --> 00:17:32,530
...هذا مؤلم

280
00:17:33,730 --> 00:17:35,490
هل أنت بخير يا جيني؟

281
00:17:36,900 --> 00:17:38,450
هل أقطعها بهذا فحسب؟

282
00:17:39,230 --> 00:17:40,160
!نعم

283
00:17:45,070 --> 00:17:47,420
!اقطع ذلك الحطب يا كوماتشي

284
00:17:49,240 --> 00:17:51,530
!ممتاز! لنذهب لبيعه الآن

285
00:17:51,530 --> 00:17:52,590
!حاضر

286
00:17:52,590 --> 00:17:55,650
.لننس البحث في القمامة عن الطّعام أو سرقته

287
00:17:55,750 --> 00:17:58,150
!سنشتريه بالمال الّذي نجنيه

288
00:17:58,150 --> 00:17:59,050
!أجل

289
00:17:59,340 --> 00:18:00,710
!هيّا بنا

290
00:18:00,710 --> 00:18:01,780
.نعم

291
00:18:04,420 --> 00:18:05,830
!بعنا كلّ شيء

292
00:18:05,830 --> 00:18:06,730
.نعم

293
00:18:06,930 --> 00:18:08,740
!كم أنا جائعة

294
00:18:08,830 --> 00:18:10,440
ماذا سنأكل اليوم؟

295
00:18:10,600 --> 00:18:12,760
.أيّ شيء تشتهينه

296
00:18:12,760 --> 00:18:13,900
!ممتاز

297
00:18:13,900 --> 00:18:16,070
...في تلك الحالة

298
00:18:17,090 --> 00:18:19,660
!لم ركما هنا من قبل –
.صحيح –

299
00:18:20,190 --> 00:18:22,490
أنت ضخم! كم عمرك؟

300
00:18:22,860 --> 00:18:24,410
.أنا في التّاسعة

301
00:18:24,410 --> 00:18:26,660
ماذا؟ في التّاسعة؟

302
00:18:30,410 --> 00:18:31,500
!كاذب

303
00:18:33,210 --> 00:18:34,840
!أنت وحش –
.هذا مؤلم –

304
00:18:34,840 --> 00:18:35,670
!توقّفا

305
00:18:36,660 --> 00:18:39,300
!إيّاكما ولمس كوماتشي

306
00:18:39,300 --> 00:18:40,510
!جيني

307
00:18:44,680 --> 00:18:48,810
.آسف بشأن ذلك
.إنّها لطيفة جدًّا في الحقيقة

308
00:18:54,980 --> 00:18:57,360
هل شفيت؟ –
!لم أعد أتألّم –

309
00:18:57,890 --> 00:18:59,320
أهذا سحر؟

310
00:18:59,320 --> 00:19:02,280
!أنت صانع معجزات يا كوماتشي –
!مذهل –

311
00:19:03,070 --> 00:19:08,250
!كوماتشي! كوماتشي

312
00:19:10,870 --> 00:19:11,980
.لنبدأ الأكل

313
00:19:11,980 --> 00:19:13,330
!لنبدأ الأكل

314
00:19:19,170 --> 00:19:20,410
.لم يكن ذلك كافيًا

315
00:19:20,410 --> 00:19:21,930
.تفضّلي –
أأنت واثق؟ –

316
00:19:26,630 --> 00:19:28,390
!هذا لذيذ

317
00:19:28,390 --> 00:19:31,980
.إنّك نهمة جدًّا، لذلك علينا العمل بجدّ

318
00:19:32,220 --> 00:19:33,310
!حاضرة

319
00:19:37,200 --> 00:19:40,150
كم كان عمرك عندما صرت عبدًا يا كوماتشي؟

320
00:19:43,360 --> 00:19:44,370
.أربع سنوات

321
00:19:44,570 --> 00:19:45,820
!وأنا أيضًا

322
00:19:45,820 --> 00:19:48,330
...لا شيء في ذلك يدعو للاحتفال

323
00:19:51,200 --> 00:19:53,030
!أنا شبعى

324
00:19:53,220 --> 00:19:54,800
!...أنا شبعى

325
00:19:55,490 --> 00:19:57,690
...أنا... شبعى

326
00:19:58,830 --> 00:19:59,760
جيني؟

327
00:20:02,920 --> 00:20:04,900
!كوماتشي

328
00:20:29,150 --> 00:20:30,470
!كوماتشي

329
00:20:36,610 --> 00:20:40,130
كم أنا جائعة! ماذا سنأكل؟

330
00:20:45,690 --> 00:20:48,350
.أيّ شيء تشتهينه

331
00:20:50,860 --> 00:20:52,500
...كوماتشي

332
00:20:57,720 --> 00:21:01,590
!ماذا؟ لا تبكي يا جيني

333
00:21:23,730 --> 00:21:25,310
.أنا جدّ سعيدة

334
00:21:42,230 --> 00:21:47,490
ما عدت أستطيع حماية أحد ثانية

335
00:21:47,490 --> 00:21:52,290
إنّ تلاشي الصّوت خطئي أنا

336
00:21:52,290 --> 00:21:54,580
ما عاد لديّ وقت حتّى للنّظر للأسف

337
00:21:54,580 --> 00:21:57,170
ثمّة آثار حصى على راحَتَيَّ

338
00:21:57,170 --> 00:22:00,960
ابدئي بالتّحرّك ثانية يا سفينتي

339
00:22:00,960 --> 00:22:06,050
مع أنّي لا أستطيع الطّيران في السّماء الواسعة

340
00:22:06,050 --> 00:22:12,100
بإمكاني إضاءة البحر العميق

341
00:22:12,100 --> 00:22:12,890
نحن

342
00:22:12,890 --> 00:22:15,390
ودائمًا، لا يمكننا السّماح أن تكون هذه النّهاية

343
00:22:15,390 --> 00:22:18,020
ودائمًا، لا يمكننا أن نُهزم

344
00:22:18,020 --> 00:22:21,810
لدينا شيء ما هنا لحمايته

345
00:22:21,810 --> 00:22:24,320
قد لا يكون هذا ما توقّعتُه

346
00:22:24,320 --> 00:22:27,030
لكن لا يمكننا أن نتوقّف هنا

347
00:22:27,030 --> 00:22:32,370
سننطلق الآن ونتشارك الوحدة

348
00:22:32,370 --> 00:22:35,080
لا داعي للخوف

349
00:22:35,080 --> 00:22:39,040
لستُ نفس الشّخص الّذي كنتُه يومها

350
00:22:39,040 --> 00:22:42,920
لا يستطيع أحد الوقوف في طريقي

351
00:22:42,920 --> 00:22:44,130
والآن، ابتعدوا

352
00:22:44,130 --> 00:22:46,780
اغزُ العالم، آمن بالمستقبل

353
00:22:46,780 --> 00:22:49,320
عدّ اللّيالي

354
00:22:49,320 --> 00:22:52,030
ماذا رأيت؟ ماذا تعلّمت؟

355
00:22:52,030 --> 00:22:55,530
لإدراك ما هو مهمّ

356
00:23:04,290 --> 00:23:08,910
يعيش كوما وجيني حياة سعيدة
.واضعين ماضيهما كعبدين خلفهما

357
00:23:08,910 --> 00:23:13,490
لكن من جهة أخرى، يدوس ملك
.قاسٍ على سعادة رعاياه

358
00:23:13,490 --> 00:23:17,320
،ينطلق بطلانا في مواجهة الحكومة
.ويقاتلان من أجل الحرّيّة

359
00:23:17,320 --> 00:23:20,830
هل تستطيع مشاعرهما تغيير العالم؟

360
00:23:20,940 --> 00:23:22,380
:في الحلقة القادمة من وان بيس

361
00:23:22,380 --> 00:23:25,710
"!لمحات سعادة عابرة! كوماتشي وجيني"

362
00:23:25,710 --> 00:23:28,130
!ملك القراصنة، لن يكون إلاّ أنا