1
00:00:00,000 --> 00:00:11,040
يوجد قوس قزح وراء الأمطار الغزيرة

2
00:00:19,170 --> 00:00:22,680
سأعرف أنّ الجواب السّهل كذبة

3
00:00:23,930 --> 00:00:28,290
أعد ألاّ أتراجع أمام الصّراخ

4
00:00:28,290 --> 00:00:32,830
أحتاجك وحدك لتفهم الغد

5
00:00:32,930 --> 00:00:37,620
أعطيتني أفضل لحظات حياتي

6
00:00:39,190 --> 00:00:47,790
...ماذا أبدو؟ ملَكًا أم شيطانًا

7
00:00:47,790 --> 00:00:52,710
ما وراء الفجر، ما وراء الفجر

8
00:00:52,710 --> 00:00:58,230
ثمّة الكثير ممّا أريد أن أخبرك به

9
00:00:58,230 --> 00:01:03,050
مليء بالحبّ، بالحبّ

10
00:01:03,050 --> 00:01:08,870
الّذي لا يمكن كتابته في رسالة

11
00:01:05,100 --> 00:01:07,180
عزيزتي بوني

12
00:01:08,870 --> 00:01:17,400
يد صغيرة تبحث عن الأبديّة

13
00:01:28,570 --> 00:01:29,920
!مهلاً

14
00:01:33,080 --> 00:01:35,380
أأنت بخير يا كوما؟

15
00:01:35,380 --> 00:01:36,340
!كوما

16
00:01:37,000 --> 00:01:38,150
.أنا بخير

17
00:01:38,370 --> 00:01:40,470
!هذا لا شيء

18
00:01:40,870 --> 00:01:42,310
.يا لشجاعتك يا كوما

19
00:01:44,920 --> 00:01:47,700
!أنا من تسري في عروقه دماء الباكانير

20
00:01:47,700 --> 00:01:49,160
!أمّا زوجتي فلا

21
00:01:49,160 --> 00:01:51,190
!دعوها وطفلنا وشأنهما

22
00:01:53,590 --> 00:01:55,290
.أمّك ماتت

23
00:01:55,510 --> 00:01:57,410
.إنّها في السّماء الآن

24
00:01:57,720 --> 00:01:59,610
...أعتقد أنّها

25
00:02:00,240 --> 00:02:01,870
.في مكان أفضل الآن

26
00:02:02,680 --> 00:02:05,410
.أنت قويّ يا كوما

27
00:02:06,030 --> 00:02:08,810
.عليك تحمّل كلّ شيء وتنجو

28
00:02:10,170 --> 00:02:12,000
!إله الشّمس نيكا

29
00:02:12,280 --> 00:02:15,130
...سيأتي من أجلك وسيأخذك بعيدًا معه

30
00:02:15,130 --> 00:02:18,090
.بينما ستداعب الشّمس والبحر وجهك

31
00:02:19,880 --> 00:02:21,130
!اخرسوا-إي

32
00:02:25,140 --> 00:02:27,010
!أعلم أنّكم كنتم تنتظرون هذا

33
00:02:27,010 --> 00:02:31,450
الحدث الّذي يقام كلّ ثلاث
!سنوات لاختبار مهاراتكم

34
00:02:31,450 --> 00:02:33,420
...حلبة مسابقة هذه السّنة

35
00:02:33,420 --> 00:02:36,220
.هي جزيرة لا تنتمي لتحالف حكومة العالم

36
00:02:36,220 --> 00:02:37,840
!غود فالي

37
00:02:38,140 --> 00:02:39,770
!وجدناه

38
00:02:39,770 --> 00:02:41,660
!لا يمكنك الهرب

39
00:02:42,730 --> 00:02:44,530
!مهلاً لحظة

40
00:02:47,110 --> 00:02:48,850
!أنا أختار الحياة

41
00:02:48,850 --> 00:02:50,880
!فماذا عنكم أنتم؟

42
00:02:56,310 --> 00:03:00,790
!فصل محذوف من التّاريخ"
"!يأس غود فالي

43
00:03:04,300 --> 00:03:06,260
الأزرق الغربيّ - غود فالي

44
00:03:09,970 --> 00:03:13,850
!تمّ تحرير فرائس اليوم في البرّيّة

45
00:03:13,850 --> 00:03:18,840
الأرانب الثّلاثة عشر فائقة النُّدرة الّتي سلف
!وقدّمناها تعادل 10 آلاف نقطة لكلّ واحد

46
00:03:18,840 --> 00:03:22,020
كما أنّ هنالك 150 من الأرانب
!متوسّطة النُّدرة

47
00:03:22,360 --> 00:03:25,290
!سيتمّ تقديم نقاط إضافيّة على القتل الفوريّ

48
00:03:25,290 --> 00:03:30,110
وجهّزنا مكافآت من العيار الثّقيل
!في انتظار الفائز الأوّل

49
00:03:31,120 --> 00:03:32,990
.شاهدوا أيّها الأطفال

50
00:03:33,190 --> 00:03:35,080
.لا تتوقّع الفوز يا غارلينغ

51
00:03:35,350 --> 00:03:37,410
!ستحظى عائلة مانماير بهذه الجائزة

52
00:03:41,630 --> 00:03:44,710
!لا داعي للعجلة! احترموا القواعد

53
00:03:47,670 --> 00:03:50,450
!كيف يُسمح بشيء فظيع مثل هذا؟

54
00:03:50,450 --> 00:03:52,370
!ليوقظني أحد ما من هذا الكابوس

55
00:03:52,500 --> 00:03:55,680
!لا يجدر بالبشر أن يعاملوا البشر الآخرين كألعاب

56
00:03:57,680 --> 00:03:58,890
!بنيّ

57
00:04:01,100 --> 00:04:03,820
!على خطّتنا أن تنجح بكلّ تأكيد

58
00:04:03,890 --> 00:04:05,280
!تحمّسوا

59
00:04:05,840 --> 00:04:06,730
.حاضر

60
00:04:09,650 --> 00:04:12,310
سيبدأ نبلاء العالم المائتين

61
00:04:12,310 --> 00:04:15,390
.مطارَدتهم بعد ساعة من الآن

62
00:04:15,390 --> 00:04:18,120
!اهربوا إن أردتم النّجاة

63
00:04:22,080 --> 00:04:23,920
مقرّ البحريّة الرّئيسيّ

64
00:04:23,920 --> 00:04:25,780
غود فالي؟

65
00:04:25,780 --> 00:04:28,260
لماذا عليّ الذّهاب لجزيرة معزولة كهذه؟

66
00:04:28,490 --> 00:04:30,350
...لا يمكنني إخبارك

67
00:04:30,440 --> 00:04:32,390
!أتوسّل إليك يا غارب –
.لا –

68
00:04:32,950 --> 00:04:34,730
،لا شيء أكيد بعد

69
00:04:34,920 --> 00:04:37,100
.لكنّ السّلامة أولى من النّدم

70
00:04:37,380 --> 00:04:40,060
هل تتحدّث عن رحلة التّنانين
!السّماويّين الصّغيرة؟

71
00:04:40,300 --> 00:04:44,270
لقد حذّرتكم. ما كان عليكم
.العبث مع هاتشينوسو

72
00:04:44,680 --> 00:04:47,010
.كان ذلك كنزًا من جزيرة القراصنة

73
00:04:47,010 --> 00:04:49,610
.من الطّبيعيّ أن يحاولوا استعادته

74
00:04:50,350 --> 00:04:52,860
.أتساءل كيف تسرّبت تلك المعلومات

75
00:04:53,230 --> 00:04:55,670
لم تُفرّطوا في إجراءات الأمن، أليس كذلك؟

76
00:04:55,820 --> 00:04:57,080
فلِمَ القلق إذًا؟

77
00:04:57,820 --> 00:04:59,370
...في الحقيقة

78
00:05:00,450 --> 00:05:02,620
.لم نتوقّع تدخّل روجر في الأمر

79
00:05:02,620 --> 00:05:03,790
!ابدأ بذلك في المرّة القادمة

80
00:05:04,130 --> 00:05:05,250
!أنا في طريقي

81
00:05:05,450 --> 00:05:08,130
!غادر قراصنة روكس الميناء

82
00:05:09,130 --> 00:05:10,840
جزيرة القراصنة في العالم الجديد - هاتشينوسو

83
00:05:11,120 --> 00:05:13,770
!سُحقًا! لقد سبقونا إليه

84
00:05:13,920 --> 00:05:15,800
!سنذهب أيضًا! أسرعوا

85
00:05:16,340 --> 00:05:19,360
!إنّه يوم مهمّ لعالم القراصنة

86
00:05:19,720 --> 00:05:22,940
!حسنًا! لتبدأ اللّعبة

87
00:05:34,870 --> 00:05:37,280
!انظروا للبحر

88
00:05:40,290 --> 00:05:43,830
.تحاصر البحريّة الجزيرة
.لم أرَ كلّ هذا العدد من السّفن من قبل

89
00:05:44,970 --> 00:05:48,610
،يريدون منع أيّ أحد من الهرب

90
00:05:48,810 --> 00:05:51,920
وحذف هذا الفصل القاسي بالكامل

91
00:05:51,980 --> 00:05:53,930
!من التّاريخ

92
00:05:54,680 --> 00:05:59,260
ما هذه الإبادة الجماعيّة بحق السّكّان
.الأصليّين إلاّ لعبة قذرة لاحتكار الموارد

93
00:06:00,050 --> 00:06:02,890
الأرانب المائة ألف على هذه الجزيرة

94
00:06:02,890 --> 00:06:05,420
سيُذبَحون بالكامل قبل نهاية لعبتهم

95
00:06:05,420 --> 00:06:07,360
!خلال ثلاثة أسابيع

96
00:06:08,910 --> 00:06:10,270
هل تصدّقون هذا؟

97
00:06:11,190 --> 00:06:14,320
هل هذه هي الحياة الحقيقيّة
!بالفعل أم أنّها جحيم؟

98
00:06:18,500 --> 00:06:19,450
...لكن

99
00:06:19,630 --> 00:06:21,770
،إن نجونا في هذه الأسابيع الثّلاثة

100
00:06:21,830 --> 00:06:24,020
!فسيقومون بتحريرنا

101
00:06:24,960 --> 00:06:26,980
!ستقودك سذاجتك إلى الهلاك

102
00:06:26,980 --> 00:06:30,720
!لم ينجُ أيّ أحد من هذه اللّعبة من قبل
!لا أحد على الإطلاق

103
00:06:31,380 --> 00:06:34,510
!لماذا يمنحوننا الأمل إن كان مجرّد كذبة؟

104
00:06:34,510 --> 00:06:37,760
!لأنّ الأمل هو ما يجعلكم تعانون وتهربون

105
00:06:37,980 --> 00:06:40,510
ما كان إعدام شخص سبق واستسلم

106
00:06:40,810 --> 00:06:42,220
!ليكون ممتعًا لهم

107
00:06:43,410 --> 00:06:47,750
!النّجاة من هذه اللّعبة ما هو إلاّ حلم أجوف

108
00:06:47,750 --> 00:06:50,820
!علينا الخروج من اللّعبة بحدّ ذاتها

109
00:06:51,180 --> 00:06:53,150
...كلاّ، مستحيل

110
00:07:01,570 --> 00:07:05,130
حصل القدّيس غارلينغ على مائة
!ألف نقطة سلفًا

111
00:07:05,130 --> 00:07:07,540
!هل يسعى خلف الأرانب الأكثر قيمة فقط؟

112
00:07:13,080 --> 00:07:14,630
!أنا حرّ أخيرًا

113
00:07:15,420 --> 00:07:16,510
!يا فكّك القويّ

114
00:07:16,670 --> 00:07:18,540
!من الجيّد تواجدك معنا أيّها البرمائيّ القرش

115
00:07:18,960 --> 00:07:22,470
.شكرًا لك. هذه أوّل مرّة يُثني فيها عليّ أحد ما

116
00:07:22,470 --> 00:07:25,370
ما الوضع يا جيني؟

117
00:07:26,560 --> 00:07:28,640
.ثمّة شيء ما ليس في محلّه

118
00:07:28,920 --> 00:07:31,410
.واثقة أنّهم حصلوا على المعلومة

119
00:07:31,510 --> 00:07:34,510
لكن لا توجد أيّ إشارات سواء
.من البحريّة أو القراصنة

120
00:07:34,510 --> 00:07:36,150
لماذا؟

121
00:07:36,360 --> 00:07:38,360
ما الّذي تحاولين فعله؟

122
00:07:39,610 --> 00:07:42,830
!ألا ترى؟ أحاول التّلاعب بالمعلومات

123
00:07:43,280 --> 00:07:46,650
!جوائز المنافسة هي طريق خروجنا من هنا

124
00:07:46,650 --> 00:07:48,030
جوائز؟

125
00:07:48,290 --> 00:07:51,900
لديهم واحدة من أقوى فواكه
الشّيطان تسمح لآكلها

126
00:07:51,900 --> 00:07:54,330
!بالتّحوّل إلى التّنّين الأزوريّ الخرافيّ

127
00:07:54,660 --> 00:07:56,170
!وذلك ليس كلّ شيء

128
00:07:56,300 --> 00:08:00,010
،على هذه الجزيرة فاكهة الكفّ أيضًا

129
00:08:00,180 --> 00:08:03,180
وهي قادرة على إرسال آكلها
!والآخرين لجُزر أخرى

130
00:08:03,490 --> 00:08:06,430
،إن أكل واحد منّا أيًّا من هاتين الفاكهتين

131
00:08:06,430 --> 00:08:10,900
بإمكان عشرات النّاس الهرب
!من هذه الجحيم والبحريّة

132
00:08:11,070 --> 00:08:12,520
...هذا مستحيل

133
00:08:12,520 --> 00:08:16,900
.الجوائز في مركز الجزيرة
.سيقتلوننا إن اقتربنا منها

134
00:08:17,140 --> 00:08:20,580
!أنا محترفة سرقة وتنصّت وتجسّس

135
00:08:20,670 --> 00:08:24,590
.سرّبتُ بعض المعلومات قبل أسبوعين

136
00:08:24,940 --> 00:08:29,200
يفترض أن تأتي حشود من القراصنة
ليعيثوا فسادًا في هذه الجزيرة

137
00:08:29,200 --> 00:08:30,920
.للحصول على الكنز

138
00:08:32,460 --> 00:08:35,970
.لكنّ ذلك لن يكون كافيًا لضمان نجاحنا

139
00:08:36,040 --> 00:08:40,840
على أحدنا أن يكون طُعمًا لجذب
.التّنانين السّماويّين

140
00:08:41,800 --> 00:08:43,100
طُعم؟

141
00:08:45,820 --> 00:08:47,010
.أنا أتطوّع لذلك

142
00:08:50,180 --> 00:08:51,390
!كوما

143
00:08:51,390 --> 00:08:55,450
سيسمح لي جسدي الضّخم والشّديد
.بالنّجاة أطول من الآخرين

144
00:08:55,450 --> 00:08:56,360
...كما أنّي

145
00:08:57,640 --> 00:09:00,740
.لا أريد رؤية أيّ أحد آخر يموت

146
00:09:03,150 --> 00:09:05,240
!مرحى

147
00:09:05,240 --> 00:09:07,230
!أحسنت القول يا كوما

148
00:09:07,230 --> 00:09:09,460
!لن أسمح لهم بقتلك

149
00:09:09,560 --> 00:09:11,910
!سنغادر غود فالي معًا

150
00:09:18,580 --> 00:09:21,380
عدالة

151
00:09:21,950 --> 00:09:22,840
ماذا؟

152
00:09:26,250 --> 00:09:27,940
أرى سفينة قادمة من الشّرق

153
00:09:28,220 --> 00:09:31,560
روكس

154
00:09:28,520 --> 00:09:30,840
!وهي لقراصنة روكس

155
00:09:46,330 --> 00:09:48,990
قراصنة روكس؟ لماذا؟

156
00:09:48,990 --> 00:09:50,700
!وليسوا الوحيدين أيضًا

157
00:09:50,880 --> 00:09:53,660
!ثمّة عدّة سفن قادمة
!جميعها لقراصنة مشهورين

158
00:09:53,930 --> 00:09:56,320
.لم نسمع أيّ شيء عن هذا
ما الّذي يسعون خلفه؟

159
00:09:56,320 --> 00:09:57,440
!أطلقوا

160
00:10:03,010 --> 00:10:04,930
!إنّكم تضيّعون ذخيرتكم أيّها البحريّة

161
00:10:06,860 --> 00:10:09,970
!اتبعوني يا قراصنة روكس

162
00:10:11,740 --> 00:10:15,380
!لا تتسرّع كثيرًا يا روكس
!من قال أنّي أحد أتباعك لتأمرني؟

163
00:10:15,380 --> 00:10:16,520
!غبيّ

164
00:10:16,950 --> 00:10:19,980
!لا تبدأ بهذا أنت أيضًا يا نيوغيت

165
00:10:21,510 --> 00:10:23,530
!يا لجرأتك يا ستوسي

166
00:10:23,530 --> 00:10:25,990
.لا يحقّ لك قول ذلك يا غلوريوسا

167
00:10:26,150 --> 00:10:28,250
!الغنيمة لمن سبق

168
00:10:28,400 --> 00:10:29,740
أيناسبكم ذلك؟

169
00:10:33,020 --> 00:10:35,040
عمّ تتحدّثون؟

170
00:10:35,390 --> 00:10:37,330
.الكنز لي أنا

171
00:10:37,920 --> 00:10:40,290
!لن يكون لك أيّ نفع به يا لينلين

172
00:10:41,500 --> 00:10:43,500
!ذلك الكنز من نصيبي

173
00:10:45,920 --> 00:10:49,230
!واثق أنّ الغبيّ روكس نسي لماذا نحن هنا

174
00:10:49,230 --> 00:10:51,100
!علينا التّأكّد من الكنز أوّلاً

175
00:10:51,290 --> 00:10:54,150
!كفّ عن التّصرّف كأنّك القائد هنا

176
00:10:54,220 --> 00:10:56,350
!سأطيح بكم جميعًا

177
00:10:56,350 --> 00:10:59,400
.سأسرق ما أسعى خلفه وأغادر بكلّ صمت

178
00:10:59,400 --> 00:11:01,820
.كفاكم من أحلام اليقظة

179
00:11:01,820 --> 00:11:05,000
.يبدو أنّ روجر يسعى خلفه أيضًا
...إنّه آخر من قد أدعه

180
00:11:05,000 --> 00:11:06,360
!اصمت أيّها الفتى

181
00:11:07,100 --> 00:11:08,830
!معركة اليوم حاسمة

182
00:11:08,830 --> 00:11:11,450
!أتينا جميعًا وذلك الهدف نصب أعيننا

183
00:11:11,570 --> 00:11:13,420
!لنسوِّ هذا الأمر الآن وللأبد

184
00:11:17,200 --> 00:11:19,280
!نزل قراصنة روكس على الجزيرة

185
00:11:19,280 --> 00:11:20,480
قراصنة؟

186
00:11:20,480 --> 00:11:22,110
!تحرّكوا أيّها البحريّة

187
00:11:22,110 --> 00:11:25,010
!إن حدث لنا أيّ شيء، ستدفعون الثّمن-إي

188
00:11:25,200 --> 00:11:26,340
!لديّ تقرير

189
00:11:26,580 --> 00:11:30,280
!تظهر أطقم قراصنة من كلّ الجهات
!إنّنا محاصرون

190
00:11:30,280 --> 00:11:33,810
!كيف عرفوا؟ كانت تلك المعلومات سرّيّة

191
00:11:34,050 --> 00:11:35,980
!نحن نجهل مسعاهم

192
00:11:36,340 --> 00:11:38,230
!احذروا في السّاحل الغربيّ

193
00:11:38,390 --> 00:11:40,500
!نزل قراصنة روجر هناك

194
00:11:46,730 --> 00:11:51,310
ألديكم أيّ فكرة بما شعرتُ به
!طول هذه السّنة؟

195
00:11:51,310 --> 00:11:53,020
.يبدو أنّ الأمور تزداد حماسة

196
00:11:53,020 --> 00:11:56,770
لن تكون لك أيّ امتيازات كقبطان
!هذه المرّة يا روجر

197
00:11:56,770 --> 00:11:59,000
!لننطلق يا رجال

198
00:12:00,780 --> 00:12:04,140
!ليتراجع رجال البحريّة لحماية التّنانين السّماويّين

199
00:12:04,140 --> 00:12:07,260
!يا للغباء! ما كانت الغاية من الحصار؟

200
00:12:07,260 --> 00:12:09,840
!تقدّموا أيّها الفرسان المقدّسون –
!حاضرة –

201
00:12:18,260 --> 00:12:21,880
.علينا سرقة الجوائز قبل أن ينزلوا

202
00:12:21,880 --> 00:12:24,020
!أسرع يا كوما –
.حاضر –

203
00:12:24,310 --> 00:12:25,980
روجر وروكس؟

204
00:12:26,150 --> 00:12:28,520
.قد يكون هذا كثيرًا علينا

205
00:12:28,670 --> 00:12:30,350
!وصلت التّعزيزات

206
00:12:35,660 --> 00:12:37,370
أين هو؟

207
00:12:37,570 --> 00:12:41,290
!أخبروني أين أجد روجر

208
00:12:41,880 --> 00:12:43,290
!لقد نجونا

209
00:12:45,960 --> 00:12:48,030
!أخلوا المكان في أسرع وقت ممكن

210
00:12:50,750 --> 00:12:52,840
!رائع! سبقناهم لها

211
00:12:56,570 --> 00:12:58,220
لا يوجد أحد هنا، صحيح؟

212
00:12:58,630 --> 00:13:01,070
!لنفتح هذه الصّناديق الصّغيرة

213
00:13:01,470 --> 00:13:02,690
!حسنًا

214
00:13:03,100 --> 00:13:04,940
!مرحى

215
00:13:04,940 --> 00:13:06,400
!نجحنا

216
00:13:06,640 --> 00:13:08,360
هذه فاكهة شيطان إذًا؟

217
00:13:08,360 --> 00:13:12,540
،لا أستطيع التّمييز بينهما
!لذلك دعنا نكتشف بعد أكلهما

218
00:13:12,730 --> 00:13:14,240
علينا أكلها؟

219
00:13:20,910 --> 00:13:21,830
!إيفا-تشان

220
00:13:23,580 --> 00:13:25,040
!ليس بهذه السّرعة

221
00:13:26,330 --> 00:13:27,290
.إيفا-تشان

222
00:13:29,580 --> 00:13:31,640
.سآخذ هذه أيضًا

223
00:13:33,180 --> 00:13:34,390
!كُلها يا كوما

224
00:13:40,020 --> 00:13:42,230
!أعطني إيّاها يا فتى

225
00:13:42,230 --> 00:13:43,750
!لا تفكّر

226
00:13:49,110 --> 00:13:51,740
!كُل الفاكهة وأنقذ نفسك

227
00:13:56,440 --> 00:13:58,390
،إن نجا ولو واحد منّا فقط

228
00:14:02,590 --> 00:14:05,330
!فسنكون قد فزنا

229
00:14:08,490 --> 00:14:11,430
!ممتاز! هيّا يا كوما

230
00:14:13,350 --> 00:14:14,550
...إيفا-تشان

231
00:14:15,390 --> 00:14:16,470
!كوما

232
00:14:22,890 --> 00:14:25,230
...فتى الباكانير

233
00:14:27,230 --> 00:14:32,070
الموت أو العبوديّة هما فقط
.ما قُدّر لكم في هذه الحياة

234
00:14:32,420 --> 00:14:35,200
.هذا ما قرّره التّاريخ لأمثالكم

235
00:14:40,060 --> 00:14:41,700
هل أنت شخص مهمّ يا سيّدي؟

236
00:14:43,700 --> 00:14:47,750
أن تولد مهمًّا في نظر العالم
...هو أمر غريب بالفعل

237
00:14:47,750 --> 00:14:52,710
ولا فائدة من أن يولد المرء من الأساس
.إن كان سيكون عبدًا منذ ولادته

238
00:14:53,610 --> 00:14:57,970
إن حصلتُ على قوّة بعد
،أكلي لهذه الفاكهة

239
00:14:58,550 --> 00:15:00,930
،فأريد أن أكون مثل نيكا

240
00:15:00,930 --> 00:15:03,570
...وأستعملها لإنقاذ أكبر عدد

241
00:15:03,840 --> 00:15:06,140
!من هؤلاء الأقلّ حظًّا

242
00:15:06,540 --> 00:15:10,030
.لذلك السّبب على أمثالكم أن يختفوا

243
00:15:13,390 --> 00:15:15,020
!انتظر يا روكس

244
00:15:15,020 --> 00:15:16,710
!ابتعد عن طريقي يا روجر

245
00:15:17,080 --> 00:15:21,160
ستختفي هذه الأحداث بين
.طيّات التّاريخ المظلم

246
00:15:21,780 --> 00:15:28,290
مملكة سوربي
الأزرق الجنوبيّ

247
00:15:23,360 --> 00:15:25,480
.أسطورة غارب البطوليّة

248
00:15:25,480 --> 00:15:28,290
!أهذا كلّ ما للأخبار أن ينشروه؟

249
00:15:28,550 --> 00:15:31,190
.ذلك بالضّبط ما يريده مَن على قمّة العالم

250
00:15:31,330 --> 00:15:34,050
.هذا الصّحفيّ مورغانز مجرّد حثالة

251
00:15:34,370 --> 00:15:38,860
في النّهاية، ما زلنا لا نعرف ماذا
.حدث على تلك الجزيرة بالفعل

252
00:15:38,960 --> 00:15:42,440
أتنوي الصّلاة طويلاً يا كوما؟

253
00:15:43,980 --> 00:15:48,100
أنا أفكّر في الأرواح الأخرى
...الّتي لم أستطع إنقاذها

254
00:15:48,290 --> 00:15:49,780
!كفّ عن ذلك

255
00:15:49,890 --> 00:15:54,480
أنقذت أكثر من خمسمائة شخص
!في خضمّ كلّ تلك الفوضى

256
00:15:54,480 --> 00:15:57,440
!إنّه محقّ يا كوماتشي! كنتَ رائعًا

257
00:15:57,440 --> 00:15:59,730
!كان الجميع يبكون دموع امتنان لك

258
00:15:59,730 --> 00:16:01,580
!بمن فيهم أنا

259
00:16:02,820 --> 00:16:03,830
...ولكن

260
00:16:04,890 --> 00:16:08,150
منحتَ أولئك الأشخاص حرّيّتهم
.بيديك هاتين

261
00:16:08,150 --> 00:16:09,830
!يداك الآن يدا تحرير

262
00:16:10,260 --> 00:16:11,790
تحرير؟

263
00:16:12,040 --> 00:16:13,130
يداي؟

264
00:16:13,540 --> 00:16:15,150
.أنت قويّ

265
00:16:15,250 --> 00:16:17,890
!عليك تحمّل كلّ شيء وتنجو

266
00:16:17,960 --> 00:16:20,010
!سيأتي محارب التّحرير

267
00:16:24,200 --> 00:16:26,810
تدير عائلتك كنيسة؟

268
00:16:26,810 --> 00:16:29,310
.هذا يفسّر الكثير بشأن شخصيّتك

269
00:16:34,980 --> 00:16:37,900
!حسنًا، أظنّني سأُبحر

270
00:16:37,900 --> 00:16:40,070
!حان الوقت للاستمتاع بحرّيّتي

271
00:16:40,390 --> 00:16:43,370
!لن أنسى وجهك أبدًا يا إيفا-تشان

272
00:16:44,800 --> 00:16:46,830
!يستحيل على أيّ أحد نسيانه

273
00:16:46,830 --> 00:16:51,830
أمّا أنا فسأظلّ هنا مع كوماتشي
!وأكتشف ماذا أفعل بمستقبلي يا أخي

274
00:16:52,100 --> 00:16:54,290
!هذه فكرة ممتازة

275
00:16:55,780 --> 00:16:58,760
!مع السّلامة يا صديقيّ

276
00:17:04,040 --> 00:17:04,970
!حسنًا

277
00:17:05,740 --> 00:17:09,730
أنا أكبر منك بأربع سنوات. لذلك من
.واجبي الحرص على إطعامك

278
00:17:12,550 --> 00:17:14,060
!لنذهب لتقطيع الحطب

279
00:17:17,540 --> 00:17:18,530
...هذا مؤلم

280
00:17:19,730 --> 00:17:21,490
هل أنت بخير يا جيني؟

281
00:17:22,900 --> 00:17:24,450
هل أقطعها بهذا فحسب؟

282
00:17:25,230 --> 00:17:26,160
!نعم

283
00:17:31,070 --> 00:17:33,420
!اقطع ذلك الحطب يا كوماتشي

284
00:17:35,240 --> 00:17:37,530
!ممتاز! لنذهب لبيعه الآن

285
00:17:37,530 --> 00:17:38,590
!حاضر

286
00:17:38,590 --> 00:17:41,650
.لننس البحث في القمامة عن الطّعام أو سرقته

287
00:17:41,750 --> 00:17:44,150
!سنشتريه بالمال الّذي نجنيه

288
00:17:44,150 --> 00:17:45,050
!أجل

289
00:17:45,340 --> 00:17:46,710
!هيّا بنا

290
00:17:46,710 --> 00:17:47,780
.نعم

291
00:17:50,420 --> 00:17:51,830
!بعنا كلّ شيء

292
00:17:51,830 --> 00:17:52,730
.نعم

293
00:17:52,930 --> 00:17:54,740
!كم أنا جائعة

294
00:17:54,830 --> 00:17:56,440
ماذا سنأكل اليوم؟

295
00:17:56,600 --> 00:17:58,760
.أيّ شيء تشتهينه

296
00:17:58,760 --> 00:17:59,900
!ممتاز

297
00:17:59,900 --> 00:18:02,070
...في تلك الحالة

298
00:18:03,090 --> 00:18:05,660
!لم ركما هنا من قبل –
.صحيح –

299
00:18:06,190 --> 00:18:08,490
أنت ضخم! كم عمرك؟

300
00:18:08,860 --> 00:18:10,410
.أنا في التّاسعة

301
00:18:10,410 --> 00:18:12,660
ماذا؟ في التّاسعة؟

302
00:18:16,410 --> 00:18:17,500
!كاذب

303
00:18:19,210 --> 00:18:20,840
!أنت وحش –
.هذا مؤلم –

304
00:18:20,840 --> 00:18:21,670
!توقّفا

305
00:18:22,660 --> 00:18:25,300
!إيّاكما ولمس كوماتشي

306
00:18:25,300 --> 00:18:26,510
!جيني

307
00:18:30,680 --> 00:18:34,810
.آسف بشأن ذلك
.إنّها لطيفة جدًّا في الحقيقة

308
00:18:40,980 --> 00:18:43,360
هل شفيت؟ –
!لم أعد أتألّم –

309
00:18:43,890 --> 00:18:45,320
أهذا سحر؟

310
00:18:45,320 --> 00:18:48,280
!أنت صانع معجزات يا كوماتشي –
!مذهل –

311
00:18:49,070 --> 00:18:54,250
!كوماتشي! كوماتشي

312
00:18:56,870 --> 00:18:57,980
.لنبدأ الأكل

313
00:18:57,980 --> 00:18:59,330
!لنبدأ الأكل

314
00:19:05,170 --> 00:19:06,410
.لم يكن ذلك كافيًا

315
00:19:06,410 --> 00:19:07,930
.تفضّلي –
أأنت واثق؟ –

316
00:19:12,630 --> 00:19:14,390
!هذا لذيذ

317
00:19:14,390 --> 00:19:17,980
.إنّك نهمة جدًّا، لذلك علينا العمل بجدّ

318
00:19:18,220 --> 00:19:19,310
!حاضرة

319
00:19:23,200 --> 00:19:26,150
كم كان عمرك عندما صرت عبدًا يا كوماتشي؟

320
00:19:29,360 --> 00:19:30,370
.أربع سنوات

321
00:19:30,570 --> 00:19:31,820
!وأنا أيضًا

322
00:19:31,820 --> 00:19:34,330
...لا شيء في ذلك يدعو للاحتفال

323
00:19:37,200 --> 00:19:39,030
!أنا شبعى

324
00:19:39,220 --> 00:19:40,800
!...أنا شبعى

325
00:19:41,490 --> 00:19:43,690
...أنا... شبعى

326
00:19:44,830 --> 00:19:45,760
جيني؟

327
00:19:48,920 --> 00:19:50,900
!كوماتشي

328
00:20:15,150 --> 00:20:16,470
!كوماتشي

329
00:20:22,610 --> 00:20:26,130
كم أنا جائعة! ماذا سنأكل؟

330
00:20:31,690 --> 00:20:34,350
.أيّ شيء تشتهينه

331
00:20:36,860 --> 00:20:38,500
...كوماتشي

332
00:20:43,720 --> 00:20:47,590
!ماذا؟ لا تبكي يا جيني

333
00:21:09,730 --> 00:21:11,310
.أنا جدّ سعيدة

334
00:21:28,230 --> 00:21:33,490
ما عدت أستطيع حماية أحد ثانية

335
00:21:33,490 --> 00:21:38,290
إنّ تلاشي الصّوت خطئي أنا

336
00:21:38,290 --> 00:21:40,580
ما عاد لديّ وقت حتّى للنّظر للأسف

337
00:21:40,580 --> 00:21:43,170
ثمّة آثار حصى على راحَتَيَّ

338
00:21:43,170 --> 00:21:46,960
ابدئي بالتّحرّك ثانية يا سفينتي

339
00:21:46,960 --> 00:21:52,050
مع أنّي لا أستطيع الطّيران في السّماء الواسعة

340
00:21:52,050 --> 00:21:58,100
بإمكاني إضاءة البحر العميق

341
00:21:58,100 --> 00:21:58,890
نحن

342
00:21:58,890 --> 00:22:01,390
ودائمًا، لا يمكننا السّماح أن تكون هذه النّهاية

343
00:22:01,390 --> 00:22:04,020
ودائمًا، لا يمكننا أن نُهزم

344
00:22:04,020 --> 00:22:07,810
لدينا شيء ما هنا لحمايته

345
00:22:07,810 --> 00:22:10,320
قد لا يكون هذا ما توقّعتُه

346
00:22:10,320 --> 00:22:13,030
لكن لا يمكننا أن نتوقّف هنا

347
00:22:13,030 --> 00:22:18,370
سننطلق الآن ونتشارك الوحدة

348
00:22:18,370 --> 00:22:21,080
لا داعي للخوف

349
00:22:21,080 --> 00:22:25,040
لستُ نفس الشّخص الّذي كنتُه يومها

350
00:22:25,040 --> 00:22:28,920
لا يستطيع أحد الوقوف في طريقي

351
00:22:28,920 --> 00:22:30,130
والآن، ابتعدوا

352
00:22:30,130 --> 00:22:32,780
اغزُ العالم، آمن بالمستقبل

353
00:22:32,780 --> 00:22:35,320
عدّ اللّيالي

354
00:22:35,320 --> 00:22:38,030
ماذا رأيت؟ ماذا تعلّمت؟

355
00:22:38,030 --> 00:22:41,530
لإدراك ما هو مهمّ

356
00:22:50,290 --> 00:22:54,910
يعيش كوما وجيني حياة سعيدة
.واضعين ماضيهما كعبدين خلفهما

357
00:22:54,910 --> 00:22:59,490
لكن من جهة أخرى، يدوس ملك
.قاسٍ على سعادة رعاياه

358
00:22:59,490 --> 00:23:03,320
،ينطلق بطلانا في مواجهة الحكومة
.ويقاتلان من أجل الحرّيّة

359
00:23:03,320 --> 00:23:06,830
هل تستطيع مشاعرهما تغيير العالم؟

360
00:23:06,940 --> 00:23:08,380
:في الحلقة القادمة من وان بيس

361
00:23:08,380 --> 00:23:11,710
"!لمحات سعادة عابرة! كوماتشي وجيني"

362
00:23:11,710 --> 00:23:14,130
!ملك القراصنة، لن يكون إلاّ أنا