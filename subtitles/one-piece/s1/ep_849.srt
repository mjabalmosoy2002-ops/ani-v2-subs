1
00:00:03,010 --> 00:00:06,520
قلبي يخفق عند التّفكير بك

2
00:00:06,560 --> 00:00:09,940
قوّة لا حصر لها تندفع

3
00:00:09,980 --> 00:00:15,730
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

4
00:00:15,780 --> 00:00:17,320
نحن الأمل

5
00:00:23,370 --> 00:00:30,210
فرحتنا لتطاير مشاعرنا الصّادقة بيننا

6
00:00:30,250 --> 00:00:37,460
ألمنا عندما ضحكنا لنواسي حزننا

7
00:00:37,510 --> 00:00:44,350
نصل بينها في مهبّ الرّياح آه

8
00:00:44,390 --> 00:00:51,100
إنّه يرفرف أعلى فأعلى

9
00:00:51,140 --> 00:00:54,270
لمَ تخلّيت عن بحثتك؟

10
00:00:54,310 --> 00:00:57,690
ولمَ تواصل القتال لوحدك؟

11
00:00:57,730 --> 00:01:00,570
أخبرني، أيّ مستقبل أعددت له؟

12
00:01:00,610 --> 00:01:04,120
هل حقّقت حلمك؟

13
00:01:04,530 --> 00:01:08,040
قلبي يخفق عند التّفكير بك

14
00:01:08,080 --> 00:01:11,790
قوّة لا حصر لها تندفع

15
00:01:11,830 --> 00:01:17,340
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

16
00:01:17,380 --> 00:01:18,550
نحن الأمل

17
00:01:18,750 --> 00:01:22,130
عند نهاية العالم الواسعة والزٍّرقاء

18
00:01:22,170 --> 00:01:24,680
هناك مكان أريد أن أذهب إليه معك

19
00:01:24,720 --> 00:01:27,470
طريق البحر الّذي نسلك

20
00:01:27,510 --> 00:01:34,230
قُرّر قبل وقت طويل

21
00:01:44,910 --> 00:01:48,410
صوتك الّذي لم يصل لي بعد

22
00:01:48,450 --> 00:01:52,040
يسحق قلبي العاجز

23
00:01:52,080 --> 00:01:55,290
أريدك

24
00:01:55,330 --> 00:02:00,130
لذا سأجدّد الثّقة في الصّباح عندما يأتي النّور

25
00:02:00,170 --> 00:02:03,970
أغمض عينيك وأنصت جيّدًا

26
00:02:04,010 --> 00:02:07,470
ولنبحث عن إجابتك

27
00:02:07,510 --> 00:02:13,270
طريق البحر الّذي لم تره أبدًا يستمرّ دائمًا

28
00:02:13,310 --> 00:02:14,310
نحن الأمل

29
00:02:14,480 --> 00:02:17,860
عند نهاية العالم الواسعة والزٍّرقاء

30
00:02:17,900 --> 00:02:20,360
هناك مكان أريد أن أذهب إليه معك

31
00:02:20,400 --> 00:02:23,150
سنكون أبد الدّهر

32
00:02:23,190 --> 00:02:30,330
قُرّر قبل وقت طويل

33
00:02:34,080 --> 00:02:36,650
،بعد فشلهم في قتل بيغ مام

34
00:02:36,650 --> 00:02:39,590
هرب لوفي والبقيّة من قصر الكعكة الكاملة

35
00:02:39,590 --> 00:02:42,920
.ويواصلون الاتّجاه صوب ساني

36
00:02:43,670 --> 00:02:47,110
.تطاردهم بيغ مام أثناء نوبة جوعها

37
00:02:47,130 --> 00:02:49,700
!إنّه السّاحل! صلوا إلى السّاني

38
00:02:50,010 --> 00:02:52,910
في نفس الأثناء، من أجل استعادة السّاني

39
00:02:52,910 --> 00:02:54,830
،الّتي قبض عليها قراصنة بيغ مام

40
00:02:55,060 --> 00:02:57,650
.يواصل بروك وتشوبّر معركةً محفوفة بالمخاطر

41
00:02:58,440 --> 00:03:03,770
.لكنّ بيروسبيرو غلّفهما بالحلوى بواسطة قدرته

42
00:03:05,030 --> 00:03:08,380
أخيرًا، بينما يقترب لوفي والبقيّة الّذين اجتازوا

43
00:03:08,380 --> 00:03:10,600
...غابة الإغواء من السّاني

44
00:03:13,120 --> 00:03:15,560
...تزيين

45
00:03:15,750 --> 00:03:17,550
!عذراء الحلوى

46
00:03:21,290 --> 00:03:25,570
"!قُبيل الفجر! بيدرو، قائد الحرّاس"

47
00:03:27,050 --> 00:03:28,990
!لا يستطيع أيّ أحد العبور من هنا

48
00:03:28,990 --> 00:03:30,820
!التفّوا وصلوا إلى السّفينة

49
00:03:30,850 --> 00:03:33,020
!لا، بل انطلقوا مباشرةً

50
00:03:37,230 --> 00:03:39,620
...فاكهة المطّاط

51
00:03:43,570 --> 00:03:46,010
!الصّقر الأحمر

52
00:03:54,740 --> 00:03:56,100
!أهو لهب؟

53
00:04:36,040 --> 00:04:37,970
!بيدرو

54
00:04:38,450 --> 00:04:42,920
!سيبزغ فجر العالم عمّا قريب

55
00:05:10,070 --> 00:05:12,970
!قدرته-تيا تشبه قدرة لوفي

56
00:05:37,070 --> 00:05:39,580
...كعك

57
00:05:41,350 --> 00:05:45,000
!الزّفاف

58
00:05:49,610 --> 00:05:50,760
!ها هي ذي

59
00:05:54,780 --> 00:05:57,390
!ما العمل يا لوفي؟! نحن محاصرون

60
00:06:02,810 --> 00:06:05,760
!لوفي! اطرد كاتاكوري من السّفينة

61
00:06:05,760 --> 00:06:07,900
!سنحاول الإبحار بطريقة ما

62
00:06:07,900 --> 00:06:09,400
!مفهوم

63
00:06:09,420 --> 00:06:10,710
!من هنا

64
00:06:10,710 --> 00:06:11,710
!حسنًا

65
00:06:14,510 --> 00:06:17,570
!ذلك الوغد! لا بدّ أنّه عبر من بُعد المرآة

66
00:06:23,730 --> 00:06:28,640
.اسمع! لكلٍّ دوره

67
00:06:34,110 --> 00:06:40,030
!كعك الزّفاف

68
00:06:40,780 --> 00:06:44,880
.لا أريد التورّط مع ماما أثناء نوبة جوعها

69
00:06:44,880 --> 00:06:46,200
.لعق

70
00:06:47,460 --> 00:06:49,860
!تصليب التسلّح

71
00:06:51,910 --> 00:06:54,630
...فاكهة المطّاط

72
00:06:56,680 --> 00:06:59,890
!رشّاش الصّقر

73
00:07:12,780 --> 00:07:15,510
...لماذا؟! أستخدم الهاكي لكن لا أستطيع إصابته

74
00:07:46,480 --> 00:07:49,040
!تشوبّر! بروك! هل أنتما بخير؟

75
00:07:49,040 --> 00:07:50,210
!تماسكا

76
00:07:58,610 --> 00:08:01,590
أين هو؟

77
00:08:01,590 --> 00:08:04,010
!الكعك

78
00:08:09,160 --> 00:08:10,140
.كاروت

79
00:08:11,970 --> 00:08:13,770
.لا تُصدمي بغير المتوقّع

80
00:08:13,770 --> 00:08:14,690
ماذا؟

81
00:08:15,630 --> 00:08:17,190
...أظنّ

82
00:08:17,880 --> 00:08:19,320
...أنّ لوفي وطاقمه

83
00:08:20,050 --> 00:08:21,940
من كانت تنتظره

84
00:08:21,940 --> 00:08:25,650
...عشيرتها وعائلة كوزكي لقرون

85
00:08:25,650 --> 00:08:29,540
!من سيقودون العالم إلى الفجر الجديد

86
00:08:29,540 --> 00:08:31,000
!لقرون؟

87
00:08:42,870 --> 00:08:45,970
يا موندور، هل تسمعني؟

88
00:08:45,970 --> 00:08:48,240
.نعم، أسمعك

89
00:08:48,240 --> 00:08:53,730
حاصروا السّاحل الجنوب الشّرقيّ
.لجزيرة الكعكة الكاملة بالسّفن الحربيّة

90
00:08:53,990 --> 00:08:56,400
.عُلم يا أخي بيروس

91
00:08:56,400 --> 00:08:57,650
.إغلاق

92
00:08:57,650 --> 00:09:00,550
محاصرة السّاحل-سوار؟

93
00:09:01,020 --> 00:09:03,910
.أظنّ أنّ قبّعة القشّ والبقيّة ما زالوا أحياء

94
00:09:03,910 --> 00:09:05,270
!ماذا؟

95
00:09:05,270 --> 00:09:11,370
كانت ماما تلاحقهم على اليابسة
،وكاتاكوري-ساما ينتظر في السّفينة

96
00:09:11,370 --> 00:09:13,250
لكن هل ما زالوا أحياء-بون؟

97
00:09:13,250 --> 00:09:15,830
.أجل، إنّهم مثابرون جدًّا

98
00:09:16,260 --> 00:09:19,300
!جزيرة كعك البندق، أجيبوا

99
00:09:19,860 --> 00:09:22,430
.هذه أماندو من جزيرة البندق

100
00:09:22,430 --> 00:09:24,710
.حاصروا السّاحل الجنوب الغربيّ

101
00:09:25,100 --> 00:09:28,430
!لا تدعوا قبّعة القشّ ومن معه أن يهربوا بأيّ ثمن

102
00:09:28,430 --> 00:09:30,100
.عُلم

103
00:09:34,880 --> 00:09:36,720
...اندفاع

104
00:09:36,720 --> 00:09:38,020
ماذا؟

105
00:09:38,020 --> 00:09:42,390
اندفاع الريح! يمكن لهذه السفينة
!القفز على مدى كيلومتر إلى الأمام

106
00:09:42,390 --> 00:09:46,450
،إن حاولنا الإبحار بشكل طبيعي
!ستُغرف السفينة على يد بيغ مام

107
00:09:46,450 --> 00:09:49,950
لم أفهم بالضبط لكن يمكننا الهرب بتلك الطريقة، صحيح؟

108
00:09:49,950 --> 00:09:50,910
!أجل

109
00:09:50,910 --> 00:09:54,040
!حسنًا! لنراهن عليه

110
00:09:55,560 --> 00:09:57,750
!بيغ مام قادمة

111
00:10:01,240 --> 00:10:04,010
!وجدتكم

112
00:10:04,700 --> 00:10:07,700
!كاروت! اذهبي-غارا لمساعدتهم على الإبحار

113
00:10:07,700 --> 00:10:09,510
ماذا؟ -
!أسرعي -

114
00:10:09,510 --> 00:10:10,660
!حسنًا

115
00:10:15,960 --> 00:10:19,010
أهو هناك؟

116
00:10:19,010 --> 00:10:22,360
!كعك الزفاف؟

117
00:10:27,890 --> 00:10:32,070
!بروك، تشوبّر! اصمدا

118
00:10:32,070 --> 00:10:36,290
،حتّى إن تمكنّا من الخروج من هنا
...لا فائدة إن متّم في الأخير

119
00:10:38,830 --> 00:10:42,340
!رأينا طاقم قبّعة القشّ في الساحل الجنوب الغربي

120
00:10:42,670 --> 00:10:46,190
...هذه الوزيرة أماندو من جزيرة المكسّرات

121
00:10:46,190 --> 00:10:47,970
.سنحاصر قبّعة القشّ والبقية

122
00:10:56,710 --> 00:10:58,400
.الوضع فظيع

123
00:10:58,400 --> 00:11:01,930
.سفن حربية قادمة من البحر وبيغ مام من اليابسة

124
00:11:01,930 --> 00:11:04,530
!نحن عالقون في الوسط تمامًا

125
00:11:12,100 --> 00:11:14,740
!نامي! علينا التقدّم

126
00:11:14,730 --> 00:11:18,880
!أعلم! لكن عليّ شحن برميلين آخرين من الكولا

127
00:11:18,880 --> 00:11:22,750
!سأهتم بالباقي فاذهبي وجهّزي لاندفاع لا أعرف ماذا

128
00:11:23,000 --> 00:11:25,070
!حسنًا، سأترك الأمر لك إذًا

129
00:11:42,670 --> 00:11:45,740
!موجة الحلوى

130
00:11:55,970 --> 00:11:57,290
!ما كان ذلك؟

131
00:11:58,640 --> 00:11:59,910
!حلوى؟

132
00:11:59,910 --> 00:12:03,500
!لا! لا يمكننا استخدام اندفاع الريح هكذا

133
00:12:12,650 --> 00:12:13,720
!ما الخطب؟

134
00:12:14,040 --> 00:12:17,400
!الأمر جاد! الساني غو عالقة في الحلوى

135
00:12:17,390 --> 00:12:18,270
!ماذا؟

136
00:12:22,250 --> 00:12:25,810
!هل رأيتم قوة موجة الحلوى؟

137
00:12:25,810 --> 00:12:28,570
!أنا متوخّي الكمال

138
00:12:28,570 --> 00:12:30,320
!ها هو

139
00:12:32,840 --> 00:12:34,490
ما العمل؟

140
00:12:34,490 --> 00:12:38,410
!أعد بروك وتشوبّر إلى جانب السّفينة يا وغد الحلوى

141
00:12:40,950 --> 00:12:42,290
...إلم نفعل شيئًا

142
00:12:42,290 --> 00:12:45,460
!كعك

143
00:12:45,460 --> 00:12:48,170
...إمّا أن تُدّمركم ماما

144
00:12:48,160 --> 00:12:51,910
!أو تغرقكم المدافع

145
00:13:04,880 --> 00:13:10,570
!لا أمل لكم في النجاة على كي حال

146
00:13:59,240 --> 00:14:01,930
!سيف الوحش، كاراجيشي

147
00:14:11,900 --> 00:14:16,080
أنت، هل تعرف كم تبلغ المكافأة على رأسي؟

148
00:14:16,080 --> 00:14:17,720
.إنها 700 مليون

149
00:14:19,240 --> 00:14:23,380
!لستُ ممّن قد يُهزم على يد ضعيف مثلك

150
00:14:23,380 --> 00:14:24,810
!لعق

151
00:14:25,460 --> 00:14:28,940
...سيكون هذا آخر كلام بيننا

152
00:14:42,890 --> 00:14:46,690
.هربت من الموت. لعق

153
00:14:48,150 --> 00:14:53,000
!لا مغزى من الموت هنا! فجر العالم الجديد قادم

154
00:14:53,000 --> 00:14:55,220
!عليّ أن أعود

155
00:14:57,830 --> 00:15:00,090
.كم أنت وسيم

156
00:15:00,090 --> 00:15:03,130
.سأخفّفها إلى 50 سنة

157
00:15:03,130 --> 00:15:05,230
.تابع حياتك

158
00:15:06,750 --> 00:15:08,220
،في ذلك الوقت

159
00:15:08,220 --> 00:15:13,780
...لولا أنّك ضحّيتَ بعينك اليسرى، لقُتلت بالتأكيد

160
00:15:15,340 --> 00:15:18,180
هل كنتَ مستميتًا إلى ذلك الحدّ للنّجاة؟

161
00:15:19,830 --> 00:15:21,440
...حسنًا

162
00:15:21,440 --> 00:15:23,970
كم عمرك الآن؟

163
00:15:24,390 --> 00:15:25,910
...27

164
00:15:25,910 --> 00:15:32,550
،استُنزفت 50 سنة من عمرك
.وكأنك عشت 77 سنة بالفعل

165
00:15:34,370 --> 00:15:38,010
...والآن، أتساءل كم سنة تتوقع أن تعيش

166
00:15:39,570 --> 00:15:42,890
.أريد أن أختار أين أموت بنفسي على الأقل

167
00:15:44,660 --> 00:15:46,340
،بالمناسبة

168
00:15:46,340 --> 00:15:50,260
...كنتَ قائد قراصنة نوكس

169
00:15:50,260 --> 00:15:54,270
نوكس" تعني "ليل"، أليس كذلك؟"

170
00:15:54,270 --> 00:15:56,570
.يبعث بإيحاء سلبيّ للغاية

171
00:15:57,110 --> 00:15:59,410
".يقال، "بعد كل ليل، يأتي فجر جديد

172
00:16:00,550 --> 00:16:01,750
...و

173
00:16:02,890 --> 00:16:05,650
...نوكس" لها نفس معنى"

174
00:16:07,140 --> 00:16:09,060
..."قُبيل الفجر"...

175
00:16:10,650 --> 00:16:12,260
إن كان بإمكاني أن أكون حجر الأساس

176
00:16:12,260 --> 00:16:15,250
،لفجر جديد للعالم الذي يتطلع إليه السيد والبقيّة

177
00:16:15,250 --> 00:16:16,630
.فهذا ما أرغبه أكثر من أي شيء

178
00:16:18,070 --> 00:16:20,750
...أظنني أملك وقتًا كافيًا من أجل ذلك

179
00:16:24,740 --> 00:16:31,340
...قلتَ ذات مرّة أنّ "قُبيل الفجر" و"نوكس" لهما نفس المعنى

180
00:16:31,340 --> 00:16:37,860
لكن الشيء الوحيد الذي ينتظرك
.هو الظلام السّرمديّ المسمّى بالموت

181
00:16:37,860 --> 00:16:38,740
...لا

182
00:16:56,780 --> 00:17:00,300
!إنها آتية! اجتمعوا

183
00:17:29,640 --> 00:17:33,790
!إذًا تلك هي سفينة قراصنة روجر... الأورو جاكسون

184
00:17:54,620 --> 00:17:58,270
!روجر! أودن-ساما! اصطحباني معكما

185
00:18:04,840 --> 00:18:08,310
!سأفعل أيّ شيء! خذاني معكما

186
00:18:10,560 --> 00:18:14,000
.يا فتى، ما زال عليك الانتظار

187
00:18:14,000 --> 00:18:16,960
!لستُ بفتى، أنا بيدرو

188
00:18:22,610 --> 00:18:25,630
.وقتي محدود

189
00:18:25,630 --> 00:18:30,640
.اسمع! لكلٍّ دوره

190
00:18:32,660 --> 00:18:34,760
!تحلّ بالصّبر وانتظر

191
00:18:34,760 --> 00:18:40,050
...سيحين بشكل طبيعيّ. أقصد، دورك

192
00:18:41,500 --> 00:18:44,300
.وداعًا يا بيدرو

193
00:18:45,970 --> 00:18:48,620
!حسنًا يا روجر

194
00:18:58,940 --> 00:19:00,440
!بيدرو

195
00:19:01,190 --> 00:19:02,420
...روجر

196
00:19:02,730 --> 00:19:04,340
ماذا عنه؟

197
00:19:08,200 --> 00:19:09,640
!قالوا أنّه مات

198
00:19:11,370 --> 00:19:12,710
!لا بدّ أنّك تمزحين

199
00:19:12,710 --> 00:19:16,350
!لن يموت! إنّه ملك القراصنة

200
00:19:17,210 --> 00:19:18,850
!لستُ أمزح

201
00:19:18,850 --> 00:19:23,090
قُبض عليه من قبل البحريّة وفي
...ساحة إعدام في الأزرق الشّرقيّ

202
00:19:45,320 --> 00:19:47,480
كنزي؟

203
00:19:47,920 --> 00:19:50,390
!سأعطيكم إيّاه إن أردتموه

204
00:19:50,620 --> 00:19:52,300
!جدوه

205
00:19:52,300 --> 00:19:55,520
!تركت كل ما هو موجود في هذا العالم فيه

206
00:20:07,420 --> 00:20:13,480
.هذه البداية. عصر جديد يلوح أخيرًا في الأفق

207
00:20:32,280 --> 00:20:37,340
.سوف تحمل أمواج الزمن الأمنيات
...وتبحر بها عبر أحلام الشعوب

208
00:20:37,340 --> 00:20:40,800
.لا رادع لها

209
00:20:42,160 --> 00:20:45,270
،ما دام النّاس يبحثون عن معنى الحرّيّة

210
00:20:45,270 --> 00:20:48,990
.ستعيش تلك الأشياء أبد الدّهر

211
00:20:55,220 --> 00:20:56,660
...روجر

212
00:21:00,600 --> 00:21:01,870
.قرّرت

213
00:21:06,360 --> 00:21:09,210
!سوف... أبحر أيضًا

214
00:21:12,340 --> 00:21:17,800
...حتّى إن أنكرت، لم ترَ الفجر

215
00:21:17,800 --> 00:21:19,060
.لعق

216
00:21:19,410 --> 00:21:21,440
هل تظنّ... ذلك؟

217
00:21:22,870 --> 00:21:27,940
"!قال روجر، "لكُلٍّ دوره

218
00:21:28,250 --> 00:21:29,940
عمّاذا تتحدّث؟

219
00:21:29,940 --> 00:21:31,780
!هذا دوري

220
00:21:34,720 --> 00:21:38,240
سيكسر هذا كلّ تعاويذك السحريّة-غارا، صحيح؟

221
00:21:39,020 --> 00:21:40,150
!قنابل؟

222
00:21:40,150 --> 00:21:43,940
!توقّف أيها الأحمق! فيمَ تُفكّر؟

223
00:21:44,440 --> 00:21:46,130
!دعني

224
00:21:50,820 --> 00:21:52,110
...أنا

225
00:21:53,280 --> 00:21:56,260
.ساورني شعور أنّ هذه ستكون رحلتي الأخيرة

226
00:21:56,260 --> 00:21:58,370
ماذا تقصد يا بيدرو؟

227
00:22:04,680 --> 00:22:05,850
!بيدرو؟

228
00:22:06,460 --> 00:22:07,690
.الوداع

229
00:22:37,280 --> 00:22:39,310
ماذا تقصد يا بيدرو؟

230
00:22:39,780 --> 00:22:43,230
...يومًا ما، ستعرفين مدى أهمّيّة

231
00:22:43,750 --> 00:22:48,540
!إنقاذ لوفي والبقيّة هنا وتركهم يبحرون

232
00:22:52,550 --> 00:22:55,240
!بيدرو

233
00:22:56,430 --> 00:22:57,980
!اسمعوا

234
00:22:57,980 --> 00:23:01,080
!عليكم-غارا أن تمضوا قُدمًا

235
00:23:10,360 --> 00:23:13,510
!مهّد بيدرو الطّريق إلى بصيص أمل للهروب

236
00:23:13,960 --> 00:23:16,220
،لكن، لسحق بصيص الأمل ذاك

237
00:23:16,220 --> 00:23:19,800
!هاجمت بيغ مام وكاتاكوري الساني بلا شفقة

238
00:23:19,960 --> 00:23:22,090
!هناك سبيل واحد فقط للنجاة

239
00:23:22,090 --> 00:23:26,890
،حاملًا معه أمنيات بيديرو
!يقوم لوفي بمخاطرة كبيرة بعزيمة

240
00:23:26,890 --> 00:23:31,720
:في الحلقة القادمة من وان بيس
"!سأعود! لوفي، مغادرة قاتلة"

241
00:23:31,720 --> 00:23:34,190
!ملك القراصنة، لن يكون إلّا أنا