1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,880 --> 00:02:05,360
بعد انضمام أودن، وصل قراصنة اللّحية البيضاء
.إلى جزيرة تصادف وجود قراصنة روجر عليها

29
00:02:06,010 --> 00:02:07,320
!أيّها القبطان

30
00:02:07,770 --> 00:02:10,740
سفينة اللّحية البيضاء
!في الجانب الآخر من الجزيرة

31
00:02:10,740 --> 00:02:13,310
!يبدو أنّهم لاحظوا وجودنا

32
00:02:13,310 --> 00:02:16,540
.انتهينا من القتال للتّوّ يا روجر

33
00:02:17,280 --> 00:02:20,550
.اللّحية البيضاء؟ لم أره منذ مدّة

34
00:02:24,950 --> 00:02:28,300
!تبدو الطّيور مضطربة... لا بدّ أنّهم رسوا

35
00:02:28,720 --> 00:02:30,180
!حسنًا

36
00:02:30,180 --> 00:02:35,080
لنقم بهذا! نكون قادرين على
!القتال فقط ما دمنا أحياء

37
00:02:36,590 --> 00:02:39,270
!نهايتي قريبة

38
00:02:39,270 --> 00:02:44,490
!قد تكون هذه آخر مرّة أراك فيها أيّها اللّحية البيضاء

39
00:02:49,740 --> 00:02:52,540
!غان مودوكي

40
00:03:04,320 --> 00:03:08,830
.إنّه قويّ كما قيل عنه
هل نوقفه يا ريلي؟

41
00:03:08,830 --> 00:03:09,870
!بالتّأكيد

42
00:03:09,870 --> 00:03:12,740
!انتظرا يا غابان وريلي

43
00:03:12,740 --> 00:03:15,480
!لا أريدكما أن تتأذّيا

44
00:03:17,420 --> 00:03:19,100
.تريد قتاله فحسب

45
00:03:22,470 --> 00:03:24,480
!أشتمّ رائحة وحش

46
00:03:25,610 --> 00:03:27,360
!أيّها السّاموراي

47
00:03:28,720 --> 00:03:30,740
!الهلاك المقدّس

48
00:03:53,220 --> 00:03:55,470
!ما كان ذلك؟

49
00:03:59,540 --> 00:04:00,900
!ها هو قادم

50
00:04:18,400 --> 00:04:22,040
"!أمنية روجر! رحلة جديدة"

51
00:05:11,780 --> 00:05:13,840
...تبدو في حال جيّدة

52
00:05:14,140 --> 00:05:15,950
!يا روجر

53
00:05:15,950 --> 00:05:18,600
...كم مرّ من وقت

54
00:05:19,060 --> 00:05:21,490
!يا نيوغيت؟

55
00:05:32,510 --> 00:05:33,450
ماركو

56
00:05:33,450 --> 00:05:34,360
فيستا

57
00:05:34,360 --> 00:05:35,320
جوزو

58
00:05:35,320 --> 00:05:36,240
أندري

59
00:05:36,240 --> 00:05:37,200
راكويو

60
00:05:37,200 --> 00:05:38,120
فوسا

61
00:05:38,120 --> 00:05:39,080
وايتي بي

62
00:05:39,080 --> 00:05:39,990
تيتش

63
00:05:42,620 --> 00:05:43,580
ريلي

64
00:05:43,580 --> 00:05:44,500
غابان

65
00:05:44,500 --> 00:05:45,460
نوزودون

66
00:05:45,460 --> 00:05:46,380
سانبل

67
00:05:46,380 --> 00:05:47,340
شانكس

68
00:05:46,380 --> 00:05:47,340
باغي

69
00:06:03,630 --> 00:06:05,850
!سلّم كلّ ما لديك

70
00:06:05,850 --> 00:06:07,190
!نالوا منهم

71
00:06:08,380 --> 00:06:09,610
!انهبوهم

72
00:06:10,900 --> 00:06:13,820
!تصادم اثنان من أعظم أطقم القراصنة

73
00:06:20,440 --> 00:06:23,750
.قراصنة روجر ضدّ قراصنة اللّحية البيضاء

74
00:06:23,750 --> 00:06:27,790
.دامت المعركة المفعمة بالتّوتّر لثلاثة أيّام بلياليها

75
00:06:30,240 --> 00:06:32,300
!لا تختبر صبري

76
00:06:34,780 --> 00:06:37,800
.أنا جادّ دائمًا

77
00:06:37,800 --> 00:06:38,640
.أيّها الشّابّ

78
00:07:26,080 --> 00:07:28,540
!إذًا ثلاثة صناديق من اللّحم المجفّف مقابل برميل؟

79
00:07:28,540 --> 00:07:29,630
!موافق

80
00:07:29,630 --> 00:07:32,630
!أعجبني هذا القميص! من أين حصلت عليه؟

81
00:07:32,630 --> 00:07:34,320
!أعطني المزيد

82
00:07:34,320 --> 00:07:35,990
!مهلاً! أخذت الكثير

83
00:07:35,990 --> 00:07:39,090
!إنّها مقايضة متساوية

84
00:07:39,090 --> 00:07:40,560
.آسف

85
00:07:40,560 --> 00:07:42,980
لديك شيء ما أيضًا، صحيح؟

86
00:07:42,980 --> 00:07:43,870
!نعم

87
00:07:44,390 --> 00:07:48,760
،كنّا نحاول نهب بعضنا البعض
...لكنّنا نتبادل الهدايا الآن

88
00:07:51,980 --> 00:07:54,690
هل هما متدرّبين؟

89
00:07:56,990 --> 00:07:59,940
...بالتّفكير في الأمر، لطالما كانا معنا

90
00:08:00,120 --> 00:08:02,990
.لا يبدوان قويّين

91
00:08:03,540 --> 00:08:05,140
...لكنّهما يحسنان التّصرّف

92
00:08:05,500 --> 00:08:07,910
.كمخضرمين

93
00:08:08,290 --> 00:08:10,850
!يا شانكس

94
00:08:11,210 --> 00:08:12,830
ماذا؟

95
00:08:12,830 --> 00:08:17,510
أترى صاحب القبّعة هناك؟

96
00:08:17,510 --> 00:08:18,490
.نعم

97
00:08:18,720 --> 00:08:23,870
سمعتُ أنّه لم ينم في الأمس ولا اليوم
!الّذي قبله خلال ليلة وقف إطلاق النّار

98
00:08:24,770 --> 00:08:27,520
!لماذا؟ هل أراد التّفاخر؟

99
00:08:27,520 --> 00:08:28,700
!كلاّ

100
00:08:28,700 --> 00:08:32,730
!يقولون أنّه لم ينم ولو مرّة واحدة مذ أن وُلد

101
00:08:32,730 --> 00:08:35,500
ماذا؟ أهنالك شخص هكذا؟

102
00:08:35,500 --> 00:08:39,410
هذا ممتاز. أتساءل إن كان يستمتع
!بالحياة بضعف ما نستمتع بها نحن

103
00:08:39,410 --> 00:08:43,010
!غبيّ! الأمر ليس بتلك البساطة

104
00:08:43,010 --> 00:08:45,220
!لا بدّ أنّه وحش

105
00:08:45,220 --> 00:08:46,600
وحش؟

106
00:08:48,710 --> 00:08:52,980
!يا أودن! أيمكنك قراءتها فعلاً؟

107
00:08:54,050 --> 00:08:55,650
.نعم، يمكنني

108
00:08:55,650 --> 00:08:59,720
!أستطيع قراءتها، لكن لماذا تمتلك هذه الكتابة؟

109
00:08:59,720 --> 00:09:06,380
نُقلت المعرفة بهذا النّصّ من الأب إلى ابن
.واحد فقط في كلّ جيل في عشيرة كوزكي

110
00:09:15,610 --> 00:09:18,050
...مضت 13 سنة بالفعل

111
00:09:20,280 --> 00:09:25,430
،وصلنا أخيرًا إلى جزيرة لودستار
،آخر جزيرة تشير إليها البوصلة المسجِّلة

112
00:09:22,400 --> 00:09:23,000
الرّيد لاين

113
00:09:25,430 --> 00:09:28,850
.والّتي لم تطأها قدم إنسان من قبل

114
00:09:29,330 --> 00:09:33,310
...لكنّنا لاحظنا عندما رسونا فيها وكلّنا فرح

115
00:09:33,310 --> 00:09:36,750
!أنّها لم تكن الجزيرة الأخيرة

116
00:09:36,960 --> 00:09:42,110
استمرّت الإبر في البوصلة المسجِّلة
!بالدّوران ولم تُشر إلى أيّ مكان

117
00:09:42,110 --> 00:09:44,610
.واقتنعتُ حينها

118
00:09:44,610 --> 00:09:47,070
!كان هنالك جزيرة أخرى

119
00:09:47,070 --> 00:09:53,960
وعندما أبلغُها، سأكون أوّل شخص
!يبحر حول العالم على الإطلاق

120
00:10:02,030 --> 00:10:08,570
لكنّ حكومة العالم لطالما منعت
.أيّ أحد من محاول فكّ رموزها

121
00:10:08,570 --> 00:10:12,270
.إنّها تُسمّى البونيغليف

122
00:10:12,270 --> 00:10:15,390
،ظننتُ أنّها كانت مجرّد آثار ثقافيّة

123
00:10:23,840 --> 00:10:30,090
تحاول الحكومة منعنا من الذّهاب للجزيرة
!الأخيرة الّتي قد تحمل كمّيّة هائلة من الكنوز

124
00:10:30,200 --> 00:10:33,090
!وهذا يجعلها محيّرة أكثر

125
00:10:33,090 --> 00:10:37,120
،إن استطعنا الوصول إلى هناك
...فسنكون بالقول والفعل

126
00:10:37,120 --> 00:10:40,850
!أعظم طاقم قراصنة في العالم

127
00:10:45,830 --> 00:10:47,470
!الأعظم في العالم؟

128
00:10:52,420 --> 00:10:55,060
!لا بدّ أنّك متفاجئ يا نيوغيت

129
00:10:55,540 --> 00:10:59,750
...هذا صحيح! إذًا سوف

130
00:11:19,320 --> 00:11:24,690
.لم أستطع الحركة
.اندهشت للمرّة الثّانية هذا اليوم

131
00:11:24,950 --> 00:11:27,470
!ما قصّة هذا الرّجل؟

132
00:11:36,330 --> 00:11:40,810
!عمّ تتحدّث يا روجر؟! هذه أحلام أطفال

133
00:11:47,260 --> 00:11:50,200
!أنا جادّ يا نيوغيت

134
00:11:50,770 --> 00:11:52,220
!أرجوك

135
00:11:53,430 --> 00:11:57,580
!أعرني أودن لسنة واحدة فقط

136
00:11:57,580 --> 00:11:59,670
!إنّه طلب يُطلب مرّة في العمر

137
00:11:59,670 --> 00:12:03,540
بمساعدته، أنا واثق من تمكّني
!من بلوغ الجزيرة الأخيرة

138
00:12:04,950 --> 00:12:07,920
!مهلاً، لا تكن أنانيًّا

139
00:12:08,780 --> 00:12:11,550
!أرجوك يا نيوغيت

140
00:12:13,080 --> 00:12:14,760
!أنا أتوسّل إليك

141
00:12:14,760 --> 00:12:18,770
!توقّف أيّها القبطان روجر! إنّه عدوّنا

142
00:12:21,460 --> 00:12:26,040
!يكفي! هذا مثير للشّفقة
!لا تطأطئ رأسك

143
00:12:26,040 --> 00:12:28,170
!أرجوك يا أدون

144
00:12:28,340 --> 00:12:32,200
!رافقنا في رحلتنا لسنة واحدة

145
00:12:33,640 --> 00:12:35,790
!تبًّا لك

146
00:12:38,690 --> 00:12:42,630
روجر! هل تحاول أخذ عضو
!من عائلتي بعيدًا عنّي؟

147
00:12:43,070 --> 00:12:46,090
!لكن لم يسعني إلاّ الشّعور بالحماس

148
00:12:46,860 --> 00:12:50,300
لماذا تستطيع عشيرة كوزكي قراءة النّصّ؟

149
00:12:51,240 --> 00:12:54,430
هل قابلته الآن لسبب وجيه؟

150
00:13:01,920 --> 00:13:06,570
!وقبل أن أدري، خرجت الكلمات من فمي

151
00:13:07,300 --> 00:13:09,070
!أيّها اللّحية-كيتشي-تشان

152
00:13:09,070 --> 00:13:11,090
!أريد الذّهاب

153
00:13:11,090 --> 00:13:13,570
!اسمح لي بالذّهاب أرجوك

154
00:13:13,570 --> 00:13:17,580
!أريد رؤية الجزيرة الأخيرة الّتي تحدّث عنها

155
00:13:21,400 --> 00:13:23,230
!إنّه منزعج

156
00:13:23,230 --> 00:13:25,540
!بالطّبع أنا منزعج

157
00:13:25,780 --> 00:13:28,490
!أنا وأنت أشبه بالإخوة

158
00:13:28,490 --> 00:13:30,880
!لسنة واحدة فقط أيّها اللّحية-كيتشي-تشان

159
00:13:39,580 --> 00:13:41,530
!أرجوك

160
00:14:00,690 --> 00:14:02,350
!اهتمّ بنفسك

161
00:14:02,350 --> 00:14:03,830
!أكيد

162
00:14:04,150 --> 00:14:06,680
!سوف نبقى هنا

163
00:14:07,150 --> 00:14:09,000
.إنّنا نحبّ هذه السّفينة

164
00:14:09,000 --> 00:14:12,020
.سننتظر عودتك هنا

165
00:14:17,510 --> 00:14:19,140
.أكيد

166
00:14:19,140 --> 00:14:21,560
.أنتم الآن قراصنة بمعنى الكلمة

167
00:14:22,670 --> 00:14:25,020
!لنفعل ما يحلو لنا

168
00:14:30,480 --> 00:14:33,820
يا والدي! ألن تقوم بتوديعه؟

169
00:14:36,760 --> 00:14:40,080
.ترك لنا روجر هدايا كعربون شكر

170
00:14:40,080 --> 00:14:41,980
!الكثير الكثير من الكنوز

171
00:14:41,980 --> 00:14:44,440
!وكمّيّات هائلة من الطّعام

172
00:14:44,440 --> 00:14:45,830
!ماذا؟

173
00:14:45,830 --> 00:14:48,290
!أيّها الأغبياء

174
00:14:48,290 --> 00:14:50,920
!أعيدوا لهم الطّعام

175
00:14:50,920 --> 00:14:56,300
!لن أسامحهم إن تركوا عائلة كوزكي أودن جياعًا

176
00:14:56,300 --> 00:14:57,870
!أسرعوا

177
00:14:57,870 --> 00:14:59,260
!حاضر

178
00:14:59,260 --> 00:15:00,720
!في الحال

179
00:15:05,230 --> 00:15:07,490
!أودن-ساما

180
00:15:10,940 --> 00:15:13,730
!إلى اللّقاء

181
00:15:13,730 --> 00:15:16,070
!يا رفاق

182
00:15:16,640 --> 00:15:19,510
!ابذل جُهدك

183
00:15:19,770 --> 00:15:24,450
!لا أطيق الانتظار حتّى أسمع قصص رحلتك

184
00:15:24,450 --> 00:15:26,970
!اهتمّ بنفسك

185
00:15:37,450 --> 00:15:41,100
...الفصل الثّاني من حياتي كقرصان

186
00:15:41,100 --> 00:15:44,060
!بدأت مغامرة جديدة

187
00:15:44,060 --> 00:15:49,520
،اللّحية-كيتشي-تشان رجل عظيم
.لكنّ روجر رجل لا تُسبر أغواره أيضًا

188
00:15:50,000 --> 00:15:52,660
!أنا محظوظ للغاية

189
00:15:56,190 --> 00:15:59,410
.على مهلك، على مهلك

190
00:15:59,410 --> 00:16:01,720
!هيّا، هيّا

191
00:16:02,470 --> 00:16:05,410
!لم نحمل أطفالاً بين أيدينا منذ مدّة

192
00:16:05,410 --> 00:16:08,720
.صحيح، يُشعرني هذا بالحنين

193
00:16:08,980 --> 00:16:12,730
!مومونوسكي وهيوري

194
00:16:18,280 --> 00:16:21,220
!أين اختفيت؟ ها أنا

195
00:16:21,580 --> 00:16:25,660
!ها أنت ذي! على مهل، على مهل

196
00:16:25,660 --> 00:16:29,450
!حسنًا؟ لنبدأ! هيّا

197
00:16:35,840 --> 00:16:37,150
!ماذا يحدث؟

198
00:16:37,150 --> 00:16:38,150
!ثمّة شيء في الدّاخل

199
00:16:38,550 --> 00:16:40,590
!ماذا؟! ماذا هنالك؟

200
00:16:49,900 --> 00:16:53,170
!أيّها القبطان روجر! لديها راكبون خلسة

201
00:16:59,570 --> 00:17:02,510
!أودن-ساما

202
00:17:02,830 --> 00:17:04,180
!إينواراشي

203
00:17:04,180 --> 00:17:06,060
!نيكوماموشي

204
00:17:07,960 --> 00:17:09,750
!لماذا أنتما هنا؟

205
00:17:09,750 --> 00:17:14,610
إنّنا نستمتع بصحبة أودن-ساما
!أكثر من أيّ شيء آخر

206
00:17:14,840 --> 00:17:18,480
!لا بدّ أنّ اللّحية-كيتشي-تشان قلق الآن

207
00:17:18,970 --> 00:17:21,530
!الكلب والقطّ اختفيا

208
00:17:23,010 --> 00:17:26,530
!أحمقان

209
00:17:33,190 --> 00:17:37,600
،أعرف أنّ هذا لم يكن مخطّطًا له
لكن أيمكنهما البقاء أيضًا؟

210
00:17:39,740 --> 00:17:42,800
.أعتقد أنّك فهمت الأمر بالخطأ

211
00:17:53,210 --> 00:17:58,870
.أودن. يحتاجك القبطان بفضل معرفتك فحسب

212
00:17:59,190 --> 00:18:01,000
أهذا مفهوم؟

213
00:18:06,720 --> 00:18:09,350
!هل لديك مال يا شانكس؟

214
00:18:09,350 --> 00:18:12,620
!نعم، لنذهب لشراء طعام

215
00:18:12,900 --> 00:18:15,170
...بطاطس

216
00:18:15,170 --> 00:18:17,040
!وأرقطيون

217
00:18:17,040 --> 00:18:18,690
.سآخذ هذه

218
00:18:18,690 --> 00:18:20,460
!أين المال؟

219
00:18:20,460 --> 00:18:21,710
!يا سيّدي؟

220
00:18:22,200 --> 00:18:24,440
!الفجل هو التّالي

221
00:18:24,550 --> 00:18:28,240
!لصّ! انتظر يا هذا

222
00:18:30,460 --> 00:18:33,530
!إنّه يسرق من مواطنين عاديّين

223
00:18:33,530 --> 00:18:35,520
.سيقتله القبطان

224
00:18:36,420 --> 00:18:37,940
!ذلك المغفّل

225
00:18:40,630 --> 00:18:43,740
!أودن! لا تعبث مع النّاس العاديّين

226
00:18:43,740 --> 00:18:46,110
!أحتاج المزيد من المكوّنات

227
00:18:46,110 --> 00:18:47,720
!مكوّنات لماذا؟

228
00:18:47,720 --> 00:18:50,530
!بيض! كونياكو

229
00:18:50,530 --> 00:18:53,850
!تشيكوا! أوتار العجل

230
00:18:53,850 --> 00:18:56,470
!لصّ

231
00:18:57,540 --> 00:19:01,570
!قلتُ لك أنّ عليك الدّفع للأشخاص العاديّين

232
00:19:01,570 --> 00:19:06,070
!أريد طبخ أودن لذيذ لكم

233
00:19:06,070 --> 00:19:08,240
!الأودن طعام؟

234
00:19:08,240 --> 00:19:11,560
!نعم! إنّه الطّبق الألذّ في بلاد وانو

235
00:19:12,330 --> 00:19:14,310
!ها هو هناك! هذا هو

236
00:19:21,510 --> 00:19:24,320
!أنت جريء بالفعل

237
00:19:26,800 --> 00:19:30,100
ماذا؟ ألا قانون في هذه البلدة؟

238
00:19:30,100 --> 00:19:31,780
...غابان، إنّهم

239
00:19:31,780 --> 00:19:35,330
.نعم، لا يبدون كأشخاص عاديّين

240
00:19:48,680 --> 00:19:49,930
!أودن

241
00:19:49,930 --> 00:19:52,200
!اهرب يا أودن

242
00:19:53,560 --> 00:19:54,540
!أودن

243
00:19:54,540 --> 00:19:56,140
!كان في قلب الانفجار

244
00:19:58,040 --> 00:19:59,730
!أودن

245
00:20:18,710 --> 00:20:20,330
...أودن! أنت

246
00:20:21,070 --> 00:20:22,380
!أنت حيّ

247
00:20:22,380 --> 00:20:23,540
!مذهل

248
00:20:25,490 --> 00:20:28,920
غابان، إنّهم ليسوا أشخاصًا عاديّين، صحيح؟

249
00:20:30,030 --> 00:20:31,430
...بلا شكّ

250
00:20:33,120 --> 00:20:34,700
.أودن

251
00:20:35,000 --> 00:20:35,890
.مفهوم

252
00:20:39,420 --> 00:20:41,590
.لم أحصل على الأعشاب البحريّة بعد

253
00:20:41,590 --> 00:20:43,190
أعشاب بحريّة؟

254
00:20:43,190 --> 00:20:44,820
.بإمكاني إعداد مرق رائع بها

255
00:20:50,100 --> 00:20:51,450
.أنت غريب للغاية

256
00:20:52,680 --> 00:20:55,160
!يا إلهي! ذلك لا يهمّ

257
00:20:55,430 --> 00:20:57,390
!نل منهم

258
00:21:08,110 --> 00:21:10,450
!يا لها من رائحة زكيّة

259
00:21:10,450 --> 00:21:14,190
.حسنًا! أظنّه جاهزًا

260
00:21:14,490 --> 00:21:17,240
...في بلاد وانو، يعتبر هذا

261
00:21:17,410 --> 00:21:19,310
!الطّبق الألذّ

262
00:21:23,460 --> 00:21:26,440
!حسنًا، بالهناء والشّفاء جميعًا

263
00:21:34,560 --> 00:21:37,410
ما رأيكم؟ أهو لذيذ؟

264
00:21:42,480 --> 00:21:45,940
!لذيذ جدًّا

265
00:21:45,940 --> 00:21:50,200
!لم أكن أعرف أنّ الأودن لذيذ هكذا

266
00:21:50,200 --> 00:21:51,970
!إنّه الطّعام المثاليّ مع السّاكي

267
00:21:51,970 --> 00:21:54,090
!جيّد! أعجبكم إذًا

268
00:21:57,040 --> 00:21:59,160
!إنّه ساخن جدًّا

269
00:21:59,160 --> 00:22:00,770
!لسانك حسّاس للغاية

270
00:22:03,880 --> 00:22:05,650
!يا رجال

271
00:22:05,650 --> 00:22:09,610
!لنقم حفلة ترحيب كبيرة بأعضائنا الجدد

272
00:22:09,610 --> 00:22:11,690
!أجل

273
00:22:14,550 --> 00:22:15,760
!أودن

274
00:22:15,760 --> 00:22:17,390
!روجر

275
00:22:17,390 --> 00:22:19,940
!لنحتفل طوال اللّيل

276
00:22:19,940 --> 00:22:21,160
!أكيد

277
00:22:21,160 --> 00:22:29,480
!أودن

278
00:22:29,480 --> 00:22:32,400
!جفل وغانمو

279
00:22:33,570 --> 00:22:36,440
!تشيكوا وبيض

280
00:22:37,370 --> 00:22:41,470
!نضيف هذا لذاك ويصبح جاهزًا للأكل

281
00:22:41,470 --> 00:22:44,620
...ما كان الأودن ليُسمّى أودن

282
00:22:45,500 --> 00:22:49,790
!إن لم يكن يغلي

283
00:22:50,130 --> 00:22:53,000
!أجل يا كوزكي

284
00:23:04,350 --> 00:23:08,500
مغامرة كبيرة ومجنونة، وغناء بصوت
!عال مع رفاق طاقم مرحين

285
00:23:08,500 --> 00:23:12,250
.التّحليق إلى السّماء وحماس لغز في قعر البحر

286
00:23:12,250 --> 00:23:17,510
يفكّ أدون رموز أسرار العالم الّتي ستقودهم
!إلى أبعد أرض تشير إليها البونيغليف

287
00:23:17,510 --> 00:23:21,990
!واصلوا التّقدّم! يواصل قراصنة روجر ترحالهم

288
00:23:22,540 --> 00:23:26,810
:في الحلقة القادمة من وان بيس
"!كرّس حياته لها! مغامرة روجر"

289
00:23:26,810 --> 00:23:30,620
!ملك القراصنة، لن يكون إلاّ أنا