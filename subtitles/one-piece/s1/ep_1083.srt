1
00:00:00,650 --> 00:00:04,320
بوجود الضّعف كحليف لي

2
00:00:04,320 --> 00:00:07,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,950 --> 00:00:10,660
من المؤسف البقاء في مكان كهذا

4
00:00:10,660 --> 00:00:14,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,200 --> 00:00:18,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,870 --> 00:00:22,500
إن كان قلبي أيضًا ضائعًا

7
00:00:22,500 --> 00:00:25,210
فلن أتمكّن من إيجادك

8
00:00:25,210 --> 00:00:29,260
لا لطفك ولا قوّتك

9
00:00:29,260 --> 00:00:35,060
أعلم مسبقًا

10
00:00:35,060 --> 00:00:36,970
إنّ بزوغ الفجر وشيك

11
00:00:36,970 --> 00:00:40,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,150 --> 00:00:44,320
سأندفع عبر الطّريق بأكمله

13
00:00:44,320 --> 00:00:47,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,070 --> 00:00:51,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,570 --> 00:00:54,330
بوجود العالم كعدوّ لي

16
00:00:54,330 --> 00:00:58,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,790 --> 00:01:01,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,580 --> 00:01:06,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:15,970 --> 00:01:21,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:30,440 --> 00:01:36,040
.يشهد العالم تغيّرًا جديدًا"
"!المنظّمة الجديدة كروس غيلد

21
00:01:36,040 --> 00:01:38,750
"عاصمة الزّهور - بعد الوليمة"

22
00:01:42,550 --> 00:01:46,340
!لا أصدّق أنّ شيئًا كهذا حدث في غيابي

23
00:01:48,010 --> 00:01:49,660
!رايزو

24
00:01:49,660 --> 00:01:51,850
!شينوبو-سان! لا تموتي

25
00:01:56,550 --> 00:01:57,940
!لا تفارقانا

26
00:01:57,940 --> 00:01:59,800
.لا داعي للقلق

27
00:01:59,800 --> 00:02:04,450
.سبق ومنحهما الطّبيب تشوبّر أفضل عناية

28
00:02:04,450 --> 00:02:09,020
.قال أنّهما سيكونان بخير بعد القليل من الرّاحة

29
00:02:09,560 --> 00:02:11,180
.هكذا إذًا

30
00:02:11,180 --> 00:02:12,660
...سرّني سماع هذا

31
00:02:14,790 --> 00:02:19,490
...لا أصدّق أنّ الأمر انتهى برايزو وشينوبو هكذا

32
00:02:19,490 --> 00:02:21,420
.يا لها من شعوذة مرعبة

33
00:02:21,420 --> 00:02:25,680
...انتهى بن الحال هكذا رغم أنّنا هاجمناه معًا

34
00:02:25,680 --> 00:02:29,760
...صحيح، قال أنّه كان أميرالاً في البحريّة-نيا

35
00:02:32,960 --> 00:02:37,330
كلّ من الطّبيعة والبشريّة يحتاجان
...لريّ عطشهما بالماء

36
00:02:37,330 --> 00:02:38,440
.يا صغير

37
00:02:39,260 --> 00:02:41,350
!دعني

38
00:02:51,530 --> 00:02:55,690
.لا يستطيع البشر الضّعفاء مجابهة الطّبيعة

39
00:02:55,690 --> 00:02:57,400
ألا تفهمون؟

40
00:02:57,400 --> 00:03:00,840
تواجد كايدو هنا كان الرّادع الوحيد
!الّذي منعني من الحضور من قبل

41
00:03:01,870 --> 00:03:05,280
،مع أنّ ما سأقوله يُحزنني
إلاّ أنّ حكم كايدو الطّاغي

42
00:03:05,280 --> 00:03:09,050
.هو ما حمى هذه الجزيرة من الأعداء الخارجيّين

43
00:03:11,040 --> 00:03:15,140
!أكره الاعتراف بهذا، لكنّ كلامه كان صحيحًا

44
00:03:15,300 --> 00:03:20,940
كان وجود كايدو هنا هو ما
...يدفع أعداء هذه البلاد عنها

45
00:03:20,940 --> 00:03:22,930
!يا للعار

46
00:03:22,930 --> 00:03:24,260
!أنا جدّ آسف

47
00:03:24,260 --> 00:03:28,070
!كنتُ في كوري ولم أعلم بحدوث هذا

48
00:03:28,230 --> 00:03:32,140
.هذا ليس خطأك... كان الضّرر قليلاً

49
00:03:32,140 --> 00:03:35,020
!وكلّ هذا بسبب مجهودات مومونوسكي-ساما الكبيرة

50
00:03:35,020 --> 00:03:36,250
.لذلك لا داعي للقلق

51
00:03:38,410 --> 00:03:42,170
بالمناسبة، كيف حال أوتسورو-سان؟

52
00:03:42,170 --> 00:03:45,190
،صحيح، اندلعت النّيران في بلدة أوكوبوري

53
00:03:45,190 --> 00:03:49,790
...وعانت حروقًا فظيعة، لكنّها نجت

54
00:03:50,370 --> 00:03:53,080
!هذه أنت يا أوتسورو-سان

55
00:03:53,420 --> 00:03:55,770
.سمعتُ أنّ كين-سان قد عاد

56
00:03:55,770 --> 00:03:59,480
.نعم. لكنّه عاد للعاصمة سلفًا

57
00:03:59,480 --> 00:04:03,310
.أنت من العاصمة أيضًا
.عليك الذّهاب معه

58
00:04:03,310 --> 00:04:08,270
...نعم. أريد البقاء معه، ولكن

59
00:04:10,730 --> 00:04:15,660
،يا إلهي... حتّى بعد مرور عشرين سنة
...لم ينقص جمال تسورو ولو قليلاً

60
00:04:15,660 --> 00:04:20,040
مهلاً! التّبجّح بحياتك العاطفيّة هكذا
!لا يستحقّ حتّى انتباه كلب

61
00:04:20,040 --> 00:04:22,460
!صحيح-نيا

62
00:04:23,780 --> 00:04:26,500
.كم هذا جميل يا كين-ساما

63
00:04:31,710 --> 00:04:33,990
!ما الخطب يا رايزو؟

64
00:04:33,990 --> 00:04:35,870
أتريد شيئًا ما؟

65
00:04:35,870 --> 00:04:37,870
...أريد

66
00:04:37,870 --> 00:04:38,980
ماذا؟

67
00:04:40,720 --> 00:04:43,600
.أن أكون محبوبًا أيضًا

68
00:04:44,770 --> 00:04:48,280
!ليتحسّن حالك أوّلاً يا رايزو

69
00:04:48,280 --> 00:04:53,280
...أريد جلب انتباه الكونويتشي لي أيضًا

70
00:04:57,570 --> 00:05:01,150
!الأودن في بلاد وانو رائع

71
00:05:05,420 --> 00:05:07,500
!أمر خطير-سارو

72
00:05:11,550 --> 00:05:13,620
!مهلاً

73
00:05:17,380 --> 00:05:19,100
أتريد بعض الأودن؟

74
00:05:19,100 --> 00:05:23,980
!الدّوق إينواراشي والسّيّد نيكوماموشي يستدعيانك

75
00:05:28,140 --> 00:05:30,030
.ها قد أتيت يا كاروت

76
00:05:30,030 --> 00:05:32,630
ماذا هنالك؟! لماذا استدعيتماني؟

77
00:05:32,630 --> 00:05:35,620
!أيّها الدّوق-ساما والسّيّد نيكوماموشي

78
00:05:35,620 --> 00:05:38,120
.كنّا في انتظارك

79
00:05:54,630 --> 00:05:58,890
لماذا لا تصبحين-غارا حاكمة دوقيّة موكومو؟

80
00:06:00,680 --> 00:06:02,270
!حاكمة؟

81
00:06:02,270 --> 00:06:03,620
!مرحى

82
00:06:03,620 --> 00:06:04,770
!لا أمانع

83
00:06:11,980 --> 00:06:15,110
!ماذا؟

84
00:06:15,110 --> 00:06:17,160
!حاكمة؟

85
00:06:17,160 --> 00:06:20,540
!لا أريد! مستحيل أن أستطيع ذلك

86
00:06:23,780 --> 00:06:27,750
!أرجوكما! سأفعل أيّ شيء، فسامحاني

87
00:06:31,710 --> 00:06:33,320
...في الحقيقة

88
00:06:33,320 --> 00:06:38,680
،قرّرنا أنا والقطّ البقاء هنا في بلاد وانو
،وبصفتنا ساموراي من عشيرة كوزكي

89
00:06:38,680 --> 00:06:42,060
.لحماية مومونوسكي-ساما

90
00:06:44,270 --> 00:06:46,750
!صحيح-نيا

91
00:06:46,750 --> 00:06:52,170
،لقد أبحرتِ-غارا مع طاقم قبّعة القشّ
،وهو أمر حظي به قليلون فقط

92
00:06:52,170 --> 00:06:56,280
لذلك أنا واثق أنّك تملكين ما يتطلّبه
.الأمر لقيادة الجيل التّالي

93
00:06:56,280 --> 00:06:57,970
!مهلاً، مهلاً

94
00:06:57,970 --> 00:07:01,200
!هناك آخرون كثر أقوى منّي

95
00:07:01,200 --> 00:07:02,660
!بالطّبع يوجد

96
00:07:03,950 --> 00:07:07,000
!واجبنا هو حماية البلاد

97
00:07:08,900 --> 00:07:13,000
.سأدعمك أيضًا. إنّه قرار الدّوق-ساما والسّيّد

98
00:07:26,230 --> 00:07:30,150
...كاروت! الأهمّ من كلّ شيء، أنّك-تيا

99
00:07:30,150 --> 00:07:32,270
.تحملين إرادة بيدرو في قلبك

100
00:07:36,770 --> 00:07:38,570
...بيدرو

101
00:07:39,640 --> 00:07:41,990
.لا يهمّ كيف تقاتلين

102
00:07:41,990 --> 00:07:45,690
من الآن فصاعدًا، عليك أن تكوني مقاتلة
.قويّة ومتأهّبة في كلّ وقت

103
00:07:47,820 --> 00:07:51,200
.لكلّ امرئ دوره

104
00:07:52,410 --> 00:07:54,210
..كاروت

105
00:07:54,210 --> 00:07:56,200
.سيحين دورك-غارا أيضًا

106
00:07:58,500 --> 00:08:02,210
أهذا هو دوري إذًا؟

107
00:08:03,460 --> 00:08:04,970
...بيدرو

108
00:08:04,970 --> 00:08:06,910
.نعتمد عليك

109
00:08:06,910 --> 00:08:10,970
!سنترك و في عهدتكم-غارا أيّها الشّباب

110
00:08:18,400 --> 00:08:20,140
فعلاً؟

111
00:08:20,140 --> 00:08:22,480
أنت هو جدّنا؟

112
00:08:22,480 --> 00:08:24,270
...نعم

113
00:08:24,980 --> 00:08:27,820
.أنا والد أودن

114
00:08:30,540 --> 00:08:33,790
!إذًا فقد كنتَ حيًّا بالفعل

115
00:08:33,790 --> 00:08:35,650
.أنا آسف

116
00:08:35,650 --> 00:08:38,510
.شعرت بالخزي الشّديد من مواجهتكما

117
00:08:38,510 --> 00:08:41,360
...لم أستطع إنقاذ أودن

118
00:08:41,360 --> 00:08:46,290
.وفوق ذلك، لم أستطيع إنقاذ هذه البلاد

119
00:08:46,290 --> 00:08:49,180
.أنا آسف. أنا آسف

120
00:08:49,180 --> 00:08:51,290
.أردت دائمًا أن ألقاك

121
00:08:51,290 --> 00:08:53,000
.وكذلك أنا

122
00:08:53,000 --> 00:08:54,860
.شكرًا لكما

123
00:08:55,470 --> 00:09:00,240
.أنت تشبه أودن كثيرًا يا مومونوسكي

124
00:09:00,240 --> 00:09:02,260
!جدّي

125
00:09:02,260 --> 00:09:05,210
،بالنّسبة لنا نحن اللّذين فقدنا والدانا

126
00:09:05,210 --> 00:09:08,660
!وجود أقرباء آخرين لنا لأمر مشجّع للغاية

127
00:09:08,660 --> 00:09:10,930
.أتشاركه نفس الشّعور

128
00:09:10,930 --> 00:09:14,330
!لذلك لا تعتذر لنا أبدًا

129
00:09:23,080 --> 00:09:25,430
!يا للمفاجأة

130
00:09:25,660 --> 00:09:27,850
!إذًا فقد كان سوكياكي-ساما

131
00:09:27,850 --> 00:09:30,950
!لم يخطر ذلك على بالي أبدًا

132
00:09:30,950 --> 00:09:34,250
.قفز قلبي إلى حلقي من المفاجأة

133
00:09:34,250 --> 00:09:37,390
!أنا مسرور جدًّا لأنّه حيّ

134
00:09:40,900 --> 00:09:44,530
.عرفتُ أنّكم لاحظتم الأمر

135
00:09:44,530 --> 00:09:48,410
من قد يرتدي قناع تنغو وليس هناك أيّ مهرجان؟

136
00:09:48,410 --> 00:09:51,290
.لم نظنّ أبدًا أنّك مجرّد حدّاد سيوف فحسب

137
00:09:51,480 --> 00:09:55,230
...ظننّا أنّه ستكون من الفظاظة فتح الموضوع

138
00:09:55,230 --> 00:09:57,080
صحيح يا كين-ساما؟

139
00:09:59,240 --> 00:10:00,960
!هذا صحيح

140
00:10:01,830 --> 00:10:04,840
...آسف لأنّي جعلتكم تمرّون بهذا

141
00:10:06,460 --> 00:10:12,040
يمكنني إخباركم عن تاريخ هذه البلاد
،بما أنّي عجوز تقدّم به العمر كثيرًا

142
00:10:12,040 --> 00:10:14,480
.ولكنّ هذا كلّ شيء

143
00:10:14,480 --> 00:10:19,360
.لذلك لا تخبروا هذه الأمّة بالأمر
.دعونا أتقاعد في سلام

144
00:10:19,570 --> 00:10:23,360
من الآن فصاعدًا، هذا العصر الجديد
.لكم لتبنوه أنتم

145
00:10:23,360 --> 00:10:27,240
!إنّ حقيقة أنّك حيّ وحدها تمنحنا الشّجاعة

146
00:10:28,440 --> 00:10:30,280
...هذا العصر

147
00:10:30,280 --> 00:10:32,200
.الّذي سنبنيه نحن

148
00:10:35,530 --> 00:10:36,830
!حسنًا

149
00:10:36,830 --> 00:10:38,110
!حاضر

150
00:10:45,170 --> 00:10:48,840
!ماذا؟! بلوتون موجود هنا؟

151
00:10:48,840 --> 00:10:52,220
...نعم. لكنّي لم أره

152
00:10:52,220 --> 00:10:54,000
!لكنّه هنا بكلّ تأكيد

153
00:10:54,000 --> 00:10:56,940
ذلك الشّيء موجود بالفعل؟

154
00:10:59,220 --> 00:11:02,070
هل هذا هو الّذي حرق فرانكي تصاميمه؟

155
00:11:02,070 --> 00:11:04,190
عندما كنّا في إنيس لوبي؟

156
00:11:04,190 --> 00:11:05,680
.هذا صحيح

157
00:11:05,680 --> 00:11:08,510
.السّلام القديم الّذي يحمل اسم إله

158
00:11:08,510 --> 00:11:09,570
.بلوتون

159
00:11:09,570 --> 00:11:11,200
بلوتون؟

160
00:11:11,200 --> 00:11:13,580
.يا له من شيء خطير

161
00:11:13,580 --> 00:11:17,160
ما الّذي كانت تخطّط له هذه البلاد؟

162
00:11:20,530 --> 00:11:23,150
أتريده يا لوفي؟

163
00:11:23,150 --> 00:11:24,510
.على الإطلاق

164
00:11:24,730 --> 00:11:26,520
.توقّعت ذلك

165
00:11:26,520 --> 00:11:30,790
.لكنّ أودن حاول إطلاقه

166
00:11:30,790 --> 00:11:32,100
لماذا يا ترى؟

167
00:11:33,380 --> 00:11:36,310
!ماذا؟ ماذا؟ عدوّ؟

168
00:11:36,310 --> 00:11:37,730
ماذا؟

169
00:11:37,730 --> 00:11:39,850
...هل تقولون أنّ امرأة ناضجة

170
00:11:39,850 --> 00:11:42,230
أشبه بالسّلاح؟

171
00:11:42,230 --> 00:11:44,320
!من تكونين يا هذه؟

172
00:11:44,320 --> 00:11:47,740
من أكون؟ ألم تتعرّفوا إليّ؟

173
00:11:47,740 --> 00:11:51,570
...حدث أمر ما وفقدت بعض الوزن

174
00:11:51,570 --> 00:11:54,450
!لكنّها أنا شينوبو

175
00:11:54,450 --> 00:11:56,830
!ماذا؟

176
00:11:56,830 --> 00:11:59,120
!أحبّ كيف صرت بعدما فقدته

177
00:11:59,120 --> 00:12:02,610
!تبدين رائعة لدرجة أنّي صرب مجرّد عظام

178
00:12:02,610 --> 00:12:06,160
!مع أنّي عظام من الأساس

179
00:12:07,760 --> 00:12:09,260
!فعلاً؟

180
00:12:09,830 --> 00:12:11,390
!أخي الكبير! أخي الكبير

181
00:12:12,540 --> 00:12:16,100
!لقد صرتُ تلميذة لشينوبو-تشان

182
00:12:16,100 --> 00:12:18,850
،سأصير قويّة
،وفي المرّة التّالية الّتي سنلتقي فيها

183
00:12:18,850 --> 00:12:21,480
!دعني أنضمّ إلى طاقمك

184
00:12:21,480 --> 00:12:23,890
!أكيد إن أتقنت النّينجتسو

185
00:12:23,890 --> 00:12:25,430
!لا أمانع

186
00:12:28,570 --> 00:12:30,340
!أجل

187
00:12:30,340 --> 00:12:34,010
!سأعمل بجدّ لأصير كونويتشي فاتنة

188
00:12:34,010 --> 00:12:35,200
!نين، نين

189
00:12:35,200 --> 00:12:38,080
!كم أنت ظريفة يا أوتاما

190
00:12:39,150 --> 00:12:42,200
!أنت الأفضل يا أوتاما

191
00:12:44,700 --> 00:12:48,840
!لا أصدّق هذا... بلوتون في بلاد وانو؟

192
00:12:48,840 --> 00:12:51,320
...بوسيدون من قبل، والآن هذا

193
00:12:51,320 --> 00:12:56,790
!عليّ إخبار ذلك الشّخص بشأن هذا

194
00:13:27,240 --> 00:13:29,250
!أيّها الشّوغن

195
00:13:29,250 --> 00:13:31,050
.ها أنت ذا

196
00:13:33,430 --> 00:13:37,300
.تمّ إيداع خطط أعادة البناء لكلّ منطقة

197
00:13:37,300 --> 00:13:39,000
.جيّد

198
00:13:40,720 --> 00:13:43,540
.هذا هو تقدير للميزانيّة

199
00:13:43,540 --> 00:13:45,830
.نعم، شكرًا لك

200
00:13:45,830 --> 00:13:47,310
!أيّها الشّوغن

201
00:13:47,510 --> 00:13:52,220
بدأت اقتراحات إعادة استغلال مواقع
.مصانع الأسلحة بالتّوافد علينا

202
00:13:52,220 --> 00:13:54,030
.نعم... هيّا بنا

203
00:13:59,830 --> 00:14:04,040
.أيّها الشّوغن! أعطني رأيك رجاءً بشأن الخزّان لاحقًا

204
00:14:04,240 --> 00:14:08,420
علينا أن نتحدّث بشأن الاجتماع
.مع دايميو جميع المناطق

205
00:14:08,420 --> 00:14:09,910
.نعم

206
00:14:11,010 --> 00:14:12,950
!أيّها الشّوغن-ساما

207
00:14:14,620 --> 00:14:15,910
.نعم

208
00:14:24,850 --> 00:14:25,900
!مومو

209
00:14:39,240 --> 00:14:41,600
!يا زورو

210
00:14:41,600 --> 00:14:44,620
...أيمكنك تعليمي بعض تقنيات السّيف

211
00:14:44,620 --> 00:14:47,200
لو سمحت؟

212
00:14:48,530 --> 00:14:51,070
لوفي؟ زورو؟

213
00:14:56,500 --> 00:14:59,140
!أونامي! أوسوبّ

214
00:14:59,140 --> 00:15:00,880
!سانجي

215
00:15:00,880 --> 00:15:03,070
!تشوبّريمون

216
00:15:03,070 --> 00:15:05,140
!روبين! فرانكي

217
00:15:05,140 --> 00:15:07,810
!أيّها العظمي-كيتشي! جينبي

218
00:15:07,810 --> 00:15:09,930
!ياماتو

219
00:15:10,440 --> 00:15:12,680
!أين أنتم؟

220
00:15:13,390 --> 00:15:15,110
!يا رفاق

221
00:15:17,980 --> 00:15:21,330
!هيوري! هل رأيت لوفي والبقيّة؟

222
00:15:21,330 --> 00:15:24,700
...لقد رحلوا بعد أن ودّعوا الجميع

223
00:15:26,000 --> 00:15:28,030
!كم أنا حزينة

224
00:15:30,610 --> 00:15:32,570
ودّعوا الجميع؟

225
00:15:32,570 --> 00:15:35,050
...لكن لم يودّعوني أنا

226
00:15:36,830 --> 00:15:38,840
!مومونوسكي-ساما

227
00:15:38,840 --> 00:15:42,450
...كـ-كينييمون! إنّ لوفي والبقيّة

228
00:15:42,450 --> 00:15:44,430
!عرفتُ بذلك للتّوّ

229
00:15:44,430 --> 00:15:46,980
!ماذا؟! أنت أيضًا؟

230
00:15:46,980 --> 00:15:51,190
!تحقّقت من الأمر، لقد ودّعوا دنجيرو والبقيّة

231
00:15:51,190 --> 00:15:54,480
!لماذا لم يودّعونا نحن بالتّحديد؟

232
00:15:54,480 --> 00:15:56,070
!هذا ما أريد معرفته

233
00:15:56,070 --> 00:15:58,240
!خاب ظنّي فيك يا لوفي

234
00:15:58,470 --> 00:16:00,950
!ظننتُ أنّنا أصدقاء

235
00:16:29,810 --> 00:16:32,770
!يا قبّعة القشّ-يا. اختر موعدًا آخر

236
00:16:33,860 --> 00:16:35,150
!لماذا؟

237
00:16:35,150 --> 00:16:37,030
!لأنّ هذا غريب

238
00:16:37,030 --> 00:16:39,840
!سنبحر معًا هكذا

239
00:16:39,840 --> 00:16:43,470
!انتهى تحالفنا! نحن أعداء الآن

240
00:16:43,470 --> 00:16:47,040
!قرّرنا سلفًا أنّنا سنبحر اليوم

241
00:16:47,040 --> 00:16:48,120
!وكذلك نحن –
!وكذلك نحن –

242
00:16:48,320 --> 00:16:51,790
!ترافالغار! غيّر موعد إبحارك أوّلاً

243
00:16:51,790 --> 00:16:54,960
.أنا من عليه إخبارك بذلك

244
00:16:54,960 --> 00:16:57,180
!لن أغيّره أيضًا

245
00:16:57,180 --> 00:16:59,240
.هذا سخيف

246
00:16:59,240 --> 00:17:02,070
.لا خيار أمامنا، اخترنا نفس اليوم

247
00:17:02,070 --> 00:17:03,970
!لنختر اتّجاهات مختلفة

248
00:17:03,970 --> 00:17:07,240
!سجّلت البوصلة ثلاثة اتّجاها

249
00:17:07,240 --> 00:17:09,930
!الشّمال الشّرقيّ والشّرق والجنوب الشّرقيّ

250
00:17:10,160 --> 00:17:11,520
!ليختر كلّ منّا

251
00:17:11,520 --> 00:17:13,190
!الشّمال الشّرقيّ

252
00:17:11,520 --> 00:17:13,190
!الوسط

253
00:17:14,550 --> 00:17:16,850
...أظنّني قد قرّرتُ اتّجاهي

254
00:17:17,430 --> 00:17:20,310
إنّ اتّجاه الشّمال الشّرقيّ هو ما
.سيقرّبنا أكثر لوجهتنا

255
00:17:20,310 --> 00:17:23,740
!استعملا عقليكما أيّها الغبيّان

256
00:17:25,780 --> 00:17:27,520
الوسط"؟"

257
00:17:28,230 --> 00:17:29,330
هل أنتما طفلين؟

258
00:17:30,830 --> 00:17:32,810
.حدّدت اتّجاهي

259
00:17:32,810 --> 00:17:35,820
لماذا لا تقرّران الباقي بينكما؟

260
00:17:35,820 --> 00:17:38,190
!اختر واحدة يا قبّعة القشّ

261
00:17:38,190 --> 00:17:40,760
."كُتب على إحداها "الشّرق

262
00:17:40,760 --> 00:17:42,470
!هذه

263
00:17:45,830 --> 00:17:47,510
!إنّها الشّرق

264
00:17:48,630 --> 00:17:50,720
!لقد خسرت

265
00:17:50,720 --> 00:17:53,050
!آسف يا رفاق

266
00:17:54,350 --> 00:17:56,310
!الخطر محدق بنا في كلّ الاتّجاهات

267
00:17:56,310 --> 00:17:59,780
!لا نهتمّ لهذا! ساعدنا في التّحميل يا لوفي

268
00:18:00,310 --> 00:18:01,820
!سُحقًا

269
00:18:01,820 --> 00:18:05,820
!أنا واحد من اليونكو، ولكنّي خسرت في القرعة

270
00:18:07,240 --> 00:18:08,530
!انظر لحالك

271
00:18:08,530 --> 00:18:09,950
...لكن

272
00:18:09,950 --> 00:18:12,700
...إنّ أكثر من يزعجني لكونه أحد اليونكو

273
00:18:12,700 --> 00:18:14,610
!هو هذا

274
00:18:16,450 --> 00:18:18,710
!المهرّج العبقريّ باغي

275
00:18:18,710 --> 00:18:21,670
!ماذا؟! ما هذا؟

276
00:18:35,390 --> 00:18:38,560
!هذان هو كروكودايل وعين الصّقر

277
00:18:38,560 --> 00:18:40,980
!لماذا يظهران هنا وكأنّهما تابعان لباغي؟

278
00:18:40,980 --> 00:18:45,150
...مستحيل أن يعمل عين الصّقر تحت إمرته

279
00:18:47,110 --> 00:18:51,080
،إن كان هذان الرّجلان تحت إمرته بالفعل

280
00:18:51,080 --> 00:18:53,830
.إذًا فهو جدير بالفعل بلقب اليونكو

281
00:18:53,830 --> 00:18:57,080
لكنّه مجرّد غبيّ! ما الّذي حدث؟

282
00:18:57,080 --> 00:19:00,900
...يبدو أنّ هذه الشّراكة تُدعى كروس غيلد

283
00:19:00,900 --> 00:19:04,460
.وقد بدأت بوضع مكافآت على رؤوس البحريّة

284
00:19:04,460 --> 00:19:06,860
...البحريّة الّتي كانت الصّيّاد دائمًا

285
00:19:06,860 --> 00:19:10,850
يجب عليها أن تقلق الآن لأنّها صارت
.فريسة للمدنيّين

286
00:19:10,850 --> 00:19:14,490
،بينما كنّا في هذه البلاد المنعزلة

287
00:19:14,490 --> 00:19:17,940
.تغيّر العالم كثيرًا في الخارج

288
00:19:20,140 --> 00:19:22,980
لا شكوى بشأن الاتّجاهات، صحيح؟

289
00:19:22,980 --> 00:19:27,240
،بمجرّد أن نبحر خارج هذه البلاد
!سنصير أعداءً لبعضنا ثانية

290
00:19:33,660 --> 00:19:36,980
ما هذا يا ترافالغار؟

291
00:19:36,980 --> 00:19:39,210
.إنّها نسخة عن بونيغليف الطّريق

292
00:19:39,440 --> 00:19:42,250
.لديكم الحقّ في امتلاكها أيضًا

293
00:19:42,250 --> 00:19:44,550
...لا متعة في الغشّ

294
00:19:44,550 --> 00:19:47,700
...إذًا فقد كان كايدو يملك واحدًا بالفعل

295
00:19:47,700 --> 00:19:51,430
إنّه نفس ذلك الشّيء الّذي جعلنا
...أحد قادة بيغ مام يسرقه

296
00:19:53,040 --> 00:19:57,310
!علينا أن نكون جادّين بشأن هذا أيضًا يا كيد

297
00:19:57,310 --> 00:20:00,770
...للمشاركة في المعركة من أجل الوان بيس

298
00:20:00,770 --> 00:20:04,260
علينا العثور على الرّجل ذو ندبةِ الحرق، صحيح؟

299
00:20:04,260 --> 00:20:06,320
.نكاد لا نملك أيّ دلائل

300
00:20:07,310 --> 00:20:09,090
ندبة الحرق"؟"

301
00:20:09,090 --> 00:20:10,200
ما هذا؟

302
00:20:15,120 --> 00:20:17,470
!ألا تعرف؟

303
00:20:17,470 --> 00:20:20,280
!هذا لصالحنا إذًا

304
00:20:21,070 --> 00:20:22,830
!ماذا؟! أخبرني

305
00:20:30,470 --> 00:20:34,160
!يا ياماتو

306
00:20:34,160 --> 00:20:36,370
!أين أنت؟

307
00:20:36,370 --> 00:20:38,100
!أتسمعني؟

308
00:20:38,100 --> 00:20:40,220
!ياماتو

309
00:20:40,220 --> 00:20:42,480
!ألست هنا أيضًا؟

310
00:20:42,480 --> 00:20:44,970
!ياماتو

311
00:20:45,430 --> 00:20:47,110
!مومونوسكي-كُن

312
00:20:47,110 --> 00:20:49,050
!أنا هنا

313
00:20:49,050 --> 00:20:51,020
أين؟

314
00:20:51,890 --> 00:20:54,400
فوق السّطح كالعادة؟

315
00:20:54,980 --> 00:20:58,320
!حسنًا! اتّخذت قراري

316
00:21:07,420 --> 00:21:10,630
!لنذهب لرؤية لوفي والبقيّة

317
00:21:13,420 --> 00:21:14,920
...أنا

318
00:21:14,920 --> 00:21:17,640
!سأعيش كيفما عاش كوزكي أودن

319
00:21:51,140 --> 00:21:55,160
انتهى الوقت

320
00:21:55,160 --> 00:21:58,970
هنالك من ضحك ثانية

321
00:21:59,150 --> 00:22:06,630
لا بأس، فإنّ الغمّيضة الآن انتهت

322
00:22:06,630 --> 00:22:10,860
تعال معي
(سنراها قريبًا)

323
00:22:11,030 --> 00:22:14,610
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

324
00:22:14,780 --> 00:22:18,990
شيء ما سيتغيّر
(سنراها قريبًا)

325
00:22:19,160 --> 00:22:23,250
كن قويًّا، ما زال هنالك وقت
(3-2-1)

326
00:22:31,300 --> 00:22:35,380
لكنّنا شباب، لذلك فنحن أحرار

327
00:22:35,380 --> 00:22:39,850
لنعش جميعًا أحلامنا الأكثر حماقة

328
00:22:40,010 --> 00:22:43,770
سننير الطّريق المظلم أمامنا

329
00:22:43,930 --> 00:22:47,900
لنقف على أقدامنا ونحاول

330
00:22:48,060 --> 00:22:51,980
لنكتشف معًا أصقاع العالم

331
00:22:51,980 --> 00:22:56,370
أنا وأنت، سنحلّق بعيدًا

332
00:23:04,660 --> 00:23:09,250
!قصّة لم تُروى بعد قبل مغادرة طاقم قبّعة القشّ

333
00:23:09,250 --> 00:23:13,170
إنّ رحلة القضاء على كايدو الّتي بدأت
،بزبديّة أرزّ واحدة شارفت على نهايتها

334
00:23:13,170 --> 00:23:18,260
وها هما لوفي وأوتاما يتشاركان
.حساء فاصولياء حمراء دافئ وخزين

335
00:23:18,260 --> 00:23:21,750
ماذا ستكون كلماتهما الأخيرة لبعضهما؟

336
00:23:22,430 --> 00:23:24,220
:في الحلقة القادمة من وان بيس

337
00:23:24,220 --> 00:23:27,730
."وقد المغادرة، بلاد وانو وطاقم قبّعة القشّ"

338
00:23:27,730 --> 00:23:31,730
!ملك القراصنة، لن يكون إلاّ أنا