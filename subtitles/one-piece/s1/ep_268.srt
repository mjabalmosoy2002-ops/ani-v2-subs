1
00:00:15,080 --> 00:00:18,920
.نُقل كلٌ من فرانكي وروبين إلى برج القانون

2
00:00:24,960 --> 00:00:26,800
!هذا أروع شعور

3
00:00:26,800 --> 00:00:33,300
من المفاجئ أنّك تمكنت من النجاة
.من تلك الحادثة قبل ثمان سنوات يا كاتي فلام

4
00:00:33,300 --> 00:00:37,390
.تحقيق الأهداف مستحيل بلا تضحيات

5
00:00:37,390 --> 00:00:41,600
.إنّنا نعمل لضمان سلام البشريّة أجمع

6
00:00:43,020 --> 00:00:44,650
!إنّك مختل

7
00:00:44,650 --> 00:00:47,570
وضع توم-سان حياته على المحك لحماية المخططات

8
00:00:47,570 --> 00:00:50,660
!لوجود أغبياء مثلك

9
00:00:56,700 --> 00:00:58,330
!يوي

10
00:01:00,660 --> 00:01:03,920
وفي تلك الأثناء، كان لوفي يقاتل 10000 جندي

11
00:01:03,920 --> 00:01:07,130
.في جزيرة إنيس لوبي الرئيسيّة

12
00:01:14,800 --> 00:01:18,350
!أرجوك استجب أيّها الرئيس سباندام
!وجهنا باتخاذ التدابير المضادّة

13
00:01:18,350 --> 00:01:20,850
!لا نستطيع إيقاف قبعة القش لوفي

14
00:01:35,780 --> 00:01:40,290
وفي تلك الأثناء، زورو والبقيّة
الذين كانوا ينتظرون فتح البوّابات

15
00:01:40,290 --> 00:01:43,290
على متن الرجل الصاروخ، اقتحموا المكان
...بعد تحضير دقيق

16
00:01:44,790 --> 00:01:47,630
!ماذا؟! هذه مصيبة
!سنصطدم بالبوّابة

17
00:01:47,630 --> 00:01:49,260
!ماذا نفعل؟! ماذا نفعل؟

18
00:01:49,260 --> 00:01:51,800
!تفاديها يا كوكورو-سان

19
00:01:49,260 --> 00:01:51,800
!ماذا نفعل؟

20
00:01:53,220 --> 00:01:56,300
.لا تقلقوا. توجد طريقة

21
00:02:05,900 --> 00:02:07,570
اجتازوا البوّابة الرئيسيّة

22
00:02:07,570 --> 00:02:10,280
.وتوجهوا مباشرة إلى البوّابة الأماميّة للجزيرة الرئيسيّة

23
00:02:26,330 --> 00:02:29,800
!مـ-من هذان؟

24
00:02:43,020 --> 00:02:45,690
!فلتتقدم وحدة البازوكات العملاقة

25
00:02:48,440 --> 00:02:50,360
...إلّم أسرع، فإنّ روبين

26
00:02:53,110 --> 00:02:56,200
.سأجرب ذلك الشيء

27
00:02:56,200 --> 00:02:59,280
!استسلم يا قبعة القش

28
00:03:01,990 --> 00:03:03,200
!أطلقوا

29
00:03:08,420 --> 00:03:09,180
هل نجحنا؟

30
00:03:09,460 --> 00:03:10,540
!سقط إلى الشلّال

31
00:03:17,800 --> 00:03:21,260
!انظروا! لا يزال متعلقًا

32
00:03:23,270 --> 00:03:28,600
.قبعة القش! لا نمانع سحبك إن استسلمت بهدوء

33
00:03:28,600 --> 00:03:29,810
!مستحيل

34
00:03:29,810 --> 00:03:33,730
!يا لعناده! فلتسقط إلى الشلّال

35
00:03:33,730 --> 00:03:34,490
!أيّها الوغد

36
00:03:34,490 --> 00:03:37,110
!قدّموا لي رِجل المساعدة جميعًا

37
00:03:37,110 --> 00:03:38,240
!حسنًا

38
00:03:40,830 --> 00:03:42,290
!ذهب إلى هناك

39
00:03:42,290 --> 00:03:44,160
!هنا! هنا

40
00:03:50,710 --> 00:03:52,670
!حالفني الحظ

41
00:03:58,680 --> 00:04:00,720
!إنّه قبعة القش! أطلقوا

42
00:04:00,720 --> 00:04:03,970
.انتهى بي المطاف إلى مكان جنونيّ

43
00:04:03,970 --> 00:04:06,520
ولكنّي تمكنت من التخلّص من عدد
.كبير منهم دفعة واحدة، لذلك لا بأس

44
00:04:07,190 --> 00:04:08,850
إلّم تخنّي الذاكرة، فإنّ عليّ التقدّم

45
00:04:08,850 --> 00:04:11,110
نحو تلك البناية التي تبدو ذات أهميّة، أليس كذلك؟

46
00:04:11,380 --> 00:04:12,100
!حسنًا

47
00:04:12,220 --> 00:04:14,540
!ذهب إلى هناك! الحقوه

48
00:04:17,570 --> 00:04:19,610
...ثـ-ثقال

49
00:04:19,610 --> 00:04:22,120
،ا-اصعدوا بالترتيب
!بدءًا من الأدنى

50
00:04:22,120 --> 00:04:24,580
!ببطء! ببطء

51
00:04:24,580 --> 00:04:25,830
!لا تهتز أيّها الأحمق

52
00:04:25,830 --> 00:04:28,210
!لست أنا! كانت هبّة ريح

53
00:04:28,210 --> 00:04:30,250
!إنّها مجرّد رياح! أوقفها بعزيمتك

54
00:04:31,830 --> 00:04:37,590
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

55
00:04:43,680 --> 00:04:50,060
فلنعبر هذا البحر الواسع بحثًا

56
00:04:50,060 --> 00:04:56,030
عن معجزة عالميّة لم يرها أيّ أحد من قبل

57
00:04:56,030 --> 00:05:00,910
سنتقدّم للأمام كما نشاء وقلوبنا تنبض

58
00:05:00,910 --> 00:05:07,620
نتبع خطى أولئك الّذي يلاحقون أحلامهم

59
00:05:07,620 --> 00:05:13,580
،مهما كانت اللّيالي عاصفة
،فإن وحّدنا قلوبنا معًا

60
00:05:13,580 --> 00:05:17,840
فسنتمكّن من الاستمرار

61
00:05:17,840 --> 00:05:19,090
!على الدّوام

62
00:05:19,970 --> 00:05:25,810
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

63
00:05:25,810 --> 00:05:31,770
،رغم أنّ هنالك دموعًا ستُذرف
فلا نودّ أن يراها أيّ أحد

64
00:05:31,770 --> 00:05:37,940
،لاحقوه، لاحقوه
،إن أردنا تحقيق أحلامنا

65
00:05:37,940 --> 00:05:40,400
علينا التّقدّم مباشرة للأمام دائمًا دون خوف

66
00:05:40,400 --> 00:05:42,780
لا يمكننا التّوقّف

67
00:05:42,780 --> 00:05:45,780
حول العالم

68
00:05:45,780 --> 00:05:47,910
!ابدؤوا معي

69
00:05:49,870 --> 00:05:55,590
،ابدؤوا الرّكض، ابدؤوا الرّكض
وتجاوزوا الجميع

70
00:05:55,670 --> 00:06:01,800
،وما دمنا لن نهرب منه
فبإمكاننا التّمسّك بالغد بأيدينا

71
00:06:01,800 --> 00:06:07,760
،لاحقوه، لاحقوه
،كلّ شيء نراه أمام أعيننا

72
00:06:07,760 --> 00:06:12,560
فلنحفره في صفحات قلوبنا البيضاء

73
00:06:12,560 --> 00:06:15,560
عالم جديد بالكامل

74
00:06:15,560 --> 00:06:18,110
!ابدؤوا معي

75
00:06:25,380 --> 00:06:29,760
!الحقوا بلوفي"
"!معركة طاقم قبعة القش الشاملة

76
00:06:37,420 --> 00:06:41,090
!لـ-لحظة! أعرف هذا السيّاف

77
00:06:41,090 --> 00:06:44,340
،أجل، إنّه واحد من أتباع قبعة القش
!إنّه صائد القراصنة زورو

78
00:06:45,680 --> 00:06:47,090
.قالوا أنّك تابع

79
00:06:47,090 --> 00:06:50,680
ألست أدنى من ذلك إذًا؟
.أيّها القرصان أ

80
00:06:51,350 --> 00:06:52,270
!ماذا؟

81
00:06:52,270 --> 00:06:53,770
.إذًا، ب

82
00:06:53,770 --> 00:06:58,310
ماذا؟! أيّها اللعين، لو كنت مطلوبًا
!لكانت مكافأتي ضعف مكافأتك

83
00:06:58,310 --> 00:06:59,320
.إذًا ج

84
00:06:59,320 --> 00:07:01,280
!استمع لحديثي أيّها الوغد

85
00:07:01,280 --> 00:07:03,070
.توقّفا

86
00:07:03,070 --> 00:07:04,860
.لا يستطيعان سماعك يا سوغيكينغ

87
00:07:04,860 --> 00:07:07,110
.هذا جزء من خطّتي يا تشوبر-كن

88
00:07:07,110 --> 00:07:08,840
.هكذا إذًا

89
00:07:10,280 --> 00:07:11,740
!يوجد المزيد من رفاقهم عند القطار

90
00:07:11,740 --> 00:07:12,540
!وجدونا

91
00:07:12,540 --> 00:07:13,680
!لا بدّ أنّ ثمّة المزيد منهم

92
00:07:13,820 --> 00:07:15,250
!فجّروه قبل أن يخرجوا

93
00:07:15,250 --> 00:07:17,630
!توقفوا! لا تزال نامي-سان في الداخل

94
00:07:17,630 --> 00:07:19,290
!أطلقوا

95
00:07:25,970 --> 00:07:28,820
!أولئك الأوغاد! سأقطعهم إلى ثلاثة أجزاء

96
00:07:28,820 --> 00:07:30,430
.انتظر أيّها القرصان أ

97
00:07:30,430 --> 00:07:31,470
!ماذا؟

98
00:07:31,470 --> 00:07:33,850
.هجمة كتلك لن تكون كافية للإطاحة بها

99
00:07:33,850 --> 00:07:37,270
أنت مجرد قرصان أ لأنّك لا تدرك
.شيئًا واضحًا كهذا

100
00:07:37,270 --> 00:07:39,560
!يا رأس الطحلب الوغد

101
00:07:41,610 --> 00:07:44,900
!أخافني هذا

102
00:07:46,860 --> 00:07:50,160
هل أنت بخير يا سوغيكينغ؟

103
00:07:50,160 --> 00:07:52,160
.أ-أ-أنا بخير يا تشوبر-كن

104
00:07:52,160 --> 00:07:53,870
!أوقفوا الإطلاق

105
00:07:54,660 --> 00:07:55,660
ما الخطب؟

106
00:07:55,840 --> 00:07:56,820
!انظروا لذلك

107
00:07:56,880 --> 00:07:58,580
!مرحبًا

108
00:07:58,740 --> 00:08:01,580
!توقّفوا! أنا مواطنة كبيرة في السّن

109
00:08:01,660 --> 00:08:06,510
!أنا طفلة وهذا حيوان صغير
!نحن ضعاف

110
00:08:06,920 --> 00:08:12,810
هددني طاقم قبعة القش
!وأرغموني على تسيير القطار

111
00:08:12,810 --> 00:08:14,810
!فعلوا ذلك

112
00:08:20,440 --> 00:08:22,480
من قد يترك رهينته تثمل؟

113
00:08:22,480 --> 00:08:25,780
!كان ذلك وشيكًا! كدنا نقتل رهائن أيضًا

114
00:08:25,780 --> 00:08:28,450
من بين كل الناس، سلب أولئك القراصنة عجوزًا وطفلة

115
00:08:28,450 --> 00:08:30,950
!وحيوانًا صغيرًا... يا لدناءتهم

116
00:08:32,030 --> 00:08:35,450
.ما هذا؟! ذلك الدخان يشابه السّحاب

117
00:08:35,950 --> 00:08:39,000
،باستخدام كرات البرودة وكرات السخونة

118
00:08:39,580 --> 00:08:42,080
.تتحوّل رطوبة الهواء إلى سحاب

119
00:08:42,080 --> 00:08:46,460
!نامي-سان! أفلتِ من الهجوم إذًا

120
00:08:49,220 --> 00:08:53,010
.انظروا، تكبر تلك السّحابة شيئًا فشيئًا

121
00:08:53,010 --> 00:08:56,600
.جدّتي، جدّتي، تكبر السّحابة شيئًا فشيئًا

122
00:08:57,810 --> 00:09:00,240
.تبدو تلك السّحابة خطيرة قليلًا

123
00:09:00,730 --> 00:09:03,190
.تعاليا إلى هنا يا تشيميني وغونبي

124
00:09:05,150 --> 00:09:08,110
.كما هو متوقّع من عصا الطّقس الكاملة

125
00:09:08,110 --> 00:09:11,070
.إنّها تخلق سحبًا أكبر وأسرع بكثير الآن

126
00:09:11,660 --> 00:09:16,830
.حسنًا، لنجرب مدى قوّة صاعقتها الآن

127
00:09:16,830 --> 00:09:21,620
!ستقوم هذه الآنسة بأمر ما
!ربما يستحسن أن نهرب من هنا

128
00:09:22,250 --> 00:09:24,820
!ها أنا ذي

129
00:09:25,380 --> 00:09:28,720
!جوّ الصّاعقة

130
00:09:47,110 --> 00:09:50,530
جدّتي، جدّتي. إنّها صاعقة مذهلة، أليست كذلك؟

131
00:09:54,410 --> 00:09:57,120
.تلك الفتاة مذهلة

132
00:09:57,120 --> 00:09:59,540
جدّتي، هل سنكون بخير تحت هذه المظلّة؟

133
00:09:59,540 --> 00:10:03,370
.ثقي بي. ستكونين بخير ما دمت هنا

134
00:10:09,510 --> 00:10:15,080
!لا

135
00:10:15,740 --> 00:10:17,560
!إنّها تهاجم الجميع! سنموت

136
00:10:17,560 --> 00:10:19,180
!سوغيكينغ

137
00:10:19,200 --> 00:10:21,140
!لماذا ضربتِ سوغيكينغ يا نامي؟

138
00:10:22,180 --> 00:10:24,140
.لا بأس

139
00:10:24,140 --> 00:10:28,730
.لـ-لا تصبّي غضبك عليّ
.تقع المشكلة بطريقة استعمالك لها

140
00:10:28,730 --> 00:10:33,150
علاوة على ذلك، يقول أوسوب-كن أنّه
!لا يتذكّر إضافة تلك الخاصيّة

141
00:10:33,150 --> 00:10:34,110
...على أيّ حال

142
00:10:35,240 --> 00:10:38,370
.يا لها من قوّة مذهلة! أطحتِ بالكثير منهم

143
00:10:42,100 --> 00:10:43,440
!أيّتها اللعينة نامي

144
00:10:43,620 --> 00:10:45,120
!ماذا تفعلين؟

145
00:10:45,500 --> 00:10:47,420
!اعتذر له يا سوغيكينغ

146
00:10:47,420 --> 00:10:49,300
!أنت اعتذري! هل أنت حمقاء؟

147
00:10:49,300 --> 00:10:54,300
نامي-سان! ذكّرتني هذه بالصدمة
!التي تعرضت لها في أوّل مرّة قابلتك فيها

148
00:10:54,300 --> 00:10:56,680
ما خطب هذا الطاقم؟

149
00:10:56,680 --> 00:11:01,180
اعتقدت أنّ تلك الفتاة هنا للدعم
.فحسب، ولكنّها تستطيع القتال جيّدًا

150
00:11:02,060 --> 00:11:04,020
.يبدو أنّ الأمر انتهى

151
00:11:04,020 --> 00:11:07,100
!إنّك مذهلة أيّتها الآنسة القرصانة

152
00:11:07,690 --> 00:11:10,520
!يبدو أنّكم بخير أيضًا أيّتها الجدّة

153
00:11:10,520 --> 00:11:13,780
!عيشي لعدّة عقود ليس محض صدفة

154
00:11:18,280 --> 00:11:22,370
بالمناسبة، أين ذلك الأحمق الذي اندفع لوحده؟

155
00:11:22,370 --> 00:11:27,420
،لا أدري... هذه الجزيرة ليست صغيرة
...لذا إن كنّا سنبحث عنه

156
00:11:27,420 --> 00:11:28,960
!ما كان ذلك؟

157
00:11:30,290 --> 00:11:32,200
!إنّه هناك حتمًا

158
00:11:34,420 --> 00:11:35,840
...حسنًا إذًا

159
00:11:36,430 --> 00:11:37,970
.لنلحقه

160
00:11:44,810 --> 00:11:48,770
...إنّهم محض قراصنة
!كيف يجرؤون على التسبب بهذه الفوضى؟

161
00:11:49,140 --> 00:11:50,180
!لن يفلتوا

162
00:12:21,720 --> 00:12:26,180
!فاكهة المطّاط: الرمح

163
00:12:31,270 --> 00:12:32,860
!قفز إلى الشجرة

164
00:12:35,190 --> 00:12:39,150
!أولئك الأوغاد! لا نهاية لهم
!لا أستطيع التقدّم

165
00:12:39,150 --> 00:12:40,820
!من هنا

166
00:12:41,820 --> 00:12:43,280
!إنّهم يركضون في الاتجاه المعاكس؟

167
00:12:43,780 --> 00:12:46,040
!فليتوجه نصفكم إلى البوّابة الأماميّة للجزيرة الرئيسيّة

168
00:12:46,200 --> 00:12:50,460
!فتح القراصنة البوّابة واخترقوا المكان
!أوقفوهم بأيّ ثمن

169
00:12:50,830 --> 00:12:54,960
!وصلوا إذًا! رائع
!ستسهل الأمور كثيرًا الآن

170
00:12:56,170 --> 00:12:57,040
!رائع

171
00:12:57,280 --> 00:12:58,500
!أخطأتم للأسف

172
00:12:58,680 --> 00:13:01,140
!إنّه هناك! أطلقوا

173
00:13:03,180 --> 00:13:05,060
إن لم تخنّي الذاكرة، فكان من هذا الطريق، أليس كذلك؟

174
00:13:05,060 --> 00:13:06,850
.سنقع في ورطة إن أرشدتنا أنت

175
00:13:06,850 --> 00:13:07,850
!لماذا؟

176
00:13:07,850 --> 00:13:10,230
!لا بأس ما دمنا نتقدّم مباشرة

177
00:13:13,760 --> 00:13:18,240
يا إلهي، اندفع ذلك الأحمق
!لوحده كالعادة

178
00:13:18,580 --> 00:13:22,700
حسنًا، بقاؤنا مع ذلك الأحمق
.يجعلنا حمقى أيضًا

179
00:13:22,700 --> 00:13:27,160
ولكن بفضل لوفي، يبدو أنّ البحرية
.متفرقين في الوقت الراهن

180
00:13:27,480 --> 00:13:30,000
كلّ ما علينا فعله الآن
!هو التوجّه مباشرة نحو المحكمة

181
00:13:30,000 --> 00:13:32,460
...هذا سيّئ، عاد مرضي المميت

182
00:13:32,460 --> 00:13:34,330
.يمكنك البقاء إن أردت الموت

183
00:13:34,330 --> 00:13:35,080
!شفيت

184
00:13:35,120 --> 00:13:35,900
!هذا جيّد

185
00:13:41,080 --> 00:13:43,220
مـ-ما الخطب؟

186
00:13:45,430 --> 00:13:46,850
.ضيوف

187
00:13:57,700 --> 00:14:00,690
!أُمرنا نحن الكلاب الحارسة أن نحمي البوّابة الأماميّة

188
00:14:02,150 --> 00:14:04,880
!لن يجتاز أحد هذا الخط

189
00:14:05,280 --> 00:14:08,540
!استسلموا أيّها الأشرار

190
00:14:12,250 --> 00:14:14,790
شرطة كلاب هذه المرّة؟

191
00:14:14,790 --> 00:14:17,660
!لا تظنّوا أنّنا لوحدنا أيّها القراصنة

192
00:14:34,390 --> 00:14:37,150
.يبدو أنّنا محاصرون بالكامل

193
00:14:37,150 --> 00:14:39,400
،بعد أن أمعنت النظر الآن
!يوجد عدد هائل من الأعداء

194
00:14:41,150 --> 00:14:44,340
.انتهت الحفلة أيّها القراصنة

195
00:14:46,910 --> 00:14:48,910
وما بذلك؟

196
00:14:49,410 --> 00:14:53,160
!يا لغطرستك! نالوا منهم يا رجال

197
00:15:01,210 --> 00:15:02,550
!تشبثوا

198
00:15:20,860 --> 00:15:23,990
...كان بإمكانك أن تسمح لنا الاستمتاع قليلًا

199
00:15:23,990 --> 00:15:25,200
!أيّها الأحمق

200
00:15:26,160 --> 00:15:28,220
.لا تنسوا سبب قدومكم إلى هنا

201
00:15:28,260 --> 00:15:30,620
هذا ليس المكان الذي ينبغي لكم
.أن تركزوا طاقتكم فيه

202
00:15:31,160 --> 00:15:35,210
سيستغرق قتال كلّ هؤلاء الأعداء
.وقتًا طويلًا بالفعل

203
00:15:38,880 --> 00:15:43,540
!تملؤهم الحيويّة. لا تموتوا

204
00:15:43,700 --> 00:15:45,920
!اكتسحوا

205
00:15:49,090 --> 00:15:51,220
!ابتعدوا أيّها الحرس

206
00:15:51,540 --> 00:15:55,140
!هذا كينغ بول من ووتر سيفن
!جهّزوا المدافع حالًا

207
00:15:58,660 --> 00:15:59,880
!سحقًا

208
00:16:00,360 --> 00:16:02,110
!خذ هذه

209
00:16:06,150 --> 00:16:08,860
!لدينا آخر

210
00:16:12,220 --> 00:16:14,950
!كلاب الحراسة! عودوا إلى التشكيلة

211
00:16:14,980 --> 00:16:16,160
!أجل

212
00:16:16,160 --> 00:16:21,210
!لن نسمح لكم بالذهاب
!كلابنا أسرع من سمكتكم

213
00:16:22,280 --> 00:16:24,520
!هذا سيّئ! سيحاولون القفز عليه

214
00:16:24,920 --> 00:16:25,660
!مستحيل

215
00:16:26,100 --> 00:16:27,120
!ألا يمكننا أن نزيد من سرعتنا؟

216
00:16:27,200 --> 00:16:28,800
.أنت، أيّها الطباخ

217
00:16:31,380 --> 00:16:32,200
ما الخطب؟

218
00:16:33,460 --> 00:16:35,350
.تولّ اللجام

219
00:16:37,890 --> 00:16:39,310
...أنتم

220
00:16:54,620 --> 00:16:59,500
...إن رأيتموهم، أخبروهم

221
00:17:01,120 --> 00:17:03,460
".إنّكم مطرودون"

222
00:17:04,840 --> 00:17:06,420
.سنفعل

223
00:17:07,010 --> 00:17:09,550
!اقفزوا عليه

224
00:17:09,550 --> 00:17:11,130
!لن نسمح لكم

225
00:17:11,440 --> 00:17:13,930
!نعتمد عليكم يا غالي-لا

226
00:17:14,430 --> 00:17:16,640
!سنسلخك

227
00:17:16,640 --> 00:17:19,640
!الدفع الهوائي بنصف عقدة

228
00:17:27,280 --> 00:17:30,280
!أ-أطاح ببعض من كلاب الحراسة

229
00:17:30,280 --> 00:17:33,100
!أرخى أولئك الحمقى دفاعاتهم

230
00:17:33,160 --> 00:17:37,490
!يستحيل أن يجاري الأشخاص العاديين سرعتنا. انطلقوا

231
00:17:37,490 --> 00:17:38,790
!أجل

232
00:17:38,790 --> 00:17:42,460
!سنقطعك قبل أن تلاحظ

233
00:17:49,340 --> 00:17:51,760
!أطاحوا بالمزيد

234
00:17:53,180 --> 00:17:54,640
!ما خطبهم؟

235
00:17:58,270 --> 00:18:01,480
!إنّهم أقوياء

236
00:18:09,150 --> 00:18:11,860
.سنعتني بهؤلاء

237
00:18:24,750 --> 00:18:29,800
.يبدو أنّ طباعك لم تتغيّر عن ذلك الوقت يا كاتي فلام

238
00:18:29,800 --> 00:18:35,340
،لو أدركت باكرًا أنّك حيّ وتملك المخططات

239
00:18:35,340 --> 00:18:37,720
...لم أكن سأضطر للمرور بكلّ هذه المتاعب

240
00:18:38,350 --> 00:18:45,560
بما أنّنا نستطيع أن نسحبك
!إلى هنا لجرائمك السابقة

241
00:18:46,400 --> 00:18:51,860
وعلى نقيض ذلك، زميلك التلميذ الأكبر
.أيسبرغ كان مزعجًا حقًا

242
00:18:52,400 --> 00:18:53,540
،بعد موت توم

243
00:18:53,660 --> 00:18:56,700
لمّ شمل شركات بناء السفن في ووتر سيفن

244
00:18:56,700 --> 00:19:00,080
وأدار شركة كبيرة لوحده. ومن ثم

245
00:19:00,080 --> 00:19:04,870
اقترب من حكومة العالم
،التي كان من المفترض أنّه يكن ضغينة ضدها

246
00:19:04,870 --> 00:19:07,040
ورسّخت شركته مكانتها بسرعة

247
00:19:07,040 --> 00:19:09,710
.ممولةً لحكومة العالم

248
00:19:10,500 --> 00:19:13,630
إنّه رئيس شركة بناء السفن غالي-لا

249
00:19:13,630 --> 00:19:16,840
.وعمدة مدينة الماء، ووتر سيفن

250
00:19:17,930 --> 00:19:20,060
بعد أن أصبح قامة يدعمها الجميع

251
00:19:20,060 --> 00:19:23,100
،وكان لا غنى عنه بالنسبة للحكومة

252
00:19:23,100 --> 00:19:27,810
.لم نتمكن من العبث معه دون حذر

253
00:19:29,270 --> 00:19:33,280
سمعت أنّ شركتك تتعاقد لبناء
!السفن لحكومة العالم

254
00:19:33,280 --> 00:19:36,780
!لا تعبث معي! لن أسمح بذلك أبدًا

255
00:19:37,740 --> 00:19:41,030
...لذلك كان يتعاقد مع الحكومة إذًا

256
00:19:41,030 --> 00:19:44,750
.كان رجلًا ذكيًّا

257
00:19:46,830 --> 00:19:50,500
.ولكن، هبّت الرياح لصالحي

258
00:19:50,500 --> 00:19:55,670
عندما ضقت ذرعًا ولم أستطع الانتظار أكثر
...وكدت أن آخذ تدابير قسريّة

259
00:19:55,670 --> 00:19:59,090
.بشّرني الأميرال أوكيجي بأنباء طيّبة

260
00:19:59,720 --> 00:20:05,560
أنّ نيكو روبين متوجهة إلى ووتر سيفن
.على متن سفينة قراصنة

261
00:20:06,230 --> 00:20:10,270
شربت كأسًا من القهوة لتهدئة نفسي

262
00:20:10,720 --> 00:20:16,240
ووفرت كلّ الظروف الملائمة
.لخطّة العمليّات بما فيها نداء الدّمار

263
00:20:16,240 --> 00:20:19,950
،ولكن كان هناك تغيير بسيط في الخطط

264
00:20:20,380 --> 00:20:27,410
!ولكن انظروا! محفزا عودة السّلاح العتيق هنا الآن

265
00:20:30,250 --> 00:20:35,800
!أتفهمان؟! تهبّ رياح العالم أجمع لصالحي الآن

266
00:20:42,720 --> 00:20:49,020
تقع بين يديّ الآن قوّة كافية
!لتعطيني التحكّم بأيّ دولة كبيرة أريدها

267
00:20:50,650 --> 00:20:54,980
لماذا منحك أوكيجي صلاحية استخدام نداء الدّمار؟

268
00:21:18,510 --> 00:21:22,700
!لا تطرحي عليّ الأسئلة أيّها المرأة الوقحة

269
00:21:23,960 --> 00:21:27,810
،لو أنّي لم أشهد بقيمة وجودك

270
00:21:27,810 --> 00:21:29,770
!فقد كنتِ بلا قيمة

271
00:21:32,400 --> 00:21:36,270
!عليك أن تكوني ممتنة لي

272
00:21:37,560 --> 00:21:41,540
...يا نسيبة أوهارا، أرض الشياطين البغيضة

273
00:21:42,200 --> 00:21:44,200
...نيكو روبين

274
00:21:49,200 --> 00:21:53,380
نقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

275
00:21:53,380 --> 00:21:57,300
نندفع للأمام بشدّة بقوّة متدفّقة

276
00:21:57,300 --> 00:22:01,420
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

277
00:22:01,420 --> 00:22:04,430
لأنّ كلّ ذلك لضمان أن نبتسم في النّهاية

278
00:22:05,350 --> 00:22:07,720
سنصبح الرّقم 1

279
00:22:07,720 --> 00:22:09,560
وسيكون هدفنا الحرّيّة في عالم العجائب

280
00:22:09,560 --> 00:22:11,770
انظروا، ثمّة نور خافت يرشدنا في الطّريق نحو الغد

281
00:22:11,770 --> 00:22:13,940
إنّه عصر صُنِع بالمخاطرة بكلّ شيء

282
00:22:13,940 --> 00:22:16,060
!نحاول دائمًا بذل ما بوسعنا، فهيّا بنا

283
00:22:16,060 --> 00:22:18,070
،إن أردنا أن ننال المجد

284
00:22:18,070 --> 00:22:19,480
فالآن هو الوقت لذلك... فلا تخافوا

285
00:22:19,480 --> 00:22:21,400
سنفوز بالمستقبل مع أصدقائنا بكلّ تأكيد

286
00:22:21,400 --> 00:22:25,370
والآن، سنبدأ الرّكض بسرعة نحو عالم واسع

287
00:22:25,370 --> 00:22:29,330
لا يمكننا الانطلاق بقوى مجهولة

288
00:22:29,330 --> 00:22:31,580
فلا خوف بداخلنا ولا تردّد

289
00:22:31,580 --> 00:22:35,380
...مهما حدث، فبالتّأكيد في النّهاية

290
00:22:35,380 --> 00:22:39,340
سنقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

291
00:22:39,340 --> 00:22:43,300
نندفع للأمام بشدّة بقوّة متدفّقة

292
00:22:43,300 --> 00:22:47,550
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

293
00:22:47,550 --> 00:22:49,560
لنندفع للأمام

294
00:22:49,560 --> 00:22:51,470
لنبدأ الرّكض نحو الغد

295
00:22:51,470 --> 00:22:54,440
لأنّ كلّ ذلك لضمان أن نبتسم في النّهاية

296
00:23:01,480 --> 00:23:03,460
!انتظر! هذا ليس ما اتفقنا عليه

297
00:23:03,540 --> 00:23:04,620
ما اتفقنا عليه؟

298
00:23:04,700 --> 00:23:07,300
!أن يغادر طاقم قبعة القش ووتر سيفن بأمان

299
00:23:07,360 --> 00:23:08,560
!صحيح

300
00:23:09,060 --> 00:23:15,330
،غادروا ووتر سيفن بأمان
وهم هنا الآن، أليس كذلك؟

301
00:23:15,920 --> 00:23:16,820
...لا يمكن

302
00:23:17,100 --> 00:23:18,640
:في الحلقة القادمة من وان بيس

303
00:23:18,720 --> 00:23:21,920
!روبين المغدورة"
"!دافع حكومة العالم

304
00:23:21,920 --> 00:23:24,420
!ملك القراصنة، لن يكون إلاّ أنا