1
00:00:29,080 --> 00:00:32,920
.نُقل كلٌ من فرانكي وروبين إلى برج القانون

2
00:00:38,960 --> 00:00:40,800
!هذا أروع شعور

3
00:00:40,800 --> 00:00:47,300
من المفاجئ أنّك تمكنت من النجاة
.من تلك الحادثة قبل ثمان سنوات يا كاتي فلام

4
00:00:47,300 --> 00:00:51,390
.تحقيق الأهداف مستحيل بلا تضحيات

5
00:00:51,390 --> 00:00:55,600
.إنّنا نعمل لضمان سلام البشريّة أجمع

6
00:00:57,020 --> 00:00:58,650
!إنّك مختل

7
00:00:58,650 --> 00:01:01,570
وضع توم-سان حياته على المحك لحماية المخططات

8
00:01:01,570 --> 00:01:04,660
!لوجود أغبياء مثلك

9
00:01:10,700 --> 00:01:12,330
!يوي

10
00:01:14,660 --> 00:01:17,920
وفي تلك الأثناء، كان لوفي يقاتل 10000 جندي

11
00:01:17,920 --> 00:01:21,130
.في جزيرة إنيس لوبي الرئيسيّة

12
00:01:28,800 --> 00:01:32,350
!أرجوك استجب أيّها الرئيس سباندام
!وجهنا باتخاذ التدابير المضادّة

13
00:01:32,350 --> 00:01:34,850
!لا نستطيع إيقاف قبعة القش لوفي

14
00:01:49,780 --> 00:01:54,290
وفي تلك الأثناء، زورو والبقيّة
الذين كانوا ينتظرون فتح البوّابات

15
00:01:54,290 --> 00:01:57,290
على متن الرجل الصاروخ، اقتحموا المكان
...بعد تحضير دقيق

16
00:01:58,790 --> 00:02:01,630
!ماذا؟! هذه مصيبة
!سنصطدم بالبوّابة

17
00:02:01,630 --> 00:02:03,260
!ماذا نفعل؟! ماذا نفعل؟

18
00:02:03,260 --> 00:02:05,800
!تفاديها يا كوكورو-سان

19
00:02:03,260 --> 00:02:05,800
!ماذا نفعل؟

20
00:02:07,220 --> 00:02:10,300
.لا تقلقوا. توجد طريقة

21
00:02:19,900 --> 00:02:21,570
اجتازوا البوّابة الرئيسيّة

22
00:02:21,570 --> 00:02:24,280
.وتوجهوا مباشرة إلى البوّابة الأماميّة للجزيرة الرئيسيّة

23
00:02:40,330 --> 00:02:43,800
!مـ-من هذان؟

24
00:02:57,020 --> 00:02:59,690
!فلتتقدم وحدة البازوكات العملاقة

25
00:03:02,440 --> 00:03:04,360
...إلّم أسرع، فإنّ روبين

26
00:03:07,110 --> 00:03:10,200
.سأجرب ذلك الشيء

27
00:03:10,200 --> 00:03:13,280
!استسلم يا قبعة القش

28
00:03:15,990 --> 00:03:17,200
!أطلقوا

29
00:03:22,420 --> 00:03:23,180
هل نجحنا؟

30
00:03:23,460 --> 00:03:24,540
!سقط إلى الشلّال

31
00:03:31,800 --> 00:03:35,260
!انظروا! لا يزال متعلقًا

32
00:03:37,270 --> 00:03:42,600
.قبعة القش! لا نمانع سحبك إن استسلمت بهدوء

33
00:03:42,600 --> 00:03:43,810
!مستحيل

34
00:03:43,810 --> 00:03:47,730
!يا لعناده! فلتسقط إلى الشلّال

35
00:03:47,730 --> 00:03:48,490
!أيّها الوغد

36
00:03:48,490 --> 00:03:51,110
!قدّموا لي رِجل المساعدة جميعًا

37
00:03:51,110 --> 00:03:52,240
!حسنًا

38
00:03:54,830 --> 00:03:56,290
!ذهب إلى هناك

39
00:03:56,290 --> 00:03:58,160
!هنا! هنا

40
00:04:04,710 --> 00:04:06,670
!حالفني الحظ

41
00:04:12,680 --> 00:04:14,720
!إنّه قبعة القش! أطلقوا

42
00:04:14,720 --> 00:04:17,970
.انتهى بي المطاف إلى مكان جنونيّ

43
00:04:17,970 --> 00:04:20,520
ولكنّي تمكنت من التخلّص من عدد
.كبير منهم دفعة واحدة، لذلك لا بأس

44
00:04:21,190 --> 00:04:22,850
إلّم تخنّي الذاكرة، فإنّ عليّ التقدّم

45
00:04:22,850 --> 00:04:25,110
نحو تلك البناية التي تبدو ذات أهميّة، أليس كذلك؟

46
00:04:25,380 --> 00:04:26,100
!حسنًا

47
00:04:26,220 --> 00:04:28,540
!ذهب إلى هناك! الحقوه

48
00:04:31,570 --> 00:04:33,610
...ثـ-ثقال

49
00:04:33,610 --> 00:04:36,120
،ا-اصعدوا بالترتيب
!بدءًا من الأدنى

50
00:04:36,120 --> 00:04:38,580
!ببطء! ببطء

51
00:04:38,580 --> 00:04:39,830
!لا تهتز أيّها الأحمق

52
00:04:39,830 --> 00:04:42,210
!لست أنا! كانت هبّة ريح

53
00:04:42,210 --> 00:04:44,250
!إنّها مجرّد رياح! أوقفها بعزيمتك

54
00:04:45,830 --> 00:04:51,590
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

55
00:04:57,680 --> 00:05:04,060
فلنعبر هذا البحر الواسع بحثًا

56
00:05:04,060 --> 00:05:10,030
عن معجزة عالميّة لم يرها أيّ أحد من قبل

57
00:05:10,030 --> 00:05:14,910
سنتقدّم للأمام كما نشاء وقلوبنا تنبض

58
00:05:14,910 --> 00:05:21,620
نتبع خطى أولئك الّذي يلاحقون أحلامهم

59
00:05:21,620 --> 00:05:27,580
،مهما كانت اللّيالي عاصفة
،فإن وحّدنا قلوبنا معًا

60
00:05:27,580 --> 00:05:31,840
فسنتمكّن من الاستمرار

61
00:05:31,840 --> 00:05:33,090
!على الدّوام

62
00:05:33,970 --> 00:05:39,810
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

63
00:05:39,810 --> 00:05:45,770
،رغم أنّ هنالك دموعًا ستُذرف
فلا نودّ أن يراها أيّ أحد

64
00:05:45,770 --> 00:05:51,940
،لاحقوه، لاحقوه
،إن أردنا تحقيق أحلامنا

65
00:05:51,940 --> 00:05:54,400
علينا التّقدّم مباشرة للأمام دائمًا دون خوف

66
00:05:54,400 --> 00:05:56,780
لا يمكننا التّوقّف

67
00:05:56,780 --> 00:05:59,780
حول العالم

68
00:05:59,780 --> 00:06:01,910
!ابدؤوا معي

69
00:06:03,870 --> 00:06:09,590
،ابدؤوا الرّكض، ابدؤوا الرّكض
وتجاوزوا الجميع

70
00:06:09,670 --> 00:06:15,800
،وما دمنا لن نهرب منه
فبإمكاننا التّمسّك بالغد بأيدينا

71
00:06:15,800 --> 00:06:21,760
،لاحقوه، لاحقوه
،كلّ شيء نراه أمام أعيننا

72
00:06:21,760 --> 00:06:26,560
فلنحفره في صفحات قلوبنا البيضاء

73
00:06:26,560 --> 00:06:29,560
عالم جديد بالكامل

74
00:06:29,560 --> 00:06:32,110
!ابدؤوا معي

75
00:06:39,380 --> 00:06:43,760
!الحقوا بلوفي"
"!معركة طاقم قبعة القش الشاملة

76
00:06:51,420 --> 00:06:55,090
!لـ-لحظة! أعرف هذا السيّاف

77
00:06:55,090 --> 00:06:58,340
،أجل، إنّه واحد من أتباع قبعة القش
!إنّه صائد القراصنة زورو

78
00:06:59,680 --> 00:07:01,090
.قالوا أنّك تابع

79
00:07:01,090 --> 00:07:04,680
ألست أدنى من ذلك إذًا؟
.أيّها القرصان أ

80
00:07:05,350 --> 00:07:06,270
!ماذا؟

81
00:07:06,270 --> 00:07:07,770
.إذًا، ب

82
00:07:07,770 --> 00:07:12,310
ماذا؟! أيّها اللعين، لو كنت مطلوبًا
!لكانت مكافأتي ضعف مكافأتك

83
00:07:12,310 --> 00:07:13,320
.إذًا ج

84
00:07:13,320 --> 00:07:15,280
!استمع لحديثي أيّها الوغد

85
00:07:15,280 --> 00:07:17,070
.توقّفا

86
00:07:17,070 --> 00:07:18,860
.لا يستطيعان سماعك يا سوغيكينغ

87
00:07:18,860 --> 00:07:21,110
.هذا جزء من خطّتي يا تشوبر-كن

88
00:07:21,110 --> 00:07:22,840
.هكذا إذًا

89
00:07:24,280 --> 00:07:25,740
!يوجد المزيد من رفاقهم عند القطار

90
00:07:25,740 --> 00:07:26,540
!وجدونا

91
00:07:26,540 --> 00:07:27,680
!لا بدّ أنّ ثمّة المزيد منهم

92
00:07:27,820 --> 00:07:29,250
!فجّروه قبل أن يخرجوا

93
00:07:29,250 --> 00:07:31,630
!توقفوا! لا تزال نامي-سان في الداخل

94
00:07:31,630 --> 00:07:33,290
!أطلقوا

95
00:07:39,970 --> 00:07:42,820
!أولئك الأوغاد! سأقطعهم إلى ثلاثة أجزاء

96
00:07:42,820 --> 00:07:44,430
.انتظر أيّها القرصان أ

97
00:07:44,430 --> 00:07:45,470
!ماذا؟

98
00:07:45,470 --> 00:07:47,850
.هجمة كتلك لن تكون كافية للإطاحة بها

99
00:07:47,850 --> 00:07:51,270
أنت مجرد قرصان أ لأنّك لا تدرك
.شيئًا واضحًا كهذا

100
00:07:51,270 --> 00:07:53,560
!يا رأس الطحلب الوغد

101
00:07:55,610 --> 00:07:58,900
!أخافني هذا

102
00:08:00,860 --> 00:08:04,160
هل أنت بخير يا سوغيكينغ؟

103
00:08:04,160 --> 00:08:06,160
.أ-أ-أنا بخير يا تشوبر-كن

104
00:08:06,160 --> 00:08:07,870
!أوقفوا الإطلاق

105
00:08:08,660 --> 00:08:09,660
ما الخطب؟

106
00:08:09,840 --> 00:08:10,820
!انظروا لذلك

107
00:08:10,880 --> 00:08:12,580
!مرحبًا

108
00:08:12,740 --> 00:08:15,580
!توقّفوا! أنا مواطنة كبيرة في السّن

109
00:08:15,660 --> 00:08:20,510
!أنا طفلة وهذا حيوان صغير
!نحن ضعاف

110
00:08:20,920 --> 00:08:26,810
هددني طاقم قبعة القش
!وأرغموني على تسيير القطار

111
00:08:26,810 --> 00:08:28,810
!فعلوا ذلك

112
00:08:34,440 --> 00:08:36,480
من قد يترك رهينته تثمل؟

113
00:08:36,480 --> 00:08:39,780
!كان ذلك وشيكًا! كدنا نقتل رهائن أيضًا

114
00:08:39,780 --> 00:08:42,450
من بين كل الناس، سلب أولئك القراصنة عجوزًا وطفلة

115
00:08:42,450 --> 00:08:44,950
!وحيوانًا صغيرًا... يا لدناءتهم

116
00:08:46,030 --> 00:08:49,450
.ما هذا؟! ذلك الدخان يشابه السّحاب

117
00:08:49,950 --> 00:08:53,000
،باستخدام كرات البرودة وكرات السخونة

118
00:08:53,580 --> 00:08:56,080
.تتحوّل رطوبة الهواء إلى سحاب

119
00:08:56,080 --> 00:09:00,460
!نامي-سان! أفلتِ من الهجوم إذًا

120
00:09:03,220 --> 00:09:07,010
.انظروا، تكبر تلك السّحابة شيئًا فشيئًا

121
00:09:07,010 --> 00:09:10,600
.جدّتي، جدّتي، تكبر السّحابة شيئًا فشيئًا

122
00:09:11,810 --> 00:09:14,240
.تبدو تلك السّحابة خطيرة قليلًا

123
00:09:14,730 --> 00:09:17,190
.تعاليا إلى هنا يا تشيميني وغونبي

124
00:09:19,150 --> 00:09:22,110
.كما هو متوقّع من عصا الطّقس الكاملة

125
00:09:22,110 --> 00:09:25,070
.إنّها تخلق سحبًا أكبر وأسرع بكثير الآن

126
00:09:25,660 --> 00:09:30,830
.حسنًا، لنجرب مدى قوّة صاعقتها الآن

127
00:09:30,830 --> 00:09:35,620
!ستقوم هذه الآنسة بأمر ما
!ربما يستحسن أن نهرب من هنا

128
00:09:36,250 --> 00:09:38,820
!ها أنا ذي

129
00:09:39,380 --> 00:09:42,720
!جوّ الصّاعقة

130
00:10:01,110 --> 00:10:04,530
جدّتي، جدّتي. إنّها صاعقة مذهلة، أليست كذلك؟

131
00:10:08,410 --> 00:10:11,120
.تلك الفتاة مذهلة

132
00:10:11,120 --> 00:10:13,540
جدّتي، هل سنكون بخير تحت هذه المظلّة؟

133
00:10:13,540 --> 00:10:17,370
.ثقي بي. ستكونين بخير ما دمت هنا

134
00:10:23,510 --> 00:10:29,080
!لا

135
00:10:29,740 --> 00:10:31,560
!إنّها تهاجم الجميع! سنموت

136
00:10:31,560 --> 00:10:33,180
!سوغيكينغ

137
00:10:33,200 --> 00:10:35,140
!لماذا ضربتِ سوغيكينغ يا نامي؟

138
00:10:36,180 --> 00:10:38,140
.لا بأس

139
00:10:38,140 --> 00:10:42,730
.لـ-لا تصبّي غضبك عليّ
.تقع المشكلة بطريقة استعمالك لها

140
00:10:42,730 --> 00:10:47,150
علاوة على ذلك، يقول أوسوب-كن أنّه
!لا يتذكّر إضافة تلك الخاصيّة

141
00:10:47,150 --> 00:10:48,110
...على أيّ حال

142
00:10:49,240 --> 00:10:52,370
.يا لها من قوّة مذهلة! أطحتِ بالكثير منهم

143
00:10:56,100 --> 00:10:57,440
!أيّتها اللعينة نامي

144
00:10:57,620 --> 00:10:59,120
!ماذا تفعلين؟

145
00:10:59,500 --> 00:11:01,420
!اعتذر له يا سوغيكينغ

146
00:11:01,420 --> 00:11:03,300
!أنت اعتذري! هل أنت حمقاء؟

147
00:11:03,300 --> 00:11:08,300
نامي-سان! ذكّرتني هذه بالصدمة
!التي تعرضت لها في أوّل مرّة قابلتك فيها

148
00:11:08,300 --> 00:11:10,680
ما خطب هذا الطاقم؟

149
00:11:10,680 --> 00:11:15,180
اعتقدت أنّ تلك الفتاة هنا للدعم
.فحسب، ولكنّها تستطيع القتال جيّدًا

150
00:11:16,060 --> 00:11:18,020
.يبدو أنّ الأمر انتهى

151
00:11:18,020 --> 00:11:21,100
!إنّك مذهلة أيّتها الآنسة القرصانة

152
00:11:21,690 --> 00:11:24,520
!يبدو أنّكم بخير أيضًا أيّتها الجدّة

153
00:11:24,520 --> 00:11:27,780
!عيشي لعدّة عقود ليس محض صدفة

154
00:11:32,280 --> 00:11:36,370
بالمناسبة، أين ذلك الأحمق الذي اندفع لوحده؟

155
00:11:36,370 --> 00:11:41,420
،لا أدري... هذه الجزيرة ليست صغيرة
...لذا إن كنّا سنبحث عنه

156
00:11:41,420 --> 00:11:42,960
!ما كان ذلك؟

157
00:11:44,290 --> 00:11:46,200
!إنّه هناك حتمًا

158
00:11:48,420 --> 00:11:49,840
...حسنًا إذًا

159
00:11:50,430 --> 00:11:51,970
.لنلحقه

160
00:11:58,810 --> 00:12:02,770
...إنّهم محض قراصنة
!كيف يجرؤون على التسبب بهذه الفوضى؟

161
00:12:03,140 --> 00:12:04,180
!لن يفلتوا

162
00:12:35,720 --> 00:12:40,180
!فاكهة المطّاط: الرمح

163
00:12:45,270 --> 00:12:46,860
!قفز إلى الشجرة

164
00:12:49,190 --> 00:12:53,150
!أولئك الأوغاد! لا نهاية لهم
!لا أستطيع التقدّم

165
00:12:53,150 --> 00:12:54,820
!من هنا

166
00:12:55,820 --> 00:12:57,280
!إنّهم يركضون في الاتجاه المعاكس؟

167
00:12:57,780 --> 00:13:00,040
!فليتوجه نصفكم إلى البوّابة الأماميّة للجزيرة الرئيسيّة

168
00:13:00,200 --> 00:13:04,460
!فتح القراصنة البوّابة واخترقوا المكان
!أوقفوهم بأيّ ثمن

169
00:13:04,830 --> 00:13:08,960
!وصلوا إذًا! رائع
!ستسهل الأمور كثيرًا الآن

170
00:13:10,170 --> 00:13:11,040
!رائع

171
00:13:11,280 --> 00:13:12,500
!أخطأتم للأسف

172
00:13:12,680 --> 00:13:15,140
!إنّه هناك! أطلقوا

173
00:13:17,180 --> 00:13:19,060
إن لم تخنّي الذاكرة، فكان من هذا الطريق، أليس كذلك؟

174
00:13:19,060 --> 00:13:20,850
.سنقع في ورطة إن أرشدتنا أنت

175
00:13:20,850 --> 00:13:21,850
!لماذا؟

176
00:13:21,850 --> 00:13:24,230
!لا بأس ما دمنا نتقدّم مباشرة

177
00:13:27,760 --> 00:13:32,240
يا إلهي، اندفع ذلك الأحمق
!لوحده كالعادة

178
00:13:32,580 --> 00:13:36,700
حسنًا، بقاؤنا مع ذلك الأحمق
.يجعلنا حمقى أيضًا

179
00:13:36,700 --> 00:13:41,160
ولكن بفضل لوفي، يبدو أنّ البحرية
.متفرقين في الوقت الراهن

180
00:13:41,480 --> 00:13:44,000
كلّ ما علينا فعله الآن
!هو التوجّه مباشرة نحو المحكمة

181
00:13:44,000 --> 00:13:46,460
...هذا سيّئ، عاد مرضي المميت

182
00:13:46,460 --> 00:13:48,330
.يمكنك البقاء إن أردت الموت

183
00:13:48,330 --> 00:13:49,080
!شفيت

184
00:13:49,120 --> 00:13:49,900
!هذا جيّد

185
00:13:55,080 --> 00:13:57,220
مـ-ما الخطب؟

186
00:13:59,430 --> 00:14:00,850
.ضيوف

187
00:14:11,700 --> 00:14:14,690
!أُمرنا نحن الكلاب الحارسة أن نحمي البوّابة الأماميّة

188
00:14:16,150 --> 00:14:18,880
!لن يجتاز أحد هذا الخط

189
00:14:19,280 --> 00:14:22,540
!استسلموا أيّها الأشرار

190
00:14:26,250 --> 00:14:28,790
شرطة كلاب هذه المرّة؟

191
00:14:28,790 --> 00:14:31,660
!لا تظنّوا أنّنا لوحدنا أيّها القراصنة

192
00:14:48,390 --> 00:14:51,150
.يبدو أنّنا محاصرون بالكامل

193
00:14:51,150 --> 00:14:53,400
،بعد أن أمعنت النظر الآن
!يوجد عدد هائل من الأعداء

194
00:14:55,150 --> 00:14:58,340
.انتهت الحفلة أيّها القراصنة

195
00:15:00,910 --> 00:15:02,910
وما بذلك؟

196
00:15:03,410 --> 00:15:07,160
!يا لغطرستك! نالوا منهم يا رجال

197
00:15:15,210 --> 00:15:16,550
!تشبثوا

198
00:15:34,860 --> 00:15:37,990
...كان بإمكانك أن تسمح لنا الاستمتاع قليلًا

199
00:15:37,990 --> 00:15:39,200
!أيّها الأحمق

200
00:15:40,160 --> 00:15:42,220
.لا تنسوا سبب قدومكم إلى هنا

201
00:15:42,260 --> 00:15:44,620
هذا ليس المكان الذي ينبغي لكم
.أن تركزوا طاقتكم فيه

202
00:15:45,160 --> 00:15:49,210
سيستغرق قتال كلّ هؤلاء الأعداء
.وقتًا طويلًا بالفعل

203
00:15:52,880 --> 00:15:57,540
!تملؤهم الحيويّة. لا تموتوا

204
00:15:57,700 --> 00:15:59,920
!اكتسحوا

205
00:16:03,090 --> 00:16:05,220
!ابتعدوا أيّها الحرس

206
00:16:05,540 --> 00:16:09,140
!هذا كينغ بول من ووتر سيفن
!جهّزوا المدافع حالًا

207
00:16:12,660 --> 00:16:13,880
!سحقًا

208
00:16:14,360 --> 00:16:16,110
!خذ هذه

209
00:16:20,150 --> 00:16:22,860
!لدينا آخر

210
00:16:26,220 --> 00:16:28,950
!كلاب الحراسة! عودوا إلى التشكيلة

211
00:16:28,980 --> 00:16:30,160
!أجل

212
00:16:30,160 --> 00:16:35,210
!لن نسمح لكم بالذهاب
!كلابنا أسرع من سمكتكم

213
00:16:36,280 --> 00:16:38,520
!هذا سيّئ! سيحاولون القفز عليه

214
00:16:38,920 --> 00:16:39,660
!مستحيل

215
00:16:40,100 --> 00:16:41,120
!ألا يمكننا أن نزيد من سرعتنا؟

216
00:16:41,200 --> 00:16:42,800
.أنت، أيّها الطباخ

217
00:16:45,380 --> 00:16:46,200
ما الخطب؟

218
00:16:47,460 --> 00:16:49,350
.تولّ اللجام

219
00:16:51,890 --> 00:16:53,310
...أنتم

220
00:17:08,620 --> 00:17:13,500
...إن رأيتموهم، أخبروهم

221
00:17:15,120 --> 00:17:17,460
".إنّكم مطرودون"

222
00:17:18,840 --> 00:17:20,420
.سنفعل

223
00:17:21,010 --> 00:17:23,550
!اقفزوا عليه

224
00:17:23,550 --> 00:17:25,130
!لن نسمح لكم

225
00:17:25,440 --> 00:17:27,930
!نعتمد عليكم يا غالي-لا

226
00:17:28,430 --> 00:17:30,640
!سنسلخك

227
00:17:30,640 --> 00:17:33,640
!الدفع الهوائي بنصف عقدة

228
00:17:41,280 --> 00:17:44,280
!أ-أطاح ببعض من كلاب الحراسة

229
00:17:44,280 --> 00:17:47,100
!أرخى أولئك الحمقى دفاعاتهم

230
00:17:47,160 --> 00:17:51,490
!يستحيل أن يجاري الأشخاص العاديين سرعتنا. انطلقوا

231
00:17:51,490 --> 00:17:52,790
!أجل

232
00:17:52,790 --> 00:17:56,460
!سنقطعك قبل أن تلاحظ

233
00:18:03,340 --> 00:18:05,760
!أطاحوا بالمزيد

234
00:18:07,180 --> 00:18:08,640
!ما خطبهم؟

235
00:18:12,270 --> 00:18:15,480
!إنّهم أقوياء

236
00:18:23,150 --> 00:18:25,860
.سنعتني بهؤلاء

237
00:18:38,750 --> 00:18:43,800
.يبدو أنّ طباعك لم تتغيّر عن ذلك الوقت يا كاتي فلام

238
00:18:43,800 --> 00:18:49,340
،لو أدركت باكرًا أنّك حيّ وتملك المخططات

239
00:18:49,340 --> 00:18:51,720
...لم أكن سأضطر للمرور بكلّ هذه المتاعب

240
00:18:52,350 --> 00:18:59,560
بما أنّنا نستطيع أن نسحبك
!إلى هنا لجرائمك السابقة

241
00:19:00,400 --> 00:19:05,860
وعلى نقيض ذلك، زميلك التلميذ الأكبر
.أيسبرغ كان مزعجًا حقًا

242
00:19:06,400 --> 00:19:07,540
،بعد موت توم

243
00:19:07,660 --> 00:19:10,700
لمّ شمل شركات بناء السفن في ووتر سيفن

244
00:19:10,700 --> 00:19:14,080
وأدار شركة كبيرة لوحده. ومن ثم

245
00:19:14,080 --> 00:19:18,870
اقترب من حكومة العالم
،التي كان من المفترض أنّه يكن ضغينة ضدها

246
00:19:18,870 --> 00:19:21,040
ورسّخت شركته مكانتها بسرعة

247
00:19:21,040 --> 00:19:23,710
.ممولةً لحكومة العالم

248
00:19:24,500 --> 00:19:27,630
إنّه رئيس شركة بناء السفن غالي-لا

249
00:19:27,630 --> 00:19:30,840
.وعمدة مدينة الماء، ووتر سيفن

250
00:19:31,930 --> 00:19:34,060
بعد أن أصبح قامة يدعمها الجميع

251
00:19:34,060 --> 00:19:37,100
،وكان لا غنى عنه بالنسبة للحكومة

252
00:19:37,100 --> 00:19:41,810
.لم نتمكن من العبث معه دون حذر

253
00:19:43,270 --> 00:19:47,280
سمعت أنّ شركتك تتعاقد لبناء
!السفن لحكومة العالم

254
00:19:47,280 --> 00:19:50,780
!لا تعبث معي! لن أسمح بذلك أبدًا

255
00:19:51,740 --> 00:19:55,030
...لذلك كان يتعاقد مع الحكومة إذًا

256
00:19:55,030 --> 00:19:58,750
.كان رجلًا ذكيًّا

257
00:20:00,830 --> 00:20:04,500
.ولكن، هبّت الرياح لصالحي

258
00:20:04,500 --> 00:20:09,670
عندما ضقت ذرعًا ولم أستطع الانتظار أكثر
...وكدت أن آخذ تدابير قسريّة

259
00:20:09,670 --> 00:20:13,090
.بشّرني الأميرال أوكيجي بأنباء طيّبة

260
00:20:13,720 --> 00:20:19,560
أنّ نيكو روبين متوجهة إلى ووتر سيفن
.على متن سفينة قراصنة

261
00:20:20,230 --> 00:20:24,270
شربت كأسًا من القهوة لتهدئة نفسي

262
00:20:24,720 --> 00:20:30,240
ووفرت كلّ الظروف الملائمة
.لخطّة العمليّات بما فيها نداء الدّمار

263
00:20:30,240 --> 00:20:33,950
،ولكن كان هناك تغيير بسيط في الخطط

264
00:20:34,380 --> 00:20:41,410
!ولكن انظروا! محفزا عودة السّلاح العتيق هنا الآن

265
00:20:44,250 --> 00:20:49,800
!أتفهمان؟! تهبّ رياح العالم أجمع لصالحي الآن

266
00:20:56,720 --> 00:21:03,020
تقع بين يديّ الآن قوّة كافية
!لتعطيني التحكّم بأيّ دولة كبيرة أريدها

267
00:21:04,650 --> 00:21:08,980
لماذا منحك أوكيجي صلاحية استخدام نداء الدّمار؟

268
00:21:32,510 --> 00:21:36,700
!لا تطرحي عليّ الأسئلة أيّها المرأة الوقحة

269
00:21:37,960 --> 00:21:41,810
،لو أنّي لم أشهد بقيمة وجودك

270
00:21:41,810 --> 00:21:43,770
!فقد كنتِ بلا قيمة

271
00:21:46,400 --> 00:21:50,270
!عليك أن تكوني ممتنة لي

272
00:21:51,560 --> 00:21:55,540
...يا نسيبة أوهارا، أرض الشياطين البغيضة

273
00:21:56,200 --> 00:21:58,200
...نيكو روبين

274
00:22:03,200 --> 00:22:07,380
نقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

275
00:22:07,380 --> 00:22:11,300
نندفع للأمام بشدّة بقوّة متدفّقة

276
00:22:11,300 --> 00:22:15,420
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

277
00:22:15,420 --> 00:22:18,430
لأنّ كلّ ذلك لضمان أن نبتسم في النّهاية

278
00:22:19,350 --> 00:22:21,720
سنصبح الرّقم 1

279
00:22:21,720 --> 00:22:23,560
وسيكون هدفنا الحرّيّة في عالم العجائب

280
00:22:23,560 --> 00:22:25,770
انظروا، ثمّة نور خافت يرشدنا في الطّريق نحو الغد

281
00:22:25,770 --> 00:22:27,940
إنّه عصر صُنِع بالمخاطرة بكلّ شيء

282
00:22:27,940 --> 00:22:30,060
!نحاول دائمًا بذل ما بوسعنا، فهيّا بنا

283
00:22:30,060 --> 00:22:32,070
،إن أردنا أن ننال المجد

284
00:22:32,070 --> 00:22:33,480
فالآن هو الوقت لذلك... فلا تخافوا

285
00:22:33,480 --> 00:22:35,400
سنفوز بالمستقبل مع أصدقائنا بكلّ تأكيد

286
00:22:35,400 --> 00:22:39,370
والآن، سنبدأ الرّكض بسرعة نحو عالم واسع

287
00:22:39,370 --> 00:22:43,330
لا يمكننا الانطلاق بقوى مجهولة

288
00:22:43,330 --> 00:22:45,580
فلا خوف بداخلنا ولا تردّد

289
00:22:45,580 --> 00:22:49,380
...مهما حدث، فبالتّأكيد في النّهاية

290
00:22:49,380 --> 00:22:53,340
سنقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

291
00:22:53,340 --> 00:22:57,300
نندفع للأمام بشدّة بقوّة متدفّقة

292
00:22:57,300 --> 00:23:01,550
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

293
00:23:01,550 --> 00:23:03,560
لنندفع للأمام

294
00:23:03,560 --> 00:23:05,470
لنبدأ الرّكض نحو الغد

295
00:23:05,470 --> 00:23:08,440
لأنّ كلّ ذلك لضمان أن نبتسم في النّهاية

296
00:23:15,480 --> 00:23:17,460
!انتظر! هذا ليس ما اتفقنا عليه

297
00:23:17,540 --> 00:23:18,620
ما اتفقنا عليه؟

298
00:23:18,700 --> 00:23:21,300
!أن يغادر طاقم قبعة القش ووتر سيفن بأمان

299
00:23:21,360 --> 00:23:22,560
!صحيح

300
00:23:23,060 --> 00:23:29,330
،غادروا ووتر سيفن بأمان
وهم هنا الآن، أليس كذلك؟

301
00:23:29,920 --> 00:23:30,820
...لا يمكن

302
00:23:31,100 --> 00:23:32,640
:في الحلقة القادمة من وان بيس

303
00:23:32,720 --> 00:23:35,920
!روبين المغدورة"
"!دافع حكومة العالم

304
00:23:35,920 --> 00:23:38,420
!ملك القراصنة، لن يكون إلاّ أنا