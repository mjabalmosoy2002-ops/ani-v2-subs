1
00:00:00,000 --> 00:00:05,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:09,660 --> 00:00:12,500
في نهاية الأحلام، في نهاية البحر

3
00:00:12,500 --> 00:00:15,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:15,000 --> 00:00:18,010
ولكن أوّلاً، علينا صنع

5
00:00:18,010 --> 00:00:22,890
أسطورة لامعة من أنفسنا

6
00:00:23,340 --> 00:00:25,720
شرارات متطايرة من هنا بلا حدود

7
00:00:25,720 --> 00:00:27,350
!وان بيس

8
00:00:27,350 --> 00:00:29,980
سنخبر جميعنا الرّحّالة

9
00:00:29,980 --> 00:00:33,980
هل ما زالت أحلامكم واضحة؟

10
00:00:35,360 --> 00:00:42,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:42,030 --> 00:00:48,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:00:48,500 --> 00:00:51,120
سنخبر جميعنا الرّحّالة

13
00:00:51,120 --> 00:00:54,880
لا توجد قتالات بلا معنى

14
00:00:56,540 --> 00:01:03,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:03,010 --> 00:01:09,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:09,600 --> 00:01:15,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:15,730 --> 00:01:22,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:29,190 --> 00:01:35,300
كشف شاكا للطّاقم ما الّذي حلّ
.لأوهارا قبل 22 سنة

19
00:01:36,020 --> 00:01:38,140
ما الّذي يفعله هؤلاء العمالقة هنا؟

20
00:01:38,500 --> 00:01:41,380
.لم أرك منذ مدّة يا فيغابانك

21
00:01:41,380 --> 00:01:42,910
!دراغون

22
00:01:44,680 --> 00:01:47,430
.إنّهم يعرفون تمامًا قيمة تلك الكتب

23
00:01:48,190 --> 00:01:49,510
،أمّا بالنّسبة لقبطانهم

24
00:01:49,510 --> 00:01:53,270
.فهو رجل غريب تغطّي جسده الضّمادات

25
00:01:53,600 --> 00:01:56,670
قال أنّ باحثي أوهارا ضحّوا بأنفسهم
.لأجل هذه الثّروة البشريّة

26
00:01:56,750 --> 00:02:00,020
.وأنّه لن يسمح لها أن تُمحى من التّاريخ

27
00:02:00,840 --> 00:02:04,150
لكنّي سأؤسّس جيشًا قادرًا
!على القتال بالفعل

28
00:02:04,150 --> 00:02:06,460
.انتظر فحسب يا فيغابانك

29
00:02:06,550 --> 00:02:08,620
!سأغيّر العالم

30
00:02:09,330 --> 00:02:10,910
...سأحرص كلّ الحرص

31
00:02:11,650 --> 00:02:15,120
!ألا يكون موت كلوفر ولا إرادة أوهارا هباءً

32
00:02:15,570 --> 00:02:20,500
،وقبل أن تنتهي تلك السّنة
وحّد دراغون قوّته مع بارثولوميو كوما

33
00:02:20,500 --> 00:02:24,470
والبقيّة لإنشاء الجيش الثّوريّ
!الّذي يهزّ العالم الآن حتّى نخاعه

34
00:02:25,500 --> 00:02:28,050
إنّ كلّ ألغاز وأسرار العالم
...الّتي اكتشفتها أوهارا

35
00:02:29,390 --> 00:02:31,020
.قد نُقلت إلى هنا

36
00:02:31,080 --> 00:02:34,980
إنّها في دماغي الآن حيث واصلت
!البحث فيها بشكل مكثّف

37
00:02:34,980 --> 00:02:39,200
...اسم ذلك القبطان العملاق هو

38
00:02:41,770 --> 00:02:44,090
ساول، صحيح؟

39
00:02:44,890 --> 00:02:47,910
.إنّه مختبئ الآن

40
00:02:48,150 --> 00:02:50,620
.عليّ الاحتفاظ بذلك سرًّا عن الجميع

41
00:02:54,490 --> 00:02:56,910
.شكرًا لك يا فيغابانك

42
00:02:57,030 --> 00:03:00,750
شكرًا لأنّك حرصت ألاّ تكون
.معركة أوهارا هباءً

43
00:03:02,810 --> 00:03:05,630
،خلال هذا الوقت في كومة الخردة

44
00:03:05,630 --> 00:03:08,310
.تلتقي بوني بفيغابانك

45
00:03:11,930 --> 00:03:14,680
!أعد والدي لسابق عهده

46
00:03:15,050 --> 00:03:17,780
...إن رفضت طلبي

47
00:03:20,510 --> 00:03:21,450
ماذا؟

48
00:03:31,360 --> 00:03:37,010
يبدو أنّه أكل فاكهة الشّيطان
!الفاشلة الّتي تركتُها في بانك هازارد

49
00:03:37,460 --> 00:03:41,300
أمضيت عشرين سنة
...والكثير من المال على بحثي

50
00:03:41,300 --> 00:03:44,590
!لصناعتها من عامل سلالة كايدو الدّمويّة

51
00:03:45,710 --> 00:03:48,640
!ماذا عن هذا الرّوبوت؟! اجعله يتحرّك لأجلنا

52
00:03:48,670 --> 00:03:50,430
!أهو من صنعك أيضًا؟

53
00:03:52,380 --> 00:03:53,730
...لا، ليس كذلك

54
00:03:54,380 --> 00:03:59,390
إنّه عملاق حديديّ أسطوريّ قيل
...أنّه هاجم أرض ماريجوا المقدّسة

55
00:03:59,550 --> 00:04:01,680
!قبل 200 سنة

56
00:04:05,880 --> 00:04:10,260
"!حلمُ العبقريّ غريب الأطوار"

57
00:04:12,020 --> 00:04:15,080
هاجم ماريجوا؟

58
00:04:15,740 --> 00:04:17,790
،لكن إن اشتغل مرّة أخرى

59
00:04:17,790 --> 00:04:19,910
!فسنكون في خطر كبير

60
00:04:22,120 --> 00:04:24,340
!إنّه سلاح مميت؟

61
00:04:24,500 --> 00:04:25,980
...إضافة لذلك

62
00:04:26,030 --> 00:04:27,550
...إنّ من قاموا بصناعته

63
00:04:27,870 --> 00:04:30,090
!عاشوا قبل أزيد من 900 سنة

64
00:04:30,310 --> 00:04:32,360
!ماذا؟! هل تمزح معنا؟

65
00:04:32,440 --> 00:04:34,970
.من الصّعب تصديق هذا

66
00:04:35,460 --> 00:04:38,180
!إنّك مذهل بالفعل

67
00:04:38,380 --> 00:04:41,890
كيف هاجمتهم؟ هل أطلقت أشعة ليزر؟

68
00:04:42,440 --> 00:04:46,650
!أرنا ما لديك يا روبونوسكي

69
00:04:47,160 --> 00:04:49,400
!رجاءً! رجاءً! رجاءً

70
00:04:49,400 --> 00:04:51,530
!كفّ عن ضربه وإلاّ كسرته

71
00:04:53,030 --> 00:04:57,830
لماذا هاجم هذا العملاق الحديديّ ماريجوا؟

72
00:04:57,830 --> 00:04:58,790
!سؤال وجيه

73
00:05:02,120 --> 00:05:04,050
...لا يزال هدفه مجهولاً

74
00:05:28,470 --> 00:05:32,400
قيل أنّه لم تحدث أيّ أضرار
.فقط لأنّ الطّاقة نفدت منه

75
00:05:34,520 --> 00:05:38,270
،لا بدّ أنّ الدّهشة سادت بين علماء ذلك العصر

76
00:05:38,310 --> 00:05:40,330
.الّذين رأوه بالتّأكيد كلغز كبير

77
00:05:40,700 --> 00:05:44,710
كيف ظهرت آلة متطوّرة
بهذا الشّكل فجأة من العدم؟

78
00:05:46,310 --> 00:05:49,670
على الأرجح أنّه سيفاجئ
.أيّ أحد حتّى بعد مرور 200 عام

79
00:05:49,670 --> 00:05:53,130
.من الأفضل أن يظلّ خامدًا

80
00:05:55,460 --> 00:05:56,840
،وفي النّهاية

81
00:05:57,090 --> 00:06:03,940
لا يعلم أحد من أين أتى العملاق الحديديّ
.أو ما الّذي كان يحاول فعله

82
00:06:04,550 --> 00:06:09,020
،أمرتْ حكومة العالم أن يُفكّك ويُدمّر

83
00:06:09,640 --> 00:06:13,670
.لكنّ الفضول منع العلماء من تنفيذ تلك الأوامر

84
00:06:14,020 --> 00:06:17,040
.لذلك السّبب ما زال هنا حتّى يومنا هذا

85
00:06:18,520 --> 00:06:21,160
.ولا تعرف الحكومة أيّ شيء عنه

86
00:06:31,540 --> 00:06:34,400
أنت بارع بما يكفي لإصلاحه، صحيح؟

87
00:06:34,970 --> 00:06:39,610
!أريد أن أجعله روبوتي الخاصّ وأتحكّم به

88
00:06:39,970 --> 00:06:41,970
!يا لك من مغفّل

89
00:06:45,130 --> 00:06:48,770
.لكنّي مندهش لأنّكم عثرتم على هذا المكان

90
00:06:49,510 --> 00:06:53,690
كان يفترض أن يبدو المدخل
.إلى هنا كجدار منيع من البلدة

91
00:06:57,860 --> 00:06:58,950
...أنا أتألّم

92
00:06:59,150 --> 00:06:59,990
!لوفي

93
00:07:00,270 --> 00:07:03,120
...اختفى لوفي

94
00:07:03,850 --> 00:07:06,620
.كنتُ في عجلة من أمري وعجوزًا حينها

95
00:07:06,620 --> 00:07:09,710
.وصلنا إلى هنا بينما كانت عقولنا واهية

96
00:07:09,910 --> 00:07:12,170
.آسف لسماعي هذا

97
00:07:13,410 --> 00:07:14,630
قبل 200 سنة؟

98
00:07:14,970 --> 00:07:17,590
إنّه في نفس الوقت الّذي مُنحت
.فيه الحقوق للبرمائيّين

99
00:07:17,830 --> 00:07:18,770
.نعم

100
00:07:18,920 --> 00:07:23,310
كانت مملكة ريوغو حليفة لحكومة العالم

101
00:07:23,510 --> 00:07:25,780
.وكان لديها أيضًا مقعد في قمّة اللّيفيلي

102
00:07:26,090 --> 00:07:30,450
من قد تكون لديه ضغينة ضدّ التّنانين
السّماويّين ليهاجمهم بالرّوبوت؟

103
00:07:30,470 --> 00:07:33,860
ما كانوا ليحظوا بأيّ فرصة
.أمام مثل هذا الرّوبوت

104
00:07:34,100 --> 00:07:36,260
.ما زلت لا أستطيع تصديق ذلك

105
00:07:36,390 --> 00:07:41,320
هل تحاول القول أنّ هذا الرّوبوت
الضّخم تسلّق الرّيد لاين؟

106
00:07:41,570 --> 00:07:42,750
.بكلّ تأكيد

107
00:07:43,030 --> 00:07:47,040
يبدو مشابهًا جدًّا للرّوبوت
.الّذي أحضرَنا إلى هنا

108
00:07:47,410 --> 00:07:48,210
.نعم

109
00:07:49,290 --> 00:07:51,100
لقد صنعتُ فيغافورس-1

110
00:07:51,500 --> 00:07:54,380
.باستعمال العملاق الحديديّ كمرجع

111
00:07:57,080 --> 00:08:01,140
لكنّه يملك خصائص حتّى قواي
.العلميّة لا تستطيع إعادة ابتكارها

112
00:08:01,420 --> 00:08:05,840
وما الّذي لا يستطيعه عبقريّ
مثلك إعادة ابتكاره؟

113
00:08:06,130 --> 00:08:07,100
.مصدر طاقته

114
00:08:07,100 --> 00:08:08,720
!مصدر طاقته؟

115
00:08:08,930 --> 00:08:13,690
كان هنالك في الماضي قوّة تتحدّى
.المعرفة العاديّة لعالمنا اليوم

116
00:08:14,970 --> 00:08:18,300
،رغم تقدّمنا التّكنولوجيّ

117
00:08:18,300 --> 00:08:20,110
لا يمكننا إعادة ابتكار ذلك العملاق
.الحديديّ بشكل كامل

118
00:08:21,150 --> 00:08:22,700
...هذا مثير للشّفقة

119
00:08:24,080 --> 00:08:27,510
.لكن من الجيّد معرفة أنّ لوفي والبقيّة بخير

120
00:08:27,570 --> 00:08:28,830
لكن من تلك الفتاة؟

121
00:08:30,620 --> 00:08:32,920
.تلك هي القرصانة جولري بوني

122
00:08:32,920 --> 00:08:37,070
لكنّي ظننتُ أنّ من كانت
!في تلك الدّوّامة طفلة صغيرة

123
00:08:37,760 --> 00:08:40,810
!وانظروا إلى رأس فيغابانك

124
00:08:42,170 --> 00:08:44,270
هل ستكون بوني بخير؟

125
00:08:44,330 --> 00:08:46,430
.ستستيقظ قريبًا

126
00:08:50,340 --> 00:08:53,650
!أشعر بسوء شديد حيال ما حدث لبوني

127
00:08:53,650 --> 00:08:56,020
!وذلك ما يجب أن تشعر به
!انحني واطلب مغفرتها

128
00:08:56,020 --> 00:08:58,750
وما أدراك أنت عن أيّ من هذا؟

129
00:09:02,140 --> 00:09:03,560
...هنالك شيء

130
00:09:04,270 --> 00:09:06,580
.عليّ منحه إيّاها

131
00:09:07,400 --> 00:09:10,000
،ولكن يا قبّعة القشّ لوفي

132
00:09:10,660 --> 00:09:15,760
.أشعر أنّ ما جمع بيننا اليوم هو القدر

133
00:09:15,830 --> 00:09:16,840
ماذا؟

134
00:09:17,910 --> 00:09:18,920
...من فضلك

135
00:09:20,460 --> 00:09:24,920
خذني على متن سفينتك بعيدًا
!عن إيغهيد، كويسار

136
00:09:43,600 --> 00:09:45,820
ماذا تكون هذه؟

137
00:09:57,120 --> 00:09:58,970
.أسلحة وحوش البحر

138
00:09:59,000 --> 00:10:01,630
.إنّها حرّاس إيغهيد نوعًا ما

139
00:10:07,010 --> 00:10:09,470
.كونوا جاهزين لإطلاق النّار عند الحاجة

140
00:10:09,470 --> 00:10:10,220
!حاضر

141
00:10:20,930 --> 00:10:22,650
...معكم سايفر بول

142
00:10:22,850 --> 00:10:25,020
.إنّنا نطلب الإذن لنرسو في إيغهيد

143
00:10:25,690 --> 00:10:27,580
...أكرّك. معكم سايفر بول

144
00:10:27,610 --> 00:10:28,620
!نحن في ورطة

145
00:10:28,670 --> 00:10:30,660
.إنّنا نرغب في النّزول على إيغهيد

146
00:10:31,870 --> 00:10:32,830
!نار

147
00:10:47,390 --> 00:10:49,690
.يا لها من حيوانات أليفة تفتقر للتّدريب

148
00:10:52,470 --> 00:10:56,350
لدينا تقارير شهود عيان تفيد بأنّ
.جولري بوني قد أبحرت إلى إيغهيد

149
00:10:56,350 --> 00:11:00,030
سئمت من هذه المرأة البغيضة
.الّتي لا تعرف سوى الهرب

150
00:11:01,100 --> 00:11:05,490
.أعتقد أنّه لم تعد لنا حاجة بها
.لذلك سنقضي عليها بمجرّد رؤيتها

151
00:11:06,950 --> 00:11:09,160
.شاكا! إنّها سفينة للحكومة

152
00:11:11,200 --> 00:11:11,990
!ماذا؟

153
00:11:11,990 --> 00:11:13,330
!الحكومة هنا؟

154
00:11:13,550 --> 00:11:17,790
يريدون منّا فتح الميناء. سيكون من
.الصّعب تفسير وجود القراصنة

155
00:11:17,790 --> 00:11:19,430
.نعلم ذلك

156
00:11:19,490 --> 00:11:22,630
.إنّ التّعرّض للاعتقال ليس ضمن خططنا

157
00:11:22,630 --> 00:11:25,760
!إنّ سي بي 0 على متن السّفينة لسبب ما

158
00:11:25,760 --> 00:11:27,720
!إنّه روب لوتشي شخصيًّا

159
00:11:28,540 --> 00:11:29,430
ماذا؟

160
00:11:29,920 --> 00:11:31,140
لوتشي؟

161
00:11:33,670 --> 00:11:35,350
لماذا كلّ هذا الرّعب؟

162
00:11:36,260 --> 00:11:40,400
!علينا فقط تسليم القراصنة لهم
روب لوتشي قاتل مغتال، صحيح؟

163
00:11:42,350 --> 00:11:45,860
!كلاّ! حرّروا قدماي

164
00:11:45,860 --> 00:11:47,930
!كلاّ، أكره ذلك الرّجل

165
00:11:47,930 --> 00:11:49,740
!ما زال لم يكفّ عن ذلك؟

166
00:11:49,770 --> 00:11:51,570
!لا تدعوه يخطو على الجزيرة

167
00:11:51,730 --> 00:11:55,410
!سأتعامل مع ذلك الوغد لوتشي بنفسي

168
00:11:55,740 --> 00:11:59,760
،لا داعي للقلق يا روبين-تشان
!سأحميك مهما تطلّب الأمر ذلك

169
00:11:59,780 --> 00:12:00,750
.شكرًا جزيلاً

170
00:12:01,120 --> 00:12:02,380
...شاكا

171
00:12:07,870 --> 00:12:10,870
.فيثاغورس، أبلغ هذا لسفينتهم

172
00:12:11,390 --> 00:12:13,680
".دعوا السّيرافيم وغادروا"

173
00:12:13,710 --> 00:12:14,470
ماذا؟

174
00:12:15,050 --> 00:12:18,560
!استعدّوا للقتال
!إنّنا نرفض دخول الحكومة للجزيرة

175
00:12:20,430 --> 00:12:24,610
.من النّادر رؤيتك تستعدّ للقتال

176
00:12:34,870 --> 00:12:37,040
!مهلاً! مهلاً! مهلاً! مهلاً

177
00:12:42,370 --> 00:12:45,090
!كوما-سان، لا يجدر بك الحركة

178
00:12:45,090 --> 00:12:46,800
!ما زلت بحاجة للإصلاح

179
00:12:54,110 --> 00:12:56,560
!دراغون-سان! يتصرّف كوما-سان بغرابة

180
00:12:57,520 --> 00:12:58,720
!كوما؟

181
00:12:58,720 --> 00:13:00,810
!كوما-سان –
!ما الخطب؟ –

182
00:13:02,270 --> 00:13:05,340
!هل ما زالت البحريّة تتلاعب به؟

183
00:13:13,780 --> 00:13:15,740
!كوما-سان! إلى أين تذهب؟

184
00:13:16,050 --> 00:13:18,450
!لم تتمّ معالجتك بالكامل بعد

185
00:13:27,180 --> 00:13:28,470
!ما الّذي يحدث؟

186
00:13:28,470 --> 00:13:30,760
!لا أدري! حدث ذلك فجأة

187
00:13:31,100 --> 00:13:33,500
يجدر به أن يكون قد فقد كلّ
...وعيه بنفسه الآن

188
00:13:35,470 --> 00:13:36,270
!كوما

189
00:13:36,270 --> 00:13:37,680
!عد يا كوما-سان

190
00:13:39,600 --> 00:13:42,230
!ماذا حدث يا كوما؟! إلى أين تذهب؟

191
00:13:49,360 --> 00:13:51,320
!كوما-سان

192
00:13:55,030 --> 00:13:56,850
!ابق هنا

193
00:13:56,850 --> 00:14:01,250
!بدأت معركة الجيش الثّوريّ للتّوّ فحسب

194
00:14:08,130 --> 00:14:09,670
!انتظر

195
00:14:09,670 --> 00:14:11,050
!كوما-سان

196
00:14:26,780 --> 00:14:28,010
...كوما

197
00:14:46,970 --> 00:14:50,840
.سايفر بول! شكرًا لإعادتكم السّيرافيم

198
00:14:50,840 --> 00:14:55,220
.نحن نرفض طلب نزولكم
.دعوا السّيرافيم وغادروا رجاءً

199
00:14:56,020 --> 00:15:00,430
يستطيع إس-بير العودة من تلقاء
.نفسه من هناك

200
00:15:00,430 --> 00:15:04,640
أرجوا أن تعذروا هذا الرّدّ الرّسميّ
.الّذي فرضه علينا جدولنا الممتلئ

201
00:15:04,640 --> 00:15:09,040
مُروا إس-بير بالعودة رجاءً
.وستكون مهمّتكم قد انتهت بذلك

202
00:15:09,040 --> 00:15:10,800
.شكرًا على جهودكم

203
00:15:11,070 --> 00:15:13,850
!مهلاً، لا داعي لهذه القسوة

204
00:15:14,250 --> 00:15:16,030
هل كشفوا أمرنا؟

205
00:15:16,030 --> 00:15:19,800
كانت رحلة طويلة! على الأقلّ دعونا
!نحتسي كوب شاي على الجزيرة

206
00:15:19,800 --> 00:15:21,200
!كما أنّ الجوّ بارد

207
00:15:21,510 --> 00:15:25,020
.فرع البحريّة جي-14 قريب من هنا

208
00:15:25,020 --> 00:15:27,240
.الجؤوا إليه للرّاحة رجاءً

209
00:15:28,010 --> 00:15:31,420
!ماذا؟! ما كلّ هذه القسوة؟! تبًّا

210
00:15:31,420 --> 00:15:33,170
هل أنت الدّكتور فيغابانك؟

211
00:15:33,170 --> 00:15:33,960
!نعم

212
00:15:35,020 --> 00:15:40,550
!أتذكّرك الاختفاءات في إيغهيد بشيء ما؟

213
00:15:43,180 --> 00:15:44,640
ماذا قال؟

214
00:15:45,070 --> 00:15:48,100
أيّ اختفاءات؟

215
00:15:48,700 --> 00:15:53,470
...قبل شهرين، سفينة سايفر بول رقم 5

216
00:15:53,910 --> 00:15:57,100
...وقبل شهر، سايفر بول رقم 7

217
00:15:57,330 --> 00:16:01,070
...وقبل أسبوعين، سايفر بول رقم 8

218
00:16:01,380 --> 00:16:08,140
لم تعد أيّ سفينة تابعة للحكومة
.زارت إيغهيد في الشّهرين الماضيين

219
00:16:08,140 --> 00:16:09,290
لماذا؟

220
00:16:13,630 --> 00:16:16,940
.أهذا صحيح؟ لا يجب أن يحدث هذا

221
00:16:16,940 --> 00:16:21,260
...تُؤكّد سجلاّتنا أنّ كلّ السّفن قد غادرت

222
00:16:22,390 --> 00:16:24,740
!أنت، ما الّذي تتحدّث عنه؟

223
00:16:24,740 --> 00:16:28,640
!هل تقول أنّنا وراء ما حدث لسايفر بول؟

224
00:16:28,640 --> 00:16:30,020
!لا تعبث معي

225
00:16:30,020 --> 00:16:33,010
!ليليث! لا داعي لهذه العدوانيّة

226
00:16:33,370 --> 00:16:35,980
،سأسمح لكم بالدّخول
!لذلك لماذا لا تبحثوا بأنفسكم؟

227
00:16:35,980 --> 00:16:38,070
!لا تفعلي ذلك أيضًا –
!اتركني –

228
00:16:38,070 --> 00:16:40,340
!لا علاقة لنا بالأمر

229
00:16:40,340 --> 00:16:42,240
!لذلك، غادروا رجاءً

230
00:16:43,040 --> 00:16:45,480
.حسنًا. مفهوم

231
00:16:46,630 --> 00:16:47,870
.إغلاق

232
00:16:47,870 --> 00:16:50,420
.لا يبدو أنّ أيّ شيء تقوله يساعدنا

233
00:16:50,420 --> 00:16:52,210
ماذا نفعل يا لوتشي؟

234
00:16:54,350 --> 00:16:55,740
...لا خيار أمامنا

235
00:16:57,060 --> 00:16:59,090
نأخذك بعيدًا عن هنا؟

236
00:16:59,090 --> 00:17:02,050
لماذا؟ أليس هذا مختبرك؟

237
00:17:02,050 --> 00:17:03,760
!هذا صحيح

238
00:17:04,230 --> 00:17:06,510
!هذه هي الجزيرة حيث يُصنع المستقبل

239
00:17:06,860 --> 00:17:11,730
،استعملتُ كلّ المنشآت كما أشاء
،وأخذت أموالاً كثيرة من الحكومة للبحث

240
00:17:11,730 --> 00:17:14,770
!وواصلتُ بحوثي كما يحلو لي

241
00:17:15,150 --> 00:17:17,610
!إيغهيد مكان مذهل، صحيح؟

242
00:17:19,320 --> 00:17:23,990
حتّى الآن، تتدفّق الأفكار إليّ
!ولا يمكنني إيقافها

243
00:17:24,320 --> 00:17:27,120
لا يوجد وقت ولا أيادٍ كافية

244
00:17:27,220 --> 00:17:30,150
!ولا أموال للعمل على كلّ تلك الأفكار

245
00:17:31,460 --> 00:17:33,960
!هل ستصنع شيئًا أكثر روعة؟

246
00:17:33,960 --> 00:17:36,110
!أتريدون رؤيته؟

247
00:17:36,470 --> 00:17:37,800
!نعم! نعم

248
00:17:39,000 --> 00:17:41,870
!سأغيّر العالم بيديّ هاتين

249
00:17:43,510 --> 00:17:45,720
!وما الّذي ستصنعه؟

250
00:17:45,720 --> 00:17:47,180
!أخبرنا

251
00:17:47,570 --> 00:17:48,870
!حسنًا

252
00:17:48,870 --> 00:17:52,890
!أريد جعل العالم هكذا بالعلم يومًا ما

253
00:17:53,200 --> 00:17:57,930
!عالم تتوفّر فيه الطّاقة للجميع بالمجّان

254
00:17:59,830 --> 00:18:01,560
!يبدو أنّك لا تفهم الأمر بالكامل

255
00:18:02,000 --> 00:18:04,320
هل ستُعطي الجميع شيئًا ما؟

256
00:18:05,460 --> 00:18:08,080
.سيكون من الرّائع بالفعل إن حدث ذلك

257
00:18:08,380 --> 00:18:10,640
...الموارد الّتي تنتج الطّاقة

258
00:18:10,640 --> 00:18:14,290
تكون دائمًا السّبب في اندلاع الحروب
.بحيث تتقاتل الدّول عليها

259
00:18:14,590 --> 00:18:18,000
!هذا صحيح! هذا يُظهر مدى غباء النّاس

260
00:18:19,600 --> 00:18:20,960
...الطّاقة

261
00:18:21,960 --> 00:18:23,170
!يمكنكم الشّعور بها

262
00:18:23,170 --> 00:18:27,330
!إنّها هنا وهناك وفي كلّ مكان

263
00:18:27,890 --> 00:18:31,390
!يمتلئ هذا العالم بالطّاقة

264
00:18:35,740 --> 00:18:39,440
،إن استطعنا تحويلها لطاقة ملموسة

265
00:18:39,440 --> 00:18:43,650
بإمكاننا القضاء على سبب
!رئيسيّ للحروب من العالم

266
00:18:48,410 --> 00:18:52,620
!واثق أنّ العلم بإمكانه أخذنا إلى هناك يومًا ما

267
00:18:56,090 --> 00:18:57,540
!لا تبدو مهتمًّا

268
00:18:57,540 --> 00:19:01,500
لا، إنّ أيّ شخص يحاول إسعاد
.الجميع يستحقّ الاحترام

269
00:19:01,500 --> 00:19:04,190
.لكنّي لستُ مهتمًّا بأن أصير بطلاً

270
00:19:04,190 --> 00:19:06,590
والآن، لماذا تريد مغادرة الجزيرة؟

271
00:19:07,230 --> 00:19:08,740
...إنّ الأمر هو

272
00:19:08,740 --> 00:19:13,550
أنّه كلّما حاولت إنشاء الطّاقة
،الّتي أسعى إليها

273
00:19:14,030 --> 00:19:18,500
،اقتربتُ أكثر من مصدر الطّاقة
الطّاقة القديمة

274
00:19:18,500 --> 00:19:22,140
.التي تشغّل هذا الجنديّ الآليّ القديم

275
00:19:23,200 --> 00:19:27,180
وطبيعتي كعالِم تجعلني أرغب
.في إلقاء نظرة عليه

276
00:19:27,180 --> 00:19:32,120
تساءلتُ ما الّذي سأتعلّمه عندما
!سأكشف التّاريخ المحرّم

277
00:19:33,010 --> 00:19:38,830
،وأثناء تبنّيّ لإرادة صديقي
...تعمّقت أكثر وأكثر في الأمر

278
00:19:49,150 --> 00:19:51,990
!وهكذا صرتُ غارقًا كثيرًا في التّاريخ المحرّم

279
00:19:51,990 --> 00:19:55,560
!ستقضي عليّ الحكومة مثلما حدث مع أوهارا

280
00:20:01,900 --> 00:20:07,530
إلى أيّ مدى هربنا؟

281
00:20:07,530 --> 00:20:14,660
نعدّ النّدوب دون أن نعرف

282
00:20:14,660 --> 00:20:21,920
وفي بالي دائمًا، خريطة كنز

283
00:20:21,920 --> 00:20:28,420
أبحث باستمرار عن المستقبل

284
00:20:28,420 --> 00:20:41,980
توجد الوعود الحقيقيّة عميقًا في القلب

285
00:20:41,980 --> 00:20:51,450
للجميع أحلام لا يستطيع أحد اللّحاق بها

286
00:20:51,450 --> 00:20:57,040
تمسّكوا بذلك الحلم فقط

287
00:20:57,040 --> 00:21:04,170
إليك يا من تبتسم مثل الشّمس

288
00:21:04,170 --> 00:21:11,170
لنغنّ نفس الأغنية مثل ذلك اليوم

289
00:21:11,170 --> 00:21:18,220
حتّى إن كبر بنا العمر، لا أريد أن أنسى

290
00:21:18,220 --> 00:21:25,650
إلى أن تصلك هذه الأمنية

291
00:21:32,440 --> 00:21:36,660
!غوصوا في بحر المعلومات"
"!مكتبة سجلاّت بانك

292
00:21:36,660 --> 00:21:42,140
مرحبًا! أنا ليليث، واحدة من أقمار
!العالم العبقريّ الدّكتور فيغابانك

293
00:21:42,200 --> 00:21:44,830
.وأنا أيضًا فيغابانك، اسمي إديسون

294
00:21:44,910 --> 00:21:47,680
!سنعرّفكم اليوم على إمبوريو إيفانكوف

295
00:21:47,700 --> 00:21:49,640
،إنّه حاكم مملكة كاماباكّا

296
00:21:49,710 --> 00:21:52,630
وواحد من قادة قوّات الجيش
.الثّوريّ في الغراند لاين

297
00:21:52,710 --> 00:21:54,530
لقد تناول فاكهة الهرمونات

298
00:21:54,530 --> 00:21:58,810
الّتي تسمح له بالتّلاعب بهرمونات
.النّاس وتغيير أجسادهم

299
00:21:58,920 --> 00:22:02,530
!وُلد في الثّامن من يناير ويحبّ الأحشاء المشويّة

300
00:22:02,590 --> 00:22:07,360
،عندما كان سجينًا في إمبل داون
،أنشأ أرض نيو كاما سرًّا

301
00:22:07,390 --> 00:22:10,260
وبنى جيشًا هناك وانتظر الفرصة
.المناسبة للقيام بثورة

302
00:22:10,330 --> 00:22:14,910
وهناك قابل قبّعة القشّ لوفي
.الّذي أتى لإنقاذ إيس

303
00:22:14,910 --> 00:22:18,550
عالج إيفانكوف لوفي الّذي تعرّض
.وقتها لسمّ مميت

304
00:22:18,650 --> 00:22:21,080
،إيفانكوف واحد من قادة الجيش الثّوريّ

305
00:22:21,110 --> 00:22:25,510
لذلك عندما عرف أنّ لوفي
،هو ابن قائد الأركان دراغون

306
00:22:25,530 --> 00:22:27,810
!خرجت عيناه من محجريهما

307
00:22:27,870 --> 00:22:31,220
وفي حرب القمّة الّتي شارك فيها
،بعد الهروب من السّجن

308
00:22:31,250 --> 00:22:34,760
قام بحماية لوفي بكلّ جهده
.من أكاينو مرّة أخرى

309
00:22:34,760 --> 00:22:37,640
!إيّاك ولم شعرة من الفتى قبّعة القشّ

310
00:22:37,960 --> 00:22:40,310
،بعد العودة لمملكة كاماباكّا

311
00:22:40,340 --> 00:22:44,570
قابل سانجي الّذي أرسله
.بارثولوميو كوما إلى هناك

312
00:22:44,590 --> 00:22:48,410
.جمعت بينهما علاقة جيّدة رغم الشّجارات الكثيرة

313
00:22:48,430 --> 00:22:50,280
.إنّ إيفانكوف شخص عطوف جدًّا

314
00:22:50,310 --> 00:22:54,240
!لنرَ ما الّذي سيحقّقه كعضو في الجيش الثّوريّ

315
00:22:54,310 --> 00:22:56,080
!هذا كلّ شيء لليوم

316
00:22:56,150 --> 00:22:59,280
بعد رؤيتكم لتقريرنا، تبرّعوا
!لصندوق البحث خاصّتنا

317
00:22:59,360 --> 00:23:01,320
!نراكم المرّة القادمة

318
00:23:05,800 --> 00:23:09,190
.تنزل سي بي 0 على إيغهيد عنوة

319
00:23:09,190 --> 00:23:13,030
كلّ من في الفابريوفيز حائر
،بشأن وصول المذبحة القاسية

320
00:23:13,030 --> 00:23:14,510
!روب لوتشي إلى هنا مع فريقه

321
00:23:14,510 --> 00:23:16,780
،ولحماية النّاس الّذين يرتعدون خوفًا

322
00:23:16,780 --> 00:23:21,260
!تواجه أطلس الأعداء بقبضتيها الضّخمتين الغاضبتين

323
00:23:21,260 --> 00:23:26,020
:في الحلقة القادمة من وان بيس
"!الاستعداد للاعتراض! هجوم روب لوتشي"

324
00:23:26,020 --> 00:23:31,770
!ملك القراصنة، لن يكون إلاّ أنا