1
00:00:14,680 --> 00:00:18,310
بوجود الضّعف كحليف لي

2
00:00:18,350 --> 00:00:21,930
أحلّق أعلى من أيّ أحد آخر

3
00:00:21,980 --> 00:00:24,650
من المؤسف البقاء في مكان كهذا

4
00:00:24,690 --> 00:00:28,770
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:29,230 --> 00:00:32,860
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:32,900 --> 00:00:36,490
إن كان قلبي أيضًا ضائعًا

7
00:00:36,530 --> 00:00:39,200
فلن أتمكّن من إيجادك

8
00:00:39,240 --> 00:00:43,250
لا لطفك ولا قوّتك

9
00:00:43,290 --> 00:00:49,040
أعلم مسبقًا

10
00:00:49,090 --> 00:00:50,960
إنّ بزوغ الفجر وشيك

11
00:00:51,000 --> 00:00:54,260
لنصبو إلى أعلى نقطة ممكنة

12
00:00:54,300 --> 00:00:58,300
سأندفع عبر الطّريق بأكمله

13
00:00:58,350 --> 00:01:01,060
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:01:01,100 --> 00:01:05,560
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:01:05,600 --> 00:01:08,310
بوجود العالم كعدوّ لي

16
00:01:08,360 --> 00:01:12,780
أقف ثابتًا وإن ارتعشت قدماي

17
00:01:12,820 --> 00:01:15,570
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:15,610 --> 00:01:20,120
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:30,000 --> 00:01:35,090
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:41,490 --> 00:01:44,120
!هيّا

21
00:01:49,790 --> 00:01:52,500
سيُترك واحد منّا في الخلف

22
00:01:52,800 --> 00:01:54,560
!يا قبّعة القشّ

23
00:01:59,800 --> 00:02:01,930
!ستدمّر أونيغاشيما

24
00:02:02,100 --> 00:02:03,680
!أنشئ سُحبًا

25
00:02:04,060 --> 00:02:06,860
!قبل أن يصيبنا هجومه

26
00:02:26,790 --> 00:02:29,790
!سأطلق العنان لنفسي كما لم أفعل من قبل

27
00:02:42,480 --> 00:02:44,880
"!العالم الّذي يصبو إليه لوفي"

28
00:02:53,810 --> 00:02:54,940
.كايدو-سان

29
00:02:56,070 --> 00:02:58,380
إلى أين ستذهب يا كايدو؟

30
00:02:59,360 --> 00:03:03,200
.وحدها الحرب تحدّد قيمة الرّجال

31
00:03:06,660 --> 00:03:09,000
.صرتَ تجسيدًا للقوّة

32
00:03:13,420 --> 00:03:16,420
.سأنهب العالم بأكمله

33
00:03:18,210 --> 00:03:21,220
.أدين بلقب اليونكو لنفسي فقط

34
00:03:26,730 --> 00:03:28,520
!يا له من إنجاز يا كايدو

35
00:03:28,680 --> 00:03:30,850
!إنّه شيطان يحلم مضربًا

36
00:03:34,440 --> 00:03:39,400
.لا يوجد في العالم من يمكنه منافستي

37
00:03:44,620 --> 00:03:47,090
.هناك أمور كثيرة تجهلها يا فتى

38
00:03:48,330 --> 00:03:51,830
.لا تستطيع بلادنا التّوقّف عن شنّ الحروب الآن

39
00:03:52,250 --> 00:03:56,120
علينا الانتصار وجمع غنائمنا من العدوّ
.لنتمكّن من دفع الضّريبة السّماويّة

40
00:03:56,540 --> 00:04:00,510
.إمّا أن نفعل هذا، أو نفقد حقوقنا كبشر

41
00:04:01,800 --> 00:04:04,980
.لا ترانا هذه البلاد إلاّ كأدوات

42
00:04:06,320 --> 00:04:10,550
لماذا على الجميع أن ينحني لهؤلاء
التّنانين السّماويّين؟

43
00:04:17,150 --> 00:04:19,200
!اخلعوا قيودي

44
00:04:20,350 --> 00:04:23,860
ما الّذي فعلته لأستحقّ هذا؟

45
00:04:26,290 --> 00:04:27,760
.لقد تمّ تجنيدك

46
00:04:28,100 --> 00:04:30,200
.ستصير جنديًّا في البحريّة

47
00:04:31,460 --> 00:04:33,730
لماذا قد أصير كلبًا للحكومة؟

48
00:04:33,880 --> 00:04:36,720
.ما عادت بلادنا تستطيع التّحكّم بك

49
00:04:36,850 --> 00:04:39,880
!اخرس! لم أطلب رأيك

50
00:04:40,050 --> 00:04:41,970
!لا تعبثوا معي

51
00:04:42,550 --> 00:04:44,930
!ستدفعون الثّمن

52
00:04:47,340 --> 00:04:49,100
سلّموا لنا كايدو

53
00:04:51,520 --> 00:04:53,600
وستشارك بلادكم

54
00:04:53,770 --> 00:04:55,600
.في قمّة اللّيفيلي القادمة

55
00:04:55,730 --> 00:04:59,310
!لستُ بيدقًا في لعبتكم السّياسيّة هذه

56
00:05:11,630 --> 00:05:14,200
.يستدعي الضّعفُ الخيانة

57
00:05:14,660 --> 00:05:18,010
سأبني أقوى جيش في العالم

58
00:05:18,230 --> 00:05:20,420
وسأجعل هذا العالم المملّ

59
00:05:20,540 --> 00:05:23,340
.عالمًا تحكمه القوّة

60
00:05:25,050 --> 00:05:27,370
!لا يوجد من هو أقوى منّي

61
00:05:32,130 --> 00:05:33,680
،أنت ورفاقك

62
00:05:33,810 --> 00:05:37,300
.نجحتم في جمع السّاموراي حولكم

63
00:05:37,440 --> 00:05:38,850
!عمل يستحقّ الثّناء

64
00:05:44,490 --> 00:05:46,110
زرعتم الأمل

65
00:05:46,240 --> 00:05:50,120
في قلوب كلّ جبناء بلاد وانو الّذين
.كانوا عاجزين عن المبادرة بأنفسهم

66
00:05:50,660 --> 00:05:52,490
،عهدوا لكم بمستقبلهم

67
00:05:52,610 --> 00:05:56,050
لكن ما العالم الّذي تودّ تركه لهم؟

68
00:05:56,410 --> 00:05:58,300
!أجبني يا قبّعة القشّ

69
00:06:05,670 --> 00:06:07,460
.أبليتَ حسنًا

70
00:06:21,940 --> 00:06:24,570
.قاتلتَ ببسالة

71
00:06:24,900 --> 00:06:25,900
،ولكن

72
00:06:30,740 --> 00:06:34,240
!لا تملك ما يتطلّبه الأمر لتغيير العالم

73
00:06:35,700 --> 00:06:38,620
!أيّها المقرّ الرّئيسيّ! هرب كايدو

74
00:06:38,870 --> 00:06:41,460
!إنّه يدمّر الأسطول ومعه كلّ رجالنا

75
00:06:43,380 --> 00:06:47,730
.أكرّر، هرب كايدو
!تكبّدنا خسائر جسيمة

76
00:06:49,380 --> 00:06:52,480
كيف نقاتل هذا الوحش؟

77
00:06:54,450 --> 00:06:57,560
!كلاّ! إيّاك والاقتراب منّي

78
00:07:26,090 --> 00:07:28,080
!قبضنا على كايدو

79
00:07:38,190 --> 00:07:40,310
...هرب كايدو

80
00:07:40,850 --> 00:07:42,280
!هرب مرّة أخرى

81
00:07:42,600 --> 00:07:46,600
يسمح لنا هذا الوغد بالإمساك به
!في كلّ مرّة يشعر فيها بالجوع

82
00:07:47,770 --> 00:07:50,850
!هذه سفينة سجن، وليست مطعمًا

83
00:07:59,980 --> 00:08:02,720
!إنّه قويّ جدًّا –
من هذا الفتى؟ –

84
00:08:02,960 --> 00:08:06,010
!إنّه بالكاد في الخامسة عشر

85
00:08:07,100 --> 00:08:09,550
!هذه ليست مكافأة تُمنح لطفل

86
00:08:09,760 --> 00:08:11,350
!إنّه وحش

87
00:08:12,960 --> 00:08:14,680
.أيّها الشّقيّ

88
00:08:15,510 --> 00:08:18,280
هل فكّرت يومًا أن تصير قرصانًا؟

89
00:08:20,610 --> 00:08:22,850
.سيحبّ روكس أن يلقاك

90
00:08:23,380 --> 00:08:24,670
هل ستأتي؟

91
00:08:28,760 --> 00:08:32,160
!انضمّ كايدو لطاقم روكس

92
00:08:32,320 --> 00:08:34,990
!ما عاد لهم من رادع الآن

93
00:08:36,870 --> 00:08:39,330
.كايدو! الوضع خطير

94
00:08:39,490 --> 00:08:42,830
!تعال، سنبحر إلى غود فالي

95
00:08:45,580 --> 00:08:48,880
!قُضي على طاقم روكس

96
00:08:50,790 --> 00:08:52,710
...هذا لا يُغتفر

97
00:08:52,950 --> 00:08:57,700
كيف يُعقل وهو يضمّ وحوشًا لا تقهر؟

98
00:08:57,840 --> 00:09:00,760
!يبدو أنّ جنديّ بحريّة يدعى غارب أطاح بهم

99
00:09:01,090 --> 00:09:05,810
.أظنّ أنّهم لم يطيقوا بعضهم فحسب
.لم يعرفوا كيف يعملون معًا

100
00:09:05,970 --> 00:09:08,550
إلى أين ستذهب يا كايدو؟

101
00:09:09,900 --> 00:09:13,030
!لا تعبث معي أيّها الوغد

102
00:09:17,630 --> 00:09:19,870
،بعد عشر سنوات من تلك الحادثة

103
00:09:20,660 --> 00:09:24,750
.صرتَ تجسيدًا للقوّة يا كايدو

104
00:09:26,820 --> 00:09:28,500
،في تاريخ البشريّة كلّه

105
00:09:28,780 --> 00:09:32,960
.لطالما كانت القوّة حلاًّ لكلّ المشاكل

106
00:09:34,260 --> 00:09:36,380
.منطق سليم

107
00:09:36,830 --> 00:09:38,710
.نحن حيوانات

108
00:09:39,120 --> 00:09:41,970
.النّجاة للأقوى هو قانون الطّبيعة

109
00:09:42,110 --> 00:09:43,890
.معك حقّ في كلامك هذا

110
00:09:44,110 --> 00:09:48,500
كما أنّ بقايا طاقم روكس
.سيتقاتلون لكسب القوّة أيضًا

111
00:09:48,620 --> 00:09:51,110
.الأسلحة هي ما تحكم عالمنا هذا

112
00:09:51,270 --> 00:09:54,440
.لديّ صفقة مفيدة لأعرضها عليك

113
00:09:57,740 --> 00:10:00,490
...سنأخذ كلّ أولئك الحكّام النّبلاء المدلّلين

114
00:10:00,910 --> 00:10:03,700
!الّذين يظنّون أنّ قوّتهم تجلب السّلام

115
00:10:04,100 --> 00:10:07,970
!وأجرّهم إلى ساحات المعارك إلى جانبكم

116
00:10:12,840 --> 00:10:16,010
!هذا هو ما أسمّيه المساواة والحرّيّة

117
00:10:16,280 --> 00:10:20,630
.وحدها الحرب تحدّد قيمة الرّجال

118
00:10:25,420 --> 00:10:29,060
!سيكون النّصر حليفي أنا

119
00:10:45,580 --> 00:10:48,080
.جاء ياماتو على ذكر جويبوي

120
00:10:48,370 --> 00:10:50,960
.أتساءل أين سمع ذلك الاسم

121
00:10:52,430 --> 00:10:57,510
إنّ أودن يريد فتح الحدود استعدادًا
.للتّرحيب بجويبوي في بلاد وانو

122
00:10:58,200 --> 00:11:02,680
أليس هو الرّجل الّذي تنتظره يا كينغ؟

123
00:11:03,120 --> 00:11:07,390
.في تلك الحالة، أعرف من يكون

124
00:11:43,050 --> 00:11:45,180
!انطلق يا لوفي

125
00:11:45,430 --> 00:11:49,310
!ستغادر هذه البلاد

126
00:12:02,860 --> 00:12:05,160
!تشجّع يا مومونوسكي

127
00:12:05,820 --> 00:12:08,330
.سيحقّق لوفي النّصر

128
00:12:09,490 --> 00:12:12,840
!ستكون هذه نهاية كايدو الشّنيع

129
00:12:13,370 --> 00:12:15,500
!سأقوم بواجبي

130
00:12:16,750 --> 00:12:18,170
!هذا ما نريده

131
00:12:18,380 --> 00:12:22,170
!حماية شعب بلاد وانو بين يديك الآن

132
00:12:22,830 --> 00:12:26,600
!أنت لها يا مومونوسكي-كُن

133
00:12:28,180 --> 00:12:30,520
!انطلقي يا سحب اللّهب

134
00:12:30,670 --> 00:12:33,730
!ستنصاعين لإرادتي

135
00:12:39,590 --> 00:12:43,400
!أسرع! ستنهار أونيغاشيما

136
00:12:48,700 --> 00:12:49,870
...أرجوك يا لوفي

137
00:12:50,200 --> 00:12:53,710
.أنهِ المعركة في أسرع وقت ممكن

138
00:12:56,370 --> 00:12:58,380
!لا تستسلموا

139
00:12:58,540 --> 00:13:01,460
!قاتلوا حتّى النّهاية

140
00:13:03,600 --> 00:13:06,220
،لم تلده أمّه بعد

141
00:13:06,550 --> 00:13:08,890
!هذا الّذي سيهزمني

142
00:13:20,520 --> 00:13:21,690
!أحسنت

143
00:13:22,610 --> 00:13:24,780
.أنا أثني على شجاعتك

144
00:13:28,570 --> 00:13:30,960
كنت قويّة جدًّا طوال هذه السّنوات

145
00:13:31,240 --> 00:13:32,540
...يا هيوري-ساما

146
00:13:36,620 --> 00:13:39,090
!اذهبوا جميعًا لطابق العرض

147
00:13:39,240 --> 00:13:40,420
...هذا ساخن

148
00:13:54,190 --> 00:13:54,930
.وصل الماء

149
00:14:03,880 --> 00:14:05,320
ما سبب هذا الاهتزاز؟

150
00:14:08,200 --> 00:14:09,410
ما هذا الصّوت؟

151
00:14:09,530 --> 00:14:11,230
.أشمّ رائحة مشاكل

152
00:14:12,370 --> 00:14:13,780
!روبين-سان

153
00:14:17,620 --> 00:14:19,830
!لا تفقد الأمل أيّها الهيكل العظميّ

154
00:14:20,100 --> 00:14:22,450
!سينتصر أملنا

155
00:14:26,210 --> 00:14:29,090
!أخمدي كلّ النّيران

156
00:14:34,260 --> 00:14:36,310
!النّجدة

157
00:14:40,310 --> 00:14:42,060
أنقذي الجميع

158
00:14:42,190 --> 00:14:44,360
!يا مياه زو

159
00:15:00,000 --> 00:15:01,250
!هذه مياه

160
00:15:01,370 --> 00:15:03,670
!إنّها تجرف الجميع

161
00:15:04,260 --> 00:15:05,800
...هل يُعقل

162
00:15:05,970 --> 00:15:08,970
!قلتُ أنّي سأعود حيًّا

163
00:15:09,170 --> 00:15:11,010
أوسوبّ؟ –
كنييمون؟ –

164
00:15:11,130 --> 00:15:12,590
أوكيكو-تشان؟

165
00:15:13,050 --> 00:15:14,470
!كلاّ

166
00:15:23,770 --> 00:15:25,360
...آسف يا زورو

167
00:15:25,860 --> 00:15:29,530
!لا تدعوا المياه تجرفكم أيّها الأغبياء

168
00:15:31,240 --> 00:15:32,780
من أين تأتي هذه المياه؟

169
00:15:33,870 --> 00:15:34,950
!مهلاً، مهلاً، مهلاً

170
00:15:35,080 --> 00:15:35,910
!سانجي-سان

171
00:15:36,240 --> 00:15:38,000
!أوسومي-تشان

172
00:15:42,420 --> 00:15:44,420
ما الّذي يحدث لأونيغاشيما؟

173
00:15:49,380 --> 00:15:51,720
.اختفت سُحب اللّهب

174
00:15:54,550 --> 00:15:57,970
!لا! ستسقط أونيغاشيما

175
00:16:17,320 --> 00:16:19,040
!النّجدة

176
00:16:23,670 --> 00:16:26,670
!أنقذ سكّان عاصمة الزّهور

177
00:16:30,020 --> 00:16:31,340
أقسم بحياتي

178
00:16:31,720 --> 00:16:34,550
!أنّي لن أسمح لأيّ شخص بالمعاناة أكثر

179
00:16:36,470 --> 00:16:40,140
!انطلقي يا سحب اللّهب

180
00:16:43,090 --> 00:16:46,440
!ممتاز! هذا مذهل يا مومونوسكي-كُن

181
00:16:46,880 --> 00:16:48,370
!أوقف الجزيرة

182
00:16:48,690 --> 00:16:51,170
!عُلم وسيُنفّد

183
00:16:56,160 --> 00:16:58,160
!انطلق

184
00:17:16,510 --> 00:17:19,640
.تحكم القوّة العالم

185
00:17:20,140 --> 00:17:22,850
!أمّا أنت، فستكون ضحيّة لا غير

186
00:17:22,970 --> 00:17:24,640
!اخرس

187
00:17:41,530 --> 00:17:45,500
!قبّعة القشّ! من الأفضل ألاّ تفشل

188
00:17:45,960 --> 00:17:48,050
!أنهِ أمره يا قبّعة القشّ-يا

189
00:17:51,290 --> 00:17:55,010
.الأقوياء يعيشون والضّعفاء يموتون

190
00:17:55,180 --> 00:17:57,720
.سأدفنك أنت وأصدقاؤك

191
00:17:58,010 --> 00:17:59,140
!اخرس

192
00:18:06,430 --> 00:18:10,520
.سأحكم العالم من بلاد وانو

193
00:18:11,550 --> 00:18:15,690
وأنت أيّها الغرّ، ما العالم الّذي تظنّ
أنّ بإمكانك بناؤه؟

194
00:18:15,920 --> 00:18:17,740
!يا قبّعة القشّ

195
00:18:28,610 --> 00:18:29,500
.تاما

196
00:18:30,210 --> 00:18:31,960
!لا ترضي بالقليل

197
00:18:32,210 --> 00:18:33,960
!سأجعل هذه حياتك اليوميّة

198
00:18:36,210 --> 00:18:38,760
،عندما نغادر هذه البلاد

199
00:18:38,930 --> 00:18:42,760
سأجعل منها مكانًا حيث
!تستطيعين الأكل قدر ما تشائين

200
00:18:47,430 --> 00:18:48,820
!أخي الكبير

201
00:19:07,080 --> 00:19:08,870
ما العالم الّذي أريد بناءه؟

202
00:19:10,630 --> 00:19:12,290
!لوفي

203
00:19:13,210 --> 00:19:15,210
!هجوم

204
00:19:26,930 --> 00:19:28,430
...إنّه عالم

205
00:19:38,230 --> 00:19:41,070
...عالم يستطيع فيه أصدقائي

206
00:19:47,030 --> 00:19:49,200
...أكل ما يودّون

207
00:19:50,500 --> 00:19:52,260
!من الطّعام

208
00:20:02,190 --> 00:20:04,470
!كايدو

209
00:21:02,940 --> 00:21:04,150
...كينغ

210
00:21:04,360 --> 00:21:08,570
.أظنّ أنّي أعرف من يكون جويبوي

211
00:21:09,410 --> 00:21:10,420
من يكون؟

212
00:21:11,970 --> 00:21:15,750
.إنّه الرّجل الّذي سيهزمني يومًا ما

213
00:21:17,290 --> 00:21:19,960
.في تلك الحالة، لا وجود له إذًا

214
00:22:05,260 --> 00:22:08,470
انتهى الوقت

215
00:22:09,340 --> 00:22:12,890
هنالك من ضحك ثانية

216
00:22:13,310 --> 00:22:19,900
لا بأس، فإنّ الغمّيضة الآن انتهت

217
00:22:20,770 --> 00:22:24,940
تعال معي
(سنراها قريبًا)

218
00:22:24,940 --> 00:22:28,700
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

219
00:22:28,700 --> 00:22:33,080
شيء ما سيتغيّر
(سنراها قريبًا)

220
00:22:33,080 --> 00:22:37,330
كن قويًّا، ما زال هنالك وقت
(3-2-1)

221
00:22:45,210 --> 00:22:49,300
لكنّنا شباب، لذلك فنحن أحرار

222
00:22:49,300 --> 00:22:53,930
لنعش جميعًا أحلامنا الأكثر حماقة

223
00:22:53,930 --> 00:22:57,850
سننير الطّريق المظلم أمامنا

224
00:22:57,850 --> 00:23:01,980
لنقف على أقدامنا ونحاول

225
00:23:01,980 --> 00:23:05,900
لنكتشف معًا أصقاع العالم

226
00:23:05,900 --> 00:23:09,900
أنا وأنت، سنحلّق بعيدًا

227
00:23:18,510 --> 00:23:20,950
،هوى كايدو إلى الهاوية

228
00:23:21,540 --> 00:23:24,770
.تحت ضوء الآمال الّتي تنير وانو

229
00:23:25,140 --> 00:23:28,090
.يشهد السّاموراي على حقبة جديدة

230
00:23:29,030 --> 00:23:31,630
،وقبضة لوفي الّتي كانت لأجل شعب وانو

231
00:23:31,900 --> 00:23:35,350
.استعادت الحرّيّة والكرامة اللّتان سُلبتا منهم

232
00:23:36,510 --> 00:23:37,880
:في الحلقة القادمة من وان بيس

233
00:23:38,020 --> 00:23:41,110
"!أسدل السّتار. المنتصر هو قبّعة القشّ لوفي"

234
00:23:41,250 --> 00:23:43,910
!ملك القراصنة، لن يكون إلاّ أنا