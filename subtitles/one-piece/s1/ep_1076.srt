1
00:00:00,680 --> 00:00:04,310
بوجود الضّعف كحليف لي

2
00:00:04,350 --> 00:00:07,930
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,980 --> 00:00:10,650
من المؤسف البقاء في مكان كهذا

4
00:00:10,690 --> 00:00:14,770
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,230 --> 00:00:18,860
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,900 --> 00:00:22,490
إن كان قلبي أيضًا ضائعًا

7
00:00:22,530 --> 00:00:25,200
فلن أتمكّن من إيجادك

8
00:00:25,240 --> 00:00:29,250
لا لطفك ولا قوّتك

9
00:00:29,290 --> 00:00:35,040
أعلم مسبقًا

10
00:00:35,090 --> 00:00:36,960
إنّ بزوغ الفجر وشيك

11
00:00:37,000 --> 00:00:40,260
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,300 --> 00:00:44,300
سأندفع عبر الطّريق بأكمله

13
00:00:44,350 --> 00:00:47,060
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,100 --> 00:00:51,560
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,600 --> 00:00:54,310
بوجود العالم كعدوّ لي

16
00:00:54,360 --> 00:00:58,780
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,820 --> 00:01:01,570
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,610 --> 00:01:06,120
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:16,000 --> 00:01:21,090
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:27,490 --> 00:01:30,120
!هيّا

21
00:01:35,790 --> 00:01:38,500
سيُترك واحد منّا في الخلف

22
00:01:38,800 --> 00:01:40,560
!يا قبّعة القشّ

23
00:01:45,800 --> 00:01:47,930
!ستدمّر أونيغاشيما

24
00:01:48,100 --> 00:01:49,680
!أنشئ سُحبًا

25
00:01:50,060 --> 00:01:52,860
!قبل أن يصيبنا هجومه

26
00:02:12,790 --> 00:02:15,790
!سأطلق العنان لنفسي كما لم أفعل من قبل

27
00:02:28,480 --> 00:02:30,880
"!العالم الّذي يصبو إليه لوفي"

28
00:02:39,810 --> 00:02:40,940
.كايدو-سان

29
00:02:42,070 --> 00:02:44,380
إلى أين ستذهب يا كايدو؟

30
00:02:45,360 --> 00:02:49,200
.وحدها الحرب تحدّد قيمة الرّجال

31
00:02:52,660 --> 00:02:55,000
.صرتَ تجسيدًا للقوّة

32
00:02:59,420 --> 00:03:02,420
.سأنهب العالم بأكمله

33
00:03:04,210 --> 00:03:07,220
.أدين بلقب اليونكو لنفسي فقط

34
00:03:12,730 --> 00:03:14,520
!يا له من إنجاز يا كايدو

35
00:03:14,680 --> 00:03:16,850
!إنّه شيطان يحلم مضربًا

36
00:03:20,440 --> 00:03:25,400
.لا يوجد في العالم من يمكنه منافستي

37
00:03:30,620 --> 00:03:33,090
.هناك أمور كثيرة تجهلها يا فتى

38
00:03:34,330 --> 00:03:37,830
.لا تستطيع بلادنا التّوقّف عن شنّ الحروب الآن

39
00:03:38,250 --> 00:03:42,120
علينا الانتصار وجمع غنائمنا من العدوّ
.لنتمكّن من دفع الضّريبة السّماويّة

40
00:03:42,540 --> 00:03:46,510
.إمّا أن نفعل هذا، أو نفقد حقوقنا كبشر

41
00:03:47,800 --> 00:03:50,980
.لا ترانا هذه البلاد إلاّ كأدوات

42
00:03:52,320 --> 00:03:56,550
لماذا على الجميع أن ينحني لهؤلاء
التّنانين السّماويّين؟

43
00:04:03,150 --> 00:04:05,200
!اخلعوا قيودي

44
00:04:06,350 --> 00:04:09,860
ما الّذي فعلته لأستحقّ هذا؟

45
00:04:12,290 --> 00:04:13,760
.لقد تمّ تجنيدك

46
00:04:14,100 --> 00:04:16,200
.ستصير جنديًّا في البحريّة

47
00:04:17,460 --> 00:04:19,730
لماذا قد أصير كلبًا للحكومة؟

48
00:04:19,880 --> 00:04:22,720
.ما عادت بلادنا تستطيع التّحكّم بك

49
00:04:22,850 --> 00:04:25,880
!اخرس! لم أطلب رأيك

50
00:04:26,050 --> 00:04:27,970
!لا تعبثوا معي

51
00:04:28,550 --> 00:04:30,930
!ستدفعون الثّمن

52
00:04:33,340 --> 00:04:35,100
سلّموا لنا كايدو

53
00:04:37,520 --> 00:04:39,600
وستشارك بلادكم

54
00:04:39,770 --> 00:04:41,600
.في قمّة اللّيفيلي القادمة

55
00:04:41,730 --> 00:04:45,310
!لستُ بيدقًا في لعبتكم السّياسيّة هذه

56
00:04:57,630 --> 00:05:00,200
.يستدعي الضّعفُ الخيانة

57
00:05:00,660 --> 00:05:04,010
سأبني أقوى جيش في العالم

58
00:05:04,230 --> 00:05:06,420
وسأجعل هذا العالم المملّ

59
00:05:06,540 --> 00:05:09,340
.عالمًا تحكمه القوّة

60
00:05:11,050 --> 00:05:13,370
!لا يوجد من هو أقوى منّي

61
00:05:18,130 --> 00:05:19,680
،أنت ورفاقك

62
00:05:19,810 --> 00:05:23,300
.نجحتم في جمع السّاموراي حولكم

63
00:05:23,440 --> 00:05:24,850
!عمل يستحقّ الثّناء

64
00:05:30,490 --> 00:05:32,110
زرعتم الأمل

65
00:05:32,240 --> 00:05:36,120
في قلوب كلّ جبناء بلاد وانو الّذين
.كانوا عاجزين عن المبادرة بأنفسهم

66
00:05:36,660 --> 00:05:38,490
،عهدوا لكم بمستقبلهم

67
00:05:38,610 --> 00:05:42,050
لكن ما العالم الّذي تودّ تركه لهم؟

68
00:05:42,410 --> 00:05:44,300
!أجبني يا قبّعة القشّ

69
00:05:51,670 --> 00:05:53,460
.أبليتَ حسنًا

70
00:06:07,940 --> 00:06:10,570
.قاتلتَ ببسالة

71
00:06:10,900 --> 00:06:11,900
،ولكن

72
00:06:16,740 --> 00:06:20,240
!لا تملك ما يتطلّبه الأمر لتغيير العالم

73
00:06:21,700 --> 00:06:24,620
!أيّها المقرّ الرّئيسيّ! هرب كايدو

74
00:06:24,870 --> 00:06:27,460
!إنّه يدمّر الأسطول ومعه كلّ رجالنا

75
00:06:29,380 --> 00:06:33,730
.أكرّر، هرب كايدو
!تكبّدنا خسائر جسيمة

76
00:06:35,380 --> 00:06:38,480
كيف نقاتل هذا الوحش؟

77
00:06:40,450 --> 00:06:43,560
!كلاّ! إيّاك والاقتراب منّي

78
00:07:12,090 --> 00:07:14,080
!قبضنا على كايدو

79
00:07:24,190 --> 00:07:26,310
...هرب كايدو

80
00:07:26,850 --> 00:07:28,280
!هرب مرّة أخرى

81
00:07:28,600 --> 00:07:32,600
يسمح لنا هذا الوغد بالإمساك به
!في كلّ مرّة يشعر فيها بالجوع

82
00:07:33,770 --> 00:07:36,850
!هذه سفينة سجن، وليست مطعمًا

83
00:07:45,980 --> 00:07:48,720
!إنّه قويّ جدًّا –
من هذا الفتى؟ –

84
00:07:48,960 --> 00:07:52,010
!إنّه بالكاد في الخامسة عشر

85
00:07:53,100 --> 00:07:55,550
!هذه ليست مكافأة تُمنح لطفل

86
00:07:55,760 --> 00:07:57,350
!إنّه وحش

87
00:07:58,960 --> 00:08:00,680
.أيّها الشّقيّ

88
00:08:01,510 --> 00:08:04,280
هل فكّرت يومًا أن تصير قرصانًا؟

89
00:08:06,610 --> 00:08:08,850
.سيحبّ روكس أن يلقاك

90
00:08:09,380 --> 00:08:10,670
هل ستأتي؟

91
00:08:14,760 --> 00:08:18,160
!انضمّ كايدو لطاقم روكس

92
00:08:18,320 --> 00:08:20,990
!ما عاد لهم من رادع الآن

93
00:08:22,870 --> 00:08:25,330
.كايدو! الوضع خطير

94
00:08:25,490 --> 00:08:28,830
!تعال، سنبحر إلى غود فالي

95
00:08:31,580 --> 00:08:34,880
!قُضي على طاقم روكس

96
00:08:36,790 --> 00:08:38,710
...هذا لا يُغتفر

97
00:08:38,950 --> 00:08:43,700
كيف يُعقل وهو يضمّ وحوشًا لا تقهر؟

98
00:08:43,840 --> 00:08:46,760
!يبدو أنّ جنديّ بحريّة يدعى غارب أطاح بهم

99
00:08:47,090 --> 00:08:51,810
.أظنّ أنّهم لم يطيقوا بعضهم فحسب
.لم يعرفوا كيف يعملون معًا

100
00:08:51,970 --> 00:08:54,550
إلى أين ستذهب يا كايدو؟

101
00:08:55,900 --> 00:08:59,030
!لا تعبث معي أيّها الوغد

102
00:09:03,630 --> 00:09:05,870
،بعد عشر سنوات من تلك الحادثة

103
00:09:06,660 --> 00:09:10,750
.صرتَ تجسيدًا للقوّة يا كايدو

104
00:09:12,820 --> 00:09:14,500
،في تاريخ البشريّة كلّه

105
00:09:14,780 --> 00:09:18,960
.لطالما كانت القوّة حلاًّ لكلّ المشاكل

106
00:09:20,260 --> 00:09:22,380
.منطق سليم

107
00:09:22,830 --> 00:09:24,710
.نحن حيوانات

108
00:09:25,120 --> 00:09:27,970
.النّجاة للأقوى هو قانون الطّبيعة

109
00:09:28,110 --> 00:09:29,890
.معك حقّ في كلامك هذا

110
00:09:30,110 --> 00:09:34,500
كما أنّ بقايا طاقم روكس
.سيتقاتلون لكسب القوّة أيضًا

111
00:09:34,620 --> 00:09:37,110
.الأسلحة هي ما تحكم عالمنا هذا

112
00:09:37,270 --> 00:09:40,440
.لديّ صفقة مفيدة لأعرضها عليك

113
00:09:43,740 --> 00:09:46,490
...سنأخذ كلّ أولئك الحكّام النّبلاء المدلّلين

114
00:09:46,910 --> 00:09:49,700
!الّذين يظنّون أنّ قوّتهم تجلب السّلام

115
00:09:50,100 --> 00:09:53,970
!وأجرّهم إلى ساحات المعارك إلى جانبكم

116
00:09:58,840 --> 00:10:02,010
!هذا هو ما أسمّيه المساواة والحرّيّة

117
00:10:02,280 --> 00:10:06,630
.وحدها الحرب تحدّد قيمة الرّجال

118
00:10:11,420 --> 00:10:15,060
!سيكون النّصر حليفي أنا

119
00:10:31,580 --> 00:10:34,080
.جاء ياماتو على ذكر جويبوي

120
00:10:34,370 --> 00:10:36,960
.أتساءل أين سمع ذلك الاسم

121
00:10:38,430 --> 00:10:43,510
إنّ أودن يريد فتح الحدود استعدادًا
.للتّرحيب بجويبوي في بلاد وانو

122
00:10:44,200 --> 00:10:48,680
أليس هو الرّجل الّذي تنتظره يا كينغ؟

123
00:10:49,120 --> 00:10:53,390
.في تلك الحالة، أعرف من يكون

124
00:11:29,050 --> 00:11:31,180
!انطلق يا لوفي

125
00:11:31,430 --> 00:11:35,310
!ستغادر هذه البلاد

126
00:11:48,860 --> 00:11:51,160
!تشجّع يا مومونوسكي

127
00:11:51,820 --> 00:11:54,330
.سيحقّق لوفي النّصر

128
00:11:55,490 --> 00:11:58,840
!ستكون هذه نهاية كايدو الشّنيع

129
00:11:59,370 --> 00:12:01,500
!سأقوم بواجبي

130
00:12:02,750 --> 00:12:04,170
!هذا ما نريده

131
00:12:04,380 --> 00:12:08,170
!حماية شعب بلاد وانو بين يديك الآن

132
00:12:08,830 --> 00:12:12,600
!أنت لها يا مومونوسكي-كُن

133
00:12:14,180 --> 00:12:16,520
!انطلقي يا سحب اللّهب

134
00:12:16,670 --> 00:12:19,730
!ستنصاعين لإرادتي

135
00:12:25,590 --> 00:12:29,400
!أسرع! ستنهار أونيغاشيما

136
00:12:34,700 --> 00:12:35,870
...أرجوك يا لوفي

137
00:12:36,200 --> 00:12:39,710
.أنهِ المعركة في أسرع وقت ممكن

138
00:12:42,370 --> 00:12:44,380
!لا تستسلموا

139
00:12:44,540 --> 00:12:47,460
!قاتلوا حتّى النّهاية

140
00:12:49,600 --> 00:12:52,220
،لم تلده أمّه بعد

141
00:12:52,550 --> 00:12:54,890
!هذا الّذي سيهزمني

142
00:13:06,520 --> 00:13:07,690
!أحسنت

143
00:13:08,610 --> 00:13:10,780
.أنا أثني على شجاعتك

144
00:13:14,570 --> 00:13:16,960
كنت قويّة جدًّا طوال هذه السّنوات

145
00:13:17,240 --> 00:13:18,540
...يا هيوري-ساما

146
00:13:22,620 --> 00:13:25,090
!اذهبوا جميعًا لطابق العرض

147
00:13:25,240 --> 00:13:26,420
...هذا ساخن

148
00:13:40,190 --> 00:13:40,930
.وصل الماء

149
00:13:49,880 --> 00:13:51,320
ما سبب هذا الاهتزاز؟

150
00:13:54,200 --> 00:13:55,410
ما هذا الصّوت؟

151
00:13:55,530 --> 00:13:57,230
.أشمّ رائحة مشاكل

152
00:13:58,370 --> 00:13:59,780
!روبين-سان

153
00:14:03,620 --> 00:14:05,830
!لا تفقد الأمل أيّها الهيكل العظميّ

154
00:14:06,100 --> 00:14:08,450
!سينتصر أملنا

155
00:14:12,210 --> 00:14:15,090
!أخمدي كلّ النّيران

156
00:14:20,260 --> 00:14:22,310
!النّجدة

157
00:14:26,310 --> 00:14:28,060
أنقذي الجميع

158
00:14:28,190 --> 00:14:30,360
!يا مياه زو

159
00:14:46,000 --> 00:14:47,250
!هذه مياه

160
00:14:47,370 --> 00:14:49,670
!إنّها تجرف الجميع

161
00:14:50,260 --> 00:14:51,800
...هل يُعقل

162
00:14:51,970 --> 00:14:54,970
!قلتُ أنّي سأعود حيًّا

163
00:14:55,170 --> 00:14:57,010
أوسوبّ؟ –
كنييمون؟ –

164
00:14:57,130 --> 00:14:58,590
أوكيكو-تشان؟

165
00:14:59,050 --> 00:15:00,470
!كلاّ

166
00:15:09,770 --> 00:15:11,360
...آسف يا زورو

167
00:15:11,860 --> 00:15:15,530
!لا تدعوا المياه تجرفكم أيّها الأغبياء

168
00:15:17,240 --> 00:15:18,780
من أين تأتي هذه المياه؟

169
00:15:19,870 --> 00:15:20,950
!مهلاً، مهلاً، مهلاً

170
00:15:21,080 --> 00:15:21,910
!سانجي-سان

171
00:15:22,240 --> 00:15:24,000
!أوسومي-تشان

172
00:15:28,420 --> 00:15:30,420
ما الّذي يحدث لأونيغاشيما؟

173
00:15:35,380 --> 00:15:37,720
.اختفت سُحب اللّهب

174
00:15:40,550 --> 00:15:43,970
!لا! ستسقط أونيغاشيما

175
00:16:03,320 --> 00:16:05,040
!النّجدة

176
00:16:09,670 --> 00:16:12,670
!أنقذ سكّان عاصمة الزّهور

177
00:16:16,020 --> 00:16:17,340
أقسم بحياتي

178
00:16:17,720 --> 00:16:20,550
!أنّي لن أسمح لأيّ شخص بالمعاناة أكثر

179
00:16:22,470 --> 00:16:26,140
!انطلقي يا سحب اللّهب

180
00:16:29,090 --> 00:16:32,440
!ممتاز! هذا مذهل يا مومونوسكي-كُن

181
00:16:32,880 --> 00:16:34,370
!أوقف الجزيرة

182
00:16:34,690 --> 00:16:37,170
!عُلم وسيُنفّد

183
00:16:42,160 --> 00:16:44,160
!انطلق

184
00:17:02,510 --> 00:17:05,640
.تحكم القوّة العالم

185
00:17:06,140 --> 00:17:08,850
!أمّا أنت، فستكون ضحيّة لا غير

186
00:17:08,970 --> 00:17:10,640
!اخرس

187
00:17:27,530 --> 00:17:31,500
!قبّعة القشّ! من الأفضل ألاّ تفشل

188
00:17:31,960 --> 00:17:34,050
!أنهِ أمره يا قبّعة القشّ-يا

189
00:17:37,290 --> 00:17:41,010
.الأقوياء يعيشون والضّعفاء يموتون

190
00:17:41,180 --> 00:17:43,720
.سأدفنك أنت وأصدقاؤك

191
00:17:44,010 --> 00:17:45,140
!اخرس

192
00:17:52,430 --> 00:17:56,520
.سأحكم العالم من بلاد وانو

193
00:17:57,550 --> 00:18:01,690
وأنت أيّها الغرّ، ما العالم الّذي تظنّ
أنّ بإمكانك بناؤه؟

194
00:18:01,920 --> 00:18:03,740
!يا قبّعة القشّ

195
00:18:14,610 --> 00:18:15,500
.تاما

196
00:18:16,210 --> 00:18:17,960
!لا ترضي بالقليل

197
00:18:18,210 --> 00:18:19,960
!سأجعل هذه حياتك اليوميّة

198
00:18:22,210 --> 00:18:24,760
،عندما نغادر هذه البلاد

199
00:18:24,930 --> 00:18:28,760
سأجعل منها مكانًا حيث
!تستطيعين الأكل قدر ما تشائين

200
00:18:33,430 --> 00:18:34,820
!أخي الكبير

201
00:18:53,080 --> 00:18:54,870
ما العالم الّذي أريد بناءه؟

202
00:18:56,630 --> 00:18:58,290
!لوفي

203
00:18:59,210 --> 00:19:01,210
!هجوم

204
00:19:12,930 --> 00:19:14,430
...إنّه عالم

205
00:19:24,230 --> 00:19:27,070
...عالم يستطيع فيه أصدقائي

206
00:19:33,030 --> 00:19:35,200
...أكل ما يودّون

207
00:19:36,500 --> 00:19:38,260
!من الطّعام

208
00:19:48,190 --> 00:19:50,470
!كايدو

209
00:20:48,940 --> 00:20:50,150
...كينغ

210
00:20:50,360 --> 00:20:54,570
.أظنّ أنّي أعرف من يكون جويبوي

211
00:20:55,410 --> 00:20:56,420
من يكون؟

212
00:20:57,970 --> 00:21:01,750
.إنّه الرّجل الّذي سيهزمني يومًا ما

213
00:21:03,290 --> 00:21:05,960
.في تلك الحالة، لا وجود له إذًا

214
00:21:51,260 --> 00:21:54,470
انتهى الوقت

215
00:21:55,340 --> 00:21:58,890
هنالك من ضحك ثانية

216
00:21:59,310 --> 00:22:05,900
لا بأس، فإنّ الغمّيضة الآن انتهت

217
00:22:06,770 --> 00:22:10,940
تعال معي
(سنراها قريبًا)

218
00:22:10,940 --> 00:22:14,700
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

219
00:22:14,700 --> 00:22:19,080
شيء ما سيتغيّر
(سنراها قريبًا)

220
00:22:19,080 --> 00:22:23,330
كن قويًّا، ما زال هنالك وقت
(3-2-1)

221
00:22:31,210 --> 00:22:35,300
لكنّنا شباب، لذلك فنحن أحرار

222
00:22:35,300 --> 00:22:39,930
لنعش جميعًا أحلامنا الأكثر حماقة

223
00:22:39,930 --> 00:22:43,850
سننير الطّريق المظلم أمامنا

224
00:22:43,850 --> 00:22:47,980
لنقف على أقدامنا ونحاول

225
00:22:47,980 --> 00:22:51,900
لنكتشف معًا أصقاع العالم

226
00:22:51,900 --> 00:22:55,900
أنا وأنت، سنحلّق بعيدًا

227
00:23:04,510 --> 00:23:06,950
،هوى كايدو إلى الهاوية

228
00:23:07,540 --> 00:23:10,770
.تحت ضوء الآمال الّتي تنير وانو

229
00:23:11,140 --> 00:23:14,090
.يشهد السّاموراي على حقبة جديدة

230
00:23:15,030 --> 00:23:17,630
،وقبضة لوفي الّتي كانت لأجل شعب وانو

231
00:23:17,900 --> 00:23:21,350
.استعادت الحرّيّة والكرامة اللّتان سُلبتا منهم

232
00:23:22,510 --> 00:23:23,880
:في الحلقة القادمة من وان بيس

233
00:23:24,020 --> 00:23:27,110
"!أسدل السّتار. المنتصر هو قبّعة القشّ لوفي"

234
00:23:27,250 --> 00:23:29,910
!ملك القراصنة، لن يكون إلاّ أنا