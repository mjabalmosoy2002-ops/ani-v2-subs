1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:01:54,540 --> 00:01:56,580
.أرجوك، غادر السّفينة يا سانجي-سان

26
00:01:56,780 --> 00:01:58,580
.لا أريد قتلك

27
00:01:58,980 --> 00:02:00,180
!مستحيل

28
00:02:00,420 --> 00:02:03,150
!صنجا اللّآلئ

29
00:02:09,160 --> 00:02:13,360
سلبتُ ذلك العجوز
...اللّعين كلّ شيء

30
00:02:14,130 --> 00:02:16,330
...لأعيش أنا

31
00:02:17,370 --> 00:02:18,430
...قوّته

32
00:02:19,770 --> 00:02:20,970
...حلمه

33
00:02:31,880 --> 00:02:35,250
!هذا المطعم هو كنز ذلك العجوز

34
00:02:36,120 --> 00:02:40,590
حتّى أنا... لا أستطيع ردّ جميل
العجوز اللّعين

35
00:02:40,590 --> 00:02:43,630
!إلاّ إذا خاطرتُ بحياتي من أجله أيضًا

36
00:02:44,560 --> 00:02:46,600
...غومو غومو نوو

37
00:02:46,960 --> 00:02:48,860
!توقّف أيّها الغبيّ! لا تتورّط معهم

38
00:02:49,560 --> 00:02:52,100
!فأس المعركة

39
00:03:01,340 --> 00:03:05,910
،الشّيطان الهادئ والقاسي"
".غين، قائد قوّات أسطول القراصنة

40
00:03:22,530 --> 00:03:25,300
!دُمّرت الزّعنفة

41
00:03:30,400 --> 00:03:33,310
كيف يجرؤ ذلك الشّقيّ
على فعل شيء كهذا؟

42
00:03:34,240 --> 00:03:36,280
!هل يحاول تدمير هذه السّفينة؟

43
00:03:36,410 --> 00:03:39,750
!غين! فجّر رأس زيف

44
00:03:41,620 --> 00:03:43,050
!اقتله بسرعة

45
00:03:43,050 --> 00:03:48,660
!لـ-لكنّه أنقذ حياتنا بمنحنا مئة وجبة

46
00:03:50,920 --> 00:03:52,460
!أيّها الوغد غين

47
00:03:52,460 --> 00:03:53,230
!اسمع

48
00:03:53,560 --> 00:03:56,930
...أنا لم أهاجمكم أو أيّ شيء

49
00:03:58,100 --> 00:03:59,700
.دمّرت الزّعنفة فحسب

50
00:04:01,170 --> 00:04:04,540
!ما الّذي تفعله أيّها الفتى العامل؟

51
00:04:04,540 --> 00:04:05,140
.سأغرقها

52
00:04:05,140 --> 00:04:06,110
!ماذا؟

53
00:04:07,710 --> 00:04:09,070
.سأغرق هذه السّفينة

54
00:04:12,340 --> 00:04:14,880
!لا تعبث معنا

55
00:04:15,210 --> 00:04:19,150
...كنتُ أتساءل كيف ستفسّر ذلك
!هل أنت مجنون أيّها الوغد؟

56
00:04:19,150 --> 00:04:22,350
لن يكون لديهم أيّ سبب
.للهجوم إن دمّرتُ السّفينة

57
00:04:25,660 --> 00:04:27,390
ما أدراك؟

58
00:04:27,830 --> 00:04:29,630
ما أدراك عن مدى أهمّيّة الجميل الّذي تلقّيتُه؟

59
00:04:29,630 --> 00:04:31,300
ما أدراك أنت عن هذا المطعم؟

60
00:04:32,100 --> 00:04:36,130
إذًا فستموت من أجل المطعم؟
هل أنت غبيّ أم ماذا؟

61
00:04:36,130 --> 00:04:37,240
!ماذا قلت؟

62
00:04:37,540 --> 00:04:38,700
...الموت ليس

63
00:04:39,370 --> 00:04:42,110
!الموت ليس أمرًا تردّ به الجميل

64
00:04:43,040 --> 00:04:45,380
!لم ينقذك لذلك السّبب

65
00:04:46,310 --> 00:04:51,080
...الموت بعد فرصة ثانية لتعيش
!هو أمر يفعله الضّعفاء فحسب

66
00:04:51,080 --> 00:04:54,020
هل هنالك أيّ طريقة أخرى
!لحلّ هذه المسألة؟

67
00:05:00,760 --> 00:05:04,130
.مهلًا، مهلًا يا رفيقيّ... كفاكما قتالًا

68
00:05:04,430 --> 00:05:07,400
.من المخزي أن تتقاتلا بعد كلّ ما حدث

69
00:05:08,530 --> 00:05:12,440
لا يمكنكما القيام بأيّ أعمال
.متهوّرة أخرى بينما الرّهينة معنا

70
00:05:13,070 --> 00:05:17,640
لسوء حظّكم يا رفيقيّ
.أنّ قراصنة كريغ هم خصمكم

71
00:05:22,250 --> 00:05:26,680
!فلتموتا حرقًا بنيران لآلئي

72
00:05:42,800 --> 00:05:44,770
...غين! لماذا

73
00:05:45,270 --> 00:05:47,300
غين-سان؟

74
00:05:47,870 --> 00:05:50,640
...آسف يا بيرل. ابتعد عن طريقي

75
00:05:55,980 --> 00:05:58,850
!غين! هل ستخوننا؟

76
00:05:59,380 --> 00:06:05,350
.آسف أيّها الدّون كريغ
.لقد أنقذ حياتنا

77
00:06:05,950 --> 00:06:11,560
.لا أريده أن يموت هكذا
...على الأقلّ... على الأقلّ

78
00:06:13,430 --> 00:06:15,930
.دعني أدفنه بيديّ هاتين

79
00:06:20,470 --> 00:06:26,310
هل فقدتَ رشدك يا قائد
قوّات أسطول القراصنة؟

80
00:06:26,840 --> 00:06:28,640
هل أنت بخير أيّها المالك؟

81
00:06:28,640 --> 00:06:30,810
!أيّها المالك! تماسك أرجوك

82
00:06:31,780 --> 00:06:33,480
قائد قوّات؟

83
00:06:33,980 --> 00:06:36,980
إذًا فهو ليس مجرّد تابع؟

84
00:06:36,980 --> 00:06:41,290
لا أصدّق أنّه حطّم درع
...ذلك المدرّع... يا لقوّته

85
00:06:44,320 --> 00:06:48,000
...أرأيت؟ نجح الأمر
...إنّها خطّتي لاستدراجه

86
00:06:48,000 --> 00:06:51,770
كاذب! كنتَ ستحطّم
السّفينة بالفعل، صحيح؟

87
00:06:52,370 --> 00:06:53,230
!سانجي-سان

88
00:06:54,270 --> 00:06:58,240
،لم أرد تدمير هذه السّفينة

89
00:06:58,540 --> 00:07:00,340
.لكن يبدو أنّ ذلك لن يحدث

90
00:07:00,340 --> 00:07:02,340
.نعم، أنت محقّ

91
00:07:02,340 --> 00:07:07,150
لن أسمح لكم بأخذ هذا المطعم
.وإن عنى ذلك المخاطرة بحياتي

92
00:07:07,380 --> 00:07:12,020
على الأقلّ سيكون دفني لك
بيديّ هاتين هي طريقتي

93
00:07:12,020 --> 00:07:13,120
.لإنهاء هذه المسألة

94
00:07:14,590 --> 00:07:17,590
!شكرًا لك. ولتحترق في الجحيم

95
00:07:17,790 --> 00:07:19,960
.أنت أيضًا يا فتى قبّعة القشّ

96
00:07:19,960 --> 00:07:24,530
.حسنًا... لن أخسر ضدّ ضعيف مثلك

97
00:07:27,200 --> 00:07:28,630
!أيّها الوغد

98
00:07:28,630 --> 00:07:31,170
!بماذا وصفت قائد قوّاتنا؟

99
00:07:31,170 --> 00:07:34,640
احترق في الجحيم"؟ "ضعيف"؟"
!كيف تجرؤان على قول هذا؟

100
00:07:34,640 --> 00:07:39,080
،نحن قراصنة كريغ
!الأقوى في الأزرق الشّرقيّ

101
00:07:40,610 --> 00:07:43,350
ألم يكن ذلك لأنّ أعدادكم كثيرة فحسب؟

102
00:07:50,050 --> 00:07:52,990
...صحيح... أصبتهم في مقتل

103
00:07:52,990 --> 00:07:53,760
...كنتُ محقًّا إذًا

104
00:07:54,660 --> 00:07:55,560
!أيّه الوغد

105
00:07:55,560 --> 00:07:56,090
!سأقتلك

106
00:07:56,090 --> 00:07:57,730
!كفاك سخرية منّا

107
00:07:57,730 --> 00:07:59,200
!تراجعوا

108
00:07:59,700 --> 00:08:01,100
!أيّها الدّون كريغ

109
00:08:01,100 --> 00:08:02,330
...ولكن

110
00:08:03,830 --> 00:08:09,170
،إن غضبتم لأنّه وصفكم بالضّعفاء
.فذلك يثبت أنّكم كذلك فعلًا

111
00:08:10,370 --> 00:08:13,140
.ستحدّد النّتيجة إن كنتم أقوياء أم ضعفاء

112
00:08:13,440 --> 00:08:17,610
.أنا موجود هنا
!لا تتحمّسوا كثيرًا

113
00:08:17,950 --> 00:08:19,820
!حا-حاضر

114
00:08:20,150 --> 00:08:20,950
!غين

115
00:08:21,920 --> 00:08:24,790
.القضاء على ذلك الطّبّاخ مسؤوليّتك أنت

116
00:08:25,690 --> 00:08:29,760
...سأتولّى أمر ذلك الغبيّ السّاذج

117
00:08:30,990 --> 00:08:33,730
.مفهوم أيّها الدّون كريغ

118
00:08:36,600 --> 00:08:37,900
!أيّها الشّقيّ

119
00:08:38,940 --> 00:08:46,180
سأجعلك تختبر القوّة الحقيقيّة
.الّتي غزت الأزرق الشّرقيّ بالكامل

120
00:08:46,680 --> 00:08:52,980
سأعلّمك أنّ فاكهة الشّيطان الّتي
.أكلتَ أو مهما كانت لا تعني شيئًا

121
00:08:55,050 --> 00:08:57,120
...إنّ ثرثرتك مزعجة

122
00:08:58,720 --> 00:09:01,660
.سأوسعك ضربًا. الأمر بتلك البساطة

123
00:09:02,290 --> 00:09:06,860
.سآتي إليك الآن
!انتظر هناك فحسب

124
00:09:08,160 --> 00:09:09,330
...يا للوقاحة

125
00:09:21,980 --> 00:09:24,050
.هذه نهاية ذلك الطّبّاخ

126
00:09:24,050 --> 00:09:25,510
.هذا صحيح

127
00:09:25,510 --> 00:09:29,520
عندما يحمل غين-سان ذلك
.السّلاح، فذلك يعني أنّه جادّ

128
00:09:37,560 --> 00:09:40,600
...لقبه هو... الشّيطان

129
00:09:41,560 --> 00:09:44,000
،لا يهمّ إن كان عدوّه يبكي أو يصرخ

130
00:09:44,000 --> 00:09:46,130
.فسيعذّبه حتّى الموت بلا رحمة

131
00:09:46,930 --> 00:09:49,670
...إنّه شيطان لا يملك ذرّة شفقة واحدة

132
00:09:53,970 --> 00:09:58,110
،آسف يا سانجي-سان
.لكن لا يمكنك هزيمتي

133
00:09:58,310 --> 00:10:01,080
واصل كلامك ذلك فحسب
.أيّها التّابع الصّغير

134
00:10:06,890 --> 00:10:07,620
!ها أنا ذا

135
00:10:22,940 --> 00:10:23,600
...أيّها الـ

136
00:10:31,180 --> 00:10:32,140
!سانجي

137
00:10:37,880 --> 00:10:42,220
...حذّرتك... لا يمكنك هزيمتي

138
00:10:47,090 --> 00:10:48,330
...مع السّلامة

139
00:10:49,530 --> 00:10:52,030
!تقبّل الهزيمة فحسب

140
00:10:57,340 --> 00:10:59,370
!أجل! قائد قوّاتنا مذهل فعلًا

141
00:10:59,370 --> 00:11:01,310
!اسحقه يا غين-سان

142
00:11:01,310 --> 00:11:01,970
!سانجي

143
00:11:01,970 --> 00:11:04,280
!سانجي! هيّا

144
00:11:09,450 --> 00:11:10,420
!مت

145
00:11:59,960 --> 00:12:03,300
...تمكن ذلك الطّبّاخ من إصابة غين-سان

146
00:12:03,300 --> 00:12:06,870
...لا يعقل أنّ غين-سان سيُهزم أيضًا

147
00:12:07,170 --> 00:12:08,670
...أغبياء

148
00:12:09,470 --> 00:12:13,810
ما الّذي رأيتموه بأمّ أعينكم حتّى الآن؟

149
00:12:14,340 --> 00:12:17,380
.غين شيطان هادئ وضعتُ ثقتي به

150
00:12:17,910 --> 00:12:21,780
لهذا السّبب عيّنتُه
.قائدًا لقوّاتنا

151
00:12:22,520 --> 00:12:24,890
.سيُظهر معدنه الحقيقيّ قريبًا

152
00:12:30,060 --> 00:12:32,190
هل سانجي بخير فعلًا؟

153
00:12:32,190 --> 00:12:35,700
بالطّبع لا! بسبب كلّ تلك
،الهجمات من ذلك المدرّع

154
00:12:35,700 --> 00:12:38,830
فلا بدّ أنّه يعاني من خمسة
.أو ستّة أضلاع مكسورة

155
00:12:39,600 --> 00:12:45,640
...سيخ الدّانغو تلك
.ليست جيّدة... كما توقّعتها

156
00:12:46,670 --> 00:12:50,380
أهذا أفضل ما لدى قائد القوّات؟

157
00:13:01,320 --> 00:13:03,460
أهذا وقت مناسب ليعير
انتباهه لآخرين؟

158
00:13:03,690 --> 00:13:04,860
!أجل

159
00:13:05,360 --> 00:13:07,930
حسنًا! سأوسعه ضربًا
!بينما هذه الفرصة سانحة

160
00:13:15,740 --> 00:13:17,040
.لا تجهد نفسك

161
00:13:32,820 --> 00:13:36,420
!أيّها الوغد! هل تنوي قتالي فعلًا؟

162
00:13:36,990 --> 00:13:40,630
أنوي قتالك؟
.لا أحتاج لشيء كهذا

163
00:13:41,030 --> 00:13:43,930
.ما أحتاجه هو النّيّة للقتل
.هذا كلّ شيء

164
00:13:44,730 --> 00:13:50,440
.وتلك هي القوّة الّتي يملكها البشر
!تذكّر ذلك أيّها القرد اللّعين

165
00:13:50,440 --> 00:13:54,740
،ماذا؟! إن استخففتَ بقرد
!فسيخدشك

166
00:14:00,380 --> 00:14:01,410
!سانجي

167
00:14:10,860 --> 00:14:13,990
!مرحى! لا بدّ أنّ عظامه سُحقت الآن

168
00:14:13,990 --> 00:14:15,630
!نل منه

169
00:14:15,930 --> 00:14:18,830
سُحقًا! ليته لم يتلقّ أضرارًا
...بسبب ذلك المدرّع

170
00:14:18,830 --> 00:14:22,430
تلقّى عشر ضربات على الأقلّ من
...تلك الكرات الحديديّة حتّى الآن

171
00:14:26,500 --> 00:14:31,580
...تقوم بالفعل بما يحلو لك
!أيّها التّابع الصّغير

172
00:14:38,980 --> 00:14:43,050
...إنّه قويّ بالفعل

173
00:14:46,520 --> 00:14:48,130
!سأنهي أمرك الآن

174
00:14:48,530 --> 00:14:49,990
...لا تكافح أكثر

175
00:14:53,730 --> 00:14:55,700
!أهذه شفقة؟

176
00:14:57,870 --> 00:14:59,570
!لا تستخفّ بي

177
00:15:00,670 --> 00:15:02,310
!غين-سان

178
00:15:06,310 --> 00:15:07,110
!سانجي

179
00:15:11,380 --> 00:15:12,150
!سانجي

180
00:15:12,150 --> 00:15:17,520
كلاّ! لا يستطيع حتّى تحمّل
...صدمات هجماته الخاصّة

181
00:15:32,400 --> 00:15:34,070
!مرحى

182
00:15:34,070 --> 00:15:36,540
!هذا هو قائدنا غين-سان

183
00:15:40,340 --> 00:15:43,850
...وغد... لعين

184
00:16:08,640 --> 00:16:09,840
...لا يمكنني

185
00:16:11,340 --> 00:16:15,580
...لا يمكنني... أيّها الدّون كريغ

186
00:16:21,550 --> 00:16:22,920
...لا أستطيع

187
00:16:25,190 --> 00:16:29,320
!لا أستطيع فعلها أيّها الدّون كريغ

188
00:16:32,790 --> 00:16:33,690
...غين

189
00:16:34,960 --> 00:16:39,970
...لا يمكنني... قتله

190
00:16:40,700 --> 00:16:42,870
!ماذا تقول؟

191
00:16:43,100 --> 00:16:50,740
...كانت... كانت أوّل
...أوّل مرّة لي

192
00:16:51,610 --> 00:16:55,720
حتّى إن كنتُ مهزومًا وفي وضع
.سيّئ، فلن أقبل الحسنة من الآخرين

193
00:16:55,720 --> 00:16:57,250
!خذ هذا الطّعام بعيدًا عنّي

194
00:16:57,820 --> 00:17:00,290
!كفاك نواحًا وكُله بسرعة

195
00:17:00,490 --> 00:17:03,790
بالنّسبة لي، كلّ من هو جائع
.يُعتبر زبونًا

196
00:17:04,420 --> 00:17:06,960
.آسف، لكنّني لستُ زبونًا

197
00:17:07,890 --> 00:17:11,500
أستطيع إدراك كيف يشعر
.شخص جائع أكثر من غيري

198
00:17:13,370 --> 00:17:15,500
،يمكنك الموت بسبب كرامتك إن أردت

199
00:17:15,930 --> 00:17:19,400
لكن إن أكلتَ ونجوت، أفلا تعتقد
أنّ هنالك مستقبلًا ينتظرك؟

200
00:17:26,110 --> 00:17:27,280
...آسف

201
00:17:28,780 --> 00:17:34,750
.آسف... شكرًا لك... ظننتُني سأموت

202
00:17:36,920 --> 00:17:43,390
...لذيذ... هذا لذيذ
.هذه أوّل مرّة أتذوّق فيها طعامًا لذيذًا كهذا

203
00:17:44,960 --> 00:17:46,330
إنّهُ لذيذٌ جدًا، صحيح؟

204
00:17:53,500 --> 00:17:58,610
آسف... سيوبّخك لأنّك أطعمتني
بالمجّان، صحيح؟

205
00:17:58,780 --> 00:18:01,610
لا يوجد أيّ دليل، لذلك لا سبب
.يدعوه ليوبّخني

206
00:18:06,320 --> 00:18:11,490
لم يُعاملني أيّ أحد بذلك
...اللّطف من قبل

207
00:18:13,390 --> 00:18:17,960
!لذلك لا يمكنني... قتله

208
00:18:18,860 --> 00:18:20,260
!عُد في أيّ وقت

209
00:18:22,770 --> 00:18:27,840
.أعلم... لا أنوي خيانتك

210
00:18:28,440 --> 00:18:32,070
لا أعتقد أنّ ما فعلناه حتّى الآن
...خاطئ أو ما شابه أيضًا

211
00:18:32,880 --> 00:18:36,550
ما زلت أحترم قوّتك
.وأقدّرك كثيرًا أيضًا

212
00:18:37,780 --> 00:18:41,220
كنتُ سعيدًا جدًّا عندما وضعتَ ثقتك بي

213
00:18:41,220 --> 00:18:42,890
.وعيّنتني قائدًا للقوّات

214
00:18:43,620 --> 00:18:48,560
لهذا امتثلتُ لأوامرك وسأواصل
...ذلك من الآن فصاعدًا أيضًا

215
00:18:49,890 --> 00:18:51,930
...لكن... لكن

216
00:18:52,860 --> 00:18:55,630
!لا أستطيع... قتل هذا الشّخص بالتّحديد

217
00:19:03,310 --> 00:19:07,180
...أيّها الدّون كريغ... إن سمحت
...هل من الممكن

218
00:19:08,980 --> 00:19:12,080
...هل من الممكن ترك هذه السّفينة
...ترك هذا المطعم وشأنه

219
00:19:13,280 --> 00:19:14,920
!أيّها الوغد

220
00:19:15,250 --> 00:19:17,420
،ألم تكن معارضة أوامري كافية

221
00:19:17,420 --> 00:19:20,660
!بل وتُسمعني محاضرة أيضًا؟
!ما معنى هذا الجنون؟

222
00:19:23,890 --> 00:19:26,290
...هذا مخيّب للآمال

223
00:19:26,630 --> 00:19:31,900
...الأخلاق... التّعاطف
.أكره هذه الأمور أكثر من غيرها

224
00:19:32,770 --> 00:19:34,800
!ألم أقل هذا دائمًا؟

225
00:19:37,340 --> 00:19:39,670
...ابتعدوا يا رجال

226
00:19:41,910 --> 00:19:43,140
...أيّها الدّون! هذا

227
00:19:45,980 --> 00:19:48,780
غاز... "إم إتش 5"؟

228
00:19:48,780 --> 00:19:51,080
!إنّه أقوى سلاح غاز سامّ

229
00:19:51,080 --> 00:19:51,850
!ماذا؟

230
00:19:51,850 --> 00:19:52,820
!غاز سامّ؟

231
00:19:53,290 --> 00:19:54,750
!هيّا! الأقنعة

232
00:19:54,750 --> 00:19:55,620
!ضعوا الأقنعة

233
00:19:55,620 --> 00:19:56,260
!بسرعة

234
00:19:56,260 --> 00:19:57,260
!سنُقتل أيضًا

235
00:19:57,260 --> 00:19:58,560
...لا أصدّق أنّه استعمله

236
00:19:58,560 --> 00:20:00,160
!هذه حقارة أيّها الوغد

237
00:20:00,160 --> 00:20:02,300
!أتدري ما سيحدث عند استعماله؟

238
00:20:02,860 --> 00:20:09,240
كفاكم نواحًا حيال أمور تافهة
!أيّها الأغبياء! هذه معركة

239
00:20:09,740 --> 00:20:12,240
.الفوز هو الهدف الوحيد

240
00:20:13,340 --> 00:20:17,240
أعمال شائنة؟ قذرة؟
!ما العيب في ذلك؟

241
00:20:18,010 --> 00:20:19,350
.الصّواب مع القوّة

242
00:20:19,710 --> 00:20:22,650
.النّتيجة هي كلّ شيء مهما كانت الوسيلة

243
00:20:23,320 --> 00:20:27,320
...سواء كان غازًا سامًّا أو شيئًا آخر
.الفوز هو كلّ ما يهمّ

244
00:20:29,090 --> 00:20:30,860
.هذه هي القوّة

245
00:20:34,030 --> 00:20:35,560
...يا له من وغد فظيع

246
00:20:41,700 --> 00:20:44,300
!ارمِ ذلك قناع الغاز

247
00:20:46,340 --> 00:20:49,410
.ما عدتَ واحدًا منّا

248
00:20:51,080 --> 00:20:51,980
!مُت

249
00:20:59,220 --> 00:21:02,390
!لن أسمح لك بإطلاق ذلك الغاز السّامّ

250
00:21:02,650 --> 00:21:05,360
!كفاك ركضًا أيّها الفتى المرساة

251
00:21:18,440 --> 00:21:19,600
!سُـ-سُحقًا

252
00:21:20,970 --> 00:21:25,580
غين! لستَ مضطرًّا للاستماع
!لكلام ذلك الضّعيف

253
00:21:26,580 --> 00:21:28,610
!سأوسعه ضربًا الآن

254
00:21:30,010 --> 00:21:32,520
!لا تستخفّ بالدّون كريغ

255
00:21:33,580 --> 00:21:37,750
.إنّه الرّجل الأقوى. لا يمكنك هزيمته

256
00:21:38,120 --> 00:21:43,330
!عد إلى رشدك أيّها الغبيّ
!يحاول ذلك الرّجل قتلك

257
00:21:43,330 --> 00:21:44,760
...أستحقّ ذلك

258
00:21:45,290 --> 00:21:51,500
،بما أنّني لم أحقّق هدفي
...وخنعتُ لعواطفي

259
00:21:52,030 --> 00:21:55,740
!هذا... هذا عقاب أستحقّه بالكامل

260
00:21:57,410 --> 00:21:58,370
!غين

261
00:21:58,370 --> 00:22:00,840
لماذا... لماذا؟

262
00:22:02,040 --> 00:22:06,620
...أظهرتَ فخرك في النّهاية
.لكن فات الأوان

263
00:22:06,620 --> 00:22:09,050
!مُت وذلك الطّبّاخ

264
00:22:10,350 --> 00:22:15,520
!"قنبلة الغاز السّامّ المميتة... "إم إتش 5

265
00:22:22,960 --> 00:22:24,430
!غوصوا في البحر

266
00:22:24,430 --> 00:22:25,870
!أيّها المالك! لندخل المطعم

267
00:22:29,670 --> 00:22:30,640
.دعاني أستعير هاذين

268
00:22:31,340 --> 00:22:33,640
!سانجي! غين! استعملاهما

269
00:22:33,640 --> 00:22:34,710
!أيّها العامل

270
00:22:35,010 --> 00:22:36,110
!والآن دوري

271
00:22:36,510 --> 00:22:39,550
!ماذا؟ غاص الجميع في البحر

272
00:22:43,550 --> 00:22:47,320
...كلاّ... كلاّ... كلاّ

273
00:22:56,000 --> 00:23:10,240
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

274
00:23:10,240 --> 00:23:17,180
ولطالما بحثت عن ذلك المكان الإعجازيّ

275
00:23:17,180 --> 00:23:24,360
لكي لا يسبقني أحد آخر إليه

276
00:23:26,890 --> 00:23:38,370
إن كان العالم سيتغيّر

277
00:23:38,370 --> 00:23:45,380
قبل أن أحقّق حلمي

278
00:23:45,380 --> 00:23:52,450
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

279
00:23:52,450 --> 00:24:05,830
لكي لا تمحى ذكرياتي

280
00:24:11,270 --> 00:24:13,400
!سأريك مقبرة من سيصبح هذا المكان

281
00:24:13,400 --> 00:24:16,110
لا يمكنك إيقاف طموحي
!بأسلحة سخيفة

282
00:24:16,110 --> 00:24:17,610
!كيف لا تشعر بالإحباط؟

283
00:24:17,610 --> 00:24:20,280
لا تدري؟ هل أنت غبيّ أم ماذا؟

284
00:24:20,280 --> 00:24:22,110
!ماذا قلت؟ كرّر ما قلتَه

285
00:24:22,110 --> 00:24:23,280
هل أنت غبيّ أم ماذا؟

286
00:24:23,280 --> 00:24:24,620
!لا تكرّر ذلك

287
00:24:24,620 --> 00:24:27,450
.أنت من أخبرني أن أقولها ثانية
...يا لك من أنانيّ

288
00:24:27,820 --> 00:24:28,850
:في الحلقة القادمة من ون بيس

289
00:24:29,220 --> 00:24:32,460
!لن أموت"
"!معركة حامية بين لوفي وكريغ

290
00:24:32,690 --> 00:24:34,860
!ملك القراصنة، لن يكون إلاّ أنا