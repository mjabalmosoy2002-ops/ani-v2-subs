1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:00,650 --> 00:02:05,490
!هذا ميناء اللّقاء
!لماذا لم يحضر أيّ أحد؟

29
00:02:05,780 --> 00:02:06,860
!أتوسّل إليكم

30
00:02:06,860 --> 00:02:10,080
!ليساعدنا أحد ما

31
00:02:18,840 --> 00:02:23,510
.ثمّة حادثة قد وقعت سلفًا في اللّيلة الماضية

32
00:02:29,390 --> 00:02:34,230
!السّاموراي الأوّل في بلاد وانو"
"!ها هو ذا كوزكي أودن

33
00:02:41,440 --> 00:02:43,480
...الأكازايا

34
00:02:44,440 --> 00:02:45,610
...و

35
00:02:45,950 --> 00:02:47,360
!أودن

36
00:02:53,370 --> 00:02:56,960
!سأذيقكم الويلات

37
00:02:58,960 --> 00:03:00,670
هل عثرتم على السّفينة؟

38
00:03:00,670 --> 00:03:01,380
.نعم

39
00:03:01,840 --> 00:03:04,340
.وجدناها

40
00:03:04,340 --> 00:03:06,420
لكن هل أنت واثق من هذا؟

41
00:03:06,420 --> 00:03:10,390
!افعلوا ما أقوله فحسب

42
00:03:12,470 --> 00:03:13,600
!هيّا

43
00:03:13,930 --> 00:03:15,180
!عُلم

44
00:03:33,240 --> 00:03:34,580
!تمّت المهمّة

45
00:03:39,080 --> 00:03:43,000
!لن أدعهم ينجحون في مسعاهم

46
00:03:43,290 --> 00:03:45,630
!والتّالي، الجسور

47
00:03:47,340 --> 00:03:50,590
!دُمّر الجسر الكبير بين كيبي وأودون

48
00:03:50,590 --> 00:03:52,470
!دمّروها

49
00:03:54,310 --> 00:03:57,520
!دُمّر الجسر الكبير بين كوري وأودون

50
00:03:57,520 --> 00:03:59,600
!يستحقّون ذلك

51
00:04:01,270 --> 00:04:03,940
...انظروا! الجسر الكبير بين المناطق قد

52
00:04:03,940 --> 00:04:05,800
!لماذا فجأة هكذا؟

53
00:04:05,800 --> 00:04:09,030
!لا نستطيع العبور للجانب الآخر الآن

54
00:04:09,030 --> 00:04:11,570
!كلّ ما بقي هو الميناء

55
00:04:13,740 --> 00:04:16,500
!أوروتشي-ساما! دُمّرت كلّ السّفن

56
00:04:16,500 --> 00:04:21,080
.لا بأس. سنعيد بناءها بمجرّد انتهاء هذا

57
00:04:21,670 --> 00:04:28,930
ما زلت لم أرَ أعضاء الأكازايا أو جنود
.السّاموراي الّذين جنّدوهم بأمّ عينيّ بعد

58
00:04:28,930 --> 00:04:34,300
!أشخاص أتوا من 20 سنة من الماضي؟

59
00:04:34,720 --> 00:04:37,870
!كيف يمكن لأيّ أحد تصديق ذلك؟

60
00:04:37,870 --> 00:04:41,810
.إلاّ إن رأوا إحدى رؤوسهم

61
00:04:41,810 --> 00:04:46,860
.لا، ما زال الأمر صعب التّصديق حتّى إن رأوها

62
00:04:46,860 --> 00:04:53,360
وذلك المغفّل اللّعين ياسويي
!جعل الأمر يبدو أكثر سخافة

63
00:04:53,660 --> 00:04:56,870
.لكنّ هذه المعلومة موثوقة

64
00:04:56,870 --> 00:05:00,750
!أعضاء الأكازايا أحياء يرزقون

65
00:05:02,710 --> 00:05:06,980
لا أهتمّ إن كان رجالي يظنّونني
.أتفوّه بالهراء فحسب

66
00:05:06,980 --> 00:05:11,050
!لديّ السّلطة لأقوم بما يجب

67
00:05:11,050 --> 00:05:16,930
.أغلقت كلّ الطرقات إلى ميناء توكاغي

68
00:05:17,310 --> 00:05:21,100
أربعة آلاف جنديّ؟
.أحسنتم عملاً بتجنيد كلّ هؤلاء

69
00:05:21,100 --> 00:05:25,020
!لكن لن يصل أيّ أحد للميناء

70
00:05:25,860 --> 00:05:29,820
!لن أمنحهم الفرصة للثّأر

71
00:05:31,650 --> 00:05:34,820
!اللّعنة عليكم يا أشباح الأكازايا

72
00:05:34,820 --> 00:05:40,580
!اغرقوا في يأس العزلة وقلّة الحيلة

73
00:05:49,460 --> 00:05:51,280
!توقّفوا جميعًا

74
00:05:51,280 --> 00:05:54,630
!ركوب ذلك القارب الصّغير انتحار بحدّ ذاته

75
00:06:00,720 --> 00:06:04,730
لنعد جمع صفوفنا ونبدأ من جديد
!عندما تسنح لنا فرصة أخرى

76
00:06:06,400 --> 00:06:08,900
...إن فوّتنا هذه الفرصة

77
00:06:09,650 --> 00:06:12,320
.سيكون علينا الانتظار لسنة كاملة

78
00:06:13,650 --> 00:06:20,200
.لكن ما عاد بمقدورنا الاختباء
.سيكتشفون أنّنا استولينا على أودون قريبًا

79
00:06:20,950 --> 00:06:26,170
.سيأتي جيش كايدو بالكامل لمطاردة المتمرّدين

80
00:06:28,210 --> 00:06:31,980
.ما عاد بإمكاننا مواصلة سرقة طعامهم أيضًا

81
00:06:31,980 --> 00:06:36,180
سمعتم ما حدث في كوري
.قبل مغادرتنا بكلّ تأكيد

82
00:06:37,260 --> 00:06:42,200
إنّ سكّان بلدة أوكوبوري الّذين
...آمنوا بمعركتنا الكبيرة

83
00:06:42,200 --> 00:06:44,060
.حُرقوا أحياءً

84
00:06:44,730 --> 00:06:46,440
...ومن بينهم

85
00:06:47,060 --> 00:06:48,860
.كانت زوجتي

86
00:06:51,860 --> 00:06:53,820
!اسمح لنا بالذّهاب أرجوك

87
00:06:56,740 --> 00:06:57,950
.لا

88
00:06:57,950 --> 00:07:03,450
!أتريدنا أن نهرب ونعيش بالعار؟

89
00:07:04,450 --> 00:07:07,040
ماذا عنّي؟

90
00:07:07,040 --> 00:07:11,170
!نريدك أن تعيش مع هيوري-ساما

91
00:07:11,170 --> 00:07:13,420
!لا تكن أنانيًّا هكذا

92
00:07:14,920 --> 00:07:18,590
!حتّى والدك لم ينعم بدعم في البداية

93
00:07:18,590 --> 00:07:22,310
...لو لم نقابل أودن-ساما

94
00:07:22,310 --> 00:07:27,520
.ما كنّا لنصبح ساموراي بما أنّنا كنّا جميعًا غير ناضجين

95
00:07:27,520 --> 00:07:30,650
...لهذا السّبب نريد أن نظلّ

96
00:07:31,110 --> 00:07:36,280
.أتباعًا لأودن-ساما حتّى النّهاية

97
00:07:37,700 --> 00:07:39,110
!لا تذهبوا

98
00:07:39,110 --> 00:07:41,280
!لا تذهب يا كينييمون

99
00:07:41,280 --> 00:07:46,950
!لا تذهبوا! لا أريد فقدان ولو شخص واحد آخر

100
00:07:49,540 --> 00:07:51,790
!اسمعوا يا رجال

101
00:07:52,130 --> 00:07:59,300
هذا الانعزال الوطنيّ الّذي دام
...لقرون مرتبط تمامًا بكوزكي

102
00:07:59,800 --> 00:08:01,260
!...وأيضًا

103
00:08:01,760 --> 00:08:04,180
!سيحين الوقت في النّهاية

104
00:08:04,640 --> 00:08:08,120
،وقبل أن يبدأ العالم بالتّغيّر

105
00:08:08,120 --> 00:08:11,270
!افتحوا بلاد وانو

106
00:08:33,920 --> 00:08:39,300
...قبل 41 سنة، في عاصمة الزّهور

107
00:08:40,430 --> 00:08:43,590
!عاد كوزكي أودن

108
00:08:43,590 --> 00:08:45,140
!أخفوا زوجاتكم

109
00:08:45,140 --> 00:08:47,020
!أخفوا بناتكم

110
00:08:52,270 --> 00:08:54,400
!أخفوا ماشيتكم

111
00:08:57,570 --> 00:09:00,400
!فشل في خوض غمار البحر ثانية

112
00:09:00,400 --> 00:09:02,660
!يريد المغادرة بشدّة هكذا؟

113
00:09:03,740 --> 00:09:08,950
.حظي رجل بشعبيّة كبيرة في العاصمة

114
00:09:30,270 --> 00:09:33,390
!ثمّة قيود في كلّ مكان

115
00:09:50,040 --> 00:09:53,620
!قيود كثيرة قد تخنقني حتّى الممات

116
00:09:54,250 --> 00:09:56,000
...أنا

117
00:09:59,300 --> 00:10:02,760
!ها قد أتيت! ها قد أتيت

118
00:10:04,930 --> 00:10:07,100
...أنا

119
00:10:13,600 --> 00:10:15,520
...أنا

120
00:10:15,810 --> 00:10:18,650
!أريد رؤية العالم الواسع

121
00:10:19,480 --> 00:10:22,610
!كما أرغب

122
00:10:25,570 --> 00:10:28,660
!يا ويحي... أريد تناول الأودن

123
00:10:46,010 --> 00:10:50,010
.مساحات شاسعة من الغابات الخضراء

124
00:10:51,060 --> 00:10:56,850
وعبر سهول الزّهور والنّباتات والأشجار
.الكثيفة، يشقّ نهر عذب طريقه

125
00:10:57,730 --> 00:11:00,980
.وبحر جميل

126
00:11:01,980 --> 00:11:08,780
هذه قصّة وقعت أحداثها في بلاد وانو
.عندما كانت لا تزال تنضح بالحياة

127
00:11:09,910 --> 00:11:12,830
!هربتَ من جبل يتحرّك؟

128
00:11:12,830 --> 00:11:14,000
!هذا صحيح

129
00:11:14,000 --> 00:11:16,370
.كان يئنّ

130
00:11:16,710 --> 00:11:21,460
!ربّما ثار غضب إله الجبل

131
00:11:22,960 --> 00:11:28,050
!أمزح فحسب! تبدون جميعًا سعداء على أيّ حال

132
00:11:28,050 --> 00:11:29,390
ماذا حدث؟

133
00:11:29,390 --> 00:11:32,890
!أمسكناه أخيرًا

134
00:11:43,690 --> 00:11:45,690
!يا له من خنزير برّيّ رائع

135
00:11:45,990 --> 00:11:49,700
سنحصل مقابله على عملة
!ذهب أبيض في العاصمة

136
00:11:49,700 --> 00:11:50,700
!ماذا؟

137
00:11:51,370 --> 00:11:53,830
!هذا كافٍ لبناء منزل محترم

138
00:11:53,830 --> 00:12:00,040
نعم! يبحث زعيم كوروكوما عن خنزير برّيّ
،أبيض أسطوريّ لعرضه في واجهة محلّه

139
00:12:00,040 --> 00:12:02,840
.لذلك وضع مكافأة لمن يحضر له واحدًا

140
00:12:02,840 --> 00:12:05,000
!لا ينبغي له عرضه

141
00:12:05,000 --> 00:12:08,970
.الخنازير البرّيّة البيضاء رُسل مقدّسة

142
00:12:14,760 --> 00:12:16,270
!كينييمون

143
00:12:16,270 --> 00:12:18,060
!...هذا مؤلم، مؤلم، مؤلم

144
00:12:18,060 --> 00:12:20,820
!سرقتَ مالاً من متجرنا ثانية

145
00:12:20,820 --> 00:12:24,650
!آنسة تسورو! نحن نعرف بعضنا منذ الطّفولة

146
00:12:24,650 --> 00:12:27,700
!أنا أشبه بأخ أكبر لك وأحتاج للمال

147
00:12:27,700 --> 00:12:32,950
!هذا لأنّك تقامر! أتدري بكم تدين لي؟

148
00:12:36,870 --> 00:12:40,420
،في المرّة القادمة الّتي تلمس فيها مالي

149
00:12:40,710 --> 00:12:44,290
!سأبيع أعضاءك الدّاخليّة

150
00:12:45,550 --> 00:12:49,630
!دع كلّ ملابسك إن كنت لا تستطيع إعادة مالي

151
00:12:51,590 --> 00:12:53,300
!تسورو اللّعينة

152
00:12:53,890 --> 00:12:56,720
!جرّدتني من ملابسي بالكامل

153
00:12:58,270 --> 00:13:02,400
.لكن تسنّت لي فرصة سماع فكرة مذرّة للمال

154
00:13:15,660 --> 00:13:18,580
!جدّي كاتسزو

155
00:13:19,750 --> 00:13:21,960
...لا تبكي. أعني

156
00:13:21,960 --> 00:13:25,260
...إنّها جنازة، لذا لا بأس من البكاء

157
00:13:25,260 --> 00:13:26,540
ما الخطب؟

158
00:13:26,840 --> 00:13:32,280
كنّا نوشك على جمع العظام
.بعد انتهاء مراسم الحرق

159
00:13:32,280 --> 00:13:33,890
!...لكنّ ذلك الرّجل

160
00:13:34,550 --> 00:13:40,100
وجدناه يطبخ الأودن على نيران
!جثّة والدنا الّتي تحترق

161
00:13:45,060 --> 00:13:48,730
.يبدو أنّ أودن-ساما غير قادر على الإبحار

162
00:13:49,150 --> 00:13:54,530
كانت تلك محاولته الثّامنة والثّلاثين
.لمغادرة البلاد بشكل غير شرعيّ

163
00:13:54,530 --> 00:13:57,080
كيف استطاع العودة حيًّا؟

164
00:13:57,080 --> 00:14:02,620
أتوقّع أنّك تعرف على الأرجح، لكن
.اسمح لي بإخبارك باختصار عن حياته

165
00:14:03,500 --> 00:14:05,670
،قبل حتّى أن يبلغ عامه الأوّل

166
00:14:05,960 --> 00:14:07,690
.رمى مربّيته في الهواء

167
00:14:07,690 --> 00:14:10,960
كما أمسك بأرنبين دفعة واحدة
.عندما كان في الثّانية

168
00:14:11,550 --> 00:14:15,430
!وعند بلوغه الرّابعة، رمى جلمودًا وأطاح بدبّ

169
00:14:15,430 --> 00:14:20,100
وفي عامه السّادس، قضى كلّ وقته
.في قاعة المتعة ينفق أموال القلعة بإسراف

170
00:14:20,100 --> 00:14:23,620
،وذهب في عامه الثّامن لمحلّ قمار وحده

171
00:14:23,620 --> 00:14:28,290
.وبدأ شجارًا مع بعض المقامرين العنيفين

172
00:14:28,290 --> 00:14:33,380
وفي عامه التّاسع، حذرته الياكوزا وكان ردّه

173
00:14:33,380 --> 00:14:37,120
،أن أضرم النّار في محلّ قمارهم
.ومعها حرب بين العصابات

174
00:14:37,120 --> 00:14:39,450
.ثمّ تمّ أسره بتهمة الاعتداء

175
00:14:39,780 --> 00:14:41,830
.وكان في العاشرة حينها

176
00:14:41,830 --> 00:14:47,630
.وبينما كان يقضي مدّته في المقالع، أظهر قدراته

177
00:14:47,630 --> 00:14:51,050
!حتّى أنّه أصبح خبير نحت حجارة

178
00:14:51,050 --> 00:14:53,800
!لا بدّ أنّ ذلك في دماء كوزكي

179
00:14:55,340 --> 00:14:59,180
!ثمّ عاد للشّارع كشخص أفضل

180
00:14:59,510 --> 00:15:01,640
!وعندما بلغ أودن-ساما عامه الرّابع عشر

181
00:15:01,930 --> 00:15:04,200
.عانت العاصمة من الجفاف

182
00:15:04,200 --> 00:15:07,150
.جفّت الآبار ولم يُطق رؤية معاناة النّاس

183
00:15:07,150 --> 00:15:11,270
.لذلك غيّر مجرى النّهر وجعله يمرّ قرب العاصمة

184
00:15:13,110 --> 00:15:15,450
.لكنّ ذلك تسبّب في فيضان كبير

185
00:15:15,860 --> 00:15:18,410
.وأُصدرت مذكّرة اعتقال ثانية في حقّه

186
00:15:19,660 --> 00:15:26,080
.كما حاول الهروب من البلاد عبر القناة

187
00:15:27,710 --> 00:15:30,170
!لكن فشل فشلاً ذريعًا

188
00:15:30,840 --> 00:15:35,300
وعندما بلغ الخامسة عشر، صارع معلّم
.معبد جبليّ وبقي متخفّيًا هناك

189
00:15:35,670 --> 00:15:42,100
اصطحب معه نساءً من العاصمة
.كلّ ليلة وشكّل مجمع حريم

190
00:15:44,020 --> 00:15:46,930
...لا بدّ أنّه وحش من نوع ما

191
00:15:46,930 --> 00:15:52,320
عليّ أن أضيف أنّ كلّ تلك النّساء
.كنّ حرّات بالمغادرة متى أردن

192
00:15:52,770 --> 00:15:55,940
.لكن هنالك من ثارت ثائرته ووقف في وجهه

193
00:15:56,570 --> 00:16:00,950
!كانوا خلائل وآباء وأزواج تلك النّسوة

194
00:16:01,410 --> 00:16:04,160
!كما حظوا بدعم مجموعة ساموراي أقوياء

195
00:16:06,660 --> 00:16:11,210
!لكنّ أودن-ساما رحّب بتحدّيهم وقاتلهم

196
00:16:11,920 --> 00:16:15,130
!وذلك هو ما عرف بحرب الحريم

197
00:16:15,420 --> 00:16:19,900
حتّى عائلة هيوغورو الّتي حاولت
،إيقافهم تورّطت في الأمر

198
00:16:19,900 --> 00:16:22,270
!ونشب قتال ضخم

199
00:16:22,270 --> 00:16:23,470
!يكفي

200
00:16:26,310 --> 00:16:28,730
.إنّ أودن-ساما في الثّامنة عشر الآن

201
00:16:28,730 --> 00:16:33,610
لقد افتعل المشاكل بشكل دوريّ
.حتّى اليوم. هذا كلّ ما لديّ

202
00:16:33,980 --> 00:16:38,150
.لا أحتاج لتعليقاتك، أوصل هذه لأودن فحسب

203
00:16:39,240 --> 00:16:42,370
!سأقطع علاقتي به

204
00:17:20,110 --> 00:17:21,860
.كاتسزو

205
00:17:25,830 --> 00:17:29,040
،في المرّة القادمة الّتي نشرب فيها
.ستكون في الحياة الآخرة

206
00:17:35,340 --> 00:17:37,000
.إلى اللّقاء

207
00:17:42,220 --> 00:17:47,600
.والآن، أستأذن منكم يا سيّدات وسادة عائلة الفقيد

208
00:17:59,730 --> 00:18:02,300
...ما كان ذلك؟ إنّه رائع

209
00:18:02,300 --> 00:18:03,910
أهذا كلّ شيء؟

210
00:18:04,200 --> 00:18:07,830
لا بدّ أنّ هذا هو خطاب أودن
!الّذي يتكلّم الجميع عنه

211
00:18:15,380 --> 00:18:20,630
.يا لي من محظوظ
.هذا أشبه بربح اليانصيب

212
00:18:21,010 --> 00:18:23,800
،إن أعطيتُ هذا لزعيم كوروكوما

213
00:18:23,800 --> 00:18:26,010
...فسأصبح

214
00:18:27,600 --> 00:18:30,970
!هيّأ! أعطني كلّ ملابسك

215
00:18:36,400 --> 00:18:38,190
!لن أسمح لك بالفرار اليوم

216
00:18:38,190 --> 00:18:40,940
!مهلاً، مهلاً، مهلاً! انتظروا

217
00:18:40,940 --> 00:18:43,740
!أوشك على الحصول على مال وفير

218
00:18:43,740 --> 00:18:45,160
!لا تكذب

219
00:18:45,160 --> 00:18:49,030
!إنّها الحقيقة! دعوني أذهب لقصر عائلة كوروكوما

220
00:18:49,870 --> 00:18:51,810
كينييمون؟

221
00:18:51,810 --> 00:18:55,540
!نعم، ذلك الفتى الّذي سرق مالنا

222
00:18:55,830 --> 00:18:59,860
!أمسكوا به واسلخوه حيًّا

223
00:18:59,860 --> 00:19:02,340
.لكن لا تواجهوه رجلاً لرجل

224
00:19:02,340 --> 00:19:06,380
!إنّه أقوى منكم

225
00:19:08,640 --> 00:19:11,080
!عُهد لي بستّين عملة فضّيّة

226
00:19:11,080 --> 00:19:14,350
!إن استعملتها، فستختفي

227
00:19:15,940 --> 00:19:18,020
هل يمكنني أخذ القِدر الأصغر؟

228
00:19:18,020 --> 00:19:20,320
.أنا أتسوّق لشخص ما

229
00:19:20,320 --> 00:19:22,530
!حسنًا. إنّه مقابل 30 عملة فضّيّة

230
00:19:22,530 --> 00:19:23,440
.تفضّل

231
00:19:23,440 --> 00:19:24,780
!شكرًا لك

232
00:19:25,570 --> 00:19:27,990
.لحظة، اشتريت القِدر الخطأ

233
00:19:27,990 --> 00:19:30,580
.كنتُ بحاجة للقِدر الأكبر

234
00:19:31,410 --> 00:19:33,950
.ثمن الأكبر هو 60 عملة فضّيّة

235
00:19:33,950 --> 00:19:36,770
،سبق ودفعت لك 30 عملة فضّيّة

236
00:19:36,770 --> 00:19:39,420
.لذلك ستصير 60 عملة بمنّي لك هذا القِدر

237
00:19:39,420 --> 00:19:40,500
!حسنًا

238
00:19:40,500 --> 00:19:42,420
!شكرًا لك

239
00:19:43,500 --> 00:19:47,050
!خدع ذلك الشّقيّ الرّجل ووفّر 30 عملة لنفسه

240
00:19:48,890 --> 00:19:50,680
!مكسب سهل

241
00:19:50,680 --> 00:19:52,060
.يا دنجيرو

242
00:19:52,060 --> 00:19:54,180
!كين-سان

243
00:19:55,350 --> 00:19:56,500
!انظر

244
00:19:56,500 --> 00:19:59,230
!حصلت على شيء نفيس

245
00:20:01,900 --> 00:20:05,280
أتيت لتعتقلني؟

246
00:20:05,280 --> 00:20:06,110
...نعم

247
00:20:06,490 --> 00:20:11,700
،لكنّني ليس وكأنّني أريد اعتقالك
...لذلك بإمكانك أن ترشوني

248
00:20:14,160 --> 00:20:18,590
لماذا يتجنّبني الجميع؟

249
00:20:18,590 --> 00:20:21,250
.يبدو أنّ كلّ ما يهتمّون له هو حريق

250
00:20:21,250 --> 00:20:23,420
!لا تعرف يا كين-سان؟

251
00:20:23,420 --> 00:20:25,840
!لا ينبغي أن تحضره

252
00:20:25,840 --> 00:20:28,760
ماذا؟ تقصد هذا الخنزير البرّيّ الأبيض؟

253
00:20:28,760 --> 00:20:34,890
يحاول زعيم كوروكوما تدمير
!عائلة هيوغورو باستعماله كطُعم

254
00:20:34,890 --> 00:20:36,060
!ماذا تعني؟

255
00:20:36,060 --> 00:20:38,730
ما أعنيه هو أنّ ذلك الخنزير البرّيّ الصّغير

256
00:20:38,730 --> 00:20:41,850
!سيجذب والده إلى هنا في أيّ لحظة

257
00:20:55,120 --> 00:20:57,200
!حسنًا

258
00:21:03,670 --> 00:21:05,210
!والد الخنزير؟

259
00:21:05,210 --> 00:21:09,300
حسب وثيقة قديمة، إنّه نوع
!خنازير برّيّة بيضاء ضخمة كالجبال

260
00:21:09,670 --> 00:21:12,300
!لهذا السّبب يسمّونه إله الجبل

261
00:21:12,300 --> 00:21:13,510
!ماذا؟

262
00:21:13,510 --> 00:21:18,390
،ذكرت إحدى القصص قبل قرون عدّة
.أنّه دمّر منطقة بأكملها في ليلة واحدة

263
00:21:18,770 --> 00:21:22,230
،ظننتُ أنّها مجرّد خرافة

264
00:21:22,690 --> 00:21:23,940
...ولكن

265
00:21:24,650 --> 00:21:29,490
...بما أنّ الخنزير البرّيّ الأبيض موجود

266
00:21:29,740 --> 00:21:32,950
!فإنّ إله الجبل موجود أيضًا

267
00:21:32,950 --> 00:21:37,450
!سيبتلعنا ويقتلنا! وصل بالفعل! اهربوا

268
00:21:46,000 --> 00:21:50,420
!...كلاّ! إنّ خطئي سيجعل العاصمة

269
00:22:24,540 --> 00:22:25,380
...كو

270
00:22:28,250 --> 00:22:29,960
...كو

271
00:22:32,880 --> 00:22:34,510
!كوزكي أودن

272
00:22:36,720 --> 00:22:40,140
.كانت تلك محادثة مثيرة للاهتمام

273
00:22:41,140 --> 00:22:43,890
...لا أعرف من تكونان

274
00:22:45,230 --> 00:22:49,730
!لكن سلّماني ذلك الخنزير البرّيّ الأبيض

275
00:23:03,710 --> 00:23:07,710
!حازت قوّة أودن الجريئة على إعجاب كينييمون

276
00:23:07,710 --> 00:23:13,690
يتعهّد كينييمون بالولاء لأودن ويقابلون
!حلفاء متناقضين عبر البلاد

277
00:23:13,690 --> 00:23:18,140
سيصبح أودون والأكازايا التّسعة
!أساطير في بلاد وانو بعد ذلك

278
00:23:18,140 --> 00:23:22,520
!هكذا بدأت رحلتهم الشّريدة والمليئة بالحيويّة

279
00:23:22,520 --> 00:23:27,000
:في الحلقة القادمة من وان بيس
"!قسم ولاء بالدّموع! أودن وكينييمون"

280
00:23:27,000 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا