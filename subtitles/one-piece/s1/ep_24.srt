1
00:00:02,490 --> 00:00:04,330
...الثّروة والشّهرة والسّلطة

2
00:00:04,630 --> 00:00:06,500
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,500 --> 00:00:08,400
.ملك القراصنة، غولد روجر

4
00:00:08,800 --> 00:00:12,570
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,570 --> 00:00:16,170
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,440 --> 00:00:20,040
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,650 --> 00:00:26,720
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,350 --> 00:00:30,290
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,190 --> 00:00:35,790
سنجمع كل أحلامنا

10
00:00:36,790 --> 00:00:42,230
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,630 --> 00:00:48,270
!ون بيس

12
00:00:48,770 --> 00:00:53,610
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,440 --> 00:00:59,050
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,150 --> 00:01:05,120
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,450 --> 00:01:10,990
!فإنّها ليست أسطورة إذًا

16
00:01:12,190 --> 00:01:17,870
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:17,930 --> 00:01:22,770
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,070 --> 00:01:25,670
!وتظاهر أنّها غير موجودة

19
00:01:26,640 --> 00:01:31,510
سنجمع كلّ أحلامنا

20
00:01:32,510 --> 00:01:37,690
ونبحر باحثين عن شيء

21
00:01:38,020 --> 00:01:40,920
،عملة في جيبي

22
00:01:41,020 --> 00:01:44,190
وتريد أن تصبح صديقي؟

23
00:01:44,290 --> 00:01:48,800
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,660 --> 00:01:50,830
!إننا كذلك

25
00:02:08,780 --> 00:02:13,220
!عين الصّقر ميهوك"
".السّيّاف الّذي دفع زورو للإبحار

26
00:02:19,590 --> 00:02:20,160
...ما

27
00:02:20,160 --> 00:02:21,390
!ما الّذي قلته؟

28
00:02:21,390 --> 00:02:24,160
!هربت نامي وأخذت غوينغ ميري؟

29
00:02:24,160 --> 00:02:26,670
!ما الّذي تقصدانه بذلك؟

30
00:02:27,700 --> 00:02:30,100
!حدث ذلك قبل قليل فقط

31
00:02:35,040 --> 00:02:37,140
ما الخطب يا أختي الكبيرة نامي؟

32
00:02:38,410 --> 00:02:40,880
.كنتِ تنظرين لملصقات المطلوبين

33
00:02:40,880 --> 00:02:42,880
...لا... لا شيء

34
00:02:42,880 --> 00:02:45,020
.أنت مذهلة كالعادة

35
00:02:45,550 --> 00:02:48,150
وضعتِ عينيك على قرصان
.ذو مكافأة ضخمة

36
00:02:48,650 --> 00:02:52,160
لكنّ أرلونغ هو القرصان الوحيد
.الّذي لا يجب أن تسعي خلفه

37
00:02:52,160 --> 00:02:54,130
...سمعتُ أنّه قويّ بشكل مرعب

38
00:02:54,530 --> 00:02:58,360
.لقد بقي هادئًا وبعيدًا عن الأنظار لفترة

39
00:02:58,360 --> 00:03:01,200
.لكنّه بدأ يتصرّف بجموح ثانية

40
00:03:01,730 --> 00:03:05,240
حسنًا، لكن من الصّعب التّخلّي
...عن مكافأة العشرين مليون

41
00:03:05,240 --> 00:03:08,470
إنّه قويّ جدًّا لدرجة أنّ هنالك إمكانيّة

42
00:03:08,470 --> 00:03:11,240
.صغيرة أنّه حتّى نحن قد نُقتل

43
00:03:13,080 --> 00:03:14,050
يا أختي الكبيرة نامي؟

44
00:03:15,750 --> 00:03:19,850
أنا آسفة، لكن هلاّ استدرتما؟
...عليّ تغيير ملابسي

45
00:03:19,850 --> 00:03:22,690
...ماذا؟! مـ-مهلًا

46
00:03:22,690 --> 00:03:23,820
!تغيير ملابسك؟ الآن؟

47
00:03:24,590 --> 00:03:26,020
أيمكنني؟

48
00:03:26,690 --> 00:03:28,360
!تفضّلي، تفضّلي

49
00:03:33,330 --> 00:03:36,330
!إنّها جريئة كما يبدو عليها

50
00:03:36,330 --> 00:03:39,240
لا ضرر إن اختلسنا النّظر قليلًا، صحيح؟

51
00:03:39,240 --> 00:03:40,040
...إنّك

52
00:03:52,680 --> 00:03:54,250
!ما-ما الّذي تفعلينه؟

53
00:03:55,490 --> 00:03:57,820
!ماذا أفعل؟ هذا مجرّد عمل

54
00:03:57,820 --> 00:04:01,360
أنا لصّة تستهدف القراصنة فحسب
.وسآخذ هذه السّفينة

55
00:04:02,330 --> 00:04:06,900
.لم أقل أبدًا أنّني أصبحتُ عضوة
.تعاونت معهم لفترة فحسب

56
00:04:07,460 --> 00:04:11,670
قضيت القليل من الوقت فقط رفقة
.لوفي والبقيّة، لكنّني استمتعت كثيرًا

57
00:04:12,800 --> 00:04:14,170
...أخبارهم

58
00:04:15,100 --> 00:04:18,010
،أنّه إن كان القدر يربط بيننا
.فسنلتقي ثانية

59
00:04:19,540 --> 00:04:21,210
!يا أختي الكبيرة نامي

60
00:04:28,850 --> 00:04:30,920
!مـ-مهلًا! سنكون في ورطة

61
00:04:30,920 --> 00:04:35,520
!طُلب منّا أن ننتبه للسّفينة

62
00:04:55,210 --> 00:04:58,280
...وهكذا أخذت السّفينة

63
00:04:58,280 --> 00:04:59,010
!نحن آسفان

64
00:04:59,010 --> 00:05:03,280
سُحقًا! إنّها تجعل هذه الأزمة
!أسوأ بالنّسبة لنا

65
00:05:03,280 --> 00:05:05,590
!أعطت كايا تلك السّفينة لنا

66
00:05:05,590 --> 00:05:09,520
!مهلًا! ما زلت أستطيع رؤيتها
!إنّها غوينغ ميري

67
00:05:10,190 --> 00:05:11,560
أين سفينتكما؟

68
00:05:11,560 --> 00:05:13,030
...ما زالت هنا

69
00:05:13,790 --> 00:05:17,230
!زورو! أوسوبّ! غادرا في الحال
!خذا تلك السّفينة واتبعا نامي

70
00:05:17,230 --> 00:05:20,000
.انس أمرها. اترك تلك السّفينة لها فحسب

71
00:05:20,000 --> 00:05:22,670
.لا داعي لنلاحق تلك الفتاة

72
00:05:22,670 --> 00:05:25,640
.لن أقبل بأيّ أحد آخر سواها كملاّحة لنا

73
00:05:34,750 --> 00:05:38,180
...حسنًا... يا له من قائد صعب المراس

74
00:05:38,920 --> 00:05:40,150
!هيّا بنا يا أوسوبّ

75
00:05:40,150 --> 00:05:41,720
...ما...؟ حسنًا

76
00:05:45,220 --> 00:05:47,890
!أخي الكبير زورو، السّفينة جاهزة

77
00:05:48,430 --> 00:05:49,730
ماذا عنك يا لوفي؟

78
00:05:49,730 --> 00:05:53,870
لا أستطيع بما أنّني لم أسوِّ
.الأمور بعد في هذا المطعم

79
00:05:53,870 --> 00:05:57,670
.كن حذرًا. هذا الوضع ليس عاديًّا

80
00:05:57,670 --> 00:05:59,640
.نعم، أعلم

81
00:06:00,170 --> 00:06:03,580
ما-ماذا؟ ما الّذي حدث للتّوّ؟

82
00:06:03,580 --> 00:06:06,610
!انقسمت السّفينة لنصفين

83
00:06:07,080 --> 00:06:08,680
!انظروا هناك

84
00:06:09,380 --> 00:06:10,420
!إنّه هو

85
00:06:15,890 --> 00:06:18,790
!الدّون كريغ! إنّه ذلك الرّجل

86
00:06:18,790 --> 00:06:22,160
!إنّه الرّجل الّذي دمّر أسطولنا

87
00:06:25,260 --> 00:06:27,670
!ذ... ذلك الرّجل

88
00:06:36,610 --> 00:06:37,980
...ذاك الرّجل هو

89
00:06:39,880 --> 00:06:42,280
!ذلك الوغد

90
00:06:43,050 --> 00:06:47,050
!تبعنا إلى هنا... لقتلنا

91
00:06:47,720 --> 00:06:49,250
!انتهى أمرنا

92
00:06:50,050 --> 00:06:50,920
زورو؟

93
00:06:51,820 --> 00:06:52,860
من يكون؟

94
00:06:53,620 --> 00:06:56,030
.الرّجل الّذي أبحث عنه

95
00:06:56,730 --> 00:06:58,430
!ميهوك عين الصّقر

96
00:06:59,460 --> 00:07:01,600
...ميهوك عين الصّقر

97
00:07:08,070 --> 00:07:09,940
...أقوى رجل في العالم

98
00:07:11,940 --> 00:07:18,480
ذلك هو الرّجل الّذي أغرق سفن الدّون كريغ
الخمسين وحده في الغراند لاين؟

99
00:07:18,480 --> 00:07:22,250
إذًا، من دمّر سفينة الدّون كريغ
...للتّوّ هو أيضًا

100
00:07:22,250 --> 00:07:26,190
.لكنّه يبدو مثل أيّ إنسان عاديّ

101
00:07:26,190 --> 00:07:29,020
.لا يبدو أنّه يملك أيّ سلاح خاصّ

102
00:07:29,790 --> 00:07:31,960
...سلاحه على ظهره

103
00:07:31,960 --> 00:07:33,930
!ذلك مستحيل

104
00:07:33,930 --> 00:07:37,770
هل قطّع تلك السّفينة الشّراعيّة
الضّخمة بذلك السّيف بالفعل؟

105
00:07:38,330 --> 00:07:41,470
...إنّه عين الصّقر، من أبرع مستخدمي السّيف

106
00:07:41,470 --> 00:07:45,240
الرّجل الّذي يقف على قمّة
...مستعملي السّيف في العالم

107
00:07:50,780 --> 00:07:53,920
لم أتوقّع أن أتمكّن من لقائه
...بهذه السّرعة

108
00:07:54,720 --> 00:07:57,950
...وأخيرًا... حان وقت الوفاء بوعدي

109
00:07:59,090 --> 00:08:00,620
...أ-أيّها الوغد

110
00:08:01,360 --> 00:08:04,190
ما الضّغينة الّتي تحملها
!ضدّنا لتسعى خلفنا؟

111
00:08:05,660 --> 00:08:06,830
.أضيّع وقتي فحسب

112
00:08:06,830 --> 00:08:10,800
!ماذا؟! لا تعبث معنا

113
00:08:20,510 --> 00:08:21,610
!ما-ماذا؟

114
00:08:22,080 --> 00:08:23,840
!أنا واثق أنّني صوّبت نحوه مباشرة

115
00:08:23,840 --> 00:08:25,110
.حوَّل مسار الطّلقات

116
00:08:26,010 --> 00:08:27,950
قام بتغيير مسار الطّلقات برفق

117
00:08:27,950 --> 00:08:29,120
.باستعمال سنّ سيفه

118
00:08:29,550 --> 00:08:30,950
...ذلك مستحيل

119
00:08:32,320 --> 00:08:34,860
!مـ-مهلًا! من تكون؟

120
00:08:36,090 --> 00:08:38,660
...ثلاثة سيوف... أيعقل

121
00:08:39,230 --> 00:08:42,630
لم يسبق لي أن رأيتُ سيفًا
...يتحرّك بذلك الرّفق

122
00:08:43,330 --> 00:08:46,170
لا شدّة في مسايفة مبنيّة
.على القوّة فحسب

123
00:08:46,770 --> 00:08:49,670
هل استعملت ذلك السّيف
لتقطيع هذه السّفينة أيضًا؟

124
00:08:49,670 --> 00:08:51,140
.صحيح

125
00:08:51,140 --> 00:08:54,370
...فهمت... أنت الأقوى

126
00:08:56,710 --> 00:08:59,280
.خرجت للبحر للقائك

127
00:09:00,850 --> 00:09:02,180
ما هو هدفك؟

128
00:09:02,180 --> 00:09:03,620
!أن أصبح الأقوى

129
00:09:04,880 --> 00:09:06,250
...يا للحماقة

130
00:09:10,960 --> 00:09:13,660
لديك وقت لتضييعه، صحيح؟
!فلنتقاتل إذًا

131
00:09:13,660 --> 00:09:19,200
هـ-هذا هو زورو! مستخدم أسلوب
!السّيوف الثّلاثة، رورونوا زورو

132
00:09:19,200 --> 00:09:19,930
!ماذا؟

133
00:09:20,370 --> 00:09:22,530
إنّه صائد قراصنة إذًا؟

134
00:09:23,540 --> 00:09:24,900
!فعلًا؟

135
00:09:28,240 --> 00:09:30,340
!مهلًا، هذا سيّئ يا لوفي

136
00:09:30,340 --> 00:09:32,810
!ستغيب غوينغ ميري عن أنظارنا قريبًا

137
00:09:32,810 --> 00:09:34,180
!يا لوفي

138
00:09:34,680 --> 00:09:39,350
.نتقاتل؟ هذا مثير للشّفقة أيّها الضّعيف

139
00:09:43,890 --> 00:09:45,720
،إن كنتَ سيّافًا كفؤًا بما يكفي

140
00:09:45,720 --> 00:09:48,560
فيجب أن تكون قادرًا على رؤية
مدى التّفاوت بين قدراتنا

141
00:09:48,560 --> 00:09:50,700
.قبل حتّى أن تتلامس سيوفنا

142
00:09:51,260 --> 00:09:57,770
هل شجاعتك أم جهلك ما دفعك
لتوجّه سيفك نحوي؟

143
00:09:58,170 --> 00:09:59,770
!إنّه طموحي

144
00:10:02,840 --> 00:10:05,640
وبسبب وعد قطعته
!على صديقة عزيزة أيضًا

145
00:10:06,110 --> 00:10:09,350
،عين الصّقر ميهوك
،أقوى سيّافي العالم

146
00:10:09,350 --> 00:10:11,420
...وصائد القراصنة زورو

147
00:10:11,420 --> 00:10:13,950
أيّ قتال سيجمع بينهما يا ترى؟

148
00:10:14,520 --> 00:10:17,650
لا يوجد أيّ أحد قادر على
!هزيمة أخينا الكبير

149
00:10:18,090 --> 00:10:20,120
!أخي الكبير هو الأقوى بالفعل

150
00:10:24,460 --> 00:10:27,230
مهلًا، ما معنى هذا؟

151
00:10:27,960 --> 00:10:32,240
أنا لستُ وحشًا يظهر كلّ قوّته
.عندما يصطاد أرنبًا

152
00:10:32,240 --> 00:10:35,540
حتّى إن كنتَ سيّافًا ذاع
،صيته بعض الشّيء

153
00:10:35,540 --> 00:10:41,210
فإنّ الأزرق الشّرقيّ هو الأضعف
.بين البحار الأربعة

154
00:10:41,840 --> 00:10:45,510
لسوء الحظّ، لا أحمل معي أيّ
.نصل أصغر من هذا

155
00:10:45,510 --> 00:10:49,080
!كفاك سخرية منّي

156
00:10:49,080 --> 00:10:51,390
!من الأفضل ألاّ تندم عندما أقتلك

157
00:10:51,390 --> 00:10:54,720
...أيّها الّضفدع القابع في بئر
.اعرف مدى كبر هذا العالم

158
00:10:54,720 --> 00:10:57,690
!قاطع الشيطان

159
00:10:59,860 --> 00:11:01,960
!ما-ماذا؟

160
00:11:09,100 --> 00:11:10,210
!زورو؟

161
00:11:10,670 --> 00:11:13,880
!ما... أوقف هجوم قاطع الشيطان؟

162
00:11:13,880 --> 00:11:17,180
حتّى تقنية قويّة لا تفشل أبدًا
...في الإطاحة بالعدوّ كهذه قد

163
00:11:17,180 --> 00:11:18,850
!ماذا يحدث؟

164
00:11:19,480 --> 00:11:23,450
!لا... لا أستطيع تحريكها
!ما الّذي فعله؟

165
00:11:23,450 --> 00:11:25,820
لم يتمكّن أيّ أحد من اكتشاف
،سرّ هذه التّقنية من قبل

166
00:11:25,820 --> 00:11:27,620
!وقد أوقفها باستعمال لعبة كتلك؟

167
00:11:28,220 --> 00:11:30,590
!هذا... غير ممكن

168
00:11:31,790 --> 00:11:34,060
!هل قدراتنا متباينة لهذا الحدّ؟

169
00:11:34,060 --> 00:11:37,230
!لا يمكن أن يكون ذلك صحيحًا
...مستحيل أن يكون الفرق شاسعًا هكذا

170
00:11:40,000 --> 00:11:43,300
لا يمكن للفرق بيني وبين الأقوى
!في العالم أن يكون هكذا

171
00:11:50,380 --> 00:11:53,280
!هذا غير ممكن، صحيح يا أخي؟
!قاتل بجدّيّة

172
00:11:53,280 --> 00:11:54,950
!أخي الكبير

173
00:11:54,950 --> 00:11:57,180
!لا يعقل أنّ الفارق كبير هكذا بيننا

174
00:12:25,740 --> 00:12:27,880
...يا لضراوة أسلوبك في المسايفة

175
00:12:35,120 --> 00:12:39,260
إنّه يصدّ هجمات أسلوب زورو
...بالسّيوف الثّلاثة بسكّين صغيرة

176
00:12:39,260 --> 00:12:42,290
!إنّه وحش تجاوز زورو الوحشيّ

177
00:12:46,300 --> 00:12:50,240
لم أمارس المسايفة طوال هذا الوقت

178
00:12:50,240 --> 00:12:52,470
!لأسمح للعبة كهذه أن تهزمني

179
00:12:54,340 --> 00:12:55,410
...زورو

180
00:13:07,490 --> 00:13:10,190
.أنت محظوظ يا زورو لأنّك صبيّ

181
00:13:10,960 --> 00:13:13,860
!أريد أن أصبح أعظم سيّافي العالم أيضًا

182
00:13:14,390 --> 00:13:17,830
...ليتني... ليتني وُلدتُ صبيًّا

183
00:13:19,730 --> 00:13:22,870
!لا تنوحي هكذا بعد أن هزمتني

184
00:13:22,870 --> 00:13:27,140
!هذا ليس عدلًا! أنت هدفي

185
00:13:27,140 --> 00:13:28,040
...زورو

186
00:13:29,640 --> 00:13:31,140
!عديني

187
00:13:31,140 --> 00:13:35,510
يومًا ما، سيصبح أحدنا
!أعظم سيّافي العالم

188
00:13:36,080 --> 00:13:36,980
!عديني

189
00:13:38,450 --> 00:13:39,220
!هذا وعد

190
00:13:44,920 --> 00:13:47,420
!سأصبح الأقوى في العالم

191
00:13:57,030 --> 00:14:01,400
!سأصبح أقوى من أجلها أيضًا

192
00:14:01,400 --> 00:14:07,440
سأصبح أقوى سيّافي العالم
!حتّى يبلغ اسمي السّماء

193
00:14:08,310 --> 00:14:11,180
...لقد وعدتُها... أنا

194
00:14:20,790 --> 00:14:23,390
...فقط لهزيمة هذا الرّجل

195
00:14:34,300 --> 00:14:37,040
ما العبء الّذي تحمله على كتفيك؟

196
00:14:37,040 --> 00:14:39,870
ما الّذي تبتغيه بمجرّد امتلاك
القوّة أيّها الضّعيف؟

197
00:14:40,340 --> 00:14:43,310
وصفتَ أخي الكبير بالضّعيف؟
!أيّها الوغد ذو الصّليب

198
00:14:43,310 --> 00:14:45,750
...سألقّنك درسًا! إنّه

199
00:14:45,750 --> 00:14:48,550
!توقّفا يا يوساكو وجوني
!لا تتدخّلا

200
00:14:49,050 --> 00:14:51,720
!كونا صبورين

201
00:14:53,520 --> 00:14:54,820
...لوفي

202
00:14:57,420 --> 00:15:00,790
...لا يجب أن أخسر

203
00:15:14,910 --> 00:15:16,540
...صيد

204
00:15:16,540 --> 00:15:19,210
!يبدو ذلك رائعًا
أعظم سيّافي العالم؟

205
00:15:19,210 --> 00:15:22,780
لن يقبل ملك القراصنة أقلّ
!من ذلك في طاقمه

206
00:15:22,780 --> 00:15:24,750
!النّمور

207
00:15:45,040 --> 00:15:47,840
هل ستدعني أطعن قلبك بتلك البساطة؟

208
00:15:47,840 --> 00:15:49,540
لماذا لا تتراجع؟

209
00:15:49,540 --> 00:15:51,010
...لا أدري

210
00:15:51,780 --> 00:15:54,110
...لا أدري لماذا، لكن

211
00:15:54,650 --> 00:15:56,880
،إن تراجعتُ ولو خطوة واحدة

212
00:15:56,880 --> 00:16:00,990
أشعر وكأنّ تلك الأمور العديدة
المهمّة مثل الوعود

213
00:16:00,990 --> 00:16:03,190
،والعهود في الماضي ستتحطّم

214
00:16:03,190 --> 00:16:06,760
ولن أعود قادرًا على الرّجوع
...إلى حيث أنا الآن

215
00:16:08,090 --> 00:16:10,060
.نعم، هذا هو الهدف من الهزيمة

216
00:16:11,300 --> 00:16:13,530
...إذًا، هذا سبب آخر لكي لا أتراجع

217
00:16:14,400 --> 00:16:15,800
حتّى إن متّ؟

218
00:16:16,670 --> 00:16:18,840
.أفضّل الموت

219
00:16:19,400 --> 00:16:24,480
!يا لقوّة قلبه! يختار الموت بدل الهزيمة

220
00:16:27,780 --> 00:16:29,710
.يا فتى! أخبرني باسمك

221
00:16:34,280 --> 00:16:36,150
.رورونوا زورو

222
00:16:37,090 --> 00:16:38,590
.سأتذكّره

223
00:16:38,590 --> 00:16:42,130
لم أقابل شخصًا مثلك منذ مدّة
...أيّها القويّ. لذلك

224
00:16:43,330 --> 00:16:45,000
،واحترامًا لك كسيّاف

225
00:16:45,000 --> 00:16:48,500
سأغرقك بأقوى سيف
.أسود في العالم

226
00:16:48,930 --> 00:16:51,330
.أقدّر لك ذلك

227
00:16:52,870 --> 00:16:53,940
!لـ-لقد أخرجه

228
00:16:53,940 --> 00:16:56,010
!إنّه السّيف الّذي قطّع به السّفينة

229
00:16:56,610 --> 00:16:58,740
...ستكون هذه الهجمة الأخيرة

230
00:16:59,210 --> 00:17:01,040
هل سأصبح الأقوى في العالم؟

231
00:17:01,040 --> 00:17:02,080
أم سألاقي حتفي؟

232
00:17:06,580 --> 00:17:08,980
!يا أخي الكبير! هذا يكفي! توقّف رجاءً

233
00:17:08,980 --> 00:17:10,850
!مهارة أسلوب السّيوف الثّلاثة السّرّيّة

234
00:17:13,560 --> 00:17:14,490
!مُت

235
00:17:14,490 --> 00:17:16,590
!العوالم الثّلاثة آلاف

236
00:17:25,370 --> 00:17:26,640
...خسرت

237
00:17:28,200 --> 00:17:31,070
...لم أتخيّل أبدًا أنّني قد أخسر

238
00:17:33,170 --> 00:17:35,840
...هذه إذًا قوّة الأقوى في العالم

239
00:17:40,980 --> 00:17:41,850
...ما الّذي

240
00:17:43,250 --> 00:17:45,690
...النّدوب في الظّهر هي عار السّيّاف

241
00:17:46,220 --> 00:17:47,120
!مثير للإعجاب

242
00:17:50,990 --> 00:17:56,930
!زورو

243
00:17:58,930 --> 00:18:01,740
.لا تعش بتهوّر أيّها الشّابّ

244
00:18:03,000 --> 00:18:04,410
!زورو

245
00:18:05,510 --> 00:18:06,870
!أخي الكبير

246
00:18:10,140 --> 00:18:11,310
لماذا؟

247
00:18:13,450 --> 00:18:16,880
،عندما قرّرتُ أن أصبح أقوى سيّاف

248
00:18:17,320 --> 00:18:20,420
.قرّرتُ أيضًا تكريس حياتي لذلك الهدف

249
00:18:22,260 --> 00:18:25,730
إنّه مجنون! خصمه هو السّيّاف
!الأقوى في العالم بالفعل

250
00:18:26,690 --> 00:18:30,400
كانت النّتيجة واضحة. كان عليه
!التّخلّي عن طموحه بدل الموت

251
00:18:30,400 --> 00:18:33,730
...ألم يكن من السّهل
أن تتخلّى عن طموحك؟

252
00:18:37,070 --> 00:18:40,670
...هذه هي قوّة الغراند لاين
!قوّة العالم

253
00:18:41,310 --> 00:18:44,940
لا أصدّق أنّ صائد القراصنة زورو
!كان بلا حول ولا قوّة كرضيع صغير

254
00:18:44,940 --> 00:18:49,720
!سُحقًا، سُحقًا... سُحقًا

255
00:18:49,720 --> 00:18:51,250
!أخي الكبير

256
00:18:56,260 --> 00:18:58,390
ما-ما كان ذلك؟

257
00:18:59,530 --> 00:19:03,460
!ذلك الشّقيّ... لديه قوّة فاكهة شيطان

258
00:19:04,460 --> 00:19:05,700
...أيّها الوغد

259
00:19:06,900 --> 00:19:09,770
هل أنت رفيق ذلك السّيّاف الشّابّ؟

260
00:19:09,770 --> 00:19:12,600
أثرتَ إعجابي أيضًا بمشاهدتك
!للأمر حتّى النّهاية

261
00:19:18,080 --> 00:19:21,710
.لا تقلق. لم أقتل ذلك الشّابّ

262
00:19:22,810 --> 00:19:25,220
!أخي الكبير! أخي الكبير! قل شيئًا

263
00:19:25,220 --> 00:19:26,120
!زورو؟

264
00:19:28,090 --> 00:19:29,090
!زورو

265
00:19:29,090 --> 00:19:31,020
!هيّا، ضعاه في السّفينة بسرعة

266
00:19:32,890 --> 00:19:34,630
!أحضرت الدّواء! فلنضعه عليه

267
00:19:35,230 --> 00:19:40,600
.ما زال الوقت باكرًا لتموت
!اسمي دراكول ميهوك

268
00:19:40,600 --> 00:19:43,270
!اكتشف نفسك! اكتشف العالم

269
00:19:43,270 --> 00:19:44,570
!اغدُ أقوى

270
00:19:44,570 --> 00:19:47,000
،لا يهمّ كم سيتطلّب الأمر من سنوات

271
00:19:47,000 --> 00:19:49,540
.سأواصل حمل لقب الأقوى في العالم وأنتظرك

272
00:19:50,170 --> 00:19:52,240
!تغلّب على هذا السّيف

273
00:19:52,240 --> 00:19:56,680
!حاول التّغلّب عليّ يا رورونوا زورو

274
00:19:58,180 --> 00:20:00,980
!أخي الكبير! أخي الكبير، قل شيئًا

275
00:20:01,650 --> 00:20:05,390
لا أصدّق أنّه دفع عين الصّقر ميهوك
...ليقول تلك الكلمات

276
00:20:06,590 --> 00:20:09,160
أيّها الفتى، ما هو حلمك؟

277
00:20:09,590 --> 00:20:10,760
!أن أصبح ملك القراصنة

278
00:20:11,760 --> 00:20:15,500
!سيكون ذلك أصعب حتّى من التّغلّب عليّ

279
00:20:15,500 --> 00:20:18,200
!وكيف لي أن أعرف بينما لم أجرّب بعد؟

280
00:20:19,570 --> 00:20:20,470
!إنّه حيّ

281
00:20:21,540 --> 00:20:22,910
.إنّه فاقد للوعي فحسب

282
00:20:22,910 --> 00:20:23,810
!أخي الكبير

283
00:20:23,810 --> 00:20:25,880
!أخي الكبير، قل شيئًا

284
00:20:26,580 --> 00:20:27,640
زورو؟

285
00:20:28,380 --> 00:20:29,550
!أخي الكبير

286
00:20:31,050 --> 00:20:32,610
...لـ... لوفي

287
00:20:33,220 --> 00:20:34,580
أيمكنك سماعي؟

288
00:20:34,580 --> 00:20:35,580
!نعم

289
00:20:38,150 --> 00:20:40,220
هل أقلقتُك عليّ؟

290
00:20:41,060 --> 00:20:49,000
لا تحتاج لأقلّ من السّيّاف الأقوى
في العالم في طاقمك، صحيح؟

291
00:20:50,100 --> 00:20:52,130
!أخي الكبير! لا تتكلّم أكثر رجاءً

292
00:20:52,130 --> 00:20:52,970
!أخي الكبير

293
00:20:53,500 --> 00:20:59,740
!سوف... لن أُهزم ثانية أبدًا

294
00:21:03,340 --> 00:21:07,150
وحتّى اليوم الّذي أهزمه فيه
...وأصبح السّيّاف الأقوى

295
00:21:07,780 --> 00:21:13,090
!فلن... أهزم أبدًا
...هل لديك أيّ مشكلة في ذلك

296
00:21:14,560 --> 00:21:16,720
!يا ملك القراصنة؟

297
00:21:20,190 --> 00:21:21,260
!لا

298
00:21:22,200 --> 00:21:26,730
.أنتما فريق جيّد
.أودّ رؤيتكما ثانية يا رفاق

299
00:21:27,770 --> 00:21:29,740
!يا عين الصّقر

300
00:21:30,700 --> 00:21:33,770
...ألم تأتي إلى هنا لتسلبني حياتي

301
00:21:33,770 --> 00:21:37,210
حياة المسيطر على الأزرق
الشّرقيّ، الدّون كريغ؟

302
00:21:37,880 --> 00:21:41,820
.كنتُ سأفعل، لكنّني نلت كفايتي من المتعة

303
00:21:41,820 --> 00:21:43,620
.سأعود أدراجي وأرتاح قليلًا

304
00:21:45,420 --> 00:21:48,990
،ربّما تكون قد نلت كفايتك
.لكنّني سئمتُ من الهزيمة

305
00:21:48,990 --> 00:21:50,560
د-دون؟

306
00:21:50,560 --> 00:21:52,960
لماذا تحاول إبقاءه هنا؟

307
00:21:55,330 --> 00:21:57,230
!مت قبل أن تغادر

308
00:21:58,630 --> 00:22:01,230
...كما توقّعت... إنّه لا يتعلّم

309
00:22:08,940 --> 00:22:10,840
...سُحقًا! لقد هرب

310
00:22:20,090 --> 00:22:20,990
!أوسوبّ

311
00:22:21,620 --> 00:22:22,420
!لوفي

312
00:22:22,920 --> 00:22:25,120
!اذهب! سأترك أمر نامي لك

313
00:22:25,720 --> 00:22:29,730
مفهوم! سنحضر أنا وزورو نامي
!وسنعود بالتّأكيد

314
00:22:29,730 --> 00:22:32,100
!احرص على جعل ذلك الطّبّاخ ينضمّ لنا

315
00:22:32,560 --> 00:22:35,200
،وعندما نجتمع نحن الخمسة
...فدعنا نبحر نحو

316
00:22:35,730 --> 00:22:37,640
!الغراند لاين

317
00:22:37,640 --> 00:22:39,900
!نعم! لك ذلك

318
00:22:39,900 --> 00:22:45,180
،يا رجال! ثمّة من أخّرنا عن هدفنا
!لكنّ القتال الحقيقيّ يبدأ الآن

319
00:22:45,180 --> 00:22:46,940
!سنستولي على تلك السّفينة

320
00:22:46,940 --> 00:22:47,880
!أجل

321
00:22:47,880 --> 00:22:52,250
أيّها العمّ، هل أستطيع التّوقّف
عن العمل إن أبعدهم من هنا؟

322
00:22:52,880 --> 00:22:54,750
.افعل ما يحلو لك

323
00:22:55,790 --> 00:23:10,030
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

324
00:23:10,030 --> 00:23:16,970
ولطالما بحثت عن ذلك المكان الإعجازيّ

325
00:23:16,970 --> 00:23:24,150
لكي لا يسبقني أحد آخر إليه

326
00:23:26,680 --> 00:23:38,160
إن كان العالم سيتغيّر

327
00:23:38,160 --> 00:23:45,170
قبل أن أحقّق حلمي

328
00:23:45,170 --> 00:23:52,240
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

329
00:23:52,240 --> 00:24:05,620
لكي لا تمحى ذكرياتي

330
00:24:10,490 --> 00:24:12,190
!كريغ وقراصنته قادمون

331
00:24:12,190 --> 00:24:14,600
بصراحة، يا لهم من مجموعة
،ناكرة للجميل

332
00:24:14,600 --> 00:24:15,960
!لقد نسوا من أطعمهم

333
00:24:15,960 --> 00:24:17,170
،بالتّفكير في الأمر

334
00:24:17,170 --> 00:24:19,800
هنالك شخص آخر ناكر للجميل
...أخذ كنوزنا وهرب

335
00:24:19,800 --> 00:24:21,500
!لا يجب أن تقلق حيال ذلك
!ارتح قليلًا

336
00:24:21,500 --> 00:24:23,740
...مهلًا، ظهر رجل غريب

337
00:24:23,740 --> 00:24:27,640
!إنّه مدرّع بالكامل
!هذا ساخن... نار، نار

338
00:24:27,640 --> 00:24:29,040
:في الحلقة القادمة من ون بيس

339
00:24:29,040 --> 00:24:32,550
!ظهور تقنيات السّاق المميتة"
".سانجي ضدّ بيرل المنيع

340
00:24:32,550 --> 00:24:34,750
!ملك القراصنة، لن يكون إلاّ أنا