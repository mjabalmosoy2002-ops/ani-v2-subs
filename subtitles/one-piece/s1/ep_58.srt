1
00:00:14,040 --> 00:00:15,440
...إرادة موروثة

2
00:00:15,780 --> 00:00:17,980
...تعاقب الأزمنة... أحلام النّاس

3
00:00:18,580 --> 00:00:20,920
.لا رادع لهذه الأشياء

4
00:00:21,380 --> 00:00:24,490
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:24,490 --> 00:00:27,120
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:35,660 --> 00:00:42,040
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:42,040 --> 00:00:47,540
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:00:47,540 --> 00:00:53,550
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:00:53,550 --> 00:00:57,050
أشعر بـ"الجمال" في كلّ مكان

10
00:00:57,050 --> 00:01:00,350
أنا متمسّك بكم بشدّة بالفعل

11
00:01:00,350 --> 00:01:06,960
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:06,960 --> 00:01:10,260
إلى أن أحصل عليه بكلّ إثارة

13
00:01:10,260 --> 00:01:17,270
!آمنوا ببلاد العجائب

14
00:01:19,210 --> 00:01:25,410
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:25,410 --> 00:01:31,420
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:31,420 --> 00:01:34,490
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:34,490 --> 00:01:37,860
،بل أريدها حياة عاديّة لا غير

18
00:01:37,860 --> 00:01:41,300
فاركضوا نحو النّعيم بدل ذلك

19
00:01:41,300 --> 00:01:46,930
!آمنوا ببلاد العجائب

20
00:01:57,110 --> 00:01:59,480
!مذهل يا نامي! انظري

21
00:02:06,350 --> 00:02:07,660
!سفينة القراصنة

22
00:02:12,060 --> 00:02:15,100
!أرى جزيرة تحت ذلك الضوء

23
00:02:15,100 --> 00:02:16,600
!سنأخذ السفينة إلى هناك

24
00:02:17,730 --> 00:02:21,940
لماذا لم تعلمني أنّك
!وجدت تنين الألفيّة؟

25
00:02:22,770 --> 00:02:25,610
ستتوجه قواتنا الرئيسيّة
!إلى جزيرة السفينة الحربيّة الآن

26
00:02:25,610 --> 00:02:27,410
!فلتتحرك جميع السفن

27
00:02:28,680 --> 00:02:32,080
تلك الوغدة نامي تجعل
...الرجال يقومون بكلّ الأعمال

28
00:02:32,080 --> 00:02:34,620
!أنت هناك، توقف عن التذمر وادفع

29
00:02:34,620 --> 00:02:36,820
!لا تغتري بنفسك أيّتها اللعينة

30
00:02:47,500 --> 00:02:49,160
...وصلنا أخيرًا

31
00:03:08,720 --> 00:03:10,820
إنّنا أحياء... أليس كذلك؟

32
00:03:10,820 --> 00:03:12,550
...يبدو كذلك

33
00:03:13,120 --> 00:03:14,660
ما ذلك؟

34
00:03:17,860 --> 00:03:19,830
ما هذا؟

35
00:03:26,000 --> 00:03:30,070
معركة عند الآثار
!زورو المتوتر ضد إيريك

36
00:03:37,040 --> 00:03:39,750
!يا لها من صورة ضخمة

37
00:03:39,950 --> 00:03:41,150
صورة ماذا هذه؟

38
00:03:41,150 --> 00:03:43,920
...تبدو كخريطة ما... مؤلم

39
00:03:44,490 --> 00:03:47,090
.ولكنّها بالية لدرجة أنّها غير واضحة أبدًا

40
00:03:47,690 --> 00:03:49,160
!ما هذا المكان من الأساس؟

41
00:03:49,860 --> 00:03:51,990
ألم يفترض أن يكون هذا وكر التنانين؟

42
00:03:52,150 --> 00:03:53,090
.لا أدري

43
00:03:53,360 --> 00:03:54,800
إذًا يا أبيس؟

44
00:03:55,960 --> 00:03:57,060
.لا أدري

45
00:03:57,060 --> 00:03:59,770
يقول الجدّ ريو أنّه
...لا يعرف هذا المكان أيضًا

46
00:04:00,000 --> 00:04:03,600
!يا إلهي! إنّه عجوز عديم الفائدة كالعادة

47
00:04:03,600 --> 00:04:04,770
!ماذا قلت؟

48
00:04:04,770 --> 00:04:06,410
!إنّها الحقيقة

49
00:04:06,410 --> 00:04:09,140
!ما هي فائدتك أنت إذًا؟

50
00:04:09,140 --> 00:04:09,980
!أنا؟

51
00:04:09,980 --> 00:04:11,750
!انظروا لهذا جميعًا

52
00:04:11,950 --> 00:04:13,950
!سقطت صورة السّقف

53
00:04:16,420 --> 00:04:17,320
!إنّها ضخمة

54
00:04:17,320 --> 00:04:19,090
!هذا خطير

55
00:04:21,890 --> 00:04:24,560
!هذا المبنى في حالة يرثى لها

56
00:04:24,990 --> 00:04:27,160
،إن ضيعنا الوقت هنا
!فسنكون في خطر أيضًا

57
00:04:27,160 --> 00:04:29,100
!لنخرج من هذا المكان بسرعة

58
00:04:29,760 --> 00:04:32,500
!ولكن قد يكون هذا وكر التنانين

59
00:04:32,500 --> 00:04:34,670
!تقولين ذلك ولكن لا أرى أيّ تنين

60
00:04:34,670 --> 00:04:35,800
!تمهلوا

61
00:04:36,700 --> 00:04:38,170
ما الخطب يا نامي-سان؟

62
00:04:38,170 --> 00:04:40,980
...قد لا تكون هذه الجزيرة المفقودة

63
00:04:42,280 --> 00:04:43,540
!انظري

64
00:04:43,540 --> 00:04:46,350
،لا تعرف السبب حتى
!لذا لا تختلق الأمور

65
00:04:46,750 --> 00:04:49,120
كيف تعرفين ذلك يا نامي؟

66
00:04:49,120 --> 00:04:50,450
.انظروا للأعلى

67
00:04:50,450 --> 00:04:51,250
الأعلى؟

68
00:04:52,720 --> 00:04:53,950
صورة السقف؟

69
00:04:53,950 --> 00:04:55,120
.أمعنوا النظر

70
00:04:55,420 --> 00:04:58,690
.إنّها خريطة تمثّل مكان الجزيرة المفقودة

71
00:04:58,690 --> 00:05:01,660
الجزيرة التي عليها
مبنى بشكل قبّة

72
00:05:02,130 --> 00:05:03,660
.هي هذه الجزيرة

73
00:05:04,000 --> 00:05:06,230
.تلك القبّة هي هذا المبنى

74
00:05:06,630 --> 00:05:08,140
...يشبهه تمامًا بالفعل

75
00:05:08,540 --> 00:05:13,840
والأشخاص الذي نراهم حول الجزيرة
.هم الناس الذين كانوا يعيشون هنا سابقًا

76
00:05:14,510 --> 00:05:18,050
.ربما يكونون أجداد أبيس

77
00:05:18,050 --> 00:05:19,650
أجدادنا؟

78
00:05:19,780 --> 00:05:22,780
أتذكرون ما أخبرنا إيّاه
العجوز بوكودين؟

79
00:05:22,780 --> 00:05:24,150
!لا، كنت نائمًا

80
00:05:24,150 --> 00:05:26,420
بربّك... أخبرنا عن أنّ سكّان
جزيرة السفينة الحربيّة

81
00:05:26,420 --> 00:05:29,360
.رحلوا إلى هناك من جزيرة أخرى

82
00:05:29,490 --> 00:05:30,960
حقًا؟

83
00:05:30,960 --> 00:05:33,760
...صحيح، قال شيئًا كهذا

84
00:05:34,030 --> 00:05:36,700
أذلك يعني أنّ السلالة
التي كان يثرثر عنها

85
00:05:36,700 --> 00:05:38,530
كانت على هذه الجزيرة؟

86
00:05:38,770 --> 00:05:40,000
.على الأغلب

87
00:05:40,330 --> 00:05:41,870
ما جعلني أتساءل هو

88
00:05:41,870 --> 00:05:44,540
كلّ تماثيل التنانين والرسومات
.في طريقنا إلى هنا

89
00:05:45,470 --> 00:05:48,980
أعتقد أنّ سكان الجزيرة
كانوا يستخدمونها

90
00:05:48,980 --> 00:05:51,850
.لعبادة تنين الألفيّة كإله

91
00:05:52,210 --> 00:05:56,420
لا بدّ وأنّ تنين الألفيّة كان
.يطير فوق هذه الجزيرة في الماضي

92
00:05:58,090 --> 00:05:59,750
!فهمت

93
00:05:59,750 --> 00:06:03,520
يقلل هذا نسبة وجود
.وكر التنانين على هذه الجزيرة بالفعل

94
00:06:03,520 --> 00:06:06,560
!ولكن أين يكون الحقيقي بهذه الحالة؟

95
00:06:06,730 --> 00:06:10,100
ألن تكون تلك الجزيرة التي رُسمَ عليها تنّين؟

96
00:06:10,500 --> 00:06:11,200
!صحيح

97
00:06:12,030 --> 00:06:15,940
توجد جزيرة بالاتجاه الموازي
.للمكان الذي يصلي سكان الجزيرة عنده

98
00:06:16,370 --> 00:06:18,810
!تلك هي الجزيرة المفقودة الحقيقيّة

99
00:06:18,810 --> 00:06:21,180
!لا بدّ وأنّ وكر التنانين هناك أيضًا

100
00:06:21,310 --> 00:06:22,310
...ولكن

101
00:06:23,640 --> 00:06:26,280
...لحظة! شكل تلك الجزيرة

102
00:06:26,280 --> 00:06:27,350
.صحيح

103
00:06:27,550 --> 00:06:30,050
،بافتراض صحة الخريطة

104
00:06:30,050 --> 00:06:33,250
.فإنّ وكر التنين على جزيرة السفينة الحربيّة

105
00:06:33,620 --> 00:06:38,130
ولكن ألم يفترض أنّه لا توجد أماكن
!على جزيرة السفينة الحربيّة تلائم الوصف؟

106
00:06:38,130 --> 00:06:40,960
!ولكن هذا المكتوب على الخريطة

107
00:06:40,960 --> 00:06:43,970
أم هل تقصد أنّ ما رسمه
الأقدمون هو مجرد هراء؟

108
00:06:43,970 --> 00:06:45,500
!صحيح أيّها الأوغاد

109
00:06:45,730 --> 00:06:47,940
!يستحيل أن تقول نامي-سان شيئًا خاطئًا

110
00:06:48,200 --> 00:06:50,740
ذلك يعني أنّه موجود في
!مكان ما على تلك الجزيرة

111
00:06:50,740 --> 00:06:52,510
!سنعرف إن ذهبنا

112
00:06:53,570 --> 00:06:58,010
صحيح... ولكن قد يكون
...غرق إلى قعر البحر

113
00:06:58,010 --> 00:07:00,950
.لا، تلك الاحتمالية كبيرة

114
00:07:00,950 --> 00:07:05,120
ذلك يفسر عدم إيجاد
.أحد له حتّى الآن

115
00:07:07,590 --> 00:07:08,420
أبيس؟

116
00:07:09,090 --> 00:07:10,090
!الجدّ ريو

117
00:07:10,290 --> 00:07:14,060
!تذكّر أيّها الجدّ ريو
!أين يوجد وكر التنانين؟

118
00:07:14,200 --> 00:07:16,460
،اعتقدنا أنّ هذا هو المكان
!ولكن لا يوجد شيء هنا

119
00:07:16,460 --> 00:07:18,630
!لا توجد إلّا رسومات أيّها الجد ريو

120
00:07:18,630 --> 00:07:21,140
ألا تذكرك تلك الرسومات بشيء؟

121
00:07:21,370 --> 00:07:23,970
ليس هناك أمل الآن سوى
!أن تتذكّر أيّها الجدّ ريو

122
00:07:24,410 --> 00:07:27,680
!هيّا، أرجوك تذكّر أيّها الجدّ ريو

123
00:08:56,800 --> 00:08:58,170
!الجدّ ريو

124
00:08:58,300 --> 00:09:01,500
حسنًا، وكر التنانين موجود فعلًا
على جزيرة السفينة الحربيّة إذًا؟

125
00:09:01,700 --> 00:09:04,040
ماذا؟ كيف عرفت ذلك يا لوفي؟

126
00:09:04,310 --> 00:09:05,470
!عرفت فحسب

127
00:09:05,840 --> 00:09:08,480
!صحيح. قال الجدّ ريو أنّه تذكّر

128
00:09:09,010 --> 00:09:11,550
قال أنّ وكر التنانين

129
00:09:11,550 --> 00:09:14,120
موجود في جزيرة شرق قمّة
...تبدو كسفينة حربيّة

130
00:09:14,420 --> 00:09:16,350
يا إلهي... لماذا يقول ذلك

131
00:09:16,350 --> 00:09:19,150
بعد أن عانينا من كلّ تلك
!المصاعب للوصول إلى هنا؟

132
00:09:19,150 --> 00:09:20,190
...آسفة

133
00:09:21,290 --> 00:09:24,960
سحبتكم كلّ الطريق إلى هنا

134
00:09:24,960 --> 00:09:27,360
...لشيء قد يكون غرق في البحر بالفعل

135
00:09:27,760 --> 00:09:29,300
...كان ذلك بلا فائدة

136
00:09:31,170 --> 00:09:32,830
!ليس بالضرورة

137
00:09:34,240 --> 00:09:38,070
قد يكون وكر التنانين في
!مكان غير متوقع

138
00:09:38,540 --> 00:09:40,610
ولن نعرف ما لم نذهب، أليس كذلك؟

139
00:09:41,750 --> 00:09:43,010
!صحيح

140
00:09:43,480 --> 00:09:46,580
الشعور بالإحباط لهذا فحسب
!ليس من طباعك يا أبيس

141
00:09:46,580 --> 00:09:49,650
لن تنجزي شيئًا إن
.كنتِ تخشين الفشل

142
00:09:49,980 --> 00:09:52,990
لا بأس بعيش حياة نسلك
...فيها الدروب الطويلة

143
00:09:54,120 --> 00:09:55,260
...رفاق

144
00:09:58,230 --> 00:10:01,930
لنذهب! لن يتحسن
!الجدّ ريو إن بقينا هنا

145
00:10:02,160 --> 00:10:02,960
أليس كذلك؟

146
00:10:07,400 --> 00:10:08,700
!شكراً لكم

147
00:10:17,280 --> 00:10:18,780
أهناك خطب ما يا زورو؟

148
00:10:18,780 --> 00:10:19,650
.ثمّة أحد هنا

149
00:10:21,430 --> 00:10:22,450
.ويملك نية قتل

150
00:10:26,950 --> 00:10:28,460
.أشكركم على الشرح

151
00:10:28,460 --> 00:10:33,660
...عرفت الآن مكان الريوكوتسو ووكر التنانين

152
00:10:33,860 --> 00:10:35,130
!أنت ثانية؟

153
00:10:35,700 --> 00:10:38,530
...ولكن لا فائدة إن كانا في قاع البحر

154
00:10:38,530 --> 00:10:41,740
يبدو أنّ لا خيار لديّ
.سوى أخذ تنين الألفيّة خاصتكم هذا

155
00:10:42,470 --> 00:10:43,670
!لا

156
00:10:43,670 --> 00:10:47,310
وبالأساس، لا نعلم ما إن كان
!وكر التنانين في قاع البحر أم لا

157
00:10:47,810 --> 00:10:51,310
قال أنّه أكل فاكهة المنجل
...إن لم تخنّي الذاكرة

158
00:10:51,780 --> 00:10:53,880
...أتى لنا شخص مزعج

159
00:10:53,880 --> 00:10:57,020
!فاكهة المنجل
!أيملك قوة فاكهة الشيطان؟

160
00:10:57,950 --> 00:10:58,590
...أنت

161
00:10:58,790 --> 00:10:59,750
.لوفي

162
00:11:00,990 --> 00:11:03,520
.اذهب وخذ الجدّ ريو معك إلى السفينة

163
00:11:06,130 --> 00:11:07,700
.سآتي لاحقًا

164
00:11:09,030 --> 00:11:10,100
!فهمت

165
00:11:10,400 --> 00:11:13,030
!تـ-تمهل... السفينة؟

166
00:11:13,800 --> 00:11:15,700
!لا نعرف أين المخرج حتى

167
00:11:15,920 --> 00:11:17,870
!سنصنعه فحسب

168
00:11:19,010 --> 00:11:20,040
...لا يمكن

169
00:11:29,220 --> 00:11:32,620
...ماذا؟ اعتقدت أنّه سيُكسر

170
00:11:32,990 --> 00:11:36,520
...أنت، أنت

171
00:11:53,370 --> 00:11:54,710
!فتح، فتح

172
00:11:54,910 --> 00:11:56,610
!نجح الأمر! نجح الأمر

173
00:11:56,610 --> 00:11:58,180
!لنذهب يا أبيس

174
00:11:58,850 --> 00:12:00,980
...إنّه أدنى من رجل كهف

175
00:12:00,980 --> 00:12:01,720
!لن أسمح لكم

176
00:12:20,200 --> 00:12:23,870
!لوفي! اذهب بسرعة

177
00:12:24,140 --> 00:12:25,270
!آسف

178
00:12:45,760 --> 00:12:47,230
!يا للسرعة

179
00:12:53,870 --> 00:12:56,870
د-دائمًا ما ننجو، أليس كذلك؟

180
00:12:56,870 --> 00:12:59,610
لسنا متأكدين ما إن كنا
!سننجو من هذا! ذلك الغبي

181
00:13:00,370 --> 00:13:02,580
!سيجعل هذا العودة سهلة

182
00:13:17,160 --> 00:13:20,430
أيّها اللعين، اعترض
!طريقي وسأجعلك تدفع الثّمن

183
00:13:21,630 --> 00:13:24,430
!دعني أراك تحاول

184
00:13:56,600 --> 00:13:58,570
أنا واثق بالكامل أنّنا الآن

185
00:13:58,570 --> 00:14:00,940
!أسرع شيء يتحرك في العالم

186
00:14:00,940 --> 00:14:03,040
!وما الذي يتطلب التباهي بذلك؟

187
00:14:03,270 --> 00:14:05,540
!لوفي! افعل شيئًا

188
00:14:05,540 --> 00:14:07,840
!سنتحطم قبل أن نصل إلى السفينة

189
00:14:07,840 --> 00:14:09,210
!لا بأس، لا بأس

190
00:14:09,680 --> 00:14:11,380
!كيف ذلك؟

191
00:14:13,080 --> 00:14:14,880
!فاكهة المنجل: الرياح القاطعة

192
00:14:17,250 --> 00:14:18,350
!ما هذا؟

193
00:14:19,220 --> 00:14:20,590
!أستهرب أيّها اللعين؟

194
00:14:21,560 --> 00:14:24,060
.لا أملك الوقت لمواجهتك

195
00:14:24,060 --> 00:14:26,560
!هدفي الوحيد هو تنين الألفيّة

196
00:14:28,600 --> 00:14:29,330
!انتظر

197
00:14:42,110 --> 00:14:44,150
!أهم بخير؟

198
00:14:47,950 --> 00:14:50,350
!أسيكون زورو بخير حقًا؟

199
00:14:50,520 --> 00:14:52,190
!أجل! سيكون بخير

200
00:14:52,190 --> 00:14:54,690
ولكن خصمه مستخدم
!قوى فاكهة شيطان

201
00:14:54,690 --> 00:14:56,820
!لن يكون ندًّا له مهما كانت قوته

202
00:14:57,690 --> 00:14:59,460
!سيكون بخير رغم ذلك

203
00:15:05,000 --> 00:15:06,900
!لوفي! أمامنا، أمامنا

204
00:15:07,570 --> 00:15:08,900
...هذا سيّئ

205
00:15:08,900 --> 00:15:10,370
!لا تقل ذلك

206
00:15:10,640 --> 00:15:12,310
!افعل شيئًا

207
00:15:26,920 --> 00:15:28,290
هناك إذًا؟

208
00:15:30,960 --> 00:15:34,200
.آسف، ولكن لا يمكن أن أدعك تمر

209
00:15:36,500 --> 00:15:40,130
لا يهمني. مروري من عدمه
!هو أمر يخصني أنا فحسب

210
00:15:40,970 --> 00:15:41,870
!ابتعد

211
00:15:52,880 --> 00:15:54,650
!سحقًا! الوغدُ خفيف

212
00:16:25,950 --> 00:16:28,020
.أخبرتك أنّك لن تمر

213
00:16:28,450 --> 00:16:29,650
!ابق ساكنًا

214
00:16:37,090 --> 00:16:40,460
!لوفي! هناك طريق مسدود آخر

215
00:16:42,030 --> 00:16:43,000
هل أحطمه؟

216
00:16:43,000 --> 00:16:43,970
!لا

217
00:16:44,330 --> 00:16:47,440
يفترض أن يكون أمامنا المنحدر
!الذي سلكناه أثناء صعودنا

218
00:16:47,700 --> 00:16:52,710
إن فعلت ذلك، فسنسقط عنده
!مباشرة وستكون نهايتنا

219
00:16:54,110 --> 00:16:55,510
ألا نستطيع الطيران؟

220
00:16:55,510 --> 00:16:56,840
!لا

221
00:17:22,600 --> 00:17:24,770
!أخبرتك ألّا تعيق طريقي

222
00:17:26,210 --> 00:17:27,710
!مت بلا مقاومة

223
00:17:34,480 --> 00:17:36,920
...يبدو أنّنا وصلنا بسلام بطريقة ما

224
00:17:36,920 --> 00:17:40,620
يا إلهي... إنّنا نملك
...حظًا عظيمًا أو شيئًا كهذا

225
00:17:43,820 --> 00:17:45,430
حسنًا! وصلنا، أليس كذلك؟

226
00:17:46,030 --> 00:17:48,400
!استعدوا للإبحار! لنذهب

227
00:17:48,400 --> 00:17:49,730
...لا أريد المزيد

228
00:17:49,730 --> 00:17:51,130
...وغد

229
00:17:51,130 --> 00:17:53,400
!ستدفع... الثمن

230
00:18:02,480 --> 00:18:03,540
!لوفي

231
00:18:04,710 --> 00:18:07,420
!زورو... زورو في خطر حسب قوله

232
00:18:07,420 --> 00:18:09,580
!ماذا نفعل؟! علينا مساعدته

233
00:18:11,620 --> 00:18:12,720
!مت

234
00:18:15,660 --> 00:18:23,760
!زورو

235
00:18:26,630 --> 00:18:27,700
!نجحت

236
00:18:27,700 --> 00:18:29,100
!مذهل

237
00:18:29,370 --> 00:18:32,070
...لا، لا يمكن أنّ هذا النمط

238
00:18:34,010 --> 00:18:34,810
!فلنذهب

239
00:18:34,940 --> 00:18:38,380
!أخبرتك ألّا تفعل هذا

240
00:18:39,950 --> 00:18:41,480
.آسف

241
00:18:41,480 --> 00:18:44,820
!سأقطعه يومًا ما حتمًا

242
00:18:45,190 --> 00:18:46,090
!سحقًا

243
00:18:47,190 --> 00:18:49,060
!لن أسمح لكم بالهروب

244
00:18:59,330 --> 00:19:00,370
!خرجنا، خرجنا

245
00:19:00,370 --> 00:19:02,500
...إنّه شعور غريب بالفعل

246
00:19:03,000 --> 00:19:04,310
!ماذا؟ هم؟

247
00:19:04,840 --> 00:19:07,070
نعم! إنّهم في طريقهم إلى
،جزيرة السفينة الحربيّة ثانية

248
00:19:07,070 --> 00:19:09,280
!مصطحبين معهم تنين الألفيّة

249
00:19:09,410 --> 00:19:13,150
ابدؤوا ملاحقتهم فورما
!نستعد إذًا! لا تضيّعوا الوقت

250
00:19:13,150 --> 00:19:15,980
...حاضر! وأيضًا أيّها الرائد

251
00:19:16,280 --> 00:19:18,950
أثناء ملاحقتهم، ظهر
،إيريك-ساما من جديد

252
00:19:19,090 --> 00:19:20,590
!وعاد للتو إلى السفينة

253
00:19:22,560 --> 00:19:24,360
.يا لكم من جماعة عديمة الجدوى

254
00:19:24,360 --> 00:19:26,190
...علينا أن نغرقهم جميعًا فحسب

255
00:19:26,490 --> 00:19:27,500
نعم؟

256
00:19:27,500 --> 00:19:29,530
!لا شيء! أحسنت بتقديم التقرير

257
00:19:31,400 --> 00:19:34,140
.تسرني عودتك إلى السفينة بلا أذى

258
00:19:34,170 --> 00:19:35,870
هل حصلت على الريوكوتسو؟

259
00:19:39,110 --> 00:19:43,010
،إن كنت تملك الوقت للسخرية
!فالحقهم بسرعة بدلًا من ذلك

260
00:19:48,720 --> 00:19:50,320
!إنّهم قادمون

261
00:19:51,050 --> 00:19:52,750
!لن يلحقوا بنا

262
00:19:52,750 --> 00:19:59,330
غوينغ ميري أسرع وأخف
،من سفن البحريّة الحربيّة الثقيلة

263
00:19:59,830 --> 00:20:03,060
ولكن ماذا سنفعل حين نصل
!إلى جزيرة السفينة الحربيّة؟

264
00:20:03,330 --> 00:20:05,070
!سنكون بخير-
!كيف سنكون بخير؟-

265
00:20:05,870 --> 00:20:08,270
علينا إيجاد وكر التنانين قبلهم

266
00:20:08,270 --> 00:20:10,540
!ليتحسن الجدّ ريو، أليس كذلك؟

267
00:20:10,910 --> 00:20:12,470
!القول أسهل من الفعل

268
00:20:12,740 --> 00:20:15,240
!قد يكون وكرهم في قاع البحر

269
00:20:15,240 --> 00:20:17,510
!علينا البحث في قاع البحر فحسب إذًا

270
00:20:17,710 --> 00:20:19,510
يا له من كلام من شخص
...لا يستطيع السباحة

271
00:20:19,950 --> 00:20:22,780
على أيّ حال، علينا أن
!نعود بأسرع ما يمكن

272
00:20:22,780 --> 00:20:25,090
!لا نملك الوقت للعبث مع البحريّة

273
00:20:26,720 --> 00:20:29,520
نامي-سان، لا يبدو أنّ ذلك
...سيكون خيارًا متاحًا

274
00:20:39,570 --> 00:20:42,070
!مذهل! رائع

275
00:20:42,070 --> 00:20:44,010
!كأنّه مزراب

276
00:20:44,010 --> 00:20:44,740
!أنت

277
00:20:50,780 --> 00:20:53,450
...أتت الحشرات الضعيفة

278
00:20:53,450 --> 00:20:55,050
!حان الوقت

279
00:20:55,050 --> 00:20:59,390
!انتشروا إلى اليسار واليمين
!تشكيلة جناح الكركي

280
00:21:10,500 --> 00:21:12,200
!أهذا ممكن؟

281
00:21:12,200 --> 00:21:15,770
!كم سفينة تملك البحريّة؟

282
00:21:16,000 --> 00:21:17,200
!استمعوا

283
00:21:17,200 --> 00:21:21,240
صلوا جميع السفن بالسلاسل
!لصنع حائط كامل

284
00:21:21,980 --> 00:21:24,710
!سيمنع ذلك مرور حتّى حشرة واحدة

285
00:21:27,880 --> 00:21:30,790
!ماذا نفعل؟! سدّوا طريقنا

286
00:21:30,790 --> 00:21:33,950
نقفز إلى سفينتهم ونبرحهم
!ضربًا ونقطع السلاسل

287
00:21:33,950 --> 00:21:35,620
!ليس لدينا إلّا هذا الحل

288
00:21:35,620 --> 00:21:38,890
!مذهل! أتستطيع فعلها يا أوسوب؟

289
00:21:39,990 --> 00:21:42,100
!انطلقوا يا لوفي وزورو وسانجي

290
00:21:42,100 --> 00:21:43,630
.توقعت ذلك

291
00:21:44,730 --> 00:21:46,330
!لا يبدو ذلك خيارًا سيئًا بالنسبة لي

292
00:21:46,470 --> 00:21:48,670
!ولكن هل أنت جاد؟

293
00:21:48,670 --> 00:21:51,440
!يستحيل أن تنجو إن فعلت ذلك

294
00:21:52,440 --> 00:21:55,210
لا بأس يا أبيس. ستسير الأمور
.على ما يرام بشكل ما

295
00:21:55,610 --> 00:21:58,310
!ولكن أنجزوا العمل بسرعة

296
00:21:58,510 --> 00:22:00,150
!اعتمدي عليّ يا نامي-سان

297
00:22:00,150 --> 00:22:02,520
!حسنًا، لنذهب

298
00:22:02,720 --> 00:22:06,820
!جميع السفن، صوّبوا
!الهدف هو سفينة القراصنة

299
00:22:06,820 --> 00:22:09,720
!ولكن لا ترموا الطوافة الموجودة خلفها

300
00:22:10,490 --> 00:22:13,330
!لا ينبغي أن تلحقوا به أيّ ضرر

301
00:22:18,530 --> 00:22:19,670
.أوقف السفن

302
00:22:21,370 --> 00:22:23,000
!فلتتوقف جميع السفن

303
00:22:28,940 --> 00:22:30,480
...نيلسون رويال

304
00:22:30,810 --> 00:22:33,450
اعتقدتك مجرد سمين لا يجيد
،شيئًا سوى الأكل

305
00:22:33,780 --> 00:22:36,320
ولكنّك تبدو وكأنّك ولدت من جديد
...حين تكون على البحر

306
00:22:39,020 --> 00:22:43,460
،مجرد عميد بحري
.لكنه يبقى عميدًا قبل كل شيء

307
00:22:49,800 --> 00:22:51,530
!يا له من شعور رائع

308
00:22:51,530 --> 00:22:53,000
!حسنًا

309
00:22:53,130 --> 00:22:54,600
!لننطلق

310
00:22:57,170 --> 00:23:02,010
مشاعري الجيّاشة لا تتّصل

311
00:23:02,140 --> 00:23:06,850
بينما أشدّ على يدك بثبات

312
00:23:07,050 --> 00:23:11,750
،سأشدّ الشّراع بنفسي

313
00:23:11,950 --> 00:23:16,690
لذا واصل مشاهدتي باهتمام بينما أبتعد

314
00:23:21,830 --> 00:23:26,470
كان يجول هذا في ذهني قليلًا منذ هذا الصّباح

315
00:23:26,770 --> 00:23:31,570
لمَ الجوّ حار؟

316
00:23:31,570 --> 00:23:41,580
،بدءًا من تلك النّقطة
لم أستطع التهرّب من ذلك

317
00:23:42,880 --> 00:23:47,890
،أريد أن أمسك تلك المشاعر الّتي رحلت بسرعة

318
00:23:47,890 --> 00:23:52,630
حتّى أنّني مستعدّ لأباغت نفسي

319
00:23:52,630 --> 00:23:57,400
أريد أن أعانق أحلامي الّتي قفزت من صدري

320
00:23:57,600 --> 00:24:02,800
معك، أستطيع الرّكض إلى هناك

321
00:24:11,380 --> 00:24:12,910
!انتهى أمرنا

322
00:24:12,910 --> 00:24:14,450
!سيطيحون بنا

323
00:24:14,450 --> 00:24:16,420
!من فكّر بهذه الخطة؟

324
00:24:16,420 --> 00:24:17,590
!أنت

325
00:24:18,120 --> 00:24:19,920
!سنهتزّ كثيرًا! تشبثوا بشيء

326
00:24:19,920 --> 00:24:21,220
!حاضر يا نامي-سان

327
00:24:21,220 --> 00:24:22,890
.ستضربنا تلك الطلقة

328
00:24:22,890 --> 00:24:24,790
!لا تقل ذلك وافعل شيئًا

329
00:24:24,790 --> 00:24:26,130
!أجل، سأفعل شيئًا

330
00:24:26,590 --> 00:24:27,930
:في الحلقة القادمة من وان بيس

331
00:24:27,930 --> 00:24:31,170
!لوفي محاصر بالكامل"
".خطة العميد نيلسون السريّة

332
00:24:31,170 --> 00:24:33,130
!ملك القراصنة، لن يكون إلاّ أنا