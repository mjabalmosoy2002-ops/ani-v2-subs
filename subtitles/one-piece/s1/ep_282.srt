1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,530
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إننا كذلك

25
00:02:13,110 --> 00:02:15,280
...لا أصدّق أنّك كنت ستموتين وحدك

26
00:02:15,280 --> 00:02:16,750
.هذا يفطر الفؤاد يا روبين-تشان

27
00:02:17,930 --> 00:02:22,210
لا أريد رؤية المزيد من النّاس
!يضحّون بأنفسهم بعد الآن

28
00:02:30,670 --> 00:02:34,010
لا أستطيع التّفكير في أيّ سبب
!قد يدفعك لتكون لطيفًا معي

29
00:02:35,800 --> 00:02:39,010
!لماذا؟ لماذا فعلتَ ذلك؟

30
00:02:43,140 --> 00:02:47,140
!يقوّي الفراق شخصيّة الرّجل"
"!سانجي وتشوبّر

31
00:02:59,530 --> 00:03:01,440
ماذا حدث لساقك؟

32
00:03:03,050 --> 00:03:07,290
بدون تلك السّاق، لن تستطيع
!أن تكون قرصانًا بعد الآن

33
00:03:07,290 --> 00:03:08,710
...ذلك صحيح

34
00:03:09,830 --> 00:03:13,000
!لماذا؟ لم أطلب مساعدتك

35
00:03:13,000 --> 00:03:16,290
لا أستطيع التّفكير في أيّ سبب
!قد يدفعك لتكون لطيفًا معي

36
00:03:18,090 --> 00:03:20,970
!لماذا؟ لماذا فعلتَ ذلك؟

37
00:03:20,970 --> 00:03:22,840
...لأنّك

38
00:03:23,430 --> 00:03:27,270
.تملك نفس حلمي

39
00:03:29,230 --> 00:03:30,740
...الأزرق الكامل

40
00:03:32,110 --> 00:03:35,990
لكن... حتّى رجالك قالوا
...أنّه غير موجود

41
00:03:35,990 --> 00:03:37,080
!بالطّبع هو موجود

42
00:03:37,710 --> 00:03:41,030
اتّجه صوب الغراند لاين
.عندما يحين الوقت المناسب

43
00:03:41,030 --> 00:03:44,580
.الأزرق الكامل موجود بالفعل هناك

44
00:03:44,580 --> 00:03:50,760
،كما ترى، ما عدتُ أستطيع أن أكون قرصانًا
.لكن بإمكانك أنت الذّهاب وإيجاده هذه المرّة

45
00:03:53,210 --> 00:03:55,380
!مهلاً! لا تمت أيّها العجوز

46
00:03:55,380 --> 00:03:59,630
لا تفعل ما يحلو لك
!ولا تمت كما يحلو لك

47
00:04:01,930 --> 00:04:08,360
تخلّى ذلك العجوز اللّعين
.عن ساقه لأعيش أنا

48
00:04:08,810 --> 00:04:09,990
!ماذا؟

49
00:04:12,230 --> 00:04:13,960
...أنا

50
00:04:14,480 --> 00:04:19,410
لا أستطيع ردّ جميل العجوز اللّعين
!إلاّ إذا خاطرتُ بحياتي من أجله أيضًا

51
00:04:25,290 --> 00:04:27,750
!الموت ليس أمرًا تردّ به الجميل

52
00:04:28,580 --> 00:04:31,000
!لم ينقذك لذلك السّبب

53
00:04:31,920 --> 00:04:36,960
...الموت بعد فرصة ثانية لتعيش
!أمر يفعله الضّعفاء فحسب

54
00:04:36,960 --> 00:04:39,690
هل هنالك أيّ طريقة أخرى
!لحلّ هذه المسألة؟

55
00:04:47,040 --> 00:04:48,030
!أيّها العامل

56
00:05:05,740 --> 00:05:07,540
...أيّها العامل

57
00:05:07,540 --> 00:05:08,630
!هل أنت بخير؟

58
00:05:10,340 --> 00:05:12,160
...لم أكتفِ بعد

59
00:05:12,160 --> 00:05:16,600
.إنّك تُغضبني
.لن أدعك تموت بسهولة

60
00:05:24,550 --> 00:05:29,470
سُحقًا! يُخرج ذلك الوغد كريغ
...سلاحًا تلو الآخر

61
00:05:29,470 --> 00:05:31,070
من المستحيل أن يستطيع
...ذلك العامل أن

62
00:05:31,520 --> 00:05:35,150
،مهما كثرت الأسلحة الّتي بحوزته

63
00:05:35,150 --> 00:05:40,030
بالإمكان أن يُهزم على يد شخص
.يملك رمح عزيمة عمياء

64
00:05:50,240 --> 00:05:53,000
...الحياة أو الموت

65
00:05:53,000 --> 00:05:58,750
في معركة قراصنة، إن خشيتَ الموت
.ولو للحظة، فستُهزم

66
00:05:58,750 --> 00:06:00,140
عمّ تتحدّث؟

67
00:06:11,220 --> 00:06:12,690
...على الأقلّ

68
00:06:16,350 --> 00:06:21,120
!لا أرى ذرّة تردّد في ذلك الفتى

69
00:06:22,280 --> 00:06:25,040
أهي غريزة البقاء؟

70
00:06:27,450 --> 00:06:30,340
أم أنّه لا يخشى الموت
لأنّ لديه ثقة في نفسه؟

71
00:06:33,370 --> 00:06:34,670
...ثقة

72
00:06:40,750 --> 00:06:44,550
...الأسطول الّذي جمعه كريغ

73
00:06:44,550 --> 00:06:46,850
...أسلحته العديدة وسمّه
...إن كان كلّ ذلك قوّته

74
00:06:50,950 --> 00:06:56,030
...فرمح ذلك الفتى قوّة أيضًا

75
00:06:57,730 --> 00:07:00,610
...رمح يحمله في قلبه

76
00:07:01,610 --> 00:07:08,210
أعرف غبيًّا يخفي ذلك الرّمح
...لسبب غبيّ

77
00:07:19,250 --> 00:07:20,310
!ماذا؟

78
00:07:20,920 --> 00:07:24,610
!سأنهي الأمر بهذا... بالتّأكيد

79
00:07:29,690 --> 00:07:32,660
...فاكهة المطّاط

80
00:07:42,570 --> 00:07:44,290
!المطرقة العملاقة

81
00:07:56,500 --> 00:07:57,420
!مهلاً

82
00:07:58,750 --> 00:08:02,000
.لكلينا أحلام سخيفة

83
00:08:05,590 --> 00:08:09,810
،ولكي أصل إلى هدفي
...الأزرق الكامل

84
00:08:10,940 --> 00:08:11,810
سانجي؟

85
00:08:12,970 --> 00:08:17,270
صحيح. سأرافقك... في رحلتك
!"لتصبح "ملك القراصنة

86
00:08:19,810 --> 00:08:22,750
.سأصبح الطّبّاخ في سفينتك

87
00:08:27,940 --> 00:08:29,580
أموافق أم لا؟

88
00:08:30,400 --> 00:08:33,030
!بالطّبع موافق! أجل

89
00:08:33,030 --> 00:08:34,910
!سعيد لأجلك يا أخي الكبير لوفي

90
00:08:34,910 --> 00:08:35,870
!أجل

91
00:08:35,870 --> 00:08:40,160
!مرحى! مرحى! لدينا طبّاخ
!سنتناول طعامًا لذيذًا

92
00:08:40,160 --> 00:08:41,520
.هكذا هو الأمر يا رفاق

93
00:08:43,000 --> 00:08:45,440
آسف على كلّ المشاكل
.الّتي تسبّبتها لكم

94
00:08:46,430 --> 00:08:51,680
!لا يعجبني هذا! أردتُ طردك بنفسي

95
00:08:51,680 --> 00:08:54,690
وقرّرتَ هذا بكلّ سهولة؟

96
00:08:56,010 --> 00:08:59,660
.آسف لدفعك للّجوء للتّمثيل السّيّئ

97
00:08:59,980 --> 00:09:01,730
!كنتَ تعرف؟

98
00:09:01,730 --> 00:09:04,480
سمعتُ كلّ شيء بما أنّ الغباء
.مسيطر عليكم جميعًا

99
00:09:04,480 --> 00:09:05,320
!ماذا؟

100
00:09:05,950 --> 00:09:11,250
،كنتَ عازمًا لتلك الدّرجة على طردي
صحيح أيّها العجوز اللّعين؟

101
00:09:11,800 --> 00:09:16,660
لماذا عليك التّكلّم هكذا
!دائمًا أيّها الوغد؟

102
00:09:18,260 --> 00:09:21,040
!هذا صحيح أيّها الشّقيّ الصّغير

103
00:09:21,040 --> 00:09:23,830
.لا أحبّ الأطفال من الأساس

104
00:09:23,830 --> 00:09:28,730
لم يمرّ يوم لم أندم فيه على السّماح
.لشقيّ صغير مثلك أن يعيش

105
00:09:29,520 --> 00:09:32,050
!ذلك يلائمني أيّها العجوز اللّعين

106
00:09:32,050 --> 00:09:34,730
.استمتع ببقيّة حياتك حتّى آخرها

107
00:09:41,730 --> 00:09:45,060
.مذهل! إنّه قارب جيّد
هل يمكننا أخذه بالفعل؟

108
00:09:45,060 --> 00:09:47,250
.بالطّبع! إنّه قارب سانجي

109
00:09:49,570 --> 00:09:50,900
.لنذهب

110
00:09:50,900 --> 00:09:52,580
ألن تقول وداعًا؟

111
00:09:53,360 --> 00:09:54,410
.لا بأس

112
00:09:54,410 --> 00:09:55,580
!سانجي

113
00:09:56,410 --> 00:09:59,060
.احذر أن تصاب بزكام

114
00:10:56,840 --> 00:10:58,980
!أيّها المالك زيف

115
00:11:00,430 --> 00:11:05,140
شكرًا على كلّ شيء لعين فعلته
!من أجلي طوال هذه السّنوات

116
00:11:05,140 --> 00:11:09,190
!لن أنسى لطفك أبدًا... ما حييت

117
00:11:29,840 --> 00:11:32,430
!أيّها الوغد

118
00:11:34,670 --> 00:11:37,670
!سأشتاق إليك أيّها الوغد

119
00:11:37,670 --> 00:11:39,350
!سأشتاق إليك

120
00:11:53,730 --> 00:11:55,360
!سنشتاق لك

121
00:11:55,360 --> 00:11:57,400
!أحزنتني، اللّعنة عليك

122
00:12:04,790 --> 00:12:05,960
!أغبياء

123
00:12:07,560 --> 00:12:10,730
.يفترق الرّجال دون التّفوّه بكلمة

124
00:12:17,900 --> 00:12:20,770
!هيّا! فلنبدأ إبحارنا

125
00:12:20,910 --> 00:12:24,510
!سألقاكم ثانية أيّها الأوغاد الملاعين

126
00:12:36,670 --> 00:12:40,500
ما دمتَ لا تخشى حتّى الموت
،بسبب ثقتك في نفسك

127
00:12:42,740 --> 00:12:48,270
...فستجد الأزرق الكامل... بكلّ تأكيد

128
00:12:51,040 --> 00:12:54,380
!يا رجال! سيأتي الزّبائن قريبًا

129
00:12:54,380 --> 00:12:56,940
!عودوا للعمل بسرعة

130
00:13:19,030 --> 00:13:23,910
كانت روبين وحيدة طوال
.هذا الوقت... مثلي تمامًا

131
00:13:25,370 --> 00:13:29,010
هل أُصبت بطلقة؟ علينا أن نوقف
!النّزيف فورًا وإلاّ ستموت

132
00:13:33,960 --> 00:13:36,590
!يمكنك ذلك! يمكنك ذلك

133
00:13:36,590 --> 00:13:40,630
...يمكنك! يمكنك أن تصبح طبيبًا عظيمًا

134
00:13:40,630 --> 00:13:43,470
...دكتـ... لا أستطيع التنفّس

135
00:13:43,470 --> 00:13:46,110
...لأنّك تملك قلبًا طيّبًا

136
00:13:46,930 --> 00:13:52,610
أتساءل إن كان لروبين شخص
...مثل الدّكتور

137
00:13:54,520 --> 00:13:57,570
هنالك بعض المخلوقات
.الغريبة في هذا العالم حقًّا

138
00:13:57,980 --> 00:14:01,690
لا بدّ أنّك عشت حياتك
.كلّها منبوذًا من الجميع

139
00:14:01,690 --> 00:14:07,200
يا لك من وحشٍ مسكين. لِمَ قد
يريد وحيدٌ مثلك إنقاذ هذه البلاد؟

140
00:14:07,200 --> 00:14:08,450
!لا تدفعني للضّحك

141
00:14:08,450 --> 00:14:13,180
اخرس! حتّى إن كنت لا أملك
!أصدقاء، ما زال يمكنني أن أقاتل

142
00:14:14,000 --> 00:14:17,000
...ما دام علَم الدّكتور موجودًا، سوف

143
00:14:17,000 --> 00:14:18,520
!بل تملك أصدقاء

144
00:14:21,800 --> 00:14:25,440
!أنا صديقك

145
00:14:35,270 --> 00:14:39,020
!لنكن قراصنة سويًّا

146
00:14:40,020 --> 00:14:41,150
.ذلك غير ممكن

147
00:14:41,150 --> 00:14:43,860
!بلى ممكن، بما أنّه ممتع

148
00:14:43,860 --> 00:14:45,210
.اسمع، كلامك غير منطقيّ

149
00:14:47,240 --> 00:14:48,320
...لكن

150
00:14:51,030 --> 00:14:55,440
...لكنّي رنّة! أملك قرنين وحوافر

151
00:14:56,830 --> 00:14:58,180
!حتّى أنّني أملك أنفًا أزرقًا

152
00:15:00,380 --> 00:15:03,780
صحيح أنّني أريد أن أكون
...قرصانًا، لكن

153
00:15:06,380 --> 00:15:10,470
!لستُ إنسانًا حتّى! أنا وحش

154
00:15:10,470 --> 00:15:14,260
...لا يمكنني أن أصبح صديقكم! لذا

155
00:15:15,560 --> 00:15:17,280
...لذا أتيت لأشكركم فقط

156
00:15:20,400 --> 00:15:23,360
.أقدّر ما فعلتموه حقًّا

157
00:15:23,360 --> 00:15:26,000
.وشكرًا على طلبكم منّي الانضمام لكم

158
00:15:30,200 --> 00:15:32,330
...سأظلّ هنا، لكن

159
00:15:35,290 --> 00:15:37,930
،يومًا ما... إن أردتم
...تعالوا لزيارتنا مجدّ

160
00:15:38,120 --> 00:15:41,850
!اخرس! لنذهب

161
00:15:53,640 --> 00:15:56,020
لا تطلب من الآخرين الانضمام
.بإخبارهم أن يخرسوا

162
00:16:08,780 --> 00:16:12,070
!كان ذلك شعورًا جيّدًا! افعلها ثانيةً

163
00:16:12,070 --> 00:16:13,950
!أيّها الغبيّ! سنبحر على الفور

164
00:16:13,950 --> 00:16:15,830
...ظـ-ظننتني سأموت

165
00:16:15,830 --> 00:16:18,040
ماذا؟ أين أنا؟

166
00:16:18,040 --> 00:16:21,090
سانجي-سان! هل أفقت؟

167
00:16:23,210 --> 00:16:26,420
!أيّها الدكتور! لم يكن مجرّد خيال، صحيح؟

168
00:16:26,420 --> 00:16:29,620
!أكملت بحثك حينئذٍ، صحيح؟

169
00:16:30,630 --> 00:16:32,760
أم أنّها كانت كذبة أيضًا؟

170
00:16:33,260 --> 00:16:37,160
!نجحت يا تشوبّر! نجح بحثي

171
00:16:37,160 --> 00:16:41,270
هل كذبت لأنّي سأحزن
إن متَّ دون قول ذلك؟

172
00:16:43,980 --> 00:16:46,130
!ردّد ذلك ثانيةً رجاءً يا دكتور

173
00:16:50,950 --> 00:16:53,080
!هل أنتم مستعدّون يا رجال؟

174
00:16:53,530 --> 00:16:54,340
!نعم

175
00:16:54,340 --> 00:16:55,460
!أطلقوا

176
00:16:56,450 --> 00:16:58,930
...اسمعي يا كوريها. هذا الغبار

177
00:17:03,920 --> 00:17:06,170
!أيّتها الطّبيبة كوريها
!ما الّذي يجري...؟

178
00:17:06,170 --> 00:17:07,520
.اخرس وشاهد فحسب

179
00:17:11,840 --> 00:17:14,550
!أيّتها الطّبيبة كوريها! لقد أطلقناها كلّها

180
00:17:14,550 --> 00:17:15,860
!اشتعلي

181
00:17:27,070 --> 00:17:28,820
...مذهل

182
00:17:28,820 --> 00:17:29,790
...أجل

183
00:17:31,070 --> 00:17:32,260
...يا لجمالها

184
00:17:34,490 --> 00:17:36,870
!سأجعل أزهار الكرز تزهر

185
00:17:36,870 --> 00:17:40,910
،فور أن يكتمل اختراعي
!سأنقذ هذه البلاد

186
00:17:41,910 --> 00:17:46,080
.اسمعي. هذا الغبار الأحمر ليست غبارًا عاديًّا

187
00:17:46,080 --> 00:17:51,050
سوف يلتصق بالثّلج الأبيض في الهواء

188
00:17:51,050 --> 00:17:53,940
.ويصنع تساقط ثلج ورديّ زاهٍ

189
00:18:00,640 --> 00:18:01,970
!...دكتور

190
00:18:02,930 --> 00:18:04,770
!...دكتورين

191
00:18:39,600 --> 00:18:41,930
!لن أطلق عليك أبدًا

192
00:18:41,930 --> 00:18:45,160
!اسمي الدّكتور هيرولوك! أنا طبيب

193
00:18:46,100 --> 00:18:51,120
،توني توني تشوبّر. إنّه اسمٌ رائع
.أليس كذلك؟ هكذا سأناديك

194
00:18:51,650 --> 00:18:56,120
تشوبّر، ستتمكّن من أن تصبح
.طبيبًا جيّدًا. أضمن لك ذلك

195
00:19:02,770 --> 00:19:06,010
.حتّى وإن اختفيت، سوف يتحقّق حلمي

196
00:19:06,010 --> 00:19:08,550
!لقد عشتُ... حياةً جيّدة

197
00:19:12,550 --> 00:19:15,020
!شكرًا لك يا تشوبّر

198
00:19:24,850 --> 00:19:29,400
والآن، رافقتك السّلامة
...في رحلتك يا بنيّ الغبيّ

199
00:19:36,650 --> 00:19:37,610
!...روبين

200
00:19:38,360 --> 00:19:40,840
!ما عدتِ وحدك بعد الآن، أتفهمين؟

201
00:19:41,910 --> 00:19:44,800
!سننقذك بكلّ تأكيد، انتظري فحسب

202
00:19:52,630 --> 00:19:53,860
أهذا صوت القطار البحريّ؟

203
00:20:09,100 --> 00:20:10,530
!لننطلق

204
00:20:11,380 --> 00:20:12,370
!عرفتُ هذا

205
00:20:36,210 --> 00:20:37,230
.أشعر بالملل

206
00:20:37,230 --> 00:20:38,230
.نعم

207
00:20:40,090 --> 00:20:43,400
!أحضروا لي بعض اللّحم وإلاّ قتلتكم جميعًا

208
00:20:43,680 --> 00:20:46,470
أسألتم لماذا أدخّن؟

209
00:20:46,470 --> 00:20:48,980
!لأنّ الهواء في هذا العالم مقرف

210
00:20:51,640 --> 00:20:54,860
...استدعيتكما إلى هنا اليوم لسبب واحد

211
00:20:54,860 --> 00:20:57,940
أعتقد أنّ الوقت حان لنوضّح من هو
!الزّعيم في هذه البلدة بشكل نهائيّ

212
00:20:57,940 --> 00:20:59,110
!إنّه أنّا أيّها الوغد

213
00:20:59,110 --> 00:21:01,080
!مستحيل، يدرك أيّ غبيّ أنّه أنا

214
00:21:05,280 --> 00:21:08,950
سانجينو، إنّ أبلهًا لا يمشط
حتّى شعره للخلف مثلك

215
00:21:08,950 --> 00:21:10,660
.ليس مؤهّلاً حتّى ليكون الزّعيم

216
00:21:10,660 --> 00:21:13,510
لديّ أسبابي، أهذا مفهوم؟! إنّه ممشوط
!للخلف من جانب واحد، ألا ترى؟

217
00:21:14,170 --> 00:21:17,270
جانب واحد؟! لا تضحكني! ذلك أشبه
!بقول أنّ لديك خصية واحدة

218
00:21:17,550 --> 00:21:18,600
!ماذا قلت؟

219
00:21:18,600 --> 00:21:22,340
!زاد الأمر عن حدّه! إنّها حرب شاملة

220
00:21:22,340 --> 00:21:25,420
!على أيّ أساس تبدأ حربًا شاملة؟

221
00:21:25,420 --> 00:21:26,650
.إنّها الحرب في كلّ الأحوال

222
00:21:26,930 --> 00:21:28,600
.أذقه طعم الرّصاص يا أوسوتويا

223
00:21:28,600 --> 00:21:31,330
.سأقضي على زوروشيا

224
00:21:33,270 --> 00:21:36,100
!فشل أوسوتويا

225
00:21:38,360 --> 00:21:40,780
اذهب واقضِ على لوفيوني
!بينما لا يملك رجالًا يحموه

226
00:21:40,780 --> 00:21:43,170
.سأقضي على لوفيوني

227
00:21:44,820 --> 00:21:47,490
!فشل تشوبّاليني

228
00:21:49,910 --> 00:21:51,750
.اعرفي عدوّك جيّدًا يا ناميموري

229
00:21:51,750 --> 00:21:53,350
.سأقضي على سانجينو

230
00:21:54,560 --> 00:21:55,390
!يا أمّي

231
00:21:55,790 --> 00:21:59,010
!قُضي على عائلة سانجينو

232
00:22:00,130 --> 00:22:01,800
أين الخزنة الآن؟

233
00:22:02,800 --> 00:22:05,060
!أجل! كان غنيًّا بالفعل

234
00:22:06,050 --> 00:22:08,720
!فشلت ناميموري

235
00:22:10,720 --> 00:22:13,730
.حسنًا. لكنّها قتلت سانجينو على الأقلّ

236
00:22:13,730 --> 00:22:16,610
.روبيتا، اقضي على لوفيوني

237
00:22:16,610 --> 00:22:17,490
.لستُ مهتمّة بذلك

238
00:22:17,490 --> 00:22:18,030
!ماذا؟

239
00:22:19,730 --> 00:22:22,360
!تعرّض زوروشيا للخيانة

240
00:22:25,320 --> 00:22:27,280
!كلاّ! اطلقا على بعضهما

241
00:22:26,200 --> 00:22:31,170
روبيتا من عائلة زوروشيا ماتت
."وهي تفكّر "لم يكن يفترض أن يحدث هذا

242
00:22:27,280 --> 00:22:29,890
!فشلت روبيتا

243
00:22:33,000 --> 00:22:34,750
!أجل، أنا الزّعيم

244
00:22:34,750 --> 00:22:38,510
أستطيع الآن أكل كلّ ما أريده
!من اللّحم في هذه البلدة

245
00:22:41,760 --> 00:22:43,670
...ما الّذي

246
00:22:43,670 --> 00:22:46,940
لا أصدّق أنّ طعم اللّحم فظيع
...عند أكله بمفردي

247
00:22:47,390 --> 00:22:53,550
إنّني... أدركت أخيرًا الآن
...ما هو أهمّ شيء في الحياة

248
00:22:54,430 --> 00:22:57,350
...أشعر بالوحدة... أشعر بالوحدة

249
00:22:57,350 --> 00:22:59,370
.إن كان هذا حلمًا، فأريد أن أستيقظ

250
00:23:00,650 --> 00:23:01,660
.كان حلمًا

251
00:23:01,660 --> 00:23:03,780
!ومن تكون أنت؟! وكان حلمًا بالفعل؟

252
00:23:11,600 --> 00:23:14,090
،كلّما رغبت في البقاء أكثر معهم
.زادت معاناتهم بسببي

253
00:23:15,450 --> 00:23:17,390
.ظننتُ أمرًا ما كنت لأجرأ على تمنّيه

254
00:23:18,830 --> 00:23:19,510
...لكن يا ساول

255
00:23:20,690 --> 00:23:22,310
.كنتَ على حقّ

256
00:23:22,930 --> 00:23:26,190
!استطعت أن ألتقي بأصدقاء سيحمونني

257
00:23:26,810 --> 00:23:28,150
:في الحلقة القادمة من وان بيس

258
00:23:28,350 --> 00:23:32,060
!كلّ شيء من أجل أصدقائها"
"!الظّلمة بداخل روبين

259
00:23:32,070 --> 00:23:34,170
!ملك القراصنة، لن يكون إلاّ أنا

260
00:23:36,070 --> 00:23:41,120
نلقاكم في الحلقة القادمة