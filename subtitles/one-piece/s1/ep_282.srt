1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,530
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إننا كذلك

25
00:02:27,110 --> 00:02:29,280
...لا أصدّق أنّك كنت ستموتين وحدك

26
00:02:29,280 --> 00:02:30,750
.هذا يفطر الفؤاد يا روبين-تشان

27
00:02:31,930 --> 00:02:36,210
لا أريد رؤية المزيد من النّاس
!يضحّون بأنفسهم بعد الآن

28
00:02:44,670 --> 00:02:48,010
لا أستطيع التّفكير في أيّ سبب
!قد يدفعك لتكون لطيفًا معي

29
00:02:49,800 --> 00:02:53,010
!لماذا؟ لماذا فعلتَ ذلك؟

30
00:02:57,140 --> 00:03:01,140
!يقوّي الفراق شخصيّة الرّجل"
"!سانجي وتشوبّر

31
00:03:13,530 --> 00:03:15,440
ماذا حدث لساقك؟

32
00:03:17,050 --> 00:03:21,290
بدون تلك السّاق، لن تستطيع
!أن تكون قرصانًا بعد الآن

33
00:03:21,290 --> 00:03:22,710
...ذلك صحيح

34
00:03:23,830 --> 00:03:27,000
!لماذا؟ لم أطلب مساعدتك

35
00:03:27,000 --> 00:03:30,290
لا أستطيع التّفكير في أيّ سبب
!قد يدفعك لتكون لطيفًا معي

36
00:03:32,090 --> 00:03:34,970
!لماذا؟ لماذا فعلتَ ذلك؟

37
00:03:34,970 --> 00:03:36,840
...لأنّك

38
00:03:37,430 --> 00:03:41,270
.تملك نفس حلمي

39
00:03:43,230 --> 00:03:44,740
...الأزرق الكامل

40
00:03:46,110 --> 00:03:49,990
لكن... حتّى رجالك قالوا
...أنّه غير موجود

41
00:03:49,990 --> 00:03:51,080
!بالطّبع هو موجود

42
00:03:51,710 --> 00:03:55,030
اتّجه صوب الغراند لاين
.عندما يحين الوقت المناسب

43
00:03:55,030 --> 00:03:58,580
.الأزرق الكامل موجود بالفعل هناك

44
00:03:58,580 --> 00:04:04,760
،كما ترى، ما عدتُ أستطيع أن أكون قرصانًا
.لكن بإمكانك أنت الذّهاب وإيجاده هذه المرّة

45
00:04:07,210 --> 00:04:09,380
!مهلاً! لا تمت أيّها العجوز

46
00:04:09,380 --> 00:04:13,630
لا تفعل ما يحلو لك
!ولا تمت كما يحلو لك

47
00:04:15,930 --> 00:04:22,360
تخلّى ذلك العجوز اللّعين
.عن ساقه لأعيش أنا

48
00:04:22,810 --> 00:04:23,990
!ماذا؟

49
00:04:26,230 --> 00:04:27,960
...أنا

50
00:04:28,480 --> 00:04:33,410
لا أستطيع ردّ جميل العجوز اللّعين
!إلاّ إذا خاطرتُ بحياتي من أجله أيضًا

51
00:04:39,290 --> 00:04:41,750
!الموت ليس أمرًا تردّ به الجميل

52
00:04:42,580 --> 00:04:45,000
!لم ينقذك لذلك السّبب

53
00:04:45,920 --> 00:04:50,960
...الموت بعد فرصة ثانية لتعيش
!أمر يفعله الضّعفاء فحسب

54
00:04:50,960 --> 00:04:53,690
هل هنالك أيّ طريقة أخرى
!لحلّ هذه المسألة؟

55
00:05:01,040 --> 00:05:02,030
!أيّها العامل

56
00:05:19,740 --> 00:05:21,540
...أيّها العامل

57
00:05:21,540 --> 00:05:22,630
!هل أنت بخير؟

58
00:05:24,340 --> 00:05:26,160
...لم أكتفِ بعد

59
00:05:26,160 --> 00:05:30,600
.إنّك تُغضبني
.لن أدعك تموت بسهولة

60
00:05:38,550 --> 00:05:43,470
سُحقًا! يُخرج ذلك الوغد كريغ
...سلاحًا تلو الآخر

61
00:05:43,470 --> 00:05:45,070
من المستحيل أن يستطيع
...ذلك العامل أن

62
00:05:45,520 --> 00:05:49,150
،مهما كثرت الأسلحة الّتي بحوزته

63
00:05:49,150 --> 00:05:54,030
بالإمكان أن يُهزم على يد شخص
.يملك رمح عزيمة عمياء

64
00:06:04,240 --> 00:06:07,000
...الحياة أو الموت

65
00:06:07,000 --> 00:06:12,750
في معركة قراصنة، إن خشيتَ الموت
.ولو للحظة، فستُهزم

66
00:06:12,750 --> 00:06:14,140
عمّ تتحدّث؟

67
00:06:25,220 --> 00:06:26,690
...على الأقلّ

68
00:06:30,350 --> 00:06:35,120
!لا أرى ذرّة تردّد في ذلك الفتى

69
00:06:36,280 --> 00:06:39,040
أهي غريزة البقاء؟

70
00:06:41,450 --> 00:06:44,340
أم أنّه لا يخشى الموت
لأنّ لديه ثقة في نفسه؟

71
00:06:47,370 --> 00:06:48,670
...ثقة

72
00:06:54,750 --> 00:06:58,550
...الأسطول الّذي جمعه كريغ

73
00:06:58,550 --> 00:07:00,850
...أسلحته العديدة وسمّه
...إن كان كلّ ذلك قوّته

74
00:07:04,950 --> 00:07:10,030
...فرمح ذلك الفتى قوّة أيضًا

75
00:07:11,730 --> 00:07:14,610
...رمح يحمله في قلبه

76
00:07:15,610 --> 00:07:22,210
أعرف غبيًّا يخفي ذلك الرّمح
...لسبب غبيّ

77
00:07:33,250 --> 00:07:34,310
!ماذا؟

78
00:07:34,920 --> 00:07:38,610
!سأنهي الأمر بهذا... بالتّأكيد

79
00:07:43,690 --> 00:07:46,660
...فاكهة المطّاط

80
00:07:56,570 --> 00:07:58,290
!المطرقة العملاقة

81
00:08:10,500 --> 00:08:11,420
!مهلاً

82
00:08:12,750 --> 00:08:16,000
.لكلينا أحلام سخيفة

83
00:08:19,590 --> 00:08:23,810
،ولكي أصل إلى هدفي
...الأزرق الكامل

84
00:08:24,940 --> 00:08:25,810
سانجي؟

85
00:08:26,970 --> 00:08:31,270
صحيح. سأرافقك... في رحلتك
!"لتصبح "ملك القراصنة

86
00:08:33,810 --> 00:08:36,750
.سأصبح الطّبّاخ في سفينتك

87
00:08:41,940 --> 00:08:43,580
أموافق أم لا؟

88
00:08:44,400 --> 00:08:47,030
!بالطّبع موافق! أجل

89
00:08:47,030 --> 00:08:48,910
!سعيد لأجلك يا أخي الكبير لوفي

90
00:08:48,910 --> 00:08:49,870
!أجل

91
00:08:49,870 --> 00:08:54,160
!مرحى! مرحى! لدينا طبّاخ
!سنتناول طعامًا لذيذًا

92
00:08:54,160 --> 00:08:55,520
.هكذا هو الأمر يا رفاق

93
00:08:57,000 --> 00:08:59,440
آسف على كلّ المشاكل
.الّتي تسبّبتها لكم

94
00:09:00,430 --> 00:09:05,680
!لا يعجبني هذا! أردتُ طردك بنفسي

95
00:09:05,680 --> 00:09:08,690
وقرّرتَ هذا بكلّ سهولة؟

96
00:09:10,010 --> 00:09:13,660
.آسف لدفعك للّجوء للتّمثيل السّيّئ

97
00:09:13,980 --> 00:09:15,730
!كنتَ تعرف؟

98
00:09:15,730 --> 00:09:18,480
سمعتُ كلّ شيء بما أنّ الغباء
.مسيطر عليكم جميعًا

99
00:09:18,480 --> 00:09:19,320
!ماذا؟

100
00:09:19,950 --> 00:09:25,250
،كنتَ عازمًا لتلك الدّرجة على طردي
صحيح أيّها العجوز اللّعين؟

101
00:09:25,800 --> 00:09:30,660
لماذا عليك التّكلّم هكذا
!دائمًا أيّها الوغد؟

102
00:09:32,260 --> 00:09:35,040
!هذا صحيح أيّها الشّقيّ الصّغير

103
00:09:35,040 --> 00:09:37,830
.لا أحبّ الأطفال من الأساس

104
00:09:37,830 --> 00:09:42,730
لم يمرّ يوم لم أندم فيه على السّماح
.لشقيّ صغير مثلك أن يعيش

105
00:09:43,520 --> 00:09:46,050
!ذلك يلائمني أيّها العجوز اللّعين

106
00:09:46,050 --> 00:09:48,730
.استمتع ببقيّة حياتك حتّى آخرها

107
00:09:55,730 --> 00:09:59,060
.مذهل! إنّه قارب جيّد
هل يمكننا أخذه بالفعل؟

108
00:09:59,060 --> 00:10:01,250
.بالطّبع! إنّه قارب سانجي

109
00:10:03,570 --> 00:10:04,900
.لنذهب

110
00:10:04,900 --> 00:10:06,580
ألن تقول وداعًا؟

111
00:10:07,360 --> 00:10:08,410
.لا بأس

112
00:10:08,410 --> 00:10:09,580
!سانجي

113
00:10:10,410 --> 00:10:13,060
.احذر أن تصاب بزكام

114
00:11:10,840 --> 00:11:12,980
!أيّها المالك زيف

115
00:11:14,430 --> 00:11:19,140
شكرًا على كلّ شيء لعين فعلته
!من أجلي طوال هذه السّنوات

116
00:11:19,140 --> 00:11:23,190
!لن أنسى لطفك أبدًا... ما حييت

117
00:11:43,840 --> 00:11:46,430
!أيّها الوغد

118
00:11:48,670 --> 00:11:51,670
!سأشتاق إليك أيّها الوغد

119
00:11:51,670 --> 00:11:53,350
!سأشتاق إليك

120
00:12:07,730 --> 00:12:09,360
!سنشتاق لك

121
00:12:09,360 --> 00:12:11,400
!أحزنتني، اللّعنة عليك

122
00:12:18,790 --> 00:12:19,960
!أغبياء

123
00:12:21,560 --> 00:12:24,730
.يفترق الرّجال دون التّفوّه بكلمة

124
00:12:31,900 --> 00:12:34,770
!هيّا! فلنبدأ إبحارنا

125
00:12:34,910 --> 00:12:38,510
!سألقاكم ثانية أيّها الأوغاد الملاعين

126
00:12:50,670 --> 00:12:54,500
ما دمتَ لا تخشى حتّى الموت
،بسبب ثقتك في نفسك

127
00:12:56,740 --> 00:13:02,270
...فستجد الأزرق الكامل... بكلّ تأكيد

128
00:13:05,040 --> 00:13:08,380
!يا رجال! سيأتي الزّبائن قريبًا

129
00:13:08,380 --> 00:13:10,940
!عودوا للعمل بسرعة

130
00:13:33,030 --> 00:13:37,910
كانت روبين وحيدة طوال
.هذا الوقت... مثلي تمامًا

131
00:13:39,370 --> 00:13:43,010
هل أُصبت بطلقة؟ علينا أن نوقف
!النّزيف فورًا وإلاّ ستموت

132
00:13:47,960 --> 00:13:50,590
!يمكنك ذلك! يمكنك ذلك

133
00:13:50,590 --> 00:13:54,630
...يمكنك! يمكنك أن تصبح طبيبًا عظيمًا

134
00:13:54,630 --> 00:13:57,470
...دكتـ... لا أستطيع التنفّس

135
00:13:57,470 --> 00:14:00,110
...لأنّك تملك قلبًا طيّبًا

136
00:14:00,930 --> 00:14:06,610
أتساءل إن كان لروبين شخص
...مثل الدّكتور

137
00:14:08,520 --> 00:14:11,570
هنالك بعض المخلوقات
.الغريبة في هذا العالم حقًّا

138
00:14:11,980 --> 00:14:15,690
لا بدّ أنّك عشت حياتك
.كلّها منبوذًا من الجميع

139
00:14:15,690 --> 00:14:21,200
يا لك من وحشٍ مسكين. لِمَ قد
يريد وحيدٌ مثلك إنقاذ هذه البلاد؟

140
00:14:21,200 --> 00:14:22,450
!لا تدفعني للضّحك

141
00:14:22,450 --> 00:14:27,180
اخرس! حتّى إن كنت لا أملك
!أصدقاء، ما زال يمكنني أن أقاتل

142
00:14:28,000 --> 00:14:31,000
...ما دام علَم الدّكتور موجودًا، سوف

143
00:14:31,000 --> 00:14:32,520
!بل تملك أصدقاء

144
00:14:35,800 --> 00:14:39,440
!أنا صديقك

145
00:14:49,270 --> 00:14:53,020
!لنكن قراصنة سويًّا

146
00:14:54,020 --> 00:14:55,150
.ذلك غير ممكن

147
00:14:55,150 --> 00:14:57,860
!بلى ممكن، بما أنّه ممتع

148
00:14:57,860 --> 00:14:59,210
.اسمع، كلامك غير منطقيّ

149
00:15:01,240 --> 00:15:02,320
...لكن

150
00:15:05,030 --> 00:15:09,440
...لكنّي رنّة! أملك قرنين وحوافر

151
00:15:10,830 --> 00:15:12,180
!حتّى أنّني أملك أنفًا أزرقًا

152
00:15:14,380 --> 00:15:17,780
صحيح أنّني أريد أن أكون
...قرصانًا، لكن

153
00:15:20,380 --> 00:15:24,470
!لستُ إنسانًا حتّى! أنا وحش

154
00:15:24,470 --> 00:15:28,260
...لا يمكنني أن أصبح صديقكم! لذا

155
00:15:29,560 --> 00:15:31,280
...لذا أتيت لأشكركم فقط

156
00:15:34,400 --> 00:15:37,360
.أقدّر ما فعلتموه حقًّا

157
00:15:37,360 --> 00:15:40,000
.وشكرًا على طلبكم منّي الانضمام لكم

158
00:15:44,200 --> 00:15:46,330
...سأظلّ هنا، لكن

159
00:15:49,290 --> 00:15:51,930
،يومًا ما... إن أردتم
...تعالوا لزيارتنا مجدّ

160
00:15:52,120 --> 00:15:55,850
!اخرس! لنذهب

161
00:16:07,640 --> 00:16:10,020
لا تطلب من الآخرين الانضمام
.بإخبارهم أن يخرسوا

162
00:16:22,780 --> 00:16:26,070
!كان ذلك شعورًا جيّدًا! افعلها ثانيةً

163
00:16:26,070 --> 00:16:27,950
!أيّها الغبيّ! سنبحر على الفور

164
00:16:27,950 --> 00:16:29,830
...ظـ-ظننتني سأموت

165
00:16:29,830 --> 00:16:32,040
ماذا؟ أين أنا؟

166
00:16:32,040 --> 00:16:35,090
سانجي-سان! هل أفقت؟

167
00:16:37,210 --> 00:16:40,420
!أيّها الدكتور! لم يكن مجرّد خيال، صحيح؟

168
00:16:40,420 --> 00:16:43,620
!أكملت بحثك حينئذٍ، صحيح؟

169
00:16:44,630 --> 00:16:46,760
أم أنّها كانت كذبة أيضًا؟

170
00:16:47,260 --> 00:16:51,160
!نجحت يا تشوبّر! نجح بحثي

171
00:16:51,160 --> 00:16:55,270
هل كذبت لأنّي سأحزن
إن متَّ دون قول ذلك؟

172
00:16:57,980 --> 00:17:00,130
!ردّد ذلك ثانيةً رجاءً يا دكتور

173
00:17:04,950 --> 00:17:07,080
!هل أنتم مستعدّون يا رجال؟

174
00:17:07,530 --> 00:17:08,340
!نعم

175
00:17:08,340 --> 00:17:09,460
!أطلقوا

176
00:17:10,450 --> 00:17:12,930
...اسمعي يا كوريها. هذا الغبار

177
00:17:17,920 --> 00:17:20,170
!أيّتها الطّبيبة كوريها
!ما الّذي يجري...؟

178
00:17:20,170 --> 00:17:21,520
.اخرس وشاهد فحسب

179
00:17:25,840 --> 00:17:28,550
!أيّتها الطّبيبة كوريها! لقد أطلقناها كلّها

180
00:17:28,550 --> 00:17:29,860
!اشتعلي

181
00:17:41,070 --> 00:17:42,820
...مذهل

182
00:17:42,820 --> 00:17:43,790
...أجل

183
00:17:45,070 --> 00:17:46,260
...يا لجمالها

184
00:17:48,490 --> 00:17:50,870
!سأجعل أزهار الكرز تزهر

185
00:17:50,870 --> 00:17:54,910
،فور أن يكتمل اختراعي
!سأنقذ هذه البلاد

186
00:17:55,910 --> 00:18:00,080
.اسمعي. هذا الغبار الأحمر ليست غبارًا عاديًّا

187
00:18:00,080 --> 00:18:05,050
سوف يلتصق بالثّلج الأبيض في الهواء

188
00:18:05,050 --> 00:18:07,940
.ويصنع تساقط ثلج ورديّ زاهٍ

189
00:18:14,640 --> 00:18:15,970
!...دكتور

190
00:18:16,930 --> 00:18:18,770
!...دكتورين

191
00:18:53,600 --> 00:18:55,930
!لن أطلق عليك أبدًا

192
00:18:55,930 --> 00:18:59,160
!اسمي الدّكتور هيرولوك! أنا طبيب

193
00:19:00,100 --> 00:19:05,120
،توني توني تشوبّر. إنّه اسمٌ رائع
.أليس كذلك؟ هكذا سأناديك

194
00:19:05,650 --> 00:19:10,120
تشوبّر، ستتمكّن من أن تصبح
.طبيبًا جيّدًا. أضمن لك ذلك

195
00:19:16,770 --> 00:19:20,010
.حتّى وإن اختفيت، سوف يتحقّق حلمي

196
00:19:20,010 --> 00:19:22,550
!لقد عشتُ... حياةً جيّدة

197
00:19:26,550 --> 00:19:29,020
!شكرًا لك يا تشوبّر

198
00:19:38,850 --> 00:19:43,400
والآن، رافقتك السّلامة
...في رحلتك يا بنيّ الغبيّ

199
00:19:50,650 --> 00:19:51,610
!...روبين

200
00:19:52,360 --> 00:19:54,840
!ما عدتِ وحدك بعد الآن، أتفهمين؟

201
00:19:55,910 --> 00:19:58,800
!سننقذك بكلّ تأكيد، انتظري فحسب

202
00:20:06,630 --> 00:20:07,860
أهذا صوت القطار البحريّ؟

203
00:20:23,100 --> 00:20:24,530
!لننطلق

204
00:20:25,380 --> 00:20:26,370
!عرفتُ هذا

205
00:20:50,210 --> 00:20:51,230
.أشعر بالملل

206
00:20:51,230 --> 00:20:52,230
.نعم

207
00:20:54,090 --> 00:20:57,400
!أحضروا لي بعض اللّحم وإلاّ قتلتكم جميعًا

208
00:20:57,680 --> 00:21:00,470
أسألتم لماذا أدخّن؟

209
00:21:00,470 --> 00:21:02,980
!لأنّ الهواء في هذا العالم مقرف

210
00:21:05,640 --> 00:21:08,860
...استدعيتكما إلى هنا اليوم لسبب واحد

211
00:21:08,860 --> 00:21:11,940
أعتقد أنّ الوقت حان لنوضّح من هو
!الزّعيم في هذه البلدة بشكل نهائيّ

212
00:21:11,940 --> 00:21:13,110
!إنّه أنّا أيّها الوغد

213
00:21:13,110 --> 00:21:15,080
!مستحيل، يدرك أيّ غبيّ أنّه أنا

214
00:21:19,280 --> 00:21:22,950
سانجينو، إنّ أبلهًا لا يمشط
حتّى شعره للخلف مثلك

215
00:21:22,950 --> 00:21:24,660
.ليس مؤهّلاً حتّى ليكون الزّعيم

216
00:21:24,660 --> 00:21:27,510
لديّ أسبابي، أهذا مفهوم؟! إنّه ممشوط
!للخلف من جانب واحد، ألا ترى؟

217
00:21:28,170 --> 00:21:31,270
جانب واحد؟! لا تضحكني! ذلك أشبه
!بقول أنّ لديك خصية واحدة

218
00:21:31,550 --> 00:21:32,600
!ماذا قلت؟

219
00:21:32,600 --> 00:21:36,340
!زاد الأمر عن حدّه! إنّها حرب شاملة

220
00:21:36,340 --> 00:21:39,420
!على أيّ أساس تبدأ حربًا شاملة؟

221
00:21:39,420 --> 00:21:40,650
.إنّها الحرب في كلّ الأحوال

222
00:21:40,930 --> 00:21:42,600
.أذقه طعم الرّصاص يا أوسوتويا

223
00:21:42,600 --> 00:21:45,330
.سأقضي على زوروشيا

224
00:21:47,270 --> 00:21:50,100
!فشل أوسوتويا

225
00:21:52,360 --> 00:21:54,780
اذهب واقضِ على لوفيوني
!بينما لا يملك رجالًا يحموه

226
00:21:54,780 --> 00:21:57,170
.سأقضي على لوفيوني

227
00:21:58,820 --> 00:22:01,490
!فشل تشوبّاليني

228
00:22:03,910 --> 00:22:05,750
.اعرفي عدوّك جيّدًا يا ناميموري

229
00:22:05,750 --> 00:22:07,350
.سأقضي على سانجينو

230
00:22:08,560 --> 00:22:09,390
!يا أمّي

231
00:22:09,790 --> 00:22:13,010
!قُضي على عائلة سانجينو

232
00:22:14,130 --> 00:22:15,800
أين الخزنة الآن؟

233
00:22:16,800 --> 00:22:19,060
!أجل! كان غنيًّا بالفعل

234
00:22:20,050 --> 00:22:22,720
!فشلت ناميموري

235
00:22:24,720 --> 00:22:27,730
.حسنًا. لكنّها قتلت سانجينو على الأقلّ

236
00:22:27,730 --> 00:22:30,610
.روبيتا، اقضي على لوفيوني

237
00:22:30,610 --> 00:22:31,490
.لستُ مهتمّة بذلك

238
00:22:31,490 --> 00:22:32,030
!ماذا؟

239
00:22:33,730 --> 00:22:36,360
!تعرّض زوروشيا للخيانة

240
00:22:39,320 --> 00:22:41,280
!كلاّ! اطلقا على بعضهما

241
00:22:40,200 --> 00:22:45,170
روبيتا من عائلة زوروشيا ماتت
."وهي تفكّر "لم يكن يفترض أن يحدث هذا

242
00:22:41,280 --> 00:22:43,890
!فشلت روبيتا

243
00:22:47,000 --> 00:22:48,750
!أجل، أنا الزّعيم

244
00:22:48,750 --> 00:22:52,510
أستطيع الآن أكل كلّ ما أريده
!من اللّحم في هذه البلدة

245
00:22:55,760 --> 00:22:57,670
...ما الّذي

246
00:22:57,670 --> 00:23:00,940
لا أصدّق أنّ طعم اللّحم فظيع
...عند أكله بمفردي

247
00:23:01,390 --> 00:23:07,550
إنّني... أدركت أخيرًا الآن
...ما هو أهمّ شيء في الحياة

248
00:23:08,430 --> 00:23:11,350
...أشعر بالوحدة... أشعر بالوحدة

249
00:23:11,350 --> 00:23:13,370
.إن كان هذا حلمًا، فأريد أن أستيقظ

250
00:23:14,650 --> 00:23:15,660
.كان حلمًا

251
00:23:15,660 --> 00:23:17,780
!ومن تكون أنت؟! وكان حلمًا بالفعل؟

252
00:23:25,600 --> 00:23:28,090
،كلّما رغبت في البقاء أكثر معهم
.زادت معاناتهم بسببي

253
00:23:29,450 --> 00:23:31,390
.ظننتُ أمرًا ما كنت لأجرأ على تمنّيه

254
00:23:32,830 --> 00:23:33,510
...لكن يا ساول

255
00:23:34,690 --> 00:23:36,310
.كنتَ على حقّ

256
00:23:36,930 --> 00:23:40,190
!استطعت أن ألتقي بأصدقاء سيحمونني

257
00:23:40,810 --> 00:23:42,150
:في الحلقة القادمة من وان بيس

258
00:23:42,350 --> 00:23:46,060
!كلّ شيء من أجل أصدقائها"
"!الظّلمة بداخل روبين

259
00:23:46,070 --> 00:23:48,170
!ملك القراصنة، لن يكون إلاّ أنا

260
00:23:50,070 --> 00:23:55,120
نلقاكم في الحلقة القادمة