1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:03,530 --> 00:02:05,610
!المستوى الرّابع

29
00:02:06,700 --> 00:02:08,780
!الرّجل الواثب

30
00:02:23,090 --> 00:02:24,820
ما الّذي تسعى إليه؟

31
00:02:24,820 --> 00:02:28,510
هل تسلّلت بين صفوفنا وحدك
أم لديك شركاء آخرين؟

32
00:02:28,510 --> 00:02:30,550
!من تكون يا هذا؟

33
00:02:31,020 --> 00:02:33,760
.الصّدق خيارك الوحيد

34
00:02:42,070 --> 00:02:43,520
ماذا عليّ أن أفعل؟

35
00:02:44,120 --> 00:02:46,030
،حتّى إن هربت منهم

36
00:02:46,200 --> 00:02:49,570
.سأكون محاطًا بجيش من قراصنة مملكة الحيوان

37
00:02:49,870 --> 00:02:52,240
...أظنّ أنّه لا يوجد أمل

38
00:02:52,240 --> 00:02:53,370
!مذهل

39
00:02:54,160 --> 00:02:57,040
!هل ستتكلّم أم لا؟

40
00:03:00,300 --> 00:03:01,460
.حسنًا

41
00:03:04,010 --> 00:03:04,960
...هذه

42
00:03:05,880 --> 00:03:08,210
...عربون شكر

43
00:03:10,010 --> 00:03:11,510
!منّي

44
00:03:11,930 --> 00:03:12,590
!انبطحوا

45
00:03:21,480 --> 00:03:23,310
...فاكهة المطّاط

46
00:03:25,280 --> 00:03:26,530
!ابتعد عن طريقي

47
00:03:26,530 --> 00:03:28,280
!يا جوكي

48
00:03:30,370 --> 00:03:32,240
...إكس

49
00:03:34,080 --> 00:03:35,330
...مسدّس

50
00:03:35,330 --> 00:03:36,830
!كونغ

51
00:03:35,330 --> 00:03:36,830
!كاليبور

52
00:03:40,460 --> 00:03:41,540
!أرجوك

53
00:03:41,800 --> 00:03:45,170
!دعني أقاتل إلى جانبكم

54
00:03:51,890 --> 00:03:56,180
"!منافسة جديدة! نامي وأولتي"

55
00:04:11,080 --> 00:04:14,490
!يا لضراوته، إنّه أشبه بالإله ميوو بعينه

56
00:04:36,640 --> 00:04:38,640
!دييس دريك

57
00:04:38,640 --> 00:04:40,260
!هل غيّر انتماءه؟

58
00:04:41,150 --> 00:04:42,850
!ذلك الوغد

59
00:04:47,860 --> 00:04:49,820
...إنّه ذلك المنحرف الّذي رأى

60
00:04:50,490 --> 00:04:54,530
نامي-سان وروبين-تشان تستحمّان
!ذلك اليوم في عاصمة الزّهور

61
00:04:55,620 --> 00:04:59,120
!ماذا؟! هذا لا يغتفر يا دريك

62
00:05:15,600 --> 00:05:17,510
!لا أصدّق هذا

63
00:05:18,940 --> 00:05:21,100
!هذا قويّ جدًّا يا نامي-سان

64
00:05:21,890 --> 00:05:24,720
!لكمة سعادة

65
00:05:24,720 --> 00:05:26,310
!ماذا؟

66
00:05:28,450 --> 00:05:33,320
كان شكل جسد نامي-سان أشبه
...بنهر جارف عظيم يتدفّق

67
00:05:35,080 --> 00:05:37,280
!يا لحقارته

68
00:05:37,540 --> 00:05:39,110
!لا، قصدتك أنت

69
00:05:39,870 --> 00:05:46,420
سرّني أنّك لم تغرق في بركة الدّماء
...الّتي انطلقت من أنفك

70
00:05:46,420 --> 00:05:47,790
!هذا صحيح يا روبين-تشان

71
00:05:48,340 --> 00:05:51,500
!لديّ دماء ساخنة تجري في عروقي

72
00:05:51,510 --> 00:05:56,050
!لا أمانع خسارة كلّ شيء من أجلك

73
00:05:56,050 --> 00:05:59,340
توقّف! لا تحاول تصوير نزيف
!أنفك على أنّه أمر رائع

74
00:06:00,060 --> 00:06:02,580
!ما قصّة ذلك الرّجل؟

75
00:06:02,580 --> 00:06:05,020
!يريد القتال معنا؟

76
00:06:05,020 --> 00:06:08,940
!كيف أمكنه قول ذلك بعد تقطيعه لحليف له؟

77
00:06:11,780 --> 00:06:15,610
!تحوّل للتّوّ إلى شيء يشبه الدّيناصور

78
00:06:15,610 --> 00:06:18,860
.لا بدّ أنّه واحد من ضبّاط التّوبي روبّو

79
00:06:19,750 --> 00:06:22,950
...لكنّ هذا غريب

80
00:06:23,330 --> 00:06:25,620
!ما الّذي يظنّ أنّه فاعل؟

81
00:06:25,620 --> 00:06:29,580
!يا دريك! لماذا هاجمت أحد الأرقام؟

82
00:06:44,900 --> 00:06:47,730
!لوفي-سان مذهل

83
00:06:48,980 --> 00:06:51,020
...يجعلك لوفي-سان

84
00:06:51,020 --> 00:06:53,590
،تشعر أنّك قريب منه جدًّا إن كنت صديقه

85
00:06:53,590 --> 00:06:57,190
...لكن إن صرتَ عدوًّا له، فسيتركك خلفه

86
00:06:57,200 --> 00:07:00,820
!هكذا هو

87
00:07:02,330 --> 00:07:04,080
ماذا تقصد؟

88
00:07:04,080 --> 00:07:07,910
.يملك لوفي-سان القدرة على جذب النّاس إليه

89
00:07:09,880 --> 00:07:13,830
!إن تعاملت معه مباشرة، فأنا واثق أنّك ستكتشف ذلك

90
00:07:14,840 --> 00:07:16,710
!دريك-سان

91
00:07:23,730 --> 00:07:27,390
!أنا أعرفك! تريد الإطاحة بكايدو أيضًا؟

92
00:07:27,820 --> 00:07:31,600
!لا أستطيع إخبارك عن السّبب، لكنّ غايتنا واحدة

93
00:07:41,530 --> 00:07:45,180
!لا تحاول استعمال خدعة رخيصة في مسرح كهذا

94
00:07:45,180 --> 00:07:45,870
!لوفي

95
00:07:47,040 --> 00:07:51,330
!لقد أصبح تابعًا لكايدو تمامًا مثل هوكينس

96
00:07:52,760 --> 00:07:55,710
!لكنّي طُردت الآن

97
00:07:56,970 --> 00:07:59,550
!لهذا السّبب تريد القتال إلى جانبنا؟

98
00:07:59,550 --> 00:08:02,930
!كيف لنا أن نثق بوغد سطحيّ مثلك؟

99
00:08:02,930 --> 00:08:06,550
!ابق بعيدًا عن لوفي يا دييس دريك

100
00:08:06,980 --> 00:08:11,100
!حتّى عالم القراصنة يحكمه قانون خُلقيّ

101
00:08:34,800 --> 00:08:36,830
.بإمكانك أن تصير حليفًا لي

102
00:08:38,510 --> 00:08:39,880
!أأنت واثق؟

103
00:08:40,050 --> 00:08:40,880
.نعم

104
00:08:40,880 --> 00:08:42,050
!لا

105
00:08:42,050 --> 00:08:44,970
!لا تتدخّل أيّها القبطان! يا لك من مغفّل

106
00:08:45,930 --> 00:08:50,510
!سأطيح بكايدو في كلّ الأحوال
!بإمكانك فعل ما يحلو لك أيضًا

107
00:09:02,950 --> 00:09:05,070
!فرانكي! جينبي

108
00:09:05,490 --> 00:09:08,950
يقولون أنّ مقاتلي السّاقة هم الأبطال
!الحقيقيّون في ساحة المعركة

109
00:09:09,330 --> 00:09:12,370
!أسرع إلى القلعة يا لوفي

110
00:09:12,540 --> 00:09:15,040
!حسنًا! سأترك أمرهم لكم

111
00:09:21,050 --> 00:09:22,300
...من خان مرّة

112
00:09:23,810 --> 00:09:25,220
!يخون مليون مرّة

113
00:09:27,100 --> 00:09:30,140
!لا أستطيع السّماح لك بالاقتراب من لوفي

114
00:09:31,900 --> 00:09:33,520
!لا ألومك

115
00:09:42,830 --> 00:09:45,490
!سانجي! لنذهب إلى داخل القلعة

116
00:09:45,490 --> 00:09:46,820
!أجل

117
00:09:49,580 --> 00:09:53,700
!تنتظر أوكيكو-تشان مساعدتي

118
00:10:03,390 --> 00:10:07,550
!أنتما، ادّخرا طاقتيكما وتقدّما بسرعة للأمام

119
00:10:07,550 --> 00:10:10,220
!أجل! نحن نعتمد عليك

120
00:10:10,640 --> 00:10:12,540
...الرّجل الّذي يرتدي قبّعة القشّ

121
00:10:12,540 --> 00:10:15,970
!أظنّ أنّه هو زعيم كلّ القراصنة والسّاموراي

122
00:10:16,230 --> 00:10:17,920
!هيّا بنا يا أختي

123
00:10:17,920 --> 00:10:19,150
!مهلاً

124
00:10:19,150 --> 00:10:20,320
!ما الّذي تفعلينه؟

125
00:10:20,610 --> 00:10:24,150
!بي-تان، لا أستطيع الاستمرار

126
00:10:25,080 --> 00:10:29,740
!قاتلتُ ضدّ ياماتو من قبل وأنا متعبة

127
00:10:29,740 --> 00:10:31,870
!إنّ صحّتك في أفضل حال

128
00:10:31,870 --> 00:10:33,120
!احملني

129
00:10:33,460 --> 00:10:36,500
!أبقوا هذين الاثنين بعيدين عن قبّعة القشّ-سان

130
00:10:36,500 --> 00:10:37,750
!أجل

131
00:10:38,250 --> 00:10:40,630
!ابتعدوا عن طريقي أيّها السّاموراي الأوغاد

132
00:10:40,630 --> 00:10:43,920
!يا ذووا الغباء الفائق

133
00:10:51,640 --> 00:10:53,330
!يا أوغاد

134
00:10:53,330 --> 00:10:58,390
كيف أمكنكم التّدخّل بينما كان بي-تان
!على وشك حملي كأميرة؟

135
00:10:58,390 --> 00:10:59,940
!ذلك ليس مهمًّا

136
00:11:08,240 --> 00:11:10,820
!قاتلت هذين الاثنين في القلعة

137
00:11:11,160 --> 00:11:12,360
...ذاك هو

138
00:11:22,130 --> 00:11:24,670
!الدّيناصور من عاصمة الزّهور

139
00:11:25,210 --> 00:11:26,670
...لكن

140
00:11:27,470 --> 00:11:30,420
!من تلك الظّريفة الّتي إلى جانبه؟

141
00:11:32,640 --> 00:11:36,730
!لن ترى كايدو-سان ثانية

142
00:11:36,730 --> 00:11:38,970
!يا قبّعة القشّ

143
00:11:42,610 --> 00:11:45,480
!القتل المؤكّد: النّجم الأخضر

144
00:11:50,320 --> 00:11:52,860
!جمجمة العشب المتفجرة

145
00:12:00,090 --> 00:12:01,500
!بي-تان

146
00:12:06,760 --> 00:12:08,670
!مـ-من كان هذا؟

147
00:12:12,310 --> 00:12:13,800
!أنا نامي

148
00:12:14,100 --> 00:12:16,010
!ما خطبك يا هذه؟

149
00:12:16,400 --> 00:12:19,010
.لا يوجد ما أحبّه أكثر من القضاء على السّحالي

150
00:12:19,020 --> 00:12:21,390
!حضّري نفسك الآن

151
00:12:22,270 --> 00:12:24,520
!ما الّذي تفعله؟

152
00:12:25,200 --> 00:12:29,270
دعي الأمر لي فحسب! سأخرجنا
!من هذا الوضع دون قتال

153
00:12:30,120 --> 00:12:31,940
!سحالي؟

154
00:12:34,000 --> 00:12:37,740
!أتريدان منّي سكب سمّ السّحالي عليكما؟

155
00:12:37,740 --> 00:12:38,870
!لا تختبئ

156
00:12:40,420 --> 00:12:42,960
!كيف تجرؤ على الإطلاق عليّ؟

157
00:12:42,960 --> 00:12:46,000
!من كان الفاعل؟

158
00:12:46,220 --> 00:12:50,380
!يا بي-تان! إنّها تلك الحقيرة

159
00:12:50,380 --> 00:12:55,080
!هذا صحيح! أنا قاتلة السّحالي العظيمة نامي

160
00:12:55,080 --> 00:12:56,510
!تذكّرا اسمي

161
00:12:56,510 --> 00:12:58,180
!قلتُ لك توقّف

162
00:13:00,230 --> 00:13:02,930
!لست الفاعلة، لكنّ ذلك لا يهمّ

163
00:13:02,940 --> 00:13:05,310
!بدأت المعركة سلفًا

164
00:13:06,530 --> 00:13:07,520
...لذلك

165
00:13:09,030 --> 00:13:11,150
!أرياني أفضل ما لديكما

166
00:13:11,990 --> 00:13:14,110
!ماذا؟

167
00:13:16,330 --> 00:13:18,780
!ما تقولينه ليس منطقيًّا على الإطلاق

168
00:13:18,780 --> 00:13:20,580
!لا يحقّ لك الكلام

169
00:13:20,580 --> 00:13:22,960
!لن أدعكما تهربان

170
00:13:22,960 --> 00:13:24,920
!كيف أمكنكما أذيّة بي-تان؟

171
00:13:24,920 --> 00:13:25,960
...انظرا

172
00:13:25,960 --> 00:13:26,960
...ما مدى

173
00:13:26,960 --> 00:13:29,840
!سرعتنا في الهرب

174
00:13:29,840 --> 00:13:37,010
!توقّفا

175
00:13:37,350 --> 00:13:40,850
!أعتمد عليك يا أوسوبّ! احم نامي-سان

176
00:13:41,100 --> 00:13:44,140
!هيّا بنا يا لوفي إلى حيث يوجد كينييمون والبقيّة

177
00:13:44,140 --> 00:13:45,230
!أجل

178
00:13:52,320 --> 00:13:54,690
!يا سانجي! أغلق أذنيك

179
00:13:55,620 --> 00:13:57,030
!حا-حاضر

180
00:13:57,030 --> 00:13:59,910
!استمعوا لموسيقى القتال خاصّتي

181
00:13:59,910 --> 00:14:01,320
!تقطيع

182
00:14:10,420 --> 00:14:12,090
!ما هذا؟

183
00:14:15,930 --> 00:14:19,550
!يبدو أنّك صرت أذكى يا قبّعة القشّ

184
00:14:20,560 --> 00:14:21,850
...لكن

185
00:14:23,150 --> 00:14:28,460
لكنّ عدم القدرة على الاستماع
!وأنت تقاتل ستكون صعبة

186
00:14:28,460 --> 00:14:29,730
!استمعوا

187
00:15:16,990 --> 00:15:18,610
!جاكي

188
00:15:22,830 --> 00:15:24,450
!غوكي

189
00:15:28,420 --> 00:15:30,210
!جوكي

190
00:15:32,340 --> 00:15:35,590
!من المؤلم جدًّا رؤيتكم هكذا يا رفاق

191
00:15:35,800 --> 00:15:36,920
...أ

192
00:15:37,510 --> 00:15:39,670
...أنتم العشرة

193
00:15:39,970 --> 00:15:44,840
!دمّرتم الكثير من البلدات

194
00:15:47,770 --> 00:15:50,350
...لذلك السّبب

195
00:15:51,150 --> 00:15:56,280
ليس من العادل أن تُهزموا وأنتم ثملون

196
00:15:56,280 --> 00:15:58,860
!أثناء وليمة بهيجة كهذه

197
00:16:09,340 --> 00:16:10,160
!صحيح؟

198
00:16:10,380 --> 00:16:14,250
!ألا تظنّ ذلك يا هاتشا؟

199
00:16:18,420 --> 00:16:21,720
!هل صحوت من سكرك؟

200
00:16:24,850 --> 00:16:29,310
!ثمّة عشرة منهم؟! أحتاج للمزيد من الكولا

201
00:16:29,310 --> 00:16:32,060
!مهما كان، فإنّ أيّ عدد منهم سيكون تهديدًا

202
00:16:32,570 --> 00:16:36,320
!أروهم ما الّذي ينتظرهم

203
00:16:36,320 --> 00:16:40,900
!إن خرج عملاق قديم عن السّيطرة وهاجمهم

204
00:16:43,240 --> 00:16:45,950
!ماذا؟! أهو مروّضهم؟

205
00:16:45,950 --> 00:16:47,410
!ذلك الوغد

206
00:16:47,410 --> 00:16:49,950
!انس الأمر! علينا الذّهاب

207
00:16:50,540 --> 00:16:52,790
!حسنًا! لنذهب

208
00:16:52,790 --> 00:16:53,660
!أجل

209
00:16:58,180 --> 00:17:01,490
!وقت العرض وشيك

210
00:17:01,490 --> 00:17:04,970
!لا مجال لكم لتشاركوا! إنّه عرض فرديّ

211
00:17:05,930 --> 00:17:07,470
!لا تتوقّف يا لوفي

212
00:17:07,470 --> 00:17:09,050
!نعم، مفهوم

213
00:17:36,010 --> 00:17:37,620
!انظروا ما مدى قوّته

214
00:17:37,840 --> 00:17:40,790
!هل سيستعمل رفيقه كسلاح؟

215
00:17:41,850 --> 00:17:42,960
!مصيبة

216
00:17:52,310 --> 00:17:56,770
!فرانكي! اهرب خارج القبّة مباشرة

217
00:17:58,150 --> 00:18:03,190
،إن سمحنا لذلك العملاق بالهيجان هنا أكثر
!فلن يتمكّن السّاموراي من التّحمّل

218
00:18:03,410 --> 00:18:04,780
!مفهوم

219
00:18:04,780 --> 00:18:06,240
!أعتمد عليك

220
00:18:06,240 --> 00:18:07,200
!نعم

221
00:18:12,080 --> 00:18:16,710
!هل يظنّ أنّ الجنرال فرانكي لعبة؟

222
00:18:19,090 --> 00:18:22,750
!لم يمسك بي

223
00:18:24,720 --> 00:18:27,630
...سأجعله يندم

224
00:18:28,140 --> 00:18:31,640
!على ظنّه أنّه لعبة

225
00:18:32,900 --> 00:18:34,220
...على الأقلّ

226
00:18:36,270 --> 00:18:40,400
إن فزتم أنتم، فسيصبّ ذلك في مصلحتي
.أكثر من فوزهم هم

227
00:18:41,990 --> 00:18:43,440
!أهذا مقنع بما يكفي؟

228
00:18:50,160 --> 00:18:53,580
.فهمت. أنت صريح

229
00:18:53,920 --> 00:18:55,240
...لكن

230
00:18:58,630 --> 00:19:02,080
!مل زلت تخفي هويّتك

231
00:19:02,220 --> 00:19:05,170
!لا يمكننا القتال جنبًا إلى جنب رفقة رجل مثلك

232
00:19:07,590 --> 00:19:12,760
!أنا قويّ بما يكفي لأصير من التّوبي روبّو
!سأكون ذا عون كبير لكم بالتّأكيد

233
00:19:12,760 --> 00:19:15,330
!أعلم ذلك جيّدًا

234
00:19:15,330 --> 00:19:16,930
!أجب عن سؤالي

235
00:19:17,230 --> 00:19:19,140
هويّتي؟

236
00:19:19,820 --> 00:19:21,060
!لا يمكنني كشفها

237
00:19:21,060 --> 00:19:24,900
!إن كشفتها، فسينتهي بنا الأمر نتقاتل

238
00:19:37,290 --> 00:19:39,810
!لديّ فكرة لكم

239
00:19:39,810 --> 00:19:42,210
!لنستدعِ المزيد من الأرقام لقتالكم

240
00:19:42,670 --> 00:19:45,420
!يا رفاق

241
00:19:45,420 --> 00:19:48,840
!اصحوا من سُكركم وتعالوا

242
00:20:01,480 --> 00:20:03,810
!كفّ عن ذلك الهراء

243
00:20:08,580 --> 00:20:09,940
!دريك

244
00:20:10,790 --> 00:20:13,820
!يو! يو! سمعتُ يا دريك

245
00:20:14,540 --> 00:20:18,330
!أنت خائن، صحيح؟

246
00:20:19,580 --> 00:20:24,330
هل ستحلّ طفيليًّا على طاقم القراصنة
!الصّغير الضعيف ذلك هذه المرّة؟

247
00:20:29,140 --> 00:20:31,380
!سكراتشمن أبّو

248
00:20:31,720 --> 00:20:34,260
!لطالما كرهتك

249
00:20:35,350 --> 00:20:38,390
!سأوسعه ضربًا، لكنّي لن أقوم بذلك لأجلكم

250
00:20:41,900 --> 00:20:43,230
!تقطيع

251
00:20:44,860 --> 00:20:45,650
!زورو

252
00:20:45,650 --> 00:20:46,690
!قُطعت؟

253
00:20:48,570 --> 00:20:50,780
.لدينا أمر مشترك

254
00:20:51,950 --> 00:20:54,820
!إنّه لا يروق لي أيضًا

255
00:21:01,920 --> 00:21:05,160
!التّحالف بيننا قائم الآن

256
00:21:05,510 --> 00:21:07,040
!ماذا قلت؟

257
00:21:37,580 --> 00:21:40,780
!دريك

258
00:21:45,710 --> 00:21:50,420
!لا تظنّ أنّ بإمكانك الهرب أيّها الخائن

259
00:21:50,420 --> 00:21:54,880
!لا بدّ أنّك جاسوس

260
00:21:55,850 --> 00:21:59,180
...ثمّة مسخ آخر يسعى خلفك

261
00:22:00,060 --> 00:22:03,230
هل ظننت أنّي سأهزم بهراء كهذا؟

262
00:22:03,230 --> 00:22:04,940
...هذا مؤلم

263
00:22:04,940 --> 00:22:07,230
!مهلاً، تماسك

264
00:22:08,070 --> 00:22:09,980
!هذا مؤلم! اللّعنة

265
00:22:09,980 --> 00:22:13,110
!هل أنت بخير! إنّه جرح سطحيّ

266
00:22:39,100 --> 00:22:40,220
!...هذا

267
00:22:42,690 --> 00:22:44,220
...لا يعقل

268
00:22:44,610 --> 00:22:46,770
...هذه الرّصاصة

269
00:23:04,790 --> 00:23:08,160
!يواصل السّولوغ هزيمة أعدائهم متحدّين قلّتهم

270
00:23:09,000 --> 00:23:11,670
.ومحاربو المينك المتقدّمون يؤرقون جاك

271
00:23:14,940 --> 00:23:17,760
!ويقتربون من عدوّهم اللّدود كايدو أكثر

272
00:23:17,760 --> 00:23:21,680
!ضغينة عُمرها 20 عامًا تحترق كأنّها نيران جحيم

273
00:23:22,470 --> 00:23:27,690
:في الحلقة القادمة من وان بيس
"!نصل بطوليّ! الأكازايا ضدّ كايدو مرّة أخرى"

274
00:23:27,690 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا