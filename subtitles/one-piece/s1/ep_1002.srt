1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:17,530 --> 00:02:19,610
!المستوى الرّابع

29
00:02:20,700 --> 00:02:22,780
!الرّجل الواثب

30
00:02:37,090 --> 00:02:38,820
ما الّذي تسعى إليه؟

31
00:02:38,820 --> 00:02:42,510
هل تسلّلت بين صفوفنا وحدك
أم لديك شركاء آخرين؟

32
00:02:42,510 --> 00:02:44,550
!من تكون يا هذا؟

33
00:02:45,020 --> 00:02:47,760
.الصّدق خيارك الوحيد

34
00:02:56,070 --> 00:02:57,520
ماذا عليّ أن أفعل؟

35
00:02:58,120 --> 00:03:00,030
،حتّى إن هربت منهم

36
00:03:00,200 --> 00:03:03,570
.سأكون محاطًا بجيش من قراصنة مملكة الحيوان

37
00:03:03,870 --> 00:03:06,240
...أظنّ أنّه لا يوجد أمل

38
00:03:06,240 --> 00:03:07,370
!مذهل

39
00:03:08,160 --> 00:03:11,040
!هل ستتكلّم أم لا؟

40
00:03:14,300 --> 00:03:15,460
.حسنًا

41
00:03:18,010 --> 00:03:18,960
...هذه

42
00:03:19,880 --> 00:03:22,210
...عربون شكر

43
00:03:24,010 --> 00:03:25,510
!منّي

44
00:03:25,930 --> 00:03:26,590
!انبطحوا

45
00:03:35,480 --> 00:03:37,310
...فاكهة المطّاط

46
00:03:39,280 --> 00:03:40,530
!ابتعد عن طريقي

47
00:03:40,530 --> 00:03:42,280
!يا جوكي

48
00:03:44,370 --> 00:03:46,240
...إكس

49
00:03:48,080 --> 00:03:49,330
...مسدّس

50
00:03:49,330 --> 00:03:50,830
!كونغ

51
00:03:49,330 --> 00:03:50,830
!كاليبور

52
00:03:54,460 --> 00:03:55,540
!أرجوك

53
00:03:55,800 --> 00:03:59,170
!دعني أقاتل إلى جانبكم

54
00:04:05,890 --> 00:04:10,180
"!منافسة جديدة! نامي وأولتي"

55
00:04:25,080 --> 00:04:28,490
!يا لضراوته، إنّه أشبه بالإله ميوو بعينه

56
00:04:50,640 --> 00:04:52,640
!دييس دريك

57
00:04:52,640 --> 00:04:54,260
!هل غيّر انتماءه؟

58
00:04:55,150 --> 00:04:56,850
!ذلك الوغد

59
00:05:01,860 --> 00:05:03,820
...إنّه ذلك المنحرف الّذي رأى

60
00:05:04,490 --> 00:05:08,530
نامي-سان وروبين-تشان تستحمّان
!ذلك اليوم في عاصمة الزّهور

61
00:05:09,620 --> 00:05:13,120
!ماذا؟! هذا لا يغتفر يا دريك

62
00:05:29,600 --> 00:05:31,510
!لا أصدّق هذا

63
00:05:32,940 --> 00:05:35,100
!هذا قويّ جدًّا يا نامي-سان

64
00:05:35,890 --> 00:05:38,720
!لكمة سعادة

65
00:05:38,720 --> 00:05:40,310
!ماذا؟

66
00:05:42,450 --> 00:05:47,320
كان شكل جسد نامي-سان أشبه
...بنهر جارف عظيم يتدفّق

67
00:05:49,080 --> 00:05:51,280
!يا لحقارته

68
00:05:51,540 --> 00:05:53,110
!لا، قصدتك أنت

69
00:05:53,870 --> 00:06:00,420
سرّني أنّك لم تغرق في بركة الدّماء
...الّتي انطلقت من أنفك

70
00:06:00,420 --> 00:06:01,790
!هذا صحيح يا روبين-تشان

71
00:06:02,340 --> 00:06:05,500
!لديّ دماء ساخنة تجري في عروقي

72
00:06:05,510 --> 00:06:10,050
!لا أمانع خسارة كلّ شيء من أجلك

73
00:06:10,050 --> 00:06:13,340
توقّف! لا تحاول تصوير نزيف
!أنفك على أنّه أمر رائع

74
00:06:14,060 --> 00:06:16,580
!ما قصّة ذلك الرّجل؟

75
00:06:16,580 --> 00:06:19,020
!يريد القتال معنا؟

76
00:06:19,020 --> 00:06:22,940
!كيف أمكنه قول ذلك بعد تقطيعه لحليف له؟

77
00:06:25,780 --> 00:06:29,610
!تحوّل للتّوّ إلى شيء يشبه الدّيناصور

78
00:06:29,610 --> 00:06:32,860
.لا بدّ أنّه واحد من ضبّاط التّوبي روبّو

79
00:06:33,750 --> 00:06:36,950
...لكنّ هذا غريب

80
00:06:37,330 --> 00:06:39,620
!ما الّذي يظنّ أنّه فاعل؟

81
00:06:39,620 --> 00:06:43,580
!يا دريك! لماذا هاجمت أحد الأرقام؟

82
00:06:58,900 --> 00:07:01,730
!لوفي-سان مذهل

83
00:07:02,980 --> 00:07:05,020
...يجعلك لوفي-سان

84
00:07:05,020 --> 00:07:07,590
،تشعر أنّك قريب منه جدًّا إن كنت صديقه

85
00:07:07,590 --> 00:07:11,190
...لكن إن صرتَ عدوًّا له، فسيتركك خلفه

86
00:07:11,200 --> 00:07:14,820
!هكذا هو

87
00:07:16,330 --> 00:07:18,080
ماذا تقصد؟

88
00:07:18,080 --> 00:07:21,910
.يملك لوفي-سان القدرة على جذب النّاس إليه

89
00:07:23,880 --> 00:07:27,830
!إن تعاملت معه مباشرة، فأنا واثق أنّك ستكتشف ذلك

90
00:07:28,840 --> 00:07:30,710
!دريك-سان

91
00:07:37,730 --> 00:07:41,390
!أنا أعرفك! تريد الإطاحة بكايدو أيضًا؟

92
00:07:41,820 --> 00:07:45,600
!لا أستطيع إخبارك عن السّبب، لكنّ غايتنا واحدة

93
00:07:55,530 --> 00:07:59,180
!لا تحاول استعمال خدعة رخيصة في مسرح كهذا

94
00:07:59,180 --> 00:07:59,870
!لوفي

95
00:08:01,040 --> 00:08:05,330
!لقد أصبح تابعًا لكايدو تمامًا مثل هوكينس

96
00:08:06,760 --> 00:08:09,710
!لكنّي طُردت الآن

97
00:08:10,970 --> 00:08:13,550
!لهذا السّبب تريد القتال إلى جانبنا؟

98
00:08:13,550 --> 00:08:16,930
!كيف لنا أن نثق بوغد سطحيّ مثلك؟

99
00:08:16,930 --> 00:08:20,550
!ابق بعيدًا عن لوفي يا دييس دريك

100
00:08:20,980 --> 00:08:25,100
!حتّى عالم القراصنة يحكمه قانون خُلقيّ

101
00:08:48,800 --> 00:08:50,830
.بإمكانك أن تصير حليفًا لي

102
00:08:52,510 --> 00:08:53,880
!أأنت واثق؟

103
00:08:54,050 --> 00:08:54,880
.نعم

104
00:08:54,880 --> 00:08:56,050
!لا

105
00:08:56,050 --> 00:08:58,970
!لا تتدخّل أيّها القبطان! يا لك من مغفّل

106
00:08:59,930 --> 00:09:04,510
!سأطيح بكايدو في كلّ الأحوال
!بإمكانك فعل ما يحلو لك أيضًا

107
00:09:16,950 --> 00:09:19,070
!فرانكي! جينبي

108
00:09:19,490 --> 00:09:22,950
يقولون أنّ مقاتلي السّاقة هم الأبطال
!الحقيقيّون في ساحة المعركة

109
00:09:23,330 --> 00:09:26,370
!أسرع إلى القلعة يا لوفي

110
00:09:26,540 --> 00:09:29,040
!حسنًا! سأترك أمرهم لكم

111
00:09:35,050 --> 00:09:36,300
...من خان مرّة

112
00:09:37,810 --> 00:09:39,220
!يخون مليون مرّة

113
00:09:41,100 --> 00:09:44,140
!لا أستطيع السّماح لك بالاقتراب من لوفي

114
00:09:45,900 --> 00:09:47,520
!لا ألومك

115
00:09:56,830 --> 00:09:59,490
!سانجي! لنذهب إلى داخل القلعة

116
00:09:59,490 --> 00:10:00,820
!أجل

117
00:10:03,580 --> 00:10:07,700
!تنتظر أوكيكو-تشان مساعدتي

118
00:10:17,390 --> 00:10:21,550
!أنتما، ادّخرا طاقتيكما وتقدّما بسرعة للأمام

119
00:10:21,550 --> 00:10:24,220
!أجل! نحن نعتمد عليك

120
00:10:24,640 --> 00:10:26,540
...الرّجل الّذي يرتدي قبّعة القشّ

121
00:10:26,540 --> 00:10:29,970
!أظنّ أنّه هو زعيم كلّ القراصنة والسّاموراي

122
00:10:30,230 --> 00:10:31,920
!هيّا بنا يا أختي

123
00:10:31,920 --> 00:10:33,150
!مهلاً

124
00:10:33,150 --> 00:10:34,320
!ما الّذي تفعلينه؟

125
00:10:34,610 --> 00:10:38,150
!بي-تان، لا أستطيع الاستمرار

126
00:10:39,080 --> 00:10:43,740
!قاتلتُ ضدّ ياماتو من قبل وأنا متعبة

127
00:10:43,740 --> 00:10:45,870
!إنّ صحّتك في أفضل حال

128
00:10:45,870 --> 00:10:47,120
!احملني

129
00:10:47,460 --> 00:10:50,500
!أبقوا هذين الاثنين بعيدين عن قبّعة القشّ-سان

130
00:10:50,500 --> 00:10:51,750
!أجل

131
00:10:52,250 --> 00:10:54,630
!ابتعدوا عن طريقي أيّها السّاموراي الأوغاد

132
00:10:54,630 --> 00:10:57,920
!يا ذووا الغباء الفائق

133
00:11:05,640 --> 00:11:07,330
!يا أوغاد

134
00:11:07,330 --> 00:11:12,390
كيف أمكنكم التّدخّل بينما كان بي-تان
!على وشك حملي كأميرة؟

135
00:11:12,390 --> 00:11:13,940
!ذلك ليس مهمًّا

136
00:11:22,240 --> 00:11:24,820
!قاتلت هذين الاثنين في القلعة

137
00:11:25,160 --> 00:11:26,360
...ذاك هو

138
00:11:36,130 --> 00:11:38,670
!الدّيناصور من عاصمة الزّهور

139
00:11:39,210 --> 00:11:40,670
...لكن

140
00:11:41,470 --> 00:11:44,420
!من تلك الظّريفة الّتي إلى جانبه؟

141
00:11:46,640 --> 00:11:50,730
!لن ترى كايدو-سان ثانية

142
00:11:50,730 --> 00:11:52,970
!يا قبّعة القشّ

143
00:11:56,610 --> 00:11:59,480
!القتل المؤكّد: النّجم الأخضر

144
00:12:04,320 --> 00:12:06,860
!جمجمة العشب المتفجرة

145
00:12:14,090 --> 00:12:15,500
!بي-تان

146
00:12:20,760 --> 00:12:22,670
!مـ-من كان هذا؟

147
00:12:26,310 --> 00:12:27,800
!أنا نامي

148
00:12:28,100 --> 00:12:30,010
!ما خطبك يا هذه؟

149
00:12:30,400 --> 00:12:33,010
.لا يوجد ما أحبّه أكثر من القضاء على السّحالي

150
00:12:33,020 --> 00:12:35,390
!حضّري نفسك الآن

151
00:12:36,270 --> 00:12:38,520
!ما الّذي تفعله؟

152
00:12:39,200 --> 00:12:43,270
دعي الأمر لي فحسب! سأخرجنا
!من هذا الوضع دون قتال

153
00:12:44,120 --> 00:12:45,940
!سحالي؟

154
00:12:48,000 --> 00:12:51,740
!أتريدان منّي سكب سمّ السّحالي عليكما؟

155
00:12:51,740 --> 00:12:52,870
!لا تختبئ

156
00:12:54,420 --> 00:12:56,960
!كيف تجرؤ على الإطلاق عليّ؟

157
00:12:56,960 --> 00:13:00,000
!من كان الفاعل؟

158
00:13:00,220 --> 00:13:04,380
!يا بي-تان! إنّها تلك الحقيرة

159
00:13:04,380 --> 00:13:09,080
!هذا صحيح! أنا قاتلة السّحالي العظيمة نامي

160
00:13:09,080 --> 00:13:10,510
!تذكّرا اسمي

161
00:13:10,510 --> 00:13:12,180
!قلتُ لك توقّف

162
00:13:14,230 --> 00:13:16,930
!لست الفاعلة، لكنّ ذلك لا يهمّ

163
00:13:16,940 --> 00:13:19,310
!بدأت المعركة سلفًا

164
00:13:20,530 --> 00:13:21,520
...لذلك

165
00:13:23,030 --> 00:13:25,150
!أرياني أفضل ما لديكما

166
00:13:25,990 --> 00:13:28,110
!ماذا؟

167
00:13:30,330 --> 00:13:32,780
!ما تقولينه ليس منطقيًّا على الإطلاق

168
00:13:32,780 --> 00:13:34,580
!لا يحقّ لك الكلام

169
00:13:34,580 --> 00:13:36,960
!لن أدعكما تهربان

170
00:13:36,960 --> 00:13:38,920
!كيف أمكنكما أذيّة بي-تان؟

171
00:13:38,920 --> 00:13:39,960
...انظرا

172
00:13:39,960 --> 00:13:40,960
...ما مدى

173
00:13:40,960 --> 00:13:43,840
!سرعتنا في الهرب

174
00:13:43,840 --> 00:13:51,010
!توقّفا

175
00:13:51,350 --> 00:13:54,850
!أعتمد عليك يا أوسوبّ! احم نامي-سان

176
00:13:55,100 --> 00:13:58,140
!هيّا بنا يا لوفي إلى حيث يوجد كينييمون والبقيّة

177
00:13:58,140 --> 00:13:59,230
!أجل

178
00:14:06,320 --> 00:14:08,690
!يا سانجي! أغلق أذنيك

179
00:14:09,620 --> 00:14:11,030
!حا-حاضر

180
00:14:11,030 --> 00:14:13,910
!استمعوا لموسيقى القتال خاصّتي

181
00:14:13,910 --> 00:14:15,320
!تقطيع

182
00:14:24,420 --> 00:14:26,090
!ما هذا؟

183
00:14:29,930 --> 00:14:33,550
!يبدو أنّك صرت أذكى يا قبّعة القشّ

184
00:14:34,560 --> 00:14:35,850
...لكن

185
00:14:37,150 --> 00:14:42,460
لكنّ عدم القدرة على الاستماع
!وأنت تقاتل ستكون صعبة

186
00:14:42,460 --> 00:14:43,730
!استمعوا

187
00:15:30,990 --> 00:15:32,610
!جاكي

188
00:15:36,830 --> 00:15:38,450
!غوكي

189
00:15:42,420 --> 00:15:44,210
!جوكي

190
00:15:46,340 --> 00:15:49,590
!من المؤلم جدًّا رؤيتكم هكذا يا رفاق

191
00:15:49,800 --> 00:15:50,920
...أ

192
00:15:51,510 --> 00:15:53,670
...أنتم العشرة

193
00:15:53,970 --> 00:15:58,840
!دمّرتم الكثير من البلدات

194
00:16:01,770 --> 00:16:04,350
...لذلك السّبب

195
00:16:05,150 --> 00:16:10,280
ليس من العادل أن تُهزموا وأنتم ثملون

196
00:16:10,280 --> 00:16:12,860
!أثناء وليمة بهيجة كهذه

197
00:16:23,340 --> 00:16:24,160
!صحيح؟

198
00:16:24,380 --> 00:16:28,250
!ألا تظنّ ذلك يا هاتشا؟

199
00:16:32,420 --> 00:16:35,720
!هل صحوت من سكرك؟

200
00:16:38,850 --> 00:16:43,310
!ثمّة عشرة منهم؟! أحتاج للمزيد من الكولا

201
00:16:43,310 --> 00:16:46,060
!مهما كان، فإنّ أيّ عدد منهم سيكون تهديدًا

202
00:16:46,570 --> 00:16:50,320
!أروهم ما الّذي ينتظرهم

203
00:16:50,320 --> 00:16:54,900
!إن خرج عملاق قديم عن السّيطرة وهاجمهم

204
00:16:57,240 --> 00:16:59,950
!ماذا؟! أهو مروّضهم؟

205
00:16:59,950 --> 00:17:01,410
!ذلك الوغد

206
00:17:01,410 --> 00:17:03,950
!انس الأمر! علينا الذّهاب

207
00:17:04,540 --> 00:17:06,790
!حسنًا! لنذهب

208
00:17:06,790 --> 00:17:07,660
!أجل

209
00:17:12,180 --> 00:17:15,490
!وقت العرض وشيك

210
00:17:15,490 --> 00:17:18,970
!لا مجال لكم لتشاركوا! إنّه عرض فرديّ

211
00:17:19,930 --> 00:17:21,470
!لا تتوقّف يا لوفي

212
00:17:21,470 --> 00:17:23,050
!نعم، مفهوم

213
00:17:50,010 --> 00:17:51,620
!انظروا ما مدى قوّته

214
00:17:51,840 --> 00:17:54,790
!هل سيستعمل رفيقه كسلاح؟

215
00:17:55,850 --> 00:17:56,960
!مصيبة

216
00:18:06,310 --> 00:18:10,770
!فرانكي! اهرب خارج القبّة مباشرة

217
00:18:12,150 --> 00:18:17,190
،إن سمحنا لذلك العملاق بالهيجان هنا أكثر
!فلن يتمكّن السّاموراي من التّحمّل

218
00:18:17,410 --> 00:18:18,780
!مفهوم

219
00:18:18,780 --> 00:18:20,240
!أعتمد عليك

220
00:18:20,240 --> 00:18:21,200
!نعم

221
00:18:26,080 --> 00:18:30,710
!هل يظنّ أنّ الجنرال فرانكي لعبة؟

222
00:18:33,090 --> 00:18:36,750
!لم يمسك بي

223
00:18:38,720 --> 00:18:41,630
...سأجعله يندم

224
00:18:42,140 --> 00:18:45,640
!على ظنّه أنّه لعبة

225
00:18:46,900 --> 00:18:48,220
...على الأقلّ

226
00:18:50,270 --> 00:18:54,400
إن فزتم أنتم، فسيصبّ ذلك في مصلحتي
.أكثر من فوزهم هم

227
00:18:55,990 --> 00:18:57,440
!أهذا مقنع بما يكفي؟

228
00:19:04,160 --> 00:19:07,580
.فهمت. أنت صريح

229
00:19:07,920 --> 00:19:09,240
...لكن

230
00:19:12,630 --> 00:19:16,080
!مل زلت تخفي هويّتك

231
00:19:16,220 --> 00:19:19,170
!لا يمكننا القتال جنبًا إلى جنب رفقة رجل مثلك

232
00:19:21,590 --> 00:19:26,760
!أنا قويّ بما يكفي لأصير من التّوبي روبّو
!سأكون ذا عون كبير لكم بالتّأكيد

233
00:19:26,760 --> 00:19:29,330
!أعلم ذلك جيّدًا

234
00:19:29,330 --> 00:19:30,930
!أجب عن سؤالي

235
00:19:31,230 --> 00:19:33,140
هويّتي؟

236
00:19:33,820 --> 00:19:35,060
!لا يمكنني كشفها

237
00:19:35,060 --> 00:19:38,900
!إن كشفتها، فسينتهي بنا الأمر نتقاتل

238
00:19:51,290 --> 00:19:53,810
!لديّ فكرة لكم

239
00:19:53,810 --> 00:19:56,210
!لنستدعِ المزيد من الأرقام لقتالكم

240
00:19:56,670 --> 00:19:59,420
!يا رفاق

241
00:19:59,420 --> 00:20:02,840
!اصحوا من سُكركم وتعالوا

242
00:20:15,480 --> 00:20:17,810
!كفّ عن ذلك الهراء

243
00:20:22,580 --> 00:20:23,940
!دريك

244
00:20:24,790 --> 00:20:27,820
!يو! يو! سمعتُ يا دريك

245
00:20:28,540 --> 00:20:32,330
!أنت خائن، صحيح؟

246
00:20:33,580 --> 00:20:38,330
هل ستحلّ طفيليًّا على طاقم القراصنة
!الصّغير الضعيف ذلك هذه المرّة؟

247
00:20:43,140 --> 00:20:45,380
!سكراتشمن أبّو

248
00:20:45,720 --> 00:20:48,260
!لطالما كرهتك

249
00:20:49,350 --> 00:20:52,390
!سأوسعه ضربًا، لكنّي لن أقوم بذلك لأجلكم

250
00:20:55,900 --> 00:20:57,230
!تقطيع

251
00:20:58,860 --> 00:20:59,650
!زورو

252
00:20:59,650 --> 00:21:00,690
!قُطعت؟

253
00:21:02,570 --> 00:21:04,780
.لدينا أمر مشترك

254
00:21:05,950 --> 00:21:08,820
!إنّه لا يروق لي أيضًا

255
00:21:15,920 --> 00:21:19,160
!التّحالف بيننا قائم الآن

256
00:21:19,510 --> 00:21:21,040
!ماذا قلت؟

257
00:21:51,580 --> 00:21:54,780
!دريك

258
00:21:59,710 --> 00:22:04,420
!لا تظنّ أنّ بإمكانك الهرب أيّها الخائن

259
00:22:04,420 --> 00:22:08,880
!لا بدّ أنّك جاسوس

260
00:22:09,850 --> 00:22:13,180
...ثمّة مسخ آخر يسعى خلفك

261
00:22:14,060 --> 00:22:17,230
هل ظننت أنّي سأهزم بهراء كهذا؟

262
00:22:17,230 --> 00:22:18,940
...هذا مؤلم

263
00:22:18,940 --> 00:22:21,230
!مهلاً، تماسك

264
00:22:22,070 --> 00:22:23,980
!هذا مؤلم! اللّعنة

265
00:22:23,980 --> 00:22:27,110
!هل أنت بخير! إنّه جرح سطحيّ

266
00:22:53,100 --> 00:22:54,220
!...هذا

267
00:22:56,690 --> 00:22:58,220
...لا يعقل

268
00:22:58,610 --> 00:23:00,770
...هذه الرّصاصة

269
00:23:18,790 --> 00:23:22,160
!يواصل السّولوغ هزيمة أعدائهم متحدّين قلّتهم

270
00:23:23,000 --> 00:23:25,670
.ومحاربو المينك المتقدّمون يؤرقون جاك

271
00:23:28,940 --> 00:23:31,760
!ويقتربون من عدوّهم اللّدود كايدو أكثر

272
00:23:31,760 --> 00:23:35,680
!ضغينة عُمرها 20 عامًا تحترق كأنّها نيران جحيم

273
00:23:36,470 --> 00:23:41,690
:في الحلقة القادمة من وان بيس
"!نصل بطوليّ! الأكازايا ضدّ كايدو مرّة أخرى"

274
00:23:41,690 --> 00:23:45,690
!ملك القراصنة، لن يكون إلاّ أنا