1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,910
"وأقول "أريد أن أصير أقوى

5
00:01:01,910 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,830 --> 00:03:36,400
،بعد إدراك لوفي لأهمّيّة الصّداقة

38
00:03:36,400 --> 00:03:40,440
وعاد إلى مارينفورد نزولاً عند
.اقتراح لملك الظّلام ريلي

39
00:03:41,400 --> 00:03:44,280
وصلت رسالته إلى بقيّة طاقم قبّعة القشّ

40
00:03:44,280 --> 00:03:48,450
.عبر أخبار تصرّف لوفي الغامض

41
00:03:48,860 --> 00:03:51,660
.لا يقوم لوفي بأمور كهذه

42
00:03:51,660 --> 00:03:53,370
.أعلم أنّ هنالك رسالة ما

43
00:03:53,370 --> 00:03:55,330
!أجل! فهمت يا لوفي

44
00:03:56,460 --> 00:04:00,550
!فهمت الآن! أجل! أجل

45
00:04:01,230 --> 00:04:03,760
.فهمت. هكذا الأمر إذًا

46
00:04:05,510 --> 00:04:09,930
!فهمت يا لوفي

47
00:04:10,860 --> 00:04:12,480
!نعم، نعم

48
00:04:12,930 --> 00:04:17,060
،يا إلهي! إنّه لا يفكّر في مشاعرنا
!يا له من أنانيّ

49
00:04:18,630 --> 00:04:19,820
!فهمت

50
00:04:20,230 --> 00:04:23,200
نعم، أهذا كلّ شيء؟

51
00:04:24,700 --> 00:04:26,670
!فهمت

52
00:04:31,620 --> 00:04:34,870
!لنلتقِ ثانية في أرخبيل شابوندي بعد سنتين

53
00:04:38,030 --> 00:04:42,560
"!يبدأ تدريب لوفي! إلى حيث تواعدنا بعد سنتين"

54
00:04:52,530 --> 00:04:53,930
.ها هو قادم

55
00:04:58,800 --> 00:05:01,400
!جينبي! شكرًا على كلّ شيء

56
00:05:01,400 --> 00:05:05,150
!ماذا تقول؟ أنا من عليه شكرك

57
00:05:11,520 --> 00:05:16,250
رغم أنّني توسّلت إليك أن تحرّرني
،من إمبل داون

58
00:05:16,670 --> 00:05:20,210
.إلاّ أنّي أشعر بالخزي لأنّي ما زلت حيًّا

59
00:05:20,210 --> 00:05:22,300
!أنا آسف

60
00:05:23,660 --> 00:05:26,760
.أخبرتك ألاّ تقول أشياء كهذه

61
00:05:27,210 --> 00:05:28,900
،لولاك يا جينبي

62
00:05:28,900 --> 00:05:32,890
على الأرجح أنّي ما كنت لأستطيع
!الوصول لمقرّ البحريّة

63
00:05:46,300 --> 00:05:47,820
.أنت على حقّ

64
00:05:48,390 --> 00:05:52,910
ربّما ما زال هنالك شيء ما أستطيع
.فعله من أجلك في المستقبل

65
00:05:54,000 --> 00:05:57,540
في كلّ الأحوال، سألقاك في جزيرة
!البرمائيّين بعد سنتين

66
00:05:57,960 --> 00:06:02,360
أتطلّع قُدمًا لليوم الّذي ستزورنا
!فيه أنت وأصدقاؤك

67
00:06:02,360 --> 00:06:03,500
!نعم

68
00:06:06,340 --> 00:06:08,130
!مع السّلامة

69
00:06:11,360 --> 00:06:15,060
.لوفي، أنا سعيدة أنّك وقفت على قديمك ثانية

70
00:06:15,060 --> 00:06:20,310
...يداك وابتسامتك وكلّ تصرّفاتك العفويّة

71
00:06:20,310 --> 00:06:22,900
!تجعل قلبي يخفق ويرتعش

72
00:06:22,900 --> 00:06:27,950
قد أموت من هذا الارتعاش
!إن لم يحدث أيّ شيء

73
00:06:31,030 --> 00:06:32,100
...أشعر بالدّوار

74
00:06:32,740 --> 00:06:34,540
هل أنت بخير يا هانكوك؟

75
00:06:38,040 --> 00:06:39,920
!لا تقلق

76
00:06:41,040 --> 00:06:43,760
.نودّ منك الذّهاب إلى نقطة التّدريب

77
00:06:43,760 --> 00:06:46,340
هل بإمكانك أخذنا إلى هناك الآن؟

78
00:06:46,340 --> 00:06:48,470
!حـ-حسنًا

79
00:06:48,470 --> 00:06:51,050
!هيّا، لنبحر إلى روسكاينا

80
00:06:51,050 --> 00:06:53,630
!حالاً يا أميرة الثّعابين-ساما

81
00:07:02,100 --> 00:07:04,270
.هذه الجزيرة مثاليّة

82
00:07:04,270 --> 00:07:08,990
بها 48 فصلاً في السّنة، لذلك تتغيّر
.كلّ أسبوع. إنّه جزيرة قاسية

83
00:07:09,400 --> 00:07:12,440
.فعلاً؟ هكذا إذًا

84
00:07:14,370 --> 00:07:15,870
!لوفي

85
00:07:15,870 --> 00:07:22,790
!سأحضر لك الطّعام كلّ يوم من جزيرة النّساء

86
00:07:22,790 --> 00:07:25,840
!ماذا؟! فعلاً يا هانكوك؟

87
00:07:25,840 --> 00:07:28,990
هل بإمكانك إحضار طبق الغورغون الخاصّ أو ما شابه؟

88
00:07:28,990 --> 00:07:30,970
!لقد كان لذيذًا

89
00:07:30,970 --> 00:07:32,720
!بـ-بالطّبع

90
00:07:32,720 --> 00:07:35,430
!أجل يا أميرة الثّعابين-ساما

91
00:07:35,880 --> 00:07:39,240
!أستطيع إحضار أيّ شيء تريد بقدر ما تريد

92
00:07:40,140 --> 00:07:44,220
!وكانت تلك عاشر مرّة تقول فيها اسمي

93
00:07:46,360 --> 00:07:49,190
!ذ-ذلك يعني أنّنا مخطوبان الآن

94
00:07:49,190 --> 00:07:53,780
كلاّ! ولماذا تتراجعين إلى الخلف؟

95
00:07:53,780 --> 00:07:56,660
!قلتِ أنّكما متزوّجان منذ وهلة فقط

96
00:07:57,450 --> 00:08:01,540
!هانكوك! لا أريدك أن تدلّليه هكذا

97
00:08:02,080 --> 00:08:06,170
لن يُسمح بتواجد النّساء هنا بينما
!يتدرّب لوفي-كُن

98
00:08:06,170 --> 00:08:06,840
!ماذا؟

99
00:08:08,170 --> 00:08:12,720
!من منحك الحقّ لتقرّر مثل هذه الأشياء يا ريلي؟

100
00:08:12,720 --> 00:08:16,090
!سأحوّلك إلى حجر حسب جوابك

101
00:08:16,510 --> 00:08:21,560
بإمكاننا العثور على أشياء نأكلها
!في الجبال والغابات والأنهار والبحر

102
00:08:22,000 --> 00:08:24,600
!اتركي أنفه! توقّفي يا أميرة الثّعابين

103
00:08:24,600 --> 00:08:29,020
!إن لم يستطع العيش هكذا، فلا يجب أن يكون قرصانًا

104
00:08:29,020 --> 00:08:31,950
!كلّ هذا من أجل مصلحة لوفي-كُن

105
00:08:33,070 --> 00:08:36,170
أقلتَ من أجل مصلحة لوفي؟

106
00:08:37,090 --> 00:08:38,160
.نعم

107
00:08:38,160 --> 00:08:40,340
...من أجل مصلحة لوفي

108
00:08:42,680 --> 00:08:44,040
!سأكون صبورة إذًا

109
00:08:45,540 --> 00:08:49,400
!لكن يا ريلي، هذه الجزيرة خطيرة فعلاً

110
00:08:49,400 --> 00:08:51,000
...إن حدث أيّ مكروه

111
00:08:51,000 --> 00:08:53,760
!لهذا السّبب هي جيّدة لتدريباته

112
00:08:53,760 --> 00:08:55,550
.ادعي له فحسب إن كنت قلقة

113
00:08:56,510 --> 00:08:58,010
هلاّ ذهبنا يا لوفي-كُن؟

114
00:08:58,010 --> 00:08:59,430
!نعم

115
00:09:01,560 --> 00:09:02,810
!لوفي

116
00:09:02,810 --> 00:09:05,230
!حظًّا سعيدًا

117
00:09:05,230 --> 00:09:06,940
!نعم

118
00:09:07,940 --> 00:09:10,440
!لوفي، فلترافقك السّلامة

119
00:09:17,490 --> 00:09:19,660
.عليك تذكّر هذه الشّجرة

120
00:09:21,880 --> 00:09:24,110
.حتّى الوحوش الضّارية لا تقترب منها

121
00:09:24,110 --> 00:09:27,330
.إنّها المنطقة الآمنة الوحيدة على هذه الجزيرة

122
00:09:27,330 --> 00:09:30,950
!فعلاً؟ إنّ شكلها غريب

123
00:09:40,760 --> 00:09:46,390
.حسنًا، نحن البشريّان الوحيدان على هذه الجزيرة

124
00:09:47,270 --> 00:09:49,430
!انظر لكلّ هذه البرّيّة

125
00:09:49,430 --> 00:09:52,400
.سمعتُ أنّه كانت هنالك بلاد قبل مدّة بعيدة

126
00:09:52,400 --> 00:09:55,740
.لكنّ البشر خسروا صراع البقاء ذلك

127
00:09:55,740 --> 00:09:58,860
!الطّبيعة هنا لا تتوانى والأرض قاسية

128
00:10:19,890 --> 00:10:22,470
!أشمّ رائعة مغامرة كبيرة

129
00:10:28,770 --> 00:10:34,400
!ثمّة العديد من الوحوش الضّارية
!إنّها لا تُحصى

130
00:10:35,440 --> 00:10:40,160
ثمّة حوالي 500 كائن حيّ
.يقوف قدراتك الآن

131
00:10:40,950 --> 00:10:44,410
،عليك أن تصير أقوى
.وإلاّ فلن تستطيع النّوم ليلاً

132
00:10:44,410 --> 00:10:48,250
كيف تمكّنت من معرفة وجودها وأعدادها؟

133
00:10:48,600 --> 00:10:52,960
.هذا أمر يخصّك أيضًا. عليك امتلاك هذه القوّة

134
00:10:55,170 --> 00:10:57,340
!تسمّى هذه القّوة الهاكي

135
00:10:59,050 --> 00:11:00,130
هاكي؟

136
00:11:08,180 --> 00:11:11,100
!كلاّ! ثمّة شيء ما هنا أيّها العجوز ريلي

137
00:11:11,630 --> 00:11:13,770
!احذر، إنّه خلفك تمامًا

138
00:11:13,770 --> 00:11:15,440
.اسمع يا لوفي-كُن

139
00:11:15,440 --> 00:11:19,610
!الهاكي قوّة كامنة في الجميع

140
00:11:19,610 --> 00:11:24,030
إنّه فيل! إنّه أكبر من المعتاد بخمسة
!أضعاف! يا له من فيل

141
00:11:25,130 --> 00:11:28,450
...التّواجد والرّوح القتاليّة والتّخويف

142
00:11:28,450 --> 00:11:33,580
إنّها لا تختلف عن الحواسّ
.الّتي يملكها البشر العاديّون

143
00:11:34,460 --> 00:11:38,210
ولكن، لا يُدرك معظمهم قوّتهم

144
00:11:38,210 --> 00:11:41,960
.أو يجهلون كيف يخرجونها حتّى النّهاية

145
00:11:44,590 --> 00:11:46,640
!عدم امتلاك أيّ شكّ

146
00:11:46,640 --> 00:11:48,970
!هذا ما يجعلك قويًّا

147
00:11:51,210 --> 00:11:52,640
!انتبه

148
00:11:54,620 --> 00:11:56,150
!المستوى الثّاني

149
00:11:56,150 --> 00:11:57,780
!المسدّس النّفّاث

150
00:12:06,160 --> 00:12:08,430
!تبًّا... يا له من فيل

151
00:12:08,430 --> 00:12:11,120
!إنّه ليس قويًّا فحسب، بل سريع أيضًا

152
00:12:14,750 --> 00:12:16,740
!شاهد بتمعّن شديد

153
00:12:16,740 --> 00:12:19,300
!يُقسّم الهاكي للونين بارزين

154
00:12:21,170 --> 00:12:22,470
!انتبه

155
00:12:22,470 --> 00:12:23,920
.لا تقلق

156
00:12:23,920 --> 00:12:27,300
.إنّه يحاول ضربي بخرطومه من اليمين

157
00:12:32,850 --> 00:12:36,000
إنّها القوّة للشّعور بتواجد بتواجد
،الآخرين بقوّة أكبر

158
00:12:36,000 --> 00:12:38,360
!وتسمّى هاكي لون الملاحظة

159
00:12:42,570 --> 00:12:43,920
...مذهل

160
00:12:43,920 --> 00:12:48,740
إن حسّنت هذه القوّة، بإمكانك
معرفة أين هو عدوّك المنيع

161
00:12:48,740 --> 00:12:54,000
.وكم أعداد عدوّك وحركتهم التّالية

162
00:12:54,000 --> 00:12:55,370
!ركلة ساق يسرى

163
00:12:56,330 --> 00:12:57,500
.مانترا

164
00:13:02,210 --> 00:13:06,050
!إنّهم يدعونها مانترا في جزيرة السّماء سكايبيا

165
00:13:08,920 --> 00:13:10,120
!هذا خطير

166
00:13:10,890 --> 00:13:13,140
.القوّة التّالية هي هاكي لون التّسلّح

167
00:13:13,140 --> 00:13:16,880
.هذه القوّة أشبه بارتداء درع خفيّة

168
00:13:20,150 --> 00:13:21,730
!أيّها العجوز

169
00:13:32,200 --> 00:13:35,410
.لـ-لقد رأيت هذا من قبل

170
00:13:35,410 --> 00:13:36,830
!دفعة أشيغارا دوكّوي

171
00:13:41,500 --> 00:13:45,840
،إن كانت الدّرع قويّة كفاية
.بالإمكان استعمالها كقوّة هجوميّة

172
00:13:47,760 --> 00:13:51,470
،هذا مؤلم! أنا مطّاطيّ
.لذلك لا يجب أن أشعر بالألم

173
00:13:51,470 --> 00:13:55,180
.هذا جزء فعّال من هذه القوّة

174
00:13:56,110 --> 00:14:00,550
،بدل استغلال نقاط ضعفهم
...هاكي التّسلّح هذا

175
00:14:00,550 --> 00:14:05,970
هو الإجراء المضادّ الفعّال الوحيد
.ضدّ آكلي فاكهة الشّيطان

176
00:14:08,980 --> 00:14:11,440
يبدو آكلو فاكهة الشّيطان من نوع لوغيا

177
00:14:11,440 --> 00:14:14,370
منيعين تقريبًا بسبب أجسادهم المائعة

178
00:14:14,370 --> 00:14:17,160
لكن بالإمكان ضربهم بإجبارهم على
.التّحوّل لحالتهم الصّلبة

179
00:14:17,160 --> 00:14:20,750
!صحيح، لهذا السّبب كان بإمكانك لمس كيزارو

180
00:14:21,120 --> 00:14:23,130
وهذا يعني أنّ بإمكاني ضرب

181
00:14:23,130 --> 00:14:26,090
!أشخاص مثل الدّخانيّ من البحريّة أو أوكيجي

182
00:14:30,860 --> 00:14:34,310
.بإمكانك نقل هذه القوّة لسلاحك أيضًا

183
00:14:34,310 --> 00:14:36,310
هل رأيت سهام الكوجا من قبل؟

184
00:14:36,760 --> 00:14:37,810
...نعم

185
00:14:41,690 --> 00:14:43,270
!كانت أشبه بسهام فولاذيّة

186
00:14:43,930 --> 00:14:46,770
...لون الملاحظة ولون التّسلّح

187
00:14:46,770 --> 00:14:48,820
.إنّهما لونان من الهاكي

188
00:14:49,310 --> 00:14:54,780
ولكن، ثمّة قلّة نادرة من النّاس باستطاعتها
.استعمال لون آخر من الهاكي

189
00:14:59,680 --> 00:15:00,750
.راقب

190
00:15:59,560 --> 00:16:01,980
!كانت تلك القوّة لتخويف عدوّك

191
00:16:02,570 --> 00:16:04,670
!هاكي لون الملك الأسمى

192
00:16:06,550 --> 00:16:09,900
...إنّ أصحاب الأسماء المهمّة

193
00:16:09,900 --> 00:16:13,430
.يملكون هذه القوّة عادة

194
00:16:14,020 --> 00:16:17,140
،ولكن، على عكس النّوعين الآخرين

195
00:16:17,140 --> 00:16:20,540
بإمكانك التّحكّم بهاكي الملك الأسمى ولكن
.لا يمكن تدريب نفسك على استعماله

196
00:16:21,330 --> 00:16:24,020
.هذا لأنّه يمثّل روح مالكه بحدّ ذاتها

197
00:16:24,730 --> 00:16:27,290
!بإمكانك تحسينه فقط بتحسين نفسك

198
00:16:27,290 --> 00:16:31,770
!صحيح، هذا ما فعلته في دار المزاد

199
00:16:33,550 --> 00:16:36,300
.تعلم ما هو الآن

200
00:16:36,300 --> 00:16:40,100
.لقد سبق وأيقظتَ قدرة لون الملك الأسمى سلفًا

201
00:16:42,060 --> 00:16:48,610
!توقّفوا

202
00:17:00,140 --> 00:17:05,200
لكن لا تستعملها حتّى تصبح قادرًا
.على التّحكّم بها بالكامل

203
00:17:05,200 --> 00:17:09,850
.لأنّك قد تخوّف أشخاصًا بريئين من حولك أيضًا

204
00:17:11,880 --> 00:17:14,590
ماذا؟ ما الخطب؟

205
00:17:18,300 --> 00:17:20,430
!هذا مذهل

206
00:17:20,430 --> 00:17:22,320
بإمكان عضو من طاقم ملك القراصنة

207
00:17:22,320 --> 00:17:25,730
!هزيمة هذه الوحوش حتّى دون لمسها

208
00:17:29,500 --> 00:17:31,110
هل تحترمني أكثر الآن؟

209
00:17:32,610 --> 00:17:33,570
!نعم

210
00:17:34,090 --> 00:17:39,700
!لكنّي رأيت قوى الهاكي تلك عدّة مرّات من قبل

211
00:17:39,700 --> 00:17:43,920
شانكس وجدّي وإنيل وأيسا

212
00:17:43,920 --> 00:17:47,210
!وهانكوك ومحاربات الكوجا أيضًا

213
00:17:47,210 --> 00:17:49,190
.نعم، صحيح

214
00:17:49,190 --> 00:17:52,670
.لكنّ تعلّم كيفية استعمال الهاكي ليست سهلة

215
00:17:53,800 --> 00:17:54,920
!نعم

216
00:18:01,930 --> 00:18:06,730
في العادة، كنّا لنحتاج الكثيري
.من الوقت، لكنّك مؤهّل ذلك

217
00:18:07,700 --> 00:18:12,150
سأعلّمك أساسيّات لون الملاحظة ولون التّسلّح

218
00:18:12,150 --> 00:18:15,320
.وحتّى لون الملك الأسمى في سنتين

219
00:18:15,320 --> 00:18:17,240
.نعم

220
00:18:17,240 --> 00:18:24,620
إنّ معظم النّاس يميلون للون
.واحد حسب ما يفضّلون

221
00:18:24,620 --> 00:18:29,170
.يكتشفون أيّ لون يفضّلون ويحسّنونه

222
00:18:29,170 --> 00:18:31,180
،لكن إن استطعت تحسين كلّ واحد منها

223
00:18:31,180 --> 00:18:33,290
.بإمكانك توسيع ما أنت قادر عليه

224
00:18:33,290 --> 00:18:35,160
.نعم، فهمت

225
00:18:36,660 --> 00:18:38,510
،والآن

226
00:18:38,940 --> 00:18:42,800
!لستُ سهلاً كمدرّب يا لوفي

227
00:18:43,830 --> 00:18:45,970
!نعم، أتطلّع قدمًا لذلك

228
00:18:58,700 --> 00:19:00,370
...والآن، هيّا

229
00:19:00,370 --> 00:19:01,240
!مهلاً لحظة

230
00:19:06,740 --> 00:19:11,420
إن كنت على حقّ، فقد قال أنّ هذا
.هو المكان الآمن الوحيد

231
00:19:13,790 --> 00:19:18,610
.سيأخذ قبّعة القشّ لوفي القرصان استراحة لفترة

232
00:19:42,740 --> 00:19:44,910
!إيس! لوفي

233
00:19:45,670 --> 00:19:48,910
!علينا الإبحار يومًا ما

234
00:19:48,910 --> 00:19:51,790
!لنخرج من هذه البلاد ونعش بحرّيّة

235
00:19:52,320 --> 00:19:55,540
!لنغدُ أقوى ونصبح قراصنة يومًا ما

236
00:19:57,440 --> 00:20:02,970
!سأصير قرصانًا وسأهزم البقيّة وسيُذاع صيتي

237
00:20:03,360 --> 00:20:06,220
!سأكون الدّليل الوحيد على حياتي

238
00:20:07,760 --> 00:20:10,790
!...فهمت! في تلك الحالة

239
00:20:12,810 --> 00:20:15,840
!...سأصبح

240
00:20:29,490 --> 00:20:31,580
!نعم

241
00:20:33,290 --> 00:20:34,500
.هذه أيضًا

242
00:20:40,280 --> 00:20:41,920
...يا رفاق

243
00:20:42,970 --> 00:20:50,270
!لوفي

244
00:20:50,270 --> 00:20:51,520
!لوفي-سان

245
00:20:53,140 --> 00:20:54,920
!لوفي

246
00:20:59,360 --> 00:21:02,660
!هيّا، أسرع! علينا أن نبدأ

247
00:21:03,610 --> 00:21:05,000
!مفهوم

248
00:21:14,520 --> 00:21:16,370
!لنبدأ أيّها العجوز

249
00:21:18,210 --> 00:21:21,980
."كلاّ، عليك قول "شكرًا يا ريلي-سان

250
00:21:21,980 --> 00:21:25,530
لا، بل يا ريلي-سينسي... أم معلّم...؟

251
00:21:25,530 --> 00:21:27,430
!شكرًا يا ريلي

252
00:21:27,850 --> 00:21:30,310
!حسنًا، لا يهمّ

253
00:21:38,590 --> 00:21:43,990
سنجمع كلّ أحلامنا

254
00:21:43,990 --> 00:21:49,570
ونبحر باحثين عن شيء، باحثين عن

255
00:21:49,940 --> 00:21:51,330
!وان بيس

256
00:21:55,870 --> 00:22:01,720
لا تجلب البوصلات سوى التّأخيرات

257
00:22:01,720 --> 00:22:06,820
هذيان مع سخونة، آخذ المقود

258
00:22:07,430 --> 00:22:18,180
إن تمّ التّحقّق من خريطة الكنز المغبرة
!فإنّها ليست أسطورة إذًا

259
00:22:19,560 --> 00:22:25,110
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

260
00:22:25,110 --> 00:22:30,420
فاركب مع إيقاع أحدهم الحيويّ فحسب

261
00:22:30,420 --> 00:22:33,080
!وتظاهر أنّها غير موجودة

262
00:22:34,200 --> 00:22:39,500
سنجمع كلّ أحلامنا

263
00:22:39,500 --> 00:22:45,500
ونبحر باحثين عن شيء، باحثين عن

264
00:22:45,500 --> 00:22:51,390
عملة في جيبي، وتريد أن تصبح صديقي؟

265
00:22:51,680 --> 00:22:57,000
!إنّنا... إنّنا في رحلة بحرية

266
00:22:57,000 --> 00:22:58,500
!إنّنا كذلك

267
00:23:02,690 --> 00:23:06,160
!زورو! أوسوبّ! سانجي! نامي

268
00:23:06,160 --> 00:23:09,490
!تشوبّر! روبين! فرانكي! بروك

269
00:23:09,490 --> 00:23:11,990
!وإيس وسابو أيضًا

270
00:23:11,990 --> 00:23:14,580
...لقطع ذلك العهد ثانية

271
00:23:14,580 --> 00:23:17,040
!سأصير أقوى

272
00:23:17,040 --> 00:23:18,480
!نحن كذلك

273
00:23:25,450 --> 00:23:27,740
،بعد سنتين من حرب القمّة

274
00:23:27,740 --> 00:23:30,840
حان الوقت للمّ شمل طاقم قبّعة القشّ

275
00:23:30,840 --> 00:23:34,350
بقواهم الجديدة الّتي حصلوا عليها
!من خلال تدريبهم

276
00:23:34,350 --> 00:23:36,350
إنّ البحر الأخير في الغراند لاين

277
00:23:36,350 --> 00:23:39,810
المعروف بالعالم الجديد صوب أعين لوفي
!وأصدقائه الّذين سيبحرون ثانية فيه

278
00:23:39,810 --> 00:23:41,410
:في الحلقة القادمة من وان بيس

279
00:23:41,410 --> 00:23:44,900
"!بداية الفصل الجديد! لمّ شمل طاقم قبّعة القشّ"

280
00:23:44,900 --> 00:23:47,550
!ملك القراصنة، لن يكون إلاّ أنا

281
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة