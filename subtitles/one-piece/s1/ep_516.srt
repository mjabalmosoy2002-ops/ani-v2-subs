1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,830 --> 00:03:22,400
،بعد إدراك لوفي لأهمّيّة الصّداقة

38
00:03:22,400 --> 00:03:26,440
وعاد إلى مارينفورد نزولاً عند
.اقتراح لملك الظّلام ريلي

39
00:03:27,400 --> 00:03:30,280
وصلت رسالته إلى بقيّة طاقم قبّعة القشّ

40
00:03:30,280 --> 00:03:34,450
.عبر أخبار تصرّف لوفي الغامض

41
00:03:34,860 --> 00:03:37,660
.لا يقوم لوفي بأمور كهذه

42
00:03:37,660 --> 00:03:39,370
.أعلم أنّ هنالك رسالة ما

43
00:03:39,370 --> 00:03:41,330
!أجل! فهمت يا لوفي

44
00:03:42,460 --> 00:03:46,550
!فهمت الآن! أجل! أجل

45
00:03:47,230 --> 00:03:49,760
.فهمت. هكذا الأمر إذًا

46
00:03:51,510 --> 00:03:55,930
!فهمت يا لوفي

47
00:03:56,860 --> 00:03:58,480
!نعم، نعم

48
00:03:58,930 --> 00:04:03,060
،يا إلهي! إنّه لا يفكّر في مشاعرنا
!يا له من أنانيّ

49
00:04:04,630 --> 00:04:05,820
!فهمت

50
00:04:06,230 --> 00:04:09,200
نعم، أهذا كلّ شيء؟

51
00:04:10,700 --> 00:04:12,670
!فهمت

52
00:04:17,620 --> 00:04:20,870
!لنلتقِ ثانية في أرخبيل شابوندي بعد سنتين

53
00:04:24,030 --> 00:04:28,560
"!يبدأ تدريب لوفي! إلى حيث تواعدنا بعد سنتين"

54
00:04:38,530 --> 00:04:39,930
.ها هو قادم

55
00:04:44,800 --> 00:04:47,400
!جينبي! شكرًا على كلّ شيء

56
00:04:47,400 --> 00:04:51,150
!ماذا تقول؟ أنا من عليه شكرك

57
00:04:57,520 --> 00:05:02,250
رغم أنّني توسّلت إليك أن تحرّرني
،من إمبل داون

58
00:05:02,670 --> 00:05:06,210
.إلاّ أنّي أشعر بالخزي لأنّي ما زلت حيًّا

59
00:05:06,210 --> 00:05:08,300
!أنا آسف

60
00:05:09,660 --> 00:05:12,760
.أخبرتك ألاّ تقول أشياء كهذه

61
00:05:13,210 --> 00:05:14,900
،لولاك يا جينبي

62
00:05:14,900 --> 00:05:18,890
على الأرجح أنّي ما كنت لأستطيع
!الوصول لمقرّ البحريّة

63
00:05:32,300 --> 00:05:33,820
.أنت على حقّ

64
00:05:34,390 --> 00:05:38,910
ربّما ما زال هنالك شيء ما أستطيع
.فعله من أجلك في المستقبل

65
00:05:40,000 --> 00:05:43,540
في كلّ الأحوال، سألقاك في جزيرة
!البرمائيّين بعد سنتين

66
00:05:43,960 --> 00:05:48,360
أتطلّع قُدمًا لليوم الّذي ستزورنا
!فيه أنت وأصدقاؤك

67
00:05:48,360 --> 00:05:49,500
!نعم

68
00:05:52,340 --> 00:05:54,130
!مع السّلامة

69
00:05:57,360 --> 00:06:01,060
.لوفي، أنا سعيدة أنّك وقفت على قديمك ثانية

70
00:06:01,060 --> 00:06:06,310
...يداك وابتسامتك وكلّ تصرّفاتك العفويّة

71
00:06:06,310 --> 00:06:08,900
!تجعل قلبي يخفق ويرتعش

72
00:06:08,900 --> 00:06:13,950
قد أموت من هذا الارتعاش
!إن لم يحدث أيّ شيء

73
00:06:17,030 --> 00:06:18,100
...أشعر بالدّوار

74
00:06:18,740 --> 00:06:20,540
هل أنت بخير يا هانكوك؟

75
00:06:24,040 --> 00:06:25,920
!لا تقلق

76
00:06:27,040 --> 00:06:29,760
.نودّ منك الذّهاب إلى نقطة التّدريب

77
00:06:29,760 --> 00:06:32,340
هل بإمكانك أخذنا إلى هناك الآن؟

78
00:06:32,340 --> 00:06:34,470
!حـ-حسنًا

79
00:06:34,470 --> 00:06:37,050
!هيّا، لنبحر إلى روسكاينا

80
00:06:37,050 --> 00:06:39,630
!حالاً يا أميرة الثّعابين-ساما

81
00:06:48,100 --> 00:06:50,270
.هذه الجزيرة مثاليّة

82
00:06:50,270 --> 00:06:54,990
بها 48 فصلاً في السّنة، لذلك تتغيّر
.كلّ أسبوع. إنّه جزيرة قاسية

83
00:06:55,400 --> 00:06:58,440
.فعلاً؟ هكذا إذًا

84
00:07:00,370 --> 00:07:01,870
!لوفي

85
00:07:01,870 --> 00:07:08,790
!سأحضر لك الطّعام كلّ يوم من جزيرة النّساء

86
00:07:08,790 --> 00:07:11,840
!ماذا؟! فعلاً يا هانكوك؟

87
00:07:11,840 --> 00:07:14,990
هل بإمكانك إحضار طبق الغورغون الخاصّ أو ما شابه؟

88
00:07:14,990 --> 00:07:16,970
!لقد كان لذيذًا

89
00:07:16,970 --> 00:07:18,720
!بـ-بالطّبع

90
00:07:18,720 --> 00:07:21,430
!أجل يا أميرة الثّعابين-ساما

91
00:07:21,880 --> 00:07:25,240
!أستطيع إحضار أيّ شيء تريد بقدر ما تريد

92
00:07:26,140 --> 00:07:30,220
!وكانت تلك عاشر مرّة تقول فيها اسمي

93
00:07:32,360 --> 00:07:35,190
!ذ-ذلك يعني أنّنا مخطوبان الآن

94
00:07:35,190 --> 00:07:39,780
كلاّ! ولماذا تتراجعين إلى الخلف؟

95
00:07:39,780 --> 00:07:42,660
!قلتِ أنّكما متزوّجان منذ وهلة فقط

96
00:07:43,450 --> 00:07:47,540
!هانكوك! لا أريدك أن تدلّليه هكذا

97
00:07:48,080 --> 00:07:52,170
لن يُسمح بتواجد النّساء هنا بينما
!يتدرّب لوفي-كُن

98
00:07:52,170 --> 00:07:52,840
!ماذا؟

99
00:07:54,170 --> 00:07:58,720
!من منحك الحقّ لتقرّر مثل هذه الأشياء يا ريلي؟

100
00:07:58,720 --> 00:08:02,090
!سأحوّلك إلى حجر حسب جوابك

101
00:08:02,510 --> 00:08:07,560
بإمكاننا العثور على أشياء نأكلها
!في الجبال والغابات والأنهار والبحر

102
00:08:08,000 --> 00:08:10,600
!اتركي أنفه! توقّفي يا أميرة الثّعابين

103
00:08:10,600 --> 00:08:15,020
!إن لم يستطع العيش هكذا، فلا يجب أن يكون قرصانًا

104
00:08:15,020 --> 00:08:17,950
!كلّ هذا من أجل مصلحة لوفي-كُن

105
00:08:19,070 --> 00:08:22,170
أقلتَ من أجل مصلحة لوفي؟

106
00:08:23,090 --> 00:08:24,160
.نعم

107
00:08:24,160 --> 00:08:26,340
...من أجل مصلحة لوفي

108
00:08:28,680 --> 00:08:30,040
!سأكون صبورة إذًا

109
00:08:31,540 --> 00:08:35,400
!لكن يا ريلي، هذه الجزيرة خطيرة فعلاً

110
00:08:35,400 --> 00:08:37,000
...إن حدث أيّ مكروه

111
00:08:37,000 --> 00:08:39,760
!لهذا السّبب هي جيّدة لتدريباته

112
00:08:39,760 --> 00:08:41,550
.ادعي له فحسب إن كنت قلقة

113
00:08:42,510 --> 00:08:44,010
هلاّ ذهبنا يا لوفي-كُن؟

114
00:08:44,010 --> 00:08:45,430
!نعم

115
00:08:47,560 --> 00:08:48,810
!لوفي

116
00:08:48,810 --> 00:08:51,230
!حظًّا سعيدًا

117
00:08:51,230 --> 00:08:52,940
!نعم

118
00:08:53,940 --> 00:08:56,440
!لوفي، فلترافقك السّلامة

119
00:09:03,490 --> 00:09:05,660
.عليك تذكّر هذه الشّجرة

120
00:09:07,880 --> 00:09:10,110
.حتّى الوحوش الضّارية لا تقترب منها

121
00:09:10,110 --> 00:09:13,330
.إنّها المنطقة الآمنة الوحيدة على هذه الجزيرة

122
00:09:13,330 --> 00:09:16,950
!فعلاً؟ إنّ شكلها غريب

123
00:09:26,760 --> 00:09:32,390
.حسنًا، نحن البشريّان الوحيدان على هذه الجزيرة

124
00:09:33,270 --> 00:09:35,430
!انظر لكلّ هذه البرّيّة

125
00:09:35,430 --> 00:09:38,400
.سمعتُ أنّه كانت هنالك بلاد قبل مدّة بعيدة

126
00:09:38,400 --> 00:09:41,740
.لكنّ البشر خسروا صراع البقاء ذلك

127
00:09:41,740 --> 00:09:44,860
!الطّبيعة هنا لا تتوانى والأرض قاسية

128
00:10:05,890 --> 00:10:08,470
!أشمّ رائعة مغامرة كبيرة

129
00:10:14,770 --> 00:10:20,400
!ثمّة العديد من الوحوش الضّارية
!إنّها لا تُحصى

130
00:10:21,440 --> 00:10:26,160
ثمّة حوالي 500 كائن حيّ
.يقوف قدراتك الآن

131
00:10:26,950 --> 00:10:30,410
،عليك أن تصير أقوى
.وإلاّ فلن تستطيع النّوم ليلاً

132
00:10:30,410 --> 00:10:34,250
كيف تمكّنت من معرفة وجودها وأعدادها؟

133
00:10:34,600 --> 00:10:38,960
.هذا أمر يخصّك أيضًا. عليك امتلاك هذه القوّة

134
00:10:41,170 --> 00:10:43,340
!تسمّى هذه القّوة الهاكي

135
00:10:45,050 --> 00:10:46,130
هاكي؟

136
00:10:54,180 --> 00:10:57,100
!كلاّ! ثمّة شيء ما هنا أيّها العجوز ريلي

137
00:10:57,630 --> 00:10:59,770
!احذر، إنّه خلفك تمامًا

138
00:10:59,770 --> 00:11:01,440
.اسمع يا لوفي-كُن

139
00:11:01,440 --> 00:11:05,610
!الهاكي قوّة كامنة في الجميع

140
00:11:05,610 --> 00:11:10,030
إنّه فيل! إنّه أكبر من المعتاد بخمسة
!أضعاف! يا له من فيل

141
00:11:11,130 --> 00:11:14,450
...التّواجد والرّوح القتاليّة والتّخويف

142
00:11:14,450 --> 00:11:19,580
إنّها لا تختلف عن الحواسّ
.الّتي يملكها البشر العاديّون

143
00:11:20,460 --> 00:11:24,210
ولكن، لا يُدرك معظمهم قوّتهم

144
00:11:24,210 --> 00:11:27,960
.أو يجهلون كيف يخرجونها حتّى النّهاية

145
00:11:30,590 --> 00:11:32,640
!عدم امتلاك أيّ شكّ

146
00:11:32,640 --> 00:11:34,970
!هذا ما يجعلك قويًّا

147
00:11:37,210 --> 00:11:38,640
!انتبه

148
00:11:40,620 --> 00:11:42,150
!المستوى الثّاني

149
00:11:42,150 --> 00:11:43,780
!المسدّس النّفّاث

150
00:11:52,160 --> 00:11:54,430
!تبًّا... يا له من فيل

151
00:11:54,430 --> 00:11:57,120
!إنّه ليس قويًّا فحسب، بل سريع أيضًا

152
00:12:00,750 --> 00:12:02,740
!شاهد بتمعّن شديد

153
00:12:02,740 --> 00:12:05,300
!يُقسّم الهاكي للونين بارزين

154
00:12:07,170 --> 00:12:08,470
!انتبه

155
00:12:08,470 --> 00:12:09,920
.لا تقلق

156
00:12:09,920 --> 00:12:13,300
.إنّه يحاول ضربي بخرطومه من اليمين

157
00:12:18,850 --> 00:12:22,000
إنّها القوّة للشّعور بتواجد بتواجد
،الآخرين بقوّة أكبر

158
00:12:22,000 --> 00:12:24,360
!وتسمّى هاكي لون الملاحظة

159
00:12:28,570 --> 00:12:29,920
...مذهل

160
00:12:29,920 --> 00:12:34,740
إن حسّنت هذه القوّة، بإمكانك
معرفة أين هو عدوّك المنيع

161
00:12:34,740 --> 00:12:40,000
.وكم أعداد عدوّك وحركتهم التّالية

162
00:12:40,000 --> 00:12:41,370
!ركلة ساق يسرى

163
00:12:42,330 --> 00:12:43,500
.مانترا

164
00:12:48,210 --> 00:12:52,050
!إنّهم يدعونها مانترا في جزيرة السّماء سكايبيا

165
00:12:54,920 --> 00:12:56,120
!هذا خطير

166
00:12:56,890 --> 00:12:59,140
.القوّة التّالية هي هاكي لون التّسلّح

167
00:12:59,140 --> 00:13:02,880
.هذه القوّة أشبه بارتداء درع خفيّة

168
00:13:06,150 --> 00:13:07,730
!أيّها العجوز

169
00:13:18,200 --> 00:13:21,410
.لـ-لقد رأيت هذا من قبل

170
00:13:21,410 --> 00:13:22,830
!دفعة أشيغارا دوكّوي

171
00:13:27,500 --> 00:13:31,840
،إن كانت الدّرع قويّة كفاية
.بالإمكان استعمالها كقوّة هجوميّة

172
00:13:33,760 --> 00:13:37,470
،هذا مؤلم! أنا مطّاطيّ
.لذلك لا يجب أن أشعر بالألم

173
00:13:37,470 --> 00:13:41,180
.هذا جزء فعّال من هذه القوّة

174
00:13:42,110 --> 00:13:46,550
،بدل استغلال نقاط ضعفهم
...هاكي التّسلّح هذا

175
00:13:46,550 --> 00:13:51,970
هو الإجراء المضادّ الفعّال الوحيد
.ضدّ آكلي فاكهة الشّيطان

176
00:13:54,980 --> 00:13:57,440
يبدو آكلو فاكهة الشّيطان من نوع لوغيا

177
00:13:57,440 --> 00:14:00,370
منيعين تقريبًا بسبب أجسادهم المائعة

178
00:14:00,370 --> 00:14:03,160
لكن بالإمكان ضربهم بإجبارهم على
.التّحوّل لحالتهم الصّلبة

179
00:14:03,160 --> 00:14:06,750
!صحيح، لهذا السّبب كان بإمكانك لمس كيزارو

180
00:14:07,120 --> 00:14:09,130
وهذا يعني أنّ بإمكاني ضرب

181
00:14:09,130 --> 00:14:12,090
!أشخاص مثل الدّخانيّ من البحريّة أو أوكيجي

182
00:14:16,860 --> 00:14:20,310
.بإمكانك نقل هذه القوّة لسلاحك أيضًا

183
00:14:20,310 --> 00:14:22,310
هل رأيت سهام الكوجا من قبل؟

184
00:14:22,760 --> 00:14:23,810
...نعم

185
00:14:27,690 --> 00:14:29,270
!كانت أشبه بسهام فولاذيّة

186
00:14:29,930 --> 00:14:32,770
...لون الملاحظة ولون التّسلّح

187
00:14:32,770 --> 00:14:34,820
.إنّهما لونان من الهاكي

188
00:14:35,310 --> 00:14:40,780
ولكن، ثمّة قلّة نادرة من النّاس باستطاعتها
.استعمال لون آخر من الهاكي

189
00:14:45,680 --> 00:14:46,750
.راقب

190
00:15:45,560 --> 00:15:47,980
!كانت تلك القوّة لتخويف عدوّك

191
00:15:48,570 --> 00:15:50,670
!هاكي لون الملك الأسمى

192
00:15:52,550 --> 00:15:55,900
...إنّ أصحاب الأسماء المهمّة

193
00:15:55,900 --> 00:15:59,430
.يملكون هذه القوّة عادة

194
00:16:00,020 --> 00:16:03,140
،ولكن، على عكس النّوعين الآخرين

195
00:16:03,140 --> 00:16:06,540
بإمكانك التّحكّم بهاكي الملك الأسمى ولكن
.لا يمكن تدريب نفسك على استعماله

196
00:16:07,330 --> 00:16:10,020
.هذا لأنّه يمثّل روح مالكه بحدّ ذاتها

197
00:16:10,730 --> 00:16:13,290
!بإمكانك تحسينه فقط بتحسين نفسك

198
00:16:13,290 --> 00:16:17,770
!صحيح، هذا ما فعلته في دار المزاد

199
00:16:19,550 --> 00:16:22,300
.تعلم ما هو الآن

200
00:16:22,300 --> 00:16:26,100
.لقد سبق وأيقظتَ قدرة لون الملك الأسمى سلفًا

201
00:16:28,060 --> 00:16:34,610
!توقّفوا

202
00:16:46,140 --> 00:16:51,200
لكن لا تستعملها حتّى تصبح قادرًا
.على التّحكّم بها بالكامل

203
00:16:51,200 --> 00:16:55,850
.لأنّك قد تخوّف أشخاصًا بريئين من حولك أيضًا

204
00:16:57,880 --> 00:17:00,590
ماذا؟ ما الخطب؟

205
00:17:04,300 --> 00:17:06,430
!هذا مذهل

206
00:17:06,430 --> 00:17:08,320
بإمكان عضو من طاقم ملك القراصنة

207
00:17:08,320 --> 00:17:11,730
!هزيمة هذه الوحوش حتّى دون لمسها

208
00:17:15,500 --> 00:17:17,110
هل تحترمني أكثر الآن؟

209
00:17:18,610 --> 00:17:19,570
!نعم

210
00:17:20,090 --> 00:17:25,700
!لكنّي رأيت قوى الهاكي تلك عدّة مرّات من قبل

211
00:17:25,700 --> 00:17:29,920
شانكس وجدّي وإنيل وأيسا

212
00:17:29,920 --> 00:17:33,210
!وهانكوك ومحاربات الكوجا أيضًا

213
00:17:33,210 --> 00:17:35,190
.نعم، صحيح

214
00:17:35,190 --> 00:17:38,670
.لكنّ تعلّم كيفية استعمال الهاكي ليست سهلة

215
00:17:39,800 --> 00:17:40,920
!نعم

216
00:17:47,930 --> 00:17:52,730
في العادة، كنّا لنحتاج الكثيري
.من الوقت، لكنّك مؤهّل ذلك

217
00:17:53,700 --> 00:17:58,150
سأعلّمك أساسيّات لون الملاحظة ولون التّسلّح

218
00:17:58,150 --> 00:18:01,320
.وحتّى لون الملك الأسمى في سنتين

219
00:18:01,320 --> 00:18:03,240
.نعم

220
00:18:03,240 --> 00:18:10,620
إنّ معظم النّاس يميلون للون
.واحد حسب ما يفضّلون

221
00:18:10,620 --> 00:18:15,170
.يكتشفون أيّ لون يفضّلون ويحسّنونه

222
00:18:15,170 --> 00:18:17,180
،لكن إن استطعت تحسين كلّ واحد منها

223
00:18:17,180 --> 00:18:19,290
.بإمكانك توسيع ما أنت قادر عليه

224
00:18:19,290 --> 00:18:21,160
.نعم، فهمت

225
00:18:22,660 --> 00:18:24,510
،والآن

226
00:18:24,940 --> 00:18:28,800
!لستُ سهلاً كمدرّب يا لوفي

227
00:18:29,830 --> 00:18:31,970
!نعم، أتطلّع قدمًا لذلك

228
00:18:44,700 --> 00:18:46,370
...والآن، هيّا

229
00:18:46,370 --> 00:18:47,240
!مهلاً لحظة

230
00:18:52,740 --> 00:18:57,420
إن كنت على حقّ، فقد قال أنّ هذا
.هو المكان الآمن الوحيد

231
00:18:59,790 --> 00:19:04,610
.سيأخذ قبّعة القشّ لوفي القرصان استراحة لفترة

232
00:19:28,740 --> 00:19:30,910
!إيس! لوفي

233
00:19:31,670 --> 00:19:34,910
!علينا الإبحار يومًا ما

234
00:19:34,910 --> 00:19:37,790
!لنخرج من هذه البلاد ونعش بحرّيّة

235
00:19:38,320 --> 00:19:41,540
!لنغدُ أقوى ونصبح قراصنة يومًا ما

236
00:19:43,440 --> 00:19:48,970
!سأصير قرصانًا وسأهزم البقيّة وسيُذاع صيتي

237
00:19:49,360 --> 00:19:52,220
!سأكون الدّليل الوحيد على حياتي

238
00:19:53,760 --> 00:19:56,790
!...فهمت! في تلك الحالة

239
00:19:58,810 --> 00:20:01,840
!...سأصبح

240
00:20:15,490 --> 00:20:17,580
!نعم

241
00:20:19,290 --> 00:20:20,500
.هذه أيضًا

242
00:20:26,280 --> 00:20:27,920
...يا رفاق

243
00:20:28,970 --> 00:20:36,270
!لوفي

244
00:20:36,270 --> 00:20:37,520
!لوفي-سان

245
00:20:39,140 --> 00:20:40,920
!لوفي

246
00:20:45,360 --> 00:20:48,660
!هيّا، أسرع! علينا أن نبدأ

247
00:20:49,610 --> 00:20:51,000
!مفهوم

248
00:21:00,520 --> 00:21:02,370
!لنبدأ أيّها العجوز

249
00:21:04,210 --> 00:21:07,980
."كلاّ، عليك قول "شكرًا يا ريلي-سان

250
00:21:07,980 --> 00:21:11,530
لا، بل يا ريلي-سينسي... أم معلّم...؟

251
00:21:11,530 --> 00:21:13,430
!شكرًا يا ريلي

252
00:21:13,850 --> 00:21:16,310
!حسنًا، لا يهمّ

253
00:21:24,590 --> 00:21:29,990
سنجمع كلّ أحلامنا

254
00:21:29,990 --> 00:21:35,570
ونبحر باحثين عن شيء، باحثين عن

255
00:21:35,940 --> 00:21:37,330
!وان بيس

256
00:21:41,870 --> 00:21:47,720
لا تجلب البوصلات سوى التّأخيرات

257
00:21:47,720 --> 00:21:52,820
هذيان مع سخونة، آخذ المقود

258
00:21:53,430 --> 00:22:04,180
إن تمّ التّحقّق من خريطة الكنز المغبرة
!فإنّها ليست أسطورة إذًا

259
00:22:05,560 --> 00:22:11,110
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

260
00:22:11,110 --> 00:22:16,420
فاركب مع إيقاع أحدهم الحيويّ فحسب

261
00:22:16,420 --> 00:22:19,080
!وتظاهر أنّها غير موجودة

262
00:22:20,200 --> 00:22:25,500
سنجمع كلّ أحلامنا

263
00:22:25,500 --> 00:22:31,500
ونبحر باحثين عن شيء، باحثين عن

264
00:22:31,500 --> 00:22:37,390
عملة في جيبي، وتريد أن تصبح صديقي؟

265
00:22:37,680 --> 00:22:43,000
!إنّنا... إنّنا في رحلة بحرية

266
00:22:43,000 --> 00:22:44,500
!إنّنا كذلك

267
00:22:48,690 --> 00:22:52,160
!زورو! أوسوبّ! سانجي! نامي

268
00:22:52,160 --> 00:22:55,490
!تشوبّر! روبين! فرانكي! بروك

269
00:22:55,490 --> 00:22:57,990
!وإيس وسابو أيضًا

270
00:22:57,990 --> 00:23:00,580
...لقطع ذلك العهد ثانية

271
00:23:00,580 --> 00:23:03,040
!سأصير أقوى

272
00:23:03,040 --> 00:23:04,480
!نحن كذلك

273
00:23:11,450 --> 00:23:13,740
،بعد سنتين من حرب القمّة

274
00:23:13,740 --> 00:23:16,840
حان الوقت للمّ شمل طاقم قبّعة القشّ

275
00:23:16,840 --> 00:23:20,350
بقواهم الجديدة الّتي حصلوا عليها
!من خلال تدريبهم

276
00:23:20,350 --> 00:23:22,350
إنّ البحر الأخير في الغراند لاين

277
00:23:22,350 --> 00:23:25,810
المعروف بالعالم الجديد صوب أعين لوفي
!وأصدقائه الّذين سيبحرون ثانية فيه

278
00:23:25,810 --> 00:23:27,410
:في الحلقة القادمة من وان بيس

279
00:23:27,410 --> 00:23:30,900
"!بداية الفصل الجديد! لمّ شمل طاقم قبّعة القشّ"

280
00:23:30,900 --> 00:23:33,550
!ملك القراصنة، لن يكون إلاّ أنا

281
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة