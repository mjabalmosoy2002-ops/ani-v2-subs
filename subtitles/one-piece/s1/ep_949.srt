1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:56,880 --> 00:02:00,000
!يدعوه النّاس بأسلوب الكابّا

29
00:02:02,260 --> 00:02:04,550
!نهر القصاص

30
00:02:11,970 --> 00:02:14,810
هل كانت الأسماك المسمومة لذيذة؟

31
00:02:14,850 --> 00:02:19,690
لا، إنّ مذاقها الفظيع جعلني أرغب
...في التّقيّؤ وأفسد معدتي

32
00:02:19,730 --> 00:02:23,530
!لكنّني بقيت حيًّا طوال 13 عامًا

33
00:02:23,570 --> 00:02:28,160
مهما كان ألمي فسيظلّ باهتًا
!بالمقارنة بخيبة أمل سيّدي

34
00:02:28,200 --> 00:02:33,790
!انتظرتُ كلّ هذا الوقت
!انضمّ كاواماتسو الكابّا للقتال

35
00:02:35,790 --> 00:02:38,210
...ظننتُه مات في قلعة أودن

36
00:02:38,250 --> 00:02:41,800
...أجمل سيّاف في بلاد وانو

37
00:02:41,840 --> 00:02:44,050
!كيكونوجو الثّلج المتساقط؟

38
00:02:45,130 --> 00:02:49,010
،غريم فوكوروكوجو النّينجا
!رايزو الضّباب

39
00:02:49,800 --> 00:02:54,930
وهذا ساموراي ومصارع السّومو
!الأكثر إرعابًا، اليوكوزونا كاواماتسو

40
00:02:55,480 --> 00:03:00,860
والرّجل العجوز إلى جانبهم هو بالفعل
!من اعتقدناه! هيوغورو الزّهرة الحقيقيّ

41
00:03:01,020 --> 00:03:04,190
!سننقذكم مهما كلّف الأمر

42
00:03:04,240 --> 00:03:06,780
!ثقوا بنا

43
00:03:10,990 --> 00:03:13,870
!مهلاً! ابتعدوا! اتركوني

44
00:03:14,080 --> 00:03:16,790
!أنتم من عليكم تركنا وشأننا

45
00:03:16,960 --> 00:03:18,920
!لا تقحمونا في هذا

46
00:03:19,080 --> 00:03:23,670
،حتّى إن كنّا نثير الشّفقة وجياعًا
!بإمكاننا مواصلة العيش ما دمنا ننصاع لهم

47
00:03:24,130 --> 00:03:27,380
!يا رجال! أهذا فعلاً ما ترغبون به؟

48
00:03:33,760 --> 00:03:36,560
!استعملها يا صديق لوفي-دونو

49
00:03:36,730 --> 00:03:38,520
!أقلت صديق؟

50
00:03:44,980 --> 00:03:49,700
!جهّزوا طلقات الطّاعون
!علينا أن ننهي أمرهم

51
00:03:49,740 --> 00:03:52,160
!استعدّوا للقتال جميعًا

52
00:03:52,320 --> 00:03:54,120
!اعتمد علينا

53
00:03:54,160 --> 00:03:56,750
!هل أنتم مستعدّون؟

54
00:03:58,290 --> 00:04:01,000
!خذوا طلقات الطّاعون

55
00:04:10,300 --> 00:04:11,470
!توقّفوا رجاءً

56
00:04:16,350 --> 00:04:20,440
كيف أمكن لأولئك الأوغاد فعل
!ذلك بالسّجناء الجائعين

57
00:04:23,730 --> 00:04:30,240
"!نحن هنا للفوز! صرخة لوفي اليائسة"

58
00:05:03,100 --> 00:05:04,900
!توقّفوا

59
00:05:19,370 --> 00:05:22,920
!نينبو: شوريكن البرق

60
00:05:28,380 --> 00:05:30,420
...يد شيطان، قلب قدّيس

61
00:05:30,460 --> 00:05:32,880
!موجة الشّرّ القاطعة

62
00:06:16,930 --> 00:06:19,510
!أسلوب الكابّا

63
00:06:22,060 --> 00:06:24,640
!نهر القصاص

64
00:06:41,910 --> 00:06:45,210
!استعملها يا صديق لوفي-دونو

65
00:06:45,370 --> 00:06:47,000
أقلتَ صديق؟

66
00:06:47,170 --> 00:06:50,290
!سيكون أحدها المفتاح المناسب

67
00:07:11,860 --> 00:07:14,150
!هيّا! هيّا! هيّا! هيّا

68
00:07:31,460 --> 00:07:34,710
!أطلقوا! أطلقوا! أطلقوا
!واصلوا الإطلاق فحسب

69
00:07:49,310 --> 00:07:50,440
!سُحقًا

70
00:07:50,480 --> 00:07:52,230
!تعرّضت لطلقة

71
00:07:53,020 --> 00:07:55,190
!إنّها تحرق

72
00:07:56,150 --> 00:07:58,240
!ساعدوني! إنّها تتفشّى

73
00:07:58,400 --> 00:07:59,410
!ابتعد عنّي

74
00:08:01,910 --> 00:08:05,080
!أطلقوا! أطلقوا
!واصلوا الإطلاق فحسب

75
00:08:08,120 --> 00:08:10,250
!...هذا مؤلم، مؤلم

76
00:08:10,790 --> 00:08:15,750
!سُحقًا! إنّهم يستهدفون السّجناء فقط

77
00:08:26,930 --> 00:08:29,940
.صحيح! نسيت ذكر هذا

78
00:08:29,980 --> 00:08:33,270
...بالنّسبة لاسم الطّاعون

79
00:08:35,730 --> 00:08:39,070
...تنتشر حمّى شديدة من مكان الطّلقات

80
00:08:39,820 --> 00:08:43,370
!ومعها ألم حارق في كلّ أنحاء الجسم

81
00:08:42,280 --> 00:08:43,370
!هذا يحرق

82
00:08:43,700 --> 00:08:46,370
!تتطاير الدّماء

83
00:08:46,410 --> 00:08:50,660
...ويعاني المصاب ويتلوّى ألمًا

84
00:08:51,080 --> 00:08:56,550
!وينقل ذلك الألم لأشخاص عشوائيّين

85
00:08:57,420 --> 00:08:59,510
!النّجدة

86
00:08:59,880 --> 00:09:00,820
!كلاّ

87
00:09:00,970 --> 00:09:02,630
!هذا موجع للغاية

88
00:09:02,800 --> 00:09:04,180
!إيّاك

89
00:09:05,930 --> 00:09:07,510
!انظروا لهذا

90
00:09:07,560 --> 00:09:11,810
!هكذا ينتهي بكم المطاف مصابين بالعدوى

91
00:09:19,740 --> 00:09:25,660
.يبدون مثل نباتات جفّت وتعفّنت

92
00:09:37,290 --> 00:09:38,680
...النّجدة

93
00:09:38,680 --> 00:09:40,260
!كلاّ! ابتعد عنّي

94
00:09:46,260 --> 00:09:47,970
...هذه

95
00:09:48,600 --> 00:09:51,270
!تحفة كوين-ساما الفنّيّة

96
00:09:51,310 --> 00:09:55,810
!يُدعى هذا الطّاعون الغريب بالمومياء

97
00:10:02,740 --> 00:10:03,650
!انطلقوا

98
00:10:04,360 --> 00:10:10,490
أصبحتم الآن أسلحة بشريّة بإمكانها
!الإطاحة بالعدوّ بلمسة واحدة

99
00:10:12,000 --> 00:10:13,910
!لا تنشروا الفيروس

100
00:10:14,290 --> 00:10:16,540
!يا رفاق، لا تتحرّكوا

101
00:10:16,580 --> 00:10:18,210
!سأكتشف حلاًّ ما

102
00:10:18,250 --> 00:10:21,630
!أعد أنّني سأعالجكم

103
00:10:21,800 --> 00:10:24,050
!عليكم القتال أيضًا

104
00:10:24,090 --> 00:10:26,180
أم هل أعتبركم متمرّدين؟

105
00:10:31,810 --> 00:10:32,470
...سُحقًا

106
00:10:41,070 --> 00:10:42,110
...سُحقًا

107
00:10:42,280 --> 00:10:43,310
...تبًّا

108
00:10:43,420 --> 00:10:44,490
...لا أريد القتال

109
00:10:46,150 --> 00:10:47,490
!لن يتوقّفوا

110
00:10:48,410 --> 00:10:49,370
،على هذه الحال

111
00:10:49,740 --> 00:10:53,750
!أودون بأكمله ضدّنا

112
00:10:55,410 --> 00:10:57,330
!اخرجوا من هنا

113
00:11:01,210 --> 00:11:03,710
...إن لم تظهروا يا رفاق

114
00:11:05,130 --> 00:11:09,850
!ما كان لأيّ من هذا أن يحدث

115
00:11:10,100 --> 00:11:13,350
...حتّى إن كنتم بالفعل

116
00:11:14,390 --> 00:11:21,610
السّاموراي الأكازايا الّذين كان
،يفترض أنّهم ماتوا منذ 20 سنة

117
00:11:21,650 --> 00:11:24,070
!فلن تظفروا بالفوز

118
00:11:25,360 --> 00:11:27,030
...كايدو

119
00:11:27,740 --> 00:11:31,280
...التّنّين الطّائر العملاق

120
00:11:32,330 --> 00:11:35,370
...بالإضافة لقراصنة مملكة الحيوان

121
00:11:35,410 --> 00:11:37,660
!لا يملك أيّ أحد أيّ فرصة أمامهم

122
00:11:40,130 --> 00:11:41,340
!انظروا

123
00:11:41,710 --> 00:11:48,880
...إنّ مجرّد سلاح صنعه أحد أتباع كايدو

124
00:11:50,340 --> 00:11:52,220
!أثبت أنّه بهذه الخطورة

125
00:11:54,140 --> 00:11:58,060
!يا لها من قوّة مدمّرة

126
00:11:59,650 --> 00:12:04,780
،هذا صحيح! لو لم يظهر غريب مثلك

127
00:12:05,030 --> 00:12:09,570
لكان بإمكاننا مواصلة حياتنا اليوميّة
!في أودون كالسّابق

128
00:12:11,570 --> 00:12:16,160
!لم نكن مضطرّين لتكبّد كلّ هذا

129
00:12:28,880 --> 00:12:30,840
!كلاّ يا لوفيتارو-سان! لا تلمسهم

130
00:12:40,850 --> 00:12:45,520
!توقّفوا يا رفاق

131
00:12:45,770 --> 00:12:48,400
!مستحيل! عرّض نفسه للعدوى طوعًا؟

132
00:13:19,020 --> 00:13:20,020
!أهو غبيّ؟

133
00:13:24,440 --> 00:13:25,440
.توقّف

134
00:13:25,610 --> 00:13:26,900
!ستموت

135
00:13:28,070 --> 00:13:30,650
!ما الّذي تفعله يا لوفيتارو-دونو؟

136
00:13:37,660 --> 00:13:39,330
!يا فتى قبّعة القشّ

137
00:13:43,500 --> 00:13:45,670
!أقلتم تهديد؟

138
00:13:49,500 --> 00:13:53,340
!أقلتم قوّة مدمّرة؟

139
00:13:54,550 --> 00:13:56,050
...إنّ هذا

140
00:13:56,510 --> 00:13:59,010
!لا يؤثّر بي إطلاقًا

141
00:14:00,850 --> 00:14:02,310
!لا تكذب

142
00:14:02,350 --> 00:14:04,310
!ابتعد عنهم في الحال

143
00:14:04,350 --> 00:14:06,520
!لوفي

144
00:14:20,330 --> 00:14:25,420
...إنّ جميع السّاموراي الّذين أعرفهم أقوياء جدًّا

145
00:14:41,930 --> 00:14:44,680
...أمّا أنتم

146
00:14:45,060 --> 00:14:48,440
!فقد انكسرت أرواحكم

147
00:14:53,740 --> 00:14:56,150
!أقلتم حياتكم اليوميّة؟

148
00:14:56,950 --> 00:15:01,580
تنصاعون للأوامر فحسب وتحصلون
...على وجبات دانغو تافهة

149
00:15:04,160 --> 00:15:09,500
تُمنحون ما يكفي لتنجون من
!الموت وتسمّون ذلك حياة؟

150
00:15:24,980 --> 00:15:26,640
!أفيقوا

151
00:15:27,350 --> 00:15:29,270
...ما أنتم إلاّ

152
00:15:29,690 --> 00:15:31,900
!عبيد

153
00:15:50,670 --> 00:15:53,130
!أخي الكبير والبقيّة بخير

154
00:15:53,380 --> 00:15:55,300
!أهو بخير بالفعل؟

155
00:16:06,270 --> 00:16:10,690
أخبروني أين العيب في كوني
!غريبًا عن هذه البلاد؟

156
00:16:11,020 --> 00:16:15,110
!ألا يُسمح لغريب بإنقاذ هذه البلاد؟

157
00:16:30,040 --> 00:16:32,540
...قطعتُ وعدًا

158
00:16:35,090 --> 00:16:38,630
...لصديقتي تاما

159
00:16:38,670 --> 00:16:42,510
...الّتي أطعمتني من طعامها

160
00:16:43,090 --> 00:16:48,310
أنّني سأجعل هذه البلاد مكانًا
!تستطيع الأكل فيه بقدر ما تشاء

161
00:16:58,740 --> 00:17:02,030
!يا للذّته

162
00:17:02,570 --> 00:17:05,830
!هذا الحساء لذيذ للغاية

163
00:17:07,740 --> 00:17:08,790
!تاما

164
00:17:09,120 --> 00:17:11,290
!لا ترضي بالقليل

165
00:17:11,330 --> 00:17:13,210
!سأجعل هذه حياتك اليوميّة

166
00:17:14,880 --> 00:17:17,670
،عندما نغادر هذه البلاد

167
00:17:17,710 --> 00:17:21,590
سأجعل منها مكانًا حيث
!تستطيعين الأكل قدر ما تشائين

168
00:17:24,930 --> 00:17:26,760
...أخي الكبير

169
00:17:27,140 --> 00:17:29,350
...إن عجزت

170
00:17:30,730 --> 00:17:35,400
...على الوفاء بهذا الوعد، فإنّ هذه البلاد

171
00:17:35,440 --> 00:17:37,860
!ستكون جحيمًا أبديّة

172
00:17:46,070 --> 00:17:48,620
!سمعتُ عن أودن

173
00:17:49,160 --> 00:17:51,290
!ونِعم الرّجل بالفعل

174
00:17:52,830 --> 00:17:58,500
،لكن قبل 20 سنة
،في اليوم الّذي قتله فيه كايدو

175
00:17:58,960 --> 00:18:02,170
!أصابت حالة ركود هذه البلاد، صحيح؟

176
00:18:07,010 --> 00:18:11,890
!نحن هنا لنذيق الهزيمة لكايدو

177
00:18:13,180 --> 00:18:18,230
!لا نريد أن يقف حلفاؤنا في طريقنا

178
00:18:23,400 --> 00:18:26,450
!لذلك اتّخذوا قرارًا الآن

179
00:18:27,070 --> 00:18:28,870
...أتريدون الوقوف معنا

180
00:18:29,780 --> 00:18:32,290
!أم مع كايدو؟

181
00:18:55,560 --> 00:18:57,060
هل أنت جادّ؟

182
00:19:07,410 --> 00:19:10,280
...ما زلت

183
00:19:11,740 --> 00:19:14,160
ستمنحنا فرصة؟

184
00:19:29,010 --> 00:19:30,680
...لقد أسر قلوبهم

185
00:19:32,220 --> 00:19:34,640
!ويا لها من طريقة لفعل ذلك

186
00:19:36,060 --> 00:19:37,850
...هذا سيّئ

187
00:19:38,730 --> 00:19:41,820
...إنّ قلوبهم متردّدة

188
00:19:42,150 --> 00:19:46,990
لكن إن استطعت تسديد طلقة
،وسط أولئك الحمقى غير المحميّين

189
00:19:47,030 --> 00:19:49,320
،فسيسبّب ذلك رعبًا كبيرًا

190
00:19:49,740 --> 00:19:52,450
!وتنقلب الموازين لصالحنا ثانية

191
00:19:52,990 --> 00:19:58,000
...ستنتشر فيروسات بما يُعادل 200 طلقة طاعون

192
00:19:58,040 --> 00:19:59,870
!بقنبلة الطّاعون هذه

193
00:20:03,590 --> 00:20:06,970
!خذوا هذا! هجوم ضخم لعطسة الفيل

194
00:20:08,300 --> 00:20:11,050
...هذا لا يُعقل أيّها المأمور

195
00:20:13,050 --> 00:20:14,890
!كلاّ! لا تفعل

196
00:20:19,190 --> 00:20:22,110
!مهلاً! سيطلق علينا شيئًا ما

197
00:20:22,270 --> 00:20:23,020
!ماذا؟

198
00:20:25,480 --> 00:20:26,690
!فات الأوان

199
00:20:33,450 --> 00:20:37,120
!عطسة الفيل

200
00:20:44,630 --> 00:20:45,880
!ماذا؟

201
00:20:48,130 --> 00:20:49,670
ماذا؟ ماذا؟ ماذا؟

202
00:20:52,680 --> 00:20:55,970
.فعلتُ هذا لأنّني رأيتُ مستقبلاً فظيعًا

203
00:21:09,440 --> 00:21:11,150
!بابانوكي-ساما

204
00:21:11,320 --> 00:21:13,950
!أيّها المأمور

205
00:21:21,500 --> 00:21:22,750
...يا له

206
00:21:25,040 --> 00:21:27,380
!من شخص يُعتمد عليه

207
00:21:29,510 --> 00:21:30,920
.اهتمّوا بالباقي

208
00:21:40,140 --> 00:21:41,390
!دع الأمر لنا

209
00:21:41,560 --> 00:21:44,350
!مهلاً! يا هؤلاء! أتتذكّرون؟

210
00:21:44,730 --> 00:21:47,360
!ما الّذي سيحدث إن عبثتم مع الحرس؟

211
00:21:47,400 --> 00:21:50,650
...الإساءة الأولى، ستُقطع أيديكم

212
00:21:50,820 --> 00:21:52,780
.نعلم ذلك، ولا نهتمّ

213
00:21:53,070 --> 00:21:56,780
!قرّرنا جميعًا أن نتمرّد

214
00:21:59,410 --> 00:22:01,540
!ادفعوا ثمن ما أذقتمونا إيّاه طوال هذه السّنين

215
00:22:01,700 --> 00:22:02,680
.لنقم بهذا

216
00:22:02,680 --> 00:22:03,450
.أجل

217
00:22:15,390 --> 00:22:18,680
...قبل ثمانية أيّام من المعركة العظيمة

218
00:22:18,720 --> 00:22:22,140
...بينما يجهل جيش العدوّ الرّسميّ الأمر بالكامل

219
00:22:32,940 --> 00:22:35,200
!تمّ إخضاع أودون

220
00:22:35,740 --> 00:22:39,740
!أبليت بلاءً حسنًا يا فتى قبّعة القشّ

221
00:22:49,250 --> 00:22:52,710
...أحضرت معك مساعدًا مذهلاً

222
00:22:53,620 --> 00:22:55,470
!يا كينييمون

223
00:23:04,310 --> 00:23:07,190
!يريد استعادة بلاد وانو من كايدو

224
00:23:07,510 --> 00:23:13,320
أمست رغبة لوفي الرّاسخة أملًا
!وإلهامًا لمومونوسكي والسّجناء

225
00:23:13,910 --> 00:23:22,040
،بعد 20 عامًا من الألم والمهانة
!فهل سيتظافر لوفي وحلفاؤه معًا؟

226
00:23:22,200 --> 00:23:23,740
:في الحلقة القادمة من وان بيس

227
00:23:23,820 --> 00:23:27,580
"حلم المحاربين! إخضاع لوفي لأودون"

228
00:23:27,620 --> 00:23:30,400
!ملك القراصنة، لن يكون إلاّ أنا