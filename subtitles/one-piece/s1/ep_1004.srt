1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,900 --> 00:01:59,500
.مرحبًا يا رفاق

29
00:01:59,500 --> 00:02:03,220
!أنا من أكثر أتباع لوفي-سينباي المخلصين

30
00:02:03,220 --> 00:02:08,310
!مرحبًا بكم في غرفتي السّرّيّة اليوم
!أتمنّى أن تستمتعوا بوقتكم

31
00:02:08,310 --> 00:02:12,320
!حسنًا، لنستدع مرشد اليوم! تفضّل

32
00:02:12,320 --> 00:02:14,240
.شكرًا لك

33
00:02:14,240 --> 00:02:16,630
!أوتاما سينسي، سرّني لقاؤك هنا

34
00:02:16,630 --> 00:02:21,180
!شكرًا على استضافتي
لكن ما الّذي تريد منّي فعله؟

35
00:02:21,180 --> 00:02:25,810
أريدك أن تخبرينا عن لوفي-سينباي
.الّذي أكنّ له كلّ الاحترام

36
00:02:25,810 --> 00:02:30,730
.لوفي-سينباي؟ بارتو-كُن
هل تحبّ أخي الكبير لوفي أيضًا؟

37
00:02:30,730 --> 00:02:34,620
،نعم. لكن بما أنّي لم أره منذ مدّة طويلة

38
00:02:34,620 --> 00:02:40,500
فلا يسعني سوى التّساؤل عن مكانه
.الآن وما المغامرات الّتي يخوضها

39
00:02:40,500 --> 00:02:44,980
!أتوسّل إليك! أخبريني عن أحواله مؤخّرًا

40
00:02:44,980 --> 00:02:46,470
!حسنًا

41
00:02:46,470 --> 00:02:51,410
!نحبّ كلانا أخي الكبير، لذلك نحن صديقان

42
00:02:51,410 --> 00:02:55,290
سأخبرك كلّ شيء عن أعماله
!البطوليّة في بلاد وانو

43
00:02:55,290 --> 00:02:59,760
...شكرًا لك! حسنًا، غرفة بارتو السّرّيّة تبدأ

44
00:02:59,760 --> 00:03:01,620
!الآن

45
00:03:03,260 --> 00:03:08,260
"!مشروع دعم لوفي-سينباي: غرفة بارتو السّرّيّة"

46
00:03:11,470 --> 00:03:16,560
!جاء أخي الكبير لوفي إلى بلاد وانو للإطاحة بكايدو

47
00:03:17,690 --> 00:03:23,060
.أعتقد أنّه يريد تسوية النّزال القائم بينهما منذ دريسروزا

48
00:03:24,860 --> 00:03:30,070
.لقد أنقذ أخي الكبير لوفي حياتي في أوّل لقاء لنا

49
00:03:30,070 --> 00:03:31,930
!أنقذ حياتك؟

50
00:03:31,930 --> 00:03:35,330
!إنّه بالغ الرّوعة أينما حلّ وارتحل

51
00:03:35,330 --> 00:03:40,630
!نعم! لهذا السّبب أحبّ أخي الكبير لوفي

52
00:03:40,630 --> 00:03:42,750
.أوتاما سينسي، تجيدين الحكم على الآخرين

53
00:03:49,930 --> 00:03:52,070
!لم أرَ لوفي-سينباي منذ مدّة

54
00:03:52,070 --> 00:03:56,300
!يبدو مقدّسًا كعادته! برّاقًا للغاية

55
00:04:09,120 --> 00:04:11,320
.هذا الشّاطئ صاخب

56
00:04:15,370 --> 00:04:16,700
.تفضّل

57
00:04:17,080 --> 00:04:19,790
!بالهناء والشّفاء

58
00:04:20,340 --> 00:04:21,750
!يا أخي الكبير

59
00:04:22,170 --> 00:04:24,160
!شكرًا على الطّعام

60
00:04:27,640 --> 00:04:32,510
،شكرت أخي الكبير بالطّعام

61
00:04:32,810 --> 00:04:39,560
لكنّ الجوع دفعني لشرب مياه النّهر
...الملوّثة وفقدت وعيي

62
00:04:42,900 --> 00:04:44,100
!يا تاما

63
00:04:47,360 --> 00:04:51,650
كان أخي الكبير والبقيّة في طريقهم
...لأخذي إلى طبيب

64
00:04:51,650 --> 00:04:56,610
عندما قابلوا هوكينز، وهو أحد
.نجوم قراصنة مملكة الحيوان

65
00:04:56,610 --> 00:05:00,640
،تمامًا مثل لوفي-سينباي
.إنّه ناشئ من الجيل الأسوأ

66
00:05:00,640 --> 00:05:03,790
كيف يجرؤ على الوقوف في وجه لوفي-سينباي؟

67
00:05:04,210 --> 00:05:08,130
.أنقذ أخي الكبير حياتي مرارًا

68
00:05:08,300 --> 00:05:14,300
.ورغم ذلك، اختطفني تابع كايدو المسمّى هولديم

69
00:05:14,640 --> 00:05:18,260
.مهلاً، مهلاً. تورّطتِ في الكثير من المشاكل

70
00:05:18,260 --> 00:05:20,600
!كنت متفاجئة أيضًا

71
00:05:21,140 --> 00:05:25,600
.لكنّ أخي الكبير لوفي أتى لنجدتي ثانية

72
00:05:29,480 --> 00:05:31,690
...فاكهة المطّاط

73
00:05:34,320 --> 00:05:36,320
!الصّقر الأحمر

74
00:05:46,460 --> 00:05:47,210
!خذي

75
00:05:52,850 --> 00:05:54,300
!إنّها تفّاحة

76
00:05:55,510 --> 00:05:56,630
...تاما

77
00:05:59,730 --> 00:06:03,970
.أنا أردّ لك معروف إطعامي

78
00:06:04,390 --> 00:06:06,640
!وما هذه إلاّ البداية

79
00:06:14,450 --> 00:06:17,320
!يا للذّتها

80
00:06:18,580 --> 00:06:19,530
!تاما

81
00:06:20,370 --> 00:06:22,120
!لا ترضي بالقليل

82
00:06:22,370 --> 00:06:24,410
!سأجعل هذه حياتك اليوميّة

83
00:06:26,880 --> 00:06:29,650
،عندما نغادر هذه البلاد

84
00:06:29,650 --> 00:06:33,540
سأجعل منها مكانًا حيث
!تستطيعين الأكل قدر ما تشائين

85
00:06:34,600 --> 00:06:38,620
!هذا هو لوفي-سينباي. ما قاله كان رائعًا

86
00:06:38,620 --> 00:06:41,180
.أريده أن يقول ذلك لي أيضًا

87
00:06:41,810 --> 00:06:46,180
،وبعد ذلك، انضمّ له أفراد الطّاقم الآخرين

88
00:06:46,320 --> 00:06:50,730
.لكنّ كايدو ظهر فجأة ونشب قتال بينهما

89
00:06:51,450 --> 00:06:53,900
!كـ-كـ-كايدو؟

90
00:06:54,280 --> 00:06:58,900
هذا التّنّين الضّخم هو كايدو؟
!يبدو قويًّا كما توقّعت

91
00:06:59,320 --> 00:07:01,570
!تنّين؟! ما ذلك؟

92
00:07:04,540 --> 00:07:06,040
!هذا كايدو

93
00:07:08,000 --> 00:07:09,080
...ذاك هو

94
00:07:10,630 --> 00:07:12,000
!كايدو

95
00:07:12,420 --> 00:07:14,710
...أنت

96
00:07:17,220 --> 00:07:18,460
.لوفي

97
00:07:18,970 --> 00:07:21,180
!الرّجل الّذي سيصبح ملك القراصنة

98
00:07:23,270 --> 00:07:25,100
!لوفي...؟

99
00:07:25,220 --> 00:07:27,560
!أقلتَ لوفي؟

100
00:07:32,240 --> 00:07:34,730
!نَفس الانفجار

101
00:08:00,600 --> 00:08:03,090
...فاكهة المطّاط

102
00:08:09,520 --> 00:08:13,640
!مسدّس الملك كونغ

103
00:08:16,980 --> 00:08:19,940
!باغوا الرّعد

104
00:08:52,980 --> 00:08:56,130
!لا أصدّق أنّ لوفي-سينباي خسر القتال

105
00:08:56,130 --> 00:09:00,270
!لماذا لم أكن معه؟! يا لي من عديم الفائدة

106
00:09:00,700 --> 00:09:03,490
!بارتو-كُن، لست عديم الفائدة

107
00:09:03,990 --> 00:09:05,320
.لنواصل

108
00:09:06,410 --> 00:09:12,040
ثمّ تمّ إرسال أخي الكبير لوفي
.إلى مخيّم التّنقيب في أودون

109
00:09:15,260 --> 00:09:18,580
!أشعر بالأسى عليه! كنت لآخذ مكانه في الحين

110
00:09:20,260 --> 00:09:23,880
.التقى ثانية بقرصان يُدعى كيد هناك

111
00:09:24,350 --> 00:09:29,620
.يوستاس "كابتن" كيد هو ناشئ من الجيل الأسوأ

112
00:09:29,620 --> 00:09:31,970
!إنّه منافس لوفي-سينباي

113
00:09:32,230 --> 00:09:36,810
!يجب سجن من يقفون في طريق سينباي للأبد

114
00:09:38,110 --> 00:09:43,990
.هاجم أخي الكبير حارسًا لإنقاذ رجل عجوز يُدعى هيو

115
00:09:43,990 --> 00:09:45,970
!يثير جلبة ثانية

116
00:09:45,970 --> 00:09:50,870
أينما ذهب، ثمّة دائمًا مشاكل
!لأنّه ملك القراصنة المستقبليّ

117
00:09:52,290 --> 00:09:54,040
!أيّها العجوز

118
00:09:54,040 --> 00:09:56,500
!مهلاً! لا! إيّاك

119
00:09:56,500 --> 00:09:57,500
...توقّف

120
00:10:10,640 --> 00:10:12,180
!لنخرج من هنا

121
00:10:24,570 --> 00:10:30,680
بعد فشلهما في الهرب، أجبر أخي الكبير
...والعجوز هيو على أن يخوضا تحدّي

122
00:10:30,680 --> 00:10:34,240
كوين، أحد كبار النّجوم، الّذي كان
.مصارعة سومو الجحيم المميتة

123
00:10:34,840 --> 00:10:39,170
!الموت هو مصيركم يا حمقى

124
00:10:39,170 --> 00:10:41,580
!الواحد تلو الآخر

125
00:10:43,010 --> 00:10:45,750
!اخرس

126
00:10:47,590 --> 00:10:49,630
...عندما يتعلّق الأمر بمكان مماتي

127
00:10:51,020 --> 00:10:52,970
!سيكون ذلك من اختياري

128
00:10:53,890 --> 00:10:56,520
!أمسكوا قبّعة القشّ لوفي

129
00:10:58,900 --> 00:11:00,100
!ها قم قادمون

130
00:11:02,700 --> 00:11:06,050
!اثنان ضدّ الكثير منهم ليس عادلاً

131
00:11:06,050 --> 00:11:07,780
!هل سيكون بخير؟

132
00:11:07,990 --> 00:11:09,990
!لا داعي للقلق

133
00:11:09,990 --> 00:11:16,160
كان أخي الكبير سعيدًا بالقتال لأنّه أراد
!أن يتدرّب على مهارته الجديدة، الرّيوو

134
00:11:17,210 --> 00:11:19,750
!إنّه يتألّق حتّى في الشّدائد

135
00:11:19,750 --> 00:11:23,380
!سيصبح لوفي-سينباي أقوى بكثير

136
00:11:24,090 --> 00:11:26,250
!هذا ممتاز

137
00:11:27,100 --> 00:11:30,470
!تبًّا! ليس هكذا أيضًا! لا

138
00:11:31,350 --> 00:11:32,260
...لكن

139
00:11:34,060 --> 00:11:37,220
!ما زال هنالك كلّ هؤلاء الأعداء للتّدرّب معهم

140
00:11:37,520 --> 00:11:40,980
!سأتقن الرّيوو بأيّ ثمن

141
00:11:49,910 --> 00:11:52,570
...أمّا أنتم

142
00:11:52,790 --> 00:11:56,370
!فقد انكسرت أرواحكم

143
00:11:58,090 --> 00:12:00,620
...قطعتُ وعدًا

144
00:12:03,090 --> 00:12:06,250
...لصديقتي تاما

145
00:12:06,720 --> 00:12:10,010
...الّتي أطعمتني من طعامها

146
00:12:11,060 --> 00:12:16,390
أنّني سأجعل هذه البلاد مكانًا
!تستطيع الأكل فيه بقدر ما تشاء

147
00:12:19,150 --> 00:12:23,640
،لكن قبل 20 سنة
،في اليوم الّذي قتله فيه كايدو

148
00:12:24,030 --> 00:12:26,690
!أصابت حالة ركود هذه البلاد، صحيح؟

149
00:12:32,080 --> 00:12:37,070
!نحن هنا لنذيق الهزيمة لكايدو

150
00:12:38,250 --> 00:12:43,410
!لا نريد أن يقف حلفاؤنا في طريقنا

151
00:12:48,420 --> 00:12:51,460
!لذلك اتّخذوا قرارًا الآن

152
00:12:52,180 --> 00:12:53,840
...أتريدون الوقوف معنا

153
00:12:54,770 --> 00:12:57,010
!أم مع كايدو؟

154
00:13:07,990 --> 00:13:11,650
.هذا يعني الكثير بما أنّه صادر من لوفي-سينباي

155
00:13:11,650 --> 00:13:15,410
!مرّ وقت طويل مذ سمعت خطابًا مشجّعًا منه

156
00:13:15,410 --> 00:13:16,990
!أراهن أنّك ستحبّ واحدًا آخر

157
00:13:17,540 --> 00:13:21,990
.وهكذا تمكّن أخي الكبير من إخضاع أودون

158
00:13:22,670 --> 00:13:27,790
ومن هناك، أغاروا أخيرًا على أوينغاشيما
.للوصول إلى كايدو

159
00:13:27,800 --> 00:13:31,340
!سيخوض سينباي وكايدو معركة حاسمة

160
00:13:31,340 --> 00:13:33,420
!أنا متحمّس

161
00:13:38,350 --> 00:13:41,930
.لكن حدث أمر غريب

162
00:13:42,480 --> 00:13:47,900
،قُبيل المعركة الكبيرة
،اعترف كانجورو أنّه جاسوس لأوروتشي

163
00:13:47,900 --> 00:13:50,400
!واختطف مومو-كُن

164
00:13:50,400 --> 00:13:54,090
!ماذا؟! كان خائنًا؟

165
00:13:54,090 --> 00:13:58,360
!كنت معهم حتّى وصلوا إلى زو، لكن لم ألاحظ

166
00:13:58,360 --> 00:14:01,990
.كان كينييمون والبقيّة محاصرين

167
00:14:02,420 --> 00:14:06,580
!لكنّ أخي الكبير لوفي أتى

168
00:14:09,300 --> 00:14:11,920
!لستُم خبراء بحر، فلا تتهوّروا

169
00:14:13,300 --> 00:14:16,210
!يجب عليكم أن تتراجعوا

170
00:14:18,430 --> 00:14:20,760
!البحر هو ساحة قتال القراصنة

171
00:14:21,440 --> 00:14:26,640
إنّ طريقة دخولهم هنا تشعل الأحداث
!ولا أطيق الانتظار حتّى تحرقها

172
00:14:43,910 --> 00:14:46,080
!الرّجل الواثب

173
00:14:47,090 --> 00:14:51,120
!لوفي-سينباي مذهل! يا لروعته

174
00:14:53,470 --> 00:14:59,120
أنا ممتنّ للغاية لأنّني رأيت هيئة الرّجل الواثب
!الّتي هزم بها دوفلامينغو مرّة أخرى

175
00:14:59,120 --> 00:15:06,140
.لا أهتمّ بالنّاشئين الآخرين
!أروني المزيد من لوفي-سينباي

176
00:15:11,820 --> 00:15:14,860
هل يتقاتل هؤلاء الثّلاثة دائمًا؟

177
00:15:14,860 --> 00:15:17,820
!الاثنان الآخران هناك فقط ليجعلوا سينباي يبدو رائعًا

178
00:15:17,820 --> 00:15:19,660
!آمُل أن يُهزما

179
00:15:24,420 --> 00:15:29,330
!إضافة لذلك، أتى صديق أخي الكبير للمساعدة

180
00:15:30,960 --> 00:15:35,250
!أعيروني مسامعكم

181
00:15:35,670 --> 00:15:42,010
ها أنا الآن، سأتشارك كأس ساكي
...مع زعيمي قبّعة القشّ-سان

182
00:15:42,390 --> 00:15:45,510
!بصفتي العضو الجديد

183
00:15:46,430 --> 00:15:48,520
...يمكنكم مناداتي

184
00:15:48,690 --> 00:15:51,730
!فارس البحر" جينبي"

185
00:15:56,110 --> 00:16:00,860
!انضمّ الشّيتشيبوكاي السّابق جينبي للطّاقم

186
00:16:01,040 --> 00:16:04,870
إنّ كلّ رفاق طاقم لوفي-سينباي
!من خيرة الخيرة مثله

187
00:16:05,120 --> 00:16:08,160
هل جينبي-سان شخص عظيم لهذا الحدّ؟

188
00:16:08,160 --> 00:16:13,400
بالطّبع، إنّه قرصان قويّ جدًّا
،يعرفه كلّ قراصنة العالم

189
00:16:13,400 --> 00:16:16,070
وقد هرب من إمبل داون

190
00:16:16,070 --> 00:16:19,880
!ونجى في حربّ القمّة رفقة لوفي-سينباي

191
00:16:19,880 --> 00:16:21,630
!هذا مذهل

192
00:16:22,390 --> 00:16:28,010
بعد وصولهم لأونيغاشيما، هزم أخي الكبير
.والبقيّةُ الحرسَ عند بوّابة توري في لمح البصر

193
00:16:32,270 --> 00:16:33,310
...الصّقر

194
00:16:36,280 --> 00:16:38,480
!الأحمر

195
00:16:53,080 --> 00:16:56,790
!لنقم بهذا معهم! بعد أن نطيح بكايدو

196
00:16:58,170 --> 00:17:01,000
!وإيساع بيغ مام وأوروتشي ضربًا

197
00:17:01,550 --> 00:17:03,630
،بعد أن ننتصر في هذه المعركة

198
00:17:04,310 --> 00:17:07,090
...فسنقيم أكبر

199
00:17:08,150 --> 00:17:10,350
!وليمة على الإطلاق

200
00:17:12,940 --> 00:17:16,940
!أنا معكم

201
00:17:21,450 --> 00:17:23,340
!هيّا بنا يا رفاق

202
00:17:23,340 --> 00:17:26,910
!اتبعوا السّاموراي

203
00:17:27,250 --> 00:17:33,120
نجح طاقم قبّعة القشّ الدّخول
،إلى أونيغاشيما متنكّرين كأتباع لكايدو

204
00:17:33,120 --> 00:17:38,210
لكنّ أخي الكبير لوفي غضب كثيرًا
.وأحدث فوضى عارمة كالعادة

205
00:17:49,640 --> 00:17:52,220
لماذا غضب بسبب حساء الفاصولياء الحمراء؟

206
00:17:52,220 --> 00:17:55,600
.لأنّه تذكّر الوعد الّذي قطعه لي

207
00:17:55,600 --> 00:17:58,190
.أخي الكبير طيّب للغاية

208
00:17:58,900 --> 00:18:01,230
!إنّني غارق في دموعي

209
00:18:01,650 --> 00:18:07,320
لكنّ هنالك العديد من الأعداء الأقوياء
،في أونيغاشيما! وفي طريقه إلى كايدو

210
00:18:07,320 --> 00:18:11,320
.تواجه أخي الكبير مع أولتي وبيج وان من التّوبي روبّو

211
00:18:11,870 --> 00:18:15,020
بإمكانهما التّحوّل إلى ديناصورات؟

212
00:18:15,020 --> 00:18:20,130
يملك قراصنة مملكة الحيوان التّابعون
!لكايدو الكثير من الوحوش الشّرسة

213
00:18:20,130 --> 00:18:22,970
!أيّها الوغد

214
00:18:23,090 --> 00:18:27,260
!مدفع رأس أولتي

215
00:18:43,940 --> 00:18:46,690
!باغوا الرّعد

216
00:19:22,200 --> 00:19:24,310
!قبّعة القشّ لوفي

217
00:19:29,830 --> 00:19:31,320
!هذا أنت، صحيح؟

218
00:19:33,210 --> 00:19:35,330
!اسمي ياماتو

219
00:19:36,330 --> 00:19:38,700
!أنا ابن كايدو

220
00:19:38,710 --> 00:19:40,870
ابن كايدو؟

221
00:19:41,090 --> 00:19:43,880
لماذا هاجم حلفاءه؟

222
00:19:45,170 --> 00:19:49,720
.يبدو أنّ ياماتو يكره كايدو

223
00:19:49,720 --> 00:19:52,490
!لماذا؟ كايدو هو والده

224
00:19:52,490 --> 00:19:54,970
!هل يمكننا أن نثق في شخص مثله؟

225
00:19:54,970 --> 00:19:58,520
.انسجم أخي الكبير مع ياماتو في الحال

226
00:19:59,360 --> 00:20:02,000
.يثق حتّى في ابن عدوّه

227
00:20:02,000 --> 00:20:06,150
!إنّ قلبه كبير كبر الغراند لاين

228
00:20:07,200 --> 00:20:08,530
...أنت

229
00:20:17,330 --> 00:20:20,210
!دعني أقاتل إلى جانبك

230
00:20:20,210 --> 00:20:24,210
.وهكذا بدأ أخي الكبير بالعمل مع ياماتو

231
00:20:25,180 --> 00:20:30,340
.ووصلوا إلى طابق العرض لمواجهة كايدو

232
00:20:30,340 --> 00:20:32,590
...ولتحقيق ذلك

233
00:20:33,730 --> 00:20:36,220
!تحالفنا مع بيغ مام

234
00:20:37,680 --> 00:20:39,810
...سوف نضع

235
00:20:39,810 --> 00:20:42,600
...أيدينا أخيرًا

236
00:20:45,320 --> 00:20:48,400
!على كنز وان بيس العظيم

237
00:20:51,830 --> 00:20:54,780
وأخيرًا ستبدأ معركة حاسمة ضدّ كايدو؟

238
00:20:55,040 --> 00:20:56,490
...الوان بيس

239
00:20:56,870 --> 00:20:59,830
!ذلك شيء أنا من سيحصل عليه

240
00:20:59,830 --> 00:21:04,950
ولكن، استعادت أولين-تشان ذاكرتها
.وهاجمت أخي الكبير

241
00:21:04,950 --> 00:21:09,750
،قبل المعركة الكبيرة ضدّ كايدو
عليه أن يقاتل أحد اليونكو الآخرين؟

242
00:21:09,970 --> 00:21:12,510
!إن كنت مكانه، لتسبّبت في مقتلي بكلّ تأكيد

243
00:21:12,510 --> 00:21:15,170
!لكنّ هذا لا شيء بالنّسبة للوفي-سينباي

244
00:21:26,440 --> 00:21:30,270
!أنت وكايدو ورجالكما وأوروتشي وكلّ أتباعه

245
00:21:30,450 --> 00:21:33,860
!سأوسعكم ضربًا جميعًا

246
00:21:36,700 --> 00:21:40,200
!ستكون حربًا شاملة

247
00:21:40,330 --> 00:21:43,370
!يا رفاق! سأترك الباقي لكم

248
00:21:43,500 --> 00:21:45,120
!ادعمونا

249
00:21:45,380 --> 00:21:50,250
اتّجه أخي الكبير لوفي إلى السّطح
!حيث يقاتل كايدو والبقيّة

250
00:21:51,880 --> 00:21:55,890
!نجوم طاقم قبّعة القشّ هنا جميعًا

251
00:21:55,890 --> 00:22:00,010
!يا لجمالهم! أشبه بالآلهة
!بريقهم يعمي الأبصار

252
00:22:00,350 --> 00:22:02,230
...فأنا يا كايدو

253
00:22:03,230 --> 00:22:05,390
!قادم لإيساعك ضربًا

254
00:22:11,530 --> 00:22:13,860
.حسنًا، هذا كلّ شيء لهذا اليوم

255
00:22:13,860 --> 00:22:18,810
!ماذا؟! أهذا كلّ شيء؟
.لكنّ الحماسة ازدادت للتّوّ

256
00:22:18,810 --> 00:22:21,000
!أخبريني بالمزيد بعد

257
00:22:21,000 --> 00:22:24,830
!لم يبدأ قتال أخي الكبير ضدّ كايدو بعد

258
00:22:25,800 --> 00:22:29,980
أيّ أنّ قتال فرض السّيطرة
!على العالم الجديد لم يبدأ بعد

259
00:22:29,980 --> 00:22:32,240
!سيكون حماسيًّا

260
00:22:32,240 --> 00:22:34,550
.أوتاما سينسي، شكرًا جزيلاً لك

261
00:22:34,550 --> 00:22:39,490
كان من الممتع الحديث معك بما
.أنّك تحبّ أخي الكبير أيضًا

262
00:22:39,490 --> 00:22:42,600
!لا تتوقّف عن تشجيع أخي الكبير

263
00:22:42,600 --> 00:22:46,370
!بالطّبع! وأعلم أنّكم تتشاركوني نفس الشّعور

264
00:22:46,370 --> 00:22:51,100
!لنواصل دعم لوفي-سينباي والبقيّة

265
00:22:51,320 --> 00:22:56,030
!حسنًا جميعًا، نلتقي في المرّة القادمة
!مع السّلامة

266
00:23:04,420 --> 00:23:06,080
!طلقات الطّاعون الّتي لا تنتهي

267
00:23:06,080 --> 00:23:08,540
!كلّ من في طابق العرض هالك

268
00:23:08,540 --> 00:23:11,440
!أفضل سلاح ابتكره كوين، أحد النّجوم الكبار، على الإطلاق

269
00:23:11,440 --> 00:23:14,070
!إنّه يدعى أوني الجليد

270
00:23:14,070 --> 00:23:21,590
إنّه يسحب السّاموراي إلى جحيم وسط آهات
!الغيلان الّذين يهاجمون زورو والبقيّة

271
00:23:22,390 --> 00:23:23,810
:في الحلقة القادمة من وان بيس

272
00:23:23,810 --> 00:23:27,230
"!قوّة أوني الجليد! نسخة جديدة لطلقات الطّاعون"

273
00:23:27,230 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا