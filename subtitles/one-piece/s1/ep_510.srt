1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,910
"وأقول "أريد أن أصير أقوى

5
00:01:01,910 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,060 --> 00:03:38,240
فقد لوفي أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:39,590 --> 00:03:43,660
.والتقى لاحقًا مع ملك الظّلام ريلي

39
00:03:43,660 --> 00:03:46,080
ما الّذي ستفعله يا لوفي-كُن؟

40
00:03:47,080 --> 00:03:49,790
...في تلك الأثناء، كان بقيّة طاقم قبّعة القشّ

41
00:03:49,790 --> 00:03:54,840
.في طريقهم للّقاء وفاءً بوعدهم لبعضهم وللوفي

42
00:03:55,330 --> 00:03:56,920
.مفهوم

43
00:03:57,360 --> 00:03:58,840
.اتّخذت قراري

44
00:03:59,260 --> 00:04:01,900
.سأعود

45
00:04:01,900 --> 00:04:03,130
!إلى مارينفورد

46
00:04:06,000 --> 00:04:10,720
"!كارثة لسانجي! عودة الملكة إلى المملكة"

47
00:04:13,620 --> 00:04:15,960
.هـ-هذه سفينة البحريّة رقم 204

48
00:04:15,960 --> 00:04:17,860
.نطلب الإذن بالدّخول

49
00:04:17,860 --> 00:04:19,770
.أتيتم في الوقت المناسب

50
00:04:19,770 --> 00:04:22,360
حسنًا، هلّي برقم رمزكم؟

51
00:04:22,360 --> 00:04:25,200
.رقم رمزنا هو 5063

52
00:04:26,010 --> 00:04:29,730
.تمّ تأكيد الرّقم. افتحوا بوّابة العدالة

53
00:04:29,730 --> 00:04:30,580
!حاضر

54
00:04:31,360 --> 00:04:32,220
.إغلاق

55
00:04:32,220 --> 00:04:34,050
.حسنًا، أبليت جيّدًا

56
00:04:34,710 --> 00:04:37,960
لوفي-كُن، كيف تشعر؟

57
00:04:37,960 --> 00:04:40,710
.أشعر بخير الآن. لا داعي للقلق

58
00:04:40,710 --> 00:04:45,290
،الشّيتشيبوكاي الملكيّ السّابق
!فارس البحر جينبي

59
00:04:46,470 --> 00:04:49,890
،نائب القبطان السّابق لملك القراصنة

60
00:04:50,320 --> 00:04:52,930
!ملك الظّلام سيلفرز ريلي

61
00:04:53,560 --> 00:04:57,900
!إضافة لقبّعة القشّ لوفي! ما الّذي يريدونه؟

62
00:05:10,510 --> 00:05:15,750
في تلك الأثناء في مملكة تورينو حيث
.توقّف البشر والطّيور عن قتال بعضهم

63
00:05:15,750 --> 00:05:20,110
هل ستغادر الآن فعلاً أيّها التّانوكي؟
.صرنا أصدقاء لتوّنا

64
00:05:22,050 --> 00:05:27,330
،نعم، قرأت في الصّحيفة عن محنة صديقي

65
00:05:27,330 --> 00:05:29,760
.لذلك أريد العودة في أقرب وقت ممكن

66
00:05:30,840 --> 00:05:33,140
...لا أصدّق ما حدث لأخي لوفي

67
00:05:33,920 --> 00:05:36,480
!الّذي التقينا به في ألاباستا

68
00:05:37,130 --> 00:05:41,560
.أريد رؤية لوفي قريبًا وتقديم الرّعاية الطّبّيّة له

69
00:05:41,560 --> 00:05:43,280
.لا بدّ أنّه ضغط كثيرًا على نفسه كالعادة

70
00:05:44,120 --> 00:05:45,430
!أيّتها التّانوكي

71
00:05:45,430 --> 00:05:49,560
!أنا سعيد لأنّكم على وفاق مع الطّيور

72
00:05:49,560 --> 00:05:53,830
.هذا لأنّك خاطرت بحياتك وتحدّثت معها

73
00:05:53,830 --> 00:05:55,120
...كلاّ

74
00:05:55,500 --> 00:05:58,920
!اسمعوا يا رفاق، عيشوا مع البشر بسلام

75
00:05:59,960 --> 00:06:05,670
كلّ ما يريدونه هي الأعشاب المختلفة
!الّتي تنمو على تلك الشّجرة

76
00:06:05,670 --> 00:06:10,690
!هذا صحيح! لا نريد بيضك ولا نريد أذيّتك

77
00:06:10,690 --> 00:06:15,680
!نحن مختلفون عن أولئك الّذين طردوك من جزيرتك الأمّ

78
00:06:16,600 --> 00:06:18,210
،بما أنّك ذكرت الأمر الآن

79
00:06:18,210 --> 00:06:23,020
الدّواء الّذي صنعتموه من النّباتات
!الّتي على تلك الشّجرة مفيد للغاية

80
00:06:23,020 --> 00:06:24,780
.شفيت جراحي سلفًا

81
00:06:24,780 --> 00:06:30,280
.بالطّبع! هذا دواء توارثناه أبًا عن جدّ

82
00:06:31,410 --> 00:06:36,620
!بصراحة، أريد البقاء في هذه الجزيرة ودراسة النّباتات

83
00:06:36,620 --> 00:06:41,710
.أنا واثق أنّ هنالك مكوّنات غير مألوفة لي
.لكنّني لا أملك الوقت

84
00:06:41,710 --> 00:06:43,130
!تعال وزرنا ثانية

85
00:06:43,130 --> 00:06:47,130
!هذا صحيح! أنت مرحّب بك دائمًا أيّها التّانوكي

86
00:06:48,380 --> 00:06:51,590
!فعلاً؟ سرّني سماع ذلك

87
00:06:52,800 --> 00:06:57,680
!عندما ألتقي بأصدقائي، سأخبرهم عن هذه البلاد

88
00:06:57,680 --> 00:07:01,150
!وسآتي لزيارتكم ثانية

89
00:07:02,350 --> 00:07:05,570
.خذ هذه. أمامك رحلة طويلة وستجوع

90
00:07:05,570 --> 00:07:07,030
.شكرًا لك

91
00:07:07,030 --> 00:07:09,120
!زرنا ثانية أيّها التّانوكي

92
00:07:11,110 --> 00:07:13,620
!إنّها حلوى قطنيّة

93
00:07:13,620 --> 00:07:17,160
!حسنًا يا رفاق، كونوا لطفاء مع بعضكم

94
00:07:18,290 --> 00:07:21,120
!الوداع أيّها التّانوكي

95
00:07:21,120 --> 00:07:24,590
!حسنًا، لديّ علبة طعام وبعض الحلوى القطنيّة

96
00:07:24,590 --> 00:07:27,820
!سأنطلق نحو نقطة اللّقاء الآن

97
00:07:28,510 --> 00:07:31,220
!لا أملك سفينة قراصنة

98
00:07:31,220 --> 00:07:33,640
!حتّى إن كنت أملك واحدة، لا أملك ملاّحًا

99
00:07:33,640 --> 00:07:37,350
!لذلك لا أدري كيف أذهب إلى شابوندي

100
00:07:37,350 --> 00:07:42,100
!كلاّ، سأجد أيّ سفينة... كلاّ، سأضيع هكذا

101
00:07:42,100 --> 00:07:44,580
!ما الّذي سأفعله؟

102
00:07:44,580 --> 00:07:46,610
...أ-أيّها التّانوكي

103
00:07:46,610 --> 00:07:51,570
!سُحقًا! عليّ أن أقوم بواجبي كطبيب للطّاقم يا لوفي

104
00:07:52,990 --> 00:07:55,060
ماذا؟ ماذا قلت؟

105
00:07:55,060 --> 00:07:58,130
سيوصلني والدك إلى هناك؟

106
00:07:59,580 --> 00:08:01,830
!أجل، إلى اللّقاء

107
00:08:02,220 --> 00:08:05,460
!نحن مرتفعون وسريعون

108
00:08:05,460 --> 00:08:07,920
!سأصل إلى هناك في غضون لحظات

109
00:08:09,000 --> 00:08:11,170
ماذا؟ بإمكانك الإسراع أكثر؟

110
00:08:14,760 --> 00:08:16,600
!هذا رائع

111
00:08:17,930 --> 00:08:21,020
!وكأنّني أركب أفعوانيّة

112
00:08:28,690 --> 00:08:32,610
...أشعر بالغثيان... تحمّست كثيرًا

113
00:08:34,570 --> 00:08:37,830
!يا نيوز كو! أعطني صحيفة

114
00:08:39,240 --> 00:08:42,370
.سأقرؤها وأنا أتناول غدائي

115
00:08:42,370 --> 00:08:46,250
.لا بدّ من وجود جديد عن أخبار الحرب الآن

116
00:08:47,000 --> 00:08:48,460
!هذا لذيذ

117
00:08:50,300 --> 00:08:52,630
!هذا غير ممكن

118
00:08:54,590 --> 00:08:57,000
!لماذا؟! ما الّذي يحدث؟

119
00:08:57,000 --> 00:08:59,180
!ما الّذي دفع لوفي ليقوم بهذا...؟

120
00:09:11,880 --> 00:09:13,950
،أثناء ذلك في الأزرق الشّرقيّ

121
00:09:13,950 --> 00:09:18,030
...قام الجيش الثّوريّ بتحرير روبين

122
00:09:30,380 --> 00:09:31,590
!أنقذتمونا

123
00:09:31,590 --> 00:09:33,920
!شكرًا على قدومكم أيّها الجيش الثّوريّ

124
00:09:34,970 --> 00:09:36,280
!حمدًا على هذا

125
00:09:36,280 --> 00:09:37,240
!روبين

126
00:09:37,550 --> 00:09:38,510
!سوران

127
00:09:38,510 --> 00:09:42,680
حمدًا على هذا. أيستطيع الجميع
أن يكونوا أحرارًا بدءًا من الآن؟

128
00:09:43,250 --> 00:09:44,310
.نعم

129
00:09:46,560 --> 00:09:51,390
.على الأقلّ، لن تُجبرون على بناء الجسر

130
00:09:52,070 --> 00:09:53,360
...عفوًا

131
00:09:53,940 --> 00:09:55,990
هلاّ قبلتِ بهذه؟

132
00:10:05,250 --> 00:10:07,460
.شكرًا لك يا سوران

133
00:10:08,540 --> 00:10:10,960
سترحلين، صحيح يا روبين؟

134
00:10:11,750 --> 00:10:12,960
.نعم

135
00:10:18,010 --> 00:10:19,340
!روبين

136
00:10:20,090 --> 00:10:21,720
أيمكنني أن أراك ثانية؟

137
00:10:42,700 --> 00:10:44,280
.روبين-سان

138
00:10:44,910 --> 00:10:47,870
هل ستتّجهين صوب شابوندي؟

139
00:10:47,870 --> 00:10:49,080
.نعم

140
00:10:49,080 --> 00:10:51,210
".نور الثّورة"

141
00:10:52,100 --> 00:10:57,920
.هكذا سمّيناك وبحثنا عنك لأزيد من عشر سنوات

142
00:10:58,670 --> 00:11:03,560
،أنت النّاجية الوحيدة من أوهارا
.البلاد الّتي قاتلت ضدّ العالم

143
00:11:04,890 --> 00:11:07,140
،عندما نجدك

144
00:11:07,140 --> 00:11:09,690
!علينا أن نحميك من الحكومة بأيّ ثمن

145
00:11:09,690 --> 00:11:11,230
.هذه كانت كلمات الزّعيم لنا

146
00:11:12,730 --> 00:11:13,480
الزّعيم؟

147
00:11:15,440 --> 00:11:19,110
.قائد الجيش الثوّريّ، دراغون

148
00:11:19,990 --> 00:11:22,160
...والد لوفي

149
00:11:23,660 --> 00:11:25,330
!يا لغرابة الأقدار

150
00:11:27,540 --> 00:11:29,830
.أتوسّلك ثانية

151
00:11:29,830 --> 00:11:34,630
.قابلي زعيمنا! سآخذك إليه

152
00:11:34,630 --> 00:11:39,090
.لا أستطيع. عليّ العودة لمكان آخر

153
00:11:39,460 --> 00:11:42,480
.كما أنّه لا حاجة لتحموني

154
00:11:43,930 --> 00:11:46,600
.لأنّ لديّ أصدقائي

155
00:11:47,040 --> 00:11:50,520
.تقصدين طاقم قبّعة القشّ

156
00:11:50,520 --> 00:11:51,440
.نعم

157
00:11:51,440 --> 00:11:55,440
.حسنًا، دعينا نوصلك ولو لجزء من الطّريق على الأقلّ

158
00:11:55,440 --> 00:12:00,690
لا يمكن رؤية نهاية هذا الجسر
.حتّى إن سرتِ لأيّام عدّة

159
00:12:00,690 --> 00:12:03,410
.دعينا نأخذك إلى حيث تذهبين

160
00:12:05,030 --> 00:12:10,290
!سنكون قادرين على فتح السّجنين الثّالث والرّابع قريبًا

161
00:12:10,290 --> 00:12:11,440
.عُلم

162
00:12:11,440 --> 00:12:15,210
.أخبر البقيّة أن يستعدّوا لتحرير السّجناء

163
00:12:15,210 --> 00:12:16,440
!حاضر

164
00:12:16,440 --> 00:12:18,390
هلّي أن أطلب منك شيئًا؟

165
00:12:19,460 --> 00:12:20,800
.اطلبي ما تشائين

166
00:12:20,800 --> 00:12:24,880
لماذا يحتاجني الجيش الثّوريّ؟

167
00:12:25,220 --> 00:12:26,920
....ذ-ذلك لأنّ

168
00:12:28,880 --> 00:12:32,680
ستشاهدين العديد من البلدات المهجورة
.قبل أن نتمكّن من الوصول لنهاية الجسر

169
00:12:32,680 --> 00:12:38,110
.هذا لأنّ البلاد بأكملها تتحرّك مع تقدّم عمليّات البناء

170
00:12:42,190 --> 00:12:44,360
لماذا يبنون هذا الجسر؟

171
00:12:44,360 --> 00:12:47,990
.إنّه أمر من نبلاء العالم، التّنانين السّماويّين

172
00:12:47,990 --> 00:12:49,280
التّنانين السّماويّين؟

173
00:12:49,280 --> 00:12:52,370
!لا أهتمّ إن كان هنالك سبب أم لا

174
00:12:52,370 --> 00:12:56,040
فلن يقلّل ذلك من عدد القتلى لأولئك
!الّذين يسمّونهم عبيدًا

175
00:12:59,040 --> 00:13:04,550
،هل رأيتم ابن دراغون-سان
قبّعة القشّ لوفي، في الصّحيفة اليوم؟

176
00:13:04,550 --> 00:13:08,220
،نعم. لقد فُقد بعد الحرب

177
00:13:08,220 --> 00:13:10,400
.لكنّه ظهر ثانية وقام بذلك الفعل

178
00:13:11,010 --> 00:13:14,560
.علينا أن نري هذه المقالة لنيكو روبين حالاً

179
00:13:14,560 --> 00:13:16,520
.إنّها قلقة حياله

180
00:13:16,520 --> 00:13:19,900
.لا أظنّ أنّهم وصلوا لنهاية الأمر بعد

181
00:13:20,900 --> 00:13:22,720
!حسنًا، شكرًا لك

182
00:13:23,530 --> 00:13:24,860
.هذه لك يا روبين-سان

183
00:13:26,910 --> 00:13:31,040
!لوفي! أنا سعيدة لأنّه بخير

184
00:13:34,960 --> 00:13:38,750
ما الأمر؟ أهنالك خبر مضحك؟

185
00:13:40,680 --> 00:13:42,210
.نعم

186
00:14:14,370 --> 00:14:17,960
،أثناء ذلك، على جزيرة النيوكاما

187
00:14:17,960 --> 00:14:22,750
...جزيرة مومويرو في مملك كاماباكّا

188
00:14:28,930 --> 00:14:34,640
!قلتُ "أعطوني سفينة!" لديّ وعد أفي به

189
00:14:34,640 --> 00:14:37,430
!أضعت الكثير من الوقت أعبث معكم

190
00:14:37,840 --> 00:14:40,130
،بذلك العذر يا كاندي-تشان

191
00:14:40,130 --> 00:14:42,910
!أنت تحاول الهرب من الجزيرة فحسب

192
00:14:42,910 --> 00:14:44,570
!لن نسمح لك بفعل ذلك

193
00:14:44,570 --> 00:14:47,440
!نعم، ذلك صحيح تمامًا

194
00:14:48,160 --> 00:14:51,130
بالطّبع، أريد مغادرة هذه البلاد

195
00:14:51,130 --> 00:14:53,440
!الّتي تخلو من النّساء بالكامل

196
00:14:53,440 --> 00:14:55,640
ما تلك السّفينة هناك؟

197
00:14:58,500 --> 00:15:02,210
!إ-إنّها إيفان-ساما! إيفان-ساما على متنها

198
00:15:05,800 --> 00:15:07,760
ماذا؟ من تكون؟

199
00:15:09,800 --> 00:15:13,350
ما الخطب؟ هل هي مهمّة لذلك الحدّ؟

200
00:15:13,350 --> 00:15:15,960
...إنّها ملكة مملكة كاماباكّا

201
00:15:17,020 --> 00:15:19,450
!إمبوريو إيفانكوف-ساما

202
00:15:19,450 --> 00:15:21,100
...ماذا؟ ذلك الاسم كان في

203
00:15:32,280 --> 00:15:34,280
إنّها مملكة الأوكاما من الصّحيفة؟

204
00:15:36,580 --> 00:15:39,450
.كانت مع لوفي، لذلك أظنّ أنّها تعرف الكثير

205
00:15:46,210 --> 00:15:48,360
.لم أركم منذ وقت طويل

206
00:15:49,090 --> 00:15:51,380
!لا أصدّق هذا

207
00:15:51,380 --> 00:15:53,760
!إ-إنّها من نوعي المفضّل

208
00:15:53,760 --> 00:15:56,120
!لا، مهلاً، مهلاً

209
00:15:57,180 --> 00:16:00,850
.إنّها هنا لأنّها أوكاما أيضًا

210
00:16:00,850 --> 00:16:02,060
!كدت أُخدع بذلك

211
00:16:03,520 --> 00:16:05,230
من أنت؟

212
00:16:05,230 --> 00:16:07,480
...أ-أنا

213
00:16:09,150 --> 00:16:11,030
!صدرها بارز للغاية

214
00:16:11,030 --> 00:16:13,320
!ومؤخّرتها مشدودة جدًّا

215
00:16:13,320 --> 00:16:16,280
!كلاّ، لن أُخدع بذلك

216
00:16:18,700 --> 00:16:22,330
أتريد شيئًا منّي أيّها الفتى كاندي؟

217
00:16:22,680 --> 00:16:26,460
...نعم، لديّ الكثير من الأسئلة لك! أوّلاً

218
00:16:26,460 --> 00:16:28,550
ما نوعك المفضّل من الرّجال؟

219
00:16:28,550 --> 00:16:31,460
!كلاّ، الأمر يخصّ لوفي

220
00:16:31,460 --> 00:16:34,470
لوفي؟ تقصد فتى قبّعة القشّ؟

221
00:16:34,470 --> 00:16:35,890
!أصبت

222
00:16:35,890 --> 00:16:39,720
!أعلم أنّك كنت معه في مقرّ البحريّة

223
00:16:39,720 --> 00:16:42,140
!لوفي، يا لك من محظوظ

224
00:16:42,140 --> 00:16:44,480
.أعني، لا بدّ أنّكما مررتما بوقت صعب

225
00:16:44,480 --> 00:16:46,780
.أخبريني بكلّ شيء

226
00:16:46,780 --> 00:16:47,690
...يا آنستي

227
00:16:57,570 --> 00:16:59,930
ومن تكون أنت؟

228
00:16:59,930 --> 00:17:03,750
!تبًّا! عرفت أنّ هذا سيحدث! سُحقًا لك

229
00:17:03,750 --> 00:17:07,130
!وكيف تعرف فتى قبّعة القشّ؟

230
00:17:07,130 --> 00:17:08,170
.أنا من رفاق طاقمه

231
00:17:09,340 --> 00:17:10,500
!من رفاق طاقمه؟

232
00:17:15,070 --> 00:17:17,760
.هذا هو ملصق المطلوبين لفتى قبّعة القشّ

233
00:17:17,760 --> 00:17:19,010
.نعم، صحيح

234
00:17:19,620 --> 00:17:21,850
.وهذا ملصق "صائد القراصنة" زورو

235
00:17:21,850 --> 00:17:22,720
!لا أعرفه

236
00:17:23,220 --> 00:17:25,480
.وهذا ملصق "اللّصّة القطّة" نامي

237
00:17:27,760 --> 00:17:30,770
.وهذا ملصق "ملك القنّاصين" سوغيكينغ

238
00:17:30,770 --> 00:17:32,150
.نعم

239
00:17:32,150 --> 00:17:34,320
.وهذا هو أنت

240
00:17:34,320 --> 00:17:35,200
!كلاّ

241
00:17:35,200 --> 00:17:38,410
!أرأيت؟! لست ضمن هذه الملصقات

242
00:17:38,410 --> 00:17:42,080
!إذًا لا يوجد دليل أنّك من طاقم فتى قبّعة القشّ

243
00:17:42,080 --> 00:17:44,450
!أخبرتك أنّني كذلك

244
00:17:44,450 --> 00:17:48,250
!أخبرني كيف يُبلي لوفي في الحال يا ملك الأوكاما

245
00:17:48,680 --> 00:17:52,420
!أعلم أنّك كنت معه من الصّحيفة

246
00:17:52,420 --> 00:17:54,130
إذًا، أهذا أنت؟

247
00:17:54,130 --> 00:17:56,080
...قلتُ أنّه ليس أنا

248
00:17:56,680 --> 00:17:59,890
...إنّها ليس أنا... ولكنّه أنا

249
00:18:01,050 --> 00:18:03,720
.الاسم هو اسمي

250
00:18:07,580 --> 00:18:10,190
!لماذا تعاني لهذه الدّرجة؟

251
00:18:13,610 --> 00:18:17,150
!ذلك... أنا! إنّه أنا

252
00:18:17,150 --> 00:18:21,200
...ذلك الرّجل الغريب على الملصق هو أنا بالتّأكيد

253
00:18:25,040 --> 00:18:27,540
!كلاّ، إنّه لا يشبهك أبدًا

254
00:18:27,870 --> 00:18:29,630
!إذًا لا ترغمني على قول ذلك

255
00:18:29,630 --> 00:18:31,460
!تقيّأت دماءً أيّها المغفّل

256
00:18:31,830 --> 00:18:33,340
.لا فائدة

257
00:18:33,340 --> 00:18:36,410
%حتّى إن كانت هنالك فرصة 0.1

258
00:18:36,410 --> 00:18:40,090
،أنّك قد تكون دمية لدى حكومة العالم

259
00:18:40,090 --> 00:18:45,220
!فلن أخبرك أيّ معلومة تخصّ فتى قبّعة القشّ

260
00:18:45,220 --> 00:18:48,520
.أفهم ذلك. أعرني سفينة إذًا

261
00:18:48,520 --> 00:18:51,350
.سأذهب لنقطة اللّقاء مع لوفي

262
00:18:51,350 --> 00:18:52,810
.لن أعطيك سفينة

263
00:18:53,440 --> 00:18:55,230
!سأذهب سباحة إذًا

264
00:18:55,230 --> 00:18:57,720
!ماذا قلت للتّوّ؟

265
00:18:57,720 --> 00:19:00,990
!إذًا فأنت لا تقول أنّك عضو في طاقمه فحسب

266
00:19:03,070 --> 00:19:05,990
.لا خيار لديّ. أثّرت بي

267
00:19:05,990 --> 00:19:10,080
من أجل شغفك، سأخبرك ماذا
...حدث لفتى قبّعة القشّ

268
00:19:13,120 --> 00:19:17,000
!أو لا! مرحى

269
00:19:17,000 --> 00:19:18,300
أي أنّك لن تخبره؟

270
00:19:18,300 --> 00:19:19,800
!خدعتنا جميعًا

271
00:19:19,800 --> 00:19:21,340
!إيفان-ساما

272
00:19:21,340 --> 00:19:23,000
!اخرسوا أيّها المغفّلون

273
00:19:25,390 --> 00:19:26,890
...تبًّا

274
00:19:26,890 --> 00:19:29,270
!يبدو أنّ دفاعاته مرخيّة

275
00:19:29,270 --> 00:19:33,270
!هذه فرصتنا! فلنلبسه فستان الحلويّات

276
00:19:33,610 --> 00:19:36,360
!لن أرتديه ثانية! تراجعوا عنّي

277
00:19:37,220 --> 00:19:41,510
!أنا أرجَل الرّجال وأحبّ النّساء

278
00:19:41,510 --> 00:19:43,980
!لا تقتربوا منّي أيّها المغفّلون

279
00:19:43,980 --> 00:19:45,490
!بو! بو

280
00:19:47,200 --> 00:19:49,640
أنت، اسمك إيفان، صحيح؟

281
00:19:50,160 --> 00:19:53,120
!قرّرت سرقة سفينة لأنّني قرصان

282
00:19:54,070 --> 00:19:55,710
!عليك قتالي مباشرة

283
00:19:56,540 --> 00:19:57,660
!لا بأس

284
00:19:58,240 --> 00:20:03,040
والآن سيقاتل سيّد أسلوب كاماباكّا
...كينبو النيوكاما

285
00:20:03,040 --> 00:20:06,430
ضدّ "السّاق السّوداء" سانجي
!في نزال واحد لثلاث دقائق

286
00:20:09,680 --> 00:20:14,190
.حتّى نائبته كانت قويّة جدًّا
!لا بدّ أنّه مرعب

287
00:20:14,190 --> 00:20:16,440
!سأقدّم كلّ ما لديّ من البداية

288
00:20:16,440 --> 00:20:17,730
!ابدآ

289
00:20:17,730 --> 00:20:19,710
!ساق الشّيطان

290
00:20:20,640 --> 00:20:23,320
!لحم مفروم من الدّرجة الأولى

291
00:20:29,640 --> 00:20:31,580
!يا-يا لها من ركلة قويّة

292
00:20:31,580 --> 00:20:35,410
...يـ-يجب أن أكون أقوى، لكنّي سأسقط

293
00:20:36,420 --> 00:20:39,750
...سأسقط

294
00:20:39,750 --> 00:20:41,600
!أو لا

295
00:20:43,130 --> 00:20:45,640
!مرحى

296
00:20:45,640 --> 00:20:48,600
!لم تكن ستسقط؟! لقد خدعتنا

297
00:20:49,970 --> 00:20:52,640
.يبدو أنّك فتى قويّ

298
00:20:52,640 --> 00:20:55,230
.لكن أظنّ أنّك تحتاج لبعض التّأديب

299
00:20:55,230 --> 00:20:56,520
ماذا؟

300
00:20:56,520 --> 00:21:00,530
!كينبو النيوكاما: التّقنية السّرّيّة التّجميليّة 44

301
00:21:00,530 --> 00:21:02,870
!قبضة إزالة الشّعر

302
00:21:06,030 --> 00:21:07,570
!غمزة الموت

303
00:21:08,200 --> 00:21:10,210
!غمزة الجحيم

304
00:21:11,120 --> 00:21:13,620
!غمزة المجرّة

305
00:21:28,050 --> 00:21:32,220
سأخبرك كيف حال فتى قبّعة القشّ
!أيّها الفتى ذو الحاجب اللّولبيّ

306
00:21:33,320 --> 00:21:35,350
لماذا غيّرت رأيك؟

307
00:21:35,950 --> 00:21:40,060
.لأنّ العالم بأسره يدري بذلك الآن

308
00:21:40,060 --> 00:21:42,880
.أتساءل ما الّذي يفكّر فيه

309
00:21:43,530 --> 00:21:45,190
أهذه صحيفة اليوم؟

310
00:21:45,190 --> 00:21:46,820
!مهلاً! لوفي

311
00:21:46,820 --> 00:21:49,740
.إيفان-سان، ثمّة اتّصال لك من بالتيغو

312
00:21:49,740 --> 00:21:50,780
فعلاً؟

313
00:21:50,780 --> 00:21:52,910
.اذهب إلى مبنى الاتّصال

314
00:21:53,880 --> 00:21:55,960
،بسبب الحرب الأخيرة

315
00:21:55,960 --> 00:22:00,250
!صار النّاس يعلمون الكثير عنك الآن يا دراغون

316
00:22:00,250 --> 00:22:03,050
ألم يزعج ذلك رجالك؟

317
00:22:04,510 --> 00:22:10,100
يبدو أنّهم ارتاحوا لمعرفة أنّ زعيمهم
.الغامض كان من البشر في النّهاية

318
00:22:10,100 --> 00:22:13,470
.ذلك لا يهمّ الآن. ما عاد لوفي طفلاً

319
00:22:13,470 --> 00:22:18,060
.لكنّني لا أصدّق أنّك كنت معه

320
00:22:18,060 --> 00:22:21,530
إنّ الحظّ أمر غريب، صحيح؟

321
00:22:22,440 --> 00:22:26,820
.على أيّ حال، كان هروبًا غير متوقّع لي ولإينازوما

322
00:22:26,820 --> 00:22:31,570
لديّ الكثير من الأمور الّتي أريد
.مناقشتها معك وأسئلة أكثر منها

323
00:22:31,850 --> 00:22:33,300
.بالطّبع

324
00:22:33,300 --> 00:22:38,640
.علينا أن نستدعي قادتنا من جميع أنحاء العالم بسرعة

325
00:22:38,640 --> 00:22:40,200
إنّ موت اللّحية البيضاء

326
00:22:40,200 --> 00:22:44,390
.سيغيّر وضع العالم ونظام الحكومة

327
00:22:44,390 --> 00:22:49,180
.وفوق ذلك، عليّ إخبارك ماذا حلّ بكوما

328
00:22:49,180 --> 00:22:52,350
.نعم، أريد تفاصيل ذلك

329
00:22:52,350 --> 00:22:56,350
ما الّذي دفعه ليطيع الحكومة؟

330
00:22:56,840 --> 00:22:59,690
.كوما الّذي عرفتُه ما عاد موجودًا

331
00:23:00,170 --> 00:23:03,560
!لقد حاول قتلي

332
00:23:04,140 --> 00:23:07,190
بالمناسبة يا دراغون، هل قرأت صحيفة اليوم؟

333
00:23:07,190 --> 00:23:10,700
!فاجأني فتى قبّعة القشّ ثانية

334
00:23:10,700 --> 00:23:13,320
.إنّه جامح بقدر جموح والده

335
00:23:13,320 --> 00:23:16,990
!لا أصدّق أنّه قام بأمر كهذا في مارينفورد

336
00:23:25,290 --> 00:23:27,630
.تضرّر مقرّ البحريّة بشدّة في حرب القمّة

337
00:23:28,690 --> 00:23:30,950
،عاد لوفي إلى المكان الّذي فقد فيه إيس

338
00:23:30,950 --> 00:23:34,350
.لكن برفقة ريلي وجينبي هذه المرّة

339
00:23:34,350 --> 00:23:37,360
ستصدم هذه الأخبار الأعجوبيّة

340
00:23:37,360 --> 00:23:40,350
.أصدقاءه والعالم بأسره أيضًا

341
00:23:40,350 --> 00:23:41,770
:في الحلقة القادمة من وان بيس

342
00:23:41,770 --> 00:23:45,030
"!عودة غير متوقّعة! لوفي، إلى مارينفورد"

343
00:23:45,030 --> 00:23:47,510
!ملك القراصنة، لن يكون إلاّ أنا