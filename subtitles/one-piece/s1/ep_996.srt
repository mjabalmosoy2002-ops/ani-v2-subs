1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:09,530 --> 00:02:11,890
!أيّها الحمقى

29
00:02:11,890 --> 00:02:14,120
!توقّفوا عن الشّرب

30
00:02:14,870 --> 00:02:16,500
!احملوا أسلحتكم

31
00:02:16,500 --> 00:02:19,040
!نتعرّض لغارة

32
00:02:20,080 --> 00:02:25,350
!افتحوا بلاد وانو

33
00:02:34,350 --> 00:02:39,610
"!شغب في أونيغاشيما! تبدأ حرب لوفي الشّاملة"

34
00:02:53,700 --> 00:02:54,750
!أودن

35
00:03:01,210 --> 00:03:03,170
!سوناتشي

36
00:03:31,820 --> 00:03:34,420
!أسلوب أودن ذو السّيفين

37
00:03:34,950 --> 00:03:37,660
!توتسكا الفردوس

38
00:03:45,080 --> 00:03:48,440
...النّدبة الّتي أعطانيها أودن

39
00:03:48,440 --> 00:03:50,530
لماذا تؤلمني؟

40
00:03:50,530 --> 00:03:53,930
كيف اخترق النّصل جسدي؟

41
00:03:54,140 --> 00:03:57,760
!لا تستخفّ بتابعيّ السّاموراي

42
00:03:57,760 --> 00:04:00,480
...لا أمانع

43
00:04:01,810 --> 00:04:04,820
!إن نُسيت

44
00:04:04,820 --> 00:04:06,320
...لكنّ

45
00:04:10,860 --> 00:04:14,950
!روحي ستستمرّ في العيش

46
00:04:24,000 --> 00:04:29,010
!هل يستعملون ريوو أودن؟

47
00:04:32,470 --> 00:04:35,310
!فلتخترقك أنصالنا حتّى الجانب الآخر

48
00:05:12,420 --> 00:05:14,090
!كايدو

49
00:05:30,060 --> 00:05:31,780
!كايدو-ساما

50
00:05:36,120 --> 00:05:39,870
!يا-يا رفاق

51
00:05:43,240 --> 00:05:46,440
!إنّهم الأكازايا التّسعة

52
00:05:46,440 --> 00:05:48,790
!أتباع أودن الحقيقيّون

53
00:05:48,790 --> 00:05:51,300
!إنّهم أقوياء

54
00:05:52,210 --> 00:05:55,050
!هذه وليمة خطيرة

55
00:05:55,460 --> 00:05:58,050
!هل مات كايدو؟

56
00:05:58,930 --> 00:06:01,430
!مستحيل

57
00:06:01,430 --> 00:06:04,250
!لا يعقل أن يموت كايدو-ساما المنيع

58
00:06:04,250 --> 00:06:08,480
!قاتلوهم! اقتلوا جرذان الأكازايا

59
00:06:10,940 --> 00:06:16,570
قبّعة القشّ وكيد والبقيّة سابقًا كانوا مجرّد
!تشتيت للقيام بهذا الهجوم المفاجئ؟

60
00:06:16,570 --> 00:06:18,470
!ابقوا متأهّبين يا رفاق

61
00:06:18,470 --> 00:06:21,990
!قد لا يزال هنالك متسلّلون في مكان ما

62
00:06:21,990 --> 00:06:23,870
!هذا صحيح

63
00:06:56,950 --> 00:06:59,530
!استمعوا أيّها الضّعفاء

64
00:06:59,530 --> 00:07:03,240
!لن نسمح لكم بأذيّة كينييمون والبقيّة

65
00:07:03,240 --> 00:07:05,530
!حسنًا! سننضمّ إليهم

66
00:07:05,530 --> 00:07:08,000
!لنوسع كايدو ضربًا ثانية

67
00:07:08,000 --> 00:07:09,630
!ها أنا ذي

68
00:07:10,880 --> 00:07:12,380
!ياماتو

69
00:07:14,500 --> 00:07:15,670
!نطحة

70
00:07:19,170 --> 00:07:20,300
!أولتي

71
00:07:28,560 --> 00:07:30,940
!أتيتم بأعداد كبيرة ثانية

72
00:07:30,940 --> 00:07:33,570
!كيف تجرؤ على ضربي؟

73
00:07:33,980 --> 00:07:36,990
!آلمني ذلك كثيرًا

74
00:07:38,860 --> 00:07:41,010
،لقد هاجمتني رغم أنّني حليفتك

75
00:07:41,010 --> 00:07:44,660
...كما أنّك تركض رفقة قبّعة القشّ

76
00:07:44,660 --> 00:07:46,580
!ما الّذي تفعله-أرينسو؟

77
00:07:48,200 --> 00:07:50,290
...لا يوجد أيّ خطأ

78
00:07:50,290 --> 00:07:54,550
!لقد حان اليوم الّذي أصبح فيه كوزكي أودن أخيرًا

79
00:07:56,260 --> 00:07:58,210
!كوزكي أودن؟

80
00:07:58,510 --> 00:08:01,720
!عمّ تتكلّم؟! هل أنت مجنون؟

81
00:08:02,640 --> 00:08:04,430
!أنا جادّ

82
00:08:06,930 --> 00:08:08,620
!هل أنت بخير؟

83
00:08:08,620 --> 00:08:11,650
!لنوسعهم ضربًا ونواصل تحرّكنا

84
00:08:11,650 --> 00:08:12,400
!أجل

85
00:08:13,980 --> 00:08:16,820
!يا سيّدي الصّغير ياماتو، لدينا مشكلة

86
00:08:16,820 --> 00:08:22,410
تعرّض والدك للهجوم للتّوّ
!وثمّة العديد من الأعداء في الطّابق

87
00:08:22,410 --> 00:08:24,530
!كفاك عبثًا في الأرجاء

88
00:08:24,530 --> 00:08:25,660
!أعلم

89
00:08:25,660 --> 00:08:26,620
ماذا؟

90
00:08:26,620 --> 00:08:29,850
،ما عدت حليفًا لكم

91
00:08:29,850 --> 00:08:32,000
!ولا أهتمّ إن مات والدي

92
00:08:33,920 --> 00:08:35,090
!ماذا؟

93
00:08:39,630 --> 00:08:41,360
...فاكهة المطّاط

94
00:08:41,360 --> 00:08:43,310
!السّوط

95
00:08:55,690 --> 00:08:57,860
ما الأمر هذه المرّة؟

96
00:08:57,860 --> 00:09:00,770
...يحدث الكثير في هذه الوليمة بالفعل

97
00:09:01,240 --> 00:09:03,700
...فاكهة المطّاط

98
00:09:04,110 --> 00:09:07,080
!مسدّس الفيل

99
00:09:09,750 --> 00:09:11,080
...لا بدّ أنّه

100
00:09:25,050 --> 00:09:26,180
!كلاّ

101
00:09:26,180 --> 00:09:27,640
!لقد رأت لوفي

102
00:09:37,480 --> 00:09:40,150
!كلاّ! بيغ مام

103
00:09:40,150 --> 00:09:42,070
!ليس وأنا مشغول جدًّا

104
00:09:43,950 --> 00:09:45,800
.وجدتك أخيرًا

105
00:09:45,800 --> 00:09:50,210
!يا قبّعة القشّ

106
00:10:49,510 --> 00:10:50,770
!غرفة

107
00:11:02,690 --> 00:11:04,360
!مهلاً

108
00:11:05,070 --> 00:11:11,200
ياماتو موجود هنا! تريد الإمساك به والفوز
بحقّ تحدّي أحد كبار النّجوم، صحيح؟

109
00:11:11,780 --> 00:11:13,660
.لديّ شأن آخر

110
00:11:27,460 --> 00:11:29,320
!ابتعدي عن طريقي يا أولتي

111
00:11:29,320 --> 00:11:32,890
!أنا كوزكي أودن! وسأطيح بكايدو

112
00:11:32,890 --> 00:11:35,250
!من أودن أيّها الغبيّ

113
00:11:35,250 --> 00:11:38,440
!عليك تقدير عائلتك

114
00:11:41,350 --> 00:11:42,960
!لا يحقّ لك الكلام

115
00:11:42,960 --> 00:11:45,650
!في تلك الحالة، كوني لطيفة مع بيج وان

116
00:11:45,650 --> 00:11:48,780
!ماذا؟! لا تمل عليّ ما أفعل

117
00:11:49,740 --> 00:11:51,160
...أنا

118
00:11:51,160 --> 00:11:56,040
أعامل بي-تان بلطف أكثر
!من أيّ أحد آخر في العالم

119
00:12:08,550 --> 00:12:10,720
...مدفع

120
00:12:12,300 --> 00:12:13,850
!نطحة أولتي

121
00:12:36,820 --> 00:12:39,910
!هيّا بنا! علينا إنقاذه الآن

122
00:12:39,910 --> 00:12:40,920
!مهلاً

123
00:12:42,660 --> 00:12:44,160
!انظري هناك

124
00:12:44,160 --> 00:12:46,130
...ماذا؟! أهذه

125
00:12:49,960 --> 00:12:51,890
!شينوبو-تشان

126
00:12:54,260 --> 00:12:57,040
!لا تقلقي يا نيكو روبين

127
00:12:57,040 --> 00:12:59,680
!لدينا أصدقاء يُعتمد عليهم

128
00:13:00,060 --> 00:13:01,640
!أيّها الزّعيم-سان

129
00:13:09,400 --> 00:13:11,450
...كحال شينوبو

130
00:13:12,360 --> 00:13:16,370
!عدم جلب الأنظار إلينا سيساعدنا في مرحلة معيّنة

131
00:13:16,370 --> 00:13:19,830
!لذلك تحلّي بالصّبر حاليًّا

132
00:13:20,330 --> 00:13:22,670
!نعم، فهمت

133
00:13:22,670 --> 00:13:27,040
!عندما سيحين الوقت، سنظهر كلّ ما في جعبتنا

134
00:13:27,040 --> 00:13:30,800
!سأعتمد عليك أيّها الزّعيم-سان

135
00:13:42,510 --> 00:13:44,810
!كاروت! لنهرب من هنا

136
00:13:45,560 --> 00:13:46,860
!حسنًا

137
00:13:48,650 --> 00:13:54,370
!ذلك مستحيل-جدار! أوامر ماما مطلقة

138
00:13:55,820 --> 00:13:58,250
!هذا صحيح

139
00:14:02,030 --> 00:14:03,910
!جهّزوا أنفسكم

140
00:14:05,540 --> 00:14:07,670
!كرات سوداء

141
00:14:11,420 --> 00:14:14,100
!هل أنت بخير؟

142
00:14:14,430 --> 00:14:16,390
!ها أنا ذي

143
00:14:16,390 --> 00:14:18,600
!وأنا أيضًا

144
00:14:18,600 --> 00:14:20,810
!غيوم العاصفة

145
00:14:26,520 --> 00:14:28,060
!مخلب الكهرباء

146
00:14:33,360 --> 00:14:36,740
!نينبو: إكتوبلازم البرق

147
00:14:54,170 --> 00:14:55,880
!نجحنا

148
00:14:55,880 --> 00:14:57,840
!هيّا بنا يا كاروت

149
00:14:57,840 --> 00:14:58,970
!حسنًا

150
00:14:58,970 --> 00:15:01,470
!إلى حيث توجد بيغ مام

151
00:15:01,470 --> 00:15:03,450
!أجل

152
00:15:03,450 --> 00:15:06,770
!مهلاً... ماذا؟! لماذا؟

153
00:15:06,770 --> 00:15:09,360
!لقد تكبّدنا عناء الهرب منها للتّوّ

154
00:15:12,020 --> 00:15:13,360
...إنّني

155
00:15:13,360 --> 00:15:18,610
أملك مبدأ ينصّ على أنّني لن أتخلّى
!أبدًا على كنز وضعت يدي عليه

156
00:15:19,700 --> 00:15:21,700
هل تتحدّثين عن زوس؟

157
00:15:21,700 --> 00:15:26,710
!انتظرني! سأستعيده مهما كلّف الأمر

158
00:15:32,840 --> 00:15:35,710
!يا قبّعة القشّ

159
00:15:36,840 --> 00:15:38,850
...فاكهة المطّاط

160
00:15:42,890 --> 00:15:46,600
!مسدّس الفيل

161
00:16:15,420 --> 00:16:21,470
لقد جعلتَ من طاقم قراصنتي
...أضحوكة، وبهدف قتلك

162
00:16:23,470 --> 00:16:28,600
!أتيتُ كلّ هذه المسافة من توتولاند

163
00:16:29,140 --> 00:16:31,940
!يا قبّعة القشّ

164
00:16:41,740 --> 00:16:45,060
.كلاّ... هذا سيّئ

165
00:16:45,060 --> 00:16:48,950
!عليّ القتال أيضًا وإلاّ قتلتني ماما

166
00:16:53,880 --> 00:16:56,270
!لذيذ! لذيذ! لذيذ

167
00:16:56,270 --> 00:16:59,190
!لذيذ! لذيذ! لذيذ! لذيذ

168
00:16:59,190 --> 00:17:00,590
!لذيذ

169
00:17:04,260 --> 00:17:07,560
!زوس-تشان

170
00:17:09,430 --> 00:17:11,480
!نا... مي

171
00:17:13,140 --> 00:17:16,130
.أنا سعيدة لأنّك بخير

172
00:17:16,130 --> 00:17:18,450
.كنت قلقة حيالك

173
00:17:22,030 --> 00:17:26,200
.كنت قلقًا حيالك أيضًا. أنا جادّ

174
00:17:26,200 --> 00:17:27,760
!أنا سعيدة

175
00:17:27,760 --> 00:17:31,950
!إنّ الرّابط الّذي بيننا أعمق ممّا ظننت

176
00:17:31,950 --> 00:17:36,970
!إنّك تؤلمينني يا نامي! اتركيني

177
00:17:38,420 --> 00:17:41,170
!لن أتركك أبدًا

178
00:17:44,010 --> 00:17:46,310
...نامي

179
00:17:58,730 --> 00:18:00,590
!أجل، بإمكاني رؤيته

180
00:18:00,590 --> 00:18:04,570
!الرّابط الّذي يجمعكما يلمع كأنّه كنز

181
00:18:04,820 --> 00:18:06,950
!إنّها محقّة يا زوس

182
00:18:08,200 --> 00:18:13,750
...أنت كنزي النّفيس الخاصّ

183
00:18:45,110 --> 00:18:48,240
.أيا قمرًا غافلاً عن الفجر

184
00:18:49,660 --> 00:18:51,890
...لعلّ مرادك يتحقّق

185
00:18:51,890 --> 00:18:56,690
وتُلقى الظّلال التّسعة في اللّيلة
المحبوكة لعشرين سنة

186
00:18:56,690 --> 00:19:00,500
!ولتعرفنّ ضِياء الفجر

187
00:19:00,500 --> 00:19:03,690
،آن أواننا. إن أطحنا برأس كايدو

188
00:19:03,690 --> 00:19:09,390
!سنثأر بذلك لسيّدنا كوزكي أودن

189
00:19:23,770 --> 00:19:27,910
!اركضوا إلى كوري

190
00:19:30,200 --> 00:19:33,210
!لا تنظروا للوراء

191
00:19:44,250 --> 00:19:45,550
!أودن-ساما

192
00:19:48,460 --> 00:19:51,350
!أودن-ساما

193
00:20:00,520 --> 00:20:02,190
!أودن-ساما

194
00:20:25,550 --> 00:20:30,070
!يا قبّعة القشّ! لماذا أنت هنا؟

195
00:20:30,070 --> 00:20:35,930
،لا تقل لي أنّك أتيت للإطاحة بكايدو
.فذلك مضحك للغاية

196
00:20:35,930 --> 00:20:38,140
!صحيح! لستُ هنا لذلك السّبب

197
00:20:38,140 --> 00:20:39,310
ماذا؟

198
00:20:40,560 --> 00:20:41,730
!لوفي؟

199
00:20:46,560 --> 00:20:49,610
!يا فتى قبّعة القشّ... ماذا قلت؟

200
00:20:49,610 --> 00:20:52,080
!ليس ذلك هدفك يا لوفي؟

201
00:20:53,030 --> 00:20:55,660
...كلاّ! أنا

202
00:20:59,200 --> 00:21:05,170
بعد عشرين سنة، سيأتي ساموراي
...الأكازايا للظّفر بانتقامهم

203
00:21:05,420 --> 00:21:11,390
توقُّع أوروتشي الّذي لم يصدّقه
!أيّ أحد كان مرتبطًا بكلّ شيء

204
00:21:14,670 --> 00:21:18,290
.لا أصدّق أنّكم تعاونتم مع قراصنة

205
00:21:18,290 --> 00:21:23,170
...الإشاعة عن الظّلال في أطلال قلعة أودن

206
00:21:23,170 --> 00:21:25,170
.بانك هازارد

207
00:21:25,170 --> 00:21:26,940
.دريسروزا

208
00:21:26,940 --> 00:21:29,570
.الجزيرة الوهميّة زو

209
00:21:29,570 --> 00:21:34,110
!وخلف كلّ ذلك نجد طاقم قبّعة القشّ

210
00:21:34,440 --> 00:21:36,600
،ويا لها من صدفة غريبة

211
00:21:36,600 --> 00:21:42,290
كنتم تختبئون خلف طاقم قبّعة القشّ
.الّذين أعتبرهم أعداءً لي

212
00:21:42,290 --> 00:21:47,270
بعضكم تحمّل لعشرين سنة بينما
،قفز البقيّة عبر الزّمن وهربوا

213
00:21:47,270 --> 00:21:50,340
.وانتهى بكم المطاف بحشد كلّ القوّات

214
00:21:51,590 --> 00:21:55,970
!لكنّ القراصنة سيطعنونكم في الظّهر

215
00:21:57,220 --> 00:22:01,120
،في اللّحظة الّتي سيرون فيها هزيمتكم
.سيتخلّون عنكم وسيهربون

216
00:22:01,120 --> 00:22:07,360
إضافة لذلك، سبق أن أذقت الهزيمة
!لقبّعة القشّ سابقًا

217
00:22:08,520 --> 00:22:11,400
!إنّك تهينه بكلامك هذا

218
00:22:12,860 --> 00:22:15,700
!لا يشبهكم لوفي-دونو على الإطلاق

219
00:22:16,030 --> 00:22:20,180
!أنت وكايدو ورجالكما وأوروتشي وكلّ أتباعه

220
00:22:20,180 --> 00:22:23,750
!سأوسعكم ضربًا جميعًا

221
00:22:26,620 --> 00:22:28,710
...لوفي

222
00:22:31,340 --> 00:22:35,680
!إنّه الرّجل الّذي سيقف على قمّة البحر يومًا ما

223
00:22:37,260 --> 00:22:40,700
،حتّى إن كان الموت مصيرنا
!فسيظلّ واقفًا هنا

224
00:22:40,700 --> 00:22:44,140
!سيحلّ الفجر على بلاد وانو ثانية

225
00:22:44,140 --> 00:22:45,820
...لأنّ

226
00:22:46,180 --> 00:22:48,940
!ذلك ما وعدنا به سيّدنا

227
00:22:52,150 --> 00:22:55,530
!ستكون حربًا شاملة

228
00:23:04,000 --> 00:23:05,870
!انقلبت الموازين

229
00:23:05,870 --> 00:23:10,630
يعاني قراصنة مملكة الحيوان
!ضدّ قوّات السّاموراي المتصاعدة

230
00:23:10,630 --> 00:23:13,990
!يستخفّ كايدو بلوفي الّذي بدأ القتال

231
00:23:13,990 --> 00:23:15,970
!إنّها ليلة القمر البدر

232
00:23:15,970 --> 00:23:21,770
ويظهر المينك أشكالهم الحقيقيّة وهم
!يقاتلون بينما يفكّرون في موطنهم المدمّر

233
00:23:22,470 --> 00:23:23,770
:في الحلقة القادمة من وان بيس

234
00:23:23,770 --> 00:23:26,960
المعركة تحت القمر! المحاربون"
"!الهائجون، سولونغ أسد القمر

235
00:23:26,960 --> 00:23:30,400
!ملك القراصنة، لن يكون إلاّ أنا