1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:51,920 --> 00:01:54,520
اسمع يا سيّدي! نبحث عن
!معلومات عن جزيرة السّماء

22
00:01:54,520 --> 00:01:56,420
...هل تعرف شيئًا؟ إن كنتَ تعرف

23
00:02:00,290 --> 00:02:01,430
!"قالت "جزيرة السّماء

24
00:02:01,430 --> 00:02:04,360
!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل

25
00:02:02,490 --> 00:02:04,000
!هذا لا يصدّق

26
00:02:07,570 --> 00:02:08,330
!لوفي

27
00:02:13,240 --> 00:02:14,740
!زورو! تمهّل لحظة

28
00:02:14,740 --> 00:02:17,740
!اخرسي! إنّه يسعى للقتال وأنا أقدّمه له

29
00:02:21,180 --> 00:02:21,910
!لوفي

30
00:02:23,410 --> 00:02:24,920
!غادروا هذه البلدة

31
00:02:26,580 --> 00:02:30,020
،لوفي! زورو! انسيا أمر الوعد
!أوسعاهم ضربًا بسرعة

32
00:02:31,390 --> 00:02:34,130
.لا تقاتلهم مهما حدث

33
00:02:41,600 --> 00:02:46,470
قراصنة في القمّة! رجل يتحدّث عن"
"!الأحلام وملك اكتشاف الأعماق

34
00:02:58,950 --> 00:03:01,220
!انظروا إليهم! ما زالوا واقفين

35
00:03:02,220 --> 00:03:05,890
!نالوا من أولئك الجبناء

36
00:03:05,890 --> 00:03:09,360
!هذه البلدة ليست للحالمين الجبناء

37
00:03:12,660 --> 00:03:13,760
ما هذه الضّجّة؟

38
00:03:13,760 --> 00:03:16,030
سمعتُ أنّ قراصنة بيلامي
.يقيمون إعدامًا علنيًّا

39
00:03:16,370 --> 00:03:20,170
!لوفي! زورو! ألن تقوما بالرّدّ عليهم؟

40
00:03:20,170 --> 00:03:23,670
!قاتلاهم! لماذا لا توسعاهم ضربًا فحسب؟

41
00:03:24,780 --> 00:03:27,580
.لا فائدة يا آنسة. إنّهما ذكيّان

42
00:03:27,580 --> 00:03:31,250
.أدركا أنّ خصومهما ليسوا أندادًا لهما

43
00:03:31,720 --> 00:03:36,520
...لكن عدم قتال خصم قويّ
.حركة مشينة

44
00:03:38,060 --> 00:03:40,830
.أعتقد أنّ لا كرامة له كقائد

45
00:03:40,830 --> 00:03:42,960
،إنّ البحريّة كرماء هذه الأيّام

46
00:03:42,960 --> 00:03:47,570
وضعوا مكافأة 30 مليون بيري
!على رأس مغفّل بلا قيمة مثله

47
00:03:48,600 --> 00:03:52,170
.زورو، لا تقاتلهم مهما حدث

48
00:03:53,970 --> 00:03:56,810
لماذا... أنتما...؟

49
00:03:57,170 --> 00:04:02,050
...مبدأ عدم المقاومة

50
00:04:07,590 --> 00:04:10,190
.إضافة لكونكما ضعيفين، لا كبرياء لكما

51
00:04:10,190 --> 00:04:12,590
.لا يمكنكما خوض ولو قتال واحد

52
00:04:12,590 --> 00:04:14,990
.لكنّ رأسيكما مليئان بالأحلام

53
00:04:16,360 --> 00:04:17,860
.أنتما كالحشرات

54
00:04:17,860 --> 00:04:19,960
!بكلّ تأكيد

55
00:04:25,840 --> 00:04:27,740
.اكتفيت، اكتفيت

56
00:04:28,740 --> 00:04:32,140
...شقيّ قصير ضعيف يساوي 30 مليون

57
00:04:32,140 --> 00:04:34,550
.أتساءل أيّ نوع من الرّجال يكون

58
00:04:35,180 --> 00:04:38,280
!هذا ليس مخيّبًا فحسب، بل مملاًّ

59
00:04:38,280 --> 00:04:41,120
.لم ألتقِ أبدًا بجبناء مثلهما

60
00:04:53,060 --> 00:04:55,770
.نعم، أبعداهما عن وجهي

61
00:04:56,700 --> 00:04:57,770
.منظرهما يضرّ العين

62
00:05:03,410 --> 00:05:05,340
!انظروا لهما

63
00:05:13,750 --> 00:05:15,990
!لوفي! زورو

64
00:05:16,650 --> 00:05:18,220
.يا امرأة

65
00:05:20,320 --> 00:05:24,100
لن تتمكّني من التّقدّم للأمام
.في العصر الجديد إن بقيت معه

66
00:05:24,100 --> 00:05:26,100
ما رأيك أن أشتريك؟

67
00:05:26,560 --> 00:05:28,070
كم سيكلّفني مجيئك معي؟

68
00:05:33,340 --> 00:05:36,840
ماذا قالت؟ ستقوم بشرائي؟

69
00:05:37,240 --> 00:05:40,950
.هذا صحيح. انضمّي لنا
.سيكون ذلك ممتعًا

70
00:05:45,080 --> 00:05:46,450
،أكره قول هذا

71
00:05:47,020 --> 00:05:51,090
لكنّني أفضل بكثير من أن أنضمّ
!لفريق ضعفاء مثلكم

72
00:05:55,630 --> 00:05:56,860
!إنّها غالية الثّمن

73
00:06:00,460 --> 00:06:03,500
!طاقمهم مجرّد مجموعة حمقى

74
00:06:03,500 --> 00:06:06,240
!لا أمل يُرجى منهم

75
00:06:13,580 --> 00:06:16,710
خذي ذلكما الاثنين وغادروا بسرعة

76
00:06:16,710 --> 00:06:19,850
!بينما ما زلتم قيد الحياة أيّها الضّعفاء

77
00:06:23,320 --> 00:06:26,390
!أجل، لا تعودوا أبدًا

78
00:06:32,030 --> 00:06:34,330
.جزيرة السّماء موجودة فعلاً

79
00:06:45,780 --> 00:06:49,010
!فطائر الكرز هذه هي الأفضل بالفعل

80
00:06:49,510 --> 00:06:50,780
...أنت ذلك الرّجل

81
00:06:51,320 --> 00:06:53,820
لماذا أنت غاضبة أيّتها الشّابّة؟

82
00:06:53,820 --> 00:06:57,490
.هما من فازا بهذا القتال

83
00:06:57,490 --> 00:06:58,190
ماذا؟

84
00:07:02,330 --> 00:07:04,930
فعلاً؟ تريد التّغلّب علينا؟

85
00:07:06,630 --> 00:07:09,670
،عندما نلتقي في المرّة القادمة
!سنكون كلانا في قمّة القراصنة

86
00:07:13,170 --> 00:07:16,410
.كان ردّك اللاّذع مبهرًا بكلّ تأكيد

87
00:07:16,410 --> 00:07:18,910
.أنت امرأة شجاعة بالفعل

88
00:07:20,240 --> 00:07:21,180
!زورو

89
00:07:22,210 --> 00:07:23,310
!لوفي

90
00:07:28,890 --> 00:07:33,060
!العصر الجديد الّذي تحدّثوا عنه مجرّد هراء

91
00:07:34,330 --> 00:07:39,530
العصر الّذي يحلم فيه القراصنة
!قد ولّى، أهذا ما قالوه؟

92
00:07:39,530 --> 00:07:40,500
ما الّذي يحدث؟

93
00:07:46,440 --> 00:07:51,610
!أحلام النّاس... لا تنتهي

94
00:07:56,250 --> 00:07:57,620
!أليس كذلك؟

95
00:08:00,920 --> 00:08:02,250
...مهلاً، مهلاً

96
00:08:03,150 --> 00:08:06,090
ما الّذي تصرخ به فجأة هكذا؟

97
00:08:06,090 --> 00:08:08,090
ما هراء أحلام النّاس هذا؟

98
00:08:08,090 --> 00:08:11,030
!التّفوّق على الآخرين ليس سهلاً

99
00:08:14,200 --> 00:08:15,570
!هل فقدت عقلك؟

100
00:08:18,040 --> 00:08:20,810
.ما الّذي يحدث؟ أسمع ضجّة في الخارج

101
00:08:21,410 --> 00:08:25,440
لا تهتمّ. ربّما يحدثون فوضى
.في الخارج لأنّهم غاضبون

102
00:08:25,910 --> 00:08:27,210
!كم هذا محزن

103
00:08:29,580 --> 00:08:32,020
.بإمكانهم السّخرية منّا كما يشاؤون

104
00:08:32,020 --> 00:08:36,350
فعندما تكون القمّة هدفك، تقابل في
.طريقك قتالات لا تستحقّ الخوض فيها

105
00:08:36,590 --> 00:08:37,890
!أولستُ محقًّا؟

106
00:08:42,330 --> 00:08:43,090
.لنذهب

107
00:08:44,460 --> 00:08:46,700
حسنًا... لوفي؟

108
00:08:54,910 --> 00:08:55,740
!لوفي

109
00:08:56,970 --> 00:08:59,780
.يبدو أنّني قاطعتكم

110
00:09:00,310 --> 00:09:01,710
هل أنتم في عجلة من أمركم؟

111
00:09:03,180 --> 00:09:06,380
!أتمنّى أن تستطيعوا الذّهاب لجزيرة السّماء

112
00:09:25,070 --> 00:09:29,370
لحظة، ربّما يعرف شيئًا ما
.عن جزيرة السّماء

113
00:09:29,370 --> 00:09:30,610
.أتساءل من ذلك الشّخص

114
00:09:30,610 --> 00:09:33,940
."لا أدري... كما أنّه ليس "شخصًا

115
00:09:33,940 --> 00:09:37,780
ماذا؟ ليس "شخصًا"؟ ماذا إذًا؟

116
00:09:37,780 --> 00:09:40,120
...بل "أشخاص"، على الأرجح

117
00:09:41,790 --> 00:09:43,250
ماذا تقصدان؟

118
00:09:43,520 --> 00:09:48,730
هل تقصدان أنّه كان هنالك
!آخرون معه؟ أين؟! انتظرا

119
00:09:54,100 --> 00:09:57,570
!مذاق السّاكي جيّد جدًّا اليوم

120
00:10:07,180 --> 00:10:07,680
!لوح

121
00:10:07,680 --> 00:10:08,310
!تفضّل

122
00:10:11,720 --> 00:10:12,350
!مسمار

123
00:10:12,350 --> 00:10:13,120
!تفضّل

124
00:10:16,520 --> 00:10:17,050
!لوح

125
00:10:17,050 --> 00:10:17,790
!تفضّل

126
00:10:18,520 --> 00:10:19,160
!هذا مؤلم

127
00:10:19,860 --> 00:10:20,560
!تفضّل

128
00:10:23,160 --> 00:10:23,960
...تفضّل

129
00:10:24,300 --> 00:10:29,600
يا إلهي... أعلم أنّني أصلحها بنفسي
.لكنّني لستُ نجّار سفن

130
00:10:30,030 --> 00:10:32,170
.لكنّك بارع في هذا يا أوسوبّ

131
00:10:32,170 --> 00:10:35,710
.فعلاً؟! هذا هو المدهش بشأني

132
00:10:35,710 --> 00:10:37,910
.علينا شراء سفينة جديدة فحسب

133
00:10:37,910 --> 00:10:42,850
هل جننت؟! أتدري كيف حصلنا
!على هذه السّفينة؟

134
00:10:41,910 --> 00:10:44,520
.أعلم، أعلم، سمعتُ ذلك كثيرًا

135
00:10:44,520 --> 00:10:47,350
أعطتها لكم فتاة جميلة
من قريتك، صحيح؟

136
00:10:48,350 --> 00:10:51,760
ومع ذلك، من الخطير مواصلة
.الإبحار على سفينة بهذه الحالة

137
00:10:51,760 --> 00:10:55,830
!لذلك أواصل إصلاحها
!تعال وساعدنا

138
00:10:55,830 --> 00:10:59,660
إصلاح؟ أتسمّي هذا إصلاحًا؟
.أنت ترقّعها فحسب

139
00:11:00,160 --> 00:11:01,470
!اخرس

140
00:11:01,470 --> 00:11:03,870
!مهلاً، هذا وجه مضحك يا أوسوبّ

141
00:11:03,870 --> 00:11:04,700
!أتقصد هذا؟

142
00:11:05,240 --> 00:11:08,440
!اخرس

143
00:11:08,810 --> 00:11:11,740
...صحيح... بشأن العشاء

144
00:11:11,740 --> 00:11:13,910
!اخرس

145
00:11:13,910 --> 00:11:14,850
لستما جائعين إذًا؟

146
00:11:15,410 --> 00:11:19,550
!لا! بل جائعان! جائعان يا سانجي-كُن

147
00:11:16,210 --> 00:11:20,480
.حسنًا، أتساءل هل نضج حساء النّوارس

148
00:11:19,550 --> 00:11:20,480
!دعنا نأكل أرجوك

149
00:11:20,480 --> 00:11:21,990
!سانجي-كُن

150
00:11:21,250 --> 00:11:23,350
!أتساءل إن كان سيعجبهم

151
00:11:24,490 --> 00:11:35,470
...إنقاذ، إنقاذ

152
00:11:31,530 --> 00:11:33,760
ما... ما قصّة تلك السّفينة؟

153
00:11:35,470 --> 00:11:38,000
...إنقاذ

154
00:11:36,300 --> 00:11:38,000
!...هذه الأغنية

155
00:12:08,220 --> 00:12:10,490
!لو-لو-لو-لوفي! زورو

156
00:12:10,490 --> 00:12:13,420
!لماذا أنتما مصابان؟! ماذا حدث؟

157
00:12:13,420 --> 00:12:15,790
!نامي-سان! هل أنت بخير؟

158
00:12:16,990 --> 00:12:19,060
!نا-نادوا الطّبيب

159
00:12:19,060 --> 00:12:20,370
!أنت هو، فاذهب لتفقّدهما

160
00:12:20,370 --> 00:12:21,370
...هذا مؤلم

161
00:12:24,200 --> 00:12:28,810
حسنًا، أيّ نوع من وحوش موغيرا قاتلتما؟

162
00:12:29,970 --> 00:12:33,440
،كانوا قراصنة. لكن لا بأس
.انتهى الأمر الآن

163
00:12:33,440 --> 00:12:34,010
.نعم

164
00:12:34,480 --> 00:12:38,350
،حتّى إن كان انتهى في نظركما
!فلم ينتهِ في نظري أنا

165
00:12:38,350 --> 00:12:39,980
!ما بالكما؟! أنتما رجلان، صحيح؟

166
00:12:39,980 --> 00:12:43,320
،عندما يستفزّكما شخص ما
!عليكما الذّهاب وإيساعه ضربًا

167
00:12:43,320 --> 00:12:48,130
في الحقيقة، أو بالأحرى، لماذا لا تفجّران
!هذه البلدة المزعجة بالكامل؟

168
00:12:48,760 --> 00:12:50,960
!إذًا ما كان ما قلتِه قبل قليل؟

169
00:12:51,460 --> 00:12:54,470
ما فات قد مات! لا تتحدّث
!عمّا أمسى تاريخًا الآن

170
00:12:54,470 --> 00:12:55,730
!أتريدني أن أضربك أنا؟

171
00:12:56,100 --> 00:12:59,640
مهلاً، لماذا هي في مزاج سيّئ
رغم أنّها لم تتأذَّ؟

172
00:12:59,970 --> 00:13:01,610
.لا أدري

173
00:13:02,240 --> 00:13:04,880
صحيح! هل حصلتم على أيّ
معلومات عن جزيرة السّماء؟

174
00:13:05,280 --> 00:13:07,450
جزيرة... السّماء...؟

175
00:13:09,150 --> 00:13:12,980
،"من يهتمّ؟! كلّ ما فعلتُه هو ذكر "جزيرة السّماء

176
00:13:12,980 --> 00:13:14,820
.وبدأ كلّ من في الحانة بالضّحك

177
00:13:14,820 --> 00:13:17,420
!هل قلتُ شيئًا مضحكًا؟

178
00:13:18,160 --> 00:13:19,460
!ما بالهم؟

179
00:13:19,460 --> 00:13:21,160
!الهجوم الخاصّ: نجم الكتشب

180
00:13:21,160 --> 00:13:22,890
!نقطة تعزيز الحماية

181
00:13:23,160 --> 00:13:26,500
.المكان صاخب هنا
لماذا كلّ هذا الانزعاج؟

182
00:13:27,370 --> 00:13:29,370
!مرحبًا يا روبين-تشان

183
00:13:29,370 --> 00:13:32,340
هل أجهّز لك حمّامك
أم تريدين الأكل أوّلاً؟

184
00:13:32,340 --> 00:13:34,540
هل ذهبتِ لمكان ما يا روبين؟

185
00:13:35,170 --> 00:13:39,510
نعم. اشتريتُ بعض الملابس وحصلت
.على معلومات عن جزيرة السّماء

186
00:13:39,880 --> 00:13:41,880
!هذا صحيح! أنت يا روبين

187
00:13:41,880 --> 00:13:43,210
!نقطة تعزيز القفز

188
00:13:41,880 --> 00:13:45,120
حدث كلّ هذا لأنّك بدأت الحديث
!عن جزيرة السّماء تلك

189
00:13:45,120 --> 00:13:46,480
،إن كانت غير موجودة

190
00:13:46,480 --> 00:13:47,520
!مهلاً يا تشوبّر

191
00:13:46,480 --> 00:13:48,690
!فسأرسلك إلى قبر من الماء

192
00:13:49,050 --> 00:13:51,590
!دعيها وشأنها الآن

193
00:13:51,590 --> 00:13:55,490
أو بالأحرى، لا تقتربي منها لكي
.لا تسبّبي فوضى أكثر على السّفينة

194
00:13:57,400 --> 00:13:58,900
.تفضّل أيّها القائد

195
00:13:58,900 --> 00:14:00,730
!إنّها خريطة كنز

196
00:14:00,730 --> 00:14:03,970
ماذا؟ أليست مجرّد خريطة عاديّة؟
لأيّ مكان هي؟

197
00:14:03,970 --> 00:14:04,900
.إنّها لهذه الجزيرة

198
00:14:05,640 --> 00:14:08,910
البلدة الّتي على اليسار هي
.موكتاون حيث نحن الآن

199
00:14:09,210 --> 00:14:12,540
وهل ترون علامة × على الجانب الآخر؟

200
00:14:12,910 --> 00:14:16,180
سمعتُ أنّ رجلاً لا ينتمي
.إلى جايا يعيش هناك

201
00:14:16,180 --> 00:14:17,580
!لا ينتمي لها؟

202
00:14:17,820 --> 00:14:20,320
.اسمه مونبلان كريكت

203
00:14:21,690 --> 00:14:24,920
رجل يتحدّث عن الأحلام
.ونُفي من هذه البلدة

204
00:14:24,920 --> 00:14:26,560
قد تكون لديكما مواضيع
.مشتركة للحديث عنها

205
00:14:29,230 --> 00:14:30,700
حسنًا، لماذا لا نجرّب الذّهاب إلى هناك؟

206
00:14:30,700 --> 00:14:35,830
لكن مهلاً يا لوفي. لستُ واثقًا
...أنّ علينا الذّهاب الآن لأنّ

207
00:14:35,830 --> 00:14:37,600
صحيح يا تشوبّر، رأيتها أيضًا، أليس كذلك؟

208
00:14:41,310 --> 00:14:43,370
ما الّذي تفعلانه؟

209
00:14:43,370 --> 00:14:45,080
!طننتُ أنّني سأموت

210
00:14:45,310 --> 00:14:47,710
.يا إلهي، أنت مزعج فعلاً

211
00:14:47,710 --> 00:14:49,080
...لكنّ نامي كانت

212
00:14:49,080 --> 00:14:51,420
!ماذا؟! كنتُ ماذا؟

213
00:14:51,420 --> 00:14:53,280
!أتحاول القول أنّني مجرّد غبيّة؟

214
00:14:57,620 --> 00:15:02,030
!أيّها الزّعيم الكبير
!اكتملت التّجهيزات تحت البحر

215
00:15:02,030 --> 00:15:03,360
!الميكروفون جاهز أيضًا

216
00:15:03,360 --> 00:15:06,560
!حسنًا! لنبدأ البحث بالسّونار

217
00:15:40,800 --> 00:15:44,270
!معكم غطّاس الأوتان رقم 27
!تمّ تأكيد استجابة للسّونار

218
00:15:44,270 --> 00:15:46,100
تمّ كشف سرب من الأسماك
!على يسارنا مباشرة

219
00:15:46,100 --> 00:15:48,940
،وفق سرعة سباحتها
.حدّدنا أنّها أسماك الصّوري

220
00:15:49,340 --> 00:15:51,540
!حسنًا! سنشويها جميعها على العشاء

221
00:15:52,940 --> 00:15:55,380
!معكم الغطّاس رقم 4
!تمّ تأكيد استجابة للسّونار

222
00:15:55,650 --> 00:15:58,580
!تمّ اكتشاف سفينة صغيرة على البحر

223
00:15:59,680 --> 00:16:03,550
!ماذا؟! سفينة؟ حدّدوا اتّجاهها بالضّبط

224
00:16:03,960 --> 00:16:07,730
!إنّها... تبحر أمامنا مباشرة

225
00:16:08,060 --> 00:16:10,290
!إنّها قريبة كفاية لنراها بالفعل

226
00:16:11,060 --> 00:16:14,970
أوقفوا البحث وعودوا للسّفينة
!يا غطّاسي الأوتان

227
00:16:23,410 --> 00:16:26,310
لم نتأخّر كثيرًا حتّى التقينا
...بشيء غريب آخر

228
00:16:26,310 --> 00:16:30,180
.لكنّهم لا يبدون كالأشخاص السّابقين يا أوسوبّ

229
00:16:30,180 --> 00:16:33,750
حسنًا، سواء كان ذلك شيئًا جيّدًا
.أم سيّئًا، فتلك قصّة أخرى

230
00:16:34,350 --> 00:16:37,160
!على أيّ حال، رأيناهم بالفعل، صحيح؟

231
00:16:37,160 --> 00:16:41,690
نعم. منقذ السّفن ذاك
!من هذه الجزيرة كما توقّعنا

232
00:16:41,690 --> 00:16:43,700
!رأينا سفينته تعود

233
00:16:44,730 --> 00:16:47,330
.لكنّني لا أمانع رؤيته ثانية

234
00:16:47,700 --> 00:16:53,340
!مهلاً، يا رجال! كفاكم ثرثرة

235
00:16:56,110 --> 00:16:59,740
!يا إلهي، تحمّست كثيرًا متسائلاً من تكونون

236
00:17:02,150 --> 00:17:05,120
!لديك وجه متهوّر يا هذا
!من أيّ نوع أنت؟

237
00:17:05,120 --> 00:17:06,720
!أنا بشريّ أيّها الغبيّ

238
00:17:06,720 --> 00:17:10,490
!أيّها الأوغاد! ألا تعرفون شوجو-ساما؟

239
00:17:10,490 --> 00:17:13,560
إنّه الزّعيم الكبير لقراصنة شوجو
!وملك اكتشاف الأعماق

240
00:17:13,560 --> 00:17:15,790
!لا تغضبوا زعيمنا الكبير

241
00:17:16,590 --> 00:17:18,760
...لا بأس، لا بأس

242
00:17:19,560 --> 00:17:22,300
.يبدو أنّكم قراصنة

243
00:17:22,670 --> 00:17:27,840
هل تعرفون أنّ الشّيتشيبوكاي
كروكودايل هُزم؟

244
00:17:27,840 --> 00:17:34,510
،عند التّفكير في قدراتي
.فقد يكون ذلك المنصب لي

245
00:17:34,510 --> 00:17:37,550
.لذلك بدأت أتحمّس كثيرًا منتظرًا الدّعوة

246
00:17:38,280 --> 00:17:41,390
هكذا إذًا... تريد أن تصبح أحد الشّيتشيبوكاي؟

247
00:17:41,390 --> 00:17:45,960
حسنًا، على أيّ حال، أعظم جانب منّي

248
00:17:45,960 --> 00:17:50,700
هو أنّني لم أقصّ شعري طوال حياتي
.ذات الخمسة والعشرين سنة

249
00:17:50,700 --> 00:17:54,000
حسنًا، ألستم متفاجئين؟

250
00:17:55,230 --> 00:17:56,130
.يبدو هذا غبيًّا

251
00:17:56,530 --> 00:17:58,100
!فاجأتني

252
00:17:58,440 --> 00:18:00,100
!انتبه لكلامك أيّها الوغد

253
00:18:00,100 --> 00:18:05,580
لا بأس، لا بأس... ما تقوله
.يزيدني حماسًا بالفعل

254
00:18:06,110 --> 00:18:13,420
اسمع. ستخرجون من نفق
.غضبي إلى بحر من الدّم

255
00:18:14,090 --> 00:18:17,060
.لا يهمّ... لكن ثمّة مكان نريد الذّهاب إليه

256
00:18:17,060 --> 00:18:17,960
.لذلك ابتعد عن الطّريق

257
00:18:18,390 --> 00:18:22,030
!غبيّ! هذه المنطقة منطقتي أنا

258
00:18:22,030 --> 00:18:25,130
!إن أردتَ المرور، فعليك الدّفع

259
00:18:25,760 --> 00:18:29,570
ما الّذي يقصده بمنطقته؟
.إنّه يتحدّث مثل ماسيرا

260
00:18:29,570 --> 00:18:31,900
ماذا؟ هل قال ماسيرا أشياءً كهذه؟

261
00:18:31,900 --> 00:18:35,410
ماذا؟ ماسيرا؟ ماذا بشأن ماسيرا؟

262
00:18:35,410 --> 00:18:40,040
...لقد ركلناه خارج سفينتنا، لكن

263
00:18:39,240 --> 00:18:41,880
!ر-ركلتموه... ركلتموه...؟

264
00:18:42,350 --> 00:18:43,050
!أيّها الزّعيم الكبير

265
00:18:43,050 --> 00:18:45,680
ركلتموه؟ كيف تجرؤون
!على فعل ذلك بأخي؟

266
00:18:45,680 --> 00:18:48,520
!هذا انتقام لماسيرا

267
00:18:45,820 --> 00:18:48,520
.مهلاً، انتظر لحظة

268
00:18:48,520 --> 00:18:50,120
!لقد ركلناه بالفعل، لكنّه ما زال حيًّا

269
00:18:52,820 --> 00:18:55,160
!الموجة الصّوتيّة

270
00:18:55,490 --> 00:18:57,560
!سونار الدّمار

271
00:19:13,540 --> 00:19:14,580
...إنّ السّفينة

272
00:19:19,780 --> 00:19:22,650
حسنًا... ما الّذي يفعلونه؟

273
00:19:21,420 --> 00:19:22,650
!أيّها الزّعيم الكبير

274
00:19:22,650 --> 00:19:24,460
...إن استعملتَ ذلك على السّفينة، فسوف

275
00:19:22,650 --> 00:19:25,120
.من يدري؟ لكنّ ذلك رائع

276
00:19:24,460 --> 00:19:27,130
!كلاّ! لقد أعماه الغضب

277
00:19:25,120 --> 00:19:27,730
.إنّه يدمّر سفينتهم بصوته

278
00:19:28,130 --> 00:19:32,430
يا رفاق! كفاكم تفرّجًا
!ولنغادر بينما نستطيع ذلك

279
00:19:32,630 --> 00:19:34,070
!حسنًا

280
00:19:34,070 --> 00:19:36,100
.مهلاً، لم تعد نامي شيطانة

281
00:19:36,100 --> 00:19:37,300
!فعلاً؟

282
00:19:37,300 --> 00:19:40,340
نعم، يجب أن تكون هدأت
.بعد تفريغ كلّ غضبها

283
00:19:43,640 --> 00:19:45,140
!مـ-مهلاً لحظة

284
00:19:46,610 --> 00:19:49,580
!هذا سيّئ! وصلت الموجات إلى سفينتها

285
00:19:49,810 --> 00:19:52,820
،بدأت السّفينة تتداعى
!وخاصّة المناطق المرمّمة

286
00:19:52,820 --> 00:19:55,650
!هيكل السّفينة متهالك بما يكفي كما هو

287
00:19:56,120 --> 00:19:59,620
!ستتداعى السّفينة أكثر إن بقينا هنا

288
00:19:59,920 --> 00:20:03,230
!انطلقوا بأقصى سرعة
!لنبتعد عن موجات صوته

289
00:20:38,060 --> 00:20:40,300
.لكنّني كنت متفاجئًا

290
00:20:40,300 --> 00:20:42,170
،ثمّ قالت تلك المرأة الجميلة

291
00:20:42,400 --> 00:20:47,110
"!أخبروني أين يعيش كريكت هذا"

292
00:20:48,210 --> 00:20:49,740
!يا لها من امرأة جريئة

293
00:20:49,740 --> 00:20:52,780
!جريئة؟ لقد كانت قويّة

294
00:20:52,780 --> 00:20:55,750
كانت لديها أيادٍ غامضة
،تنبثق من كلّ مكان

295
00:20:55,750 --> 00:20:59,450
.وأطاحت بكلّ من كان في الحانة
!لم يكن ذلك مضحكًا

296
00:21:03,050 --> 00:21:06,860
لكن ما الّذي تريده من العجوز كريكت؟

297
00:21:07,430 --> 00:21:11,000
.البحر حولنا هنا تابع للأخوين القردين

298
00:21:11,700 --> 00:21:14,630
،وأيضًا، إن كان للأمر علاقة بذلك العجوز

299
00:21:15,300 --> 00:21:17,240
.فستُصاب بغبائه

300
00:21:18,300 --> 00:21:19,400
.ستكون تلك مشكلة

301
00:21:20,300 --> 00:21:23,610
ما تسعى إليه تلك المرأة
.هو سبيكة الذّهب بلا شكّ

302
00:21:23,610 --> 00:21:24,640
!سبيكة ذهب؟

303
00:21:24,640 --> 00:21:26,710
نعم. سمعتُ أنّه عُثر
.حديثًا على سبيكة ذهب

304
00:21:26,710 --> 00:21:28,250
فعلاً؟ أين؟

305
00:21:28,250 --> 00:21:29,910
...يا رجال

306
00:21:31,380 --> 00:21:32,650
!بيلامي

307
00:21:33,320 --> 00:21:35,450
ما سبيكة الذّهب هذه الّتي تتحدّثون عنها؟

308
00:21:36,350 --> 00:21:42,030
...ذلك المدعوّ كريكت
.أريد فعلاً أن ألقاه أيضًا

309
00:21:47,030 --> 00:21:49,430
!أخبروني بكلّ شيء عنه

310
00:21:55,350 --> 00:22:03,420
آه، خلف السّماء الّتي لا نهاية لها

311
00:22:03,420 --> 00:22:14,030
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

312
00:22:21,910 --> 00:22:29,350
مرّت عليّ أيّام كدت أخسر فيها نفسي

313
00:22:29,350 --> 00:22:37,760
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

314
00:22:37,760 --> 00:22:45,970
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

315
00:22:45,970 --> 00:22:54,810
دفعوا بي للأمام، أليس كذلك؟

316
00:22:54,810 --> 00:23:03,120
آه، إنّ النّجوم تهوي من السّماء

317
00:23:03,120 --> 00:23:06,250
...وهذه اللّحظة الفريدة

318
00:23:11,730 --> 00:23:13,630
إذًا فهذا هو... ما كان اسمه؟

319
00:23:13,630 --> 00:23:14,660
.مونبلان كريكت

320
00:23:14,660 --> 00:23:16,230
هذا منزله، صحيح؟

321
00:23:16,230 --> 00:23:19,230
!"ثمّة كتاب صور! عنوانه "نولاند الكذّاب

322
00:23:19,230 --> 00:23:21,500
!يا له من عنوان جيّد

323
00:23:21,500 --> 00:23:24,170
.يعيد هذا الذّكريات لي
.قرأته كثيرًا عندما كنت طفلاً

324
00:23:24,170 --> 00:23:24,870
أتعرفه؟

325
00:23:24,870 --> 00:23:27,510
.نعم. سمعتُ أنّه كان رجلاً حقيقيًّا

326
00:23:27,810 --> 00:23:29,110
:في الحلقة القادمة من ون بيس

327
00:23:29,480 --> 00:23:32,080
".عائلة أسطوريّة! نولاند الكذّاب"

328
00:23:32,080 --> 00:23:34,110
!ملك القراصنة، لن يكون إلاّ أنا