1
00:00:00,000 --> 00:00:05,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:09,660 --> 00:00:12,500
في نهاية الأحلام، في نهاية البحر

3
00:00:12,500 --> 00:00:15,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:15,000 --> 00:00:18,010
ولكن أوّلاً، علينا صنع

5
00:00:18,010 --> 00:00:22,890
أسطورة لامعة من أنفسنا

6
00:00:23,290 --> 00:00:25,720
شرارات متطايرة من هنا بلا حدود

7
00:00:25,720 --> 00:00:27,350
!وان بيس

8
00:00:27,350 --> 00:00:29,980
سنخبر جميعنا الرّحّالة

9
00:00:29,980 --> 00:00:33,980
هل ما زالت أحلامكم واضحة؟

10
00:00:35,360 --> 00:00:42,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:42,030 --> 00:00:48,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:00:48,500 --> 00:00:51,120
سنخبر جميعنا الرّحّالة

13
00:00:51,120 --> 00:00:54,880
لا توجد قتالات بلا معنى

14
00:00:56,540 --> 00:01:03,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:03,010 --> 00:01:09,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:09,600 --> 00:01:15,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:15,730 --> 00:01:22,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:27,740 --> 00:01:30,120
!هذا خارق

19
00:01:30,830 --> 00:01:33,000
مرحبًا بكم، كيف الحال؟

20
00:01:33,330 --> 00:01:37,090
.أنا نجّار سفينة طاقم قبّعة القشّ فرانكي

21
00:01:37,380 --> 00:01:41,710
.وأنا عالمة الآثار نيكو روبين من نفس الطّاقم

22
00:01:42,130 --> 00:01:46,890
أخبريني يا روبين، ماذا يفترض بي فعله؟

23
00:01:47,300 --> 00:01:51,520
.تسلّل عملاء سايفر بول إلى إيغهيد

24
00:01:51,640 --> 00:01:53,520
.كنت أفكّر في تقرير عنهم

25
00:01:53,690 --> 00:01:56,600
أولئك الّذي واجهناهم منذ مدّة؟

26
00:01:56,940 --> 00:02:00,570
،إنّهم الآن جزء من سايفر بول إيجيس زيرو

27
00:02:00,690 --> 00:02:04,110
.أقوى وكالة استخبارات في العالم

28
00:02:04,530 --> 00:02:07,450
...إنّهم أشخاص يرتدون بِذلاً بيضاء وأقنعة

29
00:02:07,870 --> 00:02:12,660
.لا أرى ضررًا من إلقاء نظرة عليهم

30
00:02:13,050 --> 00:02:15,870
.لنبدأ بدون أيّ تأخير

31
00:02:16,000 --> 00:02:18,170
...نعم، هيّا بنا

32
00:02:18,330 --> 00:02:19,630
!نبدأ

33
00:02:21,750 --> 00:02:26,330
سجلّ التّنافس! طاقم قبّعة"
"!القشّ ضدّ سايفر بول

34
00:02:29,530 --> 00:02:32,350
.صحيحٌ أنّكم أصلحتم سفينتنا

35
00:02:32,470 --> 00:02:36,910
،لكن كيفما نظرت إلى الأمر
.أجد أنّ الرّسوم مرتفعة للغاية

36
00:02:37,230 --> 00:02:41,320
.لذا قرّرت... ألاّ أدفع ولا بيري واحد

37
00:02:46,070 --> 00:02:50,620
هؤلاء هم الحرفيّون في شركة غالي-لا
!الّتي تبني السّفن في ووتر سفن

38
00:02:52,170 --> 00:02:55,830
.وعملاء سايفر بول كانوا يعملون هناك متخفّين

39
00:02:56,080 --> 00:03:01,250
أساليب القراصنة لا تنفع
في ورشة الحرفيّين، أليس كذلك؟

40
00:03:03,090 --> 00:03:04,710
!تمهّل

41
00:03:05,840 --> 00:03:09,930
فقط الأشخاص المصرّح لهم
.يمكنهم دخول المصنع

42
00:03:10,780 --> 00:03:13,390
!الرّجل ذو الأنف المستطيل هو كاكو

43
00:03:13,510 --> 00:03:16,480
.كان في ذلك الوقت جزءًا من سي بي 9

44
00:03:20,560 --> 00:03:24,690
.وروب لوتشي أيضًا كان من سي بي 9

45
00:03:25,210 --> 00:03:28,200
.أنا روب لو... لا، أقصد، أنا هاتّوري الحمامة

46
00:03:28,330 --> 00:03:32,490
.وهذا روب لوتشي. وهو يعمل هنا
!سعيد بلقائكم

47
00:03:33,280 --> 00:03:34,580
!يا لوقاحتك

48
00:03:34,840 --> 00:03:36,570
كانت السّكرتيرة الجميلة كاليفا

49
00:03:36,740 --> 00:03:40,290
.وساقي الحانة بلونو يعملان لنفس عميلين أيضًا

50
00:03:40,950 --> 00:03:43,460
،نيابة عن حكومة العالم

51
00:03:43,600 --> 00:03:47,330
كان لوتشي ورفاقه يسعون خلف أيسبرغ

52
00:03:47,470 --> 00:03:51,300
رئيس شركة غالي-لا ظنًّا
.أنّ تصاميم بلوتون بحوزته

53
00:03:51,800 --> 00:03:53,640
!لا أملك شيئًا أعطيكم إيّاه

54
00:03:54,600 --> 00:03:56,270
.إلّم تملكه، فهذه مشكلة

55
00:03:58,850 --> 00:04:00,480
حيث أنّك تكاد أن تموت؟

56
00:04:01,440 --> 00:04:03,820
.خاب أملي فيك

57
00:04:04,980 --> 00:04:06,000
!لوتشي

58
00:04:06,480 --> 00:04:11,950
أنتم... تعملون لمصلحة الحكومة؟

59
00:04:12,080 --> 00:04:17,030
.صحيح. كان التّخفّي مهمّة سهلة بالنّسبة لنا

60
00:04:18,080 --> 00:04:22,960
.ولكن حنكتك أبهرتني

61
00:04:24,700 --> 00:04:26,860
...حسنًا يا أيسبرغ-سان

62
00:04:27,460 --> 00:04:32,090
أين مخطّطات السّلاح القديم بلوتون؟

63
00:04:32,470 --> 00:04:36,640
.أرجوك أخبرنا قبل أن يتأذّى الكثير من النّاس

64
00:04:38,350 --> 00:04:40,560
كان أيسبرغ في ورطة

65
00:04:40,690 --> 00:04:43,400
.عندما اقتحم لوفي وزورو الغرفة

66
00:04:43,650 --> 00:04:49,070
.باولي، نحن عملاء استخبارات حكوميّين في الحقيقة

67
00:04:49,740 --> 00:04:53,180
ولكنّك ستسامحنا إن اعتذرنا، أليس كذلك؟

68
00:04:53,990 --> 00:04:58,830
.فنحن رفاق قضينا كلّ يوم في بناء السّفن معًا

69
00:04:59,800 --> 00:05:05,240
،إن كنتَ لا تصدقني لكون هذا مفاجئًا جدًّا
فهل تريدني أن أدوس على وجه أيسبرغ؟

70
00:05:06,590 --> 00:05:07,340
!الانتقال الآني

71
00:05:08,880 --> 00:05:09,840
!اختفى

72
00:05:16,300 --> 00:05:17,310
!مسدّس الإصبع

73
00:05:27,480 --> 00:05:28,400
!لوفي

74
00:05:32,740 --> 00:05:33,700
...سحقًا

75
00:05:33,820 --> 00:05:36,820
،يُسمح لسي بي 9
،الّتي تمثّل العدالة في الظّلال

76
00:05:36,950 --> 00:05:39,510
.بالقتل دون الخوف من أيّ مساءلة

77
00:05:39,730 --> 00:05:43,910
يتقن عملاؤها مجموعة من
.التّقنيات تُسمّى القوى السّتّة

78
00:05:44,040 --> 00:05:45,500
.وهذا ليس كلّ شيء

79
00:05:45,630 --> 00:05:48,940
.تناول لوتشي فاكهة شيطان فوق كلّ ذلك

80
00:05:53,220 --> 00:05:54,920
...فاكهة القطّ

81
00:05:58,930 --> 00:06:00,830
...من صنف النّمر المرقّط

82
00:06:02,930 --> 00:06:06,840
...أنواع الفواكه هي لوغيا وزون وباراميسيا

83
00:06:07,230 --> 00:06:09,860
.توجد الكثير من القوى الفريدة

84
00:06:10,270 --> 00:06:16,410
.التّعزيز الجسديّ الحقيقيّ هو سمة أنواع زون

85
00:06:16,610 --> 00:06:19,870
.كلّما تدرّبنا، صرنا أقوى

86
00:06:22,620 --> 00:06:27,420
نوع زون هو أقوى الأصناف عندما
.يتعلّق الأمر بالهجوم القريب

87
00:06:34,260 --> 00:06:35,380
.مسدّس الإصبع

88
00:06:37,480 --> 00:06:38,390
!لوفي

89
00:06:45,440 --> 00:06:48,150
!احظَ بتحليق ممتع خارج هذه الجزيرة

90
00:06:53,210 --> 00:06:56,950
،تمّ أخذنا إلى الجزيرة القضائيّة إنيس لوبي

91
00:06:57,070 --> 00:07:00,490
.حيث واجه لوفي وبقية الطّاقم سي بي 9

92
00:07:04,540 --> 00:07:07,040
.مرّ وقت طويل يا رئيس

93
00:07:07,540 --> 00:07:09,500
...أجل

94
00:07:10,420 --> 00:07:13,210
كاتي فلام، المجرم المسؤول عن

95
00:07:13,370 --> 00:07:18,180
مهاجمة موظّفين حكوميّين في
...ووتر سيفن قبل ثمان سنوات

96
00:07:18,340 --> 00:07:22,010
نيكو روبين، المجرمة الّتي كانت
متورّطة في حادثة

97
00:07:22,010 --> 00:07:26,390
مهاجمة سفن البحريّة الحربيّة
...في أوهارا في الأزرق الغربيّ

98
00:07:26,390 --> 00:07:29,130
.أكملنا اصطحابهما إلى هنا بلا مشاكل

99
00:07:29,940 --> 00:07:32,860
.كلاهما خلف الباب الآن

100
00:07:33,020 --> 00:07:35,200
...على أيّ حال، دعوني أقابل

101
00:07:36,320 --> 00:07:38,320
!أمل العالم أجمع

102
00:07:38,680 --> 00:07:42,940
.لا أحبّ النّظر في وجه سباندام على الإطلاق

103
00:07:48,210 --> 00:07:52,750
منذ أن أقيمت حكومة العالم، فلم يحدث قطّ

104
00:07:53,130 --> 00:07:57,130
.أن قطع رجل كلّ هذا الشّوط إلى مدخل الحكومة

105
00:07:58,300 --> 00:08:01,720
إلى متى تنوي الهيجان؟

106
00:08:04,930 --> 00:08:06,410
.إلى أن أموت

107
00:08:09,350 --> 00:08:13,520
.لن تتمكّن من مجاراتي الآن

108
00:08:13,690 --> 00:08:14,650
ماذا؟

109
00:08:15,400 --> 00:08:19,400
.ستتطّور كلّ تقنياتي خطوة إلى الأمام

110
00:08:21,570 --> 00:08:23,890
!المستوى... الثّاني

111
00:08:25,540 --> 00:08:27,940
...فاكهة المطّاط

112
00:08:29,410 --> 00:08:32,140
!البازوكا النفّاثة

113
00:08:52,690 --> 00:08:55,450
ماذا؟ هل عدوّنا هو قبّعة القشّ وحده؟

114
00:08:56,230 --> 00:08:57,360
!يويوي

115
00:08:57,480 --> 00:09:03,320
حتّى إن كان وحده، إلاّ أنّ وصوله
.إلى هنا مثير للإعجاب

116
00:09:06,450 --> 00:09:11,370
،حتّى مع سقوط بلونو
.تظلّ سي بي 9 مجموعة قويّة

117
00:09:11,960 --> 00:09:16,040
أعتقد أنّ كونه مالك حانة
.لخمس سنوات جعله ضعيفًا

118
00:09:16,170 --> 00:09:18,880
،حتّى إن كان قد أصبح ضعيفًا
أكان يمكن هزيمته؟

119
00:09:19,010 --> 00:09:22,170
.لقد هُزم... تشابابا

120
00:09:22,760 --> 00:09:27,430
خاض الطّاقم معركة ضدّهم
.من أجل مفتاح أصفادي

121
00:09:31,100 --> 00:09:33,230
!العجلة الخارقة، الكرة الحديديّة

122
00:09:33,550 --> 00:09:36,690
!سأسحقك في زاوية البرج باستخدام هذا الزّخم

123
00:09:38,430 --> 00:09:39,600
...مدفع

124
00:09:40,280 --> 00:09:41,310
!الرّياح

125
00:09:48,870 --> 00:09:52,790
!خارق

126
00:09:53,040 --> 00:09:54,660
.استطعتُ هزيمة فوكورو

127
00:09:54,920 --> 00:09:59,170
أمّا تشوبّر، فقد تجاوز حدوده
.وهزم كومادوري أثناء هيجانه

128
00:09:59,400 --> 00:10:02,440
!إن كنتُ سأموت على أيّ حال، فسأقوم بذلك

129
00:10:03,340 --> 00:10:07,110
.أتمنّى فقط ألاّ يدخل أحد لهذه الغرفة

130
00:10:11,430 --> 00:10:14,130
!ساق العاصفة

131
00:10:17,880 --> 00:10:19,070
!خذ هذه

132
00:10:19,440 --> 00:10:22,280
!أغنيّة الصّفصاف... القرمزيّة

133
00:10:35,540 --> 00:10:39,590
أيّ نوع من التّنبّؤات هذا؟
...يا لغرورك

134
00:10:39,790 --> 00:10:42,300
.ليست تنبّؤات. بل توقّعات جوّيّة

135
00:10:42,600 --> 00:10:44,660
.تحكّمت بكلّ من الرّطوبة والحرارة هنا

136
00:10:44,840 --> 00:10:47,210
!الطّقس في هذه الغرفة تحت سيطرتي

137
00:10:51,430 --> 00:10:53,180
!جوّ رمح البرق

138
00:10:57,850 --> 00:10:59,610
...لا يهمّ كم أنت قويّة

139
00:11:00,010 --> 00:11:02,320
.توقّعاتي الجوّيّة لا تخطئ أبدًا

140
00:11:02,560 --> 00:11:05,880
أصبحت كاليفا امرأة الصّابون
،بعد تناولها لفاكهة الفقاعات

141
00:11:06,030 --> 00:11:07,520
.لكنّ نامي استطاعت هزيمتها

142
00:11:08,010 --> 00:11:11,160
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

143
00:11:11,290 --> 00:11:14,660
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

144
00:11:15,410 --> 00:11:17,120
.انتبه لكلامك

145
00:11:19,500 --> 00:11:23,050
.أنا من النّوع الّذي يشتعل غضبًا

146
00:11:23,880 --> 00:11:25,510
!ساق الشّيطان

147
00:11:25,670 --> 00:11:27,470
!ماذا؟ مـ-مهلاً

148
00:11:27,820 --> 00:11:29,430
...ركلة

149
00:11:35,540 --> 00:11:37,310
!اللّهب

150
00:11:47,400 --> 00:11:50,820
وفي مواجهة جابرا وقوّة فاكهة الكلب
،من صنف الذّئب

151
00:11:50,970 --> 00:11:52,580
.خرج سانجي منتصرًا

152
00:11:52,740 --> 00:11:55,540
.لم يتبقّ سوى لوتشي وكاكو

153
00:12:11,550 --> 00:12:14,390
.تناول كاكو فاكهة الثّور، صنف الزّرافة

154
00:12:15,260 --> 00:12:18,960
وبفضلها، استطاع دفع
.زورو إلى حدوده القصوى

155
00:12:19,220 --> 00:12:24,320
،أقول أنّه لو كان الخيار لي
!فأنا أفضّل اللّحم أكثر

156
00:12:26,150 --> 00:12:28,860
!وأنا أقول أنّ ذلك ليس مهمًّا أيّها العاشب

157
00:12:31,950 --> 00:12:33,340
...أسلوب السّيفين

158
00:12:33,780 --> 00:12:34,880
...القاطعان

159
00:12:43,470 --> 00:12:44,880
!تسلّق البرج

160
00:12:47,670 --> 00:12:49,590
!ردّ تسلّق البرج

161
00:12:52,340 --> 00:12:53,890
!منجل الزّرافة

162
00:13:03,560 --> 00:13:05,860
.الجسد الحديديّ: لا نقاط عمياء

163
00:13:07,650 --> 00:13:08,520
!ماذا؟

164
00:13:18,750 --> 00:13:22,160
.أصبحتُ مكعّبًا بلا نقاط عمياء

165
00:13:23,820 --> 00:13:25,130
!زخّات الزّرافة

166
00:13:30,050 --> 00:13:31,220
!الجسد الحديديّ

167
00:13:36,180 --> 00:13:36,850
!مسدّس الأنف

168
00:13:38,180 --> 00:13:40,020
!تقطيع الغوريلّتان القويّ

169
00:13:49,400 --> 00:13:53,570
إنّك من النّوع الّذي يعجز حتّى عن
تخيّل نفسه أنّه قد يُهزم، صحيح؟

170
00:13:58,700 --> 00:14:00,200
!يا لتكبّرك

171
00:14:00,530 --> 00:14:02,370
!وكذلك أنت

172
00:14:07,110 --> 00:14:09,710
...هالة الشّيطان... أسلوب السّيوف التّسعة

173
00:14:13,550 --> 00:14:14,640
!أسورا

174
00:14:19,050 --> 00:14:20,480
!تقطيع السّماء

175
00:14:26,810 --> 00:14:29,640
!هجومي القاطع... تحوّل إلى ضباب؟

176
00:14:30,030 --> 00:14:32,070
!لا أمانع وجود العقبات

177
00:14:32,440 --> 00:14:35,400
!اخترت السّير على درب أسورا

178
00:14:46,500 --> 00:14:49,130
!أسورا: الضّباب الفضّيّ

179
00:15:04,640 --> 00:15:06,060
!زورو رجل ولا كلّ الرّجال

180
00:15:06,730 --> 00:15:10,650
في مكان آخر، كان لوفي يواجه
.لوتشي في قتال رجل لرجل

181
00:15:11,150 --> 00:15:15,210
،مهما كان ما يواجهونه الآن
!فسينجون حتمًا

182
00:15:15,400 --> 00:15:19,820
،ولكن إن تركتك تفلت الآن
!فستذهب لقتل رفاقي

183
00:15:20,380 --> 00:15:23,160
!لن أزيح عينيّ عنك

184
00:15:24,490 --> 00:15:26,560
.إنّك زعيم ممتاز

185
00:15:26,700 --> 00:15:29,580
.أودّ من أحمق ما أن يسمع هذا

186
00:15:30,250 --> 00:15:33,660
ولكن أتساءل ما إن كانت
!قدراتك كافية لتدعيم قرارك هذا

187
00:15:34,280 --> 00:15:35,130
!مسدّس الإصبع

188
00:15:36,260 --> 00:15:38,050
!ساق العاصفة! ذيل الفهد

189
00:15:46,390 --> 00:15:48,510
!أتستطيع هزيمتي؟

190
00:15:48,850 --> 00:15:51,610
!لا أستطيع حماية أحد ما لم أنتصر

191
00:15:55,650 --> 00:15:57,770
...فاكهة المطّاط

192
00:15:59,700 --> 00:16:00,950
!البندقيّة

193
00:16:02,240 --> 00:16:04,120
.الجسد الحديديّ. الشّجرة الفارغة

194
00:16:17,770 --> 00:16:19,890
!المستوى... الثّالث

195
00:16:29,740 --> 00:16:31,400
!بالون العظام

196
00:16:32,560 --> 00:16:33,510
عظام؟

197
00:16:34,200 --> 00:16:36,760
...القوّة الّتي تنتقل من عظم إلى آخر

198
00:16:37,960 --> 00:16:40,380
...انظر! ذراعي اليسرى

199
00:16:41,950 --> 00:16:44,230
!ذراعُ عملاق

200
00:16:44,740 --> 00:16:47,380
!إن كان هذا مجرّد عرض، فلا تزعج نفسك

201
00:16:47,840 --> 00:16:50,160
...فاكهة المطّاط

202
00:16:50,320 --> 00:16:51,120
!الجسد الحديديّ

203
00:16:51,450 --> 00:16:54,130
!المسدّس العملاق

204
00:17:06,470 --> 00:17:07,260
.الحلقة القصوى

205
00:17:39,710 --> 00:17:41,460
...وإلى أن أهزمك

206
00:17:43,970 --> 00:17:47,640
!فلن... أسقط أرضًا ثانية أبدًا

207
00:18:04,400 --> 00:18:06,000
...المدفع

208
00:18:07,050 --> 00:18:10,880
!الرّشّاش النّفّاث

209
00:18:28,180 --> 00:18:32,680
.في نهاية معركة شاقّة، هزم لوفي لوتشي

210
00:18:33,980 --> 00:18:35,390
!أحسنت يا لوفي

211
00:18:41,860 --> 00:18:44,710
كانت سفن نداء الدّمار تحيط بالجزيرة

212
00:18:44,860 --> 00:18:47,200
.عندما أتت ميري لاصطحابنا

213
00:18:47,340 --> 00:18:50,830
.بدونها، لكنّا لقينا حتفنا في إنيس لوبي

214
00:18:51,050 --> 00:18:55,780
!سفينة شجاعة صانعة للمعجزات

215
00:18:56,370 --> 00:19:00,240
بعد هذه الحادثة، انضمّ فريق
لوتشي إلى سي بي 0

216
00:19:00,380 --> 00:19:02,710
.وحاولوا التّأثير على أحداث دريسروزا

217
00:19:03,380 --> 00:19:07,550
إنّ لهم يدًا في كلّ عمل قذر
.وفي أماكن لا نتوقّعها

218
00:19:09,390 --> 00:19:12,850
.لا أستطيع العثور على أيّ قائمة استعملوها للتّهريب

219
00:19:13,270 --> 00:19:16,730
...لكن واضح تمامًا أنّ هنالك من سرقها

220
00:19:17,100 --> 00:19:18,310
.توقّعت ذلك

221
00:19:19,150 --> 00:19:22,300
كلّ الأسلحة والمتفجّرات الّتي تُركت في الخلف

222
00:19:22,470 --> 00:19:24,880
.سُرقت بعد الحادثة

223
00:19:25,150 --> 00:19:27,030
.كان هنالك الكثير

224
00:19:27,500 --> 00:19:29,470
.لا بدّ أنّه من صنيع منظّمة ما

225
00:19:29,740 --> 00:19:31,740
.كانت البحريّة قلقة بشأن ذلك أيضًا

226
00:19:32,410 --> 00:19:34,040
أكان الجيش الثّوريّ؟

227
00:19:34,450 --> 00:19:38,140
.نعم. ومن غيرهم؟ عد في الحال

228
00:19:39,670 --> 00:19:43,670
تتكوّن سي بي 0 من عملاء
.يتلقّون أوامر مباشرة من نبلاء العالم

229
00:19:44,060 --> 00:19:47,510
وخلال قمّة ليفيلي، كانوا يؤمّنون
.الحماية للتّنانين السّماويّين

230
00:19:48,010 --> 00:19:50,420
.يجدر بكم أن تشكروني

231
00:19:51,600 --> 00:19:53,600
.سايفر بول 0

232
00:19:54,510 --> 00:19:58,770
.بما أنّنا أوقفناكم، تمّ إنقاذ العديد من البلدان

233
00:19:59,020 --> 00:20:01,360
.لا يجب مواجهة التّنانين السّماويّين

234
00:20:01,520 --> 00:20:03,020
.حتّى الأطفال يعرفون ذلك

235
00:20:03,370 --> 00:20:07,360
.التّنانين السّماويّون آلهة أسّسوا هذا العالم

236
00:20:07,530 --> 00:20:10,780
.وكلّ ما لدينا هنا هم مجرّد ملوك للعالم الأدنى

237
00:20:10,950 --> 00:20:14,600
.وبالطّبع يجب أن نقدّم للآلهة كلّ ما يريدونه

238
00:20:14,740 --> 00:20:17,450
.وبعد ذلك، أتّجهوا إلى إيغهيد

239
00:20:17,570 --> 00:20:21,580
إنّ مهمّتنا تنصّ على إعادة
هذا الضّخم إلى إيغهيد

240
00:20:21,710 --> 00:20:24,800
.والقضاء على كلّ الفيغابانك

241
00:20:24,960 --> 00:20:27,260
...إضافة إلى التزام الحذر

242
00:20:27,580 --> 00:20:29,720
.بشأن كلّ ابتكاراته القيّمة

243
00:20:30,220 --> 00:20:33,470
يريدون منّا القضاء على أكثر
.رجل مفيد في العالم

244
00:20:36,350 --> 00:20:40,810
وهل لهذا الأمر أيّ علاقة بما
حدث للولوسيا قبل أيّام؟

245
00:20:53,700 --> 00:20:55,500
.هذا كلّ شيء لليوم

246
00:20:55,870 --> 00:21:00,200
هل سنواجه سي بي 0؟
...إنّهم لا يتعلّمون درسهم أبدًا

247
00:21:00,410 --> 00:21:02,680
.لوتشي رجل خطير للغاية

248
00:21:02,920 --> 00:21:06,670
لنأمل فقط ألاّ يحوّل مسدّس الإصبع
.خاصّته أصدقاءنا لخليّة نحل

249
00:21:07,170 --> 00:21:08,960
.توقّفي، أنت تخيفينني

250
00:21:09,210 --> 00:21:13,220
بدأت الأمور تحتدم أكثر
.على إيغهيد في كلّ الأحوال

251
00:21:13,510 --> 00:21:16,310
.لا أشعر بالقلق أبدًا بوجود لوفي وأصدقائنا هنا

252
00:21:16,430 --> 00:21:17,450
.أنت على حقّ

253
00:21:18,020 --> 00:21:19,800
.كلاّ، داهمَنا الوقت

254
00:21:20,600 --> 00:21:23,520
!إلى لقاء آخر يا رفق

255
00:21:23,690 --> 00:21:25,140
.مع السّلامة

256
00:21:31,860 --> 00:21:37,450
إلى أيّ مدى هربنا؟

257
00:21:37,450 --> 00:21:44,580
نعدّ النّدوب دون أن نعرف

258
00:21:44,580 --> 00:21:51,840
وفي بالي دائمًا، خريطة كنز

259
00:21:51,840 --> 00:21:58,310
أبحث باستمرار عن المستقبل

260
00:21:58,310 --> 00:22:11,860
توجد الوعود الحقيقيّة عميقًا في القلب

261
00:22:11,860 --> 00:22:21,330
للجميع أحلام لا يستطيع أحد اللّحاق بها

262
00:22:21,330 --> 00:22:26,960
تمسّكوا بذلك الحلم فقط

263
00:22:26,960 --> 00:22:34,090
إليك يا من تبتسم مثل الشّمس

264
00:22:34,090 --> 00:22:41,060
لنغنّ نفس الأغنية مثل ذلك اليوم

265
00:22:41,060 --> 00:22:48,110
حتّى إن كبر بنا العمر، لا أريد أن أنسى

266
00:22:48,110 --> 00:22:55,530
إلى أن تصلك هذه الأمنية

267
00:23:05,500 --> 00:23:08,330
.يواصل لوفي ولوتشي القتال بتهوّر

268
00:23:08,460 --> 00:23:12,440
ويهزم السّيرافيم الأربعة جيش
.سي بي 0 الكبير بدون رحمة

269
00:23:12,590 --> 00:23:15,920
وبينما يشهد طاقم قبّعة القشّ
،على قوّتهم الاستثنائيّة

270
00:23:16,060 --> 00:23:21,350
يبدأ فيغابانك بإخبارهم عن بحثه المهمّ
!المتعلّق بقوى فواكه الشّيطان

271
00:23:21,700 --> 00:23:23,140
:في الحلقة القادمة من وان بيس

272
00:23:23,270 --> 00:23:26,180
"!أقوى أشكال البشريّة! قوى السّيرافيم"

273
00:23:26,360 --> 00:23:28,780
!ملك القراصنة، لن يكون إلاّ أنا