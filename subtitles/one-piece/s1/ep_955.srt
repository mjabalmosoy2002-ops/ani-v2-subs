1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:03,070 --> 00:02:04,410
.ها أنت ذا

29
00:02:04,410 --> 00:02:08,740
سرقتَ سيفي، صحيح؟

30
00:02:12,000 --> 00:02:14,120
.لقد قابلتُ ريوما

31
00:02:16,210 --> 00:02:18,510
!لا تكذب عليّ

32
00:02:18,510 --> 00:02:20,920
!كفاك تفوّهًا بكلام مبهم

33
00:02:25,260 --> 00:02:28,180
قبل زمن بعيد، عندما كانت بلاد وانو

34
00:02:28,180 --> 00:02:31,690
...توصف ببلاد الذّهب من قِبل البلدان الأخرى

35
00:02:31,690 --> 00:02:32,730
ذهب؟

36
00:02:32,730 --> 00:02:34,350
!أرخيتَ دفاعك

37
00:02:38,440 --> 00:02:42,400
.رغب القراصنة من حول العالم بالذّهب

38
00:02:42,690 --> 00:02:46,900
!حاول نبلاء حُكم بلاد وانو الّتي عُرفت ببلاد الذّهب

39
00:02:48,950 --> 00:02:54,290
أرى أولئك الأعداء من وراء البحار
...كم أنّه شخص لا يشقّ له غبار

40
00:02:55,540 --> 00:02:59,710
!وحفر ساموراي بلاد وانو في ذاكرتهم

41
00:03:00,210 --> 00:03:04,090
.ذاك ما كان عليه ريوما

42
00:03:07,260 --> 00:03:09,840
!من أنت على أيّ حال؟

43
00:03:10,800 --> 00:03:12,890
!عدوّ أم صديق؟

44
00:03:12,890 --> 00:03:16,930
!لن أعيده لك! سأعطيك أيّ سيف سواه

45
00:03:23,650 --> 00:03:29,450
كان السّيف شوسوي الّذي كنت
!تحمله كنزًا سُرق من بلاد وانو

46
00:03:29,450 --> 00:03:31,700
!ماذا؟ شوسوي؟

47
00:03:31,700 --> 00:03:36,090
!بدأت هذه المأساة برمّتها عندما أُخذ

48
00:03:36,090 --> 00:03:39,210
،وبسبب ذلك، اشتعل غضب إله السّيوف خاصّتنا

49
00:03:39,210 --> 00:03:42,540
!وسقطت كلّ منطقة تواليًا

50
00:03:42,540 --> 00:03:45,630
!وفي النّهاية، احتُلَّت البلاد

51
00:03:46,010 --> 00:03:48,020
لكن كيف...؟

52
00:03:48,020 --> 00:03:52,270
...أفعل أونيمارو هذا؟ لكن فقط البشر يستطيعون فعل هذا

53
00:03:52,270 --> 00:03:55,390
من فعل هذا إذًا؟

54
00:04:02,770 --> 00:04:04,620
...كاواماتسو-ساما

55
00:04:04,620 --> 00:04:09,110
...لقد أدّيت... واجبي

56
00:04:09,360 --> 00:04:10,700
!بالتّوفيق

57
00:04:32,430 --> 00:04:36,600
"!تحالف جديد؟! تجمّع جيش كايدو"

58
00:04:38,600 --> 00:04:41,950
قبل أسبوع من الغارة على أونيغاشيما حيث يُخطّط

59
00:04:41,950 --> 00:04:45,620
،أن تجري المعركة الكبرى في يوم مهرجان النّار

60
00:04:45,620 --> 00:04:49,900
.وقعت في أيدي السّاموراي العديد من السّيوف

61
00:04:57,200 --> 00:04:58,880
!زوروجورو-سان

62
00:04:58,880 --> 00:05:04,960
،إن كان سيفك هو شوسوي الحقيقيّ
!فأعده إلى بلاد وانو

63
00:05:04,960 --> 00:05:07,550
!أخبرتك! إنّه سيفي

64
00:05:09,840 --> 00:05:11,510
!سأمنحك بديلاً عنه

65
00:05:12,760 --> 00:05:16,510
...سيف ورثته عن والدي المتوفّى

66
00:05:17,350 --> 00:05:19,560
!السّيف العظيم إنما

67
00:05:21,680 --> 00:05:22,810
...إنما

68
00:05:23,310 --> 00:05:27,770
إنّه سيف أسطوريّ والسّلاح الوحيد
!الّذي جرح كايدو على الإطلاق

69
00:05:32,530 --> 00:05:35,030
...السّيف الّذي قطع كايدو

70
00:05:35,870 --> 00:05:37,530
...إنما

71
00:05:40,500 --> 00:05:42,510
!لا يا هيوري-ساما

72
00:05:42,510 --> 00:05:46,130
!لا يمكنك التّخلّي عن تذكار من أودن-ساما

73
00:05:50,420 --> 00:05:53,840
...كان والدي كوزكي أودن

74
00:05:54,680 --> 00:05:57,680
.سيّافًا يستعمل أسلوب السّيفين الطّويلين

75
00:05:58,680 --> 00:06:02,560
،قبل أن يُعدَم من طرف الرّجل الفظيع أوروتشي

76
00:06:02,930 --> 00:06:05,940
...عُهد لنا أنا الصّغيرة وأخي مومونوسكي

77
00:06:06,350 --> 00:06:11,320
.بواحد من السّيفين اللّذين استعملهما والدي لكلٍّ منّا

78
00:06:16,610 --> 00:06:17,570
...حصل أخي على

79
00:06:19,200 --> 00:06:21,330
.أمي-نو-هاباكيري

80
00:06:23,960 --> 00:06:24,830
...وحصلتُ أنا على

81
00:06:26,540 --> 00:06:27,710
.إنما

82
00:06:31,000 --> 00:06:36,340
صُنع كلاهما على أيدي صانعي سيوف
.عظماء ذاع صيتهم في بلاد وانو في الماضي

83
00:06:36,680 --> 00:06:39,100
.إنّهما سيفان مذهلان

84
00:06:39,970 --> 00:06:43,070
!لهذا السّبب لا يمكنك التّخلّي عنه يا صاحبة السّموّ

85
00:06:43,070 --> 00:06:46,150
...لا يمكنك السّماح لرجل مريب مثله

86
00:06:46,150 --> 00:06:49,390
!أن يحمل سيف أودن-ساما

87
00:06:49,390 --> 00:06:50,940
...كاواماتسو

88
00:06:51,690 --> 00:06:54,410
،أدرك حقيقة شعورك تمامًا

89
00:06:54,410 --> 00:06:58,610
.لكن لا تكن فظًّا مع الرّجل الّذي أنقذ حياتي

90
00:06:59,820 --> 00:07:02,710
.إنّه سيف ريوما المعروف بإله السّيوف

91
00:07:02,710 --> 00:07:07,170
.لا أعرف كيف انتهى المطاف بشوسوي معك أنت

92
00:07:12,420 --> 00:07:13,670
...حسنًا

93
00:07:14,090 --> 00:07:16,880
...أعتقد أنّ موريا سرقه

94
00:07:17,800 --> 00:07:19,020
...لكن

95
00:07:19,020 --> 00:07:24,020
...عندما سُرق، خيّم الحزن على البلاد بأكملها لأنّه

96
00:07:24,520 --> 00:07:26,480
.كنز مقدّس

97
00:07:28,350 --> 00:07:31,560
.قدّم شوسوي لهذه البلاد رجاءً

98
00:07:49,420 --> 00:07:52,880
...إن أعطيتني بديلاً، فحينها

99
00:07:59,380 --> 00:08:00,770
.حسنًا

100
00:08:00,770 --> 00:08:05,850
شكّلت رابطًا معه لأنّنا تقاتلنا
!وإن كان قتالاً ضدّ جثّته فحسب

101
00:08:17,690 --> 00:08:19,960
...سأعيد شوسوي

102
00:08:19,960 --> 00:08:21,790
،في المقابل

103
00:08:21,790 --> 00:08:24,780
.دعاني أزور قبر ريوما بعد هذا

104
00:08:26,700 --> 00:08:30,040
!إنّه واهم بالفعل! أهو بخير؟

105
00:08:30,870 --> 00:08:32,460
!يا صاحبة السّموّ

106
00:08:38,460 --> 00:08:40,800
...عاصمة الزّهور

107
00:08:41,260 --> 00:08:46,760
يُعرف هذا المكان بالزّنزانات العامّة
.حيث يتمّ عرض السّجناء

108
00:08:49,640 --> 00:08:52,980
.معقل سجناء بلدة راستسو

109
00:08:56,820 --> 00:09:01,120
إنّ السّاموراي الّذين أُسروا هناك
...لتمرّدهم ضدّ الشّوغن أوروتشي

110
00:09:01,120 --> 00:09:04,070
.لم يُحرّروا بعد

111
00:09:04,370 --> 00:09:07,410
خدع ياسويي العدوّ

112
00:09:07,660 --> 00:09:12,330
...وأنقذ خطّة الغارة عن طريق المخاطرة بحياته. ولكن

113
00:09:13,120 --> 00:09:14,920
!ما الّذي يحدث؟

114
00:09:15,250 --> 00:09:17,710
!لسنا متمرّدين

115
00:09:18,130 --> 00:09:23,060
إن المنشورات الّتي كانت معنا كانت
!مجرّد خدعة من ياسويي-ساما

116
00:09:23,060 --> 00:09:26,810
!وشم الهلال مجرّد تصميم شائع

117
00:09:26,810 --> 00:09:29,070
...كيف للخوف أن يتمكّن منكم

118
00:09:29,070 --> 00:09:33,950
لدرجة أن تسجنونا ونحن أبرياء
!وتعرضوننا في مكان كهذا؟

119
00:09:33,950 --> 00:09:37,400
!إنّه لمن المخزي أن نُعتبر كمتمرّدين

120
00:09:38,150 --> 00:09:40,160
!أطلقوا سراحنا

121
00:09:40,160 --> 00:09:41,030
!أنت

122
00:09:42,320 --> 00:09:43,490
...سُحقًا

123
00:09:44,910 --> 00:09:46,910
ماذا بإمكاننا فعله؟

124
00:10:07,720 --> 00:10:10,890
ما الّذي حلّ بتحالفكم؟

125
00:10:11,220 --> 00:10:15,900
...ظننت أنّك شكّلت تحالفًا مع كيد وأبو

126
00:10:19,820 --> 00:10:22,150
...لقد خُدِعنا

127
00:10:26,820 --> 00:10:33,000
...كان سكراتشمن أبو تحت جناح كايدو من البداية

128
00:10:37,670 --> 00:10:40,810
...قال لي كايدو المتوحّش

129
00:10:40,810 --> 00:10:44,670
".إن كنت تريد أن تصير من أتباعي، فسأرحّب بك"

130
00:10:47,720 --> 00:10:51,650
...إنّه في بحث دائم عن جنود أقوياء

131
00:10:51,650 --> 00:10:55,100
...لإنشاء أقوى جيش في العالم

132
00:10:55,980 --> 00:11:00,690
.كانت فرص انتصاري في ذلك الوضع صفرًا في المائة

133
00:11:01,110 --> 00:11:04,870
.وكانت فرص نجاحي في الهرب صفرًا في المائة

134
00:11:04,870 --> 00:11:09,670
.وكانت فرص بقائي عن طريق الانصياع له أربعين في المائة

135
00:11:09,670 --> 00:11:11,620
.لم يكن لديّ خيار

136
00:11:15,870 --> 00:11:19,790
...لكنّ كيد وكيلر لم يكونا مثلي

137
00:11:20,420 --> 00:11:21,800
لقد تحدّياه

138
00:11:21,800 --> 00:11:26,550
.وواصلا القتال إلى أن عجزا عن الحركة بالكامل

139
00:11:27,720 --> 00:11:31,550
.يأبى كايدو أن يقتل الأشخاص أمثالهما

140
00:11:33,260 --> 00:11:37,490
.سيحاول كسر روحهم وسحقهم إلى أن ينصاعوا

141
00:11:37,490 --> 00:11:39,940
...لكن لا أظنّ أنّ كيد سيستسلم

142
00:11:40,270 --> 00:11:42,530
.لذلك فسيُقتل

143
00:11:42,530 --> 00:11:46,190
.أشعر بالأسى على أعضاء طاقم كيد

144
00:11:46,530 --> 00:11:50,960
قيل لهم أنّ عليهم القيام بشتّى
.الأمور إن أرادوا إنقاذ قائدهم

145
00:11:50,960 --> 00:11:54,910
.ممّا يعني أنّ أوروتشي استغلّهم كما يشاء

146
00:12:05,670 --> 00:12:09,140
.يمكنك اعتبار اليونكو مخلوقات مختلفة تمامًا عنّا

147
00:12:09,140 --> 00:12:11,640
!إنّهم لا يفهمون المنطق

148
00:12:15,140 --> 00:12:18,940
يبدو أنّ التّحالف بينك وبين قبّعة
...القشّ يسير بشكل جيّد

149
00:12:20,440 --> 00:12:23,770
...أتيتما إلى بلاد وانو معًا

150
00:12:24,820 --> 00:12:26,240
،والآن

151
00:12:26,240 --> 00:12:28,570
هل غيّرت رأيك؟

152
00:12:29,280 --> 00:12:31,240
!لا تشكّك بي

153
00:12:42,460 --> 00:12:46,210
...إن كنت تخطّط للسّماح لي بالهرب

154
00:12:46,920 --> 00:12:48,460
.فلن أعارضك

155
00:12:55,220 --> 00:12:59,680
.بقيت ستّة أيّام على الغارة على أونيغاشيما

156
00:13:08,190 --> 00:13:10,320
!ذلك هو جلد كايدو

157
00:13:17,740 --> 00:13:21,080
!تذكّر نكساتك

158
00:13:27,090 --> 00:13:31,050
!تذكّر أنّك لم تستطع هزيمته بالقوّة

159
00:13:34,430 --> 00:13:37,760
!باغوا الرّعد

160
00:13:51,570 --> 00:13:53,820
...تبدو تلك الصّفيحة الحديديّة ناعمة كالهلام

161
00:14:02,960 --> 00:14:05,670
!بقيت خمسة أيّام على الغارة

162
00:14:21,020 --> 00:14:30,440
...رنين، رنين، رنين

163
00:14:30,440 --> 00:14:31,690
.فتح

164
00:14:32,820 --> 00:14:33,710
...هذا

165
00:14:33,710 --> 00:14:35,610
!كينييمون

166
00:14:35,610 --> 00:14:40,410
.ثمّة تغيير في الرّمز على المنشورات الّتي تملكونها

167
00:14:40,410 --> 00:14:42,870
!أضيفوا خطّين على بطن أفعى الهابو

168
00:14:44,080 --> 00:14:45,120
...هذه

169
00:14:45,750 --> 00:14:48,920
!رسالة ياسويي-ساما

170
00:14:53,670 --> 00:14:55,170
...خطّان

171
00:14:58,300 --> 00:15:00,350
!خطّان؟

172
00:15:04,020 --> 00:15:05,850
!فهمت

173
00:15:07,190 --> 00:15:09,360
!هذا متوقّع من ياسويي-ساما

174
00:15:10,320 --> 00:15:11,690
...هكذا إذًا

175
00:15:11,690 --> 00:15:14,360
!حسنًا! عُلم

176
00:15:16,320 --> 00:15:19,070
!أنتم، استعملوا الجزء السّفليّ من أجسامكم أكثر

177
00:15:19,490 --> 00:15:23,140
وإلاّ، لن تكون كافية للإبحار
!عبر مياه أونيغاشيما العاتية

178
00:15:23,140 --> 00:15:24,430
!حاضر يا زعيم

179
00:15:24,430 --> 00:15:27,520
!هيّا، هيّا، أستعملوا الجزء السّفليّ لأجسامكم

180
00:15:24,430 --> 00:15:27,520
خطّان على بطن أفعى الهابو؟

181
00:15:27,520 --> 00:15:28,910
!فهمت

182
00:15:28,910 --> 00:15:31,770
!وصلت الرّسالة يا كينييمون-دونو

183
00:15:31,770 --> 00:15:34,050
.جيّد. سرّني أنّها وصلتك

184
00:15:35,550 --> 00:15:40,180
أكان هذا كينييمون؟
!سأحرص على إصلاح كلّ السّفن

185
00:15:40,180 --> 00:15:42,020
...وبشكل خارق

186
00:15:42,020 --> 00:15:44,020
!اعتمدوا عليّ

187
00:15:44,020 --> 00:15:46,450
!دعوا الأمر لنا

188
00:15:44,020 --> 00:15:46,450
!لنبذل كلّ جهدنا

189
00:15:46,450 --> 00:15:47,640
!اعتمدوا علينا

190
00:15:47,640 --> 00:15:51,060
!أخبر الجميع عن التّغيير في الرّمز

191
00:15:51,060 --> 00:15:52,940
.شكرًا لك

192
00:15:53,360 --> 00:15:54,530
.أثرت إعجابي

193
00:15:55,030 --> 00:16:00,500
يستطيع سكّان بلاد وانو اكتشاف المغزى
.من الخطّين الإضافيّين في طرفة عين

194
00:16:00,500 --> 00:16:03,080
حسنًا، ما الّذي يعنيه ذلك؟

195
00:16:03,790 --> 00:16:06,120
...خطّان على أفعى الهابو

196
00:16:09,170 --> 00:16:10,210
!بابو؟

197
00:16:12,040 --> 00:16:17,050
لا يمكنك فهم المغزى إن كنت
.تجهلين أسماء موانئ بلاد وانو

198
00:16:20,390 --> 00:16:22,050
.ميناء إيتاتشي

199
00:16:23,800 --> 00:16:25,350
.ميناء نيكو

200
00:16:25,350 --> 00:16:26,810
.ميناء كايرو

201
00:16:26,810 --> 00:16:28,230
.ميناء موغورا

202
00:16:28,230 --> 00:16:29,690
.ميناء توكاغي

203
00:16:29,690 --> 00:16:32,520
.وميناء هابو

204
00:16:32,520 --> 00:16:37,740
يملك كلّ ميناء في بلاد وانو اسمًا
.قد يعني اسم حيوان أيضًا

205
00:16:38,030 --> 00:16:40,420
،أوّلاً، باستعمال رمز الأفعى

206
00:16:40,420 --> 00:16:44,200
.يكون المقصود أنّ ميناء هابو هو نقطة اللّقاء

207
00:16:44,200 --> 00:16:47,460
.والآن، تمّت إضافة أطراف إليها

208
00:16:47,460 --> 00:16:52,090
،قد يبدو الجسم طويلاً نوعًا ما
.لكنّ إضافة أطراف للأفعى يجعلها سحليّة

209
00:16:52,090 --> 00:16:54,880
.يقع ميناء توكاغي (سحليّة) في أودون

210
00:16:55,380 --> 00:16:59,850
وعن طريق تغيير نقطة اللّقاء
،من ميناء هابو إلى ميناء توكاغي

211
00:16:59,850 --> 00:17:03,970
.فحتّى أذكى وأمكر الأعداء لن يتمكّنوا من اعتراض خطّتنا

212
00:17:04,300 --> 00:17:05,930
...إنّ ياسويي-ساما

213
00:17:06,720 --> 00:17:12,650
قد أخذ في عين الاعتبار كلّ احتماليّة
.وخطى خطوات باكرًا من أجلنا على الأرجح

214
00:17:16,980 --> 00:17:23,080
،كنّا مدينين له من الأساس
.لكنّنا تسبّبنا له بالمشاكل حتّى النّهاية

215
00:17:23,080 --> 00:17:27,410
على السّاموراي الحقيقيّ أن يستغلّ هذه
.الفرصة وإلاّ سيجلب العار على نفسه

216
00:17:28,700 --> 00:17:33,040
...أتذكّر ما قاله ياسويي-ساما مرّة

217
00:17:33,040 --> 00:17:35,250
...عليكم أن تصبحوا لبلاد وانو"

218
00:17:35,250 --> 00:17:36,880
"!حرّاسًا

219
00:17:38,960 --> 00:17:41,100
...كنتَ مذهلاً بالفعل

220
00:17:41,100 --> 00:17:42,340
.يا ياسويي-سان

221
00:17:44,970 --> 00:17:47,560
،ما زالت أمامنا بعض التّحدّيات

222
00:17:48,010 --> 00:17:50,310
،ولكن بفضلكم جميعًا

223
00:17:52,390 --> 00:17:57,190
.ازداد عدد حلفائنا الجنود كما أملنا بالضّبط

224
00:17:57,190 --> 00:18:00,660
،ما زلنا لا نملك أيّ فكرة عمّا حدث لدنجيرو

225
00:18:00,660 --> 00:18:04,660
!لكن في صفوفنا سبعة من أتباع كوزكي

226
00:18:16,250 --> 00:18:18,050
.هذا مذهل بالفعل

227
00:18:18,050 --> 00:18:21,800
.ما عاد امتلاكنا لخمسة آلاف جنديّ مجرّد حلم

228
00:18:21,800 --> 00:18:24,050
!نعم! هذا مدهش

229
00:18:25,510 --> 00:18:28,150
هل ستواصلون الثّرثرة؟

230
00:18:28,150 --> 00:18:30,140
.هذا مضيعة للوقت

231
00:18:30,970 --> 00:18:35,850
!حسنًا، لنبدأ مناقشة الخطّة

232
00:18:36,100 --> 00:18:39,950
...سنطيح برأسَيْ كايدو وأوروتشي بأيّ ثمن

233
00:18:39,950 --> 00:18:44,400
!لنثأر لأودن-ساما المتوفّى

234
00:19:17,850 --> 00:19:22,660
!وصل سكراتشمن أبو إلى بلاد وانو

235
00:19:22,660 --> 00:19:25,360
!تحقّقوا من هذا

236
00:19:26,030 --> 00:19:27,700
...وبالمناسبة

237
00:19:31,240 --> 00:19:36,120
.ثمّة طريقتان في الحقيقة لدخول بلاد وانو

238
00:19:36,500 --> 00:19:37,750
...الأولى

239
00:19:38,170 --> 00:19:42,670
هي الطّريقة الخطيرة بحيث
.تسحب أسماك الكوي الوافدين

240
00:19:49,550 --> 00:19:52,060
!تحرّكوا يا أعزّائي

241
00:19:53,060 --> 00:19:54,230
...والأخرى

242
00:19:54,230 --> 00:19:58,560
.عن طريق فتح الشّلاّل والعبور خلال كهف

243
00:19:59,600 --> 00:20:05,360
ولا داعي أن نذكر أنّ العبور من هنا بسلام
.غير ممكن دون إذن من كايدو وأوروتشي

244
00:20:06,190 --> 00:20:09,950
.يوجد ميناء موغورا في نهاية الكهف

245
00:20:12,990 --> 00:20:18,470
.يتمّ حمل البحّارة والبضائع إلى الأعلى عن طريق ناقلة

246
00:20:18,470 --> 00:20:21,830
،وعند الصّعود إلى نهاية النّفق

247
00:20:26,710 --> 00:20:29,930
.سيجدون أنفسهم في هاكوماي

248
00:20:32,930 --> 00:20:34,970
مرحبًا يا كايدو-سان؟

249
00:20:35,470 --> 00:20:38,020
.لقد وصلنا إلى هاكوماي

250
00:20:38,020 --> 00:20:40,600
أونيغاشيما

251
00:20:38,810 --> 00:20:43,980
ماذا؟ تكبّدتم أنتم أيضًا عناء العودة للاحتفال؟

252
00:20:46,530 --> 00:20:48,250
!بالطّبع عدنا

253
00:20:48,250 --> 00:20:51,080
!إنّه المهرجان الذّهبيّ السّنويّ

254
00:20:51,080 --> 00:20:55,410
!لا أريد أن أظلّ مستبعدًا

255
00:20:55,410 --> 00:20:58,040
!سوف نقيم احتفالاً أكبر من سابقيه

256
00:20:58,040 --> 00:20:59,910
!هذا ممتاز

257
00:21:01,500 --> 00:21:03,790
!لنقم بذلك

258
00:21:17,430 --> 00:21:20,480
!ما-ما-ما هؤلاء؟

259
00:21:21,850 --> 00:21:23,530
...أو... أو

260
00:21:23,530 --> 00:21:25,230
...أونيغاشيما

261
00:21:25,860 --> 00:21:27,730
!إنّهم أرقام أونيغاشيما

262
00:21:28,230 --> 00:21:29,790
!لنهرب في الحال

263
00:21:29,790 --> 00:21:31,700
!وإلاّ أكلونا

264
00:21:42,670 --> 00:21:44,980
...أعتقد أنّ الأرقام عادوا أيضًا

265
00:21:44,980 --> 00:21:46,010
!ماذا؟

266
00:21:46,010 --> 00:21:50,760
!أكرههم لأنّهم يشربون بشكل فوضويّ

267
00:21:50,760 --> 00:21:52,630
!لنحتسِ شرابًا آخر

268
00:22:00,770 --> 00:22:05,100
سنقيم أعظم احتفال على الإطلاق
!في ليلة مهرجان النّار

269
00:22:05,100 --> 00:22:07,980
.صحيح، سيكون ذكرى سنويّة

270
00:22:10,650 --> 00:22:11,490
ما هذا...؟

271
00:22:11,820 --> 00:22:14,950
أصبحا صديقين بعد أن حاولا قتل بعضهما؟

272
00:22:18,910 --> 00:22:21,330
!اسمعوا يا هؤلاء

273
00:22:21,330 --> 00:22:22,040
!ماذا هنالك؟

274
00:22:22,330 --> 00:22:25,290
...نحن قراصنة مملكة الحيوان

275
00:22:25,540 --> 00:22:28,170
...وقراصنة بيغ مام

276
00:22:28,710 --> 00:22:30,050
.دعني أقف

277
00:22:30,050 --> 00:22:31,900
...قد قرّرنا

278
00:22:31,900 --> 00:22:33,840
...أن نشكّل

279
00:22:33,840 --> 00:22:35,760
!تحالفًا

280
00:22:36,970 --> 00:22:37,640
ماذا؟

281
00:22:38,810 --> 00:22:46,730
!ماذا؟

282
00:22:46,730 --> 00:22:52,110
!أوّلاً، سنحكم العالم معًا

283
00:22:52,110 --> 00:22:55,490
!ثمّ سنعود إلى قتل بعضنا البعض

284
00:23:04,410 --> 00:23:08,430
التّقطيع لنصفين بضربة واحدة! يعاني
!زورو مع إنما الّذي يمتصّ الهاكي خاصّته

285
00:23:08,430 --> 00:23:11,010
!في تلك الأثناء، يحاول لوفي جاهدًا إتقان ريو

286
00:23:11,010 --> 00:23:15,060
،وبينما يُحمّس الجميع أنفسهم
!يكاد ينتهي تجنيد الحلفاء

287
00:23:15,060 --> 00:23:17,190
!وها قد حان اليوم أخيرًا

288
00:23:17,190 --> 00:23:19,180
،بوجود مصير بلاد وانو على المحكّ

289
00:23:19,180 --> 00:23:21,910
!يبذل قراصنة قبّعة القشّ والأكازايا مجهودات يائسة

290
00:23:22,560 --> 00:23:23,950
:في الحلقة القادمة من وان بيس

291
00:23:23,950 --> 00:23:27,380
!وقت المعركة الكبرى وشيك"
"!يدخل قراصنة قبّعة القشّ وضع القتال

292
00:23:27,380 --> 00:23:29,790
!ملك القراصنة، لن يكون إلاّ أنا