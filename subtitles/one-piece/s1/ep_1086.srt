1
00:00:00,650 --> 00:00:04,320
بوجود الضّعف كحليف لي

2
00:00:04,320 --> 00:00:07,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,950 --> 00:00:10,660
من المؤسف البقاء في مكان كهذا

4
00:00:10,660 --> 00:00:14,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,200 --> 00:00:18,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,870 --> 00:00:22,500
إن كان قلبي أيضًا ضائعًا

7
00:00:22,500 --> 00:00:25,210
فلن أتمكّن من إيجادك

8
00:00:25,210 --> 00:00:29,260
لا لطفك ولا قوّتك

9
00:00:29,260 --> 00:00:35,060
أعلم مسبقًا

10
00:00:35,060 --> 00:00:36,970
إنّ بزوغ الفجر وشيك

11
00:00:36,970 --> 00:00:40,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,150 --> 00:00:44,320
سأندفع عبر الطّريق بأكمله

13
00:00:44,320 --> 00:00:47,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,070 --> 00:00:51,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,570 --> 00:00:54,330
بوجود العالم كعدوّ لي

16
00:00:54,330 --> 00:00:58,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,790 --> 00:01:01,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,580 --> 00:01:06,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:15,970 --> 00:01:21,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:27,960 --> 00:01:30,140
...اليونكو كايدو

21
00:01:30,140 --> 00:01:32,690
...واليونكو بيغ مام أيضًا

22
00:01:33,040 --> 00:01:34,830
.أُطيح بكليهما

23
00:01:35,500 --> 00:01:38,040
.صار ذلك نقطة تحوّل في هذا العصر

24
00:01:39,840 --> 00:01:44,700
وهكذا، فإنّ صحوة لوفي، الّذي صار
...من اليونكو، الصّادمة

25
00:01:44,700 --> 00:01:46,750
.هزّت العالم

26
00:01:48,100 --> 00:01:52,850
.بدأ هذا العصر بالتّغيّر بشكل كبير وواضح

27
00:01:53,740 --> 00:01:56,770
.تتواصل مغامرتهم إلى المرحلة التّالية

28
00:02:04,960 --> 00:02:09,690
"!اليونكو الجديد! المهرّج العبقريّ باغي"

29
00:02:22,050 --> 00:02:23,760
!يا هذا

30
00:02:35,640 --> 00:02:38,570
!إنّك لستَ مؤهّلاً لتكون قبطانًا

31
00:02:38,570 --> 00:02:41,740
...أ...أنا... آسف

32
00:02:41,740 --> 00:02:45,110
!وضعت حياة كلّ أفراد طاقمك في خطر

33
00:02:59,010 --> 00:03:00,910
!كيف لك أن تكون بهذا الغباء؟

34
00:03:07,020 --> 00:03:10,830
،لكنّ الجميع بخير الآن
...ربّما هذا يكفي

35
00:03:11,600 --> 00:03:15,340
!لا تتساهل معه يا جينبي

36
00:03:17,160 --> 00:03:19,770
!لـ-لون الملك الأسمى؟

37
00:03:19,770 --> 00:03:21,340
!توقّف يا زعيم

38
00:03:21,660 --> 00:03:24,030
!لا تقترب من نامي وهي غاضبة

39
00:03:26,870 --> 00:03:29,830
هل انتهيتَ من الإصلاحات؟

40
00:03:29,830 --> 00:03:31,990
!نعم، كلّ شيء كما يجب

41
00:03:32,250 --> 00:03:35,410
!أرأيت كم كانت السّاني قويّة؟

42
00:03:35,410 --> 00:03:37,960
،لقد سقطت من ارتفاع شاهق

43
00:03:37,960 --> 00:03:40,670
!ولم يُكسر سوى عمود شراع واحد

44
00:03:44,090 --> 00:03:46,550
ما هذا الصّوت؟

45
00:03:46,550 --> 00:03:48,800
!أعتقد أنّك ما زلت تستطيع الشّعور بالجوع

46
00:03:59,570 --> 00:04:02,290
!روبين-تشان

47
00:04:02,290 --> 00:04:03,890
!آسف على التّأخير

48
00:04:05,870 --> 00:04:06,970
!شكرًا لك

49
00:04:13,700 --> 00:04:17,160
...حبّ، حبّ، حبّ

50
00:04:17,840 --> 00:04:18,730
!عجبًا

51
00:04:19,300 --> 00:04:21,460
.ملصقات المطلوبين خاصّتنا

52
00:04:23,760 --> 00:04:25,040
!ملصقات مطلوبين؟

53
00:04:29,310 --> 00:04:31,050
!دعيني أرى

54
00:04:31,480 --> 00:04:33,720
!روبين-تشان

55
00:04:42,490 --> 00:04:46,400
القبطان الأعلى لأسطول قبّعة القشّ
،المتكوّن من 5600 عضوًا

56
00:04:46,950 --> 00:04:51,680
اليونكو قبّعة القشّ لوفي وضبّاطه
...التّسعة الأعلى

57
00:04:51,680 --> 00:04:54,270
كم صارت مكافآتهم الآن يا ترى؟

58
00:05:03,220 --> 00:05:04,700
هل ارتفعت؟

59
00:05:09,980 --> 00:05:12,860
.طبيب السّفينة، تشوبّر محبّ الحلوى القطنيّة

60
00:05:12,860 --> 00:05:14,410
.حيوان أليف بين قوسين

61
00:05:14,770 --> 00:05:16,910
.المكافأة: 1000 بيري

62
00:05:16,910 --> 00:05:18,720
.ارتفعت 900 بيري

63
00:05:20,100 --> 00:05:23,190
...مهلاً! ارتفعت، ولكن

64
00:05:32,370 --> 00:05:34,930
.الملاّحة، القطّة اللّصّة نامي

65
00:05:34,930 --> 00:05:38,830
.المكافأة" 366 مليون بيري

66
00:05:39,840 --> 00:05:42,910
!أزيد من 100 مليون؟
!أتمنّى لو كان لي كلّ ذلك المال

67
00:05:52,090 --> 00:05:53,590
!أجل

68
00:05:54,440 --> 00:05:57,280
.الموسيقيّ، ملك السّول بروك

69
00:05:57,280 --> 00:06:01,100
.المكافأة: 383 مليون بيري

70
00:06:01,100 --> 00:06:02,520
!شكرًا

71
00:06:02,520 --> 00:06:03,810
ماذا...؟

72
00:06:08,700 --> 00:06:11,670
.نجّار السّفينة، السّايبورغ فرانكي

73
00:06:11,670 --> 00:06:15,610
.المكافأة: 394 مليون بيري

74
00:06:15,950 --> 00:06:19,240
!سُحقًا لهم! أين صورتي؟

75
00:06:39,900 --> 00:06:42,290
.القنّاص، الإله أوسوبّ

76
00:06:42,290 --> 00:06:44,800
.المكافأة: 500 مليون بيري

77
00:06:45,030 --> 00:06:46,670
!هذا يكفي

78
00:06:46,670 --> 00:06:49,340
!لا أريدها أن ترتفع أكثر بعد الآن

79
00:06:50,910 --> 00:06:53,170
!لستُ حيوانًا أليفًا

80
00:06:57,840 --> 00:06:58,640
.خذ

81
00:06:59,750 --> 00:07:02,400
.ابتهج يا تشوبّر

82
00:07:04,340 --> 00:07:07,600
.عالمة الآثار، الطّفلة الشّيطانة نيكو روبين

83
00:07:07,600 --> 00:07:11,130
.المكافأة: 930 مليون بيري

84
00:07:12,730 --> 00:07:14,580
!شكرًا يا روبين

85
00:07:19,860 --> 00:07:23,960
!ارتفعت مكافأتي كثيرًا

86
00:07:26,360 --> 00:07:28,670
.طبّاخ، السّاق السّوداء سانجي

87
00:07:28,670 --> 00:07:32,400
.المكافأة: مليار و32 مليون بيري

88
00:07:33,160 --> 00:07:35,220
.إليك ملصقك يا جينبي

89
00:07:37,240 --> 00:07:39,050
.يا له من شرف

90
00:07:39,050 --> 00:07:42,450
.اعترفوا بي كعضو من طاقم قبّعة القشّ

91
00:07:42,450 --> 00:07:46,610
.بالطّبع سيعترفون. أحدثتَ جلبة كبيرة

92
00:07:48,430 --> 00:07:49,710
!ماذا؟

93
00:07:54,680 --> 00:07:57,150
.ربّان السّفينة، فارس البحر جينبي

94
00:07:57,150 --> 00:07:59,880
.المكافأة: مليار و100 مليون بيري

95
00:08:02,440 --> 00:08:04,950
.سيّاف، صائد القراصنة روزو

96
00:08:04,950 --> 00:08:08,600
.المكافأة: مليار و111 مليون بيري

97
00:08:08,600 --> 00:08:12,730
!لماذا مكافأتي أقلّ من مكافأته؟

98
00:08:12,730 --> 00:08:14,550
هل أنت بخير يا سانجي؟

99
00:08:14,550 --> 00:08:16,070
ما الخطب؟

100
00:08:16,070 --> 00:08:18,780
...صحيح يا جينبي

101
00:08:18,780 --> 00:08:20,770
...أنت أيضًا

102
00:08:21,490 --> 00:08:24,100
.لا تقلق يا جينبي

103
00:08:24,100 --> 00:08:25,950
.حيال صاحب المركز الرّابع هذا

104
00:08:28,220 --> 00:08:30,690
!من تنعت بصاحب المركز الرّابع؟

105
00:08:33,840 --> 00:08:35,870
!اخرس يا رأس الطّحلب –
!اهدآ –

106
00:08:36,930 --> 00:08:38,490
...أنا آسف

107
00:08:38,980 --> 00:08:40,840
...أخرجيني من هنا رجاءً

108
00:08:42,150 --> 00:08:46,080
.القبطان الأعلى، اليونكو قبّعة القشّ لوفي

109
00:08:46,080 --> 00:08:49,560
.المكافأة: 3 مليارات بيري

110
00:08:50,740 --> 00:08:53,260
!توقّفا كلاكما

111
00:08:55,240 --> 00:08:57,140
...أنا جائع

112
00:09:05,450 --> 00:09:07,960
هل رأيتهم؟ –
!نعم، نعم –

113
00:09:07,960 --> 00:09:10,910
!كانوا هم بالفعل –
!هذا مذهل –

114
00:09:13,370 --> 00:09:16,260
!كان ذلك أعظم سيّافي العالم؟

115
00:09:16,260 --> 00:09:18,330
!أنا خائف –
!يا إلهي –

116
00:09:21,300 --> 00:09:25,450
عندما تمّ حلّ نظام الشّيتشيبوكاي
،وكنّا محاصرين بسُفن البحريّة

117
00:09:25,450 --> 00:09:27,580
...ظننتُ أنّه قُضي علينا

118
00:09:28,720 --> 00:09:32,690
...بفضل رئيسنا باغي، انتهى الأمر هكذا

119
00:09:41,540 --> 00:09:45,160
!مهلاً لحظة

120
00:09:45,160 --> 00:09:49,520
!خذا كلّ ما تريدانه إلاّ حياتي

121
00:10:05,400 --> 00:10:07,700
!أنا أرجوكما

122
00:10:07,700 --> 00:10:09,510
!سأفعل أيّ شيء

123
00:10:09,510 --> 00:10:12,850
!حتّى أنّي سألعق أحذيتكما! رجاءً

124
00:10:18,450 --> 00:10:24,390
كان من المفترض أن نؤسّس
.كروس غيلد أنا وعين الصّقر

125
00:10:24,740 --> 00:10:28,370
!لماذا أنت هو زعيمها؟ أخبرني يا باغي

126
00:10:28,370 --> 00:10:31,560
!لا يمكنني سوى الاعتذار الآن

127
00:10:31,560 --> 00:10:33,480
..."أو قول "لا تهتمّ

128
00:10:34,180 --> 00:10:39,660
أنت أوّل وآخر شخص ارتقى لمنصب
.اليونكو بقوله "آسف" فقط

129
00:10:40,020 --> 00:10:42,990
.سيكون هذا مثالاً سيّئًا إن تركناك تعيش

130
00:10:45,100 --> 00:10:50,470
إنّ كلمة "إهانة" ليست كافية
.للتّعبير عمّا أشعر به

131
00:10:51,610 --> 00:10:53,220
...لا تقتلاني

132
00:10:53,220 --> 00:10:55,020
.ذلك مستحيل

133
00:10:57,730 --> 00:11:01,940
!توقّف، توقّف، توقّف! توقّف

134
00:11:01,940 --> 00:11:03,610
...حسنًا، حسنًا

135
00:11:03,610 --> 00:11:05,880
!أيّها الزّعيم

136
00:11:05,880 --> 00:11:11,740
!أنا مسرور لخدمتك بعد كلّ هذا الوقت

137
00:11:11,740 --> 00:11:15,790
!أيّها الوغد! هل تخونني يا غالدينو؟

138
00:11:15,790 --> 00:11:21,030
!لا أذكر أنّي صرت تابعك يومًا يا باغي؟

139
00:11:22,130 --> 00:11:24,450
!يا لك من وغد

140
00:11:25,340 --> 00:11:27,870
!صفني بما تشاء

141
00:11:29,020 --> 00:11:33,230
انتهى أمر الزّعيم. ماذا نفعل الآن؟

142
00:11:33,230 --> 00:11:35,090
!سأخدم كروكودايل

143
00:11:38,450 --> 00:11:41,270
.إنّنا نعيش في عالم قاسٍ

144
00:11:42,540 --> 00:11:45,900
!خاطرت بحظّك كثيرًا

145
00:11:45,900 --> 00:11:48,020
!أنت! توقّف –
!خذ! خذ –

146
00:11:52,210 --> 00:11:56,080
!خسرت امتيازاتك كشيتشيبوكاي يا عين الصّقر

147
00:11:56,590 --> 00:11:59,580
ماذا تريد يا كروكودايل؟

148
00:11:59,580 --> 00:12:03,510
.تحيط البحريّة بهذه الجزيرة حاليًّا

149
00:12:03,510 --> 00:12:04,590
.لا عجب في ذلك

150
00:12:06,440 --> 00:12:11,550
،في آخر قمّة ليفيلي
،تمّ سحب كلّ حقوق الشّيتشيبوكاي

151
00:12:11,550 --> 00:12:14,790
.وقُطعت أيّ علاقة لهم بحكومة العالم

152
00:12:15,650 --> 00:12:19,460
.هذا يعني أنّك مجرّد قرصان الآن

153
00:12:19,460 --> 00:12:22,980
.تتحرّك البحريّة بسرعة في أوقات كهذه فحسب

154
00:12:23,830 --> 00:12:27,400
.إنّ ما حدث بسببك أنت أيضًا

155
00:12:27,400 --> 00:12:29,280
...كان ذلك قبل زمن بعيد

156
00:12:35,620 --> 00:12:38,150
.تعال إلى هنا إذًا

157
00:12:39,470 --> 00:12:41,870
لا يبدو هذا سيّئًا، صحيح؟

158
00:12:42,510 --> 00:12:47,910
إن وحّدنا قوانا معًا، فسنكون منظّمة
.لا يمكن للبحريّة تجاهلها

159
00:12:48,770 --> 00:12:53,250
.كنتَ تُعرف في السّابق بصيّاد البحريّة

160
00:12:53,730 --> 00:12:56,140
...أنا وأنت متشابهان

161
00:12:56,690 --> 00:12:59,340
.من ناحية عدم ثقتنا بأيّ أحد

162
00:13:04,990 --> 00:13:07,940
!ما الّذي يريده؟! أنا جدّ خائف

163
00:13:08,500 --> 00:13:13,230
لماذا يتبعني النّحس أينما ذهبتُ هكذا؟

164
00:13:15,410 --> 00:13:16,690
!أسرعوا

165
00:13:20,010 --> 00:13:21,780
!بسرعة –
!ما الّذي تفعله؟ –

166
00:13:30,190 --> 00:13:32,870
!قبطان باغي –
!يا قبطان –

167
00:13:33,720 --> 00:13:36,220
!أيّها القبطان باغي

168
00:13:36,220 --> 00:13:39,100
!ما الأمر؟! قاتلوا

169
00:13:39,100 --> 00:13:41,340
!هل أنتم خائفون من البحريّة؟

170
00:13:42,530 --> 00:13:46,730
!هؤلاء الحمقى! أنا أستعدّ للتّسلّل بعيدًا عن هنا

171
00:13:46,730 --> 00:13:48,000
!أيّها القبطان

172
00:13:48,000 --> 00:13:51,900
تتعرّض السّفن الحربيّة
!الّتي تحاصر الجزيرة للهجوم

173
00:13:54,420 --> 00:13:57,350
!إنّها تغرق الواحدة تلو الأخرى

174
00:13:58,410 --> 00:13:59,790
!تقصد البحريّة؟

175
00:14:03,370 --> 00:14:04,980
!ماذا؟

176
00:14:04,980 --> 00:14:07,210
!من يساعدنا؟

177
00:14:19,220 --> 00:14:21,390
!إنّه كروكودايل

178
00:14:28,770 --> 00:14:29,650
.ابتعدوا عن الطّريق

179
00:14:36,110 --> 00:14:37,690
!أطلقوا

180
00:14:44,720 --> 00:14:46,360
!رمال

181
00:14:51,590 --> 00:14:56,550
إذًا فإشاعة أنّ كروكودايل هو تابع
!الرّئيس باغي كانت صحيحة

182
00:14:56,550 --> 00:14:59,850
!أتى لنجدتنا مخاطرًا بحياته

183
00:14:59,850 --> 00:15:01,930
!بفضل رئيسنا باغي العظيم

184
00:15:04,310 --> 00:15:07,130
!هكذا إذًا... إنّه كروكودايل

185
00:15:11,950 --> 00:15:15,880
!أتى لتحصيل ديني الكبير عنده

186
00:15:15,880 --> 00:15:19,590
!ماذا أفعل؟ لا مال لديّ لأدفع له

187
00:15:19,590 --> 00:15:21,910
!إنّه مخيف أكثر من البحريّة

188
00:15:27,260 --> 00:15:29,120
.أنا أعرفك

189
00:15:29,470 --> 00:15:31,950
.ظننتُ أنّك ستهرب دون الدّفع لي

190
00:15:35,310 --> 00:15:37,340
!محقّ تمامًا

191
00:15:37,340 --> 00:15:38,660
...إطلاقًا

192
00:15:38,660 --> 00:15:42,120
،قد يبدو أنّ خدمة توصيل باغي تُبلي حسنًا

193
00:15:42,120 --> 00:15:46,000
!لكنّها تملك الكثير من الأفواه لإطعامها

194
00:15:46,000 --> 00:15:49,840
كما أنّ العمالقة الّذين هم أكبر
...مُكسبينا قد غادروا

195
00:15:50,280 --> 00:15:54,640
.إن لم تستطع الدّفع، فبإمكاننا بيعك كعبد

196
00:15:55,230 --> 00:15:57,510
!لا تقل أشياء فظيعة كهذه

197
00:15:57,510 --> 00:16:01,070
!لقد هربنا من إمبل داون معًا

198
00:16:01,070 --> 00:16:02,620
!يا كرو-تشان

199
00:16:02,620 --> 00:16:05,970
،أعرتك المال لذلك السّبب بالتّحديد

200
00:16:05,970 --> 00:16:07,500
،لكن إن لم تستطع ردّه

201
00:16:07,930 --> 00:16:09,710
.فسيكون عليك تحمّل كامل المسؤوليّة

202
00:16:09,970 --> 00:16:11,240
مسؤوليّة؟

203
00:16:12,060 --> 00:16:15,630
،سأقوم بتأسيس شركة جديدة
.لذلك أحتاج للمال في الحال

204
00:16:15,630 --> 00:16:18,090
...كـ-كـ-كلاّ

205
00:16:19,260 --> 00:16:20,950
...في تلك الحالة

206
00:16:20,950 --> 00:16:25,200
!د-دعني أساعدك في ذلك

207
00:16:25,200 --> 00:16:27,600
...هذا الشّيتشيبوكاي السّابق الواقف أمامك

208
00:16:28,160 --> 00:16:30,230
!سيعمل تحت إمرتك

209
00:16:30,230 --> 00:16:31,690
فعلاً؟

210
00:16:31,690 --> 00:16:34,440
!سأعمل لأسدّد ديني

211
00:16:34,630 --> 00:16:39,180
!يجب أن يكون تأسيسُ شركةٍ عملاً مبهرجًا

212
00:16:40,000 --> 00:16:42,320
!لدينا موارد بشريّة مختلفة

213
00:16:42,320 --> 00:16:44,260
.تصميم الإعلانات

214
00:16:44,260 --> 00:16:45,720
.الطّباعة

215
00:16:45,720 --> 00:16:47,120
!النّقل

216
00:16:47,220 --> 00:16:49,100
!يمكنك أن تأمرنا كيفما تشاء

217
00:16:49,100 --> 00:16:51,440
!سنعمل بالمجّان

218
00:16:52,180 --> 00:16:55,590
تكلّم، هل هذا هو الملصق الّذي وزّعتَه؟

219
00:16:57,480 --> 00:16:59,700
...إنّك في منتصفه

220
00:16:59,980 --> 00:17:01,300
.يا رئيس

221
00:17:01,300 --> 00:17:03,780
...كـ-كلاّ

222
00:17:03,780 --> 00:17:05,970
!ذلك ليس ما كنتُ أنوي فعله

223
00:17:05,970 --> 00:17:08,020
!إن لم يكن عملاً مقصودًا، فماذا إذًا؟

224
00:17:14,530 --> 00:17:17,710
!لـ-لم يكن ذلك قصدي بالفعل

225
00:17:17,710 --> 00:17:22,110
!يحترمني أتباعي كثيرًا

226
00:17:22,110 --> 00:17:24,030
!تفاجأت أنا أيضًا

227
00:17:26,250 --> 00:17:27,950
!أيّها الرّئيس

228
00:17:28,510 --> 00:17:30,780
!صمّمت واحدًا جيّدًا

229
00:17:31,720 --> 00:17:33,830
!مهلاً، ما ذلك الملصق؟

230
00:17:33,830 --> 00:17:36,630
!جعلتُ الرّئيس يبدو الأروع بينهم

231
00:17:36,630 --> 00:17:38,800
!ماذا؟

232
00:17:42,060 --> 00:17:44,590
لم يرَ أيّ أحد هذا، صحيح؟

233
00:17:44,590 --> 00:17:48,510
...سبق ووزّعناه –
!في كلّ أرجاء العالم –

234
00:17:48,510 --> 00:17:51,520
!ماذا؟

235
00:17:56,740 --> 00:18:01,440
،باغي هو العقل المدبّر خلف الهروب من إمبل داون

236
00:18:01,440 --> 00:18:04,550
.وهو عضو سابق أيضًا في طاقم ملك القراصنة

237
00:18:04,550 --> 00:18:08,580
كان يقف على قدم المساواة
.مع اليونكو أحمر الشّعر شانكس في الماضي

238
00:18:09,540 --> 00:18:15,560
إنّه محبوب للغاية لدرجة أنّ كروكودايل
.أتى لمساعدته في جزيرة كاراي باري

239
00:18:15,560 --> 00:18:20,250
كما تمّ تأكيد العلاقة بين كروكودايل
.وعين الصّقر عن طريق أجهزة التّنصّت

240
00:18:21,850 --> 00:18:25,380
سبق واستثمرت العديد من المنظّمات
."المشبوهة في "صيد جنود البحريّة

241
00:18:25,380 --> 00:18:29,410
،في ضوء التّصاعد المتزايد للتّمرّد في أرجاء العالم

242
00:18:29,410 --> 00:18:33,650
.فإنّ كروس غيلد تُعدّ تهديدًا حقيقيًّا لنا

243
00:18:33,650 --> 00:18:35,890
ما هي مكافآت أولئك الثّلاثة؟

244
00:18:37,190 --> 00:18:40,480
!الشّيتشيبوكاي السّابق السّير كروكودايل

245
00:18:41,020 --> 00:18:43,900
.مستعمل مرعب لقوى فاكهة شيطان من صنف لوغيا

246
00:18:43,900 --> 00:18:46,910
.كما أنّه يتمتّع أيضًا بذكاء حادّ وقدرة على القيادة

247
00:18:47,840 --> 00:18:50,870
!لذلك فإنّ مكافأته هي مليار و965 مليون بيري

248
00:18:51,290 --> 00:18:53,370
!عين الصّقر ميهوك

249
00:18:53,700 --> 00:18:58,380
تفوّق الشّيتشيبوكاي السّابق على اليونكو
.أحمر الشّعر في المسايفة

250
00:18:58,920 --> 00:19:02,460
،وبصفته السّيّاف الأعظم في العالم
...فإنّ مكافأته هي

251
00:19:03,480 --> 00:19:06,090
!ثلاثُ مليارات و590 مليون بيري

252
00:19:06,400 --> 00:19:09,720
!إضافة إلى المهرج العبقريّ باغي

253
00:19:10,150 --> 00:19:12,660
،إلى جانب سجلّه الّذي ذكرتُه قبل قليل

254
00:19:12,660 --> 00:19:16,310
فإنّ ذلكما الاثنين تحت إمرته أيضًا
...وهو الأكثر أهمّيّة الآن

255
00:19:17,620 --> 00:19:21,050
!لذلك فإنّ مكافأته هي 3 مليارات و189 مليون بيري

256
00:19:21,370 --> 00:19:25,260
،إنّنا نعتبره يونكو جديدًا مثل قبّعة القشّ

257
00:19:25,260 --> 00:19:30,400
!وصنّفناه على أنّه خطر على أمن حكومة العالم

258
00:19:31,630 --> 00:19:32,700
...وأيضًا

259
00:19:32,700 --> 00:19:34,650
أنت يونكو؟

260
00:19:34,910 --> 00:19:37,400
...يا لها من سمعة صنعت لنفسك

261
00:19:37,760 --> 00:19:39,040
...أيّها المهرّج

262
00:19:39,040 --> 00:19:42,480
!أنا جدّ آسف! آسف بالفعل

263
00:19:42,480 --> 00:19:43,510
!سألعق حذاءك

264
00:19:43,510 --> 00:19:44,460
!اخرس

265
00:19:46,170 --> 00:19:49,740
،لكن من جهة أخرى

266
00:19:49,740 --> 00:19:52,760
.ليست فكرة سيّئة أن يكون قائدًا شكليًّا لنا

267
00:19:54,140 --> 00:19:56,090
،أنا على الأقلّ

268
00:19:56,320 --> 00:20:01,050
.أفضّل العيش بسلام على أن أصير يونكو

269
00:20:01,830 --> 00:20:03,180
أأنت واثق؟

270
00:20:03,410 --> 00:20:05,800
،دعه يتحمّل تبعات ذلك

271
00:20:05,800 --> 00:20:08,770
.ويمكننا التّخلّص منه وقتما نريد

272
00:20:11,800 --> 00:20:13,520
.معك حقّ

273
00:20:25,300 --> 00:20:26,760
!يا رفاق

274
00:20:27,890 --> 00:20:32,120
،استعدادًا للعصر الجديد الّذي يقترب منّا

275
00:20:32,120 --> 00:20:35,410
!أسّسنا كروس غيلد

276
00:20:35,410 --> 00:20:37,980
!دعوني أقدّم لكم كبار المسؤولين فيها

277
00:20:38,430 --> 00:20:40,060
...أوّلاً

278
00:20:40,060 --> 00:20:43,260
!السّير كروكودايل

279
00:20:45,940 --> 00:20:47,560
...وأيضًا

280
00:20:48,240 --> 00:20:52,060
!عين الصّقر ميهوك

281
00:20:54,030 --> 00:20:56,990
!كروكودايل –
!ميهوك-ساما –

282
00:20:59,380 --> 00:21:00,750
!سنتبعك

283
00:21:00,750 --> 00:21:03,420
!سير كروكودايل

284
00:21:03,420 --> 00:21:06,250
!والآن يا رفاق

285
00:21:06,840 --> 00:21:09,290
!لنقم بهذا بطريقة مبهرجة

286
00:21:15,400 --> 00:21:17,660
!الرّئيس باغي يبكي

287
00:21:17,660 --> 00:21:20,350
!تأثّرنا حتّى البكاء نحن أيضًا

288
00:21:22,530 --> 00:21:25,560
!ما الّذي سيحلّ بحياتي؟

289
00:21:51,300 --> 00:21:55,300
انتهى الوقت

290
00:21:55,300 --> 00:21:59,140
هنالك من ضحك ثانية

291
00:21:59,310 --> 00:22:06,770
لا بأس، فإنّ الغمّيضة الآن انتهت

292
00:22:06,770 --> 00:22:11,030
تعال معي
(سنراها قريبًا)

293
00:22:11,190 --> 00:22:14,780
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

294
00:22:14,950 --> 00:22:19,160
شيء ما سيتغيّر
(سنراها قريبًا)

295
00:22:19,330 --> 00:22:23,410
كن قويًّا، ما زال هنالك وقت
(3-2-1)

296
00:22:31,460 --> 00:22:35,550
لكنّنا شباب، لذلك فنحن أحرار

297
00:22:35,550 --> 00:22:40,010
لنعش جميعًا أحلامنا الأكثر حماقة

298
00:22:40,180 --> 00:22:43,930
سننير الطّريق المظلم أمامنا

299
00:22:44,100 --> 00:22:48,060
لنقف على أقدامنا ونحاول

300
00:22:48,230 --> 00:22:52,150
لنكتشف معًا أصقاع العالم

301
00:22:52,150 --> 00:22:56,530
أنا وأنت، سنحلّق بعيدًا

302
00:23:04,580 --> 00:23:09,150
يقود قائد البحريّة كوبي غزوًا
.باستعمال الباسيفيستا الجدد

303
00:23:09,150 --> 00:23:12,380
لكنّ اليونكو اللّحية السّوداء يستغل
.هذا الاضطراب الحاصل ويُغير عليهم

304
00:23:12,730 --> 00:23:15,760
بينما الإمبراطورة القرصانة هانكوك
.لن تقف مكتوفة الأيدي

305
00:23:16,100 --> 00:23:21,630
من سيفوز في هذا الصّراع ثلاثيّ
الأطراف يحث تتشابك الظّلمة والجمال؟

306
00:23:22,390 --> 00:23:23,750
:في الحلقة القادمة من وان بيس

307
00:23:23,750 --> 00:23:26,850
!الحرب على جزيرة النّساء"
"!قضيّة تتعلّق بالبطل كوبي

308
00:23:26,850 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا