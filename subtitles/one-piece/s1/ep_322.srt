1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:28,590 --> 00:02:33,220
...إن كنت تنوي أخذه معكم حقًّا

33
00:02:33,700 --> 00:02:35,230
.فخذه مهما تطلّب الأمر

34
00:02:35,640 --> 00:02:37,480
!خذه بالقوّة

35
00:02:37,480 --> 00:02:41,270
!تلك هي الطّريقة الوحيدة لتحريره

36
00:02:43,780 --> 00:02:48,530
‘‘!وداعًا يا أتباعي الأعزّاء! رحيل فرانكي’’

37
00:03:15,540 --> 00:03:17,180
!ارتد شيئًا

38
00:03:17,180 --> 00:03:18,100
!أيّها المنحرف

39
00:03:18,100 --> 00:03:20,640
!كيف تجرؤ على تدمير البلدة ثانيةً؟

40
00:03:20,640 --> 00:03:22,230
!ارحل من هنا أيّها المنحرف

41
00:03:22,230 --> 00:03:24,160
!يا عديم النّفع

42
00:03:26,880 --> 00:03:28,570
.أعد إليّ لباس سباحتي يا قبّعة القشّ

43
00:03:29,400 --> 00:03:31,370
!انضمّ لنا إذًا

44
00:03:31,370 --> 00:03:34,160
اعقل! هل تظنّ أنّك ستجعلني أنضمّ لكم

45
00:03:34,160 --> 00:03:37,000
!بمجرّد سرقة لباس سباحتي؟

46
00:03:46,350 --> 00:03:48,130
.لا شيء يؤثّر على الرّجال

47
00:03:48,130 --> 00:03:50,460
،على الرّجل أن يكون واسع الحيلة
.حتّى إن بقي عاريًا

48
00:03:50,460 --> 00:03:53,990
!يجب أن يكون كالأسد الواقف في وجه الأمواج

49
00:03:58,850 --> 00:04:01,520
!اتّخذ وقفته وهو مفضوح تمامًا

50
00:04:01,520 --> 00:04:03,110
!لا تنظري إليه

51
00:04:03,110 --> 00:04:05,650
!إنّه الأسوأ... إنّه الأسوأ

52
00:04:05,650 --> 00:04:09,700
!لقد استهنتُ به
!يا له من شخص قويّ العزيمة

53
00:04:09,700 --> 00:04:12,240
!إنّه رجل من بين الرّجال

54
00:04:12,240 --> 00:04:14,620
!إنّه منحرف فحسب

55
00:04:16,950 --> 00:04:19,580
،إن كان لا بأس باستعمال القوّة معه
.يمكنني مساعدتك

56
00:04:20,070 --> 00:04:21,060
ماذا؟

57
00:04:21,060 --> 00:04:27,730
بالتّفكير في الأمر، قال العمّ أيس
.أنّ لا خيار أمامنا سوى أخذه عنوةً

58
00:04:27,730 --> 00:04:29,010
لكن كيف؟

59
00:04:32,110 --> 00:04:33,970
...زهرتان

60
00:04:43,640 --> 00:04:44,510
ماذا؟

61
00:04:49,760 --> 00:04:50,320
!إمساك

62
00:05:00,080 --> 00:05:01,870
!ماذا؟! انتظري يا روبين

63
00:05:01,870 --> 00:05:04,710
!أمسكتهما! هذا مؤلم

64
00:05:04,710 --> 00:05:08,170
!ستسحقينهما يا روبين

65
00:05:04,710 --> 00:05:08,170
!هذا مؤلم، مؤلم، مؤلم

66
00:05:21,810 --> 00:05:24,270
!سينسلخان

67
00:05:24,270 --> 00:05:26,650
!سينخلعان

68
00:05:27,100 --> 00:05:29,110
!كاليوسفيّ تمامًا

69
00:05:40,620 --> 00:05:44,420
!يا روبين! أريده أن يظلّ رجلاً عندما ينضمّ لنا

70
00:05:44,420 --> 00:05:45,820
!لا تنزعيهما

71
00:05:45,820 --> 00:05:47,630
!مجرّد رؤية ذلك تؤلم

72
00:05:53,040 --> 00:05:56,720
!ما الّذي يجري؟! فرانكي يتألّم

73
00:05:56,720 --> 00:06:00,180
!ما هذا الصّراخ المؤلم؟
!يبدو وكأنّه على عتبة الموت

74
00:06:00,180 --> 00:06:02,260
...أشعر بالأسى عليه نوعًا ما

75
00:06:03,140 --> 00:06:04,390
.مع أنّه منحرف

76
00:06:04,850 --> 00:06:08,660
،إن أخبرتنا نحن القراصنة
،أن نتخلّى عن الكنز الماثل أمامنا

77
00:06:08,660 --> 00:06:12,860
.فلن نتراجع عنه ما لم تمنحنا سببًا وجيهًا

78
00:06:13,650 --> 00:06:15,230
...كـ-كما قلت

79
00:06:18,400 --> 00:06:21,720
!أ-أريد البقاء في هذه الجزيرة فحسب

80
00:06:24,190 --> 00:06:28,840
،أ-أقدّركم فعلاً يا رفاق! بل في الواقع
!لا أستطيع إيفاءكم حقّكم

81
00:06:29,380 --> 00:06:31,640
،أريد الذّهاب معكم ومساعدتكم

82
00:06:31,640 --> 00:06:35,410
.لكن ثمّة ما أحتاج فعله هنا

83
00:06:36,980 --> 00:06:39,680
!لهذا منحتكم السّفينة كهديّة

84
00:06:40,200 --> 00:06:43,280
!كما أنّني ما عدتُ نجّار سفن من الأساس

85
00:06:43,280 --> 00:06:47,990
!لذا تلك السّفينة هي آخر سفينة أبنيها

86
00:06:47,990 --> 00:06:49,150
.كانت رغبتي الّتي اعتززتُ بها طويلاً

87
00:06:49,650 --> 00:06:52,930
!إنّها سفينة أحلام بالفعل

88
00:06:52,930 --> 00:06:54,440
.انتظر يا فرانكي

89
00:06:56,520 --> 00:07:01,490
لا أظنّ أنّ تلك السّفينة أصبحت
.سفينة الأحلام الّتي تقصدها بعد

90
00:07:03,970 --> 00:07:05,720
سفينة أحلام؟

91
00:07:05,720 --> 00:07:10,210
صحيح! لا يمكن للمخطّطات
!وحدها إكمال تلك السّفينة

92
00:07:10,640 --> 00:07:13,650
فبعد أن تُبحر، عليها أن تعبر الكثير من البحار

93
00:07:13,650 --> 00:07:16,170
...وتتغلّب على الكثير من المعارك والصّعاب

94
00:07:17,780 --> 00:07:20,680
،إلى أن تفعل كلّ ذلك وتبلغ نهاية البحر

95
00:07:21,310 --> 00:07:23,690
.فلا يمكنك اعتبارها سفينة أحلام

96
00:07:24,990 --> 00:07:29,520
،وعندما تكتمل سفينة أحلامي يومًا ما

97
00:07:29,520 --> 00:07:32,810
!سأركب تلك السّفينة كنجّارها

98
00:07:32,810 --> 00:07:35,840
.لأشهد ذلك اليوم الموعود

99
00:07:35,840 --> 00:07:38,920
،عند حلول ذلك اليوم
،ستكون السّفينة متداعية على الأغلب

100
00:07:38,920 --> 00:07:43,660
!لكنّي واثق أنّها ستبعث ضوءًا فاخرًا

101
00:07:44,020 --> 00:07:46,210
ما رأيك؟ أليست رائعة يا توم-سان؟

102
00:07:46,210 --> 00:07:47,940
!نعم، هذا رائع

103
00:07:47,940 --> 00:07:51,720
.إن أصبحت بحّارًا أيضًا، ستتغلّب عليّ

104
00:07:53,190 --> 00:07:55,130
.أتساءل إن كنت متأثّرًا بدم القراصنة

105
00:07:55,130 --> 00:07:59,530
معتوه-كي، لا يمكن لشخص مثلك
!التّفوّق على توم-سان

106
00:07:59,530 --> 00:08:00,470
!ماذا قلت؟

107
00:08:00,470 --> 00:08:03,450
!ماذا تفعل يا معتوه-كي؟

108
00:08:03,450 --> 00:08:04,430
.نقيق، نقيق

109
00:08:05,580 --> 00:08:08,800
!حسنًا، إن كنتَ رجلاً، افعل ذلك بعزم

110
00:08:11,930 --> 00:08:14,440
!لقد تغيّر ما أريد فعله

111
00:08:14,440 --> 00:08:17,030
.ما تريد فعله؟ هذا غير صحيح

112
00:08:19,060 --> 00:08:23,280
...كلّ ما تفعله في هذه الجزيرة حاليًّا

113
00:08:25,780 --> 00:08:27,040
.هو التّكفير

114
00:08:32,910 --> 00:08:39,470
ما زلت نادمًا لأنّ توم-سان
.أُخِذ ذلك اليوم بسببك

115
00:08:44,020 --> 00:08:47,430
...لكنّ توم-سان قد سامحك بالفعل ذلك اليوم

116
00:08:48,930 --> 00:08:50,520
.وحاول إرشادك

117
00:08:52,640 --> 00:08:57,590
...سفن قد تفعل شيئًا كذاك
!ما عادت سفني

118
00:09:07,640 --> 00:09:11,160
...توم-سان... ضرب فرانكي للمرّة الأولى

119
00:09:12,080 --> 00:09:13,120
!لم فعلت ذلك؟

120
00:09:16,320 --> 00:09:19,530
أقلت "ما عادت سفني"؟

121
00:09:19,530 --> 00:09:21,760
!قل أيّ شيء إلاّ ذلك

122
00:09:22,470 --> 00:09:26,370
!وما الضّير في قول ذلك؟! لقد ندمتُ على بنائها

123
00:09:27,140 --> 00:09:30,310
!لو أنّني لم أبنها، لما تأذّى أيّ أحد

124
00:09:32,010 --> 00:09:36,700
...أيًّا كان نوع السّفينة، فعملُ بنائها

125
00:09:38,630 --> 00:09:40,910
!لا يعدّ عملاً صالحًا ولا طالحًا

126
00:09:41,940 --> 00:09:45,660
،لا يهمّني أيّ نوعٍ من السّفن قرّرت أن تبني

127
00:09:46,090 --> 00:09:49,830
،لكن حتّى إن قامت تلك السّفن بإيذاء أحدهم

128
00:09:49,830 --> 00:09:51,870
،بل وحتّى إن دمّرت العالم

129
00:09:51,870 --> 00:09:55,580
!على من بناها أن يحبّها على الأقلّ

130
00:09:56,300 --> 00:09:59,520
!لا يجب على من بناها أن يتبرّأ منها

131
00:09:59,520 --> 00:10:01,300
!لا تلم السّفن

132
00:10:01,300 --> 00:10:06,460
!على المرء أن يفخر بعزم... بالسّفن الّتي بناها

133
00:10:08,690 --> 00:10:12,740
...توحيدك للرّعاع في الشّوارع الخلفيّة

134
00:10:13,860 --> 00:10:19,230
تسمية نفسك بصائد مكافآت وحمايتك
...لهذه الجزيرة من اللّصوص

135
00:10:20,020 --> 00:10:23,950
فعلت كلّ ذلك لتحمي مدينة الماء
،هذه الّتي أحبّها توم-سان

136
00:10:23,950 --> 00:10:26,910
...وكانت تلك طريقتك للتّكفير

137
00:10:27,370 --> 00:10:30,830
.مع أنّ الأمر لا يبدو كذلك للآخرين

138
00:10:32,630 --> 00:10:34,910
.بالطّبع لا يبدو كذلك

139
00:10:34,910 --> 00:10:37,460
!ذلك ليس سبب فعلي لكلّ ذلك

140
00:10:37,460 --> 00:10:39,830
!هذا مؤلم، مؤلم، مؤلم

141
00:10:40,800 --> 00:10:43,060
،توقّفت عن بناء السّفن، هوايتك المفضّلة

142
00:10:43,060 --> 00:10:45,070
.وعشتَ قامعًا لنفسك

143
00:10:45,830 --> 00:10:47,930
هل ستعيش هكذا لما بقي من حياتك؟

144
00:10:48,910 --> 00:10:53,410
،حتّى إن سامحك توم-سان، وحتّى إن سامحتُك

145
00:10:53,410 --> 00:10:55,940
لن يتغيّر أيّ شيء، أليس كذلك؟

146
00:10:58,980 --> 00:11:00,230
...ألم يحن الوقت

147
00:11:04,050 --> 00:11:06,830
لتسامح نفسك يا فرانكي؟

148
00:11:14,080 --> 00:11:18,040
ألم يحن الوقت لتبدأ عيش حلمك؟

149
00:11:35,020 --> 00:11:35,770
!ما هذا؟

150
00:11:39,570 --> 00:11:40,770
!حقيبة؟

151
00:11:41,600 --> 00:11:44,330
!فيها ما ستحتاج لرحلتك يا أخي

152
00:11:44,330 --> 00:11:46,180
!ابتعدوا عن الطّريق أيّها الأوغاد

153
00:11:46,180 --> 00:11:47,510
!إنّها عائلة فرانكي

154
00:11:47,510 --> 00:11:49,700
!أخي

155
00:11:51,660 --> 00:11:53,160
...أولئك

156
00:11:56,550 --> 00:12:01,330
!أخي! سامحنا رجاءً على كلّ أفعالنا
!نحن آسفون

157
00:12:01,330 --> 00:12:02,780
!نحن آسفون

158
00:12:02,780 --> 00:12:05,270
!نحن مستعدّون لقبول أيّ عقوبة

159
00:12:05,270 --> 00:12:10,840
!لأنّنا حمقى، نفكّر بقدر عقولنا الصّغيرة

160
00:12:11,620 --> 00:12:15,060
!وكيف تفكّر عقولكم الصّغيرة؟

161
00:12:15,060 --> 00:12:18,470
!كيف تسرقون لباس سباحتي؟

162
00:12:18,470 --> 00:12:22,730
!كيف تجعلونني قرصانًا؟! اهتمّوا بشؤونكم

163
00:12:22,730 --> 00:12:26,190
!إنّها حياتي! لا أحد يقرّرها سواي

164
00:12:27,510 --> 00:12:32,740
كيف لي أنا زعيمكم، أن أسير طوعًا
!في الطّريق الّذي مهّده لي أتباعي؟

165
00:12:32,740 --> 00:12:34,380
!هذا مخزٍ

166
00:12:34,380 --> 00:12:39,010
،إن كانت عقولكم صغيرة
!لا تفكّروا بها من الأساس

167
00:12:39,010 --> 00:12:41,920
...آ-آسف. لكن

168
00:12:42,650 --> 00:12:45,440
ألا يحقّ لنا حتّى أن نفكّر قليلاً؟

169
00:12:45,440 --> 00:12:49,630
.نحن مدينون لك جدًّا لأنّك أويت جانحين مثلنا

170
00:12:49,630 --> 00:12:54,220
!ألا يحقّ لنا حتّى التّفكير في سعادتك؟

171
00:13:01,060 --> 00:13:03,560
من الأحمق هنا؟

172
00:13:04,570 --> 00:13:07,530
...أنتم جميعًا

173
00:13:07,530 --> 00:13:10,880
!هذا مؤلم، مؤلم، مؤلم، مؤلم

174
00:13:12,030 --> 00:13:13,660
!أ-أخي

175
00:13:12,700 --> 00:13:15,160
!هذا مؤلم، مؤلم، مؤلم

176
00:13:16,990 --> 00:13:18,740
!يا روبين

177
00:13:16,990 --> 00:13:21,000
...هذا مؤلم، مؤلم، مؤلم

178
00:13:18,740 --> 00:13:22,460
!هوّني عليه! رجاءً! ستجعلين منه امرأةً

179
00:13:22,460 --> 00:13:23,960
!إنّه يبكي

180
00:13:23,960 --> 00:13:26,340
!ستنسلخان

181
00:13:26,760 --> 00:13:28,800
!ستُخلعان

182
00:13:29,200 --> 00:13:31,260
!كالعنب تمامًا

183
00:13:31,990 --> 00:13:34,470
!آهٍ يا عنبي

184
00:13:35,590 --> 00:13:40,180
!عليك اللّعنة يا نيكو روبين
!لن تفلتي بفعلتك هذه

185
00:13:40,180 --> 00:13:42,690
!ستنسلخان

186
00:13:42,690 --> 00:13:45,150
!ستُخلعان

187
00:13:45,150 --> 00:13:47,610
!كالتّفاح تمامًا

188
00:13:47,610 --> 00:13:49,110
...آهٍ يا تفّاحي

189
00:13:54,300 --> 00:13:57,610
!دموعي لا تكفّ عن النّزول من شدّة الألم

190
00:13:57,610 --> 00:13:58,420
!روبين

191
00:14:00,020 --> 00:14:02,790
مـ-ماذا؟ ألا تفعلين أيّ شيء؟

192
00:14:04,660 --> 00:14:08,310
.فعلت مرّةً فحسب، في المرّة الأولى

193
00:14:09,460 --> 00:14:12,800
.يا لسخفه لأن يدّعي أنّه يبكي من الألم

194
00:14:14,270 --> 00:14:15,710
مرّةً فحسب؟

195
00:14:16,590 --> 00:14:19,160
!سحقًا! هذا مؤلم، مؤلم، مؤلم

196
00:14:19,160 --> 00:14:20,310
...مؤلم، مؤلم، مؤلم، مؤلم

197
00:14:20,310 --> 00:14:24,370
!لا أستطيع التّوقّف عن البكاء من شدّة الألم

198
00:14:47,080 --> 00:14:49,130
!ألم تجدوهم بعد؟

199
00:14:49,130 --> 00:14:52,550
!لا تدعوهم يهربون مهما كان
!ابحثوا في كلّ شبر عنهم

200
00:14:55,510 --> 00:15:00,510
!هذا مؤلم! هذا مؤلم
!لا أستطيع التّوقّف عن البكاء

201
00:15:00,510 --> 00:15:02,910
!أخي

202
00:15:03,900 --> 00:15:05,940
!هل أنت بخير؟

203
00:15:07,440 --> 00:15:10,230
!كيف لي أن أكون بخير؟

204
00:15:10,970 --> 00:15:15,700
.لم أرك في الجوار من قبل
ما بالك يا صاحب البكيني؟

205
00:15:15,700 --> 00:15:19,110
.لا تغترّ بنفسك كثيرًا في هذه الشّوارع الخلفيّة

206
00:15:22,510 --> 00:15:24,040
!نالوا منه

207
00:15:38,970 --> 00:15:40,890
!مـ-ماذا؟

208
00:15:43,590 --> 00:15:45,680
!كيف تجرؤ على السّخريّة منّا؟

209
00:15:50,980 --> 00:15:55,690
أنت قويّ للغاية. إنّك تهدر
.تلك القوّة بكونك جانحًا

210
00:15:56,380 --> 00:15:58,610
!مـ-من أنت؟

211
00:16:01,170 --> 00:16:02,030
!زامباي

212
00:16:03,980 --> 00:16:09,950
أنا فرانكي. قرّرتُ أن أجعل من شوارع
.ووتر سيفن الخلفيّة ملعبي

213
00:16:09,950 --> 00:16:11,040
!سعيد للقائكم

214
00:16:12,020 --> 00:16:13,000
.حـ-حاضر

215
00:16:13,610 --> 00:16:15,960
...هذا مؤلم، مؤلم، مؤلم، مؤلم

216
00:16:15,960 --> 00:16:18,590
!أخي

217
00:16:20,360 --> 00:16:23,050
!يا له من شعور رائع

218
00:16:25,500 --> 00:16:27,320
!لنذهب لحانة أخرى

219
00:16:28,230 --> 00:16:31,030
!أنت يا صاحب البكيني الأنيق

220
00:16:31,030 --> 00:16:33,450
.لنحتس شرابًا معًا

221
00:16:33,450 --> 00:16:36,190
.سنأخذك إلى الحانة

222
00:16:40,720 --> 00:16:42,420
!مـ-ماذا تفعل؟

223
00:16:42,420 --> 00:16:43,740
!أفلتنا

224
00:16:43,740 --> 00:16:47,980
أيّتها الآنستان اليافعتان، لا تقبلا
!الشّراب من الآخرين في وضح النّهار

225
00:16:50,110 --> 00:16:52,960
!أعرف مكانًا يقدّم كولا جيّدة

226
00:16:53,850 --> 00:16:55,790
لِمَ لا تأتيان معي؟

227
00:16:55,790 --> 00:16:59,760
!أخي! أخي

228
00:17:06,910 --> 00:17:09,640
.أ-أعطني شيئًا آكله

229
00:17:10,950 --> 00:17:14,190
!أحضر كلّ من لا يملك ما يأكله

230
00:17:21,110 --> 00:17:23,560
!جنّوا كما تشاؤون

231
00:17:23,560 --> 00:17:26,080
!سنؤسّس عائلة فرانكي

232
00:17:26,080 --> 00:17:28,550
!أجل

233
00:17:28,550 --> 00:17:33,000
!إنّها بدايتنا

234
00:17:33,000 --> 00:17:38,840
!نحن عائلة فرانكي

235
00:17:38,840 --> 00:17:40,800
!مرحى

236
00:17:44,760 --> 00:17:56,730
!فرانكي! فرانكي! فرانكي

237
00:18:03,250 --> 00:18:08,180
!هل يمكنكم... أن تعيشوا من دوني؟

238
00:18:08,180 --> 00:18:09,660
...أخي

239
00:18:10,180 --> 00:18:12,590
...وجه عالم ووتر سيفن المظلم

240
00:18:12,590 --> 00:18:16,730
!سنعمل سويًّا لتولّي ذلك الدّور بشكل رائع

241
00:18:16,730 --> 00:18:18,080
!لذا لا تقلق

242
00:18:18,080 --> 00:18:19,670
!لا تبك يا أخي

243
00:18:19,670 --> 00:18:20,640
!أخي

244
00:18:20,640 --> 00:18:23,610
،مهما ابتعدت

245
00:18:23,610 --> 00:18:27,120
!سنظلّ أتباعك لبقيّة حياتنا

246
00:18:27,120 --> 00:18:28,640
!أخي

247
00:18:29,910 --> 00:18:32,270
...هذا مؤلم، مؤلم، مؤلم

248
00:18:33,400 --> 00:18:35,140
!لا أستطيع الكفّ عن البكاء

249
00:18:38,520 --> 00:18:39,770
!أسرع

250
00:18:39,770 --> 00:18:40,980
.هذا ليس جيّدًا

251
00:18:41,780 --> 00:18:42,900
!لوفي

252
00:18:45,390 --> 00:18:47,360
!زورو! سانجي

253
00:18:48,240 --> 00:18:49,370
!مصيبة

254
00:18:49,800 --> 00:18:52,950
!عاد جدّك يا لوفي

255
00:18:52,950 --> 00:18:54,350
.إنّهم في السّاحل المقابل

256
00:18:54,350 --> 00:18:57,080
!إنّهم يبحثون عنّا الآن! سيهاجموننا

257
00:18:57,080 --> 00:19:01,040
.ماذا؟! لماذا؟! قال أنّه لن يقبض علينا

258
00:19:01,670 --> 00:19:04,920
!وما أدرانا؟! استعدّوا للإبحار بسرعة

259
00:19:07,330 --> 00:19:10,140
!فرانكي! ألم ترتدِ لباس سباحتك بعد؟

260
00:19:14,030 --> 00:19:14,850
!سأعيده لك

261
00:19:23,170 --> 00:19:25,530
...والآن، اركب معنا يا فرانكي

262
00:19:26,340 --> 00:19:27,820
.اركب سفينتي

263
00:19:29,950 --> 00:19:32,540
!لا تعتدّ بنفسك

264
00:19:32,540 --> 00:19:35,780
أنتم هوّاة تمامًا بالكاد تستطيعون
!تدبّر التّرقيعات المؤقّتة

265
00:19:35,780 --> 00:19:41,500
سيكون من المؤسف ألاّ تملك هذه
.السّفينة العظيمة نجّار سفن على متنها

266
00:19:41,830 --> 00:19:44,590
!أظنّني لا أملك خيارًا عدا مساعدتكم

267
00:19:44,590 --> 00:19:49,220
!أنا فرانكي، سأكون نجّار سفينتكم

268
00:19:49,620 --> 00:19:52,680
!حسنًا! لدينا عضوًا جديدًا في طاقمنا

269
00:19:52,680 --> 00:19:55,220
!مرحى! أجل

270
00:19:58,630 --> 00:19:59,940
!...أخي

271
00:20:00,470 --> 00:20:01,940
!لا تبك! لا تبك

272
00:20:02,510 --> 00:20:05,400
!قبّعة القشّ رجلٌ يستحقّ ثقتنا

273
00:20:13,640 --> 00:20:17,930
.توم-سان... إنّي مغادرٌ هذه الجزيرة

274
00:20:19,330 --> 00:20:21,830
اسمع، علّمني كيف أرسم المخطّطات
!من أجل سفينة القراصنة أيضًا

275
00:20:25,020 --> 00:20:26,670
ما المضحك؟

276
00:20:31,170 --> 00:20:32,970
ألن تأوي إلى الفراش بعد يا توم-سان؟

277
00:20:33,690 --> 00:20:34,930
ما الّذي ترسمه؟

278
00:20:34,930 --> 00:20:38,390
.لنرَ... إنّه أمل هذه الجزيرة

279
00:20:39,270 --> 00:20:40,270
أمل؟

280
00:20:40,750 --> 00:20:44,730
لم أكن تلميذًا جيّدًا. لم أسبّب لك
...سوى المتاعب، لكن

281
00:20:45,130 --> 00:20:48,510
!هل سمعتم عن جزيرة الخردة؟

282
00:20:48,510 --> 00:20:52,030
!أقلت أنّ عمّال توم انتهوا من بناء القطار البحريّ؟

283
00:20:53,030 --> 00:20:55,990
!شكرًا لك على كلّ شيء

284
00:21:21,120 --> 00:21:23,730
...يا رؤساء عمّال غالي-لا

285
00:21:24,480 --> 00:21:26,690
!اعتنوا بأيسبرغ جيّدًا

286
00:21:27,160 --> 00:21:30,650
لم أسبّب لك سوى المتاعب
.أنت الآخر يا أيسبرغ

287
00:21:31,850 --> 00:21:34,660
...العجوز كوكورو، الصّغيرة والأرنب

288
00:21:34,660 --> 00:21:36,000
...نقيق

289
00:21:36,000 --> 00:21:37,120
...يوكوزونا

290
00:21:37,510 --> 00:21:38,490
!أيّها المنحرف

291
00:21:38,490 --> 00:21:39,900
...سكّان البلدة الحيّويّين

292
00:21:38,490 --> 00:21:39,900
!إلى أين أنت ذاهب؟

293
00:21:39,900 --> 00:21:41,080
!ستعود، أليس كذلك؟

294
00:21:41,800 --> 00:21:42,990
...أختاي الصّغيرتان

295
00:21:46,100 --> 00:21:48,500
...سودوم... غومورا

296
00:21:49,460 --> 00:21:53,470
...و... أتباعي الأعزّاء

297
00:22:16,520 --> 00:22:19,770
!سأخرج قليلاً

298
00:22:24,190 --> 00:22:26,000
.ارتد لباس سباحتك

299
00:22:31,160 --> 00:22:34,380
!ماذا؟! أوسوبّ سيعود؟

300
00:22:34,380 --> 00:22:36,050
!حقًّا؟! نعم

301
00:22:36,050 --> 00:22:38,100
!حسنًا إذًا! لنذهب لأخذه على الفور

302
00:22:38,100 --> 00:22:39,280
!انتظروا يا رفاق

303
00:22:40,090 --> 00:22:44,980
.لن أسمح لأيّ منّا بالذّهاب وأخذه

304
00:22:44,980 --> 00:22:46,650
:في الحلقة القادمة من وان بيس

305
00:22:46,650 --> 00:22:50,750
!مغادرة مدينة الماء"
"!يضع الرّجل أوسوبّ خاتمة للنّزال

306
00:22:50,750 --> 00:22:53,340
!ملك القراصنة، لن يكون إلاّ أنا

307
00:22:55,990 --> 00:23:01,000
نلقاكم في الحلقة القادمة