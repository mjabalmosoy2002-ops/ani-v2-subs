1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:42,590 --> 00:02:47,220
...إن كنت تنوي أخذه معكم حقًّا

33
00:02:47,700 --> 00:02:49,230
.فخذه مهما تطلّب الأمر

34
00:02:49,640 --> 00:02:51,480
!خذه بالقوّة

35
00:02:51,480 --> 00:02:55,270
!تلك هي الطّريقة الوحيدة لتحريره

36
00:02:57,780 --> 00:03:02,530
‘‘!وداعًا يا أتباعي الأعزّاء! رحيل فرانكي’’

37
00:03:29,540 --> 00:03:31,180
!ارتد شيئًا

38
00:03:31,180 --> 00:03:32,100
!أيّها المنحرف

39
00:03:32,100 --> 00:03:34,640
!كيف تجرؤ على تدمير البلدة ثانيةً؟

40
00:03:34,640 --> 00:03:36,230
!ارحل من هنا أيّها المنحرف

41
00:03:36,230 --> 00:03:38,160
!يا عديم النّفع

42
00:03:40,880 --> 00:03:42,570
.أعد إليّ لباس سباحتي يا قبّعة القشّ

43
00:03:43,400 --> 00:03:45,370
!انضمّ لنا إذًا

44
00:03:45,370 --> 00:03:48,160
اعقل! هل تظنّ أنّك ستجعلني أنضمّ لكم

45
00:03:48,160 --> 00:03:51,000
!بمجرّد سرقة لباس سباحتي؟

46
00:04:00,350 --> 00:04:02,130
.لا شيء يؤثّر على الرّجال

47
00:04:02,130 --> 00:04:04,460
،على الرّجل أن يكون واسع الحيلة
.حتّى إن بقي عاريًا

48
00:04:04,460 --> 00:04:07,990
!يجب أن يكون كالأسد الواقف في وجه الأمواج

49
00:04:12,850 --> 00:04:15,520
!اتّخذ وقفته وهو مفضوح تمامًا

50
00:04:15,520 --> 00:04:17,110
!لا تنظري إليه

51
00:04:17,110 --> 00:04:19,650
!إنّه الأسوأ... إنّه الأسوأ

52
00:04:19,650 --> 00:04:23,700
!لقد استهنتُ به
!يا له من شخص قويّ العزيمة

53
00:04:23,700 --> 00:04:26,240
!إنّه رجل من بين الرّجال

54
00:04:26,240 --> 00:04:28,620
!إنّه منحرف فحسب

55
00:04:30,950 --> 00:04:33,580
،إن كان لا بأس باستعمال القوّة معه
.يمكنني مساعدتك

56
00:04:34,070 --> 00:04:35,060
ماذا؟

57
00:04:35,060 --> 00:04:41,730
بالتّفكير في الأمر، قال العمّ أيس
.أنّ لا خيار أمامنا سوى أخذه عنوةً

58
00:04:41,730 --> 00:04:43,010
لكن كيف؟

59
00:04:46,110 --> 00:04:47,970
...زهرتان

60
00:04:57,640 --> 00:04:58,510
ماذا؟

61
00:05:03,760 --> 00:05:04,320
!إمساك

62
00:05:14,080 --> 00:05:15,870
!ماذا؟! انتظري يا روبين

63
00:05:15,870 --> 00:05:18,710
!أمسكتهما! هذا مؤلم

64
00:05:18,710 --> 00:05:22,170
!ستسحقينهما يا روبين

65
00:05:18,710 --> 00:05:22,170
!هذا مؤلم، مؤلم، مؤلم

66
00:05:35,810 --> 00:05:38,270
!سينسلخان

67
00:05:38,270 --> 00:05:40,650
!سينخلعان

68
00:05:41,100 --> 00:05:43,110
!كاليوسفيّ تمامًا

69
00:05:54,620 --> 00:05:58,420
!يا روبين! أريده أن يظلّ رجلاً عندما ينضمّ لنا

70
00:05:58,420 --> 00:05:59,820
!لا تنزعيهما

71
00:05:59,820 --> 00:06:01,630
!مجرّد رؤية ذلك تؤلم

72
00:06:07,040 --> 00:06:10,720
!ما الّذي يجري؟! فرانكي يتألّم

73
00:06:10,720 --> 00:06:14,180
!ما هذا الصّراخ المؤلم؟
!يبدو وكأنّه على عتبة الموت

74
00:06:14,180 --> 00:06:16,260
...أشعر بالأسى عليه نوعًا ما

75
00:06:17,140 --> 00:06:18,390
.مع أنّه منحرف

76
00:06:18,850 --> 00:06:22,660
،إن أخبرتنا نحن القراصنة
،أن نتخلّى عن الكنز الماثل أمامنا

77
00:06:22,660 --> 00:06:26,860
.فلن نتراجع عنه ما لم تمنحنا سببًا وجيهًا

78
00:06:27,650 --> 00:06:29,230
...كـ-كما قلت

79
00:06:32,400 --> 00:06:35,720
!أ-أريد البقاء في هذه الجزيرة فحسب

80
00:06:38,190 --> 00:06:42,840
،أ-أقدّركم فعلاً يا رفاق! بل في الواقع
!لا أستطيع إيفاءكم حقّكم

81
00:06:43,380 --> 00:06:45,640
،أريد الذّهاب معكم ومساعدتكم

82
00:06:45,640 --> 00:06:49,410
.لكن ثمّة ما أحتاج فعله هنا

83
00:06:50,980 --> 00:06:53,680
!لهذا منحتكم السّفينة كهديّة

84
00:06:54,200 --> 00:06:57,280
!كما أنّني ما عدتُ نجّار سفن من الأساس

85
00:06:57,280 --> 00:07:01,990
!لذا تلك السّفينة هي آخر سفينة أبنيها

86
00:07:01,990 --> 00:07:03,150
.كانت رغبتي الّتي اعتززتُ بها طويلاً

87
00:07:03,650 --> 00:07:06,930
!إنّها سفينة أحلام بالفعل

88
00:07:06,930 --> 00:07:08,440
.انتظر يا فرانكي

89
00:07:10,520 --> 00:07:15,490
لا أظنّ أنّ تلك السّفينة أصبحت
.سفينة الأحلام الّتي تقصدها بعد

90
00:07:17,970 --> 00:07:19,720
سفينة أحلام؟

91
00:07:19,720 --> 00:07:24,210
صحيح! لا يمكن للمخطّطات
!وحدها إكمال تلك السّفينة

92
00:07:24,640 --> 00:07:27,650
فبعد أن تُبحر، عليها أن تعبر الكثير من البحار

93
00:07:27,650 --> 00:07:30,170
...وتتغلّب على الكثير من المعارك والصّعاب

94
00:07:31,780 --> 00:07:34,680
،إلى أن تفعل كلّ ذلك وتبلغ نهاية البحر

95
00:07:35,310 --> 00:07:37,690
.فلا يمكنك اعتبارها سفينة أحلام

96
00:07:38,990 --> 00:07:43,520
،وعندما تكتمل سفينة أحلامي يومًا ما

97
00:07:43,520 --> 00:07:46,810
!سأركب تلك السّفينة كنجّارها

98
00:07:46,810 --> 00:07:49,840
.لأشهد ذلك اليوم الموعود

99
00:07:49,840 --> 00:07:52,920
،عند حلول ذلك اليوم
،ستكون السّفينة متداعية على الأغلب

100
00:07:52,920 --> 00:07:57,660
!لكنّي واثق أنّها ستبعث ضوءًا فاخرًا

101
00:07:58,020 --> 00:08:00,210
ما رأيك؟ أليست رائعة يا توم-سان؟

102
00:08:00,210 --> 00:08:01,940
!نعم، هذا رائع

103
00:08:01,940 --> 00:08:05,720
.إن أصبحت بحّارًا أيضًا، ستتغلّب عليّ

104
00:08:07,190 --> 00:08:09,130
.أتساءل إن كنت متأثّرًا بدم القراصنة

105
00:08:09,130 --> 00:08:13,530
معتوه-كي، لا يمكن لشخص مثلك
!التّفوّق على توم-سان

106
00:08:13,530 --> 00:08:14,470
!ماذا قلت؟

107
00:08:14,470 --> 00:08:17,450
!ماذا تفعل يا معتوه-كي؟

108
00:08:17,450 --> 00:08:18,430
.نقيق، نقيق

109
00:08:19,580 --> 00:08:22,800
!حسنًا، إن كنتَ رجلاً، افعل ذلك بعزم

110
00:08:25,930 --> 00:08:28,440
!لقد تغيّر ما أريد فعله

111
00:08:28,440 --> 00:08:31,030
.ما تريد فعله؟ هذا غير صحيح

112
00:08:33,060 --> 00:08:37,280
...كلّ ما تفعله في هذه الجزيرة حاليًّا

113
00:08:39,780 --> 00:08:41,040
.هو التّكفير

114
00:08:46,910 --> 00:08:53,470
ما زلت نادمًا لأنّ توم-سان
.أُخِذ ذلك اليوم بسببك

115
00:08:58,020 --> 00:09:01,430
...لكنّ توم-سان قد سامحك بالفعل ذلك اليوم

116
00:09:02,930 --> 00:09:04,520
.وحاول إرشادك

117
00:09:06,640 --> 00:09:11,590
...سفن قد تفعل شيئًا كذاك
!ما عادت سفني

118
00:09:21,640 --> 00:09:25,160
...توم-سان... ضرب فرانكي للمرّة الأولى

119
00:09:26,080 --> 00:09:27,120
!لم فعلت ذلك؟

120
00:09:30,320 --> 00:09:33,530
أقلت "ما عادت سفني"؟

121
00:09:33,530 --> 00:09:35,760
!قل أيّ شيء إلاّ ذلك

122
00:09:36,470 --> 00:09:40,370
!وما الضّير في قول ذلك؟! لقد ندمتُ على بنائها

123
00:09:41,140 --> 00:09:44,310
!لو أنّني لم أبنها، لما تأذّى أيّ أحد

124
00:09:46,010 --> 00:09:50,700
...أيًّا كان نوع السّفينة، فعملُ بنائها

125
00:09:52,630 --> 00:09:54,910
!لا يعدّ عملاً صالحًا ولا طالحًا

126
00:09:55,940 --> 00:09:59,660
،لا يهمّني أيّ نوعٍ من السّفن قرّرت أن تبني

127
00:10:00,090 --> 00:10:03,830
،لكن حتّى إن قامت تلك السّفن بإيذاء أحدهم

128
00:10:03,830 --> 00:10:05,870
،بل وحتّى إن دمّرت العالم

129
00:10:05,870 --> 00:10:09,580
!على من بناها أن يحبّها على الأقلّ

130
00:10:10,300 --> 00:10:13,520
!لا يجب على من بناها أن يتبرّأ منها

131
00:10:13,520 --> 00:10:15,300
!لا تلم السّفن

132
00:10:15,300 --> 00:10:20,460
!على المرء أن يفخر بعزم... بالسّفن الّتي بناها

133
00:10:22,690 --> 00:10:26,740
...توحيدك للرّعاع في الشّوارع الخلفيّة

134
00:10:27,860 --> 00:10:33,230
تسمية نفسك بصائد مكافآت وحمايتك
...لهذه الجزيرة من اللّصوص

135
00:10:34,020 --> 00:10:37,950
فعلت كلّ ذلك لتحمي مدينة الماء
،هذه الّتي أحبّها توم-سان

136
00:10:37,950 --> 00:10:40,910
...وكانت تلك طريقتك للتّكفير

137
00:10:41,370 --> 00:10:44,830
.مع أنّ الأمر لا يبدو كذلك للآخرين

138
00:10:46,630 --> 00:10:48,910
.بالطّبع لا يبدو كذلك

139
00:10:48,910 --> 00:10:51,460
!ذلك ليس سبب فعلي لكلّ ذلك

140
00:10:51,460 --> 00:10:53,830
!هذا مؤلم، مؤلم، مؤلم

141
00:10:54,800 --> 00:10:57,060
،توقّفت عن بناء السّفن، هوايتك المفضّلة

142
00:10:57,060 --> 00:10:59,070
.وعشتَ قامعًا لنفسك

143
00:10:59,830 --> 00:11:01,930
هل ستعيش هكذا لما بقي من حياتك؟

144
00:11:02,910 --> 00:11:07,410
،حتّى إن سامحك توم-سان، وحتّى إن سامحتُك

145
00:11:07,410 --> 00:11:09,940
لن يتغيّر أيّ شيء، أليس كذلك؟

146
00:11:12,980 --> 00:11:14,230
...ألم يحن الوقت

147
00:11:18,050 --> 00:11:20,830
لتسامح نفسك يا فرانكي؟

148
00:11:28,080 --> 00:11:32,040
ألم يحن الوقت لتبدأ عيش حلمك؟

149
00:11:49,020 --> 00:11:49,770
!ما هذا؟

150
00:11:53,570 --> 00:11:54,770
!حقيبة؟

151
00:11:55,600 --> 00:11:58,330
!فيها ما ستحتاج لرحلتك يا أخي

152
00:11:58,330 --> 00:12:00,180
!ابتعدوا عن الطّريق أيّها الأوغاد

153
00:12:00,180 --> 00:12:01,510
!إنّها عائلة فرانكي

154
00:12:01,510 --> 00:12:03,700
!أخي

155
00:12:05,660 --> 00:12:07,160
...أولئك

156
00:12:10,550 --> 00:12:15,330
!أخي! سامحنا رجاءً على كلّ أفعالنا
!نحن آسفون

157
00:12:15,330 --> 00:12:16,780
!نحن آسفون

158
00:12:16,780 --> 00:12:19,270
!نحن مستعدّون لقبول أيّ عقوبة

159
00:12:19,270 --> 00:12:24,840
!لأنّنا حمقى، نفكّر بقدر عقولنا الصّغيرة

160
00:12:25,620 --> 00:12:29,060
!وكيف تفكّر عقولكم الصّغيرة؟

161
00:12:29,060 --> 00:12:32,470
!كيف تسرقون لباس سباحتي؟

162
00:12:32,470 --> 00:12:36,730
!كيف تجعلونني قرصانًا؟! اهتمّوا بشؤونكم

163
00:12:36,730 --> 00:12:40,190
!إنّها حياتي! لا أحد يقرّرها سواي

164
00:12:41,510 --> 00:12:46,740
كيف لي أنا زعيمكم، أن أسير طوعًا
!في الطّريق الّذي مهّده لي أتباعي؟

165
00:12:46,740 --> 00:12:48,380
!هذا مخزٍ

166
00:12:48,380 --> 00:12:53,010
،إن كانت عقولكم صغيرة
!لا تفكّروا بها من الأساس

167
00:12:53,010 --> 00:12:55,920
...آ-آسف. لكن

168
00:12:56,650 --> 00:12:59,440
ألا يحقّ لنا حتّى أن نفكّر قليلاً؟

169
00:12:59,440 --> 00:13:03,630
.نحن مدينون لك جدًّا لأنّك أويت جانحين مثلنا

170
00:13:03,630 --> 00:13:08,220
!ألا يحقّ لنا حتّى التّفكير في سعادتك؟

171
00:13:15,060 --> 00:13:17,560
من الأحمق هنا؟

172
00:13:18,570 --> 00:13:21,530
...أنتم جميعًا

173
00:13:21,530 --> 00:13:24,880
!هذا مؤلم، مؤلم، مؤلم، مؤلم

174
00:13:26,030 --> 00:13:27,660
!أ-أخي

175
00:13:26,700 --> 00:13:29,160
!هذا مؤلم، مؤلم، مؤلم

176
00:13:30,990 --> 00:13:32,740
!يا روبين

177
00:13:30,990 --> 00:13:35,000
...هذا مؤلم، مؤلم، مؤلم

178
00:13:32,740 --> 00:13:36,460
!هوّني عليه! رجاءً! ستجعلين منه امرأةً

179
00:13:36,460 --> 00:13:37,960
!إنّه يبكي

180
00:13:37,960 --> 00:13:40,340
!ستنسلخان

181
00:13:40,760 --> 00:13:42,800
!ستُخلعان

182
00:13:43,200 --> 00:13:45,260
!كالعنب تمامًا

183
00:13:45,990 --> 00:13:48,470
!آهٍ يا عنبي

184
00:13:49,590 --> 00:13:54,180
!عليك اللّعنة يا نيكو روبين
!لن تفلتي بفعلتك هذه

185
00:13:54,180 --> 00:13:56,690
!ستنسلخان

186
00:13:56,690 --> 00:13:59,150
!ستُخلعان

187
00:13:59,150 --> 00:14:01,610
!كالتّفاح تمامًا

188
00:14:01,610 --> 00:14:03,110
...آهٍ يا تفّاحي

189
00:14:08,300 --> 00:14:11,610
!دموعي لا تكفّ عن النّزول من شدّة الألم

190
00:14:11,610 --> 00:14:12,420
!روبين

191
00:14:14,020 --> 00:14:16,790
مـ-ماذا؟ ألا تفعلين أيّ شيء؟

192
00:14:18,660 --> 00:14:22,310
.فعلت مرّةً فحسب، في المرّة الأولى

193
00:14:23,460 --> 00:14:26,800
.يا لسخفه لأن يدّعي أنّه يبكي من الألم

194
00:14:28,270 --> 00:14:29,710
مرّةً فحسب؟

195
00:14:30,590 --> 00:14:33,160
!سحقًا! هذا مؤلم، مؤلم، مؤلم

196
00:14:33,160 --> 00:14:34,310
...مؤلم، مؤلم، مؤلم، مؤلم

197
00:14:34,310 --> 00:14:38,370
!لا أستطيع التّوقّف عن البكاء من شدّة الألم

198
00:15:01,080 --> 00:15:03,130
!ألم تجدوهم بعد؟

199
00:15:03,130 --> 00:15:06,550
!لا تدعوهم يهربون مهما كان
!ابحثوا في كلّ شبر عنهم

200
00:15:09,510 --> 00:15:14,510
!هذا مؤلم! هذا مؤلم
!لا أستطيع التّوقّف عن البكاء

201
00:15:14,510 --> 00:15:16,910
!أخي

202
00:15:17,900 --> 00:15:19,940
!هل أنت بخير؟

203
00:15:21,440 --> 00:15:24,230
!كيف لي أن أكون بخير؟

204
00:15:24,970 --> 00:15:29,700
.لم أرك في الجوار من قبل
ما بالك يا صاحب البكيني؟

205
00:15:29,700 --> 00:15:33,110
.لا تغترّ بنفسك كثيرًا في هذه الشّوارع الخلفيّة

206
00:15:36,510 --> 00:15:38,040
!نالوا منه

207
00:15:52,970 --> 00:15:54,890
!مـ-ماذا؟

208
00:15:57,590 --> 00:15:59,680
!كيف تجرؤ على السّخريّة منّا؟

209
00:16:04,980 --> 00:16:09,690
أنت قويّ للغاية. إنّك تهدر
.تلك القوّة بكونك جانحًا

210
00:16:10,380 --> 00:16:12,610
!مـ-من أنت؟

211
00:16:15,170 --> 00:16:16,030
!زامباي

212
00:16:17,980 --> 00:16:23,950
أنا فرانكي. قرّرتُ أن أجعل من شوارع
.ووتر سيفن الخلفيّة ملعبي

213
00:16:23,950 --> 00:16:25,040
!سعيد للقائكم

214
00:16:26,020 --> 00:16:27,000
.حـ-حاضر

215
00:16:27,610 --> 00:16:29,960
...هذا مؤلم، مؤلم، مؤلم، مؤلم

216
00:16:29,960 --> 00:16:32,590
!أخي

217
00:16:34,360 --> 00:16:37,050
!يا له من شعور رائع

218
00:16:39,500 --> 00:16:41,320
!لنذهب لحانة أخرى

219
00:16:42,230 --> 00:16:45,030
!أنت يا صاحب البكيني الأنيق

220
00:16:45,030 --> 00:16:47,450
.لنحتس شرابًا معًا

221
00:16:47,450 --> 00:16:50,190
.سنأخذك إلى الحانة

222
00:16:54,720 --> 00:16:56,420
!مـ-ماذا تفعل؟

223
00:16:56,420 --> 00:16:57,740
!أفلتنا

224
00:16:57,740 --> 00:17:01,980
أيّتها الآنستان اليافعتان، لا تقبلا
!الشّراب من الآخرين في وضح النّهار

225
00:17:04,110 --> 00:17:06,960
!أعرف مكانًا يقدّم كولا جيّدة

226
00:17:07,850 --> 00:17:09,790
لِمَ لا تأتيان معي؟

227
00:17:09,790 --> 00:17:13,760
!أخي! أخي

228
00:17:20,910 --> 00:17:23,640
.أ-أعطني شيئًا آكله

229
00:17:24,950 --> 00:17:28,190
!أحضر كلّ من لا يملك ما يأكله

230
00:17:35,110 --> 00:17:37,560
!جنّوا كما تشاؤون

231
00:17:37,560 --> 00:17:40,080
!سنؤسّس عائلة فرانكي

232
00:17:40,080 --> 00:17:42,550
!أجل

233
00:17:42,550 --> 00:17:47,000
!إنّها بدايتنا

234
00:17:47,000 --> 00:17:52,840
!نحن عائلة فرانكي

235
00:17:52,840 --> 00:17:54,800
!مرحى

236
00:17:58,760 --> 00:18:10,730
!فرانكي! فرانكي! فرانكي

237
00:18:17,250 --> 00:18:22,180
!هل يمكنكم... أن تعيشوا من دوني؟

238
00:18:22,180 --> 00:18:23,660
...أخي

239
00:18:24,180 --> 00:18:26,590
...وجه عالم ووتر سيفن المظلم

240
00:18:26,590 --> 00:18:30,730
!سنعمل سويًّا لتولّي ذلك الدّور بشكل رائع

241
00:18:30,730 --> 00:18:32,080
!لذا لا تقلق

242
00:18:32,080 --> 00:18:33,670
!لا تبك يا أخي

243
00:18:33,670 --> 00:18:34,640
!أخي

244
00:18:34,640 --> 00:18:37,610
،مهما ابتعدت

245
00:18:37,610 --> 00:18:41,120
!سنظلّ أتباعك لبقيّة حياتنا

246
00:18:41,120 --> 00:18:42,640
!أخي

247
00:18:43,910 --> 00:18:46,270
...هذا مؤلم، مؤلم، مؤلم

248
00:18:47,400 --> 00:18:49,140
!لا أستطيع الكفّ عن البكاء

249
00:18:52,520 --> 00:18:53,770
!أسرع

250
00:18:53,770 --> 00:18:54,980
.هذا ليس جيّدًا

251
00:18:55,780 --> 00:18:56,900
!لوفي

252
00:18:59,390 --> 00:19:01,360
!زورو! سانجي

253
00:19:02,240 --> 00:19:03,370
!مصيبة

254
00:19:03,800 --> 00:19:06,950
!عاد جدّك يا لوفي

255
00:19:06,950 --> 00:19:08,350
.إنّهم في السّاحل المقابل

256
00:19:08,350 --> 00:19:11,080
!إنّهم يبحثون عنّا الآن! سيهاجموننا

257
00:19:11,080 --> 00:19:15,040
.ماذا؟! لماذا؟! قال أنّه لن يقبض علينا

258
00:19:15,670 --> 00:19:18,920
!وما أدرانا؟! استعدّوا للإبحار بسرعة

259
00:19:21,330 --> 00:19:24,140
!فرانكي! ألم ترتدِ لباس سباحتك بعد؟

260
00:19:28,030 --> 00:19:28,850
!سأعيده لك

261
00:19:37,170 --> 00:19:39,530
...والآن، اركب معنا يا فرانكي

262
00:19:40,340 --> 00:19:41,820
.اركب سفينتي

263
00:19:43,950 --> 00:19:46,540
!لا تعتدّ بنفسك

264
00:19:46,540 --> 00:19:49,780
أنتم هوّاة تمامًا بالكاد تستطيعون
!تدبّر التّرقيعات المؤقّتة

265
00:19:49,780 --> 00:19:55,500
سيكون من المؤسف ألاّ تملك هذه
.السّفينة العظيمة نجّار سفن على متنها

266
00:19:55,830 --> 00:19:58,590
!أظنّني لا أملك خيارًا عدا مساعدتكم

267
00:19:58,590 --> 00:20:03,220
!أنا فرانكي، سأكون نجّار سفينتكم

268
00:20:03,620 --> 00:20:06,680
!حسنًا! لدينا عضوًا جديدًا في طاقمنا

269
00:20:06,680 --> 00:20:09,220
!مرحى! أجل

270
00:20:12,630 --> 00:20:13,940
!...أخي

271
00:20:14,470 --> 00:20:15,940
!لا تبك! لا تبك

272
00:20:16,510 --> 00:20:19,400
!قبّعة القشّ رجلٌ يستحقّ ثقتنا

273
00:20:27,640 --> 00:20:31,930
.توم-سان... إنّي مغادرٌ هذه الجزيرة

274
00:20:33,330 --> 00:20:35,830
اسمع، علّمني كيف أرسم المخطّطات
!من أجل سفينة القراصنة أيضًا

275
00:20:39,020 --> 00:20:40,670
ما المضحك؟

276
00:20:45,170 --> 00:20:46,970
ألن تأوي إلى الفراش بعد يا توم-سان؟

277
00:20:47,690 --> 00:20:48,930
ما الّذي ترسمه؟

278
00:20:48,930 --> 00:20:52,390
.لنرَ... إنّه أمل هذه الجزيرة

279
00:20:53,270 --> 00:20:54,270
أمل؟

280
00:20:54,750 --> 00:20:58,730
لم أكن تلميذًا جيّدًا. لم أسبّب لك
...سوى المتاعب، لكن

281
00:20:59,130 --> 00:21:02,510
!هل سمعتم عن جزيرة الخردة؟

282
00:21:02,510 --> 00:21:06,030
!أقلت أنّ عمّال توم انتهوا من بناء القطار البحريّ؟

283
00:21:07,030 --> 00:21:09,990
!شكرًا لك على كلّ شيء

284
00:21:35,120 --> 00:21:37,730
...يا رؤساء عمّال غالي-لا

285
00:21:38,480 --> 00:21:40,690
!اعتنوا بأيسبرغ جيّدًا

286
00:21:41,160 --> 00:21:44,650
لم أسبّب لك سوى المتاعب
.أنت الآخر يا أيسبرغ

287
00:21:45,850 --> 00:21:48,660
...العجوز كوكورو، الصّغيرة والأرنب

288
00:21:48,660 --> 00:21:50,000
...نقيق

289
00:21:50,000 --> 00:21:51,120
...يوكوزونا

290
00:21:51,510 --> 00:21:52,490
!أيّها المنحرف

291
00:21:52,490 --> 00:21:53,900
...سكّان البلدة الحيّويّين

292
00:21:52,490 --> 00:21:53,900
!إلى أين أنت ذاهب؟

293
00:21:53,900 --> 00:21:55,080
!ستعود، أليس كذلك؟

294
00:21:55,800 --> 00:21:56,990
...أختاي الصّغيرتان

295
00:22:00,100 --> 00:22:02,500
...سودوم... غومورا

296
00:22:03,460 --> 00:22:07,470
...و... أتباعي الأعزّاء

297
00:22:30,520 --> 00:22:33,770
!سأخرج قليلاً

298
00:22:38,190 --> 00:22:40,000
.ارتد لباس سباحتك

299
00:22:45,160 --> 00:22:48,380
!ماذا؟! أوسوبّ سيعود؟

300
00:22:48,380 --> 00:22:50,050
!حقًّا؟! نعم

301
00:22:50,050 --> 00:22:52,100
!حسنًا إذًا! لنذهب لأخذه على الفور

302
00:22:52,100 --> 00:22:53,280
!انتظروا يا رفاق

303
00:22:54,090 --> 00:22:58,980
.لن أسمح لأيّ منّا بالذّهاب وأخذه

304
00:22:58,980 --> 00:23:00,650
:في الحلقة القادمة من وان بيس

305
00:23:00,650 --> 00:23:04,750
!مغادرة مدينة الماء"
"!يضع الرّجل أوسوبّ خاتمة للنّزال

306
00:23:04,750 --> 00:23:07,340
!ملك القراصنة، لن يكون إلاّ أنا

307
00:23:09,990 --> 00:23:15,000
نلقاكم في الحلقة القادمة