1
00:00:00,000 --> 00:00:00,990
...اركض حتّى نصل إلى

2
00:00:00,990 --> 00:00:05,400
حتّى نصل إليك

3
00:00:10,350 --> 00:00:13,660
البحر الأزرق الصّافي المفتوح

4
00:00:14,090 --> 00:00:17,000
جزء من معجزة

5
00:00:17,670 --> 00:00:23,300
تقابلنا أكثر ممّا يمكننا تصّوره

6
00:00:23,670 --> 00:00:26,390
مع كلّ خطوة نخطوها في هذه الرّحلة

7
00:00:26,390 --> 00:00:30,250
ما زال الهدف بعيد المنال

8
00:00:30,250 --> 00:00:33,800
لكن بإمكاننا تجاوز أيّ عقبة

9
00:00:33,800 --> 00:00:37,190
لأنّنا نريد رؤية ابتسامتك

10
00:00:37,190 --> 00:00:41,430
إن تردّدنا، فلن نتألّق

11
00:00:41,430 --> 00:00:44,990
بل ونسعى جاهدين للتّغلّب على نقاط ضعفنا

12
00:00:44,990 --> 00:00:50,580
نحن الّذين كنّا مخلصين

13
00:00:50,580 --> 00:00:54,500
لطالما كنّا كذلك

14
00:00:54,500 --> 00:00:58,130
...اركض حتّى نصل إلى

15
00:00:58,130 --> 00:01:03,180
حتّى نصل إليك

16
00:01:03,180 --> 00:01:09,850
لن نبلغ مستوى الأسطورة؟
!لا مشكلة! كلّ شيء على ما يرام

17
00:01:09,850 --> 00:01:16,340
اتبع الخريطة المتألّقة إلى أن يأتي
اليوم الّذي نستطيع فيه الضّحك

18
00:01:16,340 --> 00:01:22,610
لذلك لا مزيد من التّردّد أيّها المقاتل
سيكون كلّ شيء بخير

19
00:01:27,390 --> 00:01:29,130
!نامي! نامي

20
00:01:29,130 --> 00:01:30,670
!هيّا، استيقظي

21
00:01:39,780 --> 00:01:41,310
...هذا مؤلم

22
00:01:41,310 --> 00:01:44,590
شربت... الكثير؟

23
00:01:50,150 --> 00:01:51,220
ماذا؟

24
00:01:54,630 --> 00:01:55,980
أين أنا؟

25
00:02:03,090 --> 00:02:04,630
.لا يوجد أحد هنا

26
00:02:09,850 --> 00:02:11,460
ما الّذي يحدث؟

27
00:02:17,980 --> 00:02:19,790
هل كنتُ أتخيّل؟

28
00:02:20,060 --> 00:02:21,600
...على أيّ حال، أنا

29
00:02:21,600 --> 00:02:23,000
...هذا مؤلم

30
00:02:23,190 --> 00:02:25,660
ما الّذي أفعله هنا؟

31
00:02:25,660 --> 00:02:29,460
أذكر أنّنا غادرنا إيغهيد
،على متن سفينة العمالقة

32
00:02:29,460 --> 00:02:31,810
...وبينما كنّا نحتفل

33
00:02:37,310 --> 00:02:39,780
ما الّذي يحدث هنا؟

34
00:02:40,260 --> 00:02:44,080
.عليّ الانضمام للبقيّة في أسرع وقت ممكن

35
00:02:48,910 --> 00:02:51,040
!لا

36
00:02:54,630 --> 00:02:58,670
"!نامي في حيرة! مغامرة في بلاد المكعّبات"

37
00:03:06,870 --> 00:03:07,840
.هذا فظيع

38
00:03:08,120 --> 00:03:09,200
!ثمّة حريق

39
00:03:09,200 --> 00:03:10,530
هل الغابة تحترق؟

40
00:03:10,530 --> 00:03:12,430
!يا لها من رائحة فظيعة

41
00:03:12,500 --> 00:03:14,970
!لنخمده بمياه النّبع

42
00:03:15,310 --> 00:03:19,770
إن وصلت النّيران إلى شجرة العالم
!إغدراسيل، فإنّ بلادنا هالكة

43
00:03:21,230 --> 00:03:22,770
ما هذا؟

44
00:03:30,940 --> 00:03:32,480
...نحل ستينغمور

45
00:03:33,110 --> 00:03:35,150
ما الّذي يحدث؟

46
00:03:36,140 --> 00:03:39,940
،حسب كلام سكّان الغابة
،فإنّهم يقولون أنّ إله الأذان قد هُزم

47
00:03:40,200 --> 00:03:42,540
.وذلك هو سبب هذه الفوضى

48
00:03:42,540 --> 00:03:44,280
!هذا مستحيل

49
00:03:44,280 --> 00:03:46,770
من بمقدوره هزيمة ذلك الأرنب الضّخم؟

50
00:03:46,870 --> 00:03:50,310
.ربّما علينا إبلاغ إله الشّمس

51
00:03:51,560 --> 00:03:54,950
قلعة بيغستين

52
00:03:53,440 --> 00:03:55,770
ما زالت حيّة؟

53
00:03:58,480 --> 00:04:02,450
!لن تلمسي شعرة واحدة من نامي

54
00:04:14,710 --> 00:04:17,500
ما هذه النّحلة العملاقة؟

55
00:04:17,740 --> 00:04:20,160
!صباح الخير يا نامي

56
00:04:20,230 --> 00:04:22,030
أين نحن؟

57
00:04:22,030 --> 00:04:23,290
.لا فكرة لديّ

58
00:04:23,640 --> 00:04:26,690
.لكنّنا كنّا على متن سفينة العمالقة

59
00:04:28,010 --> 00:04:30,670
!ما هذا المكان؟! أهذا حلم؟

60
00:04:31,030 --> 00:04:32,680
أهذه قلعة ما؟

61
00:04:33,490 --> 00:04:37,310
هل فقدتُ عقلي؟
!لا أذكر أنّني غيّرتُ ملابسي

62
00:04:40,220 --> 00:04:43,480
.حسنًا، أظنّني سأعود للنّوم

63
00:04:47,020 --> 00:04:49,560
!مهلاً! لا تتركني وحدي

64
00:04:49,560 --> 00:04:50,960
!زوس

65
00:04:50,960 --> 00:04:53,070
!عد يا زوس

66
00:04:54,830 --> 00:04:58,790
!لينقذني أحد ما

67
00:04:59,390 --> 00:05:00,960
!لوفي

68
00:05:00,960 --> 00:05:02,320
!زورو

69
00:05:02,320 --> 00:05:04,380
!سانجي-كُن

70
00:05:04,840 --> 00:05:06,880
...لا أمانع حتّى أوسوبّ الآن

71
00:05:06,880 --> 00:05:10,380
!يا نامي

72
00:05:10,570 --> 00:05:12,540
ماذا؟ أوسوبّ؟

73
00:05:16,010 --> 00:05:18,220
...هذا مؤلم

74
00:05:18,410 --> 00:05:22,600
يا إلهي! لماذا الأرضيّة هكذا؟

75
00:05:22,600 --> 00:05:24,350
!إنّها مليئة بالعثرات

76
00:05:42,860 --> 00:05:44,990
!إنّه ضخم

77
00:05:48,600 --> 00:05:51,340
...مهلاً، لم أقصد أن أفزعك

78
00:05:55,500 --> 00:05:57,260
.لا تغضب منّي رجاءً

79
00:06:01,720 --> 00:06:03,540
!قلت لك لم أقصد ذلك

80
00:06:03,540 --> 00:06:05,160
!آسفة

81
00:06:09,210 --> 00:06:11,780
إنّه بطيء... هل لأنّ أقدامه قصيرة؟

82
00:06:16,390 --> 00:06:18,920
!اكتفيت! أوسوبّ

83
00:06:18,920 --> 00:06:20,870
!أين أنت؟

84
00:06:20,870 --> 00:06:22,580
!أنا هنا

85
00:06:23,360 --> 00:06:24,660
!أوسوبّ

86
00:06:32,300 --> 00:06:34,490
!النّجدة

87
00:06:34,490 --> 00:06:36,250
!أنت من يُفترض به إنقاذي

88
00:06:36,330 --> 00:06:38,510
!وما ذلك الوحش؟

89
00:06:40,600 --> 00:06:42,470
!أوسوبّ في خطر

90
00:06:42,770 --> 00:06:44,430
!وأنا كذلك

91
00:06:44,670 --> 00:06:46,560
!ما الّذي يحدث هنا؟

92
00:06:46,560 --> 00:06:48,520
!أهذه قلعة وحوش؟

93
00:06:50,270 --> 00:06:52,590
!هيّا، نحن بحاجتك يا زوس

94
00:06:52,590 --> 00:06:54,860
!استيقظ! هيّا

95
00:06:55,770 --> 00:06:57,450
!استيقظ بسرعة

96
00:07:00,510 --> 00:07:03,660
هل حان وقت الأكل يا نامي؟

97
00:07:05,160 --> 00:07:07,500
!سأعطيك الكثير من السُّحب الطّازجة لاحقًا

98
00:07:07,500 --> 00:07:08,830
!فعلاً؟

99
00:07:12,060 --> 00:07:13,480
!والآن امتدّ يا زوس

100
00:07:13,480 --> 00:07:15,090
!دعي الأمر لي

101
00:07:23,210 --> 00:07:25,100
!تماسك يا زوس

102
00:07:37,990 --> 00:07:39,820
!سأقع

103
00:07:42,010 --> 00:07:45,210
!ما رأيك ببعض البرق؟

104
00:07:59,670 --> 00:08:01,180
ما... ماذا؟

105
00:08:09,980 --> 00:08:11,150
!هذا مؤلم

106
00:08:17,650 --> 00:08:19,820
ماذا؟

107
00:08:36,460 --> 00:08:38,440
!يراودني شعور سيّئ حيال هذا

108
00:08:38,440 --> 00:08:39,700
!وأنا كذلك

109
00:08:43,520 --> 00:08:44,850
...إنّ هذا

110
00:08:45,290 --> 00:08:47,210
...كنتُ أعرف

111
00:08:59,720 --> 00:09:01,450
!النّجدة

112
00:09:05,950 --> 00:09:09,120
!من الصّعب الرّكض على هذه الأرضيّة اللّعينة

113
00:09:09,120 --> 00:09:11,870
هل عرفتَ أيّ شيء
!عن وضعنا هذا يا أوسوبّ؟

114
00:09:11,870 --> 00:09:15,500
!لا شيء على الإطلاق! استيقظتُ للتّوّ أيضًا

115
00:09:16,440 --> 00:09:21,200
مهلاً، مهلاً... ولكن أين نحن؟

116
00:09:26,060 --> 00:09:27,510
!ماذا؟

117
00:09:27,510 --> 00:09:28,970
!لحية؟

118
00:09:29,160 --> 00:09:30,710
...وهذه الملابس

119
00:09:31,250 --> 00:09:32,450
...مهلاً

120
00:09:37,240 --> 00:09:40,210
!نامي! هيّا، استيقظي

121
00:09:44,280 --> 00:09:46,770
...هذا مؤلم

122
00:09:46,770 --> 00:09:48,230
...ما الّذي

123
00:09:55,310 --> 00:09:56,580
.وتعرفين الباقي

124
00:09:56,580 --> 00:09:59,180
.كان ذلك صوتك بالفعل

125
00:09:59,420 --> 00:10:01,210
!ما الّذي نفعله هنا؟

126
00:10:01,420 --> 00:10:02,750
.لا فكرة لديّ

127
00:10:02,870 --> 00:10:05,590
،كنّا على سفينة العمالقة

128
00:10:05,830 --> 00:10:07,460
...وشربنا الكثير

129
00:10:09,470 --> 00:10:13,850
.بالمناسبة، هذا الخمر قويّ جدًّا

130
00:10:14,300 --> 00:10:17,260
!نعم! هذا أفسنتين

131
00:10:17,260 --> 00:10:19,980
.يُعرف أيضًا بالجنّيّة الخضراء

132
00:10:19,980 --> 00:10:23,820
صحيح! ألم يقل لنا أنّ ذلك الخمر
!يسبّب الهلوسة؟

133
00:10:25,540 --> 00:10:26,740
!نهاية مسدودة

134
00:10:32,600 --> 00:10:34,620
!هذا مرتفع جدًّا

135
00:10:42,250 --> 00:10:44,100
!ما الّذي سنفعله يا أوسوبّ؟

136
00:10:44,190 --> 00:10:47,340
...ذكرتِ الهلوسة قبل قليل يا نامي

137
00:10:47,580 --> 00:10:48,550
ماذا؟

138
00:10:48,550 --> 00:10:51,260
...إن كان ذلك صحيحًا، فهذا القطّ أيضًا

139
00:10:51,260 --> 00:10:53,850
...ربّما نعتقد أنّنا نراه فحسب

140
00:10:56,340 --> 00:10:58,190
!ولكنّه في الأصل مجرّد هلوسة

141
00:11:01,090 --> 00:11:02,570
!أرني ما لديك

142
00:11:13,240 --> 00:11:15,790
!أوسوبّ

143
00:11:29,090 --> 00:11:30,340
...أوسوبّ

144
00:11:34,520 --> 00:11:36,440
!كلاّ

145
00:12:06,120 --> 00:12:07,800
...هذا مؤلم

146
00:12:07,800 --> 00:12:09,660
هل نجوتُ الآن؟

147
00:12:12,820 --> 00:12:14,020
!كلاّ

148
00:12:14,390 --> 00:12:17,560
!تحوّل أوسوبّ إلى بروك

149
00:12:25,190 --> 00:12:26,440
!أوسوبّ

150
00:12:29,680 --> 00:12:31,640
!هيّا، افتح عينيك

151
00:12:31,740 --> 00:12:35,260
!لا تتركني وحدي

152
00:12:37,270 --> 00:12:38,460
!أوسوبّ

153
00:13:10,850 --> 00:13:12,740
لماذا هنالك أسد فجأة؟

154
00:13:12,930 --> 00:13:14,310
!أوسوبّ، تماسك

155
00:13:14,310 --> 00:13:16,740
!استيقظ وإلاّ قُتلنا

156
00:13:16,740 --> 00:13:19,440
!أوسوبّ! أوسوبّ

157
00:13:34,000 --> 00:13:36,100
!كلاّ

158
00:13:36,100 --> 00:13:38,100
!مهلاً! لا تستعمليني كدرع

159
00:13:38,510 --> 00:13:40,310
!توقّف، ابتعد! توقّف، ابتعد

160
00:13:40,310 --> 00:13:41,990
...نحن هالكون

161
00:13:50,170 --> 00:13:51,610
!المستوى الثّالث

162
00:14:00,630 --> 00:14:02,930
!نامي-سان

163
00:14:05,420 --> 00:14:09,170
...ولأنّك أبكيت شخصًا عزيزًا عليّ
!سأحكم عليك بالإعدام

164
00:14:16,080 --> 00:14:17,890
!ساق العفريت

165
00:14:22,390 --> 00:14:23,970
!أسلوب السّيوف الثّلاثة

166
00:14:25,770 --> 00:14:28,110
...فاكهة المطّاط

167
00:14:28,530 --> 00:14:30,320
...سوط

168
00:14:31,700 --> 00:14:33,350
...ركلة

169
00:14:34,220 --> 00:14:36,700
...إعصار تنّين الحبل الأسود

170
00:14:40,450 --> 00:14:41,810
!الأسود

171
00:14:46,670 --> 00:14:48,630
!الفيل

172
00:14:54,010 --> 00:14:55,650
!الكتف

173
00:15:22,520 --> 00:15:24,620
...نجونا أخيرًا

174
00:15:28,790 --> 00:15:31,130
.ماذا؟ لقد تحوّل إلى قطّ

175
00:15:31,360 --> 00:15:33,400
!إنّه ضخم

176
00:15:33,400 --> 00:15:35,840
،لكن لا أظنّني سآكله

177
00:15:36,120 --> 00:15:39,740
.فقد كان ذلك الأرنب المشويّ لذيذًا بما يكفي

178
00:15:40,800 --> 00:15:43,010
!نامي-سان

179
00:15:43,310 --> 00:15:45,840
!كنت قلقًا جدًّا عليك

180
00:15:47,670 --> 00:15:50,800
!كنتُ خائفة جدًّا يا سانجي-كُن

181
00:15:50,800 --> 00:15:53,110
...وأوسوبّ المسكين قد مات

182
00:15:53,300 --> 00:15:55,390
.لا بدّ أنّ ذلك كان صعبًا عليك

183
00:15:55,650 --> 00:15:58,820
ولا بدّ أنّه كان سعيدًا بالتّضحية
.بنفسه من أجلك

184
00:15:58,820 --> 00:16:00,910
...أنا حيّ

185
00:16:01,540 --> 00:16:02,710
...ويا لك من

186
00:16:02,710 --> 00:16:07,230
.لن أنسى أبدًا أنّك استعملتني كدرع لك

187
00:16:21,540 --> 00:16:23,010
!ما-ماذا؟

188
00:16:25,970 --> 00:16:27,590
!ماذا يحدث الآن؟

189
00:16:27,590 --> 00:16:28,770
مرّة أخرى؟

190
00:16:29,180 --> 00:16:31,990
.ثمّة مخلوقات عملاقة أخرى هنا

191
00:16:31,990 --> 00:16:34,400
.ستستحقّ العناء إن كان مذاقها لذيذًا

192
00:16:34,400 --> 00:16:37,340
.العثور على السّفينة والبحر له الأولويّة الآن

193
00:16:37,340 --> 00:16:39,490
.لا ندري إن كان بقيّة الطّاقم بخير

194
00:16:39,780 --> 00:16:41,690
،بالحديث عن الطّعام

195
00:16:41,880 --> 00:16:44,830
سرب النّحل وخليّته الّذين رميتما
...بهم بعيدًا قبل قليل

196
00:16:46,410 --> 00:16:50,250
كانت مصدر طعام جيّد جدًّا
.ومليئًا بالمغذّيات

197
00:16:50,500 --> 00:16:54,010
.فعلاً؟ يا للخسارة

198
00:16:54,010 --> 00:16:54,970
أفهمت؟

199
00:16:54,970 --> 00:16:57,340
.كان عليك قولها باكرًا –
ماذا؟ –

200
00:16:57,340 --> 00:16:59,550
!لماذا أنتم مرتاحون جدًّا هكذا؟

201
00:16:59,550 --> 00:17:01,300
!أين نحن بالضّبط؟

202
00:17:03,760 --> 00:17:06,990
ولكن كيف وصلتم إلى هنا؟

203
00:17:06,990 --> 00:17:10,000
.استيقظتُ في المدينة هناك

204
00:17:10,000 --> 00:17:12,210
،وعندما تتبّعتُ أثر بعض الضّجّة

205
00:17:12,410 --> 00:17:14,920
.وجدتُ لوفي هناك وقد قتل أرنبًا عملاقًا

206
00:17:14,920 --> 00:17:18,540
كان بإمكانك هزيمة ذلك
.القطّ الأسد بسهولة يا أوسوبّ

207
00:17:18,540 --> 00:17:21,990
استيقظتُ وأنا أوشك أن أكون
!وجبة له! كنتُ مذعورًا

208
00:17:34,920 --> 00:17:37,170
...فاكهة المطّاط

209
00:17:38,320 --> 00:17:40,210
!البالون

210
00:17:51,140 --> 00:17:54,940
.كم هذا مؤلم... لكنّي نجوت

211
00:17:55,110 --> 00:17:59,670
هذه الوحوش العملاقة الغريبة
...وهذه المباني الشّبيهة بالقِلاع

212
00:17:59,750 --> 00:18:02,740
...إن كان هذا العالم هلوسة فقط

213
00:18:02,740 --> 00:18:05,090
ربّما هو حلم؟

214
00:18:05,350 --> 00:18:06,420
.لا

215
00:18:07,180 --> 00:18:08,990
...إن كنتُ أحلم

216
00:18:10,440 --> 00:18:12,710
.فلن يكون هنالك أيّ رجال آخرين

217
00:18:12,710 --> 00:18:15,030
ما نوع الأحلام الّتي تراودك عادة؟

218
00:18:15,950 --> 00:18:17,660
...استعدّي يا نامي-سان

219
00:18:19,770 --> 00:18:21,630
!سأقفز

220
00:18:22,660 --> 00:18:23,730
ماذا؟

221
00:18:56,100 --> 00:18:57,510
.هذا غريب

222
00:18:58,050 --> 00:19:00,090
.لا توجد أيّ رياح هنا

223
00:19:07,240 --> 00:19:09,010
...هكذا إذًا

224
00:19:09,010 --> 00:19:09,930
ماذا هنالك؟

225
00:19:11,250 --> 00:19:13,640
أهذه شجرة؟

226
00:19:13,640 --> 00:19:15,350
...بعد تفكير معمّق

227
00:19:16,300 --> 00:19:18,000
،وحسب ملاحظاتي

228
00:19:18,000 --> 00:19:21,940
فهذه ملابس محاربي إلباف
.الّتي نرتديها الآن

229
00:19:22,150 --> 00:19:26,300
ولكن، مستحيل أن تكون هنالك
ملابس في مقاسنا

230
00:19:26,300 --> 00:19:28,590
.في بلاد العمالقة إلباف

231
00:19:28,590 --> 00:19:33,270
أتقول أنّنا في إلباف
ولكن تحوّلنا إلى عمالقة؟

232
00:19:33,270 --> 00:19:35,320
أنا عملاق الآن؟

233
00:19:35,320 --> 00:19:37,090
.ذلك غير معقول

234
00:19:37,090 --> 00:19:40,640
.بعض أفراد طاقمنا هنا، ولكن ليس كلّه

235
00:19:40,640 --> 00:19:42,040
كيف لك أن تعرف ذلك؟

236
00:19:43,920 --> 00:19:46,520
.لا يلتقط راداري وجود روبين-تشان

237
00:19:46,520 --> 00:19:47,470
أأنت كلب؟

238
00:19:47,700 --> 00:19:49,070
!بالضّبط

239
00:19:49,070 --> 00:19:52,400
قد نعثر على السّفينة ساني
!إن ذهبنا البحر

240
00:19:52,400 --> 00:19:53,970
.سيكون البقيّة هناك

241
00:19:54,160 --> 00:19:56,140
.انظروا لحجم هذا المكان

242
00:19:56,410 --> 00:19:58,790
.لا أظنّنا سنصل البحر قريبًا

243
00:19:58,790 --> 00:20:00,060
.معه حقّ

244
00:20:00,300 --> 00:20:02,430
.هنالك بشر في المدينة

245
00:20:02,670 --> 00:20:07,160
لن نعرف أيّ شيء ما
.لم نسألهم أين نحن الآن

246
00:20:07,160 --> 00:20:09,030
!إلى المدينة إذًا

247
00:20:09,280 --> 00:20:13,090
،إن كنّا سنسأل شخصًا ما
!فمن الأفضل أن يكون فتاة جميلة

248
00:20:13,090 --> 00:20:14,620
!كن أكثر جدّيّة

249
00:20:14,620 --> 00:20:16,470
!أنت تذهب في الاتّجاه الخاطئ يا زورو

250
00:20:16,470 --> 00:20:17,750
أتظنّ ذلك؟

251
00:20:19,960 --> 00:20:22,270
لماذا يبدو أنّكم تستمتعون بوقتكم كثيرًا؟

252
00:20:22,270 --> 00:20:25,960
!لا نعرف أيّ شيء عن هذا المكان المريب

253
00:20:25,960 --> 00:20:30,180
!سنكون بخير يا نامي-سان
!أنا معك هنا

254
00:20:30,380 --> 00:20:32,700
،حتّى لو لم نكن في إلباف

255
00:20:32,700 --> 00:20:37,180
!سيكون قلبي طوع أمرك دائمًا

256
00:20:38,380 --> 00:20:43,420
إن كانت هذه إلباف، توقّعتُ رؤية
.سبيكة ذهب عملاقة على الأقلّ

257
00:20:43,420 --> 00:20:45,270
.تقصدين "سرقتها" وليس رؤيتها

258
00:20:45,590 --> 00:20:48,740
!لنذهب إلى المدينة ونسأل النّاس هناك

259
00:20:48,740 --> 00:20:51,070
!معك حقّ! هيّا بنا

260
00:20:51,640 --> 00:20:53,680
!فلتبدأ المغامرة

261
00:20:53,680 --> 00:20:55,910
!أجل

262
00:20:58,540 --> 00:21:06,380
!إلباف-باف! إلباف

263
00:21:06,910 --> 00:21:10,590
!إنّهم ضخام لأنّهم عمالقة

264
00:21:10,590 --> 00:21:16,600
يُتبع

265
00:21:20,100 --> 00:21:23,900
ها أنا أجهد عينيّ حتّى الإنهاك

266
00:21:25,520 --> 00:21:29,440
أتفحّص مكاني وأرى أين أقف الآن

267
00:21:30,690 --> 00:21:35,350
وعقلي مستهلَك بالكامل بكلّ
هذا الوهم واليأس

268
00:21:35,350 --> 00:21:38,700
دائمًا ما أميل قليلاً عن المسار ولا أعرف كيف

269
00:21:39,150 --> 00:21:43,170
والأشياء الّتي تظهر لي بوضوح

270
00:21:44,370 --> 00:21:48,210
هي دومًا ذكريات قاسية

271
00:21:49,760 --> 00:21:54,240
أجمع بقايا ملل حياتي البسيط

272
00:21:54,240 --> 00:21:57,890
ربّما أتحوّل إلى شخص غيري ليس أنا

273
00:21:59,300 --> 00:22:02,500
أتساءل ما المستقبل
الّذي يليق بشخص مثلي الآن

274
00:22:02,500 --> 00:22:06,420
من الآن فصاعدًا
مهما أجهدتُ عينيّ بالتّحديق

275
00:22:06,420 --> 00:22:08,880
فلن أرى شيئًا على أيّ حال

276
00:22:08,880 --> 00:22:12,350
أنا أواجه الرّياح المعاكسة

277
00:22:12,350 --> 00:22:15,220
وأصبّها في دمعة القدر

278
00:22:15,220 --> 00:22:19,660
وأمزّق كلّ الأوهام الزّائفة إربًا إربا

279
00:22:19,660 --> 00:22:23,230
والجميع هناك

280
00:22:23,230 --> 00:22:27,750
يرصّون واقعهم الخاصّ بين
الحياة والموت هكذا طوال الوقت

281
00:22:27,750 --> 00:22:30,360
ثمّ يأتي الغد بصوتٍ أعلى من أن يُحتمل

282
00:22:30,360 --> 00:22:34,910
ولا يترك وقتًا حتّى للدّعاء

283
00:22:34,910 --> 00:22:39,750
وذلك المستقبل الّذي نراه

284
00:22:39,750 --> 00:22:44,020
إنّه لي أنا

285
00:22:51,490 --> 00:22:54,490
.يكتشف لوفي والبقيّة الأراضي الغامضة حولهم

286
00:22:54,490 --> 00:22:58,370
،وخلف مباني مكعّبات اللّعب
.يكتشفون معبد إله الشّمس

287
00:22:58,860 --> 00:23:01,430
أيعقل أنّهم في إلباف بالفعل؟

288
00:23:01,870 --> 00:23:05,090
،وبينهما يهدفون للهرب من بلاد المكعّبات

289
00:23:05,090 --> 00:23:07,210
.تقترب منهم أصوات خطوات مشؤومة

290
00:23:07,210 --> 00:23:08,880
:في الحلقة القادمة من وان بيس

291
00:23:08,880 --> 00:23:12,190
!اكتشاف الأرض الغامضة"
"سرّ إله الشّمس

292
00:23:12,190 --> 00:23:14,550
!ملك القراصنة، لن يكون إلاّ أنا