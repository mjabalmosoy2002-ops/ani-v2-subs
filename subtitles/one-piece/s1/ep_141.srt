5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:52,680 --> 00:01:55,890
!يا قراصنة اليقطين، انطلقوا

22
00:02:00,960 --> 00:02:02,990
الكنز الّذي نسعى إليه قابعٌ
!في تلك الجزيرة

23
00:02:02,990 --> 00:02:06,300
،من يصل إليها أوّلاً
!سيحصل على مكافأة

24
00:02:10,300 --> 00:02:11,800
!مـ-مهلاً

25
00:02:14,640 --> 00:02:17,080
!انتظروني! أنا قادم أيضًا

26
00:02:18,310 --> 00:02:19,380
.لا تستطيع

27
00:02:22,310 --> 00:02:25,180
أنت كبير الآن، أليس كذلك؟

28
00:02:34,330 --> 00:02:35,390
!انتظروني

29
00:02:36,160 --> 00:02:39,800
!رابا نوي! إيسوكا! رونغو
!أكيبي! بوكاو

30
00:02:40,330 --> 00:02:42,230
!لا تتركوني وحدي

31
00:02:43,230 --> 00:02:46,810
!لا تتركوني هنا

32
00:02:52,140 --> 00:02:53,140
...كنتُ أحلم

33
00:02:53,140 --> 00:02:55,280
أنت قلق على أصدقائك، صحيح؟

34
00:02:56,350 --> 00:02:58,680
.كنت تنادي على أسمائهم أثناء نومك

35
00:03:01,590 --> 00:03:03,790
ما كان المغزى من كلّ ذلك بالضّبط؟

36
00:03:03,790 --> 00:03:07,760
لِمَ كرّستُ خمسين سنة من عمري
في البحث عن ضباب قوس قزح؟

37
00:03:07,760 --> 00:03:10,830
برؤيتي لرابا نوي
،والبقيّة كما كانوا حينها

38
00:03:11,200 --> 00:03:14,930
يجعلني ذلك أنا على الأقلّ أفكّر
.أنّني أهدرتُ كلّ ذلك الوقت

39
00:03:14,930 --> 00:03:16,730
لم تُهدره، صحيح؟

40
00:03:16,730 --> 00:03:19,470
رأيت أصدقاءك القدامى
.مجدّدًا بالفعل

41
00:03:19,470 --> 00:03:20,940
...لستُ واثقًا

42
00:03:24,310 --> 00:03:26,410
أهذه السّفينة تتحرّك؟

43
00:03:26,980 --> 00:03:28,750
...لا يُفترض أن تفعل

44
00:03:32,820 --> 00:03:37,020
مشاعر الحنين! مقبرة القراصنة"
"!الّتي لا خروج منها

45
00:03:38,660 --> 00:03:40,160
!إلى الأمام

46
00:03:40,660 --> 00:03:42,430
!إلى الأمام بأقصى سرعة

47
00:03:42,660 --> 00:03:46,030
أواثق أنّنا نسير إلى الأمام يا لوفي؟

48
00:03:46,030 --> 00:03:48,600
!نعم! إلى الأمام مباشرةً

49
00:03:49,830 --> 00:03:52,040
إلى أين أنتم ذاهبون بالضّبط؟

50
00:03:52,040 --> 00:03:54,070
!إلى أين؟ سنخرج من الضّباب

51
00:03:54,610 --> 00:03:56,040
.لا تكن سخيفًا

52
00:03:56,670 --> 00:04:00,410
،"فور أن تدخل إلى "حفلة القرد
.لن تخرج منها ثانيةً

53
00:04:00,410 --> 00:04:02,250
.إنّها منطقة بحر شيطانيّة

54
00:04:02,950 --> 00:04:07,090
مهلاً، ألم نرَ تلك السّفينة قبل وهلة؟

55
00:04:07,620 --> 00:04:08,820
.لا تنزعج من ذلك

56
00:04:08,820 --> 00:04:11,090
.ثمّة سفن مشابهة أينما ذهبت

57
00:04:11,090 --> 00:04:16,160
كلاّ، لقد مرّت هذه السّفينة من
.نفس المكان الأوّل الّذي رسونا فيه

58
00:04:16,590 --> 00:04:19,060
أذكر رؤية رمز الإلهة
!في مقدّمة السّفينة

59
00:04:19,060 --> 00:04:23,700
أ-أيعني هذا أنّنا عدنا من حيث بدأنا؟

60
00:04:24,300 --> 00:04:27,740
لهذا سألتك إن كنت واثقًا
!من أنّنا نسير إلى الأمام

61
00:04:27,740 --> 00:04:29,910
!كنتُ أراقب! كنّا نسير إلى الأمام

62
00:04:30,310 --> 00:04:33,410
لا يمكنك الجزم إن كنّا نسير إلى الأمام
وسط هذا الضّباب، أليس كذلك؟

63
00:04:33,410 --> 00:04:34,080
...لا يعقل

64
00:04:37,120 --> 00:04:38,780
!ستّ زهور

65
00:04:54,770 --> 00:04:56,230
!لِمَ فعلت ذلك؟

66
00:04:56,230 --> 00:04:58,800
!أطلقنا إلى الأمام، لكنّها عادت من خلفنا

67
00:04:58,800 --> 00:05:00,310
.عرفتها

68
00:05:00,310 --> 00:05:02,510
.الفضاء مشوّه

69
00:05:02,840 --> 00:05:04,080
ماذا تقصد؟

70
00:05:04,780 --> 00:05:07,110
.أذكرُ أنّي قرأتُ شيئًا في كتاب

71
00:05:07,110 --> 00:05:10,720
.إنّ داخل ضباب قوس قزح أشبه بمتاهة

72
00:05:11,950 --> 00:05:14,320
...غومو غومو نوو

73
00:05:12,920 --> 00:05:14,920
!مهلاً، لا تتهوّر

74
00:05:14,320 --> 00:05:17,360
!الصّاروخ

75
00:05:17,960 --> 00:05:18,920
.فات الأوان

76
00:05:19,360 --> 00:05:23,600
.لن يعود إلى نفس المكان بالضّرورة

77
00:05:23,600 --> 00:05:25,330
!ذلك الأحمق

78
00:05:32,340 --> 00:05:33,610
.فهمت

79
00:05:33,610 --> 00:05:36,670
هذا ضباب غامض، بحيث أنّ أينما
.ذهبت، ستعود من حيث بدأت

80
00:05:37,380 --> 00:05:39,540
."إنّه "ضباب غامض

81
00:05:39,840 --> 00:05:42,310
هل أنتم واثقون أنّكم فهمتم؟

82
00:05:42,650 --> 00:05:45,180
على الأقلّ جزئيّة عدم مقدرتنا
.على الخروج من هنا

83
00:05:46,950 --> 00:05:49,350
!لسنا بحاجة للخروج. المكان ممتع

84
00:05:49,350 --> 00:05:50,020
!بلى، علينا ذلك

85
00:05:50,560 --> 00:05:52,990
.لننضمّ إلى رابا نوي والبقيّة

86
00:05:54,230 --> 00:05:55,260
لأولئك الصّبية؟

87
00:05:55,490 --> 00:05:57,830
"أفضل طريقة لنا للخروج من "حفلة القرد

88
00:05:57,830 --> 00:06:01,170
هي باستشارة الّذين يملكون المنطقة، صحيح؟

89
00:06:01,170 --> 00:06:05,140
نعم، لكن أين هم؟

90
00:06:05,140 --> 00:06:08,110
.لنسأل ذلك الصبيّ هناك

91
00:06:11,740 --> 00:06:13,110
!كيف وجدتني؟

92
00:06:13,110 --> 00:06:14,610
.لا فائدة من الاختباء

93
00:06:15,950 --> 00:06:17,180
.زهرة واحدة

94
00:06:19,120 --> 00:06:20,950
هلاّ أخذتنا؟

95
00:06:21,290 --> 00:06:23,520
.إلى زعيمكم

96
00:06:28,960 --> 00:06:30,300
!مستحيل

97
00:06:32,130 --> 00:06:34,930
أقلتما أنّ هينزو عاد كرجلٍ عجوز؟

98
00:06:34,930 --> 00:06:37,270
أيّ نكتة هذه؟

99
00:06:37,270 --> 00:06:39,140
.ليست نكتة

100
00:06:39,540 --> 00:06:44,410
،لقد سقط إلى البحر لإنقاذنا
.ولم نره منذ حينها

101
00:06:46,810 --> 00:06:49,110
!أعدكم أن ألحق بكم لاحقًا

102
00:06:49,310 --> 00:06:51,620
!اذهبوا! تابعوا طريقكم ولا تقلقوا بشأني

103
00:06:52,980 --> 00:06:55,320
.ما زال حيًّا، في العالم الخارجيّ

104
00:06:55,650 --> 00:07:01,330
قال هينزو أنّه كان يبحث عن طريقةٍ
،لإعادتنا طوال هذا الوقت في لولوكا

105
00:07:01,330 --> 00:07:03,660
!وأنّه مرّت خمسون سنة، بتلك البساطة

106
00:07:04,930 --> 00:07:07,430
.خمسون سنة؟ هذا سخيف

107
00:07:07,830 --> 00:07:10,840
أواثقون أنّ ذلك العجوز لا يخدعكم؟

108
00:07:10,840 --> 00:07:13,070
ولِمَ قد يخدعنا؟

109
00:07:13,940 --> 00:07:15,870
.ما كنتُ لأعرف

110
00:07:15,870 --> 00:07:18,910
،لكن إن كان ما قاله هينزو صحيحًا

111
00:07:18,910 --> 00:07:20,810
.أتساءل ما حلّ ببلدة لولوكا

112
00:07:23,280 --> 00:07:25,280
...أبي... أمّي

113
00:07:25,950 --> 00:07:28,250
.لا فائدة من القلق بشأن ذلك

114
00:07:28,250 --> 00:07:31,490
ستعرفون إن كان ذلك صحيحًا
.أم لا فور أن تعودوا وتروا بأعينكم

115
00:07:32,120 --> 00:07:33,560
هل تعرف طريقة للرّجوع؟

116
00:07:34,330 --> 00:07:36,030
.بالطّبع

117
00:07:36,030 --> 00:07:39,560
