1
00:00:05,000 --> 00:00:10,000
آل فانتوم
AlPhantom

2
00:00:22,010 --> 00:00:25,560
قلبي ينبض بقوّةٍ عند تفكيري بك

3
00:00:25,560 --> 00:00:28,980
تعصِف قوّةٌ لا حُدود لها

4
00:00:28,980 --> 00:00:34,780
مادُمتَ ترغب بهذا، سنُلوّح برابطتنا التي لا تتغيّر

5
00:00:34,780 --> 00:00:36,360
نحن أمَل

6
00:00:42,370 --> 00:00:49,250
مُتعة جعل مَشاعرنا الحقيقيّة تُحلَق نحو بعضنا

7
00:00:49,250 --> 00:00:56,510
ألَم ضَحِكاتنا التي ضحكناها بكلّ قوّتنا لتجفيف
دُموعنا

8
00:00:56,510 --> 00:01:03,390
نصِل بينها معاً و في الرّياح، أه

9
00:01:03,390 --> 00:01:10,140
إنّها تُرفرف أعلى و أعلى

10
00:01:10,140 --> 00:01:13,310
لماذا تخلّيتَ عن بحثك؟

11
00:01:13,310 --> 00:01:16,730
لماذا تستمرّ بالقِتال لوَحدك؟

12
00:01:16,730 --> 00:01:19,610
أخبرنا، أيّ نوعٍ من المُستقبل استعدّيتَ له؟

13
00:01:19,610 --> 00:01:23,160
هل حقّقتَ حُلمك؟

14
00:01:23,530 --> 00:01:27,080
قلبي ينبض بقوّةٍ عند تفكيري بك

15
00:01:27,080 --> 00:01:30,830
تعصِف قوّةٌ لا حُدود لها

16
00:01:30,830 --> 00:01:36,380
مادُمتَ ترغب بهذا، سنُلوّح برابطتنا التي لا تتغيّر

17
00:01:36,380 --> 00:01:37,590
نحن أمَل

18
00:01:37,750 --> 00:01:41,180
في نهاية العالَم الأزرق الوَاسع

19
00:01:41,180 --> 00:01:43,720
هناك مكانٌ أرغب بالذّهاب إليه معك

20
00:01:43,720 --> 00:01:46,510
الطّريق البَحريّ الذي نُبحر فيه

21
00:01:46,510 --> 00:01:53,270
تمّ تقريره في الماضي البعيد

22
00:02:03,910 --> 00:02:07,450
صوتكَ الذي لَم يصِلني بعد

23
00:02:07,450 --> 00:02:11,080
يسحق قلبي العاجز

24
00:02:11,080 --> 00:02:14,330
أنا بانتظارك

25
00:02:14,330 --> 00:02:19,170
لذا سأستمرّ بالإيمان بالصّباح عندما يدخل الضّوء

26
00:02:19,170 --> 00:02:23,010
أغلِق عيناكَ و اسمع جيّداً

27
00:02:23,010 --> 00:02:26,510
لنبحث عن إجابتك

28
00:02:26,510 --> 00:02:32,310
يستمرّ الطّريق دائماً نحو البَحر الذي لَم ترَه
سابقاً

29
00:02:32,310 --> 00:02:33,350
نحن أمَل

30
00:02:33,480 --> 00:02:36,900
في نهاية العالَم الأزرق الوَاسع

31
00:02:36,900 --> 00:02:39,400
هناك مكانٌ يجب أن أعود إليه معك

32
00:02:39,400 --> 00:02:42,190
سنكون إلى الأبد

33
00:02:42,190 --> 00:02:49,370
تمّ تقريره في الماضي البعيد

34
00:02:52,750 --> 00:02:59,420
.إلتمّ شمل لوفي و سانجي ثانيةً في نُقطة اللّقاء
أخيراً بعد انفصالهما

35
00:02:59,630 --> 00:03:03,590
سنُدمّر حفلة شاي بيغ ماما و حفل الزّفاف

36
00:03:03,630 --> 00:03:06,260
!و نُنقِذ عائلة سانجي

37
00:03:06,300 --> 00:03:09,140
!بعدها، سيعود سانجي معنا

38
00:03:09,680 --> 00:03:11,560
،لتحقيق هذا

39
00:03:11,600 --> 00:03:17,190
.تحالَف لوفي و مَجموعته مع بيجي الذي يُخطّط لقتل
إمبراطورة البِحار - بيغ ماما

40
00:03:17,490 --> 00:03:21,670
.مع اقتراب بِدء حفلة الشّاي، وَصل الضّيوف وَاحداً
تلوى الآخر

41
00:03:23,940 --> 00:03:27,160
...يملك الجّميع أهدافهم الخاصّة

42
00:03:27,200 --> 00:03:29,630
.بينما تبدأ حفلة الشّاي أخيراً...

43
00:03:30,080 --> 00:03:31,140
!كُلوا

44
00:03:32,120 --> 00:03:33,180
!إشرَبوا

45
00:03:34,290 --> 00:03:39,510
.و استمتعوا بالحفلة حتّى تشبع قُلوبكم

46
00:03:40,000 --> 00:03:42,590
...إستمتعوا بكلّ شيءٍ

47
00:03:42,630 --> 00:03:44,850
!سيحصل هُنا...

48
00:03:46,860 --> 00:03:55,230
"!الثّنائيّ المُتصدّع! يدخُل سانجي و بودينغ"

49
00:04:07,360 --> 00:04:10,990
الطّابق التّاسع-غُرفة الإنتظار للعريس و العروس

50
00:04:07,650 --> 00:04:11,100
.هذا مَوقع انعقاد حفلة الشّاي
.بدأ كلّ شيءٍ للتّوّ

51
00:04:11,570 --> 00:04:14,330
أنهى كِلا العريس و العروس استعداداتهما

52
00:04:14,330 --> 00:04:17,890
.و يُراجعان للمرّة الأخيرة تفاصيل الإحتفال الذي
سيبدأ في السّاعة الـ12

53
00:04:17,890 --> 00:04:20,400
.يسير كلّ شيءٍ بشكلٍ جيّد

54
00:04:20,400 --> 00:04:24,850
بعد تبادل العهود، سيرفع العريس خمار العروس

55
00:04:24,850 --> 00:04:26,330
.و يُقبّلها

56
00:04:27,340 --> 00:04:32,030
.ستجذب قُبلة الزّفاف انتباه الجّميع

57
00:04:32,030 --> 00:04:35,080
...في تلك اللّحظة بالضّبط

58
00:04:36,490 --> 00:04:39,540
!ستُطلِق بودينغ سان النّار على سانجي سان

59
00:04:42,730 --> 00:04:44,200
سانجي سان؟

60
00:04:44,900 --> 00:04:46,350
ما الخطب؟

61
00:04:47,940 --> 00:04:50,380
...أوه، لا شيء
...أشعر بالتّوَتّر فقط

62
00:04:52,620 --> 00:04:54,370
...أنا أيضاً

63
00:04:55,200 --> 00:04:58,310
!!ظـ-ظريفةٌ جدّاً

64
00:04:58,460 --> 00:05:01,270
الهول كيك تشاتو- السّطح

65
00:05:05,710 --> 00:05:07,190
!هاي

66
00:05:07,800 --> 00:05:09,510
!هاي

67
00:05:10,300 --> 00:05:11,780
قُبّعة القشّ؟

68
00:05:12,220 --> 00:05:14,120
.نحن مُستعدّون تقريباً

69
00:05:14,120 --> 00:05:15,640
.حسناً

70
00:05:15,970 --> 00:05:18,620
!كم هذا مُثيرٌ للإهتمام

71
00:05:19,460 --> 00:05:21,400
!هاي، إبقى هناك

72
00:05:25,940 --> 00:05:28,760
!لا يُمكنكَ العبث في الأرجاء الآن
!عُد إلى الدّاخل

73
00:05:29,150 --> 00:05:31,400
!بماذا يُفكّر؟

74
00:05:31,570 --> 00:05:34,020
!أوه، يُمكنني الخُروج من هُنا أيضاً

75
00:05:36,700 --> 00:05:40,020
!ماذا يحصل بجسدك؟

76
00:05:40,020 --> 00:05:42,080
!إنّه رائعٌ جدّاً

77
00:05:42,540 --> 00:05:44,570
!لا تعبث بجسدي

78
00:05:44,570 --> 00:05:46,520
!لا تكُن جادّاً جدّاً

79
00:05:50,300 --> 00:05:52,410
!ماذا تفعل؟

80
00:05:52,880 --> 00:05:56,110
...رُبّما كان يجدُر بي قتلهم

81
00:05:57,720 --> 00:05:59,240
ماذا الآن؟

82
00:06:01,390 --> 00:06:04,350
...أوه، يا إلهي

83
00:06:04,690 --> 00:06:06,630
فيتو، ماذا تفعل؟

84
00:06:06,630 --> 00:06:08,400
!فاذر، هذا مُذهل

85
00:06:08,400 --> 00:06:12,880
!رئيس المَجلّة الإقتصاديّة العالَميّة و زعيم
جيرما يتكلّمان معاً-ريرو

86
00:06:13,300 --> 00:06:17,260
.بالتّأكيد يتكلّمان
.يملك كِلاهما أُذُنين و فماً

87
00:06:17,490 --> 00:06:21,890
!حسناً، لكنّها حفلةٌ استثنائيّة-ريرو

88
00:06:21,890 --> 00:06:25,400
.الإبن الأكبر و وزير الحلوى، بيروسبيرو

89
00:06:25,950 --> 00:06:28,860
.الإبنة الكُبرى و وزيرة الفاكهة، كومبوتي

90
00:06:29,470 --> 00:06:32,280
.الإبن الثّاني، جنرال الحلوى كاتاكوري

91
00:06:32,280 --> 00:06:35,740
.الإبنة الرّابعة عشر، جنرالة الحلوى سموذي

92
00:06:35,740 --> 00:06:39,160
.الإبن الثّالث، دايفوكو، و الإبن الرّابع، أوفين

93
00:06:39,390 --> 00:06:43,080
.عددٌ لا يُحصى من الوُحش في كلّ مكان

94
00:06:43,080 --> 00:06:47,170
،كان مُشجّعاً جدّاً امتلاكهم جميعاً بنفس الجّانب

95
00:06:49,610 --> 00:06:53,940
.لكن يُرعبني التّفكير بأنّنا سنجعلهم جميعاً
أعداءنا-ريرو

96
00:06:53,940 --> 00:06:55,340
هاه؟ "أعداء"؟

97
00:06:55,590 --> 00:06:58,540
.إن كنتَ تملك الوَقت لفِعل ذلك، إذهب لتفقّد
المكان في الأسفل

98
00:06:58,540 --> 00:07:01,360
.حسناً، فاذر. لنذهب، غوتي

99
00:07:01,730 --> 00:07:04,730
.سمعتُ بأنّ كعكة حفل الزّفاف ستكون خياليّةً جدّاً

100
00:07:04,730 --> 00:07:08,060
.لا يُمكنني الإنتظار لرُؤية بودينغ ساما في فُستان
زِفاف

101
00:07:39,450 --> 00:07:40,260
.ماما

102
00:07:42,160 --> 00:07:44,730
.ها هي ماذر كراميل

103
00:07:46,770 --> 00:07:50,560
...نعم... مَحبوبتنا

104
00:07:50,590 --> 00:07:52,320
!ماذر...

105
00:07:52,320 --> 00:07:57,490
.أوه، من اللّطيف رُؤية ماذر تبتسم بإشراقٍ كالعادة

106
00:07:57,490 --> 00:07:59,160
.هي كالشّمس

107
00:08:02,930 --> 00:08:07,330
.هذا صحيح
!ماذر هي نُور العالَم

108
00:08:08,900 --> 00:08:11,250
...لا أعلَم من هي مع ذلك

109
00:08:11,520 --> 00:08:14,880
...هذه حفلة شايي الأُولى، لذا بشأن هذه السيّدة

110
00:08:14,880 --> 00:08:19,680
ما هي صِلتكِ بها، بيغ ماما؟

111
00:08:21,030 --> 00:08:23,280
...لا تتطفّل

112
00:08:23,330 --> 00:08:25,980
!على ذِكرياتي...

113
00:08:33,670 --> 00:08:36,420
!بصحّتكم

114
00:08:39,180 --> 00:08:40,940
كيف يجري كلّ شيءٍ في الأسفل هناك؟

115
00:08:40,940 --> 00:08:45,660
.إنتهى الطّهاة من الإعداد لحفلة الشّاي، لذا
يستمتعون بوَليمة

116
00:08:45,930 --> 00:08:49,390
.أغلَقنا جميع الممرّات بينما نفعل ذلك

117
00:08:49,390 --> 00:08:53,630
.جيّد. بإغلاقها، لَن يتمكّن أحدٌ من الصّعود لفترة

118
00:08:53,650 --> 00:08:58,380
سنعدّ الآن حلزونات الإرسال القرنيّة لتشويش إشارات
الرّاديو

119
00:08:58,380 --> 00:09:00,300
.و لعزل المَوقع

120
00:09:00,300 --> 00:09:03,990
.لا تنسا الإعداد لما تعلَم عنه أيضاً-
.نعم، سيّدي-

121
00:09:30,010 --> 00:09:32,340
.كلّ ما تبقّى لفِعله هو الإعداد له

122
00:09:32,340 --> 00:09:35,240
.ما نحتاجه في تلك الغُرفة

123
00:09:39,570 --> 00:09:41,360
!هاي

124
00:09:42,110 --> 00:09:45,280
ماذا تفعلان هناك؟

125
00:09:45,450 --> 00:09:49,770
...حسناً، نفذ منّا الشّراب، لذا أتينا للحُصول على
بعضٍ منه

126
00:09:49,770 --> 00:09:52,980
!أوه، نفِذ منكما أيضاً؟

127
00:09:52,980 --> 00:09:55,230
.من هُنا

128
00:09:57,960 --> 00:10:01,140
.لكنّكما لا تبدوان مألوفان

129
00:10:03,760 --> 00:10:05,400
ما الخطب-ريرو؟

130
00:10:06,860 --> 00:10:10,040
!أوه، سيّداي
!شُكراً لقيامكما بعمل جولات

131
00:10:10,300 --> 00:10:12,370
هل من خطب-ريرو؟

132
00:10:12,540 --> 00:10:16,630
.حسناً، يُوجد شخصان غير مألوفان
.رُبّما يكونان دخيلان

133
00:10:18,460 --> 00:10:22,450
للإحتياط فقط، هناك حاجةٌ للإعتناء بهذا الأمر،
صحيح، غوتي؟

134
00:10:22,610 --> 00:10:23,550
.نعم

135
00:10:27,450 --> 00:10:30,060
.كنتَ غير مَحظوظ-ريرو

136
00:10:34,790 --> 00:10:41,110
.أحضرنا لكِ هديّة، هديّةٌ مُشتركةٌ لكِ و
لابنتكِ-نين، تشارلوت

137
00:10:41,430 --> 00:10:44,530
!أوه، هذا صندوق كنز

138
00:10:44,530 --> 00:10:46,780
!الشّيء المُفضّل لَديّ

139
00:10:46,780 --> 00:10:49,330
.أتسائل عمّا يُوجد بداخله

140
00:10:49,600 --> 00:10:52,660
.أحضرتُ لكِ هديّةً أيضاً، لينلين

141
00:10:52,660 --> 00:10:55,040
!خُذي وَاحدةً منّي أيضاً

142
00:10:55,040 --> 00:10:58,630
.خاصّتي شيءٌ نادرٌ من الجّنوب

143
00:10:58,650 --> 00:11:02,590
.أوه-هاه! ذهبتُ إلى أقصى الشّمال

144
00:11:03,610 --> 00:11:08,990
!أنا مُمتنّةٌ جدّاً
!للحُصول على الكثير من الهدايا دائماً هكذا

145
00:11:08,990 --> 00:11:11,350
!شُكراً لكم

146
00:11:11,350 --> 00:11:13,970
!أنا سعيدةٌ جدّاً

147
00:11:13,970 --> 00:11:16,440
،بالحديث عن صندوق الكنز، ماميغو

148
00:11:16,830 --> 00:11:19,730
.سمعتُ بأنّكِ حصلتِ على كنزٍ عظيمٍ من تحت البِحار

149
00:11:19,960 --> 00:11:21,030
أوه؟

150
00:11:21,440 --> 00:11:25,450
.تملك آذاناً سريعة
.هذا هو عزيزي مورغانز

151
00:11:25,450 --> 00:11:27,100
.و هذا صحيح

152
00:11:27,720 --> 00:11:32,750
.صندوق الكنز الذي تمّ توريثه لأجيالٍ بين أفراد
العائلة المالِكة تحت البِحار

153
00:11:34,040 --> 00:11:39,340
.لسببٍ ما، تركه نيبتون و هو هُنا الآن

154
00:11:42,900 --> 00:11:46,450
...هذا هو صندوق

155
00:11:46,860 --> 00:11:49,260
!تاماتي الأُسطوريّ...

156
00:11:51,120 --> 00:11:53,890
!أوه! أُنظُروا إلى فخامته

157
00:11:53,890 --> 00:11:55,390
ماذا بداخله؟

158
00:11:55,910 --> 00:11:58,400
!هل فتحتِه، ماميغو؟

159
00:11:58,750 --> 00:12:02,650
،في الوَليمة الضّخمة بعد حفل زفاف بودينغ

160
00:12:02,650 --> 00:12:08,610
!سأفتحه مع هدايا الجّميع، و أُريه لكم جميعاً

161
00:12:08,840 --> 00:12:10,910
!لا يُمكنني الإنتظار

162
00:12:14,380 --> 00:12:16,660
!أشعر بالإثارة لرُؤية مثل هذه اللّحظة الثّمينة

163
00:12:17,060 --> 00:12:22,480
!كنتُ بانتظار هذا اليوم أيضاً

164
00:12:27,070 --> 00:12:28,220
!فاذر

165
00:12:28,780 --> 00:12:30,790
أوه، هل انتهيتُم؟

166
00:12:30,790 --> 00:12:33,260
.إنتهت جميع الإستعدادات-ريرو

167
00:12:33,430 --> 00:12:35,350
.حسناً. عملٌ جيّد

168
00:12:35,530 --> 00:12:37,790
.أيّها الرّفاق، إذهبوا لتبديل ملابسكم

169
00:12:37,910 --> 00:12:38,770
.نعم، سيّدي

170
00:12:41,810 --> 00:12:43,740
.سيزر، أخرِج المِرآة

171
00:12:43,740 --> 00:12:45,990
!أيّها الوَغد! دعوتَني بذلك الإسم ثانيةً

172
00:12:47,800 --> 00:12:50,330
.إذاً هذا هو المَدخل لحفلة الشّاي

173
00:12:51,550 --> 00:12:56,000
!إستمتعوا بها على قدر استطاعتكم، يا فاشلي العالَم

174
00:12:56,650 --> 00:12:58,500
سيزر كلاون؟

175
00:12:58,770 --> 00:13:00,790
.أنتَ فاشلٌ أيضاً

176
00:13:00,790 --> 00:13:03,880
.إختبئ فقط في تلك المِرآة في مكانٍ ما هُنا

177
00:13:03,880 --> 00:13:05,840
!إخرَس! أعلَم

178
00:13:06,030 --> 00:13:08,380
،عندما تبدأ بيغ ماما بصرخة رُعبها

179
00:13:08,380 --> 00:13:13,250
.أحضر تلك المِرآة و اقتحم القاعة
.هذا عملك

180
00:13:14,620 --> 00:13:17,640
.هذا طريق هُربنا الوَحيد

181
00:13:18,160 --> 00:13:21,060
.تأكّد من ألّا تخطُر ببالك أيّة أفكار

182
00:13:21,060 --> 00:13:23,480
!تأخّر الوَقت كثيراً لكي أخونك

183
00:13:23,500 --> 00:13:26,690
!أوه، لا
!يُخطّط بيجي و رِفاقه لشيءٍ ما

184
00:13:35,010 --> 00:13:36,720
.تخلّصتُ منها

185
00:13:36,930 --> 00:13:40,830
.تسريبات المَعلومات ستجلِب أزمةً غير مُتوَقّعة

186
00:13:41,100 --> 00:13:43,790
.بقيَت 30 دقيقةً على حفل الزّفاف

187
00:13:43,790 --> 00:13:49,030
هل قُبّعة القشّ و الآخرون مُستعدّون؟
...آمَل أنّه لا يلهو في الأرجاء كمُغفّلٍ ثانيةً

188
00:13:49,350 --> 00:13:53,470
!تفقّد الأمر بنفسك
!إنّهم داخل جسدك

189
00:14:10,170 --> 00:14:13,380
!هاي، أيّها المُغفّلون! لِمَ أنتُم نائمون؟

190
00:14:13,430 --> 00:14:15,070
!يُفترض أن تستعدّوا

191
00:14:15,640 --> 00:14:17,490
.دعهم ينامون

192
00:14:17,830 --> 00:14:21,120
.يبدو بأنّهم لَم يناموا كثيراً منذ وُصولهم

193
00:14:21,120 --> 00:14:23,420
.سأُوقِظهم قبل 10 دقائق

194
00:14:23,600 --> 00:14:25,290
.لا يُمكنني تصديق هذا

195
00:14:25,290 --> 00:14:28,590
.سأتخلّى عنهم حالما يُعيقون طريقي

196
00:14:28,820 --> 00:14:30,300
.لا مُشكلة

197
00:14:31,490 --> 00:14:35,430
.أحميهم و أستعدّ لأجلهم

198
00:14:43,630 --> 00:14:46,220
.أولئكَ المُغفّلون... كم هذا سخيف

199
00:14:46,220 --> 00:14:46,980
!أعلَم

200
00:14:48,540 --> 00:14:50,860
.تحتاج للعودة إلى الدّاخل

201
00:14:51,610 --> 00:14:54,490
.سأدخل القاعة

202
00:14:54,490 --> 00:14:57,170
!جميعكم، إستعدّوا

203
00:14:58,890 --> 00:15:01,100
،حال دُخولنا

204
00:15:03,140 --> 00:15:05,420
!لَن تكون هناك عودة

205
00:15:07,940 --> 00:15:10,850
...آمَل أن تكون مُستعدّاً أيضاً

206
00:15:12,240 --> 00:15:14,480
!فينسموك سانجي

207
00:15:36,630 --> 00:15:38,110
!كلّا! كلّا

208
00:15:38,720 --> 00:15:42,580
!إنّها ظريفةٌ جدّاً، لكن لا تُخدَع

209
00:15:44,810 --> 00:15:46,020
...أنا

210
00:15:46,350 --> 00:15:49,420
...لَم أُخطّط للزّواج عندما أتيتُ إلى هُنا، لذا

211
00:15:50,210 --> 00:15:55,260
...من الغريب عليّ حقّاً الجّلوس إلى جانبكِ هكذا
الآن

212
00:15:55,610 --> 00:15:57,840
...أشعر كما لَو كنتُ أحلُم

213
00:15:59,170 --> 00:16:01,180
.إبقى هادئاً، إبقى هادئاً

214
00:16:01,180 --> 00:16:03,220
.لَن أُخدَع ثانيةً

215
00:16:10,530 --> 00:16:12,020
...هل هو

216
00:16:13,880 --> 00:16:17,610
حُلمٌ جيّدٌ أم سيّء؟...

217
00:16:18,510 --> 00:16:21,200
!أوه، يا رجل، إنّها ظريفةٌ جدّاً

218
00:16:21,200 --> 00:16:24,720
!بـ... بالتّأكيد، إنّه حُلمٌ جيّد

219
00:16:24,930 --> 00:16:27,310
!حقّاً؟! هذا جيّد

220
00:16:27,700 --> 00:16:29,670
!هاي، إهدأ

221
00:16:29,670 --> 00:16:31,810
!إنّها تُمثّل فقط

222
00:16:32,210 --> 00:16:34,670
!إنّها تُخطّط لقتلي

223
00:16:39,410 --> 00:16:40,820
أوه؟

224
00:16:40,870 --> 00:16:45,070
...رُبّما كنتُ أحلُم فقط في الوَاقع

225
00:16:45,070 --> 00:16:48,830
!كلّا، كلّا، كلّا! لا تُخدَع
!صدّق ما رأيتَه

226
00:16:49,130 --> 00:16:51,750
سانجي سان، هل من خطب؟

227
00:16:51,750 --> 00:16:55,670
...ماذا؟ كـ-كلّا، كلّا، كلّا! الأمر فقط

228
00:16:56,960 --> 00:16:58,260
!أوه، نعم

229
00:16:59,240 --> 00:17:02,950
...بـ-بشأن قُبلة الزّفاف... أمم

230
00:17:02,950 --> 00:17:07,790
...في حال كنتِ تُوَاجهين مُشكلةً
...بفِعلها للمرّة الأُولى أمام الآخرين

231
00:17:07,790 --> 00:17:10,870
...لا-لا أُمانع تقبيلكِ على جبينكِ أو

232
00:17:12,900 --> 00:17:16,550
.قبّلني على فمي
.سنُصبح زوجاً و زوجة

233
00:17:35,370 --> 00:17:36,860
!ماذا كان ذلك؟

234
00:17:37,630 --> 00:17:40,200
!إصطدم سانجي ساما بالسّقف؟

235
00:17:41,720 --> 00:17:43,930
كيف انتهى به الأمر هكذا؟

236
00:17:43,930 --> 00:17:45,870
!إنّه ينزف كثيراً

237
00:17:45,870 --> 00:17:47,160
!أوه، لا

238
00:17:48,430 --> 00:17:49,930
!سانجي سان

239
00:17:50,770 --> 00:17:53,830
!ما خطب عفريت المِياه القذِرة اللّعين ذاك؟

240
00:17:53,830 --> 00:17:56,000
!أُريد قتلَه بسرعة

241
00:18:26,530 --> 00:18:28,410
.لا تبدين سعيدة

242
00:18:29,470 --> 00:18:31,230
...كلّا، أنا سعيدة

243
00:18:31,390 --> 00:18:36,060
.لنستمتع
.إنّه يومٌ مُهمٌّ لأخونا و أُختنا العزيزان

244
00:18:36,230 --> 00:18:37,040
...نعم

245
00:18:45,160 --> 00:18:46,970
كلّ شيءٍ على ما يُرام، صحيح؟

246
00:18:47,490 --> 00:18:49,890
.نعم... لا يُوجد خطب

247
00:18:50,380 --> 00:18:55,100
.هذا جيّد
.اليوم أكثر تميّزاً عن أيّ يومٍ آخر

248
00:18:55,900 --> 00:18:58,570
.لا تخفض من دِفعاتك. لَعق

249
00:18:59,380 --> 00:19:00,880
.أعلَم

250
00:19:05,300 --> 00:19:10,040
.سعيدةٌ لأنّه يبدو بأنّكَ تستمتع بوَقتك، جادج

251
00:19:10,040 --> 00:19:14,160
!بالتّأكيد أفعل
!هذا أفضل يومٍ في حياتي

252
00:19:14,160 --> 00:19:20,170
!لي أيضاً
!لأنّنا سنُصبح عائلةً قريباً

253
00:19:20,460 --> 00:19:23,120
...في النورث بلو... كلّا

254
00:19:24,640 --> 00:19:28,340
...ستُصبح أقوى عائلةٍ في العالَم قريباً

255
00:19:29,160 --> 00:19:30,980
!بصحّتك

256
00:19:58,940 --> 00:20:00,360
.بانغ

257
00:20:02,940 --> 00:20:04,400
نعم؟

258
00:20:04,820 --> 00:20:08,780
.حان الوَقت تقريباً
.أرجوكما إتّجها إلى المَوقع

259
00:20:09,110 --> 00:20:11,810
سانجي سان، هل أنتَ مُستعدّ؟

260
00:20:12,330 --> 00:20:13,310
.نعم

261
00:20:15,500 --> 00:20:16,890
هلّا ذهبنا؟

262
00:20:17,290 --> 00:20:19,670
...لَقد حان الوَقت أخيراً

263
00:20:19,920 --> 00:20:22,790
!أشعر بالتّوَتّر و الحماس أيضاً

264
00:20:22,790 --> 00:20:24,090
.أنا أيضاً

265
00:20:25,920 --> 00:20:27,510
...أنا حقّاً

266
00:20:27,680 --> 00:20:30,030
.مُتحمّسةٌ جدّاً...

267
00:20:36,020 --> 00:20:40,400
!إنّها السّاعة الـ12! إنّها السّاعة الـ12

268
00:21:03,210 --> 00:21:09,030
!حسناً، أيّها السيّدات و السّادة
!إنّه حدَث اليوم الرّئيسيّ

269
00:21:09,220 --> 00:21:13,990
...الإبنة الثّالثة و الثّلاثون لعائلة تشارلوت،
تشارلوت بودينغ ساما، و

270
00:21:13,990 --> 00:21:18,370
...الإبن الثّالث لعائلة فينسموك، فينسموك سانجي
ساما

271
00:21:18,370 --> 00:21:20,580
...حفل الزّفاف الملَكيّ...

272
00:21:20,580 --> 00:21:23,110
!سيبدأ الآن...

273
00:21:27,610 --> 00:21:28,740
!زواج

274
00:21:28,900 --> 00:21:31,390
!زواج-
!زواج-

275
00:21:31,390 --> 00:21:33,780
!زواج

276
00:21:45,840 --> 00:21:48,130
!زواج-
!زواج-

277
00:21:49,220 --> 00:21:51,570
!كم هذا مُذهل

278
00:21:52,470 --> 00:21:57,240
!دون تأخير، ها هُما العريس و العروس

279
00:22:07,920 --> 00:22:08,880
!واو

280
00:22:15,490 --> 00:22:18,640
!إمبراطورة البِحار، قراصنة بيغ ماما

281
00:22:18,640 --> 00:22:23,420
!و الجيش الشرّير، جيرما 66

282
00:22:24,460 --> 00:22:29,440
!سيربط الزّوجان الشّابّان بين عائلَتيهما سيّئتا
السّمعة و أحلامها

283
00:22:31,050 --> 00:22:33,740
!زواج مَصلحة

284
00:22:36,950 --> 00:22:44,460
!بزواجهما، ستُزهر زهرةٌ شرّيرةٌ أُخرى بجُنونٍ في
هذا العالَم

285
00:22:45,060 --> 00:22:46,970
!حيّوهما

286
00:22:50,440 --> 00:22:52,360
!أُنظُروا إلى هذا

287
00:22:53,070 --> 00:22:55,970
!لهذا اليوم الجّميل جدّاً

288
00:23:00,120 --> 00:23:03,040
!إستسلِم

289
00:23:08,590 --> 00:23:09,900
!ذلك المُغفّل

290
00:23:11,420 --> 00:23:13,670
!ياله من مُمثّلٍ عظيم

291
00:23:16,510 --> 00:23:19,910
!سيبدأ حفل الزّفاف الدّمويّ الآن

292
00:23:29,860 --> 00:23:34,550
!عند مَذبحٍ على كعكة الزّفاف العملاقة، تمّ نذر
وَعدٍ للحُبّ

293
00:23:34,550 --> 00:23:38,400
!يتردّد قلب بودينغ و تنهمر الدّموع على خدّيها

294
00:23:38,400 --> 00:23:42,930
،عندما تُفعّل قُبلَة زفافهما الرّومانسيّة جميع
المَكائد ليتمّ تنفيذها

295
00:23:42,930 --> 00:23:46,230
!يَظهر لوفي أخيراً في حفلة الشّاي العاصفة

296
00:23:46,250 --> 00:23:47,650
!في الحلقة القادمة من وَن بيس

297
00:23:47,650 --> 00:23:51,030
"!قُبلَةٌ مُميتة! تبدأ مُهمّة اغتيال الإمبراطورة"

298
00:23:51,030 --> 00:23:53,410
!سأُصبح ملِك القراصنة