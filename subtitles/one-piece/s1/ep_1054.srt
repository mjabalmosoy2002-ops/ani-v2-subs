1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:02:12,190 --> 00:02:14,610
،مع اقتراب أونيغاشيما إلى بلاد وانو

19
00:02:14,610 --> 00:02:19,580
يواصل لوفي والبقيّة القتال من أجل
.القضيّة الّتي يؤمنون بها

20
00:02:26,250 --> 00:02:28,000
...بقي القليل فحسب

21
00:02:28,000 --> 00:02:30,130
...لكنّ الأهمّ هنا هو

22
00:02:31,630 --> 00:02:33,670
!أرواح من بداخلها

23
00:02:34,720 --> 00:02:37,600
!طُعنتُ فجأة

24
00:02:38,680 --> 00:02:41,850
...بإمكانك قتلي فقط

25
00:02:42,390 --> 00:02:45,810
.إذا ما قتلتَ قبطانك

26
00:02:45,810 --> 00:02:47,490
!سُحقًا لك

27
00:02:47,730 --> 00:02:50,570
!سأقتل كليكما

28
00:02:51,070 --> 00:02:54,070
!استمتعا بصحبة بعضيكما في الحياة الأخرى أيضًا

29
00:02:57,490 --> 00:03:01,460
!والآن، قم بما يجب القيام به. لا تتهاون

30
00:03:01,830 --> 00:03:03,750
!أنت تثير قرفي

31
00:03:08,540 --> 00:03:13,050
"!الموت لشريكك! مراهنة كيلر المميتة"

32
00:03:32,070 --> 00:03:33,660
!سيف القشّ

33
00:03:48,960 --> 00:03:51,970
ما الخطب؟ هل انتهى الأمر سلفًا؟

34
00:04:00,090 --> 00:04:01,890
!مستحيل

35
00:04:06,270 --> 00:04:07,730
لماذا تضحك؟

36
00:04:07,980 --> 00:04:12,950
ظننتُ أنّ لست من النّوع الّذي
...يضحك كثيرًا

37
00:04:16,570 --> 00:04:20,490
!أيعقل أنّك أكلت فاكهة سمايل؟

38
00:04:40,800 --> 00:04:42,680
!اسمع يا كيلر

39
00:04:42,930 --> 00:04:47,220
!سأمنحك فرصة لإنقاذ قبطانك إن أكلتَ هذه

40
00:04:47,220 --> 00:04:49,900
هيّا، ماذا ستفعل؟

41
00:05:27,220 --> 00:05:30,190
!هذه ذروة البؤس يا كيلر

42
00:05:31,560 --> 00:05:35,570
لم تصر عاجزًا عن التّوقّف عن الضّحك
...حتّى في حزنك فحسب

43
00:05:42,240 --> 00:05:44,700
...بل وصرتَ عاجزًا عن القتال أيضًا

44
00:05:45,200 --> 00:05:48,040
.يُلقى بك في كلّ الأرجاء كدمية الآن

45
00:05:50,330 --> 00:05:52,090
!اخرس يا هوكينس

46
00:05:54,120 --> 00:05:56,590
...أظنّ أنّك غاضب

47
00:05:57,170 --> 00:05:59,050
.لكن لا يبدو ذلك عليك

48
00:06:01,130 --> 00:06:03,390
،إن أردتَ أن أخرس

49
00:06:03,680 --> 00:06:06,180
فلماذا لا تردّ القتال؟

50
00:06:07,300 --> 00:06:10,150
.هيّا، اقطعني

51
00:06:11,770 --> 00:06:13,730
.لا حاجة للتّردّد

52
00:06:14,020 --> 00:06:17,360
،سواء كانت ساقي أو ذراعي أو رأسي

53
00:06:17,360 --> 00:06:20,160
.لك كامل الحرّيّة لاختيار ما تشاء

54
00:06:20,530 --> 00:06:21,570
!هيّا

55
00:06:24,320 --> 00:06:25,990
!انظروا هناك

56
00:06:26,240 --> 00:06:27,200
!كيلر-سان

57
00:06:28,330 --> 00:06:29,460
!يا رفاق

58
00:06:30,040 --> 00:06:31,750
.وصل رفاقك

59
00:06:31,750 --> 00:06:33,870
!بازيل هوكينس

60
00:06:33,870 --> 00:06:36,090
!صرتَ من أتباع كايدو

61
00:06:38,040 --> 00:06:40,430
!كيف أمكنك أن تخوننا؟

62
00:06:41,420 --> 00:06:43,850
!أرجوكم... توقّفوا

63
00:06:45,430 --> 00:06:49,390
.لن أمنحكم الإذن بأذيّته

64
00:06:49,390 --> 00:06:53,560
!كيلر-سان! لماذا لا نستطيع مساعدتك؟

65
00:06:56,650 --> 00:06:58,860
!لأنّ ذلك سيعني موت كيد

66
00:07:03,070 --> 00:07:06,290
.أخذت قبطانكم كرهينة

67
00:07:08,450 --> 00:07:10,290
.هذه دمية كيد القشّيّة

68
00:07:11,040 --> 00:07:15,340
.سيتكبّد كلّ الضّرر الّذي قد أتلقّاه أنا

69
00:07:15,830 --> 00:07:18,550
،إن قطعتم عنقي

70
00:07:19,040 --> 00:07:21,010
!فإنّ عنق كيد هو الّذي سيُقطع

71
00:07:21,380 --> 00:07:23,390
،إن طعنتم قلبي

72
00:07:23,390 --> 00:07:26,810
.فإنّ قلب كيد سيتوقّف عن النّبض

73
00:07:27,590 --> 00:07:29,350
!سُحقًا لك

74
00:07:30,390 --> 00:07:34,100
،يبدو أنّه يقاتل بيغ مام الآن

75
00:07:34,310 --> 00:07:37,570
...إنّها معركة خاسرة سلفًا

76
00:07:38,020 --> 00:07:40,780
،إن تلقّى ضررًا هو عن غنى عنه

77
00:07:41,570 --> 00:07:44,360
.فلن ينجو بكلّ تأكيد

78
00:07:46,320 --> 00:07:48,530
!إنّك لا تقاتل بإنصاف

79
00:07:48,530 --> 00:07:51,460
!سُحقًا! ما الّذي يجدر بنا فعله؟

80
00:07:51,780 --> 00:07:54,540
.لا يتطلّب الأمر الكثير من التّفكير

81
00:07:55,660 --> 00:07:59,840
.ليس لديكم الكثير من الخيارات

82
00:08:05,760 --> 00:08:07,630
!كيلر-سان

83
00:08:07,630 --> 00:08:10,470
...إمّا أن تسمح لي بتقطيعك

84
00:08:13,560 --> 00:08:17,190
.أو تترك كيد لحتفه وتقاتلني

85
00:08:25,570 --> 00:08:29,030
.لن أهاجمك أبدًا

86
00:08:29,490 --> 00:08:33,500
.ذلك خيار مملّ لعرض جانبي كهذا

87
00:08:33,870 --> 00:08:35,080
،في تلك الحالة

88
00:08:35,410 --> 00:08:37,670
.لديّ فكرة

89
00:08:47,720 --> 00:08:50,340
.عجبًا، عجبًا، عجبًا

90
00:08:50,340 --> 00:08:52,560
ما الخطب؟

91
00:08:53,850 --> 00:08:55,270
...سُحقًا

92
00:08:55,720 --> 00:08:57,520
!أنت! ما الّذي يحدث؟

93
00:08:58,020 --> 00:09:00,230
!يوستاس-يا! تراجع في الحال

94
00:09:01,310 --> 00:09:02,610
!اخرس

95
00:09:06,860 --> 00:09:12,370
!سأعطيكما علاجًا ينفع جيّدًا مع الأشقياء السّيّئين

96
00:09:14,990 --> 00:09:16,490
...الوتر

97
00:09:16,490 --> 00:09:18,170
!المغناطيسيّ

98
00:09:18,200 --> 00:09:20,970
!ارقد بسلام

99
00:09:31,550 --> 00:09:35,310
!قلق شمطاء مثلك عليّ لا يشعرني بالسّعادة

100
00:09:35,310 --> 00:09:37,180
!شقيّ قذر

101
00:09:37,180 --> 00:09:40,270
!يجدر أن تتشرّف بهذا! يا وقاحتك

102
00:09:42,140 --> 00:09:43,230
!بروميثيوس

103
00:09:43,230 --> 00:09:45,240
!حاضر يا ماما

104
00:09:46,190 --> 00:09:49,570
!اشوِ ذلكما الوغدين

105
00:09:49,570 --> 00:09:52,160
!النّار المقدّسة

106
00:10:04,290 --> 00:10:06,970
.يجب معاقبتك

107
00:10:07,800 --> 00:10:09,340
!يا ترافالغار

108
00:10:10,960 --> 00:10:12,800
!لم يكن ذلك ضروريًّا

109
00:10:23,640 --> 00:10:26,780
!ما سبب هذه الآلام؟

110
00:10:30,650 --> 00:10:32,200
!ما خطبك؟

111
00:10:34,990 --> 00:10:38,210
ما الخطب؟ أتعاني من الصّداع؟

112
00:10:38,780 --> 00:10:39,960
!كيد

113
00:10:40,200 --> 00:10:41,330
!سُحقًا

114
00:10:41,330 --> 00:10:42,700
!هيّا يا هيرا

115
00:10:42,700 --> 00:10:44,590
!حاضرة يا ماما

116
00:10:45,040 --> 00:10:46,080
!نابوليون

117
00:10:46,080 --> 00:10:47,540
!حاضر يا ماما

118
00:10:47,540 --> 00:10:50,210
،إن كان يؤلمك رأسك بشدّة

119
00:10:50,210 --> 00:10:54,420
!فسأخلّصك منه

120
00:10:54,420 --> 00:10:55,970
!اتّحاد

121
00:10:58,310 --> 00:11:00,150
!كن شكورًا

122
00:11:00,650 --> 00:11:03,520
!ما الّذي تفعله؟! لا فائدة منك

123
00:11:03,890 --> 00:11:05,650
!أنت تعترض طريقي أيّها الطّبيب الدّجّال

124
00:11:07,270 --> 00:11:08,360
!تبادل

125
00:11:09,980 --> 00:11:11,830
!صدمة مضادّة

126
00:11:14,280 --> 00:11:15,530
!ماما

127
00:11:15,530 --> 00:11:17,660
!كيف تجرؤ على فعل ذلك بها؟

128
00:11:18,410 --> 00:11:21,080
!النّار المسروقة

129
00:11:39,850 --> 00:11:41,900
!غارة ماما

130
00:11:54,070 --> 00:11:56,120
...والآن

131
00:11:56,490 --> 00:11:59,320
رأس غبيّ جريء

132
00:11:59,320 --> 00:12:01,370
...وذراع طبيب دجّال

133
00:12:01,370 --> 00:12:04,370
أيّهما أقطع أوّلاً؟

134
00:12:15,760 --> 00:12:17,470
...سُحقًا

135
00:12:17,470 --> 00:12:20,680
!تسنّت لي مواجهة أحد اليونكو أخيرًا

136
00:12:21,090 --> 00:12:23,640
...إن متّ هنا، فما كانت

137
00:12:23,640 --> 00:12:26,310
!الغاية من حياتي كقرصان؟

138
00:12:34,520 --> 00:12:36,940
!كم أنت مضحك

139
00:12:36,940 --> 00:12:38,620
!يا كيد

140
00:12:44,620 --> 00:12:45,830
!يوستاس-يا

141
00:12:45,830 --> 00:12:49,710
أعتقد أنّك ستموت في كلّ الأحوال
.حتّى إن لم أقتلك أنا

142
00:13:10,060 --> 00:13:10,940
!توقّف

143
00:13:10,940 --> 00:13:13,360
!توقّف يا هوكينس

144
00:13:14,150 --> 00:13:16,400
.إنّك مثير للشّفقة يا كيلر

145
00:13:16,400 --> 00:13:17,740
!توقّف

146
00:13:27,160 --> 00:13:28,500
...سُحقًا

147
00:13:29,040 --> 00:13:31,550
!ما الّذي يحدث؟

148
00:13:31,710 --> 00:13:34,380
!حرّر كيد

149
00:13:42,760 --> 00:13:43,850
...وفي المقابل

150
00:13:45,800 --> 00:13:47,520
...يمكنك الحصول

151
00:13:47,890 --> 00:13:49,480
!على حياتي أنا

152
00:14:09,040 --> 00:14:10,540
!كيلر-سان

153
00:14:12,790 --> 00:14:16,420
.ستصير الأمور أسهل بالنّسبة لك بمجرّد زوال كيد

154
00:14:16,420 --> 00:14:21,760
.كلّ ما عانيته من بؤس كان بسببه

155
00:14:26,850 --> 00:14:28,430
!كم هذا محبط

156
00:14:28,430 --> 00:14:32,770
!النّيران تقترب منّا أيضًا
!علينا الخروج من هنا بسرعة

157
00:14:32,770 --> 00:14:35,480
،لو لم تتمرّد على كايدو-سان

158
00:14:35,810 --> 00:14:40,660
...ما كنتَ لتعاني مصيرًا بائسًا كهذا

159
00:14:41,230 --> 00:14:44,240
...إنّك لا تفهم

160
00:14:44,240 --> 00:14:45,540
.يا هوكينس

161
00:14:49,530 --> 00:14:54,160
إنّه محقّ! كيف تجرّأت على تحويل
!كيلر-سان لشخص مبتهج؟

162
00:14:54,160 --> 00:14:57,630
!ستصير طاقم قراصنة مبتهج أيضًا

163
00:14:57,630 --> 00:15:02,220
!سأرسل كلّ من يضحك عليك للجحيم

164
00:15:04,340 --> 00:15:09,470
كيد هو الرّجل الّذي سيتجاوز اليونكو
!وسيصير ملك القراصنة

165
00:15:09,470 --> 00:15:13,690
!ولن نموت هنا

166
00:15:18,560 --> 00:15:20,360
!توقّف

167
00:15:24,820 --> 00:15:28,580
السّعي خلف اليونكو ولقب ملك القراصنة؟

168
00:15:28,820 --> 00:15:31,670
!من الجيّد أنّ لديكم طموحات كبيرة كهذه

169
00:15:35,540 --> 00:15:37,670
!لا تقف في طريقنا إذًا

170
00:15:37,670 --> 00:15:42,260
!اقطعني بمنجليك هاتين إن كنتُ أقف في طريقك

171
00:15:46,760 --> 00:15:49,060
.أو بإمكانك الاستسلام

172
00:15:49,510 --> 00:15:52,810
.سأحدّث كايدو-سان بالحسنى عنك

173
00:15:56,230 --> 00:15:59,860
هل تخبرني أن أصير تحت جناح كايدو؟

174
00:16:00,360 --> 00:16:03,280
...هذا مثير للشّفقة

175
00:16:08,320 --> 00:16:09,410
!اخرس

176
00:16:09,410 --> 00:16:13,660
!لا يمكنكم القتال في هذه المعركة على أيّ حال

177
00:16:13,660 --> 00:16:15,580
!رأيتم الواقع الأليم، صحيح؟

178
00:16:16,370 --> 00:16:20,250
صرتم تعرفون الآن سبب فرض سيطرتهم
!على البحر كلّ هذا الوقت

179
00:16:20,250 --> 00:16:23,800
!أعلم أنّ غرائزك تنبؤك بهذا

180
00:16:23,800 --> 00:16:25,550
!مستحيل أن تفوزوا

181
00:16:31,600 --> 00:16:33,980
أنت نادم، صحيح؟

182
00:16:34,930 --> 00:16:37,480
.نادم على خيارك

183
00:16:50,280 --> 00:16:55,250
استطاع ذلك العجوز اللّحية البيضاء
...الموت ميتة جيّدة

184
00:17:07,340 --> 00:17:10,100
أنتم من الجيل الأسوأ، صحيح؟

185
00:17:10,430 --> 00:17:13,680
.أشقياء يحاولون التّظاهر بالقوّة

186
00:17:16,140 --> 00:17:20,600
،إن كنتم ستصيرون أتباعًا عندي
...فسأرحّبك بكم

187
00:17:20,600 --> 00:17:22,730
...وإن رفضتم

188
00:17:28,820 --> 00:17:34,950
،كنتَ خائفًا من الموت
.لكنّنا ما زلنا على قيد الحياة

189
00:17:37,330 --> 00:17:41,920
!سترى من منّا سيندم على خياراته

190
00:17:41,920 --> 00:17:43,510
.حسنًا

191
00:17:45,290 --> 00:17:46,760
...في تلك الحالة

192
00:17:47,170 --> 00:17:49,890
.سأحاول ألاّ أندم على شيء

193
00:17:50,180 --> 00:17:51,600
!إمّا أن تخيب أو تصيب

194
00:18:03,900 --> 00:18:05,360
!سيتعبك ذلك فحسب

195
00:18:08,320 --> 00:18:11,070
!الوداع أيّها الشّقيّ القذر

196
00:18:15,990 --> 00:18:18,330
.لديّ سؤالين لك

197
00:18:23,870 --> 00:18:27,880
...ماذا سيحدث إن تلقّيتَ ضررًا

198
00:18:28,300 --> 00:18:30,340
لن يصبّ في أيّ مكان؟

199
00:18:31,170 --> 00:18:32,640
عمّ تتحدّث؟

200
00:18:32,880 --> 00:18:35,720
!تعرف كيف تعمل قدراتي

201
00:18:36,180 --> 00:18:39,690
!سيتكبّد كيد كلّ الضّرر الّذي أتلقّاه

202
00:18:40,310 --> 00:18:45,060
!ما دامت دميته القشّيّة مخزّنة داخل جسدي

203
00:18:45,060 --> 00:18:46,570
!فهمت

204
00:19:13,840 --> 00:19:17,270
!لماذا قُطعت ذراعي أنا؟

205
00:19:17,590 --> 00:19:19,680
...كلّ الضّرر يجب أن

206
00:19:20,470 --> 00:19:21,560
...إنّ كيد

207
00:19:22,020 --> 00:19:23,440
...ليس لديه

208
00:19:23,930 --> 00:19:24,940
!ذراع يسرى

209
00:19:30,400 --> 00:19:33,110
!سُحقًا! لم أتوقّع ذلك

210
00:19:36,400 --> 00:19:38,500
.سؤالي الثّاني

211
00:19:41,740 --> 00:19:46,380
إن أخذتُ هذه، كم بقيت هنالك
من حياة لتحميك؟

212
00:19:58,510 --> 00:20:01,640
.تهانينا! كانت تلك آخر واحدة

213
00:20:03,140 --> 00:20:06,690
اختفى الألم؟

214
00:20:16,610 --> 00:20:18,780
!أوراق رجل القشّ

215
00:20:18,780 --> 00:20:22,710
.ورقة الموت مستقيمة
!إنّها ورقة الدّمار

216
00:20:49,100 --> 00:20:50,730
!المخالب قاطعة الرّأس

217
00:20:53,150 --> 00:20:54,780
!...إنّ رجل القشّ

218
00:21:01,820 --> 00:21:03,870
!لن يموت رجل القشّ

219
00:21:04,120 --> 00:21:06,620
!سيعود إن كان ذلك هو تنبّؤ الأوراق

220
00:21:06,620 --> 00:21:09,170
!اكشفي لي عن نتيجة هذه المعركة

221
00:21:15,800 --> 00:21:17,090
!البرج

222
00:21:21,720 --> 00:21:23,600
!سيوف الصّوت الدّوّارة

223
00:21:42,410 --> 00:21:44,870
!نجحت يا كيلر-سان

224
00:21:54,380 --> 00:21:57,430
!هوكينس-سان

225
00:21:58,590 --> 00:22:01,720
...ورقة رجل القشّ... البرج

226
00:22:10,020 --> 00:22:11,520
...إنّها تعني

227
00:22:16,270 --> 00:22:18,740
..."انهيار القديم"

228
00:22:21,860 --> 00:22:26,070
.ما الخطب؟ عادت لك الحياة فجأة

229
00:22:26,070 --> 00:22:27,410
!يا كيد

230
00:22:28,490 --> 00:22:31,540
.نعم، صار جسدي أخفّ بكثير

231
00:22:35,000 --> 00:22:37,170
...معناها الخفيّ

232
00:22:37,840 --> 00:22:39,880
."طريق جديد"

233
00:22:51,770 --> 00:22:54,480
!هيّا يا شريكي

234
00:23:04,610 --> 00:23:07,910
.يزداد إصرار أوروتشي تدريجيًّا حتّى وهو في مأزق

235
00:23:07,910 --> 00:23:12,700
.يعيد هذا إحياء روح كانجورو الّذي يُحتضر كممثّل

236
00:23:12,700 --> 00:23:16,170
تتحوّل القلعة الّتي تعمّها الفوضى
ويحيط بها الكره إلى مسرح كبير

237
00:23:16,170 --> 00:23:21,760
للقيام بعرض لا يحدث سوى مرّة كلّ جيل من
!قِبل عشيرة كوروزومي المشتعلة بنيران الانتقام

238
00:23:22,510 --> 00:23:23,590
:في الحلقة القادمة من وان بيس

239
00:23:23,590 --> 00:23:27,010
"!مناورات ظلال خفيّة! تلتهم النّيران أونيغاشيما"

240
00:23:27,010 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا