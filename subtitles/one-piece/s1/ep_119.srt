1
00:00:08,290 --> 00:00:11,330
!العالم... نعم

2
00:00:11,860 --> 00:00:13,530
...اسعوا نحو الحرّيّة

3
00:00:13,530 --> 00:00:17,570
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:18,030 --> 00:00:21,370
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,900 --> 00:00:23,370
!فتجاوزوها

6
00:00:23,670 --> 00:00:26,640
!تحت راية ما تؤمنون به

7
00:00:31,110 --> 00:00:36,720
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,720 --> 00:00:39,950
متّجهًا نحو عالم بلا نهاية

9
00:00:41,360 --> 00:00:46,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,230 --> 00:00:54,640
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,640 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,810
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,810 --> 00:01:10,450
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,450 --> 00:01:14,320
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,320 --> 00:01:19,260
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,260 --> 00:01:27,000
متّجهين نحو الأفق

17
00:01:27,000 --> 00:01:32,510
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,510 --> 00:01:37,210
متّجهًا نحو عالم بلا نهاية

19
00:01:37,210 --> 00:01:42,450
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,450 --> 00:01:48,720
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:53,690 --> 00:01:55,330
مشاعر أولئك الّذين يعانون من كرب

22
00:01:55,330 --> 00:01:57,600
.لاقت سحقًا من سحابة الرّمال الجافّة

23
00:01:58,500 --> 00:02:01,900
،هنالك من في الأمل ساعٍ
.وهنالك من فيه متشبّث

24
00:02:02,300 --> 00:02:04,440
تشابكت مشاعرهم وهم في ريبةٍ من أمرهم

25
00:02:04,770 --> 00:02:08,540
.واسمةً حقبةً من التّاريخ يختمها الحزن

26
00:02:09,980 --> 00:02:13,410
تستمرّ فيفي وأصدقاؤها في القتال
.من أجل إنقاذ أراباستا من أزمتها

27
00:02:15,850 --> 00:02:18,920
...إضافةً لانتصار أوسوبّ وتشوبّر

28
00:02:20,720 --> 00:02:24,290
.تمكّن سانجي من سحق السّيّد 2 بون كوري

29
00:02:36,040 --> 00:02:40,340
في نفس الأثناء، خاضت نامي
،قتالاً حاميًا ضدّ الآنسة دبلفينغر

30
00:02:40,340 --> 00:02:42,080
.الّتي تملك قوى فاكهة الأشواك

31
00:02:42,680 --> 00:02:44,380
!خذي هذه

32
00:02:44,750 --> 00:02:46,750
!جوّ الزّوبعة

33
00:03:02,530 --> 00:03:03,460
ماذا؟

34
00:03:03,460 --> 00:03:05,300
!...شبكت الحمامتان على جسدي

35
00:03:27,390 --> 00:03:31,830
وفي النّهاية، استطاعت نامي الفوز بالمعركة
.بفضل اختراع أوسوبّ، عصا الطّقس

36
00:03:33,390 --> 00:03:38,170
ليبقى قتال واحد قائم
.بين السّيّد 1 وزورو

37
00:03:41,370 --> 00:03:44,670
.إذًا أساسًا، جسدك صلب كالفولاذ

38
00:03:44,670 --> 00:03:47,840
،ما لم أكن قادرًا على قطع حتّى الفولاذ
فلن أستطيع الإطاحة بك، صحيح؟

39
00:03:48,280 --> 00:03:50,180
.كلامك صحيح

40
00:03:50,980 --> 00:03:53,410
.هجمات التّحطيم والقطع لا تفلح ضدّي

41
00:03:54,820 --> 00:03:57,280
.فهمت. هذا مزعج

42
00:03:57,280 --> 00:04:00,790
،بما أنّني لا أستطيع قطع الفولاذ بعد
.لا أستطيع أن أهزمك في الوقت الرّاهن

43
00:04:01,860 --> 00:04:03,160
وماذا ستفعل إذًا؟

44
00:04:03,160 --> 00:04:06,260
.لنرَ... سأتعاطف معك

45
00:04:06,260 --> 00:04:07,230
ماذا؟

46
00:04:08,130 --> 00:04:10,630
.كنتُ منتظرًا لوضع صعب كهذا

47
00:04:11,400 --> 00:04:15,240
فكّرتُ أنّه حان الوقت
.لأتقدّم بمستواي خطوةً

48
00:04:16,270 --> 00:04:18,410
،عندما أهزمك

49
00:04:18,740 --> 00:04:22,540
سأكون الرّجل الّذي يستطيع
.قطع حتّى الفولاذ

50
00:04:27,050 --> 00:04:32,250
سرّ المسايفة القويّة! القدرة"
".على قطع الفولاذ ونفَس كلّ شيء

51
00:04:35,260 --> 00:04:37,930
عندما تهزمني؟

52
00:04:38,530 --> 00:04:40,860
،قد يُحبط هذا حماسك

53
00:04:41,800 --> 00:04:45,430
،لكن مذ حصلتُ على قوى فاكهة القطع

54
00:04:45,430 --> 00:04:48,970
لم أتكبّد ولو خدشًا ممّن
.يسمّون أنفسهم سيّافة

55
00:04:50,040 --> 00:04:53,640
.لا يستطيع أيّ سيّاف هزيمتي

56
00:04:53,940 --> 00:04:56,480
...فهمت ما تقصد

57
00:04:56,480 --> 00:04:59,880
لكن يمكنك أن تحتفظ
.بكلّ حكاياتك لنفسك

58
00:05:00,280 --> 00:05:03,880
،لا أدري كم واجهت من سيّاف في الماضي

59
00:05:05,020 --> 00:05:08,120
.لكنّنا لم نتواجه من قبل

60
00:05:12,490 --> 00:05:14,800
.يبدو أنّ لسانك حادّ على الأقلّ

61
00:05:16,000 --> 00:05:18,200
.شكرًا يا أصلع

62
00:05:23,070 --> 00:05:24,910
.سنرى إلى متى ستصمد

63
00:05:25,270 --> 00:05:26,370
.وأنت أيضًا

64
00:06:09,620 --> 00:06:10,350
...قاطع

65
00:06:12,390 --> 00:06:13,590
!الغول

66
00:06:18,160 --> 00:06:19,310
...صيد

67
00:06:19,790 --> 00:06:21,030
!النّمور

68
00:06:53,190 --> 00:06:54,430
أولم أخبرك؟

69
00:06:58,900 --> 00:07:02,840
.من المفاجئ أنّك لم تتلقّ ولو خدشًا واحدًا

70
00:07:03,340 --> 00:07:06,610
هذه أوّل مرّة أيضًا يظلّ
...خصمي واقفًا

71
00:07:06,610 --> 00:07:08,410
.بعد أن ظننتُ أنّني أصبته بشدّة

72
00:07:09,010 --> 00:07:10,810
.بالطّبع

73
00:07:11,380 --> 00:07:15,020
.بما أنّنا لم نتواجه من قبل

74
00:07:24,860 --> 00:07:25,660
!صحيح

75
00:07:26,860 --> 00:07:29,400
.جسده كلّه من سيوف

76
00:07:29,400 --> 00:07:32,370
!لذا فإنّ سيوفه لا تملك مقدّمة أو مؤخّرة

77
00:07:36,340 --> 00:07:38,570
!الأقحوان المتلألئ

78
00:07:45,750 --> 00:07:48,120
...هـ-هذا

79
00:07:50,080 --> 00:07:51,090
.سأعصف بك

80
00:08:32,730 --> 00:08:35,430
،إن تعلّق الأمر بالتّدريب
.لقد تدرّبتُ أكثر من الجميع

81
00:08:38,930 --> 00:08:43,340
كما مررتُ بالكثير من المواقف
.الّتي كادت تودي بحياتي

82
00:08:45,640 --> 00:08:51,810
عندما أهزمك، سأكون الرّجل
.الّذي يستطيع قطع حتّى الفولاذ

83
00:08:52,180 --> 00:08:57,050
لم أتكبّد ولو خدشًا ممّن
.يسمّون أنفسهم سيّافة

84
00:08:58,590 --> 00:09:01,120
!ما الّذي ينقصني؟

85
00:09:03,590 --> 00:09:06,530
!سينسي! سينسي

86
00:09:07,560 --> 00:09:08,430
نعم؟

87
00:09:09,760 --> 00:09:14,440
أصحيحٌ أنّه يوجد في هذا العالم من
يستطيع قطع أيّ شيء، حتّى الفولاذ؟

88
00:09:17,140 --> 00:09:19,310
.نعم، ذلك صحيح

89
00:09:21,080 --> 00:09:24,450
.والآن، راقب هذه الورقة بإمعان يا زورو

90
00:09:31,050 --> 00:09:33,350
.سينسي، لم تقطعها

91
00:09:33,350 --> 00:09:35,190
.اسمع يا زورو

92
00:09:35,190 --> 00:09:40,730
.هنالك سيّافة لا يستطيعون قطع أيّ شيء

93
00:09:42,930 --> 00:09:48,870
،لكن بوسعهم قطع أيّ شيء أيضًا
.حتّى الفولاذ... وباستخدام السّيف عينه

94
00:09:50,200 --> 00:09:54,380
أقوى السّيافة يمكنهم حماية
ما يريدون حمايته

95
00:09:54,380 --> 00:09:56,680
.كما قطع ما يريدون قطعه

96
00:09:57,780 --> 00:10:01,950
...أمّا المسايفة الّتي تؤذي أيّ ما تمسّه

97
00:10:01,950 --> 00:10:04,050
.لا أعتبرها مسايفة حقيقيّة

98
00:10:04,450 --> 00:10:05,850
هل فهمت؟

99
00:10:28,710 --> 00:10:32,210
سينسي، سأكون سيّافًا
!يستطيع قطع أيّ شيء

100
00:10:33,280 --> 00:10:36,380
زورو، هل أصغيت لما قلت؟

101
00:10:49,590 --> 00:10:52,400
.أسرع وحاول قطعي

102
00:10:53,100 --> 00:10:56,570
.لا يمكنك قطعي بالدّفاع وحده

103
00:10:57,810 --> 00:11:03,880
مع الأسف، لا أظنّك تستطيع
...رؤية بسالتي وأنا أقطع الفولاذ

104
00:11:08,680 --> 00:11:13,620
.لأنّي عندما أقطعه، ستموت

105
00:11:15,090 --> 00:11:16,590
.كلامك منطقيّ

106
00:11:25,330 --> 00:11:29,200
!سأقطّع كلّ شيء... إربًا

107
00:11:31,410 --> 00:11:35,810
المسايفة الّتي لا تقطع أيّ شيء؟

108
00:11:55,130 --> 00:11:56,660
...لا فائدة

109
00:11:58,300 --> 00:12:02,040
!سأقطّع كلّ شيء... إربًا

110
00:12:03,370 --> 00:12:05,770
المسايفة الّتي لا تقطع أيّ شيء؟

111
00:12:06,770 --> 00:12:10,140
...لا أقطع أيّ شيء، لكن أقطع الفولاذ

112
00:12:10,140 --> 00:12:12,410
!لا أفهم ما يعنيه ذلك على الإطلاق

113
00:12:13,880 --> 00:12:15,320
!اطعن واطعن

114
00:12:15,320 --> 00:12:17,790
!هذا هو سرّ المسايفة القويّة

115
00:12:18,190 --> 00:12:20,250
!القطع الذّريّ

116
00:12:22,860 --> 00:12:24,390
!سأقطعك فحسب

117
00:12:53,220 --> 00:12:54,420
...قبضة

118
00:12:54,420 --> 00:12:55,360
!السّلطعون

119
00:13:17,110 --> 00:13:19,410
!يا لك من وغدٍ خبيث

120
00:13:20,720 --> 00:13:22,380
.وأنت أيضًا

121
00:13:23,150 --> 00:13:27,290
...دعني أخبرك شيئًا
.لا تعتبرني سيّافًا

122
00:13:27,990 --> 00:13:32,090
.أملك أسلحة كثيرة تستطيع تمزيقك إربًا

123
00:13:38,200 --> 00:13:39,570
!الحافر اللّولبيّ

124
00:13:44,340 --> 00:13:47,480
!إلّم تكن سيّافًا... هل أنت حفّار؟

125
00:13:47,880 --> 00:13:49,110
!أنا قاتل

126
00:13:54,580 --> 00:13:58,450
!شرارات؟! ما مدى سرعة دورانها؟

127
00:14:00,860 --> 00:14:02,020
!ستُصدّ

128
00:14:04,430 --> 00:14:06,660
...لا يمكنني أن أحفر

129
00:14:07,510 --> 00:14:09,830
.لأنّني سأقطع كلّ شيء إن حفرت

130
00:14:11,130 --> 00:14:12,030
!سحقًا

131
00:14:27,480 --> 00:14:30,250
...أسئ تقدير خصمك للحظة وسوف

132
00:14:31,950 --> 00:14:32,790
!تموت

133
00:15:04,220 --> 00:15:05,620
...ما زلتَ تتنفّس

134
00:15:11,460 --> 00:15:14,130
...لن أري ظهري له

135
00:15:16,260 --> 00:15:18,800
كيف ستكافح بيديك العاريتين؟

136
00:15:24,870 --> 00:15:30,180
.لستَ سيّافًا أساسًا
.لذا لن تفهم حتّى إن شرحت لك

137
00:15:31,680 --> 00:15:33,910
.لستُ مهتمًّا أساسًا

138
00:15:36,850 --> 00:15:39,520
!القاطع الفوضويّ

139
00:15:57,370 --> 00:15:58,970
...ارقد بسلام

140
00:16:02,040 --> 00:16:06,710
...حظّي سيّئ مع الصّخور اليوم

141
00:16:37,980 --> 00:16:42,580
يا رفاق! احرصوا على إرجاع
!فيفي إلى ديارها

142
00:16:43,320 --> 00:16:45,250
!لنتقابل في قصر ألوبارنا

143
00:16:49,820 --> 00:16:53,430
أهم بخير... جميعًا؟

144
00:17:09,210 --> 00:17:10,780
أنّى له أن يقف؟

145
00:17:11,450 --> 00:17:13,210
...بعد أن قطعتُه عدّة مرّات

146
00:17:13,750 --> 00:17:15,680
هل تجنّب كلّ تلك الصّخور المتساقطة؟

147
00:17:22,420 --> 00:17:25,230
تجنّبتُ... الصّخور؟

148
00:17:26,030 --> 00:17:26,860
...لا

149
00:17:27,900 --> 00:17:32,330
بل عرفتُ... المكان الّذي
...لن تسقط فيه

150
00:17:37,240 --> 00:17:38,370
...السّيوف

151
00:17:39,340 --> 00:17:43,010
...يمكنني أن أعرف أنّ إحداها
...تحت تلك الصّخرة

152
00:17:46,810 --> 00:17:48,180
ما الّذي يفعله؟

153
00:17:57,260 --> 00:17:59,790
...سبق وأن اختبرتُ هذا الشّعور

154
00:18:04,000 --> 00:18:06,000
...حيث يخيّم الصّمت من حولي

155
00:18:07,640 --> 00:18:10,170
...وأسمع دقّات قلبي بوضوح

156
00:18:13,940 --> 00:18:17,380
أهكذا... نشعر بالضّبط
عندما نكون على شفير الموت؟

157
00:18:20,310 --> 00:18:26,450
شعرتُ بتلميح من الصّخور
...المتساقطة وكأنّها كائنات حيّة

158
00:18:27,990 --> 00:18:31,430
...كلّا، لم يكن تلميحًا
...بل كان أكثر وضوحًا من ذلك

159
00:18:32,330 --> 00:18:33,530
...نفَس

160
00:18:35,100 --> 00:18:37,670
...نفس... الصّخور

161
00:18:38,470 --> 00:18:40,300
...للأشجار نفَسها

162
00:18:41,600 --> 00:18:43,500
...التّربة أيضًا

163
00:18:44,370 --> 00:18:46,110
أهذا ما في الأمر؟

164
00:18:47,340 --> 00:18:53,650
اسمع. هنالك سيّافة
.لا يستطيعون قطع أيّ شيء

165
00:18:56,020 --> 00:19:01,190
هل المقصود بـ"عدم قطع
أيّ شيء" هو معرفة النّفَس؟

166
00:19:02,390 --> 00:19:06,030
تلك هي... القدرة على
...قطع حتّى الفولاذ

167
00:19:07,900 --> 00:19:10,870
أيّها الوغد... ما الّذي فعلته؟

168
00:19:11,330 --> 00:19:13,670
...بعد أن تكبّدتَ هجومًا بليغًا

169
00:19:13,670 --> 00:19:15,900
...بعد أن نزفتَ كلّ هذا القدر

170
00:19:15,900 --> 00:19:18,070
!يستحيل أن تكون حيًّا

171
00:19:26,250 --> 00:19:30,750
...يمكنني سماع... نفَس فولاذه

172
00:19:32,050 --> 00:19:34,420
...إنّ إرادتي تتدفّق في السّيف

173
00:19:51,070 --> 00:19:56,010
فليكن... سأجهز عليه
.كليًّا بالهجوم التّالي

174
00:19:58,210 --> 00:19:59,350
...يبقى السّؤال

175
00:20:00,450 --> 00:20:05,250
.ما إن كنتُ قادرًا حقًّا على قطع الفولاذ

176
00:20:07,860 --> 00:20:11,760
من الصّعب أن أتخيّلك تدافع
.ضدّ هجومي بسيفٍ واحد فحسب

177
00:20:14,400 --> 00:20:17,730
.أصبت. اكتفيتُ من الدّفاع

178
00:20:18,800 --> 00:20:21,540
!أصبحت جاهزًا إذًا؟ فليكن

179
00:20:24,540 --> 00:20:28,910
:أسلوب السّيف الواحد
!أنشودة أسد الموت

180
00:20:29,580 --> 00:20:31,250
!التّدفّق الذّريّ

181
00:20:53,970 --> 00:20:55,370
...أشكرك

182
00:20:57,300 --> 00:20:59,870
!ما زال بوسعي أن أغدو أقوى

183
00:21:04,650 --> 00:21:10,920
...أصبح أقوى... في هذا القتال... بالفعل

184
00:21:15,320 --> 00:21:21,000
هل ستقطع... الماسّ أو ما شابه تاليًا؟

185
00:21:24,100 --> 00:21:26,070
...سيكون ذلك إسرافًا

186
00:21:28,600 --> 00:21:30,300
...لقد خسرت

187
00:22:06,640 --> 00:22:12,750
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

188
00:22:12,750 --> 00:22:18,690
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

189
00:22:18,690 --> 00:22:24,930
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

190
00:22:24,930 --> 00:22:30,360
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

191
00:22:30,360 --> 00:22:36,600
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

192
00:22:36,600 --> 00:22:42,040
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

193
00:22:42,810 --> 00:22:45,810
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

194
00:22:45,810 --> 00:22:49,580
دعنا نرسم قصّة المستقبل

195
00:22:49,880 --> 00:22:54,820
سأضع كلّ مشاعري
في رياح جديدة تمامًا الآن

196
00:22:54,820 --> 00:22:57,830
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

197
00:22:57,830 --> 00:23:00,830
رحلة لا نهاية لها لنكون معًا

198
00:23:00,830 --> 00:23:06,030
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

199
00:23:11,240 --> 00:23:12,640
لماذا تبكي؟

200
00:23:12,640 --> 00:23:15,540
لأنّ تلك الخلد الشّمطاء
...قالت أنّ لوفي مات

201
00:23:15,540 --> 00:23:16,680
!أهذا صحيح؟

202
00:23:16,680 --> 00:23:18,180
وهل تصدّقان ذلك؟

203
00:23:18,180 --> 00:23:19,780
!بالطّبع لا

204
00:23:19,780 --> 00:23:21,250
.امسحا مخاطكما إذًا

205
00:23:22,220 --> 00:23:24,620
!ما عدتم تملكون سببًا للقتال

206
00:23:24,620 --> 00:23:27,190
!استسلموا الآن! أيّها الجيش الملكيّ

207
00:23:27,190 --> 00:23:28,560
:في الحلقة القادمة من ون بيس

208
00:23:32,060 --> 00:23:34,330
!ملك القراصنة، لن يكون إلّا أنا