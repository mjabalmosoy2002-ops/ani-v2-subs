1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:12,570 --> 00:02:18,320
بعد التّسلّل إلى أونيغاشيما، يقترب
.لوفي والبقيّة من كايدو بوتيرة ثابتة

29
00:02:18,990 --> 00:02:22,370
...أمّا كيد الّذي قاتل أبو

30
00:02:43,050 --> 00:02:49,020
هل اعتقدت أنّ تحالفنا كان قويًّا
!كفاية للإطاحة بأحد اليونكو؟

31
00:02:49,020 --> 00:02:50,810
!كن واقعيًّا

32
00:02:53,620 --> 00:02:55,960
...إنّ تحالفات القراصنة في المقام الأوّل

33
00:02:55,960 --> 00:02:59,150
!نادرًا ما تكون لها نهاية سعيدة

34
00:02:59,150 --> 00:03:01,070
!خدش

35
00:03:01,070 --> 00:03:03,120
!تقطيع

36
00:03:06,240 --> 00:03:09,330
...ظننتُ أنّك ميت

37
00:03:09,770 --> 00:03:12,080
ماذا؟ كيد؟

38
00:03:13,880 --> 00:03:15,090
!أيّها الحثالة

39
00:03:15,090 --> 00:03:18,470
!سآخذ رأس كيد

40
00:03:30,930 --> 00:03:33,810
!أيّها المسنّن! لنسرع نحو القلعة

41
00:03:35,480 --> 00:03:38,550
!...ثـ...ثـ...ثـ

42
00:03:38,550 --> 00:03:41,950
!ثمّة منزل للمتعة

43
00:03:49,910 --> 00:03:54,080
يراودني شعور أنّ هنالك الكثير
!من النّساء الجميلات هناك

44
00:03:54,080 --> 00:03:55,960
!كلاّ يا سانجي

45
00:03:55,960 --> 00:03:59,300
!انتظر يا سانجي-دونو

46
00:04:00,040 --> 00:04:03,130
!وكأنّ هنالك من يجرّه إليه

47
00:04:04,800 --> 00:04:06,470
...إنّه

48
00:04:07,550 --> 00:04:11,770
...يبدو أنّه لم يستطع إيجاد أيّ نساء

49
00:04:16,650 --> 00:04:20,820
"!وصول التّعزيزات! قائد قراصنة اللّحية البيضاء"

50
00:04:32,580 --> 00:04:34,000
!تنافر

51
00:04:37,670 --> 00:04:40,300
!أيّها المسنّن، ما الّذي تفعله؟

52
00:04:41,630 --> 00:04:44,590
!يعرفون من نكون الآن في كلّ الأحوال

53
00:04:44,590 --> 00:04:46,390
!التزم بالخطّة

54
00:04:46,390 --> 00:04:48,990
!إلى الجحيم أنت والخطّة

55
00:04:48,990 --> 00:04:50,760
!سأقوم بالأمر فحسب

56
00:04:51,600 --> 00:04:52,890
!لا، مهلاً

57
00:04:55,230 --> 00:04:58,640
لا بدّ أنّ من الصّعب امتلاك قبطان
.سريع الهيجان هكذا

58
00:04:58,640 --> 00:05:00,360
.لا، ليس صعبًا

59
00:05:00,360 --> 00:05:03,320
!كيد رائع

60
00:05:03,320 --> 00:05:06,410
.حسنًا، لا يختلف وضعي عنك كثيرًا

61
00:05:21,170 --> 00:05:25,800
!أتشعر كأنّك بطل بإنقاذك لنا يا قبّعة القشّ؟

62
00:05:25,800 --> 00:05:27,510
!أنا لم أنقذكم

63
00:05:27,510 --> 00:05:30,600
!هذا ما قد يقوله شخص يشعر أنّه بطل

64
00:05:30,600 --> 00:05:33,060
!توقّف! أنت تزعجني

65
00:05:34,370 --> 00:05:37,640
!لماذا تتقاتلان؟! لا نحتاج لشجارات داخليّة الآن

66
00:05:37,640 --> 00:05:40,990
!عليك الإطاحة بأعدائك بهدوء

67
00:05:41,400 --> 00:05:43,820
هل نصغي إليه؟

68
00:05:43,820 --> 00:05:45,110
.سنقوم بما يحلو لنا

69
00:05:48,700 --> 00:05:52,370
!لن نمتثل لأيّ أحد بعد الآن

70
00:06:08,550 --> 00:06:10,520
...كان المكان فارغًا

71
00:06:11,090 --> 00:06:15,770
،وجدت منزل متعة، جنّة على الأرض
...لكن لم يكن هنالك أيّ أحد

72
00:06:16,140 --> 00:06:18,770
أهذا كابوس؟

73
00:06:20,890 --> 00:06:24,340
عدم وجود نساء في منزل المتعة
.يعني أنّ لا رجال هناك أيضًا

74
00:06:24,340 --> 00:06:26,570
!سنعبر ذلك الجسر الآن

75
00:06:26,570 --> 00:06:27,860
!نعم

76
00:06:27,860 --> 00:06:30,490
!حظًّا سعيدًا يا فريق التّسلّل

77
00:06:30,490 --> 00:06:32,160
!أجل

78
00:06:33,570 --> 00:06:35,580
!جيّد! هذه هي الرّوح المطلوبة

79
00:06:35,910 --> 00:06:38,080
!ليتبعني بقيّتكم

80
00:06:38,080 --> 00:06:40,000
!أجل

81
00:06:43,960 --> 00:06:46,000
!سنذهب أيضًا

82
00:06:46,000 --> 00:06:50,260
!ستسير دبّابة براكيو 5 في المؤخّرة

83
00:06:50,260 --> 00:06:52,470
!ابدؤوا التّحرّك

84
00:07:02,810 --> 00:07:06,280
!سانجي! لا أعرف ما مشكلتك، ولكن ابتهج

85
00:07:07,110 --> 00:07:10,990
لا بدّ أن تكون حذرًا. على الأرجح
.أنّه سيكون هنالك الكثير من الأعداء

86
00:07:11,860 --> 00:07:13,490
!الكثير؟

87
00:07:13,490 --> 00:07:15,120
!هذا صحيح

88
00:07:15,120 --> 00:07:19,080
!لا بدّ من ذلك... لا بدّ من وجودهنّ في مكان ما

89
00:07:19,080 --> 00:07:21,040
!في مكان ما

90
00:07:21,700 --> 00:07:23,380
سانجي؟

91
00:07:26,920 --> 00:07:29,300
...آسف لإقلاقكم

92
00:07:29,710 --> 00:07:33,260
!لن أستسلم عن العثور على أولئك النّسوة

93
00:07:41,180 --> 00:07:44,130
،أيّها القنّاص والسّائق أوسوبّ

94
00:07:44,130 --> 00:07:49,820
،انقل الدّبّابة براكيو 5 للأمام ببطء
!بنفس سرعة المشاة

95
00:07:50,320 --> 00:07:54,200
!عُلم يا قائد الدّبّابة تشوبّر

96
00:07:54,200 --> 00:07:56,160
!ببطء شديد للأمام

97
00:08:00,510 --> 00:08:04,700
!راقبوا نوافذ منزل المتعة من باب الحيطة فقط

98
00:08:04,700 --> 00:08:06,080
!أنا لها

99
00:08:07,920 --> 00:08:10,550
...إن رأيت شكل بشريّ من النّوافذ

100
00:08:11,300 --> 00:08:12,470
!كينييمون

101
00:08:12,470 --> 00:08:14,800
.المكان صاخب في الخارج

102
00:08:15,470 --> 00:08:18,140
!اغطسوا في الماء جميعًا

103
00:09:04,060 --> 00:09:08,290
!أخيرًا! لقد عدنا إلى هنا ثانية أخيرًا

104
00:09:08,290 --> 00:09:09,610
!لعق

105
00:09:09,610 --> 00:09:12,030
...كانت ماما معنا عندما وصلنا إلى هنا

106
00:09:12,030 --> 00:09:14,190
!كلّ ذلك كان خطأ ذلك الوغد

107
00:09:24,620 --> 00:09:26,750
!سُحقًا

108
00:09:26,750 --> 00:09:27,830
!ماما

109
00:09:32,290 --> 00:09:35,470
.فليبتلعكم البحر

110
00:09:36,250 --> 00:09:38,770
!ماما

111
00:09:39,550 --> 00:09:43,430
!كينغ... لن أسامحك أبدًا

112
00:09:43,430 --> 00:09:45,350
!سنجعله يدفع الثّمن

113
00:09:45,350 --> 00:09:47,480
!هيّا بنا يا إخوتي وأخواتي

114
00:09:47,480 --> 00:09:50,270
!سندخل بلاد وانو هذه المرّة

115
00:09:50,270 --> 00:09:52,150
!أجل

116
00:09:52,150 --> 00:09:54,280
!تسلّقوا حتّى القمّة

117
00:10:02,160 --> 00:10:05,780
ما أريد معرفته هو لماذا هذه
!هي طريقة الدّخول الوحيدة؟

118
00:10:05,780 --> 00:10:08,000
!هذا جنون

119
00:10:08,000 --> 00:10:13,580
وكذلك بشأن التّحالف بيننا نحن قراصنة
!بيغ مام وقراصنة مملكة الحيوان

120
00:10:13,580 --> 00:10:18,430
!هذا جنون! ما الّذي تفكّر فيها ماما؟

121
00:10:18,430 --> 00:10:20,640
!هذا ما قرّرتْه ماما

122
00:10:20,640 --> 00:10:25,850
!انسوا أمر التّحالف، تذكّروا سبب مجيئنا إلى هنا

123
00:10:25,850 --> 00:10:31,480
نعم! علينا تولّي أمر قبّعة القشّ الّذي
...ألحق العار بماما ولطّخ اسم عائلتنا

124
00:10:31,480 --> 00:10:34,700
!ونظهر للعالم بأكمله رأسه المقطوع

125
00:10:35,480 --> 00:10:37,110
!يا للوحشيّة

126
00:10:37,110 --> 00:10:39,320
،والأهمّ من ذلك

127
00:10:39,650 --> 00:10:43,660
!سأصير المفضّلة لدى كايدو-سان

128
00:10:43,660 --> 00:10:45,660
!تبًّا لك يا فلامبي

129
00:10:45,660 --> 00:10:47,620
!لقد وصلنا

130
00:10:47,620 --> 00:10:49,210
!بلاد وانو

131
00:10:49,210 --> 00:10:51,560
!لا نعرف ما يوجد بانتظارنا

132
00:10:51,560 --> 00:10:53,040
!استعدّوا للقتال

133
00:10:54,670 --> 00:10:56,380
!لا ترخوا دفاعاتكم

134
00:10:56,380 --> 00:11:00,680
،في هذا المكان في آخر مرّة
...تجرّأ ذلك اللّعين كينغ

135
00:11:02,390 --> 00:11:03,600
!...هذا

136
00:11:03,600 --> 00:11:06,010
!ماذا؟! كينغ؟

137
00:11:06,010 --> 00:11:07,810
...عاد ذلك الوغد

138
00:11:08,970 --> 00:11:10,730
!لا، ذلك ليس هو

139
00:11:11,890 --> 00:11:13,310
!ماركو؟

140
00:11:16,250 --> 00:11:20,840
إذًا فالإشاعة حيال تحالف قراصنة
...بيغ مام وقراصنة مملكة الحيوان

141
00:11:20,840 --> 00:11:22,990
.كانت صحيحة-يوي

142
00:11:22,990 --> 00:11:26,320
!ماركو من قراصنة اللّحية البيضاء؟

143
00:11:26,320 --> 00:11:29,580
!قائد وحدتهم الأولى ماركو العنقاء؟

144
00:11:29,580 --> 00:11:31,870
!لا تظهروا أيّ رحمة! أسقطوه

145
00:11:42,630 --> 00:11:44,140
...والآن

146
00:11:45,680 --> 00:11:47,810
!ارحلوا

147
00:11:48,260 --> 00:11:51,230
!ختم العنقاء

148
00:11:51,230 --> 00:11:53,440
!لن أسمح لك بالقيام بذلك

149
00:11:59,280 --> 00:12:01,240
!لا بدّ أنّك تمازحني

150
00:12:01,240 --> 00:12:02,820
!ثانية؟

151
00:12:07,580 --> 00:12:10,950
!لماذا هو هنا؟

152
00:12:10,950 --> 00:12:14,600
،في المرّة القادمة الّتي تأتون فيها لبلاد وانو

153
00:12:14,600 --> 00:12:17,460
!ستجدون أنّ الأوضاع قد تغيّرت

154
00:12:20,460 --> 00:12:24,090
!ماذا؟ سفينة ضخمة تهوي-نيا

155
00:12:24,090 --> 00:12:25,260
.انظر للأعلى

156
00:12:29,390 --> 00:12:31,220
.مرّ وقت طويل

157
00:12:32,600 --> 00:12:36,190
!سأنال منك هذه المرّة بكلّ تأكيد

158
00:12:38,910 --> 00:12:41,200
!يا قبّعة القشّ

159
00:12:47,880 --> 00:12:50,870
!لن أسمح لك بقتله

160
00:12:55,940 --> 00:13:02,380
.رأينا جميعًا مثابرته وقوّته اللاّمحدودة بأعيننا

161
00:13:02,380 --> 00:13:06,800
إنّه الشّخص الّذي أراد إيس إنقاذه
!وحصل على موافقة والدي

162
00:13:07,300 --> 00:13:10,810
!نحن ملزمون بإحضاره للعصر الجديد

163
00:13:11,340 --> 00:13:15,310
!ظننتُ أنّكم جميعًا أفضل من ذلك
!ليس وكأنّ الأمر يهمّ

164
00:13:19,910 --> 00:13:21,690
!يا قراصنة اللّحية البيضاء

165
00:13:22,800 --> 00:13:23,900
!أكاينو

166
00:13:24,600 --> 00:13:28,320
إنّ الدّرجة الّتي تعتبره بها كخطر
.تجعلك ترغب في قتله

167
00:13:28,320 --> 00:13:33,270
والدّرجة الّتي تبعث فينا توقّعات عالية
.تجعلنا نرغب في حمايته

168
00:13:33,270 --> 00:13:35,580
إنّهما بنفس المستوى، ألا تظنّ-يوي؟

169
00:13:36,240 --> 00:13:37,870
...لم أرك

170
00:13:39,290 --> 00:13:41,670
.منذ الحرب

171
00:13:46,590 --> 00:13:48,180
...ماركو

172
00:14:16,420 --> 00:14:18,080
.تفضّل المزيد

173
00:14:18,080 --> 00:14:19,750
!بلاك ماريا؟

174
00:14:20,460 --> 00:14:24,130
لماذا لا تعملين على مهمّتك؟

175
00:14:24,130 --> 00:14:26,790
عن أيّ مهمّة تتحدّث؟

176
00:14:26,790 --> 00:14:29,510
!البحث عن ابني الغبيّ

177
00:14:29,510 --> 00:14:33,510
!حسنًا، أليس هذا أفضل أيّها القائد الأعلى كايدو؟

178
00:14:33,510 --> 00:14:35,180
.لا، ليس أفضل

179
00:14:35,800 --> 00:14:38,890
.سيكون أولئك الحمقى أكثر من كافين للبحث عنه

180
00:14:38,890 --> 00:14:42,770
...أعضاء التّوبي روبّو الآخرين المزعجين بشدّة

181
00:14:42,770 --> 00:14:45,530
.لهذا السّبب أنا هنا

182
00:14:47,150 --> 00:14:51,490
،حسنًا! كما الحال من سنة لأخرى
!دعونا نكسر القاعدة اليوم

183
00:14:51,490 --> 00:14:55,540
!صحيح يا أوروتشي؟! إنّه يوم رائع

184
00:14:58,280 --> 00:15:00,880
!هذا صحيح يا كايدو

185
00:15:04,680 --> 00:15:10,530
أشباح عشيرة كوزكي الّذين طاردونا
!طوال 20 سنة قد رحلوا

186
00:15:10,530 --> 00:15:12,720
!علينا الاحتفال اليوم

187
00:15:12,720 --> 00:15:16,080
...كانجورو الّذي خدعهم حتّى آخر لحظة

188
00:15:16,080 --> 00:15:21,190
قد أنهى مسيرته في التّمثيل الّتي
.استمرّت 20 سنة وسيصل إلى هنا قريبًا

189
00:15:21,190 --> 00:15:27,780
إضافة إلى قادة السّفن الحربيّة
!الّذين أغرقوا الأكازايا في البحر

190
00:15:30,080 --> 00:15:31,610
!إنّه مثير للإعجاب

191
00:15:31,860 --> 00:15:36,660
.لكنتُ قتلتُه عن طريق الخطأ حينها

192
00:15:40,450 --> 00:15:43,500
!نَفس الانفجار

193
00:15:56,260 --> 00:16:00,560
الأمر المذهل حيال كانجورو
...هو قدرته على النّجاة

194
00:16:00,560 --> 00:16:03,770
.في أيّ وضع مهما كان خطيرًا

195
00:16:03,770 --> 00:16:10,010
،فوق ذلك، عندما نجوا من الموت معًا
،صارت ثقة أودن فيه ثابتة لا تتزحزح

196
00:16:10,010 --> 00:16:13,570
.ولن يشكّ الأكازايا في خيانته أبدًا

197
00:16:13,570 --> 00:16:17,890
،لكن رغم مقدرته على الظّفر بكلّ تلك الثّقة

198
00:16:17,890 --> 00:16:21,370
.لم يكن أودن منفتحًا معه إطلاقًا

199
00:16:21,370 --> 00:16:25,630
هذا يعني أنّه حتّى أولئك الأتباع
.من السّاموراي لا يعلمون كلّ شيء بعد

200
00:16:26,500 --> 00:16:28,340
تقصد حيال ذلك الشّيء؟

201
00:16:28,340 --> 00:16:29,780
...نعم

202
00:16:39,600 --> 00:16:41,350
!أكازايا؟

203
00:16:42,520 --> 00:16:44,600
!لماذا أنت هنا؟

204
00:16:44,600 --> 00:16:49,070
.ليس لديّ ما أتحدّث به مع ممثّلين هواة مثلكم

205
00:16:49,070 --> 00:16:50,730
!ماذا قلت؟

206
00:16:50,730 --> 00:16:51,990
!هل فقدت عقلك؟

207
00:16:54,950 --> 00:16:57,410
!لا يهمّ! اقطعه

208
00:17:01,030 --> 00:17:02,540
!من أنت؟

209
00:17:09,170 --> 00:17:11,440
!المعذرة

210
00:17:11,440 --> 00:17:13,550
!أحتاج للحديث مع أوروتشي-ساما

211
00:17:13,550 --> 00:17:17,010
!أجل! وصلتَ يا كانجورو

212
00:17:17,010 --> 00:17:18,670
.لم أره من قبل

213
00:17:18,670 --> 00:17:21,230
!أتريد القتال هنا؟

214
00:17:23,770 --> 00:17:27,900
!اهدؤوا أيّها الحمقى! إنّه من رجال أوروتشي

215
00:17:27,900 --> 00:17:30,980
!مرّ وقت طويل يا أوروتشي-ساما

216
00:17:31,610 --> 00:17:35,280
.القصر ضخم، لذلك أضعت طريقًا بعض الشّيء

217
00:17:38,370 --> 00:17:44,040
وجب عليّ تقطيع أولئك الرّجال
.الّذين ظنّوا أنّني عدوّهم وهاجموني

218
00:17:44,040 --> 00:17:46,500
.أعتذر على ذلك

219
00:17:46,500 --> 00:17:49,400
!ماذا؟ لا بأس بذلك

220
00:17:49,400 --> 00:17:53,090
...صحيح! أرى أنّك أحضرت شيئًا معك

221
00:17:53,710 --> 00:17:57,630
.إنّه كوزكي مومونوسكي كما طلبت

222
00:17:58,260 --> 00:18:01,390
.إنّه ابن أودن

223
00:18:12,600 --> 00:18:14,820
!ثمّة تيّار قويّ أمامنا

224
00:18:14,820 --> 00:18:17,530
إنّه خطير نوعًا ما، لكن هل ندخله؟

225
00:18:17,530 --> 00:18:18,870
...نعم

226
00:18:19,110 --> 00:18:20,530
!إيّاكم أن تفسدوا الأمر

227
00:18:20,530 --> 00:18:21,990
!حاضر

228
00:18:21,990 --> 00:18:25,210
!اندفعوا بكلّ سرعة

229
00:18:31,620 --> 00:18:34,630
!لا تفزعوا! أبقوها على مستوى أفقيّ

230
00:18:34,630 --> 00:18:36,300
!سأعدّل التّوازن

231
00:18:40,430 --> 00:18:42,760
!حسنًا! يبدو هذا جيّدًا

232
00:18:42,760 --> 00:18:44,390
!حاضر يا قبطان

233
00:18:52,850 --> 00:18:57,300
...رنين، رنين، رنين

234
00:18:57,300 --> 00:18:58,360
.فتح

235
00:19:01,150 --> 00:19:03,580
أيمكنكم سماعي-نيا؟

236
00:19:03,580 --> 00:19:06,950
!أهذا أنت يا نيكو؟! لقد تأخّرت! هل وصلت؟

237
00:19:06,950 --> 00:19:08,330
!نعم

238
00:19:08,330 --> 00:19:10,460
!تسلّقنا الشّلاّلات للتّوّ

239
00:19:15,670 --> 00:19:18,380
!هل تعرف في أيّ يوم ووقت نحن؟

240
00:19:19,090 --> 00:19:24,600
،إنّها ليلة مهرجان النّار، يوم المعركة الكبرى
.لذلك أتينا في الوقت المناسب

241
00:19:24,600 --> 00:19:27,700
.لا يمكنك-غارا قول ذلك بعد

242
00:19:27,700 --> 00:19:32,190
نحن في طريقنا إلى الجهة
.الشّمال غربيّة لأونيغاشيما سلفًا

243
00:19:32,190 --> 00:19:34,850
!فهمت! إلى اللّقاء إذًا

244
00:19:34,850 --> 00:19:38,150
!لا، مهلاً! انتظر يا نيكو

245
00:19:38,150 --> 00:19:39,530
.قطع

246
00:19:42,820 --> 00:19:45,600
.إنّه متسرّع كعادته

247
00:19:45,600 --> 00:19:48,920
.آمل أن يصلوا في الوقت المناسب لغارتنا

248
00:19:50,500 --> 00:19:53,560
،لم أرَ نيكو-تشان مذ أن انفصلنا

249
00:19:53,560 --> 00:19:57,500
لكن أظنّ أنّه صار كبيرًا للغاية كما
.هو حال إينو-تشان أيضًا

250
00:19:57,500 --> 00:20:01,240
ذلك القطّ اللّعين... من الأفضل
.أن يتحرّك بأسرع ما يمكنه

251
00:20:01,240 --> 00:20:04,170
!سنصل إلى المدخل الخلفيّ قريبًا

252
00:20:04,170 --> 00:20:06,640
.لا أظنّ أنّه سيصل في الوقت المناسب

253
00:20:06,640 --> 00:20:12,350
بسبب تيّارات البحر، يمكن للسّفن
.العاديّة الاقتراب من الأمام فقط

254
00:20:12,350 --> 00:20:17,320
آمل أنّ كينييمون ودنجيرو قد وصلا
.للمدخل الخلفيّ بدون أيّ مشاكل

255
00:20:17,320 --> 00:20:23,030
!نعم! أريد تحقيق أمنية أودن-ساما مع الجميع

256
00:20:23,030 --> 00:20:24,950
...مومونوسكي-ساما

257
00:20:25,240 --> 00:20:27,490
!أتمنّى أنّك في مأمن

258
00:20:32,830 --> 00:20:34,290
.إنّها نهاية مسدودة

259
00:20:34,290 --> 00:20:35,580
.ربّما

260
00:20:35,580 --> 00:20:38,170
أضعت طريقك، صحيح يا زورو؟

261
00:20:38,170 --> 00:20:41,500
.لا، بإمكاننا صنع طريق بأنفسنا

262
00:20:41,500 --> 00:20:44,840
...ولكن بصمت. لا يجب أن نفسد الخطّة

263
00:20:45,090 --> 00:20:47,510
.حسنًا، مفهوم

264
00:20:48,550 --> 00:20:49,890
!إنما

265
00:21:20,540 --> 00:21:23,920
...حسنًا، ثمّة دائمًا عقبات في الطّرقات

266
00:21:23,920 --> 00:21:25,390
...نعم

267
00:21:25,590 --> 00:21:26,930
!معك حقّ

268
00:21:29,550 --> 00:21:32,470
!يا أختي! أنا أرجوك

269
00:21:32,470 --> 00:21:34,930
.أنا مسرورة-أرينسو

270
00:21:34,930 --> 00:21:36,520
.ذلك ليس قصدي

271
00:21:36,520 --> 00:21:39,190
!لماذا لا تسيرين بنفسك الآن؟

272
00:21:39,190 --> 00:21:43,990
!لا-أرينسو! هذا ممتع أكثر-أرينسو

273
00:21:43,990 --> 00:21:46,530
...هذا ليس ممتعًا بالمرّة بالنّسبة لي

274
00:21:46,530 --> 00:21:48,030
!فعلاً يا بي-تان؟

275
00:21:48,030 --> 00:21:50,450
!أخبرتك ألاّ تناديني بي-تان

276
00:21:50,450 --> 00:21:53,580
أنت مستمتع بالفعل، صحيح؟

277
00:21:53,580 --> 00:21:55,580
...كفّي عن هذا

278
00:21:55,580 --> 00:21:58,290
!لا يمكننا البحث عن ياماتو هكذا

279
00:21:58,290 --> 00:22:02,380
!لا أهتمّ أبدًا لشقيّ كايدو الغبيّ ذاك

280
00:22:02,380 --> 00:22:04,300
!لا تتحدّثي بالسّوء عنهما

281
00:22:04,300 --> 00:22:06,130
!بي-تان، افعل شيئًا

282
00:22:06,130 --> 00:22:06,760
!لا تنادني بي-تان

283
00:22:11,510 --> 00:22:14,220
.يا للوفي ذاك... انطلق بمفرده

284
00:22:14,550 --> 00:22:16,520
إلى أين ذهب؟

285
00:22:22,600 --> 00:22:24,940
.أستطيع استعمالها بشكل جيّد الآن

286
00:22:27,320 --> 00:22:29,910
.لا بدّ أنّ كايدو في الأعلى

287
00:22:30,070 --> 00:22:31,910
!ها هو هناك

288
00:22:31,910 --> 00:22:34,910
!سأقطع رأس قبّعة القشّ

289
00:22:34,910 --> 00:22:36,160
!مرحى

290
00:22:44,590 --> 00:22:45,920
!ها هو ذا

291
00:22:45,920 --> 00:22:47,130
!هذا هو

292
00:22:47,130 --> 00:22:50,220
!إنّ من سيطيح به، سيصبح جزءًا من التّوبي روبّو

293
00:22:56,260 --> 00:22:59,430
!أظنّني سأتدرّب عليكم بعض الشّيء

294
00:22:59,430 --> 00:23:01,820
!نالوا منه

295
00:23:05,530 --> 00:23:07,240
!ريوو

296
00:23:18,200 --> 00:23:21,290
!يشقّ غضب بيغ مام الأرض

297
00:23:21,290 --> 00:23:26,210
وتطلق هجومًا مميتًا ضدّ طاقم قبّعة
!القشّ الّذين تكرههم بشدّة من الأعلى

298
00:23:26,210 --> 00:23:31,110
وها هم يتحدّون اليونكو بدبّابة براكيو
!متغلّبين بذلك على خوفهم

299
00:23:31,110 --> 00:23:36,050
!نالا منها أيّها القائد تشوبّر والسّائق أوسوبّ

300
00:23:36,050 --> 00:23:37,850
:في الحلقة القادمة من وان بيس

301
00:23:37,850 --> 00:23:41,040
"!العهد بين الرّجال! قتال دبّابة براكيو الضّاري"

302
00:23:41,040 --> 00:23:45,650
!ملك القراصنة، لن يكون إلاّ أنا