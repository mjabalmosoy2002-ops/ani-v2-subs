1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,570 --> 00:02:04,320
بعد التّسلّل إلى أونيغاشيما، يقترب
.لوفي والبقيّة من كايدو بوتيرة ثابتة

29
00:02:04,990 --> 00:02:08,370
...أمّا كيد الّذي قاتل أبو

30
00:02:29,050 --> 00:02:35,020
هل اعتقدت أنّ تحالفنا كان قويًّا
!كفاية للإطاحة بأحد اليونكو؟

31
00:02:35,020 --> 00:02:36,810
!كن واقعيًّا

32
00:02:39,620 --> 00:02:41,960
...إنّ تحالفات القراصنة في المقام الأوّل

33
00:02:41,960 --> 00:02:45,150
!نادرًا ما تكون لها نهاية سعيدة

34
00:02:45,150 --> 00:02:47,070
!خدش

35
00:02:47,070 --> 00:02:49,120
!تقطيع

36
00:02:52,240 --> 00:02:55,330
...ظننتُ أنّك ميت

37
00:02:55,770 --> 00:02:58,080
ماذا؟ كيد؟

38
00:02:59,880 --> 00:03:01,090
!أيّها الحثالة

39
00:03:01,090 --> 00:03:04,470
!سآخذ رأس كيد

40
00:03:16,930 --> 00:03:19,810
!أيّها المسنّن! لنسرع نحو القلعة

41
00:03:21,480 --> 00:03:24,550
!...ثـ...ثـ...ثـ

42
00:03:24,550 --> 00:03:27,950
!ثمّة منزل للمتعة

43
00:03:35,910 --> 00:03:40,080
يراودني شعور أنّ هنالك الكثير
!من النّساء الجميلات هناك

44
00:03:40,080 --> 00:03:41,960
!كلاّ يا سانجي

45
00:03:41,960 --> 00:03:45,300
!انتظر يا سانجي-دونو

46
00:03:46,040 --> 00:03:49,130
!وكأنّ هنالك من يجرّه إليه

47
00:03:50,800 --> 00:03:52,470
...إنّه

48
00:03:53,550 --> 00:03:57,770
...يبدو أنّه لم يستطع إيجاد أيّ نساء

49
00:04:02,650 --> 00:04:06,820
"!وصول التّعزيزات! قائد قراصنة اللّحية البيضاء"

50
00:04:18,580 --> 00:04:20,000
!تنافر

51
00:04:23,670 --> 00:04:26,300
!أيّها المسنّن، ما الّذي تفعله؟

52
00:04:27,630 --> 00:04:30,590
!يعرفون من نكون الآن في كلّ الأحوال

53
00:04:30,590 --> 00:04:32,390
!التزم بالخطّة

54
00:04:32,390 --> 00:04:34,990
!إلى الجحيم أنت والخطّة

55
00:04:34,990 --> 00:04:36,760
!سأقوم بالأمر فحسب

56
00:04:37,600 --> 00:04:38,890
!لا، مهلاً

57
00:04:41,230 --> 00:04:44,640
لا بدّ أنّ من الصّعب امتلاك قبطان
.سريع الهيجان هكذا

58
00:04:44,640 --> 00:04:46,360
.لا، ليس صعبًا

59
00:04:46,360 --> 00:04:49,320
!كيد رائع

60
00:04:49,320 --> 00:04:52,410
.حسنًا، لا يختلف وضعي عنك كثيرًا

61
00:05:07,170 --> 00:05:11,800
!أتشعر كأنّك بطل بإنقاذك لنا يا قبّعة القشّ؟

62
00:05:11,800 --> 00:05:13,510
!أنا لم أنقذكم

63
00:05:13,510 --> 00:05:16,600
!هذا ما قد يقوله شخص يشعر أنّه بطل

64
00:05:16,600 --> 00:05:19,060
!توقّف! أنت تزعجني

65
00:05:20,370 --> 00:05:23,640
!لماذا تتقاتلان؟! لا نحتاج لشجارات داخليّة الآن

66
00:05:23,640 --> 00:05:26,990
!عليك الإطاحة بأعدائك بهدوء

67
00:05:27,400 --> 00:05:29,820
هل نصغي إليه؟

68
00:05:29,820 --> 00:05:31,110
.سنقوم بما يحلو لنا

69
00:05:34,700 --> 00:05:38,370
!لن نمتثل لأيّ أحد بعد الآن

70
00:05:54,550 --> 00:05:56,520
...كان المكان فارغًا

71
00:05:57,090 --> 00:06:01,770
،وجدت منزل متعة، جنّة على الأرض
...لكن لم يكن هنالك أيّ أحد

72
00:06:02,140 --> 00:06:04,770
أهذا كابوس؟

73
00:06:06,890 --> 00:06:10,340
عدم وجود نساء في منزل المتعة
.يعني أنّ لا رجال هناك أيضًا

74
00:06:10,340 --> 00:06:12,570
!سنعبر ذلك الجسر الآن

75
00:06:12,570 --> 00:06:13,860
!نعم

76
00:06:13,860 --> 00:06:16,490
!حظًّا سعيدًا يا فريق التّسلّل

77
00:06:16,490 --> 00:06:18,160
!أجل

78
00:06:19,570 --> 00:06:21,580
!جيّد! هذه هي الرّوح المطلوبة

79
00:06:21,910 --> 00:06:24,080
!ليتبعني بقيّتكم

80
00:06:24,080 --> 00:06:26,000
!أجل

81
00:06:29,960 --> 00:06:32,000
!سنذهب أيضًا

82
00:06:32,000 --> 00:06:36,260
!ستسير دبّابة براكيو 5 في المؤخّرة

83
00:06:36,260 --> 00:06:38,470
!ابدؤوا التّحرّك

84
00:06:48,810 --> 00:06:52,280
!سانجي! لا أعرف ما مشكلتك، ولكن ابتهج

85
00:06:53,110 --> 00:06:56,990
لا بدّ أن تكون حذرًا. على الأرجح
.أنّه سيكون هنالك الكثير من الأعداء

86
00:06:57,860 --> 00:06:59,490
!الكثير؟

87
00:06:59,490 --> 00:07:01,120
!هذا صحيح

88
00:07:01,120 --> 00:07:05,080
!لا بدّ من ذلك... لا بدّ من وجودهنّ في مكان ما

89
00:07:05,080 --> 00:07:07,040
!في مكان ما

90
00:07:07,700 --> 00:07:09,380
سانجي؟

91
00:07:12,920 --> 00:07:15,300
...آسف لإقلاقكم

92
00:07:15,710 --> 00:07:19,260
!لن أستسلم عن العثور على أولئك النّسوة

93
00:07:27,180 --> 00:07:30,130
،أيّها القنّاص والسّائق أوسوبّ

94
00:07:30,130 --> 00:07:35,820
،انقل الدّبّابة براكيو 5 للأمام ببطء
!بنفس سرعة المشاة

95
00:07:36,320 --> 00:07:40,200
!عُلم يا قائد الدّبّابة تشوبّر

96
00:07:40,200 --> 00:07:42,160
!ببطء شديد للأمام

97
00:07:46,510 --> 00:07:50,700
!راقبوا نوافذ منزل المتعة من باب الحيطة فقط

98
00:07:50,700 --> 00:07:52,080
!أنا لها

99
00:07:53,920 --> 00:07:56,550
...إن رأيت شكل بشريّ من النّوافذ

100
00:07:57,300 --> 00:07:58,470
!كينييمون

101
00:07:58,470 --> 00:08:00,800
.المكان صاخب في الخارج

102
00:08:01,470 --> 00:08:04,140
!اغطسوا في الماء جميعًا

103
00:08:50,060 --> 00:08:54,290
!أخيرًا! لقد عدنا إلى هنا ثانية أخيرًا

104
00:08:54,290 --> 00:08:55,610
!لعق

105
00:08:55,610 --> 00:08:58,030
...كانت ماما معنا عندما وصلنا إلى هنا

106
00:08:58,030 --> 00:09:00,190
!كلّ ذلك كان خطأ ذلك الوغد

107
00:09:10,620 --> 00:09:12,750
!سُحقًا

108
00:09:12,750 --> 00:09:13,830
!ماما

109
00:09:18,290 --> 00:09:21,470
.فليبتلعكم البحر

110
00:09:22,250 --> 00:09:24,770
!ماما

111
00:09:25,550 --> 00:09:29,430
!كينغ... لن أسامحك أبدًا

112
00:09:29,430 --> 00:09:31,350
!سنجعله يدفع الثّمن

113
00:09:31,350 --> 00:09:33,480
!هيّا بنا يا إخوتي وأخواتي

114
00:09:33,480 --> 00:09:36,270
!سندخل بلاد وانو هذه المرّة

115
00:09:36,270 --> 00:09:38,150
!أجل

116
00:09:38,150 --> 00:09:40,280
!تسلّقوا حتّى القمّة

117
00:09:48,160 --> 00:09:51,780
ما أريد معرفته هو لماذا هذه
!هي طريقة الدّخول الوحيدة؟

118
00:09:51,780 --> 00:09:54,000
!هذا جنون

119
00:09:54,000 --> 00:09:59,580
وكذلك بشأن التّحالف بيننا نحن قراصنة
!بيغ مام وقراصنة مملكة الحيوان

120
00:09:59,580 --> 00:10:04,430
!هذا جنون! ما الّذي تفكّر فيها ماما؟

121
00:10:04,430 --> 00:10:06,640
!هذا ما قرّرتْه ماما

122
00:10:06,640 --> 00:10:11,850
!انسوا أمر التّحالف، تذكّروا سبب مجيئنا إلى هنا

123
00:10:11,850 --> 00:10:17,480
نعم! علينا تولّي أمر قبّعة القشّ الّذي
...ألحق العار بماما ولطّخ اسم عائلتنا

124
00:10:17,480 --> 00:10:20,700
!ونظهر للعالم بأكمله رأسه المقطوع

125
00:10:21,480 --> 00:10:23,110
!يا للوحشيّة

126
00:10:23,110 --> 00:10:25,320
،والأهمّ من ذلك

127
00:10:25,650 --> 00:10:29,660
!سأصير المفضّلة لدى كايدو-سان

128
00:10:29,660 --> 00:10:31,660
!تبًّا لك يا فلامبي

129
00:10:31,660 --> 00:10:33,620
!لقد وصلنا

130
00:10:33,620 --> 00:10:35,210
!بلاد وانو

131
00:10:35,210 --> 00:10:37,560
!لا نعرف ما يوجد بانتظارنا

132
00:10:37,560 --> 00:10:39,040
!استعدّوا للقتال

133
00:10:40,670 --> 00:10:42,380
!لا ترخوا دفاعاتكم

134
00:10:42,380 --> 00:10:46,680
،في هذا المكان في آخر مرّة
...تجرّأ ذلك اللّعين كينغ

135
00:10:48,390 --> 00:10:49,600
!...هذا

136
00:10:49,600 --> 00:10:52,010
!ماذا؟! كينغ؟

137
00:10:52,010 --> 00:10:53,810
...عاد ذلك الوغد

138
00:10:54,970 --> 00:10:56,730
!لا، ذلك ليس هو

139
00:10:57,890 --> 00:10:59,310
!ماركو؟

140
00:11:02,250 --> 00:11:06,840
إذًا فالإشاعة حيال تحالف قراصنة
...بيغ مام وقراصنة مملكة الحيوان

141
00:11:06,840 --> 00:11:08,990
.كانت صحيحة-يوي

142
00:11:08,990 --> 00:11:12,320
!ماركو من قراصنة اللّحية البيضاء؟

143
00:11:12,320 --> 00:11:15,580
!قائد وحدتهم الأولى ماركو العنقاء؟

144
00:11:15,580 --> 00:11:17,870
!لا تظهروا أيّ رحمة! أسقطوه

145
00:11:28,630 --> 00:11:30,140
...والآن

146
00:11:31,680 --> 00:11:33,810
!ارحلوا

147
00:11:34,260 --> 00:11:37,230
!ختم العنقاء

148
00:11:37,230 --> 00:11:39,440
!لن أسمح لك بالقيام بذلك

149
00:11:45,280 --> 00:11:47,240
!لا بدّ أنّك تمازحني

150
00:11:47,240 --> 00:11:48,820
!ثانية؟

151
00:11:53,580 --> 00:11:56,950
!لماذا هو هنا؟

152
00:11:56,950 --> 00:12:00,600
،في المرّة القادمة الّتي تأتون فيها لبلاد وانو

153
00:12:00,600 --> 00:12:03,460
!ستجدون أنّ الأوضاع قد تغيّرت

154
00:12:06,460 --> 00:12:10,090
!ماذا؟ سفينة ضخمة تهوي-نيا

155
00:12:10,090 --> 00:12:11,260
.انظر للأعلى

156
00:12:15,390 --> 00:12:17,220
.مرّ وقت طويل

157
00:12:18,600 --> 00:12:22,190
!سأنال منك هذه المرّة بكلّ تأكيد

158
00:12:24,910 --> 00:12:27,200
!يا قبّعة القشّ

159
00:12:33,880 --> 00:12:36,870
!لن أسمح لك بقتله

160
00:12:41,940 --> 00:12:48,380
.رأينا جميعًا مثابرته وقوّته اللاّمحدودة بأعيننا

161
00:12:48,380 --> 00:12:52,800
إنّه الشّخص الّذي أراد إيس إنقاذه
!وحصل على موافقة والدي

162
00:12:53,300 --> 00:12:56,810
!نحن ملزمون بإحضاره للعصر الجديد

163
00:12:57,340 --> 00:13:01,310
!ظننتُ أنّكم جميعًا أفضل من ذلك
!ليس وكأنّ الأمر يهمّ

164
00:13:05,910 --> 00:13:07,690
!يا قراصنة اللّحية البيضاء

165
00:13:08,800 --> 00:13:09,900
!أكاينو

166
00:13:10,600 --> 00:13:14,320
إنّ الدّرجة الّتي تعتبره بها كخطر
.تجعلك ترغب في قتله

167
00:13:14,320 --> 00:13:19,270
والدّرجة الّتي تبعث فينا توقّعات عالية
.تجعلنا نرغب في حمايته

168
00:13:19,270 --> 00:13:21,580
إنّهما بنفس المستوى، ألا تظنّ-يوي؟

169
00:13:22,240 --> 00:13:23,870
...لم أرك

170
00:13:25,290 --> 00:13:27,670
.منذ الحرب

171
00:13:32,590 --> 00:13:34,180
...ماركو

172
00:14:02,420 --> 00:14:04,080
.تفضّل المزيد

173
00:14:04,080 --> 00:14:05,750
!بلاك ماريا؟

174
00:14:06,460 --> 00:14:10,130
لماذا لا تعملين على مهمّتك؟

175
00:14:10,130 --> 00:14:12,790
عن أيّ مهمّة تتحدّث؟

176
00:14:12,790 --> 00:14:15,510
!البحث عن ابني الغبيّ

177
00:14:15,510 --> 00:14:19,510
!حسنًا، أليس هذا أفضل أيّها القائد الأعلى كايدو؟

178
00:14:19,510 --> 00:14:21,180
.لا، ليس أفضل

179
00:14:21,800 --> 00:14:24,890
.سيكون أولئك الحمقى أكثر من كافين للبحث عنه

180
00:14:24,890 --> 00:14:28,770
...أعضاء التّوبي روبّو الآخرين المزعجين بشدّة

181
00:14:28,770 --> 00:14:31,530
.لهذا السّبب أنا هنا

182
00:14:33,150 --> 00:14:37,490
،حسنًا! كما الحال من سنة لأخرى
!دعونا نكسر القاعدة اليوم

183
00:14:37,490 --> 00:14:41,540
!صحيح يا أوروتشي؟! إنّه يوم رائع

184
00:14:44,280 --> 00:14:46,880
!هذا صحيح يا كايدو

185
00:14:50,680 --> 00:14:56,530
أشباح عشيرة كوزكي الّذين طاردونا
!طوال 20 سنة قد رحلوا

186
00:14:56,530 --> 00:14:58,720
!علينا الاحتفال اليوم

187
00:14:58,720 --> 00:15:02,080
...كانجورو الّذي خدعهم حتّى آخر لحظة

188
00:15:02,080 --> 00:15:07,190
قد أنهى مسيرته في التّمثيل الّتي
.استمرّت 20 سنة وسيصل إلى هنا قريبًا

189
00:15:07,190 --> 00:15:13,780
إضافة إلى قادة السّفن الحربيّة
!الّذين أغرقوا الأكازايا في البحر

190
00:15:16,080 --> 00:15:17,610
!إنّه مثير للإعجاب

191
00:15:17,860 --> 00:15:22,660
.لكنتُ قتلتُه عن طريق الخطأ حينها

192
00:15:26,450 --> 00:15:29,500
!نَفس الانفجار

193
00:15:42,260 --> 00:15:46,560
الأمر المذهل حيال كانجورو
...هو قدرته على النّجاة

194
00:15:46,560 --> 00:15:49,770
.في أيّ وضع مهما كان خطيرًا

195
00:15:49,770 --> 00:15:56,010
،فوق ذلك، عندما نجوا من الموت معًا
،صارت ثقة أودن فيه ثابتة لا تتزحزح

196
00:15:56,010 --> 00:15:59,570
.ولن يشكّ الأكازايا في خيانته أبدًا

197
00:15:59,570 --> 00:16:03,890
،لكن رغم مقدرته على الظّفر بكلّ تلك الثّقة

198
00:16:03,890 --> 00:16:07,370
.لم يكن أودن منفتحًا معه إطلاقًا

199
00:16:07,370 --> 00:16:11,630
هذا يعني أنّه حتّى أولئك الأتباع
.من السّاموراي لا يعلمون كلّ شيء بعد

200
00:16:12,500 --> 00:16:14,340
تقصد حيال ذلك الشّيء؟

201
00:16:14,340 --> 00:16:15,780
...نعم

202
00:16:25,600 --> 00:16:27,350
!أكازايا؟

203
00:16:28,520 --> 00:16:30,600
!لماذا أنت هنا؟

204
00:16:30,600 --> 00:16:35,070
.ليس لديّ ما أتحدّث به مع ممثّلين هواة مثلكم

205
00:16:35,070 --> 00:16:36,730
!ماذا قلت؟

206
00:16:36,730 --> 00:16:37,990
!هل فقدت عقلك؟

207
00:16:40,950 --> 00:16:43,410
!لا يهمّ! اقطعه

208
00:16:47,030 --> 00:16:48,540
!من أنت؟

209
00:16:55,170 --> 00:16:57,440
!المعذرة

210
00:16:57,440 --> 00:16:59,550
!أحتاج للحديث مع أوروتشي-ساما

211
00:16:59,550 --> 00:17:03,010
!أجل! وصلتَ يا كانجورو

212
00:17:03,010 --> 00:17:04,670
.لم أره من قبل

213
00:17:04,670 --> 00:17:07,230
!أتريد القتال هنا؟

214
00:17:09,770 --> 00:17:13,900
!اهدؤوا أيّها الحمقى! إنّه من رجال أوروتشي

215
00:17:13,900 --> 00:17:16,980
!مرّ وقت طويل يا أوروتشي-ساما

216
00:17:17,610 --> 00:17:21,280
.القصر ضخم، لذلك أضعت طريقًا بعض الشّيء

217
00:17:24,370 --> 00:17:30,040
وجب عليّ تقطيع أولئك الرّجال
.الّذين ظنّوا أنّني عدوّهم وهاجموني

218
00:17:30,040 --> 00:17:32,500
.أعتذر على ذلك

219
00:17:32,500 --> 00:17:35,400
!ماذا؟ لا بأس بذلك

220
00:17:35,400 --> 00:17:39,090
...صحيح! أرى أنّك أحضرت شيئًا معك

221
00:17:39,710 --> 00:17:43,630
.إنّه كوزكي مومونوسكي كما طلبت

222
00:17:44,260 --> 00:17:47,390
.إنّه ابن أودن

223
00:17:58,600 --> 00:18:00,820
!ثمّة تيّار قويّ أمامنا

224
00:18:00,820 --> 00:18:03,530
إنّه خطير نوعًا ما، لكن هل ندخله؟

225
00:18:03,530 --> 00:18:04,870
...نعم

226
00:18:05,110 --> 00:18:06,530
!إيّاكم أن تفسدوا الأمر

227
00:18:06,530 --> 00:18:07,990
!حاضر

228
00:18:07,990 --> 00:18:11,210
!اندفعوا بكلّ سرعة

229
00:18:17,620 --> 00:18:20,630
!لا تفزعوا! أبقوها على مستوى أفقيّ

230
00:18:20,630 --> 00:18:22,300
!سأعدّل التّوازن

231
00:18:26,430 --> 00:18:28,760
!حسنًا! يبدو هذا جيّدًا

232
00:18:28,760 --> 00:18:30,390
!حاضر يا قبطان

233
00:18:38,850 --> 00:18:43,300
...رنين، رنين، رنين

234
00:18:43,300 --> 00:18:44,360
.فتح

235
00:18:47,150 --> 00:18:49,580
أيمكنكم سماعي-نيا؟

236
00:18:49,580 --> 00:18:52,950
!أهذا أنت يا نيكو؟! لقد تأخّرت! هل وصلت؟

237
00:18:52,950 --> 00:18:54,330
!نعم

238
00:18:54,330 --> 00:18:56,460
!تسلّقنا الشّلاّلات للتّوّ

239
00:19:01,670 --> 00:19:04,380
!هل تعرف في أيّ يوم ووقت نحن؟

240
00:19:05,090 --> 00:19:10,600
،إنّها ليلة مهرجان النّار، يوم المعركة الكبرى
.لذلك أتينا في الوقت المناسب

241
00:19:10,600 --> 00:19:13,700
.لا يمكنك-غارا قول ذلك بعد

242
00:19:13,700 --> 00:19:18,190
نحن في طريقنا إلى الجهة
.الشّمال غربيّة لأونيغاشيما سلفًا

243
00:19:18,190 --> 00:19:20,850
!فهمت! إلى اللّقاء إذًا

244
00:19:20,850 --> 00:19:24,150
!لا، مهلاً! انتظر يا نيكو

245
00:19:24,150 --> 00:19:25,530
.قطع

246
00:19:28,820 --> 00:19:31,600
.إنّه متسرّع كعادته

247
00:19:31,600 --> 00:19:34,920
.آمل أن يصلوا في الوقت المناسب لغارتنا

248
00:19:36,500 --> 00:19:39,560
،لم أرَ نيكو-تشان مذ أن انفصلنا

249
00:19:39,560 --> 00:19:43,500
لكن أظنّ أنّه صار كبيرًا للغاية كما
.هو حال إينو-تشان أيضًا

250
00:19:43,500 --> 00:19:47,240
ذلك القطّ اللّعين... من الأفضل
.أن يتحرّك بأسرع ما يمكنه

251
00:19:47,240 --> 00:19:50,170
!سنصل إلى المدخل الخلفيّ قريبًا

252
00:19:50,170 --> 00:19:52,640
.لا أظنّ أنّه سيصل في الوقت المناسب

253
00:19:52,640 --> 00:19:58,350
بسبب تيّارات البحر، يمكن للسّفن
.العاديّة الاقتراب من الأمام فقط

254
00:19:58,350 --> 00:20:03,320
آمل أنّ كينييمون ودنجيرو قد وصلا
.للمدخل الخلفيّ بدون أيّ مشاكل

255
00:20:03,320 --> 00:20:09,030
!نعم! أريد تحقيق أمنية أودن-ساما مع الجميع

256
00:20:09,030 --> 00:20:10,950
...مومونوسكي-ساما

257
00:20:11,240 --> 00:20:13,490
!أتمنّى أنّك في مأمن

258
00:20:18,830 --> 00:20:20,290
.إنّها نهاية مسدودة

259
00:20:20,290 --> 00:20:21,580
.ربّما

260
00:20:21,580 --> 00:20:24,170
أضعت طريقك، صحيح يا زورو؟

261
00:20:24,170 --> 00:20:27,500
.لا، بإمكاننا صنع طريق بأنفسنا

262
00:20:27,500 --> 00:20:30,840
...ولكن بصمت. لا يجب أن نفسد الخطّة

263
00:20:31,090 --> 00:20:33,510
.حسنًا، مفهوم

264
00:20:34,550 --> 00:20:35,890
!إنما

265
00:21:06,540 --> 00:21:09,920
...حسنًا، ثمّة دائمًا عقبات في الطّرقات

266
00:21:09,920 --> 00:21:11,390
...نعم

267
00:21:11,590 --> 00:21:12,930
!معك حقّ

268
00:21:15,550 --> 00:21:18,470
!يا أختي! أنا أرجوك

269
00:21:18,470 --> 00:21:20,930
.أنا مسرورة-أرينسو

270
00:21:20,930 --> 00:21:22,520
.ذلك ليس قصدي

271
00:21:22,520 --> 00:21:25,190
!لماذا لا تسيرين بنفسك الآن؟

272
00:21:25,190 --> 00:21:29,990
!لا-أرينسو! هذا ممتع أكثر-أرينسو

273
00:21:29,990 --> 00:21:32,530
...هذا ليس ممتعًا بالمرّة بالنّسبة لي

274
00:21:32,530 --> 00:21:34,030
!فعلاً يا بي-تان؟

275
00:21:34,030 --> 00:21:36,450
!أخبرتك ألاّ تناديني بي-تان

276
00:21:36,450 --> 00:21:39,580
أنت مستمتع بالفعل، صحيح؟

277
00:21:39,580 --> 00:21:41,580
...كفّي عن هذا

278
00:21:41,580 --> 00:21:44,290
!لا يمكننا البحث عن ياماتو هكذا

279
00:21:44,290 --> 00:21:48,380
!لا أهتمّ أبدًا لشقيّ كايدو الغبيّ ذاك

280
00:21:48,380 --> 00:21:50,300
!لا تتحدّثي بالسّوء عنهما

281
00:21:50,300 --> 00:21:52,130
!بي-تان، افعل شيئًا

282
00:21:52,130 --> 00:21:52,760
!لا تنادني بي-تان

283
00:21:57,510 --> 00:22:00,220
.يا للوفي ذاك... انطلق بمفرده

284
00:22:00,550 --> 00:22:02,520
إلى أين ذهب؟

285
00:22:08,600 --> 00:22:10,940
.أستطيع استعمالها بشكل جيّد الآن

286
00:22:13,320 --> 00:22:15,910
.لا بدّ أنّ كايدو في الأعلى

287
00:22:16,070 --> 00:22:17,910
!ها هو هناك

288
00:22:17,910 --> 00:22:20,910
!سأقطع رأس قبّعة القشّ

289
00:22:20,910 --> 00:22:22,160
!مرحى

290
00:22:30,590 --> 00:22:31,920
!ها هو ذا

291
00:22:31,920 --> 00:22:33,130
!هذا هو

292
00:22:33,130 --> 00:22:36,220
!إنّ من سيطيح به، سيصبح جزءًا من التّوبي روبّو

293
00:22:42,260 --> 00:22:45,430
!أظنّني سأتدرّب عليكم بعض الشّيء

294
00:22:45,430 --> 00:22:47,820
!نالوا منه

295
00:22:51,530 --> 00:22:53,240
!ريوو

296
00:23:04,200 --> 00:23:07,290
!يشقّ غضب بيغ مام الأرض

297
00:23:07,290 --> 00:23:12,210
وتطلق هجومًا مميتًا ضدّ طاقم قبّعة
!القشّ الّذين تكرههم بشدّة من الأعلى

298
00:23:12,210 --> 00:23:17,110
وها هم يتحدّون اليونكو بدبّابة براكيو
!متغلّبين بذلك على خوفهم

299
00:23:17,110 --> 00:23:22,050
!نالا منها أيّها القائد تشوبّر والسّائق أوسوبّ

300
00:23:22,050 --> 00:23:23,850
:في الحلقة القادمة من وان بيس

301
00:23:23,850 --> 00:23:27,040
"!العهد بين الرّجال! قتال دبّابة براكيو الضّاري"

302
00:23:27,040 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا