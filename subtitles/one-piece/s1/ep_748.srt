181
00:13:51,790 --> 00:13:55,750
!لكنّني بحاجةٍ لأصدقاءٍ جديرين بالثّقة لتحقيق هذا

182
00:13:56,210 --> 00:13:58,670
!يُمكنكِ الحُصول على هذا القارب الحربيّ

183
00:13:58,670 --> 00:14:03,050
!ليس من السّهل قيادته، لكن واثقٌ من أنّكِ ستستفيدين منه جيّداً

184
00:14:03,050 --> 00:14:07,780
!إن تعاونّا جميعاً معاً، سيتحقّق حُلمُنا

185
00:14:09,180 --> 00:14:11,160
!هل ترغبين بمُرافقتي؟

186
00:14:15,180 --> 00:14:19,150
.قابلتُ أخيراً شخصاً يُشاركني أفكاري

187
00:14:19,900 --> 00:14:23,890
.جميع من في القلعة قد وَثقوا ببيل أيضاً

188
00:14:24,570 --> 00:14:28,200
!إذاً هل لاحقتي لوفي سينباي لإرضاءه؟

189
00:14:28,200 --> 00:14:32,600
!نعم، و لقد أخبرتَني عن طاقم قُبّعة القشّ باستمرار

190
00:14:33,910 --> 00:14:36,680
!إذاً فقد كنتِ تبذلين جهدكِ لأجل أصدقاءكِ كما نفعل نحن

191
00:14:38,210 --> 00:14:40,640
!مَديحكَ لا يُسعدني

192
00:14:41,210 --> 00:14:43,460
.الرّجل بيل مازال يبدو مُثيراً للشّبهة

193
00:14:43,460 --> 00:14:46,900
!إنّه أروع بكثيرٍ منكَ أو من قُبّعة القشّ

194
00:14:50,430 --> 00:14:52,830
هاي! ماذا تفعلون هُناك؟

195
00:14:55,060 --> 00:14:58,400
!من أنتُم؟

196
00:15:30,550 --> 00:15:32,300
هل سيكفي هذا؟

197
00:15:32,300 --> 00:15:34,070
!نعم! شُكراً

198
00:15:37,470 --> 00:15:38,980
!لنفعلها

199
00:15:39,480 --> 00:15:41,240
!مُؤلم! مُؤلم! أوو! أوو

200
00:15:42,350 --> 00:15:45,090
!حارٌّ جدّاً-
...أ-أعتذر-

201
00:15:45,900 --> 00:15:47,640
!إنّه يُزال! ثانيةً

202
00:15:48,070 --> 00:15:50,470
هذه هي حِكمة الجدّة من موطننا، هاه؟

203
00:15:50,470 --> 00:15:51,990
هل تعرفينها؟

204
00:15:51,990 --> 00:15:56,010
!نعم، أفعل! لا يُوجد ما لا تعرف عنه الجدّة

205
00:15:57,540 --> 00:15:59,910
.لابدّ من أنّه عمل بيل

206
00:15:59,910 --> 00:16:02,810
هل يُمكنكم تحطيمها؟-
.كلّا، لا يُمكننا-

207
00:16:03,090 --> 00:16:06,070
هل تمّ رَميكم من الأعلى أيضاً؟

208
00:16:06,090 --> 00:16:09,880
ماذا تعني بـ"أيضاً"؟
من أنتُم؟

209
00:16:09,880 --> 00:16:12,010
و ما هذا المكان؟

210
00:16:12,010 --> 00:16:13,840
ألا تعرفين أيّ شيء؟

211
00:16:13,840 --> 00:16:16,330
...مَنجم الفِضّة هو مَنجمٌ غنيٌّ بالفضّة و

212
00:16:16,930 --> 00:16:19,480
.نحن في هاوية المَنجم تحت الأرض...

213
00:16:21,140 --> 00:16:26,090
.نحن أعضاءٌ سابقون من تحالف قراصنة الفِضّة

214
00:16:26,110 --> 00:16:27,110
ماذا؟

215
00:16:27,110 --> 00:16:29,840
.مهما فعلنا، لم نتمكّن من إرضاء بيل

216
00:16:30,190 --> 00:16:33,480
من لا يُمكنهم أن يجلبوا له الكُنوز أو الأشخاص

217
00:16:33,480 --> 00:16:35,820
أصحاب المُكافآت، سيتمّ رَميهم جميعاً إلى الأسفل هُنا

218
00:16:35,820 --> 00:16:39,240
.و يُجبرون على استخراج المَعدن من الصّباح حتّى المساء

219
00:16:39,870 --> 00:16:43,460
!كم هو فَظيعٌ ليتخلّى عن أصدقاءه

220
00:16:43,460 --> 00:16:46,840
.لذا فنحن عبيدٌ له

221
00:16:52,840 --> 00:16:57,180
!مُستحيل! لن يفعل مثل هذا الشّيء لأصدقاءه

222
00:16:57,180 --> 00:16:59,390
.أعلم أنّه من الصّعب تصديق هذا

223
00:16:59,390 --> 00:17:01,470
.لكنّها الحقيقة

224
00:17:03,850 --> 00:17:06,420
!هاي، ألا يُوجد سبيلٌ للخُروج من هُنا؟

225
00:17:06,420 --> 00:17:09,610
.السكّة الحديديّة هي الصّلة الوَحيدة بين هذا المكان و الأعلى هناك

226
00:17:09,610 --> 00:17:13,510
.لكن إن استخدمناه، سيعرف أفيلون بالحال

227
00:17:13,530 --> 00:17:18,070
.الكثير حاولوا حتّى الآن، لكنّهم فشلوا جميعاً

228
00:17:18,620 --> 00:17:20,470
.فقط استسلموا عن المُقاومة

229
00:17:26,960 --> 00:17:28,770
!ما جرس الإنذار هذا؟

230
00:17:29,000 --> 00:17:33,860
!قِطار أفيلون السّريع المَحدود سيصل قريباً

231
00:17:38,050 --> 00:17:39,180
!أفيلون؟

232
00:17:42,140 --> 00:17:45,370
!أرى أحدهم أمامي

233
00:17:45,890 --> 00:17:49,590
!أرجوكم احذروا من القنابل ثانيةً

234
00:17:52,070 --> 00:17:53,630
!ها قد أتى أفيلون

235
00:17:53,990 --> 00:17:56,720
!عليّ إزالة هذا الشّيء اللّزج بسرعة

236
00:17:57,820 --> 00:18:00,590
...هاي! هل أخبركَ بيل بالفعل بأن

237
00:18:01,160 --> 00:18:03,700
!تتخلّص منّي أيضاً؟...

238
00:18:03,700 --> 00:18:04,980
!هذا صحيح

239
00:18:07,170 --> 00:18:08,650
.فهمت

240
00:18:14,090 --> 00:18:15,780
!بدأ أفيلون التّصرّف بشكلٍ هائج

241
00:18:15,880 --> 00:18:18,360
!أمطار القنابل! أمطار القنابل

242
00:18:25,810 --> 00:18:28,500
!رائع! أُزيلت بالكامل

243
00:18:31,320 --> 00:18:33,150
...أوو، أوو، أوو

244
00:18:34,110 --> 00:18:35,780
!هل أنتُم بخير؟

245
00:18:35,780 --> 00:18:37,530
...بـ-بالكاد

246
00:18:37,530 --> 00:18:39,010
!ماذا عنك، لوفي سينباي؟

247
00:18:43,700 --> 00:18:47,180
!أوه، سينباي! هل أنتَ بخير؟

248
00:18:47,580 --> 00:18:49,730
!لقد وَجدتّ قُبّعة القشّ

249
00:18:50,210 --> 00:18:52,820
،مع هذا الحفّار الذي صنعه بيل بشكلٍ خاصّ

250
00:18:53,210 --> 00:18:56,860
!قِفوا جانباً لأجل ثقب قُبّعة القشّ

251
00:18:57,050 --> 00:18:58,280
!أوه لا

252
00:19:12,690 --> 00:19:15,800
!!لوفي سينباي

253
00:19:29,790 --> 00:19:32,190
!تخلّصتُ منها

254
00:19:33,130 --> 00:19:36,440
!لقد مرّت من خِلالها! لماذا لم يتأذّى؟

255
00:19:36,670 --> 00:19:39,050
ما الذي كنتَ تستهدفه؟

256
00:19:39,050 --> 00:19:42,230
!جسدي ليس بهذه الضّخامة

257
00:19:47,140 --> 00:19:48,950
!ها نحن ذا، ترام

258
00:19:50,270 --> 00:19:53,500
!سأتحوّل إلى القطار السّريع المُميّز المُفرِط

259
00:20:01,410 --> 00:20:03,590
!ها نحن ذا

260
00:20:05,450 --> 00:20:11,790
غومو غومونو... المِطرقة

261
00:20:08,040 --> 00:20:09,350
!خُذ هذه

262
00:20:14,290 --> 00:20:17,020
!هذا هو عزيزي لوفي سينباي

263
00:20:23,840 --> 00:20:26,050
الغيار الثّاني

264
00:20:26,050 --> 00:20:31,000
غومو غومونو... المِدفع

265
00:20:37,400 --> 00:20:40,180
!هـ-هذا لا يُصدّق! لقد فعلها

266
00:20:43,950 --> 00:20:46,350
!الآن انسحابٌ إلى الكراج

267
00:20:48,080 --> 00:20:49,560
!إنتظر

268
00:20:49,660 --> 00:20:52,890
!أوه، إنتظرني! سينباي

269
00:21:06,350 --> 00:21:08,100
...إستعدّوا لتغيير

270
00:21:08,100 --> 00:21:09,100
!السكّة...

271
00:21:09,220 --> 00:21:10,720
!توقّف

272
00:21:10,720 --> 00:21:12,140
!لا يُمكنكَ الهرب

273
00:21:14,730 --> 00:21:16,900
!تغيير السكّة

274
00:21:18,570 --> 00:21:20,610
!ياله من إزعاج

275
00:21:20,610 --> 00:21:22,400
!لوفي سينباي

276
00:21:23,110 --> 00:21:25,080
!لنعتني بأمره

277
00:21:31,870 --> 00:21:34,120
!تغيير السكّة! تغيير السكّة

278
00:21:34,120 --> 00:21:36,040
!تغيير السكّة

279
00:21:36,040 --> 00:21:38,560
!كلّا، لا يُمكنني

280
00:21:43,510 --> 00:21:50,330
غومو غومونو... جيت بازوكا

281
00:22:05,780 --> 00:22:09,050
....لقد قضى على قِطار أفيلون السّريع بهذه السّهولة-
...يال قوّته-

282
00:22:17,000 --> 00:22:18,670
قِطار أفيلون السّريع

283
00:22:18,960 --> 00:22:21,040
المحطّة الطّرفيّة

284
00:22:21,170 --> 00:22:23,320
!هل ترون؟! قضيتُ على ترام

285
00:22:23,550 --> 00:22:28,090
!قاتلتُ بالتّعاون مع لوفي سينباي للمرّة الأولى

286
00:22:28,090 --> 00:22:32,290
!هاي! لنخرج من هُنا الآن

287
00:22:53,740 --> 00:22:56,620
!أفيلون! هاي، أفيلون

288
00:22:56,870 --> 00:22:58,250
ما الخطب؟

289
00:22:58,250 --> 00:23:00,900
.لا يُجيب. لابدّ من أنّه قد فشل

290
00:23:01,340 --> 00:23:04,980
!إن وَصل قُبّعة القشّ و الآخرون إلى الأعلى هُنا، سنكون في وَرطة

291
00:23:11,510 --> 00:23:14,990
...إذاً، لنقُم فقط

292
00:23:15,390 --> 00:23:17,390
.بدفنهم جميعاً...

293
00:23:24,900 --> 00:23:27,060
أمام لوفي و الآخرين الذين تسلّقوا

294
00:23:27,060 --> 00:23:29,740
!للوُصول إلى السّطح، القاتل التّالي، بيسيتا، يَظهر

295
00:23:29,740 --> 00:23:32,050
بينما كانت الأسلحة السرّيّة لفاكهة الصّهر-الصّهر

296
00:23:32,050 --> 00:23:34,530
،على وَشك حرق كلّ شيءٍ في هاوية المَنجم تحت الأرض

297
00:23:34,530 --> 00:23:36,540
!يصل زورو و الآخرون أخيراً

298
00:23:36,540 --> 00:23:40,190
!مُبارزة زورو و بيسيتا، حيث كبرياءهما على المِحكّ، تبدأ

299
00:23:40,210 --> 00:23:41,630
!في الحلقة القادمة من ون بيس

300
00:23:41,630 --> 00:23:45,110
!تقنيّات المُسايفة تشتعل"
"!يَظهر لو و زورو أخيراً

301
00:23:45,130 --> 00:23:47,570
!سأُصبح ملك القراصنة