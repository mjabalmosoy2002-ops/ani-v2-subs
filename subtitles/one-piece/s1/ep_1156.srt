1
00:00:00,000 --> 00:00:05,070
!إلى الأمام! إلى الأمام

2
00:00:11,680 --> 00:00:14,170
!إنّنا نحلّق خارجها

3
00:00:19,750 --> 00:00:22,490
...يا رفاق! يومًا ما

4
00:00:22,490 --> 00:00:26,680
!سأذهب إلى إلباف! إلى بلاد المحاربين

5
00:00:27,050 --> 00:00:30,310
!بالطّبع يا أوسوبّ
!سنذهب إلى هناك بالتّأكيد

6
00:00:31,160 --> 00:00:34,340
!سنذهب إلى موطن العمالقة يومًا ما

7
00:00:34,340 --> 00:00:36,110
!أجل

8
00:00:36,110 --> 00:00:40,250
!إلباف-باف! إلباف-باف

9
00:00:40,250 --> 00:00:44,380
!إنّهم ضخام لأنّهم عمالقة

10
00:00:47,070 --> 00:00:49,700
!حانت اللّحظة أخيرًا يا أوسوبّ

11
00:00:49,700 --> 00:00:50,910
!أجل

12
00:00:51,150 --> 00:00:54,540
!لنذهب إلى إلباف

13
00:01:00,410 --> 00:01:05,530
!إلباف الّتي طال انتظارها"
"!وليمة لمّ الشّمل الكبيرة

14
00:01:14,170 --> 00:01:17,080
.غادر لوفي والبقيّة إيغهيد

15
00:01:18,400 --> 00:01:23,810
واستمرّت وليمتهم وهم في طريقهم
.إلى وجهتهم التّالية، إلباف

16
00:01:28,630 --> 00:01:30,320
...وثمّ

17
00:01:30,320 --> 00:01:32,850
مهلاً، أتستمع لي يا قبّعة القشّ؟

18
00:01:34,960 --> 00:01:38,490
...بعد أن ودّعناكم في ووتر سفن

19
00:01:38,490 --> 00:01:43,590
.ذهبنا إلى ليتل غاردن للقاء زعيمينا فحسب

20
00:01:43,590 --> 00:01:45,610
!هذا ما حدث إذًا؟

21
00:01:45,610 --> 00:01:49,430
.بالطّبع ستتساءلان عنهما
!مرّ قرن بأكمله على انفصالكم

22
00:01:49,430 --> 00:01:51,390
وهل تدري ما حدث بعدها؟

23
00:01:51,690 --> 00:01:54,880
!كانا يتقاتلان بيديهما العاريتين

24
00:01:54,880 --> 00:01:55,980
!ماذا؟

25
00:02:06,380 --> 00:02:09,370
!لماذا؟ ما الّذي حدث لأسلحتكما؟

26
00:02:09,730 --> 00:02:11,410
...هذا لأنّ

27
00:02:19,910 --> 00:02:21,920
!لقد انكسرت لسبب وجيه

28
00:02:21,920 --> 00:02:23,590
!هذا كلّ ما هنالك

29
00:02:23,850 --> 00:02:25,280
!فهمت

30
00:02:27,180 --> 00:02:31,600
هل تعتقد أنّ رجلين قويّين مثلهما
سيموتان من قتال بالأيدي؟

31
00:02:33,040 --> 00:02:36,940
مستحيل! لكنّ أيّ نزال بين محاربين
!يجب أن يكون دائمًا حتّى الموت

32
00:02:37,200 --> 00:02:41,440
إن كان قتال بسيط بالأيدي كافيًا لفضّ
.النّزالات، فلن يكونا مناسبين كزعيمين لنا

33
00:02:42,070 --> 00:02:43,440
!كنتُ شاهدًا على ذلك

34
00:02:43,440 --> 00:02:47,160
كانت معركة كان فيها
.كلّ هجوم ضربة قاتلة

35
00:02:47,160 --> 00:02:49,660
لم تستطع تصديق ما تراه، صحيح؟ –
!أكيد –

36
00:02:49,660 --> 00:02:52,990
.تلك هي المعارك الّتي تناسب اسم إلباف

37
00:02:56,540 --> 00:03:00,260
،لكنّهما أوقفانا في النّهاية

38
00:03:00,500 --> 00:03:03,640
.وعدنا لبعض الوقت إلى إلباف

39
00:03:03,640 --> 00:03:05,420
.للحصول على أسلحة لنا

40
00:03:05,770 --> 00:03:07,510
للحصول على أسلحة؟

41
00:03:08,680 --> 00:03:10,800
ما زلتما تنويان مواصلة القتال؟

42
00:03:11,170 --> 00:03:12,310
!بالطّبع

43
00:03:13,410 --> 00:03:14,450
.ميؤوس منكما

44
00:03:14,450 --> 00:03:16,210
!مهلاً يا نامي

45
00:03:16,210 --> 00:03:19,480
!ألم تتعلّمي شيئًا من ليتل غاردن؟

46
00:03:19,690 --> 00:03:22,360
!صحيح! أخبرها يا أوسوبّ

47
00:03:22,570 --> 00:03:25,360
!هذا قتال حقيقيّ

48
00:03:27,030 --> 00:03:28,250
ما هذا؟

49
00:03:28,250 --> 00:03:34,210
للتّشبيه، فإنّ هذين الاثنين

50
00:03:29,740 --> 00:03:33,420
قبل سنتين                      ليتل غاردن

51
00:03:34,210 --> 00:03:36,340
.ولا يريدان أن يدمّره الآخرون مهما حدث

52
00:03:36,580 --> 00:03:42,380
.لذلك استمرّا بالقتال لمئة سنة
.لحماية تلك الرّاية

53
00:03:45,260 --> 00:03:46,770
!أفهمت؟

54
00:03:46,770 --> 00:03:51,430
!إنّ هذا بلا شكّ تحدّي فخر عظيم بين محاربين

55
00:03:51,430 --> 00:03:57,570
...هذا هو هدفي بالضّبط
!أن أصبح محارب بحر شجاع

56
00:03:59,060 --> 00:04:00,520
...وأخيرًا

57
00:04:00,960 --> 00:04:03,770
!نحن في طريقنا إلى إلباف أخيرًا

58
00:04:03,770 --> 00:04:06,030
!حسنًا، لنشرب بقدر ما نستطيع

59
00:04:06,030 --> 00:04:07,740
!استمعي إليّ على الأقلّ

60
00:04:08,580 --> 00:04:10,450
تريد أن تصبح عملاقًا إذًا؟

61
00:04:10,450 --> 00:04:13,210
!كلاّ! أكنت تستمعين من الأساس؟

62
00:04:20,850 --> 00:04:23,460
!التّدرّب مع العمالقة؟

63
00:04:23,580 --> 00:04:29,370
يا إلهي... من المحزن أنّ بعض
.النّاس لا يهتمّون إلاّ بالقتال

64
00:04:29,370 --> 00:04:30,550
!ماذا؟

65
00:04:34,100 --> 00:04:35,640
.تخيّل فحسب

66
00:04:36,520 --> 00:04:40,290
لا بدّ أنّ هنالك العديد من
...النّساء العملاقات الجميلات

67
00:04:41,810 --> 00:04:44,860
!انتظرنني أيّتها الحسناوات

68
00:04:44,860 --> 00:04:46,680
.غباؤه يتخطّى الحدود

69
00:04:48,380 --> 00:04:50,990
!رائحة المكان نتنة بسبب ذلك يا فرانكي

70
00:04:51,850 --> 00:04:55,990
.قالوا أنّه يُدعى هاكارل
!إنّه يتماشى جيّدًا مع الخمر والكولا

71
00:04:56,190 --> 00:05:00,370
.بالمناسبة، هذا الخمر قويّ جدًّا

72
00:05:01,130 --> 00:05:04,090
!نعم! هذا أفسنتين

73
00:05:04,090 --> 00:05:07,050
.يُعرف أيضًا بالجنّيّة الخضراء

74
00:05:07,050 --> 00:05:08,210
.هكذا إذًا

75
00:05:08,970 --> 00:05:12,480
.الجنّيّة الخضراء؟ إنّه جميل بالفعل

76
00:05:12,480 --> 00:05:14,590
...سأتذوّق بعضه

77
00:05:14,590 --> 00:05:18,110
،إنّه قد يجعل شاربه يُهلوس
.فكونوا حذرين

78
00:05:20,390 --> 00:05:22,410
هل أنت بخير يا تشوبّر؟

79
00:05:24,820 --> 00:05:27,410
!لا تشربوا الكثير منه أيّها الأغبياء

80
00:05:27,410 --> 00:05:29,360
ألا ترى أنّ الأوان قد فات على ذلك؟

81
00:05:31,350 --> 00:05:33,500
!تشوبّر ثمل

82
00:05:37,520 --> 00:05:40,800
!بدأت أشعر به يغزو عظامي حتّى النّخاع

83
00:05:40,900 --> 00:05:42,410
!هذا لأنّي هيكل عظميّ

84
00:05:43,720 --> 00:05:45,630
!اسمع يا بروك

85
00:05:48,490 --> 00:05:50,090
!غنّ لنا

86
00:05:58,830 --> 00:05:59,830
!أجل

87
00:06:00,830 --> 00:06:01,660
!أيّها الولد

88
00:06:05,540 --> 00:06:08,770
هذه قصّة بطل

89
00:06:08,770 --> 00:06:12,860
قصّة رجل سيصير ملكًا

90
00:06:13,260 --> 00:06:16,780
لا وجود لمحاولات ثانية في الحرب

91
00:06:16,780 --> 00:06:20,640
لكنّه يقف ثابتًا بصندلين في قدميه العاريتين

92
00:06:22,810 --> 00:06:23,640
!أجل

93
00:06:33,970 --> 00:06:36,680
جزيرة غارتل
العالم الجديد

94
00:06:35,010 --> 00:06:37,180
،قبل أزيد من شهر

95
00:06:37,930 --> 00:06:42,380
وقعت حادثة في جزيرة غارتل
.في العالم الجديد

96
00:06:45,620 --> 00:06:49,440
!سأتولّى أمر الأشرار

97
00:06:49,440 --> 00:06:53,530
"آكل لحوم البشر"
بارتولوميو

98
00:06:50,070 --> 00:06:53,530
هزم بارتولوميو مجرمي البلدة

99
00:06:53,750 --> 00:06:57,490
وحاول بيع بضائع طاقم
...قبّعة القشّ، ولكن

100
00:06:57,490 --> 00:06:59,870
،إلى كلّ الموجودين على الجزيرة

101
00:07:01,140 --> 00:07:04,450
!لدينا عرض بنصف السّعر لبضائعنا

102
00:07:09,290 --> 00:07:13,300
!ما المضحك في هذا؟
!يفترض أن تذرفوا دموع فرح

103
00:07:13,830 --> 00:07:17,470
هل تدرون تحت حماية من هذه الجزيرة؟

104
00:07:26,730 --> 00:07:29,690
!أحمر الشّعر؟

105
00:07:31,710 --> 00:07:33,610
!أحد الأباطرة الأربعة؟

106
00:07:35,490 --> 00:07:37,130
!لا أهتمّ

107
00:07:37,650 --> 00:07:42,490
لوفي-سنباي هو المقدّر له
!أن يقود هذه الحقبة

108
00:07:42,490 --> 00:07:44,750
!لوفي-سنباي دون غيره

109
00:07:44,750 --> 00:07:48,870
.كانت صفعة في وجه أحد الأباطرة

110
00:07:48,870 --> 00:07:50,930
اليوم الحاليّ

111
00:08:03,830 --> 00:08:05,470
،إن سمحتُ بهذا

112
00:08:05,470 --> 00:08:10,560
فسيُدمّر ذلك مصداقيّة هذا العلم الّذي
،أعرته للجُزر والقراصنة الآخرين

113
00:08:10,960 --> 00:08:14,520
.وسيضع أصدقائي في خطر

114
00:08:15,730 --> 00:08:17,540
!أنت على حقّ

115
00:08:19,720 --> 00:08:21,470
!أنا جدّ آسف

116
00:08:21,750 --> 00:08:25,090
،لم أتوقّف حتّى للتّفكير في العواقب

117
00:08:25,090 --> 00:08:27,750
.تصرّفت بجهل وغباء

118
00:08:28,000 --> 00:08:30,970
كيف يمكنني التّكفير عن ذلك؟

119
00:08:36,350 --> 00:08:38,050
.سنمنحك فرصة

120
00:08:40,620 --> 00:08:42,970
فرصة؟

121
00:08:43,930 --> 00:08:46,680
.هذا سمّ قاتل

122
00:08:48,260 --> 00:08:53,140
.لديك شهر واحد لدسّه في شراب قبّعة القشّ

123
00:08:58,970 --> 00:09:03,350
يسبّب شربه ألمًا شديدًا، ويجعل الدّماء
،تخرج من كلّ فجوة في الجسم

124
00:09:03,630 --> 00:09:05,240
.ممّا يؤدّي للموت

125
00:09:07,170 --> 00:09:11,040
سنجعل زعيمك الأكبر يدفع الثّمن
.بهذه الطّريقة

126
00:09:13,920 --> 00:09:16,000
!لماذا على لوفي-سنباي دفع الثّمن؟

127
00:09:16,000 --> 00:09:17,430
!نحن الجُناة هنا

128
00:09:17,430 --> 00:09:20,990
!نحن من يتحمّل المسؤوليّة، وليس هو

129
00:09:24,760 --> 00:09:26,400
!يا زعيم

130
00:09:26,720 --> 00:09:29,890
!لا تفعل ذلك! ستموت

131
00:09:30,370 --> 00:09:35,510
!ستخرج الدّماء من جسدك وستموت

132
00:09:38,030 --> 00:09:39,480
.لا بأس

133
00:09:42,450 --> 00:09:44,440
...لا يمكن أن –
!لا بأس –

134
00:09:46,230 --> 00:09:52,000
أقسمنا بالولاء للوفي-سنباي

135
00:09:52,780 --> 00:09:56,210
،لذلك لا علاقة لهذا به

136
00:09:56,880 --> 00:09:58,500
!ولا أريده أن يعرف أيضًا

137
00:09:58,860 --> 00:10:01,170
...لأنّي لا أريده أن

138
00:10:03,260 --> 00:10:08,680
يضيّع ولو لحظة واحدة من وقته
!الثّمين على شخص مثلي

139
00:10:09,290 --> 00:10:15,230
هذه قصّة شائعة لغرّ تحدّى إمبراطورًا

140
00:10:15,670 --> 00:10:17,480
!ونال ما يستحقّ في المقابل

141
00:10:18,380 --> 00:10:19,740
...أنا أيضًا

142
00:10:21,560 --> 00:10:23,730
...أنا أيضًا أريد رؤية

143
00:10:23,990 --> 00:10:27,950
!لوفي-سنباي وهو يصير ملكًا للقراصنة

144
00:10:28,330 --> 00:10:31,490
!لكنّي أفسدت الأمور بسبب غبائي

145
00:10:32,650 --> 00:10:35,960
!سأترك كلّ شيء لكم يا رفاقي

146
00:10:35,960 --> 00:10:37,920
!يا زعيم

147
00:10:39,400 --> 00:10:40,990
...الوداع

148
00:10:42,130 --> 00:10:44,120
...يا إصدقائي

149
00:10:55,630 --> 00:10:56,740
ماذا؟

150
00:10:58,100 --> 00:11:03,360
نادي بارتو

151
00:10:59,880 --> 00:11:01,610
!سمحوا لنا بالذّهاب

152
00:11:01,610 --> 00:11:03,360
!هيّا! لنغادر بأسرع ما يمكننا

153
00:11:04,740 --> 00:11:10,320
بما أنّه لم يكن سمًّا، فذلك يعني أنّهم
.لم يريدوا قتل لوفي-سنباي من الأساس

154
00:11:10,630 --> 00:11:14,660
،إنّه إمبراطور، لذلك توقّعتُ أن يكون قاسيًا

155
00:11:14,660 --> 00:11:16,830
!لكنّه كان شخصًا ليّنًا في الحقيقة

156
00:11:23,740 --> 00:11:26,880
لماذا تبتسم يا زعيم؟

157
00:11:26,940 --> 00:11:27,880
...نعم

158
00:11:28,450 --> 00:11:32,970
لأنّي سعيد بمعرفة أنّ لوفي
.يحظى بكلّ ذلك الاحترام

159
00:11:35,540 --> 00:11:39,150
.حسنًا يا زعيم، تنحّ جانبًا

160
00:11:42,970 --> 00:11:45,320
.ما زال عليهم دفع الثّمن

161
00:11:56,160 --> 00:11:58,650
،وعلى ساحل جزيرة غارتل

162
00:11:59,400 --> 00:12:02,000
...فإنّ سفينة قراصنة نادي بارتو

163
00:12:03,130 --> 00:12:04,560
.غرقت

164
00:12:06,780 --> 00:12:08,440
.وضعهم مجهول

165
00:12:38,620 --> 00:12:40,540
جزيرة القراصنة
هاتشينوسو

166
00:12:56,420 --> 00:12:58,600
قبطان السّفينة الثّانية لقراصنة اللّحية السّوداء
شيريو المطر

167
00:13:00,560 --> 00:13:05,440
!ما الّذي حدث هنا أثناء غيابي؟

168
00:13:06,110 --> 00:13:08,150
قبضان السّفينة الثّامنة لقراصنة اللّحية السّوداء
"فاسكو شوت "السّكّير

169
00:13:09,200 --> 00:13:10,900
!يا بيزارو

170
00:13:12,120 --> 00:13:16,160
قبضان السّفينة الرّابعة لقراصنة اللّحية السّوداء
الملك الفاسد أفالو بيزارو

171
00:13:12,270 --> 00:13:16,160
...كلاّ! تيتش! إنّ الأمر

172
00:13:19,100 --> 00:13:22,040
...رسالة فيغابانك

173
00:13:19,370 --> 00:13:22,040
عميد قراصنة اللّحية السّوداء
مارشال د. تيتش

174
00:13:24,400 --> 00:13:27,900
سمعتموها، صحيح؟

175
00:13:28,830 --> 00:13:31,470
.بدأ العالم بالتّحرّك أخيرًا

176
00:13:31,650 --> 00:13:35,860
ولم تعد البونيغليف معرفة يحتكر
.بها عالم السّفليّ فحسب

177
00:13:36,250 --> 00:13:40,380
باختصار، سيتدافع الأباطرة الأربعة
.للحصول على تلك الحجارة

178
00:13:40,450 --> 00:13:43,850
وحكومة العالم والبحريّة
.سيدخلون السّباق أيضًا

179
00:13:44,840 --> 00:13:48,360
.لا فوز ما لم نتولّى أمرهم

180
00:13:49,980 --> 00:13:54,050
،كان كوبي هو رهينتنا النّفيسة
أليس كذلك؟

181
00:13:55,570 --> 00:13:59,580
!لكنّك سمحت له بالهرب؟

182
00:14:00,310 --> 00:14:02,620
!أنا آسف! أنا آسف يا تيتش

183
00:14:02,620 --> 00:14:05,540
...ولكن استمع لي! هناك من حرّر موريا

184
00:14:06,030 --> 00:14:07,000
!ماذا؟

185
00:14:08,380 --> 00:14:12,090
قبضان السّفينة السّابعة لقراصنة اللّحية السّوداء
السّفينة الحربيّة العظيمة" سان خوان ولف"

186
00:14:09,080 --> 00:14:12,090
أين كان هذا المتجر من قبل؟

187
00:14:12,090 --> 00:14:15,000
!لا، ليس هناك! إلى اليسار قليلاً

188
00:14:15,000 --> 00:14:16,800
.ويحي. أنا آسف

189
00:14:17,510 --> 00:14:19,260
!لا، لا، لا

190
00:14:19,890 --> 00:14:21,880
!سحقتَ مبنى آخر بمؤخّرتك

191
00:14:21,880 --> 00:14:23,910
.يا ويحي

192
00:14:23,910 --> 00:14:26,750
!سمحت لموريا بالفرار أيضًا؟

193
00:14:30,300 --> 00:14:31,620
...مهلاً، كان ذلك

194
00:14:31,620 --> 00:14:33,030
...ذلك الصّوت

195
00:14:33,370 --> 00:14:35,340
!أيّها العميد

196
00:14:47,920 --> 00:14:49,630
!العميد

197
00:14:51,630 --> 00:14:54,670
!نحن جاهزون في أيّ وقت

198
00:14:54,670 --> 00:14:56,440
!الكنز العظيم

199
00:14:56,440 --> 00:14:58,920
...إنّ من سيجد الوان بيس

200
00:14:59,180 --> 00:15:01,850
!هو أنت، صحيح أيّها اللّحية السّوداء؟

201
00:15:02,310 --> 00:15:05,270
!لنغزو العالم

202
00:15:17,580 --> 00:15:19,110
قبضان السّفينة التّاسعة لقراصنة اللّحية السّوداء
دوك كيو

203
00:15:20,160 --> 00:15:22,030
!روحهم عالية جدًّا

204
00:15:25,900 --> 00:15:28,580
!علينا استغلال هذا لصالحنا

205
00:15:34,060 --> 00:15:36,510
.والآن يا كوزا

206
00:15:37,120 --> 00:15:41,190
كنت تقول أنّ كوبي هرب ولكن...؟

207
00:15:40,430 --> 00:15:44,220
قبضان السّفينة العاشرة لقراصنة اللّحية السّوداء
كوزان

208
00:15:41,190 --> 00:15:43,960
.نعم، ولكنّنا أمسكنا بغارب

209
00:15:45,970 --> 00:15:47,850
!هذا مثاليّ

210
00:15:47,850 --> 00:15:50,900
إنّه قيّم أكثر من كوبي، صحيح؟

211
00:15:50,900 --> 00:15:52,400
!اخرس أنت

212
00:15:53,550 --> 00:15:56,240
...ولكن لنكون أدقّ

213
00:15:57,340 --> 00:16:02,220
.ظننّا أنّنا قتلناه، ولكنّه ما زال حيًّا

214
00:16:02,870 --> 00:16:05,550
.هذا إنجاز عظيم جدًّا يا كوزان

215
00:16:05,550 --> 00:16:08,210
من غيرك كان ليستطيع الإطاحة به؟

216
00:16:08,810 --> 00:16:11,790
.لا، تطلّب الأمر تعاونًا منّا جميعًا

217
00:16:11,790 --> 00:16:13,920
.تهبّ الرّياح في صالحنا

218
00:16:14,910 --> 00:16:15,880
!نعم

219
00:16:16,990 --> 00:16:18,720
...وفوق ذلك

220
00:16:19,840 --> 00:16:21,520
!كفّوا عن دفعي

221
00:16:22,770 --> 00:16:26,000
.بحوزتي فتاة العيون الثّلاثة

222
00:16:29,940 --> 00:16:31,440
!لا تلمسني

223
00:16:32,800 --> 00:16:35,400
.اسمع، صِلني بلافيت

224
00:16:45,230 --> 00:16:47,790
مقرّ شركة أوميت للشّحن البحريّ

225
00:16:50,650 --> 00:16:52,160
.نعم أيّها العميد

226
00:16:52,160 --> 00:16:56,840
ما الّذي يؤخّرك؟
علام ينوي الجيش الثّوريّ؟

227
00:16:56,840 --> 00:16:57,840
...حسنًا

228
00:16:58,010 --> 00:17:01,090
قبضان السّفينة الخامسة لقراصنة اللّحية السّوداء
لافيت

229
00:16:59,160 --> 00:17:02,700
.إنّهم يحاولون بالفعل تجويعهم

230
00:17:03,240 --> 00:17:06,430
إنّ مصاعد البوندورا في الميناء
.الأحمر تتحطّم باستمرار

231
00:17:08,670 --> 00:17:13,020
.ويحدث ذلك دائمًا عندما تُحمّل بالطّعام

232
00:17:13,340 --> 00:17:17,320
تمّت محاصرة شُحنات الطّعام
.من مختلف البلدان أيضًا

233
00:17:17,320 --> 00:17:20,550
،حتّى إن استطعت البحريّة تأمين الطّعام

234
00:17:20,550 --> 00:17:24,000
إلاّ أنّ مصاعد البوندورا
.إلى ماريجوا تتحطّم باستمرار

235
00:17:24,620 --> 00:17:29,080
،إن مات أيّ تنّين سماويّ جوعًا

236
00:17:29,600 --> 00:17:32,080
.فستكون حادثة لا سابق لها

237
00:17:32,330 --> 00:17:33,870
!كم هذا ممتع

238
00:17:37,100 --> 00:17:39,470
...كفّ عن الاستمتاع بالأمر

239
00:17:39,820 --> 00:17:41,830
.واستعدّ في الحال

240
00:17:42,910 --> 00:17:44,760
.مفهوم

241
00:17:48,870 --> 00:17:51,190
.بيزارو، لقد وصلنا

242
00:17:51,450 --> 00:17:53,230
!مهلاً، مهلاً، مهلاً

243
00:17:53,800 --> 00:17:56,650
!أنا هنا أخيرًا

244
00:17:56,650 --> 00:18:00,650
!أنا في قاعدة تيتش-ساما

245
00:18:02,150 --> 00:18:04,000
!ماذا؟

246
00:18:04,000 --> 00:18:06,700
!تلك العين تتحرّك

247
00:18:06,700 --> 00:18:08,120
.إنّها ديفون

248
00:18:12,010 --> 00:18:15,040
!يا إلهي

249
00:18:16,580 --> 00:18:17,670
!كلاّ

250
00:18:21,380 --> 00:18:25,470
!لِمَ ترفضين الرّسو في الميناء ببساطة؟

251
00:18:25,470 --> 00:18:28,210
.أنا مصاب

252
00:18:29,290 --> 00:18:31,670
!كلاّ! هذا سيّئ

253
00:18:31,670 --> 00:18:36,350
!ثمّة وحش عملاق يحملنا

254
00:18:36,350 --> 00:18:40,040
!يا أخي الكبير! يا أختي الكبرى
!افعلا شيء حيال هذا

255
00:18:40,040 --> 00:18:42,130
ألا يخرس أبدًا؟

256
00:18:42,830 --> 00:18:46,220
!هل أحضرتما الرّجل الّذي تحدّثتما عنه؟

257
00:18:46,220 --> 00:18:47,280
.نعم

258
00:18:48,400 --> 00:18:51,700
.كان ذلك قرار تيتش، ما باليد حيلة

259
00:18:52,440 --> 00:18:53,650
.صحيح

260
00:18:58,030 --> 00:19:01,960
...رغم مغادرتهم لإيغهيد قبل يومين

261
00:19:06,630 --> 00:19:08,650
وماذا عن هناك؟ –
!ليسوا هنا –

262
00:19:08,650 --> 00:19:10,090
!ولا هنا أيضًا

263
00:19:10,090 --> 00:19:11,510
!ما الّذي يحدث؟

264
00:19:13,370 --> 00:19:17,670
،حتّى سفينة القراصنة العمالقة
...إريك العظيمة

265
00:19:17,670 --> 00:19:20,830
...لم تصل إلى إلباف بعد

266
00:19:20,830 --> 00:19:22,570
.لسبب واحد فقط

267
00:19:22,570 --> 00:19:25,150
!لا أصدّق هذا

268
00:19:25,330 --> 00:19:27,610
...شربنا حتّى فقدنا الوعي وعندما استيقظنا

269
00:19:27,770 --> 00:19:30,620
!كانت السّفينة ساني قد اختفت

270
00:19:31,070 --> 00:19:34,580
!لم نعثر عليها في أيّ مكان

271
00:19:43,860 --> 00:19:46,340
.كانت تبحر إلى جانبنا في آخر مرّة رأيتها

272
00:19:47,150 --> 00:19:49,920
هل انجرفت بعيدًا عنّا؟

273
00:19:51,550 --> 00:19:54,110
اختفى لوفي والبقيّة؟

274
00:19:54,110 --> 00:19:55,520
.ذلك ما يبدو

275
00:19:57,080 --> 00:20:00,150
!لا يمكنني أن أهدأ
!لا يمكننا العودة إلى إلباف هكذا

276
00:20:00,480 --> 00:20:02,760
!سنعثر عليهم مهما كلّف الأمر

277
00:20:02,760 --> 00:20:04,160
...ربّما

278
00:20:05,340 --> 00:20:08,090
.مزّقتهم سمكة ما لأشلاء

279
00:20:08,300 --> 00:20:12,420
الأسماك هنا ضخمة، لذلك قد يكون
!هذا واردًا! وهو أمر ليس مضحكًا

280
00:20:12,420 --> 00:20:14,750
!إلى أين ذهبوا؟

281
00:20:16,230 --> 00:20:17,250
!لوفي

282
00:20:17,310 --> 00:20:18,330
!زورو

283
00:20:18,330 --> 00:20:20,170
!أوسوبّ

284
00:20:20,170 --> 00:20:21,790
!سانجي-سان

285
00:20:21,790 --> 00:20:23,790
!تشوبّر-سان

286
00:20:23,970 --> 00:20:27,310
!نامي

287
00:20:33,140 --> 00:20:36,700
...اركض حتّى نصل إلى

288
00:20:36,700 --> 00:20:40,970
حتّى نصل إليك

289
00:20:45,860 --> 00:20:49,240
البحر الأزرق الصّافي المفتوح

290
00:20:49,570 --> 00:20:52,570
جزء من معجزة

291
00:20:53,080 --> 00:20:59,100
تقابلنا أكثر ممّا يمكننا تصّوره

292
00:20:59,100 --> 00:21:01,810
مع كلّ خطوة نخطوها في هذه الرّحلة

293
00:21:01,810 --> 00:21:05,820
ما زال الهدف بعيد المنال

294
00:21:05,820 --> 00:21:09,320
لكن بإمكاننا تجاوز أيّ عقبة

295
00:21:09,320 --> 00:21:12,490
لأنّنا نريد رؤية ابتسامتك

296
00:21:12,490 --> 00:21:16,790
إن تردّدنا، فلن نتألّق

297
00:21:16,790 --> 00:21:20,520
بل سعينا جاهدين للتّغلّب على نقاط ضعفنا

298
00:21:20,520 --> 00:21:26,000
نحن الّذين كنّا مخلصين

299
00:21:26,000 --> 00:21:30,050
لطالما كنّا كذلك

300
00:21:30,050 --> 00:21:38,720
...اركض حتّى نصل إلى
حتّى نصل إليك

301
00:21:38,720 --> 00:21:45,400
لن نبلغ مستوى الأسطورة؟
!لا مشكلة! كلّ شيء على ما يرام

302
00:21:45,400 --> 00:21:51,800
اتبع الخريطة المتألّقة إلى أن يأتي
اليوم الّذي نستطيع فيه الضّحك

303
00:21:51,800 --> 00:21:58,180
لذلك لا مزيد من التّردّد أيّها المقاتل
سيكون كلّ شيء بخير

304
00:22:02,790 --> 00:22:04,530
!نامي! نامي

305
00:22:04,530 --> 00:22:06,020
!هيّا، استيقظي

306
00:22:23,940 --> 00:22:25,480
...هذا مؤلم

307
00:22:26,110 --> 00:22:29,710
شربت... الكثير؟

308
00:22:37,510 --> 00:22:38,600
ماذا؟

309
00:22:40,390 --> 00:22:46,440
يُتبع

310
00:22:49,940 --> 00:22:53,290
.تستيقظ نامي في مكان غريب وتجول في الأرجاء

311
00:22:53,860 --> 00:22:58,570
،أشكال الأرض والجدران غريبة جدًّا
.ووحوش عملاقة تهاجم الواحد تلو الآخر

312
00:22:58,570 --> 00:23:00,740
أهذا حلم؟ أم هو واقع؟

313
00:23:01,480 --> 00:23:06,120
المغامرة الّتي دخلها طاقم قبّعة القشّ
.قد صارت محفوفة بالمخاطر والقلق

314
00:23:06,570 --> 00:23:08,210
:في الحلقة القادمة من وان بيس

315
00:23:08,210 --> 00:23:11,240
"!نامي في حيرة! مغامرة في بلاد المكعّبات"

316
00:23:11,240 --> 00:23:13,550
!ملك القراصنة، لن يكون إلاّ أنا