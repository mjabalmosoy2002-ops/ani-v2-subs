1
00:00:12,080 --> 00:00:19,070
!إلى الأمام! إلى الأمام

2
00:00:25,680 --> 00:00:28,170
!إنّنا نحلّق خارجها

3
00:00:33,750 --> 00:00:36,490
...يا رفاق! يومًا ما

4
00:00:36,490 --> 00:00:40,680
!سأذهب إلى إلباف! إلى بلاد المحاربين

5
00:00:41,050 --> 00:00:44,310
!بالطّبع يا أوسوبّ
!سنذهب إلى هناك بالتّأكيد

6
00:00:45,160 --> 00:00:48,340
!سنذهب إلى موطن العمالقة يومًا ما

7
00:00:48,340 --> 00:00:50,110
!أجل

8
00:00:50,110 --> 00:00:54,250
!إلباف-باف! إلباف-باف

9
00:00:54,250 --> 00:00:58,380
!إنّهم ضخام لأنّهم عمالقة

10
00:01:01,070 --> 00:01:03,700
!حانت اللّحظة أخيرًا يا أوسوبّ

11
00:01:03,700 --> 00:01:04,910
!أجل

12
00:01:05,150 --> 00:01:08,540
!لنذهب إلى إلباف

13
00:01:14,410 --> 00:01:19,530
!إلباف الّتي طال انتظارها"
"!وليمة لمّ الشّمل الكبيرة

14
00:01:28,170 --> 00:01:31,080
.غادر لوفي والبقيّة إيغهيد

15
00:01:32,400 --> 00:01:37,810
واستمرّت وليمتهم وهم في طريقهم
.إلى وجهتهم التّالية، إلباف

16
00:01:42,630 --> 00:01:44,320
...وثمّ

17
00:01:44,320 --> 00:01:46,850
مهلاً، أتستمع لي يا قبّعة القشّ؟

18
00:01:48,960 --> 00:01:52,490
...بعد أن ودّعناكم في ووتر سفن

19
00:01:52,490 --> 00:01:57,590
.ذهبنا إلى ليتل غاردن للقاء زعيمينا فحسب

20
00:01:57,590 --> 00:01:59,610
!هذا ما حدث إذًا؟

21
00:01:59,610 --> 00:02:03,430
.بالطّبع ستتساءلان عنهما
!مرّ قرن بأكمله على انفصالكم

22
00:02:03,430 --> 00:02:05,390
وهل تدري ما حدث بعدها؟

23
00:02:05,690 --> 00:02:08,880
!كانا يتقاتلان بيديهما العاريتين

24
00:02:08,880 --> 00:02:09,980
!ماذا؟

25
00:02:20,380 --> 00:02:23,370
!لماذا؟ ما الّذي حدث لأسلحتكما؟

26
00:02:23,730 --> 00:02:25,410
...هذا لأنّ

27
00:02:33,910 --> 00:02:35,920
!لقد انكسرت لسبب وجيه

28
00:02:35,920 --> 00:02:37,590
!هذا كلّ ما هنالك

29
00:02:37,850 --> 00:02:39,280
!فهمت

30
00:02:41,180 --> 00:02:45,600
هل تعتقد أنّ رجلين قويّين مثلهما
سيموتان من قتال بالأيدي؟

31
00:02:47,040 --> 00:02:50,940
مستحيل! لكنّ أيّ نزال بين محاربين
!يجب أن يكون دائمًا حتّى الموت

32
00:02:51,200 --> 00:02:55,440
إن كان قتال بسيط بالأيدي كافيًا لفضّ
.النّزالات، فلن يكونا مناسبين كزعيمين لنا

33
00:02:56,070 --> 00:02:57,440
!كنتُ شاهدًا على ذلك

34
00:02:57,440 --> 00:03:01,160
كانت معركة كان فيها
.كلّ هجوم ضربة قاتلة

35
00:03:01,160 --> 00:03:03,660
لم تستطع تصديق ما تراه، صحيح؟ –
!أكيد –

36
00:03:03,660 --> 00:03:06,990
.تلك هي المعارك الّتي تناسب اسم إلباف

37
00:03:10,540 --> 00:03:14,260
،لكنّهما أوقفانا في النّهاية

38
00:03:14,500 --> 00:03:17,640
.وعدنا لبعض الوقت إلى إلباف

39
00:03:17,640 --> 00:03:19,420
.للحصول على أسلحة لنا

40
00:03:19,770 --> 00:03:21,510
للحصول على أسلحة؟

41
00:03:22,680 --> 00:03:24,800
ما زلتما تنويان مواصلة القتال؟

42
00:03:25,170 --> 00:03:26,310
!بالطّبع

43
00:03:27,410 --> 00:03:28,450
.ميؤوس منكما

44
00:03:28,450 --> 00:03:30,210
!مهلاً يا نامي

45
00:03:30,210 --> 00:03:33,480
!ألم تتعلّمي شيئًا من ليتل غاردن؟

46
00:03:33,690 --> 00:03:36,360
!صحيح! أخبرها يا أوسوبّ

47
00:03:36,570 --> 00:03:39,360
!هذا قتال حقيقيّ

48
00:03:41,030 --> 00:03:42,250
ما هذا؟

49
00:03:42,250 --> 00:03:48,210
للتّشبيه، فإنّ هذين الاثنين

50
00:03:43,740 --> 00:03:47,420
قبل سنتين                      ليتل غاردن

51
00:03:48,210 --> 00:03:50,340
.ولا يريدان أن يدمّره الآخرون مهما حدث

52
00:03:50,580 --> 00:03:56,380
.لذلك استمرّا بالقتال لمئة سنة
.لحماية تلك الرّاية

53
00:03:59,260 --> 00:04:00,770
!أفهمت؟

54
00:04:00,770 --> 00:04:05,430
!إنّ هذا بلا شكّ تحدّي فخر عظيم بين محاربين

55
00:04:05,430 --> 00:04:11,570
...هذا هو هدفي بالضّبط
!أن أصبح محارب بحر شجاع

56
00:04:13,060 --> 00:04:14,520
...وأخيرًا

57
00:04:14,960 --> 00:04:17,770
!نحن في طريقنا إلى إلباف أخيرًا

58
00:04:17,770 --> 00:04:20,030
!حسنًا، لنشرب بقدر ما نستطيع

59
00:04:20,030 --> 00:04:21,740
!استمعي إليّ على الأقلّ

60
00:04:22,580 --> 00:04:24,450
تريد أن تصبح عملاقًا إذًا؟

61
00:04:24,450 --> 00:04:27,210
!كلاّ! أكنت تستمعين من الأساس؟

62
00:04:34,850 --> 00:04:37,460
!التّدرّب مع العمالقة؟

63
00:04:37,580 --> 00:04:43,370
يا إلهي... من المحزن أنّ بعض
.النّاس لا يهتمّون إلاّ بالقتال

64
00:04:43,370 --> 00:04:44,550
!ماذا؟

65
00:04:48,100 --> 00:04:49,640
.تخيّل فحسب

66
00:04:50,520 --> 00:04:54,290
لا بدّ أنّ هنالك العديد من
...النّساء العملاقات الجميلات

67
00:04:55,810 --> 00:04:58,860
!انتظرنني أيّتها الحسناوات

68
00:04:58,860 --> 00:05:00,680
.غباؤه يتخطّى الحدود

69
00:05:02,380 --> 00:05:04,990
!رائحة المكان نتنة بسبب ذلك يا فرانكي

70
00:05:05,850 --> 00:05:09,990
.قالوا أنّه يُدعى هاكارل
!إنّه يتماشى جيّدًا مع الخمر والكولا

71
00:05:10,190 --> 00:05:14,370
.بالمناسبة، هذا الخمر قويّ جدًّا

72
00:05:15,130 --> 00:05:18,090
!نعم! هذا أفسنتين

73
00:05:18,090 --> 00:05:21,050
.يُعرف أيضًا بالجنّيّة الخضراء

74
00:05:21,050 --> 00:05:22,210
.هكذا إذًا

75
00:05:22,970 --> 00:05:26,480
.الجنّيّة الخضراء؟ إنّه جميل بالفعل

76
00:05:26,480 --> 00:05:28,590
...سأتذوّق بعضه

77
00:05:28,590 --> 00:05:32,110
،إنّه قد يجعل شاربه يُهلوس
.فكونوا حذرين

78
00:05:34,390 --> 00:05:36,410
هل أنت بخير يا تشوبّر؟

79
00:05:38,820 --> 00:05:41,410
!لا تشربوا الكثير منه أيّها الأغبياء

80
00:05:41,410 --> 00:05:43,360
ألا ترى أنّ الأوان قد فات على ذلك؟

81
00:05:45,350 --> 00:05:47,500
!تشوبّر ثمل

82
00:05:51,520 --> 00:05:54,800
!بدأت أشعر به يغزو عظامي حتّى النّخاع

83
00:05:54,900 --> 00:05:56,410
!هذا لأنّي هيكل عظميّ

84
00:05:57,720 --> 00:05:59,630
!اسمع يا بروك

85
00:06:02,490 --> 00:06:04,090
!غنّ لنا

86
00:06:12,830 --> 00:06:13,830
!أجل

87
00:06:14,830 --> 00:06:15,660
!أيّها الولد

88
00:06:19,540 --> 00:06:22,770
هذه قصّة بطل

89
00:06:22,770 --> 00:06:26,860
قصّة رجل سيصير ملكًا

90
00:06:27,260 --> 00:06:30,780
لا وجود لمحاولات ثانية في الحرب

91
00:06:30,780 --> 00:06:34,640
لكنّه يقف ثابتًا بصندلين في قدميه العاريتين

92
00:06:36,810 --> 00:06:37,640
!أجل

93
00:06:47,970 --> 00:06:50,680
جزيرة غارتل
العالم الجديد

94
00:06:49,010 --> 00:06:51,180
،قبل أزيد من شهر

95
00:06:51,930 --> 00:06:56,380
وقعت حادثة في جزيرة غارتل
.في العالم الجديد

96
00:06:59,620 --> 00:07:03,440
!سأتولّى أمر الأشرار

97
00:07:03,440 --> 00:07:07,530
"آكل لحوم البشر"
بارتولوميو

98
00:07:04,070 --> 00:07:07,530
هزم بارتولوميو مجرمي البلدة

99
00:07:07,750 --> 00:07:11,490
وحاول بيع بضائع طاقم
...قبّعة القشّ، ولكن

100
00:07:11,490 --> 00:07:13,870
،إلى كلّ الموجودين على الجزيرة

101
00:07:15,140 --> 00:07:18,450
!لدينا عرض بنصف السّعر لبضائعنا

102
00:07:23,290 --> 00:07:27,300
!ما المضحك في هذا؟
!يفترض أن تذرفوا دموع فرح

103
00:07:27,830 --> 00:07:31,470
هل تدرون تحت حماية من هذه الجزيرة؟

104
00:07:40,730 --> 00:07:43,690
!أحمر الشّعر؟

105
00:07:45,710 --> 00:07:47,610
!أحد الأباطرة الأربعة؟

106
00:07:49,490 --> 00:07:51,130
!لا أهتمّ

107
00:07:51,650 --> 00:07:56,490
لوفي-سنباي هو المقدّر له
!أن يقود هذه الحقبة

108
00:07:56,490 --> 00:07:58,750
!لوفي-سنباي دون غيره

109
00:07:58,750 --> 00:08:02,870
.كانت صفعة في وجه أحد الأباطرة

110
00:08:02,870 --> 00:08:04,930
اليوم الحاليّ

111
00:08:17,830 --> 00:08:19,470
،إن سمحتُ بهذا

112
00:08:19,470 --> 00:08:24,560
فسيُدمّر ذلك مصداقيّة هذا العلم الّذي
،أعرته للجُزر والقراصنة الآخرين

113
00:08:24,960 --> 00:08:28,520
.وسيضع أصدقائي في خطر

114
00:08:29,730 --> 00:08:31,540
!أنت على حقّ

115
00:08:33,720 --> 00:08:35,470
!أنا جدّ آسف

116
00:08:35,750 --> 00:08:39,090
،لم أتوقّف حتّى للتّفكير في العواقب

117
00:08:39,090 --> 00:08:41,750
.تصرّفت بجهل وغباء

118
00:08:42,000 --> 00:08:44,970
كيف يمكنني التّكفير عن ذلك؟

119
00:08:50,350 --> 00:08:52,050
.سنمنحك فرصة

120
00:08:54,620 --> 00:08:56,970
فرصة؟

121
00:08:57,930 --> 00:09:00,680
.هذا سمّ قاتل

122
00:09:02,260 --> 00:09:07,140
.لديك شهر واحد لدسّه في شراب قبّعة القشّ

123
00:09:12,970 --> 00:09:17,350
يسبّب شربه ألمًا شديدًا، ويجعل الدّماء
،تخرج من كلّ فجوة في الجسم

124
00:09:17,630 --> 00:09:19,240
.ممّا يؤدّي للموت

125
00:09:21,170 --> 00:09:25,040
سنجعل زعيمك الأكبر يدفع الثّمن
.بهذه الطّريقة

126
00:09:27,920 --> 00:09:30,000
!لماذا على لوفي-سنباي دفع الثّمن؟

127
00:09:30,000 --> 00:09:31,430
!نحن الجُناة هنا

128
00:09:31,430 --> 00:09:34,990
!نحن من يتحمّل المسؤوليّة، وليس هو

129
00:09:38,760 --> 00:09:40,400
!يا زعيم

130
00:09:40,720 --> 00:09:43,890
!لا تفعل ذلك! ستموت

131
00:09:44,370 --> 00:09:49,510
!ستخرج الدّماء من جسدك وستموت

132
00:09:52,030 --> 00:09:53,480
.لا بأس

133
00:09:56,450 --> 00:09:58,440
...لا يمكن أن –
!لا بأس –

134
00:10:00,230 --> 00:10:06,000
أقسمنا بالولاء للوفي-سنباي

135
00:10:06,780 --> 00:10:10,210
،لذلك لا علاقة لهذا به

136
00:10:10,880 --> 00:10:12,500
!ولا أريده أن يعرف أيضًا

137
00:10:12,860 --> 00:10:15,170
...لأنّي لا أريده أن

138
00:10:17,260 --> 00:10:22,680
يضيّع ولو لحظة واحدة من وقته
!الثّمين على شخص مثلي

139
00:10:23,290 --> 00:10:29,230
هذه قصّة شائعة لغرّ تحدّى إمبراطورًا

140
00:10:29,670 --> 00:10:31,480
!ونال ما يستحقّ في المقابل

141
00:10:32,380 --> 00:10:33,740
...أنا أيضًا

142
00:10:35,560 --> 00:10:37,730
...أنا أيضًا أريد رؤية

143
00:10:37,990 --> 00:10:41,950
!لوفي-سنباي وهو يصير ملكًا للقراصنة

144
00:10:42,330 --> 00:10:45,490
!لكنّي أفسدت الأمور بسبب غبائي

145
00:10:46,650 --> 00:10:49,960
!سأترك كلّ شيء لكم يا رفاقي

146
00:10:49,960 --> 00:10:51,920
!يا زعيم

147
00:10:53,400 --> 00:10:54,990
...الوداع

148
00:10:56,130 --> 00:10:58,120
...يا إصدقائي

149
00:11:09,630 --> 00:11:10,740
ماذا؟

150
00:11:12,100 --> 00:11:17,360
نادي بارتو

151
00:11:13,880 --> 00:11:15,610
!سمحوا لنا بالذّهاب

152
00:11:15,610 --> 00:11:17,360
!هيّا! لنغادر بأسرع ما يمكننا

153
00:11:18,740 --> 00:11:24,320
بما أنّه لم يكن سمًّا، فذلك يعني أنّهم
.لم يريدوا قتل لوفي-سنباي من الأساس

154
00:11:24,630 --> 00:11:28,660
،إنّه إمبراطور، لذلك توقّعتُ أن يكون قاسيًا

155
00:11:28,660 --> 00:11:30,830
!لكنّه كان شخصًا ليّنًا في الحقيقة

156
00:11:37,740 --> 00:11:40,880
لماذا تبتسم يا زعيم؟

157
00:11:40,940 --> 00:11:41,880
...نعم

158
00:11:42,450 --> 00:11:46,970
لأنّي سعيد بمعرفة أنّ لوفي
.يحظى بكلّ ذلك الاحترام

159
00:11:49,540 --> 00:11:53,150
.حسنًا يا زعيم، تنحّ جانبًا

160
00:11:56,970 --> 00:11:59,320
.ما زال عليهم دفع الثّمن

161
00:12:10,160 --> 00:12:12,650
،وعلى ساحل جزيرة غارتل

162
00:12:13,400 --> 00:12:16,000
...فإنّ سفينة قراصنة نادي بارتو

163
00:12:17,130 --> 00:12:18,560
.غرقت

164
00:12:20,780 --> 00:12:22,440
.وضعهم مجهول

165
00:12:52,620 --> 00:12:54,540
جزيرة القراصنة
هاتشينوسو

166
00:13:10,420 --> 00:13:12,600
قبطان السّفينة الثّانية لقراصنة اللّحية السّوداء
شيريو المطر

167
00:13:14,560 --> 00:13:19,440
!ما الّذي حدث هنا أثناء غيابي؟

168
00:13:20,110 --> 00:13:22,150
قبضان السّفينة الثّامنة لقراصنة اللّحية السّوداء
"فاسكو شوت "السّكّير

169
00:13:23,200 --> 00:13:24,900
!يا بيزارو

170
00:13:26,120 --> 00:13:30,160
قبضان السّفينة الرّابعة لقراصنة اللّحية السّوداء
الملك الفاسد أفالو بيزارو

171
00:13:26,270 --> 00:13:30,160
...كلاّ! تيتش! إنّ الأمر

172
00:13:33,100 --> 00:13:36,040
...رسالة فيغابانك

173
00:13:33,370 --> 00:13:36,040
عميد قراصنة اللّحية السّوداء
مارشال د. تيتش

174
00:13:38,400 --> 00:13:41,900
سمعتموها، صحيح؟

175
00:13:42,830 --> 00:13:45,470
.بدأ العالم بالتّحرّك أخيرًا

176
00:13:45,650 --> 00:13:49,860
ولم تعد البونيغليف معرفة يحتكر
.بها عالم السّفليّ فحسب

177
00:13:50,250 --> 00:13:54,380
باختصار، سيتدافع الأباطرة الأربعة
.للحصول على تلك الحجارة

178
00:13:54,450 --> 00:13:57,850
وحكومة العالم والبحريّة
.سيدخلون السّباق أيضًا

179
00:13:58,840 --> 00:14:02,360
.لا فوز ما لم نتولّى أمرهم

180
00:14:03,980 --> 00:14:08,050
،كان كوبي هو رهينتنا النّفيسة
أليس كذلك؟

181
00:14:09,570 --> 00:14:13,580
!لكنّك سمحت له بالهرب؟

182
00:14:14,310 --> 00:14:16,620
!أنا آسف! أنا آسف يا تيتش

183
00:14:16,620 --> 00:14:19,540
...ولكن استمع لي! هناك من حرّر موريا

184
00:14:20,030 --> 00:14:21,000
!ماذا؟

185
00:14:22,380 --> 00:14:26,090
قبضان السّفينة السّابعة لقراصنة اللّحية السّوداء
السّفينة الحربيّة العظيمة" سان خوان ولف"

186
00:14:23,080 --> 00:14:26,090
أين كان هذا المتجر من قبل؟

187
00:14:26,090 --> 00:14:29,000
!لا، ليس هناك! إلى اليسار قليلاً

188
00:14:29,000 --> 00:14:30,800
.ويحي. أنا آسف

189
00:14:31,510 --> 00:14:33,260
!لا، لا، لا

190
00:14:33,890 --> 00:14:35,880
!سحقتَ مبنى آخر بمؤخّرتك

191
00:14:35,880 --> 00:14:37,910
.يا ويحي

192
00:14:37,910 --> 00:14:40,750
!سمحت لموريا بالفرار أيضًا؟

193
00:14:44,300 --> 00:14:45,620
...مهلاً، كان ذلك

194
00:14:45,620 --> 00:14:47,030
...ذلك الصّوت

195
00:14:47,370 --> 00:14:49,340
!أيّها العميد

196
00:15:01,920 --> 00:15:03,630
!العميد

197
00:15:05,630 --> 00:15:08,670
!نحن جاهزون في أيّ وقت

198
00:15:08,670 --> 00:15:10,440
!الكنز العظيم

199
00:15:10,440 --> 00:15:12,920
...إنّ من سيجد الوان بيس

200
00:15:13,180 --> 00:15:15,850
!هو أنت، صحيح أيّها اللّحية السّوداء؟

201
00:15:16,310 --> 00:15:19,270
!لنغزو العالم

202
00:15:31,580 --> 00:15:33,110
قبضان السّفينة التّاسعة لقراصنة اللّحية السّوداء
دوك كيو

203
00:15:34,160 --> 00:15:36,030
!روحهم عالية جدًّا

204
00:15:39,900 --> 00:15:42,580
!علينا استغلال هذا لصالحنا

205
00:15:48,060 --> 00:15:50,510
.والآن يا كوزا

206
00:15:51,120 --> 00:15:55,190
كنت تقول أنّ كوبي هرب ولكن...؟

207
00:15:54,430 --> 00:15:58,220
قبضان السّفينة العاشرة لقراصنة اللّحية السّوداء
كوزان

208
00:15:55,190 --> 00:15:57,960
.نعم، ولكنّنا أمسكنا بغارب

209
00:15:59,970 --> 00:16:01,850
!هذا مثاليّ

210
00:16:01,850 --> 00:16:04,900
إنّه قيّم أكثر من كوبي، صحيح؟

211
00:16:04,900 --> 00:16:06,400
!اخرس أنت

212
00:16:07,550 --> 00:16:10,240
...ولكن لنكون أدقّ

213
00:16:11,340 --> 00:16:16,220
.ظننّا أنّنا قتلناه، ولكنّه ما زال حيًّا

214
00:16:16,870 --> 00:16:19,550
.هذا إنجاز عظيم جدًّا يا كوزان

215
00:16:19,550 --> 00:16:22,210
من غيرك كان ليستطيع الإطاحة به؟

216
00:16:22,810 --> 00:16:25,790
.لا، تطلّب الأمر تعاونًا منّا جميعًا

217
00:16:25,790 --> 00:16:27,920
.تهبّ الرّياح في صالحنا

218
00:16:28,910 --> 00:16:29,880
!نعم

219
00:16:30,990 --> 00:16:32,720
...وفوق ذلك

220
00:16:33,840 --> 00:16:35,520
!كفّوا عن دفعي

221
00:16:36,770 --> 00:16:40,000
.بحوزتي فتاة العيون الثّلاثة

222
00:16:43,940 --> 00:16:45,440
!لا تلمسني

223
00:16:46,800 --> 00:16:49,400
.اسمع، صِلني بلافيت

224
00:16:59,230 --> 00:17:01,790
مقرّ شركة أوميت للشّحن البحريّ

225
00:17:04,650 --> 00:17:06,160
.نعم أيّها العميد

226
00:17:06,160 --> 00:17:10,840
ما الّذي يؤخّرك؟
علام ينوي الجيش الثّوريّ؟

227
00:17:10,840 --> 00:17:11,840
...حسنًا

228
00:17:12,010 --> 00:17:15,090
قبضان السّفينة الخامسة لقراصنة اللّحية السّوداء
لافيت

229
00:17:13,160 --> 00:17:16,700
.إنّهم يحاولون بالفعل تجويعهم

230
00:17:17,240 --> 00:17:20,430
إنّ مصاعد البوندورا في الميناء
.الأحمر تتحطّم باستمرار

231
00:17:22,670 --> 00:17:27,020
.ويحدث ذلك دائمًا عندما تُحمّل بالطّعام

232
00:17:27,340 --> 00:17:31,320
تمّت محاصرة شُحنات الطّعام
.من مختلف البلدان أيضًا

233
00:17:31,320 --> 00:17:34,550
،حتّى إن استطعت البحريّة تأمين الطّعام

234
00:17:34,550 --> 00:17:38,000
إلاّ أنّ مصاعد البوندورا
.إلى ماريجوا تتحطّم باستمرار

235
00:17:38,620 --> 00:17:43,080
،إن مات أيّ تنّين سماويّ جوعًا

236
00:17:43,600 --> 00:17:46,080
.فستكون حادثة لا سابق لها

237
00:17:46,330 --> 00:17:47,870
!كم هذا ممتع

238
00:17:51,100 --> 00:17:53,470
...كفّ عن الاستمتاع بالأمر

239
00:17:53,820 --> 00:17:55,830
.واستعدّ في الحال

240
00:17:56,910 --> 00:17:58,760
.مفهوم

241
00:18:02,870 --> 00:18:05,190
.بيزارو، لقد وصلنا

242
00:18:05,450 --> 00:18:07,230
!مهلاً، مهلاً، مهلاً

243
00:18:07,800 --> 00:18:10,650
!أنا هنا أخيرًا

244
00:18:10,650 --> 00:18:14,650
!أنا في قاعدة تيتش-ساما

245
00:18:16,150 --> 00:18:18,000
!ماذا؟

246
00:18:18,000 --> 00:18:20,700
!تلك العين تتحرّك

247
00:18:20,700 --> 00:18:22,120
.إنّها ديفون

248
00:18:26,010 --> 00:18:29,040
!يا إلهي

249
00:18:30,580 --> 00:18:31,670
!كلاّ

250
00:18:35,380 --> 00:18:39,470
!لِمَ ترفضين الرّسو في الميناء ببساطة؟

251
00:18:39,470 --> 00:18:42,210
.أنا مصاب

252
00:18:43,290 --> 00:18:45,670
!كلاّ! هذا سيّئ

253
00:18:45,670 --> 00:18:50,350
!ثمّة وحش عملاق يحملنا

254
00:18:50,350 --> 00:18:54,040
!يا أخي الكبير! يا أختي الكبرى
!افعلا شيء حيال هذا

255
00:18:54,040 --> 00:18:56,130
ألا يخرس أبدًا؟

256
00:18:56,830 --> 00:19:00,220
!هل أحضرتما الرّجل الّذي تحدّثتما عنه؟

257
00:19:00,220 --> 00:19:01,280
.نعم

258
00:19:02,400 --> 00:19:05,700
.كان ذلك قرار تيتش، ما باليد حيلة

259
00:19:06,440 --> 00:19:07,650
.صحيح

260
00:19:12,030 --> 00:19:15,960
...رغم مغادرتهم لإيغهيد قبل يومين

261
00:19:20,630 --> 00:19:22,650
وماذا عن هناك؟ –
!ليسوا هنا –

262
00:19:22,650 --> 00:19:24,090
!ولا هنا أيضًا

263
00:19:24,090 --> 00:19:25,510
!ما الّذي يحدث؟

264
00:19:27,370 --> 00:19:31,670
،حتّى سفينة القراصنة العمالقة
...إريك العظيمة

265
00:19:31,670 --> 00:19:34,830
...لم تصل إلى إلباف بعد

266
00:19:34,830 --> 00:19:36,570
.لسبب واحد فقط

267
00:19:36,570 --> 00:19:39,150
!لا أصدّق هذا

268
00:19:39,330 --> 00:19:41,610
...شربنا حتّى فقدنا الوعي وعندما استيقظنا

269
00:19:41,770 --> 00:19:44,620
!كانت السّفينة ساني قد اختفت

270
00:19:45,070 --> 00:19:48,580
!لم نعثر عليها في أيّ مكان

271
00:19:57,860 --> 00:20:00,340
.كانت تبحر إلى جانبنا في آخر مرّة رأيتها

272
00:20:01,150 --> 00:20:03,920
هل انجرفت بعيدًا عنّا؟

273
00:20:05,550 --> 00:20:08,110
اختفى لوفي والبقيّة؟

274
00:20:08,110 --> 00:20:09,520
.ذلك ما يبدو

275
00:20:11,080 --> 00:20:14,150
!لا يمكنني أن أهدأ
!لا يمكننا العودة إلى إلباف هكذا

276
00:20:14,480 --> 00:20:16,760
!سنعثر عليهم مهما كلّف الأمر

277
00:20:16,760 --> 00:20:18,160
...ربّما

278
00:20:19,340 --> 00:20:22,090
.مزّقتهم سمكة ما لأشلاء

279
00:20:22,300 --> 00:20:26,420
الأسماك هنا ضخمة، لذلك قد يكون
!هذا واردًا! وهو أمر ليس مضحكًا

280
00:20:26,420 --> 00:20:28,750
!إلى أين ذهبوا؟

281
00:20:30,230 --> 00:20:31,250
!لوفي

282
00:20:31,310 --> 00:20:32,330
!زورو

283
00:20:32,330 --> 00:20:34,170
!أوسوبّ

284
00:20:34,170 --> 00:20:35,790
!سانجي-سان

285
00:20:35,790 --> 00:20:37,790
!تشوبّر-سان

286
00:20:37,970 --> 00:20:41,310
!نامي

287
00:20:47,140 --> 00:20:50,700
...اركض حتّى نصل إلى

288
00:20:50,700 --> 00:20:54,970
حتّى نصل إليك

289
00:20:59,860 --> 00:21:03,240
البحر الأزرق الصّافي المفتوح

290
00:21:03,570 --> 00:21:06,570
جزء من معجزة

291
00:21:07,080 --> 00:21:13,100
تقابلنا أكثر ممّا يمكننا تصّوره

292
00:21:13,100 --> 00:21:15,810
مع كلّ خطوة نخطوها في هذه الرّحلة

293
00:21:15,810 --> 00:21:19,820
ما زال الهدف بعيد المنال

294
00:21:19,820 --> 00:21:23,320
لكن بإمكاننا تجاوز أيّ عقبة

295
00:21:23,320 --> 00:21:26,490
لأنّنا نريد رؤية ابتسامتك

296
00:21:26,490 --> 00:21:30,790
إن تردّدنا، فلن نتألّق

297
00:21:30,790 --> 00:21:34,520
بل سعينا جاهدين للتّغلّب على نقاط ضعفنا

298
00:21:34,520 --> 00:21:40,000
نحن الّذين كنّا مخلصين

299
00:21:40,000 --> 00:21:44,050
لطالما كنّا كذلك

300
00:21:44,050 --> 00:21:52,720
...اركض حتّى نصل إلى
حتّى نصل إليك

301
00:21:52,720 --> 00:21:59,400
لن نبلغ مستوى الأسطورة؟
!لا مشكلة! كلّ شيء على ما يرام

302
00:21:59,400 --> 00:22:05,800
اتبع الخريطة المتألّقة إلى أن يأتي
اليوم الّذي نستطيع فيه الضّحك

303
00:22:05,800 --> 00:22:12,180
لذلك لا مزيد من التّردّد أيّها المقاتل
سيكون كلّ شيء بخير

304
00:22:16,790 --> 00:22:18,530
!نامي! نامي

305
00:22:18,530 --> 00:22:20,020
!هيّا، استيقظي

306
00:22:37,940 --> 00:22:39,480
...هذا مؤلم

307
00:22:40,110 --> 00:22:43,710
شربت... الكثير؟

308
00:22:51,510 --> 00:22:52,600
ماذا؟

309
00:22:54,390 --> 00:23:00,440
يُتبع

310
00:23:03,940 --> 00:23:07,290
.تستيقظ نامي في مكان غريب وتجول في الأرجاء

311
00:23:07,860 --> 00:23:12,570
،أشكال الأرض والجدران غريبة جدًّا
.ووحوش عملاقة تهاجم الواحد تلو الآخر

312
00:23:12,570 --> 00:23:14,740
أهذا حلم؟ أم هو واقع؟

313
00:23:15,480 --> 00:23:20,120
المغامرة الّتي دخلها طاقم قبّعة القشّ
.قد صارت محفوفة بالمخاطر والقلق

314
00:23:20,570 --> 00:23:22,210
:في الحلقة القادمة من وان بيس

315
00:23:22,210 --> 00:23:25,240
"!نامي في حيرة! مغامرة في بلاد المكعّبات"

316
00:23:25,240 --> 00:23:27,550
!ملك القراصنة، لن يكون إلاّ أنا