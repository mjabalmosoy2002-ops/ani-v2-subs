1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,430
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:57,940 --> 00:01:59,860
!ساق العفريت

19
00:02:00,690 --> 00:02:03,320
!لا يجدر بالرّجال ضرب النّساء

20
00:02:04,020 --> 00:02:07,070
!هذا منطق سليم منذ حقبة الدّيناصورات

21
00:02:07,300 --> 00:02:09,080
!أيّها الحثالة

22
00:02:09,080 --> 00:02:10,200
!العنق

23
00:02:15,520 --> 00:02:16,710
!شوي الكتف

24
00:02:18,320 --> 00:02:19,530
!الكتف السّفليّ

25
00:02:21,320 --> 00:02:22,990
!الصّدر

26
00:02:23,730 --> 00:02:25,550
!لحم التّرقوة! لحم البطن

27
00:02:25,550 --> 00:02:28,110
!لحم الذّيل! لحم الخوخ! لحم الذّقن

28
00:02:30,190 --> 00:02:32,720
!اندفاع اللّحم البقريّ

29
00:02:34,440 --> 00:02:36,850
!حلّق بعيدًا أيّها الوغد

30
00:02:49,440 --> 00:02:52,260
.وهكذا حقّق سانجي النّصر على كوين

31
00:02:52,260 --> 00:02:54,580
في تلك الأثناء، في برج الدّماغ
...الأيمن داخل القبّة

32
00:02:55,270 --> 00:02:56,120
...هكذا إذًا

33
00:02:56,300 --> 00:02:58,170
هل تحاول أن تصير ملكًا؟

34
00:02:58,170 --> 00:02:59,790
...حسنًا

35
00:02:59,790 --> 00:03:01,840
...لقد قطعتُ

36
00:03:02,420 --> 00:03:04,590
...وعدًا

37
00:03:05,420 --> 00:03:07,760
!لقبطاني وأعزّ أصدقائي

38
00:03:11,100 --> 00:03:15,270
!أسلوب السّيوف الثّلاثة للملك الأسمى"
"!زورو ضدّ كينغ

39
00:03:18,100 --> 00:03:20,310
أقلتَ وعدًا؟

40
00:03:20,690 --> 00:03:22,020
...ولكن ما دام

41
00:03:22,020 --> 00:03:24,480
...كايدو-سان وأنا موجودان

42
00:03:28,320 --> 00:03:32,330
.فلن تفي بذلك الوعد أبدًا

43
00:03:33,160 --> 00:03:35,660
أنت وذلك السّيف المدعوّ إنما

44
00:03:35,700 --> 00:03:38,120
!ستذهبان للجحيم على يدي

45
00:04:11,240 --> 00:04:12,950
.محاولة جيّدة

46
00:04:12,950 --> 00:04:16,450
.آسف. بنيتي الجسديّة غير عاديّة

47
00:04:16,450 --> 00:04:18,910
.لن تكون لهجمات سيفك أيّ فائدة ضدّي

48
00:04:24,460 --> 00:04:27,630
!أتريد أن تصير ملكًا وأنت بهذا الضّعف؟

49
00:04:28,920 --> 00:04:30,880
!أنا أقوم بقطعه بالتّأكيد

50
00:04:31,260 --> 00:04:33,680
!لكنّ ذلك لا يؤثّر به على الإطلاق

51
00:04:38,850 --> 00:04:39,810
!لن أدعك تهرب

52
00:04:43,690 --> 00:04:44,770
!فكّر

53
00:04:45,110 --> 00:04:47,780
!إنّه ليس منيعًا

54
00:04:50,450 --> 00:04:52,070
!لا بدّ من سبب

55
00:04:57,790 --> 00:05:00,660
!واجه هزيمتك ومت

56
00:05:08,460 --> 00:05:09,590
!أسلوب السّيوف الثّلاثة

57
00:05:12,010 --> 00:05:14,680
!صيد النّمور الشّديد

58
00:05:34,030 --> 00:05:35,320
!مهلاً

59
00:05:48,590 --> 00:05:50,510
...ذلك ما ظننت

60
00:05:50,510 --> 00:05:54,090
يصير أسرع عندما تكون ألسنة اللّهب
.على ظهره غير مشتعلة

61
00:05:55,090 --> 00:05:57,680
!لكنّ دفاعه يصير أضعف

62
00:06:02,310 --> 00:06:04,560
...قناع كينغ-ساما

63
00:06:04,560 --> 00:06:07,310
!إذًا فالإشاعات صحيحة

64
00:06:07,900 --> 00:06:12,280
...جناحان أسودان وشعر أبيض وبشرة بنّيّة

65
00:06:13,530 --> 00:06:17,410
قد تحصل على مائة مليون بيري
...لمجرّد إعلام الحكومة. إنّه نادر

66
00:06:18,450 --> 00:06:19,990
...كـ-كلاّ، ما كنتُ

67
00:06:19,990 --> 00:06:22,160
!أجنحة اللّهب الإمبراطوريّ

68
00:06:28,290 --> 00:06:31,590
.القلعة تشتعل سلفًا

69
00:06:31,590 --> 00:06:35,630
إن كنتَ زعيمًا، فعليك أن تكون أكثر
.لطفًا مع أتباعك وحافظ على هدوئك

70
00:06:38,590 --> 00:06:41,470
.اخرج إلى هنا إن كنت لا تستطيع التّركيز

71
00:06:42,010 --> 00:06:44,480
مائة مليون لمجرّد إعلام الحكومة؟

72
00:06:45,560 --> 00:06:48,480
من أيّ قبيلة أنت يا هذا؟

73
00:07:00,160 --> 00:07:02,790
!لماذا تسأل وأنت تكاد تلقى حتفك؟

74
00:07:30,400 --> 00:07:33,690
،إنّه بكلّ تأكيد من قبيلة فريدة من نوعها

75
00:07:34,400 --> 00:07:36,900
!لكنّ ذلك ليس من شأني

76
00:07:43,580 --> 00:07:46,370
...لا أملك الكثير من الوقت

77
00:07:48,870 --> 00:07:53,290
.قد يسلبني سيفي حياتي إن استمرّ هذا طويلاً

78
00:07:54,420 --> 00:07:57,010
.أرى الآن الخطر الّذي تشكّله

79
00:07:59,470 --> 00:08:00,930
.وأنا كذلك

80
00:08:01,470 --> 00:08:03,850
.استمرّ حكمكم لوقت طويل

81
00:08:04,060 --> 00:08:06,520
!حان وقت الرّحيل يا هؤلاء

82
00:08:13,810 --> 00:08:15,610
!لا تراهن بعمرك

83
00:08:15,820 --> 00:08:18,990
!قُدّر لكايدو-سان أن يصير ملك القراصنة

84
00:08:20,490 --> 00:08:23,700
.أنا آسف، لكنّ ذلك يحدث

85
00:08:27,620 --> 00:08:29,160
...ملك الجحيم

86
00:08:32,130 --> 00:08:33,840
!أسلوب السّيوف الثّلاثة

87
00:08:39,800 --> 00:08:41,430
...قاطع الغيلان

88
00:08:44,510 --> 00:08:46,100
!المطهّر

89
00:09:25,010 --> 00:09:27,100
هل تحاول أن تصير ملكًا؟

90
00:09:27,100 --> 00:09:28,810
...لقد قطعتُ

91
00:09:29,520 --> 00:09:31,430
...وعدًا

92
00:09:32,730 --> 00:09:35,060
!لقبطاني وأعزّ أصدقائي

93
00:09:35,980 --> 00:09:37,570
...ملك الجحيم

94
00:09:40,400 --> 00:09:42,150
!أسلوب السّيوف الثّلاثة

95
00:09:44,570 --> 00:09:47,580
.أنت من منحني هذه الحياة

96
00:09:47,950 --> 00:09:49,330
.يا كايدو-سان

97
00:09:53,460 --> 00:09:55,170
!معكم بانك هازارد

98
00:09:55,170 --> 00:09:59,630
!خرج أحد فئران التّجار عن السّيطرة
!نُزعت القيود عنه بالقوّة

99
00:09:59,630 --> 00:10:02,260
!أجيبوا! أجيبوا

100
00:10:04,760 --> 00:10:07,010
!توّقف! ابتعد

101
00:10:16,020 --> 00:10:17,310
!أخرجنا

102
00:10:17,610 --> 00:10:20,690
!ما الّذي فعلناه لك؟! هذا غباء

103
00:10:21,230 --> 00:10:24,070
!سأحرقكم جميعًا

104
00:10:43,710 --> 00:10:46,010
!من أنت؟

105
00:10:46,010 --> 00:10:49,430
.أنا؟ أنا قرصان

106
00:10:50,010 --> 00:10:54,270
.أرى لماذا لا تستطيع الحكومة التّخلّي عنك

107
00:10:54,270 --> 00:10:56,480
أنت من قبيلة لوناريا، صحيح؟

108
00:10:56,980 --> 00:11:00,820
.رأيت اختبار الصّلابة قبل قليل

109
00:11:00,820 --> 00:11:03,900
.أنا مندهش لتحمّلك تلك النّيران المستعرة

110
00:11:04,740 --> 00:11:08,360
!أنت مندهش لأنّني عضو من قبيلة أسطوريّة؟

111
00:11:08,910 --> 00:11:12,370
!هل ستفعل بي مثل ما فعلوه هم؟

112
00:11:17,710 --> 00:11:22,550
.سأخرج من هنا وأشكّل طاقم قراصنة جديد

113
00:11:23,750 --> 00:11:26,470
ماذا تريد أن تفعل يا فأر التّجارب؟

114
00:11:35,100 --> 00:11:38,810
!هل ستجعل هذا العالم غير المثير للاهتمام مثيرًا للاهتمام

115
00:11:39,060 --> 00:11:42,190
!اختر! سأدع القرار لك

116
00:11:44,940 --> 00:11:46,610
...هل يمكنك

117
00:11:48,570 --> 00:11:50,320
!تغيير العالم؟

118
00:11:52,030 --> 00:11:54,700
!أنا وحدي من يمكنه ذلك

119
00:12:02,540 --> 00:12:04,920
!عثرنا على فأرَيْ التّجارب الهاربين

120
00:12:04,920 --> 00:12:06,840
!أوقفوهما مهما كلّف الأمر

121
00:12:06,840 --> 00:12:09,340
!سأفجّر رأسيهما

122
00:12:12,850 --> 00:12:14,100
.لا يوجد الكثير من المُطارِدين

123
00:12:14,100 --> 00:12:16,970
.نعم. معك حقّ

124
00:12:16,970 --> 00:12:18,310
!أطلقوا

125
00:12:24,480 --> 00:12:26,480
!لا فائدة من المسدّسات ضدّهما

126
00:12:31,950 --> 00:12:33,910
!لا بأس بك على الإطلاق

127
00:12:36,290 --> 00:12:37,410
.هذا لا شيء

128
00:12:44,590 --> 00:12:47,170
!لم أسألك عن اسمك

129
00:12:47,170 --> 00:12:48,460
ما هو؟

130
00:12:49,220 --> 00:12:50,260
.ألبير

131
00:12:50,260 --> 00:12:53,590
!ألبير! أنت قويّ

132
00:12:54,260 --> 00:12:57,770
!نادي نفسك بكينغ بدءًا من الآن

133
00:12:59,350 --> 00:13:00,430
.كينع

134
00:13:01,100 --> 00:13:03,560
!ابق خلفي يا كينع

135
00:13:03,730 --> 00:13:05,690
!لن أخونك أبدًا

136
00:13:05,860 --> 00:13:08,900
!ستكون ذراعي اليمنى بدءًا من الآن

137
00:13:24,250 --> 00:13:27,380
!يحتاج العالم لملك واحد فحسب

138
00:13:27,800 --> 00:13:30,880
!ألسنة اللّهب مشتعلة! لا فائدة من الهجوم الآن

139
00:13:31,720 --> 00:13:33,760
!خذا هذا يا رورونوا

140
00:13:34,970 --> 00:13:37,260
!أجنحة اللّهب الإمبراطوريّ

141
00:13:50,110 --> 00:13:52,110
!ألسنة اللّهب هذه كالحمم

142
00:14:24,890 --> 00:14:26,100
!ذلك ثانية

143
00:14:30,360 --> 00:14:34,320
!لن أسم حلك بأخذ هذه السّيوف الممتازة

144
00:15:14,860 --> 00:15:17,070
...إنّه يتحرّك بسرعة! ما يعني

145
00:15:17,450 --> 00:15:18,610
!يمكنني قطعه الآن

146
00:15:24,500 --> 00:15:25,870
!رقصة الطّائر

147
00:15:47,060 --> 00:15:49,100
...يبدو أنّ اكتشفت

148
00:15:49,770 --> 00:15:51,560
!كيف تعمل قوّتي

149
00:15:52,150 --> 00:15:53,650
!نعم

150
00:15:53,650 --> 00:15:57,440
!سترى الآن هزيمتك بكلّ تأكيد

151
00:16:15,800 --> 00:16:16,590
...صيد

152
00:16:18,300 --> 00:16:20,260
!النّمور الشّديد

153
00:16:36,730 --> 00:16:38,690
!لماذا تحاول صدّي؟

154
00:16:38,990 --> 00:16:41,070
!ظننتُ أنّ هجماتي لن تؤذيك

155
00:16:41,070 --> 00:16:44,700
!أم أنّك خائف منها؟

156
00:17:40,550 --> 00:17:44,220
!من ناحية بيولوجيّة، أنت عاجز عن هزيمتي

157
00:17:59,780 --> 00:18:04,150
!أكره خلق أعذار كهذه أكثر من أيّ شيء آخر

158
00:18:05,530 --> 00:18:09,200
!سأتذكّرك كسيّاف جريء

159
00:18:10,290 --> 00:18:12,370
!سأنقش ذلك بنفسي في ذاكرتك

160
00:18:14,250 --> 00:18:17,000
!رغم أنّي أجهل إن كان بمقدورك النّجاة

161
00:18:20,880 --> 00:18:23,340
!أجنحة اللّهب الإمبراطوريّ

162
00:19:23,360 --> 00:19:26,240
!ملك الجحيم، تنّين السّيوف الثّلاثة

163
00:19:39,250 --> 00:19:41,290
!الرّحمات المائة وثلاثة

164
00:19:45,260 --> 00:19:49,470
!هذه نهايتك يا رورونوا

165
00:19:53,100 --> 00:19:56,390
!إدانة التّنّين

166
00:19:59,020 --> 00:20:04,020
!أجنحة اللّهب الإمبراطوريّ العملاقة

167
00:20:43,360 --> 00:20:46,690
...كا-كايدو-سان

168
00:20:47,480 --> 00:20:50,740
!أما زلت تظنّ ذلك يا كينغ؟

169
00:20:51,030 --> 00:20:53,370
تظنّ أنّي جويبوي؟

170
00:20:53,620 --> 00:20:58,290
العالم الّذي أسعى لإنشائه هو العالم الّتي تريده؟

171
00:21:00,710 --> 00:21:02,500
.الأسطورة أسطورة

172
00:21:03,080 --> 00:21:05,340
.ما عدت أتمنّى أيّ شيء

173
00:21:06,300 --> 00:21:09,590
.أنت من منحني حياتي

174
00:21:10,130 --> 00:21:13,050
!ويجب أن تظلّ الأقوى

175
00:21:14,220 --> 00:21:15,890
...لن أخسر أيضًا

176
00:21:17,760 --> 00:21:20,350
!سأجعلك ملك القراصنة

177
00:21:30,440 --> 00:21:37,280
لا تحتاج لأقلّ من السّيّاف الأقوى
في العالم في طاقمك، صحيح؟

178
00:21:46,670 --> 00:21:50,590
وحتّى اليوم الّذي أهزمه فيه
...وأصبح السّيّاف الأقوى

179
00:21:51,090 --> 00:21:55,800
!فلن... أُهزم أبدًا

180
00:21:56,180 --> 00:22:00,140
!هل لديك أيّ مشكلة في ذلك يا ملك القراصنة؟

181
00:22:01,810 --> 00:22:02,730
!لا

182
00:22:04,980 --> 00:22:07,360
...سأصير إذًا

183
00:22:11,110 --> 00:22:13,320
!ملك الجحيم

184
00:22:37,720 --> 00:22:41,770
.معركة برج الدّماغ الأيمن خارج قبّة الجمجمة

185
00:22:47,690 --> 00:22:48,980
...المنتصر

186
00:22:50,230 --> 00:22:51,270
.زورو

187
00:23:04,580 --> 00:23:07,620
يحافظ أوسوبّ على عزيمته للنّجاة
.حتّى إن بدا ذلك بشعًا

188
00:23:08,000 --> 00:23:12,750
والسّاموراي الّذين يؤمنون بطاقم بقّعة
.القشّ عازمون على مواصلة العيش

189
00:23:12,750 --> 00:23:16,970
حان الوقت لطلقات أرواحهم

190
00:23:16,970 --> 00:23:19,140
أن تكسر الجدار القديم الّذي يعترض طريق

191
00:23:19,140 --> 00:23:21,600
!لترقّب أرواحهم الّتي لا تتزعزع للمستقبل

192
00:23:22,470 --> 00:23:27,100
:في الحلقة القادمة من وان بيس
"!لوفي يتحرّك! نقطة تحوّل لحقبة جديدة"

193
00:23:27,100 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا