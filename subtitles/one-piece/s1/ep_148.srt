1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:59,460 --> 00:02:02,090
خذي ذلكما الاثنين وغادروا بسرعة

22
00:02:02,090 --> 00:02:05,260
!بينما ما زلتم قيد الحياة أيّها الضّعفاء

23
00:02:09,170 --> 00:02:11,300
.جزيرة السّماء موجودة فعلاً

24
00:02:13,170 --> 00:02:14,270
!زورو

25
00:02:15,210 --> 00:02:16,270
!لوفي

26
00:02:19,140 --> 00:02:23,150
!العصر الجديد الّذي تحدّثوا عنه مجرّد هراء

27
00:02:24,450 --> 00:02:29,090
العصر الّذي يحلم فيه القراصنة
!قد ولّى، أهذا ما قالوه؟

28
00:02:33,790 --> 00:02:36,030
...أحلام النّاس

29
00:02:37,060 --> 00:02:39,130
!لا تنتهي

30
00:02:44,300 --> 00:02:48,270
".عائلة أسطوريّة! نولاند الكذّاب"

31
00:02:50,340 --> 00:02:53,010
...سُحقًا... سُحقًا... سُحقًا

32
00:02:53,410 --> 00:02:56,680
!سُحقًا... لإنسان الغاب ذاك

33
00:02:56,680 --> 00:02:59,920
!لقد دمّر السّفينة أكثر

34
00:03:00,250 --> 00:03:04,190
.بدأت هذه السّفينة تتداعى
ربّما حان الوقت لاستبدالها؟

35
00:03:04,190 --> 00:03:06,960
إيّاك أن تجرؤ على قول أشياء
!غير مراعية كهذه أيضًا

36
00:03:06,960 --> 00:03:08,290
!إيّاك أن تجرؤ

37
00:03:08,290 --> 00:03:12,530
تعرف تمامًا كيف حصلنا على
!هذه السّفينة، صحيح؟

38
00:03:12,530 --> 00:03:14,130
!صحيح؟

39
00:03:14,130 --> 00:03:17,270
.أعلم يا أوسوبّ. لن تفيدنا الشّكوى بأيّ شيء

40
00:03:17,740 --> 00:03:21,170
.غوينغ ميري جزء مهمّ من الطّاقم

41
00:03:19,400 --> 00:03:20,870
!...تعرف تمامًا

42
00:03:20,870 --> 00:03:22,510
...تعرف... تعرف

43
00:03:21,170 --> 00:03:23,740
!لذلك دعنا نعمل بجدّ ونصلح هذه السّفينة

44
00:03:23,570 --> 00:03:27,480
!...تمامًا كيف... تمامًا كيف... تمامًا كيف

45
00:03:24,410 --> 00:03:27,480
...لوفي... إنّك فعلاً

46
00:03:30,180 --> 00:03:34,790
!أيّها الغبيّ! هل تصلحها أم تخرّبها؟

47
00:03:34,790 --> 00:03:36,990
...حسنًا، أحاول فعلاً إصلاحها، لكن

48
00:03:36,990 --> 00:03:38,320
.يا ويحي، تحطّمت ثانية

49
00:03:38,320 --> 00:03:39,920
!لوفي

50
00:03:41,290 --> 00:03:44,900
غادرنا موكتاون واتّجهنا شرقًا عن
.طريق دوراننا حول الجزيرة

51
00:03:45,300 --> 00:03:47,300
.نحن نصل النّقطة على الخريطة

52
00:03:47,570 --> 00:03:49,870
ذلك الرّجل... ما كان اسمه؟

53
00:03:50,130 --> 00:03:52,070
.مونبلان كريكت

54
00:03:52,270 --> 00:03:55,310
إذًا فالرّجل الّذي يتحدّث
عن الأحلام هناك، صحيح؟

55
00:03:55,910 --> 00:03:58,110
!هـ-هذا مذهل

56
00:03:59,010 --> 00:04:02,310
!هذا منزله؟! إنّه قصر

57
00:04:02,310 --> 00:04:07,080
!هل مونبلان كريكت هذا فاحش الثّراء؟

58
00:04:07,080 --> 00:04:09,090
.غبيّان! أمعنا النّظر

59
00:04:09,090 --> 00:04:13,960
.حالم؟ يبدو لي ساعيًا لجلب الانتباه

60
00:04:15,230 --> 00:04:16,160
لماذا؟

61
00:04:19,630 --> 00:04:22,700
!ماذا...؟! إنّه مجّرد لوح

62
00:04:22,700 --> 00:04:24,540
!ماذا؟

63
00:04:24,540 --> 00:04:27,870
.المنزل الحقيقيّ هو نصفه فحسب
.الباقي مجرّد مظاهر خادعة

64
00:04:27,870 --> 00:04:30,040
.يبدو لي رجلاً رخيصًا

65
00:04:30,640 --> 00:04:33,940
أيّ نوع من الأحلام الّتي تحدّث
عنها أدّت به ليُنفى من البلدة؟

66
00:04:33,940 --> 00:04:36,010
،لا أدري ما التّفاصيل

67
00:04:36,450 --> 00:04:40,990
لكنّني سمعتُ أنّه قال أنّ مقدارًا
.هائلاً من الذّهب موجود في جايا

68
00:04:40,990 --> 00:04:42,020
!الذّهب؟

69
00:04:42,020 --> 00:04:44,460
أهو كنز قراصنة مدفون أو ما شابه؟

70
00:04:44,460 --> 00:04:46,790
.أنا لا أدري

71
00:04:47,120 --> 00:04:49,190
!ذهب

72
00:04:49,560 --> 00:04:51,960
!احفر الأرض يا تشوبّر! سنجد الذّهب

73
00:04:51,960 --> 00:04:53,160
سنجده إن حفرت؟

74
00:04:53,500 --> 00:04:55,770
أيعيش وحده في هذا المكان المنعزل؟

75
00:04:55,770 --> 00:04:57,600
.مرحبًا. أستأذن للدّخول

76
00:04:57,600 --> 00:04:58,770
!ألم تستطع الانتظار قليلاً؟

77
00:05:00,400 --> 00:05:03,110
!لا أحد هنا. مرحبًا

78
00:05:03,980 --> 00:05:04,780
...لم يجب أحد

79
00:05:04,780 --> 00:05:07,450
انتظر أيّها الغبيّ! ما الّذي ستفعله
إن كان هذا الرّجل خطيرًا؟

80
00:05:08,010 --> 00:05:10,380
!يا رفاق! لا أحد هنا

81
00:05:12,080 --> 00:05:13,280
...هذا

82
00:05:14,550 --> 00:05:15,720
.كتاب صور

83
00:05:16,490 --> 00:05:18,790
.إنّه كتاب قديم جدًّا

84
00:05:19,560 --> 00:05:21,430
."عنوانه "نولاند الكذّاب

85
00:05:21,890 --> 00:05:25,700
!نعم، إنّه عنوان رائع
!فكرة ممتازة لكتاب

86
00:05:25,700 --> 00:05:27,630
نولاند الكذّاب"؟"

87
00:05:27,630 --> 00:05:29,270
هل تعرفه يا سانجي-كُن؟

88
00:05:29,270 --> 00:05:32,400
.لكن كُتب أنّه نشر في الأزرق الشّماليّ

89
00:05:32,400 --> 00:05:35,640
.نعم. لقد وُلدتُ في الأزرق الشّماليّ

90
00:05:35,640 --> 00:05:37,380
ألم أخبركم بذلك من قبل؟

91
00:05:37,380 --> 00:05:40,680
.هذه معلومة جديدة
.ظننتُك من الشّرقيّ أيضًا

92
00:05:40,680 --> 00:05:41,710
.كبرتُ هناك فحسب

93
00:05:41,710 --> 00:05:43,910
!اهدأ يا تشوبّر! ما الّذي تفعله؟

94
00:05:43,910 --> 00:05:44,850
!ماذا؟

95
00:05:45,850 --> 00:05:48,420
.هذه قصّة مشهورة في الشّماليّ

96
00:05:48,790 --> 00:05:54,860
إنّها قصّة خياليّة، لكن سمعتُ أنّ نولاند
.هذا عاش بالفعل قبل زمن بعيد

97
00:05:56,930 --> 00:05:59,830
...كان يا ما كان قصّة قديمة

98
00:05:59,830 --> 00:06:03,600
.تعود أحداثها لأربعمائة عام من الزّمان

99
00:06:04,870 --> 00:06:09,840
لرجل يُدعى مونبلان نولاند
.عاش في بلاد من الأزرق الشّماليّ

100
00:06:10,940 --> 00:06:16,450
كان نولاند مكتشفًا كثير الحديث
.عن مغامراته المدهشة

101
00:06:16,450 --> 00:06:21,450
ولكن، لم يستطع القرويّون الجزم ما
.إذا كانت قصصه حقيقة أم خيال

102
00:06:22,350 --> 00:06:27,190
وذات يوم، ذهب للقاء الملك
.بعد عودته من ترحاله

103
00:06:28,130 --> 00:06:32,960
رأيت جبلاً من الذّهب على"
".جزيرة في البحر العظيم

104
00:06:33,430 --> 00:06:39,400
أبحر الملك الشّجاع إلى البحر العظيم
،ليرى إن كانت القصّة حقيقيّة

105
00:06:39,400 --> 00:06:42,370
.آخذًا معه ألفَيْ جنديّ

106
00:06:42,370 --> 00:06:46,080
بعد نجاتهم من عواصف عظيمة
،ومقاتلتهم لوحوش كثيرة

107
00:06:46,380 --> 00:06:53,450
لم يصل منهم سوى الملك
.ونولاند ومائة جنديّ للجزيرة

108
00:06:53,950 --> 00:06:58,490
.ولكن، ما وجدوه كان مجرّد غابة

109
00:06:59,360 --> 00:07:03,660
في النّهاية، حُكم على نولاند
.بالموت لقاء جريمة الكذب

110
00:07:04,060 --> 00:07:07,160
:وكانت كلمات نولاند الأخيرة كالتّالي

111
00:07:07,800 --> 00:07:11,440
هذا صحيح! غرق جبل الذّهب
"!عميقًا في البحر

112
00:07:11,870 --> 00:07:14,510
.كان الملك والآخرون مصدومين

113
00:07:14,940 --> 00:07:17,840
لم يصدّق أحد نولاند بعد ذلك

114
00:07:17,840 --> 00:07:22,510
.لأنّه واصل كذبه حتّى لحظة مماته

115
00:07:23,080 --> 00:07:26,350
"عن قصص "نولاند الكذّاب
.من الأزرق الشّماليّ الخياليّة

116
00:07:29,820 --> 00:07:34,490
!مونبلان كريكت خليفة لمونبلان نولاند ذاك؟

117
00:07:34,790 --> 00:07:37,560
.سمعتُ تلك القصّة الخياليّة عندما كنتُ طفلاً

118
00:07:37,560 --> 00:07:40,930
لا يوجد شخص في الأزرق
.الشّماليّ لا يعرفها

119
00:07:41,300 --> 00:07:45,570
،جميعنا من الأزرق الشّماليّ
لذلك قيل لنا في العادة

120
00:07:45,570 --> 00:07:49,540
أنّنا إن كذبنا كثيرًا، فسيُحكم
.علينا بالموت مثل نولاند

121
00:07:51,840 --> 00:07:54,580
!يصبح هذا ممتعًا أكثر فأكثر

122
00:07:54,580 --> 00:07:58,080
ما كنتُ لأتخيّل أبدًا أنّ جايا
.هي الجزيرة المذكورة في القصّة

123
00:07:58,080 --> 00:08:00,950
،وبعد أربعمائة سنة
يبحث خلف نولاند الكذّاب

124
00:08:00,950 --> 00:08:05,260
...عن الذّهب في هذه الجزيرة إذًا

125
00:08:05,690 --> 00:08:10,160
بهدف تبرئة اسم سلفه الّذي نُعت
...بالكاذب وسُخر منه حتى مات

126
00:08:14,270 --> 00:08:17,100
!إنّ هذه العائلة تُضحكني

127
00:08:19,270 --> 00:08:21,740
هل يعتقد فعلاً أنّ بإمكانه تبرئة

128
00:08:21,740 --> 00:08:25,740
اسم سلف له منذ أربعمائة سنة
!بالعثور على بعض الذّهب؟

129
00:08:27,610 --> 00:08:30,380
!يبدو أنّه مخبول

130
00:08:39,120 --> 00:08:43,490
...وللأسف، مات الكذّاب

131
00:08:45,300 --> 00:08:49,270
.قبل حتّى أن يصبح محارب بحر شجاع

132
00:08:49,900 --> 00:08:51,840
!لا تنظري إليّ

133
00:08:51,840 --> 00:08:53,770
ولا تضيفي جملاً مفجعة
!من تلقاء نفسك

134
00:08:55,470 --> 00:08:56,770
!وقع لوفي في البحر

135
00:08:57,140 --> 00:08:58,980
!ما الّذي تفعله؟

136
00:08:59,840 --> 00:09:01,150
!من تكونون؟

137
00:09:01,580 --> 00:09:04,920
يا لجرأتكم وأنتم تسترخون
!في منزل غيركم دون إذن

138
00:09:04,920 --> 00:09:07,120
!هذا الجزء من البحر ضمن منطقتي

139
00:09:07,120 --> 00:09:09,320
!يا أوسوبّ! اذهب لإنقاذ لوفي

140
00:09:09,320 --> 00:09:09,650
!مفهوم

141
00:09:09,920 --> 00:09:12,560
!تسعون خلف الذّهب، صحيح؟ مت

142
00:09:21,170 --> 00:09:22,270
!سانجي

143
00:09:22,270 --> 00:09:23,030
!سانجي-كُن

144
00:09:23,600 --> 00:09:26,240
.لا تقلقا. لم تصبني

145
00:09:28,140 --> 00:09:29,210
!تمهّل

146
00:09:29,370 --> 00:09:31,640
.غبيّ... لا يجب عليك الاستخفاف بخصمك

147
00:09:33,240 --> 00:09:34,680
!ابتعد! سأهتمّ بأمره

148
00:09:43,490 --> 00:09:45,820
!مهلاً، ماذا كنتَ تفعل؟

149
00:09:45,820 --> 00:09:49,130
.رأيت... فقاعات تخرج من الماء

150
00:09:49,490 --> 00:09:52,560
،لذلك كنتُ أنظر للماء
.ثمّ ظهرت حبّة كستناء فجأة

151
00:09:52,560 --> 00:09:56,930
،لكنّ حبّة الكستناء كانت رجلاً
.ثمّ قام بسحبي إلى المياه

152
00:09:57,370 --> 00:09:59,170
!مهلاً، أيّها العجوز

153
00:10:01,440 --> 00:10:05,210
!أحضروا المزيد من المناشف الباردة
!افتحوا النّوافذ

154
00:10:06,540 --> 00:10:07,750
مرض تخفيف الضّغط؟

155
00:10:07,750 --> 00:10:09,710
هل هذا الرّجل مريض؟

156
00:10:09,710 --> 00:10:12,580
.نعم، مرض يصيب الغطّاسين أحيانًا

157
00:10:13,450 --> 00:10:16,890
.لكنّها لا تصبح حالة مُزمنة عادةً

158
00:10:16,890 --> 00:10:20,890
انخفاض الضّغط السّريع عند
،الصّعود لسطح البحر من أعماقه

159
00:10:20,890 --> 00:10:24,560
يُحّرر النيتروجين المتحلّل في الدّم بسرعة

160
00:10:24,560 --> 00:10:25,960
.ويشكّل فقاعات غازيّة حينها

161
00:10:26,630 --> 00:10:29,770
وبما أنّ فقاعات الغاز تتوسّع
،داخل وخارج الأوعية الدّمويّة

162
00:10:29,770 --> 00:10:33,370
تتسبّب بمشاكل في تدفّق الدّم
.والعضلات والمفاصل

163
00:10:33,370 --> 00:10:35,670
أي أنّها ظاهرة غامضة من نوع ما؟

164
00:10:36,270 --> 00:10:40,780
على الأرجح أنّه واصل الغوص كلّ يوم

165
00:10:40,780 --> 00:10:44,420
دون منح الفرصة للفقاعات
.بالاختفاء من جسده

166
00:10:44,680 --> 00:10:46,780
!ولكن لأيّ سبب؟

167
00:10:46,780 --> 00:10:49,890
.لا أدري، لكنّه يخاطر بحياته

168
00:10:50,350 --> 00:10:52,820
في بعض الحالات، يمكن لمرض
...تخفيف الضّغط

169
00:10:53,490 --> 00:10:55,090
.أن يسبّب الموت

170
00:11:07,410 --> 00:11:10,780
.هذا أنت يا ماسيرا. أنت حيّ إذًا

171
00:11:10,780 --> 00:11:12,440
حيّ؟ عمّ تتحدّث؟

172
00:11:12,440 --> 00:11:15,780
،لا تهتمّ. على كلّ حال
ما كان إطلاق النّار ذاك؟

173
00:11:15,780 --> 00:11:18,780
صحيح يا أخي! هل تعتقد
أنّ شيئًا ما حدث للعجوز؟

174
00:11:18,780 --> 00:11:20,890
!لنسرع! أنا بدأت أتحمّس

175
00:11:23,120 --> 00:11:25,720
!أيّها العجوز! هل أنت بخير؟

176
00:11:27,630 --> 00:11:29,790
!سيقتلاننا

177
00:11:29,790 --> 00:11:32,160
!ما الّذي تفعلونه هنا؟

178
00:11:32,160 --> 00:11:33,860
!ما الّذي فعلتموه للعجوز؟

179
00:11:34,230 --> 00:11:38,840
،ماذا؟ نحن نعتني بهذا الرّجل الآن
.لذلك اذهبا لمكان آخر

180
00:11:38,840 --> 00:11:41,870
!غبيّ! لن يستمعا لنا أبدًا

181
00:11:41,870 --> 00:11:43,040
!إنّهما متوحّشان تمامًا

182
00:11:43,040 --> 00:11:43,870
!تمامًا

183
00:11:43,870 --> 00:11:45,880
!لنخلِ المكان جميعًا عبر النّوافذ

184
00:11:47,040 --> 00:11:49,350
!أنتم لطفاء جدًّا

185
00:11:49,510 --> 00:11:51,020
!استمعا لنا فعلاً

186
00:12:06,000 --> 00:12:08,630
تعيشان هنا أيضًا؟

187
00:12:08,900 --> 00:12:13,970
في الواقع، منزل العجوز
.هو مقرّ تحالف ساروياما

188
00:12:13,970 --> 00:12:16,570
لكنّنا ننام في سفننا معظم الوقت

189
00:12:16,910 --> 00:12:20,040
.لأنّ هذا المنزل صغير جدًّا علينا

190
00:12:20,580 --> 00:12:22,580
.هذا لأنّكما ضخمان للغاية

191
00:12:22,580 --> 00:12:26,520
لكن مقارنة بالعمالقة، فأنتما
.تبدوان ككرة صملاخ أذن

192
00:12:27,690 --> 00:12:30,520
لماذا هم على وفاق تامّ هكذا؟

193
00:12:30,520 --> 00:12:32,490
.ربّما لأنّ لديهم الكثير من الأمور المشتركة

194
00:12:32,490 --> 00:12:38,000
لكن من المدهش أنّكم استطعتم
!ركله رغم صغر حجمكم

195
00:12:38,000 --> 00:12:40,060
.فعلاً؟ بإمكانك ذلك أيضًا

196
00:12:40,060 --> 00:12:40,900
فعلاً؟

197
00:12:40,900 --> 00:12:42,770
.نعم، بإمكانك ذلك لأنّك قرد

198
00:12:43,070 --> 00:12:44,740
!لوفي، لقد استعاد وعيه

199
00:12:45,070 --> 00:12:46,140
!استيقظ؟

200
00:12:49,740 --> 00:12:52,010
...إنّه محقّ، بإمكاني ركل ماسيرا

201
00:12:54,150 --> 00:12:56,680
!أيّها العمّ ذو الرّأس الماسيّ
!أريد سؤالك عن شيء ما

202
00:13:01,690 --> 00:13:03,490
.آسف لتسبّبي بالمشاكل لكم

203
00:13:03,490 --> 00:13:07,190
ظننتُ أنّكم مجرّد أغبياء
.يسعون خلف الذّهب

204
00:13:07,190 --> 00:13:09,190
ماذا؟! لديك سبيكة ذهب؟

205
00:13:09,190 --> 00:13:10,190
.لا تسعي خلفها

206
00:13:10,460 --> 00:13:12,900
ما الّذي أردت أن تسألني عنه؟

207
00:13:12,900 --> 00:13:16,430
!أيّها العمّ، نريد الذّهاب لجزيرة السّماء
!أخبرنا رجاءً كيف نذهب إليها

208
00:13:17,070 --> 00:13:18,740
جزيرة السّماء؟

209
00:13:22,870 --> 00:13:25,510
تصدّقون بوجود جزيرة السّماء؟

210
00:13:26,080 --> 00:13:28,250
!توقّفي! إنّه شخص مريض

211
00:13:28,580 --> 00:13:31,150
!هل جزيرة السّماء غير موجودة أيّها العمّ؟

212
00:13:34,190 --> 00:13:35,590
.لا أحد يدري

213
00:13:37,020 --> 00:13:39,860
.أعرف شخصًا قال أنّها موجودة

214
00:13:40,590 --> 00:13:44,060
!لكنّ النّاس يصفونه بالكاذب الكبير الأسطوريّ

215
00:13:44,060 --> 00:13:46,560
.أصبحت عائلته محلّ سخرية للأبد

216
00:13:47,900 --> 00:13:49,470
!ليس أنا

217
00:13:50,130 --> 00:13:53,740
ثمّة قصّة قديمة يعرفها معظم
.ساكنة الأزرق الشّماليّ

218
00:13:53,740 --> 00:13:56,440
."إنّها "نولاند الكذّاب

219
00:13:57,480 --> 00:14:00,240
!قلتُ لك أنّه ليس أنا
!اسمه مختلف تمامًا، مفهوم؟

220
00:14:00,910 --> 00:14:05,480
بالتّفكير في الأمر، اسم نولاند الكامل
.هو مونبلان نولاند إن لم أكن مخطئًا

221
00:14:05,480 --> 00:14:07,650
...هل من الممكن أنّك ونولاند

222
00:14:07,650 --> 00:14:11,560
هل أنت سليل له؟! وهل هذه
!هي الجزيرة في تلك القصّة؟

223
00:14:12,760 --> 00:14:16,260
...إنّه جدُّ جدِّ جدّي

224
00:14:16,260 --> 00:14:20,130
.إنّه سلفي من بعيد... كم هذا مزعج

225
00:14:20,130 --> 00:14:24,400
أشكّ أنّه ما زالت في عروقي
...قطرة دم من دمائه

226
00:14:25,140 --> 00:14:27,770
،رغم أنّ عائلة مونبلان طُردت من البلاد

227
00:14:27,770 --> 00:14:29,270
،ولم تجلب لها الأنظار كثيرًا

228
00:14:29,270 --> 00:14:32,180
إلاّ أنّ النّاس واصلوا استنكار
.عائلتنا ليومنا هذا

229
00:14:32,810 --> 00:14:37,110
.لكنّ لا أحد من العائلة يكرهه

230
00:14:37,110 --> 00:14:38,280
لماذا؟

231
00:14:38,480 --> 00:14:42,720
.لأنّ نولاند كان شخصًا صادقًا بشكل استثنائيّ

232
00:14:42,720 --> 00:14:44,720
...لكنّ كتاب الصّور ذاك

233
00:14:45,160 --> 00:14:48,730
كان عُذر نولاند الأخير في ذلك
...الكتاب على هذا النّحو

234
00:14:48,730 --> 00:14:53,330
هذا صحيح! غرق جبل الذّهب"
"!عميقًا في البحر

235
00:14:53,330 --> 00:14:55,730
رسم وجه تعلوه ملامح
...الغباء في الكتاب

236
00:14:56,930 --> 00:15:01,940
لكنّه ذرف دموعًا كثيرة
.ومات ميتة يملؤها النّدم

237
00:15:02,310 --> 00:15:05,580
كان واثقًا أنّ الجزيرة
،الّتي وصل إليها كانت جايا

238
00:15:05,580 --> 00:15:07,480
.حيث وجد أطلال مدينة من الذّهب

239
00:15:07,480 --> 00:15:10,410
شعر أنّه كان من المستحيل
.أنّها كانت مجرّد وهم

240
00:15:12,250 --> 00:15:16,190
أصرّ نولاند أنّ الأطلال غرقت
،بسبب تحرّكات القشرة الأرضيّة

241
00:15:16,190 --> 00:15:20,690
لكنّ الجميع ظنّوا أنّه يختلق أعذارًا
.بسبب وضعه اليائس

242
00:15:21,760 --> 00:15:25,900
،أُعدم نولاند أمام الحشود السّاخرة

243
00:15:25,900 --> 00:15:28,600
."ولم يبقَ سوى لقب "الكذّاب

244
00:15:28,600 --> 00:15:32,900
صحيح! أنت تبحث عن مدينة
الذّهب في قاع البحر

245
00:15:32,900 --> 00:15:35,040
!بهدف تبرئة اسم عائلة مونبلان

246
00:15:35,040 --> 00:15:36,910
!لا تكن سخيفًا

247
00:15:36,910 --> 00:15:38,340
!أوسوبّ

248
00:15:38,340 --> 00:15:39,880
...ظننتُني سأموت

249
00:15:40,240 --> 00:15:43,550
،كم كان سلفي صادقًا

250
00:15:43,550 --> 00:15:46,850
،أو كم كان مكتشفًا رائعًا
!لا علاقة لهما بي

251
00:15:47,220 --> 00:15:51,990
هل يمكنك إدراك كيف سيشعر
طفل يسخر منه الغرباء

252
00:15:51,990 --> 00:15:54,390
!فقط لأنّه سليل لذلك الغبيّ؟

253
00:15:54,390 --> 00:15:56,060
!هكذا كبرت أنا

254
00:15:59,260 --> 00:16:03,670
ولكن... صحيح، خلال السّنوات
،الأربعمائة الماضية

255
00:16:03,670 --> 00:16:08,440
،أبحر العديد بهدف استعادة شرف عائلتنا

256
00:16:08,440 --> 00:16:11,610
.ولقد فُقدوا جميعًا

257
00:16:12,210 --> 00:16:14,910
.شعرتُ بالخجل من هذه العائلة

258
00:16:14,910 --> 00:16:18,050
.هربتُ من المنزل وأصبحتُ قرصانًا

259
00:16:18,050 --> 00:16:20,720
فعلاً؟ أنت قرصان أيضًا؟

260
00:16:20,720 --> 00:16:23,120
.ليس وكأنّني رغبتُ في أن أصبح قرصانًا

261
00:16:23,120 --> 00:16:26,120
.أردت الهرب من لعنة نولاند فحسب

262
00:16:26,590 --> 00:16:30,830
ومع الوقت، أصبح لي
.طاقم قراصنة خاصّ بي

263
00:16:30,830 --> 00:16:33,430
،وبعد وقت طويل، دخلتُ الغراند لاين

264
00:16:33,430 --> 00:16:35,600
.وكرّستُ كلّ وقتي للمغامرات

265
00:16:36,270 --> 00:16:42,040
لكن وصلت سفينتي لهذه الجزيرة
.بالصّدفة قبل عشر سنوات

266
00:16:43,610 --> 00:16:45,840
وبشكل غريب، كنتُ أنا وحدي

267
00:16:45,840 --> 00:16:49,980
رغم كرهي لعائلة مونبلان ونولاند
.أكثر من غيري، من وصل إلى هنا

268
00:16:50,350 --> 00:16:55,320
لم تكن هنالك مدينة من الذّهب
.على الجزيرة، كما ذُكر في الكتاب

269
00:16:55,750 --> 00:16:58,120
،وبينما أنا واقف على رأس الجزيرة
.شعرتُ أنّ هذا كان قدري

270
00:16:58,620 --> 00:17:00,790
.ما عاد هنالك مكان للهرب

271
00:17:01,360 --> 00:17:04,500
!لننهِ هذا الأمر يا نولاند

272
00:17:05,130 --> 00:17:09,870
مستحيل! أيّها القائد، لن تكون
!لدينا أيّ علاقة بمشكلة عائلتك

273
00:17:09,870 --> 00:17:12,970
إن أصررت على البحث عن
!الذّهب، قم بذلك وحدك

274
00:17:13,600 --> 00:17:17,040
.سنفترق هنا. وداعًا أيّها القائد

275
00:17:21,610 --> 00:17:25,720
.لا بأس إن كانت هناك
.ولا بأس أيضًا إن لم تكن

276
00:17:26,050 --> 00:17:29,390
.فلستُ أريد إثبات براءته

277
00:17:30,490 --> 00:17:35,830
.هذا نزال مع الرّجل الّذي دمّر حياتي

278
00:17:36,730 --> 00:17:41,370
.أريد أن أسوّي الأمر معه قبل أن أموت

279
00:17:46,000 --> 00:17:47,570
...رجل ولا كلّ الرّجال

280
00:17:49,010 --> 00:17:53,280
إذًا ماذا عنهما؟
لماذا ذلكما القردان هنا؟

281
00:17:53,280 --> 00:17:56,380
لا بدّ من وجود قصّة مثيرة

282
00:17:56,380 --> 00:18:00,120
حُبكت أحداثها بقبضات رجال
.كرّسوا حياتهم لاكتشاف الأعماق

283
00:18:00,120 --> 00:18:02,490
.إنّهما مجرّد معجبين بكتاب الصّور

284
00:18:02,490 --> 00:18:03,520
!معجبان؟

285
00:18:03,520 --> 00:18:06,120
.إنّها علاقة بسيطة جدًّا

286
00:18:06,120 --> 00:18:08,060
.أعتقد أنّ ذلك كان قبل خمس أو ستّ سنوات

287
00:18:08,060 --> 00:18:10,630
.سمعا إشاعة عنّي وأتيا إليّ

288
00:18:11,060 --> 00:18:15,730
قالا "نعتقد أنّ ذهب نولاند
!"موجود فعلاً

289
00:18:17,230 --> 00:18:18,300
!شوجو

290
00:18:19,140 --> 00:18:21,510
هل أنت جاهز لمواجهتي بعد
!ركلك لي فجأة هكذا؟

291
00:18:21,510 --> 00:18:23,510
!هذا اتّهام زائف شنيع يا ماسيرا

292
00:18:23,510 --> 00:18:25,510
!لا تغضبني

293
00:18:27,040 --> 00:18:29,010
.البحر في هذه المنطقة عميق

294
00:18:29,010 --> 00:18:33,880
،وفي البحر البارد المظلم
.تطاردك وحدة أعمق بكثير

295
00:18:35,020 --> 00:18:40,020
.كنتُ أغوص وأبحث وحدي كلّ يوم

296
00:18:40,690 --> 00:18:43,690
دخلا حياتي دون سابق إنذار

297
00:18:43,690 --> 00:18:47,630
،وأصبحا تابعين لي دون إذني
.ولزما المكان هنا

298
00:18:48,270 --> 00:18:54,040
...إنّ غبيّين بسيطا الفهم مثلهما
.يشعرانني بالرّاحة بصراحة

299
00:18:54,870 --> 00:18:56,110
هل تفهمون؟

300
00:18:56,110 --> 00:19:02,750
أنا أفهمك. إنّ الزّملاء الحقيقيّين
...يمنحون بعضهم القوّة و

301
00:19:02,750 --> 00:19:05,520
حسنًا، كفانا حديثًا عن قصّة
...ذلكما القردين

302
00:19:05,520 --> 00:19:08,750
!لا تسأل عنها من الأساس وأغلق فمك

303
00:19:09,520 --> 00:19:13,260
كما قلت... أريد الذّهاب
!إلى جزيرة السّماء أيّها العمّ

304
00:19:15,690 --> 00:19:17,460
!أنت قليل الصّبر بالفعل

305
00:19:17,460 --> 00:19:19,830
أخبرتك من قبل، ألم تسمعني؟

306
00:19:19,830 --> 00:19:22,900
الدّليل الوحيد عن جزيرة
.السّماء يعود لنولاند الكذّاب

307
00:19:22,900 --> 00:19:26,400
،إن أصبحت لك أيّ علاقة به
.فسيضحك عليك الجميع مثلي

308
00:19:26,400 --> 00:19:29,040
!ماذا؟! هل زار جزيرة السّماء أيضًا؟

309
00:19:29,470 --> 00:19:32,180
...للأسف، لم يُذكر هنا أنّه فعل، ولكن

310
00:19:32,380 --> 00:19:35,580
!سجلّ سفينة؟! أهو لنولاند؟

311
00:19:35,580 --> 00:19:36,650
.صحيح

312
00:19:37,180 --> 00:19:37,650
...مهلاً

313
00:19:37,650 --> 00:19:38,920
.اقرئي من هناك

314
00:19:39,820 --> 00:19:42,990
...مذهل... سجلّ من أربعمائة سنة مضت

315
00:19:43,650 --> 00:19:48,330
اليوم 21 يونيو من العام 1120 من
.التّقويم الفلكيّ البحريّ، الجوّ مشمس

316
00:19:48,330 --> 00:19:50,530
.غادرنا بلدة فيرا المبهجة

317
00:19:50,530 --> 00:19:56,070
وإن تبعنا البوصلة المسجِّلة، فيجب علينا
.التّوجّه شرق الشّمال الشّرقيّ من الميناء

318
00:19:56,470 --> 00:20:00,640
حصلنا على غرض نادي من قارب
.مؤن عثرنا عليه خلال النّهار

319
00:20:00,640 --> 00:20:03,940
.إنّه قارب متزلّج لشخص واحد يُدعى ويفر

320
00:20:05,240 --> 00:20:09,410
قارب غامض يولّد رياحًا ويتحرّك
.حتّى في الأيّام الّتي لا رياح فيها

321
00:20:09,410 --> 00:20:12,350
يبدو أنّه يجب أن تعتاد عليه
.حتّى تركبه، ولم أستطع ذلك

322
00:20:12,350 --> 00:20:16,090
.والآن، أصبح اللّعبة المثاليّة لطاقمي

323
00:20:16,090 --> 00:20:17,990
!مستحيل! ما هذا؟ أريد واحدًا

324
00:20:17,990 --> 00:20:19,290
!لا تهتمّي لذلك، واصلي القراءة

325
00:20:19,920 --> 00:20:23,330
إنّ مصدر قوّته هو منتج يوجد
،في جزيرة السّماء

326
00:20:23,330 --> 00:20:26,760
وسمعتُ أنّ عدّة أشياء فريدة
.أخرى توجد في السّماء

327
00:20:27,100 --> 00:20:32,240
وبالحديث عن جزيرة السّماء، أراني أحد
.أصدقائي المستكشفين سمكة سماء حيّة

328
00:20:32,540 --> 00:20:35,040
.تفاجأت لغرابة شكل السّمكة

329
00:20:35,040 --> 00:20:36,140
سمكة سماء؟

330
00:20:36,410 --> 00:20:39,380
،ما زالت منطقة مجهولة لسفينتنا

331
00:20:39,380 --> 00:20:43,280
لكن بصفتي بحّارًا، كم أودّ الذّهاب
.لبحر السّماء يومًا ما

332
00:20:43,280 --> 00:20:44,780
...مونبلان نولاند

333
00:20:45,620 --> 00:20:47,220
!"قال "البحر في السّماء

334
00:20:47,220 --> 00:20:49,190
!كما قالت روبين تمامًا

335
00:20:49,190 --> 00:20:53,220
ويبدو أنّ جزيرة السّماء كانت
.أمرًا عاديًّا للغاية للنّاس في الماضي

336
00:20:53,220 --> 00:20:54,830
!إذًا فهي موجودة بالفعل

337
00:20:54,830 --> 00:20:56,830
!أجل

338
00:20:58,230 --> 00:21:00,830
!أيّها العجوز! كيف تشعر؟

339
00:21:00,830 --> 00:21:01,830
!بأفضل حال

340
00:21:02,200 --> 00:21:03,630
!سررت بسماع هذا

341
00:21:04,240 --> 00:21:06,040
...أيّها العجوز، هذا الوغد

342
00:21:06,040 --> 00:21:08,810
اخرسا واستمعا لي، أيروق لكما هؤلاء؟

343
00:21:09,210 --> 00:21:11,110
لماذا تسأل؟

344
00:21:11,340 --> 00:21:15,080
يبدو أنّهم يريدون الذّهاب
.إلى جزيرة السّماء بأيّ ثمن

345
00:21:15,310 --> 00:21:19,780
،جزيرة السّماء... إن كانوا يريدون الذّهاب
.فثمّة طريقة واحدة لذلك

346
00:21:20,220 --> 00:21:23,150
،إن حاولوا من تلقاء أنفسهم
.فسيقتلون في الحال أيّها العجوز

347
00:21:23,550 --> 00:21:29,290
بالضّبط... لذلك لماذا لا نقدّم يد العون لهم؟

348
00:21:55,720 --> 00:22:03,790
آه، خلف السّماء الّتي لا نهاية لها

349
00:22:03,790 --> 00:22:14,400
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

350
00:22:22,280 --> 00:22:29,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

351
00:22:29,720 --> 00:22:38,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

352
00:22:38,130 --> 00:22:46,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

353
00:22:46,340 --> 00:22:55,180
دفعوا بي للأمام، أليس كذلك؟

354
00:22:55,180 --> 00:23:03,490
آه، إنّ النّجوم تهوي من السّماء

355
00:23:03,490 --> 00:23:06,620
...وهذه اللّحظة الفريدة

356
00:23:11,600 --> 00:23:14,670
!بإمكاننا أخيرًا الذّهاب السّماء! إلى السّماء

357
00:23:14,670 --> 00:23:16,730
أتساءل أيّ نوع من الأماكن
!تكون جزيرة السّماء

358
00:23:16,730 --> 00:23:18,370
!أنا متحمّس جدًّا

359
00:23:18,370 --> 00:23:21,510
!إنّها مغامرة مناسبة للقائد أوسوبّ

360
00:23:21,510 --> 00:23:23,510
.لكنّها ستكون رحلة نخاطر فيها بحياتنا

361
00:23:23,510 --> 00:23:26,440
...نعم، نخاطر فيها بحياتنا
.ماذا؟ مهلاً يا لوفي، انس الأمر

362
00:23:26,440 --> 00:23:27,840
!...أنت

363
00:23:28,250 --> 00:23:29,450
:في الحلقة القادمة من ون بيس

364
00:23:29,450 --> 00:23:32,650
!أديروا الدّفّة نحو السّحاب"
"!الإمساك بطائر الجنوب

365
00:23:32,650 --> 00:23:34,920
!ملك القراصنة، لن يكون إلاّ أنا