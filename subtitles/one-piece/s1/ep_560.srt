123
00:12:01,790 --> 00:12:07,720
أحتاج منك أن تصير تضحيّة من أجل
!موت شيراهوشي، إلى جانب الجزيرة

124
00:12:11,680 --> 00:12:14,140
!قاتل أنت أيضًا يا أوميبوزو

125
00:12:14,140 --> 00:12:17,140
!رجاءً! افعل شيئًا بشأن الكراكن

126
00:12:17,140 --> 00:12:19,440
!اهزمه أيّها الكراكن

127
00:12:19,440 --> 00:12:20,690
!أنت قويّ

128
00:12:20,690 --> 00:12:26,040
.كلاهما ضخم لكن لا يبدو أنّه يريد القتال

129
00:12:26,040 --> 00:12:27,690
!سيهزمه الكراكن

130
00:12:28,570 --> 00:12:32,640
!أنت أيّها الرّاهب العظيم! لا بدّ أنّك أسأت سمعه

131
00:12:34,870 --> 00:12:40,750
"!ما قاله لك ديكّن هو، "سأترك السّاحة لك

132
00:12:41,190 --> 00:12:42,500
ماذا؟

133
00:12:42,500 --> 00:12:47,380
!ما يعني أنّه لم يكن سيدمّر هذه الجزيرة

134
00:12:47,820 --> 00:12:50,760
."لكن قال "أصبح تضحية

135
00:12:51,250 --> 00:12:55,310
.أراد منك أن تقاتل بشدّة وكأنّك ستضحّي بنفسك

136
00:12:55,310 --> 00:12:57,100
هل تظنّ ذلك؟

137
00:12:57,100 --> 00:12:59,630
نعم. أليس كذلك يا رفاق؟

138
00:12:59,630 --> 00:13:02,700
!ماذا؟ أ-أجل... معه حقّ

139
00:13:02,700 --> 00:13:06,520
.كم أنت محظوظ لأنّ قبطانك يثق بك هكذا

140
00:13:06,520 --> 00:13:07,820
!أنت مذهل

141
00:13:07,820 --> 00:13:10,190
!حان الوقت لكي تكون رجلاً

142
00:13:12,020 --> 00:13:13,910
!هكذا كان الأمر إذًا

143
00:13:15,410 --> 00:13:17,060
.لا، لم يكن كذلك

144
00:13:17,870 --> 00:13:25,080
!والآن، خذ هذا واهزم طاقم قبّعة القشّ معنا

145
00:13:32,380 --> 00:13:34,190
!منشّط الطّاقة

146
00:13:34,190 --> 00:13:37,390
!مستحيل. لن يفلح مع ذلك الجسد العملاق

147
00:13:45,190 --> 00:13:48,270
!بل يعمل بأحسن ما يكون

148
00:13:48,270 --> 00:13:50,070
!ماذا؟

149
00:14:00,580 --> 00:14:02,500
!سورومي

150
00:14:02,500 --> 00:14:06,960
!أيّها القبطان! آسف لأنّني لم أثق بك

151
00:14:06,960 --> 00:14:09,710
!أجل! لقد هزم الكراكن شرّ هزيمة

152
00:14:09,710 --> 00:14:12,050
!ما الّذي حدث؟! هل أنت بخير؟

153
00:14:12,050 --> 00:14:13,630
!لا فائدة! لقد غاب عن الوعي

154
00:14:13,630 --> 00:14:17,090
!هل أنتم أعدائي أيضًا؟

155
00:14:19,640 --> 00:14:22,850
!أصبح كشخص آخر

156
00:14:22,850 --> 00:14:28,020
!دعوا الأمر لي

157
00:14:50,910 --> 00:14:53,510
أين هو عدوّي؟

158
00:14:53,510 --> 00:14:55,920
!ذ-ذلك الرّجل هناك يا واداتسومي

159
00:14:57,070 --> 00:14:58,470
أذلك هو؟

160
00:14:59,640 --> 00:15:01,430
!حسنًا

161
00:15:02,200 --> 00:15:03,720
!احترس يا جينبي-تشان

162
00:15:03,720 --> 00:15:06,180
!كاراتي البرمائيّين

163
00:15:07,020 --> 00:15:09,020
...ركلة القاطرة

164
00:15:10,310 --> 00:15:13,190
!المكوّنة من 7000 قرميد

165
00:15:20,320 --> 00:15:23,490
!هذا مؤلم، مؤلم، مؤلم، مؤلم

166
00:15:26,370 --> 00:15:30,480
!كيف أمكنه إلحاق ذلك الضّرر بمثل ذلك الكائن العملاق؟

167
00:15:51,550 --> 00:15:52,640
!نامي-سان

168
00:15:52,640 --> 00:15:56,940
!لا! أسقط هبوب الرّياح نامي-سان

169
00:15:57,980 --> 00:16:00,570
!انهض أيّها الوغد

170
00:16:00,570 --> 00:16:04,200
!هذا مؤلم! من ضربني هذه المرّة؟

171
00:16:06,240 --> 00:16:08,060
!أيّها الوغد الكبير

172
00:16:08,060 --> 00:16:13,290
ماذا سيحدث إن أصبت ملاّحتنا الجميلة
بخدش أو خدشين؟

173
00:16:13,610 --> 00:16:16,860
!لا يعقل! أفلحت ركلته أيضًا

174
00:16:16,860 --> 00:16:21,080
!كم ساقه قويّة لتؤذي عملاقًا مثله؟

175
00:16:21,080 --> 00:16:22,890
!لا

176
00:16:28,010 --> 00:16:29,940
.تبعثر حالي

177
00:16:32,360 --> 00:16:35,720
!لم يكن خطئي

178
00:16:41,250 --> 00:16:43,910
!سأقاتلك أيّها الرّاهب العظيم

179
00:16:43,910 --> 00:16:48,410
!ادفع الثّمن بحياتك أيّتها الكعكة المبخّرة الكبيرة

180
00:16:49,160 --> 00:16:51,790
!لأيّ مدى يمكنهم أن يصبحوا أقوياء؟

181
00:16:51,790 --> 00:16:53,610
!ألف زهرة

182
00:17:08,680 --> 00:17:11,730
!ساعدنا يا هيوزو-سان

183
00:17:13,850 --> 00:17:17,720
!يا إلهي، أيمكنني الحصول على واسابي أخطبوط؟

184
00:17:17,720 --> 00:17:21,360
!لا، أنت لست في حانة
!كما أنّه لا يجب أن تأكل الأخطبوط

185
00:17:25,450 --> 00:17:27,890
!لا تكن لئيمًا

186
00:17:31,420 --> 00:17:34,330
!لا فائدة! إنّه ثمل تمامًا

187
00:17:34,330 --> 00:17:38,210
!كم هذا مثير للشّفقة

188
00:17:38,740 --> 00:17:40,570
،إن كنت تستطيع إثبات نفسك الآن

189
00:17:40,570 --> 00:17:44,890
.فهذه فرصتك لتصبح ضابطًا بحركة واحدة

190
00:17:57,940 --> 00:18:02,320
.علمتُ أنّ هجومًا مباغتًا كهذا لن يفلح

191
00:18:02,320 --> 00:18:04,320
من أنت؟

192
00:18:05,470 --> 00:18:11,620
!أنا الّذي سيصبح السّيّاف البرمائيّ الأوّل قريبًا، نورو-ساما

193
00:18:17,780 --> 00:18:18,750
ماذا؟

194
00:18:21,510 --> 00:18:22,840
ما الّذي يجري؟

195
00:18:22,840 --> 00:18:24,050
أهي خمار؟

196
00:18:25,000 --> 00:18:26,680
!هيوزو-سان

197
00:18:52,950 --> 00:18:54,880
!لا بأس بك

198
00:18:54,880 --> 00:18:56,790
.وأنت ضعيف

199
00:18:59,810 --> 00:19:02,380
!أيمكنك أن تقول ذلك بعد رؤيتك لهذا؟

200
00:19:03,300 --> 00:19:05,210
!ساطع جدًّا

201
00:19:07,850 --> 00:19:12,140
،إن كنت لا تستطيع أن ترى
!فلن تستطيع حماية نفسك من سيفي

202
00:19:13,600 --> 00:19:14,980
!خذ هذا

203
00:19:32,780 --> 00:19:33,930
ماذا؟

204
00:19:36,710 --> 00:19:40,410
.تستخدم عينيك لترى فحسب. لهذا أنت ضعيف

205
00:19:40,410 --> 00:19:41,670
!تدرّب أكثر وعد

206
00:19:52,490 --> 00:19:54,550
!حالفك الحظّ فحسب

207
00:19:54,550 --> 00:19:58,560
...سأصبح السّيّاف البرمائيّ الأوّل، لن أخسر

208
00:20:06,150 --> 00:20:08,530
من هو الأوّل؟

209
00:20:11,440 --> 00:20:12,670
!توقّف

210
00:20:15,160 --> 00:20:17,870
!هيوزو-سان، نحن في صفّك

211
00:20:20,700 --> 00:20:23,340
.ما باله؟ يبدو غريبًا

212
00:20:23,340 --> 00:20:25,300
!ليس يثمل هكذا عادةً

213
00:20:25,300 --> 00:20:27,300
!إنّه أقوى

214
00:20:28,380 --> 00:20:30,630
!اندفاع السّكّير الطّاعن

215
00:20:39,060 --> 00:20:41,060
!الـ-الدّروع لا تفلح

216
00:20:43,860 --> 00:20:48,780
!كان يتلوّى ألمًا دون أيّ إصابة قبل مدّة

217
00:20:48,780 --> 00:20:53,220
.هل تمزح؟ هذا ما حدث عندما تغيّر هودي-سان تغيّر

218
00:20:53,220 --> 00:20:57,120
!هل أصبح هيوزو-سان وحشًا أيضًا؟

219
00:20:58,020 --> 00:21:02,420
!إنّه شعور عظيم! أشعر بطفرة من الطّاقة

220
00:21:02,420 --> 00:21:05,790
!أريد قطع المزيد من النّاس

221
00:21:05,790 --> 00:21:08,670
!دعني أقطعك

222
00:21:08,670 --> 00:21:13,950
!اهربوا! ليوقفه أحد! يستحيل علينا أن نحمي أنفسنا

223
00:21:16,080 --> 00:21:19,140
!يمكن أن يكون أيّ أحد

224
00:21:21,180 --> 00:21:24,600
!وجدتُ واحدًا

225
00:21:29,360 --> 00:21:32,740
!تـ-تمّ إيقاف هيوزو-سان

226
00:21:41,660 --> 00:21:45,830
.تبدو أقوى من أبو الشّصّ الّذي هزمتُ للتّوّ

227
00:21:46,790 --> 00:21:47,810
!زورو

228
00:21:47,810 --> 00:21:50,380
.آسف. سأواجه هذا الشّخص

229
00:21:51,160 --> 00:21:55,890
.سيكون هذا إحماءً جيّدًا قبل ذهابنا للعالم الجديد

230
00:22:05,170 --> 00:22:07,690
.تصبح أقلّ قوّة في الماء كما توقّعت

231
00:22:08,180 --> 00:22:10,900
أقلّ قوّة"؟"

232
00:22:10,900 --> 00:22:13,030
!أيّها المخلوق الوضيع الغبيّ

233
00:22:13,030 --> 00:22:17,380
!ألا تعلم أين أنت؟! أنت في عمق البحر

234
00:22:17,380 --> 00:22:20,790
!لا فرصة لبشريّ مثلك ليكسب نزالاً هنا

235
00:22:21,310 --> 00:22:22,450
،فضلاً عن ذلك

236
00:22:22,930 --> 00:22:25,750
.سينتهي كلّ شيء قريبًا

237
00:22:26,210 --> 00:22:30,960
وذلك الحال ينطبق على شيراهوشي
!وجزيرة البرمائيّين وحتّى أصدقاءك

238
00:22:30,960 --> 00:22:35,390
!لا يمكن لأحمق مثلك أن يحمي أيّ شيء

239
00:22:36,340 --> 00:22:37,340
.لا

240
00:22:58,520 --> 00:23:00,120
!سأحميهم جميعًا

241
00:23:01,120 --> 00:23:02,990
...هذا ما عملتُ لأجله

242
00:23:02,990 --> 00:23:05,090
!في العامين المنصرمين

243
00:23:07,440 --> 00:23:13,970
.يقاتل طاقم قبّعة القشّ ضبّاط القراصنة البرمائيّين الجدد

244
00:23:14,260 --> 00:23:19,430
يتواصل كشف النّقاب عن الهجمات الجديدة
.والأقوى للطّاقم الّتي تعلّموها في تدريب عامين

245
00:23:19,870 --> 00:23:21,640
،وأعلاهم

246
00:23:21,640 --> 00:23:24,560
،تواصل السّفينة نوح الاقتراب شيئًا فشيئًا

247
00:23:24,560 --> 00:23:26,810
.بينما تهوي لتدمير جزيرة البرمائيّين

248
00:23:26,810 --> 00:23:28,400
:في الحلقة القادمة من وان بيس

249
00:23:28,400 --> 00:23:31,510
المعركة المربكة الهائلة! طاقم قبّعة"
"!القشّ ضدّ القراصنة البرمائيّين الجدد

250
00:23:31,510 --> 00:23:33,800
!ملك القراصنة، لن يكون إلاّ أنا

251
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة