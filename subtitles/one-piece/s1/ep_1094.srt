1
00:00:00,000 --> 00:00:05,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:09,660 --> 00:00:12,500
في نهاية الأحلام، في نهاية البحر

3
00:00:12,500 --> 00:00:15,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:15,000 --> 00:00:18,010
ولكن أوّلاً، علينا صنع

5
00:00:18,010 --> 00:00:22,890
أسطورة لامعة من أنفسنا

6
00:00:23,340 --> 00:00:25,720
شرارات متطايرة من هنا بلا حدود

7
00:00:25,720 --> 00:00:27,350
!وان بيس

8
00:00:27,350 --> 00:00:29,980
سنخبر جميعنا الرّحّالة

9
00:00:29,980 --> 00:00:33,980
هل ما زالت أحلامكم واضحة؟

10
00:00:35,360 --> 00:00:42,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:42,030 --> 00:00:48,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:00:48,500 --> 00:00:51,120
سنخبر جميعنا الرّحّالة

13
00:00:51,120 --> 00:00:54,880
لا توجد قتالات بلا معنى

14
00:00:56,540 --> 00:01:03,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:03,010 --> 00:01:09,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:09,600 --> 00:01:15,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:15,730 --> 00:01:22,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:30,290 --> 00:01:32,710
...فاكهة المطّاط

19
00:01:32,870 --> 00:01:34,080
!توقّف

20
00:01:38,090 --> 00:01:39,920
!أتوسّل إليكم

21
00:01:39,920 --> 00:01:42,970
!لا تؤذوا أبي

22
00:01:42,970 --> 00:01:44,590
!اهربي أيّتها الغبيّة

23
00:01:44,830 --> 00:01:46,300
!إنّه باسيفيستا

24
00:01:56,490 --> 00:02:00,860
"!يتعمّق الغموض أكثر! طابق مختبر إيغهيد"

25
00:02:18,630 --> 00:02:22,420
أخبريني! هل كوما هو والدك بالفعل؟

26
00:02:22,670 --> 00:02:25,440
نعم! لماذا كنتُ لأكذب عليكم؟

27
00:02:25,500 --> 00:02:27,510
!كان ذلك مفاجئًا

28
00:02:27,710 --> 00:02:30,720
ألهذا السّبب أتيت لرؤية فيغابانك؟

29
00:02:48,230 --> 00:02:49,370
!أيّها الوغد

30
00:02:49,440 --> 00:02:52,580
.إنّه بخير. أنا أوفّر لنا الوقت فحسب

31
00:02:52,580 --> 00:02:53,570
.لنغادر

32
00:02:53,570 --> 00:02:54,760
...أبي

33
00:02:59,530 --> 00:03:01,510
بوني! ما الّذي تفعلينه؟

34
00:03:04,710 --> 00:03:05,890
!أنت، اتركني

35
00:03:05,960 --> 00:03:07,520
.غبيّة، لنغادر المكان

36
00:03:11,210 --> 00:03:14,180
!لم يوفّر ذلك أيّ وقت لنا

37
00:03:24,490 --> 00:03:26,030
.الإمساك بالمشتبه بهم

38
00:03:31,520 --> 00:03:32,580
.من هنا

39
00:03:33,870 --> 00:03:35,080
.إنّه طريق مسدود

40
00:03:35,240 --> 00:03:36,290
.لا خيار آخر أمامنا

41
00:03:36,490 --> 00:03:38,870
،أنا آسف يا بوني

42
00:03:39,450 --> 00:03:42,340
.لكنّي سأوقفه باستعمال القوّة

43
00:03:42,340 --> 00:03:43,570
!كلاّ

44
00:03:43,570 --> 00:03:45,050
.آسف يا بوني

45
00:03:45,260 --> 00:03:47,020
.أغلقي عينيك لوهلة

46
00:03:47,020 --> 00:03:47,760
...حسنًا

47
00:03:47,960 --> 00:03:49,590
ما الّذي ستفعلونه؟

48
00:03:49,590 --> 00:03:51,990
.لا ترخيا دفاعكما

49
00:03:51,990 --> 00:03:55,560
.إنّنا على إيغهيد. جزيرة فيغابانك

50
00:03:55,560 --> 00:04:00,270
!ربّما يكون مختلفًا عن الباسيفيستا الّذين نعرفهم

51
00:04:00,590 --> 00:04:01,400
!هيّا بنا

52
00:04:01,400 --> 00:04:03,360
!توقّفوا

53
00:04:07,990 --> 00:04:08,830
ماذا؟

54
00:04:11,530 --> 00:04:12,870
ما الّذي يحدث؟

55
00:04:16,540 --> 00:04:17,620
!نحن في مشكلة

56
00:04:17,620 --> 00:04:19,730
...الإمساك بالـ

57
00:04:28,670 --> 00:04:30,350
ما كان ذلك؟

58
00:04:30,710 --> 00:04:32,810
...يا إلهي

59
00:04:33,640 --> 00:04:35,400
لكن لماذا؟

60
00:04:35,590 --> 00:04:38,920
شعرتُ بضعف مفاجئ
...في كلّ جسدي

61
00:04:38,920 --> 00:04:41,500
...لا أستطيع حتّى التّحرّك

62
00:04:46,770 --> 00:04:50,180
!لوفي! تشوبّر! كلاكما صار عجوزًا

63
00:04:50,180 --> 00:04:53,160
...وأنت صرت طفلاً

64
00:04:53,230 --> 00:04:54,460
ماذا؟

65
00:04:55,980 --> 00:04:57,200
.هكذا إذًا

66
00:04:57,430 --> 00:05:01,050
.ما عاد يتعرّف إلينا الآن

67
00:05:01,230 --> 00:05:04,210
...هذه أخبار جيّدة

68
00:05:04,210 --> 00:05:05,790
!لنستغلّ هذا الوضع

69
00:05:06,380 --> 00:05:07,590
...يا إلهي

70
00:05:10,500 --> 00:05:11,470
ماذا؟

71
00:05:11,630 --> 00:05:13,680
.يؤلمني ظهري بشدّة

72
00:05:13,750 --> 00:05:16,140
أأنت بخير يا لوفي؟

73
00:05:18,760 --> 00:05:20,220
...أنا أتألّم

74
00:05:20,380 --> 00:05:21,270
!لوفي

75
00:05:21,470 --> 00:05:24,430
...اختفى لوفي

76
00:05:40,160 --> 00:05:43,870
.يبدو أنّ الباسيفيستا قد توقّف عن البحث

77
00:05:44,280 --> 00:05:46,230
...بوني

78
00:05:46,290 --> 00:05:50,840
ولكن يا بوني، أما كان بمقدورك
تغييري لسنّ أفضل...؟

79
00:05:54,260 --> 00:05:57,470
.أفهم كيف تشعرين، لكنّه ليس الحقيقيّ

80
00:05:57,670 --> 00:06:02,500
إن لم تدعيني أوسعه ضربًا
...فسنكون في خطر كبير

81
00:06:02,500 --> 00:06:04,470
.تمهّل يا لوفي

82
00:06:05,260 --> 00:06:07,130
.المعذرة يا بوني

83
00:06:07,130 --> 00:06:12,280
كلّ ما هنالك هو أنّ لدينا
...تاريخًا سيّئًا مع الباسيفيستا

84
00:06:14,550 --> 00:06:19,380
هل يمكنك إعادتي لجسدي الطّبيعيّ؟

85
00:06:21,990 --> 00:06:23,640
.هذا لا يناسبنا

86
00:06:23,640 --> 00:06:27,400
،بما أنّهم نسخ عن شخص كان بشرًا في الأصل

87
00:06:27,400 --> 00:06:29,770
.من المنطقيّ أن تكون له عائلة

88
00:06:30,630 --> 00:06:33,010
،لا تسيئي فهمي يا بوني

89
00:06:34,120 --> 00:06:36,580
.لكن هذا هو ما أعرفه عن كوما

90
00:06:36,580 --> 00:06:39,400
،بدأ كملك شرّير لمملكة سوربي

91
00:06:39,400 --> 00:06:42,060
.إلى أن طرده الشّعب وصار قرصانًا

92
00:06:42,350 --> 00:06:44,740
،كان عضوًا من الجيش الثّوريّ أيضًا

93
00:06:44,740 --> 00:06:48,540
حتّى أمسكت به البحريّة
.وحكمت عليه بالسّجن المؤبّد

94
00:06:49,350 --> 00:06:52,090
لكنّ فيغابانك كان منبهرًا بقوّته الهائلة

95
00:06:52,090 --> 00:06:55,050
.وقدراته الكامنة

96
00:06:55,050 --> 00:06:59,070
لذلك مقابل المشاركة في تجارب
،لتعزيز الجسد وتطوير النّسخ

97
00:06:59,070 --> 00:07:03,090
استعاد كوما حرّيّته وعاد للبحر
!كواحد من الشّيتشيبوكاي

98
00:07:04,120 --> 00:07:05,460
هل أنا مخطئ؟

99
00:07:06,970 --> 00:07:10,550
يمكنني فهم جعله شيتشيبوكاي
...وإنشاء نسخ عنه

100
00:07:10,870 --> 00:07:13,900
لكنّ تحويله إلى سايبورغ
!هو بمثابة حكم بالإعدام

101
00:07:13,900 --> 00:07:17,270
من كان ليوافق على صفقة
إن علم بنتائجها من البداية؟

102
00:07:17,630 --> 00:07:19,340
.هذا صحيح

103
00:07:19,460 --> 00:07:22,190
.لكنّ السّجن المؤبّد أمر مروّع أيضًا

104
00:07:22,750 --> 00:07:25,810
من يدري كم من الجرائم
ارتكب الطّاغية كوما؟

105
00:07:32,930 --> 00:07:35,130
!لم يكن أبي طاغية أبدًا

106
00:07:35,130 --> 00:07:39,300
!كان يكره حكومة العالم
!ما كان أبدًا ليعمل معهم

107
00:07:39,300 --> 00:07:41,450
!أجروا عليه تجاربهم بالقوّة

108
00:07:41,450 --> 00:07:45,600
كلاّ! هل تحاولين قتلنا؟
!هذا خطير للغاية

109
00:07:45,600 --> 00:07:48,040
أرأيت ما كانت تحمله؟

110
00:07:48,530 --> 00:07:51,960
!إنّه سيف ليزر! لا أصدّق هذا

111
00:07:52,710 --> 00:07:57,090
.هذا مكبّ نفايات
.إنّه مليء ببقايا اختراعات فيغابانك

112
00:07:57,550 --> 00:07:58,810
.سيكون مفيدًا لنا

113
00:07:59,920 --> 00:08:03,930
،بغضّ النّظر عن الظّروف
.إنّه قتلٌ باسم العلم

114
00:08:16,950 --> 00:08:20,850
.أخبرني أبي أنّه من قبيلة خاصّة

115
00:08:21,730 --> 00:08:23,210
وماذا في ذلك؟

116
00:08:23,270 --> 00:08:25,790
لا يمنح ذلك الحقّ لأيّ أحد
!لإجراء تجارب عليه بالقوّة

117
00:08:26,060 --> 00:08:28,500
!لا يمنحهم الحقّ لقتله

118
00:08:28,500 --> 00:08:30,020
!نعم، أوافقك الرّأي

119
00:08:30,020 --> 00:08:31,710
!قبيلة خاصّة؟

120
00:08:33,490 --> 00:08:34,670
...بوني

121
00:08:35,910 --> 00:08:38,320
.أعيديني لسنّي الحقيقيّ أيضًا

122
00:08:47,510 --> 00:08:48,680
!لننطلق

123
00:08:56,110 --> 00:08:58,190
.هذا رائع

124
00:08:59,480 --> 00:09:00,890
!إنّنا نطير

125
00:09:00,890 --> 00:09:03,160
!إنّ الرّوبوت يحلّق في السّماء

126
00:09:04,120 --> 00:09:07,190
أهذه الجزيرة أمامنا هي جزيرة فيغابانك؟

127
00:09:25,640 --> 00:09:29,850
عندما يعرف لوفي وتشوبّر
،أنّنا طرنا باستعمال روبوت ضخم

128
00:09:29,850 --> 00:09:32,440
.فسيحسداننا كثيرًا

129
00:09:32,660 --> 00:09:35,290
كيف لشيء بهذه الضّخامة
أن يحلّق عاليًا هكذا؟

130
00:09:35,290 --> 00:09:36,650
.بسبب مضادّ الجاذبيّة

131
00:09:37,100 --> 00:09:41,010
إنّ فيغافورس-01 يستعمل النّفّاثات
الّتي على ظهره

132
00:09:41,010 --> 00:09:42,860
.ويحلّق باستعمال أجهزة مضادّة للجاذبيّة

133
00:09:42,860 --> 00:09:44,700
مضادّ الجاذبيّة؟

134
00:09:44,700 --> 00:09:49,330
،هذا ممكن فقط بفضل مكيّف هواء الجزيرة
!لكنّ هذا سيصير واقعًا للعالم بأسره قريبًا

135
00:09:52,020 --> 00:09:54,170
!يا لها من مدينة رائعة

136
00:09:54,950 --> 00:09:57,960
.لم أرَ أيّ هندسة مماثلة لهذه من قبل

137
00:09:58,200 --> 00:09:59,420
.سنصعد أكثر

138
00:10:07,340 --> 00:10:11,060
!يوجد وحش ضخم هناك! كم هذا رائع

139
00:10:11,060 --> 00:10:14,770
!هناك روبوت عملاق! كم عددها يا ترى؟

140
00:10:14,770 --> 00:10:16,490
!الأسماك تطير

141
00:10:16,490 --> 00:10:19,230
أتستعمل أجهزة مضادّة للجاذبيّة أيضًا؟

142
00:10:19,230 --> 00:10:20,940
!إنّها مدينة المستقبل بالفعل

143
00:10:21,160 --> 00:10:22,280
.هذا صحيح

144
00:10:22,280 --> 00:10:24,900
.هذه هي الجزيرة حيث نبني المستقبل

145
00:10:27,270 --> 00:10:30,460
!مرحبًا في جزيرة المستقبل إيغهيد

146
00:10:33,330 --> 00:10:36,290
،ستجدون فوق السّحاب اللاّبوفيز
.وهو طابق البحوث

147
00:10:36,470 --> 00:10:39,210
.وفي الأسفل طابق المصنع الفابريوفيز

148
00:10:39,210 --> 00:10:41,920
.يعيش العمّال والباحثون هناك

149
00:10:41,920 --> 00:10:45,380
يبدو أنّ قبطانكم تسبّب
.في فوضى هناك في الأسفل

150
00:10:45,540 --> 00:10:47,310
.حسنًا، على الأقلّ هو بخير

151
00:10:55,810 --> 00:10:57,270
.وصلنا

152
00:11:01,850 --> 00:11:06,370
.ينبض قلبي بسرعة فائقة
ما الّذي ينتظرنا تاليًا؟

153
00:11:07,560 --> 00:11:11,030
!ألن تأتيا معنا أيضًا يا زورو وبروك؟

154
00:11:11,030 --> 00:11:12,440
.سأبقى لحراسة السّفينة

155
00:11:12,440 --> 00:11:13,520
.وأنا كذلك

156
00:11:13,520 --> 00:11:16,120
!أواثقان؟ إنّها جزيرة المستقبل

157
00:11:16,120 --> 00:11:18,750
.أنا لا أثق في تلك المرأة

158
00:11:19,540 --> 00:11:21,650
...يا له من مغفّل

159
00:11:22,110 --> 00:11:26,300
بإمكانك تجاهل رأس الطّحلب ذاك
!يا ليليث-تشان

160
00:11:28,290 --> 00:11:29,430
ماذا الآن؟

161
00:11:29,430 --> 00:11:30,690
.سر وستعرف

162
00:11:30,750 --> 00:11:32,050
أسير...؟

163
00:11:35,450 --> 00:11:37,390
!يشبه هذا جزيرة السّماء –
!ألم أقل لك؟ –

164
00:11:37,390 --> 00:11:38,420
فعلاً؟

165
00:11:38,420 --> 00:11:39,960
!أريد أن أجرّب أيضًا

166
00:11:41,760 --> 00:11:43,190
!هذا رائع

167
00:11:43,190 --> 00:11:44,970
!ذكّرني هذا بالكثير

168
00:11:44,970 --> 00:11:49,180
.فعلاً؟ هذه أوّل تجربة لي
!أنا مندهش تمامًا

169
00:11:49,180 --> 00:11:50,910
أهذا من اختراع فيغابانك أيضًا؟

170
00:11:51,370 --> 00:11:53,370
!استنتاج في محلّه

171
00:11:53,900 --> 00:11:57,310
عن طريق السّيطرة
،على جوّ الجزيرة بالكامل

172
00:11:57,310 --> 00:12:01,270
بإمكاننا تعديل كثافة البايروبلوين
...والرّطوبة في نوى التّكاثف

173
00:12:01,270 --> 00:12:04,780
ونستطيع بالتّالي إعادة تشكيل سحب
.الجزر وسحب البحر الّتي في جزر السّماء

174
00:12:04,780 --> 00:12:06,460
.لم نستنتج أيًّا من هذا

175
00:12:07,440 --> 00:12:09,430
!هذا هو مدخل المختبر

176
00:12:09,430 --> 00:12:11,050
!هذا مذهل

177
00:12:11,370 --> 00:12:12,760
!وهذا رائع

178
00:12:14,710 --> 00:12:17,100
سيكون عليكم ارتداء بذلات
!مختبر قبل الدّخول

179
00:12:17,410 --> 00:12:20,310
.غرف تغيير الملابس على الجانب

180
00:12:20,310 --> 00:12:22,270
عن أيّ نوع من الملابس نتحدّث؟

181
00:12:22,270 --> 00:12:23,750
.لا أطيق الانتظار حتّى أرى ذلك

182
00:12:23,750 --> 00:12:26,780
!يحيا المستقبل! كم أنا توّاق لهذا

183
00:12:26,780 --> 00:12:29,340
كيف ستبدو الملابس؟ –
.سنعرف قريبًا –

184
00:12:29,340 --> 00:12:30,780
!لا أطيق الانتظار

185
00:12:30,780 --> 00:12:32,620
!مكانك يا هذا

186
00:12:33,700 --> 00:12:35,280
!أيّها الغبيّ

187
00:12:35,410 --> 00:12:39,370
من يدري ما الّذي ينتظرنا؟
!عليّ حماية نامي-سان وروبين-تشان

188
00:12:39,370 --> 00:12:41,670
.حمايتهما من واجبي

189
00:12:42,030 --> 00:12:44,150
هذا كلّ شيء. مفهوم؟

190
00:12:44,150 --> 00:12:46,380
.وحدهم الأغبياء من يتخلّون عن النّساء

191
00:12:46,950 --> 00:12:49,090
!أنت الغبيّ! غادر في الحال

192
00:12:50,660 --> 00:12:55,260
.مرحبًا. اختاروا الزّيّ الّذي تحبّون

193
00:12:55,510 --> 00:12:57,470
كيف نقوم بذلك؟

194
00:12:57,670 --> 00:12:59,770
أنضغط على أزرار ما؟

195
00:13:08,060 --> 00:13:09,740
ما الّذي يجري هنا؟

196
00:13:09,740 --> 00:13:12,410
.اسحبوا الرّافعة على أحذية القبّة بأنفسكم

197
00:13:12,480 --> 00:13:14,200
!ستتناسب مع أرجلكم

198
00:13:14,400 --> 00:13:16,270
هكذا، صحيح؟

199
00:13:16,900 --> 00:13:18,300
...تبدو ثقيلة

200
00:13:19,570 --> 00:13:20,450
!على الإطلاق

201
00:13:22,880 --> 00:13:24,420
.تبدو ظريفة

202
00:13:24,880 --> 00:13:27,520
.إنّها تناسبك تمامًا يا روبين
.تبدو مثاليّة

203
00:13:27,520 --> 00:13:31,050
.يمكن لهذه الملابس أن تخنق صاحبها بامتياز

204
00:13:31,050 --> 00:13:33,130
...لا تخيفيني

205
00:13:35,250 --> 00:13:37,560
!لقد حمّستني أزياء المستقبل هذه كثيرًا

206
00:13:37,560 --> 00:13:41,140
!فيغابانك هذا عبقريّ بالفعل
!حتّى الملابس تتناسب مع مقاسي

207
00:13:41,680 --> 00:13:43,640
!هذا خارق

208
00:13:43,640 --> 00:13:46,300
!هذا مجرّد قميص ألوها عاديّ فحسب

209
00:13:47,610 --> 00:13:51,110
لكنّ نامي-سان وروبين-تشان
!ظريفتان، لذلك فهذا لا يهمّ

210
00:13:51,330 --> 00:13:52,950
!لم أرَ هذه الصّيحة من قبل

211
00:13:52,950 --> 00:13:55,030
!روبين، تبدين رائعة وقويّة

212
00:13:55,030 --> 00:13:55,780
فعلاً؟

213
00:13:55,780 --> 00:13:56,910
وأنا؟

214
00:13:56,910 --> 00:13:58,750
!أنت منحرف مهما نظرنا إليك

215
00:13:58,750 --> 00:14:00,370
!يا لها من مجاملة كبيرة

216
00:14:01,470 --> 00:14:03,570
!أنا منحرف

217
00:14:09,250 --> 00:14:12,130
ألا تريد الذّهاب معهم؟

218
00:14:12,130 --> 00:14:17,090
.هذه جزيرة تابعة للحكومة
من سيساعدهم إن أمسكوا بهم؟

219
00:14:18,360 --> 00:14:21,200
.ذلك ما توقّعته أيضًا

220
00:14:21,200 --> 00:14:22,690
أتريد بعض الشّاي؟

221
00:14:22,690 --> 00:14:23,730
.نعم

222
00:14:23,730 --> 00:14:24,560
.حسنًا

223
00:14:24,560 --> 00:14:25,440
.شكرًا لك

224
00:14:25,440 --> 00:14:27,520
!يا سيّداي

225
00:14:27,520 --> 00:14:29,000
أما زلت هنا؟

226
00:14:29,000 --> 00:14:32,280
.سبق وغادرنا بلاد وانو منذ مدّة. وداعًا

227
00:14:32,280 --> 00:14:34,610
!مهلاً، مهلاً لحظة

228
00:14:34,610 --> 00:14:36,890
...صحيح أنّي أردتكم أن توصلوني

229
00:14:36,890 --> 00:14:40,400
بشرط أن تكون أيّ جزيرة
...خارج بلاد وانو

230
00:14:40,710 --> 00:14:44,330
!ولكن إلاّ هذه يا سيّدي
!إنّها جزيرة حكوميّة

231
00:14:44,330 --> 00:14:47,600
.شكرًا على مساعدتك لقبطاننا

232
00:14:47,600 --> 00:14:48,540
.ارحل

233
00:14:50,100 --> 00:14:52,670
!سأجعلهم يدفعون الثّمن

234
00:14:59,600 --> 00:15:01,060
!يبدو هذا ممتعًا

235
00:15:01,060 --> 00:15:02,460
!حسنًا

236
00:15:04,060 --> 00:15:06,300
!هذا ممتع بالفعل

237
00:15:07,900 --> 00:15:09,650
!الدّرج يتحرّك

238
00:15:09,650 --> 00:15:12,400
!إنّ الدّرج يخرج من الأسفل

239
00:15:22,870 --> 00:15:25,580
ما الآليّة المستخدمة هنا؟
ما الّذي يشغّلها؟

240
00:15:25,580 --> 00:15:28,040
!مصدر طاقة هذه الجزيرة هي النّار

241
00:15:28,040 --> 00:15:31,000
.يمكن تحويل النّار لكلّ أشكال الطّاقة

242
00:15:31,000 --> 00:15:32,920
أهنالك الكثير من الموارد هنا؟

243
00:15:32,920 --> 00:15:36,380
.كنتُ أبحث عمّا يمكنني حرقه

244
00:15:37,590 --> 00:15:42,300
ظننتُ أنّه بإمكاني حتّى صنع شمس
...إن وُجد لهيب لا ينطفئ

245
00:15:42,300 --> 00:15:43,640
!شمس؟

246
00:15:47,200 --> 00:15:49,690
!أنت في طريقنا –
!ابتعد يا فرانكي –

247
00:15:49,690 --> 00:15:51,060
.آسف، آسف

248
00:15:52,770 --> 00:15:53,610
!ماذا؟

249
00:15:53,610 --> 00:15:55,070
!سرتِ عبر جدار

250
00:15:58,290 --> 00:15:59,450
ما الّذي يحدث؟

251
00:15:59,450 --> 00:16:01,480
هذا جدار، صحيح؟

252
00:16:01,880 --> 00:16:02,950
!مرحبًا

253
00:16:03,670 --> 00:16:06,540
!افتحي الباب –
!ليليث-تشان –

254
00:16:06,540 --> 00:16:10,210
!ما الّذي تفعلونه؟ سيروا عبره فحسب
.لا تنخدعوا بما تراه أعينكم

255
00:16:11,680 --> 00:16:13,420
!ليليث! ليليث

256
00:16:13,810 --> 00:16:15,170
ما الخطب يا إديسون؟

257
00:16:17,520 --> 00:16:19,870
!ليليث-تشان

258
00:16:23,680 --> 00:16:26,640
...لا يمكنني سماع أيّ شيء

259
00:16:26,990 --> 00:16:28,850
!عنقه! رأسه

260
00:16:28,850 --> 00:16:33,150
،لا داعي للقلق. إن قُطع عنقه
.فستكون هنالك دماء كثيرة

261
00:16:33,150 --> 00:16:36,110
!شكرًا على تحليلك العقلانيّ
!إنك تخيفينني

262
00:16:36,660 --> 00:16:38,910
!سانجي! هل أنت بخير؟

263
00:16:38,910 --> 00:16:39,700
.نعم

264
00:16:39,700 --> 00:16:41,580
.بالإمكان العبور من خلاله

265
00:16:41,580 --> 00:16:43,490
...لكنّه لا يبدو كذلك

266
00:16:43,490 --> 00:16:45,020
.حسنًا –
ماذا؟ –

267
00:16:45,460 --> 00:16:47,500
.سأذهب أيضًا –
...مـ-مهلاً –

268
00:16:47,500 --> 00:16:48,610
.مع السّلامة

269
00:16:50,300 --> 00:16:51,440
...عبرت من خلاله

270
00:16:51,930 --> 00:16:52,900
لماذا؟

271
00:17:00,350 --> 00:17:02,910
لماذا جعلوا هذا مربكًا جدًّا؟

272
00:17:02,910 --> 00:17:03,830
!ماذا؟

273
00:17:06,010 --> 00:17:10,760
ماذا؟! إنّه مجرّد باب حديديّ
!بعد أن مررنا عبره! كيف يعمل؟

274
00:17:11,570 --> 00:17:13,100
!لقد اختفت ليليث-تشان

275
00:17:13,100 --> 00:17:14,690
!مرحبًا

276
00:17:14,690 --> 00:17:16,470
!واصلوا السّير مباشرة

277
00:17:16,750 --> 00:17:17,690
من قال ذلك؟

278
00:17:17,690 --> 00:17:19,950
!أنا فيغابانك إديسون

279
00:17:19,950 --> 00:17:21,530
فيغابانك آخر؟

280
00:17:21,530 --> 00:17:24,620
.سرّني وصولكم بخير. اتبعوني رجاءً

281
00:17:30,180 --> 00:17:32,120
.واصلوا السّير مباشرة

282
00:17:34,890 --> 00:17:36,450
.استديروا يمينًا

283
00:17:37,840 --> 00:17:38,990
.ثمّ يسارًا

284
00:17:44,640 --> 00:17:46,390
ألم نصل بعد؟

285
00:17:46,390 --> 00:17:48,600
.أتساءل ماذا يوجد أمامنا

286
00:17:49,680 --> 00:17:51,690
!"عليّ البحث عن "كنز مستقبليّ

287
00:17:51,690 --> 00:17:53,440
وما هو "الكنز المستقبليّ"؟

288
00:17:53,440 --> 00:17:56,360
شيء مثل زهور مصنوعة
!من الأحجار الكريمة

289
00:17:56,360 --> 00:17:59,350
لا يمكنني التّمييز إن كان ذلك
...طفوليًّا أو عفى عليه الزّمن

290
00:18:00,120 --> 00:18:01,350
!ركلة المستقبل

291
00:18:10,740 --> 00:18:13,830
ما هذا المكان؟ –
أهي نهاية مسدودة؟ –

292
00:18:13,830 --> 00:18:15,750
...إنّها تبدو مثل أبواب

293
00:18:15,750 --> 00:18:17,460
.سأفتحها لأجلكم

294
00:18:27,110 --> 00:18:28,220
!هناك شخص في الدّاخل

295
00:18:32,070 --> 00:18:34,350
!ماذا؟ –
!مهلاً، لماذا؟ –

296
00:18:34,910 --> 00:18:36,220
!جينبي؟

297
00:18:36,830 --> 00:18:38,650
.لكنّه يبدو يافعًا جدًّا

298
00:18:39,240 --> 00:18:41,050
.وشكله مختلف

299
00:18:45,820 --> 00:18:49,070
!الاحتمال الأوّل. إنّه طفل جينبي

300
00:18:50,300 --> 00:18:53,660
!الاحتمال الثّاني. تمّ تحويل جينبي لطفل

301
00:18:54,130 --> 00:18:55,060
...كلاّ

302
00:18:55,060 --> 00:18:57,620
!الاحتمال الثّالث. شبيه جينبي

303
00:18:58,140 --> 00:18:59,590
.إنّ لديه أجنحة

304
00:18:59,590 --> 00:19:01,450
...ويراودني شعور غريب حياله

305
00:19:02,170 --> 00:19:04,410
!أنت! من تكون؟

306
00:19:07,970 --> 00:19:12,310
!يبدو مثل طفل، لكنّه كبير كِبر جينبي

307
00:19:15,160 --> 00:19:16,210
...مهلاً

308
00:19:18,690 --> 00:19:20,610
!يراودني شعور غريب

309
00:19:22,070 --> 00:19:23,650
!الاحتمال الرّابع

310
00:19:23,650 --> 00:19:25,640
!إنّه باسيفيستا

311
00:19:32,590 --> 00:19:37,160
...بإمكان العباقرة رؤية حتّى مستقبلهم

312
00:19:37,160 --> 00:19:40,240
ما الّذي تتحدّث عنه يا فيغابانك؟

313
00:19:40,640 --> 00:19:42,210
...أنا

314
00:19:44,560 --> 00:19:46,200
...سأموت قريبًا

315
00:19:46,510 --> 00:19:49,760
!كفاك مزاحًا لو سمحت
.هذا ليس مضحكًا

316
00:19:50,650 --> 00:19:53,180
...أردت إبلاغك فحسب

317
00:19:53,690 --> 00:19:54,710
.يا دراغون

318
00:20:01,930 --> 00:20:07,570
إلى أيّ مدى هربنا؟

319
00:20:07,570 --> 00:20:14,700
نعدّ النّدوب دون أن نعرف

320
00:20:14,700 --> 00:20:21,960
وفي بالي دائمًا، خريطة كنز

321
00:20:21,960 --> 00:20:28,470
أبحث باستمرار عن المستقبل

322
00:20:28,470 --> 00:20:42,020
توجد الوعود الحقيقيّة عميقًا في القلب

323
00:20:42,020 --> 00:20:51,490
للجميع أحلام لا يستطيع أحد اللّحاق بها

324
00:20:51,490 --> 00:20:57,080
تمسّكوا بذلك الحلم فقط

325
00:20:57,080 --> 00:21:04,210
إليك يا من تبتسم مثل الشّمس

326
00:21:04,210 --> 00:21:11,220
لنغنّ نفس الأغنية مثل ذلك اليوم

327
00:21:11,220 --> 00:21:18,270
حتّى إن كبر بنا العمر، لا أريد أن أنسى

328
00:21:18,270 --> 00:21:25,700
إلى أن تصلك هذه الأمنية

329
00:21:32,060 --> 00:21:36,740
!أخبريني يا روبين
!أريد تعلّم المزيد أيّها الأحمق" مع تشوبّر"

330
00:21:37,030 --> 00:21:41,000
مرحبًا يا رفاق! أنا طبيب سفينة
!طاقم قبّعة القشّ واسمي تشوبّر

331
00:21:41,000 --> 00:21:42,840
.وأنا عالمة الآثار روبين

332
00:21:42,840 --> 00:21:45,130
لا أطيق الانتظار حتّى أتعلّم
.منك كالعادة يا روبين

333
00:21:45,410 --> 00:21:49,500
.يمكن للمعلومات أن تكون سلاحًا قويًّا
.لنواصل التّعلّم دائمًا

334
00:21:49,870 --> 00:21:53,050
.سنتحدّث اليوم عن بارثولوميو كوما

335
00:21:53,190 --> 00:21:57,210
إنّه قرصان وشيتشيبوكاي سابق
."يُعرف أيضًا بـ"الطّاغية

336
00:21:57,310 --> 00:22:01,850
لقد أكل فاكهة الكفّ الّتي تسمح له
،بصدّ أيّ شيء بوسائد كفّه

337
00:22:01,850 --> 00:22:04,940
.وقد يرسله محلّقًا لمسافات بعيدة

338
00:22:04,940 --> 00:22:08,870
وُلد في التّاسع من فبراير
.ويحبّ العسل والسّلمون

339
00:22:08,870 --> 00:22:14,240
،كان واحدًا من الشّيتشيبوكاي
.لكنّه كان أيضًا من قادة الجيش الثّوريّ

340
00:22:14,320 --> 00:22:16,510
،سبق وقابلنا كوما

341
00:22:16,510 --> 00:22:20,080
.لكنّه أنقذنا من كيزارو وسنتومارو

342
00:22:20,080 --> 00:22:22,370
!لذلك ندين له بالكثير

343
00:22:22,370 --> 00:22:24,880
.أنا من قادة الجيش الثّوريّ

344
00:22:25,170 --> 00:22:28,670
،لديّ صلة معهم
.وأريد مساعدتهم على الخروج من هنا

345
00:22:29,080 --> 00:22:33,840
تمّ تعديل جسد كوما وصار سايبورغ
.شيئًا فشيئًا من طرف البحريّة

346
00:22:33,840 --> 00:22:36,030
،ولكن قبل أن يفقد إرادته الحرّة

347
00:22:36,030 --> 00:22:40,350
.قدّم طلبًا ليُبرمج على حماية ساني

348
00:22:41,640 --> 00:22:43,930
.اكتملت مهمّتي

349
00:22:47,050 --> 00:22:52,030
ثمّ فقد إرادته الحرّة بالكامل
.قبل حرب القمّة

350
00:22:52,460 --> 00:22:56,120
.أتساءل لماذا كان عليه أن يصير سايبورغ

351
00:22:56,650 --> 00:22:59,810
!هذا كلّ شيء لهذا الأسبوع
!نلتقي في المرّة القادمة

352
00:22:59,810 --> 00:23:01,210
!مع السّلامة

353
00:23:05,710 --> 00:23:07,540
!إمكانيّات العلم لا حدود لها

354
00:23:07,910 --> 00:23:10,190
!بدأ البحث سلفًا

355
00:23:10,190 --> 00:23:13,880
إنّ روحهم الفضوليّة لأبعد الحدود
!تطغى على طاقم قبّعة القشّ

356
00:23:14,210 --> 00:23:16,300
.طيبة وشرّ. حكمة وطمع

357
00:23:16,300 --> 00:23:17,970
.فكرة وانفجار

358
00:23:18,030 --> 00:23:22,430
عقول موهوبة تتدفّق من كلّ
!الجهات مجتمعة هنا الآن

359
00:23:22,430 --> 00:23:23,930
:في الحلقة القادمة من وان بيس

360
00:23:23,930 --> 00:23:26,810
"!عقل العبقريّ! فيغابانك السّتّة"

361
00:23:27,060 --> 00:23:29,480
!ملك القراصنة، لكن يكون إلاّ أنا