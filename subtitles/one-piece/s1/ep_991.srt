1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:11,360 --> 00:02:13,480
...فاكهة المطّاط

29
00:02:14,690 --> 00:02:17,860
!مسدّس الفيل

30
00:02:20,910 --> 00:02:26,580
،بعد تسلّل لوفي إلى قلعة كايدو
.اعترض طريقه كلّ من أولتي وبيج وان

31
00:02:27,500 --> 00:02:30,330
!أيّها الوغد

32
00:02:30,420 --> 00:02:34,840
!كيف تجرؤ على فعل ذلك لبي-تان؟

33
00:02:40,220 --> 00:02:42,600
!سأدمّرك

34
00:02:47,100 --> 00:02:51,230
!مدفع رأس أولتي

35
00:03:03,870 --> 00:03:06,290
...ولكنّ من أتى لمساعدة لوفي كان

36
00:03:09,410 --> 00:03:12,170
!باغوا الرّعد

37
00:03:18,010 --> 00:03:21,640
!كنتُ في انتظارك

38
00:03:21,840 --> 00:03:24,350
!لوقت طويل جدًّا

39
00:03:30,890 --> 00:03:33,320
!اسمي ياماتو

40
00:03:33,940 --> 00:03:36,490
!أنا ابن كايدو

41
00:03:39,900 --> 00:03:44,490
"!عدوّ أم صديق؟ لوفي وياماتو"

42
00:04:17,020 --> 00:04:20,280
.هذه هي أونيغاشيما إذًا

43
00:04:22,070 --> 00:04:23,900
...كينغ

44
00:04:31,910 --> 00:04:33,580
...ماركو

45
00:04:34,580 --> 00:04:37,500
!ختم العنقاء

46
00:04:43,220 --> 00:04:44,800
!ثانية؟

47
00:04:48,430 --> 00:04:50,470
...قبّعة القشّ

48
00:04:51,010 --> 00:04:54,040
!من الأفضل أن يجهّزوا أنفسهم... لعق

49
00:04:54,040 --> 00:04:56,600
!كما لا أوافق على تحالف ماما

50
00:04:56,600 --> 00:05:01,910
!قراصنة بيغ مام هم من سيضحكون أخيرًا

51
00:05:09,990 --> 00:05:11,330
!إطلاق

52
00:05:16,330 --> 00:05:19,210
!إطلاق! إطلاق! إطلاق

53
00:06:08,590 --> 00:06:10,760
!عرفتُ أنّ الأمر لن ينجح

54
00:06:10,760 --> 00:06:12,280
!لا تستسلم

55
00:06:12,280 --> 00:06:16,100
،إن لم نثق في دبّابة براكيو هذه
!فمن غيرنا سيفعل؟

56
00:06:16,100 --> 00:06:20,060
!لن أترك هذه الرّافعة وإن قتلني ذلك

57
00:06:21,020 --> 00:06:22,560
...أوسوبّ

58
00:06:26,020 --> 00:06:28,200
!استهداف بيغ مام

59
00:06:28,200 --> 00:06:30,910
!براكيو تانك: المتفجّرات المضادّة للدّبّابات

60
00:06:31,820 --> 00:06:33,120
!إطلاق

61
00:07:01,900 --> 00:07:04,480
...حياة أم

62
00:07:06,560 --> 00:07:08,320
!لا تفعل

63
00:07:24,840 --> 00:07:26,210
!ماما

64
00:07:36,560 --> 00:07:38,200
!ماما

65
00:07:38,200 --> 00:07:41,940
!زوس والمرأة الّتي اختطفته موجودان هنا

66
00:07:59,410 --> 00:08:01,700
هل تراجعت؟

67
00:08:01,700 --> 00:08:04,920
!مرحى! نجحنا

68
00:08:05,540 --> 00:08:10,960
!سيلقّن ذلك بيغ مام درسًا
!هذا ما تقدر عليه دبّابة براكيو

69
00:08:10,960 --> 00:08:13,220
!تعلّمي من ذلك

70
00:08:25,180 --> 00:08:26,860
!ما الّذي يحدث؟

71
00:08:27,850 --> 00:08:32,770
.يبدو أنّ مفتاح التّحوّل قد تفعّل بسبب تلك اللّكمة

72
00:08:32,770 --> 00:08:38,200
علينا دمجها مع وحيد القرن الأسود
!حالاً لتشكيل الجنرال فرانكي

73
00:08:38,200 --> 00:08:42,420
!نعم! لنذهب للتّلّة الموعودة

74
00:08:42,580 --> 00:08:44,620
!لكن ماذا علينا فعله يا أوسوبّ؟

75
00:08:45,250 --> 00:08:49,590
!ذهبت بيغ مام خلف نامي والبقيّة

76
00:08:49,590 --> 00:08:52,460
.أعتقد أنّها ستحاول استعادة زوس

77
00:08:52,460 --> 00:08:54,550
...أنا قلق حيالهم

78
00:08:54,550 --> 00:08:58,390
.سيكونون بخير... سانجي معهم أيضًا

79
00:08:59,380 --> 00:09:01,230
سانجي؟

80
00:09:02,180 --> 00:09:08,190
آمل ألاّ ينسى أمر إنقاذ مومونوسكي
...ويبدأ بمطاردة النّساء في منزل المتعة

81
00:09:08,520 --> 00:09:11,530
.حدوث ذلك وارد

82
00:09:15,940 --> 00:09:18,200
!لا، لنثق بسانجي

83
00:09:18,200 --> 00:09:19,950
!نعم

84
00:09:20,700 --> 00:09:25,660
،تمكّن كينييمون والبقيّة من التّقدّم
!لذلك فنحن نبلي حسنًا

85
00:09:26,120 --> 00:09:29,920
!أريناهم ما تستطيع دبّابة براكيو هذه فعله

86
00:09:29,920 --> 00:09:33,820
!أجل! القائد تشوبّر! القنّاص والسّائق أوسوبّ

87
00:09:33,820 --> 00:09:35,570
!الدّبّابة براكيو 5

88
00:09:35,570 --> 00:09:39,510
!لا شيء يقف في طريقنا

89
00:09:51,940 --> 00:09:54,530
!هيّا

90
00:09:58,320 --> 00:10:01,370
.مظلّة قديمة

91
00:10:02,360 --> 00:10:06,290
.قباقيب قديمة وصنادل قديمة

92
00:10:10,170 --> 00:10:15,300
!جدار تراب! شمعة

93
00:10:19,090 --> 00:10:21,680
!مصباح أيضًا

94
00:10:25,890 --> 00:10:29,480
!سأمنحكِ الحياة

95
00:10:30,900 --> 00:10:33,770
.اتبعيني

96
00:10:34,940 --> 00:10:37,530
!ماما، مِن هنا

97
00:10:37,530 --> 00:10:41,530
!مهلاً! لا تنادها يا شمس

98
00:10:42,950 --> 00:10:44,890
!ماذا أفعل يا نامي؟

99
00:10:44,890 --> 00:10:48,540
!إن أمسكت بي، فستقتلني

100
00:10:49,830 --> 00:10:53,590
هل تلك المرأة فائقة النّضج خطيرة لتلك الدّرجة؟

101
00:10:53,590 --> 00:10:56,550
!إنّها من مستوى مختلف تمامًا

102
00:10:57,090 --> 00:11:00,090
مهلاً، ألم نرَ سانجي قبل قليل؟

103
00:11:00,630 --> 00:11:02,000
!نعم

104
00:11:02,000 --> 00:11:04,050
...ولكن

105
00:11:04,340 --> 00:11:06,720
...آسف على التّأخير

106
00:11:07,140 --> 00:11:10,480
!لن أتخلّى عن فكرة العثور على تلك النّسوة

107
00:11:11,470 --> 00:11:13,810
!لماذا أتى إلى هنا من الأساس؟

108
00:11:14,520 --> 00:11:19,030
على أيّ حال، علينا أن نسبقها
!ونبحث عن مومونوسكي-ساما

109
00:11:21,320 --> 00:11:22,570
!حسنًا

110
00:11:25,870 --> 00:11:29,250
!ماما! مِن هنا

111
00:11:32,330 --> 00:11:37,150
.لا داعي للعجلة. طابق العرض أمامنا

112
00:11:37,150 --> 00:11:39,720
!لا يمكنهم الهرب

113
00:11:46,180 --> 00:11:51,390
.الجميع ثملون ولا توجد حراسة تقريبًا

114
00:11:52,180 --> 00:11:55,060
.المكان أشبه بقاعة من الأهداف السّهلة

115
00:11:56,650 --> 00:11:57,440
...هل ذاك

116
00:12:03,820 --> 00:12:07,700
.تسلّل أولئك السّاموراي بنجاح

117
00:12:10,530 --> 00:12:14,000
أنت ظريفة جدًّا! إلى أيّ وحدة تنتمين؟

118
00:12:14,410 --> 00:12:17,440
.ما اسمك؟ أخبريني

119
00:12:17,440 --> 00:12:18,920
ماذا هنالك؟

120
00:12:24,960 --> 00:12:29,260
.أنا آسفة، لكن لا اسم لي لأخبرك به

121
00:12:29,260 --> 00:12:31,440
.يا لك من امرأة مخيفة

122
00:12:36,890 --> 00:12:40,230
!يا رفاق

123
00:12:40,230 --> 00:12:46,160
يقدّم الشّوغن أوروتشي بداية
!حدث خاصّ مرتجل الآن

124
00:12:49,780 --> 00:12:51,160
...أهذا

125
00:13:06,710 --> 00:13:11,060
...أيّها الحضور! هذا الشّقيّ هنا

126
00:13:15,390 --> 00:13:18,040
!أمعنوا النّظر

127
00:13:18,040 --> 00:13:23,460
إنّه ابن كوزكي أودن الّذي اعتُقد
!أنّه قد مات قبل 20 سنة

128
00:13:23,460 --> 00:13:25,930
،اللّيلة، سأري هذا الشّقيّ الرّحمة

129
00:13:25,930 --> 00:13:30,780
!وسأرسله ليلقى والده

130
00:13:50,260 --> 00:13:55,230
.ذلك اللّعين أوروتشي
كيف بدأ بأمر غبيّ كهذا؟

131
00:14:04,940 --> 00:14:09,290
.لقد أفسد جوّ وليمتي

132
00:14:28,250 --> 00:14:30,890
!سُحقًا! ما الّذي يحدث؟

133
00:15:02,870 --> 00:15:05,750
...ثمّة العديد من حاملي القوى

134
00:15:07,840 --> 00:15:10,100
.نُدعى الموهوبين

135
00:15:13,090 --> 00:15:17,200
لا أصدّق أنّك نجحت في التّسلّل
.عميقًا داخل منطقة العدوّ

136
00:15:17,200 --> 00:15:19,310
.أنت لا تخشى الموت فعلاً

137
00:15:20,180 --> 00:15:21,650
.أنت على حقّ

138
00:15:21,890 --> 00:15:25,980
.أعلم أنّك تريد أن تصير ملك القراصنة أيضًا

139
00:15:27,030 --> 00:15:32,200
.نحن أيضًا أردنا أن نصبح ملك القراصنة سابقًا

140
00:15:32,200 --> 00:15:35,510
،لكن ما دام كايدو-ساما على قيد الحياة

141
00:15:35,510 --> 00:15:37,910
!فلن تحقّق ذلك الهدف أبدًا

142
00:15:37,910 --> 00:15:41,130
.ليس لديّ أيّ اهتمام بذلك

143
00:15:42,160 --> 00:15:46,170
.قبطاننا هو من سيصير ملك القراصنة

144
00:15:46,170 --> 00:15:47,920
فعلاً...؟

145
00:15:47,920 --> 00:15:51,070
.إنّك رجل وسيم بالفعل

146
00:15:51,070 --> 00:15:52,880
لماذا لا تنضمّ لنا؟

147
00:15:53,720 --> 00:15:55,640
ماذا إن رفضت عرضك؟

148
00:15:55,640 --> 00:15:57,010
وهل ذلك ممكن؟

149
00:16:05,190 --> 00:16:07,570
!هذا هو مدى قوّة كايدو-ساما

150
00:16:07,770 --> 00:16:10,110
.ثمّة ما يقارب 500 منّا

151
00:16:11,730 --> 00:16:15,280
.إن أطعتَ كايدو-ساما، فسيسهّل ذلك الأمر عليك

152
00:16:16,740 --> 00:16:18,660
.اقبل بالطّريقة السّهلة

153
00:16:18,660 --> 00:16:20,750
.ما زال بإمكانك أن تبدأ من جديد

154
00:16:22,870 --> 00:16:24,710
!مستحيل

155
00:16:25,500 --> 00:16:26,840
!أعازم على الموت؟

156
00:16:50,730 --> 00:16:52,190
...ما الّذي

157
00:17:02,080 --> 00:17:05,380
.لا، لستُ عازمًا على الموت إطلاقًا

158
00:17:05,380 --> 00:17:08,000
.لكن من الأفضل أن تكونوا كذلك

159
00:17:08,920 --> 00:17:12,930
.إن كان عليّ الموت، فأفضّل السّقوط للأمام لا الخلف

160
00:17:21,680 --> 00:17:25,580
...قلت أنّك ابن كايدو

161
00:17:25,580 --> 00:17:27,230
فما الّذي تريده منّي؟

162
00:17:27,230 --> 00:17:31,360
.لديّ ما أخبرك به. إنّه أمر مهمّ

163
00:17:31,360 --> 00:17:34,110
.لا وقت لديّ الآن

164
00:17:34,110 --> 00:17:37,740
.لا تقلق. لن ألحق بك أيّ أذى

165
00:17:37,740 --> 00:17:40,620
...ألم تسمعني عندما قلت

166
00:17:43,870 --> 00:17:45,410
!أن لا وقت لديّ؟

167
00:17:52,250 --> 00:17:54,340
!قلتُ أنّ لا وقت لديّ

168
00:17:54,920 --> 00:17:57,970
.لديّ ما أخبرك به

169
00:18:02,100 --> 00:18:04,600
!يا أختي! تماسكي

170
00:18:05,430 --> 00:18:07,110
!أختي

171
00:18:13,530 --> 00:18:16,410
!باغوا الرّعد

172
00:18:21,610 --> 00:18:25,660
!أيّها المغفّلون! أحضروا الفريق الطّبّيّ

173
00:18:28,410 --> 00:18:29,250
!اذهب

174
00:18:29,250 --> 00:18:30,170
...حاضر

175
00:18:31,000 --> 00:18:35,960
.لا تفقدوا أثرهما. حاصروهما وأعلمونا بمكانهما

176
00:18:38,930 --> 00:18:40,920
!تبًّا لك يا ياماتو

177
00:18:40,920 --> 00:18:45,310
.بيج وان-سان! تلقّيتَ ضربة خطيرة أيضًا

178
00:18:47,770 --> 00:18:50,150
!مسدّس الفيل

179
00:18:57,780 --> 00:19:01,610
!كلاّ... يحتاج بيج-وان للعلاج أيضًا

180
00:19:01,610 --> 00:19:06,240
...نعم، كانت لكمة قويّة
.ربّما خُلع فكّي من مكانه

181
00:19:06,240 --> 00:19:07,830
!أذلك كلّ شيء؟

182
00:19:07,830 --> 00:19:10,950
الأهمّ الآن، ألم يصل الفريق الطّبّيّ بعد؟

183
00:19:10,950 --> 00:19:13,630
!لقد وصلنا

184
00:19:22,260 --> 00:19:23,890
كيف حالها؟

185
00:19:28,640 --> 00:19:31,060
!أنت تؤلم عينيّ

186
00:19:34,770 --> 00:19:36,210
...بكاء... بكاء

187
00:19:36,210 --> 00:19:38,690
!بي-تان

188
00:19:40,530 --> 00:19:45,150
!آلمني ذلك-أرينسو! يا لي من مسكينة

189
00:19:45,150 --> 00:19:47,490
لماذا لا تلزمين الهدوء إذًا؟

190
00:19:47,490 --> 00:19:49,140
!ماذا قلت؟

191
00:19:49,140 --> 00:19:52,520
!كيف تجرؤ على الحديث معي هكذا؟
!هل أنت مراهق متمرّد؟

192
00:19:52,520 --> 00:19:54,580
!أتريد أن تبكي أختك؟

193
00:20:00,960 --> 00:20:03,450
...على أيّ حال، ذلك المغفّل ياماتو

194
00:20:03,450 --> 00:20:07,680
كيف أمكنه استعمال هجوم باغوا الرّعد
!الخاصّ بكايدو-ساما وكأنّه هجومه؟

195
00:20:07,680 --> 00:20:09,600
.تبدو بأحسن حال

196
00:20:10,680 --> 00:20:13,810
.إنّ هجومه أقرب لباغوا الفشل

197
00:20:16,730 --> 00:20:20,180
...لم يؤلمني البتّة

198
00:20:20,180 --> 00:20:21,610
...يا أختي

199
00:20:21,610 --> 00:20:25,700
بيج وان-ساما! توقّف ياماتو-ساما
!وقبّعة القشّ عن الهرب

200
00:20:25,700 --> 00:20:27,000
!حسنًا

201
00:20:30,580 --> 00:20:32,710
!مهلاً يا بي-تان

202
00:20:34,290 --> 00:20:37,300
!لا تتركني

203
00:20:40,250 --> 00:20:44,880
!إلى أين تأخذني؟! لا وقت لي للحديث مع غريب

204
00:20:44,880 --> 00:20:48,510
.انتظر. أريد الحديث فقط

205
00:20:49,340 --> 00:20:51,440
!ابتعد عن طريقي

206
00:21:05,230 --> 00:21:07,280
!استمع لما لديّ لأقوله

207
00:21:21,800 --> 00:21:23,460
!لديك خمس ثوانٍ

208
00:21:31,680 --> 00:21:34,980
.بإمكان الآخرين سماعنا
.أريد الحديث معك على انفراد

209
00:21:35,850 --> 00:21:37,820
!لا أريد إذًا

210
00:21:47,190 --> 00:21:49,450
...فاكهة المطّاط

211
00:21:49,450 --> 00:21:51,660
!المدفع الرّشّاش

212
00:22:06,960 --> 00:22:08,470
!يا لعنادك

213
00:22:10,260 --> 00:22:13,220
!الصّقر الأحمر

214
00:22:45,540 --> 00:22:47,390
...هذا يذكّرني

215
00:22:48,000 --> 00:22:50,510
!بقتالي مع ذلك الرّجل

216
00:22:51,380 --> 00:22:54,600
!من أنت؟! ما هو اسمك؟

217
00:22:55,430 --> 00:22:57,060
!أخبرني باسمك أوّلاً

218
00:22:57,260 --> 00:22:58,730
...أنا

219
00:22:59,720 --> 00:23:00,980
!إيس

220
00:23:05,020 --> 00:23:08,700
!أنا هنا لأدقّ عنق كايدو

221
00:23:18,200 --> 00:23:22,710
اجتمع الأكازايا التّسعة في أونيغاشيما
!حاملين إرادة أودن الّتي ورثوها عنه

222
00:23:22,710 --> 00:23:25,270
!يُحكم على مومونوسكي بالموت

223
00:23:25,270 --> 00:23:30,050
،في هذا الوضع الحسّاس للوقت
!يتشارك ياماتو عزمه بكلّ شغف

224
00:23:30,050 --> 00:23:35,470
ينزع ابن كايدو قناعه ويظهر للوفي
.المرتبك وجهه الحقيقيّ

225
00:23:36,470 --> 00:23:40,540
:في الحلقة القادمة من وان بيس
"!الرّغبة في أن يكون أودن! حلم ياماتو"

226
00:23:40,540 --> 00:23:44,490
!ملك القراصنة، لن يكون إلاّ أنا