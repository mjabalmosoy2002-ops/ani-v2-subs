1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,360 --> 00:01:59,480
...فاكهة المطّاط

29
00:02:00,690 --> 00:02:03,860
!مسدّس الفيل

30
00:02:06,910 --> 00:02:12,580
،بعد تسلّل لوفي إلى قلعة كايدو
.اعترض طريقه كلّ من أولتي وبيج وان

31
00:02:13,500 --> 00:02:16,330
!أيّها الوغد

32
00:02:16,420 --> 00:02:20,840
!كيف تجرؤ على فعل ذلك لبي-تان؟

33
00:02:26,220 --> 00:02:28,600
!سأدمّرك

34
00:02:33,100 --> 00:02:37,230
!مدفع رأس أولتي

35
00:02:49,870 --> 00:02:52,290
...ولكنّ من أتى لمساعدة لوفي كان

36
00:02:55,410 --> 00:02:58,170
!باغوا الرّعد

37
00:03:04,010 --> 00:03:07,640
!كنتُ في انتظارك

38
00:03:07,840 --> 00:03:10,350
!لوقت طويل جدًّا

39
00:03:16,890 --> 00:03:19,320
!اسمي ياماتو

40
00:03:19,940 --> 00:03:22,490
!أنا ابن كايدو

41
00:03:25,900 --> 00:03:30,490
"!عدوّ أم صديق؟ لوفي وياماتو"

42
00:04:03,020 --> 00:04:06,280
.هذه هي أونيغاشيما إذًا

43
00:04:08,070 --> 00:04:09,900
...كينغ

44
00:04:17,910 --> 00:04:19,580
...ماركو

45
00:04:20,580 --> 00:04:23,500
!ختم العنقاء

46
00:04:29,220 --> 00:04:30,800
!ثانية؟

47
00:04:34,430 --> 00:04:36,470
...قبّعة القشّ

48
00:04:37,010 --> 00:04:40,040
!من الأفضل أن يجهّزوا أنفسهم... لعق

49
00:04:40,040 --> 00:04:42,600
!كما لا أوافق على تحالف ماما

50
00:04:42,600 --> 00:04:47,910
!قراصنة بيغ مام هم من سيضحكون أخيرًا

51
00:04:55,990 --> 00:04:57,330
!إطلاق

52
00:05:02,330 --> 00:05:05,210
!إطلاق! إطلاق! إطلاق

53
00:05:54,590 --> 00:05:56,760
!عرفتُ أنّ الأمر لن ينجح

54
00:05:56,760 --> 00:05:58,280
!لا تستسلم

55
00:05:58,280 --> 00:06:02,100
،إن لم نثق في دبّابة براكيو هذه
!فمن غيرنا سيفعل؟

56
00:06:02,100 --> 00:06:06,060
!لن أترك هذه الرّافعة وإن قتلني ذلك

57
00:06:07,020 --> 00:06:08,560
...أوسوبّ

58
00:06:12,020 --> 00:06:14,200
!استهداف بيغ مام

59
00:06:14,200 --> 00:06:16,910
!براكيو تانك: المتفجّرات المضادّة للدّبّابات

60
00:06:17,820 --> 00:06:19,120
!إطلاق

61
00:06:47,900 --> 00:06:50,480
...حياة أم

62
00:06:52,560 --> 00:06:54,320
!لا تفعل

63
00:07:10,840 --> 00:07:12,210
!ماما

64
00:07:22,560 --> 00:07:24,200
!ماما

65
00:07:24,200 --> 00:07:27,940
!زوس والمرأة الّتي اختطفته موجودان هنا

66
00:07:45,410 --> 00:07:47,700
هل تراجعت؟

67
00:07:47,700 --> 00:07:50,920
!مرحى! نجحنا

68
00:07:51,540 --> 00:07:56,960
!سيلقّن ذلك بيغ مام درسًا
!هذا ما تقدر عليه دبّابة براكيو

69
00:07:56,960 --> 00:07:59,220
!تعلّمي من ذلك

70
00:08:11,180 --> 00:08:12,860
!ما الّذي يحدث؟

71
00:08:13,850 --> 00:08:18,770
.يبدو أنّ مفتاح التّحوّل قد تفعّل بسبب تلك اللّكمة

72
00:08:18,770 --> 00:08:24,200
علينا دمجها مع وحيد القرن الأسود
!حالاً لتشكيل الجنرال فرانكي

73
00:08:24,200 --> 00:08:28,420
!نعم! لنذهب للتّلّة الموعودة

74
00:08:28,580 --> 00:08:30,620
!لكن ماذا علينا فعله يا أوسوبّ؟

75
00:08:31,250 --> 00:08:35,590
!ذهبت بيغ مام خلف نامي والبقيّة

76
00:08:35,590 --> 00:08:38,460
.أعتقد أنّها ستحاول استعادة زوس

77
00:08:38,460 --> 00:08:40,550
...أنا قلق حيالهم

78
00:08:40,550 --> 00:08:44,390
.سيكونون بخير... سانجي معهم أيضًا

79
00:08:45,380 --> 00:08:47,230
سانجي؟

80
00:08:48,180 --> 00:08:54,190
آمل ألاّ ينسى أمر إنقاذ مومونوسكي
...ويبدأ بمطاردة النّساء في منزل المتعة

81
00:08:54,520 --> 00:08:57,530
.حدوث ذلك وارد

82
00:09:01,940 --> 00:09:04,200
!لا، لنثق بسانجي

83
00:09:04,200 --> 00:09:05,950
!نعم

84
00:09:06,700 --> 00:09:11,660
،تمكّن كينييمون والبقيّة من التّقدّم
!لذلك فنحن نبلي حسنًا

85
00:09:12,120 --> 00:09:15,920
!أريناهم ما تستطيع دبّابة براكيو هذه فعله

86
00:09:15,920 --> 00:09:19,820
!أجل! القائد تشوبّر! القنّاص والسّائق أوسوبّ

87
00:09:19,820 --> 00:09:21,570
!الدّبّابة براكيو 5

88
00:09:21,570 --> 00:09:25,510
!لا شيء يقف في طريقنا

89
00:09:37,940 --> 00:09:40,530
!هيّا

90
00:09:44,320 --> 00:09:47,370
.مظلّة قديمة

91
00:09:48,360 --> 00:09:52,290
.قباقيب قديمة وصنادل قديمة

92
00:09:56,170 --> 00:10:01,300
!جدار تراب! شمعة

93
00:10:05,090 --> 00:10:07,680
!مصباح أيضًا

94
00:10:11,890 --> 00:10:15,480
!سأمنحكِ الحياة

95
00:10:16,900 --> 00:10:19,770
.اتبعيني

96
00:10:20,940 --> 00:10:23,530
!ماما، مِن هنا

97
00:10:23,530 --> 00:10:27,530
!مهلاً! لا تنادها يا شمس

98
00:10:28,950 --> 00:10:30,890
!ماذا أفعل يا نامي؟

99
00:10:30,890 --> 00:10:34,540
!إن أمسكت بي، فستقتلني

100
00:10:35,830 --> 00:10:39,590
هل تلك المرأة فائقة النّضج خطيرة لتلك الدّرجة؟

101
00:10:39,590 --> 00:10:42,550
!إنّها من مستوى مختلف تمامًا

102
00:10:43,090 --> 00:10:46,090
مهلاً، ألم نرَ سانجي قبل قليل؟

103
00:10:46,630 --> 00:10:48,000
!نعم

104
00:10:48,000 --> 00:10:50,050
...ولكن

105
00:10:50,340 --> 00:10:52,720
...آسف على التّأخير

106
00:10:53,140 --> 00:10:56,480
!لن أتخلّى عن فكرة العثور على تلك النّسوة

107
00:10:57,470 --> 00:10:59,810
!لماذا أتى إلى هنا من الأساس؟

108
00:11:00,520 --> 00:11:05,030
على أيّ حال، علينا أن نسبقها
!ونبحث عن مومونوسكي-ساما

109
00:11:07,320 --> 00:11:08,570
!حسنًا

110
00:11:11,870 --> 00:11:15,250
!ماما! مِن هنا

111
00:11:18,330 --> 00:11:23,150
.لا داعي للعجلة. طابق العرض أمامنا

112
00:11:23,150 --> 00:11:25,720
!لا يمكنهم الهرب

113
00:11:32,180 --> 00:11:37,390
.الجميع ثملون ولا توجد حراسة تقريبًا

114
00:11:38,180 --> 00:11:41,060
.المكان أشبه بقاعة من الأهداف السّهلة

115
00:11:42,650 --> 00:11:43,440
...هل ذاك

116
00:11:49,820 --> 00:11:53,700
.تسلّل أولئك السّاموراي بنجاح

117
00:11:56,530 --> 00:12:00,000
أنت ظريفة جدًّا! إلى أيّ وحدة تنتمين؟

118
00:12:00,410 --> 00:12:03,440
.ما اسمك؟ أخبريني

119
00:12:03,440 --> 00:12:04,920
ماذا هنالك؟

120
00:12:10,960 --> 00:12:15,260
.أنا آسفة، لكن لا اسم لي لأخبرك به

121
00:12:15,260 --> 00:12:17,440
.يا لك من امرأة مخيفة

122
00:12:22,890 --> 00:12:26,230
!يا رفاق

123
00:12:26,230 --> 00:12:32,160
يقدّم الشّوغن أوروتشي بداية
!حدث خاصّ مرتجل الآن

124
00:12:35,780 --> 00:12:37,160
...أهذا

125
00:12:52,710 --> 00:12:57,060
...أيّها الحضور! هذا الشّقيّ هنا

126
00:13:01,390 --> 00:13:04,040
!أمعنوا النّظر

127
00:13:04,040 --> 00:13:09,460
إنّه ابن كوزكي أودن الّذي اعتُقد
!أنّه قد مات قبل 20 سنة

128
00:13:09,460 --> 00:13:11,930
،اللّيلة، سأري هذا الشّقيّ الرّحمة

129
00:13:11,930 --> 00:13:16,780
!وسأرسله ليلقى والده

130
00:13:36,260 --> 00:13:41,230
.ذلك اللّعين أوروتشي
كيف بدأ بأمر غبيّ كهذا؟

131
00:13:50,940 --> 00:13:55,290
.لقد أفسد جوّ وليمتي

132
00:14:14,250 --> 00:14:16,890
!سُحقًا! ما الّذي يحدث؟

133
00:14:48,870 --> 00:14:51,750
...ثمّة العديد من حاملي القوى

134
00:14:53,840 --> 00:14:56,100
.نُدعى الموهوبين

135
00:14:59,090 --> 00:15:03,200
لا أصدّق أنّك نجحت في التّسلّل
.عميقًا داخل منطقة العدوّ

136
00:15:03,200 --> 00:15:05,310
.أنت لا تخشى الموت فعلاً

137
00:15:06,180 --> 00:15:07,650
.أنت على حقّ

138
00:15:07,890 --> 00:15:11,980
.أعلم أنّك تريد أن تصير ملك القراصنة أيضًا

139
00:15:13,030 --> 00:15:18,200
.نحن أيضًا أردنا أن نصبح ملك القراصنة سابقًا

140
00:15:18,200 --> 00:15:21,510
،لكن ما دام كايدو-ساما على قيد الحياة

141
00:15:21,510 --> 00:15:23,910
!فلن تحقّق ذلك الهدف أبدًا

142
00:15:23,910 --> 00:15:27,130
.ليس لديّ أيّ اهتمام بذلك

143
00:15:28,160 --> 00:15:32,170
.قبطاننا هو من سيصير ملك القراصنة

144
00:15:32,170 --> 00:15:33,920
فعلاً...؟

145
00:15:33,920 --> 00:15:37,070
.إنّك رجل وسيم بالفعل

146
00:15:37,070 --> 00:15:38,880
لماذا لا تنضمّ لنا؟

147
00:15:39,720 --> 00:15:41,640
ماذا إن رفضت عرضك؟

148
00:15:41,640 --> 00:15:43,010
وهل ذلك ممكن؟

149
00:15:51,190 --> 00:15:53,570
!هذا هو مدى قوّة كايدو-ساما

150
00:15:53,770 --> 00:15:56,110
.ثمّة ما يقارب 500 منّا

151
00:15:57,730 --> 00:16:01,280
.إن أطعتَ كايدو-ساما، فسيسهّل ذلك الأمر عليك

152
00:16:02,740 --> 00:16:04,660
.اقبل بالطّريقة السّهلة

153
00:16:04,660 --> 00:16:06,750
.ما زال بإمكانك أن تبدأ من جديد

154
00:16:08,870 --> 00:16:10,710
!مستحيل

155
00:16:11,500 --> 00:16:12,840
!أعازم على الموت؟

156
00:16:36,730 --> 00:16:38,190
...ما الّذي

157
00:16:48,080 --> 00:16:51,380
.لا، لستُ عازمًا على الموت إطلاقًا

158
00:16:51,380 --> 00:16:54,000
.لكن من الأفضل أن تكونوا كذلك

159
00:16:54,920 --> 00:16:58,930
.إن كان عليّ الموت، فأفضّل السّقوط للأمام لا الخلف

160
00:17:07,680 --> 00:17:11,580
...قلت أنّك ابن كايدو

161
00:17:11,580 --> 00:17:13,230
فما الّذي تريده منّي؟

162
00:17:13,230 --> 00:17:17,360
.لديّ ما أخبرك به. إنّه أمر مهمّ

163
00:17:17,360 --> 00:17:20,110
.لا وقت لديّ الآن

164
00:17:20,110 --> 00:17:23,740
.لا تقلق. لن ألحق بك أيّ أذى

165
00:17:23,740 --> 00:17:26,620
...ألم تسمعني عندما قلت

166
00:17:29,870 --> 00:17:31,410
!أن لا وقت لديّ؟

167
00:17:38,250 --> 00:17:40,340
!قلتُ أنّ لا وقت لديّ

168
00:17:40,920 --> 00:17:43,970
.لديّ ما أخبرك به

169
00:17:48,100 --> 00:17:50,600
!يا أختي! تماسكي

170
00:17:51,430 --> 00:17:53,110
!أختي

171
00:17:59,530 --> 00:18:02,410
!باغوا الرّعد

172
00:18:07,610 --> 00:18:11,660
!أيّها المغفّلون! أحضروا الفريق الطّبّيّ

173
00:18:14,410 --> 00:18:15,250
!اذهب

174
00:18:15,250 --> 00:18:16,170
...حاضر

175
00:18:17,000 --> 00:18:21,960
.لا تفقدوا أثرهما. حاصروهما وأعلمونا بمكانهما

176
00:18:24,930 --> 00:18:26,920
!تبًّا لك يا ياماتو

177
00:18:26,920 --> 00:18:31,310
.بيج وان-سان! تلقّيتَ ضربة خطيرة أيضًا

178
00:18:33,770 --> 00:18:36,150
!مسدّس الفيل

179
00:18:43,780 --> 00:18:47,610
!كلاّ... يحتاج بيج-وان للعلاج أيضًا

180
00:18:47,610 --> 00:18:52,240
...نعم، كانت لكمة قويّة
.ربّما خُلع فكّي من مكانه

181
00:18:52,240 --> 00:18:53,830
!أذلك كلّ شيء؟

182
00:18:53,830 --> 00:18:56,950
الأهمّ الآن، ألم يصل الفريق الطّبّيّ بعد؟

183
00:18:56,950 --> 00:18:59,630
!لقد وصلنا

184
00:19:08,260 --> 00:19:09,890
كيف حالها؟

185
00:19:14,640 --> 00:19:17,060
!أنت تؤلم عينيّ

186
00:19:20,770 --> 00:19:22,210
...بكاء... بكاء

187
00:19:22,210 --> 00:19:24,690
!بي-تان

188
00:19:26,530 --> 00:19:31,150
!آلمني ذلك-أرينسو! يا لي من مسكينة

189
00:19:31,150 --> 00:19:33,490
لماذا لا تلزمين الهدوء إذًا؟

190
00:19:33,490 --> 00:19:35,140
!ماذا قلت؟

191
00:19:35,140 --> 00:19:38,520
!كيف تجرؤ على الحديث معي هكذا؟
!هل أنت مراهق متمرّد؟

192
00:19:38,520 --> 00:19:40,580
!أتريد أن تبكي أختك؟

193
00:19:46,960 --> 00:19:49,450
...على أيّ حال، ذلك المغفّل ياماتو

194
00:19:49,450 --> 00:19:53,680
كيف أمكنه استعمال هجوم باغوا الرّعد
!الخاصّ بكايدو-ساما وكأنّه هجومه؟

195
00:19:53,680 --> 00:19:55,600
.تبدو بأحسن حال

196
00:19:56,680 --> 00:19:59,810
.إنّ هجومه أقرب لباغوا الفشل

197
00:20:02,730 --> 00:20:06,180
...لم يؤلمني البتّة

198
00:20:06,180 --> 00:20:07,610
...يا أختي

199
00:20:07,610 --> 00:20:11,700
بيج وان-ساما! توقّف ياماتو-ساما
!وقبّعة القشّ عن الهرب

200
00:20:11,700 --> 00:20:13,000
!حسنًا

201
00:20:16,580 --> 00:20:18,710
!مهلاً يا بي-تان

202
00:20:20,290 --> 00:20:23,300
!لا تتركني

203
00:20:26,250 --> 00:20:30,880
!إلى أين تأخذني؟! لا وقت لي للحديث مع غريب

204
00:20:30,880 --> 00:20:34,510
.انتظر. أريد الحديث فقط

205
00:20:35,340 --> 00:20:37,440
!ابتعد عن طريقي

206
00:20:51,230 --> 00:20:53,280
!استمع لما لديّ لأقوله

207
00:21:07,800 --> 00:21:09,460
!لديك خمس ثوانٍ

208
00:21:17,680 --> 00:21:20,980
.بإمكان الآخرين سماعنا
.أريد الحديث معك على انفراد

209
00:21:21,850 --> 00:21:23,820
!لا أريد إذًا

210
00:21:33,190 --> 00:21:35,450
...فاكهة المطّاط

211
00:21:35,450 --> 00:21:37,660
!المدفع الرّشّاش

212
00:21:52,960 --> 00:21:54,470
!يا لعنادك

213
00:21:56,260 --> 00:21:59,220
!الصّقر الأحمر

214
00:22:31,540 --> 00:22:33,390
...هذا يذكّرني

215
00:22:34,000 --> 00:22:36,510
!بقتالي مع ذلك الرّجل

216
00:22:37,380 --> 00:22:40,600
!من أنت؟! ما هو اسمك؟

217
00:22:41,430 --> 00:22:43,060
!أخبرني باسمك أوّلاً

218
00:22:43,260 --> 00:22:44,730
...أنا

219
00:22:45,720 --> 00:22:46,980
!إيس

220
00:22:51,020 --> 00:22:54,700
!أنا هنا لأدقّ عنق كايدو

221
00:23:04,200 --> 00:23:08,710
اجتمع الأكازايا التّسعة في أونيغاشيما
!حاملين إرادة أودن الّتي ورثوها عنه

222
00:23:08,710 --> 00:23:11,270
!يُحكم على مومونوسكي بالموت

223
00:23:11,270 --> 00:23:16,050
،في هذا الوضع الحسّاس للوقت
!يتشارك ياماتو عزمه بكلّ شغف

224
00:23:16,050 --> 00:23:21,470
ينزع ابن كايدو قناعه ويظهر للوفي
.المرتبك وجهه الحقيقيّ

225
00:23:22,470 --> 00:23:26,540
:في الحلقة القادمة من وان بيس
"!الرّغبة في أن يكون أودن! حلم ياماتو"

226
00:23:26,540 --> 00:23:30,490
!ملك القراصنة، لن يكون إلاّ أنا