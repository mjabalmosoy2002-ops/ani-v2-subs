1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,200 --> 00:03:22,630
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:22,630 --> 00:03:26,650
وصل لوفي إلى مارين فورد لإنقاذ أخيه
!إيس الّذي كان على وشك أن يُعدَم

39
00:03:27,700 --> 00:03:29,990
!تمكّن لوفي من إنقاذ إيس أخيرًا

40
00:03:30,360 --> 00:03:34,240
لكن، أصاب الأميرال أكاينو إيس في مقتل

41
00:03:34,830 --> 00:03:38,000
!ومات إيس بين ذراعَي لوفي

42
00:03:39,360 --> 00:03:44,930
...الرّجل الّذي ينتظره روجر

43
00:03:45,460 --> 00:03:50,090
!ليس أنت بأيّ حال من الأحوال يا تيتش

44
00:03:51,960 --> 00:03:55,600
.سامحوني يا أبنائي

45
00:03:56,630 --> 00:04:01,100
.ربّيتُ أحمقًا سخيفًا

46
00:04:02,930 --> 00:04:08,150
.لقد منحتموني كلّ شيء

47
00:04:09,060 --> 00:04:10,820
.تقديري لكم عميق

48
00:04:12,600 --> 00:04:16,480
!الوداع يا أولادي

49
00:04:20,800 --> 00:04:25,350
"!يبدأ العرض! تُكشف حبكة اللّحية السّوداء"

50
00:04:26,960 --> 00:04:29,170
!المكتب الرّئيسيّ! المكتب الرّئيسيّ

51
00:04:29,170 --> 00:04:31,760
!هناك أخبار مهمّة من مارينفورد

52
00:04:31,760 --> 00:04:33,600
!أهذا صحيح؟

53
00:04:33,600 --> 00:04:37,130
!هل اللّحية البيضاء فعلاً...؟! هل أنت واثق؟

54
00:04:37,130 --> 00:04:38,980
!...لا أصدّق أنّ اللّحية البيضاء قد

55
00:04:39,560 --> 00:04:42,100
!انتشرت الأخبار عبر العالم كالنّار في الهشيم

56
00:04:42,100 --> 00:04:46,500
"!فشل طاقم اللّحية البيضاء في إنقاذ ابن روجر إيس"

57
00:04:46,500 --> 00:04:50,930
".وموت اللّحية البيضاء، قبطان القراصنة الأسطوريّ"

58
00:04:50,930 --> 00:04:53,820
!المزيد! استعدّوا لطباعة إصدار آخر

59
00:04:54,130 --> 00:04:55,950
!إليكم أخبارًا عاجلة

60
00:04:56,400 --> 00:05:02,030
!مات اللّحية البيضاء بعد موت قبضة النّار إيس بلحظات! أكرّر

61
00:05:02,030 --> 00:05:03,790
...في مارينفورد

62
00:05:02,030 --> 00:05:03,790
...اللّحية البيضاء

63
00:05:03,790 --> 00:05:05,420
!مات

64
00:05:05,420 --> 00:05:08,830
!إذًا هذه نهاية قراصنة اللّحية البيضاء

65
00:05:08,830 --> 00:05:10,670
!ستنتهي الحرب قريبًا

66
00:05:10,670 --> 00:05:12,680
!يمكننا العيش في سلام أخيرًا

67
00:05:13,880 --> 00:05:17,310
النّاس الّذين شهدوا بأعينهم

68
00:05:17,310 --> 00:05:19,250
...الحدث التّاريخيّ الّذي يتمّ تبليغه الآن

69
00:05:19,600 --> 00:05:25,130
.يقفون مذهولين وعاجزين عن الكلام

70
00:05:31,970 --> 00:05:34,910
...رحل اللّحية البيضاء إذًا

71
00:05:49,750 --> 00:05:51,980
.كان في الـ72 من العمر

72
00:05:52,760 --> 00:05:56,550
.وقف في وجه حتّى ملك القراصنة في عصره

73
00:05:56,950 --> 00:05:59,260
كان قبطان قراصنة اللّحية البيضاء

74
00:05:59,260 --> 00:06:01,770
...وكان القرصان العظيم إدوارد نيوغيت

75
00:06:01,770 --> 00:06:04,090
.الملقّب باللّحية البيضاء

76
00:06:04,770 --> 00:06:09,770
...مات في الحرب الحاسمة في خليج مارينفورد بين

77
00:06:09,770 --> 00:06:13,010
قراصنة اللّحية البيضاء ومقرّ البحريّة

78
00:06:13,010 --> 00:06:16,330
.وحلفاؤهم الشّيتشيبوكاي

79
00:06:22,160 --> 00:06:24,250
!هذا مثير للاهتمام

80
00:06:24,250 --> 00:06:27,380
!ستتغيّر الأمور في العالم حقًّا

81
00:06:27,380 --> 00:06:28,800
،لكن حتّى قبل ذلك

82
00:06:29,320 --> 00:06:32,380
!لا أظنّ أنّ الأمور ستسوّى بتلك السّهولة أيضًا

83
00:06:33,090 --> 00:06:38,260
،مع أبشع المجرمين ومدير سجن إمبل داون

84
00:06:38,260 --> 00:06:43,640
.أتساءل ما الّذي ينوي اللّحية السّوداء فعله

85
00:06:44,100 --> 00:06:45,640
ما الّذي سيحدث؟

86
00:06:45,640 --> 00:06:48,400
أهذه نهاية الحرب حقًّا؟

87
00:06:48,400 --> 00:06:52,610
...وأيضًا، الكلام الّذي نطق به اللّحية البيضاء قبل موته

88
00:06:52,650 --> 00:06:55,190
...الوان بيس

89
00:06:56,450 --> 00:06:59,620
!موجود فعلاً

90
00:07:02,160 --> 00:07:05,960
!إنّها مسألة وقت إلى أن يعلم العالم

91
00:07:05,960 --> 00:07:08,880
!أتساءل كيف سيتفاعل القراصنة

92
00:07:08,880 --> 00:07:13,170
لكن حتّى قبل ذلك، أيمكننا أن نقول
أنّ هذه الحرب انتهت حقًّا؟

93
00:07:13,170 --> 00:07:16,880
لِمَ أتى اللّحية السّوداء إلى مارينفورد؟

94
00:07:33,690 --> 00:07:35,780
!ذلك الوغد

95
00:07:35,780 --> 00:07:39,530
!ماركو! الجميع يشعرون مثلك

96
00:07:39,530 --> 00:07:42,370
!لكن من الأفضل أن تحتمل

97
00:07:42,370 --> 00:07:44,560
!أعلم يا فيستا

98
00:07:46,160 --> 00:07:50,830
أسرعوا واصعدوا إلى السّفينة! ألا تذكرون آخر أوامر قبطاننا؟

99
00:07:50,830 --> 00:07:52,290
!إيس

100
00:07:52,290 --> 00:07:53,540
!والدي

101
00:08:04,720 --> 00:08:07,890
!جينبي! أسرع وأحضر أخا إيس

102
00:08:07,890 --> 00:08:09,100
!حسنًا

103
00:08:10,980 --> 00:08:13,320
!إيس-سان! الوالد العجوز

104
00:08:13,320 --> 00:08:17,690
!لم أستطع أن أفعل أيّ شيء لمساعدتكما

105
00:08:17,690 --> 00:08:21,660
!أريد أن أساعد لوفي-كن على الأقلّ

106
00:08:21,660 --> 00:08:24,160
!لا تدعوا القراصنة يهربون

107
00:08:24,160 --> 00:08:26,240
!اقتلوهم جميعًا

108
00:09:07,790 --> 00:09:10,250
!أيّها القبطان باغي، إلى أين أنت ذاهب؟

109
00:09:10,250 --> 00:09:13,920
!هل أنت غبيّ؟! سأخرج من هنا

110
00:09:13,920 --> 00:09:16,670
!لا أستطيع قتل اللّحية البيضاء لأنّه مات بالفعل

111
00:09:16,670 --> 00:09:18,710
!القبطان باغي

112
00:09:18,710 --> 00:09:20,590
!لم أستطع فعلها

113
00:09:20,590 --> 00:09:22,130
!مسار الثّقب المظلم

114
00:09:23,970 --> 00:09:26,640
!أيّها القبطان باغي، هذه فرصتك

115
00:09:26,640 --> 00:09:28,220
!أسرع واقتل اللّحية البيضاء

116
00:09:28,220 --> 00:09:31,770
!واثق أنّك تستطيع تجاوز هذا الشّقّ

117
00:09:31,770 --> 00:09:36,480
!كفّ عن إخباري ما أفعل
!لن يكون من الذّكاء مهاجمته بلا تفكير

118
00:09:36,480 --> 00:09:39,190
!إنّي أنتظر اللّحظة المناسبة

119
00:09:39,190 --> 00:09:41,140
!يظنّون أنّ الأمر سهل

120
00:09:41,140 --> 00:09:41,740
!ماء الظّلام

121
00:09:44,570 --> 00:09:46,660
!ما يعني أنّك ما عدت تستطيع إنشاء الزّلازل

122
00:09:46,660 --> 00:09:50,540
!صحيح! عرف القبطان باغي هذا وانتظر هذه اللّحظة

123
00:09:50,540 --> 00:09:51,960
!دعنا نساعدك

124
00:09:51,960 --> 00:09:53,000
...لا، انتظروا

125
00:09:53,000 --> 00:09:55,380
!ها أنت ذا أيّها القبطان باغي

126
00:09:55,380 --> 00:09:57,340
!مهلاً، مهلاً، مهلاً! انتظروا يا رفاق

127
00:09:57,840 --> 00:10:01,010
!هذا مؤلم! سحقًا

128
00:10:11,950 --> 00:10:15,980
!أ-أذلك ما يستطيع رجل عجوز يُحتضر فعله؟

129
00:10:16,980 --> 00:10:23,820
!لـ-لا! بل ذلك ما يجعله اللّحية البيضاء الأسطوريّ

130
00:10:23,820 --> 00:10:26,680
!كنتُ خائفًا ولم أستطع حتّى الاقتراب منه

131
00:10:26,680 --> 00:10:28,600
!كان اللّحية البيضاء مخيفًا

132
00:10:28,600 --> 00:10:32,330
!ذلك الرّجل في القمّة مخيف، حتّى إن كان ميّتًا

133
00:10:33,880 --> 00:10:40,040
!لا أهتمّ إن ظننتم أنّ أمري ميؤوس
!هذا الوداع أيّها الحمقى

134
00:10:41,420 --> 00:10:42,590
!القبطان باغي

135
00:10:43,000 --> 00:10:45,510
...إنّه يبكي... القبطان باغي

136
00:10:45,510 --> 00:10:47,890
"!فهمت! "عدوّ البارحة قد يكون صديق اليوم

137
00:10:48,160 --> 00:10:53,470
شعر بالشّفقة على منافسه اللّحية البيضاء
!دون أن حتّى أن يُدرك

138
00:10:53,470 --> 00:10:56,100
!أمكنه أن يقتل ذلك الرّجل

139
00:10:56,100 --> 00:10:58,850
!والآن يحاول أن يغادرنا دون أن يصطنع أعذارًا

140
00:10:59,440 --> 00:11:05,070
!ذلك اللّئيم! أرانا شيئًا أكثر أهمّيةً من قتل اللّحية البيضاء

141
00:11:05,510 --> 00:11:11,000
لا أصدّق أنّه اختار الشّفقة بدلاً
!من كلّ الشّهرة الّتي كان سيدركها

142
00:11:12,910 --> 00:11:17,020
!إنّه رجل منقطع النّظير كما علمنا طوال هذا الوقت

143
00:11:17,830 --> 00:11:19,960
!أنت رائع بحقّ أيّها القبطان باغي

144
00:11:19,960 --> 00:11:21,960
!انتظر أيّها القبطان باغي

145
00:11:21,960 --> 00:11:23,300
!دعنا نأتي معك

146
00:11:23,300 --> 00:11:25,280
!أيّها القبطان

147
00:11:34,830 --> 00:11:39,020
!كان عنيدًا حقًّا! من الجيّد رؤيته يسقط ميّتًا أخيرًا

148
00:11:39,020 --> 00:11:43,860
.الأمر يسير كما خطّطنا له حتّى الآن
.حان الوقت أيّها القبطان

149
00:11:44,400 --> 00:11:49,160
!حسنًا، لنبدأ

150
00:11:55,490 --> 00:11:57,500
!إنّهم يخطّطون لفعل شيء ثانيةً

151
00:11:57,500 --> 00:11:59,000
!تيتش، ذلك الوغد

152
00:11:59,000 --> 00:12:01,250
!ماذا سيفعل لوالدي الآن؟

153
00:12:04,090 --> 00:12:05,880
!سأقدّم عرضًا

154
00:12:06,880 --> 00:12:11,090
!إنّه عرض سيهزّ العالم أجمع

155
00:12:12,090 --> 00:12:14,310
!ما ذلك القماش الأسود؟

156
00:12:14,310 --> 00:12:16,890
!دخل اللّحية السّوداء تحته مع جسد اللّحية البيضاء

157
00:12:18,140 --> 00:12:21,560
!والآن، لا تتعدّوا لفترة

158
00:12:22,000 --> 00:12:24,130
!ماذا تفعلون بظنّكم؟

159
00:12:24,130 --> 00:12:27,450
إنّه شخص خدعنا بانضمامه إلى
!الشّيتشيبوكاي الملكيّين فقط لخيانتنا

160
00:12:27,450 --> 00:12:28,490
!ابقوا فطنين

161
00:12:30,700 --> 00:12:32,280
!لا أطيق الانتظار

162
00:12:32,280 --> 00:12:35,660
هل سيحلّ طاقمنا إن فشلنا؟

163
00:12:41,920 --> 00:12:44,630
!أسرعوا! إلى البحر

164
00:12:45,750 --> 00:12:47,550
!لوفي-كن

165
00:12:47,550 --> 00:12:49,160
!تماسك

166
00:12:49,160 --> 00:12:53,390
عليك أن تواصل في هذا العالم حيث
...ما عاد إيس يعيش فيه

167
00:12:53,390 --> 00:12:56,320
!لغدٍ وبعد غد

168
00:12:57,180 --> 00:12:58,430
!أطلقوا

169
00:12:59,270 --> 00:13:03,600
!عليك أن تعيش بقوّة

170
00:13:04,390 --> 00:13:07,940
...جينبي، إلّم أنجُ من الموت

171
00:13:10,260 --> 00:13:14,490
آسف لكن هلاّ اعتنيت بأخي؟

172
00:13:17,940 --> 00:13:20,290
،آسف على مناقضتك يا إيس-سان

173
00:13:20,290 --> 00:13:25,540
.لكن لا ينبغي أن تبالغ في تقديري
.لستُ طيّبًا كما تظنّ

174
00:13:25,540 --> 00:13:29,920
.حتّى إن كان أخاك، نحن في عالم القراصنة

175
00:13:29,920 --> 00:13:35,220
!إنّي أساعد أو أحمي فقط من أحترمه كثيرًا

176
00:13:37,840 --> 00:13:43,440
!لم تتغيّر مشاعري إطلاقًا يا إيس-سان

177
00:13:43,440 --> 00:13:46,880
!لستُ أساعده لأنّه أخوك

178
00:13:53,400 --> 00:13:58,280
!...أحترم لوفي-كن كثيرًا! ولهذا السّبب

179
00:14:05,670 --> 00:14:09,300
!أسرع يا جينبي! عالج لوفي

180
00:14:09,300 --> 00:14:11,920
!أيّها الباسيفيستا! اقتلا قبّعة القشّ

181
00:14:11,920 --> 00:14:16,000
!مع أنّه شيتشيبوكاي، إلاّ أنّ جينبي عدوّنا الآن

182
00:14:16,000 --> 00:14:17,490
!مسموح لنا قتله

183
00:14:20,630 --> 00:14:22,020
!السّاق العطِرة

184
00:14:26,730 --> 00:14:30,270
!بوا هانكوك! هل ستقفين في طريقنا ثانيةً؟

185
00:14:32,680 --> 00:14:36,410
!قبضة النّار إيس واللّحية البيضاء ماتا بالفعل

186
00:14:36,410 --> 00:14:39,370
!لا أحبّ الرّجال العنيدين

187
00:14:43,120 --> 00:14:47,370
!جينبي! اعتن بلوفي جيّدًا رجاءً

188
00:14:47,370 --> 00:14:49,500
!جينبي! اركب هذه السّفينة

189
00:14:49,500 --> 00:14:50,380
!حسنًا

190
00:14:51,800 --> 00:14:52,960
!ما هذا؟

191
00:14:56,630 --> 00:14:59,350
!سحقًا! لقد جمّد البحر

192
00:14:59,350 --> 00:15:00,600
!لا يمكننا المغادرة

193
00:15:00,600 --> 00:15:02,640
!أسرع وافعل شيئًا

194
00:15:02,640 --> 00:15:04,480
!إنّه الأميرال أوكيجي

195
00:15:04,480 --> 00:15:07,060
!أوقفوا أوكيجي

196
00:15:09,310 --> 00:15:11,980
!لا خيار لديّ! سأبحث عن طريق آخر

197
00:15:21,910 --> 00:15:24,540
،عندما أقول أنّني لن أدعكم تهربون

198
00:15:25,130 --> 00:15:28,250
!لِمَ لا تسلّم حياتك أيّها الأحمق

199
00:15:52,520 --> 00:15:56,400
!سلّم لي ابن دراغون

200
00:15:56,400 --> 00:15:59,620
!أكاينو! ليس ميّتًا

201
00:15:59,620 --> 00:16:01,700
!خلتُ أنّه هُزم على يد والدي

202
00:16:01,700 --> 00:16:03,200
...لقد انتقل تحت الأرض

203
00:16:03,200 --> 00:16:04,950
!عبر صنع طريق بالحمم

204
00:16:05,410 --> 00:16:06,850
!جينبي

205
00:16:06,850 --> 00:16:11,880
!لا يمكنني أن أفعل ذلك
...لأنّني حسمتُ أمري بالفعل

206
00:16:11,880 --> 00:16:15,130
!بأن أنقذ حياته وإن كلّفني ذلك حياتي

207
00:16:15,130 --> 00:16:19,010
!حسنًا إذًا، لن أسألك ثانيةً

208
00:16:22,200 --> 00:16:26,850
!كوبي! يريد أكاينو-سان قتل قبّعة القشّ بأيّ ثمن

209
00:16:26,850 --> 00:16:30,690
!فور أن يراك هدفًا، لا يمكنك الهرب منه

210
00:16:31,690 --> 00:16:33,060
...لوفي-سان

211
00:16:36,150 --> 00:16:39,070
!سنحمي أخا إيس

212
00:16:39,070 --> 00:16:41,160
!ذلك أمر والدنا أيضًا

213
00:16:41,160 --> 00:16:44,410
!أجل! عائلة إيس هي عائلتنا أيضًا

214
00:16:45,780 --> 00:16:48,830
!عائلة"؟ كفاكم تفاهةً"

215
00:16:49,160 --> 00:16:56,840
"لقد تركتم قبضة النّار إيس و"والدكم
!اللّحية البيضاء لحتفهما وهربتم

216
00:16:56,840 --> 00:16:57,920
!ماذا قلت؟

217
00:16:57,920 --> 00:16:59,210
!خذ هذه

218
00:17:05,600 --> 00:17:06,850
!هـ-هذا لا يفلح إطلاقًا

219
00:17:07,230 --> 00:17:10,100
!ابتعدوا عن طريقي أيّها الجبناء

220
00:17:10,100 --> 00:17:11,310
!تنحّ جانبًا يا جينبي

221
00:17:11,310 --> 00:17:16,110
!هورمونات إمبوريو لتكبير الوجه

222
00:17:16,960 --> 00:17:20,860
!إيفا-سان، دعني أساعدك

223
00:17:23,320 --> 00:17:24,950
!المقصّ العظيم

224
00:17:26,830 --> 00:17:29,750
!لا تلمس فتى قبّعة القشّ

225
00:17:29,750 --> 00:17:32,500
!سأقتل ابن دراغون بالتّأكيد

226
00:17:32,500 --> 00:17:34,170
...غمزة

227
00:17:34,170 --> 00:17:35,750
!الجحيم

228
00:17:43,730 --> 00:17:48,000
منذ إمبل داون، كان فتى قبّعة
...القشّ يتعرّض للهجوم

229
00:17:48,000 --> 00:17:52,900
!جسديًّا وعقليًّا وقد دفعه ذلك لأكثر من طاقته

230
00:17:54,440 --> 00:18:00,030
...إن تركتُ مكروهًا يصبه، فلن أستطيع أن أواجه

231
00:18:00,030 --> 00:18:03,530
!رفيقي دراغون لما تبقّى من حياتي

232
00:18:03,530 --> 00:18:04,740
!أوافقك

233
00:18:06,820 --> 00:18:10,740
!لا أملك الوقت لألهو معكما الآن

234
00:18:11,160 --> 00:18:13,000
!لذا تراجعا أنتما الاثنان

235
00:18:13,000 --> 00:18:15,210
!هلمّ إليّ

236
00:18:15,210 --> 00:18:20,960
!أنا أحترق بحرارة أكثر منك الآن

237
00:18:37,100 --> 00:18:39,730
!يبدو أنّه جاهز الآن

238
00:18:39,730 --> 00:18:42,070
!دعني أراه يا قبطان

239
00:18:51,870 --> 00:18:56,330
!حسنًا جميعًا، شكرًا لكم من أجل الانتظار

240
00:18:56,330 --> 00:18:58,300
إنّه العرض الأعظم في العالم

241
00:18:58,300 --> 00:19:02,170
!بتقديم من القبطان تيتش من قراصنة اللّحية السّوداء

242
00:19:02,170 --> 00:19:05,050
!استمتعوا به رجاءً

243
00:19:09,050 --> 00:19:11,560
!ا-اللّحية السّوداء

244
00:19:15,230 --> 00:19:17,560
!ما الّذي كان يفعله هناك؟

245
00:19:18,160 --> 00:19:20,300
!لم يتغيّر شيء على جسد اللّحية البيضاء

246
00:19:22,730 --> 00:19:24,480
!وعلى جسم اللّحية السّوداء أيضًا

247
00:19:25,940 --> 00:19:29,030
!أيّتها البحريّة

248
00:19:29,990 --> 00:19:34,110
!سأريكم ما أنا قادر عليه

249
00:19:35,250 --> 00:19:38,170
!سنصبح أعداءً ثانيةً

250
00:19:42,340 --> 00:19:44,270
!مسار الثّقب المظلم

251
00:19:46,090 --> 00:19:48,090
!ما الّذي يجري؟

252
00:19:53,880 --> 00:19:57,850
!تلك قوّة فاكهة الظّلام خاصّتي

253
00:19:58,300 --> 00:19:59,390
...والآن

254
00:20:02,770 --> 00:20:04,190
...هذه

255
00:20:08,120 --> 00:20:09,400
!...تلك الوقفة

256
00:20:35,560 --> 00:20:36,850
...تلك

257
00:20:37,720 --> 00:20:40,520
!قوّة فاكهة الزّلزال

258
00:20:40,520 --> 00:20:45,650
!لـ-لماذا يملك قوّة اللّحية البيضاء الرّاحل؟

259
00:20:50,740 --> 00:20:52,530
!نجحت يا قبطان

260
00:20:52,530 --> 00:20:55,470
لن يحلّ طاقمنا إذًا؟

261
00:20:55,470 --> 00:21:00,290
!يبدو أنّني اتّخذتُ القرار الصّائب بالانضمام لهم

262
00:21:02,080 --> 00:21:04,880
!قوّة زلزال والدي؟

263
00:21:04,880 --> 00:21:07,750
!ما الّذي فعله ذلك الوغد تيتش

264
00:21:10,510 --> 00:21:13,470
!جاذبيّة الظّلام تجلب الفناء التّامّ

265
00:21:14,000 --> 00:21:17,260
!وقوّة الزّلزال تدمّر كلّ شيء

266
00:21:17,760 --> 00:21:22,300
!وأنا أمتلك كليهما! لا يستطيع أيّ أحد منافستي الآن

267
00:21:22,920 --> 00:21:26,230
!فأنا الرّجل الأقوى في العالم

268
00:21:29,150 --> 00:21:31,730
...لا أدري كيف فعل هذا لكن

269
00:21:31,730 --> 00:21:34,460
!حصل على قوّة اللّحية البيضاء

270
00:21:34,460 --> 00:21:36,220
!كيف يعقل؟

271
00:21:36,220 --> 00:21:41,330
!ما يعني أنّه ما زال علينا الخوف من قوّة فاكهة الزّلزال؟

272
00:21:41,760 --> 00:21:47,160
إن كنتُ صائبًا، يستحيل على المرء أن يمتلك
!قوى فاكهتَي شيطان في نفس الوقت

273
00:21:47,160 --> 00:21:50,340
.ذلك مستحيل على النّاس العاديّين بالتّأكيد

274
00:21:50,340 --> 00:21:54,570
.لكنّ تيتش مختلف قليلاً كما تعلمان

275
00:21:54,570 --> 00:21:58,310
.بنيته الجسديّة مختلفة مقارنةً مع سائر النّاس

276
00:21:59,590 --> 00:22:01,980
!ولهذا استطاع فعل ذلك

277
00:22:01,980 --> 00:22:04,850
!هل رأيتم ذلك؟

278
00:22:07,150 --> 00:22:12,320
!أخبروا النّاس في العالم
،الأشخاص المملّين الّذين يحبّون السّلام

279
00:22:12,320 --> 00:22:15,740
!وجنود البحريّة وحكومة العالم والقراصنة

280
00:22:16,380 --> 00:22:18,530
!لا بدّ أنّ هذا كابوس

281
00:22:18,530 --> 00:22:21,870
!مستقبل هذا العالم محسوم

282
00:22:24,330 --> 00:22:28,630
!أجل، ها قد حان العصر الّذي أغزوه

283
00:22:31,800 --> 00:22:36,180
!ظننت أنّ اللّحية البيضاء مات وانتصرت البحريّة

284
00:22:36,180 --> 00:22:39,600
!لا أصدّق أنّه الآن يملك قوى فاكهتَي شيطان

285
00:22:40,120 --> 00:22:43,020
!من يكون اللّحية السّوداء بالضّبط؟

286
00:22:43,020 --> 00:22:46,350
!ظننت أنّ الحرب ستنتهي قريبًا

287
00:22:46,350 --> 00:22:49,770
!إذًا لٍمَ يحدث هذا؟! يا كوبي

288
00:22:50,530 --> 00:22:57,160
مع أنّ أخا لوفي-سان واللّحية البيضاء
!ماتا، إلاّ أنّ هذه الحرب لم تنتهِ؟

289
00:23:11,430 --> 00:23:16,210
يستخدم اللّحية السّوداء القوّة الّتي سرقها
.من اللّحية البيضاء بحريّة ليعيث فسادًا

290
00:23:16,210 --> 00:23:18,970
في نفس الأثناء، أكاينو وبقيّة البحريّة

291
00:23:18,970 --> 00:23:21,880
.يلاحقون القراصنة باسم العدالة

292
00:23:21,880 --> 00:23:24,510
،لا يبدو أنّ الحرب ستنتهي

293
00:23:24,510 --> 00:23:26,690
!بل يحمي وطيسها أكثر

294
00:23:26,690 --> 00:23:27,890
:في الحلقة القادمة من وان بيس

295
00:23:27,890 --> 00:23:31,480
"!أكاينو الجشع! قبضة الحمم تضرب لوفي"

296
00:23:31,480 --> 00:23:33,840
!ملك القراصنة، لن يكون إلاّ أنا

297
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة