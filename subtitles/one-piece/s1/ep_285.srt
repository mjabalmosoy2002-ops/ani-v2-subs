1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:42,510 --> 00:02:43,610
...تلك

33
00:02:43,610 --> 00:02:45,530
...مهلاً... لا تقل لّي

34
00:02:48,500 --> 00:02:51,770
!...إنّها مخطّطات السّلاح العتيق بلوتون

35
00:02:52,240 --> 00:02:53,870
.إنّها هي بعينها

36
00:02:54,080 --> 00:02:55,440
هل تصدّقني؟

37
00:03:00,620 --> 00:03:02,740
.يا سباندا

38
00:03:02,880 --> 00:03:06,840
...ما خاطر توم-سان وأيسبرغ بحياتهما لحمايته

39
00:03:06,840 --> 00:03:08,200
!سلّمها لي بسرعة

40
00:03:08,200 --> 00:03:11,300
...رغبة المهندس المعماريّ لهذا السّلاح

41
00:03:11,300 --> 00:03:14,350
أي، إن وقع السّلاح العتيق في أيدي غبيّ مثلك

42
00:03:15,160 --> 00:03:17,810
،وبدأ استخدامه بغرض التّسبّب في المشاكل

43
00:03:17,810 --> 00:03:21,180
.فسيرغب حينها ببناء سلاح آخر لإيقاف الأوّل

44
00:03:21,990 --> 00:03:26,300
صحيحٌ أنّك تستطيع إحياء السّلاح
.العتيق إن استخدمت نيكو روبين

45
00:03:26,760 --> 00:03:28,740
،حتّى إن كانت لا تريد مساعدتك

46
00:03:28,740 --> 00:03:31,280
،ما دام يُمكن استخدامها

47
00:03:31,500 --> 00:03:33,150
.فهي خطيرة

48
00:03:33,330 --> 00:03:39,290
لكنّها تملك أصدقاء مستعدّون
.للمخاطرة بحياتهم لإنقاذها

49
00:03:39,640 --> 00:03:40,900
...لذا سوف

50
00:03:42,290 --> 00:03:43,950
.أراهن

51
00:04:01,010 --> 00:04:02,980
!أيّها الوغد! ما الّذي تفعله؟

52
00:04:04,110 --> 00:04:05,410
!تحوّلت إلى رماد

53
00:04:07,800 --> 00:04:11,920
.والآن لم تعد هناك قوّة لمواجهة السّلاح العتيق

54
00:04:12,130 --> 00:04:16,360
إلّم يحدث شيء وسقطت نيكو روبين
.بين أيديكم، سيكون ذلك بلا فائدة

55
00:04:16,550 --> 00:04:19,060
...لكن إن فاز طاقم قبّعة القشّ

56
00:04:19,620 --> 00:04:23,860
.فلن يظلّ لكم شيء على الإطلاق

57
00:04:24,090 --> 00:04:27,830
.راهنتُ على فوزهم

58
00:04:28,260 --> 00:04:30,320
...كاتي فلام

59
00:04:30,970 --> 00:04:33,310
...كيف تجرّأت

60
00:04:34,700 --> 00:04:37,790
!على حرق مخطّطاتي؟

61
00:04:47,600 --> 00:04:48,600
!أخي

62
00:04:49,100 --> 00:04:53,560
!أخي يسقط إلى الشّلاّل

63
00:04:53,770 --> 00:04:55,700
!فرانكي

64
00:04:55,700 --> 00:04:57,270
!أيّها القراصنة

65
00:04:58,770 --> 00:05:00,500
!ما ذلك؟

66
00:05:00,500 --> 00:05:02,690
!اقفزوا بكلّ قوّتكم إلى الشّلاّل

67
00:05:06,660 --> 00:05:08,620
!ر-رجل الصّاروخ؟

68
00:05:14,800 --> 00:05:16,500
!إنّه يطير ثانيةً

69
00:05:22,830 --> 00:05:25,630
هذا يعيد الذّكريات، أليس كذلك يا توم-سان؟

70
00:05:28,630 --> 00:05:31,810
...أمّا بشأن مساعدة المدعوّ روجر

71
00:05:32,070 --> 00:05:35,430
!أنا فخور بذلك بعزم

72
00:05:35,690 --> 00:05:38,330
.أنا لوفي وأنا الرّجل الّذي سيصبح ملك القراصنة

73
00:05:38,330 --> 00:05:38,950
!حقًّا؟

74
00:05:38,950 --> 00:05:39,520
.نعم

75
00:05:41,080 --> 00:05:42,900
كان روجر

76
00:05:43,930 --> 00:05:46,790
غبيًّا مثله أيضًا، أليس كذلك؟

77
00:05:47,100 --> 00:05:50,890
.وساعدته كثيرًا

78
00:05:51,250 --> 00:05:52,910
.يبدو أنّنا لم نتعلّم درسنا

79
00:05:53,210 --> 00:05:58,470
.جميع عمّال توم يساعدون هذا الفتى القرصان

80
00:06:00,980 --> 00:06:04,880
كنتَ لتفعل المثل، أليس كذلك يا توم-سان؟

81
00:06:13,590 --> 00:06:15,220
!سنصطدم

82
00:06:15,750 --> 00:06:18,230
!سـ-سنُسحق

83
00:06:25,790 --> 00:06:30,620
!احصلوا على المفاتيح الخمسة’’
‘‘.قراصنة قبّعة القشّ ضدّ السّي بي 9

84
00:06:58,330 --> 00:06:59,890
!اهربوا

85
00:07:15,340 --> 00:07:16,290
...لقد أتوا

86
00:07:19,250 --> 00:07:20,710
!يويوي

87
00:07:24,920 --> 00:07:26,400
!لقد أتوا

88
00:07:26,400 --> 00:07:27,800
!سحقًا

89
00:07:27,800 --> 00:07:29,270
!تعالي معي

90
00:07:31,610 --> 00:07:34,800
ليتني أستطيع التّحرّر من أصفاد
...الحجر البحريّ هذه

91
00:07:37,170 --> 00:07:40,520
!إنّي أعطيكم كامل الحرّيّة أيّها السّي بي 9

92
00:07:41,270 --> 00:07:44,860
!أبرحوهم ضربًا هنا في برج القانون

93
00:07:47,080 --> 00:07:49,490
!أمنحكم الإذن بذبحهم

94
00:07:49,760 --> 00:07:52,090
!لوتشي! تعال معي

95
00:07:52,090 --> 00:07:54,490
!حماية حياتي هي أولى أوليّاتك

96
00:07:54,490 --> 00:07:55,640
!مفهوم؟

97
00:07:55,920 --> 00:07:57,080
!فانكفريد

98
00:08:09,420 --> 00:08:11,490
.حسنًا، ولد مطيع

99
00:08:14,940 --> 00:08:16,220
...فاكهة شيطان

100
00:08:16,680 --> 00:08:18,850
!أكل الفيل فاكهة شيطان بقوى سيوف؟

101
00:08:18,850 --> 00:08:21,070
.كلاّ، بل العكس

102
00:08:21,070 --> 00:08:23,310
.إنّه سيف تناول فاكهة الفيل

103
00:08:23,310 --> 00:08:24,770
.بعبارة أخرى، إنّه سيفٌ فيل

104
00:08:25,520 --> 00:08:29,870
أملك بحوزتي هذا السّيف القيّم
.بالإضافة إلى السّي بي 9

105
00:08:30,000 --> 00:08:33,600
،عندما أفكّر في الأمر بهدوء
.ليس هناك ما يخيفني

106
00:08:33,720 --> 00:08:36,190
!والآن، لنذهب إلى بوّابات العدالة

107
00:08:36,190 --> 00:08:39,990
حاول استرجاع هذه المرأة
!إن استطعت يا قبّعة القشّ

108
00:08:40,800 --> 00:08:42,590
!أخي فرانكي بخير

109
00:08:42,590 --> 00:08:46,270
!وصل طاقم قبّعة القشّ إلى برج القانون أخيرًا

110
00:08:46,270 --> 00:08:48,460
!لم يعد أخونا حبيسًا

111
00:08:48,750 --> 00:08:50,350
!ويبدو أنّه سينضمّ للقتال

112
00:08:50,350 --> 00:08:52,300
!هذا صحيح! هذه من شيمه

113
00:08:52,600 --> 00:08:55,130
!عليك بهم يا أخي

114
00:08:55,390 --> 00:08:57,890
!انطلق! يا قبّعة القشّ

115
00:08:58,460 --> 00:09:00,640
.إنّنا نعهد لك بالباقي يا قبّعة القشّ

116
00:09:04,080 --> 00:09:06,010
!هل أنتم بخير؟

117
00:09:06,010 --> 00:09:08,020
!العجوز كوكورو؟! الصّغيران؟

118
00:09:08,020 --> 00:09:13,490
ماذا دهاكما تأتيان إلى هنا جالبين
!شيئًا خطيرًا كالرّجل الصّاروخ؟

119
00:09:13,690 --> 00:09:15,960
...صـ-صحيحٌ أنّه أنقذني، لكن

120
00:09:16,080 --> 00:09:18,160
!أيّتها العجوز! تماسكي

121
00:09:18,370 --> 00:09:20,930
!أترجّاك! لا تموتي

122
00:09:20,930 --> 00:09:23,020
!لا تموتي

123
00:09:35,280 --> 00:09:36,340
.نزف أنفي

124
00:09:36,710 --> 00:09:39,510
كيف أمكنكم النّجاة من اصطدام
!كهذا بنزيف أنف فقط؟

125
00:09:40,360 --> 00:09:42,640
!حسنًا! وصلنا

126
00:09:44,090 --> 00:09:45,020
!...يا قبّعة القشّ

127
00:09:45,270 --> 00:09:46,360
!مرحبًا

128
00:09:46,360 --> 00:09:48,730
!شكرًا يا جدّتي الوحش

129
00:09:48,910 --> 00:09:51,540
!يا رفاق! انهضوا بسرعة

130
00:09:51,540 --> 00:09:53,220
!لم يكن ذلك شيئًا

131
00:09:53,900 --> 00:09:56,410
.أنت مطّاطيّ. فلا تقارنّا بك

132
00:09:56,660 --> 00:10:00,000
اضطررنا نحن البشر من لحم ودم
.أن نقتحم المكان بتلك الطّريقة

133
00:10:00,150 --> 00:10:01,830
هل تظنّ أنّنا بخير...؟

134
00:10:02,690 --> 00:10:07,840
!محال

135
00:10:07,840 --> 00:10:09,180
.نعم، إنّهم بخير جميعًا

136
00:10:09,400 --> 00:10:12,000
...أنتم غريبو الأطوار جميعًا أيضًا، لذا

137
00:10:12,210 --> 00:10:13,590
.فقط للأمانة

138
00:10:13,900 --> 00:10:15,530
!ثمّة درج في الأعلى

139
00:10:15,530 --> 00:10:17,430
!لنسرع ونلحق بروبين

140
00:10:25,080 --> 00:10:26,130
.انتظروا

141
00:10:28,160 --> 00:10:29,230
!ما ذلك؟

142
00:10:29,520 --> 00:10:31,220
...تشابابابا

143
00:10:31,220 --> 00:10:33,830
.قاموا بغزونا

144
00:10:33,950 --> 00:10:35,750
حتّى إن ذهبتم إلى الغرفة
،الّتي رأيتم قبل قليل

145
00:10:35,750 --> 00:10:37,850
،ما عادت نيكو روبين هناك

146
00:10:37,850 --> 00:10:40,070
.لأنّ لوتشي أخذتها إلى بوّابات العدالة

147
00:10:40,600 --> 00:10:41,450
!ماذا؟

148
00:10:41,670 --> 00:10:44,130
.ورئيسنا أيضًا

149
00:10:46,550 --> 00:10:47,600
!هكذا إذًا؟

150
00:10:47,600 --> 00:10:49,410
.شكرًا على إخبارنا بهذه المعلومات القيّمة

151
00:10:50,050 --> 00:10:52,580
...تشابابا... زلّ لساني

152
00:10:53,100 --> 00:10:54,800
.يا له من شخص مضحك

153
00:10:54,800 --> 00:10:56,030
...أيًّا كان

154
00:10:56,030 --> 00:10:58,150
،إنّهم متّجهون إلى هناك الآن

155
00:10:58,150 --> 00:11:00,140
،لكنّي لن أدلّكم على الطّريق إلى هناك

156
00:11:00,140 --> 00:11:02,920
كما أنّنا نحن، السّي بي 9
.لن ندعهم تتبعوهم أيضًا

157
00:11:03,030 --> 00:11:06,770
.لدينا أمر بالقضاء عليكم

158
00:11:07,000 --> 00:11:08,770
أمر بالقضاء علينا...؟

159
00:11:08,960 --> 00:11:12,050
،ما لم تستطيعوا هزيمتنا

160
00:11:12,050 --> 00:11:14,770
.لن تتمكّنوا من تحرير نيكو روبين

161
00:11:15,080 --> 00:11:15,950
.نعم

162
00:11:16,170 --> 00:11:18,440
لست بحاجة لإخبارنا ذلك
.لأنّنا سنهزمكم على كلّ حال

163
00:11:18,440 --> 00:11:19,670
...تشابابا

164
00:11:19,670 --> 00:11:21,840
.يا له من شخص شجاع

165
00:11:21,970 --> 00:11:23,990
.لكن دعني أخبركم بشيء أخير

166
00:11:24,280 --> 00:11:25,950
.ماذا؟! افعل ما يحلو لك

167
00:11:26,280 --> 00:11:28,540
.شكرًا

168
00:11:29,100 --> 00:11:30,870
.إذًا سأحدّثكم بصراحة

169
00:11:31,530 --> 00:11:33,130
!انظروا إلى هذا

170
00:11:33,350 --> 00:11:34,470
مفتاح؟

171
00:11:34,650 --> 00:11:35,590
!مفتاح ماذا؟

172
00:11:36,390 --> 00:11:41,880
إنّه مفتاح فكّ أصفاد الحجر البحريّ
!الّتي تُكبّل نيكو روبين

173
00:11:41,880 --> 00:11:43,310
الحجر البحريّ؟

174
00:11:43,310 --> 00:11:46,800
.إنّه حجر يُبطل قوى فاكهة الشّيطان

175
00:11:46,940 --> 00:11:49,600
سمعتُ أنّ تأثيره يضاهي تأثير سقوط
.حاملي قوّة فاكهة الشيّطان في البحر

176
00:11:50,160 --> 00:11:53,410
،إذًا لهذا لا تقاتل روبين الآن

177
00:11:53,410 --> 00:11:54,940
.على الرّغم من مدى قوّتها

178
00:11:54,940 --> 00:11:56,060
.نعم

179
00:11:56,350 --> 00:11:58,060
،عادةً

180
00:11:58,060 --> 00:12:01,360
هي ليست ضعيفة لدرجة أن تظلّ أسيرة
.لدى أشخاص كأولئك بدون أيّ مقاومة

181
00:12:01,730 --> 00:12:03,570
.لا بدّ أنّها تشعر بالإحباط

182
00:12:03,810 --> 00:12:05,120
.فهمت

183
00:12:05,120 --> 00:12:09,490
،حتّى إن حالفكم الحظّ وأنقذتم نيكو روبين

184
00:12:09,490 --> 00:12:12,130
،بما أنّ الحجر البحريّ صلب كالماسّ

185
00:12:12,130 --> 00:12:15,330
.فستظلّ مكبّلة به إلى الأبد

186
00:12:16,270 --> 00:12:17,730
...تشابابا

187
00:12:17,730 --> 00:12:19,170
.زلّ لساني ثانيةً

188
00:12:19,690 --> 00:12:21,510
.إنّه مضحك بحقّ

189
00:12:21,740 --> 00:12:25,220
،إن كنتم لا تمانعون ذلك
.بادروا في إنقاذ نيكو روبين

190
00:12:25,820 --> 00:12:28,180
!تشابابابابا

191
00:12:28,580 --> 00:12:29,790
...إذًا

192
00:12:30,570 --> 00:12:33,520
!أعطه لنا

193
00:12:37,400 --> 00:12:40,070
.يبدو أنّه يستطيع استخدام تلك التّقنية أيضًا

194
00:12:40,580 --> 00:12:42,190
.لا تتهوّر

195
00:12:42,540 --> 00:12:45,790
.لم أقل أنّ هذا هو المفتاح الصّحيح

196
00:12:45,790 --> 00:12:48,200
!ماذا؟

197
00:12:49,610 --> 00:12:52,700
قد يكون مفتاح

198
00:12:52,700 --> 00:12:55,600
.أصفاد أخرى

199
00:12:55,710 --> 00:12:57,930
!تشابابا بابا

200
00:12:58,620 --> 00:13:00,630
يوجد على هذا البرج

201
00:13:00,990 --> 00:13:05,860
.خمسة أعضاء من السّي بي 9، بمن فيهم أنا

202
00:13:05,860 --> 00:13:09,480
لكلٍّ مفتاحه

203
00:13:07,080 --> 00:13:09,480
!واحد، اثنان، هيّا

204
00:13:09,480 --> 00:13:11,920
!واحد، اثنان، سيّئ

205
00:13:09,480 --> 00:13:13,390
.وينتظرونكم

206
00:13:13,650 --> 00:13:16,560
إذًا إلى أن نهزمكم جميعًا ونأخذ المفاتيح

207
00:13:16,560 --> 00:13:18,770
،ونجرّبها على أصداف روبين

208
00:13:18,770 --> 00:13:20,980
!لن نعرف أيّها المفتاح الصّحيح؟

209
00:13:20,980 --> 00:13:23,360
يا للغباء... هل تماطلون؟

210
00:13:23,740 --> 00:13:25,310
،بينما نحن نقاتل

211
00:13:25,310 --> 00:13:28,450
تحاولون أخذ روبين-تشان
!إلى بوّابات العدالة، أليس كذلك؟

212
00:13:28,910 --> 00:13:31,040
!هو كذلك

213
00:13:31,040 --> 00:13:33,410
...زلّ لساني ثانيةً

214
00:13:33,660 --> 00:13:35,870
.يجب أن نمنح الأولويّة للّحاق بروبين بسرعة

215
00:13:36,240 --> 00:13:40,770
.سنسترجع روبين أوّلاً ثمّ نقلق حيال المفتاح

216
00:13:41,000 --> 00:13:43,390
!لنتجاهل غريب الأطوار ذاك ونسرع

217
00:13:43,390 --> 00:13:44,130
!تشابا

218
00:13:44,700 --> 00:13:46,060
!تشابابا

219
00:13:46,060 --> 00:13:48,220
.أنت ذكيّة

220
00:13:48,440 --> 00:13:50,490
،لكن إن فعلتم ذلك

221
00:13:50,760 --> 00:13:55,680
!سأرمي هذا المفتاح إلى البحر! تشابابا

222
00:13:57,690 --> 00:14:00,560
.إنّنا نمنحكم فرصة

223
00:14:00,560 --> 00:14:01,150
.إلى اللّقاء

224
00:14:01,620 --> 00:14:03,710
!انتظر أيّها النّذل

225
00:14:03,710 --> 00:14:04,820
!انتظر

226
00:14:05,800 --> 00:14:07,360
!انتظر أنت

227
00:14:09,220 --> 00:14:11,500
!توقّف! فقط قليلاً

228
00:14:11,500 --> 00:14:14,840
!انتظر إلى أن نقرّر ما سيفعله كلٌّ منّا

229
00:14:15,260 --> 00:14:17,920
!أفلتني

230
00:14:18,030 --> 00:14:20,230
.اهدأ يا قبّعة القشّ

231
00:14:20,430 --> 00:14:23,170
!دعني

232
00:14:20,940 --> 00:14:23,170
هل لوتشي هو صاحب الحمامة؟

233
00:14:23,390 --> 00:14:24,960
.نعم، ذاك هو

234
00:14:25,350 --> 00:14:28,050
،إن كان مع روبين-تشان

235
00:14:28,730 --> 00:14:31,010
.فيجب أن ندع لوفي يتقدّم على الأقلّ

236
00:14:31,300 --> 00:14:32,420
.لوفي

237
00:14:32,600 --> 00:14:34,850
.على أيّ حال، أوسع صاحب الحمامة ذاك ضربًا

238
00:14:35,170 --> 00:14:37,270
!دعني! دعني

239
00:14:37,660 --> 00:14:40,200
.نحن ستّة باستثناء لوفي

240
00:14:40,490 --> 00:14:42,980
.وقال أنّ هنالك خمسة أعضاء من السّي بي 9 هنا

241
00:14:43,330 --> 00:14:47,240
.سنأخذ مفتاح أصفاد روبين-تشان منهم ونلحق بلوفي

242
00:14:48,280 --> 00:14:50,860
.إن عبرت روبين-كن من البوّابات، فسينتهي الأمر

243
00:14:51,170 --> 00:14:53,540
!إنّنا نسابق الوقت

244
00:14:53,830 --> 00:14:56,160
!خسارتنا أمامهم تعني خسارتنا للوقت

245
00:14:58,770 --> 00:15:01,000
!جميعًا! اقضوا عليهم وإن كلّفكم ذلك حياتكم

246
00:15:01,000 --> 00:15:01,970
!أجل

247
00:15:01,970 --> 00:15:04,600
!بالتّوفيق

248
00:15:19,480 --> 00:15:21,940
!دعني! دعني

249
00:15:22,370 --> 00:15:24,850
.نحن ستّة باستثناء لوفي

250
00:15:25,200 --> 00:15:27,610
.وقال أنّ هنالك خمسة أعضاء من السّي بي 9 هنا

251
00:15:28,080 --> 00:15:31,960
.سنأخذ مفتاح أصفاد روبين-تشان منهم ونلحق بلوفي

252
00:15:33,220 --> 00:15:35,410
.إن عبرت روبين-كن من البوّابات، فسينتهي الأمر

253
00:15:35,840 --> 00:15:38,370
!إنّنا نسابق الوقت

254
00:15:38,640 --> 00:15:40,660
!خسارتنا أمامهم تعني خسارتنا للوقت

255
00:15:43,570 --> 00:15:45,630
!جميعًا! اقضوا عليهم وإن كلّفكم ذلك حياتكم

256
00:15:45,630 --> 00:15:46,810
!أجل

257
00:15:46,810 --> 00:15:49,590
!بالتّوفيق

258
00:15:50,190 --> 00:15:53,840
!يا رفاقنا القراصنة

259
00:15:58,490 --> 00:16:00,620
تشيمني؟ غونبي؟

260
00:16:00,620 --> 00:16:02,640
هل ذهبا؟

261
00:16:02,930 --> 00:16:05,650
!كانوا هناك قبل قليل فحسب

262
00:16:06,060 --> 00:16:07,980
!أنا واثق أنّني سأصادفهم في مكان ما

263
00:16:08,260 --> 00:16:11,440
!لن أدعكم تذهبون إلى بوّابات العدالة

264
00:16:11,440 --> 00:16:13,990
!روبين

265
00:16:14,670 --> 00:16:16,780
!ممرّ سرّيّ

266
00:16:16,780 --> 00:16:20,950
!ممرّ سرّيّ! ممرّ سرّيّ

267
00:16:20,950 --> 00:16:23,240
!ممر سرّيّ

268
00:16:23,240 --> 00:16:24,450
!جغرافية

269
00:16:25,310 --> 00:16:26,600
!فيزياء

270
00:16:27,340 --> 00:16:28,550
!وصمة

271
00:16:29,390 --> 00:16:31,010
!ماريمبا

272
00:16:42,310 --> 00:16:44,090
خفافيش...؟

273
00:16:46,830 --> 00:16:49,760
...أ-أتساءل كم يمتدّ هذا الممرّ

274
00:16:55,040 --> 00:16:56,700
.أسمع شيئًا

275
00:16:59,580 --> 00:17:02,000
!لا شيء يخيفني

276
00:17:04,590 --> 00:17:05,620
!لنذهب إلى هناك

277
00:17:13,270 --> 00:17:15,260
.لن تأتيك المساعدة يا نيكو روبين

278
00:17:17,640 --> 00:17:22,340
!فهم لا يعرفون طريق بوّابات العدالة من الأساس

279
00:17:39,820 --> 00:17:42,290
!اخرج! يا نذل الحمامة

280
00:17:42,780 --> 00:17:45,290
!أهو من هذا الطّريق؟

281
00:17:47,750 --> 00:17:49,540
!أم ذاك؟

282
00:17:51,790 --> 00:17:57,130
!من أيّ طريق؟

283
00:17:57,130 --> 00:17:58,590
.ويحي

284
00:17:58,770 --> 00:18:01,680
!ذاك؟

285
00:18:03,880 --> 00:18:05,600
!من أيّ طريق...؟

286
00:18:06,350 --> 00:18:08,480
!أيّ طريق؟

287
00:18:08,850 --> 00:18:12,320
!أمن هذا الطّريق؟

288
00:18:16,980 --> 00:18:19,570
!من هذا الطّريق! روبين

289
00:18:22,720 --> 00:18:25,450
.حتّى هو لا يجدر أن يتبعنا حتّى هنا

290
00:18:30,210 --> 00:18:31,690
.إنّها غرفة غريبة

291
00:18:32,920 --> 00:18:35,420
.يجب أن أفعل هذا ثمّ هذا... ثمّ هذا هكذا

292
00:18:37,100 --> 00:18:38,640
.أتساءل ما الّذي يفعله

293
00:18:54,730 --> 00:18:56,990
!افتحي أيّتها البوّابات

294
00:19:04,630 --> 00:19:05,930
...عجيب

295
00:19:12,080 --> 00:19:14,590
...هذا سيّئ... قبل أن أقاتل

296
00:19:14,940 --> 00:19:17,010
!أين المطبخ؟

297
00:19:17,390 --> 00:19:19,210
!المدفع النّفّاث

298
00:19:21,110 --> 00:19:23,900
بسبب استخدامي لقنّينة ونصف
،من الكولا في المدفع النّفّاث

299
00:19:23,900 --> 00:19:26,640
!فقد استخدمت أكثر من قنّينتين اليوم

300
00:19:27,070 --> 00:19:30,870
لا أستطيع قتال السّي بي 9
!ما لم أملأ القنّينات الثّلاث

301
00:19:32,740 --> 00:19:34,310
!تبدو المنطقة كمطبخ

302
00:19:41,130 --> 00:19:44,490
...تشابابابابا

303
00:19:44,750 --> 00:19:46,570
!أنا فوكورو الصّامت

304
00:19:46,570 --> 00:19:48,410
!أحبّ الشّائعات

305
00:19:48,930 --> 00:19:50,460
هل تريد المفتاح؟

306
00:19:50,460 --> 00:19:51,470
!سحقًا

307
00:19:51,470 --> 00:19:53,120
!لم أُعِد ملء الكولا خاصّتي بعد

308
00:19:53,400 --> 00:19:54,720
!...تشابا

309
00:19:59,790 --> 00:20:03,320
.أتساءل ما هذا الرّواق الشّبيه بالدّيماس

310
00:20:07,350 --> 00:20:09,350
!يويوي

311
00:20:09,860 --> 00:20:13,230
!أيّتها القرصانة اللّعينة

312
00:20:13,410 --> 00:20:19,030
!هلاكك محتوم الآن بعد أن أمسكتك هنا

313
00:20:19,500 --> 00:20:22,980
...مهلاً

314
00:20:22,980 --> 00:20:27,450
!...لحظة

315
00:20:29,700 --> 00:20:30,790
!يويوي

316
00:20:35,330 --> 00:20:36,530
...يا له من شخص صاخب

317
00:20:45,380 --> 00:20:47,220
.لا أحد هنا

318
00:20:50,910 --> 00:20:52,130
.ولا هنا

319
00:20:54,650 --> 00:20:55,860
.ولا هنا أيضًا

320
00:20:58,290 --> 00:20:59,520
.حسنًا، لا أحد هنا

321
00:21:00,430 --> 00:21:02,990
!ما الخطب؟ جميع الأماكن خالية

322
00:21:03,960 --> 00:21:05,450
.لا بأس إلّم يكن أحد في الجوار

323
00:21:11,490 --> 00:21:13,580
...لا بدّ أنّهم خافوا منّي

324
00:21:16,060 --> 00:21:17,580
!أحدهم هنا

325
00:21:23,100 --> 00:21:24,670
...إنّه نائم

326
00:21:25,450 --> 00:21:27,400
أهو فرد من السّي بي 9 أيضًا؟

327
00:21:29,030 --> 00:21:32,770
!إ-إنّه ينام والمفتاح أمامه مباشرةً

328
00:21:32,780 --> 00:21:37,690
!أوليست هذه فرصة ذهبيّة؟

329
00:21:37,900 --> 00:21:39,730
!ماذا عن هذه الغرفة؟

330
00:21:42,430 --> 00:21:44,010
...سحقًا

331
00:21:44,620 --> 00:21:46,670
.لا أحد هنا أيضًا

332
00:21:55,300 --> 00:21:57,210
.اعتبر البيت بيتك رجاءً

333
00:21:59,420 --> 00:22:02,880
هل أحضّر لك... بعض الشّاي؟

334
00:22:17,460 --> 00:22:19,480
!رجاءً

335
00:22:29,450 --> 00:22:31,950
هل سحبت سيوفك من الآن؟

336
00:22:33,550 --> 00:22:36,910
.نعم، بما أنّها متعطّشة للدّماء

337
00:22:45,180 --> 00:22:47,630
!عجبًا! من أين سقطت يا زورو؟

338
00:22:47,630 --> 00:22:50,170
!ما الّذي تفعله مع ذئب؟

339
00:22:50,170 --> 00:22:51,760
.وأنت مع زرافة

340
00:22:51,760 --> 00:22:54,720
.هذا يعني أنّ كليهما يملكان قوى فاكهة الشّيطان إذًا

341
00:22:54,720 --> 00:22:56,640
!ما قصّة السّي بي 9؟

342
00:22:56,640 --> 00:23:00,110
!مهلاً، مهلاً... ما هذا المكان؟! حديقة حيوانات؟

343
00:23:00,440 --> 00:23:01,810
:في الحلقة القادمة من وان بيس

344
00:23:01,810 --> 00:23:05,480
"!قوى فاكهة الشّيطان! تحوّل كاكو وجابرا"

345
00:23:05,620 --> 00:23:08,060
!ملك القراصنة، لن يكون إلاّ أنا

346
00:23:10,030 --> 00:23:15,040
نلقاكم في الحلقة القادمة