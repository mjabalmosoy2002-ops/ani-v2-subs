1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:28,510 --> 00:02:29,610
...تلك

33
00:02:29,610 --> 00:02:31,530
...مهلاً... لا تقل لّي

34
00:02:34,500 --> 00:02:37,770
!...إنّها مخطّطات السّلاح العتيق بلوتون

35
00:02:38,240 --> 00:02:39,870
.إنّها هي بعينها

36
00:02:40,080 --> 00:02:41,440
هل تصدّقني؟

37
00:02:46,620 --> 00:02:48,740
.يا سباندا

38
00:02:48,880 --> 00:02:52,840
...ما خاطر توم-سان وأيسبرغ بحياتهما لحمايته

39
00:02:52,840 --> 00:02:54,200
!سلّمها لي بسرعة

40
00:02:54,200 --> 00:02:57,300
...رغبة المهندس المعماريّ لهذا السّلاح

41
00:02:57,300 --> 00:03:00,350
أي، إن وقع السّلاح العتيق في أيدي غبيّ مثلك

42
00:03:01,160 --> 00:03:03,810
،وبدأ استخدامه بغرض التّسبّب في المشاكل

43
00:03:03,810 --> 00:03:07,180
.فسيرغب حينها ببناء سلاح آخر لإيقاف الأوّل

44
00:03:07,990 --> 00:03:12,300
صحيحٌ أنّك تستطيع إحياء السّلاح
.العتيق إن استخدمت نيكو روبين

45
00:03:12,760 --> 00:03:14,740
،حتّى إن كانت لا تريد مساعدتك

46
00:03:14,740 --> 00:03:17,280
،ما دام يُمكن استخدامها

47
00:03:17,500 --> 00:03:19,150
.فهي خطيرة

48
00:03:19,330 --> 00:03:25,290
لكنّها تملك أصدقاء مستعدّون
.للمخاطرة بحياتهم لإنقاذها

49
00:03:25,640 --> 00:03:26,900
...لذا سوف

50
00:03:28,290 --> 00:03:29,950
.أراهن

51
00:03:47,010 --> 00:03:48,980
!أيّها الوغد! ما الّذي تفعله؟

52
00:03:50,110 --> 00:03:51,410
!تحوّلت إلى رماد

53
00:03:53,800 --> 00:03:57,920
.والآن لم تعد هناك قوّة لمواجهة السّلاح العتيق

54
00:03:58,130 --> 00:04:02,360
إلّم يحدث شيء وسقطت نيكو روبين
.بين أيديكم، سيكون ذلك بلا فائدة

55
00:04:02,550 --> 00:04:05,060
...لكن إن فاز طاقم قبّعة القشّ

56
00:04:05,620 --> 00:04:09,860
.فلن يظلّ لكم شيء على الإطلاق

57
00:04:10,090 --> 00:04:13,830
.راهنتُ على فوزهم

58
00:04:14,260 --> 00:04:16,320
...كاتي فلام

59
00:04:16,970 --> 00:04:19,310
...كيف تجرّأت

60
00:04:20,700 --> 00:04:23,790
!على حرق مخطّطاتي؟

61
00:04:33,600 --> 00:04:34,600
!أخي

62
00:04:35,100 --> 00:04:39,560
!أخي يسقط إلى الشّلاّل

63
00:04:39,770 --> 00:04:41,700
!فرانكي

64
00:04:41,700 --> 00:04:43,270
!أيّها القراصنة

65
00:04:44,770 --> 00:04:46,500
!ما ذلك؟

66
00:04:46,500 --> 00:04:48,690
!اقفزوا بكلّ قوّتكم إلى الشّلاّل

67
00:04:52,660 --> 00:04:54,620
!ر-رجل الصّاروخ؟

68
00:05:00,800 --> 00:05:02,500
!إنّه يطير ثانيةً

69
00:05:08,830 --> 00:05:11,630
هذا يعيد الذّكريات، أليس كذلك يا توم-سان؟

70
00:05:14,630 --> 00:05:17,810
...أمّا بشأن مساعدة المدعوّ روجر

71
00:05:18,070 --> 00:05:21,430
!أنا فخور بذلك بعزم

72
00:05:21,690 --> 00:05:24,330
.أنا لوفي وأنا الرّجل الّذي سيصبح ملك القراصنة

73
00:05:24,330 --> 00:05:24,950
!حقًّا؟

74
00:05:24,950 --> 00:05:25,520
.نعم

75
00:05:27,080 --> 00:05:28,900
كان روجر

76
00:05:29,930 --> 00:05:32,790
غبيًّا مثله أيضًا، أليس كذلك؟

77
00:05:33,100 --> 00:05:36,890
.وساعدته كثيرًا

78
00:05:37,250 --> 00:05:38,910
.يبدو أنّنا لم نتعلّم درسنا

79
00:05:39,210 --> 00:05:44,470
.جميع عمّال توم يساعدون هذا الفتى القرصان

80
00:05:46,980 --> 00:05:50,880
كنتَ لتفعل المثل، أليس كذلك يا توم-سان؟

81
00:05:59,590 --> 00:06:01,220
!سنصطدم

82
00:06:01,750 --> 00:06:04,230
!سـ-سنُسحق

83
00:06:11,790 --> 00:06:16,620
!احصلوا على المفاتيح الخمسة’’
‘‘.قراصنة قبّعة القشّ ضدّ السّي بي 9

84
00:06:44,330 --> 00:06:45,890
!اهربوا

85
00:07:01,340 --> 00:07:02,290
...لقد أتوا

86
00:07:05,250 --> 00:07:06,710
!يويوي

87
00:07:10,920 --> 00:07:12,400
!لقد أتوا

88
00:07:12,400 --> 00:07:13,800
!سحقًا

89
00:07:13,800 --> 00:07:15,270
!تعالي معي

90
00:07:17,610 --> 00:07:20,800
ليتني أستطيع التّحرّر من أصفاد
...الحجر البحريّ هذه

91
00:07:23,170 --> 00:07:26,520
!إنّي أعطيكم كامل الحرّيّة أيّها السّي بي 9

92
00:07:27,270 --> 00:07:30,860
!أبرحوهم ضربًا هنا في برج القانون

93
00:07:33,080 --> 00:07:35,490
!أمنحكم الإذن بذبحهم

94
00:07:35,760 --> 00:07:38,090
!لوتشي! تعال معي

95
00:07:38,090 --> 00:07:40,490
!حماية حياتي هي أولى أوليّاتك

96
00:07:40,490 --> 00:07:41,640
!مفهوم؟

97
00:07:41,920 --> 00:07:43,080
!فانكفريد

98
00:07:55,420 --> 00:07:57,490
.حسنًا، ولد مطيع

99
00:08:00,940 --> 00:08:02,220
...فاكهة شيطان

100
00:08:02,680 --> 00:08:04,850
!أكل الفيل فاكهة شيطان بقوى سيوف؟

101
00:08:04,850 --> 00:08:07,070
.كلاّ، بل العكس

102
00:08:07,070 --> 00:08:09,310
.إنّه سيف تناول فاكهة الفيل

103
00:08:09,310 --> 00:08:10,770
.بعبارة أخرى، إنّه سيفٌ فيل

104
00:08:11,520 --> 00:08:15,870
أملك بحوزتي هذا السّيف القيّم
.بالإضافة إلى السّي بي 9

105
00:08:16,000 --> 00:08:19,600
،عندما أفكّر في الأمر بهدوء
.ليس هناك ما يخيفني

106
00:08:19,720 --> 00:08:22,190
!والآن، لنذهب إلى بوّابات العدالة

107
00:08:22,190 --> 00:08:25,990
حاول استرجاع هذه المرأة
!إن استطعت يا قبّعة القشّ

108
00:08:26,800 --> 00:08:28,590
!أخي فرانكي بخير

109
00:08:28,590 --> 00:08:32,270
!وصل طاقم قبّعة القشّ إلى برج القانون أخيرًا

110
00:08:32,270 --> 00:08:34,460
!لم يعد أخونا حبيسًا

111
00:08:34,750 --> 00:08:36,350
!ويبدو أنّه سينضمّ للقتال

112
00:08:36,350 --> 00:08:38,300
!هذا صحيح! هذه من شيمه

113
00:08:38,600 --> 00:08:41,130
!عليك بهم يا أخي

114
00:08:41,390 --> 00:08:43,890
!انطلق! يا قبّعة القشّ

115
00:08:44,460 --> 00:08:46,640
.إنّنا نعهد لك بالباقي يا قبّعة القشّ

116
00:08:50,080 --> 00:08:52,010
!هل أنتم بخير؟

117
00:08:52,010 --> 00:08:54,020
!العجوز كوكورو؟! الصّغيران؟

118
00:08:54,020 --> 00:08:59,490
ماذا دهاكما تأتيان إلى هنا جالبين
!شيئًا خطيرًا كالرّجل الصّاروخ؟

119
00:08:59,690 --> 00:09:01,960
...صـ-صحيحٌ أنّه أنقذني، لكن

120
00:09:02,080 --> 00:09:04,160
!أيّتها العجوز! تماسكي

121
00:09:04,370 --> 00:09:06,930
!أترجّاك! لا تموتي

122
00:09:06,930 --> 00:09:09,020
!لا تموتي

123
00:09:21,280 --> 00:09:22,340
.نزف أنفي

124
00:09:22,710 --> 00:09:25,510
كيف أمكنكم النّجاة من اصطدام
!كهذا بنزيف أنف فقط؟

125
00:09:26,360 --> 00:09:28,640
!حسنًا! وصلنا

126
00:09:30,090 --> 00:09:31,020
!...يا قبّعة القشّ

127
00:09:31,270 --> 00:09:32,360
!مرحبًا

128
00:09:32,360 --> 00:09:34,730
!شكرًا يا جدّتي الوحش

129
00:09:34,910 --> 00:09:37,540
!يا رفاق! انهضوا بسرعة

130
00:09:37,540 --> 00:09:39,220
!لم يكن ذلك شيئًا

131
00:09:39,900 --> 00:09:42,410
.أنت مطّاطيّ. فلا تقارنّا بك

132
00:09:42,660 --> 00:09:46,000
اضطررنا نحن البشر من لحم ودم
.أن نقتحم المكان بتلك الطّريقة

133
00:09:46,150 --> 00:09:47,830
هل تظنّ أنّنا بخير...؟

134
00:09:48,690 --> 00:09:53,840
!محال

135
00:09:53,840 --> 00:09:55,180
.نعم، إنّهم بخير جميعًا

136
00:09:55,400 --> 00:09:58,000
...أنتم غريبو الأطوار جميعًا أيضًا، لذا

137
00:09:58,210 --> 00:09:59,590
.فقط للأمانة

138
00:09:59,900 --> 00:10:01,530
!ثمّة درج في الأعلى

139
00:10:01,530 --> 00:10:03,430
!لنسرع ونلحق بروبين

140
00:10:11,080 --> 00:10:12,130
.انتظروا

141
00:10:14,160 --> 00:10:15,230
!ما ذلك؟

142
00:10:15,520 --> 00:10:17,220
...تشابابابا

143
00:10:17,220 --> 00:10:19,830
.قاموا بغزونا

144
00:10:19,950 --> 00:10:21,750
حتّى إن ذهبتم إلى الغرفة
،الّتي رأيتم قبل قليل

145
00:10:21,750 --> 00:10:23,850
،ما عادت نيكو روبين هناك

146
00:10:23,850 --> 00:10:26,070
.لأنّ لوتشي أخذتها إلى بوّابات العدالة

147
00:10:26,600 --> 00:10:27,450
!ماذا؟

148
00:10:27,670 --> 00:10:30,130
.ورئيسنا أيضًا

149
00:10:32,550 --> 00:10:33,600
!هكذا إذًا؟

150
00:10:33,600 --> 00:10:35,410
.شكرًا على إخبارنا بهذه المعلومات القيّمة

151
00:10:36,050 --> 00:10:38,580
...تشابابا... زلّ لساني

152
00:10:39,100 --> 00:10:40,800
.يا له من شخص مضحك

153
00:10:40,800 --> 00:10:42,030
...أيًّا كان

154
00:10:42,030 --> 00:10:44,150
،إنّهم متّجهون إلى هناك الآن

155
00:10:44,150 --> 00:10:46,140
،لكنّي لن أدلّكم على الطّريق إلى هناك

156
00:10:46,140 --> 00:10:48,920
كما أنّنا نحن، السّي بي 9
.لن ندعهم تتبعوهم أيضًا

157
00:10:49,030 --> 00:10:52,770
.لدينا أمر بالقضاء عليكم

158
00:10:53,000 --> 00:10:54,770
أمر بالقضاء علينا...؟

159
00:10:54,960 --> 00:10:58,050
،ما لم تستطيعوا هزيمتنا

160
00:10:58,050 --> 00:11:00,770
.لن تتمكّنوا من تحرير نيكو روبين

161
00:11:01,080 --> 00:11:01,950
.نعم

162
00:11:02,170 --> 00:11:04,440
لست بحاجة لإخبارنا ذلك
.لأنّنا سنهزمكم على كلّ حال

163
00:11:04,440 --> 00:11:05,670
...تشابابا

164
00:11:05,670 --> 00:11:07,840
.يا له من شخص شجاع

165
00:11:07,970 --> 00:11:09,990
.لكن دعني أخبركم بشيء أخير

166
00:11:10,280 --> 00:11:11,950
.ماذا؟! افعل ما يحلو لك

167
00:11:12,280 --> 00:11:14,540
.شكرًا

168
00:11:15,100 --> 00:11:16,870
.إذًا سأحدّثكم بصراحة

169
00:11:17,530 --> 00:11:19,130
!انظروا إلى هذا

170
00:11:19,350 --> 00:11:20,470
مفتاح؟

171
00:11:20,650 --> 00:11:21,590
!مفتاح ماذا؟

172
00:11:22,390 --> 00:11:27,880
إنّه مفتاح فكّ أصفاد الحجر البحريّ
!الّتي تُكبّل نيكو روبين

173
00:11:27,880 --> 00:11:29,310
الحجر البحريّ؟

174
00:11:29,310 --> 00:11:32,800
.إنّه حجر يُبطل قوى فاكهة الشّيطان

175
00:11:32,940 --> 00:11:35,600
سمعتُ أنّ تأثيره يضاهي تأثير سقوط
.حاملي قوّة فاكهة الشيّطان في البحر

176
00:11:36,160 --> 00:11:39,410
،إذًا لهذا لا تقاتل روبين الآن

177
00:11:39,410 --> 00:11:40,940
.على الرّغم من مدى قوّتها

178
00:11:40,940 --> 00:11:42,060
.نعم

179
00:11:42,350 --> 00:11:44,060
،عادةً

180
00:11:44,060 --> 00:11:47,360
هي ليست ضعيفة لدرجة أن تظلّ أسيرة
.لدى أشخاص كأولئك بدون أيّ مقاومة

181
00:11:47,730 --> 00:11:49,570
.لا بدّ أنّها تشعر بالإحباط

182
00:11:49,810 --> 00:11:51,120
.فهمت

183
00:11:51,120 --> 00:11:55,490
،حتّى إن حالفكم الحظّ وأنقذتم نيكو روبين

184
00:11:55,490 --> 00:11:58,130
،بما أنّ الحجر البحريّ صلب كالماسّ

185
00:11:58,130 --> 00:12:01,330
.فستظلّ مكبّلة به إلى الأبد

186
00:12:02,270 --> 00:12:03,730
...تشابابا

187
00:12:03,730 --> 00:12:05,170
.زلّ لساني ثانيةً

188
00:12:05,690 --> 00:12:07,510
.إنّه مضحك بحقّ

189
00:12:07,740 --> 00:12:11,220
،إن كنتم لا تمانعون ذلك
.بادروا في إنقاذ نيكو روبين

190
00:12:11,820 --> 00:12:14,180
!تشابابابابا

191
00:12:14,580 --> 00:12:15,790
...إذًا

192
00:12:16,570 --> 00:12:19,520
!أعطه لنا

193
00:12:23,400 --> 00:12:26,070
.يبدو أنّه يستطيع استخدام تلك التّقنية أيضًا

194
00:12:26,580 --> 00:12:28,190
.لا تتهوّر

195
00:12:28,540 --> 00:12:31,790
.لم أقل أنّ هذا هو المفتاح الصّحيح

196
00:12:31,790 --> 00:12:34,200
!ماذا؟

197
00:12:35,610 --> 00:12:38,700
قد يكون مفتاح

198
00:12:38,700 --> 00:12:41,600
.أصفاد أخرى

199
00:12:41,710 --> 00:12:43,930
!تشابابا بابا

200
00:12:44,620 --> 00:12:46,630
يوجد على هذا البرج

201
00:12:46,990 --> 00:12:51,860
.خمسة أعضاء من السّي بي 9، بمن فيهم أنا

202
00:12:51,860 --> 00:12:55,480
لكلٍّ مفتاحه

203
00:12:53,080 --> 00:12:55,480
!واحد، اثنان، هيّا

204
00:12:55,480 --> 00:12:57,920
!واحد، اثنان، سيّئ

205
00:12:55,480 --> 00:12:59,390
.وينتظرونكم

206
00:12:59,650 --> 00:13:02,560
إذًا إلى أن نهزمكم جميعًا ونأخذ المفاتيح

207
00:13:02,560 --> 00:13:04,770
،ونجرّبها على أصداف روبين

208
00:13:04,770 --> 00:13:06,980
!لن نعرف أيّها المفتاح الصّحيح؟

209
00:13:06,980 --> 00:13:09,360
يا للغباء... هل تماطلون؟

210
00:13:09,740 --> 00:13:11,310
،بينما نحن نقاتل

211
00:13:11,310 --> 00:13:14,450
تحاولون أخذ روبين-تشان
!إلى بوّابات العدالة، أليس كذلك؟

212
00:13:14,910 --> 00:13:17,040
!هو كذلك

213
00:13:17,040 --> 00:13:19,410
...زلّ لساني ثانيةً

214
00:13:19,660 --> 00:13:21,870
.يجب أن نمنح الأولويّة للّحاق بروبين بسرعة

215
00:13:22,240 --> 00:13:26,770
.سنسترجع روبين أوّلاً ثمّ نقلق حيال المفتاح

216
00:13:27,000 --> 00:13:29,390
!لنتجاهل غريب الأطوار ذاك ونسرع

217
00:13:29,390 --> 00:13:30,130
!تشابا

218
00:13:30,700 --> 00:13:32,060
!تشابابا

219
00:13:32,060 --> 00:13:34,220
.أنت ذكيّة

220
00:13:34,440 --> 00:13:36,490
،لكن إن فعلتم ذلك

221
00:13:36,760 --> 00:13:41,680
!سأرمي هذا المفتاح إلى البحر! تشابابا

222
00:13:43,690 --> 00:13:46,560
.إنّنا نمنحكم فرصة

223
00:13:46,560 --> 00:13:47,150
.إلى اللّقاء

224
00:13:47,620 --> 00:13:49,710
!انتظر أيّها النّذل

225
00:13:49,710 --> 00:13:50,820
!انتظر

226
00:13:51,800 --> 00:13:53,360
!انتظر أنت

227
00:13:55,220 --> 00:13:57,500
!توقّف! فقط قليلاً

228
00:13:57,500 --> 00:14:00,840
!انتظر إلى أن نقرّر ما سيفعله كلٌّ منّا

229
00:14:01,260 --> 00:14:03,920
!أفلتني

230
00:14:04,030 --> 00:14:06,230
.اهدأ يا قبّعة القشّ

231
00:14:06,430 --> 00:14:09,170
!دعني

232
00:14:06,940 --> 00:14:09,170
هل لوتشي هو صاحب الحمامة؟

233
00:14:09,390 --> 00:14:10,960
.نعم، ذاك هو

234
00:14:11,350 --> 00:14:14,050
،إن كان مع روبين-تشان

235
00:14:14,730 --> 00:14:17,010
.فيجب أن ندع لوفي يتقدّم على الأقلّ

236
00:14:17,300 --> 00:14:18,420
.لوفي

237
00:14:18,600 --> 00:14:20,850
.على أيّ حال، أوسع صاحب الحمامة ذاك ضربًا

238
00:14:21,170 --> 00:14:23,270
!دعني! دعني

239
00:14:23,660 --> 00:14:26,200
.نحن ستّة باستثناء لوفي

240
00:14:26,490 --> 00:14:28,980
.وقال أنّ هنالك خمسة أعضاء من السّي بي 9 هنا

241
00:14:29,330 --> 00:14:33,240
.سنأخذ مفتاح أصفاد روبين-تشان منهم ونلحق بلوفي

242
00:14:34,280 --> 00:14:36,860
.إن عبرت روبين-كن من البوّابات، فسينتهي الأمر

243
00:14:37,170 --> 00:14:39,540
!إنّنا نسابق الوقت

244
00:14:39,830 --> 00:14:42,160
!خسارتنا أمامهم تعني خسارتنا للوقت

245
00:14:44,770 --> 00:14:47,000
!جميعًا! اقضوا عليهم وإن كلّفكم ذلك حياتكم

246
00:14:47,000 --> 00:14:47,970
!أجل

247
00:14:47,970 --> 00:14:50,600
!بالتّوفيق

248
00:15:05,480 --> 00:15:07,940
!دعني! دعني

249
00:15:08,370 --> 00:15:10,850
.نحن ستّة باستثناء لوفي

250
00:15:11,200 --> 00:15:13,610
.وقال أنّ هنالك خمسة أعضاء من السّي بي 9 هنا

251
00:15:14,080 --> 00:15:17,960
.سنأخذ مفتاح أصفاد روبين-تشان منهم ونلحق بلوفي

252
00:15:19,220 --> 00:15:21,410
.إن عبرت روبين-كن من البوّابات، فسينتهي الأمر

253
00:15:21,840 --> 00:15:24,370
!إنّنا نسابق الوقت

254
00:15:24,640 --> 00:15:26,660
!خسارتنا أمامهم تعني خسارتنا للوقت

255
00:15:29,570 --> 00:15:31,630
!جميعًا! اقضوا عليهم وإن كلّفكم ذلك حياتكم

256
00:15:31,630 --> 00:15:32,810
!أجل

257
00:15:32,810 --> 00:15:35,590
!بالتّوفيق

258
00:15:36,190 --> 00:15:39,840
!يا رفاقنا القراصنة

259
00:15:44,490 --> 00:15:46,620
تشيمني؟ غونبي؟

260
00:15:46,620 --> 00:15:48,640
هل ذهبا؟

261
00:15:48,930 --> 00:15:51,650
!كانوا هناك قبل قليل فحسب

262
00:15:52,060 --> 00:15:53,980
!أنا واثق أنّني سأصادفهم في مكان ما

263
00:15:54,260 --> 00:15:57,440
!لن أدعكم تذهبون إلى بوّابات العدالة

264
00:15:57,440 --> 00:15:59,990
!روبين

265
00:16:00,670 --> 00:16:02,780
!ممرّ سرّيّ

266
00:16:02,780 --> 00:16:06,950
!ممرّ سرّيّ! ممرّ سرّيّ

267
00:16:06,950 --> 00:16:09,240
!ممر سرّيّ

268
00:16:09,240 --> 00:16:10,450
!جغرافية

269
00:16:11,310 --> 00:16:12,600
!فيزياء

270
00:16:13,340 --> 00:16:14,550
!وصمة

271
00:16:15,390 --> 00:16:17,010
!ماريمبا

272
00:16:28,310 --> 00:16:30,090
خفافيش...؟

273
00:16:32,830 --> 00:16:35,760
...أ-أتساءل كم يمتدّ هذا الممرّ

274
00:16:41,040 --> 00:16:42,700
.أسمع شيئًا

275
00:16:45,580 --> 00:16:48,000
!لا شيء يخيفني

276
00:16:50,590 --> 00:16:51,620
!لنذهب إلى هناك

277
00:16:59,270 --> 00:17:01,260
.لن تأتيك المساعدة يا نيكو روبين

278
00:17:03,640 --> 00:17:08,340
!فهم لا يعرفون طريق بوّابات العدالة من الأساس

279
00:17:25,820 --> 00:17:28,290
!اخرج! يا نذل الحمامة

280
00:17:28,780 --> 00:17:31,290
!أهو من هذا الطّريق؟

281
00:17:33,750 --> 00:17:35,540
!أم ذاك؟

282
00:17:37,790 --> 00:17:43,130
!من أيّ طريق؟

283
00:17:43,130 --> 00:17:44,590
.ويحي

284
00:17:44,770 --> 00:17:47,680
!ذاك؟

285
00:17:49,880 --> 00:17:51,600
!من أيّ طريق...؟

286
00:17:52,350 --> 00:17:54,480
!أيّ طريق؟

287
00:17:54,850 --> 00:17:58,320
!أمن هذا الطّريق؟

288
00:18:02,980 --> 00:18:05,570
!من هذا الطّريق! روبين

289
00:18:08,720 --> 00:18:11,450
.حتّى هو لا يجدر أن يتبعنا حتّى هنا

290
00:18:16,210 --> 00:18:17,690
.إنّها غرفة غريبة

291
00:18:18,920 --> 00:18:21,420
.يجب أن أفعل هذا ثمّ هذا... ثمّ هذا هكذا

292
00:18:23,100 --> 00:18:24,640
.أتساءل ما الّذي يفعله

293
00:18:40,730 --> 00:18:42,990
!افتحي أيّتها البوّابات

294
00:18:50,630 --> 00:18:51,930
...عجيب

295
00:18:58,080 --> 00:19:00,590
...هذا سيّئ... قبل أن أقاتل

296
00:19:00,940 --> 00:19:03,010
!أين المطبخ؟

297
00:19:03,390 --> 00:19:05,210
!المدفع النّفّاث

298
00:19:07,110 --> 00:19:09,900
بسبب استخدامي لقنّينة ونصف
،من الكولا في المدفع النّفّاث

299
00:19:09,900 --> 00:19:12,640
!فقد استخدمت أكثر من قنّينتين اليوم

300
00:19:13,070 --> 00:19:16,870
لا أستطيع قتال السّي بي 9
!ما لم أملأ القنّينات الثّلاث

301
00:19:18,740 --> 00:19:20,310
!تبدو المنطقة كمطبخ

302
00:19:27,130 --> 00:19:30,490
...تشابابابابا

303
00:19:30,750 --> 00:19:32,570
!أنا فوكورو الصّامت

304
00:19:32,570 --> 00:19:34,410
!أحبّ الشّائعات

305
00:19:34,930 --> 00:19:36,460
هل تريد المفتاح؟

306
00:19:36,460 --> 00:19:37,470
!سحقًا

307
00:19:37,470 --> 00:19:39,120
!لم أُعِد ملء الكولا خاصّتي بعد

308
00:19:39,400 --> 00:19:40,720
!...تشابا

309
00:19:45,790 --> 00:19:49,320
.أتساءل ما هذا الرّواق الشّبيه بالدّيماس

310
00:19:53,350 --> 00:19:55,350
!يويوي

311
00:19:55,860 --> 00:19:59,230
!أيّتها القرصانة اللّعينة

312
00:19:59,410 --> 00:20:05,030
!هلاكك محتوم الآن بعد أن أمسكتك هنا

313
00:20:05,500 --> 00:20:08,980
...مهلاً

314
00:20:08,980 --> 00:20:13,450
!...لحظة

315
00:20:15,700 --> 00:20:16,790
!يويوي

316
00:20:21,330 --> 00:20:22,530
...يا له من شخص صاخب

317
00:20:31,380 --> 00:20:33,220
.لا أحد هنا

318
00:20:36,910 --> 00:20:38,130
.ولا هنا

319
00:20:40,650 --> 00:20:41,860
.ولا هنا أيضًا

320
00:20:44,290 --> 00:20:45,520
.حسنًا، لا أحد هنا

321
00:20:46,430 --> 00:20:48,990
!ما الخطب؟ جميع الأماكن خالية

322
00:20:49,960 --> 00:20:51,450
.لا بأس إلّم يكن أحد في الجوار

323
00:20:57,490 --> 00:20:59,580
...لا بدّ أنّهم خافوا منّي

324
00:21:02,060 --> 00:21:03,580
!أحدهم هنا

325
00:21:09,100 --> 00:21:10,670
...إنّه نائم

326
00:21:11,450 --> 00:21:13,400
أهو فرد من السّي بي 9 أيضًا؟

327
00:21:15,030 --> 00:21:18,770
!إ-إنّه ينام والمفتاح أمامه مباشرةً

328
00:21:18,780 --> 00:21:23,690
!أوليست هذه فرصة ذهبيّة؟

329
00:21:23,900 --> 00:21:25,730
!ماذا عن هذه الغرفة؟

330
00:21:28,430 --> 00:21:30,010
...سحقًا

331
00:21:30,620 --> 00:21:32,670
.لا أحد هنا أيضًا

332
00:21:41,300 --> 00:21:43,210
.اعتبر البيت بيتك رجاءً

333
00:21:45,420 --> 00:21:48,880
هل أحضّر لك... بعض الشّاي؟

334
00:22:03,460 --> 00:22:05,480
!رجاءً

335
00:22:15,450 --> 00:22:17,950
هل سحبت سيوفك من الآن؟

336
00:22:19,550 --> 00:22:22,910
.نعم، بما أنّها متعطّشة للدّماء

337
00:22:31,180 --> 00:22:33,630
!عجبًا! من أين سقطت يا زورو؟

338
00:22:33,630 --> 00:22:36,170
!ما الّذي تفعله مع ذئب؟

339
00:22:36,170 --> 00:22:37,760
.وأنت مع زرافة

340
00:22:37,760 --> 00:22:40,720
.هذا يعني أنّ كليهما يملكان قوى فاكهة الشّيطان إذًا

341
00:22:40,720 --> 00:22:42,640
!ما قصّة السّي بي 9؟

342
00:22:42,640 --> 00:22:46,110
!مهلاً، مهلاً... ما هذا المكان؟! حديقة حيوانات؟

343
00:22:46,440 --> 00:22:47,810
:في الحلقة القادمة من وان بيس

344
00:22:47,810 --> 00:22:51,480
"!قوى فاكهة الشّيطان! تحوّل كاكو وجابرا"

345
00:22:51,620 --> 00:22:54,060
!ملك القراصنة، لن يكون إلاّ أنا

346
00:22:56,030 --> 00:23:01,040
نلقاكم في الحلقة القادمة