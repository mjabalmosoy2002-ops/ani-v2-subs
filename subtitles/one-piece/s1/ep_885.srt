1
00:02:42,840 --> 00:02:49,650
يمرّ عصر القراصنة العظيم بموجة تغيّرات
.فاقت توقّعات حكومة العالم

2
00:02:51,510 --> 00:02:58,490
ونجد في قلب هذه الموجة العاتية
...وأكثر من يجلب الانتباه

3
00:03:00,690 --> 00:03:02,620
!مونكي د. لوفي

4
00:03:03,690 --> 00:03:05,510
!وقراصنة قبّعة القشّ

5
00:03:08,290 --> 00:03:12,170
ومن أجل التّأقلم مع عصر
،القراصنة العظيم المضطرب

6
00:03:12,170 --> 00:03:16,630
يحضر خمسون قائدًا القمّة العالميّة
.كلّ خمس سنوات

7
00:03:17,370 --> 00:03:20,720
.تُعرف بـ"ليفيلي" وهي توشك أن تبدأ

8
00:03:25,210 --> 00:03:29,360
.إنّ الأوقات تتغيّر بشكل كبير الآن

9
00:03:33,800 --> 00:03:38,730
!ظُلمة الأرض المقدّسة"
"!قبّعة القشّ العملاقة الغامضة

10
00:03:52,110 --> 00:03:56,010
كان لوفي-سان يأكل الكثير، صحيح؟

11
00:03:56,010 --> 00:04:00,390
!نعم! كانت له شهيّة كبيرة في دريسروزا

12
00:04:00,710 --> 00:04:03,200
.وكذلك في قصر ريوغو

13
00:04:03,200 --> 00:04:06,390
.إنّهنّ مستمتعات بوقتهنّ –
.بالفعل –

14
00:04:06,390 --> 00:04:09,520
من الجيّد أن يكون أولئك الّذين
سيقودون بلدانهم في المستقبلِ

15
00:04:09,520 --> 00:04:12,020
.أصدقاءَ متآخين

16
00:04:12,020 --> 00:04:14,770
.لكنّها تظلّ رابطة غريبة

17
00:04:14,770 --> 00:04:19,360
نعم، .وعلينا شكر قبّعة القشّ
.والبقيّة على ذلك

18
00:04:20,310 --> 00:04:24,360
!عفوًا! ألستِ ريبيكّا من دريسروزا؟

19
00:04:25,770 --> 00:04:27,120
!أنا أعرفه

20
00:04:28,110 --> 00:04:29,770
!هذا أنا ساي

21
00:04:29,770 --> 00:04:33,370
!لم أتوقّع أن أراك ثانية بهذه السّرعة

22
00:04:33,790 --> 00:04:36,500
!هل أنت بخير؟ –
!في أحسن حال –

23
00:04:36,740 --> 00:04:39,900
...إنّه عضو من بحريّة هابّو لبلاد كانو

24
00:04:39,900 --> 00:04:44,220
...سمعتُ أنّ تشين جاو تنازل كقائد

25
00:04:44,220 --> 00:04:46,510
.إنّه القائد الجديد

26
00:04:47,340 --> 00:04:48,220
!ساي

27
00:04:49,170 --> 00:04:53,060
!مرحبًا يا أخي! أرى أنّك هنا أيضًا يا ليو

28
00:04:53,060 --> 00:04:54,770
!أنا حارس شخصيّ سرّيّ

29
00:04:55,970 --> 00:04:58,080
!يُعتمد عليك بالفعل

30
00:04:58,080 --> 00:04:58,950
!بالفعل

31
00:04:59,390 --> 00:05:01,280
أهو صديقك؟

32
00:05:01,280 --> 00:05:05,150
!تشاركنا أكواب ساكي مع لوفيلاند والبقيّة

33
00:05:05,150 --> 00:05:07,070
!كلانا تابع له

34
00:05:09,830 --> 00:05:12,330
!إنّها الأميرة فيفي

35
00:05:13,500 --> 00:05:14,540
!وابول

36
00:05:16,870 --> 00:05:18,340
!غبيّة

37
00:05:21,380 --> 00:05:23,340
!لماذا أنت هنا؟

38
00:05:25,370 --> 00:05:29,970
،هذا غريب، صحيح؟ نعم
!أنا من أُرسلت محلّقًا في الهواء

39
00:05:29,970 --> 00:05:33,270
انتهى بي المطاف في بحر بعيد
!بسبب قبّعة القشّ لوفي

40
00:05:33,270 --> 00:05:36,270
!لكنّي عُدت

41
00:05:36,270 --> 00:05:39,770
هل تريدين معرفة كيف عاد عزيزي؟

42
00:05:40,140 --> 00:05:43,610
هل هو صديق للوفي-ساما أيضًا؟

43
00:05:43,610 --> 00:05:46,320
!لا، إنّه عدوّ لنا يا شيراهوشي

44
00:05:48,190 --> 00:05:51,240
هل الملك كوبرا ثقيل الدّم بخير؟

45
00:05:51,240 --> 00:05:57,930
،رأيتُه في حالة يُرثى لها قبل قليل
!لذلك كانت تلك سخرية فحسب

46
00:05:59,170 --> 00:06:01,460
!آه يا عزيزي

47
00:06:01,460 --> 00:06:05,960
!إنّك ممتع بشكل كبير
!وأنا الطّمّاعة في ثروتك أضحك بشدّة

48
00:06:09,130 --> 00:06:09,890
!وابول

49
00:06:11,680 --> 00:06:13,430
!كفاك هراءً

50
00:06:14,090 --> 00:06:17,230
...لا أصدّق أنّك صرت ملكًا ثانية

51
00:06:17,230 --> 00:06:20,100
.إذًا فهنالك بلاد فقيرة أخرى

52
00:06:22,060 --> 00:06:24,320
!لا بدّ أنّ حكومة العالم في تراجع

53
00:06:24,320 --> 00:06:27,270
!لماذا يودّون من هذا الأحمق أن ينضمّ لهم ثانية؟

54
00:06:28,060 --> 00:06:32,240
!دولتون! العجوز الشّمطاء
!ما زلتما حيّين؟

55
00:06:32,240 --> 00:06:35,620
ماذا؟ سألت كيف أحافظ على شبابي؟ –
!لم أسأل عن ذلك –

56
00:06:35,910 --> 00:06:39,500
!دولتون-سان! الدّكتور كوريها
!سُررت بلقائكما ثانية

57
00:06:39,500 --> 00:06:43,350
.مرحبًا يا فيفي-تشان
.صرتِ أكثر فخامة من ذي قبل

58
00:06:44,700 --> 00:06:46,300
هل أنت سعيدة؟

59
00:06:46,300 --> 00:06:48,790
،لو عرفتُ أنّك أميرة وقتها

60
00:06:48,790 --> 00:06:52,090
.لكنتُ جعلتكم تدفعون أتعابًا طبّيّة أعلى

61
00:06:52,630 --> 00:06:54,430
من هذان؟

62
00:06:54,430 --> 00:06:58,230
.قابلتُهما عندما كنتُ أبحر مع لوفي-سان والبقيّة

63
00:07:02,140 --> 00:07:07,830
مرضت نامي-سان في طريقنا إلى ألاباستا
،وكان علينا العثور على طبيب

64
00:07:08,390 --> 00:07:11,520
...لذلك توقّفنا في جزيرة شتويّة

65
00:07:14,410 --> 00:07:20,290
!انتبهوا أيّها القراصنة
!غادروا هذا المكان فورًا! حالاً

66
00:07:28,210 --> 00:07:29,010
!فيفي

67
00:07:33,510 --> 00:07:35,010
!...أيّها الـ

68
00:07:35,270 --> 00:07:36,350
!صوّبوا

69
00:07:39,100 --> 00:07:40,230
!لا! توقّف

70
00:07:40,620 --> 00:07:43,100
!لن يساعد القتال في شيء

71
00:07:43,420 --> 00:07:46,820
!أنا بخير! خدشَت ذراعي فحسب

72
00:07:48,520 --> 00:07:51,900
!في تلك الحالة، لن نرسو هنا

73
00:07:52,480 --> 00:07:54,810
لكن هل لنا بطبيب؟

74
00:07:55,570 --> 00:07:57,870
.صديقتنا تعاني من مرضٍ حرج

75
00:07:58,440 --> 00:08:00,920
!ساعدونا رجاءً! أترجّاكم

76
00:08:03,780 --> 00:08:04,780
!فيفي

77
00:08:05,620 --> 00:08:09,840
،إن دخلتم في قتال هنا
ما الّذي سيحدث لنامي-سان؟

78
00:08:13,960 --> 00:08:15,590
!استدعوا طبيبًا رجاءً

79
00:08:16,090 --> 00:08:18,100
!ساعدوا صديقتنا رجاءً

80
00:08:19,090 --> 00:08:21,010
.سأرشدكم إلى القرية

81
00:08:22,130 --> 00:08:23,490
.اتبعوني

82
00:08:30,730 --> 00:08:34,010
في ذلك الوقت، كانت الجزيرة الشّتويّة
تحت حكم وابول الظّالم

83
00:08:34,010 --> 00:08:36,080
،الّذي كان ملكًا عليها

84
00:08:36,080 --> 00:08:39,910
،ولكن ذات يوم، عندما هاجمها القراصنة

85
00:08:39,910 --> 00:08:42,340
.تخلّى عن البلاد بدل الدّفاع عنها

86
00:08:42,820 --> 00:08:46,800
،أمّا دولتون-سان الّذي كان يخدمه
.فقد حمى المواطنين

87
00:08:47,990 --> 00:08:53,260
لكنّ وابول الّذي انتظر حتّى يمرّ
،الغزو متظاهرًا أنّه قرصان

88
00:08:53,690 --> 00:08:56,760
.عاد للجزيرة مع أتباعه

89
00:08:59,140 --> 00:09:00,220
ماذا؟

90
00:09:03,810 --> 00:09:06,100
ما ذلك العلم الغريب؟

91
00:09:07,720 --> 00:09:08,610
...ذلك العلم

92
00:09:11,730 --> 00:09:15,200
كانَ علَمَ الدّكتور هيرولوك الّذي ربّى
توني-كُن مع الدّكتور هوريها

93
00:09:15,200 --> 00:09:20,640
!وأحبّ بلاده بشدّة حتّى لحظة مماته

94
00:09:27,160 --> 00:09:30,110
!ما عادت هذه القلعة لك

95
00:09:30,460 --> 00:09:34,670
هذا ليس مكانًا للجرذان
!الفاسدة من أمثالك

96
00:09:35,040 --> 00:09:40,390
!ارحل عن هذه البلاد
!لقد هلكت مملكة درام بالفعل

97
00:09:40,710 --> 00:09:46,890
من بين كلّ الأعلام، لا تنصبوا
!علم ذلك الدجّال

98
00:09:55,820 --> 00:09:59,740
!الدّكتور... حاول إنقاذك حتّى أنت

99
00:10:00,770 --> 00:10:02,160
...تشوبّر

100
00:10:02,160 --> 00:10:04,660
.لا تضمر الضّغينة للبشر

101
00:10:06,460 --> 00:10:11,710
.هذه البلاد مريضةٌ الآن
.يعاني الملك أيضًا من مرضٍ في قلبه

102
00:10:15,130 --> 00:10:19,640
لماذا يا دكتور؟ شخص مثله
!لا يستحقّ أن يُنقذ

103
00:10:26,050 --> 00:10:26,810
ماذا؟

104
00:10:27,260 --> 00:10:28,390
...أنا

105
00:10:29,090 --> 00:10:33,860
!لن أضربك، لذا غادر هذه البلاد

106
00:10:33,860 --> 00:10:40,570
!ماذا تقول يا تشوبّر؟
!أتظنّ أنّه سيصغي إليك؟

107
00:10:40,980 --> 00:10:43,080
...لكن... في النّهاية

108
00:10:44,700 --> 00:10:48,210
كنتَ قرصانًا مزيّفًا، صحيح؟

109
00:10:48,210 --> 00:10:51,480
لا تعلمون ما يعنيه هذا العلم

110
00:10:51,480 --> 00:10:54,330
لأنّكم كنتم قراصنة مزيّفين
!لم يخاطروا حتّى بحياتهم

111
00:10:55,340 --> 00:10:57,210
!تجنّبها! احترس

112
00:10:57,370 --> 00:11:00,050
!لا يمكنك كسر هذا العلم

113
00:11:01,260 --> 00:11:03,600
!لا بدّ أنّه نُسِف! يا للغبيّ

114
00:11:08,880 --> 00:11:11,070
...أرأيت؟ لم ينكسر

115
00:11:14,470 --> 00:11:16,720
من الأفضل لك أن تتأهّب

116
00:11:16,720 --> 00:11:19,190
!إن كنت ستعبث بعلم جمجمة شخص آخر

117
00:11:19,190 --> 00:11:21,820
...فاكهة المطّاط

118
00:11:21,820 --> 00:11:25,780
!انتظر! سأعطيك منصبًا وميداليّة

119
00:11:26,400 --> 00:11:27,510
...أيّها الدّكتور

120
00:11:27,890 --> 00:11:29,250
...إنّ المملكة

121
00:11:29,250 --> 00:11:30,830
...إنّ مملكة درام

122
00:11:35,840 --> 00:11:38,420
!سأجعلك نائب الملك إذًا

123
00:11:38,750 --> 00:11:40,510
!على وشك الانهيار

124
00:11:40,510 --> 00:11:44,050
!البازوكا

125
00:11:54,100 --> 00:11:57,110
...شكرًا لك. درام سوف

126
00:11:57,980 --> 00:11:59,300
...تولد من جديد حتمًا

127
00:12:00,770 --> 00:12:05,370
ثمّ ساعد دولتون-سان لوفي-سان
،للتّخلّص من وابول

128
00:12:06,230 --> 00:12:08,270
،ونزولاً عند رغبة جميع المواطنين

129
00:12:08,270 --> 00:12:11,750
أصبح ملكًا على البلاد الّتي حملت
.اسمًا جديدًا، مملكة ساكورا

130
00:12:12,030 --> 00:12:13,420
.فهمت

131
00:12:14,880 --> 00:12:16,500
!مهلاً، مهلاً، مهلاً

132
00:12:16,740 --> 00:12:23,180
،دولتون! أخبرتني أنّ أكفّ عن الهراء
!مع أنّك مجرّد تابع لي فحسب

133
00:12:23,180 --> 00:12:24,930
...كان ذلك في الماضي

134
00:12:25,670 --> 00:12:26,550
...أمّا الآن

135
00:12:31,550 --> 00:12:34,590
!أنا على قدم المساواة معك

136
00:12:35,740 --> 00:12:36,860
!عزيزي

137
00:12:36,860 --> 00:12:41,530
!دولتون-سان! إنّك بالفعل خُلقتَ لتكون ملكًا

138
00:12:41,530 --> 00:12:42,860
...ماذا؟ لا

139
00:12:44,240 --> 00:12:47,870
!اسمع يا دولتون
!أيّها المدافع الوغد عن العدالة

140
00:12:47,870 --> 00:12:51,910
!لا يمكنك أن تتصرّف بسذاجة عندما تدير بلادًا

141
00:12:51,910 --> 00:12:54,750
أنا خير مثال بما أنّي عدت

142
00:12:54,750 --> 00:12:58,020
عن طريق جني ثروة بفضل
!قوّة فاكهة المضغ

143
00:12:58,020 --> 00:13:02,090
!كلّما تسلّقتَ أكثر، سترى مدى قذارة العالم

144
00:13:02,410 --> 00:13:05,260
...سألقّنك درسًا! وسأردّ لك الصّاع صاعين

145
00:13:05,260 --> 00:13:08,850
بالمناسبة، هل قرأت المقال عن لوفي-كُن؟

146
00:13:08,850 --> 00:13:10,890
.نعم، بالتّفصيل

147
00:13:10,890 --> 00:13:13,680
...عفوًا... أيعقل يا دولتون-سان

148
00:13:15,120 --> 00:13:17,020
أنّك تحبّ لوسي؟

149
00:13:17,020 --> 00:13:19,110
تحبّ لوفيلاند، صحيح؟

150
00:13:23,140 --> 00:13:24,280
.أحبّه كثيرًا

151
00:13:25,100 --> 00:13:26,530
!سيكون هذا ممتعًا

152
00:13:27,020 --> 00:13:29,200
!هل تستمعون لي؟

153
00:13:29,200 --> 00:13:32,950
!أيّتها الشّمطاء، إلى متى ستعيشين؟

154
00:13:32,950 --> 00:13:36,220
!تجاوزتِ 150 سنة

155
00:13:37,240 --> 00:13:40,760
!عُمري 141 سنة فقط

156
00:13:41,620 --> 00:13:43,670
...بالمناسبة يا فتيات

157
00:13:45,960 --> 00:13:48,890
هل رأيتنّ ذلك الرّنّة أزرق الأنف؟

158
00:13:49,060 --> 00:13:51,260
!نعم، لقد قابلتُه

159
00:13:52,850 --> 00:13:55,960
أنقذ حياة لوفي-ساما في مملكة ريوغو

160
00:13:55,960 --> 00:13:58,870
.عندما كانت حالته حرجة كما أنقذ المملكة أيضًا

161
00:14:02,520 --> 00:14:04,100
.هكذا إذًا

162
00:14:07,020 --> 00:14:10,530
!رجاءً... علّميني لأصبح طبيبًا

163
00:14:10,530 --> 00:14:15,910
!سأصبح دواءً لكلّ داء
!سأصبح طبيبًا يمكنه علاج أيّ شيء

164
00:14:15,910 --> 00:14:18,840
!حتّى أنّني سأعالج بلادًا

165
00:14:19,530 --> 00:14:24,680
لأنّه... لا يوجد مرض
!في هذا العالم لا يمكن علاجه

166
00:14:46,190 --> 00:14:49,950
!اسمع، لنكن قراصنة معًا

167
00:14:49,950 --> 00:14:50,790
!اتّفقنا؟

168
00:14:51,260 --> 00:14:52,200
.ذلك غير ممكن

169
00:14:52,650 --> 00:14:53,840
...لكن

170
00:14:56,700 --> 00:15:02,210
...لكنّي رنّة! أملك قرنين وحوافر

171
00:15:02,530 --> 00:15:03,880
!حتّى أنّني أملك أنفًا أزرقًا

172
00:15:04,230 --> 00:15:08,840
!لستُ إنسانًا حتّى! أنا وحش

173
00:15:08,840 --> 00:15:13,390
!لا يمكنني أن أصبح صديقكم
...لذا

174
00:15:13,390 --> 00:15:14,850
...لذا أتيت لأشكركم فقط

175
00:15:15,510 --> 00:15:18,600
.أقدّر ما فعلتموه حقًّا

176
00:15:19,640 --> 00:15:22,440
.وشكرًا على طلبكم منّي الانضمام لكم

177
00:15:23,010 --> 00:15:26,090
...سأظلّ هنا، لكن

178
00:15:26,680 --> 00:15:29,690
،يومًا ما... إن أردتم
...تعالوا لزيارتنا مجدّ

179
00:15:29,690 --> 00:15:33,160
!اخرس! لنذهب

180
00:15:39,610 --> 00:15:41,370
!أريد التّحدّث معك في شيء

181
00:15:41,550 --> 00:15:48,170
!اسمعي يا دكتورين! سأصبح قرصانًا
!سأذهب معهم

182
00:15:48,450 --> 00:15:50,220
!لا تكن سخيفًا

183
00:15:51,790 --> 00:15:56,560
لم أسمع في حياتي عن حيوان
.رنّة ذهب ليبحر

184
00:15:56,560 --> 00:15:59,470
...معك حقّ. أنا رنّة! لكنّي

185
00:15:59,470 --> 00:16:00,880
!رجل أيضًا

186
00:16:05,860 --> 00:16:09,820
وماذا تظنّ أنّ شخصًا مثلك
!يستطيع فعله في البحر؟

187
00:16:09,820 --> 00:16:13,070
هل ستعيش في خيالك
!كما فعل ذلك الدّجّال؟

188
00:16:13,070 --> 00:16:15,870
!أنت مخطئة! لم يكن خيالاً

189
00:16:16,450 --> 00:16:19,700
!لقد اكتمل بحث الدّكتور بالفعل

190
00:16:25,040 --> 00:16:28,270
أكان لا بأس أن تودّعا بعضيكما هكذا؟

191
00:16:31,170 --> 00:16:35,920
أخذ شخص آخر حيوانًا أليفًا
.كنتُ أعتني به لا غير

192
00:16:37,050 --> 00:16:40,440
...لا أحبّ... الدّموع

193
00:16:46,970 --> 00:16:49,650
!هل أنتم مستعدّون يا رجال؟

194
00:16:57,480 --> 00:17:00,200
!سأجعل... أزهار الكرز تزهر في هذه البلاد

195
00:17:00,200 --> 00:17:04,610
،فور أن يكتمل اختراعي
!سأنقذ هذه البلاد

196
00:17:05,270 --> 00:17:09,040
!...دكتور...! دكتورين

197
00:17:33,850 --> 00:17:37,670
والآن، رافقتك السّلامة
...في رحلتك يا بنيّ الغبيّ

198
00:17:53,920 --> 00:17:55,090
!هذا مؤلم

199
00:17:55,470 --> 00:17:56,470
!ماذا حدث؟

200
00:17:57,030 --> 00:18:01,220
حاولتُ مساعدة سانجي في الطّبخ
...وقطعت إصبعي

201
00:18:01,220 --> 00:18:02,100
.دعيني ألقي نظرة

202
00:18:03,380 --> 00:18:07,230
!لا بأس. سيُشفى في وقت وجيز
.سيؤلمك هذا قليلاً

203
00:18:10,180 --> 00:18:12,060
!أنت رائع يا أخي تشو

204
00:18:12,060 --> 00:18:12,650
ماذا؟

205
00:18:12,650 --> 00:18:16,530
.لأنّه لا توجد إصابة لا يمكنك علاجها

206
00:18:16,530 --> 00:18:20,490
كان لوفي في حالة يُرثى لها
!من قبل، لكنّه بخير الآن

207
00:18:21,150 --> 00:18:25,410
ذلك لأنّي تعلّمتُ على يد أعظم
!طبيبة في العالم

208
00:18:29,990 --> 00:18:31,920
.يا له من يوم جميل

209
00:18:33,040 --> 00:18:34,050
.ليو

210
00:18:34,550 --> 00:18:38,490
،كُنت أعمل لصالح مملكة كانو
لكنّي سأقطع صلتي بهم

211
00:18:38,490 --> 00:18:41,800
.بعد مهمّة الحراسة هذه

212
00:18:42,110 --> 00:18:45,080
.ستكون هذه آخر مهمّة أقوم بها لهم

213
00:18:45,590 --> 00:18:50,730
أنا أدين بالكثير لقبّعة القشّ والبقيّة
.لأنّهم أنقذونا في دريسروزا

214
00:18:51,180 --> 00:18:56,820
إنّنا سبعة ممثلين لأسطول قبّعة القشّ
.بأكثر من 5600 عضو في مجملنا

215
00:18:56,820 --> 00:19:00,740
.علينا أن نكون مستعدّين في أيّ وقت

216
00:19:00,860 --> 00:19:02,030
.نعم

217
00:19:02,820 --> 00:19:06,660
.سمعتُ أنّ بقيّة الأعضاء بدؤوا بالاستعداد أيضًا

218
00:19:13,660 --> 00:19:15,050
!ماذا قلت؟

219
00:19:15,050 --> 00:19:19,300
!ستترك مملكة ستاندينغ فجأة؟

220
00:19:19,300 --> 00:19:21,050
!أعطني سببًا

221
00:19:21,050 --> 00:19:23,800
!لديّ دين كبير عليّ ردّه

222
00:19:23,800 --> 00:19:24,850
!حاجز

223
00:19:25,710 --> 00:19:27,840
!الحاجز السّاحق

224
00:19:29,840 --> 00:19:33,240
يمكنني تشكيل حواجز بعقد
!أصابعي معًا فحسب

225
00:19:33,240 --> 00:19:35,400
!حتّى الأطفال يعرفون ذلك

226
00:19:36,140 --> 00:19:37,900
!نـ-نحن نستسلم

227
00:19:38,120 --> 00:19:42,450
،لقد خسرنا! سنخدم تحت جناحكم
!لذلك ترأّفوا بنا رجاءً

228
00:19:43,740 --> 00:19:44,780
...حسنًا

229
00:19:45,030 --> 00:19:46,330
.ارتدوا هذه

230
00:19:47,530 --> 00:19:49,080
ما-ما هذه؟

231
00:19:51,070 --> 00:19:54,670
!لندعم طاقم قبّعة القشّ معًا

232
00:19:54,670 --> 00:19:55,750
!معًا

233
00:19:59,840 --> 00:20:02,930
!تقترب سفينتان مجهولتان منّا

234
00:20:03,150 --> 00:20:05,560
هل هم بقايا من قوّات دوفلامينغو؟

235
00:20:06,590 --> 00:20:07,850
.كافنديش

236
00:20:07,850 --> 00:20:10,070
،كما تعلم

237
00:20:10,840 --> 00:20:14,600
.كنتُ في السّابق أمير مملكة بورجوا

238
00:20:16,310 --> 00:20:19,400
!كافنديش-ساما

239
00:20:19,780 --> 00:20:24,590
لكنّ جميع نساء البلاد كنّ يسعين خلفي

240
00:20:24,980 --> 00:20:27,990
ولم تكن أيّ واحدة منهنّ عازمة
...على الزّواج بأيّ رجل آخر

241
00:20:28,260 --> 00:20:33,510
.طُردتُ من البلاد لأنّي محبوب جدًّا

242
00:20:34,120 --> 00:20:35,630
...لذلك

243
00:20:35,980 --> 00:20:40,000
.لا داعي لمهاجمتهنّ بما أنّهنّ لسن أعداء

244
00:20:43,840 --> 00:20:47,530
أعلم أنّ قبّعة القشّ سيواجه أشخاصًا

245
00:20:47,530 --> 00:20:51,310
.أكثر خطورة من دوفلامينغو من الآن فصاعدًا

246
00:20:51,310 --> 00:20:54,310
.علينا أن نصير أقوى

247
00:20:54,310 --> 00:20:58,270
!نعم! أنا أيضًا أتدرّب مع رفاقي

248
00:20:58,270 --> 00:21:02,240
!آمل أن نستطيع القتال مع لوفيلاند ثانية

249
00:21:02,470 --> 00:21:03,570
!نعم

250
00:21:09,940 --> 00:21:13,520
...في سجن إمبل داون أسفل الماء

251
00:21:20,750 --> 00:21:22,510
...في أسفل المستويات

252
00:21:22,510 --> 00:21:27,030
المستوى السّادس الّذي يضمّ مجرمين
.يُعتبرون شديدي الخطورة

253
00:21:28,550 --> 00:21:30,250
.الجحيم اللاّنهائيّ

254
00:21:35,760 --> 00:21:38,600
ما هذه الزّنزانة الانفراديّة؟

255
00:21:38,870 --> 00:21:42,570
.هل أنا وحدي هنا؟ أشعر بالوحدة

256
00:21:42,570 --> 00:21:46,990
!لا تقل لي أنّك تحاول حمايتي يا ماجيلان

257
00:21:48,970 --> 00:21:52,950
هل أتى قاتل من الأعلى لقتلي؟

258
00:21:53,290 --> 00:21:59,000
،بهدف منعي من إخبار أيّ أحد بسرّ ماريجوا

259
00:21:59,000 --> 00:22:03,300
!فهل أرسلوا قاتلاً لإسكاتي؟

260
00:22:08,040 --> 00:22:13,310
وهل كشفي للأمر مهمّ لهذه الدّرجة؟
.لا تدوم السّلطة للأبد

261
00:22:13,310 --> 00:22:16,210
!ستتعفّن بشكل أسرع ممّا يظنّه أيّ أحد

262
00:23:20,370 --> 00:23:24,710
يقع تهديد التّنّين السّماويّ الّذي
.يضرب فجأة على شيراهوشي

263
00:23:24,980 --> 00:23:29,300
لديه روب لوتشي من سايفر بول
،إلى جانبه ولا يمكن لأحد أن يمنعه

264
00:23:29,300 --> 00:23:32,150
.لكنّ نيبتون يتحرّك لشنّ هجوم يثير استياءه كثيرًا

265
00:23:32,150 --> 00:23:36,890
!ولكنّ ما سيوقف ذلك صادم جدًّا

266
00:23:36,890 --> 00:23:38,220
:في الحلقة القادمة من وان بيس

267
00:23:38,220 --> 00:23:41,130
!اضطرابات في الأرض المقدّسة"
"!الأميرة شيراهوشي مستهدفة

268
00:23:41,130 --> 00:23:43,590
!ملك القراصنة، لن يكون إلاّ أنا