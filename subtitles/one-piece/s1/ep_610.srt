1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,310 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:46,070 --> 00:02:52,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,410 --> 00:02:58,460
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,210 --> 00:03:06,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,680 --> 00:03:08,390
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:08,930 --> 00:03:12,640
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:15,680 --> 00:03:17,980
،بعد نجاتهم من معركة حامية

37
00:03:17,980 --> 00:03:21,010
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:21,010 --> 00:03:23,380
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:24,360 --> 00:03:27,530
،رسوا في بانك هازارد، جزيرة من جزأين
.أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:28,390 --> 00:03:33,370
،بعد اكتشافهم لدافع للسّيّد سيزار كلاون حاكم الجزيرة

41
00:03:33,700 --> 00:03:36,790
وبينما هم يحاولون الهرب جميعًا
.من سلاح الدّمار الشّامل شينوكوني

42
00:03:36,790 --> 00:03:41,250
،إلى جانب حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

43
00:03:41,250 --> 00:03:44,420
،هم في طريقهم الآن لاختطاف سيزار

44
00:03:44,420 --> 00:03:47,920
.وإنقاذ الأطفال والهرب من الجزيرة

45
00:03:48,180 --> 00:03:49,920
!الرّمح النّفّاث

46
00:03:52,500 --> 00:03:53,260
!الأرضيّة

47
00:03:57,850 --> 00:04:00,170
.يا لقوّته الخفيّة المذهلة

48
00:04:00,600 --> 00:04:02,820
لكنّ السّقوط هنا

49
00:04:02,820 --> 00:04:06,460
سيقوده إلى المنحدر نحو مكبّ
.النّفايات عميقًا تحت الأرض

50
00:04:07,110 --> 00:04:10,140
.لن يتمكّن من العودة أبدًا إلاّ إن كان يستطيع الطّيران

51
00:04:10,660 --> 00:04:13,120
.لم أتوقّعه أن يحفر قبره بنفسه

52
00:04:13,770 --> 00:04:14,740
!الوداع

53
00:04:16,160 --> 00:04:17,830
!لم ينجح الأمر

54
00:04:18,370 --> 00:04:22,660
.كنتُ واثقًا جدًّا أنّ بإمكاني أخذ قلبي من سيزار

55
00:04:23,350 --> 00:04:26,420
.لكن لم أتوقّع تواجدك هنا

56
00:04:27,440 --> 00:04:28,260
!فيرغو

57
00:04:29,330 --> 00:04:30,220
!أضف "سان" لاسمي

58
00:04:44,750 --> 00:04:46,670
.أنا مشغول بأمر الآن

59
00:04:47,290 --> 00:04:49,450
هل سبب مجيء عاجل لهذه الدّرجة؟

60
00:04:50,860 --> 00:04:52,280
.يا نائب الأميرال سموكر

61
00:04:57,190 --> 00:05:01,000
"!صِدام قبضات! معركة بين نائبَيْ أميرال"

62
00:05:08,300 --> 00:05:12,970
الطّابق الثّالث للمبنى "ب" - غرفة البسكويت

63
00:05:17,130 --> 00:05:21,480
موتشا، تلك الحلوى اللّذيذة
من حقّ الجميع، صحيح؟

64
00:05:21,480 --> 00:05:23,230
.كفّوا عن القتال

65
00:05:23,230 --> 00:05:26,190
.تشاركوها وكلوها معًا كالعادة

66
00:05:26,400 --> 00:05:27,280
!كلاّ

67
00:05:27,280 --> 00:05:30,570
!ليس علينا أكلها بعد الآن

68
00:05:33,080 --> 00:05:34,820
.أنت طفلة صعبة

69
00:05:34,820 --> 00:05:37,410
!مهلاً، ما الّذي فعلته؟

70
00:05:37,660 --> 00:05:42,120
!صحيح، ليس لدينا وقت لك

71
00:05:42,120 --> 00:05:44,530
كيف أمكنكم قول شيء كهذا؟

72
00:05:44,530 --> 00:05:47,670
.أنا أعرفكم حقّ المعرفة

73
00:05:47,930 --> 00:05:51,010
.طاقم قبّعة القشّ ذائع الصّيت

74
00:05:51,380 --> 00:05:53,840
.مسرورة بلقائكم

75
00:05:55,220 --> 00:05:56,680
!من تكونين؟

76
00:05:58,100 --> 00:06:01,550
.أنا موني، وأكلت فاكهة الثّلج

77
00:06:11,710 --> 00:06:13,690
!أوسوبّ! بروك

78
00:06:13,690 --> 00:06:16,830
!سأحاول إبقاء الأطفال هنا

79
00:06:16,830 --> 00:06:19,450
!وأنتما، اذهبا وابحثا عن أغلال الحجر البحريّ

80
00:06:19,840 --> 00:06:21,360
!أغلال من الحجر البحريّ؟

81
00:06:21,360 --> 00:06:22,570
لماذا تريدينها؟

82
00:06:22,570 --> 00:06:24,120
!طلب منّي لوفي البحث عنها

83
00:06:26,410 --> 00:06:28,260
...لا أعلم السّبب، ولكن

84
00:06:29,350 --> 00:06:31,670
!يمكن الاعتماد عليّ للبحث عن الأشياء

85
00:06:31,670 --> 00:06:35,050
!سأذهب معكما! إذْ عليّ إيجاد مومونوسكي

86
00:06:35,050 --> 00:06:37,000
!حسنٌ! فلنذهب إذًا

87
00:06:47,650 --> 00:06:51,940
"المبنى "د" - غرفة تصنيع "إس إيْ دي

88
00:07:11,240 --> 00:07:12,000
ما هذه؟

89
00:07:12,850 --> 00:07:14,670
.هذه الغرفة مريبة للغاية

90
00:07:15,780 --> 00:07:18,760
.هذا ليس من شأنك

91
00:07:21,710 --> 00:07:24,970
أنت، لِمَ تشيح بنظرك عنّي؟

92
00:07:25,210 --> 00:07:29,150
.فأنا لم أستسلم بعد

93
00:07:34,100 --> 00:07:36,660
.سأتولّى أمرك لاحقًا

94
00:07:36,660 --> 00:07:39,280
فلماذا لا تخرس وتظلّ مستلقيًا أرضًا؟

95
00:07:44,460 --> 00:07:45,420
.فيرغو

96
00:07:46,630 --> 00:07:50,700
.لا أريد أن يعلم الجنود بحقيقتك

97
00:07:51,850 --> 00:07:56,130
.إنّهم يتطلّعون إليك كأب لهم

98
00:07:56,910 --> 00:07:58,830
.إنّ هذا من أقصى درجات الخيانة

99
00:07:59,260 --> 00:08:02,600
.لا يسعني تصديق أنّك كلب جوكر الطّائع

100
00:08:04,330 --> 00:08:05,350
.فات الأوان على ذلك

101
00:08:06,720 --> 00:08:10,480
.كنتُ بصحبتهم قبل دقائق معدودة

102
00:08:10,910 --> 00:08:11,980
!ماذا فعلت بهم؟

103
00:08:11,980 --> 00:08:13,360
.لا أذكر

104
00:08:13,360 --> 00:08:14,690
!فيرغو

105
00:08:17,400 --> 00:08:20,220
.أنت تتحمّس كثيرًا يا سموكر-كُن

106
00:08:21,150 --> 00:08:26,290
.لا تقل لي أنّك قلق على مشاكسي البحرية أولئك

107
00:08:28,370 --> 00:08:30,050
.أنا قائد قاعدة

108
00:08:30,050 --> 00:08:33,340
.أستطيع فعل ما أشاء لرجالي عديمي النّفع

109
00:08:36,520 --> 00:08:41,560
كما أنّه عليك الموت في كلّ الأحوال
.بما أنّك تعرف حقيقتي الآن

110
00:09:15,130 --> 00:09:18,670
،حتّى ولو كنت تعرفهم لوقت طويل

111
00:09:20,000 --> 00:09:23,190
،وحتّى ولو كنت قائد قاعدة
،وهو ما لم أعد أعترف به بعد الآن

112
00:09:24,720 --> 00:09:26,470
،فبمجرّد خروجنا من القاعدة

113
00:09:26,470 --> 00:09:29,460
.فإنّ قائد وحدة ما مسؤول عن حياة رجاله

114
00:09:30,390 --> 00:09:34,850
!إيّاك ولمس شعرة من رجالي

115
00:09:36,190 --> 00:09:39,820
المبنى "ب" - [جي-5] وسانجي

116
00:09:45,150 --> 00:09:46,910
ما الّذي يحدث هنا؟

117
00:09:46,910 --> 00:09:48,450
!هذا ساخن! ساخن

118
00:09:48,450 --> 00:09:50,040
!لا مكان نطأ فيه هنا

119
00:09:50,040 --> 00:09:52,460
!ما الّذي حدث هنا؟

120
00:09:52,680 --> 00:09:55,420
!أسرعوا! احملوا الجرحى ودعونا نتقدّم

121
00:09:55,420 --> 00:09:58,920
!كما علينا حماية تاشيغي-تشان

122
00:09:58,920 --> 00:10:00,090
!توقّفوا عن هذا

123
00:10:00,420 --> 00:10:02,920
!لا تكونوا ودودين معه هكذا! إنّه عدوّنا

124
00:10:02,920 --> 00:10:05,220
!هكذا قد يعرّف العالم علاقتنا

125
00:10:05,220 --> 00:10:07,180
!لكنّ القراصنة أحرار

126
00:10:07,180 --> 00:10:11,500
،عندما ضربت فيرغو المزيّف بركلة يا أخي

127
00:10:11,500 --> 00:10:13,990
!بدوتَ رائعًا، حتّى أنا وقعت في حبّك

128
00:10:13,990 --> 00:10:16,100
!نعم، بدوت مثيرًا حقًّا يا أخي

129
00:10:16,100 --> 00:10:17,320
!اخرسوا

130
00:10:17,320 --> 00:10:19,970
!أخبرتكم أنّي لا أقبل الدّعم من الرّجال

131
00:10:19,970 --> 00:10:22,690
!كفّوا على مناداة القرصان بأخي

132
00:10:26,210 --> 00:10:29,490
!انفجرت إحدى الحاويات! إنّها تحترق

133
00:10:29,490 --> 00:10:31,650
!مهلاً، هذا سيّئ

134
00:10:31,650 --> 00:10:33,180
!ثمّة صدع على الجدار الخارجيّ

135
00:10:36,940 --> 00:10:39,710
!انفجار آخر! ما الّذي يحدث؟

136
00:10:39,710 --> 00:10:41,380
!اهربوا يا هؤلاء

137
00:10:41,380 --> 00:10:44,800
.ماذا؟ ما الخطب؟ يبدو وجهك شاحبًا

138
00:10:44,800 --> 00:10:47,550
!بدأ الغاز بالتّسرّب إلى الدّاخل

139
00:10:47,550 --> 00:10:49,910
!الغاز المميت الّذي واجهناه سابقًا

140
00:10:49,910 --> 00:10:51,780
!ماذا؟

141
00:10:51,780 --> 00:10:54,010
!اهربوا إن كنتم تريدون النّجاة

142
00:10:58,480 --> 00:11:00,440
!كلاّ

143
00:11:05,080 --> 00:11:08,740
المبنى "ب" كبير جدًّا، لكنّه سيمتلئ
!بالغاز في أيّة لحظة

144
00:11:13,740 --> 00:11:15,500
!قف وكفاك نحيبًا

145
00:11:17,230 --> 00:11:19,380
!تاشيغي-تشان، عليكِ قيادتهم

146
00:11:19,700 --> 00:11:23,550
!ستموتون إن أضعتم طريقكم
!لا تسلكوا الطّريق الخطأ

147
00:11:24,010 --> 00:11:24,910
!أيّها السّاق السّوداء

148
00:11:24,910 --> 00:11:27,470
!هيّا يا رجال! سيُقضى عليكم إن أبطأتم

149
00:11:30,280 --> 00:11:31,930
!يا رفاق! اتبعوني

150
00:11:32,470 --> 00:11:36,890
الطّابق الثّاني للمبنى "ب" - الغرفة السّرّيّة

151
00:11:40,170 --> 00:11:42,930
!يا لهم من مجموعة حمقى

152
00:11:42,930 --> 00:11:45,880
!سمحوا لشينوكوني بالدّخول بأنفسهم

153
00:11:45,880 --> 00:11:47,050
...لكن

154
00:11:47,660 --> 00:11:51,990
السّماح لهم بالموت هناك لن يساعد
!على إتمام عرض تجربتي إلى نهايته

155
00:11:52,530 --> 00:11:56,280
!"اسمع، أغلق البوّابات للمبنيين "س" و"د

156
00:11:56,280 --> 00:11:58,050
حاضر. ماذا عن "ر"؟

157
00:11:58,050 --> 00:11:59,620
.دع تلك مفتوحة

158
00:12:00,130 --> 00:12:04,920
."أريد استدراجهم إلى الطّابق الأوّل للمبنى "ر

159
00:12:05,250 --> 00:12:09,350
."في كلّ الأحوال، يحاولون بلوغ البوّابة 66 للمبنى "ر

160
00:12:10,050 --> 00:12:14,980
،لا أريدهم أن يأخذوا طريقًا خاطئًا
.لذلك دعونا  نرشدهم

161
00:12:18,930 --> 00:12:22,560
المبنى "س" - مكبّ النّفايات

162
00:12:29,960 --> 00:12:31,990
.كان ذلك فظيعًا

163
00:12:36,860 --> 00:12:38,190
أين أنا؟

164
00:12:43,330 --> 00:12:44,320
.إنّه مكسور

165
00:12:44,770 --> 00:12:46,090
أهذا مكبّ نفايات؟

166
00:12:47,890 --> 00:12:51,090
.أظنني سقطت إلى هذا القاع العميق

167
00:12:57,530 --> 00:12:59,520
!أنا جائع

168
00:13:00,330 --> 00:13:04,050
!بالتّفكير في الأمر، كنت أركض طوال الوقت

169
00:13:05,550 --> 00:13:07,580
هل يوجد ما يمكنني أكله هنا؟

170
00:13:08,040 --> 00:13:08,860
!سُحقًا

171
00:13:09,210 --> 00:13:10,750
!كلّها نفايات

172
00:13:21,890 --> 00:13:24,170
!احذر أيّها الرّجل الوقح

173
00:13:52,290 --> 00:13:55,580
!لا يروقني هذا المكان بالمرّة

174
00:13:56,160 --> 00:13:59,800
."الغرفة السّرّيّة في الطّابق الثّاني للمبنى "ر

175
00:13:59,800 --> 00:14:03,120
.لم أرد المجيء لهذه الغرفة الرّديئة

176
00:14:03,380 --> 00:14:05,900
لكن لا يجب أن أسمح لطاقم
.قبّعة القشّ بفعل ما يحلو لهم

177
00:14:06,570 --> 00:14:09,480
.لقد تمادوا كثيرًا

178
00:14:10,730 --> 00:14:13,310
.يقف جوكر إلى جانبي

179
00:14:13,310 --> 00:14:17,180
!بمجرّد وصولهم إلى هنا، سأقتلهم جميعًا دفعة واحدة

180
00:14:17,890 --> 00:14:19,030
!أيّها السّيّد

181
00:14:19,030 --> 00:14:21,930
!نحن متأهّبون للقتال منذ البارحة

182
00:14:21,930 --> 00:14:24,830
لماذا استدعيتنا إلى هنا

183
00:14:24,830 --> 00:14:27,210
حيث كان مكتب فيغابانك المقيت السّابق؟

184
00:14:27,210 --> 00:14:30,240
فيغابانك عدوّ لنا أيضًا

185
00:14:30,240 --> 00:14:32,320
!بما أنّه تسبّب بالحادثة قبل أربع سنوات

186
00:14:32,620 --> 00:14:36,820
!ألا يوجد ما نستطيع فعله؟

187
00:14:36,820 --> 00:14:38,950
!ألا يجدر بنا قتالهم؟

188
00:14:39,200 --> 00:14:41,080
.لا، لا داعي لذلك

189
00:14:41,970 --> 00:14:46,720
!أنتم يا رجال أفضل جنود لديّ

190
00:14:48,150 --> 00:14:50,500
!لا أريد أن تُزهق أرواحكم سدى

191
00:14:50,900 --> 00:14:53,090
...أ-أيّها السّيّد

192
00:14:55,170 --> 00:14:58,430
.حسنٌ، سأشرح الخطّة

193
00:14:59,260 --> 00:15:02,970
،عندما نغلق البوّابات "س" و"د" كما سبق وقلت

194
00:15:02,970 --> 00:15:06,560
فالطّرق الوحيدة الّتي ستبقى هي المتّصلة

195
00:15:06,560 --> 00:15:08,440
.بالطّابق الأوّل للمبنى "ر" الّذي تحت هذه الغرفة

196
00:15:12,170 --> 00:15:15,680
.طاقم قبّعة القشّ أو جي-5 أو الأطفال

197
00:15:15,680 --> 00:15:17,330
،لا يهمّ إن كانوا أعداءنا أم لا

198
00:15:17,330 --> 00:15:21,200
ستكون الغرفة أسفلنا المكان الوحيد الّذي
.يستطيع هؤلاء النّاجون الذّهاب إليه

199
00:15:21,690 --> 00:15:25,670
."ثمّة نظام تهوية في الطّابق الأوّل للمبنى "ر

200
00:15:25,670 --> 00:15:29,150
لذلك بإمكاننا السّماح للهواء من الخارج
.المحمّل بشينوكوني، بالدّخول

201
00:15:29,150 --> 00:15:31,420
.ولن يكون هناك سبيل للعودة بعدها

202
00:15:31,670 --> 00:15:34,690
!من بإمكانه النّجاة من ذلك؟

203
00:15:34,690 --> 00:15:39,220
سيصبح المكان غرفة غاز ضخمة
!بعدما نغلق كلّ البوّابات

204
00:15:39,970 --> 00:15:45,120
سنبثّ ما سيحدث في تلك الغرفة
!لكلّ سماسرة السّوق السّوداء في العالم

205
00:15:46,450 --> 00:15:50,110
!وسيرون هكذا ما أنا قادر عليه

206
00:16:02,000 --> 00:16:04,860
.المعذرة أيّها السّيّد سيزار

207
00:16:06,660 --> 00:16:11,330
هل أنت من اخترع ذلك الغاز السّامّ المميت؟

208
00:16:11,880 --> 00:16:13,920
.نعم، صحيح

209
00:16:21,330 --> 00:16:27,810
إنّه يشبه غاز فيغابانك الّذي انتشر في كلّ
.أنحاء الجزيرة بعد الحادثة قبل أربع سنوات

210
00:16:27,810 --> 00:16:30,440
.لذا فالأمر يرعبنا بصراحة

211
00:16:30,440 --> 00:16:32,170
.إنّه فظيع

212
00:16:53,730 --> 00:16:54,760
أيّها السّيّد؟

213
00:16:57,030 --> 00:16:58,220
...هذه

214
00:17:00,750 --> 00:17:03,260
!معركة علم ثأريّة

215
00:17:03,260 --> 00:17:04,960
!يا رجالي

216
00:17:07,390 --> 00:17:11,670
...في ذلك اليوم، حاولتُ إيقاف

217
00:17:11,670 --> 00:17:15,190
!العالِم المجنون فيغابانك

218
00:17:15,480 --> 00:17:18,900
،كلاّ! إن انفجر سلاح كهذا"

219
00:17:19,220 --> 00:17:22,450
"!فما الّذي سيحلّ بالنّاس على الجزيرة؟

220
00:17:22,790 --> 00:17:26,080
"!توقّف يا فيغابانك"

221
00:17:29,580 --> 00:17:32,380
.لكنّ الحادثة وقعت

222
00:17:34,670 --> 00:17:40,570
وفوق ذلك، ما زال يترأسنا ككبير
!القسم العلميّ في البحريّة

223
00:17:41,330 --> 00:17:44,680
!ويُعتبر أعظم علماء العالم على الإطلاق

224
00:17:44,930 --> 00:17:47,220
!لا أستطيع تحمّل ذلك

225
00:17:47,520 --> 00:17:51,350
!إنّه الرّجل الفظيع الّذي آذاكم جميعًا

226
00:17:51,680 --> 00:17:55,900
!ألا تظنّون أنّه من الظّلم أن يبقى العالِم الأوّل في العالم؟

227
00:18:00,730 --> 00:18:01,830
!أيّها السّيّد

228
00:18:03,240 --> 00:18:05,820
!لهذا السّبب أريد إثبات خطئهم

229
00:18:06,050 --> 00:18:08,830
،لم أرد صنع سلاح دمار شامل

230
00:18:09,410 --> 00:18:13,160
!لكنّي أريد أن أريهم أنّ هنالك عالِمًا أعظم منه هنا

231
00:18:13,520 --> 00:18:16,980
!أردت إثبات أنّي أعظم عالِم في العالم

232
00:18:20,640 --> 00:18:25,760
،عندما تعترف البحريّة بذلك
،وأغدو كبير قسم الأبحاث

233
00:18:25,760 --> 00:18:27,510
.سيتحقّق حلمي

234
00:18:27,510 --> 00:18:32,180
!وسأتمكّن بمعرفتي العلميّة من تحقيق السّلام في العالم

235
00:18:35,050 --> 00:18:36,560
!أيّها السّيّد

236
00:18:36,860 --> 00:18:41,360
!آسف أيّها السّيّد! عار علينا لأنّنا شككنا بك

237
00:18:41,360 --> 00:18:44,320
!أنت هو المنقذ في النّهاية

238
00:18:46,500 --> 00:18:58,540
!أيّها السّيّد

239
00:18:58,890 --> 00:19:02,740
!شكرًا لكم! شكرًا لكم جميعًا

240
00:19:07,560 --> 00:19:09,300
!توقّف يا سيزار

241
00:19:09,690 --> 00:19:12,350
!عليك إيقاف التّجربة في الحال

242
00:19:17,230 --> 00:19:22,760
إذا ما انفجر سلاح كهذا، فماذا
!سيكون مصير قاطني الجزيرة؟

243
00:19:22,760 --> 00:19:24,940
!اخرسوا أيّها الحمقى

244
00:19:24,940 --> 00:19:29,640
أين تظنّون أنفسكم؟
!إنّ هذا مختبر أبحاثٍ تابع للقوّات

245
00:19:29,640 --> 00:19:33,320
تريد البحريّة القضاء على أكبر عدد من القراصنة

246
00:19:33,320 --> 00:19:36,620
!وما يحتاجونه هو سلاح يضمن تحقيق ذلك

247
00:19:36,620 --> 00:19:38,060
!أنت مخطئ

248
00:19:38,060 --> 00:19:42,590
!إنّهم لا يريدون سلاحًا من شأنه القضاء على المدنيين أيضًا

249
00:19:44,220 --> 00:19:45,090
!أنت غبيّ للغاية

250
00:19:45,420 --> 00:19:48,340
!تلك تضحية لا بدّ منها

251
00:19:48,340 --> 00:19:51,190
!إنّ من يورّطون أنفسهم أغبياء فحسب

252
00:19:51,190 --> 00:19:54,100
.إن فجّرنا كلّ شيء، بإمكاننا إحلال السّلام في العالم

253
00:19:55,180 --> 00:19:56,900
...ما أنت إلاّ

254
00:19:57,480 --> 00:19:59,600
!أأردت القول رجل قاس؟

255
00:20:00,010 --> 00:20:02,060
!لا بدّ أنّك تمازحني

256
00:20:02,350 --> 00:20:07,800
تستعملون السّجناء كفئران تجارب
!كأنّهم نفايات يجب التّخلّص منها

257
00:20:07,800 --> 00:20:09,610
فأين يكمن الفرق بيننا؟

258
00:20:09,610 --> 00:20:12,990
.أميرال الأسطول الحاليّ سنغوكو رقيق القلب للغاية

259
00:20:12,990 --> 00:20:17,830
.لكنّ الأميرال أكاينو سيرغب في سلاح مثله

260
00:20:18,240 --> 00:20:19,910
!اذهبوا إن كنتم قد فهمتم

261
00:20:19,910 --> 00:20:21,210
.إنّكم تعترضون طريقي

262
00:20:23,210 --> 00:20:27,660
!لا بدّ أنّ فيغابانك يحسدني لأنّني بهذه العبقريّة

263
00:20:27,660 --> 00:20:32,140
.سمعتُ أنّه فشل في تحويل البشر لعمالقة ثانية

264
00:20:32,140 --> 00:20:37,040
لا يمكن جعل النّاس أكبر حجمًا
.في وقت قصير إلاّ إن استعمل السّحر

265
00:20:37,040 --> 00:20:38,730
:لذلك أخبره دائمًا

266
00:20:39,790 --> 00:20:45,820
عليه اختطاف أطفال ما زالوا في طور
.النّموّ ويجرّب عليهم كلّ العقاقير الّتي يعرف

267
00:20:48,310 --> 00:20:50,130
...سيزار

268
00:20:56,160 --> 00:20:59,710
!نعم! نعم

269
00:21:04,800 --> 00:21:06,190
!ما-ما الّذي تفعلونه؟

270
00:21:06,190 --> 00:21:07,670
!لا تقاوم

271
00:21:07,880 --> 00:21:10,380
!أتظنّون أنّ بإمكانكم الحديث معي هكذا؟

272
00:21:10,700 --> 00:21:15,720
أوشكت على الانتهاء من صنع سلاح
!لم ترونه إلاّ في أحلامكم

273
00:21:17,210 --> 00:21:19,430
!فيغابانك! ما الّذي يحدث هنا؟

274
00:21:20,110 --> 00:21:23,310
.أنت مطرود من فريق الأبحاث هذا يا سيزار

275
00:21:23,310 --> 00:21:26,650
لا يسمح بتصرّفك غير المسؤول هنا
.وما عدت أستطيع حمايتك

276
00:21:28,850 --> 00:21:30,280
!!لا تعبثوا معي

277
00:21:30,590 --> 00:21:32,990
!لا تفعلها يا سيزار

278
00:21:52,390 --> 00:21:53,950
!أغبياء

279
00:21:53,950 --> 00:21:58,300
،فيغابانك والبحريّة وقبّعة القشّ والرّجال المتواجدون هنا

280
00:21:58,300 --> 00:22:03,390
!كلّهم أقلّ ذكاء منّي، بل أغبياء ككومة صخور

281
00:22:03,390 --> 00:22:05,900
!والآن، فلنبدأ الأمر

282
00:22:08,820 --> 00:22:11,780
!البوّابة الرّابطة بين "س" و"ب" تُغلق

283
00:22:12,610 --> 00:22:15,570
!البوّابة الرّابطة بين "د" و"ب" تُغلق

284
00:22:16,090 --> 00:22:20,970
"لا يستطيع أحد الدّخول للمبنيين "س" و"د
.من المبنى "ب" حاليًّا

285
00:22:21,780 --> 00:22:23,870
!اركضوا بكلّ قوّتكم

286
00:22:44,450 --> 00:22:46,370
أقلت شيئًا ما؟

287
00:22:47,380 --> 00:22:49,230
!من تكون؟

288
00:22:49,490 --> 00:22:52,650
...مـ

289
00:22:58,090 --> 00:22:59,770
...من

290
00:22:59,770 --> 00:23:02,230
!تكون أنت؟

291
00:23:11,050 --> 00:23:14,250
عميقًا داخل المبنى "س" الّذي قيل
،أنّ الهرب منه مستحيل

292
00:23:14,250 --> 00:23:18,530
يجد لوفي نفسه في وضع يائس
.ثمّ يلتقي بتنّين صغير

293
00:23:18,970 --> 00:23:23,080
يصف التّنّين نفسه بالمحارب
.وقد قهر قدرًا غريبًا

294
00:23:23,080 --> 00:23:26,390
.يقرّر لوفي القيام بخطوة ما بعد لقائهما المفاجئ

295
00:23:26,390 --> 00:23:27,740
:في الحلقة القادمة من وان بيس

296
00:23:27,740 --> 00:23:30,500
"!تنّين صغير! ظهور مومونوسكي"

297
00:23:30,500 --> 00:23:32,560
!ملك القراصنة، لن يكون إلاّ أنا

298
00:23:35,990 --> 00:23:40,990
!!نراكم في الحلقة القادمة