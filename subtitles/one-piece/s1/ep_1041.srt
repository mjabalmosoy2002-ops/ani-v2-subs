1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:44,630 --> 00:01:49,430
فلنلوّنها بألواننا الخاصّة

19
00:01:58,370 --> 00:02:02,530
يهرب كلّ من نامي وأوسوبّ
.في ساحة المعركة وهما يحميان أوتاما

20
00:02:02,530 --> 00:02:04,780
!بسرعة يا حصّونة-تشان

21
00:02:04,780 --> 00:02:07,570
!أنا لها يا سيّدتي-ساما

22
00:02:11,010 --> 00:02:12,680
!ها هي ذي

23
00:02:12,680 --> 00:02:14,450
!اقتلوا تلك الشّقيّة

24
00:02:17,080 --> 00:02:19,180
!لن أسمح لكم بذلك

25
00:02:19,180 --> 00:02:21,420
!سنحمي سيّدتي-ساما

26
00:02:23,630 --> 00:02:26,590
!إبرة العقرب المميتة

27
00:02:31,610 --> 00:02:35,070
!لن أسمح لكم بلمس سيّدتي-ساما

28
00:02:35,070 --> 00:02:36,600
!دايفوكو-كُن

29
00:02:36,600 --> 00:02:40,310
!دعي أمر كوماتشيو لنا

30
00:02:42,250 --> 00:02:45,690
!أأنت واثق؟! شكرًا لكما

31
00:02:45,920 --> 00:02:51,320
كونا حذرين رجاءً كلاكما
!يا دايفوكو-كُن وغازيلمان-كُن

32
00:02:51,630 --> 00:02:53,370
...كلاكما

33
00:02:54,260 --> 00:02:56,910
!صديق عزيز عليّ

34
00:02:57,550 --> 00:02:59,880
.يا لها من قدرة مذهلة

35
00:02:59,880 --> 00:03:05,720
نعم، لا يمكن كسب صداقات
.في ساحات المعارك في العادة

36
00:03:05,720 --> 00:03:12,340
يتواصل تعداد قراصنة مملكة الحيوان
.بالتّناقص بسبب قوّة الكيبي دانغو لأوتاما

37
00:03:14,950 --> 00:03:19,430
يتقاتل جينبي وهوز-هو في معركة
.مميتة في أحد أركان القلعة

38
00:03:20,280 --> 00:03:22,900
،بينما كنت أتلقّى أشدّ العقاب

39
00:03:22,900 --> 00:03:25,940
.قيل لي باستهزاء أن أدعو لخلاصي

40
00:03:26,460 --> 00:03:29,440
!تضرّعًا لإله الشّمس نيكا

41
00:03:31,870 --> 00:03:37,790
إنّه محارب أسطوريّ
من غابر الأزمان آمن العبيد

42
00:03:37,790 --> 00:03:41,250
.أنّه سيحرّرهم يومًا ما

43
00:03:41,720 --> 00:03:44,320
.لا أدري إن كان موجودًا فعلاً

44
00:03:44,320 --> 00:03:48,460
.محارب سيجعلك تضحك وسيخلّصك من بؤسك

45
00:03:48,980 --> 00:03:51,450
،بدا لي السّجن كأنّه للأبد

46
00:03:51,450 --> 00:03:55,050
.لذلك تشبّثت بهذه الأسطورة الغريبة

47
00:03:55,680 --> 00:03:59,640
.كنتُ أفكّر "لا أهتمّ من يكون
"!ليساعدني أحد ما

48
00:04:00,740 --> 00:04:03,730
ما علاقة ذلك بي؟

49
00:04:04,020 --> 00:04:07,980
سمعتُ أنّ ضمن قراصنة الشّمس الّذين قدتَهم

50
00:04:08,330 --> 00:04:11,070
!من كانوا عبيدًا في السّابق

51
00:04:11,070 --> 00:04:15,490
!ليس لديّ ما أقوله لك

52
00:04:15,490 --> 00:04:17,040
!دعني أثقبك بأنيابي

53
00:04:17,040 --> 00:04:18,250
!مسدّس الأنياب

54
00:04:32,190 --> 00:04:33,760
!ما الّذي يحدث؟

55
00:04:34,780 --> 00:04:37,430
!فنّ كاراتي البرمائيّين السّرّيّ

56
00:04:37,430 --> 00:04:38,930
!سُحقًا

57
00:04:42,480 --> 00:04:44,180
!ذيلي

58
00:04:44,830 --> 00:04:48,230
!قبضة قرميد الشّيطان

59
00:04:55,050 --> 00:04:58,410
...في تلك الأثناء، فوق سطح قبّة الجمجمة

60
00:04:58,670 --> 00:04:59,620
!كايدو

61
00:05:05,680 --> 00:05:07,750
!"نادني بـ"والدي

62
00:05:08,600 --> 00:05:09,880
!يا ياماتو

63
00:05:15,190 --> 00:05:17,970
!أنا هنا لأقطع أواصري معك

64
00:05:21,280 --> 00:05:25,400
"!معارك مواجهات وحوش! ياماتو وفرانكي"

65
00:05:53,130 --> 00:05:54,340
!ياماتو

66
00:05:54,730 --> 00:05:56,590
!أنت قويّ

67
00:05:56,860 --> 00:06:00,680
...اغدُ الشّوغن من أجلي بدون مقاومة

68
00:06:01,150 --> 00:06:04,060
.من الأفضل أن تستمع لوالدك

69
00:06:07,440 --> 00:06:12,460
!تباهى بقوّتك بقدر ما تريد كشوغن لبلاد وانو

70
00:06:12,460 --> 00:06:16,780
!هيمن على كلّ شيء وافعل ما يحلو لك

71
00:06:19,170 --> 00:06:21,530
!لن أهيمن على أيّ شيء

72
00:06:22,420 --> 00:06:24,540
!ولن أصير تحت هيمنة أحد

73
00:06:25,430 --> 00:06:27,370
...كم هذا مزعج

74
00:06:27,560 --> 00:06:29,580
.ماتوا جميعًا

75
00:06:30,020 --> 00:06:33,260
!كلّ من ردّدوا  نفس تلك الكلمات

76
00:06:33,260 --> 00:06:35,550
!أعلم أنّ لوفي سيعود

77
00:06:36,270 --> 00:06:37,670
،وحتّى ذلك الحين

78
00:06:38,320 --> 00:06:40,430
!سأبقيك مشغولاً

79
00:06:49,020 --> 00:06:52,190
.أنت غافل عمّا هو صواب وعمّا هو خطأ

80
00:06:54,650 --> 00:06:56,070
...أنا

81
00:06:56,460 --> 00:06:57,860
!أودن

82
00:06:58,420 --> 00:07:02,110
!سوف أحمي بلاد وانو

83
00:07:45,720 --> 00:07:47,690
جلدي صلب للغاية، صحيح؟

84
00:07:47,690 --> 00:07:51,960
هذا مؤلم، صحيح؟
!هذه هي قوّة السّايبورغ

85
00:07:52,470 --> 00:07:53,580
...نعم

86
00:07:53,890 --> 00:07:57,340
.كلّ ما يمكنك فعله هو استعمال ما مُنحتَ إيّاه

87
00:07:57,940 --> 00:08:00,340
!إنّها قوّة أحمق مثير للشّفقة

88
00:08:01,150 --> 00:08:02,720
!ماذا؟

89
00:08:09,950 --> 00:08:11,430
!سُحقًا لك

90
00:08:11,700 --> 00:08:15,670
!ستعجز عن هزيمتي مهما حاولت

91
00:08:15,670 --> 00:08:18,440
!شعاع

92
00:08:22,920 --> 00:08:24,070
!ها أنت هناك

93
00:08:33,010 --> 00:08:35,170
!أنت سحليّة لعينة تلمع أكثر من اللاّزم

94
00:08:37,100 --> 00:08:38,670
!تلمع

95
00:08:45,320 --> 00:08:48,120
تكنولوجيا تخوّلك أن تطلق
...طلقات ليزر متتالية

96
00:08:48,120 --> 00:08:50,310
!كان فرانكي ليرغب بذلك

97
00:08:50,310 --> 00:08:51,930
!سأقتلك

98
00:08:52,700 --> 00:08:54,730
أتريد هذا بالفعل؟

99
00:08:54,730 --> 00:08:55,850
!قم بالأمر فحسب

100
00:09:03,240 --> 00:09:05,240
!خذ! شعاع

101
00:09:06,630 --> 00:09:10,160
لن يستطيع ذو الحاجبين اللّولبيّين
!إخراجنا من هنا وحده

102
00:09:13,330 --> 00:09:15,750
...هذا ما هو متوقّع من زورو

103
00:09:16,640 --> 00:09:19,840
!حسنًا! أعدّوا الحقنة

104
00:09:19,840 --> 00:09:21,090
!مياغي

105
00:09:21,310 --> 00:09:23,960
!احصل على موافقة مسبقة

106
00:09:26,600 --> 00:09:30,930
احرص أنّك تفهم الشّرح بالكامل
.قبل أن توافق على الأمر

107
00:09:30,930 --> 00:09:36,270
هذا الدّواء الّذي توارثناه في زو
،سيمنح لك قدرة خارقة على الشّفاء

108
00:09:36,270 --> 00:09:38,820
.لكنّ ذلك مؤقّت فحسب

109
00:09:38,820 --> 00:09:41,800
...وفي المقابل، ستعاني أعراضًا جانبيّة لاحقًا

110
00:09:41,800 --> 00:09:45,790
!تُقدّر بضعف ما تعاني منه الآن

111
00:09:45,790 --> 00:09:48,360
.نعم، لا أمانع ذلك

112
00:09:48,760 --> 00:09:51,660
...لا أمانع ذلك ولكن

113
00:09:52,220 --> 00:09:54,410
!أليست الإبرة طويلة جدًّا؟

114
00:09:54,830 --> 00:09:57,210
!زورو، تماسك

115
00:09:57,470 --> 00:09:59,080
!أنت لها

116
00:10:10,610 --> 00:10:11,390
!مهلاً

117
00:10:11,700 --> 00:10:13,290
!أدخلتها عميقًا، عميقًا

118
00:10:13,290 --> 00:10:15,180
!عفوًا! أنا آسف

119
00:10:18,620 --> 00:10:23,210
،الضّمادات سميكة جدًّا
.لذلك لم أستطع رؤية عروقك

120
00:10:23,210 --> 00:10:24,700
!انزعها أوّلاً

121
00:10:24,700 --> 00:10:27,010
!نعم، معك حقّ

122
00:10:27,010 --> 00:10:28,700
.حسنًا، لنقم بهذا فحسب

123
00:10:29,840 --> 00:10:31,620
!هل أنت واثق يا هذا؟

124
00:10:58,490 --> 00:11:00,060
!دع البقيّة لنا

125
00:11:00,060 --> 00:11:01,940
!أطح بساساكي

126
00:11:01,940 --> 00:11:04,060
!يا أخي الحديديّ

127
00:11:05,670 --> 00:11:09,840
!عدتم لتقاتلوا في صفّي؟

128
00:11:09,840 --> 00:11:11,860
!نعم

129
00:11:15,720 --> 00:11:19,790
!يا-يا أصدقائي ممّن أكلوا الكيبي دانغو

130
00:11:19,790 --> 00:11:23,250
!لديّ خدمة أطلبها منكم جميعًا

131
00:11:23,250 --> 00:11:27,550
...قفوا إلى جانب مجموعة أخي الكبير لوفي

132
00:11:27,550 --> 00:11:30,470
!ومجموعة مومونوسكي-كُن

133
00:11:42,200 --> 00:11:44,730
!بالتّأكيد يا سيّدتي-ساما

134
00:11:46,170 --> 00:11:48,650
!دعي الأمر لي يا سيّدتي-ساما

135
00:11:50,500 --> 00:11:53,530
!أطيحوا بكايدو! هيّا بنا

136
00:11:55,370 --> 00:11:57,950
!يا رفاق، اتبعوني

137
00:12:03,140 --> 00:12:04,710
!قوّتنا

138
00:12:04,710 --> 00:12:07,920
!سنستخدمها كلّ من أجل سيّدي-ساما

139
00:12:14,850 --> 00:12:18,930
!ما عادوا أتباعًا لك

140
00:12:18,930 --> 00:12:20,390
...إنّهم

141
00:12:21,060 --> 00:12:23,020
!رفاقي

142
00:12:24,200 --> 00:12:26,650
!خارق

143
00:12:31,570 --> 00:12:34,070
!أيّتها الوحدة المدرّعة

144
00:12:34,380 --> 00:12:38,580
،أعلم أنّ قدرة العدوّ تتلاعب بكم
...لكنّ ما تفعلونه

145
00:12:39,050 --> 00:12:41,960
!يُعتبر خيانة

146
00:13:02,240 --> 00:13:03,230
!كلاّ

147
00:13:09,290 --> 00:13:11,840
!أنت صلب للغاية

148
00:13:11,840 --> 00:13:14,900
!أعتقد أنّني سدّدت هجمات مميتة

149
00:13:15,500 --> 00:13:18,450
!أهو هو الصّلب والمزعج

150
00:13:21,590 --> 00:13:23,410
...لماذا لا

151
00:13:23,600 --> 00:13:27,120
!تبتعد عن طريقي في الحال؟

152
00:13:35,980 --> 00:13:40,470
سمعت أنّ كلّ أتباعنا قد غيّروا ولاءهم
...في طابق العرض أيضًا

153
00:13:44,740 --> 00:13:49,150
!سأذهب إلى هناك وأقتل كلّ من يقف ضدّنا

154
00:13:58,740 --> 00:14:02,410
!احموا بلاد وانو من أجلي

155
00:14:03,090 --> 00:14:07,370
!أنا أراك كجزء من قوّاتنا يا ياماتو

156
00:14:16,270 --> 00:14:18,880
!لا يقول الآباء أشياء كهذه لأبنائهم

157
00:14:22,070 --> 00:14:25,140
،حصلت على فاكهة الشّيطان بشقّ الأنفس

158
00:14:25,140 --> 00:14:28,520
!ولم أكن أنوي السّماح لك بأكلها

159
00:14:35,170 --> 00:14:36,150
...كنتُ

160
00:14:36,840 --> 00:14:38,700
!أتضوّر جوعًا

161
00:14:42,720 --> 00:14:44,580
!صُدمت أيضًا

162
00:14:44,890 --> 00:14:48,580
!مسعاي هو الإبحار، لكنّني لا أستطيع السّباحة

163
00:14:49,680 --> 00:14:53,260
،نويت قتلك مرّات لا تحصى

164
00:14:53,260 --> 00:14:55,800
!وصُرعت مرّات لا تحصى أيضًا

165
00:14:55,800 --> 00:14:57,880
!صرتُ أقوى بفضلك

166
00:15:00,730 --> 00:15:03,050
...ما أبقاني على الجزيرة

167
00:15:03,810 --> 00:15:06,260
!ليست هذه الأصفاد فحسب

168
00:15:08,620 --> 00:15:11,100
...إن لم أقاتل من أجل هذه البلاد

169
00:15:17,250 --> 00:15:20,700
!فلا أستطيع أن أدعو نفسي أودن

170
00:15:36,800 --> 00:15:39,920
!سأقوم بالأمر

171
00:15:53,230 --> 00:15:55,570
!سأعصف بكلّ شيء بعيدًا

172
00:15:55,570 --> 00:15:59,190
فعلاً...؟ هذا هو ما يوصف
!بهيئة الرّجل الوحش إذًا

173
00:15:59,460 --> 00:16:03,450
!روبوت لعين! سأركلك بعيدًا عن طريقي

174
00:16:07,380 --> 00:16:08,750
...الآليّة المخادعة

175
00:16:08,750 --> 00:16:10,830
!السّيف الدّوّار

176
00:16:19,270 --> 00:16:21,840
!ذلك السّيف الخطير ثانية؟

177
00:16:22,150 --> 00:16:25,090
!لن أبتعد عن طريقك

178
00:16:37,570 --> 00:16:39,650
!أخي الحديديّ

179
00:16:39,650 --> 00:16:41,280
!دعنا نساعدك

180
00:16:45,160 --> 00:16:47,550
!ساساكي، أرنا ما لديك

181
00:16:47,550 --> 00:16:48,880
!هيّا

182
00:16:48,880 --> 00:16:50,540
!أنا قادر على هذا

183
00:16:50,830 --> 00:16:53,830
!اذهبوا أنتم لمساعدة الآخرين

184
00:17:00,650 --> 00:17:02,510
!هذا مضحك

185
00:17:02,510 --> 00:17:06,180
.لا بدّ أنّ سعيد لزوال مصدر الإزعاج هؤلاء

186
00:17:08,930 --> 00:17:12,470
.يبدو أنّني لا أملك أيّ حلفاء حولي هنا

187
00:17:15,310 --> 00:17:18,650
!ماذا؟! ذلك الشّيء يدور؟

188
00:17:21,250 --> 00:17:23,030
...أهكذا هي

189
00:17:24,670 --> 00:17:26,110
!الدّيناصورات فعلاً؟

190
00:17:27,510 --> 00:17:28,660
!نعم، هكذا نحن

191
00:17:28,660 --> 00:17:30,280
...تـ-تلك التّقنية

192
00:17:30,720 --> 00:17:34,410
!أنت في خطر! اهرب يا أخي الحديديّ

193
00:17:36,840 --> 00:17:38,590
!أغبياء

194
00:17:38,590 --> 00:17:41,670
!لماذا لا تقلقون على نفسكم؟

195
00:17:42,760 --> 00:17:44,970
!سيراتوبس المروحيّ

196
00:17:54,530 --> 00:17:56,850
!يا رفاق

197
00:18:03,250 --> 00:18:05,430
!أيّ نوع من الهجمات هذه؟

198
00:18:05,430 --> 00:18:07,860
!أسيكون هجومًا جوّيًّا؟

199
00:18:13,720 --> 00:18:17,080
!يُسرى الجنرال

200
00:18:28,970 --> 00:18:30,590
...أنا

201
00:18:31,110 --> 00:18:33,510
!أهيمن على السّماء

202
00:18:47,290 --> 00:18:49,490
...هذا هي الدّيناصورات إذًا

203
00:18:50,050 --> 00:18:52,320
!هذا رائع

204
00:18:52,880 --> 00:18:54,870
...التّريسيراتوبس

205
00:18:55,080 --> 00:18:57,450
!ديناصور كهذا

206
00:19:03,760 --> 00:19:05,550
...لم أكن أعلم

207
00:19:10,610 --> 00:19:11,760
هل سيهاجم؟

208
00:19:11,760 --> 00:19:13,140
!بتلك السّرعة؟

209
00:19:14,740 --> 00:19:16,220
!حسنًا

210
00:19:21,290 --> 00:19:23,610
!أيّها الدّيناصور

211
00:19:24,160 --> 00:19:25,690
!أرني ما لديك

212
00:19:28,450 --> 00:19:30,570
!درع الجنرال

213
00:19:31,200 --> 00:19:32,950
!إنّه صغير جدًّا

214
00:19:34,410 --> 00:19:36,030
هل أنت يائس؟

215
00:19:36,380 --> 00:19:39,250
!سأجعله يتفتّك كالبسكويت

216
00:20:06,460 --> 00:20:07,280
...ها أنا

217
00:20:07,280 --> 00:20:08,400
!ماذا؟

218
00:20:10,460 --> 00:20:11,280
ماذا؟

219
00:20:15,220 --> 00:20:16,490
...مستحيل

220
00:20:17,880 --> 00:20:22,410
تُغيّر المراوح اتّجاه الاندفاع اعتمادًا
.على الطّريقة الّتي تدور بها

221
00:20:22,850 --> 00:20:28,670
...جعلها تدور بالطّريقة الخطأ

222
00:20:29,100 --> 00:20:32,010
.لذلك السّبب تراجع للخلف

223
00:20:33,890 --> 00:20:36,930
.أمّنتُ مساحة كافية لأقلع

224
00:20:37,350 --> 00:20:38,730
!لا تكذب

225
00:20:38,730 --> 00:20:40,010
!اخرس

226
00:20:40,240 --> 00:20:43,270
!كلّما طال إقلاعي، كان هجومي أقوى

227
00:20:44,360 --> 00:20:48,240
!أعتمد عليك يا درع الجنرال

228
00:20:48,240 --> 00:20:50,530
!رصاصة التّريسيراتوبس

229
00:20:58,340 --> 00:21:02,830
!كلاّ! القاذفة على كتفي ستنفجر

230
00:21:10,270 --> 00:21:11,340
!الوداع

231
00:21:12,400 --> 00:21:13,890
!سُحقًا لك

232
00:21:14,690 --> 00:21:16,220
!نلت منك

233
00:21:16,650 --> 00:21:17,890
...سوبلكس

234
00:21:18,360 --> 00:21:20,810
!الجنرال

235
00:21:33,420 --> 00:21:37,950
!قبّعة القشّ

236
00:21:38,200 --> 00:21:39,880
!عد للحياة

237
00:21:39,880 --> 00:21:42,990
!عد للحياة يا قبّعة القشّ

238
00:21:44,050 --> 00:21:45,250
!سُحقًا

239
00:21:45,250 --> 00:21:47,460
!ليت القبطان كان هنا

240
00:21:47,460 --> 00:21:49,670
أفرغنا رئتيه من الماء بالكامل، صحيح؟

241
00:21:49,930 --> 00:21:52,300
!ماذا بإمكاننا أن نفعل أكثر؟

242
00:21:52,300 --> 00:21:54,310
أعلينا منحه دواءً ما؟

243
00:21:54,310 --> 00:21:56,380
!كلاّ، بل علينا حقنه به

244
00:21:56,780 --> 00:21:58,260
!يبدو شاحبًا

245
00:21:58,650 --> 00:22:00,140
!يا قبّعة القشّ

246
00:22:00,140 --> 00:22:01,990
!استيقظ

247
00:22:01,990 --> 00:22:03,270
!ماذا نفعل؟

248
00:22:03,270 --> 00:22:11,810
!قبّعة القشّ

249
00:22:08,440 --> 00:22:09,150
!مهلاً

250
00:22:31,920 --> 00:22:34,550
!يا قبّعة القشّ! حمدًا لله

251
00:22:37,090 --> 00:22:38,180
!...لحـ

252
00:22:38,180 --> 00:22:39,340
لح؟

253
00:22:39,810 --> 00:22:45,390
...لحـ

254
00:22:41,680 --> 00:22:43,020
لح؟

255
00:22:47,850 --> 00:22:49,770
!لحم

256
00:22:50,230 --> 00:22:52,690
!ماذا؟

257
00:22:52,690 --> 00:22:55,650
!أريد لحمًا

258
00:23:04,540 --> 00:23:06,560
أهذا حلم أم واقع؟

259
00:23:06,560 --> 00:23:11,840
أشخاص طيّبون عرفتهم روبين في أوهارا
.إضافة لوالدتها يقفون أمامها الآن

260
00:23:11,840 --> 00:23:14,900
.لقد كانوا بصيص أمل لروبن الصّغيرة

261
00:23:14,900 --> 00:23:18,950
،هل ستقودها أصواتهم إلى نهاية حلقة مأساويّة

262
00:23:18,950 --> 00:23:21,760
أم ستكون بداية رحلة وحيدة؟

263
00:23:22,470 --> 00:23:27,270
:في الحلقة القادمة من وان بيس
".فخّ المفترس، إغواءات بلاك ماريا"

264
00:23:27,270 --> 00:23:31,640
!ملك القراصنة، لن يكون إلاّ أنا