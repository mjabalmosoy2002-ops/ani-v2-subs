1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:44,630 --> 00:01:49,430
فلنلوّنها بألواننا الخاصّة

19
00:01:58,450 --> 00:02:03,740
.يتحدّى كلّ من لوفي وزورو ولو وكيد وكيلر كايدو

20
00:02:11,010 --> 00:02:12,200
...مُطهّر

21
00:02:12,200 --> 00:02:13,370
!قاطع الغول

22
00:02:13,370 --> 00:02:15,410
!مخالب قطع الأعناق

23
00:02:19,430 --> 00:02:21,550
!مسدّس كونغ

24
00:02:21,550 --> 00:02:25,990
!كما تريد، سأريك كم أنا قويّ

25
00:02:25,990 --> 00:02:28,050
!الملزمة المغناطيسيّة

26
00:02:28,510 --> 00:02:29,510
!عصا الإيقاع

27
00:02:34,490 --> 00:02:38,810
هذا ما توقّعته من أغبياء يطمحون
.ليكونوا ملك القراصنة

28
00:02:38,810 --> 00:02:40,140
...لكن

29
00:02:40,870 --> 00:02:43,560
!ما عدتم تستطيعون إيقافي

30
00:02:49,050 --> 00:02:54,370
!إله البرق تنجين

31
00:03:00,260 --> 00:03:05,290
ردّت بيغ مام القتال وانقلبت
.الموازين ضدّ لوفي والبقيّة

32
00:03:13,740 --> 00:03:14,970
!يا قبّعة القشّ

33
00:03:15,140 --> 00:03:18,640
!لماذا لم تتأذّ بسبب البرق؟

34
00:03:25,210 --> 00:03:28,480
!لأنّني مطّاطيّ

35
00:03:31,990 --> 00:03:34,620
!كيف تجرئين على أذيّة زورو والبقيّة

36
00:03:37,220 --> 00:03:39,290
!نَفَس الانفجار

37
00:03:47,560 --> 00:03:50,710
!لا تنفع النّار ضدّه أيضًا؟! لماذا؟

38
00:03:53,850 --> 00:03:56,140
!بسبب شجاعتي

39
00:03:57,060 --> 00:03:59,640
...فاكهة المطّاط

40
00:04:02,740 --> 00:04:03,980
...مدفع كونغ

41
00:04:08,170 --> 00:04:11,820
!الرّشّاش

42
00:04:16,670 --> 00:04:20,710
"!ضحك كايدو! اليونكو ضدّ الجيل الأسوأ"

43
00:07:17,190 --> 00:07:18,300
!هل نجح؟

44
00:07:57,190 --> 00:07:58,710
!كايدو

45
00:08:40,230 --> 00:08:44,420
!سيقضي هذا عليك يا كايدو

46
00:09:20,380 --> 00:09:21,250
!كلاّ

47
00:09:26,390 --> 00:09:29,770
!يا قبّعة القشّ؟! متى أُصبت؟

48
00:09:29,770 --> 00:09:31,620
!لم يُصب

49
00:09:31,620 --> 00:09:34,350
!إنّه تأثير ثانويّ لتقنيته الشّبيهة بالكرة الحديديّة تلك

50
00:09:34,700 --> 00:09:37,980
!لا يستطيع استعمال الهاكي لحوالي عشر دقائق الآن

51
00:09:37,980 --> 00:09:41,190
.فهمت. قوّة تحمل مخاطر في طيّاتها

52
00:09:41,830 --> 00:09:46,450
لكن إن كانت كلّ تلك الهجمات
،قد أجدت نفعًا ضدّه

53
00:09:46,450 --> 00:09:48,700
!فهذه فرصتنا للقضاء عليه

54
00:09:54,090 --> 00:09:57,290
!لا تعلّقوا الكثير من الآمال

55
00:10:05,510 --> 00:10:08,430
!لوفي! عليك التّحرّك وإلاّ متّ

56
00:10:12,570 --> 00:10:15,850
!ماذا؟ أنت منهك سلفًا؟

57
00:10:15,850 --> 00:10:18,440
!أحسنت صنعًا بهيجانك ذاك

58
00:10:19,200 --> 00:10:22,610
!لننهِ هذا الأمر الآن

59
00:10:23,190 --> 00:10:25,730
!سيف الأمّ المستعر

60
00:10:30,380 --> 00:10:33,450
!سلّم قبّعة القشّ لي

61
00:10:36,960 --> 00:10:38,620
!صدمة مضادّة

62
00:10:45,690 --> 00:10:47,710
!لوفي! استيقظ

63
00:10:58,770 --> 00:11:01,980
!لنشنّ هجمات أخرى على كايدو يا كيلر

64
00:11:02,160 --> 00:11:03,280
!حاضر

65
00:11:50,840 --> 00:11:53,070
!كيلر! انتبه

66
00:12:10,230 --> 00:12:13,450
...الرّياح الّتي تهبّ نحو السّماء

67
00:12:13,450 --> 00:12:16,290
...تدمّر كلّ شيء

68
00:12:16,290 --> 00:12:18,640
!إعصار التّنّين

69
00:12:21,700 --> 00:12:22,980
!كيلر

70
00:12:31,750 --> 00:12:33,400
!هذا غير معقول

71
00:12:33,670 --> 00:12:36,450
!هذا أشبه بكارثة طبيعيّة

72
00:12:38,880 --> 00:12:41,500
...زورو، شكرًا

73
00:12:42,220 --> 00:12:43,330
!العفو

74
00:12:58,220 --> 00:12:59,510
!لوفي

75
00:13:02,310 --> 00:13:03,520
!لوفي

76
00:13:18,160 --> 00:13:19,620
!لوفي

77
00:13:43,940 --> 00:13:45,390
!لوفي

78
00:13:52,700 --> 00:13:54,260
!مهلاً، مهلاً

79
00:13:54,260 --> 00:13:57,700
!أيّها الوغد! لا تبتلع قبطاننا

80
00:14:43,010 --> 00:14:44,950
!فهمت

81
00:14:46,470 --> 00:14:51,920
!شعرت بذلك الهاكي الغريب من ذلك السّيف

82
00:15:07,820 --> 00:15:09,310
!أسلوب السّيوف الثّلاثة

83
00:15:10,040 --> 00:15:12,850
!إعصار تنّين الحبل الأسود العظيم

84
00:15:27,500 --> 00:15:28,950
!قَطَع حراشفه

85
00:15:36,010 --> 00:15:39,210
!ذلك الشّقيّ! تمكّن من قطع كايدو

86
00:15:52,790 --> 00:15:55,520
!كم هذا مؤلم

87
00:15:56,210 --> 00:15:57,880
...فهمت

88
00:15:57,880 --> 00:16:00,900
...كما توقّعت، ذلك السّيف

89
00:16:02,990 --> 00:16:05,490
!أسلوب أودن للسّيفين

90
00:16:06,170 --> 00:16:09,620
!هو سيف أودن، صحيح؟

91
00:16:15,680 --> 00:16:19,010
...استطاع أن ينافسني باستعمال إعصار التّنّين

92
00:16:19,010 --> 00:16:22,010
!إنّه لا يعرف حدوده

93
00:16:39,860 --> 00:16:41,360
!يا لوفي

94
00:16:41,750 --> 00:16:43,740
زورو؟

95
00:16:49,430 --> 00:16:50,910
!انتبهوا من الهجمات الكبيرة

96
00:16:57,850 --> 00:16:59,960
...إعصار التّنّين

97
00:17:00,400 --> 00:17:02,960
!الرّيح النّاسفة

98
00:17:43,730 --> 00:17:44,960
...يا إلهي

99
00:17:59,870 --> 00:18:02,150
،لم نتوقّع أبدًا أنّ مورّدنا سيموت

100
00:18:02,150 --> 00:18:05,260
...والوليمة الّتي دُعينا إليها

101
00:18:05,260 --> 00:18:08,150
.ستتحوّل إلى ساحة معركة

102
00:18:16,080 --> 00:18:21,040
سمعتُ أنّها معركة للثّأر لشخص مات
.قبل عشرين سنة في هذه البلاد

103
00:18:23,100 --> 00:18:24,170
.نعم

104
00:18:24,520 --> 00:18:28,200
،لكن عندما خسر دوفلامينغو سلطته

105
00:18:28,200 --> 00:18:32,430
.صار الصّراع بين كايدو والجيل الأسوأ محتومًا

106
00:18:35,160 --> 00:18:37,190
...مسدّس الملك

107
00:18:37,190 --> 00:18:39,190
!خيط الإله

108
00:18:39,190 --> 00:18:40,570
!كونغ

109
00:19:01,250 --> 00:19:03,670
...كان القدر

110
00:19:04,190 --> 00:19:07,840
.ما جمع بين السّاموراي والقراصنة معًا

111
00:19:09,390 --> 00:19:13,720
.في الوقت الّذي يوشك فيه وضع العالم أن يتغيّر

112
00:19:14,740 --> 00:19:20,140
...إذا ما صادف وقُضي على كِلا هذين اليونكو

113
00:19:24,120 --> 00:19:27,480
.فلن يستطيع أحد الجزم بما سيحلّ بالعالم

114
00:19:31,250 --> 00:19:33,410
.لكن لا داعي للقلق حيال ذلك

115
00:19:41,640 --> 00:19:45,420
...أعداد العدوّ الّذي أغار على الجزيرة

116
00:19:46,190 --> 00:19:51,370
!هي 5400

117
00:19:51,370 --> 00:19:53,890
لكنّ 400 منهم قد سقطوا سلفًا

118
00:19:57,360 --> 00:19:59,680
...ومن جهة أخرى

119
00:20:00,580 --> 00:20:05,380
...نحن قراصنة مملكة الحيوان

120
00:20:05,380 --> 00:20:09,300
لدينا أزيد من 30000 رجل

121
00:20:09,300 --> 00:20:11,320
لكنّ 3000 منهم فقط من سقطوا

122
00:20:12,500 --> 00:20:15,530
.أبلى السّاموراي بلاءً حسنًا

123
00:20:18,330 --> 00:20:23,500
الفارق في القوى يعني أنّهم لا يستطيعون
.حتّى بلوغ القائد إن هاجموا مباشرة

124
00:20:24,680 --> 00:20:28,290
.عمليّة القيام بهجوم متسلّل ناجح كانت مذهلة

125
00:20:29,150 --> 00:20:34,880
لكنّ هذه المعركة لن تنتهي حتّى
.إن قطعوا عنق القائد

126
00:20:43,580 --> 00:20:47,810
.هذه حرب شاملة، لا ملاذ آمن على الجزيرة

127
00:20:48,370 --> 00:20:52,720
،إن أطلقوا العنان لضبّاط كايدو الكبار الأقوياء

128
00:20:52,720 --> 00:20:56,070
.فإنّهم سيطيحون بمائة رجل دفعة واحدة

129
00:21:03,760 --> 00:21:08,250
...إن لم يستطع الجيل الأسوأ إيقاف الضّبّاط الكبار

130
00:21:12,650 --> 00:21:17,470
فإنّ لعبة الغو هذه ستنتهي بسيادة
.تامّة للقطع السّوداء

131
00:21:21,530 --> 00:21:24,770
...واضح تمامًا ما الجانب الّذي سيفوز

132
00:21:31,290 --> 00:21:34,360
...اسحقوا أكثر عدد ممكن من الجانب الآخر

133
00:21:35,130 --> 00:21:37,570
.أيّها القراصنة

134
00:22:16,540 --> 00:22:19,660
!لم أره في تلك الهيئة من قبل

135
00:22:26,680 --> 00:22:28,620
أتلك هي هيئة الوحش البشريّ خاصّته؟

136
00:22:30,810 --> 00:22:32,880
!يا لينلين

137
00:22:33,850 --> 00:22:35,840
!هذا ممتع

138
00:22:40,070 --> 00:22:44,100
!كنت أفكّر في نفس الشّيء

139
00:22:50,700 --> 00:22:53,480
!كايدو

140
00:23:04,430 --> 00:23:07,370
.فتاة تتمنّى مستقبلاً أفضل لبلاد وانو

141
00:23:07,370 --> 00:23:13,340
تنفّذ أوتاما الّتي تركض عبر أونيغاشيما
!المضطربة خطّتها بكلّ عزم

142
00:23:13,340 --> 00:23:15,420
،لإنقاذ أصدقائها الّذين يقاتلون بلا دعم

143
00:23:15,420 --> 00:23:22,220
هل ستكون قادرة على منحهم فرصة للتّعافي وقلب
!موازين المعركة الّتي لصالح جيش كايدو ضدّهم؟

144
00:23:22,560 --> 00:23:27,080
:في الحلقة القادمة من وان بيس
"!خطّة أوتاما السّرّيّة! عمليّة الكيبي دانغو"

145
00:23:27,080 --> 00:23:31,640
!ملك القراصنة، لن يكون إلاّ أنا