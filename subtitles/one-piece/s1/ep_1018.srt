1
00:00:10,480 --> 00:00:17,660
مدّ يدك واقطع الرّياح

2
00:00:17,660 --> 00:00:22,330
ارسم خريطتك الخاصّة

3
00:00:26,920 --> 00:00:33,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:33,590 --> 00:00:40,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:40,060 --> 00:00:46,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:46,350 --> 00:00:49,730
لا يمكن لأحد الجزم بذلك

7
00:00:49,730 --> 00:00:56,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:56,240 --> 00:01:03,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:01:03,200 --> 00:01:09,840
مدّ يدك واقطع الرّياح

10
00:01:09,840 --> 00:01:14,510
اركل الظّلمة بعيدًا

11
00:01:15,510 --> 00:01:22,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:22,720 --> 00:01:26,600
وأنا جاهز لذلك

13
00:01:26,600 --> 00:01:32,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:32,360 --> 00:01:39,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:39,070 --> 00:01:45,790
مدّ يدك واقطع الرّياح

16
00:01:45,790 --> 00:01:51,420
اركل الظّلمة بعيدًا

17
00:01:51,420 --> 00:01:58,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:58,630 --> 00:02:03,430
فلنلوّنها بألواننا الخاصّة

19
00:02:12,450 --> 00:02:17,740
.يتحدّى كلّ من لوفي وزورو ولو وكيد وكيلر كايدو

20
00:02:25,010 --> 00:02:26,200
...مُطهّر

21
00:02:26,200 --> 00:02:27,370
!قاطع الغول

22
00:02:27,370 --> 00:02:29,410
!مخالب قطع الأعناق

23
00:02:33,430 --> 00:02:35,550
!مسدّس كونغ

24
00:02:35,550 --> 00:02:39,990
!كما تريد، سأريك كم أنا قويّ

25
00:02:39,990 --> 00:02:42,050
!الملزمة المغناطيسيّة

26
00:02:42,510 --> 00:02:43,510
!عصا الإيقاع

27
00:02:48,490 --> 00:02:52,810
هذا ما توقّعته من أغبياء يطمحون
.ليكونوا ملك القراصنة

28
00:02:52,810 --> 00:02:54,140
...لكن

29
00:02:54,870 --> 00:02:57,560
!ما عدتم تستطيعون إيقافي

30
00:03:03,050 --> 00:03:08,370
!إله البرق تنجين

31
00:03:14,260 --> 00:03:19,290
ردّت بيغ مام القتال وانقلبت
.الموازين ضدّ لوفي والبقيّة

32
00:03:27,740 --> 00:03:28,970
!يا قبّعة القشّ

33
00:03:29,140 --> 00:03:32,640
!لماذا لم تتأذّ بسبب البرق؟

34
00:03:39,210 --> 00:03:42,480
!لأنّني مطّاطيّ

35
00:03:45,990 --> 00:03:48,620
!كيف تجرئين على أذيّة زورو والبقيّة

36
00:03:51,220 --> 00:03:53,290
!نَفَس الانفجار

37
00:04:01,560 --> 00:04:04,710
!لا تنفع النّار ضدّه أيضًا؟! لماذا؟

38
00:04:07,850 --> 00:04:10,140
!بسبب شجاعتي

39
00:04:11,060 --> 00:04:13,640
...فاكهة المطّاط

40
00:04:16,740 --> 00:04:17,980
...مدفع كونغ

41
00:04:22,170 --> 00:04:25,820
!الرّشّاش

42
00:04:30,670 --> 00:04:34,710
"!ضحك كايدو! اليونكو ضدّ الجيل الأسوأ"

43
00:07:31,190 --> 00:07:32,300
!هل نجح؟

44
00:08:11,190 --> 00:08:12,710
!كايدو

45
00:08:54,230 --> 00:08:58,420
!سيقضي هذا عليك يا كايدو

46
00:09:34,380 --> 00:09:35,250
!كلاّ

47
00:09:40,390 --> 00:09:43,770
!يا قبّعة القشّ؟! متى أُصبت؟

48
00:09:43,770 --> 00:09:45,620
!لم يُصب

49
00:09:45,620 --> 00:09:48,350
!إنّه تأثير ثانويّ لتقنيته الشّبيهة بالكرة الحديديّة تلك

50
00:09:48,700 --> 00:09:51,980
!لا يستطيع استعمال الهاكي لحوالي عشر دقائق الآن

51
00:09:51,980 --> 00:09:55,190
.فهمت. قوّة تحمل مخاطر في طيّاتها

52
00:09:55,830 --> 00:10:00,450
لكن إن كانت كلّ تلك الهجمات
،قد أجدت نفعًا ضدّه

53
00:10:00,450 --> 00:10:02,700
!فهذه فرصتنا للقضاء عليه

54
00:10:08,090 --> 00:10:11,290
!لا تعلّقوا الكثير من الآمال

55
00:10:19,510 --> 00:10:22,430
!لوفي! عليك التّحرّك وإلاّ متّ

56
00:10:26,570 --> 00:10:29,850
!ماذا؟ أنت منهك سلفًا؟

57
00:10:29,850 --> 00:10:32,440
!أحسنت صنعًا بهيجانك ذاك

58
00:10:33,200 --> 00:10:36,610
!لننهِ هذا الأمر الآن

59
00:10:37,190 --> 00:10:39,730
!سيف الأمّ المستعر

60
00:10:44,380 --> 00:10:47,450
!سلّم قبّعة القشّ لي

61
00:10:50,960 --> 00:10:52,620
!صدمة مضادّة

62
00:10:59,690 --> 00:11:01,710
!لوفي! استيقظ

63
00:11:12,770 --> 00:11:15,980
!لنشنّ هجمات أخرى على كايدو يا كيلر

64
00:11:16,160 --> 00:11:17,280
!حاضر

65
00:12:04,840 --> 00:12:07,070
!كيلر! انتبه

66
00:12:24,230 --> 00:12:27,450
...الرّياح الّتي تهبّ نحو السّماء

67
00:12:27,450 --> 00:12:30,290
...تدمّر كلّ شيء

68
00:12:30,290 --> 00:12:32,640
!إعصار التّنّين

69
00:12:35,700 --> 00:12:36,980
!كيلر

70
00:12:45,750 --> 00:12:47,400
!هذا غير معقول

71
00:12:47,670 --> 00:12:50,450
!هذا أشبه بكارثة طبيعيّة

72
00:12:52,880 --> 00:12:55,500
...زورو، شكرًا

73
00:12:56,220 --> 00:12:57,330
!العفو

74
00:13:12,220 --> 00:13:13,510
!لوفي

75
00:13:16,310 --> 00:13:17,520
!لوفي

76
00:13:32,160 --> 00:13:33,620
!لوفي

77
00:13:57,940 --> 00:13:59,390
!لوفي

78
00:14:06,700 --> 00:14:08,260
!مهلاً، مهلاً

79
00:14:08,260 --> 00:14:11,700
!أيّها الوغد! لا تبتلع قبطاننا

80
00:14:57,010 --> 00:14:58,950
!فهمت

81
00:15:00,470 --> 00:15:05,920
!شعرت بذلك الهاكي الغريب من ذلك السّيف

82
00:15:21,820 --> 00:15:23,310
!أسلوب السّيوف الثّلاثة

83
00:15:24,040 --> 00:15:26,850
!إعصار تنّين الحبل الأسود العظيم

84
00:15:41,500 --> 00:15:42,950
!قَطَع حراشفه

85
00:15:50,010 --> 00:15:53,210
!ذلك الشّقيّ! تمكّن من قطع كايدو

86
00:16:06,790 --> 00:16:09,520
!كم هذا مؤلم

87
00:16:10,210 --> 00:16:11,880
...فهمت

88
00:16:11,880 --> 00:16:14,900
...كما توقّعت، ذلك السّيف

89
00:16:16,990 --> 00:16:19,490
!أسلوب أودن للسّيفين

90
00:16:20,170 --> 00:16:23,620
!هو سيف أودن، صحيح؟

91
00:16:29,680 --> 00:16:33,010
...استطاع أن ينافسني باستعمال إعصار التّنّين

92
00:16:33,010 --> 00:16:36,010
!إنّه لا يعرف حدوده

93
00:16:53,860 --> 00:16:55,360
!يا لوفي

94
00:16:55,750 --> 00:16:57,740
زورو؟

95
00:17:03,430 --> 00:17:04,910
!انتبهوا من الهجمات الكبيرة

96
00:17:11,850 --> 00:17:13,960
...إعصار التّنّين

97
00:17:14,400 --> 00:17:16,960
!الرّيح النّاسفة

98
00:17:57,730 --> 00:17:58,960
...يا إلهي

99
00:18:13,870 --> 00:18:16,150
،لم نتوقّع أبدًا أنّ مورّدنا سيموت

100
00:18:16,150 --> 00:18:19,260
...والوليمة الّتي دُعينا إليها

101
00:18:19,260 --> 00:18:22,150
.ستتحوّل إلى ساحة معركة

102
00:18:30,080 --> 00:18:35,040
سمعتُ أنّها معركة للثّأر لشخص مات
.قبل عشرين سنة في هذه البلاد

103
00:18:37,100 --> 00:18:38,170
.نعم

104
00:18:38,520 --> 00:18:42,200
،لكن عندما خسر دوفلامينغو سلطته

105
00:18:42,200 --> 00:18:46,430
.صار الصّراع بين كايدو والجيل الأسوأ محتومًا

106
00:18:49,160 --> 00:18:51,190
...مسدّس الملك

107
00:18:51,190 --> 00:18:53,190
!خيط الإله

108
00:18:53,190 --> 00:18:54,570
!كونغ

109
00:19:15,250 --> 00:19:17,670
...كان القدر

110
00:19:18,190 --> 00:19:21,840
.ما جمع بين السّاموراي والقراصنة معًا

111
00:19:23,390 --> 00:19:27,720
.في الوقت الّذي يوشك فيه وضع العالم أن يتغيّر

112
00:19:28,740 --> 00:19:34,140
...إذا ما صادف وقُضي على كِلا هذين اليونكو

113
00:19:38,120 --> 00:19:41,480
.فلن يستطيع أحد الجزم بما سيحلّ بالعالم

114
00:19:45,250 --> 00:19:47,410
.لكن لا داعي للقلق حيال ذلك

115
00:19:55,640 --> 00:19:59,420
...أعداد العدوّ الّذي أغار على الجزيرة

116
00:20:00,190 --> 00:20:05,370
!هي 5400

117
00:20:05,370 --> 00:20:07,890
لكنّ 400 منهم قد سقطوا سلفًا

118
00:20:11,360 --> 00:20:13,680
...ومن جهة أخرى

119
00:20:14,580 --> 00:20:19,380
...نحن قراصنة مملكة الحيوان

120
00:20:19,380 --> 00:20:23,300
لدينا أزيد من 30000 رجل

121
00:20:23,300 --> 00:20:25,320
لكنّ 3000 منهم فقط من سقطوا

122
00:20:26,500 --> 00:20:29,530
.أبلى السّاموراي بلاءً حسنًا

123
00:20:32,330 --> 00:20:37,500
الفارق في القوى يعني أنّهم لا يستطيعون
.حتّى بلوغ القائد إن هاجموا مباشرة

124
00:20:38,680 --> 00:20:42,290
.عمليّة القيام بهجوم متسلّل ناجح كانت مذهلة

125
00:20:43,150 --> 00:20:48,880
لكنّ هذه المعركة لن تنتهي حتّى
.إن قطعوا عنق القائد

126
00:20:57,580 --> 00:21:01,810
.هذه حرب شاملة، لا ملاذ آمن على الجزيرة

127
00:21:02,370 --> 00:21:06,720
،إن أطلقوا العنان لضبّاط كايدو الكبار الأقوياء

128
00:21:06,720 --> 00:21:10,070
.فإنّهم سيطيحون بمائة رجل دفعة واحدة

129
00:21:17,760 --> 00:21:22,250
...إن لم يستطع الجيل الأسوأ إيقاف الضّبّاط الكبار

130
00:21:26,650 --> 00:21:31,470
فإنّ لعبة الغو هذه ستنتهي بسيادة
.تامّة للقطع السّوداء

131
00:21:35,530 --> 00:21:38,770
...واضح تمامًا ما الجانب الّذي سيفوز

132
00:21:45,290 --> 00:21:48,360
...اسحقوا أكثر عدد ممكن من الجانب الآخر

133
00:21:49,130 --> 00:21:51,570
.أيّها القراصنة

134
00:22:30,540 --> 00:22:33,660
!لم أره في تلك الهيئة من قبل

135
00:22:40,680 --> 00:22:42,620
أتلك هي هيئة الوحش البشريّ خاصّته؟

136
00:22:44,810 --> 00:22:46,880
!يا لينلين

137
00:22:47,850 --> 00:22:49,840
!هذا ممتع

138
00:22:54,070 --> 00:22:58,100
!كنت أفكّر في نفس الشّيء

139
00:23:04,700 --> 00:23:07,480
!كايدو

140
00:23:18,430 --> 00:23:21,370
.فتاة تتمنّى مستقبلاً أفضل لبلاد وانو

141
00:23:21,370 --> 00:23:27,340
تنفّذ أوتاما الّتي تركض عبر أونيغاشيما
!المضطربة خطّتها بكلّ عزم

142
00:23:27,340 --> 00:23:29,420
،لإنقاذ أصدقائها الّذين يقاتلون بلا دعم

143
00:23:29,420 --> 00:23:36,220
هل ستكون قادرة على منحهم فرصة للتّعافي وقلب
!موازين المعركة الّتي لصالح جيش كايدو ضدّهم؟

144
00:23:36,560 --> 00:23:41,080
:في الحلقة القادمة من وان بيس
"!خطّة أوتاما السّرّيّة! عمليّة الكيبي دانغو"

145
00:23:41,080 --> 00:23:45,640
!ملك القراصنة، لن يكون إلاّ أنا