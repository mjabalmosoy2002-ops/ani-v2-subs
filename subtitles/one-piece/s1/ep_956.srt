1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:11,040 --> 00:02:15,160
سنقيم أعظم احتفال على الإطلاق
!في ليلة مهرجان النّار

29
00:02:15,460 --> 00:02:18,040
.صحيح، سيكون ذكرى سنويّة

30
00:02:18,420 --> 00:02:20,750
!اسمعوا يا هؤلاء

31
00:02:20,750 --> 00:02:21,460
!ماذا هنالك؟

32
00:02:21,880 --> 00:02:24,720
...نحن قراصنة مملكة الحيوان

33
00:02:25,050 --> 00:02:27,590
...وقراصنة بيغ مام

34
00:02:28,260 --> 00:02:29,490
.دعني أقف

35
00:02:29,490 --> 00:02:31,310
...قد قرّرنا

36
00:02:31,430 --> 00:02:33,280
...أن نشكّل

37
00:02:33,280 --> 00:02:35,180
!تحالفًا

38
00:02:35,770 --> 00:02:38,100
.يقع ميناء توكاغي في أودون

39
00:02:38,520 --> 00:02:42,940
وعن طريق تغيير نقطة اللّقاء
،من ميناء هابو إلى ميناء توكاغي

40
00:02:42,940 --> 00:02:47,070
فحتّى أذكى وأمكر الأعداء
.لن يتمكّنوا من اعتراض خطّتنا

41
00:02:47,490 --> 00:02:49,030
...إنّ ياسويي-ساما

42
00:02:49,820 --> 00:02:55,750
قد أخذ في عين الاعتبار كلّ احتماليّة
.وخطى خطوات باكرًا من أجلنا على الأرجح

43
00:02:57,830 --> 00:03:01,590
...سنطيح برأسَيْ كايدو وأوروتشي بأيّ ثمن

44
00:03:01,590 --> 00:03:06,220
!لنثأر لأودن-ساما المتوفّى

45
00:03:09,680 --> 00:03:14,140
!وقت المعركة الكبرى وشيك"
"!يدخل قراصنة قبّعة القشّ وضع القتال

46
00:03:19,690 --> 00:03:21,650
...هل هذا صحيح

47
00:03:22,020 --> 00:03:24,110
!بالفعل؟

48
00:03:24,110 --> 00:03:25,710
.نعم، هذا صحيح

49
00:03:25,710 --> 00:03:28,990
!هيوري-ساما حيّة؟

50
00:03:29,570 --> 00:03:32,660
.نعم، إنّها حيّة

51
00:03:35,830 --> 00:03:39,580
...أنا جدّ قلقة بشأن أوتوكو

52
00:03:40,080 --> 00:03:43,460
،ومع ذلك يا كاواماتسو

53
00:03:43,460 --> 00:03:47,340
.لن أقابل الجميع الآن

54
00:03:47,670 --> 00:03:51,760
لا يجب على أن يسمح النّاس
.للمشاعر أن تغلبهم قبل المعارك

55
00:03:54,470 --> 00:03:56,560
،معًا رفقة الجميع

56
00:03:56,560 --> 00:04:01,940
!أنقذوا بلاد وانو رجاءً

57
00:04:02,860 --> 00:04:04,940
!يا صاحبة السّموّ! لا ينبغي لك ذلك

58
00:04:12,700 --> 00:04:17,460
!قالت تلك الشّيطانة الصّغيرة كلامًا مهذّبًا كهذا

59
00:04:17,460 --> 00:04:19,750
!لقد كبرت بالفعل

60
00:04:19,850 --> 00:04:26,140
،كاواماتسو! بما أنّك كنت في السّجن
،ظننتُ أنّ شيئًا سيّئًا حلّ بها

61
00:04:26,140 --> 00:04:28,670
!لذلك لم أستطع أن أسألك

62
00:04:30,630 --> 00:04:31,760
أين هي الآن؟

63
00:04:31,760 --> 00:04:33,490
!أهي مع حارس ما؟

64
00:04:33,490 --> 00:04:37,270
.لا تقلق. إنّها في مكان آمن

65
00:04:38,890 --> 00:04:40,640
!على أيّ حال، ذلك رائع

66
00:04:40,640 --> 00:04:43,020
!رائع بالفعل

67
00:04:48,480 --> 00:04:50,650
...إنّها حيّة

68
00:04:58,290 --> 00:05:00,500
!أخي الكبير

69
00:05:01,460 --> 00:05:02,350
!هيوري

70
00:05:02,350 --> 00:05:04,080
!ركلة انقضاضيّة

71
00:05:09,760 --> 00:05:11,130
!هيوري

72
00:05:11,720 --> 00:05:13,630
!زوروجورو

73
00:05:14,390 --> 00:05:16,510
هل أنقذتها؟

74
00:05:17,060 --> 00:05:18,690
!شكرًا لك

75
00:05:18,690 --> 00:05:22,350
،قد تكون فظّة قليلاً، لكنّها ضعيفة في الحقيقة

76
00:05:22,350 --> 00:05:25,160
.وتبكي كثيرًا، لذلك قد تكون صعبة المراس

77
00:05:25,160 --> 00:05:28,940
!يا مومو. أما زلت تظنّ أنّكما ما زلتما في الماضي؟

78
00:05:29,440 --> 00:05:32,700
.إنّها الآن أكبر منك بثماني عشرة سنة

79
00:05:37,450 --> 00:05:39,290
!ركلة انقضاضيّة

80
00:05:40,870 --> 00:05:43,630
ركلة انقضاضيّة من شخص
!يكبرني بثماني عشرة سنة؟

81
00:05:43,630 --> 00:05:45,750
...ذلك سيّئ

82
00:05:46,790 --> 00:05:49,840
...تلك الحسناء الّتي كانت معك حينها

83
00:05:49,840 --> 00:05:52,630
!كانت أخت مومونوسكي؟

84
00:05:56,720 --> 00:05:58,390
ما-ماذا؟

85
00:06:04,060 --> 00:06:06,410
!مومونوسكي-كُن

86
00:06:06,410 --> 00:06:09,170
أهنالك ما يمكنني فعله لك؟

87
00:06:09,170 --> 00:06:11,780
.لا تتملّق أخاها يا غبيّ

88
00:06:12,110 --> 00:06:13,490
.سانغورو-دونو

89
00:06:13,490 --> 00:06:16,160
.كفاك عبثًا

90
00:06:16,780 --> 00:06:19,410
!كاواماتسو! إنّهم جاهزون

91
00:06:21,040 --> 00:06:23,870
أواثق بشأن هذا؟

92
00:06:23,870 --> 00:06:24,960
.نعم

93
00:06:25,420 --> 00:06:27,940
...وصلنا إلى اتّفاق بالفعل

94
00:06:27,940 --> 00:06:29,630
.فهمت

95
00:06:30,130 --> 00:06:32,460
.لن أضيف أيّ شيء إذًا

96
00:06:32,920 --> 00:06:33,880
!هيتتسو-دونو

97
00:06:34,300 --> 00:06:35,980
.خذ هذا أوّلاً

98
00:06:35,980 --> 00:06:40,990
هذا هو كيتتسو الثّاني الّذي تمّت مصادرته
.من لوفيتارو-دونو في أودون

99
00:06:40,990 --> 00:06:43,140
!شكرًا لك

100
00:06:44,230 --> 00:06:46,890
!ذلك الشّقيّ الجشع

101
00:06:46,890 --> 00:06:49,190
.أخذه دون إذني

102
00:06:50,360 --> 00:06:51,610
!كيتتسو

103
00:06:54,570 --> 00:06:56,700
.عرفتُ أنّه كان أحد السّيوف الأسطوريّة

104
00:06:58,450 --> 00:07:02,410
!هارك! اسمي تنغوياما هيتتسو

105
00:07:02,410 --> 00:07:05,830
!أنا صانع سيوف من بلاد وانو

106
00:07:06,540 --> 00:07:07,970
،وطوال عقدين

107
00:07:07,970 --> 00:07:13,340
كنت أنتظر اليوم الّذي أستطيع فيه
إعادة هذين السّيفين

108
00:07:13,340 --> 00:07:16,010
!إلى مومونوسكي-ساما وهيوري-ساما

109
00:07:23,640 --> 00:07:26,560
.لقد كانا سيفا أودن-ساما العزيزين

110
00:07:26,560 --> 00:07:30,440
!أمي-نو-هاباكيري القادر على شقّ السّماء لنصفين

111
00:07:30,690 --> 00:07:35,530
!وإنما القادر حتّى على قطع قاع الجحيم

112
00:07:36,190 --> 00:07:42,490
يُعتبر كلاهما من السّيوف الحادّة الممتازة
.الواحدة والعشرين إضافة لشوسوي

113
00:07:42,780 --> 00:07:47,960
!مومونوسكي-ساما، ما الّذي تريد فعله بتحفتي الفنّيّة؟

114
00:07:47,960 --> 00:07:50,500
!فـ-في الواقع... لستُ مستعدًّا بعد

115
00:07:51,000 --> 00:07:53,040
،ليس لأنّني خائف منه أو ما شابه

116
00:07:53,420 --> 00:07:56,920
.لكنّني أريدك أن تحتفظ به حاليًّا

117
00:07:57,220 --> 00:08:01,470
!أمّا إنما فهو لك

118
00:08:02,180 --> 00:08:07,020
أوّلاً، عليّ إخبارك أنّ الوحيد الّذي تمكّن
...من ترويض إنما في هذه البلاد

119
00:08:07,430 --> 00:08:11,350
!كان كوزكي أودن وفشل في ذلكّ كلّ من سبقه وتلاه

120
00:08:25,330 --> 00:08:30,500
.حاول قطع إحدى تلك الأشجار

121
00:08:36,550 --> 00:08:37,710
.زورو-دونو

122
00:08:38,210 --> 00:08:42,980
سأقول كلامي هذا من باب الطّيبة
،بصراحة، لكنّني إن كنت مكانك

123
00:08:42,980 --> 00:08:44,550
.ما كنت لآخذه

124
00:09:10,960 --> 00:09:12,870
!قُطع الجرف بأكمله

125
00:09:25,300 --> 00:09:27,970
!انظروا إلى ذراع زوروجورو

126
00:09:34,310 --> 00:09:35,560
!...سُحقًا

127
00:09:38,270 --> 00:09:39,440
!أعده

128
00:09:57,420 --> 00:09:59,670
!هذا إنما

129
00:10:02,170 --> 00:10:05,260
،سوف يمتصّ ريو حامله كما يشاء

130
00:10:05,260 --> 00:10:08,050
.ويقطع أكثر ممّا هو مطلوب

131
00:10:08,720 --> 00:10:14,100
إن كنت سيّافًا عاديًّا، لكان قد استنزفك
...بالكامل وأفقدك وعيك الآن

132
00:10:14,100 --> 00:10:15,900
!مثير للإعجاب

133
00:10:16,850 --> 00:10:20,110
ما الّذي تريد فعله؟ أتريد سيفًا آخر؟

134
00:10:23,700 --> 00:10:26,570
!لا، سآخذ هذا

135
00:10:28,200 --> 00:10:30,160
إنما إذًا؟

136
00:10:30,540 --> 00:10:32,950
،بمجرّد أن أعتاد عليه

137
00:10:33,370 --> 00:10:38,420
فسأغدو أقوى بكثير، صحيح؟

138
00:10:44,720 --> 00:10:46,720
!إنّه أحمق

139
00:10:52,310 --> 00:10:54,180
!المستوى الرّابع

140
00:11:01,770 --> 00:11:03,990
!الرّجل الواثب

141
00:11:09,450 --> 00:11:12,370
!مسدّس الملك كونغ

142
00:11:24,340 --> 00:11:26,230
.لم يكن ذلك جيّدًا

143
00:11:26,230 --> 00:11:29,070
.نعم، إنّك تتعب نفسك كثيرًا

144
00:11:29,070 --> 00:11:31,050
!ماذا؟! لم يكن ذلك جيّدًا؟

145
00:11:56,540 --> 00:12:01,130
!واصل العمل بجدّ! فالوقت يداهمنا

146
00:12:01,630 --> 00:12:05,000
.فلتكن قويّة كفاية لتحمل مائة ألف شخص

147
00:12:05,020 --> 00:12:06,730
.لا نتوقّع حضور كلّ ذلك العدد

148
00:12:06,730 --> 00:12:10,240
.غبيّ! إنّنا نريد أكبر عدد ممكن من الحلفاء

149
00:12:10,240 --> 00:12:13,100
!لنتراهن على عدد الأشخاص الّذين سيحضرون

150
00:12:14,430 --> 00:12:17,640
أوروبي-دونو. هل تعرفين حجم قوّة العدوّ العسكريّة؟

151
00:12:18,140 --> 00:12:20,400
،حسب ما سمعت

152
00:12:20,980 --> 00:12:25,370
فإنّ قراصنة مملكة الحيوان
.يتألّفون من حوالي 20 ألف جنديّ

153
00:12:25,370 --> 00:12:30,250
.ويملك الشّوغن أوروتشي حوالي 10 آلاف مرافق

154
00:12:30,250 --> 00:12:35,510
هذا يعني أنّه سيكون هنالك 30 ألفًا
.من الأعداء على أونيغاشيما ذلك اليوم

155
00:12:35,510 --> 00:12:40,680
،لا يوجد أيّ من العامّة ليعترضوا الطّريق
.لذلك لديهم أفضليّة جغرافيّة

156
00:12:40,680 --> 00:12:42,750
.حتّى بوجود مخطّطات القصر

157
00:12:43,170 --> 00:12:47,420
.كلّ ما لدينا هو حوالي أربعة آلاف

158
00:12:47,760 --> 00:12:52,590
،لن تكون حربًا شاملة
.لكنّهم يفوقوننا عددًا بشكل كبير

159
00:12:52,930 --> 00:12:57,100
!ومع ذلك، لا خيار آخر أمامنا سوى خطّة الغارة

160
00:12:57,100 --> 00:12:59,480
!علينا تنفيذها

161
00:13:11,400 --> 00:13:12,700
...لوفي

162
00:13:13,660 --> 00:13:14,700
!هل أنت بخير؟

163
00:13:16,530 --> 00:13:19,160
!لوفي! علينا التّحرّك

164
00:13:19,870 --> 00:13:22,420
آسف. هل يمكنكم الانتظار قليلاً؟

165
00:13:23,040 --> 00:13:25,000
هل يمكنك إتقانه في الوقت المناسب؟

166
00:13:25,590 --> 00:13:27,000
أقصد ريو؟

167
00:13:27,380 --> 00:13:31,630
!نعم، سأتقنه في الوقت المناسب مهما كلّفني

168
00:13:40,140 --> 00:13:42,440
!اهدأ

169
00:13:51,070 --> 00:13:54,490
مومو، أليس عليك أن تتدرّب أيضًا؟

170
00:13:55,820 --> 00:14:02,250
بالمناسبة، أتتذكّر عندما أخبرتني
بشأن عبارة "سوناتشي"؟

171
00:14:02,750 --> 00:14:03,410
.نعم

172
00:14:04,330 --> 00:14:07,600
.قلتَ أنّها كلمة حظّ سعيد للرّفع من المعنويّات

173
00:14:07,600 --> 00:14:08,710
.نعم

174
00:14:08,710 --> 00:14:12,530
.لكنّ أوكيكو أخبرتني ألاّ أقولها

175
00:14:12,530 --> 00:14:15,510
،تعلّمتها من عجوز في قريتي منذ زمن فحسب

176
00:14:15,890 --> 00:14:18,160
.لكنّني لم أقلها ولو حتّى لمرّة واحدة

177
00:14:18,160 --> 00:14:19,260
!ماذا؟

178
00:14:20,890 --> 00:14:22,410
!مرحبًا

179
00:14:22,410 --> 00:14:24,850
!أيّها المعلّم-ساما

180
00:14:25,310 --> 00:14:26,940
!أوتاما

181
00:14:27,650 --> 00:14:29,920
!كنت قلقًا عليك

182
00:14:29,920 --> 00:14:32,150
!تشوبّر! لوفي

183
00:14:32,150 --> 00:14:33,240
!نامي

184
00:14:38,280 --> 00:14:39,330
...رنين، رنين، رنين

185
00:14:40,200 --> 00:14:41,220
.فتح

186
00:14:41,220 --> 00:14:43,120
.هذا كينييمون

187
00:14:43,120 --> 00:14:48,250
!ما الإمكانات العسكريّة لكلّ منطقة؟
كم جنّدتم من الحلفاء؟

188
00:14:48,960 --> 00:14:51,420
.ما زالت نار الثّورة تشتعل

189
00:14:52,920 --> 00:14:55,130
!مع العديد من الحلفاء النّشيطين

190
00:14:55,130 --> 00:14:57,220
.نحن جاهزون

191
00:14:57,220 --> 00:14:58,930
.كينييمون-دونو

192
00:14:59,930 --> 00:15:00,760
!كيبي

193
00:15:01,060 --> 00:15:02,020
!هاكوماي

194
00:15:02,020 --> 00:15:03,180
!رينغو

195
00:15:03,560 --> 00:15:04,680
!أودون

196
00:15:04,680 --> 00:15:08,020
!معنا 200 جنديّ إضافيّ

197
00:15:09,940 --> 00:15:11,610
!فعلاً؟

198
00:15:15,490 --> 00:15:17,050
!مرحى

199
00:15:17,050 --> 00:15:20,330
!لدينا الآن 4200 جنديّ

200
00:15:21,280 --> 00:15:23,870
...لم يصلني خبر من لو-دونو بعد

201
00:15:24,540 --> 00:15:27,140
من يهتمّ إن اتّصل أم لا؟

202
00:15:27,140 --> 00:15:29,750
!مهلاً، إنّه قويّ للغاية

203
00:15:32,590 --> 00:15:36,380
.تدرّب أخي الكبير بشدّة لدرجة أنّه يعجز عن الاستيقاظ

204
00:15:41,800 --> 00:15:43,060
!أيّها الضّابط

205
00:15:44,020 --> 00:15:46,790
.سيقام مهرجان قريبًا. نريد المشاركة

206
00:15:46,790 --> 00:15:48,850
!لا يمكنكم! توقّفوا عن هذا

207
00:15:48,850 --> 00:15:51,870
!سُحقًا! ستكون هذه فرصتنا الأخيرة

208
00:15:51,870 --> 00:15:54,980
!سيقاتل الجميع حتّى الموت

209
00:15:56,360 --> 00:15:58,700
،أعلم أنّ من أُسروا في العاصمة محبطون

210
00:15:58,700 --> 00:16:02,090
.لكن ليس بوسعنا فعل أيّ شيء

211
00:16:02,090 --> 00:16:05,540
.حتّى عائلاتهم الّذين احتجّوا قد أُسروا

212
00:16:05,870 --> 00:16:10,250
...إنّ أقوى السّاموراي لدينا هناك

213
00:16:10,250 --> 00:16:12,840
.لكنّ الوقت يداهمنا

214
00:16:14,500 --> 00:16:15,880
!يا رفاق

215
00:16:15,880 --> 00:16:18,130
!شكرًا على كلّ جهودكم

216
00:16:18,720 --> 00:16:22,640
.سخّروا ما بقي من وقت للسّفر والاستعداد

217
00:16:22,640 --> 00:16:23,850
!عُلم

218
00:16:23,850 --> 00:16:27,730
!سألقاكم في الميناء الموعود

219
00:16:46,410 --> 00:16:47,950
.مومو-كُن

220
00:16:49,500 --> 00:16:51,060
.تفضّل، خذ

221
00:16:51,060 --> 00:16:54,940
قبّعة مُحاكة... أقمت بحياكتها لي؟

222
00:16:54,940 --> 00:16:56,210
!نعم

223
00:16:58,760 --> 00:17:01,490
.حكت واحدة للجميع

224
00:17:01,490 --> 00:17:03,010
.شكرًا لك

225
00:17:04,300 --> 00:17:05,850
.حسنًا يا لوفي-دونو

226
00:17:06,430 --> 00:17:10,700
.سنغادر الآن. علينا أن نسبق الجميع إلى هناك

227
00:17:10,700 --> 00:17:11,600
.حسنًا

228
00:17:11,600 --> 00:17:15,730
.سفينتنا ساني ترسو هنا

229
00:17:17,110 --> 00:17:18,880
!إيّاكم أن يمسكوا بكم

230
00:17:18,880 --> 00:17:20,600
!ماذا؟

231
00:17:20,600 --> 00:17:23,490
!لم نرخِ دفاعنا قطّ

232
00:17:28,120 --> 00:17:30,710
!أنا أعتمد عليكم

233
00:17:30,710 --> 00:17:34,080
!صحيح، دع الأمر لنا

234
00:17:34,080 --> 00:17:35,960
!أراكم في الميناء إذًا

235
00:17:36,630 --> 00:17:37,840
!نعم

236
00:17:52,940 --> 00:17:56,980
،ثمّة العديد من المداخن في هذه البلاد

237
00:17:59,150 --> 00:18:03,570
.وعمّال تعساء أكثر من ذلك

238
00:18:03,570 --> 00:18:05,410
أتظنّ أنّ الأمر صحيح؟

239
00:18:05,410 --> 00:18:06,660
ماذا تقصد؟

240
00:18:06,680 --> 00:18:08,090
...ياسويي-ساما

241
00:18:08,090 --> 00:18:11,700
.قد حمى ساموراي الأكازايا
هل سمعتم تلك الإشاعة؟

242
00:18:11,700 --> 00:18:12,580
ماذا؟

243
00:18:12,580 --> 00:18:13,500
...ذلك المنشور

244
00:18:13,500 --> 00:18:19,610
،لم يكن خدعة من ياسويي-ساما
.بل كان إشارة حقيقيّة للغارة كما سمعت

245
00:18:19,610 --> 00:18:23,050
.لا تشعرنا بالأمل

246
00:18:23,380 --> 00:18:27,180
.أتذكرين ما حلّ بعشيرة كوزكي قبل عشرين سنة

247
00:18:27,180 --> 00:18:32,270
...حتّى إن كان كينييمون والبقيّة أحياء

248
00:18:34,940 --> 00:18:38,360
.فلا بدّ أنّ قلوبهم قد حُطّمت

249
00:18:38,690 --> 00:18:42,740
!لن يتمكّنوا من النّهوض ثانية

250
00:18:43,320 --> 00:18:45,860
.إنّ هذه البلاد معزولة تمامًا

251
00:18:46,280 --> 00:18:48,490
!لن يأتي أحد للمساعدة

252
00:18:48,910 --> 00:18:54,580
!إضافة إلى أنّ لا أحد قادر على مجابهة كايدو

253
00:18:55,460 --> 00:18:58,010
،ها قد بدؤوا تحرّكهم أخيرًا

254
00:18:58,010 --> 00:19:03,760
سبعة من ساموراي الأكازايا
.وشينوبي وشخص مهمّ للغاية

255
00:19:03,760 --> 00:19:09,600
يخطون على أرض جافّة
.تتفتّت كأنّها صقيع في الشّتاء

256
00:19:11,220 --> 00:19:14,650
.تشرق الشّمس عاليًا في السّماء

257
00:19:14,650 --> 00:19:16,730
،ثمّة بضع غيوم داكنة

258
00:19:17,230 --> 00:19:19,190
...لكنّ ظلال التّسعة

259
00:19:19,690 --> 00:19:22,530
الّذين ليسوا أشباحًا في الواقع

260
00:19:22,530 --> 00:19:25,950
...وينوون الثأر لسيّدهم بعد عقدين من الزّمن

261
00:19:26,320 --> 00:19:29,320
.تبدو واضحة تمامًا على الأرض

262
00:19:29,780 --> 00:19:33,490
.لنبنِ لهما شاهدَيْ قبر أفضل بمجرّد فوزنا بالمعركة

263
00:19:44,460 --> 00:19:47,430
.يبدو كيتتسو ذاك مختلفًا الآن

264
00:19:48,300 --> 00:19:51,600
.يبدو أنّه قابل مالكًا جيّدًا

265
00:19:52,510 --> 00:19:56,980
.كيتتسو الثّالث الّذي تحمله الآن من صناعتي

266
00:19:56,980 --> 00:19:58,730
!أهذا معقول؟

267
00:19:59,230 --> 00:20:00,320
.أيّها الشّقيّ

268
00:20:00,320 --> 00:20:02,920
،منحتك هيوري-ساما إنما

269
00:20:02,920 --> 00:20:05,820
والّذي يبدو لي أنّك تحمله بكلّ راحة في يدك، صحيح؟

270
00:20:06,990 --> 00:20:09,490
.إنّه يتّبع نفس مبدأ السّيوف الملعونة

271
00:20:09,490 --> 00:20:12,420
.لا يقوى الضّعفاء على حملها

272
00:20:12,420 --> 00:20:17,370
لكنّ أكبر سبب يجعلك تحمله بكلّ راحة
،في يدك وكما شاءت الأقدار

273
00:20:17,370 --> 00:20:22,500
هو أنّ وادو إيتشيمونجي وإنما
!صُنعا على يد نفس الشّخص

274
00:20:24,170 --> 00:20:27,770
.صانع السّيوف الأسطوريّ، شيموتسكي كوزابورو

275
00:20:27,770 --> 00:20:33,470
غادر هذه البلاد بشكل غير قانونيّ
.قبل أزيد من نصف قرن

276
00:20:33,470 --> 00:20:36,270
ربّما تكون هيوري-ساما قد منحتك

277
00:20:36,270 --> 00:20:39,630
.تذكار والدها لأنّها تعرّفت على ذلك السّيف

278
00:20:42,150 --> 00:20:45,530
!لم يصر إنما سيفًا أسودًا بعد

279
00:20:45,980 --> 00:20:49,400
.بالإمكان الرّفع من تصنيفه اعتمادًا عليك

280
00:20:50,860 --> 00:20:53,240
!سأقوم بذلك

281
00:20:55,240 --> 00:20:56,930
أكلّ شيء بخير في أودون؟

282
00:20:56,930 --> 00:20:58,890
.نعم، كلّ شيء بخير

283
00:20:58,890 --> 00:21:01,080
!ماذا؟ إذًا فذلك التّقرير كان زائفًا

284
00:21:01,080 --> 00:21:05,260
.نعم، أنا في أودون. لم يتغيّر أيّ شيء

285
00:21:05,260 --> 00:21:08,880
.سنواصل مراقبتنا للسّجناء

286
00:21:08,880 --> 00:21:09,970
.جيّد

287
00:21:09,970 --> 00:21:10,760
.إغلاق

288
00:21:10,760 --> 00:21:14,300
!يا له من مغفّل لا يُوثق به

289
00:21:14,760 --> 00:21:19,520
،لكن ما دمت أملك هذه المعلومة
.فإنّها أكثر من كافية

290
00:21:19,890 --> 00:21:23,660
.تغيّر من ميناء هابو إلى ميناء توكاغي"

291
00:21:23,660 --> 00:21:28,110
كوزكي هيوري حيّة وفي مكان ما في الشّمال"، أهكذا إذًا؟

292
00:22:24,170 --> 00:22:26,540
!انتظر فحسب يا كايدو

293
00:22:28,880 --> 00:22:31,630
!اجتمعوا

294
00:22:32,420 --> 00:22:36,220
السّماء صافية وأوراق براعم الكرز
!تتطاير في عاصمة الزّهور

295
00:22:36,840 --> 00:22:39,390
!لقد حلّ يوم مهرجان النّار أخيرًا

296
00:22:39,930 --> 00:22:43,560
في تلك الأثناء وفي الظّلال، توشك المعركة

297
00:22:43,560 --> 00:22:46,570
!الّتي قد تغيّر مصير العالم أن تبدأ

298
00:23:02,000 --> 00:23:03,510
!لدينا أخبار مهمّة

299
00:23:03,510 --> 00:23:09,930
إنّ فصل مانغا وان بيس الّذي سيُنشر في الرّابع
من يناير على مجلّة شونين جامب الأسبوعيّة

300
00:23:09,930 --> 00:23:12,400
!سيكون الفصل الألف في السّلسلة

301
00:23:12,400 --> 00:23:16,630
!شكرًا للجميع وواصلوا تشجيعكم لنا

302
00:23:18,140 --> 00:23:23,450
!مؤامرات تُحاك
!أمواج الزّمن المحتدمة تقترب

303
00:23:23,450 --> 00:23:24,980
:في الحلقة القادمة من وان بيس

304
00:23:24,980 --> 00:23:28,070
أخبار مهمّة! الحادثة الّتي ستؤثّر"
"!على الشّيتشيبوكاي

305
00:23:28,070 --> 00:23:30,910
!ملك القراصنة، لن يكون إلاّ أنا