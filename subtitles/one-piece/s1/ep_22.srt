1
00:00:02,490 --> 00:00:04,330
...الثّروة والشّهرة والسّلطة

2
00:00:04,630 --> 00:00:06,500
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,500 --> 00:00:08,400
.ملك القراصنة، غولد روجر

4
00:00:08,800 --> 00:00:12,570
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,570 --> 00:00:16,170
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,440 --> 00:00:20,040
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,650 --> 00:00:26,720
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,350 --> 00:00:30,290
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,190 --> 00:00:35,790
سنجمع كل أحلامنا

10
00:00:36,790 --> 00:00:42,230
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,630 --> 00:00:48,270
!ون بيس

12
00:00:48,770 --> 00:00:53,610
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,440 --> 00:00:59,050
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,150 --> 00:01:05,120
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,450 --> 00:01:10,990
!فإنّها ليست أسطورة إذًا

16
00:01:12,190 --> 00:01:17,870
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:17,930 --> 00:01:22,770
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,070 --> 00:01:25,670
!وتظاهر أنّها غير موجودة

19
00:01:26,640 --> 00:01:31,510
سنجمع كلّ أحلامنا

20
00:01:32,510 --> 00:01:37,690
ونبحر باحثين عن شيء

21
00:01:38,020 --> 00:01:40,920
،عملة في جيبي

22
00:01:41,020 --> 00:01:44,190
وتريد أن تصبح صديقي؟

23
00:01:44,290 --> 00:01:48,800
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,660 --> 00:01:50,830
!إننا كذلك

25
00:01:54,070 --> 00:01:56,040
ما قصّة هذا المطعم؟

26
00:01:56,540 --> 00:02:00,040
وكأنّني... وكأنّني على متن
!سفينة قراصنة

27
00:02:00,470 --> 00:02:02,940
!هرب تابع القرصان كريغ

28
00:02:07,380 --> 00:02:09,320
هذا مطعم، صحيح؟

29
00:02:09,320 --> 00:02:11,920
،أنا جدّ آسف يا سيّدي
لكن هل لديك أيّ مال؟

30
00:02:12,890 --> 00:02:14,290
هل ستفي رصاصة بالغرض؟

31
00:02:14,290 --> 00:02:15,990
لا تملك مالًا إذًا، صحيح؟

32
00:02:21,460 --> 00:02:22,200
.كُل

33
00:02:25,930 --> 00:02:27,570
!وجدتُ طبّاخًا جيّدًا

34
00:02:28,470 --> 00:02:30,440
.هذه فرصة جيّدة

35
00:02:30,440 --> 00:02:31,970
!العجوز اللّعين

36
00:02:31,970 --> 00:02:34,110
!غادر هذا المكان معهم

37
00:02:34,110 --> 00:02:36,510
!لم نعد بحاجة لك في هذا المطعم

38
00:02:40,980 --> 00:02:45,520
!أقوى أسطول قراصنة"
".الأميرال الدّون كريغ

39
00:02:48,120 --> 00:02:52,190
!أيّها العجوز اللّعين
.أنا مساعد الطّاهي هنا

40
00:02:52,190 --> 00:02:54,530
!ما الّذي تقصده بأنّك ما عدت تحتاجني؟

41
00:02:54,530 --> 00:02:56,930
.أنت تتسبّب بالمشاكل مع الزّبائن أحيانًا

42
00:02:56,930 --> 00:03:00,000
وتتّسع منخاراك في اللّحظة
.الّتي ترى فيها فتاة ما

43
00:03:00,000 --> 00:03:02,370
،لا تستطيع حتّى طبخ وجبة محترمة

44
00:03:02,370 --> 00:03:05,240
.لذلك فأنت مجرّد عبء على هذا المطعم

45
00:03:05,240 --> 00:03:06,670
.هذا ما قلتُه

46
00:03:06,670 --> 00:03:08,310
ماذا تقول؟

47
00:03:11,480 --> 00:03:14,910
...كما أنّ بقيّة الطّبّاخين يتفادونك

48
00:03:14,910 --> 00:03:17,580
،لذلك اذهب لتصبح قرصانًا أو ما شابه

49
00:03:17,580 --> 00:03:20,890
!وغادر هذا المكان فحسب

50
00:03:21,820 --> 00:03:23,450
ماذا تقول؟

51
00:03:24,590 --> 00:03:28,690
إن التزمتُ الصّمت، يمكنك قول
!ما تشاء، صحيح أيّها العجوز اللّعين؟

52
00:03:29,830 --> 00:03:31,860
،أستطيع غضّ النّظر عن بقيّة كلامك

53
00:03:31,860 --> 00:03:34,330
لكنّني لن أقف مكتوف اليدين
!وأنت تهين طبخي

54
00:03:34,900 --> 00:03:38,670
،مهما كان ما تقوله
!فسأبقى هنا كطاهٍ

55
00:03:39,070 --> 00:03:40,600
!وذلك آخر ما عندي

56
00:03:40,600 --> 00:03:44,310
ما الّذي تنوي عليه بإمساكك
بالمالك من ياقتيه هكذا؟

57
00:03:44,310 --> 00:03:46,440
!أيّها الغبيّ

58
00:03:48,480 --> 00:03:50,980
...سُحقًا لك

59
00:03:53,280 --> 00:03:54,680
...كفاك عبثًا

60
00:03:55,490 --> 00:03:57,490
،مهما حاولتَ جاهدًا لطردي من هنا

61
00:03:58,150 --> 00:04:01,490
...فسأواصل العمل هنا كطاهٍ

62
00:04:01,490 --> 00:04:03,590
!إلى أن تموت

63
00:04:03,590 --> 00:04:07,360
!لن أموت! سأعيش لمئة سنة أخرى

64
00:04:07,360 --> 00:04:09,470
...ذاك العجوز جوابه دائمًا على طرف لسانه

65
00:04:09,470 --> 00:04:12,570
!حسنًا، حصلتَ على الإذن
.يمكنك أن تصبح قرصانًا الآن

66
00:04:12,570 --> 00:04:13,440
!مستحيل

67
00:04:14,240 --> 00:04:17,510
.والآن... آسف على هذا

68
00:04:17,510 --> 00:04:20,710
أودّ أن أعوّض عليك بتقديم
.سلطة فواكه لك يا أميرتي

69
00:04:20,710 --> 00:04:24,110
.مذهل، شكرًا لك! أنت لطيف جدًّا

70
00:04:24,110 --> 00:04:24,650
...العفو

71
00:04:24,650 --> 00:04:27,020
!ولن تعتذر لنا أيضًا؟

72
00:04:27,020 --> 00:04:29,520
!سأقاضيك يا طبّاخ الحبّ الغبيّ

73
00:04:29,520 --> 00:04:33,990
قدّمت لك شايًا، صحيح؟
.اشكرني على ذلك يا طويل الأنف

74
00:04:33,990 --> 00:04:37,090
ماذا؟ أتريد قتالي؟
.لن أتساهل معك

75
00:04:37,530 --> 00:04:38,830
!اهزمه يا زورو

76
00:04:38,830 --> 00:04:40,330
.اهزمه بنفسك

77
00:04:40,330 --> 00:04:43,000
.توقّف! لا تتشاجر بسببي رجاءً

78
00:04:43,000 --> 00:04:44,000
.حاضر، في الحال

79
00:04:44,000 --> 00:04:46,000
!من قال أنّ شجارنا بسببك؟

80
00:04:46,000 --> 00:04:47,400
...بالمناسبة

81
00:04:47,400 --> 00:04:48,040
ماذا؟

82
00:04:48,040 --> 00:04:50,070
...الطّعام الّذي تقدّمونه هنا لذيذ

83
00:04:50,070 --> 00:04:52,770
...لكن يبدو أنّه باهظ الثّمن بالنّسبة لي

84
00:04:52,770 --> 00:04:54,340
.بالطّبع هو بالمجّان لك

85
00:04:54,340 --> 00:04:55,610
!شكرًا لك

86
00:04:56,810 --> 00:04:57,780
.أمّا أنتم فستدفعون

87
00:04:57,780 --> 00:04:58,680
...ما

88
00:04:58,680 --> 00:05:00,880
.كم يسهل توقّع أفعالك

89
00:05:02,920 --> 00:05:05,350
!ما الّذي تفعله بجلوسك هناك؟

90
00:05:05,350 --> 00:05:07,760
،عندما يجلس الزّبائن
!عليك إحضار مناشف مبلّلة لهم

91
00:05:07,760 --> 00:05:08,820
.حاضر

92
00:05:18,000 --> 00:05:22,100
،حسنًا... بسبب كلّ ما حدث

93
00:05:22,100 --> 00:05:24,970
...مرّت أربعة أيّام سلفًا

94
00:05:24,970 --> 00:05:27,710
متى نستطيع المغادرة؟

95
00:05:27,710 --> 00:05:28,880
.لا أدري

96
00:05:29,580 --> 00:05:32,850
هل سيعمل كفتى أعمال
روتينيّة لسنة بالفعل؟

97
00:05:32,850 --> 00:05:36,820
ما الخطب في ذلك؟
.الطّعام بالمجّان والوضع مريح هنا

98
00:05:36,820 --> 00:05:38,550
.بالنّسبة لك أنت

99
00:05:40,350 --> 00:05:42,020
!يا لوفي

100
00:05:43,290 --> 00:05:46,990
!ما الّذي يحدث؟
!لنغادر في أقرب وقت

101
00:05:46,990 --> 00:05:51,700
انتظروا قليلًا. سأحاول التّحدّث
.مع المالك ثانية

102
00:05:51,700 --> 00:05:53,370
!أنا أتوسّل إليك

103
00:06:17,460 --> 00:06:19,990
مهلًا، ما الخطب؟

104
00:06:40,010 --> 00:06:41,710
...ساعة رمليّة... على جانبي الجمجمة

105
00:06:41,710 --> 00:06:44,320
...لإظهار مدى خطورتهم لأعدائهم

106
00:06:44,780 --> 00:06:48,350
...ذلك العلم... ذلك العلم

107
00:06:48,350 --> 00:06:51,790
لا مجال للشّكّ... إنّه ينتمي
...للمسيطر على الأزرق الشّرقيّ

108
00:06:52,460 --> 00:06:54,760
!الدّون كريغ

109
00:07:08,840 --> 00:07:12,480
!لماذا... لماذا قراصنة كريغ هنا؟

110
00:07:12,940 --> 00:07:15,580
!أرأيت يا باتي؟! لقد أتوا بالفعل

111
00:07:15,580 --> 00:07:17,780
!ستتخلّص منهم، صحيح؟

112
00:07:17,780 --> 00:07:19,550
!أ-أليس هذا خطأ ما؟

113
00:07:19,550 --> 00:07:22,490
إنّنا نتحدّث هنا عن زعيم أسطول
.بحريّ يضمّ 5000 قرصان

114
00:07:22,490 --> 00:07:25,720
لماذا قد يأتي كلّ هذه المسافة
!فقط لينتقم لأحد رجاله؟

115
00:07:25,720 --> 00:07:28,820
!لا مجال للشّكّ! إنّه هنا بالفعل

116
00:07:28,820 --> 00:07:32,630
!هذا ليس جيّدًا
!ألا يجدر بنا المغادرة فحسب؟

117
00:07:32,630 --> 00:07:34,800
!يا لها من سفينة شراعيّة ضخمة

118
00:07:42,140 --> 00:07:44,240
!إنّها سفينة ضخمة

119
00:07:44,240 --> 00:07:47,140
أتساءل إن كان غين قد أتى
.ليردّ جميلك

120
00:07:47,140 --> 00:07:49,010
...لا أظنّ ذلك

121
00:07:49,610 --> 00:07:51,250
...لكنّ هذا غريب

122
00:08:00,190 --> 00:08:01,560
...مـ-مهلًا

123
00:08:01,560 --> 00:08:03,090
...ما الّذي

124
00:08:10,730 --> 00:08:13,630
...تبدو سفينتهم في حالة يرثى لها

125
00:08:13,630 --> 00:08:16,470
لا يبدو أنّهم قد تعرّضوا
...لهجمات مدافع

126
00:08:17,140 --> 00:08:20,210
ولكن، من الصّعب التّفكير
.في أنّ ذلك الضّرر من صنع البشر

127
00:08:20,210 --> 00:08:22,380
هل ضربهم إعصار أو ما شابه؟

128
00:08:24,480 --> 00:08:26,310
...ها هو قادم

129
00:09:19,130 --> 00:09:25,540
آ-آسف... هلّي ببعض الماء والطّعام؟

130
00:09:26,200 --> 00:09:30,480
...لديّ مال... الكثير من المال

131
00:09:30,910 --> 00:09:35,650
.لا أذكر حتّى متى أكلتُ آخر مرّة

132
00:09:35,650 --> 00:09:43,050
...رجاءً... أعطوني بعض الماء والطّعام

133
00:09:46,020 --> 00:09:48,030
!ما-ما هذا؟

134
00:09:48,030 --> 00:09:49,990
.إنّه لا يُبدي أيّ هيبة أو قوّة

135
00:09:49,990 --> 00:09:54,800
،هل هو بالفعل الدّون كريغ
أميرال أسطول القراصنة الكبير؟

136
00:09:54,800 --> 00:09:57,170
...إنّه جائع إذًا

137
00:10:02,410 --> 00:10:03,910
!أ-أيّها القائد

138
00:10:05,540 --> 00:10:06,980
!الدّون كريغ

139
00:10:08,750 --> 00:10:11,720
!الـ-النّجدة! ساعدوا قائدنا

140
00:10:12,480 --> 00:10:14,720
!إنّه يتضوّر جوعًا بالفعل

141
00:10:14,920 --> 00:10:18,690
!لم يأكل أيّ شيء لأيّام
!سيموت إن لم يأكل

142
00:10:27,100 --> 00:10:29,270
هذا جيّد! من الرّائع رؤية

143
00:10:29,270 --> 00:10:33,570
...المطلوب الشّهير الدّون كريغ هكذا

144
00:10:33,570 --> 00:10:36,370
.لدينا مال هذه المرّة
!نحن زبائن

145
00:10:36,370 --> 00:10:41,140
!لا تكن سخيفًا
.اتّصلوا بالبحريّة في الحال

146
00:10:41,140 --> 00:10:41,910
ماذا؟

147
00:10:41,910 --> 00:10:45,550
.إنّه في أضعف حالاته الآن
!هذه فرصة لا تتكرّر ثانية

148
00:10:45,550 --> 00:10:49,120
.لا حاجة لإطعامه أيّ شيء
.أبقوه رهن الاعتقال

149
00:10:49,120 --> 00:10:52,790
صحيح! لا ندري ما الّذي سيفعله
.بمجرّد أن يستعيد طاقته

150
00:10:52,790 --> 00:10:54,420
.قام بأعمال بشعة

151
00:10:54,420 --> 00:10:58,860
إنّه يستحقّ أن يجوع بسبب
!كلّ ما اقترفته يداه

152
00:10:59,330 --> 00:11:03,100
أراهن أنّه سيهاجم هذا المطعم
.مباشرة بمجرّد عودته لطبيعته

153
00:11:03,100 --> 00:11:05,770
.لا حاجة لإعطائه ولو كوب ماء واحد

154
00:11:07,640 --> 00:11:09,940
...لن أفعل أيّ شيء

155
00:11:11,810 --> 00:11:13,710
...لن أفعل أيّ شيء

156
00:11:13,710 --> 00:11:18,110
.أعد أن أغادر بسرعة بمجرّد أن آكل

157
00:11:18,110 --> 00:11:21,880
...لذلك أرجوكم... ساعدوني

158
00:11:22,580 --> 00:11:24,650
!أيّها الدّون كريغ، توقّف رجاءً

159
00:11:25,020 --> 00:11:29,020
!لا تتوسّل إليهم رجاءً
!هذا ليس أمرًا عليك فعله

160
00:11:29,020 --> 00:11:31,890
!لا تقم بشيء مخزٍ كهذا رجاءً

161
00:11:31,890 --> 00:11:38,600
...أنا أعدكم... أرجوكم
...سآخذ حتّى البقايا... أيّ شيء

162
00:11:39,770 --> 00:11:41,800
...أيّ شيء

163
00:11:44,470 --> 00:11:45,410
...دون

164
00:11:51,910 --> 00:11:54,410
تبًّا! هل تحاول كسب عطفنا؟

165
00:11:54,410 --> 00:11:56,280
.أنت، ابتعد عن طريقي يا باتي

166
00:12:02,260 --> 00:12:03,560
ماذا؟

167
00:12:04,390 --> 00:12:07,530
!سا... سانجي-سان

168
00:12:10,130 --> 00:12:14,070
.تفضّل يا غين. أطعمه إيّاه

169
00:12:16,470 --> 00:12:17,770
...سانجي-سان

170
00:12:23,610 --> 00:12:24,780
!شكرًا لك

171
00:12:35,750 --> 00:12:38,490
!يا سانجي! خذ ذلك الطّعام منه حالًا

172
00:12:38,990 --> 00:12:41,460
!هل تدرك أيّ نوع من الرّجال يكون؟

173
00:12:42,060 --> 00:12:44,930
إنّه الرّجل الّذي يُدعى المسيطر
،على الأزرق الشّرقيّ

174
00:12:44,930 --> 00:12:46,830
!كريغ الشّائن

175
00:12:48,500 --> 00:12:52,700
.بدأ الأمر في سجن
تظاهر أنّه جنديّ من البحريّة

176
00:12:52,700 --> 00:12:56,910
واستولى على سفينة للبحريّة
.عن طريق قتل ضابط عليها

177
00:12:56,910 --> 00:12:59,480
.وهكذا أعلن أنّه أصبح قرصانًا

178
00:13:03,880 --> 00:13:06,020
بهدف مهاجمة البلدات
.وسفن المسافرين

179
00:13:09,050 --> 00:13:13,860
.إنّه يقوم بأيّ شيء ليواصل الفوز
!هكذا وصل إلى حيث هو الآن

180
00:13:15,130 --> 00:13:17,090
.ماذا؟ إنّه يلعب بقذارة إذًا

181
00:13:17,460 --> 00:13:20,360
.قوّته الحقيقيّة ساحقة أيضًا

182
00:13:20,360 --> 00:13:24,530
أتظنّه سيغادر بعد الأكل؟
!ذلك ليس ممكنًا في حالته

183
00:13:24,870 --> 00:13:29,370
ترك شيطان خبيث مثله يموت
!دون مساعدة عمل لصالح المجتمع

184
00:14:19,290 --> 00:14:22,520
!سا...سانجي

185
00:14:31,230 --> 00:14:33,230
!هذا ليس ما اتّفقنا عليه أيّها الدّون كريغ

186
00:14:33,230 --> 00:14:37,540
!أحضرتك بشرط أنّك لن تؤذي هذا المطعم

187
00:14:37,540 --> 00:14:41,080
...وذلك الرّجل أنقذ حياتنا

188
00:14:45,680 --> 00:14:47,550
.نعم، كان ذلك لذيذًا

189
00:14:49,620 --> 00:14:51,890
.عدت للحياة ثانية

190
00:15:06,700 --> 00:15:12,370
مـ-مهلًا... ما-ما الّذي يحدث هناك؟

191
00:15:12,370 --> 00:15:13,670
.سنرى عندما نذهب إلى هناك

192
00:15:13,670 --> 00:15:15,780
!ماذا؟! هـ-هل أنت جادّ؟

193
00:15:15,780 --> 00:15:17,510
ماذا؟ هل أنت خائف؟

194
00:15:17,510 --> 00:15:19,510
!ما... لا تكن سخيفًا

195
00:15:22,850 --> 00:15:23,920
...هذا غريب

196
00:15:24,550 --> 00:15:27,620
لا إشارة على أنّ هنالك
...أيّ أحد على تلك السّفينة

197
00:15:47,670 --> 00:15:52,610
.يا له من مطعم جيّد
.سآخذ هذه السّفينة

198
00:15:56,050 --> 00:15:58,720
...إذًا... هذا ما تريد

199
00:15:59,280 --> 00:16:00,890
...هذا مؤلم

200
00:16:11,060 --> 00:16:16,670
،سفينتي في حالة يرثى لها
.لذلك أريد واحدة جديدة

201
00:16:17,270 --> 00:16:21,110
ستغادرون هذه السّفينة
.بعد أن تقوموا بما آمركم به

202
00:16:21,110 --> 00:16:22,510
!ما-ماذا؟

203
00:16:22,510 --> 00:16:26,410
.الدّون كريغ... هذا ليس ما وعدتني به

204
00:16:29,250 --> 00:16:33,050
هنالك حوالي 100 من رجالي
.ما زالوا أحياءً على سفينتي

205
00:16:33,650 --> 00:16:36,250
إنّهم ضعفاء بسبب الجوع
.ويعانون إصابات خطيرة

206
00:16:37,150 --> 00:16:42,530
.أوّلًا، حضّروا 100 وجبة وبعض الماء لهم

207
00:16:43,060 --> 00:16:45,530
.مات بعضهم جوعًا بالفعل

208
00:16:46,500 --> 00:16:48,700
...ما... ماء

209
00:16:52,670 --> 00:16:54,800
!أحضروهم في الحال

210
00:16:55,310 --> 00:16:57,770
هل تقول لنا أنّ علينا إحياء قراصنة

211
00:16:57,770 --> 00:17:00,540
!سيهاجمون هذه السّفينة؟

212
00:17:00,540 --> 00:17:01,510
!نحن نرفض

213
00:17:02,450 --> 00:17:06,020
.ترفضون؟ لا تسئ فهمي

214
00:17:06,020 --> 00:17:10,390
.أنا لا أقدّم طلبًا هنا
.أنا أصدر الأوامر لكم

215
00:17:11,150 --> 00:17:18,430
...لا يهمّ من تكونون
!فلا تتحدّوني

216
00:17:25,070 --> 00:17:26,470
...سانجي-سان

217
00:17:27,440 --> 00:17:32,270
...سانجي-سان، أنا آسف
...لم أقصد أن يحدث هذا

218
00:17:32,640 --> 00:17:36,240
!أيّها الوغد! انظر ما الّذي فعلتَه

219
00:17:54,630 --> 00:17:57,130
!يا سانجي! إلى أين أنت ذاهب؟

220
00:17:59,930 --> 00:18:04,910
.للمطبخ. علينا تحضير 100 وجبة أخرى

221
00:18:05,670 --> 00:18:06,440
!سانجي-سان

222
00:18:06,440 --> 00:18:07,410
!سانجي؟

223
00:18:07,410 --> 00:18:10,340
!ماذا؟

224
00:18:10,840 --> 00:18:13,750
.صحيح. هذا ما يجب أن يحدث

225
00:18:24,120 --> 00:18:26,990
هل أنت جاسوس كريغ يا سانجي؟

226
00:18:26,990 --> 00:18:28,760
!لا يمكننا السّماح لك بدخول المطعم

227
00:18:28,760 --> 00:18:32,230
!اكتفينا من تصرّفاتك المجنونة

228
00:18:34,730 --> 00:18:36,200
...واصلوا

229
00:18:37,600 --> 00:18:39,610
واصلوا ما كنتم ستفعلون
!إن أردتم إيقافي

230
00:18:42,710 --> 00:18:44,540
...أنا أعلم

231
00:18:45,180 --> 00:18:49,010
...إنّه مجرم لا أمل منه

232
00:18:51,250 --> 00:18:56,760
.لكنّ ذلك لا يهمّني
!ذلك لا يهمّ إطلاقًا

233
00:18:57,660 --> 00:19:01,860
...ما سيحدث بعد إطعامهم
.أمر من المزعج التّفكير فيه

234
00:19:01,860 --> 00:19:04,430
.أنا طبّاخ، لا أكثر ولا أقلّ

235
00:19:05,330 --> 00:19:09,830
،إن وُجد شخص جائع أمامي
!فسأطعمه. ذلك كلّ شيء

236
00:19:11,240 --> 00:19:14,770
،لا بأس أن يكون الطّبّاخ هكذا
ألا تظنّون ذلك؟

237
00:19:22,650 --> 00:19:23,680
!باتي

238
00:19:23,680 --> 00:19:25,520
!اسمعوا، ليبقه أحدكم مقيّدًا

239
00:19:26,820 --> 00:19:32,490
سانجي، تقوم أحيانًا بإطعام الزّبائن
الّذين أطردهم في الخلف، صحيح؟

240
00:19:33,160 --> 00:19:38,460
،لن أقول من على صواب
.لكن هذه المرّة، أنت مخطئ

241
00:19:38,960 --> 00:19:41,770
لن أسمح لك بالقيام بما
.تريد بعد الآن

242
00:19:41,770 --> 00:19:43,630
.سأحمي هذا المطعم

243
00:19:43,630 --> 00:19:45,700
.ولحسن الحظّ، لدينا عدوّ واحد لنقاتله

244
00:19:45,700 --> 00:19:49,370
،حتّى إن كان الدّون كريغ
فماذا بوسعه فعله ضدّنا؟

245
00:19:51,610 --> 00:19:55,080
هذا مطعم بحريّ يرتاد عليه
.القراصنة كلّ يوم

246
00:19:55,650 --> 00:19:58,950
!نحن جاهزون بالكامل لخدمة أيّ زبون

247
00:19:58,950 --> 00:19:59,980
...هذا

248
00:19:59,980 --> 00:20:03,520
هل شبعتَ يا كريغ-سان؟

249
00:20:03,520 --> 00:20:05,890
...بعد الوجبة الرّئيسيّة، ما رأيك

250
00:20:06,620 --> 00:20:11,030
!بتحليّة من حديد؟

251
00:20:11,790 --> 00:20:15,670
!كرات لحم الهلاك

252
00:20:31,850 --> 00:20:32,610
!دون

253
00:20:38,020 --> 00:20:42,360
.ربّما أكون قد كسرت الأبواب
.سيوبّخني المالك ثانية

254
00:20:42,360 --> 00:20:44,660
.حسنًا، فعلتَ ذلك لحماية المطعم

255
00:20:44,660 --> 00:20:45,990
.إنّه أمر يستحقّ التّوبيخ

256
00:20:47,060 --> 00:20:50,300
ماذا ستفعل بأولئك الّذين
على سفينة كريغ؟

257
00:20:50,300 --> 00:20:51,570
من يدري؟

258
00:20:51,570 --> 00:20:54,500
...ربّما سندهن الزّبدة على السّفينة ونقليها

259
00:21:00,110 --> 00:21:06,180
سيكون مذاقها لذيذًا، صحيح؟
!أيّها الطّبّاخ الفظيع

260
00:21:08,280 --> 00:21:10,890
كيف تجرؤ على تقديم تحلية
!فظيعة كهذه؟

261
00:21:10,890 --> 00:21:13,120
!هذا المطعم هو الأسوأ

262
00:21:18,060 --> 00:21:19,690
!وأنتم مزعجون

263
00:21:26,770 --> 00:21:27,770
...من كلّ جسده

264
00:21:27,770 --> 00:21:28,900
...رصاص

265
00:21:43,220 --> 00:21:46,020
!لا تتحدّوني

266
00:21:46,650 --> 00:21:49,260
!أنا الأقوى

267
00:21:50,660 --> 00:21:52,730
...ذراعان فولاذيّان أقوى من أيّة أذرع

268
00:21:53,330 --> 00:21:56,000
درع مصنوع من فولاذ ووتز
...أقسى من أيّ درع

269
00:21:56,000 --> 00:21:59,700
وقبضة من الألماس بإمكانها
!تدمير أيّ شيء

270
00:22:00,900 --> 00:22:05,440
لديّ أنواع عدّة من الأسلحة
...المدمجة في درعي

271
00:22:05,440 --> 00:22:07,740
أسطول من 50 سفينة كبيرة
!و5000 قرصان

272
00:22:07,740 --> 00:22:11,180
!فزت بكلّ معاركي في الماضي

273
00:22:11,610 --> 00:22:15,750
!أنا الرّجل المناسب لأُنادى دون

274
00:22:16,650 --> 00:22:18,520
!ابتعد عن طريقي يا فتى

275
00:22:21,050 --> 00:22:23,820
،عندما آمركم بتحضير الطّعام

276
00:22:23,820 --> 00:22:26,290
!كلّ ما عليكم فعله هو إطاعة الأوامر

277
00:22:27,160 --> 00:22:29,790
!لا تتحدّوني

278
00:22:34,930 --> 00:22:37,540
يوجد هنا ما يكفي لمئة
.وجبة على الأرجح

279
00:22:37,540 --> 00:22:39,740
.خذه إلى سفينتك في الحال

280
00:22:39,740 --> 00:22:40,910
!أيّها المالك زيف

281
00:22:40,910 --> 00:22:44,380
ما قصّة ذلك العمّ؟
!كنتُ لأتعرّض للأذى

282
00:22:47,980 --> 00:22:50,950
أ... أقلتم زيف؟

283
00:22:55,790 --> 00:23:10,030
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

284
00:23:10,030 --> 00:23:16,970
ولطالما بحثت عن ذلك المكان الإعجازيّ

285
00:23:16,970 --> 00:23:24,150
لكي لا يسبقني أحد آخر إليه

286
00:23:26,680 --> 00:23:38,160
إن كان العالم سيتغيّر

287
00:23:38,160 --> 00:23:45,170
قبل أن أحقّق حلمي

288
00:23:45,170 --> 00:23:52,240
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

289
00:23:52,240 --> 00:24:05,620
لكي لا تمحى ذكرياتي

290
00:24:11,660 --> 00:24:14,260
هل من الصّواب فعلًا منح كريغ
طعامًا بتلك البساطة؟

291
00:24:14,260 --> 00:24:16,200
!نعم. افعل شيئًا ما أيّها العمّ

292
00:24:16,200 --> 00:24:17,530
!حسنًا، دعوا الأمر لي

293
00:24:17,530 --> 00:24:19,200
!مهلًا! إلى أين ستذهب يا لوفي؟

294
00:24:19,200 --> 00:24:21,670
لا تذهب لتفتعل قتالًا
!مع كريغ أيّها الغبيّ

295
00:24:21,670 --> 00:24:24,740
.يبدو ذلك ممتعًا
ستقاتل يا لوفي؟ أتحتاج مساعدة؟

296
00:24:25,670 --> 00:24:26,840
:في الحلقة القادمة من ون بيس

297
00:24:26,840 --> 00:24:30,340
!حماية باراتيي"
"!القرصان العظيم زيف ذو السّاق الحمراء

298
00:24:30,710 --> 00:24:33,210
!ملك القراصنة، لن يكون إلاّ أنا