1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,480 --> 00:02:41,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:55,800 --> 00:03:00,220
.كما وعدت، سأقتلك في رمشة عين
.لن يكون موتك مؤلمًا

33
00:03:00,220 --> 00:03:04,020
هذا مؤسف. لو أنّك بقيت متّصلاً
،بذلك الرّاعي وقام بحمايتك

34
00:03:04,020 --> 00:03:05,410
.لكنت بخير الآن

35
00:03:06,330 --> 00:03:07,830
!والآن، هذه نهايتك

36
00:03:08,500 --> 00:03:12,010
!لا تقتله أرجوك! لا نحتاج لمفتاحك

37
00:03:12,010 --> 00:03:14,080
!والآن، مت

38
00:03:14,770 --> 00:03:16,640
!أوسوبّ

39
00:03:38,650 --> 00:03:41,400
!من تكون يا هذا؟

40
00:04:02,510 --> 00:04:03,730
.صيّاد

41
00:04:09,030 --> 00:04:11,520
.أ-أنا آسف يا سانجي-كُن

42
00:04:13,630 --> 00:04:14,310
...أنا

43
00:04:16,510 --> 00:04:19,320
...في النّهاية... أنا

44
00:04:19,920 --> 00:04:21,860
.ما زلتَ حيًّا. ذلك كلّ ما يهمّ

45
00:04:21,860 --> 00:04:24,660
لكلّ شخص أمور يستطيع فعلها
.وأمور أخرى يعجز عنها

46
00:04:26,000 --> 00:04:27,030
...سانجي

47
00:04:28,890 --> 00:04:30,930
.انظرا للخارج كلاكما

48
00:04:34,290 --> 00:04:35,120
...مستحيل

49
00:04:53,610 --> 00:04:56,940
.توشك بوّابات العدالة أن تُفتح

50
00:04:59,390 --> 00:05:00,610
!...روبين

51
00:05:07,420 --> 00:05:11,050
بمجرّد أن تُفتح تلك البوّابات
،وتعبر روبين-تشان من خلالها

52
00:05:11,050 --> 00:05:14,830
فإنّ البحر خلفها يعج بملوك البحر
.ولا وسيلة لنا لعبوره

53
00:05:15,500 --> 00:05:18,770
ويوجد بعده سجن هائل
.ومقرّ البحريّة الرّئيسيّ

54
00:05:18,770 --> 00:05:23,630
ستُؤخذ روبين-تشان قريبًا
.إلى مكان بعيد عن متناولنا

55
00:05:23,630 --> 00:05:28,050
مستحيل... لم يصل لوفي
في الوقت المناسب؟

56
00:05:28,390 --> 00:05:30,830
!لقّنها درسًا يا فانكفريد

57
00:05:33,020 --> 00:05:34,850
.لوفي أمامي مباشرة

58
00:05:37,600 --> 00:05:39,670
لا تصب أيًّا من نقاطها الحيويّة، مفهوم؟

59
00:05:42,010 --> 00:05:44,440
...سهم

60
00:05:44,440 --> 00:05:45,870
!العاج

61
00:06:02,250 --> 00:06:04,810
!لن أسمح لك بالهرب أيّتها المرأة الغبيّة

62
00:06:04,810 --> 00:06:06,800
!لا تستخفّي بي

63
00:06:06,800 --> 00:06:10,970
.والآن، لنعبر الأبواب نحو أحلامنا معًا

64
00:06:11,660 --> 00:06:13,930
.دع أمر الحصول على مفتاحه لي

65
00:06:16,460 --> 00:06:20,400
هل ستغيّرون المقاتلين؟
.لا أمانع ذلك أبدًا

66
00:06:21,580 --> 00:06:24,360
.سأقوم بما تعجز عنه أنت

67
00:06:25,600 --> 00:06:28,070
!وستقوم بما أعجز عنه أنا

68
00:06:28,070 --> 00:06:29,450
ماذا؟

69
00:06:29,940 --> 00:06:31,660
.فكّر جيّدًا

70
00:06:33,080 --> 00:06:34,280
!استوعب الوضع

71
00:06:35,680 --> 00:06:40,250
ما دمت معنا، بإمكاننا إنقاذ
!روبين-تشان بكلّ تأكيد يا أوسوبّ

72
00:06:42,810 --> 00:06:44,590
!أريد أن أعيش

73
00:06:45,550 --> 00:06:49,530
...ما-ما بإمكاني فعله

74
00:06:53,160 --> 00:06:57,960
ركلات مشتعلة! وجبة سانجي"
"!الكاملة من تقنيات السّاق

75
00:07:01,650 --> 00:07:06,080
ما دمتُ معهم... بإمكاننا إنقاذ روبين؟

76
00:07:07,010 --> 00:07:09,990
ماذا؟ ما معنى ذلك؟

77
00:07:26,140 --> 00:07:26,960
!انتقال آنيّ

78
00:07:27,870 --> 00:07:29,100
!اذهبا

79
00:07:29,100 --> 00:07:30,870
!حـ-حسنًا! أوسوبّ

80
00:07:30,870 --> 00:07:32,320
!إصاباتي تؤلمني

81
00:07:32,320 --> 00:07:35,750
تحمّل الأمر! هذا أفضل
!من التّعرّض للقتل، صحيح؟

82
00:07:35,750 --> 00:07:37,720
.وجهة نظر سديدة

83
00:07:46,930 --> 00:07:47,980
!أسلوب الجسد الحديديّ القتاليّ

84
00:07:49,910 --> 00:07:51,350
!رصاصة الذّئب

85
00:08:07,080 --> 00:08:11,050
.يا لك من صيّاد. مجرّد كلام بلا أفعال

86
00:08:17,220 --> 00:08:19,500
!هذا صحيح! فهمت

87
00:08:19,500 --> 00:08:20,640
ماذا؟

88
00:08:21,060 --> 00:08:25,230
،بإمكاننا إنقاذها... ما دمت معكم
!بإمكاننا إنقاذ روبين! اللّعنة

89
00:08:25,230 --> 00:08:28,150
!اللّعنة"؟! ليس عليك أن تغضب أو ما شابه"

90
00:08:28,150 --> 00:08:29,060
!لنسرع يا نامي-كُن

91
00:08:29,060 --> 00:08:30,720
!انتظرني

92
00:08:30,720 --> 00:08:33,090
!فهمت! فهمت

93
00:08:41,680 --> 00:08:43,250
.ربّما عليّ قتلهم في النّهاية

94
00:09:13,500 --> 00:09:14,990
...ها قد تماديت الآن

95
00:09:26,960 --> 00:09:28,080
!مسدّس الأصابع العشرة

96
00:09:28,790 --> 00:09:31,330
!لحم مفروم من الدّرجة الثّالثة

97
00:09:31,330 --> 00:09:32,350
!الجسد الحديديّ

98
00:09:45,870 --> 00:09:47,780
!لا ينفع ذلك ضدّي أيّها الأبله

99
00:09:48,490 --> 00:09:50,940
ما قصّة ركلاته هذه؟

100
00:09:52,580 --> 00:09:55,850
إنّ تلك التّقنية الّتي تستعملونها
...لجعل أجسادكم كالحديد

101
00:09:57,070 --> 00:09:58,860
.مزعجة بالفعل

102
00:09:59,330 --> 00:10:00,950
!ساق العاصفة: الذّئب الوحيد

103
00:10:07,340 --> 00:10:08,460
!شوي الكتف

104
00:10:09,020 --> 00:10:09,790
!ركلة الخصر

105
00:10:10,340 --> 00:10:10,920
!ركلة التّرقوة

106
00:10:11,340 --> 00:10:14,130
!ضربة البطن! ركلة الرّدف! ركلة العصعص
!ركلة الفخذ! ركلة الظّنبوب

107
00:10:21,630 --> 00:10:23,810
!ركلة لحم العجل

108
00:10:23,810 --> 00:10:25,140
!أسلوب الجسد الحديديّ القتاليّ

109
00:10:28,090 --> 00:10:30,950
!أخبرتك أنّ ركلاتك لا تنفع ضدّي، صحيح؟

110
00:10:30,950 --> 00:10:32,400
!ناب الذّئب

111
00:10:37,550 --> 00:10:38,780
!كان ذلك هجومًا ناجحًا، صحيح؟

112
00:10:39,430 --> 00:10:42,150
:أسلوب الجسد الحديديّ القتاليّ
!وقفة ناب الذّئب

113
00:10:45,680 --> 00:10:48,360
أنا الوحيد من بين متقني القوى السّتّ

114
00:10:48,360 --> 00:10:50,750
الّذي يستطيع الحركة واستعمل تقنية
.الجسد الحديديّ على كامل جسدي

115
00:10:51,430 --> 00:10:53,090
!كفّ عن الثّرثرة

116
00:10:53,510 --> 00:10:55,050
!لحم مفروم من الدّرجة الثّانية

117
00:11:08,050 --> 00:11:10,730
،بدا أنّ الهجوم قد نجح
لكن لم يحدث ذلك؟

118
00:11:16,030 --> 00:11:17,650
!هل نجح أم لا؟

119
00:11:23,870 --> 00:11:25,120
.أبليت حسنًا

120
00:11:26,090 --> 00:11:29,690
.كنت في انتظار رجل مثلك

121
00:11:34,230 --> 00:11:38,280
هل ستنقذها... تنقذ روبين؟

122
00:11:38,280 --> 00:11:40,720
!ماذا؟! ما الّذي تقوله؟

123
00:11:41,510 --> 00:11:45,180
...التزمت الصّمت بشأن هذا... لكن روبين

124
00:11:47,190 --> 00:11:52,190
...هي أختي الصّغيرة في الحقيقة
.الّتي انفصلت عنها منذ زمن بعيد

125
00:11:52,190 --> 00:11:53,980
!ماذا؟

126
00:11:55,240 --> 00:11:56,570
!هل هذا صحيح؟

127
00:11:57,230 --> 00:11:58,960
.لم أكن أعلم

128
00:11:58,960 --> 00:12:01,670
...لم تخبرنا بأيّ شيء عن هذا، لذا

129
00:12:02,250 --> 00:12:03,990
...ذلك طبيعيّ

130
00:12:03,990 --> 00:12:05,820
.لكنّها الحقيقة

131
00:12:08,790 --> 00:12:11,840
.حدث هذا قبل عشرين سنة

132
00:12:11,840 --> 00:12:13,290
.لن أنسَ ذلك أبدًا

133
00:12:15,300 --> 00:12:17,790
،على جزيرة في الأزرق الغربيّ

134
00:12:17,790 --> 00:12:21,000
،في يوم صيفيّ مشمس وصحو

135
00:12:21,000 --> 00:12:24,580
.ذهبتُ وروبين للّعب في الشّاطئ

136
00:12:27,860 --> 00:12:28,810
!أخي الكبير

137
00:12:28,810 --> 00:12:30,180
.كنّا مقرّبين من بعضنا

138
00:12:31,080 --> 00:12:31,890
!روبين

139
00:12:31,080 --> 00:12:33,140
.لذلك كنّا نلعب معًا دائمًا

140
00:12:36,550 --> 00:12:37,360
!انظري

141
00:12:37,360 --> 00:12:40,070
...وفي ذلك اليوم أيضًا، كنّا سعيدين

142
00:12:41,650 --> 00:12:43,450
.إلى أن أتى أولئك الأشخاص

143
00:12:50,330 --> 00:12:52,620
...عندما أشحت نظري عنها لوهلة

144
00:12:58,550 --> 00:13:02,040
!اختطف أولئك القراصنة روبين

145
00:13:06,990 --> 00:13:09,960
!روبين! أعيدوا روبين

146
00:13:14,730 --> 00:13:18,220
.ولم أرها ثانية بعد ذلك اليوم

147
00:13:20,970 --> 00:13:24,320
عندما اكتشفت أنّها هربت
،من أولئك القراصنة

148
00:13:24,700 --> 00:13:25,740
...روبين

149
00:13:25,740 --> 00:13:27,740
.كان الأوان قد فات

150
00:13:32,950 --> 00:13:35,250
.كلّ هذا خطئي أنا

151
00:13:35,970 --> 00:13:39,850
،لذلك أريد إنقاذها بأيّ ثمن

152
00:13:39,850 --> 00:13:43,200
لكن لا يمكنني فعل أيّ شيء
.بسبب الوضع الّذي أنا فيه

153
00:13:44,040 --> 00:13:47,440
.لذلك... أعهد لك بكلّ هذا

154
00:13:47,440 --> 00:13:49,390
!أنقذ روبين رجاءً

155
00:13:50,720 --> 00:13:53,270
.حسنًا، مفهوم. دع الأمر لي

156
00:13:53,640 --> 00:13:56,730
.سآخذ هذا المفتاح وأنقذها بكلّ تأكيد

157
00:14:00,230 --> 00:14:02,480
!أوتظنّني سأصدّق هراءً كهذا؟

158
00:14:07,920 --> 00:14:11,030
روبين-تشان أختك الصّغرى؟

159
00:14:11,400 --> 00:14:15,000
،أيّها الأبله! إن كنت تريد الكذب
.حاول جعله أكثر تصديقًا

160
00:14:36,160 --> 00:14:39,460
يا إلهي، ما زلت تسبّبين المشاكل
،بعد أن وصلنا إلى هذا الحدّ

161
00:14:39,460 --> 00:14:41,400
!يا لك من امرأة غبيّة

162
00:14:41,400 --> 00:14:45,440
!غبيّة! غبيّة! غبيّة! امرأة غبيّة

163
00:14:45,440 --> 00:14:47,490
!أصبحت متعبًا جدًّا بسببك

164
00:14:47,490 --> 00:14:49,200
!سيري بنفسك يا حقيرة

165
00:14:50,890 --> 00:14:53,660
.لا تجعليني أكرّر كلامي

166
00:14:54,640 --> 00:14:58,870
.لم يتبقّ ولو حتّى بصيص أمل لك

167
00:14:58,870 --> 00:15:01,260
،سمعتُ صوتًا ما في الممرّ قبل قليل

168
00:15:01,260 --> 00:15:03,890
لكن لم يظهر أيّ أحد بعدها، صحيح؟

169
00:15:03,890 --> 00:15:08,980
لا بدّ أنّ لوتشي يقتله الآن، أسمعتِ؟

170
00:15:16,350 --> 00:15:20,300
أيّتها الحقيرة! جعلتني أسعل
!كلّ ذلك السّعال

171
00:15:20,300 --> 00:15:27,650
!غبيّة! غبيّة! غبيّة! امرأة غبيّة

172
00:15:28,650 --> 00:15:30,340
.يجدر أنّك قد أدركت الأمر الآن

173
00:15:30,340 --> 00:15:34,900
،لا يهمّ ما الخدع الّتي ستؤدّيها
.لا يمكنك عبور هذه الأبواب أبدًا

174
00:15:34,900 --> 00:15:38,660
أنت مخطئ! سأقوم بكلّ ما يتطلّبه
!الأمر منّي لعبورها

175
00:15:40,900 --> 00:15:43,340
.يبدو أنّنا على خلاف

176
00:15:43,340 --> 00:15:45,290
.أعتقد أنّه لا طائل من مناقشة الأمر

177
00:15:45,710 --> 00:15:47,440
.ليس لديّ وقت كثير أيضًا

178
00:15:47,440 --> 00:15:50,130
!فاكهة المطّاط... المدفع الرّشّاش

179
00:15:50,570 --> 00:15:51,960
!الطّابع

180
00:15:51,960 --> 00:15:52,550
!السّوط

181
00:15:53,390 --> 00:15:55,220
!الرّمح

182
00:16:16,860 --> 00:16:19,280
هل نجحت ركلاتي قليلاً هذه المرّة؟

183
00:16:19,910 --> 00:16:22,250
!...مهلاً! أيّها الوغد! المفتاح

184
00:16:23,390 --> 00:16:25,040
!أنت من أعطاني إيّاه

185
00:16:25,720 --> 00:16:27,540
!كيف تجرؤ...؟

186
00:16:27,540 --> 00:16:29,500
ما زلتَ لم تتعلّم درسك؟

187
00:16:30,100 --> 00:16:30,960
!الجسد الحديديّ

188
00:16:36,930 --> 00:16:37,720
!إلى اللّقاء

189
00:16:37,720 --> 00:16:39,680
!كلاّ! انتظر

190
00:16:40,690 --> 00:16:43,000
!أنا من معروف عنه الخداع

191
00:16:43,000 --> 00:16:44,560
!كيف تجرؤ؟

192
00:16:44,560 --> 00:16:45,440
!انتقال آنيّ

193
00:16:54,110 --> 00:16:55,410
...طاولة الحفلات

194
00:16:55,410 --> 00:16:56,510
!أسلوب الجسد الحديديّ القتاليّ

195
00:16:57,920 --> 00:16:59,530
!ركلة الفخذ

196
00:17:03,710 --> 00:17:05,830
!سيخ الشّوي

197
00:17:10,150 --> 00:17:12,920
!سُحقًا! أنا غاضب

198
00:17:12,920 --> 00:17:17,280
.إن كنت تريد أن تتأذّى بشدّة... فلا أمانع ذلك

199
00:17:17,280 --> 00:17:20,970
سأريك القوّة الحقيقيّة لأسلوب
!الجسد الحديديّ القتاليّ خاصّتي

200
00:17:23,450 --> 00:17:26,190
:أسلوب الجسد الحديديّ القتاليّ
!وقفة ذئب الموز

201
00:17:28,950 --> 00:17:31,320
!شبكة منطقة صيد الذّئب

202
00:17:31,320 --> 00:17:32,480
!مهلاً! هجوم قاطع؟

203
00:17:37,910 --> 00:17:39,160
!خطوات الذّئب الثّقيلة

204
00:17:51,620 --> 00:17:53,980
ما رأيك بقوّة لكمات الجسد الحديديّ؟

205
00:17:53,980 --> 00:17:55,920
قوّتها لا نظير لها، صحيح؟

206
00:17:55,920 --> 00:17:56,970
!مشية القمر

207
00:18:01,470 --> 00:18:03,910
!ساق العاصفة: وابل نجوم الذّئب

208
00:18:18,840 --> 00:18:23,370
كنت ساذجًا لاعتقادك أنّ بإمكانك
.سرقة المفتاح منّي والهرب

209
00:18:24,330 --> 00:18:28,960
أنا ذئب. سأواصل السّعي خلفك
.إلى أن أغرس أنيابي فيك

210
00:18:34,750 --> 00:18:36,410
.ماذا؟ ما زلت حيًّا

211
00:18:37,240 --> 00:18:42,210
...لا أنوي الهرب... لا أنوي أن أُقتل

212
00:18:45,530 --> 00:18:46,890
.ولا أنوي أن أسامح أيضًا

213
00:18:46,890 --> 00:18:48,280
تسامح؟

214
00:18:50,790 --> 00:18:53,130
هل تتعاطف مع نيكو روبين؟

215
00:18:53,990 --> 00:18:57,590
.إنّ العقل المشتّت يخلق ثغرات خلال القتال

216
00:18:57,590 --> 00:19:01,250
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

217
00:19:01,250 --> 00:19:04,530
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

218
00:19:05,370 --> 00:19:06,910
.انتبه لكلامك

219
00:19:09,560 --> 00:19:13,430
.أنا من النّوع الّذي يشتعل غضبًا

220
00:19:13,430 --> 00:19:16,090
،إن كنت تحت هذا الضّغط
.فلا فرصة لك للإطاحة بي

221
00:19:16,090 --> 00:19:18,780
أنا واثق أنّ هجماتي تسبّبت
.بضرر كثير لك حتّى الآن

222
00:19:18,780 --> 00:19:21,940
...إن لم يكن ذلك كافيًا

223
00:19:21,940 --> 00:19:24,280
:أسلوب الجسد الحديديّ القتاليّ
!شيطان الذّئب السّماويّ

224
00:19:40,650 --> 00:19:44,410
.هيّا اضحك بينما تستطيع ذلك

225
00:19:56,050 --> 00:19:59,840
لا أدري ما الممتع
...في الدّوران هكذا، ولكن

226
00:20:05,560 --> 00:20:07,930
!ما قصّته؟ صارت ساقه حمراء الآن

227
00:20:09,030 --> 00:20:11,100
...إنّها ساق من الجحيم

228
00:20:11,100 --> 00:20:12,890
!ساق الشّيطان

229
00:20:13,600 --> 00:20:17,980
إنّ الحرارة المولّدة من الدّوران
...ستجعل ركلاتي أسرع

230
00:20:21,640 --> 00:20:22,400
!إنّها تلمع

231
00:20:31,160 --> 00:20:33,620
!هذا يحرق

232
00:20:34,290 --> 00:20:38,590
.قوّتها المدمّرة تشبه قوّة شيطان

233
00:20:52,250 --> 00:20:55,270
...هذا يحرق! يحرق، يحرق، يحرق

234
00:20:56,900 --> 00:21:00,570
لـ-لقد احترقت! حتّى عظامي
!ساخنة! لقد انكسرت

235
00:21:01,010 --> 00:21:02,780
!تقنية الجسد الحديديّ لا تعمل

236
00:21:02,780 --> 00:21:05,780
!ما قصّة تلك الرّكلة؟! سحقًا

237
00:21:10,780 --> 00:21:11,880
!غبيّ

238
00:21:11,880 --> 00:21:15,040
لا أصدّق أنّه قفز في الهواء بينما
!خصمه متقن للقوى السّتّ

239
00:21:15,580 --> 00:21:16,950
!ساق الشّيطان

240
00:21:17,920 --> 00:21:19,880
!لحم مفروم من الدّرجة الأولى

241
00:21:19,090 --> 00:21:19,880
!مشية القمر

242
00:21:23,010 --> 00:21:23,840
!يا لغبائك

243
00:21:23,840 --> 00:21:25,550
!أنت غبيّ بالفعل

244
00:21:25,550 --> 00:21:27,830
تحمّست كثيرًا وأصبحت متهوّرًا
!محاولاً إنهاء القتال

245
00:21:27,830 --> 00:21:28,850
!أنا الفائز

246
00:21:31,700 --> 00:21:32,480
!خذ هذه

247
00:21:32,480 --> 00:21:33,600
!مسدّس الأصابع ضوء القمر العشرة

248
00:21:40,320 --> 00:21:43,400
.صددتَ إحدى يداي. كنت وشيكًا

249
00:21:44,000 --> 00:21:46,090
إن كنتَ سريعًا بما يكفي
،لتنفيذ ركلة أخرى

250
00:21:46,090 --> 00:21:48,360
لكنتَ قادرًا على إيقاف
.مسدّس الإصبع بالكامل

251
00:21:49,480 --> 00:21:51,360
...ما كان بيدي حيلة

252
00:21:51,360 --> 00:21:55,370
!لأنّ الرّكلة الأخرى...هدفها الإطاحة بك

253
00:21:57,810 --> 00:21:59,600
!ساق الشّيطان

254
00:21:59,600 --> 00:22:01,420
!ماذا؟ مـ-مهلاً

255
00:22:01,910 --> 00:22:03,380
...ركلة

256
00:22:09,890 --> 00:22:11,460
!اللّهب

257
00:22:22,030 --> 00:22:24,480
...يخلق الإله الطّعام

258
00:22:26,710 --> 00:22:29,210
.والشّيطان التّوابل

259
00:22:32,980 --> 00:22:36,280
.أعتقد أنّني أضفت الكثير من التّوابل

260
00:22:44,340 --> 00:22:48,340
ما الّذي تفعله؟
.بدأت هجماتي بالفعل

261
00:22:48,340 --> 00:22:49,430
!ماذا؟

262
00:22:49,430 --> 00:22:50,430
!زخّات الزّرافة

263
00:22:52,770 --> 00:22:54,600
!لا يمكنني صدّها

264
00:22:54,600 --> 00:22:59,550
بدأت للتّوّ بإظهار قوّة الزّرافة
!الحقيقيّة الجامحة

265
00:22:59,550 --> 00:23:01,030
:في الحلقة القادمة من وان بيس

266
00:23:01,030 --> 00:23:05,080
هجوم السّيف الأبيض! زورو ضدّ"
"!كاكو في نزال سيوف قويّ قاطع

267
00:23:05,080 --> 00:23:07,140
!ملك القراصنة، لن يكون إلاّ أنا

268
00:23:09,990 --> 00:23:14,990
نلقاكم في الحلقة القادمة