1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,480 --> 00:02:27,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:41,800 --> 00:02:46,220
.كما وعدت، سأقتلك في رمشة عين
.لن يكون موتك مؤلمًا

33
00:02:46,220 --> 00:02:50,020
هذا مؤسف. لو أنّك بقيت متّصلاً
،بذلك الرّاعي وقام بحمايتك

34
00:02:50,020 --> 00:02:51,410
.لكنت بخير الآن

35
00:02:52,330 --> 00:02:53,830
!والآن، هذه نهايتك

36
00:02:54,500 --> 00:02:58,010
!لا تقتله أرجوك! لا نحتاج لمفتاحك

37
00:02:58,010 --> 00:03:00,080
!والآن، مت

38
00:03:00,770 --> 00:03:02,640
!أوسوبّ

39
00:03:24,650 --> 00:03:27,400
!من تكون يا هذا؟

40
00:03:48,510 --> 00:03:49,730
.صيّاد

41
00:03:55,030 --> 00:03:57,520
.أ-أنا آسف يا سانجي-كُن

42
00:03:59,630 --> 00:04:00,310
...أنا

43
00:04:02,510 --> 00:04:05,320
...في النّهاية... أنا

44
00:04:05,920 --> 00:04:07,860
.ما زلتَ حيًّا. ذلك كلّ ما يهمّ

45
00:04:07,860 --> 00:04:10,660
لكلّ شخص أمور يستطيع فعلها
.وأمور أخرى يعجز عنها

46
00:04:12,000 --> 00:04:13,030
...سانجي

47
00:04:14,890 --> 00:04:16,930
.انظرا للخارج كلاكما

48
00:04:20,290 --> 00:04:21,120
...مستحيل

49
00:04:39,610 --> 00:04:42,940
.توشك بوّابات العدالة أن تُفتح

50
00:04:45,390 --> 00:04:46,610
!...روبين

51
00:04:53,420 --> 00:04:57,050
بمجرّد أن تُفتح تلك البوّابات
،وتعبر روبين-تشان من خلالها

52
00:04:57,050 --> 00:05:00,830
فإنّ البحر خلفها يعج بملوك البحر
.ولا وسيلة لنا لعبوره

53
00:05:01,500 --> 00:05:04,770
ويوجد بعده سجن هائل
.ومقرّ البحريّة الرّئيسيّ

54
00:05:04,770 --> 00:05:09,630
ستُؤخذ روبين-تشان قريبًا
.إلى مكان بعيد عن متناولنا

55
00:05:09,630 --> 00:05:14,050
مستحيل... لم يصل لوفي
في الوقت المناسب؟

56
00:05:14,390 --> 00:05:16,830
!لقّنها درسًا يا فانكفريد

57
00:05:19,020 --> 00:05:20,850
.لوفي أمامي مباشرة

58
00:05:23,600 --> 00:05:25,670
لا تصب أيًّا من نقاطها الحيويّة، مفهوم؟

59
00:05:28,010 --> 00:05:30,440
...سهم

60
00:05:30,440 --> 00:05:31,870
!العاج

61
00:05:48,250 --> 00:05:50,810
!لن أسمح لك بالهرب أيّتها المرأة الغبيّة

62
00:05:50,810 --> 00:05:52,800
!لا تستخفّي بي

63
00:05:52,800 --> 00:05:56,970
.والآن، لنعبر الأبواب نحو أحلامنا معًا

64
00:05:57,660 --> 00:05:59,930
.دع أمر الحصول على مفتاحه لي

65
00:06:02,460 --> 00:06:06,400
هل ستغيّرون المقاتلين؟
.لا أمانع ذلك أبدًا

66
00:06:07,580 --> 00:06:10,360
.سأقوم بما تعجز عنه أنت

67
00:06:11,600 --> 00:06:14,070
!وستقوم بما أعجز عنه أنا

68
00:06:14,070 --> 00:06:15,450
ماذا؟

69
00:06:15,940 --> 00:06:17,660
.فكّر جيّدًا

70
00:06:19,080 --> 00:06:20,280
!استوعب الوضع

71
00:06:21,680 --> 00:06:26,250
ما دمت معنا، بإمكاننا إنقاذ
!روبين-تشان بكلّ تأكيد يا أوسوبّ

72
00:06:28,810 --> 00:06:30,590
!أريد أن أعيش

73
00:06:31,550 --> 00:06:35,530
...ما-ما بإمكاني فعله

74
00:06:39,160 --> 00:06:43,960
ركلات مشتعلة! وجبة سانجي"
"!الكاملة من تقنيات السّاق

75
00:06:47,650 --> 00:06:52,080
ما دمتُ معهم... بإمكاننا إنقاذ روبين؟

76
00:06:53,010 --> 00:06:55,990
ماذا؟ ما معنى ذلك؟

77
00:07:12,140 --> 00:07:12,960
!انتقال آنيّ

78
00:07:13,870 --> 00:07:15,100
!اذهبا

79
00:07:15,100 --> 00:07:16,870
!حـ-حسنًا! أوسوبّ

80
00:07:16,870 --> 00:07:18,320
!إصاباتي تؤلمني

81
00:07:18,320 --> 00:07:21,750
تحمّل الأمر! هذا أفضل
!من التّعرّض للقتل، صحيح؟

82
00:07:21,750 --> 00:07:23,720
.وجهة نظر سديدة

83
00:07:32,930 --> 00:07:33,980
!أسلوب الجسد الحديديّ القتاليّ

84
00:07:35,910 --> 00:07:37,350
!رصاصة الذّئب

85
00:07:53,080 --> 00:07:57,050
.يا لك من صيّاد. مجرّد كلام بلا أفعال

86
00:08:03,220 --> 00:08:05,500
!هذا صحيح! فهمت

87
00:08:05,500 --> 00:08:06,640
ماذا؟

88
00:08:07,060 --> 00:08:11,230
،بإمكاننا إنقاذها... ما دمت معكم
!بإمكاننا إنقاذ روبين! اللّعنة

89
00:08:11,230 --> 00:08:14,150
!اللّعنة"؟! ليس عليك أن تغضب أو ما شابه"

90
00:08:14,150 --> 00:08:15,060
!لنسرع يا نامي-كُن

91
00:08:15,060 --> 00:08:16,720
!انتظرني

92
00:08:16,720 --> 00:08:19,090
!فهمت! فهمت

93
00:08:27,680 --> 00:08:29,250
.ربّما عليّ قتلهم في النّهاية

94
00:08:59,500 --> 00:09:00,990
...ها قد تماديت الآن

95
00:09:12,960 --> 00:09:14,080
!مسدّس الأصابع العشرة

96
00:09:14,790 --> 00:09:17,330
!لحم مفروم من الدّرجة الثّالثة

97
00:09:17,330 --> 00:09:18,350
!الجسد الحديديّ

98
00:09:31,870 --> 00:09:33,780
!لا ينفع ذلك ضدّي أيّها الأبله

99
00:09:34,490 --> 00:09:36,940
ما قصّة ركلاته هذه؟

100
00:09:38,580 --> 00:09:41,850
إنّ تلك التّقنية الّتي تستعملونها
...لجعل أجسادكم كالحديد

101
00:09:43,070 --> 00:09:44,860
.مزعجة بالفعل

102
00:09:45,330 --> 00:09:46,950
!ساق العاصفة: الذّئب الوحيد

103
00:09:53,340 --> 00:09:54,460
!شوي الكتف

104
00:09:55,020 --> 00:09:55,790
!ركلة الخصر

105
00:09:56,340 --> 00:09:56,920
!ركلة التّرقوة

106
00:09:57,340 --> 00:10:00,130
!ضربة البطن! ركلة الرّدف! ركلة العصعص
!ركلة الفخذ! ركلة الظّنبوب

107
00:10:07,630 --> 00:10:09,810
!ركلة لحم العجل

108
00:10:09,810 --> 00:10:11,140
!أسلوب الجسد الحديديّ القتاليّ

109
00:10:14,090 --> 00:10:16,950
!أخبرتك أنّ ركلاتك لا تنفع ضدّي، صحيح؟

110
00:10:16,950 --> 00:10:18,400
!ناب الذّئب

111
00:10:23,550 --> 00:10:24,780
!كان ذلك هجومًا ناجحًا، صحيح؟

112
00:10:25,430 --> 00:10:28,150
:أسلوب الجسد الحديديّ القتاليّ
!وقفة ناب الذّئب

113
00:10:31,680 --> 00:10:34,360
أنا الوحيد من بين متقني القوى السّتّ

114
00:10:34,360 --> 00:10:36,750
الّذي يستطيع الحركة واستعمل تقنية
.الجسد الحديديّ على كامل جسدي

115
00:10:37,430 --> 00:10:39,090
!كفّ عن الثّرثرة

116
00:10:39,510 --> 00:10:41,050
!لحم مفروم من الدّرجة الثّانية

117
00:10:54,050 --> 00:10:56,730
،بدا أنّ الهجوم قد نجح
لكن لم يحدث ذلك؟

118
00:11:02,030 --> 00:11:03,650
!هل نجح أم لا؟

119
00:11:09,870 --> 00:11:11,120
.أبليت حسنًا

120
00:11:12,090 --> 00:11:15,690
.كنت في انتظار رجل مثلك

121
00:11:20,230 --> 00:11:24,280
هل ستنقذها... تنقذ روبين؟

122
00:11:24,280 --> 00:11:26,720
!ماذا؟! ما الّذي تقوله؟

123
00:11:27,510 --> 00:11:31,180
...التزمت الصّمت بشأن هذا... لكن روبين

124
00:11:33,190 --> 00:11:38,190
...هي أختي الصّغيرة في الحقيقة
.الّتي انفصلت عنها منذ زمن بعيد

125
00:11:38,190 --> 00:11:39,980
!ماذا؟

126
00:11:41,240 --> 00:11:42,570
!هل هذا صحيح؟

127
00:11:43,230 --> 00:11:44,960
.لم أكن أعلم

128
00:11:44,960 --> 00:11:47,670
...لم تخبرنا بأيّ شيء عن هذا، لذا

129
00:11:48,250 --> 00:11:49,990
...ذلك طبيعيّ

130
00:11:49,990 --> 00:11:51,820
.لكنّها الحقيقة

131
00:11:54,790 --> 00:11:57,840
.حدث هذا قبل عشرين سنة

132
00:11:57,840 --> 00:11:59,290
.لن أنسَ ذلك أبدًا

133
00:12:01,300 --> 00:12:03,790
،على جزيرة في الأزرق الغربيّ

134
00:12:03,790 --> 00:12:07,000
،في يوم صيفيّ مشمس وصحو

135
00:12:07,000 --> 00:12:10,580
.ذهبتُ وروبين للّعب في الشّاطئ

136
00:12:13,860 --> 00:12:14,810
!أخي الكبير

137
00:12:14,810 --> 00:12:16,180
.كنّا مقرّبين من بعضنا

138
00:12:17,080 --> 00:12:17,890
!روبين

139
00:12:17,080 --> 00:12:19,140
.لذلك كنّا نلعب معًا دائمًا

140
00:12:22,550 --> 00:12:23,360
!انظري

141
00:12:23,360 --> 00:12:26,070
...وفي ذلك اليوم أيضًا، كنّا سعيدين

142
00:12:27,650 --> 00:12:29,450
.إلى أن أتى أولئك الأشخاص

143
00:12:36,330 --> 00:12:38,620
...عندما أشحت نظري عنها لوهلة

144
00:12:44,550 --> 00:12:48,040
!اختطف أولئك القراصنة روبين

145
00:12:52,990 --> 00:12:55,960
!روبين! أعيدوا روبين

146
00:13:00,730 --> 00:13:04,220
.ولم أرها ثانية بعد ذلك اليوم

147
00:13:06,970 --> 00:13:10,320
عندما اكتشفت أنّها هربت
،من أولئك القراصنة

148
00:13:10,700 --> 00:13:11,740
...روبين

149
00:13:11,740 --> 00:13:13,740
.كان الأوان قد فات

150
00:13:18,950 --> 00:13:21,250
.كلّ هذا خطئي أنا

151
00:13:21,970 --> 00:13:25,850
،لذلك أريد إنقاذها بأيّ ثمن

152
00:13:25,850 --> 00:13:29,200
لكن لا يمكنني فعل أيّ شيء
.بسبب الوضع الّذي أنا فيه

153
00:13:30,040 --> 00:13:33,440
.لذلك... أعهد لك بكلّ هذا

154
00:13:33,440 --> 00:13:35,390
!أنقذ روبين رجاءً

155
00:13:36,720 --> 00:13:39,270
.حسنًا، مفهوم. دع الأمر لي

156
00:13:39,640 --> 00:13:42,730
.سآخذ هذا المفتاح وأنقذها بكلّ تأكيد

157
00:13:46,230 --> 00:13:48,480
!أوتظنّني سأصدّق هراءً كهذا؟

158
00:13:53,920 --> 00:13:57,030
روبين-تشان أختك الصّغرى؟

159
00:13:57,400 --> 00:14:01,000
،أيّها الأبله! إن كنت تريد الكذب
.حاول جعله أكثر تصديقًا

160
00:14:22,160 --> 00:14:25,460
يا إلهي، ما زلت تسبّبين المشاكل
،بعد أن وصلنا إلى هذا الحدّ

161
00:14:25,460 --> 00:14:27,400
!يا لك من امرأة غبيّة

162
00:14:27,400 --> 00:14:31,440
!غبيّة! غبيّة! غبيّة! امرأة غبيّة

163
00:14:31,440 --> 00:14:33,490
!أصبحت متعبًا جدًّا بسببك

164
00:14:33,490 --> 00:14:35,200
!سيري بنفسك يا حقيرة

165
00:14:36,890 --> 00:14:39,660
.لا تجعليني أكرّر كلامي

166
00:14:40,640 --> 00:14:44,870
.لم يتبقّ ولو حتّى بصيص أمل لك

167
00:14:44,870 --> 00:14:47,260
،سمعتُ صوتًا ما في الممرّ قبل قليل

168
00:14:47,260 --> 00:14:49,890
لكن لم يظهر أيّ أحد بعدها، صحيح؟

169
00:14:49,890 --> 00:14:54,980
لا بدّ أنّ لوتشي يقتله الآن، أسمعتِ؟

170
00:15:02,350 --> 00:15:06,300
أيّتها الحقيرة! جعلتني أسعل
!كلّ ذلك السّعال

171
00:15:06,300 --> 00:15:13,650
!غبيّة! غبيّة! غبيّة! امرأة غبيّة

172
00:15:14,650 --> 00:15:16,340
.يجدر أنّك قد أدركت الأمر الآن

173
00:15:16,340 --> 00:15:20,900
،لا يهمّ ما الخدع الّتي ستؤدّيها
.لا يمكنك عبور هذه الأبواب أبدًا

174
00:15:20,900 --> 00:15:24,660
أنت مخطئ! سأقوم بكلّ ما يتطلّبه
!الأمر منّي لعبورها

175
00:15:26,900 --> 00:15:29,340
.يبدو أنّنا على خلاف

176
00:15:29,340 --> 00:15:31,290
.أعتقد أنّه لا طائل من مناقشة الأمر

177
00:15:31,710 --> 00:15:33,440
.ليس لديّ وقت كثير أيضًا

178
00:15:33,440 --> 00:15:36,130
!فاكهة المطّاط... المدفع الرّشّاش

179
00:15:36,570 --> 00:15:37,960
!الطّابع

180
00:15:37,960 --> 00:15:38,550
!السّوط

181
00:15:39,390 --> 00:15:41,220
!الرّمح

182
00:16:02,860 --> 00:16:05,280
هل نجحت ركلاتي قليلاً هذه المرّة؟

183
00:16:05,910 --> 00:16:08,250
!...مهلاً! أيّها الوغد! المفتاح

184
00:16:09,390 --> 00:16:11,040
!أنت من أعطاني إيّاه

185
00:16:11,720 --> 00:16:13,540
!كيف تجرؤ...؟

186
00:16:13,540 --> 00:16:15,500
ما زلتَ لم تتعلّم درسك؟

187
00:16:16,100 --> 00:16:16,960
!الجسد الحديديّ

188
00:16:22,930 --> 00:16:23,720
!إلى اللّقاء

189
00:16:23,720 --> 00:16:25,680
!كلاّ! انتظر

190
00:16:26,690 --> 00:16:29,000
!أنا من معروف عنه الخداع

191
00:16:29,000 --> 00:16:30,560
!كيف تجرؤ؟

192
00:16:30,560 --> 00:16:31,440
!انتقال آنيّ

193
00:16:40,110 --> 00:16:41,410
...طاولة الحفلات

194
00:16:41,410 --> 00:16:42,510
!أسلوب الجسد الحديديّ القتاليّ

195
00:16:43,920 --> 00:16:45,530
!ركلة الفخذ

196
00:16:49,710 --> 00:16:51,830
!سيخ الشّوي

197
00:16:56,150 --> 00:16:58,920
!سُحقًا! أنا غاضب

198
00:16:58,920 --> 00:17:03,280
.إن كنت تريد أن تتأذّى بشدّة... فلا أمانع ذلك

199
00:17:03,280 --> 00:17:06,970
سأريك القوّة الحقيقيّة لأسلوب
!الجسد الحديديّ القتاليّ خاصّتي

200
00:17:09,450 --> 00:17:12,190
:أسلوب الجسد الحديديّ القتاليّ
!وقفة ذئب الموز

201
00:17:14,950 --> 00:17:17,320
!شبكة منطقة صيد الذّئب

202
00:17:17,320 --> 00:17:18,480
!مهلاً! هجوم قاطع؟

203
00:17:23,910 --> 00:17:25,160
!خطوات الذّئب الثّقيلة

204
00:17:37,620 --> 00:17:39,980
ما رأيك بقوّة لكمات الجسد الحديديّ؟

205
00:17:39,980 --> 00:17:41,920
قوّتها لا نظير لها، صحيح؟

206
00:17:41,920 --> 00:17:42,970
!مشية القمر

207
00:17:47,470 --> 00:17:49,910
!ساق العاصفة: وابل نجوم الذّئب

208
00:18:04,840 --> 00:18:09,370
كنت ساذجًا لاعتقادك أنّ بإمكانك
.سرقة المفتاح منّي والهرب

209
00:18:10,330 --> 00:18:14,960
أنا ذئب. سأواصل السّعي خلفك
.إلى أن أغرس أنيابي فيك

210
00:18:20,750 --> 00:18:22,410
.ماذا؟ ما زلت حيًّا

211
00:18:23,240 --> 00:18:28,210
...لا أنوي الهرب... لا أنوي أن أُقتل

212
00:18:31,530 --> 00:18:32,890
.ولا أنوي أن أسامح أيضًا

213
00:18:32,890 --> 00:18:34,280
تسامح؟

214
00:18:36,790 --> 00:18:39,130
هل تتعاطف مع نيكو روبين؟

215
00:18:39,990 --> 00:18:43,590
.إنّ العقل المشتّت يخلق ثغرات خلال القتال

216
00:18:43,590 --> 00:18:47,250
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

217
00:18:47,250 --> 00:18:50,530
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

218
00:18:51,370 --> 00:18:52,910
.انتبه لكلامك

219
00:18:55,560 --> 00:18:59,430
.أنا من النّوع الّذي يشتعل غضبًا

220
00:18:59,430 --> 00:19:02,090
،إن كنت تحت هذا الضّغط
.فلا فرصة لك للإطاحة بي

221
00:19:02,090 --> 00:19:04,780
أنا واثق أنّ هجماتي تسبّبت
.بضرر كثير لك حتّى الآن

222
00:19:04,780 --> 00:19:07,940
...إن لم يكن ذلك كافيًا

223
00:19:07,940 --> 00:19:10,280
:أسلوب الجسد الحديديّ القتاليّ
!شيطان الذّئب السّماويّ

224
00:19:26,650 --> 00:19:30,410
.هيّا اضحك بينما تستطيع ذلك

225
00:19:42,050 --> 00:19:45,840
لا أدري ما الممتع
...في الدّوران هكذا، ولكن

226
00:19:51,560 --> 00:19:53,930
!ما قصّته؟ صارت ساقه حمراء الآن

227
00:19:55,030 --> 00:19:57,100
...إنّها ساق من الجحيم

228
00:19:57,100 --> 00:19:58,890
!ساق الشّيطان

229
00:19:59,600 --> 00:20:03,980
إنّ الحرارة المولّدة من الدّوران
...ستجعل ركلاتي أسرع

230
00:20:07,640 --> 00:20:08,400
!إنّها تلمع

231
00:20:17,160 --> 00:20:19,620
!هذا يحرق

232
00:20:20,290 --> 00:20:24,590
.قوّتها المدمّرة تشبه قوّة شيطان

233
00:20:38,250 --> 00:20:41,270
...هذا يحرق! يحرق، يحرق، يحرق

234
00:20:42,900 --> 00:20:46,570
لـ-لقد احترقت! حتّى عظامي
!ساخنة! لقد انكسرت

235
00:20:47,010 --> 00:20:48,780
!تقنية الجسد الحديديّ لا تعمل

236
00:20:48,780 --> 00:20:51,780
!ما قصّة تلك الرّكلة؟! سحقًا

237
00:20:56,780 --> 00:20:57,880
!غبيّ

238
00:20:57,880 --> 00:21:01,040
لا أصدّق أنّه قفز في الهواء بينما
!خصمه متقن للقوى السّتّ

239
00:21:01,580 --> 00:21:02,950
!ساق الشّيطان

240
00:21:03,920 --> 00:21:05,880
!لحم مفروم من الدّرجة الأولى

241
00:21:05,090 --> 00:21:05,880
!مشية القمر

242
00:21:09,010 --> 00:21:09,840
!يا لغبائك

243
00:21:09,840 --> 00:21:11,550
!أنت غبيّ بالفعل

244
00:21:11,550 --> 00:21:13,830
تحمّست كثيرًا وأصبحت متهوّرًا
!محاولاً إنهاء القتال

245
00:21:13,830 --> 00:21:14,850
!أنا الفائز

246
00:21:17,700 --> 00:21:18,480
!خذ هذه

247
00:21:18,480 --> 00:21:19,600
!مسدّس الأصابع ضوء القمر العشرة

248
00:21:26,320 --> 00:21:29,400
.صددتَ إحدى يداي. كنت وشيكًا

249
00:21:30,000 --> 00:21:32,090
إن كنتَ سريعًا بما يكفي
،لتنفيذ ركلة أخرى

250
00:21:32,090 --> 00:21:34,360
لكنتَ قادرًا على إيقاف
.مسدّس الإصبع بالكامل

251
00:21:35,480 --> 00:21:37,360
...ما كان بيدي حيلة

252
00:21:37,360 --> 00:21:41,370
!لأنّ الرّكلة الأخرى...هدفها الإطاحة بك

253
00:21:43,810 --> 00:21:45,600
!ساق الشّيطان

254
00:21:45,600 --> 00:21:47,420
!ماذا؟ مـ-مهلاً

255
00:21:47,910 --> 00:21:49,380
...ركلة

256
00:21:55,890 --> 00:21:57,460
!اللّهب

257
00:22:08,030 --> 00:22:10,480
...يخلق الإله الطّعام

258
00:22:12,710 --> 00:22:15,210
.والشّيطان التّوابل

259
00:22:18,980 --> 00:22:22,280
.أعتقد أنّني أضفت الكثير من التّوابل

260
00:22:30,340 --> 00:22:34,340
ما الّذي تفعله؟
.بدأت هجماتي بالفعل

261
00:22:34,340 --> 00:22:35,430
!ماذا؟

262
00:22:35,430 --> 00:22:36,430
!زخّات الزّرافة

263
00:22:38,770 --> 00:22:40,600
!لا يمكنني صدّها

264
00:22:40,600 --> 00:22:45,550
بدأت للتّوّ بإظهار قوّة الزّرافة
!الحقيقيّة الجامحة

265
00:22:45,550 --> 00:22:47,030
:في الحلقة القادمة من وان بيس

266
00:22:47,030 --> 00:22:51,080
هجوم السّيف الأبيض! زورو ضدّ"
"!كاكو في نزال سيوف قويّ قاطع

267
00:22:51,080 --> 00:22:53,140
!ملك القراصنة، لن يكون إلاّ أنا

268
00:22:55,990 --> 00:23:00,990
نلقاكم في الحلقة القادمة