1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:51,450 --> 00:01:54,050
!أعد ذهب العمّ ذو الرّأس الماسيّ

22
00:01:54,050 --> 00:01:55,550
ذهب؟

23
00:01:56,750 --> 00:02:00,020
تقصد أغراض العجوز كريكت؟

24
00:02:12,140 --> 00:02:13,900
!الوداع يا قبّعة القشّ

25
00:02:36,830 --> 00:02:40,160
!ما الخطب؟! يا قبّعة القشّ
!إلى أين أنت ذاهب؟

26
00:02:41,770 --> 00:02:42,800
إلى أين؟

27
00:02:47,170 --> 00:02:47,970
!السّماء

28
00:02:52,410 --> 00:02:56,350
!الانطلاق نحو السّماء"
".ركوب تيّار المحيط الصّاعد

29
00:03:04,260 --> 00:03:07,830
!أين هو؟! حلّ الصّباح بالفعل؟

30
00:03:08,560 --> 00:03:13,660
تجاوزنا الموعد المحدّد بأكثر
!من 46 دقيقة! سيفوتنا التّيّار

31
00:03:13,660 --> 00:03:17,800
سيحتاج وقتًا أطول للعودة
!لأنّه يحمل كلّ ذلك الذّهب الآن

32
00:03:17,800 --> 00:03:21,010
!أنا واثقة أنّه لم يأخذ ذلك في حسبانه

33
00:03:21,010 --> 00:03:24,310
لا، لا أعتقد أنّه أخذ الوقت
.في الحسبان على الإطلاق

34
00:03:24,310 --> 00:03:25,810
.نعم، متأكّد من ذلك 200 بالمائة

35
00:03:26,080 --> 00:03:28,580
هل تعتقدون أنّه هُزم في البلدة؟

36
00:03:28,950 --> 00:03:30,680
!على يد بيلامي ذاك؟

37
00:03:30,680 --> 00:03:33,550
إن هُزم، فسيدفع ثمنًا باهظًا
!حتّى إن عاد في الوقت المناسب

38
00:03:34,190 --> 00:03:36,020
...ذلك متوقّع منك

39
00:03:39,760 --> 00:03:42,790
!مرحبًا

40
00:03:46,760 --> 00:03:49,570
!هذا هو! هذا جيّد! لقد عاد

41
00:03:49,570 --> 00:03:51,440
!وجدتها

42
00:03:51,440 --> 00:03:54,840
!لوفي! أسرع! لقد تأخّرنا

43
00:03:54,840 --> 00:03:56,370
!انظروا

44
00:03:56,370 --> 00:04:00,410
!خنفساء هرقل! بحثتُ عنها طويلاً

45
00:04:00,410 --> 00:04:01,780
...كنتَ تبحث

46
00:04:01,780 --> 00:04:03,180
!عن خنفساء؟

47
00:04:11,720 --> 00:04:14,090
!ماذا؟! مذهل

48
00:04:14,090 --> 00:04:16,930
!إنّه النّموذج الطّائر لغوينغ ميري

49
00:04:16,930 --> 00:04:18,830
!يبدو أنّها قادرة على الطّيران

50
00:04:18,830 --> 00:04:22,300
!أليس كذلك؟! فعلوا ذلك من أجلنا

51
00:04:26,800 --> 00:04:28,040
.انظروا إليهم

52
00:04:28,040 --> 00:04:30,610
...رؤيتهم تجعلني أشعر بعدم الرّاحة

53
00:04:30,610 --> 00:04:31,710
.أوافقك

54
00:04:32,340 --> 00:04:36,010
حتّى الحمامة كانت لتبدو
...أفضل من الدّجاجة

55
00:04:36,010 --> 00:04:38,850
!تلك ليست المشكلة هنا
!أنت غبيّ

56
00:04:39,080 --> 00:04:42,520
!حسنًا! لنبحر! أمستعدّون يا رجال؟

57
00:04:42,520 --> 00:04:43,790
!نعم، نعم يا سيّدي

58
00:05:00,400 --> 00:05:03,110
!اصعدوا للسّفينة بسرعة! الوقت يداهمكم

59
00:05:03,110 --> 00:05:07,110
هل تنوون إضاعة فرصتكم
بالذّهاب للسّماء أيّها الحمقى؟

60
00:05:07,450 --> 00:05:09,480
!صحيح! شكرًا على السّفينة

61
00:05:13,350 --> 00:05:15,150
.عليك أن تشكرهم هم

62
00:05:21,360 --> 00:05:23,830
!نعم! شكرًا يا رفاق

63
00:05:24,100 --> 00:05:26,300
!بإمكانكم الاحتفاظ بخنفساء هرقل خاصّتي

64
00:05:26,700 --> 00:05:30,770
!فعلاً؟! هل أنت جادّ؟! يمكننا ذلك؟

65
00:05:30,770 --> 00:05:33,170
!أنت شخص طيّب

66
00:05:33,170 --> 00:05:36,470
!على أيّ حال، علينا الإسراع
!اصعدوا على السّفينة قبل فوات الأوان

67
00:05:36,470 --> 00:05:39,280
!سنسبقكم وأنتم ستتبعوننا

68
00:05:39,640 --> 00:05:41,280
!أسرع يا لوفي

69
00:05:41,280 --> 00:05:42,110
!حاضر

70
00:05:48,750 --> 00:05:53,190
مدينة الذّهب" هذه مجرّد"
!ضرب من خيال نولاند

71
00:05:55,090 --> 00:05:58,130
!عليك أن تدرك أنّ الأحلام لا تتحقّق أبدًا

72
00:06:07,670 --> 00:06:09,470
!يا تحالف ساروياما

73
00:06:12,640 --> 00:06:14,410
!الإخفاق ليس خيارًا الآن

74
00:06:14,880 --> 00:06:19,680
!ابذلوا كلّ ما لديكم مهما حدث

75
00:06:19,680 --> 00:06:21,750
!أجل

76
00:06:24,390 --> 00:06:25,790
!حسنًا! لننطلق

77
00:06:29,860 --> 00:06:31,400
!حان وقت الإبحار يا رفاق

78
00:06:31,400 --> 00:06:32,360
!أجل

79
00:06:32,360 --> 00:06:34,200
!حاضر يا نامي-سان

80
00:06:46,410 --> 00:06:49,850
!أيّها الفتى! هنا ستفترق طرقنا

81
00:06:50,820 --> 00:06:51,880
!نعم

82
00:06:52,650 --> 00:06:56,320
.هنالك حقيقة مؤكّدة واحدة

83
00:06:57,490 --> 00:07:03,860
لم يسبق لأيّ أحد في التّاريخ إثبات عدم
!وجود مدينة الذّهب أو جزيرة السّماء

84
00:07:04,160 --> 00:07:04,800
!نعم

85
00:07:06,230 --> 00:07:11,970
ربّما يضحك النّاس ويصفون الأمر بمنطق
!أحمق، لكنّ ذلك كافٍ بالنّسبة لي

86
00:07:11,970 --> 00:07:14,610
!لكنّ ذلك هو ما تعنيه الرّومانسيّة

87
00:07:14,610 --> 00:07:15,940
...الرّومانسيّة

88
00:07:18,380 --> 00:07:19,640
!هذا صحيح

89
00:07:23,610 --> 00:07:26,750
.وشكرًا على الذّهب

90
00:07:28,150 --> 00:07:31,460
!إيّاكم أن تسقطوا من السّماء، مفهوم؟

91
00:07:33,890 --> 00:07:35,790
!إلى اللّقاء أيّها العمّ

92
00:07:35,790 --> 00:07:38,400
!شكرًا على كلّ شيء يا كريكت-سان

93
00:07:38,600 --> 00:07:42,830
!أنا واثق أنّ مدينة الذّهب حقيقيّة أيّها العجوز

94
00:07:43,200 --> 00:07:46,140
!أيّها العمّ! لا تضغط على نفسك

95
00:07:46,440 --> 00:07:48,610
!اهتمّ بشؤونك الخاصّة

96
00:07:56,150 --> 00:07:58,320
!حلّ الصّباح بالفعل

97
00:07:58,750 --> 00:08:01,120
حسنًا، هل ترون أيّ شيء؟

98
00:08:01,690 --> 00:08:04,520
لا أستطيع حتّى رؤية أفق
!الشّاطئ المقابل لنا بعد

99
00:08:04,520 --> 00:08:07,590
هل هم ذاهبون لجزيرة السّماء بالفعل؟

100
00:08:08,260 --> 00:08:09,930
.نعم، ذلك ما قالوه

101
00:08:10,260 --> 00:08:14,430
،سيكون من الصّعب اللّحاق بهم
.لذلك علينا الاهتمام بأمرهم قبل ذلك

102
00:08:14,870 --> 00:08:19,840
قبّعة القشّ لوفي... مكافأة
...بقيمة 100 مليون بيري

103
00:08:20,910 --> 00:08:24,410
!حسنًا! إنّها السّابعة صباحًا

104
00:08:24,410 --> 00:08:28,950
!يجدر بنا أن نصل لوجهتنا حوالي الحادية عشر

105
00:08:28,950 --> 00:08:33,450
كما قال العجوز، إنّ المكان الّذي
ينطلق منه تيّار المحيط الصّاعد

106
00:08:33,450 --> 00:08:40,390
يتغيّر في كلّ مرّة، لذلك علينا
!الوصول قبل ذلك وإيجاده

107
00:08:40,860 --> 00:08:42,190
!انظرا! انظرا

108
00:08:42,730 --> 00:08:45,900
...نحن متأخّرون قليلاً، لذلك

109
00:08:45,900 --> 00:08:48,700
!أنتم! هل تستمعون إلى شرحي؟

110
00:08:49,430 --> 00:08:51,500
!أرأيتما؟ لقد نظر للأمام

111
00:08:52,940 --> 00:08:55,770
!هنالك طيور غريبة بالفعل في هذا العالم

112
00:08:56,140 --> 00:09:01,050
!صحيح! بإمكانه النّظر للجنوب فقط
!إنّه يشبه بوصلة! هذا ممتع

113
00:09:05,650 --> 00:09:06,550
ما الّذي قاله؟

114
00:09:07,020 --> 00:09:10,550
.قال أنّه سينظر لاتّجاه مختلف لإرباكنا

115
00:09:12,260 --> 00:09:13,490
!لماذا لا تحاول؟

116
00:09:16,760 --> 00:09:18,900
!مهلاً! إنّه ينظر للشّمال

117
00:09:26,970 --> 00:09:29,270
!لا يشعر بارتياح إلاّ إن نظر إلى الجنوب

118
00:09:29,270 --> 00:09:34,410
!أنتم! لا تغضبوا الزّعيم الكبير

119
00:09:35,250 --> 00:09:40,890
!لا بأس! إنّ عفويّتهم تُحمّسني

120
00:09:41,220 --> 00:09:42,890
!ماذا؟ ماذا هنالك؟

121
00:09:43,990 --> 00:09:47,020
!لا داعي للشّعور بالقلق

122
00:09:47,860 --> 00:09:49,560
!لنستمتع بوقتنا

123
00:09:49,560 --> 00:09:51,860
من سبب تأخّرنا؟

124
00:09:52,260 --> 00:09:57,440
إنّه محقّ! لا فائدة من الشّعور
!بالتّوتّر طوال هذه السّاعات

125
00:09:57,670 --> 00:10:02,440
!فهمت! حسنًا يا رجال
!انطلقوا بأقصى سرعة... وبارتياح

126
00:10:05,240 --> 00:10:07,750
!يا له من طقس جميل

127
00:10:10,880 --> 00:10:12,380
!هل سنكون بخير؟

128
00:10:15,590 --> 00:10:18,120
!ماذا؟! ما هذا؟

129
00:10:19,160 --> 00:10:22,090
!السّماء... مظلمة

130
00:10:22,490 --> 00:10:24,360
!أخبار سيّئة يا زعيم

131
00:10:24,360 --> 00:10:25,400
!ما الخطب؟

132
00:10:25,400 --> 00:10:28,800
!يحلّ اللّيل في الجنوب الغربيّ
!إنّها السّحب الملكيّة

133
00:10:29,100 --> 00:10:31,300
!فعلاً؟! ما الوقت الآن؟

134
00:10:31,300 --> 00:10:34,340
!إنّها العاشرة! هذا أبكر ممّا توقّعنا

135
00:10:34,340 --> 00:10:36,840
!هذا سيّئ... شوجو
!أيمكننا الوصول في الوقت؟

136
00:10:36,840 --> 00:10:40,810
!إلى البحر في الحال يا غطّاسي أوتان
!ابحثوا عن التّيّار

137
00:10:43,910 --> 00:10:45,650
!هذه هي السّحب الملكيّة؟

138
00:10:46,380 --> 00:10:47,990
!ماذا الآن؟

139
00:10:49,390 --> 00:10:52,090
!ظهرت أبكر ممّا توقّعنا

140
00:10:52,090 --> 00:10:54,260
!لكنّنا لا نعرف حتّى مكان التّيّار

141
00:11:02,200 --> 00:11:03,630
!تمّ كشف تردّدات صوتيّة

142
00:11:03,630 --> 00:11:06,300
!ثمّة تيّار ضخم أمامنا مباشرةً

143
00:11:06,300 --> 00:11:10,270
مخلوقات ضخمة غربنا
!مباشرةً! يبدو أنّها ملوك بحر

144
00:11:11,040 --> 00:11:14,310
ثمّة موجات عكس التّيّار
!في اتّجاه السّاعة العاشرة

145
00:11:14,310 --> 00:11:16,350
!أعتقد أنّها دوّامة ضخمة

146
00:11:16,350 --> 00:11:19,780
!هذا هو! اسلكوا اتّجاه السّاعة العاشرة

147
00:11:19,780 --> 00:11:23,520
!إنّها إشارة على الانفجار
!اتّجهوا نحو الدّوّامة ولا تتراجعوا

148
00:11:28,260 --> 00:11:29,490
!ما الّذي...؟

149
00:11:29,490 --> 00:11:31,230
!أصبحت الأمواج أعلى فجأة

150
00:11:31,230 --> 00:11:32,760
!سوف نغرق

151
00:11:34,730 --> 00:11:37,740
!إنّه زلزال يسبق الانفجار! استعدّوا

152
00:11:37,740 --> 00:11:39,170
!ا-انفجار؟

153
00:11:39,740 --> 00:11:40,670
!أيّتها الملاّحة

154
00:11:41,370 --> 00:11:42,840
إلام تشير البوصلة المسجِّلة؟

155
00:11:45,780 --> 00:11:47,450
!إنّها تشير لتلك السّحب

156
00:11:48,580 --> 00:11:51,150
!هل جزيرة السّماء هناك؟

157
00:11:51,780 --> 00:11:53,420
!اتّجاه الرّياح مثاليّ أيضًا

158
00:11:53,420 --> 00:11:56,120
إنّ السّحب متّجهة مباشرة
!إلى مركز الدّوّامة

159
00:11:56,450 --> 00:11:59,560
مهلاً، ما هذه "الدّوّامة"؟
...أنا لا أرى شيئًا

160
00:12:00,260 --> 00:12:03,360
!يبدو أنّنا أصبنا الهدف هذه المرّة يا أخي

161
00:12:03,360 --> 00:12:06,830
نعم! ويبدو أنّه سيكون
!انفجارًا ذا حجم جيّد أيضًا

162
00:12:06,830 --> 00:12:08,170
!بإمكاننا الذّهاب؟

163
00:12:08,170 --> 00:12:09,630
!نعم، بإمكاننا

164
00:12:11,700 --> 00:12:12,440
ماذا؟

165
00:12:12,770 --> 00:12:14,740
!سنأخذكم إلى الحافّة الدّاخليّة للدّوّامة

166
00:12:15,240 --> 00:12:17,210
!ماذا نفعل بعد ذلك؟

167
00:12:17,210 --> 00:12:21,550
،اركبوا التّيّار! إن وصلتم إلى المركز
!فستسير الأمور كما يجب

168
00:12:22,980 --> 00:12:24,980
!مركز هذه الدّوّامة الضّخمة؟

169
00:12:45,670 --> 00:12:49,540
.لم أقابل حمقى مثلكم من قبل

170
00:12:50,470 --> 00:12:52,840
!أريد الذّهاب لجزيرة السّماء أيّها العمّ

171
00:12:53,170 --> 00:12:55,640
!الذّهب... لقد سُرق

172
00:12:56,310 --> 00:12:58,010
.سأعود في الصّباح

173
00:13:00,080 --> 00:13:01,820
!إلى اللّقاء أيّها العمّ

174
00:13:05,950 --> 00:13:08,490
...لا يكفّون عن الحديث عن الأحلام

175
00:13:08,860 --> 00:13:12,030
!إنّها تسحبنا

176
00:13:15,730 --> 00:13:18,070
!لم يذكر أيّ أحد أيّ شيء عن دوّامة

177
00:13:18,430 --> 00:13:21,540
!لا بأس! سأحميك أنت وروبين-تشان

178
00:13:22,370 --> 00:13:24,210
...لم أرَ دوّامة ضخمة كهذه من قبل

179
00:13:27,140 --> 00:13:30,510
!هذا سيّئ! لنعد أدراجنا! دعوني أعود

180
00:13:30,510 --> 00:13:33,850
!اقبل الأمر فحسب يا أوسوبّ! فات الأوان
!فهنالك من هو متحمّس سلفًا

181
00:13:34,250 --> 00:13:36,580
!لنذهب إلى جزيرة السّماء

182
00:14:07,780 --> 00:14:13,390
!حسنًا يا رفاق
!الباقي منوط بكم أنتم الآن

183
00:14:13,390 --> 00:14:16,060
!حسنًا! شكرًا على مرافقتنا

184
00:14:16,060 --> 00:14:17,130
!مهلاً

185
00:14:17,130 --> 00:14:20,860
!على مهلكم! أنا خائف

186
00:14:20,860 --> 00:14:22,730
!دعني أعود أيّها الوغد

187
00:14:22,730 --> 00:14:24,630
!هذا الشّيء سيقتلنا في الحال

188
00:14:24,630 --> 00:14:28,470
!لم يخبرنا أحد عن دوّامة عملاقة
!لقد خدعتمونا

189
00:14:28,470 --> 00:14:29,540
!حلّ اللّيل

190
00:14:29,900 --> 00:14:32,970
!الدّوّامة تسحبنا إليها

191
00:14:33,410 --> 00:14:36,510
!لنعد يا لوفي! ما زال بإمكاننا ذلك

192
00:14:36,510 --> 00:14:40,310
!أليس الأمر واضحًا؟
!هذه الدّوّامة وحدها كفيلة بقتلنا

193
00:14:40,310 --> 00:14:42,320
!جزيرة السّماء مجرّد حلم في حلم

194
00:14:42,320 --> 00:14:44,620
حلم في حلم؟ أهذا ما تظنّ؟

195
00:14:44,620 --> 00:14:47,960
!نعم يا لوفي! لا أعتقد أنّ بإمكاننا ذلك أيضًا

196
00:14:48,320 --> 00:14:50,360
!جزيرة في حلم في حلم

197
00:14:50,360 --> 00:14:54,230
سأندم طوال حياتي إن فوّتّ
!مغامرة كبيرة كهذه

198
00:14:54,860 --> 00:14:57,830
...إ-إنّه يستمتع بهذا

199
00:15:01,800 --> 00:15:04,740
أنتم! بينما تعارضون الأمر
...بدون فائدة

200
00:15:04,740 --> 00:15:05,840
ماذا هنالك؟

201
00:15:09,180 --> 00:15:11,080
!تسحبنا الدّوّامة إلى داخلها

202
00:15:13,550 --> 00:15:16,820
!بسرعة يا نامي-سان! تعالي لذراعيّ

203
00:15:20,050 --> 00:15:21,690
!نحن نسقط

204
00:15:24,830 --> 00:15:27,360
!ماذا؟! إنّها تختفي؟! كيف ذلك؟

205
00:15:27,360 --> 00:15:28,400
!ماذا حدث؟

206
00:15:29,060 --> 00:15:33,300
!كـ-كانت تلك الدّوّامة ضخمة أيضًا
!ما الّذي يحدث؟

207
00:15:39,140 --> 00:15:42,780
!كلاّ! بدأ الأمر سلفًا

208
00:15:44,480 --> 00:15:47,250
!اختفت الدّوّامة من السّطح فحسب

209
00:15:48,820 --> 00:15:51,750
...تـ... تقصدين

210
00:15:52,050 --> 00:15:54,390
!مهلاً

211
00:15:57,290 --> 00:15:58,130
!يا زورو

212
00:15:58,930 --> 00:15:59,760
!انظر

213
00:16:07,570 --> 00:16:12,070
!لحقت بك يا قبّعة القشّ لوفي

214
00:16:12,610 --> 00:16:14,680
!...إنّه ذلك الرّجل من موكتاون

215
00:16:16,780 --> 00:16:17,750
!من؟

216
00:16:18,000 --> 00:16:22,720
أنا هنا للحصول على مكافأة المائة
!مليون الّتي على رأسك! استعدّ

217
00:16:27,960 --> 00:16:30,760
من يكونون؟ أصدقاء؟

218
00:16:31,560 --> 00:16:33,430
.لا أدري

219
00:16:37,600 --> 00:16:39,200
لماذا حلّ الظّلام هنا؟

220
00:16:39,430 --> 00:16:42,340
مكافأتي؟ ماذا تعني بمائة مليون؟

221
00:16:42,640 --> 00:16:44,710
!إذًا فأنت لا تعرف

222
00:16:45,370 --> 00:16:49,580
!هنالك مكافأة مائة مليون على رأسك

223
00:16:50,040 --> 00:16:54,380
ومكافأة صائد القراصنة زورو
!هي ستّون مليون بيري

224
00:16:54,680 --> 00:16:57,490
!ذلك صحيح! لديه ملصقات مطلوبين جديدة

225
00:16:57,490 --> 00:17:00,560
!زورو! على رأسك مكافأة الآن

226
00:17:00,560 --> 00:17:04,760
!ماذا؟! تمهّل! ماذا عنّي؟
!هنالك واحدة لي أيضًا، صحيح؟

227
00:17:05,890 --> 00:17:06,330
.لا

228
00:17:06,630 --> 00:17:07,760
!انظر جيّدًا

229
00:17:08,530 --> 00:17:09,260
.لا

230
00:17:11,530 --> 00:17:15,400
فهمت! ارتفعت مكافأتك كثيرًا
!بعد حادثة أراباستا

231
00:17:15,400 --> 00:17:17,110
...لكن مائة مليون

232
00:17:18,840 --> 00:17:22,880
!مائة مليون! أسمعتَ ذلك؟
!مكافأتي مائة مليون

233
00:17:22,880 --> 00:17:25,210
!ستّون مليون فقط؟ هذا محبط

234
00:17:25,210 --> 00:17:27,120
!لا تفرحا بهذا

235
00:17:28,350 --> 00:17:31,650
!يا رفاق! لا تدعوهم يشتّتون انتباهكم

236
00:17:35,520 --> 00:17:39,590
!إنّه قادم! تيّار المحيط الصّاعد قادم

237
00:17:40,090 --> 00:17:42,230
!استعدّوا

238
00:17:45,060 --> 00:17:45,900
ما الّذي...؟

239
00:17:46,500 --> 00:17:49,440
يا رفاق! تمسّكوا بالسّفينة
!جيّدًا أو ادخلوا للدّاخل

240
00:17:49,770 --> 00:17:55,410
!السّفينة... إنّها ترتفع

241
00:18:32,680 --> 00:18:35,850
!كلاّ! ستنقلب سفينتنا

242
00:18:38,320 --> 00:18:40,290
!تحمّلوا

243
00:18:40,290 --> 00:18:42,020
!إيّاكم أن تُرموا من على السّفينة

244
00:18:45,830 --> 00:18:48,430
!هيّا إلى جزيرة السّماء

245
00:18:50,930 --> 00:18:52,330
!ما الّذي يحدث؟

246
00:18:52,330 --> 00:18:55,100
!إنّ السّفينة تصعد عمودًا من الماء

247
00:18:55,700 --> 00:18:56,840
!هذا رائع

248
00:18:56,840 --> 00:18:58,810
!كيف يحدث هذا؟

249
00:19:00,710 --> 00:19:01,780
!الرّياح؟

250
00:19:02,310 --> 00:19:08,750
!حسنًا! بإمكاننا الآن الذّهاب للسّماء
!انطلقي يا ميري

251
00:19:10,990 --> 00:19:14,190
!مهلاً! لا أعتقد أنّ الأمر سيكون سهلاً

252
00:19:14,190 --> 00:19:15,420
!ما-ما الخطب؟

253
00:19:15,420 --> 00:19:17,660
ماذا؟ هل نسينا أمرًا ما؟

254
00:19:17,660 --> 00:19:19,890
!هيكل السّفينة بدأ يطفوا

255
00:19:21,230 --> 00:19:23,970
!إن استمرّ هذا، فسنحلّق بعيدًا نحو هلاكنا

256
00:19:23,970 --> 00:19:29,700
!لكن ما الّذي تريدنا أن نفعله؟
!بالكاد نستطيع التّمسّك

257
00:19:30,810 --> 00:19:31,710
!ما هذا؟

258
00:19:32,710 --> 00:19:33,780
!ملك بحر

259
00:19:33,780 --> 00:19:35,940
!إنّه الّذي تمّ حسبه للدّوّامة

260
00:19:40,310 --> 00:19:43,950
أرأيتم؟! إنّها مسألة وقت فحسب
!قبل أن يحدث ذلك لنا

261
00:19:44,200 --> 00:19:49,460
!مهلاً! نحن نركب انفجارًا قويًّا

262
00:19:49,460 --> 00:19:50,930
!ماذا بإمكاننا فعله؟

263
00:19:51,140 --> 00:19:53,900
!أعتقد أنّها مجرّد ظاهرة طبيعيّة

264
00:19:56,860 --> 00:19:58,170
!تسقط علينا أشياء كثيرة

265
00:19:58,770 --> 00:20:01,900
!إنّها ضحايا تيّار المحيط الصّاعد

266
00:20:01,900 --> 00:20:06,940
نحن هالكون! سنسقط وسنصطدم
!بالمحيط وسنموت

267
00:20:09,340 --> 00:20:10,910
!افردوا الأشرعة في الحال

268
00:20:10,910 --> 00:20:11,280
ماذا؟

269
00:20:11,880 --> 00:20:16,420
هذا هو البحر! وليس مجرّد
!عمود ماء! إنّه تيّار صاعد

270
00:20:16,720 --> 00:20:19,650
والرّياح الّتي تهبّ من تحت
عبارة عن تيّار هوائيّ صاعد

271
00:20:19,650 --> 00:20:21,960
!أنتجته الحرارة الجوفيّة وبخار الانفجار

272
00:20:22,460 --> 00:20:25,260
،إن كنّا نتعامل مع رياح وبحر
!فذلك اختصاصي

273
00:20:25,660 --> 00:20:27,700
!من في رأيكم ملاّحة هذه السّفينة؟

274
00:20:29,460 --> 00:20:31,670
!أنت يا نامي-سان

275
00:20:31,770 --> 00:20:34,800
!يا رفاق! افعلوا ما قالته نامي-سان

276
00:20:33,100 --> 00:20:38,640
سنجمع كل أحلامنا

277
00:20:34,800 --> 00:20:36,140
!أجل

278
00:20:36,400 --> 00:20:38,570
!اركبوا رياح الميمنة واسحبوا الدّفّة نحوها

279
00:20:38,570 --> 00:20:40,140
!صفّوا السّفينة مع التّيّار

280
00:20:38,640 --> 00:20:44,380
ونبحر باحثين عن شيء، باحثين عن

281
00:20:40,140 --> 00:20:40,840
!حاضر

282
00:20:43,180 --> 00:20:45,810
!كلاّ! توشك السّفينة على ترك المياه

283
00:20:44,380 --> 00:20:45,810
!ون بيس

284
00:20:46,210 --> 00:20:49,250
!سنسقط! سنسقط يا نامي
!افعلي شيئًا يا نامي

285
00:20:49,580 --> 00:20:51,250
!لا، بإمكاننا النّجاح

286
00:20:50,620 --> 00:20:56,220
لا تجلب البوصلات سوى التّأخير

287
00:20:54,890 --> 00:20:56,620
!نحن نطير

288
00:20:56,220 --> 00:21:01,960
أمسك بمقود السّفينة وأنا أهذي بالحمّى

289
00:20:59,090 --> 00:21:01,500
!مذهل! السّفينة تطير

290
00:21:01,900 --> 00:21:02,900
!هذا حقيقيّ؟

291
00:21:01,960 --> 00:21:13,370
،إن تمّ التّحقّق من خريطة الكنز المغبرة
!فإنّها ليست أسطورة إذًا

292
00:21:05,970 --> 00:21:06,800
!نجحنا

293
00:21:07,170 --> 00:21:08,200
!أجل

294
00:21:08,500 --> 00:21:10,640
!نامي-سان! أنت رائعة

295
00:21:11,240 --> 00:21:14,110
!أنا أحبّك

296
00:21:14,110 --> 00:21:19,880
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

297
00:21:14,710 --> 00:21:19,010
!انطلقوا! نحو نهاية حلمنا الّذي لم يُرى

298
00:21:19,880 --> 00:21:25,090
فاركب إيقاع أحدهم الحيويّ فحسب

299
00:21:24,220 --> 00:21:26,420
!انطلقوا

300
00:21:25,090 --> 00:21:28,760
!وتظاهر أنّها غير موجودة

301
00:21:26,790 --> 00:21:30,860
،بهذه الرّياح وهذا التّيّار
!بإمكاننا الانطلاق فوق بقدر ما نشاء

302
00:21:28,760 --> 00:21:34,260
سنجمع كلّ أحلامنا

303
00:21:31,660 --> 00:21:34,560
!يا نامي! هل نكاد نصل جزيرة السّماء؟

304
00:21:34,260 --> 00:21:39,970
ونبحر باحثين عن شيء

305
00:21:35,060 --> 00:21:38,270
إن كانت موجودة، فستكون على
!الجانب الآخر من تلك السّحب

306
00:21:39,470 --> 00:21:40,800
!فوق السّحب؟

307
00:21:39,970 --> 00:21:46,210
عملة في جيبي، وتريد أن تصبح صديقي؟

308
00:21:41,440 --> 00:21:43,770
!ما الّذي قد نجده هناك؟

309
00:21:44,340 --> 00:21:47,080
!فلنخترق السّحب الملكيّة

310
00:21:46,310 --> 00:21:51,080
!إنّنا، إنّنا في رحلة بحريّة

311
00:21:51,750 --> 00:21:52,950
!إننا كذلك

312
00:21:55,430 --> 00:22:03,340
آه، خلف السّماء الّتي لا نهاية لها

313
00:22:03,340 --> 00:22:13,950
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

314
00:22:21,830 --> 00:22:29,270
مرّت عليّ أيّام كدت أخسر فيها نفسي

315
00:22:29,270 --> 00:22:37,680
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

316
00:22:37,680 --> 00:22:45,880
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

317
00:22:45,880 --> 00:22:54,730
دفعوا بي للأمام، أليس كذلك؟

318
00:22:54,730 --> 00:23:03,030
آه، إنّ النّجوم تهوي من السّماء

319
00:23:03,030 --> 00:23:06,170
...وهذه اللّحظة الفريدة

320
00:23:11,380 --> 00:23:14,040
!يا رفاق! انظروا خارج السّفينة

321
00:23:14,040 --> 00:23:15,510
!ما هذا المكان؟

322
00:23:15,510 --> 00:23:17,050
!يا للبياض النّاصع

323
00:23:17,050 --> 00:23:19,850
!باختصار، هذا محيط في السّماء؟

324
00:23:19,850 --> 00:23:20,990
!ثمّة شيء ما هناك

325
00:23:20,990 --> 00:23:22,690
...إنّه مخلوق غريب

326
00:23:22,690 --> 00:23:23,550
أهي سمكة؟

327
00:23:23,550 --> 00:23:25,120
!ثمّة شيء ما هناك

328
00:23:25,120 --> 00:23:26,220
!ماذا الآن؟

329
00:23:26,220 --> 00:23:27,990
!إنّه شخص ما! أحدهم قادم

330
00:23:27,990 --> 00:23:29,290
:في الحلقة القادمة من ون بيس

331
00:23:29,290 --> 00:23:32,200
!الإبحار في البحر الأبيض"
".فارس السّماء والبّوابة في السّحب

332
00:23:32,200 --> 00:23:34,670
!ملك القراصنة، لن يكون إلاّ أنا