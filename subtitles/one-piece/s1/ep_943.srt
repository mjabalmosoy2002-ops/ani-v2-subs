6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:00,000 --> 00:02:03,380
!أحمقان... عرفتُ أنّهما لن يكبحا نفسيهما

29
00:02:03,550 --> 00:02:05,590
.سنواجه المشاكل بسبب هذا

30
00:02:06,050 --> 00:02:08,600
!لكن لا يمكننا أن نلومهما

31
00:02:08,760 --> 00:02:12,850
!كيف تجرؤان على التّدخل في إعدامها؟

32
00:02:12,890 --> 00:02:16,980
!ظهر المزيد من أصدقاء الجرذ

33
00:02:17,020 --> 00:02:23,150
!ابنة ياسويي... تلك الشّقيّة اللّعينة مجرمة خطيرة

34
00:02:23,190 --> 00:02:29,280
أيّها السّاموراي! انطلقوا واقتلوا
!كلّ من تدخّل في الإعدام

35
00:02:31,120 --> 00:02:32,700
!اعتنِ بها

36
00:02:32,870 --> 00:02:34,710
!ماذا؟! مـ-مهلاً

37
00:02:34,910 --> 00:02:37,080
!مدفع العنقاء ذو الـ720 رطلاً

38
00:02:41,710 --> 00:02:44,420
!جوّ الصّاعقة

39
00:02:48,390 --> 00:02:49,760
!ابتعد عن طريقي

40
00:02:50,100 --> 00:02:51,470
!لا أظنّ ذلك

41
00:02:51,890 --> 00:02:53,600
...في تلك الحالة

42
00:02:54,270 --> 00:02:55,430
!سأقطعك

43
00:03:02,110 --> 00:03:05,570
.أنا كلب الشّوغن

44
00:03:08,530 --> 00:03:13,990
...أتذكّر كيف أنّك لا تحبّ طريقة ضحكك

45
00:03:14,040 --> 00:03:18,620
حتّى أنّك توقّفت عن الضّحك
...بصوت عالٍ في مرحلة ما

46
00:03:18,670 --> 00:03:24,670
وكلّ من كان يسخر من ضحكتك
!كان يتعرّض لضرب مبرح على يديك

47
00:03:28,050 --> 00:03:31,010
...أرجوك... توقّف

48
00:03:31,220 --> 00:03:35,890
!من فعل هذا بصاحبي؟

49
00:03:36,640 --> 00:03:38,440
!أيّها البالون

50
00:03:39,440 --> 00:03:40,940
يا فتى قبّعة القشّ؟

51
00:03:41,150 --> 00:03:43,230
!أيّها البالون

52
00:03:44,440 --> 00:03:47,860
!ما الّذي تريده يا قبّعة القشّ؟
لماذا تصرخ؟

53
00:03:48,900 --> 00:03:52,620
!هيّا، لنبدأ نزالات السّومو

54
00:03:53,490 --> 00:03:54,620
!هيّا

55
00:03:58,000 --> 00:04:03,340
عزيمة لوفي! الفوز"
"!بنزالات سومو الجحيم

56
00:04:14,220 --> 00:04:15,890
!سانغورو

57
00:04:16,100 --> 00:04:18,140
!دع أوتوكو لي

58
00:04:18,310 --> 00:04:19,690
!شكرًا يا أوسوهاتشي

59
00:04:32,070 --> 00:04:35,740
!سأترك الدّيناصور لك

60
00:04:37,450 --> 00:04:39,830
!نعم! سأتولّى أمره

61
00:04:46,670 --> 00:04:47,880
!أسلوب السّيفين

62
00:04:48,880 --> 00:04:50,800
!ردّ تسلّق البرج

63
00:04:55,470 --> 00:04:57,520
!ساق الشّيطان

64
00:04:58,270 --> 00:04:59,980
!سحق

65
00:05:22,540 --> 00:05:25,210
!زوروجورو قويّ جدًّا

66
00:05:25,250 --> 00:05:28,380
!إنّه ندّ مناسب للزّعيم كيوشيرو

67
00:05:29,960 --> 00:05:31,970
.من الأفضل أن تتوقّف أيّها الرّونين

68
00:05:32,300 --> 00:05:34,590
!من يكون؟

69
00:05:40,810 --> 00:05:44,310
.يبدو أنّ الحظّ يقف إلى جانبي

70
00:05:57,950 --> 00:06:00,700
!أونيوابانشو أوروتشي هنا

71
00:06:08,750 --> 00:06:11,420
.نعرف من تكون

72
00:06:11,840 --> 00:06:16,140
.رورونوا زورو من قراصنة قبّعة القشّ

73
00:06:17,390 --> 00:06:24,140
كان هوكينس محقًّا. يبدو أنّ كلّ أعضاء
.قراصنة قبّعة القشّ هنا في بلاد وانو

74
00:06:24,810 --> 00:06:28,860
.كلّ ما نحتاجه هو واحد منكم
.لا أهتمّ من يكون

75
00:06:28,900 --> 00:06:33,190
سنكتشف هدفكم هنا من
!خلال الإمساك بكم ثمّ تعذيبكم

76
00:06:33,240 --> 00:06:34,070
!لننطلق

77
00:06:34,240 --> 00:06:35,240
!حاضر

78
00:06:47,420 --> 00:06:48,500
شعوذة؟

79
00:06:52,250 --> 00:06:53,210
!نينبو

80
00:06:55,930 --> 00:06:57,640
!بيوا الجحيم

81
00:07:00,510 --> 00:07:02,100
!إنّه مجرّد مسدّس لعين

82
00:07:09,360 --> 00:07:10,150
!توكو

83
00:07:14,650 --> 00:07:16,740
!لا تقلقي

84
00:07:18,910 --> 00:07:22,740
!اهربي من العاصمة في الحال

85
00:07:22,790 --> 00:07:25,290
!سأهتمّ بهم

86
00:07:25,910 --> 00:07:28,370
!ملك السّول

87
00:07:30,380 --> 00:07:32,290
!السّول

88
00:07:32,630 --> 00:07:36,090
!لعنةٌ عليكم

89
00:07:38,680 --> 00:07:40,800
!ظهر ثانية

90
00:07:40,970 --> 00:07:43,850
!غاشادوكورو

91
00:07:44,060 --> 00:07:46,350
!أجل أيّها العظميّ-كيتشي

92
00:07:58,450 --> 00:08:00,610
...تلك المرأة

93
00:08:00,660 --> 00:08:03,780
.كانت مع زوروجورو

94
00:08:03,830 --> 00:08:05,540
.فوجين، رايجين

95
00:08:05,700 --> 00:08:06,790
!حاضر

96
00:08:06,950 --> 00:08:08,790
.طاردا تلك المرأة

97
00:08:08,960 --> 00:08:10,080
!حاضر

98
00:08:49,120 --> 00:08:51,540
.يا له من منظر رائع

99
00:09:12,900 --> 00:09:13,940
،والآن

100
00:09:14,310 --> 00:09:16,190
...اذهب إلى

101
00:09:16,480 --> 00:09:17,900
!الجحيم

102
00:09:32,000 --> 00:09:35,130
.أكل كلاهما فاكهة شيطان

103
00:09:35,170 --> 00:09:38,250
.لا بدّ أنّ التّعذيب بالماء موجع للغاية

104
00:09:46,550 --> 00:09:49,180
!لا تعبث معي

105
00:09:50,560 --> 00:09:52,140
!...أيّها الـ

106
00:09:53,640 --> 00:09:56,810
هل لديك مشكلة؟

107
00:10:00,110 --> 00:10:05,160
.نعم. فكّرت في لعبة شيّقة

108
00:10:20,960 --> 00:10:24,760
!شكرًا على الانتظار أيّها الحمقى

109
00:10:27,550 --> 00:10:30,100
...نزالات سومو الجحيم

110
00:10:33,140 --> 00:10:36,020
!ستُستأنف

111
00:11:24,940 --> 00:11:27,030
.عرفت أنّك قادم

112
00:11:30,740 --> 00:11:33,080
.ترافالغار لو

113
00:11:33,330 --> 00:11:34,660
!أيّها القائد

114
00:11:35,330 --> 00:11:36,660
!آسف أيّها القائد

115
00:11:37,000 --> 00:11:39,040
!وضعك أسرنا في وضع حرج للغاية

116
00:11:41,840 --> 00:11:44,380
ما الّذي فعلتموه بدبّنا الأبيض؟

117
00:11:44,960 --> 00:11:49,510
بإمكانك إخراجهم من هناك
.في رمشة عين بقدرتك

118
00:11:49,550 --> 00:11:56,270
أيّ نوع من من الحمقى قد يُبقي
كلّ رهائنه في مكان واحد واضح؟

119
00:11:56,600 --> 00:11:59,270
.سأزجّ بك في ذلك السّجن أيضًا

120
00:12:00,850 --> 00:12:02,560
.لا تقم باستفزازي

121
00:12:02,610 --> 00:12:04,570
ألم تتعلّم أيّ شيء؟

122
00:12:05,230 --> 00:12:06,990
!أخبرني

123
00:12:09,780 --> 00:12:13,030
.لا يمكنك الإطاحة بي

124
00:12:41,600 --> 00:12:42,650
!هذا مؤلم

125
00:12:44,560 --> 00:12:45,480
!شاتشي

126
00:12:51,200 --> 00:12:55,490
.لديّ أربع حيوات الآن

127
00:13:07,050 --> 00:13:11,380
...بإمكانك تقطيعي فقط بعد أن تقتل

128
00:13:11,880 --> 00:13:13,840
.الأعضاء الثّلاثة من طاقمك

129
00:13:22,140 --> 00:13:25,270
.نعم. هذا جيّد

130
00:13:32,030 --> 00:13:34,070
!ساق الشّيطان

131
00:13:34,780 --> 00:13:36,450
!سحق

132
00:13:56,260 --> 00:13:59,260
.واضح تمامًا أنّ دماء فينسموك تجري في عروقك

133
00:14:00,140 --> 00:14:04,600
!نهيتُكَ عن ذكر ذلك الاسم ثانيةً

134
00:14:06,900 --> 00:14:09,690
كما أنّك تنكّرت أيضًا كمقنّع السّوبا، صحيح؟

135
00:14:09,860 --> 00:14:10,900
ومن يدري؟

136
00:14:11,780 --> 00:14:14,320
.أعتقد أنّني محبوب لدى الدّيناصورات فقط

137
00:14:21,700 --> 00:14:24,370
تريدني أن أصنع منك وجبة بهذه الشّدّة؟

138
00:14:24,540 --> 00:14:27,710
.أنصحك ألّا تعتقد أنّني ضعيف كذلك الرّجل

139
00:14:35,880 --> 00:14:38,720
المكوّنات العنيدة تجعل
.الطّبخ أكثر متعة دائمًا

140
00:14:43,020 --> 00:14:44,810
...ذلك الصّوت

141
00:14:47,440 --> 00:14:48,770
!لجميلة ما

142
00:14:49,400 --> 00:14:51,150
!إنّها تتعرّض للهجوم

143
00:14:59,570 --> 00:15:01,910
!ساق الشّيطان

144
00:15:04,660 --> 00:15:07,750
!لحم مفروم فاخر

145
00:15:39,950 --> 00:15:42,830
.إنّها بحاجة للمساعدة

146
00:15:47,620 --> 00:15:50,830
!سأوافيك في الحال... لأكون بجانبك

147
00:16:10,940 --> 00:16:12,690
!زوروجورو-سان

148
00:16:17,280 --> 00:16:19,030
!أنت تحميها

149
00:16:19,530 --> 00:16:21,240
!إنّها حليفة لك إذًا

150
00:16:31,790 --> 00:16:34,040
!لماذا يطاردونك؟

151
00:16:34,210 --> 00:16:37,300
...أنا آسفة! حاولت إخفاء وجهي، لكن

152
00:16:38,050 --> 00:16:42,430
!يعرف رأس الطّحلب تلك الحسناء؟

153
00:16:44,640 --> 00:16:47,220
!ذلك الوغد

154
00:16:47,890 --> 00:16:53,400
!مكافأته أقلّ... من مكافأتي

155
00:17:06,950 --> 00:17:09,620
...نزالات سومو الجحيم

156
00:17:11,540 --> 00:17:13,750
!ستُستأنف

157
00:17:24,590 --> 00:17:28,930
.لكن لدينا قاعدة جديدة

158
00:17:29,470 --> 00:17:35,900
،إذا ما خطوتما خارج الحلبة
!ستُقتلان بالمسامير في تلك الأطواق

159
00:17:36,570 --> 00:17:39,570
.وهذا لم يتغيّر

160
00:17:39,610 --> 00:17:43,030
...لكنّ القاعدة الجديدة

161
00:17:43,070 --> 00:17:49,370
،ما دمتما على قيد الحياة
.فسيظلّ هذان مغطّسين في الماء

162
00:17:50,450 --> 00:17:55,040
ممّا يعني أنّه فقط عندما
...ستتذوّقان أنت وذلك العجوز

163
00:17:55,460 --> 00:17:57,170
،طعم الموت

164
00:17:57,540 --> 00:17:59,960
.سنخرجهما من الماء

165
00:18:00,130 --> 00:18:03,880
!هذه سخافة! لا علاقة لهم بي

166
00:18:04,050 --> 00:18:07,640
...نعم، هذا صحيح على الأرجح

167
00:18:07,680 --> 00:18:11,850
ولكن، لماذا تبدو مستاءً قليلاً من ذلك؟

168
00:18:12,520 --> 00:18:16,400
هل السّبب هو أنّكم
متنافسون من نفس الجيل؟

169
00:18:16,440 --> 00:18:21,190
حسنًا، بإمكانكما دائمًا التّضحية
.بحياتكما من أجلهما في الحال

170
00:18:21,230 --> 00:18:25,110
بغضّ النّظر عن مدى شهرتكم أو كم من
،مئات الملايين من البيري بلغت مكافآتكم

171
00:18:25,160 --> 00:18:27,950
...فكلّ البشر

172
00:18:27,990 --> 00:18:33,710
.سيغرقون ولو في خمسة سنتيمترات من الماء

173
00:18:38,750 --> 00:18:42,300
.والآن، لتبدأ اللّعبة

174
00:19:18,170 --> 00:19:19,630
،في تلك الحالة

175
00:19:19,960 --> 00:19:22,670
!لماذا لا تدخل أنت الحلبة؟

176
00:19:24,260 --> 00:19:28,510
!سأوسعك ضربًا وأنهي هذا

177
00:19:38,650 --> 00:19:41,400
إلى من تتكلّم في رأيك؟

178
00:19:41,440 --> 00:19:44,360
!لا تستفزّني

179
00:19:44,400 --> 00:19:45,570
!أوغاد

180
00:19:50,870 --> 00:19:52,080
!يا فتى قبّعة القشّ

181
00:19:58,750 --> 00:19:59,790
.أنت

182
00:20:02,420 --> 00:20:03,670
.يا شقيّ

183
00:20:07,380 --> 00:20:11,180
.لا أفهم لماذا أنت متفائل هكذا

184
00:20:16,060 --> 00:20:20,600
هل تعتقد فعلاً أنّ بإمكانك
الخروج من هنا حيًّا؟

185
00:20:21,440 --> 00:20:24,650
هل تعتقد أنّ بإمكانك هزيمتنا؟

186
00:20:28,150 --> 00:20:32,450
!الموت هو مصيركم يا حمقى

187
00:20:33,870 --> 00:20:36,160
!الواحد تلو الآخر

188
00:20:37,700 --> 00:20:40,330
!اخرس

189
00:21:06,520 --> 00:21:08,490
...عندما يتعلّق الأمر بمكان مماتي

190
00:21:09,990 --> 00:21:11,860
!سيكون ذلك من اختياري

191
00:21:36,390 --> 00:21:39,020
أنت! ما هذا الصّوت؟

192
00:21:56,570 --> 00:21:58,200
!أجبني، ما الخطب؟

193
00:21:58,410 --> 00:21:59,870
!هيّا، أجيبوني

194
00:22:00,790 --> 00:22:04,170
كوين-ساما! فقدنا الاتّصال
!بالحرس في الخارج

195
00:22:45,080 --> 00:22:47,750
!وصلتُ أخيرًا

196
00:22:51,880 --> 00:22:54,760
!يا حساء الفاصولياء الحمراء

197
00:23:04,560 --> 00:23:07,270
تحدث حالة طوارئ ويخرج
!الوضع عن السّيطرة

198
00:23:07,310 --> 00:23:12,280
تهيج بيغ مام باحثة عن حساء الفاصولياء
!الحمراء وتصل أخيرًا إلى مكان نزالات السّومو

199
00:23:12,320 --> 00:23:16,820
كوين وبيغ مام! يجد لوفي نفسه محاصرًا
!في مواجهته لهذين الوحشين

200
00:23:16,860 --> 00:23:22,200
ولكن، تغيّر غير متوقّع في الأحداث
!يقع في الجحيم الفوضويّ

201
00:23:22,410 --> 00:23:23,940
:في الحلقة القادمة من وان بيس

202
00:23:23,940 --> 00:23:26,800
"!ضربت العاصفة! بيغ مام الهائجة"

203
00:23:27,040 --> 00:23:30,380
!ملك القراصنة، لن يكون إلاّ أنا