1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:36,330 --> 00:02:39,810
.عش كما تشاء يا لوفي

33
00:02:39,810 --> 00:02:45,110
في مجرى الزّمن، نتيجةً لظروف
،مختلفة وعزائم قويّة

34
00:02:45,110 --> 00:02:47,670
!يستفهم النّاس العالم الّذي يعيشون فيه

35
00:02:47,670 --> 00:02:51,530
.سيأتي اليوم الّذي نلتقي فيه في مرحلةٍ ما

36
00:02:54,540 --> 00:02:57,370
الجزيرة القضائيّة إنيس لوبي هي الباب الأماميّ

37
00:02:57,370 --> 00:03:01,170
.الّذي يقود إلى حكومة العالم، منظّمة هائلة

38
00:03:01,170 --> 00:03:02,750
،بما أنّهم تسبّبوا في انهيارها

39
00:03:02,750 --> 00:03:05,630
.فلا البحريّة ولا القراصنة سيتركونهم وشأنهم

40
00:03:05,630 --> 00:03:09,930
بإمكانكم القول أنّ اسم طاقم قبّعة القشّ
.انتشر كالنّار في الهشيم في العالم أجمع

41
00:03:10,680 --> 00:03:12,510
.وكذلك ملصقات المطلوبين

42
00:03:14,560 --> 00:03:16,880
!سانجي! أنت الأفضل

43
00:03:18,040 --> 00:03:20,020
!أليس هذا مذهلاً؟! الرّسمة تشبهه تمامًا

44
00:03:31,290 --> 00:03:33,790
!قام بعمل مجنون

45
00:03:34,270 --> 00:03:36,370
!انظروا! إنّها مقالة عن قبّعة القشّ

46
00:03:36,940 --> 00:03:39,190
.يبدو أنّه أسقط برج القانون

47
00:03:39,190 --> 00:03:41,900
!سترتفع مكافأته بجنون بعد ذلك

48
00:03:44,330 --> 00:03:48,260
.إنيس لوبي معروفة بقطار ووتر سيفن البحريّ

49
00:03:48,920 --> 00:03:50,640
...ليست بعيدة جدًّا من هنا

50
00:03:51,280 --> 00:03:53,680
.لا بدّ أنّه تحوُّل للقدر

51
00:03:54,740 --> 00:04:00,870
...بأن يكونوا في نطاقنا
.يا له من طاقم مؤسف ويُرثى له

52
00:04:05,950 --> 00:04:07,150
!هيّا بنا أيّها القائد

53
00:04:08,640 --> 00:04:10,270
!بالطّبع سنذهب

54
00:04:13,500 --> 00:04:15,870
!هيّا! استعدّوا للإبحار

55
00:04:15,870 --> 00:04:17,400
!العمل ينتظرنا

56
00:04:17,400 --> 00:04:18,330
!أنت

57
00:04:18,950 --> 00:04:20,610
!انتظر يا تيتش

58
00:04:20,610 --> 00:04:21,950
.كنتُ أبحث عنك

59
00:04:30,830 --> 00:04:34,960
لنعد ثلاثة أيّام إلى الوراء قبل
أن يُصدم ويُذهل العالم

60
00:04:34,960 --> 00:04:38,140
بملصقات المطلوبين الخاصّة
.بقراصنة قبّعة القشّ

61
00:04:38,690 --> 00:04:41,930
.كان هنالك حدث وقع في جزيرة معيّنة

62
00:04:42,640 --> 00:04:46,150
.هذه جزيرة بانارو في الغراند لاين

63
00:04:48,740 --> 00:04:53,740
القوّة الأكثر شناعة! يهاجم"
"!ظلام اللّحية السّوداء إيس

64
00:05:04,040 --> 00:05:08,880
!عجبًا! إيس! القائد

65
00:05:09,350 --> 00:05:11,910
.لا تدعوني بـ"القائد" بعد كلّ هذا الوقت

66
00:05:11,910 --> 00:05:15,220
يفترض أن تُخصّص تلك الكلمة
.للنّاس الّذين تحترمهم

67
00:05:15,780 --> 00:05:17,380
.لا تسخر منّي

68
00:05:19,020 --> 00:05:21,450
.لا بدّ أنّك "قبضة النّار" إيس

69
00:05:21,450 --> 00:05:23,810
!بلحمه وشحمه. سعيد للقائكم

70
00:05:24,380 --> 00:05:28,440
.أرى أنّك أصبحت قائدًا عظيمًا بنفسك

71
00:05:29,250 --> 00:05:33,390
أليس كذلك يا قائد قراصنة
اللّحية السّوداء، مارشال د. تيتش؟

72
00:05:35,420 --> 00:05:38,410
!عجبًا يا إيس! لم أرك منذ وقتٍ طويل

73
00:05:39,070 --> 00:05:41,700
ما الأمر إذًا؟ كيف عرفت أنّني هنا؟

74
00:05:43,450 --> 00:05:46,540
!كفانا لغوًا يا تيتش

75
00:05:47,380 --> 00:05:52,970
،يجدر بك أن تعرف القواعد
.بما أنّك عشت ضعف ما عاشه البقيّة

76
00:05:53,890 --> 00:05:55,510
أليس كذلك؟

77
00:06:04,570 --> 00:06:06,460
.نعم، فهمت

78
00:06:06,460 --> 00:06:09,090
!لكن دعني أخبرك بشيء أوّلاً

79
00:06:09,090 --> 00:06:12,900
ما رأيك يا إيس؟ لِمَ لا تنضمّ لطاقمي؟

80
00:06:15,190 --> 00:06:17,380
!لنستولِ على العالم معًا

81
00:06:17,380 --> 00:06:19,990
!سبق وخطّطتُ لكيف سأرتفع في سلّم القوّة

82
00:06:20,440 --> 00:06:25,000
!عهد اللّحية البيضاء قد ولّى
!سأصبح ملك القراصنة القادم

83
00:06:25,570 --> 00:06:30,330
كبداية، سأقتل قبّعة القشّ لوفي
،الّذي يتواجد في ووتر سيفن

84
00:06:30,330 --> 00:06:32,910
!كهديّة للحكومة

85
00:06:33,890 --> 00:06:37,340
لوفي؟ ماذا قلت للتّوّ؟

86
00:06:37,750 --> 00:06:40,330
!هل تعرفه؟

87
00:06:40,620 --> 00:06:42,990
!أعطيتني سببًا آخر لكي لا أدعك تذهب

88
00:06:43,680 --> 00:06:45,350
!إنّه أخي

89
00:06:45,350 --> 00:06:46,280
ماذا؟

90
00:06:47,130 --> 00:06:51,690
...وبطبيعة الحال، يستحيل قطعًا أن أنضمّ

91
00:06:54,790 --> 00:06:55,820
.لطاقمك

92
00:06:55,820 --> 00:06:56,700
!تبًّا

93
00:07:06,280 --> 00:07:08,540
!سأقدّم لأحد رجالك درسًا في الأخلاق

94
00:07:08,990 --> 00:07:09,670
!مسدّس النّار

95
00:07:18,260 --> 00:07:19,640
!وصيّة اللّهب

96
00:07:20,580 --> 00:07:21,800
!عمود النّار

97
00:07:28,930 --> 00:07:32,730
!أوغر، بارجس! لا تتدخّلا

98
00:07:32,730 --> 00:07:36,120
!لستما ندّين لذلك الرّجل. تراجعا

99
00:07:36,120 --> 00:07:36,700
!آسف

100
00:07:36,700 --> 00:07:38,150
!قبضة النّار

101
00:07:47,300 --> 00:07:49,390
!حرقني

102
00:07:47,300 --> 00:07:50,740
!أيّها القائد

103
00:07:50,740 --> 00:07:52,960
!هذا ساخن، ساخن، ساخن، ساخن، ساخن

104
00:07:54,370 --> 00:07:56,490
!إنّي أحترق

105
00:08:00,130 --> 00:08:01,390
!هذا ساخن، ساخن، ساخن، ساخن

106
00:08:15,730 --> 00:08:17,490
!ساخن، ساخن

107
00:08:21,270 --> 00:08:22,110
!أيّها القائد

108
00:08:22,110 --> 00:08:25,450
!سحقًا! ساخن، ساخن، ساخن، ساخن

109
00:08:26,420 --> 00:08:29,500
!اخرسوا يا هؤلاء! دعوني لوحدي

110
00:09:06,950 --> 00:09:11,820
فهمت يا إيس. إنّك تشتعل
لهفةً لقتلي، أليس كذلك؟

111
00:09:11,820 --> 00:09:15,790
لا عجب في ذلك. فقتل رفيق
.طاقم يعدّ جريمة جسيمة

112
00:09:16,190 --> 00:09:20,140
!صحيحٌ أنّني قتلت قائد الوحدة الرّابعة ثاتش

113
00:09:20,140 --> 00:09:25,600
لكن لم يكن لي خيار! فقد وضع يديه
!على فاكهة الشّيطان الّتي كنتُ أسعى لها

114
00:09:26,160 --> 00:09:30,280
تقضي قاعدة السّفينة أنّ أيًّا من وجد
الفاكهة يستطيع أكلها، هل نسيت؟

115
00:09:30,280 --> 00:09:33,980
،حفظتُ شكل كلّ فاكهة في الكتاب

116
00:09:33,980 --> 00:09:37,820
لذا عرفتُ أنّها الفاكهة الّتي كنتُ
!أسعى لها لحظة رأيتها

117
00:09:37,820 --> 00:09:41,290
والسّبب الوحيد من قضائي كلّ تلك
العقود على سفينة اللّحية البيضاء

118
00:09:41,290 --> 00:09:45,950
هو لأنّي فكّرت أنّه المكان الأكثر
!احتمالاً لوجودها

119
00:09:47,420 --> 00:09:49,910
،كنتُ لأستسلم لو أنّ الحظّ لم يبتسم لي

120
00:09:50,370 --> 00:09:53,510
!لكنّ تلك الفاكهة وقعت في يدي صديقي

121
00:09:56,110 --> 00:10:00,250
إذًا قتلت ثاتش وسرقتها؟

122
00:10:02,030 --> 00:10:03,720
.حسنٌ، هذه سنّة الحياة

123
00:10:04,860 --> 00:10:08,140
!لقد اختارتني هذه القدرة يا إيس

124
00:10:11,220 --> 00:10:14,690
!وجعلت منّي الشّخص الأقوى يا إيس

125
00:10:15,470 --> 00:10:19,500
.انظر! إنّها نادرة، حتّى بالنّسبة لنوع لوغيا

126
00:10:23,880 --> 00:10:26,950
إيس، أليس جسدك من نار؟

127
00:10:33,880 --> 00:10:36,620
!أمّا جسدي فمن ظلام

128
00:10:37,820 --> 00:10:40,880
انظروا! إنّه نفس الدّخان الأسود
.الّذي رأيناه سابقًا

129
00:10:40,880 --> 00:10:43,260
.ما زال أولئك القراصنة في البلدة

130
00:10:43,260 --> 00:10:48,120
ألم ينتهوا بعد؟
!...إن دمّروا المزيد في قريتنا

131
00:10:48,120 --> 00:10:51,050
!لا تقتربوا منهم! خيارنا الوحيد هو الهرب

132
00:10:57,910 --> 00:10:59,440
ظلام...؟

133
00:11:00,150 --> 00:11:05,750
.هذا صحيح أيّها القائد إيس. لا تستطيع قتلي

134
00:11:05,750 --> 00:11:10,120
يقال أنّ هذه القوّة هي الأكثر شرًّا
.في تاريخ فواكه الشّيطان

135
00:11:10,700 --> 00:11:13,650
.إنّها فاكهة شيطان من نوع لوغيا، فاكهة الظّلام

136
00:11:13,650 --> 00:11:16,520
.أصبحتُ رجلاً مصنوعًا من الظّلام

137
00:11:16,520 --> 00:11:20,840
!سأذيقك من قوّتها

138
00:11:23,240 --> 00:11:24,510
.تفضّل

139
00:11:28,410 --> 00:11:29,960
!ماذا تفعل؟! أسرع

140
00:11:29,960 --> 00:11:31,440
!سيطلق القائد العنان لقوّته

141
00:11:31,440 --> 00:11:35,540
،إلّم نسرع بالابتعاد من هنا
!فسنقع في نطاق هجومه

142
00:11:35,540 --> 00:11:36,980
!قف

143
00:12:09,100 --> 00:12:13,720
!إنّ الظّلام المتدفّق من جسده يزحف على الأرض

144
00:12:13,720 --> 00:12:17,580
،مخيف! إنّه حالك السّواد
.وكأنّه توجد حفرة في الأرض

145
00:12:17,580 --> 00:12:19,480
من المخيف كيف أنّه يُشعرك
.وكأنّه سيلتهمك

146
00:12:19,890 --> 00:12:22,450
ابتعدوا بسرعة! ابتعدوا من هنا
!قدر ما تستطيعون

147
00:12:24,060 --> 00:12:27,190
!اذهبوا من خلال الغابة! اهربوا حتّى الشّاطئ

148
00:12:33,160 --> 00:12:38,060
!الظلاّم هو الجاذبيّة
!يملك القوّة لجذب أيّ شيء

149
00:12:38,060 --> 00:12:43,290
ولا حتّى شعاع من الضّوء يمكنه
!الهرب من جاذبيّته اللاّنهائيّة

150
00:12:44,580 --> 00:12:48,800
.لكنّك تواجهني... وما زلتُ سليمًا

151
00:12:49,240 --> 00:12:51,730
.لم أستهدفك بعد

152
00:12:52,460 --> 00:12:54,850
.يمكنك البقاء هنا والاستماع بمظهر البلدة

153
00:12:57,240 --> 00:12:59,760
!الثّقب الأسود

154
00:14:02,850 --> 00:14:05,700
!إنّ الأرض تبتلع البلدة

155
00:14:05,700 --> 00:14:08,750
لماذا؟ مـ-ما الّذي يجري؟

156
00:14:14,430 --> 00:14:21,270
يستخدم الظّلام قوّته اللاّمحدودة
!لتكثيف الأشياء وسحقها

157
00:14:35,350 --> 00:14:40,530
...أهذا كابوس؟ إنّ قريتنا

158
00:14:48,200 --> 00:14:52,340
.والآن سأريك ماذا حلّ بالقرية المفقودة

159
00:14:52,740 --> 00:14:55,220
!انظر كيف أصبحت في فوضى عارمة

160
00:14:55,740 --> 00:14:57,150
!تحرير

161
00:15:23,860 --> 00:15:27,530
...أمست قريتنا... من ركام

162
00:15:35,690 --> 00:15:37,640
هل فهمت الآن يا إيس؟

163
00:15:37,640 --> 00:15:40,350
!هذه القوّة الّتي اكتسبتها

164
00:15:42,740 --> 00:15:43,720
!ضوء اليراعة

165
00:15:44,200 --> 00:15:46,060
!اشتعال

166
00:15:48,220 --> 00:15:50,340
!ساخن، ساخن، ساخن، ساخن

167
00:15:51,150 --> 00:15:53,520
!هذا يحرق

168
00:15:54,030 --> 00:15:57,950
.أعي تمامًا مدى عظمة قوّة الظّلام

169
00:15:54,030 --> 00:15:57,950
!ساخن، ساخن، ساخن، ساخن

170
00:15:57,950 --> 00:15:59,720
...لكن ما يحيّرني

171
00:15:59,720 --> 00:16:03,530
إن كانت من نوع لوغيا، فيجدر
.بهذه الهجمات أن تخترقك

172
00:15:59,720 --> 00:16:03,530
!سحقًا! هذا ساخن! ساخن، ساخن، ساخن، ساخن

173
00:16:15,760 --> 00:16:19,700
،سبق وأخبرتك أنّ الظّلام يجذب كلّ شيء

174
00:16:19,700 --> 00:16:22,510
وذلك يشمل الرّصاص والسّيوف
!واللّكمات والنّار والبرق

175
00:16:23,170 --> 00:16:26,850
على خلاف بقيّتكم، لا أملك خيار
!أن أدع الأشياء تعبر من خلالي

176
00:16:26,850 --> 00:16:31,440
جسدي يشعر بألم أسوأ بكثير
!من سائر النّاس من كلّ ناحية

177
00:16:33,370 --> 00:16:36,650
،لكن مقابل قبول تلك المخاطرة
...ثمّة شيء آخر

178
00:16:36,650 --> 00:16:39,170
.يمكنني ابتلاعه

179
00:16:39,170 --> 00:16:40,640
!ماء الظّلام

180
00:16:45,020 --> 00:16:49,100
على وجه الدّقّة، تملك جاذبيّة الظّلام القدرة على
.سحب الجسد المادّيّ لحامل قوّة فاكهة الشّيطان

181
00:16:53,540 --> 00:16:54,900
!الجاذبيّة؟

182
00:16:58,810 --> 00:17:00,510
...وجسدي

183
00:17:06,570 --> 00:17:11,440
إذًا؟ هل فهمت الأمر يا إيس؟

184
00:17:13,030 --> 00:17:13,900
!...لا يمكن

185
00:17:39,170 --> 00:17:44,970
لا بدّ أنّه مضى وقتٌ طويل
.مذ لكمك أحد يا إيس

186
00:17:45,790 --> 00:17:50,110
!أظنّ أنّك أدركتَ الأمر عندما أمسكتُ بك

187
00:17:51,670 --> 00:17:54,880
...الشّيء الآخر الّذي يسحبه ظلامي هو

188
00:17:54,880 --> 00:17:56,920
!قوى فاكهة الشّيطان

189
00:17:58,120 --> 00:18:00,480
،ما يعني أنّني بينما ألمسهم

190
00:18:00,480 --> 00:18:04,010
لا يمكن لحاملي قوّة فاكهة الشّيطان
!استخدام أيٍّ من قواهم

191
00:18:05,210 --> 00:18:08,060
!لوغيا وزون وباراميسيا

192
00:18:08,060 --> 00:18:12,560
في وجه عالمٍ من حاملي قوّة فاكهة الشّيطان
،الّذين يملكون ثقةً مفرطة في قدراتهم

193
00:18:12,560 --> 00:18:15,620
!قد اكتسبتُ وسيلةً هجوميّة لا يمكن صدّها

194
00:18:18,050 --> 00:18:19,630
لا يجب أن أدعك تلمسني فحسب، صحيح؟

195
00:18:20,050 --> 00:18:24,240
سبق وأثبتّ لك أنّك لا تستطيع
!الهرب من جاذبيّة ظلامي

196
00:18:24,240 --> 00:18:26,010
!ماء الظّلام

197
00:18:29,930 --> 00:18:31,270
!نار الإله: النّار المجهولة

198
00:18:32,560 --> 00:18:33,680
!خذ هذه

199
00:18:49,060 --> 00:18:52,290
!...سحقًا! رماح النّار

200
00:18:53,360 --> 00:18:55,290
!كسر بعض فِقراتي

201
00:18:57,260 --> 00:19:00,160
!...قوّته الجديدة مزعجة

202
00:19:01,090 --> 00:19:03,110
!نار الصّليب

203
00:19:14,890 --> 00:19:17,600
!إنّ صخرة الموزة... تنهار

204
00:19:18,980 --> 00:19:22,980
!ما الّذي يجري؟ لا يعقل أن يكونا من البشر

205
00:19:24,530 --> 00:19:30,000
!انسوا أمر القرية
!ما الّذي سيحدث... لجزيرتنا؟

206
00:19:39,390 --> 00:19:43,780
افترضتُ أنّ حاملي قوّة فاكهة
الشّيطان منهمكين جدًّا في قواهم

207
00:19:43,780 --> 00:19:47,040
لدرجة أنّهم سيصبحون خصومًا
.ضعاف عندما يفقدونها

208
00:19:47,040 --> 00:19:52,740
لكن كان يجب أن أتوقّع
من أحد قادة اللّحية البيضاء

209
00:19:52,740 --> 00:19:55,270
.أن يكون مقاتلاً مهيبًا في القتال الأساسيّ أيضًا

210
00:20:01,890 --> 00:20:07,400
.وها هو اليوم يقودنا إلى مفترق طرق مصيريّ آخر

211
00:20:23,810 --> 00:20:26,680
!كلّ شيء يُصبح بلا حول ولا قوّة أمام الظّلام

212
00:20:26,680 --> 00:20:29,260
.حتّى شخص بقوّتك

213
00:20:30,020 --> 00:20:33,470
.لكنّ هذا يزيدني شوقًا للحصول على قوّتك

214
00:20:34,380 --> 00:20:37,450
!إيس، انضمّ لطاقمي

215
00:20:44,550 --> 00:20:49,050
إن خنعتُ للقوّة، فلا مغزى
.من أن تلدني أمّي رجلاً

216
00:20:50,270 --> 00:20:53,850
!لن أترك شيئًا أندم عليه لاحقًا في حياتي

217
00:20:53,850 --> 00:20:55,030
هل فهمت أيّها الغبيّ؟

218
00:20:57,100 --> 00:20:59,970
إلى متى تستطيع العيش بهذا
المبدأ في هذا العالم؟

219
00:20:59,970 --> 00:21:03,000
!هذه خسارة يا إيس

220
00:21:05,040 --> 00:21:06,960
!فلتمت في الظّلام

221
00:21:07,690 --> 00:21:10,050
:وصيّة اللّهب العظيمة

222
00:21:17,830 --> 00:21:19,520
!إمبراطور اللّهب

223
00:21:27,990 --> 00:21:31,450
!الشّمس أو الظلاّم... يوجد فائز واحد بينهما

224
00:21:32,650 --> 00:21:36,490
!سأجعل من اللّحية البيضاء الملك

225
00:22:08,110 --> 00:22:11,250
"معركة جزيرة بانارو الحاسمة"
...في الغراند لاين

226
00:22:12,360 --> 00:22:16,320
...سيُعتبر القتال بين هذين الاثنين

227
00:22:16,320 --> 00:22:22,110
.سبب وقوع حادثة هائلة في وقت قريب

228
00:22:31,300 --> 00:22:33,630
!إلى بحر المغامرة

229
00:22:33,630 --> 00:22:35,550
!لنتّجه مباشرةً إلى جزيرة البرمائيّين

230
00:22:35,550 --> 00:22:40,180
لا، لا، لا، لا! بوجودنا قرب العالم
!الجديد، علينا أخذ فائق الحذر

231
00:22:40,180 --> 00:22:41,770
.يا سانجي! ثمّة سفينة

232
00:22:41,770 --> 00:22:43,440
.إنّها تفتقر للشّراع والرّاية

233
00:22:43,440 --> 00:22:45,890
!هل نبحر نحو المشاكل بأقصى سرعة من الآن؟

234
00:22:45,890 --> 00:22:47,230
:في الحلقة القادمة من وان بيس

235
00:22:47,230 --> 00:22:50,940
!عصابة القراصنة الغامضة"
"!ساني والفخّ الخطير

236
00:22:50,940 --> 00:22:53,320
!ملك القراصنة، لن يكون إلاّ أنا

237
00:22:55,990 --> 00:23:01,000
نلقاكم في الحلقة القادمة