1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,130 --> 00:03:24,230
،بعد أن فقد أخاه إيس أثناء حرب القمّة ضدّ البحريّة

38
00:03:24,230 --> 00:03:29,610
.وصل لوفي إلى جزيرة النّساء حيث غرق في حزن لا يطاق

39
00:03:30,400 --> 00:03:34,120
...لكن ثمّة قصّة لم تُروَ عن الإخوة

40
00:03:34,900 --> 00:03:40,350
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كصبيّين

41
00:03:41,320 --> 00:03:48,220
تُركَ لوفي مع دادان، لصّة جبل من جبل كولبو
.وقابل صبيّين سابقين لأوانهما يدعيان إيس وسابو

42
00:03:51,530 --> 00:03:56,330
"!ترك عائلة دادان إلى الأبد؟! تمّ بناء مخبأ الأطفال"

43
00:04:01,660 --> 00:04:03,730
كيف حالك يا بوتشي؟

44
00:04:07,440 --> 00:04:11,610
!من حفر حفرة أمام الباب؟

45
00:04:12,060 --> 00:04:15,450
.كان إيس والآخرين، بهدف إمساك الخنازير البرّيّة

46
00:04:15,450 --> 00:04:19,830
!هذا بيتي! لا يمكنهم أن يحفروا حفرةً أينما شاؤوا

47
00:04:20,130 --> 00:04:21,830
!أولئك الأشقياء

48
00:04:22,720 --> 00:04:26,250
!سابو، من منحك الإذن لغزو منطقتنا؟

49
00:04:26,530 --> 00:04:30,030
!منطقتكم؟! أنتم سخيفون حقًّا

50
00:04:30,030 --> 00:04:32,760
!كفّوا عن التّفوّه بالهراء وأروني ما لديكم

51
00:04:33,230 --> 00:04:35,330
!حسنًا، استعدّ

52
00:04:38,040 --> 00:04:39,400
!إيس

53
00:04:40,140 --> 00:04:41,390
!انتبه

54
00:04:46,200 --> 00:04:47,860
!سحقًا

55
00:04:47,860 --> 00:04:49,230
!أيّها الحقير

56
00:04:50,900 --> 00:04:52,710
!صنعتُ تفويجًا

57
00:04:57,160 --> 00:04:59,660
!ها هو ذا رئيس الشّرطة! لنذهب

58
00:05:03,930 --> 00:05:07,050
!لوفي، أسرع! من هنا

59
00:05:10,460 --> 00:05:12,180
!عاد

60
00:05:17,660 --> 00:05:19,630
!لنصطد غزالاً من أجل العشاء

61
00:05:19,630 --> 00:05:23,560
!أجل! أحبّ لحم الغزال! لنذهب للصّيد

62
00:05:23,560 --> 00:05:24,770
!انتظر

63
00:05:25,960 --> 00:05:27,520
!عدنا

64
00:05:27,520 --> 00:05:30,190
!لا تعودوا للبيت أيّها الأشقياء المزعجين

65
00:05:30,460 --> 00:05:32,030
.هذا هو العشاء

66
00:05:32,030 --> 00:05:33,300
.اطبخيه الآن

67
00:05:33,300 --> 00:05:35,860
!إنّه وقت الطّعام

68
00:06:04,580 --> 00:06:06,730
!لا تهدروا الطّعام

69
00:06:09,230 --> 00:06:11,300
!سيأكلني

70
00:06:13,070 --> 00:06:15,410
!لا تخرجوا إلى أن تعدّوا حتّى 10،000

71
00:06:21,630 --> 00:06:24,030
!توقّف

72
00:06:24,400 --> 00:06:26,160
!أيّها النّذل

73
00:06:36,080 --> 00:06:37,180
!صدقًا

74
00:06:37,180 --> 00:06:41,350
لِمَ علينا أن نقوم بأعمال تنظيف
!البيت الشّاقة كلّ ليلة بعد العشاء؟

75
00:06:41,350 --> 00:06:44,030
!سأطردهم بأيّ ثمن

76
00:06:49,010 --> 00:06:51,060
!إنّه نظيف الآن

77
00:06:51,870 --> 00:06:54,080
!لوفي! انتظر أيّها الوغد

78
00:06:57,910 --> 00:07:00,410
...أ-أيّتها الزّعيمة

79
00:07:03,560 --> 00:07:05,120
...يا إلهي

80
00:07:08,830 --> 00:07:11,870
الوقت الوحيد الّذي يمكنني الاستراحة فيه
.هو عندما أدخل إلى الفوتون خاصّتي

81
00:07:16,970 --> 00:07:19,550
!التّدريب الأخير بالنّسبة لليوم

82
00:07:19,550 --> 00:07:20,970
!سأفوز

83
00:07:20,970 --> 00:07:22,180
!لن تتعلّم أبدًا

84
00:07:22,180 --> 00:07:23,350
!ها نحن أولاء

85
00:07:23,350 --> 00:07:24,390
!حسنًا

86
00:07:44,910 --> 00:07:46,320
!أهلاً يا جنّيّة

87
00:08:03,430 --> 00:08:04,390
!سحقًا

88
00:08:04,390 --> 00:08:06,730
لوفي، هل أنت بخير؟

89
00:08:06,730 --> 00:08:08,020
.يا له من طابق سيّئ

90
00:08:08,020 --> 00:08:10,060
!أيها الوغد

91
00:08:10,060 --> 00:08:12,270
!أنتم

92
00:08:14,790 --> 00:08:16,150
هل نذهب للنّوم؟

93
00:08:16,150 --> 00:08:17,150
.أجل

94
00:08:19,110 --> 00:08:21,610
!علينا أن نطرد الأشقياء

95
00:08:21,610 --> 00:08:25,790
!إلّم نفعل شيئًا، سيستولون على عائلة دادان

96
00:08:25,790 --> 00:08:28,870
!قبل كلّ شيء، هذا الأمر يدهور صحّتي

97
00:08:28,870 --> 00:08:30,870
.على رسلك يا زعيمة

98
00:08:30,870 --> 00:08:34,750
!لقد استولوا علينا قبل وقت طويل

99
00:08:34,750 --> 00:08:38,970
!اخرس! فقط لا أستطيع الاعتناء بهم بعد الآن

100
00:08:38,970 --> 00:08:41,010
!أجل، سأطردهم

101
00:08:41,010 --> 00:08:43,970
!انسيا اتّفاقنا مع غارب

102
00:08:43,970 --> 00:08:44,990
!أنت

103
00:08:45,470 --> 00:08:46,900
غارب؟

104
00:08:49,760 --> 00:08:53,810
!أنا آسفة، آسفة! لا أدري ما دفعني لقول ذلك

105
00:08:53,810 --> 00:08:58,730
.المعذرة. سمعت أنّ لوفي هنا

106
00:09:04,320 --> 00:09:05,360
!ماكينو

107
00:09:05,360 --> 00:09:06,870
!لوفي

108
00:09:07,510 --> 00:09:09,140
!تبدو بصّحة جيّدة

109
00:09:09,140 --> 00:09:12,370
.مضت ستّة أشهر، لذا أتينا إلى هنا لنرى كيف حالك

110
00:09:12,370 --> 00:09:13,960
!مرحبًا أيّها المحافظ

111
00:09:13,960 --> 00:09:16,210
.لا تخبر غارب-سان

112
00:09:16,210 --> 00:09:19,510
...إذًا أنت تعيش مع اللّصوص حقًّا

113
00:09:19,510 --> 00:09:21,260
هل لديك مشكلة؟

114
00:09:21,260 --> 00:09:25,090
،أجل، ولصّة كبيرة! أنت لصّة
!لذا لا تتصرّفي معي بهذا الأسلوب

115
00:09:25,090 --> 00:09:28,430
!ماذا؟! النّاس من قرية فوشا مزعجون جميعًا؟

116
00:09:28,970 --> 00:09:30,600
!لديّ بعض الهدايا لك

117
00:09:30,920 --> 00:09:34,850
أفترض أنّ غارب-سان ما كان
...ليفكّر بشأن هذه الأشياء

118
00:09:34,850 --> 00:09:37,400
!ها هي ذي! ملابس جديدة

119
00:09:37,400 --> 00:09:39,610
!عظيم

120
00:09:39,610 --> 00:09:41,030
.مسرورة لأنّها أعجبتك

121
00:09:41,610 --> 00:09:45,780
.سأضبط الطّول، لذا... أحتاجكما أيضًا

122
00:09:45,780 --> 00:09:46,700
اتّفقنا؟

123
00:09:48,240 --> 00:09:49,740
!أنت

124
00:09:49,740 --> 00:09:51,200
.أنت أيضًا

125
00:09:55,840 --> 00:09:58,420
سمعت أنّ إيس-كن مشاغب

126
00:09:58,420 --> 00:10:00,630
.لكنّك تبدو كولد مطيع

127
00:10:00,630 --> 00:10:02,800
...لـ-لا، لستُ كذلك

128
00:10:04,130 --> 00:10:05,280
!إنّه خجول جدًّا

129
00:10:05,280 --> 00:10:06,720
!إنّك تحمرّ خجلاً يا إيس

130
00:10:07,140 --> 00:10:08,060
!أنتما

131
00:10:08,060 --> 00:10:10,150
!مهلاً، لا يجب أن تتحرّك

132
00:10:10,150 --> 00:10:11,310
.سأنال منكما لاحقًا

133
00:10:18,520 --> 00:10:20,320
!آمل أن يعجبكم

134
00:10:24,200 --> 00:10:25,680
!لذيذ

135
00:10:29,030 --> 00:10:33,040
.يجب أن تكون الوجبات لذيذة في السّفينة

136
00:10:33,040 --> 00:10:36,620
!سأضمّ أفضل طبّاخ أوّلاً عندما أذهب للبحر

137
00:10:36,620 --> 00:10:40,530
.سأصبح قرصانًا قبلك لذا لا تنس ذلك

138
00:10:40,530 --> 00:10:43,670
!هذا ليس عدلاً! سأصبح قرصانًا أوّلاً

139
00:10:50,010 --> 00:10:52,720
!أما زلتما تتفوّهان بهراء كهذا؟

140
00:10:54,400 --> 00:10:58,440
!ألا تفهمان أنّ عليكما أن تصيرا جنديّي بحريّة؟

141
00:11:01,480 --> 00:11:02,220
!دادان

142
00:11:02,230 --> 00:11:04,150
...حاضرة يا غارب-سان

143
00:11:05,110 --> 00:11:06,780
لِمَ ضربتني أيضًا؟

144
00:11:06,780 --> 00:11:09,910
!إنّك لا تربّين الأشقياء جيّدًا

145
00:11:09,910 --> 00:11:14,040
إنّه غارب؟ إنّه جدّ إيس ولوفي؟

146
00:11:14,040 --> 00:11:17,750
أيّها التّافه، ذكرت أنّك ستذهب
...إلى البحر أيضًا

147
00:11:17,750 --> 00:11:20,210
!ليس "تافه" بل سابو

148
00:11:20,210 --> 00:11:25,630
!لقد تبادلنا كأس ساكي وتعاهدنا أن نصبح قراصنة

149
00:11:25,630 --> 00:11:27,090
...إنّه ثرثار

150
00:11:27,090 --> 00:11:33,810
هذا يعني أنّ هنالك ثلاثة حمقى
!يريدون منّي أن أوكّلهم بتمرين حقيقيّ

151
00:11:37,140 --> 00:11:38,270
!لا يمكنكم أن تهربوا

152
00:11:39,310 --> 00:11:41,240
...يا إلهي

153
00:11:43,110 --> 00:11:47,150
.لا بدّ أنّك سعيد يا لوفي
.لديك أخوين كبيرين الآن

154
00:11:49,030 --> 00:11:50,660
!انتظروا

155
00:11:50,660 --> 00:11:51,780
!خذ هذه

156
00:11:51,780 --> 00:11:53,120
!الصّدر

157
00:11:53,120 --> 00:11:54,990
!خذ، خذ، خذ

158
00:11:54,990 --> 00:11:57,370
!هذا العجوز كوحش

159
00:12:03,500 --> 00:12:07,920
!هذا يكفي لليوم! سأتعامل معكم بقسوة أكثر غدًا

160
00:12:07,920 --> 00:12:09,300
!لا يمكنكم أن تموتوا بعد

161
00:12:23,320 --> 00:12:26,530
.إلّم نفعل شيئًا، سيقتلنا العجوز غدًا

162
00:12:26,530 --> 00:12:28,560
،حتّى إن نجونا

163
00:12:28,560 --> 00:12:31,700
!سيواصل فعل ذلك حتّى نتخلّى عن حلمنا

164
00:12:31,700 --> 00:12:33,570
!لا أريد أن أموت

165
00:12:33,570 --> 00:12:35,330
.لدينا خيار واحد فقط

166
00:12:35,330 --> 00:12:38,700
!آن الأوان لكي نحسم أمرنا يا أخواي

167
00:13:03,310 --> 00:13:05,520
ماذا نفعل بشأن هذا؟

168
00:13:06,610 --> 00:13:08,440
.يا لهم من متحذلقين

169
00:13:08,440 --> 00:13:13,950
كيف لك ألاّ تهتمّ؟! إنّهم شائنو
!السّمعة حتّى في وسط المدينة

170
00:13:13,950 --> 00:13:19,500
سيحاول أيّ أحد أن يقتلهم فور أن
!يراهم لو لم يكونوا تحت حمايتنا

171
00:13:19,500 --> 00:13:21,320
!انتهت عطلتي

172
00:13:21,320 --> 00:13:25,580
عليك أن تجعلي منهم رجال بحريّة
!مؤهّلين عندما أعود في المرّة القادمة

173
00:13:25,580 --> 00:13:27,590
!هل ستترك كلّ شيء لي ثانيةً؟

174
00:13:27,590 --> 00:13:28,190
ماذا؟

175
00:13:28,190 --> 00:13:30,010
!الوداع

176
00:13:33,260 --> 00:13:35,260
!الوداع

177
00:13:38,100 --> 00:13:41,430
!كيف للصّة أن تربّي جنديّ بحريّة؟

178
00:13:41,430 --> 00:13:43,310
!ذلك العجوز الخرف لا يدري ما يقول

179
00:13:43,310 --> 00:13:45,150
.هوّني عليك أيّتها الزّعيمة

180
00:13:45,150 --> 00:13:49,530
.إذًا أنت قلقة بشأن أولئك الأطفال في النّهاية

181
00:13:50,610 --> 00:13:55,410
.من يهتمّ؟! بالتّفكير في الأمر، هذا يفيدنا

182
00:13:55,410 --> 00:13:59,620
!لقد غادروا طواعية! أنا مسرورة

183
00:14:01,250 --> 00:14:02,930
!هربنا بنجاح

184
00:14:03,590 --> 00:14:05,420
.دادان والبقيّة لا يلاحقوننا

185
00:14:09,400 --> 00:14:13,680
!"صحيح أنّ "أطفال الشّيطان يملكون حظّ الشّيطان

186
00:14:13,680 --> 00:14:16,390
!إنّه طفل الشّيطان

187
00:14:16,760 --> 00:14:21,510
يمكنني أن أرى أنّها تشعر بالسّعادة
!الآن لأنّ متاعبها ذهبت

188
00:14:25,190 --> 00:14:28,610
!لا! إنّها تمطر

189
00:14:40,240 --> 00:14:42,450
.لنبق هنا ونختبئ من المطر

190
00:14:44,080 --> 00:14:46,210
!هذا شيّق

191
00:14:50,380 --> 00:14:54,440
!غيّرت رأيي. لا أريد أن أتعرّض لضرب مبرح من غارب

192
00:14:54,440 --> 00:14:57,180
!اذهبا وابحثا عن الأشقياء الأغبياء

193
00:14:57,180 --> 00:14:58,590
!حاضر

194
00:15:52,730 --> 00:15:55,000
!رفاق

195
00:15:55,000 --> 00:15:57,400
!إيس! سابو

196
00:15:57,400 --> 00:15:58,700
!لوفي

197
00:15:58,700 --> 00:16:00,160
!انظرا لهذا

198
00:16:00,160 --> 00:16:01,470
ما هو؟

199
00:16:01,470 --> 00:16:06,410
.قمتُ بتصميم مخبئنا
لا يمكننا أن ننام في الخارج دائمًا، صحيح؟

200
00:16:06,410 --> 00:16:10,330
!لذا علينا أن نبني مخبأنا ها هنا

201
00:16:10,330 --> 00:16:13,960
!مخبأ... كم هذا رائع

202
00:16:13,960 --> 00:16:15,590
ماذا عن الموادّ؟

203
00:16:15,590 --> 00:16:19,800
.ثمّة الكثير من تلك الأشياء

204
00:18:08,200 --> 00:18:11,450
!مذهل! يبدو كما التّصميم تمامًا

205
00:18:11,450 --> 00:18:14,210
!إنّه عمل عظيم برأيي

206
00:18:14,210 --> 00:18:16,050
ما الخطب يا إيس؟

207
00:18:16,050 --> 00:18:19,880
!هذا مخبأ، لذا علينا أن ننصب بعض الفخاخ

208
00:18:19,880 --> 00:18:21,710
!حسنًا، سأفكّر في الأمر

209
00:18:25,800 --> 00:18:26,980
!أجل

210
00:18:26,980 --> 00:18:28,880
،لدينا إطلالة على غري ترمينال

211
00:18:28,880 --> 00:18:31,390
!وكذلك قرية فوشا ومياه الأزرق الشّرقيّ

212
00:18:31,390 --> 00:18:34,390
ليس غير مألوف، أليس كذلك؟

213
00:18:34,390 --> 00:18:36,440
!من الجميل رؤيتهم من هنا

214
00:18:50,160 --> 00:18:53,110
!معك حقّ! هذا مختلف

215
00:19:04,840 --> 00:19:06,880
!لوفي، ثمّة ريح خلفيّة! افرد الأشرعة

216
00:19:06,880 --> 00:19:07,890
!حسنًا

217
00:19:12,890 --> 00:19:14,930
!هيّا نتقدّم إلى الكنز

218
00:19:15,600 --> 00:19:17,810
!عدوّ في مقدّمة السّفينة والميمنة

219
00:19:17,810 --> 00:19:21,360
!إنّها سفينة بلوجام! تجهّزا للقتال

220
00:19:22,190 --> 00:19:26,280
!بدؤوا يطلقون! راوغا

221
00:19:26,280 --> 00:19:29,390
!لوفي، إلى أقصى الميسرة

222
00:19:29,390 --> 00:19:31,410
!أجل، مفهوم

223
00:19:31,410 --> 00:19:35,500
!لا! عليك أن تقول "عُلم وسيُنفّذ" في ظرف كهذا

224
00:19:35,500 --> 00:19:36,880
.صحيح

225
00:19:37,370 --> 00:19:40,130
!لوفي، إلى أقصى الميسرة

226
00:19:40,130 --> 00:19:43,340
!أقصى الميسرة! عُلم ويُنفّذ

227
00:19:47,380 --> 00:19:49,430
!لنقاتل مباشرةً! إلى سطح السّفينة

228
00:19:51,850 --> 00:19:54,220
!انتظراهم ليأتوا إلى سطح السّفينة

229
00:19:54,220 --> 00:19:55,550
!مفهوم

230
00:19:55,550 --> 00:19:57,480
!لا تبك يا لوفي

231
00:19:57,480 --> 00:19:58,580
!حسنًا

232
00:20:10,790 --> 00:20:12,670
!انتصرنا

233
00:20:12,670 --> 00:20:14,240
!أجل

234
00:20:14,240 --> 00:20:16,040
!سيلقّنكم هذا درسًا

235
00:20:19,960 --> 00:20:21,420
!هذا جميل

236
00:20:21,420 --> 00:20:23,200
!أجل، عظيم

237
00:20:24,610 --> 00:20:27,340
!هذا مخبؤنا

238
00:20:27,860 --> 00:20:29,510
!إنّهم هناك

239
00:20:30,440 --> 00:20:32,850
!ألم تجداهم بعد؟

240
00:20:32,850 --> 00:20:33,720
!آسف

241
00:20:33,720 --> 00:20:37,800
تحدّثنا إلى النّاس الّذين رأوهم
في غري ترمينال أو الأدغال

242
00:20:37,800 --> 00:20:39,730
!لكنّنا لم نستطع إيجادهم

243
00:20:39,730 --> 00:20:42,270
!مضى أسبوعان

244
00:20:42,270 --> 00:20:46,320
!ربّما التهمهم النّمر الكبير في الأدغال

245
00:20:46,320 --> 00:20:48,070
!يا زعيمة

246
00:20:48,070 --> 00:20:49,190
!و-وجدناهم

247
00:20:49,190 --> 00:20:50,530
!حقًّا؟

248
00:20:50,530 --> 00:20:54,450
!لقد بنوا مخبأً في الشّجرة الضّخمة عميقًا في الأدغال

249
00:20:54,450 --> 00:20:57,160
!يمكننا أخذك إلى هناك

250
00:20:57,160 --> 00:20:58,450
!فهمت

251
00:20:58,450 --> 00:21:00,370
!أنا مسرور من أجلك أيّتها الزّعيمة

252
00:21:00,370 --> 00:21:03,060
!كنت قلقة كثيرًا

253
00:21:03,060 --> 00:21:06,740
تبًّا! أما زالوا أحياء؟

254
00:21:06,740 --> 00:21:09,380
!لا أصدّق كم أولئك الأشقياء عنيدون

255
00:21:10,510 --> 00:21:12,510
مـ-ماذا؟

256
00:21:12,510 --> 00:21:17,470
!لا تقفوا فحسب! اذهبوا وأحضروا شيئًا للعشاء

257
00:21:17,470 --> 00:21:19,180
!حاضر

258
00:21:34,030 --> 00:21:37,780
...إيس... سابو... انتظراني

259
00:21:38,460 --> 00:21:42,520
.يبدون مثل سائر الأطفال عندما ينامون

260
00:21:43,540 --> 00:21:46,380
.لا، لا تصابوا بنزلة برد

261
00:22:34,340 --> 00:22:36,010
!فُعّل فخّ للتّوّ

262
00:22:37,330 --> 00:22:39,060
!أحاول أحدهم التّسلّل بهذه السّرعة؟

263
00:22:40,560 --> 00:22:43,240
.ربّما كان مجرّد خلل

264
00:22:43,240 --> 00:22:47,480
.لنرَ، نصبناها بعجالة لذا قد يحدث ذلك

265
00:22:49,360 --> 00:22:50,690
...إيس

266
00:22:50,690 --> 00:22:52,150
...هذا مؤلم

267
00:22:52,550 --> 00:22:54,160
!سحقًا

268
00:22:54,160 --> 00:22:58,370
!لن أقلق بشأنهم أبدًا ثانيةً

269
00:23:11,450 --> 00:23:16,300
،عندما هوجم الأولاد من قبل دبّ ضخم
.تدخّل عجوز معيّن لإنقاذهم

270
00:23:16,300 --> 00:23:17,950
وقد أخبرهم الرّجل

271
00:23:17,950 --> 00:23:20,640
.أنّه قاتل غولد روجر ذات مرّة

272
00:23:20,640 --> 00:23:23,160
يشعر لوفي بالتّشويق ليسمع قصّة

273
00:23:23,160 --> 00:23:26,270
!عن ملك القراصنة لم يسمعها من قبل

274
00:23:26,270 --> 00:23:27,730
:في الحلقة القادمة من وان بيس

275
00:23:27,730 --> 00:23:30,980
!لوفي يصبح تلميذًا؟"
"!الرّجل الّذي قاتل ضدّ ملك القراصنة

276
00:23:30,980 --> 00:23:33,150
!ملك القراصنة، لن يكون إلاّ أنا

277
00:23:35,990 --> 00:23:41,000
!!نلقاكم في الحلقة القادمة