1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,130 --> 00:03:38,230
،بعد أن فقد أخاه إيس أثناء حرب القمّة ضدّ البحريّة

38
00:03:38,230 --> 00:03:43,610
.وصل لوفي إلى جزيرة النّساء حيث غرق في حزن لا يطاق

39
00:03:44,400 --> 00:03:48,120
...لكن ثمّة قصّة لم تُروَ عن الإخوة

40
00:03:48,900 --> 00:03:54,350
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كصبيّين

41
00:03:55,320 --> 00:04:02,220
تُركَ لوفي مع دادان، لصّة جبل من جبل كولبو
.وقابل صبيّين سابقين لأوانهما يدعيان إيس وسابو

42
00:04:05,530 --> 00:04:10,330
"!ترك عائلة دادان إلى الأبد؟! تمّ بناء مخبأ الأطفال"

43
00:04:15,660 --> 00:04:17,730
كيف حالك يا بوتشي؟

44
00:04:21,440 --> 00:04:25,610
!من حفر حفرة أمام الباب؟

45
00:04:26,060 --> 00:04:29,450
.كان إيس والآخرين، بهدف إمساك الخنازير البرّيّة

46
00:04:29,450 --> 00:04:33,830
!هذا بيتي! لا يمكنهم أن يحفروا حفرةً أينما شاؤوا

47
00:04:34,130 --> 00:04:35,830
!أولئك الأشقياء

48
00:04:36,720 --> 00:04:40,250
!سابو، من منحك الإذن لغزو منطقتنا؟

49
00:04:40,530 --> 00:04:44,030
!منطقتكم؟! أنتم سخيفون حقًّا

50
00:04:44,030 --> 00:04:46,760
!كفّوا عن التّفوّه بالهراء وأروني ما لديكم

51
00:04:47,230 --> 00:04:49,330
!حسنًا، استعدّ

52
00:04:52,040 --> 00:04:53,400
!إيس

53
00:04:54,140 --> 00:04:55,390
!انتبه

54
00:05:00,200 --> 00:05:01,860
!سحقًا

55
00:05:01,860 --> 00:05:03,230
!أيّها الحقير

56
00:05:04,900 --> 00:05:06,710
!صنعتُ تفويجًا

57
00:05:11,160 --> 00:05:13,660
!ها هو ذا رئيس الشّرطة! لنذهب

58
00:05:17,930 --> 00:05:21,050
!لوفي، أسرع! من هنا

59
00:05:24,460 --> 00:05:26,180
!عاد

60
00:05:31,660 --> 00:05:33,630
!لنصطد غزالاً من أجل العشاء

61
00:05:33,630 --> 00:05:37,560
!أجل! أحبّ لحم الغزال! لنذهب للصّيد

62
00:05:37,560 --> 00:05:38,770
!انتظر

63
00:05:39,960 --> 00:05:41,520
!عدنا

64
00:05:41,520 --> 00:05:44,190
!لا تعودوا للبيت أيّها الأشقياء المزعجين

65
00:05:44,460 --> 00:05:46,030
.هذا هو العشاء

66
00:05:46,030 --> 00:05:47,300
.اطبخيه الآن

67
00:05:47,300 --> 00:05:49,860
!إنّه وقت الطّعام

68
00:06:18,580 --> 00:06:20,730
!لا تهدروا الطّعام

69
00:06:23,230 --> 00:06:25,300
!سيأكلني

70
00:06:27,070 --> 00:06:29,410
!لا تخرجوا إلى أن تعدّوا حتّى 10،000

71
00:06:35,630 --> 00:06:38,030
!توقّف

72
00:06:38,400 --> 00:06:40,160
!أيّها النّذل

73
00:06:50,080 --> 00:06:51,180
!صدقًا

74
00:06:51,180 --> 00:06:55,350
لِمَ علينا أن نقوم بأعمال تنظيف
!البيت الشّاقة كلّ ليلة بعد العشاء؟

75
00:06:55,350 --> 00:06:58,030
!سأطردهم بأيّ ثمن

76
00:07:03,010 --> 00:07:05,060
!إنّه نظيف الآن

77
00:07:05,870 --> 00:07:08,080
!لوفي! انتظر أيّها الوغد

78
00:07:11,910 --> 00:07:14,410
...أ-أيّتها الزّعيمة

79
00:07:17,560 --> 00:07:19,120
...يا إلهي

80
00:07:22,830 --> 00:07:25,870
الوقت الوحيد الّذي يمكنني الاستراحة فيه
.هو عندما أدخل إلى الفوتون خاصّتي

81
00:07:30,970 --> 00:07:33,550
!التّدريب الأخير بالنّسبة لليوم

82
00:07:33,550 --> 00:07:34,970
!سأفوز

83
00:07:34,970 --> 00:07:36,180
!لن تتعلّم أبدًا

84
00:07:36,180 --> 00:07:37,350
!ها نحن أولاء

85
00:07:37,350 --> 00:07:38,390
!حسنًا

86
00:07:58,910 --> 00:08:00,320
!أهلاً يا جنّيّة

87
00:08:17,430 --> 00:08:18,390
!سحقًا

88
00:08:18,390 --> 00:08:20,730
لوفي، هل أنت بخير؟

89
00:08:20,730 --> 00:08:22,020
.يا له من طابق سيّئ

90
00:08:22,020 --> 00:08:24,060
!أيها الوغد

91
00:08:24,060 --> 00:08:26,270
!أنتم

92
00:08:28,790 --> 00:08:30,150
هل نذهب للنّوم؟

93
00:08:30,150 --> 00:08:31,150
.أجل

94
00:08:33,110 --> 00:08:35,610
!علينا أن نطرد الأشقياء

95
00:08:35,610 --> 00:08:39,790
!إلّم نفعل شيئًا، سيستولون على عائلة دادان

96
00:08:39,790 --> 00:08:42,870
!قبل كلّ شيء، هذا الأمر يدهور صحّتي

97
00:08:42,870 --> 00:08:44,870
.على رسلك يا زعيمة

98
00:08:44,870 --> 00:08:48,750
!لقد استولوا علينا قبل وقت طويل

99
00:08:48,750 --> 00:08:52,970
!اخرس! فقط لا أستطيع الاعتناء بهم بعد الآن

100
00:08:52,970 --> 00:08:55,010
!أجل، سأطردهم

101
00:08:55,010 --> 00:08:57,970
!انسيا اتّفاقنا مع غارب

102
00:08:57,970 --> 00:08:58,990
!أنت

103
00:08:59,470 --> 00:09:00,900
غارب؟

104
00:09:03,760 --> 00:09:07,810
!أنا آسفة، آسفة! لا أدري ما دفعني لقول ذلك

105
00:09:07,810 --> 00:09:12,730
.المعذرة. سمعت أنّ لوفي هنا

106
00:09:18,320 --> 00:09:19,360
!ماكينو

107
00:09:19,360 --> 00:09:20,870
!لوفي

108
00:09:21,510 --> 00:09:23,140
!تبدو بصّحة جيّدة

109
00:09:23,140 --> 00:09:26,370
.مضت ستّة أشهر، لذا أتينا إلى هنا لنرى كيف حالك

110
00:09:26,370 --> 00:09:27,960
!مرحبًا أيّها المحافظ

111
00:09:27,960 --> 00:09:30,210
.لا تخبر غارب-سان

112
00:09:30,210 --> 00:09:33,510
...إذًا أنت تعيش مع اللّصوص حقًّا

113
00:09:33,510 --> 00:09:35,260
هل لديك مشكلة؟

114
00:09:35,260 --> 00:09:39,090
،أجل، ولصّة كبيرة! أنت لصّة
!لذا لا تتصرّفي معي بهذا الأسلوب

115
00:09:39,090 --> 00:09:42,430
!ماذا؟! النّاس من قرية فوشا مزعجون جميعًا؟

116
00:09:42,970 --> 00:09:44,600
!لديّ بعض الهدايا لك

117
00:09:44,920 --> 00:09:48,850
أفترض أنّ غارب-سان ما كان
...ليفكّر بشأن هذه الأشياء

118
00:09:48,850 --> 00:09:51,400
!ها هي ذي! ملابس جديدة

119
00:09:51,400 --> 00:09:53,610
!عظيم

120
00:09:53,610 --> 00:09:55,030
.مسرورة لأنّها أعجبتك

121
00:09:55,610 --> 00:09:59,780
.سأضبط الطّول، لذا... أحتاجكما أيضًا

122
00:09:59,780 --> 00:10:00,700
اتّفقنا؟

123
00:10:02,240 --> 00:10:03,740
!أنت

124
00:10:03,740 --> 00:10:05,200
.أنت أيضًا

125
00:10:09,840 --> 00:10:12,420
سمعت أنّ إيس-كن مشاغب

126
00:10:12,420 --> 00:10:14,630
.لكنّك تبدو كولد مطيع

127
00:10:14,630 --> 00:10:16,800
...لـ-لا، لستُ كذلك

128
00:10:18,130 --> 00:10:19,280
!إنّه خجول جدًّا

129
00:10:19,280 --> 00:10:20,720
!إنّك تحمرّ خجلاً يا إيس

130
00:10:21,140 --> 00:10:22,060
!أنتما

131
00:10:22,060 --> 00:10:24,150
!مهلاً، لا يجب أن تتحرّك

132
00:10:24,150 --> 00:10:25,310
.سأنال منكما لاحقًا

133
00:10:32,520 --> 00:10:34,320
!آمل أن يعجبكم

134
00:10:38,200 --> 00:10:39,680
!لذيذ

135
00:10:43,030 --> 00:10:47,040
.يجب أن تكون الوجبات لذيذة في السّفينة

136
00:10:47,040 --> 00:10:50,620
!سأضمّ أفضل طبّاخ أوّلاً عندما أذهب للبحر

137
00:10:50,620 --> 00:10:54,530
.سأصبح قرصانًا قبلك لذا لا تنس ذلك

138
00:10:54,530 --> 00:10:57,670
!هذا ليس عدلاً! سأصبح قرصانًا أوّلاً

139
00:11:04,010 --> 00:11:06,720
!أما زلتما تتفوّهان بهراء كهذا؟

140
00:11:08,400 --> 00:11:12,440
!ألا تفهمان أنّ عليكما أن تصيرا جنديّي بحريّة؟

141
00:11:15,480 --> 00:11:16,220
!دادان

142
00:11:16,230 --> 00:11:18,150
...حاضرة يا غارب-سان

143
00:11:19,110 --> 00:11:20,780
لِمَ ضربتني أيضًا؟

144
00:11:20,780 --> 00:11:23,910
!إنّك لا تربّين الأشقياء جيّدًا

145
00:11:23,910 --> 00:11:28,040
إنّه غارب؟ إنّه جدّ إيس ولوفي؟

146
00:11:28,040 --> 00:11:31,750
أيّها التّافه، ذكرت أنّك ستذهب
...إلى البحر أيضًا

147
00:11:31,750 --> 00:11:34,210
!ليس "تافه" بل سابو

148
00:11:34,210 --> 00:11:39,630
!لقد تبادلنا كأس ساكي وتعاهدنا أن نصبح قراصنة

149
00:11:39,630 --> 00:11:41,090
...إنّه ثرثار

150
00:11:41,090 --> 00:11:47,810
هذا يعني أنّ هنالك ثلاثة حمقى
!يريدون منّي أن أوكّلهم بتمرين حقيقيّ

151
00:11:51,140 --> 00:11:52,270
!لا يمكنكم أن تهربوا

152
00:11:53,310 --> 00:11:55,240
...يا إلهي

153
00:11:57,110 --> 00:12:01,150
.لا بدّ أنّك سعيد يا لوفي
.لديك أخوين كبيرين الآن

154
00:12:03,030 --> 00:12:04,660
!انتظروا

155
00:12:04,660 --> 00:12:05,780
!خذ هذه

156
00:12:05,780 --> 00:12:07,120
!الصّدر

157
00:12:07,120 --> 00:12:08,990
!خذ، خذ، خذ

158
00:12:08,990 --> 00:12:11,370
!هذا العجوز كوحش

159
00:12:17,500 --> 00:12:21,920
!هذا يكفي لليوم! سأتعامل معكم بقسوة أكثر غدًا

160
00:12:21,920 --> 00:12:23,300
!لا يمكنكم أن تموتوا بعد

161
00:12:37,320 --> 00:12:40,530
.إلّم نفعل شيئًا، سيقتلنا العجوز غدًا

162
00:12:40,530 --> 00:12:42,560
،حتّى إن نجونا

163
00:12:42,560 --> 00:12:45,700
!سيواصل فعل ذلك حتّى نتخلّى عن حلمنا

164
00:12:45,700 --> 00:12:47,570
!لا أريد أن أموت

165
00:12:47,570 --> 00:12:49,330
.لدينا خيار واحد فقط

166
00:12:49,330 --> 00:12:52,700
!آن الأوان لكي نحسم أمرنا يا أخواي

167
00:13:17,310 --> 00:13:19,520
ماذا نفعل بشأن هذا؟

168
00:13:20,610 --> 00:13:22,440
.يا لهم من متحذلقين

169
00:13:22,440 --> 00:13:27,950
كيف لك ألاّ تهتمّ؟! إنّهم شائنو
!السّمعة حتّى في وسط المدينة

170
00:13:27,950 --> 00:13:33,500
سيحاول أيّ أحد أن يقتلهم فور أن
!يراهم لو لم يكونوا تحت حمايتنا

171
00:13:33,500 --> 00:13:35,320
!انتهت عطلتي

172
00:13:35,320 --> 00:13:39,580
عليك أن تجعلي منهم رجال بحريّة
!مؤهّلين عندما أعود في المرّة القادمة

173
00:13:39,580 --> 00:13:41,590
!هل ستترك كلّ شيء لي ثانيةً؟

174
00:13:41,590 --> 00:13:42,190
ماذا؟

175
00:13:42,190 --> 00:13:44,010
!الوداع

176
00:13:47,260 --> 00:13:49,260
!الوداع

177
00:13:52,100 --> 00:13:55,430
!كيف للصّة أن تربّي جنديّ بحريّة؟

178
00:13:55,430 --> 00:13:57,310
!ذلك العجوز الخرف لا يدري ما يقول

179
00:13:57,310 --> 00:13:59,150
.هوّني عليك أيّتها الزّعيمة

180
00:13:59,150 --> 00:14:03,530
.إذًا أنت قلقة بشأن أولئك الأطفال في النّهاية

181
00:14:04,610 --> 00:14:09,410
.من يهتمّ؟! بالتّفكير في الأمر، هذا يفيدنا

182
00:14:09,410 --> 00:14:13,620
!لقد غادروا طواعية! أنا مسرورة

183
00:14:15,250 --> 00:14:16,930
!هربنا بنجاح

184
00:14:17,590 --> 00:14:19,420
.دادان والبقيّة لا يلاحقوننا

185
00:14:23,400 --> 00:14:27,680
!"صحيح أنّ "أطفال الشّيطان يملكون حظّ الشّيطان

186
00:14:27,680 --> 00:14:30,390
!إنّه طفل الشّيطان

187
00:14:30,760 --> 00:14:35,510
يمكنني أن أرى أنّها تشعر بالسّعادة
!الآن لأنّ متاعبها ذهبت

188
00:14:39,190 --> 00:14:42,610
!لا! إنّها تمطر

189
00:14:54,240 --> 00:14:56,450
.لنبق هنا ونختبئ من المطر

190
00:14:58,080 --> 00:15:00,210
!هذا شيّق

191
00:15:04,380 --> 00:15:08,440
!غيّرت رأيي. لا أريد أن أتعرّض لضرب مبرح من غارب

192
00:15:08,440 --> 00:15:11,180
!اذهبا وابحثا عن الأشقياء الأغبياء

193
00:15:11,180 --> 00:15:12,590
!حاضر

194
00:16:06,730 --> 00:16:09,000
!رفاق

195
00:16:09,000 --> 00:16:11,400
!إيس! سابو

196
00:16:11,400 --> 00:16:12,700
!لوفي

197
00:16:12,700 --> 00:16:14,160
!انظرا لهذا

198
00:16:14,160 --> 00:16:15,470
ما هو؟

199
00:16:15,470 --> 00:16:20,410
.قمتُ بتصميم مخبئنا
لا يمكننا أن ننام في الخارج دائمًا، صحيح؟

200
00:16:20,410 --> 00:16:24,330
!لذا علينا أن نبني مخبأنا ها هنا

201
00:16:24,330 --> 00:16:27,960
!مخبأ... كم هذا رائع

202
00:16:27,960 --> 00:16:29,590
ماذا عن الموادّ؟

203
00:16:29,590 --> 00:16:33,800
.ثمّة الكثير من تلك الأشياء

204
00:18:22,200 --> 00:18:25,450
!مذهل! يبدو كما التّصميم تمامًا

205
00:18:25,450 --> 00:18:28,210
!إنّه عمل عظيم برأيي

206
00:18:28,210 --> 00:18:30,050
ما الخطب يا إيس؟

207
00:18:30,050 --> 00:18:33,880
!هذا مخبأ، لذا علينا أن ننصب بعض الفخاخ

208
00:18:33,880 --> 00:18:35,710
!حسنًا، سأفكّر في الأمر

209
00:18:39,800 --> 00:18:40,980
!أجل

210
00:18:40,980 --> 00:18:42,880
،لدينا إطلالة على غري ترمينال

211
00:18:42,880 --> 00:18:45,390
!وكذلك قرية فوشا ومياه الأزرق الشّرقيّ

212
00:18:45,390 --> 00:18:48,390
ليس غير مألوف، أليس كذلك؟

213
00:18:48,390 --> 00:18:50,440
!من الجميل رؤيتهم من هنا

214
00:19:04,160 --> 00:19:07,110
!معك حقّ! هذا مختلف

215
00:19:18,840 --> 00:19:20,880
!لوفي، ثمّة ريح خلفيّة! افرد الأشرعة

216
00:19:20,880 --> 00:19:21,890
!حسنًا

217
00:19:26,890 --> 00:19:28,930
!هيّا نتقدّم إلى الكنز

218
00:19:29,600 --> 00:19:31,810
!عدوّ في مقدّمة السّفينة والميمنة

219
00:19:31,810 --> 00:19:35,360
!إنّها سفينة بلوجام! تجهّزا للقتال

220
00:19:36,190 --> 00:19:40,280
!بدؤوا يطلقون! راوغا

221
00:19:40,280 --> 00:19:43,390
!لوفي، إلى أقصى الميسرة

222
00:19:43,390 --> 00:19:45,410
!أجل، مفهوم

223
00:19:45,410 --> 00:19:49,500
!لا! عليك أن تقول "عُلم وسيُنفّذ" في ظرف كهذا

224
00:19:49,500 --> 00:19:50,880
.صحيح

225
00:19:51,370 --> 00:19:54,130
!لوفي، إلى أقصى الميسرة

226
00:19:54,130 --> 00:19:57,340
!أقصى الميسرة! عُلم ويُنفّذ

227
00:20:01,380 --> 00:20:03,430
!لنقاتل مباشرةً! إلى سطح السّفينة

228
00:20:05,850 --> 00:20:08,220
!انتظراهم ليأتوا إلى سطح السّفينة

229
00:20:08,220 --> 00:20:09,550
!مفهوم

230
00:20:09,550 --> 00:20:11,480
!لا تبك يا لوفي

231
00:20:11,480 --> 00:20:12,580
!حسنًا

232
00:20:24,790 --> 00:20:26,670
!انتصرنا

233
00:20:26,670 --> 00:20:28,240
!أجل

234
00:20:28,240 --> 00:20:30,040
!سيلقّنكم هذا درسًا

235
00:20:33,960 --> 00:20:35,420
!هذا جميل

236
00:20:35,420 --> 00:20:37,200
!أجل، عظيم

237
00:20:38,610 --> 00:20:41,340
!هذا مخبؤنا

238
00:20:41,860 --> 00:20:43,510
!إنّهم هناك

239
00:20:44,440 --> 00:20:46,850
!ألم تجداهم بعد؟

240
00:20:46,850 --> 00:20:47,720
!آسف

241
00:20:47,720 --> 00:20:51,800
تحدّثنا إلى النّاس الّذين رأوهم
في غري ترمينال أو الأدغال

242
00:20:51,800 --> 00:20:53,730
!لكنّنا لم نستطع إيجادهم

243
00:20:53,730 --> 00:20:56,270
!مضى أسبوعان

244
00:20:56,270 --> 00:21:00,320
!ربّما التهمهم النّمر الكبير في الأدغال

245
00:21:00,320 --> 00:21:02,070
!يا زعيمة

246
00:21:02,070 --> 00:21:03,190
!و-وجدناهم

247
00:21:03,190 --> 00:21:04,530
!حقًّا؟

248
00:21:04,530 --> 00:21:08,450
!لقد بنوا مخبأً في الشّجرة الضّخمة عميقًا في الأدغال

249
00:21:08,450 --> 00:21:11,160
!يمكننا أخذك إلى هناك

250
00:21:11,160 --> 00:21:12,450
!فهمت

251
00:21:12,450 --> 00:21:14,370
!أنا مسرور من أجلك أيّتها الزّعيمة

252
00:21:14,370 --> 00:21:17,060
!كنت قلقة كثيرًا

253
00:21:17,060 --> 00:21:20,740
تبًّا! أما زالوا أحياء؟

254
00:21:20,740 --> 00:21:23,380
!لا أصدّق كم أولئك الأشقياء عنيدون

255
00:21:24,510 --> 00:21:26,510
مـ-ماذا؟

256
00:21:26,510 --> 00:21:31,470
!لا تقفوا فحسب! اذهبوا وأحضروا شيئًا للعشاء

257
00:21:31,470 --> 00:21:33,180
!حاضر

258
00:21:48,030 --> 00:21:51,780
...إيس... سابو... انتظراني

259
00:21:52,460 --> 00:21:56,520
.يبدون مثل سائر الأطفال عندما ينامون

260
00:21:57,540 --> 00:22:00,380
.لا، لا تصابوا بنزلة برد

261
00:22:48,340 --> 00:22:50,010
!فُعّل فخّ للتّوّ

262
00:22:51,330 --> 00:22:53,060
!أحاول أحدهم التّسلّل بهذه السّرعة؟

263
00:22:54,560 --> 00:22:57,240
.ربّما كان مجرّد خلل

264
00:22:57,240 --> 00:23:01,480
.لنرَ، نصبناها بعجالة لذا قد يحدث ذلك

265
00:23:03,360 --> 00:23:04,690
...إيس

266
00:23:04,690 --> 00:23:06,150
...هذا مؤلم

267
00:23:06,550 --> 00:23:08,160
!سحقًا

268
00:23:08,160 --> 00:23:12,370
!لن أقلق بشأنهم أبدًا ثانيةً

269
00:23:25,450 --> 00:23:30,300
،عندما هوجم الأولاد من قبل دبّ ضخم
.تدخّل عجوز معيّن لإنقاذهم

270
00:23:30,300 --> 00:23:31,950
وقد أخبرهم الرّجل

271
00:23:31,950 --> 00:23:34,640
.أنّه قاتل غولد روجر ذات مرّة

272
00:23:34,640 --> 00:23:37,160
يشعر لوفي بالتّشويق ليسمع قصّة

273
00:23:37,160 --> 00:23:40,270
!عن ملك القراصنة لم يسمعها من قبل

274
00:23:40,270 --> 00:23:41,730
:في الحلقة القادمة من وان بيس

275
00:23:41,730 --> 00:23:44,980
!لوفي يصبح تلميذًا؟"
"!الرّجل الّذي قاتل ضدّ ملك القراصنة

276
00:23:44,980 --> 00:23:47,150
!ملك القراصنة، لن يكون إلاّ أنا

277
00:23:49,990 --> 00:23:55,000
!!نلقاكم في الحلقة القادمة