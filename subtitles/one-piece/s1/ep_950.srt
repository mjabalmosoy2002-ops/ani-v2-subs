1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,310 --> 00:02:02,490
!ألا يُسمح لغريب بإنقاذ هذه البلاد؟

29
00:02:11,700 --> 00:02:14,870
...قبل ثمانية أيّام من المعركة العظيمة

30
00:02:14,870 --> 00:02:20,840
أخضع لوفي والبقيّة أودون بينما يجهل
.جيش العدوّ الرّئيسيّ الأمر

31
00:02:24,090 --> 00:02:28,600
"!حلم المحاربين! إخضاع لوفي لأودون"

32
00:02:29,710 --> 00:02:31,870
!نحن أحرار

33
00:02:31,870 --> 00:02:33,730
!أجل

34
00:02:33,730 --> 00:02:35,450
!لنهزم كايدو

35
00:02:35,450 --> 00:02:42,290
!واحد، اثنان، مرحى

36
00:02:42,290 --> 00:02:45,570
.ما عاد بإمكانكم التّراجع الآن

37
00:02:53,080 --> 00:02:56,250
!لوفي... أين ذهب؟

38
00:03:00,790 --> 00:03:01,840
!لوفي

39
00:03:25,740 --> 00:03:27,150
...كيلر

40
00:03:35,700 --> 00:03:37,220
!يا لتهوّرك

41
00:03:37,220 --> 00:03:38,460
!اسمع

42
00:03:40,210 --> 00:03:43,210
هل ستقاتل كايدو ثانية؟

43
00:03:44,920 --> 00:03:46,670
أتريد الانضمام لنا؟

44
00:03:56,470 --> 00:03:57,780
!مستحيل

45
00:03:57,780 --> 00:04:02,190
...انظر ما فعل بصاحبي

46
00:04:02,650 --> 00:04:06,900
!اشكرني لأنّني لم أقتلك هنا والآن

47
00:04:08,440 --> 00:04:10,530
.سئمت من تشكيل التّحالفات

48
00:04:11,070 --> 00:04:14,200
.لن أضع ثقتي بأيّ أحد

49
00:05:37,030 --> 00:05:39,080
.لنذهب يا كيلر

50
00:05:40,790 --> 00:05:43,080
.لنذهب لاستعادة رفاق طاقمنا

51
00:05:45,170 --> 00:05:49,090
!سنشقّ طريقنا الخاصّ

52
00:05:52,010 --> 00:05:53,970
.انظر لما تستطيع عشرون سنة فعله

53
00:05:54,550 --> 00:06:00,640
.من الصّعب جدًّا مواصلة التّصديق في حلم متفائل

54
00:06:01,770 --> 00:06:04,360
...لم يستطيعوا الانتظار أكثر من عشر سنين

55
00:06:04,360 --> 00:06:07,560
...أمسوا عجولين وقصدوا أونيغاشيما

56
00:06:08,190 --> 00:06:09,770
!وماتوا جميعًا

57
00:06:18,280 --> 00:06:19,870
!ماذا حدث؟

58
00:06:23,660 --> 00:06:25,830
!مرّت عشر سنين

59
00:06:27,130 --> 00:06:29,260
.أمسينا شيوخًا

60
00:06:29,260 --> 00:06:33,090
!وسنُمسي أضعف إن انتظرنا عشرين سنة

61
00:06:33,090 --> 00:06:36,880
أتطلب منّا انتظار أولئك الأشخاص
!الّتي عودتهم مظنون بها؟

62
00:06:37,260 --> 00:06:41,390
!ضعوا ثقتكم في كلمات توكي-ساما... ثقوا بهم

63
00:06:41,390 --> 00:06:43,390
!سيعود كينييمون

64
00:06:43,810 --> 00:06:46,190
!برفقة مومونوسكي-ساما

65
00:06:47,150 --> 00:06:50,770
ما عدنا نملك ما نسكت به جوعنا
.بما أنّنا لم نخضع لأوروتشي

66
00:06:52,190 --> 00:06:54,400
!وسيكون موتنا بسبب المرض لا بالقتال

67
00:07:00,280 --> 00:07:02,450
!إنّه جيش كايدو

68
00:07:12,340 --> 00:07:14,230
!لماذا دمّرت البئر؟

69
00:07:14,230 --> 00:07:16,010
!اخرس

70
00:07:39,200 --> 00:07:41,840
!ما عدنا نتحمّل أكثر يا شوتنمارو

71
00:07:41,840 --> 00:07:45,830
!فلنذهب للإطاحة بكايدو... وأوروتشي

72
00:07:45,830 --> 00:07:50,140
!لا أريد أن أشيخ وأموت دون فعل أيّ شيء

73
00:07:50,140 --> 00:07:53,140
!كلاّ! لن يكون لموتكم أيّ مغزى

74
00:07:53,140 --> 00:07:56,550
لا فرص لديكم ما لم تشكّلوا
!جيشًا كبيرًا تحت راية كوزكي

75
00:08:01,390 --> 00:08:03,810
!ضقنا بهذا الحال ذرعًا

76
00:08:06,770 --> 00:08:10,150
!دعنا نموت حاملين لسيوفنا على الأقلّ

77
00:08:10,150 --> 00:08:13,750
!إن كنّا سنموت، نريد الموت كساموراي

78
00:08:13,750 --> 00:08:15,070
!لا توقفنا

79
00:08:15,070 --> 00:08:18,150
!دعنا نذهب

80
00:08:15,070 --> 00:08:18,150
!أرجوك

81
00:08:18,490 --> 00:08:23,280
اهدؤوا يا رجال! لن تغيّر المخاطرة
!بحياتكم الآن من شيء

82
00:08:23,280 --> 00:08:24,300
!لِمَ؟

83
00:08:24,300 --> 00:08:27,470
!لسنا جبناء مثلك

84
00:08:27,470 --> 00:08:28,810
!هذا صحيح

85
00:08:28,810 --> 00:08:32,020
!سنختار طريقة مماتنا بأنفسنا

86
00:08:32,020 --> 00:08:33,600
!دعنا نذهب

87
00:08:32,020 --> 00:08:33,600
!أرجوك

88
00:08:33,600 --> 00:08:36,150
!دعنا نحظى بثأرنا

89
00:08:36,150 --> 00:08:39,550
!سيذهب كلّ ما تحمّلتموه مهبّ الرّيح

90
00:08:39,880 --> 00:08:44,390
!إن ذهبتم الآن، فلن تتمكّنوا من الثأر لأودن-ساما

91
00:08:44,390 --> 00:08:48,020
!تدركون ذلك جميعًا

92
00:08:54,980 --> 00:08:57,730
...أتذكرون؟ عندما كنّا صبية

93
00:08:59,150 --> 00:09:02,990
اعتدنا على الصّراخ بتلك الكلمة
.واختبار شجاعتنا

94
00:09:02,990 --> 00:09:07,830
في النّهاية، تقدير قيمة النّفس
!أكثر من اللاّزم، يجعل المرء جبانًا

95
00:09:15,750 --> 00:09:17,670
!سوناتشي

96
00:09:28,720 --> 00:09:32,140
.تخلّوا عن أسمائكم، تخلّوا عن أذهانكم

97
00:09:32,480 --> 00:09:35,320
!اقفزوا دونما أيّ تفكير معمّق

98
00:09:35,320 --> 00:09:38,070
!هذا ما تعنيه تلك الكلمة

99
00:09:39,980 --> 00:09:43,380
!فليصدح صراخكم! سوناتشي

100
00:09:43,380 --> 00:09:48,830
!سوناتشي

101
00:09:48,830 --> 00:09:50,080
!توقّفوا

102
00:10:14,560 --> 00:10:25,410
!سوناتشي

103
00:10:26,360 --> 00:10:29,660
!إن كنّا سنموت، نريد الموت كساموراي

104
00:10:52,100 --> 00:11:19,960
!سوناتشي

105
00:11:46,740 --> 00:11:50,620
لماذا استغرق الأمر عشرين سنة؟

106
00:11:51,240 --> 00:11:53,240
!سنعرف ذلك بمجرّد انتهائه

107
00:11:53,580 --> 00:11:55,370
!لا بدّ من مغزى لكلّ هذا

108
00:12:36,450 --> 00:12:40,210
.لا سبب يدفعني لأشكّك بأودن-ساما

109
00:12:41,000 --> 00:12:43,840
!يا رجال

110
00:12:46,090 --> 00:12:48,210
...بعد ثمانية أيّام

111
00:12:48,210 --> 00:12:50,770
،في ليلة مهرجان النّار

112
00:12:50,770 --> 00:12:54,640
...سنغير على أونيغاشيما باسم كوزكي

113
00:12:55,140 --> 00:13:01,480
لندقّ عنقيْ القرصان كايدو
!والشّوغن أوروتشي

114
00:13:03,480 --> 00:13:06,200
،من ما زال منكم عازمًا

115
00:13:06,200 --> 00:13:08,940
!فليتبعني

116
00:13:14,530 --> 00:13:17,490
!أجل

117
00:13:19,080 --> 00:13:23,210
!بالطّبع سنتبعك يا زعيم
!انتظرنا هذا اليوم بفارغ الصّبر

118
00:13:29,510 --> 00:13:30,510
!أشورا

119
00:13:31,550 --> 00:13:34,140
لم تتغيّروا قطّ مذّاك اليوم، صحيح؟

120
00:13:34,140 --> 00:13:40,680
كنّا في نفس العمر حينها، لكن بعد أن عشنا
!عشرين سنة أطول منكم، صرنا أقوى منكم

121
00:13:42,350 --> 00:13:43,710
!أليس كذلك يا إينو؟

122
00:13:43,710 --> 00:13:45,810
!نعم، معك حقّ

123
00:13:48,650 --> 00:13:51,900
!اخرسا أيّها العجوزان! لا تعترضا طريقنا

124
00:13:53,150 --> 00:13:54,410
!أيّها الشّقيّ الغرّ

125
00:13:58,410 --> 00:14:04,080
!مهلاً، مهلاً، توقّفوا
!لا أحد يقوى على إيقاف قتال بين الأكازايا

126
00:14:13,420 --> 00:14:14,810
!قرصان؟

127
00:14:14,810 --> 00:14:18,140
!ذو قبّعة القشّ قرصان مثل كايدو؟

128
00:14:18,430 --> 00:14:20,030
!نعم، لكنّه مختلف

129
00:14:20,030 --> 00:14:23,230
!لا يمكننا أن نثق به! واثقون أنّه سيخوننا

130
00:14:23,230 --> 00:14:26,620
!لماذا أحضرتم قرصانًا من بين الجميع؟

131
00:14:26,620 --> 00:14:29,920
حسنًا، العالم واسع وثمّة أنواع
...مختلفة من القراصنة

132
00:14:29,920 --> 00:14:34,170
!ذلك الرّجل ضروريّ للإطاحة بكايدو

133
00:14:34,320 --> 00:14:35,860
!أنّى لنا أن نثق به؟

134
00:14:35,860 --> 00:14:38,450
!نحتاج تفسيرًا مقنعًا

135
00:14:38,950 --> 00:14:44,160
.هذا سيّئ. نفتقر لشيء ما
...لقد عادوا لرشدهم، ولكن

136
00:14:44,660 --> 00:14:48,640
أوّلاً، هل صحيح أنّكم أتيتم
من الماضي قبل عشرين سنة؟

137
00:14:48,640 --> 00:14:52,100
.رايزو-سان، لطالما بدوت أكبر من عمرك

138
00:14:52,100 --> 00:14:55,760
لذلك لا يمكننا معرفة إن كبرت
!عشرين سنة أم لا

139
00:14:56,050 --> 00:14:58,780
،ربّما لم يكن هذا مقصدكم
!لكنّكم تجرحون مشاعري

140
00:14:58,780 --> 00:15:01,220
أين ذهب فتى قبّعة القشّ؟

141
00:15:04,100 --> 00:15:08,520
.تاما، ما كان عليك المجيء
.المكان خطير هنا

142
00:15:08,520 --> 00:15:11,080
.أنا آسفة يا أخي الكبير

143
00:15:11,080 --> 00:15:13,530
!لكنّني مسرورة لأنّك بخير

144
00:15:13,530 --> 00:15:14,990
...نعم

145
00:15:15,780 --> 00:15:17,770
.يبدو لي على شفير الموت

146
00:15:19,070 --> 00:15:21,010
!يا أخي الكبير، تشجّع

147
00:15:21,010 --> 00:15:22,410
!لا تلمسيه

148
00:15:23,910 --> 00:15:26,210
!سأعثر على التّرياق قريبًا

149
00:15:26,210 --> 00:15:29,290
!ما كان عليك أن تتظاهر أنّه لا يؤثّر فيك

150
00:15:29,670 --> 00:15:33,640
!لا بدّ أنّك تتألّم
!لماذا لا تفكّر قبل أن تتصرّف؟

151
00:15:33,640 --> 00:15:34,840
!عليك أن تعتذر لي

152
00:15:37,630 --> 00:15:38,850
.أنا آسف

153
00:15:38,850 --> 00:15:40,340
.أنا أتألّم

154
00:15:40,340 --> 00:15:41,390
!ساعدني

155
00:15:41,390 --> 00:15:42,850
!انتظر فحسب

156
00:15:44,180 --> 00:15:49,100
نحن ممتنّون! لكن بما أنّنا بتنا نعلم
!أنّهم قراصنة، فلن ننضمّ لهم

157
00:15:49,100 --> 00:15:52,940
!مهلاً! لن نستطيع الإطاحة بكايدو حينها

158
00:15:52,940 --> 00:15:56,150
!فتى قبّعة القشّ أهل للثّقة

159
00:15:56,150 --> 00:15:59,160
!لا فرق بين القراصنة في نظرنا

160
00:16:02,030 --> 00:16:04,240
!لا حاجة لنا بالقراصنة

161
00:16:04,240 --> 00:16:05,950
!اطردوهم

162
00:16:07,040 --> 00:16:11,010
.قد يكون لوفي غبيًّا، لكنّه مميّز

163
00:16:11,010 --> 00:16:14,300
.ما كنت لأفعل شيئًا كالّذي فعله

164
00:16:14,840 --> 00:16:17,550
...مومو، إنّك

165
00:16:17,880 --> 00:16:20,300
...غبيّ حقيقيّ

166
00:16:21,050 --> 00:16:22,470
...وجبان

167
00:16:22,470 --> 00:16:24,350
...وضعيف

168
00:16:24,350 --> 00:16:25,970
...وواهن

169
00:16:25,970 --> 00:16:29,310
.لا أمل يُرجى منك

170
00:16:30,810 --> 00:16:32,610
!اخرس! أنت فظّ جدًّا

171
00:16:33,020 --> 00:16:35,980
!لا يحقّ لك بتاتًا التّحدّث معي هكذا

172
00:16:37,780 --> 00:16:39,780
!مومو-كُن، لا تلمسه

173
00:16:44,660 --> 00:16:48,410
ماذا تكون؟ جبان؟

174
00:16:48,410 --> 00:16:52,080
...أنا كوزكي مومونوسكي

175
00:16:52,460 --> 00:16:55,290
!ابن كوزكي أودن

176
00:16:55,290 --> 00:16:57,960
!اذهب إذًا يا مومو

177
00:17:00,380 --> 00:17:03,010
!اطردوهم

178
00:17:03,010 --> 00:17:05,220
!لن نثق بالقراصنة

179
00:17:05,220 --> 00:17:06,220
!اطردوهم

180
00:17:23,990 --> 00:17:25,890
!اذهب بسرعة

181
00:17:25,890 --> 00:17:29,060
!تـ-توقّف أيّها الأبله! هل ستقتلني؟

182
00:17:29,060 --> 00:17:31,880
من ينتظرون في رأيك؟

183
00:17:31,880 --> 00:17:35,340
!إنّهم في انتظارك أنت

184
00:18:15,250 --> 00:18:17,590
...أيعقل... أنّه

185
00:18:42,030 --> 00:18:43,780
!مومونوسكي-ساما

186
00:18:44,490 --> 00:18:46,570
!كم أنا شاكر لأنّك حيّ

187
00:18:55,500 --> 00:18:56,580
...صحيح

188
00:18:58,040 --> 00:19:00,290
...ما كنّا نفتقر له

189
00:19:01,210 --> 00:19:03,010
.هو حلم

190
00:19:03,880 --> 00:19:07,800
!ما ينتظرنا بعد هذه المعركة

191
00:19:08,340 --> 00:19:10,350
...ليس أنا

192
00:19:10,350 --> 00:19:15,040
...أظنّ أنّ ما يراه الجميع هو والدي

193
00:19:15,040 --> 00:19:19,150
!ظلّ كوزكي العظيم الّذي حمى بلاد وانو

194
00:19:33,540 --> 00:19:35,910
...لا-لا أستطيع

195
00:19:37,420 --> 00:19:38,920
!لا أستطيع

196
00:19:54,180 --> 00:19:58,440
!أريد الإطاحة بكايدو

197
00:20:08,860 --> 00:20:10,570
!مومونوسكي

198
00:20:10,990 --> 00:20:13,580
...لا تخف يا مومونوسكي

199
00:20:16,410 --> 00:20:19,580
!لا تخف يا مومونوسكي

200
00:20:24,840 --> 00:20:28,680
...ا-اسمعوا جميعًا

201
00:20:29,680 --> 00:20:30,680
!أيّها النّاس

202
00:20:31,010 --> 00:20:32,550
!استمعوا لي

203
00:20:38,350 --> 00:20:42,190
...ما حدث في قلعة أدون يومها

204
00:20:42,190 --> 00:20:47,190
ذهبت في رحلة للبحث عن حلفاء
.رفقة كينييمون والبقيّة

205
00:20:47,690 --> 00:20:54,080
.لكنّني انفصلت عنهم وتعثّرت عاجزًا في مكان خطير

206
00:20:54,490 --> 00:21:01,210
عجزت عن العودة بدون مساعدة لوفي
...والآخرين الّذين قابلتهم في الطّريق

207
00:21:01,620 --> 00:21:05,420
.لستُ قويًّا كفايةً بعد

208
00:21:06,630 --> 00:21:12,140
!لكنّني سأثأر للجميع بأيّ ثمن

209
00:21:12,140 --> 00:21:17,140
،حتّى في الأوقات العصيبة
...أستطيع المواصلة دونما استسلام

210
00:21:17,140 --> 00:21:20,060
.بسبب أمنية واحدة

211
00:21:20,060 --> 00:21:25,620
...ولتحقيقها، أحتاج حلفاء من نفس الطّينة

212
00:21:25,620 --> 00:21:30,950
أحتاج مساعدتكم جميعًا
!يا من تعيشون في بلاد وانو

213
00:21:31,280 --> 00:21:34,530
!نتشارك جميعنا أمنية واحدة

214
00:21:36,330 --> 00:21:40,040
!ألا وهي استعادة بلاد وانو

215
00:21:40,370 --> 00:21:43,830
،أيّها النّاس... طوال السّنوات العشرين الماضية

216
00:21:43,830 --> 00:21:48,380
!انتظرتمونا وأنا أشكركم على ذلك

217
00:21:55,140 --> 00:21:58,850
...أنا وريث لقب دايميو بلاد وانو

218
00:22:00,140 --> 00:22:02,650
!كوزكي مومونوسكي

219
00:22:02,650 --> 00:22:05,400
!آن الأوان لننهض

220
00:22:09,360 --> 00:22:12,150
!أجل

221
00:22:16,870 --> 00:22:20,700
.أراحتني معرفة أنّ مومونوسكي-ساما قد صار أقوى

222
00:22:20,700 --> 00:22:26,560
.ثمّة مكان عليّ أن أقصده بشكل طارئ
!أعد أن أنضمّ لكم قبل المعركة

223
00:22:26,560 --> 00:22:29,170
!حسنًا. مفهوم

224
00:23:04,210 --> 00:23:06,300
!لدى أوروتشي خطّة

225
00:23:06,300 --> 00:23:09,880
تحاصر مكيدة الشّوغن قراصنة قبّعة القشّ

226
00:23:09,880 --> 00:23:13,710
!وتدمّر خطّة استعادة بلاد وانو

227
00:23:14,090 --> 00:23:17,680
!لكن في مواجهة ذلك، ينهض السّيّاف زوروجورو

228
00:23:17,680 --> 00:23:21,560
!سيعاقب عالم الرّذيلة هذا

229
00:23:22,390 --> 00:23:23,810
:في الحلقة القادمة من وان بيس

230
00:23:23,810 --> 00:23:27,060
!فرقة أوروتشي للمطاردة"
"!مجموعة النّينجا ضدّ زورو

231
00:23:27,060 --> 00:23:30,360
!ملك القراصنة، لن يكون إلاّ أنا