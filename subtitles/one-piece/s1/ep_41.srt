1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:02:37,990 --> 00:02:39,460
!مطرقة أوسوبّ

26
00:02:40,420 --> 00:02:42,560
!رباط أوسوبّ المطّاطيّ الهالك

27
00:03:05,950 --> 00:03:07,350
:الهجوم الخاصّ

28
00:03:07,620 --> 00:03:08,620
!نجم النّار

29
00:03:11,850 --> 00:03:14,460
!مطرقة أوسوبّ

30
00:03:19,960 --> 00:03:21,500
!فزت

31
00:03:23,530 --> 00:03:24,730
!هذا جزاءك

32
00:03:31,740 --> 00:03:33,970
يمكنني أن أقتل بشرًا مثلكما

33
00:03:34,370 --> 00:03:39,510
دون حاجةٍ للمسهم حتّى
.إن كنتُ أملك بعض الماء

34
00:03:40,080 --> 00:03:42,380
هذا الاختلاف بيننا نحن البرمائيّون
.وبينكم أيّها البشر

35
00:03:52,960 --> 00:03:53,890
!أرلونغ

36
00:03:55,130 --> 00:03:56,400
!أختي الكبيرة نامي

37
00:03:56,400 --> 00:03:57,560
!نامي-سان

38
00:03:58,930 --> 00:04:00,600
!أهلاً يا نامي

39
00:04:00,800 --> 00:04:05,340
.وجدتني على وشك تحطيم بعض القراصنة

40
00:04:05,700 --> 00:04:07,670
لِمَ أتيت إلى هنا؟

41
00:04:09,280 --> 00:04:11,280
...أتيتُ لقتلك

42
00:04:15,010 --> 00:04:19,220
!لوفي بأقصى قوّته"
".عزيمة نامي وقبّعة القّشّ

43
00:04:23,320 --> 00:04:27,290
أقلتِ... لقتلي؟

44
00:04:31,560 --> 00:04:34,000
لا تتعلّمين أبدًا، أليس كذلك؟

45
00:04:34,200 --> 00:04:36,200
كم مرّة حاولتِ قتلي

46
00:04:36,200 --> 00:04:39,040
خلال السّنوات الثّمان الّتي قضيتِ معنا؟

47
00:04:39,970 --> 00:04:43,510
جرّبتِ الاغتيال والسّمّ
...والهجوم خلسة

48
00:04:43,510 --> 00:04:45,680
فهل تمكّنتِ من قتلي؟

49
00:04:46,840 --> 00:04:52,120
لا بدّ أنّك مدركة تمام الإدراك
.أنّكم أيّها البشر لا تستطيعون قتلي

50
00:04:53,050 --> 00:04:56,120
...أصغي الآن. لن أقتلك

51
00:04:57,120 --> 00:05:00,190
...كما لا تستطيعين الهرب منّي

52
00:05:01,390 --> 00:05:02,530
...نامي

53
00:05:03,260 --> 00:05:07,100
.ستظلّين معايِنتنا إلى الأبد

54
00:05:08,670 --> 00:05:11,870
.لكن كما تعلمين، أنا رجلٌ كريم

55
00:05:12,270 --> 00:05:16,770
إن كان ممكنًا، أريد منك أن
.تكوني معايِنتنا بمحض إرادتك

56
00:05:21,240 --> 00:05:24,310
فما رأيك؟

57
00:05:24,680 --> 00:05:30,890
.سأقتل الجميع هنا سواك

58
00:05:33,020 --> 00:05:37,460
لكن إن عدتِ بسعادةٍ إلى قراصنة أرلونغ

59
00:05:37,460 --> 00:05:40,500
،ورسمتِ خرائط البحر بصفتكِ إحدى القادة

60
00:05:41,430 --> 00:05:46,470
فلن أمانع أن أصفح عن حياة
.أولئك الأشخاص من قرية كوكوياشي

61
00:05:47,800 --> 00:05:51,670
.لكن لا يمكنني أن أدع هؤلاء يعيشون

62
00:05:52,510 --> 00:05:54,240
.تمادوا كثيرًا

63
00:05:54,240 --> 00:05:56,650
.السّؤال هو أيّ جانبٍ ستأخذين

64
00:05:57,480 --> 00:06:01,620
إمّا أن تأخذي جانبي الآن
،وتنجين بحياتك وحياة أهل قريتك

65
00:06:02,080 --> 00:06:06,590
أو تأخذي جانب هؤلاء الضّعفاء
.وتحاولي قتالي مع الجميع

66
00:06:06,590 --> 00:06:11,290
لكن نظرًا لحالة هؤلاء
،الأشخاص الّذين تعتمدين عليهم

67
00:06:11,530 --> 00:06:14,460
فمن الواضح أنّ الوضع
.سيكون مأساويًّا عليك

68
00:06:17,600 --> 00:06:18,970
...نامي

69
00:06:19,500 --> 00:06:21,840
هل أنت صديقتي؟

70
00:06:22,240 --> 00:06:25,910
أم... صديقتهم؟

71
00:06:28,980 --> 00:06:29,980
...هذا ليس عدلاً

72
00:06:30,850 --> 00:06:33,180
،إن قلتُ أنّني صديقة لوفي والبقيّة

73
00:06:33,180 --> 00:06:34,780
.سيُقتل الجميع

74
00:06:35,150 --> 00:06:37,150
،وإن قلتُ أنّني صديقة أرلونغ

75
00:06:37,150 --> 00:06:39,090
.سينجو الجميع من قريتي

76
00:06:39,720 --> 00:06:41,220
،حسب كلامي

77
00:06:41,220 --> 00:06:42,590
...فالجميع سوف

78
00:06:45,530 --> 00:06:46,330
!هذه خساسة

79
00:06:46,330 --> 00:06:49,260
،مهما كان قرارها
!لن يعيد لها حريّتها

80
00:06:51,670 --> 00:06:52,700
...لكن

81
00:06:57,270 --> 00:06:58,270
...لوفي

82
00:07:03,780 --> 00:07:04,880
...ساعدني

83
00:07:05,850 --> 00:07:08,310
!بالطّبع سأفعل

84
00:07:11,620 --> 00:07:14,990
!لا يجب أن أشكّ في كلامه

85
00:07:19,060 --> 00:07:20,330
!جميعًا، أنا آسفة

86
00:07:20,730 --> 00:07:23,030
!موتوا معي رجاءً

87
00:07:25,600 --> 00:07:27,800
!حسنٌ

88
00:07:27,800 --> 00:07:30,000
!نحن لها

89
00:07:30,000 --> 00:07:32,540
!سنقاتل

90
00:07:34,010 --> 00:07:35,370
...فهمت

91
00:07:35,540 --> 00:07:38,410
...يريد الجميع أن يموتوا

92
00:07:45,980 --> 00:07:48,050
!ر... رجاءً! رجاءً

93
00:07:48,750 --> 00:07:52,520
!عِش! عِش! عِش! عِش! عِش

94
00:08:02,700 --> 00:08:03,600
ما الّذي...؟

95
00:08:06,800 --> 00:08:07,640
...أخيرًا

96
00:08:08,210 --> 00:08:10,470
بقي أن نخلّصه من الوزن
...الّذي على رجليه فحسب

97
00:08:10,880 --> 00:08:11,840
...ما الّذي

98
00:08:13,880 --> 00:08:15,510
...هذا ما قصدته إذًا

99
00:08:15,980 --> 00:08:17,050
!هل يمكن...؟

100
00:08:17,050 --> 00:08:18,820
!أخي الكبير لوفي

101
00:08:20,220 --> 00:08:22,020
!أنت، تمالك نفسك

102
00:08:22,020 --> 00:08:23,890
!عُد إلى وعيك

103
00:08:35,700 --> 00:08:36,970
!ثلاثون ثانية

104
00:08:36,970 --> 00:08:38,640
.لن أصمد أكثر من ذلك

105
00:08:41,570 --> 00:08:42,570
!زورو

106
00:08:43,170 --> 00:08:44,940
!ستكون كافية

107
00:08:46,740 --> 00:08:49,250
.لا توجد نافورة هناك

108
00:08:49,680 --> 00:08:51,710
!أيمكن أن يكون فتى المطّاط ذاك؟

109
00:08:56,990 --> 00:08:58,390
.لا تقلق

110
00:08:58,390 --> 00:09:00,890
!لا يوجد شيء يا نصف السّمكة اللّعين

111
00:09:01,790 --> 00:09:06,460
ظننتني أخبرتك ألاّ تناديني
...هكذا ثانية

112
00:09:06,460 --> 00:09:08,600
!يا زورو المحتضر

113
00:09:14,070 --> 00:09:16,270
،إن ركلتُ وحطّمتُ ذلك الوزن على رجله

114
00:09:16,270 --> 00:09:17,740
.يمكنه القتال

115
00:09:18,170 --> 00:09:22,080
!لوفي، أنت الوحيد الّذي يستطيع القتال الآن

116
00:09:26,310 --> 00:09:30,990
في البحر، يُفترض بحامل قدرات
فاكهة الشّيطان

117
00:09:30,990 --> 00:09:34,290
،أن يفقد حتّى الطّاقة على المقاومة
.وكذلك كلّ قواه، ويموت

118
00:09:35,220 --> 00:09:37,560
،إن كان لا يزال حيًّا

119
00:09:38,090 --> 00:09:42,260
فيعني ذلك أنّ أحدهم يحاول
.إفساد هذه اللّعبة

120
00:09:42,560 --> 00:09:44,000
!هل أنت بخير؟

121
00:09:44,000 --> 00:09:45,130
!حمدًا للّه أنّك بخير

122
00:09:45,500 --> 00:09:47,100
عجبًا! ماذا؟

123
00:09:47,100 --> 00:09:48,240
!ماذا؟! ما الخطب؟

124
00:09:50,140 --> 00:09:52,840
أيّها العمّ، ما الّذي فعلته بمروحتك؟
.كانت رائعة

125
00:09:52,840 --> 00:09:55,710
!من يكترث لذلك الآن؟

126
00:09:56,810 --> 00:09:58,410
إفساد اللّعبة؟

127
00:09:58,950 --> 00:10:02,180
.لم تبدُ كلعبةٍ ممتعة من البداية

128
00:10:03,350 --> 00:10:05,120
،على أيّ حال

129
00:10:05,120 --> 00:10:07,650
،إن كان هنالك عائق ما
.عليّ أن أتحقّق منه

130
00:10:08,860 --> 00:10:09,620
.تنحّ عن طريقي

131
00:10:12,760 --> 00:10:13,790
!نجم البيض

132
00:10:17,030 --> 00:10:18,800
!أنا أدعمك من الخلف يا زورو

133
00:10:19,630 --> 00:10:22,070
!أخي الكبير أوسوبّ! أهو بخير؟

134
00:10:22,300 --> 00:10:25,470
!يا لشجاعته ويا له من دخولٍ باسل

135
00:10:25,510 --> 00:10:27,970
!قاتل بكلّ ما تيسّر لك

136
00:10:27,970 --> 00:10:29,640
!هل أنت هناك؟

137
00:10:30,640 --> 00:10:31,910
!أوسوبّ

138
00:10:32,450 --> 00:10:33,680
!اسمعي يا نامي

139
00:10:33,680 --> 00:10:35,150
!هزمتُ أحد القادة

140
00:10:35,150 --> 00:10:37,880
!أحد القادة! أحد القادة

141
00:10:38,080 --> 00:10:39,990
.الشّخص الّذي يملك وجهًا كهذا

142
00:10:41,890 --> 00:10:43,860
!البرمائيّون ضعفاء بحقّ

143
00:10:47,090 --> 00:10:49,830
!أهزمتَ... تشو؟

144
00:10:51,660 --> 00:10:53,000
!نلت ما تستحقّ

145
00:10:53,000 --> 00:10:56,430
!بقدومي، سيصل القتال إلى ذروته الآن

146
00:10:56,600 --> 00:10:58,770
!إنّه متّجه إلى فصله الأخير

147
00:11:06,850 --> 00:11:09,980
اسمع، ألا تستطيع الإفلات
بنفسك بطريقةٍ ما؟

148
00:11:09,980 --> 00:11:11,380
.هذا مستحيل

149
00:11:11,380 --> 00:11:13,350
.لا حول لي ولا قوّة

150
00:11:13,520 --> 00:11:17,090
!اخرجي! اخرجي! اخرجي

151
00:11:20,260 --> 00:11:22,090
!الأخ الكبير الطّبّاخ

152
00:11:22,490 --> 00:11:25,260
،لا أدري ما الّذي يجري داخل الماء

153
00:11:25,260 --> 00:11:28,200
!لكن لا بدّ أن تكون مبادرته هي الفيصل

154
00:11:28,200 --> 00:11:29,500
!أخي الكبير زورو

155
00:11:29,900 --> 00:11:32,340
!حافظ على ثباتك وأوقف أرلونغ

156
00:11:34,640 --> 00:11:35,840
!حسنًا

157
00:11:35,840 --> 00:11:39,980
علينا أن نمنع أرلونغ من
.النّزول إلى البحر بطريقةٍ ما

158
00:11:39,980 --> 00:11:41,950
.سأوقفه عن الحراك

159
00:11:45,780 --> 00:11:49,550
!لن أدعك تفعل ما يحلو لك

160
00:11:49,750 --> 00:11:52,520
!أنت يا أرلونغ! انظر ها هنا

161
00:11:54,960 --> 00:11:57,260
!ماذا؟! أخي الكبير أوسوبّ

162
00:11:57,260 --> 00:11:58,560
!يا لجسارته

163
00:12:00,630 --> 00:12:02,500
...رباط

164
00:12:02,830 --> 00:12:04,330
!أوسوب المطّاطيّ الهالِك

165
00:12:02,830 --> 00:12:05,270
...ها أنت تقف في طريقي

166
00:12:05,270 --> 00:12:09,210
.يبدو أنّك تفضّل أن تموت أوّلاً يا زورو

167
00:12:09,570 --> 00:12:11,570
!الآن يا زورو

168
00:12:11,570 --> 00:12:13,680
!ما الّذي تريد فعله؟

169
00:12:16,350 --> 00:12:17,950
.محالٌ أن أموت

170
00:12:17,950 --> 00:12:20,750
!سأكسر أنفك الفخور

171
00:12:25,790 --> 00:12:27,160
...أيّها الأحمق

172
00:12:27,160 --> 00:12:30,460
.إنّه أنف أفخر به لأنّه لا ينكسر

173
00:12:31,560 --> 00:12:34,660
،لكن إن كنتَ في قوّتك القصوى

174
00:12:34,830 --> 00:12:38,000
.لربّما استطعتَ أن تُحدث فيه خدشًا

175
00:12:53,550 --> 00:12:54,820
...أخي الكبير

176
00:12:54,820 --> 00:12:56,280
!انظر هناك

177
00:12:58,050 --> 00:13:00,490
!نهض ذاك الأخطبوط اللّعين

178
00:13:02,560 --> 00:13:04,960
و... ما الّذي يفعله؟

179
00:13:07,700 --> 00:13:11,000
سحقًا! حسبتُ أنّ ذلك الرّباط
!المطّاطيّ سيصيبني

180
00:13:11,000 --> 00:13:15,000
!ماذا؟

181
00:13:16,670 --> 00:13:19,570
!أرأيتم؟! هو من كان هدفي

182
00:13:19,570 --> 00:13:21,980
لكنّك كنتَ تصرخ باسم
أرلونغ"، أليس كذلك؟"

183
00:13:23,310 --> 00:13:24,140
...ذاك الأخطبوط

184
00:13:25,050 --> 00:13:29,680
!رورونوا زورو
!لن أدعك تفعل ما يحلو لك

185
00:13:29,680 --> 00:13:33,350
!سأسحق صديقك الّذي نزل إلى البحر

186
00:13:40,390 --> 00:13:45,930
لستَ بحاجةٍ للقلق بما أنّكم
.ستموتون جميعًا على أيّ حال

187
00:13:52,300 --> 00:13:54,840
!أخي الكبير

188
00:14:41,320 --> 00:14:43,120
!أُخت نامي-سان الكبيرة

189
00:14:43,120 --> 00:14:44,620
!اتركي الباقي لي

190
00:14:48,790 --> 00:14:49,690
!برمائيّ

191
00:14:52,030 --> 00:14:53,400
.ابتعدي يا أختي الكبيرة

192
00:14:53,400 --> 00:14:55,300
!سأحطّم صخرةً كتلك بركلتي

193
00:15:01,400 --> 00:15:02,210
!ذاك الأخطبوط

194
00:15:02,370 --> 00:15:06,010
!لكمة التّاكوياكي

195
00:15:06,280 --> 00:15:07,540
!أختي الكبيرة

196
00:15:14,520 --> 00:15:16,450
!زورو

197
00:15:20,390 --> 00:15:22,360
أهذا كلّ ما عندك؟

198
00:15:22,590 --> 00:15:24,060
.كان ذلك سريعًا جدًّا

199
00:15:25,090 --> 00:15:28,730
وما قصّة هذه الضمّادات؟

200
00:15:30,230 --> 00:15:32,640
هل وقعتَ في مكانٍ ما؟

201
00:15:36,840 --> 00:15:38,670
ما هذه النّدبة؟

202
00:15:53,090 --> 00:15:56,160
أنّى له أن يكون حيًّا بهذه الحالة؟

203
00:15:56,990 --> 00:15:59,390
!أنّى له أن يظلّ واقفًا؟

204
00:16:11,240 --> 00:16:13,240
أيّ عينين هاتين؟

205
00:16:13,970 --> 00:16:16,440
أهما عينا شخصٍ يحتضر؟

206
00:16:18,480 --> 00:16:20,450
،إنّه رجلٌ أحتاج قتله بالتّأكيد

207
00:16:21,180 --> 00:16:25,690
!الآن وها هنا

208
00:16:32,990 --> 00:16:34,830
،إن ظلّ المصابُ ساكنًا

209
00:16:35,330 --> 00:16:38,330
...لن تُفتح جراحه ثانية

210
00:16:38,330 --> 00:16:40,530
.أصبتَ قولاً

211
00:16:41,000 --> 00:16:43,370
هل تجد وضعك مسلّيًا؟

212
00:16:46,970 --> 00:16:49,110
...لا أتحدّث عن نفسي

213
00:16:49,710 --> 00:16:51,480
.بل عن ذلك الرّجل الأخطبوط

214
00:16:52,510 --> 00:16:53,410
!ماذا؟

215
00:16:53,780 --> 00:16:55,080
...ظننتني أخبرتك

216
00:16:55,410 --> 00:16:58,220
.فزنا بهذه اللّعبة

217
00:17:14,670 --> 00:17:16,900
!سحقًا

218
00:17:17,270 --> 00:17:19,770
!أفزعني ذلك

219
00:17:23,480 --> 00:17:27,150
أنت من جعل هذا الوضع
!معقّدًا من البداية

220
00:17:29,610 --> 00:17:30,750
!ممتاز

221
00:17:31,450 --> 00:17:33,550
...اذهب أيّها اللّعين

222
00:17:33,890 --> 00:17:36,290
!واهزم ذلك القّرش الوضيع

223
00:17:38,290 --> 00:17:39,990
هل تصعد يا فتى؟

224
00:17:39,990 --> 00:17:42,130
!إنّي أصعد

225
00:17:49,530 --> 00:17:54,740
!لقد عُدت

226
00:17:57,210 --> 00:17:58,680
!فتى المطّاط

227
00:17:58,910 --> 00:18:01,650
!أخي الكبير لوفي

228
00:18:08,290 --> 00:18:09,320
!لوفي

229
00:18:12,860 --> 00:18:14,990
!...ذاك الوغد

230
00:18:16,160 --> 00:18:17,960
!تأخّرتَ أيّها الغبيّ

231
00:18:20,200 --> 00:18:20,830
!زورو

232
00:18:21,460 --> 00:18:24,430
!أنت! توقّف

233
00:18:24,430 --> 00:18:25,670
...لا تقل أنّك

234
00:18:30,270 --> 00:18:31,940
!دعنا نتبادل

235
00:18:34,210 --> 00:18:36,050
!أيّها الغبيّ

236
00:18:36,480 --> 00:18:40,650
!غومو غومو نوو: الجرس

237
00:18:41,480 --> 00:18:44,350
!و... السّوط

238
00:18:51,460 --> 00:18:55,430
!غومو غومو نوو: المسدّس

239
00:18:59,500 --> 00:19:01,470
!الرشّاش

240
00:19:10,910 --> 00:19:11,980
!حسنًا

241
00:19:29,030 --> 00:19:30,970
هل فعلتَ شيئًا؟

242
00:19:31,770 --> 00:19:33,870
!لم تُؤثّر عليه

243
00:19:34,600 --> 00:19:36,900
.نعم. كان إحماءً

244
00:19:42,010 --> 00:19:43,440
!ذاك الغبيّ

245
00:19:43,880 --> 00:19:45,710
!سأقتله

246
00:19:54,090 --> 00:19:55,820
،يا لكم من مجموعة من الحثالة

247
00:19:55,820 --> 00:19:57,860
...تتمسّكون بنُبل

248
00:19:58,960 --> 00:20:03,500
كنتَ لتسعد أكثر لو أنّك متّ
...في قعر البحر

249
00:20:03,500 --> 00:20:04,930
.ماذا؟ كلاّ

250
00:20:04,930 --> 00:20:07,570
.أنا سعيدٌ لأنّهم أنقذوني

251
00:20:10,940 --> 00:20:13,770
هل يمكنك أن تعي غضبي؟

252
00:20:13,770 --> 00:20:18,410
إنّه غضب رؤية إخواني الأعزّاء
.يُهزمون أمام ديدان

253
00:20:19,910 --> 00:20:25,380
ستُدركون قريبًا أنّه كان
.يجب أن تموتوا دون مقاومة

254
00:20:26,320 --> 00:20:28,950
هل سيكون أخي الكبير لوفي بخير؟

255
00:20:28,950 --> 00:20:32,460
لم تُؤثّر هجماته الشّرسة
...على الإطلاق

256
00:20:32,460 --> 00:20:36,330
الأهمّ، إلى أيّ مدى حلّق
!أخي الكبير زورو؟

257
00:20:36,560 --> 00:20:39,930
!عليك به يا لوفي! سأدعمك من الخلف

258
00:20:39,930 --> 00:20:41,530
.لستَ بحاجةٍ لتقلق بشأن خلفه

259
00:20:49,140 --> 00:20:53,140
.إن خسر، ستموتون جميعًا أيضًا

260
00:20:53,540 --> 00:20:55,210
...هذا صحيح

261
00:20:55,210 --> 00:20:57,780
إن حدث ذلك فستكون نهاية
.الأزرق الشّرقيّ أيضًا

262
00:21:05,920 --> 00:21:09,530
ما الفرق الشّاسع بيني وبينك؟

263
00:21:10,860 --> 00:21:11,800
.الأنف

264
00:21:14,970 --> 00:21:15,930
ربّما الفكّ؟

265
00:21:18,200 --> 00:21:20,470
...أتساءل إن كان أخي الكبير يمزح

266
00:21:20,870 --> 00:21:23,510
.لا، إنّه جاد بالتّأكيد

267
00:21:24,240 --> 00:21:25,380
!شباك الأصابع

268
00:21:26,710 --> 00:21:28,550
!جنسٌ حقير

269
00:21:42,760 --> 00:21:45,730
!يا له من غبيّ
!أذى نفسه بقضمه لصخرة

270
00:21:45,730 --> 00:21:47,700
...لا بدّ أنّه كسر أسنانـ

271
00:21:54,040 --> 00:21:57,240
!حطّم العمود الحجريّ بأسنانه

272
00:21:57,570 --> 00:21:59,510
!مصيبة! هذا مخيف

273
00:22:00,840 --> 00:22:02,440
!يا له من رجل

274
00:22:02,810 --> 00:22:04,350
،إن أحكم عليك بأسنانه

275
00:22:04,350 --> 00:22:07,780
،لن يخلّف آثارها عليك فحسب
!بل وسيقضم حتّى عظامك

276
00:22:12,120 --> 00:22:16,220
.أرأيت؟ هذه قوّة البرمائيّين الفطريّة

277
00:22:17,230 --> 00:22:19,690
تحاملت عليكم الأقدار أيّها البشر

278
00:22:20,330 --> 00:22:24,730
وجعلت منكم مخلوقات
.عاجزة تنحني أمام البرمائيّين

279
00:22:28,270 --> 00:22:30,810
.أنتم البشر مخلوقات وضيعة

280
00:22:31,370 --> 00:22:35,340
.كنّا في مستوى مختلف منذ ولادتنا

281
00:22:37,480 --> 00:22:39,110
...سأريك

282
00:22:39,110 --> 00:22:42,320
...الاختلاف الحقيقيّ بيني وبينك

283
00:22:46,090 --> 00:22:48,020
.نعم، تفضّل وأرني

284
00:22:48,820 --> 00:22:51,230
.يستحيل أن أخسر أمام سمكة

285
00:22:51,560 --> 00:22:52,690
...أنا

286
00:22:52,990 --> 00:22:55,260
!الرّجل الّذي سيُصبح ملك القراصنة

287
00:22:57,000 --> 00:23:01,840
مشاعري الجيّاشة لا تتّصل

288
00:23:01,840 --> 00:23:06,670
بينما أشدّ على يدك بثبات

289
00:23:06,670 --> 00:23:11,580
،سأشدّ الشّراع بنفسي

290
00:23:11,580 --> 00:23:17,250
لذا واصل مشاهدتي
باهتمام بينما أبتعد

291
00:23:21,550 --> 00:23:26,760
كان يجول هذا في ذهني قليلاً
منذ هذا الصّباح

292
00:23:26,760 --> 00:23:31,360
لمَ الجوّ حار؟

293
00:23:31,360 --> 00:23:41,670
،بدءًا من تلك النّقطة
لم أستطع التّهرّب من ذلك

294
00:23:42,670 --> 00:23:47,680
أريد أن أمسك تلك المشاعر
،الّتي رحلت بسرعة

295
00:23:47,680 --> 00:23:52,520
حتّى أنّني مستعدّ لأباغت نفسي

296
00:23:52,520 --> 00:23:57,560
أريد أن أعانق أحلامي
الّتي قفزت من صدري

297
00:23:57,560 --> 00:24:02,660
معك، أستطيع الرّكض إلى هناك

298
00:24:11,270 --> 00:24:13,270
ماذا؟ أين ذهب أرلونغ؟

299
00:24:13,270 --> 00:24:14,470
!لوفي! البحر

300
00:24:14,470 --> 00:24:16,940
!البحر؟ عجبًا! هنالك قرش

301
00:24:16,940 --> 00:24:18,480
!بل هو أرلونغ

302
00:24:18,480 --> 00:24:19,710
ماذا؟ هل هرب؟

303
00:24:19,710 --> 00:24:22,980
!هذا سيّئ! قدراته تتضاعف داخل الماء

304
00:24:22,980 --> 00:24:23,910
!احترس

305
00:24:23,910 --> 00:24:25,450
!مصيبة

306
00:24:25,950 --> 00:24:27,480
!لوفي

307
00:24:27,480 --> 00:24:28,950
:في الحلقة القادمة من ون بيس

308
00:24:28,950 --> 00:24:32,290
انفجار! هجوم البرمائيّ"
"!أرلونغ الشّرس من البحر

309
00:24:32,290 --> 00:24:34,760
!ملك القراصنة، لن يكون إلاّ أنا