1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,910 --> 00:03:22,210
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:22,210 --> 00:03:26,420
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:26,940 --> 00:03:31,280
يقاتل لوفي وقراصنة اللّحية البيضاء
،للوصول إلى المنصّة

40
00:03:31,280 --> 00:03:36,670
لكنّ البحريّة فعّلت الجدران المطوّقة
!وأغلقت كلّ طرق الهرب للقراصنة

41
00:03:43,840 --> 00:03:47,430
!مهلاً، ما الخطب؟! يجب أن تُفعّل جميعها

42
00:03:47,640 --> 00:03:53,140
أ-أخشى أنّ ذلك الجدار لن يرتفع
!بسبب جسد أورز العملاق

43
00:03:53,410 --> 00:03:56,230
يبدو أنّ دماءه قد تسرّبت إلى النّظام

44
00:03:56,230 --> 00:03:57,970
!وجعلته أقلّ قوّة

45
00:03:59,560 --> 00:04:02,390
...أورز! إ-إنّك

46
00:04:02,970 --> 00:04:04,230
...لا يمكننا تطويق المكان كلّيًّا

47
00:04:04,750 --> 00:04:06,740
!لكن ابدأ يا أكاينو

48
00:04:24,660 --> 00:04:29,210
!تمّ إصدار أمر الإعدام"
"!اختراق الجدران المطوّقة

49
00:04:35,400 --> 00:04:37,330
!لماذا انقطع البثّ؟

50
00:04:37,330 --> 00:04:38,780
!أرونا ما يجري في مارينفورد

51
00:04:38,780 --> 00:04:40,100
!أصلحوا الأمر بسرعة

52
00:04:40,440 --> 00:04:43,560
!إنّهم يواجهون مشاكل مع حلزون الاتّصال لنقل البثّ

53
00:04:43,560 --> 00:04:45,150
!لا يوجد ما يسعنا فعله

54
00:04:47,780 --> 00:04:51,470
هل صحيح أنّ اللّحية البيضاء
!والبحريّة كان بينهما اتّفاق؟

55
00:04:54,620 --> 00:04:55,950
!افعلوا شيئًا ما

56
00:04:56,650 --> 00:04:58,870
!هل باع اللّحية البيضاء حلفاءه؟

57
00:05:01,630 --> 00:05:03,250
!ما الّذي سيحدث للحرب؟

58
00:05:05,340 --> 00:05:08,040
!ما الّذي سيحدث للعالم؟

59
00:05:17,540 --> 00:05:20,170
!يا لسخافة البحريّة

60
00:05:20,630 --> 00:05:22,860
أيعني أنّ كلّ ذلك كان مجرّد عرض جانبيّ؟

61
00:05:23,020 --> 00:05:26,560
!عدنا فقط لمشاهدة الحرب

62
00:05:26,720 --> 00:05:28,540
!لا أصدّق أنّهم يواجهون مشكلة مع حلزون الاتّصال

63
00:05:28,540 --> 00:05:30,440
إذًا فأنتم تصدّقون ذلك أيضًا؟

64
00:05:30,920 --> 00:05:31,900
أولا تصدّقه أنت؟

65
00:05:32,030 --> 00:05:34,280
!يا لكم من أغبياء

66
00:05:34,280 --> 00:05:36,870
...إنّهم لا يريدون عرضه لأنّ هنالك أمورًا

67
00:05:37,370 --> 00:05:39,830
.لا يريدون منّا أو من العالم أن يروها

68
00:05:50,150 --> 00:05:51,610
...أيّتها القبطانة بوني

69
00:05:52,130 --> 00:05:54,100
!اخرس! دعني وشأني

70
00:05:54,680 --> 00:05:57,130
"باع اللّحية البيضاء حلفاءه؟"

71
00:05:57,130 --> 00:05:58,440
!هذا هراء

72
00:05:58,740 --> 00:06:02,220
.ما كان ليفعل ذلك
!لهذا هو أسطورة حيّة

73
00:06:03,040 --> 00:06:04,280
!لنبحر يا بيبو

74
00:06:04,280 --> 00:06:05,870
!حاضر يا قبطان

75
00:06:05,870 --> 00:06:07,380
!تعال معنا يا جان بار

76
00:06:07,890 --> 00:06:11,120
!هذا صحيح أيّها المكتب الرّئيسيّ
!ولا فرص في استعادة الإشارة

77
00:06:11,120 --> 00:06:14,610
!لذلك لا أعلم ما الّذي يحدث في مارينغورد الآن

78
00:06:19,260 --> 00:06:21,210
!بركان الشّهب

79
00:06:34,060 --> 00:06:35,700
!لا يمكنهم الهرب

80
00:06:36,400 --> 00:06:39,300
!أذب الجليد الّذي يقفون عليه

81
00:07:22,230 --> 00:07:23,350
!الجليد يذوب

82
00:07:33,600 --> 00:07:35,450
...هـ-هذه المياه

83
00:07:36,990 --> 00:07:38,190
!إنّها ساخنة، ساخنة

84
00:07:38,420 --> 00:07:40,320
!إنّ مياه البحر تغلي بسبب الحمم

85
00:07:43,070 --> 00:07:44,510
!اصعدوا على الجليد

86
00:07:46,030 --> 00:07:46,870
!انظروا

87
00:07:58,530 --> 00:07:59,810
!إنّهم يسدّون هذا الجانب

88
00:08:04,560 --> 00:08:07,370
!ألا يمكننا تدمير هذا الجدار؟

89
00:08:27,920 --> 00:08:29,160
!أيّها اللّحية البيضاء

90
00:08:33,300 --> 00:08:36,750
!لم تنفع هجمات والدنا! إنّه ليس جدارًا عاديًّا

91
00:08:38,740 --> 00:08:41,260
!حسنًا، لننهِ هذا الأمر

92
00:08:49,440 --> 00:08:52,160
!أصابت الحمم سفينة موبي ديك

93
00:08:52,160 --> 00:08:53,680
!أخمدوا النّيران

94
00:08:53,990 --> 00:08:55,520
!أسرعوا جميعًا

95
00:08:56,240 --> 00:08:57,860
!افعلوا  كلّ ما بوسعكم

96
00:09:00,610 --> 00:09:02,230
!لا تدعوها تغرق

97
00:09:02,230 --> 00:09:06,090
كنّا نتطلّع قدمًا للإبحار عبر العالم
!مع إيس على تلك السّفينة ثانية

98
00:09:06,610 --> 00:09:09,980
!أيّها اللّحية البيضاء! ولّت أيّامك

99
00:09:26,740 --> 00:09:28,310
...إنّ موبي ديك

100
00:09:29,710 --> 00:09:33,130
!سُحقًا للبحريّة

101
00:09:33,460 --> 00:09:35,820
!هذه السّفينة هي مجدنا

102
00:09:37,450 --> 00:09:39,920
!تبًّا! سفينتنا

103
00:09:39,920 --> 00:09:43,150
لقد أغرقوا السّفينة الّتي حملت
!قراصنة اللّحية البيضاء لسنوات

104
00:10:08,280 --> 00:10:10,240
...أنا آسف

105
00:10:15,740 --> 00:10:18,780
!نفدت منّا السّبل لدخول السّاحة

106
00:10:22,590 --> 00:10:26,060
!ما الّذي يحدث خلف الجدران؟

107
00:10:26,060 --> 00:10:28,110
!الأمر واضح وإن كنّا لا نستطيع رؤيته

108
00:10:28,110 --> 00:10:32,840
لا يمكنهم التّقدّم أو التّراجع
!وهم عرضة لهجمات متتالية

109
00:10:32,840 --> 00:10:38,080
الجدران المطوّقة عبارة عن تابوت
!لقراصنة اللّحية البيضاء الآن

110
00:10:38,920 --> 00:10:40,270
...تابوت

111
00:10:41,460 --> 00:10:43,230
!تسير الخطّة كما يجب

112
00:10:43,590 --> 00:10:44,840
...لننتقل الآن إلى

113
00:10:45,450 --> 00:10:48,970
...إعدام بورتغاس د. إيس

114
00:10:49,680 --> 00:10:51,380
!في الحال

115
00:11:06,470 --> 00:11:08,160
...في مكان لا يمكننا الرّؤية

116
00:11:08,340 --> 00:11:10,450
!لن نسمح لهم بقتل إيس

117
00:11:10,820 --> 00:11:13,800
!نعم! ما زالت هنالك طريقة ما

118
00:11:14,270 --> 00:11:15,580
!واحدة على الأقلّ

119
00:11:16,610 --> 00:11:18,420
!الطّريق الّذي تركه لنا أورز

120
00:11:20,060 --> 00:11:21,600
!سنكون أهدافًا مكشوفة لهم إن سلكناه

121
00:11:21,600 --> 00:11:23,830
!تتوقّع البحريّة أن نسلكه بكلّ تأكيد

122
00:11:33,060 --> 00:11:35,400
!لا وقت لدينا للجدال

123
00:11:35,410 --> 00:11:39,230
..صحيح! تلك الطّريقة الوحيدة لإنقاذ إيس

124
00:12:01,170 --> 00:12:04,130
!إيس

125
00:12:11,570 --> 00:12:12,670
...قبّعة القشّ

126
00:12:12,670 --> 00:12:14,600
!نحن قادمون أيضًا

127
00:12:25,270 --> 00:12:27,400
!لا يجب عليهم سلك طريق واضح كهذا

128
00:12:27,700 --> 00:12:29,910
!ليس بعد! دعوهم يقتربون بقدر الإمكان

129
00:12:31,230 --> 00:12:32,040
!أطلقوا

130
00:12:37,620 --> 00:12:42,070
!سيدافعون عن المدخل الوحيد بكلّ تأكيد

131
00:12:42,070 --> 00:12:43,240
!هذا فخّ واضح

132
00:12:46,220 --> 00:12:47,250
!اطلقوا

133
00:12:55,880 --> 00:12:57,230
!إيس

134
00:13:18,670 --> 00:13:21,090
!إنّنا ننهي أمرهم شيئًا فشيئًا

135
00:13:31,570 --> 00:13:32,470
!إيس

136
00:13:44,380 --> 00:13:45,730
...إيس

137
00:14:08,120 --> 00:14:09,280
...إيس

138
00:14:21,070 --> 00:14:26,650
!إيس

139
00:14:27,110 --> 00:14:27,860
!أطلقوا

140
00:14:46,550 --> 00:14:48,140
!يا فتى قبّعة القشّ

141
00:14:48,140 --> 00:14:49,090
!لوفي-كُن

142
00:15:18,740 --> 00:15:23,960
!لوفي

143
00:15:39,410 --> 00:15:42,420
!أطلقوا على أيّ أحد يمرّ على أورز

144
00:15:50,950 --> 00:15:54,460
!سأنقذك وإن عنى ذلك موتي

145
00:15:59,510 --> 00:16:01,290
.ابدؤوا عمليّة الإعدام

146
00:16:24,350 --> 00:16:28,140
!إيس-كُن

147
00:17:07,910 --> 00:17:11,600
!ليتل أورز جونيور! ما زال حيًّا

148
00:17:12,530 --> 00:17:15,360
!إيس-كُن

149
00:17:17,580 --> 00:17:19,990
!إيس-كُن

150
00:17:23,500 --> 00:17:25,910
!إيس-كُن

151
00:17:26,980 --> 00:17:28,430
!...أورز

152
00:17:29,390 --> 00:17:33,200
!سأحمي إيس-كُن

153
00:17:34,070 --> 00:17:38,720
!أورز

154
00:17:38,860 --> 00:17:40,810
!أورز حيّ

155
00:17:43,360 --> 00:17:45,440
!أيّها القبطان

156
00:17:45,440 --> 00:17:46,880
!يا له من رجل

157
00:17:47,800 --> 00:17:49,440
!أورز

158
00:17:50,130 --> 00:17:51,650
!أيّها القبطان سكوارد

159
00:18:04,740 --> 00:18:06,880
!أيّها القبطان... سكوارد

160
00:18:07,800 --> 00:18:09,340
...إنّكم

161
00:18:15,340 --> 00:18:16,390
!حسنًا

162
00:18:19,990 --> 00:18:22,000
!هل أنت بخير يا لوفي-كُن؟

163
00:18:22,000 --> 00:18:23,720
!إنّك متهوّر كثيرًا بالفعل

164
00:18:28,170 --> 00:18:29,680
!استعدّوا للإطلاق

165
00:18:35,220 --> 00:18:36,810
!نار

166
00:18:38,740 --> 00:18:40,120
!أورز

167
00:18:42,640 --> 00:18:44,290
!إنّهم يهاجمون أورز ثانية

168
00:18:44,290 --> 00:18:45,120
!أورز

169
00:18:50,680 --> 00:18:51,840
!أورز

170
00:18:53,530 --> 00:18:57,240
!علينا فعل شيء ما! علينا أن نسرع

171
00:18:57,240 --> 00:19:00,500
!سيعدمون إيس

172
00:19:00,840 --> 00:19:02,930
!نعم، علينا إيقافهم

173
00:19:03,490 --> 00:19:04,760
!جينبي

174
00:19:08,060 --> 00:19:11,760
!أريدك أن تسديني خدمة

175
00:19:15,440 --> 00:19:17,350
!إيس-كُن

176
00:19:17,850 --> 00:19:20,060
!يا صلابته

177
00:19:20,060 --> 00:19:22,410
!إنّه بالكاد حيّ! واصلوا إطلاق النّار

178
00:19:22,710 --> 00:19:26,400
!حسنًا. دعوا الأمر لي

179
00:19:26,400 --> 00:19:27,170
!كيزارو-سان

180
00:19:28,270 --> 00:19:32,620
!علينا إنهاء الإعدام بسرعة

181
00:19:34,210 --> 00:19:39,970
!من الأفضل التّصويب على رأسه هذه المرّة

182
00:19:40,720 --> 00:19:41,720
!أورز

183
00:19:41,720 --> 00:19:42,830
!أيّها القبطان أورز

184
00:19:46,680 --> 00:19:48,390
!أورز

185
00:19:49,380 --> 00:19:51,460
!انتهى الأمر

186
00:19:55,770 --> 00:20:00,810
!رمية كتف تيّار المحيط

187
00:20:38,440 --> 00:20:39,440
!...لو

188
00:20:41,910 --> 00:20:43,100
!لوفي

189
00:21:10,940 --> 00:21:13,430
!عجبًا! وصلتَ أخيرًا

190
00:21:15,860 --> 00:21:19,440
!ما زلت واقفًا على قدميك يا ابن دراغون

191
00:21:21,520 --> 00:21:25,230
!إنّ شبابه أخافني

192
00:21:31,840 --> 00:21:34,920
!الرّجل الّذي قفز فوق الجدار هو أخو إيس

193
00:21:35,900 --> 00:21:37,120
!ذلك الشّقيّ

194
00:21:42,330 --> 00:21:46,140
.سأثني على عنادك فحسب

195
00:21:46,320 --> 00:21:51,010
.لكنّك لست جيّدًا كفاية لتبلغ هذه الخشبة

196
00:21:51,370 --> 00:21:54,190
ما الّذي جعلك تعتقد أنّ بإمكانك هزيمتنا؟

197
00:22:07,310 --> 00:22:13,950
!سأستعيد إيس

198
