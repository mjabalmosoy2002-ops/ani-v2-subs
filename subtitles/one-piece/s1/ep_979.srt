1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,880 --> 00:02:04,180
!لوفي-دونو! يا لسروري
!أنا جدّ مسرور بقدومك

29
00:02:04,680 --> 00:02:09,950
في ليلة مهرجان النّار، بعد أن عرفوا
،أنّ رفيقهم كانجورو هو جاسوس العدوّ

30
00:02:09,950 --> 00:02:13,910
،بدا وكأنّ كلّ آمال ساموراي الأكازايا قد فقدت

31
00:02:13,910 --> 00:02:17,670
!لكنّ لوفي وبقيّة القراصنة أتوا بنصر لهم

32
00:02:17,670 --> 00:02:19,960
!لماذا مجموعة لوفي هنا؟

33
00:02:19,960 --> 00:02:23,870
!ليس هم فحسب، سمعتُ أنّ لو كان محبوسًا

34
00:02:25,220 --> 00:02:27,180
!أنا آسف يا لوفي-دونو

35
00:02:27,970 --> 00:02:31,430
...تسرّبت خطّتنا بالكامل

36
00:02:31,430 --> 00:02:33,810
!هل علينا القتال من دونهم؟

37
00:02:33,810 --> 00:02:36,390
!ماذا؟! مستحيل

38
00:02:36,390 --> 00:02:40,000
!ما زال هنالك أمر واحد لم نخبركم به

39
00:02:40,000 --> 00:02:44,530
آسف. لم نكن نودّ إغراقكم
...في المزيد من اليأس

40
00:02:44,970 --> 00:02:46,280
!ماذا؟

41
00:02:46,680 --> 00:02:51,030
وليمة اليوم ليست مجرّد وليمة أخرى
...في ليلة مهرجان النّار

42
00:02:51,030 --> 00:02:53,790
...إنّها وليمة للاحتفال أيضًا

43
00:02:53,790 --> 00:02:59,030
بالتّحالف بيننا نحن قراصنة مملكة الحيوان
!وقراصنة بيغ مام المشهورين

44
00:03:00,740 --> 00:03:03,300
!اخرسا! سأنافسكما

45
00:03:34,620 --> 00:03:36,690
!الرّجل الواثب

46
00:03:44,530 --> 00:03:46,380
!طلقة الحَقن

47
00:04:11,930 --> 00:04:14,240
!سفينة عائلة كيوشيرو

48
00:04:14,240 --> 00:04:16,490
!لقد حضر كيوشيرو

49
00:04:16,490 --> 00:04:18,940
!أنا في مأمن الآن

50
00:04:19,400 --> 00:04:21,870
.يبدو أنّكم في ورطة

51
00:04:21,870 --> 00:04:24,670
ما الّذي بإمكاني فعله للمساعدة؟

52
00:04:28,030 --> 00:04:29,010
!كلاّ

53
00:04:46,090 --> 00:04:47,320
...ذلك الرّجل

54
00:04:47,680 --> 00:04:50,490
ما الّذي يدور في باله؟

55
00:04:57,310 --> 00:05:01,460
"!حظّ موفّق؟! خطّة القائد كينييمون"

56
00:05:06,400 --> 00:05:09,340
!ما الّذي تفعله أيّها الزّعيم-سان؟

57
00:05:21,770 --> 00:05:23,230
!ما الّذي يحدث؟

58
00:05:26,550 --> 00:05:28,520
.لم أكن أريد إغراق السّفينة

59
00:05:28,520 --> 00:05:32,820
.لذلك عطّلتُ المدافع الموجّهة لنا فحسب

60
00:05:32,820 --> 00:05:35,320
!ما-ما الّذي يحدث؟

61
00:05:35,320 --> 00:05:38,330
!كونوا حذرين! مهاراته لا يستهان بها

62
00:05:38,330 --> 00:05:40,500
!إنّه كلب الشّوغن

63
00:05:40,500 --> 00:05:45,110
!إنّه الياكوزا الّذي أخذ مكان الزّعيم هيوغورو

64
00:05:46,940 --> 00:05:49,490
!يا ساموراي الأكازايا

65
00:05:49,700 --> 00:05:55,930
،أنا ياكوزا من عاصمة الزّهور
!يناديني النّاس بكيوشيرو الغافي

66
00:05:56,160 --> 00:06:02,100
تضمّ عائلة كيوشيرو 200 محارب
!ونودّ مساعدتكم في غارتكم

67
00:06:03,600 --> 00:06:04,820
!ماذا؟

68
00:06:05,080 --> 00:06:06,310
!لا بدّ أنّك تمزح أيّها الزّعيم

69
00:06:06,310 --> 00:06:08,420
أيريد الانضمام إلينا؟

70
00:06:08,420 --> 00:06:10,780
.ظننتُ أنّه عدوّنا

71
00:06:10,780 --> 00:06:12,320
...ذلك ما يفترض أن يكون

72
00:06:19,980 --> 00:06:21,370
ما الّذي يريده؟

73
00:06:21,370 --> 00:06:26,360
!ما الّذي تعنيه؟! أنت تابع أوروتشي
!ما الجميل الّذي تدين لنا به؟

74
00:06:29,530 --> 00:06:34,300
أنا مدين لعشيرة كوزكي بأعداد
...لا تحصى من الجمائل والدّيون

75
00:06:37,290 --> 00:06:40,220
!تخطر على بالي كثيرًا يا كين-سان

76
00:06:41,000 --> 00:06:42,390
!كين-سان؟

77
00:06:42,390 --> 00:06:46,770
حادثة إله الجبل الّتي وقعت
!في العاصمة قبل 40 سنة

78
00:06:50,190 --> 00:06:54,320
...ظنّ النّاس أنّ أودن-ساما فقد صوابه فحسب

79
00:06:54,320 --> 00:06:56,070
.لكنّ الأمر ليس كذلك

80
00:06:56,070 --> 00:07:03,370
حدث ذلك بسبب طمعك في صغرك
!عندما حاولتَ بيع الخنزير الصّغير

81
00:07:23,920 --> 00:07:26,210
!شلاّل الفردوس

82
00:07:32,800 --> 00:07:34,030
ماذا؟

83
00:07:34,030 --> 00:07:37,240
!ثمّة شخص واحد فقط يعلم بذلك الأمر

84
00:07:39,240 --> 00:07:42,060
!لهذا السّبب يسمّونه إله الجبل

85
00:07:42,060 --> 00:07:43,280
!ماذا؟

86
00:07:43,280 --> 00:07:47,690
!...كلاّ! كان خطئي أنّ العاصمة قد

87
00:07:49,400 --> 00:07:50,750
...لا يُعقل

88
00:07:51,030 --> 00:07:52,740
!هل أنت دنجيرو؟

89
00:07:52,740 --> 00:07:53,600
!ماذا؟

90
00:07:53,620 --> 00:07:54,380
!دنجيرو-سان؟

91
00:07:58,370 --> 00:08:00,160
!دنجيرو

92
00:08:00,760 --> 00:08:02,640
...الكثير من الأعداء

93
00:08:02,640 --> 00:08:04,960
!ساعدني يا أشورا

94
00:08:04,960 --> 00:08:05,850
!حسنًا

95
00:08:14,400 --> 00:08:17,680
!دنجيرو! أشورا

96
00:08:18,340 --> 00:08:21,160
!تقدّم يا كينييمون

97
00:08:21,160 --> 00:08:25,520
احمل مستقبل حلم عشيرة كوزكي
!وأودن-ساما على عاتقك

98
00:08:29,830 --> 00:08:32,780
...أنت حيّ

99
00:08:58,630 --> 00:09:03,780
هذا صحيح! أنا من أتباع عشيرة كوزكي
!وواحد من الأكازايا التّسعة

100
00:09:03,780 --> 00:09:05,850
!دنجيرو

101
00:09:08,410 --> 00:09:10,900
!ما-ماذا؟

102
00:09:11,770 --> 00:09:14,480
...أعتقد أنّ التّعرّف إليّ صعب

103
00:09:14,880 --> 00:09:19,840
،عندما أُبغلتُ بعودة كين-سان والبقيّة
،أردت أن آتي إليكم في الحال

104
00:09:19,840 --> 00:09:23,570
.ظللتُ عدوًّا لكم من  باب الحيطة

105
00:09:23,570 --> 00:09:26,430
،وطبعًا إذا كنت قد كشفت هويّتي

106
00:09:26,430 --> 00:09:31,310
لكان الجاسوس قد كشف أمري
!ولكان أوروتشي قد قضى عليّ

107
00:09:32,840 --> 00:09:34,170
!دنجيرو

108
00:09:34,170 --> 00:09:35,630
!اخرس

109
00:09:36,060 --> 00:09:39,690
ولكن، بما أنّني واصلت كسب ثقة
،أوروتشي حتّى النّهاية

110
00:09:39,690 --> 00:09:44,740
تمكّنت من تحرير ألف ساموراي
!في سجن بلدة راستسو

111
00:09:44,740 --> 00:09:46,020
!انظروا هناك

112
00:09:46,050 --> 00:09:47,950
!تعزيزات للأعداء؟

113
00:09:48,310 --> 00:09:50,370
.كلاّ، ليسوا كذلك

114
00:09:54,480 --> 00:09:56,110
...تلك العلامات

115
00:10:03,220 --> 00:10:04,370
...لا يُعقل

116
00:10:04,370 --> 00:10:05,970
!شعارات عشائر السّاموراي

117
00:10:10,290 --> 00:10:14,920
!ما مجموعه 1200 محارب! نحن معكم

118
00:10:20,820 --> 00:10:24,530
!أتى هذا اليوم أخيرًا! سيتسنّى لنا القتال

119
00:10:24,530 --> 00:10:28,930
!الـ-الزّعيم كيوشيرو واحد من الأكازايا؟

120
00:10:28,930 --> 00:10:31,310
!اتّصلوا بأونيغاشيما حالاً

121
00:10:31,310 --> 00:10:33,080
!حا-حاضر

122
00:10:45,030 --> 00:10:46,950
...دنجيرو

123
00:10:46,950 --> 00:10:48,980
!الآن يا كين-سان

124
00:10:48,980 --> 00:10:51,640
!يا لك من رجل ذكيّ

125
00:10:51,640 --> 00:10:56,270
!تشير العلامة إلى تاريخ ومكان اللّقاء للمعركة الكبيرة

126
00:10:56,270 --> 00:10:58,650
...طائران محترقان

127
00:10:58,880 --> 00:11:00,820
...وهابو، أي أفعى حفر، و

128
00:11:00,820 --> 00:11:04,940
!هلالٌ معكوس يرمز للثّورة

129
00:11:04,940 --> 00:11:08,810
.في يوم مهرجان النّار"
.الشّفق، ساعة الطّائر الثّانية

130
00:11:08,810 --> 00:11:11,240
".عند ميناء هابو

131
00:11:11,240 --> 00:11:14,190
.لم تكن العلامة الأصليّة تحمل ذلكما الخطّين

132
00:11:15,750 --> 00:11:19,750
...سُرّب هذا المنشور لأوروتشي والبقيّة

133
00:11:20,280 --> 00:11:25,720
.لكنّ ياسويي-ساما غيّره قبل أن يموت

134
00:11:25,720 --> 00:11:28,340
...هذين الخطّين اللّذين أضيفا حديثًا

135
00:11:28,340 --> 00:11:32,200
!يقطعان الحروف الوسطى

136
00:11:32,200 --> 00:11:37,440
هذا يعني أنّ مكان اللّقاء الجديد هو
...هابوميناتو (ميناء هابو) دون الجزء الأوسط

137
00:11:37,440 --> 00:11:38,730
!أي هاتو

138
00:11:41,880 --> 00:11:47,930
لذا فإنّه الرّصيف في ميناء هابو ذو الإطلالة الممتازة
.على غابة أشجار القيقب الّتي أحبّها ياسويي-ساما

139
00:11:49,140 --> 00:11:50,030
ماذا؟

140
00:11:50,030 --> 00:11:51,910
!ماذا؟

141
00:11:51,910 --> 00:11:57,440
،بسماع وجود خطّين على هابو
.فإنّ أيّ أحد كان ليفهم الرّسالة بسهولة

142
00:11:59,460 --> 00:12:03,250
،لكنّ فكرة وجود جاسوس لأوروتشي بينكم

143
00:12:03,250 --> 00:12:08,800
!جعلتك تخبر النّاس أنّه ميناء توكاغي عمدًا

144
00:12:08,800 --> 00:12:14,010
يملك كلّ ميناء في بلاد وانو اسمًا
.قد يعني اسم حيوان أيضًا

145
00:12:14,010 --> 00:12:18,430
،قد يبدو الجسم طويلاً نوعًا ما
.لكنّ إضافة أطراف للأفعى يجعلها سحليّة

146
00:12:18,430 --> 00:12:21,210
.يقع ميناء توكاغي (سحليّة) في أودون

147
00:12:22,860 --> 00:12:27,130
.هذا صحيح، لم تبدُ تلك الصّورة كسحليّة

148
00:12:27,130 --> 00:12:31,320
...صدّقت الأمر لأنّ كين-ساما كان واثقًا جدًّا

149
00:12:31,320 --> 00:12:34,830
،وقع الجاسوس في الفخّ مباشرة

150
00:12:34,830 --> 00:12:39,650
وأخبر أوروتشي أنّ ميناء توكاغي
!هو مكان اللّقاء الجديد

151
00:12:40,270 --> 00:12:44,320
كانت حماقةَ مَن تصرّف كما يحلو له
!في العاصمة لمدّة طويلة

152
00:12:44,320 --> 00:12:49,620
أخطأ أوروتشي في تقدير المسافة بين كلّ مكان
!ولم يخطُ أيّ خطوة حتّى اللّيلة الماضية

153
00:12:50,630 --> 00:12:54,120
!سأذيقهم الجحيم

154
00:12:54,300 --> 00:12:56,310
هل وجدتم السّفينة؟

155
00:12:56,400 --> 00:12:57,100
!نعم

156
00:13:09,690 --> 00:13:14,950
لكن في ذلك الوقت، كان الجميع
،قد عبروا تلك الجسور العظيمة

157
00:13:14,950 --> 00:13:17,830
!والسّفن الّتي احتاجوها غادرت موانئها

158
00:13:17,830 --> 00:13:20,450
!كلّ ما دُمّر هي السّفن الّتي بقيت

159
00:13:20,450 --> 00:13:25,070
...كما خطّطتَ، المحاربون الـ4200 الّذين جمعتَهم

160
00:13:25,280 --> 00:13:29,200
كانوا متوارين عن الأنظار في رصيف
!ميناء هابو حتّى الوقت المناسب

161
00:13:30,400 --> 00:13:32,370
!هذا يعني أنّهم بخير؟

162
00:14:26,570 --> 00:14:31,080
حتّى بعد 20 سنة، ما زلتُ أتذكّر موت
!أودن-ساما الأسطوريّ

163
00:14:31,450 --> 00:14:35,250
!عشنا حياتنا مؤمنين بعودة عشيرة كوزكي

164
00:14:35,540 --> 00:14:38,960
!نحن قادمون معكم يا ساموراي الأكازايا

165
00:14:38,960 --> 00:14:41,520
!نحن في أهبة الاستعداد

166
00:14:43,400 --> 00:14:48,000
!خطّة الإغارة على أونيغاشيما لم تُحبط على الإطلاق

167
00:14:48,940 --> 00:14:53,420
!بإضافة 1200 من محاربينا، صرنا 5400 في المجمل

168
00:14:53,420 --> 00:14:56,120
!والآن، هيّا بنا جميعًا

169
00:15:00,220 --> 00:15:02,430
!إلى أونيغاشيما

170
00:15:08,270 --> 00:15:10,060
!ثمّة الكثير منهم

171
00:15:10,060 --> 00:15:13,930
!هذا سيّئ! هل من خبر من أونيغاشيما؟

172
00:15:13,930 --> 00:15:18,930
كنت أتّصل بهم، لكنّهم لم يلاحظوا
!بسبب انشغالهم في الوليمة

173
00:15:19,280 --> 00:15:21,660
!مهلاً، هذا رائع

174
00:15:21,660 --> 00:15:24,790
!بعد كلّ هذه المتاعب، صار لنا حلفاء أكثر

175
00:15:24,790 --> 00:15:27,770
.لكنّنا كنّا سنقوم بالأمر في كلّ الأحوال

176
00:15:27,770 --> 00:15:30,770
.كلّما زاد عددنا، كان أفضل

177
00:15:30,910 --> 00:15:33,000
.من الجيّد وجودهم معنا

178
00:15:33,000 --> 00:15:36,510
!بإمكاننا الآن هزيمة قراصنة مملكة الحيوان بسهولة

179
00:15:37,450 --> 00:15:39,120
!هذا ممتاز

180
00:15:40,620 --> 00:15:44,330
،لا أعرف ما الّذي يحدث بالتّحديد
!لكنّ كلّ شيء بخير الآن

181
00:15:44,330 --> 00:15:48,230
.لا ترخِ دفاعاتك. بيغ مام في أونيغاشيما أيضًا

182
00:15:48,230 --> 00:15:52,060
!كلاّ! لم يتغيّر أيّ شيء

183
00:15:52,060 --> 00:15:55,320
!سُحقًا لك يا كينييمون

184
00:15:55,680 --> 00:15:59,200
!كين-سان! هذا هو قائدنا

185
00:15:59,200 --> 00:16:02,200
!أنت جدير بالاحترام كما توقّعت

186
00:16:08,500 --> 00:16:10,540
!هذا هو قائدنا كينييمون-سان

187
00:16:10,540 --> 00:16:12,580
!أنت الوحيد الّذي يمكنه قيادتنا

188
00:16:12,580 --> 00:16:14,780
!سنتبعك حتّى النّهاية

189
00:16:25,040 --> 00:16:27,310
...لم يكن "توكاغي (سحليّة)" إذًا

190
00:16:27,630 --> 00:16:30,210
..."(بل "هاتو (رصيف

191
00:16:55,960 --> 00:16:59,260
.كن صريحًا يا كينييمون

192
00:16:59,260 --> 00:17:04,180
نعرف أنّك لست قادرًا على قول
.كذبة ماكرة كهذه

193
00:17:05,100 --> 00:17:08,080
.انتهى الأمر على خير
.لن نغضب منك إن اعترفت

194
00:17:08,080 --> 00:17:08,920
.توقّف

195
00:17:09,480 --> 00:17:12,540
ظننتَ فعلاً أنّه "توكاغي"، صحيح؟

196
00:17:12,540 --> 00:17:13,590
!هذا يكفي

197
00:17:13,600 --> 00:17:17,440
!لكن انتهى كلّ شيء على ما يرام
.كان خطأ محظوظًا

198
00:17:20,510 --> 00:17:24,280
!ربّما قد أموت في هذه المعركة

199
00:17:25,270 --> 00:17:28,790
!أشعر وكأنّني أنفقت حظّ عُمري بالكامل

200
00:17:30,400 --> 00:17:33,040
!أكيد، قد كنتَ محظوظًا بشكل مذهل

201
00:17:33,040 --> 00:17:34,570
!كينييمون-دونو

202
00:17:34,620 --> 00:17:36,030
!هذا هو قائدنا العزيز

203
00:17:36,030 --> 00:17:42,340
،لكن بما أنّنا نتشارك نفس الهدف
!كان لذلك نصيب من حظّنا أيضًا

204
00:17:45,720 --> 00:17:49,560
!إنّه محقّ يا كين-ساما! لن ندعك تموت وحدك

205
00:17:50,080 --> 00:17:52,640
!لقد خدمنا أودن-ساما كساموراي معًا

206
00:17:52,640 --> 00:17:57,400
،صحيح أنّنا ولدنا وتربّينا بشكل مختلف
!لكنّنا سنموت معًا! فلا تنسَ ذلك

207
00:18:05,470 --> 00:18:09,890
.لستُ سعيدًا بسماع هذا من رجال مزعجين مثلكم

208
00:18:22,110 --> 00:18:24,800
!قبلتُ مصيري

209
00:18:25,080 --> 00:18:28,040
!مرّت 20 سنة على موت أودن-ساما المأساويّ

210
00:18:28,950 --> 00:18:34,330
كانت بلاد وانو منغمسة في ظلمة
!أحلك من هذه السّماء الغائمة

211
00:18:34,810 --> 00:18:38,050
!لكن آن الأوان

212
00:18:39,130 --> 00:18:41,150
!هيّا بنا إلى أونيغاشيما

213
00:18:41,150 --> 00:18:44,280
!لنثأر من موت أودن-ساما معًا

214
00:18:45,430 --> 00:18:47,720
!كينييمون-دونو

215
00:18:47,720 --> 00:18:51,790
!سنغيّر بلاد وانو بأيّ ثمن كان

216
00:19:15,170 --> 00:19:16,370
!لنتراجع حاليًّا

217
00:19:16,510 --> 00:19:17,710
!حا-حاضر

218
00:19:18,060 --> 00:19:19,140
!ما هذا؟

219
00:19:19,220 --> 00:19:20,520
!ما الّذي يحدث؟

220
00:19:20,910 --> 00:19:22,310
!ما الّذي سنفعله؟

221
00:19:22,370 --> 00:19:23,800
!علينا الهرب

222
00:19:30,680 --> 00:19:36,040
لا تظنّوا أنّ بإمكانكم العودة
!سالمين بعد سخريتكم منّي

223
00:19:39,900 --> 00:19:42,240
...اسمعا! لسنا بحاجة للسّعي خلفهم

224
00:19:43,450 --> 00:19:44,950
...يا إلهي

225
00:19:49,510 --> 00:19:52,850
.يا لكينييمون اللّعين... عليّ إبلاغ أونيغاشيما

226
00:19:52,850 --> 00:19:56,460
!قمتُ بدوري الّذي أوكلني إيّاه أوروتشي-ساما

227
00:19:58,100 --> 00:20:00,230
!بقي لي أمر واحد فقط لأفعله

228
00:20:02,260 --> 00:20:03,470
!كاواماتسو؟

229
00:20:14,490 --> 00:20:17,620
!لم أكن أعرف أنّك بارع في الرّسم هكذا

230
00:20:18,830 --> 00:20:19,960
!لن أسمح لك بالذّهاب

231
00:20:20,750 --> 00:20:23,990
!لن أسمح لك بخطف مومونوسكي-ساما

232
00:20:28,370 --> 00:20:30,620
!كاواماتسو! أنا قادم أيضًا

233
00:20:30,620 --> 00:20:33,040
!إيّاك! ستغرق

234
00:20:35,000 --> 00:20:38,640
!تشاركنا جميعًا سنوات عديدة من الألم والمعاناة

235
00:20:38,640 --> 00:20:42,050
!خدمنا تحت راية أودن-ساما معًا وفقدناه معًا

236
00:20:42,980 --> 00:20:46,690
هل تستمتع بخداع وخيانة أصدقاء كهؤلاء؟

237
00:20:46,860 --> 00:20:51,240
هل تستمتع بدوسك على أمنياتنا وتخييب أمالنا؟

238
00:20:51,240 --> 00:20:52,990
!كانجورو

239
00:20:54,570 --> 00:20:57,440
!أجل! أستمتع كثيرًا

240
00:20:58,450 --> 00:21:01,160
!الخداع والتّحايل والنّهاية المفاجئة

241
00:21:01,160 --> 00:21:04,130
لا يوجد دور في العالم بأسره
!جدير بأن ألعبه أكثر من هذا

242
00:21:05,740 --> 00:21:09,590
!وأعجبني كيف تظاهرتم بالغباء أيضًا

243
00:21:12,620 --> 00:21:15,290
!كانجورو

244
00:21:20,100 --> 00:21:24,340
!سننهي المسرحيّة بتلطيخ الخشبة بدماء كوزكي

245
00:21:34,780 --> 00:21:36,390
!كاواماتسو

246
00:21:36,390 --> 00:21:38,440
!مومونوسكي-ساما

247
00:21:38,450 --> 00:21:43,170
.لا تقلق يا مومونوسكي
.سأجعل أختك تتبعك إلى حتفك

248
00:21:43,170 --> 00:21:47,590
!كاواماتسو! أقسم أنّني سأجد هيوري وأقتلها أيضًا

249
00:21:47,590 --> 00:21:50,240
!أعلم أنّها حيّة الآن

250
00:21:53,720 --> 00:21:55,300
!كانجورو

251
00:21:55,300 --> 00:21:58,430
!لا أصدّق أنّك رسمتَ طائرًا يمكنه الطّيران ببراعة

252
00:21:58,430 --> 00:22:04,500
كلّ ما رأيناه منك هي رسومات بلا فائدة
!تختفي إن لمست الماء

253
00:22:04,500 --> 00:22:06,710
!كان ذلك جزءًا من دوري أيضًا

254
00:22:07,210 --> 00:22:08,770
!نحن على ارتفاع شاهق

255
00:22:08,770 --> 00:22:12,610
!أنزلني! أنا خائف! النّجدة

256
00:22:17,240 --> 00:22:19,100
!أغرقناهم في نفس الوقت ثانية

257
00:22:19,100 --> 00:22:21,160
!سأغرق السّفينة الأخيرة

258
00:22:21,160 --> 00:22:22,770
!بل أنا من سيغرقها

259
00:22:22,800 --> 00:22:24,120
!قلتُ أنّني سأغرقها

260
00:22:24,120 --> 00:22:26,570
!مومونوسكي-ساما

261
00:22:28,240 --> 00:22:30,750
كانجورو؟ مومو؟

262
00:22:30,750 --> 00:22:32,420
!مهلاً! إلى أين تذهبان؟

263
00:22:32,420 --> 00:22:34,740
!الوداع أيّها الحمقى

264
00:22:37,790 --> 00:22:42,270
!في كلّ الأحوال، لستم ندًّا لجيش كايدو-ساما

265
00:22:42,270 --> 00:22:45,060
!لا يمكنكم حتّى دخول الجزيرة

266
00:22:48,550 --> 00:22:51,470
!النّجدة

267
00:23:03,770 --> 00:23:05,910
،بينما يحلّق بعيدًا

268
00:23:05,910 --> 00:23:11,800
يتحمّل القائد الصّغير مومونوسكي خوفه الشّديد
.ويصرخ من أعماق قلبه ويشجّع رفاقه

269
00:23:11,800 --> 00:23:19,680
يبعد طاقم قبّعة القشّ هجوم العدوّ وكذا الأمواج
!العاتية وكلّهم غضب على خيانة كانجورو

270
00:23:19,680 --> 00:23:22,360
!سينقذون صديقهم مهما كلّف الأمر

271
00:23:22,360 --> 00:23:26,810
:"في الحلقة القادمة من وان بيس
"!وعد بدموع! مومونوسكي المختطَف"

272
00:23:26,810 --> 00:23:30,510
!ملك القراصنة، لن يكون إلاّ أنا