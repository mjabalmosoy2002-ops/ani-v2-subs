1
00:00:00,000 --> 00:00:05,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:09,660 --> 00:00:12,500
في نهاية الأحلام، في نهاية البحر

3
00:00:12,500 --> 00:00:15,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:15,000 --> 00:00:18,010
ولكن أوّلاً، علينا صنع

5
00:00:18,010 --> 00:00:22,890
أسطورة لامعة من أنفسنا

6
00:00:22,890 --> 00:00:25,720
شرارات متطايرة من هنا بلا حدود

7
00:00:25,720 --> 00:00:27,350
!وان بيس

8
00:00:27,350 --> 00:00:29,980
سنخبر جميعنا الرّحّالة

9
00:00:29,980 --> 00:00:33,980
هل ما زالت أحلامكم واضحة؟

10
00:00:35,360 --> 00:00:42,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:42,030 --> 00:00:48,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:00:48,500 --> 00:00:51,120
سنخبر جميعنا الرّحّالة

13
00:00:51,120 --> 00:00:54,880
لا توجد قتالات بلا معنى

14
00:00:56,540 --> 00:01:03,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:03,010 --> 00:01:09,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:09,600 --> 00:01:15,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:15,730 --> 00:01:22,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:27,990 --> 00:01:32,870
"!العدالة الّتي لا تلين! السّجلّ الفخريّ للبحريّة"

19
00:01:35,960 --> 00:01:38,000
مرحبًا يا رفاق! كيف الأحوال؟

20
00:01:38,170 --> 00:01:42,050
.هذه أنا ملاّحة طاقم قبّعة القشّ نامي
!سررت بلقائكم

21
00:01:42,170 --> 00:01:44,550
.وأنا ربّان سفينة الطّاقم جينبي

22
00:01:44,680 --> 00:01:47,510
.شكرًا على حضوركم جميعًا

23
00:01:47,640 --> 00:01:50,640
.سنتحدّث اليوم عن البحريّة

24
00:01:50,810 --> 00:01:54,310
.وأنا القنّاص أوسوبّ
.لا حاجة لمشاهدة هذه الحلقة

25
00:01:54,480 --> 00:01:57,940
ماذا هنالك يا أوسوبّ؟ أتعاني خطبًا ما؟

26
00:01:58,060 --> 00:01:59,960
.لقد كنت أخفي شيئًا ما عنكم

27
00:02:00,090 --> 00:02:03,820
أعاني من مرض رؤية مشاهد
.ماضية للبحريّة المميت

28
00:02:03,950 --> 00:02:04,650
!كاذب

29
00:02:04,780 --> 00:02:07,320
أصاب بطفح على جلدي كلّما
!ذُكر هؤلاء البحّارة

30
00:02:07,450 --> 00:02:09,990
لكنّ القراصنة بحّارة أيضًا، صحيح؟

31
00:02:10,160 --> 00:02:13,830
من المحرج قليلاً للقراصنة
،أن يقوموا بتقديم هؤلاء

32
00:02:13,960 --> 00:02:15,960
.لكن علينا معرفة عدوّنا جيّدًا

33
00:02:16,120 --> 00:02:17,460
.هذا صحيح

34
00:02:17,630 --> 00:02:21,130
!معك حقّ. سأبذل ما بوسعي

35
00:02:21,800 --> 00:02:24,340
.أوّلاً، ألقوا نظرة على هذا

36
00:02:24,800 --> 00:02:28,720
.هذا هو المبيان التّنظيميّ للبحريّة

37
00:02:29,510 --> 00:02:32,770
إنّها منظّمة مخصّصة للحفاظ
...على الأمن في البحار

38
00:02:32,890 --> 00:02:36,060
.في جميع بلدان حكومة العالم

39
00:02:36,440 --> 00:02:39,020
،باسم العدالة المطلقة

40
00:02:39,190 --> 00:02:44,360
يعتقلون أساسًا القراصنة
.وبقيّة الخارجين عن القانون

41
00:02:45,320 --> 00:02:48,490
.لنبدأ بالحديث عن أميرال الأسطول

42
00:02:49,370 --> 00:02:53,160
الضّابط الأعلى رتبة بين البحريّة حاليًّا
.وهو أميرال الأسطول ساكازوكي

43
00:02:53,330 --> 00:02:57,000
إنّه رجل الحمم الّذي أكل
.فاكهة الحمم، وهي من نوع لوغيا

44
00:02:57,170 --> 00:03:02,000
كان لا يزال أميرالاً خلال حرب القمّة
.في مارينفورد قبل سنتين

45
00:03:02,670 --> 00:03:06,760
.إنّه الرّجل الّذي قتل إيس-سان

46
00:03:06,880 --> 00:03:10,010
.وتسبّب أيضًا بالنّدبة على صدر لوفي

47
00:03:10,140 --> 00:03:13,060
!لا أصدّق أنّ بإمكانه التّلاعب الحمم

48
00:03:13,640 --> 00:03:17,640
.ملك القراصنة غولد روجر، والثّوريّ دراغون

49
00:03:17,770 --> 00:03:21,940
.ذُهلتُ عندما علمتُ أنّ ابنَيهما أخوان غير شقيقين

50
00:03:22,730 --> 00:03:25,740
.كلاكما تسري في عروقكما دماء سيّئة

51
00:03:25,860 --> 00:03:30,740
!لا أهتمّ إن هرب البقيّة إن نلت منكما

52
00:03:31,240 --> 00:03:32,910
.راقب ما سأفعل

53
00:03:34,240 --> 00:03:35,580
!لوفي

54
00:03:45,460 --> 00:03:49,010
.إنّه الآن يقود البحريّة بأكملها

55
00:03:49,880 --> 00:03:53,550
!هل طاقم قبّعة القشّ في جزيرة إيغهيد؟

56
00:03:54,140 --> 00:03:55,390
!لماذا؟

57
00:03:55,680 --> 00:03:59,940
،حسب تقارير رجالنا
.فإنّهم إلى جانب فيغابانك

58
00:04:01,190 --> 00:04:02,270
!أرأيتم؟

59
00:04:02,690 --> 00:04:06,190
!ها قد تعقدّت الأمور ثانية

60
00:04:06,570 --> 00:04:11,610
يبدو أنّ محاولة نزول سي بي 0 على الجزيرة
.قد فعّلت مهمّة اعتراض معيّنة

61
00:04:14,160 --> 00:04:16,740
.إنّ هذا بمثابة إعلان حرب

62
00:04:17,120 --> 00:04:21,870
أتمنّى لو أنّ أولئك الأشقياء
.أخذوا برأيي أوّلاً

63
00:04:22,830 --> 00:04:26,460
،لنتحدّث الآن عن بورسالينو
.أحد الأميرالات الثّلاثة

64
00:04:27,340 --> 00:04:28,760
.لقبه هو كيزارو، أي القرد الأصفر

65
00:04:28,920 --> 00:04:32,340
.إنّه رجل الضّوء الّذي أكل فاكهة الوميض

66
00:04:32,510 --> 00:04:38,390
لقد أذاق طاقمنا هزيمة نكراء
.في أرخبيل شابوندي قبل سنتين

67
00:04:40,140 --> 00:04:42,810
.واضح أنّه قويّ للغاية

68
00:04:43,350 --> 00:04:45,860
!السّرعة وزن

69
00:04:46,110 --> 00:04:50,030
أسبق ورُكلتَ بسرعة الضّوء؟

70
00:04:54,120 --> 00:04:57,160
...يا صاحب مكافأة الـ120 مليون

71
00:04:57,290 --> 00:04:59,790
...صائد القراصنة زورو

72
00:05:00,290 --> 00:05:01,460
...سُحقًا

73
00:05:02,790 --> 00:05:04,000
أميرال...؟

74
00:05:09,880 --> 00:05:14,180
،إنّه ينفّذ الأوامر من الأعلى دون أيّ تردّد

75
00:05:14,300 --> 00:05:16,850
.ولا يهتمّ لأيّ شيء

76
00:05:18,310 --> 00:05:20,850
هل يمكنني الدّخول؟

77
00:05:21,480 --> 00:05:23,140
...أحضرت هذه الوجبات الخفيفة لك

78
00:05:23,850 --> 00:05:28,940
!هل سبق وقابلت الدّكتور فيغابانك من قبل؟

79
00:05:30,320 --> 00:05:31,400
.نعم

80
00:05:36,620 --> 00:05:39,410
.مرّة واحدة... قبل وقت طويل

81
00:05:40,120 --> 00:05:45,170
.لكنّي لم أتخيّل أبدًا أنّه قد يقوم بخيانتكم

82
00:05:47,670 --> 00:05:52,510
لننتقل الآن إلى إيشّو الّذي أصبح
.أميرالاً بعد حرب القمّة

83
00:05:52,800 --> 00:05:55,050
.لقبه هو فوجيتورا، أي النّمر البنفسجيّ

84
00:05:55,550 --> 00:05:59,720
،بفضل تناوله لفاكهة الجاذبيّة
،وهي من نوع باراميسيا

85
00:05:59,930 --> 00:06:02,980
.صار قادرًا على التّلاعب بالجاذبيّة

86
00:06:03,430 --> 00:06:07,860
.سأرسل هؤلاء إلى الجحيم

87
00:06:10,070 --> 00:06:14,450
.كان عازمًا بشدّة على حلّ نظام الشّيتشيبوكاي

88
00:06:14,610 --> 00:06:18,700
.أُعجب لوفي كثيرًا بالعجوز إيشّو

89
00:06:21,620 --> 00:06:25,960
!ألحق تصرّفك الأنانيّ العار بالعدالة

90
00:06:26,170 --> 00:06:30,630
،إن كنتَ لا تريد أن يلحقها العار
!فأبقها قريبة منك طوال الوقت

91
00:06:30,750 --> 00:06:34,050
،إن خسرنا المصداقيّة باعترافنا بالخطأ فحسب

92
00:06:34,170 --> 00:06:36,680
!فلم تكن لدينا مصداقيّة من الأساس

93
00:06:37,220 --> 00:06:41,060
!عليك تنظيف فوضاك بنفسك يا فوجيتورا

94
00:06:42,140 --> 00:06:46,980
،قبّعة القشّ ولو... إن لم تحضر لي رأسيهما

95
00:06:47,230 --> 00:06:51,480
فلن تستطيع أن تخطو خطوة
!في أيّ من قواعد البحريّة في العالم

96
00:06:52,940 --> 00:06:57,410
!نعم، ذلك بالضّبط ما أريده

97
00:06:58,200 --> 00:07:01,370
.تمّت ترقية أراماكي حديثًا أيضًا

98
00:07:01,490 --> 00:07:03,620
.اسمه ريوكوغيو، أي الثّور الأخضر

99
00:07:03,790 --> 00:07:08,250
إنّه رجل الغابة الّذي أكل فاكهة
.الغابة، وهي من نوع لوغيا

100
00:07:08,370 --> 00:07:12,920
.لقد ظهر في بلاد وانو بينما كنّا هناك

101
00:07:13,090 --> 00:07:18,010
مواجهة أميرال بعد انتهائنا للتّوّ
،من مواجهة كايدو

102
00:07:18,130 --> 00:07:21,470
لا أظنّها كانت لتكون مواجهة
.سهلة حتّى علينا

103
00:07:21,760 --> 00:07:25,770
.لم أعلم حتّى أنّه كانت هنالك مواجهة

104
00:07:25,890 --> 00:07:28,690
!التّنانين السّماويّون هم آلهة هذا العالم

105
00:07:28,900 --> 00:07:32,650
،وفي هذه البلاد الّتي ليست جزءًا من حكومة العالم

106
00:07:32,820 --> 00:07:36,530
!لا تملكون أيّ حقوق ولا حتّى الحقّ لتكونوا أحرارًا

107
00:07:37,610 --> 00:07:40,820
!غابة عضلات الغضب المفتولة

108
00:07:41,070 --> 00:07:45,290
.أكلت فاكهة الغابة، وصرت رجل الغابة

109
00:07:46,120 --> 00:07:49,000
،إلى جانب البحر
!فإنّ الغابة هي مهد الحياة الثّاني

110
00:07:49,960 --> 00:07:52,170
!إنّها لوغيا خالصة

111
00:07:52,750 --> 00:07:57,880
،يمكنني ارتكاب مجزرة هنا
.فلا وجود للقانون هنا

112
00:07:58,300 --> 00:08:02,720
وكلّ من هم ليسوا من الحكومة
.يُعتبر ممّن سيُضحّى بهم

113
00:08:02,890 --> 00:08:07,640
.إنّ افتقاركم للقيمة هو ما يسمح للبقيّة أن يعيشوا

114
00:08:07,790 --> 00:08:10,270
!هناك عزاء في الميز

115
00:08:11,060 --> 00:08:16,650
!إنّه مجنون حقيقيّ، عكس فوجيتورا تمامًا

116
00:08:17,280 --> 00:08:20,700
لننتقل الآن إلى نائب الأميرال
.مونكي د. غارب

117
00:08:20,950 --> 00:08:23,910
.لقبه هو بطل البحريّة

118
00:08:24,080 --> 00:08:26,830
،إنّ قدراته القتالية تتساوى مع الأميرالات

119
00:08:26,990 --> 00:08:30,830
.لكنّه أصرّ على البقاء نائب أميرال فقط

120
00:08:30,960 --> 00:08:36,340
،ما عاد يُقاتل في الجبهات الأماميّة
.ويفضّل تدريب الجيل الصّاعد

121
00:08:36,460 --> 00:08:38,760
.أنا أعرفه! إنّه جدّ لوفي

122
00:08:38,880 --> 00:08:41,380
.إنّه يعيش على هواه، تمامًا مثل لوفي

123
00:08:41,720 --> 00:08:46,350
لديّ بعض الرّفاق الّذين يريدون
.لقاء مونكي د. لوفي

124
00:08:46,850 --> 00:08:47,970
!البحريّة

125
00:08:48,220 --> 00:08:49,560
!استيقظ

126
00:08:54,810 --> 00:08:57,320
...ماذا؟! جـ-جـ-جـ

127
00:08:57,570 --> 00:08:59,030
!جدّي

128
00:09:07,410 --> 00:09:12,580
كما قلت، إن كنت تريد العبور
!فسيكون ذلك على جثّتي

129
00:09:13,620 --> 00:09:17,090
!لا أستطيع يا جدّي! تنحّ عن طريقي

130
00:09:17,250 --> 00:09:20,260
!إلّم تستطع فسيموت إيس

131
00:09:20,380 --> 00:09:21,800
!مستحيل

132
00:09:21,920 --> 00:09:26,600
!لا تسير الأمور كما ترغب دائمًا! لن أرحمك

133
00:09:27,720 --> 00:09:29,600
...لوفي، إنّي أعتبرك

134
00:09:30,680 --> 00:09:34,440
!عدوّي

135
00:09:48,450 --> 00:09:52,370
.لا بدّ أنّ ذلك الوضع كان صعبًا جدًّا على غارب

136
00:09:54,830 --> 00:09:57,460
.ما زال هنالك العديد من الجنود

137
00:09:57,670 --> 00:10:00,500
تمّت ترقية سموكر لنائب أميرال، صحيح؟

138
00:10:03,340 --> 00:10:05,380
!هيّا، لننتقل للشّخص التّالي

139
00:10:05,550 --> 00:10:08,720
إن عرفتم من هو، فبإمكانكم
!الانضمام لقراصنة أوسوبّ

140
00:10:08,850 --> 00:10:10,060
!من هذا؟

141
00:10:25,280 --> 00:10:31,160
لنتحدّث عن أشخاص يشغلون مناصب
.ومن مجموعات خاصّة داخل البحريّة

142
00:10:31,990 --> 00:10:35,210
.إنّه أميرال أسطول سابق، لكنّه متقاعد الآن

143
00:10:35,370 --> 00:10:37,670
.مفتّش البحريّة العامّ سنغوكو

144
00:10:37,880 --> 00:10:43,380
،أكل فاكهة البشر من صنف البوذا
.وهي فاكهة زون خرافيّة

145
00:10:43,550 --> 00:10:46,590
!إذًا فالجواب الصّحيح كان سنغوكو

146
00:10:46,760 --> 00:10:48,510
هل أصبتم التّخمين؟

147
00:10:48,840 --> 00:10:53,890
لا أعتقد أنّ بإمكاننا الخروج
!من هذا بدون نشمّر عن أيدينا

148
00:10:55,230 --> 00:11:00,150
لحماية شعوب العالم المهدّدين
،من قبل الأشرار الهائجين

149
00:11:00,730 --> 00:11:04,610
!من المهمّ لهم أن نكون هنا

150
00:11:07,150 --> 00:11:10,200
!العدالة الّتي تأتي من الإنسانيّة لن تندثر أبدًا

151
00:11:11,160 --> 00:11:15,410
،لا تدّع أنّك تستطيع إغراق هذا المكان بسهولة

152
00:11:15,830 --> 00:11:17,250
!أيّها الصّعلوك

153
00:11:20,290 --> 00:11:23,170
فيغابانك تابع للبحريّة أيضًا، صحيح؟

154
00:11:23,300 --> 00:11:28,300
.نعم. إنّه قائد م ع خ
.المجموعة العلميّة الخاصّة

155
00:11:28,510 --> 00:11:32,220
.إنّه رجل الدّماغ الّذي أكل فاكهة الدّماغ

156
00:11:32,350 --> 00:11:34,810
.أرادت البحريّة أسلحة جديدة

157
00:11:34,970 --> 00:11:40,150
.وكان فيغابانك في حاجة للتّموين
.لذلك كان لديهم اهتمام مشترك

158
00:11:40,600 --> 00:11:42,860
!هذه هي الجزيرة حيث يُصنع المستقبل

159
00:11:43,270 --> 00:11:47,950
،استعملتُ كلّ المنشآت كما أشاء
،وأخذت أموالاً كثيرة من الحكومة للبحث

160
00:11:48,070 --> 00:11:50,740
!وواصلتُ بحوثي كما يحلو لي

161
00:11:50,870 --> 00:11:55,290
حتّى الآن، تتدفّق الأفكار إليّ
!ولا يمكنني إيقافها

162
00:11:57,000 --> 00:11:59,670
!سأغيّر العالم بيديّ هاتين

163
00:12:01,380 --> 00:12:04,590
.سنتومارو هو قائد الوحدة العلميّة

164
00:12:04,750 --> 00:12:10,050
لقد شارك في حرب القمّة في مارينفورد
.وكان يقود الباسيفيستا

165
00:12:10,180 --> 00:12:14,260
.إنّه الآن حارس شخصيّ لفيغابانك في إيغهيد

166
00:12:14,850 --> 00:12:18,770
!بربّك! أنت عار بحقّ يا بي إكس-4

167
00:12:18,900 --> 00:12:20,560
!من أنت بالضّبط يا ذا فأس المعركة؟

168
00:12:20,900 --> 00:12:23,400
!كيف تجرؤ على دعوة النّاس بأسماء أسلحتهم؟

169
00:12:23,560 --> 00:12:27,940
!أنا سنتومارو، الشّخص الأشدّ كتمانًا في العالم

170
00:12:30,740 --> 00:12:34,330
.أيّها العجوز بانك... أعتقد أنّي خائن أيضًا الآن

171
00:12:40,160 --> 00:12:42,330
.لا أرى أيّ ضرر من التّصرّف كذلك إذًا

172
00:12:43,710 --> 00:12:46,630
!تفعيل الباسيفيستا مارك 3

173
00:12:57,140 --> 00:13:00,230
...احرصوا أن يستطيع مبتكركم

174
00:13:00,390 --> 00:13:03,480
!الخروج من الجزيرة بأمان

175
00:13:04,270 --> 00:13:08,900
،وبين صفوف البحريّة
.هنالك فصيل يُدعى سورد

176
00:13:09,150 --> 00:13:12,860
،إنّه يتكوّن من جنود قدّموا استقالاتهم

177
00:13:12,990 --> 00:13:15,160
وخسروا دعم البحريّة

178
00:13:15,280 --> 00:13:19,580
مقابل حرّيّة التّصرّف بدون أوامر
.من كبار الضّبّاط

179
00:13:19,700 --> 00:13:24,250
أي أنّ البحريّة لن تلبّي نداء أيّ أحد من سورد؟

180
00:13:24,380 --> 00:13:28,000
يجب على المرء أن يكون شجاعًا
.جدًّا ليكون جزءًا منه

181
00:13:28,250 --> 00:13:32,330
.قائد سورد هو دييس دريك

182
00:13:32,510 --> 00:13:35,930
!هو؟ لكنّه قرصان من الجيل الأسوأ

183
00:13:36,100 --> 00:13:39,220
كان من التّوبي روبّو التّابعين لقراصنة
،مملكة الحيوان في بلاد وانو

184
00:13:39,350 --> 00:13:42,390
.لكنّه انقلب عليهم وانضمّ إلينا خلال الغارة

185
00:13:43,020 --> 00:13:47,020
باختصار، لقد وضعت البحريّة
.جواسيس بين القراصنة

186
00:13:49,440 --> 00:13:52,360
!ما زال هنالك أمل

187
00:13:52,490 --> 00:13:54,070
!يا قبّعة القشّ لوفي

188
00:13:54,610 --> 00:13:57,320
!أنا أقاتل وحدي لسبب ما

189
00:13:59,280 --> 00:14:00,120
!أرجوك

190
00:14:00,910 --> 00:14:04,040
!دعني أقاتل إلى جانبكم

191
00:14:05,700 --> 00:14:07,060
ماذا؟

192
00:14:07,590 --> 00:14:11,590
.إنّ دريك مفقود في الوقت الحاليّ

193
00:14:12,170 --> 00:14:15,340
.هنالك العديد من الجنود المجانين أيضًا

194
00:14:15,510 --> 00:14:19,890
.برينس غروس، رجل الطّين الّذي أكل فاكهة الطّين

195
00:14:20,060 --> 00:14:24,100
.كوجاكو، امرأة التّأديب الّتي أكلت فاكهة السّوط

196
00:14:24,230 --> 00:14:26,940
.كلاهما لواء بحريّ انضمّا إلى سورد

197
00:14:30,070 --> 00:14:31,480
تدركان ذلك، صحيح؟

198
00:14:32,150 --> 00:14:35,490
،إن خطونا على تلك الجزيرة

199
00:14:36,200 --> 00:14:39,700
فسيأتي خلفنا أسراب من القراصنة
.الغاضبين كالنّحل للنّيل منّا

200
00:14:42,750 --> 00:14:45,210
.لذلك السّبب تُلقّب بخليّة النّحل

201
00:14:45,830 --> 00:14:48,500
.لا يستطيع أحد التّدخّل هناك

202
00:14:48,790 --> 00:14:51,500
!يا إلهي... بالغ كثيرًا

203
00:14:51,670 --> 00:14:54,170
!غارب فتى مشاكس بالفعل

204
00:14:54,590 --> 00:14:58,590
لا أصدّق أنّه وصف كوبي بمستقبل
.البحريّة. سيدفع ثمن ذلك

205
00:14:58,720 --> 00:15:00,800
.سأحرص على تخريب تقدّمه

206
00:15:00,930 --> 00:15:05,350
لا يفترض بك أن تقول شيئًا
!كهذا علنًا أيّها الشّقيّ المدلّل

207
00:15:05,520 --> 00:15:07,100
!كم هذا ظريف

208
00:15:08,650 --> 00:15:11,900
.كوبي صديق للوفي وجزء من سورد أيضًا

209
00:15:12,070 --> 00:15:14,400
.يبدو أنّه ترقّى لمنصب عقيد

210
00:15:14,690 --> 00:15:20,160
لقد أنقذ مواطنين خلال حادثة
.ميناء روكي وصار يُعرف بالبطل اليافع

211
00:15:20,320 --> 00:15:22,330
!صار شخصيّة مشهورة

212
00:15:22,910 --> 00:15:30,080
نجا لوفي في حرب القمّة بفضل
.شجاعة هذا الجنديّ الصّغير

213
00:15:30,790 --> 00:15:33,590
مضى وقتٌ طويل. هل تعرّفتما عليّ؟

214
00:15:35,130 --> 00:15:36,050
من أنت؟

215
00:15:36,470 --> 00:15:38,510
!هذا أنا! كوبي

216
00:15:39,130 --> 00:15:40,840
ألم تتذكّرني؟

217
00:15:41,050 --> 00:15:47,270
.أملك صديقًا يدعى كوبي فعلاً... لكنّه قصير

218
00:15:47,770 --> 00:15:51,770
هذا أنا! كوبي الّذي كان طفلاً
!بكّاءً ولا أمل منه

219
00:15:52,020 --> 00:15:55,230
!ماذا؟! أهذا صحيح؟

220
00:15:55,570 --> 00:15:57,030
أذاك هو كوبي؟

221
00:15:58,530 --> 00:16:03,740
!هانكوك-سان
!لا تنوي البحريّة أن تواجهك

222
00:16:05,910 --> 00:16:11,290
،بعد أن تمّ حلّ نظام الشّيتشيبوكاي
.ذهب للقبض على هانكوك

223
00:16:11,420 --> 00:16:15,420
ولكن لسوء الحظّ، تمّ الإمساك به
.على يد اللّحية السّوداء

224
00:16:15,800 --> 00:16:18,170
.آمل أن يكون بخير

225
00:16:19,130 --> 00:16:22,470
لنتحدّث عن القائدة البحريّة هيباري
.والرّائد البحريّ هيلميبّو

226
00:16:22,640 --> 00:16:25,310
.كلاهما صديقين لكوبي

227
00:16:25,430 --> 00:16:28,020
.يبدو أنّ هيلميبّو يعرف زورو

228
00:16:28,390 --> 00:16:32,100
!أنا ذاك الابن الغبيّ المدلّل

229
00:16:35,320 --> 00:16:36,480
!كان أنت إذًا

230
00:16:36,610 --> 00:16:39,150
!أتوسّل إليكم يا رفاق

231
00:16:39,360 --> 00:16:42,360
!إنّه صديقنا، لنفعل شيئًا ما رجاءً

232
00:16:42,660 --> 00:16:43,820
!أرجوك أيّها الأمير

233
00:16:46,490 --> 00:16:50,080
!أرجوكم! لن تكون لنا فرصة وحدنا

234
00:16:50,210 --> 00:16:52,710
...لا يمكننا أبدًا أن ننقذه

235
00:16:52,830 --> 00:16:53,880
!كوبي-سينباي

236
00:16:57,500 --> 00:16:59,300
!تعال إلى هنا رجاءً

237
00:16:59,420 --> 00:17:02,220
!كلاّ! لم أقصد أيّ شيء غريب بذلك

238
00:17:02,340 --> 00:17:06,180
وأخيرًا، الأميرال السّابق كوزان
.الّذي ترك البحريّة

239
00:17:06,560 --> 00:17:09,060
.لقبه وقتها هو أوكيجي، أي التّدرج الأزرق

240
00:17:09,480 --> 00:17:13,230
إنّه رجل الجليد الّذي أكل فاكهة
.الجليد، وهي من نوع لوغيا

241
00:17:13,350 --> 00:17:17,780
لكنّه الآن قبطان السّفينة العاشرة
.لقراصنة اللّحية السّوداء

242
00:17:18,570 --> 00:17:23,200
،كوزان كسول بطبعه
.لكنّه مرعب إذا ما قرّر القتال

243
00:17:23,360 --> 00:17:29,120
ما كان دافعه للانضمام لأسطول
اللّحية السّوداء يا ترى؟

244
00:17:29,370 --> 00:17:31,620
.عصر الجليد

245
00:17:35,830 --> 00:17:38,590
!تجمّد... الـ-البحر

246
00:17:41,260 --> 00:17:44,760
.هذه قوّة أميرال بحريّة

247
00:17:54,560 --> 00:18:00,820
،بعد الحرب قبل سنتين
.استقال أميرال الأسطول سنغوكو

248
00:18:02,070 --> 00:18:05,570
،في العادة، لا يظهر أوكيجي شغفه

249
00:18:05,700 --> 00:18:10,290
.لكنّه كره فكرة أن يصير أكاينو أميرال الأسطول

250
00:18:11,120 --> 00:18:16,080
فواجها بعضهما وهذا الصّراع الأوّل
...من نوعه بين الأميرالات

251
00:18:16,250 --> 00:18:19,750
.أخذ شكل معركة على جزيرة ما

252
00:18:22,090 --> 00:18:23,920
!فاز أكاينو

253
00:18:24,050 --> 00:18:27,430
.ساكازوكي هو أميرال الأسطول الجديد

254
00:18:27,550 --> 00:18:30,350
لكنّ أوكيجي رفض العمل مع أكاينو

255
00:18:31,350 --> 00:18:33,180
.وغادر البحريّة بعدها

256
00:18:33,310 --> 00:18:35,890
لم يعد جنديًّا في البحريّة إذًا؟

257
00:18:36,020 --> 00:18:37,150
.صحيح

258
00:18:37,600 --> 00:18:39,020
...هل يمكنني

259
00:18:39,480 --> 00:18:41,820
أن أعرف ما الّذي تسعون إليه جميعًا؟

260
00:18:42,070 --> 00:18:45,150
.انقلب كوزان على البحريّة

261
00:18:45,320 --> 00:18:47,990
.إنّهم الآن إخوة سابقون وقد صاروا أعداءً

262
00:18:48,410 --> 00:18:54,250
للبحريّة مشاكل أخرى، وخاصّة
.هذا الجوّ الثّقيل حول العالم الآن

263
00:18:54,540 --> 00:18:57,670
وضعت كروس غيلد تحت قيادة اليونكو باغي

264
00:18:57,830 --> 00:19:00,920
.مكافآت على رؤوس جنود البحريّة

265
00:19:01,090 --> 00:19:06,800
صحيح، وصار المواطنون العاديّون
.يستهدفون البحريّة الآن

266
00:19:07,510 --> 00:19:10,220
،إنّ موت نائب الأميرال تي-بون

267
00:19:10,350 --> 00:19:12,680
،الّذي أحبّه النّاس والبحريّة على حدّ السّواء

268
00:19:12,810 --> 00:19:15,310
.كان صدمة للعالم بأكمله

269
00:19:15,430 --> 00:19:19,480
.ولكن، لم تنشر البحريّة أيّ شيء عن ظروف اختفائه

270
00:19:20,520 --> 00:19:23,070
.الفقر والمال كفيلان بتغيير المرء

271
00:19:23,360 --> 00:19:26,030
.أنا لا أختلق الأعذار لمن قتلوه بالطّبع

272
00:19:27,280 --> 00:19:32,870
أبحر تسعة من نوّاب الأميرالات
.إلى إيغهيد بقيادة كيزارو

273
00:19:32,990 --> 00:19:34,830
ماذا؟ هذا العدد كلّه؟

274
00:19:34,950 --> 00:19:36,660
!فعلاً؟ هذا خطير

275
00:19:38,500 --> 00:19:43,050
في تلك الأثناء، ذهب غارب
.إلى هاتشينوسو لإنقاذ كوبي

276
00:19:43,550 --> 00:19:46,590
.لكنّ كوزان كان بانتظاره هناك

277
00:19:46,720 --> 00:19:49,760
قتال بين بطل البحريّة وأميرال سابق؟

278
00:19:49,930 --> 00:19:52,720
.ما كنت لأتوقّع أن يكون هذا ممكنًا من قبل

279
00:19:54,470 --> 00:19:55,890
!يا كوزان

280
00:19:56,270 --> 00:19:58,190
!حرّر هيباري من جليدك

281
00:19:58,520 --> 00:20:00,350
!دع كوبي يرحل

282
00:20:00,690 --> 00:20:03,230
!وعد إلى البحريّة

283
00:20:05,860 --> 00:20:09,950
لكن أخشى أنّي لا أستطيع منحك
!ما تطلبه منّي يا غارب-سان

284
00:20:13,280 --> 00:20:16,040
،بهدف إنقاذ تلميذك العزيز

285
00:20:16,750 --> 00:20:20,750
فهل أنت مستعدّ لقتل تلميذك الأوّل السّابق؟

286
00:20:22,710 --> 00:20:25,000
.لا تدع هراء الماضي يقيّدك

287
00:20:26,460 --> 00:20:29,680
ألم أعلّمك أنّ عليك
!أن تعيش في الحاضر؟

288
00:20:37,600 --> 00:20:39,690
...التّردّد علامة على

289
00:20:41,600 --> 00:20:42,560
!الضّعف

290
00:20:44,940 --> 00:20:48,190
!الثّقب الأزرق

291
00:20:55,370 --> 00:20:57,330
.سنتوقّف هنا اليوم

292
00:20:57,450 --> 00:21:01,290
،إلى جانب المعارك في إيغهيد
!الفوضى تعمّ هاتشينوسو أيضًا

293
00:21:01,420 --> 00:21:05,880
،بعد رؤية ما تفعله البحريّة
.صار من السّهل فهم وضع العالم

294
00:21:06,040 --> 00:21:09,380
.معك حقّ بالكامل
.لكن دعنا لا نسمح لذلك أن يقلقنا

295
00:21:09,510 --> 00:21:11,680
.نحن طاقم قبّعة القشّ

296
00:21:11,800 --> 00:21:15,800
.أحسنت القول
!ستستمرّ مغامراتنا كالمعتاد فحسب

297
00:21:16,010 --> 00:21:19,600
!لوفي ينادينا، لنعد إلى ساني الآن

298
00:21:19,730 --> 00:21:21,690
.سنودّعكم هنا إذًا

299
00:21:21,810 --> 00:21:24,690
!انتبهوا لصحّتكم! مع السّلامة

300
00:21:24,810 --> 00:21:26,110
!إلى اللّقاء

301
00:21:31,950 --> 00:21:37,700
إلى أيّ مدى هربنا؟

302
00:21:37,700 --> 00:21:45,000
نعدّ النّدوب دون أن نعرف

303
00:21:45,000 --> 00:21:51,920
وفي بالي دائمًا، خريطة كنز

304
00:21:51,920 --> 00:21:58,390
أبحث باستمرار عن المستقبل

305
00:21:58,390 --> 00:22:11,940
توجد الوعود الحقيقيّة عميقًا في القلب

306
00:22:11,940 --> 00:22:21,410
للجميع أحلام لا يستطيع أحد اللّحاق بها

307
00:22:21,410 --> 00:22:27,040
تمسّكوا بذلك الحلم فقط

308
00:22:27,040 --> 00:22:34,170
إليك يا من تبتسم مثل الشّمس

309
00:22:34,170 --> 00:22:41,140
لنغنّ نفس الأغنية مثل ذلك اليوم

310
00:22:41,140 --> 00:22:48,190
حتّى إن كبر بنا العمر، لا أريد أن أنسى

311
00:22:48,190 --> 00:22:55,610
إلى أن تصلك هذه الأمنية

312
00:23:05,370 --> 00:23:08,750
يعاني غارب في مواجهته وحده
.ضدّ القراصنة على الجزيرة

313
00:23:08,890 --> 00:23:11,880
يحاول الهرب من هاتشينوسو
،رفقة كوبي وبقيّة الجنود

314
00:23:12,020 --> 00:23:14,670
.لكنّ كوزان يعترض طريقه

315
00:23:14,880 --> 00:23:17,800
،بينما يسترجعان ذكريات أيّام تدريبهما معًا

316
00:23:17,940 --> 00:23:21,350
تتصادم نسخة كلّ منهما
!عن العدالة في هاتشينوسو

317
00:23:21,620 --> 00:23:22,970
:في الحلقة القادمة من وان بيس

318
00:23:23,110 --> 00:23:26,440
"!غارب وكوزان! صراع عدالتَيْ المعلّم والتّلميذ

319
00:23:26,570 --> 00:23:28,920
!ملك القراصنة، لن يكون إلاّ أنا