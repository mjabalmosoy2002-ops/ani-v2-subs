1
00:00:10,480 --> 00:00:19,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:23,660 --> 00:00:26,500
في نهاية الأحلام، في نهاية البحر

3
00:00:26,500 --> 00:00:29,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:29,000 --> 00:00:32,010
ولكن أوّلاً، علينا صنع

5
00:00:32,010 --> 00:00:36,890
أسطورة لامعة من أنفسنا

6
00:00:36,890 --> 00:00:39,720
شرارات متطايرة من هنا بلا حدود

7
00:00:39,720 --> 00:00:41,350
!وان بيس

8
00:00:41,350 --> 00:00:43,980
سنخبر جميعنا الرّحّالة

9
00:00:43,980 --> 00:00:47,980
هل ما زالت أحلامكم واضحة؟

10
00:00:49,360 --> 00:00:56,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:56,030 --> 00:01:02,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:01:02,500 --> 00:01:05,120
سنخبر جميعنا الرّحّالة

13
00:01:05,120 --> 00:01:08,880
لا توجد قتالات بلا معنى

14
00:01:10,540 --> 00:01:17,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:17,010 --> 00:01:23,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:23,600 --> 00:01:29,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:29,730 --> 00:01:36,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:41,990 --> 00:01:46,870
"!العدالة الّتي لا تلين! السّجلّ الفخريّ للبحريّة"

19
00:01:49,960 --> 00:01:52,000
مرحبًا يا رفاق! كيف الأحوال؟

20
00:01:52,170 --> 00:01:56,050
.هذه أنا ملاّحة طاقم قبّعة القشّ نامي
!سررت بلقائكم

21
00:01:56,170 --> 00:01:58,550
.وأنا ربّان سفينة الطّاقم جينبي

22
00:01:58,680 --> 00:02:01,510
.شكرًا على حضوركم جميعًا

23
00:02:01,640 --> 00:02:04,640
.سنتحدّث اليوم عن البحريّة

24
00:02:04,810 --> 00:02:08,310
.وأنا القنّاص أوسوبّ
.لا حاجة لمشاهدة هذه الحلقة

25
00:02:08,480 --> 00:02:11,940
ماذا هنالك يا أوسوبّ؟ أتعاني خطبًا ما؟

26
00:02:12,060 --> 00:02:13,960
.لقد كنت أخفي شيئًا ما عنكم

27
00:02:14,090 --> 00:02:17,820
أعاني من مرض رؤية مشاهد
.ماضية للبحريّة المميت

28
00:02:17,950 --> 00:02:18,650
!كاذب

29
00:02:18,780 --> 00:02:21,320
أصاب بطفح على جلدي كلّما
!ذُكر هؤلاء البحّارة

30
00:02:21,450 --> 00:02:23,990
لكنّ القراصنة بحّارة أيضًا، صحيح؟

31
00:02:24,160 --> 00:02:27,830
من المحرج قليلاً للقراصنة
،أن يقوموا بتقديم هؤلاء

32
00:02:27,960 --> 00:02:29,960
.لكن علينا معرفة عدوّنا جيّدًا

33
00:02:30,120 --> 00:02:31,460
.هذا صحيح

34
00:02:31,630 --> 00:02:35,130
!معك حقّ. سأبذل ما بوسعي

35
00:02:35,800 --> 00:02:38,340
.أوّلاً، ألقوا نظرة على هذا

36
00:02:38,800 --> 00:02:42,720
.هذا هو المبيان التّنظيميّ للبحريّة

37
00:02:43,510 --> 00:02:46,770
إنّها منظّمة مخصّصة للحفاظ
...على الأمن في البحار

38
00:02:46,890 --> 00:02:50,060
.في جميع بلدان حكومة العالم

39
00:02:50,440 --> 00:02:53,020
،باسم العدالة المطلقة

40
00:02:53,190 --> 00:02:58,360
يعتقلون أساسًا القراصنة
.وبقيّة الخارجين عن القانون

41
00:02:59,320 --> 00:03:02,490
.لنبدأ بالحديث عن أميرال الأسطول

42
00:03:03,370 --> 00:03:07,160
الضّابط الأعلى رتبة بين البحريّة حاليًّا
.وهو أميرال الأسطول ساكازوكي

43
00:03:07,330 --> 00:03:11,000
إنّه رجل الحمم الّذي أكل
.فاكهة الحمم، وهي من نوع لوغيا

44
00:03:11,170 --> 00:03:16,000
كان لا يزال أميرالاً خلال حرب القمّة
.في مارينفورد قبل سنتين

45
00:03:16,670 --> 00:03:20,760
.إنّه الرّجل الّذي قتل إيس-سان

46
00:03:20,880 --> 00:03:24,010
.وتسبّب أيضًا بالنّدبة على صدر لوفي

47
00:03:24,140 --> 00:03:27,060
!لا أصدّق أنّ بإمكانه التّلاعب الحمم

48
00:03:27,640 --> 00:03:31,640
.ملك القراصنة غولد روجر، والثّوريّ دراغون

49
00:03:31,770 --> 00:03:35,940
.ذُهلتُ عندما علمتُ أنّ ابنَيهما أخوان غير شقيقين

50
00:03:36,730 --> 00:03:39,740
.كلاكما تسري في عروقكما دماء سيّئة

51
00:03:39,860 --> 00:03:44,740
!لا أهتمّ إن هرب البقيّة إن نلت منكما

52
00:03:45,240 --> 00:03:46,910
.راقب ما سأفعل

53
00:03:48,240 --> 00:03:49,580
!لوفي

54
00:03:59,460 --> 00:04:03,010
.إنّه الآن يقود البحريّة بأكملها

55
00:04:03,880 --> 00:04:07,550
!هل طاقم قبّعة القشّ في جزيرة إيغهيد؟

56
00:04:08,140 --> 00:04:09,390
!لماذا؟

57
00:04:09,680 --> 00:04:13,940
،حسب تقارير رجالنا
.فإنّهم إلى جانب فيغابانك

58
00:04:15,190 --> 00:04:16,270
!أرأيتم؟

59
00:04:16,690 --> 00:04:20,190
!ها قد تعقدّت الأمور ثانية

60
00:04:20,570 --> 00:04:25,610
يبدو أنّ محاولة نزول سي بي 0 على الجزيرة
.قد فعّلت مهمّة اعتراض معيّنة

61
00:04:28,160 --> 00:04:30,740
.إنّ هذا بمثابة إعلان حرب

62
00:04:31,120 --> 00:04:35,870
أتمنّى لو أنّ أولئك الأشقياء
.أخذوا برأيي أوّلاً

63
00:04:36,830 --> 00:04:40,460
،لنتحدّث الآن عن بورسالينو
.أحد الأميرالات الثّلاثة

64
00:04:41,340 --> 00:04:42,760
.لقبه هو كيزارو، أي القرد الأصفر

65
00:04:42,920 --> 00:04:46,340
.إنّه رجل الضّوء الّذي أكل فاكهة الوميض

66
00:04:46,510 --> 00:04:52,390
لقد أذاق طاقمنا هزيمة نكراء
.في أرخبيل شابوندي قبل سنتين

67
00:04:54,140 --> 00:04:56,810
.واضح أنّه قويّ للغاية

68
00:04:57,350 --> 00:04:59,860
!السّرعة وزن

69
00:05:00,110 --> 00:05:04,030
أسبق ورُكلتَ بسرعة الضّوء؟

70
00:05:08,120 --> 00:05:11,160
...يا صاحب مكافأة الـ120 مليون

71
00:05:11,290 --> 00:05:13,790
...صائد القراصنة زورو

72
00:05:14,290 --> 00:05:15,460
...سُحقًا

73
00:05:16,790 --> 00:05:18,000
أميرال...؟

74
00:05:23,880 --> 00:05:28,180
،إنّه ينفّذ الأوامر من الأعلى دون أيّ تردّد

75
00:05:28,300 --> 00:05:30,850
.ولا يهتمّ لأيّ شيء

76
00:05:32,310 --> 00:05:34,850
هل يمكنني الدّخول؟

77
00:05:35,480 --> 00:05:37,140
...أحضرت هذه الوجبات الخفيفة لك

78
00:05:37,850 --> 00:05:42,940
!هل سبق وقابلت الدّكتور فيغابانك من قبل؟

79
00:05:44,320 --> 00:05:45,400
.نعم

80
00:05:50,620 --> 00:05:53,410
.مرّة واحدة... قبل وقت طويل

81
00:05:54,120 --> 00:05:59,170
.لكنّي لم أتخيّل أبدًا أنّه قد يقوم بخيانتكم

82
00:06:01,670 --> 00:06:06,510
لننتقل الآن إلى إيشّو الّذي أصبح
.أميرالاً بعد حرب القمّة

83
00:06:06,800 --> 00:06:09,050
.لقبه هو فوجيتورا، أي النّمر البنفسجيّ

84
00:06:09,550 --> 00:06:13,720
،بفضل تناوله لفاكهة الجاذبيّة
،وهي من نوع باراميسيا

85
00:06:13,930 --> 00:06:16,980
.صار قادرًا على التّلاعب بالجاذبيّة

86
00:06:17,430 --> 00:06:21,860
.سأرسل هؤلاء إلى الجحيم

87
00:06:24,070 --> 00:06:28,450
.كان عازمًا بشدّة على حلّ نظام الشّيتشيبوكاي

88
00:06:28,610 --> 00:06:32,700
.أُعجب لوفي كثيرًا بالعجوز إيشّو

89
00:06:35,620 --> 00:06:39,960
!ألحق تصرّفك الأنانيّ العار بالعدالة

90
00:06:40,170 --> 00:06:44,630
،إن كنتَ لا تريد أن يلحقها العار
!فأبقها قريبة منك طوال الوقت

91
00:06:44,750 --> 00:06:48,050
،إن خسرنا المصداقيّة باعترافنا بالخطأ فحسب

92
00:06:48,170 --> 00:06:50,680
!فلم تكن لدينا مصداقيّة من الأساس

93
00:06:51,220 --> 00:06:55,060
!عليك تنظيف فوضاك بنفسك يا فوجيتورا

94
00:06:56,140 --> 00:07:00,980
،قبّعة القشّ ولو... إن لم تحضر لي رأسيهما

95
00:07:01,230 --> 00:07:05,480
فلن تستطيع أن تخطو خطوة
!في أيّ من قواعد البحريّة في العالم

96
00:07:06,940 --> 00:07:11,410
!نعم، ذلك بالضّبط ما أريده

97
00:07:12,200 --> 00:07:15,370
.تمّت ترقية أراماكي حديثًا أيضًا

98
00:07:15,490 --> 00:07:17,620
.اسمه ريوكوغيو، أي الثّور الأخضر

99
00:07:17,790 --> 00:07:22,250
إنّه رجل الغابة الّذي أكل فاكهة
.الغابة، وهي من نوع لوغيا

100
00:07:22,370 --> 00:07:26,920
.لقد ظهر في بلاد وانو بينما كنّا هناك

101
00:07:27,090 --> 00:07:32,010
مواجهة أميرال بعد انتهائنا للتّوّ
،من مواجهة كايدو

102
00:07:32,130 --> 00:07:35,470
لا أظنّها كانت لتكون مواجهة
.سهلة حتّى علينا

103
00:07:35,760 --> 00:07:39,770
.لم أعلم حتّى أنّه كانت هنالك مواجهة

104
00:07:39,890 --> 00:07:42,690
!التّنانين السّماويّون هم آلهة هذا العالم

105
00:07:42,900 --> 00:07:46,650
،وفي هذه البلاد الّتي ليست جزءًا من حكومة العالم

106
00:07:46,820 --> 00:07:50,530
!لا تملكون أيّ حقوق ولا حتّى الحقّ لتكونوا أحرارًا

107
00:07:51,610 --> 00:07:54,820
!غابة عضلات الغضب المفتولة

108
00:07:55,070 --> 00:07:59,290
.أكلت فاكهة الغابة، وصرت رجل الغابة

109
00:08:00,120 --> 00:08:03,000
،إلى جانب البحر
!فإنّ الغابة هي مهد الحياة الثّاني

110
00:08:03,960 --> 00:08:06,170
!إنّها لوغيا خالصة

111
00:08:06,750 --> 00:08:11,880
،يمكنني ارتكاب مجزرة هنا
.فلا وجود للقانون هنا

112
00:08:12,300 --> 00:08:16,720
وكلّ من هم ليسوا من الحكومة
.يُعتبر ممّن سيُضحّى بهم

113
00:08:16,890 --> 00:08:21,640
.إنّ افتقاركم للقيمة هو ما يسمح للبقيّة أن يعيشوا

114
00:08:21,790 --> 00:08:24,270
!هناك عزاء في الميز

115
00:08:25,060 --> 00:08:30,650
!إنّه مجنون حقيقيّ، عكس فوجيتورا تمامًا

116
00:08:31,280 --> 00:08:34,700
لننتقل الآن إلى نائب الأميرال
.مونكي د. غارب

117
00:08:34,950 --> 00:08:37,910
.لقبه هو بطل البحريّة

118
00:08:38,080 --> 00:08:40,830
،إنّ قدراته القتالية تتساوى مع الأميرالات

119
00:08:40,990 --> 00:08:44,830
.لكنّه أصرّ على البقاء نائب أميرال فقط

120
00:08:44,960 --> 00:08:50,340
،ما عاد يُقاتل في الجبهات الأماميّة
.ويفضّل تدريب الجيل الصّاعد

121
00:08:50,460 --> 00:08:52,760
.أنا أعرفه! إنّه جدّ لوفي

122
00:08:52,880 --> 00:08:55,380
.إنّه يعيش على هواه، تمامًا مثل لوفي

123
00:08:55,720 --> 00:09:00,350
لديّ بعض الرّفاق الّذين يريدون
.لقاء مونكي د. لوفي

124
00:09:00,850 --> 00:09:01,970
!البحريّة

125
00:09:02,220 --> 00:09:03,560
!استيقظ

126
00:09:08,810 --> 00:09:11,320
...ماذا؟! جـ-جـ-جـ

127
00:09:11,570 --> 00:09:13,030
!جدّي

128
00:09:21,410 --> 00:09:26,580
كما قلت، إن كنت تريد العبور
!فسيكون ذلك على جثّتي

129
00:09:27,620 --> 00:09:31,090
!لا أستطيع يا جدّي! تنحّ عن طريقي

130
00:09:31,250 --> 00:09:34,260
!إلّم تستطع فسيموت إيس

131
00:09:34,380 --> 00:09:35,800
!مستحيل

132
00:09:35,920 --> 00:09:40,600
!لا تسير الأمور كما ترغب دائمًا! لن أرحمك

133
00:09:41,720 --> 00:09:43,600
...لوفي، إنّي أعتبرك

134
00:09:44,680 --> 00:09:48,440
!عدوّي

135
00:10:02,450 --> 00:10:06,370
.لا بدّ أنّ ذلك الوضع كان صعبًا جدًّا على غارب

136
00:10:08,830 --> 00:10:11,460
.ما زال هنالك العديد من الجنود

137
00:10:11,670 --> 00:10:14,500
تمّت ترقية سموكر لنائب أميرال، صحيح؟

138
00:10:17,340 --> 00:10:19,380
!هيّا، لننتقل للشّخص التّالي

139
00:10:19,550 --> 00:10:22,720
إن عرفتم من هو، فبإمكانكم
!الانضمام لقراصنة أوسوبّ

140
00:10:22,850 --> 00:10:24,060
!من هذا؟

141
00:10:39,280 --> 00:10:45,160
لنتحدّث عن أشخاص يشغلون مناصب
.ومن مجموعات خاصّة داخل البحريّة

142
00:10:45,990 --> 00:10:49,210
.إنّه أميرال أسطول سابق، لكنّه متقاعد الآن

143
00:10:49,370 --> 00:10:51,670
.مفتّش البحريّة العامّ سنغوكو

144
00:10:51,880 --> 00:10:57,380
،أكل فاكهة البشر من صنف البوذا
.وهي فاكهة زون خرافيّة

145
00:10:57,550 --> 00:11:00,590
!إذًا فالجواب الصّحيح كان سنغوكو

146
00:11:00,760 --> 00:11:02,510
هل أصبتم التّخمين؟

147
00:11:02,840 --> 00:11:07,890
لا أعتقد أنّ بإمكاننا الخروج
!من هذا بدون نشمّر عن أيدينا

148
00:11:09,230 --> 00:11:14,150
لحماية شعوب العالم المهدّدين
،من قبل الأشرار الهائجين

149
00:11:14,730 --> 00:11:18,610
!من المهمّ لهم أن نكون هنا

150
00:11:21,150 --> 00:11:24,200
!العدالة الّتي تأتي من الإنسانيّة لن تندثر أبدًا

151
00:11:25,160 --> 00:11:29,410
،لا تدّع أنّك تستطيع إغراق هذا المكان بسهولة

152
00:11:29,830 --> 00:11:31,250
!أيّها الصّعلوك

153
00:11:34,290 --> 00:11:37,170
فيغابانك تابع للبحريّة أيضًا، صحيح؟

154
00:11:37,300 --> 00:11:42,300
.نعم. إنّه قائد م ع خ
.المجموعة العلميّة الخاصّة

155
00:11:42,510 --> 00:11:46,220
.إنّه رجل الدّماغ الّذي أكل فاكهة الدّماغ

156
00:11:46,350 --> 00:11:48,810
.أرادت البحريّة أسلحة جديدة

157
00:11:48,970 --> 00:11:54,150
.وكان فيغابانك في حاجة للتّموين
.لذلك كان لديهم اهتمام مشترك

158
00:11:54,600 --> 00:11:56,860
!هذه هي الجزيرة حيث يُصنع المستقبل

159
00:11:57,270 --> 00:12:01,950
،استعملتُ كلّ المنشآت كما أشاء
،وأخذت أموالاً كثيرة من الحكومة للبحث

160
00:12:02,070 --> 00:12:04,740
!وواصلتُ بحوثي كما يحلو لي

161
00:12:04,870 --> 00:12:09,290
حتّى الآن، تتدفّق الأفكار إليّ
!ولا يمكنني إيقافها

162
00:12:11,000 --> 00:12:13,670
!سأغيّر العالم بيديّ هاتين

163
00:12:15,380 --> 00:12:18,590
.سنتومارو هو قائد الوحدة العلميّة

164
00:12:18,750 --> 00:12:24,050
لقد شارك في حرب القمّة في مارينفورد
.وكان يقود الباسيفيستا

165
00:12:24,180 --> 00:12:28,260
.إنّه الآن حارس شخصيّ لفيغابانك في إيغهيد

166
00:12:28,850 --> 00:12:32,770
!بربّك! أنت عار بحقّ يا بي إكس-4

167
00:12:32,900 --> 00:12:34,560
!من أنت بالضّبط يا ذا فأس المعركة؟

168
00:12:34,900 --> 00:12:37,400
!كيف تجرؤ على دعوة النّاس بأسماء أسلحتهم؟

169
00:12:37,560 --> 00:12:41,940
!أنا سنتومارو، الشّخص الأشدّ كتمانًا في العالم

170
00:12:44,740 --> 00:12:48,330
.أيّها العجوز بانك... أعتقد أنّي خائن أيضًا الآن

171
00:12:54,160 --> 00:12:56,330
.لا أرى أيّ ضرر من التّصرّف كذلك إذًا

172
00:12:57,710 --> 00:13:00,630
!تفعيل الباسيفيستا مارك 3

173
00:13:11,140 --> 00:13:14,230
...احرصوا أن يستطيع مبتكركم

174
00:13:14,390 --> 00:13:17,480
!الخروج من الجزيرة بأمان

175
00:13:18,270 --> 00:13:22,900
،وبين صفوف البحريّة
.هنالك فصيل يُدعى سورد

176
00:13:23,150 --> 00:13:26,860
،إنّه يتكوّن من جنود قدّموا استقالاتهم

177
00:13:26,990 --> 00:13:29,160
وخسروا دعم البحريّة

178
00:13:29,280 --> 00:13:33,580
مقابل حرّيّة التّصرّف بدون أوامر
.من كبار الضّبّاط

179
00:13:33,700 --> 00:13:38,250
أي أنّ البحريّة لن تلبّي نداء أيّ أحد من سورد؟

180
00:13:38,380 --> 00:13:42,000
يجب على المرء أن يكون شجاعًا
.جدًّا ليكون جزءًا منه

181
00:13:42,250 --> 00:13:46,330
.قائد سورد هو دييس دريك

182
00:13:46,510 --> 00:13:49,930
!هو؟ لكنّه قرصان من الجيل الأسوأ

183
00:13:50,100 --> 00:13:53,220
كان من التّوبي روبّو التّابعين لقراصنة
،مملكة الحيوان في بلاد وانو

184
00:13:53,350 --> 00:13:56,390
.لكنّه انقلب عليهم وانضمّ إلينا خلال الغارة

185
00:13:57,020 --> 00:14:01,020
باختصار، لقد وضعت البحريّة
.جواسيس بين القراصنة

186
00:14:03,440 --> 00:14:06,360
!ما زال هنالك أمل

187
00:14:06,490 --> 00:14:08,070
!يا قبّعة القشّ لوفي

188
00:14:08,610 --> 00:14:11,320
!أنا أقاتل وحدي لسبب ما

189
00:14:13,280 --> 00:14:14,120
!أرجوك

190
00:14:14,910 --> 00:14:18,040
!دعني أقاتل إلى جانبكم

191
00:14:19,700 --> 00:14:21,060
ماذا؟

192
00:14:21,590 --> 00:14:25,590
.إنّ دريك مفقود في الوقت الحاليّ

193
00:14:26,170 --> 00:14:29,340
.هنالك العديد من الجنود المجانين أيضًا

194
00:14:29,510 --> 00:14:33,890
.برينس غروس، رجل الطّين الّذي أكل فاكهة الطّين

195
00:14:34,060 --> 00:14:38,100
.كوجاكو، امرأة التّأديب الّتي أكلت فاكهة السّوط

196
00:14:38,230 --> 00:14:40,940
.كلاهما لواء بحريّ انضمّا إلى سورد

197
00:14:44,070 --> 00:14:45,480
تدركان ذلك، صحيح؟

198
00:14:46,150 --> 00:14:49,490
،إن خطونا على تلك الجزيرة

199
00:14:50,200 --> 00:14:53,700
فسيأتي خلفنا أسراب من القراصنة
.الغاضبين كالنّحل للنّيل منّا

200
00:14:56,750 --> 00:14:59,210
.لذلك السّبب تُلقّب بخليّة النّحل

201
00:14:59,830 --> 00:15:02,500
.لا يستطيع أحد التّدخّل هناك

202
00:15:02,790 --> 00:15:05,500
!يا إلهي... بالغ كثيرًا

203
00:15:05,670 --> 00:15:08,170
!غارب فتى مشاكس بالفعل

204
00:15:08,590 --> 00:15:12,590
لا أصدّق أنّه وصف كوبي بمستقبل
.البحريّة. سيدفع ثمن ذلك

205
00:15:12,720 --> 00:15:14,800
.سأحرص على تخريب تقدّمه

206
00:15:14,930 --> 00:15:19,350
لا يفترض بك أن تقول شيئًا
!كهذا علنًا أيّها الشّقيّ المدلّل

207
00:15:19,520 --> 00:15:21,100
!كم هذا ظريف

208
00:15:22,650 --> 00:15:25,900
.كوبي صديق للوفي وجزء من سورد أيضًا

209
00:15:26,070 --> 00:15:28,400
.يبدو أنّه ترقّى لمنصب عقيد

210
00:15:28,690 --> 00:15:34,160
لقد أنقذ مواطنين خلال حادثة
.ميناء روكي وصار يُعرف بالبطل اليافع

211
00:15:34,320 --> 00:15:36,330
!صار شخصيّة مشهورة

212
00:15:36,910 --> 00:15:44,080
نجا لوفي في حرب القمّة بفضل
.شجاعة هذا الجنديّ الصّغير

213
00:15:44,790 --> 00:15:47,590
مضى وقتٌ طويل. هل تعرّفتما عليّ؟

214
00:15:49,130 --> 00:15:50,050
من أنت؟

215
00:15:50,470 --> 00:15:52,510
!هذا أنا! كوبي

216
00:15:53,130 --> 00:15:54,840
ألم تتذكّرني؟

217
00:15:55,050 --> 00:16:01,270
.أملك صديقًا يدعى كوبي فعلاً... لكنّه قصير

218
00:16:01,770 --> 00:16:05,770
هذا أنا! كوبي الّذي كان طفلاً
!بكّاءً ولا أمل منه

219
00:16:06,020 --> 00:16:09,230
!ماذا؟! أهذا صحيح؟

220
00:16:09,570 --> 00:16:11,030
أذاك هو كوبي؟

221
00:16:12,530 --> 00:16:17,740
!هانكوك-سان
!لا تنوي البحريّة أن تواجهك

222
00:16:19,910 --> 00:16:25,290
،بعد أن تمّ حلّ نظام الشّيتشيبوكاي
.ذهب للقبض على هانكوك

223
00:16:25,420 --> 00:16:29,420
ولكن لسوء الحظّ، تمّ الإمساك به
.على يد اللّحية السّوداء

224
00:16:29,800 --> 00:16:32,170
.آمل أن يكون بخير

225
00:16:33,130 --> 00:16:36,470
لنتحدّث عن القائدة البحريّة هيباري
.والرّائد البحريّ هيلميبّو

226
00:16:36,640 --> 00:16:39,310
.كلاهما صديقين لكوبي

227
00:16:39,430 --> 00:16:42,020
.يبدو أنّ هيلميبّو يعرف زورو

228
00:16:42,390 --> 00:16:46,100
!أنا ذاك الابن الغبيّ المدلّل

229
00:16:49,320 --> 00:16:50,480
!كان أنت إذًا

230
00:16:50,610 --> 00:16:53,150
!أتوسّل إليكم يا رفاق

231
00:16:53,360 --> 00:16:56,360
!إنّه صديقنا، لنفعل شيئًا ما رجاءً

232
00:16:56,660 --> 00:16:57,820
!أرجوك أيّها الأمير

233
00:17:00,490 --> 00:17:04,080
!أرجوكم! لن تكون لنا فرصة وحدنا

234
00:17:04,210 --> 00:17:06,710
...لا يمكننا أبدًا أن ننقذه

235
00:17:06,830 --> 00:17:07,880
!كوبي-سينباي

236
00:17:11,500 --> 00:17:13,300
!تعال إلى هنا رجاءً

237
00:17:13,420 --> 00:17:16,220
!كلاّ! لم أقصد أيّ شيء غريب بذلك

238
00:17:16,340 --> 00:17:20,180
وأخيرًا، الأميرال السّابق كوزان
.الّذي ترك البحريّة

239
00:17:20,560 --> 00:17:23,060
.لقبه وقتها هو أوكيجي، أي التّدرج الأزرق

240
00:17:23,480 --> 00:17:27,230
إنّه رجل الجليد الّذي أكل فاكهة
.الجليد، وهي من نوع لوغيا

241
00:17:27,350 --> 00:17:31,780
لكنّه الآن قبطان السّفينة العاشرة
.لقراصنة اللّحية السّوداء

242
00:17:32,570 --> 00:17:37,200
،كوزان كسول بطبعه
.لكنّه مرعب إذا ما قرّر القتال

243
00:17:37,360 --> 00:17:43,120
ما كان دافعه للانضمام لأسطول
اللّحية السّوداء يا ترى؟

244
00:17:43,370 --> 00:17:45,620
.عصر الجليد

245
00:17:49,830 --> 00:17:52,590
!تجمّد... الـ-البحر

246
00:17:55,260 --> 00:17:58,760
.هذه قوّة أميرال بحريّة

247
00:18:08,560 --> 00:18:14,820
،بعد الحرب قبل سنتين
.استقال أميرال الأسطول سنغوكو

248
00:18:16,070 --> 00:18:19,570
،في العادة، لا يظهر أوكيجي شغفه

249
00:18:19,700 --> 00:18:24,290
.لكنّه كره فكرة أن يصير أكاينو أميرال الأسطول

250
00:18:25,120 --> 00:18:30,080
فواجها بعضهما وهذا الصّراع الأوّل
...من نوعه بين الأميرالات

251
00:18:30,250 --> 00:18:33,750
.أخذ شكل معركة على جزيرة ما

252
00:18:36,090 --> 00:18:37,920
!فاز أكاينو

253
00:18:38,050 --> 00:18:41,430
.ساكازوكي هو أميرال الأسطول الجديد

254
00:18:41,550 --> 00:18:44,350
لكنّ أوكيجي رفض العمل مع أكاينو

255
00:18:45,350 --> 00:18:47,180
.وغادر البحريّة بعدها

256
00:18:47,310 --> 00:18:49,890
لم يعد جنديًّا في البحريّة إذًا؟

257
00:18:50,020 --> 00:18:51,150
.صحيح

258
00:18:51,600 --> 00:18:53,020
...هل يمكنني

259
00:18:53,480 --> 00:18:55,820
أن أعرف ما الّذي تسعون إليه جميعًا؟

260
00:18:56,070 --> 00:18:59,150
.انقلب كوزان على البحريّة

261
00:18:59,320 --> 00:19:01,990
.إنّهم الآن إخوة سابقون وقد صاروا أعداءً

262
00:19:02,410 --> 00:19:08,250
للبحريّة مشاكل أخرى، وخاصّة
.هذا الجوّ الثّقيل حول العالم الآن

263
00:19:08,540 --> 00:19:11,670
وضعت كروس غيلد تحت قيادة اليونكو باغي

264
00:19:11,830 --> 00:19:14,920
.مكافآت على رؤوس جنود البحريّة

265
00:19:15,090 --> 00:19:20,800
صحيح، وصار المواطنون العاديّون
.يستهدفون البحريّة الآن

266
00:19:21,510 --> 00:19:24,220
،إنّ موت نائب الأميرال تي-بون

267
00:19:24,350 --> 00:19:26,680
،الّذي أحبّه النّاس والبحريّة على حدّ السّواء

268
00:19:26,810 --> 00:19:29,310
.كان صدمة للعالم بأكمله

269
00:19:29,430 --> 00:19:33,480
.ولكن، لم تنشر البحريّة أيّ شيء عن ظروف اختفائه

270
00:19:34,520 --> 00:19:37,070
.الفقر والمال كفيلان بتغيير المرء

271
00:19:37,360 --> 00:19:40,030
.أنا لا أختلق الأعذار لمن قتلوه بالطّبع

272
00:19:41,280 --> 00:19:46,870
أبحر تسعة من نوّاب الأميرالات
.إلى إيغهيد بقيادة كيزارو

273
00:19:46,990 --> 00:19:48,830
ماذا؟ هذا العدد كلّه؟

274
00:19:48,950 --> 00:19:50,660
!فعلاً؟ هذا خطير

275
00:19:52,500 --> 00:19:57,050
في تلك الأثناء، ذهب غارب
.إلى هاتشينوسو لإنقاذ كوبي

276
00:19:57,550 --> 00:20:00,590
.لكنّ كوزان كان بانتظاره هناك

277
00:20:00,720 --> 00:20:03,760
قتال بين بطل البحريّة وأميرال سابق؟

278
00:20:03,930 --> 00:20:06,720
.ما كنت لأتوقّع أن يكون هذا ممكنًا من قبل

279
00:20:08,470 --> 00:20:09,890
!يا كوزان

280
00:20:10,270 --> 00:20:12,190
!حرّر هيباري من جليدك

281
00:20:12,520 --> 00:20:14,350
!دع كوبي يرحل

282
00:20:14,690 --> 00:20:17,230
!وعد إلى البحريّة

283
00:20:19,860 --> 00:20:23,950
لكن أخشى أنّي لا أستطيع منحك
!ما تطلبه منّي يا غارب-سان

284
00:20:27,280 --> 00:20:30,040
،بهدف إنقاذ تلميذك العزيز

285
00:20:30,750 --> 00:20:34,750
فهل أنت مستعدّ لقتل تلميذك الأوّل السّابق؟

286
00:20:36,710 --> 00:20:39,000
.لا تدع هراء الماضي يقيّدك

287
00:20:40,460 --> 00:20:43,680
ألم أعلّمك أنّ عليك
!أن تعيش في الحاضر؟

288
00:20:51,600 --> 00:20:53,690
...التّردّد علامة على

289
00:20:55,600 --> 00:20:56,560
!الضّعف

290
00:20:58,940 --> 00:21:02,190
!الثّقب الأزرق

291
00:21:09,370 --> 00:21:11,330
.سنتوقّف هنا اليوم

292
00:21:11,450 --> 00:21:15,290
،إلى جانب المعارك في إيغهيد
!الفوضى تعمّ هاتشينوسو أيضًا

293
00:21:15,420 --> 00:21:19,880
،بعد رؤية ما تفعله البحريّة
.صار من السّهل فهم وضع العالم

294
00:21:20,040 --> 00:21:23,380
.معك حقّ بالكامل
.لكن دعنا لا نسمح لذلك أن يقلقنا

295
00:21:23,510 --> 00:21:25,680
.نحن طاقم قبّعة القشّ

296
00:21:25,800 --> 00:21:29,800
.أحسنت القول
!ستستمرّ مغامراتنا كالمعتاد فحسب

297
00:21:30,010 --> 00:21:33,600
!لوفي ينادينا، لنعد إلى ساني الآن

298
00:21:33,730 --> 00:21:35,690
.سنودّعكم هنا إذًا

299
00:21:35,810 --> 00:21:38,690
!انتبهوا لصحّتكم! مع السّلامة

300
00:21:38,810 --> 00:21:40,110
!إلى اللّقاء

301
00:21:45,950 --> 00:21:51,700
إلى أيّ مدى هربنا؟

302
00:21:51,700 --> 00:21:59,000
نعدّ النّدوب دون أن نعرف

303
00:21:59,000 --> 00:22:05,920
وفي بالي دائمًا، خريطة كنز

304
00:22:05,920 --> 00:22:12,390
أبحث باستمرار عن المستقبل

305
00:22:12,390 --> 00:22:25,940
توجد الوعود الحقيقيّة عميقًا في القلب

306
00:22:25,940 --> 00:22:35,410
للجميع أحلام لا يستطيع أحد اللّحاق بها

307
00:22:35,410 --> 00:22:41,040
تمسّكوا بذلك الحلم فقط

308
00:22:41,040 --> 00:22:48,170
إليك يا من تبتسم مثل الشّمس

309
00:22:48,170 --> 00:22:55,140
لنغنّ نفس الأغنية مثل ذلك اليوم

310
00:22:55,140 --> 00:23:02,190
حتّى إن كبر بنا العمر، لا أريد أن أنسى

311
00:23:02,190 --> 00:23:09,610
إلى أن تصلك هذه الأمنية

312
00:23:19,370 --> 00:23:22,750
يعاني غارب في مواجهته وحده
.ضدّ القراصنة على الجزيرة

313
00:23:22,890 --> 00:23:25,880
يحاول الهرب من هاتشينوسو
،رفقة كوبي وبقيّة الجنود

314
00:23:26,020 --> 00:23:28,670
.لكنّ كوزان يعترض طريقه

315
00:23:28,880 --> 00:23:31,800
،بينما يسترجعان ذكريات أيّام تدريبهما معًا

316
00:23:31,940 --> 00:23:35,350
تتصادم نسخة كلّ منهما
!عن العدالة في هاتشينوسو

317
00:23:35,620 --> 00:23:36,970
:في الحلقة القادمة من وان بيس

318
00:23:37,110 --> 00:23:40,440
"!غارب وكوزان! صراع عدالتَيْ المعلّم والتّلميذ

319
00:23:40,570 --> 00:23:42,920
!ملك القراصنة، لن يكون إلاّ أنا