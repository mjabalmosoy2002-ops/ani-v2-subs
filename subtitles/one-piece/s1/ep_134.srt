1
00:00:22,120 --> 00:00:25,190
!العالم... نعم

2
00:00:25,720 --> 00:00:27,390
...اسعوا نحو الحرّيّة

3
00:00:27,390 --> 00:00:31,530
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,890 --> 00:00:35,260
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,760 --> 00:00:37,130
!فتجاوزوها

6
00:00:37,530 --> 00:00:40,500
!تحت راية ما تؤمنون به

7
00:00:44,970 --> 00:00:50,580
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,580 --> 00:00:53,810
متّجهًا نحو عالم بلا نهاية

9
00:00:55,220 --> 00:01:00,090
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,090 --> 00:01:08,500
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,500 --> 00:01:14,240
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,240 --> 00:01:18,670
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,670 --> 00:01:24,310
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,310 --> 00:01:28,180
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,180 --> 00:01:33,120
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,120 --> 00:01:40,860
متّجهين نحو الأفق

17
00:01:40,860 --> 00:01:46,370
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,370 --> 00:01:51,070
متّجهًا نحو عالم بلا نهاية

19
00:01:51,070 --> 00:01:56,310
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,310 --> 00:02:02,580
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:11,130 --> 00:02:12,190
.سئمتُ من كلّ هذا

22
00:02:16,260 --> 00:02:19,330
متى سيتوقّف هذا المطر؟

23
00:02:21,400 --> 00:02:25,410
يا أوسوبّ، ألديك أيّ شيء ممتع؟

24
00:02:25,410 --> 00:02:28,310
ماذا؟ لديّ ألعاب ناريّة بإمكاننا
.إطلاقها، لكن واحدة فقط

25
00:02:28,310 --> 00:02:29,240
أتريد إطلاقها؟

26
00:02:29,240 --> 00:02:30,140
!أجل

27
00:02:30,140 --> 00:02:31,610
.لا تفعل ذلك

28
00:02:31,610 --> 00:02:34,080
ماذا إن كانت توجد سفينة
معادية في الجوار أو ما شابه؟

29
00:02:34,580 --> 00:02:35,850
.أعتقد أنّك على حقّ

30
00:02:45,660 --> 00:02:48,430
ما ذلك الكتاب الّذي كنتِ
تقرئينه كلّ هذا الوقت؟

31
00:02:50,870 --> 00:02:53,000
!يُبدي لوفي اهتمامًا بكتاب ما؟

32
00:02:53,000 --> 00:02:54,840
ماذا؟ هل من خطب ما؟

33
00:02:54,840 --> 00:02:56,640
.لا-لا، لا شيء

34
00:02:57,070 --> 00:03:00,680
،"إنّه كتاب يُدعى "رينبو ميست
."أو "ضباب قوس قزح

35
00:03:01,340 --> 00:03:03,540
إنّها رواية مبنيّة عن مغامرات
خاضها شخص ما

36
00:03:03,540 --> 00:03:05,380
.في منطقة غير اعتياديّة من البحر

37
00:03:06,710 --> 00:03:08,920
!مغامرات؟ يبدو هذا ممتعًا

38
00:03:09,050 --> 00:03:10,720
!لا أصدّق

39
00:03:11,250 --> 00:03:13,320
...بغضّ النّظر عن كم يشعر بالملل

40
00:03:13,520 --> 00:03:15,520
.البحر مكان غريب بالفعل

41
00:03:18,930 --> 00:03:20,460
.اسمعوا، لقد رأيتُ جزيرة

42
00:03:20,460 --> 00:03:23,200
!فعلاً؟! مرحى

43
00:03:26,700 --> 00:03:28,340
ما بالكم يا رفاق؟

44
00:03:28,340 --> 00:03:29,770
.لا شيء

45
00:03:33,240 --> 00:03:37,280
سأجعلها تتفتّح! الرّجل أوسوبّ"
".وكرة الثّمانية شاكو

46
00:03:40,780 --> 00:03:41,850
...توقّفت

47
00:03:45,520 --> 00:03:48,160
أصبح بإمكاني الآن، صحيح يا أبي وأمّي؟

48
00:04:04,410 --> 00:04:06,630
!حسنًا، راقب السّفينة جيّدًا

49
00:04:06,630 --> 00:04:08,680
!أكيد، مفهوم

50
00:04:10,310 --> 00:04:12,210
!تعالوا! إنّها بلدة

51
00:04:12,580 --> 00:04:15,120
!مهلاً، انتظرنا يا لوفي

52
00:04:17,890 --> 00:04:19,250
!إنّها بلدة

53
00:04:25,090 --> 00:04:28,330
.إنّها مليئة بالحيويّة وإن كانت صغيرة

54
00:04:30,630 --> 00:04:33,430
بإمكاننا الحصول على بعض
الأشياء من هنا، صحيح؟

55
00:04:34,440 --> 00:04:36,570
أوسوبّ، هل ستقوم بالتّسوّق؟

56
00:04:36,740 --> 00:04:38,210
.سؤال وجيه

57
00:04:38,440 --> 00:04:40,840
!مهلاً يا رفاق، شاهدوا هذا

58
00:04:41,640 --> 00:04:42,710
ما الأمر؟

59
00:04:42,710 --> 00:04:45,350
!لا تقل لي أنّ هنالك ملصقات مطلوبين
!الأمر ليس كذلك، صحيح؟

60
00:04:45,950 --> 00:04:49,880
!إنّه مهرجان ألعاب ناريّة
!والأفضل من ذلك أنّه اليوم

61
00:04:49,880 --> 00:04:50,580
!أجل

62
00:04:50,580 --> 00:04:51,590
!مذهل

63
00:04:51,590 --> 00:04:53,520
!لم أر الألعاب النّاريّة منذ مدّة

64
00:04:53,820 --> 00:04:55,820
.حسنًا يا نامي-سان، سأرافقك

65
00:04:55,820 --> 00:04:58,560
.لا، لا، شكرًا لك. اهتمّ بشؤونك الخاصّة

66
00:04:59,090 --> 00:05:01,460
!الألعاب النّاريّة! لا أطيق الانتظار

67
00:05:02,530 --> 00:05:04,930
.لم أركم هناك من قبل يا جماعة

68
00:05:05,830 --> 00:05:07,440
هل أتيتم لمشاهدة الألعاب النّاريّة؟

69
00:05:07,440 --> 00:05:09,240
—لا، ذلك ليس

70
00:05:09,240 --> 00:05:12,710
لماذا؟ هل هذه الألعاب النّاريّة
مشهورة لهذا الحدّ؟

71
00:05:12,970 --> 00:05:15,710
.نعم. إنّه مهرجان مشهور على هذه الجزيرة

72
00:05:15,710 --> 00:05:18,250
.إنّهم يقيمونه لأزيد من أربعمائة عام

73
00:05:19,380 --> 00:05:21,710
أربعمائة عام؟ كلّ هذا الوقت؟

74
00:05:22,050 --> 00:05:24,540
انظروا. أترون ذلك البرج
على الجبل خلفكم؟

75
00:05:26,590 --> 00:05:29,360
إنّ سكّان ذلك المنزل يصنعون
الألعاب النّاريّة

76
00:05:29,360 --> 00:05:31,390
.لأجيال عدّة منذ أربعمائة سنة

77
00:05:31,690 --> 00:05:35,360
لكن تتألفّ عائلتهم الآن من
.عجوز وفتاة صغيرة فقط

78
00:05:35,360 --> 00:05:39,230
ماذا؟ إذًا هل يصنع العجوز
الألعاب النّاريّة وحده؟

79
00:05:39,470 --> 00:05:43,370
.لا، لا! إنّه يصنعها بمساعدة تلك الفتاة

80
00:05:43,700 --> 00:05:46,740
إنّهما يعملان طوال السّنة
.من أجل هذا اليوم فقط

81
00:05:46,740 --> 00:05:48,110
.ذلك مميّز بالفعل

82
00:05:49,640 --> 00:05:52,480
لماذا يتطلّب الأمر أكثر من سنة
لصناعة ألعاب ناريّة؟

83
00:05:52,480 --> 00:05:54,680
...يا لغبائك! إنّ ذلك

84
00:05:55,850 --> 00:05:57,350
.ثمّة عدّة أسباب

85
00:05:57,350 --> 00:05:59,190
.ما كنتَ لتفهم حتّى إن أخبرتك

86
00:05:59,190 --> 00:06:00,020
.هكذا إذًا

87
00:06:00,020 --> 00:06:01,390
!صحيح

88
00:06:01,390 --> 00:06:03,860
.يبدو أنّ مخزوننا من البارود انتهى

89
00:06:03,860 --> 00:06:05,890
.أتساءل إن كانا سيتشاركان القليل معنا

90
00:06:05,890 --> 00:06:06,830
من يدري؟

91
00:06:06,830 --> 00:06:08,660
!سأعود بعد قليل

92
00:06:09,900 --> 00:06:13,500
ولكن، أتمنّى ألاّ يحدث أيّ شيء
.كما السّنة الماضية

93
00:06:13,500 --> 00:06:15,040
.نعم، معك حقّ

94
00:06:15,440 --> 00:06:17,440
لكن ما الّذي حدث السّنة الماضية؟

95
00:06:17,440 --> 00:06:19,840
،صحيح. في السّنة الماضية
—خلال مهرجان الألعاب النّاريّة

96
00:06:19,840 --> 00:06:23,410
.كادويان! لقد أتوا إلى هنا للاستمتاع بوقتهم

97
00:06:23,410 --> 00:06:26,080
.لا داعي لتتكبّد عناء إخبارهم بذلك

98
00:06:26,380 --> 00:06:27,950
.أظنّك محقًّا

99
00:06:27,950 --> 00:06:30,250
.آسف، إنّه لا شيء. انسوا الأمر

100
00:06:30,990 --> 00:06:34,290
!صحيح! علينا إخبار زورو والبقيّة بهذا

101
00:06:34,290 --> 00:06:37,120
!أجل! لنذهب لإخبار روبين-تشان

102
00:06:37,120 --> 00:06:39,360
.لا، ربّما علينا الأكل أوّلاً

103
00:06:39,360 --> 00:06:40,260
!لماذا ذلك؟

104
00:06:46,870 --> 00:06:50,270
.هكذا هي الألعاب النّاريّة الّتي صنعتُها

105
00:06:50,470 --> 00:06:52,670
،سأريها لهما، وسيُذهلان بها كثيرًا

106
00:06:52,670 --> 00:06:55,480
وسيقولان، "إن كنتَ موهوبًا
،كفاية لصنع شيء مذهل كهذا

107
00:06:55,480 --> 00:06:58,710
"!فرجاءً خذ ما تشاء من البارود بالمجّان

108
00:06:58,710 --> 00:07:00,750
.أتساءل إن كان سيحدث ذلك

109
00:07:03,020 --> 00:07:04,050
!كلاّ

110
00:07:05,990 --> 00:07:08,460
.مهلاً، يا له من وجه غريب

111
00:07:08,460 --> 00:07:10,830
هل أنت فعلاً المسؤول
عن صناعة الألعاب النّاريّة؟

112
00:07:10,830 --> 00:07:12,030
!بالطّبع أنا هو

113
00:07:12,030 --> 00:07:15,260
.أنا الزّعيم أوداما خبير الألعاب النّاريّة

114
00:07:15,460 --> 00:07:19,270
.في تلك الحالة، أنا أتوسّل إليك
بإمكانك التّنازل عن القليل، صحيح؟

115
00:07:19,270 --> 00:07:21,600
لا بدّ أنّ لديك الكثير من البارود، صحيح؟

116
00:07:22,470 --> 00:07:25,770
.لا أملك أيّ بارود لإعطائه لغرّ مثلك

117
00:07:25,770 --> 00:07:28,340
.والآن، غادر رجاءً. مع السّلامة

118
00:07:29,040 --> 00:07:30,140
!مـ-مهلاً لحظة

119
00:07:30,140 --> 00:07:32,910
رجاء قرّر إن كنتُ غرًّا أم لا بعد
!إلقائك لنظرة على هذه

120
00:07:33,110 --> 00:07:34,920
—إنّها ألعاب ناريّة ممتا

121
00:07:36,920 --> 00:07:39,950
!كرة! ضخمة! بيضاء

122
00:07:40,490 --> 00:07:43,320
!من منحك الإذن بالدّخول إلى عقر داري؟

123
00:07:43,320 --> 00:07:46,890
!هل هذه حقيقيّة أيّها العجوز؟
!إنّه مجسّم عجينة ورق، صحيح؟

124
00:07:46,890 --> 00:07:50,260
لمَ قد يتواجد مجسّم عجينة
ورق في منزل صانع ألعاب ناريّة؟

125
00:07:51,630 --> 00:07:52,670
.إنّها حقيقيّة

126
00:07:52,670 --> 00:07:56,070
إذًا، أكنتَ ستقول أنّ ألعابك النّاريّة ممتازة؟

127
00:08:01,680 --> 00:08:03,310
.لا، لا، ليس تمامًا

128
00:08:06,350 --> 00:08:08,120
كرة بقياس 3، صحيح؟

129
00:08:08,120 --> 00:08:09,850
،لم يتمّ لصقها بشكل محكم

130
00:08:09,850 --> 00:08:11,650
.لكنّها في حالة جيّدة بشكل عامّ

131
00:08:12,650 --> 00:08:16,220
لماذا كنت تخفيها؟
.ستكون خسارة ألاّ تنهيها

132
00:08:16,560 --> 00:08:18,830
ماذا؟ من أنتِ؟

133
00:08:18,830 --> 00:08:21,930
.أنا كوداما، حفيدة الجدّ أوداما

134
00:08:22,430 --> 00:08:27,070
ماذا؟ تعنين أنّك الفتاة الّتي تساعد
!العجوز لصناعة الألعاب النّاريّة؟

135
00:08:27,440 --> 00:08:29,100
.نعم، إنّها أنا

136
00:08:29,500 --> 00:08:32,170
لن أسمح لك بالاستخفاف بي
.فقط لأنّني فتاة صغيرة

137
00:08:32,170 --> 00:08:35,740
ما زلت ماهرة جدًّا، وربّما
.أكون بنفس مهارة جدّي

138
00:08:36,810 --> 00:08:38,810
!هذا مؤلم

139
00:08:39,110 --> 00:08:40,850
!لا تتحمّسي كثيرًا

140
00:08:40,850 --> 00:08:43,220
!كان يُفترض بك الاتّصال بفريق الإطلاق

141
00:08:43,450 --> 00:08:46,820
اتّصلت بهم بالفعل! سيكونون هنا
،قريبًا لحمل المتفجّرات

142
00:08:46,820 --> 00:08:49,190
.لذلك فكّرت في إخراجها

143
00:08:49,460 --> 00:08:51,590
،قبل ذلك، عليك تجهيز القذائف

144
00:08:51,590 --> 00:08:53,230
!وتجهيز العربة

145
00:08:53,230 --> 00:08:55,130
!نعم، نعم، فهمت

146
00:08:55,130 --> 00:08:56,830
!أنا أعلم ذلك

147
00:09:00,500 --> 00:09:01,670
ولماذا لا تزال هنا؟

148
00:09:03,070 --> 00:09:05,510
،لا تقف هناك دون حراك
!اذهب وساعدها

149
00:09:05,510 --> 00:09:06,340
لماذا؟

150
00:09:06,340 --> 00:09:08,440
!اذهب فحسب

151
00:09:12,550 --> 00:09:14,020
ما قصّته؟

152
00:09:14,020 --> 00:09:16,520
!أخبرني أن أغادر، ثمّ طلب منّي المساعدة

153
00:09:16,520 --> 00:09:18,050
.أنا أستسلم. سأغادر

154
00:09:18,420 --> 00:09:19,420
!أنت

155
00:09:20,190 --> 00:09:22,720
!أتحاول التّراخي؟ تعال وساعدني

156
00:09:24,060 --> 00:09:25,690
!ماذا؟

157
00:09:25,890 --> 00:09:28,130
لستَ هنا لتصبح متدرّبًا؟

158
00:09:28,430 --> 00:09:30,200
.بالطّبع لا

159
00:09:30,200 --> 00:09:32,970
أتيت لأحصل على بعض البارود
.منكما فحسب

160
00:09:33,170 --> 00:09:34,470
،كنت تحمل ألعابك النّاريّة الخاصّة

161
00:09:34,470 --> 00:09:36,500
لذلك كنتُ واثقة أنّك أردت
.أن تصبح متدرّبًا

162
00:09:36,800 --> 00:09:38,670
.صنعتُها بغرض المتعة فحسب

163
00:09:38,670 --> 00:09:42,010
أكره الاعتراف بهذا، ولكن لستُ
.أهلاً لأعمل بشكل محترف عليها

164
00:09:42,280 --> 00:09:45,950
.نعم... لكنّك قمتَ بعمل جيّد بالفعل

165
00:09:45,950 --> 00:09:47,950
.عليك أن تسرع وتنهيها

166
00:09:49,250 --> 00:09:51,950
بالتّفكير في الأمر، قلتِ نفس
.الشّيء قبل قليل أيضًا

167
00:09:51,950 --> 00:09:53,390
ماذا تقصدين؟

168
00:09:53,390 --> 00:09:55,920
.ظننتُ أنّني أنهيتها سلفًا

169
00:09:56,920 --> 00:10:00,700
تصبح الألعاب النّاريّة منتهية بالفعل
عندما تتفجّر بشكل جميل

170
00:10:00,700 --> 00:10:02,230
.في سماء اللّيل

171
00:10:02,530 --> 00:10:06,700
لذلك تُعتبر كلّ الألعاب النّاريّة
.في المخزن بضاعة غير منتهية

172
00:10:08,470 --> 00:10:10,600
.وقاذفات الإطلاق هذه أيضًا

173
00:10:10,600 --> 00:10:13,710
.لا تُعتبر منتهية حتّى تُستعمل كمعدّات

174
00:10:13,710 --> 00:10:16,060
.ثمّة شيء مذهل حيالك

175
00:10:16,540 --> 00:10:20,350
.كما أخبرتك. لن أسمح لك بالاستخفاف بي

176
