1
00:00:08,120 --> 00:00:11,190
!العالم... نعم

2
00:00:11,720 --> 00:00:13,390
...اسعوا نحو الحرّيّة

3
00:00:13,390 --> 00:00:17,530
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,890 --> 00:00:21,260
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,760 --> 00:00:23,130
!فتجاوزوها

6
00:00:23,530 --> 00:00:26,500
!تحت راية ما تؤمنون به

7
00:00:30,970 --> 00:00:36,580
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,580 --> 00:00:39,810
متّجهًا نحو عالم بلا نهاية

9
00:00:41,220 --> 00:00:46,090
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,090 --> 00:00:54,500
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,500 --> 00:01:00,240
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,240 --> 00:01:04,670
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,670 --> 00:01:10,310
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,310 --> 00:01:14,180
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,180 --> 00:01:19,120
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,120 --> 00:01:26,860
متّجهين نحو الأفق

17
00:01:26,860 --> 00:01:32,370
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,370 --> 00:01:37,070
متّجهًا نحو عالم بلا نهاية

19
00:01:37,070 --> 00:01:42,310
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,310 --> 00:01:48,580
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:57,130 --> 00:01:58,190
.سئمتُ من كلّ هذا

22
00:02:02,260 --> 00:02:05,330
متى سيتوقّف هذا المطر؟

23
00:02:07,400 --> 00:02:11,410
يا أوسوبّ، ألديك أيّ شيء ممتع؟

24
00:02:11,410 --> 00:02:14,310
ماذا؟ لديّ ألعاب ناريّة بإمكاننا
.إطلاقها، لكن واحدة فقط

25
00:02:14,310 --> 00:02:15,240
أتريد إطلاقها؟

26
00:02:15,240 --> 00:02:16,140
!أجل

27
00:02:16,140 --> 00:02:17,610
.لا تفعل ذلك

28
00:02:17,610 --> 00:02:20,080
ماذا إن كانت توجد سفينة
معادية في الجوار أو ما شابه؟

29
00:02:20,580 --> 00:02:21,850
.أعتقد أنّك على حقّ

30
00:02:31,660 --> 00:02:34,430
ما ذلك الكتاب الّذي كنتِ
تقرئينه كلّ هذا الوقت؟

31
00:02:36,870 --> 00:02:39,000
!يُبدي لوفي اهتمامًا بكتاب ما؟

32
00:02:39,000 --> 00:02:40,840
ماذا؟ هل من خطب ما؟

33
00:02:40,840 --> 00:02:42,640
.لا-لا، لا شيء

34
00:02:43,070 --> 00:02:46,680
،"إنّه كتاب يُدعى "رينبو ميست
."أو "ضباب قوس قزح

35
00:02:47,340 --> 00:02:49,540
إنّها رواية مبنيّة عن مغامرات
خاضها شخص ما

36
00:02:49,540 --> 00:02:51,380
.في منطقة غير اعتياديّة من البحر

37
00:02:52,710 --> 00:02:54,920
!مغامرات؟ يبدو هذا ممتعًا

38
00:02:55,050 --> 00:02:56,720
!لا أصدّق

39
00:02:57,250 --> 00:02:59,320
...بغضّ النّظر عن كم يشعر بالملل

40
00:02:59,520 --> 00:03:01,520
.البحر مكان غريب بالفعل

41
00:03:04,930 --> 00:03:06,460
.اسمعوا، لقد رأيتُ جزيرة

42
00:03:06,460 --> 00:03:09,200
!فعلاً؟! مرحى

43
00:03:12,700 --> 00:03:14,340
ما بالكم يا رفاق؟

44
00:03:14,340 --> 00:03:15,770
.لا شيء

45
00:03:19,240 --> 00:03:23,280
سأجعلها تتفتّح! الرّجل أوسوبّ"
".وكرة الثّمانية شاكو

46
00:03:26,780 --> 00:03:27,850
...توقّفت

47
00:03:31,520 --> 00:03:34,160
أصبح بإمكاني الآن، صحيح يا أبي وأمّي؟

48
00:03:50,410 --> 00:03:52,630
!حسنًا، راقب السّفينة جيّدًا

49
00:03:52,630 --> 00:03:54,680
!أكيد، مفهوم

50
00:03:56,310 --> 00:03:58,210
!تعالوا! إنّها بلدة

51
00:03:58,580 --> 00:04:01,120
!مهلاً، انتظرنا يا لوفي

52
00:04:03,890 --> 00:04:05,250
!إنّها بلدة

53
00:04:11,090 --> 00:04:14,330
.إنّها مليئة بالحيويّة وإن كانت صغيرة

54
00:04:16,630 --> 00:04:19,430
بإمكاننا الحصول على بعض
الأشياء من هنا، صحيح؟

55
00:04:20,440 --> 00:04:22,570
أوسوبّ، هل ستقوم بالتّسوّق؟

56
00:04:22,740 --> 00:04:24,210
.سؤال وجيه

57
00:04:24,440 --> 00:04:26,840
!مهلاً يا رفاق، شاهدوا هذا

58
00:04:27,640 --> 00:04:28,710
ما الأمر؟

59
00:04:28,710 --> 00:04:31,350
!لا تقل لي أنّ هنالك ملصقات مطلوبين
!الأمر ليس كذلك، صحيح؟

60
00:04:31,950 --> 00:04:35,880
!إنّه مهرجان ألعاب ناريّة
!والأفضل من ذلك أنّه اليوم

61
00:04:35,880 --> 00:04:36,580
!أجل

62
00:04:36,580 --> 00:04:37,590
!مذهل

63
00:04:37,590 --> 00:04:39,520
!لم أر الألعاب النّاريّة منذ مدّة

64
00:04:39,820 --> 00:04:41,820
.حسنًا يا نامي-سان، سأرافقك

65
00:04:41,820 --> 00:04:44,560
.لا، لا، شكرًا لك. اهتمّ بشؤونك الخاصّة

66
00:04:45,090 --> 00:04:47,460
!الألعاب النّاريّة! لا أطيق الانتظار

67
00:04:48,530 --> 00:04:50,930
.لم أركم هناك من قبل يا جماعة

68
00:04:51,830 --> 00:04:53,440
هل أتيتم لمشاهدة الألعاب النّاريّة؟

69
00:04:53,440 --> 00:04:55,240
—لا، ذلك ليس

70
00:04:55,240 --> 00:04:58,710
لماذا؟ هل هذه الألعاب النّاريّة
مشهورة لهذا الحدّ؟

71
00:04:58,970 --> 00:05:01,710
.نعم. إنّه مهرجان مشهور على هذه الجزيرة

72
00:05:01,710 --> 00:05:04,250
.إنّهم يقيمونه لأزيد من أربعمائة عام

73
00:05:05,380 --> 00:05:07,710
أربعمائة عام؟ كلّ هذا الوقت؟

74
00:05:08,050 --> 00:05:10,540
انظروا. أترون ذلك البرج
على الجبل خلفكم؟

75
00:05:12,590 --> 00:05:15,360
إنّ سكّان ذلك المنزل يصنعون
الألعاب النّاريّة

76
00:05:15,360 --> 00:05:17,390
.لأجيال عدّة منذ أربعمائة سنة

77
00:05:17,690 --> 00:05:21,360
لكن تتألفّ عائلتهم الآن من
.عجوز وفتاة صغيرة فقط

78
00:05:21,360 --> 00:05:25,230
ماذا؟ إذًا هل يصنع العجوز
الألعاب النّاريّة وحده؟

79
00:05:25,470 --> 00:05:29,370
.لا، لا! إنّه يصنعها بمساعدة تلك الفتاة

80
00:05:29,700 --> 00:05:32,740
إنّهما يعملان طوال السّنة
.من أجل هذا اليوم فقط

81
00:05:32,740 --> 00:05:34,110
.ذلك مميّز بالفعل

82
00:05:35,640 --> 00:05:38,480
لماذا يتطلّب الأمر أكثر من سنة
لصناعة ألعاب ناريّة؟

83
00:05:38,480 --> 00:05:40,680
...يا لغبائك! إنّ ذلك

84
00:05:41,850 --> 00:05:43,350
.ثمّة عدّة أسباب

85
00:05:43,350 --> 00:05:45,190
.ما كنتَ لتفهم حتّى إن أخبرتك

86
00:05:45,190 --> 00:05:46,020
.هكذا إذًا

87
00:05:46,020 --> 00:05:47,390
!صحيح

88
00:05:47,390 --> 00:05:49,860
.يبدو أنّ مخزوننا من البارود انتهى

89
00:05:49,860 --> 00:05:51,890
.أتساءل إن كانا سيتشاركان القليل معنا

90
00:05:51,890 --> 00:05:52,830
من يدري؟

91
00:05:52,830 --> 00:05:54,660
!سأعود بعد قليل

92
00:05:55,900 --> 00:05:59,500
ولكن، أتمنّى ألاّ يحدث أيّ شيء
.كما السّنة الماضية

93
00:05:59,500 --> 00:06:01,040
.نعم، معك حقّ

94
00:06:01,440 --> 00:06:03,440
لكن ما الّذي حدث السّنة الماضية؟

95
00:06:03,440 --> 00:06:05,840
،صحيح. في السّنة الماضية
—خلال مهرجان الألعاب النّاريّة

96
00:06:05,840 --> 00:06:09,410
.كادويان! لقد أتوا إلى هنا للاستمتاع بوقتهم

97
00:06:09,410 --> 00:06:12,080
.لا داعي لتتكبّد عناء إخبارهم بذلك

98
00:06:12,380 --> 00:06:13,950
.أظنّك محقًّا

99
00:06:13,950 --> 00:06:16,250
.آسف، إنّه لا شيء. انسوا الأمر

100
00:06:16,990 --> 00:06:20,290
!صحيح! علينا إخبار زورو والبقيّة بهذا

101
00:06:20,290 --> 00:06:23,120
!أجل! لنذهب لإخبار روبين-تشان

102
00:06:23,120 --> 00:06:25,360
.لا، ربّما علينا الأكل أوّلاً

103
00:06:25,360 --> 00:06:26,260
!لماذا ذلك؟

104
00:06:32,870 --> 00:06:36,270
.هكذا هي الألعاب النّاريّة الّتي صنعتُها

105
00:06:36,470 --> 00:06:38,670
،سأريها لهما، وسيُذهلان بها كثيرًا

106
00:06:38,670 --> 00:06:41,480
وسيقولان، "إن كنتَ موهوبًا
،كفاية لصنع شيء مذهل كهذا

107
00:06:41,480 --> 00:06:44,710
"!فرجاءً خذ ما تشاء من البارود بالمجّان

108
00:06:44,710 --> 00:06:46,750
.أتساءل إن كان سيحدث ذلك

109
00:06:49,020 --> 00:06:50,050
!كلاّ

110
00:06:51,990 --> 00:06:54,460
.مهلاً، يا له من وجه غريب

111
00:06:54,460 --> 00:06:56,830
هل أنت فعلاً المسؤول
عن صناعة الألعاب النّاريّة؟

112
00:06:56,830 --> 00:06:58,030
!بالطّبع أنا هو

113
00:06:58,030 --> 00:07:01,260
.أنا الزّعيم أوداما خبير الألعاب النّاريّة

114
00:07:01,460 --> 00:07:05,270
.في تلك الحالة، أنا أتوسّل إليك
بإمكانك التّنازل عن القليل، صحيح؟

115
00:07:05,270 --> 00:07:07,600
لا بدّ أنّ لديك الكثير من البارود، صحيح؟

116
00:07:08,470 --> 00:07:11,770
.لا أملك أيّ بارود لإعطائه لغرّ مثلك

117
00:07:11,770 --> 00:07:14,340
.والآن، غادر رجاءً. مع السّلامة

118
00:07:15,040 --> 00:07:16,140
!مـ-مهلاً لحظة

119
00:07:16,140 --> 00:07:18,910
رجاء قرّر إن كنتُ غرًّا أم لا بعد
!إلقائك لنظرة على هذه

120
00:07:19,110 --> 00:07:20,920
—إنّها ألعاب ناريّة ممتا

121
00:07:22,920 --> 00:07:25,950
!كرة! ضخمة! بيضاء

122
00:07:26,490 --> 00:07:29,320
!من منحك الإذن بالدّخول إلى عقر داري؟

123
00:07:29,320 --> 00:07:32,890
!هل هذه حقيقيّة أيّها العجوز؟
!إنّه مجسّم عجينة ورق، صحيح؟

124
00:07:32,890 --> 00:07:36,260
لمَ قد يتواجد مجسّم عجينة
ورق في منزل صانع ألعاب ناريّة؟

125
00:07:37,630 --> 00:07:38,670
.إنّها حقيقيّة

126
00:07:38,670 --> 00:07:42,070
إذًا، أكنتَ ستقول أنّ ألعابك النّاريّة ممتازة؟

127
00:07:47,680 --> 00:07:49,310
.لا، لا، ليس تمامًا

128
00:07:52,350 --> 00:07:54,120
كرة بقياس 3، صحيح؟

129
00:07:54,120 --> 00:07:55,850
،لم يتمّ لصقها بشكل محكم

130
00:07:55,850 --> 00:07:57,650
.لكنّها في حالة جيّدة بشكل عامّ

131
00:07:58,650 --> 00:08:02,220
لماذا كنت تخفيها؟
.ستكون خسارة ألاّ تنهيها

132
00:08:02,560 --> 00:08:04,830
ماذا؟ من أنتِ؟

133
00:08:04,830 --> 00:08:07,930
.أنا كوداما، حفيدة الجدّ أوداما

134
00:08:08,430 --> 00:08:13,070
ماذا؟ تعنين أنّك الفتاة الّتي تساعد
!العجوز لصناعة الألعاب النّاريّة؟

135
00:08:13,440 --> 00:08:15,100
.نعم، إنّها أنا

136
00:08:15,500 --> 00:08:18,170
لن أسمح لك بالاستخفاف بي
.فقط لأنّني فتاة صغيرة

137
00:08:18,170 --> 00:08:21,740
ما زلت ماهرة جدًّا، وربّما
.أكون بنفس مهارة جدّي

138
00:08:22,810 --> 00:08:24,810
!هذا مؤلم

139
00:08:25,110 --> 00:08:26,850
!لا تتحمّسي كثيرًا

140
00:08:26,850 --> 00:08:29,220
!كان يُفترض بك الاتّصال بفريق الإطلاق

141
00:08:29,450 --> 00:08:32,820
اتّصلت بهم بالفعل! سيكونون هنا
،قريبًا لحمل المتفجّرات

142
00:08:32,820 --> 00:08:35,190
.لذلك فكّرت في إخراجها

143
00:08:35,460 --> 00:08:37,590
،قبل ذلك، عليك تجهيز القذائف

144
00:08:37,590 --> 00:08:39,230
!وتجهيز العربة

145
00:08:39,230 --> 00:08:41,130
!نعم، نعم، فهمت

146
00:08:41,130 --> 00:08:42,830
!أنا أعلم ذلك

147
00:08:46,500 --> 00:08:47,670
ولماذا لا تزال هنا؟

148
00:08:49,070 --> 00:08:51,510
،لا تقف هناك دون حراك
!اذهب وساعدها

149
00:08:51,510 --> 00:08:52,340
لماذا؟

150
00:08:52,340 --> 00:08:54,440
!اذهب فحسب

151
00:08:58,550 --> 00:09:00,020
ما قصّته؟

152
00:09:00,020 --> 00:09:02,520
!أخبرني أن أغادر، ثمّ طلب منّي المساعدة

153
00:09:02,520 --> 00:09:04,050
.أنا أستسلم. سأغادر

154
00:09:04,420 --> 00:09:05,420
!أنت

155
00:09:06,190 --> 00:09:08,720
!أتحاول التّراخي؟ تعال وساعدني

156
00:09:10,060 --> 00:09:11,690
!ماذا؟

157
00:09:11,890 --> 00:09:14,130
لستَ هنا لتصبح متدرّبًا؟

158
00:09:14,430 --> 00:09:16,200
.بالطّبع لا

159
00:09:16,200 --> 00:09:18,970
أتيت لأحصل على بعض البارود
.منكما فحسب

160
00:09:19,170 --> 00:09:20,470
،كنت تحمل ألعابك النّاريّة الخاصّة

161
00:09:20,470 --> 00:09:22,500
لذلك كنتُ واثقة أنّك أردت
.أن تصبح متدرّبًا

162
00:09:22,800 --> 00:09:24,670
.صنعتُها بغرض المتعة فحسب

163
00:09:24,670 --> 00:09:28,010
أكره الاعتراف بهذا، ولكن لستُ
.أهلاً لأعمل بشكل محترف عليها

164
00:09:28,280 --> 00:09:31,950
.نعم... لكنّك قمتَ بعمل جيّد بالفعل

165
00:09:31,950 --> 00:09:33,950
.عليك أن تسرع وتنهيها

166
00:09:35,250 --> 00:09:37,950
بالتّفكير في الأمر، قلتِ نفس
.الشّيء قبل قليل أيضًا

167
00:09:37,950 --> 00:09:39,390
ماذا تقصدين؟

168
00:09:39,390 --> 00:09:41,920
.ظننتُ أنّني أنهيتها سلفًا

169
00:09:42,920 --> 00:09:46,700
تصبح الألعاب النّاريّة منتهية بالفعل
عندما تتفجّر بشكل جميل

170
00:09:46,700 --> 00:09:48,230
.في سماء اللّيل

171
00:09:48,530 --> 00:09:52,700
لذلك تُعتبر كلّ الألعاب النّاريّة
.في المخزن بضاعة غير منتهية

172
00:09:54,470 --> 00:09:56,600
.وقاذفات الإطلاق هذه أيضًا

173
00:09:56,600 --> 00:09:59,710
.لا تُعتبر منتهية حتّى تُستعمل كمعدّات

174
00:09:59,710 --> 00:10:02,060
.ثمّة شيء مذهل حيالك

175
00:10:02,540 --> 00:10:06,350
.كما أخبرتك. لن أسمح لك بالاستخفاف بي

176
