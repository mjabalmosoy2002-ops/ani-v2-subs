1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:44,630 --> 00:01:49,430
فلنلوّنها بألواننا الخاصّة

19
00:01:57,940 --> 00:02:02,050
،بينما يقاتلون أودن المزيّف الّذي أنشأه كانجورو

20
00:02:02,050 --> 00:02:04,780
.أدرك أعضاء الأكازايا دافعه

21
00:02:04,780 --> 00:02:10,540
...إنّه يسعى خلف... مومونوسكي-ساما

22
00:02:10,540 --> 00:02:14,700
.ليس من المحبّب مطاردة رجل يحتضر

23
00:02:19,560 --> 00:02:24,610
أشعل أودن المزيّف فتيل متفجّرات
...كان يخفيها تحت ملابسه

24
00:02:24,610 --> 00:02:26,970
!وسدّ طريق الأكازايا

25
00:02:29,720 --> 00:02:32,470
!اللّعنة عليك! ابتعد عنّي

26
00:02:35,560 --> 00:02:40,900
!لا تلطّخ اسم كوزكي أودن أكثر

27
00:02:48,040 --> 00:02:51,950
!نيكو! رايزو! واصلوا فحسب يا رفاق

28
00:02:54,050 --> 00:02:57,910
هل ستتولّى أمري وحدك يا ملك النّهار؟

29
00:02:58,300 --> 00:03:03,130
بقيت هنا في الخلف ليس لأنّني
...أردت تسوية أمر ضغينة قديمة

30
00:03:03,560 --> 00:03:08,700
!بل لم أرد لأيّ أحد أن يتأذّى بإطلاق العنان لك

31
00:03:08,700 --> 00:03:09,760
!جاك

32
00:03:14,700 --> 00:03:17,720
.على كلانا الاستعداد لأسوأ الاحتمالات

33
00:03:18,270 --> 00:03:20,480
!ثمّة هجوم ضخم قادم نحونا

34
00:03:20,480 --> 00:03:22,310
!سيادة البحر

35
00:03:26,420 --> 00:03:29,860
!ابتعدوا يا رفاق

36
00:03:40,930 --> 00:03:43,630
زورو-يا، أما زلتَ حيًّا؟

37
00:03:43,630 --> 00:03:48,090
.أبليتَ حسنًا لصدّ ذلك ولو لوهلة... شكرًا لك

38
00:03:48,090 --> 00:03:49,800
أين هو قبّعة القشّ؟

39
00:03:55,110 --> 00:03:57,390
!كايدو

40
00:04:05,070 --> 00:04:07,400
...فاكهة المطّاط

41
00:04:07,740 --> 00:04:08,650
...أحمر

42
00:04:12,340 --> 00:04:14,830
!تفاديتَ هجومي يا كايدو

43
00:04:14,830 --> 00:04:16,870
!لا بدّ لأنّه مؤلم

44
00:04:28,190 --> 00:04:32,340
!النّاشئون الخارقون يردّون الهجوم"
"!مهمّة تفريق اليونكو

45
00:04:44,270 --> 00:04:46,420
!أجل! احترقوا

46
00:04:46,420 --> 00:04:49,320
!احترقوا أكثر

47
00:04:51,450 --> 00:04:53,710
!سُحقًا! إنّها لا تُخمد إطلاقًا

48
00:04:53,710 --> 00:04:56,530
!لماذا تُلقى علينا المشاكل من كلّ جانب؟

49
00:04:56,530 --> 00:05:01,840
فوكوروكوجو! تعرف أين يخزّنون
أطنانًا من المتفجّرات، صحيح؟

50
00:05:01,840 --> 00:05:04,170
.نعم، سأدلّك إليها

51
00:05:04,170 --> 00:05:09,010
.فأنا أعرف كلّ شبر من هذه القلعة

52
00:05:09,010 --> 00:05:11,300
!هذا ما أتوقّعه من أتباعي الشّينوبي

53
00:05:11,300 --> 00:05:15,030
!هذه ليست النّهاية أيّها القراصنة الأوغاد

54
00:05:15,030 --> 00:05:17,180
!ابكوا! نوحوا

55
00:05:17,180 --> 00:05:19,560
!اهربوا والفزع يتملّككم

56
00:05:19,560 --> 00:05:24,810
!سأحرق الجزيرة بالكامل وأقتل كلّ من عليها

57
00:05:33,630 --> 00:05:35,940
!تحيط بنا النّيران! ماذا حدث؟

58
00:05:38,870 --> 00:05:40,980
!أنا من يقتل الآخرين

59
00:05:40,980 --> 00:05:43,980
!أنا حاكم بلاد وانو

60
00:05:43,980 --> 00:05:47,250
!أنا أقتلهم! أنا أقتلهم! أنا أقتلهم

61
00:05:47,250 --> 00:05:51,480
!الموت لك يا كايدو
!سُحقًا لمشروع أونيغاشيما الجديدة

62
00:05:51,480 --> 00:05:52,540
!أوروتشي

63
00:05:52,840 --> 00:05:55,270
!هذا من صنيعك إذًا

64
00:05:55,270 --> 00:05:59,930
!ها أنتم أولاء يا أوغاد الأكازايا شبهِ الأشباح

65
00:06:01,890 --> 00:06:03,500
...أوروتشي-ساما

66
00:06:03,500 --> 00:06:06,730
.لا يعرفون أنّك متّ مرّة من قبل

67
00:06:07,330 --> 00:06:08,610
!فوكوروكوجو

68
00:06:08,610 --> 00:06:11,440
.اهرب رجاءً. دعني أتولّى أمرهم

69
00:06:11,440 --> 00:06:13,570
!ابتعد أيّها المغفّل

70
00:06:14,920 --> 00:06:19,010
!تغطّيكم الجروح والكدمات... لا عجب في ذلك

71
00:06:19,010 --> 00:06:22,520
!أتيتم للقاء حتفكم طوعًا

72
00:06:22,520 --> 00:06:26,080
!لا بدّ أنّكم فقدتم رشدكم

73
00:06:26,080 --> 00:06:28,420
!ما الّذي تريدونه؟

74
00:06:28,420 --> 00:06:32,170
،صمدت بلا عناء طوال عشرين سنة

75
00:06:32,170 --> 00:06:34,510
!وتبعتموني حتّى هنا

76
00:06:34,510 --> 00:06:38,340
!هل تكرهونني لتلك الدّرجة؟ أتمقتونني؟

77
00:06:38,340 --> 00:06:41,680
!هل تريدون التّخلّص منّي لهذا الحدّ؟

78
00:06:42,820 --> 00:06:46,930
!سُحقًا لكم ولكايدو وللجميع

79
00:06:48,120 --> 00:06:51,480
.لولاك لما مات أودن-ساما

80
00:06:53,960 --> 00:06:58,710
لكن لا وقت لدينا للخوض
.في هرائك الغبيّ هذا بعد الآن

81
00:06:58,710 --> 00:07:02,170
.ثمّة أمر واحد فقط نتطلّع للقيام به

82
00:07:02,170 --> 00:07:04,580
!بلاد وانو الّتي حلم بها أودن-ساما

83
00:07:04,580 --> 00:07:08,290
!ولتحقيق ذلك، سنطيح بكايدو والبقيّة

84
00:07:08,290 --> 00:07:12,090
!أتعقدون أيّها الحمقى أنّكم تدافعون عن بلاد وانو؟

85
00:07:12,090 --> 00:07:14,460
.نعم، ذلك صحيح

86
00:07:16,900 --> 00:07:18,930
.اسمعوا يا رفاق

87
00:07:18,930 --> 00:07:21,110
هل تحبّون هذه البلاد؟

88
00:07:21,110 --> 00:07:23,810
.نعم، نحبّ هذه البلاد

89
00:07:23,810 --> 00:07:26,850
هل سترثون إرادتي بالفعل؟

90
00:07:26,850 --> 00:07:28,320
.بالطّبع

91
00:07:28,320 --> 00:07:29,980
!جيّد، جيّد

92
00:07:29,980 --> 00:07:31,110
أودن-ساما؟

93
00:07:31,110 --> 00:07:34,030
.لا مجال في المساومة على ذلك

94
00:07:34,030 --> 00:07:35,400
ماذا؟

95
00:07:36,710 --> 00:07:42,120
،عندما يحاول المرء حماية شيء ما
...يتطلّب ذلك الكثير من العزيمة

96
00:07:42,120 --> 00:07:45,410
.للعيش بدون المساومة على معتقداتنا

97
00:07:46,380 --> 00:07:51,710
التزموا بما تؤمنوا به مهما مرّ من وقت

98
00:07:52,140 --> 00:07:53,460
.ولا تتخلّوا عنه أبدًا

99
00:07:54,220 --> 00:07:57,630
.تبدو هذه وكأنّها كلماتك الأخيرة وهذا يخيفني

100
00:07:57,630 --> 00:07:59,300
فعلاً؟

101
00:08:05,560 --> 00:08:07,680
!انتظر رجاءً يا أودن-ساما

102
00:08:33,930 --> 00:08:38,380
.ذلك ما أخبرَنا به أودن-ساما

103
00:08:39,840 --> 00:08:43,920
.أوروتشي! لا وقت لدينا لأحمق مثلك
!ابتعد عن طريقنا

104
00:08:44,230 --> 00:08:46,100
وماذا إن رفضت؟

105
00:08:46,100 --> 00:08:46,740
!ماذا؟

106
00:08:46,740 --> 00:08:50,810
.لا أصدّق أنّكم تقدّرون كلمات غبيّة لرجل ميت

107
00:08:50,810 --> 00:08:54,640
!أنا فعلاً لا أحبّ أي جزء منكم

108
00:08:55,080 --> 00:08:56,920
...اسمعوا، إنّني

109
00:08:56,920 --> 00:09:01,480
!أريد قطع أعناقكم بشدّة

110
00:09:05,840 --> 00:09:09,620
!أروني ما لديكم... سأقاتلكم ها هنا

111
00:09:25,010 --> 00:09:28,410
!أتعرفون مع من تعبثون؟

112
00:09:28,410 --> 00:09:30,830
!عليكم التزام حدودكم

113
00:09:30,830 --> 00:09:34,020
!أنا شوغن بلاد وانو

114
00:09:36,150 --> 00:09:40,650
!ما هذا التّصرّف؟! لم أرتكب أيّ خطأ

115
00:09:41,900 --> 00:09:45,680
كلّ ما فعلت هو الانتقام
!من عشيرة كوزكي كما يستحقّون

116
00:09:45,680 --> 00:09:48,780
!استعدت ما كان يفترض أن يكون لي لا غير

117
00:09:57,000 --> 00:09:59,650
!لكنّكم لا تفهمون أيّها الأغبياء

118
00:09:59,650 --> 00:10:04,200
يفترض بالمواطنين والسّاموراي الانحناء
!للشّوغن خاصّتهم واتّباع أمره

119
00:10:04,200 --> 00:10:06,470
!أنا رجل سلطة

120
00:10:08,510 --> 00:10:10,140
!شوركن الزّهور

121
00:10:12,360 --> 00:10:16,810
!هذه البلاد الّتي قمعتني هي المُلامة

122
00:10:23,780 --> 00:10:25,570
!تـ-تلك النّظرة

123
00:10:30,090 --> 00:10:33,450
!هل تحاول القول أنّني على خطأ؟

124
00:10:33,790 --> 00:10:35,140
...لا تنظر إليّ

125
00:10:35,140 --> 00:10:37,450
!لا تنظر إليّ

126
00:10:38,100 --> 00:10:40,620
!لستُ مخطئًا

127
00:10:41,810 --> 00:10:45,550
!كفّ عن النّظر إليّ هكذا

128
00:11:00,310 --> 00:11:01,600
!أوروتشي-ساما

129
00:11:02,160 --> 00:11:05,570
!سأترك أمر عقابك للجحيم! هيّا بنا

130
00:11:08,700 --> 00:11:11,150
هل ستنتقم لسيّدك؟

131
00:11:11,840 --> 00:11:13,910
!علا رأيي فيك يا فوكوروكوجو

132
00:11:13,910 --> 00:11:17,830
،رغم أنّه كان مجرّد مغفّل
.إلاّ أنّك بقيت وفيًّا له حتّى النّهاية

133
00:11:17,830 --> 00:11:20,810
!بإمكاني قول نفس الشّيء عنكم

134
00:11:20,810 --> 00:11:25,280
،حتّى إن لم يكن لديّ هدف الانتقام
!قُدّر لنا أنا وأنت أن نتقاتل

135
00:11:25,280 --> 00:11:27,350
!هل تعرف ما أعنيه يا رايزو؟

136
00:11:27,350 --> 00:11:28,460
!نعم

137
00:12:14,030 --> 00:12:16,140
!هل سيدمّران القلعة بأكملها؟

138
00:12:35,800 --> 00:12:38,800
!إنّه صدام قويّ... أكان كايدو؟

139
00:12:38,800 --> 00:12:40,540
!ربّما هذا ضدّ لوفي-دونو؟

140
00:12:40,540 --> 00:12:41,580
!لا داعي للقلق

141
00:12:42,890 --> 00:12:45,000
!أنا واثق أنّهم سيكونون بخير

142
00:12:45,470 --> 00:12:46,460
...فضلاً عن ذلك

143
00:12:47,670 --> 00:12:50,000
.قطعنا وعدًا

144
00:12:54,480 --> 00:12:57,310
!لا وقت لدينا لنضيّعه

145
00:12:57,310 --> 00:12:59,970
!نعم! لنسرع

146
00:13:03,370 --> 00:13:04,810
...لوفي-دونو

147
00:13:29,460 --> 00:13:31,380
!هذا لا يكفي أبدًا

148
00:13:31,810 --> 00:13:35,570
!ألا يمكنكم جعل الأمر أكثر إثارة؟

149
00:13:35,570 --> 00:13:38,220
!إلى حدّ الشّعور بالخوف

150
00:13:38,990 --> 00:13:40,000
!أجيبوني

151
00:13:40,000 --> 00:13:43,210
ألن يكون من الرّائع أن تتسبّبوا لي
...بندبة لا تزول

152
00:13:43,210 --> 00:13:45,600
!أو تخيفونني بما يكفي حتّى أشعر بالقشعريرة؟

153
00:13:45,870 --> 00:13:49,200
!لأنّكم ستموتون قريبًا

154
00:13:49,200 --> 00:13:50,230
!أيّها الوغد القذر

155
00:13:50,230 --> 00:13:55,820
!سأسلبكم كلّ شيء! لم تنس ذلك، صحيح؟

156
00:13:57,740 --> 00:14:03,890
بدأت أشعر وكأنّني بحاجة لقطع
.أعناق هؤلاء عاجلاً أيضًا

157
00:14:03,890 --> 00:14:07,540
.لننه أمرهم بالهجوم التّالي يا كايدو

158
00:14:07,540 --> 00:14:09,710
.نعم، لنقتلهم

159
00:14:10,590 --> 00:14:14,550
!اللّهو برويّة ليس طريقة جيّدة للاستمتاع

160
00:14:14,810 --> 00:14:17,480
!تتطلّب الحياة الانضباط

161
00:14:17,480 --> 00:14:20,140
!كفّ عن التفوّه بهذا الهراء

162
00:14:25,160 --> 00:14:27,230
!لا يمكنك إنهاء المعركة من تلقاء نفسك

163
00:14:28,830 --> 00:14:29,770
!ماذا؟

164
00:14:30,900 --> 00:14:33,130
!لن تفوزا

165
00:14:33,130 --> 00:14:35,860
!سنريكما مقدار عزيمتنا

166
00:14:36,130 --> 00:14:37,690
!يا كايدو

167
00:14:59,110 --> 00:15:00,880
عزيمتكم؟

168
00:15:01,390 --> 00:15:04,470
ما الغاية من شيء كهذا؟

169
00:15:11,410 --> 00:15:13,900
!لا تغامر بالكثير يا قبّعة القشّ

170
00:15:16,210 --> 00:15:19,860
!سأقطع أعناقكم كما أردتم

171
00:15:21,840 --> 00:15:22,700
!انتبهوا

172
00:15:31,630 --> 00:15:32,540
!لوفي

173
00:15:32,540 --> 00:15:34,330
!انتبهوا أكثر

174
00:15:36,800 --> 00:15:38,720
!لن أسمح لكم بالفرار

175
00:15:45,100 --> 00:15:46,180
!السّتارة الصّادّة للجراثيم

176
00:15:53,480 --> 00:15:55,020
!ما رأيكم بهذا؟

177
00:16:03,580 --> 00:16:04,910
!تورا-أو

178
00:16:13,500 --> 00:16:14,840
!اختفوا

179
00:16:35,820 --> 00:16:40,730
!سئمت سماع كلمات مثل العزيمة والإصرار

180
00:16:41,170 --> 00:16:46,490
!هذه كلمات جوفاء ولا تأثير لها على العالم

181
00:16:47,300 --> 00:16:52,370
!سيموت الضّعفاء دون ترك أيّ شيء خلفهم

182
00:16:53,140 --> 00:16:55,170
وماذا في ذلك؟

183
00:16:56,480 --> 00:16:59,290
...هل يمكنك حمل

184
00:17:00,650 --> 00:17:03,380
!بلاد وانو على ظهرك؟

185
00:17:09,910 --> 00:17:14,190
!ثمّة أمر عليّ القيام به

186
00:17:14,190 --> 00:17:16,290
!لا تتظاهر بالقوّة يا ولد

187
00:17:16,290 --> 00:17:21,320
ما دمتُ هنا، لا يمكنك فعل ما
!يحلو لك في عالم البحار هذا

188
00:17:21,750 --> 00:17:26,910
،إنّكم تحاولون حماية شيء ما
.لكنّ كلّ ذلك الجهد ذهب سدى

189
00:17:27,210 --> 00:17:29,260
!بسببي أنا

190
00:17:29,260 --> 00:17:30,330
!مهلاً يا هذا

191
00:17:31,260 --> 00:17:34,790
،إن كنت ستدعو قبطاننا إلى الجحيم

192
00:17:34,790 --> 00:17:37,460
!فسآتي أنا أيضًا

193
00:17:38,850 --> 00:17:44,410
لا يمكنك تحمّل البقاء وحدك؟
..."حتّى الشّجرة الميتة لها فائدة للجبل"

194
00:17:44,410 --> 00:17:49,100
هل أثّر عليك أولئك السّاموراي وفقدت عقلك؟

195
00:17:49,100 --> 00:17:54,170
إن كان ذلك النوع من التّضحية بالذّات
،"هو ما تسمّيه "بالصّداقة

196
00:17:54,170 --> 00:17:57,690
!إذًا فهو أمر وضيع لتفتخر به

197
00:17:57,690 --> 00:17:59,270
!قل ما يحلو لك

198
00:18:00,120 --> 00:18:02,420
.دعني أخبرك بأمر واحد

199
00:18:02,420 --> 00:18:09,120
تلك ليست طريقة حياة أو روحًا نبيلة
!أو ما إلى ذلك ليتشرّف بها المرء

200
00:18:09,120 --> 00:18:11,450
!ستموت هباءً لا غير

201
00:18:11,450 --> 00:18:14,410
ذلك الغبيّ، ما الّذي يفكّر فيه؟

202
00:18:16,510 --> 00:18:20,210
،قم بشيء جدير لإنهاء حياتك على الأقلّ

203
00:18:20,210 --> 00:18:23,040
!ودعني أمتّع ناظريّ به

204
00:18:58,510 --> 00:19:01,400
!ثمّة أمر عليّ القيام به

205
00:19:01,400 --> 00:19:03,150
...وهو يا كايدو

206
00:19:03,150 --> 00:19:06,880
!إيساعك ضربًا ومواصلة تقدّمي

207
00:19:11,610 --> 00:19:14,350
.آسف... لا سبب يدعوك للموت الآن

208
00:19:15,740 --> 00:19:17,310
!كنتُ مدركًا لذلك طوال الوقت

209
00:19:17,310 --> 00:19:20,370
!تبًّا! لا تجعل جماعتك تستولي على كلّ شيء

210
00:19:20,370 --> 00:19:22,730
!كيف يمكنك التّقدّم للأمام بدوننا؟

211
00:19:25,240 --> 00:19:27,230
!على أيّ حال، سأشقّ طريقي

212
00:19:38,750 --> 00:19:39,500
!هيّا بنا

213
00:19:40,260 --> 00:19:42,210
!لا تستخفّ بي يا ولد

214
00:20:06,820 --> 00:20:08,440
!لن أسمح لك

215
00:20:11,590 --> 00:20:13,570
!لا يهمّ إن هاجمتم جميعًا دفعة واحدة

216
00:20:23,090 --> 00:20:24,590
!هاجم

217
00:20:24,590 --> 00:20:25,790
!وغد قذر

218
00:20:27,140 --> 00:20:27,960
!شكرًا

219
00:20:34,220 --> 00:20:35,840
!كايدو

220
00:20:53,780 --> 00:20:55,530
...غازي العوالم الثّلاثة

221
00:21:00,370 --> 00:21:01,910
!راغناراكو

222
00:21:15,390 --> 00:21:16,340
!لوفي

223
00:21:17,110 --> 00:21:19,350
!لننه أمر البقيّة أيضًا

224
00:21:23,480 --> 00:21:24,600
!تمّ الأمر

225
00:21:24,600 --> 00:21:25,150
!حسنًا

226
00:21:25,150 --> 00:21:26,110
!غرفة

227
00:21:26,980 --> 00:21:27,810
!خلط

228
00:21:30,000 --> 00:21:32,280
!أين أنا؟! المكان مظلم

229
00:21:32,880 --> 00:21:33,660
!زوس

230
00:21:33,660 --> 00:21:35,650
!أيمكنك فعلها يا رورونوا؟

231
00:21:36,420 --> 00:21:38,780
!لا خيار أمامي

232
00:21:43,670 --> 00:21:45,580
!لن أسمح لك بالعودة إليها

233
00:21:46,250 --> 00:21:49,420
!اللّهب الفاصل: مفترق طرق المسارات السّتّة

234
00:21:52,010 --> 00:21:55,410
!توقّف! أنا مجرّد سيف

235
00:21:55,410 --> 00:21:58,260
!ماما، النّجدة

236
00:21:58,260 --> 00:21:59,350
!يا رفاق

237
00:21:59,350 --> 00:22:00,140
!هذه فرصتنا

238
00:22:00,140 --> 00:22:02,020
!المسدّسات المغناطيسيّة

239
00:22:04,200 --> 00:22:05,900
!ما هذا؟

240
00:22:05,900 --> 00:22:10,770
!هل اعتقدتم أنّ بإمكانكم هزيمتي إن فرّقتمونا؟

241
00:22:19,490 --> 00:22:20,200
!تنافر

242
00:22:23,120 --> 00:22:23,830
!عصا الإيقاع

243
00:22:27,430 --> 00:22:31,000
!مغفّل! لا يمكنك هزيمتي بضربي بصخرة

244
00:22:39,140 --> 00:22:40,390
!سُحقًا

245
00:22:46,310 --> 00:22:47,520
!ماما

246
00:22:47,520 --> 00:22:50,690
،إن لم تستطع الحصول على المساعدة
!فستنسحب من المعركة

247
00:22:53,290 --> 00:22:54,770
!كيف هذا؟

248
00:23:04,510 --> 00:23:10,000
حتّى بعد إبعاد بيغ مام، ما زال النّاشئون
!يقاتلون في معركة استنزاف شرسة

249
00:23:10,000 --> 00:23:15,010
،يحاول كايدو مهاجمة لوفي الهاوي
.ويتجهّز زورو ليضرب وهو محاصر

250
00:23:15,010 --> 00:23:19,260
كما أسورا، فإنّ السّيف الشّهير إنما يفعّل
!تقنية أسلوب السّيوف التّسعة السّرّيّة

251
00:23:19,260 --> 00:23:22,050
!وها هو يخاطر بمصيره على حركة واحدة

252
00:23:22,510 --> 00:23:26,480
:في الحلقة القادمة من وان بيس
"!الدّفاع عن لوفي! تقنية سيف زورو ولو"

253
00:23:26,480 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا