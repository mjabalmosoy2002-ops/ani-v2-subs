1
00:00:10,480 --> 00:00:17,660
مدّ يدك واقطع الرّياح

2
00:00:17,660 --> 00:00:22,330
ارسم خريطتك الخاصّة

3
00:00:26,920 --> 00:00:33,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:33,590 --> 00:00:40,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:40,060 --> 00:00:46,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:46,350 --> 00:00:49,730
لا يمكن لأحد الجزم بذلك

7
00:00:49,730 --> 00:00:56,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:56,240 --> 00:01:03,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:01:03,200 --> 00:01:09,840
مدّ يدك واقطع الرّياح

10
00:01:09,840 --> 00:01:14,510
اركل الظّلمة بعيدًا

11
00:01:15,510 --> 00:01:22,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:22,720 --> 00:01:26,600
وأنا جاهز لذلك

13
00:01:26,600 --> 00:01:32,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:32,360 --> 00:01:39,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:39,070 --> 00:01:45,790
مدّ يدك واقطع الرّياح

16
00:01:45,790 --> 00:01:51,420
اركل الظّلمة بعيدًا

17
00:01:51,420 --> 00:01:58,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:58,630 --> 00:02:03,430
فلنلوّنها بألواننا الخاصّة

19
00:02:11,940 --> 00:02:16,050
،بينما يقاتلون أودن المزيّف الّذي أنشأه كانجورو

20
00:02:16,050 --> 00:02:18,780
.أدرك أعضاء الأكازايا دافعه

21
00:02:18,780 --> 00:02:24,540
...إنّه يسعى خلف... مومونوسكي-ساما

22
00:02:24,540 --> 00:02:28,700
.ليس من المحبّب مطاردة رجل يحتضر

23
00:02:33,560 --> 00:02:38,610
أشعل أودن المزيّف فتيل متفجّرات
...كان يخفيها تحت ملابسه

24
00:02:38,610 --> 00:02:40,970
!وسدّ طريق الأكازايا

25
00:02:43,720 --> 00:02:46,470
!اللّعنة عليك! ابتعد عنّي

26
00:02:49,560 --> 00:02:54,900
!لا تلطّخ اسم كوزكي أودن أكثر

27
00:03:02,040 --> 00:03:05,950
!نيكو! رايزو! واصلوا فحسب يا رفاق

28
00:03:08,050 --> 00:03:11,910
هل ستتولّى أمري وحدك يا ملك النّهار؟

29
00:03:12,300 --> 00:03:17,130
بقيت هنا في الخلف ليس لأنّني
...أردت تسوية أمر ضغينة قديمة

30
00:03:17,560 --> 00:03:22,700
!بل لم أرد لأيّ أحد أن يتأذّى بإطلاق العنان لك

31
00:03:22,700 --> 00:03:23,760
!جاك

32
00:03:28,700 --> 00:03:31,720
.على كلانا الاستعداد لأسوأ الاحتمالات

33
00:03:32,270 --> 00:03:34,480
!ثمّة هجوم ضخم قادم نحونا

34
00:03:34,480 --> 00:03:36,310
!سيادة البحر

35
00:03:40,420 --> 00:03:43,860
!ابتعدوا يا رفاق

36
00:03:54,930 --> 00:03:57,630
زورو-يا، أما زلتَ حيًّا؟

37
00:03:57,630 --> 00:04:02,090
.أبليتَ حسنًا لصدّ ذلك ولو لوهلة... شكرًا لك

38
00:04:02,090 --> 00:04:03,800
أين هو قبّعة القشّ؟

39
00:04:09,110 --> 00:04:11,390
!كايدو

40
00:04:19,070 --> 00:04:21,400
...فاكهة المطّاط

41
00:04:21,740 --> 00:04:22,650
...أحمر

42
00:04:26,340 --> 00:04:28,830
!تفاديتَ هجومي يا كايدو

43
00:04:28,830 --> 00:04:30,870
!لا بدّ لأنّه مؤلم

44
00:04:42,190 --> 00:04:46,340
!النّاشئون الخارقون يردّون الهجوم"
"!مهمّة تفريق اليونكو

45
00:04:58,270 --> 00:05:00,420
!أجل! احترقوا

46
00:05:00,420 --> 00:05:03,320
!احترقوا أكثر

47
00:05:05,450 --> 00:05:07,710
!سُحقًا! إنّها لا تُخمد إطلاقًا

48
00:05:07,710 --> 00:05:10,530
!لماذا تُلقى علينا المشاكل من كلّ جانب؟

49
00:05:10,530 --> 00:05:15,840
فوكوروكوجو! تعرف أين يخزّنون
أطنانًا من المتفجّرات، صحيح؟

50
00:05:15,840 --> 00:05:18,170
.نعم، سأدلّك إليها

51
00:05:18,170 --> 00:05:23,010
.فأنا أعرف كلّ شبر من هذه القلعة

52
00:05:23,010 --> 00:05:25,300
!هذا ما أتوقّعه من أتباعي الشّينوبي

53
00:05:25,300 --> 00:05:29,030
!هذه ليست النّهاية أيّها القراصنة الأوغاد

54
00:05:29,030 --> 00:05:31,180
!ابكوا! نوحوا

55
00:05:31,180 --> 00:05:33,560
!اهربوا والفزع يتملّككم

56
00:05:33,560 --> 00:05:38,810
!سأحرق الجزيرة بالكامل وأقتل كلّ من عليها

57
00:05:47,630 --> 00:05:49,940
!تحيط بنا النّيران! ماذا حدث؟

58
00:05:52,870 --> 00:05:54,980
!أنا من يقتل الآخرين

59
00:05:54,980 --> 00:05:57,980
!أنا حاكم بلاد وانو

60
00:05:57,980 --> 00:06:01,250
!أنا أقتلهم! أنا أقتلهم! أنا أقتلهم

61
00:06:01,250 --> 00:06:05,480
!الموت لك يا كايدو
!سُحقًا لمشروع أونيغاشيما الجديدة

62
00:06:05,480 --> 00:06:06,540
!أوروتشي

63
00:06:06,840 --> 00:06:09,270
!هذا من صنيعك إذًا

64
00:06:09,270 --> 00:06:13,930
!ها أنتم أولاء يا أوغاد الأكازايا شبهِ الأشباح

65
00:06:15,890 --> 00:06:17,500
...أوروتشي-ساما

66
00:06:17,500 --> 00:06:20,730
.لا يعرفون أنّك متّ مرّة من قبل

67
00:06:21,330 --> 00:06:22,610
!فوكوروكوجو

68
00:06:22,610 --> 00:06:25,440
.اهرب رجاءً. دعني أتولّى أمرهم

69
00:06:25,440 --> 00:06:27,570
!ابتعد أيّها المغفّل

70
00:06:28,920 --> 00:06:33,010
!تغطّيكم الجروح والكدمات... لا عجب في ذلك

71
00:06:33,010 --> 00:06:36,520
!أتيتم للقاء حتفكم طوعًا

72
00:06:36,520 --> 00:06:40,080
!لا بدّ أنّكم فقدتم رشدكم

73
00:06:40,080 --> 00:06:42,420
!ما الّذي تريدونه؟

74
00:06:42,420 --> 00:06:46,170
،صمدت بلا عناء طوال عشرين سنة

75
00:06:46,170 --> 00:06:48,510
!وتبعتموني حتّى هنا

76
00:06:48,510 --> 00:06:52,340
!هل تكرهونني لتلك الدّرجة؟ أتمقتونني؟

77
00:06:52,340 --> 00:06:55,680
!هل تريدون التّخلّص منّي لهذا الحدّ؟

78
00:06:56,820 --> 00:07:00,930
!سُحقًا لكم ولكايدو وللجميع

79
00:07:02,120 --> 00:07:05,480
.لولاك لما مات أودن-ساما

80
00:07:07,960 --> 00:07:12,710
لكن لا وقت لدينا للخوض
.في هرائك الغبيّ هذا بعد الآن

81
00:07:12,710 --> 00:07:16,170
.ثمّة أمر واحد فقط نتطلّع للقيام به

82
00:07:16,170 --> 00:07:18,580
!بلاد وانو الّتي حلم بها أودن-ساما

83
00:07:18,580 --> 00:07:22,290
!ولتحقيق ذلك، سنطيح بكايدو والبقيّة

84
00:07:22,290 --> 00:07:26,090
!أتعقدون أيّها الحمقى أنّكم تدافعون عن بلاد وانو؟

85
00:07:26,090 --> 00:07:28,460
.نعم، ذلك صحيح

86
00:07:30,900 --> 00:07:32,930
.اسمعوا يا رفاق

87
00:07:32,930 --> 00:07:35,110
هل تحبّون هذه البلاد؟

88
00:07:35,110 --> 00:07:37,810
.نعم، نحبّ هذه البلاد

89
00:07:37,810 --> 00:07:40,850
هل سترثون إرادتي بالفعل؟

90
00:07:40,850 --> 00:07:42,320
.بالطّبع

91
00:07:42,320 --> 00:07:43,980
!جيّد، جيّد

92
00:07:43,980 --> 00:07:45,110
أودن-ساما؟

93
00:07:45,110 --> 00:07:48,030
.لا مجال في المساومة على ذلك

94
00:07:48,030 --> 00:07:49,400
ماذا؟

95
00:07:50,710 --> 00:07:56,120
،عندما يحاول المرء حماية شيء ما
...يتطلّب ذلك الكثير من العزيمة

96
00:07:56,120 --> 00:07:59,410
.للعيش بدون المساومة على معتقداتنا

97
00:08:00,380 --> 00:08:05,710
التزموا بما تؤمنوا به مهما مرّ من وقت

98
00:08:06,140 --> 00:08:07,460
.ولا تتخلّوا عنه أبدًا

99
00:08:08,220 --> 00:08:11,630
.تبدو هذه وكأنّها كلماتك الأخيرة وهذا يخيفني

100
00:08:11,630 --> 00:08:13,300
فعلاً؟

101
00:08:19,560 --> 00:08:21,680
!انتظر رجاءً يا أودن-ساما

102
00:08:47,930 --> 00:08:52,380
.ذلك ما أخبرَنا به أودن-ساما

103
00:08:53,840 --> 00:08:57,920
.أوروتشي! لا وقت لدينا لأحمق مثلك
!ابتعد عن طريقنا

104
00:08:58,230 --> 00:09:00,100
وماذا إن رفضت؟

105
00:09:00,100 --> 00:09:00,740
!ماذا؟

106
00:09:00,740 --> 00:09:04,810
.لا أصدّق أنّكم تقدّرون كلمات غبيّة لرجل ميت

107
00:09:04,810 --> 00:09:08,640
!أنا فعلاً لا أحبّ أي جزء منكم

108
00:09:09,080 --> 00:09:10,920
...اسمعوا، إنّني

109
00:09:10,920 --> 00:09:15,480
!أريد قطع أعناقكم بشدّة

110
00:09:19,840 --> 00:09:23,620
!أروني ما لديكم... سأقاتلكم ها هنا

111
00:09:39,010 --> 00:09:42,410
!أتعرفون مع من تعبثون؟

112
00:09:42,410 --> 00:09:44,830
!عليكم التزام حدودكم

113
00:09:44,830 --> 00:09:48,020
!أنا شوغن بلاد وانو

114
00:09:50,150 --> 00:09:54,650
!ما هذا التّصرّف؟! لم أرتكب أيّ خطأ

115
00:09:55,900 --> 00:09:59,680
كلّ ما فعلت هو الانتقام
!من عشيرة كوزكي كما يستحقّون

116
00:09:59,680 --> 00:10:02,780
!استعدت ما كان يفترض أن يكون لي لا غير

117
00:10:11,000 --> 00:10:13,650
!لكنّكم لا تفهمون أيّها الأغبياء

118
00:10:13,650 --> 00:10:18,200
يفترض بالمواطنين والسّاموراي الانحناء
!للشّوغن خاصّتهم واتّباع أمره

119
00:10:18,200 --> 00:10:20,470
!أنا رجل سلطة

120
00:10:22,510 --> 00:10:24,140
!شوركن الزّهور

121
00:10:26,360 --> 00:10:30,810
!هذه البلاد الّتي قمعتني هي المُلامة

122
00:10:37,780 --> 00:10:39,570
!تـ-تلك النّظرة

123
00:10:44,090 --> 00:10:47,450
!هل تحاول القول أنّني على خطأ؟

124
00:10:47,790 --> 00:10:49,140
...لا تنظر إليّ

125
00:10:49,140 --> 00:10:51,450
!لا تنظر إليّ

126
00:10:52,100 --> 00:10:54,620
!لستُ مخطئًا

127
00:10:55,810 --> 00:10:59,550
!كفّ عن النّظر إليّ هكذا

128
00:11:14,310 --> 00:11:15,600
!أوروتشي-ساما

129
00:11:16,160 --> 00:11:19,570
!سأترك أمر عقابك للجحيم! هيّا بنا

130
00:11:22,700 --> 00:11:25,150
هل ستنتقم لسيّدك؟

131
00:11:25,840 --> 00:11:27,910
!علا رأيي فيك يا فوكوروكوجو

132
00:11:27,910 --> 00:11:31,830
،رغم أنّه كان مجرّد مغفّل
.إلاّ أنّك بقيت وفيًّا له حتّى النّهاية

133
00:11:31,830 --> 00:11:34,810
!بإمكاني قول نفس الشّيء عنكم

134
00:11:34,810 --> 00:11:39,280
،حتّى إن لم يكن لديّ هدف الانتقام
!قُدّر لنا أنا وأنت أن نتقاتل

135
00:11:39,280 --> 00:11:41,350
!هل تعرف ما أعنيه يا رايزو؟

136
00:11:41,350 --> 00:11:42,460
!نعم

137
00:12:28,030 --> 00:12:30,140
!هل سيدمّران القلعة بأكملها؟

138
00:12:49,800 --> 00:12:52,800
!إنّه صدام قويّ... أكان كايدو؟

139
00:12:52,800 --> 00:12:54,540
!ربّما هذا ضدّ لوفي-دونو؟

140
00:12:54,540 --> 00:12:55,580
!لا داعي للقلق

141
00:12:56,890 --> 00:12:59,000
!أنا واثق أنّهم سيكونون بخير

142
00:12:59,470 --> 00:13:00,460
...فضلاً عن ذلك

143
00:13:01,670 --> 00:13:04,000
.قطعنا وعدًا

144
00:13:08,480 --> 00:13:11,310
!لا وقت لدينا لنضيّعه

145
00:13:11,310 --> 00:13:13,970
!نعم! لنسرع

146
00:13:17,370 --> 00:13:18,810
...لوفي-دونو

147
00:13:43,460 --> 00:13:45,380
!هذا لا يكفي أبدًا

148
00:13:45,810 --> 00:13:49,570
!ألا يمكنكم جعل الأمر أكثر إثارة؟

149
00:13:49,570 --> 00:13:52,220
!إلى حدّ الشّعور بالخوف

150
00:13:52,990 --> 00:13:54,000
!أجيبوني

151
00:13:54,000 --> 00:13:57,210
ألن يكون من الرّائع أن تتسبّبوا لي
...بندبة لا تزول

152
00:13:57,210 --> 00:13:59,600
!أو تخيفونني بما يكفي حتّى أشعر بالقشعريرة؟

153
00:13:59,870 --> 00:14:03,200
!لأنّكم ستموتون قريبًا

154
00:14:03,200 --> 00:14:04,230
!أيّها الوغد القذر

155
00:14:04,230 --> 00:14:09,820
!سأسلبكم كلّ شيء! لم تنس ذلك، صحيح؟

156
00:14:11,740 --> 00:14:17,890
بدأت أشعر وكأنّني بحاجة لقطع
.أعناق هؤلاء عاجلاً أيضًا

157
00:14:17,890 --> 00:14:21,540
.لننه أمرهم بالهجوم التّالي يا كايدو

158
00:14:21,540 --> 00:14:23,710
.نعم، لنقتلهم

159
00:14:24,590 --> 00:14:28,550
!اللّهو برويّة ليس طريقة جيّدة للاستمتاع

160
00:14:28,810 --> 00:14:31,480
!تتطلّب الحياة الانضباط

161
00:14:31,480 --> 00:14:34,140
!كفّ عن التفوّه بهذا الهراء

162
00:14:39,160 --> 00:14:41,230
!لا يمكنك إنهاء المعركة من تلقاء نفسك

163
00:14:42,830 --> 00:14:43,770
!ماذا؟

164
00:14:44,900 --> 00:14:47,130
!لن تفوزا

165
00:14:47,130 --> 00:14:49,860
!سنريكما مقدار عزيمتنا

166
00:14:50,130 --> 00:14:51,690
!يا كايدو

167
00:15:13,110 --> 00:15:14,880
عزيمتكم؟

168
00:15:15,390 --> 00:15:18,470
ما الغاية من شيء كهذا؟

169
00:15:25,410 --> 00:15:27,900
!لا تغامر بالكثير يا قبّعة القشّ

170
00:15:30,210 --> 00:15:33,860
!سأقطع أعناقكم كما أردتم

171
00:15:35,840 --> 00:15:36,700
!انتبهوا

172
00:15:45,630 --> 00:15:46,540
!لوفي

173
00:15:46,540 --> 00:15:48,330
!انتبهوا أكثر

174
00:15:50,800 --> 00:15:52,720
!لن أسمح لكم بالفرار

175
00:15:59,100 --> 00:16:00,180
!السّتارة الصّادّة للجراثيم

176
00:16:07,480 --> 00:16:09,020
!ما رأيكم بهذا؟

177
00:16:17,580 --> 00:16:18,910
!تورا-أو

178
00:16:27,500 --> 00:16:28,840
!اختفوا

179
00:16:49,820 --> 00:16:54,730
!سئمت سماع كلمات مثل العزيمة والإصرار

180
00:16:55,170 --> 00:17:00,490
!هذه كلمات جوفاء ولا تأثير لها على العالم

181
00:17:01,300 --> 00:17:06,370
!سيموت الضّعفاء دون ترك أيّ شيء خلفهم

182
00:17:07,140 --> 00:17:09,170
وماذا في ذلك؟

183
00:17:10,480 --> 00:17:13,290
...هل يمكنك حمل

184
00:17:14,650 --> 00:17:17,380
!بلاد وانو على ظهرك؟

185
00:17:23,910 --> 00:17:28,190
!ثمّة أمر عليّ القيام به

186
00:17:28,190 --> 00:17:30,290
!لا تتظاهر بالقوّة يا ولد

187
00:17:30,290 --> 00:17:35,320
ما دمتُ هنا، لا يمكنك فعل ما
!يحلو لك في عالم البحار هذا

188
00:17:35,750 --> 00:17:40,910
،إنّكم تحاولون حماية شيء ما
.لكنّ كلّ ذلك الجهد ذهب سدى

189
00:17:41,210 --> 00:17:43,260
!بسببي أنا

190
00:17:43,260 --> 00:17:44,330
!مهلاً يا هذا

191
00:17:45,260 --> 00:17:48,790
،إن كنت ستدعو قبطاننا إلى الجحيم

192
00:17:48,790 --> 00:17:51,460
!فسآتي أنا أيضًا

193
00:17:52,850 --> 00:17:58,410
لا يمكنك تحمّل البقاء وحدك؟
..."حتّى الشّجرة الميتة لها فائدة للجبل"

194
00:17:58,410 --> 00:18:03,100
هل أثّر عليك أولئك السّاموراي وفقدت عقلك؟

195
00:18:03,100 --> 00:18:08,170
إن كان ذلك النوع من التّضحية بالذّات
،"هو ما تسمّيه "بالصّداقة

196
00:18:08,170 --> 00:18:11,690
!إذًا فهو أمر وضيع لتفتخر به

197
00:18:11,690 --> 00:18:13,270
!قل ما يحلو لك

198
00:18:14,120 --> 00:18:16,420
.دعني أخبرك بأمر واحد

199
00:18:16,420 --> 00:18:23,120
تلك ليست طريقة حياة أو روحًا نبيلة
!أو ما إلى ذلك ليتشرّف بها المرء

200
00:18:23,120 --> 00:18:25,450
!ستموت هباءً لا غير

201
00:18:25,450 --> 00:18:28,410
ذلك الغبيّ، ما الّذي يفكّر فيه؟

202
00:18:30,510 --> 00:18:34,210
،قم بشيء جدير لإنهاء حياتك على الأقلّ

203
00:18:34,210 --> 00:18:37,040
!ودعني أمتّع ناظريّ به

204
00:19:12,510 --> 00:19:15,400
!ثمّة أمر عليّ القيام به

205
00:19:15,400 --> 00:19:17,150
...وهو يا كايدو

206
00:19:17,150 --> 00:19:20,880
!إيساعك ضربًا ومواصلة تقدّمي

207
00:19:25,610 --> 00:19:28,350
.آسف... لا سبب يدعوك للموت الآن

208
00:19:29,740 --> 00:19:31,310
!كنتُ مدركًا لذلك طوال الوقت

209
00:19:31,310 --> 00:19:34,370
!تبًّا! لا تجعل جماعتك تستولي على كلّ شيء

210
00:19:34,370 --> 00:19:36,730
!كيف يمكنك التّقدّم للأمام بدوننا؟

211
00:19:39,240 --> 00:19:41,230
!على أيّ حال، سأشقّ طريقي

212
00:19:52,750 --> 00:19:53,500
!هيّا بنا

213
00:19:54,260 --> 00:19:56,210
!لا تستخفّ بي يا ولد

214
00:20:20,820 --> 00:20:22,440
!لن أسمح لك

215
00:20:25,590 --> 00:20:27,570
!لا يهمّ إن هاجمتم جميعًا دفعة واحدة

216
00:20:37,090 --> 00:20:38,590
!هاجم

217
00:20:38,590 --> 00:20:39,790
!وغد قذر

218
00:20:41,140 --> 00:20:41,960
!شكرًا

219
00:20:48,220 --> 00:20:49,840
!كايدو

220
00:21:07,780 --> 00:21:09,530
...غازي العوالم الثّلاثة

221
00:21:14,370 --> 00:21:15,910
!راغناراكو

222
00:21:29,390 --> 00:21:30,340
!لوفي

223
00:21:31,110 --> 00:21:33,350
!لننه أمر البقيّة أيضًا

224
00:21:37,480 --> 00:21:38,600
!تمّ الأمر

225
00:21:38,600 --> 00:21:39,150
!حسنًا

226
00:21:39,150 --> 00:21:40,110
!غرفة

227
00:21:40,980 --> 00:21:41,810
!خلط

228
00:21:44,000 --> 00:21:46,280
!أين أنا؟! المكان مظلم

229
00:21:46,880 --> 00:21:47,660
!زوس

230
00:21:47,660 --> 00:21:49,650
!أيمكنك فعلها يا رورونوا؟

231
00:21:50,420 --> 00:21:52,780
!لا خيار أمامي

232
00:21:57,670 --> 00:21:59,580
!لن أسمح لك بالعودة إليها

233
00:22:00,250 --> 00:22:03,420
!اللّهب الفاصل: مفترق طرق المسارات السّتّة

234
00:22:06,010 --> 00:22:09,410
!توقّف! أنا مجرّد سيف

235
00:22:09,410 --> 00:22:12,260
!ماما، النّجدة

236
00:22:12,260 --> 00:22:13,350
!يا رفاق

237
00:22:13,350 --> 00:22:14,140
!هذه فرصتنا

238
00:22:14,140 --> 00:22:16,020
!المسدّسات المغناطيسيّة

239
00:22:18,200 --> 00:22:19,900
!ما هذا؟

240
00:22:19,900 --> 00:22:24,770
!هل اعتقدتم أنّ بإمكانكم هزيمتي إن فرّقتمونا؟

241
00:22:33,490 --> 00:22:34,200
!تنافر

242
00:22:37,120 --> 00:22:37,830
!عصا الإيقاع

243
00:22:41,430 --> 00:22:45,000
!مغفّل! لا يمكنك هزيمتي بضربي بصخرة

244
00:22:53,140 --> 00:22:54,390
!سُحقًا

245
00:23:00,310 --> 00:23:01,520
!ماما

246
00:23:01,520 --> 00:23:04,690
،إن لم تستطع الحصول على المساعدة
!فستنسحب من المعركة

247
00:23:07,290 --> 00:23:08,770
!كيف هذا؟

248
00:23:18,510 --> 00:23:24,000
حتّى بعد إبعاد بيغ مام، ما زال النّاشئون
!يقاتلون في معركة استنزاف شرسة

249
00:23:24,000 --> 00:23:29,010
،يحاول كايدو مهاجمة لوفي الهاوي
.ويتجهّز زورو ليضرب وهو محاصر

250
00:23:29,010 --> 00:23:33,260
كما أسورا، فإنّ السّيف الشّهير إنما يفعّل
!تقنية أسلوب السّيوف التّسعة السّرّيّة

251
00:23:33,260 --> 00:23:36,050
!وها هو يخاطر بمصيره على حركة واحدة

252
00:23:36,510 --> 00:23:40,480
:في الحلقة القادمة من وان بيس
"!الدّفاع عن لوفي! تقنية سيف زورو ولو"

253
00:23:40,480 --> 00:23:45,690
!ملك القراصنة، لن يكون إلاّ أنا