1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:55,190 --> 00:01:59,120
!أديروا الدّفّة نحو السّحاب"
"!الإمساك بطائر الجنوب

22
00:02:01,930 --> 00:02:03,430
ما الّذي تريد إخبارنا به أيّها العمّ؟

23
00:02:04,460 --> 00:02:10,300
اسمعوا، سأبدأ بإخباركم كلّ شيء
.أعرفه عن جزيرة السّماء

24
00:02:10,800 --> 00:02:15,010
لا شيء من هذا أكيد، لكنّ تصديقكم
!لكلامي أم لا منوط بكم

25
00:02:15,270 --> 00:02:16,610
!نعم! نحن نصدّقك

26
00:02:16,610 --> 00:02:17,480
!هذا سريع

27
00:02:17,710 --> 00:02:20,910
ثمّة ظاهرة غريبة تحدث
...في هذه المياه

28
00:02:21,450 --> 00:02:25,450
يحلّ اللّيل فجأة أحيانًا حتّى
.إن كنّا في منتصف النّهار

29
00:02:26,020 --> 00:02:29,020
!أجل! رأينا ذلك! صحيح؟

30
00:02:29,020 --> 00:02:33,690
نعم! حلّ اللّيل فجأة
!ثمّ ظهرت بعض الوحوش

31
00:02:35,390 --> 00:02:36,890
العملاقة؟

32
00:02:36,890 --> 00:02:41,230
،ثمّة قصّة تتحدّث عن أصلوها
.لكن انسوا أمرها الآن

33
00:02:41,430 --> 00:02:43,700
...حلول اللّيل المفاجئ هذا

34
00:02:46,870 --> 00:02:50,240
تتسبّب به ظلال سحب
...مضغوطة بشدّة

35
00:02:50,240 --> 00:02:52,240
تقصد المزن الرّكاميّ؟

36
00:02:52,240 --> 00:02:54,580
...لكنّها أغمق من أن تكون سحبًا

37
00:02:55,850 --> 00:02:57,320
!أنت غبيّ أيّها العمّ

38
00:02:57,320 --> 00:02:59,550
يصبح الجوّ غائمًا عند تجمّع
!غيوم كثيرة وليس مظلمًا

39
00:02:59,550 --> 00:03:00,950
!نعم! غائم

40
00:03:00,950 --> 00:03:01,550
!غائم

41
00:03:01,550 --> 00:03:03,520
!اخرسوا واستمعوا

42
00:03:03,920 --> 00:03:07,330
."ثمّة سحب تُعرف بـ"السُّحب الملكيّة

43
00:03:07,330 --> 00:03:12,860
إنّها تتجمّع عاليًا في السّماء
.لكنّها لا تنتج تيّارات هواء أو مطر

44
00:03:12,860 --> 00:03:18,340
،عندما تظهر عاليًا في السّماء
،يُحجب حتّى نور الشّمس

45
00:03:18,340 --> 00:03:20,500
.ويتحوّل النّهار على الأرض إلى ليل

46
00:03:20,970 --> 00:03:23,270
وتقول نظريّة أنّ السّحب الملكيّة

47
00:03:23,270 --> 00:03:28,980
هي سحب متحجّرة طفت في السّماء
.لآلاف آلاف السّنين دونما أيّ تغيير

48
00:03:28,980 --> 00:03:33,420
هذا سخيف! لا يمكن للسّحب
!أن تتشكّل دون تيّارات هوائيّة

49
00:03:33,820 --> 00:03:36,420
.لك حرّيّة تصديق وجودها من عدمه

50
00:03:36,420 --> 00:03:38,890
!أنا لا أطلب منك أن تصدّقيني

51
00:03:39,320 --> 00:03:41,090
إنّها سحب غامضة إذًا؟

52
00:03:41,560 --> 00:03:44,600
.نوعًا ما. ما زال الغموض يلفّها

53
00:03:44,600 --> 00:03:46,000
!أنت مذهل يا لوفي

54
00:03:46,000 --> 00:03:50,000
اسمعوا. إن كانت هنالك
...جزيرة سماء بالفعل

55
00:03:50,300 --> 00:03:51,970
!سيكون ذلك المكان الوحيد الممكن

56
00:03:52,200 --> 00:03:55,140
!حسنًا، مفهوم! لنذهب فوق تلك السّحب

57
00:03:55,140 --> 00:03:56,270
!انهض يا زورو

58
00:03:56,270 --> 00:03:57,340
ماذا؟ أحلّ الصّباح؟

59
00:03:57,340 --> 00:04:00,510
!استعدّوا يا رفاق! أديروا الدّفّة للسّحب

60
00:04:00,510 --> 00:04:03,350
!شكرًا على المعلومات أيّها العمّ

61
00:04:03,650 --> 00:04:05,880
كم مرّة عليّ أن أقول أنّنا لا نعرف
!كيف نذهب إلى هناك؟

62
00:04:08,020 --> 00:04:09,350
.وهنا تبدأ المشكلة الحقيقيّة

63
00:04:09,350 --> 00:04:11,360
...دعوني أبدأ بقول هذا
!ضعوا حياتكم على المحكّ

64
00:04:11,360 --> 00:04:12,860
...نحن على شفير الموت سلفًا

65
00:04:13,190 --> 00:04:16,860
تيّار المحيط الصّاعد هو تيّار
...ينطلق في الهواء

66
00:04:16,860 --> 00:04:21,170
نظريًّا، بإمكانكم صعوده
نحو السّماء، مفهوم؟

67
00:04:21,170 --> 00:04:25,240
إنّه تيّار بإمكانه جعل سفينتنا
تحلّق نحو السّماء، صحيح؟

68
00:04:25,240 --> 00:04:28,140
!فهمت! عليه فقط أن يرسلنا فوق السّحب

69
00:04:28,870 --> 00:04:30,680
!مرحى

70
00:04:31,710 --> 00:04:33,110
على تيّار؟

71
00:04:33,110 --> 00:04:37,550
لكن ألن ينتهي بنا المطاف
محطّمين في المحيط؟

72
00:04:37,550 --> 00:04:41,120
.ذلك صحيح في العادة. التّوقيت هو الحلّ

73
00:04:41,120 --> 00:04:46,090
من السّهل الحديث عن التّحليق
،بواسطة التّيّار

74
00:04:46,590 --> 00:04:50,660
لكن لن تكون رحلة لطيفة
.كما تعتقدون يا رفاق

75
00:04:52,760 --> 00:04:56,200
.تيّار المحيط الصّاعد كارثة طبيعيّة

76
00:04:56,200 --> 00:04:59,200
!إنّه شيء يستدعي تجنّبه في العادة

77
00:05:00,910 --> 00:05:04,280
كيف يتصاعد تيّار مائيّ
!كهذا نحو السّماء عادة؟

78
00:05:04,280 --> 00:05:08,180
...لم نسمع أيّ شيء كهذا من قبل

79
00:05:08,750 --> 00:05:09,750
!نعم

80
00:05:11,750 --> 00:05:16,950
في العادة، بإمكاننا فقط أن نخمّن
.كيف يعمل ذلك التّيّار الوحشيّ

81
00:05:16,950 --> 00:05:20,220
لا يوجد من هو غبيّ كفاية
.ليقفز فيه ويكتشف الأمر

82
00:05:20,930 --> 00:05:22,190
!والنّظريّة المقبولة هي كالتّالي

83
00:05:26,500 --> 00:05:29,970
،عميقًا تحت قاع البحر
،ثمّة تجاويف ضخمة

84
00:05:29,970 --> 00:05:33,040
.وتتسرّب إليها مياه البحر الباردة

85
00:05:33,270 --> 00:05:37,040
وتحوّل الحرارة في باطن
،الأرض تلك المياه لبخار

86
00:05:37,040 --> 00:05:39,880
ويتسبّب الضّغط النّاجم
.بانفجار على قاع البحر

87
00:05:40,310 --> 00:05:46,380
انفجار كبير كفاية لإرسال مياه البحر
!محلّقة ويُنشئ تيّارًا نحو السّماء

88
00:05:49,020 --> 00:05:53,620
ويتواصل البحر بالصّعود نحو
.السّماء لحوالي دقيقة كاملة

89
00:05:53,620 --> 00:05:58,330
دقيقة واحدة؟! ما حجم الانفجار
!الّذي نتحدّث عنه هنا؟

90
00:06:00,870 --> 00:06:02,300
.ويحدث خمس مرّات في الشّهر

91
00:06:03,230 --> 00:06:05,870
!تريدنا أن ننفجر لأشلاء...؟

92
00:06:06,500 --> 00:06:07,840
...ولكن

93
00:06:08,340 --> 00:06:13,180
وصف ظاهرة طبيعيّة كبيرة
.بالكلمات والمنطق حماقة

94
00:06:13,180 --> 00:06:19,450
لـ-لذلك باختصار، علينا ركوب هذا التّيّار
الّذي يظهر خمس مرّات في الشّهر

95
00:06:19,450 --> 00:06:21,190
ونأمل أن يأخذنا لجزيرة السّماء؟

96
00:06:21,550 --> 00:06:29,290
نعم. وإن أخطأتموه، ستسقطون
...عائدين وتصطدمون بالمحيط

97
00:06:30,290 --> 00:06:33,000
.وسينتهي بكم الأمر في قاع البحر

98
00:06:34,600 --> 00:06:37,340
!حـ-حسنًا! لننس أمر جزيرة السّماء

99
00:06:39,700 --> 00:06:41,710
!هذا مستحيل

100
00:06:41,710 --> 00:06:47,010
عليك أن تملك أكبر حظّ
!قد يحظى به أيّ محظوظ

101
00:06:49,380 --> 00:06:51,520
!سنكون بخير! لنذهب

102
00:06:51,520 --> 00:06:52,120
وكيف لي أن أدري؟

103
00:06:52,620 --> 00:06:56,720
سنكون بخير"؟ كيف لك أن تقول"
...أمورًا لا أساس لها بسهولة

104
00:06:56,720 --> 00:06:59,620
!أعني، انظر لحال غوينغ ميري وستعرف

105
00:06:59,620 --> 00:07:02,160
!إنّها في حالة مزرية

106
00:07:02,160 --> 00:07:06,030
!لا يمكنها تحمّل كارثة ضخمة كهذه

107
00:07:06,030 --> 00:07:10,370
هذا صحيح. ما كانت تلك السّفينة
.أن تصمد وإن كانت في أحسن حال

108
00:07:10,670 --> 00:07:11,870
!ماذا؟

109
00:07:11,870 --> 00:07:14,040
...السّرعة والوزن والقوّة

110
00:07:14,040 --> 00:07:17,510
.ستُدمّر تلك السّفينة بسبب ذلك الانفجار

111
00:07:18,080 --> 00:07:22,250
!لكن... نعم! الأمر مستحيل بالفعل

112
00:07:22,450 --> 00:07:24,920
.لكن لا تقلقوا حيال ذلك

113
00:07:24,920 --> 00:07:28,350
سأطلب من ماسيرا وشوجو
.أن يساعداكم في الذّهاب

114
00:07:28,350 --> 00:07:31,220
.وذلك بعد تقوية سفينتكم بالطّبع

115
00:07:31,520 --> 00:07:33,960
!أجل! دعوا الأمر لنا فحسب

116
00:07:33,960 --> 00:07:35,230
!شكرًا لكما

117
00:07:35,530 --> 00:07:37,400
...لم يطلب رأينا حتّى

118
00:07:39,230 --> 00:07:41,230
!هل تدرك الأمر تمامًا؟

119
00:07:41,230 --> 00:07:41,730
أدرك ماذا؟

120
00:07:41,730 --> 00:07:43,670
!في البداية... أجل

121
00:07:43,670 --> 00:07:48,340
أطول مدّة يمكننا البقاء فيها على
!هذه الجزيرة هي يوم واحد فقط

122
00:07:48,340 --> 00:07:52,740
وبعد ذلك، ستبدأ اللوغ بوس
!بتسجيل مجال الجزيرة التّالية

123
00:07:52,740 --> 00:07:56,080
!نعم! نعم! لن ننجح في الوقت المناسب

124
00:07:56,080 --> 00:07:58,750
!كما أنّك لستَ عرّافًا أيّها العمّ

125
00:07:58,750 --> 00:08:00,950
أشكّ أنّك تعرف، ولكن كم يومًا أمامنا

126
00:08:00,950 --> 00:08:05,920
حتّى يتوافق تيّار المحيط الصّاعد
!والسّحب الملكيّة معًا؟

127
00:08:05,920 --> 00:08:10,930
!لا، لا! بل كم شهرًا؟! أو لنقل كم سنة؟

128
00:08:10,930 --> 00:08:14,200
!غدًا عصرًا. عليكم الاستعداد إن كنتم ذاهبين

129
00:08:14,200 --> 00:08:16,200
!لا يمكننا الاستعداد في ذلك الوقت

130
00:08:16,200 --> 00:08:19,170
!ماذا؟ انسوا الأمر إن كنتم مرتابين هكذا

131
00:08:21,440 --> 00:08:22,510
!أنت تكذب

132
00:08:23,270 --> 00:08:28,310
!هذا غير صائب! قابلناك للتّوّ
!ألا تتصرّف بلطف أكثر من اللاّزم؟

133
00:08:28,550 --> 00:08:30,080
...وأيضًا

134
00:08:30,410 --> 00:08:31,550
!تمهّل يا أوسوبّ

135
00:08:31,550 --> 00:08:32,650
!اخرس أنت

136
00:08:33,280 --> 00:08:36,090
شاءت الصّدف أن يكون
الغد أفضل فرصة

137
00:08:36,090 --> 00:08:40,290
للذّهاب إلى جزيرة السّماء
!الأسطوريّة المجهولة هذه؟

138
00:08:40,590 --> 00:08:44,930
كما ستساعدنا على تقوية سفينتنا
!وأخذنا إلى هناك؟

139
00:08:44,930 --> 00:08:46,430
!هذا مناسب أكثر من اللاّزم

140
00:08:46,430 --> 00:08:48,370
!ما الّذي تخطّط له بالتّحديد؟

141
00:08:48,830 --> 00:08:53,770
!كما أنّك سليل نولاند الكذّاب
!لا يمكننا أن نثق بك

142
00:08:57,270 --> 00:09:00,510
!أيّها العجوز! الطّعام جاهز

143
00:09:00,510 --> 00:09:01,310
!ابتعدا

144
00:09:01,580 --> 00:09:03,750
—نامي-سان! الطّعام

145
00:09:06,780 --> 00:09:09,220
!ما-ماذا؟! أتريد القتال؟

146
00:09:09,990 --> 00:09:13,290
،وقتما تأكّدنا من "ليلِ النّهار" في منطقة ماسيرا

147
00:09:13,290 --> 00:09:18,760
ستظهر السّحب الملكيّة في السّماء
.الجنوبيّة في اليوم التّالي

148
00:09:18,760 --> 00:09:21,100
،ونظرًا لمعدّل ظهوره خمس مرّات في الشّهر

149
00:09:21,100 --> 00:09:24,940
فإنّ تيّار المحيط الصّاعد سيكون
.نشطًا غدًا على الأرجح

150
00:09:25,600 --> 00:09:28,540
.سيحدث في مكان ما جنوبًا منّا

151
00:09:28,810 --> 00:09:33,680
الأمر ليس مؤكّدًا 100%، ولكن
.هنالك فرصة كبيرة بحدوثه غدًا

152
00:09:40,180 --> 00:09:44,160
.أنا سعيد بلقائي بحمقى مثلكم

153
00:09:46,460 --> 00:09:51,330
!لذلك، لنذهب ونأكل بعض الطّعام
...اعتبروا منزلي منزلكم اليوم

154
00:09:51,600 --> 00:09:52,900
!يا أصحاب

155
00:09:56,530 --> 00:09:58,570
!وقت الأكل! أسرع يا أوسوبّ

156
00:09:58,570 --> 00:09:59,800
!أجل! هيّا

157
00:09:59,800 --> 00:10:01,610
!تشوبّر! اذهب ونادي على روبين-تشان

158
00:10:01,610 --> 00:10:02,540
!حالاً

159
00:10:04,580 --> 00:10:08,680
يبدو أنّ كلّ ما بوسعنا فعله هو
...بذل جهدنا للذّهاب للسّماء

160
00:10:09,210 --> 00:10:11,150
.رغم أنّ الأمر منوط بالحظّ في النّهاية

161
00:10:11,380 --> 00:10:14,550
نامي. هل أنا بائس وجبان؟

162
00:10:14,820 --> 00:10:16,550
.أضف عليهما "غبيّ" أيضًا

163
00:10:16,790 --> 00:10:20,360
.أعرف كيف تشعر. اذهب واعتذر الآن

164
00:10:22,760 --> 00:10:25,460
!آسف أيّها العمّ

165
00:10:25,460 --> 00:10:29,200
!ما الّذي...؟! هذا مقرف
!لا تمسح أنفك بي أيّها الأحمق

166
00:10:35,270 --> 00:10:38,510
!طعم ساكي اليوم أفضل بكثير

167
00:10:38,510 --> 00:10:42,050
كلوا، كلوا! بدأت وجبة سمك
!الصّوري الكاملة للتّوّ

168
00:10:42,050 --> 00:10:42,510
!تفضّل

169
00:10:43,580 --> 00:10:46,250
!نلت منك يا غبيّ الإنقاذ
!إنّها قنبلة صلصة حارّة

170
00:10:47,020 --> 00:10:49,420
!أيّها الوغد طويل الأنف

171
00:10:50,820 --> 00:10:52,990
!يا فتاة! تعالي واجلسي قربي

172
00:10:52,990 --> 00:10:56,460
وغد! أمامك مائة عام أخرى حتّى
!تستطيع التّقرّب من نامي-سان

173
00:11:05,240 --> 00:11:07,240
...رأيتُ ذهبًا"

174
00:11:08,470 --> 00:11:10,210
"!في عين الجمجمة اليمنى

175
00:11:10,210 --> 00:11:10,710
!ذهب؟

176
00:11:14,510 --> 00:11:19,080
كانت تلك الجملة المغمورة
.بالدّموع آخر ما كتبه نولاند

177
00:11:19,920 --> 00:11:22,990
"...رأيتُ ذهبًا في عين الجمجمة اليمنى"

178
00:11:23,820 --> 00:11:26,460
.أُعدم نولاند في نفس ذلك اليوم

179
00:11:26,890 --> 00:11:30,900
،حتّى بعد المجيء إلى جايا
.كانت تلك الكلمات مجرّدة من المنطق

180
00:11:30,900 --> 00:11:32,730
"...عين الجمجمة اليمنى"

181
00:11:32,730 --> 00:11:36,030
هل يقصد اسم مدينة
كانت موجودة يومًا ما؟

182
00:11:36,030 --> 00:11:38,470
أو ربّما كانت تلميحًا لموته؟

183
00:11:38,840 --> 00:11:42,070
لم يُذكر شيء في الصّفحات
...الفارغة بعد ذلك

184
00:11:42,870 --> 00:11:44,940
!لذلك السّبب نغوص

185
00:11:44,940 --> 00:11:47,280
!فحُلمنا قابع في قاع البحر

186
00:11:48,550 --> 00:11:50,080
!هذا صحيح

187
00:11:52,450 --> 00:11:54,420
!سنحلّق

188
00:11:55,750 --> 00:11:58,060
!ليس إن واصلتَ الأكل هكذا

189
00:12:02,990 --> 00:12:06,700
.تأخّر الوقت كثيرًا، لكنّي أراه يا بيلامي

190
00:12:06,700 --> 00:12:08,330
.استعدّوا لنرسو

191
00:12:09,170 --> 00:12:12,600
يستحقّ الحمقى الّذين يطاردون
!الأحلام أكثر من مجرّد كدمات

192
00:12:28,650 --> 00:12:34,560
.يوم وصولي إلى جايا"
".سجلّ 21 مايو 1122

193
00:12:34,560 --> 00:12:36,760
!نولاند! نولاند

194
00:12:36,760 --> 00:12:39,890
،عندما رسونا على الجزيرة"
سمعنا نداءات طائر غريبة

195
00:12:39,890 --> 00:12:46,570
.وصوت جرس كبير صادر من الغابة

196
00:12:46,570 --> 00:12:52,240
إنّ صدى صوت ذلك الجرس الذّهبيّ
،الضّخم يتردّد بعيدًا وفي كلّ مكان

197
00:12:52,240 --> 00:12:56,740
وكأنّه يُعلن عن مدى ازدهار
!مدينة عريقة التّاريخ

198
00:12:57,310 --> 00:13:02,680
ظننّا أنّنا عرفنا كلّ شيء
"...بعد عيشنا لبضعة عقود

199
00:13:02,680 --> 00:13:05,250
!نولاند! نولاند

200
00:13:05,250 --> 00:13:09,690
لكنّ الوقت العابر الّذي اختبرناه"
من هذه الحضارة الّتي ازدهرت

201
00:13:09,690 --> 00:13:12,730
لوقت طويل في البحر الواسع
!تركنا عاجزين عن الكلام

202
00:13:13,030 --> 00:13:16,730
"!جعلَنا صوت الجرس نجمد في أماكننا

203
00:13:19,600 --> 00:13:21,570
!نولاند رائع جدًّا

204
00:13:22,600 --> 00:13:25,570
!مذهل! جرس ذهبيّ عملاق

205
00:13:25,570 --> 00:13:29,540
!مهلاً أيّها العمّ! أنت تحبّ نولاند بالفعل

206
00:13:31,210 --> 00:13:32,350
!انظروا لهذا

207
00:13:33,110 --> 00:13:34,480
!إنّها أجراس ذهبيّة

208
00:13:35,050 --> 00:13:37,390
لكن، كيف لهذه أن تكون عملاقة؟

209
00:13:38,420 --> 00:13:43,060
.هذه ليست ذلك الجرس
.إنّها سبائك ذهب

210
00:13:43,060 --> 00:13:44,890
.وجدنا هذه السّبائك الثّلاث في قاع البحر

211
00:13:44,890 --> 00:13:45,860
سبائك؟

212
00:13:45,860 --> 00:13:48,330
!هنالك مدينة ذهب بالفعل إذًا

213
00:13:48,330 --> 00:13:51,000
.إنّها لا تثبت ذلك

214
00:13:51,000 --> 00:13:54,840
بالإمكان العثور على ذهب كهذا
.في أيّ أطلال قديمة

215
00:13:55,270 --> 00:13:58,810
لكنّها تثبت بالفعل أنّه كانت هنالك
.حضارة في هذه المنطقة

216
00:13:59,210 --> 00:14:02,740
صُنعت السّبائك بغرض الحصول
.على أوزان موحّدة

217
00:14:03,210 --> 00:14:05,650
.ممّا يعني أنّها استُعملت للمقايضة

218
00:14:05,880 --> 00:14:09,650
نعم. ونداءات الطّائر الغريب
...الّتي ذكرتُها

219
00:14:09,650 --> 00:14:10,750
!يا ماسيرا

220
00:14:13,150 --> 00:14:14,620
!مذهل! ثمّة المزيد؟

221
00:14:14,620 --> 00:14:15,560
!هذه القطعة أكبر

222
00:14:15,920 --> 00:14:16,890
.هذا كلّ شيء

223
00:14:16,890 --> 00:14:18,960
!مذهلة! إنّها جميلة

224
00:14:19,360 --> 00:14:21,260
...أجراس ذهبيّة وطائر

225
00:14:21,260 --> 00:14:24,300
هل تعتقد أنّها كانت رموزًا لجايا القديمة؟

226
00:14:25,500 --> 00:14:29,270
لا أدري، لكن أعتقد
.أنّها كانت جزءًا من نموذج ما

227
00:14:29,770 --> 00:14:34,310
يُسمّى هذا طائر الجنوب، وهي طيور
!ما زالت تعيش على هذه الجزيرة

228
00:14:34,310 --> 00:14:36,610
هل لديها صوت غريب؟

229
00:14:36,610 --> 00:14:38,410
!نعم. كما ذُكر في السّجلّ تمامًا

230
00:14:38,710 --> 00:14:42,850
...استعمل البحّارة طائر الجنوب منذ

231
00:14:45,450 --> 00:14:47,260
!مصيبة

232
00:14:47,260 --> 00:14:48,820
!ما الأمر؟! ما الخطب؟

233
00:14:48,820 --> 00:14:52,360
هذا سيّئ! اذهبوا إلى الغابة
!فورًا يا رفاق! الغابة الجنوبيّة

234
00:14:52,730 --> 00:14:55,400
!ماذا؟! عمّ تتحدّث أيّها العمّ؟
!هل أنت مجنون؟

235
00:14:55,400 --> 00:14:58,200
!اذهبوا للإمساك بهذا الطّائر في الحال

236
00:14:58,200 --> 00:14:59,700
!لماذا؟! من أجل ماذا؟

237
00:14:59,700 --> 00:15:01,040
لماذا نحتاج هذا الطّائر؟

238
00:15:01,040 --> 00:15:06,140
اسمعوا جيّدًا! تيّار المحيط
الصّاعد الّذي ستقصدونه غدًا

239
00:15:06,140 --> 00:15:09,210
.موجود جنوب هذا الرّأس مباشرة

240
00:15:09,210 --> 00:15:11,010
كيف ستصلون إلى هناك؟

241
00:15:11,480 --> 00:15:13,650
سنبحر مباشرة إلى هناك، صحيح؟

242
00:15:13,650 --> 00:15:15,750
!نحن في الغراند لاين كما تعلم

243
00:15:15,750 --> 00:15:19,190
،بمجرّد دخولكم عرض البحر
!من المستحيل أن تعرفوا الاتّجاهات

244
00:15:19,190 --> 00:15:20,820
!هذا صحيح

245
00:15:20,820 --> 00:15:25,460
،نحن ذاهبون لنقطة ما في المحيط
!وليس جزيرة، لا مرشد لنعتمد عليه

246
00:15:25,460 --> 00:15:28,460
كيف نتّجه إلى الجنوب مباشرة؟

247
00:15:28,460 --> 00:15:31,800
!باستعمال تصرّف هذا الطّائر

248
00:15:32,170 --> 00:15:35,570
تملك بعض أنواع الحيوانات
مغانط داخليّة دقيقة

249
00:15:35,570 --> 00:15:37,940
.تسمح لها بالتّعرّف على الاتّجاهات

250
00:15:39,040 --> 00:15:41,410
!إذًا فأنت أقلّ شأنًا من الحيوانات يا زورو

251
00:15:41,640 --> 00:15:43,910
!وكأنّه يحقّ لك أنت الكلام

252
00:15:44,280 --> 00:15:47,110
طيور الجنوب هي الأفضل
!بين هذه الحيوانات

253
00:15:49,250 --> 00:15:52,490
مهما كانت الأرض أو البحر
،الّذي توجد فيها واسعًا

254
00:15:52,490 --> 00:15:56,360
فإنّ أجسادها ستشير دائمًا
.للاتّجاه الصّحيح

255
00:15:58,060 --> 00:16:01,260
على أيّ حال، بدون إحدى هذه
!الطّيور، فلن تستطيعوا الذّهاب

256
00:16:01,260 --> 00:16:04,830
لن تحصلوا حتّى على فرصة
!للذّهاب لجزيرة السّماء

257
00:16:04,830 --> 00:16:06,300
!ماذا؟

258
00:16:06,300 --> 00:16:08,370
!لماذا تخبرنا بذلك الآن؟

259
00:16:09,040 --> 00:16:10,370
!كفاكم جدالاً

260
00:16:11,040 --> 00:16:14,180
!لا وقت أمامنا! لا تماطلوا

261
00:16:14,480 --> 00:16:17,150
تريدنا أن نذهب للغابة
!في منتصف اللّيل؟

262
00:16:17,150 --> 00:16:18,410
!لا تنسوا هذه

263
00:16:20,380 --> 00:16:23,920
!سنبدأ نحن بترميم سفينتكم المتهالكة

264
00:16:23,920 --> 00:16:27,360
،بالتّفكير في الأمر
!لم يكن لدينا وقت للاحتفال

265
00:16:27,360 --> 00:16:29,290
ولماذا تخبرنا بهذا الآن؟

266
00:16:29,490 --> 00:16:34,930
اسمعوا! احرصوا على إمساك طائر
!جنوب واحد على الأقلّ قبل الفجر

267
00:16:36,160 --> 00:16:37,370
!الظّلام حالك

268
00:16:37,370 --> 00:16:39,470
!كفّ عن سحبي

269
00:16:40,200 --> 00:16:43,870
!ليست غلطتي! تتحرّك يداي من تلقاء نفسها

270
00:16:44,240 --> 00:16:48,840
معدتي ممتلئة... لا أعتقد
...أنّ بإمكاني مطاردة الطّيور

271
00:16:48,840 --> 00:16:51,450
!أين هي هذه الطّيور الغريبة؟

272
00:16:51,780 --> 00:16:54,180
لنمسك بإحداها لنستطيع
!العودة للشّرب

273
00:16:54,450 --> 00:16:56,650
!كيف انتهى بنا الأمر نقوم بهذا فجأة؟

274
00:16:57,190 --> 00:16:58,490
!ابتعد عنّي

275
00:16:58,490 --> 00:17:01,120
!ألم يكن بمقدوره إخبارنا خلال النّهار؟

276
00:17:01,720 --> 00:17:02,990
أخبرني، أين الطّيور؟

277
00:17:02,990 --> 00:17:06,460
،إن كنّا نعرف أين هي
!ما كنّا لنبحث عنها

278
00:17:06,760 --> 00:17:09,200
...دليلنا الوحيد هو صرخاتها الغريبة

279
00:17:09,200 --> 00:17:12,200
...وتبدو مثل ذلك التّمثال الذّهبيّ

280
00:17:12,200 --> 00:17:15,770
هل هنالك طائر غبيّ المظهر
!كذاك بالفعل؟

281
00:17:15,770 --> 00:17:19,670
!كما أنّ "صرخة غريبة" هو وصف غامض
!كيف يفترض بنا أن نعرف؟

282
00:17:19,670 --> 00:17:23,140
...قال أنّنا سنعرف بمجرّد دخولنا الغابة

283
00:17:25,950 --> 00:17:27,450
!صرخة غريبة

284
00:17:27,450 --> 00:17:28,420
!هذه هي

285
00:17:28,650 --> 00:17:29,520
!حسنًا

286
00:17:29,720 --> 00:17:32,090
!لا خيار آخر أمامنا الآن

287
00:17:32,090 --> 00:17:34,720
لدينا ثلاث شبكات. لذا سننفصل
!إلى ثلاث مجموعات ونبحث

288
00:17:34,720 --> 00:17:35,690
!أجل

289
00:17:35,690 --> 00:17:40,060
!هيّا بنا! لنوسع تلك الطّيور ضربًا

290
00:17:40,060 --> 00:17:41,960
!تقصد لنمسك بها

291
00:17:48,070 --> 00:17:51,840
،لا تقلقي! مهما كان ما سنلقاه
!فسأحميك يا نامي-سان

292
00:17:51,840 --> 00:17:53,440
!ماذا عنّي يا سانجي-كُن؟

293
00:17:53,440 --> 00:17:55,740
!لا أهتمّ لأمرك
!كفّ عن التّصرّف بقلّة ثقة

294
00:17:55,740 --> 00:17:59,380
في كلّ الأحوال، لنمسك بالطّائر
!لنتمكّن من مغادرة هذه الغابة

295
00:17:59,710 --> 00:18:04,420
لنبدأ بالإصغاء جيّدًا لصرخة
.الطّائر الّتي سمعناها قبل قليل

296
00:18:06,290 --> 00:18:07,290
!تلك هي

297
00:18:07,290 --> 00:18:10,090
!جيو! اخرج! جيو

298
00:18:10,090 --> 00:18:10,560
!وغد

299
00:18:12,990 --> 00:18:14,700
!لماذا تمسك بي أنا؟

300
00:18:14,700 --> 00:18:18,170
!نامي! ذلك الشّيء الّذي عليك رائع
!من أين حصلتِ عليه؟

301
00:18:18,170 --> 00:18:19,530
ماذا؟

302
00:18:22,900 --> 00:18:24,340
!عنكبوت

303
00:18:24,710 --> 00:18:27,610
!إنّه مجرّد عنكبوت
!أيّها المسكين... تعال

304
00:18:27,910 --> 00:18:31,610
!العناكب مقرفة أيّها الغبيّ
!ارمه بعيدًا من هنا

305
00:18:31,610 --> 00:18:34,680
!ابتعد عنه يا أوسوبّ! لا بدّ أنّه سامّ

306
00:18:35,520 --> 00:18:37,250
!إنّها تسقط من الأشجار

307
00:18:37,590 --> 00:18:39,090
!هذا مقرف جدًّا

308
00:18:39,520 --> 00:18:41,890
!لا بدّ أنّها من فصيلة الرّتيلاء

309
00:18:41,890 --> 00:18:45,790
لا بأس! لن تقذفنا بأيّ سمّ
!ما دمنا لن نفعل لها أيّ شيء

310
00:18:45,790 --> 00:18:47,900
!اعتدت أن أقاتل العناكب في الماضي

311
00:18:47,900 --> 00:18:51,800
كلاّ، لا تعتمد عليّ أبدًا عندما يتعلّق
!الأمر بالحشرات المقزّزة مثلها

312
00:18:52,130 --> 00:18:55,970
!وأنا أيضًا! أكرهها بالكامل
!بالكامل! أسرع وارمه بعيدًا

313
00:18:56,900 --> 00:19:00,170
ولكن ألا تنزعجون
من ذلك العثّ والحريش؟

314
00:19:09,280 --> 00:19:10,820
!أكره العثّ والحريش

315
00:19:11,850 --> 00:19:14,160
!كلاّ! لا تتركوني وحدي

316
00:19:16,590 --> 00:19:18,060
...أسمع صرخات

317
00:19:18,060 --> 00:19:18,890
.انسي أمرهم

318
00:19:23,870 --> 00:19:26,430
...حريش؟ إنّه ضخم

319
00:19:26,830 --> 00:19:30,040
.ليس من اللّطيف قتل كلّ شيء
...يا لذلك المسكين

320
00:19:30,570 --> 00:19:32,670
.هذا ما يستحقّه لمحاولته الهجوم عليّ

321
00:19:33,910 --> 00:19:34,840
...لكن

322
00:19:34,840 --> 00:19:35,880
!ماذا؟

323
00:19:36,140 --> 00:19:38,110
.أتينا من هناك للتّوّ

324
00:19:41,280 --> 00:19:43,380
.إنّها صرخة الطّائر... مِن هنا

325
00:19:44,620 --> 00:19:46,690
.انتبه للمستنقع

326
00:19:48,390 --> 00:19:50,320
!...مهلاً! انتظري

327
00:19:54,860 --> 00:19:56,060
!أمسكتك

328
00:19:56,400 --> 00:19:58,570
!انظر يا تشوبّر! إنّها أطلس

329
00:19:58,570 --> 00:19:59,570
أطلس؟

330
00:19:59,570 --> 00:20:00,670
!نعم

331
00:20:00,670 --> 00:20:04,540
خنافس أطلس وهرقل من أكثر الحشرات
!الّتي تحظى بالإعجاب في العالم

332
00:20:04,840 --> 00:20:07,010
فعلاً؟ الخنافس؟

333
00:20:07,010 --> 00:20:09,910
!ألم تسمع بها من قبل؟
!الإمساك بها صعب جدًّا

334
00:20:09,910 --> 00:20:12,250
!أيّهما أفضل، هي أم "ون بيس"؟

335
00:20:13,250 --> 00:20:14,380
!خيار صعب

336
00:20:14,650 --> 00:20:17,080
!لوفي! ثمّة واحدة هنا أيضًا

337
00:20:17,080 --> 00:20:19,090
!إنّها خنفساء الأيل

338
00:20:19,590 --> 00:20:20,960
!أمسكها

339
00:20:22,320 --> 00:20:23,690
!لقد طارت

340
00:20:23,690 --> 00:20:24,530
!...تعالي

341
00:20:27,160 --> 00:20:29,960
!خلفها! لا تدعها تهرب

342
00:20:31,070 --> 00:20:33,530
!خليّة نحل! اهرب

343
00:20:46,550 --> 00:20:48,520
!ما قصّة هذه الغابة؟

344
00:20:49,680 --> 00:20:51,190
!لوفي! انظر هناك

345
00:20:51,190 --> 00:20:52,150
!إنّه ذلك الطّائر

346
00:20:52,150 --> 00:20:54,190
!لقد أوقع خليّة النّحل

347
00:20:56,690 --> 00:20:58,530
!ماذا؟ هل قال شيئًا ما؟

348
00:21:00,330 --> 00:21:03,500
"!قال، "سأقتلكم لاقتحامكم هذه الغابة

349
00:21:15,280 --> 00:21:19,280
!مهلاً، مهلاً يا فتى! لا تثر غضبنا

350
00:21:19,280 --> 00:21:23,420
ليس من اللّطيف الظّهور ليلاً هكذا
!والمطالبة بالذّهب يا أطفال

351
00:21:24,290 --> 00:21:27,560
!غادروا! لدينا عمل لننهيه

352
00:21:29,560 --> 00:21:31,330
هل أنتما حارساه؟

353
00:21:31,330 --> 00:21:34,530
بالتّفكير في الأمر، كان هنالك
...قرصان اسمه كريكت بالفعل

354
00:21:34,800 --> 00:21:38,570
سمعتُ قصّة عائلة مونبلان
.الحزينة في الحانة

355
00:21:38,570 --> 00:21:39,970
.لقد أثّرت بي

356
00:21:40,470 --> 00:21:45,870
الكنوز الّتي كافح أحد آخر للحصول
!عليها لديها طعم خاصّ بها

357
00:21:46,270 --> 00:21:49,840
أتريدون معرفة بماذا يصفني الآخرون؟

358
00:21:49,840 --> 00:21:51,410
!الضّبع

359
00:21:55,550 --> 00:22:03,450
آه، خلف السّماء الّتي لا نهاية لها

360
00:22:03,450 --> 00:22:14,060
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

361
00:22:21,940 --> 00:22:29,380
مرّت عليّ أيّام كدت أخسر فيها نفسي

362
00:22:29,380 --> 00:22:37,790
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

363
00:22:37,790 --> 00:22:46,000
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

364
00:22:46,000 --> 00:22:54,840
دفعوا بي للأمام، أليس كذلك؟

365
00:22:54,840 --> 00:23:03,150
آه، إنّ النّجوم تهوي من السّماء

366
00:23:03,150 --> 00:23:06,280
...وهذه اللّحظة الفريدة

367
00:23:11,590 --> 00:23:13,560
!أيّها العمّ! أمسكنا بالطّائر

368
00:23:13,560 --> 00:23:14,530
!ما-ماذا حدث؟

369
00:23:14,530 --> 00:23:15,430
!أيّها العمّ ذو الرّأس الماسيّ؟

370
00:23:15,430 --> 00:23:17,090
!آ-آسف

371
00:23:17,800 --> 00:23:20,200
!لم يكن بوسعنا فعل أيّ شيء
!كنّا بلا حول ولا قوّة

372
00:23:20,200 --> 00:23:21,930
!سُرق الذّهب أيضًا

373
00:23:21,930 --> 00:23:24,370
!لا بأس! انسوا أمر تلك الخردة

374
00:23:24,370 --> 00:23:25,700
!شعار بيلامي

375
00:23:25,700 --> 00:23:26,770
!سأعود في الصّباح

376
00:23:27,470 --> 00:23:28,870
:في الحلقة القادمة من ون بيس

377
00:23:28,870 --> 00:23:32,110
!الأحلام لا تتحقّق؟"
".بيلامي ضدّ تحالف ساروياما

378
00:23:32,110 --> 00:23:34,280
!ملك القراصنة، لن يكون إلاّ أنا