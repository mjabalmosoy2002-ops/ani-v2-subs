1
00:00:08,120 --> 00:00:11,190
!العالم... نعم

2
00:00:11,720 --> 00:00:13,390
...اسعوا نحو الحرّيّة

3
00:00:13,390 --> 00:00:17,530
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,890 --> 00:00:21,260
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,760 --> 00:00:23,130
!فتجاوزوها

6
00:00:23,530 --> 00:00:26,500
!تحت راية ما تؤمنون به

7
00:00:30,970 --> 00:00:36,580
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,580 --> 00:00:39,810
متّجهًا نحو عالم بلا نهاية

9
00:00:41,220 --> 00:00:46,090
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,090 --> 00:00:54,500
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,500 --> 00:01:00,240
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,240 --> 00:01:04,670
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,670 --> 00:01:10,310
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,310 --> 00:01:14,180
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,180 --> 00:01:19,120
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,120 --> 00:01:26,860
متّجهين نحو الأفق

17
00:01:26,860 --> 00:01:32,370
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,370 --> 00:01:37,070
متّجهًا نحو عالم بلا نهاية

19
00:01:37,070 --> 00:01:42,310
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,310 --> 00:01:48,580
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:55,590 --> 00:01:59,660
!صائد القراصنة الخرافيّ"
".زورو السّيّاف المتجوّل

22
00:02:23,110 --> 00:02:26,680
سنشرب كلّ قطرة من هذا
!المشروب في هذا المكان

23
00:02:28,850 --> 00:02:29,990
،على مهلك يا بيلي

24
00:02:29,990 --> 00:02:32,090
كم مكانًا ستفسد قبل أن تشبع؟

25
00:02:32,090 --> 00:02:33,660
وما أدراني؟

26
00:02:35,330 --> 00:02:36,730
...ذلك الرّجل هناك

27
00:02:37,360 --> 00:02:39,430
.على رأسه مكافأة تقدّر بخمسة ملايين بيري

28
00:02:40,430 --> 00:02:42,930
...خمسة ملايين؟ ما قولك

29
00:02:43,900 --> 00:02:45,300
أن نتراجع هذه المرّة يا يوساكو؟

30
00:02:45,670 --> 00:02:46,770
،مهلاً يا جوني

31
00:02:46,770 --> 00:02:49,470
إن كنّا سنسعى خلف الضّعفاء
.فحسب، فلن نصل إلى أيّ مكان

32
00:02:49,470 --> 00:02:53,040
هذا هو الوقت الّذي على صائد المكافآت
.أن يسعى خلف الرّتب الأعلى

33
00:02:53,040 --> 00:02:54,480
،أدرك ما تقوله

34
00:02:54,480 --> 00:02:58,280
لكن إذا كانت المكافأة خمسة
.ملايين، حتّى نحن قد نخسر بالكاد

35
00:03:17,530 --> 00:03:18,870
.أعطني شيئًا لآكله

36
00:03:19,900 --> 00:03:21,040
ألديك مال؟

37
00:03:21,040 --> 00:03:23,570
...ليس الآن. ولكن

38
00:03:24,170 --> 00:03:28,010
،سأجني بعض المال قريبًا جدًّا
.بمجرّد حصولي على مكافأة

39
00:03:31,910 --> 00:03:34,080
لا أستطيع السّماح
!لذلك أن يمرّ مرور الكرام

40
00:03:34,680 --> 00:03:37,750
!سأقطّعك قبل أن تنال منّي

41
00:03:47,460 --> 00:03:50,000
.لا تدعني أتعب نفسي كثيرًا

42
00:03:50,000 --> 00:03:51,330
.أنا جائع

43
00:03:52,700 --> 00:03:56,470
،أجبني عن سؤال واحد
هل هنالك مكافأة على رأسك؟

44
00:03:57,140 --> 00:03:58,540
.ستتفاجأ بسماع قيمتها

45
00:03:58,540 --> 00:04:00,610
!على رأسي مكافأة تقدّر بخمسة ملايين بيري

46
00:04:00,610 --> 00:04:02,540
.هكذا إذًا. هذا كثير

47
00:04:02,540 --> 00:04:03,240
ماذا؟

48
00:04:13,950 --> 00:04:16,520
.كسبت بعض المال
.أعطني شيئًا آكله الآن

49
00:04:16,720 --> 00:04:18,190
!حاضر، سأعود في الحال

50
00:04:20,560 --> 00:04:23,030
.لديه مهارة ممتازة

51
00:04:23,560 --> 00:04:25,660
.إنّه ليس على قائمة المطلوبين

52
00:04:26,030 --> 00:04:28,970
،إن كان صائد مكافآت
.فعلى أحد أن يعلم من يكون

53
00:04:28,970 --> 00:04:32,200
هل يعقل أن يكون صائد القراصنة
الّذي سمعنا عنه مؤخّرًا؟

54
00:04:32,200 --> 00:04:34,540
.سمعتُ أنّه رجل قاسٍ للغاية

55
00:04:34,540 --> 00:04:38,780
لا، يُشاع أنّ صائد القراصنة
.يستعمل ثلاثة سيوف

56
00:04:38,780 --> 00:04:41,950
يقولون أنّ إحداها سيف
.شهير لديه غمد أبيض

57
00:04:42,510 --> 00:04:45,350
والأكثر من ذلك، يقولون
،أنّه أشبه بوحش شيطاني

58
00:04:45,350 --> 00:04:47,390
.أخذ شكل إنسان

59
00:04:47,720 --> 00:04:49,650
.إنّه لا يبدو كذلك بكلّ تأكيد

60
00:04:49,990 --> 00:04:51,320
...في تلك الحالة

61
00:04:51,990 --> 00:04:55,690
لا يمكننا الوقوف بلا حراك
!بينما أُخذت طريدتنا منّا

62
00:04:55,990 --> 00:04:56,790
...مهلاً يا جوني

63
00:05:00,160 --> 00:05:03,700
،أنت أيّها الشّابّ
،إن كنتَ صائد مكافآت أيضًا

64
00:05:03,700 --> 00:05:06,370
.فعليك إذًا أن تتقيّد بالقواعد

65
00:05:06,640 --> 00:05:07,470
ماذا؟

66
00:05:07,810 --> 00:05:10,240
،لم نكن نريد افتعال مشاكل للحانة

67
00:05:10,240 --> 00:05:12,240
.لذلك كنّا ننتظره حتّى يخرج

68
00:05:13,340 --> 00:05:16,710
.سبق ووضعنا أنظارنا عليه أوّلاً
.كان طريدتنا نحن

69
00:05:21,420 --> 00:05:22,320
!أنت، مهلاً

70
00:05:22,790 --> 00:05:24,450
!هل تستمع لي؟

71
00:05:24,450 --> 00:05:26,460
!ثمّة قواعد بين صائدي المكافآت

72
00:05:31,030 --> 00:05:31,930
.عين الصّقر

73
00:05:33,230 --> 00:05:35,730
هل تعرفان عين الصّقر ميهوك؟

74
00:05:35,730 --> 00:05:38,400
ميهوك؟ تقصد أحد الشّيتشيبوكاي؟

75
00:05:38,940 --> 00:05:41,200
،أنا في رحلة هدفي منها هو هزيمته

76
00:05:41,200 --> 00:05:43,670
.وأصبح أعظم سيّافي العالم

77
00:05:44,240 --> 00:05:47,180
،أقوم فعلاً بجمع المكافآت بغرض الأكل

78
00:05:47,640 --> 00:05:49,880
.لكنّ ذلك لا يعني أنّني صائد قراصنة

79
00:05:49,880 --> 00:05:51,910
أعظم سيّافي العالم؟

80
00:05:51,910 --> 00:05:53,250
هل سمعت ذلك يا شريكي؟

81
00:05:53,250 --> 00:05:56,750
!مستحيل! ذلك مستحيل
!لا بدّ أنّك تحلم

82
00:05:57,020 --> 00:05:59,160
.ذلك ما قرّرت فعله مذ كنتُ طفلاً

83
00:05:59,560 --> 00:06:01,520
.لا يهمّ ما قد يقوله أيّ أحد

84
00:06:01,520 --> 00:06:05,030
،حتّى إن كان ذلك حلم طفولتك
...من المستحيل أن

85
00:06:06,730 --> 00:06:09,930
لم أكن أعلم أنّكما كنتما
.تستهدفانه. أنا آسف

86
00:06:10,430 --> 00:06:12,330
.بإمكانكما تسليمه للبحريّة

87
00:06:12,900 --> 00:06:14,600
.مكافأته لكما

88
00:06:14,600 --> 00:06:15,540
هـ-هل أنت جادّ؟

89
00:06:15,940 --> 00:06:16,970
...ولكن

90
00:06:17,610 --> 00:06:19,210
.وجبتي هنا على حسابكما

91
00:06:27,820 --> 00:06:30,790
!نجحنا يا جوني
!حصلنا على خمسة ملايين بيري

92
00:06:30,790 --> 00:06:34,190
،سيكون معنا مال للأكل لوقت طويل
.دون أن نسعى خلف أيّ مكافآت

93
00:06:34,490 --> 00:06:35,690
مهلاً، ما الخطب؟

94
00:06:36,020 --> 00:06:37,290
ألست سعيدًا؟

95
00:06:37,860 --> 00:06:38,760
...لماذا

96
00:06:40,260 --> 00:06:42,160
أصبحت صائد مكافآت؟

97
00:06:42,330 --> 00:06:44,070
ماذا؟ لماذا أصبحت كذلك؟

98
00:06:44,300 --> 00:06:46,970
أليس الأمر واضحًا؟
.لأتمكّن من جني قوت يومي

99
00:06:47,570 --> 00:06:50,770
.كانت القرية الّتي وُلدتُ فيها فقيرة جدًّا

100
00:06:51,270 --> 00:06:55,240
ورغم ذلك، كان قطّاع الطّرق
.يغيرون على أمثالها كثيرًا

101
00:06:55,710 --> 00:06:57,040
،وعندما كانوا يأتون

102
00:06:57,040 --> 00:07:01,720
كان صائدو المكافآت الّذين
.يسعون خلفهم يأتون أيضًا

103
00:07:09,420 --> 00:07:13,990
وعميقًا في داخلي، أردتُ أن أكون
مثل أولئك الرّجال المندفعين

104
00:07:14,290 --> 00:07:16,430
.الّذين تحدّوا قطّاع الطّرق

105
00:07:18,000 --> 00:07:20,270
،قلتُ لنفسي أنّه يومًا ما

106
00:07:20,270 --> 00:07:23,670
آمل فعلاً أن أتمكّن من الإطاحة
.برجال أشرار مثلهم أيضًا

107
00:07:24,140 --> 00:07:26,170
لم أعلم إلاّ بعد وقت لاحق

108
00:07:26,170 --> 00:07:28,640
.أنّهم كانوا يجمعون المكافآت كعمل لهم

109
00:07:28,810 --> 00:07:31,310
،بذكرك للأمر الآن
.أردت أن أصبح مثلهم أيضًا

110
00:07:31,680 --> 00:07:34,250
عندما سمعتُ ما قاله ذلك
،"الرّجل عن "الأعظم في العالم

111
00:07:34,510 --> 00:07:36,850
.ذكّرني بنفسي في الماضي

112
00:07:37,820 --> 00:07:39,790
مهلاً، لماذا تتصرّف بعاطفيّة هكذا؟

113
00:07:39,790 --> 00:07:41,190
.ليس هذا من شيمك

114
00:07:41,190 --> 00:07:42,320
.اخرس

115
00:07:45,890 --> 00:07:46,660
!ما الأمر؟

116
00:07:47,990 --> 00:07:49,760
ما الخطب؟ هل حدث أمر ما؟

117
00:07:50,030 --> 00:07:53,370
قطّاع طرق! تهاجم عصابة ديك
!مزرعة خارج البلدة

118
00:07:53,370 --> 00:07:54,570
قاطع الطّريق ديك؟

119
00:07:57,240 --> 00:07:59,300
!ها هو! مذهل

120
00:07:59,300 --> 00:08:01,570
مكافأة هذا المجرم الخطير
!هي 10 ملايين بيري

121
00:08:06,580 --> 00:08:08,780
!انهبوا كما تشاؤون يا رجال

122
00:08:15,790 --> 00:08:17,720
.كانوا يخفون الكثير

123
00:08:17,720 --> 00:08:19,590
!كان صيدنا وفيرًا اليوم

124
00:08:24,430 --> 00:08:25,430
أهؤلاء هم؟

125
00:08:25,900 --> 00:08:28,800
مهلاً، ما الّذي سنفعله؟
!إنّهم يأخذون كلّ شيء وبسرعة

126
00:08:28,800 --> 00:08:32,240
!إنّه قاطع الطّريق ديك
.نحن لسنا أندادًا له

127
00:08:32,240 --> 00:08:34,370
الأمر لا يستحقّ إن كانت أرواحنا
.هي ما سنخسرها أيضًا

128
00:08:34,370 --> 00:08:35,640
!سُحقًا

129
00:08:38,310 --> 00:08:41,980
!حسنًا، لننتقل للتّالي! خذوا كلّ ما لديهم

130
00:08:47,580 --> 00:08:49,790
ما بال سكّان هذه البلدة؟

131
00:08:49,790 --> 00:08:51,550
.يا لهم من جبناء

132
00:08:51,550 --> 00:08:54,120
ألا يملكون حتّى الشّجاعة لقتالي؟

133
00:08:54,120 --> 00:08:56,260
،حسنًا، ربّما ذلك قرار حكيم
.من ناحية منطقيّة

134
00:08:56,430 --> 00:08:58,700
،هنالك من ينهبون
،وهنالك من يُنهب منهم

135
00:08:58,700 --> 00:09:01,400
ويمكن للمرء أن يكون أحدهما
.أو الآخر في هذه الأيّام

136
00:09:01,400 --> 00:09:04,170
.الضّعف جريمة بحدّ ذاته

137
00:09:04,170 --> 00:09:06,670
المجابهة شيء لا يُقدم عليه
!سوى الحمقى

138
00:09:12,840 --> 00:09:14,940
...ثمّة أحمق بالفعل

139
00:09:15,110 --> 00:09:17,380
!أ-أعد لنا طعامنا

140
00:09:17,380 --> 00:09:20,450
إنّه شيء عملنا جميعًا
!جاهدين على تخزينه

141
00:09:21,080 --> 00:09:22,420
!هاري

142
00:09:25,790 --> 00:09:28,120
.على الأقلّ لديك شجاعة الكبار

143
00:09:29,590 --> 00:09:31,530
!...سُحقًا

144
00:09:31,860 --> 00:09:34,300
!توقّف يا هاري! أنت لست ندًّا له

145
00:09:34,300 --> 00:09:35,430
!هاري

146
00:09:37,430 --> 00:09:38,470
!هيّا بنا

147
00:09:38,770 --> 00:09:42,100
.على رسلك يا شريكي
.حتّى نحن سنخسر أمامه بالكاد

148
00:09:46,510 --> 00:09:49,110
...ذلك ليس السّبب، إنّه

149
00:09:53,820 --> 00:09:55,320
...يُمثّل ما كنتُه ذاك اليوم

150
00:09:59,620 --> 00:10:02,120
لا يعرف كيف يتراجع
.أو الاعتناء بنفسه بعد

151
00:10:06,060 --> 00:10:07,960
.إنّه أنا، عندما كنتُ لا أزال بريئًا

152
00:10:11,570 --> 00:10:13,130
!مهلاً يا جوني

153
00:10:15,140 --> 00:10:17,370
!ما الّذي تعتقد نفسك فاعلاً؟

154
00:10:17,600 --> 00:10:18,440
!من أنت؟

155
00:10:20,940 --> 00:10:23,280
.مجرّد صائد مكافآت مجهول

156
00:10:23,280 --> 00:10:24,880
ماذا قلت؟

157
00:10:56,480 --> 00:10:58,940
أنتما صائدا مكافآت؟

158
00:10:58,940 --> 00:11:00,680
هل تسعيان خلف رأسي؟

159
00:11:00,980 --> 00:11:03,980
.يا للإزعاج. أنتما مجرّد ضبعين انتهازيّين

160
00:11:04,320 --> 00:11:05,380
!بماذا ناديتنا؟

161
00:11:05,380 --> 00:11:08,220
،إن كان المال ما تريدانه
،فسأحسن إليكما ببعضه

162
00:11:08,220 --> 00:11:10,060
.إن كنتما لا تمانعان بعض الفكّة

163
00:11:10,060 --> 00:11:11,960
!لا نريده

164
00:11:11,960 --> 00:11:12,590
ماذا؟

165
00:11:12,960 --> 00:11:17,630
يراودنا شعور بإحلال العدالة
.فحسب هذا اليوم

166
00:11:17,630 --> 00:11:19,060
...ماذا؟ مهلاً يا جوني

167
00:11:19,260 --> 00:11:21,530
شعور بإحلال العدالة؟

168
00:11:26,170 --> 00:11:26,870
...مهلاً

169
00:11:26,870 --> 00:11:27,540
...يا شريكي

170
00:11:28,140 --> 00:11:30,140
هلاّ سمحت لي بأن أكون رجلاً؟

171
00:11:30,140 --> 00:11:30,780
...جوني

172
00:11:34,050 --> 00:11:35,680
جوني، أتقصد...؟

173
00:11:37,580 --> 00:11:38,450
.حسنًا

174
00:11:40,320 --> 00:11:43,390
لا وجود لشيء كالعدالة
!أو الشّرّ في هذه الأيّام

175
00:11:43,390 --> 00:11:46,660
!القوّة هي السّائدة
هذا كلّ ما هنالك، صحيح؟

176
00:11:49,130 --> 00:11:50,890
!نحن جادّان

177
00:11:50,890 --> 00:11:53,000
،نعم! فهذا الصّباح فقط

178
00:11:53,000 --> 00:11:56,870
سلّمنا مجرمًا مكافأته
!خمسة ملايين بيري للبحريّة

179
00:11:57,970 --> 00:11:59,440
سلّمتماه هذا الصّباح للبحريّة؟

180
00:12:03,310 --> 00:12:04,810
...بيلي

181
00:12:04,810 --> 00:12:08,040
!أنتما من سحق أخي الصّغير؟

182
00:12:08,040 --> 00:12:09,180
!ماذا؟

183
00:12:35,470 --> 00:12:37,710
.أنا هنا لاستلام السّيف إن انتهيت منه

184
00:12:38,240 --> 00:12:39,070
.نعم

185
00:12:49,920 --> 00:12:51,390
.موهبتك استثنائيّة

186
00:12:51,890 --> 00:12:53,220
.عملتُ عليه جاهدًا

187
00:12:53,220 --> 00:12:55,960
.أنت متهوّر جدًّا في معاملتك لذلك السّيف

188
00:12:55,960 --> 00:12:57,730
،إن كان سيفًا عاديًّا

189
00:12:57,730 --> 00:13:01,700
لكان لقي نفس مصير
.سيفيك المكسورين هناك

190
00:13:02,160 --> 00:13:04,530
.مفهوم. سأكون حذرًا

191
00:13:20,210 --> 00:13:23,420
!سأصبح أقوى من أجلها أيضًا

192
00:13:23,850 --> 00:13:27,420
سأصبح أقوى بما يكفي
!ليبلغ اسمي عنان السّماء

193
00:13:28,290 --> 00:13:31,260
!سأصبح السّيّاف الأقوى في العالم

194
00:13:38,400 --> 00:13:39,770
.شكرًا على المساعدة

195
00:13:39,770 --> 00:13:43,240
،أودّ أن أدفع لك المزيد
!لكن لسوء الحظّ، أنا مفلس الآن

196
00:13:43,470 --> 00:13:44,840
.لا تقلق حيال ذلك

197
00:13:44,840 --> 00:13:47,310
.لا يتسنّى لي رؤية غرض مثله دائمًا

198
00:13:47,310 --> 00:13:49,180
.كان تُحفة لناظريّ بالفعل

199
00:13:49,180 --> 00:13:52,480
.ليس كهذا السّيف الطّويل معدوم النّفع

200
00:13:54,450 --> 00:13:56,880
!مهلاً، ألم أحذّرك؟

201
00:13:56,880 --> 00:13:58,020
!ترأّف بي

202
00:13:58,020 --> 00:14:00,950
،لا يهمّ كم ستحمل من السّيوف
!لن تكون كافية أبدًا هكذا

203
00:14:00,950 --> 00:14:03,190
.سُحقًا، ها قد فعلتُها ثانية

204
00:14:03,190 --> 00:14:05,590
.آسف، سأحرص على تعويضك

205
00:14:09,330 --> 00:14:11,830
.إنّه ذلك الوغد ديك، حوت الجبل

206
00:14:11,830 --> 00:14:14,530
إنّه قاطع طريق مكافأته عشرة
!ملايين بيري ويستعمل مدفعًا

207
00:14:15,030 --> 00:14:17,440
قاطع طريق بمكافأة على رأسه؟

208
00:14:33,950 --> 00:14:34,950
!سُحقًا

209
00:14:38,160 --> 00:14:41,460
.لا فائدة. إنّه أكثر ممّا يستطيعان تحمّله

210
00:14:49,800 --> 00:14:51,800
ما هذا؟

211
00:14:52,100 --> 00:14:54,810
هل أنتما فعلاً من أطاحا بأخي الصّغير؟

212
00:14:55,670 --> 00:14:57,980
،نحن من سلّم بيلي

213
00:14:57,980 --> 00:15:00,240
!لكنّ شخصًا آخر هزمه أيّها الوغد

214
00:15:00,240 --> 00:15:02,210
لماذا تتفاخران بذلك إذًا؟

215
00:15:02,210 --> 00:15:04,450
.ظننتُ فعلاً أنّكما أضعف من ذلك

216
00:15:04,680 --> 00:15:05,920
!اخرس

217
00:15:22,770 --> 00:15:25,900
.يا إلهي، يا لمثابرتكما

218
00:15:29,610 --> 00:15:30,610
!توقّف

219
00:15:31,740 --> 00:15:32,440
!مهلاً

220
00:15:32,780 --> 00:15:34,040
!...أيّها الـ

221
00:15:34,380 --> 00:15:36,150
!أتريد الموت لهذه الدّرجة؟

222
00:15:43,450 --> 00:15:44,590
!يا زعيم

223
00:15:44,590 --> 00:15:47,460
انتهينا من تحميل كلّ شيء
.نهبناه على العربة

224
00:15:47,460 --> 00:15:51,330
.انتهيتم؟ لنغادر المكان إذًا

225
00:15:51,330 --> 00:15:54,060
لا فائدة من العبث هنا
.مع هؤلاء الضّعفاء

226
00:15:55,700 --> 00:15:57,200
!انتظر

227
00:15:58,770 --> 00:16:01,140
!قلت لك انتظر أيّها المجرم المطلوب

228
00:16:01,640 --> 00:16:06,910
لقد سلّمنا العشرات... بل المئات
!من أصحاب المكافآت بالكاد

229
00:16:07,280 --> 00:16:09,380
،إن سمحنا لك بالإفلات

230
00:16:09,380 --> 00:16:11,580
!فسيلحق بنا العار للأجيال القادمة

231
00:16:12,510 --> 00:16:14,120
.يا للخسارة

232
00:16:14,520 --> 00:16:16,950
الأمر لا يستحقّ، صحيح؟

233
00:16:17,650 --> 00:16:21,460
...ربّما لن نكسب شيئًا... ولكن

234
00:16:22,890 --> 00:16:27,160
هنالك أوقات على الرّجل أن يثبَت
!على ما يؤمن به ويقاتل

235
00:16:29,530 --> 00:16:32,000
.أنتما لن تعيشا طويلاً في هذه الحياة

236
00:16:32,000 --> 00:16:34,140
!عرفنا ذلك عندما بدأنا هذا

237
00:16:34,570 --> 00:16:35,870
.فهمت

238
00:16:36,340 --> 00:16:39,070
!يا رجال! تولّوا أمر هذان الرّجلان في الحال

239
00:16:41,740 --> 00:16:42,710
!لننل منهما

240
00:16:42,710 --> 00:16:43,410
!ابتعد

241
00:16:58,160 --> 00:17:00,960
!ماذا تريد؟! أفلتني
!إنّهما يقاتلان من أجلي

242
00:17:01,230 --> 00:17:02,930
...إن كنت تريد القتال

243
00:17:04,060 --> 00:17:07,830
ففكّر مليًّا. ماذا بمقدورك
فعله بما لديك من قوّة؟

244
00:17:24,220 --> 00:17:26,790
.يا إلهي، مسكينان

245
00:17:27,120 --> 00:17:30,760
لا توجد منطقة في وجهيكما
.لم تُضرب بعد

246
00:17:30,760 --> 00:17:33,190
.أعتقد أنّ الوقت حان لإنهاء هذا

247
00:17:34,930 --> 00:17:39,330
،لم أكسب أيّ فلس من قتلكما

248
00:17:39,600 --> 00:17:42,500
.لكن اعتبرا هذا مصيركما المحتوم

249
00:17:42,870 --> 00:17:46,610
حظّكما التّعيس الّذي كسبتماه
.من محاولتكما السّعي خلف رأسي

250
00:17:46,870 --> 00:17:50,710
لكن استريحا، سأرسلكما
.للعالم الآخر معًا كشريكين

251
00:17:54,050 --> 00:17:55,150
!خذا هذه

252
00:17:56,980 --> 00:17:57,820
!ها أنا ذا

253
00:18:05,360 --> 00:18:07,090
هذا يكفي، ألا تظنّ ذلك؟

254
00:18:07,430 --> 00:18:09,260
.انتهى هذا القتال منذ مدّة

255
00:18:12,960 --> 00:18:13,760
...أنت

256
00:18:14,470 --> 00:18:15,730
...ذلك الرّجل

257
00:18:16,000 --> 00:18:19,940
.سامحاني، لكنّني سآخذ طريدتكما منكما

258
00:18:21,170 --> 00:18:23,740
.فأنا بحاجة شديدة ومفاجئة للمال

259
00:18:23,740 --> 00:18:25,080
...أ-أكيد

260
00:18:25,710 --> 00:18:26,610
.حسنًا

261
00:18:29,610 --> 00:18:30,650
من يكون؟

262
00:18:32,620 --> 00:18:35,820
سـ-سيف بغمد أبيض...؟

263
00:18:38,390 --> 00:18:40,760
.سأحتاج لاستعارة سيفيكما لبعض الوقت

264
00:18:41,160 --> 00:18:43,830
—لا مشكلة، لكن ما الّذي تنوي أن

265
00:18:44,930 --> 00:18:47,460
!...ثلاثة سيوف؟! لا يُعقل

266
00:18:48,600 --> 00:18:51,600
!صائد القراصنة رورونوا زورو؟

267
00:18:54,200 --> 00:18:57,910
فعلاً؟ هذا هو صائد القراصنة الخرافيّ إذًا؟

268
00:18:58,540 --> 00:19:00,880
ما الّذي يحدث هنا إذًا؟

269
00:19:01,440 --> 00:19:04,410
،أكيد أنّني أصبحتُ أقوى في الآونة الأخيرة

270
00:19:04,780 --> 00:19:07,950
لكن بمجرّد أن أستعمل الكثير
.من قوّتي، تُكسر سيوفي

271
00:19:08,520 --> 00:19:11,320
لا يجب أن أقوم بالمبالغة
.في استعمال قوّتي بتهوّر

272
00:19:11,850 --> 00:19:13,390
،مهما كان السّيف

273
00:19:13,390 --> 00:19:16,730
عليّ أن أبلغ النّقطة الّتي أستطيع
.إطلاق 100% من قوّته

274
00:19:20,330 --> 00:19:24,470
حتّى باستعمال ثلاثة سيوف
،يا رورونوا زورو

275
00:19:24,470 --> 00:19:28,740
لا أظنّك ستكون قادرًا على هزيمة
.هذا العدد الكبير من الرّجال دفعةً واحدة

276
00:19:31,040 --> 00:19:35,640
استعمال ثلاثة سيوف لا يشبه
.استعمال أسلوب السّيوف الثّلاثة

277
00:19:35,880 --> 00:19:37,650
أقلت أسلوب السّيوف الثّلاثة؟

278
00:19:37,650 --> 00:19:39,580
لنره إذًا، ما الضّرر من ذلك؟

279
00:19:39,580 --> 00:19:41,120
!نالوا منه يا رجال

280
00:19:55,060 --> 00:19:56,760
!لقد فعلها! مذهل

281
00:19:57,000 --> 00:19:58,230
!هذا ممتاز

282
00:20:00,430 --> 00:20:01,300
!انتبه

283
00:20:09,910 --> 00:20:11,410
!رائع

284
00:20:26,060 --> 00:20:28,390
.أخبرتك ألاّ تقفي قربي

285
00:20:28,690 --> 00:20:30,760
.ستصاب بالزّكام إن لم ترتدي ملابس كافية

286
00:20:31,060 --> 00:20:34,030
إنّ من يصابون بالزّكام هم
.من يرخون دفاعات عقولهم

287
00:20:34,330 --> 00:20:36,770
أتساءل إن وُجد شخص ما

288
00:20:36,770 --> 00:20:39,640
.يروي قصصًا عن صائد القراصنة، زورو

289
00:20:39,840 --> 00:20:42,610
.لم أدعُ نفسي يومًا بصائد القراصنة

290
00:20:42,910 --> 00:20:46,580
إذًا من منحك اسمًا رائعًا كهذا؟

291
00:20:47,450 --> 00:20:50,550
.لا أدري. لا أهمّيّة لذلك عندي

292
00:21:08,500 --> 00:21:10,340
!كـ-كلاّ! نيراني

293
00:21:10,640 --> 00:21:12,500
!قاطع الغول

294
00:21:16,410 --> 00:21:19,780
...هذا إذًا... أسلوب السّيوف الثّلاثة

295
00:21:26,880 --> 00:21:28,550
.حسنًا، لم تنكسر السّيوف

296
00:21:29,450 --> 00:21:30,350
.شكرًا على المساعدة

297
00:21:32,660 --> 00:21:34,090
!رورونوا زورو

298
00:21:34,890 --> 00:21:38,100
.أنا مندهش جدًّا بمهاراتك
هلاّ سمحت لنا بالانضمام لك؟

299
00:21:38,500 --> 00:21:40,460
،نحن ثنائيّ صائدي مكافآت

300
00:21:40,460 --> 00:21:42,800
،مرعبان بما يكفي بالكاد
،لإسكات طفل يبكي

301
00:21:42,800 --> 00:21:44,330
!يوساكو وجوني

302
00:21:45,670 --> 00:21:47,040
.افعلا ما يحلو لكما

303
00:21:52,240 --> 00:21:54,910
!أخي الكبير

304
00:21:55,470 --> 00:22:03,650
آه، خلف السّماء الّتي لا نهاية لها

305
00:22:03,650 --> 00:22:14,260
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

306
00:22:22,130 --> 00:22:29,570
مرّت عليّ أيّام كدت أخسر فيها نفسي

307
00:22:29,570 --> 00:22:37,980
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

308
00:22:37,980 --> 00:22:46,190
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

309
00:22:46,190 --> 00:22:55,030
دفعوا بي للأمام، أليس كذلك؟

310
00:22:55,030 --> 00:23:03,370
آه، إنّ النّجوم تهوي من السّماء

311
00:23:03,370 --> 00:23:06,470
...وهذه اللّحظة الفريدة

312
00:23:11,850 --> 00:23:12,650
!لوفي

313
00:23:12,650 --> 00:23:13,110
ماذا؟

314
00:23:13,110 --> 00:23:15,420
.لنسرع ونغادر هذه الجزيرة

315
00:23:15,420 --> 00:23:17,620
.يبدو أنّها ستسبّب لنا المشاكل فحسب

316
00:23:17,620 --> 00:23:20,790
يراودني شعور من ذلك
.العجوز مماثل لك

317
00:23:20,790 --> 00:23:22,960
فعلاً؟ لا داعي للقلق إذًا، صحيح؟

318
00:23:23,590 --> 00:23:25,460
!كلاّ، لهذا السّبب أنا قلق

319
00:23:25,460 --> 00:23:26,660
فعلاً؟

320
00:23:26,660 --> 00:23:28,060
:في الحلقة القادمة من ون بيس

321
00:23:28,060 --> 00:23:31,560
زيني من جزيرة الجديان"
"!وسفينة القراصنة في الجبال

322
00:23:31,560 --> 00:23:33,800
!ملك القراصنة، لن يكون إلاّ أنا