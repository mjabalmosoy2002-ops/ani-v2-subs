1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:32,680 --> 00:02:36,140
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:36,140 --> 00:02:41,440
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:41,440 --> 00:02:47,650
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

32
00:02:47,650 --> 00:02:49,320
.وأصدقاؤه يغامرون في ذلك البحر

33
00:02:50,120 --> 00:02:53,660
!ملك القراصنة، لن يكون إلاّ أنا

34
00:03:00,040 --> 00:03:02,920
،دخل طاقم قبّعة القشّ أخيرًا إلى العالم الجديد

35
00:03:02,920 --> 00:03:05,290
.البحر الأعنف الّذي يحكمه اليونكو

36
00:03:06,220 --> 00:03:10,180
.بعد علمهم بدافع حاكم الجزيرة سيزار كلاون

37
00:03:10,550 --> 00:03:12,820
،بينما يحاولون الهرب من شينوكوني

38
00:03:12,820 --> 00:03:16,020
،إلى جانب حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

39
00:03:16,020 --> 00:03:19,410
،إنّهم في طريقهم لاختطاف سيزار

40
00:03:19,410 --> 00:03:23,200
.وإنقاذ الأطفال والهرب من الجزيرة

41
00:03:25,600 --> 00:03:28,700
!أمسك بي إن استطعت! لكنّي محميّ

42
00:03:28,700 --> 00:03:31,700
!دوفلامينغو! اليونكو

43
00:03:31,700 --> 00:03:35,370
هل تملك الجرأة حتّى لتشنّ حربًا عليهم؟

44
00:03:37,620 --> 00:03:41,250
!لا أظنّ ذلك! إن كنت تريد الهرب فهذه فرصتك

45
00:03:39,420 --> 00:03:40,710
حرب؟

46
00:03:41,570 --> 00:03:44,300
!اغرب عن وجهي

47
00:03:57,890 --> 00:03:59,140
...لقد كنتُ

48
00:04:00,190 --> 00:04:02,390
!أحارب طوال هذا الوقت

49
00:04:06,670 --> 00:04:10,890
"!نتيجة مفاجئة! الصّيّاد الأبيض ضدّ فيرغو"

50
00:04:13,460 --> 00:04:16,510
!سـ-سيّدي

51
00:04:30,170 --> 00:04:32,550
!هذا مؤلم، مؤلم، مؤلم... أنفي

52
00:04:32,770 --> 00:04:34,990
!كسرت أنفي

53
00:04:34,990 --> 00:04:36,850
!كيف تجرؤ! سحقًا

54
00:04:36,850 --> 00:04:38,600
...هذا مؤلم، مؤلم، مؤلم

55
00:04:39,810 --> 00:04:43,650
!سحقًا لك! هل كنت تنصت لي أساسًا؟

56
00:04:43,650 --> 00:04:46,520
!لن تسلم بفعلتك هذه

57
00:04:47,540 --> 00:04:51,530
!فذلك القرصان المجنون يدعمني

58
00:04:52,030 --> 00:04:56,300
!أحد الشّيتشيبوكاي الملكيّين، دونكيهوتي دوفلامينغو

59
00:04:57,330 --> 00:05:02,290
!إنّه من يتحكّم بزمام أمور العالم الجديد خلف الكواليس

60
00:05:02,290 --> 00:05:04,880
...الأسلحة الخفيفة وأسلحة حربيّة ومخدّرات

61
00:05:04,880 --> 00:05:08,630
!إنّه مشترك في كلّ اتّفاقية محفوفة بالمخاطر

62
00:05:10,760 --> 00:05:13,600
!إنّه العقل المدبّر لعالم الجريمة

63
00:05:13,600 --> 00:05:16,730
!وله علاقة بكلّ الشّخصيّات شائنة السّمعة

64
00:05:17,510 --> 00:05:20,900
!لستَ ندًّا له

65
00:05:20,900 --> 00:05:24,100
!سيُخضعك في غضون دقائق

66
00:05:24,100 --> 00:05:28,340
!أنت وأصدقاؤك

67
00:05:31,740 --> 00:05:35,320
.لـ-لكن ما زال بإمكاني أن أصفح عن حياتك

68
00:05:35,320 --> 00:05:37,550
...إ-إن اعتذرت الآن

69
00:05:40,080 --> 00:05:44,010
فكّر في كم من وحش

70
00:05:44,010 --> 00:05:46,500
!ستغضبه إلى فعلت لي شيئًا

71
00:05:46,580 --> 00:05:47,340
!مفهوم؟

72
00:05:47,540 --> 00:05:50,670
!أنت، هل تنصت؟

73
00:05:50,670 --> 00:05:53,390
!أقصد الشّيتشيبوكاي واليونكو

74
00:05:53,390 --> 00:05:54,960
...سوف

75
00:05:54,960 --> 00:05:57,630
!يغرقونك في البحر في طرفة عين

76
00:05:58,010 --> 00:06:02,310
...إ-إن اعتذرت الآن، سأسامحك

77
00:06:05,400 --> 00:06:07,400
!غاستيل

78
00:06:12,080 --> 00:06:13,700
!نلتَ ما تستحقّ

79
00:06:13,700 --> 00:06:14,900
!أجل

80
00:06:14,900 --> 00:06:17,370
!هجوم غاز حارق يستطيع إذابة الحديد

81
00:06:20,660 --> 00:06:25,290
!هل انصهر؟ أم تحوّل إلى رماد؟

82
00:06:32,410 --> 00:06:36,290
!أ-أ-أ-أعلم! لا يبدو هذا حقيقيًّا، أليس كذلك؟

83
00:06:36,290 --> 00:06:40,010
!هذا كثير بالنّسبة لناشئ أتى من العالم الجديد

84
00:06:40,010 --> 00:06:42,890
.لكنّ أحد أولئك الوحوش هنا في المختبر

85
00:06:43,330 --> 00:06:44,490
!إنّه فيرغو

86
00:06:44,490 --> 00:06:48,100
!ولا أحد يستطيع مواجهة هاكي التّسلّح خاصّته

87
00:06:48,100 --> 00:06:50,820
!سموكر ولو في عداد الموتى

88
00:06:51,340 --> 00:06:53,300
!وكذلك كلّ أفراد طاقمك

89
00:06:53,940 --> 00:06:56,090
!قـ-قـ-قلت أنّكم ستموتون جميعًا

90
00:06:56,090 --> 00:06:57,990
...لـ-لـ-لذا لِمَ لا تنصت لي

91
00:06:58,360 --> 00:07:00,410
...أخبرتك

92
00:07:03,160 --> 00:07:06,080
!أنّني لا أهتمّ

93
00:07:11,450 --> 00:07:12,710
...سموكر

94
00:07:19,180 --> 00:07:20,260
!فيرغو

95
00:07:23,390 --> 00:07:26,140
!كيف تجرؤ على العبث مع البحريّة؟

96
00:07:26,140 --> 00:07:29,760
.أنت ضعيف جدًّا لأن تهزمني

97
00:07:49,790 --> 00:07:51,210
.لا تتعلّم درسك أبدًا

98
00:07:51,460 --> 00:07:55,680
.مهاراتي الأساسيّة في القتال والهاكي أفضل من خاصّتك

99
00:07:55,680 --> 00:07:57,310
أما زلت لا تفهم؟

100
00:08:05,890 --> 00:08:06,810
!بطيء جدًّا

101
00:08:26,740 --> 00:08:28,910
!الهجوم الأبيض

102
00:08:51,230 --> 00:08:56,070
تواصل قتالي لأنّك غاضب لأنّني خنت البحريّة؟

103
00:08:57,070 --> 00:08:58,800
!أريد تسوية المسألة فحسب

104
00:08:58,800 --> 00:09:01,740
!عليّ أن أقضي عليك بيديّ هاتين

105
00:09:02,610 --> 00:09:05,400
!أيّها القرصان فيرغو

106
00:09:05,990 --> 00:09:09,160
.الهاكي خاصّتك ليس جيّدًا كفايةً لهزيمتي

107
00:09:09,870 --> 00:09:11,840
لِمَ لا ترى ذلك؟

108
00:09:17,510 --> 00:09:22,150
.الشّينوكوني هو غاز قاتل يُحجّر أجساد النّاس ويقتلهم

109
00:09:22,840 --> 00:09:26,360
.وهو يتدفّق الآن داخل المختبر

110
00:09:29,020 --> 00:09:30,930
!مهلاً، ما الّذي تفعله؟

111
00:09:30,930 --> 00:09:32,630
،إن اتّجهتَ مباشرةً

112
00:09:32,630 --> 00:09:34,730
!لكنّا الآن لحقنا بالأطفال

113
00:09:34,730 --> 00:09:37,520
!اخرسي! أنت جريحة، فأطبقي فمك

114
00:09:37,520 --> 00:09:39,190
!أنا ذاهب مباشرةً

115
00:09:39,230 --> 00:09:41,610
!لا! ليس من هذا الاتّجاه

116
00:09:41,610 --> 00:09:43,330
!لا! ابتعدت كثيرًا

117
00:09:43,330 --> 00:09:45,500
!كيف تخطئ في شيء بهذه البساطة؟

118
00:09:45,500 --> 00:09:46,740
!اخرسي

119
00:09:49,240 --> 00:09:51,500
!أسرعوا يا أطفال! واصلوا

120
00:09:51,870 --> 00:09:55,290
.أشعر بالدّوار. أشعر وكأنّني كنت أحلم

121
00:09:55,290 --> 00:09:57,110
.هذا بسبب المهدّئات

122
00:09:57,110 --> 00:09:59,170
!إنّها لا تضرّ، فلا تقلقوا

123
00:09:59,670 --> 00:10:04,970
!رفاق! لا تشيحوا أنظاركم عن الأطفال

124
00:10:04,970 --> 00:10:07,140
!حاضر يا أخي

125
00:10:07,410 --> 00:10:09,930
!أجل

126
00:10:09,930 --> 00:10:12,120
!موتشا! ابقي معي

127
00:10:12,120 --> 00:10:14,030
!ستكونين بخير قريبًا

128
00:10:14,030 --> 00:10:16,600
!تشجّعي! أخرجيها كلّها

129
00:10:19,900 --> 00:10:23,860
...النّاجون متّجهون إلى المبنى "ر"، الطّابق الأوّل

130
00:10:25,910 --> 00:10:28,110
!وساحة المعركة بين لوفي وسيزار

131
00:10:28,870 --> 00:10:32,620
...في نفس الأثناء، يبحث كينييمون على ابنه مومونوسكي

132
00:10:33,330 --> 00:10:37,000
!ماذا فعلت؟! مومونوسكي

133
00:10:37,460 --> 00:10:41,590
!ماذا؟! تحوّل مومونوسكي إلى تنّين صغير؟

134
00:10:41,590 --> 00:10:42,510
!نعم

135
00:10:43,000 --> 00:10:45,400
.لا ينبغي أن أخبر أيّ أحد، لكنّ هذا صحيح

136
00:10:47,720 --> 00:10:49,640
...ربّما قمتُ

137
00:10:49,890 --> 00:10:53,470
!بتقطيع مومونوسكي؟

138
00:10:55,480 --> 00:10:57,440
!مومونوسكي

139
00:10:57,850 --> 00:11:00,230
!اقترفت أمرًا فظيعًا

140
00:11:00,320 --> 00:11:03,280
!كينييمون-سان، لا يمكنك أن تعود

141
00:11:03,280 --> 00:11:05,740
...تلك المنطقة مليئة بالغاز الآن

142
00:11:07,410 --> 00:11:10,490
!الغاز السّامّ أمامنا مباشرةً

143
00:11:10,780 --> 00:11:12,940
!سأخترق أيّ شيء بروحي

144
00:11:12,940 --> 00:11:15,040
!سواء كان نارًا أو غازًا

145
00:11:15,040 --> 00:11:16,830
!مومونوسكي

146
00:11:16,830 --> 00:11:20,380
!لا، هذا مستحيل! كينييمون-سان

147
00:11:24,170 --> 00:11:27,940
.أصفاد الحجر البحريّ... قد تكون هنا

148
00:11:29,470 --> 00:11:31,430
!لا، ليس هنا

149
00:11:31,430 --> 00:11:36,390
.لأنّني سمعت "منبّه أوسوبّ" يرنّ في رأسي للتّوّ

150
00:11:37,390 --> 00:11:40,320
.أجل، لنتظاهر فحسب أنّني تفقّدت هذه الغرفة

151
00:11:40,320 --> 00:11:41,240
!هذه هي

152
00:11:41,240 --> 00:11:45,300
سأخبرهم "بحثت في كلّ مكان عن
...أصفاد الحجر البحريّ لكنّي لم أجدها

153
00:11:46,070 --> 00:11:47,650
"!في هذه الغرفة

154
00:12:02,870 --> 00:12:04,330
!إنّه عدوّ

155
00:12:05,420 --> 00:12:07,880
!لِمَ يحدث لي هذا دائمًا؟

156
00:12:44,750 --> 00:12:46,630
...الهجوم

157
00:12:46,630 --> 00:12:48,840
!الأبيض

158
00:13:01,600 --> 00:13:05,260
هل رضيت الآن يا سموكر-كن؟

159
00:13:26,420 --> 00:13:29,460
،مهما كان إيمانك بالعدالة عميقًا

160
00:13:30,080 --> 00:13:32,420
!فأنت بلا حيلة إن كنت ضعيفًا

161
00:13:58,120 --> 00:13:58,910
ماذا تريد؟

162
00:14:05,650 --> 00:14:07,920
،إن استطعت استعادة قلبي

163
00:14:07,920 --> 00:14:12,800
!فسأوسعك ضربًا بسهولة يا فيرغو

164
00:14:13,090 --> 00:14:15,640
!لا تجعلني أكرّر كلامي أيّها الشّقيّ

165
00:14:16,480 --> 00:14:19,390
!نادني فيرغو-سان

166
00:14:37,030 --> 00:14:40,540
.تاشيغي، أريد منك قيادة جنود جي-5

167
00:14:40,540 --> 00:14:42,950
إلى أين أنت ذاهب يا سموكر-سان؟

168
00:14:42,950 --> 00:14:44,580
!لا تقل لي أنّك تسعى خلف فيرغو

169
00:14:44,790 --> 00:14:49,360
!لا يمكن للقانون أن يسوّي هذه المسألة يا تاشيغي

170
00:14:50,130 --> 00:14:53,460
!بل عليّ أن أسوّيها بيديّ! كان يعبث مع البحريّة

171
00:14:54,220 --> 00:14:55,950
!توقّفي يا تاشيغي

172
00:14:55,950 --> 00:14:58,430
!ألا تفضّلين الموت على أن تترجّي قرصانًا؟

173
00:14:58,430 --> 00:15:00,360
،حاليًّا، علينا أن نتضرّع من أجل حياتنا

174
00:15:00,360 --> 00:15:02,010
!وإن عنى ذلك أن نركع أمامه

175
00:15:02,020 --> 00:15:06,060
!لأنّنا إن متنا هنا، فلن نستطيع إنقاذ رجالنا

176
00:15:06,060 --> 00:15:07,730
...والأطفال

177
00:15:13,570 --> 00:15:16,780
!ستموت هنا أيضًا يا لو

178
00:15:33,000 --> 00:15:35,130
...سموكر

179
00:15:36,510 --> 00:15:38,890
أما زلت تريد القتال يا سموكر-كن؟

180
00:15:39,390 --> 00:15:43,010
.تدري أنّك لست ندًّا لي

181
00:15:51,810 --> 00:15:53,610
ماذا تفعل؟

182
00:15:55,860 --> 00:15:58,730
لا ينبغي أن تتحوّل إلى دخان وتنشر نفسك

183
00:15:58,730 --> 00:16:01,280
.بينما تواجه مستعمل هاكي أفضل منك

184
00:16:08,580 --> 00:16:10,640
!فذلك يسهّل عليّ ضربك فحسب

185
00:16:24,890 --> 00:16:27,480
لِمَ تواصل استخدام قوّة فاكهة الشّيطان خاصّتك؟

186
00:16:27,480 --> 00:16:29,480
ألا تستطيع التّفكير بشكل صائب؟

187
00:16:30,400 --> 00:16:33,950
.هذا ليس من طبعك يا سموكر-كن

188
00:16:38,640 --> 00:16:40,580
!يكفي عبثًا

189
00:16:55,260 --> 00:16:56,550
!خيزران الشّيطان

190
00:17:11,760 --> 00:17:15,210
.أعلم أنّك تريد قتلي لعبثي مع البحريّة

191
00:17:16,770 --> 00:17:19,850
.لكن عليك أن تكون قويًّا كفايةً لفعل ذلك يا سموكر

192
00:17:20,400 --> 00:17:23,360
.إن كنت متهوّرًا فحسب، فلن تجعل رجالك فخورين بك

193
00:17:29,900 --> 00:17:31,040
.انتهى الأمر

194
00:17:42,260 --> 00:17:45,140
...سموكر، قلبي

195
00:17:46,130 --> 00:17:48,350
!شكرًا لاسترجاعه

196
00:17:51,810 --> 00:17:53,730
!بات الأمر منطقيًّا الآن أيّها الوغد

197
00:17:55,380 --> 00:17:57,570
!لهذا تحوّلتَ إلى دخان

198
00:18:01,610 --> 00:18:03,490
.نحن متساويان الآن

199
00:18:04,460 --> 00:18:06,320
!أجهز عليه فحسب

200
00:18:07,450 --> 00:18:10,810
لا تريد أن تكون مدينًا لقرصان إذًا؟

201
00:18:12,370 --> 00:18:14,470
.تلك وصمة عار بالنّسبة لجنديّ بحريّة

202
00:18:14,470 --> 00:18:16,580
.أشعر بالعار لأن أظهر نفسي لرجالي

203
00:18:16,790 --> 00:18:17,790
...ولكن

204
00:18:19,250 --> 00:18:21,960
.كانت تلك مجرّد مساعدة احتجتها

205
00:18:24,930 --> 00:18:26,680
.انتهى الأمر

206
00:18:27,680 --> 00:18:29,880
.يا فيرغو... سان

207
00:18:30,810 --> 00:18:32,670
!أيّها الشّقيّ

208
00:18:32,670 --> 00:18:35,860
هل تذكّرت الآن أنّني أفضل منك؟

209
00:18:35,860 --> 00:18:38,050
.أريدك أن تواصل التّفكير هكذا فحسب

210
00:18:39,230 --> 00:18:42,460
!لكن لا يمكنك أن تظلّ جالسًا على ذلك "العرش" إلى الأبد

211
00:18:43,320 --> 00:18:44,030
!أنتما الاثنان

212
00:18:47,070 --> 00:18:49,870
!"أدري أنّك تنصت يا "جوكر

213
00:19:00,090 --> 00:19:02,930
.فيرغو في عداد الأموات يا جوكر

214
00:19:03,380 --> 00:19:05,980
.أنت على وشك أن تفقد يدك اليمنى

215
00:19:06,430 --> 00:19:08,850
.وسيعتني قبّعة القشّ-يا بسيزار

216
00:19:09,680 --> 00:19:12,950
.ما يعني أنّك ستفقد "إس إيْ دي" أيضًا

217
00:19:13,520 --> 00:19:18,650
.لم تترقّب حدوث هذا لأنّك كنتَ واثقًا أكثر من اللاّزم

218
00:19:19,270 --> 00:19:21,740
لذا لِمَ لا تواصل الضّحك بتعالٍ كما المعتاد

219
00:19:21,740 --> 00:19:23,860
.وتفكّر بشأن خطوتك القادمة

220
00:19:24,410 --> 00:19:28,680
...لكنّك لن تضحك طويلاً

221
00:19:30,070 --> 00:19:32,870
!لأنّنا سنفعل ما يعجز العقل على تصوّره

222
00:19:38,920 --> 00:19:42,200
!أحسنت في ادّعاء القوّة يا ولد

223
00:19:43,840 --> 00:19:47,460
لكن هل أنت واثق أنّك ستنجو؟

224
00:19:47,460 --> 00:19:49,610
.انظر إلى فيرغو أمامك

225
00:19:50,600 --> 00:19:53,180
ألم تثر غيضه؟

226
00:20:00,810 --> 00:20:05,000
أتذكر ما حدث آخر مرّة؟

227
00:20:05,000 --> 00:20:06,610
كيف سار الأمر؟

228
00:20:06,610 --> 00:20:10,510
أثرت غيض فيرغو ثمّ ماذا حدث؟

229
00:20:12,830 --> 00:20:16,450
.لا بدّ أنّك لم تستطع نسيان الأمر من وقعِ الصّدمة

230
00:20:16,790 --> 00:20:19,290
.لا بدّ أنّك خائف من فيرغو

231
00:20:20,750 --> 00:20:23,750
،فحتّى مع مسايفتك الّتي لا تضاهى

232
00:20:24,380 --> 00:20:27,120
.فإنّ الهاكي خاصّته سيخوّل له أن يصدّ كلّ هجماتك

233
00:20:27,760 --> 00:20:31,280
،لا من حيث المكانة أو القوّة

234
00:20:31,280 --> 00:20:35,060
!لستَ ندًّا لفيرغو

235
00:20:43,240 --> 00:20:44,420
!هيّا

236
00:21:46,710 --> 00:21:49,960
.مضت سنتان على حرب القمّة

237
00:21:53,090 --> 00:21:56,760
هل حقّق أيّ أحد شيئًا؟

238
00:21:57,810 --> 00:22:00,520
.ظللتم هادئين فحسب

239
00:22:01,730 --> 00:22:05,150
.وكلّ ما فعل اللّحية البيضاء كان إنهاء عصر

240
00:22:06,860 --> 00:22:10,000
.جمعت قيادة البحريّة قوّات جديدة

241
00:22:11,570 --> 00:22:13,750
!ولم تتّخذ كبار الشّخصيّات أيّ أفعال

242
00:22:15,410 --> 00:22:18,670
.وكأنّ الجميع كانوا يجهّزون لشيء ما

243
00:22:19,540 --> 00:22:22,940
.كانت تلك الحرب ما إلاّ البداية

244
00:22:28,840 --> 00:22:31,620
...لطالما أخبرتني

245
00:22:32,340 --> 00:22:34,850
أنّ عصر الشّجعان الجديد

246
00:22:35,340 --> 00:22:39,200
!يدنو بموجة لا يمكن إيقافها

247
00:22:44,100 --> 00:22:47,770
!لقد كسرت... التّرس

248
00:22:53,530 --> 00:22:56,030
،والآن

249
00:22:57,010 --> 00:22:58,760
!ما عادت هنالك رجعة

250
00:23:10,570 --> 00:23:13,630
.قلب هجوم لو الموازين في لحظة

251
00:23:13,630 --> 00:23:17,330
.يحتشد قراصنة قبّعة القشّ ويبحثون عن مهرب سريع

252
00:23:17,710 --> 00:23:20,720
...لكنّ سيزار، في أوجّ غضبه

253
00:23:20,720 --> 00:23:22,940
...يطلق هجومًا شنيعًا على لوفي

254
00:23:22,940 --> 00:23:26,020
.يبيد الصّديق كما العدوّ

255
00:23:26,020 --> 00:23:27,400
:في الحلقة القادمة من وان بيس

256
00:23:27,400 --> 00:23:30,730
"!هزيمة سيزار! ماغنوم الدّبّ الأشيب القويّ"

257
00:23:30,730 --> 00:23:32,820
!ملك القراصنة، لن يكون إلاّ أنا

258
00:23:36,030 --> 00:23:41,030
!!نراكم في الحلقة القادمة