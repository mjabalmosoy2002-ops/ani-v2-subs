1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,530
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إننا كذلك

25
00:01:51,650 --> 00:01:52,940
.سوغيكينغ

26
00:01:54,610 --> 00:01:56,770
.أطلق على ذلك العلم

27
00:01:57,160 --> 00:01:58,360
.عُلم

28
00:02:00,380 --> 00:02:03,620
هذا سلاحي الجديد، المقلاع
!الضّخم... وأسميته كابوتو

29
00:02:04,180 --> 00:02:06,570
!أمعنوا النّظر إلى قوّته

30
00:02:06,570 --> 00:02:10,000
!القتل المؤكّد: نجم طائر النّار

31
00:02:19,140 --> 00:02:20,170
!مستحيل

32
00:02:24,100 --> 00:02:25,300
!تمّت المهمّة

33
00:02:25,940 --> 00:02:29,190
هل أنتم مجانين؟! لا تظنّوا أنّكم ستنجون

34
00:02:29,190 --> 00:02:31,020
!بعد جعلكم للعالم بأسره عدوًّا لكم

35
00:02:31,270 --> 00:02:35,900
!تلك غايتي من الأساس

36
00:02:39,660 --> 00:02:40,920
!روبين

37
00:02:42,620 --> 00:02:45,200
!ما زلنا لم نسمعك تقولينها

38
00:02:50,000 --> 00:02:53,240
!قولي أنّك تريدين أن تعيشي

39
00:02:56,800 --> 00:02:57,810
...روبين

40
00:03:02,390 --> 00:03:03,410
!روبين

41
00:03:05,810 --> 00:03:07,000
...أعيش

42
00:03:09,020 --> 00:03:12,560
.ظننتُه أمرًا ما كنت لأجرأ على تمنّيه

43
00:03:15,030 --> 00:03:18,470
.لم يسمح لي أحد أبدًا بتمنّيه

44
00:03:18,700 --> 00:03:22,870
...نعم. البحر واسع، ويومًا ما بكلّ تأكيد

45
00:03:22,870 --> 00:03:26,900
!ستقابلين أصدقاء سيحمونك

46
00:03:35,710 --> 00:03:40,750
إن كان من المسموح لي بالفعل
...البوح بأمنيتي أخيرًا

47
00:03:42,050 --> 00:03:43,310
...فأنا

48
00:03:46,270 --> 00:03:48,030
!أريد أن أعيش

49
00:03:49,430 --> 00:03:53,520
!خذوني للبحر معكم

50
00:04:13,880 --> 00:04:17,820
!يا رفاق...! أنا أحبّكم اللّعنة عليكم

51
00:04:19,750 --> 00:04:20,660
!لننطلق

52
00:04:24,550 --> 00:04:26,010
!الجسر المتحرّك ينزل

53
00:04:32,660 --> 00:04:33,480
!روبين

54
00:04:34,270 --> 00:04:35,920
!سننقذك بكلّ تأكيد

55
00:04:36,730 --> 00:04:40,810
!إنّ الجسر المتحرّك ينزل! انطلق يا قبّعة القشّ

56
00:04:40,900 --> 00:04:42,820
!كيف تجرؤون أيّها القراصنة الملعونون

57
00:04:42,820 --> 00:04:44,950
!لن نسمح بحدوث هذا

58
00:04:44,950 --> 00:04:49,620
!جهّزوا مدفع الخندق! أوقفوا الجسر
!حطّموه إن اقتضى الأمر

59
00:04:49,620 --> 00:04:50,660
!حاضر

60
00:04:59,240 --> 00:05:00,570
!توقّف الجسر المتحرّك عن النّزول؟

61
00:05:01,010 --> 00:05:03,460
!كيف تجرؤون على الوقوف في وجهنا؟
!أوغاد ملعونون

62
00:05:04,260 --> 00:05:06,220
!من الفاعل؟

63
00:05:07,470 --> 00:05:10,500
!أيّها القراصنة

64
00:05:10,680 --> 00:05:12,310
!ماذا؟! كوكورو-سان؟

65
00:05:12,310 --> 00:05:15,980
!سمعتُ كلّ شيء
!لماذا تضيّعون الوقت؟

66
00:05:15,980 --> 00:05:18,990
.نضيّع الوقت؟ لكنّ الجسر لم ينزل بالكامل

67
00:05:19,270 --> 00:05:22,600
!اقفزوا بكلّ ما لديكم من قوّة للشّلاّلات

68
00:05:23,900 --> 00:05:25,050
أهذا صوت القطار البحريّ؟

69
00:05:26,990 --> 00:05:29,740
ماذا؟ ما معنى تلك الابتسامة؟

70
00:05:39,180 --> 00:05:40,540
!لننطلق

71
00:05:41,280 --> 00:05:42,580
!عرفتُ هذا

72
00:05:46,500 --> 00:05:48,490
!كلاّ

73
00:05:52,850 --> 00:05:54,680
!لم أكن لآخذك على أي حال

74
00:05:55,020 --> 00:05:57,390
!يستحيل أن تصبح قرصانًا

75
00:05:57,890 --> 00:05:58,840
!بل سأصبح

76
00:05:59,190 --> 00:06:02,020
،سأجمع رفقاء يضاهون هذا الطّاقم يومًا ما

77
00:06:02,690 --> 00:06:04,480
،وأجد أعظم كنز في العالم

78
00:06:04,900 --> 00:06:08,120
!وسأصبح ملك القراصنة حتمًا

79
00:06:11,290 --> 00:06:15,570
عندما كنت طفلاً، أقسمت
...أن أجمع طاقمي وأصبح قرصانًا

80
00:06:16,370 --> 00:06:18,710
.مثل القرصان الّذي حماني

81
00:06:20,880 --> 00:06:22,710
!أنت صديقتنا بالفعل

82
00:06:23,020 --> 00:06:23,980
...روبين

83
00:06:24,670 --> 00:06:27,550
،لذلك، كما حماني هو حينها

84
00:06:27,550 --> 00:06:30,180
!سأحميك أنا أيضًا

85
00:06:38,060 --> 00:06:41,400
"!اقفزوا نحو الشّلاّلات! مشاعر لوفي"

86
00:06:57,620 --> 00:07:00,880
!خذني معك في رحلتك القادمة إذًا يا شانكس

87
00:07:00,880 --> 00:07:02,840
!أريد أن أصبح قرصانًا أيضًا

88
00:07:04,590 --> 00:07:06,620
!يستحيل أن تصبح قرصانًا

89
00:07:07,260 --> 00:07:08,600
!لماذا؟

90
00:07:10,010 --> 00:07:11,040
.لوفي

91
00:07:11,040 --> 00:07:15,020
مجرّد كونك سبّاحًا ماهرًا، فذلك لا يعني
.أنّك ستصبح قرصانًا جيّدًا

92
00:07:15,020 --> 00:07:18,470
!أنا قويّ بالقتال أيضًا
!لكماتي كالمسدّس

93
00:07:18,770 --> 00:07:20,020
حقًّا؟

94
00:07:20,020 --> 00:07:21,430
!ما هذا الأسلوب؟

95
00:07:21,770 --> 00:07:24,440
!هذا يعني أنّك طفل صغير يا لوفي

96
00:07:24,440 --> 00:07:26,890
!إنّك بنفس عمر ابني

97
00:07:27,030 --> 00:07:29,410
!لست طفلاً! أنا بالغ

98
00:07:29,410 --> 00:07:32,830
.هوّن عليك، لا تغضب
!هيّا، اشرب العصير

99
00:07:32,830 --> 00:07:34,700
!شكرًا لك

100
00:07:36,160 --> 00:07:38,290
!أرأيت؟ إنّك طفل

101
00:07:38,290 --> 00:07:39,980
!هذه حركة قذرة يا شانكس

102
00:07:41,930 --> 00:07:43,080
!لا تضحكوا

103
00:07:43,750 --> 00:07:45,880
!تبًّا لك يا شانكس الغشّاش

104
00:07:56,180 --> 00:07:57,600
.سنعذر أنفسنا

105
00:08:03,520 --> 00:08:08,470
.هؤلاء هم المدعوّون بالقراصنة إذًا
.يبدون كالحمقى

106
00:08:13,370 --> 00:08:14,720
...مرحبًا

107
00:08:17,240 --> 00:08:21,710
.إنّنا قطّاع طرق جبال
.ولكنّنا لم نأت لتخريب المكان

108
00:08:22,170 --> 00:08:25,010
بيعي لنا الشّراب. عشرة براميل
.تقريبًا ستكون كافية

109
00:08:26,320 --> 00:08:30,010
.المعذرة، نفد منا الشّراب للتّوّ

110
00:08:30,010 --> 00:08:31,550
.هذا غريب

111
00:08:31,550 --> 00:08:35,390
يبدو أنّ القراصنة يشربون شيئًا ما، أذلك ماء؟

112
00:08:35,390 --> 00:08:38,510
.ما قدّمته لهم للتّوّ هو كلّ ما أملكه

113
00:08:38,970 --> 00:08:43,720
المعذرة على ذلك، يبدو أننا شربنا
.حتّى نفد الشّراب من المحلّ

114
00:08:43,960 --> 00:08:44,680
!آسف

115
00:08:45,560 --> 00:08:48,950
.سأعطيك هذه إن أردت. لم أفتحها بعد

116
00:08:56,460 --> 00:09:00,200
.هناك مكافأة 8 ملايين بيري على رأسي لعلمك

117
00:09:00,200 --> 00:09:04,150
زجاجة واحدة ليست كافية حتّى
.لشراب ما قبل النّوم. لا تستخفّ بي

118
00:09:08,090 --> 00:09:09,420
.تبلّلت الأرض

119
00:09:10,760 --> 00:09:13,840
أعتذر على ذلك يا ماكينو-سان، ألديك خرقة؟

120
00:09:14,050 --> 00:09:16,290
!سأعتني بالأمر

121
00:09:22,450 --> 00:09:27,150
.يبدو أنّك تحبّ التّنظيف
.ربّما سيرضيك هذا أكثر

122
00:09:27,820 --> 00:09:32,250
لا فائدة من البقاء بما أنّهم
!لا يملكون الشّراب. لنذهب

123
00:09:34,780 --> 00:09:36,560
!الوداع أيّها الجبناء

124
00:09:47,710 --> 00:09:50,000
هل أنت بخير أيّها القائد؟
هل من جروح؟

125
00:09:50,000 --> 00:09:52,200
.أنا بخير. لا مشكلة

126
00:09:56,970 --> 00:09:59,010
!هزأ بك بالكامل يا زعيم

127
00:09:59,010 --> 00:10:00,430
!حالك يرثى لها

128
00:10:03,730 --> 00:10:05,010
!لماذا تضحكون؟

129
00:10:05,640 --> 00:10:09,310
!بدوتم سخيفين جدًّا
!لماذا لم تقاتلوهم؟

130
00:10:09,820 --> 00:10:12,280
،مهما كانت أعدادهم أو مدى قوّتهم

131
00:10:12,280 --> 00:10:15,940
فلستم رجالاً لضحككم بعد فعلهم
!ذلك بكم... ولا قراصنة

132
00:10:18,320 --> 00:10:23,120
أتفهّم شعورك، ولكنّه صبّ
.الشّراب عليّ فحسب

133
00:10:23,120 --> 00:10:25,040
.ليس شيئًا يستحقّ الغضب بشأنه

134
00:10:25,040 --> 00:10:26,080
!لا يهمّ

135
00:10:34,520 --> 00:10:35,720
أتأكل بدافع الغضب يا لوفي؟

136
00:10:35,720 --> 00:10:36,380
!اصمت

137
00:10:39,140 --> 00:10:40,510
!ما الّذي تأكله؟

138
00:10:42,640 --> 00:10:46,140
ما داخل الصّندوق... هل أكلت
ما داخل هذا الصّندوق؟

139
00:10:46,140 --> 00:10:46,880
...أ-أجل

140
00:10:48,110 --> 00:10:50,770
!الفظه! الفظه حالاً! الفظّ كلّ ما أكلته

141
00:10:50,770 --> 00:10:53,060
!مـ-ماذا تفعل يا شانكس؟

142
00:11:02,910 --> 00:11:04,740
ما كان ذلك؟

143
00:11:05,040 --> 00:11:07,790
!ما أكلته كان فاكهة المطّاط

144
00:11:07,790 --> 00:11:09,420
،فاكهة المطّاط معروفة باسم فاكهة الشّيطان

145
00:11:09,790 --> 00:11:11,420
...وتناولها يحوّل جسدك إلى مطّاط

146
00:11:11,670 --> 00:11:15,320
!وتفقد القدرة على السّباحة إلى الأبد

147
00:11:15,510 --> 00:11:17,930
!ماذا؟! مستحيل

148
00:11:17,930 --> 00:11:19,800
!أيّها الغبيّ

149
00:11:37,600 --> 00:11:43,110
،كنّا نشرب بمزاج جيّد
فما الّذي تفعله أيّها الطّفل؟

150
00:11:43,430 --> 00:11:46,530
سحقًا! اعتذر! كيف تجرؤ على
السّخرية من شانكس وطاقمه؟

151
00:11:48,880 --> 00:11:52,140
أقلت شيئًا يهينك؟

152
00:11:52,140 --> 00:11:53,880
!قلت! اعتذر

153
00:11:54,420 --> 00:11:55,330
!أيّها العمدة

154
00:12:00,720 --> 00:12:03,220
!هل رأيتم وجوه أولئك القراصنة في تلك المرّة؟

155
00:12:03,220 --> 00:12:07,670
!غُطّي بالشّراب ولم يقل أيّ كلمة
!يا له من مثير للشّفقة

156
00:12:08,310 --> 00:12:12,220
.القراصنة مجرّد مجموعة من الجبناء
.لا يجيدون سوى الكلام

157
00:12:12,560 --> 00:12:13,520
!توقّفوا

158
00:12:15,360 --> 00:12:18,820
!لا تسخروا من شانكس والبقيّة
!ليسوا ضعفاء

159
00:12:18,820 --> 00:12:20,190
!توقّف يا لوفي

160
00:12:22,570 --> 00:12:24,990
لا تسخروا من شانكس والبقيّة
!يا قطّاع الطّرق الأغبياء

161
00:12:29,760 --> 00:12:32,910
.اختيارك للكلمات كان سيّئًا أيّها الطّفل

162
00:12:32,910 --> 00:12:37,120
.لم ينجُ شخص أغضبني من قبل

163
00:12:37,880 --> 00:12:39,210
!تمهّل

164
00:12:39,550 --> 00:12:41,660
!أفلت الصّبي! أرجوك

165
00:12:44,090 --> 00:12:48,350
،لا أدري ما الّذي فعله لوفي
!ولا أريد قتالكم

166
00:12:48,350 --> 00:12:50,640
!إلّم يكن ذلك يهينكم، فسأدفع لكم حتّى

167
00:12:50,640 --> 00:12:53,340
!أرجوكم، اعفوا عن هذا الصّبي

168
00:12:53,600 --> 00:12:54,840
!العمدة

169
00:12:55,480 --> 00:12:59,020
.يعرف كبار السّنّ كيف يسير العالم بالفعل

170
00:12:59,440 --> 00:13:01,860
.ولكن لا فائدة. فات الأوان عليه

171
00:13:01,860 --> 00:13:04,780
...ذلك لأنّه أغضبني

172
00:13:05,780 --> 00:13:08,020
!أنتم المخطئون يا قردة الجبال

173
00:13:10,200 --> 00:13:13,960
.أمرك ميؤوس أيّها الطّفل
!فلتندم على ذلك في العالم الآخر

174
00:13:14,170 --> 00:13:14,910
!لوفي

175
00:13:14,910 --> 00:13:17,770
!أرجوك! أفلته

176
00:13:17,770 --> 00:13:20,670
...تساءلت لِمَ كانت الحانة فارغة

177
00:13:21,730 --> 00:13:23,460
.يبدو أنّهم قطّاع الطّرق من تلك المرّة

178
00:13:23,970 --> 00:13:25,670
!القائد

179
00:13:30,100 --> 00:13:31,510
!شانكس

180
00:13:53,400 --> 00:13:56,790
ما زلتم في هذه القرية أيّها القراصنة؟

181
00:13:56,790 --> 00:13:59,040
هل كنت تنظّف القرية طوال الوقت؟

182
00:13:59,040 --> 00:14:00,000
!لوفي

183
00:14:00,590 --> 00:14:03,200
ألم تكن لكماتك قوية كالمسدّس؟

184
00:14:03,480 --> 00:14:04,380
!اصمت

185
00:14:05,230 --> 00:14:09,090
،لا أدري ما الّذي جاء بك إلى هنا
.ولكن غادر قبل أن يلحق بك الأذى

186
00:14:09,450 --> 00:14:13,310
.إن اقتربت أكثر، فسنفجر رأسك أيّها الضّعيف

187
00:14:15,190 --> 00:14:18,810
!أخبرك ألا تقترب أكثر! سأفجّر رأسك

188
00:14:26,010 --> 00:14:27,620
.ضع حياتك على المحكّ

189
00:14:27,830 --> 00:14:28,600
!ماذا؟

190
00:14:29,740 --> 00:14:32,320
ضع حياتك على المحكّ بما
.أنّك قد سحبت مسدّسك

191
00:14:33,000 --> 00:14:34,580
ماذا تقول أيّها الوغد؟

192
00:14:35,310 --> 00:14:38,030
.أعني أنّ هذا ليس أداة للتّهديد

193
00:14:52,320 --> 00:14:53,940
!أ-أطلقتم النّار عليه

194
00:14:53,940 --> 00:14:55,350
!يا لهم من قذرين

195
00:14:55,890 --> 00:14:56,680
قذرين؟

196
00:14:56,680 --> 00:14:58,560
.لا تتفوّهوا بالسّخافات

197
00:14:58,560 --> 00:15:01,060
هل تعتقدون أنّكم تواجهون
قدّيسين أو شيئًا من ذلك القبيل؟

198
00:15:01,440 --> 00:15:03,730
!من يقفون أمامكم قراصنة

199
00:15:04,100 --> 00:15:06,930
!اصمتوا! لا علاقة لكم بالأمر من الأساس

200
00:15:07,380 --> 00:15:08,930
...استمعوا يا قطاع الطّرق

201
00:15:08,930 --> 00:15:13,490
حين يصبّ الشّراب عليّ أو يلقى عليّ
،طعام أو يُبصق عليّ حتّى

202
00:15:13,490 --> 00:15:16,000
.فإنّي سأضحك وأنسى الأمر في أغلب الأوقات

203
00:15:16,000 --> 00:15:16,950
...ولكن

204
00:15:17,330 --> 00:15:19,080
،مهما كان السّبب

205
00:15:19,080 --> 00:15:21,240
!فلن أغفر لمن يؤذي أصدقائي

206
00:15:22,490 --> 00:15:23,700
...شانكس

207
00:15:25,910 --> 00:15:27,330
!لن تغفر له؟

208
00:15:27,510 --> 00:15:30,500
!قراصنة سفلة! اقتلوهم يا رجال

209
00:15:32,930 --> 00:15:34,970
.سأتولّى هذا. لا نحتاج للمزيد

210
00:15:45,410 --> 00:15:47,650
.لا تغترّ بنفسك يا قاطع الطّرق

211
00:15:47,650 --> 00:15:52,010
.إن أردت قتالنا، فاجلب سفينة حربيّة إلى هنا

212
00:15:52,950 --> 00:15:54,530
!قويّ للغاية

213
00:15:54,790 --> 00:15:58,920
!تـ-تمهل! هذا الطّفل هو من هاجمنا

214
00:15:59,220 --> 00:16:00,500
.إنّك رجل مطلوب

215
00:16:02,080 --> 00:16:03,230
!سحقًا

216
00:16:04,190 --> 00:16:05,120
!قنبلة دخانيّة

217
00:16:08,630 --> 00:16:09,540
!لوفي

218
00:16:11,400 --> 00:16:13,300
!تمكّنت من الهرب بسلاسة

219
00:16:13,300 --> 00:16:15,500
لن يتوقّعوا هروب قاطع طرق
!جبليّة إلى البحر أبدًا

220
00:16:16,180 --> 00:16:20,510
!سحقًا! اتركني أيّها القرد الغبيّ
!فلتمت أفضل

221
00:16:21,270 --> 00:16:23,680
!أيّها الغبيّ... أنت من سيموت

222
00:16:24,270 --> 00:16:26,640
!فقد أغضبتني في نهاية المطاف

223
00:16:27,040 --> 00:16:28,150
!الوداع

224
00:16:30,200 --> 00:16:31,570
!سحقًا! سحقًا

225
00:16:31,570 --> 00:16:35,350
إنّهم مجرّد قمامة، ولم أتمكن من
!ضربهم حتّى مرّة واحدة! سحقًا

226
00:16:40,790 --> 00:16:44,430
.آسف، ولكن لا فائدة لي منك بعد الآن

227
00:16:53,090 --> 00:16:55,580
!مـ-ما هذا؟

228
00:17:03,190 --> 00:17:04,540
!النّجدة

229
00:17:21,230 --> 00:17:22,540
!شانكس

230
00:17:30,760 --> 00:17:31,870
!انصرف

231
00:17:51,110 --> 00:17:55,570
...أدين لك يا لوفي
.أخبرتنا ماكينو-سان بكل شيء

232
00:17:55,570 --> 00:17:57,820
.قاتلت من أجلنا

233
00:18:01,540 --> 00:18:04,910
!لا تبكِ... إنّك رجل

234
00:18:04,910 --> 00:18:07,100
...ولكن يا شانكس

235
00:18:07,830 --> 00:18:10,120
!ذراعك

236
00:18:11,250 --> 00:18:13,870
.مجرّد ذراعٍ واحدة ثمن بخس

237
00:18:14,880 --> 00:18:16,240
...حمدًا على سلامتك

238
00:18:37,530 --> 00:18:38,610
ستغادرون إذًا؟

239
00:18:38,980 --> 00:18:42,960
.أجل. بقينا لوقت طويل
.ولكنّنا سنفترق الآن

240
00:18:42,960 --> 00:18:44,110
ستشعر بالوحدة، أليس كذلك؟

241
00:18:44,660 --> 00:18:49,330
أجل، سأكون وحيدًا... ولكنّني
.لن أطلب منك اصطحابي

242
00:18:49,330 --> 00:18:52,280
!قرّرت أن أصبح قرصانًا بنفسي

243
00:18:54,210 --> 00:18:56,140
!لم أكن لآخذك على أيّ حال

244
00:18:56,550 --> 00:18:59,340
!يستحيل أن تصبح قرصانًا

245
00:18:59,720 --> 00:19:00,580
!بل سأصبح

246
00:19:01,350 --> 00:19:04,540
،سأجمع رفقاء يضاهون هذا الطّاقم يومًا ما

247
00:19:04,900 --> 00:19:07,020
،وأجد أعظم كنز في العالم

248
00:19:07,220 --> 00:19:10,490
!وسأصبح ملك القراصنة حتمًا

249
00:19:11,730 --> 00:19:14,440
ستفوقنا إذًا؟

250
00:19:17,480 --> 00:19:18,310
...في هذه الحالة

251
00:19:21,190 --> 00:19:23,790
.سأأتمن هذه القبعة عندك

252
00:19:23,790 --> 00:19:25,910
.إنّها قبّعة غالية عليّ

253
00:19:26,590 --> 00:19:27,870
!اعتن بها

254
00:19:45,700 --> 00:19:47,360
،بعدها بعشر سنوات

255
00:19:47,360 --> 00:19:49,840
.بدأت إبحاري وصرتُ قرصانًا

256
00:19:51,100 --> 00:19:56,100
،كما حماني شانكس حينها
!سأحمي أصدقائي

257
00:20:05,200 --> 00:20:07,160
!كلاّ

258
00:20:12,170 --> 00:20:14,430
!انتظري فحسب يا روبين

259
00:20:29,190 --> 00:20:30,960
!أيّها الوغد

260
00:20:31,180 --> 00:20:33,020
!يا لتشوبّر مان المقيت ذاك

261
00:20:33,020 --> 00:20:36,300
لن أسمح له بإفساد خططي
!للسّيطرة على العالم بعد الآن

262
00:20:36,860 --> 00:20:39,240
!هذا هو الشّرّ بعينه، الدّكتور أوسودابا

263
00:20:39,240 --> 00:20:42,820
إنّه قائد عصابة أوسودابا الشّرّيرة
!ويخطّط للسّيطرة على العالم

264
00:20:42,820 --> 00:20:47,080
إنّه عالِم شرّير يصنع من الشّرّ
!أطيافًا ووحوشًا وآليّين... وأيّ شيء

265
00:20:47,080 --> 00:20:49,780
.أولئك خلفه هم بعض أتباعه

266
00:20:50,170 --> 00:20:54,040
سأستدرجه إلى قاعدتي وأنتظره
.هنا متأهّبًا لأضرب ضربتي

267
00:20:54,040 --> 00:20:57,300
!ثمّ سأسحقه بقوّة عصابتي القتاليّة الكاملة

268
00:20:57,740 --> 00:20:58,880
!هكذا

269
00:20:58,880 --> 00:21:00,490
...إنّ نقطة ضعفه

270
00:21:00,630 --> 00:21:02,430
!هذا صحيح، مساعدته ناميفيا

271
00:21:02,430 --> 00:21:04,050
!هذه المساعدة الجميلة ناميفيا

272
00:21:04,050 --> 00:21:06,890
.إنّها تدير مهمّات تشوبّر مان بكلّ براعة

273
00:21:07,310 --> 00:21:08,680
!هيّا يا رجال

274
00:21:08,680 --> 00:21:10,100
!أوّلاً، أحضروا لي رهينة

275
00:21:11,100 --> 00:21:12,540
!حالاً

276
00:21:12,990 --> 00:21:14,520
!أحضرنا رهينة

277
00:21:14,520 --> 00:21:15,220
!مرحبًا

278
00:21:15,220 --> 00:21:16,270
!أحضرتموه هو؟

279
00:21:16,520 --> 00:21:19,190
،هذا بطلنا المدافع عن العدالة
!تشوبّر مان

280
00:21:19,190 --> 00:21:23,670
إنّه يطير في الأرجاء بعباءة تشوبّر مان
!ويحارب من أجل سلام العالم

281
00:21:23,670 --> 00:21:24,790
!سلاحه هو ظرافته

282
00:21:26,410 --> 00:21:29,660
يستطيع إذابة قلب العدوّ
!بـ"بريق الظّرافة" خاصّته

283
00:21:29,660 --> 00:21:34,750
وإن لم ينجح ذلك، يستعمل
!عنف تشوبّر" لإبراح العدوّ ضربًا"

284
00:21:36,130 --> 00:21:37,260
.أريد شايًا

285
00:21:37,260 --> 00:21:39,490
!ما الّذي تفعله بالاسترخاء في قاعدتي؟

286
00:21:40,170 --> 00:21:43,090
!ماذا؟! ما ذلك الشّيء الضّخم في الحديقة؟

287
00:21:43,090 --> 00:21:45,870
!إنّه سلاحي السّرّيّ
!كفّ عن النّظر إليه أيّها الوغد

288
00:21:46,390 --> 00:21:47,580
هل يمكنني أن أحاول ركوبه؟

289
00:21:47,580 --> 00:21:48,550
.نعم، تفضّل

290
00:21:48,550 --> 00:21:50,890
!مهلاً! لماذا تصادق لوفيبومبر؟

291
00:21:51,430 --> 00:21:54,400
،هذا هو لوفيبومبر العملاق
.آليّ ضخم وسلاحهم السّرّيّ

292
00:21:54,400 --> 00:21:56,560
.إنّه آليّ ضخم يبلغ طوله 50 مترًا

293
00:21:56,560 --> 00:22:00,030
،عندما يركبه أوسودابا
.يصبح أسوأ وأقوى أعدائكم

294
00:22:00,030 --> 00:22:01,820
.الميزات الخاصّة: القدرة على الكلام

295
00:22:01,820 --> 00:22:03,860
!الشّخصيّة: يقوم بما يحلو له

296
00:22:16,080 --> 00:22:17,710
!هذا وحش كرة الأرزّ زوروكيلر

297
00:22:17,710 --> 00:22:19,750
،إن لم تمنحوه كرات أرزّ عندما يطلبها

298
00:22:19,750 --> 00:22:21,670
يغضب ويقول "أحضروا بعضها
"!من الآن فصاعدًا

299
00:22:22,010 --> 00:22:24,380
.هذه وحش الزّهور روبيفلورن
إنّها امرأة شرّيرة

300
00:22:24,380 --> 00:22:27,630
"هزمها تشوبّر مان بـ"بريق تشوبّر
.القاتل عدّة مرّات

301
00:22:27,720 --> 00:22:29,310
.هذا هو الوحش المنحرف سانجيروبس

302
00:22:29,310 --> 00:22:32,480
،إنّه يصرّ أنّه ليس منحرفًا
.لكن لا تشغل باله إلاّ الأشياء المنحرفة

303
00:22:32,480 --> 00:22:34,100
.لا يظهر أيّ رحمة للرّجال

304
00:22:34,650 --> 00:22:36,880
.إنّهم أشرار عصابة أوسودابا الثّلاثة

305
00:22:36,880 --> 00:22:38,560
...لكن لا علاقة لهم بهذه القصّة

306
00:22:38,690 --> 00:22:42,370
.وهكذا، تمّ القضاء على العصابة الشّرّيرة

307
00:22:42,370 --> 00:22:43,820
!هذا مذهل

308
00:22:43,820 --> 00:22:45,600
!أنت رائع يا لوفيبومبر

309
00:22:45,600 --> 00:22:46,610
!بالطّبع أنا رائع

310
00:22:49,700 --> 00:22:51,900
تشوبّر مان! ثمّة مشاكل في إحدى
!البلدات الشّرقيّة

311
00:22:52,160 --> 00:22:56,360
،حسنًا! سأتّجه إلى هناك راكبًا لوفيبومبر
!الآليّ الضّخم الّذي حصلت عليه ذلك اليوم

312
00:22:56,570 --> 00:22:57,450
!ليس هنا

313
00:22:57,450 --> 00:22:58,540
.لقد بعتُه

314
00:22:58,540 --> 00:22:59,240
!ماذا؟

315
00:22:59,240 --> 00:23:00,920
!انطلق! انطلق يا بطلنا تشوبّر مان

316
00:23:00,920 --> 00:23:03,000
!قاتل من أجل سلام العالم

317
00:23:11,570 --> 00:23:15,060
.لا-لا تقلقي يا روبين-كُن
.نحن هنا إلى جانبك

318
00:23:15,060 --> 00:23:18,100
.قالها وساقاه ترتجفان

319
00:23:18,100 --> 00:23:20,020
!أ-أنا أرتجف من الحماس

320
00:23:20,020 --> 00:23:23,900
فعلاً؟ حسنًا، لنسرع ونتولّى
!أمر رجال حكومة العالم هؤلاء

321
00:23:23,900 --> 00:23:26,570
!ثمّ سننقذ روبين-كُن بكلّ تأكيد

322
00:23:26,570 --> 00:23:28,200
:في الحلقة القادمة من وان بيس

323
00:23:28,200 --> 00:23:31,710
دروب الرّجال! تقنيات"
"!زورو وحلم أوسوبّ

324
00:23:31,710 --> 00:23:34,010
!ملك القراصنة، لن يكون إلاّ أنا

325
00:23:36,150 --> 00:23:41,160
نلقاكم في الحلقة القادمة