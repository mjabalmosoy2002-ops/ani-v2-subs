1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:59,640 --> 00:02:04,400
.تصادم التّنّينان كايدو ومومونوسكي أخيرًا

19
00:02:04,400 --> 00:02:06,690
من ذاك التّنّين؟

20
00:02:08,150 --> 00:02:10,160
...إنّ اسمي هو

21
00:02:11,650 --> 00:02:13,740
!كوزكي مومونوسكي

22
00:02:13,740 --> 00:02:17,000
!أنا الرّجل الّذي سيصير شوغن بلاد وانو

23
00:02:33,880 --> 00:02:36,350
!نفَس الانفجار

24
00:02:54,950 --> 00:02:56,450
!أجل يا مومو

25
00:03:05,160 --> 00:03:10,930
"!تتكرّر الأسطورة ثانية! قبضة لوفي تزأر في السّماء"

26
00:03:12,590 --> 00:03:13,760
!مومو

27
00:03:16,630 --> 00:03:18,970
...لقد عضضتَ

28
00:03:20,510 --> 00:03:22,440
!أحد اليونكو

29
00:03:23,850 --> 00:03:28,530
!أما زال هنالك شيء في هذا العالم يخيفك؟

30
00:03:29,360 --> 00:03:30,070
...كـ

31
00:03:38,490 --> 00:03:39,910
!كلاّ

32
00:03:52,750 --> 00:03:54,010
!مومو، انطلق

33
00:03:55,550 --> 00:03:57,430
!يمكنك الطّيران

34
00:03:57,880 --> 00:03:59,010
!أجل

35
00:04:05,430 --> 00:04:06,860
...إيقاف أونيغاشيما

36
00:04:08,850 --> 00:04:10,320
!مسؤوليّتك أنت

37
00:04:15,780 --> 00:04:18,490
...أمّا كايدو

38
00:04:21,200 --> 00:04:22,790
...فسأهزمه

39
00:04:23,200 --> 00:04:25,790
!بأيّ ثمن كان

40
00:04:48,020 --> 00:04:49,570
...لوفي

41
00:04:49,990 --> 00:04:54,280
!عاد بكامل قوّته

42
00:04:59,700 --> 00:05:01,570
!أنت لها يا لوفي

43
00:05:01,570 --> 00:05:04,160
!هذا خارق

44
00:05:07,050 --> 00:05:08,750
هل سمعتما ذلك؟

45
00:05:09,410 --> 00:05:11,750
.يا له من رجل مضحك

46
00:05:14,760 --> 00:05:16,800
!ما من مفاجئة فيما قاله

47
00:05:16,800 --> 00:05:19,140
أين كان؟

48
00:05:20,260 --> 00:05:22,640
!لوفي

49
00:05:22,640 --> 00:05:23,930
!مومو-كُن

50
00:05:24,220 --> 00:05:25,680
...لوفي

51
00:05:25,930 --> 00:05:29,770
!فعل لوفي كلّ ما قال أنّه سيفعله

52
00:05:29,770 --> 00:05:31,480
!أخي الكبير

53
00:05:31,480 --> 00:05:33,320
!مومو-كُن

54
00:05:33,690 --> 00:05:34,940
...يا إلهي

55
00:05:35,860 --> 00:05:37,400
!أنت لها يا لوفي

56
00:05:38,780 --> 00:05:41,650
!يا إلهي، أنت رائع جدًّا يا لوفي-سان

57
00:05:41,650 --> 00:05:45,700
!سترى بلاد وانو الفجر قريبًا يا روبين-سان

58
00:05:54,290 --> 00:05:58,180
!هذا ما نتوقّعه من ملك القراصنة المستقبليّ

59
00:06:04,260 --> 00:06:06,930
!كفاك هربًا كالفئران

60
00:06:28,330 --> 00:06:30,170
.آن الأوان أخيرًا

61
00:06:30,490 --> 00:06:32,710
...نعم، ما هذه إلاّ البداية

62
00:06:35,210 --> 00:06:39,930
لماذا تضحكان كالحمقى؟

63
00:06:40,420 --> 00:06:42,550
...إنّ قبطانكما

64
00:06:42,970 --> 00:06:44,970
!سبق وخسر أمام كايدو-سان

65
00:06:45,430 --> 00:06:48,050
!لا يهمّ كم مرّة سيُعاود الكرّة

66
00:06:48,050 --> 00:06:50,730
!ضدّ من يقاتل في رأيكما؟

67
00:06:53,980 --> 00:06:57,860
!إنّه يقاتل ملك القراصنة المستقبلي دون سواه

68
00:07:03,190 --> 00:07:06,620
!ذلك ليس المستقبل الّذي نراه نحن

69
00:07:07,110 --> 00:07:10,450
!إنّه عصر لن يخطر حتّى في بالكما

70
00:07:10,450 --> 00:07:13,330
!ماذا قلتما أيّها الشّقيّين القذرين؟

71
00:07:41,190 --> 00:07:44,740
!إنّهما يفوقان كبار النّجوم قوّة

72
00:07:44,740 --> 00:07:49,500
!صارت تقنياتهما أكثر حدّة بكثير

73
00:07:49,820 --> 00:07:53,040
...يملك لوفيتارو حضورًا قويًّا

74
00:07:53,660 --> 00:07:57,170
!إنّه تمامًا كما كان أودن-ساما بالنّسبة لنا

75
00:08:19,650 --> 00:08:20,730
!حسنًا

76
00:09:50,940 --> 00:09:56,290
!هل هنالك فرصة قد تهزمني فيها؟

77
00:10:02,290 --> 00:10:04,260
،ما دام فيّ عرق ينبض

78
00:10:05,040 --> 00:10:07,380
!فإنّ الفرص لا حصر لها

79
00:10:37,320 --> 00:10:38,460
...أخي الكبير

80
00:10:43,080 --> 00:10:44,420
...لوفي

81
00:11:11,400 --> 00:11:13,120
.قرأت هذا في يوميّاته

82
00:11:13,780 --> 00:11:17,290
...عندما تصادم روجر مع اللّحية البيضاء

83
00:11:25,330 --> 00:11:27,420
!انشقّت السّماء فوقهما

84
00:11:51,320 --> 00:11:54,660
...لديّ... ما أبلّغ به

85
00:11:56,240 --> 00:11:58,910
...انشقّت... السّماء

86
00:12:09,670 --> 00:12:12,140
.لا تنطق بأيّ كلمة

87
00:12:19,130 --> 00:12:23,230
من المحظوظ الآن-نيا؟

88
00:12:37,740 --> 00:12:42,290
صار الأمر أكثر حماسة، صحيح يا كايدو؟

89
00:12:44,030 --> 00:12:45,500
...والآن

90
00:12:50,710 --> 00:12:53,720
!علينا القيام بهذا أيضًا

91
00:13:12,520 --> 00:13:14,030
...باغوا الرّعد

92
00:13:15,110 --> 00:13:17,360
...ظننتُ أنّني حميتُ نفسي بالكامل

93
00:13:18,620 --> 00:13:20,910
...لكن لم تكن حماية مثاليّة

94
00:13:22,950 --> 00:13:24,000
!ياما-أو

95
00:13:25,830 --> 00:13:28,250
!ساعد ذلك الأحمق الجبان

96
00:13:30,510 --> 00:13:33,300
!مـ-من الّذي تصفه بالأحمق الجبان؟

97
00:13:33,670 --> 00:13:36,340
!هذا يكفي يا مومو

98
00:13:38,050 --> 00:13:41,720
!ا-اخرس! أعلم ما عليّ فعله

99
00:13:42,180 --> 00:13:46,100
!لا تظنّ أنّ النّاس بإمكانهم أن يتغيّروا بهذه السّهولة

100
00:13:49,890 --> 00:13:52,570
!لا تقلق يا مومونوسكي-كُن

101
00:13:52,990 --> 00:13:55,070
!أنا إلى جانبك

102
00:13:56,230 --> 00:13:59,740
!آسف لأنّني تركت سابقًا

103
00:14:00,110 --> 00:14:01,320
!ياماتو

104
00:14:01,320 --> 00:14:04,740
!حسنًا، لنوقف أونيغاشيما

105
00:14:05,710 --> 00:14:07,910
!أعتمد عليك يا مومو

106
00:14:12,160 --> 00:14:13,630
!يا ياماتو

107
00:14:14,250 --> 00:14:15,380
!مومونوسكي

108
00:14:19,090 --> 00:14:22,100
!إلى أين تذهبان؟

109
00:14:31,980 --> 00:14:33,730
...امنحاني القوّة

110
00:14:35,650 --> 00:14:36,820
!يا كينييمون

111
00:14:38,610 --> 00:14:39,660
!وكيكو

112
00:14:41,110 --> 00:14:43,870
...سأحرص بالتّأكيد

113
00:14:49,660 --> 00:14:51,920
!أسرع يا مومونوسكي-كُن

114
00:15:07,680 --> 00:15:10,140
!انتهى أمر بلاد وانو

115
00:15:10,140 --> 00:15:12,480
!استسلم يا ياماتو

116
00:15:17,190 --> 00:15:18,940
!سُحقًا لك

117
00:15:23,400 --> 00:15:27,370
!سيحلّ فجر بلاد وانو عمّا قريب

118
00:15:39,220 --> 00:15:40,340
!ياما-أو

119
00:15:40,710 --> 00:15:42,010
!لا داعي لإخباري

120
00:15:42,750 --> 00:15:44,550
تريد أن تقاتله وحدك، صحيح؟

121
00:15:46,770 --> 00:15:48,060
!نعم

122
00:16:02,270 --> 00:16:04,110
!سأموت

123
00:16:19,120 --> 00:16:21,290
!مـ-مومونوسكي-كُن

124
00:16:21,290 --> 00:16:23,550
!أمسك بالسّماء

125
00:16:23,550 --> 00:16:25,050
!أمسكها؟

126
00:16:25,550 --> 00:16:27,720
!أصغِ يا مومونوسكي-كُن

127
00:16:30,350 --> 00:16:34,350
!يستطيع التّنانين إنشاء سحب

128
00:16:34,600 --> 00:16:36,520
!إ-إنشاء؟

129
00:16:36,850 --> 00:16:39,020
!أنت تنّين الآن

130
00:16:39,350 --> 00:16:42,860
!أنت تنّين ضخم يحلّق في السّماء

131
00:16:50,030 --> 00:16:52,290
!بإمكانك النّجاح

132
00:16:53,870 --> 00:16:56,750
!أنا... تنّين

133
00:16:57,950 --> 00:16:59,250
...وأنشئ

134
00:17:00,170 --> 00:17:01,670
!سُحبًا

135
00:17:06,670 --> 00:17:07,760
!أعرف ذلك

136
00:17:08,220 --> 00:17:09,470
!أعرف كيف

137
00:17:09,880 --> 00:17:11,190
!هذه هي

138
00:17:16,680 --> 00:17:17,980
!كينييمون

139
00:17:19,140 --> 00:17:21,940
!خذي مومونوسكي-ساما واهربا

140
00:17:23,730 --> 00:17:25,280
...سوف

141
00:17:28,190 --> 00:17:31,830
!أعود من أجلك بكلّ تأكيد

142
00:17:33,410 --> 00:17:35,830
!إنّ التّنانين لا تطير

143
00:17:35,830 --> 00:17:39,170
...بل تُنشئ سُحبًا وتمسك بها

144
00:17:40,660 --> 00:17:42,670
!وتركض عبر السّماء

145
00:17:43,080 --> 00:17:45,130
!هذا ما تفعله التّنانين

146
00:17:50,100 --> 00:17:53,890
!أنا أطير

147
00:17:54,590 --> 00:17:56,890
...اسم هذه السُّحب هو

148
00:18:01,560 --> 00:18:03,230
!سُحب اللّهب

149
00:18:33,060 --> 00:18:36,980
!أسلوب أودن للسّيف الواحد

150
00:18:48,820 --> 00:18:54,160
...صدام القطّ

151
00:19:03,910 --> 00:19:07,050
!الضّاحك

152
00:19:15,130 --> 00:19:19,560
!أيّها القذر

153
00:19:20,730 --> 00:19:21,770
...سهم الكلب

154
00:19:22,320 --> 00:19:25,400
!القاطع

155
00:20:04,680 --> 00:20:05,980
...بيدرو

156
00:20:06,850 --> 00:20:10,940
ليتني استطعت أن أحتسي شرابًا معك
...بينما نشاهد القمر

157
00:20:12,860 --> 00:20:14,690
!سيّدي نيكوماموشي

158
00:20:14,690 --> 00:20:16,780
!كاروت

159
00:20:17,740 --> 00:20:20,580
!أنا جدّ سعيدة! كنت مذهلاً للغاية

160
00:20:21,740 --> 00:20:24,160
!كان ذلك رائعًا يا سيّدي

161
00:20:24,160 --> 00:20:25,290
!نعم

162
00:20:25,290 --> 00:20:27,960
!نجحت أخيرًا يا سيّدي

163
00:20:28,330 --> 00:20:31,630
!بيدرو... سيكون سعيدًا الآن

164
00:20:34,130 --> 00:20:35,510
...أنتم-غارا

165
00:20:37,760 --> 00:20:41,270
.كونوا حذرين. وإلاّ دخلتم تحوّل السّولونغ

166
00:20:43,430 --> 00:20:45,930
...لا أعرف كيف

167
00:20:45,930 --> 00:20:49,020
...لكنّ القمر ظاهر بالكامل الآن

168
00:21:09,790 --> 00:21:12,670
!ثمّة غضب في كلّ المينك

169
00:21:21,970 --> 00:21:24,890
...لا أصدّق أنّ جاك قد

170
00:21:25,720 --> 00:21:30,360
...لم أتوقّع أنّ أحد كبار النّجوم سيُهزم

171
00:21:34,440 --> 00:21:37,410
!لكنّ ذلك لا يهمّني

172
00:21:49,370 --> 00:21:52,000
،إن خسرت

173
00:21:52,000 --> 00:21:55,380
!سيصير الجميع في هذه البلاد عبدًا

174
00:21:57,050 --> 00:21:59,630
،سيكون عليهم أن يعيشوا من أجلي

175
00:21:59,630 --> 00:22:03,140
...وسيكون عليهم الموت من أجلي

176
00:22:07,890 --> 00:22:10,280
...قريبًا، هذه الجزيرة

177
00:22:10,560 --> 00:22:13,480
!ستنزل على عاصمة الزّهور

178
00:22:14,520 --> 00:22:17,240
،سندمّر عاصمة الزّهور

179
00:22:17,240 --> 00:22:22,780
وستصير بلاد وانو إمبراطوريّة قراصنة
!تُدعى أونيغاشيما الجديدة

180
00:22:22,780 --> 00:22:25,750
!سيوقف مومو هذه الجزيرة

181
00:22:27,370 --> 00:22:30,710
!كفاك نباحًا يا قبّعة القشّ لوفي

182
00:22:30,910 --> 00:22:33,380
!حافظ على هدوئك

183
00:22:33,670 --> 00:22:37,170
!لا أمل يُرجى من أولئك الأشقياء
!لا حول لهم بتاتًا

184
00:22:37,500 --> 00:22:39,550
...أمّا أنت

185
00:22:39,550 --> 00:22:42,220
!عليك الموت ها هنا

186
00:22:45,760 --> 00:22:50,190
!سأعاملك معاملة خاصّة

187
00:23:04,490 --> 00:23:07,530
.مخزون هائل من المتفجّرات والأسلحة

188
00:23:07,530 --> 00:23:09,660
.سينفجر بالكامل إن سقط

189
00:23:09,660 --> 00:23:14,080
تحوّلت أونيغاشيما إلى قنبلة عملاقة
!تحوم فوق سماء عاصمة الزّهور

190
00:23:14,080 --> 00:23:17,750
،لإيقاف حصن الموت الطّائر الّذي بدأ بالسّقوط

191
00:23:17,750 --> 00:23:21,840
!ينطلق ياماتو ومومونوسكي في مهمّة بالغة السّرّيّة

192
00:23:22,420 --> 00:23:23,920
:في الحلقة القادمة من وان بيس

193
00:23:23,920 --> 00:23:27,180
"!زادت حدّة الوضع أكثر! نهاية أونيغاشيما"

194
00:23:27,180 --> 00:23:31,640
!ملك القراصنة، لن يكون إلاّ أنا