1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,900 --> 00:03:23,780
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:23,780 --> 00:03:27,570
.اجتيح لوفي بحزن لا يطاق

39
00:03:28,070 --> 00:03:32,330
...إلاّ أنّ هنالك قصّة لم تُحكَ عن الإخوة

40
00:03:33,000 --> 00:03:38,960
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كانا طفلين

41
00:03:42,360 --> 00:03:47,130
"!سُلبت الحرّيّة! فخّ النّبلاء يهدّد الإخوة"

42
00:03:50,970 --> 00:03:54,000
!ها هي ذي! ثمّة عاصفة قادمة

43
00:03:54,000 --> 00:03:57,230
!نحن جاهزون لها! دعها تأتي

44
00:03:57,230 --> 00:04:01,500
!رائع! الرّياح تشتدّ أكثر فأكثر

45
00:04:01,500 --> 00:04:04,230
!لوفي، أمسك العلَم بإحكام

46
00:04:04,230 --> 00:04:07,460
!ليس من الرّائع أن يفقد القراصنة علَمهم في العاصفة

47
00:04:07,460 --> 00:04:11,000
!حسنًا! هيّا أيّتها الرّيح الهوجاء

48
00:04:11,000 --> 00:04:13,500
!هيّا أيّتها الرّيح العنيفة

49
00:04:13,500 --> 00:04:15,290
!أرني ما لديك أيّتها الوغدة

50
00:04:18,330 --> 00:04:19,800
!ها هي ذي

51
00:04:21,870 --> 00:04:23,420
!لوفي

52
00:04:24,310 --> 00:04:25,210
!هل أنت بخير؟

53
00:04:25,210 --> 00:04:27,530
!ساعداني

54
00:04:28,830 --> 00:04:30,680
ماذا تفعل يا لوفي؟

55
00:04:32,010 --> 00:04:35,360
!كفّا عن الضّحك وساعداني

56
00:04:43,230 --> 00:04:46,530
!رائع! نجونا من العاصفة

57
00:04:46,530 --> 00:04:49,200
.لكنّ المخبأ دُمّر

58
00:04:49,200 --> 00:04:51,630
.حسنًا، لنذهب لجمع الموادّ

59
00:04:51,630 --> 00:04:53,680
.أريد منظارًا

60
00:04:53,780 --> 00:04:56,700
.لن تجد شيئًا كذاك هنا أبدًا أيّها الغبيّ

61
00:04:56,700 --> 00:04:58,790
.أفضّل إيجاد مدفع

62
00:04:58,790 --> 00:05:01,830
!سيكون من الرّائع إن استطعنا إيجاد مدفع

63
00:05:05,360 --> 00:05:09,050
.لا فائدة يا إيس. لا أستطيع إيجاد منظار

64
00:05:09,050 --> 00:05:13,840
.لوفي، لم نأت إلى هنا لإيجاد منظار
.ابحث عن موادّ البناء

65
00:05:15,730 --> 00:05:18,180
.قد تكون هذه كافية

66
00:05:22,300 --> 00:05:25,940
.إنّه منظار! سيسعد لوفي

67
00:05:30,340 --> 00:05:32,650
!يا فتى

68
00:05:32,650 --> 00:05:37,700
لم أعلم أنّ أحد الأشقياء الشّائنين
.ينحدر من عائلة نبيلة

69
00:05:38,070 --> 00:05:40,790
بلوجام! كيف علمت؟

70
00:05:41,870 --> 00:05:44,790
.بادروا يا رفاق. لكن لا تتركوا عليه أيّ علامة

71
00:05:47,660 --> 00:05:49,420
!هل تريدون القتال؟

72
00:05:56,200 --> 00:05:57,700
!إيس! لوفي

73
00:05:57,700 --> 00:05:59,700
...أشعر بالدّوار

74
00:05:58,310 --> 00:05:59,700
هل أن بخير يا سابو؟

75
00:05:59,700 --> 00:06:00,700
!أجل

76
00:06:00,700 --> 00:06:05,140
إن قاتلنا نحن الثّلاثة معًا، يمكننا الفوز
!على هؤلاء الحمقى بكلّ سهولة

77
00:06:05,140 --> 00:06:08,860
!هذا صحيح! حتّى أنّنا هزمنا نمر جبل كولبو الكبير

78
00:06:08,860 --> 00:06:11,100
!أيّها الوضعيون الصّغار

79
00:06:11,100 --> 00:06:15,280
!لننه هذا الأمر بقتل قبطانهم فحسب

80
00:06:15,280 --> 00:06:16,240
!حسنًا

81
00:06:29,960 --> 00:06:30,960
!سحقًا

82
00:06:38,850 --> 00:06:41,870
!حسنًا أيّها الأشقياء، لا تتحرّكوا

83
00:06:41,870 --> 00:06:44,060
!لست خائفًا من ذلك

84
00:06:44,060 --> 00:06:45,690
!سحقًا! اتركني

85
00:06:45,690 --> 00:06:46,730
!أيّها الوغد

86
00:06:46,730 --> 00:06:49,270
!ابتعد عنّي! وإلاّ أسعتك ضربًا

87
00:06:49,270 --> 00:06:51,730
...دعني أيّها الوغد

88
00:07:02,360 --> 00:07:04,790
.بالكاد وصلت في الوقت

89
00:07:04,790 --> 00:07:06,290
!أبي

90
00:07:07,830 --> 00:07:11,000
.لم نؤذ شعرة منه يا سيّدي

91
00:07:11,000 --> 00:07:11,720
!أنت

92
00:07:11,720 --> 00:07:13,260
!...سحقًا! أيّها الـ

93
00:07:13,260 --> 00:07:14,130
!سابو

94
00:07:14,670 --> 00:07:17,720
هل أراد إيجادي بشدّة لدرجة أنّه عيّنَ قراصنة؟

95
00:07:17,720 --> 00:07:23,220
.إذًا هما من أغويا سابو لطريق الشّرّ

96
00:07:23,220 --> 00:07:24,580
!أعده

97
00:07:24,580 --> 00:07:28,560
.ماذا تقصد بـ"أعده"؟ سابو ابني

98
00:07:28,560 --> 00:07:32,820
على الأطفال أن يعيشوا كما يخبرهم آباؤهم
.لأنّ أباءهم من جلبوهم لهذا العالم

99
00:07:33,220 --> 00:07:36,940
!كيف تجرؤان عن إغواء سابو للهرب؟

100
00:07:36,940 --> 00:07:39,410
!أيّها الشّقيّان الفاسدان

101
00:07:39,410 --> 00:07:41,740
!هل تسعيان خلف مالي؟

102
00:07:41,740 --> 00:07:43,080
!ماذا قلت؟

103
00:07:45,910 --> 00:07:50,040
!أيّها القرصان! احذر من ضرب ذلك الفتى

104
00:07:50,040 --> 00:07:53,670
!لقد لطّخني بدمائه الوضيعة

105
00:07:54,130 --> 00:07:55,380
!إيس

106
00:07:56,510 --> 00:07:57,630
!أنت

107
00:07:57,630 --> 00:08:01,010
!توقّف! لم يغوني أحد

108
00:08:01,510 --> 00:08:03,730
!بل هربت بمحض إرادتي

109
00:08:03,730 --> 00:08:05,720
.ابق بعيدًا عن هذا! أنت

110
00:08:07,770 --> 00:08:10,100
.سأترك الباقي لكم أيّها القراصنة

111
00:08:10,360 --> 00:08:14,020
.بالطّبع يا سيّدي. سبق ودفعت لنا من أجل هذا

112
00:08:14,570 --> 00:08:19,840
.سنعتني بأمر هذين الاثنين حتّى لا يزعجان ابنك ثانيةً

113
00:08:21,420 --> 00:08:26,280
!انتظر يا بلوجام! أبي، يكفي! فهمت

114
00:08:27,040 --> 00:08:29,240
ماذا فهمت؟

115
00:08:30,730 --> 00:08:32,460
!لا تفعل يا سابو

116
00:08:33,450 --> 00:08:39,130
...سأفعل ما تقول وأعيش كما تريد

117
00:08:39,130 --> 00:08:43,840
!فلا تؤذيهما أرجوك

118
00:08:43,840 --> 00:08:46,100
.أترجّاك

119
00:08:46,100 --> 00:08:48,850
.إنّهما مهمّان جدًّا لي، إنّهما أخواي

120
00:08:50,240 --> 00:08:51,600
...سابو

121
00:08:52,270 --> 00:08:55,980
.إذًا عد إلى البيت الآن

122
00:08:55,980 --> 00:08:59,690
.عليك أن تكفّ عن لعب لعبة القراصنة
.إنّها مضيعة للوقت

123
00:09:01,930 --> 00:09:03,700
!أنت! لا تذهب

124
00:09:03,700 --> 00:09:05,270
!صمتًا

125
00:09:05,270 --> 00:09:09,450
!سابو، اهرب! لست بحاجة للقلق بشأننا

126
00:09:09,980 --> 00:09:12,330
!قلت أنّك تريد أن تعيش بحرّيّة معنا

127
00:09:12,720 --> 00:09:14,830
!سابو، لا تذهب

128
00:09:15,360 --> 00:09:17,750
!هل ستنهي حلمك؟

129
00:09:18,380 --> 00:09:19,800
!سابو

130
00:09:22,510 --> 00:09:23,880
!سابو

131
00:09:28,910 --> 00:09:31,030
!سابو

132
00:09:37,230 --> 00:09:39,690
أيّها القبطان! ماذا نفعل بهذين الطّفلين؟

133
00:09:40,860 --> 00:09:42,650
.خذهما إلى مخبئنا

134
00:09:42,650 --> 00:09:43,400
.حاضر

135
00:09:44,530 --> 00:09:46,800
!أيّها الوغد! فكّ وثاقي

136
00:09:46,800 --> 00:09:50,080
!قاتلني مجدّدًا! لن أخسر هذه المرّة

137
00:09:50,080 --> 00:09:51,500
!صمتًا

138
00:09:51,500 --> 00:09:54,920
!لِمَ جلبتمونا إلى هنا؟

139
00:09:54,920 --> 00:09:59,880
،لا بدّ أنّ من الجميل أن يكون المرء نبيلاً
أليس كذلك أيّها الشّقيّان؟

140
00:10:00,340 --> 00:10:03,720
فهم يزدرون الآخرين كما لو أنّهم
.حثالة ويتسلّطون على الجميع

141
00:10:03,720 --> 00:10:06,640
.يا لها من حياة ميسّرة

142
00:10:06,640 --> 00:10:09,640
ألا تظنّان أنّ ذلك جميل؟

143
00:10:09,640 --> 00:10:11,640
!ما الّذي ترمي إليه؟

144
00:10:11,640 --> 00:10:15,770
!أن تكون قرصانًا أفضل بكثير
!هذا ما قاله سابو

145
00:10:15,770 --> 00:10:20,860
.أشعر بالأسف عليكما. أنت، فكّ وثاقهما

146
00:10:20,860 --> 00:10:21,820
.حاضر

147
00:10:21,820 --> 00:10:27,780
لِمَ هرب طفل من عائلة نبيلة
إلى مكان مثل غري ترمينال برأيكما؟

148
00:10:29,040 --> 00:10:34,960
.فعل ذلك استهزاءً بالنّاس هنا كما يفعل النّبلاء البالغون

149
00:10:35,360 --> 00:10:38,500
.أراهن أنّه كان يزدريكما أيضًا

150
00:10:38,500 --> 00:10:41,880
!هذا غير صحيح! ما كان سابو ليفعل ذلك

151
00:10:41,880 --> 00:10:44,220
!معه حقّ! نحن إخوة

152
00:10:44,220 --> 00:10:47,150
.حقًّا؟ حسنًا، آسف

153
00:10:48,140 --> 00:10:52,770
لكنّكما لن تزعجا ذلك الشّقيّ، أليس كذلك؟

154
00:10:53,120 --> 00:10:54,700
،إن كنتما تنويان فعل ذلك

155
00:10:54,700 --> 00:10:57,650
.فسأضطرّ لقتلكما ها هنا

156
00:10:57,650 --> 00:11:01,440
.إن كنتما تعتبرانه أخًا لكما، فمن الأفضل أن تتركاه وشأنه

157
00:11:03,010 --> 00:11:05,780
لصالح سابو؟

158
00:11:06,080 --> 00:11:08,570
!لكنّ سابو يكره المدينة العليا

159
00:11:08,570 --> 00:11:13,370
.عليكما أن تدعاه وشأنه إن كنتما تهتمّان لأمره حقًّا

160
00:11:13,370 --> 00:11:16,120
...ستفهمان عندما تكبران. و

161
00:11:16,560 --> 00:11:21,040
أنا حاقد عليكما لما فعلتماه لبورشيمي

162
00:11:21,040 --> 00:11:25,920
.لكن يمكننا أن ننسى بشأن ذلك
.بل أحببت استعراضكما للقوّة

163
00:11:25,920 --> 00:11:30,510
.لهذا أردت أن أطلب منكما شيئًا
.أظنّ أنّه سينال اهتمامكما

164
00:11:30,510 --> 00:11:37,020
ينقصني الرّجال. فهل تريدان العمل معي؟

165
00:11:37,020 --> 00:11:42,020
.إنّها مهمّة سهلة ولا تحتوي على أيّ خطورة

166
00:11:42,410 --> 00:11:44,940
.هناك خريطة لغري ترمينال

167
00:11:44,940 --> 00:11:49,160
وما عليكما سوى أن تحملا رُزمًا
.إلى المواقع المحدّدة على الخريطة

168
00:11:49,160 --> 00:11:50,490
هل تريدان فعلها؟

169
00:11:50,490 --> 00:11:51,860
.حسنًا

170
00:11:53,080 --> 00:11:54,330
كم ستدفع؟

171
00:11:59,080 --> 00:12:03,130
.إيس، لا أحبّذ عدم وجود سابو معنا

172
00:12:03,130 --> 00:12:08,050
.تعايش مع الأمر. لا أحبّذ ذلك أيضًا
.أريد إنقاذ سابو

173
00:12:08,050 --> 00:12:12,650
.لكن لا أدري ما هو أفضل له حقًّا

174
00:12:13,480 --> 00:12:16,470
.لنرَ كيف ستسير الأمور. إنّه بخير

175
00:12:16,470 --> 00:12:19,640
.إن كان لا يستطيع تحمّل الأمر هنا
.يمكنه العودة فحسب

176
00:12:20,390 --> 00:12:24,240
.لنجن بعض المال لمدّخرات القراصنة من أجل تلك المناسبة

177
00:12:26,090 --> 00:12:28,900
.لا أستطيع قول ذلك. ليس خطأ إيس ولوفي

178
00:12:28,900 --> 00:12:31,910
!لِمَ لا تستطيع قول الحقيقة؟

179
00:12:31,910 --> 00:12:37,410
هل لأنّهما حذّراك من قول أيّ شيء؟

180
00:12:37,410 --> 00:12:39,870
!ليسا من ذلك النّوع من النّاس

181
00:12:39,870 --> 00:12:46,800
إن كنت تملك سجلاًّ إجراميًّا، فإنّ ذلك يفسد
.سمعة عائلتك ولا تستطيع دخول المدينة العليا

182
00:12:46,800 --> 00:12:49,210
،قام ذلكما الاثنان بإغوائك

183
00:12:49,210 --> 00:12:53,050
،ولم يكن لديك خيار سوى المشاركة في العنف

184
00:12:53,050 --> 00:12:55,040
أليس كذلك يا سابو؟

185
00:12:57,780 --> 00:12:59,060
.سابو

186
00:12:59,060 --> 00:13:04,310
.مصير صديقيك في غري ترمينال بين يديْ أولئك القراصنة

187
00:13:04,310 --> 00:13:06,490
.ويمكنني أن أمنحهم أمرًا

188
00:13:07,000 --> 00:13:09,430
،إن كانا مهمّان لك

189
00:13:09,430 --> 00:13:11,860
.فكّر فيمَ عليك فعله

190
00:13:14,700 --> 00:13:19,120
.أنت ولد ذكيّ وتعي ما عليك فعله

191
00:13:19,950 --> 00:13:23,540
!وعدتني ألاّ تؤذيهما

192
00:13:23,540 --> 00:13:26,170
!لهذا عدت إلى هنا

193
00:13:26,490 --> 00:13:30,840
...تظلّ الجريمة جريمة! ارتكبناها بمحض إرادتنا

194
00:13:33,650 --> 00:13:35,430
!صدقًا

195
00:13:36,220 --> 00:13:40,020
!من المحزن جدًّا أن تملك ابنًا غبيًّا كهذا

196
00:13:40,980 --> 00:13:43,270
ألا يمكنك تفهّم معضلتي؟

197
00:13:43,270 --> 00:13:46,520
.لا بدّ أنّ ذلك صعب جدًّا

198
00:13:47,230 --> 00:13:50,030
.سأهتمّ بأمر الورق

199
00:14:06,540 --> 00:14:09,460
.مرحبًا بعودتك يا سيّدي

200
00:14:09,460 --> 00:14:13,840
.حسنًا يا سابو، لنذهب. مضى وقت طويل مذ غادرت

201
00:14:13,840 --> 00:14:17,550
.لا تدخل بعد أيّها القذر

202
00:14:17,550 --> 00:14:20,410
.اغسل وعقّم جسدك في الفناء أوّلاً

203
00:14:20,410 --> 00:14:22,350
.ثمّ استحمّ

204
00:14:22,350 --> 00:14:25,690
.أنا مسرور لأنّك بأمان يا سيّدي الصّغير

205
00:14:25,690 --> 00:14:30,000
.سابو! عدتَ وقد أصبحت أكبر

206
00:14:31,440 --> 00:14:32,400
.أمّي

207
00:14:32,400 --> 00:14:35,240
.والآن يا ستيلي، رحّب بأخيك الأكبر

208
00:14:35,680 --> 00:14:40,330
.سعيد للقائك يا أخي! اسمي ستيلي وعمري 8

209
00:14:41,120 --> 00:14:42,240
من هو؟

210
00:14:43,750 --> 00:14:47,540
.لقد تبنّيناه. إنّه ولد ذكيّ من عائلة نبيلة

211
00:14:47,540 --> 00:14:51,880
.لكن لسبب ما، أصبح والداه مهملان

212
00:14:52,390 --> 00:14:55,320
.وأويناه بما أنّ لديه مستقبلاً واعدًا

213
00:14:56,000 --> 00:15:00,070
...إلّم تعمل لتصبح وريثي

214
00:15:01,320 --> 00:15:04,440
.لا، إنّي أخبرك بأكثر من اللاّزم

215
00:15:04,440 --> 00:15:05,920
.اذهب لغرفتك الآن

216
00:15:05,920 --> 00:15:07,940
.عليك أن تبدأ الدّراسة غدًا

217
00:15:17,320 --> 00:15:20,030
!هل ستنهي حلمك؟

218
00:15:23,040 --> 00:15:27,710
.يا أخي! سمعت أنّك غبيّ للغاية

219
00:15:28,460 --> 00:15:31,880
.كان أبوانا يقولان ذلك دائمًا خلف السّتار

220
00:15:32,330 --> 00:15:37,630
لكن لديك حظّ الشّيطان
.لأنّهم سيعتنون بالمحروقات ليلة غد

221
00:15:38,350 --> 00:15:41,250
،لو أنّك بقيت في غري ترمينال

222
00:15:42,260 --> 00:15:45,320
.لمتّ غدًا

223
00:15:45,980 --> 00:15:52,480
في الواقع، كان سيناسبني لو أنّ ابنهما
.الحقيقيّ لم يعد إلى البيت

224
00:15:52,480 --> 00:15:56,360
!مـ-مـ-ما الّذي تفعله؟! سأخبر أبي

225
00:15:56,360 --> 00:15:59,210
!عمّاذا كنت تتحدّث؟

226
00:15:59,210 --> 00:16:01,410
!ما الّذي يجري؟ أخبرني بكلّ شيء

227
00:16:01,740 --> 00:16:06,500
.سـ-سيُضرم حريق في غري ترمينال غدًا

228
00:16:07,010 --> 00:16:07,830
!حريق؟

229
00:16:07,830 --> 00:16:09,100
.أجل

230
00:16:09,100 --> 00:16:12,310
.لا تدري بشأنها لأنّك لم تكن هنا

231
00:16:12,310 --> 00:16:14,880
.لكنّهم قرّروا ذلك قبل أشهر

232
00:16:15,340 --> 00:16:17,400
هل علمتَ أنّ حكومة العالم

233
00:16:17,400 --> 00:16:20,180
بعثت مجموعة من المراقبين ليجوبوا الأزرق الشّرقيّ؟

234
00:16:20,730 --> 00:16:24,370
!سيصلون إلى مملكة غوا أخيرًا بعد ثلاثة أيّام

235
00:16:25,080 --> 00:16:27,810
ومعهم أحد نبلاء العالم

236
00:16:27,810 --> 00:16:30,960
!والتّنانين السّماويّين، لذا فالنّاس مذعورون

237
00:16:30,960 --> 00:16:36,070
،لا يريد أفراد العائلة المالكة أن يرى وصمة عارنا

238
00:16:36,070 --> 00:16:40,160
.لذا قرّروا إحراق غري ترمينال عن بكرة أبيها

239
00:16:40,160 --> 00:16:43,200
!حينها ستنظّف هذه البلاد

240
00:16:43,200 --> 00:16:48,370
!عمّاذا تتحدّث؟ هذا مستحيل

241
00:16:48,370 --> 00:16:52,080
!ثمّة الكثير من النّاس يعيشون هناك

242
00:16:52,080 --> 00:16:54,460
!لا يمكنهم سلبهم ديارهم

243
00:16:54,460 --> 00:16:56,160
!اتركني

244
00:16:56,160 --> 00:16:58,710
ألم تنصت لي؟

245
00:17:00,690 --> 00:17:04,550
.سيحرقون كلّ عار هذه البلاد

246
00:17:05,340 --> 00:17:07,430
أتقصد النّاس أيضًا؟

247
00:17:14,060 --> 00:17:15,190
!أ-أنت

248
00:17:17,480 --> 00:17:18,820
إلى أين أنت ذاهب؟

249
00:17:23,110 --> 00:17:24,990
...لا يمكنك القفز

250
00:17:29,360 --> 00:17:31,580
.لـ-ليس خطئي

251
00:17:32,030 --> 00:17:34,080
!إنّها كذبة! لا بدّ أنّه يكذب

252
00:17:34,670 --> 00:17:38,580
!لا يمكن إحراق منطقة بذلك الحجم

253
00:17:42,970 --> 00:17:45,160
...كانوا هناك هذا العصر

254
00:17:46,480 --> 00:17:50,310
هل نحن جاهزون للغد؟ لا يمكن
.أن يكون هناك أيّ خطأ في الحسابات

255
00:17:50,310 --> 00:17:54,220
.نحن جاهزون لكنّ العنصر غير المعلوم هم القراصنة

256
00:17:54,220 --> 00:17:57,230
.عليهم إحراق القمامة على وجه الخصوص

257
00:17:57,820 --> 00:18:01,320
...يجهّز طاقم بلوجام صناديق الزّيت والمتفجّرات

258
00:18:01,320 --> 00:18:05,280
.في كلّ أرجاء غري ترمينال إلى حلول الوقت المحدّد غدًا

259
00:18:06,240 --> 00:18:09,980
!هل بلوجام متواطئ في هذا؟ إذًا لا بدّ أنّ ذلك صحيح

260
00:18:09,980 --> 00:18:11,830
!لكنّ هذا سخيف حقًّا

261
00:18:22,760 --> 00:18:25,450
.أتساءل كيف يبلي سابو

262
00:18:25,450 --> 00:18:27,600
.اخرس واخلد للنّوم

263
00:18:28,600 --> 00:18:31,780
.وافقنا أن نترك سابو في الوقت الرّاهن

264
00:18:31,780 --> 00:18:32,890
.حسنًا

265
00:18:33,810 --> 00:18:37,260
.قد يكون هذا في مصلحته

266
00:18:37,260 --> 00:18:39,050
...سابو

267
00:18:40,410 --> 00:18:41,570
!لوفي

268
00:18:42,200 --> 00:18:44,790
...منظار

269
00:19:11,360 --> 00:19:16,390
يمكنني أن أعرف إن كانت ستُضرم
.نارٌ أم لا بنظرة النّاس في البلدة

270
00:19:20,040 --> 00:19:21,980
!مرحبًا، صباح الخير

271
00:19:21,980 --> 00:19:23,110
!صباح الخير

272
00:19:23,110 --> 00:19:25,200
.إنّه صباح جميل

273
00:19:25,200 --> 00:19:26,570
.بالفعل

274
00:19:26,570 --> 00:19:30,660
!ممتاز! لا يوجد أيّ خطب

275
00:19:30,660 --> 00:19:32,620
.سأسير حول البلدة

276
00:19:32,620 --> 00:19:37,850
ينبغي أن يكون صباح الغد أكثر جمالاً، أليس كذلك؟

277
00:19:37,850 --> 00:19:39,630
.أجل، يفترض ذلك

278
00:19:45,880 --> 00:19:49,180
.يبدو كلّ شيء طبيعيّ كما العادة

279
00:19:51,800 --> 00:19:54,010
.اليوم عاصف

280
00:19:54,010 --> 00:19:57,340
.أجل بالفعل يا صاحب الجلالة

281
00:19:57,340 --> 00:20:02,610
يمكن أن تقع الحوادث بسهولة
.في مثل هذا اليوم، لا سيّما الحرائق

282
00:20:02,610 --> 00:20:06,280
.معك حقّ يا صاحب الجلالة

283
00:20:06,720 --> 00:20:09,450
!سابو ليس في البيت؟

284
00:20:09,450 --> 00:20:11,560
!يا له من شقيّ فاسد

285
00:20:11,560 --> 00:20:15,720
!أما زال يريد لعب لعبة القراصنة دون أن يدرس؟

286
00:20:16,420 --> 00:20:18,250
!ابحثوا في البلدة بأكملها

287
00:20:18,660 --> 00:20:21,080
!لا يمكن أن يكون قد خرج من البلدة بسهولة

288
00:20:22,430 --> 00:20:24,170
.المعذرة يا سيّدي

289
00:20:24,170 --> 00:20:25,260
ماذا تريد؟

290
00:20:25,720 --> 00:20:29,570
هل تعرف أنّه ستضرم نار في غري ترمينال اللّيلة؟

291
00:20:29,570 --> 00:20:33,430
أعرف بالطّبع. وماذا في ذلك؟

292
00:20:34,060 --> 00:20:35,180
يعرف؟

293
00:20:35,510 --> 00:20:37,770
من أيّ عائلة تنحدر؟

294
00:20:38,270 --> 00:20:40,640
!إذًا فذلك صحيح

295
00:20:42,240 --> 00:20:43,680
!يا فتى

296
00:20:43,680 --> 00:20:46,910
ما الّذي يجري هنا؟ الجميع يعلمون؟

297
00:20:46,910 --> 00:20:49,740
!الجميع يعلمون بشأن ذلك ويتصرّفون بشكل طبيعيّ؟

298
00:20:49,740 --> 00:20:53,920
!ألا يكترث أيّ أحد للنّار في غري ترمينال؟

299
00:20:57,200 --> 00:21:00,410
.أنتما هنا إذًا أيّها الشّقيّان

300
00:21:00,410 --> 00:21:02,670
هل تريدنا أن نحمل الصّناديق؟

301
00:21:02,670 --> 00:21:06,080
.أجل، وستكون هناك مهمّة كبيرة لكما اللّيلة

302
00:21:06,080 --> 00:21:07,710
.سأخبركما لاحقًا

303
00:21:13,070 --> 00:21:15,670
.أبي يعلم أيضًا

304
00:21:15,670 --> 00:21:18,680
.لهذا أعادني قبل أن تنشب النّار

305
00:21:18,680 --> 00:21:21,200
لأنّه يريدني أن أحافظ على مكانتهم

306
00:21:21,200 --> 00:21:24,440
!وأرث ممتلكاتهم مع أنّه يعتبرني أحمقًا

307
00:21:27,870 --> 00:21:32,090
.آسف إن كان كلبي يزعجك

308
00:21:32,090 --> 00:21:34,780
أرى أنّك تلهث، فما بالك يا فتى؟

309
00:21:35,200 --> 00:21:36,760
.لا شيء

310
00:21:36,760 --> 00:21:38,830
.حقًّا؟ حسنًا

311
00:21:39,840 --> 00:21:45,130
هـ-هل تعلم أنّه ستضرم نار في غري ترمينال اللّيلة؟

312
00:21:45,130 --> 00:21:47,290
.أجل، أعلم

313
00:21:47,290 --> 00:21:52,490
لِمَ لا أحد في البلدة بمن فيهم أنت يبدو قلقًا؟

314
00:21:52,490 --> 00:21:54,550
لِمَ لا يحاول أيّ أحد منع ذلك؟

315
00:21:56,600 --> 00:22:01,140
.تبدو كصبيّ طيّب

316
00:22:01,140 --> 00:22:03,810
.لكن أصغ جيّدًا

317
00:22:04,120 --> 00:22:07,150
!علينا أن نتستّر على الخطّة جميعًا

318
00:22:07,150 --> 00:22:11,990
ماذا إن عرف أحد من خارج البلدة بشأنها؟

319
00:22:12,500 --> 00:22:16,450
...نحن استثناء! إن كنت تنحدر من عائلة نبيلة

320
00:22:17,820 --> 00:22:18,990
!أنت

321
00:22:20,240 --> 00:22:21,950
!إيس! لوفي

322
00:22:22,640 --> 00:22:25,960
!ثمّة خطب بهذه البلدة! الجميع مجانين

323
00:22:26,210 --> 00:22:28,270
،مع أنّهم يعلمون أنّ النّاس سيموتون قريبًا

324
00:22:28,270 --> 00:22:30,960
!إلاّ أنّهم يتصرّفون بشكل طبيعيّ وحتّى أنّهم يبتسمون

325
00:22:31,670 --> 00:22:36,130
!لا أريد البقاء هنا! عليّ أن أخبرهما بسرعة

326
00:22:38,100 --> 00:22:41,560
!الرّيح عاتية اليوم من بين كلّ الأيّام

327
00:22:41,560 --> 00:22:44,180
!ها هو! أليس هو؟

328
00:22:44,180 --> 00:22:46,700
!لا شكّ في ذلك! ذلك هو الصّبيّ الهارب

329
00:22:47,230 --> 00:22:48,900
!أنت، توقّف

330
00:22:49,450 --> 00:22:54,570
!أهالي هذه البلاد يخطّطون لإحراق عارهم الوطنيّ اللّيلة

331
00:22:55,430 --> 00:22:58,950
!عليكما الخروج من غري ترمينال يا إيس ولوفي

332
00:22:59,610 --> 00:23:02,990
!اهربا! إيس! لوفي

333
00:23:11,550 --> 00:23:14,470
،بعد أن عرفا بسرّ اندلاع الحريق

334
00:23:14,470 --> 00:23:17,320
.يقع لوفي وإيس في ضيق شديد على يد بلوجام

335
00:23:17,800 --> 00:23:21,510
،يهرع سابو إلى غري ترمينال لإنقاذهما

336
00:23:21,510 --> 00:23:26,770
!لكنّ النّيران الحارقة الشّديدة على وشك التهام لوفي وإيس

337
00:23:26,770 --> 00:23:28,230
:في الحلقة القادمة من وان بيس

338
00:23:28,230 --> 00:23:31,060
"!أُضرمت النّار! غري ترمينال في أزمة"

339
00:23:31,060 --> 00:23:33,430
!ملك القراصنة، لن يكون إلاّ أنا

340
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة