1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,900 --> 00:03:37,780
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:37,780 --> 00:03:41,570
.اجتيح لوفي بحزن لا يطاق

39
00:03:42,070 --> 00:03:46,330
...إلاّ أنّ هنالك قصّة لم تُحكَ عن الإخوة

40
00:03:47,000 --> 00:03:52,960
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كانا طفلين

41
00:03:56,360 --> 00:04:01,130
"!سُلبت الحرّيّة! فخّ النّبلاء يهدّد الإخوة"

42
00:04:04,970 --> 00:04:08,000
!ها هي ذي! ثمّة عاصفة قادمة

43
00:04:08,000 --> 00:04:11,230
!نحن جاهزون لها! دعها تأتي

44
00:04:11,230 --> 00:04:15,500
!رائع! الرّياح تشتدّ أكثر فأكثر

45
00:04:15,500 --> 00:04:18,230
!لوفي، أمسك العلَم بإحكام

46
00:04:18,230 --> 00:04:21,460
!ليس من الرّائع أن يفقد القراصنة علَمهم في العاصفة

47
00:04:21,460 --> 00:04:25,000
!حسنًا! هيّا أيّتها الرّيح الهوجاء

48
00:04:25,000 --> 00:04:27,500
!هيّا أيّتها الرّيح العنيفة

49
00:04:27,500 --> 00:04:29,290
!أرني ما لديك أيّتها الوغدة

50
00:04:32,330 --> 00:04:33,800
!ها هي ذي

51
00:04:35,870 --> 00:04:37,420
!لوفي

52
00:04:38,310 --> 00:04:39,210
!هل أنت بخير؟

53
00:04:39,210 --> 00:04:41,530
!ساعداني

54
00:04:42,830 --> 00:04:44,680
ماذا تفعل يا لوفي؟

55
00:04:46,010 --> 00:04:49,360
!كفّا عن الضّحك وساعداني

56
00:04:57,230 --> 00:05:00,530
!رائع! نجونا من العاصفة

57
00:05:00,530 --> 00:05:03,200
.لكنّ المخبأ دُمّر

58
00:05:03,200 --> 00:05:05,630
.حسنًا، لنذهب لجمع الموادّ

59
00:05:05,630 --> 00:05:07,680
.أريد منظارًا

60
00:05:07,780 --> 00:05:10,700
.لن تجد شيئًا كذاك هنا أبدًا أيّها الغبيّ

61
00:05:10,700 --> 00:05:12,790
.أفضّل إيجاد مدفع

62
00:05:12,790 --> 00:05:15,830
!سيكون من الرّائع إن استطعنا إيجاد مدفع

63
00:05:19,360 --> 00:05:23,050
.لا فائدة يا إيس. لا أستطيع إيجاد منظار

64
00:05:23,050 --> 00:05:27,840
.لوفي، لم نأت إلى هنا لإيجاد منظار
.ابحث عن موادّ البناء

65
00:05:29,730 --> 00:05:32,180
.قد تكون هذه كافية

66
00:05:36,300 --> 00:05:39,940
.إنّه منظار! سيسعد لوفي

67
00:05:44,340 --> 00:05:46,650
!يا فتى

68
00:05:46,650 --> 00:05:51,700
لم أعلم أنّ أحد الأشقياء الشّائنين
.ينحدر من عائلة نبيلة

69
00:05:52,070 --> 00:05:54,790
بلوجام! كيف علمت؟

70
00:05:55,870 --> 00:05:58,790
.بادروا يا رفاق. لكن لا تتركوا عليه أيّ علامة

71
00:06:01,660 --> 00:06:03,420
!هل تريدون القتال؟

72
00:06:10,200 --> 00:06:11,700
!إيس! لوفي

73
00:06:11,700 --> 00:06:13,700
...أشعر بالدّوار

74
00:06:12,310 --> 00:06:13,700
هل أن بخير يا سابو؟

75
00:06:13,700 --> 00:06:14,700
!أجل

76
00:06:14,700 --> 00:06:19,140
إن قاتلنا نحن الثّلاثة معًا، يمكننا الفوز
!على هؤلاء الحمقى بكلّ سهولة

77
00:06:19,140 --> 00:06:22,860
!هذا صحيح! حتّى أنّنا هزمنا نمر جبل كولبو الكبير

78
00:06:22,860 --> 00:06:25,100
!أيّها الوضعيون الصّغار

79
00:06:25,100 --> 00:06:29,280
!لننه هذا الأمر بقتل قبطانهم فحسب

80
00:06:29,280 --> 00:06:30,240
!حسنًا

81
00:06:43,960 --> 00:06:44,960
!سحقًا

82
00:06:52,850 --> 00:06:55,870
!حسنًا أيّها الأشقياء، لا تتحرّكوا

83
00:06:55,870 --> 00:06:58,060
!لست خائفًا من ذلك

84
00:06:58,060 --> 00:06:59,690
!سحقًا! اتركني

85
00:06:59,690 --> 00:07:00,730
!أيّها الوغد

86
00:07:00,730 --> 00:07:03,270
!ابتعد عنّي! وإلاّ أسعتك ضربًا

87
00:07:03,270 --> 00:07:05,730
...دعني أيّها الوغد

88
00:07:16,360 --> 00:07:18,790
.بالكاد وصلت في الوقت

89
00:07:18,790 --> 00:07:20,290
!أبي

90
00:07:21,830 --> 00:07:25,000
.لم نؤذ شعرة منه يا سيّدي

91
00:07:25,000 --> 00:07:25,720
!أنت

92
00:07:25,720 --> 00:07:27,260
!...سحقًا! أيّها الـ

93
00:07:27,260 --> 00:07:28,130
!سابو

94
00:07:28,670 --> 00:07:31,720
هل أراد إيجادي بشدّة لدرجة أنّه عيّنَ قراصنة؟

95
00:07:31,720 --> 00:07:37,220
.إذًا هما من أغويا سابو لطريق الشّرّ

96
00:07:37,220 --> 00:07:38,580
!أعده

97
00:07:38,580 --> 00:07:42,560
.ماذا تقصد بـ"أعده"؟ سابو ابني

98
00:07:42,560 --> 00:07:46,820
على الأطفال أن يعيشوا كما يخبرهم آباؤهم
.لأنّ أباءهم من جلبوهم لهذا العالم

99
00:07:47,220 --> 00:07:50,940
!كيف تجرؤان عن إغواء سابو للهرب؟

100
00:07:50,940 --> 00:07:53,410
!أيّها الشّقيّان الفاسدان

101
00:07:53,410 --> 00:07:55,740
!هل تسعيان خلف مالي؟

102
00:07:55,740 --> 00:07:57,080
!ماذا قلت؟

103
00:07:59,910 --> 00:08:04,040
!أيّها القرصان! احذر من ضرب ذلك الفتى

104
00:08:04,040 --> 00:08:07,670
!لقد لطّخني بدمائه الوضيعة

105
00:08:08,130 --> 00:08:09,380
!إيس

106
00:08:10,510 --> 00:08:11,630
!أنت

107
00:08:11,630 --> 00:08:15,010
!توقّف! لم يغوني أحد

108
00:08:15,510 --> 00:08:17,730
!بل هربت بمحض إرادتي

109
00:08:17,730 --> 00:08:19,720
.ابق بعيدًا عن هذا! أنت

110
00:08:21,770 --> 00:08:24,100
.سأترك الباقي لكم أيّها القراصنة

111
00:08:24,360 --> 00:08:28,020
.بالطّبع يا سيّدي. سبق ودفعت لنا من أجل هذا

112
00:08:28,570 --> 00:08:33,840
.سنعتني بأمر هذين الاثنين حتّى لا يزعجان ابنك ثانيةً

113
00:08:35,420 --> 00:08:40,280
!انتظر يا بلوجام! أبي، يكفي! فهمت

114
00:08:41,040 --> 00:08:43,240
ماذا فهمت؟

115
00:08:44,730 --> 00:08:46,460
!لا تفعل يا سابو

116
00:08:47,450 --> 00:08:53,130
...سأفعل ما تقول وأعيش كما تريد

117
00:08:53,130 --> 00:08:57,840
!فلا تؤذيهما أرجوك

118
00:08:57,840 --> 00:09:00,100
.أترجّاك

119
00:09:00,100 --> 00:09:02,850
.إنّهما مهمّان جدًّا لي، إنّهما أخواي

120
00:09:04,240 --> 00:09:05,600
...سابو

121
00:09:06,270 --> 00:09:09,980
.إذًا عد إلى البيت الآن

122
00:09:09,980 --> 00:09:13,690
.عليك أن تكفّ عن لعب لعبة القراصنة
.إنّها مضيعة للوقت

123
00:09:15,930 --> 00:09:17,700
!أنت! لا تذهب

124
00:09:17,700 --> 00:09:19,270
!صمتًا

125
00:09:19,270 --> 00:09:23,450
!سابو، اهرب! لست بحاجة للقلق بشأننا

126
00:09:23,980 --> 00:09:26,330
!قلت أنّك تريد أن تعيش بحرّيّة معنا

127
00:09:26,720 --> 00:09:28,830
!سابو، لا تذهب

128
00:09:29,360 --> 00:09:31,750
!هل ستنهي حلمك؟

129
00:09:32,380 --> 00:09:33,800
!سابو

130
00:09:36,510 --> 00:09:37,880
!سابو

131
00:09:42,910 --> 00:09:45,030
!سابو

132
00:09:51,230 --> 00:09:53,690
أيّها القبطان! ماذا نفعل بهذين الطّفلين؟

133
00:09:54,860 --> 00:09:56,650
.خذهما إلى مخبئنا

134
00:09:56,650 --> 00:09:57,400
.حاضر

135
00:09:58,530 --> 00:10:00,800
!أيّها الوغد! فكّ وثاقي

136
00:10:00,800 --> 00:10:04,080
!قاتلني مجدّدًا! لن أخسر هذه المرّة

137
00:10:04,080 --> 00:10:05,500
!صمتًا

138
00:10:05,500 --> 00:10:08,920
!لِمَ جلبتمونا إلى هنا؟

139
00:10:08,920 --> 00:10:13,880
،لا بدّ أنّ من الجميل أن يكون المرء نبيلاً
أليس كذلك أيّها الشّقيّان؟

140
00:10:14,340 --> 00:10:17,720
فهم يزدرون الآخرين كما لو أنّهم
.حثالة ويتسلّطون على الجميع

141
00:10:17,720 --> 00:10:20,640
.يا لها من حياة ميسّرة

142
00:10:20,640 --> 00:10:23,640
ألا تظنّان أنّ ذلك جميل؟

143
00:10:23,640 --> 00:10:25,640
!ما الّذي ترمي إليه؟

144
00:10:25,640 --> 00:10:29,770
!أن تكون قرصانًا أفضل بكثير
!هذا ما قاله سابو

145
00:10:29,770 --> 00:10:34,860
.أشعر بالأسف عليكما. أنت، فكّ وثاقهما

146
00:10:34,860 --> 00:10:35,820
.حاضر

147
00:10:35,820 --> 00:10:41,780
لِمَ هرب طفل من عائلة نبيلة
إلى مكان مثل غري ترمينال برأيكما؟

148
00:10:43,040 --> 00:10:48,960
.فعل ذلك استهزاءً بالنّاس هنا كما يفعل النّبلاء البالغون

149
00:10:49,360 --> 00:10:52,500
.أراهن أنّه كان يزدريكما أيضًا

150
00:10:52,500 --> 00:10:55,880
!هذا غير صحيح! ما كان سابو ليفعل ذلك

151
00:10:55,880 --> 00:10:58,220
!معه حقّ! نحن إخوة

152
00:10:58,220 --> 00:11:01,150
.حقًّا؟ حسنًا، آسف

153
00:11:02,140 --> 00:11:06,770
لكنّكما لن تزعجا ذلك الشّقيّ، أليس كذلك؟

154
00:11:07,120 --> 00:11:08,700
،إن كنتما تنويان فعل ذلك

155
00:11:08,700 --> 00:11:11,650
.فسأضطرّ لقتلكما ها هنا

156
00:11:11,650 --> 00:11:15,440
.إن كنتما تعتبرانه أخًا لكما، فمن الأفضل أن تتركاه وشأنه

157
00:11:17,010 --> 00:11:19,780
لصالح سابو؟

158
00:11:20,080 --> 00:11:22,570
!لكنّ سابو يكره المدينة العليا

159
00:11:22,570 --> 00:11:27,370
.عليكما أن تدعاه وشأنه إن كنتما تهتمّان لأمره حقًّا

160
00:11:27,370 --> 00:11:30,120
...ستفهمان عندما تكبران. و

161
00:11:30,560 --> 00:11:35,040
أنا حاقد عليكما لما فعلتماه لبورشيمي

162
00:11:35,040 --> 00:11:39,920
.لكن يمكننا أن ننسى بشأن ذلك
.بل أحببت استعراضكما للقوّة

163
00:11:39,920 --> 00:11:44,510
.لهذا أردت أن أطلب منكما شيئًا
.أظنّ أنّه سينال اهتمامكما

164
00:11:44,510 --> 00:11:51,020
ينقصني الرّجال. فهل تريدان العمل معي؟

165
00:11:51,020 --> 00:11:56,020
.إنّها مهمّة سهلة ولا تحتوي على أيّ خطورة

166
00:11:56,410 --> 00:11:58,940
.هناك خريطة لغري ترمينال

167
00:11:58,940 --> 00:12:03,160
وما عليكما سوى أن تحملا رُزمًا
.إلى المواقع المحدّدة على الخريطة

168
00:12:03,160 --> 00:12:04,490
هل تريدان فعلها؟

169
00:12:04,490 --> 00:12:05,860
.حسنًا

170
00:12:07,080 --> 00:12:08,330
كم ستدفع؟

171
00:12:13,080 --> 00:12:17,130
.إيس، لا أحبّذ عدم وجود سابو معنا

172
00:12:17,130 --> 00:12:22,050
.تعايش مع الأمر. لا أحبّذ ذلك أيضًا
.أريد إنقاذ سابو

173
00:12:22,050 --> 00:12:26,650
.لكن لا أدري ما هو أفضل له حقًّا

174
00:12:27,480 --> 00:12:30,470
.لنرَ كيف ستسير الأمور. إنّه بخير

175
00:12:30,470 --> 00:12:33,640
.إن كان لا يستطيع تحمّل الأمر هنا
.يمكنه العودة فحسب

176
00:12:34,390 --> 00:12:38,240
.لنجن بعض المال لمدّخرات القراصنة من أجل تلك المناسبة

177
00:12:40,090 --> 00:12:42,900
.لا أستطيع قول ذلك. ليس خطأ إيس ولوفي

178
00:12:42,900 --> 00:12:45,910
!لِمَ لا تستطيع قول الحقيقة؟

179
00:12:45,910 --> 00:12:51,410
هل لأنّهما حذّراك من قول أيّ شيء؟

180
00:12:51,410 --> 00:12:53,870
!ليسا من ذلك النّوع من النّاس

181
00:12:53,870 --> 00:13:00,800
إن كنت تملك سجلاًّ إجراميًّا، فإنّ ذلك يفسد
.سمعة عائلتك ولا تستطيع دخول المدينة العليا

182
00:13:00,800 --> 00:13:03,210
،قام ذلكما الاثنان بإغوائك

183
00:13:03,210 --> 00:13:07,050
،ولم يكن لديك خيار سوى المشاركة في العنف

184
00:13:07,050 --> 00:13:09,040
أليس كذلك يا سابو؟

185
00:13:11,780 --> 00:13:13,060
.سابو

186
00:13:13,060 --> 00:13:18,310
.مصير صديقيك في غري ترمينال بين يديْ أولئك القراصنة

187
00:13:18,310 --> 00:13:20,490
.ويمكنني أن أمنحهم أمرًا

188
00:13:21,000 --> 00:13:23,430
،إن كانا مهمّان لك

189
00:13:23,430 --> 00:13:25,860
.فكّر فيمَ عليك فعله

190
00:13:28,700 --> 00:13:33,120
.أنت ولد ذكيّ وتعي ما عليك فعله

191
00:13:33,950 --> 00:13:37,540
!وعدتني ألاّ تؤذيهما

192
00:13:37,540 --> 00:13:40,170
!لهذا عدت إلى هنا

193
00:13:40,490 --> 00:13:44,840
...تظلّ الجريمة جريمة! ارتكبناها بمحض إرادتنا

194
00:13:47,650 --> 00:13:49,430
!صدقًا

195
00:13:50,220 --> 00:13:54,020
!من المحزن جدًّا أن تملك ابنًا غبيًّا كهذا

196
00:13:54,980 --> 00:13:57,270
ألا يمكنك تفهّم معضلتي؟

197
00:13:57,270 --> 00:14:00,520
.لا بدّ أنّ ذلك صعب جدًّا

198
00:14:01,230 --> 00:14:04,030
.سأهتمّ بأمر الورق

199
00:14:20,540 --> 00:14:23,460
.مرحبًا بعودتك يا سيّدي

200
00:14:23,460 --> 00:14:27,840
.حسنًا يا سابو، لنذهب. مضى وقت طويل مذ غادرت

201
00:14:27,840 --> 00:14:31,550
.لا تدخل بعد أيّها القذر

202
00:14:31,550 --> 00:14:34,410
.اغسل وعقّم جسدك في الفناء أوّلاً

203
00:14:34,410 --> 00:14:36,350
.ثمّ استحمّ

204
00:14:36,350 --> 00:14:39,690
.أنا مسرور لأنّك بأمان يا سيّدي الصّغير

205
00:14:39,690 --> 00:14:44,000
.سابو! عدتَ وقد أصبحت أكبر

206
00:14:45,440 --> 00:14:46,400
.أمّي

207
00:14:46,400 --> 00:14:49,240
.والآن يا ستيلي، رحّب بأخيك الأكبر

208
00:14:49,680 --> 00:14:54,330
.سعيد للقائك يا أخي! اسمي ستيلي وعمري 8

209
00:14:55,120 --> 00:14:56,240
من هو؟

210
00:14:57,750 --> 00:15:01,540
.لقد تبنّيناه. إنّه ولد ذكيّ من عائلة نبيلة

211
00:15:01,540 --> 00:15:05,880
.لكن لسبب ما، أصبح والداه مهملان

212
00:15:06,390 --> 00:15:09,320
.وأويناه بما أنّ لديه مستقبلاً واعدًا

213
00:15:10,000 --> 00:15:14,070
...إلّم تعمل لتصبح وريثي

214
00:15:15,320 --> 00:15:18,440
.لا، إنّي أخبرك بأكثر من اللاّزم

215
00:15:18,440 --> 00:15:19,920
.اذهب لغرفتك الآن

216
00:15:19,920 --> 00:15:21,940
.عليك أن تبدأ الدّراسة غدًا

217
00:15:31,320 --> 00:15:34,030
!هل ستنهي حلمك؟

218
00:15:37,040 --> 00:15:41,710
.يا أخي! سمعت أنّك غبيّ للغاية

219
00:15:42,460 --> 00:15:45,880
.كان أبوانا يقولان ذلك دائمًا خلف السّتار

220
00:15:46,330 --> 00:15:51,630
لكن لديك حظّ الشّيطان
.لأنّهم سيعتنون بالمحروقات ليلة غد

221
00:15:52,350 --> 00:15:55,250
،لو أنّك بقيت في غري ترمينال

222
00:15:56,260 --> 00:15:59,320
.لمتّ غدًا

223
00:15:59,980 --> 00:16:06,480
في الواقع، كان سيناسبني لو أنّ ابنهما
.الحقيقيّ لم يعد إلى البيت

224
00:16:06,480 --> 00:16:10,360
!مـ-مـ-ما الّذي تفعله؟! سأخبر أبي

225
00:16:10,360 --> 00:16:13,210
!عمّاذا كنت تتحدّث؟

226
00:16:13,210 --> 00:16:15,410
!ما الّذي يجري؟ أخبرني بكلّ شيء

227
00:16:15,740 --> 00:16:20,500
.سـ-سيُضرم حريق في غري ترمينال غدًا

228
00:16:21,010 --> 00:16:21,830
!حريق؟

229
00:16:21,830 --> 00:16:23,100
.أجل

230
00:16:23,100 --> 00:16:26,310
.لا تدري بشأنها لأنّك لم تكن هنا

231
00:16:26,310 --> 00:16:28,880
.لكنّهم قرّروا ذلك قبل أشهر

232
00:16:29,340 --> 00:16:31,400
هل علمتَ أنّ حكومة العالم

233
00:16:31,400 --> 00:16:34,180
بعثت مجموعة من المراقبين ليجوبوا الأزرق الشّرقيّ؟

234
00:16:34,730 --> 00:16:38,370
!سيصلون إلى مملكة غوا أخيرًا بعد ثلاثة أيّام

235
00:16:39,080 --> 00:16:41,810
ومعهم أحد نبلاء العالم

236
00:16:41,810 --> 00:16:44,960
!والتّنانين السّماويّين، لذا فالنّاس مذعورون

237
00:16:44,960 --> 00:16:50,070
،لا يريد أفراد العائلة المالكة أن يرى وصمة عارنا

238
00:16:50,070 --> 00:16:54,160
.لذا قرّروا إحراق غري ترمينال عن بكرة أبيها

239
00:16:54,160 --> 00:16:57,200
!حينها ستنظّف هذه البلاد

240
00:16:57,200 --> 00:17:02,370
!عمّاذا تتحدّث؟ هذا مستحيل

241
00:17:02,370 --> 00:17:06,080
!ثمّة الكثير من النّاس يعيشون هناك

242
00:17:06,080 --> 00:17:08,460
!لا يمكنهم سلبهم ديارهم

243
00:17:08,460 --> 00:17:10,160
!اتركني

244
00:17:10,160 --> 00:17:12,710
ألم تنصت لي؟

245
00:17:14,690 --> 00:17:18,550
.سيحرقون كلّ عار هذه البلاد

246
00:17:19,340 --> 00:17:21,430
أتقصد النّاس أيضًا؟

247
00:17:28,060 --> 00:17:29,190
!أ-أنت

248
00:17:31,480 --> 00:17:32,820
إلى أين أنت ذاهب؟

249
00:17:37,110 --> 00:17:38,990
...لا يمكنك القفز

250
00:17:43,360 --> 00:17:45,580
.لـ-ليس خطئي

251
00:17:46,030 --> 00:17:48,080
!إنّها كذبة! لا بدّ أنّه يكذب

252
00:17:48,670 --> 00:17:52,580
!لا يمكن إحراق منطقة بذلك الحجم

253
00:17:56,970 --> 00:17:59,160
...كانوا هناك هذا العصر

254
00:18:00,480 --> 00:18:04,310
هل نحن جاهزون للغد؟ لا يمكن
.أن يكون هناك أيّ خطأ في الحسابات

255
00:18:04,310 --> 00:18:08,220
.نحن جاهزون لكنّ العنصر غير المعلوم هم القراصنة

256
00:18:08,220 --> 00:18:11,230
.عليهم إحراق القمامة على وجه الخصوص

257
00:18:11,820 --> 00:18:15,320
...يجهّز طاقم بلوجام صناديق الزّيت والمتفجّرات

258
00:18:15,320 --> 00:18:19,280
.في كلّ أرجاء غري ترمينال إلى حلول الوقت المحدّد غدًا

259
00:18:20,240 --> 00:18:23,980
!هل بلوجام متواطئ في هذا؟ إذًا لا بدّ أنّ ذلك صحيح

260
00:18:23,980 --> 00:18:25,830
!لكنّ هذا سخيف حقًّا

261
00:18:36,760 --> 00:18:39,450
.أتساءل كيف يبلي سابو

262
00:18:39,450 --> 00:18:41,600
.اخرس واخلد للنّوم

263
00:18:42,600 --> 00:18:45,780
.وافقنا أن نترك سابو في الوقت الرّاهن

264
00:18:45,780 --> 00:18:46,890
.حسنًا

265
00:18:47,810 --> 00:18:51,260
.قد يكون هذا في مصلحته

266
00:18:51,260 --> 00:18:53,050
...سابو

267
00:18:54,410 --> 00:18:55,570
!لوفي

268
00:18:56,200 --> 00:18:58,790
...منظار

269
00:19:25,360 --> 00:19:30,390
يمكنني أن أعرف إن كانت ستُضرم
.نارٌ أم لا بنظرة النّاس في البلدة

270
00:19:34,040 --> 00:19:35,980
!مرحبًا، صباح الخير

271
00:19:35,980 --> 00:19:37,110
!صباح الخير

272
00:19:37,110 --> 00:19:39,200
.إنّه صباح جميل

273
00:19:39,200 --> 00:19:40,570
.بالفعل

274
00:19:40,570 --> 00:19:44,660
!ممتاز! لا يوجد أيّ خطب

275
00:19:44,660 --> 00:19:46,620
.سأسير حول البلدة

276
00:19:46,620 --> 00:19:51,850
ينبغي أن يكون صباح الغد أكثر جمالاً، أليس كذلك؟

277
00:19:51,850 --> 00:19:53,630
.أجل، يفترض ذلك

278
00:19:59,880 --> 00:20:03,180
.يبدو كلّ شيء طبيعيّ كما العادة

279
00:20:05,800 --> 00:20:08,010
.اليوم عاصف

280
00:20:08,010 --> 00:20:11,340
.أجل بالفعل يا صاحب الجلالة

281
00:20:11,340 --> 00:20:16,610
يمكن أن تقع الحوادث بسهولة
.في مثل هذا اليوم، لا سيّما الحرائق

282
00:20:16,610 --> 00:20:20,280
.معك حقّ يا صاحب الجلالة

283
00:20:20,720 --> 00:20:23,450
!سابو ليس في البيت؟

284
00:20:23,450 --> 00:20:25,560
!يا له من شقيّ فاسد

285
00:20:25,560 --> 00:20:29,720
!أما زال يريد لعب لعبة القراصنة دون أن يدرس؟

286
00:20:30,420 --> 00:20:32,250
!ابحثوا في البلدة بأكملها

287
00:20:32,660 --> 00:20:35,080
!لا يمكن أن يكون قد خرج من البلدة بسهولة

288
00:20:36,430 --> 00:20:38,170
.المعذرة يا سيّدي

289
00:20:38,170 --> 00:20:39,260
ماذا تريد؟

290
00:20:39,720 --> 00:20:43,570
هل تعرف أنّه ستضرم نار في غري ترمينال اللّيلة؟

291
00:20:43,570 --> 00:20:47,430
أعرف بالطّبع. وماذا في ذلك؟

292
00:20:48,060 --> 00:20:49,180
يعرف؟

293
00:20:49,510 --> 00:20:51,770
من أيّ عائلة تنحدر؟

294
00:20:52,270 --> 00:20:54,640
!إذًا فذلك صحيح

295
00:20:56,240 --> 00:20:57,680
!يا فتى

296
00:20:57,680 --> 00:21:00,910
ما الّذي يجري هنا؟ الجميع يعلمون؟

297
00:21:00,910 --> 00:21:03,740
!الجميع يعلمون بشأن ذلك ويتصرّفون بشكل طبيعيّ؟

298
00:21:03,740 --> 00:21:07,920
!ألا يكترث أيّ أحد للنّار في غري ترمينال؟

299
00:21:11,200 --> 00:21:14,410
.أنتما هنا إذًا أيّها الشّقيّان

300
00:21:14,410 --> 00:21:16,670
هل تريدنا أن نحمل الصّناديق؟

301
00:21:16,670 --> 00:21:20,080
.أجل، وستكون هناك مهمّة كبيرة لكما اللّيلة

302
00:21:20,080 --> 00:21:21,710
.سأخبركما لاحقًا

303
00:21:27,070 --> 00:21:29,670
.أبي يعلم أيضًا

304
00:21:29,670 --> 00:21:32,680
.لهذا أعادني قبل أن تنشب النّار

305
00:21:32,680 --> 00:21:35,200
لأنّه يريدني أن أحافظ على مكانتهم

306
00:21:35,200 --> 00:21:38,440
!وأرث ممتلكاتهم مع أنّه يعتبرني أحمقًا

307
00:21:41,870 --> 00:21:46,090
.آسف إن كان كلبي يزعجك

308
00:21:46,090 --> 00:21:48,780
أرى أنّك تلهث، فما بالك يا فتى؟

309
00:21:49,200 --> 00:21:50,760
.لا شيء

310
00:21:50,760 --> 00:21:52,830
.حقًّا؟ حسنًا

311
00:21:53,840 --> 00:21:59,130
هـ-هل تعلم أنّه ستضرم نار في غري ترمينال اللّيلة؟

312
00:21:59,130 --> 00:22:01,290
.أجل، أعلم

313
00:22:01,290 --> 00:22:06,490
لِمَ لا أحد في البلدة بمن فيهم أنت يبدو قلقًا؟

314
00:22:06,490 --> 00:22:08,550
لِمَ لا يحاول أيّ أحد منع ذلك؟

315
00:22:10,600 --> 00:22:15,140
.تبدو كصبيّ طيّب

316
00:22:15,140 --> 00:22:17,810
.لكن أصغ جيّدًا

317
00:22:18,120 --> 00:22:21,150
!علينا أن نتستّر على الخطّة جميعًا

318
00:22:21,150 --> 00:22:25,990
ماذا إن عرف أحد من خارج البلدة بشأنها؟

319
00:22:26,500 --> 00:22:30,450
...نحن استثناء! إن كنت تنحدر من عائلة نبيلة

320
00:22:31,820 --> 00:22:32,990
!أنت

321
00:22:34,240 --> 00:22:35,950
!إيس! لوفي

322
00:22:36,640 --> 00:22:39,960
!ثمّة خطب بهذه البلدة! الجميع مجانين

323
00:22:40,210 --> 00:22:42,270
،مع أنّهم يعلمون أنّ النّاس سيموتون قريبًا

324
00:22:42,270 --> 00:22:44,960
!إلاّ أنّهم يتصرّفون بشكل طبيعيّ وحتّى أنّهم يبتسمون

325
00:22:45,670 --> 00:22:50,130
!لا أريد البقاء هنا! عليّ أن أخبرهما بسرعة

326
00:22:52,100 --> 00:22:55,560
!الرّيح عاتية اليوم من بين كلّ الأيّام

327
00:22:55,560 --> 00:22:58,180
!ها هو! أليس هو؟

328
00:22:58,180 --> 00:23:00,700
!لا شكّ في ذلك! ذلك هو الصّبيّ الهارب

329
00:23:01,230 --> 00:23:02,900
!أنت، توقّف

330
00:23:03,450 --> 00:23:08,570
!أهالي هذه البلاد يخطّطون لإحراق عارهم الوطنيّ اللّيلة

331
00:23:09,430 --> 00:23:12,950
!عليكما الخروج من غري ترمينال يا إيس ولوفي

332
00:23:13,610 --> 00:23:16,990
!اهربا! إيس! لوفي

333
00:23:25,550 --> 00:23:28,470
،بعد أن عرفا بسرّ اندلاع الحريق

334
00:23:28,470 --> 00:23:31,320
.يقع لوفي وإيس في ضيق شديد على يد بلوجام

335
00:23:31,800 --> 00:23:35,510
،يهرع سابو إلى غري ترمينال لإنقاذهما

336
00:23:35,510 --> 00:23:40,770
!لكنّ النّيران الحارقة الشّديدة على وشك التهام لوفي وإيس

337
00:23:40,770 --> 00:23:42,230
:في الحلقة القادمة من وان بيس

338
00:23:42,230 --> 00:23:45,060
"!أُضرمت النّار! غري ترمينال في أزمة"

339
00:23:45,060 --> 00:23:47,430
!ملك القراصنة، لن يكون إلاّ أنا

340
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة