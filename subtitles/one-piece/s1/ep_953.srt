1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,690 --> 00:02:02,690
ذلك السّيف شوسوي الّذي كنت
!تحمله كان كنزًا سُرق من بلاد وانو

29
00:02:02,690 --> 00:02:07,070
!بدأت هذه المأساة برمّتها عندما أُخذ

30
00:02:07,070 --> 00:02:08,700
عن أيّ إله تتحدّث؟

31
00:02:08,700 --> 00:02:11,700
!كفاك ازدراءً

32
00:02:23,880 --> 00:02:26,590
!كفّا عن القتال

33
00:02:35,640 --> 00:02:41,360
ما الّذي يدفع ساموراي وراهب للقتال هكذا في البرّيّة؟

34
00:02:50,990 --> 00:02:53,580
...كاوا... ماتسو

35
00:02:54,160 --> 00:02:56,620
!كاواماتسو؟! أهذا أنت؟

36
00:03:04,420 --> 00:03:08,680
!اعتراف هيوري"
"!لمّ شمل على جسر قطّاع الطّرق

37
00:03:46,300 --> 00:03:47,840
!كا-كايدو-سان

38
00:04:13,320 --> 00:04:15,450
!توقّف رجاءً يا كايدو-سان

39
00:04:15,450 --> 00:04:17,450
!لا تستطيع الجزيرة تحمّل المزيد

40
00:04:18,620 --> 00:04:20,620
!اخرسوا! هذا يكفي

41
00:04:21,290 --> 00:04:22,250
!آسف

42
00:04:22,790 --> 00:04:24,000
!نلت منك

43
00:04:33,220 --> 00:04:35,560
!سيادة إيكوكو

44
00:04:37,430 --> 00:04:39,560
!باغوا الرّعد

45
00:05:00,290 --> 00:05:02,520
!متى ستنتهي تلك المعركة؟

46
00:05:02,520 --> 00:05:04,880
!علينا الهرب للبرّ الرّئيسيّ بالفعل

47
00:05:04,880 --> 00:05:06,920
!يا رجال

48
00:05:07,840 --> 00:05:11,480
كيف أمكنكم أيّها الحمقى أن تحتموا وزعيمكم يقاتل؟

49
00:05:11,480 --> 00:05:13,300
!جبناء ملاعين

50
00:05:13,300 --> 00:05:15,660
!كوين-ساما؟! متى وصلت إلى هنا؟

51
00:05:15,660 --> 00:05:17,140
!هربت أنت أيضًا؟

52
00:05:19,140 --> 00:05:22,140
...مـ-مستحيل

53
00:05:25,690 --> 00:05:28,230
على أيّ حال، هل من أخبار من أودون؟

54
00:05:28,230 --> 00:05:31,610
...لا... لا يمكننا الاتّصال بهم بالحلزون الذّكيّ

55
00:05:33,530 --> 00:05:36,930
حسنًا! سأذهب إلى هناك لأتحقّق
!إن كان كلّ شيء بخير

56
00:05:36,930 --> 00:05:40,140
!تريد مغادرة المكان فحسب يا كوين-ساما
!هذا ليس عدلاً

57
00:05:40,140 --> 00:05:42,350
!لا! سأذهب لأتحقّق فحسب

58
00:05:42,350 --> 00:05:46,690
...رنين، رنين، رنين... رنين، رنين، رنين

59
00:05:46,690 --> 00:05:47,840
!أعطني إيّاه

60
00:05:47,840 --> 00:05:48,500
!حاضر

61
00:05:48,500 --> 00:05:49,630
!فتح

62
00:05:51,170 --> 00:05:53,300
!مرحبًا، معكم كوين

63
00:05:54,090 --> 00:05:56,110
!كوين

64
00:05:56,110 --> 00:06:00,260
!معك المأمور بابانوكي من أودون

65
00:06:00,260 --> 00:06:03,660
.تمّت إعادة الاتّصالات بالحلزون الذّكيّ

66
00:06:03,660 --> 00:06:05,440
!نعم! للتّوّ

67
00:06:05,770 --> 00:06:11,500
.أحضرت الكثير من الرّجال إلى هنا
!إن كان لديكم نقص، بإمكاننا القدوم

68
00:06:11,500 --> 00:06:13,860
،إنّه يتصرّف بهدوء
!لكنّه يبحث عن عذر للهرب

69
00:06:13,860 --> 00:06:16,880
.كلاّ، ذلك ليس ضروريًّا في الوقت الحاليّ

70
00:06:16,880 --> 00:06:18,530
!رُفض عرضه

71
00:06:18,530 --> 00:06:21,300
قبّعة القشّ لوفي وكابتن كيد

72
00:06:21,300 --> 00:06:25,290
.وبقيّة الصّعاليك خلف القضبان جميعًا

73
00:06:25,290 --> 00:06:26,560
...فهمت

74
00:06:26,560 --> 00:06:28,980
.اتّصلت لأقول أنّ كلّ شيء بخير فحسب

75
00:06:28,980 --> 00:06:30,420
!أتمنّى لو لم يكن الوضع هكذا

76
00:06:30,420 --> 00:06:32,130
!كوين-ساما

77
00:06:38,010 --> 00:06:40,740
.هذا كلّ شيء لديّ

78
00:06:40,740 --> 00:06:42,140
.إغلاق

79
00:06:42,560 --> 00:06:45,850
!أكان ذلك جيّدًا يا سيّدتي؟

80
00:06:45,850 --> 00:06:48,730
!نعم! شكرًا لك

81
00:06:49,190 --> 00:06:50,380
!أبليت حسنًا

82
00:06:50,380 --> 00:06:52,190
!نعم

83
00:06:53,570 --> 00:06:59,320
!يا لها من شعوذة
!روّضت عدوّها بقطعة كيبي دانغو

84
00:07:00,120 --> 00:07:04,330
يبدو أنّها تنفع مع الحيوانات
!ومستعملي قدرات الحيوانات أيضًا

85
00:07:05,830 --> 00:07:07,750
!سُحقًا

86
00:07:10,960 --> 00:07:15,210
أوغاد! أتظنّون أنّ بإمكانكم
!الإفلات بفعلتكم هذه؟

87
00:07:15,760 --> 00:07:18,150
!سأنال منكم مهما كلّف الأمر

88
00:07:18,150 --> 00:07:20,930
.أرى أنّك جريء حتّى وأنت مقيّد

89
00:07:23,640 --> 00:07:26,390
!تاما! أطعميه الدّانغو خاصّتك

90
00:07:26,810 --> 00:07:28,540
!مثل الّتي أعطيت لحصونة

91
00:07:28,540 --> 00:07:29,850
!ماذا؟

92
00:07:30,190 --> 00:07:34,280
لكنّي لا أدري إن كان الأمر
...سينجح كما حدث حينها

93
00:07:34,280 --> 00:07:36,430
!جرّبيه فحسب

94
00:07:36,430 --> 00:07:38,660
!حا-حاضرة

95
00:07:38,660 --> 00:07:41,050
دانغو؟ عمّ تتحدّث؟

96
00:07:41,050 --> 00:07:42,640
!سترى عمّا قريب

97
00:07:42,640 --> 00:07:45,580
...إن كنت مصرًّا

98
00:07:47,210 --> 00:07:49,560
!كيبي دانغو

99
00:07:49,560 --> 00:07:52,630
!أخرجت دانغو من خدّها بالفعل

100
00:07:53,040 --> 00:07:56,380
...تفضّل! جـ-جرّبه، إنّه لذيذ

101
00:07:57,630 --> 00:08:00,640
!ماذا قلت يا شقيّة؟! ماذا تريدين؟

102
00:08:01,800 --> 00:08:03,260
!أنا خائفة

103
00:08:05,060 --> 00:08:06,270
.لا بأس

104
00:08:29,620 --> 00:08:34,590
!يا سيّدتي! لا تتردّدي في طلب أيّ شيء منّي

105
00:08:35,590 --> 00:08:37,340
!ما-ما هذا؟

106
00:08:37,760 --> 00:08:39,880
!أجل! لقد نجحت

107
00:08:45,720 --> 00:08:47,280
!حسنًا، صافحني

108
00:08:47,280 --> 00:08:48,580
!حاضر

109
00:08:48,580 --> 00:08:50,730
!جيّد، جيّد. أبليت حسنًا

110
00:08:55,150 --> 00:09:00,610
...إنّها قدرة أوتاما-تشان
!إن أحسنّا استعمالها، فستكون مفيدة

111
00:09:05,910 --> 00:09:07,800
!هذا ممتع

112
00:09:07,800 --> 00:09:10,620
!هذا من دواعي سروري يا سيّدتي

113
00:09:14,290 --> 00:09:16,500
!مرّ كلّ شيء على خير

114
00:09:17,630 --> 00:09:20,230
!بفضلك يا كاريبو

115
00:09:20,230 --> 00:09:22,590
!نعم، هذا صحيح

116
00:09:22,590 --> 00:09:25,470
!بفضلي

117
00:09:26,300 --> 00:09:30,860
،ابتلعت حلزونهم الزّعيم

118
00:09:30,860 --> 00:09:34,560
!وقطعت اتّصالاتهم

119
00:09:37,360 --> 00:09:43,320
ويظنّ الأعداء في الخارج الآن أنّ الآلاف
!منّا نحن السّجناء نقبع بصمت في زنزاناتنا

120
00:09:43,320 --> 00:09:49,540
!أنا واثق أنّهم سيُذهلون في يوم المعركة الكبيرة

121
00:09:52,790 --> 00:09:58,090
!لا تنسوا مساهمتي رجاءً

122
00:09:58,420 --> 00:10:00,440
!أنتم مدينون لي

123
00:10:00,440 --> 00:10:02,180
!أعلم ذلك

124
00:10:02,180 --> 00:10:06,430
!حسنًا! بإمكاننا الآن الاتّصال بكينييمون والبقيّة

125
00:10:12,430 --> 00:10:13,890
!تشوبّريمون-دونو

126
00:10:20,530 --> 00:10:25,760
سنردّ لك هذا الجميل وإن كلّفنا
!حياتنا مهما طال الزّمن

127
00:10:25,760 --> 00:10:29,500
لا داعي لذلك... لم تكن هزيمة
.ذلك الفيروس صعبة

128
00:10:29,500 --> 00:10:32,870
كما أنّ السّاموراي يميلون لمسألة
.ردّ الجميل بجدّيّة كبيرة، لذلك لا بأس

129
00:10:37,830 --> 00:10:40,040
!حـ-حسنًا، هذا جيّد

130
00:10:40,550 --> 00:10:42,170
...حتّى لوفيتارو قد شفي بالكامل

131
00:10:42,170 --> 00:10:44,840
!لنقم بهذا يا رجال

132
00:10:44,840 --> 00:10:46,570
!أجل

133
00:10:46,570 --> 00:10:48,740
!أنت الأفضل

134
00:10:46,570 --> 00:10:48,740
!لوفيتارو-سان

135
00:10:48,740 --> 00:10:49,470
!بإمكاننا النّجاح

136
00:10:49,470 --> 00:10:50,700
!سأتبعك

137
00:10:50,700 --> 00:10:53,430
!واستعاد صحّته وجاذبيّته

138
00:10:54,640 --> 00:10:58,520
اكتسب ثقة النّاس فقط لأنّ
!مومونوسكي-ساما أحضره إلى هنا

139
00:11:00,060 --> 00:11:01,690
!لا مجال للشّكّ

140
00:11:01,690 --> 00:11:04,150
...لم يتغيّر البتّة

141
00:11:04,150 --> 00:11:06,400
...لم نرك منذ مدّة

142
00:11:06,780 --> 00:11:08,700
!أيّها الزّعيم هيوغورو

143
00:11:15,410 --> 00:11:17,120
!هؤلاء هم

144
00:11:18,500 --> 00:11:20,790
!خطابات الدّم أوماسا

145
00:11:22,380 --> 00:11:24,840
!تسوناغورو مقسوم القبّعة

146
00:11:26,670 --> 00:11:28,680
!أوتشو القرَعة

147
00:11:30,390 --> 00:11:32,810
!عين الثّعبان ياتابّي

148
00:11:32,810 --> 00:11:36,790
!إنّهم زعماء من مختلف المناطق
!لم أعلم أنّهم كانوا هنا

149
00:11:36,790 --> 00:11:40,610
!لم أعتقد أنّني سأعيش لأخدمك ثانية

150
00:11:40,610 --> 00:11:43,940
!أنا جدّ سعيد لأنّكم بخير جميعًا

151
00:11:44,900 --> 00:11:46,670
!لسنا جديرين لنستحقّ لطفك

152
00:11:46,670 --> 00:11:50,620
!الأمر أشبه باستعمال المرحاض بعد أخذ حمّام

153
00:11:50,620 --> 00:11:52,220
!هذا صحيح

154
00:11:52,220 --> 00:11:54,370
.بكلّ تأكيد

155
00:11:56,040 --> 00:12:00,080
!إنّهم غرباء أطوار بالفعل
!تصرّفتَ بشموخ معهم أيضًا أيّها العجوز

156
00:12:01,830 --> 00:12:03,730
!العجوز"؟"

157
00:12:03,730 --> 00:12:04,460
!كلاّ

158
00:12:07,380 --> 00:12:08,300
!نزع الأظافر

159
00:12:08,300 --> 00:12:09,190
!تقطيع الأصابع

160
00:12:09,190 --> 00:12:10,430
!خلع الآذان

161
00:12:11,030 --> 00:12:13,200
!تحمّل العواقب أيّها المغفّل

162
00:12:13,200 --> 00:12:15,660
!كم علينا أن نقطع؟

163
00:12:15,660 --> 00:12:17,120
!يا زعيم، أصدر الأمر

164
00:12:17,120 --> 00:12:21,440
!توقّفوا! أنقذ ذلك الرّجل حياتي

165
00:12:27,990 --> 00:12:34,550
لن نضيّع أيّ وقت في جمع متمرّدين
.ما زالوا يختبئون في أرجاء البلاد

166
00:12:34,550 --> 00:12:36,740
!نعم. أعتمد عليكم

167
00:12:36,740 --> 00:12:37,450
!أجل

168
00:12:38,120 --> 00:12:41,540
...نجوت من الموت أيّها الشّابّ

169
00:12:41,540 --> 00:12:43,940
.كن حذرًا من الآن فصاعدًا

170
00:12:43,940 --> 00:12:46,090
!اخرسوا أيّها الأغبياء

171
00:12:46,630 --> 00:12:51,590
مذهل! إنّه جريء بالفعل لمواجهة
!زعماء المناطق ندًّا لندّ هكذا

172
00:12:51,590 --> 00:12:55,810
!سأتبعك لبقيّة حياتي يا لوفيتارو-سان

173
00:12:58,390 --> 00:13:03,600
!نعم، اتبعوني! سأنقذ هذه البلاد

174
00:13:27,340 --> 00:13:28,760
!يا إلهي

175
00:13:28,760 --> 00:13:33,970
توقّعت هذا! إذًا فالرّجل من كوري
...الّذي سرق المخطّطات

176
00:13:33,970 --> 00:13:35,780
!كان أنت

177
00:13:35,780 --> 00:13:40,600
!كنتُ أبحث عن هذه لمدّة
!مخطّطات قصر كايدو في أونيغاشيما

178
00:13:41,730 --> 00:13:45,900
صحيح، جعلت فرانوسكي-دونو
.يمرّ بصعاب كثيرة من أجلها

179
00:13:46,110 --> 00:13:49,940
لكن بإمكاننا الآن التّخطيط
!لما سنفعله في منطقة العدوّ

180
00:13:51,030 --> 00:13:53,300
!أنت الأفضل لا محالة

181
00:13:53,300 --> 00:13:55,970
هل كان انتباهك حادًّا هكذا في الماضي؟

182
00:13:55,970 --> 00:13:58,390
!كفّ عن قول ذلك يا إينو

183
00:13:58,390 --> 00:14:01,530
...رنين، رنين، رنين... رنين، رنين، رنين

184
00:14:01,530 --> 00:14:04,680
.رنين، رنين، رنين... فتح

185
00:14:04,680 --> 00:14:09,920
أهذا رايزو؟ كيف هي الأحوال؟
!أتمكّنت من إنقاذ لوفيتارو-دونو؟

186
00:14:10,250 --> 00:14:12,730
.بل الوضع أفضل من ذلك بكثير

187
00:14:12,730 --> 00:14:16,800
إنّها قصّة طويلة، لكنّنا جمعنا
...الكثير من المحاربين. حوالي

188
00:14:22,770 --> 00:14:26,330
!ثـ-ثلاثة آلاف وخمسمائة؟

189
00:14:26,330 --> 00:14:27,940
!هذا كثير جدًّا

190
00:14:27,940 --> 00:14:33,920
!إذًا فقد أنقذت لوفي-دونو
!ووجدت كاواماتسو أيضًا وحرّرته؟

191
00:14:33,920 --> 00:14:37,050
!كان هم من أمسكوا بكاواماتسو أيضًا؟

192
00:14:37,050 --> 00:14:40,200
!وفوق ذلك، غزوتم مخيّم التّنقيب؟

193
00:14:40,620 --> 00:14:44,000
!فعلتم ما هو أكثر من إنقاذ لوفي-كُن

194
00:14:44,750 --> 00:14:48,730
!لننطلق إلى أونيغاشيما

195
00:14:48,730 --> 00:14:50,340
!أجل

196
00:14:50,340 --> 00:14:53,510
!نتوقّع ارتفاع عدد المحاربين الّذين سينضمّون لنا

197
00:14:53,880 --> 00:14:57,970
!لكن ثمّة مشكلة عليكم معرفتها

198
00:14:58,430 --> 00:15:01,890
،ثمّة العديد من مصانع الأسلحة في بلاد وانو

199
00:15:01,890 --> 00:15:06,850
لكنّ كلّ منتجاتها تقريبًا عبارة
!عن آلات حرب بغرض التّصدير

200
00:15:06,850 --> 00:15:10,570
!يُفضّل السّاموراي استعمال السّيوف والرّماح أكثر

201
00:15:12,530 --> 00:15:18,700
حاليًّا، الحصول عليها أمر صعب
!بما أنّ أوروتشي حرّم حمل الأسلحة

202
00:15:18,700 --> 00:15:24,120
إن لم نمتلك أسلحة بما يكفي لجميع
!المتمرّدين، فلن تكون أمامنا أيّ فرصة

203
00:15:24,450 --> 00:15:26,660
.حسنًا. هذا مفهوم

204
00:15:26,660 --> 00:15:28,920
.هذه مسألة خطيرة بالفعل

205
00:15:29,750 --> 00:15:31,340
السّيوف؟

206
00:15:35,920 --> 00:15:38,930
،أحرزنا بعض التّقدّم أيضًا
!لكنّني سأبلغك به لاحقًا

207
00:15:39,590 --> 00:15:45,230
سأذهب إلى قرية أميغاسا
،لتقييم مدى استعدادنا للقتال

208
00:15:45,230 --> 00:15:47,230
!وسنكمل العمل من هناك

209
00:15:47,230 --> 00:15:51,170
!رايزو! بلّغني بتفاصيل مجموعتك لاحقًا

210
00:15:51,170 --> 00:15:52,610
!لك ذلك

211
00:15:52,610 --> 00:15:53,400
.إغلاق

212
00:15:59,530 --> 00:16:01,740
!حسنًا، لننطلق

213
00:16:20,550 --> 00:16:22,680
...أ-أنت

214
00:16:25,560 --> 00:16:27,480
...لا أصدّق هذا

215
00:16:27,810 --> 00:16:29,310
!أهذا أنت بالفعل؟

216
00:16:30,400 --> 00:16:31,400
!كاواماتسو

217
00:16:31,770 --> 00:16:32,810
ماذا؟

218
00:16:40,530 --> 00:16:41,410
...مستحيل

219
00:16:42,070 --> 00:16:45,200
...أيعقل... أنّك

220
00:16:49,410 --> 00:16:50,750
!كاواماتسو

221
00:17:10,230 --> 00:17:14,110
!لم أتخيّل قطّ أنّني سأراك ثانية في مكان كهذا

222
00:17:14,860 --> 00:17:21,070
أنا جدّ سعيد لأنّك حيّة ترزقين
!أكثر من أيّ شيء آخر

223
00:17:21,070 --> 00:17:22,990
!هيوري-ساما

224
00:17:24,620 --> 00:17:30,180
صحيح. سبق وقالت أنّ كابّا قام
...بتربيتها بعد موت والديها

225
00:17:30,180 --> 00:17:35,290
...أنا آسفة. خفت وهربت حينها

226
00:17:36,790 --> 00:17:41,550
لطالما أعطيتني أيّ طعام كنت
...تجده وإن كان مجرّد بقايا

227
00:17:48,260 --> 00:17:51,560
...ما زلت لا أستحقّ

228
00:17:56,020 --> 00:17:57,480
...كاواماتسو

229
00:17:58,360 --> 00:18:02,370
لم أستطع مواصلة مشاهدتك
.تنهار سنة بعد سنة

230
00:18:02,370 --> 00:18:04,820
كنت أعلم أنّ باستطاعتك النّجاة
...بسهولة بمفردك

231
00:18:05,240 --> 00:18:09,450
.فكّرت فيما قد أفعل إن متّ بسببي

232
00:18:23,930 --> 00:18:25,340
!يا صاحبة السّموّ

233
00:18:28,050 --> 00:18:29,680
...هذا

234
00:18:32,180 --> 00:18:34,190
!كاواماتسو، أنا آسفة

235
00:18:34,940 --> 00:18:38,400
!ستموت قريبًا إن لم أفعل شيئًا

236
00:18:41,110 --> 00:18:44,990
!خفتُ حينها... وهربت

237
00:18:47,990 --> 00:18:51,550
عزيزي كاواماتسو، شكرًا لك"
.على كلّ شيء

238
00:18:51,550 --> 00:18:54,580
".سأكون بخير. هيوري

239
00:18:54,910 --> 00:18:55,960
!ماذا؟

240
00:18:55,960 --> 00:18:58,580
!هـ-هيوري-ساما

241
00:19:05,260 --> 00:19:07,430
!هيوري-ساما

242
00:19:08,010 --> 00:19:11,810
!يا صاحبة السّموّ

243
00:19:14,310 --> 00:19:18,410
!اسمعي! غسلت شعري وحدي

244
00:19:18,410 --> 00:19:20,020
...أغلقت عينيّ هكذا

245
00:19:20,440 --> 00:19:21,900
...صاحبة السّموّ

246
00:19:23,280 --> 00:19:25,030
...ليست هنا

247
00:19:32,870 --> 00:19:34,540
!هيوري-ساما

248
00:19:44,010 --> 00:19:46,470
!هيوري-ساما! أين ذهبت؟

249
00:20:06,320 --> 00:20:08,820
...هيوري-ساما

250
00:20:19,000 --> 00:20:20,710
...هيوري-ساما

251
00:20:21,790 --> 00:20:27,010
يا صاحبة السّموّ... أين ذهبت؟

252
00:20:33,640 --> 00:20:35,180
...يا صاحبة السّموّ

253
00:20:35,720 --> 00:20:39,600
!هيوري-ساما

254
00:20:44,610 --> 00:20:48,440
...أنا آسفة... أنا جدّ آسفة

255
00:20:49,280 --> 00:20:54,290
!يا للطفك! هذا هو سبب هربك إذًا

256
00:20:54,290 --> 00:20:57,700
!اكتسبت الكثير من الوزن بفضلك

257
00:21:00,830 --> 00:21:03,250
...كا-كاواماتسو-ساما

258
00:21:17,810 --> 00:21:18,600
!من هناك؟

259
00:21:22,520 --> 00:21:24,870
!نحن هنا للانتقام يا غيوكيمارو

260
00:21:24,870 --> 00:21:30,110
كيف تجرؤ على سرقة أطنان من
!الأسلحة منّا! سنستعيدها جميعها

261
00:21:34,490 --> 00:21:38,370
أراهن أنّك أصبت بالشّلل! إنّها أسلحة
!قادرة على صيد حتّى الحيوانات البرّيّة

262
00:21:39,830 --> 00:21:41,790
!هيوري-ساما! اختبئي خلف الشّجرة

263
00:21:41,790 --> 00:21:43,040
!حاضرة

264
00:21:44,080 --> 00:21:46,250
!ماذا؟ أهؤلاء أعوانه؟

265
00:21:46,250 --> 00:21:48,340
!لا يهمّ! أردوهم قتلى جميعًا

266
00:21:50,590 --> 00:21:51,880
!موتوا

267
00:22:00,310 --> 00:22:01,350
!أسلوب الكابّا

268
00:22:01,350 --> 00:22:02,660
!أسلوب السّيفين

269
00:22:02,660 --> 00:22:04,190
!نهر القِصاص

270
00:22:04,190 --> 00:22:05,360
!التفاف وحيد القرن

271
00:22:17,990 --> 00:22:19,290
!كاواماتسو-ساما

272
00:22:22,250 --> 00:22:23,180
!كاواماتسو

273
00:22:23,180 --> 00:22:25,750
هل أنت بخير يا هيوري-ساما؟

274
00:22:28,090 --> 00:22:30,510
...كاواماتسو-ساما

275
00:22:33,840 --> 00:22:37,140
!مهلاً! هل تهرب ثانية؟

276
00:22:37,510 --> 00:22:40,470
!سُحقًا لك! أعد لي سيفي شوسوي

277
00:22:50,530 --> 00:22:52,200
!كاواماتسو-ساما

278
00:22:52,200 --> 00:22:53,750
!كم أنا مسرور

279
00:22:53,750 --> 00:22:55,660
!إنّه على قيد الحياة

280
00:23:04,210 --> 00:23:08,510
يحصل كاواماتسو على أسلحة للمحاربين
!الّذين جمعوهم بعد إخضاع أودون

281
00:23:08,510 --> 00:23:10,000
في نفس الأثناء، تخبر هيوري زورو

282
00:23:10,000 --> 00:23:16,600
عن السّيف الأسطوريّ الّذي استعمله
!كوزكي أودن، السّلاح الوحيد الّذي جرح كايدو

283
00:23:16,600 --> 00:23:22,370
يتدفّق الماضي والحاضر معًا
!لخلق إمكانات لقوّة جديدة

284
00:23:22,370 --> 00:23:26,310
:في الحلقة القادمة من وان بيس
"!اسمه إنما! سيف أودن العظيم"

285
00:23:26,310 --> 00:23:30,440
!ملك القراصنة، لن يكون إلاّ أنا