1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:01:53,180 --> 00:01:54,110
!أخي الكبير

26
00:02:01,820 --> 00:02:07,060
حتّى إن كانت إصابةً تقتُل
!النّاس العاديّين، لا يجب أن أموت

27
00:02:15,630 --> 00:02:16,930
!إعصار التنّين

28
00:02:24,110 --> 00:02:26,980
...عليّ أن أسرع وأُنقذ لوفي

29
00:02:31,150 --> 00:02:32,180
!يا له من غبيّ

30
00:02:34,450 --> 00:02:37,420
.آسفة، هذا كلّ ما نستطيع فعله الآن

31
00:02:41,390 --> 00:02:45,960
فهمت. ما يعني أنّني إن استطعتُ
...ركل وتحطيم تلك الصّخرة

32
00:02:50,900 --> 00:02:55,340
!فلتُدرك أنّكم مجرّد بشر

33
00:03:01,640 --> 00:03:05,850
!محاربون فخورون
معركتا سانجي وأوسوبّ الضاريتان

34
00:03:27,530 --> 00:03:32,170
...رجلٌ من قرية كوكوياشي
...إنّك تُهدر وقتك

35
00:03:32,170 --> 00:03:34,010
!سحقًا! وجدني

36
00:03:34,340 --> 00:03:38,110
!ما الغاية من تمديد حياته هكذا؟

37
00:03:38,110 --> 00:03:40,280
!سأُغرقك معه

38
00:03:43,450 --> 00:03:45,290
!وكأنّي سأدعك

39
00:03:45,890 --> 00:03:49,120
!أيّها البشريّ اللّعين

40
00:03:50,920 --> 00:03:53,230
!أصدقًا تحاول قتالي في الماء؟

41
00:03:53,860 --> 00:03:57,230
أنتم جنس وضيع عليهم
!أن يقلقوا بشأن كبح أنفاسهم

42
00:03:59,470 --> 00:04:01,570
.لك ذلك. سأقاتلك

43
00:04:01,570 --> 00:04:04,600
!كاراتيه البرمائيّين: حبل الشّعر المقاتِل

44
00:04:10,540 --> 00:04:12,110
...أيّها الـ

45
00:04:12,480 --> 00:04:16,450
.ما الخطب؟ تقلّصت قوّة ركلاتك إلى النّصف

46
00:04:16,650 --> 00:04:18,820
.تلك حدود البشر

47
00:04:18,820 --> 00:04:23,790
عكس قوّة كاراتيه البرمائيّين
!الّتي لا تضعف في الماء

48
00:04:24,290 --> 00:04:27,590
.بل بالأحرى، قد تتضاعف اعتمادًا على المهارة

49
00:04:30,800 --> 00:04:33,700
...كاراتيه البرمائيّين: مفجّر الأمعاء

50
00:04:34,370 --> 00:04:36,070
!الفوريّ تحت الماء

51
00:04:41,310 --> 00:04:42,670
:كاراتيه البرمائيّين

52
00:04:45,880 --> 00:04:48,380
!ركلة الفأس المشتعلة

53
00:04:54,450 --> 00:04:55,990
!الكعب كاسر الفكّ

54
00:04:59,890 --> 00:05:01,330
:الهجوم الخاصّ

55
00:05:03,260 --> 00:05:05,360
!قنبلة الفكّ المقهقة

56
00:05:12,000 --> 00:05:12,770
!أجل

57
00:05:33,090 --> 00:05:35,730
!هواء! هواء! هواء! أوكسجين! هواء

58
00:05:35,730 --> 00:05:38,790
!سرّبتُ الكثير من الهواء! لا أستطيع التنفّس

59
00:05:44,500 --> 00:05:45,840
إلى أين ذاهب؟

60
00:05:45,840 --> 00:05:49,740
.سحقًا! دعني أمرّ
!أحتاج إلى الهواء! دعني أتنفّس

61
00:05:50,640 --> 00:05:52,670
...صدقًا، يا لها من قوّة مذهلة

62
00:05:52,910 --> 00:05:54,510
.لا أصدّق أنّه بشريّ

63
00:05:55,180 --> 00:05:56,310
...دعني أتنفّس

64
00:06:15,160 --> 00:06:16,600
،إلّم تخنّي الذّاكرة

65
00:06:16,970 --> 00:06:21,100
.قلتَ أنّ من يؤذون آنسة حثالة

66
00:06:21,940 --> 00:06:23,600
.لكن انظر أين آل بك ذلك

67
00:06:23,600 --> 00:06:27,040
.هذه عاقبة شهامتك الرّخيصة

68
00:06:29,710 --> 00:06:32,980
.لن تستطيع الهروب منّي وستموت

69
00:06:32,980 --> 00:06:35,980
.كما سيموت ذلك الشّرطيّ وفتى المطّاط

70
00:06:35,980 --> 00:06:42,260
كما سيموت زورو وذو الأنف
.الطّويل والقرويّين المتمرّدين

71
00:06:42,260 --> 00:06:45,790
ونظرًا لكلّ ما حدث، لن تسلم
!نامي بخيانتها لنا أيضًا

72
00:06:48,530 --> 00:06:49,960
هل فهمت؟

73
00:06:50,830 --> 00:06:53,870
،بشهامتك السّطحيّة

74
00:06:54,070 --> 00:06:59,470
،لا تستطيع حماية أيّ أحد
!ما بالك نامي في النّهاية

75
00:07:07,250 --> 00:07:09,520
،حتّى إن كنتَ قويًّا نوعًا ما

76
00:07:10,080 --> 00:07:14,820
كان مجرّد كلامٍ سخيف نابعٍ
.من بشريّ عاجز

77
00:07:16,420 --> 00:07:21,030
أنتم البشر لا تستطيعون احتمال
تغيّر مفاجئ في ضغط الماء، صحيح؟

78
00:07:22,390 --> 00:07:26,530
بعبارة أخرى، إن غطستَ
...بسرعة إلى الهاوية

79
00:07:27,370 --> 00:07:30,170
.فستنفجر أعضاءك الدّاخلية

80
00:07:32,840 --> 00:07:34,170
!غوص الضّغط السّاحق

81
00:07:46,180 --> 00:07:48,490
!لن أدعه يفلت بهذا

82
00:07:48,850 --> 00:07:53,090
!لا أستطيع حماية أيّ أحد؟

83
00:08:06,800 --> 00:08:09,440
هل يأبى أن يموت؟

84
00:08:12,210 --> 00:08:15,810
!إذًا، سأمنحك ذلك الهجوم كما تشاء

85
00:08:16,410 --> 00:08:22,220
،إنّهم يتنفّسون برئتهم في اليابسة
.بينما يتنفّسون بخياشيمهم في الماء

86
00:08:24,890 --> 00:08:28,790
.ما يعني أنّه مجرّد سمكة ناطقة الآن

87
00:08:30,390 --> 00:08:32,300
أيمكنك أن تتحمّل مرّة أخرى؟

88
00:08:32,300 --> 00:08:36,600
ستموت السّمكة إن دخل
.الهواء من خياشيمها

89
00:08:37,030 --> 00:08:40,570
،إن كنتَ سمكة أيضًا
!ستشعر بنفس الألم

90
00:08:52,780 --> 00:08:54,280
...أنت

91
00:08:57,850 --> 00:08:58,690
...مهلًا

92
00:08:58,690 --> 00:09:01,420
.لا تقلق. إنّه بخير

93
00:09:01,420 --> 00:09:02,490
!حقًّا؟

94
00:09:02,490 --> 00:09:03,460
.أجل، نوعًا ما

95
00:09:03,460 --> 00:09:04,590
نوعًا ما؟

96
00:09:04,790 --> 00:09:06,600
.سأشرح لاحقًا

97
00:09:07,630 --> 00:09:11,830
على أيّ حال، اخرج من الماء أيّها
!السّمكة اللّعينة ودعنا نسوّي هذا

98
00:09:15,140 --> 00:09:17,440
ما زلت لم تفهم، أليس كذلك؟

99
00:09:17,810 --> 00:09:22,110
.لا يهمّ إن كنّا في الماء أو اليابسة

100
00:09:22,110 --> 00:09:24,350
!لقد استشطتُ غضبًا

101
00:09:24,580 --> 00:09:27,950
!سأجعلك تختبر جوهر كاراتيه البرمائيّين

102
00:09:28,980 --> 00:09:33,250
الهجوم الّذي استخدمته عليك
!لأعصف بك كان قبضة المائة قرميد

103
00:09:33,550 --> 00:09:37,630
لكنّ هجومي المطلق هو قبضة
!الألف قرميد

104
00:09:37,630 --> 00:09:43,660
!فرصة نجاتك على الأغلب... صفر

105
00:09:44,600 --> 00:09:45,800
!ركلة العنق

106
00:09:49,000 --> 00:09:51,410
أقلتَ أنّ شهامتي ساذجة؟

107
00:09:52,870 --> 00:09:54,510
!ركلة الكتف

108
00:09:55,510 --> 00:09:58,210
أقلتَ أنّني لا أستطيع حماية أيّ أحد؟

109
00:09:58,210 --> 00:10:01,750
!ركلة الضّلع! ركلة أسفل الظّهر
!ركلة الصّدر

110
00:10:02,420 --> 00:10:03,880
!ركلة السّاق

111
00:10:08,520 --> 00:10:10,660
...أيّها الـ

112
00:10:11,360 --> 00:10:15,960
!أيّها الحقير
!القبضة المطلقة: ألف قرميد

113
00:10:21,200 --> 00:10:23,070
!ضربة... الخروف

114
00:10:43,720 --> 00:10:45,260
...أظنّه

115
00:10:46,560 --> 00:10:47,960
لا يريد التّحلية؟

116
00:11:12,850 --> 00:11:15,320
!ما كان ذلك؟! ما الّذي يجري؟

117
00:11:36,870 --> 00:11:38,240
...كوروبي

118
00:11:41,110 --> 00:11:42,250
...هاتشي

119
00:11:43,480 --> 00:11:45,280
.إنّهما سمكتان صغيرتان في النّهاية

120
00:11:45,680 --> 00:11:49,220
ما زال من المبكّر عليهما بمليون
.وخمسون ألف سنة لمواجهة طبّاخ

121
00:11:50,220 --> 00:11:54,290
.فزنا بهذه اللّعبة

122
00:11:55,730 --> 00:12:02,570
كيف تجرؤون على هزيمة إخوتي
واحدًا تلو الآخر أيّها الأوغاد؟

123
00:12:03,000 --> 00:12:07,000
!ألم تتحمّسوا أكثر من اللاّزم؟

124
00:12:10,240 --> 00:12:14,680
أنت، ماذا قصدت بقولك
أنّ لوفي بخير نوعًا ما؟

125
00:12:14,680 --> 00:12:17,250
.عنيتُ أنّه لن يموت في الوقت الرّاهن

126
00:12:17,750 --> 00:12:22,180
،لكن لأجل إنعاشه
...عليّ أن أنزل إلى البحر ثانية

127
00:12:23,090 --> 00:12:26,990
مع أنّه لا يبدو أنّ ذلك الشّخص
...سيدعني

128
00:12:29,960 --> 00:12:32,530
!مذهلان... إنّهما مذهلان حقًّا

129
00:12:33,330 --> 00:12:36,100
!هزما اثنان من قادة قراصنة أرلونغ

130
00:12:41,170 --> 00:12:44,040
هذا حدّي. لم أعد أستطيع
!كبح أنفاسي أكثر

131
00:12:44,040 --> 00:12:46,610
.غين-سان، تولّ عنّي
.سأنزل إلى الماء هذه المرّة

132
00:12:46,840 --> 00:12:49,380
.تحسّن لون بشرته بشكلٍ كبير

133
00:12:49,640 --> 00:12:51,380
.بصق الكثير من الماء

134
00:12:51,380 --> 00:12:52,710
ما الّذي يجري هناك؟

135
00:12:52,710 --> 00:12:54,850
.لا تقلق. لا يزال الجميع أحياء

136
00:12:55,250 --> 00:12:56,250
...في الواقع

137
00:12:56,980 --> 00:12:58,750
،ومع أنّه يصعب تصديق هذا

138
00:12:58,750 --> 00:13:00,890
...هذا القتال يمدّني بالأمل

139
00:13:01,820 --> 00:13:04,660
...الأمل الّذي كنتُ أصدّه

140
00:13:17,040 --> 00:13:19,940
...تبًّا! تسبّب لي في الكثير من المتاعب

141
00:13:20,970 --> 00:13:23,510
!يا لها من قدرة مذهلة على الهروب

142
00:13:25,080 --> 00:13:29,480
لكنّ هذا كان سهلًا للغاية... مات فورًا
.بطلقةٍ من مسدّس البخاخ خاصّتي

143
00:13:29,850 --> 00:13:34,820
.أظنّني يجب أن أعود أدراجي
.لا بدّ أنّ البقيّة انتهوا الآن

144
00:13:54,540 --> 00:13:57,340
!نجوت! أفلح الأمر

145
00:13:57,340 --> 00:14:01,650
أنا مسرور حقًّا لأنّني جهّزتُ
.نجم الكتشب لمثل هذه الظّروف

146
00:14:01,650 --> 00:14:07,350
ظنّ أنّه أصابني بمسدّس البخّاخ
!خاصّته أو أيًّا كان. عُد أدراجك

147
00:14:09,190 --> 00:14:13,290
...لكن صدقًا، يا لهم من جنس مخيف

148
00:14:13,630 --> 00:14:17,760
قلبوا البيوت في البلدة
...رأسًا على عقب

149
00:14:19,060 --> 00:14:25,400
أشعر بالأسى على نامي
...وأريد مساعدتها حقًّا، لكن

150
00:14:29,840 --> 00:14:31,280
.أظنّها كانت مخيّلتي فحسب

151
00:14:32,180 --> 00:14:34,550
.أظنّني سأواصل ادّعاء الموت

152
00:14:35,710 --> 00:14:41,590
،لـ-لكن، مع أنّني مغطّى بدمٍ زائف

153
00:14:41,590 --> 00:14:43,850
.أريد شيئًا يُظهر أثر معركةٍ قاتلة

154
00:14:44,190 --> 00:14:49,260
وجدتها! إن ظهرتُ وجسدي مغطّى
.بالوحل، قد يفي ذلك بالغرض

155
00:14:49,260 --> 00:14:53,830
".وسأقول شيئًا مثل: "آسف. خسرت

156
00:14:54,970 --> 00:14:58,340
...أتساءل إن كان من الأفضل أن أقول

157
00:14:58,340 --> 00:15:02,140
آسف، تركت ذلك الوغد يهرب"
".مع أنّي كنتُ وشيكًا من هزيمته

158
00:15:02,140 --> 00:15:05,310
...أو قد لا يكون ذلك مقنعًا للغاية

159
00:15:05,940 --> 00:15:08,280
نحن أصدقاء الآن، ألسنا كذلك؟

160
00:15:08,680 --> 00:15:13,720
.لا تبكي يا نامي"
".فعلنا الصّواب فحسب

161
00:15:14,120 --> 00:15:16,920
.أفضّل الموت على الخسارة

162
00:15:17,190 --> 00:15:20,490
".جميعنا قاتلنا جيّدًا"

163
00:15:21,060 --> 00:15:25,730
لكنّه يظلّ أفضل بمائة مرّة
.من عصابةٍ لعينةٍ تؤذي آنسة

164
00:15:26,660 --> 00:15:30,070
".كانت معركةً قاتلة بالتّأكيد"

165
00:15:30,500 --> 00:15:34,270
!هذا لأجل عملي
!كان هذا خياري الوحيد

166
00:15:36,170 --> 00:15:40,640
".إصاباتي ليست بذلك السّوء"

167
00:15:40,880 --> 00:15:43,010
.كانت أختي الكبيرة نامي تبكي

168
00:15:43,010 --> 00:15:46,620
هل يحتاجون إلى سببٍ أكثر من ذلك
ليضعوا حياتهم على المحكّ؟

169
00:15:47,150 --> 00:15:51,320
.كانت نامي في العاشرة فحسب
هل تعلمان كم كان ذلك القرار مؤلمًا لها؟

170
00:15:53,560 --> 00:15:56,490
!فلنقاتل

171
00:16:01,030 --> 00:16:07,400
"...قاتلتُ... بطريقةٍ"

172
00:16:11,810 --> 00:16:12,710
...يا للـ

173
00:16:13,840 --> 00:16:15,680
!...يا للخزي

174
00:16:20,180 --> 00:16:24,420
!يا لخزيي

175
00:16:24,720 --> 00:16:27,520
!انتظر أيّها السّمكة اللّعينة

176
00:16:29,620 --> 00:16:33,160
ماذا؟ أما زلت حيًّا؟

177
00:16:35,160 --> 00:16:39,370
بالطّبع! يستحيل أن تصيبني طلقات
!مترنّحة من نصف سمكة مثلك

178
00:16:41,840 --> 00:16:45,640
،لحظة غادرتُ قريتي
...تخلّيتُ عن أمورٍ

179
00:16:45,870 --> 00:16:48,440
...مثل السّلام والأمان

180
00:16:49,340 --> 00:16:55,110
لأنّهم يعيشون مخاطرين بحياتهم
!كلّ يوم، يضحكون بسعادة كبيرة

181
00:16:57,550 --> 00:17:00,020
.لهذا قرّرتُ أن أُبحر

182
00:17:00,020 --> 00:17:02,190
!أردتُ أن أضحك من قلبي أيضًا

183
00:17:02,190 --> 00:17:04,360
،إلّم أقاتل بكلّ ما أوتيت من قوّة

184
00:17:04,360 --> 00:17:07,660
لن أملك الحقّ لأن أركب معهم
.في نفس السّفينة

185
00:17:08,190 --> 00:17:12,130
ولن أملك الحقّ لأن أضحك
!من قلبي معهم

186
00:17:23,180 --> 00:17:24,140
هل أنت غبيّ؟

187
00:17:25,110 --> 00:17:27,310
...استُحسن بك أن تدّعي الموت فحسب

188
00:17:28,080 --> 00:17:30,720
...حتّى دماغك وضيع

189
00:17:32,380 --> 00:17:36,750
...انتهيت

190
00:17:37,060 --> 00:17:40,560
!نعم، معك حق
!انتهت حياتك بالفعل

191
00:17:40,960 --> 00:17:42,290
!انتهيت

192
00:17:42,930 --> 00:17:44,300
!مطرقة أوسوبّ

193
00:17:46,030 --> 00:17:48,230
!رباط أوسوبّ المطّاطي الهالك

194
00:17:53,200 --> 00:17:56,010
!سحقًا

195
00:17:56,010 --> 00:17:59,180
!وقعتُ في فخّ تافه

196
00:17:59,610 --> 00:18:03,550
!...ذاك الحقير

197
00:18:05,950 --> 00:18:08,390
!الهجوم الخاصّ: النّجم الرّصاصيّ

198
00:18:06,620 --> 00:18:07,520
ساكي؟

199
00:18:11,390 --> 00:18:15,590
كيف تجرؤون على فعل كلّ هذه
!الأمور الوقحة أيّها الجنس الواهن

200
00:18:16,430 --> 00:18:21,230
أينما اختبأت، سأعصف بك فورًا
!بماء حقل الأرزّ هذا

201
00:18:24,600 --> 00:18:27,370
.وقحة أم لا... لا يهمّ

202
00:18:27,370 --> 00:18:32,180
،على أيّ حال، كرجل
.لا يمكنني أن أهرب من هذا القتال

203
00:18:32,980 --> 00:18:34,710
.نعم، سأموت إن خسرت

204
00:18:35,340 --> 00:18:37,610
!لكنّي قرصان بالفعل

205
00:18:37,610 --> 00:18:39,080
!المدفع البخّاخ

206
00:18:48,060 --> 00:18:51,260
!...يا لها من قوّة

207
00:18:51,860 --> 00:18:55,960
لِمَ عليّ أن أقاتل غبيًّا مثله؟

208
00:18:56,230 --> 00:18:58,730
!إنّه يفضح نفسه تمامًا

209
00:18:59,740 --> 00:19:01,440
!سأملأ جسدك بالثّقوب

210
00:19:01,440 --> 00:19:03,670
!المدفع البخّاخ الرشّاش

211
00:19:04,410 --> 00:19:07,610
!مصيبة! كيف عرف مكاني؟

212
00:19:07,610 --> 00:19:12,110
سحقًا! سحقًا! فقط راقبوني
!يا قراصنة أوسوبّ ويا كايا

213
00:19:12,110 --> 00:19:14,720
!أبحرتُ وصرتُ قرصانًا

214
00:19:15,150 --> 00:19:20,960
سأقاتل! لأجل أن أصبح محارب
!بحرٍ مغوار حقيقيّ، وليس كذبًا

215
00:19:20,960 --> 00:19:28,630
!اكتفيتُ من ادّعاء أنّني قرصان

216
00:19:29,830 --> 00:19:31,630
قلتَ اكتفيتَ ممّاذا؟

217
00:19:31,630 --> 00:19:34,340
هذا القتال! السّاكي قابل
!للاحتراق كما تعلم

218
00:19:34,800 --> 00:19:37,100
!الهجوم الخاصّ: نجم النّار

219
00:19:41,810 --> 00:19:45,650
!مؤلم! مؤلم! مؤلم! ماء! ماء
!ماء! ماء! ماء! ماء

220
00:19:45,650 --> 00:19:47,350
!مؤلم! مؤلم! مؤلم

221
00:19:46,980 --> 00:19:47,380
!هذا سيّئ

222
00:19:48,010 --> 00:19:49,980
!ماء! ماء! ماء! ماء

223
00:19:51,320 --> 00:19:54,820
!مطرقة أوسوبّ

224
00:20:16,010 --> 00:20:17,010
!...أيّها الحقير

225
00:20:17,910 --> 00:20:19,010
!مطرقة أوسوبّ

226
00:20:19,010 --> 00:20:22,010
!مطرقة أوسوبّ! مطرقة أوسوبّ

227
00:20:22,010 --> 00:20:25,420
!رباط أوسوبّ المطّاطيّ الهالك
!مطرقة أوسوبّ! مطرقة أوسوبّ

228
00:20:25,420 --> 00:20:27,690
!مطرقة أوسوبّ
!مطرقة أوسوبّ! مطرقة أوسوبّ

229
00:20:27,690 --> 00:20:30,460
!مطرقة أوسوبّ! مطرقة أوسوبّ

230
00:20:39,160 --> 00:20:42,070
!فُزت! هزمتُ برمائيًّا

231
00:20:48,170 --> 00:20:50,540
!هذا جزاءك

232
00:20:50,540 --> 00:20:53,380
!يمكنني أن أفوز أيضًا، إن حاولت

233
00:20:53,380 --> 00:20:55,550
!هل رأيتم؟

234
00:20:55,550 --> 00:20:59,150
!لا تسخروا منّي أيّها الأوغاد

235
00:21:10,290 --> 00:21:13,260
!رجاءً... عُد إلى وعيك

236
00:21:17,500 --> 00:21:20,570
!عُد إلى وعيك بسرعة
!وإلّا سيفوت الأوان

237
00:21:20,840 --> 00:21:24,510
!إنّ أصدقاءك... أصدقاءك

238
00:21:29,210 --> 00:21:35,490
ظننتُ أنّهما يملكان فرصة للفوز
بهذا القتال. أكان محض حلم؟

239
00:21:36,550 --> 00:21:38,860
ما الّذي فعله ذلك القرش اللّعين؟

240
00:21:38,860 --> 00:21:39,990
.لا أدري

241
00:21:40,620 --> 00:21:44,990
،فور أن رمى ماءً عليهما
...تقيّآ دمًا ورُميا في الهواء

242
00:21:46,460 --> 00:21:49,200
يمكنني أن أقتل بشرًا مثلكما

243
00:21:49,200 --> 00:21:54,400
دون حاجةٍ للمسهم حتّى
.إن كنتُ أملك بعض الماء

244
00:21:54,870 --> 00:21:56,940
هذا الاختلاف بيننا نحن البرمائيّون
.وبينكم أيّها البشر

245
00:21:56,940 --> 00:21:58,110
!لا تعبث معي

246
00:22:04,850 --> 00:22:07,150
...هذا ليس مضحكًا

247
00:22:07,150 --> 00:22:12,590
لعبة إطلاق المياه بالنّسبة له
...أشبه بطلقة بندقيّة بالنّسبة لنا

248
00:22:12,850 --> 00:22:15,120
...إذًا، هذه هي قوّة قرش

249
00:22:15,120 --> 00:22:18,360
...ويحتلّ مرتبةً فريدة بين البرمائيّين

250
00:22:21,430 --> 00:22:23,130
...إنّه في مستوى آخر تمامًا

251
00:22:23,500 --> 00:22:25,200
.موتا الآن

252
00:22:25,800 --> 00:22:30,440
.حياتكما ليست بتلك القيمة

253
00:22:30,440 --> 00:22:31,410
!أرلونغ

254
00:22:32,410 --> 00:22:33,710
!أختي الكبيرة نامي

255
00:22:34,010 --> 00:22:34,940
!نامي-سان

256
00:22:34,940 --> 00:22:36,410
...نا-تشان

257
00:22:36,880 --> 00:22:42,250
أهلًا يا نامي! وجدتني على
.وشك تحطيم بعض القراصنة

258
00:22:43,180 --> 00:22:45,120
لِمَ أتيت إلى هنا؟

259
00:22:50,460 --> 00:22:52,290
...أتيتُ لقتلك

260
00:22:57,000 --> 00:23:01,840
مشاعري الجيّاشة لا تتّصل

261
00:23:01,840 --> 00:23:06,670
بينما أشدّ على يدك بثبات

262
00:23:06,670 --> 00:23:11,580
،سأشدّ الشّراع بنفسي

263
00:23:11,580 --> 00:23:17,250
لذا واصل مشاهدتي
باهتمام بينما أبتعد

264
00:23:21,550 --> 00:23:26,760
كان يجول هذا في ذهني قليلًا
منذ هذا الصّباح

265
00:23:26,760 --> 00:23:31,360
لمَ الجوّ حار؟

266
00:23:31,360 --> 00:23:41,670
،بدءًا من تلك النّقطة
لم أستطع التّهرّب من ذلك

267
00:23:42,670 --> 00:23:47,680
أريد أن أمسك تلك المشاعر
،الّتي رحلت بسرعة

268
00:23:47,680 --> 00:23:52,520
حتّى أنّني مستعدّ لأباغت نفسي

269
00:23:52,520 --> 00:23:57,560
أريد أن أعانق أحلامي
الّتي قفزت من صدري

270
00:23:57,560 --> 00:24:02,660
معك، أستطيع الرّكض إلى هناك

271
00:24:11,170 --> 00:24:13,970
.سأُشغل ذاك الوغد نصف سمكة
!انزل إلى الماء

272
00:24:13,970 --> 00:24:15,840
!أجل! دع لوفي لي

273
00:24:15,840 --> 00:24:18,310
!حسنًا! سأدعمك من الخلف

274
00:24:18,310 --> 00:24:20,280
!أستدعمني من تلك المسافة؟

275
00:24:20,280 --> 00:24:23,280
..."إنّي أعاني من رُهاب "قتال أرلونغ

276
00:24:23,280 --> 00:24:24,320
هذا كذب، أليس كذلك؟

277
00:24:24,320 --> 00:24:26,650
!نجوت

278
00:24:26,650 --> 00:24:27,850
:في الحلقة القادمة من ون بيس

279
00:24:27,990 --> 00:24:30,990
!لوفي بأقصى قوّته
عزيمة نامي وقبّعة القّشّ

280
00:24:30,990 --> 00:24:33,060
!ملك القراصنة، لن يكون إلاّ أنا