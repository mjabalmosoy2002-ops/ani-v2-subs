1
00:00:28,040 --> 00:00:29,550
...إرادة موروثة

2
00:00:29,740 --> 00:00:32,090
...تعاقب الأزمنة... أحلام النّاس

3
00:00:32,580 --> 00:00:34,990
.لا رادع لهذه الأشياء

4
00:00:35,380 --> 00:00:38,480
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:38,480 --> 00:00:41,230
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:49,660 --> 00:00:56,030
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:56,030 --> 00:01:01,540
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:01:01,540 --> 00:01:07,540
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:01:07,540 --> 00:01:11,050
أشعر بـ"الجمال" في كلّ مكان

10
00:01:11,050 --> 00:01:14,350
أنا متمسّك بكم بشدّة بالفعل

11
00:01:14,350 --> 00:01:20,990
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:20,990 --> 00:01:24,290
إلى أن أحصل عليه بكلّ إثارة

13
00:01:24,290 --> 00:01:31,300
!آمنوا ببلاد العجائب

14
00:01:33,200 --> 00:01:39,410
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:39,410 --> 00:01:45,420
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:45,420 --> 00:01:48,520
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:48,520 --> 00:01:51,850
،بل أريدها حياة عاديّة لا غير

18
00:01:51,850 --> 00:01:55,090
فاركضوا نحو النّعيم بدل ذلك

19
00:01:55,290 --> 00:02:05,040
!آمنوا ببلاد العجائب

20
00:02:08,110 --> 00:02:13,480
مرّت ثلاث سنوات مذ أمطرت ولو
.قطرة واحدة على مملكة الواحات

21
00:02:13,940 --> 00:02:17,810
فحمل النّاس الأسلحة ساعين
.لأمل بعد الاضطراب

22
00:02:18,250 --> 00:02:22,750
يخيّم خوارٌ حزين على الأرض المحترقة

23
00:02:22,750 --> 00:02:23,790
.ومدّ هائل من القلق

24
00:02:25,760 --> 00:02:30,290
لإيقاف القتال، انطلق لوفي والبقيّة
نحو المدينة الخضراء إيرومالو

25
00:02:30,560 --> 00:02:34,430
،ثمّ اتّجهوا نحو واحة يوبا
.حيث يوجد جيش المتمرّدين

26
00:02:38,140 --> 00:02:42,510
.المحارب المتمرّد كوزا"
".الحلم الّذي أُقسم به لفيفي

27
00:03:22,450 --> 00:03:25,820
!توقّف عن هذا

28
00:03:26,120 --> 00:03:29,150
!انظر كم أضعتَ من الماء
!يا لك من مبذّر

29
00:03:29,150 --> 00:03:33,420
لِمَ كلّ هذا؟! أحضر إيس
!الكثير من الماء معه

30
00:03:33,420 --> 00:03:35,690
!هنالك حدود لكلّ شيء

31
00:03:35,690 --> 00:03:38,000
!كنت تشرب الكثير لوقت طويل

32
00:03:38,000 --> 00:03:39,600
.إنّه يحاول الشّرب أيضًا

33
00:03:39,600 --> 00:03:43,870
،هذا في حالة ما قالت نامي-سان
"!أنا عطشى للغاية"

34
00:03:43,870 --> 00:03:46,540
!فأستطيع أخذه لها في الحال

35
00:03:46,540 --> 00:03:50,010
!نامي-سان! فيفي-تشان
!أترغبان في بعض الماء؟

36
00:03:50,410 --> 00:03:52,610
!لا تكن سخيفًا! سأشربه أنا

37
00:03:52,610 --> 00:03:54,040
.لا نريد الآن

38
00:03:54,040 --> 00:03:56,680
!أعطني ذلك

39
00:03:56,680 --> 00:03:59,450
!سوف تبذّران الماء! توقّفا

40
00:03:59,450 --> 00:04:00,780
أتريد بعض الماء أيضًا؟

41
00:04:00,780 --> 00:04:03,250
.شكرًا. لكن يمكنني الانتظار

42
00:04:08,060 --> 00:04:11,230
يا فيفي. هلاّ أخبرتني المزيد
عن جيش المتمرّدين؟

43
00:04:12,000 --> 00:04:14,800
صحيح، على الأرجح أنّه عليّ
.إخباركم عنه مقدّمًا

44
00:04:16,930 --> 00:04:19,740
...حدث هذا قبل 11 سنة

45
00:04:21,870 --> 00:04:25,910
!فيفي! اكبُري وأصبحي أميرة ممتازة

46
00:04:58,910 --> 00:05:01,910
!قريتنا... لقد جفّت قريتنا

47
00:05:01,910 --> 00:05:04,350
!لماذا لم تساعدنا؟

48
00:05:04,920 --> 00:05:08,150
.لكنّ الجوّ في يد الرّب

49
00:05:08,150 --> 00:05:13,360
قد أكون ملكًا، لكنّني لا أستطيع
.التّحكّم بقوى الطّبيعة

50
00:05:14,260 --> 00:05:17,960
لكنّ أبي قال أنّ بمقدور
!الملك فعل أيّ شيء

51
00:05:18,330 --> 00:05:22,400
يمكنني فقط القيام بما
—في مقدرة البشر أن

52
00:05:22,400 --> 00:05:25,440
يا جلالة الملك! أتى والد
!هذا الفتى للقصر

53
00:05:25,670 --> 00:05:28,240
!إليك أشدّ اعتذاراتي يا جلالة الملك

54
00:05:28,240 --> 00:05:32,210
!سامح ابني المدلّل رجاءً
!سأتحمّل كامل المسؤوليّة

55
00:05:32,880 --> 00:05:37,180
!سأقبل أيّ عقاب
!لن يتكرّر هذا! أنا أتوسّل إليك

56
00:05:37,180 --> 00:05:39,750
!لا أصدّق كم أنت أحمق

57
00:05:39,750 --> 00:05:45,120
!أحمق! أحمق! أحمق

58
00:05:45,120 --> 00:05:48,330
أنت توتو، صحيح؟

59
00:05:48,330 --> 00:05:49,360
!نعم

60
00:05:49,790 --> 00:05:52,730
ستتكفّل المملكة بمعيشة

61
00:05:52,730 --> 00:05:55,330
.أولئك القرويّين الّذين تضرّروا من الجفاف

62
00:05:55,700 --> 00:06:00,800
،بإمكانك العيش هنا في ألوبارنا
!ووضع خطط لمستقبلكم

63
00:06:00,800 --> 00:06:06,480
!هذا كرم كبير منك
!شكرًا جزيلاً! شكرًا جزيلاً

64
00:06:07,540 --> 00:06:11,210
ما هذا؟! وكأنّك قد تفهم
!مشاعر القرويّين

65
00:06:11,780 --> 00:06:13,780
!انتظر يا كوزا! عد إلى هنا

66
00:06:16,420 --> 00:06:17,420
.يا توتو

67
00:06:17,750 --> 00:06:18,560
!نعم

68
00:06:19,790 --> 00:06:24,530
.إنّه فتى صالح
.لقد أتى ليوصل مشاعر القرويّين

69
00:06:24,960 --> 00:06:30,500
.اقتحم المكان من أجل صالح القرويّين

70
00:06:37,140 --> 00:06:38,680
.ماذا؟ طفل بكّاء

71
00:06:42,110 --> 00:06:43,880
ماذا قلت أيّها القصيرة؟

72
00:06:44,310 --> 00:06:45,220
قصيرة؟

73
00:06:49,450 --> 00:06:50,490
.كوبرا-ساما

74
00:06:50,990 --> 00:06:52,490
ما الأمر يا إيغارام؟

75
00:06:52,490 --> 00:06:58,360
مع كلّ احترامي، لا تملك المملكة
.ما يكفي لدعمهم جميعًا

76
00:06:58,360 --> 00:06:59,730
!أبله

77
00:06:59,730 --> 00:07:04,000
بإمكاننا التّقشّف في مصاريفنا
!أو أيًّا كان ما قد يتطلّبه الأمر

78
00:07:04,000 --> 00:07:06,770
.مفهوم. بأمرك

79
00:07:07,400 --> 00:07:10,570
!أمر فظيع يا جلالة الملك
!إنّه بشأن فيفي-ساما

80
00:07:15,680 --> 00:07:17,780
.خضتُ قتالاً وخسرت

81
00:07:17,780 --> 00:07:18,880
!فيفي

82
00:07:18,880 --> 00:07:20,120
!فيفي-ساما

83
00:07:20,350 --> 00:07:23,450
!ذلك الشّقيّ الصّغير
!كيف يجرؤ على أذيّة الأميرة؟

84
00:07:23,450 --> 00:07:24,690
!سوف أسحقه

85
00:07:24,690 --> 00:07:27,090
!مهلاً! مهلاً يا إيغارام

86
00:07:27,090 --> 00:07:29,760
!إليك أشدّ اعتذاراتي

87
00:07:30,560 --> 00:07:32,760
!سأموت للتّكفير عن هذا

88
00:07:32,760 --> 00:07:36,330
!كفا كلاكما

89
00:07:39,540 --> 00:07:43,170
!غبيّان! كان شجار أطفال لا غير

90
00:07:52,650 --> 00:07:54,950
!مرحبًا! تقدّموا

91
00:07:55,290 --> 00:07:57,690
!تقدّموا! لدينا أثمنة منخفضة

92
00:07:58,060 --> 00:08:00,520
!هذا لذيذ! تفضّل

93
00:08:01,830 --> 00:08:02,830
!إنّه شجار

94
00:08:03,230 --> 00:08:04,830
!تقدّموا

95
00:08:04,830 --> 00:08:05,730
!إنّه شجار

96
00:08:06,860 --> 00:08:08,900
!لا تتساهل معها فقط لأنّها أميرة

97
00:08:08,900 --> 00:08:11,600
!لقّن تلك الأميرة المدلّلة درسًا

98
00:08:11,900 --> 00:08:14,300
!حظًّا سعيدًا يا فيفي-تشان

99
00:08:14,300 --> 00:08:17,470
!أنتما! كوزا هو قائدنا

100
00:08:21,210 --> 00:08:24,850
!سأصبح قائدتكم إن فزتُ أنا

101
00:08:25,920 --> 00:08:28,190
!وكأنّني سأخسر أمام قصيرة مثلك

102
00:08:28,650 --> 00:08:31,390
!لطالما كنتُ القائد في القرية

103
00:08:33,160 --> 00:08:34,620
!هيّا بنا

104
00:08:50,710 --> 00:08:52,210
!اسمعوا يا رفاق

105
00:08:52,640 --> 00:08:56,680
بدءًا من اليوم، ستصبح فيفي
!نائبة القائد لجماعة الرّمل

106
00:08:56,680 --> 00:08:58,180
هل لدى أيّ أحد منكم اعتراض؟

107
00:08:58,180 --> 00:09:00,550
!لا

108
00:09:01,850 --> 00:09:03,350
.انظر يا إيغارام

109
00:09:04,150 --> 00:09:06,520
.أصبح لفيفي أصدقاء

110
00:09:07,160 --> 00:09:08,130
.نعم

111
00:09:08,130 --> 00:09:10,760
ذلك أفضل شيء يمكن أن تمتلكه

112
00:09:10,760 --> 00:09:14,900
إن كانت ستحمل مسؤوليّة
.أراباستا على عاتقها يومًا ما

113
00:09:23,640 --> 00:09:26,480
!عمّي توتو! عمّتي! صباح الخير

114
00:09:26,480 --> 00:09:27,510
أين القائد؟

115
00:09:27,510 --> 00:09:31,480
صباح الخير! إن كنتِ تبحثين
!عن كوزا، فقد غادر سلفًا

116
00:09:31,880 --> 00:09:33,820
.أفترض أنّه في المكان المعتاد

117
00:09:33,820 --> 00:09:35,290
!إلى اللّقاء

118
00:09:35,690 --> 00:09:38,760
!يا فيفي-تشان
!ماذا بشأن الغداء؟

119
00:09:38,760 --> 00:09:40,960
!سأتغدّى معكم! شكرًا لكما

120
00:09:41,960 --> 00:09:44,490
!يا لها من بلاد غريبة

121
00:09:44,490 --> 00:09:49,000
!أميرة مملكة تختلط مع عامّة مثلنا

122
00:09:49,000 --> 00:09:50,930
!هذا دليل على السّلام

123
00:09:52,000 --> 00:09:54,300
إيغارام-سان. هل ستنضمّ لنا على الغداء؟

124
00:09:54,300 --> 00:09:57,040
!لا، لا، لا بأس بهذا
!أحضرتُ معي كرات أرزّ

125
00:09:57,040 --> 00:09:58,440
!حسنًا، سأغادر

126
00:10:07,450 --> 00:10:09,820
!صاحب الجلالة! ماذا تفعل هنا؟

127
00:10:10,620 --> 00:10:12,420
!كلاّ! سيّدي

128
00:10:14,020 --> 00:10:16,360
!هل تتبعني ثانية؟

129
00:10:16,360 --> 00:10:21,330
...لـ-لكنّني قلق حيال فيفي-تشان

130
00:10:22,970 --> 00:10:26,200
عد للمنزل! ستسبّب المزيد
!من العمل فحسب

131
00:10:26,200 --> 00:10:27,470
!ماذا؟

132
00:10:27,870 --> 00:10:30,640
!ماذا تقصد بماذا؟

133
00:10:40,220 --> 00:10:41,750
.يبدو أنّها كانت بلادًا رائعة

134
00:10:41,750 --> 00:10:42,220
.نعم

135
00:10:42,650 --> 00:10:44,960
!أعطني ذلك الماء

136
00:10:44,960 --> 00:10:46,590
!في أحلامك

137
00:10:47,190 --> 00:10:49,730
...لكن حدثت أمور عدّة

138
00:11:01,540 --> 00:11:03,540
!مرحبًا يا صغيرة

139
00:11:03,540 --> 00:11:06,210
ذاهبة لمكان ما؟ أتريديننا أن نأتي معك؟

140
00:11:09,350 --> 00:11:11,480
!هاجموا يا جماعة الرّمل

141
00:11:13,850 --> 00:11:17,090
!ما قصّة هؤلاء الأطفال؟
!ألم نهتمّ بأمرهم بعد؟

142
00:11:17,820 --> 00:11:18,920
!أيّها القائد! رفاق

143
00:11:19,390 --> 00:11:22,590
!اهربي يا فيفي! إنّهما يسعيان خلفك

144
00:11:22,960 --> 00:11:24,830
!اهربي يا فيفي

145
00:11:24,830 --> 00:11:26,000
!سيقتلانكم

146
00:11:26,000 --> 00:11:27,900
!لكن... أيّها القائد

147
00:11:30,370 --> 00:11:32,070
!لن نقتلك

148
00:11:32,070 --> 00:11:36,140
،نريد مال فدية مقابلك
!لذلك سنختطفك فحسب

149
00:11:37,840 --> 00:11:38,810
!سُحقًا لك

150
00:11:39,810 --> 00:11:42,650
!تعالي إليّ أيّتها الأميرة فيفي

151
00:11:47,820 --> 00:11:49,350
!لن أسمح لكما بأخذها

152
00:11:49,350 --> 00:11:51,790
!احموها حتّى الموت يا جماعة الرّمل

153
00:12:13,710 --> 00:12:14,680
!ما هذا؟

154
00:12:15,910 --> 00:12:17,510
!ما هذا الشّيء؟

155
00:12:17,510 --> 00:12:19,820
!ماذا؟ ما هذا؟

156
00:12:20,120 --> 00:12:22,850
.وخز، وخز، وخز، وخز

157
00:12:30,430 --> 00:12:32,030
!إنّه ضخم

158
00:12:32,330 --> 00:12:35,000
!مذهل

159
00:12:46,540 --> 00:12:49,910
!أخبريني المزيد عمّا حدث

160
00:12:50,580 --> 00:12:54,850
حسنًا. كان قائدنا كوزا فتًى
...ذا قلب مشتعل

161
00:12:55,990 --> 00:13:00,120
...لكنّني كنتُ قلقة على ذلك القلب مرّة

162
00:13:01,390 --> 00:13:02,760
!لن أسمح لكما بأخذها

163
00:13:02,760 --> 00:13:04,830
!احموها حتّى الموت يا جماعة الرّمل

164
00:13:18,610 --> 00:13:20,340
!يا لم من حرّاس شخصيّين مثيرين للشّفقة

165
00:13:20,780 --> 00:13:22,010
!ثمّة المزيد منهم؟

166
00:13:24,350 --> 00:13:25,850
!هذا مؤلم

167
00:13:25,850 --> 00:13:26,880
!سُحقًا! لقد هربت

168
00:13:29,320 --> 00:13:31,690
!الأطلال في تلك الجهة! لنمسك بها

169
00:13:34,660 --> 00:13:35,960
!لا تدعوهم يذهبون

170
00:13:37,730 --> 00:13:38,800
!ابتعدوا

171
00:13:42,730 --> 00:13:44,470
!ما الّذي حدث؟

172
00:13:51,070 --> 00:13:55,380
!ما الّذي حدث لكم يا أطفال؟
!ما الّذي حدث هنا؟

173
00:13:56,450 --> 00:13:59,780
...أتى بعض الأشرار سعيًا خلف فيفي

174
00:13:59,780 --> 00:14:00,850
!ماذا؟

175
00:14:01,950 --> 00:14:04,150
...كانوا راشدين وبسيوف

176
00:14:04,150 --> 00:14:05,960
!ذهبوا للتّوّ إلى الأطلال

177
00:14:05,960 --> 00:14:07,820
!ذهب كوزا خلفهم أيضًا

178
00:14:08,260 --> 00:14:09,530
!ماذا؟

179
00:14:13,460 --> 00:14:19,240
أيّتها الأميرة! أين أنت يا أميرة؟

180
00:14:19,240 --> 00:14:21,510
إلى أين ذهبت؟

181
00:14:21,510 --> 00:14:24,140
!جداها! جداها! لا تدعاها تهرب

182
00:14:24,140 --> 00:14:27,840
!أيّتها الأميرة فيفي! تعالي

183
00:14:36,050 --> 00:14:38,090
!ها أنت هنا

184
00:14:39,560 --> 00:14:42,630
رجاءً كوني طفلة مهذّبة ودعينا
!نمسك بك فحسب

185
00:14:45,360 --> 00:14:46,430
!لا تكن عجولاً

186
00:14:48,470 --> 00:14:49,530
!القائد

187
00:14:51,170 --> 00:14:52,800
!هل أنت بخير يا فيفي؟

188
00:14:54,040 --> 00:14:56,270
...هذا مؤلم

189
00:14:56,270 --> 00:14:59,040
!لا تستخفّ بجماعة الرّمل أيّها الشّرّير

190
00:14:59,880 --> 00:15:01,880
!غادروا هذه المدينة حالاً

191
00:15:02,150 --> 00:15:06,550
.اسمع يا فتى. اخرس وسلّمني الأميرة

192
00:15:07,880 --> 00:15:11,050
.ليس من الحكمة إغضاب الكبار

193
00:15:11,050 --> 00:15:13,660
!سيف! لنهرب أيّها القائد

194
00:15:14,860 --> 00:15:17,160
!ذلك لا يخيفني

195
00:15:23,300 --> 00:15:25,800
!احموها حتّى الموت يا جماعة الرّمل

196
00:15:26,670 --> 00:15:28,740
!أيّها القائد! توقّف

197
00:15:29,010 --> 00:15:31,210
تريد قتالي إذًا؟

198
00:16:12,580 --> 00:16:13,250
!أيّها القائد

199
00:16:15,120 --> 00:16:18,190
!ذلك الوغد أطاح بزعيمنا

200
00:16:19,220 --> 00:16:22,460
!ما هذا؟! لنوسعه ضربًا

201
00:16:24,800 --> 00:16:26,760
!أنت! تعال

202
00:16:26,760 --> 00:16:28,400
!أنتما

203
00:16:30,400 --> 00:16:32,340
!أيّها المغفّلان

204
00:16:32,770 --> 00:16:34,810
!بابا! إيغارام

205
00:16:35,340 --> 00:16:36,810
!فيفي-ساما! هل أنت بخير؟

206
00:16:36,810 --> 00:16:40,780
اللّعنة عليكما! ظننتما أنّ بإمكانكما
!اختطاف ابنتي، صحيح؟

207
00:16:40,780 --> 00:16:45,450
!يا لكما من حثالة
!خذا! خذا! خذا

208
00:16:45,450 --> 00:16:47,380
!يبدو أنّ ثمّة المزيد منهم

209
00:16:48,550 --> 00:16:52,220
تشاكا! بيل! ماذا تفعلان هنا؟

210
00:16:52,920 --> 00:16:56,090
ماذا نفعل هنا؟
.هذا ما علينا نحن أن نسأله

211
00:16:56,090 --> 00:17:00,330
ما الّذي يفعله الملك في مكان
كهذا بعيدًا عن القصر؟

212
00:17:00,330 --> 00:17:02,800
.عليك الكفّ عن التّصرّف بتهوّر هكذا

213
00:17:04,670 --> 00:17:06,540
...إيغارام! إنّ كوزا

214
00:17:06,540 --> 00:17:09,440
!نعم! لنأخذه للطّبيب في الحال

215
00:17:09,440 --> 00:17:11,880
!أعضاء جماعة الرّمل على التّلّة أيضًا

216
00:17:11,880 --> 00:17:13,780
!تشاكا وبيل! قوما بالتّحضيرات في الحال

217
00:17:13,780 --> 00:17:14,140
!حاضر

218
00:17:15,610 --> 00:17:17,750
!يا لهم من أطفال شجعان

219
00:17:23,990 --> 00:17:28,090
ما الخطب يا فيفي؟ لماذا تبدين كئيبة؟

220
00:17:28,760 --> 00:17:31,500
...كنتُ خائفة جدًّا

221
00:17:32,660 --> 00:17:34,560
.نعم، كنتُ خائفًا أيضًا

222
00:17:35,200 --> 00:17:37,530
...كانوا يحملون سيوفًا أيضًا

223
00:17:38,370 --> 00:17:39,400
!كلاّ

224
00:17:40,840 --> 00:17:45,610
أخبرتَهم أن يحموني حتّى
...الموت أيّها القائد

225
00:17:45,980 --> 00:17:48,580
!احموها حتّى الموت يا جماعة الرّمل

226
00:17:53,050 --> 00:17:56,620
...لا تتحدّث عن الموت أيّها القائد

227
00:17:58,960 --> 00:18:03,230
كانت خائفة من فقدان أصدقائها
...أكثر من أيّ شيء آخر

228
00:18:13,670 --> 00:18:17,410
،ما زالت فيفي صغيرة
.لكنّها الأميرة يا كوزا

229
00:18:17,870 --> 00:18:21,080
.كان ما قمتَ به اليوم عملاً مذهلاً

230
00:18:21,410 --> 00:18:23,810
.لك كلّ امتناني. شكرًا لك

231
00:18:25,050 --> 00:18:28,250
.فيفي صديقتي. كان ذلك طبيعيًّا

232
00:18:29,020 --> 00:18:30,220
.فهمت

233
00:18:30,220 --> 00:18:34,420
واضح لي أنّ الجيل التّالي من أراباستا
.سيكون بين أيدٍ أمينة

234
00:18:34,830 --> 00:18:36,430
هل تحبّ هذه البلاد؟

235
00:18:36,430 --> 00:18:38,860
!نعم! لقد وُلدتُ فيها

236
00:18:39,230 --> 00:18:41,030
!وأنا أيضًا

237
00:18:43,100 --> 00:18:44,100
...أنا

238
00:18:45,270 --> 00:18:47,070
...ما-ما-ما

239
00:18:47,500 --> 00:18:50,110
.أنا قلق بعض الشّيء

240
00:18:50,110 --> 00:18:51,140
لماذا؟

241
00:18:52,440 --> 00:18:57,750
يتطلّب حكم الآخرين اتّخاذ
.قرارات صعبة في وقت قصير

242
00:18:57,750 --> 00:19:01,180
.فيفي-ساما طيّبة أكثر من اللاّزم على ذلك

243
00:19:01,520 --> 00:19:03,290
.إيغارام

244
00:19:03,290 --> 00:19:03,950
نعم؟

245
00:19:05,320 --> 00:19:09,330
.لا بأس. لا بأس بأراباستا كما هي الآن

246
00:19:14,930 --> 00:19:18,870
،اسمح لي أن أرافقك
!طالما حييت

247
00:19:21,100 --> 00:19:22,210
يوبا؟

248
00:19:22,510 --> 00:19:26,680
!نعم! تحدّث والدك مع أبي بشأنها

249
00:19:26,680 --> 00:19:28,550
مع العمّ توتو؟

250
00:19:28,550 --> 00:19:33,520
سأله إن كان يريد بناء بلدة
!جديدة في واحة يوبا الخالية

251
00:19:35,820 --> 00:19:39,590
،تلك المنطقة أشبه بملتقى طرق لأراباستا

252
00:19:39,590 --> 00:19:41,930
حيث كلّ الرّحّالة والتّجّار
!يعبرون منها أثناء ترحالهم

253
00:19:43,160 --> 00:19:45,630
!انتظري فقط حتّى تُبنى بلدة فيها

254
00:19:46,030 --> 00:19:48,970
!سيكون الكثير من المواطنين سعداء

255
00:19:52,270 --> 00:19:53,400
!هذا رائع، صحيح؟

256
00:19:54,240 --> 00:19:57,740
!ولقد طُلب من أبي أن يكون ممثّلها

257
00:19:58,110 --> 00:19:59,510
هل ستذهب أيضًا أيّها القائد؟

258
00:19:59,510 --> 00:20:00,610
!بالطّبع

259
00:20:01,010 --> 00:20:03,380
...قال أبي أن البقاء هنا

260
00:20:03,910 --> 00:20:07,780
،وبناء مدينة جديدة ليس أمرًا سهلاً

261
00:20:07,780 --> 00:20:08,950
!لكنّني سأنجح في ذلك

262
00:20:08,950 --> 00:20:11,360
!سأبني مدينة جديدة بيديّ هاتين

263
00:20:12,020 --> 00:20:14,690
!تحتاج هذه البلاد مدينة مثل يوبا

264
00:20:25,940 --> 00:20:27,940
.نعتمد عليك يا توتو

265
00:20:27,940 --> 00:20:32,410
!نعم يا صاحب الجلالة
!سنبني مدينة مذهلة

266
00:20:32,940 --> 00:20:35,880
.وداعًا يا فيفي-تشان
.لن نرى بعضنا لمدّة طويلة

267
00:20:35,880 --> 00:20:39,580
!تعالي لزيارتنا عندما تكتمل المدينة

268
00:20:40,020 --> 00:20:41,920
!أكيد أيّها العمّ توتو

269
00:20:42,520 --> 00:20:44,190
سنبني مدينة مذهلة

270
00:20:44,190 --> 00:20:46,690
!وستجعل هذه المملكة تزدهر أكثر

271
00:20:46,690 --> 00:20:48,660
!حان وقت المغادرة

272
00:20:48,930 --> 00:20:53,160
!إلى اللّقاء يا فيفي
!اكبُري وأصبحي أميرة ممتازة

273
00:20:54,430 --> 00:20:55,200
!نعم

274
00:20:57,730 --> 00:21:00,270
!كوزا! لا تتصرّف بتعجرف هكذا

275
00:21:00,270 --> 00:21:01,070
!هذا مؤلم

276
00:21:02,770 --> 00:21:04,880
.كوزا محقّ

277
00:21:05,880 --> 00:21:09,050
.ستجعل يوبا هذه البلاد تزدهر أكثر

278
00:21:12,480 --> 00:21:16,490
فهمت. صديقك كوزا هذا
.كان فتى لطيفًا جدًّا

279
00:21:17,090 --> 00:21:19,460
لكن هل لذلك علاقة بجيش المتمرّدين؟

280
00:21:19,460 --> 00:21:21,430
.نعم. له علاقة

281
00:21:26,630 --> 00:21:29,200
...واسم قائد جيش المتمرّدين هو

282
00:21:29,200 --> 00:21:30,000
.كوزا

283
00:21:30,530 --> 00:21:31,500
!—لا يُعقل

284
00:21:33,500 --> 00:21:35,240
.إنّه الفتى الّذي أخبرتك عنه

285
00:21:37,540 --> 00:21:41,180
نامي-سان! أتودين بعضه
!أيضًا يا نامي-سان؟

286
00:21:42,950 --> 00:21:45,820
!قريدس الصّحراء هذا لذيذ

287
00:21:45,820 --> 00:21:48,150
!إنّه ليس قريدسًا، بل عقربًا

288
00:21:49,590 --> 00:21:51,390
!لا-لا يمكنني أكل المزيد

289
00:21:53,120 --> 00:21:55,630
!هذا يكفي يا هؤلاء

290
00:21:55,630 --> 00:21:57,090
!لنذهب يا رموش

291
00:22:00,000 --> 00:22:02,070
لماذا هي غاضبة؟

292
00:22:02,500 --> 00:22:04,630
.لا أدري

293
00:22:15,110 --> 00:22:20,950
كالمغامرات الّتي حلمت
بها حين كنت طفلاً

294
00:22:20,950 --> 00:22:26,020
أستمر بالمضي قدمًا
نحو نهايات العواطف

295
00:22:26,020 --> 00:22:38,640
أجمع يديّ، والرّمال والوقت
اللّذان يتسرّبان منهما

296
00:22:38,640 --> 00:22:45,640
يثبتان لي أنّ هذا هو ما ولدت لأفعله

297
00:22:45,640 --> 00:22:56,650
لنواصل السّباحة بسرعة
قريبة من الانهيار

298
00:22:57,750 --> 00:23:08,500
إلى أن نُجرف يومًا
ما إلى شاطئ برمل أبيض

299
00:23:08,500 --> 00:23:11,440
لا يعرفه أحد

300
00:23:25,250 --> 00:23:27,720
لا يبدو إيس كمجرم خطير، صحيح؟

301
00:23:27,720 --> 00:23:31,720
ومع ذلك، يخشى القراصنة من العالم
."بأكمله من اسم "قبضة النّار إيس

302
00:23:31,720 --> 00:23:34,690
أي نوع من القراصنة يكون اللّحية
السّوداء الّذي يسعى خلفه؟

303
00:23:34,690 --> 00:23:37,190
.سمعت أنّ هنالك من هزم اللّحية السّوداء

304
00:23:37,190 --> 00:23:39,100
.نعم، صائد مكافآت يُدعى سكوربيون

305
00:23:39,100 --> 00:23:41,230
!ثمّة شخص بهذه الرّوعة؟

306
00:23:41,230 --> 00:23:42,670
:في الحلقة القادمة من ون بيس

307
00:23:42,670 --> 00:23:45,670
!مواجهة في ضباب الرّمضاء"
".إيس ضدّ سكوربيون المِقدام

308
00:23:46,070 --> 00:23:48,370
!ملك القراصنة، لن يكون إلاّ أنا