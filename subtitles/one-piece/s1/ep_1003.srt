1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,060 --> 00:02:02,940
.يسرع لوفي نحو السّطح ساعيًا لقتال كايدو

29
00:02:03,820 --> 00:02:05,860
!فرانكي! جينبي

30
00:02:06,280 --> 00:02:09,740
يقولون أنّ مقاتلي السّاقة هم الأبطال
!الحقيقيّون في ساحة المعركة

31
00:02:10,160 --> 00:02:13,160
!أسرع إلى القلعة يا لوفي

32
00:02:13,330 --> 00:02:15,830
!حسنًا! سأترك أمرهم لكم

33
00:02:21,130 --> 00:02:23,750
!سانجي! لنذهب إلى داخل القلعة

34
00:02:23,760 --> 00:02:24,840
!أجل

35
00:02:25,130 --> 00:02:31,010
وعلى السّطح، تتواصل المعركة بين
.قبيلة المينك وجاك أمام كايدو

36
00:02:45,780 --> 00:02:51,200
دخل كلّ من إينواراشي ونيكوماموشي أخيرًا
.وضع السّولونغ أيضًا لإيقاف هيجان جاك

37
00:03:07,800 --> 00:03:13,140
بينما يطلق كوين نسخة جديدة من
!طلقات الطّاعون نحو زورو ودريك

38
00:03:20,780 --> 00:03:22,020
...لا يعقل

39
00:03:22,570 --> 00:03:24,150
...هذه الرّصاصة

40
00:03:36,290 --> 00:03:40,630
"!نصل بطوليّ! الأكازايا ضدّ كايدو مرّة أخرى"

41
00:03:50,970 --> 00:03:54,800
!أنا الأفضل

42
00:04:05,860 --> 00:04:07,690
!هيّا! تماسك

43
00:04:11,240 --> 00:04:12,490
...لا

44
00:04:12,790 --> 00:04:17,450
...لا... وصلتُ إلى هذا الحدّ أخيرًا

45
00:04:17,450 --> 00:04:20,420
!لا أريد الموت هنا

46
00:04:20,420 --> 00:04:22,040
...النّجدة

47
00:04:22,040 --> 00:04:23,910
!النّجدة

48
00:04:25,010 --> 00:04:26,580
ما الّذي يحدث؟

49
00:04:27,220 --> 00:04:28,920
...يبدون مثل

50
00:04:28,920 --> 00:04:30,960
!غيلان

51
00:04:33,770 --> 00:04:35,930
...استعمل أخيرًا

52
00:04:38,440 --> 00:04:40,390
!طلقات الطّاعون

53
00:04:41,600 --> 00:04:42,730
!سُحقًا

54
00:04:46,020 --> 00:04:47,480
!أنت، اسمع

55
00:04:47,480 --> 00:04:51,400
!ما الغاية من كلّ هذا؟! ماذا في هذه الرّصاصات؟

56
00:04:53,910 --> 00:04:58,780
،تعرّض لإحداها إن كنت فضوليًّا هكذا
!ستعرف الإجابة بمجرّد حدوث ذلك

57
00:05:17,310 --> 00:05:19,390
!اهرب في الحال

58
00:05:30,990 --> 00:05:34,660
!بنيّ العزيز! مومونوسكي

59
00:05:35,330 --> 00:05:37,830
!إنّه هنا

60
00:05:37,830 --> 00:05:40,450
!أنا كوزكي أودن

61
00:05:40,670 --> 00:05:43,330
!استمع لوالدك

62
00:05:44,090 --> 00:05:45,400
...شينوبو

63
00:05:45,400 --> 00:05:50,000
يبدو يائسًا... لماذا لا نستمع لما
لديه ليقوله فحسب؟

64
00:05:50,000 --> 00:05:53,720
...قال لوفي أنّه حليف لنا

65
00:05:53,720 --> 00:05:57,200
!مومونوسكي-ساما، نحن في معقل العدوّ

66
00:05:57,200 --> 00:06:01,510
!لا يجدر بنا أن نثق بشخص يدّعي أنّه أودن-ساما

67
00:06:01,770 --> 00:06:03,680
!أنا أودن

68
00:06:03,680 --> 00:06:06,400
!أريد حمايتك

69
00:06:09,280 --> 00:06:10,980
...والدي

70
00:06:10,980 --> 00:06:13,110
...ألا يمكننا الاستماع له فحسب

71
00:06:13,110 --> 00:06:15,110
!مومونوسكي-ساما! لا تدع ذلك يخدعك

72
00:06:15,490 --> 00:06:17,650
!لا يعقل أن يكون أودن-ساما

73
00:06:18,080 --> 00:06:20,080
!أنا أودن

74
00:06:20,080 --> 00:06:22,780
!لا يعقل أن تكون أودن-ساما

75
00:06:26,590 --> 00:06:28,750
...لكنّي

76
00:06:28,750 --> 00:06:31,710
!أريد الحديث مع والدي ثانية

77
00:07:21,220 --> 00:07:24,390
!خذ هذه! سأقدّم كلّ ما لديّ

78
00:07:42,830 --> 00:07:45,660
.تطلّب الأمر كلّ ما في جعبتي للإطاحة به

79
00:07:46,040 --> 00:07:49,950
.كان قويًّا جدًّا

80
00:07:55,630 --> 00:07:56,790
!أرني ما لديك

81
00:07:57,390 --> 00:08:01,130
!سأقطّعك بكلّ ما أوتيت من قوّة

82
00:08:03,800 --> 00:08:08,430
...يا أحد النّجوم الكبار من قراصنة مملكة الحيوان

83
00:08:08,810 --> 00:08:11,060
!جاك الجفاف

84
00:08:19,700 --> 00:08:22,470
...كلّ كراهية ومرارة الماضي

85
00:08:22,470 --> 00:08:26,700
...لنبتّ في ذلك الآن وللأبد

86
00:08:26,830 --> 00:08:28,450
!جاك

87
00:08:28,830 --> 00:08:30,370
!أيّها الدّوق-ساما

88
00:08:30,670 --> 00:08:34,830
!عليك تركنا نسوّي الحساب معه-نيا

89
00:08:40,800 --> 00:08:44,680
...إنّه-غارا كارثة حقيقيّة

90
00:08:45,180 --> 00:08:48,890
!نحن المينك لن ننسى أبدًا

91
00:08:48,890 --> 00:08:55,500
تلك الرّؤية المليئة بالغاز السّامّ
!محفورة في ذكريات كلّ المينك

92
00:08:55,500 --> 00:08:59,650
لا تدري كم من الأشخاص توجّعوا
!ألمًا وأفسحوا المجال ليغمرهم اليأس

93
00:09:01,950 --> 00:09:04,800
،مذ أن أرأيتك-غارا قبل قليل

94
00:09:04,800 --> 00:09:11,370
!وذراعي اليسرى المبتورة توخزني

95
00:09:11,370 --> 00:09:15,580
...وهذه السّاق الّتي بترتَها-غارا

96
00:09:15,840 --> 00:09:18,670
...توّاقة

97
00:09:19,300 --> 00:09:22,050
!لتقطيعك أيضًا

98
00:09:30,560 --> 00:09:32,850
...أيّها المينك اللّعناء

99
00:09:33,520 --> 00:09:37,560
!ستُدمّرون بالكامل هذه المرّة

100
00:10:04,720 --> 00:10:09,380
!لا تسمحوا بصعود أيّ أحد
!لا تدعوهم يعترضون طريق لوفي والبقيّة

101
00:10:09,770 --> 00:10:11,970
!أوقفوهم هنا جميعًا

102
00:10:23,780 --> 00:10:28,010
،واندا! لا يهمّ كم نقطع منهم
!إلاّ أنّهم يواصلون التّوافد

103
00:10:28,010 --> 00:10:29,740
!سنتعب أنفسنا هكذا

104
00:10:29,740 --> 00:10:32,700
!لا تتوقّفوا! تابعوا

105
00:10:35,870 --> 00:10:38,160
!لنواصل الرّكض هكذا

106
00:10:45,680 --> 00:10:46,670
!كاروت

107
00:10:47,260 --> 00:10:48,800
!سأقاتل أيضًا

108
00:10:56,270 --> 00:10:58,100
!كاروت، شكرًا لك

109
00:10:58,230 --> 00:11:00,770
!أنا معكم! لنضع حدًّا لهم

110
00:11:01,070 --> 00:11:02,520
.لعق

111
00:11:03,200 --> 00:11:04,860
ما الخطب؟

112
00:11:05,740 --> 00:11:08,740
.أنا آسفة يا واندا. عليّ الذّهاب

113
00:11:12,330 --> 00:11:13,370
!كاروت؟

114
00:11:13,870 --> 00:11:15,910
!أحتاج للتّحقّق من أمر ما

115
00:11:34,930 --> 00:11:39,140
...رُميت كلّ هذه المسافة خارجًا

116
00:11:39,650 --> 00:11:42,520
...أخذوني على حين غرّة

117
00:11:43,570 --> 00:11:47,320
!جينبي اللّعين

118
00:11:50,950 --> 00:11:52,280
!ماما

119
00:11:52,580 --> 00:11:55,080
!هذا أنت يا بيروسبيرو

120
00:11:55,080 --> 00:11:58,420
!ممتاز يا ماما! أحتاج للحديث معك

121
00:11:58,500 --> 00:12:02,590
.حسنًا، أتيت في الوقت المناسب

122
00:12:02,590 --> 00:12:04,580
لماذا لا تساعدني؟

123
00:12:07,590 --> 00:12:10,930
.لم أتوقّع رؤيتك هنا يا ماركو

124
00:12:13,180 --> 00:12:15,350
ما الّذي أتى بك إلى هنا؟

125
00:12:15,350 --> 00:12:19,800
.سمعت أنّ طاقم اللّحية البيضاء تداعى سلفًا

126
00:12:19,800 --> 00:12:24,060
...حسنًا، لديّ نفس هدف ابنك

127
00:12:25,150 --> 00:12:27,270
.القضاء على الغيلان-يوي

128
00:12:28,990 --> 00:12:30,740
!هذا صحيح يا ماما

129
00:12:30,740 --> 00:12:33,320
!أتيت للإطاحة بكايدو

130
00:12:33,540 --> 00:12:36,740
!وحّدنا قوانا لذلك السّبب

131
00:12:36,740 --> 00:12:39,530
!ماذا قلت؟

132
00:12:40,590 --> 00:12:41,290
!كلاّ

133
00:12:42,090 --> 00:12:43,870
ما هذا؟

134
00:12:44,050 --> 00:12:48,590
ربّما التّحالف الّذي يتحدّث الجميع
عنه تشكّل بالفعل؟

135
00:12:50,470 --> 00:12:54,050
...سمعت بشأنه إذًا

136
00:12:54,050 --> 00:12:59,680
!ذلك صحيح! شكّلنا تحالف قراصنة

137
00:13:02,690 --> 00:13:04,540
...مستحيل

138
00:13:04,540 --> 00:13:06,380
...لا بدّ أنّك تمزحين يا ماما

139
00:13:06,380 --> 00:13:11,150
!لا يمكننا التّحالف مع كايدو! لا يمكن أن نثق به

140
00:13:11,150 --> 00:13:13,220
.بيروسبيرو

141
00:13:13,220 --> 00:13:18,410
هل تشكّك في قراري؟

142
00:13:18,870 --> 00:13:21,830
!للحصول على الوان بيس

143
00:13:22,000 --> 00:13:25,250
.بإمكاننا أن نستغلّه

144
00:15:10,570 --> 00:15:11,560
!أخيرًا

145
00:15:17,450 --> 00:15:21,070
!هذا يكفي أيّها الحمقى

146
00:15:27,040 --> 00:15:28,290
!كايدو

147
00:15:29,460 --> 00:15:33,920
!جاك واحد من كبار النّجوم الّذين اخترتهم بنفسي

148
00:15:34,590 --> 00:15:40,840
لا يوجد سبب يدفعني لألزم الصّمت
.بينما يُضرب تابعي الغالي حتّى الموت

149
00:15:41,890 --> 00:15:45,120
...أنا... آسف

150
00:15:45,120 --> 00:15:46,720
...كايدو-ساما

151
00:15:49,360 --> 00:15:53,100
.أعلم أنّك لست ضعيفًا

152
00:15:55,030 --> 00:15:57,110
...إنّما هم

153
00:15:59,910 --> 00:16:02,200
!الأقوى هنا

154
00:16:11,540 --> 00:16:16,670
...تكبّدنا أضرارًا جسيمة بسبب السّولونغ

155
00:16:19,300 --> 00:16:24,470
لكنّك أبليت حسنًا بمحاصرة أولئك
.السّولونغ بقدر ما استطعت

156
00:16:24,890 --> 00:16:28,930
.اذهب وداوِ جراحك. فعلت ما يكفي سلفًا

157
00:16:37,110 --> 00:16:38,820
.الشّغب يعمّ الجزيرة

158
00:16:40,320 --> 00:16:42,490
هل سيصعدون إلى هنا؟

159
00:16:42,490 --> 00:16:44,780
!لا أصدّق أنّ لا أحد هنا في قاعة الوليمة

160
00:16:44,780 --> 00:16:48,030
أختي ماريا، هلاّ غنّيت لنا أغنية؟

161
00:16:48,290 --> 00:16:49,530
.حسنًا

162
00:16:50,040 --> 00:16:52,950
ما رأيكنّ في شيء كهذا؟

163
00:16:57,380 --> 00:16:59,790
في اللّيلة المثلِجة

164
00:17:01,220 --> 00:17:03,050
!مهلاً

165
00:17:05,180 --> 00:17:08,090
الاثنان المشتاقان لبعضهما

166
00:17:09,690 --> 00:17:12,600
ولم يحصلا على فرصة

167
00:17:14,650 --> 00:17:16,980
لرؤية بعضهما لمدّة

168
00:17:18,110 --> 00:17:21,070
!قد رأيا بعضهما أخيرًا

169
00:17:22,160 --> 00:17:24,570
تحت ضياء القمر

170
00:17:26,460 --> 00:17:28,160
!كم هذا رومانسيّ

171
00:17:31,670 --> 00:17:34,080
!تلك الحماسة

172
00:17:44,470 --> 00:17:47,510
أفهمت يا بيروسبيرو؟

173
00:17:47,510 --> 00:17:52,480
.قرّرت تشكيل تحالف مع كايدو

174
00:17:52,480 --> 00:17:54,460
،ومع ذلك

175
00:17:54,460 --> 00:17:59,610
نحن أفراد العائلة أردنا دائمًا
!أن تصير ماما ملك القراصنة

176
00:17:59,610 --> 00:18:00,770
!لعق

177
00:18:01,950 --> 00:18:04,610
.أعلم ذلك بالطّبع

178
00:18:04,910 --> 00:18:08,780
ألا يمكنكم أن تثقوا بي؟

179
00:18:11,750 --> 00:18:15,080
.حسنًا... ارتحت الآن

180
00:18:16,880 --> 00:18:18,320
.فهمت

181
00:18:18,320 --> 00:18:23,990
إذًا، ما عاد القضاء على الغيلان
.غايتنا المشتركة الآن

182
00:18:23,990 --> 00:18:25,260
.يا بيروسبيرو

183
00:18:25,760 --> 00:18:28,640
...قبلت عرضك، ولكن

184
00:18:28,640 --> 00:18:34,870
.ماركو! لا أصدّق أنّك ساعدت أولئك الأشقياء
.ظننت أنّك أفضل من ذلك

185
00:18:34,870 --> 00:18:39,560
أظنّ أنّ بقايا طاقم اللّحية البيضاء
.يجهلون ماذا يفعلون

186
00:18:40,400 --> 00:18:45,280
ألست تسيئين فهم كلمة "بقايا" يا بيغ مام؟

187
00:18:47,620 --> 00:18:49,320
...أتظنّين أنّ صوت والدنا

188
00:18:55,170 --> 00:18:59,210
ما زال يربطنا؟

189
00:19:00,260 --> 00:19:02,330
...نحن من تُركنا في الخلف

190
00:19:02,930 --> 00:19:05,040
!أحرار-يوي

191
00:19:05,800 --> 00:19:09,620
...نعم، لا يستطيع الأموات الكلام

192
00:19:09,620 --> 00:19:11,510
.افعل ما يحلو لك

193
00:19:12,100 --> 00:19:14,300
....لا يبدو أنّك تفهمين

194
00:19:15,860 --> 00:19:19,520
!لكنّني حرّ للقيام بما يحلو لي

195
00:19:36,790 --> 00:19:38,750
!علمتُ أنّه هو

196
00:19:39,880 --> 00:19:40,960
...أنا

197
00:19:42,340 --> 00:19:45,290
.راودني شعور أنّ هذه ستكون رحلتي الأخيرة

198
00:19:45,300 --> 00:19:47,420
ماذا تعني يا بيدرو؟

199
00:19:47,970 --> 00:19:51,340
...يومًا ما، سترين ما مدى أهمّيّة

200
00:19:51,890 --> 00:19:56,390
!إنقاذ لوفي والبقيّة هنا والسّماح لهم بالإبحار

201
00:20:01,570 --> 00:20:02,440
!بيدرو؟

202
00:20:03,610 --> 00:20:04,730
.الوداع

203
00:20:26,220 --> 00:20:28,710
!بيدرو

204
00:20:29,510 --> 00:20:30,800
!اسمعي

205
00:20:31,180 --> 00:20:33,930
!عليكم أنتم-غارا المواصلة

206
00:20:35,270 --> 00:20:36,720
!بيدرو

207
00:20:39,940 --> 00:20:41,730
!كاروت! إلى أين تذهبين؟

208
00:20:41,730 --> 00:20:43,810
!وجدت عدوّ بيدرو

209
00:20:53,240 --> 00:20:55,530
!يا قبّعة القشّ-سان! تقدّم الآن

210
00:20:55,790 --> 00:20:56,910
!شكرًا لك

211
00:21:01,800 --> 00:21:04,290
!ها هما! قبّعة القشّ والسّاق السّوداء

212
00:21:04,290 --> 00:21:05,920
!كم هم مزعجون

213
00:21:05,920 --> 00:21:07,750
!ابتعدوا عن طريقي

214
00:21:21,270 --> 00:21:25,770
أنا واثق أنّكم ستتعبون في النّهاية
!من الهرب وستموتون

215
00:21:28,400 --> 00:21:33,150
!لا أطيق الانتظار حتّى أرى كم تستطيعون أن تتفادون

216
00:21:37,780 --> 00:21:40,030
.لم أفكّر في ذلك من الأساس

217
00:21:40,410 --> 00:21:43,160
!نَفس الانفجار

218
00:21:44,800 --> 00:21:46,460
!أسلوب لهب الثّعلب

219
00:21:50,760 --> 00:21:52,550
!فاصل اللّهب

220
00:22:21,080 --> 00:22:25,240
!ظننتَ أنّنا سنهرب؟ هذا مضحك

221
00:22:25,870 --> 00:22:28,160
!سئمنا من الهرب

222
00:22:28,510 --> 00:22:30,540
!سئمنا من الاختباء

223
00:22:30,920 --> 00:22:36,010
!سنموت بصفتنا ساموراي أودن-ساما

224
00:22:38,140 --> 00:22:40,970
!متشبّثين برأسك

225
00:23:04,380 --> 00:23:07,100
بعد الحفاظ على قلوبهم الشّغوفة
الّتي تهزّ الأرض وهي تنبض لسنوات

226
00:23:07,100 --> 00:23:09,920
،بحبّهم لسيّدهم أودن

227
00:23:09,920 --> 00:23:14,110
.يقف أعضاء أكازايا معًا لإنقاذ بلاد وانو

228
00:23:14,110 --> 00:23:17,260
!أيّتها الأنصال المصقولة! آن الأوان

229
00:23:17,260 --> 00:23:21,300
!ستقضي الفنون السّرّيّة الأسطوريّة على كايدو

230
00:23:22,470 --> 00:23:27,640
:في الحلقة القادمة من وان بيس
"!تقنية متوارثة! إطلاق مسايفة أودن السّرّيّة"

231
00:23:27,640 --> 00:23:30,270
!ملك القراصنة، لن يكون إلاّ أنا