1
00:00:00,000 --> 00:00:01,260
!مفتاح تدمير ذاتيّ؟

2
00:00:01,490 --> 00:00:04,340
!أتخاف كوما لذلك الحدّ؟

3
00:00:06,230 --> 00:00:09,310
أنا أمنعك بالكامل من الحفاظ
.على أيّ أرادة حرّة

4
00:00:12,500 --> 00:00:15,230
هذه إذًا... هي حياتي؟

5
00:00:17,410 --> 00:00:19,840
.لا بدّ أنّي تسبّبت بالأذى للكثيرين

6
00:00:20,710 --> 00:00:22,340
أنت تسبّبت بالأذى؟

7
00:00:23,070 --> 00:00:25,740
!في الحقيقة، هكذا هي سنّة الحياة

8
00:00:26,220 --> 00:00:29,390
...بل موتك ما سيسبّب الأذى

9
00:00:29,710 --> 00:00:32,600
!لكلّ شخص عرفك وأحبّك

10
00:00:33,300 --> 00:00:34,620
.شكرًا لك

11
00:00:38,810 --> 00:00:42,360
هلاّ أوصلتَ رسالة لابنتي بوني؟

12
00:00:44,490 --> 00:00:46,520
...عيدُ ميلادٍ عاشر

13
00:00:47,530 --> 00:00:49,010
.سعيد

14
00:01:07,890 --> 00:01:09,300
...بوني

15
00:01:13,850 --> 00:01:16,060
هل رأيت كلّ ذكرياته؟

16
00:01:16,290 --> 00:01:17,470
.رأيتُها

17
00:01:20,170 --> 00:01:21,900
...يا إلهي

18
00:01:22,820 --> 00:01:26,200
لم أستطع الوفاء بالوعد
.الّذي قطعتُه لكوما

19
00:01:48,510 --> 00:01:49,690
...على رسلك

20
00:01:52,330 --> 00:01:55,430
!أنا آسفة يا فيغابانك

21
00:02:03,660 --> 00:02:09,050
"!آسفة يا أبي! دموع بوني ولكمة كوما"

22
00:02:12,600 --> 00:02:14,580
.ناوليني يدك

23
00:02:14,780 --> 00:02:15,930
لماذا؟

24
00:02:16,520 --> 00:02:18,420
...ترك كوما معي

25
00:02:19,280 --> 00:02:22,510
.هديّة عيد ميلادك العاشر

26
00:02:22,510 --> 00:02:24,760
!هديّة من أبي؟ مرحى

27
00:02:27,240 --> 00:02:28,530
!انظري

28
00:02:32,040 --> 00:02:34,850
!جميل! إنّه ياقوت أزرق

29
00:02:35,040 --> 00:02:38,440
!إنّها قلادة تشبه الشّمس
!سأقدّرها للأبد

30
00:02:38,720 --> 00:02:41,020
تشبه الشّمس؟ –
!نعم –

31
00:02:41,580 --> 00:02:42,980
،مثل إله الشّمس

32
00:02:43,480 --> 00:02:44,630
!نيكا

33
00:02:49,800 --> 00:02:51,560
...هكذا إذًا

34
00:02:51,560 --> 00:02:54,330
،قال كوما أنّها تميمة حظّ سعيد

35
00:02:54,780 --> 00:02:56,310
.لكنّك على حقّ

36
00:02:56,650 --> 00:02:59,380
...من كان يظنّ قبل سنتين

37
00:02:59,670 --> 00:03:02,800
أنّ ذلك الفتى سيتحوّل إلى شيء كذلك؟

38
00:03:02,800 --> 00:03:04,580
إلى شيء كذلك؟

39
00:03:04,580 --> 00:03:05,620
...نعم

40
00:03:06,700 --> 00:03:11,410
،بعد التّفكير في الأمر
.قبّعة القشّ هو ابن صديق أبي

41
00:03:11,410 --> 00:03:14,970
صحيح، لذلك السّبب تفاجأتُ كثيرًا
.عندما ظهرتما معًا أمامي

42
00:03:15,270 --> 00:03:17,790
.ما أغربَ تصاريف القدر بالفعل

43
00:03:17,790 --> 00:03:19,690
،بينما كنتِ في تلك الغرفة

44
00:03:19,690 --> 00:03:23,730
ممنوع الاقتراب
احذروا

45
00:03:20,220 --> 00:03:23,730
.حدثت أمور خطيرة عديدة في إيغهيد

46
00:03:24,700 --> 00:03:29,460
.حتّى أنّ طاقم قبّعة القشّ قد أنقذوا حياتي للتّوّ

47
00:03:30,140 --> 00:03:34,770
.سأشرح لك كلّ شيء
.لنذهب للقائهم بعد أن تهدأ الأمور

48
00:03:34,770 --> 00:03:35,970
!موافقة

49
00:03:46,370 --> 00:03:48,680
...أنا آسف يا بوني

50
00:03:48,680 --> 00:03:52,790
في نهاية المطاف، ما أنا إلاّ عالِم
...أجير لدى الحكومة

51
00:03:52,790 --> 00:03:54,140
.كلاّ

52
00:03:56,150 --> 00:03:57,370
.كلاّ

53
00:03:58,510 --> 00:03:59,730
!كلاّ

54
00:04:00,090 --> 00:04:01,790
.إنّها غلطته هو

55
00:04:04,690 --> 00:04:06,320
!هو الوحيد المُلام

56
00:04:06,320 --> 00:04:07,440
في الوقت الحاليّ

57
00:04:07,570 --> 00:04:09,200
على جزيرة إيغهيد
في العالم الجديد

58
00:04:20,520 --> 00:04:24,520
!سُحقًا، لماذا لا نستطيع الحركة؟

59
00:04:25,250 --> 00:04:26,590
!بوني

60
00:04:27,030 --> 00:04:28,510
!ما الّذي يحدث هنا؟

61
00:04:28,510 --> 00:04:31,320
!لا فكرة لديّ! لا بدّ أنّها قوّته

62
00:04:38,230 --> 00:04:42,840
...طعام

63
00:04:42,840 --> 00:04:44,900
...أريد لحمًا

64
00:04:45,220 --> 00:04:49,240
...ليحضر لي أحد ما

65
00:04:49,240 --> 00:04:51,880
...بعض اللّحم

66
00:04:51,880 --> 00:04:54,740
!كنتُ لأحضره له، لكنّي عاجزة عن الحركة

67
00:04:56,200 --> 00:04:57,440
!لدينا تقرير

68
00:04:58,280 --> 00:05:00,200
تمّ العثور على حارس فيغابانك

69
00:05:00,460 --> 00:05:04,040
!المدعوّ سنتومارو في الفابريوفيز في وسط البلدة

70
00:05:06,720 --> 00:05:09,010
...سنتومارو-كُن

71
00:05:09,750 --> 00:05:11,210
...بوني

72
00:05:13,820 --> 00:05:17,390
.أيّتها القرصانة جولري بوني

73
00:05:19,010 --> 00:05:21,850
...إنّ والدك كوما

74
00:05:23,540 --> 00:05:24,960
.ميت

75
00:05:28,400 --> 00:05:29,730
!لديّنا تقرير

76
00:05:29,930 --> 00:05:33,440
لا يُسمح إلاّ بأصحاب رتبة العميد
...البحريّ فما فوق بالدّخول

77
00:05:35,810 --> 00:05:38,200
!هذا لا يُصدّق أبدًا

78
00:05:38,640 --> 00:05:41,560
صار من أباطرة البحر الأربعة
!وها هو الآن يحاصر رهينة

79
00:05:41,560 --> 00:05:42,750
...صحيح

80
00:05:42,750 --> 00:05:46,740
.آمل فقط ألاّ يموت أبرياء وسط كلّ هذا

81
00:05:51,050 --> 00:05:54,770
جمعت البحريّة قوّات أكثر ممّا
!فعلت في حصار أوهارا

82
00:05:54,770 --> 00:05:58,080
.هذا سيّئ جدًّا بالنّسبة للدّكتور فيغابانك

83
00:05:55,840 --> 00:05:58,680
حادثة رهائن طاقم قبّعة القشّ

84
00:05:59,570 --> 00:06:01,560
!كلاّ

85
00:06:01,560 --> 00:06:03,680
!الأمر ليس كذلك

86
00:06:03,680 --> 00:06:06,100
...أبقوا أيديكم أعلى هكذا

87
00:06:07,920 --> 00:06:09,700
!ثمّ اضربوا

88
00:06:11,160 --> 00:06:12,640
هل فهمتم؟

89
00:06:12,640 --> 00:06:13,800
!كان ذلك رائعًا

90
00:06:13,800 --> 00:06:17,030
!أرنا ذلك مرّة أخرى

91
00:06:17,030 --> 00:06:19,670
!حسنًا، فقط لأنّكم مصرّون

92
00:06:19,670 --> 00:06:22,750
!أقوم بهذا فقط لأجلكم أيّها الفتية والفتيات

93
00:06:25,070 --> 00:06:27,710
هل من مشكلة يا دراغون؟

94
00:06:28,160 --> 00:06:32,600
،إن كان كوما قد اندفع مسرعًا بدافع غريزيّ

95
00:06:33,020 --> 00:06:36,430
فإلى أين يكون قد ذهب في رأيك يا إيفا؟

96
00:06:39,620 --> 00:06:43,320
،لو كنتُ أنا في محلّه
...لذهبتُ مباشرة إلى ماريجوا

97
00:06:45,420 --> 00:06:47,350
.لكنّ كوما مختلف

98
00:06:48,720 --> 00:06:50,310
...لا بدّ أنّه

99
00:06:57,340 --> 00:06:59,320
...لذلك لماذا لا

100
00:06:59,960 --> 00:07:02,990
تنضمّين إلى والدك في الحياة الآخرة؟

101
00:07:11,440 --> 00:07:13,170
!كفّ عن ذلك أيّها غبيّ

102
00:07:25,770 --> 00:07:27,690
!إيّاك والعبث معي

103
00:07:30,400 --> 00:07:33,070
،إن كنت سأُقتَل في كلّ الأحوال

104
00:07:33,300 --> 00:07:34,860
!فسآخذك معي أيضًا

105
00:07:37,070 --> 00:07:39,910
!المستقبل المحرّف

106
00:07:43,780 --> 00:07:45,540
!مستقبل شبيه بنيكا

107
00:07:45,900 --> 00:07:47,250
نيكا؟

108
00:07:47,500 --> 00:07:48,920
!الآن

109
00:07:59,960 --> 00:08:03,760
ما كان ذلك؟ أتسمّين هذا هجومًا؟

110
00:08:09,840 --> 00:08:11,220
...إنّ ضرباتي

111
00:08:12,180 --> 00:08:13,980
...ضعيفة ثانية

112
00:08:14,570 --> 00:08:15,790
لماذا؟

113
00:08:17,260 --> 00:08:18,930
...فهمت

114
00:08:19,280 --> 00:08:20,900
.أنت ابنته

115
00:08:30,520 --> 00:08:33,710
.هذا يفسّر لماذا تعرفين ذلك الاسم

116
00:08:37,940 --> 00:08:39,240
...ولكنّك

117
00:08:39,630 --> 00:08:41,590
...لا تعرفين

118
00:08:42,580 --> 00:08:44,100
.ما هو

119
00:08:49,060 --> 00:08:52,050
ما الّذي تثرثر به؟

120
00:08:53,710 --> 00:08:55,720
...يبدو أنّها لم ترَ الرّابط

121
00:08:55,720 --> 00:08:59,880
بين نيكا وقبّعة القشّ لوفي
.في هيئته البيضاء بعد

122
00:09:01,210 --> 00:09:02,490
...يا للأسف

123
00:09:03,960 --> 00:09:05,620
!بالفعل

124
00:09:21,790 --> 00:09:25,550
!مهلاً، من قام بإطعامه؟

125
00:09:25,550 --> 00:09:27,220
!ماذا؟! لـ-ليس نحن

126
00:09:27,220 --> 00:09:28,930
!لم نمنحه أيّ شيء

127
00:09:28,930 --> 00:09:31,600
!ضعوا أصفاد الحجر البحريّ عليه

128
00:09:31,600 --> 00:09:33,310
!في الحال –
!أمرك –

129
00:09:33,590 --> 00:09:35,060
!أمسكوا به

130
00:09:35,060 --> 00:09:39,030
...دعوني آكل لحمي

131
00:09:39,530 --> 00:09:42,000
!توقّفوا

132
00:09:50,950 --> 00:09:54,150
...لا أستطيع تغيير عُمر هذا العجوز

133
00:09:54,150 --> 00:09:55,460
!لماذا يا ترى؟

134
00:09:55,460 --> 00:10:00,210
تتساءلين لماذا لا تعمل قواك ضدّي؟

135
00:10:01,090 --> 00:10:02,320
...بوني

136
00:10:03,120 --> 00:10:05,010
...إنّ تلك القوّة

137
00:10:08,330 --> 00:10:12,040
.أنا من أعطيتك إيّاها

138
00:10:34,810 --> 00:10:38,210
...إنّ تلك القوّة
.أنا من أعطيتك إيّاها

139
00:10:40,820 --> 00:10:42,010
ماذا؟

140
00:10:44,600 --> 00:10:46,250
.كنتِ فأر تجارب

141
00:10:46,880 --> 00:10:49,440
،لا يستطيع الرُّضّع أكل الفواكه

142
00:10:49,800 --> 00:10:53,980
لذا قمنا بحقنك بمستخلص منها لنرى
.إن كنت ستحصلين على قوى من ذلك فقط

143
00:10:59,210 --> 00:11:01,090
.فاكهة العُمر

144
00:11:01,980 --> 00:11:04,570
،كانت التّجربة ناجحة
.لكنّ الفاكهة كانت بلا قيمة

145
00:11:05,230 --> 00:11:09,160
بإمكان مستعملها تحويل نفسه
.لأيّ مستقبل محتمل يتخيّله

146
00:11:10,030 --> 00:11:12,120
،لكن كلّما أدركتِ الواقع

147
00:11:12,120 --> 00:11:16,000
.بدأت تلك الاحتمالات المستقبليّة بالاختفاء

148
00:11:23,300 --> 00:11:26,590
أما زلت تؤمنين أنّ نيكا حقيقيّ؟

149
00:11:26,830 --> 00:11:28,300
!نيكا حقيقيّ

150
00:11:28,610 --> 00:11:31,740
كنتُ أبحث عنه منذ اليّوم
الّذي صار فيه أبي سايبورغ

151
00:11:31,740 --> 00:11:35,310
!تحت أوامرك أنت لتحريره من قبضتك

152
00:11:35,820 --> 00:11:40,730
،بدأت تشكّين في وجوده
.ولذلك صارت ضرباتك أضعف

153
00:11:45,240 --> 00:11:48,400
،آمن والدك أيضًا بأسطورة الباكانير الغبيّة تلك

154
00:11:48,640 --> 00:11:51,780
...حتّى أنّه قال لي

155
00:11:54,120 --> 00:11:57,160
".أريد إنقاذ النّاس مثل نيكا تمامًا"

156
00:12:00,570 --> 00:12:05,340
وكنتُ أنا أيضًا من أجرى تجارب
،عقاقير على والدتك

157
00:12:05,340 --> 00:12:08,220
الّتي كانت الزّوجة الثّامنة لشخص
.من الأرض المقدّسة

158
00:12:09,800 --> 00:12:13,840
وأثبتت تلك الشّوائب الزّرقاء
.أنّها كانت تجربة فاشلة أخرى

159
00:12:29,150 --> 00:12:31,770
ومع أنّي لم أحصل على النّتيجة
،الّتي كنتُ أتوقّعها

160
00:12:31,770 --> 00:12:34,620
لم أتصوّر أبدًا أنّك قد ترثين
.ذلك التّأثير الجانبيّ

161
00:12:55,220 --> 00:12:57,640
!و-وقع شيء ما من السّماء

162
00:13:08,870 --> 00:13:11,460
...إذًا كنتَ أنت

163
00:13:13,410 --> 00:13:15,570
تجارب؟

164
00:13:15,870 --> 00:13:18,080
!كان ذلك نتيجة لتجاربك؟

165
00:13:18,820 --> 00:13:20,410
...ذاق كوما وعائلته

166
00:13:20,410 --> 00:13:23,120
!الأمرّين بسبب حراشف الياقوت الأزرق

167
00:13:24,420 --> 00:13:27,800
!ضحّى كوما بحياته لعلاج ابنته

168
00:13:28,240 --> 00:13:31,350
بينما تحلّيتَ أنت بالوقاحة لتعرض
!عليه صفقة كأنّك تسديه خدمة

169
00:13:31,350 --> 00:13:32,380
.تمهّل

170
00:13:35,400 --> 00:13:37,760
.ضع نفسك في مكاني

171
00:13:39,150 --> 00:13:43,690
هل كنتَ لتزعج نفسك بمشاعر الحشرات؟

172
00:13:51,840 --> 00:13:53,240
!بالطّبع لا

173
00:14:07,320 --> 00:14:08,840
!أهو باسيفيستا؟

174
00:14:09,250 --> 00:14:10,960
!كـ-كلاّ

175
00:14:11,830 --> 00:14:13,920
!إنّه يملك وسائد كفوف على راحة يده

176
00:14:15,850 --> 00:14:17,260
...أيعقل أنّه

177
00:14:17,560 --> 00:14:19,100
الحقيقيّ؟

178
00:14:31,850 --> 00:14:32,900
!لدينا تقرير

179
00:14:33,360 --> 00:14:35,610
،وصل إلى ساحل إيغهيد الجنوب غربيّ

180
00:14:35,610 --> 00:14:39,590
بارثولوميو كوما، أحد أسياد
!الحرب السّبعة السّابقين

181
00:14:40,310 --> 00:14:42,460
.إنّه في طريقه إلى وسط الجزيرة

182
00:14:42,560 --> 00:14:45,580
لا تعمل رقاقة السّلطة معه
!ولا يمكننا إيقافه

183
00:14:56,080 --> 00:14:58,580
!كوما هنا؟! لماذا؟

184
00:14:59,230 --> 00:15:01,310
!ما كلّ هذه الجلبة؟

185
00:15:01,610 --> 00:15:04,060
.لا يعقل أن يكون كوما هنا

186
00:15:17,890 --> 00:15:18,860
...لا أستطيع

187
00:15:22,900 --> 00:15:25,320
...أنا خائفة جدًّا

188
00:15:27,410 --> 00:15:29,580
...لا أستطيع حتّى البوح بكلمة

189
00:15:41,800 --> 00:15:44,770
!استعملوا أسلحتكم وأوقفوه –
!عُلم –

190
00:15:57,370 --> 00:16:00,240
...اسمع يا أبي

191
00:16:09,000 --> 00:16:11,170
...أشعر وكأنّ روحي تُسحق

192
00:16:14,710 --> 00:16:15,800
...أعتقد أحيانًا

193
00:16:26,220 --> 00:16:27,750
...أنّه ربّما

194
00:16:28,640 --> 00:16:29,810
...سيكون

195
00:16:30,640 --> 00:16:34,460
.من السّهل عليّ أكثر لو متّ فحسب

196
00:16:45,550 --> 00:16:48,330
...سامحني يا أبي

197
00:17:00,100 --> 00:17:03,260
.إنّ صراخك بدأ يزعجني أيّتها الشّقيّة

198
00:17:06,030 --> 00:17:08,070
.صوّبوا على الرّأس

199
00:17:13,230 --> 00:17:16,190
!توقّفوا

200
00:17:34,300 --> 00:17:35,720
...سامحني

201
00:17:36,150 --> 00:17:37,630
.يا أبي

202
00:17:41,250 --> 00:17:43,720
...فعلتَ كلّ شيء حتّى أستطيع أن أعيش

203
00:18:26,590 --> 00:18:28,450
!أبي

204
00:18:33,890 --> 00:18:37,370
...أبي

205
00:18:48,500 --> 00:18:51,080
!إنّه بارثولوميو كوما بالفعل

206
00:19:02,340 --> 00:19:03,670
!مستحيل

207
00:19:19,420 --> 00:19:22,070
!ما معنى هذا يا فيغابانك؟

208
00:19:22,290 --> 00:19:25,400
!يُفترض... يُفترض أنّه مات

209
00:19:35,580 --> 00:19:37,830
...فتى الباكانير

210
00:19:38,130 --> 00:19:43,100
الموت أو العبوديّة هما فقط
.ما قُدّر لكم في هذه الحياة

211
00:19:45,360 --> 00:19:47,550
.أمّك ماتت

212
00:19:48,280 --> 00:19:51,490
.أعتقد أنّها... في مكان أفضل الآن

213
00:19:52,440 --> 00:19:53,920
...كوماتشي

214
00:19:54,710 --> 00:19:56,430
.أنا جدّ سعيدة

215
00:19:56,830 --> 00:19:58,780
.أنا آسفة يا كوماتشي

216
00:19:58,960 --> 00:20:01,420
.سأموت عمّا قريب

217
00:20:17,220 --> 00:20:19,330
!يفترض أنّه مات

218
00:20:19,750 --> 00:20:23,180
،بعد بضعة أيّام من إنقاذ الجيش الثّوريّ له

219
00:20:25,050 --> 00:20:27,710
...ضغطتُ على مفتاح

220
00:20:30,260 --> 00:20:31,970
!التّدمير الذّاتيّ

221
00:21:05,880 --> 00:21:19,770
يوجد قوس قزح وراء الأمطار الغزيرة

222
00:21:28,110 --> 00:21:32,070
سأعرف أنّ الجواب السّهل كذبة

223
00:21:33,110 --> 00:21:37,330
أعد ألاّ أتراجع أمام الصّراخ

224
00:21:37,330 --> 00:21:41,290
أحتاجك وحدك لتفهم الغد

225
00:21:42,250 --> 00:21:46,250
أعطيتني أفضل لحظات حياتي

226
00:21:48,050 --> 00:21:56,890
...ماذا أبدو؟ ملَكًا أم شيطانًا

227
00:21:56,890 --> 00:22:01,730
ما وراء الفجر، ما وراء الفجر

228
00:22:01,730 --> 00:22:07,190
ثمّة الكثير ممّا أريد أن أخبرك به

229
00:22:07,190 --> 00:22:11,990
مليء بالحبّ، بالحبّ

230
00:22:07,380 --> 00:22:07,940
أبي

231
00:22:11,990 --> 00:22:17,780
الّذي لا يمكن كتابته في رسالة

232
00:22:14,030 --> 00:22:16,110
عزيزتي بوني

233
00:22:17,780 --> 00:22:26,330
يد صغيرة تبحث عن الأبديّة

234
00:22:41,010 --> 00:22:46,520
يُتبع

235
00:22:50,480 --> 00:22:53,990
،يسير كوما نحو ابنته
.بينما بلغ جسده حدوده

236
00:22:54,240 --> 00:22:56,540
.انتظرت بوني عودته لوقت طويل

237
00:22:56,740 --> 00:22:59,700
ما الّذي دفع كوما للتّحرّك

238
00:22:59,700 --> 00:23:02,950
مع أنّه ما عاد يملك أيّ ذكريات
أو سبب وجيه لذلك؟

239
00:23:02,950 --> 00:23:05,830
.وبعد وقت طويل، يلتقي الأب وابنته أخيرًا

240
00:23:06,070 --> 00:23:07,620
:في الحلقة القادمة من وان بيس

241
00:23:07,620 --> 00:23:11,420
"!شكرًا يا أبي! عناق كوما وبوني الدّافئ"

242
00:23:11,420 --> 00:23:13,700
!ملك القراصنة، لن يكون إلاّ أنا