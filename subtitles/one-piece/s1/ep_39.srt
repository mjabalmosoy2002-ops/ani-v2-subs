1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:01:53,910 --> 00:01:55,210
...لوفي

26
00:01:56,480 --> 00:01:57,550
...ساعدني

27
00:02:05,820 --> 00:02:08,390
!إيّاك أن تُبكي ملاّحتنا

28
00:02:14,300 --> 00:02:16,200
...غومو غومو نوو

29
00:02:16,770 --> 00:02:19,070
!المروحة

30
00:02:35,780 --> 00:02:37,150
...ماذا... ماذا

31
00:02:37,820 --> 00:02:40,720
آكلو فواكه الشّيطان
.لا يستطيعون السّباحة

32
00:02:41,090 --> 00:02:45,590
لكن، حتّى غير آكليها
.سيغرقون في هذا الوضع

33
00:02:46,730 --> 00:02:48,300
!هل سيرمي به في البحر؟

34
00:02:49,130 --> 00:02:51,070
!غومو غومو نوو: المسدّس

35
00:02:52,500 --> 00:02:53,900
!سحقًا لك

36
00:02:57,310 --> 00:02:58,410
!لوفي

37
00:02:58,410 --> 00:02:59,510
!سحقًا لك

38
00:03:06,150 --> 00:03:08,280
...هذا سيّئ... قوّتي تخور

39
00:03:12,350 --> 00:03:16,290
!لوفي غريق"
".زورو ضدّ هاتشان الأخطبوط

40
00:03:19,290 --> 00:03:22,630
ما رأيكما؟ أليست لعبةً شيّقة للغاية؟

41
00:03:23,100 --> 00:03:25,370
كم من ثانية سيصمد فتى المطّاط؟

42
00:03:25,370 --> 00:03:29,270
أم ستموتان قبله؟

43
00:03:33,640 --> 00:03:36,710
.هذا سيّئ يا جوني
...أخي الكبير لوفي في ورطة

44
00:03:36,710 --> 00:03:39,250
!لا يستطيع مساعدة نفسه الآن

45
00:03:41,880 --> 00:03:44,880
.سنهزمه في خمس ثوان
!لوفي! سآتي لإنقاذك على الفور

46
00:03:45,120 --> 00:03:47,290
!قذيفة حبر هاتشي

47
00:03:54,860 --> 00:04:00,000
...شعري! أيّها الوغد! سوف

48
00:04:00,400 --> 00:04:03,600
أسامحك بما أنّه مجرّد شعر
.وسينمو ثانية

49
00:04:04,200 --> 00:04:05,670
!رورونوا زورو

50
00:04:05,670 --> 00:04:09,680
لا يمكنك أن تقطّعني
.لأنّي أملك ستّة أيدي

51
00:04:09,680 --> 00:04:11,740
!حاول أن تقطّعني إن استطعت

52
00:04:11,740 --> 00:04:12,680
!أيّها الرّجل الأخطبوط

53
00:04:12,680 --> 00:04:19,250
!صدّ... هاتشي... الثّلاثيّ... للسّيوف

54
00:04:22,050 --> 00:04:23,690
!هذا مؤلم

55
00:04:23,690 --> 00:04:25,520
!لا أملك الوقت للّهو معك

56
00:04:28,560 --> 00:04:29,900
!إنّه يثير غيظي

57
00:04:30,930 --> 00:04:32,760
...أيعقل أنّه

58
00:04:32,760 --> 00:04:34,730
!انتبه وإلاّ فلن تعيش طويلًا

59
00:04:35,030 --> 00:04:37,770
!لا يجب أن يهاجم السّمك الطبّاخ

60
00:04:38,270 --> 00:04:40,910
...الوقت ينفد منّا... لا يوجد وقت

61
00:04:42,440 --> 00:04:44,080
!انهزم بسرعة

62
00:04:47,550 --> 00:04:51,120
!مصّاص هاتشي

63
00:04:55,850 --> 00:04:58,560
!وماذا؟! انزل بسرعة

64
00:05:01,430 --> 00:05:03,430
!أيّها الأخطبوط الخسيس

65
00:05:07,530 --> 00:05:10,670
!ذاك الأخطبوط اللّعين
!إنّه يتحرّك بترنّح وبطء

66
00:05:10,670 --> 00:05:12,800
،لكن، إن نزل إلى البحر الآن

67
00:05:12,800 --> 00:05:15,210
.سيُسحب إلى قعره

68
00:05:15,210 --> 00:05:18,540
،لكن على هذا الحال
!سيموت أخي الكبير لوفي

69
00:05:18,540 --> 00:05:20,340
!علينا أن نفعل شيئًا

70
00:05:20,340 --> 00:05:20,840
!نعم

71
00:05:20,840 --> 00:05:21,310
!انتظرا

72
00:05:21,310 --> 00:05:22,810
!هذا مؤلم

73
00:05:22,810 --> 00:05:26,520
ما الّذي بوسعكما فعله في البحر
بإصاباتكما البليغة؟

74
00:05:27,450 --> 00:05:30,250
.لا تستطيعان فعل الكثير هكذا

75
00:05:30,820 --> 00:05:33,990
إن كنتما تقصدان ذاك
.الشّابّ المطّاطّيّ، سأذهب وأنقذه

76
00:05:33,990 --> 00:05:35,490
حـ-حقًّا؟

77
00:05:35,790 --> 00:05:38,230
قدرتنا على إنقاذ ذلك الشّابّ
من عدمهما

78
00:05:38,230 --> 00:05:40,530
هي ما ستحسم هذه المعركة
على الأغلب، صحيح؟

79
00:05:40,530 --> 00:05:42,000
.يمكنني أن أرى ذلك أيضًا

80
00:05:42,000 --> 00:05:42,970
!غين-سان

81
00:05:42,970 --> 00:05:43,730
!سأذهب أيضًا

82
00:05:43,900 --> 00:05:45,000
!وأنا أيضًا

83
00:05:45,000 --> 00:05:46,340
!وأنا سأذهب

84
00:05:46,340 --> 00:05:49,340
،كلاّ! إن ذهب الكثير منّا لإنقاذه وتأخّروا

85
00:05:49,340 --> 00:05:54,180
سيلاحظ هؤلاء البرمائيّون ذلك وسيتسبّب
.ذلك المتاعب لهؤلاء الأشخاص على العكس

86
00:05:54,180 --> 00:05:54,940
!غين-سان

87
00:05:55,110 --> 00:05:59,580
لن يكون هنالك مغزى إن تسبّبنا
.في عرقلة قتالهم

88
00:05:59,580 --> 00:06:00,920
.لذا، سأذهب وحدي

89
00:06:01,320 --> 00:06:03,320
لا تمانعان، صحيح؟

90
00:06:03,820 --> 00:06:05,920
!آسف... شكرًا لك

91
00:06:05,920 --> 00:06:09,390
.سأدعه لك
.آسف، لكن أسرع أرجوك

92
00:06:09,620 --> 00:06:10,590
!انتظر

93
00:06:11,630 --> 00:06:13,530
.غين-سان، سأذهب أيضًا

94
00:06:13,930 --> 00:06:15,630
!نوجيكو، أنت مصابة

95
00:06:15,630 --> 00:06:19,400
يقاتل أولئك الأشخاص
!لأجل أختي الصّغيرة

96
00:06:21,970 --> 00:06:23,040
!غين-سان

97
00:06:26,940 --> 00:06:28,980
.حسنًا. تعالي معي

98
00:06:28,980 --> 00:06:29,780
!فلنسرع

99
00:06:29,780 --> 00:06:30,480
!نعم

100
00:06:32,150 --> 00:06:33,210
...آسف

101
00:06:33,650 --> 00:06:36,020
...يا ليتنا كنّا أقوى بقليل

102
00:06:36,780 --> 00:06:39,890
...أنقذا أخي الكبير... رجاءً

103
00:06:50,360 --> 00:06:52,870
!أيّها الرّجل السّمكة اللّعين

104
00:06:59,310 --> 00:07:03,080
رورونوا زورو! هل تمانع إن
سألتك سؤالًا؟ لا تمانع، صحيح؟

105
00:07:03,080 --> 00:07:06,950
.سمعتُ أنّك تستعمل أسلوب الثّلاثة سيوف
فلمَ تستخدم سيفًا واحدًا الآن؟

106
00:07:06,950 --> 00:07:09,280
!أنت تخسر سلفًا بسيفٍ واحد

107
00:07:09,620 --> 00:07:12,290
!ا-اخرس! لستُ أقاتل بجديّة

108
00:07:12,290 --> 00:07:17,290
في الواقع، ثمّة سبب لعجز
.السّيّافين البشر في هزيمتي

109
00:07:17,290 --> 00:07:18,960
هل تريد أن تعرف السّبب؟
تريد أن تعرفه، صحيح؟

110
00:07:18,960 --> 00:07:22,260
!حينما تسمعه، ستتفاجأ وتخاف وتُذهل

111
00:07:22,900 --> 00:07:26,630
!سحقًا! لا يمكنني أن أتألّم الآن

112
00:07:26,630 --> 00:07:29,640
!كما أنّ الحمّى خاصّتي تسوء

113
00:07:29,640 --> 00:07:32,270
...خلتُ أنّها ستهمد بينما أتحرّك، لكن

114
00:07:40,380 --> 00:07:41,880
...كما توقّعت، الجراح

115
00:07:43,880 --> 00:07:45,850
الّتي تكبّدتها من قتالك
...مع عين الصّقر

116
00:07:46,420 --> 00:07:47,550
!أخي الكبير

117
00:07:47,920 --> 00:07:49,090
ما الّذي تفعله؟

118
00:07:49,090 --> 00:07:51,920
هل تحاول ادّعاء المرض أو ما شابه؟

119
00:07:51,920 --> 00:07:54,490
!لن تنطلي عليّ يا رورونوا زورو

120
00:07:54,490 --> 00:07:57,130
!تفقّد هيئتي الحقيقيّة فحسب

121
00:08:00,730 --> 00:08:03,400
!انظر! هذه هي هيئتي الحقيقيّة

122
00:08:03,400 --> 00:08:05,970
!هاتشي مستعمل أسلوب السّتّة سيوف قادم

123
00:08:05,970 --> 00:08:09,870
!أنت! لا يفترض بك أن تقع هكذا
!لا تسخر منّي

124
00:08:12,910 --> 00:08:13,940
!أخي الكبير

125
00:08:13,940 --> 00:08:15,950
!إذًا، فقد كان يتحمّل الألم

126
00:08:16,210 --> 00:08:19,420
نعم. كانت جراحه لتقتل شخصًا عاديًّا

127
00:08:19,420 --> 00:08:21,990
!أو لتتركه طريح الفراش لنصف عام

128
00:08:21,990 --> 00:08:22,690
!ماذا؟

129
00:08:25,620 --> 00:08:27,660
.فكّرتُ أنّ شيئًا غريبًا يحدث

130
00:08:27,660 --> 00:08:31,230
ادّعى وكأنّ شيئًا لم يكن بعد
.ذلك القتال الحامي

131
00:08:31,230 --> 00:08:32,600
!أهو غبيّ أم ماذا؟

132
00:08:40,440 --> 00:08:43,210
.ظننتني حذّرتك أن تنتبه

133
00:08:43,570 --> 00:08:45,910
أملك درجة دان الأربعين
.في كاراتيه البرمائيّين

134
00:08:46,110 --> 00:08:49,680
!مـ-ماذا؟ أَعُصِف بأحدهم؟

135
00:08:49,680 --> 00:08:51,580
!أ-أخي الكبير؟

136
00:08:51,580 --> 00:08:53,020
!أخي الكبير الطّبّاخ

137
00:08:56,620 --> 00:08:59,420
!أخي الكبير الطّبّاخ

138
00:09:04,690 --> 00:09:06,800
.تكفّلتُ بأمره يا أرلونغ-سان

139
00:09:06,800 --> 00:09:08,660
ماذا نفعل برورونوا زورو؟

140
00:09:08,660 --> 00:09:13,640
.ارموا به في البحر فحسب
!يا لهم من ضعفاء ويا له من ملل

141
00:09:17,070 --> 00:09:17,870
أهذا كلّ شيء؟

142
00:09:18,170 --> 00:09:21,640
.تبًّا، تسبّبوا في الكثير من الأضرار مع ذلك

143
00:09:21,640 --> 00:09:23,480
.ليس بالأمر الجلل

144
00:09:23,480 --> 00:09:26,550
لا يُمكن أن تُدمّر حديقة أرلونغ
.بهذا النّوع من الأضرار

145
00:09:26,550 --> 00:09:27,850
...فعلًا

146
00:09:29,350 --> 00:09:31,550
!كيف تجرؤ يا رورونوا زورو؟

147
00:09:31,550 --> 00:09:35,190
هل مِتّ من الصّدمة قبل أن
!أهاجمك أنا، السّيّاف العظيم؟

148
00:09:35,190 --> 00:09:36,990
أمكنك أن تخلّد اسمك
في التّاريخ لو أنّك متّ

149
00:09:36,990 --> 00:09:39,160
بعد تلقّيك لهجمةٍ من أسلوب
.السّتّة سيوف خاصّتي

150
00:09:39,160 --> 00:09:42,530
مهما كافحتم ولو انطبقت
،السّماء مع الأرض

151
00:09:42,530 --> 00:09:48,970
يستحيل عليكم أيّها البشر أن تصيبوني
!ولو بخدش، أنا، مستخدم السّيوف السّتّة

152
00:09:57,010 --> 00:10:00,410
،توقّف يا هاتشي. أفهم شعورك

153
00:10:00,410 --> 00:10:02,980
.لكن إن ثارت ثائرتك، سنقع في مأزق

154
00:10:02,980 --> 00:10:04,550
هل ستدمّر حديقة أرلونغ؟

155
00:10:06,320 --> 00:10:08,290
.لـ-لا... أنا آسف

156
00:10:08,790 --> 00:10:11,290
...انفعلتُ كثيرًا

157
00:10:11,830 --> 00:10:13,130
.لا تنجرف في حماسك

158
00:10:13,130 --> 00:10:15,260
.معك حقّ. أنا آسف

159
00:10:16,300 --> 00:10:18,970
أقلتَ أسلوب السّتّة سيوف؟
!يا للسّخف

160
00:10:29,040 --> 00:10:30,510
!أخي الكبير

161
00:10:32,710 --> 00:10:34,580
!رورونوا زورو

162
00:10:34,850 --> 00:10:37,250
.دعني أخبرك بشيءٍ أيّها الأخطبوط

163
00:10:37,820 --> 00:10:40,490
.هنالك رجلٌ أحتاج لقاءه

164
00:10:41,490 --> 00:10:43,890
...وإلى أن ألقاه ثانية

165
00:10:46,060 --> 00:10:49,960
لا يمكنني السّماح ولو لحصّاد
!الأرواح نفسه أن يحصد روحي

166
00:11:10,110 --> 00:11:12,650
!يا لذا الأنف الطّويل اللّعين! إنّه سريع

167
00:11:12,650 --> 00:11:15,450
وجه ذلك الرّجل وقدرته على
!الهرب ليسا من البشر

168
00:11:18,260 --> 00:11:21,660
إن أشغلتُ أحد قادة قراصنة
،أرلونغ هكذا

169
00:11:21,660 --> 00:11:25,260
فيجدر أن يستفيد لوفي
.والبقيّة من ذلك

170
00:11:25,530 --> 00:11:28,700
!أحسنتَ صنعًا يا أوسوبّ-ساما
!يا لمراعاتك لهم

171
00:11:28,700 --> 00:11:30,970
...مع أنّ الأمر آل هكذا من نفسه

172
00:11:32,270 --> 00:11:36,040
.كما توقّعت، لا يستطيع اللّحاق بي

173
00:11:36,040 --> 00:11:39,940
.سحقًا. هذا ليس جيّدًا
.يبدو أنّني تقدّمتُ عليه بكثير

174
00:11:40,210 --> 00:11:43,050
البرمائيّون بطيئون كالسّلاحف
،على اليابسة في النّهاية

175
00:11:43,050 --> 00:11:45,650
.سبقته بكثير بسرعة

176
00:11:46,220 --> 00:11:48,650
سلاحف...؟

177
00:11:48,650 --> 00:11:54,590
!أنت أيّتها السّلحفاة! أيّتها السّلحفاة البطيئة
!الحق بي إن استطعت

178
00:11:54,590 --> 00:11:58,430
!سأسبقك ثانية على الفور
!أيّتها السّلحفاة المترنّحة

179
00:11:58,830 --> 00:12:02,970
ألستَ من سيكون عليه أن يترنّح؟

180
00:12:05,840 --> 00:12:06,940
!مصيبة

181
00:12:06,940 --> 00:12:07,770
!توقّف أيّها الوغد

182
00:12:14,480 --> 00:12:16,080
.شرب الكثير من الماء

183
00:12:16,080 --> 00:12:18,850
علينا أن نصعد به بسرعة
.قبل فوات الأوان

184
00:12:20,750 --> 00:12:23,420
سحقًا! أظنّني لا أستطيع
.تحطيمها في البحر

185
00:12:23,420 --> 00:12:25,020
.الطّفويّة قويّة للغاية

186
00:12:25,020 --> 00:12:26,360
.غين-سان، أسرع

187
00:12:26,360 --> 00:12:28,390
.لا فائدة. لا أستطيع تحطيم الصّخرة

188
00:12:28,390 --> 00:12:31,590
أسطوانة أكسجين ستفيد
.لكنّنا لا نملك الوقت لجلبها

189
00:12:32,060 --> 00:12:35,000
...كما لا يمكننا الصّعود به والصّخرة

190
00:12:35,600 --> 00:12:36,700
!صحيح

191
00:12:59,690 --> 00:13:01,590
!لا يزال ذلك الرّجل حيًّا

192
00:13:01,590 --> 00:13:03,790
!أخي الكبير! أخي الكبير الطّبّاخ

193
00:13:04,830 --> 00:13:07,590
كانت لكمة ذلك البرمائيّ لكمة
...من الدّرجة الأربعين؟ فهمت

194
00:13:09,730 --> 00:13:12,930
إذًا، هذا يجعل من تلك الرّكلات الّتي
كنتُ أتلقّاها من ذلك العجوز اللّعين

195
00:13:12,930 --> 00:13:14,740
.ركلات من الدّرجة الأربعمائة

196
00:13:18,840 --> 00:13:20,870
ما الأمر يا رورونوا زورو؟

197
00:13:20,870 --> 00:13:24,010
،لستُ واثقًا ممّا يجري
.لكن يبدو أنّك تتألّم

198
00:13:24,010 --> 00:13:28,010
أتظنّ أنّ باستطاعتك هزيمة أسلوبي
ذي السّتّة سيوف في حالتك هذه؟

199
00:13:28,010 --> 00:13:30,880
.يظنّ الجميع في العالم نفس الشّيء

200
00:13:31,680 --> 00:13:33,350
.هذا ليس من شأنك

201
00:13:33,750 --> 00:13:36,690
!أخي الكبير في حالة يرثى لها

202
00:13:36,690 --> 00:13:39,030
لا بدّ أنّه أُصيب بحمّى من جراحه

203
00:13:39,030 --> 00:13:40,890
.وبالكاد يحافظ على وعيه

204
00:13:41,360 --> 00:13:45,560
،إن فُتحت تلك الجراح ثانية
!سيموت بالتّأكيد

205
00:13:46,000 --> 00:13:48,470
لكن هذا ليس الوقت المناسب
!للتّفكير في هكذا أمور

206
00:13:48,470 --> 00:13:52,340
نعم! إنّه الوحيد القادر
!على اجتياز هذا الوضع

207
00:13:53,310 --> 00:13:56,540
.سأريك أسلوب الثّلاثة سيوف

208
00:13:57,240 --> 00:14:00,350
!يوساكو! جوني
!دعاني أستخدم سيفيكما

209
00:14:00,680 --> 00:14:01,780
!بالطّبع

210
00:14:01,780 --> 00:14:04,320
!أخي الكبير! إليك بهما

211
00:14:04,780 --> 00:14:08,420
سحقًا! أشعر وكأنّني على وشك
!أن أغيب عن الوعي

212
00:14:08,420 --> 00:14:10,460
...أتساءل إلى متى أستطيع الوقوف

213
00:14:10,990 --> 00:14:12,720
!أخي الكبير! رمينا لك سيفينا

214
00:14:12,720 --> 00:14:14,930
!قلتَ أنّك تريد استخدامهما! أمسكهما

215
00:14:14,930 --> 00:14:19,530
سأريكم الحائط الّذي لا تستطيعون
!التّفوّق عليه أيّها البشر ذوي الذّراعين

216
00:14:19,530 --> 00:14:20,630
!أسلوب السّتّة سيوف

217
00:14:20,630 --> 00:14:22,300
!أخي الكبير! احترس

218
00:14:22,300 --> 00:14:23,570
!تحميل سيوف اللّوامس

219
00:14:23,570 --> 00:14:24,970
!أخي

220
00:14:31,140 --> 00:14:32,210
...أسلوب الثّلاثة سيوف

221
00:14:37,380 --> 00:14:39,280
!اندفاع سيوف الذّئب

222
00:14:46,390 --> 00:14:47,760
!لقد نجح

223
00:14:47,760 --> 00:14:51,090
تولّى أمر الهجمات العشوائيّة
!للسّيوف السّتّة! إنّه مذهلٌ بحقّ

224
00:14:54,530 --> 00:14:58,670
!يا له من تركيز ويا لها من قوّة روحيّة

225
00:14:58,870 --> 00:15:02,370
كيف تجرؤ على ارتكاب مثل
!هذا الفعل الوقح

226
00:15:02,370 --> 00:15:05,610
!أغضبتني حقًّا أيّها الحقير

227
00:15:05,610 --> 00:15:06,940
!سأقتلك

228
00:15:06,940 --> 00:15:09,880
يجدر بك أن تعلم بهذا بمجرّد
!التّفكير في الأمر

229
00:15:09,880 --> 00:15:12,150
،يمكنني أن أحمل ستّة سيوف
لذا يستحيل عليك أن تهزمني

230
00:15:12,150 --> 00:15:16,120
!بينما تحمل ثلاثة سيوف فحسب
!أليس كذلك؟

231
00:15:16,120 --> 00:15:20,090
بمجرّد التّفكير في الأمر؟
.يا له من سوء تقدير كبير

232
00:15:20,520 --> 00:15:23,060
ما الّذي تبتغيه بمجرّد امتلاك
القوّة أيّها الضّعيف؟

233
00:15:23,060 --> 00:15:24,260
ما العبء الّذي تحمله؟

234
00:15:25,930 --> 00:15:29,330
!سأصبح أقوى من أجلها أيضًا

235
00:15:29,670 --> 00:15:33,670
سأصبح أقوى بما يكفي
!ليبلغ اسمي السّماء

236
00:15:34,070 --> 00:15:37,270
!سأصبح السّيّاف الأقوى في العالم

237
00:15:47,420 --> 00:15:51,350
...سواءً ثلاثة سيوف
...أو ستّة سيوف

238
00:15:53,290 --> 00:15:55,690
!فذلك لا يهمّ

239
00:15:58,030 --> 00:16:03,160
!ثقل سيوفنا مختلف

240
00:16:19,210 --> 00:16:20,410
أقلتَ ثقل؟

241
00:16:21,320 --> 00:16:25,020
.فهمت. إذًا، سيوفك ثقيلة

242
00:16:25,020 --> 00:16:27,690
لكنّ وزن سيوفي ثلاثمائة كيلوغرام
للسّيف الواحد على الأقلّ

243
00:16:27,690 --> 00:16:29,320
.ومع أنّ ذلك لا يبدو عليها

244
00:16:29,320 --> 00:16:34,090
وزنها أكبر بكثير من وزن
!سيوفكم أيّها البشر الأوغاد

245
00:16:35,430 --> 00:16:37,800
.لا طائل من مناقشة غبيّ

246
00:16:37,800 --> 00:16:40,270
:أسلوب السّتّة سيوف
!وقفة وعاء الأخطبوط

247
00:16:40,730 --> 00:16:41,630
...السّنة الجديدة

248
00:16:44,540 --> 00:16:45,510
!افتحي

249
00:16:47,940 --> 00:16:48,940
!ارتطام الجسد

250
00:16:50,080 --> 00:16:52,180
!هذه دناءة! ضربه في جراحه

251
00:16:52,180 --> 00:16:53,410
!سيلقّنك هذا

252
00:16:53,410 --> 00:16:54,450
!أخي الكبير

253
00:16:54,450 --> 00:16:55,750
!سيموت

254
00:16:56,050 --> 00:16:58,080
!لن أدعك تهبط وأنت حيّ

255
00:16:58,080 --> 00:16:59,920
:المهارة المطلقة للسّتّة سيوف

256
00:16:59,920 --> 00:17:01,620
!والتز السّتّة سيوف

257
00:17:02,090 --> 00:17:06,330
ستغدو لحمًا مفرومًا إن لمستها
!ولو للحظة! فلتصبح لحمًا مفرومًا

258
00:17:06,990 --> 00:17:07,960
!أخي الكبير

259
00:17:14,970 --> 00:17:15,870
!ماذا؟

260
00:17:15,870 --> 00:17:17,570
!هذا مؤلم

261
00:17:17,570 --> 00:17:18,970
!أخي الكبير

262
00:17:27,810 --> 00:17:32,520
ذاك الوغد! التفّ على سيوفي
!متكيّفًا مع الدّوران

263
00:17:32,520 --> 00:17:35,720
وفوق ذلك، أعطاني خدمة
!قطع أيادي مجّانيّة

264
00:17:35,720 --> 00:17:38,990
!كيف يجرؤ على السّخريّة منّي؟
!لستُ أخطبوط سيرك

265
00:17:38,990 --> 00:17:41,490
!أنا ساخط الآن
!لن أدعه يُفلت بفعلته

266
00:17:41,490 --> 00:17:43,260
!سأقتله بكلّ تأكيد

267
00:17:52,670 --> 00:17:55,270
...أخي الكبير... يبدو أنّه يتألّم بشدّة

268
00:17:55,640 --> 00:17:59,140
.ربّما انفتحت جراحه وقعَ ذلك الهجوم

269
00:17:59,140 --> 00:18:02,950
...يا ليتني أتألّم محلّه

270
00:18:04,180 --> 00:18:10,720
حتّى إن كانت إصابةً تُفقد وعي
!النّاس العاديّين، لا يجب أن أسقط

271
00:18:13,890 --> 00:18:16,660
:أسلوب السّتّة سيوف
!وقفة وعاء الأخطبوط

272
00:18:16,660 --> 00:18:18,090
!انتهى كلّ شيء

273
00:18:19,300 --> 00:18:25,270
حتّى إن كانت إصابةً تقتُل النّاس
!العاديّين، لا يجب أن أموت

274
00:18:25,270 --> 00:18:26,240
...السّنة الجديدة

275
00:18:28,070 --> 00:18:30,810
،لأجل أن أهزم عين الصّقر الاستثنائيّ

276
00:18:31,810 --> 00:18:34,180
!لا يجب أن أكون عاديًّا

277
00:18:40,720 --> 00:18:42,690
!إعصار التنّين

278
00:19:01,770 --> 00:19:02,870
...هاتشي

279
00:19:04,210 --> 00:19:11,650
...كيف يُعقل... أن أُهزم
أمام أسلوب ثلاثة سيوف؟

280
00:19:17,450 --> 00:19:18,820
...أيّها الرّجل الأخطبوط

281
00:19:19,750 --> 00:19:26,130
بتّ تعرف الآن الاختلاف
في الوزن بين سيوفنا، صحيح؟

282
00:19:26,990 --> 00:19:28,630
هل أنت سعيد الآن؟

283
00:19:49,520 --> 00:19:54,120
.بكيتُ بقدر ما أريد
.ونُحتُ بما يكفي أيضًا

284
00:19:56,760 --> 00:19:58,220
!وأنا عازمة أيضًا

285
00:20:00,190 --> 00:20:03,660
!يجب أن أذهب. الجميع يقاتلون

286
00:20:16,840 --> 00:20:19,380
آسف، لكنّي لا أكترث
.لذلك الرّجل الأخطبوط

287
00:20:20,380 --> 00:20:22,880
...عليّ أن أسرع وأُنقذ لوفي

288
00:20:22,880 --> 00:20:24,350
!أخي الكبير! احترس

289
00:20:24,350 --> 00:20:26,350
!كيف تجرؤ على هزيمة هاتشي؟

290
00:20:27,920 --> 00:20:29,050
...أنت

291
00:20:29,760 --> 00:20:32,190
!عصفتَ بي في السّماء حقًّا

292
00:20:32,560 --> 00:20:36,860
ماذا؟ لم أتوقّع أنّه يوجد أحد

293
00:20:36,860 --> 00:20:39,160
.في الأزرق الشّرقيّ يستطيع النّجاة من قبضتي

294
00:20:39,700 --> 00:20:44,640
...بل هنالك الكثير على الأغلب
.ولا سيّما في مطعمٍ معيّن

295
00:20:46,240 --> 00:20:48,340
أنت تستخفّ بي حقًّا، أليس كذلك؟

296
00:20:53,580 --> 00:20:55,710
!أ-أخي الكبير! هذا متهوّر

297
00:20:55,710 --> 00:20:56,950
!أنت، توقّف

298
00:20:57,250 --> 00:21:00,380
!ستموت إن نزلت إلى البحر بتلك الجراح

299
00:21:00,790 --> 00:21:04,090
!اخرس! لقد وصل إلى حدّه

300
00:21:04,520 --> 00:21:06,660
!لا نملك الوقت لانتظار حتّى تُنهي قتالك

301
00:21:06,660 --> 00:21:08,260
.نعم، أعلم

302
00:21:08,730 --> 00:21:11,330
.أعلم أنّنا لا نملك وقتًا نضيّعه

303
00:21:11,330 --> 00:21:13,660
إنّي أحاول أن أوقفك وأنا مدركٌ
!لذلك تمام الإدراك

304
00:21:13,660 --> 00:21:15,730
!اخرس فحسب أيّها الأحمق

305
00:21:15,970 --> 00:21:17,940
!لا يمكنك أن تشتكي إن فعلتُ هذا، صحيح؟

306
00:21:20,400 --> 00:21:21,710
!هذا مثيرٌ للاهتمام

307
00:21:21,710 --> 00:21:23,840
هل يريد أن يقاتل برمائيًّا مثلي في الماء؟

308
00:21:23,840 --> 00:21:25,110
!يا له من غبيّ

309
00:21:25,380 --> 00:21:30,310
!هذا تهوّر! القتال في الماء هو ما يريدونه

310
00:21:41,790 --> 00:21:44,630
،إلّم تخنّي الذّاكرة
...إنّه من قرية كوكوياشي

311
00:21:45,530 --> 00:21:48,730
!عنقه! عنق لوفي ممدّد

312
00:21:51,330 --> 00:21:54,140
آسفة، لستُ قويّةً بما يكفي
!لسحب جسدك بكامله

313
00:21:54,140 --> 00:21:58,010
.ابصق الماء ورقبتك ممدودة
!تنفّس على الأقل رجاءً

314
00:21:58,270 --> 00:22:00,710
!عُد إلى الوعي
!آمل أنّه لم يفت الأوان بعد

315
00:22:00,710 --> 00:22:02,980
من الأفضل أن أسرع قبل
.ألاّ أستطيع كبح أنفاسي

316
00:22:03,510 --> 00:22:06,320
،فهمت... لا يستطيع تحطيم الصّخرة

317
00:22:06,320 --> 00:22:09,990
،لكن إن كان عنق لوفي ممتدًّا خارج الماء
.بإمكانه أن يتنفّس على الأقل

318
00:22:09,990 --> 00:22:14,960
ما يعني أنّني إن استطعتُ ركل وتحطيم تلك
.الصّخرة، يمكنني أن أترك الباقي لذلك الرّجل

319
00:22:15,820 --> 00:22:19,030
!كاراتيه البرمائيّين... مزلجة السّاعد

320
00:22:25,530 --> 00:22:30,640
!فلتُدرك أنّكم مجرّد بشر

321
00:22:39,380 --> 00:22:40,880
!عد إلى الوعي

322
00:22:44,950 --> 00:22:47,250
!رجاءً... بسرعة

323
00:22:50,560 --> 00:22:53,060
!هذا الشّخص عنيد

324
00:22:57,000 --> 00:23:01,840
مشاعري الجيّاشة لا تتّصل

325
00:23:01,840 --> 00:23:06,670
بينما أشدّ على يدك بثبات

326
00:23:06,670 --> 00:23:11,580
،سأشدّ الشّراع بنفسي

327
00:23:11,580 --> 00:23:17,250
لذا واصل مشاهدتي
باهتمام بينما أبتعد

328
00:23:21,550 --> 00:23:26,760
كان يجول هذا في ذهني قليلًا
منذ هذا الصّباح

329
00:23:26,760 --> 00:23:31,360
لمَ الجوّ حار؟

330
00:23:31,360 --> 00:23:41,670
،بدءًا من تلك النّقطة
لم أستطع التّهرّب من ذلك

331
00:23:42,670 --> 00:23:47,680
أريد أن أمسك تلك المشاعر
،الّتي رحلت بسرعة

332
00:23:47,680 --> 00:23:52,520
حتّى أنّني مستعدّ لأباغت نفسي

333
00:23:52,520 --> 00:23:57,560
أريد أن أعانق أحلامي
الّتي قفزت من صدري

334
00:23:57,560 --> 00:24:02,660
معك، أستطيع الرّكض إلى هناك

335
00:24:11,240 --> 00:24:12,300
!مصيبة

336
00:24:12,300 --> 00:24:14,870
!سحقًا! ذاك الوغد ذو ربطة الشّعر
!إنّه يهاجمني من الخلف

337
00:24:15,310 --> 00:24:16,340
!هذا سيّئ

338
00:24:16,340 --> 00:24:18,040
...لكن لأجل إنقاذ لوفي

339
00:24:18,040 --> 00:24:20,780
،حتّى إن كنتُ في موقفٍ غير مؤاتٍ
!سأهزمه بكلّ تأكيد

340
00:24:20,780 --> 00:24:22,310
.كلّ هذا لأجل نامي-سان

341
00:24:22,310 --> 00:24:23,650
!إذًا، هذا ما تفكّر فيه في النّهاية

342
00:24:23,650 --> 00:24:24,580
!مصيبة

343
00:24:24,980 --> 00:24:26,650
!اخرس

344
00:24:26,650 --> 00:24:27,990
:في الحلقة القادمة من ون بيس

345
00:24:27,990 --> 00:24:31,320
!محاربون فخورون"
".معركتا سانجي وأوسوبّ الضّاريتان

346
00:24:31,320 --> 00:24:33,360
!ملك القراصنة، لن يكون إلاّ أنا