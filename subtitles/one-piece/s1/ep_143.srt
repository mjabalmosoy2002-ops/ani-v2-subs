1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:10,550 --> 00:02:14,930
!وهكذا تبدأ الأسطورة"
".الجانب الآخر من قوس قزح

22
00:02:29,540 --> 00:02:32,910
.أبي، حصادنا أكبر ممّا توقّعنا

23
00:02:34,010 --> 00:02:38,020
!خذوه! لا تتركوا أيّ قطعة من الكنوز

24
00:02:42,120 --> 00:02:43,150
!هجوم

25
00:02:44,420 --> 00:02:45,390
!رفاق

26
00:02:45,390 --> 00:02:46,660
!لا تتهوّروا

27
00:02:47,020 --> 00:02:49,860
!هذه منطقة قراصنة اليقطين

28
00:02:49,860 --> 00:02:52,700
ويقع على عاتقنا حمايتها
!إلى حين عودة رابا نوي

29
00:02:53,030 --> 00:02:53,630
!أيّها الأستاذ

30
00:02:54,200 --> 00:02:56,930
!أنا أحد قراصنة اليقطين أيضًا

31
00:02:56,930 --> 00:02:58,570
!سأقاتل إلى جانبكم

32
00:02:58,570 --> 00:03:00,140
!سأساعدك أيّها العمّ

33
00:03:02,040 --> 00:03:02,840
!أيّها الأستاذ

34
00:03:02,840 --> 00:03:04,680
!نالوا منّي

35
00:03:08,880 --> 00:03:12,050
كيف يعقل أن تواجهوا
!مشاكل مع أولئك الأطفال؟

36
00:03:13,050 --> 00:03:14,620
!...وـ-ويتّون

37
00:03:14,620 --> 00:03:16,590
!ما زال صغيرًا كما كان

38
00:03:16,920 --> 00:03:20,830
.كلاّ. في الواقع، أنا حفيد ويتّون، ليك

39
00:03:20,830 --> 00:03:21,960
هل أشبهه حقًّا؟

40
00:03:21,960 --> 00:03:23,490
.نعم، تشبهه تمامًا

41
00:03:23,490 --> 00:03:27,570
هكذا إذًا؟ كان جدّي وسيمًا مثلي إذًا؟

42
00:03:27,930 --> 00:03:29,500
ما قصّته؟

43
00:03:29,500 --> 00:03:30,530
.إنّه غريب الأطوار

44
00:03:31,140 --> 00:03:34,070
!سلّموني كنزكم بهدوء وبلا مقاومة

45
00:03:34,070 --> 00:03:37,010
وإن رفضتم، سأحرقكم حرقًا
!ببذلة الصّدمة الكهربائيّة خاصّتي

46
00:03:37,010 --> 00:03:39,510
!احترسوا! إنّه يستخدم الكهرباء

47
00:03:40,310 --> 00:03:41,450
الكهرباء إذًا؟

48
00:03:42,010 --> 00:03:45,280
!كنتُ متشوّقًا للاهتياج أيضًا

49
00:03:45,720 --> 00:03:50,390
سأتلقّى كهربائك وأقطعها
!إلى شطرين بسيفي

50
00:03:50,390 --> 00:03:53,090
.كلاّ، لا يُمكن قطع الكهرباء بالسّيف

51
00:03:53,660 --> 00:03:56,060
.سيكون ذلك شيّقًا. جرّب حظّك

52
00:03:57,090 --> 00:03:58,700
.كنتُ آمل أن تقول ذلك

53
00:04:07,510 --> 00:04:09,110
هدأ الوضع...؟

54
00:04:09,110 --> 00:04:11,010
.نعم... هدأ

55
00:04:11,340 --> 00:04:12,840
هل تظنّ أنّ الجميع بخير؟

56
00:04:12,840 --> 00:04:13,810
من يدري؟

57
00:04:13,810 --> 00:04:16,850
!"لا تقل "من يدري

58
00:04:16,850 --> 00:04:19,050
!ألست قلقًا بشأن الجميع؟

59
00:04:19,380 --> 00:04:21,490
.ليسوا بحاجة لقلقنا

60
00:04:21,950 --> 00:04:25,960
بالأحرى، أنا قلق ما إن كان
.ذلك المحافظ اللّعين سيعود حيًّا

61
00:04:27,630 --> 00:04:30,530
إن تكفّل لوفي والبقيّة بأمر
،ذلك المحافظ اللّعين

62
00:04:30,530 --> 00:04:32,300
.فلن أستطيع الثّأر منه

63
00:04:32,300 --> 00:04:35,130
.صحيح... ثمّة تلك المسألة أيضًا

64
00:04:35,730 --> 00:04:36,530
هل ستأتي؟

65
00:04:36,530 --> 00:04:38,800
.نعم. لنذهب

66
00:04:39,940 --> 00:04:45,710
!غومو غومو نوو: الصّاروخ

67
00:04:46,640 --> 00:04:47,510
ما كان ذلك؟

68
00:04:53,980 --> 00:04:55,950
.عجبًا، توقّفنا

69
00:04:55,950 --> 00:04:57,590
!ا-القائد

70
00:05:00,760 --> 00:05:03,490
...يـ-يا جرأتك

71
00:05:03,490 --> 00:05:06,030
بأن تدخل إلى ضباب قوس
!قزح دون إذني

72
00:05:06,330 --> 00:05:09,330
عليك أن تدفع 50 مليون بيري
!"كضريبةٍ على "الدّخول بلا إذن

73
00:05:09,330 --> 00:05:09,830
.لا أريد

74
00:05:09,830 --> 00:05:11,140
!ماذا؟

75
00:05:11,140 --> 00:05:14,340
!أتقصد أنّك لن تمتثل لأوامر ويتّون-ساما؟

76
00:05:14,340 --> 00:05:16,470
!ويتّون؟ أهذا أنت؟

77
00:05:16,470 --> 00:05:21,450
صحيح. أنا محافظ لولوكا
!العظيم والفخور، ويتّون

78
00:05:21,450 --> 00:05:24,620
،ماذا؟ أنت الّذي كنتَ قرصانًا
!أصبحت محافظًا الآن؟

79
00:05:24,620 --> 00:05:26,520
ماذا؟ أهذا خاطئ؟

80
00:05:26,520 --> 00:05:30,020
!أ-أيّها القائد، إنّه هو
!إنّه الشّخص الّذي سرق سفينتنا

81
00:05:30,020 --> 00:05:30,550
ماذا؟

82
00:05:34,630 --> 00:05:37,090
أ-أنت ذلك الصّبيّ؟

83
00:05:37,530 --> 00:05:40,660
،أنت الّذي أحرق البلدة
!صرتَ محافظًا؟

84
00:05:40,660 --> 00:05:43,130
!لا أقبل هذا! يستحيل أن أقبل هذا

85
00:05:43,400 --> 00:05:44,400
!أطبق فمك

86
00:05:45,300 --> 00:05:46,070
!رابا نوي

87
00:05:48,340 --> 00:05:51,380
.يا فتى، عمل المحافظ جميل

88
00:05:51,380 --> 00:05:57,080
يمكنني البقاء في مكتبي وجمع الأموال
.الّتي اختلستها من أهل البلدة الأغبياء

89
00:05:57,080 --> 00:05:59,250
لستُ بحاجة لأجوب البحار
،بحثًا عن فريستي

90
00:05:59,250 --> 00:06:01,290
!ولا أن تطاردني البحريّة

91
00:06:01,290 --> 00:06:03,450
.أعيش كلّ يوم بنعيم وهناء

92
00:06:03,450 --> 00:06:05,620
!لا تجارة أسهل من هذه

93
00:06:05,990 --> 00:06:10,960
إن وُلدتَ من جديد، عليك أن
.تحاول كسب القوّة كما فعلتُ أنا

94
00:06:10,960 --> 00:06:15,100
!فلا فائدة من العيش كقرصان تافه

95
00:06:17,370 --> 00:06:18,840
!اخرس

96
00:06:20,940 --> 00:06:21,740
!أيّها القائد

97
00:06:21,740 --> 00:06:22,310
!أبي

98
00:06:28,710 --> 00:06:31,280
!أيّها الـ...! ما الّذي تفعله؟

99
00:06:32,950 --> 00:06:36,350
.لا تعرف ما هو القرصان الحقيقيّ

100
00:06:36,620 --> 00:06:37,320
ماذا؟

101
00:06:38,690 --> 00:06:39,920
...لوفي

102
00:06:40,690 --> 00:06:42,690
.لا حاجة لنا بالقوّة

103
00:06:42,690 --> 00:06:45,900
.نحن القراصنة نملك حلمًا قبل كلّ شيء

104
00:06:47,060 --> 00:06:48,230
أقلتَ حـ-حُلمًا؟

105
00:06:54,410 --> 00:06:58,910
!بذلة الصّدمة الكهربائيّة خاصّتي لا تُقهر
!لا يمكنك أن تهرب منها

106
00:06:58,910 --> 00:07:00,980
أهرب؟ من؟ أنا؟

107
00:07:00,980 --> 00:07:04,620
!أخبرتك أنّني سأقطع كهربائك إلى نصفين

108
00:07:04,880 --> 00:07:08,350
كما أخبرتك، أين المنطق
!في محاولة قطع الكهرباء؟

109
00:07:08,350 --> 00:07:09,520
هل أقطعها؟

110
00:07:10,320 --> 00:07:12,820
!خذ هذه! الرّعد الجيّاش

111
00:07:15,260 --> 00:07:17,500
!ماذا؟ ما الّذي يجري هنا؟

112
00:07:17,730 --> 00:07:21,900
يبدو أنّ بذلته الّتي يفتخر بها
.تصبح بلا نفع بمجرّد انتزاع القابس

113
00:07:22,600 --> 00:07:26,270
!سحقًا! كيف يُعقل حدوث هذا؟
!أعده! أعده أيّها الوغد

114
00:07:26,270 --> 00:07:28,470
!أيّها النّذل! هذا ليس عدلاً

115
00:07:29,610 --> 00:07:32,910
!ساعدني! إنّي أغرق! إنّي أغرق
!لا يمكنني فتح القمرة

116
00:07:33,610 --> 00:07:34,910
!دعني أقطع شيئًا

117
00:07:40,550 --> 00:07:43,820
!أقلتَ حلمًا؟ ما هو؟ أخبرني

118
00:07:43,820 --> 00:07:46,260
.الجميع يعلمون ما هو حلمكم

119
00:07:46,620 --> 00:07:49,330
تريدون فقط اكتساب الغِنى
.والذّهب والفضّة

120
00:07:49,330 --> 00:07:53,460
سيأتي كلّ ذلك إلى حضنك
.فور أن تملك السّلطة

121
00:07:54,300 --> 00:07:59,440
حلم القرصان هو أن يكون
.أعظم رجل في البحار

122
00:08:02,640 --> 00:08:05,110
!أنا الرّجل الّذي سيصبح ملك القراصنة

123
00:08:06,310 --> 00:08:07,680
...لوفي

124
00:08:08,650 --> 00:08:09,380
...سحقًا

125
00:08:14,390 --> 00:08:17,760
!لم يتحدّاني أحد وعاش ليرى نور الغد

126
00:08:17,760 --> 00:08:19,420
!سأعصف بكَ عصفًا

127
00:08:19,420 --> 00:08:20,660
!انتظر أيّها القائد

128
00:08:20,660 --> 00:08:22,590
!أبي، ماذا عنّي؟

129
00:08:22,590 --> 00:08:23,990
!وما همّي؟

130
00:08:24,660 --> 00:08:25,830
!أيّها القائد

131
00:08:33,140 --> 00:08:35,310
ما ذلك؟ ما الّذي يجري؟

132
00:08:43,610 --> 00:08:45,120
!...برج قوس قزح

133
00:08:45,120 --> 00:08:46,320
...إنّه ينهار

134
00:08:57,290 --> 00:08:59,730
سحقًا، ما الّذي يجري؟

135
00:09:00,260 --> 00:09:01,700
!إنّه يتخلّى عنّا

136
00:09:02,070 --> 00:09:03,700
!ويتّون، أيّها الوغد

137
00:09:03,700 --> 00:09:07,570
!ما عدتَ القائد، سحقًا

138
00:09:08,640 --> 00:09:09,270
!لوفي

139
00:09:09,640 --> 00:09:10,770
!رابا نوي

140
00:09:10,770 --> 00:09:12,480
!إنّه رابا نوي

141
00:09:12,480 --> 00:09:13,810
!لقد عاد

142
00:09:13,810 --> 00:09:15,750
!حمدًا للرّب! إنّه رابا نوي

143
00:09:15,750 --> 00:09:18,680
!لقد أقلقني جدًّا

144
00:09:19,220 --> 00:09:22,390
تبًّا، كيف لشخصٍ أن يكون
مزعجًا بهذا القدر؟

145
00:09:23,450 --> 00:09:24,520
مـ-ما ذلك؟

146
00:09:28,260 --> 00:09:29,430
!...لا يمكن

147
00:09:29,430 --> 00:09:30,490
الأستاذ؟

148
00:09:30,490 --> 00:09:35,100
كانت "حفلة القرد" مستقرّة
.على توازن دقيق في الأساس

149
00:09:35,100 --> 00:09:38,100
،إن حدث انفجار كبير في مكان كهذا

150
00:09:38,100 --> 00:09:40,470
!لا ندري ما قد يحدث

151
00:09:43,610 --> 00:09:44,810
!ما ذلك؟

152
00:09:44,810 --> 00:09:47,780
!إنّ تشوّه الفضاء يتّسع بسرعة

153
00:09:47,780 --> 00:09:51,120
!على هذا الحال، سنعلق به ونموت جميعًا

154
00:09:51,120 --> 00:09:52,080
!ماذا؟

155
00:09:52,820 --> 00:09:55,350
...كيف حدث هذا؟ برج قوس قزح

156
00:09:57,450 --> 00:09:59,660
.غرق تمامًا

157
00:10:03,490 --> 00:10:07,730
،سحقًا، لم يكن ناقصًا فحسب
.بل ولم يكن محصّنًا كفايةً أيضًا

158
00:10:07,730 --> 00:10:09,230
.لكن لا يهمّ

159
00:10:09,900 --> 00:10:12,400
.لن يلاحقني رجالي الآن

160
00:10:12,400 --> 00:10:15,070
!الكنز لي وحدي

161
00:10:33,230 --> 00:10:35,070
!السّماء تهوي

162
00:10:35,300 --> 00:10:38,300
.لا يوجد وقت. ربّما ساعة

163
00:10:38,300 --> 00:10:40,340
!هذا سيّئ! علينا الخروج من هنا

164
00:10:40,340 --> 00:10:42,310
لكن كيف؟

165
00:10:43,340 --> 00:10:47,180
لقد زار مؤلّف هذا الكتاب
.حفلة القرد" مرّةً"

166
00:10:47,180 --> 00:10:49,550
لا بدّ أنّه دوّن طريقة
.الخروج من هنا أيضًا

167
00:10:50,210 --> 00:10:51,450
ما الخطب؟

168
00:10:52,280 --> 00:10:54,120
".يُتبع في المجلّد الأخير"

169
00:10:54,450 --> 00:10:55,820
وأين هو؟

170
00:10:56,620 --> 00:10:58,120
!لا تملكينه؟

171
00:10:59,960 --> 00:11:01,190
ما ذلك؟

172
00:11:01,490 --> 00:11:02,830
ماذا؟ ما الخطب؟

173
00:11:02,830 --> 00:11:04,700
!لوفي، ذلك الضّوء

174
00:11:05,700 --> 00:11:07,130
...إنّه ضوء الشّمس

175
00:11:07,130 --> 00:11:08,100
!ضوء الغروب

176
00:11:08,100 --> 00:11:09,170
الغروب؟

177
00:11:09,170 --> 00:11:13,140
نعم. إنّ ضوء الشّمس يشعّ
!من خلال صدعٍ في الفضاء

178
00:11:13,470 --> 00:11:16,340
.تبعنا ذلك الضّوء وخرجنا

179
00:11:16,340 --> 00:11:17,480
!حـ-حقًّا؟

180
00:11:17,480 --> 00:11:21,080
بسرعة! قد يختفي
!ذلك الضّوء في أيّ لحظة

181
00:11:21,080 --> 00:11:24,520
!افردوا الأشرعة
!جدّفوا بأقصى طاقتكم جميعًا

182
00:11:25,120 --> 00:11:27,350
!تعالوا أيضًا! ساعدونا

183
00:11:27,350 --> 00:11:28,520
!سنخرج من هنا

184
00:11:28,520 --> 00:11:29,320
...حـ-حسنًا

185
00:11:39,560 --> 00:11:41,430
!أنتم، ماذا تفعلون؟! جدّفوا جيّدًا

186
00:11:41,430 --> 00:11:43,170
!إنّنا نفعل ذلك بالفعل

187
00:11:51,640 --> 00:11:52,880
!لقد تحطّمت

188
00:11:52,880 --> 00:11:53,880
!ما الّذي تفعله؟

189
00:11:53,880 --> 00:11:55,350
!سحقًا، لا فائدة

190
00:11:55,350 --> 00:11:57,880
!هذا سيّئ! بدأ الضّوء يختفي

191
00:11:58,520 --> 00:12:00,050
...هذه النّهاية إذًا

192
00:12:00,050 --> 00:12:01,890
!اخرجوا وادفعونا من الخلف

193
00:12:01,890 --> 00:12:02,690
!لا تهذِ

194
00:12:02,920 --> 00:12:05,260
...إن سبحنا برفرفة جميعًا، ربّما يمكننا

195
00:12:05,260 --> 00:12:06,020
!لن نفعل

196
00:12:06,660 --> 00:12:08,990
...لو أنّ ريحًا خلفيّة تدفعنا فحسب

197
00:12:10,430 --> 00:12:11,960
نحتاج هبوب الرّياح فحسب، صحيح؟

198
00:12:12,500 --> 00:12:14,670
!انتظر! ماذا ستفعل؟

199
00:12:14,670 --> 00:12:16,630
!فجّروا سفينتنا

200
00:12:17,640 --> 00:12:19,800
.كانت سفينة بحريّة في الأساس

201
00:12:19,800 --> 00:12:21,470
.إنّها مدجّجة بالقذائف المدفعيّة

202
00:12:21,470 --> 00:12:25,010
إن أشعلناها، يجدر أن تمنحكم
.رياحًا عكسيّة قويّة كفايةً

203
00:12:25,010 --> 00:12:26,040
!لا يمكنك

204
00:12:26,040 --> 00:12:29,350
!انتظر يا رابا نوي
...إن فعلت ذلك، ما الّذي

205
00:12:29,350 --> 00:12:31,580
!سيحلّ بك؟

206
00:12:33,850 --> 00:12:38,220
هذا كنزي أنا! أنا! لهذا لا يمكنني
!أن أتنحّى عن كوني محافظًا

207
00:12:47,970 --> 00:12:52,140
أنت، يفترض أنّ أصدقائنا
.داخل الضّباب

208
00:12:52,140 --> 00:12:56,110
ماذا حدث؟ لا تقل
.أنّك الوحيد الّذي عاد

209
00:12:57,680 --> 00:12:58,740
!ماذا هناك؟

210
00:13:04,020 --> 00:13:05,480
!أنت، انتظر

211
00:13:14,130 --> 00:13:15,290
!رابا نوي

212
00:13:15,290 --> 00:13:17,430
!رفاق! إلى أين ذاهبون؟! عودوا

213
00:13:17,430 --> 00:13:19,830
!نحن قراصنة اليقطين

214
00:13:19,830 --> 00:13:22,830
نحن أصدقاء أقسموا أن يظلّوا
!سويًّا حتّى الموت

215
00:13:23,470 --> 00:13:24,540
...رفاق

216
00:13:25,140 --> 00:13:28,470
!لقد اندفع رابا نوي لإنقاذكم

217
00:13:28,470 --> 00:13:30,370
!لا تدعوا ما فعله يذهب هباءً

218
00:13:30,370 --> 00:13:31,480
!هل تحاولون أن تُقتلوا سويًّا؟

219
00:13:32,880 --> 00:13:34,450
!لن نموت

220
00:13:35,280 --> 00:13:38,550
!هينزو، أعدك أنّنا سنعود

221
00:13:38,550 --> 00:13:41,620
!مهما مرّ من عام، سنعود إلى لولوكا

222
00:13:42,920 --> 00:13:43,990
...إيسوكا

223
00:13:44,760 --> 00:13:49,030
إ-إيّاكما أن تظنّا أنّكما
!لن تُجازيا على ضرب المحافظ

224
00:13:49,030 --> 00:13:52,030
سيكون عليكما دفع 90 مليون
!"بيري كضريبةٍ لـ"ضرب المحافظ

225
00:13:52,030 --> 00:13:53,560
هل أنتما راضيان؟

226
00:13:53,560 --> 00:13:55,830
.لا يهمّني ذلك

227
00:13:58,070 --> 00:13:59,940
.سأتخلّف عن دفعها في النّهاية

228
00:13:59,940 --> 00:14:02,470
!ماذا؟ دفع الضّرائب واجب المواطنين

229
00:14:02,910 --> 00:14:05,710
كيف يلزم على القرصان
دفع الضّرائب؟

230
00:14:05,710 --> 00:14:07,580
...فـ-في الواقع

231
00:14:07,580 --> 00:14:08,450
!سانجي

232
00:14:08,950 --> 00:14:11,280
!ضباب قوس قزح يختفي

233
00:14:11,280 --> 00:14:11,780
ماذا؟

234
00:14:14,250 --> 00:14:17,090
ماذا سيحلّ بلوفي والبقيّة؟

235
00:14:18,360 --> 00:14:21,660
!والآن، لا يمكن لأيّ منهم أن يرجع! أبدًا

236
00:14:21,660 --> 00:14:28,430
!مهما حاولتما فعله، قوّتي ثابتة

237
00:14:46,720 --> 00:14:47,590
!ما ذلك؟

238
00:14:48,190 --> 00:14:48,990
!ماذا؟

239
00:14:48,990 --> 00:14:50,090
!ما الّذي...؟

240
00:15:23,020 --> 00:15:24,490
!سفينة ميري

241
00:15:24,490 --> 00:15:26,490
أهم بخير؟

242
00:15:32,530 --> 00:15:33,860
!قصري

243
00:15:36,830 --> 00:15:39,800
!كلّ ممتلكاتي تنجرف

244
00:15:56,220 --> 00:15:57,720
!رفاق

245
00:15:56,220 --> 00:15:57,720
!نامي-سان

246
00:15:57,720 --> 00:16:00,090
!سحقًا، كيف يُعقل هذا؟
!...سفينتي الغالية

247
00:16:00,090 --> 00:16:01,890
!سانجي، لم أرك منذ وقت طويل

248
00:16:01,890 --> 00:16:03,160
!نامي-سوان

249
00:16:03,790 --> 00:16:04,800
!لِمَ فعلت ذلك؟

250
00:16:04,800 --> 00:16:06,730
!تبًّا، أنا غاضبة

251
00:16:06,730 --> 00:16:08,730
لماذا يا نامي-سان؟

252
00:16:09,230 --> 00:16:13,070
لقد عُصف كلّ الكنز الّذي تركته
.على سطح السّفينة

253
00:16:13,070 --> 00:16:15,470
.من الأفضل ألاّ تقترب منها حاليًّا

254
00:16:17,410 --> 00:16:19,640
!هذا حدّكم أيّها القراصنة

255
00:16:19,640 --> 00:16:20,510
!البحريّة

256
00:16:20,510 --> 00:16:22,880
!نفس الّذين كانوا يلاحقوننا

257
00:16:24,850 --> 00:16:26,620
!النّجدة

258
00:16:26,620 --> 00:16:30,320
هؤلاء الأشخاص مجرمون شنيعون
!سلبوا كلّ ممتلكات المحافظ

259
00:16:31,760 --> 00:16:34,660
،هذا خاتم الأميرة إلوشيا

260
00:16:34,660 --> 00:16:38,900
إحدى الكنوز الّتي سرقها القراصنة
.قبل مائة عام وظلّت مختفية

261
00:16:38,900 --> 00:16:40,130
لِمَ هو معك؟

262
00:16:40,130 --> 00:16:41,670
...فـ-في الواقع

263
00:16:41,670 --> 00:16:43,870
لم تسرقه، أليس كذلك؟

264
00:16:43,870 --> 00:16:48,340
لا، بالطّبع لا! لقد كان بين الكنوز
!"الرّاقدة في "حفلة القرد

265
00:16:48,340 --> 00:16:52,180
صحيح، صحيح، أخرجناه
!من سفينة محطّمة فحسب

266
00:16:52,180 --> 00:16:56,150
.فهمت. تقصدان أنّه لا ينتمي لأيّ أحد

267
00:16:56,150 --> 00:16:56,950
!ماذا؟

268
00:16:56,950 --> 00:16:59,780
أيّها الرّائد، لقد وجدنا
كومةً كبيرةً من الذّهب

269
00:16:59,780 --> 00:17:01,820
.نعتقد أنّها جُرفت من هناك

270
00:17:01,820 --> 00:17:04,920
.حسنًا، ستُصادره البحريّة كلّه

271
00:17:04,920 --> 00:17:08,360
!انتظروا! لن أدعكم تلمسون ذلك الكنز

272
00:17:08,360 --> 00:17:10,360
!إنّه كنزي

273
00:17:10,360 --> 00:17:13,560
.أيّ كنز دون مالك يعود إلى حكومة العالم

274
00:17:13,560 --> 00:17:17,270
!وإن تمّ اختلاسه، سيُعتبر قرصنة

275
00:17:17,270 --> 00:17:20,070
!لا أمانع! أنا قرصان من الأساس

276
00:17:20,070 --> 00:17:22,240
!آخذ كلّ ما أريده بالقوّة

277
00:17:22,240 --> 00:17:23,770
!احترس

278
00:17:24,640 --> 00:17:26,940
.سأعتبر هذا اعترافًا منك

279
00:17:26,940 --> 00:17:29,180
ألا بأس يا ويتّون القرصان؟

280
00:17:29,180 --> 00:17:30,150
!ماذا؟

281
00:17:38,020 --> 00:17:40,320
...لا يُعقل أنّك

282
00:17:44,400 --> 00:17:46,000
...رابا نوي

283
00:17:46,000 --> 00:17:47,330
!لا يمكن

284
00:17:47,330 --> 00:17:50,370
وعدتك أنّنا سنعود، أليس كذلك؟

285
00:17:50,370 --> 00:17:51,940
!إيسوكا؟

286
00:17:52,500 --> 00:17:55,010
.اعتقلوا كلّ أفراد عصابة ويتّون

287
00:17:55,010 --> 00:17:55,840
.حاضر

288
00:18:00,340 --> 00:18:04,780
أنتم أحياء جميعًا؟ لـ-لكن كيف؟

289
00:18:04,780 --> 00:18:09,020
رُمينا إلى العالم الخارجيّ أيضًا
.لحظةَ الانفجار

290
00:18:09,020 --> 00:18:12,820
.لكن إلى فترة ما قبل 50 سنة من الآن

291
00:18:12,820 --> 00:18:17,300
بالطّبع، شوّه ذلك الضّباب
.تدفّق الوقت أيضًا

292
00:18:17,300 --> 00:18:19,900
لِمَ لم تأتوا إلى هنا أبكر إذًا؟

293
00:18:20,160 --> 00:18:23,130
من أجل هزيمة ويتّون
،الّذي أساء استخدام سلطته

294
00:18:23,130 --> 00:18:29,010
فكّرنا أنّنا بحاجة لاستخدام سلطة
.أخرى... أي سلطة البحريّة

295
00:18:29,010 --> 00:18:33,740
لكن استغرقني بعض الوقت
.لأكسب رتبةً عالية

296
00:18:33,740 --> 00:18:35,750
.هذا كلّ شيء

297
00:18:35,750 --> 00:18:38,050
،قد أكون مرتديًا زيّ البحريّة

298
00:18:38,050 --> 00:18:43,720
لكن في قلبي، ما زلتُ أحد قراصنة
.اليقطين وصديقك يا هينزو

299
00:18:44,390 --> 00:18:46,360
.الآن وإلى الأبد

300
00:18:48,430 --> 00:18:50,130
...رابا نوي

301
00:18:56,330 --> 00:19:00,040
،أيضًا، نسيت ذكر هذا
...لكن يا قراصنة لوفي

302
00:19:00,040 --> 00:19:01,610
.أنتم رهن الاعتقال أيضًا

303
00:19:01,610 --> 00:19:02,570
!ماذا؟

304
00:19:02,570 --> 00:19:04,080
!أنت قاسٍ

305
00:19:04,080 --> 00:19:07,550
هل نسيت أنّك تدين لي
!لإطعامك أيّها النّذل؟

306
00:19:08,010 --> 00:19:11,020
،كعضو في البحريّة، مكلّف بدعم العدالة

307
00:19:11,020 --> 00:19:14,520
لا يمكنني أن أدع قرصانًا
...بمكافأة على رأسه يهرب، لكن

308
00:19:14,520 --> 00:19:16,090
!كيف يُعقل هذا؟

309
00:19:16,090 --> 00:19:19,720
علينا أن نأخذ الآن ويتّون
!وعصابته إلى مقرّ البحريّة

310
00:19:19,720 --> 00:19:24,230
لكن حينها، سيهرب منّا
!قراصنة لوفي في نهاية المطاف

311
00:19:24,530 --> 00:19:26,960
!لكن يستحيل علينا التّعامل معهم

312
00:19:26,960 --> 00:19:28,970
!اطلبوا الدّعم من قاعدة البحريّة فورًا

313
00:19:28,970 --> 00:19:31,640
!لا، لن يصلوا حتّى الغد أو بعد غد

314
00:19:31,640 --> 00:19:35,210
!ستكون النّهاية إن هربوا في غضون ذلك

315
00:19:35,510 --> 00:19:38,480
!أستسلم! ما باليد حيلة

316
00:19:39,210 --> 00:19:41,180
.بدا ذلك متعمّدًا بالتّأكيد

317
00:19:45,080 --> 00:19:48,190
لا يمكننا القيام بأيّ إصلاحات
.شاملة على الفور

318
00:19:48,720 --> 00:19:52,920
لكن يجدر بهذا التّرقيع الطّارئ
.أن يصدّ الماء على الأقلّ

319
00:19:54,330 --> 00:19:55,930
...شكرًا لك يا لوفي

320
00:19:56,360 --> 00:19:58,260
.ولكلّ أصدقائك

321
00:19:58,900 --> 00:20:02,330
والآن، اكتمل البحث الّذي
.واصلت فيه كلّ هذه السّنين

322
00:20:02,330 --> 00:20:03,800
.لا يمكنني أن نسمح بذلك

323
00:20:04,240 --> 00:20:07,670
لا ندري متى قد يظهر
ضباب قوس قزح ثانيةً، صحيح؟

324
00:20:07,670 --> 00:20:10,940
،مع وجود ذلك الشّيء
.لا يمكننا أن نُبحر بسلام

325
00:20:11,340 --> 00:20:13,110
،نريد منك أن تصنع لنا عدّةً

326
00:20:13,110 --> 00:20:15,410
.تجنّبنا دخول ضباب قوس قزح

327
00:20:17,220 --> 00:20:19,050
.سيكون ذلك سهلاً

328
00:20:27,230 --> 00:20:30,390
.ضباب قوس قزح أرضُ بقاء

329
00:20:30,900 --> 00:20:33,100
.حيث لا يوجد فيه نهار ولا ليل

330
00:20:33,100 --> 00:20:35,530
.ولا يوجد فيه مرض ولا تقدّم في العمر

331
00:20:37,870 --> 00:20:43,880
تشعّ السّماء بألوان الزّمرّد
.وتحيطنا بعمقٍ كالحليب

332
00:20:45,040 --> 00:20:47,710
وكانت تحتوي السّفن الكثيرة
المأسورة في هذه الأرض

333
00:20:47,710 --> 00:20:51,120
.على قدرٍ لا يحصى من الكنز القابع فيها

334
00:20:51,120 --> 00:20:55,650
.كانت آخر جنّة متبقيّة على الأرض فعلاً

335
00:20:57,120 --> 00:21:00,390
.وكنّا نحن ملوك أرض البقاء

336
00:21:00,390 --> 00:21:04,260
،دحرنا القراصنة الّذين أتوا مقتحمين
.وحافظنا على سلام الجنّة

337
00:21:04,260 --> 00:21:07,060
.كان اسمنا قراصنة اليقطين

338
00:21:07,370 --> 00:21:10,740
لكم أودّ أن أسرد قصصَ
المغامرات الفريدة

339
00:21:10,740 --> 00:21:14,240
...الّتي خضنا غمارها داخل الضّباب

340
00:21:15,770 --> 00:21:19,910
من أجل المغامرين الّذين سيأتون
.لزيارة هذه الأرض من بعدنا

341
00:21:26,880 --> 00:21:29,390
...تعود أسماء المغامرين

342
00:21:29,390 --> 00:21:32,990
لأولئك الّذين يرجع لهم فضل
...عودتنا إلى العالم

343
00:21:33,520 --> 00:21:35,260
.قراصنة لوفي

344
00:21:38,330 --> 00:21:41,230
على أيّ حال، كان ذلك
.مكانًا شيّقًا بالفعل

345
00:21:41,230 --> 00:21:44,170
حقًّا؟ ضقتُ ذرعًا من مقبرة
!السّفن تلك

346
00:21:44,170 --> 00:21:47,440
،ليس وكأنّني أريد أن أعيش هناك
.لكن أريد أن أزورها من حين لآخر

347
00:21:47,440 --> 00:21:49,410
أكانت جميلة حقًّا؟

348
00:21:49,410 --> 00:21:50,370
ماذا؟ مطر؟

349
00:21:50,370 --> 00:21:52,010
...كلاّ... ليس مطرًا

350
00:21:52,010 --> 00:21:53,380
أهو برَد؟

351
00:21:54,250 --> 00:21:56,810
...لا... شيءٌ ما يسقـ

352
00:22:09,390 --> 00:22:17,460
آه، خلف السّماء الّتي لا نهاية لها

353
00:22:17,460 --> 00:22:28,080
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

354
00:22:35,950 --> 00:22:43,390
مرّت عليّ أيّام كدت أخسر فيها نفسي

355
00:22:43,390 --> 00:22:51,800
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

356
00:22:51,800 --> 00:23:00,010
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

357
00:23:00,010 --> 00:23:08,850
دفعوا بي للأمام، أليس كذلك؟

358
00:23:08,850 --> 00:23:17,160
آه، إنّ النّجوم تهوي من السّماء

359
00:23:17,160 --> 00:23:20,290
...وهذه اللّحظة الفريدة

360
00:23:26,570 --> 00:23:27,500
!ما الخطب؟

361
00:23:27,500 --> 00:23:31,210
!بوصلتنا المسجّلة معطّلة
.المؤشّر عالق باتّجاه الأعلى

362
00:23:31,210 --> 00:23:31,710
!ماذا؟

363
00:23:31,710 --> 00:23:32,670
.ذلك ليس صحيحًا

364
00:23:32,670 --> 00:23:35,780
لقد قامت بتسجيل مجال
.مغناطيسيّ قويّ لجزيرة ما

365
00:23:35,780 --> 00:23:37,480
.إنّها تشير إلى الأعلى، إلى جزيرة السّماء

366
00:23:37,480 --> 00:23:38,450
جزيرة السّماء؟

367
00:23:38,450 --> 00:23:41,320
هل سقطت السّفينة من هناك إذًا؟

368
00:23:41,320 --> 00:23:42,580
:في الحلقة القادمة من ون بيس

369
00:23:42,580 --> 00:23:45,250
!سُجّلت الوجهة التّالية"
"!ماسيرا، ملك إنقاذ السّفن

370
00:23:45,250 --> 00:23:47,590
!ملك القراصنة، لن يكون إلاّ أنا