1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,930 --> 00:03:24,900
.فقد لوفي أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:25,560 --> 00:03:28,400
بعد أن تمكّن من الوقوف على قدميه
،ثانية بمساعدة جينبي

39
00:03:28,400 --> 00:03:31,120
.التقى لوفي بملك الظّلام ريلي

40
00:03:31,120 --> 00:03:33,530
ما الّذي ستفعله يا لوفي-كُن؟

41
00:03:33,530 --> 00:03:36,500
.سأعود

42
00:03:36,500 --> 00:03:37,580
!إلى مارينفورد

43
00:03:38,600 --> 00:03:42,940
.ووصلت الأخبار لبقيّة طاقم قبّعة القشّ

44
00:03:43,630 --> 00:03:47,300
!لماذا؟! ما الّذي يحدث؟
!ما الّذي دفع لوفي...؟

45
00:03:48,050 --> 00:03:51,930
!لوفي! أنا سعيدة لأنّه بخير

46
00:03:53,130 --> 00:03:54,680
أهذه صحيفة اليوم؟

47
00:03:55,530 --> 00:03:57,000
!مهلاً! لوفي

48
00:04:00,760 --> 00:04:04,960
"!عودة غير متوقّعة! لوفي، إلى مارينفورد"

49
00:04:07,300 --> 00:04:11,860
...وفي مقرّ البحريّة مارينفورد في الغراند لاين

50
00:04:13,300 --> 00:04:15,160
!هذا غير مفهوم

51
00:04:15,900 --> 00:04:20,760
كشفت أحداث في حرب القمّة أنّه أخ
غير شقيق للمتوفّى بورتغاس د. إيس

52
00:04:20,760 --> 00:04:23,170
وابن الثّوريّ دراغون

53
00:04:23,730 --> 00:04:28,900
!إضافة لأنّه حفيد نائب أميرال البحريّة غارب

54
00:04:28,900 --> 00:04:31,630
!القرصان مونكي د. لوفي

55
00:04:32,510 --> 00:04:37,600
،لقد فُقد أثره بعد الحرب
لكنّه كان حيًّا كما هو متوقّع

56
00:04:37,600 --> 00:04:41,720
!وظهر ثانية هنا في مقرّ البحريّة

57
00:04:44,190 --> 00:04:46,770
—قبل بعضة أيّام

58
00:04:44,560 --> 00:04:46,770
...قبل بضعة أيّام

59
00:04:58,660 --> 00:05:00,710
!هذا فظيع

60
00:05:00,710 --> 00:05:02,120
كانت حربًا شاملة

61
00:05:02,120 --> 00:05:05,750
.بين نخبة البحريّة وأعظم قراصنة العالم

62
00:05:05,750 --> 00:05:08,610
.كانوا محظوظين لأنّ الجزيرة لم تغرق

63
00:05:08,610 --> 00:05:10,170
من أين أتيت؟

64
00:05:10,720 --> 00:05:14,930
من ألاباستا، أنا أكتب مقالاً
.عن كروكودايل وقبّعة القشّ

65
00:05:14,930 --> 00:05:18,720
.لكنّ قبّعة القشّ قد يكون ميتًا الآن

66
00:05:18,720 --> 00:05:23,440
أنا واثق أنّ البحريّة تريد البحث
،عن القراصنة المتورّطين في الحرب

67
00:05:24,190 --> 00:05:26,440
.لكن لا وقت لديهم لذلك الآن

68
00:05:26,440 --> 00:05:27,690
.صحيح

69
00:05:27,820 --> 00:05:32,700
!الوان بيس حقيقيّ

70
00:05:34,660 --> 00:05:38,260
إنّ القراصنة الّذين ألهمتهم كلمات
اللّحية البيضاء الأخيرة

71
00:05:38,260 --> 00:05:40,660
.يقترفون جرائم في كلّ أنحاء العالم

72
00:05:42,680 --> 00:05:47,840
جميع جنود البحريّة الّذين بإمكانهم
.القتال يتعاملون معهم في كلّ مكان

73
00:05:48,840 --> 00:05:50,760
.أشعر بالسّوء حيالهم

74
00:05:52,730 --> 00:05:56,340
.بالحديث عنهم، ها قد أتى الجنود

75
00:06:02,930 --> 00:06:06,810
ما خطب تلك السّفينة؟
!إنّها لا تقترب من الخليج

76
00:06:07,770 --> 00:06:09,020
.إنّها تتصرّف بغرابة

77
00:06:17,070 --> 00:06:17,940
!طلقات تحذير؟

78
00:06:17,940 --> 00:06:19,230
!ما الّذي يحدث؟

79
00:06:20,580 --> 00:06:21,830
!هل اتّصلوا بنا؟

80
00:06:21,830 --> 00:06:22,620
!لا

81
00:06:23,000 --> 00:06:27,250
!مستحيل! لماذا عاد ثانية...؟

82
00:06:27,250 --> 00:06:28,500
!ما الخطب؟

83
00:06:28,960 --> 00:06:31,300
!إنّه قبّعة القشّ لوفي

84
00:06:31,880 --> 00:06:32,920
!ماذا؟

85
00:06:32,920 --> 00:06:35,130
!هل سرق سفينة بحريّة؟

86
00:06:35,130 --> 00:06:36,960
لماذا في هذا الوقت؟

87
00:06:36,960 --> 00:06:40,010
!إنّه لا يتعلّم أبدًا... أغرقوا السّفينة

88
00:06:41,220 --> 00:06:43,520
!جوجوتسو البرمائيّين

89
00:06:43,520 --> 00:06:47,440
!رمية كتف تيّار المحيط

90
00:06:55,400 --> 00:06:57,280
!هل ذاك هو "فارس البحر" جينبي الخائن؟

91
00:06:58,360 --> 00:07:00,000
!ثمّة شخص آخر

92
00:07:09,790 --> 00:07:13,250
...لا يعقل أنّه الأسطوريّ

93
00:07:13,250 --> 00:07:18,010
،نائب قبطان قراصنة روجر
!ملك الظّلام ريلي

94
00:07:29,690 --> 00:07:31,750
لماذا لا يأتون للشّاطئ؟

95
00:07:32,410 --> 00:07:34,320
...لقد التفّوا حول الجزيرة مرّة

96
00:07:34,980 --> 00:07:37,430
!وكأنّها جنازة في البحر

97
00:07:47,580 --> 00:07:52,500
!جنازة؟! لأنّ قوّاتنا الرّئيسيّة ليست هنا الآن؟

98
00:07:52,500 --> 00:07:57,420
!قراصنة لعناء! أطلقوا عليهم من كلّ الاتّجاهات

99
00:08:17,780 --> 00:08:20,530
!اذهب وأطلق عنان قوّتك عليهم

100
00:08:20,530 --> 00:08:21,520
!حاضر

101
00:08:22,760 --> 00:08:24,540
!أمسكوا بقبّعة القشّ

102
00:08:24,960 --> 00:08:27,330
!أنا سأقاتلكم

103
00:08:28,870 --> 00:08:30,710
!أريدكم أن تلعبوا معي أيضًا

104
00:08:31,990 --> 00:08:33,710
...فاكهة المطّاط

105
00:08:33,710 --> 00:08:35,550
!السّوط

106
00:08:40,300 --> 00:08:44,180
!ما الّذي يرمي إليه؟! إنّه يتّجه غربًا

107
00:08:44,180 --> 00:08:46,220
!هل يريد الإطاحة بمقرّ البحريّة؟

108
00:08:54,790 --> 00:08:56,940
ما الّذي سيفعله بـ"جرس أوكس"؟

109
00:10:12,020 --> 00:10:12,890
زهور؟

110
00:10:23,070 --> 00:10:25,240
!ستكون هذه صورة ممتازة

111
00:10:47,300 --> 00:10:48,890
!طاردوه! لا تدعوه يهرب

112
00:10:49,360 --> 00:10:51,200
...إنّه يغادر

113
00:10:51,720 --> 00:10:53,220
ما كانت الغاية من ذلك؟

114
00:10:53,220 --> 00:10:57,060
...ملك الظّلام ريلي والشّيتشيبوكاي جينبي

115
00:10:57,060 --> 00:10:58,770
!هل يقفان في صفّه؟

116
00:10:59,110 --> 00:11:02,070
.كان ريلي عضوًا في طاقم ملك القراصنة

117
00:11:02,070 --> 00:11:04,290
!هل يعني ذلك أنّ قبّعة القشّ هو خليفة روجر؟

118
00:11:04,290 --> 00:11:08,990
!مـ-مهلاً! إنّه ابن دراغون
...لا يمكن أن يكون ذلك صحيحًا

119
00:11:09,910 --> 00:11:11,950
...في كلّ الأحوال، هذه

120
00:11:11,950 --> 00:11:13,410
!أخبار مهمّة

121
00:11:32,800 --> 00:11:36,100
!انتشرت هذه المقالة في كلّ أنحاء العالم سلفًا

122
00:11:36,100 --> 00:11:40,770
!وتذكر حقيقة أنّنا سمحنا لقبّعة القشّ بالهرب أيضًا

123
00:11:40,770 --> 00:11:41,980
!كم هذا مهين

124
00:11:42,460 --> 00:11:46,320
إن نظرتم للأمر ببساطة، ما فعله
...قبّعة القشّ هو إعراب عن تقديره

125
00:11:46,320 --> 00:11:51,030
لأخيه واللّحية البيضاء وجميع
.من ماتوا في الحرب

126
00:11:51,030 --> 00:11:54,120
لا شكّ في لحظة الصّمت
،والدّوران حول الجزيرة

127
00:11:54,670 --> 00:12:00,290
!لكنّ الجرس قد قُرع 16 مرّة بدل مرّتين

128
00:12:00,290 --> 00:12:04,670
!لذلك قد يكون قرعه 16 مرّة تحدّيًا لنا

129
00:12:06,130 --> 00:12:09,760
.يا إلهي! كم أنّه مثير للجدل

130
00:12:09,760 --> 00:12:11,580
...قبّعة القشّ لوفي

131
00:12:11,580 --> 00:12:14,680
.هذا غير مفاجئ نظرًا لكونه حفيد غارب

132
00:12:15,140 --> 00:12:18,730
.أتساءل كيف يعرف ريلي

133
00:12:18,730 --> 00:12:21,900
.لا أظنّ أنّ ريلي يودّ العودة لمركز الأحداث

134
00:12:22,580 --> 00:12:25,270
.انقلب جينبي علينا أخيرًا

135
00:12:25,270 --> 00:12:30,490
.كونه أحد الشّيتشيبوكاي كان رمز سلام بين شعبينا

136
00:12:30,490 --> 00:12:32,030
!يا للأسف

137
00:12:32,030 --> 00:12:36,240
.إنّ القوى الثّلاثة العظمى غير متّزنة الآن

138
00:12:36,240 --> 00:12:39,910
كيف لنا أن نملأ المقاعد الثّلاثة الشّاغرة
بين الشّيتشيبوكاي؟

139
00:12:40,400 --> 00:12:43,460
.علينا أن نرى ما الّذي سيجري في العالم الجديد

140
00:12:43,460 --> 00:12:47,170
ستحدث بعض التّغييرات في علاقات
.القوّة بين القراصنة

141
00:12:47,170 --> 00:12:50,550
.علينا أن نختار الأكثر قوّة

142
00:12:51,040 --> 00:12:54,890
سبق وقام اللّحية السّوداء بحركته في العالم الجديد

143
00:12:54,890 --> 00:13:00,560
وتخلّص من أحد النّاشئين الّذي تتجاوز
.مكافأته 100 مليون

144
00:13:00,560 --> 00:13:05,230
.إنّه يعلم كلّ شيء عن منطقة نفوذ اللّحية البيضاء

145
00:13:06,520 --> 00:13:12,360
إنّه الآن في مقدّمة السّباق ليصبح
.أحد اليونكو من بين بقيّة القراصنة

146
00:13:12,360 --> 00:13:18,120
لم يحمل أيّ أحد فاكهتَيْ شيطان
.من قبل على مرّ التّاريخ سواه

147
00:13:18,740 --> 00:13:23,760
إنّ من قد يكونون قادرين على
...وضع حدّ له هم اليونكو

148
00:13:24,530 --> 00:13:28,880
.أو ماركو العنقاء وبقايا قراصنة اللّحية البيضاء

149
00:13:30,210 --> 00:13:35,340
إنّ "د." في وسط المشاكل دومًا
."بما في ذلك "بورتغاس

150
00:13:35,340 --> 00:13:40,360
إنّ تلك الأسماء معروفة عند
.أكثر ممّا يجب هذه الأيّام

151
00:13:58,220 --> 00:14:03,460
.حاولت إقناع غارب للعدول عن هذا لكنّه استقال

152
00:14:04,300 --> 00:14:08,480
.لكن عليه الاحتفاظ بلقبه والبقاء في البحريّة

153
00:14:09,160 --> 00:14:12,230
.لتدريس جنود البحريّة اليافعين

154
00:14:13,080 --> 00:14:15,930
،إن كنت تريد الاستقالة من منصبك كأميرال أسطول

155
00:14:16,400 --> 00:14:18,760
فهلاّ قمت بذلك على الأقلّ؟

156
00:14:18,760 --> 00:14:20,640
.سنغوكو

157
00:14:20,640 --> 00:14:21,520
.حاضر

158
00:14:22,100 --> 00:14:27,360
أقبل بذلك العرض. ليست طريقة
.سيّئة لقضاء حياة تقاعدي

159
00:14:30,550 --> 00:14:35,320
قدتما كلاكما البحريّة
في المقدّمة منذ عصر روجر

160
00:14:35,320 --> 00:14:37,870
.وها أنتما تتنحّيان عن منصبيكما

161
00:14:37,870 --> 00:14:40,120
.سيكون لذلك عواقب كثيرة

162
00:14:40,120 --> 00:14:44,920
بما في ذلك السّجناء الهاربون
،من المستوى 6 في إمبل داون

163
00:14:45,500 --> 00:14:49,440
ما زال هنالك العديد من القراصنة
.سيّئي السّمعة أحرارًا

164
00:14:50,670 --> 00:14:54,210
.وكان نيوغيت على رأس القائمة

165
00:14:56,160 --> 00:14:59,680
إنّ عصر القراصنة يتغيّر الآن

166
00:14:59,680 --> 00:15:03,640
ولا يجب على الجنود القدامى التّشبّث
.بالسّلطة في البحريّة

167
00:15:03,640 --> 00:15:07,390
.أساس العدالة هو القيم
.وتتغيّر القيم في كلّ جيل

168
00:15:09,440 --> 00:15:11,650
.هذا ليس ما أريد سماعه

169
00:15:11,650 --> 00:15:13,650
،بالمناسبة يا كونغ-سان

170
00:15:14,040 --> 00:15:19,200
.أريد أن أرشّح أوكيجي لمنصب أميرال الأسطول التّالي

171
00:15:26,670 --> 00:15:29,630
.تسمّى تلك القوّة بالهاكي

172
00:15:29,630 --> 00:15:32,540
.من الآمن قول أنّ هذا ما تعانيه

173
00:15:33,170 --> 00:15:37,260
.أعتقد أنّها استيقظت بسبب صدمة الحرب

174
00:15:37,260 --> 00:15:42,180
في العادة، يمكن الحصول عليها
.عن طريق التّدريب لوقت طويل

175
00:15:42,180 --> 00:15:44,710
هاكي...؟ هكذا هو الأمر إذًا؟

176
00:15:45,450 --> 00:15:49,780
.إنّها قوّة يمتلكها كلّ نوّاب الأميرالات

177
00:15:49,780 --> 00:15:50,730
!فعلاً؟

178
00:16:03,450 --> 00:16:06,630
...أشعر بتواجد الآخرين بشكل قويّ جدًّا

179
00:16:06,630 --> 00:16:08,000
...هذا غير مريح تمامًا

180
00:16:08,640 --> 00:16:11,250
أنتما متدرّبان على يد غارب، صحيح؟

181
00:16:11,250 --> 00:16:12,920
.سلاه عنها

182
00:16:12,920 --> 00:16:16,710
أيّها الطّبيب! أتظنّ أنّني سأحصل
على تلك القوّة أيضًا؟

183
00:16:16,710 --> 00:16:18,260
وما أدراني؟

184
00:16:20,130 --> 00:16:25,350
!تبًّا! وكأنّك تسبقني الآن

185
00:16:25,350 --> 00:16:27,730
...لا أدري ما الّذي يحدث

186
00:16:28,310 --> 00:16:29,870
لكن ما هذا الشّعور؟

187
00:16:29,870 --> 00:16:33,260
!وكأنّني شخص مختلف من ذي قبل

188
00:16:33,980 --> 00:16:39,700
!ربّما... إن بذلت جهدًا أكبر، فسأصير أقوى

189
00:16:40,210 --> 00:16:45,720
!أقوى بكثير ممّا أنا عليه الآن... بقدر قوّته

190
00:16:48,120 --> 00:16:52,250
!أنا آسف! لم أستطع الدّفاع عن المقرّ

191
00:16:56,840 --> 00:16:57,760
!لا تقلق

192
00:17:03,590 --> 00:17:07,220
!كان على قيد الحياة؟ هذا مذهل

193
00:17:08,180 --> 00:17:11,650
.أسمعت بهذا؟ تسبّب قبّعة القشّ بالمشاكل ثانية

194
00:17:12,230 --> 00:17:13,310
.نعم

195
00:17:13,310 --> 00:17:18,730
لم تنتهِ حرب القمّة منذ وقت قصير
وقرع الجرس 16 مرّة الآن؟

196
00:17:18,730 --> 00:17:21,400
أكانت رسالة من نوع ما؟

197
00:17:22,740 --> 00:17:24,570
.لا أدري

198
00:17:24,570 --> 00:17:27,240
لنضع ذلك جانبًا، ماذا عن نقلي؟

199
00:17:27,880 --> 00:17:33,670
حسنًا، سأتحدّث مع سنغوكو-سان
بشأنه، لكن هل أنت جادّ؟

200
00:17:33,670 --> 00:17:36,880
.ما كان أيّ أحد ليمزح في هذا

201
00:17:36,880 --> 00:17:43,300
.أعلم. لكنّ جي 5 ليس مكان يُقصد طواعية

202
00:17:43,300 --> 00:17:45,980
.يملك ذلك المكان الكثير من المشاكل

203
00:17:47,390 --> 00:17:50,810
.فرع البحريّة الخامس في الغراند لاين

204
00:17:51,570 --> 00:17:54,440
.هذا يعني أنّك تريد الذّهاب للعالم الجديد

205
00:17:54,880 --> 00:17:58,610
.من الأفضل دائمًا أن نكون قريبين من أهدافنا

206
00:18:01,240 --> 00:18:05,500
.انتشرت أخبار قبّعة القشّ لوفي في العالم بأكمله

207
00:18:06,490 --> 00:18:09,740
...حتّى في العالم الجديد

208
00:18:09,740 --> 00:18:13,200
"!كان قبّعة القشّ لوفي حيًّا"

209
00:18:14,000 --> 00:18:17,770
".قرع الجرس 16 مرّة لعصر جديد في مارينفورد"

210
00:18:18,540 --> 00:18:20,210
ما هو جرس أوكس؟

211
00:18:22,170 --> 00:18:23,970
...إنّ جرس أوكس

212
00:18:25,000 --> 00:18:27,470
،هو الجرس المقدّس من أوكس لويدز

213
00:18:27,470 --> 00:18:30,890
.سفينة للبحريّة كان لها تأثيري كبير قبل زمن بعيد

214
00:18:31,930 --> 00:18:36,770
في نهاية العام، يقرعونه 8 مرّات
لتقدير السّنة الماضية

215
00:18:36,770 --> 00:18:40,170
و8 مرّات في بداية السّنة
.كدعاء للسّنة الجديدة

216
00:18:40,170 --> 00:18:44,280
،أي يُقرع 16 مرّة في المجمل
.وهذا هو تقليد تتّبعه البحريّة

217
00:18:44,280 --> 00:18:46,320
.هذا هو معنى قرعه 16 مرّة

218
00:18:48,320 --> 00:18:50,660
.لكن لم يحن الوقت لذلك بعد

219
00:18:50,660 --> 00:18:55,120
لذلك ربّما يكون قد فعل ذلك ليعلن
.عن نهاية عصر وبداية آخر

220
00:18:55,120 --> 00:18:57,670
.يريد أن يقول "انتهى عصر اللّحية البيضاء

221
00:18:58,090 --> 00:19:01,920
سأكون أنا من سيشكّل العصر الجديد"؟

222
00:19:02,290 --> 00:19:06,510
،إن لم يكن قد فعلها لتلك الأسباب
...فما كان ليعود للمكان

223
00:19:06,510 --> 00:19:10,020
.حيث عليه أن يعيش ألم فقدانه لأخيه

224
00:19:11,600 --> 00:19:13,890
!يا له من وغد مزعج

225
00:19:14,310 --> 00:19:16,270
،في الحقيقة، بعد الحرب

226
00:19:16,270 --> 00:19:20,860
أخذ الصّدارة بين النّاشئين
.بمكافأة بلغت 100 مليون

227
00:19:21,420 --> 00:19:26,360
.لكنّني لن أسمح له بفعل ما يشاء

228
00:19:29,070 --> 00:19:30,950
...العالم الجديد

229
00:19:31,400 --> 00:19:36,540
،ظننتُ أنّ بإمكاني الاستمتاع أكثر هنا
لكن ما قصّة هؤلاء الجبناء؟

230
00:19:36,540 --> 00:19:41,040
!على رسلك! لم أسبّب لك أيّ أذى

231
00:19:41,040 --> 00:19:46,420
!كنّا نوشك على الخروج من هذا البحر
!دعونا نعود إلى النّعيم أحياءً

232
00:19:46,970 --> 00:19:50,510
النّعيم؟ تقصد موطنك الحبيب؟

233
00:19:50,910 --> 00:19:56,230
وصلتم إلى هنا للتّوّ ولا فكرة
!لديكم عن هذا البحر الرّهيب

234
00:20:03,970 --> 00:20:05,260
قبّعة القشّ؟

235
00:20:05,260 --> 00:20:07,650
.نعم، تسبّب بالمشاكل ثانية

236
00:20:08,200 --> 00:20:10,240
.لا داعي للهلع

237
00:20:10,240 --> 00:20:12,240
...إنّ آخر من سيقوم بكشّ الملك

238
00:20:12,240 --> 00:20:13,830
.سيكون المنتصر

239
00:20:14,660 --> 00:20:16,160
!ماذا حدث؟

240
00:20:16,600 --> 00:20:21,500
أيّها الأب! إنّ السّفينة ليست
!على الماء، إنّها في الهواء

241
00:20:21,500 --> 00:20:23,090
!ماذا قلت؟

242
00:20:23,620 --> 00:20:27,840
ماذا قلت؟ ماذا تعني؟
!سيطروا على السّفينة، اللّعنة

243
00:20:27,840 --> 00:20:30,260
...أيّها الأب! ثمّة شيء ما ينزل من السّماء

244
00:20:33,760 --> 00:20:36,900
!كلاّ، بل نحن من نصعد

245
00:20:42,920 --> 00:20:44,900
.أنا جدّ آسف

246
00:20:47,200 --> 00:20:51,570
.هلاّ كرّرت كلامك؟ لم أسمع أوّل مرّة

247
00:20:51,570 --> 00:20:53,480
!أنا اللّحية البنّيّة

248
00:20:53,480 --> 00:20:56,740
!قرصان تفوق مكافأته 80 مليون

249
00:20:56,740 --> 00:20:58,040
!اللّحية البنّيّة-ساما

250
00:20:58,830 --> 00:21:02,750
!احرص على تذكّر اسمي! هذه منطقتي

251
00:21:03,140 --> 00:21:06,160
!ما فعلتَه برجالي فظيع

252
00:21:06,160 --> 00:21:08,300
!سأجعلك تدفع الثّمن بالدّماء

253
00:21:08,860 --> 00:21:13,190
فهمت. ظننتُ أنّني لم أسمع
.اسمك لأنّه غبيّ جدًّا

254
00:21:14,040 --> 00:21:18,270
.سأخبرك بأمرين. الأوّل هو أنّي لا أحبّ المزاح

255
00:21:18,270 --> 00:21:19,430
المزاح؟

256
00:21:19,880 --> 00:21:21,770
،أمّا بالنّسبة للشّيء الثّاني

257
00:21:23,440 --> 00:21:27,480
.أستطيع رؤية ظلّ الموت على وجهك

258
00:21:35,780 --> 00:21:40,250
!أواثق أنّ البوصلة المسجّلة تشير لتلك الجزيرة؟

259
00:21:40,250 --> 00:21:43,620
!يضرب البرق الجزيرة كالمطر

260
00:21:44,360 --> 00:21:46,040
!لا يمكننا الذّهاب إلى هناك

261
00:21:51,820 --> 00:21:54,420
!كيف نستطيع الذّهاب للشّاطئ؟

262
00:21:56,280 --> 00:22:00,020
الرّجال الجسورين الّذين وطأت أقدامهم
...العالم الجديد ولو لمرّة واحدة

263
00:22:01,160 --> 00:22:03,480
!أيّها الكاهن الأعلى، ثمّة من يقترب منّا

264
00:22:04,610 --> 00:22:05,600
من يكون؟

265
00:22:06,230 --> 00:22:10,530
يصفون جميعًا النّصف الأوّل من
...الغراند لاين بنفس الوصف

266
00:22:11,000 --> 00:22:13,030
...أخبرني أيّها الشّابّ

267
00:22:13,610 --> 00:22:16,320
من هذه الجدّة؟

268
00:22:16,320 --> 00:22:20,350
".كان ذلك البحر أشبه بالنّعيم"

269
00:22:22,370 --> 00:22:24,790
أتريدون مظلّة؟

270
00:22:25,960 --> 00:22:29,920
!إن بقينا هنا، فسنموت قريبًا

271
00:22:29,920 --> 00:22:34,130
!نريد العودة للنّعيم فحسب! رجاءً

272
00:22:34,130 --> 00:22:37,040
.يا لك من مفسد للمرح

273
00:22:38,640 --> 00:22:43,930
...إن لم تكن مستعدًّا للموت

274
00:22:43,930 --> 00:22:45,560
...فلا ترمِ بنفسك

275
00:22:46,310 --> 00:22:50,820
!في هذا البحر

276
00:22:53,570 --> 00:22:59,070
!سأطيح بك قريبًا! من الأفضل أن تستعدّ

277
00:22:59,070 --> 00:23:01,080
!يا قبّعة القشّ

278
00:23:11,520 --> 00:23:14,610
تقارير عن الحادثة الجديد المتعلّقة بلوفي في مارينفورد

279
00:23:14,610 --> 00:23:17,200
.انتشرت حول العالم في لمح البصر

280
00:23:17,200 --> 00:23:19,640
،الجميع حائرون بسبب أفعاله الغامضة

281
00:23:19,640 --> 00:23:21,430
.وكذلك أصدقاؤه

282
00:23:21,430 --> 00:23:23,970
.لكنّ للوفي سبب وجيه لتصرّفاته تلك

283
00:23:23,970 --> 00:23:26,770
!ما الّذي يفكّر فيه لوفي بالضّبط؟

284
00:23:26,770 --> 00:23:28,130
:في الحلقة القادمة من وان بيس

285
00:23:28,130 --> 00:23:30,980
!تحت أمل أن تصل لأصدقائي"
"!تنتشر الأخبار المهمّة بسرعة

286
00:23:30,980 --> 00:23:33,370
!ملك القراصنة، لن يكون إلاّ أنا

287
00:23:35,900 --> 00:23:40,910
!!نلقاكم في الحلقة القادمة