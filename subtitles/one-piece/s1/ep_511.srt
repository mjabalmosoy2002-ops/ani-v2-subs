1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,910
"وأقول "أريد أن أصير أقوى

5
00:01:01,910 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,930 --> 00:03:38,900
.فقد لوفي أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:39,560 --> 00:03:42,400
بعد أن تمكّن من الوقوف على قدميه
،ثانية بمساعدة جينبي

39
00:03:42,400 --> 00:03:45,120
.التقى لوفي بملك الظّلام ريلي

40
00:03:45,120 --> 00:03:47,530
ما الّذي ستفعله يا لوفي-كُن؟

41
00:03:47,530 --> 00:03:50,500
.سأعود

42
00:03:50,500 --> 00:03:51,580
!إلى مارينفورد

43
00:03:52,600 --> 00:03:56,940
.ووصلت الأخبار لبقيّة طاقم قبّعة القشّ

44
00:03:57,630 --> 00:04:01,300
!لماذا؟! ما الّذي يحدث؟
!ما الّذي دفع لوفي...؟

45
00:04:02,050 --> 00:04:05,930
!لوفي! أنا سعيدة لأنّه بخير

46
00:04:07,130 --> 00:04:08,680
أهذه صحيفة اليوم؟

47
00:04:09,530 --> 00:04:11,000
!مهلاً! لوفي

48
00:04:14,760 --> 00:04:18,960
"!عودة غير متوقّعة! لوفي، إلى مارينفورد"

49
00:04:21,300 --> 00:04:25,860
...وفي مقرّ البحريّة مارينفورد في الغراند لاين

50
00:04:27,300 --> 00:04:29,160
!هذا غير مفهوم

51
00:04:29,900 --> 00:04:34,760
كشفت أحداث في حرب القمّة أنّه أخ
غير شقيق للمتوفّى بورتغاس د. إيس

52
00:04:34,760 --> 00:04:37,170
وابن الثّوريّ دراغون

53
00:04:37,730 --> 00:04:42,900
!إضافة لأنّه حفيد نائب أميرال البحريّة غارب

54
00:04:42,900 --> 00:04:45,630
!القرصان مونكي د. لوفي

55
00:04:46,510 --> 00:04:51,600
،لقد فُقد أثره بعد الحرب
لكنّه كان حيًّا كما هو متوقّع

56
00:04:51,600 --> 00:04:55,720
!وظهر ثانية هنا في مقرّ البحريّة

57
00:04:58,190 --> 00:05:00,770
—قبل بعضة أيّام

58
00:04:58,560 --> 00:05:00,770
...قبل بضعة أيّام

59
00:05:12,660 --> 00:05:14,710
!هذا فظيع

60
00:05:14,710 --> 00:05:16,120
كانت حربًا شاملة

61
00:05:16,120 --> 00:05:19,750
.بين نخبة البحريّة وأعظم قراصنة العالم

62
00:05:19,750 --> 00:05:22,610
.كانوا محظوظين لأنّ الجزيرة لم تغرق

63
00:05:22,610 --> 00:05:24,170
من أين أتيت؟

64
00:05:24,720 --> 00:05:28,930
من ألاباستا، أنا أكتب مقالاً
.عن كروكودايل وقبّعة القشّ

65
00:05:28,930 --> 00:05:32,720
.لكنّ قبّعة القشّ قد يكون ميتًا الآن

66
00:05:32,720 --> 00:05:37,440
أنا واثق أنّ البحريّة تريد البحث
،عن القراصنة المتورّطين في الحرب

67
00:05:38,190 --> 00:05:40,440
.لكن لا وقت لديهم لذلك الآن

68
00:05:40,440 --> 00:05:41,690
.صحيح

69
00:05:41,820 --> 00:05:46,700
!الوان بيس حقيقيّ

70
00:05:48,660 --> 00:05:52,260
إنّ القراصنة الّذين ألهمتهم كلمات
اللّحية البيضاء الأخيرة

71
00:05:52,260 --> 00:05:54,660
.يقترفون جرائم في كلّ أنحاء العالم

72
00:05:56,680 --> 00:06:01,840
جميع جنود البحريّة الّذين بإمكانهم
.القتال يتعاملون معهم في كلّ مكان

73
00:06:02,840 --> 00:06:04,760
.أشعر بالسّوء حيالهم

74
00:06:06,730 --> 00:06:10,340
.بالحديث عنهم، ها قد أتى الجنود

75
00:06:16,930 --> 00:06:20,810
ما خطب تلك السّفينة؟
!إنّها لا تقترب من الخليج

76
00:06:21,770 --> 00:06:23,020
.إنّها تتصرّف بغرابة

77
00:06:31,070 --> 00:06:31,940
!طلقات تحذير؟

78
00:06:31,940 --> 00:06:33,230
!ما الّذي يحدث؟

79
00:06:34,580 --> 00:06:35,830
!هل اتّصلوا بنا؟

80
00:06:35,830 --> 00:06:36,620
!لا

81
00:06:37,000 --> 00:06:41,250
!مستحيل! لماذا عاد ثانية...؟

82
00:06:41,250 --> 00:06:42,500
!ما الخطب؟

83
00:06:42,960 --> 00:06:45,300
!إنّه قبّعة القشّ لوفي

84
00:06:45,880 --> 00:06:46,920
!ماذا؟

85
00:06:46,920 --> 00:06:49,130
!هل سرق سفينة بحريّة؟

86
00:06:49,130 --> 00:06:50,960
لماذا في هذا الوقت؟

87
00:06:50,960 --> 00:06:54,010
!إنّه لا يتعلّم أبدًا... أغرقوا السّفينة

88
00:06:55,220 --> 00:06:57,520
!جوجوتسو البرمائيّين

89
00:06:57,520 --> 00:07:01,440
!رمية كتف تيّار المحيط

90
00:07:09,400 --> 00:07:11,280
!هل ذاك هو "فارس البحر" جينبي الخائن؟

91
00:07:12,360 --> 00:07:14,000
!ثمّة شخص آخر

92
00:07:23,790 --> 00:07:27,250
...لا يعقل أنّه الأسطوريّ

93
00:07:27,250 --> 00:07:32,010
،نائب قبطان قراصنة روجر
!ملك الظّلام ريلي

94
00:07:43,690 --> 00:07:45,750
لماذا لا يأتون للشّاطئ؟

95
00:07:46,410 --> 00:07:48,320
...لقد التفّوا حول الجزيرة مرّة

96
00:07:48,980 --> 00:07:51,430
!وكأنّها جنازة في البحر

97
00:08:01,580 --> 00:08:06,500
!جنازة؟! لأنّ قوّاتنا الرّئيسيّة ليست هنا الآن؟

98
00:08:06,500 --> 00:08:11,420
!قراصنة لعناء! أطلقوا عليهم من كلّ الاتّجاهات

99
00:08:31,780 --> 00:08:34,530
!اذهب وأطلق عنان قوّتك عليهم

100
00:08:34,530 --> 00:08:35,520
!حاضر

101
00:08:36,760 --> 00:08:38,540
!أمسكوا بقبّعة القشّ

102
00:08:38,960 --> 00:08:41,330
!أنا سأقاتلكم

103
00:08:42,870 --> 00:08:44,710
!أريدكم أن تلعبوا معي أيضًا

104
00:08:45,990 --> 00:08:47,710
...فاكهة المطّاط

105
00:08:47,710 --> 00:08:49,550
!السّوط

106
00:08:54,300 --> 00:08:58,180
!ما الّذي يرمي إليه؟! إنّه يتّجه غربًا

107
00:08:58,180 --> 00:09:00,220
!هل يريد الإطاحة بمقرّ البحريّة؟

108
00:09:08,790 --> 00:09:10,940
ما الّذي سيفعله بـ"جرس أوكس"؟

109
00:10:26,020 --> 00:10:26,890
زهور؟

110
00:10:37,070 --> 00:10:39,240
!ستكون هذه صورة ممتازة

111
00:11:01,300 --> 00:11:02,890
!طاردوه! لا تدعوه يهرب

112
00:11:03,360 --> 00:11:05,200
...إنّه يغادر

113
00:11:05,720 --> 00:11:07,220
ما كانت الغاية من ذلك؟

114
00:11:07,220 --> 00:11:11,060
...ملك الظّلام ريلي والشّيتشيبوكاي جينبي

115
00:11:11,060 --> 00:11:12,770
!هل يقفان في صفّه؟

116
00:11:13,110 --> 00:11:16,070
.كان ريلي عضوًا في طاقم ملك القراصنة

117
00:11:16,070 --> 00:11:18,290
!هل يعني ذلك أنّ قبّعة القشّ هو خليفة روجر؟

118
00:11:18,290 --> 00:11:22,990
!مـ-مهلاً! إنّه ابن دراغون
...لا يمكن أن يكون ذلك صحيحًا

119
00:11:23,910 --> 00:11:25,950
...في كلّ الأحوال، هذه

120
00:11:25,950 --> 00:11:27,410
!أخبار مهمّة

121
00:11:46,800 --> 00:11:50,100
!انتشرت هذه المقالة في كلّ أنحاء العالم سلفًا

122
00:11:50,100 --> 00:11:54,770
!وتذكر حقيقة أنّنا سمحنا لقبّعة القشّ بالهرب أيضًا

123
00:11:54,770 --> 00:11:55,980
!كم هذا مهين

124
00:11:56,460 --> 00:12:00,320
إن نظرتم للأمر ببساطة، ما فعله
...قبّعة القشّ هو إعراب عن تقديره

125
00:12:00,320 --> 00:12:05,030
لأخيه واللّحية البيضاء وجميع
.من ماتوا في الحرب

126
00:12:05,030 --> 00:12:08,120
لا شكّ في لحظة الصّمت
،والدّوران حول الجزيرة

127
00:12:08,670 --> 00:12:14,290
!لكنّ الجرس قد قُرع 16 مرّة بدل مرّتين

128
00:12:14,290 --> 00:12:18,670
!لذلك قد يكون قرعه 16 مرّة تحدّيًا لنا

129
00:12:20,130 --> 00:12:23,760
.يا إلهي! كم أنّه مثير للجدل

130
00:12:23,760 --> 00:12:25,580
...قبّعة القشّ لوفي

131
00:12:25,580 --> 00:12:28,680
.هذا غير مفاجئ نظرًا لكونه حفيد غارب

132
00:12:29,140 --> 00:12:32,730
.أتساءل كيف يعرف ريلي

133
00:12:32,730 --> 00:12:35,900
.لا أظنّ أنّ ريلي يودّ العودة لمركز الأحداث

134
00:12:36,580 --> 00:12:39,270
.انقلب جينبي علينا أخيرًا

135
00:12:39,270 --> 00:12:44,490
.كونه أحد الشّيتشيبوكاي كان رمز سلام بين شعبينا

136
00:12:44,490 --> 00:12:46,030
!يا للأسف

137
00:12:46,030 --> 00:12:50,240
.إنّ القوى الثّلاثة العظمى غير متّزنة الآن

138
00:12:50,240 --> 00:12:53,910
كيف لنا أن نملأ المقاعد الثّلاثة الشّاغرة
بين الشّيتشيبوكاي؟

139
00:12:54,400 --> 00:12:57,460
.علينا أن نرى ما الّذي سيجري في العالم الجديد

140
00:12:57,460 --> 00:13:01,170
ستحدث بعض التّغييرات في علاقات
.القوّة بين القراصنة

141
00:13:01,170 --> 00:13:04,550
.علينا أن نختار الأكثر قوّة

142
00:13:05,040 --> 00:13:08,890
سبق وقام اللّحية السّوداء بحركته في العالم الجديد

143
00:13:08,890 --> 00:13:14,560
وتخلّص من أحد النّاشئين الّذي تتجاوز
.مكافأته 100 مليون

144
00:13:14,560 --> 00:13:19,230
.إنّه يعلم كلّ شيء عن منطقة نفوذ اللّحية البيضاء

145
00:13:20,520 --> 00:13:26,360
إنّه الآن في مقدّمة السّباق ليصبح
.أحد اليونكو من بين بقيّة القراصنة

146
00:13:26,360 --> 00:13:32,120
لم يحمل أيّ أحد فاكهتَيْ شيطان
.من قبل على مرّ التّاريخ سواه

147
00:13:32,740 --> 00:13:37,760
إنّ من قد يكونون قادرين على
...وضع حدّ له هم اليونكو

148
00:13:38,530 --> 00:13:42,880
.أو ماركو العنقاء وبقايا قراصنة اللّحية البيضاء

149
00:13:44,210 --> 00:13:49,340
إنّ "د." في وسط المشاكل دومًا
."بما في ذلك "بورتغاس

150
00:13:49,340 --> 00:13:54,360
إنّ تلك الأسماء معروفة عند
.أكثر ممّا يجب هذه الأيّام

151
00:14:12,220 --> 00:14:17,460
.حاولت إقناع غارب للعدول عن هذا لكنّه استقال

152
00:14:18,300 --> 00:14:22,480
.لكن عليه الاحتفاظ بلقبه والبقاء في البحريّة

153
00:14:23,160 --> 00:14:26,230
.لتدريس جنود البحريّة اليافعين

154
00:14:27,080 --> 00:14:29,930
،إن كنت تريد الاستقالة من منصبك كأميرال أسطول

155
00:14:30,400 --> 00:14:32,760
فهلاّ قمت بذلك على الأقلّ؟

156
00:14:32,760 --> 00:14:34,640
.سنغوكو

157
00:14:34,640 --> 00:14:35,520
.حاضر

158
00:14:36,100 --> 00:14:41,360
أقبل بذلك العرض. ليست طريقة
.سيّئة لقضاء حياة تقاعدي

159
00:14:44,550 --> 00:14:49,320
قدتما كلاكما البحريّة
في المقدّمة منذ عصر روجر

160
00:14:49,320 --> 00:14:51,870
.وها أنتما تتنحّيان عن منصبيكما

161
00:14:51,870 --> 00:14:54,120
.سيكون لذلك عواقب كثيرة

162
00:14:54,120 --> 00:14:58,920
بما في ذلك السّجناء الهاربون
،من المستوى 6 في إمبل داون

163
00:14:59,500 --> 00:15:03,440
ما زال هنالك العديد من القراصنة
.سيّئي السّمعة أحرارًا

164
00:15:04,670 --> 00:15:08,210
.وكان نيوغيت على رأس القائمة

165
00:15:10,160 --> 00:15:13,680
إنّ عصر القراصنة يتغيّر الآن

166
00:15:13,680 --> 00:15:17,640
ولا يجب على الجنود القدامى التّشبّث
.بالسّلطة في البحريّة

167
00:15:17,640 --> 00:15:21,390
.أساس العدالة هو القيم
.وتتغيّر القيم في كلّ جيل

168
00:15:23,440 --> 00:15:25,650
.هذا ليس ما أريد سماعه

169
00:15:25,650 --> 00:15:27,650
،بالمناسبة يا كونغ-سان

170
00:15:28,040 --> 00:15:33,200
.أريد أن أرشّح أوكيجي لمنصب أميرال الأسطول التّالي

171
00:15:40,670 --> 00:15:43,630
.تسمّى تلك القوّة بالهاكي

172
00:15:43,630 --> 00:15:46,540
.من الآمن قول أنّ هذا ما تعانيه

173
00:15:47,170 --> 00:15:51,260
.أعتقد أنّها استيقظت بسبب صدمة الحرب

174
00:15:51,260 --> 00:15:56,180
في العادة، يمكن الحصول عليها
.عن طريق التّدريب لوقت طويل

175
00:15:56,180 --> 00:15:58,710
هاكي...؟ هكذا هو الأمر إذًا؟

176
00:15:59,450 --> 00:16:03,780
.إنّها قوّة يمتلكها كلّ نوّاب الأميرالات

177
00:16:03,780 --> 00:16:04,730
!فعلاً؟

178
00:16:17,450 --> 00:16:20,630
...أشعر بتواجد الآخرين بشكل قويّ جدًّا

179
00:16:20,630 --> 00:16:22,000
...هذا غير مريح تمامًا

180
00:16:22,640 --> 00:16:25,250
أنتما متدرّبان على يد غارب، صحيح؟

181
00:16:25,250 --> 00:16:26,920
.سلاه عنها

182
00:16:26,920 --> 00:16:30,710
أيّها الطّبيب! أتظنّ أنّني سأحصل
على تلك القوّة أيضًا؟

183
00:16:30,710 --> 00:16:32,260
وما أدراني؟

184
00:16:34,130 --> 00:16:39,350
!تبًّا! وكأنّك تسبقني الآن

185
00:16:39,350 --> 00:16:41,730
...لا أدري ما الّذي يحدث

186
00:16:42,310 --> 00:16:43,870
لكن ما هذا الشّعور؟

187
00:16:43,870 --> 00:16:47,260
!وكأنّني شخص مختلف من ذي قبل

188
00:16:47,980 --> 00:16:53,700
!ربّما... إن بذلت جهدًا أكبر، فسأصير أقوى

189
00:16:54,210 --> 00:16:59,720
!أقوى بكثير ممّا أنا عليه الآن... بقدر قوّته

190
00:17:02,120 --> 00:17:06,250
!أنا آسف! لم أستطع الدّفاع عن المقرّ

191
00:17:10,840 --> 00:17:11,760
!لا تقلق

192
00:17:17,590 --> 00:17:21,220
!كان على قيد الحياة؟ هذا مذهل

193
00:17:22,180 --> 00:17:25,650
.أسمعت بهذا؟ تسبّب قبّعة القشّ بالمشاكل ثانية

194
00:17:26,230 --> 00:17:27,310
.نعم

195
00:17:27,310 --> 00:17:32,730
لم تنتهِ حرب القمّة منذ وقت قصير
وقرع الجرس 16 مرّة الآن؟

196
00:17:32,730 --> 00:17:35,400
أكانت رسالة من نوع ما؟

197
00:17:36,740 --> 00:17:38,570
.لا أدري

198
00:17:38,570 --> 00:17:41,240
لنضع ذلك جانبًا، ماذا عن نقلي؟

199
00:17:41,880 --> 00:17:47,670
حسنًا، سأتحدّث مع سنغوكو-سان
بشأنه، لكن هل أنت جادّ؟

200
00:17:47,670 --> 00:17:50,880
.ما كان أيّ أحد ليمزح في هذا

201
00:17:50,880 --> 00:17:57,300
.أعلم. لكنّ جي 5 ليس مكان يُقصد طواعية

202
00:17:57,300 --> 00:17:59,980
.يملك ذلك المكان الكثير من المشاكل

203
00:18:01,390 --> 00:18:04,810
.فرع البحريّة الخامس في الغراند لاين

204
00:18:05,570 --> 00:18:08,440
.هذا يعني أنّك تريد الذّهاب للعالم الجديد

205
00:18:08,880 --> 00:18:12,610
.من الأفضل دائمًا أن نكون قريبين من أهدافنا

206
00:18:15,240 --> 00:18:19,500
.انتشرت أخبار قبّعة القشّ لوفي في العالم بأكمله

207
00:18:20,490 --> 00:18:23,740
...حتّى في العالم الجديد

208
00:18:23,740 --> 00:18:27,200
"!كان قبّعة القشّ لوفي حيًّا"

209
00:18:28,000 --> 00:18:31,770
".قرع الجرس 16 مرّة لعصر جديد في مارينفورد"

210
00:18:32,540 --> 00:18:34,210
ما هو جرس أوكس؟

211
00:18:36,170 --> 00:18:37,970
...إنّ جرس أوكس

212
00:18:39,000 --> 00:18:41,470
،هو الجرس المقدّس من أوكس لويدز

213
00:18:41,470 --> 00:18:44,890
.سفينة للبحريّة كان لها تأثيري كبير قبل زمن بعيد

214
00:18:45,930 --> 00:18:50,770
في نهاية العام، يقرعونه 8 مرّات
لتقدير السّنة الماضية

215
00:18:50,770 --> 00:18:54,170
و8 مرّات في بداية السّنة
.كدعاء للسّنة الجديدة

216
00:18:54,170 --> 00:18:58,280
،أي يُقرع 16 مرّة في المجمل
.وهذا هو تقليد تتّبعه البحريّة

217
00:18:58,280 --> 00:19:00,320
.هذا هو معنى قرعه 16 مرّة

218
00:19:02,320 --> 00:19:04,660
.لكن لم يحن الوقت لذلك بعد

219
00:19:04,660 --> 00:19:09,120
لذلك ربّما يكون قد فعل ذلك ليعلن
.عن نهاية عصر وبداية آخر

220
00:19:09,120 --> 00:19:11,670
.يريد أن يقول "انتهى عصر اللّحية البيضاء

221
00:19:12,090 --> 00:19:15,920
سأكون أنا من سيشكّل العصر الجديد"؟

222
00:19:16,290 --> 00:19:20,510
،إن لم يكن قد فعلها لتلك الأسباب
...فما كان ليعود للمكان

223
00:19:20,510 --> 00:19:24,020
.حيث عليه أن يعيش ألم فقدانه لأخيه

224
00:19:25,600 --> 00:19:27,890
!يا له من وغد مزعج

225
00:19:28,310 --> 00:19:30,270
،في الحقيقة، بعد الحرب

226
00:19:30,270 --> 00:19:34,860
أخذ الصّدارة بين النّاشئين
.بمكافأة بلغت 100 مليون

227
00:19:35,420 --> 00:19:40,360
.لكنّني لن أسمح له بفعل ما يشاء

228
00:19:43,070 --> 00:19:44,950
...العالم الجديد

229
00:19:45,400 --> 00:19:50,540
،ظننتُ أنّ بإمكاني الاستمتاع أكثر هنا
لكن ما قصّة هؤلاء الجبناء؟

230
00:19:50,540 --> 00:19:55,040
!على رسلك! لم أسبّب لك أيّ أذى

231
00:19:55,040 --> 00:20:00,420
!كنّا نوشك على الخروج من هذا البحر
!دعونا نعود إلى النّعيم أحياءً

232
00:20:00,970 --> 00:20:04,510
النّعيم؟ تقصد موطنك الحبيب؟

233
00:20:04,910 --> 00:20:10,230
وصلتم إلى هنا للتّوّ ولا فكرة
!لديكم عن هذا البحر الرّهيب

234
00:20:17,970 --> 00:20:19,260
قبّعة القشّ؟

235
00:20:19,260 --> 00:20:21,650
.نعم، تسبّب بالمشاكل ثانية

236
00:20:22,200 --> 00:20:24,240
.لا داعي للهلع

237
00:20:24,240 --> 00:20:26,240
...إنّ آخر من سيقوم بكشّ الملك

238
00:20:26,240 --> 00:20:27,830
.سيكون المنتصر

239
00:20:28,660 --> 00:20:30,160
!ماذا حدث؟

240
00:20:30,600 --> 00:20:35,500
أيّها الأب! إنّ السّفينة ليست
!على الماء، إنّها في الهواء

241
00:20:35,500 --> 00:20:37,090
!ماذا قلت؟

242
00:20:37,620 --> 00:20:41,840
ماذا قلت؟ ماذا تعني؟
!سيطروا على السّفينة، اللّعنة

243
00:20:41,840 --> 00:20:44,260
...أيّها الأب! ثمّة شيء ما ينزل من السّماء

244
00:20:47,760 --> 00:20:50,900
!كلاّ، بل نحن من نصعد

245
00:20:56,920 --> 00:20:58,900
.أنا جدّ آسف

246
00:21:01,200 --> 00:21:05,570
.هلاّ كرّرت كلامك؟ لم أسمع أوّل مرّة

247
00:21:05,570 --> 00:21:07,480
!أنا اللّحية البنّيّة

248
00:21:07,480 --> 00:21:10,740
!قرصان تفوق مكافأته 80 مليون

249
00:21:10,740 --> 00:21:12,040
!اللّحية البنّيّة-ساما

250
00:21:12,830 --> 00:21:16,750
!احرص على تذكّر اسمي! هذه منطقتي

251
00:21:17,140 --> 00:21:20,160
!ما فعلتَه برجالي فظيع

252
00:21:20,160 --> 00:21:22,300
!سأجعلك تدفع الثّمن بالدّماء

253
00:21:22,860 --> 00:21:27,190
فهمت. ظننتُ أنّني لم أسمع
.اسمك لأنّه غبيّ جدًّا

254
00:21:28,040 --> 00:21:32,270
.سأخبرك بأمرين. الأوّل هو أنّي لا أحبّ المزاح

255
00:21:32,270 --> 00:21:33,430
المزاح؟

256
00:21:33,880 --> 00:21:35,770
،أمّا بالنّسبة للشّيء الثّاني

257
00:21:37,440 --> 00:21:41,480
.أستطيع رؤية ظلّ الموت على وجهك

258
00:21:49,780 --> 00:21:54,250
!أواثق أنّ البوصلة المسجّلة تشير لتلك الجزيرة؟

259
00:21:54,250 --> 00:21:57,620
!يضرب البرق الجزيرة كالمطر

260
00:21:58,360 --> 00:22:00,040
!لا يمكننا الذّهاب إلى هناك

261
00:22:05,820 --> 00:22:08,420
!كيف نستطيع الذّهاب للشّاطئ؟

262
00:22:10,280 --> 00:22:14,020
الرّجال الجسورين الّذين وطأت أقدامهم
...العالم الجديد ولو لمرّة واحدة

263
00:22:15,160 --> 00:22:17,480
!أيّها الكاهن الأعلى، ثمّة من يقترب منّا

264
00:22:18,610 --> 00:22:19,600
من يكون؟

265
00:22:20,230 --> 00:22:24,530
يصفون جميعًا النّصف الأوّل من
...الغراند لاين بنفس الوصف

266
00:22:25,000 --> 00:22:27,030
...أخبرني أيّها الشّابّ

267
00:22:27,610 --> 00:22:30,320
من هذه الجدّة؟

268
00:22:30,320 --> 00:22:34,350
".كان ذلك البحر أشبه بالنّعيم"

269
00:22:36,370 --> 00:22:38,790
أتريدون مظلّة؟

270
00:22:39,960 --> 00:22:43,920
!إن بقينا هنا، فسنموت قريبًا

271
00:22:43,920 --> 00:22:48,130
!نريد العودة للنّعيم فحسب! رجاءً

272
00:22:48,130 --> 00:22:51,040
.يا لك من مفسد للمرح

273
00:22:52,640 --> 00:22:57,930
...إن لم تكن مستعدًّا للموت

274
00:22:57,930 --> 00:22:59,560
...فلا ترمِ بنفسك

275
00:23:00,310 --> 00:23:04,820
!في هذا البحر

276
00:23:07,570 --> 00:23:13,070
!سأطيح بك قريبًا! من الأفضل أن تستعدّ

277
00:23:13,070 --> 00:23:15,080
!يا قبّعة القشّ

278
00:23:25,520 --> 00:23:28,610
تقارير عن الحادثة الجديد المتعلّقة بلوفي في مارينفورد

279
00:23:28,610 --> 00:23:31,200
.انتشرت حول العالم في لمح البصر

280
00:23:31,200 --> 00:23:33,640
،الجميع حائرون بسبب أفعاله الغامضة

281
00:23:33,640 --> 00:23:35,430
.وكذلك أصدقاؤه

282
00:23:35,430 --> 00:23:37,970
.لكنّ للوفي سبب وجيه لتصرّفاته تلك

283
00:23:37,970 --> 00:23:40,770
!ما الّذي يفكّر فيه لوفي بالضّبط؟

284
00:23:40,770 --> 00:23:42,130
:في الحلقة القادمة من وان بيس

285
00:23:42,130 --> 00:23:44,980
!تحت أمل أن تصل لأصدقائي"
"!تنتشر الأخبار المهمّة بسرعة

286
00:23:44,980 --> 00:23:47,370
!ملك القراصنة، لن يكون إلاّ أنا

287
00:23:49,900 --> 00:23:54,910
!!نلقاكم في الحلقة القادمة