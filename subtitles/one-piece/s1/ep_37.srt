1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:02:15,130 --> 00:02:16,860
ما الخطب يا فتاة؟

26
00:02:22,980 --> 00:02:26,140
هل تريدين منّي إرجاع القريّة بهذا القدر؟

27
00:02:29,150 --> 00:02:32,360
إذًا ما رأيكِ أن نعقد اتّفاقًا؟

28
00:02:32,360 --> 00:02:33,770
اتفاق؟

29
00:02:33,770 --> 00:02:35,080
.صحيح

30
00:02:35,080 --> 00:02:38,090
.اجمعي مائة مليون بيري وأحضريها إلى هنا

31
00:02:38,090 --> 00:02:42,110
.افعلي وسأترك القرية وأمنحك حريّتك

32
00:02:42,400 --> 00:02:43,320
!صدقًا؟

33
00:02:43,540 --> 00:02:45,260
!صدقًا

34
00:02:45,260 --> 00:02:49,660
.أفضّل الموت على أن أنكث وعدًا يخصّ المال

35
00:02:49,660 --> 00:02:51,570
.مهما استغرق ذلك من سنوات

36
00:02:51,570 --> 00:02:53,290
.سأفي باتّفاقنا

37
00:02:58,970 --> 00:03:01,640
!سأجمع مائة مليون بيري بكل تأكيد

38
00:03:02,350 --> 00:03:04,500
!بيلمير-سان! سأفعلها

39
00:03:04,770 --> 00:03:06,600
!مهما استغرقني ذلك من وقت

40
00:03:09,950 --> 00:03:14,190
"!وقوف لوفي! عاقبة الوعد المنكوث"

41
00:03:22,720 --> 00:03:25,220
غين-سان؟ وقوّات البحريّة؟

42
00:03:31,820 --> 00:03:34,450
هل أنتِ الفتاة اللّصة المعروفة بنامي؟

43
00:03:36,400 --> 00:03:42,320
.تفيد معلوماتنا أنّكِ اخبأتِ الكنوز الّتي سرقتها من القراصنة

44
00:03:42,320 --> 00:03:47,630
!بموجب هذا، تصادر الحكومة كلّ الممتلكات الّتي سرقتها

45
00:03:53,380 --> 00:03:55,980
ما الخطب؟ ألم تسمعيني؟

46
00:03:56,560 --> 00:03:58,600
بموجب هذا، تتولى الحكومة حيازة

47
00:03:58,600 --> 00:04:01,650
.كلّ ما سرقته من القراصنة

48
00:04:03,700 --> 00:04:08,200
.عجبًا. أرى أنّك متحمّس جدًا بشأن واجباتك

49
00:04:08,610 --> 00:04:11,480
،لستم شجعانًا بما يكفي لمواجهة القراصنة

50
00:04:11,480 --> 00:04:13,780
.لذلك تتعاملون مع اللّصوص المتسلّلين بدلًا من ذلك لتحصلوا على المديح

51
00:04:13,780 --> 00:04:15,650
!يا للفخامة

52
00:04:18,830 --> 00:04:20,790
.إليكم ما ينتظركم

53
00:04:20,790 --> 00:04:22,960
.أنا قائدة ضمن قراصنة أرلونغ

54
00:04:22,960 --> 00:04:26,040
!لن يجلس أرلونغ ساكنًا إن عبثتم معي

55
00:04:27,140 --> 00:04:32,410
أيّتها الفتاة السّخيفة. أتظنّين أنّكِ في نفس مستواي؟

56
00:04:32,630 --> 00:04:34,090
!جدوا المسروقات

57
00:04:36,090 --> 00:04:36,980
!انتظروا

58
00:04:42,660 --> 00:04:43,840
!توقّفوا

59
00:04:49,990 --> 00:04:52,830
!أهذا ما على قوّات البحريّة فعله الآن؟

60
00:04:53,150 --> 00:04:56,730
!قام قراصنة أرلونغ بقتل النّاس، حتّى أنّهم دمّروا بلدات

61
00:04:56,730 --> 00:04:57,670
!تعلمون ذلك

62
00:04:58,280 --> 00:05:02,300
!إنّه يحكم هذه الجزيرة ويدوس على حياة النّاس

63
00:05:02,300 --> 00:05:03,930
هل تجاهل تلك المشكلة الكبيرة

64
00:05:03,930 --> 00:05:06,270
وجمع أغراضٍ مسروقة من لصّ

65
00:05:06,270 --> 00:05:07,470
!هو ما ترمز إليه الحكومة؟

66
00:05:08,970 --> 00:05:11,370
.لا تتحدّثي بتعالٍ

67
00:05:11,370 --> 00:05:12,460
!تابعوا بحثكم

68
00:05:12,900 --> 00:05:17,420
!كان الجميع في الجزيرة ينتظرون مساعدتكم منذ سنين

69
00:05:17,760 --> 00:05:20,930
!كيف تجرؤون على تجاهلهم والمجيء إلى هنا؟

70
00:05:21,270 --> 00:05:24,050
!أيّها العقيد! يبدو بستان اليوسفيّ هذا مشبوهًا

71
00:05:24,050 --> 00:05:24,900
!احفره

72
00:05:29,050 --> 00:05:32,400
!أبعد يداك القذرتان عن بستان اليوسفيّ الخاص ببيلمير-سان

73
00:05:35,660 --> 00:05:37,260
!لن أدعكم تأخذون مالي

74
00:05:37,260 --> 00:05:39,320
...إنّه مال الـ
...إنّه مال الـ

75
00:05:41,610 --> 00:05:45,590
!مال هذه الفتاة مخصّص لإنقاذ قرية كوكوياشي

76
00:05:45,590 --> 00:05:49,830
!ما الّذي يعطيك الحقّ في أخذه يا رجل البحريّة؟

77
00:05:51,930 --> 00:05:56,800
ماذا؟ ممثّل قرية وضيع يقلّل من احترام عقيدٍ في القوّات البحريّة؟

78
00:05:57,660 --> 00:06:00,920
غين-سان... كيف تدري بذلك؟

79
00:06:05,110 --> 00:06:06,970
.لطالما عرفت يا نامي

80
00:06:10,450 --> 00:06:12,050
...أنا... سأنضمّ

81
00:06:12,050 --> 00:06:12,620
ماذا؟

82
00:06:13,560 --> 00:06:16,080
...سأنضمّ إلى... قراصنة أرلونغ

83
00:06:16,450 --> 00:06:16,920
!نامي

84
00:06:19,060 --> 00:06:19,950
...أنتِ

85
00:06:20,150 --> 00:06:20,940
...نامي

86
00:06:21,580 --> 00:06:25,010
،لم أصدّق ما فعلته آنذاك

87
00:06:25,010 --> 00:06:26,910
.لذا واجهت نوجيكو لاحقًا

88
00:06:26,910 --> 00:06:29,380
عرف الجميع في القرية حينها

89
00:06:29,380 --> 00:06:33,930
.أنّكِ بقيتِ مع قراصنة أرلونغ لكي تنقذي القرية

90
00:06:34,140 --> 00:06:37,220
.لكنّنا ادّعينا جهلنا

91
00:06:37,220 --> 00:06:41,060
لأنّ آمالنا ستمنعكِ من الهرب من أرلونغ

92
00:06:41,060 --> 00:06:43,380
.ما إن قرّرتِ ذلك

93
00:06:43,920 --> 00:06:45,380
...لا يعقل

94
00:06:48,100 --> 00:06:51,030
عمّاذا تتحدّث؟

95
00:06:51,030 --> 00:06:53,470
،هل تقصد أنّ جميع أهل القرية لصوص

96
00:06:53,470 --> 00:06:56,740
وعلينا القبض عليهم؟

97
00:06:56,740 --> 00:07:01,030
!بل يقصد أنّ كلّ واحدٍ منّا يقاتل ليعيش

98
00:07:01,970 --> 00:07:05,360
!وذلك فقط لأنّنا لا نستطيع الاعتماد عليكم يا أتباع الحكومة

99
00:07:05,970 --> 00:07:09,820
!إن كنتم لن تُنقذوا قريتنا، فغادروا حالًا

100
00:07:10,390 --> 00:07:13,560
!اعبثوا هنا وسيهجم أرلونغ على سفينتكم أيضًا

101
00:07:13,560 --> 00:07:17,430
...السيّد أرلونغ؟ أشكّ في ذلك

102
00:07:19,670 --> 00:07:21,240
!ألم تجدوه بعد؟

103
00:07:21,240 --> 00:07:24,610
!إنّنا نبحث عن مائة مليون هنا وليس حبّة أرزّ

104
00:07:26,240 --> 00:07:29,050
!أنت! كيف تعلم القدر الّذي هناك؟

105
00:07:31,000 --> 00:07:32,950
أتقصد المائة مليون؟

106
00:07:32,950 --> 00:07:36,290
.ساورني حدسٌ أنّ هنالك ذلك القدر فحسب

107
00:07:47,080 --> 00:07:48,490
...أيعقل أنّه

108
00:07:54,140 --> 00:07:57,120
!أيعقل أنّ أرلونغ أرسلك إلى هنا؟

109
00:07:58,950 --> 00:08:00,470
من يدري؟

110
00:08:00,470 --> 00:08:06,680
.إنّنا نتعامل مع قضيّة سرقة كما يفعل أيّ موظّفين حكوميّين ببساطة

111
00:08:07,000 --> 00:08:09,350
!يا لكم من حثالة

112
00:08:09,350 --> 00:08:12,060
!لا أصدّق أنّ البحريّة ستنزل إلى مستوى التواطؤ مع القراصنة

113
00:08:14,300 --> 00:08:15,810
!أرلونغ

114
00:08:16,160 --> 00:08:17,420
!وجدّته

115
00:08:26,180 --> 00:08:27,810
!هذا مُذهل

116
00:08:27,810 --> 00:08:31,090
!أنا مُنبهر لأنّكِ استطعتِ جمع كل هذا القدر يا فتاة

117
00:08:31,310 --> 00:08:33,540
...إنّهُ ممزّق وملطّخ بالدّماء

118
00:08:33,540 --> 00:08:35,540
!لا يهمّ! يظل المالُ مالًا

119
00:08:38,630 --> 00:08:41,510
!ثلاثون بالمائة من هذا سيصبح لي

120
00:08:41,710 --> 00:08:43,390
...لا تلمسوه

121
00:08:43,880 --> 00:08:47,000
...لا تلمسوه... لا تلمسوه

122
00:08:47,930 --> 00:08:48,970
...نامي

123
00:08:49,900 --> 00:08:52,050
...لا تلمسوه... لا تلمسوه

124
00:08:52,250 --> 00:08:53,680
!لا تلمسوه

125
00:09:09,550 --> 00:09:10,740
!نامي

126
00:09:16,030 --> 00:09:19,390
!نوجيكو

127
00:09:23,850 --> 00:09:25,680
مروحة؟

128
00:09:34,460 --> 00:09:36,790
!تبًا، كان ذلك رائعًا

129
00:09:39,550 --> 00:09:41,480
!توصّلتُ إلى حركة جديدة

130
00:09:43,130 --> 00:09:45,360
!أيّها الطّبيب! أيّها الطّبيب

131
00:09:46,630 --> 00:09:48,450
ماذا هناك يا غين-سان؟

132
00:09:48,450 --> 00:09:49,850
!تعرّضت نوجيكو لطلقٍ ناريّ

133
00:09:49,850 --> 00:09:51,080
!ممّن؟

134
00:09:51,080 --> 00:09:52,240
!قوّات البحريّة

135
00:09:52,240 --> 00:09:53,130
قوّات البحريّة؟

136
00:09:54,360 --> 00:09:55,330
!نوجيكو

137
00:09:55,940 --> 00:09:57,110
...أنا بخير

138
00:09:57,790 --> 00:10:00,230
.كان أرلونغ متواطئًا مع قوّات البحريّة

139
00:10:00,230 --> 00:10:01,060
!ماذا؟

140
00:10:01,420 --> 00:10:04,200
.كان يكذب على نامي لثمان سنوات

141
00:10:04,200 --> 00:10:06,560
!لم يكن ينوي أبدًا الحفاظ على اتّفاقهما

142
00:10:06,760 --> 00:10:07,840
!ماذا قلت؟

143
00:10:07,840 --> 00:10:09,600
...مُحال! إذًا

144
00:10:09,600 --> 00:10:12,210
!ذاك الوغد! كذب على عزيزتنا نا-تشان

145
00:10:12,210 --> 00:10:13,450
!نا-تشان

146
00:10:17,570 --> 00:10:18,530
...نامي

147
00:10:19,020 --> 00:10:23,080
أهلًا يا نامي! ما الأخبار؟ هل تحتاجين المساعدة في أيّ شيء؟

148
00:10:25,670 --> 00:10:26,900
!أما زِلت هنا؟

149
00:10:27,940 --> 00:10:31,420
!لا علاقة لهذا الأمر بكم! غادروا الجزيرة فورًا

150
00:10:38,700 --> 00:10:41,820
!...أرلونغ...! أرلونغ

151
00:10:42,650 --> 00:10:43,540
!أرلونغ

152
00:10:44,060 --> 00:10:48,180
.أُفضّل الموت على أن أنكث وعدًا يخصّ المال

153
00:10:48,180 --> 00:10:50,380
.مهما استغرق ذلك من سنوات

154
00:10:50,380 --> 00:10:52,060
.سأفي باتّفاقنا

155
00:10:52,770 --> 00:10:54,230
!أرلونغ

156
00:10:58,940 --> 00:11:00,950
ما مشكلتها؟

157
00:11:16,790 --> 00:11:18,080
!أرلونغ

158
00:11:20,370 --> 00:11:25,010
أهلًا! ما المشكلة يا معاينتنا الماهرة؟

159
00:11:25,010 --> 00:11:27,070
لِمَ هذا الوجه الغاضب؟

160
00:11:29,060 --> 00:11:32,970
!سرق رجال البحريّة الذين تسيطر عليهم كلّ مالي

161
00:11:33,660 --> 00:11:37,990
!ماذا عن قولك أنّك تفضّل الموت على أن تنكث وعدًا يخصّ المال؟

162
00:11:37,990 --> 00:11:39,430
!لماذا؟

163
00:11:39,430 --> 00:11:41,680
متى نكثت وعدنا؟

164
00:11:42,010 --> 00:11:45,160
...لا تدّعِ الغباء! تواطأت مع البحريّة لأجل

165
00:11:47,280 --> 00:11:50,940
!متى نكثت وعدنا؟ أخبريني

166
00:11:59,280 --> 00:12:03,010
!سحقًا لك! سحقًا لك! سحقًا لك

167
00:12:04,810 --> 00:12:07,950
فهمت! سُرق مالكِ إذًا؟

168
00:12:07,950 --> 00:12:10,490
.يا للأسف

169
00:12:10,490 --> 00:12:13,010
.لكنّ الاتّفاق يبقى اتّفاقًا

170
00:12:13,010 --> 00:12:15,830
،إلّم تحضري لي مائة مليون بيري

171
00:12:15,830 --> 00:12:19,800
.أخشى أنّني لا أستطيع إعادة الجزيرة لكِ

172
00:12:21,400 --> 00:12:22,440
!أيّها الحثالة

173
00:12:25,550 --> 00:12:29,900
!ما هي إلّا مائة مليون بيري! ابدأي بجمعها ثانيةً

174
00:12:33,400 --> 00:12:36,170
أم أنّكِ ستهربين منّي؟

175
00:12:37,570 --> 00:12:42,660
.لكن إن هربتِ، فسأقتل جميع من في قرية كوكوياشي

176
00:12:46,430 --> 00:12:47,230
...نامي

177
00:12:47,570 --> 00:12:50,090
.ادّعينا جهلنا

178
00:12:50,410 --> 00:12:56,780
.لأنّ آمالنا ستمنعكِ من الهرب من أرلونغ ما إن قرّرتِ ذلك

179
00:13:02,230 --> 00:13:05,500
هل ستهربين أخيرًا؟

180
00:13:08,650 --> 00:13:10,450
ألا يجب أن نلاحقها؟

181
00:13:10,450 --> 00:13:15,590
.نلاحقها؟ لماذا؟ لن تهرب

182
00:13:15,590 --> 00:13:20,340
.ما كانت لتتخلّى أبدًا عن حياة أهل قريتها

183
00:13:21,050 --> 00:13:24,060
...تجيد اللّعب بدناءة حقًا

184
00:13:24,060 --> 00:13:28,160
.ما كنتُ لأترك معاينة ممتازة كنامي تذهب بسهولة أبدًا

185
00:13:28,350 --> 00:13:31,620
.لكنّي لستُ شيطانًا بلا قلب

186
00:13:32,770 --> 00:13:36,140
،فور أن تنتهي من معاينة كلّ بحار العالم

187
00:13:36,140 --> 00:13:38,010
!سأمنحها حريّتها

188
00:13:40,650 --> 00:13:43,670
!أي بعد عقودٍ من الآن

189
00:13:44,100 --> 00:13:47,000
!ولا حتّى مائة سنة ستكون كافية

190
00:13:51,120 --> 00:13:55,070
!حسنًا دعونا نلتقي بلوفي بأسرع ما يمكن

191
00:13:56,150 --> 00:13:58,770
سانجي. ما الّذي تفعله؟

192
00:13:58,770 --> 00:14:01,040
.أقدّر السّعادة

193
00:14:01,240 --> 00:14:03,200
عمّاذا تتحدّث؟

194
00:14:03,200 --> 00:14:07,120
.عاشت نامي-سان معاناة أضعاف ما يعيشه الشّخص العاديّ

195
00:14:10,690 --> 00:14:13,860
.سأخلّصها من تلك المعاناة

196
00:14:14,270 --> 00:14:16,500
أتوجد سعادةٌ أعظم من هذه؟

197
00:14:17,900 --> 00:14:21,410
.دافعك الخفيّ واضح يا طبّاخ الحبّ

198
00:14:23,010 --> 00:14:26,640
إنّي أُقاتل لأجل شخصٍ جميل. ما الضّير في ذلك؟

199
00:14:26,990 --> 00:14:31,160
!هذا ليس بيت القصيد! بل هذا لأجل نامي وأهل القرية

200
00:14:31,550 --> 00:14:32,690
.اخرس

201
00:14:39,380 --> 00:14:42,820
!كفّا عن الثرثرة ولنذهب

202
00:14:48,270 --> 00:14:49,950
!اكتفينا من هذا! تسلّحوا

203
00:14:49,950 --> 00:14:51,010
!فلنقاتل

204
00:14:55,270 --> 00:14:59,300
!غين-سان! الجميع! لا تتسرّعوا رجاءً

205
00:14:59,810 --> 00:15:02,490
!لا يُمكنكم أن تموتوا! سينتهي كل شيء

206
00:15:03,130 --> 00:15:06,140
!عليكم أن تنجوا وإلّا سينتهي كلّ شيء

207
00:15:06,140 --> 00:15:11,550
!أقسمنا قبل ثمان سنوات ألّا نهدر حياتنا

208
00:15:11,840 --> 00:15:14,360
،مهما كان حكمهم لنا مؤلمًا ومذلًا

209
00:15:14,980 --> 00:15:19,380
!أقسمنا أن نقاتل بصبرنا ما دامت نامي مبتهجة

210
00:15:19,820 --> 00:15:22,530
!لكن هذا كان جوابهم

211
00:15:23,100 --> 00:15:27,500
!بعد أن اندثرت فرصة قريتنا في الحريّة، ما عدنا نملك أملًا

212
00:15:27,500 --> 00:15:28,460
،والأكثر من ذلك

213
00:15:29,030 --> 00:15:33,500
!علينا أن نجعل أولئك البرمائيين يدفعون ثمن تلاعبهم بطيبة تلك الفتاة

214
00:15:33,500 --> 00:15:34,160
!هل من اعتراض؟

215
00:15:34,830 --> 00:15:36,360
!بالطّبع لا! هيّا بنا

216
00:15:36,360 --> 00:15:40,210
!كنّا على أهبة الاستعداد دائمًا للقتال في أيّ وقت

217
00:15:40,630 --> 00:15:43,350
!أرفض أن أدعهم يحكمونني بعد الآن

218
00:15:45,220 --> 00:15:47,400
!انتظروا جميعًا

219
00:15:48,920 --> 00:15:49,940
!نامي

220
00:15:53,710 --> 00:15:56,780
!القليل فقط! انتظروا قليلًا فقط

221
00:15:56,780 --> 00:15:58,850
!سأعمل بجدٍّ ثانيةً

222
00:15:58,850 --> 00:16:00,950
!سأجمع المال مجددًا

223
00:16:01,440 --> 00:16:03,070
!سيكون ذلك سهلًا هذه المرّة

224
00:16:03,270 --> 00:16:07,320
!اعتدتُ على ذلك! سيكون الأمر بخير! لا داعي للقلق على الإطلاق

225
00:16:08,160 --> 00:16:10,750
!هذا لا يُعدُّ شيئًا مقارنة بآنذاك

226
00:16:13,000 --> 00:16:15,440
!رجاءً، لا مزيد من القتل

227
00:16:15,440 --> 00:16:19,100
!جميعًا! أنا بخير! بخير حال

228
00:16:26,990 --> 00:16:30,430
...يُمكنك أن تتوقّفي الآن... حتّى أنتِ تعلمين أنّه ما من مغزى

229
00:16:31,200 --> 00:16:35,540
...قاتلتِ ببسالة حاملةً حياتنا على عاتقكِ طوال هذه السّنين

230
00:16:35,780 --> 00:16:39,260
لا بدّ أنّ انضمامكِ إليهم كان أشدّ ألمًا

231
00:16:39,260 --> 00:16:41,660
...من طعنةٍ في القلب

232
00:16:42,940 --> 00:16:45,040
.قاتلتِ ببسالة

233
00:16:46,520 --> 00:16:47,880
...غين-سان

234
00:16:54,270 --> 00:16:56,170
.اتركي القرية الآن

235
00:16:57,760 --> 00:16:58,590
!غين-سان؟

236
00:16:59,650 --> 00:17:01,140
.افعليها يا نامي

237
00:17:01,140 --> 00:17:02,470
!مـ-ماذا؟

238
00:17:03,230 --> 00:17:04,220
...نا-تشان

239
00:17:04,220 --> 00:17:05,160
...نامي

240
00:17:06,370 --> 00:17:09,660
.أنتِ ذكيّة وتملكين حلمًا

241
00:17:09,950 --> 00:17:11,430
!نوجيكو! جميعكم

242
00:17:12,840 --> 00:17:14,270
!لن أدعكم

243
00:17:15,380 --> 00:17:16,930
!توقّفوا، جميعًا

244
00:17:16,930 --> 00:17:19,830
!لا أُريد أن أرى أيّ أحد آخر يتعرّض للأذى بسببهم

245
00:17:22,440 --> 00:17:23,580
!ستموتون

246
00:17:24,510 --> 00:17:25,660
.نعلم

247
00:17:32,880 --> 00:17:36,150
!لا فائدة! حسمنا أمرنا

248
00:17:39,920 --> 00:17:41,500
!تنحّي عن طريقنا يا نامي

249
00:17:43,890 --> 00:17:45,430
!هيّا بنا جميعًا

250
00:17:45,430 --> 00:17:48,730
!حتّى إنّ كنّا لا نستطيع الفوز، فلنرهم معدننا الحقيقيّ

251
00:18:26,010 --> 00:18:27,930
!أرلونغ

252
00:18:30,140 --> 00:18:32,970
!أرلونغ! أرلونغ

253
00:18:35,270 --> 00:18:37,340
!أرلونغ! أرلونغ

254
00:18:37,560 --> 00:18:40,280
!أرلونغ! أرلونغ! أرلونغ

255
00:18:40,280 --> 00:18:42,560
!أرلونغ! أرلونغ

256
00:18:42,970 --> 00:18:43,490
...أرلـ

257
00:18:49,780 --> 00:18:50,700
...لوفي

258
00:18:55,220 --> 00:18:58,230
!ماذا تريد؟
!أنت لا تعلم أيّ شيءٍ أساسًا

259
00:18:58,620 --> 00:19:02,340
!لا تدري حتّى ما حدث في هذه الجزيرة قبل ثمانية أعوام

260
00:19:02,340 --> 00:19:03,810
.نعم، لا أدري

261
00:19:05,440 --> 00:19:07,020
!لا علاقة لهذا بك

262
00:19:08,100 --> 00:19:10,470
!أخبرتكم أن تغادروا هذه الجزيرة فورًا

263
00:19:10,470 --> 00:19:12,280
.نعم، أخبرتنا

264
00:19:12,280 --> 00:19:15,080
!غادروا! لستُ بحاجتكم

265
00:19:15,080 --> 00:19:18,650
!غادروا! غادروا! غادروا! غادروا

266
00:19:18,650 --> 00:19:21,910
!غادروا! غادروا! غادروا

267
00:19:22,220 --> 00:19:23,510
!غادروا

268
00:19:44,100 --> 00:19:44,970
...لوفي

269
00:19:46,810 --> 00:19:48,080
...ساعدني

270
00:20:03,700 --> 00:20:06,690
!بالطّبع سأفعل

271
00:20:09,030 --> 00:20:11,210
!إيّاك أن تلمس كنزي

272
00:20:13,220 --> 00:20:14,320
...لوفي

273
00:20:23,370 --> 00:20:24,090
.هيّا بنا

274
00:20:25,890 --> 00:20:26,790
!أجل

275
00:20:31,230 --> 00:20:33,990
!هل أنتما بخير؟

276
00:20:33,990 --> 00:20:35,700
!هل أرلونغ من فعل بكما هذا؟

277
00:20:37,350 --> 00:20:38,610
.تنحّيا

278
00:20:39,920 --> 00:20:42,260
.لدينا شيءٌ نسوّيه مع البرمائيين

279
00:20:42,950 --> 00:20:45,740
،بما أنّنا نعلم حقيقة أختنا الكبيرة نامي

280
00:20:45,740 --> 00:20:49,230
.شعرنا أنّ الشّيء الوحيد الّذي نستطيع فعله هو هزيمة أرلونغ

281
00:20:49,470 --> 00:20:51,850
...لذا تحدّيناه

282
00:20:52,290 --> 00:20:54,610
.لكنّنا خسرنا بسهولة

283
00:20:56,410 --> 00:20:59,120
،آسف، لكن لن ندعكم تدخلون هذا الباب

284
00:20:59,120 --> 00:21:00,750
!بما أنّكم لا تملكون أي فرصة للانتصار

285
00:21:00,970 --> 00:21:01,720
!ماذا؟

286
00:21:01,960 --> 00:21:06,140
!إنّنا ننتظر مجيء رجالٍ معيّنين

287
00:21:06,540 --> 00:21:08,210
رجال معيّنين؟

288
00:21:08,680 --> 00:21:13,030
!أُراهن بحياتي أنّهم سيأتون

289
00:21:28,380 --> 00:21:29,140
!ها هم ذا

290
00:21:45,070 --> 00:21:46,250
...إنّهم هم

291
00:21:46,400 --> 00:21:49,190
من يكونون؟

292
00:21:49,590 --> 00:21:52,380
،إن كانوا لا يستطيعون التّكفل بهم

293
00:21:52,400 --> 00:21:54,520
،فلا أمل يُرجى لهذه الجزيرة

294
00:21:54,520 --> 00:21:57,210
!بل لمستقبل الأزرق الشرقيّ كلّه

295
00:21:57,980 --> 00:22:01,140
...وجوه أولئك الرّجال الذّين أتوا إلى هنا لتغيير مصير هذه الجزيرة

296
00:22:01,360 --> 00:22:04,380
!احفروها في أذهانكم

297
00:22:13,640 --> 00:22:14,720
.تنحّوا

298
00:22:21,920 --> 00:22:26,740
أنتم، هل تظنّون أنّ ذلكما الغبيّين كانا من جماعة زورو؟

299
00:22:27,110 --> 00:22:29,880
.زورو؟ يبدوان ضعيفين جدًا على ذلك

300
00:22:29,880 --> 00:22:31,440
.لا يستحقّان القتل حتّى

301
00:22:31,440 --> 00:22:32,970
!أكيد

302
00:22:46,880 --> 00:22:47,830
ما الّذي...؟

303
00:22:50,910 --> 00:22:52,840
!أيّكم هو أرلونغ؟

304
00:22:57,000 --> 00:23:01,840
مشاعري الجيّاشة لا تتّصل

305
00:23:01,840 --> 00:23:06,670
بينما أشدّ على يدك بثبات

306
00:23:06,670 --> 00:23:11,580
،سأشدّ الشّراع بنفسي

307
00:23:11,580 --> 00:23:17,250
لذا واصل مشاهدتي
باهتمام بينما أبتعد

308
00:23:21,550 --> 00:23:26,760
كان يجول هذا في ذهني قليلًا
منذ هذا الصّباح

309
00:23:26,760 --> 00:23:31,360
لمَ الجوّ حار؟

310
00:23:31,360 --> 00:23:41,670
،بدءًا من تلك النّقطة
لم أستطع التّهرّب من ذلك

311
00:23:42,670 --> 00:23:47,680
أريد أن أمسك تلك المشاعر
،الّتي رحلت بسرعة

312
00:23:47,680 --> 00:23:52,520
حتّى أنّني مستعدّ لأباغت نفسي

313
00:23:52,520 --> 00:23:57,560
أريد أن أعانق أحلامي
الّتي قفزت من صدري

314
00:23:57,560 --> 00:24:02,660
معك، أستطيع الرّكض إلى هناك

315
00:24:11,540 --> 00:24:13,110
!تقدّمت من نفسك

316
00:24:13,340 --> 00:24:15,510
!أخبرتك ألّا تأخذ كل الفرائس

317
00:24:15,510 --> 00:24:16,480
حقًا؟

318
00:24:16,480 --> 00:24:16,900
ماذا؟

319
00:24:16,900 --> 00:24:17,620
!ما الخطب؟

320
00:24:17,620 --> 00:24:19,920
!أجل، هذا ما في الأمر! أنا في مأزق نوعًا ما! اسمعوني

321
00:24:19,920 --> 00:24:22,590
!سحقًا! ذاك الشّخص ينوي على فعل شيء

322
00:24:22,590 --> 00:24:25,150
!ما العمل؟! ما العمل؟ ما العمل؟

323
00:24:26,060 --> 00:24:27,390
!لوفي

324
00:24:27,390 --> 00:24:28,630
:في الحلقة القادمة من ون بيس

325
00:24:28,630 --> 00:24:31,860
"لوفي في مأزق كبير! البرمائيون ضدّ قراصنة لوفي"

326
00:24:31,860 --> 00:24:34,160
!ملك القراصنة لن يكون إلّا أنا