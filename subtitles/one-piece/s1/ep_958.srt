1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:01,380 --> 00:02:04,400
.إنّ مؤتمر "ليفيلي" يسبّب الحوادث دائمًا

29
00:02:05,320 --> 00:02:11,480
حتّى إن كانت هنالك خلافات، فسأسمّي
.ما بينهم سلامًا ما دامت لم تُرق الدّماء

30
00:02:11,850 --> 00:02:14,660
!لكنّ ما حدث هذه المرّة ليس جيّدًا

31
00:02:14,920 --> 00:02:20,190
،ربّما فات الأوان على قول هذا
.لكن ثمّة أمر واحد في الحقيقة لم أخبرك به

32
00:02:20,190 --> 00:02:25,630
بعد أن فُضّ مؤتمر "ليفيلي" مباشرة
،وانطلقنا مغادرين، وقعت حادثة ما

33
00:02:25,630 --> 00:02:28,390
.وتلقّيت التّقرير على متن السّفينة

34
00:02:29,120 --> 00:02:33,810
سنبذل نحن البحريّة قصارى جهدنا
...لحلّها، لكن أرجوكم لا تخافوا

35
00:02:33,810 --> 00:02:37,270
!من العالم السّطحيّ وكذا البشر

36
00:02:37,270 --> 00:02:40,440
!مهلاً! ما الغاية من كلّ هذا؟

37
00:02:43,740 --> 00:02:45,470
!"ضباب"

38
00:02:46,550 --> 00:02:49,550
...ضميرك حيّ كالعادة

39
00:02:49,550 --> 00:02:52,560
...حسنًا، إنّها قاعدة

40
00:02:52,560 --> 00:02:54,540
!صحيح! استمع

41
00:02:54,540 --> 00:02:57,440
...ثمّة أمر عليّ أن أبلغك به

42
00:02:57,440 --> 00:02:58,630
!أيّها النّقيب

43
00:03:01,790 --> 00:03:07,200
وبالتّالي، سيتنازل كلّ الشّيتشيبوكاي
،الملكيّين عن كلّ حقوقهم بالطّبع

44
00:03:07,200 --> 00:03:10,990
.وعلاقاتهم مع حكومة العالم ستُقطع

45
00:03:10,990 --> 00:03:12,100
!...ممّا يعني

46
00:03:12,700 --> 00:03:14,120
!باغي

47
00:03:14,120 --> 00:03:18,340
!أنت مجرّد قرصان آخر الآن

48
00:03:19,230 --> 00:03:21,480
!هذا ليس عدلاً أيّها المغفّلون

49
00:03:21,480 --> 00:03:26,170
تمّ اتّخاذ القرار دون إعلامنا، وبما أنّنا
!لم نعد مفيدين، ستعتقلوننا؟

50
00:03:26,170 --> 00:03:28,430
!لا حسّ عدالة لديكم على الإطلاق

51
00:03:28,430 --> 00:03:33,060
تحايل كروكودايل دوفلامينغو
!عليكم لا علاقة له بعملي

52
00:03:33,060 --> 00:03:36,020
!لا تنفّسوا عن غضبكم عليّ

53
00:03:36,020 --> 00:03:38,920
!السّاحل بأكمله محاصر

54
00:03:39,440 --> 00:03:40,790
ماذا نفعل؟

55
00:03:40,790 --> 00:03:45,000
!بالطّبع سنقاتلهم بطريقة مبهرجة

56
00:03:49,630 --> 00:03:52,140
!أظهروا بعض الجرأة

57
00:03:52,140 --> 00:03:54,850
!أيّها الحمقى

58
00:03:55,870 --> 00:03:58,730
!هذا هو رئيسنا باغي

59
00:03:59,830 --> 00:04:03,650
!باغي! باغي! باغي! باغي

60
00:04:03,650 --> 00:04:07,150
!يبدو أنّهم ما عادوا في صفّنا

61
00:04:07,150 --> 00:04:09,550
...هذا لا يُغتفر

62
00:04:09,550 --> 00:04:13,470
!ويفيل! أمنحك الإذن للإطاحة بهم

63
00:04:13,470 --> 00:04:15,580
...فعلاً؟ إذًا

64
00:04:15,580 --> 00:04:18,500
!سأقتلهم

65
00:04:19,940 --> 00:04:23,200
!باسم اللّحية البيضاء

66
00:04:23,520 --> 00:04:25,340
...أشعر برعشة حماس

67
00:04:25,860 --> 00:04:27,710
...مرّ وقت طويل

68
00:04:29,610 --> 00:04:32,680
.مذ كنتُ أنا من يُطارَد

69
00:04:34,300 --> 00:04:35,970
!أيّتها الجدّة نيون

70
00:04:35,970 --> 00:04:37,950
!ثمّة سفن تابعة للبحريّة على السّاحل

71
00:04:37,950 --> 00:04:39,140
!ماذا قلت؟

72
00:04:39,140 --> 00:04:41,940
!بدؤوا تحرّكاتهم بالفعل؟

73
00:04:43,580 --> 00:04:45,400
!لا تهلعن

74
00:04:47,710 --> 00:04:48,990
!أميرة الثّعابين

75
00:04:49,090 --> 00:04:51,890
...أعتقد أنّهم

76
00:04:53,050 --> 00:04:54,950
!قد نسوا أمرًا

77
00:04:54,950 --> 00:04:58,490
...أصبحنا أعضاء في الشّيتشيبوكاي الملكيّين

78
00:05:00,640 --> 00:05:03,460
!لأنّنا أقوياء

79
00:05:04,310 --> 00:05:06,630
!بدأت الأمور تصبح أكثر متعة

80
00:05:16,660 --> 00:05:20,730
"!معركة أسطوريّة! غارب وروجر"

81
00:05:41,520 --> 00:05:45,250
.لا بدّ أنّك سعيد يا إيشّو

82
00:05:45,250 --> 00:05:49,130
.كان إلغاء نظام الشّيتشيبوكاي هو غايتك

83
00:05:49,340 --> 00:05:54,200
.لقد عارضتُه، لكنّ قرار القادة لا يمكن الرّجوع عنه

84
00:05:54,200 --> 00:05:58,050
!سُحقًا، ما مدى سذاجة الجميع؟

85
00:05:58,050 --> 00:06:00,680
...للعدالة ثمن دائمًا

86
00:06:00,680 --> 00:06:03,850
ولا مهرب منها؟

87
00:06:05,830 --> 00:06:11,340
.لا يمكنك أن تفهم لأنّك لم تكن يومًا واحدًا منهم

88
00:06:11,340 --> 00:06:14,880
...العالم الّذي يتمّ فيه تجاهل الضّعفاء الأبرياء

89
00:06:14,880 --> 00:06:17,030
!لا قيمة له

90
00:06:19,200 --> 00:06:21,660
!بسرعة! واصلوا التّقدّم

91
00:06:21,660 --> 00:06:23,070
!بسرعة

92
00:06:36,050 --> 00:06:38,950
.ما عاد الشّيتشبوكاي موجودين

93
00:06:38,950 --> 00:06:45,010
لنضع ثقتنا في "م ع خ"، مجموعة
...البحريّة العلميّة الخاصّة

94
00:06:46,870 --> 00:06:51,360
!يوشك توازن القوى في العالم أن يتغيّر بشكل جذريّ

95
00:06:52,590 --> 00:06:55,530
!لكن نجهل مسار ذلك التّغيير

96
00:06:56,970 --> 00:07:01,280
...سمعت أنّ كايدو وبيغ مام قد اتّحدا في بلاد وانو

97
00:07:02,160 --> 00:07:04,020
!ماذا؟

98
00:07:06,020 --> 00:07:08,670
!هل هذا يعني عودة الرّوكس؟

99
00:07:15,570 --> 00:07:19,640
!لا تتحدّث عنهم وكأنّهم أسطورة أو ما شابه

100
00:07:19,640 --> 00:07:21,600
...إنّهم حقيقة

101
00:07:23,330 --> 00:07:29,060
!وكارثة تهدّدنا رغم كوننا مشغولين كثيرًا حاليًّا

102
00:07:46,140 --> 00:07:50,170
!ماذا؟! تحالَف اثنان من اليونكو؟

103
00:07:50,170 --> 00:07:51,630
!مستحيل

104
00:07:51,630 --> 00:07:53,090
!وفي وقت كهذا؟

105
00:07:53,090 --> 00:07:58,050
بشكل أدقّ، وصلتنا معلومات أنّهما
...سيتحالفان في الأيّام القادمة

106
00:07:58,050 --> 00:08:00,220
لم يتسبّبا في أيّ أضرار حتّى الآن

107
00:08:00,220 --> 00:08:03,800
.نجهل هدفهما وكيف نتعامل معهما

108
00:08:04,220 --> 00:08:07,790
...الشّيء الوحيد المشترك بينهما

109
00:08:07,790 --> 00:08:10,560
.هو قراصنة روكس الأسطوريّون

110
00:08:12,020 --> 00:08:15,890
...لكن لا توجد معلومات كافية حولهم أيضًا

111
00:08:17,110 --> 00:08:21,220
...كره كلّ من بيغ مام وكايدو بعضهما لوقت طويل

112
00:08:21,220 --> 00:08:25,580
.لم أتوقّع حدوث أمر كهذا

113
00:08:25,580 --> 00:08:28,560
سنغوكو-سان، من هم قراصنة روكس؟

114
00:08:28,560 --> 00:08:30,330
.صحيح

115
00:08:30,330 --> 00:08:34,500
...أنتم شباب ولا تدرون عنهم

116
00:08:40,360 --> 00:08:46,240
كان قراصنة روكس مجموعة فريدة
...من الأشخاص اجتمعوا معًا

117
00:08:46,240 --> 00:08:52,810
حول خطّة واحدة لجني المال على جزيرة
.القراصنة هاتشينوسو منذ زمن طويل

118
00:08:57,170 --> 00:09:02,680
كانوا عنيفين جميعًا لدرجة أنّهم تقاتلوا
.حتّى الموت حتّى على متن سفينتهم

119
00:09:04,800 --> 00:09:08,540
...وكان يتألّف أعضاؤها من القبطان روكس

120
00:09:10,770 --> 00:09:12,830
!واللّحية البيضاء في عزّ شبابه

121
00:09:15,610 --> 00:09:17,130
!وبيغ مام

122
00:09:19,650 --> 00:09:21,470
!وكايدو

123
00:09:24,470 --> 00:09:29,930
اعتاد هؤلاء الثّلاثة أن يبحروا
.على متن نفس سفينة القراصنة

124
00:09:32,020 --> 00:09:33,900
!ماذا؟

125
00:09:33,900 --> 00:09:35,150
!مـ-مستحيل

126
00:09:35,150 --> 00:09:37,020
!لا-لا أصدّق هذا

127
00:09:37,190 --> 00:09:42,490
ثمّة قراصنة آخرون من صفوف
.طاقم روكس ذاع صيتهم لاحقًا أيضًا

128
00:09:42,760 --> 00:09:48,390
كالأسد الذّهبيّ شيكي الّذي كان مشهورًا
.وتنافس على سيادة العالم الجديد

129
00:09:48,390 --> 00:09:52,290
وآخرون أيضًا مثل الفأس الفضّيّة
...والقبطان جون وأوتشوكو

130
00:09:52,290 --> 00:09:57,020
!لا بدّ أنّك تمزح! جميعها أسماء لقراصنة كبار

131
00:09:57,020 --> 00:09:59,590
لماذا نسي التّاريخ مجموعة قراصنة كهؤلاء؟

132
00:09:59,820 --> 00:10:02,880
أحد الأسباب هو كرههم الشّديد لبعضهم

133
00:10:02,880 --> 00:10:05,300
.ولم يكونوا يفتخرون بالتّشهير بمآثرهم

134
00:10:05,530 --> 00:10:07,140
...إضافة لذلك

135
00:10:07,140 --> 00:10:11,100
...كان القبطان روكس يطمح ليصبح ملك العالم

136
00:10:20,590 --> 00:10:26,510
لذلك كشّروا عن أنيابهم لحكومة
،العالم كأنّهم مجموعة إرهابيّة

137
00:10:26,510 --> 00:10:30,830
.وكانت الحكومة تتستّر على حوادثهم مذّاك الحين

138
00:10:31,700 --> 00:10:37,920
لكنّ الجميع كانوا يعلمون كم كانوا
.خطرين في ذلك الوقت

139
00:10:40,150 --> 00:10:45,950
وقعت حادثة مصيريّة معيّنة
.في وادي الإله، "غود فالي"، قبل 38 سنة

140
00:10:46,530 --> 00:10:49,930
أفادت الأخبار أنّ قراصنة روكس الأقوى

141
00:10:49,930 --> 00:10:54,210
...في العالم قد أُبيدوا على تلك الجزيرة

142
00:11:42,540 --> 00:11:46,380
،لم يقوَ أحد على وضع حدّ لتقدّم الشّرّ

143
00:11:46,380 --> 00:11:50,890
!إلاّ غارب، نائب الأميرال في البحريّة

144
00:11:52,890 --> 00:11:55,900
انتشر اسمه كالنار في الهشيم حول العالم

145
00:11:55,900 --> 00:11:59,330
.وبدأ النّاس ينادونه بطل البحريّة

146
00:12:01,730 --> 00:12:06,880
إذًا فتلك هي بداية قصص بطولة
!نائب الأميرال غارب العديدة

147
00:12:10,200 --> 00:12:14,560
ثمّة الكثير من قصص البطولة
،الّتي تضمّ نائب الأميرال غارب

148
00:12:14,560 --> 00:12:20,250
!لكنّني لم أعلم أنّ هنالك فصلاً عظيمًا آخر منها

149
00:12:20,250 --> 00:12:22,520
!إنّه مميّز بالفعل

150
00:12:25,960 --> 00:12:28,590
!بيغ مام وكايدو؟

151
00:12:28,590 --> 00:12:30,530
...هذا يكفي

152
00:12:33,470 --> 00:12:37,310
.لكنّه يرفض الحديث عن ذلك أحيانًا

153
00:12:37,310 --> 00:12:39,080
لماذا؟

154
00:12:42,690 --> 00:12:46,590
.سأعلمكم بالأمر لتكونوا ملمّين ببعض التّاريخ

155
00:12:47,480 --> 00:12:52,320
.لم يذكر أيّ تقرير سبب امتناعه عن الحديث

156
00:12:52,320 --> 00:12:56,470
كان من الضّروريّ له أن يعمل مع
.قرصان للقتال في تلك المعركة

157
00:12:57,040 --> 00:12:58,270
!قرصان؟

158
00:12:58,870 --> 00:13:03,810
.والسّبب الآخر هو أنّه أنقذ التّنانين السّماويّة

159
00:13:03,810 --> 00:13:07,730
!ماذا؟! التّنانين السّماويّة كانوا جزءًا من القصّة؟

160
00:13:11,450 --> 00:13:15,600
في الواقع، من واجب جنديّ البحريّة
.أن يحمي التّنانين السّماويّة

161
00:13:15,600 --> 00:13:17,030
!ما الخطب في ذلك؟

162
00:13:17,760 --> 00:13:21,580
كان ضمير غارب الأخلاقيّ يملي
.عليه أنّ ذلك ليس واجبه

163
00:13:25,230 --> 00:13:29,480
أحد الأسباب الّتي تدفع غارب
...لرفض منصب الأميرال

164
00:13:29,480 --> 00:13:33,380
.هو أنّ الأميرالات أعوان مباشرون للتّنانين السّماويّة

165
00:13:33,640 --> 00:13:39,180
إنّه يُظهر علنًا عدم الاحترام لهم، لكن
.يُصفح عنه بفضل إنجازاته وشعبيّته

166
00:13:39,660 --> 00:13:41,750
...الحقيقة خلف هذه المسألة

167
00:13:41,750 --> 00:13:46,590
من أجل حماية التّنانين السّماويّة
،وعبيدهم في غود فالي

168
00:13:46,590 --> 00:13:53,910
!عمل غارب مع روجر الّذي كان هناك هزيمة قراصنة روكس

169
00:13:53,910 --> 00:13:57,410
!إنّها تُعرف بحادثة غود فالي

170
00:14:00,290 --> 00:14:01,600
...عمِل مع ملك القراصنة

171
00:14:01,600 --> 00:14:02,640
...جنبًا إلى جنب

172
00:14:02,640 --> 00:14:03,960
!وقاتلا معًا؟

173
00:14:03,960 --> 00:14:07,440
!التّنانين السّماويّة وروجر وروكس؟

174
00:14:07,440 --> 00:14:12,530
!لا أصدّق أنّهم كانوا جميعًا في نفس المكان والوقت
ما الّذي كان على تلك الجزيرة؟

175
00:14:12,530 --> 00:14:15,630
!لم أسمع من قبل بغود فالي

176
00:14:16,530 --> 00:14:18,580
...لا عجب في ذلك

177
00:14:19,740 --> 00:14:22,630
اسم غود فالي

178
00:14:23,290 --> 00:14:27,380
.ما عاد موجودًا الآن على أيّ خريطة

179
00:14:28,880 --> 00:14:33,970
...في الحقيقة، اختفت الجزيرة بلا أيّ أثر

180
00:14:37,970 --> 00:14:42,720
.الجزيرة الّتي أرادت حكومة العالم إخفاءها قد اختفت

181
00:14:42,720 --> 00:14:47,110
أما زلتم تريدون معرفة المزيد عن الجزيرة؟

182
00:14:47,110 --> 00:14:52,280
،ذات مرّة، حاول روكس الطّموح أن يصبح ملك العالم

183
00:14:52,280 --> 00:14:58,680
،لكنّه خرق العديد من المحرّمات
...لذلك ما عادت المعلومات متوفّرة عنه

184
00:14:59,410 --> 00:15:05,060
.لا يتذكّره إلاّ القليل من جنود البحريّة من جيلنا

185
00:15:05,250 --> 00:15:06,920
،حتّى إن كان ذلك منذ زمن

186
00:15:06,920 --> 00:15:09,600
لا أصدّق وجود رجل قاد ثلاثة قراصنة

187
00:15:09,600 --> 00:15:12,020
!أصبحوا يُنعتون باليونكو لاحقًا

188
00:15:12,210 --> 00:15:17,840
...أمّا روجر، ربّما كان روكس هو أوّل وأقوى عدوّ له

189
00:15:17,840 --> 00:15:21,740
والغريب في الأمر، كان ثمّة أمر
.مشترك بين روجر وروكس

190
00:15:23,060 --> 00:15:27,370
.اسم روكس الكامل هو روكس د. زيبيك

191
00:15:28,060 --> 00:15:30,270
،رغم أنّه كان قد مات سلفًا

192
00:15:30,270 --> 00:15:35,790
كان أحد أولئك القراصنة
!الّذين يحملون "د." في اسمهم

193
00:15:58,380 --> 00:16:00,410
.دعوني أعود لقصّتي

194
00:16:05,310 --> 00:16:11,000
صحيح أنّ كايدو وبيغ مام كانا
...على متن نفس السّفينة

195
00:16:11,000 --> 00:16:16,460
لكنّ قدراتهما مختلفة بالكامل
.عمّا كانت عليه قبل 38 سنة

196
00:16:16,460 --> 00:16:22,740
إن كانا قد تحالفا بالفعل، فسنوشك
.على رؤية أسوأ مجموعة قراصنة في العالم

197
00:16:22,740 --> 00:16:26,470
برانيو! إلى كم وصلت مكافآتهم الآن؟

198
00:16:26,470 --> 00:16:30,660
صحيح، علينا وضع مكافآت جديدة لأولئك

199
00:16:30,660 --> 00:16:34,020
.الّذين جُرّدوا من لقب الشّيتشيبوكاي أيضًا

200
00:16:34,020 --> 00:16:38,240
.لنراجع كلّ مكافآتهم

201
00:16:47,930 --> 00:16:54,000
سنبدأ باللّحية السّوداء الّذي بدأ يُنادى
...باليونكو قبل عام مضى

202
00:16:54,650 --> 00:16:59,920
لقد جنّد بعض الأعوان الأقوياء
،عندما أغار على إمبل داون قبل سنتين

203
00:16:59,920 --> 00:17:03,530
.واكتسب الآن السّيطرة على جزيرة القراصنة هاتشينوسو

204
00:17:03,530 --> 00:17:08,800
!ما زال يواصل فرض سيطرته آخذًا مكان اللّحية البيضاء

205
00:17:10,000 --> 00:17:15,060
!عميد قراصنة اللّحية السّوداء، مارشال د. تيتش

206
00:17:15,290 --> 00:17:19,230
!ملياران و247 مليونًا و600 ألف بيري

207
00:17:23,550 --> 00:17:28,490
والتّالي، حصل على لقب اليونكو
...قبل ستّ سنوات فقط

208
00:17:29,560 --> 00:17:35,920
إنّه الأصغر سنًّا بين الأربعة ويحوز
...على ثقة عمياء من أعوانه

209
00:17:35,920 --> 00:17:37,210
.بيكمان

210
00:17:37,210 --> 00:17:38,380
.رو

211
00:17:38,380 --> 00:17:39,590
.ياسوبّ

212
00:17:39,820 --> 00:17:42,630
،اكتسب كبار قادته سمعة كلّ على حدّة

213
00:17:42,630 --> 00:17:49,590
ومجموعته الّتي لا تُهزم لديها معدّل مكافآت
...مرتفع وأفضل توازن بين أيّ مجموعة أخرى

214
00:17:50,370 --> 00:17:53,580
...زعيم قراصنة أحمر الشّعر

215
00:17:53,580 --> 00:17:56,000
!شانكس أحمر الشّعر

216
00:17:56,000 --> 00:17:59,480
!أربعة مليارات و48 مليونًا و900 ألف بيري

217
00:18:03,130 --> 00:18:04,400
...وبعدهما

218
00:18:05,260 --> 00:18:13,120
إنّها وحش بالفطرة يُزعم أنّها دمّرت
...قرية إلباف عندما كانت طفلة

219
00:18:13,120 --> 00:18:17,840
،لا تثق إلاّ في أقاربها وأبنائها الخمسة والثّمانين

220
00:18:18,000 --> 00:18:24,830
،بَنت هذه الملكة المستبدّة أرض توتّو
!مملكة مشيّدة من الحلوى

221
00:18:26,490 --> 00:18:29,700
!قبطان قراصنة بيغ مام

222
00:18:29,700 --> 00:18:32,120
!شارلوت لينلين

223
00:18:32,120 --> 00:18:35,560
!أربعة مليارات و388 مليون بيري

224
00:18:39,750 --> 00:18:44,470
،وضمن قراصنة روكس القدماء

225
00:18:44,970 --> 00:18:48,240
...كان مجرّد قرصان متدرّب

226
00:18:49,720 --> 00:18:56,390
ولكن بعد ذلك، حاز على احترام
،قراصنة متوحّشين بقوّته فحسب

227
00:18:56,390 --> 00:19:00,070
!وانتهى به المطاف يحمل لقب اليونكو

228
00:19:01,050 --> 00:19:03,940
!القائد العامّ لقراصنة مملكة الحيوان

229
00:19:03,940 --> 00:19:06,650
!ملك الوحوش كايدو

230
00:19:06,650 --> 00:19:10,220
!أربعة مليارات و611 مليونًا و100 ألف بيري

231
00:19:14,540 --> 00:19:16,140
...أشعر بالاكتئاب

232
00:19:16,140 --> 00:19:18,330
،"حسب قرار مؤتمر "ليفيلي

233
00:19:18,330 --> 00:19:24,680
!ما عاد بإمكاننا إرسال الشّيتشيبوكاي لقتال اليونكو الآن

234
00:19:28,870 --> 00:19:32,870
...سواء كان تخلّصنا من ذلك السّمّ صوابًا أم لا

235
00:19:33,080 --> 00:19:38,330
فالأمر منوط بمدى نجاعة مجموعة
."البحريّة العلميّة الخاصّة، "م غ خ

236
00:19:38,540 --> 00:19:41,520
،وكمرجع لكم

237
00:19:41,520 --> 00:19:44,760
!إليكم مكافآت شخصيّات أسطوريّة أخرى

238
00:19:46,570 --> 00:19:49,200
!قبطان قراصنة اللّحية البيضاء

239
00:19:49,200 --> 00:19:51,460
!إدوارد نيوغيت

240
00:19:51,780 --> 00:19:55,020
!خمسة مليارات و46 مليون بيري

241
00:19:59,580 --> 00:20:02,210
!قبطان قراصنة روجر

242
00:20:02,210 --> 00:20:05,420
!ملك القراصنة غولد روجر

243
00:20:05,420 --> 00:20:08,950
!خمسة مليارات و564 مليونًا و800 ألف بيري

244
00:20:14,870 --> 00:20:21,150
...لم يستطع أيّ قرصان تجاوزهما

245
00:20:23,440 --> 00:20:26,920
،لكن بمجرّد تحالف كايدو وبيغ مام

246
00:20:27,090 --> 00:20:31,550
فإنّ مجموع مكافآتهما سيتغلّب
!على هذه الأرقام بالفعل

247
00:20:41,980 --> 00:20:46,640
...لكن حاليًّا في بلاد وانو الّتي لا تتبع للحكومة

248
00:20:47,530 --> 00:20:49,590
!أميرال الأسطول ساكازوكي

249
00:20:49,590 --> 00:20:52,640
!انس أمر بلاد وانو

250
00:20:54,530 --> 00:21:01,420
!لا نملك أيّ موارد للتّعامل معها يا سنغوكو-سان

251
00:21:11,010 --> 00:21:14,550
...بالطّبع، لم أكن أنوي التّدخّل

252
00:21:14,760 --> 00:21:19,730
.كنتُ أشارك معرفتي كجنديّ قديم للجنود اليافعين

253
00:21:24,690 --> 00:21:27,750
.حتّى القراصنة لديهم علاقات

254
00:21:27,750 --> 00:21:30,800
.لديهم أهداف لتحرّكاتهم

255
00:21:30,800 --> 00:21:34,110
لا يمكنك رؤية ما سيحلّ تاليًا
.إن كنت جاهلاً بالتّاريخ

256
00:21:34,640 --> 00:21:39,390
صحيح... كان هنالك قرصان من بلاد وانو

257
00:21:39,390 --> 00:21:42,790
.حاز على إعجاب اللّحية البيضاء وروجر وأحمر الشّعر

258
00:21:46,290 --> 00:21:53,200
تقصد كوزكي أودن؟ الرّجل الّذي خدم
...في السّابق كقائد على سفينة اللّحية البيضاء

259
00:21:53,200 --> 00:22:00,180
...انضمّ أودن لاحقًا إلى روجر ورافقه في آخر رحلاته

260
00:22:00,440 --> 00:22:05,550
...من المستحيل أنّ لأودن علاقة بما يحدث الآن

261
00:22:10,050 --> 00:22:14,860
لكن لماذا هؤلاء القراصنة الكبار
...الّذي يؤرقون العالم

262
00:22:15,180 --> 00:22:19,610
يتورّطون دائمًا مع بلاد وانو؟

263
00:22:21,350 --> 00:22:26,670
...أجد أنّ الأمر أكثر من مجرّد مصادفة

264
00:22:26,670 --> 00:22:27,960
!يا ساكازوكي

265
00:23:04,350 --> 00:23:06,960
،في يوم مهرجان النّار السّنويّ

266
00:23:06,960 --> 00:23:09,890
في نقطة اللّقاء، لم يظهر لوفي ومجموعته

267
00:23:09,890 --> 00:23:12,550
!بينما يقف كينييمون ورفاقه فاقدين للأمل

268
00:23:12,550 --> 00:23:16,590
!ثمّة عاصفة تلوح في الأجواء
!هل سيتخلّون عن خطّة الغارة؟

269
00:23:16,590 --> 00:23:22,310
تبدو الأمواج العاتية ورياح البحر وكأنّها
!تحاول سدّ طريقهم إلى أونيغاشيما

270
00:23:22,310 --> 00:23:23,890
:في الحلقة القادمة من وان بيس

271
00:23:23,890 --> 00:23:27,790
"!ميناء اللّقاء! بداية فصل بلاد وانو الثّالث"

272
00:23:27,790 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا