1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,380 --> 00:02:38,690
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,690 --> 00:02:43,650
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:45,920 --> 00:02:53,310
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,310 --> 00:02:59,080
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,460 --> 00:03:06,340
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,340 --> 00:03:08,340
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:09,020 --> 00:03:12,880
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:15,890 --> 00:03:18,350
،بعد نجاتهم من معركة حامية

37
00:03:18,270 --> 00:03:21,200
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:21,200 --> 00:03:23,360
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:24,150 --> 00:03:28,150
،رسوا في بانك هازارد، جزيرة من جزئين
،أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:28,150 --> 00:03:29,610
...وأسروا على يد سيزار كلاون

41
00:03:30,030 --> 00:03:32,950
،ليكونوا فئران تجارب لشينوكوني

42
00:03:32,950 --> 00:03:34,450
.سلاح دمار شامل

43
00:03:34,910 --> 00:03:39,850
لكنّ الهجوم المضادّ بدأ رفقة
!حليفهم الشّيتشيبوكاي ترافالغار لو

44
00:03:41,620 --> 00:03:44,300
...كرة

45
00:03:46,820 --> 00:03:51,100
!نار فرانكي

46
00:03:54,420 --> 00:03:56,060
!السّفينة تحترق

47
00:03:56,060 --> 00:03:58,100
!أخمدوا النّار

48
00:04:00,520 --> 00:04:06,440
لم نعد الآن تحت مراقبة حلازين
.اتّصال البثّ الخاصّة بسيزار

49
00:04:06,970 --> 00:04:11,390
،أيّها الصّيّاد الأبيض-يا، لا يوجد من يجبرني على إنقاذك

50
00:04:11,390 --> 00:04:15,470
لكن إن كان السّماح لك بالعودة سالمًا
،للقاعدة سيجعل فيرغو يفقد مكانته

51
00:04:15,470 --> 00:04:17,250
.فذلك سيخدمني كثيرًا

52
00:04:18,020 --> 00:04:23,170
.ولكن، عليك أن تنسى كلّ ما سمعته عنّي وعن جوكر

53
00:04:24,050 --> 00:04:28,090
.هذا ليس طلبًا. بل شرطًا

54
00:04:28,090 --> 00:04:31,760
.لقاء الإبقاء على حياتك

55
00:04:33,350 --> 00:04:34,800
!يا كينييمون

56
00:04:35,090 --> 00:04:36,390
أباستطاعتك قطع الحديد؟

57
00:04:37,430 --> 00:04:39,770
!ليس من الصّعب قطعه

58
00:04:39,990 --> 00:04:42,060
!أيّها اللّحية البنّيّة، واصل تقدّمك هكذا

59
00:04:42,570 --> 00:04:45,020
!سأواصل التّقدّم

60
00:05:29,480 --> 00:05:32,710
!ما الّذي فعلتموه؟

61
00:05:55,180 --> 00:05:56,870
!مصيبة

62
00:05:57,730 --> 00:06:01,140
من الجيّد أنّنا دخلنا، ولكنّ الغاز
!السّامّ سيدخل هو الآخر

63
00:06:13,720 --> 00:06:16,990
!أمزحة هذه أم ماذا؟ أتحاولون جرّنا للقبر معكم؟

64
00:06:17,450 --> 00:06:19,780
!ليحاول الجميع سدّ الفتحة

65
00:06:19,870 --> 00:06:21,950
!وإلاّ فمآلنا الموت لا محالة

66
00:08:08,970 --> 00:08:10,850
.أظنّنا في أمان الآن

67
00:09:48,370 --> 00:09:49,990
!إنّها النّهاية

68
00:09:51,970 --> 00:09:57,130
!أصبحت بانك هازارد جزيرة غير مأهولة حقًّا الآن

69
00:10:07,900 --> 00:10:10,220
.لا يزال الغاز يحوم وبكثافة

70
00:10:10,680 --> 00:10:14,940
.ستودي خطوة واحدة للخارج بحياة صاحبها بلا شكّ

71
00:10:20,200 --> 00:10:21,600
كيف هو الحال يا بروك؟

72
00:10:21,600 --> 00:10:24,030
.وكأنّها أرضُ موت في الخارج

73
00:10:24,500 --> 00:10:27,280
،بمجرّد التّفكير فيما كان ليحصل لنا لو لم تُسدّ الفتحة

74
00:10:29,650 --> 00:10:30,960
.أُصاب بفزع شديد

75
00:10:31,280 --> 00:10:32,840
!أنت تصيبنا بالفزع أيضًا

76
00:10:36,490 --> 00:10:37,410
!حسنٌ

77
00:10:37,410 --> 00:10:41,790
!الأمور ليست حسنة على الإطلاق
!فقد كدنا نموت بسببك

78
00:10:41,790 --> 00:10:43,460
!كما أنّ نحن من سدّ الفتحة

79
00:10:46,250 --> 00:10:48,710
!أنتم أيّها القراصنة مزعجون أكثر ممّا توقّعت

80
00:10:48,710 --> 00:10:52,970
!استسلموا الآن يا طاقم قبّعة القشّ
!وأنت أيضًا أيّها القرصان اللّحية البنّيّة

81
00:10:53,170 --> 00:10:57,700
!بعد أن حوصرنا؟! لا وجود لمفرّ نلجأ إليه

82
00:11:00,100 --> 00:11:01,900
.لا حاجة لنا بالهرب

83
00:11:03,520 --> 00:11:05,650
.على كلّ حال، كان هذا متوقّعًا

84
00:11:10,190 --> 00:11:11,910
.لا يجدر بهم فعل هذا

85
00:11:15,570 --> 00:11:17,830
!إ-إنّهم يعرفون اسمي

86
00:11:17,830 --> 00:11:20,680
!يبدو أنّ الأمور قد بدأت تثور في الأسفل

87
00:11:22,080 --> 00:11:26,830
أنتما الاثنان، لا تعترضا طريقي وطريق طاقمه، مفهوم؟

88
00:11:27,540 --> 00:11:28,180
.مفهوم

89
00:11:30,880 --> 00:11:34,010
!يا تورا-أو! اسمع يا هذا

90
00:11:34,170 --> 00:11:36,810
!إنّه الوقت المناسب! فأسرع

91
00:11:37,170 --> 00:11:39,410
!أعدنا لطبيعتنا

92
00:11:39,890 --> 00:11:41,860
!ليس عليك فعل هذا

93
00:11:42,010 --> 00:11:43,970
!ما الّذي تتفوّه به يا سانجي-كن؟

94
00:11:43,970 --> 00:11:45,570
!إ-إنّه لا شيء

95
00:11:45,570 --> 00:11:47,310
!بل علينا العودة لطبيعتنا

96
00:11:47,310 --> 00:11:48,350
.غرفة

97
00:11:48,350 --> 00:11:50,570
!أريد استعادة جسدي! أريده الآن

98
00:11:50,570 --> 00:11:51,370
...لا ضرورة لذلك

99
00:11:51,810 --> 00:11:53,080
.تبادل

100
00:11:55,400 --> 00:11:58,960
!سُحقًا! انتهى الحلم

101
00:11:59,070 --> 00:12:01,450
!لقد عدت

102
00:12:01,450 --> 00:12:03,090
ولكن... ماذا؟

103
00:12:12,290 --> 00:12:13,870
!سانجي-كُن؟

104
00:12:15,750 --> 00:12:17,740
!لماذا أرتدي معطفًا مختلفًا؟

105
00:12:17,740 --> 00:12:19,430
!خلعتَ ملابسي، صحيح؟

106
00:12:19,430 --> 00:12:21,230
..بإمكاني شرح ذلك

107
00:12:26,850 --> 00:12:28,400
!سانجي، هل أنت بخير؟

108
00:12:29,690 --> 00:12:32,060
...ماذا؟ جسدي

109
00:12:32,060 --> 00:12:35,940
.لكنّ السّبب ليس تلك اللّكمة فقط

110
00:12:35,940 --> 00:12:40,250
.تكبّدت نامي الكثير بذلك الجسد على يد سيزار

111
00:12:40,490 --> 00:12:41,380
ماذا؟

112
00:12:43,070 --> 00:12:45,220
!مـ-مهلاً، ما الخطب؟

113
00:12:46,210 --> 00:12:50,410
!أنا سعيد لأنّه كان جسدي من تعرّض للأذى

114
00:12:50,410 --> 00:12:53,020
!يا لنُبلك

115
00:12:54,900 --> 00:12:57,470
!فليصغ الجميع لما سأقول

116
00:13:01,760 --> 00:13:02,990
!لو

117
00:13:03,800 --> 00:13:07,400
يمتلئ المكان بأكمله بالغاز السّامّ
،خارج هذا المختبر الآن

118
00:13:07,400 --> 00:13:11,860
لكن هنالك ممرّ واحد سيُجنّبنا الهواء
!في الخارج ويقودنا مباشرة للبحر

119
00:13:15,330 --> 00:13:19,610
.يتكوّن هذا المختبر من عدّة مبانٍ

120
00:13:20,560 --> 00:13:22,760
."نحن الآن في المبنى "أ

121
00:13:23,720 --> 00:13:26,160
إن عبرنا البّوابة في نهاية هذا المبنى

122
00:13:26,160 --> 00:13:29,550
،وعبرنا المبنى "ب" المتوسّط لهذا المختبر

123
00:13:30,050 --> 00:13:31,350
."فسنصل للمبنى "ر

124
00:13:32,390 --> 00:13:36,730
"ثمّة بوّابة كبيرة كُتب عليها "ر-66

125
00:13:36,730 --> 00:13:39,560
.وهو مدخل للممرّ المؤدّي للبحر

126
00:13:40,010 --> 00:13:44,240
لا أريد التّسبّب في مذبحة، ولكنّ ساعتين
.هي أقصى مدّة يمكنني منحها لكم

127
00:13:44,950 --> 00:13:47,770
،وإنّ من سيبقون منكم أطول من ذلك

128
00:13:48,230 --> 00:13:50,180
.لا يسعني ضمان سلامتهم

129
00:13:50,180 --> 00:13:52,360
!ماذا؟

130
00:13:52,610 --> 00:13:54,270
!ما الّذي تقصده بكلامك هذا؟؟

131
00:13:54,270 --> 00:13:55,410
!أنت

132
00:13:55,410 --> 00:13:56,920
!هل تمزح معنا؟

133
00:13:57,730 --> 00:13:59,960
هل سيحدث شيء للمختبر؟

134
00:14:00,930 --> 00:14:03,140
.يعتمد ذلك على سيرورة الأمور

135
00:14:03,140 --> 00:14:05,170
.كل ما عليّ الآن هو فعل ما عليّ فعله

136
00:14:06,050 --> 00:14:07,990
.حسنًا، فهمت

137
00:14:09,010 --> 00:14:11,200
روبين، هلاّ قمتِ بخدمة لي؟

138
00:14:11,760 --> 00:14:12,720
ما هي؟

139
00:14:14,050 --> 00:14:15,450
!يا جي-5

140
00:14:16,890 --> 00:14:17,850
!سمو-يان

141
00:14:18,530 --> 00:14:22,970
!ثمّة في هذا المختبر أطفال اختُطفوا قبل سنتين

142
00:14:23,520 --> 00:14:28,270
!"جدوهم وتوجّهوا نحو البوّابة "ر-66

143
00:14:28,740 --> 00:14:32,610
.إن كان على صواب، فستجدون ميناءً هناك

144
00:14:32,610 --> 00:14:35,760
!اسرقوا سفينة لنهرب بها من بانك هازارد

145
00:14:36,660 --> 00:14:38,280
!أجل

146
00:14:38,280 --> 00:14:40,460
!أريد أيضًا مغادرة هذه الجزيرة اللّعينة

147
00:14:40,460 --> 00:14:41,330
...الأطفال

148
00:14:41,710 --> 00:14:46,800
!يا رفاق، لننفصل ونبحث عن الأطفال ونأخذهم للممرّ

149
00:14:46,800 --> 00:14:48,340
!"إنّه "ر-66

150
00:14:48,340 --> 00:14:49,630
!حاضر

151
00:14:49,630 --> 00:14:51,860
!زورو! لا تذهب وحدك

152
00:14:54,210 --> 00:14:56,580
!انتظرني يا مومونوسكي

153
00:14:56,580 --> 00:14:58,470
!سأنقذك مهما كلّف الأمر

154
00:14:58,810 --> 00:15:01,560
.هكذا إذًا. مفهوم

155
00:15:01,560 --> 00:15:04,060
...آسف. سأذهب الآن

156
00:15:06,900 --> 00:15:08,930
!انتظرني يا سيزار

157
00:15:08,930 --> 00:15:11,650
!لن أختنق هذه المرّة

158
00:15:13,820 --> 00:15:16,990
!سأوسعك ضربًا وأختطفك

159
00:15:56,920 --> 00:16:00,780
!أرأيتما؟ هذه تجربة مفتوحة عظيمة

160
00:16:01,300 --> 00:16:06,500
...طاقم قبّعة القشّ وترافالغار لو وجي-5 البحريّة

161
00:16:07,200 --> 00:16:10,000
ضحّوا جميعًا بأنفسهم من أجلي

162
00:16:10,000 --> 00:16:13,500
!لإثبات كم أنّ شينوكوني قويّ

163
00:16:41,210 --> 00:16:42,790
ماذا هنالك؟

164
00:16:43,290 --> 00:16:45,210
ما الّذي يحدث؟

165
00:16:45,730 --> 00:16:48,830
لماذا لا أرى جنود جي-5 في المدخل الرّئيسيّ؟

166
00:16:49,770 --> 00:16:53,110
لماذا لا أرى أيّ أجساد متصلّبة؟

167
00:16:53,950 --> 00:16:57,550
.لا يمكنني إثبات قوّة شينوكوني من دونها

168
00:16:58,870 --> 00:17:03,300
!طاقم قبّعة القشّ ولو وسموكر... ألقوا مصارعهم حقًّا؟

169
00:17:03,660 --> 00:17:05,720
ما رأيك يا فيرغو؟

170
00:17:07,960 --> 00:17:09,970
.ثمّة أمر واحد أكيد

171
00:17:10,550 --> 00:17:13,770
.لم يعد لهم وجود في ذلك القفص

172
00:17:15,130 --> 00:17:18,510
!ماذا؟ ما الّذي تقصده بهذا؟

173
00:17:18,510 --> 00:17:21,990
.يتكوّن جي-5 من جنود بعقول غبيّة

174
00:17:22,720 --> 00:17:28,290
لا أظنّهم يتوفّرون على الذّكاء اللاّزم
.للفرار من الغاز السّامّ بمفردهم

175
00:17:29,900 --> 00:17:30,950
...ما يعني

176
00:17:31,230 --> 00:17:34,000
أظنّ أنّ قبّعة القشّ والبقيّة

177
00:17:34,000 --> 00:17:37,880
.هربوا من القفص وساعدوا جنود جي-5 على الهرب

178
00:17:38,280 --> 00:17:40,350
!ماذا قلت؟

179
00:17:42,890 --> 00:17:43,720
!هيّا بنا

180
00:17:49,710 --> 00:17:53,950
.تاشيغي، أريدك أن تقودي جنود جي-5

181
00:17:55,320 --> 00:17:57,150
إلى أين أنت ذاهب يا سموكر-سان؟

182
00:17:58,970 --> 00:17:59,900
!أتسعى خلف فيرغو؟

183
00:18:01,010 --> 00:18:02,840
!لا أستطيع مسامحته

184
00:18:03,460 --> 00:18:07,570
!لا يستطيع القانون البتّ في هذه الأمور يا تاشيغي

185
00:18:09,300 --> 00:18:13,160
!عليّ فعل هذا بنفسي! لقد كان يستخفّ بالبحريّة

186
00:18:18,570 --> 00:18:20,550
!خذني معك إذًا

187
00:18:24,240 --> 00:18:27,680
!إنّه... إنّ فيرغو قويّ للغاية

188
00:18:28,080 --> 00:18:29,680
...إذا ما حدث مكروه ما

189
00:18:29,680 --> 00:18:32,310
من سيحمي رجالنا؟

190
00:18:32,960 --> 00:18:36,670
.ساعدي أولئك الحمقى على الفرار، وكذا الأطفال

191
00:18:43,590 --> 00:18:45,490
...سموكر-سان

192
00:18:52,440 --> 00:18:56,650
!حقًّا؟ أهُزم لوفي على يد سيزار قبلاً؟

193
00:18:56,650 --> 00:19:01,400
نعم، وقد قُبض علينا على حين غرّة
.وكدنا نختنق أيضًا

194
00:19:01,400 --> 00:19:05,070
!إنّه يستطيع التّحكّم في الغازات
!ذلك الوغد مزعج

195
00:19:05,070 --> 00:19:06,970
!باستطاعته سحب الأكسجين من الهواء

196
00:19:12,080 --> 00:19:14,770
.نحن أيضًا فقدنا وعينا على يد ذلكما اليتّي

197
00:19:19,460 --> 00:19:21,230
.هذا سيّئ جدًّا

198
00:19:22,960 --> 00:19:25,610
!هذا سيّئ للغاية

199
00:19:37,000 --> 00:19:41,720
ما الّذي تدرّبنا من أجله في العامين المنصرمين؟

200
00:19:42,290 --> 00:19:45,530
...هوّن عليك، ما زلنا أحياء، فلا

201
00:19:45,530 --> 00:19:47,340
!سُحقًا لذلك

202
00:19:48,500 --> 00:19:53,060
قد تدفع حياتك ثمن وقوعك
!في الغفلة لوهلة من الآن فصاعدًا

203
00:19:54,510 --> 00:19:55,560
!مـ-مهلاً

204
00:19:56,750 --> 00:19:58,520
!لا تدعوهم يمرّون

205
00:20:02,170 --> 00:20:03,610
!لوفي

206
00:20:05,880 --> 00:20:07,860
.ابتعدوا عن طريقنا بسرعة

207
00:20:10,400 --> 00:20:12,030
!لوفي

208
00:20:13,150 --> 00:20:16,080
ما الّذي يفعله رأس الطّحلب ذاك؟

209
00:20:30,820 --> 00:20:32,260
!يا لوفي

210
00:20:35,590 --> 00:20:36,310
زورو؟

211
00:20:39,960 --> 00:20:42,210
!لا وقت للتّخاذل

212
00:20:42,210 --> 00:20:44,690
!هذه بداية العالم الجديد فحسب

213
00:21:03,010 --> 00:21:05,710
.إنّه صارم مع نفسه

214
00:21:07,880 --> 00:21:10,880
!نعم، آسف! لن أرخي دفاعاتي ثانية

215
00:21:24,900 --> 00:21:26,130
!إنّه قبّعة القشّ

216
00:21:26,130 --> 00:21:28,690
!لا أدري ما غايته، لكن أطيحوا به

217
00:21:41,060 --> 00:21:42,830
...فاكهة المطّاط

218
00:21:52,870 --> 00:21:54,830
!الصّحن الطّائر

219
00:21:57,910 --> 00:21:58,810
!سأذهب فحسب

220
00:21:59,960 --> 00:22:01,980
...كن أكثر جدّيّة

221
00:22:06,860 --> 00:22:08,480
!سيّدي

222
00:22:10,860 --> 00:22:11,860
ما الخطب؟

223
00:22:12,490 --> 00:22:15,330
،بقيادة القرصان قبّعة القشّ لوفي

224
00:22:16,070 --> 00:22:19,790
"تمكّن العدوّ بكلّ أفراده من دخول ردهة المبنى "أ

225
00:22:20,240 --> 00:22:22,660
!وهم يواصلون تقدّمهم

226
00:22:22,660 --> 00:22:25,080
!ماذا؟

227
00:22:25,080 --> 00:22:26,830
!استطاعوا الدّخول؟

228
00:22:27,130 --> 00:22:30,960
!كيف استطاعوا فتح تلك البوّابة الصّلبة؟

229
00:22:30,960 --> 00:22:32,930
!كيف استطاعوا الفرار من القفص؟

230
00:22:32,930 --> 00:22:34,450
!لا علم لنا بعد

231
00:22:35,110 --> 00:22:38,800
.في كلّ الأحوال، ترك لو طليقًا ليس جيّدًا

232
00:22:39,650 --> 00:22:44,100
.سيتوجّب عليّ قتله بنفسي حسب غايته

233
00:22:48,880 --> 00:22:50,690
!ابتعدوا عن طريقي

234
00:23:00,920 --> 00:23:02,180
!هيّا بنا

235
00:23:11,040 --> 00:23:12,880
...داخل المختبر المغلق

236
00:23:12,880 --> 00:23:16,510
يفرّ لوفي ومن معه من شينوكوني
.الكاسح بكلّ ما لديهم

237
00:23:17,240 --> 00:23:21,600
ومواجهين الموت الفوريّ إن لم يستطيعوا
...عبور تلك البّوابة في طريقهم

238
00:23:21,800 --> 00:23:24,980
!يُظهر رجال جي-5 فخر البحريّة

239
00:23:24,980 --> 00:23:26,810
:في الحلقة القادمة من وان بيس

240
00:23:26,810 --> 00:23:30,610
"!دموع تاشيغي! خطّة اختراق جي-5 اليائسة"

241
00:23:30,610 --> 00:23:32,730
!ملك القراصنة، لن يكون إلاّ أنا

242
00:23:36,030 --> 00:23:41,030
!!نراكم في الحلقة القادمة