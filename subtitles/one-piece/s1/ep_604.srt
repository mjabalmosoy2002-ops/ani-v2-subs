1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,380 --> 00:02:52,690
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,690 --> 00:02:57,650
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:59,920 --> 00:03:07,310
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:03:07,310 --> 00:03:13,080
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:14,460 --> 00:03:20,340
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,340 --> 00:03:22,340
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:23,020 --> 00:03:26,880
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:29,890 --> 00:03:32,350
،بعد نجاتهم من معركة حامية

37
00:03:32,270 --> 00:03:35,200
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:35,200 --> 00:03:37,360
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:38,150 --> 00:03:42,150
،رسوا في بانك هازارد، جزيرة من جزئين
،أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:42,150 --> 00:03:43,610
...وأسروا على يد سيزار كلاون

41
00:03:44,030 --> 00:03:46,950
،ليكونوا فئران تجارب لشينوكوني

42
00:03:46,950 --> 00:03:48,450
.سلاح دمار شامل

43
00:03:48,910 --> 00:03:53,850
لكنّ الهجوم المضادّ بدأ رفقة
!حليفهم الشّيتشيبوكاي ترافالغار لو

44
00:03:55,620 --> 00:03:58,300
...كرة

45
00:04:00,820 --> 00:04:05,100
!نار فرانكي

46
00:04:08,420 --> 00:04:10,060
!السّفينة تحترق

47
00:04:10,060 --> 00:04:12,100
!أخمدوا النّار

48
00:04:14,520 --> 00:04:20,440
لم نعد الآن تحت مراقبة حلازين
.اتّصال البثّ الخاصّة بسيزار

49
00:04:20,970 --> 00:04:25,390
،أيّها الصّيّاد الأبيض-يا، لا يوجد من يجبرني على إنقاذك

50
00:04:25,390 --> 00:04:29,470
لكن إن كان السّماح لك بالعودة سالمًا
،للقاعدة سيجعل فيرغو يفقد مكانته

51
00:04:29,470 --> 00:04:31,250
.فذلك سيخدمني كثيرًا

52
00:04:32,020 --> 00:04:37,170
.ولكن، عليك أن تنسى كلّ ما سمعته عنّي وعن جوكر

53
00:04:38,050 --> 00:04:42,090
.هذا ليس طلبًا. بل شرطًا

54
00:04:42,090 --> 00:04:45,760
.لقاء الإبقاء على حياتك

55
00:04:47,350 --> 00:04:48,800
!يا كينييمون

56
00:04:49,090 --> 00:04:50,390
أباستطاعتك قطع الحديد؟

57
00:04:51,430 --> 00:04:53,770
!ليس من الصّعب قطعه

58
00:04:53,990 --> 00:04:56,060
!أيّها اللّحية البنّيّة، واصل تقدّمك هكذا

59
00:04:56,570 --> 00:04:59,020
!سأواصل التّقدّم

60
00:05:43,480 --> 00:05:46,710
!ما الّذي فعلتموه؟

61
00:06:09,180 --> 00:06:10,870
!مصيبة

62
00:06:11,730 --> 00:06:15,140
من الجيّد أنّنا دخلنا، ولكنّ الغاز
!السّامّ سيدخل هو الآخر

63
00:06:27,720 --> 00:06:30,990
!أمزحة هذه أم ماذا؟ أتحاولون جرّنا للقبر معكم؟

64
00:06:31,450 --> 00:06:33,780
!ليحاول الجميع سدّ الفتحة

65
00:06:33,870 --> 00:06:35,950
!وإلاّ فمآلنا الموت لا محالة

66
00:08:22,970 --> 00:08:24,850
.أظنّنا في أمان الآن

67
00:10:02,370 --> 00:10:03,990
!إنّها النّهاية

68
00:10:05,970 --> 00:10:11,130
!أصبحت بانك هازارد جزيرة غير مأهولة حقًّا الآن

69
00:10:21,900 --> 00:10:24,220
.لا يزال الغاز يحوم وبكثافة

70
00:10:24,680 --> 00:10:28,940
.ستودي خطوة واحدة للخارج بحياة صاحبها بلا شكّ

71
00:10:34,200 --> 00:10:35,600
كيف هو الحال يا بروك؟

72
00:10:35,600 --> 00:10:38,030
.وكأنّها أرضُ موت في الخارج

73
00:10:38,500 --> 00:10:41,280
،بمجرّد التّفكير فيما كان ليحصل لنا لو لم تُسدّ الفتحة

74
00:10:43,650 --> 00:10:44,960
.أُصاب بفزع شديد

75
00:10:45,280 --> 00:10:46,840
!أنت تصيبنا بالفزع أيضًا

76
00:10:50,490 --> 00:10:51,410
!حسنٌ

77
00:10:51,410 --> 00:10:55,790
!الأمور ليست حسنة على الإطلاق
!فقد كدنا نموت بسببك

78
00:10:55,790 --> 00:10:57,460
!كما أنّ نحن من سدّ الفتحة

79
00:11:00,250 --> 00:11:02,710
!أنتم أيّها القراصنة مزعجون أكثر ممّا توقّعت

80
00:11:02,710 --> 00:11:06,970
!استسلموا الآن يا طاقم قبّعة القشّ
!وأنت أيضًا أيّها القرصان اللّحية البنّيّة

81
00:11:07,170 --> 00:11:11,700
!بعد أن حوصرنا؟! لا وجود لمفرّ نلجأ إليه

82
00:11:14,100 --> 00:11:15,900
.لا حاجة لنا بالهرب

83
00:11:17,520 --> 00:11:19,650
.على كلّ حال، كان هذا متوقّعًا

84
00:11:24,190 --> 00:11:25,910
.لا يجدر بهم فعل هذا

85
00:11:29,570 --> 00:11:31,830
!إ-إنّهم يعرفون اسمي

86
00:11:31,830 --> 00:11:34,680
!يبدو أنّ الأمور قد بدأت تثور في الأسفل

87
00:11:36,080 --> 00:11:40,830
أنتما الاثنان، لا تعترضا طريقي وطريق طاقمه، مفهوم؟

88
00:11:41,540 --> 00:11:42,180
.مفهوم

89
00:11:44,880 --> 00:11:48,010
!يا تورا-أو! اسمع يا هذا

90
00:11:48,170 --> 00:11:50,810
!إنّه الوقت المناسب! فأسرع

91
00:11:51,170 --> 00:11:53,410
!أعدنا لطبيعتنا

92
00:11:53,890 --> 00:11:55,860
!ليس عليك فعل هذا

93
00:11:56,010 --> 00:11:57,970
!ما الّذي تتفوّه به يا سانجي-كن؟

94
00:11:57,970 --> 00:11:59,570
!إ-إنّه لا شيء

95
00:11:59,570 --> 00:12:01,310
!بل علينا العودة لطبيعتنا

96
00:12:01,310 --> 00:12:02,350
.غرفة

97
00:12:02,350 --> 00:12:04,570
!أريد استعادة جسدي! أريده الآن

98
00:12:04,570 --> 00:12:05,370
...لا ضرورة لذلك

99
00:12:05,810 --> 00:12:07,080
.تبادل

100
00:12:09,400 --> 00:12:12,960
!سُحقًا! انتهى الحلم

101
00:12:13,070 --> 00:12:15,450
!لقد عدت

102
00:12:15,450 --> 00:12:17,090
ولكن... ماذا؟

103
00:12:26,290 --> 00:12:27,870
!سانجي-كُن؟

104
00:12:29,750 --> 00:12:31,740
!لماذا أرتدي معطفًا مختلفًا؟

105
00:12:31,740 --> 00:12:33,430
!خلعتَ ملابسي، صحيح؟

106
00:12:33,430 --> 00:12:35,230
..بإمكاني شرح ذلك

107
00:12:40,850 --> 00:12:42,400
!سانجي، هل أنت بخير؟

108
00:12:43,690 --> 00:12:46,060
...ماذا؟ جسدي

109
00:12:46,060 --> 00:12:49,940
.لكنّ السّبب ليس تلك اللّكمة فقط

110
00:12:49,940 --> 00:12:54,250
.تكبّدت نامي الكثير بذلك الجسد على يد سيزار

111
00:12:54,490 --> 00:12:55,380
ماذا؟

112
00:12:57,070 --> 00:12:59,220
!مـ-مهلاً، ما الخطب؟

113
00:13:00,210 --> 00:13:04,410
!أنا سعيد لأنّه كان جسدي من تعرّض للأذى

114
00:13:04,410 --> 00:13:07,020
!يا لنُبلك

115
00:13:08,900 --> 00:13:11,470
!فليصغ الجميع لما سأقول

116
00:13:15,760 --> 00:13:16,990
!لو

117
00:13:17,800 --> 00:13:21,400
يمتلئ المكان بأكمله بالغاز السّامّ
،خارج هذا المختبر الآن

118
00:13:21,400 --> 00:13:25,860
لكن هنالك ممرّ واحد سيُجنّبنا الهواء
!في الخارج ويقودنا مباشرة للبحر

119
00:13:29,330 --> 00:13:33,610
.يتكوّن هذا المختبر من عدّة مبانٍ

120
00:13:34,560 --> 00:13:36,760
."نحن الآن في المبنى "أ

121
00:13:37,720 --> 00:13:40,160
إن عبرنا البّوابة في نهاية هذا المبنى

122
00:13:40,160 --> 00:13:43,550
،وعبرنا المبنى "ب" المتوسّط لهذا المختبر

123
00:13:44,050 --> 00:13:45,350
."فسنصل للمبنى "ر

124
00:13:46,390 --> 00:13:50,730
"ثمّة بوّابة كبيرة كُتب عليها "ر-66

125
00:13:50,730 --> 00:13:53,560
.وهو مدخل للممرّ المؤدّي للبحر

126
00:13:54,010 --> 00:13:58,240
لا أريد التّسبّب في مذبحة، ولكنّ ساعتين
.هي أقصى مدّة يمكنني منحها لكم

127
00:13:58,950 --> 00:14:01,770
،وإنّ من سيبقون منكم أطول من ذلك

128
00:14:02,230 --> 00:14:04,180
.لا يسعني ضمان سلامتهم

129
00:14:04,180 --> 00:14:06,360
!ماذا؟

130
00:14:06,610 --> 00:14:08,270
!ما الّذي تقصده بكلامك هذا؟؟

131
00:14:08,270 --> 00:14:09,410
!أنت

132
00:14:09,410 --> 00:14:10,920
!هل تمزح معنا؟

133
00:14:11,730 --> 00:14:13,960
هل سيحدث شيء للمختبر؟

134
00:14:14,930 --> 00:14:17,140
.يعتمد ذلك على سيرورة الأمور

135
00:14:17,140 --> 00:14:19,170
.كل ما عليّ الآن هو فعل ما عليّ فعله

136
00:14:20,050 --> 00:14:21,990
.حسنًا، فهمت

137
00:14:23,010 --> 00:14:25,200
روبين، هلاّ قمتِ بخدمة لي؟

138
00:14:25,760 --> 00:14:26,720
ما هي؟

139
00:14:28,050 --> 00:14:29,450
!يا جي-5

140
00:14:30,890 --> 00:14:31,850
!سمو-يان

141
00:14:32,530 --> 00:14:36,970
!ثمّة في هذا المختبر أطفال اختُطفوا قبل سنتين

142
00:14:37,520 --> 00:14:42,270
!"جدوهم وتوجّهوا نحو البوّابة "ر-66

143
00:14:42,740 --> 00:14:46,610
.إن كان على صواب، فستجدون ميناءً هناك

144
00:14:46,610 --> 00:14:49,760
!اسرقوا سفينة لنهرب بها من بانك هازارد

145
00:14:50,660 --> 00:14:52,280
!أجل

146
00:14:52,280 --> 00:14:54,460
!أريد أيضًا مغادرة هذه الجزيرة اللّعينة

147
00:14:54,460 --> 00:14:55,330
...الأطفال

148
00:14:55,710 --> 00:15:00,800
!يا رفاق، لننفصل ونبحث عن الأطفال ونأخذهم للممرّ

149
00:15:00,800 --> 00:15:02,340
!"إنّه "ر-66

150
00:15:02,340 --> 00:15:03,630
!حاضر

151
00:15:03,630 --> 00:15:05,860
!زورو! لا تذهب وحدك

152
00:15:08,210 --> 00:15:10,580
!انتظرني يا مومونوسكي

153
00:15:10,580 --> 00:15:12,470
!سأنقذك مهما كلّف الأمر

154
00:15:12,810 --> 00:15:15,560
.هكذا إذًا. مفهوم

155
00:15:15,560 --> 00:15:18,060
...آسف. سأذهب الآن

156
00:15:20,900 --> 00:15:22,930
!انتظرني يا سيزار

157
00:15:22,930 --> 00:15:25,650
!لن أختنق هذه المرّة

158
00:15:27,820 --> 00:15:30,990
!سأوسعك ضربًا وأختطفك

159
00:16:10,920 --> 00:16:14,780
!أرأيتما؟ هذه تجربة مفتوحة عظيمة

160
00:16:15,300 --> 00:16:20,500
...طاقم قبّعة القشّ وترافالغار لو وجي-5 البحريّة

161
00:16:21,200 --> 00:16:24,000
ضحّوا جميعًا بأنفسهم من أجلي

162
00:16:24,000 --> 00:16:27,500
!لإثبات كم أنّ شينوكوني قويّ

163
00:16:55,210 --> 00:16:56,790
ماذا هنالك؟

164
00:16:57,290 --> 00:16:59,210
ما الّذي يحدث؟

165
00:16:59,730 --> 00:17:02,830
لماذا لا أرى جنود جي-5 في المدخل الرّئيسيّ؟

166
00:17:03,770 --> 00:17:07,110
لماذا لا أرى أيّ أجساد متصلّبة؟

167
00:17:07,950 --> 00:17:11,550
.لا يمكنني إثبات قوّة شينوكوني من دونها

168
00:17:12,870 --> 00:17:17,300
!طاقم قبّعة القشّ ولو وسموكر... ألقوا مصارعهم حقًّا؟

169
00:17:17,660 --> 00:17:19,720
ما رأيك يا فيرغو؟

170
00:17:21,960 --> 00:17:23,970
.ثمّة أمر واحد أكيد

171
00:17:24,550 --> 00:17:27,770
.لم يعد لهم وجود في ذلك القفص

172
00:17:29,130 --> 00:17:32,510
!ماذا؟ ما الّذي تقصده بهذا؟

173
00:17:32,510 --> 00:17:35,990
.يتكوّن جي-5 من جنود بعقول غبيّة

174
00:17:36,720 --> 00:17:42,290
لا أظنّهم يتوفّرون على الذّكاء اللاّزم
.للفرار من الغاز السّامّ بمفردهم

175
00:17:43,900 --> 00:17:44,950
...ما يعني

176
00:17:45,230 --> 00:17:48,000
أظنّ أنّ قبّعة القشّ والبقيّة

177
00:17:48,000 --> 00:17:51,880
.هربوا من القفص وساعدوا جنود جي-5 على الهرب

178
00:17:52,280 --> 00:17:54,350
!ماذا قلت؟

179
00:17:56,890 --> 00:17:57,720
!هيّا بنا

180
00:18:03,710 --> 00:18:07,950
.تاشيغي، أريدك أن تقودي جنود جي-5

181
00:18:09,320 --> 00:18:11,150
إلى أين أنت ذاهب يا سموكر-سان؟

182
00:18:12,970 --> 00:18:13,900
!أتسعى خلف فيرغو؟

183
00:18:15,010 --> 00:18:16,840
!لا أستطيع مسامحته

184
00:18:17,460 --> 00:18:21,570
!لا يستطيع القانون البتّ في هذه الأمور يا تاشيغي

185
00:18:23,300 --> 00:18:27,160
!عليّ فعل هذا بنفسي! لقد كان يستخفّ بالبحريّة

186
00:18:32,570 --> 00:18:34,550
!خذني معك إذًا

187
00:18:38,240 --> 00:18:41,680
!إنّه... إنّ فيرغو قويّ للغاية

188
00:18:42,080 --> 00:18:43,680
...إذا ما حدث مكروه ما

189
00:18:43,680 --> 00:18:46,310
من سيحمي رجالنا؟

190
00:18:46,960 --> 00:18:50,670
.ساعدي أولئك الحمقى على الفرار، وكذا الأطفال

191
00:18:57,590 --> 00:18:59,490
...سموكر-سان

192
00:19:06,440 --> 00:19:10,650
!حقًّا؟ أهُزم لوفي على يد سيزار قبلاً؟

193
00:19:10,650 --> 00:19:15,400
نعم، وقد قُبض علينا على حين غرّة
.وكدنا نختنق أيضًا

194
00:19:15,400 --> 00:19:19,070
!إنّه يستطيع التّحكّم في الغازات
!ذلك الوغد مزعج

195
00:19:19,070 --> 00:19:20,970
!باستطاعته سحب الأكسجين من الهواء

196
00:19:26,080 --> 00:19:28,770
.نحن أيضًا فقدنا وعينا على يد ذلكما اليتّي

197
00:19:33,460 --> 00:19:35,230
.هذا سيّئ جدًّا

198
00:19:36,960 --> 00:19:39,610
!هذا سيّئ للغاية

199
00:19:51,000 --> 00:19:55,720
ما الّذي تدرّبنا من أجله في العامين المنصرمين؟

200
00:19:56,290 --> 00:19:59,530
...هوّن عليك، ما زلنا أحياء، فلا

201
00:19:59,530 --> 00:20:01,340
!سُحقًا لذلك

202
00:20:02,500 --> 00:20:07,060
قد تدفع حياتك ثمن وقوعك
!في الغفلة لوهلة من الآن فصاعدًا

203
00:20:08,510 --> 00:20:09,560
!مـ-مهلاً

204
00:20:10,750 --> 00:20:12,520
!لا تدعوهم يمرّون

205
00:20:16,170 --> 00:20:17,610
!لوفي

206
00:20:19,880 --> 00:20:21,860
.ابتعدوا عن طريقنا بسرعة

207
00:20:24,400 --> 00:20:26,030
!لوفي

208
00:20:27,150 --> 00:20:30,080
ما الّذي يفعله رأس الطّحلب ذاك؟

209
00:20:44,820 --> 00:20:46,260
!يا لوفي

210
00:20:49,590 --> 00:20:50,310
زورو؟

211
00:20:53,960 --> 00:20:56,210
!لا وقت للتّخاذل

212
00:20:56,210 --> 00:20:58,690
!هذه بداية العالم الجديد فحسب

213
00:21:17,010 --> 00:21:19,710
.إنّه صارم مع نفسه

214
00:21:21,880 --> 00:21:24,880
!نعم، آسف! لن أرخي دفاعاتي ثانية

215
00:21:38,900 --> 00:21:40,130
!إنّه قبّعة القشّ

216
00:21:40,130 --> 00:21:42,690
!لا أدري ما غايته، لكن أطيحوا به

217
00:21:55,060 --> 00:21:56,830
...فاكهة المطّاط

218
00:22:06,870 --> 00:22:08,830
!الصّحن الطّائر

219
00:22:11,910 --> 00:22:12,810
!سأذهب فحسب

220
00:22:13,960 --> 00:22:15,980
...كن أكثر جدّيّة

221
00:22:20,860 --> 00:22:22,480
!سيّدي

222
00:22:24,860 --> 00:22:25,860
ما الخطب؟

223
00:22:26,490 --> 00:22:29,330
،بقيادة القرصان قبّعة القشّ لوفي

224
00:22:30,070 --> 00:22:33,790
"تمكّن العدوّ بكلّ أفراده من دخول ردهة المبنى "أ

225
00:22:34,240 --> 00:22:36,660
!وهم يواصلون تقدّمهم

226
00:22:36,660 --> 00:22:39,080
!ماذا؟

227
00:22:39,080 --> 00:22:40,830
!استطاعوا الدّخول؟

228
00:22:41,130 --> 00:22:44,960
!كيف استطاعوا فتح تلك البوّابة الصّلبة؟

229
00:22:44,960 --> 00:22:46,930
!كيف استطاعوا الفرار من القفص؟

230
00:22:46,930 --> 00:22:48,450
!لا علم لنا بعد

231
00:22:49,110 --> 00:22:52,800
.في كلّ الأحوال، ترك لو طليقًا ليس جيّدًا

232
00:22:53,650 --> 00:22:58,100
.سيتوجّب عليّ قتله بنفسي حسب غايته

233
00:23:02,880 --> 00:23:04,690
!ابتعدوا عن طريقي

234
00:23:14,920 --> 00:23:16,180
!هيّا بنا

235
00:23:25,040 --> 00:23:26,880
...داخل المختبر المغلق

236
00:23:26,880 --> 00:23:30,510
يفرّ لوفي ومن معه من شينوكوني
.الكاسح بكلّ ما لديهم

237
00:23:31,240 --> 00:23:35,600
ومواجهين الموت الفوريّ إن لم يستطيعوا
...عبور تلك البّوابة في طريقهم

238
00:23:35,800 --> 00:23:38,980
!يُظهر رجال جي-5 فخر البحريّة

239
00:23:38,980 --> 00:23:40,810
:في الحلقة القادمة من وان بيس

240
00:23:40,810 --> 00:23:44,610
"!دموع تاشيغي! خطّة اختراق جي-5 اليائسة"

241
00:23:44,610 --> 00:23:46,730
!ملك القراصنة، لن يكون إلاّ أنا

242
00:23:50,030 --> 00:23:55,030
!!نراكم في الحلقة القادمة