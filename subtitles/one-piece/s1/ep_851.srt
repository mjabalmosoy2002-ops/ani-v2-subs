1
00:00:03,010 --> 00:00:06,520
قلبي يخفق عند التّفكير بك

2
00:00:06,560 --> 00:00:09,940
قوّة لا حصر لها تندفع

3
00:00:09,980 --> 00:00:15,730
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

4
00:00:15,780 --> 00:00:17,320
نحن الأمل

5
00:00:23,370 --> 00:00:30,210
فرحتنا لتطاير مشاعرنا الصّادقة بيننا

6
00:00:30,250 --> 00:00:37,460
ألمنا عندما ضحكنا لنواسي حزننا

7
00:00:37,510 --> 00:00:44,350
نصل بينها في مهبّ الرّياح آه

8
00:00:44,390 --> 00:00:51,100
إنّه يرفرف أعلى فأعلى

9
00:00:51,140 --> 00:00:54,270
لمَ تخلّيت عن بحثتك؟

10
00:00:54,310 --> 00:00:57,690
ولمَ تواصل القتال لوحدك؟

11
00:00:57,730 --> 00:01:00,570
أخبرني، أيّ مستقبل أعددت له؟

12
00:01:00,610 --> 00:01:04,120
هل حقّقت حلمك؟

13
00:01:04,530 --> 00:01:08,040
قلبي يخفق عند التّفكير بك

14
00:01:08,080 --> 00:01:11,790
قوّة لا حصر لها تندفع

15
00:01:11,830 --> 00:01:17,340
ما دامت لك رغبة، سنلوّح برابطنا الّذي لا يتغيّر

16
00:01:17,380 --> 00:01:18,550
نحن الأمل

17
00:01:18,750 --> 00:01:22,130
عند نهاية العالم الواسعة والزٍّرقاء

18
00:01:22,170 --> 00:01:24,680
هناك مكان أريد أن أذهب إليه معك

19
00:01:24,720 --> 00:01:27,470
طريق البحر الّذي نسلك

20
00:01:27,510 --> 00:01:34,230
قُرّر قبل وقت طويل

21
00:01:44,910 --> 00:01:48,410
صوتك الّذي لم يصل لي بعد

22
00:01:48,450 --> 00:01:52,040
يسحق قلبي العاجز

23
00:01:52,080 --> 00:01:55,290
أريدك

24
00:01:55,330 --> 00:02:00,130
لذا سأجدّد الثّقة في الصّباح عندما يأتي النّور

25
00:02:00,170 --> 00:02:03,970
أغمض عينيك وأنصت جيّدًا

26
00:02:04,010 --> 00:02:07,470
ولنبحث عن إجابتك

27
00:02:07,510 --> 00:02:13,270
طريق البحر الّذي لم تره أبدًا يستمرّ دائمًا

28
00:02:13,310 --> 00:02:14,310
نحن الأمل

29
00:02:14,480 --> 00:02:17,860
عند نهاية العالم الواسعة والزٍّرقاء

30
00:02:17,900 --> 00:02:20,360
هناك مكان أريد أن أذهب إليه معك

31
00:02:20,400 --> 00:02:23,150
سنكون أبد الدّهر

32
00:02:23,190 --> 00:02:30,330
قُرّر قبل وقت طويل

33
00:02:33,750 --> 00:02:37,180
،من أجل الهرب من جزيرة هول كيك

34
00:02:37,180 --> 00:02:40,320
.وصل لوفي ورفاقه أخيرًا إلى ساني

35
00:02:41,800 --> 00:02:45,150
لكن، جنرال الحلوى كاتاكوري
والبقية ممّن كانوا يتربّصون لهم

36
00:02:45,150 --> 00:02:46,780
.صدّوا سبيلهم

37
00:02:48,020 --> 00:02:50,910
ثمّ ضحّى بيدرو بنفسه وبيروسبيرو ليفسح المجال

38
00:02:50,910 --> 00:02:53,310
.للوفي والبقيّة للهروب

39
00:02:56,560 --> 00:03:02,610
.قمع رفاقه الذين أنقذهم حزنهم وتجهّزوا لاندفاع الرّيح

40
00:03:02,980 --> 00:03:05,130
!أبحروا يا رفاق

41
00:03:05,740 --> 00:03:10,300
!إن أهدرنا هذه الفرصة فسنلحق العار ببيدرو

42
00:03:13,410 --> 00:03:14,550
!أصغ إلي

43
00:03:15,360 --> 00:03:18,220
!سأعود! أترك الباقي لك

44
00:03:18,670 --> 00:03:20,670
!حسنًا، ها نحن ذا

45
00:03:21,460 --> 00:03:24,380
...مدفع

46
00:03:24,880 --> 00:03:27,630
!الرّيح

47
00:03:37,120 --> 00:03:38,520
...نجحت

48
00:03:42,820 --> 00:03:45,520
!هنا، أستطيع ضربك بقدر ما أريد

49
00:03:51,570 --> 00:03:57,310
"!الرّجل صاحب مكافأة المليار! جنرال الحلوى الأقوى، كاتاكوري"

50
00:04:00,700 --> 00:04:04,190
!يا للغبيّ! لا أصدّق أنّه كسر المرآة بنفسه

51
00:04:04,630 --> 00:04:07,990
!هل تحاول التضحية بنفسك وترك أصدقاءك يهربون؟

52
00:04:08,600 --> 00:04:11,320
!سأوسعك ضربًا

53
00:04:13,470 --> 00:04:17,250
!لا تكن سخيفًا -
!إلى من تتحدّث برأيك؟ -

54
00:04:17,270 --> 00:04:21,520
!مكافأة كاتاكوري-ساما تُقدّر بمليار وسبعة وخمسين مليونًا

55
00:04:21,690 --> 00:04:24,400
!إنّه الأقوى بين جنرالات الحلوى الثّلاثة

56
00:04:25,570 --> 00:04:29,170
...أنت خطير يا قبّعة القشّ لوفي

57
00:04:31,250 --> 00:04:32,840
،مع أنّ ذلك كان تهوّرًا

58
00:04:32,840 --> 00:04:37,390
إلّا أنّه لا يوجد سوى قلّة من النّاس
...الّذين تسبّبوا في كلّ هذه الأضرار

59
00:04:37,390 --> 00:04:38,570
.لقراصنة بيغ مام

60
00:04:40,620 --> 00:04:45,900
.إن تركتك تذهب، ستشكّل خطرًا أكبر على ماما

61
00:04:47,730 --> 00:04:53,490
...لكن من حيث القدرة، أنت أدنى منّي بكثير

62
00:04:54,660 --> 00:04:56,490
.عليّ الاعتناء بك الآن

63
00:04:57,200 --> 00:04:59,000
!لن أُهزم

64
00:05:00,870 --> 00:05:04,000
.سأعلّمك أنّ هناك من هم أقوى منك دائمًا

65
00:05:06,710 --> 00:05:08,840
!ها أنا ذا

66
00:05:18,640 --> 00:05:20,520
أهذا كلّ ما لديك؟

67
00:05:21,560 --> 00:05:23,140
...فاكهة المطّاط

68
00:05:23,190 --> 00:05:25,610
!المسدّس النفّاث

69
00:05:29,150 --> 00:05:31,730
!مسدّسان نفّاثان

70
00:05:36,370 --> 00:05:38,700
...إن كنتُ أريد التّفادي حقًا

71
00:05:40,080 --> 00:05:42,210
.فبإمكاني أن أتفادى إلى الأبد

72
00:05:43,920 --> 00:05:45,670
...فاكهة المطّاط

73
00:05:48,670 --> 00:05:51,300
!بندقيّة الصّقر

74
00:05:55,890 --> 00:05:57,430
...فاكهة المطّاط

75
00:05:57,430 --> 00:05:59,970
!بازوكا النّسر

76
00:06:04,140 --> 00:06:05,470
!توقّف مكانك

77
00:06:12,440 --> 00:06:13,610
أين ذهب قبّعة القشّ؟

78
00:06:14,240 --> 00:06:15,450
!كاتاكوري-ساما

79
00:06:17,070 --> 00:06:18,910
...فاكهة المطّاط

80
00:06:19,280 --> 00:06:21,040
!فأس الصّقر

81
00:06:21,490 --> 00:06:22,540
...هجوم مباغت

82
00:06:23,370 --> 00:06:24,540
.لا فائدة

83
00:06:26,960 --> 00:06:30,210
!لا نستطيع رؤيته -
أهذا مراده؟ -

84
00:06:34,220 --> 00:06:37,390
!رشّاش الصّقر

85
00:06:38,590 --> 00:06:41,350
!كاتاكوري-ساما -
!مستحيل -

86
00:06:45,850 --> 00:06:48,310
!استعدّوا للاصطدام

87
00:07:00,070 --> 00:07:02,200
.لا أرى أيّ أحد على أعتابنا

88
00:07:05,250 --> 00:07:06,660
...سوف تُمطر

89
00:07:06,830 --> 00:07:09,670
!لوفي

90
00:07:09,670 --> 00:07:12,300
!أسمعني صوتك إن كنت هناك

91
00:07:13,420 --> 00:07:15,380
...ذهبَ إلى عالم المرايا

92
00:07:16,800 --> 00:07:18,590
...آخذًا كاتاكوري

93
00:07:18,590 --> 00:07:19,220
!ماذا؟

94
00:07:20,140 --> 00:07:21,300
...لوفي

95
00:07:25,140 --> 00:07:29,560
!كسر أحدهم المرآة! لا يمكننا الدّخول هكذا

96
00:07:31,230 --> 00:07:34,610
!لنثق بقبطاننا

97
00:07:34,650 --> 00:07:37,150
!قال أنّه سيعود

98
00:07:37,420 --> 00:07:38,360
!أجل

99
00:07:39,990 --> 00:07:41,730
...بالحديث عن الغائبين

100
00:07:42,410 --> 00:07:45,700
.لا أرى بيدرو-سان أيضًا

101
00:07:47,210 --> 00:07:50,580
...معك حقّ -
هل ذهب إلى مكان ما؟ -

102
00:07:50,790 --> 00:07:53,390
هل ذهب إلى عالم المرايا مع لوفي-سان؟

103
00:07:56,380 --> 00:07:59,630
...بيدرو... بيدرو قد

104
00:08:00,510 --> 00:08:03,140
كاروت؟ -
هل حدث شيء؟ -

105
00:08:07,730 --> 00:08:11,340
!ما الخطب يا رفاق؟

106
00:08:15,230 --> 00:08:18,530
.تشوبّر، بروك، اسمعا جيدًا

107
00:08:19,450 --> 00:08:21,980
...في الواقع... بيدرو

108
00:09:55,080 --> 00:09:56,420
...مستحيل

109
00:09:56,580 --> 00:09:58,880
تمزحين... صحيح؟

110
00:10:03,050 --> 00:10:05,590
...لا... لا

111
00:10:06,840 --> 00:10:07,890
...بيدرو-سان

112
00:10:09,600 --> 00:10:13,020
...بيدرو-سان

113
00:10:14,270 --> 00:10:17,110
...بيدرو-سان ضحّى بنفسه

114
00:10:20,190 --> 00:10:22,650
!إنّه خطئي

115
00:10:23,110 --> 00:10:28,200
!كان عليّ حماية السّاني حتّى النهاية

116
00:10:28,670 --> 00:10:31,960
!لأنّي... كنتُ ضعيفًا

117
00:10:43,010 --> 00:10:46,700
!...لو أنّني... كنتُ

118
00:10:52,810 --> 00:10:54,850
...لو أنّي كنتُ أقوى

119
00:11:19,250 --> 00:11:21,920
.اتركوا البكاء لأعدائنا

120
00:11:23,000 --> 00:11:25,410
.لا ينبغي لنا أن نحزن

121
00:11:30,220 --> 00:11:31,760
!مهلًا يا جينبي-سان

122
00:11:32,390 --> 00:11:36,430
!كيف لك أن تنطق بمثل هذا الكلام البارد؟

123
00:11:36,430 --> 00:11:39,940
—تعرف بيدرو-سان أقلّ منّا، لهذا

124
00:11:40,100 --> 00:11:42,950
!أقول لكم لا تفقدوا تركيزكم

125
00:11:45,230 --> 00:11:48,110
...كنّا محاصرين في السّاحل

126
00:11:49,490 --> 00:11:54,650
.علِمَ أنّ المكان خطير للغاية لذا كان مستعدًّا للتّضحية بنفسه

127
00:11:57,540 --> 00:11:58,580
...هذا

128
00:11:58,970 --> 00:12:00,940
!نصرُ بيدرو

129
00:12:05,420 --> 00:12:10,360
!كم من ضرّر تكبّد العدوّ بسببكم؟

130
00:12:11,800 --> 00:12:15,500
!إنّه خطأ فادح غير مسبوق بالنسبة لهم

131
00:12:16,780 --> 00:12:21,110
!قوّتكم تركت بيغ مام في مأزق حقًّا

132
00:12:22,730 --> 00:12:26,860
...ألا تسمعون صوت بيدرو في داخلكم يقول

133
00:12:29,450 --> 00:12:31,120
!تابعوا"؟"

134
00:12:42,500 --> 00:12:45,130
...شعر لوفي به على الفور

135
00:12:45,800 --> 00:12:49,070
.وقرّر أن يواجه العدوّ بنفسه

136
00:12:50,880 --> 00:12:56,600
!مكافأة كاتاكوري تتجاوز المليار! إنّه وقت المخاطرة

137
00:12:57,350 --> 00:12:59,590
!لم ينته الأمر بعد

138
00:13:00,060 --> 00:13:02,860
!ما زلنا في جزيرة توتو

139
00:13:03,770 --> 00:13:10,180
!قريبًا، ستلاحقنا ملكة قراصنة البلاد، بيغ مام

140
00:13:11,150 --> 00:13:16,670
ويمكن أن يهاجمنا أسطول العدوّ
!في أيّ وقت ومن أيّ اتّجاه

141
00:13:18,040 --> 00:13:22,170
،إلى أن تخرجوا من المنطقة التي تحكمها بيغ مام

142
00:13:22,830 --> 00:13:27,920
!لا يمكنكم أن تفقدوا تركيزكم
!ألا يخبركم بيدرو ذلك في قرارة أنفسكم؟

143
00:13:36,300 --> 00:13:38,180
.أنا جدّ آسف

144
00:13:39,140 --> 00:13:41,590
.تجاوزتُ حدودي

145
00:13:44,600 --> 00:13:47,520
!نامي، وجّهينا -
!حسنًا -

146
00:13:47,690 --> 00:13:51,400
سيأتي لنا سانجي-كن والبقيّة من جزيرة الكاكاو

147
00:13:51,400 --> 00:13:53,400
.لذا لا يجب أن نفوّت بعضنا

148
00:13:53,950 --> 00:13:56,820
!ستهبّ رياح قويّة قريبًا. إنّها رياح دافعة

149
00:13:57,030 --> 00:13:58,620
!إلى الميمنة

150
00:13:58,790 --> 00:14:00,750
!أقصى الميمنة

151
00:14:01,080 --> 00:14:03,870
اجعل الشّراع يلقط الرّياح من
!الميمنة واتّجه إلى الغربِ مباشرةً

152
00:14:04,080 --> 00:14:06,580
!سنسلك الطّريق الأقصر -
!عُلم -

153
00:14:06,750 --> 00:14:09,170
!سأذهب لتعويض الكولا المُستهلكة

154
00:14:12,300 --> 00:14:13,480
!سأتولّى الحراسة

155
00:14:16,430 --> 00:14:17,470
!حسنًا

156
00:14:20,430 --> 00:14:23,200
!سأراقب التيّارات

157
00:14:44,750 --> 00:14:47,330
!إنّهم قادمون من الجنوب

158
00:14:47,830 --> 00:14:49,920
!ظننت أنّهم سيستغرقون أطول

159
00:14:50,550 --> 00:14:52,290
!إنّها السّفن التي واجهنا قبل قليل

160
00:14:53,260 --> 00:14:54,380
!شخص؟

161
00:14:55,260 --> 00:14:56,930
...مـ-مستحيل

162
00:15:01,220 --> 00:15:04,480
!كعك

163
00:15:04,770 --> 00:15:08,600
...مستحيل.. لا أظنّ... أنّ ذلك ممكن

164
00:15:09,080 --> 00:15:12,110
!بيغ مام تسير على الماء

165
00:15:12,230 --> 00:15:14,780
!بربّك! هذا سخيف

166
00:15:17,860 --> 00:15:20,540
...ذلك ليس ماءً... بل

167
00:15:22,120 --> 00:15:23,290
!حلوى؟

168
00:15:25,370 --> 00:15:29,080
!إنّها تسير على كُتلة ضخمة من الحلوى المتنقّلة

169
00:15:30,210 --> 00:15:33,670
!تستخدم الحلوى؟ -
...هل يعني هذا -

170
00:15:34,630 --> 00:15:38,180
...الشّخص الوحيد الّذي يستطيع صنعها

171
00:15:38,800 --> 00:15:42,020
!لا بدّ أنّه... هو-تيا

172
00:15:44,560 --> 00:15:46,180
...لعق

173
00:15:46,520 --> 00:15:48,580
!بزّاقة حلوى البحر

174
00:15:49,100 --> 00:15:51,310
أين ذهب زيوس؟

175
00:15:51,360 --> 00:15:55,190
!واجبه حمل ماما فوق البحر

176
00:15:55,820 --> 00:15:56,860
...لا تقل لي

177
00:15:57,200 --> 00:16:02,740
.لكن لا بأس... أملك الآن سببًا لردّ الصّاع لهم أيضًا

178
00:16:03,120 --> 00:16:06,450
!ضحّى بيدرو حتّى بنفسه

179
00:16:12,380 --> 00:16:17,720
...حسنًا، يمكنني تعويض ذراعي المفقودة بالحلوى، لكن

180
00:16:18,710 --> 00:16:21,840
كلّ مرّة أرى يدي المينى

181
00:16:22,360 --> 00:16:26,560
،تذوب بحرارة كوب الشّاي السّاخن في العصر

182
00:16:27,310 --> 00:16:33,190
!سأتذكّر... وجه ذلك اليغور

183
00:16:33,560 --> 00:16:37,650
.أليس كذلك يا نابليون؟ لا شيء أشدّ إهانةً من ذلك

184
00:16:37,820 --> 00:16:41,780
.طاقم قبّعة القشّ مجرمون كبار في بلادنا على أيّ حال

185
00:16:41,780 --> 00:16:43,410
.لا مستقبل لهم

186
00:16:45,540 --> 00:16:47,750
...كيف أجعل

187
00:16:48,500 --> 00:16:51,730
!أصدقاءه يعانون حتّى أشفي غليلي؟

188
00:17:14,560 --> 00:17:17,560
ماذا؟ لماذا؟ لماذا؟

189
00:17:17,560 --> 00:17:19,940
!رحل الجميع

190
00:17:19,940 --> 00:17:24,520
...أريد أكل النّار حقًّا! أستنزفُ قوّتي

191
00:17:25,120 --> 00:17:28,580
...أريد أكل السّحب الرّعّادة أيضًا

192
00:17:33,960 --> 00:17:38,840
!إذًا لولا-تشان من ثريلر بارك كانت تتقن صنع الحلوى

193
00:17:39,130 --> 00:17:43,220
هذا صحيح. كانت لولا وزيرة
...الشّوكولاتة الّتي تدير جزيرة الكاكاو

194
00:17:43,260 --> 00:17:47,760
.لكن منذ رحيلها، ظلّ منصبها شاغرًا

195
00:17:47,930 --> 00:17:49,640
لماذا؟

196
00:17:49,850 --> 00:17:55,770
...لأنّ المرّشّح المفّضل لدى الجميع يواصل رفض العروض

197
00:17:55,900 --> 00:17:56,970
صحيح يا بودينغ؟

198
00:17:57,520 --> 00:18:00,070
...لـ-لأنّه، بالنّسبة لي

199
00:18:00,530 --> 00:18:04,990
!أختي لولا هي وزير الشّوكولاتة الوحيد لبلدة الشّوكولاتة

200
00:18:05,030 --> 00:18:07,830
...وآمل أن تعود قريبًا

201
00:18:08,330 --> 00:18:09,950
...أفهم قصدك ولكن

202
00:18:11,950 --> 00:18:13,030
ماذا؟

203
00:18:13,410 --> 00:18:15,250
ماذا؟ ماذا؟

204
00:18:15,580 --> 00:18:17,540
هل يمكن أنّني أتخيّل؟

205
00:18:17,920 --> 00:18:18,840
...لا

206
00:18:19,250 --> 00:18:22,510
!أ-أظنّ أنّ تلك ابنتي

207
00:18:22,670 --> 00:18:26,610
!مرحبًا! مرحبًا

208
00:18:29,600 --> 00:18:31,940
!مرحبًا

209
00:18:33,690 --> 00:18:35,730
...ذهبت

210
00:18:36,230 --> 00:18:37,900
...شيفون

211
00:18:38,060 --> 00:18:41,940
!اسمعي! اخرجي من هناك الآن يا بودينغ

212
00:18:43,400 --> 00:18:45,770
!مـ-مستحيل

213
00:18:45,770 --> 00:18:49,080
!أرتدي فستان زفاف الآن

214
00:18:49,120 --> 00:18:52,360
،إن جلستُ على السجّادة مع ذلك الرّجل

215
00:18:52,360 --> 00:18:57,510
!سيظنّ النّاس أنّنا حديثي الزّواج أقمنا عرسنا للتّوّ

216
00:18:59,670 --> 00:19:00,670
أيّ ناس؟

217
00:19:00,840 --> 00:19:05,860
!لا ندري من يشاهد! وسأنزعج إن ظنّوا ذلك

218
00:19:07,390 --> 00:19:10,350
!ذلك... يزعجني حقًّا، مفهوم؟

219
00:19:10,510 --> 00:19:13,270
.أشعر بالأسى حيال ذلك لكن لا تسقطي

220
00:19:13,890 --> 00:19:16,520
!ا-اخرس

221
00:19:16,730 --> 00:19:21,820
!كم هو لطيف! إنّه قلق عليّ

222
00:19:22,250 --> 00:19:27,820
!من تظنّ نفسك؟! سواءً سقطتُ أم لا ليس من شأنك

223
00:19:28,070 --> 00:19:29,700
!ها هي جزيرة الكاكاو

224
00:19:29,870 --> 00:19:33,160
!حسنًا! لنبدأ في صنع الكعك بمجرّد وصولنا

225
00:19:33,450 --> 00:19:38,000
...مهلًا! هل سمعت ما قلت يا سانجي

226
00:19:38,580 --> 00:19:39,960
!سان

227
00:19:42,880 --> 00:19:46,380
!رشّاش الصّقر

228
00:19:48,590 --> 00:19:51,760
...لا تقلّ لي أنّ كاتاكوري-ساما -
!يتعرّض للهجوم؟ -

229
00:20:09,160 --> 00:20:11,140
...أسايرك في هذا

230
00:20:12,030 --> 00:20:13,620
هل أقوم به بشكل خاطئ؟

231
00:20:20,880 --> 00:20:24,090
.لكنّه أكثر فعالية هكذا

232
00:20:32,050 --> 00:20:33,640
!هذا كاتاكوري-ساما الّذي نعرف

233
00:20:33,930 --> 00:20:38,640
قبّعة القشّ يملك ذراعين لكنّ
!كاتاكوري-ساما يملك العشرات

234
00:20:40,770 --> 00:20:43,270
!إنّه يوجّه عشرات الأضعاف من اللّكمات

235
00:20:50,320 --> 00:20:52,410
!كاتاكوري-ساما، هذا غاشم

236
00:21:13,900 --> 00:21:15,300
.أنت قويّ للغاية

237
00:21:19,680 --> 00:21:22,050
.لكن أظنّك ترى الآن

238
00:21:22,600 --> 00:21:26,020
،كما أسلفتُ الذّكر، من حيث القدرة

239
00:21:26,070 --> 00:21:29,090
.كلّ ما تستطيع أن تفعله، أستطيع فعله أفضل منك

240
00:21:29,690 --> 00:21:34,070
.أنت أدنى منّي من حيث السّرعة والقوّة وكلّ شيء

241
00:21:42,040 --> 00:21:44,790
!لن يخسر المطّاط أمام الموتشي

242
00:21:59,930 --> 00:22:02,560
!لا أرى قبّعة القشّ الآن أيضًا

243
00:22:02,730 --> 00:22:06,730
!لا تقل لي أنّه يستطيع التحرّك بسرعة مثل كاتاكوري-ساما

244
00:22:07,480 --> 00:22:09,070
هل تحاول منافستي؟

245
00:22:10,650 --> 00:22:12,570
!لن أخسر

246
00:22:14,490 --> 00:22:16,280
...فاكهة المطّاط

247
00:22:17,160 --> 00:22:19,370
!ختم الصّقر

248
00:22:22,160 --> 00:22:23,290
أهذا كلّ ما لديك؟

249
00:22:23,500 --> 00:22:24,860
!مستحيل

250
00:22:25,380 --> 00:22:26,670
!اختفى مجدّدًا

251
00:22:38,760 --> 00:22:41,810
!عرفتُ أنّ كاتاكوري-ساما في مستوى آخر تمامًا

252
00:22:50,650 --> 00:22:52,490
هل ستظهر قوّتك تاليًا؟

253
00:22:56,910 --> 00:22:58,450
.استسلم

254
00:23:10,880 --> 00:23:13,720
!يبدأ نزال بين لوفي وكاتاكوري

255
00:23:13,760 --> 00:23:16,760
قوّة فاكهة المطّاط الّتي أطاحت بالكثير من الأعداء

256
00:23:16,760 --> 00:23:20,640
!وفاكهة الموتشي الّتي لم تُهزم أبدًا تتواجهان مباشرةً

257
00:23:20,640 --> 00:23:23,850
القوّة ضدّ القوّة، في مواجهة العدوّ
،الأقوى على الإطلاق كاتاكوري

258
00:23:23,850 --> 00:23:27,060
!يشنّ لوفي لكمة عملاقة بكلّ ما أوتي من قوّة

259
00:23:27,060 --> 00:23:31,320
:في الحلقة القادمة من وان بيس
"!تبدأ معركة صعبة! لوفي ضدّ كاتاكوري"

260
00:23:31,360 --> 00:23:33,700
!ملك القراصنة، لن يكون إلّا أنا