1
00:00:02,660 --> 00:00:04,500
...الثّروة والشّهرة والسّلطة

2
00:00:04,800 --> 00:00:06,670
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,670 --> 00:00:08,570
.ملك القراصنة، غولد روجر

4
00:00:08,970 --> 00:00:12,740
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,740 --> 00:00:16,340
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,610 --> 00:00:20,210
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,820 --> 00:00:26,890
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,520 --> 00:00:30,460
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,360 --> 00:00:35,960
سنجمع كل أحلامنا

10
00:00:36,960 --> 00:00:42,400
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,800 --> 00:00:48,440
!ون بيس

12
00:00:48,940 --> 00:00:53,780
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,610 --> 00:00:59,220
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,320 --> 00:01:05,290
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,620 --> 00:01:11,160
!فإنّها ليست أسطورة إذًا

16
00:01:12,360 --> 00:01:18,040
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,100 --> 00:01:22,940
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,240 --> 00:01:25,840
!وتظاهر أنّها غير موجودة

19
00:01:26,810 --> 00:01:31,680
سنجمع كلّ أحلامنا

20
00:01:32,680 --> 00:01:37,860
ونبحر باحثين عن شيء

21
00:01:38,190 --> 00:01:41,090
،عملة في جيبي

22
00:01:41,190 --> 00:01:44,360
وتريد أن تصبح صديقي؟

23
00:01:44,460 --> 00:01:48,970
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,830 --> 00:01:51,000
!إننا كذلك

25
00:02:02,980 --> 00:02:04,280
!كم هو ثقيل

26
00:02:04,280 --> 00:02:05,850
ما-ما هذا؟

27
00:02:05,850 --> 00:02:06,920
!وجدتُه في المخزن

28
00:02:07,620 --> 00:02:09,990
!إنّها قذائف مدفعيّة

29
00:02:09,990 --> 00:02:13,960
،حصلنا أخيرًا على مدفع
!لذلك فكّرتُ أن نتدرّب قليلًا

30
00:02:13,960 --> 00:02:15,730
!دع الأمر لي فحسب

31
00:02:16,430 --> 00:02:19,130
أعتقد أنّني كنتُ في الثّالثة حينها
عندما قفزتُ على قذيفة مدفع

32
00:02:19,130 --> 00:02:21,200
!محلّقًا ومسافرًا نصف العالم

33
00:02:21,200 --> 00:02:23,270
كيف يعمل هذا الشّيء؟

34
00:02:22,470 --> 00:02:23,770
!استمع لي

35
00:02:24,130 --> 00:02:26,240
يا زورو! هل تعرف كيف
!تستعمل مدفعًا؟

36
00:02:26,670 --> 00:02:29,340
.كان نائمًا طوال هذا الوقت

37
00:02:30,940 --> 00:02:32,140
.إنّه ليس مرحًا

38
00:02:32,470 --> 00:02:36,550
،إذا أبحرنا قليلًا نحو الجنوب
!سنجد حيدًا سيكون هدفًا مثاليًّا

39
00:02:36,550 --> 00:02:37,410
!أأنت محقّة؟

40
00:02:37,780 --> 00:02:38,780
!هيّا بنا! هيّا بنا

41
00:02:38,780 --> 00:02:41,680
!فلنذهب إلى هناك

42
00:02:39,620 --> 00:02:41,680
!هل ستطلق مدفعًا من دوني؟

43
00:02:41,680 --> 00:02:45,420
اعتاد النّاس أن ينادوني سيّد
!المدافع أوسوبّ لمعلوماتك

44
00:02:45,420 --> 00:02:46,890
!استمع لي

45
00:02:51,060 --> 00:02:54,830
!ماضي أسلوب السّيوف الثّلاثة"
"!عهد زورو وكوينا

46
00:03:15,250 --> 00:03:19,690
!رجاءً

47
00:03:20,520 --> 00:03:22,460
!أنا هنا لتحدّي هذا الدّوجو

48
00:03:22,460 --> 00:03:25,760
!فليخرج إليّ شخص قويّ ويقاتلني

49
00:03:27,330 --> 00:03:30,530
تحدّي الدّوجو هو أمر نادر
.في هذه الأيّام

50
00:03:31,270 --> 00:03:33,070
!لا تستخفّ بي فقط لأنّني طفل

51
00:03:33,070 --> 00:03:35,870
!لا ندّ لي في القرية المجاورة

52
00:03:35,870 --> 00:03:38,740
.حسنًا، أقبل تحدّيك

53
00:03:39,310 --> 00:03:41,410
!سأحصل على هذا الدّوجو إن فزتُ

54
00:03:41,410 --> 00:03:42,610
وإن خسرتَ؟

55
00:03:42,610 --> 00:03:45,180
...حـ-حينها، سوف

56
00:03:45,180 --> 00:03:46,980
!سأصبح تلميذًا هنا

57
00:03:48,780 --> 00:03:51,080
...لا بأس بذلك. ولكن الآن

58
00:03:51,480 --> 00:03:52,420
!كوينا

59
00:03:54,850 --> 00:03:56,290
.نعم يا أبي

60
00:03:56,620 --> 00:04:00,160
!ماذا؟! ألن تقاتلني؟

61
00:04:00,390 --> 00:04:05,430
كوينا فتاة، لكنّها أقوى بكثير
.من البالغين في هذا الدّوجو

62
00:04:05,430 --> 00:04:07,730
...أقول هذا وإن كنتُ والدها

63
00:04:09,870 --> 00:04:11,200
!لا بأس

64
00:04:11,200 --> 00:04:13,210
.تفضّل بالدّخول إذًا

65
00:04:15,970 --> 00:04:17,580
أستطيع استعمال ما أشاء؟

66
00:04:17,940 --> 00:04:18,980
.خذ راحتك

67
00:04:22,510 --> 00:04:24,550
!حسنًا إذًا! لنبدأ

68
00:04:25,150 --> 00:04:26,820
!نعم! أريني ما لديك

69
00:04:28,990 --> 00:04:30,420
!انحنيا للآلهة

70
00:04:30,720 --> 00:04:31,620
ماذا يفعل؟

71
00:04:31,620 --> 00:04:32,620
...يبدو سخيفًا

72
00:04:33,020 --> 00:04:34,660
!انحنيا لبعضكما

73
00:04:35,390 --> 00:04:36,290
!ابدآ

74
00:04:53,780 --> 00:04:55,350
!سـ-سحقًا

75
00:05:02,750 --> 00:05:06,720
درستَ تقنيات أسلوب السّيفين من قبل؟

76
00:05:06,890 --> 00:05:09,690
كلاّ! اليوم هي أوّل مرّة
!أحمل فيها سيف خيزران

77
00:05:11,060 --> 00:05:12,500
اليوم هي أوّل مرّة؟

78
00:05:13,230 --> 00:05:14,730
!سُحقًا

79
00:05:15,470 --> 00:05:18,840
!أنا قويّ! وسأصبح أقوى بكثير

80
00:05:18,840 --> 00:05:23,440
!أرفض... أرفض أن أخسر أمام هذه الفتاة

81
00:05:26,840 --> 00:05:28,650
...هذا مؤلم

82
00:05:28,810 --> 00:05:30,710
!لماذا لم يتفاداها؟

83
00:05:31,850 --> 00:05:33,880
!انتهى النّزال

84
00:05:35,020 --> 00:05:36,620
.إنّه يشبه خنزيرًا برّيًّا

85
00:05:37,020 --> 00:05:38,250
!تمهّلي يا كوينا

86
00:05:38,250 --> 00:05:41,320
يحتاج مبتدئ مثله لعشر سنوات
.قبل أن يستعمل أسلوب السّيفين

87
00:05:43,990 --> 00:05:45,660
!ماذا؟

88
00:05:47,730 --> 00:05:48,630
ماذا؟

89
00:05:49,970 --> 00:05:52,470
!بإمكاننا خوض نزال آخر إن أردت

90
00:05:52,670 --> 00:05:54,770
!سُحقًا! الخسارة خسارة

91
00:05:54,770 --> 00:05:57,810
نعم. من الجيّد قبول الهزيمة
...بكياسة. إذًا فسوف

92
00:05:57,810 --> 00:06:00,940
!نعم! سأصبح تلميذًا هنا
!ألديك مشكلة في ذلك؟

93
00:06:01,140 --> 00:06:02,140
.على الإطلاق

94
00:06:03,450 --> 00:06:07,980
سأتدرّب وأتدرّب وأتدرّب

95
00:06:08,250 --> 00:06:11,290
!وثمّ سأهزمك

96
00:06:12,290 --> 00:06:13,590
!تذكّري ذلك

97
00:06:16,020 --> 00:06:17,760
.لن يحين ذلك اليوم أبدًا

98
00:07:15,750 --> 00:07:17,850
!انتهى النّزال

99
00:07:18,550 --> 00:07:21,550
الفوز لصالح كوينا بنتيجة
!ألفا فوز ودون أيّ هزائم

100
00:07:22,050 --> 00:07:24,290
...سُـ-سُحقًا

101
00:07:24,290 --> 00:07:26,530
!ما زلتَ ضعيفًا كما عهدتك يا زورو

102
00:07:28,130 --> 00:07:31,260
.أنت مثير للشّفقة. وخاصّة وأنّك صبيّ

103
00:07:34,670 --> 00:07:36,670
!مهلًا! زورو ليس ضعيفًا

104
00:07:36,940 --> 00:07:38,970
!إنّه الأقوى بين كلّ الأولاد

105
00:07:38,970 --> 00:07:40,270
!حتّى أنّه هزم راشدين

106
00:07:40,570 --> 00:07:43,540
.لكنّه أضعف منّي

107
00:07:44,510 --> 00:07:48,380
،حتّى باستعماله لسيفين
.يبقى الضّعيف ضعيفًا

108
00:07:48,580 --> 00:07:52,380
.على الفاشلين التزام الصّمت
.صراخكم يثير الشّفقة

109
00:08:02,060 --> 00:08:05,530
...خسرتَ ثانية يا زورو

110
00:08:05,530 --> 00:08:08,230
.حتّى بعد أن أصبحت بهذه القوّة

111
00:08:08,900 --> 00:08:11,370
سينسي! هل تمنحها تدريبات سرّيّة

112
00:08:11,370 --> 00:08:13,740
!لأنّها ابنتك؟

113
00:08:13,740 --> 00:08:14,670
!لا تغشّ

114
00:08:15,070 --> 00:08:17,640
.لا، لا. لا أقوم بأيّ من هذا

115
00:08:18,710 --> 00:08:20,880
.أصبح زورو قويًّا بالفعل

116
00:08:21,510 --> 00:08:25,050
.لكنّ كوينا تصبح أقوى أيضًا

117
00:08:25,620 --> 00:08:27,620
زورو؟

118
00:08:27,620 --> 00:08:28,890
.سأغسل وجهي

119
00:08:36,390 --> 00:08:37,230
!سُحقًا

120
00:08:38,230 --> 00:08:42,000
!لماذا لا أستطيع هزيمة كوينا؟
!لماذا؟! لماذا؟

121
00:08:42,000 --> 00:08:44,700
!سأصبح أقوى رجل في العالم

122
00:08:44,700 --> 00:08:45,940
!فلماذا؟

123
00:08:49,910 --> 00:08:53,340
!اللّيلة... سأقاتلها ثانية

124
00:08:56,780 --> 00:08:59,650
...مرّت سنة فقط مذ أصبح تلميذًا

125
00:08:59,650 --> 00:09:01,850
.إنّ تقدّم زورو لأمر مذهل بالفعل

126
00:09:02,590 --> 00:09:05,950
إنّه يتدرّب بشكل لا يُضاهى
.أكثر من الآخرين

127
00:09:06,520 --> 00:09:08,820
.لذلك فالأمر طبيعيّ في نظري

128
00:09:09,260 --> 00:09:13,800
لكن... يبدو أنّه ما زال ليس
.ندًّا لكوينا-سان

129
00:09:14,730 --> 00:09:18,030
.تواجه السّيّافات عراقيل ضخمة

130
00:09:19,230 --> 00:09:23,270
،حسب وضعها الآن
.فلا أستطيع توريثها الدّوجو

131
00:09:25,570 --> 00:09:26,570
!أبي

132
00:09:26,810 --> 00:09:27,880
!كوينا-سان

133
00:09:28,310 --> 00:09:30,580
.ليس من المهذّب استراق السّمع يا كوينا

134
00:09:31,510 --> 00:09:35,550
!سأصبح أقوى سيّافي العالم
!سترى ذلك

135
00:09:38,590 --> 00:09:41,390
...كوينا. بصفتك فتاة

136
00:09:42,690 --> 00:09:45,760
لا يمكنك أبدًا أن تصبحي
.الأقوى في العالم

137
00:10:07,210 --> 00:10:08,280
!زورو؟

138
00:10:08,280 --> 00:10:10,250
ما الّذي تفعلينه هنا؟

139
00:10:10,650 --> 00:10:12,550
!أنا من عليها قول ذلك

140
00:10:12,790 --> 00:10:14,820
ما الّذي تفعله في هنا
!في هذه السّاعة؟

141
00:10:18,530 --> 00:10:21,160
أنا هنا لأتحدّاك في نزالك
!الأوّل بعد الألفين

142
00:10:21,930 --> 00:10:24,830
!أنوي جعل هذا نزالي الأخير معك

143
00:10:25,400 --> 00:10:26,730
!سأضع نهاية لهذا

144
00:10:26,730 --> 00:10:28,370
!قاتليني بسيف حقيقيّ

145
00:10:29,300 --> 00:10:30,840
!لديك سيف حقيقيّ، صحيح؟

146
00:10:33,370 --> 00:10:34,570
ضدّي؟

147
00:10:39,980 --> 00:10:40,980
.أكيد

148
00:10:54,660 --> 00:10:56,660
...وادو إيتشيمونجي

149
00:12:05,730 --> 00:12:07,760
حمل سيفين حقيقيّين
قد يكون متعبًا، صحيح؟

150
00:12:09,030 --> 00:12:11,570
!يبدو أنّك ما زلت تفتقر للقوّة

151
00:12:12,770 --> 00:12:13,770
!اخرسي

152
00:12:26,820 --> 00:12:28,980
.فوزي الأوّل بعد الألفين

153
00:12:36,020 --> 00:12:38,390
...سُحقًا

154
00:12:39,990 --> 00:12:41,630
...سُحقًا

155
00:12:42,800 --> 00:12:44,630
...هذا فظيع

156
00:12:49,040 --> 00:12:52,070
.أنا من عليها البكاء من الإحباط

157
00:12:53,140 --> 00:12:54,040
ماذا؟

158
00:12:55,180 --> 00:13:00,680
،كما تعلم، عندما تكبر الفتيات
...يصبحن أضعف من الرّجال

159
00:13:01,650 --> 00:13:04,350
...حتّى إن لحقت بي قريبًا

160
00:13:06,020 --> 00:13:10,420
تقول دائمًا أنّك ستصبح
.أفضل سيّاف في العالم

161
00:13:11,630 --> 00:13:16,430
أخبرني أبي أنّه لا يمكن لفتاة
...أن تصبح كذلك

162
00:13:17,930 --> 00:13:18,930
...أعلم

163
00:13:19,530 --> 00:13:21,130
!أعلم ذلك

164
00:13:21,770 --> 00:13:24,340
!لكن... لكنّ ذلك محبط

165
00:13:25,010 --> 00:13:27,540
.أنت محظوظ يا زورو لأنّك صبيّ

166
00:13:28,480 --> 00:13:31,310
!أريد أن أصبح أعظم سيّافي العالم أيضًا

167
00:13:32,450 --> 00:13:35,050
...حتّى أن صدري بدأ يكبر الآن

168
00:13:36,050 --> 00:13:39,390
...ليتني... ليتني وُلدتُ صبيًّا

169
00:13:41,150 --> 00:13:43,960
!لا تنوحي هكذا بعد أن هزمتني

170
00:13:44,790 --> 00:13:47,960
!هذا ليس عدلًا! أنت هدفي

171
00:13:48,490 --> 00:13:49,460
...زورو

172
00:13:49,460 --> 00:13:51,300
!هذا للأولاد، وهذا للفتيات

173
00:13:51,300 --> 00:13:54,470
هل ستقولين أشياء كهذه أيضًا
!عندما أهزمك يومًا ما؟

174
00:13:54,470 --> 00:13:56,270
!تتصرّفين وكأنّه ليس للموهبة قيمة

175
00:13:56,670 --> 00:13:59,940
إنّك تهينين كلّ العمل الجادّ
!الّذي كنتُ أقوم به

176
00:14:00,510 --> 00:14:02,310
!لذلك لا تقولي أشياء كهذه

177
00:14:05,180 --> 00:14:06,310
!عديني

178
00:14:06,980 --> 00:14:10,820
يومًا ما، سيصبح أحدنا
!أعظم سيّافي العالم

179
00:14:11,550 --> 00:14:13,050
!سنتنافس لنرَ من سيحقّق ذلك

180
00:14:20,430 --> 00:14:21,860
...غبيّ. أنت ضعيف جدًّا

181
00:14:26,030 --> 00:14:27,230
!هذا وعد

182
00:14:37,010 --> 00:14:38,380
...مذهل

183
00:14:38,840 --> 00:14:41,750
!أصبحَ أقوى حتّى من ذي قبل

184
00:14:47,680 --> 00:14:51,760
عليّ أن أصبح أقوى لأتمكّن من حمل
.الكثير من السّيوف بكلّ راحة

185
00:14:51,760 --> 00:14:54,060
،إن كان سيفان لا يفيان بالغرض
!فسأستعمل ثلاثة

186
00:14:59,860 --> 00:15:01,460
ما الّذي تريدونه؟

187
00:15:04,130 --> 00:15:05,340
...إنّ كوينا

188
00:15:06,900 --> 00:15:09,240
...ماتت كوينا

189
00:15:20,550 --> 00:15:24,850
يبدو أنّها انزلقت وسقطت
...من سلالم المخزن

190
00:15:24,850 --> 00:15:25,650
المخزن؟

191
00:15:26,090 --> 00:15:30,730
يبدو أنّها كانت تبحث عن
.حجر شحذ لسيفها المحبوب

192
00:15:30,730 --> 00:15:32,460
لماذا قد تحتاجه؟

193
00:15:32,760 --> 00:15:34,100
...لا أدري

194
00:15:34,400 --> 00:15:35,930
...كانت مجرّد طفلة أيضًا

195
00:15:36,470 --> 00:15:38,830
...لا يمكننا فهم النّاس أبدًا

196
00:15:38,830 --> 00:15:41,740
...لا يعلم أحد ما يخفيه لنا القدر

197
00:17:12,860 --> 00:17:17,060
إنّ البشر مخلوقاتٌ هشّة، صحيح يا زورو؟

198
00:17:20,200 --> 00:17:21,430
...كوينا

199
00:17:22,270 --> 00:17:24,800
.كانت فتاة بروح تنافسيّة عالية

200
00:17:25,700 --> 00:17:28,870
،كانت تتدرّب في هذا الدّوجو منذ نعومة أظافرها

201
00:17:29,540 --> 00:17:32,410
ووصلت لقوّة تخطّت
.بها حتّى البالغين

202
00:17:33,210 --> 00:17:36,750
وبسبب ذلك، أصبحت
.معتدّة بنفسها قليلًا

203
00:17:38,350 --> 00:17:42,320
.وحينها أتيت أنت يا زورو

204
00:17:43,450 --> 00:17:45,390
.إنني شاكرٌ لك

205
00:17:46,290 --> 00:17:48,860
أصبحتَ أقوى
،وذلك دفعها لتتدرّب أكثر

206
00:17:49,290 --> 00:17:52,100
.وذلك لكي لا تخسر أمامك

207
00:17:53,030 --> 00:17:55,870
...لكي لا تخسر أمام صبيّ

208
00:17:57,970 --> 00:18:02,840
وكانت قد بدأت تتخطّى العراقيل
...الّتي تواجهها السّيّافات

209
00:18:04,370 --> 00:18:07,840
.لكنّني أب عاديّ أيضًا

210
00:18:10,950 --> 00:18:15,450
،عندما أنظر إليك الآن
...أشعر بالألم أيضًا

211
00:18:27,800 --> 00:18:28,730
...سينسي

212
00:18:30,770 --> 00:18:33,840
...اسمحي لي... بأخذ ذلك السّيف

213
00:18:36,570 --> 00:18:38,270
سيف كوينا؟

214
00:18:39,680 --> 00:18:43,050
!سأصبح أقوى من أجلها أيضًا

215
00:18:43,550 --> 00:18:46,850
سأصبح أقوى بما يكفي
!ليبلغ اسمي السّماء

216
00:18:47,780 --> 00:18:50,720
!سأصبح السّيّاف الأقوى في العالم

217
00:18:53,060 --> 00:18:55,590
...لقد وعدتُها

218
00:18:56,220 --> 00:18:57,360
...أنا

219
00:19:05,200 --> 00:19:07,400
.حسنًا. يمكنك أخذه

220
00:19:12,840 --> 00:19:17,650
.سأترك روح كوينا وأحلامها... بين يديك

221
00:20:01,220 --> 00:20:03,260
...مرّت ثمان سنوات على ذلك

222
00:20:04,190 --> 00:20:06,860
ستنطلق في رحلتك أخيرًا، صحيح؟

223
00:20:07,130 --> 00:20:08,860
.نعم يا سينسي

224
00:20:10,000 --> 00:20:12,770
.لأفي بوعدنا

225
00:20:25,640 --> 00:20:26,450
!زورو

226
00:20:30,420 --> 00:20:31,720
.اعتن بنفسك

227
00:20:37,760 --> 00:20:39,830
!ماذا؟ لم تكن قريبة حتّى

228
00:20:40,030 --> 00:20:41,630
!ما الّذي تفعلانه؟

229
00:20:41,830 --> 00:20:43,360
!نتدرّب على إطلاق المدفع

230
00:20:43,800 --> 00:20:45,730
!لكنّ الطّلقات لا تحلّق كما يجب

231
00:20:45,730 --> 00:20:48,800
!سبق وأخبرتك أن تدعني أجرّب

232
00:20:49,400 --> 00:20:51,770
...استنادًا لآخر مسافة تحليق

233
00:20:52,170 --> 00:20:53,240
.فهذا سيفي بالغرض

234
00:20:53,370 --> 00:20:54,540
!نار

235
00:20:56,210 --> 00:20:57,240
!مذهل

236
00:20:57,740 --> 00:20:59,240
!أصبته من أوّل محاولة لك

237
00:20:59,240 --> 00:21:00,880
...أصبته فعلًا

238
00:21:00,880 --> 00:21:04,680
!ما رأيك؟! أنا ماهر في التّصويب
!هل انبهرت؟

239
00:21:04,680 --> 00:21:05,720
!نعم! نعم

240
00:21:05,720 --> 00:21:08,150
!أخذتُ القرار! ستكون قنّاصنا

241
00:21:08,490 --> 00:21:10,790
!ماذا؟! لن أكون القائد؟

242
00:21:10,790 --> 00:21:12,260
!أنا هو القائد

243
00:21:13,720 --> 00:21:16,690
!لا يهمّ! سأجاريك حاليًّا

244
00:21:16,690 --> 00:21:20,160
،لكن إن فعلتَ شيئًا جبانًا
!سأصبح القائد في الحال

245
00:21:20,160 --> 00:21:21,230
.حسنًا، لا بأس

246
00:21:21,230 --> 00:21:25,200
على أيّ حال، كنتُ أفكّر
في أنّنا نحتاج لضمّ عضو آخر

247
00:21:25,200 --> 00:21:27,340
!"قبل ذهابنا إلى "الغراند لاين

248
00:21:27,340 --> 00:21:30,410
!نعم! لدينا مطبخ فاخر أيضًا

249
00:21:30,410 --> 00:21:32,080
!يمكنني الطّبخ إن دفعتَ لي

250
00:21:32,080 --> 00:21:34,140
إنّها ضرورة مهمّة للرّحلات الطّويلة، صحيح؟

251
00:21:34,140 --> 00:21:36,680
نعم! تملك كلّ سفن القراصنة
!واحدًا، صحيح؟

252
00:21:37,250 --> 00:21:38,520
!نحتاج موسيقيًّا

253
00:21:38,780 --> 00:21:40,180
!هل أنت غبيّ؟

254
00:21:40,180 --> 00:21:42,390
!ما هي الرّحلات البحريّة في رأيك؟

255
00:21:42,390 --> 00:21:44,490
وأنا الّذي اعتقدت
...أنّك ستقول شيئًا ذكيًّا

256
00:21:44,990 --> 00:21:47,690
!لكنّ القراصنة يغنّون

257
00:21:50,230 --> 00:21:52,500
!اخرجوا أيّها القراصنة الأوغاد

258
00:21:54,330 --> 00:21:56,870
!ماذا؟ ماذا؟ من أنت؟

259
00:21:57,630 --> 00:21:59,200
!اخرس

260
00:21:59,870 --> 00:22:02,640
!لا يهمّ من أكون

261
00:22:03,910 --> 00:22:05,610
كم هناك منهم؟

262
00:22:06,070 --> 00:22:07,980
واحد... على ما أظنّ؟

263
00:22:08,340 --> 00:22:09,980
.دعا الأمر له إذًا

264
00:22:10,880 --> 00:22:14,120
!قطعنا رؤوس العديد من القراصنة

265
00:22:14,480 --> 00:22:18,790
هل تحاول أيّها القرصان المجهول
!الحالم قتل شريكي؟

266
00:22:19,590 --> 00:22:20,460
...ذلك الصّوت

267
00:22:20,460 --> 00:22:22,190
!ماذا تعني بـ"شريك"؟

268
00:22:22,320 --> 00:22:26,690
،لا أدري ما الّذي يحدث
!لكن كفّ عن تكسير سفينتنا

269
00:22:28,760 --> 00:22:32,470
...خـ-خسرتُ في رمشة عين

270
00:22:33,800 --> 00:22:35,170
ماذا يحدث؟

271
00:22:36,340 --> 00:22:39,110
!أنت! هل أنت جوني؟

272
00:22:39,610 --> 00:22:42,480
!كيف تنطق باسمي بشكل مألوف هكذا؟

273
00:22:45,180 --> 00:22:47,050
!أ-أخي الكبير زورو؟

274
00:22:47,180 --> 00:22:48,620
!هذا أنت يا جوني

275
00:22:48,620 --> 00:22:50,050
!ماذا تفعل هنا يا أخي الكبير؟

276
00:22:50,050 --> 00:22:51,990
أين يوساكو؟ أليس معك؟

277
00:22:51,990 --> 00:22:53,020
ماذا؟ ماذا؟

278
00:22:53,990 --> 00:22:55,460
هل تعرفان بعضكما؟

279
00:22:55,980 --> 00:23:10,230
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

280
00:23:10,230 --> 00:23:17,170
ولطالما بحثت عن ذلك المكان الإعجازيّ

281
00:23:17,170 --> 00:23:24,340
لكي لا يسبقني أحد آخر إليه

282
00:23:26,880 --> 00:23:38,360
إن كان العالم سيتغيّر

283
00:23:38,360 --> 00:23:45,360
قبل أن أحقّق حلمي

284
00:23:45,360 --> 00:23:52,440
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

285
00:23:52,440 --> 00:24:05,820
لكي لا تمحى ذكرياتي

286
00:24:11,560 --> 00:24:13,130
أعتقد أنّنا نحتاج طبّاخًا، صحيح؟

287
00:24:13,130 --> 00:24:15,570
."يقولون أن هنالك "مطعمًا بحريًّا

288
00:24:15,570 --> 00:24:17,340
!تطلق سفينة بحريّة مدافعها

289
00:24:17,340 --> 00:24:18,240
!حسنًا! دعوا الأمر لي

290
00:24:18,240 --> 00:24:19,600
!المطعم في ذلك الاتّجاه يا غبيّ

291
00:24:19,600 --> 00:24:20,670
!سأذهب للاعتذار

292
00:24:21,010 --> 00:24:22,210
!لماذا التّأخّر؟

293
00:24:22,210 --> 00:24:23,670
!لنمرّ عليه ونأكل بعض الطّعام

294
00:24:23,670 --> 00:24:24,510
!ماذا؟ أتريد قتالًا؟

295
00:24:24,510 --> 00:24:25,640
ما قصّته؟

296
00:24:25,880 --> 00:24:27,510
:في الحلقة القادمة من ون بيس

297
00:24:27,510 --> 00:24:30,410
!طبّاخ مشهور"
".سانجي من المطعم البحريّ

298
00:24:30,610 --> 00:24:32,480
!ملك القراصنة، لن يكون إلاّ أنا