1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:20,800 --> 00:02:22,960
!لا تعرف يا كين-سان؟

29
00:02:22,960 --> 00:02:25,360
!لا ينبغي أن تحضره

30
00:02:42,460 --> 00:02:45,420
...كو

31
00:02:46,630 --> 00:02:48,260
!كوزكي أودن

32
00:02:50,470 --> 00:02:54,040
.كانت تلك محادثة مثيرة للاهتمام

33
00:02:55,000 --> 00:02:59,560
!لكن سلّماني ذلك الخنزير البرّيّ الأبيض

34
00:03:02,900 --> 00:03:07,050
"!قسم ولاء بالدّموع! أودن وكينييمون"

35
00:03:11,640 --> 00:03:12,720
!اتركني

36
00:03:12,720 --> 00:03:15,340
!اخرسي! أنت رهينة

37
00:03:15,340 --> 00:03:18,330
!ستتأذّين إن قاومت

38
00:03:27,930 --> 00:03:29,090
!ما-ما الأمر؟

39
00:03:47,700 --> 00:03:48,800
!كين-تشان

40
00:04:09,740 --> 00:04:13,620
،من أجل هذا الصّغير فحسب
!...فإنّ العاصمة سوف

41
00:04:13,620 --> 00:04:15,260
!كفاك صراخًا

42
00:04:15,790 --> 00:04:18,080
!لهذا السّبب أخبرتك أن تعطيني إيّاه

43
00:04:18,080 --> 00:04:22,650
لا! يساوي هذا الخنزير البرّيّ قطعة
!ذهب أبيض! هذا مبلغ كبير

44
00:04:23,110 --> 00:04:28,030
أستطيع سداد كلّ ديوني واستعمال
!البقيّة كرأسمال لجني المزيد من المال

45
00:04:28,170 --> 00:04:31,880
!كـ-كوزكي أودن! هذا هو بالفعل

46
00:04:31,880 --> 00:04:38,080
،أنا أزدري كلّ الكبار الأغبياء
!لكنّه الوحيد الّذي أحترمه

47
00:04:44,690 --> 00:04:49,880
إنّ الوقت الوحيد الّذي قد يأتي فيه إله الجبل
!إلى تجمّعات البشر هو عند اختطاف صغيره

48
00:04:50,030 --> 00:04:53,360
!أي أنّ هنالك من أحضر صغيره للعاصمة؟

49
00:04:53,360 --> 00:04:58,740
!علينا أن نُرضي إله الجبال
!اعثروا على خنزير برّيّ أبيض

50
00:04:58,740 --> 00:05:03,560
ستُدمّر العاصمة إن عجزنا عن إرسال
!الخنزير البرّيّ الأبيض للجبل

51
00:05:15,090 --> 00:05:17,660
!ساعدوني! النّجدة

52
00:05:20,200 --> 00:05:22,640
!تُبتلع المنازل وأصحابها بداخلها

53
00:05:22,640 --> 00:05:23,770
!أبي

54
00:05:23,770 --> 00:05:25,330
!يا له من كابوس

55
00:05:31,940 --> 00:05:34,240
!إخلاء النّاس له الأولويّة

56
00:05:34,240 --> 00:05:37,640
!فليتبعني كلّ من هو مستعدّ للموت

57
00:05:44,190 --> 00:05:46,230
!ها أنت ذا! كنتُ أبحث عنك

58
00:05:46,380 --> 00:05:48,500
!أنت خاطف الخنزير البرّيّ

59
00:05:48,500 --> 00:05:50,650
!لكنّك أخذته منّي

60
00:05:51,030 --> 00:05:53,830
!أعده إلى الجبل بسرعة

61
00:05:53,830 --> 00:05:58,590
سيسعى ذلك الوحش خلفنا مباشرة
!إن التقط رائحة صغيره

62
00:05:58,590 --> 00:05:59,410
!ماذا؟

63
00:05:59,560 --> 00:06:03,010
...لم نتوقّع أيًّا من هذا

64
00:06:03,010 --> 00:06:08,720
ابتلع إله الجبل مساعدَيّ اللّذين كانت
!تفوح من ملابسهما رائحة الخنزير البرّيّ

65
00:06:08,720 --> 00:06:11,150
!ومعهما صديقتك أوتسورو

66
00:06:12,130 --> 00:06:13,280
!لماذا هي؟

67
00:06:13,280 --> 00:06:19,510
أخذناها كرهينة لاستعادة الخنزير البرّيّ
...الأبيض منك وكنّا ننزل من الجبل

68
00:06:21,870 --> 00:06:25,440
!ابتُلع الجميع! إنّها غلطتك بالكامل

69
00:06:32,940 --> 00:06:33,780
!كين-سان

70
00:06:42,930 --> 00:06:48,480
سيسعى ذلك الوحش خلفنا مباشرة
!إن التقط رائحة صغيره

71
00:06:54,150 --> 00:06:55,860
!ابتعدوا عن طريقي

72
00:06:58,220 --> 00:06:59,550
!إنّه قادم من هنا

73
00:07:15,170 --> 00:07:17,880
!ماذا؟ سرق كين-سان شيئًا ما ثانية

74
00:07:17,880 --> 00:07:20,780
!أنا آسفة! سأردّ لك المال

75
00:07:27,960 --> 00:07:32,400
.كين-تشان، عليك العثور على عمل
!إنّ الياكوزا تطاردك دائمًا

76
00:07:32,400 --> 00:07:33,900
!ستتسبّب في مقتلك

77
00:07:33,900 --> 00:07:37,470
!من يهتمّ؟! لن يبكي موتي أيّ أحد

78
00:07:42,160 --> 00:07:44,890
!هذا مؤلم! لا تضربيني بحجر

79
00:07:45,810 --> 00:07:49,650
!أعد تسورو لي

80
00:08:27,830 --> 00:08:32,540
،توقّف يا فتى! إن ألحقت الأذى بإله الجبل
!فستُدمّر بلاد وانو

81
00:08:32,540 --> 00:08:35,650
!سأشقّ بطنه

82
00:08:36,150 --> 00:08:38,120
!تسمّي نفسك إلهًا؟

83
00:08:38,120 --> 00:08:41,300
!أعد تسورو لي

84
00:08:47,490 --> 00:08:48,580
!كين-سان

85
00:09:03,530 --> 00:09:05,720
!كين-سان! توقّف

86
00:09:06,680 --> 00:09:09,270
...إنّه شجاع

87
00:09:25,910 --> 00:09:29,240
...إن ماتت تسورو بسببي

88
00:09:34,500 --> 00:09:37,000
!أريد الموت أيضًا

89
00:09:46,390 --> 00:09:47,390
!سُحقًا

90
00:10:10,580 --> 00:10:14,580
!أليس هذا ما تبحث عنه أيّها الخنزير؟

91
00:10:19,980 --> 00:10:22,130
!كوزكي أودن! الابن الضّال

92
00:10:22,460 --> 00:10:26,970
!إنّه هو ثانية! لا بدّ أنّه تسبّب بكلّ هذا

93
00:10:27,180 --> 00:10:29,010
...إنّه مناسب تمامًا لحساء لحم خنزير جيّد

94
00:10:31,270 --> 00:10:33,580
!كيف أمكنك فعل هذا بنا؟

95
00:10:33,580 --> 00:10:35,060
!أعد أمّي لي

96
00:10:36,140 --> 00:10:37,020
...لا

97
00:10:37,520 --> 00:10:39,040
...هذا سوء فهم

98
00:10:39,040 --> 00:10:40,570
!أعد ابنتي لي

99
00:10:41,020 --> 00:10:44,870
!أنا من أحضر ذلك الخنزير إلى هنا

100
00:10:44,870 --> 00:10:49,490
!الفوضى الّتي حلّت على العاصمة غلطتي أنا

101
00:11:02,090 --> 00:11:04,210
!أسلوب أودن ذو السّيفين

102
00:11:38,370 --> 00:11:40,560
!شلاّل الفردوس

103
00:11:40,560 --> 00:11:41,920
!ماذا؟

104
00:11:48,280 --> 00:11:50,030
.هذا مذهل

105
00:11:50,340 --> 00:11:51,890
.لنعد أدراجنا

106
00:12:07,360 --> 00:12:10,360
!أوتسورو

107
00:12:08,220 --> 00:12:09,300
كين-تشان؟

108
00:12:11,410 --> 00:12:13,080
!كين-تشان

109
00:12:18,160 --> 00:12:21,590
...قالوا أنّ المنازل وسكّانها الّذين ابتُلعوا

110
00:12:21,590 --> 00:12:26,210
كان بمقدورهم بناء بلدة جديدة
.داخل معدة الخنزير البرّيّ

111
00:12:26,460 --> 00:12:33,180
.دُمّر ربع العاصمة، لكنّ المعجزة هي أنّ الجميع نجوا

112
00:12:40,910 --> 00:12:43,170
...أودن، كان ذلك رائعًا

113
00:12:43,170 --> 00:12:46,070
...رائع لدرجة أنّي أوشك على الصّراخ

114
00:12:46,480 --> 00:12:49,300
!أريد شكره على الأقلّ! لكن لا أستطيع

115
00:12:49,300 --> 00:12:52,660
!كلّ هذا بسببه هو! إنّه شرّير

116
00:12:54,600 --> 00:12:58,330
...استمعوا جميعًا! ما حدث هنا بالفعل

117
00:13:00,540 --> 00:13:02,750
!إيّاك حتّى أن تفكّر في ذلك

118
00:13:03,210 --> 00:13:05,340
!أودن-ساما

119
00:13:06,340 --> 00:13:08,440
...هذا من والدي إذًا

120
00:13:08,440 --> 00:13:12,010
...آسف لتبليغك بهذا في وقت احتفال

121
00:13:12,220 --> 00:13:15,930
!فهمت. إذًا فقد تبرّأ منّي وطردني من العاصمة

122
00:13:16,930 --> 00:13:19,600
!هذا مدعاة للضّحك أيّها الشّوغن-دونو

123
00:13:19,750 --> 00:13:26,250
!أعتقد أنّك وعاصمة الزّهور ما عدتم تتحمّلونني

124
00:13:26,250 --> 00:13:27,730
!أنا أقبل تبرّأه منّي

125
00:13:28,110 --> 00:13:32,070
!سأغادر! وعند حلول اللّيل، سأنام عند موطئي

126
00:13:32,220 --> 00:13:34,910
!أنا جائع

127
00:13:35,550 --> 00:13:41,580
وقعت حادثة إله الجبل في بلاد وانو
.عندما كان أودن لا يزال يافعًا

128
00:13:43,120 --> 00:13:45,100
هل تبكي يا كين-تشان؟

129
00:13:45,100 --> 00:13:46,670
!لا أبكي على الإطلاق

130
00:13:47,290 --> 00:13:50,650
!أوتسورو، أنا جاهز للموت من أجله

131
00:13:50,650 --> 00:13:51,990
!أنت تبكي

132
00:13:51,990 --> 00:13:54,680
!وأنا أيضًا! جاهز تمامًا للموت من أجله

133
00:13:54,820 --> 00:13:56,740
!مهلاً! انتظر يا دنجيرو

134
00:13:56,740 --> 00:13:58,220
!كين-تشان

135
00:13:58,370 --> 00:14:01,400
!كوزكي أودن! كوزكي أودن! كوزكي أودن

136
00:14:01,400 --> 00:14:03,250
!إنّه رائع بالفعل

137
00:14:03,250 --> 00:14:06,580
!اتّخذت قراري! سأتبعه لبقيّة حياتي

138
00:14:07,690 --> 00:14:09,420
!حاز على إعجابي أوّلاً

139
00:14:09,420 --> 00:14:12,740
!ليس بقدري أنا! أنا أوّل تابعيه

140
00:14:13,450 --> 00:14:16,130
!أتمنّى لو كنت حرًّا مثلهما

141
00:14:16,130 --> 00:14:23,090
،قيل أنّ الرّجال الّذين خطوا للأمام
،وكبحوا أنفسهم من اللّحاق بأودن

142
00:14:23,090 --> 00:14:25,870
...جعلوا العاصمة تنحني قليلاً

143
00:14:29,840 --> 00:14:33,130
!تفضّل رجاءً يا أودن-ساما
!رؤيتك لهي شرف لي

144
00:14:33,510 --> 00:14:36,610
!كان ياسويي-ساما في انتظارك

145
00:14:36,610 --> 00:14:38,800
!لا تكذب! أعرف أنّه ليس كذلك

146
00:14:39,760 --> 00:14:41,860
...لماذا قد أنتظر رؤية مغفّل

147
00:14:41,860 --> 00:14:44,310
!طُرد من العاصمة؟

148
00:14:44,680 --> 00:14:47,910
!ما الّذي تريده يا أودن؟
أتظنّ أنّك مهمّ بتابعين مثلهما؟

149
00:14:47,910 --> 00:14:49,360
!مرحبًا يا عمّي

150
00:14:49,500 --> 00:14:51,230
!لا تتحدّث هكذا

151
00:14:52,360 --> 00:14:54,740
!مهلاً! ثمّة بركة ماء

152
00:14:57,050 --> 00:15:01,950
!تفضّل واخطُ عليّ لتعبر

153
00:15:02,910 --> 00:15:05,180
!إنّه يتصرّف بريبة

154
00:15:05,180 --> 00:15:08,270
.إنّه خادم جديد

155
00:15:08,270 --> 00:15:11,960
!صحيح! احتضنني ياسويي-ساما

156
00:15:12,880 --> 00:15:16,470
.اسمي أوروتشي وأنا خادم

157
00:15:32,110 --> 00:15:34,630
!ماذا؟! هل ستغادر يا أودن-سان؟

158
00:15:34,630 --> 00:15:36,740
.ستقلّ المصائب، لكنّنا سنفتقده

159
00:15:38,030 --> 00:15:40,370
.سمعتُ بوجود وحش يعيش في كوري

160
00:15:40,740 --> 00:15:42,910
!اسمه أشورا دوجي

161
00:15:43,950 --> 00:15:48,290
...كوري أشبه بورم أصاب بلاد وانو
.حتّى سوكياكي-ساما عجز أمامها

162
00:15:49,230 --> 00:15:53,360
،بمجرّد أن يلتجئ مجرم ما إلى كوري
.لا تستطيع السّلطات الإمساك به

163
00:15:53,360 --> 00:15:57,890
لكنّه ما كان ليستطيع النّجاة هنا
.لو لم يكن قويًّا كفاية

164
00:15:57,890 --> 00:16:02,140
...مكان لا قانون فيه ويُعتبر بلدًا مختلفًا بالكامل

165
00:16:03,760 --> 00:16:07,310
!هذا مثير للاهتمام! سأجول بلاد وانو

166
00:16:10,250 --> 00:16:13,130
!أودن! مع السّلامة

167
00:16:13,130 --> 00:16:16,630
!كين! دنجيرو! زورونا ثانية

168
00:16:16,630 --> 00:16:17,840
!إلى اللّقاء

169
00:16:17,840 --> 00:16:21,630
.يأتي ويذهب كما يحلو له

170
00:16:21,630 --> 00:16:23,220
...إنّه حرّ تمامًا

171
00:16:23,220 --> 00:16:25,310
!ياسويي-ساما

172
00:16:25,470 --> 00:16:27,450
!ثمّة مشكلة

173
00:16:28,290 --> 00:16:33,100
!انظر للغرفة الّتي مكث فيها
!ما الّذي فعل بها؟

174
00:16:33,100 --> 00:16:35,880
!علينا أن نجعله يدفع مقابل الإصلاحات

175
00:16:37,050 --> 00:16:40,360
حسنًا، لنتظاهر أنّ كارثة طبيعيّة
...حلّت بنا فحسب

176
00:16:40,360 --> 00:16:43,200
!أنت متساهل كثيرًا معه

177
00:16:43,200 --> 00:16:45,430
!ياسويي-ساما

178
00:16:45,640 --> 00:16:47,310
ماذا هنالك أيضًا؟

179
00:16:49,230 --> 00:16:50,910
!اختفى المال؟

180
00:16:50,910 --> 00:16:53,940
!نعم! كان في الخزنة بكلّ تأكيد

181
00:16:54,080 --> 00:16:55,480
...عفوًا

182
00:16:56,650 --> 00:16:59,440
...أكره قول هذا

183
00:17:00,010 --> 00:17:02,570
!لكنّني رأيته

184
00:17:04,050 --> 00:17:09,660
عفوًا، وضع أودن-ساما المال
...في جيب صدره الدّاخليّ

185
00:17:10,520 --> 00:17:14,900
!عرفتُ ذلك! لقد عضّ اليد الّتي أطعمته

186
00:17:14,900 --> 00:17:15,940
!هذا لا يُغتفر

187
00:17:15,940 --> 00:17:18,590
.أعتقد أنّ أودن لن يُخفي حقيقة أخذه له

188
00:17:19,800 --> 00:17:21,470
أأنت واثق يا أوروتشي؟

189
00:17:22,260 --> 00:17:23,840
!نعم! أنا آسف

190
00:17:24,180 --> 00:17:27,810
!كنتُ خائفًا وعجزت عن فعل أيّ شيء

191
00:17:37,880 --> 00:17:43,000
بعد مغادرة مجموعة أودن لهاكوماي، واصلوا
...التّسبب بالمشاكل في كلّ أنحاء بلاد وانو

192
00:17:43,000 --> 00:17:45,450
!وهم في طريقهم إلى كوري

193
00:17:52,290 --> 00:17:54,670
!إلى متى ستواصلان اللّحاق بي؟

194
00:17:54,900 --> 00:17:56,310
!للأبد

195
00:17:56,310 --> 00:17:58,380
!إنّنا نحبّك كثيرًا

196
00:18:02,920 --> 00:18:04,340
!انزعج منّا

197
00:18:09,390 --> 00:18:12,490
!أنتما! لماذا تقفان هناك؟

198
00:18:12,490 --> 00:18:14,870
!نحن تابعاك، لذلك نقوم بحراستك

199
00:18:14,870 --> 00:18:16,560
!ادخلا أيّها الغبيّان

200
00:18:17,920 --> 00:18:19,820
!أودن-سان

201
00:18:21,190 --> 00:18:22,590
ماذا تفعل؟

202
00:18:22,590 --> 00:18:24,070
.أكتب يوميّاتي

203
00:18:24,220 --> 00:18:28,910
سمعتُ أنّ الملاّحين ما وراء البحار
.يكتبونها كلّ يوم على سُفنهم

204
00:18:29,410 --> 00:18:33,290
الكلمات التّالية هي ما كتبه أودن
.في يوميّاته عن رحلته

205
00:18:44,400 --> 00:18:48,760
.في رينغو، قابلنا أخوين رثّي الملابس ويتضوّران جوعًا

206
00:18:51,850 --> 00:18:53,310
!ارحلا

207
00:18:57,310 --> 00:19:01,020
،كانا يحاولان جني المال بالرّقص
.لكنّ النّاس عاملوهما ببرود

208
00:19:07,860 --> 00:19:09,990
!لماذا أنتما تتبعانني؟

209
00:19:11,910 --> 00:19:13,220
!كفّا عن الأكل أيّها الشّقيّان

210
00:19:13,560 --> 00:19:14,140
.أريد المزيد

211
00:19:14,140 --> 00:19:15,430
!قلت توقّف

212
00:19:15,430 --> 00:19:17,310
!لا تعطه المزيد

213
00:19:17,310 --> 00:19:20,860
،قيل أنّهما كانا ابنَيْ معلّم رقص

214
00:19:20,860 --> 00:19:24,520
.لكنّ والدهما اعتُقل وتشتّتت عائلتهما

215
00:19:24,520 --> 00:19:29,760
.لقد أكلا الأودن خاصّتنا بكلّ وقاحة وهما يبكيان

216
00:19:38,770 --> 00:19:45,380
في كيبي، كان هنالك غول يقصّ شعر
.الأحياء والأموات أيضًا ويأخذه

217
00:19:45,650 --> 00:19:49,910
.كان منحرفًا يصنع فُرَشًا ويبيعها لجني قوت يومه

218
00:19:59,060 --> 00:20:02,730
!مهلاً! أستسلم! أستسلم! أستسلم
!ظننتُك شخصًا ميتًا

219
00:20:02,730 --> 00:20:06,980
.سعى خلف شعري ولكمته، لكنّه تبعني بعدها

220
00:20:06,980 --> 00:20:10,840
ادّعى أنّه عانى من الاضطهاد
.في الماضي رغم أنّه كان يستحقّه

221
00:20:11,640 --> 00:20:16,150
وفي أودون ذي الغابات الكثيفة، تحدّث
.النّاس عن قاطع طرق الجبال المشهور

222
00:20:16,150 --> 00:20:20,770
.قيل أنّ النّساء تُختطفن والرّجال يُضربون بشدّة

223
00:20:21,730 --> 00:20:23,880
!لماذا تتبعونني؟

224
00:20:23,880 --> 00:20:25,230
أليس كذلك؟

225
00:20:36,540 --> 00:20:38,370
!هل ذاك هو قاطع طرق الجبال؟

226
00:20:41,650 --> 00:20:43,750
!أودن-ساما

227
00:20:44,880 --> 00:20:48,020
...لقد ترك أونيوابانشو عشيرة كوزكي

228
00:20:48,020 --> 00:20:50,390
.بعد أن فطرت كونويتشي قلبه

229
00:20:50,390 --> 00:20:53,030
.إنّه النّينجا العبقريّ رايزو

230
00:20:53,030 --> 00:20:57,270
!ما عدتُ أريد أن أعيش حياتي في الخفاء

231
00:21:02,480 --> 00:21:04,060
!لقد انزعج

232
00:21:14,820 --> 00:21:17,390
أتى كوزكي أودن إلى كوري؟

233
00:21:17,390 --> 00:21:19,300
...إنّه ابن الشّوغن

234
00:21:19,300 --> 00:21:22,810
!أريد قتله بنفسي! أمسكوه وأحضروه إليّ

235
00:21:22,810 --> 00:21:23,960
!حاضر

236
00:21:32,720 --> 00:21:37,100
!أصحاب السّلطة... هم أكثر من نكره

237
00:21:39,950 --> 00:21:41,830
أين أودن-سان؟

238
00:21:41,830 --> 00:21:44,310
.ذهب جنوبًا لقضاء حاجته

239
00:21:44,460 --> 00:21:46,460
.كان ذلك البارحة

240
00:21:46,460 --> 00:21:51,440
إنّه يختفي أحيانًا عندما يحلو له
ذلك ليوم أو يومين، صحيح؟

241
00:21:51,880 --> 00:21:54,800
!يا رايزو! ثمّة بوّابة إلى كوري جنوبًا

242
00:21:54,800 --> 00:21:55,530
!ماذا؟

243
00:21:56,640 --> 00:22:01,930
،كلاّ! كنتُ عازمًا على الموت من أجله
!لكنّني تركته يذهب لساحة القتال وحده

244
00:22:33,820 --> 00:22:38,540
!امتلأ ذلك المكان برائحة الموت والدّماء والعنف

245
00:22:38,540 --> 00:22:44,100
.كان أشبه بعالم مختلف
!كان لهم جميعًا رغبة بقتلي

246
00:22:44,460 --> 00:22:48,730
!سأقطع رأسك يا كوزكي أودن

247
00:23:04,370 --> 00:23:08,210
!روّض أودن أرضًا بلا قانون وتشكّل أعضاء الأكازايا

248
00:23:08,210 --> 00:23:10,790
!وسرعان ما أصبح أودن الدّايميو

249
00:23:10,790 --> 00:23:14,590
لكن يحدث أمر يضيف وقودًا جديدًا
!لحياته الحافلة بالأحداث سلفًا

250
00:23:15,050 --> 00:23:21,010
هل ستغير مجموعة القراصنة تلك
الّتي وصلت أخيرًا لبلاد وانو مصير أودن؟

251
00:23:22,260 --> 00:23:23,770
:في الحلقة القادمة من وان بيس

252
00:23:23,770 --> 00:23:27,220
"!تغيير المصير! انجراف قراصنة اللّحية البيضاء"

253
00:23:27,220 --> 00:23:29,770
!ملك القراصنة، لن يكون إلاّ أنا