1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,900 --> 00:02:01,570
...أنا جدّ قلقة بشأن أوتوكو

29
00:02:02,070 --> 00:02:05,450
،ومع ذلك يا كاواماتسو

30
00:02:05,450 --> 00:02:09,330
.لن أقابل الجميع الآن

31
00:02:09,700 --> 00:02:13,870
لا يجب أن يسمح النّاس
.للمشاعر أن تغلبهم قبل المعارك

32
00:02:16,420 --> 00:02:18,540
،معًا رفقة الجميع

33
00:02:18,540 --> 00:02:23,920
!أنقذوا بلاد وانو رجاءً

34
00:02:24,380 --> 00:02:29,650
أوّلاً، عليّ إخبارك أنّ الوحيد الّذي تمكّن
...من ترويض إنما في هذه البلاد

35
00:02:29,650 --> 00:02:33,520
كان كوزكي أودن وفشل
!في ذلكّ كلّ من سبقه وتلاه

36
00:02:34,430 --> 00:02:36,980
!أنا أعتمد عليكم

37
00:02:36,980 --> 00:02:40,360
!صحيح، دع الأمر لنا

38
00:02:40,360 --> 00:02:42,230
!أراكم في الميناء إذًا

39
00:02:42,940 --> 00:02:43,940
!نعم

40
00:03:00,540 --> 00:03:03,420
!انتظر فحسب يا كايدو

41
00:03:16,430 --> 00:03:21,320
أنا مجرّد وافد جديد اُختير
،من السّجلّ العسكريّ العالميّ

42
00:03:21,320 --> 00:03:27,610
،لكن مذ أن تمّ تعييني كأميرال في البحريّة
.ثمّة أمر أريد القيام به

43
00:03:27,610 --> 00:03:29,270
.البحريّة

44
00:03:29,270 --> 00:03:30,920
.الشّيتشيبوكاي

45
00:03:30,920 --> 00:03:32,530
.اليونكو

46
00:03:32,530 --> 00:03:35,410
ما الّذي سيحدث لتوازن القوى في رأيك؟

47
00:03:35,410 --> 00:03:39,580
لا أدري. من قد يمكنه الجزم
بذلك قبل أن نزعزعه؟

48
00:03:43,710 --> 00:03:51,640
تمّت الموافقة على ذلك القرصان المتوحّش
كملك لبلاد تحت نظام الشّيتشيبوكاي

49
00:03:51,640 --> 00:03:55,890
...وسُمح له بحكم هذه الجزيرة من طرف

50
00:03:57,020 --> 00:03:59,690
!حكومة العالم دون سواها

51
00:04:00,520 --> 00:04:03,450
...ما أريد تدميره هو

52
00:04:03,450 --> 00:04:05,070
.النّظام

53
00:04:05,440 --> 00:04:11,320
!ما عدنا بحاجة للشّيتشيبوكاي

54
00:04:14,410 --> 00:04:21,460
أخبار مهمّة! الحادثة الّتي ستؤثّر"
"!على الشّيتشيبوكاي

55
00:04:23,840 --> 00:04:30,840
قلعة بانغيا

56
00:04:26,300 --> 00:04:29,340
."المؤتمر العالميّ المعروف بـ"ليفيلي

57
00:04:29,340 --> 00:04:34,460
إنّه مؤتمر كبير يضمّ 50 ممثّلاً من
،ملوك وملكات يُعقد كل أربع سنوات

58
00:04:34,460 --> 00:04:42,100
.يُمثّلون أزيد من 170 بلادًا تابعة لحكومة العالم

59
00:04:47,610 --> 00:04:51,580
،تمّ فضّ مؤتمر "ليفيلي" في حالة ارتباك كبير كالعادة

60
00:04:51,580 --> 00:04:55,450
.عاد كلّ الممثّلين إلى بلدانهم

61
00:04:55,780 --> 00:04:56,990
...وثمّ

62
00:04:58,580 --> 00:05:01,250
...بعد أسبوع

63
00:05:02,330 --> 00:05:05,960
...يا إلهي... عدتُ للدّيار أخيرًا-جامون

64
00:05:05,960 --> 00:05:10,920
...يا إلهي... العالم السّطحيّ فوقنا بمسافة طويلة

65
00:05:10,920 --> 00:05:14,930
!عفوًا، شكرًا على مرافقتنا

66
00:05:14,930 --> 00:05:17,260
!يا جدّ لوفي-ساما

67
00:05:17,640 --> 00:05:20,230
.لا شكر على واجب

68
00:05:20,230 --> 00:05:23,100
كانت رحلة طويلة، صحيح يا نبتون؟

69
00:05:23,100 --> 00:05:25,310
!لا بدّ أنّك متعب

70
00:05:27,520 --> 00:05:29,390
.أنا منهك-جامون

71
00:05:29,390 --> 00:05:32,920
.غارب، ابق هنا معنا واسترح جيّدًا

72
00:05:32,920 --> 00:05:36,460
،حسنًا، ربّما سأحتسي كوب شاي

73
00:05:36,460 --> 00:05:40,620
...لكن نظرًا للوضع الحاليّ، لا أستطيع البقاء مطوّلاً

74
00:05:42,210 --> 00:05:45,120
.إنّ مؤتمر "ليفيلي" يسبّب الحوادث دائمًا

75
00:05:45,880 --> 00:05:51,090
،عندما تجتمع 50 دولة معًا
.عبارة "لنتّفق معًا" بسيطة لن تنفع

76
00:05:51,710 --> 00:05:54,840
.لكلّ بلاد العديد من المشاكل الخاصّة بها

77
00:05:54,840 --> 00:05:58,850
،تحدّق البلدان الكبيرة والقويّة لبعضها في صمت

78
00:05:58,850 --> 00:06:01,180
...ويدعون وكلاءهم يتشاجرون

79
00:06:06,690 --> 00:06:10,980
.بالنّسبة لهم، الموارد والتّقنيّات عبارة عن أسلحة

80
00:06:13,190 --> 00:06:17,620
،يُقال أنّ كلّ البلدان متساوية
.لكنّ هذا مجرّد وعود كاذبة

81
00:06:18,120 --> 00:06:25,080
،الثّروة والفقر والاختلافات الدّينيّة
...لن تسمح لها أن تكون متساوية

82
00:06:30,380 --> 00:06:34,640
حتّى إن تصافحوا، تجدهم يخفون
.الضّغائن لبعضهم بابتسامة

83
00:06:34,640 --> 00:06:38,640
أتساءل كم ثمّة من قائد قادر على الحديث

84
00:06:38,640 --> 00:06:40,930
...باسم مواطنيه والبلدان الأخرى

85
00:06:41,510 --> 00:06:43,790
...لا بدّ أنّ الطّاولة المستديرة تتحسّر عليهم

86
00:06:43,790 --> 00:06:48,410
أنت على حقّ. كانت المحادثات
.بين القادمة انفجاريّة

87
00:06:48,410 --> 00:06:54,900
ونحن لسنا استثناء، لكنّ المشاحنات
.بين البلدان لا يمكن أن تُحلّ بسهولة

88
00:06:55,320 --> 00:07:00,870
،إن وُجد تاريخ طويل
.فلا بدّ أنّ للصّراع جذورًا أعمق

89
00:07:01,780 --> 00:07:07,870
حتّى إن كانت هنالك خلافات، فسأسمّي
.ما بينهم سلامًا ما دامت لم تُرق الدّماء

90
00:07:08,460 --> 00:07:11,130
!لكنّ ما حدث هذه المرّة ليس جيّدًا

91
00:07:11,630 --> 00:07:13,040
،ربّما فات الأوان على قول هذا

92
00:07:13,040 --> 00:07:16,410
.لكن ثمّة أمر واحد في الحقيقة لم أخبرك به

93
00:07:16,800 --> 00:07:22,100
بعد أن فُضّ مؤتمر "ليفيلي" مباشرة
،وانطلقنا مغادرين، وقعت حادثة ما

94
00:07:22,100 --> 00:07:24,850
.وتلقّيت التّقرير على متن السّفينة

95
00:07:25,730 --> 00:07:30,270
سنبذل نحن البحريّة قصارى جهدنا
...لحلّها، لكن أرجوكم لا تخافوا

96
00:07:30,270 --> 00:07:34,150
!من العالم السّطحيّ وكذا البشر

97
00:07:34,570 --> 00:07:40,280
ماذا حدث؟ ما التّقرير الّتي تلقّيته يا غارب؟

98
00:07:40,910 --> 00:07:43,970
.إنّها حادثة تخصّ مملكة ألاباستا

99
00:07:43,970 --> 00:07:45,910
...مملكة ألاباستا

100
00:07:47,250 --> 00:07:48,710
!فيفي-ساما

101
00:07:50,670 --> 00:07:53,960
...قبل حدوث كلّ هذا

102
00:07:53,960 --> 00:07:58,340
في جريدة اقتصاد العالم بعد
...فضّ مؤتمر "ليفيلي" مباشرة

103
00:07:58,340 --> 00:08:01,360
!مذهل! الحوادث لا تنتهي

104
00:08:01,360 --> 00:08:04,320
.لا أصدّق أنّ كلّ هذه الأشياء حدثت دفعة واحدة

105
00:08:04,320 --> 00:08:07,680
!اسمعوا! فكّروا في أفضل العناوين على الإطلاق

106
00:08:08,690 --> 00:08:12,060
!يا سيّدي، أيّ المواضيع سيكون على الصّفحة الأولى؟

107
00:08:13,020 --> 00:08:15,320
!استمعوا! ثمّة من مات

108
00:08:15,320 --> 00:08:18,000
!تُباع جرائد أكثر عندما تحتوي نعيًا ضخمًا

109
00:08:18,000 --> 00:08:19,360
...إذًا فالعنوان الرّئيسيّ هو

110
00:08:19,360 --> 00:08:20,590
!كلاّ، انتظري

111
00:08:20,590 --> 00:08:23,320
.القرار الّذي تمّ الموافقة عليه جيّد أيضًا

112
00:08:23,320 --> 00:08:26,690
!لكنّ محاولة قتل تشعل الحماس

113
00:08:26,690 --> 00:08:27,560
!هذا صحيح

114
00:08:27,560 --> 00:08:31,930
!حسنًا، لنضع صفحتان أماميّتان
!ستكون الصّفحة الخلفيّة بنفس تصميم الأولى

115
00:08:31,930 --> 00:08:33,060
!في الحال

116
00:08:33,060 --> 00:08:34,510
!يا سيّدي

117
00:08:34,510 --> 00:08:37,130
.بريد سريع من الحكومة

118
00:08:37,550 --> 00:08:38,980
شيك، صحيح؟

119
00:08:38,980 --> 00:08:41,390
!هذا مبلغ كبير

120
00:08:41,390 --> 00:08:44,480
.فهمت. إنّه أمر للتّلاعب بالمعلومات

121
00:08:44,480 --> 00:08:47,020
لكن من أجل أيّ قضيّة؟

122
00:08:50,480 --> 00:08:53,680
يريدون التّكتّم على الحادثة؟

123
00:08:53,680 --> 00:08:55,190
!لا يمكنني فعل ذلك

124
00:08:55,690 --> 00:08:58,150
!ارمه على وجوههم

125
00:08:59,900 --> 00:09:01,030
ما الخطب يا هذا؟

126
00:09:01,030 --> 00:09:03,110
...لا، لا، لا

127
00:09:06,240 --> 00:09:09,220
!افعل ما يُملى عليك يا مورغانز

128
00:09:09,220 --> 00:09:11,830
!الوكالة السّرّيّة سايفر بول؟

129
00:09:11,830 --> 00:09:15,670
.عليك الانصياع لأوامر حكومة العالم

130
00:09:15,670 --> 00:09:17,000
!لا تتحرّكوا

131
00:09:21,130 --> 00:09:25,470
!"لا تستخفّ بمورغانز الملقّب بـ"الأخبار الهامّة

132
00:09:30,140 --> 00:09:32,480
!متى تسلّل إلى هنا؟

133
00:09:32,980 --> 00:09:36,670
!يا سيّدي! إنّ أعضاء سايفر بول ضبّاط في الحكومة

134
00:09:36,670 --> 00:09:40,150
.أعلم ذلك! من الخطير البقاء هنا يا رجال

135
00:09:40,150 --> 00:09:42,150
!لنغيّر مكاننا

136
00:09:45,700 --> 00:09:47,750
،قد أكون محبًّا للمال

137
00:09:47,750 --> 00:09:51,000
!لكنّني صحفيّ قبل كلّ شيء

138
00:09:51,370 --> 00:09:55,090
.أقوم أحيانًا بنسج الأكاذيب وخداع النّاس
!أنا أشبه بمنسّق أغانٍ للكلمات

139
00:09:55,090 --> 00:09:59,210
!أنا من يقرّر ما أنشره

140
00:10:03,090 --> 00:10:07,390
مورغانز-سان! وصلتك مكالمة من
...الملك وابول من مملكة درام

141
00:10:07,390 --> 00:10:08,810
الملك وابول؟

142
00:10:10,720 --> 00:10:12,560
ما الّذي يريده؟

143
00:10:12,560 --> 00:10:15,790
.نعم، يبدو أنّ لديه معلومات ليسرّبها

144
00:10:15,790 --> 00:10:17,810
!ماذا؟

145
00:10:28,070 --> 00:10:29,510
ما الّذي يحدث؟

146
00:10:29,510 --> 00:10:30,790
إصدار خاصّ؟

147
00:10:38,670 --> 00:10:39,630
...لا تقلقي

148
00:10:40,000 --> 00:10:41,800
...سنكون بخير

149
00:10:48,760 --> 00:10:52,220
إضافة إلى الحادثة الّتي فشلت
،الحكومة أن تتستّر عليها

150
00:10:52,220 --> 00:10:56,820
القرار الّذي وصل إليه القادة في مؤتمر
....ليفيلي" والحادثة الّتي وقعت هناك"

151
00:10:56,820 --> 00:11:02,360
أمسيا معروفين في كلّ أرجاء العالم
.في لمح البصر وصدما النّاس

152
00:11:03,150 --> 00:11:06,030
!مهلاً! ما الغاية من كلّ هذا؟

153
00:11:09,320 --> 00:11:13,090
هذا لا يُعقل! إنّها مجرّد قصّة
على جريدة اقتصاد العالم، صحيح؟

154
00:11:13,090 --> 00:11:16,750
!إنّها جريدة اقتصاد العالم
!لا بدّ أن رئيسها الطّائر ذاك يكتب هراءً ليس إلاّ

155
00:11:17,290 --> 00:11:19,630
!أنا واثق من ذلك

156
00:11:22,670 --> 00:11:26,060
...إنّه سابو! هذا مستحيل

157
00:11:26,060 --> 00:11:28,360
!لا أصدّق هذا

158
00:11:28,360 --> 00:11:29,470
!اهدأ

159
00:11:29,930 --> 00:11:33,320
.علينا التّأكّد من الحقائق أوّلًا

160
00:11:33,320 --> 00:11:38,600
...لكن لا يمكن الاتّصال بأيٍّ منهم
كيف لنا أن نتأكّد؟

161
00:11:38,900 --> 00:11:40,690
هذا مجرّد كذب، صحيح؟

162
00:11:42,070 --> 00:11:43,650
...سابو-كُن

163
00:11:46,320 --> 00:11:47,490
!يا سيّدتي

164
00:11:47,490 --> 00:11:49,530
!كان في ماريجوا؟

165
00:11:49,950 --> 00:11:52,580
!أ-أخي الكبير؟

166
00:11:55,200 --> 00:11:57,140
ما الّذي حلّ بماكينو؟

167
00:11:57,140 --> 00:12:00,080
.الحانة مغلقة اليوم

168
00:12:00,080 --> 00:12:03,290
...كانت هنالك أخبار كثيرة في العالم

169
00:12:03,290 --> 00:12:05,590
.أحتاج لمشروب الآن

170
00:12:08,590 --> 00:12:10,340
...إنّ سابو-كُن

171
00:12:12,680 --> 00:12:16,610
...عرفتُ للتّوّ أنّه كان حيًّا

172
00:12:16,610 --> 00:12:18,730
!أخبروني أنّ هذا كذب

173
00:12:18,730 --> 00:12:21,770
!سابو

174
00:12:30,110 --> 00:12:34,120
!لا أملّ أبدًا من هذا العالم

175
00:12:35,120 --> 00:12:37,290
!بدأت الأمور تصبح أكثر متعة

176
00:12:44,290 --> 00:12:46,800
!يا رجال

177
00:12:46,800 --> 00:12:48,720
!لنُبحر

178
00:12:48,720 --> 00:12:51,300
،بدل مشاهدة الحكومة وهي تضع يدها عليها

179
00:12:51,300 --> 00:12:54,220
!فسآخذها لنفسي

180
00:12:59,020 --> 00:13:02,270
...والآن، سنعود للأحداث الحاليّة

181
00:13:03,810 --> 00:13:13,490
...رنين، رنين، رنين... رنين، رنين، رنين

182
00:13:13,950 --> 00:13:15,490
...رنين، رنين، رنين

183
00:13:16,120 --> 00:13:17,100
.فتح

184
00:13:17,100 --> 00:13:19,040
.هذا أنا يا كوبي

185
00:13:23,460 --> 00:13:24,630
.تمهّل لحظة

186
00:13:24,630 --> 00:13:26,840
.لا يمكنني التّكلّم معك هنا

187
00:13:26,840 --> 00:13:27,380
.حسنًا

188
00:13:30,920 --> 00:13:33,070
!"صحيح! "بحر

189
00:13:33,070 --> 00:13:34,470
!"ضباب"

190
00:13:36,010 --> 00:13:38,660
...ضميرك حيّ كالعادة

191
00:13:38,660 --> 00:13:42,030
...حسنًا، إنّها قاعدة

192
00:13:42,030 --> 00:13:43,850
!صحيح! استمع

193
00:13:43,850 --> 00:13:46,360
...ثمّة أمر عليّ أن أبلغ به

194
00:13:46,900 --> 00:13:47,940
!لك أيّها النّقيب

195
00:14:11,050 --> 00:14:14,880
!ماذا؟! أهذا هو الوضع هناك؟

196
00:14:14,880 --> 00:14:18,010
...نعم، إنّه أكثر ممّا يمكن استيعابه

197
00:14:18,010 --> 00:14:21,310
...حتّى بوجود كلّ جنود البحريّة في العالم

198
00:14:21,310 --> 00:14:26,860
لذلك كما خطّطنا، لن تتدخّل
.البحريّة فيما يحدث هناك

199
00:14:26,860 --> 00:14:28,790
...ليس لديهم جنود بما يكفي

200
00:14:28,790 --> 00:14:33,240
.لا بأس بذلك في اعتقادي
.بلاد وانو ليست تابعة لحكومة العالم

201
00:14:33,700 --> 00:14:37,630
...والآن، بشأن وصول بيغ مام لأونيغاشيما

202
00:14:37,630 --> 00:14:38,530
.نعم

203
00:14:38,910 --> 00:14:42,550
كان هنالك صراع بين كايدو وبيغ مام
...منذ مدّة طويلة

204
00:14:42,550 --> 00:14:46,140
.تتوقّع البحريّة أن يدمّر هؤلاء القراصنة بعضهم

205
00:14:46,140 --> 00:14:47,590
.أظنّ ذلك

206
00:14:47,590 --> 00:14:52,880
...كما توقّعنا، كان كلّ من كايدو وبيغ مام يتربّصان للآخر

207
00:14:54,220 --> 00:14:56,050
!لكنّهما تحالفا معًا

208
00:14:58,260 --> 00:15:02,180
!ما-ما-ما-ماذا تقصد؟

209
00:15:06,020 --> 00:15:09,900
،بالنّسبة لقبّعة القشّ لوفي
.لا توجد أخبار عن أيّ هروب

210
00:15:10,360 --> 00:15:12,540
.ما زال الوضع على حاله

211
00:15:12,540 --> 00:15:14,910
،وثمّة أمر آخر. قد لا يكون هذا سارًّا

212
00:15:14,910 --> 00:15:18,110
.لكنّني رأيت سايفر بول زيرو في العاصمة قبل أيّام

213
00:15:18,110 --> 00:15:20,240
!ماذا؟! لماذا هم في بلاد وانو؟

214
00:15:21,530 --> 00:15:23,410
،آمل أن أكون مخطئًا

215
00:15:23,410 --> 00:15:26,470
...لكن لا بدّ أنّ ذلك يعني أنّ حكومة العالم تتعاون

216
00:15:26,470 --> 00:15:30,840
.مع بلاد وانو هذه الّتي يحكمها قرصان

217
00:15:31,960 --> 00:15:35,210
...عندما عرفتُ بالأمر، تسمّرت في مكاني

218
00:15:35,210 --> 00:15:37,630
.لبضع دقائق

219
00:15:47,140 --> 00:15:49,830
بالمناسبة، أين أنت الآن؟

220
00:15:49,830 --> 00:15:50,650
.حاضر

221
00:15:51,310 --> 00:15:55,230
...بهدف الإمساك بالإمبراطورة القرصانة بوا هانكوك

222
00:15:59,410 --> 00:16:02,120
!انطلقنا باتّجاه جزيرة النّساء

223
00:16:02,990 --> 00:16:04,340
...هذا حقيقيّ

224
00:16:04,340 --> 00:16:07,870
...تلك السّفن قادمة نحونا وتعبر الحزام الهادئ

225
00:16:07,870 --> 00:16:09,750
!تعود لأسطول البحريّة؟

226
00:16:10,630 --> 00:16:12,480
!مارغريت

227
00:16:12,480 --> 00:16:15,630
!ما الّذي سيحدث؟

228
00:16:17,760 --> 00:16:20,970
...الأخبار الّتي انتشرت في العالم

229
00:16:21,720 --> 00:16:24,530
كان عليهم التّخلّص من ذلك النّظام
!اللّعين منذ مدّة بعيدة

230
00:16:24,530 --> 00:16:27,140
...كان التّعاون مع القراصنة خطأ من الأساس

231
00:16:27,850 --> 00:16:28,890
!إنّهم أشرار

232
00:16:29,390 --> 00:16:32,520
بالنّسبة لأولئك الّذين يظنّون
...أنّ كلّ القراصنة أشرار

233
00:16:34,400 --> 00:16:37,240
!كلاب الحكومة أولئك سيختفون أخيرًا

234
00:16:37,240 --> 00:16:41,110
!سُحقًا للإمبراطورة القرصانة وعين الصّقر والمهرّج

235
00:16:41,110 --> 00:16:44,240
!ما هم إلاّ لصوص

236
00:16:45,330 --> 00:16:49,330
،وبالنّسبة للّذين يكرهون اللّصوص
...كانت أخبارًا جيّدًا

237
00:16:49,330 --> 00:16:53,840
!لكنّني اعتقدتُ أنّهم أبلوا حسنًا في حرب القمّة

238
00:16:54,590 --> 00:16:56,250
!"اتّخذ القرار في مؤتمر "ليفيلي

239
00:16:56,630 --> 00:16:58,900
.أعتقد أنّ البحريّة ستبدأ التّحرّك في الحال

240
00:16:58,900 --> 00:17:00,470
أسيكون كلّ شيء بخير؟

241
00:17:00,470 --> 00:17:03,910
!لقد كانوا إحدى القوى الثّلاث العظمى في العالم

242
00:17:03,910 --> 00:17:07,610
وبالنسبة لأولئك الّذي عرفوا كيف
،أبلوا في حرب القمّة

243
00:17:07,610 --> 00:17:12,450
وأولئك القلقين بشأن فقدان
،توازن القوى العظمى الثّلاث

244
00:17:12,450 --> 00:17:15,360
.كان هذا وضعًا مقلقًا بحقّ

245
00:17:17,780 --> 00:17:21,180
،"إحدى الأخبار النّاجمة عن آخر مؤتمر "ليفيلي

246
00:17:21,180 --> 00:17:25,070
...والّتي صدمت النّاس في أنحاء العالم كانت

247
00:17:26,530 --> 00:17:30,370
!إلغاء نظام الشّيتشيبوكاي الملكيّين

248
00:17:30,370 --> 00:17:38,750
أسياد حرب البحر السّبعة

249
00:17:31,790 --> 00:17:36,640
.الشّيتشيبوكاي الملكيّين هم قراصنة معترف بهم رسميًّا

250
00:17:36,640 --> 00:17:39,020
،رغم أنّه مسموح لهم بالنّهب

251
00:17:39,020 --> 00:17:43,900
.تستعملهم الحكومة كرادع ضدّ القراصنة الآخرين

252
00:17:43,900 --> 00:17:50,140
.تغيّرت تشكيلة الشّيتشيبوكاي باستمرار مع مرور الوقت

253
00:17:56,020 --> 00:17:57,440
.كروكودايل

254
00:17:57,900 --> 00:18:02,900
لقد تصادم مع طاقم قبّعة القشّ
.حول مملكة ألاباستا

255
00:18:02,900 --> 00:18:05,780
،كان يحاول الاستيلاء على المملكة

256
00:18:05,780 --> 00:18:09,870
.لكنّه هُزم على يد لوفي وطُرد من الشّيتشيبوكاي

257
00:18:10,660 --> 00:18:14,090
الرّجل الّذي أخذ مكان كروكودايل
...وانضمّ للشّيتشيبوكاي

258
00:18:14,090 --> 00:18:16,190
.هو مارشال د. تيتش

259
00:18:16,190 --> 00:18:22,880
.ولكن، بعد تحقيقه لهدفه، أعلن عن استقالته

260
00:18:24,090 --> 00:18:26,110
،"وهنالك جينبي، "ابن البحر الأول

261
00:18:26,110 --> 00:18:29,410
.الّذي عارض حرب القمّة وأصبح عدوًّا للبحريّة

262
00:18:29,410 --> 00:18:32,640
.قدّم هو أيضًا استقالته

263
00:18:35,850 --> 00:18:37,530
.غيكّو موريا

264
00:18:37,530 --> 00:18:44,030
اعترض هذا الرّجل طريق طاقم قبّعة القشّ
.سابقًا واستُدعي لحرب القمّة أيضًا

265
00:18:45,200 --> 00:18:46,160
...ولكن

266
00:18:47,490 --> 00:18:51,710
بعد الحرب، هوجم على حين غرّة نزولاً
عند أمر من كبار المسؤولين في الحكومة

267
00:18:51,710 --> 00:18:53,750
.وتمّ طرده

268
00:18:54,460 --> 00:18:57,920
...الشّيطان السّماويّ دونكيهوتي دوفلامينغو

269
00:18:59,090 --> 00:19:02,060
في نفس الوقت الّذي حكم فيه
،دريسروزا كملك لها

270
00:19:02,060 --> 00:19:08,230
كان يقوم بتهريب فواكه الشّيطان الاصطناعيّة
.المعروفة بـ"سمايل" كوسيط مؤثّر خلف الظّلال

271
00:19:08,230 --> 00:19:09,470
...ولكن

272
00:19:10,390 --> 00:19:13,610
خسر المعركة للسّيطرة على المملكة ضدّ لوفي

273
00:19:13,610 --> 00:19:16,080
.والبقيّة وتمّ سحب لقب الشّيتشيبوكاي منه

274
00:19:16,480 --> 00:19:19,030
.وهناك ترافالغار لو أيضًا

275
00:19:19,030 --> 00:19:26,240
لقد تحالف مع طاقم قبّعة القشّ للإطاحة
.بدوفلامينغو وسُحب منه لقبه أيضًا

276
00:19:27,200 --> 00:19:30,660
القراصنة الأربعة الّذين يفرضون
.سيطرتهم وكأنّهم أباطرة

277
00:19:32,200 --> 00:19:33,870
.اليونكو

278
00:19:34,290 --> 00:19:37,750
.مقرّ البحريّة الرّئيسيّ الّذي يحاول احتواءهم

279
00:19:37,750 --> 00:19:40,330
.إضافة إلى الشّيتشيبوكاي

280
00:19:40,330 --> 00:19:45,850
حافظت هذه القوى العظمى الثّلاث
.على السّلام في العالم

281
00:19:45,850 --> 00:19:46,970
...ولكن

282
00:19:47,380 --> 00:19:50,560
.ثمّة ملكان تكبّدا خسائر فادحة من الشّيتشيبوكاي

283
00:19:50,560 --> 00:19:54,060
،الملك نيفيرتاري كوبرا من مملكة ألاباستا

284
00:19:54,520 --> 00:19:57,610
.والملك ريكو دولدو الثّالث من مملكة دريسروزا

285
00:19:57,610 --> 00:20:00,900
.لقد دافعا على إلغاء نظام الشّيتشيبوكاي

286
00:20:01,480 --> 00:20:05,110
،"وبعد نقاش حامٍ في مؤتمر "ليفيلي

287
00:20:05,110 --> 00:20:10,450
.دعمت أغلبيّة كبيرة هذا الاقتراح وتمّ الموافقة عليه

288
00:20:10,740 --> 00:20:16,300
وبالتّالي، سيتنازل كلّ الشّيتشيبوكاي
،الملكيّين عن كلّ حقوقهم بالطّبع

289
00:20:16,300 --> 00:20:20,010
.وعلاقاتهم مع حكومة العالم ستُقطع

290
00:20:20,010 --> 00:20:21,040
!...ممّا يعني

291
00:20:21,880 --> 00:20:23,220
!باغي

292
00:20:23,220 --> 00:20:27,260
!أنت مجرّد قرصان آخر الآن

293
00:20:28,300 --> 00:20:30,430
!هذا ليس عدلاً أيّها المغفّلون

294
00:20:30,430 --> 00:20:35,320
تمّ اتّخاذ القرار دون إعلامنا، وبما أنّنا
!لم نعد مفيدين، ستعتقلوننا؟

295
00:20:35,320 --> 00:20:37,570
!لا حسّ عدالة لديكم على الإطلاق

296
00:20:37,570 --> 00:20:42,160
تحايل كروكودايل دوفلامينغو
!عليكم لا علاقة له بعملي

297
00:20:42,160 --> 00:20:45,080
!لا تنفّسوا عن غضبكم عليّ

298
00:20:45,080 --> 00:20:47,860
!السّاحل بأكمله محاصر

299
00:20:48,530 --> 00:20:50,030
ماذا نفعل؟

300
00:20:51,200 --> 00:20:55,200
!ذهبت خطّة حياتي بأكملها أدراج الرّياح

301
00:20:55,660 --> 00:20:56,660
ماذا؟

302
00:20:57,040 --> 00:21:00,170
!يُفترض أن تكون البحريّة إلى جانبنا، لكنّنا محاصرون

303
00:21:00,170 --> 00:21:02,130
!ما العمل يا ماما؟

304
00:21:02,580 --> 00:21:04,340
!ماما

305
00:21:06,090 --> 00:21:09,470
!سلّم نفسك في الحال يا عين الصّقر ميهوك

306
00:21:09,920 --> 00:21:11,840
!سلّم نفسك

307
00:21:13,680 --> 00:21:16,560
!يا أميرة الثّعابين، لدينا مشكلة

308
00:21:16,560 --> 00:21:20,980
!تمّ سحب لقب الشّيتشيبوكاي منك

309
00:21:21,350 --> 00:21:22,770
!أيّتها الجدّة نيون

310
00:21:22,770 --> 00:21:24,750
!ثمّة سفن تابعة للبحريّة على السّاحل

311
00:21:24,750 --> 00:21:25,940
!ماذا قلت؟

312
00:21:25,940 --> 00:21:28,740
!بدؤوا تحرّكاتهم بالفعل؟

313
00:21:30,530 --> 00:21:32,200
!لا تهلعن

314
00:21:34,620 --> 00:21:35,780
!أميرة الثّعابين

315
00:21:35,870 --> 00:21:38,200
...أعتقد أنّهم

316
00:21:40,000 --> 00:21:41,770
!قد نسوا أمرًا

317
00:21:41,770 --> 00:21:44,560
!لا فائدة أيّها الرّئيس باغي

318
00:21:44,560 --> 00:21:45,960
!هل نهرب؟

319
00:21:46,590 --> 00:21:50,630
!بالطّبع سنقاتلهم بطريقة مبهرجة

320
00:21:55,260 --> 00:21:57,760
!أظهروا بعض الجرأة

321
00:21:57,760 --> 00:22:00,310
!أيّها الحمقى

322
00:22:01,730 --> 00:22:04,350
!هذا هو رئيسنا باغي

323
00:22:05,860 --> 00:22:09,780
!باغي! باغي! باغي! باغي

324
00:22:09,780 --> 00:22:13,280
!يبدو أنّهم ما عادوا في صفّنا

325
00:22:13,280 --> 00:22:15,750
...هذا لا يُغتفر

326
00:22:15,750 --> 00:22:19,600
!ويفيل! أمنحك الإذن للإطاحة بهم

327
00:22:19,600 --> 00:22:21,700
...فعلاً؟ إذًا

328
00:22:21,800 --> 00:22:24,620
!سأقتلهم

329
00:22:26,000 --> 00:22:29,170
!باسم اللّحية البيضاء

330
00:22:29,750 --> 00:22:31,460
...أشعر برعشة حماس

331
00:22:32,130 --> 00:22:33,840
...مرّ وقت طويل

332
00:22:35,890 --> 00:22:39,390
.مذ كنتُ أنا من يُطارَد

333
00:22:40,430 --> 00:22:43,980
...أصبحنا أعضاء في الشّيتشيبوكاي الملكيّين

334
00:22:46,270 --> 00:22:49,330
!لأنّنا أقوياء

335
00:22:49,330 --> 00:22:52,240
!أعتمد عليكم يا رفاق

336
00:22:52,650 --> 00:22:54,490
...وبينما تقومون بذلك

337
00:22:56,910 --> 00:22:59,240
...سأنفذ بجلدي من هنا

338
00:23:04,410 --> 00:23:06,200
!كايدو وبيغ مام

339
00:23:06,200 --> 00:23:09,230
هل هذا يعني أنّ مجموعة قراصنة
روكس الوحشيّة الّتي حكمت

340
00:23:09,230 --> 00:23:11,300
!البحر بكامله في السّابق قد عادت؟

341
00:23:11,300 --> 00:23:12,970
الأسطورة الّتي تحكي عن غارب جدّ لوفي

342
00:23:12,970 --> 00:23:16,580
!وتحالفه مع ملك القراصنة قد كشف عنها النّقاب

343
00:23:16,580 --> 00:23:21,860
!فُقد توازن القوى! لا يستطيع أحد حلّ الارتباك الآن

344
00:23:22,430 --> 00:23:26,640
:في الحلقة القادمة من وان بيس
"!معركة أسطوريّة! غارب وروجر"

345
00:23:26,640 --> 00:23:30,440
!ملك القراصنة، لن يكون إلاّ أنا