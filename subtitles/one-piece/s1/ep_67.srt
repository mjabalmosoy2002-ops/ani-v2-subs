1
00:00:14,040 --> 00:00:15,570
...إرادة موروثة

2
00:00:15,570 --> 00:00:17,810
...تعاقب الأزمنة... أحلام النّاس

3
00:00:18,480 --> 00:00:21,310
.لا رادع لهذه الأشياء

4
00:00:21,310 --> 00:00:24,410
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:24,410 --> 00:00:27,050
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:35,660 --> 00:00:42,030
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:42,030 --> 00:00:47,540
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:00:47,540 --> 00:00:53,540
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:00:53,540 --> 00:00:57,050
أشعر بـ"الجمال" في كلّ مكان

10
00:00:57,050 --> 00:01:00,350
أنا متمسّك بكم بشدّة بالفعل

11
00:01:00,350 --> 00:01:06,990
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:06,990 --> 00:01:10,290
إلى أن أحصل عليه بكلّ إثارة

13
00:01:10,290 --> 00:01:17,300
!آمنوا ببلاد العجائب

14
00:01:19,200 --> 00:01:25,410
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:25,410 --> 00:01:31,410
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:31,410 --> 00:01:34,520
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:34,520 --> 00:01:37,850
،بل أريدها حياة عاديّة لا غير

18
00:01:37,850 --> 00:01:41,090
فاركضوا نحو النّعيم بدل ذلك

19
00:01:41,290 --> 00:01:51,030
!آمنوا ببلاد العجائب

20
00:02:11,520 --> 00:02:15,660
!توصيل الأميرة فيفي"
"!يشدّ قراصنة لوفي الرّحال

21
00:02:18,990 --> 00:02:20,460
!كم هما مزعجان

22
00:02:20,660 --> 00:02:22,260
!ما مشكلتهما؟

23
00:02:26,700 --> 00:02:29,540
!هذا مستحيل! يا لها من قوّة

24
00:02:30,270 --> 00:02:32,100
!لا أصدّق عينيّ

25
00:02:32,470 --> 00:02:34,870
!حسنًا إذًا. لننهِ هذا الأمر

26
00:02:35,910 --> 00:02:37,040
!أجل

27
00:03:05,540 --> 00:03:07,870
!توقّفا

28
00:03:13,810 --> 00:03:16,910
!ما الّذي تفعلانه؟

29
00:03:17,150 --> 00:03:19,820
لحسن حظّكما أنّكما استطعتما
!إبقاء الفتاة آمنة

30
00:03:19,820 --> 00:03:22,920
!كدتما تتركان مليار بيري يفلت من أيدينا

31
00:03:24,220 --> 00:03:25,460
!مفهوم؟

32
00:03:26,360 --> 00:03:29,430
عمّ تتحدّثون؟

33
00:03:29,890 --> 00:03:32,200
لماذا أنقذتموني؟

34
00:03:32,800 --> 00:03:36,100
!صحيح! علينا الحديث بشأن ذلك

35
00:03:36,100 --> 00:03:38,900
ما في الأمر هو... هلاّ أبرمتِ عقدًا معي؟

36
00:03:39,100 --> 00:03:40,370
عقد؟

37
00:03:40,970 --> 00:03:42,540
!كفاكما قتالاً

38
00:03:50,610 --> 00:03:53,680
!كان عليك قول ذلك فحسب يا زورو

39
00:03:53,680 --> 00:03:56,150
ظننتُ أنّك قمت بتقطيعهم فحسب

40
00:03:56,150 --> 00:03:58,860
لأنّهم لم يعدّوا أيّ طعام
!تحبّه أو ما شابه

41
00:03:58,860 --> 00:04:00,990
!لا تقارنّي بك

42
00:04:02,020 --> 00:04:03,460
!لا عليك! انس الأمر

43
00:04:03,460 --> 00:04:04,530
!اخرسا

44
00:04:05,260 --> 00:04:07,360
!هذا كلّ ما هنالك

45
00:04:07,860 --> 00:04:11,100
.وكتعويض، ستعطينا مليار بيري

46
00:04:12,000 --> 00:04:14,070
.رأيتِ كم هما قويّان

47
00:04:14,970 --> 00:04:17,270
.إنّه عرض جيّد جدًّا في رأيي

48
00:04:17,510 --> 00:04:18,240
!لا أستطيع

49
00:04:19,340 --> 00:04:21,740
.أقدّر أنّكم أنقذتموني. شكرًا لكم

50
00:04:21,740 --> 00:04:23,750
!لماذا لا تستطيعين؟! أنت أميرة

51
00:04:23,750 --> 00:04:25,650
...مليار بيري ليست بالشّيء الكثير

52
00:04:26,580 --> 00:04:29,250
هل تعرفين مملكة ألاباستا؟

53
00:04:29,250 --> 00:04:30,020
.لا

54
00:04:34,790 --> 00:04:38,560
إنّها مملكة مسالمة معروفة
.كحضارة وأمّة عظيمة

55
00:04:38,890 --> 00:04:40,060
.في الماضي على الأقلّ

56
00:04:40,760 --> 00:04:43,160
.في الماضي؟ ألم تعد كذلك

57
00:04:43,400 --> 00:04:45,100
.إنّها وسط حرب أهليّة

58
00:04:45,930 --> 00:04:49,040
.بدأت بوادر ثورة تظهر منذ سنوات الآن

59
00:04:50,000 --> 00:04:53,570
ثار الشّعب ووقعت المملكة
...في فوضى عارمة

60
00:04:56,110 --> 00:04:59,510
...وذات يوم، سمعتُ اسم منظّمة ما

61
00:04:59,910 --> 00:05:00,980
!باروك وركس

62
00:05:02,950 --> 00:05:07,250
عرفتُ أنّه يتمّ التّلاعب بالشّعب
.على يد هذه المجموعة

63
00:05:07,550 --> 00:05:11,690
لكنّ أيّ معلومات أخرى عنها سرّيّة
.للغاية، ولا يسعني فعل أيّ شيء

64
00:05:12,260 --> 00:05:13,860
،وحينها طلبتُ من إيغارام

65
00:05:13,860 --> 00:05:17,160
الّذي تدخّل في شؤوني
.منذ طفولتي بأن يساعدني

66
00:05:17,460 --> 00:05:18,630
العمّ صاحب الشّعر الأنبوبيّ؟

67
00:05:18,800 --> 00:05:20,800
.أنبوبيّ؟ صحيح

68
00:05:22,240 --> 00:05:25,570
سألته هل توجد طريقة ما
.للتّسلّل إلى باروك وركس

69
00:05:25,570 --> 00:05:30,080
لأنّ ذلك سيسمح لنا برؤية من
.صاحب القرار وما هي أهدافه

70
00:05:30,810 --> 00:05:33,280
.أنت أميرة جريئة جدًّا

71
00:05:33,480 --> 00:05:36,820
وبعدها؟ هل عرفت ما هدفه؟

72
00:05:38,050 --> 00:05:40,350
".تأسيس الأمّة المثاليّة"

73
00:05:41,490 --> 00:05:43,820
.هذا ما قاله إيغارام-سان على أيّ حال

74
00:05:44,120 --> 00:05:46,260
...هل يعني ذلك

75
00:05:46,260 --> 00:05:47,090
.نعم

76
00:05:47,930 --> 00:05:50,600
قال الزّعيم أنّ الهدف
،هو بناء أمّة مثاليّة

77
00:05:51,330 --> 00:05:53,170
!لكنّها مجرّد كذبة كبيرة

78
00:05:53,170 --> 00:05:56,770
الهدف الحقيقيّ هو الاستيلاء
!على مملكة ألاباستا

79
00:05:57,870 --> 00:06:01,710
عليّ العودة بسرعة لإخبار الجميع
!بالحقيقة وإيقاف القتال

80
00:06:01,840 --> 00:06:05,110
...إن لم أفعل أيّ شيء
...إن لم أفعل أيّ شيء

81
00:06:08,510 --> 00:06:09,880
.فهمت الآن

82
00:06:10,520 --> 00:06:14,350
.هذا ما في الأمر إذًا
.اتّضح كلّ شيء الآن

83
00:06:14,850 --> 00:06:18,460
لن تكون هنالك أموال
في حالة وجود حرب أهليّة؟

84
00:06:20,390 --> 00:06:21,160
.مهلاً

85
00:06:21,860 --> 00:06:24,200
من صاحب القرار الّتي تحدّثتِ عنه؟

86
00:06:24,200 --> 00:06:26,160
!تـ-تقصد هويّة الزّعيم؟

87
00:06:26,430 --> 00:06:28,200
!لا يجب عليك أن تسأل عنه

88
00:06:28,200 --> 00:06:29,070
تعرفين من يكون، صحيح؟

89
00:06:29,430 --> 00:06:31,300
!لا تسألني! إلاّ ذلك أرجوك

90
00:06:31,300 --> 00:06:34,310
!سأضع حياتكم في خطر أيضًا

91
00:06:34,610 --> 00:06:35,910
!أعتقد أنّني لا أريد أن أعرف

92
00:06:35,910 --> 00:06:38,640
فهؤلاء أشخاص يحاولون
!الاستيلاء على بلاد بأكملها

93
00:06:38,640 --> 00:06:41,110
!واضح أنّهم خطيرون جدًّا

94
00:06:41,110 --> 00:06:42,550
!نعم! هذا صحيح

95
00:06:42,550 --> 00:06:45,050
،رغم قوّتكم الكبيرة
فإنّ لا فرصة أمامكم

96
00:06:45,050 --> 00:06:47,150
،في مواجهة أحد الشّيتشيبوكاي الملكيّين

97
00:06:47,420 --> 00:06:48,620
!كروكودايل

98
00:06:51,660 --> 00:06:52,490
من يكون هذا؟

99
00:06:55,160 --> 00:06:56,360
.لقد كشفتِ عنه توًّا

100
00:07:04,270 --> 00:07:06,570
!ما قصّة الطّائر وثعلب الماء؟

101
00:07:04,770 --> 00:07:07,740
!أنا آسفة! أنا آسفة

102
00:07:06,570 --> 00:07:07,970
!هل سيخبران أحدًا ما؟

103
00:07:07,970 --> 00:07:10,340
!قالت أنّه شيتشيبوكاي

104
00:07:10,340 --> 00:07:11,440
!ليس سيّئًا

105
00:07:11,440 --> 00:07:13,940
!أ-أنا جدّ آسفة! كانت زلّة لسان

106
00:07:13,940 --> 00:07:15,380
!وكانّ ذلك سيصلح أيّ شيء

107
00:07:15,380 --> 00:07:18,410
لماذا كان عليك توريطنا
!في هذا معك؟

108
00:07:20,280 --> 00:07:24,020
مطاردة شيتشيبوكاي لنا ونحن لم
ندخل الغراند لاين إلاّ حديثًا

109
00:07:24,020 --> 00:07:25,390
!أمر لا يمكن تحمّله

110
00:07:25,750 --> 00:07:27,720
!نحن محظوظان لأنّنا سنراه قريبًا

111
00:07:27,720 --> 00:07:28,720
!أتساءل كيف يبدو

112
00:07:28,720 --> 00:07:30,090
!اخرسا

113
00:07:30,560 --> 00:07:32,630
،كانت معرفتي بكما قصيرة
!لكن شكرًا على كلّ شيء

114
00:07:32,630 --> 00:07:33,730
إلى أين تذهبين؟

115
00:07:33,730 --> 00:07:36,030
!لا يعرفون بعد كيف نبدو
!لذلك سأهرب

116
00:07:40,540 --> 00:07:42,500
!مذهل! هذا جيّد جدًّا

117
00:07:43,340 --> 00:07:45,870
أعتقد أنّ هذا يعني
!أنّ لا مهرب لنا الآن؟

118
00:07:45,870 --> 00:07:47,080
!أنا آسفة

119
00:07:47,080 --> 00:07:48,440
!إنّها مضحكة

120
00:07:48,440 --> 00:07:50,650
إلى أين كانت تنوي الهرب من الأساس؟

121
00:07:51,580 --> 00:07:57,590
أعتقد أنّ ذلك يعني أنّ ثلاثتنا
.على قائمة باروك وركس الآن

122
00:07:58,250 --> 00:07:59,820
!هذا حماسيّ لسبب ما

123
00:08:01,390 --> 00:08:04,490
لـ-لديّ 500 ألف بيري
...كنتُ أدّخرها

124
00:08:05,290 --> 00:08:07,230
!لا تخشوا شيئًا

125
00:08:08,400 --> 00:08:09,100
...لا بأ

126
00:08:10,330 --> 00:08:12,170
...ما-ما-ما

127
00:08:12,170 --> 00:08:14,200
!لا بأس! لديّ خطّة

128
00:08:14,500 --> 00:08:16,770
!إيغارام! ما هذه الملابس؟

129
00:08:17,370 --> 00:08:19,610
!تبدو مضحكًا بهذه الملابس أيّها العمّ

130
00:08:20,140 --> 00:08:21,980
...ويتوالى الأغبياء

131
00:08:22,240 --> 00:08:25,180
.فيفي-ساما. استمعي لي جيّدًا رجاءً

132
00:08:25,550 --> 00:08:27,950
بمجرّد أن تعلم شبكة استخبارات
،باروك وركس بأمر ما

133
00:08:27,950 --> 00:08:30,350
.قد يأتي المطاردون خلفك في الحال

134
00:08:30,350 --> 00:08:33,090
وفوق ذلك، إن كنتِ
...تعرفين أسرار الزّعيم

135
00:08:33,090 --> 00:08:34,220
.تعرفين ما قد يحدث

136
00:08:35,060 --> 00:08:37,820
.قرابة الألف شخص سيسعون خلفي

137
00:08:38,730 --> 00:08:42,130
،وبالتالي، سأتظاهر أنّني أنت كما ترين

138
00:08:42,730 --> 00:08:48,400
.وسأبحر نحو ألاباستا رفقة ثلاث دمى

139
00:08:48,400 --> 00:08:49,600
أيفترض أنّ هذه نحن؟

140
00:08:49,900 --> 00:08:50,770
طُعم؟

141
00:08:51,170 --> 00:08:53,770
،وبينما المطاردون مشغولون بي

142
00:08:53,770 --> 00:08:56,980
ستتّجهون جميعًا نحو ألاباستا
.عبر طرق عاديّة

143
00:08:56,980 --> 00:08:58,340
!مهلاً

144
00:08:58,610 --> 00:09:00,910
!من قال أنّنا سنأخذ الأميرة إلى هناك؟

145
00:09:02,010 --> 00:09:04,480
!ما زلنا لم نتّفق على أيّ شيء بعد

146
00:09:04,950 --> 00:09:07,720
نأخذ الأميرة إلى هناك؟
ماذا تقصدين؟

147
00:09:07,720 --> 00:09:09,420
ألم تسمع بعد؟

148
00:09:10,060 --> 00:09:13,160
.يريد هذا العمّ أن نأخذها لوطنها

149
00:09:13,160 --> 00:09:16,130
!هذا كلّ ما في الأمر؟ لا أمانع

150
00:09:16,500 --> 00:09:18,830
!سيسعى كروكودايل خلفنا

151
00:09:19,300 --> 00:09:22,000
هل كروكودايل قويّ لهذه الدّرجة؟

152
00:09:22,000 --> 00:09:24,440
.إنّ واحد من الشيتشيبوكاي السّبعة

153
00:09:24,440 --> 00:09:28,440
،إنّه قرصان معترف به قانونيًّا
.وبالتّالي لا مكافأة على رأسه

154
00:09:28,840 --> 00:09:32,940
ولكن، المكافأة الّتي كانت على رأسه
.من قبل هي 80 مليون بيري

155
00:09:33,980 --> 00:09:37,850
ثمانون مليون؟! إنّها بأربعة
!أضعاف مكافأة أرلونغ! ارفض

156
00:09:38,620 --> 00:09:40,320
هل ستقوم بذلك؟

157
00:09:40,320 --> 00:09:42,890
!نعم! يبدو الأمر ممتعًا

158
00:09:43,490 --> 00:09:45,290
!أنا ممتنّ لك

159
00:09:46,690 --> 00:09:51,000
.ما-ما-ما... حسنًا إذًا
.سأودّعكم أنا فيفي الآن

160
00:09:51,330 --> 00:09:52,900
!هذا تقليد مثاليّ أيّها العمّ

161
00:09:52,900 --> 00:09:54,300
!تقليد من؟

162
00:09:55,800 --> 00:09:59,170
.حسنًا أيتها الأميرة
.أعطني البوصلة الدّائمة

163
00:10:02,510 --> 00:10:03,870
البوصلة الدّائمة؟

164
00:10:04,570 --> 00:10:06,010
ألم تسمعي بها من قبل؟

165
00:10:06,010 --> 00:10:09,380
أفترض أنّه يمكن القول أنّها نسخة
.دائمة عن البوصلة المسجِّلة

166
00:10:09,380 --> 00:10:13,280
بينما تقود البوصلة المسجِّلة
،السّفن إلى الجزيرة التّالية

167
00:10:13,280 --> 00:10:16,750
فإنّ البوصلة الدّائمة لن تنسى أبدًا
المجال المغناطيسيّ للجزيرة

168
00:10:16,750 --> 00:10:17,850
.الّذي سُجّل فيها

169
00:10:18,120 --> 00:10:21,290
.أي أنّها ستشير دائمًا إلى تلك الجزيرة وحدها

170
00:10:21,760 --> 00:10:24,890
.وهذه مسجَّلة على مجال ألاباستا

171
00:10:25,760 --> 00:10:27,960
ستستعمل هذه للذّهاب إلى ألاباستا؟

172
00:10:30,130 --> 00:10:34,870
فيفي-ساما. خذي الطّريق غير المباشر
.من جزيرة لأخرى نحو ألاباستا

173
00:10:34,870 --> 00:10:37,040
،لم آخذ ذلك الطّريق بنفسي

174
00:10:37,040 --> 00:10:39,810
لكن يفترض أنّها جزيرتان
.أو ثلاث إن تبعتم البوصلة

175
00:10:42,810 --> 00:10:45,950
.اعتنِ بالأميرة جيّدًا لو سمحت

176
00:10:45,950 --> 00:10:46,550
!أكيد

177
00:10:46,550 --> 00:10:47,520
...إيغارام

178
00:10:50,990 --> 00:10:53,690
.أتوقّع أنّها ستكون رحلة قاسية

179
00:10:53,960 --> 00:10:55,560
.كوني حذرة في طريقك

180
00:10:55,560 --> 00:10:56,320
!—إيغا

181
00:11:04,130 --> 00:11:05,200
!وأنت أيضًا

182
00:11:09,670 --> 00:11:12,210
.فلنتقابل بأمان في وطننا

183
00:11:16,810 --> 00:11:19,850
!عليك إنقاذ المملكة بيديك أنت

184
00:11:20,750 --> 00:11:22,250
.ها قد ذهب

185
00:11:22,580 --> 00:11:24,820
!كان رجلاً مضحكًا حتّى النّهاية

186
00:11:25,120 --> 00:11:28,220
.يمكن الاعتماد عليه بالفعل

187
00:11:54,580 --> 00:11:55,650
!مستحيل

188
00:12:01,220 --> 00:12:04,520
!هذا مستحيل! إنّهم خلفنا سلفًا؟

189
00:12:14,430 --> 00:12:15,570
!كان رجلاً عظيمًا

190
00:12:15,570 --> 00:12:16,440
!نامي! ما حالة التّسجيل؟

191
00:12:16,440 --> 00:12:18,800
!لا بأس! لقد سُجّل المجال

192
00:12:19,240 --> 00:12:21,140
!أحضروها معنا! سوف نبحر الآن

193
00:12:21,340 --> 00:12:22,610
!فيفي! فيفي

194
00:12:22,940 --> 00:12:26,040
،بسرعة! إن وجدونا
!فسيذهب كلّ هذا هباءً

195
00:12:29,610 --> 00:12:31,620
!لا تقلقي! سنوصلك إلى هناك

196
00:12:33,020 --> 00:12:35,620
...أعلم أنّ ذلك لا يبدو عليهم

197
00:12:34,620 --> 00:12:36,790
!لوفي! اذهب وأيقظ الآخريْن

198
00:12:35,620 --> 00:12:37,720
!لكنّهم أنقذوا الأزرق الشّرقيّ

199
00:12:37,220 --> 00:12:38,190
!سأذهب للسّفينة

200
00:12:37,720 --> 00:12:39,260
!هم الأربعة فقط

201
00:12:38,190 --> 00:12:39,260
!دع الأمر لي

202
00:12:39,820 --> 00:12:43,660
!أقلتِ باروك وركس؟! أقلتِ كروكودايل؟

203
00:12:45,330 --> 00:12:47,430
!إنّ الشّيتشيبوكاي لا شيء على الإطلاق

204
00:13:10,290 --> 00:13:11,820
!لنذهب

205
00:13:14,560 --> 00:13:17,160
!ما الّذي...؟! هذا مؤلم؟
!ماذا يحدث؟

206
00:13:17,160 --> 00:13:18,400
!ما الّذي تفعله يا لوفي؟! تمهّل

207
00:13:18,600 --> 00:13:20,100
!سيقتلع أنفي

208
00:13:20,100 --> 00:13:23,230
!اتركني، اللّعنة! ما الّذي يحدث؟

209
00:13:24,000 --> 00:13:25,170
!بسرعة يا فيفي

210
00:13:25,170 --> 00:13:26,140
!نـ-نعم

211
00:13:27,070 --> 00:13:28,240
!لا أجد كارو

212
00:13:34,780 --> 00:13:38,150
...طُعم. يا للحُمق

213
00:13:40,350 --> 00:13:42,080
!لقد أحضرتُهما

214
00:13:42,080 --> 00:13:43,890
!اصعدوا! نحن جاهزون للمغادرة

215
00:13:44,120 --> 00:13:48,490
!ماذا؟ إنّهما ما زالا نائمين

216
00:13:48,490 --> 00:13:50,460
!لا وقت للبحث عنه

217
00:13:50,460 --> 00:13:52,560
!لكن لا أستطيع تركه هنا ببساطة

218
00:13:52,560 --> 00:13:53,360
...ومع ذلك

219
00:13:53,360 --> 00:13:54,630
!ما المشكلة؟

220
00:13:54,630 --> 00:13:56,430
!تقول أنّ طائر البطّ خاصّتها مفقود

221
00:13:57,200 --> 00:13:59,870
!إنّه لا يأتي عندما نصفّر له

222
00:14:00,900 --> 00:14:01,800
أهذا هو؟

223
00:14:02,340 --> 00:14:03,640
!أنت هناك؟

224
00:14:03,640 --> 00:14:04,910
.وصل إلى هنا قبلي حتّى

225
00:14:05,170 --> 00:14:07,310
!ثمّة تيّار رافد أعلى النّهر

226
00:14:07,310 --> 00:14:09,180
بإمكاننا استعماله للخروج
!للبحر أسرع قليلاً

227
00:14:09,340 --> 00:14:11,710
!حسنًا! لننطلق

228
00:14:12,910 --> 00:14:13,780
.اسمعي

229
00:14:15,480 --> 00:14:16,520
...سيّد بوشيدو

230
00:14:16,520 --> 00:14:19,250
كم من الأشخاص سيطاردوننا؟

231
00:14:19,850 --> 00:14:21,120
.لا أدري

232
00:14:21,590 --> 00:14:24,990
،ثمّة حوالي ألفَي عضو في باروك وركس

233
00:14:24,990 --> 00:14:28,730
وسمعتُ أنّه ثمّة عدّة قواعد أشبه
.بالبلدات كهذه على مقربة

234
00:14:29,300 --> 00:14:31,370
!قد يرسلون ألف شخص بالفعل؟

235
00:14:31,370 --> 00:14:33,000
!ما-ماذا؟

236
00:14:33,000 --> 00:14:34,840
!مهلاً! السّفينة تُغادر

237
00:14:34,840 --> 00:14:36,470
.استيقظتما أخيرًا

238
00:14:36,470 --> 00:14:38,670
!مهلاً! لنبقَ ليلة أخرى فقط

239
00:14:38,670 --> 00:14:39,470
!نعم

240
00:14:39,470 --> 00:14:41,680
!هذه البلدة ممتعة! والفتيات ظريفات

241
00:14:41,680 --> 00:14:44,080
لا يمكننا الجزم متى سنحظى
!بمثل هذا المرح ثانية

242
00:14:44,080 --> 00:14:46,010
!لنتروَّ قليلاً! نحن قراصنة

243
00:14:46,010 --> 00:14:47,820
!كما أنّ الصّبح لم يحلّ بعد

244
00:14:47,820 --> 00:14:50,280
...يا لجرأتهما. إنّهما لا يدريان شيئًا حتّى

245
00:14:51,650 --> 00:14:53,690
!اسمعي! اشرحي الأمر لهما

246
00:14:53,690 --> 00:14:54,990
!نعم! فعلتُ ذلك توًّا

247
00:14:54,990 --> 00:14:56,090
...كان ذلك سريعًا

248
00:14:56,590 --> 00:14:58,830
.لم أذكر الأجزاء المعقّدة

249
00:15:00,530 --> 00:15:02,400
سنكون قادرين على مغادرة
...الجزيرة قريبًا

250
00:15:02,400 --> 00:15:04,730
!مذهل! ثمّة ضباب الآن

251
00:15:04,730 --> 00:15:06,370
...الصّباح وشيك

252
00:15:08,600 --> 00:15:10,770
من الجيّد أنّنا استطعنا
!الهرب من مطاردينا

253
00:15:10,770 --> 00:15:12,110
!هذا أكيد

254
00:15:12,840 --> 00:15:16,040
علينا أن نكون حذرين لكي
.لا نصدم السّفينة بالصّخور

255
00:15:16,040 --> 00:15:17,710
!دعوا الأمر لي

256
00:15:20,310 --> 00:15:21,750
مهلاً. أكان ذلك أنت يا لوفي؟

257
00:15:21,750 --> 00:15:22,550
.لا

258
00:15:25,150 --> 00:15:26,620
.إنّها سفينة جيّدة

259
00:15:30,990 --> 00:15:31,890
!من أنت؟

260
00:15:31,890 --> 00:15:34,330
!...أ-أنت هي

261
00:15:37,760 --> 00:15:42,570
قابلتُ السّيّد 8 قبل قليل
.يا آنسة وينزداي

262
00:15:43,400 --> 00:15:45,170
!قتلتِ إيغارام

263
00:15:45,400 --> 00:15:46,810
!من يهتمّ لذلك؟

264
00:15:47,040 --> 00:15:50,440
ما الّذي تفعلينه على هذه
!السّفينة؟! ومن تكونين؟

265
00:15:50,440 --> 00:15:53,010
...ما الّذي تفعلينه هنا

266
00:15:53,010 --> 00:15:54,650
!يا آنسة أول سانداي؟

267
00:15:57,480 --> 00:16:01,490
!آنسة أول سانداي؟
!ما رقم شريكها العميل؟

268
00:16:01,790 --> 00:16:05,320
!إنّها شريكة السّيّد 0... الزّعيم

269
00:16:05,320 --> 00:16:07,290
!الزّ— كروكودايل؟

270
00:16:07,530 --> 00:16:08,630
أهي شرّيرة؟

271
00:16:08,660 --> 00:16:12,230
.كانت الوحيدة الّتي تعرف هويّة الزّعيم

272
00:16:12,400 --> 00:16:16,530
!عرفنا من يكون عن طريق ملاحقتها

273
00:16:16,530 --> 00:16:19,940
.بشكل أدقّ... سمحتُ لكم بملاحقتي

274
00:16:19,940 --> 00:16:21,510
!إنّها طيّبة إذًا

275
00:16:21,510 --> 00:16:23,310
!أعلم ذلك

276
00:16:23,310 --> 00:16:26,610
أنتِ أيضًا من أخبره
أنّنا اكتشفنا هويّته، صحيح؟

277
00:16:26,980 --> 00:16:27,740
.صحيح

278
00:16:27,740 --> 00:16:29,580
!إنّها شرّيرة بالفعل

279
00:16:29,580 --> 00:16:31,420
!اهدأ أنت

280
00:16:31,420 --> 00:16:34,220
!ما الّذي تحاولين فعله بالضّبط؟

281
00:16:35,220 --> 00:16:36,520
.سؤال وجيه

282
00:16:37,520 --> 00:16:41,830
كنتم جميعًا عازمين وجادّين
.ولم يسعني إلاّ مساعدتكم

283
00:16:42,430 --> 00:16:45,430
إنّ فكرة محاولة أميرة بذل
قصارى جهدها لإنقاذ مملكتها

284
00:16:45,430 --> 00:16:47,930
بينما تجعل من نفسها
...عدوّة لباروك وركس

285
00:16:48,160 --> 00:16:50,500
...كانت سخيفة للغاية كما تعلمين

286
00:16:51,930 --> 00:16:54,640
!لا تسخري منّي

287
00:16:58,270 --> 00:17:02,650
!يا سانجي! هل تدرك ما الّذي تفعله؟

288
00:17:02,650 --> 00:17:04,410
.لا، ليس تمامًا

289
00:17:04,810 --> 00:17:07,580
شعرتُ فقط أنّ عزيزتي
...الآنسة وينزداي في خطر

290
00:17:08,620 --> 00:17:12,690
كنتُ لأقدّر لكما إن لم تصوّبا
.أشياء خطيرة كهذه ناحيتي

291
00:17:14,420 --> 00:17:15,020
!...لا يُعقل

292
00:17:16,060 --> 00:17:17,260
—فاكهة

293
00:17:18,390 --> 00:17:19,760
!فاكهة شيطان؟

294
00:17:19,760 --> 00:17:22,130
!ما هي؟! ما هي قدراتها؟

295
00:17:22,660 --> 00:17:24,130
...هذا مؤلم

296
00:17:24,870 --> 00:17:27,470
،بعد إعادة النّظر إليك
!اتّضح لي أنّك غاية في الجمال

297
00:17:28,200 --> 00:17:34,610
.مهلاً، لا تستعجل
.لم أُمنح أيّة أوامر بعد

298
00:17:35,040 --> 00:17:36,780
.لا سبب يدفعني للقتال

299
00:17:38,980 --> 00:17:41,980
إذًا أنت هو قائد قراصنة قبّعة
...القشّ الّذي سمعتُ عنه

300
00:17:42,520 --> 00:17:44,690
!مونكي د. لوفي

301
00:17:44,950 --> 00:17:48,420
!أنتِ! أعيدي لي قبّعتي
!أتحاولين افتعال قتال؟

302
00:17:48,420 --> 00:17:51,660
!أراك كعدوّ! غادري في الحال

303
00:17:51,660 --> 00:17:52,730
...يا حظّكم السّيّئ

304
00:17:53,190 --> 00:17:57,400
أنتم الّذين اصطحبوا أميرة تسعى
...باروك وركس لقتلها

305
00:17:58,030 --> 00:18:01,500
...وأميرة يحميها حفنة من القراصنة

306
00:18:02,100 --> 00:18:08,080
لكن الأكثر شؤمًا هو المسار
.الّذي تشير له البوصلة المسجِّلة

307
00:18:08,910 --> 00:18:10,510
...اسم الجزيرة هو الحديقة الصّغيرة

308
00:18:11,650 --> 00:18:12,950
!ليتل غاردن

309
00:18:14,450 --> 00:18:17,220
،لا نحتاج حتّى لفعل أيّ شيء

310
00:18:17,220 --> 00:18:20,090
لأنّه ستتمّ إبادتكم قبل حتّى
.أن تصلوا إلى ألاباستا

311
00:18:20,090 --> 00:18:21,620
!أنت مخطئة! أعيدي لي قبّعتي

312
00:18:21,620 --> 00:18:23,490
!في أحلامك أيّتها الغبيّة

313
00:18:23,490 --> 00:18:24,960
هل أنت طفل؟

314
00:18:25,590 --> 00:18:30,100
ألا تعتقدون أنّ السّماح لأنفسكم
بالتّعرّض للإبادة حماقة نوعًا ما؟

315
00:18:32,500 --> 00:18:33,870
بوصلة دائمة؟

316
00:18:34,470 --> 00:18:37,840
.بإمكانكم تخطّي ليتل غاردن باستعمالها

317
00:18:38,170 --> 00:18:42,270
.إنّها تشير لجزيرة قبل ألاباستا مباشرة

318
00:18:42,270 --> 00:18:43,780
.جزيرة اللاّشيء، نانيموناي

319
00:18:44,280 --> 00:18:47,750
لا يعرف أيّ أحد من رجالنا بذلك
.المسار، لذلك لن يطاردكم أحد

320
00:18:50,380 --> 00:18:53,150
ماذا؟ إنّها شخص طيّب؟

321
00:18:53,150 --> 00:18:54,650
!لماذا تعطيننا هذه؟

322
00:18:54,650 --> 00:18:56,360
إنّه فخّ، صحيح؟

323
00:18:57,690 --> 00:18:59,120
أتظنّ ذلك؟

324
00:18:59,960 --> 00:19:04,030
ماذا أفعل؟ لا أريد قبول
.هذا من شخص مثلها

325
00:19:04,530 --> 00:19:07,430
لكن بعد أن سمحوا لي
،بالصّعود على سفينتهم

326
00:19:07,430 --> 00:19:09,430
فأخذ المسار الأكثر أمانًا
...هو الأفضل

327
00:19:09,430 --> 00:19:12,370
!من يهتمّ لذلك؟

328
00:19:16,940 --> 00:19:18,940
!هل أنت غبيّ؟

329
00:19:18,940 --> 00:19:22,410
لقد تكبّدت عناء إخبارنا
!بالطّريق الأسهل

330
00:19:22,410 --> 00:19:25,220
!ماذا إن كانت شخصًا طيّبًا بالفعل؟

331
00:19:27,050 --> 00:19:29,650
!لستِ من يحدّد مسار هذه السّفينة

332
00:19:34,690 --> 00:19:36,830
.فهمت. هذا مؤسف

333
00:19:36,830 --> 00:19:37,730
!يكفي

334
00:19:37,730 --> 00:19:40,760
لقد فجّرت سفينة العمّ
!ذو شعر الأنابيب، لذا أنا أكرهها

335
00:19:41,770 --> 00:19:45,070
.أنا لا أكره الأشخاص الجريئين

336
00:19:45,400 --> 00:19:46,740
...إن نجوتم

337
00:19:47,200 --> 00:19:48,710
.فسنلتقي ثانية

338
00:19:48,910 --> 00:19:49,670
!كلاّ

339
00:19:52,980 --> 00:19:54,280
!لنذهب يا بانتشي

340
00:19:58,310 --> 00:20:00,150
!ما-ما ذلك الشّيء؟

341
00:20:00,150 --> 00:20:01,580
!لا تقل لي أنّه ملك بحر

342
00:20:01,580 --> 00:20:02,650
...لا

343
00:20:04,020 --> 00:20:06,320
!إنّها سلحفاة

344
00:20:06,320 --> 00:20:08,860
!يا لها من سلحفاة ضخمة

345
00:20:14,400 --> 00:20:19,000
لا يمكنني معرفة ما
!الّذي تفكّر به تلك المرأة

346
00:20:19,000 --> 00:20:21,100
.إذًا لا فائدة من التّفكير في الأمر

347
00:20:21,100 --> 00:20:23,640
نملك سلفًا شخصًا كذلك على
.هذه السّفينة من الأساس

348
00:20:23,810 --> 00:20:26,840
!مهلاً! اشرح ما الّذي يحدث
!لا شيء من هذا منطقيّ

349
00:20:26,840 --> 00:20:29,140
!يا آنسة وينزداي
!أيعقل أنّك انضممتِ لطاقمنا؟

350
00:20:29,140 --> 00:20:30,810
!—مهلاً! اشرحوا لي

351
00:20:30,810 --> 00:20:33,050
!ماذا؟! ثمّة نعامة على السّفينة

352
00:20:33,650 --> 00:20:35,480
!أخبروني ما الّذي يحدث؟

353
00:20:35,480 --> 00:20:36,890
أهو للأكل؟

354
00:20:37,190 --> 00:20:40,690
!اشرحوا ما الّذي يحدث

355
00:20:42,060 --> 00:20:43,360
.فهمت

356
00:20:44,590 --> 00:20:46,930
،من المؤسف أنّ كلّ ذلك فاتني

357
00:20:46,930 --> 00:20:50,030
لكن ما زالت هنالك فرصة
.ليسطع نوري أيضًا

358
00:20:50,800 --> 00:20:51,970
!لا تقلقي

359
00:20:51,970 --> 00:20:55,900
بما أنّ هذا الأمير النّائم قد استيقظ
!الآن، فسلامتك مضمونة

360
00:20:57,170 --> 00:20:58,640
!من الجيّد أنّني كنت نائمًا

361
00:20:58,940 --> 00:21:00,740
نامي-سان. هل تشعرين بالغيرة؟

362
00:21:00,740 --> 00:21:02,240
!إطلاقًا

363
00:21:02,240 --> 00:21:06,610
لا يوجد مانع من تواجدي
على هذه السّفينة بالفعل؟

364
00:21:07,110 --> 00:21:09,420
...سأسبّب لكم المشاكل فحسب

365
00:21:09,420 --> 00:21:12,550
!ما الّذي تقولينه؟
!نعرف من أنتِ الآن

366
00:21:12,550 --> 00:21:15,590
،إن كنتِ لا تريدين المشاكل لنا
!كان عليك فعل ذلك من البداية

367
00:21:16,060 --> 00:21:17,120
.أنا آسفة

368
00:21:17,320 --> 00:21:18,930
