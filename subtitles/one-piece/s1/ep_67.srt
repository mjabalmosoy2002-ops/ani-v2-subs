1
00:00:28,040 --> 00:00:29,570
...إرادة موروثة

2
00:00:29,570 --> 00:00:31,810
...تعاقب الأزمنة... أحلام النّاس

3
00:00:32,480 --> 00:00:35,310
.لا رادع لهذه الأشياء

4
00:00:35,310 --> 00:00:38,410
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:38,410 --> 00:00:41,050
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:49,660 --> 00:00:56,030
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:56,030 --> 00:01:01,540
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:01:01,540 --> 00:01:07,540
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:01:07,540 --> 00:01:11,050
أشعر بـ"الجمال" في كلّ مكان

10
00:01:11,050 --> 00:01:14,350
أنا متمسّك بكم بشدّة بالفعل

11
00:01:14,350 --> 00:01:20,990
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:20,990 --> 00:01:24,290
إلى أن أحصل عليه بكلّ إثارة

13
00:01:24,290 --> 00:01:31,300
!آمنوا ببلاد العجائب

14
00:01:33,200 --> 00:01:39,410
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:39,410 --> 00:01:45,410
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:45,410 --> 00:01:48,520
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:48,520 --> 00:01:51,850
،بل أريدها حياة عاديّة لا غير

18
00:01:51,850 --> 00:01:55,090
فاركضوا نحو النّعيم بدل ذلك

19
00:01:55,290 --> 00:02:05,030
!آمنوا ببلاد العجائب

20
00:02:25,520 --> 00:02:29,660
!توصيل الأميرة فيفي"
"!يشدّ قراصنة لوفي الرّحال

21
00:02:32,990 --> 00:02:34,460
!كم هما مزعجان

22
00:02:34,660 --> 00:02:36,260
!ما مشكلتهما؟

23
00:02:40,700 --> 00:02:43,540
!هذا مستحيل! يا لها من قوّة

24
00:02:44,270 --> 00:02:46,100
!لا أصدّق عينيّ

25
00:02:46,470 --> 00:02:48,870
!حسنًا إذًا. لننهِ هذا الأمر

26
00:02:49,910 --> 00:02:51,040
!أجل

27
00:03:19,540 --> 00:03:21,870
!توقّفا

28
00:03:27,810 --> 00:03:30,910
!ما الّذي تفعلانه؟

29
00:03:31,150 --> 00:03:33,820
لحسن حظّكما أنّكما استطعتما
!إبقاء الفتاة آمنة

30
00:03:33,820 --> 00:03:36,920
!كدتما تتركان مليار بيري يفلت من أيدينا

31
00:03:38,220 --> 00:03:39,460
!مفهوم؟

32
00:03:40,360 --> 00:03:43,430
عمّ تتحدّثون؟

33
00:03:43,890 --> 00:03:46,200
لماذا أنقذتموني؟

34
00:03:46,800 --> 00:03:50,100
!صحيح! علينا الحديث بشأن ذلك

35
00:03:50,100 --> 00:03:52,900
ما في الأمر هو... هلاّ أبرمتِ عقدًا معي؟

36
00:03:53,100 --> 00:03:54,370
عقد؟

37
00:03:54,970 --> 00:03:56,540
!كفاكما قتالاً

38
00:04:04,610 --> 00:04:07,680
!كان عليك قول ذلك فحسب يا زورو

39
00:04:07,680 --> 00:04:10,150
ظننتُ أنّك قمت بتقطيعهم فحسب

40
00:04:10,150 --> 00:04:12,860
لأنّهم لم يعدّوا أيّ طعام
!تحبّه أو ما شابه

41
00:04:12,860 --> 00:04:14,990
!لا تقارنّي بك

42
00:04:16,020 --> 00:04:17,460
!لا عليك! انس الأمر

43
00:04:17,460 --> 00:04:18,530
!اخرسا

44
00:04:19,260 --> 00:04:21,360
!هذا كلّ ما هنالك

45
00:04:21,860 --> 00:04:25,100
.وكتعويض، ستعطينا مليار بيري

46
00:04:26,000 --> 00:04:28,070
.رأيتِ كم هما قويّان

47
00:04:28,970 --> 00:04:31,270
.إنّه عرض جيّد جدًّا في رأيي

48
00:04:31,510 --> 00:04:32,240
!لا أستطيع

49
00:04:33,340 --> 00:04:35,740
.أقدّر أنّكم أنقذتموني. شكرًا لكم

50
00:04:35,740 --> 00:04:37,750
!لماذا لا تستطيعين؟! أنت أميرة

51
00:04:37,750 --> 00:04:39,650
...مليار بيري ليست بالشّيء الكثير

52
00:04:40,580 --> 00:04:43,250
هل تعرفين مملكة ألاباستا؟

53
00:04:43,250 --> 00:04:44,020
.لا

54
00:04:48,790 --> 00:04:52,560
إنّها مملكة مسالمة معروفة
.كحضارة وأمّة عظيمة

55
00:04:52,890 --> 00:04:54,060
.في الماضي على الأقلّ

56
00:04:54,760 --> 00:04:57,160
.في الماضي؟ ألم تعد كذلك

57
00:04:57,400 --> 00:04:59,100
.إنّها وسط حرب أهليّة

58
00:04:59,930 --> 00:05:03,040
.بدأت بوادر ثورة تظهر منذ سنوات الآن

59
00:05:04,000 --> 00:05:07,570
ثار الشّعب ووقعت المملكة
...في فوضى عارمة

60
00:05:10,110 --> 00:05:13,510
...وذات يوم، سمعتُ اسم منظّمة ما

61
00:05:13,910 --> 00:05:14,980
!باروك وركس

62
00:05:16,950 --> 00:05:21,250
عرفتُ أنّه يتمّ التّلاعب بالشّعب
.على يد هذه المجموعة

63
00:05:21,550 --> 00:05:25,690
لكنّ أيّ معلومات أخرى عنها سرّيّة
.للغاية، ولا يسعني فعل أيّ شيء

64
00:05:26,260 --> 00:05:27,860
،وحينها طلبتُ من إيغارام

65
00:05:27,860 --> 00:05:31,160
الّذي تدخّل في شؤوني
.منذ طفولتي بأن يساعدني

66
00:05:31,460 --> 00:05:32,630
العمّ صاحب الشّعر الأنبوبيّ؟

67
00:05:32,800 --> 00:05:34,800
.أنبوبيّ؟ صحيح

68
00:05:36,240 --> 00:05:39,570
سألته هل توجد طريقة ما
.للتّسلّل إلى باروك وركس

69
00:05:39,570 --> 00:05:44,080
لأنّ ذلك سيسمح لنا برؤية من
.صاحب القرار وما هي أهدافه

70
00:05:44,810 --> 00:05:47,280
.أنت أميرة جريئة جدًّا

71
00:05:47,480 --> 00:05:50,820
وبعدها؟ هل عرفت ما هدفه؟

72
00:05:52,050 --> 00:05:54,350
".تأسيس الأمّة المثاليّة"

73
00:05:55,490 --> 00:05:57,820
.هذا ما قاله إيغارام-سان على أيّ حال

74
00:05:58,120 --> 00:06:00,260
...هل يعني ذلك

75
00:06:00,260 --> 00:06:01,090
.نعم

76
00:06:01,930 --> 00:06:04,600
قال الزّعيم أنّ الهدف
،هو بناء أمّة مثاليّة

77
00:06:05,330 --> 00:06:07,170
!لكنّها مجرّد كذبة كبيرة

78
00:06:07,170 --> 00:06:10,770
الهدف الحقيقيّ هو الاستيلاء
!على مملكة ألاباستا

79
00:06:11,870 --> 00:06:15,710
عليّ العودة بسرعة لإخبار الجميع
!بالحقيقة وإيقاف القتال

80
00:06:15,840 --> 00:06:19,110
...إن لم أفعل أيّ شيء
...إن لم أفعل أيّ شيء

81
00:06:22,510 --> 00:06:23,880
.فهمت الآن

82
00:06:24,520 --> 00:06:28,350
.هذا ما في الأمر إذًا
.اتّضح كلّ شيء الآن

83
00:06:28,850 --> 00:06:32,460
لن تكون هنالك أموال
في حالة وجود حرب أهليّة؟

84
00:06:34,390 --> 00:06:35,160
.مهلاً

85
00:06:35,860 --> 00:06:38,200
من صاحب القرار الّتي تحدّثتِ عنه؟

86
00:06:38,200 --> 00:06:40,160
!تـ-تقصد هويّة الزّعيم؟

87
00:06:40,430 --> 00:06:42,200
!لا يجب عليك أن تسأل عنه

88
00:06:42,200 --> 00:06:43,070
تعرفين من يكون، صحيح؟

89
00:06:43,430 --> 00:06:45,300
!لا تسألني! إلاّ ذلك أرجوك

90
00:06:45,300 --> 00:06:48,310
!سأضع حياتكم في خطر أيضًا

91
00:06:48,610 --> 00:06:49,910
!أعتقد أنّني لا أريد أن أعرف

92
00:06:49,910 --> 00:06:52,640
فهؤلاء أشخاص يحاولون
!الاستيلاء على بلاد بأكملها

93
00:06:52,640 --> 00:06:55,110
!واضح أنّهم خطيرون جدًّا

94
00:06:55,110 --> 00:06:56,550
!نعم! هذا صحيح

95
00:06:56,550 --> 00:06:59,050
،رغم قوّتكم الكبيرة
فإنّ لا فرصة أمامكم

96
00:06:59,050 --> 00:07:01,150
،في مواجهة أحد الشّيتشيبوكاي الملكيّين

97
00:07:01,420 --> 00:07:02,620
!كروكودايل

98
00:07:05,660 --> 00:07:06,490
من يكون هذا؟

99
00:07:09,160 --> 00:07:10,360
.لقد كشفتِ عنه توًّا

100
00:07:18,270 --> 00:07:20,570
!ما قصّة الطّائر وثعلب الماء؟

101
00:07:18,770 --> 00:07:21,740
!أنا آسفة! أنا آسفة

102
00:07:20,570 --> 00:07:21,970
!هل سيخبران أحدًا ما؟

103
00:07:21,970 --> 00:07:24,340
!قالت أنّه شيتشيبوكاي

104
00:07:24,340 --> 00:07:25,440
!ليس سيّئًا

105
00:07:25,440 --> 00:07:27,940
!أ-أنا جدّ آسفة! كانت زلّة لسان

106
00:07:27,940 --> 00:07:29,380
!وكانّ ذلك سيصلح أيّ شيء

107
00:07:29,380 --> 00:07:32,410
لماذا كان عليك توريطنا
!في هذا معك؟

108
00:07:34,280 --> 00:07:38,020
مطاردة شيتشيبوكاي لنا ونحن لم
ندخل الغراند لاين إلاّ حديثًا

109
00:07:38,020 --> 00:07:39,390
!أمر لا يمكن تحمّله

110
00:07:39,750 --> 00:07:41,720
!نحن محظوظان لأنّنا سنراه قريبًا

111
00:07:41,720 --> 00:07:42,720
!أتساءل كيف يبدو

112
00:07:42,720 --> 00:07:44,090
!اخرسا

113
00:07:44,560 --> 00:07:46,630
،كانت معرفتي بكما قصيرة
!لكن شكرًا على كلّ شيء

114
00:07:46,630 --> 00:07:47,730
إلى أين تذهبين؟

115
00:07:47,730 --> 00:07:50,030
!لا يعرفون بعد كيف نبدو
!لذلك سأهرب

116
00:07:54,540 --> 00:07:56,500
!مذهل! هذا جيّد جدًّا

117
00:07:57,340 --> 00:07:59,870
أعتقد أنّ هذا يعني
!أنّ لا مهرب لنا الآن؟

118
00:07:59,870 --> 00:08:01,080
!أنا آسفة

119
00:08:01,080 --> 00:08:02,440
!إنّها مضحكة

120
00:08:02,440 --> 00:08:04,650
إلى أين كانت تنوي الهرب من الأساس؟

121
00:08:05,580 --> 00:08:11,590
أعتقد أنّ ذلك يعني أنّ ثلاثتنا
.على قائمة باروك وركس الآن

122
00:08:12,250 --> 00:08:13,820
!هذا حماسيّ لسبب ما

123
00:08:15,390 --> 00:08:18,490
لـ-لديّ 500 ألف بيري
...كنتُ أدّخرها

124
00:08:19,290 --> 00:08:21,230
!لا تخشوا شيئًا

125
00:08:22,400 --> 00:08:23,100
...لا بأ

126
00:08:24,330 --> 00:08:26,170
...ما-ما-ما

127
00:08:26,170 --> 00:08:28,200
!لا بأس! لديّ خطّة

128
00:08:28,500 --> 00:08:30,770
!إيغارام! ما هذه الملابس؟

129
00:08:31,370 --> 00:08:33,610
!تبدو مضحكًا بهذه الملابس أيّها العمّ

130
00:08:34,140 --> 00:08:35,980
...ويتوالى الأغبياء

131
00:08:36,240 --> 00:08:39,180
.فيفي-ساما. استمعي لي جيّدًا رجاءً

132
00:08:39,550 --> 00:08:41,950
بمجرّد أن تعلم شبكة استخبارات
،باروك وركس بأمر ما

133
00:08:41,950 --> 00:08:44,350
.قد يأتي المطاردون خلفك في الحال

134
00:08:44,350 --> 00:08:47,090
وفوق ذلك، إن كنتِ
...تعرفين أسرار الزّعيم

135
00:08:47,090 --> 00:08:48,220
.تعرفين ما قد يحدث

136
00:08:49,060 --> 00:08:51,820
.قرابة الألف شخص سيسعون خلفي

137
00:08:52,730 --> 00:08:56,130
،وبالتالي، سأتظاهر أنّني أنت كما ترين

138
00:08:56,730 --> 00:09:02,400
.وسأبحر نحو ألاباستا رفقة ثلاث دمى

139
00:09:02,400 --> 00:09:03,600
أيفترض أنّ هذه نحن؟

140
00:09:03,900 --> 00:09:04,770
طُعم؟

141
00:09:05,170 --> 00:09:07,770
،وبينما المطاردون مشغولون بي

142
00:09:07,770 --> 00:09:10,980
ستتّجهون جميعًا نحو ألاباستا
.عبر طرق عاديّة

143
00:09:10,980 --> 00:09:12,340
!مهلاً

144
00:09:12,610 --> 00:09:14,910
!من قال أنّنا سنأخذ الأميرة إلى هناك؟

145
00:09:16,010 --> 00:09:18,480
!ما زلنا لم نتّفق على أيّ شيء بعد

146
00:09:18,950 --> 00:09:21,720
نأخذ الأميرة إلى هناك؟
ماذا تقصدين؟

147
00:09:21,720 --> 00:09:23,420
ألم تسمع بعد؟

148
00:09:24,060 --> 00:09:27,160
.يريد هذا العمّ أن نأخذها لوطنها

149
00:09:27,160 --> 00:09:30,130
!هذا كلّ ما في الأمر؟ لا أمانع

150
00:09:30,500 --> 00:09:32,830
!سيسعى كروكودايل خلفنا

151
00:09:33,300 --> 00:09:36,000
هل كروكودايل قويّ لهذه الدّرجة؟

152
00:09:36,000 --> 00:09:38,440
.إنّ واحد من الشيتشيبوكاي السّبعة

153
00:09:38,440 --> 00:09:42,440
،إنّه قرصان معترف به قانونيًّا
.وبالتّالي لا مكافأة على رأسه

154
00:09:42,840 --> 00:09:46,940
ولكن، المكافأة الّتي كانت على رأسه
.من قبل هي 80 مليون بيري

155
00:09:47,980 --> 00:09:51,850
ثمانون مليون؟! إنّها بأربعة
!أضعاف مكافأة أرلونغ! ارفض

156
00:09:52,620 --> 00:09:54,320
هل ستقوم بذلك؟

157
00:09:54,320 --> 00:09:56,890
!نعم! يبدو الأمر ممتعًا

158
00:09:57,490 --> 00:09:59,290
!أنا ممتنّ لك

159
00:10:00,690 --> 00:10:05,000
.ما-ما-ما... حسنًا إذًا
.سأودّعكم أنا فيفي الآن

160
00:10:05,330 --> 00:10:06,900
!هذا تقليد مثاليّ أيّها العمّ

161
00:10:06,900 --> 00:10:08,300
!تقليد من؟

162
00:10:09,800 --> 00:10:13,170
.حسنًا أيتها الأميرة
.أعطني البوصلة الدّائمة

163
00:10:16,510 --> 00:10:17,870
البوصلة الدّائمة؟

164
00:10:18,570 --> 00:10:20,010
ألم تسمعي بها من قبل؟

165
00:10:20,010 --> 00:10:23,380
أفترض أنّه يمكن القول أنّها نسخة
.دائمة عن البوصلة المسجِّلة

166
00:10:23,380 --> 00:10:27,280
بينما تقود البوصلة المسجِّلة
،السّفن إلى الجزيرة التّالية

167
00:10:27,280 --> 00:10:30,750
فإنّ البوصلة الدّائمة لن تنسى أبدًا
المجال المغناطيسيّ للجزيرة

168
00:10:30,750 --> 00:10:31,850
.الّذي سُجّل فيها

169
00:10:32,120 --> 00:10:35,290
.أي أنّها ستشير دائمًا إلى تلك الجزيرة وحدها

170
00:10:35,760 --> 00:10:38,890
.وهذه مسجَّلة على مجال ألاباستا

171
00:10:39,760 --> 00:10:41,960
ستستعمل هذه للذّهاب إلى ألاباستا؟

172
00:10:44,130 --> 00:10:48,870
فيفي-ساما. خذي الطّريق غير المباشر
.من جزيرة لأخرى نحو ألاباستا

173
00:10:48,870 --> 00:10:51,040
،لم آخذ ذلك الطّريق بنفسي

174
00:10:51,040 --> 00:10:53,810
لكن يفترض أنّها جزيرتان
.أو ثلاث إن تبعتم البوصلة

175
00:10:56,810 --> 00:10:59,950
.اعتنِ بالأميرة جيّدًا لو سمحت

176
00:10:59,950 --> 00:11:00,550
!أكيد

177
00:11:00,550 --> 00:11:01,520
...إيغارام

178
00:11:04,990 --> 00:11:07,690
.أتوقّع أنّها ستكون رحلة قاسية

179
00:11:07,960 --> 00:11:09,560
.كوني حذرة في طريقك

180
00:11:09,560 --> 00:11:10,320
!—إيغا

181
00:11:18,130 --> 00:11:19,200
!وأنت أيضًا

182
00:11:23,670 --> 00:11:26,210
.فلنتقابل بأمان في وطننا

183
00:11:30,810 --> 00:11:33,850
!عليك إنقاذ المملكة بيديك أنت

184
00:11:34,750 --> 00:11:36,250
.ها قد ذهب

185
00:11:36,580 --> 00:11:38,820
!كان رجلاً مضحكًا حتّى النّهاية

186
00:11:39,120 --> 00:11:42,220
.يمكن الاعتماد عليه بالفعل

187
00:12:08,580 --> 00:12:09,650
!مستحيل

188
00:12:15,220 --> 00:12:18,520
!هذا مستحيل! إنّهم خلفنا سلفًا؟

189
00:12:28,430 --> 00:12:29,570
!كان رجلاً عظيمًا

190
00:12:29,570 --> 00:12:30,440
!نامي! ما حالة التّسجيل؟

191
00:12:30,440 --> 00:12:32,800
!لا بأس! لقد سُجّل المجال

192
00:12:33,240 --> 00:12:35,140
!أحضروها معنا! سوف نبحر الآن

193
00:12:35,340 --> 00:12:36,610
!فيفي! فيفي

194
00:12:36,940 --> 00:12:40,040
،بسرعة! إن وجدونا
!فسيذهب كلّ هذا هباءً

195
00:12:43,610 --> 00:12:45,620
!لا تقلقي! سنوصلك إلى هناك

196
00:12:47,020 --> 00:12:49,620
...أعلم أنّ ذلك لا يبدو عليهم

197
00:12:48,620 --> 00:12:50,790
!لوفي! اذهب وأيقظ الآخريْن

198
00:12:49,620 --> 00:12:51,720
!لكنّهم أنقذوا الأزرق الشّرقيّ

199
00:12:51,220 --> 00:12:52,190
!سأذهب للسّفينة

200
00:12:51,720 --> 00:12:53,260
!هم الأربعة فقط

201
00:12:52,190 --> 00:12:53,260
!دع الأمر لي

202
00:12:53,820 --> 00:12:57,660
!أقلتِ باروك وركس؟! أقلتِ كروكودايل؟

203
00:12:59,330 --> 00:13:01,430
!إنّ الشّيتشيبوكاي لا شيء على الإطلاق

204
00:13:24,290 --> 00:13:25,820
!لنذهب

205
00:13:28,560 --> 00:13:31,160
!ما الّذي...؟! هذا مؤلم؟
!ماذا يحدث؟

206
00:13:31,160 --> 00:13:32,400
!ما الّذي تفعله يا لوفي؟! تمهّل

207
00:13:32,600 --> 00:13:34,100
!سيقتلع أنفي

208
00:13:34,100 --> 00:13:37,230
!اتركني، اللّعنة! ما الّذي يحدث؟

209
00:13:38,000 --> 00:13:39,170
!بسرعة يا فيفي

210
00:13:39,170 --> 00:13:40,140
!نـ-نعم

211
00:13:41,070 --> 00:13:42,240
!لا أجد كارو

212
00:13:48,780 --> 00:13:52,150
...طُعم. يا للحُمق

213
00:13:54,350 --> 00:13:56,080
!لقد أحضرتُهما

214
00:13:56,080 --> 00:13:57,890
!اصعدوا! نحن جاهزون للمغادرة

215
00:13:58,120 --> 00:14:02,490
!ماذا؟ إنّهما ما زالا نائمين

216
00:14:02,490 --> 00:14:04,460
!لا وقت للبحث عنه

217
00:14:04,460 --> 00:14:06,560
!لكن لا أستطيع تركه هنا ببساطة

218
00:14:06,560 --> 00:14:07,360
...ومع ذلك

219
00:14:07,360 --> 00:14:08,630
!ما المشكلة؟

220
00:14:08,630 --> 00:14:10,430
!تقول أنّ طائر البطّ خاصّتها مفقود

221
00:14:11,200 --> 00:14:13,870
!إنّه لا يأتي عندما نصفّر له

222
00:14:14,900 --> 00:14:15,800
أهذا هو؟

223
00:14:16,340 --> 00:14:17,640
!أنت هناك؟

224
00:14:17,640 --> 00:14:18,910
.وصل إلى هنا قبلي حتّى

225
00:14:19,170 --> 00:14:21,310
!ثمّة تيّار رافد أعلى النّهر

226
00:14:21,310 --> 00:14:23,180
بإمكاننا استعماله للخروج
!للبحر أسرع قليلاً

227
00:14:23,340 --> 00:14:25,710
!حسنًا! لننطلق

228
00:14:26,910 --> 00:14:27,780
.اسمعي

229
00:14:29,480 --> 00:14:30,520
...سيّد بوشيدو

230
00:14:30,520 --> 00:14:33,250
كم من الأشخاص سيطاردوننا؟

231
00:14:33,850 --> 00:14:35,120
.لا أدري

232
00:14:35,590 --> 00:14:38,990
،ثمّة حوالي ألفَي عضو في باروك وركس

233
00:14:38,990 --> 00:14:42,730
وسمعتُ أنّه ثمّة عدّة قواعد أشبه
.بالبلدات كهذه على مقربة

234
00:14:43,300 --> 00:14:45,370
!قد يرسلون ألف شخص بالفعل؟

235
00:14:45,370 --> 00:14:47,000
!ما-ماذا؟

236
00:14:47,000 --> 00:14:48,840
!مهلاً! السّفينة تُغادر

237
00:14:48,840 --> 00:14:50,470
.استيقظتما أخيرًا

238
00:14:50,470 --> 00:14:52,670
!مهلاً! لنبقَ ليلة أخرى فقط

239
00:14:52,670 --> 00:14:53,470
!نعم

240
00:14:53,470 --> 00:14:55,680
!هذه البلدة ممتعة! والفتيات ظريفات

241
00:14:55,680 --> 00:14:58,080
لا يمكننا الجزم متى سنحظى
!بمثل هذا المرح ثانية

242
00:14:58,080 --> 00:15:00,010
!لنتروَّ قليلاً! نحن قراصنة

243
00:15:00,010 --> 00:15:01,820
!كما أنّ الصّبح لم يحلّ بعد

244
00:15:01,820 --> 00:15:04,280
...يا لجرأتهما. إنّهما لا يدريان شيئًا حتّى

245
00:15:05,650 --> 00:15:07,690
!اسمعي! اشرحي الأمر لهما

246
00:15:07,690 --> 00:15:08,990
!نعم! فعلتُ ذلك توًّا

247
00:15:08,990 --> 00:15:10,090
...كان ذلك سريعًا

248
00:15:10,590 --> 00:15:12,830
.لم أذكر الأجزاء المعقّدة

249
00:15:14,530 --> 00:15:16,400
سنكون قادرين على مغادرة
...الجزيرة قريبًا

250
00:15:16,400 --> 00:15:18,730
!مذهل! ثمّة ضباب الآن

251
00:15:18,730 --> 00:15:20,370
...الصّباح وشيك

252
00:15:22,600 --> 00:15:24,770
من الجيّد أنّنا استطعنا
!الهرب من مطاردينا

253
00:15:24,770 --> 00:15:26,110
!هذا أكيد

254
00:15:26,840 --> 00:15:30,040
علينا أن نكون حذرين لكي
.لا نصدم السّفينة بالصّخور

255
00:15:30,040 --> 00:15:31,710
!دعوا الأمر لي

256
00:15:34,310 --> 00:15:35,750
مهلاً. أكان ذلك أنت يا لوفي؟

257
00:15:35,750 --> 00:15:36,550
.لا

258
00:15:39,150 --> 00:15:40,620
.إنّها سفينة جيّدة

259
00:15:44,990 --> 00:15:45,890
!من أنت؟

260
00:15:45,890 --> 00:15:48,330
!...أ-أنت هي

261
00:15:51,760 --> 00:15:56,570
قابلتُ السّيّد 8 قبل قليل
.يا آنسة وينزداي

262
00:15:57,400 --> 00:15:59,170
!قتلتِ إيغارام

263
00:15:59,400 --> 00:16:00,810
!من يهتمّ لذلك؟

264
00:16:01,040 --> 00:16:04,440
ما الّذي تفعلينه على هذه
!السّفينة؟! ومن تكونين؟

265
00:16:04,440 --> 00:16:07,010
...ما الّذي تفعلينه هنا

266
00:16:07,010 --> 00:16:08,650
!يا آنسة أول سانداي؟

267
00:16:11,480 --> 00:16:15,490
!آنسة أول سانداي؟
!ما رقم شريكها العميل؟

268
00:16:15,790 --> 00:16:19,320
!إنّها شريكة السّيّد 0... الزّعيم

269
00:16:19,320 --> 00:16:21,290
!الزّ— كروكودايل؟

270
00:16:21,530 --> 00:16:22,630
أهي شرّيرة؟

271
00:16:22,660 --> 00:16:26,230
.كانت الوحيدة الّتي تعرف هويّة الزّعيم

272
00:16:26,400 --> 00:16:30,530
!عرفنا من يكون عن طريق ملاحقتها

273
00:16:30,530 --> 00:16:33,940
.بشكل أدقّ... سمحتُ لكم بملاحقتي

274
00:16:33,940 --> 00:16:35,510
!إنّها طيّبة إذًا

275
00:16:35,510 --> 00:16:37,310
!أعلم ذلك

276
00:16:37,310 --> 00:16:40,610
أنتِ أيضًا من أخبره
أنّنا اكتشفنا هويّته، صحيح؟

277
00:16:40,980 --> 00:16:41,740
.صحيح

278
00:16:41,740 --> 00:16:43,580
!إنّها شرّيرة بالفعل

279
00:16:43,580 --> 00:16:45,420
!اهدأ أنت

280
00:16:45,420 --> 00:16:48,220
!ما الّذي تحاولين فعله بالضّبط؟

281
00:16:49,220 --> 00:16:50,520
.سؤال وجيه

282
00:16:51,520 --> 00:16:55,830
كنتم جميعًا عازمين وجادّين
.ولم يسعني إلاّ مساعدتكم

283
00:16:56,430 --> 00:16:59,430
إنّ فكرة محاولة أميرة بذل
قصارى جهدها لإنقاذ مملكتها

284
00:16:59,430 --> 00:17:01,930
بينما تجعل من نفسها
...عدوّة لباروك وركس

285
00:17:02,160 --> 00:17:04,500
...كانت سخيفة للغاية كما تعلمين

286
00:17:05,930 --> 00:17:08,640
!لا تسخري منّي

287
00:17:12,270 --> 00:17:16,650
!يا سانجي! هل تدرك ما الّذي تفعله؟

288
00:17:16,650 --> 00:17:18,410
.لا، ليس تمامًا

289
00:17:18,810 --> 00:17:21,580
شعرتُ فقط أنّ عزيزتي
...الآنسة وينزداي في خطر

290
00:17:22,620 --> 00:17:26,690
كنتُ لأقدّر لكما إن لم تصوّبا
.أشياء خطيرة كهذه ناحيتي

291
00:17:28,420 --> 00:17:29,020
!...لا يُعقل

292
00:17:30,060 --> 00:17:31,260
—فاكهة

293
00:17:32,390 --> 00:17:33,760
!فاكهة شيطان؟

294
00:17:33,760 --> 00:17:36,130
!ما هي؟! ما هي قدراتها؟

295
00:17:36,660 --> 00:17:38,130
...هذا مؤلم

296
00:17:38,870 --> 00:17:41,470
،بعد إعادة النّظر إليك
!اتّضح لي أنّك غاية في الجمال

297
00:17:42,200 --> 00:17:48,610
.مهلاً، لا تستعجل
.لم أُمنح أيّة أوامر بعد

298
00:17:49,040 --> 00:17:50,780
.لا سبب يدفعني للقتال

299
00:17:52,980 --> 00:17:55,980
إذًا أنت هو قائد قراصنة قبّعة
...القشّ الّذي سمعتُ عنه

300
00:17:56,520 --> 00:17:58,690
!مونكي د. لوفي

301
00:17:58,950 --> 00:18:02,420
!أنتِ! أعيدي لي قبّعتي
!أتحاولين افتعال قتال؟

302
00:18:02,420 --> 00:18:05,660
!أراك كعدوّ! غادري في الحال

303
00:18:05,660 --> 00:18:06,730
...يا حظّكم السّيّئ

304
00:18:07,190 --> 00:18:11,400
أنتم الّذين اصطحبوا أميرة تسعى
...باروك وركس لقتلها

305
00:18:12,030 --> 00:18:15,500
...وأميرة يحميها حفنة من القراصنة

306
00:18:16,100 --> 00:18:22,080
لكن الأكثر شؤمًا هو المسار
.الّذي تشير له البوصلة المسجِّلة

307
00:18:22,910 --> 00:18:24,510
...اسم الجزيرة هو الحديقة الصّغيرة

308
00:18:25,650 --> 00:18:26,950
!ليتل غاردن

309
00:18:28,450 --> 00:18:31,220
،لا نحتاج حتّى لفعل أيّ شيء

310
00:18:31,220 --> 00:18:34,090
لأنّه ستتمّ إبادتكم قبل حتّى
.أن تصلوا إلى ألاباستا

311
00:18:34,090 --> 00:18:35,620
!أنت مخطئة! أعيدي لي قبّعتي

312
00:18:35,620 --> 00:18:37,490
!في أحلامك أيّتها الغبيّة

313
00:18:37,490 --> 00:18:38,960
هل أنت طفل؟

314
00:18:39,590 --> 00:18:44,100
ألا تعتقدون أنّ السّماح لأنفسكم
بالتّعرّض للإبادة حماقة نوعًا ما؟

315
00:18:46,500 --> 00:18:47,870
بوصلة دائمة؟

316
00:18:48,470 --> 00:18:51,840
.بإمكانكم تخطّي ليتل غاردن باستعمالها

317
00:18:52,170 --> 00:18:56,270
.إنّها تشير لجزيرة قبل ألاباستا مباشرة

318
00:18:56,270 --> 00:18:57,780
.جزيرة اللاّشيء، نانيموناي

319
00:18:58,280 --> 00:19:01,750
لا يعرف أيّ أحد من رجالنا بذلك
.المسار، لذلك لن يطاردكم أحد

320
00:19:04,380 --> 00:19:07,150
ماذا؟ إنّها شخص طيّب؟

321
00:19:07,150 --> 00:19:08,650
!لماذا تعطيننا هذه؟

322
00:19:08,650 --> 00:19:10,360
إنّه فخّ، صحيح؟

323
00:19:11,690 --> 00:19:13,120
أتظنّ ذلك؟

324
00:19:13,960 --> 00:19:18,030
ماذا أفعل؟ لا أريد قبول
.هذا من شخص مثلها

325
00:19:18,530 --> 00:19:21,430
لكن بعد أن سمحوا لي
،بالصّعود على سفينتهم

326
00:19:21,430 --> 00:19:23,430
فأخذ المسار الأكثر أمانًا
...هو الأفضل

327
00:19:23,430 --> 00:19:26,370
!من يهتمّ لذلك؟

328
00:19:30,940 --> 00:19:32,940
!هل أنت غبيّ؟

329
00:19:32,940 --> 00:19:36,410
لقد تكبّدت عناء إخبارنا
!بالطّريق الأسهل

330
00:19:36,410 --> 00:19:39,220
!ماذا إن كانت شخصًا طيّبًا بالفعل؟

331
00:19:41,050 --> 00:19:43,650
!لستِ من يحدّد مسار هذه السّفينة

332
00:19:48,690 --> 00:19:50,830
.فهمت. هذا مؤسف

333
00:19:50,830 --> 00:19:51,730
!يكفي

334
00:19:51,730 --> 00:19:54,760
لقد فجّرت سفينة العمّ
!ذو شعر الأنابيب، لذا أنا أكرهها

335
00:19:55,770 --> 00:19:59,070
.أنا لا أكره الأشخاص الجريئين

336
00:19:59,400 --> 00:20:00,740
...إن نجوتم

337
00:20:01,200 --> 00:20:02,710
.فسنلتقي ثانية

338
00:20:02,910 --> 00:20:03,670
!كلاّ

339
00:20:06,980 --> 00:20:08,280
!لنذهب يا بانتشي

340
00:20:12,310 --> 00:20:14,150
!ما-ما ذلك الشّيء؟

341
00:20:14,150 --> 00:20:15,580
!لا تقل لي أنّه ملك بحر

342
00:20:15,580 --> 00:20:16,650
...لا

343
00:20:18,020 --> 00:20:20,320
!إنّها سلحفاة

344
00:20:20,320 --> 00:20:22,860
!يا لها من سلحفاة ضخمة

345
00:20:28,400 --> 00:20:33,000
لا يمكنني معرفة ما
!الّذي تفكّر به تلك المرأة

346
00:20:33,000 --> 00:20:35,100
.إذًا لا فائدة من التّفكير في الأمر

347
00:20:35,100 --> 00:20:37,640
نملك سلفًا شخصًا كذلك على
.هذه السّفينة من الأساس

348
00:20:37,810 --> 00:20:40,840
!مهلاً! اشرح ما الّذي يحدث
!لا شيء من هذا منطقيّ

349
00:20:40,840 --> 00:20:43,140
!يا آنسة وينزداي
!أيعقل أنّك انضممتِ لطاقمنا؟

350
00:20:43,140 --> 00:20:44,810
!—مهلاً! اشرحوا لي

351
00:20:44,810 --> 00:20:47,050
!ماذا؟! ثمّة نعامة على السّفينة

352
00:20:47,650 --> 00:20:49,480
!أخبروني ما الّذي يحدث؟

353
00:20:49,480 --> 00:20:50,890
أهو للأكل؟

354
00:20:51,190 --> 00:20:54,690
!اشرحوا ما الّذي يحدث

355
00:20:56,060 --> 00:20:57,360
.فهمت

356
00:20:58,590 --> 00:21:00,930
،من المؤسف أنّ كلّ ذلك فاتني

357
00:21:00,930 --> 00:21:04,030
لكن ما زالت هنالك فرصة
.ليسطع نوري أيضًا

358
00:21:04,800 --> 00:21:05,970
!لا تقلقي

359
00:21:05,970 --> 00:21:09,900
بما أنّ هذا الأمير النّائم قد استيقظ
!الآن، فسلامتك مضمونة

360
00:21:11,170 --> 00:21:12,640
!من الجيّد أنّني كنت نائمًا

361
00:21:12,940 --> 00:21:14,740
نامي-سان. هل تشعرين بالغيرة؟

362
00:21:14,740 --> 00:21:16,240
!إطلاقًا

363
00:21:16,240 --> 00:21:20,610
لا يوجد مانع من تواجدي
على هذه السّفينة بالفعل؟

364
00:21:21,110 --> 00:21:23,420
...سأسبّب لكم المشاكل فحسب

365
00:21:23,420 --> 00:21:26,550
!ما الّذي تقولينه؟
!نعرف من أنتِ الآن

366
00:21:26,550 --> 00:21:29,590
،إن كنتِ لا تريدين المشاكل لنا
!كان عليك فعل ذلك من البداية

367
00:21:30,060 --> 00:21:31,120
.أنا آسفة

368
00:21:31,320 --> 00:21:32,930
