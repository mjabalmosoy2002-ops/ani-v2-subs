1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:53,620 --> 00:01:55,750
...أجراس ذهبيّة وطائر

22
00:01:55,750 --> 00:01:58,660
هل تعتقد أنّها كانت رموزًا لجايا القديمة؟

23
00:01:59,460 --> 00:02:03,630
لا أدري، لكن أعتقد
.أنّها كانت جزءًا من نموذج ما

24
00:02:04,030 --> 00:02:08,800
يُسمّى هذا طائر الجنوب، وهي طيور
!ما زالت تعيش على هذه الجزيرة

25
00:02:08,800 --> 00:02:11,070
هل لديها صوت غريب؟

26
00:02:11,070 --> 00:02:12,770
!نعم. كما ذُكر في السّجلّ تمامًا

27
00:02:13,100 --> 00:02:17,170
...استعمل البحّارة طائر الجنوب منذ

28
00:02:18,210 --> 00:02:20,240
!مصيبة

29
00:02:20,240 --> 00:02:21,450
!ما الأمر؟! ما الخطب؟

30
00:02:21,880 --> 00:02:24,650
!اذهبوا للإمساك بهذا الطّائر في الحال

31
00:02:24,650 --> 00:02:26,150
!لماذا؟! من أجل ماذا؟

32
00:02:26,150 --> 00:02:27,420
لماذا نحتاج هذا الطّائر؟

33
00:02:27,420 --> 00:02:32,690
اسمعوا جيّدًا! تيّار المحيط
الصّاعد الّذي ستقصدونه غدًا

34
00:02:32,690 --> 00:02:36,030
.موجود جنوب هذا الرّأس مباشرة

35
00:02:36,030 --> 00:02:37,360
كيف ستصلون إلى هناك؟

36
00:02:38,030 --> 00:02:41,670
،بمجرّد دخولكم عرض البحر
!من المستحيل أن تعرفوا الاتّجاهات

37
00:02:41,670 --> 00:02:42,800
!هذا صحيح

38
00:02:42,800 --> 00:02:47,340
،نحن ذاهبون لنقطة ما في المحيط
!وليس جزيرة، لا مرشد لنعتمد عليه

39
00:02:47,540 --> 00:02:50,840
ستصلون إلى هناك باستعمال
!تصرّف هذا الطّائر

40
00:02:53,010 --> 00:02:57,010
سمعتُ قصّة عائلة مونبلان
.الحزينة في الحانة

41
00:02:57,010 --> 00:02:58,820
.لقد أثّرت بي يا كريكت

42
00:02:59,620 --> 00:03:05,290
الكنوز الّتي كافح أحد آخر للحصول
!عليها لديها طعم خاصّ بها

43
00:03:05,560 --> 00:03:09,430
أتريدون معرفة بماذا يصفني الآخرون؟

44
00:03:09,430 --> 00:03:10,900
!الضّبع

45
00:03:15,570 --> 00:03:20,470
!الأحلام لا تتحقّق؟"
".بيلامي ضدّ تحالف ساروياما

46
00:03:37,420 --> 00:03:39,060
!ها هي قادمة! تفاداها

47
00:03:52,470 --> 00:03:55,070
!هذه اليعاسيب ليست طبيعيّة

48
00:03:56,940 --> 00:03:57,540
!شبكتنا

49
00:03:57,540 --> 00:03:59,110
!ما قصّة هذه الغابة؟

50
00:04:04,750 --> 00:04:05,750
!إنّه هو

51
00:04:05,750 --> 00:04:06,620
!ماذا تعني؟

52
00:04:06,620 --> 00:04:09,620
!طائر الجنوب أشبه ببرج تحكّم للحشرات

53
00:04:09,620 --> 00:04:11,860
!لماذا يتحكّم طائر بالحشرات؟

54
00:04:21,100 --> 00:04:23,370
!إنّها هنا! من أين تصدر؟

55
00:04:27,940 --> 00:04:31,610
...ما هذا؟ أسمع شيئًا مختلفًا

56
00:04:31,610 --> 00:04:32,840
!أمامنا

57
00:04:32,840 --> 00:04:34,080
ماذا؟ جلاميد؟

58
00:04:34,410 --> 00:04:35,350
!إنّها تتدحرج باتّجاهنا

59
00:04:35,950 --> 00:04:37,450
!أهذا روث خنافس الرّوث؟

60
00:04:37,650 --> 00:04:38,980
!كلاّ! إنّها حشرات

61
00:04:39,350 --> 00:04:41,020
!إنّها دعاسيق

62
00:04:41,020 --> 00:04:42,750
!إنّها ضخمة

63
00:04:42,750 --> 00:04:44,360
!سُحقًا لها

64
00:04:49,390 --> 00:04:51,030
!لا نهاية لها

65
00:04:51,460 --> 00:04:54,570
!لماذا جيش الحراقات خاصّتك يهاجمني؟

66
00:04:54,570 --> 00:04:57,470
!أنت تعترضين طريقي
!أتظنّين أنّ بإمكانك هزيمتي؟

67
00:04:59,670 --> 00:05:03,240
...أستطيع سماعه، لكن لا أستطيع رؤيته

68
00:05:03,240 --> 00:05:04,580
!بـ-بزّاقة

69
00:05:04,580 --> 00:05:06,110
!الملح! ارميا الملح عليها

70
00:05:06,110 --> 00:05:08,550
!سانجي! استعمل ركلة الشّقلبة الملحيّة

71
00:05:08,550 --> 00:05:11,080
!حسنًا! إنّها ملحميّة وليس ملحيّة

72
00:05:12,680 --> 00:05:16,590
!سئمتُ من الهرب! أريني ما لديك

73
00:05:16,590 --> 00:05:19,860
!كلاّ يا لوفي! النّحل الدّبّ سامّ للغاية

74
00:05:20,790 --> 00:05:21,890
!يراعات

75
00:05:21,890 --> 00:05:22,360
!جميلة

76
00:05:22,730 --> 00:05:23,930
!صراصير

77
00:05:24,330 --> 00:05:25,560
!خنازير

78
00:05:36,910 --> 00:05:39,810
إنّنا نقبل القتالات الّتي يفتعلها
!الآخرون معنا بكلّ سرور

79
00:05:39,810 --> 00:05:42,550
!إيّاكم أن تستخفّوا بتحالف ساروياما

80
00:05:42,550 --> 00:05:43,550
!نالوا منهم

81
00:05:45,380 --> 00:05:49,550
،سلّمونا ذهبكم بصمت
!وإلاّ دفعتم الثّمن غاليًا

82
00:05:49,550 --> 00:05:52,060
وكيف ذلك؟

83
00:06:00,830 --> 00:06:02,470
!أ-أيّها الكهل

84
00:06:02,900 --> 00:06:04,440
!لكمة القرد

85
00:06:27,490 --> 00:06:31,830
تعرف أنّ من الخطير على
!الأطفال التّلويح بأشياء كهذه

86
00:06:34,230 --> 00:06:38,940
حسنًا، أعتقد أنّه علينا بدء عرض
!منتصف اللّيل هذا

87
00:06:39,940 --> 00:06:41,040
...النّابض

88
00:06:41,610 --> 00:06:42,670
!القانص

89
00:07:08,700 --> 00:07:11,200
!أحسنت يا بيلامي! مرحى

90
00:07:15,240 --> 00:07:18,710
ما رأيك بقوّة فاكهة النّابض
الّتي يمتلكها قائدنا؟

91
00:07:19,480 --> 00:07:21,310
تعجز عن الكلام، صحيح؟

92
00:07:22,750 --> 00:07:26,380
!نظّفوا القمامة! تولّوا أمرهم

93
00:07:33,890 --> 00:07:36,090
!أيّ تحالف هو تحالف ساروياما هذا؟

94
00:07:36,090 --> 00:07:39,800
!أنتم مجرّد رجل عجوز وقردان ضخمان

95
00:07:41,700 --> 00:07:43,030
!وجدناه يا بيلامي

96
00:07:43,400 --> 00:07:44,940
!هذا هو بالتّأكيد

97
00:07:48,240 --> 00:07:52,780
!مذهل! انظروا إلى هذه
!سبيكة ذهب مدهشة

98
00:07:52,780 --> 00:07:55,580
!ثمّة المزيد! هذا رائع

99
00:07:55,580 --> 00:07:57,420
!كان صيدنا وفيرًا

100
00:07:58,750 --> 00:08:03,920
إنّكم... لستم أهلاً لامتلاك
!...ذلك الذّهب

101
00:08:05,590 --> 00:08:06,860
لسنا أهلاً؟

102
00:08:07,290 --> 00:08:09,330
!هل سأصبح أهلاً لذلك بعد هذا؟

103
00:08:11,360 --> 00:08:12,300
!النّصل الكبير القاطع

104
00:08:17,340 --> 00:08:19,040
...أيّها الأحمق

105
00:08:21,510 --> 00:08:24,240
!نحن أقوى بكثير منكم

106
00:08:24,410 --> 00:08:28,880
!كم سنحتاج أكثر لنكون أهلاً لسرقة الكنوز؟

107
00:08:29,050 --> 00:08:30,580
!أخبرني أيّها الكهل

108
00:08:30,920 --> 00:08:32,680
!انتبه أيّها العجوز

109
00:08:33,580 --> 00:08:35,350
!سونار الدّمار

110
00:08:46,900 --> 00:08:48,230
!وغد

111
00:08:48,230 --> 00:08:49,270
!انتظر يا ساركيس

112
00:08:50,100 --> 00:08:51,970
.سأنهي حياته

113
00:08:53,800 --> 00:08:59,240
!...ليس ثانيةً... قوّة فاكهة النّابض

114
00:08:59,240 --> 00:09:01,110
!اهرب يا شوجو

115
00:09:01,110 --> 00:09:02,580
...النّابض

116
00:09:05,020 --> 00:09:07,320
!القانص

117
00:09:09,020 --> 00:09:11,120
!شوجو

118
00:09:26,940 --> 00:09:32,140
!أيّها العجوز! وجدنا ذهبًا
!سبيكة على شكل جرس

119
00:09:42,720 --> 00:09:48,030
!انظر! إنّها تشبه ما ذُكر في السّجلّ
!ذُكر هنا أجراس

120
00:09:52,960 --> 00:09:55,930
.حسنًا، لنذهب. احملوا الذّهب للسّفينة

121
00:09:56,470 --> 00:09:58,500
!اكبر أيّها الكهل

122
00:09:59,600 --> 00:10:04,140
مدينة الذّهب" هذه مجرّد"
!ضرب من خيال نولاند

123
00:10:04,140 --> 00:10:08,350
إن كنتَ تريد أن تصبح قرصانًا
،في العصر الجديد القادم

124
00:10:08,350 --> 00:10:11,620
فعليك إذًا أن تدرك
!أنّ الأحلام لا تتحقّق أبدًا

125
00:10:15,120 --> 00:10:17,360
!مدينة الذّهب موجودة فعلاً

126
00:10:19,520 --> 00:10:22,260
!مهلاً! لا تتحمّسا كثيرًا
!فنحن في منزل صغير

127
00:10:24,630 --> 00:10:26,730
...انتظر أيّها الولد

128
00:10:38,510 --> 00:10:43,080
إنّ فرخًا مثلك لا يملك
...الشّجاعة لمقاتلة الأحلام

129
00:10:43,080 --> 00:10:45,450
!لا يحقّ له التّحدّث عن القراصنة

130
00:10:47,120 --> 00:10:48,750
ماذا قلت؟

131
00:11:11,410 --> 00:11:14,910
لا فائدة. لم نستطع حتّى
...رؤية واحد منها

132
00:11:14,910 --> 00:11:19,980
رأينا واحدًا، لكن لم يكن هنالك وقت
...للإمساك بالطّائر بسبب الحشرات

133
00:11:20,720 --> 00:11:22,350
...كلّ ما فعلناه هو الهرب

134
00:11:23,190 --> 00:11:27,960
!تبًّا! سبعة أشخاص ولم تمسكوا بشيء؟
!تمالكوا أنفسكم يا رفاق

135
00:11:27,960 --> 00:11:28,790
!أنت واحد منهم

136
00:11:30,430 --> 00:11:33,360
!لا يمكنني الرّكض أكثر

137
00:11:41,440 --> 00:11:45,240
أتعتقدون فعلاً أنّ بإمكانكم"
"!الإمساك بي؟ أغبياء

138
00:11:45,240 --> 00:11:48,650
!ماذا؟! أتى إلى هنا لإخبارنا بهذا؟

139
00:11:48,650 --> 00:11:51,050
!سُحقًا! سأسقطك من هناك

140
00:11:57,320 --> 00:11:59,320
.كلّ ما أحتاجه هو رؤية أحدها

141
00:12:04,530 --> 00:12:06,600
!أيّها العمّ! أمسكنا بطائر

142
00:12:08,100 --> 00:12:09,600
!أيّها العمّ ذو الرّأس الماسيّ

143
00:12:10,100 --> 00:12:11,400
!ماسيرا

144
00:12:11,400 --> 00:12:12,740
!شوجو

145
00:12:13,770 --> 00:12:16,410
!ما الّذي حدث هنا؟

146
00:12:17,310 --> 00:12:20,140
!سُحقًا! من فعل هذا؟

147
00:12:20,140 --> 00:12:21,410
!تعال وساعدني

148
00:12:21,410 --> 00:12:22,050
!حاضر

149
00:12:22,280 --> 00:12:26,080
!...انظروا! إنّ غوينغ ميري

150
00:12:26,080 --> 00:12:31,360
!ما الّذي حدث؟! من الفاعل؟
!سُحقًا! من فعل هذا؟

151
00:12:31,560 --> 00:12:33,020
...آسف

152
00:12:33,020 --> 00:12:33,590
!أيّها العمّ

153
00:12:35,490 --> 00:12:37,060
!أيّها العمّ! هل استعدت وعيك؟

154
00:12:37,060 --> 00:12:38,700
!أنا جدّ آسف

155
00:12:38,700 --> 00:12:41,570
!لم يكن بوسعنا فعل شيء
!كنّا بلا حول ولا قوّة

156
00:12:41,570 --> 00:12:48,440
لكن... ما زال هنالك وقت لتقوية
!...السّفينة قبل الشّروق

157
00:12:48,440 --> 00:12:51,780
!مهلاً أيّها العمّ! أخبرنا ما حدث أوّلاً

158
00:12:52,640 --> 00:12:57,320
.لا... لا بأس. لا داعي للقلق
...الأمر لا يهمّ الآن

159
00:12:57,320 --> 00:12:59,250
...الأهمّ الآن، عليكم أن

160
00:13:02,190 --> 00:13:06,160
!ممتاز! أمسكتم بطائر جنوب

161
00:13:06,490 --> 00:13:07,590
!هذا مثاليّ

162
00:13:08,330 --> 00:13:09,730
!لوفي

163
00:13:09,960 --> 00:13:12,500
!الذّهب... لقد سُرق

164
00:13:18,240 --> 00:13:23,610
...لا، لا بأس... انسوا أمر تلك الخردة

165
00:13:23,610 --> 00:13:25,280
...عليكم أن تركّزوا على

166
00:13:25,280 --> 00:13:27,650
!ماذا تقصد بـ"الخردة"؟

167
00:13:27,650 --> 00:13:31,280
أخذ الأمر عشر سنوات
من الغوص في المحيط

168
00:13:31,280 --> 00:13:33,690
وتعذيب جسدك حتّى
!وجدت ذلك الذّهب

169
00:13:33,690 --> 00:13:34,390
...لا يمكن ببساطة أن

170
00:13:34,390 --> 00:13:35,550
!اخرس

171
00:13:38,790 --> 00:13:42,990
...لا بأس... هذه مشكلتنا نحن

172
00:13:42,990 --> 00:13:43,830
!استمعوا

173
00:13:44,700 --> 00:13:47,800
،إن عملنا جميعًا عليها
يستطيع تحالف ساروياما

174
00:13:47,800 --> 00:13:51,000
.إصلاح وتقوية تلك السّفينة بلا مشاكل

175
00:13:51,000 --> 00:13:53,300
!سأطلب منهم إنهاءها لهذا الصّباح

176
00:13:53,810 --> 00:13:57,040
!لن تكون هنالك أيّ مشاكل لانطلاقتكم غدًا

177
00:13:57,280 --> 00:14:02,250
،اسمعوا! سنرسلكم إلى السّماء
!بدون أدنى شكّ

178
00:14:02,580 --> 00:14:03,950
...أيّها العجوز

179
00:14:05,820 --> 00:14:06,950
.يا لوفي

180
00:14:14,190 --> 00:14:15,590
...شعار بيلامي

181
00:14:18,130 --> 00:14:19,230
أتريد المساعدة؟

182
00:14:19,960 --> 00:14:21,230
.لا، يمكنني تولّي الأمر وحدي

183
00:14:21,230 --> 00:14:26,140
!لا يا لوفي! لا تتصرّف بغباء
!سنبحر بعد ثلاث ساعات

184
00:14:30,040 --> 00:14:33,680
إن ذهبتُ بمحاذاة السّاحل، فسأبلغ
البلدة الّتي كنّا فيها هذا المساء؟

185
00:14:33,680 --> 00:14:35,080
.نعم، ذلك صحيح

186
00:14:37,950 --> 00:14:40,520
!أيّها الفتى! إلى أين تذهب؟

187
00:14:40,820 --> 00:14:44,720
!لا تتصرّف بحماقة
—أتعلم مع من تتعامل

188
00:14:45,890 --> 00:14:47,590
.إن كنتَ تريد إيقافه، فاستعمل هذا

189
00:14:49,330 --> 00:14:51,530
...أ-أيّها الفتى

190
00:14:55,530 --> 00:14:57,300
!سأعود في الصّباح

191
00:14:59,800 --> 00:15:05,810
أنا فارغ الآن! كانت تلك آخر
!قطرة ماء في جسمي

192
00:15:05,810 --> 00:15:09,210
!لن أتعرّق الآن ولو قطرة واحدة

193
00:15:09,210 --> 00:15:12,780
!هذا السّكّير العجوز مفلس وجافّ

194
00:15:15,450 --> 00:15:19,220
!يا إله الكحول، شكرًا على اليوم

195
00:15:21,330 --> 00:15:22,830
...لكن أعتقد أنّ لا وجود له

196
00:15:27,830 --> 00:15:29,270
صحيفة؟

197
00:15:29,270 --> 00:15:32,970
لنرَ ما الأخبار السّيّئة لهذا اليوم؟

198
00:15:34,570 --> 00:15:37,380
.هذه ليست الصّحيفة
...إنّها حزمة ملصقات مطلوبين

199
00:15:38,080 --> 00:15:44,320
!يا إلهي، هذه بلدة بلا قانون
!سئمت لقاء الأشرار الجدد

200
00:15:46,220 --> 00:15:49,020
!هذا هو الفتى الجبان الّذي كان هنا مساءً

201
00:15:49,920 --> 00:15:54,060
!كان حديثه عن جزيرة السّماء مضحكًا

202
00:15:54,060 --> 00:15:55,990
...أعتقد أنّ مكافأته كانت 30 مليونًا

203
00:15:59,160 --> 00:16:02,100
!كلاّ! كلاّ! أظنّني شربت الكثير

204
00:16:02,100 --> 00:16:02,930
...لنرَ

205
00:16:02,930 --> 00:16:09,810
،واحد، عشرة، مائة، ألف، عشرة آلاف
...مائة ألف، مليون، عشرة ملايين

206
00:16:10,540 --> 00:16:13,510
!ماذا؟! لقد شربت الكثير بالفعل

207
00:16:15,080 --> 00:16:22,750
،واحد، عشرة، مائة، ألف، عشرة آلاف
...مائة ألف، مليون، عشرة ملايين

208
00:16:23,820 --> 00:16:24,620
!مائة مليون

209
00:16:28,490 --> 00:16:30,230
!لديك ثلاث ساعات يا لوفي

210
00:16:33,830 --> 00:16:36,170
...إن أخّرنا انطلاقتنا أكثر من ذلك

211
00:16:40,340 --> 00:16:43,740
!ستخسر فرصتك للذّهاب لجزيرة السّماء

212
00:16:45,440 --> 00:16:48,710
على الأرجح أنّه واصل الغوص كلّ يوم

213
00:16:48,710 --> 00:16:53,220
دون منح الفرصة للفقاعات
.بالاختفاء من جسده

214
00:16:56,520 --> 00:17:01,690
.هذا نزال مع الرّجل الّذي دمّر حياتي

215
00:17:04,500 --> 00:17:07,530
!آسف! أنا جدّ آسف

216
00:17:07,530 --> 00:17:11,040
!لم يكن بوسعنا فعل شيء
!كنّا بلا حول ولا قوّة

217
00:17:12,970 --> 00:17:15,470
!سُحقًا له

218
00:17:19,610 --> 00:17:22,610
!كان ذلكما القردان الضّخمان مضحكين

219
00:17:22,610 --> 00:17:26,920
ملأت كدمات كبيرة جسديهما بالكامل
واختلطت دموعهما مع مخاطهما

220
00:17:26,920 --> 00:17:29,350
!"بينما يصرخان قائلين "أيّها العجوز

221
00:17:31,020 --> 00:17:34,060
،إن كان مهمًّا لتلك الدّرجة
!كان عليهما حمايته أفضل من ذلك

222
00:17:34,760 --> 00:17:36,160
!أليس كذلك؟

223
00:17:36,160 --> 00:17:37,460
!كم هذا سخيف

224
00:17:38,460 --> 00:17:40,200
.لا تتصرّف هكذا

225
00:17:40,200 --> 00:17:42,630
،لم يكن بوسعهم أيّ شيء
!فقد كنتما أنت وبيلامي خصمهم

226
00:17:43,100 --> 00:17:48,240
قبل كلّ شيء، قائدنا مبتدئ صاعد
!تبلغ مكافأته 55 مليون بيري

227
00:17:50,170 --> 00:17:51,740
!أخبار سيّئة

228
00:17:51,740 --> 00:17:53,580
!ما الخطب؟! نحن في منتصف اللّيل

229
00:17:56,280 --> 00:17:59,380
أولئك الأشخاص الّذين كانوا
!...هنا هذا المساء، كانوا

230
00:18:00,050 --> 00:18:04,060
!بيلامي! ما زلتَ هنا

231
00:18:04,520 --> 00:18:08,530
!عليك الهرب من هنا
!أنت في خطر كبير

232
00:18:09,730 --> 00:18:13,500
عمّ تتحدّث؟ أنا في خطر؟

233
00:18:54,140 --> 00:18:55,510
!مائة مليون...؟

234
00:18:56,710 --> 00:18:58,140
!ستّون مليونًا؟

235
00:19:01,050 --> 00:19:04,320
!هذا صحيح! إنّهما من كانا هنا هذا المساء

236
00:19:04,320 --> 00:19:08,120
!مكافآتهما أعلى من مكافأتك يا بيلامي

237
00:19:08,390 --> 00:19:09,520
!أنت في عداد الموتى

238
00:19:15,190 --> 00:19:19,160
!هل أنت جادّ؟! سُحقًا
!ضحكنا على الأشخاص الخطأ

239
00:19:19,160 --> 00:19:22,670
!أتعتقد أنّهما سيتذكّران وجوهنا؟
!من الخطير البقاء هنا

240
00:19:26,270 --> 00:19:29,710
!لم أقابل أحدًا مكافأته مائة مليون من قبل

241
00:19:36,150 --> 00:19:42,020
!مهلاً، مهلاً، مهلاً! أيّها الحمقى
!تخافون حفنة أوراق

242
00:19:42,420 --> 00:19:47,330
!هل أصابكم العمى؟
!سبق ورأيتم قائدهم

243
00:19:49,130 --> 00:19:50,060
!وصلت

244
00:19:50,600 --> 00:19:53,870
هل تعرفون أنّه كان هنالك
قراصنة في الماضي

245
00:19:53,870 --> 00:19:59,300
زيّفوا ملصقات المطلوبين
خاصّتهم لإشهار أنفسهم؟

246
00:19:59,570 --> 00:20:05,540
كان النّاس يرون مكافآتهم
،ويتراجعون جبنًا ويستسلمون

247
00:20:05,540 --> 00:20:08,150
...رغم أنّه كان بمقدورهم الفوز في قتال

248
00:20:08,150 --> 00:20:10,280
!تمامًا كما هو حالكم الآن

249
00:20:10,280 --> 00:20:16,550
انظروا لحالكم الآن مع أنّكم رأيتم
!كم كانا ضعيفين! مثيرون للشّفقة

250
00:20:16,850 --> 00:20:20,190
!معك حقّ! ذلكما الوغدان أرعباني بالفعل

251
00:20:20,590 --> 00:20:24,930
بيلامي محقّ. إنّ شخصًا
مكافأته مائة مليون

252
00:20:24,930 --> 00:20:28,200
،لا بدّ أنّه تورّط في أمور سيّئة

253
00:20:28,200 --> 00:20:31,600
!لكن لماذا لم نقرأ عنه في الصّحف؟

254
00:20:31,940 --> 00:20:35,310
!بالتّأكيد! لم أسمع بفتى قبّعة القشّ هذا

255
00:20:35,610 --> 00:20:38,640
!لقد أخافني لبعض الوقت بالفعل

256
00:20:40,480 --> 00:20:42,450
!حسنًا! لنعد للشّرب

257
00:20:50,620 --> 00:20:54,290
!بيلامي! أين أنت؟

258
00:21:08,370 --> 00:21:09,810
...لا أصدّق أنّه يناديني لأخرج

259
00:21:17,980 --> 00:21:18,850
!أنت

260
00:21:25,390 --> 00:21:28,430
...سمعتُ الإشاعات عنك للتّوّ

261
00:21:29,030 --> 00:21:31,100
ألديك شأن ما معي؟

262
00:21:32,000 --> 00:21:36,170
!نعم! أعد ذهب العمّ ذو الرّأس الماسيّ

263
00:21:55,390 --> 00:22:03,460
آه، خلف السّماء الّتي لا نهاية لها

264
00:22:03,460 --> 00:22:14,070
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

265
00:22:21,950 --> 00:22:29,390
مرّت عليّ أيّام كدت أخسر فيها نفسي

266
00:22:29,390 --> 00:22:37,800
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

267
00:22:37,800 --> 00:22:46,010
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

268
00:22:46,010 --> 00:22:54,850
دفعوا بي للأمام، أليس كذلك؟

269
00:22:54,850 --> 00:23:03,160
آه، إنّ النّجوم تهوي من السّماء

270
00:23:03,160 --> 00:23:06,290
...وهذه اللّحظة الفريدة

271
00:23:11,430 --> 00:23:14,700
.قلتَ أنّك ستذهب لجزيرة السّماء
فكيف سار ذلك الأمر؟

272
00:23:15,070 --> 00:23:18,310
...سأنطلق إلى السّماء بعد قليل
!بعد أن أوسعك ضربًا

273
00:23:18,310 --> 00:23:20,610
...كلّ ما تتحدّث عنه هو الأحلام

274
00:23:20,610 --> 00:23:24,780
إن أردت، أستطيع جعلك
!حلمًا للأبد... في الحياة الآخرة

275
00:23:24,780 --> 00:23:26,550
!وداعًا يا قبّعة القشّ

276
00:23:26,550 --> 00:23:28,120
:في الحلقة القادمة من ون بيس

277
00:23:28,120 --> 00:23:32,320
رجل المائة مليون! أعظم قوّة"
"!في العالم وقراصنة اللّحية السّوداء

278
00:23:32,420 --> 00:23:34,990
!ملك القراصنة، لن يكون إلاّ أنا