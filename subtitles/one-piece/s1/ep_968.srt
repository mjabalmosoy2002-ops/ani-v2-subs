1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,420 --> 00:02:00,190
أصبح أودن عضوًا في طاقم قراصنة روجر

29
00:02:00,190 --> 00:02:04,110
.وأبحر في الغراند لاين إلى الجزيرة الأخيرة

30
00:02:05,100 --> 00:02:06,700
!جزيرة السّماء

31
00:02:09,770 --> 00:02:11,850
!وجدته

32
00:02:11,850 --> 00:02:13,540
!إذًا فقد كان هنا؟

33
00:02:15,440 --> 00:02:18,330
!لا بدّ أنّه برج جرس شاندورا العظيم

34
00:02:18,330 --> 00:02:23,340
وصلتُ إلى هنا. سأرشد هذا"
.النّصّ إلى أقاصي الأرض

35
00:02:23,340 --> 00:02:25,800
".القرصان غول د. روجر

36
00:02:28,660 --> 00:02:30,370
!هل أنهيتَ القطار؟

37
00:02:30,370 --> 00:02:36,060
!تقصد القطار البحريّ؟! مستحيل
!ما زلت أصمّمه

38
00:02:49,350 --> 00:02:50,580
...سيولد

39
00:02:52,620 --> 00:02:55,580
.قائدنا سيولد

40
00:02:55,580 --> 00:02:58,360
!توكي! تلك هي جزيرة البرمائيّين

41
00:02:58,360 --> 00:03:02,750
...كم هذا مثير للاهتمام
...تبدو الجزيرة بأكملها في فقاعة

42
00:03:02,750 --> 00:03:06,020
!لا أصدّق هذا! يستطيع قراءة النّصوص بالفعل

43
00:03:06,020 --> 00:03:09,720
نعم. وبالمناسبة، هل لديكم
سلاح يتحكّم بملوك البحر؟

44
00:03:10,660 --> 00:03:13,600
،مرّة كلّ بضعة قرون في هذه البلاد

45
00:03:13,600 --> 00:03:17,100
.تولد حوريّة بإمكانها التّحدّث مع ملوك البحر

46
00:03:17,840 --> 00:03:20,440
...ربّما تلك الحوريّة

47
00:03:20,440 --> 00:03:24,820
أي أنّ ابنتك ستصبح السّلاح
!الّذي سيدمّر العالم يومًا ما؟

48
00:03:25,180 --> 00:03:28,280
!لم أعتقد قطّ أن يكون بوسيدون حوريّة

49
00:03:30,320 --> 00:03:34,080
يا شارلي، متى ستولد الأميرة الحوريّة؟

50
00:03:38,920 --> 00:03:39,830
!عشرة

51
00:03:40,730 --> 00:03:42,590
...أظنها تقصد بعد عشر سنوات

52
00:03:56,750 --> 00:04:00,560
بحثًا عن بونيغليف الطّريق الّذي
،يحمل تفاصيل الجزيرة الأخيرة

53
00:04:00,560 --> 00:04:04,520
.اتّجه أودن والبقيّة إلى بلاد وانو

54
00:04:07,720 --> 00:04:12,200
"!وُلد ملك القراصنة! الوصول للجزيرة الأخيرة"

55
00:04:32,120 --> 00:04:34,600
.يبدو هذا البحر مألوفًا

56
00:04:35,010 --> 00:04:39,980
لم أعلم أنّ بونيغليف الطّريق
...كان في بلادكم

57
00:04:40,880 --> 00:04:43,400
.إنّنا على بعد خطوة من الجزيرة الأخيرة

58
00:04:43,880 --> 00:04:45,480
.الجزيرة الأخيرة

59
00:04:46,050 --> 00:04:49,500
!تقبع هناك كمّيّة هائلة من الكنوز

60
00:04:50,720 --> 00:04:53,070
!لا تطيق الانتظار، صحيح يا روجر؟

61
00:04:55,600 --> 00:04:57,160
!إلى أقصى الميمنة

62
00:05:05,040 --> 00:05:07,170
!إنّنا ذاهبون إلى بلاد وانو

63
00:05:07,610 --> 00:05:09,630
!يا رفاق، تحمّسوا

64
00:05:09,630 --> 00:05:11,920
!نعم

65
00:05:34,100 --> 00:05:35,320
!أودن-سان

66
00:05:36,020 --> 00:05:37,660
ما الخطب يا أحمرتارو؟

67
00:05:37,660 --> 00:05:39,330
!انهارت توكي-سان

68
00:05:39,330 --> 00:05:41,080
!ماذا؟

69
00:05:48,070 --> 00:05:49,050
!توكي

70
00:05:49,420 --> 00:05:52,260
!ستكونين بخير! أنا هنا إلى جانبك

71
00:05:56,290 --> 00:05:57,760
...أودن

72
00:05:58,160 --> 00:06:01,680
،كانت توكي تتبعك وتسافر معك حول العالم

73
00:06:01,680 --> 00:06:04,850
.لكنّ هدفها الأصليّ كان الذّهاب لبلاد وانو

74
00:06:04,850 --> 00:06:08,980
،بينما نقترب أكثر من بلاد وانو
،يتدهور وضعها أكثر

75
00:06:08,980 --> 00:06:11,570
.وإجهاد الرّحلة الطّويلة زادها سوءًا

76
00:06:12,640 --> 00:06:16,360
هل ستكون قادرة على مواصلة الإبحار؟

77
00:06:17,740 --> 00:06:21,240
.قد تموت إن واصلت هكذا

78
00:06:21,620 --> 00:06:25,540
يجب عليها مغادرة السّفينة
.في بلاد وانو وإنهاء رحلتها

79
00:06:27,940 --> 00:06:34,590
في تلك الحالة يا أودن-ساما، عليك ترك
.مومونوسكي-ساما وهيوري-ساما في بلاد وانو أيضًا

80
00:06:34,590 --> 00:06:36,220
.اتركهما مع توكي-ساما

81
00:06:36,220 --> 00:06:39,930
.لا يعرف كينييمون والبقيّة توكي-ساما جيّدًا

82
00:06:39,930 --> 00:06:42,810
.لذلك سنرافقها أنا وإينواراشي

83
00:06:42,810 --> 00:06:47,150
،إنّهم غير معتادين على المكان
.لذلك واثق أنّهم سيشعرون بالوحدة

84
00:06:47,480 --> 00:06:50,670
.دع أمر توكي-ساما لنا

85
00:06:50,670 --> 00:06:52,650
...لا، بالطّبع سوف

86
00:06:54,590 --> 00:06:55,960
!توكي؟

87
00:06:59,620 --> 00:07:02,030
!عليك الذّهاب يا أودن-سان

88
00:07:02,770 --> 00:07:04,540
!ماذا تقولين؟

89
00:07:04,830 --> 00:07:06,120
!لا تحاولي التّظاهر بالقوّة

90
00:07:25,420 --> 00:07:27,390
".ثمّة قيود كثيرة"

91
00:07:28,800 --> 00:07:31,000
ماذا عن هذه الكلمات؟

92
00:07:31,000 --> 00:07:36,030
أهذا كلّ الشّغف الّذي لديك للمغامرة؟

93
00:07:36,030 --> 00:07:38,950
،إن استسلمت بسبب أمر هيّن كهذا

94
00:07:39,350 --> 00:07:40,360
...فأنا

95
00:07:42,770 --> 00:07:44,990
!سأفسخ هذا الزّواج

96
00:08:18,090 --> 00:08:21,390
لماذا أنت على عجلة من أمرك يا رايزو؟

97
00:08:21,390 --> 00:08:25,330
!كينييمون! أتت سفينة من العالم الخارجيّ

98
00:08:25,330 --> 00:08:26,660
!إنّها سفينة قراصنة

99
00:08:28,150 --> 00:08:30,370
!أيعقل أنّه أودن-ساما؟

100
00:08:40,070 --> 00:08:43,240
...تبدو مختلفة عن سفينة اللّحية البيضاء-دونو

101
00:08:43,240 --> 00:08:45,510
!إن كانوا قراصنة، فعلينا قتالهم

102
00:08:46,540 --> 00:08:47,390
...ذلك هو

103
00:09:10,060 --> 00:09:13,620
!أودن-ساما

104
00:09:13,620 --> 00:09:15,290
!يا رفاق

105
00:09:17,990 --> 00:09:20,870
!مرّ وقت طويل يا أودن-ساما

106
00:09:20,870 --> 00:09:22,010
!أكيد

107
00:09:22,010 --> 00:09:25,640
...لا يبدو أنّك تغيّرت

108
00:09:30,170 --> 00:09:32,350
!هؤلاء زوجتي وطفلاي

109
00:09:32,350 --> 00:09:36,060
!ماذا؟! يبدو أنّ بعض الأمور قد تغيّرت فعلاً

110
00:09:36,060 --> 00:09:40,150
.اسمي توكي، وهذه هيوري

111
00:09:40,430 --> 00:09:43,380
.وهذا هو مومونوسكي

112
00:09:46,020 --> 00:09:47,580
!أتمنّى لو كنت مكانه

113
00:09:49,620 --> 00:09:51,580
!هذا هو أودن-ساما

114
00:09:51,580 --> 00:09:53,540
!يا سيّدتي

115
00:09:53,540 --> 00:09:55,330
.سرّني لقاؤك

116
00:09:55,710 --> 00:09:59,730
إنّه الفتى الّذي يقع على عاتقه
...مستقبل عشيرة كوزكي

117
00:10:04,240 --> 00:10:07,850
!يبدو ذكيًّا للغاية

118
00:10:07,850 --> 00:10:10,890
!من الجيّد أنّه لا يشبه أودن-ساما على الإطلاق

119
00:10:10,890 --> 00:10:12,180
!ماذا قلت؟

120
00:10:16,840 --> 00:10:20,520
بالمناسبة، ما قصّة أزيائكم؟

121
00:10:25,010 --> 00:10:33,510
!كنّا في انتظار عودة أودن-ساما على أحرّ من الجمر

122
00:10:34,310 --> 00:10:39,380
...بذلنا جهدنا للعناية بكوري في غيابك، لكن

123
00:10:39,380 --> 00:10:41,990
...لكن ليس كوري فحسب، بل بلاد وانو بأكملها

124
00:10:41,990 --> 00:10:43,360
!مهلاً

125
00:10:43,530 --> 00:10:47,010
...إن كنتم تهتمّون فعلاً لأودن-سان

126
00:10:47,010 --> 00:10:50,910
!أرجوكم! دعوه يذهب

127
00:10:52,580 --> 00:10:54,100
!سيّدتي

128
00:10:54,100 --> 00:10:55,390
...أنا

129
00:11:03,180 --> 00:11:06,740
.سأغيب لفترة أطول

130
00:11:25,420 --> 00:11:27,470
!أودن-ساما

131
00:11:27,740 --> 00:11:29,590
!انتظر رجاءً

132
00:11:29,590 --> 00:11:32,010
!عد

133
00:11:32,010 --> 00:11:33,930
!أودن-ساما

134
00:11:33,930 --> 00:11:36,330
!أتوسّل إليك

135
00:11:36,330 --> 00:11:38,940
!أودن-ساما

136
00:11:39,270 --> 00:11:44,480
كان واضحًا لي أنّ شيئًا ما في وانو
.قد تغيّر حتّى بينما كنت أدير ظهري

137
00:11:46,690 --> 00:11:51,120
.عرفتُ أنّني ما كنت لأبحر ثانية إن استدرت

138
00:11:53,310 --> 00:11:58,160
!اللّعنة عليك يا أودن-ساما! أيّها الوغد

139
00:11:59,570 --> 00:12:06,130
أخذت نسخة عن بونيغليف بلاد وانو
.بسرعة وعدت إلى البحر

140
00:12:06,460 --> 00:12:11,010
،عدت لوطني بعد أربع سنوات لأوّل مرّة
.لكنّي بقيت فيها لبضع ساعات فقط

141
00:12:17,460 --> 00:12:19,170
...أيّها الوغد

142
00:12:19,170 --> 00:12:21,810
!أيمكنك قراءة النّص إذًا؟

143
00:12:23,710 --> 00:12:26,730
.آسف يا أودن

144
00:12:33,280 --> 00:12:35,950
!أودن متزوّج وله طفلان؟

145
00:12:38,750 --> 00:12:41,670
.يمكنني رؤيته... يمكنني رؤية المستقبل

146
00:12:41,900 --> 00:12:45,000
،حتّى إن غادر أودن بلاد وانو

147
00:12:45,380 --> 00:12:49,720
.فسيتسبّب ذلك الفتى بالمشاكل لك بالتّأكيد

148
00:12:50,070 --> 00:12:52,820
!وريث كوزكي

149
00:12:55,910 --> 00:12:58,270
...يا للإزعاج

150
00:12:58,580 --> 00:13:04,810
وبعد ذلك، اتّجهنا إلى دوقيّة موكومو
.مسقط رأس نيكوماموشي وإينواراشي

151
00:13:04,810 --> 00:13:08,030
.قيل أنّ تلك البلاد موجودة على ظهر فيل

152
00:13:11,860 --> 00:13:15,870
قيل لي أنّ بإمكاننا الوصول إلى زو
.عن طريق هذه الفيفر كارد فحسب

153
00:13:20,120 --> 00:13:23,960
!أنت على حقّ! إنّها ليست جزيرة
!أهذا فيل؟

154
00:13:29,990 --> 00:13:32,150
صوت من هذا؟

155
00:13:32,150 --> 00:13:34,830
أودن-سان، ما الخطب؟

156
00:13:34,830 --> 00:13:39,770
...إنّه لا شيء، لكن يراودني شعور غريب

157
00:13:48,170 --> 00:13:51,650
.الرّسالة من إينواراشي ونيكوماموشي

158
00:13:51,650 --> 00:13:56,050
...إنّهما على قيد الحياة! يا لهما من عنيدين

159
00:13:56,570 --> 00:13:59,330
!أحدث غيابهما جلبة كبيرة

160
00:13:59,740 --> 00:14:02,250
.شكرًا لكم لإعلامي بوضعهما

161
00:14:09,320 --> 00:14:11,700
...أشعر بالقلق

162
00:14:11,700 --> 00:14:14,840
هل أنت بخير يا أودن؟
.هذا ليس من شيمك

163
00:14:14,840 --> 00:14:16,870
.أعرف كيف تشعر يا أودن

164
00:14:16,870 --> 00:14:18,220
!أنت أيضًا أيّها القبطان روجر؟

165
00:14:18,540 --> 00:14:23,740
...أشعر وكأنّ شيئًا ضخمًا يراقبني

166
00:14:37,640 --> 00:14:40,990
!ها هو ذا! آخر بونيغليف طريق

167
00:14:41,330 --> 00:14:43,580
!شعار عائلة كوزكي

168
00:14:43,580 --> 00:14:47,500
.إذًا فصحيح أنّنا وقبيلة المينك كنّا إخوة

169
00:14:47,820 --> 00:14:51,940
...لدينا الآن كلّ بونيغليف الطّريق

170
00:14:52,960 --> 00:14:57,300
!لنذهب يا رجال! إلى الجزيرة الأخيرة

171
00:14:57,300 --> 00:14:59,600
!أجل

172
00:15:09,170 --> 00:15:13,070
!روجر! أودن-ساما! خذوني معكم

173
00:15:13,340 --> 00:15:16,600
!أنا أرجوكم! خذوني

174
00:15:16,600 --> 00:15:20,990
.يا فتى، ما زال عليك الانتظار

175
00:15:21,120 --> 00:15:22,370
...اسمع

176
00:15:22,990 --> 00:15:26,250
.لكلّ امرئ دوره

177
00:15:26,980 --> 00:15:28,540
!دوري؟

178
00:15:28,540 --> 00:15:31,750
.وعندما يحين، قدّم لي يد العون

179
00:15:33,860 --> 00:15:36,800
!لك ذلك! سأساعدك مهما كلّف الأمر

180
00:15:37,410 --> 00:15:40,400
.مع السّلامة يا بيدرو

181
00:15:43,790 --> 00:15:49,350
.لدينا عدّة ريو بونيغليف وأربعة بونيغليف طريق

182
00:15:49,350 --> 00:15:52,940
.هدف مغامرتنا يدنو منّا

183
00:16:14,400 --> 00:16:17,550
...بونيغليف الطّريق الأربعة الّتي لدينا

184
00:16:17,880 --> 00:16:23,220
ستتقاطع الخطوط من هذه الأربعة
.في المركز حيث ستكون الجزيرة الأخيرة

185
00:16:47,850 --> 00:16:50,120
!أيّها القبطان، هل أنت بخير؟

186
00:16:58,610 --> 00:17:01,260
هل اكتشفتم أين الجزيرة الأخيرة؟

187
00:17:01,260 --> 00:17:03,120
.نعم، فعلنا

188
00:17:03,120 --> 00:17:04,970
متى سنغادر إذًا؟

189
00:17:05,830 --> 00:17:07,640
!في الحين والسّاعة

190
00:17:07,640 --> 00:17:08,670
!أكيد

191
00:17:08,670 --> 00:17:11,620
!حسنًا! لننطلق

192
00:17:18,220 --> 00:17:20,320
مـ-مهلاً، باغي؟

193
00:17:20,320 --> 00:17:21,400
!باغي؟

194
00:17:24,430 --> 00:17:30,250
سواء كان حظًّا أم لا، وقع المتدرّب
،باغيجيرو ضحيّة حمّى شديدة

195
00:17:30,520 --> 00:17:34,080
.وتخلّى عن الرّحلة نحو الجزيرة الأخيرة

196
00:17:34,320 --> 00:17:37,960
وحده فتى غبيّ يصاب بحمّى
.قبل مغامرة عظيمة

197
00:17:38,200 --> 00:17:41,300
!اخرس! قلتُ أنّني بخير الآن

198
00:17:41,570 --> 00:17:45,370
،وجهك أحمر وحرارتك مرتفعة
.لذلك اكذب بصمت

199
00:17:45,370 --> 00:17:48,040
!قلتَ أنف من أحمر وكبير؟

200
00:17:48,040 --> 00:17:49,350
!لم أقل ذلك

201
00:17:49,350 --> 00:17:50,710
!هيّا

202
00:17:50,710 --> 00:17:51,850
!تقاتلا

203
00:17:52,270 --> 00:17:54,730
!لا تشجّعاهما يا روجر وأودن

204
00:17:56,810 --> 00:17:59,550
!الكنز المبهرج ينتظرني

205
00:17:59,550 --> 00:18:01,110
!لا تضغط على نفسك أيّها الغبيّ

206
00:18:01,110 --> 00:18:02,990
!أنا قادم أيضًا

207
00:18:06,140 --> 00:18:09,740
!خذني معك يا قبطان

208
00:18:11,950 --> 00:18:14,580
هل أنت وحش أو ما شابه؟

209
00:18:15,080 --> 00:18:20,590
،رغم أنّهما يتجادلان دائمًا، ففي النّهاية
.قرّر أحمرتارو أن يعتني به بنفسه

210
00:18:22,320 --> 00:18:25,840
.لا أعرف إن كانا صديقين صدوقين أم لا

211
00:18:29,200 --> 00:18:31,870
...خذوني معكم

212
00:18:32,580 --> 00:18:34,390
.ما زال يقول ذلك

213
00:18:34,390 --> 00:18:38,190
...باغيجيرو جريء حقًّا

214
00:18:40,420 --> 00:18:45,450
باغيجيرو متشوّق ولا يصمت بشأن
.الذّهاب، على عكسك أنت يا أحمرتارو

215
00:18:45,450 --> 00:18:47,450
.أودن-سان، قبطان

216
00:18:47,770 --> 00:18:52,290
،إن كنّا نريد الذّهاب إلى هناك
!فسنذهب بسفننا نحن يومًا ما

217
00:20:24,670 --> 00:20:27,130
!نجح قراصنة روجر في مسعاهم أخيرًا

218
00:20:27,130 --> 00:20:32,090
أبحر القرصان روجر حول العالم
!لأوّل مرّة في التّاريخ

219
00:20:32,090 --> 00:20:35,140
!هذا هو ما أسمّيه غازي البحر

220
00:20:35,140 --> 00:20:37,430
!إنّه ملك البحر

221
00:20:38,330 --> 00:20:40,600
!ملك القراصنة

222
00:21:00,520 --> 00:21:03,170
،في يوم وصولنا للجزيرة الأخيرة

223
00:21:03,610 --> 00:21:06,800
.عرفنا كلّ شيء عن العالم

224
00:21:11,200 --> 00:21:13,890
ما هي حقيقة القرن الفارغ؟

225
00:21:13,890 --> 00:21:16,180
ومن هم حاملو الحرف "د"؟

226
00:21:16,180 --> 00:21:18,180
ما هي الأسلحة العتيقة؟

227
00:21:18,580 --> 00:21:23,200
.كانت بلاد وانو متّصلة ببقيّة العالم في الماضي

228
00:21:28,840 --> 00:21:33,050
،وأمام ذلك الكنز العظيم الّذي كان نصب أعيننا

229
00:21:34,720 --> 00:21:37,120
...كان روجر في تلك اللّحظة

230
00:21:38,890 --> 00:21:40,800
.يضحك

231
00:21:41,900 --> 00:21:43,960
.وكذلك كنّا نحن

232
00:21:43,960 --> 00:21:47,350
.ضحكنا بشدّة حتّى أدمعت عيوننا

233
00:22:00,890 --> 00:22:04,190
...جويبوي، إنّني

234
00:22:04,190 --> 00:22:07,860
أتمنّى لو كنتُ قد عشتُ في نفس
.العصر الّذي عشتَ فيه

235
00:22:09,840 --> 00:22:13,240
!كيف تركتَ هذا الكنز المذهل خلفك؟

236
00:22:13,760 --> 00:22:16,110
..."يا لها من "قصّة مضحكة

237
00:22:20,980 --> 00:22:22,580
...يا رفاق

238
00:22:24,040 --> 00:22:32,050
لِمَ لا نسمّي هذه الجزيرة الّتي لم تطأها قدم
...إنسان لثمانمائة سنة بشيء بذلك المعنى

239
00:22:42,270 --> 00:22:43,850
!مثل لافتيل

240
00:23:04,310 --> 00:23:09,630
،بينما تبدأ الحقبة الجديدة
.يغادر ملك القراصنة السّفينة وحده

241
00:23:09,630 --> 00:23:13,840
عزيمة رجل! أخذ أودن ذلك
،في قلبه وعقله إلى بلاده

242
00:23:13,840 --> 00:23:18,260
بلاد وانو، حيث الرّذيلة تزدهر
!ويعاني النّاس من طغيان أوروتشي

243
00:23:18,260 --> 00:23:22,360
.تنتظر الحقيقة الصّادمة أودن

244
00:23:22,360 --> 00:23:24,060
:في الحلقة القادمة من وان بيس

245
00:23:24,060 --> 00:23:27,690
"!إلى بلاد وانو! حلّ قراصنة روجر"

246
00:23:27,690 --> 00:23:30,150
!ملك القراصنة، لن يكون إلاّ أنا