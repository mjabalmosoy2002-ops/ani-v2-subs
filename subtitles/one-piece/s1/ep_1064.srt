1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:44,630 --> 00:01:49,430
فلنلوّنها بألواننا الخاصّة

19
00:01:58,510 --> 00:02:01,020
.التّوبي روبّو وكبار النّجوم

20
00:02:01,230 --> 00:02:06,150
تمكّنت قوّات التّحالف الّتي يقودها طاقم
.قبّعة القشّ من القضاء عليهم جميعًا

21
00:02:09,400 --> 00:02:15,040
!ولكن، هم الآن محاصرون من اليونكو المرعبين

22
00:02:16,870 --> 00:02:20,790
!أرياني ما في جعبتكما أيّها الشّقيّان من الجيل الأسوأ

23
00:02:23,420 --> 00:02:27,090
!لوفي ضدّ كايدو! تتسارع المعركة الحامية بينهما

24
00:02:28,500 --> 00:02:31,460
!"سئمت سماعك تقول "فاكهة المطّاط

25
00:02:31,460 --> 00:02:34,430
!مسدّس الرّخّ

26
00:03:05,960 --> 00:03:08,260
!بدأت أستمتع بوقتي

27
00:03:11,090 --> 00:03:12,720
!وأنا كذلك

28
00:03:14,920 --> 00:03:20,080
"!باغوا التّنّين الثّمل! يدنو التّنّين الجامح من لوفي"

29
00:04:00,300 --> 00:04:02,560
...كان الصّدام شديدًا جدًّا

30
00:04:02,930 --> 00:04:05,150
!حتّى أونيغاشيما تهتزّ

31
00:04:14,940 --> 00:04:16,910
!يمكنني النّجاح

32
00:04:17,530 --> 00:04:19,700
!أنا واثق من ذلك

33
00:04:20,660 --> 00:04:22,160
...أونيغاشيما

34
00:04:22,660 --> 00:04:26,960
!سأوقفك أنا كوزكي مومونوسكي بنفسي

35
00:05:09,910 --> 00:05:11,670
!كم هذا لذيذ

36
00:05:11,670 --> 00:05:14,670
!تريّث على نفسك. إنّك تشرب الكثير

37
00:05:14,670 --> 00:05:19,720
غبيّ! إنّه اليوم الوحيد من السّنة
!الّذي يتسنّى لنا فيه الشّرب

38
00:05:22,640 --> 00:05:24,140
.أنت على حقّ

39
00:05:24,140 --> 00:05:29,020
...عدا ذلك، الحياة في هذه البلاد مزرية

40
00:05:29,850 --> 00:05:31,320
!يا أوروتشي

41
00:05:31,320 --> 00:05:32,990
...أيّها السّفيه الـ

42
00:05:31,320 --> 00:05:33,690
!مهلاً! توقّف، توقّف

43
00:05:34,940 --> 00:05:37,240
...قد يكون الضّبّاط في أيّ مكان

44
00:05:37,530 --> 00:05:41,120
.لا داعي للقلق حيال أمر كهذا اليوم

45
00:05:41,490 --> 00:05:42,620
.انظرا

46
00:05:43,490 --> 00:05:48,710
...لقد بدؤوا يجهّزون قوارب السّماء
.سينتهي المهرجان قريبًا

47
00:05:54,420 --> 00:05:56,170
!هناك الكثير من القناديل

48
00:06:06,890 --> 00:06:11,440
.اكتب أمنيتك لأسلافك المتوفّون

49
00:06:11,680 --> 00:06:13,440
ما الّذي عليّ كتابته؟

50
00:06:13,940 --> 00:06:17,490
لماذا لا تكتبين أمنيتك أيضًا؟

51
00:06:18,320 --> 00:06:20,780
هل ستتحقّق أمنيتي؟

52
00:06:21,190 --> 00:06:22,400
.نعم

53
00:06:22,400 --> 00:06:27,000
سيجد أسلافك في السّماء قوارب
السّماء الطّافية هذه

54
00:06:27,280 --> 00:06:29,710
.وسيحقّقون أمنيتك

55
00:06:32,250 --> 00:06:34,250
هل سيقرؤها أبي؟

56
00:06:35,120 --> 00:06:37,090
.بالطّبع سيقرؤها

57
00:06:40,710 --> 00:06:42,470
...أمنيتي

58
00:06:43,010 --> 00:06:44,300
!وجدتها

59
00:06:44,300 --> 00:06:48,390
!أرغب في جعل النّاس يضحكون أكثر

60
00:06:48,390 --> 00:06:50,350
!يا لها من أمنية جيّدة

61
00:06:50,350 --> 00:06:54,060
!نعم! أريد أن أكون مثل أبي

62
00:06:54,060 --> 00:06:56,520
!شخص يزرع البهجة في قلوب الجميع

63
00:06:56,520 --> 00:07:02,400
.لذلك أريد أن أصير راقصة جيّدة مثل أبي

64
00:07:02,400 --> 00:07:03,990
...وأيضًا

65
00:07:31,720 --> 00:07:35,060
!كتبتُ أمنيتي

66
00:07:35,060 --> 00:07:36,520
...دعيني أراها

67
00:07:39,020 --> 00:07:41,980
،أريد أن أكون مثل أبي

68
00:07:41,980 --> 00:07:47,370
!لكنّني أريد رؤيته أكثر من أيّ شيء آخر

69
00:07:49,820 --> 00:07:54,250
سيعثر أبي على قارب السّماء خاصّتي، صحيح؟

70
00:07:54,540 --> 00:07:56,710
.وستتحقّق أمنيتي

71
00:08:01,960 --> 00:08:03,470
.أظنّ ذلك

72
00:08:04,510 --> 00:08:08,430
...واثق أنّ قارب السّماء خاصّتك سيلمع أكثر

73
00:08:08,430 --> 00:08:11,850
في نظر ياسويي-دونو أكثر
...من أيّ شيء آخر

74
00:08:33,780 --> 00:08:35,750
.يا لها من ليلة

75
00:08:37,120 --> 00:08:40,750
.القمر بدر في السّماء. والعدوّ على الأرض

76
00:08:41,040 --> 00:08:43,290
.كلاهما ممتاز

77
00:08:43,290 --> 00:08:46,430
.لا توجد ليالٍ كثيرة مثل هذه

78
00:08:52,050 --> 00:08:54,890
!لماذا تشرب السّاكي في وقت كهذا؟

79
00:08:57,270 --> 00:08:59,150
.لأنّني مستمتع بوقتي

80
00:08:59,520 --> 00:09:02,320
!تصرّف بجدّيّة! نحن لا نلهو هنا

81
00:09:03,610 --> 00:09:06,650
.يقام اليوم مهرجان النّار في العاصمة

82
00:09:06,650 --> 00:09:09,740
.كان يفترض بنا إقامة وليمة كبيرة على أونيغاشيما أيضًا

83
00:09:09,990 --> 00:09:13,450
...لكنّكم أفسدتم كلّ شيء

84
00:09:14,030 --> 00:09:15,790
أتريد الشّرب أيضًا؟

85
00:09:15,990 --> 00:09:17,880
!أنا لا أحبّ شرب السّاكي كثيرًا

86
00:09:18,200 --> 00:09:19,960
هل أنت طفل؟

87
00:09:20,540 --> 00:09:24,080
.لنقض وقتًا ممتازًا معًا

88
00:09:24,080 --> 00:09:26,250
.لن يكون ذلك معك أنت

89
00:09:26,250 --> 00:09:31,050
فبعد الإطاحة بك، سأقيم وليمة
!ضخمة مع الجميع

90
00:09:31,680 --> 00:09:34,100
!يبدو ذلك ممتعًا

91
00:09:35,850 --> 00:09:41,360
!آمل أن تستطيع إقامة تلك الوليمة الضّخمة

92
00:09:41,770 --> 00:09:44,110
.يبدو أنّك في مزاج جيّد

93
00:09:44,310 --> 00:09:46,490
!هل ثملت؟

94
00:09:47,780 --> 00:09:52,620
!وكأنّي سأثمل من ضرب هذا القدر القليل

95
00:09:54,280 --> 00:09:56,580
...لكنّ وليمتي الضّخمة

96
00:09:57,030 --> 00:10:02,000
!كيف تجرؤ على إفساد وليمتي؟

97
00:10:06,960 --> 00:10:08,880
!يا قبّعة القشّ

98
00:10:27,060 --> 00:10:29,240
!أنت ثمل بالفعل

99
00:10:34,400 --> 00:10:39,460
لماذا لا تسترخي إن كنت ستشرب؟

100
00:10:41,290 --> 00:10:43,090
!يا قبّعة القشّ

101
00:10:47,630 --> 00:10:49,880
!ما الّذي تفعله؟

102
00:10:53,920 --> 00:10:56,140
!هل يمكنك القتال هذا بالفعل؟

103
00:10:57,220 --> 00:11:00,850
حتّى إن خسرتَ، فإيّاك أن تستعمل
!"عذرًا مثل "لقد كنتُ ثملاً

104
00:11:05,650 --> 00:11:07,860
!أيّها الغبيّ

105
00:11:12,230 --> 00:11:16,540
لماذا قد أجعل نفسي أضعف؟

106
00:11:17,160 --> 00:11:19,710
!قبلتُ بك

107
00:11:21,160 --> 00:11:23,250
...فاكهة المطّاط

108
00:11:32,840 --> 00:11:35,550
!باغوا التّنّين الثّمل

109
00:11:36,680 --> 00:11:37,600
!ماذا؟

110
00:11:38,840 --> 00:11:41,230
!يا له من شعور

111
00:11:41,560 --> 00:11:48,610
متى كانت آخر مرّة قابلتُ فيها شخصًا
استطاع أن يجاريني رأسًا لرأس؟

112
00:12:01,160 --> 00:12:03,750
!مطرقة الرّعد الثّمل

113
00:12:05,700 --> 00:12:08,630
!راغناراكو

114
00:13:06,260 --> 00:13:10,610
...ما عاد هذا المكان مناسبًا للاستعمال

115
00:13:12,940 --> 00:13:15,240
...صارت الجزيرة حطامًا

116
00:13:15,610 --> 00:13:19,700
،الأمر ممتع، ولكن في نفس الوقت
.دُمّرت نصف القلعة

117
00:13:20,070 --> 00:13:24,910
...سُحقًا... لا يمكنني حتّى إنقاذ قلعتي

118
00:13:25,580 --> 00:13:27,580
...أعتقد أنّني الآن لستُ

119
00:13:28,330 --> 00:13:29,540
...لستُ

120
00:13:30,660 --> 00:13:32,840
...سيكون علينا إعادة بنائها

121
00:13:33,630 --> 00:13:38,090
!أخذ منّا بناء هذا خمسة أعوام

122
00:13:45,890 --> 00:13:47,480
!آلمني هذا

123
00:13:47,760 --> 00:13:49,520
!ذلك الوغد

124
00:13:49,810 --> 00:13:51,480
...سُحقًا

125
00:13:53,520 --> 00:13:55,400
!هل أنت ثمل بالفعل؟

126
00:13:59,030 --> 00:14:02,860
،بعت الكثير من الأسلحة في كلّ مكان

127
00:14:02,860 --> 00:14:07,000
حتّى أنّي شكّلت أقوى جيش في العالم
...بفضل السّمايل

128
00:14:07,530 --> 00:14:10,960
!بذلتُ ما بوسعي بالفعل

129
00:14:14,330 --> 00:14:18,340
!أرخيتُ دفاعي! يا لي من غبيّ

130
00:14:20,380 --> 00:14:24,060
...لكن ربّما ما عدت أستطيع فعل هذا

131
00:14:28,140 --> 00:14:30,970
...كنتُ أبذل قصارى جهدي بالفعل

132
00:14:30,970 --> 00:14:32,480
...لماذا

133
00:14:32,650 --> 00:14:34,850
!لماذا يحدث هذا لي؟

134
00:14:34,850 --> 00:14:37,110
...فاكهة المطّاط

135
00:14:39,730 --> 00:14:43,950
!أريد تدمير كلّ شيء

136
00:14:45,530 --> 00:14:48,960
!رياح إعصار التّنّين النّاسفة

137
00:15:06,720 --> 00:15:08,850
!إنّه يرمي بنفسه في الأرجاء كما يشاء

138
00:15:12,220 --> 00:15:17,150
!دعني وشأني

139
00:15:20,400 --> 00:15:21,820
!عمّ تتحدّث؟

140
00:15:21,820 --> 00:15:23,690
!يا للعار والنّدم

141
00:15:23,690 --> 00:15:28,120
...أنا هالك! أنا... أنا

142
00:15:43,380 --> 00:15:45,670
!دعني وشأني

143
00:15:45,670 --> 00:15:48,140
!أيّها الغبيّ

144
00:15:53,770 --> 00:15:55,610
!فات الأوان على الانتحاب

145
00:15:58,060 --> 00:16:01,610
!إن لم تتركني وشأني، فإليك هذه

146
00:16:03,900 --> 00:16:06,330
!سأسحقك لأشلاء

147
00:16:13,910 --> 00:16:17,630
!لماذا كلّ شيء مزعج؟

148
00:16:21,130 --> 00:16:25,880
...هرب ابني... حتّى أنّه هاجم والده

149
00:16:25,880 --> 00:16:30,310
!سُحقًا! لا شيء يسير كما يجب

150
00:16:31,800 --> 00:16:34,020
!هذا ظلم وبهتان

151
00:16:40,520 --> 00:16:42,440
...من الصّعب التّركيز هكذا

152
00:16:44,190 --> 00:16:45,990
...كلّ هذا

153
00:16:47,900 --> 00:16:50,120
!خطأك أنت

154
00:16:54,740 --> 00:16:55,870
!ماذا؟

155
00:17:19,230 --> 00:17:22,690
أليس من الممتع أن يعاني المرء
بسبب الموت والحياة؟

156
00:17:25,400 --> 00:17:27,740
!ارقص معي أكثر

157
00:17:35,740 --> 00:17:40,910
!كيف لك أن تتحدّاني مرّة تلو الأخرى؟

158
00:17:40,910 --> 00:17:46,380
!يا قبّعة القشّ! أعتقد أنّك تحبّني أكثر من اللاّزم

159
00:17:47,050 --> 00:17:49,050
...باغوا

160
00:17:49,630 --> 00:17:51,510
!الرّعد

161
00:18:00,230 --> 00:18:02,440
!خذ هذا أيّها الوغد الثّمل

162
00:18:40,850 --> 00:18:42,980
!صار الهاكي خاصّته أقوى

163
00:18:45,020 --> 00:18:47,400
...الثّمالة ممتعة

164
00:18:49,860 --> 00:18:52,910
!كفّ عن محاولة إيقاظي منها

165
00:19:07,040 --> 00:19:09,550
!كن خلاّقًا أكثر

166
00:19:09,550 --> 00:19:11,760
!لم يعد هذا ممتعًا

167
00:19:11,760 --> 00:19:13,850
!اجعل الأمر أكثر حماسة

168
00:19:24,180 --> 00:19:26,940
...فاكهة المطّاط

169
00:19:28,940 --> 00:19:30,820
...كوندالي

170
00:19:31,730 --> 00:19:34,290
!مدفع الرّخّ الرّشّاش

171
00:19:34,490 --> 00:19:37,290
!سرب التّنانين

172
00:20:41,890 --> 00:20:46,350
.كانت قمّة ليفيلي هذه السّنة ملعونة

173
00:20:46,770 --> 00:20:49,570
...القضاء التّامّ على نظام الشّيتشيبوكاي الملكيّين

174
00:20:50,230 --> 00:20:53,030
...الحادثة الّتي تتعلّق بمملكة ألاباستا

175
00:20:53,480 --> 00:20:56,740
...تسلّل الجيش الثّوريّ إلى ماريجوا

176
00:20:56,740 --> 00:20:59,200
.دعك من كلّ هذا الآن

177
00:21:00,740 --> 00:21:03,780
.ما علينا التّعامل معه الآن هي بلاد وانو

178
00:21:03,780 --> 00:21:08,120
من كان ليتخيّل أنّ المعركة ستصير حامية هكذا؟

179
00:21:08,120 --> 00:21:10,380
.علينا القيام بشيء ما

180
00:21:11,080 --> 00:21:14,340
.لا بدّ أنّهم أمسكوا بنيكو روبين الآن

181
00:21:15,000 --> 00:21:17,800
،في معركة ضدّ كايدو وبيغ مام

182
00:21:18,170 --> 00:21:20,890
.الموت نتيجة متوقّعة

183
00:21:21,180 --> 00:21:23,090
!يجب القضاء على هذا

184
00:21:23,090 --> 00:21:28,480
.والقضاء على فاكهة الشّيطان تلك أيضًا

185
00:21:35,480 --> 00:21:38,230
.كونوا على أهبة الاستعداد للقتال حتّى إشعار آخر

186
00:21:38,230 --> 00:21:40,580
.لتكن كلّ السّفن متأهّبة

187
00:22:03,260 --> 00:22:04,800
...عفوًا

188
00:22:04,800 --> 00:22:05,930
ماذا هنالك؟

189
00:22:06,600 --> 00:22:10,600
...في الحقيقة، أرى ظلاًّ ضخمًا أمامنا

190
00:22:10,600 --> 00:22:13,280
ظلّ؟ ما هو؟

191
00:22:14,060 --> 00:22:15,320
.لا أدري

192
00:22:16,690 --> 00:22:18,400
عمّ تتكلّم؟

193
00:22:18,980 --> 00:22:21,280
جـ-جزيرة؟

194
00:22:22,110 --> 00:22:24,200
!لا، ذلك مستحيل

195
00:22:24,200 --> 00:22:28,830
صارت تلك الفاكهة مجرّد أسطورة الآن
.حتّى في نظرنا نحن

196
00:22:31,080 --> 00:22:35,170
.لم تستيقظ منذ قرون

197
00:22:35,540 --> 00:22:37,920
...لماذا إذًا نجد حكومة العالم

198
00:22:37,920 --> 00:22:42,680
!تتكبّد عناء منح تلك الفاكهة اسمًا آخر؟

199
00:22:56,060 --> 00:23:00,150
.لإخفاء اسمها الحقيقيّ من التّاريخ

200
00:23:04,700 --> 00:23:08,280
.تتعرّض كلّ من كيد ولو لهجمات شاملة قويّة

201
00:23:08,280 --> 00:23:12,330
هل كموح الإطاحة بأحد اليونكو
!مجرّد خطا شباب فحسب؟

202
00:23:12,330 --> 00:23:15,830
سيكون عليهما دفع الثّمن بيأسهم
،لمجرّد الحلم بهزيمة اليونكو

203
00:23:15,830 --> 00:23:21,510
لكنّ قوّة مغناطيسيّة متمرّدة مُلحّة
!تستيقظ في روح وحش يرقد في كومة معادن

204
00:23:22,590 --> 00:23:24,010
:في الحلقة القادمة من وان بيس

205
00:23:24,010 --> 00:23:27,720
"!دمار التّحالف؟! اشتعلي يا إرادة الجيل الأسوأ"

206
00:23:27,720 --> 00:23:31,730
!ملك القراصنة، لن يكون إلاّ أنا