1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,520 --> 00:02:02,190
دفع أودن بنفسه لحدودها بهدف الإبحار
،على متن سفينة اللّحية البيضاء

29
00:02:02,190 --> 00:02:04,570
لكنّ البحر ابتلعه في آخر لحظة

30
00:02:04,570 --> 00:02:09,120
وانجرف نحو شاطئ جزيرة مجهولة
.حيث التقى بامرأة هناك

31
00:02:12,040 --> 00:02:14,000
!إنّه طفلنا أنا وتوكي

32
00:02:14,500 --> 00:02:16,710
...اسمٌ يعني لا مثيل له

33
00:02:18,380 --> 00:02:22,090
!اسمك هو كوزكي مومونوسكي

34
00:02:23,670 --> 00:02:27,390
...ساموراي من بلاد منغلقة

35
00:02:28,260 --> 00:02:30,180
!أتمنّى أن ألتقي به يومًا ما

36
00:02:33,730 --> 00:02:38,860
"!وتتصادم الأنصال! روجر واللّحية البيضاء"

37
00:02:49,490 --> 00:02:51,080
...سوكياكي-ساما

38
00:02:54,750 --> 00:02:56,410
!أخبار مهمّة

39
00:02:56,410 --> 00:03:01,170
!الشّوغن سوكياكي-ساما في وضع حرج

40
00:03:01,170 --> 00:03:02,510
!سوكياكي-ساما

41
00:03:02,510 --> 00:03:04,880
،في بلاد وانو

42
00:03:05,590 --> 00:03:12,140
حدثت واقعة خطيرة استدعت حضور
.الدّايميو من كلّ منطقة إلى عاصمة الزّهور

43
00:03:14,430 --> 00:03:19,770
.أريد أن يخلفني أودن كشوغن

44
00:03:19,770 --> 00:03:22,690
!بالطّبع يا سوكياكي-ساما

45
00:03:24,480 --> 00:03:28,260
،لكن بما أنّ أودن ليس هنا الآن

46
00:03:28,260 --> 00:03:33,910
،أحتاج لنائب حتّى عودة أودن

47
00:03:34,330 --> 00:03:37,330
.في حالة حدوث أيّ طارئ

48
00:03:38,500 --> 00:03:43,380
سيكون هذا الرّجل الّذي اعتنى به
...أودن وكأنّه أخوه الصّغير

49
00:03:43,380 --> 00:03:45,920
!اسمه كوروزومي أوروتشي

50
00:03:48,380 --> 00:03:50,180
!أوروتشي؟

51
00:03:50,760 --> 00:03:52,140
!لماذا أنت هنا؟

52
00:03:54,220 --> 00:03:58,160
!اعتنى به أودن وكأنّه أخوه الصّغير؟

53
00:03:58,160 --> 00:03:59,770
!فعلاً؟

54
00:04:07,610 --> 00:04:12,340
شكرًا لمنحك لي هذه الفرصة لتبرئة
!اسم عشيرة كوروزومي

55
00:04:12,340 --> 00:04:18,390
ما كنتُ لأستطيع أبدًا النّظر مباشرة
!إلى سوكياكي-ساما وأودن-ساما

56
00:04:18,390 --> 00:04:22,130
،ومن أجل التّكفير عن حماقة جدّي وأشياء أخرى

57
00:04:22,130 --> 00:04:28,380
سأساعد على تتويج أودن-ساما
!بكلّ ما أوتيت من قوّة

58
00:04:32,140 --> 00:04:37,660
،سأصبح دمية مؤقّتًا إلى حين عودة أودن-ساما

59
00:04:37,660 --> 00:04:41,730
!لذلك أطلب دعمكم جميعًا

60
00:04:46,650 --> 00:04:52,570
من المستحيل أن نعصي هذا القرار
.بما أنّه صادر من سوكياكي-ساما

61
00:04:54,030 --> 00:04:55,200
!يا سيّدي

62
00:04:57,870 --> 00:04:59,450
.أوروتشي

63
00:05:00,750 --> 00:05:02,500
...أنت من عشيرة كوروزومي إذًا

64
00:05:02,500 --> 00:05:04,460
لماذا لم تخبرني؟

65
00:05:04,460 --> 00:05:06,130
!أنا جدّ آسف

66
00:05:11,090 --> 00:05:13,260
...أنا آسف فعلاً

67
00:05:36,950 --> 00:05:39,370
!انتظر اللّعنة عليك

68
00:05:39,370 --> 00:05:41,290
!كوروزومي

69
00:05:42,120 --> 00:05:45,210
!كوروزومي! أين ذهبت؟

70
00:05:45,210 --> 00:05:48,290
!إنّه سريع عندما يهرب

71
00:05:51,130 --> 00:05:52,890
!ها هو ذا! كوروزومي

72
00:05:52,890 --> 00:05:53,650
!أمسكوه

73
00:05:53,680 --> 00:05:54,680
!مهلاً

74
00:05:56,720 --> 00:05:58,910
!تبًّا! تبًّا

75
00:05:58,910 --> 00:06:00,890
!تبًّا

76
00:06:03,270 --> 00:06:05,400
!أين أنت يا كوروزومي؟

77
00:06:05,400 --> 00:06:07,650
!يجب إبادة عشيرة كوروزومي

78
00:06:09,320 --> 00:06:10,650
!تبًّا

79
00:06:11,650 --> 00:06:13,740
!لا يمكننا السّماح له بالهرب

80
00:06:13,740 --> 00:06:16,740
!عشيرة كوروزومي آفة على بلاد وانو

81
00:06:16,740 --> 00:06:20,790
.واثق أنّه ما زال في الجوار
!علينا إيجاده وقتله

82
00:06:20,790 --> 00:06:21,920
!أجل

83
00:06:21,920 --> 00:06:24,790
!كوروزومي! جميعكم مجرمون يا هؤلاء

84
00:06:24,790 --> 00:06:27,050
!سنجعلكم تدفعون ثمن جرائمكم

85
00:06:27,050 --> 00:06:29,000
!اخرج إلينا

86
00:06:35,470 --> 00:06:41,890
لماذا عليّ أن أعيش هذا بسبب
!ما فعله جدّي الخرف ذاك؟

87
00:06:42,270 --> 00:06:46,560
لماذا كلّ هذا الكره تُجاهي فقط لأنّني كوروزومي؟

88
00:06:47,150 --> 00:06:48,250
!تبًّا

89
00:06:48,250 --> 00:06:50,900
!تبًّا! تبًّا

90
00:07:23,810 --> 00:07:26,810
!لقد أخفتني! ما-ماذا تريدين؟

91
00:07:32,190 --> 00:07:35,110
!بإمكاني رؤيته! بإمكاني رؤية المستقبل

92
00:07:36,030 --> 00:07:37,900
...سوف

93
00:07:42,870 --> 00:07:45,540
!تصير الشّوغن

94
00:07:51,080 --> 00:07:54,340
!لا تخيفيني يا جدّة! من تكونين؟

95
00:07:57,880 --> 00:08:02,140
ألا تعرف ما حلّ بجدّك؟

96
00:08:02,510 --> 00:08:06,690
.لا أعرف التّفاصيل، لكنّني سمعتُ أنّه نفّذ السّيبّوكو

97
00:08:06,690 --> 00:08:10,230
!كلاّ! بل قُتل على يد كوزكي

98
00:08:10,230 --> 00:08:13,440
!ماذا؟! لكنّني سمعتُ أنّه اقترف جريمة ما

99
00:08:13,440 --> 00:08:16,650
!الخوض في صراع سُلطة ليس جريمة

100
00:08:17,030 --> 00:08:19,280
صراع سُلطة؟

101
00:08:19,280 --> 00:08:22,930
،إن استوليت على زمام الحكم
.بإمكانك وضع القوانين

102
00:08:22,930 --> 00:08:25,660
!بإمكانك جعل أيّ جريمة شرعيّة

103
00:08:25,660 --> 00:08:32,580
لم يستطع الشّوغن السّابق
!من عشيرة كوزكي إنجاب أطفال

104
00:08:32,580 --> 00:08:34,670
!لم يكن له ورثة

105
00:08:35,000 --> 00:08:39,670
فباتت خمس عشائر خدمت تحت
...جناح عشيرة كوزكي غير مستقرّة

106
00:08:40,260 --> 00:08:42,320
من سيصير الشّوغن التّالي؟

107
00:08:42,320 --> 00:08:46,010
،"بينما كان الجميع يقولون "أنا

108
00:08:46,640 --> 00:08:50,940
!كان جدّك يقوم بالتّحضيرات

109
00:08:50,940 --> 00:08:56,320
كان يستعدّ لقتل أولئك الدّايميو
!المزعجين واحدًا تلو الآخر بالسّمّ

110
00:08:57,280 --> 00:09:01,880
تخلّص منهم واحدًا بعد الآخر
!وجعل الأمر يبدو وكأنّه نزاعات داخليّة

111
00:09:01,880 --> 00:09:05,850
،ونال التّوتّر من الشّوغن بسبب موت الدّايميو

112
00:09:05,850 --> 00:09:08,750
.وسقط طريح الفراش في النّهاية

113
00:09:09,000 --> 00:09:11,350
!مرّت الخطّة كما يجب

114
00:09:11,350 --> 00:09:17,090
وعندما كان يوشك أن يضع
...يديه على زمام الحكم

115
00:09:23,180 --> 00:09:26,030
!وُلد هو

116
00:09:26,030 --> 00:09:29,350
!الوريث كوزكي سوكياكي

117
00:09:30,480 --> 00:09:31,770
!نعم

118
00:09:31,850 --> 00:09:33,980
!الفرحة تغمرنا من أجلك

119
00:09:35,150 --> 00:09:39,070
!اللّعنة عليك يا سوكياكي

120
00:09:40,110 --> 00:09:42,670
!كانت السّلطة قاب قوسين منه

121
00:09:42,670 --> 00:09:46,840
لم تستطع عشيرة كوروزومي تولّي زمام
!الحكم وكُشفت المكيدة فوق ذلك أيضًا

122
00:09:46,840 --> 00:09:51,160
!نفّذ جدّك السّيبّوكو ووُضع حدّ للعشيرة

123
00:09:51,750 --> 00:09:55,020
.سُلبت منها أراضيها وقلعتها وسُلطتها

124
00:09:55,020 --> 00:09:57,730
صار النّاس يحتقرون اسم كوروزومي

125
00:09:57,730 --> 00:10:01,860
!وانتهى المطاف بأفراد العشيرة في الشّارع

126
00:10:01,860 --> 00:10:04,630
!كانت غلطة من في رأيك؟

127
00:10:05,970 --> 00:10:09,450
!من جعل حياتك بائسة لهذا الحدّ؟

128
00:10:09,450 --> 00:10:12,730
!من المسؤول عن فقرك؟

129
00:10:13,310 --> 00:10:15,690
!من المخطئ في كلّ هذا؟

130
00:10:20,020 --> 00:10:21,900
!كلّ هذا لأنّه وُلد

131
00:10:23,570 --> 00:10:25,360
!كوزكي سوكياكي

132
00:10:25,660 --> 00:10:27,430
!هذا صحيح

133
00:10:27,430 --> 00:10:32,330
!لو لم يولد، لكنت أصبحت الشّوغن يومًا ما

134
00:10:33,870 --> 00:10:39,280
!أيّها الشّوغن-ساما

135
00:10:35,980 --> 00:10:37,330
!أحبّك

136
00:10:39,280 --> 00:10:40,840
!أحبّك

137
00:10:40,840 --> 00:10:44,340
!أيّها الشّوغن-ساما

138
00:10:45,430 --> 00:10:46,550
!يا لحُسنهنّ

139
00:10:49,720 --> 00:10:52,350
!لكنتُ أصبحت الشّوغن؟

140
00:10:52,350 --> 00:10:54,160
!هذا صحيح

141
00:10:54,160 --> 00:10:57,230
!كم يثير هذا سخطي وانزعاجي

142
00:10:57,940 --> 00:11:04,410
...هل يُعقل أنّه تجمعك قرابة بي
!قرابة دماء عشيرة كوروزومي؟

143
00:11:04,410 --> 00:11:07,700
!لا يهمّ من أكون

144
00:11:08,160 --> 00:11:13,080
.كنتُ خارج البلاد طوال هذا الوقت
...كان الأمر صعبًا

145
00:11:13,080 --> 00:11:16,080
.انظر لوجهي

146
00:11:17,000 --> 00:11:17,920
!ماذا؟

147
00:11:22,800 --> 00:11:23,840
!ماذا؟

148
00:11:23,840 --> 00:11:25,840
!أهذا وجهي؟

149
00:11:28,890 --> 00:11:32,260
.إنّها قوّة فاكهة النّسخ

150
00:11:33,850 --> 00:11:39,850
سأعطيك قدرات خاصّة
.إن كنت ستقوم بما أمليه عليك

151
00:11:40,480 --> 00:11:43,230
!القوّة الّتي تحتاج لتصير الشّوغن

152
00:11:47,450 --> 00:11:48,570
...سأقوم بالأمر

153
00:11:49,700 --> 00:11:51,950
!سأقوم بأيّ شيء

154
00:11:56,160 --> 00:11:59,670
.ادّخر المال واصنع الأسلحة

155
00:11:59,670 --> 00:12:02,940
!مهارات حرفيّو بلاد وانو هي الأفضل

156
00:12:02,940 --> 00:12:07,840
!استعملها كطعم للظّفر بدعم شخص مهمّ

157
00:12:08,840 --> 00:12:09,880
!فهمت

158
00:12:58,560 --> 00:13:00,390
.اسمي أوروتشي

159
00:13:00,390 --> 00:13:03,120
،نال المرض على عائلتي بأكملها

160
00:13:03,120 --> 00:13:08,280
...وعليّ إطعامهم جميعًا بطريقة ما

161
00:13:09,110 --> 00:13:12,620
.أشعر بالأسى عليك. بإمكانك العمل هنا

162
00:13:12,620 --> 00:13:14,910
!شكرًا جزيلاً لك

163
00:13:20,910 --> 00:13:22,540
!ياسويي-ساما

164
00:13:22,540 --> 00:13:25,340
ماذا؟ اختفى أوروتشي؟

165
00:13:25,340 --> 00:13:26,650
.نعم

166
00:13:26,650 --> 00:13:32,680
،وأعتقد أنّ هذه صدفة فحسب
...لكنّ المال اختفى من الخزنة أيضًا

167
00:13:32,680 --> 00:13:34,050
ماذا؟

168
00:13:34,590 --> 00:13:37,010
!اختفى المال أيضًا؟

169
00:13:40,980 --> 00:13:43,610
...قابلتك في منزل ياسويي-سان

170
00:13:43,610 --> 00:13:46,400
.اسمي أوروتشي! نعم، نعم

171
00:13:47,150 --> 00:13:50,960
،ما هنالك هو أنّ مرض عائلتي قد ساء

172
00:13:50,960 --> 00:13:54,280
...وأحتاج للمال

173
00:13:55,160 --> 00:13:56,740
...هكذا إذًا

174
00:13:57,030 --> 00:14:02,250
،أنا أدين بالكثير لياسويي-ساما
...لا أستطيع اقتراض المال منه

175
00:14:02,250 --> 00:14:05,380
.نعم. فهمت. اعتمد عليّ

176
00:14:05,380 --> 00:14:06,450
!أودن-ساما؟

177
00:14:06,310 --> 00:14:07,670
!شكرًا لك

178
00:14:10,760 --> 00:14:12,340
!أعرني مالاً

179
00:14:12,340 --> 00:14:13,630
!ثانية؟

180
00:14:14,380 --> 00:14:16,060
!أعرني مالاً

181
00:14:16,060 --> 00:14:17,430
!ثانية؟

182
00:14:20,010 --> 00:14:22,200
!أعرني مالاً أرجوك

183
00:14:22,200 --> 00:14:25,310
!بإمكاني ردّ المال لك هذه المرّة بالتّأكيد

184
00:14:25,310 --> 00:14:27,110
!أتوسّل إليك

185
00:14:29,270 --> 00:14:31,000
!أودن-ساما

186
00:14:31,000 --> 00:14:35,580
!وضعنا الماليّ ليس على ما يرام أيضًا

187
00:14:35,580 --> 00:14:38,280
!قال أنّه سيردّ المال

188
00:14:47,210 --> 00:14:49,380
!أهذا كافٍ؟

189
00:14:49,380 --> 00:14:55,010
لا، ليس كافيًا بقدر ما نحتاج لصنع
!كمّيّات هائلة من الأسلحة

190
00:14:55,800 --> 00:14:58,590
...أعرف مكانًا فيه المزيد من المال

191
00:14:59,720 --> 00:15:02,680
...الهدف التّالي هو

192
00:15:12,360 --> 00:15:15,170
!أودن؟! لماذا أتيت فجأة؟

193
00:15:15,170 --> 00:15:16,780
.وبدون تابعين أيضًا

194
00:15:16,780 --> 00:15:19,160
.أتيت إلى هنا لأطلب خدمة منك

195
00:15:19,160 --> 00:15:21,800
!هل بإمكانك السّماح له بالبقاء هنا؟

196
00:15:21,800 --> 00:15:27,360
.إنّه عامل مُجدّ وبإمكانه تحضير الأدوية
.إنّه أشبه بأخ أصغر لي

197
00:15:27,360 --> 00:15:29,380
.اسمي أوروتشي

198
00:15:34,170 --> 00:15:37,630
!اهتمّوا جميعًا بأوروتشي

199
00:15:38,010 --> 00:15:39,760
!سمعًا وطاعة يا سيّدي

200
00:15:49,900 --> 00:15:52,500
!الشّوغن سوكياكي

201
00:15:52,500 --> 00:15:55,650
!وصلتُ أخيرًا إلى هذا الحدّ

202
00:16:08,000 --> 00:16:10,960
!سوكياكي-ساما! تمالك نفسك

203
00:16:10,960 --> 00:16:13,590
!سوكياكي-ساما

204
00:16:14,840 --> 00:16:17,910
...إن حدث طارئ ما لي

205
00:16:17,910 --> 00:16:19,720
!فأنا أعتمد عليك يا أوروتشي

206
00:16:22,390 --> 00:16:25,100
!نعم، بكلّ تأكيد

207
00:16:25,470 --> 00:16:27,580
.أنتما أيضًا

208
00:16:27,580 --> 00:16:30,320
.ادعما أوروتشي

209
00:16:30,320 --> 00:16:31,570
.حاضر

210
00:16:31,570 --> 00:16:32,690
!سوكياكي-ساما

211
00:16:32,690 --> 00:16:34,280
!سـ-سأحضر الطّبيب

212
00:16:34,280 --> 00:16:35,990
!سنعود في الحال

213
00:16:35,990 --> 00:16:37,690
!النّجدة! ليساعدنا أحد ما

214
00:16:37,690 --> 00:16:38,910
!أحضروا الطّبيب

215
00:16:38,910 --> 00:16:42,790
!سوكياكي-ساما! هل أنت بخير؟
!سوكياكي-ساما

216
00:16:42,790 --> 00:16:45,080
!اهتمّ بكلّ شيء يا أوروتشي

217
00:16:45,080 --> 00:16:49,000
!لا يجب أن تبدو ضعيفًا هكذا يا سوكياكي-ساما

218
00:16:57,460 --> 00:16:59,760
!ستصير الشّوغن

219
00:17:04,720 --> 00:17:06,780
،وبعد ذلك بوقت قصير

220
00:17:06,780 --> 00:17:12,400
انتشرت أخبار موت الشّوغن سوكياكي
.في كلّ أنحاء بلاد وانو

221
00:17:39,090 --> 00:17:43,300
...وذات يوم في السّنة الرّابعة من رحلة أودن

222
00:18:00,190 --> 00:18:01,820
!ماذا؟

223
00:18:02,900 --> 00:18:04,610
!ماذا يحدث؟

224
00:18:05,450 --> 00:18:08,080
!تتصرّف الأسماك بغرابة

225
00:18:08,490 --> 00:18:11,160
!أهذا نذير لكارثة طبيعيّة؟

226
00:18:14,920 --> 00:18:18,210
!إنّها تبتعد عن تلك الجزيرة أيّها اللّحية-كيتشي-تشان

227
00:18:18,210 --> 00:18:19,500
.نعم

228
00:18:19,880 --> 00:18:22,550
.ربّما يعيش هناك وحش من نوع ما

229
00:18:22,550 --> 00:18:24,680
!ماركو، تحقّق من الأمر

230
00:18:24,680 --> 00:18:27,140
!مستحيل! لا أريد إفساد المتعة

231
00:18:34,770 --> 00:18:38,360
!لا تقلقا يا هيوري ومومونوسكي
!هذا لا شيء

232
00:18:39,900 --> 00:18:42,280
هل نذهب للتّحقّق من الأمر يا والدي؟

233
00:18:43,320 --> 00:18:44,570
...بكلّ تأكيد

234
00:18:49,580 --> 00:18:50,910
!لنذهب للشّاطئ

235
00:18:50,910 --> 00:18:53,160
!أجل

236
00:19:07,840 --> 00:19:10,140
!ماذا؟ هذا غير ممكن

237
00:19:10,140 --> 00:19:13,140
أتهرب هذه الحيوانات المتوحّشة؟

238
00:19:13,770 --> 00:19:16,100
...لا بدّ أنّ شيئًا ما على تلك الجزيرة

239
00:19:21,940 --> 00:19:27,240
أحضروا غارب أو سِنغوكو إن كنتم
!تريدون الإمساك بي

240
00:19:28,240 --> 00:19:31,410
!قتالكم ليس ممتعًا بالمرّة

241
00:19:32,830 --> 00:19:34,080
!أيّها القبطان

242
00:19:34,540 --> 00:19:37,500
سفينة اللّحية البيضاء
!في الجانب الآخر من الجزيرة

243
00:19:37,500 --> 00:19:40,050
!يبدو أنّهم لاحظوا وجودنا

244
00:19:40,050 --> 00:19:43,300
.انتهينا من القتال للتّوّ يا روجر

245
00:19:44,130 --> 00:19:47,300
.اللّحية البيضاء؟ لم أره منذ مدّة

246
00:19:51,800 --> 00:19:55,060
!تبدو الطّيور مضطربة... لا بدّ أنّهم رسوا

247
00:19:55,480 --> 00:19:56,930
!حسنًا

248
00:19:56,930 --> 00:20:01,940
لنقم بهذا! نكون قادرين على
!القتال فقط ما دمنا أحياء

249
00:20:03,440 --> 00:20:06,010
!نهايتي قريبة

250
00:20:06,010 --> 00:20:11,240
!قد تكون هذه آخر مرّة أراك فيها أيّها اللّحية البيضاء

251
00:20:11,240 --> 00:20:14,510
!من هذا؟! إنّه يركض بسرعة هائلة

252
00:20:14,510 --> 00:20:15,870
!أهو ساموراي؟

253
00:20:15,870 --> 00:20:19,290
!ساموراي؟! أهو بعينه؟

254
00:20:21,420 --> 00:20:23,340
!الحقوا بي بسرعة

255
00:20:23,340 --> 00:20:25,590
!أيّها القائد أودن! انتظر

256
00:20:25,590 --> 00:20:27,800
!هل أنهب كنوزهم؟

257
00:20:27,800 --> 00:20:32,600
!هذا وضع مختلف تمامًا
!قراصنة روجر خطيرون جدًّا

258
00:20:33,350 --> 00:20:35,390
!إنّه لا يستمع لنا على الإطلاق

259
00:20:54,120 --> 00:20:56,740
!غان مودوكي

260
00:21:08,720 --> 00:21:13,140
.إنّه قويّ كما قيل عنه
هل نوقفه يا ريلي؟

261
00:21:13,140 --> 00:21:14,270
!بالتّأكيد

262
00:21:14,270 --> 00:21:17,100
!انتظرا يا غابان وريلي

263
00:21:17,100 --> 00:21:19,850
!لا أريدكما أن تتأذّيا

264
00:21:21,890 --> 00:21:23,480
.تريد قتاله فحسب

265
00:21:26,820 --> 00:21:28,860
!أشتمّ رائحة وحش

266
00:21:29,990 --> 00:21:31,740
!أيّها السّاموراي

267
00:21:34,280 --> 00:21:36,240
!الهلاك المقدّس

268
00:21:58,720 --> 00:22:01,600
!ما كان ذلك؟

269
00:22:05,190 --> 00:22:08,020
!سُحقًا! لن أدع ذلك يمرّ دون عقاب

270
00:22:19,160 --> 00:22:20,370
!ها هو قادم

271
00:22:49,480 --> 00:22:51,230
!لم يلمسا بعضهما حتّى

272
00:23:04,500 --> 00:23:08,840
رغبة روجر الجادّة! حُلمه بالوصول
!إلى آخر جزيرة في الغراند لاين

273
00:23:08,900 --> 00:23:15,010
المفتاح هو موروثُ البونيغليف
!الثّقافيّ المحرّم وكوزكي أودن

274
00:23:15,010 --> 00:23:21,890
وعلى درب القدر، يتّحد هذين العظيمين
!ويُبحران نحو مكان لم يطأه أحد من قبل

275
00:23:22,520 --> 00:23:24,140
:في الحلقة القادمة من وان بيس

276
00:23:24,170 --> 00:23:26,830
"!أمنية روجر! رحلة جديدة"

277
00:23:26,830 --> 00:23:30,440
!ملك القراصنة، لن يكون إلاّ أنا