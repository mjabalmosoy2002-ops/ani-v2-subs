1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,480 --> 00:02:00,570
!ماذا؟

29
00:02:07,320 --> 00:02:08,990
...إنّه

30
00:02:14,710 --> 00:02:19,420
!أ-أهو... حيّ؟

31
00:02:21,500 --> 00:02:23,800
!قُبض على أوشيميتسو كوزو؟! مستحيل

32
00:02:24,050 --> 00:02:25,970
.إنّها الحقيقة

33
00:02:26,010 --> 00:02:28,640
.انظري، ذلك مكتوب على هذا المنشور

34
00:02:28,680 --> 00:02:33,770
...سيتمّ إعدامه في العاصمة اليوم
.وقد اكتشفوا هويّته

35
00:02:34,230 --> 00:02:37,150
...أعتقد أنّه معروف في بلدة إبيسو

36
00:02:37,400 --> 00:02:38,810
!أقلت بلدة إبيسو؟

37
00:02:38,980 --> 00:02:42,320
...نعم. وقد كان اسمه

38
00:02:42,360 --> 00:02:44,690
...ياسو أو ما شابه

39
00:02:44,900 --> 00:02:45,780
!تونوياسو؟

40
00:02:57,830 --> 00:03:01,880
!أين تعتقدين نفسك ذاهبة؟
!حياتك في خطر

41
00:03:03,250 --> 00:03:04,840
!دعني أذهب

42
00:03:05,670 --> 00:03:06,630
!عليّ الذّهاب

43
00:03:06,800 --> 00:03:09,340
!مهلاً! تمالكي نفسك

44
00:03:09,550 --> 00:03:11,180
!دعني أذهب

45
00:03:12,140 --> 00:03:13,600
!ما الّذي يحدث؟

46
00:03:13,770 --> 00:03:14,680
!توكو

47
00:03:14,850 --> 00:03:17,310
!سيعدمونه

48
00:03:18,230 --> 00:03:20,100
!دعني أذهب

49
00:03:20,150 --> 00:03:22,440
!سيُقتل

50
00:03:22,480 --> 00:03:25,990
!إنّه أبي

51
00:03:35,120 --> 00:03:40,880
يبدو أنّ اليوم سيكون يومًا جميلاً
...في عاصمة الزّهور

52
00:03:41,670 --> 00:03:43,460
!أبي

53
00:03:56,520 --> 00:04:01,400
!اندفاع طاقم قبّعة القشّ"
".إنقاذ تونوياسو الأسير

54
00:04:10,070 --> 00:04:12,780
!كيف أمكن لهذا أن يحدث؟

55
00:04:13,320 --> 00:04:15,700
!كوموراساكي-ساما

56
00:04:20,540 --> 00:04:23,250
!قد أدفع أيّ شيء لقاء مشاهدتها ثانية

57
00:04:32,970 --> 00:04:35,680
...هذا ليس موكب الأويران الّذي أردت رؤيته

58
00:04:35,970 --> 00:04:38,890
!إلى أين تأخذونها؟

59
00:04:39,060 --> 00:04:44,610
لقد تمرّدت على أوروتشي-ساما. سنحرق
.جثّتها في معقل السّجناء في بلدة راستسو

60
00:04:47,070 --> 00:04:52,240
،بمجرّد وصولك يا أوروتشي-ساما
!سوف نعدمه كقربان

61
00:04:52,570 --> 00:04:54,820
!نعم، سأكون هناك قريبًا

62
00:04:57,290 --> 00:04:59,700
...إنّ سماع صراخه وهو يموت

63
00:04:59,750 --> 00:05:05,710
.سيشفي ألم فقدان كوموراساكي بعض الشّيء

64
00:05:06,090 --> 00:05:08,630
!اليوم يوم عظيم

65
00:05:25,730 --> 00:05:28,520
!أين كوموراساكي-تان؟

66
00:05:36,950 --> 00:05:39,700
.لا أراها في أيّ مكان

67
00:05:39,870 --> 00:05:41,950
.ما زالوا ينقلونها

68
00:05:44,580 --> 00:05:47,500
ما ذلك المكان على الشّاشة؟

69
00:05:47,750 --> 00:05:50,550
.إنّه معقل السّجناء في بلدة راستسو

70
00:05:50,590 --> 00:05:54,630
،يُحتجز العديد من المجرمين هناك
.رغم أنّهم ليسوا بالقدر الّذي هنا

71
00:07:22,050 --> 00:07:25,060
...هذا جميل

72
00:07:30,940 --> 00:07:36,860
..."ما كان الأودن أن يكون "أودن
!إن لم يتمّ غليه

73
00:07:53,920 --> 00:07:55,710
!قُبض على تونوياسو؟

74
00:07:55,880 --> 00:07:58,130
!ما الّذي يحدث؟

75
00:07:58,170 --> 00:08:01,550
!لا أصدّق أنّ تونوياسو-سان هو أوشيميتسو كوزو

76
00:08:02,300 --> 00:08:04,220
...أوشيميتسو كوزو

77
00:08:04,260 --> 00:08:07,520
،اللّصّ العظيم الّذي يسرق المال والأغراض من الأغنياء

78
00:08:07,890 --> 00:08:13,020
...ويمنحها للفقراء والضّعفاء كلّ ليلة

79
00:08:14,360 --> 00:08:15,940
لصّ؟

80
00:08:16,440 --> 00:08:18,030
ذلك العجوز؟

81
00:08:18,900 --> 00:08:20,860
...أوشيميتسو كوزو

82
00:08:20,910 --> 00:08:23,370
.سمعت أشخاصًا يتحدّثون عنه في عاصمة الزّهور

83
00:08:24,160 --> 00:08:27,790
ما الغاية من كلّ هذا؟
.ظننتُ أنّه كان قدّيسًا

84
00:08:42,840 --> 00:08:43,760
!تونوياسو-سان

85
00:08:48,020 --> 00:08:49,890
لماذا يضحك الجميع؟

86
00:08:50,020 --> 00:08:52,980
!يوشك صديقكم أن يُعدم

87
00:08:58,480 --> 00:09:01,490
هل تونوياسو-سان هو أوشيميتسو كوزو بالفعل؟

88
00:09:01,650 --> 00:09:05,910
،حتّى إن كان ذلك صحيحًا
.ذلك ليس الأمر المهمّ الآن

89
00:09:07,950 --> 00:09:11,290
...أنا أتذكّر! تلك التّسريحة

90
00:09:12,580 --> 00:09:15,330
.تونوياسو اسم مزيّف

91
00:09:16,340 --> 00:09:18,000
من يكون؟

92
00:09:19,960 --> 00:09:24,260
...يبدو أنّ أمرًا مثيرًا للاهتمام يحدث في عاصمة الزّهور

93
00:09:24,300 --> 00:09:26,260
!شغّلوا حلزون لفيفة الضّوء

94
00:09:30,060 --> 00:09:31,640
!لنبحث عن أشورا

95
00:09:38,440 --> 00:09:39,980
ما هذا؟

96
00:09:48,580 --> 00:09:50,910
...مستحيل... ذاك

97
00:09:55,290 --> 00:09:57,750
!إنّه حيّ

98
00:10:00,670 --> 00:10:02,210
هل تعرفه؟

99
00:10:03,420 --> 00:10:05,510
.نعم، أعرفه تمام المعرفة

100
00:10:08,010 --> 00:10:09,430
...ذلك المحترم

101
00:10:10,140 --> 00:10:15,850
اعتاد أن يكون أحد الدّايميو الّذين خدموا
...تحت رعاية عشيرة كوزكي رفقة أودن-ساما

102
00:10:18,440 --> 00:10:20,690
...اسمه هو

103
00:10:21,190 --> 00:10:23,280
...شيموتسكي

104
00:10:32,660 --> 00:10:36,250
!ياسويي-دونو

105
00:10:42,050 --> 00:10:45,880
!دايميو هاكوماي! ياسو القنفذ

106
00:10:47,090 --> 00:10:52,310
!كان متزمّتًا للغاية ولم يبتسم يومًا

107
00:10:54,980 --> 00:10:58,730
!لم أدرك الأمر لأنّه لا يشبه ما كان عليه في الماضي

108
00:10:58,900 --> 00:11:00,150
!أوقفوا الإعدام

109
00:11:00,310 --> 00:11:02,360
!أنا من هاكوماي

110
00:11:02,360 --> 00:11:03,650
...سعدتُ لرؤيتك ثانية

111
00:11:03,780 --> 00:11:06,490
!فكّوا وثاقه، الويل لكم

112
00:11:06,650 --> 00:11:08,530
!ياسويي-ساما

113
00:11:14,750 --> 00:11:17,710
لم ينسني النّاس بعد؟

114
00:11:18,870 --> 00:11:21,590
.يسعدني هذا كثيرًا

115
00:11:30,430 --> 00:11:37,310
هاكوماي هذه هي المنطقة الوحيدة
.في بلاد وانو الّتي تضمّ ميناء قانونيًّا

116
00:11:38,690 --> 00:11:42,270
،يتمنّى لنا بعض الزّوّار الخير
.والبعض الآخر يتمنّى الشّرّ

117
00:11:43,020 --> 00:11:44,400
...لهذا السّبب

118
00:11:47,070 --> 00:11:51,030
.علينا أن نكون جيشًا منيعًا

119
00:11:59,580 --> 00:12:03,250
...إنّهم بكلّ تأكيد السّاموراي الأقوى في بلاد وانو

120
00:12:11,010 --> 00:12:11,970
أتريد القليل؟

121
00:12:12,470 --> 00:12:16,180
.كفاك عبثًا يا أودن

122
00:12:20,100 --> 00:12:26,150
إلى متى ستواصل التّسكّع في منزلي؟
!أنت ابن الشّوغن

123
00:12:27,440 --> 00:12:32,870
.طُردتُ من القلعة. لا أدري إن ما زال هنالك رابط دمويّ

124
00:12:34,240 --> 00:12:36,080
...يقول الجميع

125
00:12:36,950 --> 00:12:40,830
...أنّ أودن لن يكون وريث كوزكي سوكياكي

126
00:12:43,750 --> 00:12:45,800
.سيصبح ياسويي هو الشّوغن

127
00:12:51,380 --> 00:12:52,680
!أيّها الغبيّ

128
00:12:53,050 --> 00:12:54,350
!هذا مؤلم

129
00:12:59,100 --> 00:13:00,600
!ما الّذي تفعله؟

130
00:13:00,770 --> 00:13:03,310
.لا تأخذ كلامًا فارغًا كهذا محمل الجدّ

131
00:13:03,940 --> 00:13:08,230
!أنت الخليفة الحقيقيّة لعشيرة كوزكي

132
00:13:08,280 --> 00:13:12,570
!طردك سوكياكي-ساما لأنّه يحبّك

133
00:13:12,610 --> 00:13:15,280
.حاول أن ترتقي لتطلّعاته

134
00:13:19,580 --> 00:13:21,290
.ياسو-سان

135
00:13:21,870 --> 00:13:26,790
!أفضّل خوض غمار البحر

136
00:13:29,590 --> 00:13:32,800
لماذا لا تسمح هذه البلاد بذلك؟

137
00:13:33,970 --> 00:13:38,060
!إنّ سياسة العزلة مزعجة لا غير

138
00:13:43,350 --> 00:13:44,190
!اخرس

139
00:13:46,980 --> 00:13:50,480
.قل ما يحلو لك بعد أن تصير ساموراي حقيقيًّا

140
00:13:59,740 --> 00:14:03,040
.أنت تؤذيني! كيف تجرؤ على مواصلة لكمي

141
00:14:03,080 --> 00:14:05,170
من تظنّني في رأيك؟

142
00:14:05,540 --> 00:14:09,880
.ما زلت نكرة... مجرّد صعلوك

143
00:14:16,300 --> 00:14:18,850
!ياسويي-ساما

144
00:14:40,870 --> 00:14:45,710
!لا فائدة يا رفاق! لن يتركني أوروتشي

145
00:14:48,790 --> 00:14:52,340
!أوّلاً، أريد الاعتذار للجميع بشأن أمرين

146
00:14:52,710 --> 00:14:56,010
!ثمّ أريد قول أمر واحد لأوروتشي الغبيّ

147
00:15:24,540 --> 00:15:26,580
!توكو

148
00:15:28,170 --> 00:15:33,550
،بعد قولي لهذه الأمور
.أستطيع مغادرة هذه المملكة ضاحكًا

149
00:15:49,020 --> 00:15:51,560
!أبي

150
00:16:07,040 --> 00:16:09,370
!ياسويي-ساما

151
00:16:18,050 --> 00:16:20,260
.ستكون الطّلقة التّالية قاتلة

152
00:16:24,220 --> 00:16:28,640
.سأقرأ التّهم الموجّهة للمتّهم

153
00:16:31,310 --> 00:16:35,940
.ليلة البارحة، ارتكب جريمة سرقة في عاصمة الزّهور

154
00:16:36,440 --> 00:16:38,190
.لقد هوى بشكل مروّع

155
00:16:38,240 --> 00:16:44,370
إنّه الدّايميو السّابق لهاكوماي
!الّذي يجني قوت يومه كغيشا رجل

156
00:16:44,660 --> 00:16:47,830
!اسمه شيموتسكي ياسويي

157
00:16:48,120 --> 00:16:54,750
ولقاء جريمة التّمرّد الفظيعة ضدّ
،الشّوغن أوروتشي-ساما في الماضي

158
00:16:54,790 --> 00:16:58,010
،وكقربان لقبر الأويران كوموراساكي

159
00:16:58,920 --> 00:17:02,010
.نحكم عليه بموتٍ مخزٍ

160
00:17:07,430 --> 00:17:10,140
،والآن، حسب شهادته

161
00:17:10,180 --> 00:17:15,940
...فإنّه كان أوشيميتسو كوزو الّذي سبّب المتاعب للعامّة

162
00:17:16,110 --> 00:17:17,360
.هذه كذبة

163
00:17:19,690 --> 00:17:21,990
ما الّذي قلته للتّوّ؟

164
00:17:22,200 --> 00:17:26,830
قلتُ ذلك لأنّني أردت الحصول على كلّ
!الانتباه إن متّ في كلّ الأحوال

165
00:17:28,700 --> 00:17:31,370
.أنا آسف لأنّني كذبت

166
00:17:31,410 --> 00:17:33,500
!لستُ ذلك البطل

167
00:17:34,710 --> 00:17:36,500
...ياسويي-دونو

168
00:17:38,460 --> 00:17:40,420
لماذا قال كذبة كهذه؟

169
00:17:41,220 --> 00:17:47,260
إنّ الحزن الصّادر من جنازة كوموراساكي
.قد توجّه إلى إعدام ياسويي

170
00:17:51,180 --> 00:17:56,610
دريك-سان! إنّ سكّان بلدة إبيسو
.يتوافدون إلى عاصمة الزّهور

171
00:17:57,020 --> 00:17:57,860
!ماذا؟

172
00:18:02,820 --> 00:18:08,080
.أعتقد أنّه شخصيّة أكبر ممّا تخيّلنا

173
00:18:12,160 --> 00:18:15,460
!ياسو-سان، لا تمت

174
00:18:15,920 --> 00:18:18,040
!ياسو-سان

175
00:18:18,500 --> 00:18:22,840
!إن فقدناك، فمن سيدعمنا غيرك؟

176
00:18:23,010 --> 00:18:28,300
!لا تدخلوا هذه البلدة بدون إذن
!عودوا إلى بلدة إبيسو أيّها المتسوّلون

177
00:18:29,390 --> 00:18:31,600
!ياسو-سان

178
00:18:50,330 --> 00:18:54,080
لن تجذب هذه الأفعال الصّغيرة
.انتباه قراصنة مملكة الحيوان

179
00:19:15,930 --> 00:19:18,350
!ياسو-سان، تماسك

180
00:19:23,360 --> 00:19:26,070
!إنّ السّكّان في الشّارع الرّئيسيّ غاضبون

181
00:19:26,240 --> 00:19:27,860
!وفي الحيّ الغربيّ أيضًا

182
00:19:28,950 --> 00:19:30,530
!المشاكل تتوالى

183
00:19:33,200 --> 00:19:40,960
قرار أوروتشي-ساما ببثّ الإعدام
.في لفائف الضّوء عاد بالسّوء علينا

184
00:19:41,000 --> 00:19:43,210
.راقبوا المناطق الأخرى أيضًا

185
00:19:45,210 --> 00:19:50,840
،الشّوغن-دونو مجرّد غبيّ
!أشعر بالأسى على أتباعه

186
00:19:51,510 --> 00:19:54,060
!اسمعوا جميعًا

187
00:20:04,900 --> 00:20:09,070
!انظروا إلى عاصمة الزّهور الجميلة

188
00:20:15,700 --> 00:20:19,410
!إنّ منظر بلاد وانو هذا لا نظير له

189
00:20:41,600 --> 00:20:47,860
ولأجيال عدّة، تطوّر هذا المشهد
.على يد عشيرة كوزكي وعامّة الشّعب

190
00:20:47,900 --> 00:20:49,740
.إنّنا فخورون جدًّا به

191
00:20:51,030 --> 00:20:52,320
!أسرعوا

192
00:20:52,610 --> 00:20:54,950
!أسرعوا أكثر

193
00:20:54,990 --> 00:20:57,700
!بدأ يتحدّث بالهراء

194
00:21:01,160 --> 00:21:04,460
!لا يمكنك نسب فضل ذلك لنفسك أيّها الغبيّ

195
00:21:11,630 --> 00:21:13,680
!كوروزومي أوروتشي

196
00:21:29,940 --> 00:21:32,280
!هل تسمعني يا أوروتشي؟

197
00:21:32,820 --> 00:21:37,030
.كانت هنالك غابات شاسعة وسهول خضراء

198
00:21:39,200 --> 00:21:40,790
!أنهار

199
00:21:41,370 --> 00:21:43,120
!قرى

200
00:21:43,170 --> 00:21:47,630
!وكلّ ما فعلته هو تلويثها بتراب الجشع

201
00:21:48,550 --> 00:21:51,840
!ما أنت إلاّ آفة

202
00:21:53,680 --> 00:21:56,300
!ذلك الوغد

203
00:22:05,560 --> 00:22:07,610
...ياسويي-دونو

204
00:22:13,490 --> 00:22:14,950
.هذا مثير للإعجاب

205
00:22:21,040 --> 00:22:21,830
.أيّها العجوز

206
00:22:50,400 --> 00:22:55,280
!أبي

207
00:23:04,370 --> 00:23:09,000
،يموت تونوياسو راسمًا الابتسامة على محيّاه
!عاهدًا مستقبل بلاد وانو لقراصنة قبّعة القشّ

208
00:23:09,500 --> 00:23:16,090
يغرق سكّان بلدة إبيسو في الحزن، بينما
!زورو يراهم يضحكون بشكل هستيريّ

209
00:23:17,010 --> 00:23:21,890
وعندما يعرف الحقيقة خلف
!ابتساماتهم، يعتريه الغضب بالكامل

210
00:23:22,310 --> 00:23:23,640
:في الحلقة القادمة من وان بيس

211
00:23:23,640 --> 00:23:26,520
"!غضب زورو! الحقيقة وراء سمايل"

212
00:23:26,520 --> 00:23:29,060
!ملك القراصنة، لن يكون إلاّ أنا