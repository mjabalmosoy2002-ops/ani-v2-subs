1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:00,150 --> 00:02:04,610
"!العهد بين الرّجال! قتال دبّابة براكيو الضّاري"

29
00:02:15,790 --> 00:02:19,040
!بيغ مام؟! لماذا هي هنا؟

30
00:02:22,920 --> 00:02:25,090
!كلاّ! كلاّ! ستأكلني

31
00:02:28,050 --> 00:02:29,430
...كلاّ! كلاّ

32
00:02:29,430 --> 00:02:32,850
!يا قائد الدّبّابة تشوبّر! يا قائد الدّبّابة تشوبّر

33
00:02:33,220 --> 00:02:37,580
،بما أنّنا متنكّرون بهيئة طاقم قراصنة مملكة الحيوان

34
00:02:37,580 --> 00:02:40,860
!أنا واثق أنّها ستظنّنا حلفاءها

35
00:02:40,860 --> 00:02:41,980
!ماذا؟

36
00:02:41,980 --> 00:02:44,030
!حـ-حسنًا

37
00:02:44,030 --> 00:02:47,950
!نسيت أنّنا متنكّرون على هيئة العدوّ

38
00:02:48,160 --> 00:02:50,290
!حسنًا، لنقم بهذا

39
00:02:50,570 --> 00:02:55,290
!لديّ تقرير! هذا قائد الدّبّابة تشوبّر

40
00:02:55,290 --> 00:02:59,210
!لقد قدّم نفسه كتشوبّر للتّوّ

41
00:02:59,210 --> 00:03:03,340
!أنا من حرّاس أمن الوليمة

42
00:03:08,840 --> 00:03:12,350
.أنت في دوريّة إذًا

43
00:03:13,010 --> 00:03:15,890
!لقد صدّقته

44
00:03:19,480 --> 00:03:21,860
!كان ذلك وشيكًا

45
00:03:22,440 --> 00:03:26,820
...يبدو مألوفًا جدًّا

46
00:03:30,990 --> 00:03:32,370
!إنّه هو

47
00:03:33,030 --> 00:03:34,040
!مهلاً

48
00:03:35,990 --> 00:03:39,540
!أنت هو التّانوكي من طاقة قبّعة القشّ

49
00:03:39,540 --> 00:03:43,340
!أيّها السّائق أوسوبّ! تراجع بأقصى سرعة
!تراجع بأقصى سرعة

50
00:03:43,340 --> 00:03:44,590
!عُلم

51
00:03:48,970 --> 00:03:51,510
!لن أسمح لكما بالهرب

52
00:03:51,510 --> 00:03:53,300
!عرفتُ أنّ ذلك لن ينفع

53
00:03:53,300 --> 00:03:54,850
!بالطّبع لا

54
00:03:54,850 --> 00:03:57,890
!أيّها التّانوكي

55
00:03:57,890 --> 00:03:59,730
!تراجع بأقصى سرعة

56
00:04:03,690 --> 00:04:05,060
!لقد اختفوا

57
00:04:05,060 --> 00:04:06,860
!أخي تشو

58
00:04:06,860 --> 00:04:08,490
...يا لها من امرأة شرسة

59
00:04:10,650 --> 00:04:12,620
!حظًّا سعيدًا

60
00:04:21,660 --> 00:04:27,260
في الطّريق إلى هنا، قطع الحبال
!وحاول الهرب، لذلك أفقدته وعيه

61
00:04:27,260 --> 00:04:30,010
!لا تقلق، ما زال حيًّا

62
00:04:35,430 --> 00:04:39,980
كيف أمكنك فعل ذلك لوريث كوزكي
الّذي كان سيّدك في الماضي...؟

63
00:04:40,600 --> 00:04:43,730
!لديك قلب بارد ومن حجر

64
00:04:44,310 --> 00:04:48,190
انتهيت من لعب الدّور، لذلك
.فهو الآن مجرّد شقيّ لا أعرفه

65
00:04:48,900 --> 00:04:52,660
.لقد تفاجأت! أتذكّر ذلك بالفعل

66
00:04:52,990 --> 00:04:59,160
أنت واحد من الأكازايا التّسعة
.الّذين واجهتهم قبل 20 سنة

67
00:05:02,500 --> 00:05:06,380
.نعم... أتذكّرك جيّدًا أيضًا

68
00:05:06,580 --> 00:05:13,180
خاب ظنّي عندما سمعت أنّك ابن أودن الشّجاع
!ذاك من 20 سنة مضت ولم تتغيّر قطّ

69
00:05:16,260 --> 00:05:19,220
!نعم، إنّه مجرّد شقيّ قذر الآن

70
00:05:19,220 --> 00:05:22,390
...كلّ ما يميّزه هو سلالته العظيمة

71
00:05:33,440 --> 00:05:35,950
!فتى مسكين

72
00:05:36,860 --> 00:05:40,700
كيف أمكنك لكم صبيّ مثله حتّى أدميتَه؟

73
00:05:47,960 --> 00:05:52,150
!أبليتَ حسنًا بقيامك بدور الجاسوس لوقت طويل

74
00:05:52,150 --> 00:05:53,930
!أحسنت عملاً

75
00:05:53,930 --> 00:05:55,800
!لا يا أوروتشي-ساما

76
00:05:55,800 --> 00:05:58,620
...بل فشلت في اعتراض خطّة الأكازايا

77
00:05:58,620 --> 00:06:05,520
بسبب هجوم طاقم قبّعة القشّ
!وبقيّة طواقم القراصنة المفاجئ

78
00:06:05,520 --> 00:06:07,440
!ماذا؟! فشلت؟

79
00:06:07,440 --> 00:06:14,410
،قوّات المتمرّدين، 5400 محاربًا
!يتقدّمون الآن نحو أونيغاشيما

80
00:06:14,990 --> 00:06:16,410
!لوفي؟

81
00:06:16,410 --> 00:06:19,200
هـ-هل ما زالوا أحياء؟

82
00:06:19,200 --> 00:06:24,750
!أ-أي أنّك تقول أنّ الـ-الأكازايا ما زالوا موجودين؟

83
00:06:26,000 --> 00:06:28,170
!سُحقًا لك

84
00:06:28,170 --> 00:06:31,380
!فشلت في اعتراض خطّتهم؟

85
00:06:31,380 --> 00:06:33,850
!أنا جدّ آسف

86
00:06:33,850 --> 00:06:39,510
!أنت من أخبرني أنّهم سيلتقون في ميناء توكاغي

87
00:06:39,510 --> 00:06:41,720
!لماذا لم تقضِ عليهم؟

88
00:06:41,720 --> 00:06:44,810
!كـ-كان كينييمون أمكر منّي

89
00:06:46,100 --> 00:06:48,920
،عرفته لوقت طويل

90
00:06:48,920 --> 00:06:52,110
!لكن لم أكن أعرف أنّه مُخطِّط جيّد لتلك الدّرجة

91
00:06:52,110 --> 00:06:54,570
!لا تقدّم أعذارًا

92
00:06:54,570 --> 00:06:56,840
!أخبرني يا كانجورو

93
00:06:56,840 --> 00:07:01,030
!هل سيأتي أسطول السّاموراي لأونيغاشيما؟

94
00:07:01,030 --> 00:07:04,160
.يبدو أنّ الوضع ما زال آمنًا هنا يا أوروتشي-ساما

95
00:07:04,490 --> 00:07:05,790
!فوكوروكوجو

96
00:07:06,240 --> 00:07:09,830
.لا توجد سفن مثيرة للشّبهة في الميناء

97
00:07:10,080 --> 00:07:15,470
.ولكن، لم تعد ثلاث من سفننا الحربيّة

98
00:07:15,920 --> 00:07:17,720
...أنا

99
00:07:17,720 --> 00:07:22,850
.رأيت سفينتين منها تغرقان على يد القراصنة اللّعناء

100
00:07:31,230 --> 00:07:36,400
في تلك الحالة، من المنطقيّ افتراض
.أنّ السّفينة الأخرى غرقت أيضًا

101
00:07:36,400 --> 00:07:42,240
في الحقيقة، تأكّدنا من وجود أربعة
.قراصنة على ساحة العرض

102
00:07:44,780 --> 00:07:47,080
.قبّعة القشّ لوفي

103
00:07:49,660 --> 00:07:51,960
.صائد القراصنة زورو

104
00:07:54,090 --> 00:07:56,760
.يوستاس "كابتن" كيد

105
00:07:59,090 --> 00:08:01,590
.جنديّ المجازر" كيلر"

106
00:08:01,590 --> 00:08:06,850
على الأرجح أنّ أعضاءً من طاقميهم
.قد تسلّلوا للجزيرة أيضًا

107
00:08:06,850 --> 00:08:09,730
!إن كنت تعرف ذلك، لماذا لم تبلّغني به؟

108
00:08:09,730 --> 00:08:12,980
،كان كوين-دونو يتولّى الأمر

109
00:08:12,980 --> 00:08:17,440
...لذلك فكّرتُ أنّه ما من داع لإفساد الوليمة

110
00:08:17,440 --> 00:08:23,700
سواء كانوا هنا أم لا، فكلّ قوّاتنا
.موجودة على أونيغاشيما

111
00:08:24,150 --> 00:08:29,250
!مهما حدث، يظلّ هذا أكثر الأماكن أمنًا في البلاد

112
00:08:31,290 --> 00:08:33,440
!أنت على حقّ

113
00:08:33,440 --> 00:08:35,290
!اشرب يا أوروتشي

114
00:08:35,290 --> 00:08:38,340
.خذ! تفضّل بالشّرب

115
00:08:39,550 --> 00:08:41,470
...حـ... حسنًا

116
00:08:44,010 --> 00:08:48,430
!لا... لا أريد لأيّ أحد أن يواسيني

117
00:08:48,800 --> 00:08:52,810
أفضّل سماع تقرير عن مقتل
!أولئك السّاموراي الملاعين

118
00:08:54,690 --> 00:08:57,420
!أنا واثق أنّ كلّ شيء سيكون بخير

119
00:08:57,420 --> 00:09:00,780
!لا بدّ أنّ الجميع على أونيغاشيما الآن

120
00:09:00,980 --> 00:09:04,530
!لأنّ لوفي على هذه الجزيرة

121
00:09:04,530 --> 00:09:06,780
!انجُ كيفما تستطيع

122
00:09:06,780 --> 00:09:11,380
!سآتي لإنقاذك

123
00:09:13,290 --> 00:09:16,320
!عليّ الهرب

124
00:09:16,320 --> 00:09:18,530
...عليّ النّجاة

125
00:09:18,530 --> 00:09:20,720
!مهما كلّف الأمر

126
00:09:21,880 --> 00:09:23,510
!بلاك ماريا

127
00:09:23,510 --> 00:09:25,300
!أعطني إيّاه

128
00:09:25,300 --> 00:09:31,400
!هذا صحيح! لا يجب أن ننسى
!إنّه قائد العدوّ

129
00:09:32,720 --> 00:09:36,020
!جهّزوا منصّة الإعدام

130
00:09:36,020 --> 00:09:42,570
،إن انتهى نسل عائلة كوزكي البارزة
!فإنّ ولاءهم المتعفّن سينهار أيضًا

131
00:09:42,570 --> 00:09:45,160
!وسينتهي الأمر

132
00:09:48,490 --> 00:09:50,540
...لوفي

133
00:09:50,740 --> 00:09:52,880
...رفاق

134
00:09:53,160 --> 00:09:55,170
...أبتاه

135
00:10:01,790 --> 00:10:04,010
هل جميعهم بخير؟

136
00:10:04,300 --> 00:10:06,680
!نعم، بالطّبع هم بخير

137
00:10:07,930 --> 00:10:09,090
!إيزو

138
00:10:09,090 --> 00:10:11,180
.شكرًا على كلّ شيء يا نيكو

139
00:10:11,180 --> 00:10:16,730
قال أنّ الجميع قد نزلوا على الجزيرة
!سلفًا، لذلك أظنّ أنّ الغارة قائمة

140
00:10:17,230 --> 00:10:21,360
تلك الجزيرة الوحيدة تُدعى أونيغاشيما الآن؟

141
00:10:22,770 --> 00:10:23,820
...كيكو

142
00:10:23,820 --> 00:10:28,220
،على أيّ حال، غادرتَ قبلي
.لكنّنا وصلنا في نفس الوقت

143
00:10:28,220 --> 00:10:32,370
لم أكن بحاجة لأعهد لك برسالتي
!إلى قبّعة القشّ لوفي-يوي

144
00:10:34,290 --> 00:10:37,710
!أنت على حقّ! سأرمي هذه الرّسالة إذًا

145
00:10:44,500 --> 00:10:46,550
قلتَ أنّك ستذهب إلى بلاد وانو؟

146
00:10:46,550 --> 00:10:47,380
.نعم

147
00:10:47,380 --> 00:10:50,430
ما الّذي تنوي فعله هناك؟

148
00:10:52,970 --> 00:10:55,640
!سنطيح بكايدو

149
00:10:55,640 --> 00:10:59,250
!سنقوم بذلك! سنثأر لأودن-ساما

150
00:10:59,250 --> 00:11:02,360
!سيساعدنا طاقم قبّعة القشّ أيضًا

151
00:11:03,060 --> 00:11:04,570
...حسنًا

152
00:11:04,570 --> 00:11:07,950
.لديّ سبب إضافيّ إذًا لأذهب معك

153
00:11:08,660 --> 00:11:12,160
.على أيّ حال، لا أصدّق أنّك أتيت يا ماركو

154
00:11:12,160 --> 00:11:15,580
...صحيح، لطالما أحببت أودن

155
00:11:19,370 --> 00:11:23,800
إنّه موطن صديقي الّذي خاطر بحياته
لإنقاذه. فأنّى لي ألاّ أساعد؟

156
00:11:23,800 --> 00:11:26,470
.شكرًا لك. أنا مدين لك

157
00:11:26,470 --> 00:11:29,210
.لا عليك. وجب أن أقوم بشيء ما أبكر

158
00:11:29,210 --> 00:11:35,010
...لا أصدّق كم أنّ بلاد أودن قد تغيّرت

159
00:11:35,010 --> 00:11:37,830
.لا تعبر المعلومات عن بلاد وانو البحار

160
00:11:37,830 --> 00:11:42,190
لم أكن أعرف أنّ بلاد وانو المزدهرة
...صارت على هذا الحال

161
00:11:42,600 --> 00:11:45,360
.كلّ هذا بسبب كايدو

162
00:11:45,360 --> 00:11:49,030
!أظنّ أنّك عازم الآن! لنسرع إلى أونيغاشيما

163
00:11:49,030 --> 00:11:51,660
!علينا اللّحاق بالجميع

164
00:11:51,660 --> 00:11:55,220
لكن ماذا علينا أن نفعل؟
.بدأت غارتهم بالفعل

165
00:11:55,220 --> 00:11:57,790
كيف ننضمّ لهم والعدوّ في كلّ مكان؟

166
00:11:57,790 --> 00:12:02,040
!اعتمد عليّ! لديّ فكرة

167
00:12:05,630 --> 00:12:11,800
كما هو مخطّط، يقود دنجيرو القوّات
.الجنوبيّة نحو المدخل الخلفيّ للقلعة

168
00:12:12,760 --> 00:12:14,800
!ثمّة بوّابة ليست في التّصاميم

169
00:12:14,800 --> 00:12:16,720
.لا بدّ أنّهم وسّعوا المكان

170
00:12:18,230 --> 00:12:19,610
!اختبئوا

171
00:12:22,350 --> 00:12:24,820
!أهو من كبار الجنود؟ كم هذا مزعج

172
00:12:24,820 --> 00:12:27,570
!اسمعوا! جدوه بأسرع وقت ممكن

173
00:12:27,570 --> 00:12:28,070
!حاضر

174
00:12:28,070 --> 00:12:30,610
.لا، لن يكون هذا مزعجًا على الإطلاق

175
00:12:30,820 --> 00:12:32,530
.أنا أعرفه

176
00:12:32,780 --> 00:12:34,700
...سأذهب للحديث معه

177
00:12:34,950 --> 00:12:36,160
!من هناك؟

178
00:12:36,160 --> 00:12:37,780
!مهلاً، هذا أنا

179
00:12:37,780 --> 00:12:38,990
...أنت

180
00:12:38,990 --> 00:12:40,830
...لم أرك منذ مدّة

181
00:12:41,120 --> 00:12:42,410
!يا ساساكي

182
00:12:42,410 --> 00:12:46,300
!كيوشيرو! سمعتُ أنّك لن تأتي هذه السّنة

183
00:12:46,300 --> 00:12:48,420
!صحيح، لا تخبر أيّ أحد عنّي

184
00:12:48,420 --> 00:12:52,050
أتيت خلسة؟ ما الّذي حدث لتسريحتك المزيّفة؟

185
00:12:52,050 --> 00:12:55,100
.ليس من عادتك أن تغادر وليمة ما

186
00:12:55,100 --> 00:12:59,390
.صحيح. ابن كايدو-سان مفقود

187
00:12:59,390 --> 00:13:02,020
على أيّ حال، أتودّ الشّرب؟

188
00:13:02,020 --> 00:13:03,060
!بالطّبع

189
00:13:03,060 --> 00:13:06,000
!يا رجال، عودوا إلى قبّة الجمجمة

190
00:13:06,000 --> 00:13:08,320
.سأنضمّ لكم لاحقًا

191
00:13:08,900 --> 00:13:14,090
.البوّابة الّتي لم تكن في التّصاميم
.وساسكي، واحد من التّوبي روبّو

192
00:13:14,090 --> 00:13:19,730
ولكن، بفضل كيوشيرو الّذي كان محلّ
،ثقة العدوّ لوقت طويل

193
00:13:19,730 --> 00:13:22,410
.كانتا عقبتين سهلتَيْ التّخطّي

194
00:13:26,790 --> 00:13:30,210
!حجر بحريّ؟! ما الّذي تفعله يا كيوشيرو؟

195
00:13:30,460 --> 00:13:32,260
!شدّوا وثاقه

196
00:13:32,260 --> 00:13:33,050
!حاضر

197
00:13:33,760 --> 00:13:36,640
!ما الّذي يحدث؟! أجبني

198
00:13:36,640 --> 00:13:38,560
!كمّموا فمه أيضًا

199
00:13:38,560 --> 00:13:39,430
!حاضر

200
00:13:39,430 --> 00:13:41,430
!أجبني يا كيوشيرو

201
00:13:41,430 --> 00:13:43,640
...اسمع يا ساساكي

202
00:13:43,640 --> 00:13:48,150
هل تعرف تاريخ بلاد وانو؟

203
00:13:48,860 --> 00:13:50,280
!أذلك...؟

204
00:13:55,240 --> 00:13:58,700
،بعد تقييد أحد التّوبي روبّو الأقوياء

205
00:13:58,700 --> 00:14:03,160
قسّم دنجيرو مجموعته إلى نصفين
.كما حدث مع القوّات الشّرقيّة

206
00:14:03,160 --> 00:14:05,330
!اذهبوا إلى داخل القبّة

207
00:14:05,330 --> 00:14:07,310
!حظًّا موفّقًا

208
00:14:07,920 --> 00:14:14,050
.بالتّالي، تدنو القوّات الجنوبيّة من كايدو بوتيرة ثابتة

209
00:14:38,110 --> 00:14:41,290
!كم أنّ هؤلاء الحمقى مزعجين

210
00:14:41,490 --> 00:14:43,640
!أين ذهبت أيّها التّانوكي؟

211
00:14:43,640 --> 00:14:47,250
!عليكم دفع ما فعلتموه بكعكة الزّفاف خاصّتي

212
00:14:47,250 --> 00:14:48,790
!يا صاحبة الجلالة بيغ مام

213
00:14:50,540 --> 00:14:54,500
،سمعنا أنّك تريدين تدمير دبّابة
!فأتينا على عجل

214
00:14:54,500 --> 00:15:00,550
حسنًا. لماذا لا تأخذون مواقعكم إذًا
!وتعثرون عليهم بالفعل؟

215
00:15:00,550 --> 00:15:01,510
!حاضر

216
00:15:01,510 --> 00:15:03,850
!يا قائد الدّبّابة تشوبّر، ماذا نفعل؟

217
00:15:03,850 --> 00:15:09,400
هذا سيّئ! يضعون جميعهم أفخاخًا
!ونيّتهم الإطلاق علينا

218
00:15:09,400 --> 00:15:10,680
!لا فائدة

219
00:15:10,680 --> 00:15:12,730
!نحن هالكون

220
00:15:12,730 --> 00:15:14,190
!يا قائد الدّبّابة تشوبّر

221
00:15:14,190 --> 00:15:17,690
!ألا تتذكّر هدفنا؟

222
00:15:17,690 --> 00:15:19,070
هدفنا؟

223
00:15:19,070 --> 00:15:23,790
مهمّتنا هي الانضمام لفرانكي ودرّاجة
،وحيد القرن الأسود على التّلّة الموعودة

224
00:15:23,790 --> 00:15:27,610
!والاندماج لنصبح الجنرال فرانكي

225
00:15:27,610 --> 00:15:28,870
...صحيح

226
00:15:28,870 --> 00:15:31,920
!ذلك الاندماج هو أفضل فرصنا

227
00:15:31,920 --> 00:15:37,380
غرائزك الحيوانيّة هي أملنا الوحيد
!للخروج من هذا الوضع

228
00:15:37,880 --> 00:15:40,220
...أيّها السّائق أوسوبّ

229
00:15:41,050 --> 00:15:45,350
.أنت محقّ. أظنّني كنت متعبًا

230
00:15:47,810 --> 00:15:52,360
،إن لم نثق في دبّابة براكيو هذه
!فمن غيرنا سيفعل؟

231
00:15:54,190 --> 00:15:57,440
!يا قائد الدّبّابة تشوبّر، ما هي أوامرك؟

232
00:15:59,480 --> 00:16:01,990
!لننطلق بأقصى سرعة ممكنة

233
00:16:01,990 --> 00:16:03,370
!عُلم

234
00:16:06,160 --> 00:16:09,580
!يضع العدوّ فخًّا عند الشّقّ في الجدار

235
00:16:09,580 --> 00:16:12,250
!استدر عن طريق الانزلاق عندما أعطيك الإشارة

236
00:16:13,210 --> 00:16:14,380
!الآن

237
00:16:14,800 --> 00:16:16,460
!انطلقي يا براكيو

238
00:16:18,750 --> 00:16:19,970
!أطلقوا

239
00:16:22,550 --> 00:16:24,300
!حسنًا، أطلق بدورك

240
00:16:29,100 --> 00:16:31,100
!أطلقوا هجمات مدافع الهاون

241
00:16:39,230 --> 00:16:41,200
!دع الأمر لي

242
00:16:47,370 --> 00:16:49,830
!ثمّة مدافع ضخمة أمامنا

243
00:16:49,830 --> 00:16:53,460
!تقدّم بلا تردّد! سننال منهم من مدى قريب

244
00:17:05,510 --> 00:17:09,520
!الآن! أرهم ما لديك أيّها السّائق أوسوبّ

245
00:17:09,520 --> 00:17:11,440
!دع الأمر لي

246
00:17:20,230 --> 00:17:23,950
.أطاحا بهم جميعًا... ليسا سيّئين

247
00:17:23,950 --> 00:17:26,620
!لكنّني صرت أعرف أين التّانوكي الآن

248
00:17:30,790 --> 00:17:33,190
أتعرفان ما نقطة ضعف الدّبّابة؟

249
00:17:33,190 --> 00:17:36,400
!إنّها الهجمات من الأعلى

250
00:17:36,400 --> 00:17:39,090
!هجمات قنابل بيغ مام

251
00:17:41,090 --> 00:17:44,010
!إنّها فوقنا! لنهرب بأسرع ما لدينا

252
00:17:51,220 --> 00:17:52,680
!أوقف الدّبّابة

253
00:17:52,680 --> 00:17:54,560
!لماذا أيّها القائد؟

254
00:17:54,560 --> 00:18:00,070
!ثق بصلابة درع دبّابة براكيو
!لا بدّ من مخرج من هذا

255
00:18:01,440 --> 00:18:06,160
.حسنًا، لنعهد بمصيرنا لدبّابة براكيو

256
00:18:14,330 --> 00:18:17,080
!ها هو ذا الهجوم المفجّر

257
00:18:25,050 --> 00:18:27,020
!موتا

258
00:18:27,390 --> 00:18:29,930
!أيّها السّائق أوسوبّ، الآن

259
00:18:30,220 --> 00:18:32,850
!حسنًا! الطّلقة المباشرة

260
00:18:35,100 --> 00:18:37,900
!إليك بعض الحلوى الإضافيّة! استمتعي

261
00:18:52,200 --> 00:18:55,330
فزنا، أليس كذلك أيّها السّائق أوسوبّ؟

262
00:18:55,330 --> 00:18:58,920
!يا قائد الدّبّابة، إنّه فوز كامل

263
00:18:58,920 --> 00:19:02,840
!قُدتنا ببراعة يا قائد الدّبّابة تشوبّر

264
00:19:02,840 --> 00:19:08,090
!كلاّ، نجونا بفضل مهاراتك في التّصويب

265
00:19:08,090 --> 00:19:11,590
...على أيّ حال، كانت معركة صعبة

266
00:19:11,590 --> 00:19:14,430
!أيّها القائد، لنذهب للقاء البقيّة

267
00:19:14,430 --> 00:19:16,480
!حسنًا. لنعد

268
00:19:19,150 --> 00:19:25,780
أنتما، لا تظنّان فعلاً أنّ بإمكانكما
،الإطاحة بي بهذه السّهولة

269
00:19:25,780 --> 00:19:29,280
!أليس كذلك؟

270
00:19:29,490 --> 00:19:32,080
!لا تعبثا معي

271
00:19:32,700 --> 00:19:35,490
أيّها القائد، ما-ما أوامرك...؟

272
00:19:35,490 --> 00:19:38,250
...تـ-تعرف ما قد أقوله

273
00:19:40,170 --> 00:19:42,750
!لنقم بتراجع تخطيطيّ

274
00:19:42,750 --> 00:19:44,550
!عرفتُ أنّ الأمر لن ينجح

275
00:19:44,550 --> 00:19:46,130
!بالطّبع لن ينجح

276
00:19:46,130 --> 00:19:49,060
!أيّها التّانوكي

277
00:19:52,470 --> 00:19:56,700
،رغم أنّهما كانا خائفين
...هربا في الاتّجاه المعاكس

278
00:19:56,700 --> 00:20:00,730
...شكرًا لكما أيّها القائد تشوبّر والسّائق أوسوبّ

279
00:20:01,360 --> 00:20:02,860
!لنواصل

280
00:20:02,860 --> 00:20:03,980
!أجل

281
00:20:03,980 --> 00:20:07,990
!يا رفاق! لا تدعوا هذه التّضحية تضيع هباءً

282
00:20:07,990 --> 00:20:10,030
!مهلاً، ألا يجدر بنا فعل شيء ما؟

283
00:20:10,030 --> 00:20:15,160
أظنّ أنّ ذلك المرأة النّاضجة المتوحّشة
!أكثر ممّا يمكن لذلكما الفتيين تحمّله

284
00:20:15,160 --> 00:20:17,580
!معها حقّ! إنّها بيغ مام

285
00:20:17,580 --> 00:20:21,020
!أعلم، لهذا السّبب ليس بوسعنا فعل شيء

286
00:20:21,020 --> 00:20:24,230
!لنشكرهما على استدراجها فحسب

287
00:20:24,230 --> 00:20:27,380
على أيّ حال، لماذا المكان حارّ هنا؟

288
00:20:27,380 --> 00:20:30,880
!نامي! انظري للأعلى! نحن في ورطة

289
00:20:32,510 --> 00:20:34,390
!وجدتك

290
00:20:34,880 --> 00:20:39,270
!إنّها المرأة الّتي سرقت زوس يا ماما

291
00:20:41,350 --> 00:20:43,530
!نالوا منه

292
00:20:46,940 --> 00:20:48,570
!ريوو

293
00:20:53,070 --> 00:20:54,320
!اللّعنة عليك

294
00:21:00,210 --> 00:21:02,050
!أيّها الوغد

295
00:21:09,340 --> 00:21:12,260
!بي-تان! بي-تان! بي-تان

296
00:21:12,260 --> 00:21:16,560
!انطلق يا بي-تان

297
00:21:16,800 --> 00:21:19,730
!اسمعي! اذهبي للبحث في مكان آخر يا غبيّة

298
00:21:19,730 --> 00:21:24,020
!أنت يا بي-تان! ماذا قلت؟

299
00:21:24,020 --> 00:21:28,400
!اخرسي! أنت غبيّة! غبيّة، غبيّة، غبيّة

300
00:21:28,400 --> 00:21:31,050
!قل أنّني أخت كبيرة رائعة

301
00:21:31,050 --> 00:21:32,240
...لكن

302
00:21:33,030 --> 00:21:34,760
...لا يمكنني الرّكض أكثر

303
00:21:34,760 --> 00:21:39,040
!يا بي-تان! أنا متعبة-أرينسو

304
00:21:39,040 --> 00:21:41,200
!لا أهتمّ! هيّا بنا

305
00:21:41,200 --> 00:21:46,880
لا طاقة لديّ... حتّى أخي العزيز
...يعتبرني حمقاء

306
00:21:46,880 --> 00:21:50,590
!يا لي من مسكينة

307
00:21:50,590 --> 00:21:54,300
!لا تؤخّريني! اجلسي هناك فحسب إن كنت متعبة

308
00:21:54,300 --> 00:21:56,350
...لماذا لا يمكنك أن تقول

309
00:21:58,260 --> 00:21:59,560
!مصيبة

310
00:22:00,220 --> 00:22:03,350
"!دعني أحملك على ظهري؟"

311
00:22:03,720 --> 00:22:06,610
!ابتعدي عنّي! هيّا

312
00:22:06,610 --> 00:22:09,740
!مهلاً! اتركيني يا أختي

313
00:22:10,440 --> 00:22:11,780
...أيّها الـ

314
00:22:11,780 --> 00:22:13,650
!اسمعي! أنا جادّ! توقّفي

315
00:22:16,240 --> 00:22:17,450
!بي-تان؟

316
00:22:17,990 --> 00:22:20,620
!بي-تان! بي-تان! بي-تان

317
00:22:20,620 --> 00:22:23,910
!تماسك، تماسك، تماسك

318
00:22:23,910 --> 00:22:29,340
!يا أخي بي-تان

319
00:22:33,500 --> 00:22:34,510
ماذا؟

320
00:22:35,210 --> 00:22:36,910
!بي-تان

321
00:22:36,910 --> 00:22:42,100
!ضحّى بي-تان بنفسه لإنقاذي

322
00:22:45,970 --> 00:22:48,110
!من تكون يا هذا؟

323
00:22:48,110 --> 00:22:49,650
!ومن تكونين؟

324
00:23:04,200 --> 00:23:06,120
!اعتُرف به كعدوّ قويّ

325
00:23:06,120 --> 00:23:12,300
هاكي لون الملك الأسمى الّذي استعمله الرّجل الّذي
!يسعى ليكون ملك القراصنة يفاجئ أولتي وبيج وان

326
00:23:12,300 --> 00:23:15,470
وعندما يوشكان على مهاجمة لوفي
،في هيئة الوحش خاصّتهما

327
00:23:15,470 --> 00:23:21,980
يظهر غريب يرتدي قناع شيطان
.وصوت قباقيب خشبيّة

328
00:23:22,600 --> 00:23:27,080
:في الحلقة القادمة من وان بيس
"!باغوا الرّعد! ها قد أتى ابن كايدو"

329
00:23:27,080 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا