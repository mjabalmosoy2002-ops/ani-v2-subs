1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:32,150 --> 00:02:34,280
،بإمكاني رؤية بوّابات العدالة الآن

33
00:02:34,280 --> 00:02:36,390
لكن هل يمكن بلوغها بقارب عاديّ؟

34
00:02:37,070 --> 00:02:40,730
.لا أملك متّسعًا من الوقت على أيّ حال

35
00:02:41,080 --> 00:02:42,230
!ها أنا ذا

36
00:02:44,620 --> 00:02:47,250
!عجبًا! أخي القرصان

37
00:02:47,250 --> 00:02:49,050
!ماذا تفعل؟

38
00:02:55,340 --> 00:02:56,790
...سانجي-كن

39
00:02:57,190 --> 00:02:59,060
ألم تستطع هزيمتها حقًّا؟

40
00:02:59,770 --> 00:03:01,540
هل قاتلت بجديّة فعلاً؟

41
00:03:02,890 --> 00:03:05,010
قاتلت تلك المرأة، أليس كذلك؟

42
00:03:05,180 --> 00:03:07,510
.أنت ضعيف أمام النّساء

43
00:03:08,610 --> 00:03:11,260
.آسف بشأن المفتاح

44
00:03:11,450 --> 00:03:12,610
!ليس هكذا

45
00:03:12,610 --> 00:03:17,190
أخبرك بهذا لأنّك قد تفقد حياتك
!بسبب شهامتك السّخيفة تلك

46
00:03:17,740 --> 00:03:20,240
!هل ستتمسّك بها حتّى إن تأذّيت هكذا؟

47
00:03:20,240 --> 00:03:21,900
!ماذا إن متّ؟

48
00:03:22,810 --> 00:03:24,070
...ليس وكأنّني

49
00:03:24,820 --> 00:03:26,910
.أريد أن أموت

50
00:03:27,040 --> 00:03:28,030
...لكنّي

51
00:03:28,470 --> 00:03:32,210
.كبرتُ بمبدأ ألاّ أركل النّساء

52
00:03:32,210 --> 00:03:33,250
...لذا

53
00:03:34,770 --> 00:03:36,540
...حتّى إن كلّفني ذلك حياتي

54
00:03:36,800 --> 00:03:39,210
!لن أركل امرأة

55
00:03:44,140 --> 00:03:45,590
.يا لك من أحمق

56
00:03:45,840 --> 00:03:46,670
!أحمق

57
00:03:47,140 --> 00:03:49,510
!مهلاً! ماذا تفعلين يا نامي؟

58
00:03:49,900 --> 00:03:52,320
،إن كان الهرب يخالف شهامتك أيضًا

59
00:03:52,320 --> 00:03:54,600
!فتخلّص من تلك الشّهامة

60
00:03:54,830 --> 00:03:58,020
.لا تستحقّ أن تموت هباءً من أجلها

61
00:03:59,030 --> 00:04:01,850
.دع تلك المرأة لي

62
00:04:02,950 --> 00:04:04,250
...و

63
00:04:04,870 --> 00:04:07,860
.أحترم شهامتك أكثر من السّابق

64
00:04:08,110 --> 00:04:08,890
!ماذا؟

65
00:04:08,890 --> 00:04:11,080
هل قالت للتّوّ أنّها تحبّني أكثر من السّابق؟

66
00:04:11,080 --> 00:04:12,530
!كلاّ، لم تقل

67
00:04:18,680 --> 00:04:21,420
.لستُ لطيفة

68
00:04:22,310 --> 00:04:23,650
.ولا أنا

69
00:04:23,650 --> 00:04:25,480
.يبدو أنّنا سنتفاهم

70
00:04:40,140 --> 00:04:41,600
!يويوي

71
00:04:41,600 --> 00:04:44,240
!انتظري

72
00:04:44,240 --> 00:04:45,230
!رجل الأخطبوط

73
00:04:45,480 --> 00:04:46,900
...لن

74
00:04:46,900 --> 00:04:52,250
!لن أدعك تهربين

75
00:04:52,620 --> 00:04:54,040
!نامي، اذهبي وتكفّلي بتلك المرأة

76
00:04:54,040 --> 00:04:55,660
!سأفعل شيئًا حيال هذا الشّخص

77
00:04:56,940 --> 00:04:58,030
!حسنًا

78
00:04:58,660 --> 00:05:01,090
!يوي! يوي! يويوي

79
00:05:01,090 --> 00:05:03,350
!هل ستعترض طريقي؟

80
00:05:03,350 --> 00:05:04,420
...حوافر أزهار الكرز

81
00:05:05,670 --> 00:05:06,380
!المتقاطعة

82
00:05:22,000 --> 00:05:25,530
!كيف تجرؤ؟

83
00:05:25,530 --> 00:05:28,270
!هربت ثانيةً

84
00:05:28,780 --> 00:05:31,020
!أنا هو خصمك

85
00:05:31,330 --> 00:05:32,280
!هيّا

86
00:05:35,150 --> 00:05:39,710
!خطأ فوكورو التّقديريّ"
"!الكولا خاصّتي هي ماء الحياة

87
00:05:53,180 --> 00:05:56,850
بربّك، يستحيل أن تعبر مياهًا كهذه
بمثل هذا القارب، أليس كذلك؟

88
00:05:56,850 --> 00:05:58,350
!هل أنت غبيّ؟

89
00:05:59,570 --> 00:06:03,180
!لكنّهم أخذوا روبين إلى تلك البوّابات

90
00:06:03,430 --> 00:06:07,270
!لن أتمكّن من استرجاعها ما لم أسرع

91
00:06:10,180 --> 00:06:13,440
يجدر أن أستطيع الوصول إلى المبنى
الّذي أمامها، صحيح؟

92
00:06:13,620 --> 00:06:15,360
!مهلاً! ما الّذي تفعله؟

93
00:06:15,360 --> 00:06:16,820
!انتظر يا أخي القرصان

94
00:06:16,820 --> 00:06:18,320
!اهدأ

95
00:06:18,520 --> 00:06:20,910
،إن كنت لا أستطيع عبور البحر
!فلا خيار أمامي سوى القفز

96
00:06:21,120 --> 00:06:25,710
أتينا لندلّك على الطّريق للوصول
!إلى بوّابات العدالة

97
00:06:26,890 --> 00:06:27,750
ماذا؟

98
00:06:45,160 --> 00:06:46,420
ما هذا المكان؟

99
00:06:46,420 --> 00:06:47,490
قبو؟

100
00:06:47,490 --> 00:06:49,200
.إنّه ممرّ تحت البحر

101
00:06:49,400 --> 00:06:52,610
،للوصول إلى بوّابات العدالة
.عليك الذّهاب تحت البحر

102
00:06:53,300 --> 00:06:54,580
.فهمت

103
00:06:55,200 --> 00:06:55,940
!حسنًا إذًا

104
00:06:55,940 --> 00:06:58,160
!انتظر! هل تعرف كيف تصل إلى هناك؟

105
00:07:05,470 --> 00:07:07,280
.أنت مذهلة على أيّ حال

106
00:07:07,280 --> 00:07:09,290
!أنا منبهر لأنّك تعرفين عن ممرّ كهذا

107
00:07:10,420 --> 00:07:15,640
رأيت خادم لوتشي ينزل الدّرج
.وهو يضحك بصخب

108
00:07:15,640 --> 00:07:17,300
.لذا تبعتهم

109
00:07:20,360 --> 00:07:23,400
!لا يمكنهم ملاحقنا إن كانوا لا يعرفون أين المدخل

110
00:07:23,400 --> 00:07:24,770
!هذا ما يستحقّونه

111
00:07:25,090 --> 00:07:28,730
دخل لوتشي وتلك الآنسة سوداء
.الشّعر من تلك الأبواب أيضًا

112
00:07:43,070 --> 00:07:44,490
هذه هي إذًا؟

113
00:07:48,910 --> 00:07:51,420
.إنّها أبواب حديديّة قويّة للغاية

114
00:07:51,570 --> 00:07:53,400
هل تعرفين كيف تُفتح؟

115
00:07:54,100 --> 00:07:56,960
،كان الخادم يلمس هذا المكان

116
00:07:57,220 --> 00:08:00,290
لذا أعتقد أنّه يشتغل من خلال
...ثقب المفتاح هذا

117
00:08:00,970 --> 00:08:02,550
.إلاّ أنّنا لا نملك المفتاح

118
00:08:10,020 --> 00:08:11,630
.تراجعا

119
00:08:12,060 --> 00:08:14,280
ماذا؟ ماذا ستفعل؟

120
00:08:16,880 --> 00:08:19,450
بوسعنا الذّهاب إلى بوّابات العدالة
إن دخلنا من هنا، صحيح؟

121
00:08:32,680 --> 00:08:34,250
!المستوى الثّالث

122
00:09:12,930 --> 00:09:14,250
...فُتِحت

123
00:09:23,770 --> 00:09:25,470
!حسنًا! سأدخل

124
00:09:26,230 --> 00:09:28,930
!ماذا؟! لِمَ أصبحت صغيرًا الآن؟

125
00:09:43,880 --> 00:09:46,620
!أخي القرصان مثير لاهتمام بالفعل

126
00:09:48,340 --> 00:09:50,890
!حسنًا، لنباشر نحن أيضًا

127
00:09:53,540 --> 00:09:56,180
.سـ-سمعتُ ضجيجًا صاخبًا للتّوّ

128
00:09:56,180 --> 00:09:57,250
أكنت أتخيّل فحسب؟

129
00:09:57,250 --> 00:09:59,020
.كلاّ، مستحيل

130
00:09:59,730 --> 00:10:03,020
هل يمكن أن يكون ذلك الضّجيج
ناجمًا عن كسر القراصنة للأبواب؟

131
00:10:03,020 --> 00:10:05,430
!ماذا؟! ذلك مستحيل

132
00:10:05,700 --> 00:10:08,030
!إنّها أبواب حديديّة سميكة

133
00:10:08,030 --> 00:10:11,850
كما أنّه يستحيل عليهم إيجاد
!تلك الأبواب من الأساس

134
00:10:11,850 --> 00:10:16,980
في الواقع، يجدر بهم أن يعرفوا مكانها
.بما أنّ طفلةً وحيوانها الأليف كانا يتبعاننا

135
00:10:16,980 --> 00:10:18,200
!ماذا؟

136
00:10:18,200 --> 00:10:20,820
!مـ-ما دمت تعلم ذلك، لِمَ لم تقتلهما؟

137
00:10:24,670 --> 00:10:26,190
...لأنّني

138
00:10:26,750 --> 00:10:28,410
.لم أتلقّ أمرًا بذلك

139
00:10:28,820 --> 00:10:29,740
...ما

140
00:10:30,410 --> 00:10:32,410
!ماذا؟! أيّها الغبيّ

141
00:10:32,820 --> 00:10:35,310
!بإمكانك استخدام تقديرك إن كان الأمر تافهًا هكذا

142
00:10:35,310 --> 00:10:37,330
ألا يمكنك أن تعرف ما قد يحدث
!إن تجاهلت الأمر؟

143
00:10:38,140 --> 00:10:39,730
!ماذا تقول إذًا؟

144
00:10:39,730 --> 00:10:41,810
!هل تقصد أنّ أحدًا متّجهًا إلى هنا؟

145
00:10:41,810 --> 00:10:43,890
.أظنّ ذلك

146
00:10:43,890 --> 00:10:45,680
!أنا خائف

147
00:10:46,280 --> 00:10:48,010
!اخرس

148
00:10:48,010 --> 00:10:49,180
.كان ذلك أنا

149
00:10:49,620 --> 00:10:51,150
!اسمع يا لوتشي

150
00:10:51,150 --> 00:10:55,200
!أولى أولويّاتك هي حماية حياتي

151
00:10:55,200 --> 00:10:56,140
!مفهوم؟

152
00:10:56,560 --> 00:11:00,270
!وأيضًا، اقتل أيّ من يحاول اعتراض طريقي

153
00:11:00,840 --> 00:11:05,000
!عصياني يعدّ تمرّدًا على حكومة العالم

154
00:11:05,000 --> 00:11:06,320
!يستحقّون الموت

155
00:11:10,780 --> 00:11:14,200
!ماذا؟! ما هذه النّظرة؟

156
00:11:19,930 --> 00:11:23,150
لا تملكين الوقت للقلق على الآخرين
.يا نيكو روبين

157
00:11:23,320 --> 00:11:25,630
.لقد اقتربت من الجحيم بالفعل

158
00:11:25,920 --> 00:11:28,450
.لوتشي! أحضرها حالاً

159
00:11:49,250 --> 00:11:51,440
!حسنًا! عاد جسدي إلى طبيعته

160
00:11:54,050 --> 00:11:56,120
!انتظري فحسب يا روبين

161
00:11:59,410 --> 00:12:03,090
!سأحرص على إيساع صاحب الحمامة ذاك ضربًا

162
00:12:08,300 --> 00:12:12,220
...حسنًا، خسر سانجي-كن بسبب خطئه

163
00:12:14,820 --> 00:12:17,580
لكن ماذا فعلت به بالضّبط؟

164
00:12:44,050 --> 00:12:47,050
ما بال هذه المرأة؟

165
00:12:50,930 --> 00:12:53,090
.يا لجرأتها

166
00:13:14,220 --> 00:13:18,850
سحقًا! بينما عليّ أن أعيد ملأ
...الكولا خاصّتي قريبًا

167
00:13:19,890 --> 00:13:23,850
،بالنّسبة لشخصٍ ضخم البنية
.إنّه يحبّ القفز حقًّا

168
00:13:27,770 --> 00:13:30,550
.تشابابا... أنا هنا

169
00:13:32,900 --> 00:13:35,260
.يبدو أنّك سريع في الهرب على الأقلّ

170
00:13:35,690 --> 00:13:37,070
...تشابابا

171
00:13:37,070 --> 00:13:41,770
.لستُ ملزمًا على تلقّي لكماتك الفخورة

172
00:13:42,040 --> 00:13:44,440
!سوالف فرانكي المثلّثة

173
00:13:48,860 --> 00:13:50,090
.تشابابا

174
00:13:50,090 --> 00:13:51,320
...يستحيل

175
00:13:52,300 --> 00:13:53,700
!أن أُضرَب بسوالف كتلك

176
00:13:54,880 --> 00:13:55,530
!نلت منك

177
00:13:58,370 --> 00:14:00,380
!سلاح اليد اليسرى

178
00:14:06,230 --> 00:14:07,960
.يبدو أنّ الكولا تكاد تنفد منّي

179
00:14:08,350 --> 00:14:09,980
!من الأفضل أن أسرع إلى المطبخ

180
00:14:09,980 --> 00:14:11,300
!انتظر

181
00:14:11,770 --> 00:14:13,920
!سحقًا! تفادى هجماتي

182
00:14:14,310 --> 00:14:16,510
!إنّك خبير في الهرب أيّها الجبان اللّعين

183
00:14:16,820 --> 00:14:18,030
!تشابا

184
00:14:18,440 --> 00:14:19,390
!ماذا قلت؟

185
00:14:21,860 --> 00:14:23,760
ما الخطب يا جبان؟

186
00:14:23,970 --> 00:14:25,810
ألن تهرب هذه المرّة؟

187
00:14:26,040 --> 00:14:27,760
!أيّها الوغد

188
00:14:28,390 --> 00:14:31,230
!أغضبتني بتلك الكلمة

189
00:14:32,540 --> 00:14:34,830
!فلتتلقّ قبضتي القاتلة

190
00:14:34,830 --> 00:14:38,160
إنّها لكمة ثقيلة للغاية مدمجة
!مع سرعة مسدّس الإصبع

191
00:14:38,160 --> 00:14:39,320
!الوحش العنيف

192
00:14:46,890 --> 00:14:49,000
!...تشابابا

193
00:14:50,560 --> 00:14:53,370
...يا لها من لكمة متواضعة وغير فعّالة

194
00:14:54,770 --> 00:14:56,010
...المطرقة

195
00:14:56,430 --> 00:14:57,090
!الجسد الحديديّ

196
00:14:57,480 --> 00:14:58,390
!القويّة

197
00:15:04,480 --> 00:15:07,810
.يا لها من لكمة سخيفة

198
00:15:07,810 --> 00:15:09,480
!الوحش العنيف

199
00:15:24,970 --> 00:15:28,170
.لكماتك مترهّلة

200
00:15:29,730 --> 00:15:30,900
.لا

201
00:15:30,900 --> 00:15:33,810
.لكماتك ضعيفة

202
00:15:33,810 --> 00:15:36,710
.إذًا فلكماتك رقيقة

203
00:15:36,710 --> 00:15:39,750
.سراويلك بليدة

204
00:15:41,460 --> 00:15:42,850
سراويلي؟

205
00:15:47,480 --> 00:15:49,320
!ليست لكمات

206
00:15:49,320 --> 00:15:51,360
!بل هي سراويل فحسب

207
00:15:51,360 --> 00:15:53,320
!أيّها الوغد ذو حمّالات الصّدر

208
00:15:53,320 --> 00:15:55,280
!اخرس يا ذا الجوارب

209
00:15:55,280 --> 00:15:56,150
!ملابس داخليّة طويلة

210
00:15:56,150 --> 00:15:57,260
!سراويل فضفاضة

211
00:15:57,260 --> 00:15:58,090
!مئزر

212
00:15:58,090 --> 00:16:00,190
!تشابابابابا

213
00:16:08,940 --> 00:16:10,300
!إليك عنّي أيّها الوغد

214
00:16:10,300 --> 00:16:11,960
!اخرس يا محفظة الفكّة

215
00:16:12,560 --> 00:16:13,690
!حسنًا

216
00:16:13,690 --> 00:16:15,580
!استطعتُ دخول المطبخ

217
00:16:17,020 --> 00:16:20,040
!ها هي ذي! ثلاّجة ضخمة

218
00:16:25,440 --> 00:16:26,610
أهذا هو؟

219
00:16:26,810 --> 00:16:28,890
...حامل قوى الغوريلاّ... على الأغلب

220
00:16:29,200 --> 00:16:30,480
!سحقًا

221
00:16:30,720 --> 00:16:32,890
هل مضت ثلاث دقائق بالفعل؟

222
00:16:33,340 --> 00:16:36,090
.استخدمتُ كرة رامبل مبكّرًا

223
00:16:36,790 --> 00:16:37,690
ما العمل؟

224
00:16:40,500 --> 00:16:41,570
!يويوي

225
00:16:44,200 --> 00:16:47,300
!اختفِ من هذا العالم

226
00:16:47,300 --> 00:16:50,160
!هذه الضّربة القاضية

227
00:16:50,480 --> 00:16:51,370
!...يويو

228
00:16:52,460 --> 00:16:53,420
!أيّها الوغد

229
00:16:55,160 --> 00:16:56,420
!جيّد! حبسته

230
00:16:57,390 --> 00:16:58,960
!تشابا! كومادوري

231
00:17:01,100 --> 00:17:03,010
!أجل! لقد حبسته

232
00:17:03,360 --> 00:17:04,340
كيف تجرؤ...؟

233
00:17:04,340 --> 00:17:05,890
!انتظر لحظة أيّها الغوريلاّ

234
00:17:06,040 --> 00:17:08,390
!أحتاج تلك الثّلاّجة

235
00:17:08,660 --> 00:17:10,990
!عضو من السّي بي 9 ورعاع

236
00:17:10,990 --> 00:17:13,260
!أنا فرانكي! أنا في صفّك، هل نسيت؟

237
00:17:13,260 --> 00:17:14,410
!من نعتّ بالغوريلاّ؟

238
00:17:14,410 --> 00:17:15,150
!أنت بطيء الاستيعاب

239
00:17:15,910 --> 00:17:16,900
.اسمع

240
00:17:16,900 --> 00:17:20,310
.كما حال لوفي، لم أسامحك بعد

241
00:17:20,510 --> 00:17:22,740
...سبب فراق أوسوبّ لنا

242
00:17:24,570 --> 00:17:26,850
!يقع عليك وحدك

243
00:17:26,850 --> 00:17:28,510
!أعد لنا أوسوبّ

244
00:17:28,510 --> 00:17:31,540
.كما أخبرتكم، كنتم معه سابقًا

245
00:17:31,970 --> 00:17:34,060
!وهذا لا يهمّ الآن

246
00:17:34,060 --> 00:17:36,060
!ألا تريد إنقاذ نيكو روبين؟

247
00:17:36,060 --> 00:17:39,000
!بلى! روبين

248
00:17:39,270 --> 00:17:43,100
إذًا أخرج ثلاث قنّينات كولا
!من تلك الثّلاّجة وأعطها لي

249
00:17:43,100 --> 00:17:45,250
!بإمكاني تعزيز قوّتي بالكولا

250
00:17:45,250 --> 00:17:49,400
ثمّ سأتولّى أمر هذين الاثنين بسرعة
!وأحصل على مفتاحيهما

251
00:17:49,680 --> 00:17:52,110
أيّ غبيّ يصبح أقوى بواسطة الكولا؟

252
00:17:52,110 --> 00:17:53,870
!اخرس! إنّه أنا

253
00:17:55,920 --> 00:17:57,280
...إلى متى

254
00:17:57,600 --> 00:17:59,860
!ستواصلان هذا العرض الكوميديّ؟

255
00:18:00,950 --> 00:18:04,310
وفوق ذلك، كنتما تحاولان
أخذ استراحة شاي أثناء القتال؟

256
00:18:04,310 --> 00:18:06,220
!يا لوقاحتكما

257
00:18:06,820 --> 00:18:08,610
:مهارة الوحش العنيف السّرّيّة

258
00:18:11,710 --> 00:18:12,750
!درّاس البومة

259
00:18:16,420 --> 00:18:17,920
!تشابابابابا

260
00:18:19,420 --> 00:18:21,360
!فاصوليا اليسرى

261
00:18:29,150 --> 00:18:30,890
!ما كان ذلك؟

262
00:18:34,530 --> 00:18:35,870
!هذا فظيع

263
00:18:35,870 --> 00:18:38,120
!صحيح! إنّه في صفّنا الآن

264
00:18:38,120 --> 00:18:39,060
.سأفعل ما قال لي

265
00:18:42,340 --> 00:18:45,150
!إن فتحت الباب وأغلقته في ثانية، لن يخرج

266
00:18:47,540 --> 00:18:48,740
!يويوي

267
00:18:48,740 --> 00:18:53,580
...الباب قد

268
00:18:54,180 --> 00:18:54,750
!حسنًا

269
00:18:55,250 --> 00:18:56,270
!فرانكي

270
00:18:57,800 --> 00:18:58,540
!شكرًا

271
00:19:06,220 --> 00:19:10,180
!انتعاش

272
00:19:12,070 --> 00:19:13,640
ما الّذي...؟

273
00:19:16,130 --> 00:19:19,440
!الانتعاش هو الأهمّ! لكمة الخضراوات! خذ هذه

274
00:19:19,980 --> 00:19:20,560
.الوحش العنيف

275
00:19:23,580 --> 00:19:25,750
!أنت! كان ذلك عصير الخضراوات

276
00:19:27,130 --> 00:19:29,240
!لِمَ قد أعطي الأولويّة للصّحّة الآن أيّها الوغد؟

277
00:19:29,240 --> 00:19:31,120
!أعطني الكولا

278
00:19:31,370 --> 00:19:33,200
.لم يرد الكولا لأنّه عطش إذًا

279
00:19:34,300 --> 00:19:37,160
...يويوي! الباب

280
00:19:37,160 --> 00:19:37,960
!خذ

281
00:19:38,240 --> 00:19:39,420
!شكرًا

282
00:19:42,800 --> 00:19:46,380
!أشعر بخير

283
00:19:46,980 --> 00:19:49,340
...حسنًا

284
00:19:49,570 --> 00:19:51,110
.دعني أجلس

285
00:19:51,110 --> 00:19:54,400
.انتهى عملي في الحقل الآن

286
00:19:54,400 --> 00:19:56,000
.كفاكم غضبًا

287
00:19:56,000 --> 00:19:57,310
.لا تقاتلوا

288
00:19:57,780 --> 00:19:59,910
ما رأيكم بشرب بعض الشّاي؟

289
00:19:59,910 --> 00:20:01,400
...ما كان الشّاي

290
00:20:01,830 --> 00:20:04,320
!ليمنحني الطّاقة! أيّها البليد

291
00:20:06,120 --> 00:20:08,150
.إنّه... مضحك

292
00:20:08,500 --> 00:20:09,360
!أنت

293
00:20:09,360 --> 00:20:13,810
لِمَ يبدو من تعبيرك وكأنّك تتساءل كيف
!ستكون النّتيجة مع المشروبات الأخرى؟

294
00:20:14,590 --> 00:20:16,540
!هذه فرصتك الأخيرة أيّها الغزال اللّعين

295
00:20:16,970 --> 00:20:18,970
إذًا لا يعتمد الأمر على مشاعرك؟

296
00:20:18,970 --> 00:20:20,120
!أحتاج الكولا فقط

297
00:20:22,190 --> 00:20:25,210
!إنّها الكولا! لا شكّ في ذلك

298
00:20:25,600 --> 00:20:26,840
!شكرًا

299
00:20:29,600 --> 00:20:33,440
لا أدري ما الأمر، لكنّي لن أدعك
!تفعل ما يحلو لك

300
00:20:33,680 --> 00:20:34,690
!ساق العاصفة

301
00:20:36,520 --> 00:20:37,640
!فرانكي

302
00:20:48,360 --> 00:20:51,970
!خارق

303
00:21:16,190 --> 00:21:18,780
تشابابا... ما الأمر؟

304
00:21:18,780 --> 00:21:21,390
.ليس وكأنّ شرب الكولا سيحدث أيّ تغيير

305
00:21:24,370 --> 00:21:25,360
.احمِ نفسك

306
00:21:25,950 --> 00:21:28,180
.تشابا؟ يا لك من أحمق

307
00:21:28,330 --> 00:21:31,320
هل ستضربني بلكمة تافهة أخرى؟

308
00:21:31,830 --> 00:21:35,070
!المطرقة... القويّة

309
00:21:54,180 --> 00:21:56,090
!مذهل

310
00:22:15,470 --> 00:22:17,140
.آسف

311
00:22:17,540 --> 00:22:20,040
...كانت لكماتي في السّابق

312
00:22:20,490 --> 00:22:22,950
.تافهة بالفعل

313
00:22:31,490 --> 00:22:33,680
زورو-كن، ما فكرتك لنزع هذه الأصفاد؟

314
00:22:33,680 --> 00:22:36,360
،نعم. بما أنّ الوضع آل إلى هذا
سنلعب حجر-ورقة-مقص

315
00:22:36,360 --> 00:22:38,020
...لنقرّر أيّ معصم سنقوم بحزم بـ

316
00:22:38,020 --> 00:22:40,060
!ماذا دهاك تأتي بفكرة مخيفة كهذه؟

317
00:22:40,060 --> 00:22:41,020
!يستحيل أن نفعل ذلك

318
00:22:41,020 --> 00:22:42,150
حقًّا؟

319
00:22:42,150 --> 00:22:44,020
.إذًا، لديّ فكرة أخرى

320
00:22:44,020 --> 00:22:46,240
!لا أريد سماعها

321
00:22:46,240 --> 00:22:47,600
:في الحلقة القادمة من وان بيس

322
00:22:47,600 --> 00:22:51,690
!يفجّر زورو تقنيته الجديدة
اسم السّيف هو سوغيكينغ؟

323
00:22:51,690 --> 00:22:54,120
!ملك القراصنة، لن يكون إلاّ أنا

324
00:22:56,070 --> 00:23:01,120
نلقاكم في الحلقة القادمة