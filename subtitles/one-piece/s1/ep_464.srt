1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,790
"وأقول "أريد أن أصير أقوى

5
00:00:47,950 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,370 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,590 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,000 --> 00:03:22,360
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:22,360 --> 00:03:25,040
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:25,040 --> 00:03:26,120
!الّذي اقترب موعد إعدامه

40
00:03:27,490 --> 00:03:29,370
،أثناء ذلك في مارينفورد

41
00:03:30,170 --> 00:03:35,510
بدأت الحرب العظيمة بين قراصنة
!اللّحية البيضاء والبحريّة

42
00:03:38,200 --> 00:03:40,030
!جواهر ياساكاني المقدّسة

43
00:03:50,940 --> 00:03:54,520
...عرفتُ أنّك لن تسمح لي

44
00:03:55,140 --> 00:03:59,230
.بمهاجمة رأسك بسهولة

45
00:04:04,100 --> 00:04:05,150
!ما الّذي يفعله؟

46
00:04:06,550 --> 00:04:08,520
!أوقفوا هذا إن استطعتم

47
00:04:14,050 --> 00:04:16,500
...إن تركنا أماكننا نحن الثّلاثة

48
00:04:19,470 --> 00:04:21,840
!فمن سيشغلها؟

49
00:04:24,240 --> 00:04:25,670
!الثّوران العظيم

50
00:04:33,410 --> 00:04:34,970
!ابتعدوا

51
00:04:43,440 --> 00:04:45,740
.أضاء المكان بضوء أسطع

52
00:05:01,100 --> 00:05:05,340
لماذا لا تضيء كعك حفلات الميلاد
!بدل هذا يا شقيّ الحمم

53
00:05:10,020 --> 00:05:14,000
ألا تريد لجنازتك أن تكون مضاءة أيّها اللّحية البيضاء؟

54
00:05:18,170 --> 00:05:22,490
"!سليل الوحش! تقدّم ليتل أورز جونيور بأقصى سرعة"

55
00:05:46,510 --> 00:05:50,170
لم أكن أعرف بوجود رجال ضخام
.لهذا الحدّ في هذا العالم

56
00:05:50,300 --> 00:05:52,800
!إنّه وحش حقيقيّ

57
00:06:02,800 --> 00:06:05,560
،إن استطعت وضع يدي على جثّته

58
00:06:05,560 --> 00:06:09,240
!فسيعني ذلك أنّ بإمكاني الحصول على الزّومبي الأقوى ثانية

59
00:06:28,310 --> 00:06:29,790
!انطلقوا نحو المنصّة بسرعة

60
00:06:30,780 --> 00:06:33,320
!بدأت وحدة العمالقة تحرّكها

61
00:06:45,030 --> 00:06:46,470
!لا تخافوا

62
00:06:53,950 --> 00:06:56,200
!يسعون جميعًا خلف ليتل أورز جونيور

63
00:06:59,610 --> 00:07:01,600
...إنّ إيقافه

64
00:07:01,600 --> 00:07:03,250
!من واجبنا

65
00:07:09,750 --> 00:07:11,590
...إنّه ضخم بشكل لا يُصدّق

66
00:07:12,020 --> 00:07:14,640
!حجمه أكثر من ضعفي حجم العملاق العاديّ

67
00:07:14,640 --> 00:07:16,130
!واصلوا الإطلاق

68
00:07:16,130 --> 00:07:19,170
!ما زال بشريًّا، لذلك سيجدي هذا نفعًا ضدّه

69
00:07:31,490 --> 00:07:34,570
.أحضروا معهم مخلوقًا لا نظير لقوّته مثله

70
00:07:37,260 --> 00:07:39,300
!أطلقوا عليه! أطلقوا

71
00:07:41,480 --> 00:07:43,470
!أورز، كلاّ

72
00:07:43,470 --> 00:07:46,670
!أنت هدف سهل بسبب ضخامة حجمك

73
00:07:46,870 --> 00:07:48,660
!إيس-كُن

74
00:07:55,320 --> 00:07:59,050
!ها أنا قادم

75
00:08:08,560 --> 00:08:09,850
!هذا سيّئ

76
00:08:10,180 --> 00:08:11,320
!أوقفوه

77
00:08:26,670 --> 00:08:29,830
!فتح لنا أورز ثغرة لندخل الخليج

78
00:08:32,880 --> 00:08:35,190
!اغزوا الخليج

79
00:08:43,830 --> 00:08:46,770
!تبًّا! تراجعوا وعزّزوا خطّ الدّفاع

80
00:08:46,770 --> 00:08:48,480
!لا تسمحوا لهم بدخول السّاحة

81
00:09:33,600 --> 00:09:36,150
!إ-إلى أين علينا الهرب؟

82
00:09:37,110 --> 00:09:38,310
!تراجع يا جنديّ البحريّة

83
00:09:41,910 --> 00:09:44,010
!لا تعترض طريقي

84
00:09:45,680 --> 00:09:48,360
!اللّواء البحريّ يوكيمورا، قاتل الألف رجل

85
00:09:48,780 --> 00:09:51,180
ما الّذي تفعله؟

86
00:09:52,120 --> 00:09:55,670
!نحن في ساحة معركة
!لا فائدة لنا ممّن ليسوا مستعدّين

87
00:10:09,370 --> 00:10:12,470
!أنا عاجز

88
00:10:26,870 --> 00:10:28,250
!ولا أنا

89
00:10:28,560 --> 00:10:32,960
!عليّ بلوغ إيس-كُن

90
00:10:33,320 --> 00:10:35,250
!لا تقفوا في طريقي

91
00:10:36,710 --> 00:10:38,540
!لن أسمح لك بالتّقدّم أكثر

92
00:11:06,440 --> 00:11:08,160
!يا نائب الأميرال لاكروا

93
00:11:11,740 --> 00:11:14,550
.أورز، إنّه لا يتغيّر أبدًا

94
00:11:15,370 --> 00:11:18,000
!لا يسعى الشّجعان للموت

95
00:11:18,740 --> 00:11:22,390
!لا توقفني يا والدي

96
00:11:22,800 --> 00:11:25,720
!أريد إنقاذه فحسب

97
00:11:26,180 --> 00:11:31,390
!أريد إنقاذ إيس-كُن بأسرع ما يمكن

98
00:11:32,290 --> 00:11:34,240
.أعلم ذلك

99
00:11:34,730 --> 00:11:37,890
!ساعدوه جميعًا

100
00:11:38,150 --> 00:11:40,060
!احموا أورز

101
00:11:45,260 --> 00:11:48,740
!كيف لنا أن ندافع في مواجهة شخص بهذه الضّخامة؟

102
00:11:54,990 --> 00:11:57,970
!قطعتَ نائب الأميرال لاكروا

103
00:12:12,900 --> 00:12:16,140
!لا يمكن مهاجمته فُرادى! علينا أن نقوم بذلك معًا

104
00:12:18,890 --> 00:12:22,900
،بينما يشتّت أورز انتباهكم
!فسنقوم بخطوتنا ضدّكم

105
00:12:29,880 --> 00:12:31,450
!سهم الاستعباد

106
00:12:41,450 --> 00:12:43,630
!يا-يا رفاق

107
00:12:44,390 --> 00:12:45,840
!أنت الإمبراطورة القرصانة إذًا

108
00:12:51,670 --> 00:12:54,140
!جسدي... يتفتّت

109
00:12:54,560 --> 00:12:56,400
!السّاق العطِرة

110
00:13:11,240 --> 00:13:14,530
!حقيرة! تهاجمين جنود البحريّة أيضًا

111
00:13:14,730 --> 00:13:18,040
...وافقت على القتال ضدّ اللّحية البيضاء

112
00:13:18,650 --> 00:13:21,830
.لكنّني لم أقل أنّني سأصير جزءًا منكم

113
00:13:22,650 --> 00:13:25,460
.سواء كانوا حلفاء أو أعداء... كلّ الرّجال سواسية

114
00:13:26,700 --> 00:13:28,360
.فيما عداه هو

115
00:13:30,380 --> 00:13:33,640
."يمكنني القول... "وفيت بوعدي

116
00:13:33,640 --> 00:13:34,890
!ماذا؟

117
00:13:38,760 --> 00:13:41,260
.ارحم جمالي

118
00:13:41,950 --> 00:13:44,640
!أ-أنت

119
00:13:55,460 --> 00:13:57,250
!إيس-كُن

120
00:14:01,560 --> 00:14:03,810
!تعال! تعال بسرعة

121
00:14:08,470 --> 00:14:09,790
!أورز

122
00:14:44,410 --> 00:14:45,570
!أنت

123
00:15:11,000 --> 00:15:13,540
!سأنقذك الآن

124
00:15:14,340 --> 00:15:15,510
...أورز

125
00:15:31,210 --> 00:15:33,140
!إيس-كُن

126
00:16:04,600 --> 00:16:06,420
.صدمة الدّبّ

127
00:17:05,460 --> 00:17:07,350
!أورز

128
00:17:13,940 --> 00:17:16,600
!هذا يكفي! توقّف

129
00:17:17,600 --> 00:17:19,370
!لا يمكنك الوصول إليّ

130
00:17:35,600 --> 00:17:36,860
!اسمع يا أورز

131
00:17:40,750 --> 00:17:43,590
...كنتُ أتساءل

132
00:17:45,210 --> 00:17:46,680
ألا تشعر بالحرّ؟

133
00:17:48,270 --> 00:17:50,170
.لأنّك أقرب إلى الشّمس

134
00:17:54,760 --> 00:17:55,940
.أشعر بالحرّ فعلاً

135
00:17:56,800 --> 00:17:57,750
.فهمت

136
00:17:58,190 --> 00:18:01,560
.سيكون من اللّطيف لو كانت هنالك ظلال

137
00:18:03,240 --> 00:18:05,110
!أيها القبطان أورز

138
00:18:10,070 --> 00:18:11,980
أما زال قادرًا على الحركة؟

139
00:18:13,470 --> 00:18:14,870
!هذا رائع

140
00:18:14,870 --> 00:18:16,920
!إنّه يملك صلابة سلفه

141
00:18:17,970 --> 00:18:19,260
ما هذه؟

142
00:18:23,660 --> 00:18:26,510
.تعلّمت كيف أصنعها في بلاد وانو

143
00:18:27,390 --> 00:18:28,580
.جرّبها

144
00:18:30,710 --> 00:18:33,420
.أفسد إيس-سان اثنتان من قبلها

145
00:18:33,420 --> 00:18:34,780
!لقد أحرقهما

146
00:18:34,780 --> 00:18:38,150
!بما أنّ جسده من النّار، فلا يجب عليه التّعامل بالقشّ

147
00:18:42,220 --> 00:18:44,620
!الجوّ أبرد تحتها

148
00:18:45,390 --> 00:18:47,440
.فعلاً؟ أسعدني هذا

149
00:18:57,740 --> 00:18:59,740
!أطلقوا على أورز

150
00:19:10,240 --> 00:19:11,450
!أورز

151
00:19:11,870 --> 00:19:14,850
!ما كان عليه الوقوف ثانية! إنّه هدف سهل

152
00:19:22,450 --> 00:19:26,200
أيّها القبطان أورز! لماذا أنت في الخارج؟

153
00:19:29,130 --> 00:19:31,090
.لا أتبلّل من المطر

154
00:19:32,280 --> 00:19:34,220
!إنّها متينة

155
00:19:34,580 --> 00:19:36,460
!أحببتها

156
00:19:45,840 --> 00:19:49,470
!ما زلت... لا أستطيع الوصول إليه

157
00:19:57,200 --> 00:19:58,560
...إن أمكنني

158
00:19:59,760 --> 00:20:03,490
!الإطاحة بأحد الشّيتشيبوكاي على الأقلّ

159
00:20:23,290 --> 00:20:25,940
ما الخطب أيّها الوحش؟

160
00:20:26,290 --> 00:20:27,710
...قدمي

161
00:20:28,970 --> 00:20:30,220
!أيّها القبطان

162
00:20:31,460 --> 00:20:34,450
أيّها القبطان، لماذا أنت في الخارج ثانية؟

163
00:20:35,090 --> 00:20:38,670
.لا ينزل الثّلج على رأسي

164
00:20:39,520 --> 00:20:41,530
!لا أشعر بالبرد

165
00:20:42,740 --> 00:20:44,980
!أحبّها كثيرًا

166
00:20:47,740 --> 00:20:49,240
...شكرًا لك يا إيس

167
00:20:59,130 --> 00:21:00,880
!كم هذا ممتع

168
00:21:06,010 --> 00:21:07,960
!أورز

169
00:21:26,660 --> 00:21:28,490
!لا-لا بدّ أنّه وحش

170
00:21:31,700 --> 00:21:33,700
!لقد خطا على السّاحة

171
00:21:42,510 --> 00:21:45,210
...القليل فحسب

172
00:21:48,960 --> 00:21:53,680
!القليل فحسب وأصل لإيس-كُن

173
00:22:00,280 --> 00:22:02,230
!تبًّا لك يا دوفلامينغو

174
00:22:02,230 --> 00:22:04,520
!لقد بتر ساقه

175
00:22:04,520 --> 00:22:07,020
!سبق وطالبت بجثّته لي

176
00:22:07,270 --> 00:22:08,700
!رجل الظّلّ

177
00:22:10,590 --> 00:22:12,080
!نالي منه

178
00:22:12,500 --> 00:22:13,780
!سيف سحليّة الظّلال

179
00:22:16,340 --> 00:22:18,360
!أورز

180
00:22:36,820 --> 00:22:40,270
...سوف... أنقذك الآن

181
00:23:02,960 --> 00:23:05,100
!يا إيس-كُن

182
00:23:11,360 --> 00:23:14,560
.ضحّى أورز بحياته ليفتح الطّريق للبقيّة

183
00:23:15,090 --> 00:23:18,100
،يندفع قراصنة اللّحية البيضاء نحو المنصّة

184
00:23:18,470 --> 00:23:22,100
لكن عندما يبدو وكأنّ بإمكانهم
،إنقاذ إيس من الإعدام

185
00:23:22,270 --> 00:23:25,370
.نجد سنغوكو وهو يجهّز خطّة جديدة

186
00:23:25,640 --> 00:23:27,140
:في الحلقة القادمة من وان بيس

187
00:23:27,140 --> 00:23:31,020
"!العدالة لمن ينتصر! بدء العمل باستراتيجيّة سنغوكو"

188
00:23:31,020 --> 00:23:33,230
!ملك القراصنة، لن يكون إلاّ أنا

189
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة