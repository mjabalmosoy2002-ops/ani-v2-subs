1
00:00:08,290 --> 00:00:11,360
!العالم... نعم

2
00:00:11,890 --> 00:00:13,560
...اسعوا نحو الحرّيّة

3
00:00:13,560 --> 00:00:17,700
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:18,060 --> 00:00:21,430
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,930 --> 00:00:23,300
!فتجاوزوها

6
00:00:23,700 --> 00:00:26,670
!تحت راية ما تؤمنون به

7
00:00:31,140 --> 00:00:36,750
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,750 --> 00:00:39,980
متّجهًا نحو عالم بلا نهاية

9
00:00:41,390 --> 00:00:46,260
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,260 --> 00:00:54,670
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,670 --> 00:01:00,410
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,410 --> 00:01:04,840
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,840 --> 00:01:10,480
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,480 --> 00:01:14,350
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,350 --> 00:01:19,290
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,290 --> 00:01:27,030
متّجهين نحو الأفق

17
00:01:27,030 --> 00:01:32,540
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,540 --> 00:01:37,240
متّجهًا نحو عالم بلا نهاية

19
00:01:37,240 --> 00:01:42,480
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,480 --> 00:01:48,750
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:00,700 --> 00:02:03,430
سأغليه لثلاث ليالٍ ويومين
...لأزيل المذاق المرّ

22
00:02:04,540 --> 00:02:07,540
!انتظرا فحسب يا نامي-سان وروبين-تشان

23
00:02:07,540 --> 00:02:09,470
!سيكون هذا فطورًا مميّزًا

24
00:02:12,710 --> 00:02:16,650
!وصفة متوارثة"
".سانجي، رجل الكاري الحديديّ

25
00:02:22,450 --> 00:02:23,820
،سُحقًا

26
00:02:23,820 --> 00:02:27,360
وكأنّ هنالك من سكب حليبًا على هذا
.الضّباب. لا يمكنني رؤية أيّ شيء

27
00:02:27,360 --> 00:02:29,060
لوفي، هل ترى أيّ شيء؟

28
00:02:34,170 --> 00:02:36,070
!مهلاً، أرى شيئًا ما

29
00:02:39,070 --> 00:02:42,340
!مصيبة! ثمّة سفينة ضخمة أمامنا

30
00:02:42,740 --> 00:02:45,210
!سانجي-كُن! تولّ المقود
!استدر إلى أقصى الميمنة

31
00:02:45,440 --> 00:02:47,210
!حالاً يا نامي-سان

32
00:02:47,650 --> 00:02:50,110
—حبّ سانجي المميّز سوف

33
00:02:51,680 --> 00:02:53,450
!هـ-هذا سيّئ

34
00:02:53,450 --> 00:02:56,450
!نحن محاصرون بسفن البحريّة، صحيح؟

35
00:02:56,450 --> 00:02:57,460
!مذهل

36
00:02:58,060 --> 00:03:02,130
حتّى البحريّة لا يستطيعون
التّحرّك في هذا الضّباب؟

37
00:03:02,490 --> 00:03:05,960
قد يكون من الأفضل لنا الهروب
.مستغلّين هذا الضّباب الكثيف

38
00:03:06,400 --> 00:03:07,570
.معك حقّ

39
00:03:07,570 --> 00:03:10,570
واصلوا التّوجّه للأمام
.ولنلزم الصّمت جميعًا

40
00:03:10,570 --> 00:03:11,570
.خاصّة أنت يا لوفي

41
00:03:11,570 --> 00:03:12,370
!حاضر

42
00:03:14,240 --> 00:03:15,240
...نامي-سان

43
00:03:16,570 --> 00:03:18,440
.انتظري للحظة

44
00:03:20,410 --> 00:03:23,110
.طفل؟ أتساءل ما الّذي يفعله

45
00:03:32,220 --> 00:03:33,220
!انتبه

46
00:03:33,220 --> 00:03:34,160
.دع الأمر لي

47
00:03:46,140 --> 00:03:48,940
إنّه بخير الآن. يبدو أنّ أملاح
.الشّمّ أدّت مفعولها

48
00:03:50,410 --> 00:03:51,680
أ-أين أنا؟

49
00:03:51,680 --> 00:03:54,150
.أنت على سفينة قراصنة لوفي

50
00:03:54,380 --> 00:03:55,750
!قـ-قراصنة؟

51
00:03:55,910 --> 00:03:56,780
.نعم

52
00:03:56,780 --> 00:04:00,620
هل تتذكّر أيّ شيء؟
.وقعتَ من سفينة البحريّة

53
00:04:04,320 --> 00:04:07,690
!تـ-تراجعوا! تنوون مهاجمة البحريّة، صحيح؟

54
00:04:07,990 --> 00:04:10,330
!ما باله؟ هل نسي أنّنا أنقذنا حياته؟

55
00:04:10,330 --> 00:04:12,400
.لا يمكنك لومه. إنّه من البحريّة

56
00:04:14,270 --> 00:04:15,730
.كُل شيئًا أوّلاً

57
00:04:15,730 --> 00:04:18,370
!لا أريده! لا أحتاج لمساعدة قراصنة

58
00:04:19,740 --> 00:04:23,070
ترفض شرب حساء أعدّه طبّاخ
على سفينة قراصنة، صحيح؟

59
00:04:23,540 --> 00:04:25,340
.إنّه ليس مسمومًا أو ما شابه

60
00:04:25,980 --> 00:04:29,280
.سترتاح بمجرّد أن تملأ معدتك ببعض الطّعام

61
00:04:31,420 --> 00:04:33,080
!هذا الحساء مذهل

62
00:04:33,520 --> 00:04:35,950
!لا أصدّق مدى صفاء هذا الكونسومي

63
00:04:52,470 --> 00:04:53,740
.شكرًا على الطّعام

64
00:04:54,240 --> 00:04:55,840
.بالهناء والشّفاء

65
00:04:55,840 --> 00:04:58,940
.أنا تاجيو. أنا طبّاخ متدرّب في البحريّة

66
00:04:59,180 --> 00:05:00,450
.أنا سانجي

67
00:05:00,610 --> 00:05:03,150
أنت طبّاخ إذًا؟

68
00:05:03,580 --> 00:05:07,520
سانجي-سان، إنّك تضيّع وقتك بالطّبخ
!على متن سفينة قراصنة متهالكة كهذه

69
00:05:07,520 --> 00:05:08,850
!مهاراتك لا مثيل لها

70
00:05:09,050 --> 00:05:12,320
ماذا قلت؟! هذه السّفينة
!ليست متهالكة

71
00:05:12,320 --> 00:05:15,590
نعم! هذه السّفينة من قرية
—سيروب حيث كنت أعيش

72
00:05:15,590 --> 00:05:16,690
أهي حلوة؟

73
00:05:16,690 --> 00:05:19,000
.لا، اسمها يعني شراب فحسب
،كانت هنالك فتاة تُدعى كايا

74
00:05:19,000 --> 00:05:22,170
،أعطتنا هذه السّفينة
!لذلك فهي غالية علينا

75
00:05:19,000 --> 00:05:22,170
...مهلاً، مهلاً، مهلاً، على رسلك

76
00:05:26,100 --> 00:05:27,810
...في الحقيقة، أنا

77
00:05:35,810 --> 00:05:38,180
سكبتُ الكاري الّذي كانوا
.سيتناولونه على الغذاء

78
00:05:39,150 --> 00:05:40,250
!أنا جدّ آسف

79
00:05:41,820 --> 00:05:43,120
.ستعدّه أنت

80
00:05:44,490 --> 00:05:46,120
أنت من سكبه، صحيح؟

81
00:05:46,120 --> 00:05:48,530
،لذلك إن كنت آسفًا فعلاً حيال ذلك

82
00:05:48,530 --> 00:05:52,700
فقم بإعداد الكاري ثانية
.ليقدّم وقت الغداء

83
00:05:53,630 --> 00:05:55,770
.كان الطّاهي على حقّ
.لا شكّ في ذلك

84
00:05:55,770 --> 00:05:56,940
.نعم

85
00:05:57,300 --> 00:06:00,440
،لذلك حاولتُ إعداده مرارًا وتكرارًا

86
00:06:00,440 --> 00:06:01,970
.لكنّ النّتيجة لا تكون جيّدة

87
00:06:02,210 --> 00:06:04,610
تاجيو-كُن، هل لديك أيّ خبرة في الطّبخ؟

88
00:06:04,610 --> 00:06:08,150
بدأت كطبّاخ متدرّب قبل
.ستّة أشهر فحسب

89
00:06:08,550 --> 00:06:10,620
.يجب أن تكون تلك مدّة كافية

90
00:06:11,050 --> 00:06:14,850
لا أستطيع! كلّ ما أفعله كلّ يوم
!هو غسل الأطباق وتقشير الخضروات

91
00:06:14,850 --> 00:06:17,390
!لم أقم بطبخ أيّ طعام فعليّ

92
00:06:18,460 --> 00:06:19,560
...والأسوأ من ذلك

93
00:06:20,990 --> 00:06:24,000
لدى كلّ قادة السّفن عادة

94
00:06:24,000 --> 00:06:27,530
بحيث يجتمعون مرّة كلّ أسبوع
.ويتناولون الكاري على الغداء

95
00:06:27,830 --> 00:06:31,470
.وسفينتنا هي من ستستضيفهم هذا الأسبوع

96
00:06:31,900 --> 00:06:36,570
كيف يُفترض للكاري الّذي أعدّه
أن يرتقي لأذواق كبار البحريّة؟

97
00:06:37,180 --> 00:06:39,240
.كاري البحريّة مشهور

98
00:06:39,240 --> 00:06:42,110
سمعتُ أنّ الطّهاة من كلّ السّفن
،يتنافسون مع بعضهم

99
00:06:42,110 --> 00:06:44,580
.ولكلّ واحد نكهته الخاصّة بسفينته

100
00:06:44,780 --> 00:06:46,990
فعلاً؟ يبدو ذلك لذيذًا، صحيح؟

101
00:06:47,320 --> 00:06:48,920
،بعد قضائك ستّة أشهر في المطبخ

102
00:06:48,920 --> 00:06:50,990
،إن لم تمتلك أيّ ثقة بنفسك

103
00:06:50,990 --> 00:06:53,930
.فعد واعتذر لطاهيك ثانية

104
00:06:54,790 --> 00:06:55,690
.مستحيل

105
00:06:56,690 --> 00:06:59,430
!إن أخبرتُه بذلك، سيطردني من السّفينة

106
00:06:59,860 --> 00:07:01,900
وهل يجب أن تكون على
تلك السّفينة بالتّحديد؟

107
00:07:01,900 --> 00:07:03,540
هل من سبب لذلك أو ما شابه؟

108
00:07:04,070 --> 00:07:04,970
...في الواقع

109
00:07:05,670 --> 00:07:06,440
...الأزرق

110
00:07:08,470 --> 00:07:10,010
!هل تعرفون بشأن الأزرق الكامل؟

111
00:07:13,810 --> 00:07:16,080
الأزرق الشّرقيّ والأزرق الغربيّ

112
00:07:16,080 --> 00:07:17,850
...والأزرق الجنوبيّ والأزرق الشّماليّ

113
00:07:18,280 --> 00:07:21,590
إنّه حيث تجتمع كلّ مأكولات
.هذه البحار الأربعة اللّذيذة

114
00:07:22,490 --> 00:07:26,060
وبصفتي طبّاخًا، فإنّه بحر من الكنوز
.أودّ زيارته يومًا ما

115
00:07:26,860 --> 00:07:30,460
،يسخر الطّبّاخون الكبار من حلمي هذا

116
00:07:30,730 --> 00:07:32,360
!لكنّي أؤمن بوجوده

117
00:07:32,800 --> 00:07:34,930
!واثق أنّ الأزرق الكامل موجود

118
00:07:35,470 --> 00:07:39,370
،إن كنتُ على متن سفينة حربيّة للبحريّة
فستزداد فرصي بالذّهاب إليه، صحيح؟

119
00:07:39,500 --> 00:07:42,740
لذلك... لذلك لا أستطيع
!ترك هذه السّفينة

120
00:07:43,210 --> 00:07:45,540
الأزرق الكامل؟ أليس ذاك...؟

121
00:07:51,250 --> 00:07:53,820
كم أودّ مغادرة هذا المكان
...بأسرع ما يمكننا

122
00:07:53,820 --> 00:07:58,120
،صحيح، إن اكتشفوا وجودنا
...فسيطلقون وابل هجمات علينا

123
00:07:58,790 --> 00:08:00,960
،لكن ونظرًا للظّروف الرّاهنة

124
00:08:00,960 --> 00:08:03,460
،علينا إعادة هذا الفتى لسفينته
صحيح يا سانجي-كُن؟

125
00:08:06,100 --> 00:08:08,300
،سأعيده إلى سفينته فحسب
.لا أكثر ولا أقلّ

126
00:08:08,830 --> 00:08:10,900
.لوفي، ساعدنا للصّعود

127
00:08:12,700 --> 00:08:16,340
!غومو غومو نوو: الحبل الرّابط

128
00:08:17,980 --> 00:08:19,840
.يا سانجي، أنا أمسك بالسّفينة الآن

129
00:08:20,180 --> 00:08:22,780
،بمجرّد حلول وقت الظّهيرة
.سينقشع هذا الضّباب

130
00:08:23,080 --> 00:08:25,920
.وإن تأخّرنا أكثر، فسنكون في خطر كبير

131
00:08:26,280 --> 00:08:27,420
.تلك مدّة كافية

132
00:08:28,450 --> 00:08:30,120
إلى أيّ حدّ تنوي مساعدته؟

133
00:08:30,420 --> 00:08:32,620
سألقي نظرة على الوضع بنفسي فحسب

134
00:08:32,620 --> 00:08:34,330
.لأرى كيف يبدو مطبخ سفينة تابعة للبحريّة

135
00:08:34,530 --> 00:08:35,660
!سانجي

136
00:08:37,030 --> 00:08:40,000
!حسنًا، تمسّكا جيّدًا

137
00:08:49,270 --> 00:08:51,840
بالمناسبة، لماذا أتيت معنا أيضًا؟

138
00:08:51,840 --> 00:08:53,610
وكيف كنتَ لتعود بدوني؟

139
00:08:53,950 --> 00:08:55,980
،إذًا انتظر هنا فحسب
.وأحسن التّصرّف

140
00:08:55,980 --> 00:08:56,850
.أ-أكيد

141
00:09:00,690 --> 00:09:02,020
.هذا هو المطبخ

142
00:09:02,520 --> 00:09:06,260
،نعم. أظنّني سألقي نظرة عليه
.بما أنّني هنا

143
00:09:13,400 --> 00:09:16,200
.هذا متوقّع من البحريّة
.هذه الأغراض غالية الثّمن

144
00:09:16,940 --> 00:09:19,100
.والأكثر من ذلك، جميعها في حالة جيّدة

145
00:09:20,970 --> 00:09:21,840
ما هذا؟

146
00:09:21,840 --> 00:09:23,310
.إنّه صادر من مخزن طعام السّفينة

147
00:09:27,110 --> 00:09:28,250
...أفزعني ذلك

148
00:09:28,810 --> 00:09:30,720
!لوفي! ما الّذي تفعله هنا؟

149
00:09:31,150 --> 00:09:33,650
!سانجي! أستطلع! أقوم بالاستطلاع

150
00:09:33,920 --> 00:09:36,350
.لا يحصل المرء على فرصة كهذه كلّ يوم

151
00:09:39,220 --> 00:09:41,760
.لذلك، سأقوم بالمزيد من الاستطلاع فحسب

152
00:09:41,760 --> 00:09:43,290
،افعل ما يحلو لك

153
00:09:43,290 --> 00:09:45,830
،لكن إن وجدتك البحريّة
.فلن يتساهلوا معك

154
00:09:45,830 --> 00:09:46,560
...وأيضًا

155
00:09:47,330 --> 00:09:49,370
.اترك ما حشوت به جيوبك هنا

156
00:09:50,300 --> 00:09:51,470
إنّه تفّاح، صحيح؟

157
00:09:55,270 --> 00:09:57,310
.هذا هو كاري البحريّة

158
00:10:03,750 --> 00:10:06,020
...عندما كنتُ في المطعم البحريّ

159
00:10:07,790 --> 00:10:10,890
.لم يُعلّمني المالك زيف أيّ شيء

160
00:10:14,690 --> 00:10:18,760
يومًا بعد آخر، كلّ ما جعلني
.أفعله هو غسل الأطباق

161
00:10:21,870 --> 00:10:23,170
!أيّها الشّقيّ

162
00:10:23,900 --> 00:10:27,370
.عليك فعل ما هو أكثر من بذل جهدك

163
00:10:27,770 --> 00:10:30,110
لِمَ تظنّ أنّني أسمح لك
بالتّواجد في مطبخي

164
00:10:30,110 --> 00:10:33,210
وأطلب منك القيام بأعمال روتينيّة
!لنصف سنة أو سنة تقريبًا؟

165
00:10:33,210 --> 00:10:35,050
!فاستعمل رأسك ذاك وفكّر مليًّا

166
00:10:41,150 --> 00:10:44,590
،ذلك ما أخبرني به زيف
.بينما كان عدم الرّضا باديًا عليّ

167
00:10:45,190 --> 00:10:50,030
فهمت. سمح لي الطّاهي بالتّواجد
.هنا لأتعلّم مهاراته في الطّبخ

168
00:10:51,400 --> 00:10:53,700
.الطّبخ ليس أمرًا يمكن تعليمه ببساطة

169
00:10:59,300 --> 00:11:01,710
!سانجي-سان، سوف أجرّب بنفسي

170
00:11:04,740 --> 00:11:08,750
لنرَ... ما الّذي كان يقوله الطّاهي؟

171
00:11:09,880 --> 00:11:13,380
الوصفة الأساسيّة للكاري هي
.المسحوق والحساء والمكوّنات

172
00:11:13,890 --> 00:11:16,420
!يمزج مسحوق الكاري خاصّته بعناية

173
00:11:18,660 --> 00:11:20,260
...يا لها من رائحة

174
00:11:21,060 --> 00:11:22,730
،يأخذون مسحوق كاري معدّ سلفًا

175
00:11:22,730 --> 00:11:25,730
.ويضيفون له بعض الغارام ماسالا الطّازج

176
00:11:32,270 --> 00:11:35,840
لا تكن كسولاً لدرجة أن تستعمل
!المسحوق المعدّ سلفًا فحسب

177
00:11:37,040 --> 00:11:39,880
!إنّ نكهة التّوابل تتناقص يومًا بعد يوم

178
00:11:41,410 --> 00:11:42,910
!إنّه الغارام ماسالا

179
00:11:51,390 --> 00:11:53,630
.حاسّة شمّه جيّدة

180
00:12:19,680 --> 00:12:21,520
!إنّها ضخمة

181
00:12:21,950 --> 00:12:23,290
...في هذا الضّباب

182
00:12:23,720 --> 00:12:25,390
.لن نتحرّك لوقت طويل

183
00:12:26,890 --> 00:12:29,030
.على الأرجح أنّه سينقشع عند الظّهيرة

184
00:12:29,460 --> 00:12:31,860
بالمناسبة، هل سمعت
عن اجتماع الغداء المعتاد؟

185
00:12:32,530 --> 00:12:35,830
نعم، وعن أنّ الطّبّاخ المتدرّب
تاجيو هو من يعدّه؟

186
00:12:35,830 --> 00:12:38,600
.أتساءل ما الّذي سيطعمه لنا بالتّحديد

187
00:12:38,740 --> 00:12:39,840
!لا شكّ في ذلك

188
00:12:43,610 --> 00:12:44,610
،بالنّسبة للمرق

189
00:12:44,610 --> 00:12:47,510
بإمكاني استعمال أشياء جاهزة
.سلفًا تمّ غليها بشكل مكثّف

190
00:12:49,050 --> 00:12:50,950
.والآن، حان وقت تجهيز المكوّنات

191
00:12:53,280 --> 00:12:56,150
.أوّلاً، عليّ تقطيع لحم البقر وأقليه

192
00:13:07,170 --> 00:13:11,000
ثمّة نوع من كاري لحم
البقر حيث نجد عصارته

193
00:13:11,000 --> 00:13:13,610
.مخزّنة في لحم البقر نفسه

194
00:13:14,270 --> 00:13:16,610
لكنّ استنادًا على نكهة
،الكاري الخفيفة هذه

195
00:13:16,610 --> 00:13:18,910
فإنّه ليس من النّوع الّذي يُبقي
،جوهر اللّحم بداخله

196
00:13:18,910 --> 00:13:21,510
.بل يسمح له بالذّوبان خارجًا في الحساء

197
00:13:22,380 --> 00:13:27,490
.في تلك الحالة، فإنّ الفتى أخطأ من البداية

198
00:13:30,360 --> 00:13:31,260
هل من خطب ما؟

199
00:13:35,260 --> 00:13:39,130
يا فتى، الطّبخ ليس شيئًا
.عليك القيام به بعجالة

200
00:13:40,570 --> 00:13:44,300
تذكّروا، يعتمد كلّ شيء
.في الطّبخ على التّحضيرات

201
00:13:44,870 --> 00:13:48,340
.التّأنّي ضروريّ. هذا كلّ شيء

202
00:13:56,850 --> 00:13:57,980
...سأضيف الثّوم

203
00:13:59,750 --> 00:14:00,750
...والزّنجبيل

204
00:14:02,720 --> 00:14:04,160
،والكركم

205
00:14:05,020 --> 00:14:07,060
.ثمّ بعض الزّبادي

206
00:14:42,460 --> 00:14:44,260
.بهذا أكون اهتممتُ بالتّحضيرات

207
00:14:46,000 --> 00:14:47,830
.والآن، عليّ قلي البصل

208
00:15:05,980 --> 00:15:07,950
!كيف تدخّن في مكان أعدُّ فيه الطّعام؟

209
00:15:08,390 --> 00:15:10,260
!هل تعتقد أنّ ذلك مقبول كطبّاخ؟

210
00:15:10,620 --> 00:15:13,420
قلتُ سابقًا أنّك أفضل بكثير
،من أن تطبخ على سفينة قراصنة

211
00:15:14,130 --> 00:15:15,230
!لكنّني أسحب كلامي

212
00:15:15,660 --> 00:15:19,200
.يا ويحي، لقد حرقت شعري

213
00:15:28,240 --> 00:15:31,480
تذكّروا أن تقلوا البصل
.بشكل وجيز على نار قويّة

214
00:15:31,980 --> 00:15:33,950
.واصلوا تحريكه، لكي لا يحترق

215
00:15:34,450 --> 00:15:36,780
،بمجرّد أن يصبح البصل ناعمًا
.قلّلوا من النّار تحته

216
00:15:37,250 --> 00:15:40,250
قوموا بذلك ببطء ولطف
،بينما يُطهى فوق نار خفيفة

217
00:15:40,250 --> 00:15:42,050
.إلى أن يكتسب لونًا ذهبيًّا بنّيًّا

218
00:15:42,050 --> 00:15:43,350
أفهمتم؟

219
00:15:45,160 --> 00:15:48,960
كان سانجي-سان يحذّرني
...بشأن مستوى النّار

220
00:16:05,080 --> 00:16:07,480
.كم هذا مرتفع

221
00:16:07,710 --> 00:16:10,450
.المنظر من هنا مختلف تمامًا

222
00:16:13,820 --> 00:16:14,990
!مـ-من أنت؟

223
00:16:14,990 --> 00:16:16,820
!كُشف أمري

224
00:16:17,060 --> 00:16:18,090
!تمهّل

225
00:16:18,090 --> 00:16:19,760
!لن أتمهّل أبدًا

226
00:16:23,130 --> 00:16:24,860
...سأذيب بعض شحم الخنزير

227
00:16:26,230 --> 00:16:27,830
...وأضيف الدّقيق

228
00:16:29,800 --> 00:16:32,670
...وأحرّك بلطف حتّى لا يحترق

229
00:16:37,910 --> 00:16:39,340
...ثمّ سأضيف مسحوق الكاري

230
00:16:40,410 --> 00:16:43,280
إضافة إلى غارام ماسالا لتعزيز النّكهة

231
00:16:48,890 --> 00:16:51,720
...ثمّ ولجمع كلّ المكوّنات معًا

232
00:16:55,090 --> 00:16:56,490
...سأضيف المرق

233
00:16:58,930 --> 00:16:59,830
...ثمّ الطّماطم

234
00:17:05,770 --> 00:17:07,270
...والبصل أيضًا

235
00:17:11,980 --> 00:17:13,680
.وسأضيف اللّحم المتبّل

236
00:17:36,970 --> 00:17:38,340
...ثمّة خطب ما

237
00:17:39,770 --> 00:17:40,970
.لا قوام له

238
00:17:44,910 --> 00:17:47,580
.واضح تمامًا أنّني عاجز

239
00:17:54,690 --> 00:17:55,950
!...نكهات خفيّة

240
00:17:57,120 --> 00:17:58,220
!سانجي-سان

241
00:18:04,530 --> 00:18:05,800
...يا لحلاوة

242
00:18:07,530 --> 00:18:08,670
.هذه التّفّاحة

243
00:18:10,700 --> 00:18:11,640
...سانجي-سان

244
00:18:13,400 --> 00:18:14,770
.شكرًا جزيلاً لك

245
00:18:14,770 --> 00:18:16,040
علام تشكرني؟

246
00:18:17,280 --> 00:18:20,610
.لم أفعل أيّ شيء يتطلّب الشّكر

247
00:18:21,110 --> 00:18:23,980
سانجي-سان، تظاهرت بمجيئك
،لتفقّد السّفينة فحسب

248
00:18:23,980 --> 00:18:26,120
.لكنّك كنت تحاول تعليمي

249
00:18:26,280 --> 00:18:27,620
.لا تسئ الفهم

250
00:18:27,620 --> 00:18:30,120
!هناك! لقد هرب إلى هناك

251
00:18:31,090 --> 00:18:33,790
!سانجي! لنذهب

252
00:18:34,060 --> 00:18:35,460
...ذلك الغبيّ

253
00:18:36,090 --> 00:18:37,230
!تمهّل

254
00:18:38,030 --> 00:18:39,660
...غومو غومو نوو

255
00:18:39,900 --> 00:18:41,400
!الحبل الرّابط

256
00:18:43,430 --> 00:18:44,240
!حسنًا

257
00:18:44,440 --> 00:18:45,640
!تمسّك

258
00:18:48,010 --> 00:18:48,970
...تاجيو

259
00:18:49,770 --> 00:18:51,410
.أعتقد أنّه موجود أيضًا

260
00:18:52,480 --> 00:18:53,980
.الأزرق الكامل

261
00:18:55,150 --> 00:18:56,510
!سانجي! تمسّك

262
00:18:56,510 --> 00:18:57,280
!حالاً

263
00:19:07,760 --> 00:19:10,900
يا تاجيو، كان هنالك رجل
مريب هنا للتّوّ، صحيح؟

264
00:19:10,900 --> 00:19:11,900
إلى أين ذهب؟

265
00:19:11,900 --> 00:19:13,830
.ماذا؟ لا أدري

266
00:19:13,830 --> 00:19:15,600
أواثق أنّك لا تتخيّل الأمر فحسب؟

267
00:19:15,870 --> 00:19:18,570
واصلوا البحث! لا بدّ أنّه يختبئ
!في مكان ما على السّفينة

268
00:19:19,100 --> 00:19:20,410
!جدوه

269
00:19:26,740 --> 00:19:27,880
!...أيّها الـ

270
00:19:27,880 --> 00:19:30,250
هل تحمل ضغينة ما ضدّي؟

271
00:19:30,620 --> 00:19:31,550
.آسف

272
00:19:31,980 --> 00:19:34,590
!كلاّ، لا يبدو الأسف على وجهك

273
00:19:34,590 --> 00:19:35,650
.لذلك السّبب أنا آسف

274
00:19:35,920 --> 00:19:37,490
!...سأقطّعك لشرائح

275
00:19:39,190 --> 00:19:40,460
ما الخطب يا لوفي؟

276
00:19:41,190 --> 00:19:44,130
!لقد ألحقت ضررًا بغوينغ ميري ثانية

277
00:19:44,460 --> 00:19:46,730
!أوسوبّ، نامي، آسف

278
00:19:46,730 --> 00:19:49,900
كشفت البحريّة أمري، لذلك
.كان علينا المجيء بسرعة

279
00:19:50,270 --> 00:19:53,300
!ماذا؟! مـ-مهلاً، ما الّذي تقصده بذلك؟

280
00:19:53,300 --> 00:19:56,770
!إنّها سفينة غالية أهدتها لنا كايا

281
00:19:56,770 --> 00:19:59,080
!كم مرّة عليّ إخبارك بذلك؟

282
00:19:59,080 --> 00:20:00,180
!لا يمكننا البقاء هنا طويلاً

283
00:20:00,180 --> 00:20:02,350
،أوسوبّ، سانجي-كُن
!سنغادر في الحال

284
00:20:02,350 --> 00:20:03,850
!حالاً يا نامي-سان

285
00:20:03,850 --> 00:20:06,120
...كلاّ، لا يمكنني التّحرّك

286
00:20:21,500 --> 00:20:22,430
.قدّمه

287
00:20:22,730 --> 00:20:23,540
!حاضر

288
00:20:38,550 --> 00:20:40,850
.استمتعوا بوجبتكم رجاءً

289
00:20:52,960 --> 00:20:55,230
.هذا لذيذ

290
00:20:55,230 --> 00:20:56,940
إنّه كثيف بما يكفي والنّكهة الحارّة

291
00:20:56,940 --> 00:20:58,440
.تنتشر عبر فمي كلّه

292
00:20:58,440 --> 00:21:00,840
...اللّحم ناعم جدًّا

293
00:21:00,840 --> 00:21:02,770
!أريد المزيد في الحال

294
00:21:04,080 --> 00:21:05,040
...تاجيو

295
00:21:05,040 --> 00:21:06,210
!نعم أيّها الطّاهي

296
00:21:06,610 --> 00:21:09,310
.احرص على التّنظيف

297
00:21:10,180 --> 00:21:11,750
!حا-حاضر

298
00:21:23,730 --> 00:21:24,800
...سانجي-سان

299
00:21:28,370 --> 00:21:31,500
.أعتقد أنّه موجود أيضًا... الأزرق الكامل

300
00:21:42,610 --> 00:21:44,280
،سأعمل بجدّ أكبر

301
00:21:44,950 --> 00:21:48,520
ويومًا ما، سأصبح طبّاخًا جيّدًا
.مثلك يا سانجي-سان

302
00:21:55,060 --> 00:22:03,230
آه، خلف السّماء الّتي لا نهاية لها

303
00:22:03,230 --> 00:22:13,850
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

304
00:22:21,720 --> 00:22:29,160
مرّت عليّ أيّام كدت أخسر فيها نفسي

305
00:22:29,160 --> 00:22:37,570
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

306
00:22:37,570 --> 00:22:45,780
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

307
00:22:45,780 --> 00:22:54,620
دفعوا بي للأمام، أليس كذلك؟

308
00:22:54,620 --> 00:23:02,960
آه، إنّ النّجوم تهوي من السّماء

309
00:23:02,960 --> 00:23:06,060
...وهذه اللّحظة الفريدة

310
00:23:13,570 --> 00:23:16,940
إنّ الألعاب النّاريّة رائعة، صحيح؟
!إنّها جميلة جدًّا

311
00:23:16,940 --> 00:23:20,210
.كم أريد إطلاق بعض منها
ماذا؟ ستسمح لي بذلك؟

312
00:23:20,210 --> 00:23:24,120
،أنا جدّ سعيد! والأكثر من ذلك
!ستسمح لي بإطلاق الكبيرة؟

313
00:23:24,120 --> 00:23:26,720
مذهل! ولكن، أليست هذه كبيرة جدًّا؟

314
00:23:27,050 --> 00:23:28,420
:في الحلقة القادمة من ون بيس

315
00:23:28,420 --> 00:23:31,790
سأجعلها تتفتّح! الرّجل أوسوبّ"
".وكرة الثّمانية شاكو

316
00:23:31,790 --> 00:23:34,350
!ملك القراصنة، لن يكون إلاّ أنا