1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,160 --> 00:03:24,500
.فقد لوفي أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:24,500 --> 00:03:28,990
ثمّ بعث رسالة لطاقمه بطريقة
.ما كان أحد غيرهم ليفهمها

39
00:03:32,400 --> 00:03:36,370
.آمل أن يفهموا الرّسالة

40
00:03:36,370 --> 00:03:38,830
.سيفهمونها إن رأوا المقالة

41
00:03:39,500 --> 00:03:43,960
.سيفهمون رسالتك جيّدًا. لديّ شعور بذلك

42
00:03:43,960 --> 00:03:46,920
!أجل! فهمت يا لوفي

43
00:03:48,050 --> 00:03:52,180
!فهمت الآن! أجل! أجل

44
00:03:53,060 --> 00:03:55,220
.فهمت. هكذا الأمر إذًا

45
00:03:56,000 --> 00:03:58,230
.عُلم يا لوفي

46
00:03:58,230 --> 00:04:04,190
!فهمت يا لوفي

47
00:04:00,810 --> 00:04:02,310
!فهمت

48
00:04:04,600 --> 00:04:08,780
،يا إلهي! إنّه لا يفكّر في مشاعرنا
!يا له من أنانيّ

49
00:04:09,400 --> 00:04:10,700
!فهمت

50
00:04:10,700 --> 00:04:13,160
نعم، أهذا كلّ شيء؟

51
00:04:13,620 --> 00:04:16,540
.لا يقوم لوفي بأمور كهذه

52
00:04:16,540 --> 00:04:20,160
.إنّه مع ريلي، لا بدّ أنّها كانت فكرته

53
00:04:20,160 --> 00:04:21,960
.أعلم أنّ هنالك رسالة ما

54
00:04:28,920 --> 00:04:33,100
!يبدأ القراصنة تحرّكهم"
"!العالم الجديد الّذي لا نظير له

55
00:04:37,890 --> 00:04:40,560
،بما أنّ عصر اللّحية البيضاء قد ولّى

56
00:04:40,560 --> 00:04:44,650
.بدأ القراصنة الطّموحين بالتّحرّك بطرق جريئة

57
00:04:45,160 --> 00:04:48,530
...على عكس ترافالغار لو

58
00:04:49,070 --> 00:04:51,320
!ماذا؟! لن نذهب إلى هناك بعد؟

59
00:04:51,320 --> 00:04:53,450
!لنذهب للعالم الجديد بسرعة

60
00:04:54,070 --> 00:04:57,170
إلى متى سنظلّ في هذه المياه؟

61
00:04:57,170 --> 00:04:59,160
ما الّذي تنتظره أيّها القبطان؟

62
00:05:00,080 --> 00:05:03,370
.قلتُ أنّنا سننتظر وقتنا

63
00:05:03,370 --> 00:05:04,830
.لا تقلقوا

64
00:05:04,830 --> 00:05:08,130
.لن يبارح كنز وان بيس العظيم مكانه

65
00:05:08,130 --> 00:05:12,680
لكنّ اللّحية السّوداء بدأ تحرّكاته في العالم الجديد

66
00:05:12,680 --> 00:05:17,260
!وهنالك إشاعات تقول أنّه دمّر طاقم قراصنة

67
00:05:17,260 --> 00:05:20,480
والنّاشئون الأقوياء الّذين يريدون أن يصيروا من اليونكو

68
00:05:20,480 --> 00:05:22,270
!يتدافعون إلى العالم الجديد

69
00:05:22,270 --> 00:05:27,150
!لا وقت لدينا لنضيّعه
!سيهزمنا الجميع هكذا يا قبطان

70
00:05:27,610 --> 00:05:31,400
.من الأفضل بالنّسبة لنا إن حاولوا القضاء على بعضهم

71
00:05:31,400 --> 00:05:34,050
.لن نتورّط في أيّ قتالات مثيرة للشّفقة كتلك

72
00:05:35,410 --> 00:05:39,240
.كفاكم ثرثرة واتبعوني فحسب

73
00:05:39,240 --> 00:05:42,080
!سنحصل على مبتغانا بأيّ ثمن

74
00:05:42,080 --> 00:05:43,870
!أيّها القبطان

75
00:05:43,870 --> 00:05:45,540
!سنتبعك للأبد

76
00:05:46,380 --> 00:05:50,600
...نعم يا قبطان! يمكنك الاعتماد عليّ

77
00:05:51,260 --> 00:05:52,420
!يتكلّم في نومه؟

78
00:05:52,840 --> 00:05:53,800
.آسف

79
00:05:53,800 --> 00:05:56,090
!لا تعتذر وأنت نائم

80
00:06:01,280 --> 00:06:05,310
!الجوّ بارد! سيتجمّد جسدي

81
00:06:05,310 --> 00:06:08,090
أهنالك أيّ أحد في مكان كهذا؟

82
00:06:16,740 --> 00:06:17,820
!ما هذا؟

83
00:06:17,820 --> 00:06:19,620
!ثمّة شيء ما يهوي من السّماء

84
00:06:20,900 --> 00:06:22,500
!كلاّ! اهربوا

85
00:06:30,560 --> 00:06:32,090
!يا رفاق، هل أنتم بخير؟

86
00:06:33,170 --> 00:06:35,050
.أنا بخير

87
00:06:35,050 --> 00:06:38,050
تبًّا! ما الّذي يحدث على هذه الجزيرة؟

88
00:06:38,680 --> 00:06:41,350
!أيّها القبطان، لنغادر هذه الجزيرة

89
00:06:41,350 --> 00:06:44,300
!لا أظنّ أنّ هنالك من يعيش هنا

90
00:06:44,300 --> 00:06:46,440
لا تظنّ ذلك؟

91
00:06:46,440 --> 00:06:49,440
.يمكن لأيّ شيء أن يحدث في هذا البحر

92
00:06:49,440 --> 00:06:50,520
.انظر

93
00:06:50,980 --> 00:06:54,110
ما قصّة كتلة الثّلج الدّائريّة هذه؟

94
00:06:54,110 --> 00:06:56,320
!الأوتاد الجليديّة عالقة فيها

95
00:06:59,700 --> 00:07:02,490
!إنّها ليست كتلة ثلج! إنّها قبّة حديديّة

96
00:07:08,480 --> 00:07:10,330
!انظروا! إنّ القبّة تُفتح

97
00:07:30,070 --> 00:07:34,570
.لم أتوقّع رؤية بلدة في القبّة

98
00:07:40,070 --> 00:07:45,160
.يحبّ اليونكو كايدو-ساما الشّهير هذه الجزيرة

99
00:07:45,160 --> 00:07:47,250
.أنا مكلّف بالأمن فيها

100
00:07:47,790 --> 00:07:49,870
وبعد؟ ماذا تريد منّا؟

101
00:07:49,870 --> 00:07:54,420
.لا شيء. حذّرتكم فحسب

102
00:07:54,420 --> 00:07:58,720
.من الأفضل ألاّ تغضبه أيّها النّاشئ

103
00:07:58,720 --> 00:08:01,460
،تعني أنّني إن قتلتك أو ما شابه

104
00:08:01,460 --> 00:08:03,470
فلن يتركني كايدو وشأني؟

105
00:08:03,470 --> 00:08:06,770
...هذا صحيح. فلماذا لا

106
00:08:06,770 --> 00:08:08,430
!يسهّل هذا الأمر عليّ

107
00:08:10,020 --> 00:08:14,940
!ماذا؟ فاكهة زون قديمة؟ كم هذا نادر

108
00:08:23,320 --> 00:08:26,680
!خدش! انفجار

109
00:08:28,250 --> 00:08:30,250
!اسمعوا

110
00:08:34,250 --> 00:08:36,840
!كان ذلك مزعجًا

111
00:08:36,840 --> 00:08:38,720
!هذا هو القبطان أبو

112
00:08:38,720 --> 00:08:40,480
!كم يُعتمد عليك

113
00:08:48,560 --> 00:08:50,520
!ما زال كلّ هذا العدد منها؟

114
00:08:50,520 --> 00:08:52,310
!هذا غير معقول

115
00:08:52,310 --> 00:08:54,230
...كلاّ

116
00:08:54,230 --> 00:08:59,610
!لا تقلقوا يا رفاق! سينقذنا القبطان أبو

117
00:08:59,610 --> 00:09:01,110
!اسمعوا يا رجال

118
00:09:01,110 --> 00:09:02,200
!نعم

119
00:09:02,200 --> 00:09:03,160
!لنهرب

120
00:09:03,160 --> 00:09:04,240
!ماذا؟

121
00:09:05,990 --> 00:09:10,370
!لا يمكنني هزيمة مجموعة كبيرة من الخنازير العنيفة

122
00:09:12,160 --> 00:09:15,460
!أيّها القبطان، ثمّة نهاية مسدودة أمامنا

123
00:09:15,460 --> 00:09:17,300
!أنقذوا أنفسكم كيفما تستطيعون

124
00:09:18,760 --> 00:09:21,010
!كلاّ! نحن هالكون

125
00:09:21,010 --> 00:09:21,920
!لا تستسلموا

126
00:09:21,920 --> 00:09:24,960
!سنسقط في المياه

127
00:09:24,960 --> 00:09:26,930
!لا يهمّ! اقفزوا

128
00:09:26,930 --> 00:09:29,180
!ماذا؟

129
00:09:29,180 --> 00:09:30,270
ماذا؟

130
00:09:30,270 --> 00:09:34,060
!أيّها القبطان! نحن نركض في الهواء

131
00:09:34,060 --> 00:09:36,270
!إنّ الخنازير تركض خلفنا في الهواء أيضًا

132
00:09:36,270 --> 00:09:41,610
!بإمكاني رؤية ذلك! ما خطب هذه الجزيرة؟

133
00:09:44,110 --> 00:09:46,570
!هذا ساخن

134
00:09:46,740 --> 00:09:51,450
سان خوان ولف

135
00:09:47,160 --> 00:09:49,450
.ما عادت قدماي تتحمّلان

136
00:09:49,950 --> 00:09:52,960
.جسدي متعب

137
00:09:52,960 --> 00:09:55,880
.هذا مؤلم، عضّتني سمكة ما

138
00:09:56,500 --> 00:09:59,050
!كفّ عن الشّكوى يا ولف

139
00:09:59,050 --> 00:10:02,170
.كاد الطّوف يُكسر بسببك

140
00:10:02,170 --> 00:10:04,510
.لهذا السّبب نقوم بهذا

141
00:10:04,510 --> 00:10:10,640
كان تهوّرًا منّا محاولة عبور العالم
.الجديد بالطّوف في المقام الأوّل

142
00:10:11,470 --> 00:10:15,900
.كان علينا أخذ سفينة من سفن البحّرية في مارينفورد

143
00:10:15,900 --> 00:10:19,570
.لكنّك تتعلّق بالأشياء كثيرًا

144
00:10:19,730 --> 00:10:24,070
.إنّكم لا تتجهّزون لأيّ شيء

145
00:10:24,070 --> 00:10:26,180
!دعوني أتولّى الأمر

146
00:10:26,180 --> 00:10:28,910
أتريدني أن أصير القبطان يا تيتش؟

147
00:10:30,240 --> 00:10:32,180
.اخرس وإلاّ قتلتك

148
00:10:32,180 --> 00:10:34,210
.نحن قراصنة اللّحية السّوداء

149
00:10:34,210 --> 00:10:39,540
...تعلم السّماء ما الّذي سيحدث لنا

150
00:10:42,050 --> 00:10:43,550
!أحتاج للمزيد من السّاكي

151
00:10:43,550 --> 00:10:46,590
هلاّ ذهبنا إلى جزيرة ما عليها بلدة؟

152
00:10:48,660 --> 00:10:52,590
!نعم، أنا أفضّل ملابس رائعة بدل سفينة

153
00:10:52,590 --> 00:10:54,600
.لقد سئمت ملابس السّجن

154
00:10:54,600 --> 00:10:56,850
.عليك أن تعتادي

155
00:10:56,850 --> 00:10:59,730
.لا يمكنني أن أعتاد عليها للأبد

156
00:10:59,730 --> 00:11:03,280
!ولا أنا! إلى متى سننتظر؟

157
00:11:03,640 --> 00:11:06,070
هل البحريّة قادمة؟

158
00:11:06,450 --> 00:11:10,120
سأذهب لإلقاء نظرة. لا يمكن
.أن يكونوا بطيئين لهذه الدّرجة

159
00:11:10,520 --> 00:11:11,870
!كلامك صحيح

160
00:11:11,870 --> 00:11:14,910
.إنّ هؤلاء قد بدؤوا يسأمون الانتظار

161
00:11:18,340 --> 00:11:21,920
أليس كذلك يا جولري بوني؟

162
00:11:22,040 --> 00:11:23,620
...أيّتها القبطانة بوني

163
00:11:28,400 --> 00:11:33,470
لا أصدّق أنّهم وضعوا مكافأة تزيد
!عن 100 مليون على رأس فتاة مثلك

164
00:11:34,030 --> 00:11:37,390
.العالم الجديد بحر المختارين الأقوياء

165
00:11:37,390 --> 00:11:40,900
،رغم أنّك قطعت مسافة طويلة من الأزرق الجنوبيّ

166
00:11:40,900 --> 00:11:43,720
.فلا يمكنك التّقدّم أكثر

167
00:11:48,420 --> 00:11:51,700
...أنت ضعيفة جدًّا لتنضمّي لطاقمي

168
00:11:51,700 --> 00:11:56,000
لكن ما رأيك؟ يمكنك المجيء معي
.إن كنت تريدين أن تصيري فتاتي

169
00:11:57,330 --> 00:12:00,250
إلى البحر الّذي أمامنا... موافقة؟

170
00:12:00,810 --> 00:12:02,670
!سُحقًا لك

171
00:12:02,670 --> 00:12:04,210
!خنزير ملتحي

172
00:12:06,090 --> 00:12:07,990
.لقد رفضته

173
00:12:08,720 --> 00:12:13,220
!لا فائدة! أنت بذيئة
!على النّساء التّحلّي بالاحترام

174
00:12:13,220 --> 00:12:16,520
!لديّ أعضاء طاقم بذيئين سلفًا

175
00:12:16,520 --> 00:12:19,350
!شكرًا لقولك ذلك

176
00:12:21,440 --> 00:12:24,430
لنسلّمها للبحريّة فحسب

177
00:12:24,430 --> 00:12:27,320
!ونأخذ سفينة في المقابل كما خطّطنا

178
00:12:27,320 --> 00:12:30,200
.أيّها القبطان. البحريّة قادمة

179
00:12:30,720 --> 00:12:33,390
هل أحضروا سفينة لنا؟

180
00:12:33,390 --> 00:12:36,200
.أحضروا واحدة، لكن لا أظنّهم سيمنحوننا إيّاها

181
00:12:36,520 --> 00:12:38,660
ماذا؟ كيف عرفت ذلك؟

182
00:12:40,670 --> 00:12:42,330
.لأنّ أكاينو على متنها

183
00:12:42,670 --> 00:12:45,920
.تبًّا! ذلك ليس ما أريد الآن

184
00:12:45,920 --> 00:12:48,340
!لنهرب يا رفاق

185
00:12:50,010 --> 00:12:51,800
!أخفقنا بشدّة

186
00:12:55,530 --> 00:12:57,100
أين اللّحية السّوداء؟

187
00:12:57,100 --> 00:12:58,470
!لقد غادر

188
00:12:58,760 --> 00:13:02,100
،عندما سمعت أنّك هربت من الحكومة

189
00:13:02,100 --> 00:13:03,850
.تجمّدت الدّماء في عروقي

190
00:13:05,400 --> 00:13:08,280
.لكنّ كلّ شيء انتهى الآن

191
00:13:09,940 --> 00:13:13,200
!أيّها الأوغاد! لن أسامحكم

192
00:13:19,830 --> 00:13:21,040
اختفى؟

193
00:13:21,040 --> 00:13:24,250
.نعم، بكلّ صراحة

194
00:13:25,060 --> 00:13:28,590
!فكرة من كانت هذه؟ سنغوكو؟

195
00:13:28,960 --> 00:13:32,630
!لا، شخص أعلى مرتبة من ذلك

196
00:13:35,470 --> 00:13:40,020
.لم يكن تعبيرًا مجازيًّا. لقد اختفى بمعنى الكلمة

197
00:13:40,940 --> 00:13:45,100
كنتُ متفاجئًا. أتلك هي قوّة فاكهة الظّلال؟

198
00:13:45,100 --> 00:13:46,690
!هذه ليست مزحة

199
00:13:46,690 --> 00:13:51,240
.لا تقلق. كان يحتضر

200
00:13:51,240 --> 00:13:53,530
.لا يوجد ما قد ينقذ حياته

201
00:13:53,530 --> 00:13:57,840
.هذا صحيح. إلاّ إذا عاد كزومبي

202
00:13:58,450 --> 00:14:00,620
!لإنّه يبدو كذلك بالفعل

203
00:14:00,620 --> 00:14:03,540
!قمت بعمل ناقص

204
00:14:03,830 --> 00:14:07,130
!لا تغترّ بنفسك

205
00:14:07,130 --> 00:14:10,500
متى صرت زعيمًا عليّ؟

206
00:14:10,500 --> 00:14:15,680
!لا يهمّ كم تبلغ سلطتك في الحكومة، أظلّ قرصانًا

207
00:14:15,680 --> 00:14:17,700
!لا شيء يهمّ في نظري

208
00:14:18,610 --> 00:14:24,560
،عندما لا يعود لي أهمّيّة بالعمل معكم
!فسأتخلّى عن لقب الشّيتشيبوكاي في أيّ وقت

209
00:14:25,040 --> 00:14:27,560
.إيّاك أن تنسى ذلك

210
00:14:47,000 --> 00:14:50,290
...أثناء ذلك في مملكة تورينو

211
00:14:50,290 --> 00:14:55,640
بدأ كلّ واحد من طاقم قبّعة القشّ
...التّحرّك في أماكن مختلفة أيضًا

212
00:14:57,510 --> 00:15:00,800
.رحل التّانوكي عنّا

213
00:15:04,590 --> 00:15:07,850
.تتشاركنا الطّيور نفس الإحساس

214
00:15:07,850 --> 00:15:13,650
!نتطلّع لرؤيتك ثانية أيّها التّانوكي

215
00:15:15,570 --> 00:15:19,150
.حسنًا، لنعد للعمل

216
00:15:27,280 --> 00:15:29,460
ماذا؟ ما كان ذلك؟

217
00:15:30,060 --> 00:15:31,610
!...إنّه

218
00:15:31,610 --> 00:15:33,170
!عاد الطّائر

219
00:15:33,170 --> 00:15:35,130
!ماذا؟ عاد مبكّرًا جدًّا

220
00:15:37,300 --> 00:15:40,300
.ماذا؟ لا أرى التّانوكي

221
00:15:40,300 --> 00:15:41,720
ماذا حدث للتّانوكي؟

222
00:15:41,720 --> 00:15:44,890
!ربّما وقع في البحر

223
00:15:44,890 --> 00:15:48,020
...هذا سيّئ! لنذهب للبحث

224
00:15:51,060 --> 00:15:53,110
!مـ-من هذا؟

225
00:15:53,400 --> 00:15:59,170
،في الحقيقة، بهدف الدّفاع عن السّلام في العالم

226
00:15:59,170 --> 00:16:04,660
!أحارب الشّرّ لأنّني بطل العدالة، تشوبّر المقنّع

227
00:16:08,540 --> 00:16:10,870
!الـ-التّانوكي

228
00:16:10,870 --> 00:16:15,050
،"أعلم أنّي قلت "زرنا ثانية
لكن ألم يحن ذلك أسرع من المتوقّع؟

229
00:16:15,050 --> 00:16:17,680
!لا، أنت مخطئ! أنا لست هو

230
00:16:17,680 --> 00:16:21,840
!ربّما نتشابه، ولكنّي صديقه تشوبّر المقنّع

231
00:16:21,840 --> 00:16:24,010
.الأمر واضح تمامًا أيّها التّانوكي

232
00:16:24,010 --> 00:16:28,020
إنّك ترتدي تنكّرًا بسبب شعورك بالإحراج لأنّك عدت؟

233
00:16:28,020 --> 00:16:30,560
...لا! قلت أنّني

234
00:16:34,360 --> 00:16:36,780
هل أنت بخير أيّها التّانوكي؟

235
00:16:36,780 --> 00:16:39,450
!لا تجعلوني أكرّر كلامي
...أنا صديقه واسمي

236
00:16:39,450 --> 00:16:43,450
.يا رفاق، لا تتصرّفوا بفظاظة

237
00:16:43,450 --> 00:16:46,370
.عليكم أن تسايرون في أوقات كهذه

238
00:16:46,700 --> 00:16:49,080
!لقد ارتبكنا

239
00:16:49,080 --> 00:16:50,580
!صحيح، صحيح

240
00:16:50,580 --> 00:16:54,090
!أنت تشوبّر المقنّع! مذهل

241
00:16:54,090 --> 00:16:56,380
!نعم، لا تشبه تشوّبر على الإطلاق

242
00:16:56,380 --> 00:16:58,710
...آسفون، آسفون، نحن

243
00:16:58,710 --> 00:17:01,010
!هذا يكفي! هذا مثير للشّفقة

244
00:17:01,420 --> 00:17:03,340
!أيّها التّانوكي

245
00:17:11,430 --> 00:17:14,400
!هذا يدغدغ أيّها الوغد

246
00:17:19,490 --> 00:17:23,190
.في الحقيقة، لديّ أمر مفاجئ عليّ القيام به

247
00:17:23,190 --> 00:17:24,920
هل بإمكاني البقاء هنا لوقت أطول؟

248
00:17:24,920 --> 00:17:28,330
!أنت مرحّب بك هنا مهما كان السّبب

249
00:17:29,040 --> 00:17:31,070
ثمّة الكثير من النّباتات

250
00:17:31,070 --> 00:17:34,770
الّتي لم أرها من قبل في أيّ كتاب
.تنموا على هذه الشّجرة الكبيرة

251
00:17:34,770 --> 00:17:36,960
.دعوني أدرسها

252
00:17:37,600 --> 00:17:40,460
.لدينا مكان مناسب لك إذًا

253
00:17:41,090 --> 00:17:44,030
.عليّ أن أحسّن من قوّتي أيضًا

254
00:17:44,030 --> 00:17:45,510
.لديّ الكثير لأقوم به

255
00:17:46,190 --> 00:17:49,350
أيّها التّانوكي! أعدت بهذه السّرعة؟

256
00:17:49,350 --> 00:17:50,890
!هذا ممتاز

257
00:17:50,890 --> 00:17:55,480
!يا رفاق، سأمكث في هذه الجزيرة لبعض الوقت

258
00:17:55,860 --> 00:17:58,070
.حسنًا، هذا هو المكان

259
00:17:59,030 --> 00:18:00,920
ما هو؟

260
00:18:00,920 --> 00:18:02,240
...هذه

261
00:18:12,120 --> 00:18:16,520
.مكتبة قريتنا. بإمكانك الدّراسة هنا

262
00:18:16,520 --> 00:18:18,640
!ثمّة كتب كثيرة

263
00:18:19,880 --> 00:18:22,630
!هناك المزيد! حتّى النّهاية

264
00:18:24,420 --> 00:18:25,950
!مذهل

265
00:18:25,950 --> 00:18:30,470
كلّ هذه الكتب عن النّباتات والأدوية
!الّتي أريد دراستها

266
00:18:30,810 --> 00:18:33,310
!ثمّة الكثير منها

267
00:18:33,310 --> 00:18:36,770
هنالك الكثير من النّباتات على هذه
.الجزيرة بالإمكان صناعة الأدوية منها

268
00:18:37,540 --> 00:18:41,590
ونعرف كيف نصنعها، لكنّ الطّيور كانت تعترضنا

269
00:18:41,590 --> 00:18:45,740
ولم نستطع الحصول على النّباتات
.وصناعة الأدوية، كنّا عالقين

270
00:18:46,070 --> 00:18:49,620
،كنتُ أحكم على سكّان هذه الجزيرة من مظهرهم

271
00:18:49,950 --> 00:18:53,580
،لكن بعد التّفكير في الأمر
.كانت أسلحتهم متطوّرة للغاية

272
00:18:53,910 --> 00:18:56,830
...يبدون أغبياء من مظهرهم

273
00:18:56,830 --> 00:19:00,710
!لكنّ مستواهم الثّقافيّ عالٍ جدًّا

274
00:19:00,710 --> 00:19:02,130
!لديّ الكثير لأتعلّمه

275
00:19:02,130 --> 00:19:03,630
!أيّها التّانوكي

276
00:19:03,630 --> 00:19:08,140
،كنتَ تظنّ أنّك تقول ذلك في ذهنك
.لكنّ كنت تتكلّم بصوت عالٍ

277
00:19:08,140 --> 00:19:10,030
...وكان ذلك فظًّا جدًّا

278
00:19:10,030 --> 00:19:14,250
...أتساءل كم بوسعي التّطوّر في هذه البلاد

279
00:19:16,060 --> 00:19:18,190
انظروا... ما ذلك المخلوق؟

280
00:19:18,520 --> 00:19:20,150
!لا بدّ أنّه رجل الثّلج

281
00:19:20,150 --> 00:19:23,870
!إنّه خطير! أدخلوا الصّغار إلى البيوت

282
00:19:23,870 --> 00:19:25,610
!بندقيّة! ناولوني بندقيّةً

283
00:19:26,610 --> 00:19:29,620
!أردوه قتيلاً! ارحل أيّها الوحش اللّعين

284
00:19:29,620 --> 00:19:32,280
!لا تدعوه يقترب أكثر! اقتلوه بسرعة

285
00:19:34,810 --> 00:19:36,330
!إنّه رجل ثلج

286
00:19:36,330 --> 00:19:39,760
!اقتلوه

287
00:19:37,400 --> 00:19:38,670
!لا تدعوه يهرب

288
00:19:58,370 --> 00:19:59,350
جمجمة؟

289
00:19:59,350 --> 00:20:04,730
!إنّها رمزٌ لمعتقد أنّ لا شيء مستحيل

290
00:20:08,530 --> 00:20:10,700
!من الرّائع أن تكون قرصانًا

291
00:20:10,700 --> 00:20:13,870
!ثمّة الكثير من الأشخاص المذهلين في البحر

292
00:20:13,870 --> 00:20:16,700
.تشوبّر، اذهب إلى البحر يومًا ما

293
00:20:16,700 --> 00:20:21,120
.إن فعلت، ستفهم مدى تفاهة مشاكلك

294
00:20:21,120 --> 00:20:26,210
هذه الجزيرة الّتي وُلدت فيها
.بهذا الصّغر مقارنةً بالعالم

295
00:20:26,210 --> 00:20:27,260
حقًّا؟

296
00:20:27,260 --> 00:20:30,880
!لا، بل أصغر! هكذا! هذا صحيح

297
00:20:33,850 --> 00:20:37,770
!مستقبلك ينتظرك وراء ذلك البحر

298
00:20:39,440 --> 00:20:43,730
!لنكن قراصنة سويًّا

299
00:20:43,730 --> 00:20:47,490
صحيح أنّني أريد أن أكون
...قرصانًا، لكن

300
00:20:49,740 --> 00:20:53,700
!لستُ إنسانًا حتّى! أنا وحش

301
00:20:53,700 --> 00:20:57,760
...لا يمكنني أن أصبح صديقكم! لذا

302
00:20:58,540 --> 00:21:00,380
...لذا أتيت لأشكركم فقط

303
00:21:03,670 --> 00:21:05,900
.أقدّر ما فعلتموه حقًّا

304
00:21:06,460 --> 00:21:08,550
.وشكرًا على طلبكم منّي الانضمام لكم

305
00:21:10,010 --> 00:21:12,170
...سأظلّ هنا، لكن

306
00:21:13,550 --> 00:21:16,360
،يومًا ما... إن أردتم
...تعالوا لزيارتنا مجدّ

307
00:21:16,360 --> 00:21:20,800
!اخرس! لنذهب

308
00:21:32,920 --> 00:21:35,350
.أخذني لوفي معه للبحر

309
00:21:36,160 --> 00:21:38,200
.كنت يائسًا لأتبعه فحسب

310
00:21:39,310 --> 00:21:41,200
هل فعلت أيّ شيء لمساعدة لوفي؟

311
00:21:47,540 --> 00:21:51,510
.لا أريد أن أمرّ بذلك ثانية

312
00:21:52,860 --> 00:21:55,550
...لكن، وقتها

313
00:22:13,500 --> 00:22:17,990
!لا بدّ أنّ لوفي شعر بألم أكثر منّا

314
00:22:21,120 --> 00:22:23,880
،ولأنّه سمح لي بالانضمام لطاقمه

315
00:22:23,880 --> 00:22:27,380
!ما دعت أهتمّ لكلام النّاس عنّي

316
00:22:33,880 --> 00:22:36,040
،إن كان هذا سيساعده

317
00:22:37,850 --> 00:22:41,180
!أستطيع أن أصير وحشًا حقيقيًّا

318
00:22:41,770 --> 00:22:47,500
!تشوبّر

319
00:22:55,080 --> 00:22:58,120
!لوفي

320
00:22:58,120 --> 00:23:04,150
!أعد أنّني سأصير أقوى بكثير

321
00:23:11,530 --> 00:23:13,700
.وصلت رسالة لوفي لأصدقائه

322
00:23:13,700 --> 00:23:14,970
،نامي في ويذاريا

323
00:23:14,970 --> 00:23:18,680
،وفرانكي في بالديمور
.أخذوا زمام الأمور بأنفسهم

324
00:23:18,680 --> 00:23:21,140
،وسانجي في مملكة كاماباكّا

325
00:23:21,140 --> 00:23:25,810
قدّم أفضل ما لديه في معركة ملحميّة
.لتعلّم سرّ تمّ توارثه لأجيال في المملكة

326
00:23:25,810 --> 00:23:27,350
:في الحلقة القادمة من وان بيس

327
00:23:27,350 --> 00:23:30,730
"!العيش في الجحيم! قتال سانجي من أجل رجولته"

328
00:23:30,730 --> 00:23:33,290
!ملك القراصنة، لن يكون إلاّ أنا

329
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة