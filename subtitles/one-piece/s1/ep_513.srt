1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,910
"وأقول "أريد أن أصير أقوى

5
00:01:01,910 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,160 --> 00:03:38,500
.فقد لوفي أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:38,500 --> 00:03:42,990
ثمّ بعث رسالة لطاقمه بطريقة
.ما كان أحد غيرهم ليفهمها

39
00:03:46,400 --> 00:03:50,370
.آمل أن يفهموا الرّسالة

40
00:03:50,370 --> 00:03:52,830
.سيفهمونها إن رأوا المقالة

41
00:03:53,500 --> 00:03:57,960
.سيفهمون رسالتك جيّدًا. لديّ شعور بذلك

42
00:03:57,960 --> 00:04:00,920
!أجل! فهمت يا لوفي

43
00:04:02,050 --> 00:04:06,180
!فهمت الآن! أجل! أجل

44
00:04:07,060 --> 00:04:09,220
.فهمت. هكذا الأمر إذًا

45
00:04:10,000 --> 00:04:12,230
.عُلم يا لوفي

46
00:04:12,230 --> 00:04:18,190
!فهمت يا لوفي

47
00:04:14,810 --> 00:04:16,310
!فهمت

48
00:04:18,600 --> 00:04:22,780
،يا إلهي! إنّه لا يفكّر في مشاعرنا
!يا له من أنانيّ

49
00:04:23,400 --> 00:04:24,700
!فهمت

50
00:04:24,700 --> 00:04:27,160
نعم، أهذا كلّ شيء؟

51
00:04:27,620 --> 00:04:30,540
.لا يقوم لوفي بأمور كهذه

52
00:04:30,540 --> 00:04:34,160
.إنّه مع ريلي، لا بدّ أنّها كانت فكرته

53
00:04:34,160 --> 00:04:35,960
.أعلم أنّ هنالك رسالة ما

54
00:04:42,920 --> 00:04:47,100
!يبدأ القراصنة تحرّكهم"
"!العالم الجديد الّذي لا نظير له

55
00:04:51,890 --> 00:04:54,560
،بما أنّ عصر اللّحية البيضاء قد ولّى

56
00:04:54,560 --> 00:04:58,650
.بدأ القراصنة الطّموحين بالتّحرّك بطرق جريئة

57
00:04:59,160 --> 00:05:02,530
...على عكس ترافالغار لو

58
00:05:03,070 --> 00:05:05,320
!ماذا؟! لن نذهب إلى هناك بعد؟

59
00:05:05,320 --> 00:05:07,450
!لنذهب للعالم الجديد بسرعة

60
00:05:08,070 --> 00:05:11,170
إلى متى سنظلّ في هذه المياه؟

61
00:05:11,170 --> 00:05:13,160
ما الّذي تنتظره أيّها القبطان؟

62
00:05:14,080 --> 00:05:17,370
.قلتُ أنّنا سننتظر وقتنا

63
00:05:17,370 --> 00:05:18,830
.لا تقلقوا

64
00:05:18,830 --> 00:05:22,130
.لن يبارح كنز وان بيس العظيم مكانه

65
00:05:22,130 --> 00:05:26,680
لكنّ اللّحية السّوداء بدأ تحرّكاته في العالم الجديد

66
00:05:26,680 --> 00:05:31,260
!وهنالك إشاعات تقول أنّه دمّر طاقم قراصنة

67
00:05:31,260 --> 00:05:34,480
والنّاشئون الأقوياء الّذين يريدون أن يصيروا من اليونكو

68
00:05:34,480 --> 00:05:36,270
!يتدافعون إلى العالم الجديد

69
00:05:36,270 --> 00:05:41,150
!لا وقت لدينا لنضيّعه
!سيهزمنا الجميع هكذا يا قبطان

70
00:05:41,610 --> 00:05:45,400
.من الأفضل بالنّسبة لنا إن حاولوا القضاء على بعضهم

71
00:05:45,400 --> 00:05:48,050
.لن نتورّط في أيّ قتالات مثيرة للشّفقة كتلك

72
00:05:49,410 --> 00:05:53,240
.كفاكم ثرثرة واتبعوني فحسب

73
00:05:53,240 --> 00:05:56,080
!سنحصل على مبتغانا بأيّ ثمن

74
00:05:56,080 --> 00:05:57,870
!أيّها القبطان

75
00:05:57,870 --> 00:05:59,540
!سنتبعك للأبد

76
00:06:00,380 --> 00:06:04,600
...نعم يا قبطان! يمكنك الاعتماد عليّ

77
00:06:05,260 --> 00:06:06,420
!يتكلّم في نومه؟

78
00:06:06,840 --> 00:06:07,800
.آسف

79
00:06:07,800 --> 00:06:10,090
!لا تعتذر وأنت نائم

80
00:06:15,280 --> 00:06:19,310
!الجوّ بارد! سيتجمّد جسدي

81
00:06:19,310 --> 00:06:22,090
أهنالك أيّ أحد في مكان كهذا؟

82
00:06:30,740 --> 00:06:31,820
!ما هذا؟

83
00:06:31,820 --> 00:06:33,620
!ثمّة شيء ما يهوي من السّماء

84
00:06:34,900 --> 00:06:36,500
!كلاّ! اهربوا

85
00:06:44,560 --> 00:06:46,090
!يا رفاق، هل أنتم بخير؟

86
00:06:47,170 --> 00:06:49,050
.أنا بخير

87
00:06:49,050 --> 00:06:52,050
تبًّا! ما الّذي يحدث على هذه الجزيرة؟

88
00:06:52,680 --> 00:06:55,350
!أيّها القبطان، لنغادر هذه الجزيرة

89
00:06:55,350 --> 00:06:58,300
!لا أظنّ أنّ هنالك من يعيش هنا

90
00:06:58,300 --> 00:07:00,440
لا تظنّ ذلك؟

91
00:07:00,440 --> 00:07:03,440
.يمكن لأيّ شيء أن يحدث في هذا البحر

92
00:07:03,440 --> 00:07:04,520
.انظر

93
00:07:04,980 --> 00:07:08,110
ما قصّة كتلة الثّلج الدّائريّة هذه؟

94
00:07:08,110 --> 00:07:10,320
!الأوتاد الجليديّة عالقة فيها

95
00:07:13,700 --> 00:07:16,490
!إنّها ليست كتلة ثلج! إنّها قبّة حديديّة

96
00:07:22,480 --> 00:07:24,330
!انظروا! إنّ القبّة تُفتح

97
00:07:44,070 --> 00:07:48,570
.لم أتوقّع رؤية بلدة في القبّة

98
00:07:54,070 --> 00:07:59,160
.يحبّ اليونكو كايدو-ساما الشّهير هذه الجزيرة

99
00:07:59,160 --> 00:08:01,250
.أنا مكلّف بالأمن فيها

100
00:08:01,790 --> 00:08:03,870
وبعد؟ ماذا تريد منّا؟

101
00:08:03,870 --> 00:08:08,420
.لا شيء. حذّرتكم فحسب

102
00:08:08,420 --> 00:08:12,720
.من الأفضل ألاّ تغضبه أيّها النّاشئ

103
00:08:12,720 --> 00:08:15,460
،تعني أنّني إن قتلتك أو ما شابه

104
00:08:15,460 --> 00:08:17,470
فلن يتركني كايدو وشأني؟

105
00:08:17,470 --> 00:08:20,770
...هذا صحيح. فلماذا لا

106
00:08:20,770 --> 00:08:22,430
!يسهّل هذا الأمر عليّ

107
00:08:24,020 --> 00:08:28,940
!ماذا؟ فاكهة زون قديمة؟ كم هذا نادر

108
00:08:37,320 --> 00:08:40,680
!خدش! انفجار

109
00:08:42,250 --> 00:08:44,250
!اسمعوا

110
00:08:48,250 --> 00:08:50,840
!كان ذلك مزعجًا

111
00:08:50,840 --> 00:08:52,720
!هذا هو القبطان أبو

112
00:08:52,720 --> 00:08:54,480
!كم يُعتمد عليك

113
00:09:02,560 --> 00:09:04,520
!ما زال كلّ هذا العدد منها؟

114
00:09:04,520 --> 00:09:06,310
!هذا غير معقول

115
00:09:06,310 --> 00:09:08,230
...كلاّ

116
00:09:08,230 --> 00:09:13,610
!لا تقلقوا يا رفاق! سينقذنا القبطان أبو

117
00:09:13,610 --> 00:09:15,110
!اسمعوا يا رجال

118
00:09:15,110 --> 00:09:16,200
!نعم

119
00:09:16,200 --> 00:09:17,160
!لنهرب

120
00:09:17,160 --> 00:09:18,240
!ماذا؟

121
00:09:19,990 --> 00:09:24,370
!لا يمكنني هزيمة مجموعة كبيرة من الخنازير العنيفة

122
00:09:26,160 --> 00:09:29,460
!أيّها القبطان، ثمّة نهاية مسدودة أمامنا

123
00:09:29,460 --> 00:09:31,300
!أنقذوا أنفسكم كيفما تستطيعون

124
00:09:32,760 --> 00:09:35,010
!كلاّ! نحن هالكون

125
00:09:35,010 --> 00:09:35,920
!لا تستسلموا

126
00:09:35,920 --> 00:09:38,960
!سنسقط في المياه

127
00:09:38,960 --> 00:09:40,930
!لا يهمّ! اقفزوا

128
00:09:40,930 --> 00:09:43,180
!ماذا؟

129
00:09:43,180 --> 00:09:44,270
ماذا؟

130
00:09:44,270 --> 00:09:48,060
!أيّها القبطان! نحن نركض في الهواء

131
00:09:48,060 --> 00:09:50,270
!إنّ الخنازير تركض خلفنا في الهواء أيضًا

132
00:09:50,270 --> 00:09:55,610
!بإمكاني رؤية ذلك! ما خطب هذه الجزيرة؟

133
00:09:58,110 --> 00:10:00,570
!هذا ساخن

134
00:10:00,740 --> 00:10:05,450
سان خوان ولف

135
00:10:01,160 --> 00:10:03,450
.ما عادت قدماي تتحمّلان

136
00:10:03,950 --> 00:10:06,960
.جسدي متعب

137
00:10:06,960 --> 00:10:09,880
.هذا مؤلم، عضّتني سمكة ما

138
00:10:10,500 --> 00:10:13,050
!كفّ عن الشّكوى يا ولف

139
00:10:13,050 --> 00:10:16,170
.كاد الطّوف يُكسر بسببك

140
00:10:16,170 --> 00:10:18,510
.لهذا السّبب نقوم بهذا

141
00:10:18,510 --> 00:10:24,640
كان تهوّرًا منّا محاولة عبور العالم
.الجديد بالطّوف في المقام الأوّل

142
00:10:25,470 --> 00:10:29,900
.كان علينا أخذ سفينة من سفن البحّرية في مارينفورد

143
00:10:29,900 --> 00:10:33,570
.لكنّك تتعلّق بالأشياء كثيرًا

144
00:10:33,730 --> 00:10:38,070
.إنّكم لا تتجهّزون لأيّ شيء

145
00:10:38,070 --> 00:10:40,180
!دعوني أتولّى الأمر

146
00:10:40,180 --> 00:10:42,910
أتريدني أن أصير القبطان يا تيتش؟

147
00:10:44,240 --> 00:10:46,180
.اخرس وإلاّ قتلتك

148
00:10:46,180 --> 00:10:48,210
.نحن قراصنة اللّحية السّوداء

149
00:10:48,210 --> 00:10:53,540
...تعلم السّماء ما الّذي سيحدث لنا

150
00:10:56,050 --> 00:10:57,550
!أحتاج للمزيد من السّاكي

151
00:10:57,550 --> 00:11:00,590
هلاّ ذهبنا إلى جزيرة ما عليها بلدة؟

152
00:11:02,660 --> 00:11:06,590
!نعم، أنا أفضّل ملابس رائعة بدل سفينة

153
00:11:06,590 --> 00:11:08,600
.لقد سئمت ملابس السّجن

154
00:11:08,600 --> 00:11:10,850
.عليك أن تعتادي

155
00:11:10,850 --> 00:11:13,730
.لا يمكنني أن أعتاد عليها للأبد

156
00:11:13,730 --> 00:11:17,280
!ولا أنا! إلى متى سننتظر؟

157
00:11:17,640 --> 00:11:20,070
هل البحريّة قادمة؟

158
00:11:20,450 --> 00:11:24,120
سأذهب لإلقاء نظرة. لا يمكن
.أن يكونوا بطيئين لهذه الدّرجة

159
00:11:24,520 --> 00:11:25,870
!كلامك صحيح

160
00:11:25,870 --> 00:11:28,910
.إنّ هؤلاء قد بدؤوا يسأمون الانتظار

161
00:11:32,340 --> 00:11:35,920
أليس كذلك يا جولري بوني؟

162
00:11:36,040 --> 00:11:37,620
...أيّتها القبطانة بوني

163
00:11:42,400 --> 00:11:47,470
لا أصدّق أنّهم وضعوا مكافأة تزيد
!عن 100 مليون على رأس فتاة مثلك

164
00:11:48,030 --> 00:11:51,390
.العالم الجديد بحر المختارين الأقوياء

165
00:11:51,390 --> 00:11:54,900
،رغم أنّك قطعت مسافة طويلة من الأزرق الجنوبيّ

166
00:11:54,900 --> 00:11:57,720
.فلا يمكنك التّقدّم أكثر

167
00:12:02,420 --> 00:12:05,700
...أنت ضعيفة جدًّا لتنضمّي لطاقمي

168
00:12:05,700 --> 00:12:10,000
لكن ما رأيك؟ يمكنك المجيء معي
.إن كنت تريدين أن تصيري فتاتي

169
00:12:11,330 --> 00:12:14,250
إلى البحر الّذي أمامنا... موافقة؟

170
00:12:14,810 --> 00:12:16,670
!سُحقًا لك

171
00:12:16,670 --> 00:12:18,210
!خنزير ملتحي

172
00:12:20,090 --> 00:12:21,990
.لقد رفضته

173
00:12:22,720 --> 00:12:27,220
!لا فائدة! أنت بذيئة
!على النّساء التّحلّي بالاحترام

174
00:12:27,220 --> 00:12:30,520
!لديّ أعضاء طاقم بذيئين سلفًا

175
00:12:30,520 --> 00:12:33,350
!شكرًا لقولك ذلك

176
00:12:35,440 --> 00:12:38,430
لنسلّمها للبحريّة فحسب

177
00:12:38,430 --> 00:12:41,320
!ونأخذ سفينة في المقابل كما خطّطنا

178
00:12:41,320 --> 00:12:44,200
.أيّها القبطان. البحريّة قادمة

179
00:12:44,720 --> 00:12:47,390
هل أحضروا سفينة لنا؟

180
00:12:47,390 --> 00:12:50,200
.أحضروا واحدة، لكن لا أظنّهم سيمنحوننا إيّاها

181
00:12:50,520 --> 00:12:52,660
ماذا؟ كيف عرفت ذلك؟

182
00:12:54,670 --> 00:12:56,330
.لأنّ أكاينو على متنها

183
00:12:56,670 --> 00:12:59,920
.تبًّا! ذلك ليس ما أريد الآن

184
00:12:59,920 --> 00:13:02,340
!لنهرب يا رفاق

185
00:13:04,010 --> 00:13:05,800
!أخفقنا بشدّة

186
00:13:09,530 --> 00:13:11,100
أين اللّحية السّوداء؟

187
00:13:11,100 --> 00:13:12,470
!لقد غادر

188
00:13:12,760 --> 00:13:16,100
،عندما سمعت أنّك هربت من الحكومة

189
00:13:16,100 --> 00:13:17,850
.تجمّدت الدّماء في عروقي

190
00:13:19,400 --> 00:13:22,280
.لكنّ كلّ شيء انتهى الآن

191
00:13:23,940 --> 00:13:27,200
!أيّها الأوغاد! لن أسامحكم

192
00:13:33,830 --> 00:13:35,040
اختفى؟

193
00:13:35,040 --> 00:13:38,250
.نعم، بكلّ صراحة

194
00:13:39,060 --> 00:13:42,590
!فكرة من كانت هذه؟ سنغوكو؟

195
00:13:42,960 --> 00:13:46,630
!لا، شخص أعلى مرتبة من ذلك

196
00:13:49,470 --> 00:13:54,020
.لم يكن تعبيرًا مجازيًّا. لقد اختفى بمعنى الكلمة

197
00:13:54,940 --> 00:13:59,100
كنتُ متفاجئًا. أتلك هي قوّة فاكهة الظّلال؟

198
00:13:59,100 --> 00:14:00,690
!هذه ليست مزحة

199
00:14:00,690 --> 00:14:05,240
.لا تقلق. كان يحتضر

200
00:14:05,240 --> 00:14:07,530
.لا يوجد ما قد ينقذ حياته

201
00:14:07,530 --> 00:14:11,840
.هذا صحيح. إلاّ إذا عاد كزومبي

202
00:14:12,450 --> 00:14:14,620
!لإنّه يبدو كذلك بالفعل

203
00:14:14,620 --> 00:14:17,540
!قمت بعمل ناقص

204
00:14:17,830 --> 00:14:21,130
!لا تغترّ بنفسك

205
00:14:21,130 --> 00:14:24,500
متى صرت زعيمًا عليّ؟

206
00:14:24,500 --> 00:14:29,680
!لا يهمّ كم تبلغ سلطتك في الحكومة، أظلّ قرصانًا

207
00:14:29,680 --> 00:14:31,700
!لا شيء يهمّ في نظري

208
00:14:32,610 --> 00:14:38,560
،عندما لا يعود لي أهمّيّة بالعمل معكم
!فسأتخلّى عن لقب الشّيتشيبوكاي في أيّ وقت

209
00:14:39,040 --> 00:14:41,560
.إيّاك أن تنسى ذلك

210
00:15:01,000 --> 00:15:04,290
...أثناء ذلك في مملكة تورينو

211
00:15:04,290 --> 00:15:09,640
بدأ كلّ واحد من طاقم قبّعة القشّ
...التّحرّك في أماكن مختلفة أيضًا

212
00:15:11,510 --> 00:15:14,800
.رحل التّانوكي عنّا

213
00:15:18,590 --> 00:15:21,850
.تتشاركنا الطّيور نفس الإحساس

214
00:15:21,850 --> 00:15:27,650
!نتطلّع لرؤيتك ثانية أيّها التّانوكي

215
00:15:29,570 --> 00:15:33,150
.حسنًا، لنعد للعمل

216
00:15:41,280 --> 00:15:43,460
ماذا؟ ما كان ذلك؟

217
00:15:44,060 --> 00:15:45,610
!...إنّه

218
00:15:45,610 --> 00:15:47,170
!عاد الطّائر

219
00:15:47,170 --> 00:15:49,130
!ماذا؟ عاد مبكّرًا جدًّا

220
00:15:51,300 --> 00:15:54,300
.ماذا؟ لا أرى التّانوكي

221
00:15:54,300 --> 00:15:55,720
ماذا حدث للتّانوكي؟

222
00:15:55,720 --> 00:15:58,890
!ربّما وقع في البحر

223
00:15:58,890 --> 00:16:02,020
...هذا سيّئ! لنذهب للبحث

224
00:16:05,060 --> 00:16:07,110
!مـ-من هذا؟

225
00:16:07,400 --> 00:16:13,170
،في الحقيقة، بهدف الدّفاع عن السّلام في العالم

226
00:16:13,170 --> 00:16:18,660
!أحارب الشّرّ لأنّني بطل العدالة، تشوبّر المقنّع

227
00:16:22,540 --> 00:16:24,870
!الـ-التّانوكي

228
00:16:24,870 --> 00:16:29,050
،"أعلم أنّي قلت "زرنا ثانية
لكن ألم يحن ذلك أسرع من المتوقّع؟

229
00:16:29,050 --> 00:16:31,680
!لا، أنت مخطئ! أنا لست هو

230
00:16:31,680 --> 00:16:35,840
!ربّما نتشابه، ولكنّي صديقه تشوبّر المقنّع

231
00:16:35,840 --> 00:16:38,010
.الأمر واضح تمامًا أيّها التّانوكي

232
00:16:38,010 --> 00:16:42,020
إنّك ترتدي تنكّرًا بسبب شعورك بالإحراج لأنّك عدت؟

233
00:16:42,020 --> 00:16:44,560
...لا! قلت أنّني

234
00:16:48,360 --> 00:16:50,780
هل أنت بخير أيّها التّانوكي؟

235
00:16:50,780 --> 00:16:53,450
!لا تجعلوني أكرّر كلامي
...أنا صديقه واسمي

236
00:16:53,450 --> 00:16:57,450
.يا رفاق، لا تتصرّفوا بفظاظة

237
00:16:57,450 --> 00:17:00,370
.عليكم أن تسايرون في أوقات كهذه

238
00:17:00,700 --> 00:17:03,080
!لقد ارتبكنا

239
00:17:03,080 --> 00:17:04,580
!صحيح، صحيح

240
00:17:04,580 --> 00:17:08,090
!أنت تشوبّر المقنّع! مذهل

241
00:17:08,090 --> 00:17:10,380
!نعم، لا تشبه تشوّبر على الإطلاق

242
00:17:10,380 --> 00:17:12,710
...آسفون، آسفون، نحن

243
00:17:12,710 --> 00:17:15,010
!هذا يكفي! هذا مثير للشّفقة

244
00:17:15,420 --> 00:17:17,340
!أيّها التّانوكي

245
00:17:25,430 --> 00:17:28,400
!هذا يدغدغ أيّها الوغد

246
00:17:33,490 --> 00:17:37,190
.في الحقيقة، لديّ أمر مفاجئ عليّ القيام به

247
00:17:37,190 --> 00:17:38,920
هل بإمكاني البقاء هنا لوقت أطول؟

248
00:17:38,920 --> 00:17:42,330
!أنت مرحّب بك هنا مهما كان السّبب

249
00:17:43,040 --> 00:17:45,070
ثمّة الكثير من النّباتات

250
00:17:45,070 --> 00:17:48,770
الّتي لم أرها من قبل في أيّ كتاب
.تنموا على هذه الشّجرة الكبيرة

251
00:17:48,770 --> 00:17:50,960
.دعوني أدرسها

252
00:17:51,600 --> 00:17:54,460
.لدينا مكان مناسب لك إذًا

253
00:17:55,090 --> 00:17:58,030
.عليّ أن أحسّن من قوّتي أيضًا

254
00:17:58,030 --> 00:17:59,510
.لديّ الكثير لأقوم به

255
00:18:00,190 --> 00:18:03,350
أيّها التّانوكي! أعدت بهذه السّرعة؟

256
00:18:03,350 --> 00:18:04,890
!هذا ممتاز

257
00:18:04,890 --> 00:18:09,480
!يا رفاق، سأمكث في هذه الجزيرة لبعض الوقت

258
00:18:09,860 --> 00:18:12,070
.حسنًا، هذا هو المكان

259
00:18:13,030 --> 00:18:14,920
ما هو؟

260
00:18:14,920 --> 00:18:16,240
...هذه

261
00:18:26,120 --> 00:18:30,520
.مكتبة قريتنا. بإمكانك الدّراسة هنا

262
00:18:30,520 --> 00:18:32,640
!ثمّة كتب كثيرة

263
00:18:33,880 --> 00:18:36,630
!هناك المزيد! حتّى النّهاية

264
00:18:38,420 --> 00:18:39,950
!مذهل

265
00:18:39,950 --> 00:18:44,470
كلّ هذه الكتب عن النّباتات والأدوية
!الّتي أريد دراستها

266
00:18:44,810 --> 00:18:47,310
!ثمّة الكثير منها

267
00:18:47,310 --> 00:18:50,770
هنالك الكثير من النّباتات على هذه
.الجزيرة بالإمكان صناعة الأدوية منها

268
00:18:51,540 --> 00:18:55,590
ونعرف كيف نصنعها، لكنّ الطّيور كانت تعترضنا

269
00:18:55,590 --> 00:18:59,740
ولم نستطع الحصول على النّباتات
.وصناعة الأدوية، كنّا عالقين

270
00:19:00,070 --> 00:19:03,620
،كنتُ أحكم على سكّان هذه الجزيرة من مظهرهم

271
00:19:03,950 --> 00:19:07,580
،لكن بعد التّفكير في الأمر
.كانت أسلحتهم متطوّرة للغاية

272
00:19:07,910 --> 00:19:10,830
...يبدون أغبياء من مظهرهم

273
00:19:10,830 --> 00:19:14,710
!لكنّ مستواهم الثّقافيّ عالٍ جدًّا

274
00:19:14,710 --> 00:19:16,130
!لديّ الكثير لأتعلّمه

275
00:19:16,130 --> 00:19:17,630
!أيّها التّانوكي

276
00:19:17,630 --> 00:19:22,140
،كنتَ تظنّ أنّك تقول ذلك في ذهنك
.لكنّ كنت تتكلّم بصوت عالٍ

277
00:19:22,140 --> 00:19:24,030
...وكان ذلك فظًّا جدًّا

278
00:19:24,030 --> 00:19:28,250
...أتساءل كم بوسعي التّطوّر في هذه البلاد

279
00:19:30,060 --> 00:19:32,190
انظروا... ما ذلك المخلوق؟

280
00:19:32,520 --> 00:19:34,150
!لا بدّ أنّه رجل الثّلج

281
00:19:34,150 --> 00:19:37,870
!إنّه خطير! أدخلوا الصّغار إلى البيوت

282
00:19:37,870 --> 00:19:39,610
!بندقيّة! ناولوني بندقيّةً

283
00:19:40,610 --> 00:19:43,620
!أردوه قتيلاً! ارحل أيّها الوحش اللّعين

284
00:19:43,620 --> 00:19:46,280
!لا تدعوه يقترب أكثر! اقتلوه بسرعة

285
00:19:48,810 --> 00:19:50,330
!إنّه رجل ثلج

286
00:19:50,330 --> 00:19:53,760
!اقتلوه

287
00:19:51,400 --> 00:19:52,670
!لا تدعوه يهرب

288
00:20:12,370 --> 00:20:13,350
جمجمة؟

289
00:20:13,350 --> 00:20:18,730
!إنّها رمزٌ لمعتقد أنّ لا شيء مستحيل

290
00:20:22,530 --> 00:20:24,700
!من الرّائع أن تكون قرصانًا

291
00:20:24,700 --> 00:20:27,870
!ثمّة الكثير من الأشخاص المذهلين في البحر

292
00:20:27,870 --> 00:20:30,700
.تشوبّر، اذهب إلى البحر يومًا ما

293
00:20:30,700 --> 00:20:35,120
.إن فعلت، ستفهم مدى تفاهة مشاكلك

294
00:20:35,120 --> 00:20:40,210
هذه الجزيرة الّتي وُلدت فيها
.بهذا الصّغر مقارنةً بالعالم

295
00:20:40,210 --> 00:20:41,260
حقًّا؟

296
00:20:41,260 --> 00:20:44,880
!لا، بل أصغر! هكذا! هذا صحيح

297
00:20:47,850 --> 00:20:51,770
!مستقبلك ينتظرك وراء ذلك البحر

298
00:20:53,440 --> 00:20:57,730
!لنكن قراصنة سويًّا

299
00:20:57,730 --> 00:21:01,490
صحيح أنّني أريد أن أكون
...قرصانًا، لكن

300
00:21:03,740 --> 00:21:07,700
!لستُ إنسانًا حتّى! أنا وحش

301
00:21:07,700 --> 00:21:11,760
...لا يمكنني أن أصبح صديقكم! لذا

302
00:21:12,540 --> 00:21:14,380
...لذا أتيت لأشكركم فقط

303
00:21:17,670 --> 00:21:19,900
.أقدّر ما فعلتموه حقًّا

304
00:21:20,460 --> 00:21:22,550
.وشكرًا على طلبكم منّي الانضمام لكم

305
00:21:24,010 --> 00:21:26,170
...سأظلّ هنا، لكن

306
00:21:27,550 --> 00:21:30,360
،يومًا ما... إن أردتم
...تعالوا لزيارتنا مجدّ

307
00:21:30,360 --> 00:21:34,800
!اخرس! لنذهب

308
00:21:46,920 --> 00:21:49,350
.أخذني لوفي معه للبحر

309
00:21:50,160 --> 00:21:52,200
.كنت يائسًا لأتبعه فحسب

310
00:21:53,310 --> 00:21:55,200
هل فعلت أيّ شيء لمساعدة لوفي؟

311
00:22:01,540 --> 00:22:05,510
.لا أريد أن أمرّ بذلك ثانية

312
00:22:06,860 --> 00:22:09,550
...لكن، وقتها

313
00:22:27,500 --> 00:22:31,990
!لا بدّ أنّ لوفي شعر بألم أكثر منّا

314
00:22:35,120 --> 00:22:37,880
،ولأنّه سمح لي بالانضمام لطاقمه

315
00:22:37,880 --> 00:22:41,380
!ما دعت أهتمّ لكلام النّاس عنّي

316
00:22:47,880 --> 00:22:50,040
،إن كان هذا سيساعده

317
00:22:51,850 --> 00:22:55,180
!أستطيع أن أصير وحشًا حقيقيًّا

318
00:22:55,770 --> 00:23:01,500
!تشوبّر

319
00:23:09,080 --> 00:23:12,120
!لوفي

320
00:23:12,120 --> 00:23:18,150
!أعد أنّني سأصير أقوى بكثير

321
00:23:25,530 --> 00:23:27,700
.وصلت رسالة لوفي لأصدقائه

322
00:23:27,700 --> 00:23:28,970
،نامي في ويذاريا

323
00:23:28,970 --> 00:23:32,680
،وفرانكي في بالديمور
.أخذوا زمام الأمور بأنفسهم

324
00:23:32,680 --> 00:23:35,140
،وسانجي في مملكة كاماباكّا

325
00:23:35,140 --> 00:23:39,810
قدّم أفضل ما لديه في معركة ملحميّة
.لتعلّم سرّ تمّ توارثه لأجيال في المملكة

326
00:23:39,810 --> 00:23:41,350
:في الحلقة القادمة من وان بيس

327
00:23:41,350 --> 00:23:44,730
"!العيش في الجحيم! قتال سانجي من أجل رجولته"

328
00:23:44,730 --> 00:23:47,290
!ملك القراصنة، لن يكون إلاّ أنا

329
00:23:50,030 --> 00:23:55,030
!!نلقاكم في الحلقة القادمة