1
00:00:08,040 --> 00:00:11,110
!العالم... نعم

2
00:00:11,640 --> 00:00:13,310
...اسعوا نحو الحرّيّة

3
00:00:13,310 --> 00:00:17,450
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,810 --> 00:00:21,180
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,680 --> 00:00:23,050
!فتجاوزوها

6
00:00:23,450 --> 00:00:26,420
!تحت راية ما تؤمنون به

7
00:00:30,890 --> 00:00:36,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,500 --> 00:00:39,730
متّجهًا نحو عالم بلا نهاية

9
00:00:41,140 --> 00:00:46,010
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,010 --> 00:00:54,420
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,420 --> 00:01:00,160
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,160 --> 00:01:04,590
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,590 --> 00:01:10,230
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,230 --> 00:01:14,100
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,100 --> 00:01:19,040
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,040 --> 00:01:26,780
متّجهين نحو الأفق

17
00:01:26,780 --> 00:01:32,290
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,290 --> 00:01:36,990
متّجهًا نحو عالم بلا نهاية

19
00:01:36,990 --> 00:01:42,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,230 --> 00:01:48,500
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:58,350 --> 00:02:02,350
...1,868 ...1,867

22
00:02:02,350 --> 00:02:04,650
...1,869

23
00:02:18,000 --> 00:02:18,900
!اصطدتُ واحدة

24
00:02:22,940 --> 00:02:23,770
!انظر

25
00:02:24,010 --> 00:02:25,540
!هذا مذهل

26
00:02:28,140 --> 00:02:29,510
!اصطدتُ واحدة أيضًا

27
00:02:33,750 --> 00:02:38,020
إنّها كبيرة! لا بدّ أنّها السّمكة
!الحارسة لهذه المنطقة

28
00:02:38,990 --> 00:02:40,160
فعلاً؟

29
00:02:40,160 --> 00:02:41,490
!هذا مذهل

30
00:02:48,930 --> 00:02:50,700
!أجل

31
00:03:00,410 --> 00:03:01,440
السّمكة الحارسة...؟

32
00:03:01,440 --> 00:03:02,940
...لا يمكننا أكل هذه إطلاقًا

33
00:03:03,140 --> 00:03:04,250
!اخرس

34
00:03:04,250 --> 00:03:06,580
!لم تصطد سمكة واحدة حتّى
!لذلك لا تشتكِ

35
00:03:07,020 --> 00:03:08,250
.حسنًا. شاهد فحسب

36
00:03:10,350 --> 00:03:12,220
!سأمسك بواحدة كبيرة

37
00:03:14,490 --> 00:03:15,690
أيمكنك الصّيد من الأساس؟

38
00:03:15,690 --> 00:03:16,930
...سأصطاد شيئًا بطريقة ما

39
00:03:17,390 --> 00:03:19,660
!نامي-سان

40
00:03:20,360 --> 00:03:24,330
أحضرتُ لك عصيرًا استوائيًّا
مفيد جدًّا لجمالك

41
00:03:24,330 --> 00:03:25,900
!وسيجعل بشرتك ناعمة

42
00:03:26,940 --> 00:03:27,770
!شكرًا لك

43
00:03:28,370 --> 00:03:29,970
!ليس عدلاً

44
00:03:30,170 --> 00:03:31,470
!أريد عصيرًا أيضًا

45
00:03:31,670 --> 00:03:32,740
!أريد بشرة ناعمة

46
00:03:33,040 --> 00:03:33,910
...لا

47
00:03:34,410 --> 00:03:37,710
لماذا قد تحتاجون لبشرة ناعمة؟

48
00:03:38,880 --> 00:03:40,180
!لنكون أظرف

49
00:03:44,390 --> 00:03:46,320
.الرّياح جيّدة. التّيّار جيّد أيضًا

50
00:03:46,660 --> 00:03:48,860
.يبدو أنّنا لن نواجه أيّ مشاكل اليوم

51
00:03:49,420 --> 00:03:50,760
!أمسكتُ بشيء ما

52
00:03:59,900 --> 00:04:00,970
ما هذا الشّيء؟

53
00:04:01,570 --> 00:04:02,940
!إنّه ضخم

54
00:04:03,140 --> 00:04:05,140
!يا لوفي! ماذا أمسكت؟

55
00:04:11,580 --> 00:04:15,550
!تمرّد الملاّحة"
"!من أجل حُلم لا يتزعزع

56
00:04:19,690 --> 00:04:21,990
!يا لها من صدفة لولبيّة ضخمة

57
00:04:21,990 --> 00:04:24,630
.مهلاً، إنّها ليست صدفة لولبيّة

58
00:04:24,630 --> 00:04:25,790
!ما الّذي سنفعله؟

59
00:04:26,090 --> 00:04:27,230
هل تصلح للأكل؟

60
00:04:27,560 --> 00:04:28,730
!تريد أكلها؟

61
00:04:29,230 --> 00:04:30,400
ربّما نطهوها وهي في صدفتها؟

62
00:04:30,600 --> 00:04:31,730
!وأنت أيضًا؟

63
00:04:40,710 --> 00:04:43,510
!يا إلهي... ظننت أنّني سأموت

64
00:04:43,510 --> 00:04:45,280
.مرحبًا بالجميع

65
00:04:45,780 --> 00:04:47,250
من تكون؟

66
00:04:50,420 --> 00:04:53,460
صحيح... اعذروني لأنّني لم
.أعرّف عن نفسي باكرًا

67
00:04:53,460 --> 00:04:57,860
أنا جاهز لتوصيل أيّ منتجات
.لبلدتكم بكلّ ودّ باتّصال واحد فقط

68
00:04:57,860 --> 00:05:02,000
أنا رايس رايس من شركة
.طلبيّات حلزون الاتّصال بالبريد

69
00:05:02,700 --> 00:05:04,330
.سررت بلقائكم

70
00:05:06,530 --> 00:05:09,300
طلبيّات حلزون الاتّصال بالبريد؟
ما هذا؟

71
00:05:09,540 --> 00:05:14,910
حسنًا، كنت أقوم بعملية
،توصيل بهذا الإسكار

72
00:05:14,910 --> 00:05:16,650
لكنّني علقتُ في عاصفة قويّة

73
00:05:16,650 --> 00:05:21,280
وحُطّمتُ بسبب الأمواج
.الّتي تلاعبت بي يمينًا وشمالاً

74
00:05:21,280 --> 00:05:21,850
...فهمت

75
00:05:21,850 --> 00:05:23,250
.لا بدّ أنّك تشعر بالضّياع

76
00:05:23,920 --> 00:05:25,290
.ضياع تامّ

77
00:05:26,350 --> 00:05:28,960
!أمزح فحسب. أنت ذكيّة يا آنسة

78
00:05:29,620 --> 00:05:31,430
.حسنًا، اشرب بعض الماء

79
00:05:31,590 --> 00:05:34,430
.شكرًا لكم على إنقاذي

80
00:05:34,430 --> 00:05:35,900
،هذا ليس بالكثير
،لكنّه عربون امتناني

81
00:05:35,900 --> 00:05:37,300
.سأعطيكم هذه الفهارس

82
00:05:37,300 --> 00:05:38,900
.سأوصل لكم أيّ شيء بمكالمة واحدة

83
00:05:39,300 --> 00:05:40,800
.كم هذا مناسب

84
00:05:40,800 --> 00:05:42,600
تقوم بالتّوصيل حتّى في البحر؟

85
00:05:43,040 --> 00:05:44,570
.بالطّبع لا

86
00:05:45,040 --> 00:05:48,040
...هكذا... إذًا

87
00:05:48,040 --> 00:05:48,980
...نعم

88
00:05:49,180 --> 00:05:54,020
.شعارنا هو السّلامة والجدارة والأثمنة الرّخيصة

89
00:05:54,020 --> 00:05:56,820
...وتتمثّل مهمّتنا في

90
00:05:54,980 --> 00:05:56,990
.المكان واسع نوعًا ما في الدّاخل

91
00:05:56,820 --> 00:05:59,050
...وشركتنا، صدّقوا أو لا

92
00:05:59,050 --> 00:06:01,790
!ماذا؟! ما الّذي تفعلانه؟

93
00:05:59,050 --> 00:06:01,790
!ما-ما هذا الشّيء؟

94
00:06:02,790 --> 00:06:05,190
.حسنًا! هذا ما سأقدّمه لكم اليوم

95
00:06:05,190 --> 00:06:10,370
.شفرة بورو بورو الّتي يعرفها النّاس حاليًّا

96
00:06:10,370 --> 00:06:13,840
.شفرة بورو بورو هي أفضل منتجات شركتنا

97
00:06:13,840 --> 00:06:18,740
!واليوم، سأقدّم لكم هذا النّموذج الجديد

98
00:06:18,740 --> 00:06:24,510
أنا واثق أنّ الكثير منكم يستعملون
.شفرة بورو بورو القديمة

99
00:06:24,510 --> 00:06:29,250
لكنّ النّموذج القديم، لم يسمح لكم
!بتغيير الوزن، وهو أمر سيّئ

100
00:06:29,250 --> 00:06:34,620
لم يمانع الآباء ذلك، لكن أراد الكثيرون
.أن يستعملها حتّى الأطفال

101
00:06:34,620 --> 00:06:36,660
!لا أعرف ما هي، لكنّها تبدو ممتعة

102
00:06:34,620 --> 00:06:41,100
لذلك، يسمح لكم هذا النّموذج الجديد
...بالحفاظ على إيقاع معيّن

103
00:06:41,100 --> 00:06:42,630
!هذا ممتع

104
00:06:43,160 --> 00:06:46,770
!تعرفون كلّ شيء عن هذا، صحيح؟
.هذه مزلقة أبو أبو

105
00:06:46,770 --> 00:06:49,440
!المنتج الأوّل في شركتنا

106
00:06:49,440 --> 00:06:51,070
!تمّ إطلاق نموذج جديد
!هيّا جرّبوها

107
00:06:51,470 --> 00:06:54,780
"كيف تكون " المنتج أفضل
أفضل من " المنتجّ الأول"؟

108
00:06:55,240 --> 00:06:56,080
.لا أدري

109
00:06:56,080 --> 00:07:00,150
!وهذا هو المنتج الأكثر مبيعًا
!"السّمكة الذّهبيّة"

110
00:07:00,150 --> 00:07:03,220
يُنصح به للأشخاص الّذين
.لا يتمرّنون كثيرًا هذه الأيّام

111
00:07:03,220 --> 00:07:07,260
سأعرض منتجات فقدان الوزن
!العظيمة هذه كمجموعة

112
00:07:07,260 --> 00:07:09,120
واليوم، واليوم فقط، سأضيف

113
00:07:09,120 --> 00:07:12,530
عشرين قنّينة مليئة بعصير ميرو ميرو
،المصنوع في الأزرق الغربيّ

114
00:07:12,530 --> 00:07:16,930
إضافة لموسوعة من 26 مجلّدًا
،ستكون مفيدة بكلّ تأكيد

115
00:07:17,200 --> 00:07:19,570
ومعها منظار مناسب جدًّا
!لاستعمالات متعدّدة

116
00:07:19,570 --> 00:07:21,270
!تسألون كم تكلفة كلّ هذا؟

117
00:07:21,270 --> 00:07:23,140
!بثمن بخس طبعًا

118
00:07:23,140 --> 00:07:24,540
!دعوا الأمر لي فحسب

119
00:07:24,540 --> 00:07:27,740
ولليوم فقط، سأقدّم كلّ هذا
!كعربون امتنان لإنقاذكم حياتي

120
00:07:27,740 --> 00:07:29,110
!هل ستعطينا كلّ هذا؟

121
00:07:29,110 --> 00:07:30,850
!خذوها فحسب أيّها اللّصوص

122
00:07:30,850 --> 00:07:33,850
!ما رأيكم بـ23,800 بيري؟

123
00:07:34,950 --> 00:07:36,320
!...إذًا فأنت ستبيعها لنا

124
00:07:36,890 --> 00:07:38,550
!أريدها

125
00:07:38,890 --> 00:07:40,190
!تريدون شراءها؟

126
00:07:44,460 --> 00:07:47,000
!لديك سكاكين مطبخ أيضًا؟

127
00:07:47,260 --> 00:07:49,300
نعم! تتحدّث عن هذه، صحيح؟

128
00:07:49,300 --> 00:07:52,230
إنّها أغراض ذات جودة عالية
صنعت بشكل فرديّ وبحذر

129
00:07:52,230 --> 00:07:54,040
.على يد حرفيّين من الجبل العالي

130
00:07:54,040 --> 00:07:55,670
.انظر لهذه المرونة

131
00:07:55,670 --> 00:07:58,510
.كما أنّ حدّتها الممتازة ستدوم للأبد

132
00:07:58,910 --> 00:08:00,480
،دزّينة سكاكين طاولة

133
00:08:00,480 --> 00:08:03,040
مقص مطبخ متعدّد
،الاستعمالات يقصّ أيّ شيء

134
00:08:03,040 --> 00:08:05,910
!سكّين تقشير ومشحذ كهربائيّ
!سأضيف كلّ هذه

135
00:08:05,910 --> 00:08:07,580
!إنّها مقابل 2,980 بيري إن اشتريتَها الآن

136
00:08:08,150 --> 00:08:11,650
،ومن أجلك يا آنستي
!لديّ صابون البشرة النّاعمة

137
00:08:11,650 --> 00:08:14,490
!سيجعل بشرتك ناعمة كالبيضة

138
00:08:15,090 --> 00:08:17,730
.فعلاً...؟ لديك كلّ شيء بالفعل

139
00:08:18,060 --> 00:08:18,930
.نعم

140
00:08:18,930 --> 00:08:22,900
ابتداءً من المياه المعدنيّة لقذائف
.المدفع، فلا يوجد ما لا نحمله معنا

141
00:08:22,900 --> 00:08:24,300
ألديكم أشياء حيّة أيضًا؟

142
00:08:24,300 --> 00:08:25,870
.حسنًا، ليست لدينا

143
00:08:26,640 --> 00:08:28,000
ماذا؟ ليس لديكم؟

144
00:08:28,000 --> 00:08:30,440
...ليس لدينا ما لا نحمله، لذلك

145
00:08:31,770 --> 00:08:33,640
وماذا عن الورق؟

146
00:08:34,410 --> 00:08:34,980
الورق؟

147
00:08:34,980 --> 00:08:37,380
صحيح. ورق قويّ كبير ويصعب تمزيقه

148
00:08:37,380 --> 00:08:41,180
وسيحتاج لأكثر من مجرّد
.نسيم بحر خفيف لإفساده

149
00:08:41,180 --> 00:08:43,620
.دعي الأمر لي

150
00:08:44,020 --> 00:08:47,090
يسعد شركة طلبيّات حلزون
الاتّصال بالبريد أن تقدّم بكلّ ثقة

151
00:08:47,290 --> 00:08:49,960
!الورق الأفضل، ورق الألفيّة

152
00:08:49,960 --> 00:08:51,090
!ورق الألفيّة؟

153
00:08:51,560 --> 00:08:53,730
صُنع ورق الألفيّة باستعمال
خشب شجرة الألفيّة

154
00:08:53,730 --> 00:08:55,730
الّتي تنمو في العادة
.في جزيرة ثمانية-تسعة

155
00:08:55,730 --> 00:08:58,070
إنّ هذا الورق يبعد الحشرات
وقيل لأنّه لن يهترئ

156
00:08:58,070 --> 00:09:00,770
،لحوالي ألف سنة تقريبًا
.حتّى إن تعرّض للشّمس

157
00:09:00,770 --> 00:09:05,540
إنّه الأفضل لكتابة شجرة العائلة
.وخرائط الكنوز

158
00:09:05,540 --> 00:09:07,080
والطّائرات الورقيّة أيضًا؟

159
00:09:07,080 --> 00:09:07,840
ماذا...؟

160
00:09:08,440 --> 00:09:10,010
...سيكون ذلك مضيعة فحسب

161
00:09:11,280 --> 00:09:12,910
كم ثمنه؟

162
00:09:12,910 --> 00:09:13,780
!ستشترينه؟

163
00:09:13,780 --> 00:09:14,980
!بالطّبع

164
00:09:14,980 --> 00:09:16,790
.اكتشفتُ رغبتها في الشّراء

165
00:09:18,150 --> 00:09:20,860
تبدو لي من النّوع الّذي يهمّه
.الثّمن ما دامت قد قرّرت الشّراء

166
00:09:25,030 --> 00:09:26,900
...حتّى إن كنتِ مهتمّة

167
00:09:27,230 --> 00:09:30,830
.فإنّه غرض قيّم ولا يوجد منه الكثير

168
00:09:31,100 --> 00:09:33,170
،حتّى إن طلبتِه الآن

169
00:09:33,170 --> 00:09:36,740
لا أدري إن كان سيكون متوفّرًا خلال
...خمس سنوات... أو حتّى عشر

170
00:09:38,510 --> 00:09:40,880
لكن ألا توجد طريقة ما لتبيعني إيّاه؟

171
00:09:40,880 --> 00:09:42,740
.سأدفع أيّ ثمن

172
00:09:42,980 --> 00:09:44,710
!ماذا؟

173
00:09:44,710 --> 00:09:47,820
نامي الّتي تفضّل عدّ المال
...على أكل وجباتها

174
00:09:47,820 --> 00:09:50,320
...نامي الّتي تحبّ المال بجنون

175
00:09:50,320 --> 00:09:52,520
!ستدفع أيّ ثمن؟

176
00:09:52,520 --> 00:09:53,720
...أنتم تبالغون كثيرًا

177
00:09:57,260 --> 00:10:00,530
...حسنًا... إن كنتِ مصرّة على ذلك

178
00:10:01,730 --> 00:10:03,570
رزمة من ألف ورقة ألفيّة

179
00:10:03,570 --> 00:10:05,830
،تكلّف في العادة 60 مليون بيري

180
00:10:05,830 --> 00:10:08,800
لكن ما رأيك بمبلغ 48 مليون بيري؟

181
00:10:09,070 --> 00:10:11,510
‫48 مليون بيري...!

182
00:10:11,510 --> 00:10:14,210
هل هذا يعني أنّ الورقة الواحدة
!ثمنها 48 ألف بيري؟

183
00:10:14,410 --> 00:10:16,880
ألا يمكنك تخفيض السّعر أكثر؟

184
00:10:18,150 --> 00:10:19,580
...حسنًا، سأجعله أرخص بكثير

185
00:10:19,580 --> 00:10:21,380
ما رأيك بثمن 47.5 مليون بيري؟

186
00:10:21,380 --> 00:10:22,620
!سأدفع مليونان

187
00:10:22,620 --> 00:10:24,220
‫4.8 مليون بيري!

188
00:10:24,220 --> 00:10:25,220
...يبدو هذا مريبًا

189
00:10:25,220 --> 00:10:26,150
ألا يمكنك تخفيضه أكثر؟

190
00:10:26,450 --> 00:10:27,420
!سأشتريه

191
00:10:28,190 --> 00:10:29,390
...سانجي-كُن

192
00:10:29,390 --> 00:10:31,130
ألديك المال؟

193
00:10:31,130 --> 00:10:31,690
!كلاّ

194
00:10:35,460 --> 00:10:38,800
،لكن إن سلّمناه للبحريّة
.فسنحصل على ذلك المبلغ وزيادة

195
00:10:38,970 --> 00:10:41,570
!ماذا؟

196
00:10:42,240 --> 00:10:45,810
.آسف يا لوفي. هذا من أجل نامي-سان

197
00:10:45,810 --> 00:10:47,040
!مهلاً لحظة

198
00:10:47,510 --> 00:10:48,640
لوفي...؟

199
00:10:50,050 --> 00:10:54,250
أتقصد بلوفي... مونكي د. لوفي؟

200
00:10:54,580 --> 00:10:56,480
.نعم، ذلك أنا

201
00:10:56,850 --> 00:10:58,950
.سانجي! هيّا، فكّ وثاقي

202
00:10:59,250 --> 00:11:00,160
.لا أستطيع

203
00:11:00,160 --> 00:11:03,860
ذ-ذ-لك القرصان البغيض صاحب
...مكافأة 100 مليون بيري

204
00:11:03,860 --> 00:11:05,530
مونكي د. لوفي...؟

205
00:11:05,990 --> 00:11:09,330
!صحيح... هذا علم قراصنة

206
00:11:10,930 --> 00:11:14,470
لا أصدّق أنّني غفلتُ عن
!تفصيل مهمّ كهذا

207
00:11:14,740 --> 00:11:15,870
!قلتُ لك أن تفكّني

208
00:11:15,870 --> 00:11:16,840
!لن أفعل

209
00:11:17,140 --> 00:11:17,970
!...مهلاً

210
00:11:18,410 --> 00:11:21,480
.تذكّرتُ للتّوّ أنّ لديّ موعدًا مهمًّا

211
00:11:21,480 --> 00:11:22,440
!مع السّلامة

212
00:11:23,810 --> 00:11:25,250
!شكرًا على كلّ شيء

213
00:11:25,250 --> 00:11:26,880
!...مهلاً، نسيت أغراضك

214
00:11:32,020 --> 00:11:33,190
ما قصّته؟

215
00:11:33,620 --> 00:11:35,890
...ربّما كان خائفًا منك

216
00:11:36,190 --> 00:11:39,130
.أنت مونكي د. لوفي، الرّجل المطلوب

217
00:11:41,030 --> 00:11:42,700
فعلاً...؟

218
00:11:46,570 --> 00:11:50,740
،اسمعوا. سأعمل في الوقت الحاليّ
لذلك لا تقاطعوني، مفهوم؟

219
00:11:50,740 --> 00:11:53,010
ماذا تعنين بـ"ستعملين"؟

220
00:11:54,480 --> 00:11:55,780
.إنّه سرّ

221
00:11:55,780 --> 00:11:56,980
...ذلك ليس ظريفًا

222
00:11:57,350 --> 00:11:58,680
!دعي الأمر لي

223
00:11:58,680 --> 00:12:02,520
لن أسمح لأيّ أحد بالاقتراب منك
.حتّى تنتهين من عملك

224
00:12:02,520 --> 00:12:05,190
لكن... ماذا إن تغيّر اتّجاه
الرّياح فجأة أو ما شابه؟

225
00:12:05,690 --> 00:12:07,160
...لا داعي للقلق. هذه السّحب

226
00:12:07,820 --> 00:12:09,690
،إن لم تتحرّك تلك السّحب

227
00:12:09,690 --> 00:12:12,130
فسنحظى بيوم جيّد
.ولن تكون هنالك أيّ مشاكل

228
00:12:12,690 --> 00:12:16,300
تعالوا لإعلامي إن تغيّر
.شيء ما في تلك السّحب

229
00:12:20,600 --> 00:12:22,100
...حسنًا

230
00:12:25,410 --> 00:12:27,640
كانت أيّامنا حافلة بالأحداث

231
00:12:27,640 --> 00:12:30,010
ولم أحظَ بأيّ وقت فراغ
...مذ دخلنا إلى الغراند لاين

232
00:12:32,150 --> 00:12:33,450
...ليتل غاردن

233
00:12:34,180 --> 00:12:35,420
...جزيرة درام

234
00:12:36,380 --> 00:12:37,420
...أراباستا

235
00:12:38,990 --> 00:12:42,360
.دوّنتُ كلّ الطّرق الّتي سلكناها

236
00:12:43,260 --> 00:12:47,830
وقد سرقتُ... بل حصلتُ على خرائط
.للمناطق المحيطة من المدن أيضًا

237
00:12:49,860 --> 00:12:53,740
...سأرسم... خريطة العالم خاصّتي

238
00:12:54,200 --> 00:12:56,140
!إنّه حلمي منذ الطّفولة

239
00:13:12,620 --> 00:13:13,520
!يا رفاق

240
00:13:13,520 --> 00:13:16,690
سنجعل سطح السّفينة نظيفًا
.ولامعًا بينما تعمل نامي-سان

241
00:13:17,090 --> 00:13:18,290
!أكيد

242
00:13:18,590 --> 00:13:19,660
!حظًّا سعيدًا

243
00:13:21,130 --> 00:13:22,260
!ستعمل أنت أيضًا

244
00:13:22,560 --> 00:13:23,470
!أيّها الخائن

245
00:13:23,470 --> 00:13:24,730
!ليس عدلاً

246
00:13:24,730 --> 00:13:25,330
!هذا صحيح

247
00:13:25,330 --> 00:13:27,740
ماذا عن تلك المرأة إذًا؟

248
00:13:28,140 --> 00:13:31,510
!لا تكن سخيفًا! إنّها آنسة محترمة

249
00:13:31,840 --> 00:13:34,710
...يا للغباء! لا يهمّ إن كانت امرأة أو رجل

250
00:13:34,710 --> 00:13:37,480
ساعدنا فحسب أيّها الوحش
!ذو رأس الطّحلب

251
00:13:38,110 --> 00:13:41,620
.هذا مضحك يا عفريت آلة الحبّ

252
00:13:41,620 --> 00:13:44,050
ساعدنا فحسب وإلاّ أوسعتك
.ضربًا أيّها الوغد

253
00:13:44,050 --> 00:13:47,690
أرني ما لديك. أتظنّ أنّ بإمكانك
هزيمة الوحش؟

254
00:13:47,690 --> 00:13:51,090
تقول ذلك فقط لأنّك
.لا تعرف قواي العفريتيّة

255
00:13:51,090 --> 00:13:52,190
فعلاً...؟

256
00:14:03,470 --> 00:14:04,270
!سأقطّعك

257
00:14:04,610 --> 00:14:06,540
!أتريدني أن أخرج أحشاءك؟

258
00:14:06,880 --> 00:14:09,310
!سأقطّعك لأشلاء

259
00:14:09,310 --> 00:14:11,580
!هيّا! هيّا! قتال! قتال

260
00:14:11,580 --> 00:14:13,210
...تـ-توقّفا كلاكما

261
00:14:13,210 --> 00:14:15,920
.أوسوبّ! لا تقف هناك وتشاهد
...لنوقفهما عن الشّجار

262
00:14:16,180 --> 00:14:18,320
!لا تكن سخيفًا! ما عساي فعله؟

263
00:14:18,590 --> 00:14:19,920
.تعرف أنّه يستحيل عليّ إيقافهما

264
00:14:19,920 --> 00:14:20,760
...صحيح

265
00:14:22,220 --> 00:14:23,590
!ها أنا ذا

266
00:14:27,930 --> 00:14:29,860
!ألم أخبركم أن تلزموا الصّمت؟

267
00:14:29,860 --> 00:14:30,670
...ميلورين

268
00:14:30,670 --> 00:14:32,670
...بـ-بضربة واحدة

269
00:14:36,610 --> 00:14:39,210
...سُحقًا، ذلك يؤلم

270
00:14:44,510 --> 00:14:45,850
...بيلمير-سان

271
00:14:45,850 --> 00:14:47,980
!اسمعيني يا بيلمير-سان

272
00:14:51,950 --> 00:14:53,220
...بيلمير-سان

273
00:14:53,720 --> 00:14:56,930
أخبريني، من أين تأتي الرّياح؟

274
00:14:58,390 --> 00:14:59,460
.من البحر

275
00:14:59,460 --> 00:15:00,400
البحر؟

276
00:15:00,530 --> 00:15:02,830
هذا صحيح. تولد الرّياح من البحر

277
00:15:02,830 --> 00:15:05,370
وتحمل النّعم عندما تهبّ
.على قرية كوكوياشي

278
00:15:05,700 --> 00:15:08,400
.ليست الرّياح فحسب
...المطر والغيوم وأقواس قزح

279
00:15:08,400 --> 00:15:10,840
.يأتي كلّ شيء من البحر

280
00:15:11,210 --> 00:15:12,910
...فهمت... أخبريني

281
00:15:12,910 --> 00:15:15,810
من أين يأتي البحر إذًا؟

282
00:15:15,810 --> 00:15:16,280
!ماذا؟

283
00:15:16,280 --> 00:15:17,080
.نامي

284
00:15:17,080 --> 00:15:19,610
.لا تتعبي بيلمير-سان بأسئلتك هذه

285
00:15:19,610 --> 00:15:21,380
...لكن يا نوجيكو

286
00:15:22,320 --> 00:15:24,250
.أنت فتاة فضوليّة بالفعل يا نامي

287
00:15:27,460 --> 00:15:30,590
!نامي

288
00:15:35,830 --> 00:15:37,730
!سمعتُ أنّك فعلتِ ذلك ثانية

289
00:15:37,970 --> 00:15:40,100
جاءت البائعة في متجر
.الكتب غاضبة إلى المنزل

290
00:15:40,440 --> 00:15:43,370
.هيّا، لنعد للمنزل. العشاء جاهز

291
00:15:44,110 --> 00:15:45,570
...أخبريني يا بيلمير-سان

292
00:15:46,340 --> 00:15:48,640
ماذا يوجد خلف البحر؟

293
00:15:48,880 --> 00:15:50,310
من يدري؟

294
00:15:50,310 --> 00:15:54,350
.لا أدري ما يوجد خلف الغراند لاين

295
00:15:54,350 --> 00:15:56,050
رغم أنّك كنت في البحريّة؟

296
00:15:56,050 --> 00:15:59,050
.صحيح، لكنّ البحر واسع جدًّا

297
00:15:59,550 --> 00:16:02,860
...أريد أن أرى... ما خلف البحر

298
00:16:02,860 --> 00:16:03,890
...نامي

299
00:16:03,890 --> 00:16:07,030
أتساءل إن كان بإمكاني الذّهاب
...إلى ما خلف البحر

300
00:16:07,430 --> 00:16:09,430
.أنت طفلة قويّة

301
00:16:09,430 --> 00:16:12,000
،إن رغبتِ في ذلك فعلاً
.فبإمكانك الذّهاب حيثما تريدين

302
00:16:12,830 --> 00:16:14,600
!اتّخذتُ قراري إذًا

303
00:16:14,600 --> 00:16:18,270
سأستعمل مهاراتي في الملاحة
لأسافر عبر محيطات العالم

304
00:16:18,540 --> 00:16:21,610
.وأرسم خريطة للعالم لكلّ شيء أراه

305
00:16:22,740 --> 00:16:23,810
!بكلّ تأكيد

306
00:16:24,310 --> 00:16:26,920
...هذا صحيح. سأحقّق ذلك يومًا ما

307
00:16:27,550 --> 00:16:30,450
.سأكمل رسم خريطة للعالم بكلّ تأكيد

308
00:16:32,490 --> 00:16:33,560
!يا لوفي

309
00:16:33,990 --> 00:16:35,420
!شاهد

310
00:16:39,260 --> 00:16:40,700
!مرحى

311
00:16:40,930 --> 00:16:41,900
!مذهل

312
00:16:42,360 --> 00:16:43,630
!مذهل! مذهل

313
00:16:43,630 --> 00:16:44,900
أليس كذلك؟

314
00:16:46,100 --> 00:16:47,070
!يا إلهي

315
00:16:49,540 --> 00:16:51,910
كنتِ تعملين بجدّ. هل انتهيتِ؟

316
00:16:51,910 --> 00:16:54,040
لا... لكن ما هذا؟

317
00:16:54,480 --> 00:16:56,510
أنتم، ما الّذي تفعلونه؟

318
00:16:56,810 --> 00:16:57,980
.ننظّف

319
00:16:57,980 --> 00:17:00,220
.هذا ممتع جدًّا
أتريدين المشاركة يا نامي؟

320
00:17:00,920 --> 00:17:02,720
.ما الّذي يحدث؟ أنتم صاخبون

321
00:17:04,150 --> 00:17:06,660
ماذا؟! أهذا صابون البشرة النّاعمة؟

322
00:17:07,060 --> 00:17:08,490
.هذا خطير جدًّا

323
00:17:08,860 --> 00:17:11,090
!لا بأس! لا بأس

324
00:17:14,530 --> 00:17:15,360
!لوفي

325
00:17:17,400 --> 00:17:18,400
!ذلك الغبيّ

326
00:17:18,400 --> 00:17:20,770
....غومو غومو نوو

327
00:17:21,370 --> 00:17:24,310
!قفزة البانجي

328
00:17:24,670 --> 00:17:25,810
!ابتعدوا

329
00:17:26,210 --> 00:17:27,040
!انتبهي يا نامي-سان

330
00:17:29,840 --> 00:17:31,150
هل أنت بخير يا نامي-سان؟

331
00:17:34,620 --> 00:17:36,020
...هذا مؤلم

332
00:17:40,760 --> 00:17:42,120
...خريطتي

333
00:17:42,120 --> 00:17:44,860
هل كنتِ ترسمين خريطة؟

334
00:17:44,860 --> 00:17:46,260
ماذا؟ خريطة؟

335
00:17:46,260 --> 00:17:48,660
..."هذا ما قصدتِه بـ"عمل

336
00:17:48,660 --> 00:17:49,900
.هذا صحيح

337
00:17:49,900 --> 00:17:53,230
إنّها الخريطة الوحيدة في
العالم الّتي سجّلت رحلتنا

338
00:17:53,230 --> 00:17:55,540
.بعد دخولنا الغراند لاين

339
00:17:56,140 --> 00:17:57,310
...ومع ذلك

340
00:17:59,310 --> 00:18:03,210
حلمي هو إكمال خريطة
!للعالم من رسمي

341
00:18:06,380 --> 00:18:07,280
!غادروا

342
00:18:07,850 --> 00:18:08,820
...لكن

343
00:18:08,820 --> 00:18:09,820
...غادروا فحسب

344
00:18:09,820 --> 00:18:10,450
!...نامي

345
00:18:10,950 --> 00:18:11,690
!ماذا؟

346
00:18:12,020 --> 00:18:12,950
...أنا آسف

347
00:18:12,950 --> 00:18:15,190
،إن كان الأسف كافيًا
!لما كان للبحريّة أيّ ضرورة

348
00:18:15,190 --> 00:18:16,460
.هيّا، غادر بسرعة

349
00:18:17,690 --> 00:18:20,460
إن لم تغادر، فسأفرض عليك
!غرامة 100 ألف بيري

350
00:18:23,700 --> 00:18:24,730
.إنّها غلطتك

351
00:18:24,730 --> 00:18:25,900
!لماذا ذلك؟

352
00:18:26,170 --> 00:18:27,240
.أظنّ ذلك أيضًا

353
00:18:26,170 --> 00:18:29,300
.يا إلهي، إنّهم يعترضون طريقي دائمًا

354
00:18:27,240 --> 00:18:27,670
.وأنا كذلك

355
00:18:27,670 --> 00:18:28,800
!ماذا؟! أنتما أيضًا؟

356
00:18:28,800 --> 00:18:30,540
!لوفي، ابتهج

357
00:18:52,630 --> 00:18:55,460
...ماذا؟ كأنّها رائحة مطر

358
00:19:11,110 --> 00:19:14,720
!ثمّة مشكلة! لوفي! لوفي

359
00:19:15,180 --> 00:19:16,620
!...ثمّة مشكلة! الغيوم

360
00:19:17,220 --> 00:19:19,050
.للعناكب عشرة أرجل

361
00:19:19,720 --> 00:19:21,090
.بل لديها ثمانية

362
00:19:21,320 --> 00:19:23,690
!ذلك لا يهمّ الآن! استيقظ

363
00:19:23,890 --> 00:19:25,690
...ولأمّ أربع وأربعين مائة

364
00:19:23,890 --> 00:19:26,390
!أوسوبّ! سانجي

365
00:19:26,390 --> 00:19:27,860
!استيقظ يا زورو

366
00:19:28,330 --> 00:19:29,530
!أيّ أحد

367
00:19:30,030 --> 00:19:32,000
!هنالك مشكلة

368
00:19:32,630 --> 00:19:33,540
!...نامي

369
00:19:34,540 --> 00:19:36,540
!سأفرض عليك غرامة 100 ألف بيري

370
00:19:38,010 --> 00:19:40,010
ما... ماذا أفعل...؟

371
00:19:45,310 --> 00:19:46,310
!انتهيت

372
00:19:47,880 --> 00:19:49,380
!إنّها مثاليّة إن حقّ لي وصفها

373
00:19:50,120 --> 00:19:51,590
هل أنا عبقريّة أم ماذا؟

374
00:19:52,390 --> 00:19:53,090
ماذا هنالك؟

375
00:19:54,460 --> 00:19:56,060
!مهلاً، ماذا حدث؟

376
00:19:57,290 --> 00:19:58,030
!نامي

377
00:19:58,330 --> 00:20:00,130
!مهلاً! ما الّذي كنت تفعله؟

378
00:20:00,800 --> 00:20:03,100
!لماذا لم تخبرني قبل أن يسوء الأمر؟

379
00:20:06,330 --> 00:20:09,340
لأنّك... قلتِ أنّك ستغرّمينني
...بمائة ألف بيري

380
00:20:11,240 --> 00:20:12,370
...أيّها الغبيّ

381
00:20:13,440 --> 00:20:16,110
!يا رفاق! إلى متى ستواصلون النّوم؟

382
00:20:18,310 --> 00:20:19,080
!ما هذا؟

383
00:20:19,250 --> 00:20:22,450
!إنّه إعصار! إنّه إعصار

384
00:20:19,850 --> 00:20:22,450
!ذلك واضح! قلتُ ذلك واضح

385
00:20:22,720 --> 00:20:24,820
!لوفي! زورو! اجمعوا الأشرعة

386
00:20:24,820 --> 00:20:25,520
!حاضر

387
00:20:25,990 --> 00:20:29,160
أوسوبّ! تشوبّر! أمّنا ما على
!سطح السّفينة بالحبال

388
00:20:29,160 --> 00:20:29,990
!حاضر

389
00:20:30,290 --> 00:20:31,960
!سانجي-كُن! استدر إلى الميمنة

390
00:20:35,160 --> 00:20:36,230
!هيّا

391
00:20:37,030 --> 00:20:38,600
،وجّه مقدّمة السّفينة بعيدًا عن الإعصار

392
00:20:38,900 --> 00:20:39,970
!وإلى ابتلعنا

393
00:20:39,970 --> 00:20:40,640
!حاضر

394
00:20:48,010 --> 00:20:48,840
...أنت، أنت

395
00:20:49,040 --> 00:20:49,810
!اسمعوا

396
00:20:50,650 --> 00:20:54,450
إن جرفت الأمواج خريطتي
،العزيزة أو ما شابه

397
00:20:55,180 --> 00:20:57,050
...فستدفعون الثّمن جميعًا

398
00:20:58,150 --> 00:21:00,020
.وثمنًا غاليًا

399
00:21:00,860 --> 00:21:02,060
...إنّها مخفية فعلاً

400
00:21:10,830 --> 00:21:12,800
.ارتفع الضّغط الجوّيّ وتوقّف المطر أيضًا

401
00:21:13,400 --> 00:21:16,040
!أحسنتم عملاً. يمكنكم أن ترتاحوا الآن

402
00:21:16,370 --> 00:21:17,370
!حاضر

403
00:21:17,370 --> 00:21:21,140
،ولكن، سأعود إلى العمل
.لذلك راقبوا السّحب ثانية

404
00:21:21,140 --> 00:21:22,280
!ألم تنتهي بعد؟

405
00:21:22,880 --> 00:21:24,210
!بالطّبع لا

406
00:21:24,450 --> 00:21:27,420
.هدفي هو رسم خريطة للعالم

407
00:21:27,720 --> 00:21:30,220
.أكملتُ أوّل خريطة فحسب

408
00:21:30,220 --> 00:21:31,990
.يبدأ العمل الحقيقيّ بدءًا من الآن

409
00:21:32,450 --> 00:21:33,460
...إنّها لا تكلّ أو تملّ

410
00:21:33,660 --> 00:21:35,420
!أحبّ نامي-سان هكذا أيضًا

411
00:21:35,690 --> 00:21:38,330
أتساءل إن كانت ستغرّمنا
...مائة ألف بيري ثانية

412
00:21:38,630 --> 00:21:39,390
...على الأرجح

413
00:21:42,100 --> 00:21:43,630
كنتِ تقرئين طوال هذا الوقت؟

414
00:21:43,970 --> 00:21:45,830
!حسنًا، افردوا الأشرعة

415
00:21:46,230 --> 00:21:48,670
!لننطلق بكامل سرعتنا

416
00:21:48,940 --> 00:21:50,410
!أجل

417
00:21:50,410 --> 00:21:51,810
.سأترك الباقي لكم

418
00:21:52,270 --> 00:21:53,310
...أنتِ

419
00:22:07,270 --> 00:22:13,380
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

420
00:22:13,380 --> 00:22:19,320
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

421
00:22:19,320 --> 00:22:25,560
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

422
00:22:25,560 --> 00:22:31,000
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

423
00:22:31,000 --> 00:22:37,230
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

424
00:22:37,230 --> 00:22:42,670
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

425
00:22:43,440 --> 00:22:46,440
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

426
00:22:46,440 --> 00:22:50,210
دعنا نرسم قصّة المستقبل

427
00:22:50,210 --> 00:22:55,450
سأضع كلّ مشاعري في رياح جديدة تمامًا الآن

428
00:22:55,450 --> 00:22:58,490
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

429
00:22:58,490 --> 00:23:01,460
رحلة لا نهاية لها لنكون معًا

430
00:23:01,460 --> 00:23:06,230
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

431
00:23:11,740 --> 00:23:14,570
اسمع، هل تعرف بشأن كاري البحريّة؟

432
00:23:14,570 --> 00:23:15,210
.لا أعرف

433
00:23:15,210 --> 00:23:16,110
.إنّه مشهور

434
00:23:16,110 --> 00:23:18,510
سمعتُ أنّ طهاة كلّ سفينة
.يتنافسون مع بعضهم

435
00:23:18,510 --> 00:23:20,210
.فعلاً؟ يبدو ذلك شهيًّا

436
00:23:20,210 --> 00:23:24,420
الفتى الّذي وقع من سفينة البحريّة
.سابقًا قال أنّه طبّاخ متدرّب

437
00:23:24,420 --> 00:23:26,780
يذكّرني ذلك بالوقت الّتي أمضيته
...في المطعم البحريّ

438
00:23:27,120 --> 00:23:28,520
:في الحلقة القادمة من ون بيس

439
00:23:28,520 --> 00:23:31,960
!وصفة متوارثة"
".سانجي، رجل الكاري الحديديّ

440
00:23:31,960 --> 00:23:33,960
!ملك القراصنة، لن يكون إلاّ أنا