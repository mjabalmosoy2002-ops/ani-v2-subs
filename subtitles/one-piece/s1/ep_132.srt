1
00:00:22,040 --> 00:00:25,110
!العالم... نعم

2
00:00:25,640 --> 00:00:27,310
...اسعوا نحو الحرّيّة

3
00:00:27,310 --> 00:00:31,450
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,810 --> 00:00:35,180
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,680 --> 00:00:37,050
!فتجاوزوها

6
00:00:37,450 --> 00:00:40,420
!تحت راية ما تؤمنون به

7
00:00:44,890 --> 00:00:50,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,500 --> 00:00:53,730
متّجهًا نحو عالم بلا نهاية

9
00:00:55,140 --> 00:01:00,010
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,010 --> 00:01:08,420
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,420 --> 00:01:14,160
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,160 --> 00:01:18,590
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,590 --> 00:01:24,230
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,230 --> 00:01:28,100
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,100 --> 00:01:33,040
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,040 --> 00:01:40,780
متّجهين نحو الأفق

17
00:01:40,780 --> 00:01:46,290
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,290 --> 00:01:50,990
متّجهًا نحو عالم بلا نهاية

19
00:01:50,990 --> 00:01:56,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,230 --> 00:02:02,500
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:12,350 --> 00:02:16,350
...1,868 ...1,867

22
00:02:16,350 --> 00:02:18,650
...1,869

23
00:02:32,000 --> 00:02:32,900
!اصطدتُ واحدة

24
00:02:36,940 --> 00:02:37,770
!انظر

25
00:02:38,010 --> 00:02:39,540
!هذا مذهل

26
00:02:42,140 --> 00:02:43,510
!اصطدتُ واحدة أيضًا

27
00:02:47,750 --> 00:02:52,020
إنّها كبيرة! لا بدّ أنّها السّمكة
!الحارسة لهذه المنطقة

28
00:02:52,990 --> 00:02:54,160
فعلاً؟

29
00:02:54,160 --> 00:02:55,490
!هذا مذهل

30
00:03:02,930 --> 00:03:04,700
!أجل

31
00:03:14,410 --> 00:03:15,440
السّمكة الحارسة...؟

32
00:03:15,440 --> 00:03:16,940
...لا يمكننا أكل هذه إطلاقًا

33
00:03:17,140 --> 00:03:18,250
!اخرس

34
00:03:18,250 --> 00:03:20,580
!لم تصطد سمكة واحدة حتّى
!لذلك لا تشتكِ

35
00:03:21,020 --> 00:03:22,250
.حسنًا. شاهد فحسب

36
00:03:24,350 --> 00:03:26,220
!سأمسك بواحدة كبيرة

37
00:03:28,490 --> 00:03:29,690
أيمكنك الصّيد من الأساس؟

38
00:03:29,690 --> 00:03:30,930
...سأصطاد شيئًا بطريقة ما

39
00:03:31,390 --> 00:03:33,660
!نامي-سان

40
00:03:34,360 --> 00:03:38,330
أحضرتُ لك عصيرًا استوائيًّا
مفيد جدًّا لجمالك

41
00:03:38,330 --> 00:03:39,900
!وسيجعل بشرتك ناعمة

42
00:03:40,940 --> 00:03:41,770
!شكرًا لك

43
00:03:42,370 --> 00:03:43,970
!ليس عدلاً

44
00:03:44,170 --> 00:03:45,470
!أريد عصيرًا أيضًا

45
00:03:45,670 --> 00:03:46,740
!أريد بشرة ناعمة

46
00:03:47,040 --> 00:03:47,910
...لا

47
00:03:48,410 --> 00:03:51,710
لماذا قد تحتاجون لبشرة ناعمة؟

48
00:03:52,880 --> 00:03:54,180
!لنكون أظرف

49
00:03:58,390 --> 00:04:00,320
.الرّياح جيّدة. التّيّار جيّد أيضًا

50
00:04:00,660 --> 00:04:02,860
.يبدو أنّنا لن نواجه أيّ مشاكل اليوم

51
00:04:03,420 --> 00:04:04,760
!أمسكتُ بشيء ما

52
00:04:13,900 --> 00:04:14,970
ما هذا الشّيء؟

53
00:04:15,570 --> 00:04:16,940
!إنّه ضخم

54
00:04:17,140 --> 00:04:19,140
!يا لوفي! ماذا أمسكت؟

55
00:04:25,580 --> 00:04:29,550
!تمرّد الملاّحة"
"!من أجل حُلم لا يتزعزع

56
00:04:33,690 --> 00:04:35,990
!يا لها من صدفة لولبيّة ضخمة

57
00:04:35,990 --> 00:04:38,630
.مهلاً، إنّها ليست صدفة لولبيّة

58
00:04:38,630 --> 00:04:39,790
!ما الّذي سنفعله؟

59
00:04:40,090 --> 00:04:41,230
هل تصلح للأكل؟

60
00:04:41,560 --> 00:04:42,730
!تريد أكلها؟

61
00:04:43,230 --> 00:04:44,400
ربّما نطهوها وهي في صدفتها؟

62
00:04:44,600 --> 00:04:45,730
!وأنت أيضًا؟

63
00:04:54,710 --> 00:04:57,510
!يا إلهي... ظننت أنّني سأموت

64
00:04:57,510 --> 00:04:59,280
.مرحبًا بالجميع

65
00:04:59,780 --> 00:05:01,250
من تكون؟

66
00:05:04,420 --> 00:05:07,460
صحيح... اعذروني لأنّني لم
.أعرّف عن نفسي باكرًا

67
00:05:07,460 --> 00:05:11,860
أنا جاهز لتوصيل أيّ منتجات
.لبلدتكم بكلّ ودّ باتّصال واحد فقط

68
00:05:11,860 --> 00:05:16,000
أنا رايس رايس من شركة
.طلبيّات حلزون الاتّصال بالبريد

69
00:05:16,700 --> 00:05:18,330
.سررت بلقائكم

70
00:05:20,530 --> 00:05:23,300
طلبيّات حلزون الاتّصال بالبريد؟
ما هذا؟

71
00:05:23,540 --> 00:05:28,910
حسنًا، كنت أقوم بعملية
،توصيل بهذا الإسكار

72
00:05:28,910 --> 00:05:30,650
لكنّني علقتُ في عاصفة قويّة

73
00:05:30,650 --> 00:05:35,280
وحُطّمتُ بسبب الأمواج
.الّتي تلاعبت بي يمينًا وشمالاً

74
00:05:35,280 --> 00:05:35,850
...فهمت

75
00:05:35,850 --> 00:05:37,250
.لا بدّ أنّك تشعر بالضّياع

76
00:05:37,920 --> 00:05:39,290
.ضياع تامّ

77
00:05:40,350 --> 00:05:42,960
!أمزح فحسب. أنت ذكيّة يا آنسة

78
00:05:43,620 --> 00:05:45,430
.حسنًا، اشرب بعض الماء

79
00:05:45,590 --> 00:05:48,430
.شكرًا لكم على إنقاذي

80
00:05:48,430 --> 00:05:49,900
،هذا ليس بالكثير
،لكنّه عربون امتناني

81
00:05:49,900 --> 00:05:51,300
.سأعطيكم هذه الفهارس

82
00:05:51,300 --> 00:05:52,900
.سأوصل لكم أيّ شيء بمكالمة واحدة

83
00:05:53,300 --> 00:05:54,800
.كم هذا مناسب

84
00:05:54,800 --> 00:05:56,600
تقوم بالتّوصيل حتّى في البحر؟

85
00:05:57,040 --> 00:05:58,570
.بالطّبع لا

86
00:05:59,040 --> 00:06:02,040
...هكذا... إذًا

87
00:06:02,040 --> 00:06:02,980
...نعم

88
00:06:03,180 --> 00:06:08,020
.شعارنا هو السّلامة والجدارة والأثمنة الرّخيصة

89
00:06:08,020 --> 00:06:10,820
...وتتمثّل مهمّتنا في

90
00:06:08,980 --> 00:06:10,990
.المكان واسع نوعًا ما في الدّاخل

91
00:06:10,820 --> 00:06:13,050
...وشركتنا، صدّقوا أو لا

92
00:06:13,050 --> 00:06:15,790
!ماذا؟! ما الّذي تفعلانه؟

93
00:06:13,050 --> 00:06:15,790
!ما-ما هذا الشّيء؟

94
00:06:16,790 --> 00:06:19,190
.حسنًا! هذا ما سأقدّمه لكم اليوم

95
00:06:19,190 --> 00:06:24,370
.شفرة بورو بورو الّتي يعرفها النّاس حاليًّا

96
00:06:24,370 --> 00:06:27,840
.شفرة بورو بورو هي أفضل منتجات شركتنا

97
00:06:27,840 --> 00:06:32,740
!واليوم، سأقدّم لكم هذا النّموذج الجديد

98
00:06:32,740 --> 00:06:38,510
أنا واثق أنّ الكثير منكم يستعملون
.شفرة بورو بورو القديمة

99
00:06:38,510 --> 00:06:43,250
لكنّ النّموذج القديم، لم يسمح لكم
!بتغيير الوزن، وهو أمر سيّئ

100
00:06:43,250 --> 00:06:48,620
لم يمانع الآباء ذلك، لكن أراد الكثيرون
.أن يستعملها حتّى الأطفال

101
00:06:48,620 --> 00:06:50,660
!لا أعرف ما هي، لكنّها تبدو ممتعة

102
00:06:48,620 --> 00:06:55,100
لذلك، يسمح لكم هذا النّموذج الجديد
...بالحفاظ على إيقاع معيّن

103
00:06:55,100 --> 00:06:56,630
!هذا ممتع

104
00:06:57,160 --> 00:07:00,770
!تعرفون كلّ شيء عن هذا، صحيح؟
.هذه مزلقة أبو أبو

105
00:07:00,770 --> 00:07:03,440
!المنتج الأوّل في شركتنا

106
00:07:03,440 --> 00:07:05,070
!تمّ إطلاق نموذج جديد
!هيّا جرّبوها

107
00:07:05,470 --> 00:07:08,780
"كيف تكون " المنتج أفضل
أفضل من " المنتجّ الأول"؟

108
00:07:09,240 --> 00:07:10,080
.لا أدري

109
00:07:10,080 --> 00:07:14,150
!وهذا هو المنتج الأكثر مبيعًا
!"السّمكة الذّهبيّة"

110
00:07:14,150 --> 00:07:17,220
يُنصح به للأشخاص الّذين
.لا يتمرّنون كثيرًا هذه الأيّام

111
00:07:17,220 --> 00:07:21,260
سأعرض منتجات فقدان الوزن
!العظيمة هذه كمجموعة

112
00:07:21,260 --> 00:07:23,120
واليوم، واليوم فقط، سأضيف

113
00:07:23,120 --> 00:07:26,530
عشرين قنّينة مليئة بعصير ميرو ميرو
،المصنوع في الأزرق الغربيّ

114
00:07:26,530 --> 00:07:30,930
إضافة لموسوعة من 26 مجلّدًا
،ستكون مفيدة بكلّ تأكيد

115
00:07:31,200 --> 00:07:33,570
ومعها منظار مناسب جدًّا
!لاستعمالات متعدّدة

116
00:07:33,570 --> 00:07:35,270
!تسألون كم تكلفة كلّ هذا؟

117
00:07:35,270 --> 00:07:37,140
!بثمن بخس طبعًا

118
00:07:37,140 --> 00:07:38,540
!دعوا الأمر لي فحسب

119
00:07:38,540 --> 00:07:41,740
ولليوم فقط، سأقدّم كلّ هذا
!كعربون امتنان لإنقاذكم حياتي

120
00:07:41,740 --> 00:07:43,110
!هل ستعطينا كلّ هذا؟

121
00:07:43,110 --> 00:07:44,850
!خذوها فحسب أيّها اللّصوص

122
00:07:44,850 --> 00:07:47,850
!ما رأيكم بـ23,800 بيري؟

123
00:07:48,950 --> 00:07:50,320
!...إذًا فأنت ستبيعها لنا

124
00:07:50,890 --> 00:07:52,550
!أريدها

125
00:07:52,890 --> 00:07:54,190
!تريدون شراءها؟

126
00:07:58,460 --> 00:08:01,000
!لديك سكاكين مطبخ أيضًا؟

127
00:08:01,260 --> 00:08:03,300
نعم! تتحدّث عن هذه، صحيح؟

128
00:08:03,300 --> 00:08:06,230
إنّها أغراض ذات جودة عالية
صنعت بشكل فرديّ وبحذر

129
00:08:06,230 --> 00:08:08,040
.على يد حرفيّين من الجبل العالي

130
00:08:08,040 --> 00:08:09,670
.انظر لهذه المرونة

131
00:08:09,670 --> 00:08:12,510
.كما أنّ حدّتها الممتازة ستدوم للأبد

132
00:08:12,910 --> 00:08:14,480
،دزّينة سكاكين طاولة

133
00:08:14,480 --> 00:08:17,040
مقص مطبخ متعدّد
،الاستعمالات يقصّ أيّ شيء

134
00:08:17,040 --> 00:08:19,910
!سكّين تقشير ومشحذ كهربائيّ
!سأضيف كلّ هذه

135
00:08:19,910 --> 00:08:21,580
!إنّها مقابل 2,980 بيري إن اشتريتَها الآن

136
00:08:22,150 --> 00:08:25,650
،ومن أجلك يا آنستي
!لديّ صابون البشرة النّاعمة

137
00:08:25,650 --> 00:08:28,490
!سيجعل بشرتك ناعمة كالبيضة

138
00:08:29,090 --> 00:08:31,730
.فعلاً...؟ لديك كلّ شيء بالفعل

139
00:08:32,060 --> 00:08:32,930
.نعم

140
00:08:32,930 --> 00:08:36,900
ابتداءً من المياه المعدنيّة لقذائف
.المدفع، فلا يوجد ما لا نحمله معنا

141
00:08:36,900 --> 00:08:38,300
ألديكم أشياء حيّة أيضًا؟

142
00:08:38,300 --> 00:08:39,870
.حسنًا، ليست لدينا

143
00:08:40,640 --> 00:08:42,000
ماذا؟ ليس لديكم؟

144
00:08:42,000 --> 00:08:44,440
...ليس لدينا ما لا نحمله، لذلك

145
00:08:45,770 --> 00:08:47,640
وماذا عن الورق؟

146
00:08:48,410 --> 00:08:48,980
الورق؟

147
00:08:48,980 --> 00:08:51,380
صحيح. ورق قويّ كبير ويصعب تمزيقه

148
00:08:51,380 --> 00:08:55,180
وسيحتاج لأكثر من مجرّد
.نسيم بحر خفيف لإفساده

149
00:08:55,180 --> 00:08:57,620
.دعي الأمر لي

150
00:08:58,020 --> 00:09:01,090
يسعد شركة طلبيّات حلزون
الاتّصال بالبريد أن تقدّم بكلّ ثقة

151
00:09:01,290 --> 00:09:03,960
!الورق الأفضل، ورق الألفيّة

152
00:09:03,960 --> 00:09:05,090
!ورق الألفيّة؟

153
00:09:05,560 --> 00:09:07,730
صُنع ورق الألفيّة باستعمال
خشب شجرة الألفيّة

154
00:09:07,730 --> 00:09:09,730
الّتي تنمو في العادة
.في جزيرة ثمانية-تسعة

155
00:09:09,730 --> 00:09:12,070
إنّ هذا الورق يبعد الحشرات
وقيل لأنّه لن يهترئ

156
00:09:12,070 --> 00:09:14,770
،لحوالي ألف سنة تقريبًا
.حتّى إن تعرّض للشّمس

157
00:09:14,770 --> 00:09:19,540
إنّه الأفضل لكتابة شجرة العائلة
.وخرائط الكنوز

158
00:09:19,540 --> 00:09:21,080
والطّائرات الورقيّة أيضًا؟

159
00:09:21,080 --> 00:09:21,840
ماذا...؟

160
00:09:22,440 --> 00:09:24,010
...سيكون ذلك مضيعة فحسب

161
00:09:25,280 --> 00:09:26,910
كم ثمنه؟

162
00:09:26,910 --> 00:09:27,780
!ستشترينه؟

163
00:09:27,780 --> 00:09:28,980
!بالطّبع

164
00:09:28,980 --> 00:09:30,790
.اكتشفتُ رغبتها في الشّراء

165
00:09:32,150 --> 00:09:34,860
تبدو لي من النّوع الّذي يهمّه
.الثّمن ما دامت قد قرّرت الشّراء

166
00:09:39,030 --> 00:09:40,900
...حتّى إن كنتِ مهتمّة

167
00:09:41,230 --> 00:09:44,830
.فإنّه غرض قيّم ولا يوجد منه الكثير

168
00:09:45,100 --> 00:09:47,170
،حتّى إن طلبتِه الآن

169
00:09:47,170 --> 00:09:50,740
لا أدري إن كان سيكون متوفّرًا خلال
...خمس سنوات... أو حتّى عشر

170
00:09:52,510 --> 00:09:54,880
لكن ألا توجد طريقة ما لتبيعني إيّاه؟

171
00:09:54,880 --> 00:09:56,740
.سأدفع أيّ ثمن

172
00:09:56,980 --> 00:09:58,710
!ماذا؟

173
00:09:58,710 --> 00:10:01,820
نامي الّتي تفضّل عدّ المال
...على أكل وجباتها

174
00:10:01,820 --> 00:10:04,320
...نامي الّتي تحبّ المال بجنون

175
00:10:04,320 --> 00:10:06,520
!ستدفع أيّ ثمن؟

176
00:10:06,520 --> 00:10:07,720
...أنتم تبالغون كثيرًا

177
00:10:11,260 --> 00:10:14,530
...حسنًا... إن كنتِ مصرّة على ذلك

178
00:10:15,730 --> 00:10:17,570
رزمة من ألف ورقة ألفيّة

179
00:10:17,570 --> 00:10:19,830
،تكلّف في العادة 60 مليون بيري

180
00:10:19,830 --> 00:10:22,800
لكن ما رأيك بمبلغ 48 مليون بيري؟

181
00:10:23,070 --> 00:10:25,510
‫48 مليون بيري...!

182
00:10:25,510 --> 00:10:28,210
هل هذا يعني أنّ الورقة الواحدة
!ثمنها 48 ألف بيري؟

183
00:10:28,410 --> 00:10:30,880
ألا يمكنك تخفيض السّعر أكثر؟

184
00:10:32,150 --> 00:10:33,580
...حسنًا، سأجعله أرخص بكثير

185
00:10:33,580 --> 00:10:35,380
ما رأيك بثمن 47.5 مليون بيري؟

186
00:10:35,380 --> 00:10:36,620
!سأدفع مليونان

187
00:10:36,620 --> 00:10:38,220
‫4.8 مليون بيري!

188
00:10:38,220 --> 00:10:39,220
...يبدو هذا مريبًا

189
00:10:39,220 --> 00:10:40,150
ألا يمكنك تخفيضه أكثر؟

190
00:10:40,450 --> 00:10:41,420
!سأشتريه

191
00:10:42,190 --> 00:10:43,390
...سانجي-كُن

192
00:10:43,390 --> 00:10:45,130
ألديك المال؟

193
00:10:45,130 --> 00:10:45,690
!كلاّ

194
00:10:49,460 --> 00:10:52,800
،لكن إن سلّمناه للبحريّة
.فسنحصل على ذلك المبلغ وزيادة

195
00:10:52,970 --> 00:10:55,570
!ماذا؟

196
00:10:56,240 --> 00:10:59,810
.آسف يا لوفي. هذا من أجل نامي-سان

197
00:10:59,810 --> 00:11:01,040
!مهلاً لحظة

198
00:11:01,510 --> 00:11:02,640
لوفي...؟

199
00:11:04,050 --> 00:11:08,250
أتقصد بلوفي... مونكي د. لوفي؟

200
00:11:08,580 --> 00:11:10,480
.نعم، ذلك أنا

201
00:11:10,850 --> 00:11:12,950
.سانجي! هيّا، فكّ وثاقي

202
00:11:13,250 --> 00:11:14,160
.لا أستطيع

203
00:11:14,160 --> 00:11:17,860
ذ-ذ-لك القرصان البغيض صاحب
...مكافأة 100 مليون بيري

204
00:11:17,860 --> 00:11:19,530
مونكي د. لوفي...؟

205
00:11:19,990 --> 00:11:23,330
!صحيح... هذا علم قراصنة

206
00:11:24,930 --> 00:11:28,470
لا أصدّق أنّني غفلتُ عن
!تفصيل مهمّ كهذا

207
00:11:28,740 --> 00:11:29,870
!قلتُ لك أن تفكّني

208
00:11:29,870 --> 00:11:30,840
!لن أفعل

209
00:11:31,140 --> 00:11:31,970
!...مهلاً

210
00:11:32,410 --> 00:11:35,480
.تذكّرتُ للتّوّ أنّ لديّ موعدًا مهمًّا

211
00:11:35,480 --> 00:11:36,440
!مع السّلامة

212
00:11:37,810 --> 00:11:39,250
!شكرًا على كلّ شيء

213
00:11:39,250 --> 00:11:40,880
!...مهلاً، نسيت أغراضك

214
00:11:46,020 --> 00:11:47,190
ما قصّته؟

215
00:11:47,620 --> 00:11:49,890
...ربّما كان خائفًا منك

216
00:11:50,190 --> 00:11:53,130
.أنت مونكي د. لوفي، الرّجل المطلوب

217
00:11:55,030 --> 00:11:56,700
فعلاً...؟

218
00:12:00,570 --> 00:12:04,740
،اسمعوا. سأعمل في الوقت الحاليّ
لذلك لا تقاطعوني، مفهوم؟

219
00:12:04,740 --> 00:12:07,010
ماذا تعنين بـ"ستعملين"؟

220
00:12:08,480 --> 00:12:09,780
.إنّه سرّ

221
00:12:09,780 --> 00:12:10,980
...ذلك ليس ظريفًا

222
00:12:11,350 --> 00:12:12,680
!دعي الأمر لي

223
00:12:12,680 --> 00:12:16,520
لن أسمح لأيّ أحد بالاقتراب منك
.حتّى تنتهين من عملك

224
00:12:16,520 --> 00:12:19,190
لكن... ماذا إن تغيّر اتّجاه
الرّياح فجأة أو ما شابه؟

225
00:12:19,690 --> 00:12:21,160
...لا داعي للقلق. هذه السّحب

226
00:12:21,820 --> 00:12:23,690
،إن لم تتحرّك تلك السّحب

227
00:12:23,690 --> 00:12:26,130
فسنحظى بيوم جيّد
.ولن تكون هنالك أيّ مشاكل

228
00:12:26,690 --> 00:12:30,300
تعالوا لإعلامي إن تغيّر
.شيء ما في تلك السّحب

229
00:12:34,600 --> 00:12:36,100
...حسنًا

230
00:12:39,410 --> 00:12:41,640
كانت أيّامنا حافلة بالأحداث

231
00:12:41,640 --> 00:12:44,010
ولم أحظَ بأيّ وقت فراغ
...مذ دخلنا إلى الغراند لاين

232
00:12:46,150 --> 00:12:47,450
...ليتل غاردن

233
00:12:48,180 --> 00:12:49,420
...جزيرة درام

234
00:12:50,380 --> 00:12:51,420
...أراباستا

235
00:12:52,990 --> 00:12:56,360
.دوّنتُ كلّ الطّرق الّتي سلكناها

236
00:12:57,260 --> 00:13:01,830
وقد سرقتُ... بل حصلتُ على خرائط
.للمناطق المحيطة من المدن أيضًا

237
00:13:03,860 --> 00:13:07,740
...سأرسم... خريطة العالم خاصّتي

238
00:13:08,200 --> 00:13:10,140
!إنّه حلمي منذ الطّفولة

239
00:13:26,620 --> 00:13:27,520
!يا رفاق

240
00:13:27,520 --> 00:13:30,690
سنجعل سطح السّفينة نظيفًا
.ولامعًا بينما تعمل نامي-سان

241
00:13:31,090 --> 00:13:32,290
!أكيد

242
00:13:32,590 --> 00:13:33,660
!حظًّا سعيدًا

243
00:13:35,130 --> 00:13:36,260
!ستعمل أنت أيضًا

244
00:13:36,560 --> 00:13:37,470
!أيّها الخائن

245
00:13:37,470 --> 00:13:38,730
!ليس عدلاً

246
00:13:38,730 --> 00:13:39,330
!هذا صحيح

247
00:13:39,330 --> 00:13:41,740
ماذا عن تلك المرأة إذًا؟

248
00:13:42,140 --> 00:13:45,510
!لا تكن سخيفًا! إنّها آنسة محترمة

249
00:13:45,840 --> 00:13:48,710
...يا للغباء! لا يهمّ إن كانت امرأة أو رجل

250
00:13:48,710 --> 00:13:51,480
ساعدنا فحسب أيّها الوحش
!ذو رأس الطّحلب

251
00:13:52,110 --> 00:13:55,620
.هذا مضحك يا عفريت آلة الحبّ

252
00:13:55,620 --> 00:13:58,050
ساعدنا فحسب وإلاّ أوسعتك
.ضربًا أيّها الوغد

253
00:13:58,050 --> 00:14:01,690
أرني ما لديك. أتظنّ أنّ بإمكانك
هزيمة الوحش؟

254
00:14:01,690 --> 00:14:05,090
تقول ذلك فقط لأنّك
.لا تعرف قواي العفريتيّة

255
00:14:05,090 --> 00:14:06,190
فعلاً...؟

256
00:14:17,470 --> 00:14:18,270
!سأقطّعك

257
00:14:18,610 --> 00:14:20,540
!أتريدني أن أخرج أحشاءك؟

258
00:14:20,880 --> 00:14:23,310
!سأقطّعك لأشلاء

259
00:14:23,310 --> 00:14:25,580
!هيّا! هيّا! قتال! قتال

260
00:14:25,580 --> 00:14:27,210
...تـ-توقّفا كلاكما

261
00:14:27,210 --> 00:14:29,920
.أوسوبّ! لا تقف هناك وتشاهد
...لنوقفهما عن الشّجار

262
00:14:30,180 --> 00:14:32,320
!لا تكن سخيفًا! ما عساي فعله؟

263
00:14:32,590 --> 00:14:33,920
.تعرف أنّه يستحيل عليّ إيقافهما

264
00:14:33,920 --> 00:14:34,760
...صحيح

265
00:14:36,220 --> 00:14:37,590
!ها أنا ذا

266
00:14:41,930 --> 00:14:43,860
!ألم أخبركم أن تلزموا الصّمت؟

267
00:14:43,860 --> 00:14:44,670
...ميلورين

268
00:14:44,670 --> 00:14:46,670
...بـ-بضربة واحدة

269
00:14:50,610 --> 00:14:53,210
...سُحقًا، ذلك يؤلم

270
00:14:58,510 --> 00:14:59,850
...بيلمير-سان

271
00:14:59,850 --> 00:15:01,980
!اسمعيني يا بيلمير-سان

272
00:15:05,950 --> 00:15:07,220
...بيلمير-سان

273
00:15:07,720 --> 00:15:10,930
أخبريني، من أين تأتي الرّياح؟

274
00:15:12,390 --> 00:15:13,460
.من البحر

275
00:15:13,460 --> 00:15:14,400
البحر؟

276
00:15:14,530 --> 00:15:16,830
هذا صحيح. تولد الرّياح من البحر

277
00:15:16,830 --> 00:15:19,370
وتحمل النّعم عندما تهبّ
.على قرية كوكوياشي

278
00:15:19,700 --> 00:15:22,400
.ليست الرّياح فحسب
...المطر والغيوم وأقواس قزح

279
00:15:22,400 --> 00:15:24,840
.يأتي كلّ شيء من البحر

280
00:15:25,210 --> 00:15:26,910
...فهمت... أخبريني

281
00:15:26,910 --> 00:15:29,810
من أين يأتي البحر إذًا؟

282
00:15:29,810 --> 00:15:30,280
!ماذا؟

283
00:15:30,280 --> 00:15:31,080
.نامي

284
00:15:31,080 --> 00:15:33,610
.لا تتعبي بيلمير-سان بأسئلتك هذه

285
00:15:33,610 --> 00:15:35,380
...لكن يا نوجيكو

286
00:15:36,320 --> 00:15:38,250
.أنت فتاة فضوليّة بالفعل يا نامي

287
00:15:41,460 --> 00:15:44,590
!نامي

288
00:15:49,830 --> 00:15:51,730
!سمعتُ أنّك فعلتِ ذلك ثانية

289
00:15:51,970 --> 00:15:54,100
جاءت البائعة في متجر
.الكتب غاضبة إلى المنزل

290
00:15:54,440 --> 00:15:57,370
.هيّا، لنعد للمنزل. العشاء جاهز

291
00:15:58,110 --> 00:15:59,570
...أخبريني يا بيلمير-سان

292
00:16:00,340 --> 00:16:02,640
ماذا يوجد خلف البحر؟

293
00:16:02,880 --> 00:16:04,310
من يدري؟

294
00:16:04,310 --> 00:16:08,350
.لا أدري ما يوجد خلف الغراند لاين

295
00:16:08,350 --> 00:16:10,050
رغم أنّك كنت في البحريّة؟

296
00:16:10,050 --> 00:16:13,050
.صحيح، لكنّ البحر واسع جدًّا

297
00:16:13,550 --> 00:16:16,860
...أريد أن أرى... ما خلف البحر

298
00:16:16,860 --> 00:16:17,890
...نامي

299
00:16:17,890 --> 00:16:21,030
أتساءل إن كان بإمكاني الذّهاب
...إلى ما خلف البحر

300
00:16:21,430 --> 00:16:23,430
.أنت طفلة قويّة

301
00:16:23,430 --> 00:16:26,000
،إن رغبتِ في ذلك فعلاً
.فبإمكانك الذّهاب حيثما تريدين

302
00:16:26,830 --> 00:16:28,600
!اتّخذتُ قراري إذًا

303
00:16:28,600 --> 00:16:32,270
سأستعمل مهاراتي في الملاحة
لأسافر عبر محيطات العالم

304
00:16:32,540 --> 00:16:35,610
.وأرسم خريطة للعالم لكلّ شيء أراه

305
00:16:36,740 --> 00:16:37,810
!بكلّ تأكيد

306
00:16:38,310 --> 00:16:40,920
...هذا صحيح. سأحقّق ذلك يومًا ما

307
00:16:41,550 --> 00:16:44,450
.سأكمل رسم خريطة للعالم بكلّ تأكيد

308
00:16:46,490 --> 00:16:47,560
!يا لوفي

309
00:16:47,990 --> 00:16:49,420
!شاهد

310
00:16:53,260 --> 00:16:54,700
!مرحى

311
00:16:54,930 --> 00:16:55,900
!مذهل

312
00:16:56,360 --> 00:16:57,630
!مذهل! مذهل

313
00:16:57,630 --> 00:16:58,900
أليس كذلك؟

314
00:17:00,100 --> 00:17:01,070
!يا إلهي

315
00:17:03,540 --> 00:17:05,910
كنتِ تعملين بجدّ. هل انتهيتِ؟

316
00:17:05,910 --> 00:17:08,040
لا... لكن ما هذا؟

317
00:17:08,480 --> 00:17:10,510
أنتم، ما الّذي تفعلونه؟

318
00:17:10,810 --> 00:17:11,980
.ننظّف

319
00:17:11,980 --> 00:17:14,220
.هذا ممتع جدًّا
أتريدين المشاركة يا نامي؟

320
00:17:14,920 --> 00:17:16,720
.ما الّذي يحدث؟ أنتم صاخبون

321
00:17:18,150 --> 00:17:20,660
ماذا؟! أهذا صابون البشرة النّاعمة؟

322
00:17:21,060 --> 00:17:22,490
.هذا خطير جدًّا

323
00:17:22,860 --> 00:17:25,090
!لا بأس! لا بأس

324
00:17:28,530 --> 00:17:29,360
!لوفي

325
00:17:31,400 --> 00:17:32,400
!ذلك الغبيّ

326
00:17:32,400 --> 00:17:34,770
....غومو غومو نوو

327
00:17:35,370 --> 00:17:38,310
!قفزة البانجي

328
00:17:38,670 --> 00:17:39,810
!ابتعدوا

329
00:17:40,210 --> 00:17:41,040
!انتبهي يا نامي-سان

330
00:17:43,840 --> 00:17:45,150
هل أنت بخير يا نامي-سان؟

331
00:17:48,620 --> 00:17:50,020
...هذا مؤلم

332
00:17:54,760 --> 00:17:56,120
...خريطتي

333
00:17:56,120 --> 00:17:58,860
هل كنتِ ترسمين خريطة؟

334
00:17:58,860 --> 00:18:00,260
ماذا؟ خريطة؟

335
00:18:00,260 --> 00:18:02,660
..."هذا ما قصدتِه بـ"عمل

336
00:18:02,660 --> 00:18:03,900
.هذا صحيح

337
00:18:03,900 --> 00:18:07,230
إنّها الخريطة الوحيدة في
العالم الّتي سجّلت رحلتنا

338
00:18:07,230 --> 00:18:09,540
.بعد دخولنا الغراند لاين

339
00:18:10,140 --> 00:18:11,310
...ومع ذلك

340
00:18:13,310 --> 00:18:17,210
حلمي هو إكمال خريطة
!للعالم من رسمي

341
00:18:20,380 --> 00:18:21,280
!غادروا

342
00:18:21,850 --> 00:18:22,820
...لكن

343
00:18:22,820 --> 00:18:23,820
...غادروا فحسب

344
00:18:23,820 --> 00:18:24,450
!...نامي

345
00:18:24,950 --> 00:18:25,690
!ماذا؟

346
00:18:26,020 --> 00:18:26,950
...أنا آسف

347
00:18:26,950 --> 00:18:29,190
،إن كان الأسف كافيًا
!لما كان للبحريّة أيّ ضرورة

348
00:18:29,190 --> 00:18:30,460
.هيّا، غادر بسرعة

349
00:18:31,690 --> 00:18:34,460
إن لم تغادر، فسأفرض عليك
!غرامة 100 ألف بيري

350
00:18:37,700 --> 00:18:38,730
.إنّها غلطتك

351
00:18:38,730 --> 00:18:39,900
!لماذا ذلك؟

352
00:18:40,170 --> 00:18:41,240
.أظنّ ذلك أيضًا

353
00:18:40,170 --> 00:18:43,300
.يا إلهي، إنّهم يعترضون طريقي دائمًا

354
00:18:41,240 --> 00:18:41,670
.وأنا كذلك

355
00:18:41,670 --> 00:18:42,800
!ماذا؟! أنتما أيضًا؟

356
00:18:42,800 --> 00:18:44,540
!لوفي، ابتهج

357
00:19:06,630 --> 00:19:09,460
...ماذا؟ كأنّها رائحة مطر

358
00:19:25,110 --> 00:19:28,720
!ثمّة مشكلة! لوفي! لوفي

359
00:19:29,180 --> 00:19:30,620
!...ثمّة مشكلة! الغيوم

360
00:19:31,220 --> 00:19:33,050
.للعناكب عشرة أرجل

361
00:19:33,720 --> 00:19:35,090
.بل لديها ثمانية

362
00:19:35,320 --> 00:19:37,690
!ذلك لا يهمّ الآن! استيقظ

363
00:19:37,890 --> 00:19:39,690
...ولأمّ أربع وأربعين مائة

364
00:19:37,890 --> 00:19:40,390
!أوسوبّ! سانجي

365
00:19:40,390 --> 00:19:41,860
!استيقظ يا زورو

366
00:19:42,330 --> 00:19:43,530
!أيّ أحد

367
00:19:44,030 --> 00:19:46,000
!هنالك مشكلة

368
00:19:46,630 --> 00:19:47,540
!...نامي

369
00:19:48,540 --> 00:19:50,540
!سأفرض عليك غرامة 100 ألف بيري

370
00:19:52,010 --> 00:19:54,010
ما... ماذا أفعل...؟

371
00:19:59,310 --> 00:20:00,310
!انتهيت

372
00:20:01,880 --> 00:20:03,380
!إنّها مثاليّة إن حقّ لي وصفها

373
00:20:04,120 --> 00:20:05,590
هل أنا عبقريّة أم ماذا؟

374
00:20:06,390 --> 00:20:07,090
ماذا هنالك؟

375
00:20:08,460 --> 00:20:10,060
!مهلاً، ماذا حدث؟

376
00:20:11,290 --> 00:20:12,030
!نامي

377
00:20:12,330 --> 00:20:14,130
!مهلاً! ما الّذي كنت تفعله؟

378
00:20:14,800 --> 00:20:17,100
!لماذا لم تخبرني قبل أن يسوء الأمر؟

379
00:20:20,330 --> 00:20:23,340
لأنّك... قلتِ أنّك ستغرّمينني
...بمائة ألف بيري

380
00:20:25,240 --> 00:20:26,370
...أيّها الغبيّ

381
00:20:27,440 --> 00:20:30,110
!يا رفاق! إلى متى ستواصلون النّوم؟

382
00:20:32,310 --> 00:20:33,080
!ما هذا؟

383
00:20:33,250 --> 00:20:36,450
!إنّه إعصار! إنّه إعصار

384
00:20:33,850 --> 00:20:36,450
!ذلك واضح! قلتُ ذلك واضح

385
00:20:36,720 --> 00:20:38,820
!لوفي! زورو! اجمعوا الأشرعة

386
00:20:38,820 --> 00:20:39,520
!حاضر

387
00:20:39,990 --> 00:20:43,160
أوسوبّ! تشوبّر! أمّنا ما على
!سطح السّفينة بالحبال

388
00:20:43,160 --> 00:20:43,990
!حاضر

389
00:20:44,290 --> 00:20:45,960
!سانجي-كُن! استدر إلى الميمنة

390
00:20:49,160 --> 00:20:50,230
!هيّا

391
00:20:51,030 --> 00:20:52,600
،وجّه مقدّمة السّفينة بعيدًا عن الإعصار

392
00:20:52,900 --> 00:20:53,970
!وإلى ابتلعنا

393
00:20:53,970 --> 00:20:54,640
!حاضر

394
00:21:02,010 --> 00:21:02,840
...أنت، أنت

395
00:21:03,040 --> 00:21:03,810
!اسمعوا

396
00:21:04,650 --> 00:21:08,450
إن جرفت الأمواج خريطتي
،العزيزة أو ما شابه

397
00:21:09,180 --> 00:21:11,050
...فستدفعون الثّمن جميعًا

398
00:21:12,150 --> 00:21:14,020
.وثمنًا غاليًا

399
00:21:14,860 --> 00:21:16,060
...إنّها مخفية فعلاً

400
00:21:24,830 --> 00:21:26,800
.ارتفع الضّغط الجوّيّ وتوقّف المطر أيضًا

401
00:21:27,400 --> 00:21:30,040
!أحسنتم عملاً. يمكنكم أن ترتاحوا الآن

402
00:21:30,370 --> 00:21:31,370
!حاضر

403
00:21:31,370 --> 00:21:35,140
،ولكن، سأعود إلى العمل
.لذلك راقبوا السّحب ثانية

404
00:21:35,140 --> 00:21:36,280
!ألم تنتهي بعد؟

405
00:21:36,880 --> 00:21:38,210
!بالطّبع لا

406
00:21:38,450 --> 00:21:41,420
.هدفي هو رسم خريطة للعالم

407
00:21:41,720 --> 00:21:44,220
.أكملتُ أوّل خريطة فحسب

408
00:21:44,220 --> 00:21:45,990
.يبدأ العمل الحقيقيّ بدءًا من الآن

409
00:21:46,450 --> 00:21:47,460
...إنّها لا تكلّ أو تملّ

410
00:21:47,660 --> 00:21:49,420
!أحبّ نامي-سان هكذا أيضًا

411
00:21:49,690 --> 00:21:52,330
أتساءل إن كانت ستغرّمنا
...مائة ألف بيري ثانية

412
00:21:52,630 --> 00:21:53,390
...على الأرجح

413
00:21:56,100 --> 00:21:57,630
كنتِ تقرئين طوال هذا الوقت؟

414
00:21:57,970 --> 00:21:59,830
!حسنًا، افردوا الأشرعة

415
00:22:00,230 --> 00:22:02,670
!لننطلق بكامل سرعتنا

416
00:22:02,940 --> 00:22:04,410
!أجل

417
00:22:04,410 --> 00:22:05,810
.سأترك الباقي لكم

418
00:22:06,270 --> 00:22:07,310
...أنتِ

419
00:22:21,270 --> 00:22:27,380
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

420
00:22:27,380 --> 00:22:33,320
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

421
00:22:33,320 --> 00:22:39,560
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

422
00:22:39,560 --> 00:22:45,000
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

423
00:22:45,000 --> 00:22:51,230
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

424
00:22:51,230 --> 00:22:56,670
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

425
00:22:57,440 --> 00:23:00,440
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

426
00:23:00,440 --> 00:23:04,210
دعنا نرسم قصّة المستقبل

427
00:23:04,210 --> 00:23:09,450
سأضع كلّ مشاعري في رياح جديدة تمامًا الآن

428
00:23:09,450 --> 00:23:12,490
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

429
00:23:12,490 --> 00:23:15,460
رحلة لا نهاية لها لنكون معًا

430
00:23:15,460 --> 00:23:20,230
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

431
00:23:25,740 --> 00:23:28,570
اسمع، هل تعرف بشأن كاري البحريّة؟

432
00:23:28,570 --> 00:23:29,210
.لا أعرف

433
00:23:29,210 --> 00:23:30,110
.إنّه مشهور

434
00:23:30,110 --> 00:23:32,510
سمعتُ أنّ طهاة كلّ سفينة
.يتنافسون مع بعضهم

435
00:23:32,510 --> 00:23:34,210
.فعلاً؟ يبدو ذلك شهيًّا

436
00:23:34,210 --> 00:23:38,420
الفتى الّذي وقع من سفينة البحريّة
.سابقًا قال أنّه طبّاخ متدرّب

437
00:23:38,420 --> 00:23:40,780
يذكّرني ذلك بالوقت الّتي أمضيته
...في المطعم البحريّ

438
00:23:41,120 --> 00:23:42,520
:في الحلقة القادمة من ون بيس

439
00:23:42,520 --> 00:23:45,960
!وصفة متوارثة"
".سانجي، رجل الكاري الحديديّ

440
00:23:45,960 --> 00:23:47,960
!ملك القراصنة، لن يكون إلاّ أنا