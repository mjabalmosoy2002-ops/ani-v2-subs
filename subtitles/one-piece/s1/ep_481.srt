1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:21,730 --> 00:03:24,000
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:24,000 --> 00:03:29,070
!وصل لوفي إلى مارينفورد لينقذ أخاه إيس الّذي سيُعدَم

39
00:03:29,070 --> 00:03:36,100
تمكّن هو وطاقم اللّحية البيضاء أخيرًا من
!تخطّي الجدران المحيطة للوصول إلى المنصّة

40
00:03:36,100 --> 00:03:42,540
في خضمّ هجوم البحريّة، يركض لوفي صوب
!إيس بمساعدة من طاقم اللّحية البيضاء

41
00:03:50,700 --> 00:03:53,680
...أخيرًا... أخيرًا

42
00:03:55,200 --> 00:03:57,020
!وصلت

43
00:03:57,330 --> 00:03:58,790
!لوفي

44
00:04:00,030 --> 00:04:02,310
!...أنت حقًّا

45
00:04:02,310 --> 00:04:06,030
!أطلقوا! فجّروهم

46
00:04:16,060 --> 00:04:19,410
!ثمّة نفق من النّار في الدّخان

47
00:04:20,200 --> 00:04:22,670
!لطالما كنت هكذا

48
00:04:23,100 --> 00:04:24,500
!يا لوفي

49
00:04:27,870 --> 00:04:30,220
...لم تصغ إليّ قطّ

50
00:04:35,530 --> 00:04:38,310
!ودائمًا ما فعلتَ أشياء جنونيّة

51
00:04:44,730 --> 00:04:48,610
!إيس

52
00:04:56,200 --> 00:05:01,220
"!تمّ إنقاذ إيس! أمر اللّحية البيضاء الأخير"

53
00:05:23,830 --> 00:05:26,860
...قـ-قبضة النّار" إيس"

54
00:05:27,930 --> 00:05:30,860
!قد تحرّر الآن

55
00:05:31,180 --> 00:05:34,360
!رائع! نجحتَ يا قبّعة القشّ

56
00:05:34,360 --> 00:05:36,570
!لقد أنقذ إيس

57
00:05:36,990 --> 00:05:43,000
!كان يعمل بلا هوادة منذ إمبل داون
...ذلك الشّخص حقًّا

58
00:05:43,370 --> 00:05:45,790
!استثناء

59
00:05:49,460 --> 00:05:51,210
!حمدًا لهذا

60
00:05:52,090 --> 00:05:57,180
!أتممت مهمّتك أخيرًا يا لوفي

61
00:05:57,680 --> 00:06:00,890
...إن استطعنا الهروب من هنا بسلام

62
00:06:01,200 --> 00:06:02,680
!سنتزوّج

63
00:06:05,730 --> 00:06:10,570
!انظر يا كوبي! قبّعة القشّ اللّعين نجح أخيرًا

64
00:06:11,190 --> 00:06:14,740
!لوفي-سان، أنت مذهل

65
00:06:14,920 --> 00:06:19,120
!لا تفقدوا هدوءكم! استعدّوا للإطلاق

66
00:06:19,120 --> 00:06:20,950
!أطلقوا عليهم أثناء نزولهم

67
00:06:20,950 --> 00:06:21,370
!حاضر

68
00:06:23,580 --> 00:06:26,870
!ابق متيقّظًا يا لوفي! لنتفرّق حاليًّا

69
00:06:26,870 --> 00:06:28,040
!حسنًا

70
00:06:28,880 --> 00:06:30,710
!لا

71
00:06:33,720 --> 00:06:36,010
!وصيّة اللّهب

72
00:06:37,370 --> 00:06:38,760
!عمود النّار

73
00:07:12,800 --> 00:07:14,670
!إنّه قويّ جدًّا! احذروا

74
00:07:18,840 --> 00:07:20,930
هل يمكنك القتال يا لوفي؟

75
00:07:20,930 --> 00:07:22,140
!بالطّبع

76
00:07:23,890 --> 00:07:26,350
!إيس-سان! لوفي-كن

77
00:07:28,060 --> 00:07:31,860
لا تنسوا! قبضّة النّار إيس صاحب
!فاكهة النّار من نوع لوغيا

78
00:07:31,860 --> 00:07:37,530
!لم أتخيّل قطّ أنّك ستنقذني يومًا ما

79
00:07:37,530 --> 00:07:39,240
!شكرًا يا لوفي

80
00:07:42,280 --> 00:07:45,290
!ساعدني اللّحية البيضاء والبقيّة على فعل ذلك

81
00:07:46,700 --> 00:07:49,180
!لا تظنّا أنّكما في مأمن الآن

82
00:07:50,830 --> 00:07:53,790
!أصبحت الآن هذه ساحة إعدامكم

83
00:08:05,240 --> 00:08:05,890
!إنّها فرصتنا

84
00:08:05,890 --> 00:08:07,850
!سأمزّقك إربًا

85
00:08:12,400 --> 00:08:15,940
!إنّه أخي! لا تقربوه

86
00:08:19,200 --> 00:08:20,840
!قبضة النّار

87
00:08:30,830 --> 00:08:32,420
!المستوى الثّاني

88
00:08:32,420 --> 00:08:33,460
!الانتقال الآنيّ

89
00:08:39,170 --> 00:08:41,590
...فاكهة المطّاط

90
00:08:41,590 --> 00:08:44,230
!الطّابع النّفّاث

91
00:08:46,550 --> 00:08:47,880
!مسدّس النّار

92
00:08:53,910 --> 00:08:55,390
!فلتمت

93
00:09:02,570 --> 00:09:06,410
!لنسرع يا لوفي! علينا أن نخرج من هذا المكان

94
00:09:09,080 --> 00:09:10,160
!حسنًا

95
00:09:12,330 --> 00:09:14,630
!إنّهما ثنائيّ مثاليّ

96
00:09:14,630 --> 00:09:17,460
!أفسحوا لهما الطّريق للهرب

97
00:09:21,590 --> 00:09:24,050
!لا تدعوهما يهربان بأيّ ثمن

98
00:09:26,550 --> 00:09:27,640
!ضوء اليراعة

99
00:09:29,290 --> 00:09:30,600
!اشتعال

100
00:09:34,100 --> 00:09:36,900
!أعدموا قبضة النّار وقبّعة القشّ

101
00:09:37,650 --> 00:09:39,360
...فاكهة المطّاط

102
00:09:39,900 --> 00:09:43,320
!الرشّاش النّفّاث

103
00:10:29,490 --> 00:10:32,160
!أصبحت أقوى يا لوفي

104
00:10:42,250 --> 00:10:44,720
!سأصبح أقوى منك يومًا ما

105
00:10:51,220 --> 00:10:53,930
!إذًا، دعني أحميك الآن

106
00:10:54,560 --> 00:10:58,310
.أقلتَ "يومًا ما"؟ لا غد لكما

107
00:10:58,310 --> 00:11:01,900
هل تظنّان أنّكما تستطيعان الهرب؟

108
00:11:01,900 --> 00:11:03,190
!الأميرال كوزان

109
00:11:03,850 --> 00:11:05,530
!ذاك الوغد

110
00:11:07,030 --> 00:11:08,910
!كتلة الجليد

111
00:11:08,910 --> 00:11:10,990
.تراجع يا لوفي

112
00:11:22,990 --> 00:11:24,980
!منقار التّدرّج الهائج

113
00:11:24,980 --> 00:11:26,550
!لهب نار المرآة

114
00:12:12,250 --> 00:12:16,310
!لقد تخبّر جليد أوكيجي-سان على الفور

115
00:12:18,430 --> 00:12:23,230
!إنّه قائد وحدتنا الثّانية
!فمن الطّبيعيّ أن يستطيع فعل ذلك

116
00:12:23,230 --> 00:12:24,270
!رائع

117
00:12:24,270 --> 00:12:26,400
!يا لهما من أخوين

118
00:12:26,400 --> 00:12:30,860
!كفّوا عن الانبهار أيّها الأغبياء

119
00:12:30,860 --> 00:12:34,280
!أصلح حلزون الاتّصال بسرعة

120
00:12:34,760 --> 00:12:36,830
!حـ-حاضر

121
00:12:39,460 --> 00:12:45,800
...والآن، أتساءل إلى أيّ مدى يمكنه الهرب
!الجزء المهمّ يبدأ الآن يا قبّعة القشّ

122
00:12:46,520 --> 00:12:54,180
على أيّ حال، إن كان يمكنني أن أجهز على اللّحية
...البيضاء الّذي يُحتضر بالفعل في هذا التّشابك

123
00:12:55,680 --> 00:12:58,720
!فسأصير أحد اليونكو

124
00:12:58,720 --> 00:13:04,860
!مذهل! إنّه مسترخٍ في خضمّ وضعٍ كهذا
!هذا هو قبطاننا باغي

125
00:13:07,640 --> 00:13:10,030
...سيّد 2

126
00:13:10,570 --> 00:13:14,960
.بالكاد حقّقتُ أمنيّتك

127
00:13:16,160 --> 00:13:18,830
...والآن، عليّ أن أهرب وأختبئ

128
00:13:18,830 --> 00:13:21,080
!لمن يدين هذا الخائن بالولاء؟

129
00:13:22,580 --> 00:13:25,880
!لا، بل هو سجين متنكّر كحارس

130
00:13:25,880 --> 00:13:27,550
!لا

131
00:13:29,840 --> 00:13:31,090
!أميرال الأسطول-دونو

132
00:13:32,010 --> 00:13:35,800
!لا أصدّق هذا الخطأ الفادح
!حتّى أنا لم أستطع إيقافه

133
00:13:38,510 --> 00:13:43,060
!دعوهما يذهبان
!هكذا ستكون الأمور مثيرة للاهتمام أكثر

134
00:13:43,060 --> 00:13:44,650
!كفاك هراءً

135
00:13:45,440 --> 00:13:48,080
!حتّى قوّة الأميرال بلا جدوى أمامهما

136
00:13:48,080 --> 00:13:50,070
!فكيف لنا أن نقاتلهما؟

137
00:13:50,070 --> 00:13:52,070
!لا تهلعا

138
00:13:53,820 --> 00:13:55,530
!الأميرال ساكازوكي

139
00:13:57,030 --> 00:14:00,740
!لن ندعهما يهربان من هنا

140
00:14:03,870 --> 00:14:07,210
!لا تخافوا! لنهزمهما

141
00:14:13,140 --> 00:14:15,220
!مـ-ماذا الآن؟

142
00:14:20,810 --> 00:14:24,940
!انتبهوا جميعًا! سفينتهم تتحرّك

143
00:14:24,940 --> 00:14:28,150
!لا تقتربوا! إنّها تسير في الأرض بمجاديفها

144
00:14:28,900 --> 00:14:30,940
!مهلاً، من على متنها؟

145
00:14:38,120 --> 00:14:39,580
!سكوارد

146
00:14:39,580 --> 00:14:41,620
!قراصنة عنكبوت الدّوّامة

147
00:14:43,620 --> 00:14:47,790
!والدي، جميعًا، اهربوا

148
00:14:48,190 --> 00:14:51,710
!دعوا الحرب لنا

149
00:14:56,380 --> 00:14:59,010
!أولئك الحمقى

150
00:15:24,160 --> 00:15:27,080
!لا تكن سخيفًا يا سكوارد

151
00:15:27,080 --> 00:15:29,750
!من الواضح أنّك تشتهي الموت

152
00:15:33,800 --> 00:15:36,170
.بالطّبع أشتهيه

153
00:15:36,970 --> 00:15:40,220
.ما فعلته لوالدي كان فظيعًا

154
00:15:46,350 --> 00:15:49,480
،حتّى إن كان هذا لا يصلّح الأمر

155
00:15:49,480 --> 00:15:52,890
!لا يمكنني أن أدع الأمور على هذا الحال

156
00:15:55,610 --> 00:15:59,950
.آسف يا رفاق. ما كان يجب أن أدعهم تركبون

157
00:15:59,950 --> 00:16:03,240
!لا بأس أيّها القبطان! لا تقلق

158
00:16:03,250 --> 00:16:05,160
!تبعناك لأنّنا أردنا ذلك

159
00:16:05,580 --> 00:16:07,710
!سنختار أين سنموت بأنفسنا

160
00:16:08,010 --> 00:16:11,260
!أيّها القبطان! سنتبعك حتّى النّهاية

161
00:16:12,110 --> 00:16:13,810
...أنا آسف

162
00:16:15,200 --> 00:16:18,550
!جميعًا، خذوا إيس واهربوا

163
00:16:18,550 --> 00:16:21,260
!نار الإله: النّار المجهولة

164
00:16:26,900 --> 00:16:27,680
!سكوارد

165
00:16:34,820 --> 00:16:36,110
!أحمق

166
00:16:37,610 --> 00:16:42,610
!سكوارد اللّعين! تلك ليست الطّريقة الذكيّة للقيام بالأمر

167
00:16:42,610 --> 00:16:46,120
!أنت! أسرع وفكّ وثاقي

168
00:16:49,320 --> 00:16:53,080
!رفاق! هل أنتم بخير؟

169
00:16:57,100 --> 00:17:00,150
!تقدّموا

170
00:17:11,880 --> 00:17:13,900
!والدي

171
00:17:24,070 --> 00:17:25,520
!ماذا حدث؟

172
00:17:25,520 --> 00:17:28,290
!توقّفت هذه السّفينة

173
00:17:46,970 --> 00:17:48,760
!والدي

174
00:17:48,760 --> 00:17:51,770
...بـ-بيد واحدة فقط

175
00:17:53,140 --> 00:17:55,770
!أوقف السّفينة

176
00:18:09,080 --> 00:18:15,670
...ألا تعي كم من الجُحد لطفل

177
00:18:15,670 --> 00:18:20,340
!أن يموت أمام والده يا سكوارد؟

178
00:18:29,520 --> 00:18:31,220
!لا تسلّم لثقتك

179
00:18:32,110 --> 00:18:37,980
!تلك الطّعنة الصّغيرة الّتي تسبّبت بها لا تهدّد حياتي حقًّا

180
00:18:38,410 --> 00:18:41,610
!لكلّ امرئ مدّة من حياته

181
00:18:50,830 --> 00:18:54,000
!لقد حقّقنا هدفنا هنا

182
00:18:54,000 --> 00:18:58,420
!ما عاد سبب يبقينا هنا

183
00:18:58,420 --> 00:18:59,340
!الوالد العجوز

184
00:18:59,340 --> 00:19:01,040
!والدي

185
00:19:05,380 --> 00:19:10,230
!أصغوا جيّدًا يا قراصنة اللّحية البيضاء

186
00:19:13,020 --> 00:19:18,060
!سأوّجه لكم أمرًا من القبطان للمرّة الأخيرة

187
00:19:18,360 --> 00:19:22,690
!ماذا تقصد بـ"الأخيرة؟!" انتظر يا والدي، هذا محزن حقًّا

188
00:19:22,690 --> 00:19:24,940
!لا أريد أن أسمع مثل هذا الكلام

189
00:19:25,310 --> 00:19:27,610
!لنعد إلى العالم الجديد معًا

190
00:19:29,620 --> 00:19:31,830
!نار الصّليب

191
00:19:32,560 --> 00:19:33,870
!والدي

192
00:19:33,870 --> 00:19:37,460
!ستفترق سبلنا ها هنا

193
00:19:37,800 --> 00:19:44,090
!جميعًا، انجوا بأيّ ثمن وعودوا إلى العالم الجديد بسلام

194
00:19:52,260 --> 00:19:55,640
!و-والدي! هل تخطّط للموت هنا؟

195
00:19:58,360 --> 00:20:02,610
!أنا أثرٌ من العصر القديم

196
00:20:03,240 --> 00:20:08,450
!لا توجد أيّ سفينة تحملني في العصر الجديد

197
00:20:16,580 --> 00:20:20,870
!اذهبوا يا رفاق

198
00:20:31,340 --> 00:20:32,720
!اللّحية البيضاء

199
00:20:40,560 --> 00:20:43,320
!لا يا والدي

200
00:20:43,320 --> 00:20:45,520
!هذا أمر! علينا الذّهاب

201
00:20:45,520 --> 00:20:46,940
!العجوز

202
00:20:46,940 --> 00:20:48,740
!والدي

203
00:21:02,790 --> 00:21:04,960
!لا تنظروا للوراء

204
00:21:06,080 --> 00:21:08,700
!لأنّ العصر يتغيّر

205
00:21:53,970 --> 00:21:57,770
...بدأ كلّ شيء في ذلك البحر

206
00:22:02,180 --> 00:22:04,480
!هذا لا يصدّق

207
00:22:05,060 --> 00:22:08,370
أنت، لِمَ تبدو خاملاً؟

208
00:22:08,370 --> 00:22:11,500
!انضمّ لنا! هناك كنز أكثر من كافٍ

209
00:22:11,500 --> 00:22:14,070
.دعك منه

210
00:22:14,070 --> 00:22:18,940
...ماذا؟ ماذا تقصد؟ حصلنا على هذه الكنوز بفضله

211
00:22:18,950 --> 00:22:23,110
.دعه فحسب! ليس مهتمًّا بالكنوز

212
00:22:23,110 --> 00:22:27,420
هذا غريب! أيّ قرصان هو؟

213
00:22:27,960 --> 00:22:30,760
ماذا ترغب به؟

214
00:22:30,760 --> 00:22:33,240
!يا نيوغيت

215
00:22:49,960 --> 00:22:54,860
.كنتُ أرتحل لوقت طويل حقًّا

216
00:22:59,800 --> 00:23:02,990
!لننه الأمر

217
00:23:03,380 --> 00:23:05,080
!أيّتها البحريّة

218
00:23:11,460 --> 00:23:15,660
،خانعين لأمر اللّحية البيضاء الأخير
.يتجرّع القراصنة حزنهم وينسحبون

219
00:23:15,660 --> 00:23:19,530
إلاّ أنّ كلمات أكاينو القاسية بحقّ اللّحية البيضاء

220
00:23:19,530 --> 00:23:21,980
.أوقفت إيس

221
00:23:21,980 --> 00:23:26,350
يتجاهل إيس احتجاجات أصدقائه
!ويتقدّم إلى الأمام ليلقى قبضة أكاينو

222
00:23:26,350 --> 00:23:27,820
:في الحلقة القادمة من وان بيس

223
00:23:27,820 --> 00:23:31,260
!القوّة الّتي تستطيع حرق حتّى النّار"
"!ملاحَقة أكاينو القاسية

224
00:23:31,260 --> 00:23:33,520
!ملك القراصنة، لن يكون إلاّ أنا

225
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة