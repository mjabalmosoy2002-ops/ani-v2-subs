1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,790
"وأقول "أريد أن أصير أقوى

5
00:00:47,950 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,370 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,590 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,930 --> 00:03:21,900
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:22,390 --> 00:03:25,360
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:25,360 --> 00:03:27,020
!الّذي اقترب موعد إعدامه

40
00:03:27,890 --> 00:03:31,450
أثناء ذلك، يغير قراصنة اللّحية
...البيضاء على مارينفورد

41
00:03:31,830 --> 00:03:34,660
!وتنشب بينهم وبين البحريّة حرب شاملة

42
00:03:37,710 --> 00:03:39,700
!أورز

43
00:03:47,040 --> 00:03:51,800
!القليل فحسب وأصل لإيس-كُن

44
00:03:56,230 --> 00:03:57,730
!رجل الظّلّ

45
00:04:00,150 --> 00:04:01,490
!سيف سحليّة الظّلال

46
00:04:07,880 --> 00:04:12,310
"!العدالة لمن ينتصر! بدء العمل باستراتيجيّة سنغوكو"

47
00:04:39,880 --> 00:04:43,270
!أرأيت؟ هكذا يُقتل شخص ما

48
00:04:43,590 --> 00:04:45,190
!أيّها القبطان أورز

49
00:04:45,430 --> 00:04:48,420
!سحقًا لك أيّها الشّيتشيبوكاي

50
00:04:48,420 --> 00:04:49,520
!أيّها القبطان

51
00:04:49,710 --> 00:04:51,200
!أورز

52
00:04:59,530 --> 00:05:00,960
...إيس-كُن

53
00:05:07,450 --> 00:05:08,640
!أورز

54
00:05:30,870 --> 00:05:33,410
...إيس... كُن

55
00:05:50,080 --> 00:05:51,420
...إيس

56
00:05:54,170 --> 00:05:55,760
...كُن

57
00:06:39,880 --> 00:06:46,400
!أورز

58
00:07:04,110 --> 00:07:09,180
!سأصنع من جثّته أقوى جنديّ زومبي

59
00:07:18,750 --> 00:07:20,750
...أورز

60
00:07:22,700 --> 00:07:24,190
!أرخيت دفاعك أيّها اللّحية البيضاء

61
00:07:46,530 --> 00:07:48,330
!يا نائب الأميرال لونز

62
00:08:00,530 --> 00:08:05,820
!هـ-هزم نائب أميرال عملاق في البحريّة بسهولة

63
00:08:16,860 --> 00:08:18,900
...أورز

64
00:08:26,660 --> 00:08:30,290
!تسلّقوا جسد أورز وتقدّموا

65
00:08:58,960 --> 00:09:00,460
!هذا ممتاز

66
00:09:01,470 --> 00:09:04,700
!دوفلامينغو! كيف أمكنك فعل ذلك لأورز؟

67
00:09:04,700 --> 00:09:06,710
!سأجعلك تدفع الثّمن مهما كان

68
00:09:08,130 --> 00:09:09,330
ما المضحك؟

69
00:09:09,530 --> 00:09:11,360
أقلت ما المضحك؟

70
00:09:11,360 --> 00:09:13,920
إنّه شعور تواجدي في مركز التّاريخ
!الّذي يراودني الآن

71
00:09:16,620 --> 00:09:19,010
!صار هذا المكان نقطة تحوّل

72
00:09:19,210 --> 00:09:20,670
!عمّ تتحدّث؟

73
00:09:22,890 --> 00:09:24,350
!هذا هو قائدنا

74
00:09:24,350 --> 00:09:26,400
!لا يسع دوفلامينغو إلاّ الهرب الآن

75
00:09:47,450 --> 00:09:50,160
!أ-أيّها اللّواء البحريّ يوكيمورا

76
00:10:27,590 --> 00:10:30,180
!لا أستطيع! لا أستطيع! لا أستطيع

77
00:10:30,180 --> 00:10:32,290
!أنا خائف ولا يسعني فعل أيّ شيء

78
00:10:32,370 --> 00:10:36,010
حتّى أولئك المقاتلين الأقوياء
!يسقطون الواحد تلو الآخر

79
00:10:36,330 --> 00:10:39,710
!لا يمكنني تحمّل هذا! يا لي من فاشل

80
00:10:40,280 --> 00:10:42,620
!انتظر يا كوبي! أنا قادم معك

81
00:10:43,170 --> 00:10:45,140
!عد إلى ساحة المعركة

82
00:10:47,410 --> 00:10:49,850
!دعني أذهب رجاءً

83
00:10:52,490 --> 00:10:54,730
الأميرال أكاينو! لماذا هو هنا؟

84
00:10:54,940 --> 00:10:56,540
أنا خائف من الموت

85
00:10:56,950 --> 00:10:59,190
!وعندما أفكّر في عائلتي، أشعر بالضّعف

86
00:10:59,420 --> 00:11:01,400
!أرجوك! أنا أتوسّل إليك

87
00:11:04,330 --> 00:11:06,580
...نحن جنود البحريّة

88
00:11:07,220 --> 00:11:12,870
نقاتل القراصنة و"عدالة" العالم
!منقوشة على ظهورنا

89
00:11:13,630 --> 00:11:19,920
وكلّ من يهرب وهو يجرّ أذيال الخيبة
.لا يمكن أن يوصف بجنديّ البحريّة

90
00:11:20,570 --> 00:11:22,270
...وكنتُ لأنعته

91
00:11:22,900 --> 00:11:24,000
!بذرّة غبار

92
00:11:28,340 --> 00:11:32,980
،إن كنت تفكّر فعلاً في عائلتك
!فلا تعش في خزي

93
00:11:38,690 --> 00:11:41,680
!مستحيل! لا يمكنه قتل رجل من صفوفنا

94
00:11:43,540 --> 00:11:44,840
!أيّها الأميرال ساكازوكي

95
00:11:45,470 --> 00:11:47,530
.نحن جاهزون للبدء بالاستراتيجيّة

96
00:11:47,530 --> 00:11:50,150
!جيّد! حان الوقت

97
00:11:56,920 --> 00:11:58,420
الاستراتيجيّة"؟"

98
00:11:58,840 --> 00:12:01,800
!إيس

99
00:12:22,800 --> 00:12:24,910
!استعملوا المساحة الّتي فتحها أورز

100
00:12:26,200 --> 00:12:27,720
!ادخلوا الخليج

101
00:12:33,870 --> 00:12:37,910
!لندمّر رأس الخليج ونفتح مساحة أكبر

102
00:12:37,910 --> 00:12:39,750
!أطلقوا للأمام مباشرة

103
00:12:51,640 --> 00:12:53,930
!سُحقًا! لم يُخدش حتّى

104
00:12:54,330 --> 00:12:55,690
!دعوا الأمر لي

105
00:13:03,270 --> 00:13:04,770
!كاسحة جليد؟

106
00:13:05,590 --> 00:13:07,570
!إنّها ساحرة الجليد وايتي بي

107
00:13:07,910 --> 00:13:10,310
.كان ذلك سهلاً علينا

108
00:13:10,830 --> 00:13:13,370
!هيّا يا رفاق! لننطلق

109
00:13:13,520 --> 00:13:14,870
!شكرًا لكم

110
00:13:15,120 --> 00:13:17,370
!علينا التّحرّك نحو الخليج أيضًا

111
00:13:24,080 --> 00:13:28,920
ما الخطب يا قائد الوحدة الثّالثة عشر
ثور الماء أتموس؟

112
00:13:29,130 --> 00:13:32,350
!جـ-جسدي... ماذا فعلت يا دوفلامينغو؟

113
00:13:32,480 --> 00:13:33,590
!أيّها القائد أتموس

114
00:13:33,840 --> 00:13:36,220
!إيّاكم! لا تقتربوا منّي

115
00:13:36,810 --> 00:13:37,560
!ما الخطب؟

116
00:13:37,560 --> 00:13:37,940
!بسرعة

117
00:13:39,050 --> 00:13:40,310
!أيّها القائد

118
00:13:40,310 --> 00:13:41,190
!كلاّ

119
00:13:44,610 --> 00:13:47,360
أيّها القائد أتموس... لماذا؟

120
00:13:48,750 --> 00:13:50,960
!لا يمكنني التّحكّم بجسدي

121
00:13:50,960 --> 00:13:52,780
!توقّف يا دوفلامينغو

122
00:13:54,280 --> 00:13:56,570
!أيّها القائد

123
00:14:07,660 --> 00:14:10,310
"يمثّل القراصنة الشّرّ وتمثّل البحريّة العدالة؟"

124
00:14:10,570 --> 00:14:12,760
!كُتب ذلك وأعيد كتابته مرّات عدّة عبر التّاريخ

125
00:14:13,900 --> 00:14:15,890
القيم تختلف في نظر أطفال لم يعرفوا السّلام قطّ

126
00:14:16,180 --> 00:14:19,470
.والأطفال الّذين يجهلون كلّ الجهل عن الحرب

127
00:14:20,100 --> 00:14:24,000
إنّ من ينتهي به المطاف في القمّة
.هو من يعيد كتابة ما الخطأ وما الصّواب

128
00:14:24,610 --> 00:14:27,890
!وهذا المكان هو نقطة التّحوّل

129
00:14:30,860 --> 00:14:32,660
"ستسود العدالة؟"

130
00:14:33,300 --> 00:14:35,280
!بالطّبع ستسود

131
00:14:38,680 --> 00:14:41,580
!لأنّ المنتصر هو من يقرّر العدالة

132
00:15:00,390 --> 00:15:02,760
!لقد تجاوزوا رأس الخليج في نقطتين

133
00:15:03,340 --> 00:15:10,210
!سيمتلئ الخليج بحلفاء اللّحية البيضاء

134
00:15:10,740 --> 00:15:12,120
!يا أميرال الأسطول سنغوكو

135
00:15:12,520 --> 00:15:13,850
.لا مشكلة

136
00:15:16,650 --> 00:15:19,370
.تسورو-سان، لنبدأ العمل

137
00:15:19,520 --> 00:15:20,980
.إنّه وقت مناسب

138
00:15:20,980 --> 00:15:21,970
!ابتعدي

139
00:15:21,970 --> 00:15:24,200
!ستنالين ما هو أسوأ من الإصابات إن لم تبتعدي

140
00:15:24,370 --> 00:15:25,500
!ابتعدي أيّتها العجوز

141
00:15:27,710 --> 00:15:28,620
!لقد غُسلت

142
00:15:28,880 --> 00:15:30,090
!لقد عُلّقت

143
00:15:30,290 --> 00:15:32,320
!لكنّه شعور رائع

144
00:15:32,320 --> 00:15:35,250
.تحتاجان لمليون سنة قبل أن تستطيعا هزيمتي

145
00:15:36,350 --> 00:15:38,520
!أوصلوني لكلّ السّفن والجنود

146
00:15:38,660 --> 00:15:50,670
...رنين، رنين، رنين

147
00:15:53,100 --> 00:15:55,730
.إنّه يخطّط لأمر ما

148
00:15:56,320 --> 00:15:59,440
.يا لك من أميرال واسع الحيلة أيّها "البوذا" سنغوكو

149
00:16:07,870 --> 00:16:11,010
.اسمه هو غول د. إيس

150
00:17:25,760 --> 00:17:26,890
!العجوز

151
00:17:28,270 --> 00:17:31,580
ما الّذي تفعله هنا؟ أتعارض الاستراتيجيّة؟

152
00:17:31,990 --> 00:17:34,380
.لا، إنّهم قراصنة

153
00:17:34,820 --> 00:17:36,710
!لا شفقة عندي لأمثالهم

154
00:17:37,030 --> 00:17:37,850
...وإذًا

155
00:17:37,850 --> 00:17:38,750
!اخرس

156
00:17:41,490 --> 00:17:42,760
.ليس بالأمر المهمّ

157
00:17:45,200 --> 00:17:46,840
.أريد التّواجد هنا فحسب

158
00:17:54,030 --> 00:17:55,140
!أيّها الغبيّ

159
00:17:56,860 --> 00:17:57,860
!إيس

160
00:17:57,860 --> 00:17:58,990
!ما خطبك أيّها العجوز؟

161
00:17:59,200 --> 00:18:02,490
!أريد الإبحار؟" لن أسمح لك مهما كلّف الأمر"

162
00:18:03,590 --> 00:18:06,430
.لا تتسلّط عليّ، فلست أبي حتّى

163
00:18:06,770 --> 00:18:09,040
.لست مجبرًا على الإصغاء لك أيّها العجوز

164
00:18:09,250 --> 00:18:10,750
!نادني بجدّي

165
00:18:11,510 --> 00:18:12,420
.عجوز

166
00:18:13,300 --> 00:18:16,230
أتريد أن أذيقك لكمة حبّ أخرى؟

167
00:18:17,580 --> 00:18:18,500
!جدّي

168
00:18:18,960 --> 00:18:20,890
...سأصير أقوى بكثير

169
00:18:21,680 --> 00:18:24,220
!وأريد الخروج للإبحار مع إيس

170
00:18:24,880 --> 00:18:25,800
!هذا مؤلم

171
00:18:25,960 --> 00:18:29,280
!غبيّ! لا أريد سماع ذلك منك أيضًا

172
00:18:29,280 --> 00:18:30,680
!لا تضرب لوفي

173
00:18:30,840 --> 00:18:31,940
.عجوز قذر

174
00:18:32,270 --> 00:18:33,110
!قذر؟

175
00:18:33,600 --> 00:18:35,730
!يا إيس! تعال إلى هنا

176
00:18:44,370 --> 00:18:47,700
،اسمعا، استعدادًا لمعركة غير متوقّعة

177
00:18:48,040 --> 00:18:49,750
!عليكما الأكل حتّى الشّبع وقت المستطاع

178
00:18:50,910 --> 00:18:54,950
!هذا مهمّ للغاية لجنديّ بحريّة

179
00:18:54,950 --> 00:18:56,380
!ضعا ذلك حلقة في أذنكما

180
00:18:57,630 --> 00:19:00,040
!البحريّة؟! لا يمكنك تقرير ذلك لنا

181
00:19:00,040 --> 00:19:01,050
!ماذا قلت؟

182
00:19:01,050 --> 00:19:02,090
!سأصبح قرصانًا

183
00:19:02,090 --> 00:19:03,050
!ستنضمّ للبحريّة

184
00:19:03,050 --> 00:19:06,620
!قرصان! قرصان! قرصان! قرصان

185
00:19:03,050 --> 00:19:06,620
!بحريّة! بحريّة! بحريّة! بحريّة

186
00:19:06,620 --> 00:19:08,220
!هذا لذيذ

187
00:19:09,000 --> 00:19:10,660
!كلاّ! أكل كلّ شيء

188
00:19:10,660 --> 00:19:11,980
!كان لذيذًا

189
00:19:14,620 --> 00:19:15,620
!هذا سريع

190
00:19:17,880 --> 00:19:20,280
...سأصبح قرصانًا

191
00:19:22,860 --> 00:19:25,180
،إن صار لوفي جنديّ بحريّة

192
00:19:25,460 --> 00:19:28,240
.فسيختفي مخزون طعام سفينته في ظرف يوم واحد

193
00:19:29,410 --> 00:19:32,860
!سيكون صعب المراس أكثر من القراصنة

194
00:19:40,940 --> 00:19:43,400
...لا شفقة لديّ للأشرار

195
00:19:47,850 --> 00:19:49,490
.أمّا العائلة، فتلك قصّة أخرى

196
00:20:07,040 --> 00:20:10,270
!ما الّذي يفترض بي فعله؟

197
00:20:14,790 --> 00:20:16,430
!أيّها الوغد إيس

198
00:20:16,980 --> 00:20:19,900
!لماذا لم تعش حياتك كما أخبرتك؟

199
00:20:33,300 --> 00:20:34,060
.إيس

200
00:20:35,900 --> 00:20:39,600
.عليكما أن تصيرا جنديّين في البحريّة

201
00:20:41,630 --> 00:20:42,680
موافق؟

202
00:20:44,280 --> 00:20:46,670
.اغدُ جنديّ بحريّة قويّ

203
00:20:54,160 --> 00:20:55,370
...أيّها العجوز

204
00:21:04,510 --> 00:21:06,740
،إن كانت تساورك شكوك في آخر لحظة

205
00:21:07,070 --> 00:21:09,890
.فلن أشفق حتّى عليك يا غارب

206
00:21:11,520 --> 00:21:13,640
!لكن ساورتني شكوك، لكن قد فعلتُ شيئًا ما سلفًا

207
00:21:15,330 --> 00:21:18,440
أسمعت ذلك للتّوّ يا هيلميبو-سان؟
...إنّ استراتيجيّتهم

208
00:21:18,440 --> 00:21:19,260
...نعم

209
00:21:19,620 --> 00:21:23,390
لن يعيروا موعد الإعدام أيّ اهتمام
.وسيعدمون قبضة النّار إيس

210
00:21:23,390 --> 00:21:24,970
...إن فعلوا ذلك

211
00:21:26,410 --> 00:21:27,400
ما هذا؟

212
00:21:32,800 --> 00:21:33,790
أهذا...؟

213
00:21:33,790 --> 00:21:34,910
.ثمّة شيء يسقط من السّماء

214
00:21:36,450 --> 00:21:38,710
!أهذا هجوم مفاجئ من قراصنة اللّحية البيضاء؟

215
00:22:01,220 --> 00:22:03,960
!قلتُ أنّك كنت تقوم بالأمر أكثر من اللاّزم

216
00:22:03,960 --> 00:22:05,570
!هذا بسبب غمزته

217
00:22:05,570 --> 00:22:07,940
!أتلقي اللّوم عليّ يا كروكو؟

218
00:22:07,940 --> 00:22:09,820
!ذلك لا يهمّ، سوف نموت

219
00:22:09,820 --> 00:22:12,100
!كلّ شيء مجمّد في الأسفل

220
00:22:14,000 --> 00:22:15,190
!مرحى

221
00:22:21,740 --> 00:22:24,340
!صحيح! أنا مطّاطيّ، لذلك سأكون بخير

222
00:22:24,620 --> 00:22:26,530
!تهتمّ لنفسك فحسب؟

223
00:22:26,530 --> 00:22:28,250
!افعل شيئًا ما؟

224
00:22:28,460 --> 00:22:30,830
!لا أريد الموت هكذا

225
00:22:30,830 --> 00:22:32,510
!ليوقفني أحد ما

226
00:22:32,690 --> 00:22:36,600
!ما كان عليّ الإصغاء لك يا قبّعة القشّ

227
00:22:36,600 --> 00:22:37,680
!سُحقًا

228
00:22:52,590 --> 00:22:57,030
!إيس

229
00:23:11,480 --> 00:23:13,970
ظهر لوفي ورفاقه في السّماء فجأة

230
00:23:13,970 --> 00:23:16,100
.وسقطوا إلى منتصف ساحة المعركة

231
00:23:16,700 --> 00:23:19,480
،رأى لوفي أخاه إيس أخيرًا

232
00:23:19,480 --> 00:23:21,300
.وها هو يناديه بأعلى صوته

233
00:23:21,750 --> 00:23:25,750
!بدأت المعركة الأخير لإنقاذ إيس الآن

234
00:23:25,980 --> 00:23:27,440
:في الحلقة القادمة من وان بيس

235
00:23:27,440 --> 00:23:30,950
!وصول فريق قبّعة القشّ"
"!يتصاعد التّوتّر على ساحة المعركة

236
00:23:30,950 --> 00:23:32,950
!ملك القراصنة، لن يكون إلاّ أنا

237
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة