1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,790
"وأقول "أريد أن أصير أقوى

5
00:01:01,950 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,370 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,590 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,930 --> 00:03:35,900
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:36,390 --> 00:03:39,360
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:39,360 --> 00:03:41,020
!الّذي اقترب موعد إعدامه

40
00:03:41,890 --> 00:03:45,450
أثناء ذلك، يغير قراصنة اللّحية
...البيضاء على مارينفورد

41
00:03:45,830 --> 00:03:48,660
!وتنشب بينهم وبين البحريّة حرب شاملة

42
00:03:51,710 --> 00:03:53,700
!أورز

43
00:04:01,040 --> 00:04:05,800
!القليل فحسب وأصل لإيس-كُن

44
00:04:10,230 --> 00:04:11,730
!رجل الظّلّ

45
00:04:14,150 --> 00:04:15,490
!سيف سحليّة الظّلال

46
00:04:21,880 --> 00:04:26,310
"!العدالة لمن ينتصر! بدء العمل باستراتيجيّة سنغوكو"

47
00:04:53,880 --> 00:04:57,270
!أرأيت؟ هكذا يُقتل شخص ما

48
00:04:57,590 --> 00:04:59,190
!أيّها القبطان أورز

49
00:04:59,430 --> 00:05:02,420
!سحقًا لك أيّها الشّيتشيبوكاي

50
00:05:02,420 --> 00:05:03,520
!أيّها القبطان

51
00:05:03,710 --> 00:05:05,200
!أورز

52
00:05:13,530 --> 00:05:14,960
...إيس-كُن

53
00:05:21,450 --> 00:05:22,640
!أورز

54
00:05:44,870 --> 00:05:47,410
...إيس... كُن

55
00:06:04,080 --> 00:06:05,420
...إيس

56
00:06:08,170 --> 00:06:09,760
...كُن

57
00:06:53,880 --> 00:07:00,400
!أورز

58
00:07:18,110 --> 00:07:23,180
!سأصنع من جثّته أقوى جنديّ زومبي

59
00:07:32,750 --> 00:07:34,750
...أورز

60
00:07:36,700 --> 00:07:38,190
!أرخيت دفاعك أيّها اللّحية البيضاء

61
00:08:00,530 --> 00:08:02,330
!يا نائب الأميرال لونز

62
00:08:14,530 --> 00:08:19,820
!هـ-هزم نائب أميرال عملاق في البحريّة بسهولة

63
00:08:30,860 --> 00:08:32,900
...أورز

64
00:08:40,660 --> 00:08:44,290
!تسلّقوا جسد أورز وتقدّموا

65
00:09:12,960 --> 00:09:14,460
!هذا ممتاز

66
00:09:15,470 --> 00:09:18,700
!دوفلامينغو! كيف أمكنك فعل ذلك لأورز؟

67
00:09:18,700 --> 00:09:20,710
!سأجعلك تدفع الثّمن مهما كان

68
00:09:22,130 --> 00:09:23,330
ما المضحك؟

69
00:09:23,530 --> 00:09:25,360
أقلت ما المضحك؟

70
00:09:25,360 --> 00:09:27,920
إنّه شعور تواجدي في مركز التّاريخ
!الّذي يراودني الآن

71
00:09:30,620 --> 00:09:33,010
!صار هذا المكان نقطة تحوّل

72
00:09:33,210 --> 00:09:34,670
!عمّ تتحدّث؟

73
00:09:36,890 --> 00:09:38,350
!هذا هو قائدنا

74
00:09:38,350 --> 00:09:40,400
!لا يسع دوفلامينغو إلاّ الهرب الآن

75
00:10:01,450 --> 00:10:04,160
!أ-أيّها اللّواء البحريّ يوكيمورا

76
00:10:41,590 --> 00:10:44,180
!لا أستطيع! لا أستطيع! لا أستطيع

77
00:10:44,180 --> 00:10:46,290
!أنا خائف ولا يسعني فعل أيّ شيء

78
00:10:46,370 --> 00:10:50,010
حتّى أولئك المقاتلين الأقوياء
!يسقطون الواحد تلو الآخر

79
00:10:50,330 --> 00:10:53,710
!لا يمكنني تحمّل هذا! يا لي من فاشل

80
00:10:54,280 --> 00:10:56,620
!انتظر يا كوبي! أنا قادم معك

81
00:10:57,170 --> 00:10:59,140
!عد إلى ساحة المعركة

82
00:11:01,410 --> 00:11:03,850
!دعني أذهب رجاءً

83
00:11:06,490 --> 00:11:08,730
الأميرال أكاينو! لماذا هو هنا؟

84
00:11:08,940 --> 00:11:10,540
أنا خائف من الموت

85
00:11:10,950 --> 00:11:13,190
!وعندما أفكّر في عائلتي، أشعر بالضّعف

86
00:11:13,420 --> 00:11:15,400
!أرجوك! أنا أتوسّل إليك

87
00:11:18,330 --> 00:11:20,580
...نحن جنود البحريّة

88
00:11:21,220 --> 00:11:26,870
نقاتل القراصنة و"عدالة" العالم
!منقوشة على ظهورنا

89
00:11:27,630 --> 00:11:33,920
وكلّ من يهرب وهو يجرّ أذيال الخيبة
.لا يمكن أن يوصف بجنديّ البحريّة

90
00:11:34,570 --> 00:11:36,270
...وكنتُ لأنعته

91
00:11:36,900 --> 00:11:38,000
!بذرّة غبار

92
00:11:42,340 --> 00:11:46,980
،إن كنت تفكّر فعلاً في عائلتك
!فلا تعش في خزي

93
00:11:52,690 --> 00:11:55,680
!مستحيل! لا يمكنه قتل رجل من صفوفنا

94
00:11:57,540 --> 00:11:58,840
!أيّها الأميرال ساكازوكي

95
00:11:59,470 --> 00:12:01,530
.نحن جاهزون للبدء بالاستراتيجيّة

96
00:12:01,530 --> 00:12:04,150
!جيّد! حان الوقت

97
00:12:10,920 --> 00:12:12,420
الاستراتيجيّة"؟"

98
00:12:12,840 --> 00:12:15,800
!إيس

99
00:12:36,800 --> 00:12:38,910
!استعملوا المساحة الّتي فتحها أورز

100
00:12:40,200 --> 00:12:41,720
!ادخلوا الخليج

101
00:12:47,870 --> 00:12:51,910
!لندمّر رأس الخليج ونفتح مساحة أكبر

102
00:12:51,910 --> 00:12:53,750
!أطلقوا للأمام مباشرة

103
00:13:05,640 --> 00:13:07,930
!سُحقًا! لم يُخدش حتّى

104
00:13:08,330 --> 00:13:09,690
!دعوا الأمر لي

105
00:13:17,270 --> 00:13:18,770
!كاسحة جليد؟

106
00:13:19,590 --> 00:13:21,570
!إنّها ساحرة الجليد وايتي بي

107
00:13:21,910 --> 00:13:24,310
.كان ذلك سهلاً علينا

108
00:13:24,830 --> 00:13:27,370
!هيّا يا رفاق! لننطلق

109
00:13:27,520 --> 00:13:28,870
!شكرًا لكم

110
00:13:29,120 --> 00:13:31,370
!علينا التّحرّك نحو الخليج أيضًا

111
00:13:38,080 --> 00:13:42,920
ما الخطب يا قائد الوحدة الثّالثة عشر
ثور الماء أتموس؟

112
00:13:43,130 --> 00:13:46,350
!جـ-جسدي... ماذا فعلت يا دوفلامينغو؟

113
00:13:46,480 --> 00:13:47,590
!أيّها القائد أتموس

114
00:13:47,840 --> 00:13:50,220
!إيّاكم! لا تقتربوا منّي

115
00:13:50,810 --> 00:13:51,560
!ما الخطب؟

116
00:13:51,560 --> 00:13:51,940
!بسرعة

117
00:13:53,050 --> 00:13:54,310
!أيّها القائد

118
00:13:54,310 --> 00:13:55,190
!كلاّ

119
00:13:58,610 --> 00:14:01,360
أيّها القائد أتموس... لماذا؟

120
00:14:02,750 --> 00:14:04,960
!لا يمكنني التّحكّم بجسدي

121
00:14:04,960 --> 00:14:06,780
!توقّف يا دوفلامينغو

122
00:14:08,280 --> 00:14:10,570
!أيّها القائد

123
00:14:21,660 --> 00:14:24,310
"يمثّل القراصنة الشّرّ وتمثّل البحريّة العدالة؟"

124
00:14:24,570 --> 00:14:26,760
!كُتب ذلك وأعيد كتابته مرّات عدّة عبر التّاريخ

125
00:14:27,900 --> 00:14:29,890
القيم تختلف في نظر أطفال لم يعرفوا السّلام قطّ

126
00:14:30,180 --> 00:14:33,470
.والأطفال الّذين يجهلون كلّ الجهل عن الحرب

127
00:14:34,100 --> 00:14:38,000
إنّ من ينتهي به المطاف في القمّة
.هو من يعيد كتابة ما الخطأ وما الصّواب

128
00:14:38,610 --> 00:14:41,890
!وهذا المكان هو نقطة التّحوّل

129
00:14:44,860 --> 00:14:46,660
"ستسود العدالة؟"

130
00:14:47,300 --> 00:14:49,280
!بالطّبع ستسود

131
00:14:52,680 --> 00:14:55,580
!لأنّ المنتصر هو من يقرّر العدالة

132
00:15:14,390 --> 00:15:16,760
!لقد تجاوزوا رأس الخليج في نقطتين

133
00:15:17,340 --> 00:15:24,210
!سيمتلئ الخليج بحلفاء اللّحية البيضاء

134
00:15:24,740 --> 00:15:26,120
!يا أميرال الأسطول سنغوكو

135
00:15:26,520 --> 00:15:27,850
.لا مشكلة

136
00:15:30,650 --> 00:15:33,370
.تسورو-سان، لنبدأ العمل

137
00:15:33,520 --> 00:15:34,980
.إنّه وقت مناسب

138
00:15:34,980 --> 00:15:35,970
!ابتعدي

139
00:15:35,970 --> 00:15:38,200
!ستنالين ما هو أسوأ من الإصابات إن لم تبتعدي

140
00:15:38,370 --> 00:15:39,500
!ابتعدي أيّتها العجوز

141
00:15:41,710 --> 00:15:42,620
!لقد غُسلت

142
00:15:42,880 --> 00:15:44,090
!لقد عُلّقت

143
00:15:44,290 --> 00:15:46,320
!لكنّه شعور رائع

144
00:15:46,320 --> 00:15:49,250
.تحتاجان لمليون سنة قبل أن تستطيعا هزيمتي

145
00:15:50,350 --> 00:15:52,520
!أوصلوني لكلّ السّفن والجنود

146
00:15:52,660 --> 00:16:04,670
...رنين، رنين، رنين

147
00:16:07,100 --> 00:16:09,730
.إنّه يخطّط لأمر ما

148
00:16:10,320 --> 00:16:13,440
.يا لك من أميرال واسع الحيلة أيّها "البوذا" سنغوكو

149
00:16:21,870 --> 00:16:25,010
.اسمه هو غول د. إيس

150
00:17:39,760 --> 00:17:40,890
!العجوز

151
00:17:42,270 --> 00:17:45,580
ما الّذي تفعله هنا؟ أتعارض الاستراتيجيّة؟

152
00:17:45,990 --> 00:17:48,380
.لا، إنّهم قراصنة

153
00:17:48,820 --> 00:17:50,710
!لا شفقة عندي لأمثالهم

154
00:17:51,030 --> 00:17:51,850
...وإذًا

155
00:17:51,850 --> 00:17:52,750
!اخرس

156
00:17:55,490 --> 00:17:56,760
.ليس بالأمر المهمّ

157
00:17:59,200 --> 00:18:00,840
.أريد التّواجد هنا فحسب

158
00:18:08,030 --> 00:18:09,140
!أيّها الغبيّ

159
00:18:10,860 --> 00:18:11,860
!إيس

160
00:18:11,860 --> 00:18:12,990
!ما خطبك أيّها العجوز؟

161
00:18:13,200 --> 00:18:16,490
!أريد الإبحار؟" لن أسمح لك مهما كلّف الأمر"

162
00:18:17,590 --> 00:18:20,430
.لا تتسلّط عليّ، فلست أبي حتّى

163
00:18:20,770 --> 00:18:23,040
.لست مجبرًا على الإصغاء لك أيّها العجوز

164
00:18:23,250 --> 00:18:24,750
!نادني بجدّي

165
00:18:25,510 --> 00:18:26,420
.عجوز

166
00:18:27,300 --> 00:18:30,230
أتريد أن أذيقك لكمة حبّ أخرى؟

167
00:18:31,580 --> 00:18:32,500
!جدّي

168
00:18:32,960 --> 00:18:34,890
...سأصير أقوى بكثير

169
00:18:35,680 --> 00:18:38,220
!وأريد الخروج للإبحار مع إيس

170
00:18:38,880 --> 00:18:39,800
!هذا مؤلم

171
00:18:39,960 --> 00:18:43,280
!غبيّ! لا أريد سماع ذلك منك أيضًا

172
00:18:43,280 --> 00:18:44,680
!لا تضرب لوفي

173
00:18:44,840 --> 00:18:45,940
.عجوز قذر

174
00:18:46,270 --> 00:18:47,110
!قذر؟

175
00:18:47,600 --> 00:18:49,730
!يا إيس! تعال إلى هنا

176
00:18:58,370 --> 00:19:01,700
،اسمعا، استعدادًا لمعركة غير متوقّعة

177
00:19:02,040 --> 00:19:03,750
!عليكما الأكل حتّى الشّبع وقت المستطاع

178
00:19:04,910 --> 00:19:08,950
!هذا مهمّ للغاية لجنديّ بحريّة

179
00:19:08,950 --> 00:19:10,380
!ضعا ذلك حلقة في أذنكما

180
00:19:11,630 --> 00:19:14,040
!البحريّة؟! لا يمكنك تقرير ذلك لنا

181
00:19:14,040 --> 00:19:15,050
!ماذا قلت؟

182
00:19:15,050 --> 00:19:16,090
!سأصبح قرصانًا

183
00:19:16,090 --> 00:19:17,050
!ستنضمّ للبحريّة

184
00:19:17,050 --> 00:19:20,620
!قرصان! قرصان! قرصان! قرصان

185
00:19:17,050 --> 00:19:20,620
!بحريّة! بحريّة! بحريّة! بحريّة

186
00:19:20,620 --> 00:19:22,220
!هذا لذيذ

187
00:19:23,000 --> 00:19:24,660
!كلاّ! أكل كلّ شيء

188
00:19:24,660 --> 00:19:25,980
!كان لذيذًا

189
00:19:28,620 --> 00:19:29,620
!هذا سريع

190
00:19:31,880 --> 00:19:34,280
...سأصبح قرصانًا

191
00:19:36,860 --> 00:19:39,180
،إن صار لوفي جنديّ بحريّة

192
00:19:39,460 --> 00:19:42,240
.فسيختفي مخزون طعام سفينته في ظرف يوم واحد

193
00:19:43,410 --> 00:19:46,860
!سيكون صعب المراس أكثر من القراصنة

194
00:19:54,940 --> 00:19:57,400
...لا شفقة لديّ للأشرار

195
00:20:01,850 --> 00:20:03,490
.أمّا العائلة، فتلك قصّة أخرى

196
00:20:21,040 --> 00:20:24,270
!ما الّذي يفترض بي فعله؟

197
00:20:28,790 --> 00:20:30,430
!أيّها الوغد إيس

198
00:20:30,980 --> 00:20:33,900
!لماذا لم تعش حياتك كما أخبرتك؟

199
00:20:47,300 --> 00:20:48,060
.إيس

200
00:20:49,900 --> 00:20:53,600
.عليكما أن تصيرا جنديّين في البحريّة

201
00:20:55,630 --> 00:20:56,680
موافق؟

202
00:20:58,280 --> 00:21:00,670
.اغدُ جنديّ بحريّة قويّ

203
00:21:08,160 --> 00:21:09,370
...أيّها العجوز

204
00:21:18,510 --> 00:21:20,740
،إن كانت تساورك شكوك في آخر لحظة

205
00:21:21,070 --> 00:21:23,890
.فلن أشفق حتّى عليك يا غارب

206
00:21:25,520 --> 00:21:27,640
!لكن ساورتني شكوك، لكن قد فعلتُ شيئًا ما سلفًا

207
00:21:29,330 --> 00:21:32,440
أسمعت ذلك للتّوّ يا هيلميبو-سان؟
...إنّ استراتيجيّتهم

208
00:21:32,440 --> 00:21:33,260
...نعم

209
00:21:33,620 --> 00:21:37,390
لن يعيروا موعد الإعدام أيّ اهتمام
.وسيعدمون قبضة النّار إيس

210
00:21:37,390 --> 00:21:38,970
...إن فعلوا ذلك

211
00:21:40,410 --> 00:21:41,400
ما هذا؟

212
00:21:46,800 --> 00:21:47,790
أهذا...؟

213
00:21:47,790 --> 00:21:48,910
.ثمّة شيء يسقط من السّماء

214
00:21:50,450 --> 00:21:52,710
!أهذا هجوم مفاجئ من قراصنة اللّحية البيضاء؟

215
00:22:15,220 --> 00:22:17,960
!قلتُ أنّك كنت تقوم بالأمر أكثر من اللاّزم

216
00:22:17,960 --> 00:22:19,570
!هذا بسبب غمزته

217
00:22:19,570 --> 00:22:21,940
!أتلقي اللّوم عليّ يا كروكو؟

218
00:22:21,940 --> 00:22:23,820
!ذلك لا يهمّ، سوف نموت

219
00:22:23,820 --> 00:22:26,100
!كلّ شيء مجمّد في الأسفل

220
00:22:28,000 --> 00:22:29,190
!مرحى

221
00:22:35,740 --> 00:22:38,340
!صحيح! أنا مطّاطيّ، لذلك سأكون بخير

222
00:22:38,620 --> 00:22:40,530
!تهتمّ لنفسك فحسب؟

223
00:22:40,530 --> 00:22:42,250
!افعل شيئًا ما؟

224
00:22:42,460 --> 00:22:44,830
!لا أريد الموت هكذا

225
00:22:44,830 --> 00:22:46,510
!ليوقفني أحد ما

226
00:22:46,690 --> 00:22:50,600
!ما كان عليّ الإصغاء لك يا قبّعة القشّ

227
00:22:50,600 --> 00:22:51,680
!سُحقًا

228
00:23:06,590 --> 00:23:11,030
!إيس

229
00:23:25,480 --> 00:23:27,970
ظهر لوفي ورفاقه في السّماء فجأة

230
00:23:27,970 --> 00:23:30,100
.وسقطوا إلى منتصف ساحة المعركة

231
00:23:30,700 --> 00:23:33,480
،رأى لوفي أخاه إيس أخيرًا

232
00:23:33,480 --> 00:23:35,300
.وها هو يناديه بأعلى صوته

233
00:23:35,750 --> 00:23:39,750
!بدأت المعركة الأخير لإنقاذ إيس الآن

234
00:23:39,980 --> 00:23:41,440
:في الحلقة القادمة من وان بيس

235
00:23:41,440 --> 00:23:44,950
!وصول فريق قبّعة القشّ"
"!يتصاعد التّوتّر على ساحة المعركة

236
00:23:44,950 --> 00:23:46,950
!ملك القراصنة، لن يكون إلاّ أنا

237
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة