1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,110 --> 00:02:02,890
!سآتي لإنقاذك

29
00:02:05,670 --> 00:02:07,030
!لأنّك صديقي

30
00:02:09,260 --> 00:02:13,160
بعد أن خطف جاسوس العدوّ كانجورو مومونوسكي

31
00:02:13,160 --> 00:02:20,400
تحت أنظار لوفي والبقيّة الّذين كانوا يواجهون
!أزمة أخرى، ظهر رجل لطالما انتظروه

32
00:02:21,210 --> 00:02:23,210
!أعيروني مسامعكم

33
00:02:25,050 --> 00:02:28,340
...وُلدتُ في بلاد في قاع البحر

34
00:02:28,340 --> 00:02:33,060
.في حيّ البرمائيّين من مملكة تُدعى ريوغو في أعماق البحر

35
00:02:35,830 --> 00:02:42,070
تسبّبت بالكثير من المتاعب لزملائي
،الأكبر حول العالم

36
00:02:42,070 --> 00:02:48,410
وها أنا الآن، سأتشارك كأس ساكي
...مع زعيمي قبّعة القشّ-سان

37
00:02:48,760 --> 00:02:52,390
!بصفتي العضو الجديد

38
00:02:54,750 --> 00:02:56,460
...يمكنكم مناداتي

39
00:02:56,460 --> 00:02:59,430
!فارس البحر" جينبي"

40
00:03:00,730 --> 00:03:04,380
،تذكّروا وجهي رجاءً

41
00:03:04,380 --> 00:03:08,490
!وأطلب منكم دعمكم المتواصل

42
00:03:12,820 --> 00:03:16,730
"!عضو جديد! فارس البحر جينبي"

43
00:03:40,630 --> 00:03:43,150
!وصلتَ أخيرًا يا جينبي

44
00:03:52,360 --> 00:03:55,470
!جينبي

45
00:03:58,100 --> 00:04:02,190
.أيّها الرّفاق! أنا عضو طاقم على ساني ابتداءً من اليوم

46
00:04:05,880 --> 00:04:07,780
!كنتُ قلقةً عليك

47
00:04:08,460 --> 00:04:10,530
!اشتقت لك

48
00:04:10,530 --> 00:04:12,780
!يا زعيم

49
00:04:14,430 --> 00:04:18,160
!أنا سعيد لرؤيتكم جميعًا ثانيةً

50
00:04:20,080 --> 00:04:23,630
!الشيتشيبوكاي السّابق جينبي عضو في طاقمنا الآن

51
00:04:23,630 --> 00:04:25,420
!كم هذا مطمئن

52
00:04:26,940 --> 00:04:28,800
!أنا سعيد لأنّك حيّ

53
00:04:32,900 --> 00:04:36,560
...نامي-سان، لستِ بحاجة لمعانقته بشدّة هكذا

54
00:04:43,400 --> 00:04:46,820
!جعلتنا نقلق عليك بشدّة

55
00:04:46,820 --> 00:04:49,190
!آسف، آسف

56
00:04:49,380 --> 00:04:53,500
وجب عليّ الاعتناء ببعض الأعضاء
،المصابين من قراصنة الشّمس

57
00:04:53,500 --> 00:04:58,830
،كانت حفلة وداعي لا تُفوّت
.لذلك لم أتمكّن من المغادرة

58
00:04:58,830 --> 00:05:01,360
.أنا آسف

59
00:05:02,170 --> 00:05:05,060
!لكن من الجيّد رؤيتكم ثانية

60
00:05:05,060 --> 00:05:07,300
!ظننت أنّني لن أراك مجدّدًا

61
00:05:10,480 --> 00:05:12,830
...دعني أكون

62
00:05:13,480 --> 00:05:16,050
!آخر الوافدين

63
00:05:19,530 --> 00:05:23,250
!سأنجح في مسعاي وأعود حيًّا

64
00:05:24,000 --> 00:05:26,150
!لا تنسَ يا جينبي

65
00:05:27,750 --> 00:05:31,660
!أنا قبطانك الآن

66
00:05:31,660 --> 00:05:35,490
!سأكون في انتظارك في بلاد وانو
!تعال مهما كلّف الأمر

67
00:05:37,090 --> 00:05:38,950
!شكرًا لك

68
00:05:40,260 --> 00:05:41,330
!جينبي

69
00:05:43,010 --> 00:05:45,750
!إيّاك أن تموت مهما كان

70
00:05:55,280 --> 00:05:57,830
!ترأّف بي

71
00:06:06,620 --> 00:06:10,650
!خذني معك! بإمكاني المساعدة بكلّ تأكيد

72
00:06:13,310 --> 00:06:17,070
!سلّمني ابن دراغون

73
00:06:17,630 --> 00:06:22,700
...لا يمكنني ذلك! لأنّني اتّخذت قراري سلفًا

74
00:06:22,700 --> 00:06:25,960
!بأن أنقذ حياته وإن عنى ذلك مماتي

75
00:06:26,560 --> 00:06:31,460
،أعلم أنّ الأمر مؤلم الآن يا لوفي
!لكن عليك كبت مشاعرك هذه

76
00:06:31,900 --> 00:06:34,760
!لا تفكّر فقط في من خسرت

77
00:06:35,150 --> 00:06:37,430
!بإمكانك استعادة ما فقدته

78
00:06:37,430 --> 00:06:41,260
!فما الّذي ما زلت تمتلكه؟

79
00:06:45,870 --> 00:06:47,770
...ما زلت أمتلك

80
00:06:48,040 --> 00:06:50,360
!ما زلت أمتلك أصدقائي

81
00:06:51,330 --> 00:06:53,630
.يا جينبي

82
00:07:04,760 --> 00:07:06,400
...انضمّ

83
00:07:06,890 --> 00:07:08,670
!لطاقمي

84
00:07:09,640 --> 00:07:15,260
!سأترك الآن قراصنة بيغ مام

85
00:07:16,070 --> 00:07:19,740
!شكرًا على كلّ متاعبك

86
00:07:20,490 --> 00:07:24,830
...جينبي، إن لم أهرب من الموت

87
00:07:25,280 --> 00:07:29,730
آسف، لكن هلاّ اعتنيت بأخي؟

88
00:07:32,920 --> 00:07:35,490
،آسف على مناقضتك يا إيس-سان

89
00:07:35,490 --> 00:07:40,530
.لكن لا يمكنك المبالغة في تقديري
.لست ذو طبيعة طيّبة كما تظنّ

90
00:07:40,530 --> 00:07:44,990
.حتّى إن كان أخاك، فنحن في عالم قراصنة

91
00:07:44,990 --> 00:07:50,230
لا أساعد ولا أحمي
!إلاّ من أكنّ لهم احترامًا كبيرًا

92
00:07:55,420 --> 00:07:57,670
!أتطلّع لدعمك المتواصل

93
00:07:57,670 --> 00:07:58,880
!نعم

94
00:08:03,110 --> 00:08:05,220
،أيّها الرّفاق، سأكرّر كلامي

95
00:08:05,950 --> 00:08:10,190
!أتطلّع قُدمًا للإبحار معكم

96
00:08:12,650 --> 00:08:17,570
!مهارات جينبي في قيادة السّفن مذهلة

97
00:08:17,570 --> 00:08:20,200
!لقد ركب موجة باستعمال ساني

98
00:08:27,450 --> 00:08:29,150
...هكذا إذًا

99
00:08:29,560 --> 00:08:36,110
ظهر أخيرًا شخص قادر على إظهار
...إمكانات سفينة الأحلام

100
00:08:38,860 --> 00:08:41,760
...في كلّ مرّة أمسك مقبض الدّفّة

101
00:08:42,110 --> 00:08:44,890
!أقول لنفسي إنّها سفينة رائعة

102
00:08:44,890 --> 00:08:46,830
.شكرًا

103
00:08:47,780 --> 00:08:48,770
.حسنًا

104
00:08:50,690 --> 00:08:53,500
!ممتاز

105
00:08:53,960 --> 00:08:56,690
،احتفالاً بصعود جينبي على متن سفينتنا

106
00:08:59,290 --> 00:09:00,420
!أجل

107
00:09:00,420 --> 00:09:04,550
مهلاً، مهلاً! ليس لدينا أيّ ساكي
!على السّفينة الآن

108
00:09:04,550 --> 00:09:05,910
...لا

109
00:09:07,300 --> 00:09:09,500
...أشمّ رائحة ساكي

110
00:09:09,500 --> 00:09:10,750
!من أين؟

111
00:09:13,810 --> 00:09:15,570
!من تلك الجهة

112
00:09:20,690 --> 00:09:23,660
...أونيغاشيما في ذلك الاتّجاه

113
00:09:24,150 --> 00:09:26,950
...ثمّة شيء ما أمامها

114
00:09:28,660 --> 00:09:30,600
ما هذا؟

115
00:09:30,600 --> 00:09:34,940
!يا لوفي-دونو

116
00:09:35,500 --> 00:09:40,820
!أريد مناقشة ما سنفعله بعد بلوغنا لأونيغاشيما

117
00:09:40,820 --> 00:09:45,870
!تعال إلى هنا في الحال يا لوفي-دونو

118
00:09:46,260 --> 00:09:49,590
!أيّها الكاذب! لا أشمّ سوى مياه البحر

119
00:09:49,590 --> 00:09:51,040
!لستُ أكذب

120
00:09:53,350 --> 00:09:55,840
!أشمّ رائحة طعام أيضًا

121
00:09:55,840 --> 00:09:58,310
!لوفي-دونو

122
00:09:58,310 --> 00:10:03,130
.توقّف يا كين. لا فائدة من منحهم خطّة

123
00:10:05,530 --> 00:10:10,540
كما أنّ هذه سفينتي. إن كنتم ستعقدون اجتماعًا
.لوضع خطّة، فاعقدوه على سفينة أخرى

124
00:10:20,460 --> 00:10:25,240
!أحتاج للاستماع لخطّتكم

125
00:10:31,340 --> 00:10:33,450
!شيشيليان-دونو بالغ القوّة

126
00:10:33,450 --> 00:10:38,460
سيقاتل الدّوق إينواراشي-ساما كتابع
!لكوزكي أودن في هذه المعركة

127
00:10:38,460 --> 00:10:41,810
!لذلك سأقود أنا المينك

128
00:10:41,810 --> 00:10:44,050
!نعم، شكرًا لك

129
00:10:44,050 --> 00:10:45,760
...اسمحوا لي

130
00:10:46,980 --> 00:10:52,310
!أن أقود كلّ السّاموراي من بلاد وانو

131
00:10:57,830 --> 00:10:59,900
!الزّعيم هيوغورو

132
00:10:59,900 --> 00:11:04,110
.آسف لتصرّفي كغريب طوال 20 سنة

133
00:11:04,110 --> 00:11:05,700
.أنا سعيد لرؤيتك في أفضل حال

134
00:11:06,210 --> 00:11:10,660
...كينييمون... كلاّ، بل جميع الأكازايا

135
00:11:11,340 --> 00:11:17,040
أنا سعيد بعودتكم إلى بلاد وانو بعد
.انتقالكم عبر الزّمن 20 سنة للمستقبل

136
00:11:17,040 --> 00:11:23,000
وفوق ذلك، أحضرتم فتى قبّعة القشّ
.الّذي أدهشتني قوّته الفائقة

137
00:11:23,000 --> 00:11:29,400
فعلنا كلّ ذلك للإطاحة بكايدو
.وأوروتشي وفتح حدود بلاد وانو

138
00:11:29,400 --> 00:11:30,800
!أكيد

139
00:11:31,150 --> 00:11:36,930
حسنًا. هلاّ ناقشنا بسرعة ما سنفعله
بعد بلوغنا أونيغاشيما؟

140
00:11:36,930 --> 00:11:39,960
.حسنًا. تعال معنا

141
00:11:41,790 --> 00:11:47,400
نعم، نعم، اجلسوا على شكل دائرة حيث
.بإمكانكم رؤية الخريطة، نعم على شكل دائرة

142
00:11:47,400 --> 00:11:49,160
هل أنت بخير؟

143
00:11:49,160 --> 00:11:51,410
نعم! أيمكنك رؤيتها؟

144
00:11:51,410 --> 00:11:53,370
!أنت اجلس هنا

145
00:11:53,370 --> 00:11:56,730
.نعم، يبدو أنّ الجميع هنا

146
00:11:57,160 --> 00:11:59,790
!حسنًا، لنبدأ

147
00:12:00,390 --> 00:12:02,500
...أوّلاً وقبل كلّ شيء

148
00:12:02,500 --> 00:12:07,630
.أخبرته أنّ هذه السّفينة ليست مقرّ تخييم

149
00:12:25,520 --> 00:12:26,480
!حسنًا

150
00:12:26,830 --> 00:12:31,490
!سأشرح خطّة الإغارة على أونيغاشيما

151
00:12:31,880 --> 00:12:35,330
...كما بادٍ على الخريطة، أونيغاشيما جزيرة

152
00:12:35,330 --> 00:12:38,970
.تملك سلاسل جبال تحيط بها

153
00:12:38,970 --> 00:12:43,830
،حتّى إن حاولتم الاقتراب بالسّفن
،ستعترض المنحدرات العالية الطّريق

154
00:12:43,830 --> 00:12:45,340
!لذا فالأمر مستحيل

155
00:12:45,340 --> 00:12:49,220
!ثمّة طريقة واحدة فقط لدخول الجزيرة

156
00:12:49,220 --> 00:12:51,780
!وذلك بالعبور من البوّابة الأماميّة

157
00:12:52,030 --> 00:12:57,140
،جمجمة الجزيرة جزء من جبل
.كما يوجد بداخلها قلعة

158
00:12:57,140 --> 00:13:00,020
،لكن بعدما حصلنا على تصاميم القلعة

159
00:13:00,020 --> 00:13:04,400
وجدنا أنّ هنالك مدخلاً خلفيًّا
!على الجانب الآخر من الجزيرة

160
00:13:04,400 --> 00:13:09,150
لذلك سنتفادى البوّابة الأماميّة
،الّتي ستكون شديدة الحراسة

161
00:13:09,150 --> 00:13:13,070
وسننقسم لمجموعتين، ونأخذ طريقَيْ
،الجبل شِمالاً ويمينًا

162
00:13:13,070 --> 00:13:16,200
.وسنتسلّل إلى القلعة من المدخل الخلفيّ

163
00:13:16,200 --> 00:13:20,750
سنشنّ هجومًا مباغتًا على كايدو
،الّذي سيكون ثملاً بعد الوليمة

164
00:13:20,750 --> 00:13:24,230
!وسننهي الأمر بسرعة

165
00:13:30,310 --> 00:13:31,590
...هذا مدهش

166
00:13:32,360 --> 00:13:34,740
...هذا متوقّع من كين-سان

167
00:13:34,740 --> 00:13:37,240
إنّها فكرة جيّدة، صحيح؟

168
00:13:37,240 --> 00:13:40,200
حسنًا، ما هي خطّتك الحقيقيّة؟

169
00:13:40,200 --> 00:13:41,030
!ماذا؟

170
00:13:41,030 --> 00:13:45,190
...أعلم أنّ تلك الخطّة غير المدروسة

171
00:13:45,190 --> 00:13:51,030
...هي ما فكّرت فيه بخداع كانجورو

172
00:13:51,030 --> 00:13:51,990
ماذا؟

173
00:13:52,270 --> 00:13:54,950
هيّا، أطلعنا على الخطّة الحقيقيّة؟

174
00:13:56,570 --> 00:13:58,260
!ماذا؟

175
00:13:58,260 --> 00:14:00,660
.ها نحن أولاء، المبالغة في التّقدير

176
00:14:00,660 --> 00:14:04,500
...لكنّي أعلم أنّ خطّة كينييمون الحقيقيّة

177
00:14:06,020 --> 00:14:07,750
!غير موجودة

178
00:14:09,420 --> 00:14:12,380
...عفوًا

179
00:14:12,940 --> 00:14:17,140
...خطّتي الحقيقيّة

180
00:14:17,140 --> 00:14:18,100
،أوّلاً

181
00:14:18,800 --> 00:14:21,270
،إن لاحظ العدوّ غارتنا

182
00:14:21,550 --> 00:14:26,480
!فسيصبّون تركيزهم أكثر على ساموراي الأكازايا

183
00:14:27,520 --> 00:14:29,860
،إضافة إليّ أنا

184
00:14:30,460 --> 00:14:33,610
...وقبّعة القشّ-يا ويوستاس-يا

185
00:14:33,610 --> 00:14:35,490
.نحن القباطنة الثّلاثة

186
00:14:35,490 --> 00:14:37,240
!نعم! هذا صحيح

187
00:14:37,240 --> 00:14:40,870
،لا يهمّ ما الخطّة الّتي قد تضعونها

188
00:14:40,870 --> 00:14:45,410
نعلم تمامًا أنّ هنالك غبيّين سيحاولان
!الاندفاع مباشرة للباب الأماميّ

189
00:14:48,810 --> 00:14:51,000
.سيكون هذين الاثنين طُعمًا جيّدًا لصالحنا

190
00:14:51,000 --> 00:14:55,020
.كما أنّهما أقوى من أيّ طعم عاديّ

191
00:14:55,020 --> 00:15:00,720
بهدف إيقاف هذين الغبيّين، سيتمّ إرسال
.الكثير من رجال كايدو للخطوط الأماميّة

192
00:15:00,720 --> 00:15:04,810
،مفهوم! سيتّجه معظم رجال كايدو للأمام

193
00:15:04,810 --> 00:15:08,230
!وستصير الحراسة قليلة على كِلا طريقَيْ الجبل

194
00:15:08,580 --> 00:15:13,430
لذا فكما كان مخطّطًا، سنتقدّم جميعًا
.في طريقَيْ الجبل من كِلا الجانبين

195
00:15:14,040 --> 00:15:14,740
...لكن

196
00:15:15,800 --> 00:15:18,800
!سيواصحل هذين الاثنين التّقدّم في الطّريقين كطعم أيضًا

197
00:15:18,800 --> 00:15:19,820
!ماذا؟

198
00:15:20,880 --> 00:15:25,160
نحن جاهزون بالطّبع للتّضحية
...بأرواحنا في القتال

199
00:15:25,160 --> 00:15:30,330
...لنرسل كينييمون والبقيّة للمعركة الحاسمة

200
00:15:30,330 --> 00:15:33,210
!كيف سيتقدّم أعضاء الأكازايا إذًا؟

201
00:15:34,230 --> 00:15:36,300
.بحرًا هو الخيار الوحيد

202
00:15:36,300 --> 00:15:39,640
!لكنّ الدّوّامات ستسدّ طريقنا

203
00:15:39,640 --> 00:15:43,160
.لا مشكلة. سيسير الأمر على ما يرام

204
00:15:43,320 --> 00:15:46,600
،عن طريق الذّهاب تحت الماء عبر بولار تانغ

205
00:15:46,820 --> 00:15:52,230
وسنتجنّب الدّوّامات على الطّريق
.بالدّوران حول الجزيرة

206
00:15:52,230 --> 00:15:53,880
...وأيضًا

207
00:15:54,860 --> 00:15:59,390
.ستسمح لنا قدرتي بإرسالكم إلى الجزيرة جميعًا

208
00:16:01,300 --> 00:16:03,580
!نعم! يبدو هذا ممتازًا

209
00:16:03,820 --> 00:16:05,450
،لكن يا لو-دونو

210
00:16:05,450 --> 00:16:09,140
.ما زال عليّ قيادة الآخرين

211
00:16:09,140 --> 00:16:10,730
.معك حقّ

212
00:16:10,890 --> 00:16:16,380
إذًا سآخذ أنا طريق الجبل أيضًا، لنتمكّن
.من قيادة المجموعتين في كِلا الجانبين

213
00:16:16,770 --> 00:16:17,720
!موافقون؟

214
00:16:17,720 --> 00:16:18,720
!رايزو

215
00:16:18,720 --> 00:16:19,680
!كاواماتسو

216
00:16:19,680 --> 00:16:20,760
!إينواراشي

217
00:16:20,760 --> 00:16:21,970
!كيكونوجو

218
00:16:21,970 --> 00:16:23,490
!أشورا

219
00:16:23,490 --> 00:16:25,220
.مفهوم

220
00:16:25,220 --> 00:16:28,180
،سندّخر طاقتنا

221
00:16:28,180 --> 00:16:31,560
!وسنقاتل كايدو بكلّ قوّتنا

222
00:16:31,560 --> 00:16:32,560
!حسنًا

223
00:16:32,560 --> 00:16:37,250
!كما كان مخطّطًا سابقًا، لنستعمل تلك الخطّة

224
00:16:37,250 --> 00:16:40,670
!هذا هو كين-سان! إنّها خطّة مُحكمة

225
00:16:40,670 --> 00:16:43,180
...تحديق

226
00:16:43,380 --> 00:16:46,520
أتريد قول شيء ما يا رايزو-كُن؟

227
00:16:47,890 --> 00:16:51,040
.ليس على وجه التّحديد

228
00:16:51,060 --> 00:16:53,210
...لنرَ

229
00:16:53,210 --> 00:16:59,070
...تحت بوّابة توري

230
00:17:02,180 --> 00:17:04,790
!مهلاً، مهلاً، مهلاً

231
00:17:04,950 --> 00:17:06,720
ما هذا؟

232
00:17:06,720 --> 00:17:09,710
!إنّه حصن

233
00:17:17,460 --> 00:17:23,690
يبدو أنّ قراصنة مملكة الحيوان
...لديهم ساكي ممتاز

234
00:17:23,690 --> 00:17:25,030
!يا لوفي

235
00:17:25,030 --> 00:17:26,950
!أتريد التّقدّم مباشرة فعلاً؟

236
00:17:26,950 --> 00:17:29,510
!إنّه حصن

237
00:17:29,510 --> 00:17:33,210
!وإن كان، سأوسع ضربًا كلّ ما يقف في طريقي

238
00:17:33,210 --> 00:17:37,340
!سأحصل على السّاكي ورأس كايدو معًا

239
00:17:46,550 --> 00:17:49,640
!تـ-تلك سفينة العدوّ

240
00:17:49,640 --> 00:17:52,330
!ستصبح الرّحلة وعرة! تماسّكوا

241
00:18:15,980 --> 00:18:19,090
!لنستعمل المرساة لندخل شاطئهم بالقوّة

242
00:18:19,090 --> 00:18:20,360
!افعلها

243
00:18:29,890 --> 00:18:32,640
!حسنًا! لنقم بهذا بمحاولة واحدة

244
00:18:46,410 --> 00:18:49,050
!لم أرَ سفينة تتحرّك هكذا من قبل

245
00:18:49,050 --> 00:18:51,080
!عظامي تنزلق

246
00:18:55,250 --> 00:18:57,250
!تـ-تتحرّك السّفينة بشكل جانبيّ

247
00:18:59,440 --> 00:19:03,610
!إنّ تحرّكهم المستمرّ يمنعني من التّصويب

248
00:19:04,630 --> 00:19:08,640
مهاراتك مذهلة، لكن وجّهها بشكل
.ألطف في المرّة القادمة رجاءً

249
00:19:10,200 --> 00:19:12,430
!أنا آسف

250
00:19:12,430 --> 00:19:15,980
!أيّها القبطان لوفي! دمّر أسلحتهم المدفعيّة أوّلاً

251
00:19:15,980 --> 00:19:18,520
!حسنًا! أنا لها

252
00:19:27,200 --> 00:19:31,070
!لا تسمحوا لهم بالاقتراب! أطلقوا، أطلقوا

253
00:19:31,070 --> 00:19:33,410
...فاكهة المطّاط

254
00:19:34,080 --> 00:19:37,460
!المدفع الرّشّاش

255
00:19:51,350 --> 00:19:54,430
...فاكهة المطّاط

256
00:19:54,430 --> 00:19:57,390
!المسدّس

257
00:20:11,910 --> 00:20:14,080
!أطلقوا، أطلقوا

258
00:20:20,850 --> 00:20:23,000
...أسلوب السّيفين

259
00:20:30,190 --> 00:20:31,590
!موجة الصّقر

260
00:20:48,630 --> 00:20:50,710
.أنا محاصر

261
00:20:50,710 --> 00:20:52,950
!نالوا منه

262
00:20:54,760 --> 00:20:57,270
!سول سوليد

263
00:21:07,480 --> 00:21:09,350
...عَلَم

264
00:21:09,350 --> 00:21:10,970
!بانديرول السّنونو

265
00:21:21,770 --> 00:21:25,150
!ألف زهرة: اليد العملاقة

266
00:21:34,510 --> 00:21:35,780
!دوس

267
00:21:59,240 --> 00:22:00,640
...روبين-تشان

268
00:22:03,730 --> 00:22:06,540
...أنت جميلة حتّى وأنت تقاتلين

269
00:22:06,540 --> 00:22:10,630
!يا هذا! لماذا أنت مرتاح هكذا؟

270
00:22:15,710 --> 00:22:17,160
!ركلة البطن

271
00:22:23,040 --> 00:22:27,230
!ملاكمة فرانكي

272
00:22:28,850 --> 00:22:32,340
!خارق

273
00:22:34,820 --> 00:22:39,000
.يبدو أنّهم ليسوا بحاجة لمساعدتنا

274
00:22:48,440 --> 00:22:51,820
...فاكهة المطّاط

275
00:22:51,820 --> 00:22:55,490
!المسدّس النّفّاث

276
00:23:04,620 --> 00:23:09,840
اجتمع محاربون مرعبون في المهرجان
!الذّهبيّ السّنويّ في أونيغاشيما

277
00:23:09,840 --> 00:23:12,840
وأوروتشي في أوج نشوته مستمتعًا
!بالوليمة الفاسقة

278
00:23:12,840 --> 00:23:22,390
وبينما يقترب لوفي والبقيّة ويضع كايدو خطّة
!جديدة، تظهر شخصيّات مرعبة وبالغة الخطورة

279
00:23:22,560 --> 00:23:27,190
:في الحلقة القادمة من وان بيس
"!ورقة كايدو الرّابحة! !ظهور التّوبي روبّو"

280
00:23:27,190 --> 00:23:29,600
!ملك القراصنة، لن يكون إلاّ أنا