1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,480 --> 00:02:27,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:32,950 --> 00:02:35,600
...هالة الشّيطان... أسلوب السّيوف التّسعة

33
00:02:39,230 --> 00:02:40,570
!أسورا

34
00:02:43,900 --> 00:02:45,580
!قاطع السّماء

35
00:02:50,790 --> 00:02:53,170
!لا أمانع وجود العقبات

36
00:02:53,170 --> 00:02:56,370
!اخترت السّير على درب أسورا

37
00:03:04,480 --> 00:03:07,340
!أسورا: الضّباب الفضّيّ

38
00:03:11,460 --> 00:03:13,430
.المستوى الثّاني

39
00:03:15,850 --> 00:03:16,890
!السّوط النّفّاث

40
00:03:25,460 --> 00:03:26,860
!انتقال آنيّ

41
00:03:27,250 --> 00:03:27,860
!مسدّس الإصبع

42
00:03:30,200 --> 00:03:31,700
...فاكهة المطّاط

43
00:03:31,700 --> 00:03:32,530
!الجسد الحديديّ

44
00:03:32,530 --> 00:03:34,370
!البازوكا النّفّاثة

45
00:03:41,190 --> 00:03:41,960
!فرانكي

46
00:03:42,880 --> 00:03:44,420
!أنقذ روبين رجاءً

47
00:03:46,130 --> 00:03:48,860
!أنا لها بشكل خارق

48
00:03:50,280 --> 00:03:53,140
!أيّتها الحقيرة! ما زلت لا تستوعبين؟
!قلتُ أنّ هذا بلا فائدة

49
00:03:53,140 --> 00:03:54,680
!كم مرّة عليّ إخبارك؟

50
00:03:55,250 --> 00:03:57,520
!لم يعد لك أيّ أمل

51
00:03:58,550 --> 00:04:00,090
!لن أبارح مكاني

52
00:04:00,740 --> 00:04:04,400
!سيأتون جميعًا لإنقاذي بكلّ تأكيد

53
00:04:07,710 --> 00:04:12,300
!يرتعد سباندام خوفًا"
"!بطل يقف على برج القانون

54
00:04:41,740 --> 00:04:45,150
!مهلاً، انظروا إلى هناك
!لم أرَ هذا من قبل

55
00:04:45,150 --> 00:04:49,610
صحيح... لم أسمع أيّ أحد
!يتحدّث عن الأمر حتّى

56
00:04:51,250 --> 00:04:54,500
!لا أصدّق أنّ بوّابات العدالة فتحت بالكامل

57
00:04:54,500 --> 00:04:57,580
هذا لتستطيع السّفن الحربيّة من
!المقرّ الرّئيسيّ أن تأتي إلى هنا

58
00:04:57,580 --> 00:05:00,580
!"هذا من أجل هجوم مدافع "نداء الدّمار

59
00:05:04,930 --> 00:05:07,380
قالت الجدّة كوكورو بكلّ تأكيد

60
00:05:07,380 --> 00:05:11,010
أنّ هذه البوّابات لا تفتح أبدًا
...بالكامل، ومع ذلك

61
00:05:11,750 --> 00:05:16,770
ما جوّ التّخويف هذا؟
ما هو "نداء الدّمار"؟

62
00:05:16,770 --> 00:05:19,150
افتعل قراصنة قبّعة القشّ
.قتالاً مع العالم

63
00:05:19,150 --> 00:05:22,240
إذًا فسيقومون بتفجيرهم بالفعل
!مع هذه الجزيرة بأكملها

64
00:05:22,240 --> 00:05:24,020
!أوغاد

65
00:05:24,020 --> 00:05:27,210
!لا تمت يا أخي

66
00:05:27,210 --> 00:05:28,480
!أجل

67
00:05:28,480 --> 00:05:30,180
!عد حيًّا

68
00:05:30,180 --> 00:05:32,750
!يا قبّعة القشّ

69
00:05:45,560 --> 00:05:50,550
.عهدت بمهمّة إنقاذ روبين لفرانكي

70
00:05:51,980 --> 00:05:57,140
.كان ذلك تهاونًا منّي
.لم أتوقّعه أن يكون بهذه القوّة

71
00:05:57,570 --> 00:06:00,400
.يبدو أنّ أنفاسك بدأت تتقطّع

72
00:06:00,400 --> 00:06:02,640
أليس ذلك بسبب ذلك البخار؟

73
00:06:09,010 --> 00:06:12,490
.هزيمتك هي كلّ ما يهمّ

74
00:06:16,360 --> 00:06:18,570
.فهمت... أنت قويّ

75
00:06:20,960 --> 00:06:22,330
!من الأفضل أن أصل في الوقت

76
00:06:22,980 --> 00:06:25,290
!لا تذهبي بعد يا نيكو روبين

77
00:06:27,340 --> 00:06:28,900
!تبدين في غاية الغباء

78
00:06:29,910 --> 00:06:33,230
هذا بسبب مقاومتك العقيمة
!أيّتها المرأة الغبيّة

79
00:06:34,950 --> 00:06:36,170
!هيّا، قفي

80
00:06:37,140 --> 00:06:38,880
!قلت لك قفي

81
00:06:40,410 --> 00:06:45,180
،يا إلهي، البوّابة أمامنا مباشرة
!ومع ذلك تسبّبين لي المشاكل

82
00:06:53,490 --> 00:06:55,240
!أيّها الحرس! اخرجوا

83
00:06:55,240 --> 00:06:56,240
!حاضر

84
00:07:03,520 --> 00:07:05,250
،احرسوا بوّابات العدالة

85
00:07:05,250 --> 00:07:08,420
ورجال البحريّة في السّفينة المرافقة
!الّتي أرسلها المقرّ الرّئيسيّ

86
00:07:09,500 --> 00:07:13,950
،يصطحب رئيس سايفر بول رقم 9
سباندام، مجرمة بالغة الأهمّيّة حاليًّا

87
00:07:13,950 --> 00:07:19,840
.عبر الجسر من برج القانون

88
00:07:20,450 --> 00:07:22,900
!اصطفّوا جميعًا وألقوا التّحيّة

89
00:07:22,900 --> 00:07:24,520
!حاضر

90
00:07:33,370 --> 00:07:36,260
.انظري. جميعهم جاهزون ليشدّوا الرّحال

91
00:07:36,260 --> 00:07:39,110
.ما عاد هنالك أيّ شيء الآن ليعترض طريقنا

92
00:07:43,610 --> 00:07:45,450
.صحيح يا نيكو روبين

93
00:07:45,450 --> 00:07:49,040
.سأخبرك بسرّ صغير

94
00:07:49,810 --> 00:07:52,300
قبل عبورنا للجسر، شغّلت اللُّغم

95
00:07:52,300 --> 00:07:55,780
الموجود في الجزء العلويّ
.للدّرج الّذي صعدناه للتّوّ

96
00:07:55,780 --> 00:08:00,310
إن حاول شخص ما مثلاً
،المجيء إلى هنا

97
00:08:00,310 --> 00:08:05,720
!فإنّ الدّرج سينفجر وإيّاه

98
00:08:06,210 --> 00:08:08,340
ما رأيك؟ أليس هذا ممتعًا؟

99
00:08:08,340 --> 00:08:11,620
،لكن لا داعي للقلق

100
00:08:11,620 --> 00:08:14,530
بما أنّ لا أحد سيصل لذلك
.الدّرج من الأساس

101
00:08:19,110 --> 00:08:22,320
...لكنّني لن أعبر... البوّابة

102
00:08:33,040 --> 00:08:35,590
.لأنّهم وعدوا أن ينقذوني

103
00:08:35,590 --> 00:08:38,630
!لن يأتي أيّ أحد أيّتها المرأة الغبيّة

104
00:08:39,220 --> 00:08:43,720
سيحترق الجميع حتّى الموت
!في نيران "نداء الدّمار" المستعرة

105
00:08:45,180 --> 00:08:52,480
سيمحو ذلك حتّى الإهانة المذلّة لحقيقة
!حرق القراصنة لعلمنا المقدّس

106
00:08:53,740 --> 00:08:59,240
تمامًا كما حدث في أوهارا قبل عشرين سنة
.عندما هاجمَنا ذلك العملاق من البحريّة

107
00:09:00,830 --> 00:09:02,380
!والآن سيري

108
00:09:03,070 --> 00:09:05,450
!سيري على قدميك

109
00:09:06,020 --> 00:09:07,030
...ساول

110
00:09:09,360 --> 00:09:10,200
!حقيرة

111
00:09:12,600 --> 00:09:14,630
!أيّها الرّئيس! أسرع رجاءً

112
00:09:14,630 --> 00:09:18,130
!أعلم ذلك! اخرس! أنا بطل

113
00:09:18,630 --> 00:09:22,090
على الأرجح أنّك تعتقدين
أنّني أجهل الأمر برمّته، صحيح؟

114
00:09:22,600 --> 00:09:27,180
سوء سلوك جاغوار د. ساول في عمله
!كنائب أميرال سابق في المقرّ الرّئيسيّ

115
00:09:27,180 --> 00:09:33,140
...أمّك أولفيا... وما حدث في أوهارا وقتها

116
00:09:33,580 --> 00:09:35,580
!أعرف كلّ شيء

117
00:09:36,950 --> 00:09:38,960
ولماذا ذلك في رأيك؟

118
00:09:38,960 --> 00:09:40,630
.هذا لأنّ هنالك من أخبرني بالأمر

119
00:09:40,630 --> 00:09:45,950
إنّ من أمر بتنفيذ الغارة
،على بلاد أوهارا وشياطينها

120
00:09:45,950 --> 00:09:50,950
وكشف عن جرائمهم الفظيعة وأمر بتنفيذ
نداء الدّمار" كان رئيس سي بي 9 حينها"

121
00:09:50,950 --> 00:09:54,540
!ألا وهو أبي، الرّئيس سبانداين

122
00:10:00,180 --> 00:10:02,980
!والآن يا علماء أوهارا

123
00:10:02,980 --> 00:10:06,550
!تقرّر الآن الحكم بإعدامكم

124
00:10:08,800 --> 00:10:09,560
!اقضوا عليه

125
00:10:19,520 --> 00:10:21,900
!أيّها الأستاذ

126
00:10:25,000 --> 00:10:26,360
...إنّ أوهارا

127
00:10:29,750 --> 00:10:31,830
.تعرف أكثر ممّا يجب

128
00:10:32,260 --> 00:10:33,870
!"سأطلق "نداء الدّمار

129
00:10:34,580 --> 00:10:35,920
.اهتمّوا بالباقي

130
00:10:45,540 --> 00:10:47,930
!هيّا خذها يا ساول

131
00:10:50,720 --> 00:10:52,250
هل أنت واثقة من هذا؟

132
00:10:52,250 --> 00:10:52,960
.نعم

133
00:10:53,860 --> 00:10:57,410
!كلاّ! سأبقى هنا أيضًا! أمّي

134
00:10:57,410 --> 00:11:00,080
!أمّي

135
00:11:00,080 --> 00:11:02,880
.كم سعدت بسماعك تناديني بذلك

136
00:11:03,610 --> 00:11:04,940
!شكرًا لك

137
00:11:05,700 --> 00:11:08,540
...من الآن فصاعدًا، من أجل كلتينا

138
00:11:08,540 --> 00:11:10,070
!عيشي يا روبين

139
00:11:18,400 --> 00:11:23,960
ظنّوا جميعًا أنّ كلّ من في
...أوهارا مات حينها، لكن

140
00:11:23,960 --> 00:11:27,680
غفلت الحكومة عن شقيّة واحدة
.تمكّنت من الهرب

141
00:11:29,310 --> 00:11:30,340
كيف حدث ذلك؟

142
00:11:30,820 --> 00:11:34,010
من يدري كم مرّة كادت تُقتل هذه
الشّقيّة ذات الثّمانية ربيع

143
00:11:34,010 --> 00:11:36,350
على يد بالغين يسعون للمال؟

144
00:11:39,100 --> 00:11:42,190
.ما كان بمقدورك أن تثقي بأيّ أحد يتقرّب منك

145
00:11:42,190 --> 00:11:46,320
لم يكن لديك أيّ مكان لتنامي فيه
.بأمن وسلام. لم تملكي طعامًا أيضًا

146
00:11:47,090 --> 00:11:51,870
لا أريد حتّى تخيّل كم كانت السّنوات
.العشرين الأخيرة فظيعة بالنّسبة لك

147
00:11:54,250 --> 00:11:56,210
إذًا فقد كنتِ تعيسة جدًّا
لدرجة دفعتك للبكاء؟

148
00:11:56,210 --> 00:12:00,830
إنّ الشّخص الّذي وضع مكافأة
...على رأسك قبل عشرين سنة

149
00:12:01,240 --> 00:12:02,640
!كان أبي

150
00:12:03,680 --> 00:12:05,420
!فعل ذلك لأجل سلام العالم

151
00:12:09,340 --> 00:12:15,520
...والآن، بعد عشرين سنة
،يطارد ابنه النّاجية الوحيدة

152
00:12:15,520 --> 00:12:18,430
.وتنتهي بذلك معركة أوهارا

153
00:12:19,680 --> 00:12:22,190
!خسرت أوهارا

154
00:12:24,590 --> 00:12:27,740
!روبين! كوني فخورة يا روبين

155
00:12:29,080 --> 00:12:32,740
!أمّك أمرأة مشرِّفة! أوهارا مشرِّفة

156
00:12:32,740 --> 00:12:37,430
عليك يومًا ما، أن تمرّري تاريخ
!هذه الجزيرة يا روبين

157
00:12:37,430 --> 00:12:41,060
!قاتلت أوهارا ضدّ العالم

158
00:12:53,650 --> 00:12:55,760
!ليس وأنا لا أزال حيّة

159
00:12:55,760 --> 00:13:00,050
!لكنّ موتك وشيك، صحيح؟! أجيبيني

160
00:13:10,110 --> 00:13:10,900
!ما هذا؟

161
00:13:16,950 --> 00:13:20,450
!كا-كاتي فلام! ما الّذي يفعله هنا؟

162
00:13:20,920 --> 00:13:23,780
!لكن لا بأس. وقع في الفخّ
!يا له من غبيّ

163
00:13:23,780 --> 00:13:25,930
!وقع ذلك الغبيّ ضحيّة اللُّغم

164
00:13:28,220 --> 00:13:30,130
!أتى لإنقاذي

165
00:13:30,130 --> 00:13:33,800
.يا ويحي. هذا ليس جيّدًا
.من الجيّد أنّني أخذتُ احتياطاتي

166
00:13:35,060 --> 00:13:36,420
!علينا الإسراع! هيّا

167
00:13:38,470 --> 00:13:40,390
...حتّى كلماتي تخونني

168
00:13:40,730 --> 00:13:44,350
!ابدؤوا الإبحار يا رجال
!سأقفز على متن السّفينة

169
00:13:44,350 --> 00:13:46,400
!حا-حاضر! عُلم

170
00:13:46,400 --> 00:13:47,820
!سنشدّ الرّحال

171
00:13:47,820 --> 00:13:48,480
!حاضر

172
00:13:49,390 --> 00:13:52,440
لكنّي غاضبة لدرجة أنّني
!لا أستطيع إيقاف دموعي

173
00:13:57,030 --> 00:13:58,540
!شاهدوا جيّدًا

174
00:13:58,540 --> 00:14:03,790
هذه هي خطوة البطل الأولى
...الّتي ستُحفر في التّاريـ

175
00:14:29,830 --> 00:14:31,340
!شاهدوا جيّدًا

176
00:14:31,340 --> 00:14:36,700
هذه هي خطوة البطل الأولى
...الّتي ستُحفر في التّاريـ

177
00:14:38,370 --> 00:14:41,790
!كم هذا مؤلم

178
00:14:43,470 --> 00:14:45,500
!هل أنت بخير أيّها الرّئيس؟

179
00:14:46,120 --> 00:14:47,960
!ما كان ذلك؟! من الفاعل؟

180
00:14:47,960 --> 00:14:49,480
!لا أحد على الجسر

181
00:14:49,480 --> 00:14:53,210
لا بدّ من وجوده! لا بدّ
!أنّه مختبئ في مكان ما! جدوه

182
00:14:53,790 --> 00:14:55,270
!أين هو؟

183
00:15:05,130 --> 00:15:09,370
!أنتم! ما الّذي تفعلونه؟
!لماذا لا تهاجمون؟

184
00:15:09,370 --> 00:15:12,230
!لكن يا رئيس، لا يمكننا العثور على العدوّ

185
00:15:14,550 --> 00:15:16,820
!لحظة! إنّه هناك

186
00:15:32,130 --> 00:15:34,210
!اهربي بكلّ ما لديك من قوّة

187
00:15:34,210 --> 00:15:38,920
!ستموتين إن بقيت على هذه الجزيرة
!أبحري باستعمال طوفي

188
00:15:38,920 --> 00:15:39,760
ماذا عنك يا ساول؟

189
00:15:40,250 --> 00:15:44,130
.هذه هي نهايتي. لقد قُبض عليّ

190
00:15:44,900 --> 00:15:45,600
!اذهبي

191
00:15:45,600 --> 00:15:48,230
!كلاّ! لا ينتظرني أحد في البحر

192
00:15:48,230 --> 00:15:50,640
!أصغي إليّ يا روبين

193
00:15:51,440 --> 00:15:56,530
أنت وحيدة الآن، لكنّك ستقابلين
!أصدقاء يومًا ما بكلّ تأكيد

194
00:16:00,320 --> 00:16:01,200
أصدقاء؟

195
00:16:01,200 --> 00:16:05,940
...نعم. البحر واسع، ويومًا ما بكلّ تأكيد

196
00:16:07,120 --> 00:16:10,170
!ستقابلين أصدقاء سيحمونك

197
00:16:10,420 --> 00:16:15,490
!لم يولد أحد في هذا العالم ليكون وحيدًا

198
00:16:18,330 --> 00:16:20,300
!اهربي يا روبين! لا تنظري خلفك

199
00:16:20,300 --> 00:16:26,160
،إن واجهت وقتًا عصيبًا
!اضحكي كما علّمتك تمامًا

200
00:16:26,160 --> 00:16:27,390
!انتبه يا ساول

201
00:16:30,860 --> 00:16:32,060
.وقت الجليد

202
00:16:34,360 --> 00:16:35,610
!ساول

203
00:16:37,160 --> 00:16:40,930
اذهبي وقابلي أصدقاء أنا واثق أنّهم بانتظارك

204
00:16:40,930 --> 00:16:43,030
!في مكان ما من البحر يا روبين

205
00:16:45,840 --> 00:16:49,120
.عيشي معهم

206
00:17:02,010 --> 00:17:03,340
!انظر هناك يا رئيس

207
00:17:03,340 --> 00:17:06,200
!ماذا؟! أين تقصد؟

208
00:17:11,350 --> 00:17:14,190
!...فوق برج القانون

209
00:17:14,190 --> 00:17:19,030
برج القانون؟! ماذا بإمكانه فعله
!من تلك المسافة؟

210
00:17:24,280 --> 00:17:25,950
!أجل

211
00:17:25,950 --> 00:17:27,990
!من يكون ذاك؟

212
00:17:28,700 --> 00:17:33,500
إنّه يصوّب نحونا من تلك المسافة دون
!أيّ هامش للخطأ رغم هذه الرّياح؟

213
00:17:29,790 --> 00:17:33,500
♪ ...ولدت في ♪

214
00:17:33,500 --> 00:17:35,000
!من يكون؟

215
00:17:33,500 --> 00:17:36,020
♪ جزيرة القنّاصين ♪

216
00:17:36,020 --> 00:17:37,460
!طويل الأنف

217
00:17:37,950 --> 00:17:41,910
!أرأيتم؟! قنّاصنا مذهل، صحيح؟

218
00:17:43,160 --> 00:17:45,720
♪ ...أو حتّى قلبك ♪

219
00:17:43,160 --> 00:17:45,720
!نالوا ما استحقّوه بالفعل

220
00:17:45,720 --> 00:17:46,750
!اهربي يا روبين-تشان

221
00:17:46,750 --> 00:17:48,530
♪ !تصويب ♪

222
00:17:48,530 --> 00:17:50,310
هل عليه أن يغنّي بالفعل؟

223
00:17:50,310 --> 00:17:52,890
!كيف تجرؤ؟

224
00:17:55,530 --> 00:17:56,690
!أيّها الرّئيس

225
00:18:00,030 --> 00:18:04,800
!سُحقًا! ما الّذي تفعلونه؟
!أردوه قتيلاً في الحال

226
00:18:04,800 --> 00:18:09,700
إنّنا نحاول، لكنّ مدى رصاصاتنا لا يصل
!لذلك البعد، ناهيك عن إصابته

227
00:18:09,700 --> 00:18:12,660
!لذلك القنّاص مهارات لا تصدّق

228
00:18:13,540 --> 00:18:15,040
!لاذت نيكو روبين  بالفرار

229
00:18:15,420 --> 00:18:18,280
!لا تسمحوا لها بالهرب
!يمكنكم الإطلاق عليها يا أغبياء

230
00:18:18,280 --> 00:18:19,300
!حاضر

231
00:18:19,300 --> 00:18:21,470
!أردوها قتيلة بما يكفي لتبقى حيّة

232
00:18:21,470 --> 00:18:22,130
!كيف؟

233
00:18:36,150 --> 00:18:37,310
!أطلقوا

234
00:19:14,490 --> 00:19:16,640
!ما هذا الشّخص؟

235
00:19:17,330 --> 00:19:18,650
...أنت

236
00:19:20,970 --> 00:19:23,570
.جسدي قويّ لأنّه مصنوع من الحديد

237
00:19:24,420 --> 00:19:26,110
!لم يرق لي ذلك اللُّغم يا سباندا

238
00:19:27,730 --> 00:19:32,580
.يا فرانكي-كُن، فرانكي-كُن
.معك سوغيكينغ

239
00:19:32,580 --> 00:19:35,550
...ماذا؟ يفترض أنّ حلزون الاتّصال هذا

240
00:19:35,550 --> 00:19:37,410
.حصلت عليه من نامي

241
00:19:37,810 --> 00:19:41,910
الأهمّ الآن هو أنّك ستجد قماشة
.حمراء على الأرض قربك

242
00:19:41,910 --> 00:19:43,380
قماشة حمراء؟

243
00:19:43,380 --> 00:19:44,710
!نعم، أراها

244
00:19:45,060 --> 00:19:46,970
.ستجد مفتاحين فيها

245
00:19:46,970 --> 00:19:49,680
وبهذا ستكون كلّ المفاتيح معك
.إضافة للّتي بحوزتك سلفًا

246
00:19:50,820 --> 00:19:52,640
!كلّ المفاتيح؟

247
00:19:54,410 --> 00:19:56,350
.سلّمتها لك بكلّ تأكيد

248
00:19:57,500 --> 00:19:58,770
.تمّت المهمّة

249
00:19:59,780 --> 00:20:02,020
.لنسرع. هذا سيّئ

250
00:20:02,400 --> 00:20:03,660
...الرّقم 1

251
00:20:03,660 --> 00:20:05,110
...الرّقم 3

252
00:20:05,110 --> 00:20:06,740
!الرّقم 4... لا يعمل

253
00:20:06,740 --> 00:20:07,630
!الرّقم 5

254
00:20:09,680 --> 00:20:10,660
!أزلتها

255
00:20:15,820 --> 00:20:18,500
!مستحيل! إ-إنّها المفاتيح الحقيقيّة؟

256
00:20:20,660 --> 00:20:22,710
!مهلاً، مهلاً... تمالكي نفسك

257
00:20:22,710 --> 00:20:25,100
...لا يعقل... هذا يعني

258
00:20:25,100 --> 00:20:32,140
كلاّ! هل تمكّنتم من هزيمة
!السّي بي 9 في برج القانون؟

259
00:20:39,980 --> 00:20:41,790
!لا، ذلك غير معقول

260
00:20:41,790 --> 00:20:45,440
!لا بدّ أنّكم سرقتموها وهربتم! اللّعنة

261
00:20:46,180 --> 00:20:49,030
!هذا فرانكي! أتسمعني يا طويل الأنف؟

262
00:20:49,650 --> 00:20:52,030
.أزلت أصفاد نيكو روبين

263
00:20:52,030 --> 00:20:53,530
!ممتاز

264
00:20:53,910 --> 00:20:56,080
!شكرًا لك يا طويل الأنف

265
00:20:56,580 --> 00:21:01,670
يمكنك أن تشكري من قاتلوا ببسالة
.لجمع المفاتيح في نهاية كلّ هذا

266
00:21:02,590 --> 00:21:06,770
أنت وبلا أدنى شكّ عضوة
!في طاقم لوفي-كُن

267
00:21:06,770 --> 00:21:09,510
!يمكنك الآن فعل ما يحلو لك

268
00:21:10,890 --> 00:21:11,680
.نعم

269
00:21:14,550 --> 00:21:16,350
!ستّ زهرات

270
00:21:17,350 --> 00:21:18,810
!مهلاً! ما هذا؟

271
00:21:19,180 --> 00:21:20,430
!صفع

272
00:21:29,540 --> 00:21:31,820
.سأقوم بهذا حتىّ يُشفى غليلي

273
00:21:45,750 --> 00:21:47,360
!أيّها الرّئيس

274
00:21:47,360 --> 00:21:50,760
!حسنًا يا رفاق! أسرعوا بالمجيء إلى هنا

275
00:21:50,760 --> 00:21:53,220
!سأجهّز الأمور لهروبنا

276
00:21:53,220 --> 00:21:54,970
!عُلم

277
00:21:55,890 --> 00:21:57,930
!انزل بسرعة يا سوغيكينغ

278
00:21:58,310 --> 00:22:01,860
هذا سيّئ! أزيلت أصفاد الحجر
!البحريّ من معصمَيْ المجرمة

279
00:22:01,860 --> 00:22:03,560
!اقبضوا عليها ثانية

280
00:22:06,180 --> 00:22:09,020
.سار كلّ شيء حسب خطّتي

281
00:22:12,450 --> 00:22:13,200
ما هذا؟

282
00:22:16,720 --> 00:22:18,790
هل سمعتُ شيئًا ما للتّوّ؟

283
00:22:31,240 --> 00:22:33,500
.لا أهتمّ إن تداعى جسدي

284
00:22:33,500 --> 00:22:35,720
!سأفعل ما أستطيع فعله

285
00:22:35,720 --> 00:22:37,180
.هذا ليس تصرّفًا ذكيًّا

286
00:22:37,660 --> 00:22:41,810
تقنيتك تلك تقلّل من عمرك، أتعلم ذلك؟

287
00:22:41,810 --> 00:22:44,480
!أنت طموح أكثر من اللاّزم

288
00:22:45,270 --> 00:22:46,480
:في الحلقة القادمة من وان بيس

289
00:22:46,480 --> 00:22:50,480
،روبين حرّة! لوفي ضدّ لوتشي"
"!نزال بين القائدين

290
00:22:50,480 --> 00:22:53,010
!ملك القراصنة، لن يكون إلاّ أنا

291
00:22:56,030 --> 00:23:01,040
نلقاكم في الحلقة القادمة