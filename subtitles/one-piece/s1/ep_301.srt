1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,480 --> 00:02:41,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:46,950 --> 00:02:49,600
...هالة الشّيطان... أسلوب السّيوف التّسعة

33
00:02:53,230 --> 00:02:54,570
!أسورا

34
00:02:57,900 --> 00:02:59,580
!قاطع السّماء

35
00:03:04,790 --> 00:03:07,170
!لا أمانع وجود العقبات

36
00:03:07,170 --> 00:03:10,370
!اخترت السّير على درب أسورا

37
00:03:18,480 --> 00:03:21,340
!أسورا: الضّباب الفضّيّ

38
00:03:25,460 --> 00:03:27,430
.المستوى الثّاني

39
00:03:29,850 --> 00:03:30,890
!السّوط النّفّاث

40
00:03:39,460 --> 00:03:40,860
!انتقال آنيّ

41
00:03:41,250 --> 00:03:41,860
!مسدّس الإصبع

42
00:03:44,200 --> 00:03:45,700
...فاكهة المطّاط

43
00:03:45,700 --> 00:03:46,530
!الجسد الحديديّ

44
00:03:46,530 --> 00:03:48,370
!البازوكا النّفّاثة

45
00:03:55,190 --> 00:03:55,960
!فرانكي

46
00:03:56,880 --> 00:03:58,420
!أنقذ روبين رجاءً

47
00:04:00,130 --> 00:04:02,860
!أنا لها بشكل خارق

48
00:04:04,280 --> 00:04:07,140
!أيّتها الحقيرة! ما زلت لا تستوعبين؟
!قلتُ أنّ هذا بلا فائدة

49
00:04:07,140 --> 00:04:08,680
!كم مرّة عليّ إخبارك؟

50
00:04:09,250 --> 00:04:11,520
!لم يعد لك أيّ أمل

51
00:04:12,550 --> 00:04:14,090
!لن أبارح مكاني

52
00:04:14,740 --> 00:04:18,400
!سيأتون جميعًا لإنقاذي بكلّ تأكيد

53
00:04:21,710 --> 00:04:26,300
!يرتعد سباندام خوفًا"
"!بطل يقف على برج القانون

54
00:04:55,740 --> 00:04:59,150
!مهلاً، انظروا إلى هناك
!لم أرَ هذا من قبل

55
00:04:59,150 --> 00:05:03,610
صحيح... لم أسمع أيّ أحد
!يتحدّث عن الأمر حتّى

56
00:05:05,250 --> 00:05:08,500
!لا أصدّق أنّ بوّابات العدالة فتحت بالكامل

57
00:05:08,500 --> 00:05:11,580
هذا لتستطيع السّفن الحربيّة من
!المقرّ الرّئيسيّ أن تأتي إلى هنا

58
00:05:11,580 --> 00:05:14,580
!"هذا من أجل هجوم مدافع "نداء الدّمار

59
00:05:18,930 --> 00:05:21,380
قالت الجدّة كوكورو بكلّ تأكيد

60
00:05:21,380 --> 00:05:25,010
أنّ هذه البوّابات لا تفتح أبدًا
...بالكامل، ومع ذلك

61
00:05:25,750 --> 00:05:30,770
ما جوّ التّخويف هذا؟
ما هو "نداء الدّمار"؟

62
00:05:30,770 --> 00:05:33,150
افتعل قراصنة قبّعة القشّ
.قتالاً مع العالم

63
00:05:33,150 --> 00:05:36,240
إذًا فسيقومون بتفجيرهم بالفعل
!مع هذه الجزيرة بأكملها

64
00:05:36,240 --> 00:05:38,020
!أوغاد

65
00:05:38,020 --> 00:05:41,210
!لا تمت يا أخي

66
00:05:41,210 --> 00:05:42,480
!أجل

67
00:05:42,480 --> 00:05:44,180
!عد حيًّا

68
00:05:44,180 --> 00:05:46,750
!يا قبّعة القشّ

69
00:05:59,560 --> 00:06:04,550
.عهدت بمهمّة إنقاذ روبين لفرانكي

70
00:06:05,980 --> 00:06:11,140
.كان ذلك تهاونًا منّي
.لم أتوقّعه أن يكون بهذه القوّة

71
00:06:11,570 --> 00:06:14,400
.يبدو أنّ أنفاسك بدأت تتقطّع

72
00:06:14,400 --> 00:06:16,640
أليس ذلك بسبب ذلك البخار؟

73
00:06:23,010 --> 00:06:26,490
.هزيمتك هي كلّ ما يهمّ

74
00:06:30,360 --> 00:06:32,570
.فهمت... أنت قويّ

75
00:06:34,960 --> 00:06:36,330
!من الأفضل أن أصل في الوقت

76
00:06:36,980 --> 00:06:39,290
!لا تذهبي بعد يا نيكو روبين

77
00:06:41,340 --> 00:06:42,900
!تبدين في غاية الغباء

78
00:06:43,910 --> 00:06:47,230
هذا بسبب مقاومتك العقيمة
!أيّتها المرأة الغبيّة

79
00:06:48,950 --> 00:06:50,170
!هيّا، قفي

80
00:06:51,140 --> 00:06:52,880
!قلت لك قفي

81
00:06:54,410 --> 00:06:59,180
،يا إلهي، البوّابة أمامنا مباشرة
!ومع ذلك تسبّبين لي المشاكل

82
00:07:07,490 --> 00:07:09,240
!أيّها الحرس! اخرجوا

83
00:07:09,240 --> 00:07:10,240
!حاضر

84
00:07:17,520 --> 00:07:19,250
،احرسوا بوّابات العدالة

85
00:07:19,250 --> 00:07:22,420
ورجال البحريّة في السّفينة المرافقة
!الّتي أرسلها المقرّ الرّئيسيّ

86
00:07:23,500 --> 00:07:27,950
،يصطحب رئيس سايفر بول رقم 9
سباندام، مجرمة بالغة الأهمّيّة حاليًّا

87
00:07:27,950 --> 00:07:33,840
.عبر الجسر من برج القانون

88
00:07:34,450 --> 00:07:36,900
!اصطفّوا جميعًا وألقوا التّحيّة

89
00:07:36,900 --> 00:07:38,520
!حاضر

90
00:07:47,370 --> 00:07:50,260
.انظري. جميعهم جاهزون ليشدّوا الرّحال

91
00:07:50,260 --> 00:07:53,110
.ما عاد هنالك أيّ شيء الآن ليعترض طريقنا

92
00:07:57,610 --> 00:07:59,450
.صحيح يا نيكو روبين

93
00:07:59,450 --> 00:08:03,040
.سأخبرك بسرّ صغير

94
00:08:03,810 --> 00:08:06,300
قبل عبورنا للجسر، شغّلت اللُّغم

95
00:08:06,300 --> 00:08:09,780
الموجود في الجزء العلويّ
.للدّرج الّذي صعدناه للتّوّ

96
00:08:09,780 --> 00:08:14,310
إن حاول شخص ما مثلاً
،المجيء إلى هنا

97
00:08:14,310 --> 00:08:19,720
!فإنّ الدّرج سينفجر وإيّاه

98
00:08:20,210 --> 00:08:22,340
ما رأيك؟ أليس هذا ممتعًا؟

99
00:08:22,340 --> 00:08:25,620
،لكن لا داعي للقلق

100
00:08:25,620 --> 00:08:28,530
بما أنّ لا أحد سيصل لذلك
.الدّرج من الأساس

101
00:08:33,110 --> 00:08:36,320
...لكنّني لن أعبر... البوّابة

102
00:08:47,040 --> 00:08:49,590
.لأنّهم وعدوا أن ينقذوني

103
00:08:49,590 --> 00:08:52,630
!لن يأتي أيّ أحد أيّتها المرأة الغبيّة

104
00:08:53,220 --> 00:08:57,720
سيحترق الجميع حتّى الموت
!في نيران "نداء الدّمار" المستعرة

105
00:08:59,180 --> 00:09:06,480
سيمحو ذلك حتّى الإهانة المذلّة لحقيقة
!حرق القراصنة لعلمنا المقدّس

106
00:09:07,740 --> 00:09:13,240
تمامًا كما حدث في أوهارا قبل عشرين سنة
.عندما هاجمَنا ذلك العملاق من البحريّة

107
00:09:14,830 --> 00:09:16,380
!والآن سيري

108
00:09:17,070 --> 00:09:19,450
!سيري على قدميك

109
00:09:20,020 --> 00:09:21,030
...ساول

110
00:09:23,360 --> 00:09:24,200
!حقيرة

111
00:09:26,600 --> 00:09:28,630
!أيّها الرّئيس! أسرع رجاءً

112
00:09:28,630 --> 00:09:32,130
!أعلم ذلك! اخرس! أنا بطل

113
00:09:32,630 --> 00:09:36,090
على الأرجح أنّك تعتقدين
أنّني أجهل الأمر برمّته، صحيح؟

114
00:09:36,600 --> 00:09:41,180
سوء سلوك جاغوار د. ساول في عمله
!كنائب أميرال سابق في المقرّ الرّئيسيّ

115
00:09:41,180 --> 00:09:47,140
...أمّك أولفيا... وما حدث في أوهارا وقتها

116
00:09:47,580 --> 00:09:49,580
!أعرف كلّ شيء

117
00:09:50,950 --> 00:09:52,960
ولماذا ذلك في رأيك؟

118
00:09:52,960 --> 00:09:54,630
.هذا لأنّ هنالك من أخبرني بالأمر

119
00:09:54,630 --> 00:09:59,950
إنّ من أمر بتنفيذ الغارة
،على بلاد أوهارا وشياطينها

120
00:09:59,950 --> 00:10:04,950
وكشف عن جرائمهم الفظيعة وأمر بتنفيذ
نداء الدّمار" كان رئيس سي بي 9 حينها"

121
00:10:04,950 --> 00:10:08,540
!ألا وهو أبي، الرّئيس سبانداين

122
00:10:14,180 --> 00:10:16,980
!والآن يا علماء أوهارا

123
00:10:16,980 --> 00:10:20,550
!تقرّر الآن الحكم بإعدامكم

124
00:10:22,800 --> 00:10:23,560
!اقضوا عليه

125
00:10:33,520 --> 00:10:35,900
!أيّها الأستاذ

126
00:10:39,000 --> 00:10:40,360
...إنّ أوهارا

127
00:10:43,750 --> 00:10:45,830
.تعرف أكثر ممّا يجب

128
00:10:46,260 --> 00:10:47,870
!"سأطلق "نداء الدّمار

129
00:10:48,580 --> 00:10:49,920
.اهتمّوا بالباقي

130
00:10:59,540 --> 00:11:01,930
!هيّا خذها يا ساول

131
00:11:04,720 --> 00:11:06,250
هل أنت واثقة من هذا؟

132
00:11:06,250 --> 00:11:06,960
.نعم

133
00:11:07,860 --> 00:11:11,410
!كلاّ! سأبقى هنا أيضًا! أمّي

134
00:11:11,410 --> 00:11:14,080
!أمّي

135
00:11:14,080 --> 00:11:16,880
.كم سعدت بسماعك تناديني بذلك

136
00:11:17,610 --> 00:11:18,940
!شكرًا لك

137
00:11:19,700 --> 00:11:22,540
...من الآن فصاعدًا، من أجل كلتينا

138
00:11:22,540 --> 00:11:24,070
!عيشي يا روبين

139
00:11:32,400 --> 00:11:37,960
ظنّوا جميعًا أنّ كلّ من في
...أوهارا مات حينها، لكن

140
00:11:37,960 --> 00:11:41,680
غفلت الحكومة عن شقيّة واحدة
.تمكّنت من الهرب

141
00:11:43,310 --> 00:11:44,340
كيف حدث ذلك؟

142
00:11:44,820 --> 00:11:48,010
من يدري كم مرّة كادت تُقتل هذه
الشّقيّة ذات الثّمانية ربيع

143
00:11:48,010 --> 00:11:50,350
على يد بالغين يسعون للمال؟

144
00:11:53,100 --> 00:11:56,190
.ما كان بمقدورك أن تثقي بأيّ أحد يتقرّب منك

145
00:11:56,190 --> 00:12:00,320
لم يكن لديك أيّ مكان لتنامي فيه
.بأمن وسلام. لم تملكي طعامًا أيضًا

146
00:12:01,090 --> 00:12:05,870
لا أريد حتّى تخيّل كم كانت السّنوات
.العشرين الأخيرة فظيعة بالنّسبة لك

147
00:12:08,250 --> 00:12:10,210
إذًا فقد كنتِ تعيسة جدًّا
لدرجة دفعتك للبكاء؟

148
00:12:10,210 --> 00:12:14,830
إنّ الشّخص الّذي وضع مكافأة
...على رأسك قبل عشرين سنة

149
00:12:15,240 --> 00:12:16,640
!كان أبي

150
00:12:17,680 --> 00:12:19,420
!فعل ذلك لأجل سلام العالم

151
00:12:23,340 --> 00:12:29,520
...والآن، بعد عشرين سنة
،يطارد ابنه النّاجية الوحيدة

152
00:12:29,520 --> 00:12:32,430
.وتنتهي بذلك معركة أوهارا

153
00:12:33,680 --> 00:12:36,190
!خسرت أوهارا

154
00:12:38,590 --> 00:12:41,740
!روبين! كوني فخورة يا روبين

155
00:12:43,080 --> 00:12:46,740
!أمّك أمرأة مشرِّفة! أوهارا مشرِّفة

156
00:12:46,740 --> 00:12:51,430
عليك يومًا ما، أن تمرّري تاريخ
!هذه الجزيرة يا روبين

157
00:12:51,430 --> 00:12:55,060
!قاتلت أوهارا ضدّ العالم

158
00:13:07,650 --> 00:13:09,760
!ليس وأنا لا أزال حيّة

159
00:13:09,760 --> 00:13:14,050
!لكنّ موتك وشيك، صحيح؟! أجيبيني

160
00:13:24,110 --> 00:13:24,900
!ما هذا؟

161
00:13:30,950 --> 00:13:34,450
!كا-كاتي فلام! ما الّذي يفعله هنا؟

162
00:13:34,920 --> 00:13:37,780
!لكن لا بأس. وقع في الفخّ
!يا له من غبيّ

163
00:13:37,780 --> 00:13:39,930
!وقع ذلك الغبيّ ضحيّة اللُّغم

164
00:13:42,220 --> 00:13:44,130
!أتى لإنقاذي

165
00:13:44,130 --> 00:13:47,800
.يا ويحي. هذا ليس جيّدًا
.من الجيّد أنّني أخذتُ احتياطاتي

166
00:13:49,060 --> 00:13:50,420
!علينا الإسراع! هيّا

167
00:13:52,470 --> 00:13:54,390
...حتّى كلماتي تخونني

168
00:13:54,730 --> 00:13:58,350
!ابدؤوا الإبحار يا رجال
!سأقفز على متن السّفينة

169
00:13:58,350 --> 00:14:00,400
!حا-حاضر! عُلم

170
00:14:00,400 --> 00:14:01,820
!سنشدّ الرّحال

171
00:14:01,820 --> 00:14:02,480
!حاضر

172
00:14:03,390 --> 00:14:06,440
لكنّي غاضبة لدرجة أنّني
!لا أستطيع إيقاف دموعي

173
00:14:11,030 --> 00:14:12,540
!شاهدوا جيّدًا

174
00:14:12,540 --> 00:14:17,790
هذه هي خطوة البطل الأولى
...الّتي ستُحفر في التّاريـ

175
00:14:43,830 --> 00:14:45,340
!شاهدوا جيّدًا

176
00:14:45,340 --> 00:14:50,700
هذه هي خطوة البطل الأولى
...الّتي ستُحفر في التّاريـ

177
00:14:52,370 --> 00:14:55,790
!كم هذا مؤلم

178
00:14:57,470 --> 00:14:59,500
!هل أنت بخير أيّها الرّئيس؟

179
00:15:00,120 --> 00:15:01,960
!ما كان ذلك؟! من الفاعل؟

180
00:15:01,960 --> 00:15:03,480
!لا أحد على الجسر

181
00:15:03,480 --> 00:15:07,210
لا بدّ من وجوده! لا بدّ
!أنّه مختبئ في مكان ما! جدوه

182
00:15:07,790 --> 00:15:09,270
!أين هو؟

183
00:15:19,130 --> 00:15:23,370
!أنتم! ما الّذي تفعلونه؟
!لماذا لا تهاجمون؟

184
00:15:23,370 --> 00:15:26,230
!لكن يا رئيس، لا يمكننا العثور على العدوّ

185
00:15:28,550 --> 00:15:30,820
!لحظة! إنّه هناك

186
00:15:46,130 --> 00:15:48,210
!اهربي بكلّ ما لديك من قوّة

187
00:15:48,210 --> 00:15:52,920
!ستموتين إن بقيت على هذه الجزيرة
!أبحري باستعمال طوفي

188
00:15:52,920 --> 00:15:53,760
ماذا عنك يا ساول؟

189
00:15:54,250 --> 00:15:58,130
.هذه هي نهايتي. لقد قُبض عليّ

190
00:15:58,900 --> 00:15:59,600
!اذهبي

191
00:15:59,600 --> 00:16:02,230
!كلاّ! لا ينتظرني أحد في البحر

192
00:16:02,230 --> 00:16:04,640
!أصغي إليّ يا روبين

193
00:16:05,440 --> 00:16:10,530
أنت وحيدة الآن، لكنّك ستقابلين
!أصدقاء يومًا ما بكلّ تأكيد

194
00:16:14,320 --> 00:16:15,200
أصدقاء؟

195
00:16:15,200 --> 00:16:19,940
...نعم. البحر واسع، ويومًا ما بكلّ تأكيد

196
00:16:21,120 --> 00:16:24,170
!ستقابلين أصدقاء سيحمونك

197
00:16:24,420 --> 00:16:29,490
!لم يولد أحد في هذا العالم ليكون وحيدًا

198
00:16:32,330 --> 00:16:34,300
!اهربي يا روبين! لا تنظري خلفك

199
00:16:34,300 --> 00:16:40,160
،إن واجهت وقتًا عصيبًا
!اضحكي كما علّمتك تمامًا

200
00:16:40,160 --> 00:16:41,390
!انتبه يا ساول

201
00:16:44,860 --> 00:16:46,060
.وقت الجليد

202
00:16:48,360 --> 00:16:49,610
!ساول

203
00:16:51,160 --> 00:16:54,930
اذهبي وقابلي أصدقاء أنا واثق أنّهم بانتظارك

204
00:16:54,930 --> 00:16:57,030
!في مكان ما من البحر يا روبين

205
00:16:59,840 --> 00:17:03,120
.عيشي معهم

206
00:17:16,010 --> 00:17:17,340
!انظر هناك يا رئيس

207
00:17:17,340 --> 00:17:20,200
!ماذا؟! أين تقصد؟

208
00:17:25,350 --> 00:17:28,190
!...فوق برج القانون

209
00:17:28,190 --> 00:17:33,030
برج القانون؟! ماذا بإمكانه فعله
!من تلك المسافة؟

210
00:17:38,280 --> 00:17:39,950
!أجل

211
00:17:39,950 --> 00:17:41,990
!من يكون ذاك؟

212
00:17:42,700 --> 00:17:47,500
إنّه يصوّب نحونا من تلك المسافة دون
!أيّ هامش للخطأ رغم هذه الرّياح؟

213
00:17:43,790 --> 00:17:47,500
♪ ...ولدت في ♪

214
00:17:47,500 --> 00:17:49,000
!من يكون؟

215
00:17:47,500 --> 00:17:50,020
♪ جزيرة القنّاصين ♪

216
00:17:50,020 --> 00:17:51,460
!طويل الأنف

217
00:17:51,950 --> 00:17:55,910
!أرأيتم؟! قنّاصنا مذهل، صحيح؟

218
00:17:57,160 --> 00:17:59,720
♪ ...أو حتّى قلبك ♪

219
00:17:57,160 --> 00:17:59,720
!نالوا ما استحقّوه بالفعل

220
00:17:59,720 --> 00:18:00,750
!اهربي يا روبين-تشان

221
00:18:00,750 --> 00:18:02,530
♪ !تصويب ♪

222
00:18:02,530 --> 00:18:04,310
هل عليه أن يغنّي بالفعل؟

223
00:18:04,310 --> 00:18:06,890
!كيف تجرؤ؟

224
00:18:09,530 --> 00:18:10,690
!أيّها الرّئيس

225
00:18:14,030 --> 00:18:18,800
!سُحقًا! ما الّذي تفعلونه؟
!أردوه قتيلاً في الحال

226
00:18:18,800 --> 00:18:23,700
إنّنا نحاول، لكنّ مدى رصاصاتنا لا يصل
!لذلك البعد، ناهيك عن إصابته

227
00:18:23,700 --> 00:18:26,660
!لذلك القنّاص مهارات لا تصدّق

228
00:18:27,540 --> 00:18:29,040
!لاذت نيكو روبين  بالفرار

229
00:18:29,420 --> 00:18:32,280
!لا تسمحوا لها بالهرب
!يمكنكم الإطلاق عليها يا أغبياء

230
00:18:32,280 --> 00:18:33,300
!حاضر

231
00:18:33,300 --> 00:18:35,470
!أردوها قتيلة بما يكفي لتبقى حيّة

232
00:18:35,470 --> 00:18:36,130
!كيف؟

233
00:18:50,150 --> 00:18:51,310
!أطلقوا

234
00:19:28,490 --> 00:19:30,640
!ما هذا الشّخص؟

235
00:19:31,330 --> 00:19:32,650
...أنت

236
00:19:34,970 --> 00:19:37,570
.جسدي قويّ لأنّه مصنوع من الحديد

237
00:19:38,420 --> 00:19:40,110
!لم يرق لي ذلك اللُّغم يا سباندا

238
00:19:41,730 --> 00:19:46,580
.يا فرانكي-كُن، فرانكي-كُن
.معك سوغيكينغ

239
00:19:46,580 --> 00:19:49,550
...ماذا؟ يفترض أنّ حلزون الاتّصال هذا

240
00:19:49,550 --> 00:19:51,410
.حصلت عليه من نامي

241
00:19:51,810 --> 00:19:55,910
الأهمّ الآن هو أنّك ستجد قماشة
.حمراء على الأرض قربك

242
00:19:55,910 --> 00:19:57,380
قماشة حمراء؟

243
00:19:57,380 --> 00:19:58,710
!نعم، أراها

244
00:19:59,060 --> 00:20:00,970
.ستجد مفتاحين فيها

245
00:20:00,970 --> 00:20:03,680
وبهذا ستكون كلّ المفاتيح معك
.إضافة للّتي بحوزتك سلفًا

246
00:20:04,820 --> 00:20:06,640
!كلّ المفاتيح؟

247
00:20:08,410 --> 00:20:10,350
.سلّمتها لك بكلّ تأكيد

248
00:20:11,500 --> 00:20:12,770
.تمّت المهمّة

249
00:20:13,780 --> 00:20:16,020
.لنسرع. هذا سيّئ

250
00:20:16,400 --> 00:20:17,660
...الرّقم 1

251
00:20:17,660 --> 00:20:19,110
...الرّقم 3

252
00:20:19,110 --> 00:20:20,740
!الرّقم 4... لا يعمل

253
00:20:20,740 --> 00:20:21,630
!الرّقم 5

254
00:20:23,680 --> 00:20:24,660
!أزلتها

255
00:20:29,820 --> 00:20:32,500
!مستحيل! إ-إنّها المفاتيح الحقيقيّة؟

256
00:20:34,660 --> 00:20:36,710
!مهلاً، مهلاً... تمالكي نفسك

257
00:20:36,710 --> 00:20:39,100
...لا يعقل... هذا يعني

258
00:20:39,100 --> 00:20:46,140
كلاّ! هل تمكّنتم من هزيمة
!السّي بي 9 في برج القانون؟

259
00:20:53,980 --> 00:20:55,790
!لا، ذلك غير معقول

260
00:20:55,790 --> 00:20:59,440
!لا بدّ أنّكم سرقتموها وهربتم! اللّعنة

261
00:21:00,180 --> 00:21:03,030
!هذا فرانكي! أتسمعني يا طويل الأنف؟

262
00:21:03,650 --> 00:21:06,030
.أزلت أصفاد نيكو روبين

263
00:21:06,030 --> 00:21:07,530
!ممتاز

264
00:21:07,910 --> 00:21:10,080
!شكرًا لك يا طويل الأنف

265
00:21:10,580 --> 00:21:15,670
يمكنك أن تشكري من قاتلوا ببسالة
.لجمع المفاتيح في نهاية كلّ هذا

266
00:21:16,590 --> 00:21:20,770
أنت وبلا أدنى شكّ عضوة
!في طاقم لوفي-كُن

267
00:21:20,770 --> 00:21:23,510
!يمكنك الآن فعل ما يحلو لك

268
00:21:24,890 --> 00:21:25,680
.نعم

269
00:21:28,550 --> 00:21:30,350
!ستّ زهرات

270
00:21:31,350 --> 00:21:32,810
!مهلاً! ما هذا؟

271
00:21:33,180 --> 00:21:34,430
!صفع

272
00:21:43,540 --> 00:21:45,820
.سأقوم بهذا حتىّ يُشفى غليلي

273
00:21:59,750 --> 00:22:01,360
!أيّها الرّئيس

274
00:22:01,360 --> 00:22:04,760
!حسنًا يا رفاق! أسرعوا بالمجيء إلى هنا

275
00:22:04,760 --> 00:22:07,220
!سأجهّز الأمور لهروبنا

276
00:22:07,220 --> 00:22:08,970
!عُلم

277
00:22:09,890 --> 00:22:11,930
!انزل بسرعة يا سوغيكينغ

278
00:22:12,310 --> 00:22:15,860
هذا سيّئ! أزيلت أصفاد الحجر
!البحريّ من معصمَيْ المجرمة

279
00:22:15,860 --> 00:22:17,560
!اقبضوا عليها ثانية

280
00:22:20,180 --> 00:22:23,020
.سار كلّ شيء حسب خطّتي

281
00:22:26,450 --> 00:22:27,200
ما هذا؟

282
00:22:30,720 --> 00:22:32,790
هل سمعتُ شيئًا ما للتّوّ؟

283
00:22:45,240 --> 00:22:47,500
.لا أهتمّ إن تداعى جسدي

284
00:22:47,500 --> 00:22:49,720
!سأفعل ما أستطيع فعله

285
00:22:49,720 --> 00:22:51,180
.هذا ليس تصرّفًا ذكيًّا

286
00:22:51,660 --> 00:22:55,810
تقنيتك تلك تقلّل من عمرك، أتعلم ذلك؟

287
00:22:55,810 --> 00:22:58,480
!أنت طموح أكثر من اللاّزم

288
00:22:59,270 --> 00:23:00,480
:في الحلقة القادمة من وان بيس

289
00:23:00,480 --> 00:23:04,480
،روبين حرّة! لوفي ضدّ لوتشي"
"!نزال بين القائدين

290
00:23:04,480 --> 00:23:07,010
!ملك القراصنة، لن يكون إلاّ أنا

291
00:23:10,030 --> 00:23:15,040
نلقاكم في الحلقة القادمة