1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,910 --> 00:02:01,990
.تفرّق أعضاء الأكازايا الّذين فقدوا أودن

29
00:02:02,540 --> 00:02:05,490
!غادروا... نحو المستقبل

30
00:02:18,670 --> 00:02:22,010
!يا أميرتي! هذه رقصة الكابّا

31
00:02:35,660 --> 00:02:40,690
.ثمّ تلقّى أوروتشي رسالة بعد عشرين سنة

32
00:02:40,900 --> 00:02:44,990
!أتوا من الماضي قبل عشرين سنة

33
00:02:47,540 --> 00:02:52,370
.على أيّ حال، جاسوسك كفؤ للغاية

34
00:02:52,370 --> 00:02:57,540
...اسمع، إنّه رجل جدير بالثّقة

35
00:02:57,540 --> 00:03:02,550
.هذا صحيح. قتلتُ أولئك الّذين ذبحوا أبويك

36
00:03:04,190 --> 00:03:07,440
!لكنّ انتقامنا بدأ للتّوّ

37
00:03:07,440 --> 00:03:10,300
،عش حياتك كتابع حقيقيّ لكوزكي

38
00:03:10,480 --> 00:03:15,770
!ومت كتابع لكوزكي دون أن يعرف أيّ أحد

39
00:03:31,670 --> 00:03:36,500
"!البحر للقراصنة! الغارة على أونيغاشيما"

40
00:03:40,880 --> 00:03:43,210
...تحتشد العديد من القوّات للغارة

41
00:03:43,210 --> 00:03:47,470
عند شفق اليوم، يوم مهرجان النّار
.في ميناء توكاغي

42
00:03:47,470 --> 00:03:49,550
!الوجهة هي أونيغاشيما

43
00:03:49,550 --> 00:03:50,680
...قادمون يا كايدو

44
00:03:54,110 --> 00:03:56,450
!لنوسعك ضربًا

45
00:03:56,450 --> 00:03:57,850
!أجل

46
00:04:01,620 --> 00:04:03,820
...هكذا كان يفترض أن يسير الأمر

47
00:04:15,700 --> 00:04:17,750
!لا توجد ولو سفينة واحدة في مرمى البصر

48
00:04:18,760 --> 00:04:21,080
!أين هم الجنود الأربعة آلاف؟

49
00:04:21,080 --> 00:04:24,170
!يبدو أنّ هذا الميناء قد تعرّض للهجوم

50
00:04:24,600 --> 00:04:28,340
!عند شفق يوم مهرجان النّار في ميناء توكاغي

51
00:04:29,860 --> 00:04:33,050
!هذا هو ميناء اللّقاء

52
00:04:33,050 --> 00:04:37,140
!لماذا لم يحضر أيّ أحد؟! أين ذهبوا؟

53
00:04:37,140 --> 00:04:39,980
!لوفي-دونو، أين أنت؟

54
00:04:39,980 --> 00:04:42,350
!هيوغورو-دونو، أجب رجاءً

55
00:04:47,210 --> 00:04:49,360
!يا فرسان إينواراشي

56
00:04:49,360 --> 00:04:52,030
!لو-دونو! جيبويمون من كيبي

57
00:04:52,030 --> 00:04:55,990
!نحن أتباع كوزكي أودن

58
00:04:56,240 --> 00:04:59,060
...من عشرين سنة مضت

59
00:05:01,640 --> 00:05:07,420
!أتينا من الماضي قبل عشرين سنة للثّأر لسيّدنا

60
00:05:07,420 --> 00:05:10,720
!كان يجب أن نموت وقتها

61
00:05:10,720 --> 00:05:13,220
!لذلك أتينا لنموت من أجل سبب وجيه

62
00:05:15,950 --> 00:05:17,680
،ولكن

63
00:05:17,680 --> 00:05:20,520
!يتطلّب الأمر أكثر من أرواحنا نحن

64
00:05:20,520 --> 00:05:23,900
!يملك العدوّ ثلاثين ألف جنديّ! نحتاج للعون

65
00:05:23,900 --> 00:05:28,610
!ليجبني أحد ما! إنّنا نستنجدكم رجاءً

66
00:05:26,560 --> 00:05:28,610
!يكفي يا كينييمون

67
00:05:28,610 --> 00:05:31,840
!انظر إلى البحر والسّماء

68
00:05:32,240 --> 00:05:35,660
!حتّى السّماوات قد تخلّت عنّا

69
00:05:35,660 --> 00:05:38,120
!ما من عون سيأتينا

70
00:05:45,080 --> 00:05:48,840
!منظر بلاد وانو بديع

71
00:05:49,050 --> 00:05:50,250
!خذ هذه

72
00:05:53,070 --> 00:05:56,090
!اليد اليمنى القويّة

73
00:06:05,450 --> 00:06:07,270
إنما إذًا؟

74
00:06:07,270 --> 00:06:09,520
،بمجرّد أن أعتاد عليه

75
00:06:10,040 --> 00:06:14,490
فسأغدو أقوى بكثير، صحيح؟

76
00:06:14,490 --> 00:06:19,620
!نحن هنا للفوز ضدّ كايدو

77
00:06:20,840 --> 00:06:25,770
!لا نحتاج لحلفاء يقفون في طريقنا

78
00:06:25,770 --> 00:06:28,520
!أنا أعتمد عليكم

79
00:06:28,520 --> 00:06:31,880
!صحيح، دع الأمر لنا

80
00:06:31,880 --> 00:06:33,760
!أراكم في الميناء إذًا

81
00:06:34,320 --> 00:06:35,510
!نعم

82
00:06:35,510 --> 00:06:37,510
!توقّفوا جميعًا

83
00:06:37,510 --> 00:06:40,810
!إنّ أخذ ذلك القارب الصّغير أشبه بالانتحار

84
00:06:42,070 --> 00:06:45,310
...إن فوّتنا هذه الفرصة

85
00:06:45,310 --> 00:06:48,100
.سيكون علينا انتظار سنة كاملة

86
00:06:49,440 --> 00:06:55,990
.لكن لا يمكننا الاختباء أكثر
.سيكتشفون أنّنا سيطرنا على أودون قريبًا

87
00:06:56,420 --> 00:07:02,140
.سيأتي جيش كايدو بأكمله لمطاردة المتمرّدين

88
00:07:04,750 --> 00:07:06,000
!لا تذهبوا

89
00:07:06,810 --> 00:07:09,380
!أمنعكم من الذّهاب

90
00:07:10,270 --> 00:07:12,710
!كينييمون! أشورا

91
00:07:12,710 --> 00:07:15,590
!كانجورو! رايزو! كيكو

92
00:07:15,590 --> 00:07:17,090
!كاواماتسو

93
00:07:17,090 --> 00:07:19,680
!إينواراشي

94
00:07:20,490 --> 00:07:25,770
،لا أحد من الرّجال الـ4200 قد أتى

95
00:07:25,770 --> 00:07:29,690
...وكانت هنالك علامات دمار في الميناء

96
00:07:29,690 --> 00:07:33,650
!الجوّ هائج ولا يوجد مهرب

97
00:07:35,530 --> 00:07:38,880
!مهلاً! هل ستستسلمون بعد كلّ هذا؟

98
00:07:38,880 --> 00:07:40,030
!يا رفاق

99
00:07:41,130 --> 00:07:45,120
!هذا ليس استسلامًا يا مومونوسكي-ساما

100
00:07:46,930 --> 00:07:50,210
،سنتمكّن من التّسلّل بما أنّنا فريق صغير

101
00:07:50,210 --> 00:07:55,110
وسنضع سيفًا على عنق كايدو
!قبل أن يدرك أيّ أحد ذلك

102
00:07:57,070 --> 00:08:01,450
!لن نستسلم ما دمنا أحياء نرزق

103
00:08:09,870 --> 00:08:12,060
!ثمّة خطب ما

104
00:08:18,290 --> 00:08:22,530
!هذا يعني أنّ خطّتنا قد سُرّبت ثانية

105
00:08:31,310 --> 00:08:36,210
!لماذا هم على أهبة الاستعداد هكذا؟
!كيف عرفوا أنّنا قادمون؟

106
00:08:39,090 --> 00:08:44,010
.ربّما يوجد جاسوس في قلعتك

107
00:08:46,430 --> 00:08:52,090
كنتُ... أعني أنّ الجميع كانوا
!يفكّرون في نفس الأمر

108
00:08:54,790 --> 00:08:57,440
...لم أرغب في التّفكير في ذلك

109
00:09:01,500 --> 00:09:06,020
!لكن يوجد جاسوس بيننا على الأرجح

110
00:09:08,050 --> 00:09:11,040
!ولأصدقكم القول، لا أريد أن أعرف الآن

111
00:09:11,870 --> 00:09:15,080
!كين-ساما! هذا ليس من شيمك

112
00:09:15,080 --> 00:09:19,090
!علينا العثور على الجاسوس والتّخلّص منه قبل التّحرّك

113
00:09:19,090 --> 00:09:21,760
!وإلاّ، لا يمكننا التّقدّم

114
00:09:30,990 --> 00:09:33,870
!من المستحيل أن يعترف

115
00:09:33,870 --> 00:09:40,860
لطالما أخذت فكرة وجود جاسوس بيننا
.حيّزًا من تفكيري، لكنّني غضضت النّظر

116
00:09:40,860 --> 00:09:42,820
!هذا ثمن علينا دفعه

117
00:09:42,820 --> 00:09:46,450
منذ متى كان هذا الشّخص يخوننا؟

118
00:09:46,450 --> 00:09:47,370
!ولماذا؟

119
00:09:55,520 --> 00:09:58,960
!مهلاً! لا يجب أن نشكّ في بعضنا الآن

120
00:09:59,340 --> 00:10:05,300
إن دخل الارتياب بيننا وبدأنا في قتال
!بعضنا، فسنخدم أعداءنا بذلك لا غير

121
00:10:06,440 --> 00:10:11,500
،لكن إن سمحنا لذلك الشّخص أن يعيش
!فسنفقد فرصتنا الضّئيلة بالفوز فعلاً

122
00:10:12,410 --> 00:10:13,600
...إضافة لذلك

123
00:10:14,620 --> 00:10:17,360
...فقد خان هذا الشّخص أودن-ساما

124
00:10:17,360 --> 00:10:19,230
!لا يمكنني السّماح بذلك

125
00:10:20,460 --> 00:10:23,070
!أوافق كيكو الرّأي يا كين

126
00:10:31,300 --> 00:10:37,780
.جمع بيننا خبز وملح وتشاركنا نفس المصاعب

127
00:10:38,770 --> 00:10:41,090
...حتّى إن وُجد جاسوس

128
00:10:41,690 --> 00:10:44,550
!فلا بدّ أنّ له عُذرًا قاهرًا

129
00:10:46,690 --> 00:10:49,930
ربّما قام كايدو وأوروتشي بابتزازه؟

130
00:10:50,610 --> 00:10:54,730
!لا بدّ أنّ ذلك الشّخص قد ذاق الأمرّين

131
00:10:54,730 --> 00:10:58,310
...آسف لأنّني لم ألحظ ذلك

132
00:10:58,310 --> 00:11:03,610
أُجبر أحد رفاقي على التّجسّس
!علينا بسبب عدم كفاءتي

133
00:11:08,070 --> 00:11:10,030
!كيف لك أن تكون بهذه السّذاجة؟

134
00:11:10,030 --> 00:11:15,660
!لولا ذلك الشّخص، لكان أودن-ساما ما زال معنا الآن

135
00:11:16,310 --> 00:11:18,160
...أنا

136
00:11:18,160 --> 00:11:21,630
.لا أريد أن ينشب شجار بيننا

137
00:11:22,060 --> 00:11:23,610
...لكن

138
00:11:25,730 --> 00:11:28,130
!أتفهّم مشاعر كيكو أيضًا

139
00:11:28,130 --> 00:11:30,300
!كين! لنوضّح كلّ شيء

140
00:11:40,620 --> 00:11:42,940
!من خلال الاعتراف أنّه أنا

141
00:11:45,170 --> 00:11:47,390
!كانجورو؟

142
00:11:49,130 --> 00:11:51,240
...كفّ عن المزاح

143
00:11:51,240 --> 00:11:55,160
!كدنا جميعًا أن نموت غليًا

144
00:11:55,510 --> 00:11:56,950
.هذا صحيح

145
00:11:56,950 --> 00:12:01,070
!كان بمقدوري أداء دوري بالموت معكم يا رفاق

146
00:12:01,680 --> 00:12:04,340
...كواحد من الأكازايا التّسعة

147
00:12:04,340 --> 00:12:08,260
...وابل المساء كانجورو الّذي أقسم بالولاء لأودن

148
00:12:08,260 --> 00:12:11,590
!لم يكن لذلك الرّجل أيّ وجود

149
00:12:24,580 --> 00:12:30,700
تشاركت أفراحًا وأحزانًا معكم كلّ
...يوم واكتسبت ثقتكم المطلقة

150
00:12:30,700 --> 00:12:34,410
.لم أكره أيّ أحد ولم أقصد إيذاءكم

151
00:12:34,660 --> 00:12:40,370
...واصلت إرسال المعلومات لأوروتشي-ساما فحسب

152
00:12:41,140 --> 00:12:44,920
إذًا فأنت تقول أنّ كلّ شيء كان كذبة من البداية؟

153
00:12:44,920 --> 00:12:46,500
!لماذا قد تفعل ذلك؟

154
00:12:48,710 --> 00:12:55,160
تعرّضت للاضطهاد مذ كنت طفلاً
...وقُتل والداي أمام عينيّ

155
00:12:58,660 --> 00:13:05,190
ومذّاك الحين، تمكّنت من العيش فقط
.عن طريق لعب دور شخص آخر عداي

156
00:13:06,580 --> 00:13:12,360
.لأنّني أنا نفسي لم أستطع الإحساس أو التّفكير بأيّ شيء

157
00:13:13,320 --> 00:13:16,080
...وابل المساء كانجورو

158
00:13:16,080 --> 00:13:20,370
.ما ذاك إلاّ دور أعطانيه أوروتشي-ساما

159
00:13:21,220 --> 00:13:24,210
...اسمي الحقيقيّ

160
00:13:25,350 --> 00:13:27,800
!كوروزومي كانجورو

161
00:13:29,150 --> 00:13:31,670
أليس ذلك سببًا كافيًا؟

162
00:13:33,190 --> 00:13:36,100
...سُرّبت الخطّة الأولى

163
00:13:36,100 --> 00:13:40,370
...ليس لأنّ رجال لو قد أفشوا بها

164
00:13:40,870 --> 00:13:43,560
.بل كنتُ أنا من أعلمهم بها

165
00:13:44,370 --> 00:13:51,150
قام ياسويي بتغطية الأمر بشكل جميل
.وغيّر مكان اللّقاء مقابل حياته

166
00:13:51,150 --> 00:13:53,150
...كان ذلك مثيرًا للإعجاب

167
00:13:53,360 --> 00:13:56,850
.أعطيتهم مكان اللّقاء الجديد

168
00:13:58,340 --> 00:14:04,010
هذا ليس بالكثير، لكنّ ذلك هو كلّ
!ما يمكنني فعله بحياتي

169
00:14:04,010 --> 00:14:09,750
،لكن بمجرّد أن وصلتني الرّسالة
.صار موته بلا معنى

170
00:14:16,070 --> 00:14:21,390
عندما ظهر جاك في زو حيث لا يستطيع
،أيّ أحد العثور عليها بدون فيفر كارد

171
00:14:21,910 --> 00:14:25,390
كنت تتساءل عن السّبب، صحيح يا إينواراشي؟

172
00:14:26,520 --> 00:14:30,480
!هذا صحيح! أنا أعطيته إيّاها

173
00:14:30,480 --> 00:14:35,820
وقد سرّبت كلّ شيء عن الخطّة الأخيرة
!لأوروتشي-ساما أيضًا

174
00:14:35,820 --> 00:14:37,160
!قم بذلك

175
00:14:37,370 --> 00:14:38,740
!عُلم

176
00:14:48,140 --> 00:14:52,380
...أظنّ أنّ أوروتشي-ساما قد دمّر وأغلق

177
00:14:52,380 --> 00:14:55,090
.كلّ الطّرقات المؤدّية إلى ميناء توكاغي

178
00:14:55,780 --> 00:14:59,550
...إضافة إلى سفينة قراصنة قبّعة القشّ

179
00:15:00,110 --> 00:15:04,310
.لا عجب أنّ أحدًا لم يحضر

180
00:15:24,850 --> 00:15:27,960
!لماذا لم تشكّ في أيّ أحد منّا؟

181
00:15:35,190 --> 00:15:39,260
لماذا لم تشكّ في رجالك قبل حدوث كلّ هذا؟

182
00:15:39,260 --> 00:15:44,720
!علمتَ أنّ هنالك خطبًا ما
!طوال هذا الوقت! حيال كلّ شيء

183
00:16:18,010 --> 00:16:20,090
!كان ذلك صحيحًا

184
00:16:20,090 --> 00:16:25,000
كما قال أوروتشي-ساما، ثمّة مجموعة أشخاص
.كانوا متّجهين إلى أونيغاشيما بقارب

185
00:16:25,740 --> 00:16:27,730
!هذا مضحك للغاية

186
00:16:32,690 --> 00:16:36,420
!لا يمكنني تصديق الأمر
!إنّهم فعلاً أعضاء الأكازايا من الماضي

187
00:16:36,420 --> 00:16:39,150
!وأحدهم هو جاسوسنا

188
00:16:40,590 --> 00:16:42,340
!أهو أنت؟

189
00:16:42,340 --> 00:16:43,570
.نعم، بالفعل

190
00:16:44,170 --> 00:16:46,120
!كانجورو

191
00:17:16,290 --> 00:17:23,740
لراودني شعور رائع كممثّل أن يبتلعني
،البحر معكم دون الكشف عن نفسي

192
00:17:23,740 --> 00:17:27,120
.لكنّ أوروتشي-ساما أوقفني هذه المرّة

193
00:17:27,720 --> 00:17:31,330
."قال لي "أبليت حسنًا. انتهت المسرحيّة

194
00:17:32,100 --> 00:17:33,620
!كانجورو؟

195
00:17:48,240 --> 00:17:49,720
!مومونوسكي-ساما

196
00:17:53,950 --> 00:17:56,730
!قال أوروتشي-ساما هذا أيضًا

197
00:17:56,730 --> 00:18:00,440
"!تعال إلى أونيغاشيما مع مومونوسكي"

198
00:18:01,500 --> 00:18:04,400
!كينييمون

199
00:18:04,400 --> 00:18:06,280
!مومونوسكي-ساما

200
00:18:06,880 --> 00:18:09,020
!كيف وصل كانجورو إلى هناك في الميناء؟

201
00:18:10,790 --> 00:18:12,810
...هذه إذًا

202
00:18:16,080 --> 00:18:17,690
!رسمة؟

203
00:18:20,310 --> 00:18:23,590
...لا يستطيع كانجورو الّذي نعرف رسم هذا

204
00:18:26,010 --> 00:18:30,110
!مومونوسكي بين أيدينا! اقتلوا البقيّة

205
00:18:30,110 --> 00:18:32,220
!أجل

206
00:18:40,080 --> 00:18:41,580
!مومونوسكي-ساما

207
00:18:41,580 --> 00:18:43,500
!كين-سان! لا تتهوّر

208
00:18:43,500 --> 00:18:46,450
،إن سمحت له باختطاف مومونوسكي-ساما

209
00:18:46,450 --> 00:18:49,740
فسأكون في غاية الخجل من رؤية
!أودن-ساما في الحياة الآخرة

210
00:18:50,470 --> 00:18:51,990
...كين-ساما

211
00:18:59,330 --> 00:19:02,420
!يا رفاق! لا وقت لدينا للحديث

212
00:19:08,990 --> 00:19:10,850
!استعيدوا توازننا

213
00:19:10,850 --> 00:19:12,060
!هذه هي

214
00:19:41,140 --> 00:19:43,670
.يا إلهي منكم

215
00:19:43,670 --> 00:19:46,220
!كيف تستطيعان النّوم في ظروف كهذه؟

216
00:19:46,220 --> 00:19:47,340
!يا إلهي

217
00:19:48,440 --> 00:19:50,950
!هل أُصلحت السّفينة؟

218
00:19:54,990 --> 00:19:59,980
،بعد أن آكل وأنام وأستيقظ
!أكون في أقوى حالاتي على الإطلاق

219
00:20:00,450 --> 00:20:01,610
!ماذا؟

220
00:20:01,610 --> 00:20:03,510
!نار

221
00:20:06,500 --> 00:20:07,840
!...غير معقول

222
00:20:07,840 --> 00:20:10,450
!آسف على التّأخير

223
00:20:10,660 --> 00:20:12,030
!من كان ذلك؟

224
00:20:12,030 --> 00:20:15,940
!ظننتُ أنّنا أغرقنا كل ّسفن العدوّ

225
00:20:19,100 --> 00:20:21,330
!كلاّ! سيغرق القارب

226
00:20:24,940 --> 00:20:26,840
!ثمّة شيء ما في الماء

227
00:20:34,970 --> 00:20:39,430
ما مدى حُمقكم يا رفاق لتخرجوا
إلى البحر العاصف في ذلك القارب الصّغير؟

228
00:20:39,430 --> 00:20:41,520
...ماذا؟! أنت

229
00:20:41,520 --> 00:20:44,110
!لا تستخفّوا بالبحر أيّها السّاموراي اللّعناء

230
00:20:44,110 --> 00:20:44,860
!يا رفاق

231
00:20:48,250 --> 00:20:50,360
!هذا صادر من الجهة المعاكسة

232
00:20:50,360 --> 00:20:55,160
رأيت عددًا هائلاً من السّفن والسّاموراي
.يحتشدون في الميناء الآخر

233
00:20:55,160 --> 00:20:56,390
!من يكونون؟

234
00:20:56,390 --> 00:20:58,370
!...إ-إنّه

235
00:21:01,290 --> 00:21:04,540
!كانوا في طريقي، لذلك أردت إغراقهم

236
00:21:14,820 --> 00:21:18,140
!لوفي-دونو! جميعكم بخير؟

237
00:21:27,710 --> 00:21:30,280
!أتيت أيضًا في النّهاية أيّها المسنّن

238
00:21:31,740 --> 00:21:35,570
!يا قبّعة القشّ! لن أسمح لك بأن تحظى برأس كايدو

239
00:21:41,870 --> 00:21:45,420
ما الّذي يحدث هنا؟

240
00:21:58,700 --> 00:22:01,060
!لم أسمع بأيّ شيء من هذا

241
00:22:01,060 --> 00:22:03,730
!لوفي

242
00:22:03,730 --> 00:22:05,650
!هذا ليس ما أُبلغنا به

243
00:22:07,310 --> 00:22:10,940
كلّ ما طُلب منّا فعله هو إغراق
!السّاموراي على متن القارب

244
00:22:12,360 --> 00:22:14,610
!إنّهم قراصنة

245
00:22:16,370 --> 00:22:19,830
إنّهم قراصنة الجيل الأسوأ الّذين
!كان يفترض أن يكونوا في السّجن

246
00:22:19,830 --> 00:22:21,580
!يا هؤلاء

247
00:22:21,580 --> 00:22:24,370
!كيف أمكنكم العبث بقارب السّاموراي؟

248
00:22:28,600 --> 00:22:31,300
!لستُم خبراء بحر، فلا تتهوّروا

249
00:22:37,570 --> 00:22:40,640
!يجب عليكم أن تتراجعوا

250
00:22:47,660 --> 00:22:50,480
!البحر هو ساحة قتال القراصنة

251
00:23:04,500 --> 00:23:10,000
القراصنة الثّلاثة الّذين يهدفون ليصيروا
!غزاة البحر الجدد، لوفي وكيد ولو

252
00:23:15,420 --> 00:23:22,080
معركة شرسة تنشب على بحر
!لا حدود له! لا رادع لهم الآن

253
00:23:22,510 --> 00:23:23,770
:في الحلقة القادمة من وان بيس

254
00:23:23,770 --> 00:23:27,690
!اندفاع الجيل الأسوأ للهجوم"
"!معركة البحر العاصف

255
00:23:27,690 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا