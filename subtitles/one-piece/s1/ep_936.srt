1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,940 --> 00:01:59,570
...عفوًا

29
00:02:00,610 --> 00:02:01,480
نعم؟

30
00:02:01,860 --> 00:02:05,240
!أريد العثور على أخي الكبير

31
00:02:05,240 --> 00:02:08,030
...انفصلنا عن بعضنا منذ 20 سنة

32
00:02:08,320 --> 00:02:11,740
!قد يكون في بلاد وانو الآن

33
00:02:13,200 --> 00:02:15,170
...اسم أخي هو

34
00:02:16,460 --> 00:02:18,380
!كوزكي مومونوسكي

35
00:02:19,790 --> 00:02:21,960
...أنا أخته

36
00:02:24,800 --> 00:02:27,010
!واسمي هيوري

37
00:02:30,390 --> 00:02:34,430
!إدراك الأمر برمّته"
"!هاكي بلاد وانو، ريو

38
00:02:44,780 --> 00:02:45,950
...مومونوسكي

39
00:02:47,660 --> 00:02:48,910
!أنت أخته؟

40
00:02:50,120 --> 00:02:51,160
!هذا ما توقّعت

41
00:02:51,450 --> 00:02:54,290
!أنا سعيدة لأنّني استجمعت شجاعتي وقلتُها

42
00:02:55,120 --> 00:02:57,080
.كانت مجازفة كبيرة

43
00:02:58,460 --> 00:03:00,420
!أنت تعرف أخي، أليس كذلك؟

44
00:03:01,040 --> 00:03:02,840
!وهو بخير، صحيح؟

45
00:03:02,840 --> 00:03:04,710
!مهلاً! اهدئي

46
00:03:05,220 --> 00:03:07,010
.عليّ ترتيب أفكاري

47
00:03:09,010 --> 00:03:12,350
يتحدّث النّاس هذه الأيّام
.عن عودة عشيرة كوزكي

48
00:03:13,010 --> 00:03:18,480
وفي نفس الوقت، يوجد هنا ساموراي
.قويّ ولطيف من خارج البلاد

49
00:03:18,480 --> 00:03:20,610
!لذلك فكّرت أنّه قد يكون حليف أخي

50
00:03:22,230 --> 00:03:25,820
!أم أنّك عدوّ يسعى خلف أخي؟

51
00:03:25,820 --> 00:03:26,950
.أنا حليفه

52
00:03:28,570 --> 00:03:30,240
.أوّلاً وقبل كلّ شيء، أنا حليفه

53
00:03:33,120 --> 00:03:34,700
.أراحني سماع هذا

54
00:03:36,370 --> 00:03:40,000
هل تدري إن كان كينييمون لا يزال حيًّا؟

55
00:03:41,960 --> 00:03:47,090
هل كانجورو ورايزو وكيكونوجو معه جميعًا؟

56
00:03:47,300 --> 00:03:48,630
كيكونوجو؟

57
00:03:50,050 --> 00:03:51,590
تقصدين كيكو؟

58
00:03:51,840 --> 00:03:55,810
.نعم، مهلاً... هنالك أمر يشغلني

59
00:03:56,350 --> 00:03:58,600
هل أنت أخت مومو حقًّا؟

60
00:04:02,270 --> 00:04:03,940
.دعني أشرح الأمر

61
00:04:06,900 --> 00:04:08,440
.فهمت

62
00:04:08,700 --> 00:04:10,450
.معك حقّ

63
00:04:10,450 --> 00:04:14,410
مومو القادم من 20 سنة مضت
،يبدو في الثّامنة من العمر

64
00:04:14,660 --> 00:04:20,160
ويفترض أن تكوني أخته الصّغرى، لكنّك كبرتِ
...هذه السّنوات الـ20 وأنت الآن في الـ26

65
00:04:20,460 --> 00:04:21,080
.نعم

66
00:04:21,670 --> 00:04:22,710
...بالمناسبة

67
00:04:26,800 --> 00:04:29,300
هل من الصّواب أن تستمع لكلّ هذا؟

68
00:04:29,630 --> 00:04:32,470
!لا بأس! لأنّني أعرف سلفًا

69
00:04:36,890 --> 00:04:40,020
!كان ذلك سرًّا بين أختي الكبيرة وأنا

70
00:04:40,180 --> 00:04:44,770
أوتوكو واحدة من الأصدقاء المقرّبين
.الّذين يعرفون هويّتي الحقيقيّة

71
00:04:46,980 --> 00:04:51,150
...إنّ بهجتها تساندني يومًا بعد يوم

72
00:04:51,530 --> 00:04:56,530
...قبل 20 سنة، كنت لا أزال طفلة صغيرة مثلها

73
00:05:00,460 --> 00:05:04,210
.لكنّني لن أنسى أبدًا ما حدث ذلك اليوم

74
00:05:09,710 --> 00:05:12,550
!غادروا... إلى المستقبل

75
00:05:14,890 --> 00:05:17,890
!أمّاه، لا تفعلي هذا رجاءً

76
00:05:18,180 --> 00:05:22,020
!أمّاه! أمّاه

77
00:05:24,020 --> 00:05:27,520
.لم أكن أدري ما يحدث وكنت مرتبكة

78
00:05:28,520 --> 00:05:30,860
،ووسط النّيران الملتهبة

79
00:05:30,860 --> 00:05:35,530
.اختفى أخي والبقيّة أمام ناظريّ تمامًا

80
00:05:41,910 --> 00:05:45,170
،فقدتُ والدي أودن في نفس اليوم

81
00:05:45,170 --> 00:05:46,670
...كما فقدت والدتي أيضًا

82
00:05:47,170 --> 00:05:50,340
.في ذلك اليوم، فقدت كلّ شيء فجأة

83
00:05:50,630 --> 00:05:54,590
،قيل لي أنّ أخي سيعود بعد 20 سنة

84
00:05:54,590 --> 00:05:59,930
لكن لم أستطع التّشبّث بالأمل
...من أجل شيء غير مؤكّد كهذا

85
00:06:01,220 --> 00:06:04,940
.لم أكن أملك الإرادة لأعيش كلّ تلك السّنين

86
00:06:06,310 --> 00:06:09,110
لماذا لم يجعلوك تعبرين خلال الزّمن كالبقيّة؟

87
00:06:09,730 --> 00:06:14,490
،في حال إن أصابني أو أخي مكروه

88
00:06:14,950 --> 00:06:18,120
.كانوا حريصين على ألاّ ينتهي نسل كوزكي

89
00:06:18,450 --> 00:06:21,120
...يا له من مصير قاسٍ

90
00:06:21,330 --> 00:06:24,710
،لكنّ أحد أتباع والدي

91
00:06:25,080 --> 00:06:30,550
يُدعى كاواماتسو الكابّا، دعمني
.عاطفيًّا بكلّ صبر وربّاني

92
00:06:30,550 --> 00:06:31,500
!كابّا؟

93
00:06:31,500 --> 00:06:32,460
.نعم

94
00:06:32,960 --> 00:06:39,180
،يصعب تصديق أنّ تلك المخلوقات موجودة
...لكنّه فخور جدًّا بكونه منها

95
00:06:40,140 --> 00:06:44,020
،في اليوم الّذي احترقت فيه القلعة
،كنّا محاصرين من طرف العدوّ

96
00:06:44,020 --> 00:06:47,900
لكنّنا هربنا عبر الخندق إلى قنوات
.التّصريف دون أن نُلاحظ

97
00:06:48,810 --> 00:06:51,520
!اصبري رجاءً أيّتها الأميرة

98
00:06:55,190 --> 00:06:58,910
،بعد خسارتي لوالدي ووالدتي وأخي

99
00:06:59,200 --> 00:07:04,370
،فقدت صوتي أيضًا من أثر الصّدمة
.لكنّه كان يرفّه عنّي دائمًا

100
00:07:04,580 --> 00:07:07,580
!يا أميرة! هذه رقصة الكابّا

101
00:07:07,620 --> 00:07:12,380
!هيّا! كابّابا، كابّابا، كابّابا وبا

102
00:07:12,420 --> 00:07:15,090
...كابّابا، كابّابا

103
00:07:15,300 --> 00:07:18,220
.هيّا كلي يا أميرة

104
00:07:22,850 --> 00:07:25,350
أنت جائع أيضًا، صحيح يا كاواماتسو؟

105
00:07:25,520 --> 00:07:31,810
...كلاّ، أنا مصاب بعسر هضم طفيف
...لهذا تصدر معدتي أصواتًا

106
00:07:32,230 --> 00:07:36,490
.أرجوك... كل نصفه أرجوك

107
00:07:36,650 --> 00:07:41,410
لا، لا، وجدت سمكة مشويّة
.في النّهر قبل قليل

108
00:07:45,790 --> 00:07:47,750
سمكة مشويّة في النّهر؟

109
00:07:47,910 --> 00:07:48,920
.صحيح

110
00:07:49,500 --> 00:07:54,590
.قمت بتقطيعها وأكلها مسبقًا

111
00:07:56,050 --> 00:08:00,800
،لم يكن يأكل الكثير
...لكنّه كان يحاول إطعامي

112
00:08:01,470 --> 00:08:06,430
وبفضل لطف كاواماتسو
،الّذي حماني من أعماق روحه

113
00:08:06,430 --> 00:08:09,520
.بدأت أضحك تدريجيًّا ثانية

114
00:08:10,440 --> 00:08:12,190
أين هو الآن؟

115
00:08:12,940 --> 00:08:16,820
،أعتقد أنّه عندما كنتُ في عمرٍ يناهز الـ13

116
00:08:16,860 --> 00:08:18,440
.انفصلنا عن بعضنا

117
00:08:20,030 --> 00:08:24,990
،لكنّ كاواماتسو ساموراي قويّ

118
00:08:24,990 --> 00:08:30,290
.لذلك أنا واثقة أنّه ينتظر يوم المعركة العظيمة

119
00:08:31,500 --> 00:08:34,920
...أريد رؤيته كما أريد رؤية البقيّة

120
00:08:35,130 --> 00:08:38,800
!يا أختي الكبيرة! أريد رؤية كابّا أيضًا

121
00:08:39,050 --> 00:08:42,510
!كابّا، كابّا، كابّابا

122
00:08:44,760 --> 00:08:46,100
!نعم

123
00:08:46,640 --> 00:08:47,640
.زوروجورو-سان

124
00:08:49,060 --> 00:08:53,900
مَن غيرك أيضًا يستعدّ للمعركة العظيمة؟

125
00:08:54,060 --> 00:08:55,900
...لنرَ

126
00:08:58,280 --> 00:09:01,200
!الكلب والقطّ موجودان أيضًا؟

127
00:09:01,360 --> 00:09:02,200
.نعم

128
00:09:02,450 --> 00:09:07,490
،سمعتُ أنّهما قد ماتا كلاهما
!لذلك لم أتوقّع أنّني سأراهما ثانية

129
00:09:07,660 --> 00:09:12,460
...ربّما لم يصل نيكوماموشي إلى بلاد وانو بعد

130
00:09:15,540 --> 00:09:17,090
ماذا تفعلين؟

131
00:09:17,250 --> 00:09:19,340
...أنا جدّ، جدّ سعيدة

132
00:09:25,680 --> 00:09:27,560
!أنت مضحكة يا أختي الكبيرة

133
00:09:31,930 --> 00:09:33,980
!لكنّني لن أبكي

134
00:09:34,520 --> 00:09:36,860
!لأنّني ابنة ساموراي

135
00:09:36,900 --> 00:09:39,690
،إن كان الكلب والقطّ سيشاركان أيضًا

136
00:09:39,730 --> 00:09:44,110
من الممكن أيضًا أنّ كلّ الأكازايا
!التّسعة قد يجتمعون معًا

137
00:09:44,280 --> 00:09:45,780
...لا أدري

138
00:09:46,410 --> 00:09:48,030
.كينييمون

139
00:09:48,490 --> 00:09:50,200
.كانجورو

140
00:09:50,790 --> 00:09:52,540
.رايزو

141
00:09:53,290 --> 00:09:55,210
.أوكيكو

142
00:09:55,830 --> 00:09:57,670
.إينواراشي

143
00:09:58,380 --> 00:10:00,210
.نيكوماموشي

144
00:10:03,800 --> 00:10:08,890
كلّ من نعرف بشأنهم هم هؤلاء
.السّتّة ومومونوسكي

145
00:10:08,930 --> 00:10:12,270
.لكنّنا لم نلتقِ بالثّلاثة الآخرين بعد

146
00:10:12,430 --> 00:10:16,560
أولئك الثّلاثة الآخرون هم كاواماتسو الّذي أخبرتك عنه

147
00:10:16,560 --> 00:10:19,020
.ودنجيرو وأشورا دوجي

148
00:10:19,360 --> 00:10:25,530
.لا أدري أين هم أو ما إن كانوا سالمين

149
00:10:26,110 --> 00:10:30,910
لكنّ الجميع يتحدّثون عن هذه
،المنشورات في العاصمة الآن

150
00:10:30,950 --> 00:10:33,410
!لذلك أراهن أنّهم سيأتون

151
00:10:33,700 --> 00:10:37,120
هل هذا من المنشورات الّتي سلّمناها للمتمرّدين؟

152
00:10:37,380 --> 00:10:38,460
.نعم

153
00:10:38,750 --> 00:10:44,630
بفضل الجلبة، انتشرت المعلومات
،سريعًا وهذا أمر جيّد

154
00:10:44,670 --> 00:10:47,010
...لكن واضح أنّه ليس في صالحنا

155
00:10:47,340 --> 00:10:52,010
.أنّ مكان اللّقاء سُرّب وأنّ رفاقنا أُسروا

156
00:10:52,060 --> 00:10:54,430
.أتساءل ماذا سيحدث

157
00:10:54,600 --> 00:10:56,190
.سيكون كلّ شيء بخير

158
00:10:56,980 --> 00:10:59,440
.أنا أؤمن بذلك

159
00:10:59,690 --> 00:11:01,020
...حسنًا

160
00:11:03,320 --> 00:11:08,950
قد يتسبّب الكثير من القادة في إغراق
...السّفينة، لذلك لن أقلق بالي

161
00:11:09,120 --> 00:11:10,450
!هذا صحيح، صحيح

162
00:11:10,490 --> 00:11:14,580
!قبل كلّ شيء، أريدك أن تتحسّن

163
00:11:14,620 --> 00:11:16,660
.حسنًا، نل قسطًا من الرّاحة

164
00:11:16,830 --> 00:11:19,290
...نعم، ليس عليك إخباري بذلك

165
00:11:24,960 --> 00:11:27,470
!أوتوكو، هذه معجزة

166
00:11:28,550 --> 00:11:30,180
!أنا سعيدة

167
00:11:32,930 --> 00:11:35,270
!أخي حيّ

168
00:11:36,850 --> 00:11:38,770
!أنا سعيدة من أجلك يا أختي الكبيرة

169
00:11:42,110 --> 00:11:43,480
!أنا جدّ سعيدة

170
00:11:46,650 --> 00:11:48,700
!سعيدة من أجلك يا أختي الكبيرة

171
00:11:48,860 --> 00:11:51,570
!توكو، هذا ممتاز

172
00:11:54,200 --> 00:11:57,580
.ألا يمكنهما أن تخرسا؟ لا أستطيع النّوم

173
00:12:03,500 --> 00:12:05,130
!لكنّه في الثّامنة

174
00:12:05,380 --> 00:12:07,010
!هذا غريب

175
00:12:07,470 --> 00:12:10,010
.ما زال طفلاً

176
00:12:10,090 --> 00:12:14,100
أعتقد أنّ كينييمون والبقيّة لم يتغيّروا
.أبدًا عمّا كانوا عليه قبل 20 سنة أيضًا

177
00:12:14,390 --> 00:12:17,810
.أتساءل كيف ستكون ردّة فعلي عندما أراهم

178
00:12:17,850 --> 00:12:21,600
.ربّما من الأفضل ألاّ أراهم قبل المعركة العظيمة

179
00:12:21,650 --> 00:12:26,070
...لا يجب أن أتدخّل في معركة ساموراي

180
00:12:26,440 --> 00:12:27,860
ألا تظنّين ذلك يا أوتوكو؟

181
00:12:40,920 --> 00:12:43,630
!كلاّ! عليّ إحضار حطب أكثر

182
00:12:59,810 --> 00:13:02,850
...أتمنى لو كان معنا لحاف على الأقلّ

183
00:13:22,790 --> 00:13:25,500
!لم تكن تلك! لا أستطيع إتقانها جيّدًا

184
00:13:27,550 --> 00:13:31,630
.أرسلتهما محلّقين في الهواء
ألم يكن ذلك كافيًا؟

185
00:13:32,340 --> 00:13:33,970
!كلاّ أيّها العجوز

186
00:13:34,300 --> 00:13:38,140
أريد تسديد لكمة سترسل الخصم
!محلّقًا في الهواء دون لمسه

187
00:13:38,350 --> 00:13:40,100
،بتلك الطّريقة

188
00:13:40,180 --> 00:13:44,310
!أظنّني أستطيع اختراق حراشف كايدو القاسية

189
00:13:44,480 --> 00:13:47,060
لكمة ترسل الأعداء محلّقين
في الهواء دون لمسهم؟

190
00:13:47,230 --> 00:13:50,900
نعم. لن أعلم إذا كانت ستنجح
.ما لم أجرّبها بالفعل

191
00:13:50,940 --> 00:13:53,450
...لكنّني رأيت ذلك من قبل

192
00:13:54,320 --> 00:13:56,160
...مع رايلي

193
00:13:57,280 --> 00:13:59,700
...ومع صاحب فأس المعركة

194
00:14:00,950 --> 00:14:03,290
."حيث استعمل كلاهما نفس "هاكي لون التّسلّح

195
00:14:03,660 --> 00:14:05,540
!أين يكمن الاختلاف بيني وبينهما؟

196
00:14:05,790 --> 00:14:08,500
.لا بدّ أنّ هذا الهاكي مفهوم أجنبيّ

197
00:14:09,000 --> 00:14:10,500
!هل تعرف بشأنه؟

198
00:14:10,670 --> 00:14:15,510
في بلاد وانو، هنالك مفهوم قوّة
.يغطّي سيوفنا انطلاقًا من أجسادنا

199
00:14:16,390 --> 00:14:19,640
بإمكان السّيف الجيّد قطع حتّى
،الحديد إن أردنا منه ذلك

200
00:14:19,680 --> 00:14:22,810
.لكن إن لم نرد، فلن يقطع حتّى ورقة

201
00:14:22,850 --> 00:14:25,440
!الأمر منوط بالكامل بالسّيّاف

202
00:14:36,360 --> 00:14:37,740
.أيّها العجوز

203
00:14:37,950 --> 00:14:40,700
!غبيّ! هل تتقدّم لتنال حتفك؟

204
00:14:41,830 --> 00:14:43,750
.يا فتى قبّعة القشّ

205
00:14:43,790 --> 00:14:48,830
راقب وأنا أريك المهارة الّتي اعتدتُ
.صقلها عبر نزالات السّيف

206
00:14:56,380 --> 00:14:57,090
!أيّها العجوز

207
00:15:00,390 --> 00:15:03,020
!يا فتى قبّعة القشّ! أرشدني

208
00:15:03,770 --> 00:15:04,560
!حسنًا

209
00:15:23,290 --> 00:15:27,040
.لا تنسي أنّك شككتِ في أمر طاقمي

210
00:15:30,460 --> 00:15:36,050
أنّى للأشخاص الّذين لا يثقون ببعضهم
!القتال معًا في معركة مميتة؟

211
00:15:44,100 --> 00:15:46,930
!مهلاً، انتظر يا تورا-أو

212
00:15:53,650 --> 00:15:56,440
.غادر تورا-أو وهو غاضب

213
00:15:56,820 --> 00:15:58,820
هل سيعود؟

214
00:15:59,200 --> 00:16:02,450
!تبًّا لشينوبو! كيف أمكنها قول ذلك؟

215
00:16:02,620 --> 00:16:05,370
!لكنّك تعرف سبب نفاد صبر شينوبو-تشان

216
00:16:05,660 --> 00:16:10,920
.فرض كايدو سيطرته على هذه البلاد وأفسد حياتها

217
00:16:10,960 --> 00:16:15,670
!لكنّها تحمّلت الأمر وانتظرت 20 سنة لتقاوم

218
00:16:15,840 --> 00:16:17,260
.أعلم ذلك

219
00:16:17,300 --> 00:16:22,140
لكن حتّى إن أخبرهم بيبّو والبقيّة
.بالخطّة، ما كنتُ لألومهم

220
00:16:22,300 --> 00:16:24,430
لأنّك كنتَ لتفعل ذلك، صحيح؟

221
00:16:24,600 --> 00:16:26,850
.أظنّ أنّك كنتِ لتخبريهم أيضًا

222
00:16:28,890 --> 00:16:30,480
التّعذيب؟

223
00:16:31,560 --> 00:16:32,940
.ربّما سأتحمّل لثلاث ثوانٍ

224
00:16:33,110 --> 00:16:34,440
!تلك مدّة قصيرة جدًّا

225
00:16:34,610 --> 00:16:35,520
!غادروا

226
00:16:36,440 --> 00:16:38,940
!لا أحتاج أن تعتنوا بي أيّها الحثالة الوضيعون

227
00:16:39,240 --> 00:16:43,620
ماذا؟ صراخ في بلدة إبيسو
الّتي يملؤها الضّحك دائمًا؟

228
00:16:46,410 --> 00:16:49,200
!لا بدّ أنّك وحش الأزوكي أيّتها العجوز

229
00:16:49,370 --> 00:16:50,160
!توقّف

230
00:16:50,370 --> 00:16:56,380
!إنّهم حديثو العهد هنا
.هربوا من العاصمة وأتوا إلى هنا

231
00:16:56,550 --> 00:16:57,960
!إلام تنظرون؟

232
00:16:58,130 --> 00:17:00,300
!غادروا

233
00:17:13,020 --> 00:17:14,350
هربوا من العاصمة؟

234
00:17:14,520 --> 00:17:15,400
.نعم

235
00:17:15,440 --> 00:17:21,530
وحدهم الّذين يكنّون الولاء للشّوغن
.ويجنون المال يستطيعون البقاء في العاصمة

236
00:17:21,570 --> 00:17:27,160
سمعتُ أنّ أولئك الرّجال كانوا
.يقومون بأمور سيّئة جدًّا

237
00:17:29,330 --> 00:17:30,950
أمور سيّئة؟

238
00:17:31,250 --> 00:17:32,040
...كبداية

239
00:17:32,210 --> 00:17:34,080
...هنالك ذلك التّابع بُنغو

240
00:17:32,210 --> 00:17:34,080
!أيّها القذرون الصّغار

241
00:17:35,920 --> 00:17:39,590
.كان يضرم النّيران في البلدة كلّ ليلة

242
00:17:39,630 --> 00:17:44,050
.لكنّه لم يكن يُعاقب لأنّه رشى المسؤولين

243
00:17:47,680 --> 00:17:48,890
!مفتعل حرائق؟

244
00:17:49,060 --> 00:17:51,180
!لماذا يزعج نفسه برشوة المسؤولين لإضرام الحرائق؟

245
00:17:51,350 --> 00:17:54,940
...كان هنالك من يجني المال من ذلك

246
00:17:56,860 --> 00:18:01,070
.إنّه تاجر أخشاب يبيع الخشب لإعادة بناء المنازل

247
00:18:01,110 --> 00:18:02,990
.اسمه بونغو

248
00:18:06,120 --> 00:18:07,910
.وما خفي كان أعظم

249
00:18:08,990 --> 00:18:13,250
كان الرّجل الثّالث يستغلّ الأشخاص
،الّذين ما زالوا ينتحبون على موتاهم في الحريق

250
00:18:13,290 --> 00:18:15,370
.ويرغمهم على دفع مبالغ باهظة

251
00:18:15,420 --> 00:18:17,920
.إنّه راهب ومتعهّد يُدعى بينغو

252
00:18:21,380 --> 00:18:22,840
!مهلاً لحظة

253
00:18:23,010 --> 00:18:25,220
...أتحاولين القول أنّ هؤلاء الثّلاثة

254
00:18:25,380 --> 00:18:31,140
.نعم. بينغو وبونغو وبُنغو كانوا يتعاونون معًا

255
00:18:32,640 --> 00:18:33,680
.عرفتُ ذلك

256
00:18:33,890 --> 00:18:35,020
!هذا فظيع

257
00:18:35,190 --> 00:18:39,110
،صحيح، لكن لا يهمّ كم اقترفوا من جرائم

258
00:18:39,150 --> 00:18:43,740
.كانوا يرشون المسؤولين وينجون من الاعتقال

259
00:18:43,780 --> 00:18:46,490
،كانوا يتظاهرون أنّهم أشخاص جيّدون

260
00:18:46,530 --> 00:18:49,490
.لكنّهم من أسوأ الخلق في الحقيقة

261
00:18:49,660 --> 00:18:52,080
لم يتلقَّ هؤلاء الهمجيّون أيّ عقاب إلهيّ؟

262
00:18:54,120 --> 00:18:55,660
...بما أنّك ذكرت الأمر

263
00:18:55,710 --> 00:19:02,000
وقع ثلاثتهم في حبّ الأويران
...كوموراساكي بالغة الجمال

264
00:19:02,050 --> 00:19:05,260
!الّتي ماتت البارحة

265
00:19:05,420 --> 00:19:10,890
!أنفق ثلاثتهم أطنانًا من المال عليها وأفلسوا

266
00:19:10,930 --> 00:19:14,640
!لذلك فإنّ الآلهة ترعانا برحمتها بالفعل
!وهذه هي الإشاعات

267
00:19:14,810 --> 00:19:16,310
.يا لها من قصّة

268
00:19:16,480 --> 00:19:19,480
لكنّ هذه تفاصيل دقيقة جدًّا
.لتكون مجرّد إشاعات

269
00:19:19,860 --> 00:19:21,980
.لا بدّ أنّها حقيقيّة

270
00:19:22,020 --> 00:19:25,820
في تلك الحالة، كانت تلك الأويران
.تعرف من يكونون وخدعتهم

271
00:19:25,860 --> 00:19:27,400
!هذا مذهل

272
00:19:27,610 --> 00:19:31,330
من تكون كوموراساكي هذه؟

273
00:19:32,490 --> 00:19:33,370
!إنّهم هم

274
00:19:34,370 --> 00:19:36,500
!صحيح! لقد تذكّرت

275
00:19:42,040 --> 00:19:45,960
!كانوا يحدثون جلبة أثناء موكب الأويران

276
00:19:46,470 --> 00:19:51,010
،وفّر ياسو-سان مكانً يعيشوا فيه واهتمّ بهم

277
00:19:51,050 --> 00:19:54,140
.لكن ما زالوا يتصرّفون بغطرسة وهم وخارجون عن السّيطرة

278
00:19:54,310 --> 00:19:59,560
.تونوياسو رجل طيّب بالفعل
!يهتمّ لأمر حتّى الحثالة مثلهم

279
00:20:33,680 --> 00:20:36,100
!يا فتى قبّعة القشّ! أرشدني

280
00:20:36,930 --> 00:20:37,720
!حسنًا

281
00:20:45,320 --> 00:20:47,990
!سيلوّح بسيفه الأيمن بكلّ قوّته

282
00:20:49,280 --> 00:20:50,400
!أنا لها

283
00:21:04,630 --> 00:21:07,250
!أيّها العجوز اللّعين

284
00:21:50,260 --> 00:21:51,880
!أطاح به

285
00:22:03,980 --> 00:22:04,900
...أيّها العجوز

286
00:22:05,730 --> 00:22:09,820
!"أطاح العجوز هيو بأحد "الموهوبين

287
00:22:09,980 --> 00:22:11,230
!ألباكامان

288
00:22:14,240 --> 00:22:19,660
ذلك العجوز الخرف... ظننت
.أنّه على شفير الموت

289
00:22:20,160 --> 00:22:22,790
!لكن يبدو أنّه ما زال يتمتّع ببعض الشّباب

290
00:22:25,580 --> 00:22:27,710
...هل يعقل أن يكون العجوز هيو

291
00:22:27,750 --> 00:22:30,340
!هو هيوغورو الزّهرة المشهور؟

292
00:22:33,880 --> 00:22:35,260
...يا فتى قبّعة القشّ

293
00:22:37,180 --> 00:22:41,140
،إن كان هذا أمر تريد القيام به

294
00:22:41,850 --> 00:22:45,350
.ربّما أستطيع مساعدتك قليلاً

295
00:22:50,230 --> 00:22:51,860
!علّمني

296
00:22:53,530 --> 00:22:55,610
!ذلك ما كنت أسعى إليه

297
00:23:04,410 --> 00:23:10,960
،لإتقان ريو والهروب من مخيّم التّنقيب
!سيسمح لوفي لروحه القتاليّة بالاشتعال أكثر

298
00:23:11,000 --> 00:23:17,180
في تلك الأثناء، ينضمّ تونوياسو وجنود آخرون ممّن
!يريدون التّمرّد ضدّ أوروتشي لعملية الإغارة

299
00:23:17,220 --> 00:23:22,060
وهكذا يجتمع حلفاء أكثر معًا للإطاحة
!بكايدو ويبدأ طريق الأمل بالظّهور

300
00:23:22,310 --> 00:23:23,600
:في الحلقة القادمة من وان بيس

301
00:23:23,600 --> 00:23:26,730
تونوياسو! أكثر الأشخاص"
"!المحبوبين في بلدة إبيسو

302
00:23:26,770 --> 00:23:30,440
!ملك القراصنة، لن يكون إلاّ أنا