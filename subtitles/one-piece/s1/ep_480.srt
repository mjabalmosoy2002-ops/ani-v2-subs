1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:21,760 --> 00:03:24,000
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:24,000 --> 00:03:29,070
!وصل لوفي إلى مارينفورد لينقذ أخاه إيس الّذي سيُعدَم

39
00:03:29,070 --> 00:03:35,380
تمكّن هو وطاقم اللّحية البيضاء أخيرًا من
!تخطّي الجدران المحيطة للوصول إلى المنصّة

40
00:03:36,160 --> 00:03:37,980
،في خضمّ هجوم البحريّة

41
00:03:37,980 --> 00:03:42,540
!يركض لوفي صوب إيس بمساعدة من طاقم اللّحية البيضاء

42
00:03:43,730 --> 00:03:46,630
!أنتم

43
00:03:46,630 --> 00:03:47,590
!والدي؟

44
00:03:47,920 --> 00:03:52,010
...من الآن فصاعدًا، ساندوا قبّعة القشّ لوفي

45
00:03:52,010 --> 00:03:56,760
!بكلّ قوّتكم

46
00:04:01,690 --> 00:04:04,320
!مهّدوا طريقًا

47
00:04:16,360 --> 00:04:19,990
!أنا هنا يا إيس

48
00:04:27,920 --> 00:04:31,840
!جدّي! تنحّ عن الطّريق

49
00:04:32,060 --> 00:04:34,720
!لن أتحرّك

50
00:04:34,720 --> 00:04:38,100
!لأنّني نائب أميرال في البحريّة

51
00:04:38,560 --> 00:04:44,020
كنتُ أواجه القراصنة قبل أن تأتي
!أنت لهذه الدّنيا بوقت طويل

52
00:04:44,250 --> 00:04:45,730
!العجوز

53
00:04:45,730 --> 00:04:50,320
،إن كنت تريد العبور من هنا
!فسيكون ذلك على جثّتي

54
00:04:51,030 --> 00:04:53,110
!يا قبّعة القشّ لوفي

55
00:04:55,060 --> 00:04:58,540
...بسبب الطّريق الّذي

56
00:04:59,460 --> 00:05:02,870
!اخترتما العيش فيه

57
00:05:05,200 --> 00:05:09,640
"!كلّ في طريقه! لوفي ضدّ غارب"

58
00:05:20,390 --> 00:05:25,220
!رجاءً يا جدّي! دعني أمرّ

59
00:05:32,200 --> 00:05:34,030
!لوفي

60
00:05:43,330 --> 00:05:48,000
!كـ-كوبي! تـ-تماسك يا كوبي

61
00:05:52,730 --> 00:05:55,760
!سحقًا لقبّعة القشّ

62
00:05:56,930 --> 00:06:00,930
!كيف أمكنه فعل هذا لكوبي دون أيّ شفقة؟

63
00:06:00,930 --> 00:06:03,020
!سأجعله يدفع الثّمن

64
00:06:04,970 --> 00:06:07,270
...عـ-عليّ أن أصبح

65
00:06:07,690 --> 00:06:10,230
...أقوى بكثير

66
00:06:10,230 --> 00:06:15,280
!أ-أ-أنت حيّ! حمدًا لهذا

67
00:06:19,030 --> 00:06:20,450
أين هو لوفي-سان؟

68
00:06:22,700 --> 00:06:25,670
...قبّعة القشّ اللّعين ذاك

69
00:06:26,500 --> 00:06:29,250
!يعترض نائبُ الأميرال غارب طريقه

70
00:06:29,250 --> 00:06:32,880
!هل سيقاتلون حقًّا؟

71
00:06:32,880 --> 00:06:34,550
!لوفي-سان

72
00:06:41,310 --> 00:06:44,760
!قبّعة القشّ ذاهب إلى المنصّة! سحقًا

73
00:06:44,760 --> 00:06:46,890
!من السّهل النّيل منه من هذه المسافة

74
00:06:46,890 --> 00:06:49,910
!صوّبوا على قبّعة القشّ لوفي

75
00:06:50,730 --> 00:06:52,360
!أيّها الحمقى الوقحون

76
00:06:52,360 --> 00:06:54,110
!تراجعوا

77
00:06:58,800 --> 00:07:01,080
!سهام العبوديّة

78
00:07:01,740 --> 00:07:02,540
...نحن

79
00:07:02,540 --> 00:07:03,120
...نحبّك

80
00:07:03,120 --> 00:07:04,700
...أنت

81
00:07:05,790 --> 00:07:09,380
!أيّتها الإمبراطورة القرصانة! في أيّ جانب أنت فعلاً؟

82
00:07:09,380 --> 00:07:11,840
...إلى جانب لوفي بالطّبع

83
00:07:11,840 --> 00:07:15,340
!لكن ماذا إن أصبتم نائب الأميرال غارب برصاصة طائشة؟

84
00:07:15,340 --> 00:07:16,680
!ماذا؟

85
00:07:16,680 --> 00:07:17,970
!لـ-لا

86
00:07:17,970 --> 00:07:21,920
...نائب الأميرال غارب! إنّه

87
00:07:22,560 --> 00:07:24,770
!جدّي

88
00:07:24,770 --> 00:07:26,390
!جدّك؟

89
00:07:26,390 --> 00:07:28,560
!نائب الأميرال غارب؟

90
00:07:29,360 --> 00:07:34,530
إن تزوّجت من لوفي، فسيصبح
!غارب جدّي بطبيعة الحال

91
00:07:35,320 --> 00:07:36,740
...ذلك

92
00:07:36,740 --> 00:07:38,350
!في عقلك فحسب

93
00:07:42,780 --> 00:07:47,370
!عليك أن تجد طريقةً يا قبّعة القشّ
!أسرع قبل أن ينهار الجسر

94
00:07:47,370 --> 00:07:49,080
!قبّعة القشّ

95
00:07:49,660 --> 00:07:50,960
!لوفي-كن

96
00:07:56,800 --> 00:08:01,390
!لوفي! قبّعة القشّ لوفي

97
00:08:04,870 --> 00:08:10,400
كما قلت، إن كنت تريد العبور
!فسيكون ذلك على جثّتي

98
00:08:17,360 --> 00:08:18,620
!هذا مؤلم

99
00:08:23,700 --> 00:08:25,160
!أيّها الوغد

100
00:08:31,370 --> 00:08:33,210
!جدّي

101
00:08:33,210 --> 00:08:38,550
!لِمَ تريدني أن أقاتل هؤلاء؟

102
00:08:43,390 --> 00:08:44,800
!هذا هو تدريبك

103
00:08:44,800 --> 00:08:47,060
!تدريبي؟

104
00:08:47,060 --> 00:08:50,760
بل يجعلني أجوع فحسب
!ولا أريد أن أتعرّض للضّرب أكثر

105
00:08:53,600 --> 00:08:55,730
!لا تتصرّف كالأطفال الصّغار

106
00:08:55,730 --> 00:08:59,400
!عليك أن تصبح أقوى جنديّ في البحريّة

107
00:08:59,400 --> 00:09:03,200
!سوف أصبح قرصانًا، لا جنديّ بحريّة

108
00:09:05,950 --> 00:09:07,580
ماذا؟

109
00:09:07,580 --> 00:09:09,620
!أيّها الأحمق

110
00:09:09,620 --> 00:09:11,500
!هذا مؤلم

111
00:09:11,500 --> 00:09:15,500
!لا شيء أكثر إيلامًا من قبضة جدّي

112
00:09:31,140 --> 00:09:34,070
...فاكهة المطّاط

113
00:09:43,450 --> 00:09:45,070
...يا للأحمق

114
00:09:45,660 --> 00:09:48,330
!يجب أن أخبرك شيئًا

115
00:09:49,080 --> 00:09:50,490
ماذا؟

116
00:09:52,660 --> 00:09:55,120
!لن أصبح قرصانًا

117
00:09:55,120 --> 00:09:57,670
!فهمتَ أخيرًا

118
00:09:57,670 --> 00:10:01,060
،لن أصبح محض قرصان

119
00:10:01,060 --> 00:10:03,060
!بل سأصبح ملك القراصنة

120
00:10:06,760 --> 00:10:09,720
!لا ينبغي أن تتأثّر بأحمر الشّعر هكذا

121
00:10:11,320 --> 00:10:16,510
!انصرف! عليّ أنّ ألقّنه بعض الشّخصيّة

122
00:10:16,510 --> 00:10:18,190
!جدّي

123
00:10:19,720 --> 00:10:23,190
!لن أدعك تصبح قرصانًا مهما كان

124
00:10:44,560 --> 00:10:51,060
.مع أنّك منهك ونائم، إلاّ أنّ معدتك نشيطة كما العادة

125
00:10:59,230 --> 00:11:05,740
.لا بدّ أنّك تكره جدًّا مخيفًا مثلي

126
00:11:09,590 --> 00:11:11,030
،لكن يا لوفي

127
00:11:11,610 --> 00:11:16,290
السّبب الّذي يدفعني لمعاملتك
...بقسوة لتصبح جنديًّا في البحريّة

128
00:11:16,720 --> 00:11:20,750
.هو لأنّني لا أريدك أن تتوه عن طريق الصّواب بأيّ ثمن

129
00:11:21,750 --> 00:11:24,120
.تلك هي أمنيتي

130
00:11:35,270 --> 00:11:38,810
لوفي، سنتناول عشاءً رائعًا اللّيلة

131
00:11:38,810 --> 00:11:41,670
.لأنّني نهبتُ الكثير من البحريّة

132
00:11:41,950 --> 00:11:44,570
!يمكنك أن تأكل من اللّحم ما شئت

133
00:11:47,260 --> 00:11:48,820
...جدّي

134
00:11:53,840 --> 00:11:57,460
!لا أستطيع يا جدّي! تنحّ عن طريقي

135
00:11:57,460 --> 00:12:00,370
!إلّم تستطع فسيموت إيس

136
00:12:00,370 --> 00:12:02,080
!مستحيل

137
00:12:02,080 --> 00:12:06,710
!لا تسير الأمور كما ترغب دائمًا! لن أرحمك

138
00:12:07,970 --> 00:12:09,680
...لوفي، إنّي أعتبرك

139
00:12:10,930 --> 00:12:14,720
!عدوّي

140
00:12:40,080 --> 00:12:42,000
!لوفي

141
00:12:54,180 --> 00:12:55,280
!غارب

142
00:13:27,820 --> 00:13:31,630
!سُحقًا! ذهني مرتبك للغاية
!هذا ليس الوقت المناسب

143
00:13:32,360 --> 00:13:35,970
...والدي وأخي وأصدقائي

144
00:13:35,970 --> 00:13:38,720
...يتساقطون الواحد تلو الآخر وينزفون

145
00:13:39,430 --> 00:13:44,350
!أنا في غاية السّعادة ولا يمكنني الكفّ عن البكاء

146
00:13:44,840 --> 00:13:48,900
في هذه اللّحظة الأخيرة، بدأت
!أفكّر أنّني أريد أن أعيش

147
00:13:58,910 --> 00:14:00,830
!نائب الأميرال غارب

148
00:14:08,790 --> 00:14:10,610
!أيّها العجوز

149
00:14:14,050 --> 00:14:17,760
.أنت والدهما في الأخير يا غارب

150
00:14:19,010 --> 00:14:23,480
!إنّه على وشك الوصول إلى المنصّة

151
00:14:24,710 --> 00:14:28,360
!دعوته بحثالة متهوّرة

152
00:14:28,360 --> 00:14:31,030
!إنّه متهوّر بالفعل

153
00:14:31,030 --> 00:14:34,700
.أتساءل كيف يمكنه أن يحرّر قبضة النّار إيس

154
00:14:34,700 --> 00:14:37,700
!اغرب! أيّها الأحمق

155
00:14:44,790 --> 00:14:46,830
.لستَ حذرًا

156
00:14:46,830 --> 00:14:48,960
!والدي

157
00:15:09,890 --> 00:15:12,820
...أخيرًا... أخيرًا

158
00:15:14,310 --> 00:15:16,280
!وصلت

159
00:15:16,280 --> 00:15:17,960
!لوفي

160
00:15:19,280 --> 00:15:21,240
!...أنت حقًّا

161
00:15:22,670 --> 00:15:24,500
!إيس

162
00:15:42,680 --> 00:15:44,060
!انتظر

163
00:15:45,890 --> 00:15:47,140
.خذ هذا

164
00:15:48,200 --> 00:15:50,560
.إنّه مفتاح أصفاد أخيك

165
00:15:50,560 --> 00:15:52,690
!أملك المفتاح

166
00:15:54,230 --> 00:15:56,030
!لوفي، كيف...؟

167
00:16:20,930 --> 00:16:22,800
!مـ-ما ذلك بالضّبط؟

168
00:16:25,430 --> 00:16:29,140
!انظروا! إنّ أميرال الأسطول سنغوكو يستخدم قوّته

169
00:16:29,140 --> 00:16:30,310
!لم أرها من قبل

170
00:16:36,820 --> 00:16:40,490
!لا يمكنك الهرب منّي

171
00:16:48,310 --> 00:16:50,330
!سنغوكو

172
00:16:50,330 --> 00:16:51,460
!بوذا عملاق

173
00:16:56,340 --> 00:17:00,880
لا أصدّق أنّك تملك حتّى مثل هذا
!الشّيء يا قبّعة القشّ لوفي

174
00:17:03,680 --> 00:17:05,240
!لا، المفتاح

175
00:17:05,240 --> 00:17:06,680
!استعدّوا

176
00:17:07,180 --> 00:17:09,980
!صوّبوا عليهم واستعدّوا للإطلاق فورًا

177
00:17:11,260 --> 00:17:13,730
!...مستحيل، المفتاح

178
00:17:14,640 --> 00:17:16,120
!قبّعة القشّ لوفي

179
00:17:16,750 --> 00:17:19,820
!أنت مجرم خطير ينبغي أن يعاقب بالموت أيضًا

180
00:17:21,340 --> 00:17:26,700
!سأعدمكما معًا أيّها الأخوان بيديّ هاتين

181
00:17:33,920 --> 00:17:37,750
...ما كان ذلك؟ أغمي عليّ فجأةً

182
00:17:40,690 --> 00:17:42,800
!...قبّعة القشّ

183
00:17:44,200 --> 00:17:46,320
!ثلاثة! لِمَ أنت هنا؟

184
00:17:54,310 --> 00:17:56,110
!ما ذلك؟

185
00:17:57,120 --> 00:17:59,700
!يا ثلاثة! احم إيس بجدار

186
00:17:59,700 --> 00:18:01,860
...فاكة المطّاط

187
00:18:03,360 --> 00:18:06,160
!البالون العملاق

188
00:18:09,990 --> 00:18:12,170
!جدار الشّمع

189
00:18:15,830 --> 00:18:17,290
!هل يتمدّد؟

190
00:18:28,100 --> 00:18:30,310
!المنصّة تنهار

191
00:18:30,310 --> 00:18:31,560
!ماذا حدث؟

192
00:18:32,080 --> 00:18:34,350
!ما زال إيس حيًّا

193
00:18:34,350 --> 00:18:36,330
!إنّنا نسقط

194
00:18:37,530 --> 00:18:41,780
!سأصنع المفتاح! فكّ وثاقه حالاً

195
00:18:42,620 --> 00:18:43,990
!حسنًا

196
00:18:43,990 --> 00:18:47,310
!أيّها القبطان باغي! إنّه الأخ 3

197
00:18:47,310 --> 00:18:51,740
!ماذا؟! ما الّذي يفعله في ذلك الزّيّ السّخيف؟

198
00:18:52,350 --> 00:18:55,080
!خلتُ أنّه هرب من هنا بالفعل

199
00:19:02,800 --> 00:19:07,220
لا بدّ أنّ إعدام قبضة النّار إيس له
!علاقة بهيبة مقرّ البحريّة

200
00:19:07,220 --> 00:19:09,050
!علينا أن ننهيه

201
00:19:11,320 --> 00:19:12,600
...كان أولئك

202
00:19:12,600 --> 00:19:14,560
!الجلاّدون

203
00:19:14,560 --> 00:19:16,890
!رنين، رنين، رنين... فتح

204
00:19:16,890 --> 00:19:22,110
!فهمت! أوقف الأميرال بورسالينو قبّعة القشّ في السّاحة

205
00:19:22,400 --> 00:19:23,900
!قبّعة القشّ؟

206
00:19:23,900 --> 00:19:27,800
!عليك أن تنقذ أخاك بأيّ ثمن

207
00:19:28,260 --> 00:19:31,660
!...سيّد 2

208
00:19:33,280 --> 00:19:35,660
حسنًا، ما العمل الآن؟

209
00:19:36,370 --> 00:19:38,750
!سننقذ قبّعة-تشان

210
00:19:40,580 --> 00:19:44,630
!لأنّني صديقه! لا أحتاج لأيّ سبب آخر

211
00:19:45,600 --> 00:19:47,420
أصدقاء؟

212
00:19:47,420 --> 00:19:50,970
.بون-تشان، إنّ البوّابة تغلق

213
00:19:53,410 --> 00:19:55,720
.نحن... علينا أن نذهب

214
00:19:58,600 --> 00:20:00,440
!شكرًا لك

215
00:20:00,440 --> 00:20:04,980
!قبّعة-تشان

216
00:20:03,110 --> 00:20:04,000
!بون-تشان

217
00:20:06,510 --> 00:20:09,610
!عليك أن تنقذ أخاك بأيّ ثمن

218
00:20:13,520 --> 00:20:15,960
.لم يهرب أبدًا

219
00:20:16,910 --> 00:20:20,690
!كرّم صداقته مع قبّعة القشّ

220
00:20:21,420 --> 00:20:24,190
!حسنًا، استعدّوا بسرعة

221
00:20:24,190 --> 00:20:25,390
!حاضر

222
00:20:43,610 --> 00:20:47,320
!أين الجلاّد الآخر؟! ما الّذي يؤخّره هكذا؟

223
00:20:47,320 --> 00:20:51,200
،بما أنّ الأمر كان مفاجئًا
...فهو يواجه مشاكل في الاستعداد

224
00:20:51,200 --> 00:20:53,520
!هيّا، أسرع

225
00:20:53,520 --> 00:20:55,160
!حسنًا، لنذهب

226
00:21:02,670 --> 00:21:09,170
،إن أخبرتك أنّني هنا احترامًا لرفيقي الرّاحل

227
00:21:09,170 --> 00:21:12,170
!هل ستسخر منّي؟

228
00:21:12,840 --> 00:21:15,050
!لا، لن أفعل

229
00:21:15,050 --> 00:21:18,770
!أطلقوا! فجّروهم

230
00:21:21,490 --> 00:21:23,600
!أنقذ أخاك يا قبّعة القشّ

231
00:21:23,600 --> 00:21:25,060
!حسنًا

232
00:21:25,730 --> 00:21:27,420
!لا

233
00:21:39,120 --> 00:21:40,830
!فتى قبّعة القشّ

234
00:21:40,830 --> 00:21:42,080
!مستحيل

235
00:21:42,540 --> 00:21:44,460
!إيس

236
00:21:46,620 --> 00:21:48,460
!أخي 3

237
00:21:48,460 --> 00:21:50,550
!أصيبوا جميعًا

238
00:21:51,370 --> 00:21:54,940
لا يمكن لقبضة النّار أن يستخدم قواه
!بسبب أصفاد الحجر البحريّ

239
00:21:54,940 --> 00:21:56,320
!لقد مات

240
00:21:56,320 --> 00:21:58,810
!كما نلنا من قبّعة القشّ

241
00:22:14,400 --> 00:22:17,870
!ثمّة نفق من النّار في الدخّان

242
00:22:18,950 --> 00:22:21,120
!لطالما كنت هكذا

243
00:22:21,580 --> 00:22:23,000
!يا لوفي

244
00:22:26,270 --> 00:22:28,920
...لم تصغ إليّ قطّ

245
00:22:34,040 --> 00:22:37,550
!ودائمًا ما فعلتَ أشياء جنونيّة

246
00:22:38,800 --> 00:22:40,060
!جيّد

247
00:22:40,060 --> 00:22:40,850
!يا إلهي

248
00:22:41,160 --> 00:22:43,180
!إيس

249
00:22:43,180 --> 00:22:45,850
!لـ-لا أصدّق هذا

250
00:22:45,850 --> 00:22:48,950
!قبّعة القشّ والأخ 3 حيّان أيضًا

251
00:22:59,540 --> 00:23:02,950
!إيس

252
00:23:11,440 --> 00:23:13,760
!تحرّر إيس أخيرًا

253
00:23:19,970 --> 00:23:24,170
،لكنّ اللّحية البيضاء الّذي ينظر إلى مستقبل ما زال بعيدًا

254
00:23:24,170 --> 00:23:26,350
.يتّخذ قرارًا من نفسه

255
00:23:26,350 --> 00:23:27,810
:في الحلقة القادمة من وان بيس

256
00:23:27,810 --> 00:23:31,090
"!تمّ إنقاذ إيس! أمر اللّحية البيضاء الأخير"

257
00:23:31,090 --> 00:23:33,360
!ملك القراصنة، لن يكون إلاّ أنا

258
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة