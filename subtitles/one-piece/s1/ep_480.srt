1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:35,760 --> 00:03:38,000
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:38,000 --> 00:03:43,070
!وصل لوفي إلى مارينفورد لينقذ أخاه إيس الّذي سيُعدَم

39
00:03:43,070 --> 00:03:49,380
تمكّن هو وطاقم اللّحية البيضاء أخيرًا من
!تخطّي الجدران المحيطة للوصول إلى المنصّة

40
00:03:50,160 --> 00:03:51,980
،في خضمّ هجوم البحريّة

41
00:03:51,980 --> 00:03:56,540
!يركض لوفي صوب إيس بمساعدة من طاقم اللّحية البيضاء

42
00:03:57,730 --> 00:04:00,630
!أنتم

43
00:04:00,630 --> 00:04:01,590
!والدي؟

44
00:04:01,920 --> 00:04:06,010
...من الآن فصاعدًا، ساندوا قبّعة القشّ لوفي

45
00:04:06,010 --> 00:04:10,760
!بكلّ قوّتكم

46
00:04:15,690 --> 00:04:18,320
!مهّدوا طريقًا

47
00:04:30,360 --> 00:04:33,990
!أنا هنا يا إيس

48
00:04:41,920 --> 00:04:45,840
!جدّي! تنحّ عن الطّريق

49
00:04:46,060 --> 00:04:48,720
!لن أتحرّك

50
00:04:48,720 --> 00:04:52,100
!لأنّني نائب أميرال في البحريّة

51
00:04:52,560 --> 00:04:58,020
كنتُ أواجه القراصنة قبل أن تأتي
!أنت لهذه الدّنيا بوقت طويل

52
00:04:58,250 --> 00:04:59,730
!العجوز

53
00:04:59,730 --> 00:05:04,320
،إن كنت تريد العبور من هنا
!فسيكون ذلك على جثّتي

54
00:05:05,030 --> 00:05:07,110
!يا قبّعة القشّ لوفي

55
00:05:09,060 --> 00:05:12,540
...بسبب الطّريق الّذي

56
00:05:13,460 --> 00:05:16,870
!اخترتما العيش فيه

57
00:05:19,200 --> 00:05:23,640
"!كلّ في طريقه! لوفي ضدّ غارب"

58
00:05:34,390 --> 00:05:39,220
!رجاءً يا جدّي! دعني أمرّ

59
00:05:46,200 --> 00:05:48,030
!لوفي

60
00:05:57,330 --> 00:06:02,000
!كـ-كوبي! تـ-تماسك يا كوبي

61
00:06:06,730 --> 00:06:09,760
!سحقًا لقبّعة القشّ

62
00:06:10,930 --> 00:06:14,930
!كيف أمكنه فعل هذا لكوبي دون أيّ شفقة؟

63
00:06:14,930 --> 00:06:17,020
!سأجعله يدفع الثّمن

64
00:06:18,970 --> 00:06:21,270
...عـ-عليّ أن أصبح

65
00:06:21,690 --> 00:06:24,230
...أقوى بكثير

66
00:06:24,230 --> 00:06:29,280
!أ-أ-أنت حيّ! حمدًا لهذا

67
00:06:33,030 --> 00:06:34,450
أين هو لوفي-سان؟

68
00:06:36,700 --> 00:06:39,670
...قبّعة القشّ اللّعين ذاك

69
00:06:40,500 --> 00:06:43,250
!يعترض نائبُ الأميرال غارب طريقه

70
00:06:43,250 --> 00:06:46,880
!هل سيقاتلون حقًّا؟

71
00:06:46,880 --> 00:06:48,550
!لوفي-سان

72
00:06:55,310 --> 00:06:58,760
!قبّعة القشّ ذاهب إلى المنصّة! سحقًا

73
00:06:58,760 --> 00:07:00,890
!من السّهل النّيل منه من هذه المسافة

74
00:07:00,890 --> 00:07:03,910
!صوّبوا على قبّعة القشّ لوفي

75
00:07:04,730 --> 00:07:06,360
!أيّها الحمقى الوقحون

76
00:07:06,360 --> 00:07:08,110
!تراجعوا

77
00:07:12,800 --> 00:07:15,080
!سهام العبوديّة

78
00:07:15,740 --> 00:07:16,540
...نحن

79
00:07:16,540 --> 00:07:17,120
...نحبّك

80
00:07:17,120 --> 00:07:18,700
...أنت

81
00:07:19,790 --> 00:07:23,380
!أيّتها الإمبراطورة القرصانة! في أيّ جانب أنت فعلاً؟

82
00:07:23,380 --> 00:07:25,840
...إلى جانب لوفي بالطّبع

83
00:07:25,840 --> 00:07:29,340
!لكن ماذا إن أصبتم نائب الأميرال غارب برصاصة طائشة؟

84
00:07:29,340 --> 00:07:30,680
!ماذا؟

85
00:07:30,680 --> 00:07:31,970
!لـ-لا

86
00:07:31,970 --> 00:07:35,920
...نائب الأميرال غارب! إنّه

87
00:07:36,560 --> 00:07:38,770
!جدّي

88
00:07:38,770 --> 00:07:40,390
!جدّك؟

89
00:07:40,390 --> 00:07:42,560
!نائب الأميرال غارب؟

90
00:07:43,360 --> 00:07:48,530
إن تزوّجت من لوفي، فسيصبح
!غارب جدّي بطبيعة الحال

91
00:07:49,320 --> 00:07:50,740
...ذلك

92
00:07:50,740 --> 00:07:52,350
!في عقلك فحسب

93
00:07:56,780 --> 00:08:01,370
!عليك أن تجد طريقةً يا قبّعة القشّ
!أسرع قبل أن ينهار الجسر

94
00:08:01,370 --> 00:08:03,080
!قبّعة القشّ

95
00:08:03,660 --> 00:08:04,960
!لوفي-كن

96
00:08:10,800 --> 00:08:15,390
!لوفي! قبّعة القشّ لوفي

97
00:08:18,870 --> 00:08:24,400
كما قلت، إن كنت تريد العبور
!فسيكون ذلك على جثّتي

98
00:08:31,360 --> 00:08:32,620
!هذا مؤلم

99
00:08:37,700 --> 00:08:39,160
!أيّها الوغد

100
00:08:45,370 --> 00:08:47,210
!جدّي

101
00:08:47,210 --> 00:08:52,550
!لِمَ تريدني أن أقاتل هؤلاء؟

102
00:08:57,390 --> 00:08:58,800
!هذا هو تدريبك

103
00:08:58,800 --> 00:09:01,060
!تدريبي؟

104
00:09:01,060 --> 00:09:04,760
بل يجعلني أجوع فحسب
!ولا أريد أن أتعرّض للضّرب أكثر

105
00:09:07,600 --> 00:09:09,730
!لا تتصرّف كالأطفال الصّغار

106
00:09:09,730 --> 00:09:13,400
!عليك أن تصبح أقوى جنديّ في البحريّة

107
00:09:13,400 --> 00:09:17,200
!سوف أصبح قرصانًا، لا جنديّ بحريّة

108
00:09:19,950 --> 00:09:21,580
ماذا؟

109
00:09:21,580 --> 00:09:23,620
!أيّها الأحمق

110
00:09:23,620 --> 00:09:25,500
!هذا مؤلم

111
00:09:25,500 --> 00:09:29,500
!لا شيء أكثر إيلامًا من قبضة جدّي

112
00:09:45,140 --> 00:09:48,070
...فاكهة المطّاط

113
00:09:57,450 --> 00:09:59,070
...يا للأحمق

114
00:09:59,660 --> 00:10:02,330
!يجب أن أخبرك شيئًا

115
00:10:03,080 --> 00:10:04,490
ماذا؟

116
00:10:06,660 --> 00:10:09,120
!لن أصبح قرصانًا

117
00:10:09,120 --> 00:10:11,670
!فهمتَ أخيرًا

118
00:10:11,670 --> 00:10:15,060
،لن أصبح محض قرصان

119
00:10:15,060 --> 00:10:17,060
!بل سأصبح ملك القراصنة

120
00:10:20,760 --> 00:10:23,720
!لا ينبغي أن تتأثّر بأحمر الشّعر هكذا

121
00:10:25,320 --> 00:10:30,510
!انصرف! عليّ أنّ ألقّنه بعض الشّخصيّة

122
00:10:30,510 --> 00:10:32,190
!جدّي

123
00:10:33,720 --> 00:10:37,190
!لن أدعك تصبح قرصانًا مهما كان

124
00:10:58,560 --> 00:11:05,060
.مع أنّك منهك ونائم، إلاّ أنّ معدتك نشيطة كما العادة

125
00:11:13,230 --> 00:11:19,740
.لا بدّ أنّك تكره جدًّا مخيفًا مثلي

126
00:11:23,590 --> 00:11:25,030
،لكن يا لوفي

127
00:11:25,610 --> 00:11:30,290
السّبب الّذي يدفعني لمعاملتك
...بقسوة لتصبح جنديًّا في البحريّة

128
00:11:30,720 --> 00:11:34,750
.هو لأنّني لا أريدك أن تتوه عن طريق الصّواب بأيّ ثمن

129
00:11:35,750 --> 00:11:38,120
.تلك هي أمنيتي

130
00:11:49,270 --> 00:11:52,810
لوفي، سنتناول عشاءً رائعًا اللّيلة

131
00:11:52,810 --> 00:11:55,670
.لأنّني نهبتُ الكثير من البحريّة

132
00:11:55,950 --> 00:11:58,570
!يمكنك أن تأكل من اللّحم ما شئت

133
00:12:01,260 --> 00:12:02,820
...جدّي

134
00:12:07,840 --> 00:12:11,460
!لا أستطيع يا جدّي! تنحّ عن طريقي

135
00:12:11,460 --> 00:12:14,370
!إلّم تستطع فسيموت إيس

136
00:12:14,370 --> 00:12:16,080
!مستحيل

137
00:12:16,080 --> 00:12:20,710
!لا تسير الأمور كما ترغب دائمًا! لن أرحمك

138
00:12:21,970 --> 00:12:23,680
...لوفي، إنّي أعتبرك

139
00:12:24,930 --> 00:12:28,720
!عدوّي

140
00:12:54,080 --> 00:12:56,000
!لوفي

141
00:13:08,180 --> 00:13:09,280
!غارب

142
00:13:41,820 --> 00:13:45,630
!سُحقًا! ذهني مرتبك للغاية
!هذا ليس الوقت المناسب

143
00:13:46,360 --> 00:13:49,970
...والدي وأخي وأصدقائي

144
00:13:49,970 --> 00:13:52,720
...يتساقطون الواحد تلو الآخر وينزفون

145
00:13:53,430 --> 00:13:58,350
!أنا في غاية السّعادة ولا يمكنني الكفّ عن البكاء

146
00:13:58,840 --> 00:14:02,900
في هذه اللّحظة الأخيرة، بدأت
!أفكّر أنّني أريد أن أعيش

147
00:14:12,910 --> 00:14:14,830
!نائب الأميرال غارب

148
00:14:22,790 --> 00:14:24,610
!أيّها العجوز

149
00:14:28,050 --> 00:14:31,760
.أنت والدهما في الأخير يا غارب

150
00:14:33,010 --> 00:14:37,480
!إنّه على وشك الوصول إلى المنصّة

151
00:14:38,710 --> 00:14:42,360
!دعوته بحثالة متهوّرة

152
00:14:42,360 --> 00:14:45,030
!إنّه متهوّر بالفعل

153
00:14:45,030 --> 00:14:48,700
.أتساءل كيف يمكنه أن يحرّر قبضة النّار إيس

154
00:14:48,700 --> 00:14:51,700
!اغرب! أيّها الأحمق

155
00:14:58,790 --> 00:15:00,830
.لستَ حذرًا

156
00:15:00,830 --> 00:15:02,960
!والدي

157
00:15:23,890 --> 00:15:26,820
...أخيرًا... أخيرًا

158
00:15:28,310 --> 00:15:30,280
!وصلت

159
00:15:30,280 --> 00:15:31,960
!لوفي

160
00:15:33,280 --> 00:15:35,240
!...أنت حقًّا

161
00:15:36,670 --> 00:15:38,500
!إيس

162
00:15:56,680 --> 00:15:58,060
!انتظر

163
00:15:59,890 --> 00:16:01,140
.خذ هذا

164
00:16:02,200 --> 00:16:04,560
.إنّه مفتاح أصفاد أخيك

165
00:16:04,560 --> 00:16:06,690
!أملك المفتاح

166
00:16:08,230 --> 00:16:10,030
!لوفي، كيف...؟

167
00:16:34,930 --> 00:16:36,800
!مـ-ما ذلك بالضّبط؟

168
00:16:39,430 --> 00:16:43,140
!انظروا! إنّ أميرال الأسطول سنغوكو يستخدم قوّته

169
00:16:43,140 --> 00:16:44,310
!لم أرها من قبل

170
00:16:50,820 --> 00:16:54,490
!لا يمكنك الهرب منّي

171
00:17:02,310 --> 00:17:04,330
!سنغوكو

172
00:17:04,330 --> 00:17:05,460
!بوذا عملاق

173
00:17:10,340 --> 00:17:14,880
لا أصدّق أنّك تملك حتّى مثل هذا
!الشّيء يا قبّعة القشّ لوفي

174
00:17:17,680 --> 00:17:19,240
!لا، المفتاح

175
00:17:19,240 --> 00:17:20,680
!استعدّوا

176
00:17:21,180 --> 00:17:23,980
!صوّبوا عليهم واستعدّوا للإطلاق فورًا

177
00:17:25,260 --> 00:17:27,730
!...مستحيل، المفتاح

178
00:17:28,640 --> 00:17:30,120
!قبّعة القشّ لوفي

179
00:17:30,750 --> 00:17:33,820
!أنت مجرم خطير ينبغي أن يعاقب بالموت أيضًا

180
00:17:35,340 --> 00:17:40,700
!سأعدمكما معًا أيّها الأخوان بيديّ هاتين

181
00:17:47,920 --> 00:17:51,750
...ما كان ذلك؟ أغمي عليّ فجأةً

182
00:17:54,690 --> 00:17:56,800
!...قبّعة القشّ

183
00:17:58,200 --> 00:18:00,320
!ثلاثة! لِمَ أنت هنا؟

184
00:18:08,310 --> 00:18:10,110
!ما ذلك؟

185
00:18:11,120 --> 00:18:13,700
!يا ثلاثة! احم إيس بجدار

186
00:18:13,700 --> 00:18:15,860
...فاكة المطّاط

187
00:18:17,360 --> 00:18:20,160
!البالون العملاق

188
00:18:23,990 --> 00:18:26,170
!جدار الشّمع

189
00:18:29,830 --> 00:18:31,290
!هل يتمدّد؟

190
00:18:42,100 --> 00:18:44,310
!المنصّة تنهار

191
00:18:44,310 --> 00:18:45,560
!ماذا حدث؟

192
00:18:46,080 --> 00:18:48,350
!ما زال إيس حيًّا

193
00:18:48,350 --> 00:18:50,330
!إنّنا نسقط

194
00:18:51,530 --> 00:18:55,780
!سأصنع المفتاح! فكّ وثاقه حالاً

195
00:18:56,620 --> 00:18:57,990
!حسنًا

196
00:18:57,990 --> 00:19:01,310
!أيّها القبطان باغي! إنّه الأخ 3

197
00:19:01,310 --> 00:19:05,740
!ماذا؟! ما الّذي يفعله في ذلك الزّيّ السّخيف؟

198
00:19:06,350 --> 00:19:09,080
!خلتُ أنّه هرب من هنا بالفعل

199
00:19:16,800 --> 00:19:21,220
لا بدّ أنّ إعدام قبضة النّار إيس له
!علاقة بهيبة مقرّ البحريّة

200
00:19:21,220 --> 00:19:23,050
!علينا أن ننهيه

201
00:19:25,320 --> 00:19:26,600
...كان أولئك

202
00:19:26,600 --> 00:19:28,560
!الجلاّدون

203
00:19:28,560 --> 00:19:30,890
!رنين، رنين، رنين... فتح

204
00:19:30,890 --> 00:19:36,110
!فهمت! أوقف الأميرال بورسالينو قبّعة القشّ في السّاحة

205
00:19:36,400 --> 00:19:37,900
!قبّعة القشّ؟

206
00:19:37,900 --> 00:19:41,800
!عليك أن تنقذ أخاك بأيّ ثمن

207
00:19:42,260 --> 00:19:45,660
!...سيّد 2

208
00:19:47,280 --> 00:19:49,660
حسنًا، ما العمل الآن؟

209
00:19:50,370 --> 00:19:52,750
!سننقذ قبّعة-تشان

210
00:19:54,580 --> 00:19:58,630
!لأنّني صديقه! لا أحتاج لأيّ سبب آخر

211
00:19:59,600 --> 00:20:01,420
أصدقاء؟

212
00:20:01,420 --> 00:20:04,970
.بون-تشان، إنّ البوّابة تغلق

213
00:20:07,410 --> 00:20:09,720
.نحن... علينا أن نذهب

214
00:20:12,600 --> 00:20:14,440
!شكرًا لك

215
00:20:14,440 --> 00:20:18,980
!قبّعة-تشان

216
00:20:17,110 --> 00:20:18,000
!بون-تشان

217
00:20:20,510 --> 00:20:23,610
!عليك أن تنقذ أخاك بأيّ ثمن

218
00:20:27,520 --> 00:20:29,960
.لم يهرب أبدًا

219
00:20:30,910 --> 00:20:34,690
!كرّم صداقته مع قبّعة القشّ

220
00:20:35,420 --> 00:20:38,190
!حسنًا، استعدّوا بسرعة

221
00:20:38,190 --> 00:20:39,390
!حاضر

222
00:20:57,610 --> 00:21:01,320
!أين الجلاّد الآخر؟! ما الّذي يؤخّره هكذا؟

223
00:21:01,320 --> 00:21:05,200
،بما أنّ الأمر كان مفاجئًا
...فهو يواجه مشاكل في الاستعداد

224
00:21:05,200 --> 00:21:07,520
!هيّا، أسرع

225
00:21:07,520 --> 00:21:09,160
!حسنًا، لنذهب

226
00:21:16,670 --> 00:21:23,170
،إن أخبرتك أنّني هنا احترامًا لرفيقي الرّاحل

227
00:21:23,170 --> 00:21:26,170
!هل ستسخر منّي؟

228
00:21:26,840 --> 00:21:29,050
!لا، لن أفعل

229
00:21:29,050 --> 00:21:32,770
!أطلقوا! فجّروهم

230
00:21:35,490 --> 00:21:37,600
!أنقذ أخاك يا قبّعة القشّ

231
00:21:37,600 --> 00:21:39,060
!حسنًا

232
00:21:39,730 --> 00:21:41,420
!لا

233
00:21:53,120 --> 00:21:54,830
!فتى قبّعة القشّ

234
00:21:54,830 --> 00:21:56,080
!مستحيل

235
00:21:56,540 --> 00:21:58,460
!إيس

236
00:22:00,620 --> 00:22:02,460
!أخي 3

237
00:22:02,460 --> 00:22:04,550
!أصيبوا جميعًا

238
00:22:05,370 --> 00:22:08,940
لا يمكن لقبضة النّار أن يستخدم قواه
!بسبب أصفاد الحجر البحريّ

239
00:22:08,940 --> 00:22:10,320
!لقد مات

240
00:22:10,320 --> 00:22:12,810
!كما نلنا من قبّعة القشّ

241
00:22:28,400 --> 00:22:31,870
!ثمّة نفق من النّار في الدخّان

242
00:22:32,950 --> 00:22:35,120
!لطالما كنت هكذا

243
00:22:35,580 --> 00:22:37,000
!يا لوفي

244
00:22:40,270 --> 00:22:42,920
...لم تصغ إليّ قطّ

245
00:22:48,040 --> 00:22:51,550
!ودائمًا ما فعلتَ أشياء جنونيّة

246
00:22:52,800 --> 00:22:54,060
!جيّد

247
00:22:54,060 --> 00:22:54,850
!يا إلهي

248
00:22:55,160 --> 00:22:57,180
!إيس

249
00:22:57,180 --> 00:22:59,850
!لـ-لا أصدّق هذا

250
00:22:59,850 --> 00:23:02,950
!قبّعة القشّ والأخ 3 حيّان أيضًا

251
00:23:13,540 --> 00:23:16,950
!إيس

252
00:23:25,440 --> 00:23:27,760
!تحرّر إيس أخيرًا

253
00:23:33,970 --> 00:23:38,170
،لكنّ اللّحية البيضاء الّذي ينظر إلى مستقبل ما زال بعيدًا

254
00:23:38,170 --> 00:23:40,350
.يتّخذ قرارًا من نفسه

255
00:23:40,350 --> 00:23:41,810
:في الحلقة القادمة من وان بيس

256
00:23:41,810 --> 00:23:45,090
"!تمّ إنقاذ إيس! أمر اللّحية البيضاء الأخير"

257
00:23:45,090 --> 00:23:47,360
!ملك القراصنة، لن يكون إلاّ أنا

258
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة