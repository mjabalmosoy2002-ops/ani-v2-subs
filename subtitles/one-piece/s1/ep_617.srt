1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,350 --> 00:02:38,690
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,690 --> 00:02:43,650
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:45,990 --> 00:02:52,370
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,370 --> 00:02:59,080
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,420 --> 00:03:06,590
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,590 --> 00:03:08,340
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:09,010 --> 00:03:12,470
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:17,480 --> 00:03:19,190
،رسا قراصنة قبّعة القشّ في بانك هازارد

37
00:03:19,190 --> 00:03:21,550
،جزيرة منقسمة إلى جزأين
.الأراضي المشتعلة والأراضي المتجمّدة

38
00:03:21,980 --> 00:03:26,900
.بعد علمهم بدافع حاكم الجزيرة سيزار كلاون

39
00:03:26,900 --> 00:03:30,240
،بينما يحاولون الهرب من شينوكوني

40
00:03:30,240 --> 00:03:34,160
،إلى جانب حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

41
00:03:34,160 --> 00:03:37,250
،إنّهم في طريقهم لاختطاف سيزار

42
00:03:37,250 --> 00:03:41,170
.وإنقاذ الأطفال والهرب من الجزيرة

43
00:03:42,300 --> 00:03:46,870
!فذلك القرصان المجنون يدعمني

44
00:03:46,870 --> 00:03:50,890
!أحد الشّيتشيبوكاي الملكيّين، دونكيهوتي دوفلامينغو

45
00:03:51,140 --> 00:03:53,040
...أخبرتك

46
00:03:55,600 --> 00:03:58,230
!أنّني لا أهتمّ

47
00:04:10,320 --> 00:04:13,570
!لقد كسرت... التّرس

48
00:04:14,280 --> 00:04:16,820
،والآن

49
00:04:17,700 --> 00:04:19,470
!ما عادت هنالك رجعة

50
00:04:20,000 --> 00:04:29,020
!هزيمة سيزار
ماغنوم الدّبّ الأشيب القويّ

51
00:04:21,790 --> 00:04:26,370
"!هزيمة سيزار! ماغنوم الدّبّ الأشيب القويّ"

52
00:04:29,550 --> 00:04:33,280
.سيملأ الغاز السّامّ شينوكوني المبنى في غضون خمس دقائق

53
00:04:34,100 --> 00:04:37,560
،"وكلّ النّاجين متّجهون صوب مبنى "ر

54
00:04:37,560 --> 00:04:41,100
...إلى البوّابة "ر-66"، المخرج الوحيد. ولكن

55
00:05:00,290 --> 00:05:01,910
!ارتفع السّقف للتّوّ

56
00:05:02,960 --> 00:05:04,540
!ما الّذي حدث؟

57
00:05:07,670 --> 00:05:10,420
!بدأ الغاز يتسرّب من الشّقوق

58
00:05:10,640 --> 00:05:11,880
.هذا ليس جيّدًا

59
00:05:11,880 --> 00:05:13,930
!جميعًا! اذهبوا إلى المبنى "ر" الآن

60
00:05:13,930 --> 00:05:14,950
!اهربوا

61
00:05:14,950 --> 00:05:17,150
!لكنّي خائفة يا أختي

62
00:05:19,470 --> 00:05:21,680
!لا أستطيع الرّكض أكثر

63
00:05:21,910 --> 00:05:24,770
!لا نملك الوقت للبكاء يا أطفال

64
00:05:24,770 --> 00:05:25,840
!قفوا واهربوا

65
00:05:25,840 --> 00:05:27,280
!لا تستسلموا يا رفاق

66
00:05:27,280 --> 00:05:28,760
!قفوا! الآن

67
00:05:35,710 --> 00:05:37,120
!النّقيب-تشان

68
00:05:37,120 --> 00:05:38,400
!حمدًا لله لأنّك بخير

69
00:05:38,400 --> 00:05:40,240
!هزمت تلك المرأة الطّائر إذًا؟

70
00:05:40,490 --> 00:05:43,420
!لكن لِمَ هما قادمان من هذا الاتّجاه؟

71
00:05:43,420 --> 00:05:45,830
!يفترض أنّهما كانا خلفنا لكي يمنحانا فرصة للهرب

72
00:05:46,390 --> 00:05:48,380
!جي-5 قادمون من هذا الاتّجاه؟

73
00:05:48,380 --> 00:05:50,940
!أخبرتك أنّنا ذاهبان في الاتّجاه الخطأ

74
00:05:51,560 --> 00:05:54,750
!غير ذلك، أ-أنزلني! هذا محرج

75
00:05:54,750 --> 00:05:57,260
!هذا مزعج! ظلّي ثابتة فحسب

76
00:05:57,260 --> 00:06:02,470
أنت! من أعطاك الإذن بحمل
!تاشيغي-تشان على كتفك؟

77
00:06:02,470 --> 00:06:03,870
!زورو! عد

78
00:06:08,050 --> 00:06:09,080
!أسرعوا جميعًا

79
00:06:09,080 --> 00:06:10,530
!من هنا

80
00:06:32,730 --> 00:06:34,760
كسرت التّرس"؟"

81
00:06:35,310 --> 00:06:37,610
ما عادت هنالك رجعة"؟"

82
00:06:38,200 --> 00:06:39,700
.هذا هيستيريّ

83
00:07:01,590 --> 00:07:03,160
!اعرف حجمك

84
00:07:03,240 --> 00:07:04,410
!يا لو

85
00:07:09,940 --> 00:07:11,420
!سينهار السّقف

86
00:07:11,840 --> 00:07:14,630
!تشوبّر-يان، البقاء هنا ليس آمنًا

87
00:07:14,920 --> 00:07:17,840
!نعم! بذلتُ كلّ ما في جهدي الآن

88
00:07:18,110 --> 00:07:19,680
!"اذهبوا إلى المبنى "ر

89
00:07:19,680 --> 00:07:23,280
!حسنًا، اعتمد علينا! هيّا بنا يا رجال

90
00:07:23,280 --> 00:07:24,350
!أجل

91
00:07:27,230 --> 00:07:30,440
!موتشا! تماسكي! لنخرج من هنا

92
00:07:35,690 --> 00:07:37,330
.سحقًا

93
00:07:37,740 --> 00:07:40,410
كيف سأتناول الفطور غدًا؟

94
00:07:42,190 --> 00:07:44,300
.يا له من تحوّل مريع في الأحداث

95
00:07:48,210 --> 00:07:51,130
كيف تجرؤ يا لو؟

96
00:07:51,920 --> 00:07:54,550
.هذا مزعج

97
00:07:58,260 --> 00:08:00,720
.لكنّي على يقين أنّك ستندم

98
00:08:01,260 --> 00:08:03,330
.تذكّر ذلك جيّدًا

99
00:08:05,390 --> 00:08:08,740
.لا تعرف ماضي جوكر

100
00:08:09,370 --> 00:08:12,180
!وذلك سيكلّفك حياتك

101
00:08:17,500 --> 00:08:20,370
لا يمكن لحديثي النّعمة من أمثالك
أدركوا لتوّهم شعلةً من الشّهرة

102
00:08:20,370 --> 00:08:22,280
.أن يأملوا في السّيطرة على العالم

103
00:08:22,280 --> 00:08:24,440
.فهو يعجّ بمن هم أقوى منك

104
00:08:24,440 --> 00:08:27,200
.أخبره يا سموكر

105
00:08:31,810 --> 00:08:34,190
.أنتم مفعمون بالحيويّة ليس إلاّ أيّها الأشقياء

106
00:08:34,190 --> 00:08:35,000
...لكنّ هذا العالم

107
00:08:38,800 --> 00:08:41,000
.لا تقلق بشأني

108
00:08:41,590 --> 00:08:43,530
.اقلق على نفسك فحسب

109
00:08:54,730 --> 00:08:57,440
.فهذه الغرفة ستنفجر

110
00:08:58,140 --> 00:09:01,120
!وداعًا أيّها القرصان فيرغو

111
00:09:16,040 --> 00:09:18,240
ما كان ذلك؟

112
00:09:19,460 --> 00:09:22,220
!شـ-شيء ما يسقط

113
00:09:28,890 --> 00:09:30,980
!أعرف من فعل هذا

114
00:09:32,350 --> 00:09:34,270
.لا بدّ أنّه لو

115
00:09:38,570 --> 00:09:40,230
!ما الّذي يفعله فيرغو؟

116
00:09:40,320 --> 00:09:42,610
!سيّدي! ما الّذي يجري؟

117
00:09:42,610 --> 00:09:45,080
!بعضنا مدفونون أسفل الأنقاض

118
00:09:45,080 --> 00:09:46,240
!سيّدي

119
00:09:46,240 --> 00:09:48,700
!سحقًا

120
00:09:48,700 --> 00:09:53,210
!لقد أفسدتم "نعيمي" أيّها الحقيرون

121
00:09:53,790 --> 00:09:55,700
.أتساءل إن كان الجميع بخير

122
00:10:07,160 --> 00:10:09,470
!يجب أن أستغلّ هذا الارتباك

123
00:10:09,780 --> 00:10:10,430
!دحرجة

124
00:10:11,690 --> 00:10:15,300
.حسنًا. والآن لنبحث عن أصفاد الحجر البحريّ

125
00:10:17,060 --> 00:10:18,310
!هذا لا يعقل

126
00:10:21,990 --> 00:10:23,820
!اختفى عضو طاقم قبّعة القشّ

127
00:10:23,820 --> 00:10:24,360
!أين ذهب؟

128
00:10:24,360 --> 00:10:25,320
!جدوه

129
00:10:26,660 --> 00:10:29,200
يا من في الطّابق الثّاني من المبنى "ر"، هل تسمعونني؟

130
00:10:29,420 --> 00:10:31,330
!إنّه السّيّد

131
00:10:31,330 --> 00:10:34,830
!إن كان السّيّد بخير، فسنكون بخير

132
00:10:35,060 --> 00:10:37,630
!الغرفة السّرّيّة، حوّل

133
00:10:37,630 --> 00:10:40,460
نعم يا سيّدي، ماذا حدث؟

134
00:10:40,710 --> 00:10:42,630
!افتحوا فتحات التّهوية الآن

135
00:10:44,380 --> 00:10:49,130
!دعوا شينوكوني يتدفّق إلى هذه الغرفة

136
00:10:49,130 --> 00:10:51,160
...لـ-لكنّ ذلك سوف

137
00:10:51,160 --> 00:10:53,980
.أنا رجل غاز. لن أموت

138
00:10:54,480 --> 00:10:55,800
!عـ-عُلم

139
00:10:56,230 --> 00:10:58,530
!إذًا لننقل رفاقنا الجنود إلى الطّابق الأوّل أوّلاً

140
00:10:58,530 --> 00:10:59,960
!"قلتُ "فورًا

141
00:11:00,910 --> 00:11:03,480
!"قلتُ "نفّذوا حالاً

142
00:11:04,090 --> 00:11:06,860
!كفّوا عن التّذمّر ونفّذوا حالاً

143
00:11:07,110 --> 00:11:10,410
!لكن هناك أزيد من مئة جنديّ

144
00:11:10,410 --> 00:11:12,410
!لا يهمّني ذلك أيّها الأحمق

145
00:11:12,410 --> 00:11:14,790
!ما أنتم إلاّ حفنة من فئران التّجارب

146
00:11:14,790 --> 00:11:18,120
!لا يهتمّ أحد إن مات مئات منكم

147
00:11:18,120 --> 00:11:20,040
!فأنتم حثالة المجتمع

148
00:11:38,770 --> 00:11:41,830
!ماذا تفعلون؟! ألا تسمعونني؟

149
00:11:42,690 --> 00:11:46,820
!يمكنني أن أجد بدائلكم بسهولة أيّها الحمقى

150
00:11:54,330 --> 00:11:57,660
!شينوكوني هو قوّتي الحقيقيّة

151
00:12:05,710 --> 00:12:07,720
!كان ذلك وشيكًا

152
00:12:11,180 --> 00:12:14,360
.أصبحوا يعرفون الآن من هو سيزار حقًّا

153
00:12:15,770 --> 00:12:16,850
!زورو والبقيّة

154
00:12:19,130 --> 00:12:21,730
!إنّهم في خطر حقًّا

155
00:12:22,750 --> 00:12:26,070
هل أستطيع أن أتحكّم بالأبواب من هنا يا ترى؟

156
00:12:35,930 --> 00:12:39,460
ماذا؟ أنت! لِمَ تنظر إليّ هكذا؟

157
00:12:39,460 --> 00:12:42,180
...ماذا؟ لـ-لا، أنا

158
00:12:45,660 --> 00:12:47,330
!فهمت

159
00:12:48,160 --> 00:12:50,880
!يحاول السّيّد خداع الأعداء

160
00:12:50,880 --> 00:12:51,790
ماذا؟

161
00:12:52,680 --> 00:12:54,600
!صحيح! معك حقّ

162
00:12:54,760 --> 00:12:57,550
!لا بدّ أنّ لديه خطّة بشأن الغاز القاتل أيضًا

163
00:12:57,550 --> 00:13:00,310
!لن يدعه رجاله يموتون

164
00:13:00,720 --> 00:13:01,980
!صحيح، صحيح

165
00:13:02,060 --> 00:13:05,820
.السّيّد رجل عطوف. سيُجرح إن عرف أنّنا شككنا به

166
00:13:10,480 --> 00:13:13,110
!سيّدي! فتحت فتحات التّهوية

167
00:13:17,490 --> 00:13:19,660
!لا! الغاز القاتل

168
00:13:19,660 --> 00:13:20,660
!إنّه يتسرّب

169
00:13:20,830 --> 00:13:24,330
!أجل. كان يجب أن تفعلوا ذلك من البداية

170
00:13:24,330 --> 00:13:26,590
!لا يجب على الحثالة أن يفكّروا

171
00:13:29,660 --> 00:13:34,380
!والآن، أصبِح قوّتي! شينوكوني

172
00:14:14,760 --> 00:14:19,010
!هذه قوّتي العِلميّة

173
00:14:54,510 --> 00:14:55,840
.إنّه يعمل

174
00:15:05,600 --> 00:15:10,570
!انظر يا قبّعة القشّ لوفي! انظر لهذا المظهر المذهل

175
00:15:11,190 --> 00:15:13,790
!هذه قوّتي العِلميّة

176
00:15:15,490 --> 00:15:17,590
،من خلال هذه التّجربة

177
00:15:17,590 --> 00:15:22,500
.أبدتْ دولتان بالفعل اهتمامها بالسّلاح، شينوكوني

178
00:15:23,080 --> 00:15:25,290
.كلتاهما مسالمتان للغاية

179
00:15:26,160 --> 00:15:30,920
،لكن عندما يصبح البشر جادّين بشأن حماية أنفسهم

180
00:15:30,920 --> 00:15:33,800
!فسيبحثون عن أيّ وسيلة لقتل أعدائهم

181
00:15:34,970 --> 00:15:37,980
!الجميع بحاجتي

182
00:15:38,550 --> 00:15:41,260
سأنشر الأسلحة من حول العالم أجمع

183
00:15:41,260 --> 00:15:44,970
!وأصبح ملك أرض الموت، أي شينوكوني

184
00:15:48,480 --> 00:15:49,310
!انظر

185
00:15:52,900 --> 00:15:54,010
!اهربوا

186
00:15:58,150 --> 00:15:59,280
...لا

187
00:16:07,160 --> 00:16:08,580
!قتل رفاقنا الجنود

188
00:16:08,580 --> 00:16:09,770
!ما الّذي يفعله؟

189
00:16:09,890 --> 00:16:11,040
!سيّدي

190
00:16:12,540 --> 00:16:15,960
هل يعتبرنا فئران تجارب فعلاً؟

191
00:16:18,510 --> 00:16:21,930
!هذا مذهل برأيي

192
00:16:21,930 --> 00:16:25,280
!انظر كم يؤثّر ذلك على أعصابهم بسرعة

193
00:16:25,280 --> 00:16:26,890
!يكاد يكون هذا فنًّا

194
00:16:29,990 --> 00:16:33,260
مـ-ما... ما كان ذلك؟

195
00:16:33,260 --> 00:16:34,730
...أولئك النّاس

196
00:16:42,870 --> 00:16:44,810
.مومو، اعتن باللّحية البنّيّة

197
00:16:44,810 --> 00:16:46,040
!ماذا؟ حسنًا

198
00:16:49,760 --> 00:16:53,330
!أنت، إلى أين أنت ذاهب يا قبّعة القشّ لوفي؟

199
00:16:55,500 --> 00:16:57,980
!هل اعتراك الخوف فجأةً؟

200
00:16:57,980 --> 00:17:00,230
!يا لك من رجل مثير للشّفقة

201
00:17:01,130 --> 00:17:06,430
لكنّ المبنى "ب" خلف ذلك الطّريق
!يكاد يمتلئ عن آخره بشينوكوني

202
00:17:07,410 --> 00:17:11,450
!ما عاد هناك ملاذ آمن في الجزيرة

203
00:17:12,560 --> 00:17:15,520
!وذات الأمر ينطبق على فئران التّجارب أيضًا

204
00:17:23,610 --> 00:17:25,370
،جميعكم

205
00:17:25,960 --> 00:17:27,410
...ستموتون

206
00:17:29,240 --> 00:17:30,840
!كالقمامة

207
00:17:35,950 --> 00:17:38,880
!هذا هو السّيّد الحقيقيّ؟

208
00:17:43,800 --> 00:17:45,010
!سيّدي

209
00:17:45,950 --> 00:17:49,220
!وثقت به أيضًا

210
00:17:50,850 --> 00:17:55,440
المعذرة. أعرف أنّكم متألّمون لكن
هلاّ جلست على كرسيّ التّحكّم ذاك؟

211
00:17:57,190 --> 00:17:59,610
!أريد إنقاذ أصدقائي من الغاز

212
00:17:59,790 --> 00:18:00,920
!أيّها الوغد

213
00:18:00,920 --> 00:18:04,070
!كنت تشاهد الأمر، أليس كذلك؟ سحقًا

214
00:18:04,070 --> 00:18:06,450
.توقّفوا! جميعكم شاهدتم أيضًا

215
00:18:06,450 --> 00:18:11,160
!أجل، معك حقّ. غُدرنا غدرًا شنيعًا

216
00:18:11,320 --> 00:18:12,770
.انتهى أمرنا

217
00:18:12,770 --> 00:18:14,890
...ندري الآن أنّه كان عدوّنا ولكن

218
00:18:16,120 --> 00:18:18,340
!لا يمكننا الهرب من هنا

219
00:18:18,610 --> 00:18:21,090
!وكذلك أنتم

220
00:18:21,090 --> 00:18:24,970
!ألم ترَ قبطانك للتّوّ وهو يهرب من سيزار؟

221
00:18:25,750 --> 00:18:26,870
!نلتم ما تستحقّون

222
00:18:26,870 --> 00:18:30,180
!لقد نفذ بجلده وتخلّى عنكم

223
00:18:31,020 --> 00:18:36,690
رويدكم، هل تقلّلون من احترام قبطاننا أمامي؟

224
00:18:42,320 --> 00:18:46,950
،إن كان من النّوع الّذي قد يغدر بنا

225
00:18:46,950 --> 00:18:49,180
.لكان الأمر أسهل عليّ

226
00:18:51,580 --> 00:18:54,330
!حينها كنتُ لأهرب بكلّ سرعتي

227
00:18:54,330 --> 00:18:56,080
!المستوى الثّالث

228
00:18:58,240 --> 00:19:00,670
...لكنّه لا يكفّ أبدًا

229
00:19:01,710 --> 00:19:05,340
...عن الإيمان بنا

230
00:19:06,340 --> 00:19:09,180
.لذا لم يكن لدينا خيار سوى مساندته

231
00:19:09,800 --> 00:19:13,140
!أقسمنا أن نكون عند حسن ظنّه ما دام فينا عرق ينبض

232
00:19:20,360 --> 00:19:22,310
...سيّدي، أرجوك لا

233
00:19:27,740 --> 00:19:31,450
!ما أنتم سوى بقايا. لا يجب أن تعارضوا سيّدكم

234
00:19:31,920 --> 00:19:35,460
!موتوا ميتةَ الكلاب فحسب

235
00:19:39,630 --> 00:19:41,840
ما العمل؟

236
00:19:41,840 --> 00:19:43,670
.لا يوجد ما في استطاعتنا فعله

237
00:19:44,160 --> 00:19:46,690
!لا يمكننا هزيمة رجل قويّ مثله

238
00:19:46,690 --> 00:19:47,970
!بلى تستطيعون

239
00:19:48,840 --> 00:19:51,550
!عليكم أن تؤمنوا بقبطاننا فحسب

240
00:19:58,850 --> 00:20:00,060
...إنّ سيزار

241
00:20:00,630 --> 00:20:03,970
!من النّوع الّذي يكرهه لوفي كرهًا جمًّا

242
00:20:07,740 --> 00:20:09,700
!أ-أنقذني يا سيّدي

243
00:20:09,700 --> 00:20:10,620
!أجل

244
00:20:12,300 --> 00:20:14,660
!أنا هو سيّدكم

245
00:20:14,660 --> 00:20:20,340
!أنا منقذكم وأستطيع أن أستفيد منكم يا عديمي الفائدة

246
00:20:27,270 --> 00:20:30,180
!لن يسامح لوفي سيزار

247
00:20:30,630 --> 00:20:32,880
!لون التّسلّح، التّصليب

248
00:20:43,490 --> 00:20:47,360
!سيزار

249
00:20:49,490 --> 00:20:53,030
!عدتَ إذًا يا قبّعة القشّ لوفي

250
00:20:53,260 --> 00:20:56,200
!لا أريد أن أرى وجهك ثانيةً أبدًا

251
00:20:56,530 --> 00:21:00,670
!سيكون موتك ذروة عرض التّجربة هذا

252
00:21:08,300 --> 00:21:10,130
!مُت

253
00:21:10,680 --> 00:21:13,970
...فاكهة المطّاط

254
00:21:20,090 --> 00:21:23,600
!ماغنوم الدّبّ الأشيب

255
00:21:46,300 --> 00:21:50,210
!والآن، فلتمت! اشهد قوّتي العلميّة

256
00:21:51,240 --> 00:21:55,090
!اركع أمام قوّتي

257
00:22:03,100 --> 00:22:04,810
!اخرس

258
00:22:23,870 --> 00:22:26,090
!صحيح يا قبّعة القشّ

259
00:22:26,420 --> 00:22:29,840
...يمكنك العمل تحت رايتي إن أردت

260
00:23:10,840 --> 00:23:12,710
.سحق لوفي سيزار

261
00:23:13,220 --> 00:23:14,220
...تنتشر الأخبار الصّادمة

262
00:23:14,220 --> 00:23:16,980
.حول العالم الجديد في طرفة عين

263
00:23:16,980 --> 00:23:18,530
...في نفس الأثناء

264
00:23:18,530 --> 00:23:20,530
...قاتل أُرسِل من قبل دوفلامينغو

265
00:23:20,530 --> 00:23:23,020
.يطير صوب جزيرة بانك هازارد

266
00:23:23,020 --> 00:23:26,230
!تستعرّ عاصفة المعركة الجديدة

267
00:23:26,230 --> 00:23:27,810
:في الحلقة القادمة من وان بيس

268
00:23:27,810 --> 00:23:30,300
"!غارة! قاتل من دريسروزا"

269
00:23:30,300 --> 00:23:32,440
!ملك القراصنة، لن يكون إلاّ أنا

270
00:23:36,030 --> 00:23:41,030
!!نراكم في الحلقة القادمة