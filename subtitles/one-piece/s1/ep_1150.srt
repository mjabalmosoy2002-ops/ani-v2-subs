1
00:01:29,770 --> 00:01:32,020
!اليوم يوم جميل بالفعل

2
00:01:32,020 --> 00:01:34,860
!أودّ الخروج في نزهة مع أخي تشو

3
00:01:34,860 --> 00:01:39,420
!مرحبًا

4
00:01:45,580 --> 00:01:49,850
!وحش جزرة

5
00:01:50,210 --> 00:01:53,880
!استيقظتِ أخيرًا يا كاروت-سِنباي

6
00:01:53,880 --> 00:01:57,560
ماذا؟ ومن أنت-تيا؟

7
00:01:57,560 --> 00:02:00,670
!أنا بارتولوميو

8
00:02:00,670 --> 00:02:03,930
لكنّ الأهمّ، لماذا واحدة
،من أصدقاء لوفي-سِنباي

9
00:02:03,930 --> 00:02:07,720
الّذي أقدّره كثيرًا، تنام على سفينتنا؟

10
00:02:08,390 --> 00:02:11,550
!أنا من استدعاها إلى هنا

11
00:02:12,440 --> 00:02:15,900
!مرحبًا بكم في عرين مسابقة الأسئلة

12
00:02:15,900 --> 00:02:17,720
عرين مسابقة الأسئلة؟

13
00:02:18,030 --> 00:02:19,640
ومن أنت؟

14
00:02:19,860 --> 00:02:24,020
،أنا سيّد عرين مسابقة الأسئلة

15
00:02:23,550 --> 00:02:29,950
كيو

16
00:02:24,080 --> 00:02:27,990
!"واسمي هو "كيو

17
00:02:27,980 --> 00:02:29,490
كيو؟

18
00:02:33,830 --> 00:02:38,920
هل هذا الفيديو هو الّذي يُبثّ
في أرجاء العالم من طرف فيغابانك؟

19
00:02:38,920 --> 00:02:41,980
!إجابة صحيحة

20
00:02:41,980 --> 00:02:44,380
ستقومون بالإجابة في مسابقة أسئلة

21
00:02:44,380 --> 00:02:48,550
.عن رسالة فيغابانك هذه

22
00:02:48,640 --> 00:02:50,180
مسابقة أسئلة؟

23
00:02:50,180 --> 00:02:52,770
!لا يهمّني من تكون

24
00:02:52,770 --> 00:02:56,020
!لا يُسمح لأيّ أحد باستعمال سفينتنا

25
00:02:56,020 --> 00:02:58,860
أتريد الاستمتاع بوقتك؟
!قم بذلك في مكان آخر

26
00:02:58,860 --> 00:03:03,230
.أنا جادّ تمامًا يا بارتولوميو-كُن

27
00:03:04,820 --> 00:03:07,940
!هذا تشوبّر-سِنباي

28
00:03:09,080 --> 00:03:12,860
لماذا أخي تشو خلف القضبان؟

29
00:03:12,870 --> 00:03:15,540
.ستكون في المسابقة خمسة أسئلة

30
00:03:15,540 --> 00:03:18,850
...وفي حالة تقديم إجابة خاطئة

31
00:03:18,850 --> 00:03:22,550
!ما-ماذا؟! أخي تشو؟

32
00:03:22,550 --> 00:03:24,380
ما الّذي تنوي فعله؟

33
00:03:24,380 --> 00:03:30,300
.شغفي الكبير هو تحنيط الحيوانات النّادرة

34
00:03:32,060 --> 00:03:35,230
.لا يبدو أنّه يمزح على الإطلاق

35
00:03:35,230 --> 00:03:37,720
ماذا نفعل يا كاروت-سِنباي؟

36
00:03:39,020 --> 00:03:40,680
....أخي تشو

37
00:03:41,190 --> 00:03:43,320
!أنا موافقة

38
00:03:43,320 --> 00:03:46,360
،وإن أجبتُ على كلّ أسئلتك بشكل صحيح

39
00:03:46,360 --> 00:03:48,820
!ستطلق سراح أخي تشو

40
00:03:48,820 --> 00:03:50,870
.هذا وعد

41
00:03:50,870 --> 00:03:53,950
!من الأفضل أن تفعل يا كيو-تارو

42
00:03:54,330 --> 00:03:58,330
لماذا أضفت تارو لاسمي؟ وما معنى تارو؟

43
00:03:58,330 --> 00:04:00,620
.اصبر يا أخي تشو

44
00:04:02,300 --> 00:04:05,400
!سأنقذك بكلّ تأكيد

45
00:04:07,140 --> 00:04:13,010
!سجلّ مغامرات الدّكتور تشوبر"
"~السّجلاّت الأخيرة الّتي تركها العبقريّ~

46
00:04:22,400 --> 00:04:24,000
...إنّ هذه الجزيرة

47
00:04:25,200 --> 00:04:27,550
.صارت تعجّ بالكثير من مصادر الإزعاج لنا

48
00:04:28,620 --> 00:04:33,490
يبدو أنّ إيغهيد هي الجزيرة
.الّتي يوجد فيها لوفي وطاقه الآن

49
00:04:33,490 --> 00:04:34,620
.نعم

50
00:04:34,620 --> 00:04:37,620
لكنّ القدّيس ساترن أمر بإطلاق

51
00:04:37,620 --> 00:04:40,440
!نداء الدّماء على الجزيرة

52
00:04:40,750 --> 00:04:43,770
!احرصوا أن تغادروا يا لوفي-سِنباي بسلام

53
00:04:45,230 --> 00:04:49,130
يسعى القدّيس ساترن خلف رأس
فيغابانك الّذي خالف القانون

54
00:04:49,130 --> 00:04:52,420
!ببحوث محرّمة عن الماضي

55
00:04:58,600 --> 00:05:00,260
!فيغابانك

56
00:05:01,440 --> 00:05:02,790
!عجوز التّفّاحة

57
00:05:16,120 --> 00:05:18,710
،معكم الدّكتور فيغابانك

58
00:05:18,710 --> 00:05:21,520
.عالِم عبقريّ بسيط

59
00:05:21,520 --> 00:05:26,130
،أعلم أنّ الكثير منكم سيُصدمون برسالتي هذه

60
00:05:26,170 --> 00:05:27,940
...لكنّها الحقيقة

61
00:05:28,170 --> 00:05:30,670
!حقيقة هذا العالم

62
00:05:32,220 --> 00:05:35,780
إن لم تخُنّي الذّاكرة، فقد خطّط فيغابانك

63
00:05:36,100 --> 00:05:40,020
لبثّ هذه الرّسالة في أنحاء العالم
.في حالة حدوث شيء ما له

64
00:05:40,020 --> 00:05:44,680
!إنّه لا يملك أكبر دماغ في العالم من فراغ

65
00:05:46,030 --> 00:05:48,020
!توقّف الفيديو

66
00:05:48,440 --> 00:05:52,110
!لنبدأ مسابقة الأسئلة

67
00:05:52,450 --> 00:05:54,030
:السّؤال الأوّل

68
00:05:54,700 --> 00:06:00,030
.تُسمّى إيغهيد بالجزيرة الميكانيكيّة

69
00:06:00,160 --> 00:06:04,540
،اذهبوا يسارًا إن كان ذلك صحيحًا
!ويمينًا إن كان خاطئًا

70
00:06:05,420 --> 00:06:08,050
هل تعرفين الجواب يا كاروت-سِنباي؟

71
00:06:08,050 --> 00:06:10,170
ما كان يا ترى...؟

72
00:06:10,170 --> 00:06:12,340
!لا أتذكّر على الإطلاق

73
00:06:12,340 --> 00:06:15,220
...سبق وتحدّثنا عن ذلك

74
00:06:15,220 --> 00:06:17,760
.بقيت لديكم 10 ثوان فحسب

75
00:06:17,760 --> 00:06:20,510
...لحظة... لحظة

76
00:06:21,020 --> 00:06:24,890
هذا ليس الوقت المناسب للأكل
!يا كاروت-سِنباي

77
00:06:25,230 --> 00:06:27,420
!لا تأخذ جزرتي

78
00:06:28,480 --> 00:06:30,730
!هذا مؤلم

79
00:06:31,030 --> 00:06:33,060
!مهلاً... كلاّ

80
00:06:33,070 --> 00:06:35,240
...انتهى الوقت

81
00:06:35,240 --> 00:06:37,840
!وكان ذلك خاطئًا

82
00:06:38,660 --> 00:06:40,610
ماذا؟ أجوابنا صحيح؟

83
00:06:40,680 --> 00:06:56,400
جزيرة المستقبل

84
00:06:40,750 --> 00:06:43,440
.تُسمّى إيغهيد بجزيرة المستقبل

85
00:06:43,440 --> 00:06:45,040
!يا لحظّك

86
00:06:45,040 --> 00:06:48,660
!وقفنا في المكان الصّحيح بالصّدفة

87
00:06:51,050 --> 00:06:53,290
.كلّ هذا بفضل هذه الجزرة

88
00:06:53,300 --> 00:06:56,400
.هيّا، لنواصل ركوب هذا الزّخم

89
00:06:57,220 --> 00:06:59,670
...ولاختصار هذه القصّة الطّويلة

90
00:07:00,220 --> 00:07:02,220
...فسأقول أنّ هذا العالم

91
00:07:02,980 --> 00:07:06,220
.محتّم عليه أن يغرق تحت البحر

92
00:07:06,270 --> 00:07:09,150
سيغرق العالم تحت البحر؟

93
00:07:09,150 --> 00:07:11,850
ما الّذي يعنيه بذلك؟

94
00:07:12,070 --> 00:07:14,510
هل ينطبق ذلك على زو أيضًا؟

95
00:07:14,510 --> 00:07:18,470
إن افترضنا أنّ أجهزة استشعاري
،وحساباتي جيّدة

96
00:07:19,330 --> 00:07:23,790
سيهزّ زلزال كبير العالم بأكمله
.بشكل لا نظير له

97
00:07:23,960 --> 00:07:25,770
،وبشكل متناسب مع الزّلزال

98
00:07:25,770 --> 00:07:29,460
سيرتفع مستوى البحر في العالم
،بحوالي متر واحد

99
00:07:29,500 --> 00:07:32,650
.ما سيجعل بعض الجُزر غير قابلة للعيش

100
00:07:32,970 --> 00:07:36,490
هذا الزّلزال بالتّحديد هو ليس
ما يمكن وصفه بظاهرة طبيعيّة

101
00:07:36,490 --> 00:07:38,950
!على وجه الخصوص

102
00:07:39,810 --> 00:07:41,770
هل توقّف ثانية؟

103
00:07:41,770 --> 00:07:43,600
!لا بدّ أنّه وقت السّؤال

104
00:07:43,600 --> 00:07:45,180
:السّؤال الثّاني

105
00:07:46,600 --> 00:07:50,020
،مِن بين الخيارات التّالي

106
00:07:50,020 --> 00:07:54,020
من قاتَل كيزارو على إيغهيد
لحماية فيغابانك؟

107
00:07:54,780 --> 00:07:58,870
.الجواب أ، ساكازوكي. الجواب ب، كوزان

108
00:07:58,870 --> 00:08:01,610
.أو الجواب ج، سِنتومارو

109
00:08:01,610 --> 00:08:03,270
!هنالك ثلاثة أجوبة

110
00:08:03,290 --> 00:08:05,410
...حسنًا... حسنًا

111
00:08:07,290 --> 00:08:10,230
!نسيت ثانية

112
00:08:10,230 --> 00:08:13,660
!ركّزي على شيء آخر غير الجزر

113
00:08:13,800 --> 00:08:17,430
.تبدين في وضع سيّئ يا آنستي الحسناء

114
00:08:17,430 --> 00:08:18,540
ماذا؟

115
00:08:19,890 --> 00:08:23,130
.أخبريني إن كان بإمكاني مساعدتك بأيّ طريقة

116
00:08:23,130 --> 00:08:26,840
.أنا أدعم مُعجبِيّ دائمًا

117
00:08:26,850 --> 00:08:30,060
ما الّذي تفعله هنا يا ملفوف؟

118
00:08:30,060 --> 00:08:32,060
!اسمي كافنديش

119
00:08:32,190 --> 00:08:36,650
أتى بي فضولي إلى هذه السّفينة
!الّتي تفتقر لأيّ حسّ بالأناقة

120
00:08:36,650 --> 00:08:41,510
!عمّ تتحدّث؟ سفينتنا الأروع على الإطلاق

121
00:08:41,510 --> 00:08:44,280
!ولن ينسوا من مرّوا بها روعتها أبدًا

122
00:08:44,330 --> 00:08:47,160
ينسوا... مرّوا؟

123
00:08:47,370 --> 00:08:49,830
!عرفتُ الإجابة

124
00:08:49,920 --> 00:08:53,120
!الجواب الصّحيح هو ج، سِنتومارو

125
00:08:54,300 --> 00:09:18,400
سِنتومارو

126
00:08:56,300 --> 00:08:58,670
!جواب صحيح

127
00:08:59,640 --> 00:09:01,350
!مذهل

128
00:09:01,350 --> 00:09:05,470
!شكرًا! ساعدتني-تيا على التّذكّر

129
00:09:05,930 --> 00:09:07,890
...لا أرى كيف

130
00:09:08,060 --> 00:09:12,470
،سواء رغبتْ في ذلك أم لا
!خُلقت النّجوم لتلمع

131
00:09:12,480 --> 00:09:16,980
.ناديني إن واجهت مشكلة أخرى
!مع السّلامة

132
00:09:18,740 --> 00:09:23,660
أنا أقصد بالتّحديد ما حدث
...في المائة سنة بين حوالي 800 سنة

133
00:09:23,660 --> 00:09:25,760
.و900 سنة قبل وقتنا هذا

134
00:09:26,250 --> 00:09:30,430
.إنّها أحداث تمّ حذفها بالكامل من تاريخنا

135
00:09:30,920 --> 00:09:33,390
،تُسمّى هذه الفترة بالقرن الفارغ

136
00:09:33,390 --> 00:09:36,610
.وقد مُحيت كلّ السّجلاّت عنه

137
00:09:36,880 --> 00:09:39,820
إن الوسيلة الوحيدة لكشف السّتار
...عن هذا التّاريخ

138
00:09:40,300 --> 00:09:44,760
هي العثور على رسائل من الماضي
...على شكل بونيغليف

139
00:09:44,760 --> 00:09:48,280
.منتشرة في أرجاء العالم

140
00:09:48,560 --> 00:09:51,040
ولكنّ فكّ شيفرة البونيغليف

141
00:09:51,230 --> 00:09:55,040
.ممنوع منعًا باتًّا من طرف حكومة العالم

142
00:09:55,040 --> 00:09:58,270
،ورغم أنّي أعدّ إلى جانب الحكومة

143
00:09:58,270 --> 00:10:00,670
.عارضتُهم وبحثتُ فيه

144
00:10:01,860 --> 00:10:05,090
.إنّ التّاريخ يقصّ علينا قصّة

145
00:10:05,090 --> 00:10:08,240
.حان وقت السّؤال الآن

146
00:10:08,290 --> 00:10:09,700
:السّؤال الثّالث

147
00:10:09,410 --> 00:10:16,750
جاغوار د. ساول

148
00:10:11,330 --> 00:10:16,090
.يُسمّى هذا العملاق جاغوار د. ساول

149
00:10:16,090 --> 00:10:19,960
ما هي الطّريقة الّتي يضحك بها؟

150
00:10:20,420 --> 00:10:22,170
طريقة ضحكه؟

151
00:10:27,640 --> 00:10:31,720
أيمكنك فعل شيء آخر غير الأكل
يا كاروت-سِنباي؟

152
00:10:32,020 --> 00:10:33,720
هل تعرفين الجواب؟

153
00:10:34,270 --> 00:10:38,440
...سبق وأنهيتُ جزرتي الصّغيرة

154
00:10:38,440 --> 00:10:40,230
ماذا؟

155
00:10:41,070 --> 00:10:45,550
لا يمكنني التّفكير. ما الّذي سنفعله؟

156
00:11:03,800 --> 00:11:08,760
...أنا جائعة ولا يمكنني التّفكير

157
00:11:10,490 --> 00:11:13,260
أتستسلمين؟

158
00:11:13,440 --> 00:11:16,810
!آسفة يا أخي تشو

159
00:11:17,360 --> 00:11:20,920
ما زال الوقت باكرًا على الاستسلام يا كاروت-تشان؟

160
00:11:20,920 --> 00:11:23,360
...ماذا؟ هذا الصّوت

161
00:11:23,360 --> 00:11:24,480
!أجل

162
00:11:24,610 --> 00:11:26,660
!كلي هذا

163
00:11:26,660 --> 00:11:29,150
!مذهل، إنّه تفّاح

164
00:11:30,750 --> 00:11:33,250
.إنّه لذيذ جدًّا

165
00:11:33,250 --> 00:11:36,910
!شكرًا يا أوتاما-سِنباي

166
00:11:39,000 --> 00:11:43,670
!إنّه يدرش بين أسناني

167
00:11:44,760 --> 00:11:46,630
يدرش؟

168
00:11:46,630 --> 00:11:48,590
...يدرش

169
00:11:48,640 --> 00:11:50,430
...درش

170
00:11:50,430 --> 00:11:52,200
!نعم، تذكّرت

171
00:11:52,390 --> 00:11:55,390
!"عندما يضحك ساول يقول: "ديريشي

172
00:11:59,400 --> 00:12:02,630
جواب صحيح! كيف عرفت ذلك؟

173
00:12:02,630 --> 00:12:06,820
علّم ساول هذه الضّحكة لروبين
عندما كانت طفلة، صحيح؟

174
00:12:06,820 --> 00:12:10,440
!أخبرني أخي تشو بذلك وتذكّرتها للتّوّ

175
00:12:11,540 --> 00:12:15,160
!أجبت على ثلاثة أسئلة على التّوالي بشكل صحيح

176
00:12:15,160 --> 00:12:18,200
ما الّذي تفعلينه هنا يا أوتاما؟

177
00:12:18,250 --> 00:12:22,750
كنتُ أتدرّب على تقنية طائرة
النّينجا الورقيّة العملاقة

178
00:12:22,750 --> 00:12:27,630
الّتي علّمتني إيّاها شينوبو-تشان
.لأصير نينجا فاتنة

179
00:12:27,630 --> 00:12:33,060
!لكنّ الرّياح دفعتني بعيدًا ووقعت

180
00:12:33,060 --> 00:12:37,310
لكنّ هذه التّقنية ليست فاتنة؟

181
00:12:37,310 --> 00:12:42,350
!إن لم أعد بسرعة، ستُوبّخني شينوبو-تشان

182
00:12:42,360 --> 00:12:45,520
!حسنًا، إلى اللّقاء

183
00:12:45,820 --> 00:12:49,550
.تبذل أوتاما كلّ ما بوسعها
!عليّ أن أقوم بالمثل

184
00:12:50,740 --> 00:12:53,010
...الشّخصيّة الرّئيسيّة لهذه القصّة

185
00:12:53,370 --> 00:12:55,540
رجل ولد قبل 900 سنة في مملكة

186
00:12:55,540 --> 00:12:58,520
.ذات حضارة متقدّمة إلى حدّ كبير

187
00:13:02,290 --> 00:13:04,940
!ستؤلمك هذه بكلّ تأكيد

188
00:13:05,630 --> 00:13:10,050
فكما هو حال إله الشّمس نيكا
،الّذي ذُكر في أساطير إلباف

189
00:13:10,050 --> 00:13:13,510
فإنّ هذا الرّجل قاتَل بجسد
.يتمدّد ويتقلّص مثل المطّاط

190
00:13:24,150 --> 00:13:26,380
!كان اسمه جويبوي

191
00:13:26,570 --> 00:13:30,420
...كان أوّل رجل في هذه البحار
."يوصف بكلمة "قرصان

192
00:13:30,910 --> 00:13:33,240
قبل 900 سنة؟

193
00:13:33,240 --> 00:13:36,070
!يا لها من قصّة رومانسيّة

194
00:13:36,070 --> 00:13:40,040
من يكون جويبوي هذا؟

195
00:13:40,040 --> 00:13:42,640
...أتساءل أنا أيضًا

196
00:13:42,640 --> 00:13:45,620
!حسنًا، لننتقل إلى السّؤال التّالي

197
00:13:45,620 --> 00:13:47,250
:السّؤال الرّابع

198
00:13:48,010 --> 00:13:51,870
ما اسم هذه الشّخصيّة؟

199
00:13:51,890 --> 00:13:55,220
ماذا؟ ما هذا؟

200
00:13:55,220 --> 00:13:59,800
إنّه مجرّد ظلّ! كيف يمكننا التّعرّف إليه؟

201
00:13:59,980 --> 00:14:04,520
لكنّي أشعر أنّني رأيته
...في مكان ما من قبل

202
00:14:06,860 --> 00:14:08,810
...ما عدتُ أتحمّل

203
00:14:09,400 --> 00:14:12,270
ما عادت لك طاقة سلفًا؟

204
00:14:13,920 --> 00:14:15,870
هل تستسلمين؟

205
00:14:15,870 --> 00:14:18,400
!كدنا نصل

206
00:14:19,210 --> 00:14:22,200
!اجتهدا أكثر

207
00:14:26,170 --> 00:14:28,840
!إنّه ماركو العنقاء

208
00:14:28,840 --> 00:14:31,420
هل سيكون هذا كافيًا؟

209
00:14:31,420 --> 00:14:34,000
!أجل، جَزر

210
00:14:37,560 --> 00:14:40,300
ما الّذي تفعله هنا؟

211
00:14:41,020 --> 00:14:45,210
،أشعل فيغابانك فضولي
،وبينما كنتُ أبحث عن أجوبة

212
00:14:45,390 --> 00:14:48,930
.وجدتُ هذه السّفينة بالصّدفة

213
00:14:49,150 --> 00:14:51,770
!مهلاً! لمست نيراني الشّاشة

214
00:14:53,240 --> 00:14:54,910
...تلك الابتسامة

215
00:14:54,910 --> 00:14:57,320
...بالطّبع، إنّه

216
00:14:57,320 --> 00:14:58,330
!لوفي

217
00:14:58,330 --> 00:15:00,820
!إنّه لوفي-سِنباي

218
00:15:02,330 --> 00:15:04,240
.الجواب صحيح

219
00:15:04,290 --> 00:15:08,210
.كان ذلك السّؤال مشتعلاً

220
00:15:08,210 --> 00:15:11,330
!كيوتارو ذاك مخادع بالفعل

221
00:15:11,340 --> 00:15:13,300
!ممتاز

222
00:15:13,300 --> 00:15:16,840
!ماركو، لك جزر الشّكر

223
00:15:16,850 --> 00:15:21,800
!العبارة هي جزيل الشّكر

224
00:15:21,810 --> 00:15:23,310
!كاروت

225
00:15:23,310 --> 00:15:27,470
.يا لكم من مجموعة مرحة
.لم أقم بأيّ شيء على الإطلاق

226
00:15:27,470 --> 00:15:30,500
.بقي لدينا سؤال واحد فقط

227
00:15:31,150 --> 00:15:36,220
فخلال القرن الفارغ، وقعت
.كوارث عظمى غيّرت ملامح العالم

228
00:15:36,220 --> 00:15:38,050
...وقد تسبّب ذلك في

229
00:15:41,620 --> 00:15:44,160
.غرق العالم تحت البحر في الماضي

230
00:15:46,790 --> 00:15:50,730
.استنتاجاته تبعث على القشعريرة

231
00:15:51,050 --> 00:15:53,710
...سيغرق هذا العالم تحت البحر

232
00:15:53,970 --> 00:15:58,990
!ولم ينتهِ فيغابانك بعد

233
00:15:59,350 --> 00:16:00,970
...وما نعيش فوقه اليوم

234
00:16:00,970 --> 00:16:04,700
هو فقط ما تبقّى من أجزاء القارّات
!الّتي كانت قائمة آنذاك

235
00:16:08,410 --> 00:16:13,390
بعبارة أخرى، الحرب العُظمى
...الّتي بدأت خلال القرن الفارغ

236
00:16:17,990 --> 00:16:21,400
.ما زالت مستمرّة حتّى وقتنا هذا

237
00:16:23,790 --> 00:16:27,240
...بدأت رأسي يؤلمني

238
00:16:27,290 --> 00:16:28,600
...وأنا أيضًا

239
00:16:29,460 --> 00:16:31,950
.لكن علينا أن نستمع بتمعّن

240
00:16:31,950 --> 00:16:36,710
هذه هي الرّسالة الّتي تركها
.فيغابانك مضحّيًا بحياته

241
00:16:37,110 --> 00:16:40,920
!وإليكم آخر سؤال

242
00:16:41,220 --> 00:16:42,970
!أنا جاهزة

243
00:16:42,970 --> 00:16:47,260
!سننقذك يا تشوبّر-سِنباي

244
00:16:47,540 --> 00:16:48,930
:السّؤال الخامس

245
00:16:49,360 --> 00:16:53,730
!اكتشفوا من أكون

246
00:16:53,730 --> 00:16:56,520
!لديكم محاولة واحدة فقط للإجابة

247
00:16:57,150 --> 00:16:58,860
ماذا؟

248
00:16:59,410 --> 00:17:03,450
وكيف يفترض بنا أن نعرف بلا أيّ تلميح؟

249
00:17:03,450 --> 00:17:06,950
!هيّا، حاولوا اكتشاف ذلك

250
00:17:09,630 --> 00:17:12,160
!الفيديو يستمرّ

251
00:17:15,170 --> 00:17:19,300
كان للرّسالة الّتي بثّها فيغابانك

252
00:17:19,300 --> 00:17:22,710
.تأثير على العالم بأسره

253
00:17:22,890 --> 00:17:26,130
.كان رجلاً عظيمًا

254
00:17:26,310 --> 00:17:29,290
.أتمنّى لو التقيتُه ولو لمرّة

255
00:17:30,230 --> 00:17:31,750
...وفي النّهاية

256
00:17:32,940 --> 00:17:35,440
.لديّ رسالة أخيرة

257
00:17:35,610 --> 00:17:38,600
...رسالة لكلّ شخص في هذا العالم

258
00:17:39,570 --> 00:17:42,090
!"يحمل اسمه الحرف "د

259
00:17:42,490 --> 00:17:44,640
...إيس ولوفي

260
00:17:44,640 --> 00:17:47,510
...لوفي-سان ونائب الأميرال غارب

261
00:17:48,680 --> 00:17:50,310
!القبطان

262
00:17:50,620 --> 00:17:53,450
...من بينكم

263
00:17:54,960 --> 00:17:59,470
!كفاك عبثًا يا حلزون الاتّصال

264
00:17:59,470 --> 00:18:03,890
!لا يسمح لك برنامجنا بالتّصرّف كما تشاء

265
00:18:03,890 --> 00:18:05,760
برنامج؟

266
00:18:05,760 --> 00:18:10,230
يا كيوتارو، ما الّذي فعلته بحلزون الاتّصال؟

267
00:18:10,230 --> 00:18:14,020
!أخبرتك مرارًا أنّ ذلك ليس اسمي

268
00:18:14,020 --> 00:18:16,100
!كفّ عن مناداتي بمثل تلك الألقاب

269
00:18:16,320 --> 00:18:17,890
!وجدتها

270
00:18:18,070 --> 00:18:20,060
...إنّك-تيا وبلا أيّ شكّ

271
00:18:20,280 --> 00:18:22,530
!هو الدّكتور فيغابانك

272
00:18:22,530 --> 00:18:25,360
الدّكتور فيغابانك؟

273
00:18:25,410 --> 00:18:29,140
...عمّ تتحدّثين؟ لقد مات سلفًا

274
00:18:29,370 --> 00:18:33,330
ثمّة من تلاعب بحلزون الاتّصال هذا

275
00:18:33,330 --> 00:18:38,040
!للحديث معنا عن بثّ فيغابانك العالميّ

276
00:18:38,630 --> 00:18:40,500
أهو اختراق من نوع ما؟

277
00:18:40,550 --> 00:18:44,760
لكنّ حلزون الاتّصال عاد لطبيعته في النّهاية

278
00:18:44,760 --> 00:18:47,640
!وأعطانا تلميحًا

279
00:18:47,640 --> 00:18:51,590
.وسارع كيوتارو لإيقافه

280
00:18:51,650 --> 00:18:54,190
الشّخص الوحيد القادر على ذلك

281
00:18:54,190 --> 00:18:56,860
،هو الرّجل صاحب أكبر دماغ في العالم

282
00:18:56,860 --> 00:19:00,420
!الدّكتور فيغابانك ولا أحد سواه-تيا

283
00:19:01,630 --> 00:19:16,770
جواب صحيح

284
00:19:04,550 --> 00:19:07,810
!إجابة جيّدة، عمل ممتاز

285
00:19:08,660 --> 00:19:10,850
ومن أنتما؟

286
00:19:10,850 --> 00:19:14,700
!نحن من أقمار فيغابانك واسمي ليليث

287
00:19:14,700 --> 00:19:17,200
!وأنا إديسون

288
00:19:17,500 --> 00:19:21,630
نريد أن نحرص أنّ الجميع يتذكّرون

289
00:19:21,630 --> 00:19:24,170
.الرّسالة الّتي تركها ستيلا

290
00:19:24,300 --> 00:19:26,180
،وكما قلتم بالضّبط

291
00:19:26,220 --> 00:19:32,030
فقد قمنا بتعديل حلزون الاتّصال لإنشاء

292
00:19:32,030 --> 00:19:35,520
!مسابقة أسئلة تفاعليّة عن بعد

293
00:19:35,520 --> 00:19:40,100
إنّه مجرّد نموذج أوّلي، لكنّه ممتع، صحيح؟

294
00:19:40,110 --> 00:19:42,130
مسابقة أسئلة تفاعليّة؟

295
00:19:42,130 --> 00:19:45,190
لعبة مسابقة أسئلة؟

296
00:19:45,280 --> 00:19:49,070
!وبفضلكم، استطعنا تحديد بعض الأعطال

297
00:19:49,070 --> 00:19:50,410
!شكرًا لكم

298
00:19:50,410 --> 00:19:54,070
!وبمجرّد أن يجهز، سنبيعه ونجني ثروة

299
00:19:54,210 --> 00:19:56,870
!الكثير من المال لبحوثنا

300
00:19:58,250 --> 00:20:03,330
إذًا فقد كنتما تختبران هذه اللّعبة علينا؟

301
00:20:04,590 --> 00:20:06,130
!صحيح

302
00:20:06,510 --> 00:20:08,510
هل تمازحانني؟

303
00:20:08,510 --> 00:20:12,600
!ستدفعان ثمن هذا

304
00:20:12,600 --> 00:20:14,100
!عودي إلى هنا

305
00:20:14,100 --> 00:20:16,940
!آسف! لا تغضب علينا هكذا

306
00:20:16,940 --> 00:20:20,930
!تتطلّب أيّ تجربة بعض التّضحيات

307
00:20:24,320 --> 00:20:26,190
!كاروت

308
00:20:26,860 --> 00:20:28,650
أتريدين منه أيضًا؟

309
00:20:28,660 --> 00:20:32,450
!أنت حيّ يا أخي تشو

310
00:20:32,450 --> 00:20:34,820
حيّ؟ عمّ تتحدّثين؟

311
00:20:35,080 --> 00:20:38,580
دعاني كلّ من ليليث وإديسون

312
00:20:38,580 --> 00:20:40,740
!لتناول بعض غزل البنات

313
00:20:46,260 --> 00:20:48,920
!إنّها جنّة غزل بنات

314
00:20:51,430 --> 00:20:55,120
.خُدعتَ ببساطة

315
00:20:55,120 --> 00:20:58,100
!عشنا الأمرّين بسبب هذا

316
00:20:58,100 --> 00:21:01,730
كن حذرًا يا أخي تشو عندما تبدو
!الأمور أفضل ممّا يجب أن تكون

317
00:21:01,730 --> 00:21:03,640
عمّ تتحدّثين؟

318
00:21:04,530 --> 00:21:07,850
!غزل البنات ناعم وحلو، إنّه لذيذ جدًّا

319
00:22:50,420 --> 00:22:54,740
تمنع هجمات الشّيوخ الخمسة الشّرسة
!بوني والبقيّة من الهرب من إيغهيد

320
00:22:54,740 --> 00:22:56,510
،وبينما بوني محاصرة في الزّاوية

321
00:22:56,510 --> 00:22:59,550
فإن صوت طبول التّحرير الّتي رقصت
.عليها معا والدها يتردّد في آذانها

322
00:22:59,850 --> 00:23:03,060
المستقبل الّتي كانت بوني توّاقة
،لتتشاركه مع كوما

323
00:23:03,060 --> 00:23:05,710
!أيقظ قوّة جديدة الآن

324
00:23:05,980 --> 00:23:07,670
:في الحلقة القادمة من وان بيس

325
00:23:07,670 --> 00:23:11,520
"حلمها وحلم والدها! مستقبل بوني الحرّ"

326
00:23:11,530 --> 00:23:14,100
!ملك القراصنة، لن يكون إلاّ أنا