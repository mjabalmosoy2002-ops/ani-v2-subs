1
00:01:43,770 --> 00:01:46,020
!اليوم يوم جميل بالفعل

2
00:01:46,020 --> 00:01:48,860
!أودّ الخروج في نزهة مع أخي تشو

3
00:01:48,860 --> 00:01:53,420
!مرحبًا

4
00:01:59,580 --> 00:02:03,850
!وحش جزرة

5
00:02:04,210 --> 00:02:07,880
!استيقظتِ أخيرًا يا كاروت-سِنباي

6
00:02:07,880 --> 00:02:11,560
ماذا؟ ومن أنت-تيا؟

7
00:02:11,560 --> 00:02:14,670
!أنا بارتولوميو

8
00:02:14,670 --> 00:02:17,930
لكنّ الأهمّ، لماذا واحدة
،من أصدقاء لوفي-سِنباي

9
00:02:17,930 --> 00:02:21,720
الّذي أقدّره كثيرًا، تنام على سفينتنا؟

10
00:02:22,390 --> 00:02:25,550
!أنا من استدعاها إلى هنا

11
00:02:26,440 --> 00:02:29,900
!مرحبًا بكم في عرين مسابقة الأسئلة

12
00:02:29,900 --> 00:02:31,720
عرين مسابقة الأسئلة؟

13
00:02:32,030 --> 00:02:33,640
ومن أنت؟

14
00:02:33,860 --> 00:02:38,020
،أنا سيّد عرين مسابقة الأسئلة

15
00:02:37,550 --> 00:02:43,950
كيو

16
00:02:38,080 --> 00:02:41,990
!"واسمي هو "كيو

17
00:02:41,980 --> 00:02:43,490
كيو؟

18
00:02:47,830 --> 00:02:52,920
هل هذا الفيديو هو الّذي يُبثّ
في أرجاء العالم من طرف فيغابانك؟

19
00:02:52,920 --> 00:02:55,980
!إجابة صحيحة

20
00:02:55,980 --> 00:02:58,380
ستقومون بالإجابة في مسابقة أسئلة

21
00:02:58,380 --> 00:03:02,550
.عن رسالة فيغابانك هذه

22
00:03:02,640 --> 00:03:04,180
مسابقة أسئلة؟

23
00:03:04,180 --> 00:03:06,770
!لا يهمّني من تكون

24
00:03:06,770 --> 00:03:10,020
!لا يُسمح لأيّ أحد باستعمال سفينتنا

25
00:03:10,020 --> 00:03:12,860
أتريد الاستمتاع بوقتك؟
!قم بذلك في مكان آخر

26
00:03:12,860 --> 00:03:17,230
.أنا جادّ تمامًا يا بارتولوميو-كُن

27
00:03:18,820 --> 00:03:21,940
!هذا تشوبّر-سِنباي

28
00:03:23,080 --> 00:03:26,860
لماذا أخي تشو خلف القضبان؟

29
00:03:26,870 --> 00:03:29,540
.ستكون في المسابقة خمسة أسئلة

30
00:03:29,540 --> 00:03:32,850
...وفي حالة تقديم إجابة خاطئة

31
00:03:32,850 --> 00:03:36,550
!ما-ماذا؟! أخي تشو؟

32
00:03:36,550 --> 00:03:38,380
ما الّذي تنوي فعله؟

33
00:03:38,380 --> 00:03:44,300
.شغفي الكبير هو تحنيط الحيوانات النّادرة

34
00:03:46,060 --> 00:03:49,230
.لا يبدو أنّه يمزح على الإطلاق

35
00:03:49,230 --> 00:03:51,720
ماذا نفعل يا كاروت-سِنباي؟

36
00:03:53,020 --> 00:03:54,680
....أخي تشو

37
00:03:55,190 --> 00:03:57,320
!أنا موافقة

38
00:03:57,320 --> 00:04:00,360
،وإن أجبتُ على كلّ أسئلتك بشكل صحيح

39
00:04:00,360 --> 00:04:02,820
!ستطلق سراح أخي تشو

40
00:04:02,820 --> 00:04:04,870
.هذا وعد

41
00:04:04,870 --> 00:04:07,950
!من الأفضل أن تفعل يا كيو-تارو

42
00:04:08,330 --> 00:04:12,330
لماذا أضفت تارو لاسمي؟ وما معنى تارو؟

43
00:04:12,330 --> 00:04:14,620
.اصبر يا أخي تشو

44
00:04:16,300 --> 00:04:19,400
!سأنقذك بكلّ تأكيد

45
00:04:21,140 --> 00:04:27,010
!سجلّ مغامرات الدّكتور تشوبر"
"~السّجلاّت الأخيرة الّتي تركها العبقريّ~

46
00:04:36,400 --> 00:04:38,000
...إنّ هذه الجزيرة

47
00:04:39,200 --> 00:04:41,550
.صارت تعجّ بالكثير من مصادر الإزعاج لنا

48
00:04:42,620 --> 00:04:47,490
يبدو أنّ إيغهيد هي الجزيرة
.الّتي يوجد فيها لوفي وطاقه الآن

49
00:04:47,490 --> 00:04:48,620
.نعم

50
00:04:48,620 --> 00:04:51,620
لكنّ القدّيس ساترن أمر بإطلاق

51
00:04:51,620 --> 00:04:54,440
!نداء الدّماء على الجزيرة

52
00:04:54,750 --> 00:04:57,770
!احرصوا أن تغادروا يا لوفي-سِنباي بسلام

53
00:04:59,230 --> 00:05:03,130
يسعى القدّيس ساترن خلف رأس
فيغابانك الّذي خالف القانون

54
00:05:03,130 --> 00:05:06,420
!ببحوث محرّمة عن الماضي

55
00:05:12,600 --> 00:05:14,260
!فيغابانك

56
00:05:15,440 --> 00:05:16,790
!عجوز التّفّاحة

57
00:05:30,120 --> 00:05:32,710
،معكم الدّكتور فيغابانك

58
00:05:32,710 --> 00:05:35,520
.عالِم عبقريّ بسيط

59
00:05:35,520 --> 00:05:40,130
،أعلم أنّ الكثير منكم سيُصدمون برسالتي هذه

60
00:05:40,170 --> 00:05:41,940
...لكنّها الحقيقة

61
00:05:42,170 --> 00:05:44,670
!حقيقة هذا العالم

62
00:05:46,220 --> 00:05:49,780
إن لم تخُنّي الذّاكرة، فقد خطّط فيغابانك

63
00:05:50,100 --> 00:05:54,020
لبثّ هذه الرّسالة في أنحاء العالم
.في حالة حدوث شيء ما له

64
00:05:54,020 --> 00:05:58,680
!إنّه لا يملك أكبر دماغ في العالم من فراغ

65
00:06:00,030 --> 00:06:02,020
!توقّف الفيديو

66
00:06:02,440 --> 00:06:06,110
!لنبدأ مسابقة الأسئلة

67
00:06:06,450 --> 00:06:08,030
:السّؤال الأوّل

68
00:06:08,700 --> 00:06:14,030
.تُسمّى إيغهيد بالجزيرة الميكانيكيّة

69
00:06:14,160 --> 00:06:18,540
،اذهبوا يسارًا إن كان ذلك صحيحًا
!ويمينًا إن كان خاطئًا

70
00:06:19,420 --> 00:06:22,050
هل تعرفين الجواب يا كاروت-سِنباي؟

71
00:06:22,050 --> 00:06:24,170
ما كان يا ترى...؟

72
00:06:24,170 --> 00:06:26,340
!لا أتذكّر على الإطلاق

73
00:06:26,340 --> 00:06:29,220
...سبق وتحدّثنا عن ذلك

74
00:06:29,220 --> 00:06:31,760
.بقيت لديكم 10 ثوان فحسب

75
00:06:31,760 --> 00:06:34,510
...لحظة... لحظة

76
00:06:35,020 --> 00:06:38,890
هذا ليس الوقت المناسب للأكل
!يا كاروت-سِنباي

77
00:06:39,230 --> 00:06:41,420
!لا تأخذ جزرتي

78
00:06:42,480 --> 00:06:44,730
!هذا مؤلم

79
00:06:45,030 --> 00:06:47,060
!مهلاً... كلاّ

80
00:06:47,070 --> 00:06:49,240
...انتهى الوقت

81
00:06:49,240 --> 00:06:51,840
!وكان ذلك خاطئًا

82
00:06:52,660 --> 00:06:54,610
ماذا؟ أجوابنا صحيح؟

83
00:06:54,680 --> 00:07:10,400
جزيرة المستقبل

84
00:06:54,750 --> 00:06:57,440
.تُسمّى إيغهيد بجزيرة المستقبل

85
00:06:57,440 --> 00:06:59,040
!يا لحظّك

86
00:06:59,040 --> 00:07:02,660
!وقفنا في المكان الصّحيح بالصّدفة

87
00:07:05,050 --> 00:07:07,290
.كلّ هذا بفضل هذه الجزرة

88
00:07:07,300 --> 00:07:10,400
.هيّا، لنواصل ركوب هذا الزّخم

89
00:07:11,220 --> 00:07:13,670
...ولاختصار هذه القصّة الطّويلة

90
00:07:14,220 --> 00:07:16,220
...فسأقول أنّ هذا العالم

91
00:07:16,980 --> 00:07:20,220
.محتّم عليه أن يغرق تحت البحر

92
00:07:20,270 --> 00:07:23,150
سيغرق العالم تحت البحر؟

93
00:07:23,150 --> 00:07:25,850
ما الّذي يعنيه بذلك؟

94
00:07:26,070 --> 00:07:28,510
هل ينطبق ذلك على زو أيضًا؟

95
00:07:28,510 --> 00:07:32,470
إن افترضنا أنّ أجهزة استشعاري
،وحساباتي جيّدة

96
00:07:33,330 --> 00:07:37,790
سيهزّ زلزال كبير العالم بأكمله
.بشكل لا نظير له

97
00:07:37,960 --> 00:07:39,770
،وبشكل متناسب مع الزّلزال

98
00:07:39,770 --> 00:07:43,460
سيرتفع مستوى البحر في العالم
،بحوالي متر واحد

99
00:07:43,500 --> 00:07:46,650
.ما سيجعل بعض الجُزر غير قابلة للعيش

100
00:07:46,970 --> 00:07:50,490
هذا الزّلزال بالتّحديد هو ليس
ما يمكن وصفه بظاهرة طبيعيّة

101
00:07:50,490 --> 00:07:52,950
!على وجه الخصوص

102
00:07:53,810 --> 00:07:55,770
هل توقّف ثانية؟

103
00:07:55,770 --> 00:07:57,600
!لا بدّ أنّه وقت السّؤال

104
00:07:57,600 --> 00:07:59,180
:السّؤال الثّاني

105
00:08:00,600 --> 00:08:04,020
،مِن بين الخيارات التّالي

106
00:08:04,020 --> 00:08:08,020
من قاتَل كيزارو على إيغهيد
لحماية فيغابانك؟

107
00:08:08,780 --> 00:08:12,870
.الجواب أ، ساكازوكي. الجواب ب، كوزان

108
00:08:12,870 --> 00:08:15,610
.أو الجواب ج، سِنتومارو

109
00:08:15,610 --> 00:08:17,270
!هنالك ثلاثة أجوبة

110
00:08:17,290 --> 00:08:19,410
...حسنًا... حسنًا

111
00:08:21,290 --> 00:08:24,230
!نسيت ثانية

112
00:08:24,230 --> 00:08:27,660
!ركّزي على شيء آخر غير الجزر

113
00:08:27,800 --> 00:08:31,430
.تبدين في وضع سيّئ يا آنستي الحسناء

114
00:08:31,430 --> 00:08:32,540
ماذا؟

115
00:08:33,890 --> 00:08:37,130
.أخبريني إن كان بإمكاني مساعدتك بأيّ طريقة

116
00:08:37,130 --> 00:08:40,840
.أنا أدعم مُعجبِيّ دائمًا

117
00:08:40,850 --> 00:08:44,060
ما الّذي تفعله هنا يا ملفوف؟

118
00:08:44,060 --> 00:08:46,060
!اسمي كافنديش

119
00:08:46,190 --> 00:08:50,650
أتى بي فضولي إلى هذه السّفينة
!الّتي تفتقر لأيّ حسّ بالأناقة

120
00:08:50,650 --> 00:08:55,510
!عمّ تتحدّث؟ سفينتنا الأروع على الإطلاق

121
00:08:55,510 --> 00:08:58,280
!ولن ينسوا من مرّوا بها روعتها أبدًا

122
00:08:58,330 --> 00:09:01,160
ينسوا... مرّوا؟

123
00:09:01,370 --> 00:09:03,830
!عرفتُ الإجابة

124
00:09:03,920 --> 00:09:07,120
!الجواب الصّحيح هو ج، سِنتومارو

125
00:09:08,300 --> 00:09:32,400
سِنتومارو

126
00:09:10,300 --> 00:09:12,670
!جواب صحيح

127
00:09:13,640 --> 00:09:15,350
!مذهل

128
00:09:15,350 --> 00:09:19,470
!شكرًا! ساعدتني-تيا على التّذكّر

129
00:09:19,930 --> 00:09:21,890
...لا أرى كيف

130
00:09:22,060 --> 00:09:26,470
،سواء رغبتْ في ذلك أم لا
!خُلقت النّجوم لتلمع

131
00:09:26,480 --> 00:09:30,980
.ناديني إن واجهت مشكلة أخرى
!مع السّلامة

132
00:09:32,740 --> 00:09:37,660
أنا أقصد بالتّحديد ما حدث
...في المائة سنة بين حوالي 800 سنة

133
00:09:37,660 --> 00:09:39,760
.و900 سنة قبل وقتنا هذا

134
00:09:40,250 --> 00:09:44,430
.إنّها أحداث تمّ حذفها بالكامل من تاريخنا

135
00:09:44,920 --> 00:09:47,390
،تُسمّى هذه الفترة بالقرن الفارغ

136
00:09:47,390 --> 00:09:50,610
.وقد مُحيت كلّ السّجلاّت عنه

137
00:09:50,880 --> 00:09:53,820
إن الوسيلة الوحيدة لكشف السّتار
...عن هذا التّاريخ

138
00:09:54,300 --> 00:09:58,760
هي العثور على رسائل من الماضي
...على شكل بونيغليف

139
00:09:58,760 --> 00:10:02,280
.منتشرة في أرجاء العالم

140
00:10:02,560 --> 00:10:05,040
ولكنّ فكّ شيفرة البونيغليف

141
00:10:05,230 --> 00:10:09,040
.ممنوع منعًا باتًّا من طرف حكومة العالم

142
00:10:09,040 --> 00:10:12,270
،ورغم أنّي أعدّ إلى جانب الحكومة

143
00:10:12,270 --> 00:10:14,670
.عارضتُهم وبحثتُ فيه

144
00:10:15,860 --> 00:10:19,090
.إنّ التّاريخ يقصّ علينا قصّة

145
00:10:19,090 --> 00:10:22,240
.حان وقت السّؤال الآن

146
00:10:22,290 --> 00:10:23,700
:السّؤال الثّالث

147
00:10:23,410 --> 00:10:30,750
جاغوار د. ساول

148
00:10:25,330 --> 00:10:30,090
.يُسمّى هذا العملاق جاغوار د. ساول

149
00:10:30,090 --> 00:10:33,960
ما هي الطّريقة الّتي يضحك بها؟

150
00:10:34,420 --> 00:10:36,170
طريقة ضحكه؟

151
00:10:41,640 --> 00:10:45,720
أيمكنك فعل شيء آخر غير الأكل
يا كاروت-سِنباي؟

152
00:10:46,020 --> 00:10:47,720
هل تعرفين الجواب؟

153
00:10:48,270 --> 00:10:52,440
...سبق وأنهيتُ جزرتي الصّغيرة

154
00:10:52,440 --> 00:10:54,230
ماذا؟

155
00:10:55,070 --> 00:10:59,550
لا يمكنني التّفكير. ما الّذي سنفعله؟

156
00:11:17,800 --> 00:11:22,760
...أنا جائعة ولا يمكنني التّفكير

157
00:11:24,490 --> 00:11:27,260
أتستسلمين؟

158
00:11:27,440 --> 00:11:30,810
!آسفة يا أخي تشو

159
00:11:31,360 --> 00:11:34,920
ما زال الوقت باكرًا على الاستسلام يا كاروت-تشان؟

160
00:11:34,920 --> 00:11:37,360
...ماذا؟ هذا الصّوت

161
00:11:37,360 --> 00:11:38,480
!أجل

162
00:11:38,610 --> 00:11:40,660
!كلي هذا

163
00:11:40,660 --> 00:11:43,150
!مذهل، إنّه تفّاح

164
00:11:44,750 --> 00:11:47,250
.إنّه لذيذ جدًّا

165
00:11:47,250 --> 00:11:50,910
!شكرًا يا أوتاما-سِنباي

166
00:11:53,000 --> 00:11:57,670
!إنّه يدرش بين أسناني

167
00:11:58,760 --> 00:12:00,630
يدرش؟

168
00:12:00,630 --> 00:12:02,590
...يدرش

169
00:12:02,640 --> 00:12:04,430
...درش

170
00:12:04,430 --> 00:12:06,200
!نعم، تذكّرت

171
00:12:06,390 --> 00:12:09,390
!"عندما يضحك ساول يقول: "ديريشي

172
00:12:13,400 --> 00:12:16,630
جواب صحيح! كيف عرفت ذلك؟

173
00:12:16,630 --> 00:12:20,820
علّم ساول هذه الضّحكة لروبين
عندما كانت طفلة، صحيح؟

174
00:12:20,820 --> 00:12:24,440
!أخبرني أخي تشو بذلك وتذكّرتها للتّوّ

175
00:12:25,540 --> 00:12:29,160
!أجبت على ثلاثة أسئلة على التّوالي بشكل صحيح

176
00:12:29,160 --> 00:12:32,200
ما الّذي تفعلينه هنا يا أوتاما؟

177
00:12:32,250 --> 00:12:36,750
كنتُ أتدرّب على تقنية طائرة
النّينجا الورقيّة العملاقة

178
00:12:36,750 --> 00:12:41,630
الّتي علّمتني إيّاها شينوبو-تشان
.لأصير نينجا فاتنة

179
00:12:41,630 --> 00:12:47,060
!لكنّ الرّياح دفعتني بعيدًا ووقعت

180
00:12:47,060 --> 00:12:51,310
لكنّ هذه التّقنية ليست فاتنة؟

181
00:12:51,310 --> 00:12:56,350
!إن لم أعد بسرعة، ستُوبّخني شينوبو-تشان

182
00:12:56,360 --> 00:12:59,520
!حسنًا، إلى اللّقاء

183
00:12:59,820 --> 00:13:03,550
.تبذل أوتاما كلّ ما بوسعها
!عليّ أن أقوم بالمثل

184
00:13:04,740 --> 00:13:07,010
...الشّخصيّة الرّئيسيّة لهذه القصّة

185
00:13:07,370 --> 00:13:09,540
رجل ولد قبل 900 سنة في مملكة

186
00:13:09,540 --> 00:13:12,520
.ذات حضارة متقدّمة إلى حدّ كبير

187
00:13:16,290 --> 00:13:18,940
!ستؤلمك هذه بكلّ تأكيد

188
00:13:19,630 --> 00:13:24,050
فكما هو حال إله الشّمس نيكا
،الّذي ذُكر في أساطير إلباف

189
00:13:24,050 --> 00:13:27,510
فإنّ هذا الرّجل قاتَل بجسد
.يتمدّد ويتقلّص مثل المطّاط

190
00:13:38,150 --> 00:13:40,380
!كان اسمه جويبوي

191
00:13:40,570 --> 00:13:44,420
...كان أوّل رجل في هذه البحار
."يوصف بكلمة "قرصان

192
00:13:44,910 --> 00:13:47,240
قبل 900 سنة؟

193
00:13:47,240 --> 00:13:50,070
!يا لها من قصّة رومانسيّة

194
00:13:50,070 --> 00:13:54,040
من يكون جويبوي هذا؟

195
00:13:54,040 --> 00:13:56,640
...أتساءل أنا أيضًا

196
00:13:56,640 --> 00:13:59,620
!حسنًا، لننتقل إلى السّؤال التّالي

197
00:13:59,620 --> 00:14:01,250
:السّؤال الرّابع

198
00:14:02,010 --> 00:14:05,870
ما اسم هذه الشّخصيّة؟

199
00:14:05,890 --> 00:14:09,220
ماذا؟ ما هذا؟

200
00:14:09,220 --> 00:14:13,800
إنّه مجرّد ظلّ! كيف يمكننا التّعرّف إليه؟

201
00:14:13,980 --> 00:14:18,520
لكنّي أشعر أنّني رأيته
...في مكان ما من قبل

202
00:14:20,860 --> 00:14:22,810
...ما عدتُ أتحمّل

203
00:14:23,400 --> 00:14:26,270
ما عادت لك طاقة سلفًا؟

204
00:14:27,920 --> 00:14:29,870
هل تستسلمين؟

205
00:14:29,870 --> 00:14:32,400
!كدنا نصل

206
00:14:33,210 --> 00:14:36,200
!اجتهدا أكثر

207
00:14:40,170 --> 00:14:42,840
!إنّه ماركو العنقاء

208
00:14:42,840 --> 00:14:45,420
هل سيكون هذا كافيًا؟

209
00:14:45,420 --> 00:14:48,000
!أجل، جَزر

210
00:14:51,560 --> 00:14:54,300
ما الّذي تفعله هنا؟

211
00:14:55,020 --> 00:14:59,210
،أشعل فيغابانك فضولي
،وبينما كنتُ أبحث عن أجوبة

212
00:14:59,390 --> 00:15:02,930
.وجدتُ هذه السّفينة بالصّدفة

213
00:15:03,150 --> 00:15:05,770
!مهلاً! لمست نيراني الشّاشة

214
00:15:07,240 --> 00:15:08,910
...تلك الابتسامة

215
00:15:08,910 --> 00:15:11,320
...بالطّبع، إنّه

216
00:15:11,320 --> 00:15:12,330
!لوفي

217
00:15:12,330 --> 00:15:14,820
!إنّه لوفي-سِنباي

218
00:15:16,330 --> 00:15:18,240
.الجواب صحيح

219
00:15:18,290 --> 00:15:22,210
.كان ذلك السّؤال مشتعلاً

220
00:15:22,210 --> 00:15:25,330
!كيوتارو ذاك مخادع بالفعل

221
00:15:25,340 --> 00:15:27,300
!ممتاز

222
00:15:27,300 --> 00:15:30,840
!ماركو، لك جزر الشّكر

223
00:15:30,850 --> 00:15:35,800
!العبارة هي جزيل الشّكر

224
00:15:35,810 --> 00:15:37,310
!كاروت

225
00:15:37,310 --> 00:15:41,470
.يا لكم من مجموعة مرحة
.لم أقم بأيّ شيء على الإطلاق

226
00:15:41,470 --> 00:15:44,500
.بقي لدينا سؤال واحد فقط

227
00:15:45,150 --> 00:15:50,220
فخلال القرن الفارغ، وقعت
.كوارث عظمى غيّرت ملامح العالم

228
00:15:50,220 --> 00:15:52,050
...وقد تسبّب ذلك في

229
00:15:55,620 --> 00:15:58,160
.غرق العالم تحت البحر في الماضي

230
00:16:00,790 --> 00:16:04,730
.استنتاجاته تبعث على القشعريرة

231
00:16:05,050 --> 00:16:07,710
...سيغرق هذا العالم تحت البحر

232
00:16:07,970 --> 00:16:12,990
!ولم ينتهِ فيغابانك بعد

233
00:16:13,350 --> 00:16:14,970
...وما نعيش فوقه اليوم

234
00:16:14,970 --> 00:16:18,700
هو فقط ما تبقّى من أجزاء القارّات
!الّتي كانت قائمة آنذاك

235
00:16:22,410 --> 00:16:27,390
بعبارة أخرى، الحرب العُظمى
...الّتي بدأت خلال القرن الفارغ

236
00:16:31,990 --> 00:16:35,400
.ما زالت مستمرّة حتّى وقتنا هذا

237
00:16:37,790 --> 00:16:41,240
...بدأت رأسي يؤلمني

238
00:16:41,290 --> 00:16:42,600
...وأنا أيضًا

239
00:16:43,460 --> 00:16:45,950
.لكن علينا أن نستمع بتمعّن

240
00:16:45,950 --> 00:16:50,710
هذه هي الرّسالة الّتي تركها
.فيغابانك مضحّيًا بحياته

241
00:16:51,110 --> 00:16:54,920
!وإليكم آخر سؤال

242
00:16:55,220 --> 00:16:56,970
!أنا جاهزة

243
00:16:56,970 --> 00:17:01,260
!سننقذك يا تشوبّر-سِنباي

244
00:17:01,540 --> 00:17:02,930
:السّؤال الخامس

245
00:17:03,360 --> 00:17:07,730
!اكتشفوا من أكون

246
00:17:07,730 --> 00:17:10,520
!لديكم محاولة واحدة فقط للإجابة

247
00:17:11,150 --> 00:17:12,860
ماذا؟

248
00:17:13,410 --> 00:17:17,450
وكيف يفترض بنا أن نعرف بلا أيّ تلميح؟

249
00:17:17,450 --> 00:17:20,950
!هيّا، حاولوا اكتشاف ذلك

250
00:17:23,630 --> 00:17:26,160
!الفيديو يستمرّ

251
00:17:29,170 --> 00:17:33,300
كان للرّسالة الّتي بثّها فيغابانك

252
00:17:33,300 --> 00:17:36,710
.تأثير على العالم بأسره

253
00:17:36,890 --> 00:17:40,130
.كان رجلاً عظيمًا

254
00:17:40,310 --> 00:17:43,290
.أتمنّى لو التقيتُه ولو لمرّة

255
00:17:44,230 --> 00:17:45,750
...وفي النّهاية

256
00:17:46,940 --> 00:17:49,440
.لديّ رسالة أخيرة

257
00:17:49,610 --> 00:17:52,600
...رسالة لكلّ شخص في هذا العالم

258
00:17:53,570 --> 00:17:56,090
!"يحمل اسمه الحرف "د

259
00:17:56,490 --> 00:17:58,640
...إيس ولوفي

260
00:17:58,640 --> 00:18:01,510
...لوفي-سان ونائب الأميرال غارب

261
00:18:02,680 --> 00:18:04,310
!القبطان

262
00:18:04,620 --> 00:18:07,450
...من بينكم

263
00:18:08,960 --> 00:18:13,470
!كفاك عبثًا يا حلزون الاتّصال

264
00:18:13,470 --> 00:18:17,890
!لا يسمح لك برنامجنا بالتّصرّف كما تشاء

265
00:18:17,890 --> 00:18:19,760
برنامج؟

266
00:18:19,760 --> 00:18:24,230
يا كيوتارو، ما الّذي فعلته بحلزون الاتّصال؟

267
00:18:24,230 --> 00:18:28,020
!أخبرتك مرارًا أنّ ذلك ليس اسمي

268
00:18:28,020 --> 00:18:30,100
!كفّ عن مناداتي بمثل تلك الألقاب

269
00:18:30,320 --> 00:18:31,890
!وجدتها

270
00:18:32,070 --> 00:18:34,060
...إنّك-تيا وبلا أيّ شكّ

271
00:18:34,280 --> 00:18:36,530
!هو الدّكتور فيغابانك

272
00:18:36,530 --> 00:18:39,360
الدّكتور فيغابانك؟

273
00:18:39,410 --> 00:18:43,140
...عمّ تتحدّثين؟ لقد مات سلفًا

274
00:18:43,370 --> 00:18:47,330
ثمّة من تلاعب بحلزون الاتّصال هذا

275
00:18:47,330 --> 00:18:52,040
!للحديث معنا عن بثّ فيغابانك العالميّ

276
00:18:52,630 --> 00:18:54,500
أهو اختراق من نوع ما؟

277
00:18:54,550 --> 00:18:58,760
لكنّ حلزون الاتّصال عاد لطبيعته في النّهاية

278
00:18:58,760 --> 00:19:01,640
!وأعطانا تلميحًا

279
00:19:01,640 --> 00:19:05,590
.وسارع كيوتارو لإيقافه

280
00:19:05,650 --> 00:19:08,190
الشّخص الوحيد القادر على ذلك

281
00:19:08,190 --> 00:19:10,860
،هو الرّجل صاحب أكبر دماغ في العالم

282
00:19:10,860 --> 00:19:14,420
!الدّكتور فيغابانك ولا أحد سواه-تيا

283
00:19:15,630 --> 00:19:30,770
جواب صحيح

284
00:19:18,550 --> 00:19:21,810
!إجابة جيّدة، عمل ممتاز

285
00:19:22,660 --> 00:19:24,850
ومن أنتما؟

286
00:19:24,850 --> 00:19:28,700
!نحن من أقمار فيغابانك واسمي ليليث

287
00:19:28,700 --> 00:19:31,200
!وأنا إديسون

288
00:19:31,500 --> 00:19:35,630
نريد أن نحرص أنّ الجميع يتذكّرون

289
00:19:35,630 --> 00:19:38,170
.الرّسالة الّتي تركها ستيلا

290
00:19:38,300 --> 00:19:40,180
،وكما قلتم بالضّبط

291
00:19:40,220 --> 00:19:46,030
فقد قمنا بتعديل حلزون الاتّصال لإنشاء

292
00:19:46,030 --> 00:19:49,520
!مسابقة أسئلة تفاعليّة عن بعد

293
00:19:49,520 --> 00:19:54,100
إنّه مجرّد نموذج أوّلي، لكنّه ممتع، صحيح؟

294
00:19:54,110 --> 00:19:56,130
مسابقة أسئلة تفاعليّة؟

295
00:19:56,130 --> 00:19:59,190
لعبة مسابقة أسئلة؟

296
00:19:59,280 --> 00:20:03,070
!وبفضلكم، استطعنا تحديد بعض الأعطال

297
00:20:03,070 --> 00:20:04,410
!شكرًا لكم

298
00:20:04,410 --> 00:20:08,070
!وبمجرّد أن يجهز، سنبيعه ونجني ثروة

299
00:20:08,210 --> 00:20:10,870
!الكثير من المال لبحوثنا

300
00:20:12,250 --> 00:20:17,330
إذًا فقد كنتما تختبران هذه اللّعبة علينا؟

301
00:20:18,590 --> 00:20:20,130
!صحيح

302
00:20:20,510 --> 00:20:22,510
هل تمازحانني؟

303
00:20:22,510 --> 00:20:26,600
!ستدفعان ثمن هذا

304
00:20:26,600 --> 00:20:28,100
!عودي إلى هنا

305
00:20:28,100 --> 00:20:30,940
!آسف! لا تغضب علينا هكذا

306
00:20:30,940 --> 00:20:34,930
!تتطلّب أيّ تجربة بعض التّضحيات

307
00:20:38,320 --> 00:20:40,190
!كاروت

308
00:20:40,860 --> 00:20:42,650
أتريدين منه أيضًا؟

309
00:20:42,660 --> 00:20:46,450
!أنت حيّ يا أخي تشو

310
00:20:46,450 --> 00:20:48,820
حيّ؟ عمّ تتحدّثين؟

311
00:20:49,080 --> 00:20:52,580
دعاني كلّ من ليليث وإديسون

312
00:20:52,580 --> 00:20:54,740
!لتناول بعض غزل البنات

313
00:21:00,260 --> 00:21:02,920
!إنّها جنّة غزل بنات

314
00:21:05,430 --> 00:21:09,120
.خُدعتَ ببساطة

315
00:21:09,120 --> 00:21:12,100
!عشنا الأمرّين بسبب هذا

316
00:21:12,100 --> 00:21:15,730
كن حذرًا يا أخي تشو عندما تبدو
!الأمور أفضل ممّا يجب أن تكون

317
00:21:15,730 --> 00:21:17,640
عمّ تتحدّثين؟

318
00:21:18,530 --> 00:21:21,850
!غزل البنات ناعم وحلو، إنّه لذيذ جدًّا

319
00:23:04,420 --> 00:23:08,740
تمنع هجمات الشّيوخ الخمسة الشّرسة
!بوني والبقيّة من الهرب من إيغهيد

320
00:23:08,740 --> 00:23:10,510
،وبينما بوني محاصرة في الزّاوية

321
00:23:10,510 --> 00:23:13,550
فإن صوت طبول التّحرير الّتي رقصت
.عليها معا والدها يتردّد في آذانها

322
00:23:13,850 --> 00:23:17,060
المستقبل الّتي كانت بوني توّاقة
،لتتشاركه مع كوما

323
00:23:17,060 --> 00:23:19,710
!أيقظ قوّة جديدة الآن

324
00:23:19,980 --> 00:23:21,670
:في الحلقة القادمة من وان بيس

325
00:23:21,670 --> 00:23:25,520
"حلمها وحلم والدها! مستقبل بوني الحرّ"

326
00:23:25,530 --> 00:23:28,100
!ملك القراصنة، لن يكون إلاّ أنا