1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,490
...اسعوا نحو الحرّيّة

3
00:00:13,490 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:01,790 --> 00:02:05,800
ما رأيك بهذه الحيل المربحة؟"
"!طموحات زيني الدّائِن

22
00:02:21,950 --> 00:02:24,620
!هيّا، هيّا، ألا يمكنكم أن تبذلوا جهدًا أكبر؟

23
00:02:24,620 --> 00:02:26,520
!لستم تتسكّعون الآن

24
00:02:26,520 --> 00:02:28,420
!ألا يمكنكم أن تعملوا بجدّ أكثر؟

25
00:02:28,990 --> 00:02:31,260
!أيّها العجوز، اجلس هناك بهدوء

26
00:02:31,260 --> 00:02:32,760
!سنتكفّل بهذا

27
00:02:33,160 --> 00:02:35,630
.هيّا يا جدّي، نل بعض الرّاحة

28
00:02:36,790 --> 00:02:38,660
هل تريد أن أدلّك كتفيك؟

29
00:02:40,470 --> 00:02:41,500
مـ-ما هذا؟

30
00:02:41,500 --> 00:02:45,970
إذًا، لمَ تتعمّد بناء هذه السّفينة
في قمّة الجبل أيّها العجوز؟

31
00:02:45,970 --> 00:02:48,570
.لنرَ... ذلك لأنّها ليست سفينة

32
00:02:49,810 --> 00:02:51,110
هذه ليست سفينة؟

33
00:02:51,110 --> 00:02:54,550
اسمع! إلّم تكن هذه سفينةً
!فما هي بالضّبط إذًا؟

34
00:02:55,150 --> 00:02:56,920
...إنّها

35
00:02:57,880 --> 00:02:59,020
.تابوتي

36
00:02:59,350 --> 00:03:00,950
تابوت؟

37
00:03:02,690 --> 00:03:03,560
!نعم

38
00:03:03,890 --> 00:03:05,660
.ستكون قبري

39
00:03:05,920 --> 00:03:08,290
.فهمت. هذا قبرك إذًا يا عجوز الماعز

40
00:03:08,290 --> 00:03:09,990
!لا تدعُ لأجله الآن! ستجلب له النّحس

41
00:03:10,430 --> 00:03:11,800
!ما زال من المبكّر على هذا

42
00:03:11,800 --> 00:03:13,530
!أنت تبالغ في التّحضير

43
00:03:13,830 --> 00:03:18,640
هل يُعقل أنّ الجدّ يعلم
أنّ أجله قريب؟

44
00:03:19,770 --> 00:03:21,510
لِمَ فزعتِ؟

45
00:03:21,810 --> 00:03:23,510
،بعيشي في جزيرة كهذه

46
00:03:23,510 --> 00:03:26,710
ليس من الغريب أن أصنع
قبري، أليس كذلك؟

47
00:03:27,150 --> 00:03:29,850
.سأموت يومًا ما في النّهاية

48
00:03:30,680 --> 00:03:34,120
.ليس "يومًا ما" بل قريبًا جدًّا

49
00:03:34,690 --> 00:03:37,160
ليس من الغريب أن يكون
القبر في قمّة الجبل، صحيح؟

50
00:03:37,420 --> 00:03:39,690
لكن لِمَ تريد أن تجعل
من سفينة قراصنة قبرك؟

51
00:03:43,360 --> 00:03:45,330
!ا-العجوز

52
00:03:46,000 --> 00:03:47,230
!ا-انتظر أيّها الجدّ

53
00:03:47,230 --> 00:03:49,670
،تـ-تابوت أو قـ-قبر، أيّ ما تريد

54
00:03:49,670 --> 00:03:52,240
!نكاد ننتهي منها، لذا لا تعجّل في الرّحيل

55
00:03:52,240 --> 00:03:53,270
!لا تمت بعد

56
00:03:53,270 --> 00:03:57,140
.صه... إنّه نائم

57
00:04:03,310 --> 00:04:06,280
وجدتم قراصنة قبّعة القشّ إذًا؟

58
00:04:06,950 --> 00:04:07,720
!نعم

59
00:04:07,720 --> 00:04:11,760
أعتقد أنّهم رسوا في جزيرة
.مهجورة كما أفدتُ في بلاغي السّابق

60
00:04:13,060 --> 00:04:15,130
!حسنًا، تأهّبوا للهجوم حالاً

61
00:04:15,730 --> 00:04:20,400
،سوف نقتحم الجزيرة بكلّ قوّاتنا
!وسنقبض على قراصنة قبّعة القشّ

62
00:04:20,400 --> 00:04:21,800
!فردًا فردًا

63
00:04:21,800 --> 00:04:23,300
!انتظر أيّها النّقيب

64
00:04:24,400 --> 00:04:27,470
،إضافة إلى مستخدمي قدرات فواكه الشّيطان

65
00:04:27,470 --> 00:04:30,380
.سنواجه السّيّاف الضّليع، رورونوا زورو

66
00:04:32,310 --> 00:04:36,050
وماذا إذًا؟ هل أنت خائف أيّها الرّقيب مينتشي؟

67
00:04:36,050 --> 00:04:37,680
!بالطّبع لا

68
00:04:37,680 --> 00:04:40,520
.أريد تجنّب أيّ خسائر غير ضروريّة فحسب

69
00:04:40,520 --> 00:04:42,150
ماذا تقترح أن نفعل إذًا؟

70
00:04:42,590 --> 00:04:44,860
،إن فعلت ما أقول أيّها النّقيب

71
00:04:44,860 --> 00:04:50,800
فسوف تظفر بنصرٍ ساحق
.ولن نتكبّد إلاّ خسائر قليلة

72
00:04:55,670 --> 00:04:56,130
.حسنًا

73
00:04:57,300 --> 00:04:58,800
هذه حركتك إذًا؟

74
00:04:59,940 --> 00:05:01,010
!لذيذ

75
00:05:01,670 --> 00:05:04,110
كيف أعددت هذا الجبن؟

76
00:05:04,440 --> 00:05:06,110
.من حليب ماعز الجزيرة

77
00:05:06,110 --> 00:05:08,110
.سيمدّك بالكثير من الطّاقة أيّها العجوز

78
00:05:09,310 --> 00:05:12,080
.مع أنّ هذا لن يغيّر في الواقع شيئًا

79
00:05:12,380 --> 00:05:14,090
.حسنًا، إنّه دورك يا جدّي

80
00:05:14,350 --> 00:05:16,090
...لنرَ

81
00:05:16,450 --> 00:05:18,090
.حسنًا، كشّ ملك

82
00:05:19,960 --> 00:05:21,330
!انتظر لحظة

83
00:05:21,330 --> 00:05:23,800
!لا يوجد انتظار يا نامي-تشان

84
00:05:24,400 --> 00:05:25,860
...نلتَ منّي

85
00:05:25,860 --> 00:05:27,770
بالمقابل، هل نلعب ثانيةً؟

86
00:05:27,770 --> 00:05:28,970
.حسنًا

87
00:05:28,970 --> 00:05:34,240
لا شيء يضاهي لعب الشّطرنج مع
!حسناء مثلك بينما تُدلَّك كتفاي

88
00:05:36,940 --> 00:05:38,580
!صيدنا كبير اليوم

89
00:05:39,140 --> 00:05:43,110
سانجي، هلاّ أعددت لعجوز
الماعز أكلاً شهيًّا ثانيةً؟

90
00:05:43,110 --> 00:05:44,450
.أجل، دع الأمر لي

91
00:05:45,150 --> 00:05:48,750
أيّها العجوز، إن كان هناك
،ما تريد أكله أو تريد منّا فعله

92
00:05:48,750 --> 00:05:52,820
لا تخجل في السّؤال، اتّفقنا؟
!سنبذل كلّ ما في وسعنا

93
00:05:52,820 --> 00:05:55,730
.كلاّ، يمكنني أن أموت مبتسمًا الآن

94
00:05:56,730 --> 00:05:59,600
...أنا في النّعيم... النّعيم

95
00:05:59,600 --> 00:06:01,600
!لا تقل هذا

96
00:06:01,600 --> 00:06:03,070
...حتّى إن كان أجلك قريبًا

97
00:06:03,070 --> 00:06:04,570
!عليك أن تعيش بتفكيرٍ إيجابيّ

98
00:06:04,570 --> 00:06:06,940
!إلى آخر نفس لك

99
00:06:07,670 --> 00:06:09,340
اسمعوا، ألا يبدو هذا غريبًا؟

100
00:06:09,640 --> 00:06:10,410
ماذا؟

101
00:06:10,410 --> 00:06:13,480
يفترض بالعجوز أن يملك
ثلاثة أيّام في حياته، صحيح؟

102
00:06:13,480 --> 00:06:15,480
.صحيح. ثلاثة أيّام

103
00:06:15,480 --> 00:06:17,180
.سيعيش لثلاثة أيّام فقط

104
00:06:17,180 --> 00:06:20,520
سيمرّ ذلك الوقت بسرعة، أليس كذلك؟

105
00:06:21,620 --> 00:06:25,560
.بالفعل. مرّت ثلاثة أيّام بسرعة

106
00:06:27,030 --> 00:06:28,030
.معك حقّ

107
00:06:28,630 --> 00:06:32,700
إذًا، لِمَ لا يزال مفعمًا بالحياة؟

108
00:06:32,700 --> 00:06:35,630
كما أنّه في صحّة أفضل
من السّابق، أليس كذلك؟

109
00:06:36,300 --> 00:06:37,670
.المزيد من الجبن

110
00:06:39,400 --> 00:06:41,140
.أيّها العجوز، إليك دواء اليوم

111
00:06:41,740 --> 00:06:42,970
.احرص على أخذه

112
00:06:42,970 --> 00:06:46,540
لم أعد أحتاجه. إنّه يجعل
.طعم الأكل سيّئًا في النّهاية

113
00:06:47,250 --> 00:06:49,110
!حسنًا، كشّ ملك

114
00:06:50,080 --> 00:06:51,220
!ليس ثانيةً

115
00:06:51,580 --> 00:06:55,050
خلتُ أنّ العجوز لم يتبقّ
.في حياته سوى ثلاثة أيّام

116
00:06:55,720 --> 00:06:59,120
بالنّظر إلى حاله، يبدو وكأنّه
.سيعيش ثلاثين سنة أخرى

117
00:06:59,120 --> 00:07:00,530
هل أخطأت في تشخيصه؟

118
00:07:00,860 --> 00:07:03,060
.كلاّ. ذلك غير ممكن

119
00:07:03,460 --> 00:07:06,500
،مع ذلك، إن أخطأت في تشخيصه
لن يكون ذلك سيّئًا، صحيح؟

120
00:07:06,730 --> 00:07:08,700
!ذلك ليس بيت القصيد

121
00:07:08,700 --> 00:07:12,340
إن كان الأمر هكذا، فسأغادر
.الجزيرة مهما كان رأي الجميع

122
00:07:12,800 --> 00:07:13,710
.أجل

123
00:07:13,710 --> 00:07:17,540
لا يمكننا البقاء هنا
.وتدليل ذلك العجوز إلى الأبد

124
00:07:17,540 --> 00:07:19,310
.أريد الإبحار إلى مغامرات جديدة أيضًا

125
00:07:20,150 --> 00:07:21,410
.قُضي الأمر إذًا

126
00:07:21,680 --> 00:07:23,950
!نامي، سوف نبحر

127
00:07:23,950 --> 00:07:25,880
أ-أيمكنكم أن تنتظروا قليلاً بعد؟

128
00:07:25,880 --> 00:07:29,850
إلى متى ستتسكّعين؟
.كفّي عن لعب الشّطرنج

129
00:07:30,120 --> 00:07:32,360
!لا يمكنني التّوقّف عن اللّعب

130
00:07:32,360 --> 00:07:35,960
خسرتُ مرّات عدّة لدرجة
.أنّني رهنتُ سفينتنا لهذا العجوز

131
00:07:36,690 --> 00:07:38,200
!ماذا؟

132
00:07:38,600 --> 00:07:41,670
ماذا يفترض بالقراصنة
!الّذين فقدوا سفينتهم أن يفعلوا؟

133
00:07:41,670 --> 00:07:44,240
!سأستعيدها حتمًا، انتظروا

134
00:07:44,240 --> 00:07:45,900
.كشّ ملك

135
00:07:46,970 --> 00:07:48,070
!توقّفي

136
00:07:48,070 --> 00:07:49,240
!زلزال

137
00:07:49,770 --> 00:07:52,880
إن واصلت هذا، فلا ندري
!ما قد ترهنيه أيضًا

138
00:07:53,550 --> 00:07:59,780
إن أردتم استرجاع سفينتكم، عليكم
.العمل في هذه الجزيرة بقدر قيمتها

139
00:08:00,650 --> 00:08:04,860
وفقًا لحسابي، سيكون عليكم
.العمل لعشر سنوات في المجموع

140
00:08:05,220 --> 00:08:07,290
ما رأيكم بحيلتي المربحة؟

141
00:08:10,300 --> 00:08:12,300
!نامي

142
00:08:10,300 --> 00:08:12,300
!نامي-سان

143
00:08:12,300 --> 00:08:14,730
،آسفة، ظننتُ أنّه إن حالفني الحظّ

144
00:08:14,730 --> 00:08:18,270
يمكنني أن أجعل العجوز
.يخبرنا عن مكان الكنز

145
00:08:18,600 --> 00:08:21,440
أما زلت تفكّرين في ذلك؟

146
00:08:21,440 --> 00:08:24,610
في هذه المرحلة، خيارنا الوحيد
.هو أن نترك العجوز ونهرب

147
00:08:25,040 --> 00:08:26,080
.لا أريد

148
00:08:26,080 --> 00:08:27,950
ماذا تقول يا لوفي؟

149
00:08:27,950 --> 00:08:30,280
!من الجيّد لنا أنّ زورو أدركَ الأمر

150
00:08:30,280 --> 00:08:34,720
وإلاّ كنّا لنمضي ما بقي من حياتنا
!في هذه الجزيرة نخدم ذلك العجوز

151
00:08:34,720 --> 00:08:36,290
!ألا يمكنك أن تدرك الأمر أيضًا؟

152
00:08:36,290 --> 00:08:39,260
.لا يمكنك خوض أيّ مغامرات هنا يا لوفي

153
00:08:39,260 --> 00:08:40,020
.لنذهب

154
00:08:40,020 --> 00:08:40,530
.لا أريد

155
00:08:40,530 --> 00:08:41,160
!لوفي

156
00:08:41,690 --> 00:08:44,100
الرّهان يشبه الوعد، صحيح؟

157
00:08:44,100 --> 00:08:46,300
.في تلك الحالة، لا أريد نكث أيّ وعد

158
00:08:46,300 --> 00:08:48,370
!لا وقت لدينا للتّفكير في المبادئ

159
00:08:48,700 --> 00:08:50,700
ما رأيك يا زورو؟

160
00:08:50,700 --> 00:08:53,040
القائد هو من يقرّر، صحيح؟

161
00:08:53,040 --> 00:08:53,870
!لوفي

162
00:08:54,270 --> 00:08:55,840
.قلت لا أريد، يعني لا

163
00:08:56,210 --> 00:08:57,210
.كشّ ملك

164
00:09:01,580 --> 00:09:03,110
...هـ-هذا

165
00:09:03,550 --> 00:09:05,350
يمكننا استعادة سفينتنا إذًا؟

166
00:09:08,590 --> 00:09:10,560
ما رأيك أيّها الجدّ؟

167
00:09:12,490 --> 00:09:13,990
...نلتم منّي

168
00:09:13,990 --> 00:09:15,590
!مرحى

169
00:09:15,590 --> 00:09:18,400
!يمكننا الاعتماد عليك دائمًا يا أختي

170
00:09:18,730 --> 00:09:20,400
ما رأيك بهذه الحيلة المربحة؟

171
00:09:20,400 --> 00:09:22,100
.ممتازة، شكرًا

172
00:09:25,240 --> 00:09:30,540
عمّرتُ طويلاً، لكنّي لم أرَ في حياتي قراصنة
.مثيرين للاهتمام مثلكم. أحببتكم حقًّا

173
00:09:30,540 --> 00:09:32,310
!لنحتفل جيّدًا اللّيلة

174
00:09:33,910 --> 00:09:37,020
!أجل، وليمة للاحتفال باستعادتنا لسفينتنا

175
00:09:46,460 --> 00:09:49,290
.تبدو كقرصان عظيم أيّها الجدّ

176
00:09:49,760 --> 00:09:51,130
.تحتمل الشّرب حقًّا

177
00:09:52,760 --> 00:09:55,230
هل تدعينني بقرصان يا نامي-تشان؟

178
00:09:59,300 --> 00:10:01,410
يُمكن اعتبارها كنزًا حقًّا، صحيح؟

179
00:10:02,640 --> 00:10:06,740
نامي، تحاولين جعل العجوز يثمل
ليبوح لك بمكان الكنز، صحيح؟

180
00:10:06,980 --> 00:10:08,510
!لا تفضحني أمامه

181
00:10:08,510 --> 00:10:12,220
يا عجوز الماعز، هل تملك كنزًا حقًّا؟

182
00:10:12,950 --> 00:10:15,620
!أخبرتكم للتّوّ ألاّ تتكلّموا جهرًا

183
00:10:15,620 --> 00:10:18,160
!هناك أشياء تسير بالتّرتيب الصّحيح

184
00:10:18,160 --> 00:10:20,060
...كنزي

185
00:10:22,030 --> 00:10:26,500
هو ما شاركت معه فرحتي وتعاستي
،مذ ألقى بي البحر على هذه الجزيرة

186
00:10:26,500 --> 00:10:28,000
.أي ماعز الجزيرة

187
00:10:29,270 --> 00:10:31,300
!يا لها من قصّة رائعة

188
00:10:31,300 --> 00:10:32,540
!نلت منكم

189
00:10:34,440 --> 00:10:37,410
!لا تقل "نلت منكم"، بل أخبرنا بقصدك

190
00:10:37,410 --> 00:10:39,040
.حسنًا، سأخبركم

191
00:10:39,040 --> 00:10:43,050
بالنّسبة لكلّ القراصنة العظماء
...الّذين جابوا الغراند لاين، أنا

192
00:10:43,050 --> 00:10:43,850
!عرفتها

193
00:10:45,120 --> 00:10:47,690
.الدّائِن الّذي كان يتعامل معهم

194
00:10:47,990 --> 00:10:48,850
دائِن؟

195
00:10:48,850 --> 00:10:52,560
!نعم. أنا زيني الدّائِن، لستُ قرصانًا

196
00:10:52,560 --> 00:10:53,590
لست كذلك؟

197
00:10:53,590 --> 00:10:55,190
هذا مؤسف، صحيح يا نامي؟

198
00:10:55,430 --> 00:11:00,670
لكن مع ذلك، أنت جريء حقًّا لتقرض
المال للقراصنة، أليس كذلك أيّها العجوز؟

199
00:11:00,670 --> 00:11:01,630
لماذا؟

200
00:11:01,900 --> 00:11:03,670
!هذا واضح

201
00:11:03,670 --> 00:11:06,910
أتظنّ أنّ القراصنة يعيدون
المال إن اقترضوه؟

202
00:11:06,910 --> 00:11:08,440
.ما بالك بالفائدة

203
00:11:08,770 --> 00:11:10,210
.معك حقّ

204
00:11:10,210 --> 00:11:13,650
.لقد خدعني الجميع ولم يسدّدوا لي دينهم

205
00:11:13,910 --> 00:11:17,120
،نكث كلّ واحد من أولئك اللّعناء وعده

206
00:11:17,120 --> 00:11:19,620
.وكانت الخيانة من أبرز شيمهم

207
00:11:19,950 --> 00:11:23,350
إذًا أيّها الجدّ، أصحيحٌ أنّك تكره القراصنة؟

208
00:11:23,660 --> 00:11:27,790
،لو أنّني رضيتُ بما فعلوه لي
.لضُرب بعملي وربحي عرض الحائط

209
00:11:31,630 --> 00:11:36,330
لقد اضطررتُ لقتال القراصنة
،كلّما ذهبتُ لأخذ ديني

210
00:11:36,940 --> 00:11:38,570
.مخاطرًا بحياتي

211
00:11:43,110 --> 00:11:46,950
إنّه عملٌ يتطلّب منك أن تكون
أقوى من القراصنة، أليس كذلك؟

212
00:11:47,310 --> 00:11:49,510
هل كنتَ بتلك القوّة يا عجوز الماعز؟

213
00:11:49,510 --> 00:11:51,920
.لا أريد أن أتفاخر، لقد كنتُ ضعيفًا

214
00:11:51,920 --> 00:11:54,350
.لكنّي كنتُ أملك حلمًا

215
00:11:54,850 --> 00:11:55,790
حلم؟

216
00:11:59,690 --> 00:12:00,930
أنت أيّها الجدّ؟

217
00:12:19,440 --> 00:12:20,410
ماذا؟

218
00:12:20,910 --> 00:12:23,180
نعيد الدّين؟

219
00:12:23,550 --> 00:12:26,550
!أنا الرّجل الّذي يُلقّب بالّدائِن زيني

220
00:12:26,550 --> 00:12:30,520
أفضّل أن أبعثكم للجحيم
.على أن أدعكم تهربون بمالي

221
00:12:30,520 --> 00:12:32,290
هل نذهب إلى الآخرة معًا؟

222
00:12:32,290 --> 00:12:33,960
!انتظر يا زيني

223
00:12:34,490 --> 00:12:35,190
!خذ

224
00:12:35,190 --> 00:12:38,000
.ما رأيكم بحيلتي المبرحة؟ وداعًا

225
00:12:38,000 --> 00:12:40,370
!لن تفعل! عليك أن تعطي القراصنة حقّهم

226
00:12:40,700 --> 00:12:42,470
.سأفعل

227
00:12:48,710 --> 00:12:51,380
!زيني! كيف تجرؤ؟

228
00:12:52,110 --> 00:12:53,710
!أشكركم

229
00:12:54,810 --> 00:12:58,320
،ربّما كنتُ ضعيفًا، لكن كان لديّ حلم
.لذا قاتلتُ باستماتة لأجله

230
00:12:58,320 --> 00:13:00,080
.لا، تمكّنتُ من القتال لأجله

231
00:13:00,350 --> 00:13:02,020
ما كان حلمك أيّها العجوز؟

232
00:13:02,020 --> 00:13:05,120
.مذ كنتُ طفلاً وأنا أريد أن أصبح قرصانًا

233
00:13:05,120 --> 00:13:08,430
.قرصان حقيقيّ. ملك القراصنة

234
00:13:08,430 --> 00:13:11,160
.لهذا بدأتُ أوّلاً في مجال الإقراض

235
00:13:12,660 --> 00:13:16,770
لكنّي هوجمت على حين غرّة من قبل
قراصنة لعناء صبّوا جامّ غضبهم عليّ

236
00:13:16,770 --> 00:13:20,510
،ليُلقيني البحر إلى هذه الجزيرة
.ساكنًا فيها ما بقي من حياتي

237
00:13:20,510 --> 00:13:23,140
كان ذلك قبل عشرين سنة، أليس كذلك؟

238
00:13:23,140 --> 00:13:26,480
هل كنت تصنع ذلك القبر
منذ عشرين سنة؟

239
00:13:26,480 --> 00:13:30,150
في البداية، نويتُ بناء السّفينة
،بالقرب من البحر

240
00:13:30,150 --> 00:13:33,550
.لكنّي لم أقوَ على إنزال الخشب من الجبل

241
00:13:33,550 --> 00:13:38,190
،لذا قرّرتُ ألاّ أستسلم مهما كان
.بيد أنّي بنيتها في الجبل

242
00:13:38,190 --> 00:13:41,190
كان لي حلمٌ عظيم لم أستطع
.حسابه بمِعدادي

243
00:13:41,190 --> 00:13:42,790
!مغامرة عظيمة

244
00:13:42,790 --> 00:13:45,430
.لكن في مرحلةٍ ما، أفقتُ على الحقيقة

245
00:13:46,000 --> 00:13:52,740
قبل أن أدرك، كنتُ قد كبرتُ
.على الإبحار في الغراند لاين

246
00:13:53,270 --> 00:13:55,570
.وا حسرتي على حلمي لأصبح قرصانًا

247
00:13:57,310 --> 00:13:59,410
.ما الأحلام إلاّ أحلام في النّهاية

248
00:14:03,010 --> 00:14:05,820
لماذا استسلمت يا عجوز الماعز؟

249
00:14:07,150 --> 00:14:08,920
.لا علاقة للعمر بالأمر

250
00:14:08,920 --> 00:14:11,660
،إن أردتَ أن تصبح قرصانًا
.فعليك أن تفعل فحسب

251
00:14:13,360 --> 00:14:14,760
!اسمع يا لوفي

252
00:14:14,760 --> 00:14:17,460
ماذا سنفعل إن أخذ
العجوز كلامك محمل الجدّ؟

253
00:14:17,460 --> 00:14:19,500
.القراصنة يحتاجون سفينةً

254
00:14:18,060 --> 00:14:19,330
.أريد المزيد يا سانجي

255
00:14:19,330 --> 00:14:20,170
!تفضّل

256
00:14:19,500 --> 00:14:22,700
وسفينة العجوز عبارة
.عن تابوت في قمّة الجبل

257
00:14:20,170 --> 00:14:21,370
.شكرًا لك

258
00:14:22,700 --> 00:14:24,770
.علينا أن ننزلها فحسب إذًا

259
00:14:24,770 --> 00:14:26,400
!لا تقل ذلك وكأنّه سهل

260
00:14:27,010 --> 00:14:29,370
...صحيح... ما زال هنالك وقت

261
00:14:29,370 --> 00:14:31,840
.أرأيت؟ أخذ كلامك محمل الجدّ

262
00:14:31,840 --> 00:14:35,850
كلاّ، لم يفعل. أنت ثمل
فحسب، أليس كذلك يا جدّي؟

263
00:14:35,850 --> 00:14:37,850
!نعم، أنا ثمل، ثمل

264
00:14:39,480 --> 00:14:40,250
حقًّا؟

265
00:14:40,250 --> 00:14:44,220
!جعلني الشّابّ ذو قبّعة القشّ أسكر تمامًا

266
00:14:49,360 --> 00:14:50,730
!أجل

267
00:14:53,430 --> 00:14:55,100
أيمكننا هذا حقًّا؟

268
00:14:55,100 --> 00:14:58,470
نستدرج قراصنة قبّعة
القشّ من الجزيرة بأنفسنا؟

269
00:14:58,470 --> 00:15:00,570
،مهما كانوا أقوياء

270
00:15:00,570 --> 00:15:02,540
.فما زالوا أطفالاً أغرار

271
00:15:02,970 --> 00:15:06,340
،إن سرنا حسب خطّتنا
.ليس هنالك ما يخيفنا منهم

272
00:15:06,340 --> 00:15:08,710
.ليس وكأنّنا سنقاتلهم

273
00:15:08,710 --> 00:15:10,280
.سترى على أيّ حال

274
00:15:10,280 --> 00:15:13,220
هل سيتمكّن النّقيب
من قراصنة قبّعة القشّ؟

275
00:15:13,220 --> 00:15:16,020
.ذلك لا يخصّني

276
00:15:16,020 --> 00:15:18,360
بينما يذهب كبار الشّأن
،للقتال لأجل العدالة

277
00:15:18,360 --> 00:15:20,430
.سنستولي نحن على الكنز

278
00:15:20,860 --> 00:15:23,390
.أيّها العريف، سيكون لك دور في هذا أيضًا

279
00:15:23,390 --> 00:15:25,460
.وسأكافئك على خدمتك بسخاء

280
00:15:25,460 --> 00:15:26,360
.حـ-حاضر

281
00:15:37,380 --> 00:15:40,010
لا علاقة للعمر بالأمر إذًا؟

282
00:15:40,810 --> 00:15:44,480
أخذ على عاتقه قول شيء
.يجعل عجوزًا مثلي يحلم

283
00:15:45,150 --> 00:15:48,020
.ذلك الشّابّ ذو قبّعة القشّ خسيس بحقّ

284
00:15:49,650 --> 00:15:50,720
.معك حقّ

285
00:15:51,620 --> 00:15:52,590
روبين-تشان؟

286
00:15:53,260 --> 00:15:57,730
كما أنّ قائدنا يُنقذ النّاس الّذين يريدون
.الموت دون إذنهم ويدعهم يعيشون

287
00:15:59,000 --> 00:16:00,800
هل أنت مسرورة لأنّه تركك تعيشين؟

288
00:16:00,800 --> 00:16:03,770
.بالفعل... لستُ واثقة جدًّا من ذلك بعد

289
00:16:03,770 --> 00:16:05,770
.لستِ نادمة لأنّه فعل

290
00:16:07,070 --> 00:16:11,740
.أرى ذلك باديًا على وجهك
.حياتك بدأت للتّوّ يا روبين-تشان

291
00:16:13,780 --> 00:16:18,550
لكن بالّنسبة لي... سيرقد
.حلمي هنا أبد الدّهر

292
00:16:28,030 --> 00:16:28,960
!ما الخطب؟

293
00:16:29,260 --> 00:16:31,500
!مصيبة! استيقظوا جميعًا

294
00:16:33,970 --> 00:16:36,330
نمتُ جيّدًا حقًّا. أحان وقت الإفطار؟

295
00:16:36,330 --> 00:16:38,400
!البحريّة! أتت البحريّة

296
00:16:38,400 --> 00:16:39,740
!ماذا؟

297
00:16:45,380 --> 00:16:46,710
سفينة واحدة فقط؟

298
00:16:46,710 --> 00:16:48,580
.لا يبدو أنّهم على وشك الهجوم أيضًا

299
00:16:49,480 --> 00:16:50,850
ما الّذي يجري هنا بالضّبط؟

300
00:16:51,180 --> 00:16:53,180
!مرحبًا يا قراصنة قبّعة القشّ

301
00:16:53,180 --> 00:16:56,150
.أنا رقيب البحريّة مينتشي، مسور للقائكم

302
00:16:56,450 --> 00:16:57,560
مسرور؟

303
00:16:57,560 --> 00:17:00,230
.اسمعوا، أنا آسف حقًّا لما حدث ذلك اليوم

304
00:17:00,790 --> 00:17:05,230
،لو أنّنا عرفنا من تكونون حقًّا
.لما واصلنا ملاحقتكم كما فعلنا

305
00:17:05,230 --> 00:17:06,700
.آمل أن تقبلوا اعتذارنا

306
00:17:06,970 --> 00:17:11,600
أوليس ما تقوله غريبًا؟ من الطّبيعيّ
.أن تلاحق البحريّة القراصنة

307
00:17:11,600 --> 00:17:15,140
.إنّه يتصرّف بكرمٍ مشبوه
.ابقوا متيقّظين

308
00:17:16,140 --> 00:17:18,480
!لا تنزعجوا أرجوكم

309
00:17:18,480 --> 00:17:22,780
أعي أنّكم من هزم كروكودايل
في ألاباستا، أليس كذلك؟

310
00:17:22,780 --> 00:17:25,850
!ما كنتُ لأجرؤ على قتال قراصنة أقوياء مثلكم

311
00:17:25,850 --> 00:17:27,450
.صدّقوني

312
00:17:27,450 --> 00:17:31,690
،أقصد أنّنا إن كنّا سنهاجمكم
هل كنّا لنأتي إلى هنا بسفينة واحدة؟

313
00:17:31,960 --> 00:17:35,860
ما هذا؟ إنّه خائف منّا، أليس كذلك؟

314
00:17:37,030 --> 00:17:39,530
،حتّى إن افترضنا أنّنا خاطرنا بحياتنا لقتالكم

315
00:17:39,530 --> 00:17:41,700
.ما كنّا لندرّ من ذلك أيّ ربح

316
00:17:42,000 --> 00:17:43,540
ما الّذي تفعلونه هنا إذًا؟

317
00:17:43,870 --> 00:17:46,670
.أتينا إلى هنا للتّحرّي عن الجزيرة فقط

318
00:17:46,670 --> 00:17:49,670
إنّها جزيرة حديثة الاكتشاف
.وغير موجودة على خرائطنا

319
00:17:49,670 --> 00:17:52,880
تتحرّون؟ لا يوجد في هذه
.الجزيرة سوى عجوز وماعزه

320
00:17:53,280 --> 00:17:55,750
على ذكره، أين ذهب العجوز؟

321
00:17:56,280 --> 00:17:59,720
فهمت. إذًا فزيني آمن
هنا ويتلقّى الرّعاية، صحيح؟

322
00:18:00,150 --> 00:18:01,150
زيني؟

323
00:18:01,520 --> 00:18:04,990
،فور أن ننتهي من دوريّتنا
.سنعود إلى قاعدتنا

324
00:18:05,320 --> 00:18:08,360
من الأفضل أن تبحروا من هنا
.بأسرع ما يمكن

325
00:18:08,360 --> 00:18:09,460
.لن ألومكم

326
00:18:09,830 --> 00:18:14,300
فمقرّات البحريّة متعطّشة
.للتخلّص منكم قبل كلّ شيء

327
00:18:14,300 --> 00:18:17,740
.فهمت. يبدو أنّ هذه فرصتنا أيضًا

328
00:18:17,740 --> 00:18:21,270
.سأذهب لإحضار الطّعام
.يجب أن أنادي على روبين لتنزل أيضًا

329
00:18:29,750 --> 00:18:30,850
...إنّه

330
00:18:31,680 --> 00:18:34,190
!فخّ! إنّه فخّ من البحريّة

331
00:18:36,790 --> 00:18:38,520
هل نبحر يا لوفي؟

332
00:18:39,790 --> 00:18:42,260
.ثمّة طقس جميل خلف الضّباب

333
00:18:42,260 --> 00:18:45,600
.والأمواج هادئة، ولن نمسّكم بسوء بأيّ شكل

334
00:18:45,600 --> 00:18:46,870
.هيّا، بادروا

335
00:18:47,200 --> 00:18:49,100
!أذهب عندما يحلو لي

336
00:18:49,100 --> 00:18:50,340
!لست أنت من يقرّر

337
00:18:51,540 --> 00:18:52,800
،إن كنتُ مكان البحريّة

338
00:18:52,800 --> 00:18:55,910
،كنتُ لأقاتلنا باستماتة
!وإن كنت أملك سفينةً واحدة

339
00:18:55,910 --> 00:18:58,180
!كما أنّ هنالك شيءٌ آخر مريب

340
00:18:58,180 --> 00:19:01,680
كيف عرفت أنّ اسم الجدّ زيني؟

341
00:19:01,680 --> 00:19:03,520
.لم نذكره قطّ

342
00:19:04,050 --> 00:19:05,280
...فـ-في الواقع

343
00:19:05,650 --> 00:19:09,590
.أشكّ في نوع الفحص الّذي تنوون إجراءه

344
00:19:09,590 --> 00:19:11,620
لا تقل أنّك تسعى خلف كنز الجدّ؟

345
00:19:13,120 --> 00:19:16,690
!هكذا الأمر إذًا! لا أثق بهذا الشّخص

346
00:19:17,630 --> 00:19:19,400
اكتشفوا الأمر إذًا؟

347
00:19:19,400 --> 00:19:24,470
اكتشفوا جبل الكنوز الّتي جمعها زيني
الدّائِن ممّا تركه القراصنة رهنًا عنده؟

348
00:19:25,370 --> 00:19:27,940
!عرفتها! يملك الجدّ كنزًا بالفعل

349
00:19:29,440 --> 00:19:30,780
.أشتمّ رائحة البارود

350
00:19:31,080 --> 00:19:32,940
أهي مدافع ذلك الوغد؟

351
00:19:32,940 --> 00:19:34,410
.ليست مدافع سفينة واحدة

352
00:19:34,980 --> 00:19:37,020
.الرّائحة صادرة من مدافع لا أستطيع إحصاءها

353
00:19:37,020 --> 00:19:38,520
!ما ذلك الشّيء هناك؟

354
00:19:38,520 --> 00:19:43,290
لو أنّنا أبحرنا، لكنّا هوجمنا
!بغتةً من قبل ذلك الأسطول

355
00:19:43,290 --> 00:19:44,960
!إنّهم يعبثون معنا

356
00:19:44,960 --> 00:19:47,360
،لا أهتمّ إن كانوا أسطولاً
!أقبلوا علينا

357
00:19:47,360 --> 00:19:48,630
!ا-انتظر

358
00:19:49,960 --> 00:19:51,300
!لـ-لوفي

359
00:19:51,300 --> 00:19:52,260
!أوسوبّ

360
00:19:52,560 --> 00:19:54,170
!رفاق

361
00:19:54,170 --> 00:19:57,740
!لا تحرّكوا ساكنًا! حركة واحدة وسأقتله

362
00:19:58,670 --> 00:20:01,510
سبق ونزل رجالهم واختبؤوا هناك؟

363
00:20:01,770 --> 00:20:03,710
!أحسنت أيّها العريف

364
00:20:05,310 --> 00:20:07,650
!أسرعي وأخبريهم

365
00:20:07,650 --> 00:20:09,680
مهلاً، لن تصل في الوقت
.حتّى إن غادرت الآن

366
00:20:10,080 --> 00:20:11,920
لكن ماذا يمكننا فعله؟

367
00:20:11,920 --> 00:20:14,590
على هذا الحال، شابّ قبّعة
...القشّ والبقيّة سوف

368
00:20:15,220 --> 00:20:16,990
.هذه فوضى

369
00:20:17,760 --> 00:20:19,720
ما العمل؟

370
00:20:19,720 --> 00:20:22,590
.أيّها الجدّ، أنت قرصان، صحيح؟ افعل شيئًا

371
00:20:22,590 --> 00:20:27,400
،هذا جنون! قد أكون قرصانًا
.لكنّ هذه السّفينة تابوتي

372
00:20:27,400 --> 00:20:30,370
...إنّها في قمّة الجبل ومهما فعلت

373
00:20:30,970 --> 00:20:33,340
.علينا أن ننزلها فحسب إذًا

374
00:20:34,040 --> 00:20:35,810
الرّيح الّتي تعصف
...إلى الأسفل من الجبل

375
00:20:36,810 --> 00:20:38,180
!استعدّي للإبحار

376
00:20:40,180 --> 00:20:43,880
!لِمَ تقفين هناك ساكنة؟
!أزيحي الألواح السّاندة

377
00:20:43,880 --> 00:20:44,920
!هيّا بنا

378
00:20:49,220 --> 00:20:51,660
!...أنزل أسلحتك وإلاّ

379
00:20:53,730 --> 00:20:54,390
!أوسوبّ

380
00:20:54,390 --> 00:20:54,830
!سحقًا

381
00:20:55,190 --> 00:20:56,830
!رفاق! أسرعوا واذهبوا من هنا

382
00:20:56,830 --> 00:20:59,800
إنّهم ينوون الإجهاز
!علينا كلّنا، واحدًا تلو الآخر

383
00:20:59,800 --> 00:21:01,570
!أطبق فمك

384
00:21:01,870 --> 00:21:03,400
!تبّا لكم أيّها الجبناء

385
00:21:03,870 --> 00:21:07,470
ما عدنا بحاجة حتّى لانتظار النّقيب
.ليرسو، انتهى كلّ شيء الآن

386
00:21:07,470 --> 00:21:08,040
!أيّها العريف

387
00:21:10,380 --> 00:21:12,040
...حقًّا

388
00:21:12,040 --> 00:21:13,240
!جبناء

389
00:21:13,240 --> 00:21:15,010
.يمكنني التّعامل مع الرّصاص

390
00:21:15,010 --> 00:21:17,050
!لكنّنا لا نستطيع

391
00:21:19,080 --> 00:21:23,290
سآخذ كنز زيني مع رؤوسكم
!يا قراصنة قبّعة القشّ

392
00:21:23,290 --> 00:21:24,460
!لتذهبوا للجحيم

393
00:21:32,100 --> 00:21:33,770
!لنبحر

394
00:21:36,840 --> 00:21:40,340
مـ-مستحيل! سفينة قراصنة
!نازلة من الجبل؟

395
00:21:40,340 --> 00:21:43,410
!هجوم قراصنة زيني

396
00:21:43,850 --> 00:21:45,240
!العجوز

397
00:21:52,720 --> 00:21:55,020
ما رأيكم بحيلتي المربحة؟

398
00:21:55,510 --> 00:22:03,680
آه، خلف السّماء الّتي لا نهاية لها

399
00:22:03,680 --> 00:22:14,300
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

400
00:22:22,170 --> 00:22:29,610
مرّت عليّ أيّام كدت أخسر فيها نفسي

401
00:22:29,610 --> 00:22:38,020
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

402
00:22:38,020 --> 00:22:44,190
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

403
00:22:44,190 --> 00:22:55,070
دفعوا بي للأمام، أليس كذلك؟

404
00:22:55,070 --> 00:23:03,480
آه، إنّ النّجوم تهوي من السّماء

405
00:23:03,480 --> 00:23:06,510
...وهذه اللّحظة الفريدة

406
00:23:11,950 --> 00:23:14,220
!مذهل! يجب أن أمدحه أكثر

407
00:23:14,220 --> 00:23:15,960
!أهذا الوقت المناسب للإعجاب؟

408
00:23:15,960 --> 00:23:16,690
!صحيح

409
00:23:16,690 --> 00:23:19,060
ليس من الصّائب إظهار
!نفسك وهم يبحثون عنك

410
00:23:19,060 --> 00:23:22,060
!جدّي، دعني أعتني بالكنز

411
00:23:22,060 --> 00:23:23,160
...فتاة دنيئة

412
00:23:23,500 --> 00:23:26,170
،إن كان هنالك ما تعتزّ به
!قاتل لحمايته أيّها العجوز

413
00:23:26,600 --> 00:23:28,070
:في الحلقة القادمة من ون بيس

414
00:23:28,070 --> 00:23:31,740
!مكان كنز الجزيرة"
"!هجوم قراصنة زيني

415
00:23:31,740 --> 00:23:33,940
!ملك القراصنة، لن يكون إلاّ أنا