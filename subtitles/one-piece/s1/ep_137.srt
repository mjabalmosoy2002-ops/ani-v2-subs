1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:15,790 --> 00:02:19,800
ما رأيك بهذه الحيل المربحة؟"
"!طموحات زيني الدّائِن

22
00:02:35,950 --> 00:02:38,620
!هيّا، هيّا، ألا يمكنكم أن تبذلوا جهدًا أكبر؟

23
00:02:38,620 --> 00:02:40,520
!لستم تتسكّعون الآن

24
00:02:40,520 --> 00:02:42,420
!ألا يمكنكم أن تعملوا بجدّ أكثر؟

25
00:02:42,990 --> 00:02:45,260
!أيّها العجوز، اجلس هناك بهدوء

26
00:02:45,260 --> 00:02:46,760
!سنتكفّل بهذا

27
00:02:47,160 --> 00:02:49,630
.هيّا يا جدّي، نل بعض الرّاحة

28
00:02:50,790 --> 00:02:52,660
هل تريد أن أدلّك كتفيك؟

29
00:02:54,470 --> 00:02:55,500
مـ-ما هذا؟

30
00:02:55,500 --> 00:02:59,970
إذًا، لمَ تتعمّد بناء هذه السّفينة
في قمّة الجبل أيّها العجوز؟

31
00:02:59,970 --> 00:03:02,570
.لنرَ... ذلك لأنّها ليست سفينة

32
00:03:03,810 --> 00:03:05,110
هذه ليست سفينة؟

33
00:03:05,110 --> 00:03:08,550
اسمع! إلّم تكن هذه سفينةً
!فما هي بالضّبط إذًا؟

34
00:03:09,150 --> 00:03:10,920
...إنّها

35
00:03:11,880 --> 00:03:13,020
.تابوتي

36
00:03:13,350 --> 00:03:14,950
تابوت؟

37
00:03:16,690 --> 00:03:17,560
!نعم

38
00:03:17,890 --> 00:03:19,660
.ستكون قبري

39
00:03:19,920 --> 00:03:22,290
.فهمت. هذا قبرك إذًا يا عجوز الماعز

40
00:03:22,290 --> 00:03:23,990
!لا تدعُ لأجله الآن! ستجلب له النّحس

41
00:03:24,430 --> 00:03:25,800
!ما زال من المبكّر على هذا

42
00:03:25,800 --> 00:03:27,530
!أنت تبالغ في التّحضير

43
00:03:27,830 --> 00:03:32,640
هل يُعقل أنّ الجدّ يعلم
أنّ أجله قريب؟

44
00:03:33,770 --> 00:03:35,510
لِمَ فزعتِ؟

45
00:03:35,810 --> 00:03:37,510
،بعيشي في جزيرة كهذه

46
00:03:37,510 --> 00:03:40,710
ليس من الغريب أن أصنع
قبري، أليس كذلك؟

47
00:03:41,150 --> 00:03:43,850
.سأموت يومًا ما في النّهاية

48
00:03:44,680 --> 00:03:48,120
.ليس "يومًا ما" بل قريبًا جدًّا

49
00:03:48,690 --> 00:03:51,160
ليس من الغريب أن يكون
القبر في قمّة الجبل، صحيح؟

50
00:03:51,420 --> 00:03:53,690
لكن لِمَ تريد أن تجعل
من سفينة قراصنة قبرك؟

51
00:03:57,360 --> 00:03:59,330
!ا-العجوز

52
00:04:00,000 --> 00:04:01,230
!ا-انتظر أيّها الجدّ

53
00:04:01,230 --> 00:04:03,670
،تـ-تابوت أو قـ-قبر، أيّ ما تريد

54
00:04:03,670 --> 00:04:06,240
!نكاد ننتهي منها، لذا لا تعجّل في الرّحيل

55
00:04:06,240 --> 00:04:07,270
!لا تمت بعد

56
00:04:07,270 --> 00:04:11,140
.صه... إنّه نائم

57
00:04:17,310 --> 00:04:20,280
وجدتم قراصنة قبّعة القشّ إذًا؟

58
00:04:20,950 --> 00:04:21,720
!نعم

59
00:04:21,720 --> 00:04:25,760
أعتقد أنّهم رسوا في جزيرة
.مهجورة كما أفدتُ في بلاغي السّابق

60
00:04:27,060 --> 00:04:29,130
!حسنًا، تأهّبوا للهجوم حالاً

61
00:04:29,730 --> 00:04:34,400
،سوف نقتحم الجزيرة بكلّ قوّاتنا
!وسنقبض على قراصنة قبّعة القشّ

62
00:04:34,400 --> 00:04:35,800
!فردًا فردًا

63
00:04:35,800 --> 00:04:37,300
!انتظر أيّها النّقيب

64
00:04:38,400 --> 00:04:41,470
،إضافة إلى مستخدمي قدرات فواكه الشّيطان

65
00:04:41,470 --> 00:04:44,380
.سنواجه السّيّاف الضّليع، رورونوا زورو

66
00:04:46,310 --> 00:04:50,050
وماذا إذًا؟ هل أنت خائف أيّها الرّقيب مينتشي؟

67
00:04:50,050 --> 00:04:51,680
!بالطّبع لا

68
00:04:51,680 --> 00:04:54,520
.أريد تجنّب أيّ خسائر غير ضروريّة فحسب

69
00:04:54,520 --> 00:04:56,150
ماذا تقترح أن نفعل إذًا؟

70
00:04:56,590 --> 00:04:58,860
،إن فعلت ما أقول أيّها النّقيب

71
00:04:58,860 --> 00:05:04,800
فسوف تظفر بنصرٍ ساحق
.ولن نتكبّد إلاّ خسائر قليلة

72
00:05:09,670 --> 00:05:10,130
.حسنًا

73
00:05:11,300 --> 00:05:12,800
هذه حركتك إذًا؟

74
00:05:13,940 --> 00:05:15,010
!لذيذ

75
00:05:15,670 --> 00:05:18,110
كيف أعددت هذا الجبن؟

76
00:05:18,440 --> 00:05:20,110
.من حليب ماعز الجزيرة

77
00:05:20,110 --> 00:05:22,110
.سيمدّك بالكثير من الطّاقة أيّها العجوز

78
00:05:23,310 --> 00:05:26,080
.مع أنّ هذا لن يغيّر في الواقع شيئًا

79
00:05:26,380 --> 00:05:28,090
.حسنًا، إنّه دورك يا جدّي

80
00:05:28,350 --> 00:05:30,090
...لنرَ

81
00:05:30,450 --> 00:05:32,090
.حسنًا، كشّ ملك

82
00:05:33,960 --> 00:05:35,330
!انتظر لحظة

83
00:05:35,330 --> 00:05:37,800
!لا يوجد انتظار يا نامي-تشان

84
00:05:38,400 --> 00:05:39,860
...نلتَ منّي

85
00:05:39,860 --> 00:05:41,770
بالمقابل، هل نلعب ثانيةً؟

86
00:05:41,770 --> 00:05:42,970
.حسنًا

87
00:05:42,970 --> 00:05:48,240
لا شيء يضاهي لعب الشّطرنج مع
!حسناء مثلك بينما تُدلَّك كتفاي

88
00:05:50,940 --> 00:05:52,580
!صيدنا كبير اليوم

89
00:05:53,140 --> 00:05:57,110
سانجي، هلاّ أعددت لعجوز
الماعز أكلاً شهيًّا ثانيةً؟

90
00:05:57,110 --> 00:05:58,450
.أجل، دع الأمر لي

91
00:05:59,150 --> 00:06:02,750
أيّها العجوز، إن كان هناك
،ما تريد أكله أو تريد منّا فعله

92
00:06:02,750 --> 00:06:06,820
لا تخجل في السّؤال، اتّفقنا؟
!سنبذل كلّ ما في وسعنا

93
00:06:06,820 --> 00:06:09,730
.كلاّ، يمكنني أن أموت مبتسمًا الآن

94
00:06:10,730 --> 00:06:13,600
...أنا في النّعيم... النّعيم

95
00:06:13,600 --> 00:06:15,600
!لا تقل هذا

96
00:06:15,600 --> 00:06:17,070
...حتّى إن كان أجلك قريبًا

97
00:06:17,070 --> 00:06:18,570
!عليك أن تعيش بتفكيرٍ إيجابيّ

98
00:06:18,570 --> 00:06:20,940
!إلى آخر نفس لك

99
00:06:21,670 --> 00:06:23,340
اسمعوا، ألا يبدو هذا غريبًا؟

100
00:06:23,640 --> 00:06:24,410
ماذا؟

101
00:06:24,410 --> 00:06:27,480
يفترض بالعجوز أن يملك
ثلاثة أيّام في حياته، صحيح؟

102
00:06:27,480 --> 00:06:29,480
.صحيح. ثلاثة أيّام

103
00:06:29,480 --> 00:06:31,180
.سيعيش لثلاثة أيّام فقط

104
00:06:31,180 --> 00:06:34,520
سيمرّ ذلك الوقت بسرعة، أليس كذلك؟

105
00:06:35,620 --> 00:06:39,560
.بالفعل. مرّت ثلاثة أيّام بسرعة

106
00:06:41,030 --> 00:06:42,030
.معك حقّ

107
00:06:42,630 --> 00:06:46,700
إذًا، لِمَ لا يزال مفعمًا بالحياة؟

108
00:06:46,700 --> 00:06:49,630
كما أنّه في صحّة أفضل
من السّابق، أليس كذلك؟

109
00:06:50,300 --> 00:06:51,670
.المزيد من الجبن

110
00:06:53,400 --> 00:06:55,140
.أيّها العجوز، إليك دواء اليوم

111
00:06:55,740 --> 00:06:56,970
.احرص على أخذه

112
00:06:56,970 --> 00:07:00,540
لم أعد أحتاجه. إنّه يجعل
.طعم الأكل سيّئًا في النّهاية

113
00:07:01,250 --> 00:07:03,110
!حسنًا، كشّ ملك

114
00:07:04,080 --> 00:07:05,220
!ليس ثانيةً

115
00:07:05,580 --> 00:07:09,050
خلتُ أنّ العجوز لم يتبقّ
.في حياته سوى ثلاثة أيّام

116
00:07:09,720 --> 00:07:13,120
بالنّظر إلى حاله، يبدو وكأنّه
.سيعيش ثلاثين سنة أخرى

117
00:07:13,120 --> 00:07:14,530
هل أخطأت في تشخيصه؟

118
00:07:14,860 --> 00:07:17,060
.كلاّ. ذلك غير ممكن

119
00:07:17,460 --> 00:07:20,500
،مع ذلك، إن أخطأت في تشخيصه
لن يكون ذلك سيّئًا، صحيح؟

120
00:07:20,730 --> 00:07:22,700
!ذلك ليس بيت القصيد

121
00:07:22,700 --> 00:07:26,340
إن كان الأمر هكذا، فسأغادر
.الجزيرة مهما كان رأي الجميع

122
00:07:26,800 --> 00:07:27,710
.أجل

123
00:07:27,710 --> 00:07:31,540
لا يمكننا البقاء هنا
.وتدليل ذلك العجوز إلى الأبد

124
00:07:31,540 --> 00:07:33,310
.أريد الإبحار إلى مغامرات جديدة أيضًا

125
00:07:34,150 --> 00:07:35,410
.قُضي الأمر إذًا

126
00:07:35,680 --> 00:07:37,950
!نامي، سوف نبحر

127
00:07:37,950 --> 00:07:39,880
أ-أيمكنكم أن تنتظروا قليلاً بعد؟

128
00:07:39,880 --> 00:07:43,850
إلى متى ستتسكّعين؟
.كفّي عن لعب الشّطرنج

129
00:07:44,120 --> 00:07:46,360
!لا يمكنني التّوقّف عن اللّعب

130
00:07:46,360 --> 00:07:49,960
خسرتُ مرّات عدّة لدرجة
.أنّني رهنتُ سفينتنا لهذا العجوز

131
00:07:50,690 --> 00:07:52,200
!ماذا؟

132
00:07:52,600 --> 00:07:55,670
ماذا يفترض بالقراصنة
!الّذين فقدوا سفينتهم أن يفعلوا؟

133
00:07:55,670 --> 00:07:58,240
!سأستعيدها حتمًا، انتظروا

134
00:07:58,240 --> 00:07:59,900
.كشّ ملك

135
00:08:00,970 --> 00:08:02,070
!توقّفي

136
00:08:02,070 --> 00:08:03,240
!زلزال

137
00:08:03,770 --> 00:08:06,880
إن واصلت هذا، فلا ندري
!ما قد ترهنيه أيضًا

138
00:08:07,550 --> 00:08:13,780
إن أردتم استرجاع سفينتكم، عليكم
.العمل في هذه الجزيرة بقدر قيمتها

139
00:08:14,650 --> 00:08:18,860
وفقًا لحسابي، سيكون عليكم
.العمل لعشر سنوات في المجموع

140
00:08:19,220 --> 00:08:21,290
ما رأيكم بحيلتي المربحة؟

141
00:08:24,300 --> 00:08:26,300
!نامي

142
00:08:24,300 --> 00:08:26,300
!نامي-سان

143
00:08:26,300 --> 00:08:28,730
،آسفة، ظننتُ أنّه إن حالفني الحظّ

144
00:08:28,730 --> 00:08:32,270
يمكنني أن أجعل العجوز
.يخبرنا عن مكان الكنز

145
00:08:32,600 --> 00:08:35,440
أما زلت تفكّرين في ذلك؟

146
00:08:35,440 --> 00:08:38,610
في هذه المرحلة، خيارنا الوحيد
.هو أن نترك العجوز ونهرب

147
00:08:39,040 --> 00:08:40,080
.لا أريد

148
00:08:40,080 --> 00:08:41,950
ماذا تقول يا لوفي؟

149
00:08:41,950 --> 00:08:44,280
!من الجيّد لنا أنّ زورو أدركَ الأمر

150
00:08:44,280 --> 00:08:48,720
وإلاّ كنّا لنمضي ما بقي من حياتنا
!في هذه الجزيرة نخدم ذلك العجوز

151
00:08:48,720 --> 00:08:50,290
!ألا يمكنك أن تدرك الأمر أيضًا؟

152
00:08:50,290 --> 00:08:53,260
.لا يمكنك خوض أيّ مغامرات هنا يا لوفي

153
00:08:53,260 --> 00:08:54,020
.لنذهب

154
00:08:54,020 --> 00:08:54,530
.لا أريد

155
00:08:54,530 --> 00:08:55,160
!لوفي

156
00:08:55,690 --> 00:08:58,100
الرّهان يشبه الوعد، صحيح؟

157
00:08:58,100 --> 00:09:00,300
.في تلك الحالة، لا أريد نكث أيّ وعد

158
00:09:00,300 --> 00:09:02,370
!لا وقت لدينا للتّفكير في المبادئ

159
00:09:02,700 --> 00:09:04,700
ما رأيك يا زورو؟

160
00:09:04,700 --> 00:09:07,040
القائد هو من يقرّر، صحيح؟

161
00:09:07,040 --> 00:09:07,870
!لوفي

162
00:09:08,270 --> 00:09:09,840
.قلت لا أريد، يعني لا

163
00:09:10,210 --> 00:09:11,210
.كشّ ملك

164
00:09:15,580 --> 00:09:17,110
...هـ-هذا

165
00:09:17,550 --> 00:09:19,350
يمكننا استعادة سفينتنا إذًا؟

166
00:09:22,590 --> 00:09:24,560
ما رأيك أيّها الجدّ؟

167
00:09:26,490 --> 00:09:27,990
...نلتم منّي

168
00:09:27,990 --> 00:09:29,590
!مرحى

169
00:09:29,590 --> 00:09:32,400
!يمكننا الاعتماد عليك دائمًا يا أختي

170
00:09:32,730 --> 00:09:34,400
ما رأيك بهذه الحيلة المربحة؟

171
00:09:34,400 --> 00:09:36,100
.ممتازة، شكرًا

172
00:09:39,240 --> 00:09:44,540
عمّرتُ طويلاً، لكنّي لم أرَ في حياتي قراصنة
.مثيرين للاهتمام مثلكم. أحببتكم حقًّا

173
00:09:44,540 --> 00:09:46,310
!لنحتفل جيّدًا اللّيلة

174
00:09:47,910 --> 00:09:51,020
!أجل، وليمة للاحتفال باستعادتنا لسفينتنا

175
00:10:00,460 --> 00:10:03,290
.تبدو كقرصان عظيم أيّها الجدّ

176
00:10:03,760 --> 00:10:05,130
.تحتمل الشّرب حقًّا

177
00:10:06,760 --> 00:10:09,230
هل تدعينني بقرصان يا نامي-تشان؟

178
00:10:13,300 --> 00:10:15,410
يُمكن اعتبارها كنزًا حقًّا، صحيح؟

179
00:10:16,640 --> 00:10:20,740
نامي، تحاولين جعل العجوز يثمل
ليبوح لك بمكان الكنز، صحيح؟

180
00:10:20,980 --> 00:10:22,510
!لا تفضحني أمامه

181
00:10:22,510 --> 00:10:26,220
يا عجوز الماعز، هل تملك كنزًا حقًّا؟

182
00:10:26,950 --> 00:10:29,620
!أخبرتكم للتّوّ ألاّ تتكلّموا جهرًا

183
00:10:29,620 --> 00:10:32,160
!هناك أشياء تسير بالتّرتيب الصّحيح

184
00:10:32,160 --> 00:10:34,060
...كنزي

185
00:10:36,030 --> 00:10:40,500
هو ما شاركت معه فرحتي وتعاستي
،مذ ألقى بي البحر على هذه الجزيرة

186
00:10:40,500 --> 00:10:42,000
.أي ماعز الجزيرة

187
00:10:43,270 --> 00:10:45,300
!يا لها من قصّة رائعة

188
00:10:45,300 --> 00:10:46,540
!نلت منكم

189
00:10:48,440 --> 00:10:51,410
!لا تقل "نلت منكم"، بل أخبرنا بقصدك

190
00:10:51,410 --> 00:10:53,040
.حسنًا، سأخبركم

191
00:10:53,040 --> 00:10:57,050
بالنّسبة لكلّ القراصنة العظماء
...الّذين جابوا الغراند لاين، أنا

192
00:10:57,050 --> 00:10:57,850
!عرفتها

193
00:10:59,120 --> 00:11:01,690
.الدّائِن الّذي كان يتعامل معهم

194
00:11:01,990 --> 00:11:02,850
دائِن؟

195
00:11:02,850 --> 00:11:06,560
!نعم. أنا زيني الدّائِن، لستُ قرصانًا

196
00:11:06,560 --> 00:11:07,590
لست كذلك؟

197
00:11:07,590 --> 00:11:09,190
هذا مؤسف، صحيح يا نامي؟

198
00:11:09,430 --> 00:11:14,670
لكن مع ذلك، أنت جريء حقًّا لتقرض
المال للقراصنة، أليس كذلك أيّها العجوز؟

199
00:11:14,670 --> 00:11:15,630
لماذا؟

200
00:11:15,900 --> 00:11:17,670
!هذا واضح

201
00:11:17,670 --> 00:11:20,910
أتظنّ أنّ القراصنة يعيدون
المال إن اقترضوه؟

202
00:11:20,910 --> 00:11:22,440
.ما بالك بالفائدة

203
00:11:22,770 --> 00:11:24,210
.معك حقّ

204
00:11:24,210 --> 00:11:27,650
.لقد خدعني الجميع ولم يسدّدوا لي دينهم

205
00:11:27,910 --> 00:11:31,120
،نكث كلّ واحد من أولئك اللّعناء وعده

206
00:11:31,120 --> 00:11:33,620
.وكانت الخيانة من أبرز شيمهم

207
00:11:33,950 --> 00:11:37,350
إذًا أيّها الجدّ، أصحيحٌ أنّك تكره القراصنة؟

208
00:11:37,660 --> 00:11:41,790
،لو أنّني رضيتُ بما فعلوه لي
.لضُرب بعملي وربحي عرض الحائط

209
00:11:45,630 --> 00:11:50,330
لقد اضطررتُ لقتال القراصنة
،كلّما ذهبتُ لأخذ ديني

210
00:11:50,940 --> 00:11:52,570
.مخاطرًا بحياتي

211
00:11:57,110 --> 00:12:00,950
إنّه عملٌ يتطلّب منك أن تكون
أقوى من القراصنة، أليس كذلك؟

212
00:12:01,310 --> 00:12:03,510
هل كنتَ بتلك القوّة يا عجوز الماعز؟

213
00:12:03,510 --> 00:12:05,920
.لا أريد أن أتفاخر، لقد كنتُ ضعيفًا

214
00:12:05,920 --> 00:12:08,350
.لكنّي كنتُ أملك حلمًا

215
00:12:08,850 --> 00:12:09,790
حلم؟

216
00:12:13,690 --> 00:12:14,930
أنت أيّها الجدّ؟

217
00:12:33,440 --> 00:12:34,410
ماذا؟

218
00:12:34,910 --> 00:12:37,180
نعيد الدّين؟

219
00:12:37,550 --> 00:12:40,550
!أنا الرّجل الّذي يُلقّب بالّدائِن زيني

220
00:12:40,550 --> 00:12:44,520
أفضّل أن أبعثكم للجحيم
.على أن أدعكم تهربون بمالي

221
00:12:44,520 --> 00:12:46,290
هل نذهب إلى الآخرة معًا؟

222
00:12:46,290 --> 00:12:47,960
!انتظر يا زيني

223
00:12:48,490 --> 00:12:49,190
!خذ

224
00:12:49,190 --> 00:12:52,000
.ما رأيكم بحيلتي المبرحة؟ وداعًا

225
00:12:52,000 --> 00:12:54,370
!لن تفعل! عليك أن تعطي القراصنة حقّهم

226
00:12:54,700 --> 00:12:56,470
.سأفعل

227
00:13:02,710 --> 00:13:05,380
!زيني! كيف تجرؤ؟

228
00:13:06,110 --> 00:13:07,710
!أشكركم

229
00:13:08,810 --> 00:13:12,320
،ربّما كنتُ ضعيفًا، لكن كان لديّ حلم
.لذا قاتلتُ باستماتة لأجله

230
00:13:12,320 --> 00:13:14,080
.لا، تمكّنتُ من القتال لأجله

231
00:13:14,350 --> 00:13:16,020
ما كان حلمك أيّها العجوز؟

232
00:13:16,020 --> 00:13:19,120
.مذ كنتُ طفلاً وأنا أريد أن أصبح قرصانًا

233
00:13:19,120 --> 00:13:22,430
.قرصان حقيقيّ. ملك القراصنة

234
00:13:22,430 --> 00:13:25,160
.لهذا بدأتُ أوّلاً في مجال الإقراض

235
00:13:26,660 --> 00:13:30,770
لكنّي هوجمت على حين غرّة من قبل
قراصنة لعناء صبّوا جامّ غضبهم عليّ

236
00:13:30,770 --> 00:13:34,510
،ليُلقيني البحر إلى هذه الجزيرة
.ساكنًا فيها ما بقي من حياتي

237
00:13:34,510 --> 00:13:37,140
كان ذلك قبل عشرين سنة، أليس كذلك؟

238
00:13:37,140 --> 00:13:40,480
هل كنت تصنع ذلك القبر
منذ عشرين سنة؟

239
00:13:40,480 --> 00:13:44,150
في البداية، نويتُ بناء السّفينة
،بالقرب من البحر

240
00:13:44,150 --> 00:13:47,550
.لكنّي لم أقوَ على إنزال الخشب من الجبل

241
00:13:47,550 --> 00:13:52,190
،لذا قرّرتُ ألاّ أستسلم مهما كان
.بيد أنّي بنيتها في الجبل

242
00:13:52,190 --> 00:13:55,190
كان لي حلمٌ عظيم لم أستطع
.حسابه بمِعدادي

243
00:13:55,190 --> 00:13:56,790
!مغامرة عظيمة

244
00:13:56,790 --> 00:13:59,430
.لكن في مرحلةٍ ما، أفقتُ على الحقيقة

245
00:14:00,000 --> 00:14:06,740
قبل أن أدرك، كنتُ قد كبرتُ
.على الإبحار في الغراند لاين

246
00:14:07,270 --> 00:14:09,570
.وا حسرتي على حلمي لأصبح قرصانًا

247
00:14:11,310 --> 00:14:13,410
.ما الأحلام إلاّ أحلام في النّهاية

248
00:14:17,010 --> 00:14:19,820
لماذا استسلمت يا عجوز الماعز؟

249
00:14:21,150 --> 00:14:22,920
.لا علاقة للعمر بالأمر

250
00:14:22,920 --> 00:14:25,660
،إن أردتَ أن تصبح قرصانًا
.فعليك أن تفعل فحسب

251
00:14:27,360 --> 00:14:28,760
!اسمع يا لوفي

252
00:14:28,760 --> 00:14:31,460
ماذا سنفعل إن أخذ
العجوز كلامك محمل الجدّ؟

253
00:14:31,460 --> 00:14:33,500
.القراصنة يحتاجون سفينةً

254
00:14:32,060 --> 00:14:33,330
.أريد المزيد يا سانجي

255
00:14:33,330 --> 00:14:34,170
!تفضّل

256
00:14:33,500 --> 00:14:36,700
وسفينة العجوز عبارة
.عن تابوت في قمّة الجبل

257
00:14:34,170 --> 00:14:35,370
.شكرًا لك

258
00:14:36,700 --> 00:14:38,770
.علينا أن ننزلها فحسب إذًا

259
00:14:38,770 --> 00:14:40,400
!لا تقل ذلك وكأنّه سهل

260
00:14:41,010 --> 00:14:43,370
...صحيح... ما زال هنالك وقت

261
00:14:43,370 --> 00:14:45,840
.أرأيت؟ أخذ كلامك محمل الجدّ

262
00:14:45,840 --> 00:14:49,850
كلاّ، لم يفعل. أنت ثمل
فحسب، أليس كذلك يا جدّي؟

263
00:14:49,850 --> 00:14:51,850
!نعم، أنا ثمل، ثمل

264
00:14:53,480 --> 00:14:54,250
حقًّا؟

265
00:14:54,250 --> 00:14:58,220
!جعلني الشّابّ ذو قبّعة القشّ أسكر تمامًا

266
00:15:03,360 --> 00:15:04,730
!أجل

267
00:15:07,430 --> 00:15:09,100
أيمكننا هذا حقًّا؟

268
00:15:09,100 --> 00:15:12,470
نستدرج قراصنة قبّعة
القشّ من الجزيرة بأنفسنا؟

269
00:15:12,470 --> 00:15:14,570
،مهما كانوا أقوياء

270
00:15:14,570 --> 00:15:16,540
.فما زالوا أطفالاً أغرار

271
00:15:16,970 --> 00:15:20,340
،إن سرنا حسب خطّتنا
.ليس هنالك ما يخيفنا منهم

272
00:15:20,340 --> 00:15:22,710
.ليس وكأنّنا سنقاتلهم

273
00:15:22,710 --> 00:15:24,280
.سترى على أيّ حال

274
00:15:24,280 --> 00:15:27,220
هل سيتمكّن النّقيب
من قراصنة قبّعة القشّ؟

275
00:15:27,220 --> 00:15:30,020
.ذلك لا يخصّني

276
00:15:30,020 --> 00:15:32,360
بينما يذهب كبار الشّأن
،للقتال لأجل العدالة

277
00:15:32,360 --> 00:15:34,430
.سنستولي نحن على الكنز

278
00:15:34,860 --> 00:15:37,390
.أيّها العريف، سيكون لك دور في هذا أيضًا

279
00:15:37,390 --> 00:15:39,460
.وسأكافئك على خدمتك بسخاء

280
00:15:39,460 --> 00:15:40,360
.حـ-حاضر

281
00:15:51,380 --> 00:15:54,010
لا علاقة للعمر بالأمر إذًا؟

282
00:15:54,810 --> 00:15:58,480
أخذ على عاتقه قول شيء
.يجعل عجوزًا مثلي يحلم

283
00:15:59,150 --> 00:16:02,020
.ذلك الشّابّ ذو قبّعة القشّ خسيس بحقّ

284
00:16:03,650 --> 00:16:04,720
.معك حقّ

285
00:16:05,620 --> 00:16:06,590
روبين-تشان؟

286
00:16:07,260 --> 00:16:11,730
كما أنّ قائدنا يُنقذ النّاس الّذين يريدون
.الموت دون إذنهم ويدعهم يعيشون

287
00:16:13,000 --> 00:16:14,800
هل أنت مسرورة لأنّه تركك تعيشين؟

288
00:16:14,800 --> 00:16:17,770
.بالفعل... لستُ واثقة جدًّا من ذلك بعد

289
00:16:17,770 --> 00:16:19,770
.لستِ نادمة لأنّه فعل

290
00:16:21,070 --> 00:16:25,740
.أرى ذلك باديًا على وجهك
.حياتك بدأت للتّوّ يا روبين-تشان

291
00:16:27,780 --> 00:16:32,550
لكن بالّنسبة لي... سيرقد
.حلمي هنا أبد الدّهر

292
00:16:42,030 --> 00:16:42,960
!ما الخطب؟

293
00:16:43,260 --> 00:16:45,500
!مصيبة! استيقظوا جميعًا

294
00:16:47,970 --> 00:16:50,330
نمتُ جيّدًا حقًّا. أحان وقت الإفطار؟

295
00:16:50,330 --> 00:16:52,400
!البحريّة! أتت البحريّة

296
00:16:52,400 --> 00:16:53,740
!ماذا؟

297
00:16:59,380 --> 00:17:00,710
سفينة واحدة فقط؟

298
00:17:00,710 --> 00:17:02,580
.لا يبدو أنّهم على وشك الهجوم أيضًا

299
00:17:03,480 --> 00:17:04,850
ما الّذي يجري هنا بالضّبط؟

300
00:17:05,180 --> 00:17:07,180
!مرحبًا يا قراصنة قبّعة القشّ

301
00:17:07,180 --> 00:17:10,150
.أنا رقيب البحريّة مينتشي، مسور للقائكم

302
00:17:10,450 --> 00:17:11,560
مسرور؟

303
00:17:11,560 --> 00:17:14,230
.اسمعوا، أنا آسف حقًّا لما حدث ذلك اليوم

304
00:17:14,790 --> 00:17:19,230
،لو أنّنا عرفنا من تكونون حقًّا
.لما واصلنا ملاحقتكم كما فعلنا

305
00:17:19,230 --> 00:17:20,700
.آمل أن تقبلوا اعتذارنا

306
00:17:20,970 --> 00:17:25,600
أوليس ما تقوله غريبًا؟ من الطّبيعيّ
.أن تلاحق البحريّة القراصنة

307
00:17:25,600 --> 00:17:29,140
.إنّه يتصرّف بكرمٍ مشبوه
.ابقوا متيقّظين

308
00:17:30,140 --> 00:17:32,480
!لا تنزعجوا أرجوكم

309
00:17:32,480 --> 00:17:36,780
أعي أنّكم من هزم كروكودايل
في ألاباستا، أليس كذلك؟

310
00:17:36,780 --> 00:17:39,850
!ما كنتُ لأجرؤ على قتال قراصنة أقوياء مثلكم

311
00:17:39,850 --> 00:17:41,450
.صدّقوني

312
00:17:41,450 --> 00:17:45,690
،أقصد أنّنا إن كنّا سنهاجمكم
هل كنّا لنأتي إلى هنا بسفينة واحدة؟

313
00:17:45,960 --> 00:17:49,860
ما هذا؟ إنّه خائف منّا، أليس كذلك؟

314
00:17:51,030 --> 00:17:53,530
،حتّى إن افترضنا أنّنا خاطرنا بحياتنا لقتالكم

315
00:17:53,530 --> 00:17:55,700
.ما كنّا لندرّ من ذلك أيّ ربح

316
00:17:56,000 --> 00:17:57,540
ما الّذي تفعلونه هنا إذًا؟

317
00:17:57,870 --> 00:18:00,670
.أتينا إلى هنا للتّحرّي عن الجزيرة فقط

318
00:18:00,670 --> 00:18:03,670
إنّها جزيرة حديثة الاكتشاف
.وغير موجودة على خرائطنا

319
00:18:03,670 --> 00:18:06,880
تتحرّون؟ لا يوجد في هذه
.الجزيرة سوى عجوز وماعزه

320
00:18:07,280 --> 00:18:09,750
على ذكره، أين ذهب العجوز؟

321
00:18:10,280 --> 00:18:13,720
فهمت. إذًا فزيني آمن
هنا ويتلقّى الرّعاية، صحيح؟

322
00:18:14,150 --> 00:18:15,150
زيني؟

323
00:18:15,520 --> 00:18:18,990
،فور أن ننتهي من دوريّتنا
.سنعود إلى قاعدتنا

324
00:18:19,320 --> 00:18:22,360
من الأفضل أن تبحروا من هنا
.بأسرع ما يمكن

325
00:18:22,360 --> 00:18:23,460
.لن ألومكم

326
00:18:23,830 --> 00:18:28,300
فمقرّات البحريّة متعطّشة
.للتخلّص منكم قبل كلّ شيء

327
00:18:28,300 --> 00:18:31,740
.فهمت. يبدو أنّ هذه فرصتنا أيضًا

328
00:18:31,740 --> 00:18:35,270
.سأذهب لإحضار الطّعام
.يجب أن أنادي على روبين لتنزل أيضًا

329
00:18:43,750 --> 00:18:44,850
...إنّه

330
00:18:45,680 --> 00:18:48,190
!فخّ! إنّه فخّ من البحريّة

331
00:18:50,790 --> 00:18:52,520
هل نبحر يا لوفي؟

332
00:18:53,790 --> 00:18:56,260
.ثمّة طقس جميل خلف الضّباب

333
00:18:56,260 --> 00:18:59,600
.والأمواج هادئة، ولن نمسّكم بسوء بأيّ شكل

334
00:18:59,600 --> 00:19:00,870
.هيّا، بادروا

335
00:19:01,200 --> 00:19:03,100
!أذهب عندما يحلو لي

336
00:19:03,100 --> 00:19:04,340
!لست أنت من يقرّر

337
00:19:05,540 --> 00:19:06,800
،إن كنتُ مكان البحريّة

338
00:19:06,800 --> 00:19:09,910
،كنتُ لأقاتلنا باستماتة
!وإن كنت أملك سفينةً واحدة

339
00:19:09,910 --> 00:19:12,180
!كما أنّ هنالك شيءٌ آخر مريب

340
00:19:12,180 --> 00:19:15,680
كيف عرفت أنّ اسم الجدّ زيني؟

341
00:19:15,680 --> 00:19:17,520
.لم نذكره قطّ

342
00:19:18,050 --> 00:19:19,280
...فـ-في الواقع

343
00:19:19,650 --> 00:19:23,590
.أشكّ في نوع الفحص الّذي تنوون إجراءه

344
00:19:23,590 --> 00:19:25,620
لا تقل أنّك تسعى خلف كنز الجدّ؟

345
00:19:27,120 --> 00:19:30,690
!هكذا الأمر إذًا! لا أثق بهذا الشّخص

346
00:19:31,630 --> 00:19:33,400
اكتشفوا الأمر إذًا؟

347
00:19:33,400 --> 00:19:38,470
اكتشفوا جبل الكنوز الّتي جمعها زيني
الدّائِن ممّا تركه القراصنة رهنًا عنده؟

348
00:19:39,370 --> 00:19:41,940
!عرفتها! يملك الجدّ كنزًا بالفعل

349
00:19:43,440 --> 00:19:44,780
.أشتمّ رائحة البارود

350
00:19:45,080 --> 00:19:46,940
أهي مدافع ذلك الوغد؟

351
00:19:46,940 --> 00:19:48,410
.ليست مدافع سفينة واحدة

352
00:19:48,980 --> 00:19:51,020
.الرّائحة صادرة من مدافع لا أستطيع إحصاءها

353
00:19:51,020 --> 00:19:52,520
!ما ذلك الشّيء هناك؟

354
00:19:52,520 --> 00:19:57,290
لو أنّنا أبحرنا، لكنّا هوجمنا
!بغتةً من قبل ذلك الأسطول

355
00:19:57,290 --> 00:19:58,960
!إنّهم يعبثون معنا

356
00:19:58,960 --> 00:20:01,360
،لا أهتمّ إن كانوا أسطولاً
!أقبلوا علينا

357
00:20:01,360 --> 00:20:02,630
!ا-انتظر

358
00:20:03,960 --> 00:20:05,300
!لـ-لوفي

359
00:20:05,300 --> 00:20:06,260
!أوسوبّ

360
00:20:06,560 --> 00:20:08,170
!رفاق

361
00:20:08,170 --> 00:20:11,740
!لا تحرّكوا ساكنًا! حركة واحدة وسأقتله

362
00:20:12,670 --> 00:20:15,510
سبق ونزل رجالهم واختبؤوا هناك؟

363
00:20:15,770 --> 00:20:17,710
!أحسنت أيّها العريف

364
00:20:19,310 --> 00:20:21,650
!أسرعي وأخبريهم

365
00:20:21,650 --> 00:20:23,680
مهلاً، لن تصل في الوقت
.حتّى إن غادرت الآن

366
00:20:24,080 --> 00:20:25,920
لكن ماذا يمكننا فعله؟

367
00:20:25,920 --> 00:20:28,590
على هذا الحال، شابّ قبّعة
...القشّ والبقيّة سوف

368
00:20:29,220 --> 00:20:30,990
.هذه فوضى

369
00:20:31,760 --> 00:20:33,720
ما العمل؟

370
00:20:33,720 --> 00:20:36,590
.أيّها الجدّ، أنت قرصان، صحيح؟ افعل شيئًا

371
00:20:36,590 --> 00:20:41,400
،هذا جنون! قد أكون قرصانًا
.لكنّ هذه السّفينة تابوتي

372
00:20:41,400 --> 00:20:44,370
...إنّها في قمّة الجبل ومهما فعلت

373
00:20:44,970 --> 00:20:47,340
.علينا أن ننزلها فحسب إذًا

374
00:20:48,040 --> 00:20:49,810
الرّيح الّتي تعصف
...إلى الأسفل من الجبل

375
00:20:50,810 --> 00:20:52,180
!استعدّي للإبحار

376
00:20:54,180 --> 00:20:57,880
!لِمَ تقفين هناك ساكنة؟
!أزيحي الألواح السّاندة

377
00:20:57,880 --> 00:20:58,920
!هيّا بنا

378
00:21:03,220 --> 00:21:05,660
!...أنزل أسلحتك وإلاّ

379
00:21:07,730 --> 00:21:08,390
!أوسوبّ

380
00:21:08,390 --> 00:21:08,830
!سحقًا

381
00:21:09,190 --> 00:21:10,830
!رفاق! أسرعوا واذهبوا من هنا

382
00:21:10,830 --> 00:21:13,800
إنّهم ينوون الإجهاز
!علينا كلّنا، واحدًا تلو الآخر

383
00:21:13,800 --> 00:21:15,570
!أطبق فمك

384
00:21:15,870 --> 00:21:17,400
!تبّا لكم أيّها الجبناء

385
00:21:17,870 --> 00:21:21,470
ما عدنا بحاجة حتّى لانتظار النّقيب
.ليرسو، انتهى كلّ شيء الآن

386
00:21:21,470 --> 00:21:22,040
!أيّها العريف

387
00:21:24,380 --> 00:21:26,040
...حقًّا

388
00:21:26,040 --> 00:21:27,240
!جبناء

389
00:21:27,240 --> 00:21:29,010
.يمكنني التّعامل مع الرّصاص

390
00:21:29,010 --> 00:21:31,050
!لكنّنا لا نستطيع

391
00:21:33,080 --> 00:21:37,290
سآخذ كنز زيني مع رؤوسكم
!يا قراصنة قبّعة القشّ

392
00:21:37,290 --> 00:21:38,460
!لتذهبوا للجحيم

393
00:21:46,100 --> 00:21:47,770
!لنبحر

394
00:21:50,840 --> 00:21:54,340
مـ-مستحيل! سفينة قراصنة
!نازلة من الجبل؟

395
00:21:54,340 --> 00:21:57,410
!هجوم قراصنة زيني

396
00:21:57,850 --> 00:21:59,240
!العجوز

397
00:22:06,720 --> 00:22:09,020
ما رأيكم بحيلتي المربحة؟

398
00:22:09,510 --> 00:22:17,680
آه، خلف السّماء الّتي لا نهاية لها

399
00:22:17,680 --> 00:22:28,300
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

400
00:22:36,170 --> 00:22:43,610
مرّت عليّ أيّام كدت أخسر فيها نفسي

401
00:22:43,610 --> 00:22:52,020
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

402
00:22:52,020 --> 00:22:58,190
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

403
00:22:58,190 --> 00:23:09,070
دفعوا بي للأمام، أليس كذلك؟

404
00:23:09,070 --> 00:23:17,480
آه، إنّ النّجوم تهوي من السّماء

405
00:23:17,480 --> 00:23:20,510
...وهذه اللّحظة الفريدة

406
00:23:25,950 --> 00:23:28,220
!مذهل! يجب أن أمدحه أكثر

407
00:23:28,220 --> 00:23:29,960
!أهذا الوقت المناسب للإعجاب؟

408
00:23:29,960 --> 00:23:30,690
!صحيح

409
00:23:30,690 --> 00:23:33,060
ليس من الصّائب إظهار
!نفسك وهم يبحثون عنك

410
00:23:33,060 --> 00:23:36,060
!جدّي، دعني أعتني بالكنز

411
00:23:36,060 --> 00:23:37,160
...فتاة دنيئة

412
00:23:37,500 --> 00:23:40,170
،إن كان هنالك ما تعتزّ به
!قاتل لحمايته أيّها العجوز

413
00:23:40,600 --> 00:23:42,070
:في الحلقة القادمة من ون بيس

414
00:23:42,070 --> 00:23:45,740
!مكان كنز الجزيرة"
"!هجوم قراصنة زيني

415
00:23:45,740 --> 00:23:47,940
!ملك القراصنة، لن يكون إلاّ أنا