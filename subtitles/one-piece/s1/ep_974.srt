1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,420 --> 00:02:01,150
!ستكون لحظة كبيرة من أجلك

29
00:02:01,150 --> 00:02:03,440
!سأشاهدها حتّى النّهاية

30
00:02:07,930 --> 00:02:10,080
!سأمنحك ساعة من الزّمن

31
00:02:16,780 --> 00:02:18,600
!اللّعنة عليك

32
00:02:27,200 --> 00:02:28,890
!من وصفتَ بالسّيّد السّخيف؟

33
00:02:29,160 --> 00:02:31,060
!أيّها القائد، إنّها شينوبو

34
00:02:31,060 --> 00:02:36,370
!إنّ أودن-ساما كان يحمي هذه البلاد طوال الوقت

35
00:02:36,920 --> 00:02:39,190
!والآن، من هو السّيّد السّخيف؟

36
00:02:39,190 --> 00:02:41,330
!أجيبوني

37
00:02:43,970 --> 00:02:47,280
ما كان الأودن ليُسمّى أودن"
".إن لم يكن يغلي

38
00:03:21,940 --> 00:03:24,900
!كان أودن-ساما يحمينا؟

39
00:03:24,900 --> 00:03:26,740
...حتّى إن أخبرتنا الآن

40
00:03:27,030 --> 00:03:29,030
!يصعب تقبّل ذلك

41
00:03:32,180 --> 00:03:34,660
!لم يفت الأوان بعد

42
00:03:34,980 --> 00:03:38,500
!عليكم معرفة حقيقة أودن-ساما

43
00:03:45,570 --> 00:03:46,880
!يكفي يا شينوبو

44
00:03:50,030 --> 00:03:51,780
!فوكوروكوجو

45
00:03:53,120 --> 00:03:56,350
!ستخلق الحقيقة الفوضى لا غير

46
00:03:56,960 --> 00:03:58,620
!اتركني

47
00:03:58,960 --> 00:04:03,900
".مات السّيّد السّخيف الّذي ثار على الشّوغن"
،هذا ما سيعتقده النّاس

48
00:04:04,170 --> 00:04:07,590
!وسينتهي الإعدام قريبًا

49
00:04:08,220 --> 00:04:11,450
.هذا هو الغرض من هذا الإعدام

50
00:04:11,450 --> 00:04:13,320
كيف لك أن تتدخّلي؟

51
00:04:13,320 --> 00:04:16,540
!تعرفين العواقب، صحيح؟

52
00:04:16,770 --> 00:04:20,160
!أنا أتشارك نفس مصيرهم سلفًا

53
00:04:20,440 --> 00:04:22,830
!أنا تابعة أودن-ساما

54
00:04:22,830 --> 00:04:27,050
!لقد صرتم كلابَ أوروتشي، لذلك لن أطيعكم

55
00:04:27,050 --> 00:04:32,010
،إن حصل أيّ شيء لأودن-ساما والبقيّة
!فسأموت معهم

56
00:04:33,580 --> 00:04:38,060
!كلاّ! سننجو جميعًا وسنطيح بكم

57
00:04:41,000 --> 00:04:42,100
!أنت واهم

58
00:04:43,130 --> 00:04:44,610
!أ-أيّها الشّوغن أوروتشي

59
00:04:45,010 --> 00:04:47,610
!أوقف الإعدام رجاءً

60
00:04:51,200 --> 00:04:52,990
!أتوسّل إليك

61
00:04:55,640 --> 00:04:57,140
!رجاءً

62
00:04:57,140 --> 00:04:59,010
!أنا أتوسّل إليك

63
00:05:09,570 --> 00:05:11,380
!إ-إنّهم بحاجة لعناية طبّيّة

64
00:05:20,040 --> 00:05:20,930
!أوروتشي

65
00:05:23,250 --> 00:05:24,980
!حثالة أغبياء

66
00:05:25,420 --> 00:05:27,570
،ليست عائلة الشّوغن فحسب

67
00:05:27,570 --> 00:05:32,570
.لكنّ كافّة عامّة النّاس اضطهدوا عشيرة كوروزومي

68
00:05:32,570 --> 00:05:40,200
أدرك النّاس في الحال مدى بٌغض
.سليلها المنتقم أوروتشي

69
00:05:42,690 --> 00:05:44,460
،في تلك الأثناء

70
00:05:44,460 --> 00:05:50,210
كان السّبب وراء رقص أودن الغريب
،وهو عارٍ لخمس سنوات

71
00:05:50,210 --> 00:05:53,740
.قد شاع بين النّاس في لمح البصر

72
00:05:53,740 --> 00:05:54,720
!ماذا؟

73
00:05:55,290 --> 00:05:59,160
...أي أنّ الشّخص الّذي أنقذني يومها كان

74
00:06:00,640 --> 00:06:04,890
!ومع ذلك سخرنا منه بشدّة

75
00:06:04,890 --> 00:06:08,760
!رغم أنّه كان يتحمّل أكثر من أيّ أحد فينا

76
00:06:08,760 --> 00:06:12,110
!سُحقًا! يا لنا من حمقى

77
00:06:13,890 --> 00:06:17,780
.اندفع الجميع نحو أودن

78
00:06:17,780 --> 00:06:22,750
أدركوا أخيرًا أنّ الإعدام المُطوّل
...الّذي كانوا يشهدوه

79
00:06:22,750 --> 00:06:27,790
في حقّ هذا الرّجل الّذي كان يواجه
...الموت أمام أعينهم

80
00:06:28,040 --> 00:06:32,340
!كان الأمل الوحيد لبلاد وانو

81
00:06:34,570 --> 00:06:36,800
!أودن-ساما، عليك أن تنجو

82
00:06:36,800 --> 00:06:39,760
!آسفة لأنّني لعنتك وأنا جاهلة لكلّ هذا

83
00:06:39,760 --> 00:06:42,470
!شكرًا لك على حمايتنا

84
00:06:48,550 --> 00:06:50,380
!فات الأوان

85
00:06:50,380 --> 00:06:52,530
!يا لهم من أشخاص ذليلين

86
00:06:53,340 --> 00:06:54,690
...أودن-ساما، لا تهتمّ

87
00:06:54,690 --> 00:06:58,450
!شكرًا لكم! سأبذل جهدي

88
00:06:59,060 --> 00:07:00,700
!يا لاستقامته

89
00:07:02,850 --> 00:07:10,080
ولكن، ما كان أوروتشي ليسمح
،بأن يستمرّ حماس النّاس هذا

90
00:07:10,420 --> 00:07:19,090
وقبل أن يدركوا، كانوا محاصرين
.برجال كايدو وأوروتشي المسلّحين

91
00:07:21,540 --> 00:07:27,620
تجاوزت حرارة الزّين 700 درجة
.مئويّة وواصلت الارتفاع

92
00:07:31,630 --> 00:07:34,280
!لن أسلّم

93
00:07:41,220 --> 00:07:45,580
حملت سهام رسائل إلى قلاع
.كلّ منطقة لنشر الحادثة للعلن

94
00:07:51,860 --> 00:07:56,860
بإمكان سهام الرّسائل في بلاد وانو
...السّفر لمسافات بعيدة

95
00:07:57,780 --> 00:07:59,480
!أودن-ساما

96
00:08:01,290 --> 00:08:03,530
!أودن-ساما

97
00:08:14,050 --> 00:08:15,400
!أيّها الرّفاق

98
00:08:16,720 --> 00:08:18,530
ما الأمر يا أودن-ساما؟

99
00:08:19,300 --> 00:08:23,920
...إن تمكّنتُ من النّجاة من هذا الغليان

100
00:08:24,230 --> 00:08:26,180
...فأنا

101
00:08:26,350 --> 00:08:30,000
!أريد فتح هذه البلاد

102
00:08:33,190 --> 00:08:36,050
...إنّهم يتحدّثون عن أمر ما

103
00:08:36,340 --> 00:08:40,590
...كنّا نتحدّث عن فتحها من قبل

104
00:08:40,590 --> 00:08:46,100
.قلتَ أنّ الانعزال مرتبط بشدّة بكوزكي

105
00:08:46,500 --> 00:08:52,620
ما الّذي عثرت عليه في البحر
!خلال ارتحالك مع روجر والبقيّة؟

106
00:08:54,670 --> 00:09:00,440
إنّ المسؤولين عن عزل هذه البلاد
...عن بقيّة العالم منذ مدّة طويلة

107
00:09:00,440 --> 00:09:02,960
!هي عشيرة كوزكي

108
00:09:04,850 --> 00:09:10,810
!وذلك من أجل حماية بلاد وانو من قوّة هائلة

109
00:09:10,810 --> 00:09:13,120
...إنّ بلاد وانو

110
00:09:13,120 --> 00:09:15,380
...بل العالم

111
00:09:15,380 --> 00:09:18,500
!ينتظر شخصًا معيّنًا

112
00:09:19,880 --> 00:09:25,470
،عندما يظهر ذلك الشّخص بعد 800 سنة

113
00:09:25,470 --> 00:09:30,770
!على هذه البلاد أن تكون مرحّبة ومتعاونة

114
00:09:33,670 --> 00:09:35,190
!دعوني أوضّح كلامي

115
00:09:41,180 --> 00:09:43,920
...سيتمكّنون هذا اليوم

116
00:09:44,560 --> 00:09:47,800
!من قتلي بكلّ تأكيد

117
00:09:50,060 --> 00:09:51,410
!مستحيل

118
00:09:51,410 --> 00:09:54,330
!...لكن إن استطعت النّجاة فعلاً من الغليان

119
00:09:55,110 --> 00:09:57,460
!مرّت ثلث المدّة بالفعل

120
00:09:57,780 --> 00:10:01,630
!كيكونوجو! لنستمع لما لدى أودن-ساما ليقوله

121
00:10:05,030 --> 00:10:07,950
...نيابة عنّي

122
00:10:08,580 --> 00:10:12,390
!افتحوا بلاد وانو

123
00:10:23,300 --> 00:10:25,570
...بإمكاننا القيام بذلك معك

124
00:10:26,970 --> 00:10:30,870
!حلمك هو حلمنا نحن

125
00:10:33,690 --> 00:10:36,330
!أحسنت القول

126
00:10:43,160 --> 00:10:45,340
!بقيت ثلاثون دقيقة

127
00:10:50,080 --> 00:10:54,640
.الأمر أشبه بالجحيم حيث حتّى الحرارة قاتلة

128
00:10:54,640 --> 00:10:57,520
.إنّ الزّيت المغليّ يطهو أودن

129
00:11:00,630 --> 00:11:02,580
!أ-أنا آسفة

130
00:11:05,220 --> 00:11:07,360
لماذا لم يمت بعد؟

131
00:11:07,360 --> 00:11:10,050
!لماذا ما زال حيًّا؟

132
00:11:13,540 --> 00:11:16,330
!اجعلوا الزّيت يغلي أكثر

133
00:12:13,250 --> 00:12:14,510
!بقيت عشر دقائق

134
00:12:42,860 --> 00:12:47,020
!لا يمكن للحرارة قتله؟

135
00:12:57,920 --> 00:13:02,310
سننطلق في مغامرة عظيمة
!تفوق ما تستطيع تخيّله

136
00:13:02,810 --> 00:13:04,360
!يا أخي الصّغير

137
00:13:18,600 --> 00:13:20,080
!بقيت خمس دقائق

138
00:13:37,330 --> 00:13:38,600
!دقيقة واحدة

139
00:13:48,130 --> 00:13:49,110
!عشر ثوانٍ

140
00:13:58,990 --> 00:14:03,460
!ثمانية! سبعة! ستّة! خمسة! أربعة

141
00:14:15,490 --> 00:14:16,390
!ثلاث ثوانٍ

142
00:14:23,580 --> 00:14:24,640
!ثانية واحدة

143
00:14:33,090 --> 00:14:37,420
!لقد نجح

144
00:14:37,560 --> 00:14:40,020
!إنّها معجزة

145
00:14:40,020 --> 00:14:43,500
!لقد نجى من الإعدام

146
00:14:44,190 --> 00:14:45,580
...إنّ أودن-ساما

147
00:14:45,580 --> 00:14:48,960
!قاوم الغليان

148
00:14:50,190 --> 00:14:51,940
!نجح

149
00:14:52,420 --> 00:14:54,220
!نجح بالفعل

150
00:14:54,220 --> 00:14:55,450
!هذا مبهر

151
00:14:55,450 --> 00:14:58,010
!إنّه انتصار أودن-ساما

152
00:14:58,010 --> 00:15:00,390
!أودن-ساما

153
00:15:03,680 --> 00:15:06,100
!بُرّئ اسم أودن-ساما أيضًا

154
00:15:06,100 --> 00:15:09,980
!والآن، البلاد بأكملها في صفّنا ثانية

155
00:15:14,760 --> 00:15:17,430
!استعدّ يا كايدو

156
00:15:17,430 --> 00:15:19,560
!لا تثر غضبه أيّها القطّ الغبيّ

157
00:15:19,560 --> 00:15:21,950
!ماذا؟! لقد فاز بالفعل

158
00:15:21,950 --> 00:15:24,540
!اخرس! لا تتحدّث بإهمال هكذا

159
00:15:35,990 --> 00:15:38,260
!ما الّذي يحدث؟

160
00:15:38,260 --> 00:15:42,850
وعدتم أن تطلقوا سراحنا جميعًا
!إن نجونا طيلة ساعة

161
00:15:45,080 --> 00:15:50,770
خطرت على بالي فكرة تغيير حُكمه من الغلي
!إلى الرّمي بالسّهام قبل دقيقة

162
00:15:52,090 --> 00:15:55,480
...ولن نقوم بإعدام أودن وحده

163
00:15:55,480 --> 00:15:58,960
!لكنّ سنعدم كلّ أفراد عائلته

164
00:16:02,020 --> 00:16:04,410
!يا له من عذر طفوليّ

165
00:16:04,410 --> 00:16:07,300
...هذا ليس ما وعدت به! إنّ أودن-ساما

166
00:16:13,400 --> 00:16:15,750
!فليُظهر نفسه كلّ ما يعترض على هذا

167
00:16:15,750 --> 00:16:18,730
!سننخر أجسادكم بالرّصاص

168
00:16:29,790 --> 00:16:32,650
!أعتمد عليكم يا رفاق

169
00:16:34,670 --> 00:16:39,960
!افتحوا بلاد وانو

170
00:16:59,410 --> 00:17:03,010
!اركضوا إلى كوري

171
00:17:05,910 --> 00:17:06,850
!شينوبو

172
00:17:12,670 --> 00:17:15,660
!لا تنظروا للوراء

173
00:17:20,510 --> 00:17:22,070
!كوزكي أودن

174
00:17:23,220 --> 00:17:26,950
.كانت فكرة مثيرة للاهتمام

175
00:17:26,950 --> 00:17:28,740
!أودن-ساما

176
00:17:29,040 --> 00:17:31,790
!اقتلوهم جميعًا

177
00:17:36,320 --> 00:17:41,090
!لاحقوهم! اقضوا على اسم كوزكي

178
00:17:55,300 --> 00:17:59,730
...أعرف أنّ جسدك "ميت" سلفًا على أيّ حال

179
00:17:59,730 --> 00:18:03,950
!هذا أقلّ ما يمكنني فعله من أجل... سأطلق عليك

180
00:18:05,890 --> 00:18:09,490
!ستنتهي حقبة كوزكي هنا

181
00:18:09,730 --> 00:18:12,040
!ستموتون جميعًا

182
00:18:14,020 --> 00:18:17,420
!لا تستخفّ بأتباعي السّاموراي

183
00:18:21,320 --> 00:18:22,420
!أودن-ساما

184
00:18:24,450 --> 00:18:25,630
!كفّا عن الأكل أيّها الشّقيّان

185
00:18:26,490 --> 00:18:28,180
!قلتُ لكما توقّفا

186
00:18:28,180 --> 00:18:29,470
!لن أعطيكما المزيد

187
00:18:41,940 --> 00:18:45,610
!مهلاً! أستسلم! أستسلم! أستسلم
!ظننتُ أنّك شخص ميّت

188
00:18:56,980 --> 00:18:59,750
!أودن-ساما

189
00:19:06,990 --> 00:19:10,720
...أنتم الحمقى الّذين عاشوا في رغد العاصمة

190
00:19:10,720 --> 00:19:13,770
!لا يمكنكم أبدًا فهم مشاعر من عاش في الجحيم

191
00:19:13,770 --> 00:19:17,350
!أهذا ما تريد قوله؟

192
00:19:26,260 --> 00:19:28,920
!عار عليكم أيّها الأوغاد

193
00:19:29,180 --> 00:19:32,080
!كيف تمكّنتم من تعذيب هؤلاء الصّغار؟

194
00:19:38,770 --> 00:19:40,830
...أنا جائع

195
00:19:41,070 --> 00:19:43,800
!هذا لأنّك تواصل إقراض المال للنّاس

196
00:19:53,000 --> 00:19:54,100
!صحيح

197
00:19:54,500 --> 00:19:57,040
!يا رفاق، اذهبوا لسرقة الطّعام

198
00:19:57,040 --> 00:19:59,870
!لا يجدر بدايميو قول ذلك

199
00:20:11,930 --> 00:20:14,090
!أنهِ أمره بسرعة

200
00:20:14,640 --> 00:20:18,830
،حتّى ولو تصرّفت ببؤس الآن

201
00:20:18,830 --> 00:20:23,040
...سيتحدث النّاس عن عظمة موتك البطوليّ لأجيال

202
00:20:23,380 --> 00:20:25,900
...لا أمانع

203
00:20:27,320 --> 00:20:30,090
!أن أُنسى

204
00:20:30,340 --> 00:20:31,780
...لكن

205
00:20:36,290 --> 00:20:40,240
!ستعيش روحي

206
00:20:42,550 --> 00:20:44,360
!ماذا؟

207
00:20:44,880 --> 00:20:48,110
!آسف بشأن العجوز الشّمطاء

208
00:20:53,270 --> 00:20:55,640
...فقد قتلتُها

209
00:20:55,640 --> 00:20:57,720
فعلاً؟

210
00:21:01,980 --> 00:21:03,670
...يا لاستقامتك

211
00:21:04,400 --> 00:21:07,560
!زد قوّتك بينما تستطيع

212
00:21:10,130 --> 00:21:12,440
...إنّني

213
00:21:13,330 --> 00:21:18,390
سأسعد إن تحدّث النّاس عنّي
.وهم يحتسون شرابهم

214
00:21:26,670 --> 00:21:29,080
!أتباعي السّاموراي

215
00:21:29,680 --> 00:21:31,000
!توكي

216
00:21:31,260 --> 00:21:32,740
!مومونوسكي

217
00:21:32,740 --> 00:21:34,200
!هيوري

218
00:21:40,100 --> 00:21:42,510
!إنّي راحل

219
00:21:49,400 --> 00:21:52,820
...ما كان الأودن ليُسمّى أودن

220
00:22:24,230 --> 00:22:28,710
!إن لم يكن يغلي

221
00:23:04,350 --> 00:23:07,750
!تشتعل النّيران في قلعة أودن بعد غارة كايدو

222
00:23:07,750 --> 00:23:11,090
،وبعد هجمات متواصلة
.ما عاد لعشيرة كوزكي من مهرب الآن

223
00:23:11,090 --> 00:23:16,050
وحتّى وهي محاصرة، تصارع توكي لإنقاذ
!حلم أودن ومستقبل البلاد

224
00:23:16,050 --> 00:23:22,360
مؤمنة بشروق الشّمس، تمنّت أمنية متّقدة
.وعهدت بمصير بلاد وانو للبقيّة

225
00:23:22,360 --> 00:23:27,350
:في الحلقة القادمة من وان بيس
"!القلعة تحترق! مصير عشيرة كوزكي"

226
00:23:27,350 --> 00:23:31,730
!ملك القراصنة، لن يكون إلاّ أنا