1
00:00:00,000 --> 00:00:00,990
...اركض حتّى نصل إلى

2
00:00:00,990 --> 00:00:05,550
حتّى نصل إليك

3
00:00:10,200 --> 00:00:13,810
البحر الأزرق الصّافي المفتوح

4
00:00:14,090 --> 00:00:17,150
جزء من معجزة

5
00:00:17,670 --> 00:00:23,300
تقابلنا أكثر ممّا يمكننا تصّوره

6
00:00:23,620 --> 00:00:26,390
مع كلّ خطوة نخطوها في هذه الرّحلة

7
00:00:26,390 --> 00:00:30,250
ما زال الهدف بعيد المنال

8
00:00:30,250 --> 00:00:33,800
لكن بإمكاننا تجاوز أيّ عقبة

9
00:00:33,800 --> 00:00:37,190
لأنّنا نريد رؤية ابتسامتك

10
00:00:37,190 --> 00:00:41,430
إن تردّدنا، فلن نتألّق

11
00:00:41,430 --> 00:00:44,990
بل ونسعى جاهدين للتّغلّب على نقاط ضعفنا

12
00:00:44,990 --> 00:00:50,580
نحن الّذين كنّا مخلصين

13
00:00:50,580 --> 00:00:54,710
لطالما كنّا كذلك

14
00:00:54,710 --> 00:00:58,130
...اركض حتّى نصل إلى

15
00:00:58,130 --> 00:01:03,180
حتّى نصل إليك

16
00:01:03,180 --> 00:01:09,850
لن نبلغ مستوى الأسطورة؟
!لا مشكلة! كلّ شيء على ما يرام

17
00:01:09,850 --> 00:01:16,340
اتبع الخريطة المتألّقة إلى أن يأتي
اليوم الّذي نستطيع فيه الضّحك

18
00:01:16,340 --> 00:01:22,760
لذلك لا مزيد من التّردّد أيّها المقاتل
سيكون كلّ شيء بخير

19
00:01:28,890 --> 00:01:33,470
"عزيمة ساول - إرادة أوهارا الموروثة"

20
00:01:36,690 --> 00:01:37,770
!حسنًا

21
00:01:44,160 --> 00:01:45,760
...أيّها العجوز ساول

22
00:01:58,340 --> 00:02:03,290
ساعدتَ قبل وقت طويل واحدة
.من أفراد طاقمي عندما كانت طفلة

23
00:02:03,930 --> 00:02:05,840
.أريد تقديم امتناني لك

24
00:02:06,810 --> 00:02:09,760
...و... واحترامي

25
00:02:10,450 --> 00:02:12,050
...وأيضًا

26
00:02:12,520 --> 00:02:15,470
أين تعلّمتَ الحديث هكذا؟

27
00:02:16,540 --> 00:02:18,740
...اسمعوا جميعًا

28
00:02:18,740 --> 00:02:21,690
يتحدّث بشكل رسميّ جدًّا، صحيح؟

29
00:02:23,030 --> 00:02:24,510
.يبدو كذلك بالفعل

30
00:02:24,510 --> 00:02:27,260
...سُررتُ؟ سُررتُ بـ

31
00:02:29,040 --> 00:02:30,720
.دعني أعرّفك به

32
00:02:31,500 --> 00:02:33,950
.هذا هو لوفي

33
00:02:37,460 --> 00:02:40,250
.أنا أعرفك جيّدًا يا لوفي

34
00:02:40,760 --> 00:02:43,030
.سررتُ بالتّحرّف إليك

35
00:02:43,800 --> 00:02:47,300
."أخطأت يا لوفي. التّعبير هو "بالتّعرّف إليك

36
00:02:47,510 --> 00:02:48,920
.هكذا إذًا

37
00:02:52,140 --> 00:02:53,890
.إنّه مشهور جدًّا

38
00:02:53,890 --> 00:02:56,460
.لقد كنت جزءًا من البحريّة

39
00:02:56,460 --> 00:02:59,600
.أعلم تمامًا المكانة الّتي يحتلّها أباطرة البحر

40
00:03:17,880 --> 00:03:21,480
!وجدتِهم أخيرًا يا روبين

41
00:03:22,550 --> 00:03:23,570
.نعم

42
00:03:23,880 --> 00:03:25,590
.كما أخبرتني تمامًا

43
00:03:26,590 --> 00:03:28,280
.وجدتهم بالفعل

44
00:03:35,690 --> 00:03:40,630
أصدقاء حقيقيّون سيفعلون
.أيّ شيء لحمايتي

45
00:03:49,160 --> 00:03:52,140
!سنكون دائمًا معك لحمايتك

46
00:03:55,870 --> 00:03:58,140
.أكيد، هذا أمر طبيعيّ

47
00:04:19,230 --> 00:04:20,860
،في كلّ الأحوال

48
00:04:20,860 --> 00:04:24,440
،بعد مجيئكم كلّ هذه المسافة إلى إلباف

49
00:04:24,440 --> 00:04:26,250
...أريد أن أقول لكم يا أصدقاء روبين

50
00:04:26,490 --> 00:04:28,460
.شكرًا جزيلاً لكم

51
00:04:29,740 --> 00:04:33,800
.شكرًا لاعتنائكم بروبين كلّ هذا الوقت

52
00:04:35,540 --> 00:04:38,140
.أتمنّى أن تستمرّوا بحمايتها

53
00:04:39,380 --> 00:04:40,850
!لا داعي للقلق

54
00:04:41,040 --> 00:04:45,320
!يا ساول

55
00:04:46,770 --> 00:04:49,490
هذه أنا! ألا تتذكّرني؟

56
00:04:49,490 --> 00:04:51,050
من أنت؟

57
00:04:51,050 --> 00:04:53,510
!لم أرك منذ مدّة

58
00:04:54,450 --> 00:04:56,370
كيف حالك؟

59
00:04:56,560 --> 00:04:58,430
.قبل كلّ شيء، أنا لا أعرفك

60
00:04:58,810 --> 00:05:00,870
وكيف يمكنك الطّيران؟

61
00:05:00,870 --> 00:05:04,460
!أرى أنّ فهمك بطيء. هذه أنا

62
00:05:04,460 --> 00:05:06,390
!فيغابانك

63
00:05:09,200 --> 00:05:10,650
أهذا ما أردت؟

64
00:05:11,670 --> 00:05:14,190
.نعم، نعم. شكرًا لك

65
00:05:14,660 --> 00:05:16,390
.سأقوم بحمله

66
00:05:16,390 --> 00:05:20,600
.أحضرتُه معنا من إيغهيد بطلب من فيغابانك

67
00:05:20,830 --> 00:05:22,740
ما الّذي بداخله؟

68
00:05:24,000 --> 00:05:26,270
!أنا بداخله

69
00:05:27,400 --> 00:05:28,520
.حسنًا

70
00:05:28,520 --> 00:05:30,110
!ممتاز

71
00:05:30,680 --> 00:05:33,000
ما الّذي تقصده بـ"هي بداخله"؟

72
00:05:33,100 --> 00:05:35,380
...بخصوص ذلك

73
00:05:39,020 --> 00:05:41,080
!ماذا؟ نسخة فيغابانك؟

74
00:05:42,580 --> 00:05:43,850
!هذا صحيح

75
00:05:44,270 --> 00:05:47,820
...تضمّ هذه الحاوية نسخة مثاليّة لفيغابانك

76
00:05:47,820 --> 00:05:50,550
!بخصائص تختلف عنّا نحن الأقمار

77
00:05:50,780 --> 00:05:52,880
،إلى جانب ذلك، قبل 20 عامًا

78
00:05:53,070 --> 00:05:55,510
فإنّ من أتى إلى إلباف

79
00:05:56,330 --> 00:05:59,570
.هو "أنا" الموجود هنا

80
00:06:02,170 --> 00:06:06,730
ألا تظنّون أنّ حكومة العالم كانت لتشكّ
في أمر ستيلا إن غاب عن المختبر لشهور؟

81
00:06:08,630 --> 00:06:09,790
...يا إلهي

82
00:06:10,220 --> 00:06:12,440
.يا له من عجوز معقّد

83
00:06:12,440 --> 00:06:14,210
،ولكن

84
00:06:14,300 --> 00:06:18,010
على أيّ حال، تسلّلنا به خارج إيغهيد
...في وعاء من السّوائل البيولوجيّة

85
00:06:20,350 --> 00:06:23,910
لكن ليس لديّ الإمكانيّات
.اللاّزمة لاستخراجه بأمان

86
00:06:23,910 --> 00:06:25,350
...وأيضًا

87
00:06:26,110 --> 00:06:30,130
!أنا أنوي أن أستقرّ هنا وأبني مختبرًا جديدًا

88
00:06:30,130 --> 00:06:33,340
!مختبر جديد لفيغابانك؟

89
00:06:33,530 --> 00:06:35,190
...مهلاً، هل يعني هذا

90
00:06:35,450 --> 00:06:38,090
!أنّه سيكون بإمكانك علاج أبي؟

91
00:06:39,790 --> 00:06:41,680
!بالطّبع يا بوني

92
00:06:41,680 --> 00:06:43,050
!ممتاز

93
00:06:43,050 --> 00:06:45,700
!يا لها من أخبار سعيدة

94
00:06:47,190 --> 00:06:49,880
،إن كنت فيغابانك بالفعل

95
00:06:49,880 --> 00:06:53,030
.أنا مسرور بلقائك ثانية بعد 20 سنة

96
00:06:53,030 --> 00:06:57,010
.لكنّي لا أفهم
كيف أصبحت امرأة؟

97
00:06:57,010 --> 00:07:00,870
!لا داعي للقلق، سأشرح لك كلّ شيء

98
00:07:07,320 --> 00:07:08,960
...استعداد

99
00:07:09,230 --> 00:07:10,670
!يا أستاذ

100
00:07:10,670 --> 00:07:11,980
هل انتهيت؟

101
00:07:11,980 --> 00:07:13,550
أيمكننا اللّعب الآن؟

102
00:07:13,550 --> 00:07:16,010
.نعم. آسف يا أطفال

103
00:07:16,010 --> 00:07:19,190
.يمكنكم الذّهاب. شكرًا على المساعدة

104
00:07:20,080 --> 00:07:23,070
أطفال عمالقة؟

105
00:07:24,250 --> 00:07:25,560
،في الحقيقة

106
00:07:25,560 --> 00:07:28,810
هذا الينبوع هو المكان
.الّذي يلعب فيه الأطفال عادة

107
00:07:29,920 --> 00:07:34,590
طلبنا منهم التزام الهدوء فقط
.ليستطيع الأستاذ ساول القيام بهذا

108
00:07:34,590 --> 00:07:37,820
.تدرّبنا على هذا عدّة مرّات

109
00:07:40,930 --> 00:07:43,220
...وقع الأستاذ ساول و

110
00:07:43,480 --> 00:07:45,750
!دخلت المياه في أنفي

111
00:07:46,600 --> 00:07:49,030
!النّجدة

112
00:07:49,030 --> 00:07:51,130
!أنت بعيدة جدًّا

113
00:07:57,280 --> 00:07:59,530
.آسف لأنّي أقلقتكم

114
00:07:59,530 --> 00:08:01,970
!فعلتم كلّ ذلك لكنّها كشفت الأمر في الحال؟

115
00:08:03,000 --> 00:08:05,000
.أعتذر لأنّي لم أعرّف بنفسي

116
00:08:05,000 --> 00:08:08,560
.أنا أنجي، مساعدة الأستاذ ساول

117
00:08:05,670 --> 00:08:08,560
أمينة مكتبة البوم
(مساعدة ساول)
أنجي

118
00:08:08,560 --> 00:08:10,870
.آسفة لأنّي أتحدّث من مكان مرتفع هكذا

119
00:08:11,090 --> 00:08:15,370
ستجدون هنا أفضل مكتبة
.وأفضل مدرسة في إلباف

120
00:08:15,930 --> 00:08:17,110
مكتبة؟

121
00:08:17,110 --> 00:08:20,070
...يمكنني أخذكم في جولة إن أحببتم

122
00:08:22,530 --> 00:08:24,530
!يبدو هذا المكان ممتعًا

123
00:08:24,530 --> 00:08:29,260
أيمكننا أن نرى كيف تُدرّب
!إلباف محاربيها العظماء؟

124
00:08:32,440 --> 00:08:34,590
!سأذهب أوّلاً يا أوسوبّ –
!لن أسمح لك –

125
00:08:34,590 --> 00:08:36,100
!ذهبا سلفًا

126
00:08:39,990 --> 00:08:42,550
!انتظر يا لوفي

127
00:08:43,330 --> 00:08:44,550
...إنّ هذه

128
00:08:52,670 --> 00:08:56,620
.مدرسة الفظّ حيث يدرس أطفال إلباف

129
00:08:57,150 --> 00:09:01,860
أسّسها الأستاذ ساول منذ 20 سنة
.نزولاً لطلب من الملك السّابق

130
00:09:02,390 --> 00:09:04,060
.تبدو رائعة

131
00:09:04,060 --> 00:09:06,830
!هنا تدرّبون محاربيكم إذًا

132
00:09:07,350 --> 00:09:09,770
.عذرًا يا أنجي وغيرد

133
00:09:09,770 --> 00:09:12,670
.أتمنّى أن تصطحبانهم أينما يريدون

134
00:09:13,190 --> 00:09:16,500
.أمّا أنا فأريد اصطحاب روبين إلى المكتبة

135
00:09:16,500 --> 00:09:17,840
!مفهوم

136
00:09:18,030 --> 00:09:19,800
.دع الأمر لنا

137
00:09:21,570 --> 00:09:25,010
حسنًا، ليأتِ معي كلّ من
.يريد رؤية المدرسة

138
00:09:25,010 --> 00:09:27,820
،وإن أردتم رؤية أماكن أخرى
.فتعالوا معي

139
00:09:28,600 --> 00:09:30,370
...مدرسة

140
00:09:30,670 --> 00:09:32,810
.إنّها تذكّرني بالدّوجو

141
00:09:34,420 --> 00:09:37,810
!إنّ المدارس تُشعرني بالحنين أيضًا

142
00:09:37,810 --> 00:09:39,650
!هيّا بنا يا زورو-سان

143
00:09:39,930 --> 00:09:41,590
.لنذهب أيضًا يا تشوبّر

144
00:09:41,590 --> 00:09:42,670
...عفوًا

145
00:09:42,670 --> 00:09:45,620
.أنا مهتمّ أكثر بزيارة المكتبة

146
00:09:45,620 --> 00:09:48,050
.أتساءل إن كانت الكتب عملاقة –
.إذًا، أنا سأرافقك يا نامي-سان –

147
00:09:48,050 --> 00:09:51,390
!سأحميك بكلّ ما لديّ

148
00:09:52,610 --> 00:09:55,520
وأين ستذهب أنت يا فرانكي؟

149
00:09:55,730 --> 00:09:56,750
...أنا

150
00:09:57,570 --> 00:10:00,440
...بصراحة

151
00:10:10,210 --> 00:10:13,370
.إنّ هذه الشّجرة العملاقة تشغل كلّ تفكيري

152
00:10:19,340 --> 00:10:21,580
...إنّها ضخمة

153
00:10:25,140 --> 00:10:27,320
!هذه بلاد العمالقة

154
00:10:27,320 --> 00:10:28,940
!بشر صغار

155
00:10:28,940 --> 00:10:30,870
!لنقم بسجنهم

156
00:10:31,690 --> 00:10:32,850
هل أقوم بتقطيعهما؟

157
00:10:33,020 --> 00:10:34,540
!طبعًا لا أيّها الغبيّ

158
00:10:34,540 --> 00:10:37,040
!عودوا إلى هنا

159
00:10:37,040 --> 00:10:38,690
!سننال منكم

160
00:10:38,690 --> 00:10:39,920
!أمسكوا بهم

161
00:10:39,920 --> 00:10:42,020
!حسنًا! قاتلاني

162
00:10:42,240 --> 00:10:44,210
!أريانا ما لديكما أيّها الشّقيّان

163
00:10:44,210 --> 00:10:45,840
.هذا طبيعيّ بالكامل

164
00:10:45,840 --> 00:10:48,050
!إنّهما من محاربي المستقبل

165
00:10:49,890 --> 00:10:51,640
!مهلاً

166
00:10:53,500 --> 00:10:56,390
!ليس من الصّواب مطاردة البشر

167
00:10:56,390 --> 00:10:57,980
!ولا تنادياهم بالبشر الصّغار

168
00:10:58,210 --> 00:10:59,430
...آسفان

169
00:10:59,430 --> 00:11:00,980
!ضعيفان

170
00:11:00,980 --> 00:11:04,040
هل هؤلاء الأشقياء من قرية المحاربين بالفعل؟

171
00:11:05,650 --> 00:11:08,130
."لا تنادينا بـ"الأشقياء

172
00:11:08,130 --> 00:11:09,430
!بالضّبط

173
00:11:09,430 --> 00:11:13,100
!مهلاً، مهلاً! لا تحبطوني هكذا

174
00:11:13,100 --> 00:11:16,410
."نحن لا نمانع أبدًا أن تنادونا بـ"البشر الصّغار

175
00:11:16,410 --> 00:11:21,130
كما أنّكم ستخوضون غمار البحر
يومًا ما وتقاتلون الأشرار، صحيح؟

176
00:11:24,380 --> 00:11:26,470
ماذا؟ ما الّذي دهاكم؟

177
00:11:26,470 --> 00:11:30,080
...لن نقوم بذلك –
.لا، ذلك خطير جدًّا –

178
00:11:30,080 --> 00:11:31,540
!ماذا؟

179
00:11:31,540 --> 00:11:34,680
!ألستم يا رفاق الجيل التّالي من محاربي إلباف؟

180
00:11:35,710 --> 00:11:37,500
!لسنا رفاقك

181
00:11:37,500 --> 00:11:41,650
!إنّه محقّ! لا نريد أن نصير محاربين

182
00:11:43,860 --> 00:11:45,670
ولكن لماذا؟

183
00:11:45,930 --> 00:11:47,750
.لأنّ ذلك ليس رائعًا بعد الآن

184
00:11:49,970 --> 00:11:52,030
من الطّبيعيّ جدًّا هذه الأيّام

185
00:11:52,480 --> 00:11:55,970
.ألا يُبدي الأطفال أيّ اهتمام بذلك بعد الآن

186
00:11:57,290 --> 00:12:00,420
من قال ذلك؟ –
ماذا تقصدين بأنّه ليس من اهتماماتهم؟ –

187
00:12:00,420 --> 00:12:02,860
.من الأفضل أن تبتعدوا من هناك

188
00:12:02,860 --> 00:12:05,250
.صحيح، وإلاّ ستُوبّخون

189
00:12:06,460 --> 00:12:08,150
...إنّكم الآن

190
00:12:16,350 --> 00:12:20,310
أستاذة علم الأحياء في مدرسة الفظّ
ريبلي

191
00:12:17,420 --> 00:12:20,310
.تقفون على الأستاذة ريبلي

192
00:12:20,310 --> 00:12:23,790
كنّا نقف على عملاقة؟
!نحن آسفون

193
00:12:24,920 --> 00:12:26,900
.لا مشكلة. لستم ثقيلين على الإطلاق

194
00:12:27,220 --> 00:12:30,110
!صحيح! أيمكنك شرح الأمر لنا بما أنّك أستاذة؟

195
00:12:30,390 --> 00:12:33,470
لماذا لا يريدون أن يصيروا محاربين؟

196
00:12:35,520 --> 00:12:41,270
ظننتُ أنّ كلّ ساكني إلباف
...يطمحون ليكونوا محاربين

197
00:12:42,040 --> 00:12:44,280
هل تفاجأت؟

198
00:12:44,280 --> 00:12:49,570
مرّت مائة عام مذ كان
.محاربو إلباف يرعبون العالم

199
00:12:53,180 --> 00:12:57,490
الفظاظة والعنف والنّهب والحرب؟

200
00:12:59,630 --> 00:13:02,230
ما عاد ذلك هو العالم
.الّذي نعيش فيه الآن

201
00:13:05,970 --> 00:13:08,720
.مرحبًا بكم. سمعتُ عنكم من ساول

202
00:13:08,720 --> 00:13:11,310
.لا بدّ أنّكم طاقم قبّعة القشّ

203
00:13:11,310 --> 00:13:13,010
!هذا صحيح! سررت بلقائك

204
00:13:13,810 --> 00:13:17,050
.آسفة لأنّ أطفالنا الأشقياء كانوا مزعجين

205
00:13:17,350 --> 00:13:19,500
!انتبهي لكلامك عنهم

206
00:13:21,230 --> 00:13:23,970
.أنا أدرّس بكوني قدوة سيّئة

207
00:13:24,460 --> 00:13:26,640
!هذا لئيم يا أستاذة

208
00:13:26,740 --> 00:13:30,590
!كنتم هنا إذًا

209
00:13:31,120 --> 00:13:34,740
...إذًا ما عادت إلباف بلادًا للمحاربين

210
00:13:40,790 --> 00:13:43,380
...قال الملك العظيم هارالد في السّابق

211
00:13:43,380 --> 00:13:46,270
"!دعونا نتاجر مع بقيّة العالم بدل محاربتهم"

212
00:13:46,630 --> 00:13:50,680
أصرّ على إعادة هيكلة البلاد
،رغم معارضات كبار القرية

213
00:13:50,680 --> 00:13:52,800
.الّذين كانوا متشبّثين بالتّقاليد

214
00:13:52,800 --> 00:13:54,630
الملك هارالد؟

215
00:13:55,010 --> 00:14:00,490
هذا هو اسم الملك العظيم
.الّذي أراد إعادة هيكلة البلاد

216
00:14:00,490 --> 00:14:05,720
،ولكن بينما كان حلمه قد بدأ يتحقّق
...قُتل الملك هارالد

217
00:14:06,230 --> 00:14:08,140
.على يد ابنه

218
00:14:09,170 --> 00:14:12,060
،ترفض البلاد تتويج ابنه كملك

219
00:14:12,060 --> 00:14:14,980
.لذلك ليس لدينا ملك حتّى اليوم

220
00:14:15,630 --> 00:14:17,110
!حسنًا

221
00:14:17,200 --> 00:14:19,600
!انتهى درس التّاريخ

222
00:14:19,600 --> 00:14:23,080
.خذوهم في جولة حول المدرسة يا أطفال

223
00:14:23,080 --> 00:14:24,560
!حاضر

224
00:14:24,560 --> 00:14:27,640
!أريد القيام بذلك –
!أنا سأصطحبهم –

225
00:14:27,640 --> 00:14:30,000
.حسنًا، فهمت

226
00:14:39,280 --> 00:14:41,640
أأنت بخير أيّها البشريّ الصّغير؟

227
00:14:43,190 --> 00:14:45,220
.نعم، شكرًا لك

228
00:14:46,770 --> 00:14:48,180
...أيّها القبطان

229
00:14:49,740 --> 00:14:53,800
لماذا لست في شكلك الأبيض؟
.كنتُ أتطلّع لرؤية ذلك

230
00:14:53,800 --> 00:14:57,510
.ذلك؟ إنّه شكلي وأنا حرّ

231
00:14:58,490 --> 00:14:59,970
حرّ؟

232
00:15:05,960 --> 00:15:10,470
في الحقيقة، تتحدّث أساطير إلباف
.عن محارب له نفس المظهر

233
00:15:10,470 --> 00:15:11,900
فعلاً؟

234
00:15:12,680 --> 00:15:14,470
!كنتُ متحمّسة جدًّا

235
00:15:14,470 --> 00:15:17,060
.لأنّنا آخر جيل من المحاربين

236
00:15:17,060 --> 00:15:19,090
!يا أستاذة

237
00:15:19,490 --> 00:15:21,390
!بسرعة

238
00:15:21,390 --> 00:15:22,740
.حسنًا، خذي

239
00:15:22,740 --> 00:15:26,060
!ممتاز، هيّا بنا أيّها البشريّ الصّغير

240
00:15:33,740 --> 00:15:37,300
.فهمت. تعرفين كلّ ذلك سلفًا

241
00:15:38,080 --> 00:15:39,820
،وقتها

242
00:15:39,820 --> 00:15:43,950
.بالكاد وصلتُ إلى إلباف وأنا حيّ

243
00:15:44,500 --> 00:15:49,480
لم يسعني إلاّ أن أقلق على الكتب
.الّتي ضحّى الباحثون بحياتهم لحمايتها

244
00:15:49,710 --> 00:15:54,370
لذلك طلبتُ المساعدة من هايرودين
.واتّجهتُ عائدًا إلى أوهارا

245
00:16:03,620 --> 00:16:05,050
...وهناك

246
00:16:05,330 --> 00:16:09,370
رأيتُ تلك الكتب الصّغيرة
،ما زالت في حالة جيّدة

247
00:16:09,370 --> 00:16:11,040
.ودفعني ذلك للبكاء

248
00:16:13,400 --> 00:16:15,600
.هيّا بنا يا روبين. لندخل

249
00:16:16,630 --> 00:16:19,170
.لكن انتبهي من ذلك الكتاب

250
00:16:43,180 --> 00:16:44,470
!روبين

251
00:17:00,320 --> 00:17:01,400
!انظروا

252
00:17:09,630 --> 00:17:11,120
هل تفاجأتم؟

253
00:17:12,130 --> 00:17:14,920
!صارت كلّ الكتب الآن بشكل عملاق

254
00:17:14,920 --> 00:17:17,920
!يكبر حجم كلّ كتاب يدخل إلى هنا

255
00:17:21,930 --> 00:17:26,120
!مرحبًا بكم في مكتبة البوم السّحريّة

256
00:17:27,140 --> 00:17:32,330
ستجدون هنا كلّ النّصوص الّتي
!حماها باحثو أوهارا قبل 22 سنة

257
00:17:32,610 --> 00:17:36,980
بحثنا في كلّ أرجاء الجزيرة
!وعثرنا على كلّ واحد منها

258
00:17:38,700 --> 00:17:40,860
!أحضرنا كلّ شيء إلى هنا

259
00:17:46,830 --> 00:17:48,310
!أخرجوا كلّ الكتب

260
00:17:48,500 --> 00:17:52,020
!علينا تمرير الماضي لهم! إنّ كلّ كتاب مهمّ

261
00:17:52,250 --> 00:17:55,140
!لننقذ ولو حتّى سطرًا واحدًا منها

262
00:17:55,140 --> 00:17:58,000
لضمان وصول أصوات أسلافنا
...من آلاف السّنين

263
00:17:59,800 --> 00:18:02,130
!يجب المحافظة عليها وتمريرها للمستقبل

264
00:18:06,770 --> 00:18:09,970
.هذه أفضل مكتبة في العالم

265
00:18:12,480 --> 00:18:13,930
...روبين

266
00:18:15,520 --> 00:18:17,330
أتحبّين الكتب؟

267
00:18:25,330 --> 00:18:29,780
!لا أصدّق أنّي أريك هذه الكتب أخيرًا

268
00:18:41,220 --> 00:18:45,650
.لديك الكثير من الوقت أيضًا يا موسا-كو

269
00:18:41,810 --> 00:18:45,650
العالم السّفليّ

270
00:18:45,850 --> 00:18:47,880
هل أزعجك؟

271
00:18:48,280 --> 00:18:51,620
على الإطلاق، هذه طريقة جيّدة
.لتمرير الوقت أيضًا

272
00:18:53,770 --> 00:18:56,470
.لديّ الكثير من الوقت على أيّ حال

273
00:18:57,480 --> 00:19:01,750
هل ذلك الحدث الصّادم الّذي
أخبرتني عنه ما زال يزعجك؟

274
00:19:01,750 --> 00:19:06,280
نعم. إنّ جسدي بأكمله يرتعش
.في كلّ مرّة أفكّر فيه

275
00:19:01,950 --> 00:19:09,220
حلزون اتّصال ثلجيّ
(نوع التّعرّف على الصّوت المقاوم للبرد)

276
00:19:06,870 --> 00:19:09,220
.يؤسفني سماع هذا

277
00:19:10,700 --> 00:19:13,750
،لم نلتقِ أو نرى بعضنا من قبل

278
00:19:13,750 --> 00:19:15,640
...ولكن شاء القدر

279
00:19:16,040 --> 00:19:18,750
.أن نصير صديقين لمدّة طويلة

280
00:19:18,750 --> 00:19:21,230
،لو كنتُ مكانك

281
00:19:22,300 --> 00:19:25,750
لكنتُ قد سحقتُ المنطقة بأكملها

282
00:19:25,970 --> 00:19:27,700
!وقتلتُ كلّ واحد منهم

283
00:19:28,390 --> 00:19:31,530
.ذ... ذلك ليس ما أريده

284
00:19:32,770 --> 00:19:35,140
!ولذلك السّبب أنت مثال للسّذاجة

285
00:19:35,700 --> 00:19:39,690
لا يجب السّماح لأولئك الأغبياء
،بأن ينجون بفعلتهم

286
00:19:39,690 --> 00:19:41,390
!وإلاّ فسيعودون سعيًا للانتقام

287
00:19:41,780 --> 00:19:43,850
.شكرًا جزيلاً لك

288
00:19:44,550 --> 00:19:47,380
...أدركتُ مؤخّرًا

289
00:19:47,380 --> 00:19:51,450
أنّك تُخفي خلف كلماتك
.العنيفة تلك لطفًا كبيرًا

290
00:19:51,450 --> 00:19:52,600
!ماذا؟

291
00:19:52,830 --> 00:19:56,060
!جعلني هذا أشعر بالاشمئزاز
!فهمت الأمر بشكل خاطئ تمامًا

292
00:19:56,420 --> 00:19:59,330
!كفاك توهّمًا! أنا لطيف؟

293
00:19:59,330 --> 00:20:01,290
!إيّاك وقول ذلك ثانية

294
00:20:05,300 --> 00:20:07,240
!صمتًا يا موسا-كو

295
00:20:07,240 --> 00:20:10,320
.سألقّنك درسًا بعد أن أتحرّر من قيودي

296
00:20:20,860 --> 00:20:23,250
!مهلاً! لم تبدأ الوليمة بعد

297
00:20:24,990 --> 00:20:26,960
!أنا أشرب بينما أنتظر

298
00:20:26,960 --> 00:20:29,270
!أنت تشرب الكثير

299
00:21:10,590 --> 00:21:16,600
يُتبع

300
00:21:20,100 --> 00:21:23,900
ها أنا أجهد عينيّ حتّى الإنهاك

301
00:21:25,520 --> 00:21:29,590
أتفحّص مكاني وأرى أين أقف الآن

302
00:21:30,540 --> 00:21:35,370
وعقلي مستهلَك بالكامل بكلّ
هذا الوهم واليأس

303
00:21:35,370 --> 00:21:38,700
دائمًا ما أميل قليلاً عن المسار ولا أعرف كيف

304
00:21:39,010 --> 00:21:43,320
والأشياء الّتي تظهر لي بوضوح

305
00:21:44,370 --> 00:21:48,170
هي دومًا ذكريات قاسية

306
00:21:49,760 --> 00:21:54,220
أجمع بقايا ملل حياتي البسيط

307
00:21:54,220 --> 00:21:57,890
ربّما أتحوّل إلى شخص غيري ليس أنا

308
00:21:59,250 --> 00:22:02,480
أتساءل ما المستقبل
الّذي يليق بشخص مثلي الآن

309
00:22:02,480 --> 00:22:06,400
من الآن فصاعدًا
مهما أجهدتُ عينيّ بالتّحديق

310
00:22:06,400 --> 00:22:08,860
فلن أرى شيئًا على أيّ حال

311
00:22:08,860 --> 00:22:12,360
أنا أواجه الرّياح المعاكسة

312
00:22:12,360 --> 00:22:15,200
وأصبّها في دمعة القدر

313
00:22:15,200 --> 00:22:19,660
وأمزّق كلّ الأوهام الزّائفة إربًا إربا

314
00:22:19,660 --> 00:22:23,210
والجميع هناك

315
00:22:23,210 --> 00:22:27,750
يرصّون واقعهم الخاصّ بين
الحياة والموت هكذا طوال الوقت

316
00:22:27,750 --> 00:22:30,340
ثمّ يأتي الغد بصوتٍ أعلى من أن يُحتمل

317
00:22:30,340 --> 00:22:34,930
ولا يترك وقتًا حتّى للدّعاء

318
00:22:34,930 --> 00:22:39,760
وذلك المستقبل الّذي نراه

319
00:22:39,760 --> 00:22:44,170
إنّه لي أنا

320
00:22:50,200 --> 00:22:53,340
.بدأت وليمة إلباف أخيرًا

321
00:22:53,470 --> 00:22:58,770
يتشارك العمالقة وطاقم قبّعة القشّ
.مشروبًا وهم يتذكّرون لقاءهم الأوّل

322
00:22:59,120 --> 00:23:02,330
لكنّ ضيوفًا غير مرغوب فيهم
.بدؤوا التّحرّك في الظّلال

323
00:23:02,330 --> 00:23:05,750
!وتبدأ مؤامرة مرعبة باستهداف لوكي

324
00:23:05,750 --> 00:23:07,540
:في الحلقة القادمة من وان بيس

325
00:23:07,540 --> 00:23:11,660
ترحيب بنخب صداقة
"ودخلاء يسعون خلف لوكي

326
00:23:11,740 --> 00:23:14,290
!ملك القراصنة، لن يكون إلاّ أنا