1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,060 --> 00:02:02,280
...سنرجع للماضي قبل 25 سنة

29
00:02:09,870 --> 00:02:15,330
...بُعيد بدء عصر القراصنة العظيم

30
00:03:02,250 --> 00:03:05,760
!هل يستمتع الجميع بوقتهم؟

31
00:03:11,260 --> 00:03:13,640
.أنا سعيد لأنّني تبعتك

32
00:03:13,930 --> 00:03:15,120
!يا روجر

33
00:03:15,120 --> 00:03:18,980
!ماذا؟! لماذا تقول شيئًا كهذا الآن أيّها الغبيّ؟

34
00:03:23,400 --> 00:03:24,440
!أودن

35
00:03:24,820 --> 00:03:28,200
!يجب توجيه عبارات الشّكر لك

36
00:03:35,240 --> 00:03:38,960
!أنت تشرب الكثير! سيطر على نفسك

37
00:03:40,420 --> 00:03:45,050
!اخرس! لن أقبل نصائح من طبيب ثمل

38
00:03:46,340 --> 00:03:50,510
!أنا قلق حيال صحّتك

39
00:03:50,510 --> 00:03:52,140
!أيّها الوغد

40
00:03:54,640 --> 00:03:56,600
!استلق هناك بصمت

41
00:03:57,310 --> 00:03:58,740
...هذا مؤلم، مؤلم، مؤلم

42
00:03:58,740 --> 00:04:00,440
.آلمني هذا

43
00:04:01,600 --> 00:04:03,820
.كان ذلك علاجًا للغباء

44
00:04:04,730 --> 00:04:05,860
!توقّف

45
00:04:08,530 --> 00:04:10,030
!سُحقًا لك

46
00:04:23,710 --> 00:04:26,480
...عليّ العودة

47
00:04:26,480 --> 00:04:27,760
إلى بلاد وانو؟

48
00:04:28,340 --> 00:04:31,630
...نعم، ما زال هنالك أمر مهمّ لإنجازه

49
00:04:32,590 --> 00:04:36,600
أهنالك ما يمكننا مساعدتك به يا أودن؟

50
00:04:36,600 --> 00:04:38,430
...إن احتجت ليد العون

51
00:04:38,430 --> 00:04:41,540
!أستطيع تقديمها لك يا أودن-سان

52
00:04:41,540 --> 00:04:45,490
!غبيّ! ستكون عقبة في طريقه فحسب

53
00:04:45,490 --> 00:04:49,030
!اسمع يا أودن-سان. واثق أنّ بإمكاني المساعدة

54
00:04:51,780 --> 00:04:53,070
...ريلي

55
00:04:53,070 --> 00:04:55,200
...أحمرتارو، باغيجيرو

56
00:04:56,030 --> 00:04:57,790
!شكرًا لكم

57
00:04:57,790 --> 00:04:59,120
...لكن

58
00:05:04,750 --> 00:05:07,590
!يقع هذا على عاتقنا نحن عشيرة كوزكي

59
00:05:07,590 --> 00:05:11,230
كم مرّة طلبت منك ألاّ تناديني
بجيرو أي الابن الثّاني؟

60
00:05:11,230 --> 00:05:13,550
!انس الأمر

61
00:05:14,470 --> 00:05:17,200
صحيح. عشيرة كوزكي؟

62
00:05:17,200 --> 00:05:20,810
...تعلّمت الكثير خلال هذه الرّحلة

63
00:05:21,430 --> 00:05:25,610
.تساءلت دائمًا لماذا أغلقت بلاد وانو أبوابها

64
00:05:26,900 --> 00:05:34,360
كانت مغادرتي للبلاد خياري، لذلك لن أقول
..."شيئًا أنانيًّا مثل "دعوني أصبح الشّوغن

65
00:05:35,320 --> 00:05:38,830
!لكن عليّ توريث هذه العزيمة مهما كلّف الأمر

66
00:05:42,540 --> 00:05:46,470
،رفقة أتباعي العظماء الّذين تركتهم خلفي

67
00:05:46,470 --> 00:05:49,520
!سأفتح بلاد وانو

68
00:05:49,520 --> 00:05:54,130
وسأنتظر "المستقبل" الّذي سيأتي
!أزيد من عشرين سنة من الآن

69
00:05:56,890 --> 00:05:58,550
!لنقم بهذا يا أودن

70
00:05:58,550 --> 00:05:59,970
!أجل

71
00:05:59,970 --> 00:06:02,680
!سأنجح يا روجر

72
00:06:07,520 --> 00:06:11,900
.مرّ على ذلك 25 سنة الآن

73
00:06:44,060 --> 00:06:45,770
!أوروتشي-ساما

74
00:06:53,150 --> 00:07:00,330
"!ميناء اللّقاء! بداية فصل بلاد وانو الثّالث"

75
00:07:03,410 --> 00:07:05,410
!اليوم يوم جيّد

76
00:07:05,410 --> 00:07:08,420
!انظروا لذلك المنظر

77
00:07:10,000 --> 00:07:11,900
.إنّه اليوم المثاليّ لإقامة وليمة

78
00:07:11,900 --> 00:07:16,510
.حتّى الطّقس يصبّ في مصلحة أوروتشي-ساما

79
00:07:16,880 --> 00:07:21,780
هذه المرّة، سيظلّ كيوشيرو في العاصمة
!للاهتمام بها! أخبره أنّنا نعتمد عليه

80
00:07:21,780 --> 00:07:22,820
!حاضر

81
00:07:22,820 --> 00:07:26,890
!مسكين! لا يستطيع حضور الوليمة

82
00:07:27,480 --> 00:07:34,530
يُعرف ميناء هابو هذا في هاكوماي
.بالميناء الأكبر في بلاد وانو

83
00:07:35,070 --> 00:07:41,790
تصطفّ أشجار القيقب على طول الرّصيف
،الضّخم من السّاحل وصولاً إلى البحر

84
00:07:41,790 --> 00:07:47,210
والمشهد الخلاّب للأوراق الحمراء
.المتطايرة تودّع السّفن

85
00:07:49,290 --> 00:07:51,380
!إنّه يوم جيّد

86
00:07:51,380 --> 00:07:55,400
أحضروا السّاكي! لنحتسِ كوبًا ونحن
!نبدي إعجابنا بهذه الأوراق الحمراء

87
00:07:55,400 --> 00:07:59,300
أوروتشي-ساما، لا يجدر بك الشّرب
...إلى أن تقابل كايدو-ساما

88
00:07:59,840 --> 00:08:03,100
!ومن يهتمّ؟! أنا واثق أنّه ثمل أيضًا

89
00:08:03,510 --> 00:08:09,020
!إنّها وليمة ضخمة يحضرها 30 ألف ضيف
!لنحظَ بوقت ممتاز كما العادة

90
00:08:09,020 --> 00:08:11,940
،في ليلة مهرجان النّار السّنويّ

91
00:08:12,270 --> 00:08:16,570
يلتقي القائدان الّذين يقفان على رأس
.بلاد وانو في أونيغاشيما

92
00:08:16,570 --> 00:08:22,280
ويقيمان وليمة ضخمة يجتمع فيها
.كلٌّ من جيش أوروتشي وجيش كايدو

93
00:08:34,630 --> 00:08:36,210
!هيّا! بسرعة

94
00:08:38,420 --> 00:08:40,530
!بسرعة! بدأ الاحتفال سلفًا

95
00:08:40,530 --> 00:08:43,050
!مهلاً! لا أحبّ كيف تبدو غرّتي

96
00:09:43,240 --> 00:09:45,070
!هيّا! لنرقص

97
00:09:45,070 --> 00:09:47,750
!اشربوا! غنّوا

98
00:09:47,750 --> 00:09:50,790
!اليوم هو يوم مهرجان النّار في العاصمة

99
00:09:50,790 --> 00:09:53,160
!اليوم الوحيد المسموح لنا بالشّرب فيه

100
00:09:53,160 --> 00:09:57,090
!سنشرب حتّى الشّبع ونحظى بأفضل الأوقات اليوم

101
00:10:04,970 --> 00:10:05,940
ماذا؟

102
00:10:05,940 --> 00:10:10,770
!السّماء صافية للغاية
!سنشهد ليلة ببدر جميل ينير سماها

103
00:10:27,530 --> 00:10:32,620
تختلف الفصول في كلّ منطقة
.من مناطق بلاد وانو اختلافًا كبيرًا

104
00:10:42,510 --> 00:10:47,470
وفي نفس اللّحظة، عند نقطة
...اللّقاء في ميناء توكاغي

105
00:11:14,160 --> 00:11:16,210
!لا أرى ولو سفينة واحدة على مدّ البصر

106
00:11:17,250 --> 00:11:19,330
!أين هم الجنود الأربعة آلاف؟

107
00:11:20,710 --> 00:11:24,210
!أنا واثق أنّنا أخضعنا أودون

108
00:11:27,970 --> 00:11:32,180
.لكن لا يوجد أحد في مخيّم التّنقيب أيضًا

109
00:11:32,180 --> 00:11:35,270
!يبدو أنّ هذا الميناء قد هُوجم

110
00:11:35,680 --> 00:11:38,140
.يبدو أنّ القطّ لم يستطع المجيء

111
00:11:45,030 --> 00:11:46,900
.كما أنّ الحلزون لا يستجيب

112
00:11:47,740 --> 00:11:51,120
...لا يمكننا الاتّصال بأيّ أحد

113
00:11:54,410 --> 00:11:58,410
!عند الشّفق يوم مهرجان النّار في ميناء توكاغي

114
00:12:00,420 --> 00:12:03,810
!هذه هي نقطة اللّقاء

115
00:12:03,810 --> 00:12:07,590
!لماذا لم يحضر أيّ أحد؟! أين ذهبوا؟

116
00:12:10,890 --> 00:12:13,180
...مرّ يوم واحد لا غير

117
00:12:13,720 --> 00:12:15,640
!ما الّذي يحدث هنا؟

118
00:12:16,810 --> 00:12:18,430
!أحدث مكروه ما للجميع؟

119
00:12:18,730 --> 00:12:21,400
!تماسكوا! تماسكوا! تماسكوا

120
00:12:22,190 --> 00:12:23,820
!ارقصوا! ارقصوا

121
00:12:23,820 --> 00:12:26,330
!إنّه مهرجان النّار السّنويّ

122
00:12:26,330 --> 00:12:31,570
!لماذا لا تسترخون وتتخلّصون من بعض التّوتّر اللّيلة؟

123
00:12:35,330 --> 00:12:38,090
!لوفي-دونو، أين أنتم؟

124
00:12:38,090 --> 00:12:40,500
!هيوغورو-دونو، أجيبوا رجاءً

125
00:12:45,590 --> 00:12:47,510
!يا فرسان إينواراشي

126
00:12:47,510 --> 00:12:50,170
!لو-دونو! جيبويمون من كيبي

127
00:12:50,170 --> 00:12:54,140
!نحن أتباع كوزكي أودن

128
00:12:54,470 --> 00:12:56,890
...منذ 20 سنة مضت

129
00:12:59,520 --> 00:13:05,410
!أتينا من الماضي قبل 20 سنة لنثأر لسيّدنا

130
00:13:05,410 --> 00:13:08,710
!وجب موتنا في ذلك الوقت

131
00:13:08,710 --> 00:13:11,360
!لذا جئنا لنموت فداءً لقضيّتنا

132
00:13:14,410 --> 00:13:15,700
...إنّما

133
00:13:16,080 --> 00:13:18,910
!يتطلّب الأمر أكثر من مجرّد أرواحنا

134
00:13:18,910 --> 00:13:22,290
!تعداد العدوّ 30 ألف جنديّ! نحتاج العون

135
00:13:24,290 --> 00:13:25,380
!أتوسّل إليكم

136
00:13:25,380 --> 00:13:28,610
!ليساعدنا أحد ما

137
00:13:28,610 --> 00:13:31,230
!ليجبنا أحد ما! أتوسّل إليكم

138
00:13:31,230 --> 00:13:33,220
!يكفي يا كينييمون

139
00:13:36,100 --> 00:13:39,220
!انظر إلى السّماء والبحر

140
00:13:39,720 --> 00:13:43,070
!تخلّت عنّا السّماوات سلفًا

141
00:13:43,070 --> 00:13:45,610
!لا أحد قادر على مساعدتنا

142
00:13:45,610 --> 00:13:49,400
...لا بدّ أنّ مكروهًا حلّ على الجميع

143
00:14:08,670 --> 00:14:13,380
...سنرجع للماضي قبل يومين من مهرجان النّار

144
00:14:16,800 --> 00:14:20,610
.نعم. لدينا الآن 4200 جنديّ

145
00:14:20,610 --> 00:14:24,350
.أنا مسرور... سرّني انضمامهم لنا

146
00:14:24,730 --> 00:14:25,980
...أيّها الرّفاق

147
00:14:26,600 --> 00:14:28,610
!شكرًا على ما بذلتموه

148
00:14:28,940 --> 00:14:32,240
.استعملوا الوقت المتبقّي للسّفر والاستعداد

149
00:14:33,150 --> 00:14:34,120
...وبعدها

150
00:14:34,120 --> 00:14:37,070
!سنلتقي في بالميناء الموعود

151
00:14:45,540 --> 00:14:49,590
!أنهوا بناء سفن تكفي لحمل 5000 شخص

152
00:14:49,590 --> 00:14:50,560
.حاضر

153
00:14:50,560 --> 00:14:55,430
أحضروا تلك السّفن إلى الميناء
!في الوقت الموعود! أيمكنكم ذلك؟

154
00:14:55,680 --> 00:14:58,220
!اعتمد علينا يا أخي فرانوسكي

155
00:14:58,220 --> 00:14:59,640
!حسنًا

156
00:14:59,640 --> 00:15:04,150
،وإذًا سنلتقي بأصدقائنا في قرية أميغاسا

157
00:15:04,150 --> 00:15:07,340
!ونأتي على متن السّاني في ذلك اليوم

158
00:15:07,340 --> 00:15:09,170
!سنترك الباقي لكم

159
00:15:09,170 --> 00:15:11,710
!أجل! شكرًا على المساعدة

160
00:15:11,710 --> 00:15:14,070
!أنتم نجّارو سفن رائعون

161
00:15:14,070 --> 00:15:17,530
...شكرًا! فلنمسك قراصنة مملك الحيوان أولئك

162
00:15:18,410 --> 00:15:21,490
!ونوسعهم ضربًا يا رجال

163
00:15:25,580 --> 00:15:29,810
،مهما بلغ مقدار الخشب الّذي لدينا
!فلن يكون كافيًا أبدًا! اقطعوا كلّ شيء

164
00:15:29,810 --> 00:15:34,180
ستحضر مجموعة أوتشو سيوفًا
!ونفس الشّيء من رينغو

165
00:15:34,180 --> 00:15:35,190
...لذلك

166
00:15:35,190 --> 00:15:37,720
!سنصنع دروعًا من أيّ شيء حولنا

167
00:15:37,720 --> 00:15:39,590
،لا أدري إن كانت قابلة للاستعمال

168
00:15:39,590 --> 00:15:43,700
لكن لدينا الكثير من الأسلحة
!وما إلى ذلك لنأخذها من هنا

169
00:15:43,700 --> 00:15:45,180
!عظيم

170
00:15:45,180 --> 00:15:49,990
،إن ذهبنا إلى نقطة اللّقاء باكرًا جدًّا
.فسنجلب لنا الكثير من الانتباه

171
00:15:49,990 --> 00:15:50,810
...لكن

172
00:15:50,810 --> 00:15:55,690
في صباح ذلك اليوم، سينطلق موكب
.الشّوغن من العاصمة إلى الميناء

173
00:15:55,690 --> 00:16:00,320
،بمجرّد مغادرته إلى أونيغاشيما
!سيبدأ مهرجان النّار في العاصمة

174
00:16:00,320 --> 00:16:03,200
!لن ينتبه لنا أيّ شخص

175
00:16:03,200 --> 00:16:08,080
عصفوران بحجر..." من الأفضل"
...الوصول إلى هنا عند الشّفق

176
00:16:08,080 --> 00:16:11,540
!لكنّ بعض الضّبّاط سيظلّون في البرّ الرّئيسيّ

177
00:16:11,540 --> 00:16:15,940
،لا تسمحوا لهم بإرسال تقارير لأونيغاشيما
!لذلك ابقوا فطنين طوال الوقت

178
00:16:15,940 --> 00:16:17,050
!حاضر

179
00:16:22,350 --> 00:16:24,570
!أتسمحون لنا بارتداء هذه؟

180
00:16:24,570 --> 00:16:28,540
!مذهل! إنّها خوذة ساموراي
!أريد أن أريها لأوسوبّ أيضًا

181
00:16:28,540 --> 00:16:30,730
!نحن محاربون

182
00:16:37,400 --> 00:16:40,040
.عدوّكم هو كايدو شنيع السّمعة

183
00:16:40,040 --> 00:16:42,550
!هل أنتم جاهزون جميعًا؟

184
00:16:42,550 --> 00:16:43,910
كايدو؟

185
00:16:44,410 --> 00:16:46,200
...ذلك الخاسر

186
00:16:46,490 --> 00:16:49,250
!يوشك أن يُقطّع

187
00:16:49,620 --> 00:16:52,250
!لا أظنّ أنّنا سنخسر

188
00:16:52,250 --> 00:16:54,130
!أرونا كلّ ما في جعبتكم

189
00:16:57,510 --> 00:16:59,650
!أخي تشو والبقيّة يبدون رائعين

190
00:16:59,650 --> 00:17:02,680
.صحيح، كم هذا ظريف. تشبهون الحشرات

191
00:17:02,680 --> 00:17:04,180
!حشرات؟

192
00:17:04,180 --> 00:17:05,680
هــ-هذا ظريف...؟

193
00:17:05,930 --> 00:17:08,530
لماذا لا ترتدي درعًا أيضًا؟

194
00:17:08,530 --> 00:17:10,940
.كلاّ، سيُبطئ من سرعتي فحسب

195
00:17:10,940 --> 00:17:12,350
.ارتديه

196
00:17:12,810 --> 00:17:15,480
!بما أنّ مكافأتك منخفضة جدًّا

197
00:17:17,860 --> 00:17:19,150
!إنما

198
00:17:29,080 --> 00:17:32,060
!أتريد القتال؟! سأقتلك

199
00:17:32,060 --> 00:17:34,420
!جرّب ذلك أيّها الوغد

200
00:17:38,130 --> 00:17:40,210
!ما الّذي تفعلانه كلاكما؟

201
00:17:43,300 --> 00:17:47,570
قال أوروتشي أنّ الموسم شتاء
.في مدخل أونيغاشيما

202
00:17:47,570 --> 00:17:49,490
ماذا؟ أسيكون الجوّ باردًا؟

203
00:17:49,490 --> 00:17:52,190
ماذا تقصدين بـ"مدخل"؟

204
00:17:52,190 --> 00:17:56,240
يمتلك البرّ الرّئيسيّ لبلاد وانو مواسم
.مختلفة في مناطق مختلفة

205
00:17:56,240 --> 00:17:59,440
.إنّ الفرو يغطّينا، لذلك لا نمانع الطّقس البارد

206
00:17:59,440 --> 00:18:02,340
...صحيح، إنّ الطّقس أهمّ بكثير بالنّسبة لنا

207
00:18:02,340 --> 00:18:04,410
!من الموسم

208
00:18:04,410 --> 00:18:09,200
،يُفترض أن يكون القمر بدرًا ذلك اليوم
.لكن إن اختبأ خلف السّحب، فلا فائدة

209
00:18:09,200 --> 00:18:10,720
!صحيح

210
00:18:10,720 --> 00:18:14,750
،إن تحوّل كلّ المينك كما فعلت كاروت
!فسيساعدنا ذلك كثيرًا

211
00:18:23,090 --> 00:18:25,340
!غارتشو

212
00:18:25,930 --> 00:18:29,430
.لكن سيعتمد تحوّل سولونغ على الحظّ

213
00:18:29,430 --> 00:18:34,730
...من المهمّ أكثر تواجد السّيّد نيكوماموشي والحرّاس هنا

214
00:18:39,980 --> 00:18:41,570
ما الخطب يا لوفي؟

215
00:18:45,860 --> 00:18:47,740
...بيغ مام هنا

216
00:18:49,530 --> 00:18:52,170
!لكنّ جينبي لم يصل بعد

217
00:18:52,170 --> 00:18:56,040
!استطعنا الهروب من بيغ مام بفضله

218
00:18:58,130 --> 00:19:01,710
!سأكون في انتظارك في بلاد وانو
!تعال مهما كلّف الأمر

219
00:19:03,460 --> 00:19:05,190
!شكرًا لك

220
00:19:05,190 --> 00:19:07,090
!جينبي

221
00:19:07,800 --> 00:19:10,010
!إيّاك أن تموت مهما كان

222
00:19:16,270 --> 00:19:19,770
!كان عليه الانضمام إلينا بعد اهتمامه بأموره العالقة

223
00:19:29,820 --> 00:19:31,490
...إنّنا ممتنّون لتواجده معنا

224
00:19:31,490 --> 00:19:34,500
!ما زال أمامنا وقت... سيأتي

225
00:19:34,500 --> 00:19:36,750
.إن كان حيًّا

226
00:19:36,750 --> 00:19:38,580
!نعم، إنّه حيّ

227
00:19:40,460 --> 00:19:42,000
!سيأتي

228
00:19:44,260 --> 00:19:48,400
!تعالوا يا رفاق! أتى أوشيميتسو كوزو

229
00:19:48,400 --> 00:19:51,350
!لكن لا توجد أيّة أحاديث عن سرقات في العاصمة

230
00:19:51,350 --> 00:19:55,070
!إنّه الشّخص الوحيد القادر على هذا

231
00:19:55,070 --> 00:20:00,060
،لا يمكننا المشاركة في مهرجان النّار غدًا
!لكن لنشرب الماء بهذه

232
00:20:00,770 --> 00:20:03,690
!أحرقنا جبل قطّاع طرق الجبل

233
00:20:04,070 --> 00:20:07,150
،لكن بدل السّعي للانتقام

234
00:20:07,150 --> 00:20:11,200
!يواصلون سرقة أطنان من الطّعام من مزرعتنا

235
00:20:13,790 --> 00:20:17,600
!ألديكم علاقة ما بهذا الأمر؟

236
00:20:17,600 --> 00:20:19,370
!لا-لا نعرف أيّ شيء

237
00:20:19,670 --> 00:20:25,520
سمعتُ أنّ السّاموراي يستعدّون
!لشنّ غارة... أهذا هو السّبب يا ترى؟

238
00:20:25,520 --> 00:20:27,760
!إن كان كذلك، فلن نسمح لهم باكتشافه

239
00:20:28,880 --> 00:20:32,010
!ما الّذي تهمسان به؟

240
00:20:32,760 --> 00:20:35,100
!أنا سأرشدك

241
00:20:35,430 --> 00:20:38,390
!لذلك لا تلحق الأذى بأيّ أحد

242
00:20:38,390 --> 00:20:39,890
!أو-أوتسورو-سان

243
00:20:39,890 --> 00:20:41,520
سترشدينني؟

244
00:20:43,020 --> 00:20:45,320
هل تعرفين أيّ شيء حيال هذا؟

245
00:20:45,570 --> 00:20:48,780
.سترى بنفسك عندما تصل إلى هناك
...لكنّ المكان بعيد نوعًا ما

246
00:20:55,200 --> 00:20:59,810
!لا بدّ أنّك بحاجة لأطنان من الطّعام لأنّ حلفاءك كثر

247
00:20:59,810 --> 00:21:01,580
صحيح يا كين-سان؟

248
00:21:01,580 --> 00:21:04,710
أنت هنا في بلاد وانو، صحيح؟

249
00:21:05,340 --> 00:21:07,920
...تفاجأت كثيرًا عندما رأيت كيكونجو

250
00:21:11,010 --> 00:21:12,260
...كين-سان

251
00:21:12,840 --> 00:21:17,690
!كين-سان، دعني أتولّى هذا الأمر
!سأجذب انتباههم

252
00:21:17,690 --> 00:21:20,480
!لن أسمح لهم بالبحث عنكم

253
00:21:21,350 --> 00:21:25,940
!كين-سان... استردّ بلاد كوزكي

254
00:21:27,570 --> 00:21:31,200
!كلاّ يا أوتسورو-سان! ليس عليك أن تحمينا

255
00:21:31,490 --> 00:21:36,390
لا بأس الآن! أردنا فقط أن نأكل
!بقدر ما نشاء قبل موتنا

256
00:21:36,390 --> 00:21:37,540
ماذا؟

257
00:21:39,160 --> 00:21:41,660
!إذًا فأنتم الجناة

258
00:21:58,180 --> 00:22:00,430
...ثمّة قارب صغير

259
00:22:00,430 --> 00:22:01,890
.بإمكاننا استعماله

260
00:22:02,350 --> 00:22:06,410
!ما الّذي تفعله يا إينواراشي؟ توقّف

261
00:22:06,410 --> 00:22:08,670
!لنقم بهذا في يوم آخر يا كينييمون

262
00:22:08,670 --> 00:22:12,450
...ذلك ليس خيارًا متاحًا

263
00:22:17,620 --> 00:22:18,950
!كين-ساما

264
00:22:20,870 --> 00:22:22,910
!اتركيني يا شينوبو

265
00:22:25,420 --> 00:22:27,840
!كين-ساما، لا يمكننا القيام بهذا اللّيلة

266
00:22:28,290 --> 00:22:30,710
!بل علينا القيام به اللّيلة

267
00:22:31,170 --> 00:22:33,930
.تعرفين ذلك حقّ المعرفة يا شينوبو

268
00:22:42,930 --> 00:22:45,100
!لا بدّ أن يكون اللّيلة

269
00:22:50,980 --> 00:22:55,660
.ثمّة حادثة قد وقعت سلفًا في اللّيلة الماضية

270
00:23:04,410 --> 00:23:09,060
،انفجرت السّاني! جاهلين بسلامة لوفي والبقيّة

271
00:23:09,060 --> 00:23:13,010
!تحرّك ساموراي الأكازايا وكلمات سيّدهم تسكن قلوبهم

272
00:23:13,010 --> 00:23:17,190
.سلك بطل العصر أودن طريقه الخاصّ

273
00:23:17,190 --> 00:23:22,430
والآن، تتردّد طريقة عيشه
!كما تتطاير بتلات براعم الكرز

274
00:23:22,430 --> 00:23:23,930
:في الحلقة القادمة من وان بيس

275
00:23:23,930 --> 00:23:27,370
!السّاموراي الأوّل في بلاد وانو"
"!ها هو ذا كوزكي أودن

276
00:23:27,370 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا