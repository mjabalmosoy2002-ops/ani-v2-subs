1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,600 --> 00:02:03,890
"!مواجهة الأكازايا! كيكونوجو ضدّ كانجورو"

29
00:02:11,410 --> 00:02:12,920
...يا إلهي

30
00:02:13,410 --> 00:02:14,960
!بيغ مام؟

31
00:02:17,790 --> 00:02:21,170
.مرحبًا بعودتك يا زوس

32
00:02:21,170 --> 00:02:23,280
...ما... ما

33
00:02:23,280 --> 00:02:24,300
!ماما

34
00:02:27,380 --> 00:02:30,850
!تبدو مخيفة جدًّا عن قرب

35
00:02:30,850 --> 00:02:33,680
!إنّها أقوى شمطاء في العالم

36
00:02:38,610 --> 00:02:39,900
!زوس

37
00:02:40,980 --> 00:02:41,690
!نامي؟

38
00:02:42,250 --> 00:02:43,740
!أمسكوا بهم؟

39
00:02:45,200 --> 00:02:48,450
!أتيتِ أخيرًا يا لينلين

40
00:02:48,450 --> 00:02:51,080
!ما الّذي أخّرك؟

41
00:02:51,320 --> 00:02:54,810
!لا تكن متشدّدًا يا كايدو

42
00:02:54,810 --> 00:02:57,090
.وصلت في الوقت المناسب

43
00:03:02,250 --> 00:03:04,800
،كما قال كايدو

44
00:03:04,800 --> 00:03:09,640
!لقد شكّلنا تحالفًا لسبب وجيه

45
00:03:10,170 --> 00:03:11,760
سبب وجيه؟

46
00:03:11,760 --> 00:03:14,910
،إن كنّا على خصام دائمًا فيما بيننا
،فسيكون بعيدًا عن متناولنا

47
00:03:14,910 --> 00:03:18,480
!لكن إن وحّدنا جهودنا، فسيكون في متناولنا سلفًا

48
00:03:18,480 --> 00:03:20,900
!أهذا مفهوم؟

49
00:03:20,900 --> 00:03:24,510
!سنركّز على القرصنة

50
00:03:24,510 --> 00:03:26,740
...سوف نضع

51
00:03:26,740 --> 00:03:29,530
...أيدينا أخيرًا

52
00:03:32,240 --> 00:03:35,330
!على كنز وان بيس العظيم

53
00:03:41,710 --> 00:03:43,460
...الوان بيس

54
00:03:44,020 --> 00:03:46,970
!ذلك شيء أنا من سيحصل عليه

55
00:03:46,970 --> 00:03:49,130
!يا لهما من وغدين

56
00:03:50,550 --> 00:03:53,620
...إنّ وجود الأسلحة القديمة

57
00:03:53,620 --> 00:03:57,980
!سيجلب معه الخوف والحرب في هذا العالم

58
00:03:58,310 --> 00:04:00,310
!جهّزوا أنفسكم

59
00:04:00,310 --> 00:04:06,030
!ذلك هو عالم العنف الّذي نصبوا إليه

60
00:04:10,650 --> 00:04:12,570
...الأسلحة القديمة

61
00:04:12,570 --> 00:04:17,930
قيل أنّ ثلاثة منها موجودة
...وهي تحمل أسماء آلهة

62
00:04:17,930 --> 00:04:19,250
.بلوتون

63
00:04:20,580 --> 00:04:22,130
.أورانوس

64
00:04:23,410 --> 00:04:25,710
.بوسيدون

65
00:04:25,710 --> 00:04:32,470
إن حصلا على هذه القوّة، فسيفقد
.العالم توازنه وسيتّجه نحو دماره

66
00:04:33,010 --> 00:04:34,930
هل الأمر خطير لتلك الدّراجة؟

67
00:04:34,930 --> 00:04:36,390
.بكلّ تأكيد

68
00:04:39,270 --> 00:04:41,150
!هذا حماسيّ

69
00:04:42,730 --> 00:04:47,280
!لذلك استمعوا يا أتباع أوروتشي

70
00:04:48,320 --> 00:04:51,120
.عليكم أن تختاروا

71
00:04:53,030 --> 00:04:55,070
نختار ماذا؟

72
00:04:57,240 --> 00:04:59,330
...هذه البلاد

73
00:04:59,330 --> 00:05:03,480
،حصن طبيعيّ تحيط به الشّلاّلات

74
00:05:03,480 --> 00:05:07,320
وهو ما يمنع البحريّة وحكومة
.العالم من اقتحامها بسهولة

75
00:05:07,320 --> 00:05:10,300
،إن بنينا المزيد من مصانع الأسلحة

76
00:05:11,880 --> 00:05:15,780
،وأجبرنا حتّى سكّان عاصمة الزّهور على العمل

77
00:05:15,780 --> 00:05:21,890
،فسيصير هذا المكان أرضًا بلا قانون
!فردوسًا للقراصنة

78
00:05:29,610 --> 00:05:33,030
كايدو-ساما... ماذا تعني؟

79
00:05:33,030 --> 00:05:34,990
.أنا واثق أنّكم سمعتموني

80
00:05:37,280 --> 00:05:38,910
...أنت

81
00:05:41,240 --> 00:05:42,580
!أنت

82
00:05:42,580 --> 00:05:45,730
!أيّها الوغد كايدو

83
00:05:45,730 --> 00:05:49,530
!ما الّذي تتحدّث عنه؟

84
00:05:49,530 --> 00:05:53,550
!عاصمة الزّهور هي منطقتي أنا

85
00:05:54,170 --> 00:05:57,390
،فقط لأنّني من الكوروزومي

86
00:05:57,590 --> 00:06:01,270
...فهل تعلم... هل تعلم كم من الألم

87
00:06:01,350 --> 00:06:06,020
تسبّبت به عشيرة كوزكي لي طوال
!كلّ هذه السّنوات؟

88
00:06:06,560 --> 00:06:11,050
،لقد ظُلمتُ وكُرهتُ فقط لأنّني ما زلت حيًّا

89
00:06:11,050 --> 00:06:15,700
!وقد سلبوني كلّ شيء

90
00:06:18,780 --> 00:06:20,740
!الضّغينة ضدّ عشيرة كوزكي

91
00:06:20,740 --> 00:06:23,140
!وضدّ بلاد وانو

92
00:06:23,140 --> 00:06:26,870
...والرّغبة في الانتقام منهم جميعًا

93
00:06:26,870 --> 00:06:31,590
!ذلك ما كان يدفعني كلّ هذا الطّريق

94
00:06:32,750 --> 00:06:38,450
!بطريقة ما، عاصمة الزّهور هي رمز ثأر عشيرة كوروزومي

95
00:06:38,450 --> 00:06:41,700
...أراضيهم وحياتهم

96
00:06:41,700 --> 00:06:45,060
!كلّها لي أنا

97
00:06:46,140 --> 00:06:47,940
...حتّى أنت

98
00:06:47,940 --> 00:06:53,200
!لا يمكنك العبث بها كما يحلو لك

99
00:07:02,080 --> 00:07:04,040
!هل تسمعني؟

100
00:07:04,990 --> 00:07:10,980
سأجعل أشقياء عشيرة كوزكي
،الّذين عذّبوا عشيرة كوروزومي يركعون

101
00:07:10,980 --> 00:07:17,090
،ولمنعهم من التّمرّد عليّ
!سأستعرض الأهوال أمامهم

102
00:07:17,090 --> 00:07:22,100
!لأبد الآبدين

103
00:07:22,100 --> 00:07:24,950
!أنا من سيدمّر بلاد وانو

104
00:07:24,950 --> 00:07:28,580
!هذه البلاد لي

105
00:07:28,580 --> 00:07:32,610
!الزم حدودك يا كايدو

106
00:07:32,610 --> 00:07:35,070
!أنت هنا منذ وقت قصير فحسب

107
00:07:40,550 --> 00:07:45,200
!لا يمكن أن تتواجد بلاد وانو بدوني
!آمل أنك مدرك لذلك

108
00:07:50,580 --> 00:07:53,040
.أرى أنّك تفهم

109
00:07:53,040 --> 00:07:55,030
...ما علينا فعله الآن

110
00:07:55,030 --> 00:07:58,050
...هو قتل ذاك الشّقيّ هناك

111
00:08:38,500 --> 00:08:40,470
!لا أهتمّ

112
00:08:40,470 --> 00:08:43,590
!ما عدنا بحاجته

113
00:09:10,700 --> 00:09:12,420
!هراء

114
00:09:16,540 --> 00:09:18,800
...بالنّسبة لي

115
00:09:23,590 --> 00:09:25,260
...كلّ من عشيرة كوروزومي

116
00:09:25,760 --> 00:09:27,760
...وعشيرة كوزكي

117
00:09:30,980 --> 00:09:33,770
!لا يعنيان شيئًا

118
00:09:51,530 --> 00:09:52,580
!مومو

119
00:09:52,580 --> 00:09:55,000
!ذاك هو مومو

120
00:09:55,920 --> 00:09:57,790
!مومو، انتظرني

121
00:09:57,790 --> 00:09:59,420
!أنت، أخفض صوتك

122
00:10:04,380 --> 00:10:06,510
!ما هذا؟

123
00:10:06,510 --> 00:10:08,220
!ما الّذي حدث؟

124
00:10:10,470 --> 00:10:12,940
!كايدو

125
00:10:13,520 --> 00:10:15,730
!أيّها المغفّل! ما الّذي تفعله؟

126
00:10:16,270 --> 00:10:19,270
!اسمع! علينا أن ننقذ مومو

127
00:10:19,270 --> 00:10:20,860
!أرني الطّريق

128
00:10:20,860 --> 00:10:22,740
!حـ-حسنًا

129
00:10:23,730 --> 00:10:26,700
!ياماتو-ساما! توقّف رجاءً

130
00:10:28,070 --> 00:10:31,250
!أنا قادم إليك يا مومو

131
00:11:10,620 --> 00:11:11,240
!ماذا؟

132
00:11:20,330 --> 00:11:24,300
،أعلم عاداتك في المسايفة

133
00:11:24,710 --> 00:11:27,470
!لكنّك لا تعرفين تقنياتي، صحيح؟

134
00:11:54,450 --> 00:11:57,580
!اقضي عليه يا كيكو

135
00:12:02,540 --> 00:12:06,980
...أ-أوكيكو، أنا آسف

136
00:12:06,980 --> 00:12:13,450
...أستطيع العيش فقط كعضو من عشيرة كوروزومي

137
00:12:13,450 --> 00:12:16,440
!لذلك اقتليني بسرعة

138
00:12:17,390 --> 00:12:23,910
ما زلت أذكر الأيّام الّتي قضيناها
...معًا كالأشقّاء

139
00:12:23,910 --> 00:12:28,090
...كان العيش وأنا أخدعك

140
00:12:28,090 --> 00:12:31,400
!مؤلمًا لي على الدّوام

141
00:12:31,400 --> 00:12:38,020
أعتقد فعلاً أنّني قمت بأمور فظيعة
...لمومونوسكي-ساما أيضًا

142
00:12:38,020 --> 00:12:41,120
،وُلدت من عائلة كوروزومي

143
00:12:41,120 --> 00:12:44,800
...ولا يمكنني العيش إلاّ كذلك

144
00:12:45,710 --> 00:12:47,800
!سامحيني

145
00:12:48,630 --> 00:12:52,070
...أنا

146
00:12:52,590 --> 00:12:57,430
!أردت العيش جنبًا إلى جنب معكم يا رفاق

147
00:12:57,430 --> 00:12:59,640
!كيكو! قومي بذلك

148
00:13:00,850 --> 00:13:05,000
!كانجورو-سان... لم يفت الأوان بعد

149
00:13:05,310 --> 00:13:07,230
!لنطح بكايدو

150
00:13:07,230 --> 00:13:09,330
...كيف أمكنك

151
00:13:09,900 --> 00:13:12,620
...كيف أمكنك أن تصدّقي وغدًا مثلي

152
00:13:14,320 --> 00:13:16,280
...إنّك فعلاً

153
00:13:16,280 --> 00:13:17,750
!ساذجة

154
00:13:20,120 --> 00:13:22,040
!كيكو

155
00:13:24,920 --> 00:13:27,880
.أخبرني أنّ كلّ هذا كذب

156
00:13:28,500 --> 00:13:30,840
...أنّ كانجورو-سان هذا

157
00:13:31,800 --> 00:13:33,470
!مزيّف

158
00:13:33,470 --> 00:13:36,010
...أنّ كانجورو-سان الّذي أواجهه الآن

159
00:13:36,010 --> 00:13:38,180
!ما هو إلاّ متصنّع

160
00:13:39,100 --> 00:13:41,150
!أوكيكو

161
00:13:41,810 --> 00:13:42,640
!هيّا

162
00:13:42,640 --> 00:13:44,650
!ما الّذي تفعلينه؟

163
00:13:44,650 --> 00:13:48,730
!كيف تجرئين على قطعي بدم بارد وأنا كأخ لك؟

164
00:13:49,230 --> 00:13:54,070
!هذه الخيانة مؤلمة للغاية
!سأجعلك تدفعين الثّمن

165
00:13:54,070 --> 00:13:55,110
!أنت الخائن

166
00:13:55,110 --> 00:13:58,410
!أين يقبع قلبك الحقيقيّ؟

167
00:13:58,410 --> 00:14:01,950
!من تكون أنت؟

168
00:14:05,040 --> 00:14:11,280
كانجورو-سان الّذي ضحك وبكى
...معنا في تلك الأيّام

169
00:14:11,280 --> 00:14:12,970
!أعده لنا

170
00:14:15,130 --> 00:14:18,480
!ماذا؟! مستحيل

171
00:14:18,480 --> 00:14:23,430
...ظننتُ أنّنا سنكون أصدقاء مهما كان

172
00:14:23,430 --> 00:14:26,650
!لم أصدّق ذلك من الأساس

173
00:14:26,650 --> 00:14:29,690
!ما أمامك الآن هو أنا على حقيقتي

174
00:14:29,690 --> 00:14:31,440
...حياتي كعضو من الأكازايا

175
00:14:31,440 --> 00:14:33,780
!كانت مجرّد تمثيل

176
00:14:33,780 --> 00:14:37,740
!لم أتشارك أيّ أفراح أو أحزان معكم

177
00:14:38,200 --> 00:14:41,700
!لا أهتمّ إطلاقًا لكم

178
00:14:41,700 --> 00:14:44,000
!قمتُ بكلّ شيء من أجل عشيرة كوروزومي

179
00:14:44,000 --> 00:14:44,960
!فموتي

180
00:14:49,000 --> 00:14:52,130
!انظروا لهذا

181
00:14:52,130 --> 00:14:55,680
!هذا العرض المذهل الضّخم

182
00:14:57,760 --> 00:15:00,380
...كان كلّ شيء مزيّفًا

183
00:15:00,800 --> 00:15:03,460
...كلّ حياتك كانت تمثيلاً

184
00:15:04,020 --> 00:15:08,560
...عشتَ مؤدّيًا دورك فحسب

185
00:15:11,400 --> 00:15:13,440
!لم تكن حياتي مزيّفة

186
00:15:13,440 --> 00:15:17,970
...بل كنت أعيش لأداء دوري طوال حياتي

187
00:15:18,450 --> 00:15:21,870
،إن كنت قد أثرت عاطفتك

188
00:15:21,870 --> 00:15:24,200
!فأنا أشعر بالفخر لأنّني ممثّل جيّد

189
00:15:26,660 --> 00:15:27,750
!ماذا؟

190
00:15:36,550 --> 00:15:38,180
...لقد قطعتُ

191
00:15:38,180 --> 00:15:41,970
!قلبي أنا الّذي كان يحاول تصديقك

192
00:15:42,390 --> 00:15:45,400
!انتهت هذه المهزلة

193
00:15:46,680 --> 00:15:50,900
.كنتُ أتمنّى لو قلتَ أنّ خيانتك كانت تمثيلاً

194
00:15:51,440 --> 00:15:56,410
...لن نتمكّن أبدًا من رؤية كانجورو-سان الّذي عهدناه

195
00:15:57,900 --> 00:16:01,530
...الأفراح والأحزان الّتي تشاركناها

196
00:16:01,530 --> 00:16:03,480
!كانت مجرّد وهم

197
00:16:03,950 --> 00:16:06,750
...كانجرو-سان الّذي عرفتُه

198
00:16:06,750 --> 00:16:08,330
!كان مجرّد رسمة

199
00:16:08,830 --> 00:16:11,250
.ليس لديك أيّ أحد لتودّعه

200
00:16:12,130 --> 00:16:13,630
...في تلك الحالة

201
00:16:13,630 --> 00:16:16,050
!في تلك الحالة، لن أرحمك

202
00:16:18,300 --> 00:16:21,340
!ممتاز! هذا تغيّر أحداث غير متوقّع

203
00:16:29,100 --> 00:16:31,310
!سيف الثّلج المتساقط

204
00:16:38,070 --> 00:16:40,490
!بإمكاني توقّع كلّ حركاتك

205
00:16:45,240 --> 00:16:47,660
!هذه حركة بسيطة

206
00:16:47,660 --> 00:16:52,170
!أوكيكو، ما زلت طيّبة كعادتك

207
00:16:53,290 --> 00:16:56,590
!الرّجل الّذي أمامي ليس كانجورو

208
00:16:57,130 --> 00:16:58,920
...كانجورو-سان

209
00:16:58,920 --> 00:17:00,300
!ما عاد موجودًا

210
00:17:02,130 --> 00:17:04,010
!لماذا؟

211
00:17:05,890 --> 00:17:07,640
!لماذا؟

212
00:17:08,020 --> 00:17:10,730
!قلتَ أنّ كلّ شيء كان تمثيلاً

213
00:17:11,600 --> 00:17:13,850
!ظننت أنّنا أصدقاء

214
00:17:13,850 --> 00:17:16,900
!أخبرني يا كانجورو

215
00:17:17,650 --> 00:17:20,900
!لماذا؟

216
00:17:30,700 --> 00:17:32,750
...ممتاز

217
00:17:32,750 --> 00:17:37,000
!ممتاز! أحسنت يا أوكيكو

218
00:17:37,000 --> 00:17:39,300
....كنتُ أبحث عن

219
00:17:39,300 --> 00:17:41,920
!مكان لأموت فيه

220
00:17:43,720 --> 00:17:45,090
...إن

221
00:17:45,840 --> 00:17:46,600
...أمكنني

222
00:17:47,430 --> 00:17:50,720
،الموت على مسرح ضخم

223
00:17:51,560 --> 00:17:54,020
!فسأكون بغاية السّعادة

224
00:17:57,110 --> 00:17:58,360
!هذا مثاليّ

225
00:18:00,570 --> 00:18:02,110
!جيّد

226
00:18:02,110 --> 00:18:04,320
...يراودني شعور

227
00:18:04,320 --> 00:18:05,910
!رائع

228
00:18:35,480 --> 00:18:37,020
...كين-سان

229
00:18:37,310 --> 00:18:39,860
.نعم. لنذهب

230
00:18:39,860 --> 00:18:43,070
!كينييمون-دونو! دنجيرو-دونو

231
00:18:43,070 --> 00:18:44,530
!بالتّوفيق

232
00:18:45,110 --> 00:18:46,570
!ولكم أيضًا

233
00:19:18,520 --> 00:19:21,230
!ليس من العدل مهاجمتي من الخلف

234
00:19:21,230 --> 00:19:24,690
!يا كاواماتسو! تلك فرشاتي

235
00:19:24,690 --> 00:19:26,240
!مهلاً، مهلاً

236
00:19:26,240 --> 00:19:28,700
!كونوا لطفاء مع بعضكم

237
00:19:31,830 --> 00:19:34,240
!لا مال لدينا يا أودن-ساما

238
00:19:34,240 --> 00:19:35,200
!ماذا؟

239
00:19:35,580 --> 00:19:37,920
!ولا طعام لدينا للعشاء

240
00:19:37,920 --> 00:19:40,290
!لا عشاء اليوم أيضًا يا أودن-ساما؟

241
00:19:40,290 --> 00:19:42,630
!هيّا سامحني

242
00:19:42,630 --> 00:19:47,090
!حسنًا، لديكم عمل لتقوموا به
!توسّلوا من أجل الطّعام في البلدة

243
00:19:47,090 --> 00:19:48,010
!ثانية؟

244
00:19:48,010 --> 00:19:51,220
!لم أسمع دايميو يقول ذلك من قبل

245
00:19:51,220 --> 00:19:53,890
.معك حقّ. ولا أنا

246
00:20:14,660 --> 00:20:17,040
.اسمي كانجورو

247
00:20:17,370 --> 00:20:19,960
!اسمي كينييمون! سررت بلقائك

248
00:20:20,420 --> 00:20:24,630
.نحبّ كلانا أودن-سان، لذلك سنكون على وفاق

249
00:20:26,050 --> 00:20:28,380
!نعم، يبدو ذلك جيّدًا

250
00:20:29,800 --> 00:20:33,390
.لا بدّ أنّه كان أمرًا صعبًا يا رفاق

251
00:20:34,260 --> 00:20:35,850
...كين-سان

252
00:20:38,600 --> 00:20:41,230
.لنواصل التّقدّم للأمام الآن

253
00:20:41,810 --> 00:20:43,400
...إيزو

254
00:20:49,360 --> 00:20:53,070
ألا بأس أن تموت هنا؟

255
00:20:53,070 --> 00:20:56,450
.لا أريد أن أفوّت فرصة أخرى للموت

256
00:20:58,620 --> 00:21:00,660
.حسنًا. هيّا بنا

257
00:21:04,080 --> 00:21:05,420
.أوكيكو

258
00:21:35,320 --> 00:21:38,700
.وها قد ماتت الذّبابة الّتي كانت منجذبة للقراصنة

259
00:21:38,700 --> 00:21:43,460
!قرّروا ما العمل خلال خمس ثوانٍ يا رجال أوروتشي

260
00:21:43,790 --> 00:21:47,420
أتريدون أن تصيروا قراصنة وتتبعوني؟

261
00:21:47,420 --> 00:21:51,130
!أم تريدون أن تتحدّونا هنا وتموتون؟

262
00:21:51,590 --> 00:21:55,390
،بغرض الاستعداد للحرب العالميّة القادمة

263
00:21:55,390 --> 00:22:00,180
!سأحوّل هذه البلاد إلى إمبراطوريّة قراصنة

264
00:22:02,020 --> 00:22:05,600
.سنخرج في استكشافات أكثر من أجل أعمالنا الأساسيّة

265
00:22:06,480 --> 00:22:07,400
،لذلك فاللّيلة

266
00:22:07,400 --> 00:22:10,780
،سننقل أونيغاشيما هذه إلى عاصمة الزّهور

267
00:22:10,780 --> 00:22:13,030
!وستسقط بلاد وانو

268
00:22:13,700 --> 00:22:15,410
!ذلك الوغد

269
00:22:15,410 --> 00:22:18,870
.سأعيد تسمية هذه البلاد بأونيغاشيما الجديدة

270
00:22:18,870 --> 00:22:21,950
...والشّوغن الجديد لها هو ابني

271
00:22:21,950 --> 00:22:24,000
!ياماتو

272
00:22:27,040 --> 00:22:28,920
...ما الّذي

273
00:22:30,050 --> 00:22:34,050
!قاله للتّوّ؟

274
00:22:40,430 --> 00:22:42,470
!لا يمكنك إجباري على ذلك

275
00:22:42,930 --> 00:22:45,230
!أيّها الأب الفظيع

276
00:22:45,690 --> 00:22:48,400
!بسرعة! سيُقتل مومو هكذا

277
00:22:48,400 --> 00:22:50,150
!حسنًا! لنأخذ طريقًا مختصرًا

278
00:22:50,150 --> 00:22:50,940
!حسنًا

279
00:23:04,120 --> 00:23:09,840
بعد 20 سنة من اليأس، يتقدّم الأكازايا
!التّسعة للهجوم مطيحين بالأعداء

280
00:23:09,840 --> 00:23:11,960
!الهدف هو عدوّهم اللّدود كايدو

281
00:23:11,960 --> 00:23:14,710
ومومونوسكي الّذي يرتعد وهو على
.وشك أن يُعدم يواجه قرارًا صعبًا

282
00:23:14,710 --> 00:23:19,220
،ومن أجل بلاد وانو وعشيرة كوزكي
!أقسموا بالأرض والسّماء

283
00:23:19,220 --> 00:23:21,930
!راهنوا بحياتكم على هذه الضّربة

284
00:23:22,560 --> 00:23:26,690
:في الحلقة القادمة من وان بيس
"!غارة! إرادة أودن الموروثة"

285
00:23:26,690 --> 00:23:30,480
!ملك القراصنة، لن يكون إلاّ أنا