1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,480 --> 00:02:27,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:30,970 --> 00:02:33,340
!هذا صحيح! فهمت

33
00:02:33,340 --> 00:02:34,140
ماذا؟

34
00:02:34,540 --> 00:02:38,680
،بإمكاننا إنقاذها... ما دمت معكم
!بإمكاننا إنقاذ روبين! اللّعنة

35
00:02:38,680 --> 00:02:41,610
!اللّعنة"؟! ليس عليك أن تغضب أو ما شابه"

36
00:02:41,610 --> 00:02:42,610
!لنسرع يا نامي-كُن

37
00:02:43,350 --> 00:02:46,030
.لا تجعليني أكرّر كلامي

38
00:02:47,040 --> 00:02:51,200
.لم يتبقّ ولو حتّى بصيص أمل لك

39
00:02:51,200 --> 00:02:53,650
،سمعتُ صوتًا ما في الممرّ قبل قليل

40
00:02:53,650 --> 00:02:56,210
لكن لم يظهر أيّ أحد بعدها، صحيح؟

41
00:02:56,210 --> 00:03:00,380
لا بدّ أنّ لوتشي يقتله الآن، أسمعتِ؟

42
00:03:00,870 --> 00:03:03,140
.يبدو أنّنا على خلاف

43
00:03:03,140 --> 00:03:05,170
.أعتقد أنّه لا طائل من مناقشة الأمر

44
00:03:05,540 --> 00:03:07,270
.ليس لديّ وقت كثير أيضًا

45
00:03:07,270 --> 00:03:10,050
!فاكهة المطّاط... المدفع الرّشّاش

46
00:03:10,500 --> 00:03:11,740
!الطّابع

47
00:03:11,740 --> 00:03:12,470
!السّوط

48
00:03:13,470 --> 00:03:14,670
!الرّمح

49
00:03:25,030 --> 00:03:28,860
أنا ذئب. سأواصل السّعي خلفك
.إلى أن أغرس أنيابي فيك

50
00:03:34,110 --> 00:03:35,970
.ماذا؟ ما زلت حيًّا

51
00:03:36,510 --> 00:03:41,170
...لا أنوي الهرب... لا أنوي أن أُقتل

52
00:03:44,710 --> 00:03:46,050
.ولا أنوي أن أسامح أيضًا

53
00:03:46,050 --> 00:03:47,610
تسامح؟

54
00:03:49,980 --> 00:03:52,300
هل تتعاطف مع نيكو روبين؟

55
00:03:53,080 --> 00:03:56,970
.إنّ العقل المشتّت يخلق ثغرات خلال القتال

56
00:03:56,970 --> 00:04:00,310
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

57
00:04:00,310 --> 00:04:03,880
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

58
00:04:04,430 --> 00:04:06,150
.انتبه لكلامك

59
00:04:08,610 --> 00:04:12,160
.أنا من النّوع الّذي يشتعل غضبًا

60
00:04:20,910 --> 00:04:25,170
.قوّتها المدمّرة تشبه قوّة شيطان

61
00:04:26,100 --> 00:04:27,840
!ساق الشّيطان

62
00:04:27,840 --> 00:04:29,800
!ماذا؟ مـ-مهلاً

63
00:04:29,800 --> 00:04:31,760
...ركلة

64
00:04:36,810 --> 00:04:38,020
!اللّهب

65
00:04:49,600 --> 00:04:51,990
...يخلق الإله الطّعام

66
00:04:53,570 --> 00:04:56,410
.والشّيطان التّوابل

67
00:04:59,270 --> 00:05:02,680
.أعتقد أنّني أضفت الكثير من التّوابل

68
00:05:06,600 --> 00:05:12,320
هجوم السّيف الأبيض! زورو ضدّ"
"!كاكو في نزال سيوف قويّ قاطع

69
00:05:22,520 --> 00:05:24,480
!قاطع الغول

70
00:05:34,530 --> 00:05:37,490
!يا للهول! ذلك الزّرافة اللّعين ورأس الطّحلب

71
00:05:37,490 --> 00:05:39,570
هل يحاولان تدمير هذا البرج؟

72
00:05:50,230 --> 00:05:51,600
...هذه

73
00:05:52,920 --> 00:05:54,330
بوّابات العدالة؟

74
00:05:55,000 --> 00:05:56,890
بإمكاني الوصول إلى هناك
باتّباعي لهذه الإرشادات؟

75
00:05:59,810 --> 00:06:03,170
أتمنّى أن تكون نامي-سان متّجهة
.إلى روبين-تشان سلفًا مع أوسوبّ الآن

76
00:06:07,620 --> 00:06:10,650
عليّ الإسراع أيضًا وإحضار
.المفتاح رقم 1 إليها

77
00:06:13,400 --> 00:06:14,470
!من الأفضل أن أنطلق

78
00:06:20,710 --> 00:06:22,500
!أسرعي أيّتها الحقيرة

79
00:06:31,520 --> 00:06:34,800
!"وصلنا أخيرًا إلى "جسر التّردّد

80
00:06:37,750 --> 00:06:39,720
!انظري يا نيكو روبين

81
00:06:49,550 --> 00:06:53,440
بإمكانك رؤية بوّابات العدالة المفتوحة، صحيح؟

82
00:06:58,360 --> 00:07:02,200
.أخذ هذا وقتًا طويلاً... وقتًا طويلاً بالفعل

83
00:07:02,200 --> 00:07:03,940
.لكنّني وصلت أخيرًا

84
00:07:03,940 --> 00:07:07,040
،بمجرّد أن أعبر هذه البوّابات
...فيمكنني أن أكون للحكومةِ

85
00:07:07,040 --> 00:07:10,750
!كلاّ، بل للعالم بأسره بطلاً

86
00:07:14,570 --> 00:07:19,220
إنّ الجسر الّذي يمتدّ حتّى الجانب الآخر
،من البوّابات قد ارتفع بالفعل

87
00:07:19,220 --> 00:07:22,170
.وهو الآن ينتظر البطل ليأتي ويعبره

88
00:07:29,920 --> 00:07:35,650
كم هذا رائع! انظري إلى الطّريق
!المؤدّي إلى مستقبلي المشرق

89
00:07:37,600 --> 00:07:41,820
حسنًا، إنّه طريق نحو الجحيم بالنّسبة لك، صحيح؟

90
00:07:42,170 --> 00:07:46,870
ألا تظنّين ذلك يا نيكو روبين؟

91
00:07:52,920 --> 00:07:53,960
!كلاّ

92
00:07:53,960 --> 00:07:54,920
!ما الّذي تفعلينه يا هذه؟

93
00:07:56,460 --> 00:07:57,410
!هذا مؤلم

94
00:08:00,380 --> 00:08:02,220
!أنتِ! انتظري

95
00:08:04,720 --> 00:08:08,430
!حقيرة... هذا يكفي

96
00:08:08,830 --> 00:08:13,390
!ما زلتِ لا تدركين الأمر؟
!لا فائدة من المحاولة والمقاومة

97
00:08:13,390 --> 00:08:17,240
!هل تدركين من أكون بالفعل؟

98
00:08:17,570 --> 00:08:21,200
أنا بطل العالم. أنا بطل
!العالم، أهذا مفهوم؟

99
00:08:21,610 --> 00:08:26,630
أنت في أسوأ وضع بلا أيّ
!بصيص أمل! أنا مختلف عنك

100
00:08:26,630 --> 00:08:31,920
!لديّ مستقبل مشرق مليء بالآمال والأحلام

101
00:08:32,370 --> 00:08:34,630
!أتفهمين أيّتها المرأة الغبيّة؟

102
00:08:35,210 --> 00:08:38,320
!غبيّة! غبيّة! غبيّة

103
00:08:46,940 --> 00:08:48,510
...لوفي

104
00:08:48,510 --> 00:08:49,230
...رفاق

105
00:08:50,070 --> 00:08:51,280
!...يا رفاق

106
00:08:56,650 --> 00:08:58,280
!عليّ الإسراع! عليّ الإسراع

107
00:08:58,280 --> 00:09:00,530
لن يكون هنالك طائل
!من كلّ هذا إن تأخّرت

108
00:09:01,280 --> 00:09:02,840
!بإمكاني رؤية شيء ما أمامي

109
00:09:08,290 --> 00:09:10,960
!سنصل إلى وجهتنا حوال عشر دقائق

110
00:09:11,790 --> 00:09:14,660
!أسرعوا وتحقّقوا من تشكيلة كلّ السّفن

111
00:09:14,660 --> 00:09:15,920
!حاضر

112
00:09:16,470 --> 00:09:20,210
!يا هذه! قفي بسرعة يا حقيرة

113
00:09:20,210 --> 00:09:23,220
!هيّا بنا يا نيكو روبين

114
00:09:26,890 --> 00:09:28,760
!أهذا هو المخرج؟

115
00:09:35,680 --> 00:09:37,610
!يا قبّعة القشّ

116
00:09:38,050 --> 00:09:39,860
!هذا أنت يا فرانكي

117
00:09:39,860 --> 00:09:42,050
!ما الّذي تفعله هنا أيّها الوغد؟

118
00:09:42,050 --> 00:09:45,240
!مغفّل! كفّ عن تصرّفاتك هذه

119
00:09:45,660 --> 00:09:47,700
!أنا في صفّكم الآن! كفّ عن ذلك فحسب

120
00:09:50,690 --> 00:09:54,000
لوتشي إذًا؟ إذًا فأنت تواجه
وقتًا عصيبًا ضدّه؟

121
00:09:54,500 --> 00:09:57,960
.أين هي نيكو روبين؟ أحضرت مفتاحين معي

122
00:09:58,380 --> 00:09:59,500
هل أساعدك؟

123
00:09:59,500 --> 00:10:01,670
...لا. الأهمّ من ذلك

124
00:10:02,260 --> 00:10:04,370
.أوقف روبين أرجوك

125
00:10:06,390 --> 00:10:10,370
بإمكانك الذّهاب لبوّابات العدالة
.عبر ذلك الباب خلف رجل الحمامة

126
00:10:10,370 --> 00:10:12,430
.أُخذت روبين إلى هناك سلفًا

127
00:10:13,130 --> 00:10:15,850
.سأقوم أنا بإيقافه

128
00:10:17,640 --> 00:10:20,270
!سأدع الأمر لك بشكل خارق أيّها الوغد

129
00:10:35,960 --> 00:10:40,750
،أقول أنّه لو كان الخيار لي
!فأنا أفضّل اللّحم أكثر

130
00:10:42,610 --> 00:10:46,010
!وأنا أقول أنّ ذلك ليس مهمًّا أيّها العاشب

131
00:10:49,150 --> 00:10:51,680
.على أيّ حال، سأسرع وآخذ مفتاحك

132
00:10:52,670 --> 00:10:55,100
،إن لم أنجح في الوقت المناسب
.فستكون تلك أشبه بالهزيمة

133
00:10:58,300 --> 00:11:01,480
...أسلوب السّيفين: القاطعان

134
00:11:06,650 --> 00:11:09,950
تصبح أقوى عندما ترتدي
منشفة على رأسك؟

135
00:11:10,380 --> 00:11:11,490
ومن يدري...؟

136
00:11:15,410 --> 00:11:17,110
!تسلّق البرج

137
00:11:19,930 --> 00:11:22,010
!ردّ تسلّق البرج

138
00:11:25,380 --> 00:11:26,800
!وميض

139
00:11:28,300 --> 00:11:30,010
!تموّج

140
00:11:30,410 --> 00:11:32,810
.إن قفزتَ، فستصبح لك نقاطًا عمياء

141
00:11:32,810 --> 00:11:34,180
!منجل الزّرافة

142
00:11:44,130 --> 00:11:46,330
.الجسد الحديديّ: لا نقاط عمياء

143
00:11:48,270 --> 00:11:49,200
!ماذا؟

144
00:11:59,430 --> 00:12:02,640
.أصبحتُ مكعّبًا بلا نقاط عمياء

145
00:12:03,370 --> 00:12:05,590
!اخرس! ما الّذي تفعله؟

146
00:12:06,720 --> 00:12:08,090
.يا لسذاجتك

147
00:12:08,090 --> 00:12:10,370
ألم تلاحظ...؟

148
00:12:10,370 --> 00:12:11,470
ماذا؟

149
00:12:12,490 --> 00:12:16,500
.للزّرافات أربعة قوائم

150
00:12:17,470 --> 00:12:18,330
!ساق العاصفة

151
00:12:18,900 --> 00:12:21,290
!هل ستقاتلني أم لا يا هذا؟

152
00:12:21,290 --> 00:12:24,690
إلى أين تنظر؟
.بدأت هجماتي بالفعل

153
00:12:27,150 --> 00:12:29,860
...الهجمات القاطعة الّتي وجّهتها للأعلى

154
00:12:29,860 --> 00:12:32,160
...سترتدّ عن السّقف

155
00:12:32,160 --> 00:12:33,700
!وستنهال عليك

156
00:12:35,460 --> 00:12:36,850
!زخّات الزّرافة

157
00:12:42,050 --> 00:12:43,490
!الجسد الحديديّ

158
00:12:50,690 --> 00:12:52,540
...إنّه وابل من الهجمات القاطعة

159
00:12:52,540 --> 00:12:54,550
!سُحقًا! لا يمكنني صدّها

160
00:13:13,820 --> 00:13:15,030
!مسدّس الأنف

161
00:13:40,550 --> 00:13:41,980
!...أيّها الوغد

162
00:13:42,710 --> 00:13:44,790
.يا لك من رجل قويّ

163
00:13:44,790 --> 00:13:46,520
.أنا مندهش

164
00:13:47,720 --> 00:13:50,570
!لقد درّبت جسدي أيّها الجرّافة اللّعين

165
00:13:51,000 --> 00:13:53,710
جرّافة؟ أنا زرافة؟

166
00:13:53,710 --> 00:13:55,280
.جرّافة

167
00:13:55,280 --> 00:13:58,200
!هذا خطأ! لستُ جرّافة

168
00:14:00,350 --> 00:14:01,460
!اخرس

169
00:14:02,040 --> 00:14:04,500
...جرّافة... زرافة

170
00:14:04,910 --> 00:14:08,590
!كفاك ثرثرة... لا أهتمّ لذلك مطلقًا

171
00:14:09,850 --> 00:14:13,300
.إن كنت تسخر منّي، فستدفع الثّمن

172
00:14:13,620 --> 00:14:18,470
نفس الأمر ينطبق عليك. استعدّ
.لأنّ وقت اللّعب قد انتهى

173
00:14:18,990 --> 00:14:23,010
!أوّلاً، سأحطّم... ذلك الجسد الحديديّ

174
00:14:43,300 --> 00:14:45,660
.إنّك تقول أشياء مضحكة بالفعل

175
00:14:46,190 --> 00:14:48,670
ستحطّم جسدي الحديدي؟

176
00:14:49,220 --> 00:14:51,150
أتظنّ أنّك قادر على ذلك؟

177
00:14:51,980 --> 00:14:53,910
.نعم، بكلّ تأكيد

178
00:14:55,000 --> 00:14:56,840
أتريدني أن أجرّب؟

179
00:15:00,180 --> 00:15:03,720
،أسلوب السّيف الواحد
...فنّ إياي

180
00:15:08,010 --> 00:15:09,610
!أنشودة الأسد

181
00:15:10,680 --> 00:15:11,480
!ساق العاصفة

182
00:15:13,580 --> 00:15:14,880
!تقطيع التّنّين

183
00:15:19,600 --> 00:15:21,740
هل كنت لتنجح في التّقطيع لو كان حديدًا؟

184
00:15:22,380 --> 00:15:26,500
إنّه قراري إن كنت أريد استعمال الجسد
.الحديديّ أم لا للتّصدّي لهجومك

185
00:15:29,660 --> 00:15:33,840
.فهمت. أظنّ أنّ الأمر ليس بتلك البساطة

186
00:15:37,890 --> 00:15:39,220
!غوريلاّ واحدة

187
00:15:39,620 --> 00:15:40,930
!غوريلّتان

188
00:15:41,310 --> 00:15:43,130
!والآن، هلمّ إليّ

189
00:15:45,680 --> 00:15:47,390
...أسلوب السّيوف الثّلاثة

190
00:15:47,770 --> 00:15:50,120
أهي مسابقة قوّة الآن؟

191
00:15:50,900 --> 00:15:52,820
.كم هذا مثير للاهتمام

192
00:15:52,820 --> 00:15:54,150
!مسدّس الأنف

193
00:15:55,280 --> 00:15:56,610
!تقطيع الغوريلّتان القويّ

194
00:16:03,970 --> 00:16:05,830
!...يا لها من قوّة

195
00:16:17,390 --> 00:16:20,020
.إنّك تتحدّث بتعجرف

196
00:16:20,020 --> 00:16:24,680
إنّك من النّوع الّذي يعجز حتّى عن
تخيّل نفسه أنّه قد يُهزم، صحيح؟

197
00:16:29,370 --> 00:16:30,940
!يا لتكبّرك

198
00:16:31,380 --> 00:16:33,210
!وكذلك أنت

199
00:16:37,480 --> 00:16:41,570
!فاكهة المطّاط: المدفع الرّشّاش

200
00:16:41,950 --> 00:16:42,930
.فنّ الورق

201
00:16:48,050 --> 00:16:50,770
!فاكهة المطّاط: المسدّس

202
00:16:50,770 --> 00:16:51,460
!انتقال آنيّ

203
00:17:03,130 --> 00:17:04,160
!يا قبّعة القشّ

204
00:17:04,850 --> 00:17:05,720
!تبًّا

205
00:17:06,600 --> 00:17:07,720
!ساق العاصفة

206
00:17:16,440 --> 00:17:18,320
!سلاح اليُسرى

207
00:17:19,570 --> 00:17:20,190
!انتقال آنيّ

208
00:17:21,850 --> 00:17:22,700
!ماذا؟

209
00:17:23,230 --> 00:17:26,030
!فاكهة المطّاط: الصّاروخ

210
00:17:30,130 --> 00:17:30,690
!ماذا؟

211
00:17:30,690 --> 00:17:34,240
!فاكهة المطّاط: البازوكا

212
00:17:37,030 --> 00:17:38,300
!يا قبّعة القشّ

213
00:17:38,300 --> 00:17:40,800
!حسنًا، ابق كما أنت ولا تتحرّك

214
00:17:40,800 --> 00:17:41,740
!انتظر

215
00:17:42,420 --> 00:17:45,900
.لا تضيّع وقتك على هذا الرّجل
!اذهب فحسب

216
00:17:45,900 --> 00:17:48,060
قلت لك أنّني سأقوم بإيقافه، صحيح؟

217
00:17:48,060 --> 00:17:51,150
توقفه؟! لكن بالكاد تستطيع
!الوقوف في وجهه

218
00:17:51,150 --> 00:17:53,130
...علينا العمل معًا لكي

219
00:17:53,130 --> 00:17:53,980
!فرانكي

220
00:17:54,620 --> 00:17:58,360
.إنّه خصمي أنا! أنا من عليه إيقافه

221
00:17:58,870 --> 00:18:02,800
.سأكرّر كلامي مرّة واحدة
!أسرع وأنقذ روبين

222
00:18:02,800 --> 00:18:04,320
!وأوقفها

223
00:18:05,180 --> 00:18:07,430
!وإلاّ رحلت عنّا للأبد

224
00:18:08,780 --> 00:18:10,870
!لن نستطيع استعادتها حينها

225
00:18:12,450 --> 00:18:13,790
...إنّك

226
00:18:14,620 --> 00:18:17,500
!توقّف! أيّها القطار البحريّ

227
00:18:17,990 --> 00:18:21,330
!أعد توم-سان لنا

228
00:18:24,450 --> 00:18:25,630
.ذلك غير ممكن

229
00:18:28,680 --> 00:18:29,430
.لن أسمح لك بالذّهاب

230
00:18:31,720 --> 00:18:33,260
!يا قبّعة القشّ

231
00:18:33,260 --> 00:18:34,430
!أسرع

232
00:18:34,840 --> 00:18:36,440
!اذهب

233
00:18:37,330 --> 00:18:38,990
...إنّك

234
00:18:40,660 --> 00:18:41,530
!مفهوم

235
00:18:42,280 --> 00:18:43,570
...أظنّني قلت أنّي لن أسمح لك

236
00:18:44,290 --> 00:18:46,030
!بالذّهاب

237
00:18:47,190 --> 00:18:47,990
!مشية القمر

238
00:18:50,550 --> 00:18:51,240
!انتقال آنيّ

239
00:18:53,250 --> 00:18:54,580
!ما-ماذا؟

240
00:18:55,480 --> 00:18:56,290
!مسدّس الإصبع

241
00:19:04,240 --> 00:19:05,880
...وأظنّني أخبرتك أيضًا

242
00:19:06,380 --> 00:19:09,080
!أنّني خصمك

243
00:19:11,740 --> 00:19:13,990
...ما زلت لم أرك بعد

244
00:19:14,880 --> 00:19:18,070
!قوّة الزّرافة الحقيقيّة الجامحة

245
00:19:18,070 --> 00:19:20,480
.كفاك كلامًا! أرني فحسب

246
00:19:21,110 --> 00:19:22,960
!بكلّ تأكيد

247
00:19:23,810 --> 00:19:26,610
!أمعن النّظر إلى قوّة الزّرافة

248
00:19:29,890 --> 00:19:31,510
!مدفع الزّرافة

249
00:19:32,530 --> 00:19:34,540
.لا وجود لزرافة هكذا

250
00:19:34,540 --> 00:19:36,790
!مسدّس الأنف الأقصى

251
00:19:37,620 --> 00:19:39,210
!برج إطلاق الزّرافة

252
00:19:39,990 --> 00:19:41,080
!امتدّ؟

253
00:19:42,060 --> 00:19:43,990
أرأيت؟ ألم أخبرك بهذا؟

254
00:19:43,990 --> 00:19:46,230
.عنقك الطّويل هذا هو نقطة ضعفك

255
00:19:46,230 --> 00:19:48,050
.ذلك ليس صحيحًا تمامًا

256
00:19:48,050 --> 00:19:48,880
!ساق العاصفة

257
00:19:48,880 --> 00:19:50,260
!السّيف الأبيض الدّوّار

258
00:19:56,810 --> 00:19:59,310
.أنت من لديه ثغرة في دفاعه

259
00:19:59,310 --> 00:20:03,020
!تبًّا! أيّ نوع من المخلوقات يكون؟

260
00:20:03,540 --> 00:20:05,280
.لن أخطئك في المرّة القادمة

261
00:20:06,360 --> 00:20:07,740
!مدفع الزّرافة

262
00:20:09,170 --> 00:20:10,320
...ما

263
00:20:10,830 --> 00:20:14,330
تبًّا! أدخلت عنقي كثيرًا لدرجة
!أنّ ذراعيّ وساقيّ أصبحوا أطول

264
00:20:14,330 --> 00:20:16,290
!أيّ نوع من الخصائص يملكها جسدك؟

265
00:20:16,780 --> 00:20:20,290
الأمر أشبه بتكدّس العجين
.وخروجه كمعكرونة

266
00:20:20,290 --> 00:20:22,970
!وكأنّني آلة صنع معجّنات

267
00:20:28,790 --> 00:20:29,940
!آلة المعجّنات

268
00:20:29,940 --> 00:20:31,680
!لا تجعل ذلك هو اسم هجومك بهذه البساطة

269
00:20:32,390 --> 00:20:36,890
أنا أحبّ عنقي الطّويل، لكن يسهل
.استعمال الأذرع والسّيقان الطّويلة أيضًا

270
00:20:37,670 --> 00:20:42,440
أنا خبير في القتال يحوّل الأوضاع
.غير المتوقّعة إلى فرص

271
00:20:43,570 --> 00:20:47,400
شاهد فحسب... التّقنية الّتي
...تستفيد من طول أطرافي

272
00:20:49,930 --> 00:20:51,040
!برج إطلاق الزّرافة

273
00:20:51,040 --> 00:20:52,820
!ألم تستطع التّفكير في هجوم جديد؟

274
00:20:54,370 --> 00:20:55,280
!طفح الكيل

275
00:20:57,250 --> 00:20:58,690
...أسلوب السّيوف الثّلاثة

276
00:20:58,690 --> 00:21:00,660
!إعصار التّنّين

277
00:21:00,660 --> 00:21:01,750
!الجسد الحديديّ

278
00:21:05,480 --> 00:21:07,050
!...يا للقوّة

279
00:21:07,050 --> 00:21:07,800
!انتقال آنيّ

280
00:21:14,100 --> 00:21:15,010
!مشية القمر

281
00:21:15,010 --> 00:21:16,310
ماذا؟

282
00:21:18,570 --> 00:21:20,520
!قفز إلى الطّابق العلويّ

283
00:21:23,920 --> 00:21:25,310
!آلة المعجّنات

284
00:21:28,620 --> 00:21:30,110
!شكرًا على الانتظار

285
00:21:34,920 --> 00:21:38,190
...ذراعاي وساقاي وعنقي
،إن أمكنني التّحكّم في مداها

286
00:21:38,190 --> 00:21:40,040
!أستطيع التّلويح بسيفيّ بكلّ قوّة

287
00:21:43,010 --> 00:21:45,970
.أنا سيّاف يستعمل أسلوب السّيوف الأربعة

288
00:21:45,970 --> 00:21:48,710
أستطيع الآن الاستفادة من قوى
!الزّرافة خاصّتي بالكامل

289
00:21:49,300 --> 00:21:52,170
!ما عدت تملك أيّ فرصة أمامي

290
00:21:55,540 --> 00:21:58,600
...قوى الزّرافة قويّة جدًّا

291
00:21:59,070 --> 00:22:02,680
...بإمكانك تخزين عنقك الّذي يعرقلك

292
00:22:03,180 --> 00:22:06,310
...بإمكانك استعمال أسلوب السّيوف الأربعة

293
00:22:07,520 --> 00:22:08,990
!كلاّ

294
00:22:11,320 --> 00:22:12,360
!ماذا؟

295
00:22:12,910 --> 00:22:15,280
!أوقف هجمات سيفيّ؟

296
00:22:17,590 --> 00:22:23,000
لا شيء من ذلك... بإمكانه
.أن يكون أساسًا لهزيمتي

297
00:22:32,290 --> 00:22:34,680
،سأستعمل تقنية ساق العاصفة
،تقطيع السّماء

298
00:22:34,680 --> 00:22:37,390
!وأقطّع ردّك العقيم ذاك

299
00:22:37,390 --> 00:22:38,890
.لا مهرب لك

300
00:22:38,890 --> 00:22:40,770
!لا أمانع وجود العقبات

301
00:22:40,770 --> 00:22:43,390
!اخترت السّير على درب أسورا

302
00:22:43,390 --> 00:22:45,390
!ما ذلك الوهم؟

303
00:22:46,140 --> 00:22:47,650
:في الحلقة القادمة من وان بيس

304
00:22:47,650 --> 00:22:50,970
الإله الشّيطانيّ زورو! وُلد تجسّد "
"!أسورا من الرّوح القتاليّة

305
00:22:50,970 --> 00:22:53,120
!ملك القراصنة، لن يكون إلاّ أنا

306
00:22:55,990 --> 00:22:57,990
نلقاكم في الحلقة القادمة