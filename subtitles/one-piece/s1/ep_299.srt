1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,480 --> 00:02:41,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:44,970 --> 00:02:47,340
!هذا صحيح! فهمت

33
00:02:47,340 --> 00:02:48,140
ماذا؟

34
00:02:48,540 --> 00:02:52,680
،بإمكاننا إنقاذها... ما دمت معكم
!بإمكاننا إنقاذ روبين! اللّعنة

35
00:02:52,680 --> 00:02:55,610
!اللّعنة"؟! ليس عليك أن تغضب أو ما شابه"

36
00:02:55,610 --> 00:02:56,610
!لنسرع يا نامي-كُن

37
00:02:57,350 --> 00:03:00,030
.لا تجعليني أكرّر كلامي

38
00:03:01,040 --> 00:03:05,200
.لم يتبقّ ولو حتّى بصيص أمل لك

39
00:03:05,200 --> 00:03:07,650
،سمعتُ صوتًا ما في الممرّ قبل قليل

40
00:03:07,650 --> 00:03:10,210
لكن لم يظهر أيّ أحد بعدها، صحيح؟

41
00:03:10,210 --> 00:03:14,380
لا بدّ أنّ لوتشي يقتله الآن، أسمعتِ؟

42
00:03:14,870 --> 00:03:17,140
.يبدو أنّنا على خلاف

43
00:03:17,140 --> 00:03:19,170
.أعتقد أنّه لا طائل من مناقشة الأمر

44
00:03:19,540 --> 00:03:21,270
.ليس لديّ وقت كثير أيضًا

45
00:03:21,270 --> 00:03:24,050
!فاكهة المطّاط... المدفع الرّشّاش

46
00:03:24,500 --> 00:03:25,740
!الطّابع

47
00:03:25,740 --> 00:03:26,470
!السّوط

48
00:03:27,470 --> 00:03:28,670
!الرّمح

49
00:03:39,030 --> 00:03:42,860
أنا ذئب. سأواصل السّعي خلفك
.إلى أن أغرس أنيابي فيك

50
00:03:48,110 --> 00:03:49,970
.ماذا؟ ما زلت حيًّا

51
00:03:50,510 --> 00:03:55,170
...لا أنوي الهرب... لا أنوي أن أُقتل

52
00:03:58,710 --> 00:04:00,050
.ولا أنوي أن أسامح أيضًا

53
00:04:00,050 --> 00:04:01,610
تسامح؟

54
00:04:03,980 --> 00:04:06,300
هل تتعاطف مع نيكو روبين؟

55
00:04:07,080 --> 00:04:10,970
.إنّ العقل المشتّت يخلق ثغرات خلال القتال

56
00:04:10,970 --> 00:04:14,310
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

57
00:04:14,310 --> 00:04:17,880
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

58
00:04:18,430 --> 00:04:20,150
.انتبه لكلامك

59
00:04:22,610 --> 00:04:26,160
.أنا من النّوع الّذي يشتعل غضبًا

60
00:04:34,910 --> 00:04:39,170
.قوّتها المدمّرة تشبه قوّة شيطان

61
00:04:40,100 --> 00:04:41,840
!ساق الشّيطان

62
00:04:41,840 --> 00:04:43,800
!ماذا؟ مـ-مهلاً

63
00:04:43,800 --> 00:04:45,760
...ركلة

64
00:04:50,810 --> 00:04:52,020
!اللّهب

65
00:05:03,600 --> 00:05:05,990
...يخلق الإله الطّعام

66
00:05:07,570 --> 00:05:10,410
.والشّيطان التّوابل

67
00:05:13,270 --> 00:05:16,680
.أعتقد أنّني أضفت الكثير من التّوابل

68
00:05:20,600 --> 00:05:26,320
هجوم السّيف الأبيض! زورو ضدّ"
"!كاكو في نزال سيوف قويّ قاطع

69
00:05:36,520 --> 00:05:38,480
!قاطع الغول

70
00:05:48,530 --> 00:05:51,490
!يا للهول! ذلك الزّرافة اللّعين ورأس الطّحلب

71
00:05:51,490 --> 00:05:53,570
هل يحاولان تدمير هذا البرج؟

72
00:06:04,230 --> 00:06:05,600
...هذه

73
00:06:06,920 --> 00:06:08,330
بوّابات العدالة؟

74
00:06:09,000 --> 00:06:10,890
بإمكاني الوصول إلى هناك
باتّباعي لهذه الإرشادات؟

75
00:06:13,810 --> 00:06:17,170
أتمنّى أن تكون نامي-سان متّجهة
.إلى روبين-تشان سلفًا مع أوسوبّ الآن

76
00:06:21,620 --> 00:06:24,650
عليّ الإسراع أيضًا وإحضار
.المفتاح رقم 1 إليها

77
00:06:27,400 --> 00:06:28,470
!من الأفضل أن أنطلق

78
00:06:34,710 --> 00:06:36,500
!أسرعي أيّتها الحقيرة

79
00:06:45,520 --> 00:06:48,800
!"وصلنا أخيرًا إلى "جسر التّردّد

80
00:06:51,750 --> 00:06:53,720
!انظري يا نيكو روبين

81
00:07:03,550 --> 00:07:07,440
بإمكانك رؤية بوّابات العدالة المفتوحة، صحيح؟

82
00:07:12,360 --> 00:07:16,200
.أخذ هذا وقتًا طويلاً... وقتًا طويلاً بالفعل

83
00:07:16,200 --> 00:07:17,940
.لكنّني وصلت أخيرًا

84
00:07:17,940 --> 00:07:21,040
،بمجرّد أن أعبر هذه البوّابات
...فيمكنني أن أكون للحكومةِ

85
00:07:21,040 --> 00:07:24,750
!كلاّ، بل للعالم بأسره بطلاً

86
00:07:28,570 --> 00:07:33,220
إنّ الجسر الّذي يمتدّ حتّى الجانب الآخر
،من البوّابات قد ارتفع بالفعل

87
00:07:33,220 --> 00:07:36,170
.وهو الآن ينتظر البطل ليأتي ويعبره

88
00:07:43,920 --> 00:07:49,650
كم هذا رائع! انظري إلى الطّريق
!المؤدّي إلى مستقبلي المشرق

89
00:07:51,600 --> 00:07:55,820
حسنًا، إنّه طريق نحو الجحيم بالنّسبة لك، صحيح؟

90
00:07:56,170 --> 00:08:00,870
ألا تظنّين ذلك يا نيكو روبين؟

91
00:08:06,920 --> 00:08:07,960
!كلاّ

92
00:08:07,960 --> 00:08:08,920
!ما الّذي تفعلينه يا هذه؟

93
00:08:10,460 --> 00:08:11,410
!هذا مؤلم

94
00:08:14,380 --> 00:08:16,220
!أنتِ! انتظري

95
00:08:18,720 --> 00:08:22,430
!حقيرة... هذا يكفي

96
00:08:22,830 --> 00:08:27,390
!ما زلتِ لا تدركين الأمر؟
!لا فائدة من المحاولة والمقاومة

97
00:08:27,390 --> 00:08:31,240
!هل تدركين من أكون بالفعل؟

98
00:08:31,570 --> 00:08:35,200
أنا بطل العالم. أنا بطل
!العالم، أهذا مفهوم؟

99
00:08:35,610 --> 00:08:40,630
أنت في أسوأ وضع بلا أيّ
!بصيص أمل! أنا مختلف عنك

100
00:08:40,630 --> 00:08:45,920
!لديّ مستقبل مشرق مليء بالآمال والأحلام

101
00:08:46,370 --> 00:08:48,630
!أتفهمين أيّتها المرأة الغبيّة؟

102
00:08:49,210 --> 00:08:52,320
!غبيّة! غبيّة! غبيّة

103
00:09:00,940 --> 00:09:02,510
...لوفي

104
00:09:02,510 --> 00:09:03,230
...رفاق

105
00:09:04,070 --> 00:09:05,280
!...يا رفاق

106
00:09:10,650 --> 00:09:12,280
!عليّ الإسراع! عليّ الإسراع

107
00:09:12,280 --> 00:09:14,530
لن يكون هنالك طائل
!من كلّ هذا إن تأخّرت

108
00:09:15,280 --> 00:09:16,840
!بإمكاني رؤية شيء ما أمامي

109
00:09:22,290 --> 00:09:24,960
!سنصل إلى وجهتنا حوال عشر دقائق

110
00:09:25,790 --> 00:09:28,660
!أسرعوا وتحقّقوا من تشكيلة كلّ السّفن

111
00:09:28,660 --> 00:09:29,920
!حاضر

112
00:09:30,470 --> 00:09:34,210
!يا هذه! قفي بسرعة يا حقيرة

113
00:09:34,210 --> 00:09:37,220
!هيّا بنا يا نيكو روبين

114
00:09:40,890 --> 00:09:42,760
!أهذا هو المخرج؟

115
00:09:49,680 --> 00:09:51,610
!يا قبّعة القشّ

116
00:09:52,050 --> 00:09:53,860
!هذا أنت يا فرانكي

117
00:09:53,860 --> 00:09:56,050
!ما الّذي تفعله هنا أيّها الوغد؟

118
00:09:56,050 --> 00:09:59,240
!مغفّل! كفّ عن تصرّفاتك هذه

119
00:09:59,660 --> 00:10:01,700
!أنا في صفّكم الآن! كفّ عن ذلك فحسب

120
00:10:04,690 --> 00:10:08,000
لوتشي إذًا؟ إذًا فأنت تواجه
وقتًا عصيبًا ضدّه؟

121
00:10:08,500 --> 00:10:11,960
.أين هي نيكو روبين؟ أحضرت مفتاحين معي

122
00:10:12,380 --> 00:10:13,500
هل أساعدك؟

123
00:10:13,500 --> 00:10:15,670
...لا. الأهمّ من ذلك

124
00:10:16,260 --> 00:10:18,370
.أوقف روبين أرجوك

125
00:10:20,390 --> 00:10:24,370
بإمكانك الذّهاب لبوّابات العدالة
.عبر ذلك الباب خلف رجل الحمامة

126
00:10:24,370 --> 00:10:26,430
.أُخذت روبين إلى هناك سلفًا

127
00:10:27,130 --> 00:10:29,850
.سأقوم أنا بإيقافه

128
00:10:31,640 --> 00:10:34,270
!سأدع الأمر لك بشكل خارق أيّها الوغد

129
00:10:49,960 --> 00:10:54,750
،أقول أنّه لو كان الخيار لي
!فأنا أفضّل اللّحم أكثر

130
00:10:56,610 --> 00:11:00,010
!وأنا أقول أنّ ذلك ليس مهمًّا أيّها العاشب

131
00:11:03,150 --> 00:11:05,680
.على أيّ حال، سأسرع وآخذ مفتاحك

132
00:11:06,670 --> 00:11:09,100
،إن لم أنجح في الوقت المناسب
.فستكون تلك أشبه بالهزيمة

133
00:11:12,300 --> 00:11:15,480
...أسلوب السّيفين: القاطعان

134
00:11:20,650 --> 00:11:23,950
تصبح أقوى عندما ترتدي
منشفة على رأسك؟

135
00:11:24,380 --> 00:11:25,490
ومن يدري...؟

136
00:11:29,410 --> 00:11:31,110
!تسلّق البرج

137
00:11:33,930 --> 00:11:36,010
!ردّ تسلّق البرج

138
00:11:39,380 --> 00:11:40,800
!وميض

139
00:11:42,300 --> 00:11:44,010
!تموّج

140
00:11:44,410 --> 00:11:46,810
.إن قفزتَ، فستصبح لك نقاطًا عمياء

141
00:11:46,810 --> 00:11:48,180
!منجل الزّرافة

142
00:11:58,130 --> 00:12:00,330
.الجسد الحديديّ: لا نقاط عمياء

143
00:12:02,270 --> 00:12:03,200
!ماذا؟

144
00:12:13,430 --> 00:12:16,640
.أصبحتُ مكعّبًا بلا نقاط عمياء

145
00:12:17,370 --> 00:12:19,590
!اخرس! ما الّذي تفعله؟

146
00:12:20,720 --> 00:12:22,090
.يا لسذاجتك

147
00:12:22,090 --> 00:12:24,370
ألم تلاحظ...؟

148
00:12:24,370 --> 00:12:25,470
ماذا؟

149
00:12:26,490 --> 00:12:30,500
.للزّرافات أربعة قوائم

150
00:12:31,470 --> 00:12:32,330
!ساق العاصفة

151
00:12:32,900 --> 00:12:35,290
!هل ستقاتلني أم لا يا هذا؟

152
00:12:35,290 --> 00:12:38,690
إلى أين تنظر؟
.بدأت هجماتي بالفعل

153
00:12:41,150 --> 00:12:43,860
...الهجمات القاطعة الّتي وجّهتها للأعلى

154
00:12:43,860 --> 00:12:46,160
...سترتدّ عن السّقف

155
00:12:46,160 --> 00:12:47,700
!وستنهال عليك

156
00:12:49,460 --> 00:12:50,850
!زخّات الزّرافة

157
00:12:56,050 --> 00:12:57,490
!الجسد الحديديّ

158
00:13:04,690 --> 00:13:06,540
...إنّه وابل من الهجمات القاطعة

159
00:13:06,540 --> 00:13:08,550
!سُحقًا! لا يمكنني صدّها

160
00:13:27,820 --> 00:13:29,030
!مسدّس الأنف

161
00:13:54,550 --> 00:13:55,980
!...أيّها الوغد

162
00:13:56,710 --> 00:13:58,790
.يا لك من رجل قويّ

163
00:13:58,790 --> 00:14:00,520
.أنا مندهش

164
00:14:01,720 --> 00:14:04,570
!لقد درّبت جسدي أيّها الجرّافة اللّعين

165
00:14:05,000 --> 00:14:07,710
جرّافة؟ أنا زرافة؟

166
00:14:07,710 --> 00:14:09,280
.جرّافة

167
00:14:09,280 --> 00:14:12,200
!هذا خطأ! لستُ جرّافة

168
00:14:14,350 --> 00:14:15,460
!اخرس

169
00:14:16,040 --> 00:14:18,500
...جرّافة... زرافة

170
00:14:18,910 --> 00:14:22,590
!كفاك ثرثرة... لا أهتمّ لذلك مطلقًا

171
00:14:23,850 --> 00:14:27,300
.إن كنت تسخر منّي، فستدفع الثّمن

172
00:14:27,620 --> 00:14:32,470
نفس الأمر ينطبق عليك. استعدّ
.لأنّ وقت اللّعب قد انتهى

173
00:14:32,990 --> 00:14:37,010
!أوّلاً، سأحطّم... ذلك الجسد الحديديّ

174
00:14:57,300 --> 00:14:59,660
.إنّك تقول أشياء مضحكة بالفعل

175
00:15:00,190 --> 00:15:02,670
ستحطّم جسدي الحديدي؟

176
00:15:03,220 --> 00:15:05,150
أتظنّ أنّك قادر على ذلك؟

177
00:15:05,980 --> 00:15:07,910
.نعم، بكلّ تأكيد

178
00:15:09,000 --> 00:15:10,840
أتريدني أن أجرّب؟

179
00:15:14,180 --> 00:15:17,720
،أسلوب السّيف الواحد
...فنّ إياي

180
00:15:22,010 --> 00:15:23,610
!أنشودة الأسد

181
00:15:24,680 --> 00:15:25,480
!ساق العاصفة

182
00:15:27,580 --> 00:15:28,880
!تقطيع التّنّين

183
00:15:33,600 --> 00:15:35,740
هل كنت لتنجح في التّقطيع لو كان حديدًا؟

184
00:15:36,380 --> 00:15:40,500
إنّه قراري إن كنت أريد استعمال الجسد
.الحديديّ أم لا للتّصدّي لهجومك

185
00:15:43,660 --> 00:15:47,840
.فهمت. أظنّ أنّ الأمر ليس بتلك البساطة

186
00:15:51,890 --> 00:15:53,220
!غوريلاّ واحدة

187
00:15:53,620 --> 00:15:54,930
!غوريلّتان

188
00:15:55,310 --> 00:15:57,130
!والآن، هلمّ إليّ

189
00:15:59,680 --> 00:16:01,390
...أسلوب السّيوف الثّلاثة

190
00:16:01,770 --> 00:16:04,120
أهي مسابقة قوّة الآن؟

191
00:16:04,900 --> 00:16:06,820
.كم هذا مثير للاهتمام

192
00:16:06,820 --> 00:16:08,150
!مسدّس الأنف

193
00:16:09,280 --> 00:16:10,610
!تقطيع الغوريلّتان القويّ

194
00:16:17,970 --> 00:16:19,830
!...يا لها من قوّة

195
00:16:31,390 --> 00:16:34,020
.إنّك تتحدّث بتعجرف

196
00:16:34,020 --> 00:16:38,680
إنّك من النّوع الّذي يعجز حتّى عن
تخيّل نفسه أنّه قد يُهزم، صحيح؟

197
00:16:43,370 --> 00:16:44,940
!يا لتكبّرك

198
00:16:45,380 --> 00:16:47,210
!وكذلك أنت

199
00:16:51,480 --> 00:16:55,570
!فاكهة المطّاط: المدفع الرّشّاش

200
00:16:55,950 --> 00:16:56,930
.فنّ الورق

201
00:17:02,050 --> 00:17:04,770
!فاكهة المطّاط: المسدّس

202
00:17:04,770 --> 00:17:05,460
!انتقال آنيّ

203
00:17:17,130 --> 00:17:18,160
!يا قبّعة القشّ

204
00:17:18,850 --> 00:17:19,720
!تبًّا

205
00:17:20,600 --> 00:17:21,720
!ساق العاصفة

206
00:17:30,440 --> 00:17:32,320
!سلاح اليُسرى

207
00:17:33,570 --> 00:17:34,190
!انتقال آنيّ

208
00:17:35,850 --> 00:17:36,700
!ماذا؟

209
00:17:37,230 --> 00:17:40,030
!فاكهة المطّاط: الصّاروخ

210
00:17:44,130 --> 00:17:44,690
!ماذا؟

211
00:17:44,690 --> 00:17:48,240
!فاكهة المطّاط: البازوكا

212
00:17:51,030 --> 00:17:52,300
!يا قبّعة القشّ

213
00:17:52,300 --> 00:17:54,800
!حسنًا، ابق كما أنت ولا تتحرّك

214
00:17:54,800 --> 00:17:55,740
!انتظر

215
00:17:56,420 --> 00:17:59,900
.لا تضيّع وقتك على هذا الرّجل
!اذهب فحسب

216
00:17:59,900 --> 00:18:02,060
قلت لك أنّني سأقوم بإيقافه، صحيح؟

217
00:18:02,060 --> 00:18:05,150
توقفه؟! لكن بالكاد تستطيع
!الوقوف في وجهه

218
00:18:05,150 --> 00:18:07,130
...علينا العمل معًا لكي

219
00:18:07,130 --> 00:18:07,980
!فرانكي

220
00:18:08,620 --> 00:18:12,360
.إنّه خصمي أنا! أنا من عليه إيقافه

221
00:18:12,870 --> 00:18:16,800
.سأكرّر كلامي مرّة واحدة
!أسرع وأنقذ روبين

222
00:18:16,800 --> 00:18:18,320
!وأوقفها

223
00:18:19,180 --> 00:18:21,430
!وإلاّ رحلت عنّا للأبد

224
00:18:22,780 --> 00:18:24,870
!لن نستطيع استعادتها حينها

225
00:18:26,450 --> 00:18:27,790
...إنّك

226
00:18:28,620 --> 00:18:31,500
!توقّف! أيّها القطار البحريّ

227
00:18:31,990 --> 00:18:35,330
!أعد توم-سان لنا

228
00:18:38,450 --> 00:18:39,630
.ذلك غير ممكن

229
00:18:42,680 --> 00:18:43,430
.لن أسمح لك بالذّهاب

230
00:18:45,720 --> 00:18:47,260
!يا قبّعة القشّ

231
00:18:47,260 --> 00:18:48,430
!أسرع

232
00:18:48,840 --> 00:18:50,440
!اذهب

233
00:18:51,330 --> 00:18:52,990
...إنّك

234
00:18:54,660 --> 00:18:55,530
!مفهوم

235
00:18:56,280 --> 00:18:57,570
...أظنّني قلت أنّي لن أسمح لك

236
00:18:58,290 --> 00:19:00,030
!بالذّهاب

237
00:19:01,190 --> 00:19:01,990
!مشية القمر

238
00:19:04,550 --> 00:19:05,240
!انتقال آنيّ

239
00:19:07,250 --> 00:19:08,580
!ما-ماذا؟

240
00:19:09,480 --> 00:19:10,290
!مسدّس الإصبع

241
00:19:18,240 --> 00:19:19,880
...وأظنّني أخبرتك أيضًا

242
00:19:20,380 --> 00:19:23,080
!أنّني خصمك

243
00:19:25,740 --> 00:19:27,990
...ما زلت لم أرك بعد

244
00:19:28,880 --> 00:19:32,070
!قوّة الزّرافة الحقيقيّة الجامحة

245
00:19:32,070 --> 00:19:34,480
.كفاك كلامًا! أرني فحسب

246
00:19:35,110 --> 00:19:36,960
!بكلّ تأكيد

247
00:19:37,810 --> 00:19:40,610
!أمعن النّظر إلى قوّة الزّرافة

248
00:19:43,890 --> 00:19:45,510
!مدفع الزّرافة

249
00:19:46,530 --> 00:19:48,540
.لا وجود لزرافة هكذا

250
00:19:48,540 --> 00:19:50,790
!مسدّس الأنف الأقصى

251
00:19:51,620 --> 00:19:53,210
!برج إطلاق الزّرافة

252
00:19:53,990 --> 00:19:55,080
!امتدّ؟

253
00:19:56,060 --> 00:19:57,990
أرأيت؟ ألم أخبرك بهذا؟

254
00:19:57,990 --> 00:20:00,230
.عنقك الطّويل هذا هو نقطة ضعفك

255
00:20:00,230 --> 00:20:02,050
.ذلك ليس صحيحًا تمامًا

256
00:20:02,050 --> 00:20:02,880
!ساق العاصفة

257
00:20:02,880 --> 00:20:04,260
!السّيف الأبيض الدّوّار

258
00:20:10,810 --> 00:20:13,310
.أنت من لديه ثغرة في دفاعه

259
00:20:13,310 --> 00:20:17,020
!تبًّا! أيّ نوع من المخلوقات يكون؟

260
00:20:17,540 --> 00:20:19,280
.لن أخطئك في المرّة القادمة

261
00:20:20,360 --> 00:20:21,740
!مدفع الزّرافة

262
00:20:23,170 --> 00:20:24,320
...ما

263
00:20:24,830 --> 00:20:28,330
تبًّا! أدخلت عنقي كثيرًا لدرجة
!أنّ ذراعيّ وساقيّ أصبحوا أطول

264
00:20:28,330 --> 00:20:30,290
!أيّ نوع من الخصائص يملكها جسدك؟

265
00:20:30,780 --> 00:20:34,290
الأمر أشبه بتكدّس العجين
.وخروجه كمعكرونة

266
00:20:34,290 --> 00:20:36,970
!وكأنّني آلة صنع معجّنات

267
00:20:42,790 --> 00:20:43,940
!آلة المعجّنات

268
00:20:43,940 --> 00:20:45,680
!لا تجعل ذلك هو اسم هجومك بهذه البساطة

269
00:20:46,390 --> 00:20:50,890
أنا أحبّ عنقي الطّويل، لكن يسهل
.استعمال الأذرع والسّيقان الطّويلة أيضًا

270
00:20:51,670 --> 00:20:56,440
أنا خبير في القتال يحوّل الأوضاع
.غير المتوقّعة إلى فرص

271
00:20:57,570 --> 00:21:01,400
شاهد فحسب... التّقنية الّتي
...تستفيد من طول أطرافي

272
00:21:03,930 --> 00:21:05,040
!برج إطلاق الزّرافة

273
00:21:05,040 --> 00:21:06,820
!ألم تستطع التّفكير في هجوم جديد؟

274
00:21:08,370 --> 00:21:09,280
!طفح الكيل

275
00:21:11,250 --> 00:21:12,690
...أسلوب السّيوف الثّلاثة

276
00:21:12,690 --> 00:21:14,660
!إعصار التّنّين

277
00:21:14,660 --> 00:21:15,750
!الجسد الحديديّ

278
00:21:19,480 --> 00:21:21,050
!...يا للقوّة

279
00:21:21,050 --> 00:21:21,800
!انتقال آنيّ

280
00:21:28,100 --> 00:21:29,010
!مشية القمر

281
00:21:29,010 --> 00:21:30,310
ماذا؟

282
00:21:32,570 --> 00:21:34,520
!قفز إلى الطّابق العلويّ

283
00:21:37,920 --> 00:21:39,310
!آلة المعجّنات

284
00:21:42,620 --> 00:21:44,110
!شكرًا على الانتظار

285
00:21:48,920 --> 00:21:52,190
...ذراعاي وساقاي وعنقي
،إن أمكنني التّحكّم في مداها

286
00:21:52,190 --> 00:21:54,040
!أستطيع التّلويح بسيفيّ بكلّ قوّة

287
00:21:57,010 --> 00:21:59,970
.أنا سيّاف يستعمل أسلوب السّيوف الأربعة

288
00:21:59,970 --> 00:22:02,710
أستطيع الآن الاستفادة من قوى
!الزّرافة خاصّتي بالكامل

289
00:22:03,300 --> 00:22:06,170
!ما عدت تملك أيّ فرصة أمامي

290
00:22:09,540 --> 00:22:12,600
...قوى الزّرافة قويّة جدًّا

291
00:22:13,070 --> 00:22:16,680
...بإمكانك تخزين عنقك الّذي يعرقلك

292
00:22:17,180 --> 00:22:20,310
...بإمكانك استعمال أسلوب السّيوف الأربعة

293
00:22:21,520 --> 00:22:22,990
!كلاّ

294
00:22:25,320 --> 00:22:26,360
!ماذا؟

295
00:22:26,910 --> 00:22:29,280
!أوقف هجمات سيفيّ؟

296
00:22:31,590 --> 00:22:37,000
لا شيء من ذلك... بإمكانه
.أن يكون أساسًا لهزيمتي

297
00:22:46,290 --> 00:22:48,680
،سأستعمل تقنية ساق العاصفة
،تقطيع السّماء

298
00:22:48,680 --> 00:22:51,390
!وأقطّع ردّك العقيم ذاك

299
00:22:51,390 --> 00:22:52,890
.لا مهرب لك

300
00:22:52,890 --> 00:22:54,770
!لا أمانع وجود العقبات

301
00:22:54,770 --> 00:22:57,390
!اخترت السّير على درب أسورا

302
00:22:57,390 --> 00:22:59,390
!ما ذلك الوهم؟

303
00:23:00,140 --> 00:23:01,650
:في الحلقة القادمة من وان بيس

304
00:23:01,650 --> 00:23:04,970
الإله الشّيطانيّ زورو! وُلد تجسّد "
"!أسورا من الرّوح القتاليّة

305
00:23:04,970 --> 00:23:07,120
!ملك القراصنة، لن يكون إلاّ أنا

306
00:23:09,990 --> 00:23:11,990
نلقاكم في الحلقة القادمة