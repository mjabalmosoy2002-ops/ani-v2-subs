1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,310 --> 00:02:52,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,730 --> 00:02:57,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:59,950 --> 00:03:06,410
ولكن لم يكتشفه أحد بالكامل
.سوى غولد روجر، ملك القراصنة

32
00:03:07,330 --> 00:03:12,460
.حطّم العالم الجديد أحلام وطموح العديد من القراصنة

33
00:03:14,380 --> 00:03:20,340
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,340 --> 00:03:22,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:22,970 --> 00:03:26,850
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:29,640 --> 00:03:31,940
،بعد أن نجوا من قتال شديد

37
00:03:31,940 --> 00:03:37,480
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا
.البحر العاتي حيث يبسط اليونكو سيطرتهم

38
00:03:38,020 --> 00:03:42,320
،بعد رسوّهم في بانك هازارد
جزيرة منقسمة إلى جزأين، الأراضي المشتعلة والأراضي الجليدية

39
00:03:43,460 --> 00:03:47,530
علم طاقم قبعة القش عن تجارب شنيعة
،يجريها السّيّد، سيزار كلاون

40
00:03:47,530 --> 00:03:49,830
،وانطلقوا للبحث، ولكن مع سير الأمور

41
00:03:49,830 --> 00:03:54,730
شكّل لوفي تحالفًا مع قراصنة القلب الذين يقودهم ترافالغار لو

42
00:03:55,780 --> 00:04:00,760
.ويتوجهون الآن لرؤية السيّد سيزار كلاون

43
00:04:05,550 --> 00:04:08,180
.لن أسمح له بأخذ الأطفال ثانية

44
00:04:08,180 --> 00:04:12,640
لا أصدّق أنّه كان يستخدمهم
.كعينات اختبار ويعطيهم العقاقير

45
00:04:12,640 --> 00:04:15,730
!لا يمكنني أن أغفر لهذا السيّد

46
00:04:17,190 --> 00:04:19,110
!انظروا لذلك

47
00:04:22,280 --> 00:04:23,900
!مـ-ما هذا؟

48
00:04:24,300 --> 00:04:25,620
!يطير شيء نحونا

49
00:04:25,940 --> 00:04:27,780
!إنّها قنبلة عملاقة

50
00:04:28,810 --> 00:04:29,870
!لا، ليست كذلك

51
00:04:38,050 --> 00:04:39,720
!مئة زهرة

52
00:04:40,710 --> 00:04:41,840
!أجنحة

53
00:04:43,840 --> 00:04:45,760
!خذها

54
00:04:50,230 --> 00:04:53,030
!أظهر نفسك أيّها السيّد

55
00:04:53,030 --> 00:04:57,530
!سنبرحك ضربًا ونختطفك

56
00:04:57,530 --> 00:04:59,730
.يفترض أن يكون هذا سرًّا يا لوفي

57
00:05:00,330 --> 00:05:01,280
!قبعة القش

58
00:05:02,540 --> 00:05:04,110
!اذهب يا لوفي

59
00:05:04,540 --> 00:05:08,780
!ذلك الأحمق! من أخبره أن يواجه جميع قوّات العدو؟

60
00:05:17,590 --> 00:05:21,120
!على حافة الإبادة"
"!قدوم وحش مميت طائرًا

61
00:05:37,850 --> 00:05:42,540
ذلك الوغد! أقال أنّه سيبرح سيّدنا ضربًا ويختطفه؟

62
00:05:42,540 --> 00:05:46,360
!تبًّا له! أطيحوا بطاقم قبعة القش

63
00:05:50,420 --> 00:05:52,950
اليمنى

64
00:05:52,950 --> 00:05:54,240
!القويّة

65
00:06:08,670 --> 00:06:12,230
ماذا علينا أن نفعل يا سموكر-سان؟

66
00:06:12,230 --> 00:06:16,030
.سنقبض على طاقم قبعة القش بالطبع

67
00:06:16,030 --> 00:06:18,440
!اقبضوا على طاقم قبعة القش

68
00:06:21,240 --> 00:06:23,040
!مئة زهرة

69
00:06:27,830 --> 00:06:28,490
!تشبّث

70
00:06:42,100 --> 00:06:43,350
ماذا علينا أن نفعل؟

71
00:06:43,350 --> 00:06:44,620
.نتركهم وشأنهم

72
00:06:45,180 --> 00:06:46,630
.لندخل

73
00:06:47,630 --> 00:06:50,140
ألديك مفتاح؟

74
00:06:50,610 --> 00:06:53,230
تستطيع استخدام الانتقال الآني، صحيح؟

75
00:06:55,350 --> 00:06:56,620
.غرفة

76
00:07:01,800 --> 00:07:03,580
.افعل كما قلنا

77
00:07:03,860 --> 00:07:08,610
،أجل. بينما تأخذ سيزار وتلك المرأة إلى مكان آخر

78
00:07:09,110 --> 00:07:11,740
.سأبحث العقار

79
00:07:15,620 --> 00:07:17,700
!أسلحة اليسرى

80
00:07:29,420 --> 00:07:32,550
وصلنا، ولكن أين السيّد؟

81
00:07:32,930 --> 00:07:35,690
.لا أظن أنّه في الخارج

82
00:07:36,350 --> 00:07:37,700
أين هو إذًا؟

83
00:07:38,330 --> 00:07:40,380
.داخل المختبر على الأرجح

84
00:07:40,380 --> 00:07:43,790
.حسنًا، لا بدّ أنّنا نستطيع الدخول من ذلك الباب الكبير إذًا

85
00:07:43,790 --> 00:07:44,730
.لنذهب

86
00:07:50,610 --> 00:07:52,490
!قبعة القش لوفي

87
00:07:52,750 --> 00:07:54,620
!الدخاني

88
00:08:16,300 --> 00:08:18,140
!فكّوا قيدي

89
00:08:18,140 --> 00:08:21,210
!فكّوا قيدي يا أخواي الكبيران

90
00:08:21,600 --> 00:08:25,400
!أعراض الحرمان ثانيةً! ماذا نفعل؟

91
00:08:25,400 --> 00:08:28,650
!لا نملك خيارًا سوى أن ننومهم! سأستخدمها ثانيةً

92
00:08:29,320 --> 00:08:31,630
!القتل المؤكّد: نجم النوم

93
00:08:41,820 --> 00:08:44,040
!أفلتوني

94
00:08:46,540 --> 00:08:49,590
!مستحيل! لم ينفع نجم النوم؟

95
00:08:49,720 --> 00:08:52,510
!لا يمكن! ماذا نفعل الآن؟

96
00:08:59,360 --> 00:09:00,060
!هذا خطير

97
00:09:16,410 --> 00:09:18,830
.ناموا أخيرًا

98
00:09:18,830 --> 00:09:21,450
.ولكن لم ينفع كالسابق

99
00:09:21,980 --> 00:09:25,710
.أجل، سنكون في ورطة حين يستيقظون

100
00:09:32,670 --> 00:09:36,970
قبعة القش لوفي! ما الذي تنوي فعله على هذه الجزيرة؟

101
00:09:37,180 --> 00:09:40,720
!الدخاني! أنت بخير إذًا

102
00:09:40,720 --> 00:09:43,640
!قلقت لأنّهم كانوا يضربونك قبل قليل

103
00:09:43,850 --> 00:09:45,230
!لا تسخر منّي

104
00:09:48,150 --> 00:09:51,900
ماذا؟ أمعدتك تؤلمك؟ ألديك إمساك؟

105
00:09:55,650 --> 00:09:56,240
!فعلتها

106
00:10:02,660 --> 00:10:06,460
.ما خطبك يا دخاني؟ أصبحت ضعيفًا

107
00:10:06,460 --> 00:10:09,630
...لـ-لا، أنا

108
00:10:09,630 --> 00:10:13,670
.وتبدو غريبًا اليوم أيضًا

109
00:10:14,130 --> 00:10:16,470
.أنت، بربّك

110
00:10:16,830 --> 00:10:19,090
لا تدعيه يهزمك

111
00:10:19,090 --> 00:10:20,510
!وأنت بجسدي

112
00:10:27,810 --> 00:10:29,230
!هذا السلاح

113
00:10:29,460 --> 00:10:33,320
عدت إلى البحر إذًا يا قبعة القش؟

114
00:10:33,320 --> 00:10:37,070
!ولكنّي لن أسمح لك بفعل ما يحلو لك

115
00:10:53,960 --> 00:10:55,920
.أُصبت

116
00:10:58,010 --> 00:11:00,260
.إنّه مدهون بالحجر البحري

117
00:11:00,730 --> 00:11:04,100
الفتاة صاحبة النظارة أصبحت بهذه القوّة؟

118
00:11:04,100 --> 00:11:05,970
...اسمها

119
00:11:11,770 --> 00:11:13,980
!أنا سموكر

120
00:11:14,290 --> 00:11:15,980
!ماذا؟

121
00:11:17,320 --> 00:11:19,990
.لا بدّ أنّ هذا من فعل لو يا لوفي

122
00:11:20,200 --> 00:11:24,120
.ماذا؟ فهمت، التبديل إذًا

123
00:11:24,780 --> 00:11:27,020
.ذلك يفسر ضعفه

124
00:11:27,970 --> 00:11:29,290
...وهذا إذًا

125
00:11:32,830 --> 00:11:34,000
...أنت

126
00:11:35,140 --> 00:11:36,810
!دخاني؟

127
00:11:39,210 --> 00:11:41,380
!ما المضحك؟

128
00:11:43,770 --> 00:11:45,680
.واجهني يا قبعة القش

129
00:11:45,870 --> 00:11:47,180
!المستوى الثاني

130
00:11:52,260 --> 00:11:54,980
!هذا أكثر إثارة

131
00:12:01,530 --> 00:12:03,740
...اليد اليمنى

132
00:12:03,740 --> 00:12:05,370
!القويّة

133
00:12:11,100 --> 00:12:14,590
.لا نهاية لهم

134
00:12:15,850 --> 00:12:20,170
!لنحطّم الباب وندخل المختبر حالًا

135
00:12:20,460 --> 00:12:24,130
...هيّا بنا! فرانكي

136
00:12:28,090 --> 00:12:29,850
!إنّه سريع جدًّا

137
00:12:35,140 --> 00:12:37,150
!لننهِ القتال في وقت آخر

138
00:12:37,150 --> 00:12:37,940
!ماذا؟

139
00:12:38,340 --> 00:12:41,990
!لا فائدة من قتالك وأنت لا تستطيع استخدام كلّ قوتك

140
00:12:42,390 --> 00:12:43,570
...لا تغتر

141
00:12:43,810 --> 00:12:44,700
!بنفسك

142
00:12:46,050 --> 00:12:48,240
!إلى اللقاء يا دخاني

143
00:12:48,240 --> 00:12:50,990
!شعاع جذريّ

144
00:13:00,130 --> 00:13:01,930
!أحدث فتحة في الباب

145
00:13:01,930 --> 00:13:03,930
!ما خطب هؤلاء؟

146
00:13:03,930 --> 00:13:05,220
أكان ذلك شعاعًا؟

147
00:13:07,310 --> 00:13:11,230
!لوفي، روبين، حطّمت الباب

148
00:13:11,460 --> 00:13:13,130
!اقتحموا

149
00:13:14,470 --> 00:13:16,940
!إنّك تنجز العمل بسرعة يا فرانكي

150
00:13:20,230 --> 00:13:21,660
!سمو-يان

151
00:13:22,640 --> 00:13:24,780
!يطير شيء غريب نحونا

152
00:13:25,490 --> 00:13:26,280
!هناك

153
00:13:26,670 --> 00:13:27,910
ما هذا؟

154
00:13:38,360 --> 00:13:39,420
...هذا

155
00:13:39,760 --> 00:13:40,590
ماذا؟

156
00:14:30,870 --> 00:14:32,310
!السفينة

157
00:14:33,080 --> 00:14:34,810
ما ذلك؟

158
00:14:35,100 --> 00:14:37,980
!لوفي، فرانكي، تمهلا

159
00:14:41,440 --> 00:14:44,800
!ما هذا؟! إنّه يتحرك

160
00:14:44,800 --> 00:14:46,530
!اتركوا الأمر لي

161
00:14:48,580 --> 00:14:50,830
!إنّك تشعرني بالاشمئزاز

162
00:15:00,960 --> 00:15:02,750
!مـ-ما هذا؟

163
00:15:03,180 --> 00:15:05,550
!إنّه غاز سام! ابتعدوا

164
00:15:05,550 --> 00:15:09,470
!عندما هاجمناه بالسيوف والبنادق، بعث غازًا سامًا

165
00:15:09,780 --> 00:15:11,790
!ارتدوا أقنعة الغاز

166
00:15:11,790 --> 00:15:12,980
!بسرعة

167
00:15:17,300 --> 00:15:19,790
!ماذا؟! ما هذا؟

168
00:15:19,790 --> 00:15:21,850
أهذا مخلوق حي؟

169
00:15:21,850 --> 00:15:24,900
لا أملك أدنى فكرة. ما هذا؟

170
00:15:26,780 --> 00:15:29,600
أنت، ما ذلك؟

171
00:15:29,600 --> 00:15:33,740
!لـ-لا أدري! لم أر شيئًا كهذا من قبل

172
00:15:34,100 --> 00:15:36,680
سقط من السّماء، أليس كذلك؟

173
00:15:36,680 --> 00:15:39,290
!نعم، ولكنّه يتحرّك

174
00:15:39,290 --> 00:15:41,120
!مقرف

175
00:15:46,740 --> 00:15:48,640
أهذا كائن حي؟

176
00:15:49,800 --> 00:15:50,880
!انظروا

177
00:15:52,770 --> 00:15:54,220
...اندمج

178
00:15:54,570 --> 00:15:56,150
!وكبر

179
00:15:59,520 --> 00:16:01,900
!ماذا؟

180
00:16:04,540 --> 00:16:07,950
!سينتهي أمره إن دفعناه إلى النهر

181
00:16:07,950 --> 00:16:09,870
!توقّف

182
00:16:18,690 --> 00:16:20,220
!غاز سام ثانيةً

183
00:16:20,280 --> 00:16:21,540
!اسحبوه

184
00:16:23,320 --> 00:16:25,550
!استعداد، هيّا

185
00:16:27,070 --> 00:16:27,710
...لحظة

186
00:16:28,110 --> 00:16:29,300
...هذا

187
00:16:31,220 --> 00:16:35,470
!مؤلم! مؤلم! لمس جلدي
!فليزله أحد

188
00:16:35,470 --> 00:16:37,760
!أعطوني قطعة قماش

189
00:16:37,760 --> 00:16:40,560
!لا ينبغي لنا لمسه كما توقعت

190
00:16:40,560 --> 00:16:41,650
ماذا نفعل؟

191
00:16:41,740 --> 00:16:43,700
!لا أدري

192
00:16:43,700 --> 00:16:45,780
!تراجعوا يا شباب

193
00:16:48,880 --> 00:16:52,680
!شكله يوحي أنّه ضعيف ضد النار

194
00:16:52,680 --> 00:16:54,490
!لنحرقه

195
00:16:56,210 --> 00:16:57,740
!خذها

196
00:17:00,390 --> 00:17:03,500
!لا يوجد كائن حيّ لا يخشى النار

197
00:17:03,830 --> 00:17:05,820
!إنّك ذكي

198
00:17:05,820 --> 00:17:07,590
!احرقه

199
00:17:11,490 --> 00:17:14,840
!إنّها نقطة ضعفه كما توقعت
!تستحق هذا

200
00:17:15,110 --> 00:17:16,910
!إنّه يتعذّب بكل وضوح

201
00:17:16,910 --> 00:17:18,510
!بدأ يحترق

202
00:17:23,110 --> 00:17:26,100
!خذها! خذها! خذها! خذها

203
00:17:34,160 --> 00:17:35,280
!مرحى

204
00:17:38,620 --> 00:17:40,660
!خذها، خذها

205
00:18:05,140 --> 00:18:06,140
!ماذا؟

206
00:18:06,140 --> 00:18:10,300
!أنتم

207
00:18:18,040 --> 00:18:20,450
ماذا حدث للتو؟

208
00:18:20,450 --> 00:18:23,020
!لا أدري! لم أر شيئًا كهذا من قبل

209
00:18:23,020 --> 00:18:26,370
!يبعث سمًا إن لمسناه، وينفجر إن أحرقناه

210
00:18:26,650 --> 00:18:30,030
.لا ندري ما إن كان مخلوقًا حيًّا أم لا من الأساس

211
00:18:30,500 --> 00:18:33,340
.لا يهم، فقد مات

212
00:18:33,340 --> 00:18:35,840
.صحيح

213
00:18:35,840 --> 00:18:37,410
.هذا ليس كلّ شيء

214
00:18:37,410 --> 00:18:42,060
قتل جنود البحريّة الذين سرقوا
!السّفينة وأبحروا فيها أيضًا

215
00:18:42,060 --> 00:18:43,820
...بالنسبة لنا، فإنّ هذا

216
00:18:44,350 --> 00:18:45,300
ماذا؟

217
00:18:52,440 --> 00:18:55,430
!إنّه هنا

218
00:18:56,730 --> 00:18:58,650
!سقط من السّماء ثانيةً

219
00:18:58,650 --> 00:19:01,100
.هذا مثل الذي قبل قليل

220
00:19:01,160 --> 00:19:02,530
كم يوجد منه؟

221
00:19:09,680 --> 00:19:11,880
أهذا مخلوق حي؟

222
00:19:12,200 --> 00:19:15,430
.لا أدري. لم أر شيئًا كهذا من قبل

223
00:19:15,430 --> 00:19:17,380
.أنا أيضًا

224
00:19:17,380 --> 00:19:21,340
.أنا متفاجئ لدرجة أنّ عينَيّ خرجتا من رأسي

225
00:19:21,340 --> 00:19:26,640
.ولكنّي لا أملك عينين من الأساس

226
00:19:30,040 --> 00:19:32,390
...يا له من شيء غريب

227
00:19:32,390 --> 00:19:35,150
.ويفعل أشياء غريبة

228
00:19:38,530 --> 00:19:42,110
!مذهل! إنّه يطير بارتفاع كبير

229
00:19:45,990 --> 00:19:49,200
أليس قادمًا نحونا؟

230
00:19:59,460 --> 00:20:01,900
!ما هذا؟

231
00:20:01,900 --> 00:20:03,840
!مقرف

232
00:20:19,280 --> 00:20:21,690
!إنّه يهطل باستمرار

233
00:20:25,660 --> 00:20:28,170
!اهربوا! لا تلمسوه أبدًا

234
00:20:31,070 --> 00:20:34,320
!سموكر-سان، هذا المكان خطر

235
00:20:34,320 --> 00:20:36,260
!لنحتمِ

236
00:20:36,260 --> 00:20:37,380
.أجل

237
00:20:45,240 --> 00:20:49,760
!ولد مطيع! أعتذر لحبسك لثلاث سنوات

238
00:20:52,400 --> 00:20:53,970
!سيّد

239
00:20:53,970 --> 00:20:56,560
!لماذا خرجت؟ المكان خطر

240
00:21:05,730 --> 00:21:10,240
كما توقعت. أنت سيزار كلاون بالتأكيد، ألست كذلك؟

241
00:21:10,610 --> 00:21:12,000
...هل أنت

242
00:21:12,300 --> 00:21:14,000
!السيّد؟

243
00:21:15,850 --> 00:21:17,870
!بالفعل، صحيح

244
00:21:17,870 --> 00:21:22,560
!الجميع من طاقم قبعة القش وبحريّة جي-5

245
00:21:22,560 --> 00:21:26,430
!أنا أعظم عالم في العالم

246
00:21:29,350 --> 00:21:33,050
!السيّد سيزار كلاون

247
00:21:38,990 --> 00:21:41,770
.انتظروا قليلًا

248
00:21:44,770 --> 00:21:47,720
،بما أنّه ضعيف ضد الماء

249
00:21:47,720 --> 00:21:52,820
فإنّه يرمي قطعًا من نفسه شيئًا فشيئًا

250
00:21:52,820 --> 00:21:56,070
!من أجل عبور البحيرة

251
00:21:58,610 --> 00:22:00,410
...من الأرض المشتعلة

252
00:22:01,190 --> 00:22:03,210
!إلى الأرض الجليدية

253
00:22:03,590 --> 00:22:07,920
،حين تصل كلّ أجزائه إلى هذا الجانب

254
00:22:10,520 --> 00:22:13,350
!فستجربونه

255
00:22:14,400 --> 00:22:19,930
انفجار السّلاح الكيميائي
!الذي وقع قبل أربع سنوات في بانك هازارد

256
00:22:20,960 --> 00:22:24,980
!عالم موت لا يمكن لأحد النجاة فيه

257
00:22:31,450 --> 00:22:33,200
وفلتتعلّموا

258
00:22:33,410 --> 00:22:37,040
!مدى قوّة سلاحي القادر على تدمير جزيرة

259
00:22:37,040 --> 00:22:42,000
!وعظمة أفضل عالم في العالم الذي صنع هذا السلاح

260
00:22:46,120 --> 00:22:51,010
!أنا، السيّد سيزار كلاون

261
00:23:11,190 --> 00:23:13,370
!أمسكتك

262
00:23:13,370 --> 00:23:17,690
!ماذا؟

263
00:23:24,920 --> 00:23:28,370
يخوض لوفي وسيزار كلاون قتالًا شديدًا

264
00:23:28,370 --> 00:23:30,090
.ويأبى الطرفان الاستسلام

265
00:23:30,560 --> 00:23:32,260
،وفي نهاية القتال الشديد

266
00:23:32,260 --> 00:23:35,510
يظن لوفي أنّه قبض على سيزار، ولكن حينها

267
00:23:35,510 --> 00:23:39,560
.تُكشف قوّة فاكهة الغاز المخيفة

268
00:23:39,560 --> 00:23:41,060
:في الحلقة القادمة من وان بيس

269
00:23:41,060 --> 00:23:44,500
!معركة عنيفة! يكشف سيزار عن قوّته الحقيقيّة

270
00:23:44,500 --> 00:23:46,700
!ملك القراصنة، لن يكون إلاّ أنا

271
00:23:50,030 --> 00:23:55,030
!!نراكم في الحلقة القادمة