1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,310 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:45,950 --> 00:02:52,410
ولكن لم يكتشفه أحد بالكامل
.سوى غولد روجر، ملك القراصنة

32
00:02:53,330 --> 00:02:58,460
.حطّم العالم الجديد أحلام وطموح العديد من القراصنة

33
00:03:00,380 --> 00:03:06,340
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,340 --> 00:03:08,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:08,970 --> 00:03:12,850
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:15,640 --> 00:03:17,940
،بعد أن نجوا من قتال شديد

37
00:03:17,940 --> 00:03:23,480
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا
.البحر العاتي حيث يبسط اليونكو سيطرتهم

38
00:03:24,020 --> 00:03:28,320
،بعد رسوّهم في بانك هازارد
جزيرة منقسمة إلى جزأين، الأراضي المشتعلة والأراضي الجليدية

39
00:03:29,460 --> 00:03:33,530
علم طاقم قبعة القش عن تجارب شنيعة
،يجريها السّيّد، سيزار كلاون

40
00:03:33,530 --> 00:03:35,830
،وانطلقوا للبحث، ولكن مع سير الأمور

41
00:03:35,830 --> 00:03:40,730
شكّل لوفي تحالفًا مع قراصنة القلب الذين يقودهم ترافالغار لو

42
00:03:41,780 --> 00:03:46,760
.ويتوجهون الآن لرؤية السيّد سيزار كلاون

43
00:03:51,550 --> 00:03:54,180
.لن أسمح له بأخذ الأطفال ثانية

44
00:03:54,180 --> 00:03:58,640
لا أصدّق أنّه كان يستخدمهم
.كعينات اختبار ويعطيهم العقاقير

45
00:03:58,640 --> 00:04:01,730
!لا يمكنني أن أغفر لهذا السيّد

46
00:04:03,190 --> 00:04:05,110
!انظروا لذلك

47
00:04:08,280 --> 00:04:09,900
!مـ-ما هذا؟

48
00:04:10,300 --> 00:04:11,620
!يطير شيء نحونا

49
00:04:11,940 --> 00:04:13,780
!إنّها قنبلة عملاقة

50
00:04:14,810 --> 00:04:15,870
!لا، ليست كذلك

51
00:04:24,050 --> 00:04:25,720
!مئة زهرة

52
00:04:26,710 --> 00:04:27,840
!أجنحة

53
00:04:29,840 --> 00:04:31,760
!خذها

54
00:04:36,230 --> 00:04:39,030
!أظهر نفسك أيّها السيّد

55
00:04:39,030 --> 00:04:43,530
!سنبرحك ضربًا ونختطفك

56
00:04:43,530 --> 00:04:45,730
.يفترض أن يكون هذا سرًّا يا لوفي

57
00:04:46,330 --> 00:04:47,280
!قبعة القش

58
00:04:48,540 --> 00:04:50,110
!اذهب يا لوفي

59
00:04:50,540 --> 00:04:54,780
!ذلك الأحمق! من أخبره أن يواجه جميع قوّات العدو؟

60
00:05:03,590 --> 00:05:07,120
!على حافة الإبادة"
"!قدوم وحش مميت طائرًا

61
00:05:23,850 --> 00:05:28,540
ذلك الوغد! أقال أنّه سيبرح سيّدنا ضربًا ويختطفه؟

62
00:05:28,540 --> 00:05:32,360
!تبًّا له! أطيحوا بطاقم قبعة القش

63
00:05:36,420 --> 00:05:38,950
اليمنى

64
00:05:38,950 --> 00:05:40,240
!القويّة

65
00:05:54,670 --> 00:05:58,230
ماذا علينا أن نفعل يا سموكر-سان؟

66
00:05:58,230 --> 00:06:02,030
.سنقبض على طاقم قبعة القش بالطبع

67
00:06:02,030 --> 00:06:04,440
!اقبضوا على طاقم قبعة القش

68
00:06:07,240 --> 00:06:09,040
!مئة زهرة

69
00:06:13,830 --> 00:06:14,490
!تشبّث

70
00:06:28,100 --> 00:06:29,350
ماذا علينا أن نفعل؟

71
00:06:29,350 --> 00:06:30,620
.نتركهم وشأنهم

72
00:06:31,180 --> 00:06:32,630
.لندخل

73
00:06:33,630 --> 00:06:36,140
ألديك مفتاح؟

74
00:06:36,610 --> 00:06:39,230
تستطيع استخدام الانتقال الآني، صحيح؟

75
00:06:41,350 --> 00:06:42,620
.غرفة

76
00:06:47,800 --> 00:06:49,580
.افعل كما قلنا

77
00:06:49,860 --> 00:06:54,610
،أجل. بينما تأخذ سيزار وتلك المرأة إلى مكان آخر

78
00:06:55,110 --> 00:06:57,740
.سأبحث العقار

79
00:07:01,620 --> 00:07:03,700
!أسلحة اليسرى

80
00:07:15,420 --> 00:07:18,550
وصلنا، ولكن أين السيّد؟

81
00:07:18,930 --> 00:07:21,690
.لا أظن أنّه في الخارج

82
00:07:22,350 --> 00:07:23,700
أين هو إذًا؟

83
00:07:24,330 --> 00:07:26,380
.داخل المختبر على الأرجح

84
00:07:26,380 --> 00:07:29,790
.حسنًا، لا بدّ أنّنا نستطيع الدخول من ذلك الباب الكبير إذًا

85
00:07:29,790 --> 00:07:30,730
.لنذهب

86
00:07:36,610 --> 00:07:38,490
!قبعة القش لوفي

87
00:07:38,750 --> 00:07:40,620
!الدخاني

88
00:08:02,300 --> 00:08:04,140
!فكّوا قيدي

89
00:08:04,140 --> 00:08:07,210
!فكّوا قيدي يا أخواي الكبيران

90
00:08:07,600 --> 00:08:11,400
!أعراض الحرمان ثانيةً! ماذا نفعل؟

91
00:08:11,400 --> 00:08:14,650
!لا نملك خيارًا سوى أن ننومهم! سأستخدمها ثانيةً

92
00:08:15,320 --> 00:08:17,630
!القتل المؤكّد: نجم النوم

93
00:08:27,820 --> 00:08:30,040
!أفلتوني

94
00:08:32,540 --> 00:08:35,590
!مستحيل! لم ينفع نجم النوم؟

95
00:08:35,720 --> 00:08:38,510
!لا يمكن! ماذا نفعل الآن؟

96
00:08:45,360 --> 00:08:46,060
!هذا خطير

97
00:09:02,410 --> 00:09:04,830
.ناموا أخيرًا

98
00:09:04,830 --> 00:09:07,450
.ولكن لم ينفع كالسابق

99
00:09:07,980 --> 00:09:11,710
.أجل، سنكون في ورطة حين يستيقظون

100
00:09:18,670 --> 00:09:22,970
قبعة القش لوفي! ما الذي تنوي فعله على هذه الجزيرة؟

101
00:09:23,180 --> 00:09:26,720
!الدخاني! أنت بخير إذًا

102
00:09:26,720 --> 00:09:29,640
!قلقت لأنّهم كانوا يضربونك قبل قليل

103
00:09:29,850 --> 00:09:31,230
!لا تسخر منّي

104
00:09:34,150 --> 00:09:37,900
ماذا؟ أمعدتك تؤلمك؟ ألديك إمساك؟

105
00:09:41,650 --> 00:09:42,240
!فعلتها

106
00:09:48,660 --> 00:09:52,460
.ما خطبك يا دخاني؟ أصبحت ضعيفًا

107
00:09:52,460 --> 00:09:55,630
...لـ-لا، أنا

108
00:09:55,630 --> 00:09:59,670
.وتبدو غريبًا اليوم أيضًا

109
00:10:00,130 --> 00:10:02,470
.أنت، بربّك

110
00:10:02,830 --> 00:10:05,090
لا تدعيه يهزمك

111
00:10:05,090 --> 00:10:06,510
!وأنت بجسدي

112
00:10:13,810 --> 00:10:15,230
!هذا السلاح

113
00:10:15,460 --> 00:10:19,320
عدت إلى البحر إذًا يا قبعة القش؟

114
00:10:19,320 --> 00:10:23,070
!ولكنّي لن أسمح لك بفعل ما يحلو لك

115
00:10:39,960 --> 00:10:41,920
.أُصبت

116
00:10:44,010 --> 00:10:46,260
.إنّه مدهون بالحجر البحري

117
00:10:46,730 --> 00:10:50,100
الفتاة صاحبة النظارة أصبحت بهذه القوّة؟

118
00:10:50,100 --> 00:10:51,970
...اسمها

119
00:10:57,770 --> 00:10:59,980
!أنا سموكر

120
00:11:00,290 --> 00:11:01,980
!ماذا؟

121
00:11:03,320 --> 00:11:05,990
.لا بدّ أنّ هذا من فعل لو يا لوفي

122
00:11:06,200 --> 00:11:10,120
.ماذا؟ فهمت، التبديل إذًا

123
00:11:10,780 --> 00:11:13,020
.ذلك يفسر ضعفه

124
00:11:13,970 --> 00:11:15,290
...وهذا إذًا

125
00:11:18,830 --> 00:11:20,000
...أنت

126
00:11:21,140 --> 00:11:22,810
!دخاني؟

127
00:11:25,210 --> 00:11:27,380
!ما المضحك؟

128
00:11:29,770 --> 00:11:31,680
.واجهني يا قبعة القش

129
00:11:31,870 --> 00:11:33,180
!المستوى الثاني

130
00:11:38,260 --> 00:11:40,980
!هذا أكثر إثارة

131
00:11:47,530 --> 00:11:49,740
...اليد اليمنى

132
00:11:49,740 --> 00:11:51,370
!القويّة

133
00:11:57,100 --> 00:12:00,590
.لا نهاية لهم

134
00:12:01,850 --> 00:12:06,170
!لنحطّم الباب وندخل المختبر حالًا

135
00:12:06,460 --> 00:12:10,130
...هيّا بنا! فرانكي

136
00:12:14,090 --> 00:12:15,850
!إنّه سريع جدًّا

137
00:12:21,140 --> 00:12:23,150
!لننهِ القتال في وقت آخر

138
00:12:23,150 --> 00:12:23,940
!ماذا؟

139
00:12:24,340 --> 00:12:27,990
!لا فائدة من قتالك وأنت لا تستطيع استخدام كلّ قوتك

140
00:12:28,390 --> 00:12:29,570
...لا تغتر

141
00:12:29,810 --> 00:12:30,700
!بنفسك

142
00:12:32,050 --> 00:12:34,240
!إلى اللقاء يا دخاني

143
00:12:34,240 --> 00:12:36,990
!شعاع جذريّ

144
00:12:46,130 --> 00:12:47,930
!أحدث فتحة في الباب

145
00:12:47,930 --> 00:12:49,930
!ما خطب هؤلاء؟

146
00:12:49,930 --> 00:12:51,220
أكان ذلك شعاعًا؟

147
00:12:53,310 --> 00:12:57,230
!لوفي، روبين، حطّمت الباب

148
00:12:57,460 --> 00:12:59,130
!اقتحموا

149
00:13:00,470 --> 00:13:02,940
!إنّك تنجز العمل بسرعة يا فرانكي

150
00:13:06,230 --> 00:13:07,660
!سمو-يان

151
00:13:08,640 --> 00:13:10,780
!يطير شيء غريب نحونا

152
00:13:11,490 --> 00:13:12,280
!هناك

153
00:13:12,670 --> 00:13:13,910
ما هذا؟

154
00:13:24,360 --> 00:13:25,420
...هذا

155
00:13:25,760 --> 00:13:26,590
ماذا؟

156
00:14:16,870 --> 00:14:18,310
!السفينة

157
00:14:19,080 --> 00:14:20,810
ما ذلك؟

158
00:14:21,100 --> 00:14:23,980
!لوفي، فرانكي، تمهلا

159
00:14:27,440 --> 00:14:30,800
!ما هذا؟! إنّه يتحرك

160
00:14:30,800 --> 00:14:32,530
!اتركوا الأمر لي

161
00:14:34,580 --> 00:14:36,830
!إنّك تشعرني بالاشمئزاز

162
00:14:46,960 --> 00:14:48,750
!مـ-ما هذا؟

163
00:14:49,180 --> 00:14:51,550
!إنّه غاز سام! ابتعدوا

164
00:14:51,550 --> 00:14:55,470
!عندما هاجمناه بالسيوف والبنادق، بعث غازًا سامًا

165
00:14:55,780 --> 00:14:57,790
!ارتدوا أقنعة الغاز

166
00:14:57,790 --> 00:14:58,980
!بسرعة

167
00:15:03,300 --> 00:15:05,790
!ماذا؟! ما هذا؟

168
00:15:05,790 --> 00:15:07,850
أهذا مخلوق حي؟

169
00:15:07,850 --> 00:15:10,900
لا أملك أدنى فكرة. ما هذا؟

170
00:15:12,780 --> 00:15:15,600
أنت، ما ذلك؟

171
00:15:15,600 --> 00:15:19,740
!لـ-لا أدري! لم أر شيئًا كهذا من قبل

172
00:15:20,100 --> 00:15:22,680
سقط من السّماء، أليس كذلك؟

173
00:15:22,680 --> 00:15:25,290
!نعم، ولكنّه يتحرّك

174
00:15:25,290 --> 00:15:27,120
!مقرف

175
00:15:32,740 --> 00:15:34,640
أهذا كائن حي؟

176
00:15:35,800 --> 00:15:36,880
!انظروا

177
00:15:38,770 --> 00:15:40,220
...اندمج

178
00:15:40,570 --> 00:15:42,150
!وكبر

179
00:15:45,520 --> 00:15:47,900
!ماذا؟

180
00:15:50,540 --> 00:15:53,950
!سينتهي أمره إن دفعناه إلى النهر

181
00:15:53,950 --> 00:15:55,870
!توقّف

182
00:16:04,690 --> 00:16:06,220
!غاز سام ثانيةً

183
00:16:06,280 --> 00:16:07,540
!اسحبوه

184
00:16:09,320 --> 00:16:11,550
!استعداد، هيّا

185
00:16:13,070 --> 00:16:13,710
...لحظة

186
00:16:14,110 --> 00:16:15,300
...هذا

187
00:16:17,220 --> 00:16:21,470
!مؤلم! مؤلم! لمس جلدي
!فليزله أحد

188
00:16:21,470 --> 00:16:23,760
!أعطوني قطعة قماش

189
00:16:23,760 --> 00:16:26,560
!لا ينبغي لنا لمسه كما توقعت

190
00:16:26,560 --> 00:16:27,650
ماذا نفعل؟

191
00:16:27,740 --> 00:16:29,700
!لا أدري

192
00:16:29,700 --> 00:16:31,780
!تراجعوا يا شباب

193
00:16:34,880 --> 00:16:38,680
!شكله يوحي أنّه ضعيف ضد النار

194
00:16:38,680 --> 00:16:40,490
!لنحرقه

195
00:16:42,210 --> 00:16:43,740
!خذها

196
00:16:46,390 --> 00:16:49,500
!لا يوجد كائن حيّ لا يخشى النار

197
00:16:49,830 --> 00:16:51,820
!إنّك ذكي

198
00:16:51,820 --> 00:16:53,590
!احرقه

199
00:16:57,490 --> 00:17:00,840
!إنّها نقطة ضعفه كما توقعت
!تستحق هذا

200
00:17:01,110 --> 00:17:02,910
!إنّه يتعذّب بكل وضوح

201
00:17:02,910 --> 00:17:04,510
!بدأ يحترق

202
00:17:09,110 --> 00:17:12,100
!خذها! خذها! خذها! خذها

203
00:17:20,160 --> 00:17:21,280
!مرحى

204
00:17:24,620 --> 00:17:26,660
!خذها، خذها

205
00:17:51,140 --> 00:17:52,140
!ماذا؟

206
00:17:52,140 --> 00:17:56,300
!أنتم

207
00:18:04,040 --> 00:18:06,450
ماذا حدث للتو؟

208
00:18:06,450 --> 00:18:09,020
!لا أدري! لم أر شيئًا كهذا من قبل

209
00:18:09,020 --> 00:18:12,370
!يبعث سمًا إن لمسناه، وينفجر إن أحرقناه

210
00:18:12,650 --> 00:18:16,030
.لا ندري ما إن كان مخلوقًا حيًّا أم لا من الأساس

211
00:18:16,500 --> 00:18:19,340
.لا يهم، فقد مات

212
00:18:19,340 --> 00:18:21,840
.صحيح

213
00:18:21,840 --> 00:18:23,410
.هذا ليس كلّ شيء

214
00:18:23,410 --> 00:18:28,060
قتل جنود البحريّة الذين سرقوا
!السّفينة وأبحروا فيها أيضًا

215
00:18:28,060 --> 00:18:29,820
...بالنسبة لنا، فإنّ هذا

216
00:18:30,350 --> 00:18:31,300
ماذا؟

217
00:18:38,440 --> 00:18:41,430
!إنّه هنا

218
00:18:42,730 --> 00:18:44,650
!سقط من السّماء ثانيةً

219
00:18:44,650 --> 00:18:47,100
.هذا مثل الذي قبل قليل

220
00:18:47,160 --> 00:18:48,530
كم يوجد منه؟

221
00:18:55,680 --> 00:18:57,880
أهذا مخلوق حي؟

222
00:18:58,200 --> 00:19:01,430
.لا أدري. لم أر شيئًا كهذا من قبل

223
00:19:01,430 --> 00:19:03,380
.أنا أيضًا

224
00:19:03,380 --> 00:19:07,340
.أنا متفاجئ لدرجة أنّ عينَيّ خرجتا من رأسي

225
00:19:07,340 --> 00:19:12,640
.ولكنّي لا أملك عينين من الأساس

226
00:19:16,040 --> 00:19:18,390
...يا له من شيء غريب

227
00:19:18,390 --> 00:19:21,150
.ويفعل أشياء غريبة

228
00:19:24,530 --> 00:19:28,110
!مذهل! إنّه يطير بارتفاع كبير

229
00:19:31,990 --> 00:19:35,200
أليس قادمًا نحونا؟

230
00:19:45,460 --> 00:19:47,900
!ما هذا؟

231
00:19:47,900 --> 00:19:49,840
!مقرف

232
00:20:05,280 --> 00:20:07,690
!إنّه يهطل باستمرار

233
00:20:11,660 --> 00:20:14,170
!اهربوا! لا تلمسوه أبدًا

234
00:20:17,070 --> 00:20:20,320
!سموكر-سان، هذا المكان خطر

235
00:20:20,320 --> 00:20:22,260
!لنحتمِ

236
00:20:22,260 --> 00:20:23,380
.أجل

237
00:20:31,240 --> 00:20:35,760
!ولد مطيع! أعتذر لحبسك لثلاث سنوات

238
00:20:38,400 --> 00:20:39,970
!سيّد

239
00:20:39,970 --> 00:20:42,560
!لماذا خرجت؟ المكان خطر

240
00:20:51,730 --> 00:20:56,240
كما توقعت. أنت سيزار كلاون بالتأكيد، ألست كذلك؟

241
00:20:56,610 --> 00:20:58,000
...هل أنت

242
00:20:58,300 --> 00:21:00,000
!السيّد؟

243
00:21:01,850 --> 00:21:03,870
!بالفعل، صحيح

244
00:21:03,870 --> 00:21:08,560
!الجميع من طاقم قبعة القش وبحريّة جي-5

245
00:21:08,560 --> 00:21:12,430
!أنا أعظم عالم في العالم

246
00:21:15,350 --> 00:21:19,050
!السيّد سيزار كلاون

247
00:21:24,990 --> 00:21:27,770
.انتظروا قليلًا

248
00:21:30,770 --> 00:21:33,720
،بما أنّه ضعيف ضد الماء

249
00:21:33,720 --> 00:21:38,820
فإنّه يرمي قطعًا من نفسه شيئًا فشيئًا

250
00:21:38,820 --> 00:21:42,070
!من أجل عبور البحيرة

251
00:21:44,610 --> 00:21:46,410
...من الأرض المشتعلة

252
00:21:47,190 --> 00:21:49,210
!إلى الأرض الجليدية

253
00:21:49,590 --> 00:21:53,920
،حين تصل كلّ أجزائه إلى هذا الجانب

254
00:21:56,520 --> 00:21:59,350
!فستجربونه

255
00:22:00,400 --> 00:22:05,930
انفجار السّلاح الكيميائي
!الذي وقع قبل أربع سنوات في بانك هازارد

256
00:22:06,960 --> 00:22:10,980
!عالم موت لا يمكن لأحد النجاة فيه

257
00:22:17,450 --> 00:22:19,200
وفلتتعلّموا

258
00:22:19,410 --> 00:22:23,040
!مدى قوّة سلاحي القادر على تدمير جزيرة

259
00:22:23,040 --> 00:22:28,000
!وعظمة أفضل عالم في العالم الذي صنع هذا السلاح

260
00:22:32,120 --> 00:22:37,010
!أنا، السيّد سيزار كلاون

261
00:22:57,190 --> 00:22:59,370
!أمسكتك

262
00:22:59,370 --> 00:23:03,690
!ماذا؟

263
00:23:10,920 --> 00:23:14,370
يخوض لوفي وسيزار كلاون قتالًا شديدًا

264
00:23:14,370 --> 00:23:16,090
.ويأبى الطرفان الاستسلام

265
00:23:16,560 --> 00:23:18,260
،وفي نهاية القتال الشديد

266
00:23:18,260 --> 00:23:21,510
يظن لوفي أنّه قبض على سيزار، ولكن حينها

267
00:23:21,510 --> 00:23:25,560
.تُكشف قوّة فاكهة الغاز المخيفة

268
00:23:25,560 --> 00:23:27,060
:في الحلقة القادمة من وان بيس

269
00:23:27,060 --> 00:23:30,500
!معركة عنيفة! يكشف سيزار عن قوّته الحقيقيّة

270
00:23:30,500 --> 00:23:32,700
!ملك القراصنة، لن يكون إلاّ أنا

271
00:23:36,030 --> 00:23:41,030
!!نراكم في الحلقة القادمة