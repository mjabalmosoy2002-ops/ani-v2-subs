1
00:00:00,000 --> 00:00:01,610
حلم واحد، أمنية واحدة

2
00:00:01,660 --> 00:00:06,540
إن أردتم تحقيقه، فانطلقوا للقمّة

3
00:00:22,470 --> 00:00:26,100
سنبدأ رحلتنا نحو العالم المجهول

4
00:00:27,180 --> 00:00:31,270
نشقّ طريقنا عبر الرّياح والأمواج العاتية

5
00:00:31,310 --> 00:00:35,980
عليّ الاستمرار لأنّني أريد الوصول أوّلاً

6
00:00:36,020 --> 00:00:42,240
سنقلق لاحقًا بما أنّ النّجاح أو الفشل كجهولين

7
00:00:44,370 --> 00:00:48,790
عندما يبدو عدوّكم مرعبًا

8
00:00:48,830 --> 00:00:53,880
فتلك علامة على أنّ قلبكم ينكمش

9
00:00:54,330 --> 00:00:56,420
الهرب ليس خيارًا

10
00:00:56,460 --> 00:00:58,550
اقتربوا أكثر ولو بخطوة

11
00:00:58,590 --> 00:01:01,050
وإن نُعتّ بالوقاحة فتلك مجاملة، صحيح؟

12
00:01:01,050 --> 00:01:05,390
عندما يصعب الحال، يكون الوقت مناسبًا للضّحك

13
00:01:06,930 --> 00:01:11,310
إن أردتم البحث عن غد جديد

14
00:01:11,350 --> 00:01:16,610
فاصقلوا ثقتكم الفريدة

15
00:01:16,650 --> 00:01:21,150
إلى أن تصبح خطاكم

16
00:01:21,190 --> 00:01:24,820
أجل! إلى أن تصبح خريطة

17
00:01:24,860 --> 00:01:29,370
أفق جديد، فانظروا كم شوطًا قطعتم

18
00:01:29,410 --> 00:01:34,420
إنّه أكثر إشراقًا ومستوى الصّعوبة يزداد

19
00:01:34,790 --> 00:01:39,130
عيشوا حلمكم وأطلقوا إعصارًا

20
00:01:39,170 --> 00:01:43,970
الآن! هزّوا التّرتيب

21
00:01:44,010 --> 00:01:48,260
حلم واحد، أمنية واحدة

22
00:01:48,300 --> 00:01:52,770
الأحلام لا تهرب... أبعدوا كلّ شيء عن طريقكم

23
00:01:53,140 --> 00:01:55,140
وانطلق للقمّة

24
00:01:58,610 --> 00:02:03,030
!أجل! حسنًا، ها نحن أولاء

25
00:02:03,030 --> 00:02:06,490
!مرحبًا! لقد عدت

26
00:02:14,000 --> 00:02:17,620
في هذه البلاد، نسمّي وجوه
...الجميع المبتسمة

27
00:02:17,620 --> 00:02:21,630
!إيبيسو غاو" يا سيّدي"

28
00:02:21,630 --> 00:02:24,350
لماذا لا نضحك ونضحك؟

29
00:02:28,750 --> 00:02:32,270
ما هذه الدّمى؟

30
00:02:34,980 --> 00:02:37,900
بونيغليف؟

31
00:02:38,270 --> 00:02:42,190
!أنا من سيطيح بكايدو وسأحظى بالمجد

32
00:02:42,190 --> 00:02:43,900
!بل أنا

33
00:02:43,900 --> 00:02:45,200
!ماذا؟

34
00:02:54,240 --> 00:02:58,250
إنّها حالة طارئة. اختبئوا في مكان ما
.أيّها السّاق السّوداء-يا

35
00:02:58,250 --> 00:03:00,750
.سأهزمهم ثانيةً إن عادوا

36
00:03:00,750 --> 00:03:02,000
.الأمر ليس كذلك

37
00:03:02,540 --> 00:03:05,340
هنالك أشخاص يعرفون
!وجوهنا قادمون إلى هنا

38
00:03:08,290 --> 00:03:12,430
يُسمّى أقوى ستّة بين النّجوم
."الكبار بـ"توبي روبّو

39
00:03:12,800 --> 00:03:14,560
...واثنان منهم

40
00:03:14,560 --> 00:03:15,560
اثنان؟

41
00:03:15,850 --> 00:03:19,770
!"الأوّل هو بيج وان من "التوبي روبّو

42
00:03:26,900 --> 00:03:31,820
."والآخر هو دييس دريك من "التّوبي روبّو

43
00:03:32,570 --> 00:03:36,670
لماذا علينا فعل هذا؟

44
00:03:46,410 --> 00:03:51,010
!اضطراب في العاصمة"
"!قاتل آخر يستهدف سانجي

45
00:04:06,320 --> 00:04:09,700
!إنّ مهرجان النّار وشيك يا جماعة

46
00:04:09,700 --> 00:04:12,450
!لنحظى بحفلة مسبقة

47
00:04:25,340 --> 00:04:28,130
!دمّروا كلّ شيء

48
00:04:28,880 --> 00:04:33,050
!لقد أتت تلك العجوز بالفعل

49
00:04:33,670 --> 00:04:38,520
!أطلقوا! فليبتلعها البحر وننتهي من أمرها

50
00:04:48,940 --> 00:04:53,450
!كلوا واشربوا بقدر ما تشتهون

51
00:05:04,630 --> 00:05:07,170
!لقد تجاوزا خطّ الدّفاع الثّالث

52
00:05:08,460 --> 00:05:10,380
!ركّزوا نيرانكم

53
00:05:12,260 --> 00:05:14,430
!اشربوا المزيد

54
00:05:21,850 --> 00:05:24,940
!كلوا المزيد

55
00:05:24,940 --> 00:05:27,690
!هذه هي بلاد وانو

56
00:05:33,530 --> 00:05:37,500
!سأقتلكِ إن أتيتِ يا لينلين

57
00:05:38,410 --> 00:05:44,710
!زوس! يجب أن تعود لي

58
00:05:44,710 --> 00:05:47,750
!انتظرني يا قبّعة القشّ

59
00:06:21,740 --> 00:06:22,620
.لوفي-دونو

60
00:06:22,620 --> 00:06:24,170
!رايزو

61
00:06:28,250 --> 00:06:29,380
هل من خطب ما؟

62
00:06:30,040 --> 00:06:34,170
.لا، لديّ أخبار جيّدة

63
00:06:34,170 --> 00:06:36,510
.أوتاما بخير

64
00:06:36,960 --> 00:06:39,440
!أهي بخير بالفعل؟

65
00:06:43,680 --> 00:06:44,560
...ممتاز

66
00:06:44,980 --> 00:06:47,600
.تاما بخير الآن إذًا

67
00:06:47,600 --> 00:06:50,150
!شكرًا على إبلاغي بالأمر

68
00:06:57,740 --> 00:06:59,320
.حسنًا، سأعود ثانيةً

69
00:06:59,320 --> 00:06:59,990
.حسنًا

70
00:07:00,870 --> 00:07:02,370
!أجل

71
00:07:10,790 --> 00:07:13,630
!لقد تجاوزوا خطّ الدّفاع السّابع

72
00:07:13,630 --> 00:07:18,090
فليستعدّ الجميع في خطّ
!الدّفاع الأخير للإطلاق

73
00:07:18,090 --> 00:07:20,260
!أوقفوهم بأيّ ثمن

74
00:07:21,470 --> 00:07:23,690
!نابوليون

75
00:07:35,820 --> 00:07:37,070
!نار

76
00:07:39,030 --> 00:07:41,490
!سيادة إيكوكو

77
00:07:43,700 --> 00:07:45,750
!انقطع البثّ

78
00:07:45,750 --> 00:07:48,750
!انتقلوا لكاميرا أخرى بسرعة

79
00:07:50,830 --> 00:07:51,670
...يا إلهي

80
00:07:59,800 --> 00:08:05,220
لقد تجاوزوا خطّ الدّفاع الأخير
!وهم يصعدون الشّلاّلات الآن

81
00:08:05,220 --> 00:08:07,350
!ماذا؟

82
00:08:16,610 --> 00:08:18,150
!انطلقوا

83
00:08:19,240 --> 00:08:21,780
!تصعد هذه الأسماك الشّلاّلات

84
00:08:21,780 --> 00:08:25,240
.هذا لا يصدّق... لعق

85
00:08:25,240 --> 00:08:28,120
!سُحقًا! ما الّذي تفعلونه أيّها الأغبياء؟

86
00:08:28,120 --> 00:08:31,170
لا تسمحوا لهم حتّى بوضع
!أقدامهم على الجزيرة

87
00:08:31,170 --> 00:08:34,880
!لكن لا نملك قوّات في قمّة الشّلاّلات

88
00:08:34,880 --> 00:08:38,090
!وجميعهم أقوياء للغاية

89
00:08:38,510 --> 00:08:42,340
لا وقت لدينا لجلب الأسلحة
!اللاّزمة للإطاحة بهم

90
00:08:43,430 --> 00:08:45,300
...لا تهلع

91
00:08:46,810 --> 00:08:47,770
!كايدو-ساما

92
00:08:50,720 --> 00:08:56,520
.سُحقًا لك يا لينلين
.حتّى أنّها أحضرت أشقياءها معها

93
00:09:03,030 --> 00:09:05,490
!تمالكوا أنفسكم جميعًا

94
00:09:11,500 --> 00:09:15,590
!ستكون هذه حربًا شاملة

95
00:09:22,340 --> 00:09:24,800
.ليس علينا الجلوس هنا وانتظارهم

96
00:09:51,200 --> 00:09:53,460
ما الّذي يؤخّرهم كثيرًا
!للاهتمام بأمر سفينة؟

97
00:09:57,460 --> 00:09:58,750
!أنا سأذهب

98
00:10:06,050 --> 00:10:07,640
!نكاد نصل القمّة

99
00:10:08,640 --> 00:10:10,600
!نوشك على الوصول

100
00:10:11,520 --> 00:10:14,640
!ها أنا ذي يا كايدو

101
00:10:16,270 --> 00:10:17,480
!ما هذا؟

102
00:10:19,440 --> 00:10:22,070
!أهذا كينغ؟

103
00:10:22,070 --> 00:10:23,490
!أهذا بتيرانودون؟

104
00:10:23,780 --> 00:10:25,360
!أطلقي

105
00:10:38,290 --> 00:10:40,290
!هذا مثير للشّفقة

106
00:10:58,190 --> 00:11:00,820
!وصلنا إلى بلاد وانو

107
00:11:01,650 --> 00:11:05,860
!والآن، لنذهب لقتل قبّعة القشّ

108
00:11:11,700 --> 00:11:12,950
!لا يزال هنا

109
00:11:19,770 --> 00:11:21,060
!مستحيل

110
00:11:26,630 --> 00:11:27,340
!كلاّ

111
00:11:35,770 --> 00:11:38,810
!...كينغ! أيّها الـ

112
00:11:41,060 --> 00:11:44,110
!لن أسمح أن تطأ أقدامكم بلاد وانو

113
00:11:47,740 --> 00:11:49,740
!سُحقًا

114
00:11:49,740 --> 00:11:50,820
!ماما

115
00:11:57,870 --> 00:11:59,920
.فليبتلعك البحر

116
00:12:08,710 --> 00:12:10,980
!ماما

117
00:12:13,720 --> 00:12:15,100
!هذا هو كينغ-ساما

118
00:12:15,100 --> 00:12:19,600
ذلك المعتوه يحلّق في السّماء
!فحسب ساعيًا لجلب الانتباه

119
00:12:53,090 --> 00:12:53,840
ماذا؟

120
00:13:31,670 --> 00:13:34,180
!ما-ما الّذي تريده منّي؟

121
00:13:35,430 --> 00:13:36,430
...هذا

122
00:13:36,930 --> 00:13:38,720
محلّ سوبا، صحيح؟

123
00:14:05,120 --> 00:14:07,630
أين هو سانغورو؟

124
00:14:07,630 --> 00:14:11,010
!لا-لا أدري! النّجدة

125
00:14:11,460 --> 00:14:14,890
...حسنًا

126
00:14:17,930 --> 00:14:20,520
!نادي على سانغورو

127
00:14:55,800 --> 00:14:57,970
!أسرع يا فرانوسكي

128
00:14:57,970 --> 00:15:01,430
!مهلاً، لماذا علينا نحن أن نهرب؟

129
00:15:01,760 --> 00:15:04,180
!هدفهم هو طبّاخ السّوبا سانغورو

130
00:15:04,840 --> 00:15:10,860
لقد أطحتَ رفقة طبّاخ السّوبا
!ذاك بعضوٍ من عائلة كيوشيرو

131
00:15:15,060 --> 00:15:16,530
.آسف! لم أتحمّل

132
00:15:18,150 --> 00:15:20,280
.كانت لهم علاقة بأوروتشي

133
00:15:20,280 --> 00:15:25,370
"لذلك السّبب أرسلوا "توبي روبّو
!قراصنة مملكة الحيوان للانتقام

134
00:15:27,710 --> 00:15:31,290
!كلاّ! العدوّ؟! سُحقًا

135
00:15:37,680 --> 00:15:40,390
.حمدًا لله. هذا أنتما

136
00:15:40,760 --> 00:15:43,140
!المكان ليس آمنًا. لنذهب من هنا

137
00:15:43,140 --> 00:15:44,310
!حسنًا

138
00:15:45,640 --> 00:15:47,310
.لنغادر هذا المكان حاليًّا

139
00:16:00,030 --> 00:16:03,990
.هذا وضع سيّئ
.لا يهمّ ما كان السّبب

140
00:16:03,990 --> 00:16:08,540
إن تمّ الإمساك بأيّ أحد منكم واكتُشفت
.هويّته، فستسوء الأحوال كثيرًا

141
00:16:10,160 --> 00:16:13,040
!سيبدؤون بالبحث عن بقيّة الطّاقم

142
00:16:13,040 --> 00:16:16,590
!كلاّ! نامي-سان وروبين-تشان في خطر

143
00:16:17,080 --> 00:16:19,260
!ما زال الأمر هيّنًا ما دمتم أنتم وحدكم

144
00:16:20,540 --> 00:16:23,890
لكن إن اكتشفوا أنّ لديكم
،علاقة حتّى بعائلة كوزكي

145
00:16:23,890 --> 00:16:27,520
فخطّة الانتقام ذات العشرين
!سنة هذه ستُحبَط

146
00:16:27,840 --> 00:16:29,020
!كلاّ

147
00:16:29,800 --> 00:16:32,440
...حتّى إن أمسكوا بكم وعذّبوكم

148
00:16:32,440 --> 00:16:33,650
...ما

149
00:16:33,650 --> 00:16:38,330
.لا تخبروهم شيئًا عن السّاموراي أو قبيلة مينك

150
00:16:39,400 --> 00:16:41,080
...الزموا الصّمت

151
00:16:41,360 --> 00:16:42,740
!ودعوهم يقتلونكم

152
00:16:42,740 --> 00:16:44,160
!أنت مخيف

153
00:16:44,160 --> 00:16:46,660
!ما كان لوفي ليقول أمرًا كهذا

154
00:16:46,660 --> 00:16:48,500
.أنا عمليّ أكثر

155
00:16:48,500 --> 00:16:51,540
لا بأس ما داموا لا يملكون فكرة
عمّن نكون، صحيح؟

156
00:16:51,960 --> 00:16:53,880
...في تلك الحالة

157
00:16:57,830 --> 00:17:00,550
!لماذا لا نقاتل ووجوهنا مخفيّة؟

158
00:17:00,550 --> 00:17:02,100
...حسنًا

159
00:17:03,670 --> 00:17:05,800
.من الأفضل تفادي القتال حاليًّا

160
00:17:05,800 --> 00:17:08,510
!لا تتصرّف وكأنّك قائدنا

161
00:17:08,520 --> 00:17:10,560
...إن أمسكوا بي

162
00:17:10,560 --> 00:17:12,940
!فسأخبرهم بكلّ شيء لأنجو

163
00:17:12,940 --> 00:17:14,610
!كفاك عبثًا يا هذا

164
00:17:14,610 --> 00:17:16,270
!سأحميك إذًا مهما كلّف الأمر

165
00:17:16,270 --> 00:17:17,940
!أجل

166
00:17:17,940 --> 00:17:19,400
!يا لها من صداقة متينة

167
00:17:29,240 --> 00:17:30,250
!إنّها سيّدة

168
00:17:41,620 --> 00:17:43,340
!هذا سيّئ

169
00:17:43,340 --> 00:17:44,760
!هل ثمّة من يتبعنا سلفًا؟

170
00:18:00,780 --> 00:18:04,360
!توقّف! لا علاقة لنا بالأمر

171
00:18:08,910 --> 00:18:13,460
نحن نقدّم السّوبا، لكن لا علاقة
!لنا بطبّاخ السّوبا سانغورو

172
00:18:13,460 --> 00:18:15,540
!كيف أمكنك تدمير محلّنا؟

173
00:18:15,540 --> 00:18:18,510
!لا يمكننا البقاء في هذه المدينة بدونه

174
00:18:22,250 --> 00:18:26,510
،إن وجب لوم أحد ما
.فلوما الأبله المسمّى سانغورو

175
00:18:28,710 --> 00:18:31,100
!أخبروني عن بقيّة محلاّت السّوبا

176
00:18:31,430 --> 00:18:36,480
!وإلاّ، ناديا سانغورو

177
00:18:37,190 --> 00:18:40,440
!إنّه غبيّ عبث مع عائلة كيوشيرو

178
00:18:42,150 --> 00:18:45,440
...إن قاومتما

179
00:18:45,440 --> 00:18:47,780
!سآكلكما أيضًا

180
00:18:50,990 --> 00:18:56,330
!سانغورو

181
00:19:00,380 --> 00:19:01,720
!مهلاً

182
00:19:02,410 --> 00:19:05,220
!سانغورو، أظهر نفسك

183
00:19:09,920 --> 00:19:12,610
.هذا يكفي

184
00:19:16,390 --> 00:19:18,690
!سانغورو

185
00:19:18,690 --> 00:19:21,200
.ربّما لا فائدة من هذا

186
00:19:23,060 --> 00:19:26,280
!لن يُظهر نفسه أبدًا إن كان جبانًا

187
00:19:26,280 --> 00:19:29,290
!سانغورو

188
00:19:30,160 --> 00:19:35,120
!أريد أكل بعض الحلويّات الآن

189
00:19:35,400 --> 00:19:38,170
!إنّهم يستعملون الخداع

190
00:19:38,170 --> 00:19:40,250
!أولى أولويّاتنا الآن هي الهرب

191
00:19:42,960 --> 00:19:43,920
!سانجي

192
00:19:44,800 --> 00:19:46,550
...كيف

193
00:19:47,250 --> 00:19:49,340
!أمكنني فعل ذلك؟

194
00:19:52,260 --> 00:19:54,770
!مهلاً، انتظر يا سانجي

195
00:19:55,810 --> 00:19:58,560
!توقّف! لا علاقة لنا به أيضًا

196
00:19:58,560 --> 00:20:00,900
!حسنًا، نادي باسمه

197
00:20:00,900 --> 00:20:02,650
!نادوا جميعكم

198
00:20:04,780 --> 00:20:07,240
!نادوا طبّاخ السّوبا سانغورو

199
00:20:14,740 --> 00:20:16,040
...أنا

200
00:20:17,200 --> 00:20:18,410
!ها هنا

201
00:20:20,120 --> 00:20:21,630
!ساق الشّيطان

202
00:20:22,290 --> 00:20:23,840
!سحق

203
00:20:39,890 --> 00:20:41,060
...هذا هو

204
00:20:41,060 --> 00:20:42,230
...إنّه

205
00:20:42,520 --> 00:20:44,980
!سانغورو من محلّ السّوبا الخاصّة

206
00:20:51,280 --> 00:20:53,450
.أنت هو طبّاخ السّوبا إذًا

207
00:20:54,700 --> 00:20:58,500
.ظهرتَ أخيرًا. تسبّبت لي بالمشاكل

208
00:20:59,410 --> 00:21:04,920
هذا بيج وان. وجدت الهدف
!في المجمّع السّادس بالحيّ الثّاني

209
00:21:04,920 --> 00:21:07,590
.عُلم! سنوافيك في أقرب وقت ممكن

210
00:21:10,220 --> 00:21:12,550
!لا يمكنك الهرب الآن

211
00:21:13,090 --> 00:21:15,900
...مستعمل قوّة ديناصور

212
00:21:30,520 --> 00:21:31,900
...أيّها الوغد

213
00:21:36,700 --> 00:21:38,450
!ما الّذي تفعله يا سانغورو؟

214
00:21:38,450 --> 00:21:42,580
،توقّف! إن أتى دريك وهوكينس
!فسينتهي كلّ شيء

215
00:21:43,240 --> 00:21:44,670
.أعلم ذلك

216
00:21:51,080 --> 00:21:52,090
...لكن

217
00:21:52,620 --> 00:21:55,300
.إنّه لا يعرف من أكون فعلاً

218
00:21:55,300 --> 00:21:58,600
لذلك لن يدري أحد بأيّ شيء
!ولن أتأذّى

219
00:21:58,600 --> 00:22:01,390
.بإمكاني هزيمة هذا الأبله في الحال

220
00:22:09,230 --> 00:22:11,820
...سيكون من الجيّد وجود حلفاء أكثر

221
00:22:13,490 --> 00:22:17,120
.لكن من الجيّد أيضًا أن يكون هنالك أعداء أقلّ

222
00:22:17,820 --> 00:22:20,200
!كفّ عن هذا الكلام المبهم

223
00:22:28,290 --> 00:22:30,750
!يا رفاق، واصلوا أنتم

224
00:22:40,850 --> 00:22:42,850
...لا بأس ما دمتُ

225
00:22:48,310 --> 00:22:50,520
أُبقي هويّتي سرّيّة، صحيح؟

226
00:23:04,280 --> 00:23:11,040
!بذلة غارات حالكة السّواد وحزام جمجمة
!على قدميه أجهزة تسارع بسرعة الضّوء

227
00:23:11,040 --> 00:23:17,090
،يرتدي عباءة كُتب عليها الرّقم 3
!ظهور بطل جديد في عاصمة الزّهور

228
00:23:17,090 --> 00:23:22,100
يقاتل قراصنة مملكة الحيوان
!حاملاً تطلّعات النّاس

229
00:23:22,100 --> 00:23:23,890
:"في الحلقة القادمة من "ون بيس

230
00:23:23,890 --> 00:23:26,440
"!اندفاع! مقنّع السّوبا النّزيه"

231
00:23:26,560 --> 00:23:30,360
!ملك القراصنة، لن يكون إلاّ أنا