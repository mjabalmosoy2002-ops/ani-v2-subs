1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:16,590 --> 00:02:18,860
.نفد المال منكم جميعًا الآن

22
00:02:19,160 --> 00:02:23,630
لذلك... هل تريد أن تراهن بسروالك
أو ما شابه يا أخي؟

23
00:02:23,900 --> 00:02:25,740
.أنت محظوظ بطريقة ما

24
00:02:25,740 --> 00:02:29,910
،في حالة الفوز عند اللّعب مع روشيو
.لكان جعلك تدفع ثمن ذلك

25
00:02:31,640 --> 00:02:34,310
.آسف، لكنّني سآخذ كلّ مالك

26
00:02:35,350 --> 00:02:39,080
.أفلتني. فزت بهذه اللّعبة بعدل وإنصاف

27
00:02:42,650 --> 00:02:45,960
لقد غششتَ للتّوّ، صحيح؟

28
00:02:45,960 --> 00:02:47,220
أليس كذلك؟

29
00:02:47,920 --> 00:02:50,190
ماذا قلت؟ ومتى فعلتُ ذلك؟

30
00:02:50,460 --> 00:02:54,100
!فعلت! لقد غششت

31
00:02:54,800 --> 00:02:56,830
!لا تطلق اتّهامات سخفية أيّها الوغد

32
00:02:57,330 --> 00:03:00,670
!ساركيس! ساركيس

33
00:03:01,100 --> 00:03:02,810
نعم، ماذا؟

34
00:03:03,140 --> 00:03:06,810
.رأيته أيضًا، صحيح؟ لقد غشّ للتّوّ

35
00:03:06,810 --> 00:03:08,410
غشّ في اللّعب؟

36
00:03:09,010 --> 00:03:13,150
.نعم... هذا صحيح. لقد غشّ

37
00:03:13,150 --> 00:03:16,050
!رأيتُه أيضًا. يا لك من غشّاش قذر

38
00:03:16,050 --> 00:03:19,420
!لا تعبثا معي
!لا تعرفان مع من تتعاملان

39
00:03:47,320 --> 00:03:51,520
!كفاكم حُلمًا"
"!موكتاون، بلدة السّخرية

40
00:03:54,730 --> 00:03:56,360
أما زلت لا تراها يا أوسوبّ؟

41
00:03:56,360 --> 00:03:58,830
.لا، لا أراها بعد

42
00:03:58,830 --> 00:04:01,700
جزيرة جايا هذه ليست بعيدة، صحيح؟

43
00:04:01,700 --> 00:04:04,530
نعم، بما أنّ الطّقس ما زال
،مستقرًّا حتّى الآن

44
00:04:04,530 --> 00:04:06,940
.يجب أن نكون ضمن مناخ الجزيرة

45
00:04:07,340 --> 00:04:09,840
.إذًا لا بدّ أن جايا جزيرة ربيعيّة

46
00:04:09,840 --> 00:04:12,380
.الجوّ جميل ودافئ

47
00:04:14,240 --> 00:04:15,950
.طقس الرّبيع لطيف

48
00:04:16,880 --> 00:04:19,450
.يبدو أنّ النّوارس تستمتع به أيضًا

49
00:04:30,260 --> 00:04:31,630
!أُطلق عليها النّار

50
00:04:31,900 --> 00:04:33,660
!جيّد، لنعدّ ياكيتوري بها

51
00:04:34,060 --> 00:04:37,130
.أُطلق عليها النّار؟ لم أسمع شيئًا

52
00:04:37,130 --> 00:04:38,500
!انظر! وجدتُ رصاصة

53
00:04:38,500 --> 00:04:41,540
حسب اتّجاه طيرانها، أتت الطّلقات
.من حيث تتّجه السّفينة

54
00:04:41,540 --> 00:04:44,410
هل تقول أنّ الطّلقات أتت من جزيرة
لا يمكننا حتّى رؤيتها؟

55
00:04:44,410 --> 00:04:46,510
.ذلك مستحيل يا تشوبّر

56
00:04:46,510 --> 00:04:48,380
.لكنّني كنتُ أراقبها طوال الوقت

57
00:04:49,550 --> 00:04:54,150
إذًا أيّ بصر حادّ ومهارات قنص
وبندقيّة يملكها هذا القنّاص؟

58
00:04:54,150 --> 00:04:56,350
أُطلق عليها في مكان آخر
.وسقطت هنا بالصّدفة

59
00:04:56,950 --> 00:04:59,320
!سانجي، لدينا نوارس

60
00:05:06,830 --> 00:05:09,730
.مسكين... لا بدّ أنّه تعذّب

61
00:05:10,270 --> 00:05:12,570
.لم أستطع قتل أحدها في الحال

62
00:05:13,270 --> 00:05:15,940
.لكنّ ذلك من صنيع القدر أيضًا

63
00:05:15,940 --> 00:05:19,280
.تلك هي نتيجة كيف عشت حياتك

64
00:05:26,250 --> 00:05:29,490
!أنت! هل تعرف من أكون؟

65
00:05:29,490 --> 00:05:31,860
!ماذا؟ لا أعرف أيّها الأبله

66
00:05:31,860 --> 00:05:36,330
ما رأيك أن أخبرك إذًا؟
.أنا بطل المصارعة

67
00:05:40,330 --> 00:05:41,430
!إنّها رائعة

68
00:05:41,430 --> 00:05:43,200
!تبدو بلدة جميلة

69
00:05:43,400 --> 00:05:46,340
مهلاً، ألا تبدو كمنتجع نوعًا ما؟

70
00:05:46,340 --> 00:05:47,470
:منتجع؟

71
00:05:47,470 --> 00:05:48,670
!أسرعي يا ميري

72
00:05:48,870 --> 00:05:52,540
هذا صحيح، تجعلني أشعر
.برغبة في البقاء بعض الشّيء

73
00:05:58,220 --> 00:06:02,450
لكن هل أتخيّل أم أنّ السّفن الّتي ترسو
على الميناء كلّها سفن قراصنة؟

74
00:06:02,450 --> 00:06:04,490
،مهلاً يا أوسوبّ

75
00:06:04,490 --> 00:06:07,820
منذ متى تستطيع سفن القراصنة
أن ترسو علنًا في الموانئ؟

76
00:06:08,330 --> 00:06:09,260
!معك حقّ

77
00:06:11,400 --> 00:06:13,500
!النّجدة! سيقتلني

78
00:06:13,500 --> 00:06:15,600
ما قصّة هذه البلدة؟

79
00:06:17,970 --> 00:06:20,300
!يا لك من ضعيف

80
00:06:21,670 --> 00:06:24,570
.مهلاً يا رجل. اخترت الرّجل الخطأ لتضربه

81
00:06:24,570 --> 00:06:28,150
.انظر لتلك العلامة
.إنّه من طاقم روشيو

82
00:06:28,150 --> 00:06:29,510
سمعتَ به، صحيح؟

83
00:06:29,510 --> 00:06:33,080
إنّه روشيو الجلاّد الّذي تبلغ
.مكافأته 42 مليون بيري

84
00:06:33,080 --> 00:06:37,020
.إنّه مجنون، من الأفضل أن تكون حذرًا

85
00:06:38,820 --> 00:06:43,360
!يا له من رجل متهوّر
.لم يغشّ أبدًا في تلك اللّعبة

86
00:06:43,360 --> 00:06:46,760
لكن من المدهش أنّه هزم
.روشيو الجلاّد بكلّ سهولة هكذا

87
00:06:46,760 --> 00:06:49,030
.ألا تعرفه؟ إنّه بيلامي

88
00:06:49,430 --> 00:06:50,430
!ذاك هو؟

89
00:06:50,430 --> 00:06:54,000
بيلامي الضّبع الّذي تبلغ المكافأة
!على رأسه 55 مليون بيري؟

90
00:06:54,540 --> 00:06:55,840
!أيّها القائد

91
00:06:55,840 --> 00:06:57,470
!من فعل هذا؟

92
00:06:57,470 --> 00:06:59,840
!على أيّ حال، يحتاج طبيبًا بسرعة

93
00:06:59,840 --> 00:07:01,950
.تماسك قليلاً فحسب أيّها القائد

94
00:07:19,100 --> 00:07:21,770
.ثمّة أشخاص من كلّ الأنواع هنا

95
00:07:21,770 --> 00:07:23,370
.تبدو كبلدة ممتعة

96
00:07:24,230 --> 00:07:25,800
...مستحيل

97
00:07:25,800 --> 00:07:28,740
هل تعتقدان أنّ بإمكانهما العودة
دون التّسبّب في المشاكل؟

98
00:07:29,040 --> 00:07:31,610
.حسنًا، تبدو البلدة خطيرة من البداية

99
00:07:31,610 --> 00:07:33,510
.ذلك لا مفرّ منه

100
00:07:33,510 --> 00:07:36,210
!هذا صحيح. لا يمكنهما ذلك

101
00:07:35,310 --> 00:07:36,210
!مهلاً يا نامي

102
00:07:36,680 --> 00:07:40,220
!انتظرا يا لوفي وزورو

103
00:07:41,150 --> 00:07:42,350
...لقد ذهبت

104
00:07:42,720 --> 00:07:45,220
على الأرجح أنّها ستكون
.بخير بما أنّها معهما

105
00:07:45,220 --> 00:07:46,890
ماذا؟ إن كانت نامي-سان
...ذاهبة، فأنا أيضًا

106
00:07:47,690 --> 00:07:49,560
!إيّاك أن تذهب

107
00:07:49,560 --> 00:07:53,900
إن ذهبتَ أنت، ما-ما الّذي سيحدث
!إ-إ-إن هوجمت السّفينة...؟

108
00:07:53,900 --> 00:07:55,770
!لا تذهب أرجوك

109
00:07:55,770 --> 00:07:58,400
!لا بأس! اتركني

110
00:07:58,970 --> 00:08:01,310
حسنًا، أعتقد أنّني سأجهّز بعض
.الشّاي وأحرس السّفينة

111
00:08:02,510 --> 00:08:03,570
أين روبين-تشان؟

112
00:08:03,570 --> 00:08:05,310
.ماذا؟ ليست هنا

113
00:08:07,410 --> 00:08:08,450
...سانجي-كُن، بشأن الشّاي

114
00:08:08,450 --> 00:08:09,250
.حضّره بنفسك

115
00:08:11,080 --> 00:08:14,250
...في هذه البلدة، أنا لن

116
00:08:14,250 --> 00:08:15,950
".لن أقاتل. أعد بهذا"

117
00:08:16,150 --> 00:08:18,290
.لن أقاتل. أعد بهذا

118
00:08:18,590 --> 00:08:20,790
.حسنًا. هذا أمر جادّ

119
00:08:20,790 --> 00:08:21,260
...نعم

120
00:08:21,260 --> 00:08:21,790
.نعم

121
00:08:21,790 --> 00:08:23,860
!ما هذه الرّدود الضّعيفة؟

122
00:08:24,760 --> 00:08:28,600
،إن تسبّبتما بالمشاكل
!سيكون علينا مغادرة هذه البلدة

123
00:08:28,970 --> 00:08:31,800
إن حدث ذلك، لن نكون قادرين
!على الذّهاب للسّماء، أتفهمان؟

124
00:08:31,800 --> 00:08:32,470
.نعم

125
00:08:34,570 --> 00:08:35,140
من يكون؟

126
00:08:35,610 --> 00:08:36,870
.انظرا، وقع من على الحصان

127
00:08:36,870 --> 00:08:38,540
.نعم، وقع

128
00:08:41,980 --> 00:08:42,910
.يبدو أنّه يتألّم

129
00:08:42,910 --> 00:08:43,810
.نعم، إنّه يتألّم

130
00:08:43,810 --> 00:08:48,450
،آسف لإزعاجكم يا جماعة
.لكن ساعدوني على الوقوف أرجوكم

131
00:08:48,450 --> 00:08:50,190
لن تقف وحدك، صحيح؟

132
00:08:51,620 --> 00:08:53,120
.لوفي، احمله من الجانب الآخر

133
00:08:53,120 --> 00:08:53,860
.حسنًا

134
00:08:55,830 --> 00:08:59,560
.حسنًا، شكرًا... أنا على الحصان الآن

135
00:09:00,160 --> 00:09:03,630
.جسدي واهن منذ الولادة

136
00:09:03,630 --> 00:09:05,370
.لنذهب الآن يا تسرونغر

137
00:09:06,470 --> 00:09:07,840
!الحصان أيضًا؟

138
00:09:08,140 --> 00:09:11,070
.يا إلهي، كم هذا مزعج

139
00:09:11,070 --> 00:09:13,680
.شكرًا لكما ثانية

140
00:09:13,910 --> 00:09:17,380
،هذا ليس بالكثيرّ
لكن هل ترغبان ببعضها؟

141
00:09:17,380 --> 00:09:20,820
أنت مريب جدًّا! لا نريد أيًّا
.منها، لذلك غادر فحسب

142
00:09:20,820 --> 00:09:22,650
!إنّه تفّاح! شكرًا لك

143
00:09:22,020 --> 00:09:22,650
!مهلاً، مهلاً

144
00:09:25,990 --> 00:09:28,090
!ماذا؟! ما الّذي حدث؟

145
00:09:28,090 --> 00:09:31,060
كان ثمّة أشخاص يأكلون تفّاحًا
،حصلوا عليه من رجل غريب

146
00:09:31,060 --> 00:09:33,330
!ثمّ انفجروا. كانوا خمسة

147
00:09:35,270 --> 00:09:36,400
...مستحيل

148
00:09:36,700 --> 00:09:40,270
لوفي! ابصقها! ابصق التّفّاحة
!الّتي أكلتها للتّوّ! الآن

149
00:09:40,270 --> 00:09:42,370
.سبق وبلعتها

150
00:09:42,370 --> 00:09:43,510
!أيّها الوغد! ما معنى هذا؟

151
00:09:46,580 --> 00:09:48,350
.حسنًا، لا داعي للقلق

152
00:09:50,250 --> 00:09:51,450
!هذا لا يصدّق

153
00:09:51,450 --> 00:09:53,420
.إنّها كارثة في الدّاخل

154
00:09:53,780 --> 00:09:58,090
،إن كنتَ قد أكلت واحدة فاسدة
.لمتَّ من القضمة الأولى

155
00:09:58,090 --> 00:09:59,060
...أنت

156
00:10:00,990 --> 00:10:02,790
.محظوظ

157
00:10:03,690 --> 00:10:05,530
...هذا فظيع

158
00:10:04,290 --> 00:10:06,560
مهلاً، ما هذا؟

159
00:10:06,560 --> 00:10:09,030
.إنّه قبر روشيو الجلاّد

160
00:10:09,030 --> 00:10:11,300
.يبدو وكأنّ حربًا شنّت هنا

161
00:10:11,640 --> 00:10:13,700
هل أطلقوا مدفعًا
وسط البلدة أو ما شابه؟

162
00:10:13,700 --> 00:10:16,470
من يدري؟ حتّى من كانوا
يشاهدون القتال قالو

163
00:10:16,710 --> 00:10:20,210
.أنّهم لم يستطيعوا فهم ما حدث

164
00:10:20,210 --> 00:10:24,920
كلّ ما نعلمه هو أنّ خصم
.روشيو كان بيلامي

165
00:10:24,920 --> 00:10:26,420
بيلامي الضّبع؟

166
00:10:27,050 --> 00:10:30,150
لا مجال للشّكّ في أنّه يملك إحدى
.قدرات فاكهة الشّيكان

167
00:10:48,840 --> 00:10:50,710
!ما الّذي يجري في هذه البلدة؟

168
00:10:50,970 --> 00:10:53,110
.لا تكوني سريعة الغضب يا نامي

169
00:10:53,340 --> 00:10:56,810
!كدت تموت من دون سبب للتّوّ

170
00:10:57,110 --> 00:10:58,950
.أعتقد أنّ ذلك يحدث أحيانًا

171
00:10:59,220 --> 00:11:00,720
!وهل ذلك مقبول؟

172
00:11:06,420 --> 00:11:08,130
...ذلك الرّجل ثانية

173
00:11:08,130 --> 00:11:09,790
كم ضحيّة نال منها حتّى الآن؟

174
00:11:09,960 --> 00:11:14,300
إنّه ليس رجلاً مطلوبًا مشهورًا
أو ما شابه، فمن يكون يا ترى؟

175
00:11:14,300 --> 00:11:16,000
.حسنًا، لا أريد حتّى أن أعرف

176
00:11:16,000 --> 00:11:20,070
في كلّ الأحوال، علينا الابتعاد
.من البطل المصارع

177
00:11:22,110 --> 00:11:23,270
بطل؟

178
00:11:23,270 --> 00:11:25,680
!ولِمَ هذه الرّوح التّنافسيّة؟

179
00:11:27,980 --> 00:11:31,450
أتساءل إن كنّا نستطيع الحصول
.على معلومات في بلدة كهذه بالفعل

180
00:11:34,720 --> 00:11:35,920
ماذا عن هذا المكان؟

181
00:11:36,520 --> 00:11:38,420
.يبدو مكانًا هادئًا

182
00:11:39,060 --> 00:11:42,290
!بالفعل، إنّه مكان رائع

183
00:11:42,730 --> 00:11:45,600
،إذًا فرغم أنّها بلدة سيّئة
.يوجد فيها أماكن كهذه

184
00:11:45,600 --> 00:11:47,660
لديهم منزل عُطل يطلّ على البحر؟

185
00:11:47,660 --> 00:11:52,940
...في كلّ الأحوال، لا يوجد أحد هنا
.رغم أنّني أشتمّ رائحة طعام

186
00:11:52,940 --> 00:11:58,280
!الـ-المعذرة! أرجوكم لا تدخلوا بدون إذن

187
00:11:58,680 --> 00:12:04,610
هـ-هذا الفندق الاستوائيّ مستأجر
.لبيلامي-ساما وطاقمه

188
00:12:04,610 --> 00:12:08,420
لذلك نطلب من الضّيوف
.الآخرين أن... يغادروا

189
00:12:08,420 --> 00:12:10,490
هذا المكان فندق إذًا؟

190
00:12:10,490 --> 00:12:12,690
،إ-إن رآكم بيلامي-ساما هنا

191
00:12:12,690 --> 00:12:15,890
فستحدث مشكلة، لذلك أطلب
.منكم المغادرة بهدوء

192
00:12:15,890 --> 00:12:17,930
ماذا؟ ما الضّرر من الدّخول فحسب؟

193
00:12:17,930 --> 00:12:19,630
من يكون بيلامي هذا؟

194
00:12:19,930 --> 00:12:21,000
ما الّذي يحدث؟

195
00:12:22,100 --> 00:12:24,770
من يكون هؤلاء الثّلاثة الوضيعون؟

196
00:12:24,770 --> 00:12:28,510
!ساركيس-ساما! مرحبًا بعودتك
...حسنًا، هذا مجرّد

197
00:12:28,510 --> 00:12:30,370
!لا نهتمّ لأعذارك! تخلّص منهم فحسب

198
00:12:30,370 --> 00:12:33,040
!كم ندفع في رأيك لاستئجار هذا المكان؟

199
00:12:33,040 --> 00:12:36,010
إنّها محقّة. عودوا من حيث
!أتيتم أيّها الشّقيّ الغبيّ

200
00:12:36,450 --> 00:12:38,580
أخبريني، أيمكنني إيساعه ضربًا؟

201
00:12:38,580 --> 00:12:39,250
!بالطّبع لا

202
00:12:40,180 --> 00:12:42,250
ستوسعني ضربًا؟

203
00:12:43,250 --> 00:12:44,620
!يا له من فتى مضحك

204
00:12:44,620 --> 00:12:47,260
،على أيّ حال
.لا ترتدون سوى الخِرق

205
00:12:48,530 --> 00:12:52,060
خذوا! التقطوا ذلك المال
.واشتروا لأنفسكم شيئًا يعجبكم

206
00:12:52,060 --> 00:12:55,630
ساركيس، إنّك تضيّع المال هكذا
.بإعطائك إيّاه لأمثالهم

207
00:12:56,970 --> 00:12:59,340
ربّما كان عليّ رميه
.في خندق ما أفضل

208
00:12:59,340 --> 00:13:00,800
ماذا؟ أأنت واثق؟

209
00:13:01,170 --> 00:13:03,010
!لنذهب! هذا مزعج

210
00:13:03,010 --> 00:13:05,010
.مهلاً، مهلاً، بإمكاني المشي وحدي

211
00:13:05,010 --> 00:13:07,010
ماذا؟ لا تريدونه؟

212
00:13:07,840 --> 00:13:11,320
.ساركيس! ليلي! لا تضايقاهم كثيرًا

213
00:13:11,920 --> 00:13:14,050
.ماذا؟  أنت هنا إذًا

214
00:13:15,150 --> 00:13:20,660
عملوا هم أيضًا بجدّ بطريقتهم
.الخاصّة للوصول إلى هنا. انظروا

215
00:13:20,660 --> 00:13:23,760
.بالطّبع، إنّهم حثالة مقارنة بك وببيلامي

216
00:13:23,760 --> 00:13:26,030
إنّهم يبلون حسنًا بالنّسبة
.لكونهم أشخاصًا عاديّين

217
00:13:26,030 --> 00:13:30,000
نعم، وعلى الأرجح لن يستطيعوا النّجاة
.في العصر الجديد الّذي يوشك أن يبدأ

218
00:13:30,300 --> 00:13:35,270
...ومع ذلك... 30 مليون بيري
مكافأة لغرّ مثله؟

219
00:13:35,710 --> 00:13:38,010
.سأُري هذا لبيلامي

220
00:13:39,280 --> 00:13:41,450
!سُحقًا! أنا غاضبة جدًّا

221
00:13:41,950 --> 00:13:43,250
.هذا مؤسف

222
00:13:43,250 --> 00:13:48,490
تعتمد موكتاون على القراصنة
.الّذين ينفقون أموالاً كثيرة هنا

223
00:13:48,790 --> 00:13:51,590
أي أنّ القراصنة الفقراء غير مرحّب بهم؟

224
00:13:51,860 --> 00:13:54,560
.يبدو أنّه لا توجد طريقة لتهدئتك

225
00:13:55,030 --> 00:13:57,130
.تفضّلي، هذا على حسابنا

226
00:13:57,790 --> 00:14:00,900
،بما أنّ هذا المكان يستقطب الأقوياء
.تحدث الكثير من المتاعب

227
00:14:00,900 --> 00:14:03,600
لكن لن تستطيع الاستمرار
.إن سمحنا لذلك بإزعاجنا مرارًا

228
00:14:03,600 --> 00:14:06,870
كلّ ما يمكن فعله هو اتّخاذ الحيطة
.عند التّعامل مع الآخرين

229
00:14:06,870 --> 00:14:07,600
.تفضّلا

230
00:14:07,900 --> 00:14:10,970
!لكنّ هذه البلدة مزعجة بالفعل

231
00:14:11,610 --> 00:14:13,780
.هكذا يفكّر العقلاء على الأرجح

232
00:14:13,780 --> 00:14:17,580
لكن لسوء الحظّ، العقلاء
.نادرون في هذه البلدة

233
00:14:17,580 --> 00:14:19,980
حسنًا، سيتمّ تسجيل المجال
.المغناطيسيّ خلال أربعة أيّام

234
00:14:19,980 --> 00:14:22,420
لذلك عليكم المغادرة قبل
.التّورّط في المشاكل

235
00:14:23,220 --> 00:14:26,290
.أربعة أيّام... لا يمكننا البقاء حتّى ليومين

236
00:14:26,560 --> 00:14:27,690
!أخبرني يا سيّدي

237
00:14:27,690 --> 00:14:28,990
!أيّها العجوز

238
00:14:27,690 --> 00:14:28,990
!أيّها العمّ

239
00:14:29,690 --> 00:14:30,360
ما الخطب؟

240
00:14:30,590 --> 00:14:33,330
!مذاق فطيرة التّوت هذه مقرف جدًّا

241
00:14:30,590 --> 00:14:33,330
!مذاق فطيرة التّوت هذه لذيذ جدًّا

242
00:14:44,040 --> 00:14:47,180
!مذاق هذا الشّراب لذيذ للغاية

243
00:14:44,040 --> 00:14:47,180
!مذاق هذا الشّراب سيّئ للغاية

244
00:14:48,480 --> 00:14:51,080
هل تعاني حاسّة تذوّقك من مشكلة ما؟

245
00:14:51,650 --> 00:14:53,950
هل يعاني رأسك من مشكلة ما؟

246
00:14:54,480 --> 00:14:58,820
.حسنًا، لستُ الطّبّاخ، لذلك لا أهتمّ لرأيكما

247
00:14:59,490 --> 00:15:02,230
اسمع أيّها العمّ! أعطني 50 شطيرة
!لحم لآخذها معي

248
00:15:02,660 --> 00:15:06,260
أيّها العجوز، أعطني 51 فطيرة
!توت لآخذها معي

249
00:15:06,260 --> 00:15:08,100
!مهلاً، أريد 52 شريحة لحم

250
00:15:08,100 --> 00:15:10,030
!آسف، أريد 53 فطيرة

251
00:15:10,030 --> 00:15:11,640
!كلاّ، 54 شريحة

252
00:15:11,640 --> 00:15:12,940
‪‪‫55 فطيرة!

253
00:15:12,940 --> 00:15:13,840
‪‪‫60 شريحة!

254
00:15:13,840 --> 00:15:14,870
‪‪‫70 فطيرة!

255
00:15:14,870 --> 00:15:15,610
!ثمانون

256
00:15:15,610 --> 00:15:16,340
!مائة

257
00:15:17,310 --> 00:15:19,410
!أتريد القتال أيّها الوغد؟

258
00:15:19,410 --> 00:15:21,680
!علام تتشاجران من الأساس؟

259
00:15:21,680 --> 00:15:23,480
!لوفي، لقد وعدتني، أتذكر؟

260
00:15:23,480 --> 00:15:26,220
إضافة إلى أنّنا لا نملك مالاً كافية
!لشراء عشرات شرائح اللّحم

261
00:15:26,220 --> 00:15:27,520
!لم نأتِ للتّسوّق

262
00:15:28,250 --> 00:15:30,020
هل أنت قرصان؟

263
00:15:30,350 --> 00:15:32,420
.نعم، هذا صحيح

264
00:15:32,420 --> 00:15:34,120
كم هي مكافأتك؟

265
00:15:34,120 --> 00:15:35,230
‪‪‫30 مليون!

266
00:15:35,890 --> 00:15:38,700
‪‪‫30 مليون؟ أنت؟

267
00:15:39,160 --> 00:15:41,370
!ذلك مستحيل! أنت تكذب

268
00:15:41,370 --> 00:15:43,570
!لستُ أكذب! إنّها الحقيقة

269
00:15:43,570 --> 00:15:44,430
!توقّفا

270
00:15:44,740 --> 00:15:47,400
!أنتما، الشّجار في الحانة ممنوع

271
00:15:47,900 --> 00:15:51,070
!خذ فطائرك الخمسين وغادر في الحال

272
00:16:10,330 --> 00:16:13,330
هل ثمّة قرصان يرتدي قبّعة قشّ هنا؟

273
00:16:14,200 --> 00:16:16,100
!إ-إنّه بيلامي

274
00:16:21,340 --> 00:16:25,140
أنت هو قبّعة القشّ صاحب
!مكافأة الثّلاثين مليون إذًا

275
00:16:25,740 --> 00:16:27,010
ما هذا؟

276
00:16:27,010 --> 00:16:29,150
.يبدو أنّ لديه شأن معك يا لوفي

277
00:16:29,150 --> 00:16:32,120
أليس بيلامي هو الشّخص
الّذي استأجر ذلك الفندق؟

278
00:16:32,780 --> 00:16:35,150
هل سمعتَ ذلك؟ مكافأة ذلك
.القصير هي 30 مليون

279
00:16:35,150 --> 00:16:36,320
فعلاً؟

280
00:16:36,320 --> 00:16:37,650
أذلك صحيح؟

281
00:16:38,320 --> 00:16:40,560
.أقابل رجلاً طويلاً تلو الآخر اليوم

282
00:16:41,060 --> 00:16:43,460
.أعطني أغلى شراب كحوليّ لديك

283
00:16:43,460 --> 00:16:46,160
.وأعطِ هذا القصير ما يريد أيضًا

284
00:16:46,160 --> 00:16:47,100
.حسنًا

285
00:16:48,430 --> 00:16:51,600
!ماذا؟ هذا المكان ممتلئ

286
00:16:51,600 --> 00:16:54,810
!ما هذا المكان؟ إنّه قذر ورائحته نتنة

287
00:16:54,810 --> 00:16:56,440
.وكلّ ما لديهم هو شراب الرّم الرّخيص

288
00:16:56,870 --> 00:16:59,310
.انظرا. إنّهما من قابلناهما قبل قليل

289
00:17:01,810 --> 00:17:04,510
...عليكم أن تعرضوا علينا مقاعدكم يا هؤلاء

290
00:17:04,880 --> 00:17:06,850
!يا لهم من أغبياء ميؤوس منهم

291
00:17:10,750 --> 00:17:13,760
ذاك هو السّكّين الكبير ساركيس، صحيح؟

292
00:17:13,760 --> 00:17:16,090
هل سيفتعل قتالاً هنا أو ما شابه؟

293
00:17:16,090 --> 00:17:17,160
...مستحيل

294
00:17:18,930 --> 00:17:22,970
الطّاقم بأكمله هنا. مستحيل
.أنّهم أتوا للشّرب فحسب

295
00:17:22,970 --> 00:17:25,100
!دعهم وشأنهم! لا علاقة للأمر بنا

296
00:17:25,540 --> 00:17:27,300
.بيلامي شخص فضوليّ بالفعل

297
00:17:27,300 --> 00:17:28,670
.بكلّ تأكيد

298
00:17:30,940 --> 00:17:32,080
.حسنًا، اشرب

299
00:17:32,080 --> 00:17:35,780
!شكرًا لك! أنت شخص لطيف في الحقيقة

300
00:17:45,390 --> 00:17:46,990
!كلاّ! لقد فعلها

301
00:17:48,890 --> 00:17:51,400
!لم أعرف ما الّذي سيفعله بيلامي

302
00:17:55,400 --> 00:17:57,770
ما معنى هذا أيّها التّابع؟

303
00:17:59,340 --> 00:18:03,040
لماذا لا تخبرني أنت؟

304
00:18:05,010 --> 00:18:07,040
!زورو! تمهّل لحظة

305
00:18:07,040 --> 00:18:09,510
لم نحصل على أيّ معلومات
!في هذه البلدة بعد

306
00:18:08,810 --> 00:18:11,620
!اخرسي! إنّه يسعى للقتال وأنا أقدّمه له

307
00:18:14,520 --> 00:18:16,850
ماذا؟ ما زلت تستطيع الوقوف؟

308
00:18:20,590 --> 00:18:23,730
إذًا فأنت مستعدّ لمواجهتي؟

309
00:18:26,130 --> 00:18:28,170
!مهلاً! سيواجهون بيلامي

310
00:18:28,800 --> 00:18:29,930
!هيّا، هيّا

311
00:18:30,500 --> 00:18:31,700
!لا تدعوهم يهزمونكم

312
00:18:33,440 --> 00:18:35,940
!هذا ليس قتالاً، إنّه اختبار

313
00:18:35,940 --> 00:18:38,680
!هيّا! دعني أرى مدى قوّتك

314
00:18:39,240 --> 00:18:40,210
!انتظر يا لوفي

315
00:18:40,710 --> 00:18:43,250
اسمع يا سيّدي! نبحث عن
!معلومات عن جزيرة السّماء

316
00:18:43,250 --> 00:18:44,980
هل تعرف أيّ شيء عنها؟

317
00:18:49,950 --> 00:18:52,660
ما الّذي قالته تلك الفتاة للتّوّ؟

318
00:18:53,020 --> 00:18:54,460
.لا يعقل أنّها جادّة

319
00:19:02,930 --> 00:19:05,740
كما قلت، إن كنتَ تعرف كيفية
...الذّهاب لجزيرة السّماء

320
00:19:12,510 --> 00:19:14,950
!"قالت "جزيرة السّماء

321
00:19:15,310 --> 00:19:17,450
!هذا لا يصدّق

322
00:19:18,350 --> 00:19:19,580
!ماذا؟

323
00:19:19,580 --> 00:19:23,020
!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل

324
00:19:27,590 --> 00:19:30,660
"!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل"

325
00:19:31,530 --> 00:19:34,160
!تتعطّل البوصلات المسجِّلة بسهولة

326
00:19:37,100 --> 00:19:39,100
.مهلاً، مهلاً، فاجأني هذا

327
00:19:39,100 --> 00:19:44,140
هل تصدّقون أسطورة قديمة
كهذه عن جزيرة في السّماء؟

328
00:19:45,210 --> 00:19:47,440
من أيّ عصر أنتم؟

329
00:19:47,440 --> 00:19:51,110
يتمّ تفسير تيّارات غير عاديّة
.في الغراند لاين الواحد تلو الآخر

330
00:19:51,110 --> 00:19:53,350
.تيّار المحيط الصّاعد هو إحداها

331
00:19:54,620 --> 00:19:57,820
أعتقد أنّكم لا تعرفون بوجود
.شيء كهذا من الأساس

332
00:19:58,390 --> 00:20:01,090
إنّ السّفن الّتي وقعت ضحيّة لهذا التّيّار

333
00:20:01,090 --> 00:20:04,800
تُدفع عاليًا للسّماء بقوّة
!ثم تهوي لتتحطّم في المحيط

334
00:20:05,260 --> 00:20:07,560
،ولأنّ البّحّارة في القِدم كانوا جاهلين بهذا

335
00:20:07,560 --> 00:20:11,500
رأوا مشهدًا غريبًا تسقط فيه السّفن
،من السّماء وتخيّلوا جزيرة السّماء

336
00:20:11,500 --> 00:20:15,340
وظنّوا أنّه لا بدّ من وجود
!عالم آخر في السّماء

337
00:20:15,870 --> 00:20:19,780
.ويا لغبائهم! لكلّ ظاهرة أسبابها

338
00:20:20,510 --> 00:20:24,350
كلّ هذه الأشياء الّتي يحلم بها
!النّاس ستُفسّر قريبًا

339
00:20:26,720 --> 00:20:28,390
!يا للصّدمة

340
00:20:28,390 --> 00:20:32,520
فكّرت أنّني قد أختبرك وأسمح لك بالانضمام
،لطاقمي من أجل العصر الجديد

341
00:20:32,520 --> 00:20:34,320
!لكنّك مجرّد غبيّ واهم

342
00:20:35,530 --> 00:20:40,130
اسمع. إنّ العصر الّذي يحلم
!فيه القراصنة قد ولّى

343
00:20:40,130 --> 00:20:44,740
مدينة الذّهب ومدينة الزّمرّد
...و"ون بيس"، الكنز الكبير الخفيّ

344
00:20:44,740 --> 00:20:48,910
إنّ الأغبياء الّذين أعمتهم كنوز الأحلام
.لا يلاحظون الكنوز الّتي حولهم

345
00:20:48,910 --> 00:20:53,110
في عصر المحيطات هذا، ثمّة الكثيرون
ممّن يقدرون على عبور المحيطات

346
00:20:53,110 --> 00:20:56,680
لكنّهم يضلّون طرقهم بسبب
.تلك الأوهام ويموتون

347
00:20:57,110 --> 00:20:59,880
ويتحدّث النّاس عن أولئك
،الأموات الأغبياء قائلين

348
00:20:59,880 --> 00:21:02,890
"!كان سعيدًا لأنّه عاش حُلمه"

349
00:21:03,990 --> 00:21:06,120
!ما ذلك إلاّ هراء ينطق به فاشلون

350
00:21:06,620 --> 00:21:10,890
عندما أرى أغبياء يطاردون
!أحلامًا كهذه، أشعر بالاشمئزاز

351
00:21:12,630 --> 00:21:13,330
!لوفي

352
00:21:14,800 --> 00:21:18,540
،بما أنّ هنالك قراصنة ضعفاء مثلك

353
00:21:18,540 --> 00:21:23,010
.فذلك يسيء لنا نحن القراصنة الأقوياء

354
00:21:26,340 --> 00:21:29,650
!غادروا أيّها الحثالة
!لا يمكننا الاستمتاع بمشروباتنا

355
00:21:29,650 --> 00:21:31,420
!بيلامي محقّ تمامًا

356
00:21:31,650 --> 00:21:33,120
!غادروا

357
00:21:33,120 --> 00:21:35,090
!غادروا هذه البلدة

358
00:21:36,050 --> 00:21:39,560
يا بيلامي! يبدو أنّ الجميع هنا
!يريدون رؤية عرضك

359
00:21:40,690 --> 00:21:43,090
.لا مشكلة في ذلك

360
00:21:44,960 --> 00:21:49,200
،لوفي! زورو! انسيا أمر الوعد
!أوسعاهم ضربًا بسرعة

361
00:21:50,100 --> 00:21:51,030
...زورو

362
00:21:54,200 --> 00:21:56,540
.لا تقاتلهم مهما حدث

363
00:22:09,600 --> 00:22:17,670
آه، خلف السّماء الّتي لا نهاية لها

364
00:22:17,670 --> 00:22:28,280
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

365
00:22:36,160 --> 00:22:43,600
مرّت عليّ أيّام كدت أخسر فيها نفسي

366
00:22:43,600 --> 00:22:52,010
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

367
00:22:52,010 --> 00:23:00,220
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

368
00:23:00,220 --> 00:23:09,060
دفعوا بي للأمام، أليس كذلك؟

369
00:23:09,060 --> 00:23:17,370
آه، إنّ النّجوم تهوي من السّماء

370
00:23:17,370 --> 00:23:20,500
...وهذه اللّحظة الفريدة

371
00:23:25,680 --> 00:23:28,440
!مهلاً يا لوفي وزورو! ما الخطب؟

372
00:23:28,440 --> 00:23:32,220
،لا فائدة. عندما يتّخذ الرّجال قرارًا
.لا يمكنك دفعهم للعدول عنه

373
00:23:32,220 --> 00:23:34,650
،لا يهمّ كم سيبدوان رائعين
!سينتهي كلّ شيء إن ماتا

374
00:23:34,650 --> 00:23:36,720
!تعالوا أنتم وساعدونا

375
00:23:36,720 --> 00:23:41,090
.ماذا؟ حسنًا، صادفنا نحن أيضًا رجلاً مجنونًا

376
00:23:41,090 --> 00:23:42,390
:في الحلقة القادمة من ون بيس

377
00:23:42,390 --> 00:23:46,530
قراصنة في القمّة! رجل يتحدّث عن"
"!الأحلام وملك اكتشاف الأعماق

378
00:23:46,530 --> 00:23:48,770
!ملك القراصنة، لن يكون إلاّ أنا