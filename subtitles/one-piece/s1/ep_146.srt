1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:02,590 --> 00:02:04,860
.نفد المال منكم جميعًا الآن

22
00:02:05,160 --> 00:02:09,630
لذلك... هل تريد أن تراهن بسروالك
أو ما شابه يا أخي؟

23
00:02:09,900 --> 00:02:11,740
.أنت محظوظ بطريقة ما

24
00:02:11,740 --> 00:02:15,910
،في حالة الفوز عند اللّعب مع روشيو
.لكان جعلك تدفع ثمن ذلك

25
00:02:17,640 --> 00:02:20,310
.آسف، لكنّني سآخذ كلّ مالك

26
00:02:21,350 --> 00:02:25,080
.أفلتني. فزت بهذه اللّعبة بعدل وإنصاف

27
00:02:28,650 --> 00:02:31,960
لقد غششتَ للتّوّ، صحيح؟

28
00:02:31,960 --> 00:02:33,220
أليس كذلك؟

29
00:02:33,920 --> 00:02:36,190
ماذا قلت؟ ومتى فعلتُ ذلك؟

30
00:02:36,460 --> 00:02:40,100
!فعلت! لقد غششت

31
00:02:40,800 --> 00:02:42,830
!لا تطلق اتّهامات سخفية أيّها الوغد

32
00:02:43,330 --> 00:02:46,670
!ساركيس! ساركيس

33
00:02:47,100 --> 00:02:48,810
نعم، ماذا؟

34
00:02:49,140 --> 00:02:52,810
.رأيته أيضًا، صحيح؟ لقد غشّ للتّوّ

35
00:02:52,810 --> 00:02:54,410
غشّ في اللّعب؟

36
00:02:55,010 --> 00:02:59,150
.نعم... هذا صحيح. لقد غشّ

37
00:02:59,150 --> 00:03:02,050
!رأيتُه أيضًا. يا لك من غشّاش قذر

38
00:03:02,050 --> 00:03:05,420
!لا تعبثا معي
!لا تعرفان مع من تتعاملان

39
00:03:33,320 --> 00:03:37,520
!كفاكم حُلمًا"
"!موكتاون، بلدة السّخرية

40
00:03:40,730 --> 00:03:42,360
أما زلت لا تراها يا أوسوبّ؟

41
00:03:42,360 --> 00:03:44,830
.لا، لا أراها بعد

42
00:03:44,830 --> 00:03:47,700
جزيرة جايا هذه ليست بعيدة، صحيح؟

43
00:03:47,700 --> 00:03:50,530
نعم، بما أنّ الطّقس ما زال
،مستقرًّا حتّى الآن

44
00:03:50,530 --> 00:03:52,940
.يجب أن نكون ضمن مناخ الجزيرة

45
00:03:53,340 --> 00:03:55,840
.إذًا لا بدّ أن جايا جزيرة ربيعيّة

46
00:03:55,840 --> 00:03:58,380
.الجوّ جميل ودافئ

47
00:04:00,240 --> 00:04:01,950
.طقس الرّبيع لطيف

48
00:04:02,880 --> 00:04:05,450
.يبدو أنّ النّوارس تستمتع به أيضًا

49
00:04:16,260 --> 00:04:17,630
!أُطلق عليها النّار

50
00:04:17,900 --> 00:04:19,660
!جيّد، لنعدّ ياكيتوري بها

51
00:04:20,060 --> 00:04:23,130
.أُطلق عليها النّار؟ لم أسمع شيئًا

52
00:04:23,130 --> 00:04:24,500
!انظر! وجدتُ رصاصة

53
00:04:24,500 --> 00:04:27,540
حسب اتّجاه طيرانها، أتت الطّلقات
.من حيث تتّجه السّفينة

54
00:04:27,540 --> 00:04:30,410
هل تقول أنّ الطّلقات أتت من جزيرة
لا يمكننا حتّى رؤيتها؟

55
00:04:30,410 --> 00:04:32,510
.ذلك مستحيل يا تشوبّر

56
00:04:32,510 --> 00:04:34,380
.لكنّني كنتُ أراقبها طوال الوقت

57
00:04:35,550 --> 00:04:40,150
إذًا أيّ بصر حادّ ومهارات قنص
وبندقيّة يملكها هذا القنّاص؟

58
00:04:40,150 --> 00:04:42,350
أُطلق عليها في مكان آخر
.وسقطت هنا بالصّدفة

59
00:04:42,950 --> 00:04:45,320
!سانجي، لدينا نوارس

60
00:04:52,830 --> 00:04:55,730
.مسكين... لا بدّ أنّه تعذّب

61
00:04:56,270 --> 00:04:58,570
.لم أستطع قتل أحدها في الحال

62
00:04:59,270 --> 00:05:01,940
.لكنّ ذلك من صنيع القدر أيضًا

63
00:05:01,940 --> 00:05:05,280
.تلك هي نتيجة كيف عشت حياتك

64
00:05:12,250 --> 00:05:15,490
!أنت! هل تعرف من أكون؟

65
00:05:15,490 --> 00:05:17,860
!ماذا؟ لا أعرف أيّها الأبله

66
00:05:17,860 --> 00:05:22,330
ما رأيك أن أخبرك إذًا؟
.أنا بطل المصارعة

67
00:05:26,330 --> 00:05:27,430
!إنّها رائعة

68
00:05:27,430 --> 00:05:29,200
!تبدو بلدة جميلة

69
00:05:29,400 --> 00:05:32,340
مهلاً، ألا تبدو كمنتجع نوعًا ما؟

70
00:05:32,340 --> 00:05:33,470
:منتجع؟

71
00:05:33,470 --> 00:05:34,670
!أسرعي يا ميري

72
00:05:34,870 --> 00:05:38,540
هذا صحيح، تجعلني أشعر
.برغبة في البقاء بعض الشّيء

73
00:05:44,220 --> 00:05:48,450
لكن هل أتخيّل أم أنّ السّفن الّتي ترسو
على الميناء كلّها سفن قراصنة؟

74
00:05:48,450 --> 00:05:50,490
،مهلاً يا أوسوبّ

75
00:05:50,490 --> 00:05:53,820
منذ متى تستطيع سفن القراصنة
أن ترسو علنًا في الموانئ؟

76
00:05:54,330 --> 00:05:55,260
!معك حقّ

77
00:05:57,400 --> 00:05:59,500
!النّجدة! سيقتلني

78
00:05:59,500 --> 00:06:01,600
ما قصّة هذه البلدة؟

79
00:06:03,970 --> 00:06:06,300
!يا لك من ضعيف

80
00:06:07,670 --> 00:06:10,570
.مهلاً يا رجل. اخترت الرّجل الخطأ لتضربه

81
00:06:10,570 --> 00:06:14,150
.انظر لتلك العلامة
.إنّه من طاقم روشيو

82
00:06:14,150 --> 00:06:15,510
سمعتَ به، صحيح؟

83
00:06:15,510 --> 00:06:19,080
إنّه روشيو الجلاّد الّذي تبلغ
.مكافأته 42 مليون بيري

84
00:06:19,080 --> 00:06:23,020
.إنّه مجنون، من الأفضل أن تكون حذرًا

85
00:06:24,820 --> 00:06:29,360
!يا له من رجل متهوّر
.لم يغشّ أبدًا في تلك اللّعبة

86
00:06:29,360 --> 00:06:32,760
لكن من المدهش أنّه هزم
.روشيو الجلاّد بكلّ سهولة هكذا

87
00:06:32,760 --> 00:06:35,030
.ألا تعرفه؟ إنّه بيلامي

88
00:06:35,430 --> 00:06:36,430
!ذاك هو؟

89
00:06:36,430 --> 00:06:40,000
بيلامي الضّبع الّذي تبلغ المكافأة
!على رأسه 55 مليون بيري؟

90
00:06:40,540 --> 00:06:41,840
!أيّها القائد

91
00:06:41,840 --> 00:06:43,470
!من فعل هذا؟

92
00:06:43,470 --> 00:06:45,840
!على أيّ حال، يحتاج طبيبًا بسرعة

93
00:06:45,840 --> 00:06:47,950
.تماسك قليلاً فحسب أيّها القائد

94
00:07:05,100 --> 00:07:07,770
.ثمّة أشخاص من كلّ الأنواع هنا

95
00:07:07,770 --> 00:07:09,370
.تبدو كبلدة ممتعة

96
00:07:10,230 --> 00:07:11,800
...مستحيل

97
00:07:11,800 --> 00:07:14,740
هل تعتقدان أنّ بإمكانهما العودة
دون التّسبّب في المشاكل؟

98
00:07:15,040 --> 00:07:17,610
.حسنًا، تبدو البلدة خطيرة من البداية

99
00:07:17,610 --> 00:07:19,510
.ذلك لا مفرّ منه

100
00:07:19,510 --> 00:07:22,210
!هذا صحيح. لا يمكنهما ذلك

101
00:07:21,310 --> 00:07:22,210
!مهلاً يا نامي

102
00:07:22,680 --> 00:07:26,220
!انتظرا يا لوفي وزورو

103
00:07:27,150 --> 00:07:28,350
...لقد ذهبت

104
00:07:28,720 --> 00:07:31,220
على الأرجح أنّها ستكون
.بخير بما أنّها معهما

105
00:07:31,220 --> 00:07:32,890
ماذا؟ إن كانت نامي-سان
...ذاهبة، فأنا أيضًا

106
00:07:33,690 --> 00:07:35,560
!إيّاك أن تذهب

107
00:07:35,560 --> 00:07:39,900
إن ذهبتَ أنت، ما-ما الّذي سيحدث
!إ-إ-إن هوجمت السّفينة...؟

108
00:07:39,900 --> 00:07:41,770
!لا تذهب أرجوك

109
00:07:41,770 --> 00:07:44,400
!لا بأس! اتركني

110
00:07:44,970 --> 00:07:47,310
حسنًا، أعتقد أنّني سأجهّز بعض
.الشّاي وأحرس السّفينة

111
00:07:48,510 --> 00:07:49,570
أين روبين-تشان؟

112
00:07:49,570 --> 00:07:51,310
.ماذا؟ ليست هنا

113
00:07:53,410 --> 00:07:54,450
...سانجي-كُن، بشأن الشّاي

114
00:07:54,450 --> 00:07:55,250
.حضّره بنفسك

115
00:07:57,080 --> 00:08:00,250
...في هذه البلدة، أنا لن

116
00:08:00,250 --> 00:08:01,950
".لن أقاتل. أعد بهذا"

117
00:08:02,150 --> 00:08:04,290
.لن أقاتل. أعد بهذا

118
00:08:04,590 --> 00:08:06,790
.حسنًا. هذا أمر جادّ

119
00:08:06,790 --> 00:08:07,260
...نعم

120
00:08:07,260 --> 00:08:07,790
.نعم

121
00:08:07,790 --> 00:08:09,860
!ما هذه الرّدود الضّعيفة؟

122
00:08:10,760 --> 00:08:14,600
،إن تسبّبتما بالمشاكل
!سيكون علينا مغادرة هذه البلدة

123
00:08:14,970 --> 00:08:17,800
إن حدث ذلك، لن نكون قادرين
!على الذّهاب للسّماء، أتفهمان؟

124
00:08:17,800 --> 00:08:18,470
.نعم

125
00:08:20,570 --> 00:08:21,140
من يكون؟

126
00:08:21,610 --> 00:08:22,870
.انظرا، وقع من على الحصان

127
00:08:22,870 --> 00:08:24,540
.نعم، وقع

128
00:08:27,980 --> 00:08:28,910
.يبدو أنّه يتألّم

129
00:08:28,910 --> 00:08:29,810
.نعم، إنّه يتألّم

130
00:08:29,810 --> 00:08:34,450
،آسف لإزعاجكم يا جماعة
.لكن ساعدوني على الوقوف أرجوكم

131
00:08:34,450 --> 00:08:36,190
لن تقف وحدك، صحيح؟

132
00:08:37,620 --> 00:08:39,120
.لوفي، احمله من الجانب الآخر

133
00:08:39,120 --> 00:08:39,860
.حسنًا

134
00:08:41,830 --> 00:08:45,560
.حسنًا، شكرًا... أنا على الحصان الآن

135
00:08:46,160 --> 00:08:49,630
.جسدي واهن منذ الولادة

136
00:08:49,630 --> 00:08:51,370
.لنذهب الآن يا تسرونغر

137
00:08:52,470 --> 00:08:53,840
!الحصان أيضًا؟

138
00:08:54,140 --> 00:08:57,070
.يا إلهي، كم هذا مزعج

139
00:08:57,070 --> 00:08:59,680
.شكرًا لكما ثانية

140
00:08:59,910 --> 00:09:03,380
،هذا ليس بالكثيرّ
لكن هل ترغبان ببعضها؟

141
00:09:03,380 --> 00:09:06,820
أنت مريب جدًّا! لا نريد أيًّا
.منها، لذلك غادر فحسب

142
00:09:06,820 --> 00:09:08,650
!إنّه تفّاح! شكرًا لك

143
00:09:08,020 --> 00:09:08,650
!مهلاً، مهلاً

144
00:09:11,990 --> 00:09:14,090
!ماذا؟! ما الّذي حدث؟

145
00:09:14,090 --> 00:09:17,060
كان ثمّة أشخاص يأكلون تفّاحًا
،حصلوا عليه من رجل غريب

146
00:09:17,060 --> 00:09:19,330
!ثمّ انفجروا. كانوا خمسة

147
00:09:21,270 --> 00:09:22,400
...مستحيل

148
00:09:22,700 --> 00:09:26,270
لوفي! ابصقها! ابصق التّفّاحة
!الّتي أكلتها للتّوّ! الآن

149
00:09:26,270 --> 00:09:28,370
.سبق وبلعتها

150
00:09:28,370 --> 00:09:29,510
!أيّها الوغد! ما معنى هذا؟

151
00:09:32,580 --> 00:09:34,350
.حسنًا، لا داعي للقلق

152
00:09:36,250 --> 00:09:37,450
!هذا لا يصدّق

153
00:09:37,450 --> 00:09:39,420
.إنّها كارثة في الدّاخل

154
00:09:39,780 --> 00:09:44,090
،إن كنتَ قد أكلت واحدة فاسدة
.لمتَّ من القضمة الأولى

155
00:09:44,090 --> 00:09:45,060
...أنت

156
00:09:46,990 --> 00:09:48,790
.محظوظ

157
00:09:49,690 --> 00:09:51,530
...هذا فظيع

158
00:09:50,290 --> 00:09:52,560
مهلاً، ما هذا؟

159
00:09:52,560 --> 00:09:55,030
.إنّه قبر روشيو الجلاّد

160
00:09:55,030 --> 00:09:57,300
.يبدو وكأنّ حربًا شنّت هنا

161
00:09:57,640 --> 00:09:59,700
هل أطلقوا مدفعًا
وسط البلدة أو ما شابه؟

162
00:09:59,700 --> 00:10:02,470
من يدري؟ حتّى من كانوا
يشاهدون القتال قالو

163
00:10:02,710 --> 00:10:06,210
.أنّهم لم يستطيعوا فهم ما حدث

164
00:10:06,210 --> 00:10:10,920
كلّ ما نعلمه هو أنّ خصم
.روشيو كان بيلامي

165
00:10:10,920 --> 00:10:12,420
بيلامي الضّبع؟

166
00:10:13,050 --> 00:10:16,150
لا مجال للشّكّ في أنّه يملك إحدى
.قدرات فاكهة الشّيكان

167
00:10:34,840 --> 00:10:36,710
!ما الّذي يجري في هذه البلدة؟

168
00:10:36,970 --> 00:10:39,110
.لا تكوني سريعة الغضب يا نامي

169
00:10:39,340 --> 00:10:42,810
!كدت تموت من دون سبب للتّوّ

170
00:10:43,110 --> 00:10:44,950
.أعتقد أنّ ذلك يحدث أحيانًا

171
00:10:45,220 --> 00:10:46,720
!وهل ذلك مقبول؟

172
00:10:52,420 --> 00:10:54,130
...ذلك الرّجل ثانية

173
00:10:54,130 --> 00:10:55,790
كم ضحيّة نال منها حتّى الآن؟

174
00:10:55,960 --> 00:11:00,300
إنّه ليس رجلاً مطلوبًا مشهورًا
أو ما شابه، فمن يكون يا ترى؟

175
00:11:00,300 --> 00:11:02,000
.حسنًا، لا أريد حتّى أن أعرف

176
00:11:02,000 --> 00:11:06,070
في كلّ الأحوال، علينا الابتعاد
.من البطل المصارع

177
00:11:08,110 --> 00:11:09,270
بطل؟

178
00:11:09,270 --> 00:11:11,680
!ولِمَ هذه الرّوح التّنافسيّة؟

179
00:11:13,980 --> 00:11:17,450
أتساءل إن كنّا نستطيع الحصول
.على معلومات في بلدة كهذه بالفعل

180
00:11:20,720 --> 00:11:21,920
ماذا عن هذا المكان؟

181
00:11:22,520 --> 00:11:24,420
.يبدو مكانًا هادئًا

182
00:11:25,060 --> 00:11:28,290
!بالفعل، إنّه مكان رائع

183
00:11:28,730 --> 00:11:31,600
،إذًا فرغم أنّها بلدة سيّئة
.يوجد فيها أماكن كهذه

184
00:11:31,600 --> 00:11:33,660
لديهم منزل عُطل يطلّ على البحر؟

185
00:11:33,660 --> 00:11:38,940
...في كلّ الأحوال، لا يوجد أحد هنا
.رغم أنّني أشتمّ رائحة طعام

186
00:11:38,940 --> 00:11:44,280
!الـ-المعذرة! أرجوكم لا تدخلوا بدون إذن

187
00:11:44,680 --> 00:11:50,610
هـ-هذا الفندق الاستوائيّ مستأجر
.لبيلامي-ساما وطاقمه

188
00:11:50,610 --> 00:11:54,420
لذلك نطلب من الضّيوف
.الآخرين أن... يغادروا

189
00:11:54,420 --> 00:11:56,490
هذا المكان فندق إذًا؟

190
00:11:56,490 --> 00:11:58,690
،إ-إن رآكم بيلامي-ساما هنا

191
00:11:58,690 --> 00:12:01,890
فستحدث مشكلة، لذلك أطلب
.منكم المغادرة بهدوء

192
00:12:01,890 --> 00:12:03,930
ماذا؟ ما الضّرر من الدّخول فحسب؟

193
00:12:03,930 --> 00:12:05,630
من يكون بيلامي هذا؟

194
00:12:05,930 --> 00:12:07,000
ما الّذي يحدث؟

195
00:12:08,100 --> 00:12:10,770
من يكون هؤلاء الثّلاثة الوضيعون؟

196
00:12:10,770 --> 00:12:14,510
!ساركيس-ساما! مرحبًا بعودتك
...حسنًا، هذا مجرّد

197
00:12:14,510 --> 00:12:16,370
!لا نهتمّ لأعذارك! تخلّص منهم فحسب

198
00:12:16,370 --> 00:12:19,040
!كم ندفع في رأيك لاستئجار هذا المكان؟

199
00:12:19,040 --> 00:12:22,010
إنّها محقّة. عودوا من حيث
!أتيتم أيّها الشّقيّ الغبيّ

200
00:12:22,450 --> 00:12:24,580
أخبريني، أيمكنني إيساعه ضربًا؟

201
00:12:24,580 --> 00:12:25,250
!بالطّبع لا

202
00:12:26,180 --> 00:12:28,250
ستوسعني ضربًا؟

203
00:12:29,250 --> 00:12:30,620
!يا له من فتى مضحك

204
00:12:30,620 --> 00:12:33,260
،على أيّ حال
.لا ترتدون سوى الخِرق

205
00:12:34,530 --> 00:12:38,060
خذوا! التقطوا ذلك المال
.واشتروا لأنفسكم شيئًا يعجبكم

206
00:12:38,060 --> 00:12:41,630
ساركيس، إنّك تضيّع المال هكذا
.بإعطائك إيّاه لأمثالهم

207
00:12:42,970 --> 00:12:45,340
ربّما كان عليّ رميه
.في خندق ما أفضل

208
00:12:45,340 --> 00:12:46,800
ماذا؟ أأنت واثق؟

209
00:12:47,170 --> 00:12:49,010
!لنذهب! هذا مزعج

210
00:12:49,010 --> 00:12:51,010
.مهلاً، مهلاً، بإمكاني المشي وحدي

211
00:12:51,010 --> 00:12:53,010
ماذا؟ لا تريدونه؟

212
00:12:53,840 --> 00:12:57,320
.ساركيس! ليلي! لا تضايقاهم كثيرًا

213
00:12:57,920 --> 00:13:00,050
.ماذا؟  أنت هنا إذًا

214
00:13:01,150 --> 00:13:06,660
عملوا هم أيضًا بجدّ بطريقتهم
.الخاصّة للوصول إلى هنا. انظروا

215
00:13:06,660 --> 00:13:09,760
.بالطّبع، إنّهم حثالة مقارنة بك وببيلامي

216
00:13:09,760 --> 00:13:12,030
إنّهم يبلون حسنًا بالنّسبة
.لكونهم أشخاصًا عاديّين

217
00:13:12,030 --> 00:13:16,000
نعم، وعلى الأرجح لن يستطيعوا النّجاة
.في العصر الجديد الّذي يوشك أن يبدأ

218
00:13:16,300 --> 00:13:21,270
...ومع ذلك... 30 مليون بيري
مكافأة لغرّ مثله؟

219
00:13:21,710 --> 00:13:24,010
.سأُري هذا لبيلامي

220
00:13:25,280 --> 00:13:27,450
!سُحقًا! أنا غاضبة جدًّا

221
00:13:27,950 --> 00:13:29,250
.هذا مؤسف

222
00:13:29,250 --> 00:13:34,490
تعتمد موكتاون على القراصنة
.الّذين ينفقون أموالاً كثيرة هنا

223
00:13:34,790 --> 00:13:37,590
أي أنّ القراصنة الفقراء غير مرحّب بهم؟

224
00:13:37,860 --> 00:13:40,560
.يبدو أنّه لا توجد طريقة لتهدئتك

225
00:13:41,030 --> 00:13:43,130
.تفضّلي، هذا على حسابنا

226
00:13:43,790 --> 00:13:46,900
،بما أنّ هذا المكان يستقطب الأقوياء
.تحدث الكثير من المتاعب

227
00:13:46,900 --> 00:13:49,600
لكن لن تستطيع الاستمرار
.إن سمحنا لذلك بإزعاجنا مرارًا

228
00:13:49,600 --> 00:13:52,870
كلّ ما يمكن فعله هو اتّخاذ الحيطة
.عند التّعامل مع الآخرين

229
00:13:52,870 --> 00:13:53,600
.تفضّلا

230
00:13:53,900 --> 00:13:56,970
!لكنّ هذه البلدة مزعجة بالفعل

231
00:13:57,610 --> 00:13:59,780
.هكذا يفكّر العقلاء على الأرجح

232
00:13:59,780 --> 00:14:03,580
لكن لسوء الحظّ، العقلاء
.نادرون في هذه البلدة

233
00:14:03,580 --> 00:14:05,980
حسنًا، سيتمّ تسجيل المجال
.المغناطيسيّ خلال أربعة أيّام

234
00:14:05,980 --> 00:14:08,420
لذلك عليكم المغادرة قبل
.التّورّط في المشاكل

235
00:14:09,220 --> 00:14:12,290
.أربعة أيّام... لا يمكننا البقاء حتّى ليومين

236
00:14:12,560 --> 00:14:13,690
!أخبرني يا سيّدي

237
00:14:13,690 --> 00:14:14,990
!أيّها العجوز

238
00:14:13,690 --> 00:14:14,990
!أيّها العمّ

239
00:14:15,690 --> 00:14:16,360
ما الخطب؟

240
00:14:16,590 --> 00:14:19,330
!مذاق فطيرة التّوت هذه مقرف جدًّا

241
00:14:16,590 --> 00:14:19,330
!مذاق فطيرة التّوت هذه لذيذ جدًّا

242
00:14:30,040 --> 00:14:33,180
!مذاق هذا الشّراب لذيذ للغاية

243
00:14:30,040 --> 00:14:33,180
!مذاق هذا الشّراب سيّئ للغاية

244
00:14:34,480 --> 00:14:37,080
هل تعاني حاسّة تذوّقك من مشكلة ما؟

245
00:14:37,650 --> 00:14:39,950
هل يعاني رأسك من مشكلة ما؟

246
00:14:40,480 --> 00:14:44,820
.حسنًا، لستُ الطّبّاخ، لذلك لا أهتمّ لرأيكما

247
00:14:45,490 --> 00:14:48,230
اسمع أيّها العمّ! أعطني 50 شطيرة
!لحم لآخذها معي

248
00:14:48,660 --> 00:14:52,260
أيّها العجوز، أعطني 51 فطيرة
!توت لآخذها معي

249
00:14:52,260 --> 00:14:54,100
!مهلاً، أريد 52 شريحة لحم

250
00:14:54,100 --> 00:14:56,030
!آسف، أريد 53 فطيرة

251
00:14:56,030 --> 00:14:57,640
!كلاّ، 54 شريحة

252
00:14:57,640 --> 00:14:58,940
‪‪‫55 فطيرة!

253
00:14:58,940 --> 00:14:59,840
‪‪‫60 شريحة!

254
00:14:59,840 --> 00:15:00,870
‪‪‫70 فطيرة!

255
00:15:00,870 --> 00:15:01,610
!ثمانون

256
00:15:01,610 --> 00:15:02,340
!مائة

257
00:15:03,310 --> 00:15:05,410
!أتريد القتال أيّها الوغد؟

258
00:15:05,410 --> 00:15:07,680
!علام تتشاجران من الأساس؟

259
00:15:07,680 --> 00:15:09,480
!لوفي، لقد وعدتني، أتذكر؟

260
00:15:09,480 --> 00:15:12,220
إضافة إلى أنّنا لا نملك مالاً كافية
!لشراء عشرات شرائح اللّحم

261
00:15:12,220 --> 00:15:13,520
!لم نأتِ للتّسوّق

262
00:15:14,250 --> 00:15:16,020
هل أنت قرصان؟

263
00:15:16,350 --> 00:15:18,420
.نعم، هذا صحيح

264
00:15:18,420 --> 00:15:20,120
كم هي مكافأتك؟

265
00:15:20,120 --> 00:15:21,230
‪‪‫30 مليون!

266
00:15:21,890 --> 00:15:24,700
‪‪‫30 مليون؟ أنت؟

267
00:15:25,160 --> 00:15:27,370
!ذلك مستحيل! أنت تكذب

268
00:15:27,370 --> 00:15:29,570
!لستُ أكذب! إنّها الحقيقة

269
00:15:29,570 --> 00:15:30,430
!توقّفا

270
00:15:30,740 --> 00:15:33,400
!أنتما، الشّجار في الحانة ممنوع

271
00:15:33,900 --> 00:15:37,070
!خذ فطائرك الخمسين وغادر في الحال

272
00:15:56,330 --> 00:15:59,330
هل ثمّة قرصان يرتدي قبّعة قشّ هنا؟

273
00:16:00,200 --> 00:16:02,100
!إ-إنّه بيلامي

274
00:16:07,340 --> 00:16:11,140
أنت هو قبّعة القشّ صاحب
!مكافأة الثّلاثين مليون إذًا

275
00:16:11,740 --> 00:16:13,010
ما هذا؟

276
00:16:13,010 --> 00:16:15,150
.يبدو أنّ لديه شأن معك يا لوفي

277
00:16:15,150 --> 00:16:18,120
أليس بيلامي هو الشّخص
الّذي استأجر ذلك الفندق؟

278
00:16:18,780 --> 00:16:21,150
هل سمعتَ ذلك؟ مكافأة ذلك
.القصير هي 30 مليون

279
00:16:21,150 --> 00:16:22,320
فعلاً؟

280
00:16:22,320 --> 00:16:23,650
أذلك صحيح؟

281
00:16:24,320 --> 00:16:26,560
.أقابل رجلاً طويلاً تلو الآخر اليوم

282
00:16:27,060 --> 00:16:29,460
.أعطني أغلى شراب كحوليّ لديك

283
00:16:29,460 --> 00:16:32,160
.وأعطِ هذا القصير ما يريد أيضًا

284
00:16:32,160 --> 00:16:33,100
.حسنًا

285
00:16:34,430 --> 00:16:37,600
!ماذا؟ هذا المكان ممتلئ

286
00:16:37,600 --> 00:16:40,810
!ما هذا المكان؟ إنّه قذر ورائحته نتنة

287
00:16:40,810 --> 00:16:42,440
.وكلّ ما لديهم هو شراب الرّم الرّخيص

288
00:16:42,870 --> 00:16:45,310
.انظرا. إنّهما من قابلناهما قبل قليل

289
00:16:47,810 --> 00:16:50,510
...عليكم أن تعرضوا علينا مقاعدكم يا هؤلاء

290
00:16:50,880 --> 00:16:52,850
!يا لهم من أغبياء ميؤوس منهم

291
00:16:56,750 --> 00:16:59,760
ذاك هو السّكّين الكبير ساركيس، صحيح؟

292
00:16:59,760 --> 00:17:02,090
هل سيفتعل قتالاً هنا أو ما شابه؟

293
00:17:02,090 --> 00:17:03,160
...مستحيل

294
00:17:04,930 --> 00:17:08,970
الطّاقم بأكمله هنا. مستحيل
.أنّهم أتوا للشّرب فحسب

295
00:17:08,970 --> 00:17:11,100
!دعهم وشأنهم! لا علاقة للأمر بنا

296
00:17:11,540 --> 00:17:13,300
.بيلامي شخص فضوليّ بالفعل

297
00:17:13,300 --> 00:17:14,670
.بكلّ تأكيد

298
00:17:16,940 --> 00:17:18,080
.حسنًا، اشرب

299
00:17:18,080 --> 00:17:21,780
!شكرًا لك! أنت شخص لطيف في الحقيقة

300
00:17:31,390 --> 00:17:32,990
!كلاّ! لقد فعلها

301
00:17:34,890 --> 00:17:37,400
!لم أعرف ما الّذي سيفعله بيلامي

302
00:17:41,400 --> 00:17:43,770
ما معنى هذا أيّها التّابع؟

303
00:17:45,340 --> 00:17:49,040
لماذا لا تخبرني أنت؟

304
00:17:51,010 --> 00:17:53,040
!زورو! تمهّل لحظة

305
00:17:53,040 --> 00:17:55,510
لم نحصل على أيّ معلومات
!في هذه البلدة بعد

306
00:17:54,810 --> 00:17:57,620
!اخرسي! إنّه يسعى للقتال وأنا أقدّمه له

307
00:18:00,520 --> 00:18:02,850
ماذا؟ ما زلت تستطيع الوقوف؟

308
00:18:06,590 --> 00:18:09,730
إذًا فأنت مستعدّ لمواجهتي؟

309
00:18:12,130 --> 00:18:14,170
!مهلاً! سيواجهون بيلامي

310
00:18:14,800 --> 00:18:15,930
!هيّا، هيّا

311
00:18:16,500 --> 00:18:17,700
!لا تدعوهم يهزمونكم

312
00:18:19,440 --> 00:18:21,940
!هذا ليس قتالاً، إنّه اختبار

313
00:18:21,940 --> 00:18:24,680
!هيّا! دعني أرى مدى قوّتك

314
00:18:25,240 --> 00:18:26,210
!انتظر يا لوفي

315
00:18:26,710 --> 00:18:29,250
اسمع يا سيّدي! نبحث عن
!معلومات عن جزيرة السّماء

316
00:18:29,250 --> 00:18:30,980
هل تعرف أيّ شيء عنها؟

317
00:18:35,950 --> 00:18:38,660
ما الّذي قالته تلك الفتاة للتّوّ؟

318
00:18:39,020 --> 00:18:40,460
.لا يعقل أنّها جادّة

319
00:18:48,930 --> 00:18:51,740
كما قلت، إن كنتَ تعرف كيفية
...الذّهاب لجزيرة السّماء

320
00:18:58,510 --> 00:19:00,950
!"قالت "جزيرة السّماء

321
00:19:01,310 --> 00:19:03,450
!هذا لا يصدّق

322
00:19:04,350 --> 00:19:05,580
!ماذا؟

323
00:19:05,580 --> 00:19:09,020
!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل

324
00:19:13,590 --> 00:19:16,660
"!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل"

325
00:19:17,530 --> 00:19:20,160
!تتعطّل البوصلات المسجِّلة بسهولة

326
00:19:23,100 --> 00:19:25,100
.مهلاً، مهلاً، فاجأني هذا

327
00:19:25,100 --> 00:19:30,140
هل تصدّقون أسطورة قديمة
كهذه عن جزيرة في السّماء؟

328
00:19:31,210 --> 00:19:33,440
من أيّ عصر أنتم؟

329
00:19:33,440 --> 00:19:37,110
يتمّ تفسير تيّارات غير عاديّة
.في الغراند لاين الواحد تلو الآخر

330
00:19:37,110 --> 00:19:39,350
.تيّار المحيط الصّاعد هو إحداها

331
00:19:40,620 --> 00:19:43,820
أعتقد أنّكم لا تعرفون بوجود
.شيء كهذا من الأساس

332
00:19:44,390 --> 00:19:47,090
إنّ السّفن الّتي وقعت ضحيّة لهذا التّيّار

333
00:19:47,090 --> 00:19:50,800
تُدفع عاليًا للسّماء بقوّة
!ثم تهوي لتتحطّم في المحيط

334
00:19:51,260 --> 00:19:53,560
،ولأنّ البّحّارة في القِدم كانوا جاهلين بهذا

335
00:19:53,560 --> 00:19:57,500
رأوا مشهدًا غريبًا تسقط فيه السّفن
،من السّماء وتخيّلوا جزيرة السّماء

336
00:19:57,500 --> 00:20:01,340
وظنّوا أنّه لا بدّ من وجود
!عالم آخر في السّماء

337
00:20:01,870 --> 00:20:05,780
.ويا لغبائهم! لكلّ ظاهرة أسبابها

338
00:20:06,510 --> 00:20:10,350
كلّ هذه الأشياء الّتي يحلم بها
!النّاس ستُفسّر قريبًا

339
00:20:12,720 --> 00:20:14,390
!يا للصّدمة

340
00:20:14,390 --> 00:20:18,520
فكّرت أنّني قد أختبرك وأسمح لك بالانضمام
،لطاقمي من أجل العصر الجديد

341
00:20:18,520 --> 00:20:20,320
!لكنّك مجرّد غبيّ واهم

342
00:20:21,530 --> 00:20:26,130
اسمع. إنّ العصر الّذي يحلم
!فيه القراصنة قد ولّى

343
00:20:26,130 --> 00:20:30,740
مدينة الذّهب ومدينة الزّمرّد
...و"ون بيس"، الكنز الكبير الخفيّ

344
00:20:30,740 --> 00:20:34,910
إنّ الأغبياء الّذين أعمتهم كنوز الأحلام
.لا يلاحظون الكنوز الّتي حولهم

345
00:20:34,910 --> 00:20:39,110
في عصر المحيطات هذا، ثمّة الكثيرون
ممّن يقدرون على عبور المحيطات

346
00:20:39,110 --> 00:20:42,680
لكنّهم يضلّون طرقهم بسبب
.تلك الأوهام ويموتون

347
00:20:43,110 --> 00:20:45,880
ويتحدّث النّاس عن أولئك
،الأموات الأغبياء قائلين

348
00:20:45,880 --> 00:20:48,890
"!كان سعيدًا لأنّه عاش حُلمه"

349
00:20:49,990 --> 00:20:52,120
!ما ذلك إلاّ هراء ينطق به فاشلون

350
00:20:52,620 --> 00:20:56,890
عندما أرى أغبياء يطاردون
!أحلامًا كهذه، أشعر بالاشمئزاز

351
00:20:58,630 --> 00:20:59,330
!لوفي

352
00:21:00,800 --> 00:21:04,540
،بما أنّ هنالك قراصنة ضعفاء مثلك

353
00:21:04,540 --> 00:21:09,010
.فذلك يسيء لنا نحن القراصنة الأقوياء

354
00:21:12,340 --> 00:21:15,650
!غادروا أيّها الحثالة
!لا يمكننا الاستمتاع بمشروباتنا

355
00:21:15,650 --> 00:21:17,420
!بيلامي محقّ تمامًا

356
00:21:17,650 --> 00:21:19,120
!غادروا

357
00:21:19,120 --> 00:21:21,090
!غادروا هذه البلدة

358
00:21:22,050 --> 00:21:25,560
يا بيلامي! يبدو أنّ الجميع هنا
!يريدون رؤية عرضك

359
00:21:26,690 --> 00:21:29,090
.لا مشكلة في ذلك

360
00:21:30,960 --> 00:21:35,200
،لوفي! زورو! انسيا أمر الوعد
!أوسعاهم ضربًا بسرعة

361
00:21:36,100 --> 00:21:37,030
...زورو

362
00:21:40,200 --> 00:21:42,540
.لا تقاتلهم مهما حدث

363
00:21:55,600 --> 00:22:03,670
آه، خلف السّماء الّتي لا نهاية لها

364
00:22:03,670 --> 00:22:14,280
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

365
00:22:22,160 --> 00:22:29,600
مرّت عليّ أيّام كدت أخسر فيها نفسي

366
00:22:29,600 --> 00:22:38,010
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

367
00:22:38,010 --> 00:22:46,220
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

368
00:22:46,220 --> 00:22:55,060
دفعوا بي للأمام، أليس كذلك؟

369
00:22:55,060 --> 00:23:03,370
آه، إنّ النّجوم تهوي من السّماء

370
00:23:03,370 --> 00:23:06,500
...وهذه اللّحظة الفريدة

371
00:23:11,680 --> 00:23:14,440
!مهلاً يا لوفي وزورو! ما الخطب؟

372
00:23:14,440 --> 00:23:18,220
،لا فائدة. عندما يتّخذ الرّجال قرارًا
.لا يمكنك دفعهم للعدول عنه

373
00:23:18,220 --> 00:23:20,650
،لا يهمّ كم سيبدوان رائعين
!سينتهي كلّ شيء إن ماتا

374
00:23:20,650 --> 00:23:22,720
!تعالوا أنتم وساعدونا

375
00:23:22,720 --> 00:23:27,090
.ماذا؟ حسنًا، صادفنا نحن أيضًا رجلاً مجنونًا

376
00:23:27,090 --> 00:23:28,390
:في الحلقة القادمة من ون بيس

377
00:23:28,390 --> 00:23:32,530
قراصنة في القمّة! رجل يتحدّث عن"
"!الأحلام وملك اكتشاف الأعماق

378
00:23:32,530 --> 00:23:34,770
!ملك القراصنة، لن يكون إلاّ أنا