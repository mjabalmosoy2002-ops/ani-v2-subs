1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,940 --> 00:02:05,530
في الطّريق إلى هنا، قطع الحبال
!وحاول الهرب، لذلك أفقدته وعيه

29
00:02:05,530 --> 00:02:08,280
!لا تقلق، ما زال حيًّا

30
00:02:13,700 --> 00:02:18,340
كيف أمكنك فعل ذلك لوريث كوزكي
الّذي كان سيّدك في الماضي...؟

31
00:02:18,870 --> 00:02:21,880
!لديك قلب بارد ومن حجر

32
00:02:21,880 --> 00:02:25,880
انتهيت من لعب الدّور، لذلك
.فهو الآن مجرّد شقيّ لا أعرفه

33
00:02:25,880 --> 00:02:30,120
!أبليتَ حسنًا بقيامك بدور الجاسوس لوقت طويل

34
00:02:30,120 --> 00:02:31,850
!أحسنت عملاً

35
00:02:31,850 --> 00:02:33,730
!لا يا أوروتشي-ساما

36
00:02:33,730 --> 00:02:36,580
...بل فشلت في اعتراض خطّة الأكازايا

37
00:02:36,580 --> 00:02:43,440
بسبب هجوم طاقم قبّعة القشّ
!وبقيّة طواقم القراصنة المفاجئ

38
00:02:43,440 --> 00:02:45,440
!ماذا؟! فشلت؟

39
00:02:45,440 --> 00:02:52,160
،قوّات المتمرّدين، 5400 محاربًا
!يتقدّمون الآن نحو أونيغاشيما

40
00:02:52,910 --> 00:02:54,330
!لوفي؟

41
00:02:54,330 --> 00:02:57,120
هـ-هل ما زالوا أحياء؟

42
00:02:57,120 --> 00:03:02,670
!أ-أي أنّك تقول أنّ الـ-الأكازايا ما زالوا موجودين؟

43
00:03:04,000 --> 00:03:06,360
!سُحقًا لك

44
00:03:06,360 --> 00:03:09,390
!فشلت في اعتراض خطّتهم؟

45
00:03:09,840 --> 00:03:11,430
!بلاك ماريا

46
00:03:11,430 --> 00:03:13,260
!أعطني إيّاه

47
00:03:13,260 --> 00:03:19,360
!هذا صحيح! لا يجب أن ننسى
!إنّه قائد العدوّ

48
00:03:20,690 --> 00:03:23,980
!جهّزوا منصّة الإعدام

49
00:03:23,980 --> 00:03:30,530
،إن انتهى نسل عائلة كوزكي البارزة
!فإنّ ولاءهم المتعفّن سينهار أيضًا

50
00:03:30,530 --> 00:03:33,080
!وسينتهي الأمر

51
00:03:36,490 --> 00:03:38,040
...لوفي

52
00:03:38,950 --> 00:03:40,800
...رفاق

53
00:03:41,160 --> 00:03:43,130
...أبتاه

54
00:03:44,550 --> 00:03:47,140
!ها هو ذا الهجوم المفجّر

55
00:03:55,270 --> 00:03:57,270
!موتا

56
00:03:57,560 --> 00:04:00,330
!أيّها السّائق أوسوبّ، الآن

57
00:04:00,330 --> 00:04:03,060
!حسنًا! الطّلقة المباشرة

58
00:04:05,230 --> 00:04:08,030
!إليك بعض الحلوى الإضافيّة! استمتعي

59
00:04:16,410 --> 00:04:22,860
أنتما، لا تظنّان فعلاً أنّ بإمكانكما
،الإطاحة بي بهذه السّهولة

60
00:04:22,860 --> 00:04:26,380
!أليس كذلك؟

61
00:04:26,590 --> 00:04:29,300
!لا تعبثا معي

62
00:04:29,800 --> 00:04:32,590
أيّها القائد، ما-ما أوامرك...؟

63
00:04:32,590 --> 00:04:35,350
...تـ-تعرف ما قد أقوله

64
00:04:37,270 --> 00:04:39,850
!لنقم بتراجع تكتيكيّ

65
00:04:39,850 --> 00:04:41,640
!عرفتُ أنّ الأمر لن ينجح

66
00:04:41,640 --> 00:04:43,230
!بالطّبع لن ينجح

67
00:04:43,230 --> 00:04:46,110
!أيّها التّانوكي

68
00:04:49,520 --> 00:04:53,760
،رغم أنّهما كانا خائفين
...هربا في الاتّجاه المعاكس

69
00:04:53,760 --> 00:04:57,950
...شكرًا لكما أيّها القائد تشوبّر والسّائق أوسوبّ

70
00:04:59,700 --> 00:05:01,580
!اللّعنة عليك

71
00:05:07,380 --> 00:05:09,340
!أيّها الوغد

72
00:05:20,680 --> 00:05:21,680
ماذا؟

73
00:05:27,150 --> 00:05:29,360
!من تكون يا هذا؟

74
00:05:29,360 --> 00:05:30,900
!ومن تكونين؟

75
00:05:41,490 --> 00:05:46,830
"!باغوا الرّعد! ها قد أتى ابن كايدو"

76
00:06:11,940 --> 00:06:13,240
!أخيرًا

77
00:06:13,690 --> 00:06:16,280
!وصلت أخيرًا

78
00:06:29,870 --> 00:06:31,670
!كنت في الانتظار

79
00:06:31,670 --> 00:06:34,630
!انتظرت كلّ هذا الوقت

80
00:06:42,520 --> 00:06:44,730
...لأراك

81
00:06:46,690 --> 00:06:51,440
!انتظرت كلّ هذا الوقت من أجل هذه اللّحظة

82
00:07:17,800 --> 00:07:22,010
!كيد! التّسلّل بشكل مباشرة أمر متهوّر كما توقّعت

83
00:07:23,260 --> 00:07:26,310
!كفّ عن الشّكوى واحمِ ظهري

84
00:07:26,310 --> 00:07:29,650
!بإمكاننا أن ننجح معًا

85
00:07:30,350 --> 00:07:31,480
!أنت على حقّ

86
00:07:32,190 --> 00:07:35,860
...لقد افترقنا عن هيت والبقيّة

87
00:07:35,860 --> 00:07:38,090
،ممّن كانوا يقاتلون معنا

88
00:07:38,090 --> 00:07:40,530
.لكنّهم سيكونون بخير بطريقة ما

89
00:07:45,700 --> 00:07:47,000
!تنافر

90
00:07:56,170 --> 00:08:01,470
!إن قتلناكم، سنحصل على فرصة لنترقّى

91
00:08:01,470 --> 00:08:04,140
...إن كان هدفكم عاليًا لهذه الدّرجة

92
00:08:04,720 --> 00:08:08,600
!فجهّزوا أنفسكم وأروني ما لديكم

93
00:08:12,230 --> 00:08:13,690
!توقّف رجاءً

94
00:08:13,690 --> 00:08:15,480
!كايدو-ساما يبحث عنك

95
00:08:15,480 --> 00:08:18,610
!كفّوا عن مضايقتي! دعوني وشأني

96
00:08:18,610 --> 00:08:21,740
!يا سيّدي الصّغير! توقّف رجاءً

97
00:08:21,740 --> 00:08:26,080
!إن أرخيتم دفاعاتكم، فستموتون

98
00:08:32,210 --> 00:08:35,210
!بي-تان

99
00:08:35,210 --> 00:08:39,170
!بي-تان! هل أنت بخير؟

100
00:08:39,170 --> 00:08:44,560
!تماسك-أرينسو

101
00:08:44,890 --> 00:08:46,470
!أنت

102
00:08:47,640 --> 00:08:49,180
...كيف أمكنك

103
00:08:49,180 --> 00:08:52,230
!كيف أمكنك فعل هذا ببي-تان؟

104
00:08:52,230 --> 00:08:56,980
!لا تتنمّر لأخي بي-تان

105
00:09:00,900 --> 00:09:04,370
.أنت من تزلّج فوقه على الدّرج وكأنّه مزلجة

106
00:09:18,300 --> 00:09:20,900
!قل أنّني أخت كبيرة مذهلة

107
00:09:20,900 --> 00:09:22,220
...لكن

108
00:09:22,920 --> 00:09:24,660
.لا يمكنني الرّكض أكثر

109
00:09:24,660 --> 00:09:28,930
!يا بي-تان! أنا متعبة-أرينسو

110
00:09:28,930 --> 00:09:31,100
!لا أهتمّ! هيّا بنا

111
00:09:31,100 --> 00:09:36,770
لا طاقة لديّ... حتّى أخي العزيز
...يعتبرني حمقاء

112
00:09:36,770 --> 00:09:39,910
!يا لي من مسكينة

113
00:09:40,480 --> 00:09:44,200
!لا تؤخّريني! اجلسي هناك فحسب إن كنت متعبة

114
00:09:44,200 --> 00:09:46,530
...لماذا لا يمكنك أن تقول

115
00:09:48,160 --> 00:09:49,460
!مصيبة

116
00:09:50,120 --> 00:09:53,620
"!دعني أحملك على ظهري؟"

117
00:09:53,620 --> 00:09:56,580
!ابتعدي عنّي! هيّا

118
00:09:56,580 --> 00:09:59,590
!مهلاً! اتركيني يا أختي

119
00:10:00,130 --> 00:10:01,090
...أيّها الـ

120
00:10:01,090 --> 00:10:03,340
!اسمعي! أنا جادّ! توقّفي

121
00:10:05,930 --> 00:10:07,310
!بي-تان؟

122
00:10:07,680 --> 00:10:10,390
!بي-تان! بي-تان! بي-تان

123
00:10:10,390 --> 00:10:13,510
!تماسك، تماسك، تماسك

124
00:10:13,600 --> 00:10:18,320
!يا أخي بي-تان

125
00:10:20,770 --> 00:10:21,780
ماذا؟

126
00:10:22,440 --> 00:10:24,050
!بي-تان

127
00:10:24,050 --> 00:10:29,200
!ضحّى بي-تان بنفسه لإنقاذي

128
00:10:32,750 --> 00:10:35,540
!كلاّ! لم أفعل أيّ شيء

129
00:10:37,170 --> 00:10:41,670
ما اسمك؟! تحت إمرة من تعمل
!وإلى أيّ وحدة تنتمي؟

130
00:10:41,670 --> 00:10:44,260
...لا يا أختي

131
00:10:45,130 --> 00:10:46,840
.إنّه متسلّل

132
00:10:46,840 --> 00:10:48,910
!ماذا؟

133
00:10:48,910 --> 00:10:52,560
!أنت! من تكون يا هذا؟

134
00:10:59,360 --> 00:11:01,070
!أنا لوفي

135
00:11:02,320 --> 00:11:05,030
!الرّجل الّذي سيصير ملك القراصنة

136
00:11:15,450 --> 00:11:20,420
أتعرف في قلعة من أنت الآن؟

137
00:11:20,420 --> 00:11:25,920
!لا مجال للشّكّ أنّ كايدو-ساما سيصير ملك القراصنة

138
00:11:29,010 --> 00:11:32,100
!أيّها المغفّل

139
00:11:32,810 --> 00:11:37,020
!سأحطّم جمجمتك

140
00:11:37,310 --> 00:11:38,890
!نطحة؟

141
00:11:39,600 --> 00:11:42,230
!مدفع رأس أولتي

142
00:13:03,100 --> 00:13:05,940
!يا أختي

143
00:13:06,480 --> 00:13:08,780
...أعلم

144
00:13:14,530 --> 00:13:16,450
أنت أيضًا يا بي-تان؟

145
00:13:16,450 --> 00:13:17,790
!نعم

146
00:13:46,480 --> 00:13:50,030
...المعذرة، لكن

147
00:13:50,030 --> 00:13:53,490
!لماذا تحوّلتما؟

148
00:13:54,900 --> 00:13:57,000
!أولتي-ساما

149
00:13:59,570 --> 00:14:01,830
!بيج وان-ساما

150
00:14:04,120 --> 00:14:06,790
...أولتي-ساما؟ عفوًا

151
00:14:06,790 --> 00:14:09,000
!اخرس

152
00:14:09,590 --> 00:14:11,680
...لأنّنا

153
00:14:12,260 --> 00:14:16,180
!اعترفنا به كعدوّ قويّ

154
00:14:16,180 --> 00:14:21,060
!لا، لا، لا، تحطّم رأسه وقد مات

155
00:14:25,900 --> 00:14:28,770
!كيف تفسّر إذًا ذلك الهاكي؟

156
00:14:28,770 --> 00:14:31,230
!آلمني ذلك

157
00:14:38,860 --> 00:14:43,670
...ثمّة الكثير من الأقوياء هنا

158
00:14:50,710 --> 00:14:53,180
.كنت أقلّل من شأنهم

159
00:14:54,210 --> 00:14:56,140
.كنت مخطئًا

160
00:14:58,050 --> 00:15:00,520
!تنتمي هذه القلعة لأحد اليونكو

161
00:15:57,700 --> 00:16:01,620
!سأدمّرك

162
00:16:34,610 --> 00:16:37,110
...فاكهة المطّاط

163
00:16:54,380 --> 00:16:56,250
!أختي

164
00:17:11,770 --> 00:17:13,650
...فاكهة المطّاط

165
00:17:14,900 --> 00:17:18,070
!مسدّس الفيل

166
00:17:23,900 --> 00:17:26,490
!بيج وان-ساما! هل أنت بخير؟

167
00:17:26,490 --> 00:17:28,500
...بيج وان-ساما

168
00:17:30,700 --> 00:17:33,670
!أيّها الوغد

169
00:17:33,790 --> 00:17:38,210
!كيف تجرؤ على فعل ذلك لبي-تان؟

170
00:17:43,590 --> 00:17:45,970
!سأدمّرك

171
00:17:45,970 --> 00:17:48,220
!تحوّلت أولتي-ساما لديناصور أيضًا

172
00:17:48,220 --> 00:17:50,760
!رجاءً! لن تتحمّل القلعة أكثر

173
00:17:50,760 --> 00:17:54,700
!اخرس! لا تملِ عليّ ما أفعله

174
00:17:54,700 --> 00:17:57,060
!مدفع رأس أولتي

175
00:18:02,320 --> 00:18:05,590
!يا لصلابة رأسك

176
00:18:05,590 --> 00:18:11,120
!لن ينتهي هذا حتّى يُحطَّم بالكامل

177
00:18:23,300 --> 00:18:26,810
!إنّها... شديدة القوّة

178
00:18:32,050 --> 00:18:37,520
!سوف أفتح رأسك

179
00:18:41,980 --> 00:18:46,160
!مدفع رأس أولتي

180
00:19:02,960 --> 00:19:04,250
!كلاّ

181
00:19:04,250 --> 00:19:06,680
!المستوى الرّابع

182
00:19:28,700 --> 00:19:31,450
!باغوا الرّعد

183
00:21:06,330 --> 00:21:08,590
!قبّعة القشّ لوفي

184
00:21:12,420 --> 00:21:13,930
!هذا أنت، صحيح؟

185
00:21:19,300 --> 00:21:20,940
!هذا صحيح

186
00:21:22,310 --> 00:21:26,150
...أنا

187
00:21:34,280 --> 00:21:35,610
!من أنت؟

188
00:21:35,610 --> 00:21:36,740
!إنّه يهرب

189
00:21:36,740 --> 00:21:37,450
!ياماتو-ساما

190
00:21:37,450 --> 00:21:39,830
!أمسكوه

191
00:21:45,120 --> 00:21:48,670
!أنا أعتذر! لن ألحق بك أيّ ضرر

192
00:21:55,090 --> 00:21:59,770
...أعلم، لا يبدو أنّك قد تفعل ذلك

193
00:22:00,100 --> 00:22:03,110
!اسمع، عليّ الذّهاب

194
00:22:03,640 --> 00:22:05,730
!كنتُ في انتظارك

195
00:22:10,230 --> 00:22:13,150
!أخيرًا! أتيتَ إلى هنا أخيرًا

196
00:22:14,230 --> 00:22:18,160
!انتظرتك لوقت طويل

197
00:22:18,160 --> 00:22:20,660
!وقت طويل جدًّا

198
00:22:28,500 --> 00:22:30,930
!اسمي ياماتو

199
00:22:31,510 --> 00:22:34,220
!أنا ابن كايدو

200
00:23:04,120 --> 00:23:06,440
!كالمستجير من الرّمضاء بالنّار

201
00:23:06,440 --> 00:23:12,170
،هرب لوفي من عضوي توبي روبّو مرعبين
.ليجد ياماتو، ابن كايدو، واقفًا في طريقه

202
00:23:12,170 --> 00:23:17,410
!إنّه يخفي طموحه ويظهر قوّته الوحشيّة
!ما الّذي يريده من لوفي؟

203
00:23:17,410 --> 00:23:22,020
.عندما يتصادم الاثنان، ستُكشف حقيقة أخرى

204
00:23:22,390 --> 00:23:26,730
:في الحلقة القادمة من وان بيس
"!عدوّ أم صديق؟ لوفي وياماتو"

205
00:23:26,730 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا