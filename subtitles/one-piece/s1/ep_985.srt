1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,370 --> 00:02:03,570
تغزو مجموعة كينييمون أونيغاشيما
.للإطاحة بكايدو والتّخلّص من أوروتشي

29
00:02:03,570 --> 00:02:09,660
ويستقلّ ساموراي الأكازايا غوّاصة لو
.في اتّجاه المدخل الخلفيّ للجزيرة

30
00:02:09,660 --> 00:02:12,430
!حسنًا! علينا التّحرّك نحن أيضًا

31
00:02:12,430 --> 00:02:13,790
!أجل

32
00:02:15,810 --> 00:02:18,710
!أنا من سيطيح برأس كايدو

33
00:02:19,770 --> 00:02:20,880
!وأنا

34
00:02:23,900 --> 00:02:26,590
!حمقى

35
00:02:26,590 --> 00:02:27,260
!حسنًا

36
00:02:27,260 --> 00:02:29,680
!سأذهب لإيقافهم

37
00:02:29,680 --> 00:02:31,220
!مهلاً يا لوفي

38
00:02:32,910 --> 00:02:35,850
.سيزيد الطّين بلّة فحسب

39
00:02:36,140 --> 00:02:37,600
!سأذهب لإيقافه

40
00:02:37,600 --> 00:02:38,520
...لكن

41
00:02:41,120 --> 00:02:42,280
!يا لوفي

42
00:02:42,280 --> 00:02:43,930
!انتظر

43
00:02:54,680 --> 00:02:57,580
!مهلاً

44
00:02:57,580 --> 00:03:00,960
!أيّها المسنّن

45
00:03:20,290 --> 00:03:22,210
!أيّها المسنّن

46
00:03:22,210 --> 00:03:25,360
!أين أنت؟

47
00:03:28,510 --> 00:03:33,030
"!أوتاما في البال! هجوم لوفي الغاضب"

48
00:03:44,400 --> 00:03:46,380
إلى أين ذهب؟

49
00:03:49,110 --> 00:03:51,470
...لوفي

50
00:03:54,450 --> 00:03:56,180
...حسنًا

51
00:03:56,530 --> 00:04:00,090
.أظنّني سأجده بمجرّد وصولي لكايدو

52
00:04:15,050 --> 00:04:19,010
يا أخي! هل تشرب؟

53
00:04:19,010 --> 00:04:21,670
!إلى أين أنت ذاهب؟

54
00:04:21,670 --> 00:04:24,600
أخبرني، أين كايدو؟

55
00:04:24,600 --> 00:04:29,300
!لماذا تسألني؟ لا تقل لي أنّك ستذهب للشّرب معه

56
00:04:29,300 --> 00:04:34,390
،كايدو-سان خلف قاعة العروض هناك في الأعلى

57
00:04:34,390 --> 00:04:37,180
...لكنّه لا يشرب معنا أبدًا

58
00:04:37,910 --> 00:04:39,670
!مهلاً

59
00:04:50,630 --> 00:04:52,120
.لقد أحضرتهم

60
00:04:52,120 --> 00:04:53,870
!ادخلوا

61
00:05:12,400 --> 00:05:16,400
!كايدو-ساما-أرينسو! لم نتقابل منذ مدّة-أرينسو

62
00:05:16,400 --> 00:05:18,720
أيّ نوع من اللّغات هذه؟

63
00:05:33,420 --> 00:05:35,370
هل شربتم؟

64
00:05:37,300 --> 00:05:39,620
.لا طائل من الشّرب مع الضّعفاء

65
00:05:40,120 --> 00:05:43,210
!أريد الشّرب معك يا كايدو-سان

66
00:05:43,210 --> 00:05:46,290
.حسنًا، لا بأس

67
00:05:46,290 --> 00:05:48,960
.لنقصد القاعة لاحقًا

68
00:05:48,960 --> 00:05:51,170
.لا مراسم وقوف اليوم

69
00:05:51,460 --> 00:05:52,730
لاحقًا؟

70
00:05:52,730 --> 00:05:54,880
لماذا لا يمكننا الذّهاب الآن؟

71
00:05:55,240 --> 00:06:00,140
...كنتُ سأعرّفكم إلى لينلين أوّلاً

72
00:06:00,360 --> 00:06:01,560
لينلين؟

73
00:06:02,200 --> 00:06:04,020
ستعرّفنا إلى بيغ مام؟

74
00:06:04,390 --> 00:06:05,730
...نعم

75
00:06:11,880 --> 00:06:14,780
...أحمر وملّمع الشّفاه هذين

76
00:06:16,170 --> 00:06:18,700
.لونهما جيّد

77
00:06:18,700 --> 00:06:20,700
.أعجباني

78
00:06:21,080 --> 00:06:23,040
!شكرًا على الانتظار

79
00:06:23,640 --> 00:06:25,750
.تفضّلي حساء الفاصولياء الحمراء

80
00:06:25,750 --> 00:06:28,710
!حساء الفاصولياء الحمراء

81
00:06:28,710 --> 00:06:31,550
!كنت أنتظره

82
00:06:31,960 --> 00:06:36,010
.سمعتُ أنّها تغيّر ملابسها الآن. لنلتقِ بها لاحقًا

83
00:06:36,340 --> 00:06:37,260
لاحقًا؟

84
00:06:37,680 --> 00:06:44,230
،على أيّ حال، وقعت حادثة صغيرة
.لذلك كنت في انتظاركم

85
00:06:44,580 --> 00:06:46,100
!أتسمّي هذا تخطيطًا؟

86
00:06:46,100 --> 00:06:47,350
!توقّفي

87
00:06:47,830 --> 00:06:53,750
حسنًا، هذا صحيح، لستُ أنا
.من استدعاكم في المقام الأوّل

88
00:06:53,750 --> 00:06:55,170
!ماذا؟

89
00:06:55,170 --> 00:06:58,070
من استدعانا إذًا؟

90
00:07:00,680 --> 00:07:01,870
.أنا

91
00:07:03,680 --> 00:07:07,170
.أنا من استدعاهم يا كايدو-سان

92
00:07:07,170 --> 00:07:10,980
!كينغ... أنت من كان بحاجتنا إذًا؟

93
00:07:10,980 --> 00:07:14,090
!كيف خدعتنا؟

94
00:07:14,090 --> 00:07:18,220
كنتُ أعلم أنّ بعضكم ما كان ليحضر
.إن عرف أنّ الدّعوة منّي

95
00:07:18,220 --> 00:07:20,430
!هوز-هو! ساساكي

96
00:07:23,910 --> 00:07:25,350
.هذا صحيح

97
00:07:25,740 --> 00:07:28,480
أنتما ممّن كنتما في السّابق قبطانين
...لطاقمَيْ قراصنة تابعان لكما

98
00:07:28,850 --> 00:07:32,360
.تسعيان لأخذ أماكننا ككبار النّجوم

99
00:07:32,570 --> 00:07:35,590
.بلغنا هذه المناصب بفضي مجهوداتنا

100
00:07:35,590 --> 00:07:37,740
!بالطّبع نطمح لذلك

101
00:07:38,090 --> 00:07:39,610
.الزم حدودك

102
00:07:48,370 --> 00:07:50,500
!مهلاً، توقّفوا

103
00:07:52,390 --> 00:07:57,340
لماذا القتال في يوم وليمة مبهج كهذا؟

104
00:07:57,340 --> 00:08:00,430
كينغ! لماذا استدعيتهم؟

105
00:08:00,860 --> 00:08:06,220
.لأنّني سمعتُ بحادثتك الصّغيرة قبل الجميع

106
00:08:06,220 --> 00:08:07,560
ألست بحاجتهم؟

107
00:08:08,910 --> 00:08:10,810
...أحتاجهم بالفعل

108
00:08:11,750 --> 00:08:13,520
!باو فوان

109
00:08:13,920 --> 00:08:15,440
!نعم

110
00:08:38,560 --> 00:08:40,970
ما جدولي اليوم؟

111
00:08:44,780 --> 00:08:52,190
لاحقًا على خشبة المهرجان الذّهبيّ حيث
...يقدّم كوين-ساما عرضه الآن

112
00:08:52,910 --> 00:08:59,150
...سيقوم النّجوم الكبار الثّلاثة وفوكوروكوجو-ساما

113
00:09:00,630 --> 00:09:05,160
...وبعد ذلك، سيقدّم أوروتشي-ساما وكايدو-ساما

114
00:09:05,160 --> 00:09:06,530
!خطابًا

115
00:09:06,970 --> 00:09:13,620
...ثمّ عندما تصل سفينة قراصنة بيغ مام

116
00:09:14,230 --> 00:09:21,050
سيقدّم كلّ من كايدو-ساما
...وبيغ مام-ساما إعلانًا عن أقوى

117
00:09:21,050 --> 00:09:24,510
!تحالف قراصنة في العالم

118
00:09:25,320 --> 00:09:28,970
...وبعد ذلك، سيقدّم كايدو-ساما

119
00:09:28,970 --> 00:09:34,270
!إعلانًا مهمًّا

120
00:09:34,700 --> 00:09:35,980
.هذا كلّ شيء

121
00:09:36,310 --> 00:09:40,570
.إعلان مهمّ؟! ليس من عادتك إخفاء الأمور عنّا

122
00:09:40,860 --> 00:09:42,500
!هذا مزعج للغاية-أرينسو

123
00:09:42,500 --> 00:09:48,030
،نعم، أعلم. لكن إن شاركتكم به الآن
.فسيسبّب الارتباك

124
00:09:48,350 --> 00:09:52,540
.لذلك، إليكم ما أريد منكم فعله

125
00:09:52,890 --> 00:09:56,000
،اختفى ابني الغبيّ ياماتو اليوم

126
00:09:56,000 --> 00:09:59,000
!وأريد منكم إحضاره لي

127
00:10:00,420 --> 00:10:03,630
.ماذا...؟ يا لها من مهمّة

128
00:10:03,630 --> 00:10:08,780
هذا يعني أنّ إعلانك له علاقة
بالسّيّد الصّغير ياماتو؟

129
00:10:08,780 --> 00:10:10,740
.هذا صحيح

130
00:10:10,740 --> 00:10:12,030
.فهمت

131
00:10:12,030 --> 00:10:14,740
!كم هذا مزعج! هذه أمور عائليّة فحسب

132
00:10:14,740 --> 00:10:15,830
!توقّفي

133
00:10:15,830 --> 00:10:19,250
حسنًا... ماذا بعد أن نعيده بأمان؟

134
00:10:19,250 --> 00:10:23,280
.سأمنحكم الحقّ لتتحدّوا أحد كبار النّجوم من اختياركم

135
00:10:24,300 --> 00:10:25,740
ما قولكم؟

136
00:10:25,740 --> 00:10:28,880
!فعلاً؟ أنا موافق

137
00:10:28,880 --> 00:10:31,450
!وأنا أيضًا

138
00:10:32,050 --> 00:10:34,160
لا تمانعان، صحيح؟

139
00:10:34,160 --> 00:10:36,870
!لا، على الإطلاق

140
00:10:55,120 --> 00:10:58,060
!مهلاً! إنّ الحساء يغطّيك بالكامل

141
00:10:58,060 --> 00:11:01,920
!لا يأكل المرء حساء الفاصولياء الحمراء
!بل يغطّي نفسه به

142
00:11:03,290 --> 00:11:07,200
!أحضروا الحساء! سنسكبه على بعضنا

143
00:11:07,200 --> 00:11:09,570
!اسكبوه بالكامل

144
00:11:15,810 --> 00:11:17,210
...تاما

145
00:11:29,650 --> 00:11:32,720
...الحساء يغطّيني بالكامل. رائحته مقرفة

146
00:11:32,720 --> 00:11:34,820
!المزيد! المزيد

147
00:11:34,820 --> 00:11:37,560
!واصلوا إحضاره! خذ

148
00:11:47,240 --> 00:11:48,990
.دعونا نمرّ

149
00:11:50,050 --> 00:11:53,660
.نريد مقابلة كايدو. ابتعدوا عن طريقنا

150
00:11:53,660 --> 00:11:58,120
واثق أنّ كايدو-سان سيظهر
.في النّهاية على المسرح هناك

151
00:11:58,120 --> 00:11:59,330
.انتظرا حتّى ذلك الحين

152
00:12:03,810 --> 00:12:07,210
.لنشرب معًا ونشاهده عندما يحضر

153
00:12:07,670 --> 00:12:08,920
.لنشرب

154
00:12:19,950 --> 00:12:21,310
!ما الّذي...؟

155
00:12:22,500 --> 00:12:23,480
!أنت

156
00:12:27,630 --> 00:12:29,900
.أغلق فمك

157
00:12:30,150 --> 00:12:31,660
!اسمعوا

158
00:12:31,660 --> 00:12:36,540
...اهتمّ بي كايدو-سان جيّدًا

159
00:12:36,540 --> 00:12:42,250
.لذلك عليّ مقابلته شخصيًّا لأشكره كما يجب

160
00:12:42,250 --> 00:12:44,900
أتعرفون ما يعنيه ذلك؟

161
00:12:46,270 --> 00:12:47,910
.حسنًا

162
00:12:49,520 --> 00:12:53,260
...ذ-ذلك جيّد جدًّا

163
00:12:53,260 --> 00:12:55,350
...نـ-نعم

164
00:12:55,350 --> 00:12:58,890
.أبلغوا سلامي لكايدو-سان

165
00:13:10,670 --> 00:13:15,470
هذا التّنكّر جيّد. بإمكاننا تفادي
.قتالات لا ضرورة منها

166
00:13:15,470 --> 00:13:20,580
.بإمكاننا الوصول إلى كايدو سالمين بفضله

167
00:13:20,930 --> 00:13:24,630
...بإمكاننا دقّ عنقه أخيرًا

168
00:13:24,630 --> 00:13:26,490
...نعم

169
00:13:30,230 --> 00:13:32,300
!مرحى

170
00:13:37,990 --> 00:13:43,140
...أعتقد أنّني مررت من هنا سابقًا

171
00:13:44,700 --> 00:13:47,790
ماذا؟ عدت ثانية؟

172
00:13:47,790 --> 00:13:50,420
!هل غيّرتما أماكنكما؟

173
00:13:50,420 --> 00:13:54,110
.ماذا؟ كنّا هنا طوال الوقت

174
00:13:54,110 --> 00:13:56,370
.مستحيل

175
00:13:56,370 --> 00:14:01,260
.مشيتُ كثيرًا، لذلك لا بدّ أنّني قريب من كايدو

176
00:14:01,260 --> 00:14:03,210
أثملت وأضعتَ طريقك؟

177
00:14:03,210 --> 00:14:06,360
.أنت رجل بالغ تُحرج نفسك

178
00:14:09,590 --> 00:14:12,520
.حسنًا، لا تغضب واشرب

179
00:14:12,520 --> 00:14:15,180
.بإمكانك الأكل بقدر ما تشاء
!الطّعام لذيذ

180
00:14:20,570 --> 00:14:24,890
،الطّعام والسّاكي هنا جيّدان بالفعل

181
00:14:24,890 --> 00:14:27,190
...أما وجوهكم

182
00:14:27,810 --> 00:14:29,940
!فلا تسرّ النّاظر أبدًا

183
00:14:29,940 --> 00:14:31,540
!ماذا قلت؟

184
00:14:31,540 --> 00:14:34,740
!حسنًا! أتريد القتال؟

185
00:14:36,510 --> 00:14:38,410
!إلمَ تنظر؟

186
00:14:39,680 --> 00:14:41,990
!قل شيئًا

187
00:14:54,760 --> 00:14:56,510
!ماذا تفعل؟

188
00:14:56,510 --> 00:14:58,010
!أفعلتَ هذا؟

189
00:15:01,570 --> 00:15:04,430
!هل تعبث معنا؟

190
00:15:13,580 --> 00:15:14,990
...أنا أتضوّر جوعًا

191
00:15:14,990 --> 00:15:18,170
!أمّي! أنا جائع

192
00:15:18,170 --> 00:15:19,910
.اصبر قليلاً

193
00:15:29,770 --> 00:15:31,750
!لا تغتر بنفسك

194
00:15:35,210 --> 00:15:40,140
!أنا محبط نوعًا ما. سأقاتلكم

195
00:15:43,510 --> 00:15:47,200
!ماذا؟! إنّ الحساء يغطّي اللّحم أيضًا

196
00:15:47,200 --> 00:15:51,460
!لدينا الكثير من الطّعام. أرمه فحسب

197
00:15:51,460 --> 00:15:55,360
!وحدهم سكّان بلدة أوكوبوري من كانوا ليأكلوه

198
00:15:55,360 --> 00:15:57,640
!معك حقّ

199
00:16:02,340 --> 00:16:04,540
!لماذا؟

200
00:16:04,540 --> 00:16:10,960
لماذا هنالك الكثير من الطّعام
!من أجل أغبياء أمثالكم؟

201
00:16:14,100 --> 00:16:15,750
!ألديك مشكلة في ذلك؟

202
00:16:59,610 --> 00:17:01,360
!ما الّذي يفعله؟

203
00:17:01,360 --> 00:17:04,340
!هل حساء الفاصولياء الحمراء لذيذ لذلك الحدّ؟

204
00:17:10,330 --> 00:17:15,270
.نعم، إنّه لذيذ. لا يوجد ما هو ألذّ منه

205
00:17:40,440 --> 00:17:42,630
لماذا لا تأكل المزيد إذًا؟

206
00:17:42,630 --> 00:17:44,690
...تعال ونل ما تستحقّ

207
00:17:44,690 --> 00:17:46,510
!بدءًا برأسك

208
00:18:02,920 --> 00:18:06,320
!إنّه لذيذ

209
00:18:06,610 --> 00:18:10,120
!هذا الحساء لذيذ للغاية

210
00:18:13,010 --> 00:18:16,100
!ماذا؟ أهذه أوّل مرّة تتناولينه فيها؟

211
00:18:16,100 --> 00:18:17,170
!نعم

212
00:18:21,880 --> 00:18:22,800
...كيف

213
00:18:25,880 --> 00:18:27,260
...كيف

214
00:18:27,260 --> 00:18:31,220
!لا يتسنّى لتاما أكل شيء كهذا؟

215
00:18:42,840 --> 00:18:47,280
،إنّه مجرّد حساء فاصولياء حمراء
!فلا تغضب كثيرًا حياله

216
00:19:20,750 --> 00:19:23,110
...فاكهة المطّاط

217
00:19:24,420 --> 00:19:27,110
!مسدّس الفيل

218
00:20:02,370 --> 00:20:04,270
!اهربوا

219
00:20:04,270 --> 00:20:06,240
!وإلاّ نال منكم أيضًا

220
00:20:09,590 --> 00:20:12,740
.لا بدّ أنّه لوفي

221
00:20:16,010 --> 00:20:17,660
!يا قبطان، انظر

222
00:20:24,230 --> 00:20:28,340
!قبّعة القشّ! ما الّذي يفعله ذلك الغبيّ؟

223
00:20:33,550 --> 00:20:39,180
إننا نحاول التّسلّل عبر قاعة الوليمة
...دون لفت الانتباه متنكّرين

224
00:20:39,520 --> 00:20:41,160
...لا بأس

225
00:20:41,160 --> 00:20:42,160
!كيد؟

226
00:20:42,160 --> 00:20:44,260
!دعوه وشأنه

227
00:20:45,150 --> 00:20:50,610
.إنّه يجلب الأنظار له، لذلك من السّهل علينا التّحرّك

228
00:20:51,800 --> 00:20:57,160
عليّ أن أهدّئه الآن وإلاّ فلن أستطيع
...النّظر لوجه كينييمون

229
00:21:00,760 --> 00:21:03,480
!أعتمد عليك يا إنما

230
00:21:25,410 --> 00:21:26,820
!ماذا؟

231
00:21:56,530 --> 00:21:58,500
...يا إلهي

232
00:21:59,200 --> 00:22:01,600
!أثرت الكثير من الجلبة

233
00:22:03,490 --> 00:22:06,980
...أتيتُ مباشرة إلى هنا حيث الفوضى

234
00:22:08,420 --> 00:22:10,900
!ووجدت المكان هكذا مسبقًا

235
00:22:11,250 --> 00:22:16,110
!لماذا لا تستطيع التّسلّل بهدوء؟

236
00:22:16,130 --> 00:22:20,740
...التّسلّل بهدوء. اتّبع نصيحتك أوّلاً

237
00:22:20,740 --> 00:22:25,080
!هل يعلم ما الّذي يتفوّه به؟

238
00:22:28,020 --> 00:22:31,510
!هل نسيت ما هي الخطّة؟

239
00:22:31,720 --> 00:22:34,030
!لم أنس شيئًا

240
00:22:34,650 --> 00:22:37,010
...هؤلاء الحمقى

241
00:22:39,240 --> 00:22:42,390
!كانوا يسكبون حساء الفاصولياء الحمراء قصدًا

242
00:22:42,870 --> 00:22:44,520
!حساء الفاصولياء الحمراء؟

243
00:22:44,520 --> 00:22:48,550
!هذا الحساء لذيذ للغاية

244
00:22:50,120 --> 00:22:53,530
!في تلك الحالة، عليّ تقطيعهم جميعًا

245
00:23:04,390 --> 00:23:08,130
!صار مكان المهرجان الذّهبيّ ساحة معركة على الفور

246
00:23:08,130 --> 00:23:12,700
!يقف سكراتشمن أبو في طريق لوفي وزورو الغاضبين

247
00:23:12,700 --> 00:23:14,510
.اللّحن المرعب

248
00:23:14,510 --> 00:23:21,510
وبينما يصارعون في ساحة المعركة
!بلا مهرب، يصل كيد وهو يحمل ضغينة

249
00:23:22,240 --> 00:23:27,190
:في الحلقة القادمة من وان بيس
"!موسيقى القتال! قدرة تؤذي لوفي"

250
00:23:27,190 --> 00:23:29,860
!ملك القراصنة، لن يكون إلاّ أنا