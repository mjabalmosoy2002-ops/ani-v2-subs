1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,490
...اسعوا نحو الحرّيّة

3
00:00:13,490 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:52,750 --> 00:01:53,790
...إنّه

22
00:01:55,390 --> 00:01:57,860
!فخّ! إنّه فخّ من البحريّة

23
00:01:58,260 --> 00:02:00,190
!رفاق

24
00:02:00,190 --> 00:02:00,730
!أوسوبّ

25
00:02:09,330 --> 00:02:11,100
!لنبحر

26
00:02:12,840 --> 00:02:16,440
!مـ-مستحيل! سفينة قراصنة نازلة من الجبل؟

27
00:02:16,440 --> 00:02:17,740
!العجوز

28
00:02:20,310 --> 00:02:25,080
"!مكان كنز الجزيرة! هجوم قراصنة زيني"

29
00:02:49,540 --> 00:02:50,640
...أهذا

30
00:02:50,640 --> 00:02:52,340
!نجحت أيّها العجوز

31
00:02:52,340 --> 00:02:54,180
.مهلاً، لا تتصرّف بطيش

32
00:02:54,180 --> 00:02:56,050
لم يتوقّف قلبه ثانيةً، صحيح؟

33
00:02:56,050 --> 00:02:58,350
!توقّف عن هذا

34
00:02:58,350 --> 00:03:02,250
!أيّها الجدّ! هل أنت بخير؟

35
00:03:08,890 --> 00:03:11,900
.خرجتُ إلى البحر أخيرًا

36
00:03:12,360 --> 00:03:14,930
!أصبحتُ قرصانًا حقًّا

37
00:03:16,300 --> 00:03:19,370
!أجل! ما عاد هذا تابوتي

38
00:03:19,370 --> 00:03:23,040
!إنّها زيني، سفينة قراصنة لائقة
!أليس كذلك؟

39
00:03:25,780 --> 00:03:27,810
!أحسنت أيّها العجوز

40
00:03:27,810 --> 00:03:29,480
!أخبرناك ألاّ تحفّزه

41
00:03:29,480 --> 00:03:30,750
!إنّه رجلٌ مريض

42
00:03:31,050 --> 00:03:33,620
ما الّذي تحاول فعله أيّها الدّائِن زيني؟

43
00:03:33,620 --> 00:03:37,520
مهنتك هي ابتزاز القراصنة
!وسلبهم المال، أليس كذلك؟

44
00:03:37,920 --> 00:03:39,690
.تركتُ مهنة الإدانة قبل وقتٍ طويل

45
00:03:40,090 --> 00:03:42,760
!أنا الآن القرصان زيني

46
00:03:44,260 --> 00:03:46,200
!لا تستنقص من البحريّة أيّها العجوز الهرم

47
00:03:46,660 --> 00:03:50,640
!احترس أيّها العجوز! إنّه يسعى خلف الكنز

48
00:03:51,900 --> 00:03:54,770
إذًا بدأت البحريّة مؤخرًا
،في السّعي خلف الكنز

49
00:03:54,770 --> 00:03:57,880
بالإضافة إلى القبض على القراصنة، أليس كذلك؟

50
00:03:57,880 --> 00:04:00,680
.هذا اجتهاد كبير منكم

51
00:04:01,010 --> 00:04:02,380
.نامي، قرّبي السّفينة

52
00:04:02,380 --> 00:04:03,650
.مفهوم. هيّا، جميعًا

53
00:04:03,650 --> 00:04:06,020
!أنت! لا تملِ الأوامر على نامي-سان

54
00:04:06,220 --> 00:04:08,790
!أيّها الرّقيب مينتشي
!لقد تحرّك قراصنة قبّعة القشّ

55
00:04:08,790 --> 00:04:10,560
!اتّصل بأسطول النّقيب مور للدّعم

56
00:04:10,560 --> 00:04:11,560
!اخرس

57
00:04:19,160 --> 00:04:22,930
.أخبرتك أنّني سأعطيك قسمتك من الكنز

58
00:04:24,200 --> 00:04:25,900
فهمت، أليس كذلك؟

59
00:04:25,900 --> 00:04:28,440
.لا يمكننا إبلاغ النّقيب

60
00:04:30,780 --> 00:04:33,080
...وفق حسابي

61
00:04:35,250 --> 00:04:39,280
أنت تخرس رجالك للعمل
.على هذه المهمّة الجانبيّة

62
00:04:40,420 --> 00:04:43,960
ذلك مكلّف جدًّا، أليس كذلك أيّها الرّقيب؟

63
00:04:44,890 --> 00:04:47,290
...أيّها العجوز الخرف

64
00:04:47,290 --> 00:04:49,190
!ستدفع ثمن هذا

65
00:04:49,190 --> 00:04:50,660
!اخرس يا فتى

66
00:04:50,960 --> 00:04:54,630
!يا لجرأتك لتحاول سرقة كنزي

67
00:04:54,630 --> 00:04:56,600
!تعال وخذه منّي إن استطعت

68
00:04:58,800 --> 00:05:00,610
!أحسنت أيّها العجوز

69
00:05:03,270 --> 00:05:05,740
!أرهم كيف يقاتل القراصنة

70
00:05:27,570 --> 00:05:28,270
!أجل

71
00:05:28,270 --> 00:05:29,700
!غبيّ

72
00:05:30,700 --> 00:05:32,540
ما الّذي تفعله...؟

73
00:05:33,270 --> 00:05:34,740
!...أيّها الـ

74
00:05:35,070 --> 00:05:38,240
إن كنت قرصانًا، فلا تمانع
!إن قتلتك البحريّة، صحيح؟

75
00:05:38,580 --> 00:05:41,610
بالتّفكير في الأمر، هل يملك
ذلك العجوز أيّ أسلحة؟

76
00:05:43,110 --> 00:05:45,150
!أروني ما لديكم

77
00:05:45,150 --> 00:05:48,520
سأواجهكم بمهارات مِعدادي
!ذات التّصنيف العاشر

78
00:05:48,520 --> 00:05:49,750
!عليك بهم

79
00:05:51,560 --> 00:05:53,220
...مِعداده و

80
00:05:53,220 --> 00:05:54,160
.ماعزه

81
00:05:56,730 --> 00:05:59,200
!ماذا؟! مصيبة

82
00:06:00,230 --> 00:06:01,700
!أيّها العجوز

83
00:06:05,940 --> 00:06:06,910
!ذلك الغبيّ

84
00:06:06,910 --> 00:06:08,110
!لوفي

85
00:06:10,380 --> 00:06:13,140
ماذا تفعلون أيّها الأغبياء؟
!علامَ تطلقون؟

86
00:06:13,140 --> 00:06:15,410
!لا تهدروا طلقاتكم هكذا

87
00:06:15,410 --> 00:06:16,880
!أنا ها هنا

88
00:06:16,880 --> 00:06:17,720
!هيّا بنا

89
00:06:27,330 --> 00:06:28,630
!ماذا تفعل؟

90
00:06:28,630 --> 00:06:30,630
!إنّك تواجه ماعز! ماعز

91
00:06:30,630 --> 00:06:33,530
ولأنّها ماعز، لا أستطيع الهجوم
.عليها أيّها الرّقيب

92
00:06:33,530 --> 00:06:36,330
!يا هذا! بدأت المعركة بالفعل

93
00:06:36,330 --> 00:06:39,200
!كفّ عن التّفرّج من الأعلى وانزل إلى هنا

94
00:06:42,610 --> 00:06:44,710
!لنسرع! لنسرع! لنسرع

95
00:06:45,310 --> 00:06:47,110
.نعلم. تنحّ جانبًا للحظة

96
00:06:47,110 --> 00:06:48,780
!اهدأ يا تشوبّر

97
00:06:48,780 --> 00:06:49,680
...لكن

98
00:06:49,910 --> 00:06:53,380
حالة الجدّ الجسديّة لا تسمح
!له بخوض شيءٍ مجنون كهذا

99
00:07:06,830 --> 00:07:07,800
!أطلق عليها

100
00:07:06,830 --> 00:07:07,800
!لا تطلق

101
00:07:18,580 --> 00:07:21,410
تجرّأتم حقًّا! خرج صغاري
!عن السّيطرة الآن

102
00:07:27,620 --> 00:07:29,120
!هجوم

103
00:07:36,930 --> 00:07:40,900
!انظروا! لقد أخذوا مواقعهم وينتظروننا

104
00:07:40,900 --> 00:07:43,870
.من الغريب أنّهم يقفون ساكنين

105
00:07:43,870 --> 00:07:46,370
علينا أن نفكّر في طريقة
.لقتالهم الآن بينما نستطيع

106
00:07:46,840 --> 00:07:50,580
ما العمل إذًا؟ هل نهاجمهم أوّلاً؟

107
00:07:50,580 --> 00:07:51,740
!لا تقل كلامًا مجنونًا

108
00:07:51,740 --> 00:07:55,010
على أيّ حال، علينا الإسراع
!الآن ومساعدة العجوز

109
00:07:55,810 --> 00:07:58,550
بالمناسبة، هل صدمنا شيئًا قبل لحظات؟

110
00:07:58,550 --> 00:07:59,650
ماذا؟ حقًّا؟

111
00:07:59,650 --> 00:08:01,420
!لا يهمّ! لنسرع

112
00:08:02,550 --> 00:08:05,720
أيّها النّقيب مور، لا استجابة
.من سفينة الرّقيب مينتشي

113
00:08:05,720 --> 00:08:07,760
ما كان صوت إطلاق النّار
الّذي سمعناه سابقًا؟

114
00:08:07,760 --> 00:08:08,960
هل نتقدّم؟

115
00:08:08,960 --> 00:08:12,730
.ليس بعد. انتظروا تقرير مينتشي

116
00:08:14,230 --> 00:08:16,170
أين ذهبتِ؟

117
00:08:22,870 --> 00:08:24,840
!اكتفيت منك

118
00:08:29,080 --> 00:08:30,680
!يكفي

119
00:08:34,350 --> 00:08:35,390
!حسنًا

120
00:08:54,270 --> 00:08:57,240
أين ذهبت كلّ حيويّتك؟

121
00:08:57,240 --> 00:09:00,580
هل انقطعت أنفاسك أيّها القرصان زيني؟

122
00:09:00,580 --> 00:09:04,080
.عجبًا، نزلت أخيرًا أيّها النّذل الصّغير

123
00:09:06,120 --> 00:09:08,390
!أنت وغد ثرثار بالفعل

124
00:09:15,790 --> 00:09:18,100
والآن، هل نتحدّث عن العمل؟

125
00:09:19,430 --> 00:09:23,270
أين خبّأت كنزك أيّها القرصان زيني؟

126
00:09:39,450 --> 00:09:40,790
!ماذا قلت؟

127
00:09:41,090 --> 00:09:42,990
!لِمَ لم تبلغ عن هذا أبكر؟

128
00:09:43,250 --> 00:09:46,690
.أنا جدّ آسف أيّها النّقيب مور

129
00:09:49,060 --> 00:09:50,960
...يا لها من حيلة قذرة

130
00:09:51,630 --> 00:09:54,400
هذا ما كان ينوي عليه
!إذًا ذلك البائس مينتشي

131
00:10:00,570 --> 00:10:03,640
لِمَ لا تقرّ بمكانه بسرعة؟

132
00:10:03,640 --> 00:10:05,810
أم أنّك تريد أن تموت؟

133
00:10:06,280 --> 00:10:08,780
.بل أقدّر حياتي

134
00:10:08,780 --> 00:10:11,150
...وأعتزّ بها

135
00:10:11,150 --> 00:10:13,820
.لكن دعني أخبرك أنّني مفلس

136
00:10:13,820 --> 00:10:15,920
بمَ تريدني أن أقرّ؟

137
00:10:15,920 --> 00:10:17,560
.ريقي جافّ أساسًا

138
00:10:21,260 --> 00:10:22,490
.حسنًا

139
00:10:26,130 --> 00:10:28,270
،بما أنّها جزيرة صغيرة

140
00:10:28,270 --> 00:10:33,000
.لن نستغرق طويلاً لحفر كلّ شبرٍ منها

141
00:10:37,680 --> 00:10:39,640
.ما عدتُ بحاجتك

142
00:10:44,420 --> 00:10:45,380
!...أيّها الـ

143
00:10:47,050 --> 00:10:48,250
!هذه نهايتك

144
00:10:56,690 --> 00:10:58,930
.يبدو أنّني كسرتُ مِعدادك

145
00:10:58,930 --> 00:10:59,830
.آسفة

146
00:10:59,830 --> 00:11:01,630
!ماذا تفعلين؟

147
00:11:01,630 --> 00:11:04,400
أتظنّين أنّك تستطيعين تحدّي
...البحريّة والنّجـ

148
00:11:08,870 --> 00:11:09,910
!أيّها الجدّ

149
00:11:11,740 --> 00:11:15,780
!لقد تأخّرتم! كدتُ أموت

150
00:11:15,780 --> 00:11:18,220
!قلقتُ كثيرًا عليك

151
00:11:18,580 --> 00:11:19,180
!نجم الدّخان

152
00:11:21,950 --> 00:11:24,360
!هذه نهاية طريقكم

153
00:11:24,360 --> 00:11:26,160
روبين، هل كنت هنا؟

154
00:11:26,460 --> 00:11:30,260
أيّها العجوز، يمكنك أن تسترخي
...الآن بما أنّ القائد أوسوبّ هنـ

155
00:11:30,260 --> 00:11:32,130
!ماذا حدث؟ إنّه نتوء كبير

156
00:11:33,670 --> 00:11:34,600
!لا يوجد نبض

157
00:11:35,030 --> 00:11:38,100
.اهدأ يا تشوبّر. أنا هنا، هنا

158
00:11:38,100 --> 00:11:42,140
.فهمت! حسنًا، هوّن على نفسك واستلقِ

159
00:11:43,140 --> 00:11:44,940
!إيّاك أن تموت أيّها الجدّ

160
00:11:45,910 --> 00:11:47,950
هل تظنّني سأموت؟

161
00:11:59,460 --> 00:12:01,160
كيف حالك الآن أيّها العجوز؟

162
00:12:03,060 --> 00:12:04,930
.بخير بالطّبع

163
00:12:05,260 --> 00:12:07,370
.أنا قرصان أخيرًا

164
00:12:07,370 --> 00:12:09,200
.ما عدتُ أريد الموت

165
00:12:21,110 --> 00:12:24,620
أتينا إلى الجزيرة بأوامرٍ
.من الرّقيب فحسب

166
00:12:24,620 --> 00:12:29,190
صحيح... أظنّ أنّ التّابعين
.لا يمكنهم عصيان أوامر رؤسائهم

167
00:12:29,190 --> 00:12:32,620
دعني أخبرك أنّ قائدنا
...متقلّب جدًّا هو الآخر

168
00:12:32,620 --> 00:12:34,090
هكذا إذًا؟

169
00:12:34,630 --> 00:12:36,660
.لا تتودّدا هكذا

170
00:12:40,570 --> 00:12:44,440
أ-أيها العجوز، هل أنت بخير؟

171
00:12:44,440 --> 00:12:46,240
بل هل أنت بخير أيّها الشّابّ؟

172
00:12:46,600 --> 00:12:49,840
!يا إلهي، لوفي ميؤوس منه حقًّا

173
00:12:49,840 --> 00:12:53,140
.مرّت وعكتك، هذا مطمئن

174
00:12:53,140 --> 00:12:55,410
.أشكرك أيّها الطّبيب تشوبّر

175
00:12:56,280 --> 00:12:57,720
.آسف

176
00:12:57,720 --> 00:13:00,290
أيّها العجوز، ما رأيك بحيلتي المربحة؟

177
00:13:01,450 --> 00:13:03,020
.ممتازة، شكرًا

178
00:13:05,690 --> 00:13:06,830
.صحيح

179
00:13:06,830 --> 00:13:09,990
أخبرني يا جدّي، بإمكانك
إخبارنا، أليس كذلك؟

180
00:13:10,300 --> 00:13:11,630
بشأن كنزك؟

181
00:13:14,630 --> 00:13:17,640
!أنت! لا تضايقي مرضاي

182
00:13:17,640 --> 00:13:19,170
!أيّها الجدّ، تماسك

183
00:13:20,670 --> 00:13:22,670
...يا إلهي

184
00:13:23,580 --> 00:13:27,380
،نعم، فعلتم الكثير من أجلي

185
00:13:27,380 --> 00:13:29,650
.لذا ربّما يمكنني إخباركم

186
00:13:30,080 --> 00:13:31,550
!هذا ما أردت سماعه

187
00:13:31,550 --> 00:13:34,850
،حتّى البحريّة تعرف عنه
!لذا لا بدّ أنّه كنزٌ مذهل

188
00:13:35,990 --> 00:13:38,990
...كان لي... كنزٌ بالفعل

189
00:13:38,990 --> 00:13:43,430
قام القراصنة الّذين أدين لهم
.برهن كومة من الذّهب لي

190
00:13:43,430 --> 00:13:48,430
،لكن بنيّة شراء سفينة قراصنة وجمع طاقمي

191
00:13:48,430 --> 00:13:50,640
.استبدلته كلّه بالمال

192
00:13:50,640 --> 00:13:51,840
!مال

193
00:13:52,900 --> 00:13:56,640
.بالتّفكير في الأمر، حينها انقلبت حياتي

194
00:13:58,180 --> 00:14:01,550
أخبرتكم البارحة أنّ بعض
القراصنة الّذين كنت أدين لهم

195
00:14:01,550 --> 00:14:04,520
هاجموني بغتةً وانتهى بي المطاف
ملقيًّا إلى شاطئ هذه الجزيرة، صحيح؟

196
00:14:04,920 --> 00:14:07,490
.بطبيعة الحال، استطعتُ حماية المال

197
00:14:08,120 --> 00:14:13,860
ففي النّهاية، لقد خاطرتُ بحياتي
.بذلك المال من أجل شراء حلمي

198
00:14:18,460 --> 00:14:22,430
بعد أن ألقى بي البحر إلى هنا
...واستعدتُ وعيي

199
00:14:33,380 --> 00:14:34,680
!أكلته؟

200
00:14:34,680 --> 00:14:35,550
!حقًّا؟

201
00:14:35,550 --> 00:14:37,220
!كلّه؟! أكلته كلّه؟

202
00:14:37,620 --> 00:14:42,420
.صحيح. أو بالأحرى، تركت ورقتين أو ثلاث

203
00:14:44,190 --> 00:14:48,690
.لذا كما أخبرتكم، هذه الماعز هي كنزي

204
00:14:51,930 --> 00:14:54,370
،ربّما خسرتُ كلّ ثروتي

205
00:14:54,370 --> 00:14:56,430
.لكنّي كسبت أصدقاء بالمقابل

206
00:14:56,900 --> 00:14:59,370
.فهي لا تخونني أو تحاول خداعي

207
00:14:59,370 --> 00:15:01,240
،بتّ أملك الآن أصدقاء إلى جانبي

208
00:15:01,240 --> 00:15:04,610
.لا يقومون بأيّ شيء بدافع أنانيّ

209
00:15:04,610 --> 00:15:06,180
.لذا أريد أن أكافئها على ذلك

210
00:15:06,910 --> 00:15:10,220
.لقد كسبتُ أعظم كنز في العالم

211
00:15:11,250 --> 00:15:13,050
.هذا جيّد أيّها العجوز

212
00:15:13,280 --> 00:15:14,790
.إنّه جيّد بالفعل

213
00:15:14,790 --> 00:15:17,860
.أنا رجل يستفيد من أيّ وضع

214
00:15:20,930 --> 00:15:22,260
!يا للهراء

215
00:15:22,260 --> 00:15:25,100
!اسمع يا قبّعة القشّ
!لم ينته هذا القتال بعد

216
00:15:25,960 --> 00:15:29,300
!ثمّة أسطول سليم ينتظركم هناك

217
00:15:29,300 --> 00:15:32,270
!لا تظنّوا أنّكم ستفلتون بسهولة

218
00:15:33,640 --> 00:15:35,770
.لا تدّع الرّوعة وأنت تتدحرج

219
00:15:35,770 --> 00:15:36,510
أهو غبيّ؟

220
00:15:37,540 --> 00:15:39,040
!أنتم الأغبياء هنا

221
00:15:39,040 --> 00:15:42,710
هل تظنّون أنّكم تستطيعون
!مواجهة أسطول من تسع سفن؟

222
00:15:46,780 --> 00:15:48,290
.لن أهرب

223
00:15:50,790 --> 00:15:53,930
.أخبرهم أن يأتوا إليّ إن كانوا يريدون القتال

224
00:15:54,290 --> 00:15:56,130
...غومو غومو نوو

225
00:15:56,130 --> 00:15:58,830
!يا لوفي! أعلى قليلاً

226
00:15:59,130 --> 00:16:00,100
!عُلم

227
00:16:02,170 --> 00:16:03,800
!المسدّس

228
00:16:07,410 --> 00:16:10,240
.حسنًا، الاتّجاه صحيح

229
00:16:19,680 --> 00:16:23,220
!أنت... عار على البحريّة

230
00:16:27,090 --> 00:16:28,190
!خذوه

231
00:16:28,190 --> 00:16:28,790
!حاضر

232
00:16:36,100 --> 00:16:38,500
.هذا نقيب البحريّة مور

233
00:16:38,970 --> 00:16:42,710
لا أملك اهتمامًا لا بالجزيرة
.ولا بالرّجل المدعوّ زيني

234
00:16:43,040 --> 00:16:48,180
.هدفي الوحيد هو اعتقالكم باسم العدالة

235
00:16:48,180 --> 00:16:53,150
وامتنانًا لتسليمكم هذا العضو
،الضّال من أسطولي

236
00:16:53,150 --> 00:16:55,990
سأترك لكم حريّة اختيار
.المكان الّذي سنتواجه فيه

237
00:16:55,990 --> 00:16:58,490
.هيّا، اجلبوا سفينتكم

238
00:16:59,320 --> 00:17:02,360
.وجدتنا نفكّر في الرّحيل قريبًا أيضًا

239
00:17:02,360 --> 00:17:03,960
.سنأتي إليكم حالاً

240
00:17:07,100 --> 00:17:09,630
.تفضّل أيّها العجوز، لقد أصلحته لك

241
00:17:10,370 --> 00:17:11,740
.هذا ما أتوقّعه منك. أشكرك

242
00:17:12,000 --> 00:17:13,910
.لا عليك

243
00:17:14,840 --> 00:17:18,080
.لقد أعددتُ عشاءك
.عليك أن تسخّنه فحسب

244
00:17:18,080 --> 00:17:19,840
.نعم، أشكرك

245
00:17:20,780 --> 00:17:24,050
لكن يا شباب، هل أنتم واثقون من هذا؟

246
00:17:24,050 --> 00:17:26,850
ستواجهون أسطولاً من تسع سفن، صحيح؟

247
00:17:26,850 --> 00:17:28,520
.لا تقلق

248
00:17:28,950 --> 00:17:32,420
،لستُ قويًّا فحسب
.بل محظوظ أيضًا

249
00:17:33,420 --> 00:17:36,190
.لا أستطيع مجاراتك أيّها الشّابّ

250
00:17:36,590 --> 00:17:37,860
!أيّها الجدّ

251
00:17:37,860 --> 00:17:41,170
،أعددتُ لك مؤونةً من الأدوية
.لذا احرص على أخذها

252
00:17:41,170 --> 00:17:42,670
!عدني

253
00:17:42,670 --> 00:17:44,670
!فهمت، فهمت

254
00:17:45,270 --> 00:17:47,710
.سأحرص على أخذها، لا تقلق

255
00:17:53,410 --> 00:17:55,350
!قضينا وقتًا ممتعًا يا جدّي

256
00:17:55,350 --> 00:17:56,410
.اعتنِ بنفسك

257
00:17:56,410 --> 00:17:59,080
!يا رفاق، اعتنين بالجدّ

258
00:18:00,690 --> 00:18:02,850
!لنتقابل في البحر يومًا ما

259
00:18:03,050 --> 00:18:04,020
!أكيد

260
00:18:04,020 --> 00:18:08,560
سوف أبحر بمجرّد أن أنتهي
!من إصلاح السّفينة

261
00:18:09,430 --> 00:18:14,200
!سنكون في انتظاركم يا قراصنة زيني

262
00:18:19,100 --> 00:18:22,570
.والآن، دعينا نعد إلى الجزيرة لفترة

263
00:18:22,570 --> 00:18:24,040
.علينا إصلاح السّفينة

264
00:18:24,680 --> 00:18:27,980
.حسنًا، غادر الجميع. سنعود أدراجنا

265
00:19:15,660 --> 00:19:20,130
لا علاقة للعمر إن أردت
أن تصبح قرصانًا إذًا؟

266
00:19:21,270 --> 00:19:24,400
.يا إلهي، يعرف كيف يقنع المرء بفكرة

267
00:19:25,770 --> 00:19:28,170
.تشوبّر صبور أيضًا

268
00:19:28,540 --> 00:19:33,510
كم من عام سأستغرق لأكمل
هذه الكومة من الأدوية؟

269
00:19:34,380 --> 00:19:35,510
.أشكركم

270
00:19:35,510 --> 00:19:37,280
.أشكركم جميعًا حقًّا

271
00:19:38,220 --> 00:19:41,850
شكرًا لكم، أظنّني
.أستطيع أن أثابر قليلاً بعد

272
00:19:43,960 --> 00:19:48,930
!ففي النّهاية، حياتي كقرصان بدأت للتّوّ

273
00:19:58,840 --> 00:20:02,970
أحسنت باستدراجهم إلى
.منطقة الشّعاب الضّبابيّة يا لوفي

274
00:20:02,970 --> 00:20:05,110
تستخدم عقلك بالفعل أحيانًا، أليس كذلك؟

275
00:20:05,110 --> 00:20:06,910
ماذا؟ حقًّا؟

276
00:20:07,310 --> 00:20:10,250
!حقًّا"؟ هذا ما سألتك إيّاه"

277
00:20:10,250 --> 00:20:11,720
مِن أسطول مور

278
00:20:11,720 --> 00:20:14,450
!إلى أيّ سفينة تبحر في هذه المنطقة، حوّل

279
00:20:14,450 --> 00:20:15,990
!هذا أسطول مور

280
00:20:15,990 --> 00:20:17,590
!نحتاج مساعدة فوريّة

281
00:20:18,520 --> 00:20:20,120
!يا إلهي، يا لك من غبيّ

282
00:20:20,120 --> 00:20:21,790
!يا ليتني لم أثنِ عليك
!أسحب كلامي

283
00:20:21,790 --> 00:20:23,030
ماذا؟

284
00:20:23,460 --> 00:20:26,400
ليس وكأنّه فعل ذلك بسابق تفكير، صحيح؟

285
00:20:26,400 --> 00:20:30,640
.إنّه الحظّ فحسب
.كان يؤشّر بيده في أيّ اتّجاه

286
00:20:36,810 --> 00:20:38,480
.بالمناسبة يا طبيب السّفينة

287
00:20:39,010 --> 00:20:42,750
.كيف حاله حقًّا؟ أقصد... الجدّ

288
00:20:45,080 --> 00:20:48,450
الدّواء الّذي أعطيته له يسيطر
.على نوباته فقط كأقصى تقدير

289
00:20:48,450 --> 00:20:50,590
.لن يمنع حالته من أن تسوء

290
00:20:51,320 --> 00:20:54,660
كان قلبه ضعيفًا إلى حدٍّ ما
...من الأساس، وباعتبار سنّه

291
00:20:55,030 --> 00:20:58,460
...الإبحار في سفينة، وكقرصان فوق ذلك

292
00:20:59,560 --> 00:21:01,030
عمّاذا تتحدّثان؟

293
00:21:01,030 --> 00:21:04,970
قال العجوز أنّه يريد أن
.يصير قرصانًا، لذا علينا أن ندعه

294
00:21:05,470 --> 00:21:07,770
،وأيضًا، فور أن يُبحر العجوز

295
00:21:07,770 --> 00:21:12,280
.ربّما يجد جزيرةً تحتوي علاجَ مرضه

296
00:21:12,280 --> 00:21:13,580
.ربّما

297
00:21:13,980 --> 00:21:16,410
.لسنا بحاجة للقلق بشأنه كثيرًا

298
00:21:16,410 --> 00:21:19,750
.لن يموت ذلك العجوز بسهولة

299
00:21:20,350 --> 00:21:24,060
،على الرّغم من قلبه الضّعيف
.إلاّ أنّه جريء حقًّا في النّهاية

300
00:21:25,460 --> 00:21:26,960
.معه حقّ يا تشوبّر

301
00:21:26,960 --> 00:21:28,330
!سنقابله ثانيةً

302
00:21:32,330 --> 00:21:34,200
.نعم، سنلتقي به بالتّأكيد

303
00:21:37,000 --> 00:21:44,080
!سوف ننتظركم يا قراصنة زيني

304
00:21:55,550 --> 00:22:03,650
آه، خلف السّماء الّتي لا نهاية لها

305
00:22:03,650 --> 00:22:14,270
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

306
00:22:22,140 --> 00:22:29,580
مرّت عليّ أيّام كدت أخسر فيها نفسي

307
00:22:29,580 --> 00:22:37,990
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

308
00:22:37,990 --> 00:22:44,160
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

309
00:22:44,160 --> 00:22:55,040
دفعوا بي للأمام، أليس كذلك؟

310
00:22:55,040 --> 00:23:03,480
آه، إنّ النّجوم تهوي من السّماء

311
00:23:03,480 --> 00:23:06,480
...وهذه اللّحظة الفريدة

312
00:23:11,860 --> 00:23:14,030
!جزيرة! أرى منارة أيضًا

313
00:23:14,030 --> 00:23:14,930
!لديهم ما يُؤكل إذًا

314
00:23:14,930 --> 00:23:17,900
!مذهل، إنّها ضخمة للغاية
أهي منارة حقًّا؟

315
00:23:17,900 --> 00:23:20,160
!دعكم منها، لنسرع ونجد ما يُؤكل

316
00:23:20,160 --> 00:23:21,900
ماذا؟ من أنت أيّها العمّ؟

317
00:23:21,900 --> 00:23:25,640
!ماذا؟ ليس عجوزًا غريب الأطوار ثانيةً
!لن أعتني به

318
00:23:26,170 --> 00:23:27,340
:في الحلقة القادمة من ون بيس

319
00:23:27,340 --> 00:23:31,110
!أسطورة ضباب قوس قزح"
".جزيرة لولوكا والعجوز هينزو

320
00:23:31,580 --> 00:23:33,880
!ملك القراصنة، لن يكون إلاّ أنا