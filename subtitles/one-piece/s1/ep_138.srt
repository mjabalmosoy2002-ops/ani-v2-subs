1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:06,750 --> 00:02:07,790
...إنّه

22
00:02:09,390 --> 00:02:11,860
!فخّ! إنّه فخّ من البحريّة

23
00:02:12,260 --> 00:02:14,190
!رفاق

24
00:02:14,190 --> 00:02:14,730
!أوسوبّ

25
00:02:23,330 --> 00:02:25,100
!لنبحر

26
00:02:26,840 --> 00:02:30,440
!مـ-مستحيل! سفينة قراصنة نازلة من الجبل؟

27
00:02:30,440 --> 00:02:31,740
!العجوز

28
00:02:34,310 --> 00:02:39,080
"!مكان كنز الجزيرة! هجوم قراصنة زيني"

29
00:03:03,540 --> 00:03:04,640
...أهذا

30
00:03:04,640 --> 00:03:06,340
!نجحت أيّها العجوز

31
00:03:06,340 --> 00:03:08,180
.مهلاً، لا تتصرّف بطيش

32
00:03:08,180 --> 00:03:10,050
لم يتوقّف قلبه ثانيةً، صحيح؟

33
00:03:10,050 --> 00:03:12,350
!توقّف عن هذا

34
00:03:12,350 --> 00:03:16,250
!أيّها الجدّ! هل أنت بخير؟

35
00:03:22,890 --> 00:03:25,900
.خرجتُ إلى البحر أخيرًا

36
00:03:26,360 --> 00:03:28,930
!أصبحتُ قرصانًا حقًّا

37
00:03:30,300 --> 00:03:33,370
!أجل! ما عاد هذا تابوتي

38
00:03:33,370 --> 00:03:37,040
!إنّها زيني، سفينة قراصنة لائقة
!أليس كذلك؟

39
00:03:39,780 --> 00:03:41,810
!أحسنت أيّها العجوز

40
00:03:41,810 --> 00:03:43,480
!أخبرناك ألاّ تحفّزه

41
00:03:43,480 --> 00:03:44,750
!إنّه رجلٌ مريض

42
00:03:45,050 --> 00:03:47,620
ما الّذي تحاول فعله أيّها الدّائِن زيني؟

43
00:03:47,620 --> 00:03:51,520
مهنتك هي ابتزاز القراصنة
!وسلبهم المال، أليس كذلك؟

44
00:03:51,920 --> 00:03:53,690
.تركتُ مهنة الإدانة قبل وقتٍ طويل

45
00:03:54,090 --> 00:03:56,760
!أنا الآن القرصان زيني

46
00:03:58,260 --> 00:04:00,200
!لا تستنقص من البحريّة أيّها العجوز الهرم

47
00:04:00,660 --> 00:04:04,640
!احترس أيّها العجوز! إنّه يسعى خلف الكنز

48
00:04:05,900 --> 00:04:08,770
إذًا بدأت البحريّة مؤخرًا
،في السّعي خلف الكنز

49
00:04:08,770 --> 00:04:11,880
بالإضافة إلى القبض على القراصنة، أليس كذلك؟

50
00:04:11,880 --> 00:04:14,680
.هذا اجتهاد كبير منكم

51
00:04:15,010 --> 00:04:16,380
.نامي، قرّبي السّفينة

52
00:04:16,380 --> 00:04:17,650
.مفهوم. هيّا، جميعًا

53
00:04:17,650 --> 00:04:20,020
!أنت! لا تملِ الأوامر على نامي-سان

54
00:04:20,220 --> 00:04:22,790
!أيّها الرّقيب مينتشي
!لقد تحرّك قراصنة قبّعة القشّ

55
00:04:22,790 --> 00:04:24,560
!اتّصل بأسطول النّقيب مور للدّعم

56
00:04:24,560 --> 00:04:25,560
!اخرس

57
00:04:33,160 --> 00:04:36,930
.أخبرتك أنّني سأعطيك قسمتك من الكنز

58
00:04:38,200 --> 00:04:39,900
فهمت، أليس كذلك؟

59
00:04:39,900 --> 00:04:42,440
.لا يمكننا إبلاغ النّقيب

60
00:04:44,780 --> 00:04:47,080
...وفق حسابي

61
00:04:49,250 --> 00:04:53,280
أنت تخرس رجالك للعمل
.على هذه المهمّة الجانبيّة

62
00:04:54,420 --> 00:04:57,960
ذلك مكلّف جدًّا، أليس كذلك أيّها الرّقيب؟

63
00:04:58,890 --> 00:05:01,290
...أيّها العجوز الخرف

64
00:05:01,290 --> 00:05:03,190
!ستدفع ثمن هذا

65
00:05:03,190 --> 00:05:04,660
!اخرس يا فتى

66
00:05:04,960 --> 00:05:08,630
!يا لجرأتك لتحاول سرقة كنزي

67
00:05:08,630 --> 00:05:10,600
!تعال وخذه منّي إن استطعت

68
00:05:12,800 --> 00:05:14,610
!أحسنت أيّها العجوز

69
00:05:17,270 --> 00:05:19,740
!أرهم كيف يقاتل القراصنة

70
00:05:41,570 --> 00:05:42,270
!أجل

71
00:05:42,270 --> 00:05:43,700
!غبيّ

72
00:05:44,700 --> 00:05:46,540
ما الّذي تفعله...؟

73
00:05:47,270 --> 00:05:48,740
!...أيّها الـ

74
00:05:49,070 --> 00:05:52,240
إن كنت قرصانًا، فلا تمانع
!إن قتلتك البحريّة، صحيح؟

75
00:05:52,580 --> 00:05:55,610
بالتّفكير في الأمر، هل يملك
ذلك العجوز أيّ أسلحة؟

76
00:05:57,110 --> 00:05:59,150
!أروني ما لديكم

77
00:05:59,150 --> 00:06:02,520
سأواجهكم بمهارات مِعدادي
!ذات التّصنيف العاشر

78
00:06:02,520 --> 00:06:03,750
!عليك بهم

79
00:06:05,560 --> 00:06:07,220
...مِعداده و

80
00:06:07,220 --> 00:06:08,160
.ماعزه

81
00:06:10,730 --> 00:06:13,200
!ماذا؟! مصيبة

82
00:06:14,230 --> 00:06:15,700
!أيّها العجوز

83
00:06:19,940 --> 00:06:20,910
!ذلك الغبيّ

84
00:06:20,910 --> 00:06:22,110
!لوفي

85
00:06:24,380 --> 00:06:27,140
ماذا تفعلون أيّها الأغبياء؟
!علامَ تطلقون؟

86
00:06:27,140 --> 00:06:29,410
!لا تهدروا طلقاتكم هكذا

87
00:06:29,410 --> 00:06:30,880
!أنا ها هنا

88
00:06:30,880 --> 00:06:31,720
!هيّا بنا

89
00:06:41,330 --> 00:06:42,630
!ماذا تفعل؟

90
00:06:42,630 --> 00:06:44,630
!إنّك تواجه ماعز! ماعز

91
00:06:44,630 --> 00:06:47,530
ولأنّها ماعز، لا أستطيع الهجوم
.عليها أيّها الرّقيب

92
00:06:47,530 --> 00:06:50,330
!يا هذا! بدأت المعركة بالفعل

93
00:06:50,330 --> 00:06:53,200
!كفّ عن التّفرّج من الأعلى وانزل إلى هنا

94
00:06:56,610 --> 00:06:58,710
!لنسرع! لنسرع! لنسرع

95
00:06:59,310 --> 00:07:01,110
.نعلم. تنحّ جانبًا للحظة

96
00:07:01,110 --> 00:07:02,780
!اهدأ يا تشوبّر

97
00:07:02,780 --> 00:07:03,680
...لكن

98
00:07:03,910 --> 00:07:07,380
حالة الجدّ الجسديّة لا تسمح
!له بخوض شيءٍ مجنون كهذا

99
00:07:20,830 --> 00:07:21,800
!أطلق عليها

100
00:07:20,830 --> 00:07:21,800
!لا تطلق

101
00:07:32,580 --> 00:07:35,410
تجرّأتم حقًّا! خرج صغاري
!عن السّيطرة الآن

102
00:07:41,620 --> 00:07:43,120
!هجوم

103
00:07:50,930 --> 00:07:54,900
!انظروا! لقد أخذوا مواقعهم وينتظروننا

104
00:07:54,900 --> 00:07:57,870
.من الغريب أنّهم يقفون ساكنين

105
00:07:57,870 --> 00:08:00,370
علينا أن نفكّر في طريقة
.لقتالهم الآن بينما نستطيع

106
00:08:00,840 --> 00:08:04,580
ما العمل إذًا؟ هل نهاجمهم أوّلاً؟

107
00:08:04,580 --> 00:08:05,740
!لا تقل كلامًا مجنونًا

108
00:08:05,740 --> 00:08:09,010
على أيّ حال، علينا الإسراع
!الآن ومساعدة العجوز

109
00:08:09,810 --> 00:08:12,550
بالمناسبة، هل صدمنا شيئًا قبل لحظات؟

110
00:08:12,550 --> 00:08:13,650
ماذا؟ حقًّا؟

111
00:08:13,650 --> 00:08:15,420
!لا يهمّ! لنسرع

112
00:08:16,550 --> 00:08:19,720
أيّها النّقيب مور، لا استجابة
.من سفينة الرّقيب مينتشي

113
00:08:19,720 --> 00:08:21,760
ما كان صوت إطلاق النّار
الّذي سمعناه سابقًا؟

114
00:08:21,760 --> 00:08:22,960
هل نتقدّم؟

115
00:08:22,960 --> 00:08:26,730
.ليس بعد. انتظروا تقرير مينتشي

116
00:08:28,230 --> 00:08:30,170
أين ذهبتِ؟

117
00:08:36,870 --> 00:08:38,840
!اكتفيت منك

118
00:08:43,080 --> 00:08:44,680
!يكفي

119
00:08:48,350 --> 00:08:49,390
!حسنًا

120
00:09:08,270 --> 00:09:11,240
أين ذهبت كلّ حيويّتك؟

121
00:09:11,240 --> 00:09:14,580
هل انقطعت أنفاسك أيّها القرصان زيني؟

122
00:09:14,580 --> 00:09:18,080
.عجبًا، نزلت أخيرًا أيّها النّذل الصّغير

123
00:09:20,120 --> 00:09:22,390
!أنت وغد ثرثار بالفعل

124
00:09:29,790 --> 00:09:32,100
والآن، هل نتحدّث عن العمل؟

125
00:09:33,430 --> 00:09:37,270
أين خبّأت كنزك أيّها القرصان زيني؟

126
00:09:53,450 --> 00:09:54,790
!ماذا قلت؟

127
00:09:55,090 --> 00:09:56,990
!لِمَ لم تبلغ عن هذا أبكر؟

128
00:09:57,250 --> 00:10:00,690
.أنا جدّ آسف أيّها النّقيب مور

129
00:10:03,060 --> 00:10:04,960
...يا لها من حيلة قذرة

130
00:10:05,630 --> 00:10:08,400
هذا ما كان ينوي عليه
!إذًا ذلك البائس مينتشي

131
00:10:14,570 --> 00:10:17,640
لِمَ لا تقرّ بمكانه بسرعة؟

132
00:10:17,640 --> 00:10:19,810
أم أنّك تريد أن تموت؟

133
00:10:20,280 --> 00:10:22,780
.بل أقدّر حياتي

134
00:10:22,780 --> 00:10:25,150
...وأعتزّ بها

135
00:10:25,150 --> 00:10:27,820
.لكن دعني أخبرك أنّني مفلس

136
00:10:27,820 --> 00:10:29,920
بمَ تريدني أن أقرّ؟

137
00:10:29,920 --> 00:10:31,560
.ريقي جافّ أساسًا

138
00:10:35,260 --> 00:10:36,490
.حسنًا

139
00:10:40,130 --> 00:10:42,270
،بما أنّها جزيرة صغيرة

140
00:10:42,270 --> 00:10:47,000
.لن نستغرق طويلاً لحفر كلّ شبرٍ منها

141
00:10:51,680 --> 00:10:53,640
.ما عدتُ بحاجتك

142
00:10:58,420 --> 00:10:59,380
!...أيّها الـ

143
00:11:01,050 --> 00:11:02,250
!هذه نهايتك

144
00:11:10,690 --> 00:11:12,930
.يبدو أنّني كسرتُ مِعدادك

145
00:11:12,930 --> 00:11:13,830
.آسفة

146
00:11:13,830 --> 00:11:15,630
!ماذا تفعلين؟

147
00:11:15,630 --> 00:11:18,400
أتظنّين أنّك تستطيعين تحدّي
...البحريّة والنّجـ

148
00:11:22,870 --> 00:11:23,910
!أيّها الجدّ

149
00:11:25,740 --> 00:11:29,780
!لقد تأخّرتم! كدتُ أموت

150
00:11:29,780 --> 00:11:32,220
!قلقتُ كثيرًا عليك

151
00:11:32,580 --> 00:11:33,180
!نجم الدّخان

152
00:11:35,950 --> 00:11:38,360
!هذه نهاية طريقكم

153
00:11:38,360 --> 00:11:40,160
روبين، هل كنت هنا؟

154
00:11:40,460 --> 00:11:44,260
أيّها العجوز، يمكنك أن تسترخي
...الآن بما أنّ القائد أوسوبّ هنـ

155
00:11:44,260 --> 00:11:46,130
!ماذا حدث؟ إنّه نتوء كبير

156
00:11:47,670 --> 00:11:48,600
!لا يوجد نبض

157
00:11:49,030 --> 00:11:52,100
.اهدأ يا تشوبّر. أنا هنا، هنا

158
00:11:52,100 --> 00:11:56,140
.فهمت! حسنًا، هوّن على نفسك واستلقِ

159
00:11:57,140 --> 00:11:58,940
!إيّاك أن تموت أيّها الجدّ

160
00:11:59,910 --> 00:12:01,950
هل تظنّني سأموت؟

161
00:12:13,460 --> 00:12:15,160
كيف حالك الآن أيّها العجوز؟

162
00:12:17,060 --> 00:12:18,930
.بخير بالطّبع

163
00:12:19,260 --> 00:12:21,370
.أنا قرصان أخيرًا

164
00:12:21,370 --> 00:12:23,200
.ما عدتُ أريد الموت

165
00:12:35,110 --> 00:12:38,620
أتينا إلى الجزيرة بأوامرٍ
.من الرّقيب فحسب

166
00:12:38,620 --> 00:12:43,190
صحيح... أظنّ أنّ التّابعين
.لا يمكنهم عصيان أوامر رؤسائهم

167
00:12:43,190 --> 00:12:46,620
دعني أخبرك أنّ قائدنا
...متقلّب جدًّا هو الآخر

168
00:12:46,620 --> 00:12:48,090
هكذا إذًا؟

169
00:12:48,630 --> 00:12:50,660
.لا تتودّدا هكذا

170
00:12:54,570 --> 00:12:58,440
أ-أيها العجوز، هل أنت بخير؟

171
00:12:58,440 --> 00:13:00,240
بل هل أنت بخير أيّها الشّابّ؟

172
00:13:00,600 --> 00:13:03,840
!يا إلهي، لوفي ميؤوس منه حقًّا

173
00:13:03,840 --> 00:13:07,140
.مرّت وعكتك، هذا مطمئن

174
00:13:07,140 --> 00:13:09,410
.أشكرك أيّها الطّبيب تشوبّر

175
00:13:10,280 --> 00:13:11,720
.آسف

176
00:13:11,720 --> 00:13:14,290
أيّها العجوز، ما رأيك بحيلتي المربحة؟

177
00:13:15,450 --> 00:13:17,020
.ممتازة، شكرًا

178
00:13:19,690 --> 00:13:20,830
.صحيح

179
00:13:20,830 --> 00:13:23,990
أخبرني يا جدّي، بإمكانك
إخبارنا، أليس كذلك؟

180
00:13:24,300 --> 00:13:25,630
بشأن كنزك؟

181
00:13:28,630 --> 00:13:31,640
!أنت! لا تضايقي مرضاي

182
00:13:31,640 --> 00:13:33,170
!أيّها الجدّ، تماسك

183
00:13:34,670 --> 00:13:36,670
...يا إلهي

184
00:13:37,580 --> 00:13:41,380
،نعم، فعلتم الكثير من أجلي

185
00:13:41,380 --> 00:13:43,650
.لذا ربّما يمكنني إخباركم

186
00:13:44,080 --> 00:13:45,550
!هذا ما أردت سماعه

187
00:13:45,550 --> 00:13:48,850
،حتّى البحريّة تعرف عنه
!لذا لا بدّ أنّه كنزٌ مذهل

188
00:13:49,990 --> 00:13:52,990
...كان لي... كنزٌ بالفعل

189
00:13:52,990 --> 00:13:57,430
قام القراصنة الّذين أدين لهم
.برهن كومة من الذّهب لي

190
00:13:57,430 --> 00:14:02,430
،لكن بنيّة شراء سفينة قراصنة وجمع طاقمي

191
00:14:02,430 --> 00:14:04,640
.استبدلته كلّه بالمال

192
00:14:04,640 --> 00:14:05,840
!مال

193
00:14:06,900 --> 00:14:10,640
.بالتّفكير في الأمر، حينها انقلبت حياتي

194
00:14:12,180 --> 00:14:15,550
أخبرتكم البارحة أنّ بعض
القراصنة الّذين كنت أدين لهم

195
00:14:15,550 --> 00:14:18,520
هاجموني بغتةً وانتهى بي المطاف
ملقيًّا إلى شاطئ هذه الجزيرة، صحيح؟

196
00:14:18,920 --> 00:14:21,490
.بطبيعة الحال، استطعتُ حماية المال

197
00:14:22,120 --> 00:14:27,860
ففي النّهاية، لقد خاطرتُ بحياتي
.بذلك المال من أجل شراء حلمي

198
00:14:32,460 --> 00:14:36,430
بعد أن ألقى بي البحر إلى هنا
...واستعدتُ وعيي

199
00:14:47,380 --> 00:14:48,680
!أكلته؟

200
00:14:48,680 --> 00:14:49,550
!حقًّا؟

201
00:14:49,550 --> 00:14:51,220
!كلّه؟! أكلته كلّه؟

202
00:14:51,620 --> 00:14:56,420
.صحيح. أو بالأحرى، تركت ورقتين أو ثلاث

203
00:14:58,190 --> 00:15:02,690
.لذا كما أخبرتكم، هذه الماعز هي كنزي

204
00:15:05,930 --> 00:15:08,370
،ربّما خسرتُ كلّ ثروتي

205
00:15:08,370 --> 00:15:10,430
.لكنّي كسبت أصدقاء بالمقابل

206
00:15:10,900 --> 00:15:13,370
.فهي لا تخونني أو تحاول خداعي

207
00:15:13,370 --> 00:15:15,240
،بتّ أملك الآن أصدقاء إلى جانبي

208
00:15:15,240 --> 00:15:18,610
.لا يقومون بأيّ شيء بدافع أنانيّ

209
00:15:18,610 --> 00:15:20,180
.لذا أريد أن أكافئها على ذلك

210
00:15:20,910 --> 00:15:24,220
.لقد كسبتُ أعظم كنز في العالم

211
00:15:25,250 --> 00:15:27,050
.هذا جيّد أيّها العجوز

212
00:15:27,280 --> 00:15:28,790
.إنّه جيّد بالفعل

213
00:15:28,790 --> 00:15:31,860
.أنا رجل يستفيد من أيّ وضع

214
00:15:34,930 --> 00:15:36,260
!يا للهراء

215
00:15:36,260 --> 00:15:39,100
!اسمع يا قبّعة القشّ
!لم ينته هذا القتال بعد

216
00:15:39,960 --> 00:15:43,300
!ثمّة أسطول سليم ينتظركم هناك

217
00:15:43,300 --> 00:15:46,270
!لا تظنّوا أنّكم ستفلتون بسهولة

218
00:15:47,640 --> 00:15:49,770
.لا تدّع الرّوعة وأنت تتدحرج

219
00:15:49,770 --> 00:15:50,510
أهو غبيّ؟

220
00:15:51,540 --> 00:15:53,040
!أنتم الأغبياء هنا

221
00:15:53,040 --> 00:15:56,710
هل تظنّون أنّكم تستطيعون
!مواجهة أسطول من تسع سفن؟

222
00:16:00,780 --> 00:16:02,290
.لن أهرب

223
00:16:04,790 --> 00:16:07,930
.أخبرهم أن يأتوا إليّ إن كانوا يريدون القتال

224
00:16:08,290 --> 00:16:10,130
...غومو غومو نوو

225
00:16:10,130 --> 00:16:12,830
!يا لوفي! أعلى قليلاً

226
00:16:13,130 --> 00:16:14,100
!عُلم

227
00:16:16,170 --> 00:16:17,800
!المسدّس

228
00:16:21,410 --> 00:16:24,240
.حسنًا، الاتّجاه صحيح

229
00:16:33,680 --> 00:16:37,220
!أنت... عار على البحريّة

230
00:16:41,090 --> 00:16:42,190
!خذوه

231
00:16:42,190 --> 00:16:42,790
!حاضر

232
00:16:50,100 --> 00:16:52,500
.هذا نقيب البحريّة مور

233
00:16:52,970 --> 00:16:56,710
لا أملك اهتمامًا لا بالجزيرة
.ولا بالرّجل المدعوّ زيني

234
00:16:57,040 --> 00:17:02,180
.هدفي الوحيد هو اعتقالكم باسم العدالة

235
00:17:02,180 --> 00:17:07,150
وامتنانًا لتسليمكم هذا العضو
،الضّال من أسطولي

236
00:17:07,150 --> 00:17:09,990
سأترك لكم حريّة اختيار
.المكان الّذي سنتواجه فيه

237
00:17:09,990 --> 00:17:12,490
.هيّا، اجلبوا سفينتكم

238
00:17:13,320 --> 00:17:16,360
.وجدتنا نفكّر في الرّحيل قريبًا أيضًا

239
00:17:16,360 --> 00:17:17,960
.سنأتي إليكم حالاً

240
00:17:21,100 --> 00:17:23,630
.تفضّل أيّها العجوز، لقد أصلحته لك

241
00:17:24,370 --> 00:17:25,740
.هذا ما أتوقّعه منك. أشكرك

242
00:17:26,000 --> 00:17:27,910
.لا عليك

243
00:17:28,840 --> 00:17:32,080
.لقد أعددتُ عشاءك
.عليك أن تسخّنه فحسب

244
00:17:32,080 --> 00:17:33,840
.نعم، أشكرك

245
00:17:34,780 --> 00:17:38,050
لكن يا شباب، هل أنتم واثقون من هذا؟

246
00:17:38,050 --> 00:17:40,850
ستواجهون أسطولاً من تسع سفن، صحيح؟

247
00:17:40,850 --> 00:17:42,520
.لا تقلق

248
00:17:42,950 --> 00:17:46,420
،لستُ قويًّا فحسب
.بل محظوظ أيضًا

249
00:17:47,420 --> 00:17:50,190
.لا أستطيع مجاراتك أيّها الشّابّ

250
00:17:50,590 --> 00:17:51,860
!أيّها الجدّ

251
00:17:51,860 --> 00:17:55,170
،أعددتُ لك مؤونةً من الأدوية
.لذا احرص على أخذها

252
00:17:55,170 --> 00:17:56,670
!عدني

253
00:17:56,670 --> 00:17:58,670
!فهمت، فهمت

254
00:17:59,270 --> 00:18:01,710
.سأحرص على أخذها، لا تقلق

255
00:18:07,410 --> 00:18:09,350
!قضينا وقتًا ممتعًا يا جدّي

256
00:18:09,350 --> 00:18:10,410
.اعتنِ بنفسك

257
00:18:10,410 --> 00:18:13,080
!يا رفاق، اعتنين بالجدّ

258
00:18:14,690 --> 00:18:16,850
!لنتقابل في البحر يومًا ما

259
00:18:17,050 --> 00:18:18,020
!أكيد

260
00:18:18,020 --> 00:18:22,560
سوف أبحر بمجرّد أن أنتهي
!من إصلاح السّفينة

261
00:18:23,430 --> 00:18:28,200
!سنكون في انتظاركم يا قراصنة زيني

262
00:18:33,100 --> 00:18:36,570
.والآن، دعينا نعد إلى الجزيرة لفترة

263
00:18:36,570 --> 00:18:38,040
.علينا إصلاح السّفينة

264
00:18:38,680 --> 00:18:41,980
.حسنًا، غادر الجميع. سنعود أدراجنا

265
00:19:29,660 --> 00:19:34,130
لا علاقة للعمر إن أردت
أن تصبح قرصانًا إذًا؟

266
00:19:35,270 --> 00:19:38,400
.يا إلهي، يعرف كيف يقنع المرء بفكرة

267
00:19:39,770 --> 00:19:42,170
.تشوبّر صبور أيضًا

268
00:19:42,540 --> 00:19:47,510
كم من عام سأستغرق لأكمل
هذه الكومة من الأدوية؟

269
00:19:48,380 --> 00:19:49,510
.أشكركم

270
00:19:49,510 --> 00:19:51,280
.أشكركم جميعًا حقًّا

271
00:19:52,220 --> 00:19:55,850
شكرًا لكم، أظنّني
.أستطيع أن أثابر قليلاً بعد

272
00:19:57,960 --> 00:20:02,930
!ففي النّهاية، حياتي كقرصان بدأت للتّوّ

273
00:20:12,840 --> 00:20:16,970
أحسنت باستدراجهم إلى
.منطقة الشّعاب الضّبابيّة يا لوفي

274
00:20:16,970 --> 00:20:19,110
تستخدم عقلك بالفعل أحيانًا، أليس كذلك؟

275
00:20:19,110 --> 00:20:20,910
ماذا؟ حقًّا؟

276
00:20:21,310 --> 00:20:24,250
!حقًّا"؟ هذا ما سألتك إيّاه"

277
00:20:24,250 --> 00:20:25,720
مِن أسطول مور

278
00:20:25,720 --> 00:20:28,450
!إلى أيّ سفينة تبحر في هذه المنطقة، حوّل

279
00:20:28,450 --> 00:20:29,990
!هذا أسطول مور

280
00:20:29,990 --> 00:20:31,590
!نحتاج مساعدة فوريّة

281
00:20:32,520 --> 00:20:34,120
!يا إلهي، يا لك من غبيّ

282
00:20:34,120 --> 00:20:35,790
!يا ليتني لم أثنِ عليك
!أسحب كلامي

283
00:20:35,790 --> 00:20:37,030
ماذا؟

284
00:20:37,460 --> 00:20:40,400
ليس وكأنّه فعل ذلك بسابق تفكير، صحيح؟

285
00:20:40,400 --> 00:20:44,640
.إنّه الحظّ فحسب
.كان يؤشّر بيده في أيّ اتّجاه

286
00:20:50,810 --> 00:20:52,480
.بالمناسبة يا طبيب السّفينة

287
00:20:53,010 --> 00:20:56,750
.كيف حاله حقًّا؟ أقصد... الجدّ

288
00:20:59,080 --> 00:21:02,450
الدّواء الّذي أعطيته له يسيطر
.على نوباته فقط كأقصى تقدير

289
00:21:02,450 --> 00:21:04,590
.لن يمنع حالته من أن تسوء

290
00:21:05,320 --> 00:21:08,660
كان قلبه ضعيفًا إلى حدٍّ ما
...من الأساس، وباعتبار سنّه

291
00:21:09,030 --> 00:21:12,460
...الإبحار في سفينة، وكقرصان فوق ذلك

292
00:21:13,560 --> 00:21:15,030
عمّاذا تتحدّثان؟

293
00:21:15,030 --> 00:21:18,970
قال العجوز أنّه يريد أن
.يصير قرصانًا، لذا علينا أن ندعه

294
00:21:19,470 --> 00:21:21,770
،وأيضًا، فور أن يُبحر العجوز

295
00:21:21,770 --> 00:21:26,280
.ربّما يجد جزيرةً تحتوي علاجَ مرضه

296
00:21:26,280 --> 00:21:27,580
.ربّما

297
00:21:27,980 --> 00:21:30,410
.لسنا بحاجة للقلق بشأنه كثيرًا

298
00:21:30,410 --> 00:21:33,750
.لن يموت ذلك العجوز بسهولة

299
00:21:34,350 --> 00:21:38,060
،على الرّغم من قلبه الضّعيف
.إلاّ أنّه جريء حقًّا في النّهاية

300
00:21:39,460 --> 00:21:40,960
.معه حقّ يا تشوبّر

301
00:21:40,960 --> 00:21:42,330
!سنقابله ثانيةً

302
00:21:46,330 --> 00:21:48,200
.نعم، سنلتقي به بالتّأكيد

303
00:21:51,000 --> 00:21:58,080
!سوف ننتظركم يا قراصنة زيني

304
00:22:09,550 --> 00:22:17,650
آه، خلف السّماء الّتي لا نهاية لها

305
00:22:17,650 --> 00:22:28,270
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

306
00:22:36,140 --> 00:22:43,580
مرّت عليّ أيّام كدت أخسر فيها نفسي

307
00:22:43,580 --> 00:22:51,990
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

308
00:22:51,990 --> 00:22:58,160
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

309
00:22:58,160 --> 00:23:09,040
دفعوا بي للأمام، أليس كذلك؟

310
00:23:09,040 --> 00:23:17,480
آه، إنّ النّجوم تهوي من السّماء

311
00:23:17,480 --> 00:23:20,480
...وهذه اللّحظة الفريدة

312
00:23:25,860 --> 00:23:28,030
!جزيرة! أرى منارة أيضًا

313
00:23:28,030 --> 00:23:28,930
!لديهم ما يُؤكل إذًا

314
00:23:28,930 --> 00:23:31,900
!مذهل، إنّها ضخمة للغاية
أهي منارة حقًّا؟

315
00:23:31,900 --> 00:23:34,160
!دعكم منها، لنسرع ونجد ما يُؤكل

316
00:23:34,160 --> 00:23:35,900
ماذا؟ من أنت أيّها العمّ؟

317
00:23:35,900 --> 00:23:39,640
!ماذا؟ ليس عجوزًا غريب الأطوار ثانيةً
!لن أعتني به

318
00:23:40,170 --> 00:23:41,340
:في الحلقة القادمة من ون بيس

319
00:23:41,340 --> 00:23:45,110
!أسطورة ضباب قوس قزح"
".جزيرة لولوكا والعجوز هينزو

320
00:23:45,580 --> 00:23:47,880
!ملك القراصنة، لن يكون إلاّ أنا