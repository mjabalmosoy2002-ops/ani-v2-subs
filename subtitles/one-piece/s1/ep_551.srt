1
00:00:00,000 --> 00:02:31,010
!هيّا بنا

2
00:00:04,000 --> 00:00:09,000
الرّجل الّذي اكتسب كلّ شيء في هذا
.العالم، ملك القراصنة غولد روجر

3
00:00:09,400 --> 00:00:13,790
الكلمات الّتي نطق بها قبل أن يلقى حتفه
.دفعت بالنّاس من حول العالم إلى البحار

4
00:00:14,200 --> 00:00:17,330
!كنزي؟ سأعطيكم إيّاه إن أردتموه

5
00:00:17,330 --> 00:00:20,840
!جدوه! تركت كلّ ما هو موجود في هذا العالم فيه

6
00:00:21,330 --> 00:00:23,860
!والآن الجميع يبحثون عن الرّومانسيّة

7
00:00:23,860 --> 00:00:26,470
!دخل العالم عصرًا جديدًا بالفعل

8
00:00:26,470 --> 00:00:30,350
لا أستطيع الثّبات، لا أستطيع الوقوف

9
00:00:30,440 --> 00:00:34,820
لم يبزغ الفجر بعد ولا أطيق الانتظار

10
00:00:34,900 --> 00:00:38,530
!واحد، اثنان، شروق الشّمس، أربعة... هيّا بنا

11
00:00:45,490 --> 00:00:50,750
أحدثوا أمواجًا، اقفزوا من أحلامكم

12
00:00:50,830 --> 00:00:55,290
إن أردتم الذّهاب إلى العالم الّذي لا يصدّق

13
00:00:55,380 --> 00:00:59,720
لن يتطلّب الأمر سوى أن تكونوا أشدّاء

14
00:01:00,170 --> 00:01:02,680
أيعدّ كوننا صريحين جُرمًا؟

15
00:01:02,840 --> 00:01:05,720
مطلوب ← تعني أنك فائز

16
00:01:02,840 --> 00:01:05,720
(. A .)

17
00:01:05,890 --> 00:01:11,480
الحرّيّة هي قاعدتنا الوحيدة

18
00:01:11,600 --> 00:01:16,980
القلق ليس من شيمنا

19
00:01:17,070 --> 00:01:19,530
مهما كلّفني الثّمن يا وان بيس، سأكون الأوّل

20
00:01:19,610 --> 00:01:23,360
قلبي الحالم جدّ واسع

21
00:01:23,530 --> 00:01:27,910
من الضّروريّ ألاّ أستيقظ

22
00:01:27,990 --> 00:01:30,410
لا أستطيع الثّبات، لا أستطيع الوقوف

23
00:01:30,500 --> 00:01:34,540
لم يبزغ الفجر بعد ولا أطيق الانتظار

24
00:01:34,670 --> 00:01:38,130
!واحد، اثنان، شروق الشّمس، أربعة... هيّا بنا

25
00:01:39,840 --> 00:01:45,590
لقد وصلنا... إلى هذا الحد

26
00:01:45,720 --> 00:01:48,510
هيّا بنا إلى... مقبَعِ حلمنا

27
00:01:48,680 --> 00:01:53,640
لن ندع أحدًا خلفنا

28
00:01:53,770 --> 00:01:56,310
المضيّ قُدمًا هو عهدنا

29
00:01:56,400 --> 00:02:00,150
منذ اليوم الّذي بدأ فيه حلمنا ذاك

30
00:02:00,360 --> 00:02:04,700
المستقبل الّذي أبتغيه لم يتغيّر

31
00:02:04,780 --> 00:02:07,200
لا أستطيع الثّبات، لا أستطيع الوقوف

32
00:02:07,320 --> 00:02:11,620
شمس قلبي لن تغرب أبدًا

33
00:02:11,700 --> 00:02:18,540
واحد، اثنان، شروق الشّمس      واحد، اثنان، شروق الشّمس

34
00:02:19,800 --> 00:02:25,880
!واحد، اثنان، شروق الشّمس، أربعة... هيّا بنا

35
00:02:35,350 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

36
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

37
00:02:45,990 --> 00:02:53,370
ولكن لم يكتشفه أحد بالكامل
.سوى غولد روجر، ملك القراصنة

38
00:02:53,370 --> 00:02:59,040
.حطّم العالم الجديد أحلام وطموح العديد من القراصنة

39
00:03:00,420 --> 00:03:06,340
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

40
00:03:06,340 --> 00:03:09,340
.وأصدقاؤه يغامرون في ذلك البحر

41
00:03:09,340 --> 00:03:12,890
!ملك القراصنة، لن يكون إلاّ أنا

42
00:03:15,810 --> 00:03:18,650
،في طريقهم إلى العالم الجديد

43
00:03:18,650 --> 00:03:23,440
وصل لوفي وطاقمه إلى جزيرة البرمائيّين الواقعة
.بـ10،000 متر تحت مستوى البحر

44
00:03:23,440 --> 00:03:28,860
حيث قراصنة البرمائيّين الجدد
...الّذين يسعون لتدمير مملكة ريوغو

45
00:03:28,860 --> 00:03:32,370
بمساعدة من فاندر ديكن الّذي يسعى بدوره
.خلف شيراهوشي، يخوضون مناورات سرّيّة

46
00:03:32,990 --> 00:03:36,080
.يجد طاقم قبّعة القشّ أنفسهم عالقين في الاضطرابات

47
00:03:36,080 --> 00:03:41,080
.أسر هودي كلًا من زورو وأوسوب وبروك في قصر ريوغو

48
00:03:41,080 --> 00:03:44,670
!ابتعد من هنا يا جينبي! قلت أنّي سأذهب

49
00:03:44,670 --> 00:03:48,170
!لا، لن أسمح لك! اترك الأمر لي

50
00:03:49,050 --> 00:03:51,180
!أيّها الوغد

51
00:03:51,180 --> 00:03:54,220
!سأبرحك ضربًا وأذهب فحسب إذًا

52
00:03:54,220 --> 00:03:57,730
!سأواجهك مهما أردت حتّى تفهم

53
00:03:58,270 --> 00:04:00,650
!ماذا قلت؟

54
00:04:28,460 --> 00:04:31,340
!أرى جنودًا من الجيش

55
00:04:34,640 --> 00:04:35,850
!طلقة الماء

56
00:04:58,060 --> 00:05:01,920
"!بداية المعركة! في ساحة غيونكورد"

57
00:05:15,600 --> 00:05:18,010
!القبطان هودي مذهل-هي

58
00:05:18,010 --> 00:05:23,140
لا أصدّق أنّه كان يتلوى ألمًا
!من جرعة زائدة من منشطات الطاقة لتوّه-هي

59
00:05:42,160 --> 00:05:47,500
!هـ-هزم جيش نيبتون

60
00:05:49,050 --> 00:05:50,760
!أبيدوا بالكامل

61
00:05:50,760 --> 00:05:54,260
!ما مدى قوّة هودي؟

62
00:05:55,340 --> 00:05:56,970
!وزير اليمين-دونو

63
00:05:56,970 --> 00:05:59,220
!وزير اليسار-دونو

64
00:05:59,220 --> 00:06:01,600
!نيبتون-ساما

65
00:06:02,270 --> 00:06:05,100
!الملك-ساما

66
00:06:08,230 --> 00:06:10,480
!لنذهب إلى ساحة غيونكورد

67
00:06:13,240 --> 00:06:16,280
!لا، نيبتون-ساما

68
00:06:28,840 --> 00:06:31,170
!نيبتون-ساما

69
00:06:37,010 --> 00:06:39,010
...كنّا وشيكين

70
00:06:40,300 --> 00:06:42,810
!كنّا وشيكين

71
00:06:45,980 --> 00:06:52,570
!كان يفترض أن تؤتي جهودك ثمارها في قمّة العالم هذه السنة

72
00:06:52,570 --> 00:06:54,570
!أيّتها الملكة أوتوهيمي

73
00:06:55,280 --> 00:06:58,160
!ولكنّهم بدؤوا كلّ هذا فجأة

74
00:06:58,780 --> 00:07:00,740
!أرجوك أنقذيه

75
00:07:00,740 --> 00:07:05,290
!سيُقتل الملك-ساما على هذا المعدّل

76
00:07:05,290 --> 00:07:08,170
!أرجوك! أرجوك أنقذي الملك

77
00:07:22,220 --> 00:07:24,060
!أمّي

78
00:07:36,690 --> 00:07:39,660
!ماذا سيحلّ بهذه الدولة؟

79
00:08:02,010 --> 00:08:04,850
!قبطان! أيّها القبطان

80
00:08:04,850 --> 00:08:08,890
.أيّها القبطان ديكن، ستتحسن الأمور مع الوقت

81
00:08:08,890 --> 00:08:12,730
!أيّها الأحمق! لا أريدك أن تواسيني

82
00:08:12,730 --> 00:08:15,320
!لا تعرفون ألم انفطار القلب

83
00:08:16,110 --> 00:08:20,030
.كانت لا تزال شيراهوشي طفلة حين تقابلنا

84
00:08:20,490 --> 00:08:25,790
!وقررت الزواج منها لتحقيق حلم أجدادي

85
00:08:27,080 --> 00:08:29,910
ولكن كيف آل كلّ ذلك؟

86
00:08:41,300 --> 00:08:43,010
"!لست نوعي المفضّل"

87
00:08:47,010 --> 00:08:53,150
لست نوعي المفضّل" ما قالته حين وصلت الكلمات"
.أذناي وشعرت أنّ حبي الحقيقي ينمو، حسب ظنّي

88
00:08:53,150 --> 00:08:56,820
.شعر ياباني بمقاطع إضافيّ. بقلم فاندر ديكن التاسع

89
00:08:56,820 --> 00:09:00,400
!كسرت... كسرت قلبي

90
00:09:04,160 --> 00:09:08,540
!رفضتني، ولذا حلقت شعري

91
00:09:09,620 --> 00:09:10,710
!من الأعلى فقط؟

92
00:09:10,710 --> 00:09:14,250
!أردت قتلها، ولكنّها لا تزال حيّة

93
00:09:14,250 --> 00:09:17,420
!أعرف ذلك لأنّي لا أستطيع رمي الأشياء باتجاهها

94
00:09:17,420 --> 00:09:21,760
!لا بدّ أنّ قبعة القش الوغد يحميها

95
00:09:26,720 --> 00:09:28,640
.صحيح

96
00:09:33,690 --> 00:09:35,020
ما الخطب؟

97
00:09:35,020 --> 00:09:36,900
!أتيت بفكرة

98
00:09:36,900 --> 00:09:41,570
لماذا لا أدمّر كلّ شيء فحسب؟

99
00:09:43,200 --> 00:09:46,070
!أتتني فكرة رائعة

100
00:10:25,530 --> 00:10:28,570
!أطلق سراح الملك-ساما يا هودي

101
00:10:42,050 --> 00:10:44,340
!توقّف وإلّا سنطلق

102
00:10:53,930 --> 00:10:57,690
!اهربوا يا جنود! ستموتون بلا داعٍ-جامون

103
00:10:57,690 --> 00:11:01,610
!لن أسمح لهم بالهروب-هي! دب البحر

104
00:11:23,300 --> 00:11:25,050
!سحقًا

105
00:11:52,990 --> 00:11:55,790
!أتيت أخيرًا! ضقت ذرعًا من الانتظار

106
00:11:55,790 --> 00:11:58,370
!وصلنا يا هيوزو-سان

107
00:11:58,370 --> 00:12:00,620
!لا تقتربا! إنّه خطر

108
00:12:01,080 --> 00:12:04,170
!أتيت كما أردت-دوكان

109
00:12:05,670 --> 00:12:08,800
!لا تملكون مكانًا... تهربون إليه

110
00:12:29,700 --> 00:12:33,870
!لا نستطيع الدخول! مدخل ساحة غيونكورد مقفول

111
00:12:33,870 --> 00:12:35,410
!نيبتون-ساما

112
00:12:35,410 --> 00:12:39,160
!لنتسلّق الحائط! ربّما نستطيع رؤية ما في الداخل

113
00:13:47,730 --> 00:13:52,490
...يا إلهي، سبّب لي الكثير من المتاعب

114
00:13:53,650 --> 00:13:58,120
.أضعنا الكثير من الوقت
.هيّا، لنذهب أيّتها الأميرة

115
00:13:58,120 --> 00:13:59,330
!حسنًا

116
00:14:01,000 --> 00:14:03,290
!اعتني بهاتشي يا كيمي

117
00:14:03,290 --> 00:14:04,750
.حـ-حسنًا

118
00:14:06,500 --> 00:14:08,170
!اذهب يا ميغالو

119
00:14:54,970 --> 00:14:58,470
!يفترض لكم أيّها الجنود أن تحموا الدولة، حالكم يرثى له

120
00:15:05,430 --> 00:15:06,810
...الجنود

121
00:15:12,610 --> 00:15:13,820
!هودي

122
00:15:19,950 --> 00:15:22,910
.ينوي ذلك الجندي فعل شيء ما

123
00:15:23,490 --> 00:15:24,910
أيّ واحد؟

124
00:15:25,620 --> 00:15:31,630
!سيشن هجومًا انتحاريًا لقتل أيّ شخص حوله-بوكان

125
00:15:31,630 --> 00:15:34,000
!سأصبح حبارًا مجففًا إن فعل ذلك-هي

126
00:15:36,470 --> 00:15:39,550
،قبل أن يصل الأمراء إلى هنا

127
00:15:39,550 --> 00:15:43,100
!سيكون جيّدًا إن قتلت أحد ضبّاطهم على الأقل

128
00:15:44,770 --> 00:15:46,850
...لا، سوف

129
00:15:50,480 --> 00:15:52,230
.طلقة الماء

130
00:16:07,960 --> 00:16:10,580
ما هذه؟ إلى أين ستطير؟

131
00:16:32,310 --> 00:16:33,280
ما هذا؟

132
00:16:33,480 --> 00:16:33,940
ماذا؟

133
00:16:33,940 --> 00:16:36,610
.أسمع شيئًا ما

134
00:17:07,890 --> 00:17:13,270
ألم تكن طلقة الماء ضربة ضعيفة؟

135
00:17:21,150 --> 00:17:26,120
أعلم أنّك أخذت الكثير من منشطات الطاقة
!ولكن هذا مذهل-هي

136
00:17:26,120 --> 00:17:30,410
.تحوّل شعرك إلى الأبيض وأصبحت مفتول العضلات

137
00:17:30,410 --> 00:17:33,870
ما هو شعورك أيّها القبطان؟

138
00:17:33,870 --> 00:17:35,630
!رائع

139
00:17:56,360 --> 00:17:57,480
...الجنود

140
00:17:59,020 --> 00:18:01,190
لماذا لم ينتظروننا؟

141
00:18:15,370 --> 00:18:19,340
!فوكابوشي! ريوبوشي! مانبوشي! احترسوا

142
00:18:19,340 --> 00:18:22,090
!كلّ وحوش البحر والبرمائيين أخذوا العقار

143
00:18:23,340 --> 00:18:25,180
عرفت أنّ جيش نيبتون

144
00:18:25,180 --> 00:18:29,050
لم يكن ليهزم بسهولة
!ما دام القتال عادلًا-ري-مي-فا

145
00:18:29,050 --> 00:18:31,140
!سننقذك يا أبي

146
00:18:54,830 --> 00:18:58,710
!لماذا لا تفهم يا هودي جونز؟

147
00:18:58,710 --> 00:19:01,550
!أنتم أضعف من كل من على الجزيرة

148
00:19:02,420 --> 00:19:08,010
كان السكّان الآخرون يحاولون تجاهل تاريخ تفرقة البشر

149
00:19:08,010 --> 00:19:13,520
.ويغفرون لمقتل بطلهم وملكتهم التي ماتت بيد البشر

150
00:19:13,520 --> 00:19:16,980
.تحملوا ألمهم من أجل تغيير المستقبل

151
00:19:16,980 --> 00:19:19,560
.ووقعوا أسماءهم

152
00:19:19,560 --> 00:19:21,050
!الأمير

153
00:19:21,800 --> 00:19:22,610
!فوكابوشي-ساما

154
00:19:25,440 --> 00:19:30,180
لماذا لا تستطيعون استيعاب جرأة ولطف قرارهم؟

155
00:19:31,120 --> 00:19:33,200
لطف؟

156
00:19:33,870 --> 00:19:36,410
وما الذي سيجلبه ذلك؟

157
00:19:36,410 --> 00:19:39,830
!أتريدون أن يخدعكم البشر ثانية؟

158
00:19:43,630 --> 00:19:45,260
:قتال خيل البحر

159
00:19:45,260 --> 00:19:47,880
!رمح العصور

160
00:19:47,880 --> 00:19:50,550
!الكنوز السبعة العظيمة

161
00:19:50,550 --> 00:19:53,100
!بوّابة برج التنين

162
00:19:57,810 --> 00:20:03,690
!هـ-هزموا وحوش البحر

163
00:20:03,690 --> 00:20:07,900
!أنتم أيّها الحمقى تسعون للانتقام من دافع الكره

164
00:20:07,900 --> 00:20:13,120
ولكنّي لن أسمح لكم بسلب حياة الملك
...أو هذه الجزيرة التي تنتمي لمواطنينا

165
00:20:13,580 --> 00:20:16,120
!أو مملكة ريوغو

166
00:20:22,330 --> 00:20:26,050
!إنّهم أقوياء جدًّا! كما هو متوقّع من أقوى رجال المملكة

167
00:20:31,550 --> 00:20:35,720
أتظنون أنّكم انتصرتم لمجرد هزيمتكم لوحوش البحر؟

168
00:20:36,560 --> 00:20:43,190
!لن نخسر. لأنّنا مُنحنا قوّة عظيمة من السماء

169
00:20:43,190 --> 00:20:49,150
!ستسمح لنا تلك القوّة بحكم دولة البرمائيين الحقيقيّة

170
00:20:49,610 --> 00:20:54,990
!سنهزمكم ونقود الطريق إلى التعايش مع البشر

171
00:20:54,990 --> 00:20:56,790
،إن انتصرتم

172
00:20:56,790 --> 00:21:01,540
!فلن تسنح الفرصة لأن يتعايش البرمائيون والبشر لمئات السنين

173
00:21:02,250 --> 00:21:07,250
قولوا ما تشاؤون! ولكن في نهاية المطاف، يحكم هذه الدولة

174
00:21:07,880 --> 00:21:10,340
المنتصر، أليس كذلك؟

175
00:21:42,830 --> 00:21:44,670
!يبدون غريبون

176
00:21:49,590 --> 00:21:50,710
!إنّهم قادمون

177
00:21:50,710 --> 00:21:53,340
مـ-ما هذا؟

178
00:21:54,430 --> 00:21:55,890
.إنّك بطيء

179
00:22:29,670 --> 00:22:31,960
!أسرع يا ميغالو

180
00:22:33,340 --> 00:22:36,300
!أبي-ساما، أرجوك كن بخير

181
00:22:36,300 --> 00:22:39,510
!سيكون بخير! ستحل الأمور

182
00:22:50,980 --> 00:22:55,320
!هذه هي قوّة العقار إذًا

183
00:23:09,040 --> 00:23:14,300
،حاولا شيراهوشي وجينبي إنقاذ نيبتون

184
00:23:14,300 --> 00:23:17,300
.ولكنّهما علقا في فخ هودي

185
00:23:18,090 --> 00:23:22,220
بعرضه لسجنائه، يتأكد هودي فرض
.سيطرته الكاملة على جزيرة البرمائيين

186
00:23:22,220 --> 00:23:26,810
!ويكشف الحقيقة الصادمة المخفية منذ وقت طويل

187
00:23:26,810 --> 00:23:28,190
:في الحلقة القادمة من وان بيس

188
00:23:28,190 --> 00:23:31,730
".اعتراف صادم! الحقيقة خلف اغتيال أوتوهيمي"

189
00:23:31,730 --> 00:23:34,030
!ملك القراصنة، لن يكون إلّا أنا

190
00:23:36,150 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة