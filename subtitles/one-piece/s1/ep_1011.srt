1
00:00:10,480 --> 00:00:17,660
مدّ يدك واقطع الرّياح

2
00:00:17,660 --> 00:00:22,330
ارسم خريطتك الخاصّة

3
00:00:26,920 --> 00:00:33,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:33,590 --> 00:00:40,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:40,060 --> 00:00:46,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:46,350 --> 00:00:49,730
لا يمكن لأحد الجزم بذلك

7
00:00:49,730 --> 00:00:56,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:56,240 --> 00:01:03,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:01:03,200 --> 00:01:09,840
مدّ يدك واقطع الرّياح

10
00:01:09,840 --> 00:01:14,510
اركل الظّلمة بعيدًا

11
00:01:15,510 --> 00:01:22,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:22,720 --> 00:01:26,600
وأنا جاهز لذلك

13
00:01:26,600 --> 00:01:32,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:32,360 --> 00:01:39,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:39,070 --> 00:01:45,790
مدّ يدك واقطع الرّياح

16
00:01:45,790 --> 00:01:51,420
اركل الظّلمة بعيدًا

17
00:01:51,420 --> 00:01:58,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:58,630 --> 00:02:03,430
فلنلوّنها بألواننا الخاصّة

19
00:02:16,370 --> 00:02:19,780
!سبق وسئمت منكم أيّها الحمقى

20
00:02:20,040 --> 00:02:23,160
!يا رفاق! لم يحن أوان الموت بعد

21
00:02:23,330 --> 00:02:27,280
.ما زال كينييمون والبقيّة يواجهون كايدو

22
00:02:33,130 --> 00:02:34,670
!اخرسوا

23
00:02:36,760 --> 00:02:42,420
.وفي طابق العرض، ما زالت مشكلة أوني الجليد قائمة

24
00:02:51,480 --> 00:02:52,600
!ماذا؟

25
00:03:10,540 --> 00:03:11,870
!شكرًا

26
00:03:11,870 --> 00:03:14,460
هل أستطيع ترك هذا الطّابق لك؟

27
00:03:14,840 --> 00:03:17,080
.لا وقت لديّ لهذه اللّعبة اللّعينة

28
00:03:17,550 --> 00:03:19,340
لن تموت، صحيح؟

29
00:03:20,470 --> 00:03:21,510
!بالطّبع لا

30
00:03:21,720 --> 00:03:26,050
.ويواصل لوفي الرّكض نحو كينييمون والبقيّة

31
00:03:28,190 --> 00:03:28,970
...هذا

32
00:03:37,400 --> 00:03:41,280
"!هذا ليس صائبًا! تستدرج العنكبوت سانجي"

33
00:03:46,160 --> 00:03:48,410
!انتظرنا يا كينييمون

34
00:03:52,040 --> 00:03:53,580
!أيّها هو الطّريق إلى السّطح؟

35
00:03:54,590 --> 00:03:55,710
!ذاك

36
00:03:55,710 --> 00:03:56,790
!حسنًا

37
00:04:01,680 --> 00:04:03,090
ما الخطب يا سانجي؟

38
00:04:03,350 --> 00:04:04,760
ماذا تفعل؟

39
00:04:09,390 --> 00:04:12,650
ما قولك؟ ما قولك؟

40
00:04:12,650 --> 00:04:15,500
!لا يجدر بك فعل هذا! لا يجدر بك فعل هذا

41
00:04:15,500 --> 00:04:17,560
!هذا بذيء

42
00:04:18,780 --> 00:04:20,690
!لديّ عمل في غاية الجدّيّة

43
00:04:20,820 --> 00:04:22,610
!واصلا من دوني

44
00:04:23,120 --> 00:04:25,610
!سألحق بكما بمجرّد أن أنتهي

45
00:04:25,860 --> 00:04:27,360
!يا سانجي

46
00:04:28,410 --> 00:04:33,450
.هذا ما توقّعته من طاقم لوفي
...ربّما شعر بوجود عدوّ قويّ

47
00:04:33,830 --> 00:04:35,710
!حسنًا

48
00:04:35,710 --> 00:04:39,840
!لا بدّ أنّ لسانجي سببًا وجيهًا. لنواصل

49
00:04:39,840 --> 00:04:40,880
!نعم

50
00:04:41,390 --> 00:04:44,780
،يبدو أنّ كلّ واحد منهم يتصرّف حسب رغبته

51
00:04:44,780 --> 00:04:47,670
.لكنّهم جميعًا يقومون بما عليهم فعله بالضّبط

52
00:04:49,020 --> 00:04:50,970
...طاقم قبّعة القشّ

53
00:04:51,310 --> 00:04:54,260
!عليّ معرفة خباياهم

54
00:05:05,490 --> 00:05:06,650
!سمعته

55
00:05:09,250 --> 00:05:10,160
...صوت امرأة جذّابة

56
00:05:10,160 --> 00:05:12,370
!هذا بذيء

57
00:05:12,370 --> 00:05:13,990
!يطلب المساعدة

58
00:05:16,250 --> 00:05:19,000
!هذا بذيء

59
00:05:19,630 --> 00:05:21,550
!نعم، اقتربي

60
00:05:21,550 --> 00:05:25,250
!كفّ عن ذلك رجاءً

61
00:05:28,390 --> 00:05:32,020
أيّتها الظّريفة الصّغيرة، ما قولك؟

62
00:05:32,020 --> 00:05:33,970
!لا يجدر بك فعل هذا

63
00:05:35,230 --> 00:05:36,730
ما قولك؟

64
00:05:36,730 --> 00:05:38,390
!لا يجدر بك فعل هذا

65
00:05:39,480 --> 00:05:41,320
ما قولك؟

66
00:05:41,320 --> 00:05:43,110
!توقّف رجاءً

67
00:05:43,110 --> 00:05:45,820
!هذا بذيء

68
00:05:47,530 --> 00:05:50,010
!جملة التّحرّش الجنسيّ القديمة المألوفة

69
00:05:50,010 --> 00:05:52,700
"!ما قولك؟" و"هذا بذيء"

70
00:05:52,700 --> 00:05:55,490
!هذا بذيء

71
00:05:56,170 --> 00:06:00,620
ثمّة شخص من أصحاب السّلطة
.ينزع كيمونو امرأة بلا حيلة

72
00:06:01,040 --> 00:06:05,420
...ما تفقده المرأة الّتي تستدير في كلّ دورة

73
00:06:05,760 --> 00:06:07,340
!ليس ملابسها فحسب

74
00:06:08,050 --> 00:06:09,840
!بل كرامتها أيضًا

75
00:06:13,810 --> 00:06:16,180
!تمهّلي! أنا قادم للمساعدة

76
00:06:16,180 --> 00:06:17,270
...ما قول

77
00:06:17,270 --> 00:06:18,770
!هذا ليس صائبًا

78
00:06:19,270 --> 00:06:20,850
!توقّف

79
00:06:25,360 --> 00:06:27,320
!ماذا؟! ما هذا؟

80
00:06:27,320 --> 00:06:30,150
!هذا بذيء

81
00:06:32,580 --> 00:06:33,830
!شبكة عنكبوت؟

82
00:06:33,830 --> 00:06:36,740
!هذا بذيء

83
00:06:37,000 --> 00:06:38,290
!يكفي

84
00:06:38,290 --> 00:06:41,200
!هذا بذيء

85
00:06:45,800 --> 00:06:47,210
!فخّ بذيء

86
00:07:03,900 --> 00:07:07,520
...أتى رجل عدالة منحرف آخر

87
00:07:07,820 --> 00:07:10,180
...سُحقًا... إنّه فخّ

88
00:07:10,180 --> 00:07:11,650
...لكنّي مسرور

89
00:07:11,870 --> 00:07:16,160
أنّ امرأة جميلة مثلك لم تضطرّ
...لفقدان كرامتها

90
00:07:16,670 --> 00:07:20,370
.السّاق السّوداء سانجي من طاقم قبّعة القشّ

91
00:07:20,880 --> 00:07:23,620
!مكافأته 330 مليون بيري

92
00:07:23,800 --> 00:07:26,570
.واثقة أنّه كان يتنافس مع زورو، زميله في الطّاقم

93
00:07:26,570 --> 00:07:29,430
.أعتقد أنّ مكافأة هذا أعلى

94
00:07:29,430 --> 00:07:31,760
!مذهل! كان صيدنا وفيرًا

95
00:07:32,260 --> 00:07:35,140
!رأس الطّحلب الغبيّ ذلك ليس ندًّا لي

96
00:07:35,140 --> 00:07:39,390
!تمامًا كما أنّكم لستم أندادًا لنا

97
00:07:41,480 --> 00:07:44,730
!افكُكنَ وثاقي! سأغضّ الطّرف هذه المرّة

98
00:07:45,730 --> 00:07:49,110
!كم هذا مخيف! أنت تبتزّنا

99
00:07:49,110 --> 00:07:51,400
!عليّ الذّهاب لمكان ما

100
00:07:52,410 --> 00:07:56,200
.إن ذهبت، ستمتلئ ساحة المعركة أكثر فحسب

101
00:07:56,870 --> 00:08:01,790
.لا أريد لقاعة الوليمة هذه أن تتضرّر من ذلك

102
00:08:02,040 --> 00:08:04,500
!لستُ عازمًا على قتالكنّ

103
00:08:05,210 --> 00:08:06,790
.لا أريد ذلك

104
00:08:07,300 --> 00:08:09,400
لماذا لا تبقى وتستمتع معنا؟

105
00:08:09,400 --> 00:08:12,250
.يفترض أن يكون هذا المكان ممتعًا

106
00:08:16,930 --> 00:08:19,550
في اللّيلة المثلِجة

107
00:08:20,350 --> 00:08:24,520
الاثنان المشتاقان لبعضهما

108
00:08:25,860 --> 00:08:27,350
!مشتاقان لبعضهما؟

109
00:08:31,570 --> 00:08:34,280
ولم يحصلا على فرصة

110
00:08:42,920 --> 00:08:45,750
لرؤية بعضهما لمدّة

111
00:08:47,800 --> 00:08:52,460
!قد رأيا بعضهما أخيرًا

112
00:09:01,390 --> 00:09:03,560
!كم هذا ساحر

113
00:09:04,110 --> 00:09:06,810
تحت ضياء القمر

114
00:09:08,860 --> 00:09:09,980
...لا

115
00:09:10,400 --> 00:09:12,030
!لا، لا

116
00:09:13,110 --> 00:09:15,230
!هذا ليس النّعيم

117
00:09:15,530 --> 00:09:16,650
!بل الجحيم

118
00:09:19,620 --> 00:09:21,610
...رأيتهم الآن

119
00:09:22,120 --> 00:09:24,580
.لقد بقوا واستمتعوا

120
00:09:24,920 --> 00:09:29,420
.عاملتهنّ النّساء هنا بلطف وعناية

121
00:09:29,420 --> 00:09:32,330
.وها قد تعفّنوا الآن

122
00:09:32,680 --> 00:09:37,420
...التّعرّض للمغازلة من النّساء
...إنّ ذلك فاكهة محرّمة

123
00:09:38,010 --> 00:09:40,450
...الجحيم أم النّعيم

124
00:09:40,450 --> 00:09:42,700
...النّعيم أم الجحيم

125
00:09:42,700 --> 00:09:45,810
!هل سينتهي بي المطاف مثلهم؟

126
00:09:46,610 --> 00:09:48,290
...إنّها بوّابة جديدة

127
00:09:48,290 --> 00:09:50,310
!بوّابة النّعيم تُفتح

128
00:09:50,650 --> 00:09:55,440
!أصدقائي في انتظاري! أطلقن سراحي بسرعة

129
00:09:56,530 --> 00:10:01,410
.أتحمّس أكثر عند رؤية ولد كلامه قذر

130
00:10:01,410 --> 00:10:04,280
!ولد"؟! كفّي عن العبث معي"

131
00:10:04,870 --> 00:10:08,500
ماذا عنك أنت؟

132
00:10:10,050 --> 00:10:12,000
...هل أعجبك

133
00:10:12,550 --> 00:10:13,800
أنا؟

134
00:10:13,800 --> 00:10:16,710
...يكفي! أنت لا

135
00:10:18,010 --> 00:10:19,760
...لا تعجبينني، بل

136
00:10:23,060 --> 00:10:24,840
!أنا أحبّك

137
00:10:32,570 --> 00:10:34,270
!الطّابق الثّالث

138
00:10:35,660 --> 00:10:41,780
يبدو أنّ طاقم قبّعة القشّ يركضون
!في طابق القلعة الثّالث

139
00:10:42,040 --> 00:10:45,070
،في الدّرج أمامنا

140
00:10:45,540 --> 00:10:49,120
!ثمّة اثنان من النّجوم متأهّبان

141
00:10:50,380 --> 00:10:51,750
!توقّف

142
00:10:51,750 --> 00:10:55,880
!يا غوريشيرو! لا توقع الموز عليّ

143
00:10:56,720 --> 00:11:00,630
!بوكار-ساما! قبّعة القشّ وجينبي متّجهان إلى هناك

144
00:11:01,470 --> 00:11:03,280
!حسنًا

145
00:11:03,280 --> 00:11:06,090
...أنا نادم على سماحي لكيد بالمرور

146
00:11:08,890 --> 00:11:11,920
!انظروا! مكافأة قبّعة القشّ هي مليار ونصف مليون بيري

147
00:11:11,920 --> 00:11:15,520
إن أطحتُ به، فسيفعل ذلك أكثر
!من مجرّد تبرئة اسمي

148
00:11:15,780 --> 00:11:19,920
.مليار ونصف؟ لنقسمها لـ800 مليون و700 مليون

149
00:11:19,920 --> 00:11:21,440
!سآخذ أنا 800 مليون

150
00:11:21,660 --> 00:11:24,890
!مستحيل! سأطيح به وحدي

151
00:11:24,890 --> 00:11:27,910
!سآخذ المليار ونصف لي وحدي

152
00:11:29,080 --> 00:11:31,770
ما رأيك إذًا أن آخذ مليارًا؟

153
00:11:31,770 --> 00:11:34,160
وخذ أنت نصف المليار، موافق؟

154
00:11:34,550 --> 00:11:38,790
!كيف فكّرتِ في هذه القسمة الغبيّة؟

155
00:11:40,220 --> 00:11:42,420
!أنت! هذا يكفي

156
00:11:43,430 --> 00:11:47,140
،على أيّ حال، إن أطحتُ بقبّعة القشّ
.سأترقّى بكلّ تأكيد

157
00:11:48,100 --> 00:11:51,350
.واحد من التّوبي روبّو... لا يبدو ذلك سيّئًا

158
00:11:51,940 --> 00:11:54,140
!يا قبّعة القشّ-سان! يا قبّعة القشّ-سان

159
00:11:54,360 --> 00:11:55,390
!مِن هنا

160
00:11:55,610 --> 00:11:56,730
من يكونون؟

161
00:11:57,070 --> 00:11:58,810
!أنا أعرفكم

162
00:11:59,910 --> 00:12:02,650
!أحسنتم يا رفاق

163
00:12:02,910 --> 00:12:05,530
!أنتم أبطال السّجناء

164
00:12:10,080 --> 00:12:11,910
!أنتم من أودون

165
00:12:13,370 --> 00:12:15,790
!أنتم، ألم يصل قبّعة القشّ بعد؟

166
00:12:16,340 --> 00:12:18,540
!سيكون هناك قريبًا

167
00:12:22,550 --> 00:12:23,960
...سلّم

168
00:12:24,140 --> 00:12:25,850
أنتم من صنعه؟

169
00:12:25,850 --> 00:12:28,430
!نعم، بإمكانك الوصول للطّابق الرّابع بواسطته

170
00:12:28,430 --> 00:12:31,270
.ثمّة العديد من الأعداء على الدّرج

171
00:12:31,270 --> 00:12:33,640
!سيساعدنا هذا. شكرًا لكم

172
00:12:39,200 --> 00:12:40,940
!أين هو؟

173
00:13:08,430 --> 00:13:09,680
...ليس بعد

174
00:13:10,980 --> 00:13:12,260
!ليس بعد

175
00:13:19,110 --> 00:13:22,110
...سترى بلاد وانو

176
00:13:22,780 --> 00:13:24,400
...الفجر بكلّ تأكيد

177
00:14:02,400 --> 00:14:04,480
!استمعوا إليّ جميعًا

178
00:14:04,480 --> 00:14:07,050
!استعملوا النّار ضدّ أوني الجليد

179
00:14:07,050 --> 00:14:11,700
!إنّ هذا الفيروس مندمج مع الغاز الّذي يبرّد أجسادنا

180
00:14:11,700 --> 00:14:13,540
!انظروا إليّ

181
00:14:13,540 --> 00:14:17,410
!إن أوقفتم عمليّة التّبريد، فلن يتكاثر الفيروس

182
00:14:21,840 --> 00:14:25,380
!سأصنع ما يكفي من التّرياق للجميع

183
00:14:28,340 --> 00:14:32,800
!أنا طبيب! سأنقذ الجميع أعداءً كانوا أم أصدقاء

184
00:14:34,140 --> 00:14:35,140
!ماذا؟

185
00:14:35,140 --> 00:14:38,060
!الجميع؟! هذا يعني أوماسا أيضًا؟

186
00:14:40,350 --> 00:14:44,940
!لذلك حاولوا النّجاة
!لا تسمحوا لذلك الرّجل الشّائن بقتلكم

187
00:14:50,370 --> 00:14:53,740
!هذا جيّد أيّها التّانوكي

188
00:14:54,950 --> 00:14:58,120
!وأنت مثير للشّفقة يا أبو

189
00:14:58,120 --> 00:15:01,100
...نسختي عن لعبة المطاردة

190
00:15:01,100 --> 00:15:04,830
!كيف تجرآن على إفساد اللّعبة الممتعة؟

191
00:15:05,470 --> 00:15:08,340
!أنتما مزعجان

192
00:15:14,180 --> 00:15:15,220
!ماذا؟

193
00:15:17,020 --> 00:15:18,430
!كوين-ساما

194
00:15:20,110 --> 00:15:22,390
!ماذا؟! ماذا؟

195
00:15:23,190 --> 00:15:24,940
!سُحقًا لتلك اللّعبة

196
00:15:24,940 --> 00:15:25,900
ماذا؟

197
00:15:25,900 --> 00:15:32,110
!لم آتِ لهذه الجزيرة لألعب هذه اللّعبة المملّة

198
00:15:32,330 --> 00:15:35,120
...أتيت لتقطيع كايدو

199
00:15:35,120 --> 00:15:37,950
!الّذي يوصف بالأقوى في العالم

200
00:15:45,090 --> 00:15:46,040
!ماذا؟

201
00:15:46,040 --> 00:15:48,960
!تسبّب غضبه بزلزال؟

202
00:15:48,960 --> 00:15:51,380
!أهذا هاكي؟! أهو لون الملك الأسمى؟

203
00:16:05,230 --> 00:16:08,150
!تماسكوا! تماسكوا جميعًا

204
00:16:10,910 --> 00:16:14,910
!زورو-سان، ماذا فعلت؟! لا أصدّق أنّك فعلت هذا

205
00:16:14,910 --> 00:16:16,780
.مستحيل أن أكون السّبب

206
00:16:21,880 --> 00:16:24,000
!ما هذه الهزّة؟

207
00:16:24,000 --> 00:16:25,500
!أنا خائفة

208
00:16:26,300 --> 00:16:28,790
!لا، لستُ خائفة

209
00:16:29,090 --> 00:16:31,920
!ستكونين بخير! واصلي التّقدّم فحسب

210
00:16:31,920 --> 00:16:33,510
!أسرع أكثر

211
00:16:41,520 --> 00:16:44,270
!ما هذا؟! أهو زلزال يا جينبي؟

212
00:16:44,270 --> 00:16:47,640
...هذه الجزيرة فريدة من النّاحية الجيولوجيّة، لكن

213
00:17:03,380 --> 00:17:05,880
!كلاّ! لا يمكننا الوصول للشّاطئ

214
00:17:05,880 --> 00:17:08,660
!ابتعدوا عن أونيغاشيما حاليًّا

215
00:17:20,520 --> 00:17:21,590
...ما الّذي

216
00:17:23,400 --> 00:17:25,260
...يا لقلّة صبره

217
00:17:31,280 --> 00:17:33,360
!هل ستغرق الجزيرة؟

218
00:17:54,800 --> 00:17:58,380
!إنّ أونيغاشيما... ما الّذي يحدث؟

219
00:17:58,590 --> 00:18:01,840
!هل تعتقدون أنّ قبطاننا بخير؟

220
00:18:13,280 --> 00:18:16,550
!مومونوسكي-كُن! لنجاتك الأولويّة الآن

221
00:18:16,550 --> 00:18:18,610
!لنغادر المكان على سفينة

222
00:18:19,240 --> 00:18:20,950
!علينا الإسراع

223
00:18:22,000 --> 00:18:23,820
!يراودني شعور سيّئ

224
00:18:31,590 --> 00:18:33,120
ما كان ذلك؟

225
00:18:33,550 --> 00:18:35,540
.توقّف الاهتزاز

226
00:18:44,520 --> 00:18:47,720
.أعلم يا زورو... رأيتُ ذلك أيضًا

227
00:18:53,400 --> 00:18:54,480
...هذا

228
00:18:58,320 --> 00:19:00,570
!رأيته أيضًا

229
00:19:02,500 --> 00:19:05,070
...عليّ الوصول إلى كايدو قبل فوات الأوان

230
00:19:09,630 --> 00:19:12,290
!إنّه ذراع أوكيكو-تشان

231
00:19:18,140 --> 00:19:19,710
.أنا متأخّر

232
00:19:20,100 --> 00:19:22,630
.أتمنّى لو كان بإمكاني الطّيران

233
00:19:27,140 --> 00:19:30,560
.لكن لكلّ طريق عقباته

234
00:19:48,080 --> 00:19:49,750
!يا طاقم قبّعة القشّ

235
00:19:49,750 --> 00:19:51,290
!ماركو العنقاء

236
00:19:51,290 --> 00:19:53,160
!نعم، هذا هو أنا-يوي

237
00:19:53,380 --> 00:19:57,290
،أنتم القوّات الرّئيسيّة
!فلماذا ما زلتم في هذا الطّابق؟

238
00:19:57,720 --> 00:20:00,380
.ليس ذلك باختيارنا

239
00:20:01,010 --> 00:20:03,630
أهنالك ما أستطيع المساعدة به؟

240
00:20:13,360 --> 00:20:14,810
!ما الخطب؟

241
00:20:16,030 --> 00:20:19,740
!سفينة قراصنة مملكة الحيوان... ليست موجودة

242
00:20:19,740 --> 00:20:20,690
!ماذا؟

243
00:20:36,090 --> 00:20:37,300
!وكذلك البحر

244
00:20:37,300 --> 00:20:40,080
!ماذا؟! ما قصدك بذلك؟

245
00:20:40,970 --> 00:20:42,800
!فات الأوان

246
00:20:44,060 --> 00:20:46,510
!ما عاد بإمكاننا الهرب بحرًا الآن

247
00:20:46,850 --> 00:20:49,260
!أليس هذا ميناءً؟

248
00:20:50,060 --> 00:20:51,890
...ذلك الزّلزال قبل قليل

249
00:20:53,860 --> 00:20:55,310
!فهمت الآن

250
00:20:55,480 --> 00:20:58,480
!ما الّذي يحدث يا ياماتو؟

251
00:21:09,030 --> 00:21:13,660
!تطير التّنانين في الهواء بإنشاء سحب اللّهب

252
00:21:18,050 --> 00:21:19,710
...هذا يعني

253
00:21:48,870 --> 00:21:50,990
...ذ-ذلك مستحيل

254
00:22:40,670 --> 00:22:43,190
أأنتم راضون الآن؟

255
00:22:43,190 --> 00:22:45,330
.ولّت كوزكي

256
00:22:46,180 --> 00:22:49,780
...بلاد وانو، بل أونيغاشيما الجديدة

257
00:22:49,780 --> 00:22:52,880
.ستصير معقلاً للقراصنة

258
00:23:05,030 --> 00:23:09,610
!فلندخل عالمًا من العنف

259
00:23:18,410 --> 00:23:21,540
.تمّ تنفيذ مشروع أونيغاشيما الجديدة

260
00:23:21,540 --> 00:23:25,040
إضافة لذلك، هجمات التّوبي روبّو
الحامية تزيد الطّين بلّة

261
00:23:25,040 --> 00:23:28,110
.ويواجه طاقم قبّعة القشّ وقتًا صعبًا

262
00:23:28,110 --> 00:23:35,630
يعود ماركو خلال هذا الوضع الطّارئ ويطلق
!دوّامة نار في ساحة المعركة بكلّ عزيمة

263
00:23:36,390 --> 00:23:41,640
:في الحلقة القادمة من وان بيس
"!انقلاب الموازين! لهيب ماركو العنقاء"

264
00:23:41,640 --> 00:23:45,640
!ملك القراصنة، لن يكون إلاّ أنا