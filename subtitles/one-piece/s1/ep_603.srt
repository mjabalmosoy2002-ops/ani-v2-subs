1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,380 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:45,920 --> 00:02:53,310
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,310 --> 00:02:59,080
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,460 --> 00:03:06,590
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,590 --> 00:03:08,390
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:09,020 --> 00:03:12,880
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:16,150 --> 00:03:18,020
،بعد نجاتهم من معركة حامية

37
00:03:18,420 --> 00:03:20,940
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:20,940 --> 00:03:23,490
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:23,910 --> 00:03:27,910
،رسوا في بانك هازارد، جزيرة من جزئين
.أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:28,280 --> 00:03:31,310
،بعد تشكيل تحالف مع ترافالغار لو

41
00:03:31,310 --> 00:03:35,250
التقى لوفي بسيزار كلاون أخيرًا

42
00:03:35,250 --> 00:03:38,500
.لكنّه هُزم بسبب قدراته الغامضة

43
00:03:39,210 --> 00:03:45,300
،أثناء ذلك، هُزم لو أيضًا على يد فيرغو
.قائد قاعدة جي-5 للبحريّة

44
00:03:45,670 --> 00:03:46,510
...اهـ

45
00:03:46,970 --> 00:03:49,800
!اهربوا

46
00:03:49,810 --> 00:03:51,130
...يا قبّعة القشّ-يا

47
00:03:51,760 --> 00:03:55,680
.لا يجب أن أغفل عن أيّ تفصيل هنا

48
00:03:57,100 --> 00:03:58,770
.لنبدأ المقاومة

49
00:04:02,100 --> 00:04:06,240
"!إطلاق هجوم مضادّ! هروب لوفي ولو العظيم"

50
00:04:10,950 --> 00:04:14,500
.الشّيتشيبوكاي الملكيّ ترافالغار لو

51
00:04:16,730 --> 00:04:20,470
قرصان تصدّر اسمه عناوين الأخبار
،مؤخّرًا بعد عودته القويّة للسّاحة

52
00:04:20,470 --> 00:04:22,330
.قبّعة القشّ لوفي

53
00:04:23,910 --> 00:04:27,670
،وواحدة من أفراد طاقمه
.الطّفلة الشّيطانة نيكو روبين

54
00:04:29,170 --> 00:04:32,770
.كلب البحريّة الجامح، الصّيّاد الأبيض سموكر

55
00:04:34,710 --> 00:04:38,640
كيف لهذه الأسماء الكبيرة أن تقع في قبضة سيزار؟

56
00:04:39,240 --> 00:04:40,650
!ماذا؟

57
00:04:41,330 --> 00:04:44,700
!هؤلاء هم! إذًا فهم هناك

58
00:04:44,700 --> 00:04:46,150
ماذا نفعل؟

59
00:04:48,330 --> 00:04:51,450
.لنرَ كيف ستسير الأمر لوهلة-بون

60
00:04:55,400 --> 00:04:56,620
...مهلاً، إنّهم

61
00:05:00,250 --> 00:05:04,710
!خرجت من جحرك أخيرًا يا قبّعة القشّ

62
00:05:00,710 --> 00:05:04,710
يوستاس ”كابتن“ كيد

63
00:05:04,880 --> 00:05:08,590
قبطان قراصنة كيد
المكافأة على رأسه: 470 مليون بيلي

64
00:05:05,190 --> 00:05:06,860
.لا فائدة من المشاهدة

65
00:05:07,380 --> 00:05:11,690
كما أنّك لستَ من الرّجال الّذين يريدون
...أن يكونوا سماسرة أسلحة، صحيح

66
00:05:10,590 --> 00:05:12,800
كيلر

67
00:05:11,690 --> 00:05:12,550
يا كيلر؟

68
00:05:14,640 --> 00:05:18,140
عضو من قراصنة كيد
المكافأة على رأسه: 200 مليون بيلي

69
00:05:14,810 --> 00:05:16,640
.معك حقّ

70
00:05:19,350 --> 00:05:23,170
.لكن لا أصدّق أنّ أولئك الثّلاثة هناك معًا

71
00:05:23,560 --> 00:05:26,110
!صحيح، ذلك الوغد ترافالغار

72
00:05:26,110 --> 00:05:29,440
،ظننتُ أنّه فقد عقله عندما صار كلبًا للحكومة

73
00:05:29,610 --> 00:05:33,620
.لكنّه كان يسعى لأمر آخر على ما يبدو

74
00:05:33,620 --> 00:05:35,620
هل يخطّط لشيء ما؟

75
00:05:36,090 --> 00:05:40,290
!لا يجب أن نتأخّر عن الرّكب
!سنتحرّك نحن أيضًا

76
00:05:40,930 --> 00:05:43,500
.رجاءً يا كيد، تعامل مع الوضع بعقلانيّة

77
00:05:43,500 --> 00:05:45,040
!أعلم ذلك! اخرس فحسب

78
00:05:54,430 --> 00:05:57,430
سكراتشمن أبو

79
00:05:54,510 --> 00:05:57,160
!مرحبًا يا كابتن كيد

80
00:05:58,470 --> 00:06:01,310
بازيل هوكينس

81
00:06:01,810 --> 00:06:05,480
!تبدو مزعجًا كعادتك

82
00:06:06,520 --> 00:06:09,780
!سكراتشمن! ما الّذي تفعله؟

83
00:06:09,780 --> 00:06:12,910
!أحدثت الفوضى في مخبئنا

84
00:06:12,910 --> 00:06:15,700
!عفوًا يا كابتن! لم نستطع إيقافه

85
00:06:16,200 --> 00:06:19,960
.كنتُ أحرص على أنّك لم تجهّز أيّ قنّاصين

86
00:06:19,530 --> 00:06:25,040
قبطان قراصنة البثّ المباشر
المكافأة على رأسه: 350 مليون بيري

87
00:06:20,660 --> 00:06:25,040
.كان أيّ أحد ليفعل ذلك إن استُدعي من طرف عدوّه

88
00:06:25,210 --> 00:06:27,090
!أرأيت يا كيلر؟

89
00:06:27,090 --> 00:06:30,630
!لهذا السّبب أخبرتك ألاّ تستدعيه

90
00:06:30,920 --> 00:06:34,170
.اهدأ الآن. إنّه رجل قويّ

91
00:06:34,470 --> 00:06:39,940
قبطان قراصنة هوكينس
المكافأة على رأسه: 320 مليون بيري

92
00:06:34,930 --> 00:06:39,930
.يا لطيشك لأنّك جعلت ضيفًا دعوته بنفسك ينتظر

93
00:06:41,850 --> 00:06:44,600
...أوغاد هنا وهناك

94
00:06:44,600 --> 00:06:47,480
!سأقتلكما هنا والآن

95
00:06:47,770 --> 00:06:49,950
!عرفتُ أنّ ذلك ما أردتَه

96
00:06:49,950 --> 00:06:51,770
!أنا جاهز لذلك

97
00:06:51,770 --> 00:06:53,480
!أرني ما لديك! أسمعني

98
00:06:54,030 --> 00:06:56,900
.هذا غباء مستفحل. أنا ذاهب

99
00:06:56,900 --> 00:06:59,700
!مهلاً يا هوكينز! ليس بهذه السّرعة

100
00:07:01,700 --> 00:07:04,830
!وأنتما! يكفي من هذا

101
00:07:05,250 --> 00:07:07,120
...فمرادنا من كلّ هذا

102
00:07:07,670 --> 00:07:10,100
!هو عقد تحالف مع طاقميكما

103
00:07:12,670 --> 00:07:16,100
!ألا تعرفون حتّى كيف تتحدّثون؟

104
00:07:19,760 --> 00:07:21,470
هجوم مضادّ؟

105
00:07:21,470 --> 00:07:24,640
.نعم، فلا جدوى من إضاعة الوقت هنا

106
00:07:24,640 --> 00:07:26,420
.لننهِ هذا الأمر

107
00:07:27,100 --> 00:07:30,270
أيستطيع أيّ أحد منكم حرق الأشياء؟

108
00:07:30,750 --> 00:07:32,360
.لا بأس إن لم يكن أيضًا

109
00:07:32,560 --> 00:07:33,990
.يستطيع فرانكي إضرام النّيران

110
00:07:33,990 --> 00:07:35,880
!كما يستطيع إطلاق أشعة ليزر أيضًا

111
00:07:35,880 --> 00:07:36,740
!صحيح

112
00:07:37,070 --> 00:07:39,860
لماذا لا يمكنك إذابة هذه السّلاسل بأشعتك؟

113
00:07:39,860 --> 00:07:44,290
.أحتاج لاستعمال كلتا يديّ لتنفيذ الشّعاع الجذريّ

114
00:07:44,600 --> 00:07:46,290
...الشّيء الوحيد الّذي أستطيع إطلاقه

115
00:07:49,000 --> 00:07:51,760
!المدفع النّفّاث من مرخّرتي

116
00:07:52,960 --> 00:07:54,230
.لا يهمّ

117
00:07:54,790 --> 00:07:57,130
هل بإمكانك إضرام النّار في سفينة
البحريّة هناك عند اليمين؟

118
00:07:57,670 --> 00:07:59,820
ماذا؟ تلك؟

119
00:08:02,590 --> 00:08:05,090
!ذلك سهل سهولة شرب الماء يا أخي

120
00:08:05,090 --> 00:08:07,390
!اعتمد عليّ

121
00:08:07,600 --> 00:08:10,300
...كرة

122
00:08:12,810 --> 00:08:17,650
!نار فرانكي

123
00:08:23,530 --> 00:08:25,290
!السّفينة تحترق

124
00:08:25,290 --> 00:08:26,480
!اهربوا

125
00:08:27,080 --> 00:08:28,870
!أخمدوا النّار

126
00:08:33,330 --> 00:08:37,460
ما الّذي يفعله؟ أهو يائس لهذا الحدّ؟

127
00:08:37,460 --> 00:08:39,170
!ذلك الوغد الشّبيه بالباسيفيستا

128
00:08:41,220 --> 00:08:42,760
.لا فائدة من ذلك

129
00:08:42,760 --> 00:08:49,100
بعد انقضاء التّجربة، سأبتر أجسادهم
.وأستعملهم خير استعمال

130
00:08:49,850 --> 00:08:51,940
!الدّخان يحجب عنّي رؤية القفص

131
00:08:51,940 --> 00:08:53,600
هل أنتِ بخير أيّتها النّقيب-تشان؟

132
00:08:53,990 --> 00:08:56,230
!سمو-سان، هل الدّخان كثير هناك؟

133
00:08:56,230 --> 00:08:59,440
!غبيّ! إنّه رجل دخانيّ من الأساس

134
00:09:09,490 --> 00:09:13,960
!يا ترافالغار! صار الدّخان كثيفًا هنا

135
00:09:13,960 --> 00:09:15,540
.أنت من تسبّب بهذا

136
00:09:15,540 --> 00:09:17,670
!بناءً على طلبك

137
00:09:19,710 --> 00:09:21,460
ما الّذي تفعلانه؟

138
00:09:22,710 --> 00:09:23,760
...حسنًا

139
00:09:25,440 --> 00:09:26,640
!ماذا؟

140
00:09:27,670 --> 00:09:33,430
لم نعد الآن تحت مراقبة حلازين
.اتّصال البثّ الخاصّة بسيزار

141
00:09:34,420 --> 00:09:36,560
.لن يكتشفوا الأمر إلاّ بعد فترة

142
00:09:36,810 --> 00:09:38,300
!هذا لا يصدّق

143
00:09:38,300 --> 00:09:40,900
كيف حرّرت نفسك من سلاسل الحجر البحريّ؟

144
00:09:41,190 --> 00:09:44,530
سألت كيف؟ هذا لأنّ سلاسلي
.كانت عاديّة من البداية

145
00:09:44,650 --> 00:09:45,490
ماذا؟

146
00:09:45,800 --> 00:09:48,070
.لذا استطعت تحرير نفسي بسهولة بقدرتي

147
00:09:49,150 --> 00:09:50,200
!غرفة

148
00:09:53,780 --> 00:09:57,180
أتدرون كم شهرًا وأنا في هذا المكان؟

149
00:09:57,700 --> 00:09:59,960
،لذلك من باب الحيطة

150
00:10:00,830 --> 00:10:04,370
وضعت عددًا من السّلاسل العاديّة
.في كلّ مكان من المختبر

151
00:10:05,090 --> 00:10:07,520
وذلك لأتجنّب الحجر البحريّ

152
00:10:08,060 --> 00:10:10,930
.حتّى إن قُّدت بها بالخطأ

153
00:10:21,860 --> 00:10:24,130
!أنا حرّ

154
00:10:24,940 --> 00:10:26,650
.كفّ عن الصّراخ أيّها الغبيّ

155
00:10:26,650 --> 00:10:29,660
!مرحى، مرحى، أنا حرّ

156
00:10:29,660 --> 00:10:30,910
...والآن

157
00:10:32,330 --> 00:10:34,030
ما الّذي يجدر بي فعله بكما؟

158
00:10:35,700 --> 00:10:38,050
.عرفتم أكثر ممّا يجب

159
00:10:39,170 --> 00:10:42,960
.قدركما تحت رحمتي الآن

160
00:10:43,150 --> 00:10:45,140
قرّرت ما ستفعل مسبقًا، صحيح؟

161
00:10:45,810 --> 00:10:48,640
!فافعل ذلك وأرحنا

162
00:10:50,280 --> 00:10:51,610
سموكر-سان؟

163
00:10:53,370 --> 00:10:55,720
!عدنا لطبيعتيْنا

164
00:11:02,310 --> 00:11:06,030
!لا داعي للصّراخ كامرأة أيّتها الشّابّة

165
00:11:06,900 --> 00:11:08,870
!أسرع وحرّرنا

166
00:11:09,340 --> 00:11:11,280
!سأفعل كلّ ما تأمر به

167
00:11:11,730 --> 00:11:13,430
!ما هذا الهراء يا تاشيغي

168
00:11:13,430 --> 00:11:16,330
!ألا تفضّلين الموت على التّوسّل لقرصان؟

169
00:11:16,330 --> 00:11:19,120
،في الوقت الحاليّ، علينا التّوسّل لحياتنا

170
00:11:19,120 --> 00:11:20,910
!بل وحتّى رمي أنفسنا تحت قدميه إن تطلّب الأمر

171
00:11:20,910 --> 00:11:22,920
،لأنّه إن متنا هنا

172
00:11:23,540 --> 00:11:27,030
...فلن نستطيع إنقاذ رجالنا، ونائب الأميرال فيرغو

173
00:11:30,170 --> 00:11:34,220
.إنّ فيرغو سيتصرّف كما يحلو له في البحريّة

174
00:11:34,650 --> 00:11:36,060
...ولا تنس الأطفال

175
00:11:37,110 --> 00:11:40,230
!لا يجب أن نموت هنا

176
00:11:43,700 --> 00:11:45,740
.إنّها أذكى منك

177
00:11:46,840 --> 00:11:51,260
،أيّها الصّيّاد الأبيض-يا، لا يوجد من يجبرني على إنقاذك

178
00:11:51,260 --> 00:11:55,330
لكن إن كان السّماح لك بالعودة سالمًا
،للقاعدة سيجعل فيرغو يفقد مكانته

179
00:11:55,330 --> 00:11:57,120
.فذلك سيخدمني كثيرًا

180
00:11:57,890 --> 00:12:03,060
.ولكن، عليك أن تنسى كلّ ما سمعته عنّي وعن جوكر

181
00:12:03,900 --> 00:12:07,740
.هذا ليس طلبًا. بل شرطًا

182
00:12:08,050 --> 00:12:11,440
.لقاء الإبقاء على حياتك

183
00:12:33,640 --> 00:12:35,590
!لا يمكنن رؤية أيّ شيء

184
00:12:37,220 --> 00:12:39,430
ما الّذي يحدث هناك؟

185
00:12:41,850 --> 00:12:44,750
!أجل، تمكّنت من الخروج أخيرًا

186
00:12:44,750 --> 00:12:45,550
!حسنًا

187
00:12:45,550 --> 00:12:46,310
...ما الّذي

188
00:12:46,310 --> 00:12:47,480
!مرحى

189
00:12:47,480 --> 00:12:48,170
!انتظر

190
00:12:49,690 --> 00:12:51,860
!كيف يجرؤ على التّصرّف كما يحلو له؟

191
00:12:51,860 --> 00:12:55,180
.القفص ليس مصنوعًا من الحجر البحريّ

192
00:12:55,410 --> 00:12:59,230
.يقوم قبطاننا بتلك الأشياء بمجرّد أن تدير ظهرك له

193
00:13:04,620 --> 00:13:05,790
!يا له من أحمق

194
00:13:09,360 --> 00:13:11,610
!يا تورا-أو

195
00:13:12,090 --> 00:13:13,880
!أجل

196
00:13:13,880 --> 00:13:16,030
!كيف يمكنني الدّخول؟

197
00:13:17,390 --> 00:13:18,890
.يا أخي

198
00:13:18,890 --> 00:13:23,060
.أفضّل أن أهتمّ بساني

199
00:13:23,060 --> 00:13:24,670
.افعل ما يحلو لك

200
00:13:25,300 --> 00:13:27,630
!حسنًا، إلى اللّقاء

201
00:13:27,630 --> 00:13:29,650
...المدفع

202
00:13:29,650 --> 00:13:31,220
!النّفّاث

203
00:13:31,570 --> 00:13:33,610
!أنا قادم يا ساني

204
00:13:33,610 --> 00:13:35,870
!أعتمد عليك يا فرانكي

205
00:13:35,870 --> 00:13:36,930
!رائحة مقرفة

206
00:13:43,120 --> 00:13:44,810
لماذا تنظرين إليّ هكذا؟

207
00:13:45,010 --> 00:13:47,940
!هيّا! ما الّذي تنتظره يا تورا-أو؟

208
00:14:09,110 --> 00:14:11,170
.يا سمو-يان

209
00:14:11,490 --> 00:14:14,240
!أيّتها النّقيب-تشان! هل أنت بخير؟

210
00:14:14,240 --> 00:14:16,950
!ماذا علينا فعله؟

211
00:14:17,800 --> 00:14:20,750
...انظروا هنا. إنّه

212
00:14:22,040 --> 00:14:24,630
!سيصل الغاز السّام إلى هنا قريبًا

213
00:14:31,250 --> 00:14:34,700
إن لم نفع أيّ شيء، فما حدث
...لمن كانوا على ذلك البثّ

214
00:14:38,660 --> 00:14:42,950
!لا-لا فائدة! علينا الدّخول إلى المبنى الآن

215
00:14:45,000 --> 00:14:46,750
!الباب مغلق

216
00:14:46,750 --> 00:14:48,710
!سُحقًا! افتحوا

217
00:14:52,270 --> 00:14:54,970
!اهربوا

218
00:14:57,290 --> 00:15:01,100
!بإمكاننا الرّكض أسرع هكذا، لكنّه يكاد يُدركنا

219
00:15:01,100 --> 00:15:04,640
!التّنّين بعيد جدًّا

220
00:15:04,640 --> 00:15:07,210
!لنمسك به بسرعة ونطر به

221
00:15:07,690 --> 00:15:08,860
...لا أستطيع

222
00:15:08,860 --> 00:15:10,480
!سانجي-سان، تماسك

223
00:15:10,680 --> 00:15:12,000
!ما عدت أستطيع الرّكض

224
00:15:12,000 --> 00:15:15,410
!وظائف نامي-سان التّنفّسيّة ما عادت تستطيع التّحمّل

225
00:15:16,610 --> 00:15:18,960
!أشعر بضيق في صدري

226
00:15:19,280 --> 00:15:21,120
...صدرها... صدر

227
00:15:24,860 --> 00:15:25,790
!صدر

228
00:15:30,290 --> 00:15:31,780
!أمسكته

229
00:15:31,780 --> 00:15:34,840
!أيّ نوع من القوى الغبيّة كان هذا؟

230
00:15:40,250 --> 00:15:42,470
!الدّخان يقترب منّا

231
00:15:42,470 --> 00:15:44,660
...ذلك اللّون مريب

232
00:15:44,660 --> 00:15:47,180
!لا بدّ أنّه سامّ بشدّة

233
00:15:47,620 --> 00:15:49,750
!آسفة أيّها اللّحية البنّيّة-تشي

234
00:15:49,750 --> 00:15:52,150
!أنت مصاب بشدّة، ومع ذلك تحملنا

235
00:15:53,670 --> 00:15:57,080
.لا مشكلة في ذلك. الأمر أشبه بحمل أقزام

236
00:15:57,080 --> 00:15:59,780
!عليّ إنقاذ رجالي في كلّ الأحوال

237
00:16:00,220 --> 00:16:02,680
!علينا إنقاذ أولئك الأطفال

238
00:16:02,680 --> 00:16:05,310
!آمل ألاّ يكونوا قد تناولوا تلك الحلوى

239
00:16:05,310 --> 00:16:07,220
!انظر هناك! ما ذلك الشّيء؟

240
00:16:08,080 --> 00:16:11,200
!هناك! ثمّة من يهرب من الغاز

241
00:16:13,330 --> 00:16:14,610
تنّين؟

242
00:16:15,310 --> 00:16:17,280
...ماذا؟ أيعقل

243
00:16:22,090 --> 00:16:25,200
!ألا يمكنك الهرب بصمت أكثر؟

244
00:16:27,220 --> 00:16:29,310
!لا لماذا لا يطير؟

245
00:16:30,640 --> 00:16:32,560
!لا أحتاج مساعدةً من التّنّين

246
00:16:32,980 --> 00:16:34,610
!كفّوا عن ذلك

247
00:16:34,900 --> 00:16:38,440
!أمسكنا به بفضل جسد نامي-سان الجذّاب

248
00:16:38,440 --> 00:16:40,450
...مجرّد التّفكير به

249
00:16:41,920 --> 00:16:44,660
!هذا ليس وقتًا مناسبًا للرّعاف أيّها المنحرف

250
00:16:45,160 --> 00:16:47,490
!الغاز السّامّ يقترب منّا أكثر

251
00:16:47,490 --> 00:16:50,410
...عضلات ذراعيّ لا تتحمّل

252
00:16:50,410 --> 00:16:54,130
!صحيح، لا عضلات لديّ

253
00:16:56,700 --> 00:16:57,500
!بروك

254
00:17:02,950 --> 00:17:04,260
!بروك

255
00:17:04,260 --> 00:17:05,950
!كان ذلك وشيكًا

256
00:17:05,950 --> 00:17:07,020
!أوسوبّ

257
00:17:07,020 --> 00:17:08,320
!نـ-نامي-سان؟

258
00:17:08,320 --> 00:17:10,040
!لنواصل الهرب

259
00:17:11,570 --> 00:17:13,690
!لماذا أنتم هنا؟

260
00:17:13,910 --> 00:17:17,480
!لدينا الكثير من الأسئلة أيضًا، لكن يمكنها الانتظار

261
00:17:18,210 --> 00:17:20,440
!لنذهب إلى المختبر الآن

262
00:17:20,690 --> 00:17:22,010
!أجل

263
00:17:23,270 --> 00:17:25,450
!مهلاً، لقد بدأ يتعب

264
00:17:26,340 --> 00:17:28,830
!سينال منّا الغاز إن لم نفعل شيئًا

265
00:17:29,020 --> 00:17:31,210
!عليكم القفز على ظهري جميعًا

266
00:17:31,960 --> 00:17:33,460
!شكرًا لك

267
00:17:37,800 --> 00:17:38,960
!هذا مؤلم

268
00:17:40,450 --> 00:17:42,050
!هذا جيّد

269
00:17:42,050 --> 00:17:44,010
!ممتاز! واصل هكذا

270
00:17:44,010 --> 00:17:45,550
!هذا ممتاز

271
00:17:45,550 --> 00:17:47,140
!نعتمد عليك أيّها اللّحية البنّيّة

272
00:17:47,140 --> 00:17:49,260
!أنتم فظيعون

273
00:18:01,660 --> 00:18:02,950
!هيّا! بسرعة

274
00:18:02,950 --> 00:18:04,720
!سنموت

275
00:18:05,570 --> 00:18:08,390
!سُحقًا! سُحقًا! سُحقًا! سُحقًا

276
00:18:08,390 --> 00:18:09,910
!افتح

277
00:18:12,970 --> 00:18:15,690
...الـ-الغاز السّامّ

278
00:18:16,780 --> 00:18:19,360
!قادم للجبل

279
00:18:29,870 --> 00:18:31,340
!سُحقًا

280
00:18:32,080 --> 00:18:35,870
...هذه هي... هذه نهايتنا

281
00:18:36,470 --> 00:18:39,230
!سيصل الغاز السّامّ إلى هنا قريبًا

282
00:18:40,010 --> 00:18:42,650
!سمو-سان والنّقيب-تشان لا يمكنهما الهرب أيضًا

283
00:18:43,380 --> 00:18:45,610
!سنموت جميعًا

284
00:19:10,850 --> 00:19:13,680
!فُتح الباب

285
00:19:14,080 --> 00:19:15,640
!لدينا مشكلة

286
00:19:15,640 --> 00:19:17,100
!الباب يُفتح

287
00:19:17,410 --> 00:19:19,400
!من شغّل الرّافعة؟

288
00:19:19,540 --> 00:19:22,380
!سُحقًا! يدخل جنود جي-5 الواحد تلو الآخر

289
00:19:22,810 --> 00:19:24,240
!ما الّذي يحدث؟

290
00:19:24,240 --> 00:19:25,600
!انظروا هناك

291
00:19:35,040 --> 00:19:36,950
!مـ-مستحيل

292
00:19:38,420 --> 00:19:41,750
!إنّها نائب الأميرال سموكر من جي-5 البحريّة

293
00:19:42,920 --> 00:19:46,320
!والشّيتشيبوكاي الملكيّ ترافالغار لو

294
00:19:47,690 --> 00:19:50,960
!و القرصان قبّعة القشّ لوفي

295
00:19:52,560 --> 00:19:56,430
!ظننتُ أنّهم محبوسون على يد السّيّد

296
00:19:57,730 --> 00:20:00,350
!هذا جيّد! الجميع في الدّاخل

297
00:20:01,090 --> 00:20:04,150
حسنًا، ماذا سأفعل بشأن قلبي؟

298
00:20:06,420 --> 00:20:08,110
!بدأت أتحمّس

299
00:20:08,260 --> 00:20:11,260
!لماذا أقوم بهذا مع هؤلاء...؟

300
00:20:13,690 --> 00:20:17,560
!سمو-يان! النّقيب-تشان! أنتما على قيد الحياة

301
00:20:17,560 --> 00:20:19,830
!لم يبق أيّ أحد في الخارج الآن

302
00:20:30,440 --> 00:20:32,700
!نجونا من الغاز السّامّ

303
00:20:36,020 --> 00:20:37,850
ما هذا؟

304
00:20:40,550 --> 00:20:43,540
!هذا مؤلم

305
00:20:44,050 --> 00:20:46,350
!وصلنا إلى المختبر

306
00:20:54,160 --> 00:20:56,330
!مهلاً، مهلاً، مهلاً! انتظروا، انتظروا

307
00:20:57,810 --> 00:21:00,120
!لا تغلقوا الباب

308
00:21:00,310 --> 00:21:02,210
!سُحقًا نحن قريبون جدًّا

309
00:21:02,390 --> 00:21:05,290
!افتحوه! أدخلونا

310
00:21:05,290 --> 00:21:10,070
!كلاّ! سيتخلّون عنّا! سيقتلنا الغاز السّامّ

311
00:21:12,280 --> 00:21:15,970
.لن نستطيع النّجاة
.نحن في طريقنا للحياة الأخرى

312
00:21:17,490 --> 00:21:18,970
!يا كينييمون

313
00:21:19,240 --> 00:21:20,640
أباستطاعتك قطع الحديد؟

314
00:21:22,200 --> 00:21:24,440
!ليس من الصّعب قطعه

315
00:21:24,650 --> 00:21:26,730
!أيّها اللّحية البنّيّة، واصل تقدّمك هكذا

316
00:21:27,000 --> 00:21:28,590
!هذا سخيف

317
00:21:28,590 --> 00:21:30,940
!سأصطدم بالجدار هكذا

318
00:21:31,090 --> 00:21:33,700
أتريدون الموت بالغاز السّامّ إذًا؟

319
00:21:33,840 --> 00:21:36,390
!بالطّبع لا

320
00:21:42,280 --> 00:21:43,770
!لا شيء يهمّ الآن

321
00:21:43,770 --> 00:21:46,230
!سأواصل التّقدّم

322
00:21:46,350 --> 00:21:49,210
لا خيار آخر لدينا الآن، صحيح؟

323
00:21:49,210 --> 00:21:51,980
!نعم، إمّا أن ننجح أو نفشل

324
00:21:51,980 --> 00:21:53,680
!فلنغتنم الفرصة

325
00:21:54,280 --> 00:21:55,900
أمستعدّ أنت؟

326
00:21:55,900 --> 00:21:57,050
!كلّ الاستعداد

327
00:22:25,920 --> 00:22:26,920
!زورو والبقيّة

328
00:22:27,340 --> 00:22:29,210
!يا له من دخول غريب

329
00:22:33,010 --> 00:22:34,420
!ماذا؟

330
00:22:40,900 --> 00:22:43,730
!لقد قطعوا الباب

331
00:22:43,730 --> 00:22:45,940
مرحبًا! الجميع هنا، أليس كذلك؟

332
00:22:46,050 --> 00:22:47,020
!لوفي

333
00:22:47,020 --> 00:22:48,110
!لوفي-سان

334
00:22:49,580 --> 00:22:50,610
!لوفي

335
00:22:56,570 --> 00:22:57,950
!اجتمعنا كلّنا مجدّدًا

336
00:22:59,490 --> 00:23:02,840
!حسنًا! فلنطلق العنان للجنون

337
00:23:10,800 --> 00:23:14,750
تمكّن طاقم قبّعة القشّ من النّجاة
.من براثن شينوكوني والتمّ شملهم

338
00:23:15,130 --> 00:23:19,890
لكنّ طريق هروبهم الوحيد المتبقّي
.هو عبر الباب إلى المبنى ر

339
00:23:20,270 --> 00:23:22,140
...وفي وجه ظروف قاسية

340
00:23:22,140 --> 00:23:24,640
!يبدؤون أخيرًا الهجوم المضادّ

341
00:23:25,230 --> 00:23:26,520
:في الحلقة القادمة من وان بيس

342
00:23:26,520 --> 00:23:29,900
"!الذّهاب للمبنى ر! الاقتحام الكبير لتحالف القراصنة"

343
00:23:30,100 --> 00:23:31,980
!ملك القراصنة، لن يكون إلاّ أنا

344
00:23:35,990 --> 00:23:40,990
!!نراكم في الحلقة القادمة