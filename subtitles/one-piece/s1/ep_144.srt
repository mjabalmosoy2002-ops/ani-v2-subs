1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:54,490 --> 00:01:57,490
.على كلّ حال، كان مكان مثيرًا للاهتمام

22
00:01:57,490 --> 00:02:00,190
!فعلاً. نلت كفايتي من مقبرة السّفن تلك

23
00:02:00,490 --> 00:02:04,200
،ليس وكأنّني أريد أن أعيش هناك
.لكن أريد أن أزورها من حين لآخر

24
00:02:04,200 --> 00:02:05,600
أكانت جميلة حقًّا؟

25
00:02:05,600 --> 00:02:06,900
ماذا؟ مطر؟

26
00:02:06,900 --> 00:02:08,270
...ليس مطرًا

27
00:02:08,270 --> 00:02:09,300
أهو برَد؟

28
00:02:11,300 --> 00:02:14,010
—لا... ثمّة شيء ما يسقط

29
00:02:25,480 --> 00:02:29,350
!سُجّلت الوجهة التّالية"
"!ماسيرا، ملك إنقاذ السّفن

30
00:02:38,700 --> 00:02:41,070
!تمسّكوا! تمسّكوا بالسّفينة

31
00:02:43,700 --> 00:02:46,440
!ماذا؟! ما هذا؟! ماذا يحدث؟

32
00:02:51,040 --> 00:02:53,210
!إنّه حلم! نعم، لا بدّ أنّه حلم

33
00:02:53,210 --> 00:02:54,910
—حلم؟! هذا جيّـ

34
00:02:58,780 --> 00:03:00,890
!مهلاً! تسقط المزيد من الأشياء! احذروا

35
00:03:03,850 --> 00:03:05,660
!أدر الدّفّة! الدّفّة

36
00:03:05,660 --> 00:03:07,360
!مستحيل أن ينجح ذلك في هذه الأمواج

37
00:03:07,360 --> 00:03:09,530
!لوفي، احم السّفينة
!لا يمكنها تحمّل المزيد من هذا

38
00:03:09,530 --> 00:03:11,660
!مفهوم! أوسوبّ؟

39
00:03:11,900 --> 00:03:15,800
.ألق كلّ ما يقلقك بعيدًا
...وأغمض عينيك بهدوء

40
00:03:16,530 --> 00:03:22,610
وعندما تفتحهما، ستجد
...أمامك صباحًا هادئًا

41
00:03:24,080 --> 00:03:25,440
!عظام

42
00:03:25,440 --> 00:03:27,480
!أيّها الغبيّ! لا ترمها ناحيتي

43
00:03:27,480 --> 00:03:29,180
!المزيد من الأشياء تسقط

44
00:03:29,180 --> 00:03:30,150
!عظام

45
00:03:30,150 --> 00:03:32,350
!أيّها الغبيّ! لا ترمها ناحيتي

46
00:03:36,590 --> 00:03:39,890
!لماذا سقطت سفينة من السّماء؟

47
00:03:39,890 --> 00:03:41,430
...كم هذا غريب

48
00:03:41,430 --> 00:03:42,890
.لا يوجد شيء في السّماء

49
00:03:42,890 --> 00:03:46,760
!كما أنّ الغراند لاين مكان مخيف

50
00:03:46,760 --> 00:03:49,770
في البداية رأينا مقبرة سفن
،داخل ضباب قوس قزح

51
00:03:49,770 --> 00:03:51,270
!ثمّ سقطت علينا سفينة من السّماء

52
00:03:52,440 --> 00:03:53,870
ما الخطب يا نامي-سان؟

53
00:03:53,870 --> 00:03:57,270
!ما الّذي سنفعله؟
!اللوغ بوس معطّلة

54
00:03:57,270 --> 00:03:58,840
.إنّها تشير إلى الأعلى

55
00:03:59,180 --> 00:04:04,220
ذلك ليس صحيحًا. لقد قامت بتسجيل
.مجال مغناطيسيّ قويّ لجزيرة ما

56
00:04:04,220 --> 00:04:04,850
!ماذا؟

57
00:04:04,850 --> 00:04:06,320
،إن كانت إبرة البوصلة تشير للأعلى

58
00:04:07,320 --> 00:04:10,290
فذلك يعني أنّ المجال المغناطيسيّ
.يعود لجزيرة السّماء

59
00:04:11,060 --> 00:04:13,060
!جزيرة السّماء؟

60
00:04:13,060 --> 00:04:14,260
ما هي؟

61
00:04:14,260 --> 00:04:16,360
!أهي جزيرة طافية؟

62
00:04:16,360 --> 00:04:19,760
هـ-هل سقطت تلك السّفينة
والعظام من هناك؟

63
00:04:19,760 --> 00:04:23,100
لكن لا يمكنني رؤية أيّ شيء
.كجزيرة في السّماء

64
00:04:23,300 --> 00:04:24,670
.الأمر ليس كذلك

65
00:04:25,840 --> 00:04:28,770
.بشكل أدقّ، ثمّة بحر يطفو في السّماء

66
00:04:28,770 --> 00:04:29,540
!بحر؟

67
00:04:32,280 --> 00:04:33,980
.أشعر بالارتباك أكثر فأكثر

68
00:04:33,980 --> 00:04:37,920
أجل! هنالك بحر يطفو
!في السّماء وعليه جزيرة؟

69
00:04:37,920 --> 00:04:39,450
!حسنًا! لنتوجّه إلى هناك في الحال

70
00:04:39,450 --> 00:04:43,120
!هيّا يا رفاق! أديروا الدّفّة للأعلى

71
00:04:43,120 --> 00:04:45,420
!أديروا الدّفّة للأعلى

72
00:04:47,290 --> 00:04:50,390
.في كلّ الأحوال، لا يمكن إدارة الدّفّة للأعلى

73
00:04:51,000 --> 00:04:56,670
بصراحة، لم أر جزيرة السّماء
.من قبل ولا أعرف الكثير عنها

74
00:04:56,670 --> 00:05:00,940
صحيح! مستحيل لجزيرة أو بحر
!أن يطفوا في الهواء

75
00:05:00,940 --> 00:05:03,110
.لا بدّ أنّ اللوغ بوس معطّلة إذًا

76
00:05:03,110 --> 00:05:04,640
.لا أيّتها الملاّحة

77
00:05:05,180 --> 00:05:12,220
همّنا الوحيد الآن يجب ألاّ يكون
.البوصلة، بل كيفية الذّهاب للسّماء

78
00:05:13,550 --> 00:05:17,890
لا يهمّ ما هي الأوضاع الغريبة
،الّتي ستمرّ بها هذه السّفينة

79
00:05:17,890 --> 00:05:20,790
،أو مدى فزعنا

80
00:05:20,790 --> 00:05:24,760
.علينا ألاّ نشكّك بالبوصلة المسجِّلة
.إنّها قاعدة لا حياد عنها

81
00:05:25,160 --> 00:05:29,600
ما علينا أن نشكّك به هو ما
.نعتبره منطقًا في عقولنا

82
00:05:31,000 --> 00:05:34,540
.ثمّة جزيرة بكلّ تأكيد حيث تشير البوصلة

83
00:05:43,680 --> 00:05:46,980
ما الّذي تفعله تلك المرأة
!بفتحها للتّابوت؟

84
00:05:50,890 --> 00:05:52,390
أيمكنك معرفة شيء من ذلك؟

85
00:05:52,390 --> 00:05:53,190
.لا أدري

86
00:05:53,190 --> 00:05:55,890
!لديكِ اهتمامات غريبة

87
00:05:55,890 --> 00:05:59,400
،امرأة جميلة وجثّة ميتة
.هذا مزيج مثير للاهتمام

88
00:06:00,400 --> 00:06:02,370
ماذا؟ أين لوفي؟

89
00:06:02,370 --> 00:06:03,300
!اقفز يا لوفي

90
00:06:03,300 --> 00:06:03,830
!حسنًا

91
00:06:04,340 --> 00:06:06,900
ما الّذي يفعلانه الآن؟

92
00:06:06,900 --> 00:06:08,240
!قالا أنّهما ذاهبان للاستكشاف

93
00:06:09,340 --> 00:06:11,710
!انتهت عملية التّرميم

94
00:06:12,340 --> 00:06:15,180
.هذه الثّقوب هنا من صنع الإنسان

95
00:06:15,180 --> 00:06:18,680
فهمت... إذًا فهذا الرّجل مات
بسبب ما اخترق رأسه؟

96
00:06:19,020 --> 00:06:21,920
.كلاّ، إنّها علامات لعلاج طبّيّ

97
00:06:21,920 --> 00:06:24,390
إنّه حفر الأُقنة، صحيح أيّها الطّبيب؟

98
00:06:24,690 --> 00:06:29,730
نعم، كانوا في الماضي يثقبون
.الجمجمة لإزالة أورام الدّماغ

99
00:06:29,730 --> 00:06:32,360
.لكنّها تقنية طبّيّة من زمن بعيد جدًّا

100
00:06:32,830 --> 00:06:37,230
.صحيح. لقد مات منذ 200 سنة على الأقلّ

101
00:06:39,740 --> 00:06:42,540
.كان في أوائل الثّلاثين

102
00:06:44,840 --> 00:06:48,210
.وقع ضحيّة المرض بينما يجوب البحار ومات

103
00:06:52,580 --> 00:06:56,590
إنّ سبب بقاء أسنانه في حالة
...جيّدة مقارنة بعظامه الأخرى

104
00:06:58,960 --> 00:07:00,930
.يعود لفركه للقطران عليها

105
00:07:00,930 --> 00:07:04,900
وهذا تقليد يميّز بعض المناطق
.من الأزرق الجنوبيّ

106
00:07:04,900 --> 00:07:09,770
لذلك بالرّجوع للتّاريخ، فإنّ تلك السّفينة
.كانت لفريق استكشاف من الماضي

107
00:07:12,300 --> 00:07:17,310
ها هي ذي. القدّيس بريس سفينة
.من مملكة بريس في الأزرق الجنوبيّ

108
00:07:17,510 --> 00:07:19,380
.شدّت رحالها منذ 208 أعوام مضت

109
00:07:19,840 --> 00:07:21,580
.إنّها نفس السّفينة الّتي وقعت علينا

110
00:07:21,580 --> 00:07:24,250
.بالتّفكير في الأمر، كان لديها رمز هكذا

111
00:07:24,250 --> 00:07:28,350
على الأرجح أنّ هذه السّفينة هامت
.في السّماء لمائتي سنة على الأقل

112
00:07:28,750 --> 00:07:31,590
بإمكانك اكتشاف كلّ هذا
بمعانية العظام فحسب؟

113
00:07:32,420 --> 00:07:35,930
،قد لا يستطيع الأموات التّكلّم
.لكنّهم يحملون معلومات كثيرة

114
00:07:35,930 --> 00:07:37,630
،إن كانت السّفينة لفريق استكشاف

115
00:07:37,630 --> 00:07:40,970
فعلى الأرجح أنّ عليها
.سجلاّت وأدلّة كثيرة

116
00:07:40,970 --> 00:07:43,570
...نعم... لكنّ السّفينة غرقت

117
00:07:43,870 --> 00:07:46,970
!ما الّذي تفعلانه؟

118
00:07:44,370 --> 00:07:46,340
!لوفي! تماسك

119
00:07:46,800 --> 00:07:48,270
!ساعدني

120
00:07:49,940 --> 00:07:51,640
!يا رفاق

121
00:07:52,210 --> 00:07:53,910
!لقد نجحت

122
00:07:55,010 --> 00:07:57,620
!وجدتُ شيئًا مدهشًا
!انظروا لهذه

123
00:08:00,320 --> 00:08:02,850
!خريطة جزيرة السّماء؟

124
00:08:03,190 --> 00:08:04,420
...سكايبيا

125
00:08:04,420 --> 00:08:05,590
أرأيتم؟ أرأيتم؟

126
00:08:05,590 --> 00:08:07,830
هل هذا يعني أنّ هنالك جزيرة
!في السّماء بالفعل؟

127
00:08:08,230 --> 00:08:11,300
!مرحى

128
00:08:11,830 --> 00:08:14,500
!أجل! جزيرة السّماء موجودة فعلاً

129
00:08:14,500 --> 00:08:17,300
!إنّها جزيرة أحلام
!يمكننا الذّهاب لجزيرة أحلام

130
00:08:17,300 --> 00:08:19,270
!جزيرة أحلام

131
00:08:19,840 --> 00:08:23,980
!لا تتحمّسوا كثيرًا
.هذا يعني أنّ ذلك قد يكون ممكنًا

132
00:08:23,980 --> 00:08:26,480
.ثمّة العديد من الخرائط المزيّفة

133
00:08:28,710 --> 00:08:32,480
!أ... أنا آسفة! إنّها موجودة
...أنا واثقة أنّها موجودة، لكن

134
00:08:33,220 --> 00:08:35,290
،اسمع يا لوفي! أنا أقول لك

135
00:08:34,820 --> 00:08:39,560
مهلاً يا نامي، عاملي
السّفينة بلطف، موافقة؟

136
00:08:35,290 --> 00:08:37,290
!نحن لا نعرف كيف نذهب إلى هناك

137
00:08:37,290 --> 00:08:39,390
!أنت الملاّحة! تدبّري الأمر

138
00:08:39,390 --> 00:08:42,560
هنالك أمور لا يمكن أن نتدبّر
!الأمر فيها ببساطة

139
00:08:39,990 --> 00:08:44,400
.نامي-سان ظريفة حتّى وهي غاضبة أيضًا

140
00:08:42,560 --> 00:08:44,400
!لا أهتمّ! سنذهب للسّماء

141
00:08:45,860 --> 00:08:47,400
.لن نصل لأيّ نتيجة هكذا

142
00:08:47,400 --> 00:08:50,030
على كلّ حال، لا يمكننا التّقدّم
!للأمام بالسّفينة هكذا

143
00:08:50,030 --> 00:08:53,040
ما نحتاج إليه الآن هي المعلومات
.كما قالت روبين

144
00:08:53,670 --> 00:08:56,540
،إن ذهبت سفينة ضخمة كتلك للسّماء

145
00:08:56,540 --> 00:08:59,310
فثمّة بالتّأكيد طريقة لتذهب بها
.هذه السّفينة إلى هناك أيضًا

146
00:08:59,880 --> 00:09:04,280
لنجمع بطريقة ما كلّ سجلّ
!موجود على تلك السّفينة

147
00:09:04,720 --> 00:09:07,620
.لكنّ السّفينة قد غرقت بالكامل

148
00:09:08,150 --> 00:09:10,490
!إن غرقت، فسنقوم بعمليّة إنقاذ

149
00:09:10,820 --> 00:09:12,290
!أجل

150
00:09:12,290 --> 00:09:13,560
!وكأنّ بمقدورنا ذلك

151
00:09:14,330 --> 00:09:15,860
ما الّذي تقصده بعملية إنقاذ؟

152
00:09:18,430 --> 00:09:21,470
لكنّ ذلك لن ينفع بما
.أنّها كانت سفينة ضخمة

153
00:09:28,540 --> 00:09:32,710
عجبًا... إنّك تجعليننا نقوم
.بأمور متهوّرة بالفعل

154
00:09:33,480 --> 00:09:37,950
نامي-سان! سأحرص على إيجاد
!دليل للذّهاب للسّماء

155
00:09:38,220 --> 00:09:39,420
!أعتمد عليكم

156
00:09:39,420 --> 00:09:43,450
.لا تقلقوا، لا توجد عيوب بتصاميمي

157
00:09:48,190 --> 00:09:51,700
!حسنًا إذًا... أتمنّى لكم حظًّا سعيدًا

158
00:09:57,600 --> 00:09:59,040
...مهلاً، مهلاً، مهلاً

159
00:09:59,540 --> 00:10:02,010
.معكم تشوبّر. أجيبوا جميعًا رجاءً

160
00:10:02,440 --> 00:10:05,440
معكم لوفي. ثمّة الكثير
.من الوحوش هنا، حوّل

161
00:10:05,440 --> 00:10:07,780
هل هذا عشّ لأفاعي البحر؟

162
00:10:07,780 --> 00:10:10,180
!معكم سانجي. مهلاً! إنّها تنظر إلينا

163
00:10:10,180 --> 00:10:11,150
.جيّد

164
00:10:11,150 --> 00:10:11,980
!ما الجيّد؟

165
00:10:12,620 --> 00:10:14,950
!سينجون. لا تقلق

166
00:10:15,290 --> 00:10:17,790
تشوبّر، أمسك بالمكابح جيّدًا، مفهوم؟

167
00:10:17,790 --> 00:10:18,490
!نعم

168
00:10:18,490 --> 00:10:20,830
.أنا سعيد لأنّني لم أذهب

169
00:10:23,960 --> 00:10:50,820
!إنقاذ، إنقاذ

170
00:10:35,010 --> 00:10:36,240
ما هذا؟

171
00:10:48,790 --> 00:10:52,090
!يا رفاق، توقّفوا

172
00:10:51,220 --> 00:10:53,860
...إنقاذ

173
00:10:54,690 --> 00:10:56,490
!نعم، نعم يا سيّدي

174
00:10:56,490 --> 00:10:59,360
هل هذه هي المنطقة
!حيث غرقت السّفينة؟

175
00:10:59,360 --> 00:11:01,830
!نعم، نعم يا سيّدي الزّعيم

176
00:11:02,770 --> 00:11:06,800
!بقولهم زعيم... يقصدونني أنا

177
00:11:07,310 --> 00:11:09,170
!استعدّوا لإنقاذ السّفينة

178
00:11:09,170 --> 00:11:12,180
،السّفينة الغارقة ملك لي
ملك عمليّات الإنقاذ

179
00:11:12,180 --> 00:11:15,010
!وزعيم قراصنة ماسيرا

180
00:11:19,350 --> 00:11:22,750
...يا إلهي... غرباء أطوار في وقت كهذا

181
00:11:23,020 --> 00:11:25,520
!أنتم هناك! ما الّذي تفعلونه هنا؟

182
00:11:25,520 --> 00:11:27,460
!هذه منطقتي أنا

183
00:11:27,690 --> 00:11:28,930
منطقتك؟

184
00:11:29,160 --> 00:11:34,130
صحيح. إنّ كلّ سفينة تغرق
.في هذه المنطقة ملك لي أنا

185
00:11:34,130 --> 00:11:36,900
!لم تلمسوا أيّ شيء يخصّني، صحيح؟

186
00:11:37,270 --> 00:11:40,570
.يبدو أنّه سينقذ السّفينة

187
00:11:40,570 --> 00:11:42,910
.نعم، ذلك ما يبدو

188
00:11:42,910 --> 00:11:45,480
ماذا إذًا؟ أليس هذا لمصلحتنا؟

189
00:11:45,480 --> 00:11:50,720
!كفاكم ثرثرة! أجيبوا على سؤالي

190
00:11:51,320 --> 00:11:53,920
!المعذرة! هل يمكنني طرح سؤال عليك؟

191
00:11:53,920 --> 00:11:55,750
!أنت من ستسألني؟

192
00:11:55,750 --> 00:11:58,090
!لا بأس! سليني أيّ شيء

193
00:11:58,090 --> 00:12:00,790
.يبدو أنّكم ستنقذون السّفينة
أكلامي قريب من الصّحّة؟

194
00:12:00,790 --> 00:12:01,930
قرد من...؟

195
00:12:04,830 --> 00:12:07,930
مهلاً... هل تجدينني أشبه القرد؟

196
00:12:08,400 --> 00:12:09,300
تشبه القرد؟

197
00:12:09,300 --> 00:12:11,900
ذلك يعني أنّني وسيم. ألا تظنّين ذلك؟

198
00:12:12,740 --> 00:12:13,570
!نعم

199
00:12:13,570 --> 00:12:16,010
!هيّا، توقّفي

200
00:12:16,410 --> 00:12:18,110
اختلطت عليه كلماتك فحسب، صحيح؟

201
00:12:19,080 --> 00:12:21,780
!إذًا هل ستقومون بإنقاذها؟

202
00:12:21,780 --> 00:12:25,580
،بالطّبع! إن كانت هنالك سفينة غارقة أمامي

203
00:12:25,580 --> 00:12:27,920
!فسأنقذها! أنا من ذلك النّوع من الرّجال

204
00:12:27,920 --> 00:12:31,260
وإن كانت فوق الماء، فسأغرقها
!ثمّ سأنقذها! هكذا أنا

205
00:12:31,260 --> 00:12:34,190
!لا توجد سفينة لا يمكننا إنقاذها

206
00:12:35,090 --> 00:12:38,300
حسنًا... هل يمكنك السّماح لنا بالمشاهدة؟

207
00:12:39,360 --> 00:12:42,870
هكذا إذًا! هل إنقاذ السّفن جديد عليكم؟

208
00:12:43,670 --> 00:12:45,770
!لا بأس! يمكنكم المشاهدة

209
00:12:46,270 --> 00:12:49,740
حسنًا! لنر كيف ستسير الأمور
.من هنا يا رفاق

210
00:12:50,470 --> 00:12:53,280
...كـ... كونوا حذرين

211
00:12:54,050 --> 00:12:55,710
!يا زعيم! لدينا مشكلة

212
00:12:55,710 --> 00:12:56,450
!ما الخطب؟

213
00:12:56,450 --> 00:12:59,420
الأعضاء الّذين ذهبوا لتجهيز
...الرّافعة تحت البحر

214
00:12:59,580 --> 00:13:01,590
هل هُوجموا من طرف ملوك البحر؟

215
00:13:01,590 --> 00:13:04,760
.لا... يبدو أنّهم هُزموا على يد شخص ما

216
00:13:04,760 --> 00:13:08,090
ماذا؟! هل تقول أنّ هنالك
شخصًا ما تحت البحر؟

217
00:13:08,090 --> 00:13:09,630
!أولئك الأغبياء

218
00:13:09,630 --> 00:13:10,830
.هذا سيّئ

219
00:13:11,100 --> 00:13:14,070
!إذًا... يا هؤلاء

220
00:13:14,070 --> 00:13:15,230
...إنّنا

221
00:13:15,230 --> 00:13:18,300
!ثمّة شخص ما في الأسفل! كونوا حذرين

222
00:13:18,300 --> 00:13:19,540
!حـ... حسنًا

223
00:13:19,540 --> 00:13:21,210
.من الجيّد أنّه غبيّ

224
00:13:21,470 --> 00:13:25,110
!يا رجال! لنسرع ونجهّز الرّافعة

225
00:13:25,110 --> 00:13:27,650
!لنبدأ الإنقاذ

226
00:13:27,650 --> 00:13:29,180
!نعم، نعم يا سيّدي

227
00:13:59,880 --> 00:14:03,550
إنّه يلوّح لنا... لا تدعه يلاحظ
.معدّات التّنفّس يا أوسوبّ

228
00:14:03,550 --> 00:14:05,120
!أعلم

229
00:14:05,120 --> 00:14:08,650
!يا رفاق، تخيّلوا أنّهم يقطين

230
00:14:08,650 --> 00:14:14,860
لا تتوتّروا... فقط لأنّ
هنالك من يشاهدنا، مفهوم؟

231
00:14:14,860 --> 00:14:16,590
!نعم، نعم يا سيّدي

232
00:14:16,590 --> 00:14:18,700
!أنزلوا الرّافعة

233
00:14:18,700 --> 00:14:21,130
!نعم، نعم يا سيّدي

234
00:14:23,030 --> 00:14:24,670
!انتبهوا من العدوّ الغامض

235
00:14:24,670 --> 00:14:25,700
!نعم، نعم يا سيّدي

236
00:14:27,870 --> 00:14:30,910
أتساءل إن كانوا يقومون بهذا
.بدافع الفخر أو ما شابه

237
00:14:30,910 --> 00:14:33,810
...إنّهم يحاولون تقديم عرض لنا كما أظنّ

238
00:14:34,210 --> 00:14:36,310
!تحرّكوا

239
00:14:36,310 --> 00:14:37,780
!نعم، نعم يا سيّدي

240
00:16:07,370 --> 00:16:08,040
...أنت

241
00:16:09,140 --> 00:16:09,970
!انظر

242
00:16:41,610 --> 00:16:43,870
!الرّافعة جاهزة، تمّ التّأكيد

243
00:16:45,580 --> 00:16:46,480
!ما الّذي يحدث؟

244
00:16:59,890 --> 00:17:04,000
!ما ذلك القرد؟! ما وظيفة ذلك القرد؟

245
00:17:04,000 --> 00:17:05,260
تقصد هذا؟

246
00:17:06,530 --> 00:17:08,730
.لديك نظر حادّ

247
00:17:08,730 --> 00:17:11,240
.أنت محقّ. إنّها ليست مقدّمة سفينة عاديّة

248
00:17:13,000 --> 00:17:16,670
!أطلقوا صائد السّفن

249
00:17:17,010 --> 00:17:19,210
!نعم، نعم يا سيّدي

250
00:17:34,130 --> 00:17:35,630
!كم هذا مذهل

251
00:17:35,630 --> 00:17:36,930
!إنّ مذهل فعلاً

252
00:17:36,930 --> 00:17:37,660
ما المذهل؟

253
00:17:40,130 --> 00:17:41,630
!بقيت 40 مترًا على الهدف

254
00:17:42,600 --> 00:17:44,140
‫30 مترًا!

255
00:17:44,870 --> 00:17:47,610
!...10 ...20

256
00:17:50,470 --> 00:17:54,150
!تثبيت صائد السّفن... اكتمل

257
00:17:54,150 --> 00:17:57,520
!حسنًا! سأبدأ نفخ الهواء

258
00:17:57,520 --> 00:18:00,550
!نعم، نعم يا سيّدي

259
00:18:00,750 --> 00:18:02,520
...ماذا؟ مستحيل

260
00:18:11,730 --> 00:18:13,560
!هذا جنونيّ

261
00:18:26,740 --> 00:18:27,880
!هواء؟

262
00:18:35,490 --> 00:18:37,320
!بدأت السّفينة بالصّعود

263
00:18:43,030 --> 00:18:45,460
!نعم، نعم يا سيّدي

264
00:18:46,030 --> 00:18:49,170
!انفخوا المزيد من الهواء! في الحال

265
00:18:49,170 --> 00:18:51,470
!نعم، نعم يا سيّدي

266
00:19:00,010 --> 00:19:03,050
!...يا زعيم! الفريق الّذي تحت الماء

267
00:19:03,050 --> 00:19:07,650
!ما الخطب؟! ماذا حدث يا رجال؟

268
00:19:07,650 --> 00:19:09,750
!ثمّة شخص ما في السّفينة

269
00:19:17,130 --> 00:19:22,300
!كيف يجرؤون على أذيّة رجالي؟
!من يكونون؟

270
00:19:28,440 --> 00:19:31,380
...حسنًا، لن نأخذ أيّة صور أو ما شابه

271
00:19:31,380 --> 00:19:32,610
!ماذا؟

272
00:19:32,610 --> 00:19:34,550
...قام بوقفة من أجلنا لنلتقط صورًا

273
00:19:34,550 --> 00:19:36,610
!يا زعيم! النّجدة

274
00:19:38,580 --> 00:19:41,990
أنا قادم! واصلوا العمل
!على عمليّة الإنقاذ

275
00:19:41,990 --> 00:19:44,160
!نعم، نعم يا سيّدي

276
00:20:04,010 --> 00:20:05,210
!لكمة القرد

277
00:20:08,550 --> 00:20:10,210
...إنّها تصعد

278
00:20:14,690 --> 00:20:17,390
.أرأيتما؟ لا ضرر علينا بلا براميل

279
00:20:17,660 --> 00:20:20,560
.من المذهل أنّهم نفخوا كلّ هذا الهواء

280
00:20:21,130 --> 00:20:24,960
لكن من يحاول إنقاذ هذه السّفينة؟

281
00:20:24,960 --> 00:20:28,430
لا بدّ أنّ شيئًا ما حدث
.لنامي-سان وروبين-تشان

282
00:20:28,430 --> 00:20:30,870
!أنا أنادي عليهما ولا تجيبان

283
00:20:32,040 --> 00:20:36,610
!من تكونون ولماذا اقتحمتم منطقتي؟

284
00:20:39,640 --> 00:20:41,550
.إ... إنّه قرد

285
00:20:42,050 --> 00:20:45,020
ماذا؟ هل أشبه القرد فعلاً؟

286
00:20:45,420 --> 00:20:47,020
.نعم، أنت تشبه قردًا بالفعل

287
00:20:47,020 --> 00:20:49,020
ما هذه المحادثة؟

288
00:20:49,020 --> 00:20:49,990
ماذا تقصد؟

289
00:20:50,820 --> 00:20:52,020
بالمناسبة، من تكون؟

290
00:20:52,020 --> 00:20:54,690
!فهمت... ما بيدي حيلة

291
00:20:54,690 --> 00:20:58,230
هل تعتقد ذلك فعلاً؟
!لديك نظر حادّ

292
00:20:58,230 --> 00:21:00,000
!سألناك من تكون؟

293
00:21:04,440 --> 00:21:06,500
...مهلاً، هنالك تحت السّفينة

294
00:21:06,970 --> 00:21:11,880
.نـ-نعم... ثمّة شيء هناك في الأسفل

295
00:21:15,350 --> 00:21:19,320
!فهمت! أنتم من الأزرق الشّرقيّ إذًا؟

296
00:21:19,650 --> 00:21:23,790
!نعم. لكنّك تشبه القرود بالفعل

297
00:21:24,160 --> 00:21:26,990
!كفّ عن مجاملتي

298
00:21:47,280 --> 00:21:51,180
!ما هذا؟! ما هذا الشّيء؟

299
00:21:55,720 --> 00:22:03,790
آه، خلف السّماء الّتي لا نهاية لها

300
00:22:03,790 --> 00:22:14,400
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

301
00:22:22,280 --> 00:22:29,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

302
00:22:29,720 --> 00:22:38,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

303
00:22:38,130 --> 00:22:46,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

304
00:22:46,340 --> 00:22:55,180
دفعوا بي للأمام، أليس كذلك؟

305
00:22:55,180 --> 00:23:03,490
آه، إنّ النّجوم تهوي من السّماء

306
00:23:03,490 --> 00:23:06,620
...وهذه اللّحظة الفريدة

307
00:23:12,600 --> 00:23:13,660
!إنّها سلحفاة

308
00:23:13,660 --> 00:23:15,730
!نحن في البحر! بالطّبع سنصادف سلاحف

309
00:23:15,730 --> 00:23:17,400
!لوفي! زورو! سانجي

310
00:23:17,400 --> 00:23:19,070
!اخرس وابق صامتًا

311
00:23:19,070 --> 00:23:20,800
!كيف لك أن تكوني هادئة هكذا؟

312
00:23:20,800 --> 00:23:23,870
وقعت علينا سفينة غاليون
!ثمّ ظهر قرد غريب

313
00:23:23,870 --> 00:23:25,840
!ماذا؟! حلّ الظّلام فجأة

314
00:23:25,840 --> 00:23:27,380
!ماذا بعد هذا؟

315
00:23:27,640 --> 00:23:29,080
:في الحلقة القادمة من ون بيس

316
00:23:29,080 --> 00:23:32,350
ظهور وحوش! لا تعبثوا"
"!مع قراصنة اللّحية البيضاء

317
00:23:32,350 --> 00:23:34,650
!ملك القراصنة، لن يكون إلاّ أنا