1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:08,490 --> 00:02:11,490
.على كلّ حال، كان مكان مثيرًا للاهتمام

22
00:02:11,490 --> 00:02:14,190
!فعلاً. نلت كفايتي من مقبرة السّفن تلك

23
00:02:14,490 --> 00:02:18,200
،ليس وكأنّني أريد أن أعيش هناك
.لكن أريد أن أزورها من حين لآخر

24
00:02:18,200 --> 00:02:19,600
أكانت جميلة حقًّا؟

25
00:02:19,600 --> 00:02:20,900
ماذا؟ مطر؟

26
00:02:20,900 --> 00:02:22,270
...ليس مطرًا

27
00:02:22,270 --> 00:02:23,300
أهو برَد؟

28
00:02:25,300 --> 00:02:28,010
—لا... ثمّة شيء ما يسقط

29
00:02:39,480 --> 00:02:43,350
!سُجّلت الوجهة التّالية"
"!ماسيرا، ملك إنقاذ السّفن

30
00:02:52,700 --> 00:02:55,070
!تمسّكوا! تمسّكوا بالسّفينة

31
00:02:57,700 --> 00:03:00,440
!ماذا؟! ما هذا؟! ماذا يحدث؟

32
00:03:05,040 --> 00:03:07,210
!إنّه حلم! نعم، لا بدّ أنّه حلم

33
00:03:07,210 --> 00:03:08,910
—حلم؟! هذا جيّـ

34
00:03:12,780 --> 00:03:14,890
!مهلاً! تسقط المزيد من الأشياء! احذروا

35
00:03:17,850 --> 00:03:19,660
!أدر الدّفّة! الدّفّة

36
00:03:19,660 --> 00:03:21,360
!مستحيل أن ينجح ذلك في هذه الأمواج

37
00:03:21,360 --> 00:03:23,530
!لوفي، احم السّفينة
!لا يمكنها تحمّل المزيد من هذا

38
00:03:23,530 --> 00:03:25,660
!مفهوم! أوسوبّ؟

39
00:03:25,900 --> 00:03:29,800
.ألق كلّ ما يقلقك بعيدًا
...وأغمض عينيك بهدوء

40
00:03:30,530 --> 00:03:36,610
وعندما تفتحهما، ستجد
...أمامك صباحًا هادئًا

41
00:03:38,080 --> 00:03:39,440
!عظام

42
00:03:39,440 --> 00:03:41,480
!أيّها الغبيّ! لا ترمها ناحيتي

43
00:03:41,480 --> 00:03:43,180
!المزيد من الأشياء تسقط

44
00:03:43,180 --> 00:03:44,150
!عظام

45
00:03:44,150 --> 00:03:46,350
!أيّها الغبيّ! لا ترمها ناحيتي

46
00:03:50,590 --> 00:03:53,890
!لماذا سقطت سفينة من السّماء؟

47
00:03:53,890 --> 00:03:55,430
...كم هذا غريب

48
00:03:55,430 --> 00:03:56,890
.لا يوجد شيء في السّماء

49
00:03:56,890 --> 00:04:00,760
!كما أنّ الغراند لاين مكان مخيف

50
00:04:00,760 --> 00:04:03,770
في البداية رأينا مقبرة سفن
،داخل ضباب قوس قزح

51
00:04:03,770 --> 00:04:05,270
!ثمّ سقطت علينا سفينة من السّماء

52
00:04:06,440 --> 00:04:07,870
ما الخطب يا نامي-سان؟

53
00:04:07,870 --> 00:04:11,270
!ما الّذي سنفعله؟
!اللوغ بوس معطّلة

54
00:04:11,270 --> 00:04:12,840
.إنّها تشير إلى الأعلى

55
00:04:13,180 --> 00:04:18,220
ذلك ليس صحيحًا. لقد قامت بتسجيل
.مجال مغناطيسيّ قويّ لجزيرة ما

56
00:04:18,220 --> 00:04:18,850
!ماذا؟

57
00:04:18,850 --> 00:04:20,320
،إن كانت إبرة البوصلة تشير للأعلى

58
00:04:21,320 --> 00:04:24,290
فذلك يعني أنّ المجال المغناطيسيّ
.يعود لجزيرة السّماء

59
00:04:25,060 --> 00:04:27,060
!جزيرة السّماء؟

60
00:04:27,060 --> 00:04:28,260
ما هي؟

61
00:04:28,260 --> 00:04:30,360
!أهي جزيرة طافية؟

62
00:04:30,360 --> 00:04:33,760
هـ-هل سقطت تلك السّفينة
والعظام من هناك؟

63
00:04:33,760 --> 00:04:37,100
لكن لا يمكنني رؤية أيّ شيء
.كجزيرة في السّماء

64
00:04:37,300 --> 00:04:38,670
.الأمر ليس كذلك

65
00:04:39,840 --> 00:04:42,770
.بشكل أدقّ، ثمّة بحر يطفو في السّماء

66
00:04:42,770 --> 00:04:43,540
!بحر؟

67
00:04:46,280 --> 00:04:47,980
.أشعر بالارتباك أكثر فأكثر

68
00:04:47,980 --> 00:04:51,920
أجل! هنالك بحر يطفو
!في السّماء وعليه جزيرة؟

69
00:04:51,920 --> 00:04:53,450
!حسنًا! لنتوجّه إلى هناك في الحال

70
00:04:53,450 --> 00:04:57,120
!هيّا يا رفاق! أديروا الدّفّة للأعلى

71
00:04:57,120 --> 00:04:59,420
!أديروا الدّفّة للأعلى

72
00:05:01,290 --> 00:05:04,390
.في كلّ الأحوال، لا يمكن إدارة الدّفّة للأعلى

73
00:05:05,000 --> 00:05:10,670
بصراحة، لم أر جزيرة السّماء
.من قبل ولا أعرف الكثير عنها

74
00:05:10,670 --> 00:05:14,940
صحيح! مستحيل لجزيرة أو بحر
!أن يطفوا في الهواء

75
00:05:14,940 --> 00:05:17,110
.لا بدّ أنّ اللوغ بوس معطّلة إذًا

76
00:05:17,110 --> 00:05:18,640
.لا أيّتها الملاّحة

77
00:05:19,180 --> 00:05:26,220
همّنا الوحيد الآن يجب ألاّ يكون
.البوصلة، بل كيفية الذّهاب للسّماء

78
00:05:27,550 --> 00:05:31,890
لا يهمّ ما هي الأوضاع الغريبة
،الّتي ستمرّ بها هذه السّفينة

79
00:05:31,890 --> 00:05:34,790
،أو مدى فزعنا

80
00:05:34,790 --> 00:05:38,760
.علينا ألاّ نشكّك بالبوصلة المسجِّلة
.إنّها قاعدة لا حياد عنها

81
00:05:39,160 --> 00:05:43,600
ما علينا أن نشكّك به هو ما
.نعتبره منطقًا في عقولنا

82
00:05:45,000 --> 00:05:48,540
.ثمّة جزيرة بكلّ تأكيد حيث تشير البوصلة

83
00:05:57,680 --> 00:06:00,980
ما الّذي تفعله تلك المرأة
!بفتحها للتّابوت؟

84
00:06:04,890 --> 00:06:06,390
أيمكنك معرفة شيء من ذلك؟

85
00:06:06,390 --> 00:06:07,190
.لا أدري

86
00:06:07,190 --> 00:06:09,890
!لديكِ اهتمامات غريبة

87
00:06:09,890 --> 00:06:13,400
،امرأة جميلة وجثّة ميتة
.هذا مزيج مثير للاهتمام

88
00:06:14,400 --> 00:06:16,370
ماذا؟ أين لوفي؟

89
00:06:16,370 --> 00:06:17,300
!اقفز يا لوفي

90
00:06:17,300 --> 00:06:17,830
!حسنًا

91
00:06:18,340 --> 00:06:20,900
ما الّذي يفعلانه الآن؟

92
00:06:20,900 --> 00:06:22,240
!قالا أنّهما ذاهبان للاستكشاف

93
00:06:23,340 --> 00:06:25,710
!انتهت عملية التّرميم

94
00:06:26,340 --> 00:06:29,180
.هذه الثّقوب هنا من صنع الإنسان

95
00:06:29,180 --> 00:06:32,680
فهمت... إذًا فهذا الرّجل مات
بسبب ما اخترق رأسه؟

96
00:06:33,020 --> 00:06:35,920
.كلاّ، إنّها علامات لعلاج طبّيّ

97
00:06:35,920 --> 00:06:38,390
إنّه حفر الأُقنة، صحيح أيّها الطّبيب؟

98
00:06:38,690 --> 00:06:43,730
نعم، كانوا في الماضي يثقبون
.الجمجمة لإزالة أورام الدّماغ

99
00:06:43,730 --> 00:06:46,360
.لكنّها تقنية طبّيّة من زمن بعيد جدًّا

100
00:06:46,830 --> 00:06:51,230
.صحيح. لقد مات منذ 200 سنة على الأقلّ

101
00:06:53,740 --> 00:06:56,540
.كان في أوائل الثّلاثين

102
00:06:58,840 --> 00:07:02,210
.وقع ضحيّة المرض بينما يجوب البحار ومات

103
00:07:06,580 --> 00:07:10,590
إنّ سبب بقاء أسنانه في حالة
...جيّدة مقارنة بعظامه الأخرى

104
00:07:12,960 --> 00:07:14,930
.يعود لفركه للقطران عليها

105
00:07:14,930 --> 00:07:18,900
وهذا تقليد يميّز بعض المناطق
.من الأزرق الجنوبيّ

106
00:07:18,900 --> 00:07:23,770
لذلك بالرّجوع للتّاريخ، فإنّ تلك السّفينة
.كانت لفريق استكشاف من الماضي

107
00:07:26,300 --> 00:07:31,310
ها هي ذي. القدّيس بريس سفينة
.من مملكة بريس في الأزرق الجنوبيّ

108
00:07:31,510 --> 00:07:33,380
.شدّت رحالها منذ 208 أعوام مضت

109
00:07:33,840 --> 00:07:35,580
.إنّها نفس السّفينة الّتي وقعت علينا

110
00:07:35,580 --> 00:07:38,250
.بالتّفكير في الأمر، كان لديها رمز هكذا

111
00:07:38,250 --> 00:07:42,350
على الأرجح أنّ هذه السّفينة هامت
.في السّماء لمائتي سنة على الأقل

112
00:07:42,750 --> 00:07:45,590
بإمكانك اكتشاف كلّ هذا
بمعانية العظام فحسب؟

113
00:07:46,420 --> 00:07:49,930
،قد لا يستطيع الأموات التّكلّم
.لكنّهم يحملون معلومات كثيرة

114
00:07:49,930 --> 00:07:51,630
،إن كانت السّفينة لفريق استكشاف

115
00:07:51,630 --> 00:07:54,970
فعلى الأرجح أنّ عليها
.سجلاّت وأدلّة كثيرة

116
00:07:54,970 --> 00:07:57,570
...نعم... لكنّ السّفينة غرقت

117
00:07:57,870 --> 00:08:00,970
!ما الّذي تفعلانه؟

118
00:07:58,370 --> 00:08:00,340
!لوفي! تماسك

119
00:08:00,800 --> 00:08:02,270
!ساعدني

120
00:08:03,940 --> 00:08:05,640
!يا رفاق

121
00:08:06,210 --> 00:08:07,910
!لقد نجحت

122
00:08:09,010 --> 00:08:11,620
!وجدتُ شيئًا مدهشًا
!انظروا لهذه

123
00:08:14,320 --> 00:08:16,850
!خريطة جزيرة السّماء؟

124
00:08:17,190 --> 00:08:18,420
...سكايبيا

125
00:08:18,420 --> 00:08:19,590
أرأيتم؟ أرأيتم؟

126
00:08:19,590 --> 00:08:21,830
هل هذا يعني أنّ هنالك جزيرة
!في السّماء بالفعل؟

127
00:08:22,230 --> 00:08:25,300
!مرحى

128
00:08:25,830 --> 00:08:28,500
!أجل! جزيرة السّماء موجودة فعلاً

129
00:08:28,500 --> 00:08:31,300
!إنّها جزيرة أحلام
!يمكننا الذّهاب لجزيرة أحلام

130
00:08:31,300 --> 00:08:33,270
!جزيرة أحلام

131
00:08:33,840 --> 00:08:37,980
!لا تتحمّسوا كثيرًا
.هذا يعني أنّ ذلك قد يكون ممكنًا

132
00:08:37,980 --> 00:08:40,480
.ثمّة العديد من الخرائط المزيّفة

133
00:08:42,710 --> 00:08:46,480
!أ... أنا آسفة! إنّها موجودة
...أنا واثقة أنّها موجودة، لكن

134
00:08:47,220 --> 00:08:49,290
،اسمع يا لوفي! أنا أقول لك

135
00:08:48,820 --> 00:08:53,560
مهلاً يا نامي، عاملي
السّفينة بلطف، موافقة؟

136
00:08:49,290 --> 00:08:51,290
!نحن لا نعرف كيف نذهب إلى هناك

137
00:08:51,290 --> 00:08:53,390
!أنت الملاّحة! تدبّري الأمر

138
00:08:53,390 --> 00:08:56,560
هنالك أمور لا يمكن أن نتدبّر
!الأمر فيها ببساطة

139
00:08:53,990 --> 00:08:58,400
.نامي-سان ظريفة حتّى وهي غاضبة أيضًا

140
00:08:56,560 --> 00:08:58,400
!لا أهتمّ! سنذهب للسّماء

141
00:08:59,860 --> 00:09:01,400
.لن نصل لأيّ نتيجة هكذا

142
00:09:01,400 --> 00:09:04,030
على كلّ حال، لا يمكننا التّقدّم
!للأمام بالسّفينة هكذا

143
00:09:04,030 --> 00:09:07,040
ما نحتاج إليه الآن هي المعلومات
.كما قالت روبين

144
00:09:07,670 --> 00:09:10,540
،إن ذهبت سفينة ضخمة كتلك للسّماء

145
00:09:10,540 --> 00:09:13,310
فثمّة بالتّأكيد طريقة لتذهب بها
.هذه السّفينة إلى هناك أيضًا

146
00:09:13,880 --> 00:09:18,280
لنجمع بطريقة ما كلّ سجلّ
!موجود على تلك السّفينة

147
00:09:18,720 --> 00:09:21,620
.لكنّ السّفينة قد غرقت بالكامل

148
00:09:22,150 --> 00:09:24,490
!إن غرقت، فسنقوم بعمليّة إنقاذ

149
00:09:24,820 --> 00:09:26,290
!أجل

150
00:09:26,290 --> 00:09:27,560
!وكأنّ بمقدورنا ذلك

151
00:09:28,330 --> 00:09:29,860
ما الّذي تقصده بعملية إنقاذ؟

152
00:09:32,430 --> 00:09:35,470
لكنّ ذلك لن ينفع بما
.أنّها كانت سفينة ضخمة

153
00:09:42,540 --> 00:09:46,710
عجبًا... إنّك تجعليننا نقوم
.بأمور متهوّرة بالفعل

154
00:09:47,480 --> 00:09:51,950
نامي-سان! سأحرص على إيجاد
!دليل للذّهاب للسّماء

155
00:09:52,220 --> 00:09:53,420
!أعتمد عليكم

156
00:09:53,420 --> 00:09:57,450
.لا تقلقوا، لا توجد عيوب بتصاميمي

157
00:10:02,190 --> 00:10:05,700
!حسنًا إذًا... أتمنّى لكم حظًّا سعيدًا

158
00:10:11,600 --> 00:10:13,040
...مهلاً، مهلاً، مهلاً

159
00:10:13,540 --> 00:10:16,010
.معكم تشوبّر. أجيبوا جميعًا رجاءً

160
00:10:16,440 --> 00:10:19,440
معكم لوفي. ثمّة الكثير
.من الوحوش هنا، حوّل

161
00:10:19,440 --> 00:10:21,780
هل هذا عشّ لأفاعي البحر؟

162
00:10:21,780 --> 00:10:24,180
!معكم سانجي. مهلاً! إنّها تنظر إلينا

163
00:10:24,180 --> 00:10:25,150
.جيّد

164
00:10:25,150 --> 00:10:25,980
!ما الجيّد؟

165
00:10:26,620 --> 00:10:28,950
!سينجون. لا تقلق

166
00:10:29,290 --> 00:10:31,790
تشوبّر، أمسك بالمكابح جيّدًا، مفهوم؟

167
00:10:31,790 --> 00:10:32,490
!نعم

168
00:10:32,490 --> 00:10:34,830
.أنا سعيد لأنّني لم أذهب

169
00:10:37,960 --> 00:11:04,820
!إنقاذ، إنقاذ

170
00:10:49,010 --> 00:10:50,240
ما هذا؟

171
00:11:02,790 --> 00:11:06,090
!يا رفاق، توقّفوا

172
00:11:05,220 --> 00:11:07,860
...إنقاذ

173
00:11:08,690 --> 00:11:10,490
!نعم، نعم يا سيّدي

174
00:11:10,490 --> 00:11:13,360
هل هذه هي المنطقة
!حيث غرقت السّفينة؟

175
00:11:13,360 --> 00:11:15,830
!نعم، نعم يا سيّدي الزّعيم

176
00:11:16,770 --> 00:11:20,800
!بقولهم زعيم... يقصدونني أنا

177
00:11:21,310 --> 00:11:23,170
!استعدّوا لإنقاذ السّفينة

178
00:11:23,170 --> 00:11:26,180
،السّفينة الغارقة ملك لي
ملك عمليّات الإنقاذ

179
00:11:26,180 --> 00:11:29,010
!وزعيم قراصنة ماسيرا

180
00:11:33,350 --> 00:11:36,750
...يا إلهي... غرباء أطوار في وقت كهذا

181
00:11:37,020 --> 00:11:39,520
!أنتم هناك! ما الّذي تفعلونه هنا؟

182
00:11:39,520 --> 00:11:41,460
!هذه منطقتي أنا

183
00:11:41,690 --> 00:11:42,930
منطقتك؟

184
00:11:43,160 --> 00:11:48,130
صحيح. إنّ كلّ سفينة تغرق
.في هذه المنطقة ملك لي أنا

185
00:11:48,130 --> 00:11:50,900
!لم تلمسوا أيّ شيء يخصّني، صحيح؟

186
00:11:51,270 --> 00:11:54,570
.يبدو أنّه سينقذ السّفينة

187
00:11:54,570 --> 00:11:56,910
.نعم، ذلك ما يبدو

188
00:11:56,910 --> 00:11:59,480
ماذا إذًا؟ أليس هذا لمصلحتنا؟

189
00:11:59,480 --> 00:12:04,720
!كفاكم ثرثرة! أجيبوا على سؤالي

190
00:12:05,320 --> 00:12:07,920
!المعذرة! هل يمكنني طرح سؤال عليك؟

191
00:12:07,920 --> 00:12:09,750
!أنت من ستسألني؟

192
00:12:09,750 --> 00:12:12,090
!لا بأس! سليني أيّ شيء

193
00:12:12,090 --> 00:12:14,790
.يبدو أنّكم ستنقذون السّفينة
أكلامي قريب من الصّحّة؟

194
00:12:14,790 --> 00:12:15,930
قرد من...؟

195
00:12:18,830 --> 00:12:21,930
مهلاً... هل تجدينني أشبه القرد؟

196
00:12:22,400 --> 00:12:23,300
تشبه القرد؟

197
00:12:23,300 --> 00:12:25,900
ذلك يعني أنّني وسيم. ألا تظنّين ذلك؟

198
00:12:26,740 --> 00:12:27,570
!نعم

199
00:12:27,570 --> 00:12:30,010
!هيّا، توقّفي

200
00:12:30,410 --> 00:12:32,110
اختلطت عليه كلماتك فحسب، صحيح؟

201
00:12:33,080 --> 00:12:35,780
!إذًا هل ستقومون بإنقاذها؟

202
00:12:35,780 --> 00:12:39,580
،بالطّبع! إن كانت هنالك سفينة غارقة أمامي

203
00:12:39,580 --> 00:12:41,920
!فسأنقذها! أنا من ذلك النّوع من الرّجال

204
00:12:41,920 --> 00:12:45,260
وإن كانت فوق الماء، فسأغرقها
!ثمّ سأنقذها! هكذا أنا

205
00:12:45,260 --> 00:12:48,190
!لا توجد سفينة لا يمكننا إنقاذها

206
00:12:49,090 --> 00:12:52,300
حسنًا... هل يمكنك السّماح لنا بالمشاهدة؟

207
00:12:53,360 --> 00:12:56,870
هكذا إذًا! هل إنقاذ السّفن جديد عليكم؟

208
00:12:57,670 --> 00:12:59,770
!لا بأس! يمكنكم المشاهدة

209
00:13:00,270 --> 00:13:03,740
حسنًا! لنر كيف ستسير الأمور
.من هنا يا رفاق

210
00:13:04,470 --> 00:13:07,280
...كـ... كونوا حذرين

211
00:13:08,050 --> 00:13:09,710
!يا زعيم! لدينا مشكلة

212
00:13:09,710 --> 00:13:10,450
!ما الخطب؟

213
00:13:10,450 --> 00:13:13,420
الأعضاء الّذين ذهبوا لتجهيز
...الرّافعة تحت البحر

214
00:13:13,580 --> 00:13:15,590
هل هُوجموا من طرف ملوك البحر؟

215
00:13:15,590 --> 00:13:18,760
.لا... يبدو أنّهم هُزموا على يد شخص ما

216
00:13:18,760 --> 00:13:22,090
ماذا؟! هل تقول أنّ هنالك
شخصًا ما تحت البحر؟

217
00:13:22,090 --> 00:13:23,630
!أولئك الأغبياء

218
00:13:23,630 --> 00:13:24,830
.هذا سيّئ

219
00:13:25,100 --> 00:13:28,070
!إذًا... يا هؤلاء

220
00:13:28,070 --> 00:13:29,230
...إنّنا

221
00:13:29,230 --> 00:13:32,300
!ثمّة شخص ما في الأسفل! كونوا حذرين

222
00:13:32,300 --> 00:13:33,540
!حـ... حسنًا

223
00:13:33,540 --> 00:13:35,210
.من الجيّد أنّه غبيّ

224
00:13:35,470 --> 00:13:39,110
!يا رجال! لنسرع ونجهّز الرّافعة

225
00:13:39,110 --> 00:13:41,650
!لنبدأ الإنقاذ

226
00:13:41,650 --> 00:13:43,180
!نعم، نعم يا سيّدي

227
00:14:13,880 --> 00:14:17,550
إنّه يلوّح لنا... لا تدعه يلاحظ
.معدّات التّنفّس يا أوسوبّ

228
00:14:17,550 --> 00:14:19,120
!أعلم

229
00:14:19,120 --> 00:14:22,650
!يا رفاق، تخيّلوا أنّهم يقطين

230
00:14:22,650 --> 00:14:28,860
لا تتوتّروا... فقط لأنّ
هنالك من يشاهدنا، مفهوم؟

231
00:14:28,860 --> 00:14:30,590
!نعم، نعم يا سيّدي

232
00:14:30,590 --> 00:14:32,700
!أنزلوا الرّافعة

233
00:14:32,700 --> 00:14:35,130
!نعم، نعم يا سيّدي

234
00:14:37,030 --> 00:14:38,670
!انتبهوا من العدوّ الغامض

235
00:14:38,670 --> 00:14:39,700
!نعم، نعم يا سيّدي

236
00:14:41,870 --> 00:14:44,910
أتساءل إن كانوا يقومون بهذا
.بدافع الفخر أو ما شابه

237
00:14:44,910 --> 00:14:47,810
...إنّهم يحاولون تقديم عرض لنا كما أظنّ

238
00:14:48,210 --> 00:14:50,310
!تحرّكوا

239
00:14:50,310 --> 00:14:51,780
!نعم، نعم يا سيّدي

240
00:16:21,370 --> 00:16:22,040
...أنت

241
00:16:23,140 --> 00:16:23,970
!انظر

242
00:16:55,610 --> 00:16:57,870
!الرّافعة جاهزة، تمّ التّأكيد

243
00:16:59,580 --> 00:17:00,480
!ما الّذي يحدث؟

244
00:17:13,890 --> 00:17:18,000
!ما ذلك القرد؟! ما وظيفة ذلك القرد؟

245
00:17:18,000 --> 00:17:19,260
تقصد هذا؟

246
00:17:20,530 --> 00:17:22,730
.لديك نظر حادّ

247
00:17:22,730 --> 00:17:25,240
.أنت محقّ. إنّها ليست مقدّمة سفينة عاديّة

248
00:17:27,000 --> 00:17:30,670
!أطلقوا صائد السّفن

249
00:17:31,010 --> 00:17:33,210
!نعم، نعم يا سيّدي

250
00:17:48,130 --> 00:17:49,630
!كم هذا مذهل

251
00:17:49,630 --> 00:17:50,930
!إنّ مذهل فعلاً

252
00:17:50,930 --> 00:17:51,660
ما المذهل؟

253
00:17:54,130 --> 00:17:55,630
!بقيت 40 مترًا على الهدف

254
00:17:56,600 --> 00:17:58,140
‫30 مترًا!

255
00:17:58,870 --> 00:18:01,610
!...10 ...20

256
00:18:04,470 --> 00:18:08,150
!تثبيت صائد السّفن... اكتمل

257
00:18:08,150 --> 00:18:11,520
!حسنًا! سأبدأ نفخ الهواء

258
00:18:11,520 --> 00:18:14,550
!نعم، نعم يا سيّدي

259
00:18:14,750 --> 00:18:16,520
...ماذا؟ مستحيل

260
00:18:25,730 --> 00:18:27,560
!هذا جنونيّ

261
00:18:40,740 --> 00:18:41,880
!هواء؟

262
00:18:49,490 --> 00:18:51,320
!بدأت السّفينة بالصّعود

263
00:18:57,030 --> 00:18:59,460
!نعم، نعم يا سيّدي

264
00:19:00,030 --> 00:19:03,170
!انفخوا المزيد من الهواء! في الحال

265
00:19:03,170 --> 00:19:05,470
!نعم، نعم يا سيّدي

266
00:19:14,010 --> 00:19:17,050
!...يا زعيم! الفريق الّذي تحت الماء

267
00:19:17,050 --> 00:19:21,650
!ما الخطب؟! ماذا حدث يا رجال؟

268
00:19:21,650 --> 00:19:23,750
!ثمّة شخص ما في السّفينة

269
00:19:31,130 --> 00:19:36,300
!كيف يجرؤون على أذيّة رجالي؟
!من يكونون؟

270
00:19:42,440 --> 00:19:45,380
...حسنًا، لن نأخذ أيّة صور أو ما شابه

271
00:19:45,380 --> 00:19:46,610
!ماذا؟

272
00:19:46,610 --> 00:19:48,550
...قام بوقفة من أجلنا لنلتقط صورًا

273
00:19:48,550 --> 00:19:50,610
!يا زعيم! النّجدة

274
00:19:52,580 --> 00:19:55,990
أنا قادم! واصلوا العمل
!على عمليّة الإنقاذ

275
00:19:55,990 --> 00:19:58,160
!نعم، نعم يا سيّدي

276
00:20:18,010 --> 00:20:19,210
!لكمة القرد

277
00:20:22,550 --> 00:20:24,210
...إنّها تصعد

278
00:20:28,690 --> 00:20:31,390
.أرأيتما؟ لا ضرر علينا بلا براميل

279
00:20:31,660 --> 00:20:34,560
.من المذهل أنّهم نفخوا كلّ هذا الهواء

280
00:20:35,130 --> 00:20:38,960
لكن من يحاول إنقاذ هذه السّفينة؟

281
00:20:38,960 --> 00:20:42,430
لا بدّ أنّ شيئًا ما حدث
.لنامي-سان وروبين-تشان

282
00:20:42,430 --> 00:20:44,870
!أنا أنادي عليهما ولا تجيبان

283
00:20:46,040 --> 00:20:50,610
!من تكونون ولماذا اقتحمتم منطقتي؟

284
00:20:53,640 --> 00:20:55,550
.إ... إنّه قرد

285
00:20:56,050 --> 00:20:59,020
ماذا؟ هل أشبه القرد فعلاً؟

286
00:20:59,420 --> 00:21:01,020
.نعم، أنت تشبه قردًا بالفعل

287
00:21:01,020 --> 00:21:03,020
ما هذه المحادثة؟

288
00:21:03,020 --> 00:21:03,990
ماذا تقصد؟

289
00:21:04,820 --> 00:21:06,020
بالمناسبة، من تكون؟

290
00:21:06,020 --> 00:21:08,690
!فهمت... ما بيدي حيلة

291
00:21:08,690 --> 00:21:12,230
هل تعتقد ذلك فعلاً؟
!لديك نظر حادّ

292
00:21:12,230 --> 00:21:14,000
!سألناك من تكون؟

293
00:21:18,440 --> 00:21:20,500
...مهلاً، هنالك تحت السّفينة

294
00:21:20,970 --> 00:21:25,880
.نـ-نعم... ثمّة شيء هناك في الأسفل

295
00:21:29,350 --> 00:21:33,320
!فهمت! أنتم من الأزرق الشّرقيّ إذًا؟

296
00:21:33,650 --> 00:21:37,790
!نعم. لكنّك تشبه القرود بالفعل

297
00:21:38,160 --> 00:21:40,990
!كفّ عن مجاملتي

298
00:22:01,280 --> 00:22:05,180
!ما هذا؟! ما هذا الشّيء؟

299
00:22:09,720 --> 00:22:17,790
آه، خلف السّماء الّتي لا نهاية لها

300
00:22:17,790 --> 00:22:28,400
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

301
00:22:36,280 --> 00:22:43,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

302
00:22:43,720 --> 00:22:52,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

303
00:22:52,130 --> 00:23:00,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

304
00:23:00,340 --> 00:23:09,180
دفعوا بي للأمام، أليس كذلك؟

305
00:23:09,180 --> 00:23:17,490
آه، إنّ النّجوم تهوي من السّماء

306
00:23:17,490 --> 00:23:20,620
...وهذه اللّحظة الفريدة

307
00:23:26,600 --> 00:23:27,660
!إنّها سلحفاة

308
00:23:27,660 --> 00:23:29,730
!نحن في البحر! بالطّبع سنصادف سلاحف

309
00:23:29,730 --> 00:23:31,400
!لوفي! زورو! سانجي

310
00:23:31,400 --> 00:23:33,070
!اخرس وابق صامتًا

311
00:23:33,070 --> 00:23:34,800
!كيف لك أن تكوني هادئة هكذا؟

312
00:23:34,800 --> 00:23:37,870
وقعت علينا سفينة غاليون
!ثمّ ظهر قرد غريب

313
00:23:37,870 --> 00:23:39,840
!ماذا؟! حلّ الظّلام فجأة

314
00:23:39,840 --> 00:23:41,380
!ماذا بعد هذا؟

315
00:23:41,640 --> 00:23:43,080
:في الحلقة القادمة من ون بيس

316
00:23:43,080 --> 00:23:46,350
ظهور وحوش! لا تعبثوا"
"!مع قراصنة اللّحية البيضاء

317
00:23:46,350 --> 00:23:48,650
!ملك القراصنة، لن يكون إلاّ أنا