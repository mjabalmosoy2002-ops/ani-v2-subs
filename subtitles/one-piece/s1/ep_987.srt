1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,070 --> 00:02:02,030
!إلى الجحيم يا أبو

29
00:02:02,030 --> 00:02:03,490
!كيد

30
00:02:03,490 --> 00:02:05,950
...الوتر

31
00:02:10,370 --> 00:02:12,790
!المغناطيسيّ

32
00:02:13,990 --> 00:02:18,210
"!حُطّم حُلمه؟! الفخّ الّذي استدرج سانجي"

33
00:02:36,690 --> 00:02:38,440
!أيّها المسنّن

34
00:02:38,440 --> 00:02:40,110
!ذلك المغفّل

35
00:02:43,230 --> 00:02:44,690
!أبو-سان

36
00:02:44,690 --> 00:02:47,360
!مهلاً! إنّه ليس معنا

37
00:03:01,040 --> 00:03:03,920
!ماذا؟

38
00:03:03,920 --> 00:03:06,840
!...لا تقل لي أنّه

39
00:03:11,130 --> 00:03:15,100
!إنّه كابتن كيد

40
00:03:19,270 --> 00:03:22,190
!كيف يوجد كيد هنا أيضًا؟

41
00:03:22,190 --> 00:03:25,110
!ظننتُ أنّه مسجون في أودون

42
00:03:25,110 --> 00:03:29,990
!ما كلّ هذا يا بابانوكي؟

43
00:03:42,160 --> 00:03:46,630
...كنت توّاقًا لتشكيل تحالف معنا

44
00:03:48,300 --> 00:03:53,010
!كان حريًّا بي ملاحظة ذلك وقتها

45
00:03:55,720 --> 00:03:59,730
!كنتَ مخبرًا لكايدو

46
00:03:59,730 --> 00:04:03,880
...عرف كايدو كلّ خطوة قمنا بها

47
00:04:03,880 --> 00:04:07,610
!لأنّك كنت تبلّغه بها، صحيح؟

48
00:04:10,940 --> 00:04:13,570
!هذا بسبب سذاجتك

49
00:04:13,570 --> 00:04:14,620
!ماذا؟

50
00:04:14,620 --> 00:04:20,540
هل اعتقدت أنّ تحالفنا كان قويًّا
!كفاية للإطاحة بأحد اليونكو؟

51
00:04:20,540 --> 00:04:22,380
!كن واقعيًّا

52
00:04:24,710 --> 00:04:27,490
...إنّ تحالفات القراصنة في المقام الأوّل

53
00:04:27,490 --> 00:04:30,720
!نادرًا ما تكون لها نهاية سعيدة

54
00:04:30,720 --> 00:04:32,640
!خدش

55
00:04:32,640 --> 00:04:34,680
!تقطيع

56
00:04:47,310 --> 00:04:50,490
...ظننتُ أنّك ميت

57
00:04:50,490 --> 00:04:53,240
ماذا؟ كيد؟

58
00:04:54,610 --> 00:04:56,240
!أيّها الحثالة

59
00:05:02,620 --> 00:05:04,050
!ضرب

60
00:05:14,510 --> 00:05:15,880
!يا قبطان

61
00:05:15,880 --> 00:05:17,770
هل أنت بخير؟

62
00:05:18,180 --> 00:05:19,430
!لا داعي للقلق

63
00:05:19,430 --> 00:05:23,350
!كوين-سان! لقد أطلقوا العنان لأنفسهم

64
00:05:24,270 --> 00:05:28,110
إنّهم مليئون بالطّاقة
!ويصعب الإمساك بهم أحياء

65
00:05:33,690 --> 00:05:35,660
.بإمكانكم قتلهم

66
00:05:43,750 --> 00:05:45,330
!تنافر

67
00:05:51,300 --> 00:05:53,840
!هلمّوا إليّ إن كان الموت رغبتكم

68
00:05:54,050 --> 00:05:56,590
!سأقتلك

69
00:06:00,350 --> 00:06:03,520
!ها هو ذا! عرفت أنّه كان كيلر

70
00:06:18,200 --> 00:06:21,420
!كيد! لنخرج من هنا

71
00:06:22,490 --> 00:06:25,580
!لن يوصلنا قتالهم هنا إلى أيّ نتيجة

72
00:06:26,790 --> 00:06:29,170
!معك حقّ

73
00:06:36,630 --> 00:06:41,390
،توقّفوا! حتّى إن قتلتموهم
!لا يمكنكم أن تكونوا جزءًا من التّوبي روبّو

74
00:06:56,230 --> 00:06:59,080
!مهلاً، توقّف! ستؤذينا

75
00:07:07,910 --> 00:07:10,460
!ابتعدوا

76
00:07:11,090 --> 00:07:13,930
!ليوقفه شخص ما

77
00:07:15,090 --> 00:07:17,360
...لا يبدو هذا جيّدًا

78
00:07:17,360 --> 00:07:19,340
!لنتراجع حاليًّا

79
00:07:19,720 --> 00:07:23,350
!من ذلك الرّجل؟! ألا يمكن السّيطرة عليه؟

80
00:07:23,590 --> 00:07:27,770
!أهو عملاق؟! لكنّه يبدو أكبر بكثير

81
00:07:45,040 --> 00:07:49,670
!أجل يا هاتشا! اسحق الجيل الأسوأ

82
00:08:08,180 --> 00:08:11,820
!سآخذ رأس كيد

83
00:08:26,080 --> 00:08:28,790
!أيّها المسنّن! لنسرع نحو القلعة

84
00:08:29,660 --> 00:08:32,960
!هدفنا الآن هو رأس كايدو

85
00:08:32,960 --> 00:08:37,010
!لا يجب أن نضيّع وقتنا هنا

86
00:08:37,330 --> 00:08:39,140
!يا قبّعة القشّ

87
00:08:46,760 --> 00:08:47,770
!رفاق

88
00:08:47,770 --> 00:08:50,180
!واصل يا قبطان

89
00:08:50,180 --> 00:08:52,520
!سنتولّى أمرهم

90
00:08:52,520 --> 00:08:55,130
!حسنًا! سنتركهم لكم يا رفاق

91
00:08:55,130 --> 00:08:57,070
!هيّا بنا أيّها المسنّن

92
00:09:08,660 --> 00:09:10,580
!هيّا بنا يا زورو

93
00:09:10,580 --> 00:09:12,250
!أجل

94
00:09:32,140 --> 00:09:33,640
...يا إلهي

95
00:09:33,640 --> 00:09:37,600
!عرفت أنّك ستسبّب الفوضى أيّها المسنّن

96
00:09:37,600 --> 00:09:40,530
!أنت تقول هذا يا لوفي؟

97
00:09:41,240 --> 00:09:43,150
!لا يحقّ لك الحديث أيضًا يا رورونوا

98
00:09:45,910 --> 00:09:47,580
!اسمع أيّها المسنّن

99
00:09:47,580 --> 00:09:50,830
!سنتسلّل بهدوء من هنا

100
00:09:50,830 --> 00:09:53,040
!لا تملِ عليّ الأوامر

101
00:09:53,040 --> 00:09:55,660
!لا أتذكّر أنّني تحالفت معكم أيّها الحمقى

102
00:09:55,660 --> 00:09:57,640
!ماذا؟

103
00:09:57,640 --> 00:10:00,050
!هل تستمع لي يا قبّعة القشّ؟
...إنّك دائمًا ما

104
00:10:00,050 --> 00:10:03,050
!مع السّلامة يا رفاق! سأطيح برأس كايدو

105
00:10:03,050 --> 00:10:05,380
!ماذا؟ انتظر

106
00:10:05,840 --> 00:10:07,390
!لا يمكنك ذلك

107
00:10:07,390 --> 00:10:08,720
!سأذهب أوّلاً

108
00:10:08,720 --> 00:10:10,430
!كلاّ، سأذهب أنا أوّلاً

109
00:10:10,430 --> 00:10:11,470
!بل أنا

110
00:10:11,470 --> 00:10:13,560
!لن أسمح لك

111
00:10:14,100 --> 00:10:18,460
.فسدت الخطّة تمامًا
...لقد خرجوا عن السّيطرة

112
00:10:18,460 --> 00:10:20,570
!لا أمل يُرجى منهم

113
00:10:22,190 --> 00:10:24,380
!مرحى

114
00:10:24,380 --> 00:10:30,030
!لا يستطيع أحد الهروب من قتال الموسيقى خاصّتي

115
00:10:30,030 --> 00:10:32,570
!سأمحوكم! استمعوا

116
00:10:32,570 --> 00:10:34,160
!انفجار

117
00:10:53,010 --> 00:10:55,770
!أعتقد أنّه هو الفاعل

118
00:11:26,210 --> 00:11:27,470
!تبًّا

119
00:11:27,470 --> 00:11:29,670
!إنّه هو ثانية

120
00:11:29,670 --> 00:11:31,800
!من تلك المسافة؟

121
00:11:35,680 --> 00:11:38,640
!أبو! ذلك الوغد

122
00:11:38,640 --> 00:11:42,280
!لا تفقدوا تركيزكم! ذلك ما يسعى إليه

123
00:11:44,020 --> 00:11:47,740
!ها نحن أولاء! مرّة أخرى! استمعوا

124
00:11:48,570 --> 00:11:51,160
!هيّا! غطّوا آذانكم

125
00:11:51,160 --> 00:11:54,200
!استمعوا! انفجار

126
00:12:24,230 --> 00:12:26,280
!اسمعوا يا رفاق

127
00:12:26,650 --> 00:12:32,660
!هجمات أبو فعّالة فقط على مرمى السّمع
!لا يمكن تفاديها ما دمنا سمعناها

128
00:12:32,660 --> 00:12:35,080
!انتبهوا لهجماته المفاجئة

129
00:12:36,370 --> 00:12:37,160
ماذا؟

130
00:12:37,950 --> 00:12:39,810
ماذا قلت؟

131
00:12:39,810 --> 00:12:41,450
!كرّر ذلك ثانية

132
00:12:41,450 --> 00:12:44,830
!هذا مهمّ للغاية، لذلك سأكرّر كلامي

133
00:12:44,830 --> 00:12:46,300
!نعم

134
00:12:51,260 --> 00:12:53,780
!تلقّيت رسالة منهم

135
00:12:53,780 --> 00:12:58,350
!قالوا أنّ السّفينة بخير، لذلك سيكونون هنا قريبًا

136
00:12:58,350 --> 00:12:59,710
!هذا جيّد

137
00:12:59,710 --> 00:13:03,600
...لكنّ ذلك غريب يا بيغ مام

138
00:13:04,020 --> 00:13:08,610
...لم تصلنا أيّ أخبار من ميناء موغورا

139
00:13:08,900 --> 00:13:13,490
،إن رأوا أيّ سفينة في الميناء
...كان عليهم الاتّصال بنا

140
00:13:13,990 --> 00:13:15,870
ميناء؟

141
00:13:15,870 --> 00:13:18,550
أيّ ميناء؟

142
00:13:18,550 --> 00:13:20,080
!ماذا؟

143
00:13:38,890 --> 00:13:46,940
في تلك الأثناء، القوّات الشّرقيّة تحت قيادة كينييمون
.متّجهة إلى المدخل الخلفيّ للقلعة كما هو مخطّط

144
00:13:54,700 --> 00:13:57,280
!يا كينييمون

145
00:13:57,280 --> 00:14:00,700
!أتينا عبر الغوّاصة

146
00:14:01,450 --> 00:14:04,880
!تشوبّر-دونو! أنت هنا

147
00:14:05,540 --> 00:14:08,630
!حسنًا! هيّا بنا

148
00:14:09,340 --> 00:14:13,510
!يا رفاقي المحاربين! أودّ تعديل خطّتنا الآن

149
00:14:13,710 --> 00:14:19,100
.يبدو أنّه لم يصلهم خبر بوصولنا بعد

150
00:14:19,100 --> 00:14:22,350
!لننفصل لمجموعتين ثانية

151
00:14:23,770 --> 00:14:28,130
،سيتسلّل النّصف الأوّل من جانب قبّة الجمجمة

152
00:14:28,130 --> 00:14:31,800
.وسينتظر اللّحظة المناسبة متنكّرين بهيئة العدوّ

153
00:14:31,800 --> 00:14:35,510
،بينما سيتسلّل النّصف الثّاني عبر المدخل الخلفي

154
00:14:35,510 --> 00:14:38,660
!وسنهاجم كايدو وأوروتشي من كِلا الجانبين

155
00:14:39,030 --> 00:14:41,240
!أنا أرتعش من الحماسة

156
00:14:41,240 --> 00:14:43,580
.أتساءل إن كنّا سنجد مومو هناك

157
00:14:46,660 --> 00:14:53,430
بالتّالي، تتواصل الخطّة في التّقدّم
.بسلاسة مع بعض التّعديلات

158
00:14:54,500 --> 00:14:59,520
في تلك الأثناء، ينتقل لو والبقيّة
...تحت البحر في الغوّاصة

159
00:15:04,980 --> 00:15:11,190
ويأخذ دنجيرو والبقيّة الطّريق
.في الجانب الجنوبيّ للجزيرة

160
00:15:11,860 --> 00:15:18,550
يختلط جينبي وروبين مع الأعداء
.وهما متخفّيان وهدفها التّسلّل للقلعة

161
00:15:18,550 --> 00:15:21,330
.وكذلك حال فرانكي وبروك

162
00:15:21,700 --> 00:15:25,500
،بينما يستمتع قراصنة مملكة الحيوان بالوليمة

163
00:15:25,500 --> 00:15:31,920
يتقدّم السّاموراي بشكل ثابت
.إلى القلعة حيث أوروتشي وكايدو

164
00:15:36,090 --> 00:15:38,010
ما الّذي يفعلونه؟

165
00:15:41,880 --> 00:15:44,430
!يا رفاق

166
00:15:44,430 --> 00:15:46,480
!أنتم

167
00:15:49,060 --> 00:15:52,640
...استدعانا كايدو-ساما

168
00:15:52,640 --> 00:15:55,110
!ونحن في عجلة من أمرنا! دعونا نمرّ

169
00:15:55,110 --> 00:15:56,530
!هيّا

170
00:15:56,530 --> 00:15:57,240
!شكرًا

171
00:15:57,240 --> 00:15:58,360
!مرحى

172
00:16:02,990 --> 00:16:08,390
هل تودّون الاستمتاع بوقتكم معي بعد
أن ينتهي عملي مع كايدو-ساما؟

173
00:16:08,390 --> 00:16:12,580
!في تلك الحالة، دعوني أمرّ

174
00:16:12,580 --> 00:16:13,900
!ماذا؟

175
00:16:13,900 --> 00:16:15,210
!لا

176
00:16:16,010 --> 00:16:18,880
!نينبو: ساحق الكرات

177
00:16:29,560 --> 00:16:32,810
.كوني امرأة ناضجة جريمة

178
00:16:32,810 --> 00:16:34,820
...كانت تلك التّقنية مرعبة

179
00:16:35,230 --> 00:16:40,550
...لم أجرّب أيّ شيء كذلك من قبل
...لكن قد أودّ اكتشاف إمكانيّات جديدة

180
00:16:40,550 --> 00:16:41,470
!لا، لا

181
00:16:41,470 --> 00:16:44,080
!لستُ مستعدًّا لذلك

182
00:16:47,870 --> 00:16:49,170
!توقّفوا

183
00:16:49,540 --> 00:16:53,960
.ولكن، كان هنالك خطأ في الحسابات

184
00:16:54,790 --> 00:16:59,150
.فهمت. كانت المعلومات على التّصاميم قديمة

185
00:16:59,150 --> 00:17:02,410
.لا عجب أنّ بنايات جديدة قد بُنيت

186
00:17:02,410 --> 00:17:07,640
لكنّه ليس مناسبًا إطلاقًا ليعبر أكثر
!من ألفَيْ محارب ذلك الجسر

187
00:17:26,660 --> 00:17:29,040
...يا كينييمون

188
00:17:30,660 --> 00:17:33,690
!...ثـ...ثـ...ثـ

189
00:17:33,690 --> 00:17:37,380
!ثمّة منزل للمتعة

190
00:17:37,800 --> 00:17:43,090
هذا منزل متعة... وهو من أملاك
!بلاد ماريا السّوداء، من التّوبي روبّو

191
00:17:48,090 --> 00:17:52,230
يراودني شعور أنّ هنالك الكثير
!من النّساء الجميلات هناك

192
00:17:52,230 --> 00:17:54,100
!كلاّ يا سانجي

193
00:17:54,350 --> 00:17:57,440
!انتظر يا سانجي-دونو

194
00:17:58,270 --> 00:18:01,280
!وكأنّ هنالك من يجرّه إليه

195
00:18:02,020 --> 00:18:04,590
!انسوا أمر سانجي-كُن

196
00:18:04,590 --> 00:18:06,790
.بغضّ النّظر عن ذلك يا كينييمون

197
00:18:07,280 --> 00:18:09,870
!سنتسلّل نحن أيضًا

198
00:18:09,870 --> 00:18:13,540
!سنشكّل فريقًا لإنقاذ مومونوسكي-ساما

199
00:18:13,540 --> 00:18:18,630
أنت تقلق عليه كثيرًا، صحيح؟

200
00:18:24,340 --> 00:18:28,060
!دع أمر إنقاذ مومو-تشان لنا

201
00:18:29,010 --> 00:18:33,310
!وهكذا يستطيع كينييمون والبقيّة التّركيز على القتال

202
00:18:33,310 --> 00:18:36,940
!نامي-دونو! كاروت-دونو! شينوبو

203
00:18:39,560 --> 00:18:44,030
!شكرًا لكنّ! لأصدقكنّ القول، كان ذلك يثقل كاهلي

204
00:18:44,400 --> 00:18:45,950
!أعتمد عليكنّ

205
00:19:00,420 --> 00:19:03,210
!خرج أحد ما من منزل المتعة

206
00:19:04,880 --> 00:19:06,470
...إنّه

207
00:19:08,970 --> 00:19:12,480
...يبدو أنّه لم يستطع إيجاد أيّ نساء

208
00:19:13,390 --> 00:19:18,000
،بعد سماع الجلبة الّتي أحدثها لوفي والبقيّة

209
00:19:18,000 --> 00:19:23,200
كان معظم أتباع كايدو وأوروتشي
...قد غادروا منزل المتعة سلفًا

210
00:19:24,320 --> 00:19:28,160
حسنًا! عدم وجود نساء في منزل المتعة
.يعني أنّ لا رجال هناك أيضًا

211
00:19:28,160 --> 00:19:30,200
!سنعبر ذلك الجسر الآن

212
00:19:35,370 --> 00:19:38,450
!دخلاء! أمسكوا بهم

213
00:19:38,450 --> 00:19:40,170
!أطيحوا بهم

214
00:19:53,050 --> 00:19:54,680
!إنّه كيلر

215
00:19:57,180 --> 00:19:59,940
!اسمعوا! اسمعوا! اسمعوا

216
00:20:00,140 --> 00:20:01,670
!أجل! أجل

217
00:20:01,670 --> 00:20:06,360
لماذا أخذت هزيمة ضعفاء مثلهم كلّ هذا الوقت؟

218
00:20:08,070 --> 00:20:10,050
أتعلمون؟

219
00:20:10,050 --> 00:20:12,850
أكل كيلر فاكهة سمايل معيبة

220
00:20:12,850 --> 00:20:17,330
!وصار من المسرورين الآن

221
00:20:38,230 --> 00:20:40,170
!يا كيلر

222
00:20:40,170 --> 00:20:44,650
!إن أكلت هذه، سأمنحك فرصة لإنقاذ قبطانك

223
00:20:44,650 --> 00:20:47,320
هيّا، ماذا ستفعل؟

224
00:21:19,470 --> 00:21:21,440
!ما المضحك في ذلك؟

225
00:21:23,400 --> 00:21:25,690
!أيّها الأوغاد

226
00:21:26,350 --> 00:21:30,070
!لا تضحكوا على صديقي

227
00:21:38,110 --> 00:21:42,790
!سأرسل كلّ من يضحك عليك للجحيم

228
00:21:44,040 --> 00:21:45,590
.مفهوم

229
00:21:47,830 --> 00:21:49,960
!أيّها المسنّن

230
00:21:49,960 --> 00:21:52,380
!لا تتسبّب في المزيد من المشاكل

231
00:21:52,380 --> 00:21:54,340
!لا يحقّ لكما الحديث

232
00:21:57,880 --> 00:22:01,730
...إذًا فقد هربوا من سجن أودون

233
00:22:01,730 --> 00:22:04,940
هل نمسك بهم؟ بإمكاننا
...الحصول على فضل ذلك

234
00:22:04,940 --> 00:22:08,320
.انس الأمر! إنّهم مجرّد حفنة من الفئران

235
00:22:08,320 --> 00:22:12,090
.بدل ذلك، جدوا ياماتو وأعلموني بمكانه

236
00:22:12,090 --> 00:22:14,990
.ستكون تلك وجبة أكبر

237
00:22:15,440 --> 00:22:17,870
!لا تدعوا ساساكي يجده أوّلاً

238
00:22:17,870 --> 00:22:19,120
!حاضر

239
00:22:22,580 --> 00:22:25,790
!لماذا تعانون في مواجهة أولئك الحمقى؟

240
00:22:25,790 --> 00:22:28,590
!اقتلوهم فحسب

241
00:22:30,130 --> 00:22:31,550
...على أيّ حال

242
00:22:32,040 --> 00:22:35,390
...لا أصدّق أنّ كوين قال

243
00:22:36,220 --> 00:22:41,060
...شاءت الصّدف أنّني أريد التّخلّص

244
00:22:42,930 --> 00:22:45,440
!من أحد التّوبي روبّو

245
00:22:47,730 --> 00:22:50,280
...ثمّة أحد ما

246
00:22:52,360 --> 00:22:54,740
.أريد قتله أيضًا

247
00:23:04,200 --> 00:23:12,090
بينما يتواصل التّسلّل إلى أونيغاشيما، يحاول
.أبناء بيغ مام دخول بلاد وانو ثانية بكلّ إصرار

248
00:23:12,090 --> 00:23:17,200
!هنالك رجل واحد يقف في طريقهم
!أجنحة من لهب ومخالب حادّة

249
00:23:17,200 --> 00:23:21,980
!اسمه ماركو العنقاء! وها قد أتى

250
00:23:22,390 --> 00:23:23,560
:في الحلقة القادمة من وان بيس

251
00:23:23,560 --> 00:23:27,080
"!وصول التّعزيزات! قائد قراصنة اللّحية البيضاء"

252
00:23:27,080 --> 00:23:31,650
.ملك القراصنة، لن يكون إلاّ أنا