1
00:00:02,490 --> 00:00:04,330
...الثّروة والشّهرة والسّلطة

2
00:00:04,630 --> 00:00:06,500
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,500 --> 00:00:08,400
.ملك القراصنة، غولد روجر

4
00:00:08,800 --> 00:00:12,570
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,570 --> 00:00:16,170
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,440 --> 00:00:20,040
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,650 --> 00:00:26,720
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,350 --> 00:00:30,290
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,190 --> 00:00:35,790
سنجمع كل أحلامنا

10
00:00:36,790 --> 00:00:42,230
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,630 --> 00:00:48,270
!ون بيس

12
00:00:48,770 --> 00:00:53,610
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,440 --> 00:00:59,050
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,150 --> 00:01:05,120
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,450 --> 00:01:10,990
!فإنّها ليست أسطورة إذًا

16
00:01:12,190 --> 00:01:17,870
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:17,930 --> 00:01:22,770
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,070 --> 00:01:25,670
!وتظاهر أنّها غير موجودة

19
00:01:26,640 --> 00:01:31,510
سنجمع كلّ أحلامنا

20
00:01:32,510 --> 00:01:37,690
ونبحر باحثين عن شيء

21
00:01:38,020 --> 00:01:40,920
،عملة في جيبي

22
00:01:41,020 --> 00:01:44,190
وتريد أن تصبح صديقي؟

23
00:01:44,290 --> 00:01:48,800
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,660 --> 00:01:50,830
!إننا كذلك

25
00:01:56,370 --> 00:01:59,210
...فقط لهزيمة هذا الرّجل

26
00:02:02,080 --> 00:02:03,810
!مهارة أسلوب السّيوف الثّلاثة السّرّيّة

27
00:02:05,410 --> 00:02:07,680
!من الأفضل ألاّ تندم عندما أقتلك

28
00:02:09,150 --> 00:02:11,080
!العوالم الثّلاثة آلاف

29
00:02:19,130 --> 00:02:23,060
!زورو

30
00:02:25,730 --> 00:02:30,270
!ظهور تقنيات السّاق المميتة"
".سانجي ضدّ بيرل المنيع

31
00:02:47,720 --> 00:02:49,760
!يريدون القتال أيضًا

32
00:02:51,420 --> 00:02:52,620
!بدأت أتحمّس

33
00:02:53,260 --> 00:02:55,530
أيّها العمّ! وعدتني، صحيح؟

34
00:02:55,530 --> 00:02:59,600
،بمجرّد أن أبعدهم عن هنا
يمكنني التّوقّف عن العمل، صحيح؟

35
00:02:59,600 --> 00:03:01,200
.ما كنتُ لأرغب بشيء آخر

36
00:03:01,200 --> 00:03:05,570
،إن عملتَ في هذا المكان لسنة
.فسيصبح في حالة يرثى لها

37
00:03:06,100 --> 00:03:07,270
!حسنًا

38
00:03:07,270 --> 00:03:12,310
قلتَ أنّك تريد أن تصبح
ملك القراصنة، فهل أنت جادّ؟

39
00:03:12,310 --> 00:03:16,250
نعم، بالطّبع! سأصبح
!ملك القراصنة بكلّ تأكيد

40
00:03:17,110 --> 00:03:19,950
.قابلت الكثير ممّن يتبجّحون بقوّتهم

41
00:03:19,950 --> 00:03:23,850
لكنّك الأوّل منذ وقت طويل
.من قال ذلك بكلّ وضوح

42
00:03:23,850 --> 00:03:27,120
.سمعتُ أنّك كنتَ قرصانًا قويًّا جدًّا

43
00:03:27,660 --> 00:03:30,060
هل كنت تسعى لتصبح ملك القراصنة؟

44
00:03:30,890 --> 00:03:33,830
.وضعتُ الماضي خلفي

45
00:03:33,830 --> 00:03:39,170
أنا مالك مطعم الآن
.وذلك كافٍ بالنّسبة لي

46
00:03:41,440 --> 00:03:45,410
يا رجال! ما دمنا سنستولي
،على تلك السّفينة

47
00:03:45,410 --> 00:03:47,780
!فلن نخشى الغراند لاين بعدها

48
00:03:48,610 --> 00:03:53,750
بإمكاننا الاقتراب وشنّ هجوم مباغت
على سفن الأعداء بفعاليّة أكثر

49
00:03:59,190 --> 00:04:01,920
.سنتمكّن من شنّ هجمات مباغتة محدّدة

50
00:04:01,960 --> 00:04:04,330
...صحيح أنّ لا أحد سيشكّ

51
00:04:04,330 --> 00:04:07,900
أنّ هنالك قراصنة على متن
.سفينة سخيفة كتلك

52
00:04:07,900 --> 00:04:12,770
لـ-لكن أيّها الدّون... حتّى إن دخلنا
،الغراند لاين بتلك السّفينة

53
00:04:12,770 --> 00:04:16,740
فإن صادفنا شخصًا مثل
...عين الصّقر ميهوك ثانية

54
00:04:21,740 --> 00:04:26,110
هل ما زلتم خائفين
!من شخص مثله؟ أجيبوا؟

55
00:04:26,110 --> 00:04:27,320
...كـ-كلاّ

56
00:04:27,320 --> 00:04:31,290
تعتقدون أنّ إنسانًا عاديًّا بإمكانه
!تقطيع سفينة شراعيّة ضخمة؟

57
00:04:32,750 --> 00:04:36,160
.لا بدّ أنّها قوّة فاكهة شيطان معيّنة

58
00:04:36,160 --> 00:04:40,430
رغم أنّ آكلي فواكه الشّيطان
،يراهم المجتمع كأساطير

59
00:04:40,430 --> 00:04:44,230
.إلاّ أنّ الغراند لاين يمتلئ بهم

60
00:04:44,230 --> 00:04:49,240
لا بدّ أنّ ميهوك استعمل
.قوّة غريبة ما لتقطيع السّفينة

61
00:04:49,240 --> 00:04:55,910
حتّى ذو قبّعة القشّ ذاك سيكون مجرّد
.قرصان عاديّ عند دخوله الغراند لاين

62
00:05:04,450 --> 00:05:09,090
،أمّا السّاق الحمراء زيف
.فقد أبحر هناك لمدّة سنة

63
00:05:13,130 --> 00:05:17,930
لا يسعني إلاّ التّفكير أنّه كانت لديهم
.طُرق معيّنة لمواجهة أولئك الوحوش

64
00:05:18,570 --> 00:05:24,200
ولا بدّ أنّ تلك الطُّرق مدوّنة
.في سجلّ سفينته

65
00:05:24,640 --> 00:05:27,510
إن حالفنا الحظّ، قد نجد
.معلومات عن "ون بيس" أيضًا

66
00:05:28,010 --> 00:05:30,410
!فهمت... هذا ما توقّعته من الدّون كريغ

67
00:05:30,410 --> 00:05:32,810
،ما دمنا نملك تلكّ السّفينة والسّجلّ

68
00:05:32,810 --> 00:05:35,480
!فسنجد طريقنا لـ"الون بيس" ثانية

69
00:05:35,480 --> 00:05:39,950
!أفهمتم يا رجال؟! لننطلق
!سنستولي على ذلك المطعم

70
00:05:39,950 --> 00:05:41,450
!أجل

71
00:05:42,420 --> 00:05:45,160
!هذه سفينتنا... نحن الطّبّاخون

72
00:05:45,160 --> 00:05:48,660
...لن نسمح لهم بأخذها
!مهما كلّف الأمر

73
00:05:48,660 --> 00:05:51,500
و-والآن... ماذا نفعل لتشغيل هذه؟

74
00:05:51,500 --> 00:05:52,630
!بسرعة

75
00:05:58,270 --> 00:06:01,110
حسب هذا الوضع، سيتحوّل
...المطعم لساحة معركة

76
00:06:13,790 --> 00:06:19,360
أتمنّى لو كان هنالك مطعم
...في عرض البحر

77
00:06:19,360 --> 00:06:23,160
كنتُ أفكّر أنّه إن أمكنني مغادرة
،هذا المكان حيًّا

78
00:06:23,160 --> 00:06:25,760
...فسأبني مطعمًا كآخر أهداف حياتي

79
00:06:25,760 --> 00:06:28,600
...مطعم كهدف أخير لي في الحياة

80
00:06:32,340 --> 00:06:34,970
اذهب إلى غرفة التّشغيل
.وافتح الزّعانف

81
00:06:34,970 --> 00:06:38,310
ماذا؟ أفتح الزّعانف؟

82
00:06:38,310 --> 00:06:40,680
!سيمنح ذلك مكانًا ليقف عليه العدوّ

83
00:06:41,110 --> 00:06:45,750
لا بأس. لا يجب أن نسمح بجعل
.المطعم ساحة للمعركة

84
00:06:46,650 --> 00:06:50,490
إن أصبح كذلك، فسيشتكي
.ذلك العجوز اللّعين

85
00:06:50,490 --> 00:06:52,620
هل قلتَ شيئًا أيّها الشّقيّ اللّعين؟

86
00:06:52,620 --> 00:06:55,590
!نعم، قلتُ أنّك تحبّ الشّكوى
.هيّا، اذهب

87
00:06:55,590 --> 00:06:56,930
...حا...حاضر

88
00:06:59,500 --> 00:07:02,330
!ها هم قادمون! قادمون أخيرًا

89
00:07:03,100 --> 00:07:04,400
!لننطلق

90
00:07:04,400 --> 00:07:05,840
...فاكهة المطّاط

91
00:07:05,840 --> 00:07:07,300
!الصّاروخ

92
00:07:07,300 --> 00:07:09,610
!ماذا؟! إنّه يحلّق ناحيتنا

93
00:07:10,070 --> 00:07:13,210
...فاكهة المطّاط

94
00:07:13,210 --> 00:07:15,310
!المحشّ الضّخم

95
00:07:25,650 --> 00:07:27,790
!ذلك العامل الجديد مذهل

96
00:07:27,790 --> 00:07:29,560
...ما-ماذا يكون

97
00:07:29,560 --> 00:07:30,760
يا ترى؟

98
00:07:30,760 --> 00:07:35,600
هل يعجّ الغراند لاين بالأشخاص أمثاله؟

99
00:07:35,600 --> 00:07:36,730
!سانجي

100
00:07:37,500 --> 00:07:40,570
.راقب جيّدًا كيف يقاتل

101
00:07:41,300 --> 00:07:46,040
لا تُشح نظرك عنه أبدًا
.إلى أن ينتهي هذا القتال

102
00:07:48,540 --> 00:07:51,880
لا أصدّق أنّك تهاجم المطعم
...بعد أن قدّموا لك طعامًا

103
00:07:51,880 --> 00:07:55,350
!سأوسعك ضربًا أيّها الوغد النّاكر للجميل

104
00:07:57,920 --> 00:08:00,820
إذًا فأنت تريد فعلًا القتال على
الماء حيث لا موطئ قدم؟

105
00:08:00,820 --> 00:08:05,790
لا حول لآكلي فاكهة الشّيطان
.ولا قوّة في البحر. أنا أدرك ذلك

106
00:08:06,460 --> 00:08:07,630
!ستكون أشبه بمرساة

107
00:08:07,630 --> 00:08:09,760
.لكن بإمكاني التّمدّد

108
00:08:12,730 --> 00:08:15,840
!سانجي! سأفتح الزّعانف الآن

109
00:08:20,900 --> 00:08:21,980
ماذا يحدث؟

110
00:08:38,120 --> 00:08:39,860
...لقد ظهر للتّوّ

111
00:08:40,490 --> 00:08:42,800
!موطئ قدم من تحت البحر

112
00:08:54,140 --> 00:08:57,040
!مذهل! هذا ممتع

113
00:09:01,310 --> 00:09:04,780
سنقاتل بكلّ ما لدينا
!أيّها القراصنة الأوغاد

114
00:09:04,780 --> 00:09:09,390
فهمت. وضعتم ساحة القتال تلك
.لكي لا يتأذّى المطعم بحدّ ذاته

115
00:09:10,160 --> 00:09:13,760
،ذلك يناسبنا نحن أيضًا
.فتلك السّفينة ستصبح لنا

116
00:09:13,760 --> 00:09:17,400
.أصبحت أرغب بهذه السّفينة أكثر

117
00:09:18,360 --> 00:09:21,200
!لن نسمح لك بأخذ هذا المطعم

118
00:09:21,200 --> 00:09:23,900
!هذا صحيح! لا تستخفّ بنا

119
00:09:23,900 --> 00:09:26,100
!نحن طبّاخون مقاتلون

120
00:09:33,880 --> 00:09:37,920
أبحروا! سلاح معارك باراتيي
!البحريّ، رأس الإسقمريّ 1

121
00:09:37,920 --> 00:09:41,850
،إن كنتم لا تريدون الموت
!فغادروا المكان حالًا

122
00:09:45,420 --> 00:09:47,020
ما ذلك الشّيء؟

123
00:09:47,020 --> 00:09:49,360
!هذا رائع! أنا أريده

124
00:09:49,360 --> 00:09:51,360
!جذّف بسرعة أعلى

125
00:09:51,360 --> 00:09:51,900
!أبذلُ جهدي

126
00:09:53,860 --> 00:09:55,370
!نار

127
00:10:00,370 --> 00:10:02,240
!أشعر بالغثيان

128
00:10:03,870 --> 00:10:05,540
!أجل! عمل ممتاز

129
00:10:05,540 --> 00:10:08,680
!باتي! كارني! فلتنالا منهم

130
00:10:10,880 --> 00:10:12,350
!إنّهما بارعان

131
00:10:14,280 --> 00:10:17,550
!لا تشح نظرك! نحن نصوّب نحوه

132
00:10:18,250 --> 00:10:19,320
!أجل

133
00:10:19,320 --> 00:10:22,090
!كريغ! استعدّ

134
00:10:22,630 --> 00:10:28,060
شاهدوا كم أنّ سلاح معارك
!مطعم باراتيي البحريّ قويّ

135
00:10:37,740 --> 00:10:40,040
ماذا؟ هل اصطدمنا بشيء ما؟

136
00:10:40,040 --> 00:10:42,040
!ماذا؟ لا يمكننا التّحرّك

137
00:10:43,680 --> 00:10:45,710
!أنا الدّون كريغ

138
00:10:46,550 --> 00:10:49,050
!أنا الرّجل الّذي سيحكم محيطات العالم

139
00:10:49,050 --> 00:10:51,020
!أخبرتك أنّ ذلك هدفي أنا

140
00:10:52,150 --> 00:10:54,660
!لا وقت لديّ لإضاعته مع ألعابكم

141
00:11:00,030 --> 00:11:02,100
!ما هذه القوّة الجبّارة

142
00:11:10,670 --> 00:11:12,940
!إنّها قادمة ناحيتنا

143
00:11:12,940 --> 00:11:15,510
!سيُدمّر المطعم

144
00:11:32,960 --> 00:11:34,060
!سانجي

145
00:11:34,960 --> 00:11:35,660
!بساقه؟

146
00:12:02,760 --> 00:12:04,920
!يا-يا لها من ساق قويّة

147
00:12:04,920 --> 00:12:07,730
!لقد ركل ذلك القارب الغريب

148
00:12:08,430 --> 00:12:10,060
...تقنية السّاق تلك

149
00:12:10,060 --> 00:12:12,030
!تلك هي ركلة سانجي

150
00:12:12,030 --> 00:12:13,330
!إنّه بارع

151
00:12:17,700 --> 00:12:19,340
!أيّها الوغد سانجي

152
00:12:19,340 --> 00:12:21,270
هل تحاول تحطيم حلفائك؟

153
00:12:21,270 --> 00:12:22,240
...نعم

154
00:12:22,240 --> 00:12:24,910
!لا تجب بـ"نعم" أيّها الحساء المجنون

155
00:12:25,480 --> 00:12:29,750
كدتَ تفقد مساعدين أقوياء
!أيّها المعكرونة الغبيّة

156
00:12:30,420 --> 00:12:35,390
هل تعتقدون فعلًا أنّ لديكم
وقتًا للمزاح أيّها الطّبّاخون؟

157
00:12:36,460 --> 00:12:38,090
!لننل منهم

158
00:12:53,940 --> 00:12:56,540
.يبقى الطبّاخ طبّاخًا وإن حمل سلاحًا

159
00:12:56,540 --> 00:13:00,010
نحن مقاتلون ذوو خبرة
.في مستوى مختلف تمامًا عنكم

160
00:13:00,010 --> 00:13:04,350
لذلك أحسنوا التّصرّف أيّها الطّبّاخون
.وجدوا لكم مطعمًا على البرّ

161
00:13:04,350 --> 00:13:08,250
يا هؤلاء! لماذا تسمحون لهم
!بهزيمتكم بسهولة؟

162
00:13:08,250 --> 00:13:10,220
!أما زلتم تسمّون أنفسكم طبّاخين مقاتلين؟

163
00:13:11,260 --> 00:13:12,720
!إنّهم أقوياء أيضًا

164
00:13:12,720 --> 00:13:15,190
إنّهم مختلفون تمامًا
!عمّن قاتلناهم من قبل

165
00:13:15,190 --> 00:13:19,030
لا تضعونا في نفس الكفّة
.مع القراصنة العاديّين

166
00:13:19,030 --> 00:13:23,170
نحن قراصنة كريغ
.المسيطر على الأزرق الشّرقيّ

167
00:13:23,170 --> 00:13:29,140
أعلنوا لهم فحسب... أنّ هذه السّفينة
!أمست ملك قراصنة دون كريغ سلفًا

168
00:13:29,710 --> 00:13:31,470
.لا تسئ الفهم

169
00:13:32,040 --> 00:13:35,010
لن نسمح لكم بخطو خطوة
.واحدة في المطعم

170
00:13:35,480 --> 00:13:37,280
!إنّه محقّ تمامًا

171
00:13:42,020 --> 00:13:44,450
.أنا طبّاخ لأزيد من عشر سنوات

172
00:13:44,450 --> 00:13:46,690
.زرت 300 مطعمًا

173
00:13:46,690 --> 00:13:49,990
طُردتُ لتسبّبي بالشّجارات
.طوال الوقت وعشت حياة قاسية

174
00:13:50,390 --> 00:13:51,990
...هذا هو المكان الّذي

175
00:13:51,990 --> 00:13:54,460
لجأنا له أخيرًا بعد مرورنا
...من مطعم لآخر

176
00:13:55,360 --> 00:13:57,230
!هل من أحد هناك؟

177
00:13:57,230 --> 00:14:00,700
هل هذا هو المطعم الّذي يديره
!السّاق الحمراء زيف؟

178
00:14:00,700 --> 00:14:03,440
من الأفضل أن يكون شرط
!مطلوب طبّاخون لعناء" صحيحًا"

179
00:14:07,780 --> 00:14:09,950
.نعم، إنّه صحيح

180
00:14:12,450 --> 00:14:16,450
سواء كانوا مجرمين خطيرين
،أو هاربين من السّجن

181
00:14:16,450 --> 00:14:21,060
إن أرادوا الأكل بشدّة
،وعثروا على هذا المطعم

182
00:14:21,060 --> 00:14:27,500
!فسنطعمهم إلى أن يشبعوا
!هل بإمكانكما تحمّل ذلك؟

183
00:14:27,500 --> 00:14:28,860
!حا-حاضر

184
00:14:35,040 --> 00:14:37,770
!لا يمكننا تقديم حساء قذر كهذا للزّبائن

185
00:14:38,310 --> 00:14:39,940
!لماذا ضربتني؟

186
00:14:39,940 --> 00:14:41,580
!تلك علامة على العزيمة

187
00:14:41,580 --> 00:14:43,040
!اخرس

188
00:14:43,040 --> 00:14:46,810
...الشّجار... الطّبخ
.مسموح لنا فعل ما يحلو لنا

189
00:14:46,810 --> 00:14:49,850
.لا يوجد مطعم آخر أفضل من هذا

190
00:14:49,850 --> 00:14:53,020
سمعتهما. أتدرك الآن يا كريغ؟

191
00:14:53,650 --> 00:14:57,560
تكريس أنفسنا للطّبخ كلّ يوم
.يُعتبر معركة حامية

192
00:14:57,560 --> 00:15:02,000
مقارنة بذلك، فالقراصنة الّذين
!نواجههم اليوم لا شيء

193
00:15:02,460 --> 00:15:03,460
!إنّه محقّ

194
00:15:03,460 --> 00:15:04,630
!فلنقاتل

195
00:15:04,630 --> 00:15:05,170
!أجل

196
00:15:05,170 --> 00:15:06,300
!احموا المالك

197
00:15:06,300 --> 00:15:07,630
!احموا المطعم

198
00:15:20,410 --> 00:15:21,580
...ذ-ذلك

199
00:15:29,790 --> 00:15:32,490
ما الّذي تفعلونه يا هؤلاء؟

200
00:15:34,160 --> 00:15:35,730
من يكون هذا؟

201
00:15:38,800 --> 00:15:40,930
!أنا جدار حصين! أي أنّني منيع

202
00:15:40,930 --> 00:15:43,700
أنا رجل الدّرع المنيع في قراصنة كريغ

203
00:15:44,240 --> 00:15:46,340
!وبيرل-سان هو اسمي

204
00:15:46,910 --> 00:15:48,040
!بيرل-سان

205
00:15:48,540 --> 00:15:51,010
!باتي! كارني! هل أنتما بخير؟

206
00:15:51,410 --> 00:15:57,980
إنّهما ليسا بخير لأنّهما تلقّيا لكمتي
."القاتلة المسمّاة "هديّة بيرل

207
00:16:00,090 --> 00:16:04,060
!انظروا، انظروا! هذه سكّين جيّدة
.سوف آخذها

208
00:16:04,060 --> 00:16:09,830
!ماذا؟ اتركها. أعطني إيّاها
!اتركها أيّها الفاشل

209
00:16:22,540 --> 00:16:25,340
!لديه ركلات جيّدة بالفعل

210
00:16:25,340 --> 00:16:27,980
!لم يحز على إعجابي من فراغ

211
00:16:27,980 --> 00:16:30,510
.سكّين المطبخ هي روح الطبّاخ

212
00:16:30,510 --> 00:16:33,950
!لا تحاولوا لمسها بتهوّر أيّها الهواة

213
00:16:34,650 --> 00:16:35,690
...سانجي

214
00:16:36,350 --> 00:16:38,490
.أمسك بهذه جيّدًا وابق مستلقيًا

215
00:16:39,490 --> 00:16:41,390
.سأهتمّ بأمرهم

216
00:16:41,860 --> 00:16:44,860
!لن نسمح لطبّاخ وضيع بهزيمتنا

217
00:16:53,040 --> 00:16:57,440
أقلتم طبّاخ وضيع؟ سأقطّعكم
!لثلاث قطع أيّها الأوغاد

218
00:16:59,110 --> 00:17:02,280
يا لوقاحتك لهزيمتهم
.باستعمال ركلاتك فحسب

219
00:17:02,280 --> 00:17:03,980
أتلك سياستك؟

220
00:17:04,550 --> 00:17:08,920
.اليدان عنصر مهمّ لأيّ طبّاخ
.لا يمكنني إيذاؤهما في المعارك

221
00:17:09,720 --> 00:17:11,950
.سأطيح بك بساقي هذه أيضًا

222
00:17:11,950 --> 00:17:14,960
.تطيح بي؟ هذا مستحيل

223
00:17:14,960 --> 00:17:19,860
أنا رجل منيع فاز بكلّ معاركي
.الواحدة والسّتّين بدون خدوش

224
00:17:20,660 --> 00:17:27,000
،لم أنزف أبدًا في معركة
.ولو قطرة واحدة

225
00:17:27,570 --> 00:17:30,210
الفوز بلا أيّة خدوش
.هو دليل واضح على قوّتي

226
00:17:32,270 --> 00:17:36,850
.أنا رجل درع كلّي أناقة
أوليست هذه لباقة؟

227
00:17:37,510 --> 00:17:40,320
هل كان يفترض بتلك أن تكون
.مزحة؟ لم تكن مضحكة

228
00:17:40,320 --> 00:17:42,220
!يا فتى قبّعة القشّ

229
00:17:42,220 --> 00:17:43,990
!سوف تتعرّض للأذى إن لم تنتبه

230
00:17:50,690 --> 00:17:54,000
حتّى مدافع السّفن الحربيّة
.لا تنفع ضدّي

231
00:17:54,000 --> 00:17:55,660
!أخرج سالمًا معافى من أيّ هجوم

232
00:17:58,900 --> 00:18:02,870
.يا إلهي، فاجأني ذلك
.من الجيّد أنّني لم أسقط في البحر

233
00:18:08,040 --> 00:18:10,510
.هذا سيّئ

234
00:18:10,510 --> 00:18:11,950
!دماء! مصيبة

235
00:18:11,950 --> 00:18:13,480
.لا تقلق يا بيرل-سان

236
00:18:13,880 --> 00:18:15,480
!إنّه مجرّد نزيف أنف

237
00:18:15,480 --> 00:18:17,450
!هذا ليس جرحًا من معركة

238
00:18:17,920 --> 00:18:20,320
!هدّئ من روعك يا بيرل-سان

239
00:18:20,320 --> 00:18:20,920
ماذا يحدث؟

240
00:18:21,390 --> 00:18:23,890
!هـ-هـ-هؤلاء خطيرون

241
00:18:24,560 --> 00:18:26,830
.ماذا حدث له؟ يتصرّف بغرابة

242
00:18:26,830 --> 00:18:29,360
ما قصّة نزيف أنفه؟

243
00:18:32,500 --> 00:18:36,800
!توقّف يا بيرل! إنّه مجرّد نزيف أنف
!لا تفقد أعصابك

244
00:18:39,310 --> 00:18:41,270
ما الّذي ينوي فعله؟

245
00:18:41,770 --> 00:18:47,250
!خطر! خطر! خطر

246
00:18:50,980 --> 00:18:52,820
!كلاّ! لقد بدأ

247
00:18:52,820 --> 00:18:55,950
!إنّ بيرل-سان يشتعل عندما يغضب

248
00:18:55,950 --> 00:18:56,920
ماذا؟

249
00:18:56,920 --> 00:19:04,900
!لآلئ النّار... المعروف الكبير

250
00:19:05,360 --> 00:19:06,870
!هذا ساخن

251
00:19:06,870 --> 00:19:09,730
!بيرل-سان! توقّف رجاءً

252
00:19:11,840 --> 00:19:15,710
،احترقوا! بلهيبي هذا ودرعي الملتهب

253
00:19:15,710 --> 00:19:17,810
!لا فكرة لكم كم أنا منيع

254
00:19:19,680 --> 00:19:23,780
ذلك الغبيّ! هل سيحرق السّفينة
الّتي نستولي عليها بأكملها؟

255
00:19:25,280 --> 00:19:26,650
!سُحقًا

256
00:19:28,250 --> 00:19:32,290
تبًّا! لا مهرب من بحر من اللّهب
!وفي عرض البحر

257
00:19:32,290 --> 00:19:34,630
!هذا سيّئ! سيحترق المطعم

258
00:19:35,290 --> 00:19:37,600
سيحترق هذا المطعم؟

259
00:19:37,600 --> 00:19:38,730
!احترق! احترق

260
00:19:38,730 --> 00:19:39,900
!أيّها الوغد

261
00:19:39,900 --> 00:19:42,530
!غبيّ! ستحترق يا سانجي

262
00:19:43,430 --> 00:19:47,400
...لن أسمح لك ببساطة
!أن تحرق هذا المطعم

263
00:19:51,480 --> 00:19:53,740
!إ-إنّه متهوّر جدًّا

264
00:19:53,740 --> 00:19:55,380
!هل يريد أن يتحوّل لشعلة بشريّة؟

265
00:19:56,010 --> 00:19:58,850
حتّى الحيوانات الضّارية تقرّر
...البقاء بعيدة عن لآلئي النّاريّة

266
00:20:01,050 --> 00:20:04,820
أيّها الغبيّ! لن أكون طبّاخًا جديرًا
!إن كنتُ أخاف من ألسنة اللّهب

267
00:20:04,820 --> 00:20:09,260
!سـ-سحقًا! يا له من رجل لبق

268
00:20:10,330 --> 00:20:11,090
!ها أنا ذا

269
00:20:15,060 --> 00:20:17,070
!أصابته مباشرة

270
00:20:17,070 --> 00:20:19,540
تمكّن من إسقاط
!بيرل-سان رغم درعه المنيع

271
00:20:24,540 --> 00:20:28,010
ما بال هذا الطّبّاخ؟
.إنّه خطير

272
00:20:28,010 --> 00:20:30,950
!أ-أ-أيّها الوغد

273
00:20:30,950 --> 00:20:33,020
!النّار! أحتاج نارًا أكثر

274
00:20:33,020 --> 00:20:35,420
!عليّ إطعام لآلئي النّاريّة أكثر

275
00:20:36,950 --> 00:20:39,020
!سيحترق المطعم

276
00:20:39,020 --> 00:20:42,420
،إن وصلت النّيران للمطبخ
!فسينفجر المطعم

277
00:20:42,420 --> 00:20:46,430
!أيّها المالك! اهرب رجاءً أيّها المالك

278
00:20:57,640 --> 00:21:00,610
...لآ-لآلئي النّاريّة

279
00:21:00,610 --> 00:21:03,080
!هذا أشبه بلعب أطفال

280
00:21:03,540 --> 00:21:06,050
!أطفأت الرّياح من ركلته النّيران

281
00:21:06,050 --> 00:21:08,450
!ماذا؟! لا بدّ أنّها تقنيّة مقدّسة

282
00:21:08,450 --> 00:21:11,020
أما زالت قوّة السّاق الحمراء
!زيف كسابق عهدها؟

283
00:21:11,520 --> 00:21:13,990
!العمّ مذهل! أثار إعجابي فعلًا

284
00:21:21,960 --> 00:21:25,200
،بما أنّ الأمر آل لهذا الحال
فسأغرقكم مع تلك الزّعانف

285
00:21:25,200 --> 00:21:28,570
!قبل أن يشتعل المطعم

286
00:21:31,440 --> 00:21:33,810
!سانجي! انتبه

287
00:21:34,240 --> 00:21:36,780
!كلاّ! إنّ النّيران تحاصره

288
00:21:41,010 --> 00:21:42,250
...هذا ساخن

289
00:21:42,250 --> 00:21:43,120
!الفتى العامل

290
00:21:43,550 --> 00:21:46,750
!فاكهة المطّاط... البازوكا

291
00:21:48,590 --> 00:21:51,060
أعاد تلك الكرة الحديديّة
!من حيث جاءت

292
00:21:51,060 --> 00:21:53,560
!هذا ساخن، ساخن

293
00:22:07,440 --> 00:22:10,440
!هُزم بيرل-سان تمامًا الآن

294
00:22:10,440 --> 00:22:12,410
...بيرل-سان قد

295
00:22:12,410 --> 00:22:14,210
ماذا؟

296
00:22:14,210 --> 00:22:15,880
.واضح أنّه غبيّ

297
00:22:16,450 --> 00:22:18,320
...أغبياء في كلّ مكان

298
00:22:18,320 --> 00:22:20,850
.لا يمكنني الاعتماد على أيّ أحد

299
00:22:26,990 --> 00:22:29,760
.ستنتهي هذه المعركة هنا

300
00:22:35,370 --> 00:22:40,170
!أجل! أطلق النّار على السّاق الحمراء زيف

301
00:22:40,170 --> 00:22:43,810
،كلّ ما نحتاجه هو قتله
!وسيصبح المطعم لنا

302
00:22:55,790 --> 00:23:10,030
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

303
00:23:10,030 --> 00:23:16,970
ولطالما بحثت عن ذلك المكان الإعجازيّ

304
00:23:16,970 --> 00:23:24,150
لكي لا يسبقني أحد آخر إليه

305
00:23:26,680 --> 00:23:38,160
إن كان العالم سيتغيّر

306
00:23:38,160 --> 00:23:45,170
قبل أن أحقّق حلمي

307
00:23:45,170 --> 00:23:52,240
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

308
00:23:52,240 --> 00:24:05,620
لكي لا تمحى ذكرياتي

309
00:24:11,030 --> 00:24:13,330
!مستحيل أن أسمح لهم بأخذ المطعم

310
00:24:13,330 --> 00:24:16,830
!من الدّناءة أخذ رهينة
!سأوسع ذلك الوغد ضربًا

311
00:24:16,830 --> 00:24:19,530
!لا تتدخّل أيّها الفتى العامل
!أبق يديك بعيدًا عن هذا

312
00:24:19,530 --> 00:24:21,200
هل يمكنني استعمال ساقيّ إذًا؟

313
00:24:21,200 --> 00:24:24,110
سأقطّعك لثلاثة قطع
!يا قبّعة القشّ اللّعين

314
00:24:24,110 --> 00:24:28,210
لن أسمح لهدف ذلك العجوز اللّعين
!في الحياة أن يُسلب منه

315
00:24:28,210 --> 00:24:29,540
:في الحلقة القادمة من ون بيس

316
00:24:29,540 --> 00:24:32,680
،حلم زيف وسانجي"
"أول بلو الوهميّ

317
00:24:32,680 --> 00:24:35,120
!ملك القراصنة، لن يكون إلاّ أنا