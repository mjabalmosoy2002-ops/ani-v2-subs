1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,770 --> 00:02:01,940
.كان كانجورو هو جاسوس العدوّ

29
00:02:02,340 --> 00:02:07,530
اختُطف مومونوسكي وبدت أنّ خطّة
،كينييمون والبقيّة قد فشلت

30
00:02:07,530 --> 00:02:10,490
.لكنّ كيوشيرو الغافي حضر

31
00:02:17,390 --> 00:02:23,210
تضمّ عائلة كيوشيرو 200 محارب
!ونودّ مساعدتكم في غارتكم

32
00:02:23,510 --> 00:02:24,920
!هل أنت دنجيرو؟

33
00:02:32,950 --> 00:02:37,480
!بإضافة 1200 من محاربينا، صرنا 5400 في المجمل

34
00:02:37,480 --> 00:02:40,020
!والآن، هيّا بنا جميعًا

35
00:02:40,020 --> 00:02:43,540
!كلاّ! لم يتغيّر أيّ شيء

36
00:02:43,540 --> 00:02:45,490
!هيّا بنا إلى أونيغاشيما

37
00:02:45,490 --> 00:02:48,490
!لنثأر لموت أودن-ساما معًا

38
00:02:56,220 --> 00:03:00,460
"!وعد بدموع! مومونوسكي المختطَف"

39
00:03:02,000 --> 00:03:03,840
!كاواماتسو

40
00:03:03,840 --> 00:03:05,340
!مومونوسكي-ساما

41
00:03:08,550 --> 00:03:11,010
!مومونوسكي-ساما

42
00:03:14,990 --> 00:03:16,940
!النّجدة

43
00:03:16,940 --> 00:03:22,050
!أنا خائف! أنزلني

44
00:03:22,320 --> 00:03:23,940
!مهلاً

45
00:03:23,940 --> 00:03:25,420
!مومونوسكي-ساما

46
00:03:25,420 --> 00:03:28,170
!كانجورو من الأكازايا خاننا

47
00:03:28,170 --> 00:03:30,030
!مومونوسكي-ساما

48
00:03:30,030 --> 00:03:31,370
!لماذا؟

49
00:03:34,330 --> 00:03:36,160
!ساعدوني

50
00:03:40,600 --> 00:03:43,150
!مومونوسكي-ساما

51
00:03:54,060 --> 00:03:56,050
هل أنت بخير يا شينوبو؟

52
00:03:56,050 --> 00:03:58,640
!انس أمري وأنقذ مومونوسكي-ساما

53
00:04:00,700 --> 00:04:03,170
!اللّعنة عليك يا كانجورو

54
00:04:07,820 --> 00:04:12,550
كان كانجورو الجاسوس، صحيح يا روبين-تشان؟

55
00:04:12,550 --> 00:04:15,720
!أظنّ ذلك. علينا مساعدة مومو-تشان

56
00:04:15,720 --> 00:04:17,480
!ماذا؟

57
00:04:24,210 --> 00:04:25,800
!لوفي

58
00:04:25,800 --> 00:04:28,970
!كان كانجورو هو جاسوس العدوّ

59
00:04:28,970 --> 00:04:31,360
!إنّه يختطف مومو

60
00:04:31,360 --> 00:04:33,970
!ماذا؟! أأنت واثق؟

61
00:04:33,970 --> 00:04:37,100
!هل يعني ذلك أنّه كان يخدعنا؟

62
00:04:38,660 --> 00:04:40,640
!ذلك الوغد

63
00:04:44,560 --> 00:04:46,980
!إنّه يطير نحو الغيوم

64
00:04:46,980 --> 00:04:48,570
!سأطلق عليه لإسقاطه

65
00:04:49,960 --> 00:04:51,450
!القتل المؤكّد

66
00:04:51,450 --> 00:04:54,780
!النّجم الأخضر: شوريكن الصّنار

67
00:05:01,140 --> 00:05:03,830
.أنا آسف

68
00:05:33,990 --> 00:05:38,140
!النّجدة

69
00:05:43,120 --> 00:05:47,110
...لا وقت لدي لكم أيّها الحمقى

70
00:06:02,390 --> 00:06:04,270
!ما هذه الغيمة؟

71
00:06:04,270 --> 00:06:07,480
!كلاّ يا سانجي-دونو! عد

72
00:06:07,480 --> 00:06:08,820
!يراودني شعور سيّئ حيال هذا

73
00:06:10,690 --> 00:06:13,750
...سيستعمل تقنية أخرى لم نرها من قبل

74
00:06:13,750 --> 00:06:16,350
!غيوم الحبر

75
00:06:26,180 --> 00:06:28,460
!فلتنزل عليكم سهام الحبر كالمطر

76
00:06:43,120 --> 00:06:46,270
!رسم الأوكيو: وابل المساء

77
00:06:52,690 --> 00:06:55,740
!أديروا الدّفّة! ابتعدوا عن الغيمة

78
00:07:02,180 --> 00:07:02,910
!هذا مؤلم

79
00:07:02,910 --> 00:07:04,290
!تشوبّر، من هنا

80
00:07:04,290 --> 00:07:04,870
!حاضر

81
00:07:04,870 --> 00:07:07,460
!ما الّذي تفعله بسفينتي ساني؟

82
00:07:20,700 --> 00:07:21,900
!كلاّ

83
00:07:21,900 --> 00:07:23,220
!نامي-سان

84
00:07:26,680 --> 00:07:30,900
الوحيد المسموح له برمي سهم عبر
...قلبَيْ نامي-سان وروبين-تشان

85
00:07:30,980 --> 00:07:33,940
!هو أنا

86
00:07:33,940 --> 00:07:35,490
!سانجي

87
00:07:37,860 --> 00:07:40,870
!توقّف يا كانجورو

88
00:07:40,870 --> 00:07:44,300
!سيموتون جميعًا

89
00:07:44,300 --> 00:07:45,580
...هذا صحيح

90
00:07:46,180 --> 00:07:48,580
...سيموتون جميعًا

91
00:07:49,100 --> 00:07:50,670
!أخيرًا

92
00:07:54,940 --> 00:07:58,030
!أعتمد عليكم يا رفاق

93
00:07:59,820 --> 00:08:05,160
!افتحوا بلاد وانو

94
00:08:08,870 --> 00:08:11,680
،والدك أودن

95
00:08:11,680 --> 00:08:15,730
،حمل أملاً كاذبًا هو ووالدتك توكي

96
00:08:15,730 --> 00:08:21,010
وبالكاد سمح ذلك لهؤلاء بالإفلات
...من الموت لعشرين سنة

97
00:08:24,430 --> 00:08:31,580
على أيّ حال، من المضحك أنّ الشّخص الّذي يقود
محاربي السّاموراي الأقوياء السّاعين للانتقام أولئك

98
00:08:31,580 --> 00:08:38,200
.هو صبيّ خجول أبله يخاف المرتفعات

99
00:09:24,940 --> 00:09:27,910
!كم هذا مضحك

100
00:09:32,990 --> 00:09:35,550
...أعلم

101
00:09:37,920 --> 00:09:41,920
...أنا لستُ كوزكي أودن

102
00:09:41,920 --> 00:09:44,660
!أعرف ذلك حقّ المعرفة

103
00:09:49,260 --> 00:09:52,080
...ماذا عليّ فعله؟! لا أقوى على فعل شيء

104
00:09:56,890 --> 00:09:59,190
...ليساعدني أحد ما

105
00:09:59,190 --> 00:10:01,420
!هل أنت مجرّد قائد شكليّ يا مومو؟

106
00:10:03,270 --> 00:10:04,810
!توكي

107
00:10:04,810 --> 00:10:06,510
!مومونوسكي

108
00:10:06,510 --> 00:10:07,850
!هيوري

109
00:10:08,780 --> 00:10:13,560
!أشتاق إليكم جميعًا أيضًا

110
00:10:27,760 --> 00:10:30,870
...ما كان الأودن ليُسمّى أودن

111
00:10:36,620 --> 00:10:38,550
!قلها

112
00:10:38,550 --> 00:10:41,000
!ظننتُ أنّك شخص مهمّ

113
00:10:41,000 --> 00:10:44,300
!أنت قائد هؤلاء الرّجال العظماء، صحيح؟

114
00:10:46,050 --> 00:10:48,680
!هل ستبكي فحسب؟

115
00:10:56,580 --> 00:11:00,590
!نتشارك جميعنا أمنية واحدة

116
00:11:01,620 --> 00:11:05,300
!استعادة بلاد وانو

117
00:11:05,740 --> 00:11:09,850
...أنا الوريث لعرض دايميو بلاد وانو

118
00:11:10,840 --> 00:11:13,450
!كوزكي مومونوسكي

119
00:11:13,450 --> 00:11:16,040
!الآن هو الوقت المناسب للنّهوض

120
00:11:33,570 --> 00:11:36,830
...أ

121
00:11:37,870 --> 00:11:40,940
!ما الّذي أحاول قوله؟

122
00:11:40,940 --> 00:11:45,340
!إن قلتُ شيئًا كهذا، فلن يساعدني أيّ أحد

123
00:11:46,340 --> 00:11:47,490
...لكن

124
00:11:54,260 --> 00:11:56,200
!أيّها الرّفاق

125
00:11:56,200 --> 00:12:01,000
!أيمكنكم سماعي؟

126
00:12:01,770 --> 00:12:03,340
!مومونوسكي-ساما

127
00:12:04,190 --> 00:12:08,920
!كفّوا عن القلق حيالي جميعكم

128
00:12:09,820 --> 00:12:14,410
!هذا بالضّبط ما يسعون إليه

129
00:12:15,180 --> 00:12:18,980
!أستطيع الهرب من تلقاء نفسي

130
00:12:18,980 --> 00:12:25,360
،لذلك أريدكم أن تطيحوا بكايدو وأوروتشي
!وتنقذوا بلاد وانو

131
00:12:30,920 --> 00:12:35,660
!يا لها من كلمات مؤثّرة ونبيلة

132
00:12:36,180 --> 00:12:38,190
!مومونوسكي-ساما

133
00:12:40,220 --> 00:12:42,370
!مومونوسكي-ساما

134
00:12:42,770 --> 00:12:46,250
!لا أصدّق أنّ مومو وقف وقفة رجل

135
00:12:48,940 --> 00:12:51,160
!هذا صحيح يا مومو

136
00:12:51,970 --> 00:12:53,430
...أنت

137
00:12:54,030 --> 00:12:57,220
،مجرّد شقيّ غبيّ جبان

138
00:12:57,220 --> 00:13:01,290
لكنّك تأمر من حولك دائمًا
!أيّها القصير ذو القنزعة المضحكة

139
00:13:01,290 --> 00:13:04,410
!كيف أمكنك الحديث بفظاظة هكذا عن مومونوسكي-ساما؟

140
00:13:04,410 --> 00:13:07,070
!من ذلك الوغد؟! قطّعوه لأشلاء

141
00:13:07,630 --> 00:13:09,940
!انجُ كيفما تستطيع

142
00:13:09,940 --> 00:13:14,600
!سآتي لإنقاذك

143
00:13:19,550 --> 00:13:20,960
!لأنّك صديقي

144
00:14:01,760 --> 00:14:03,150
...حسنًا

145
00:14:05,930 --> 00:14:08,290
!لنذهب إلى أونيغاشيما

146
00:14:08,290 --> 00:14:10,360
!أجل

147
00:14:40,470 --> 00:14:41,990
!لوفي

148
00:14:41,990 --> 00:14:45,310
!إحدى سفن العدوّ تهرب

149
00:14:46,100 --> 00:14:47,500
!دعوها

150
00:14:47,500 --> 00:14:52,200
نحن ذاهبون في ذلك الاتّجاه في كلّ
!الأحوال، بإمكاننا إغراقها لاحقًا

151
00:14:52,710 --> 00:14:55,400
.ماذا؟! ظننتُ أنّه كانت هنالك سفينة أخرى

152
00:14:55,400 --> 00:14:57,990
.نعم، أغرقتها سلفًا

153
00:15:03,430 --> 00:15:05,290
!لنواصل التّقدّم

154
00:15:07,410 --> 00:15:09,190
!مومو ينتظرنا

155
00:15:10,830 --> 00:15:13,900
!كين-ساما، أنا آسفة

156
00:15:13,900 --> 00:15:15,880
!كان يفترض بي إنقاذه

157
00:15:15,880 --> 00:15:18,030
.أنا سعيد أنّك بخير

158
00:15:18,030 --> 00:15:21,340
.لا أعتقد أنّهم سيقتلون مومونوسكي-ساما بعد

159
00:15:21,340 --> 00:15:23,300
!أنا جدّ آسفة

160
00:15:23,300 --> 00:15:24,620
.لا داعي للأسف

161
00:15:30,960 --> 00:15:33,380
!دنجيرو، أنا سعيد لرؤيتك ثانية

162
00:15:33,380 --> 00:15:37,900
لا أصدّق أنّ كيوشيرو شائن السّمعة
!كان أنت يا دنجيرو-سان

163
00:15:37,900 --> 00:15:40,340
!بالمناسبة يا دنجيرو

164
00:15:40,340 --> 00:15:42,040
...ماذا

165
00:15:42,220 --> 00:15:44,870
!حلّ بوجهك؟

166
00:15:46,160 --> 00:15:48,090
تقصد هذا؟

167
00:15:49,350 --> 00:15:52,230
!أودن-ساما! توكي-ساما

168
00:16:08,100 --> 00:16:10,420
.إنّها قصّة طويلة

169
00:16:12,310 --> 00:16:14,630
!أنا سعيد برؤيتكم جميعًا

170
00:16:14,630 --> 00:16:17,800
!يا رفاق! هل أنتم بخير جميعًا؟

171
00:16:17,800 --> 00:16:21,970
!ثمّة بعض الإصابات والسّفن المحطّمة

172
00:16:22,700 --> 00:16:25,320
!نحن بخير! لا توجد مشاكل

173
00:16:25,320 --> 00:16:27,680
!لنتّجه صوب الجزيرة الآن

174
00:16:27,680 --> 00:16:31,310
!لا نريد أن نموت في البحر

175
00:16:31,310 --> 00:16:32,190
!اسمعوا

176
00:16:33,500 --> 00:16:36,730
!هذا ليس مخيّمًا للسّاموراي

177
00:16:36,730 --> 00:16:38,190
!أبعدوا قاربكم أيضًا

178
00:16:42,010 --> 00:16:43,970
!شكرًا على استضافتنا

179
00:16:43,970 --> 00:16:46,870
!أنا لا أستضيفكم! انزلوا

180
00:16:47,600 --> 00:16:49,160
!يا رفاق

181
00:16:49,470 --> 00:16:52,100
!لا تدعوا طاقم قبّعة القشّ يسبقنا

182
00:16:52,100 --> 00:16:53,940
!أجل

183
00:16:59,690 --> 00:17:01,990
!ماذا؟! من أين أتت؟

184
00:17:04,010 --> 00:17:06,410
!إنّها من السّفينة الّتي هربت

185
00:17:15,690 --> 00:17:17,360
!مدفع مدى بعيد؟

186
00:17:17,360 --> 00:17:20,150
!كانوا يحاولون الحفاظ على مسافة بيننا

187
00:17:20,150 --> 00:17:22,950
!كيف يستطيعون إصابتنا من تلك المسافة؟

188
00:17:28,080 --> 00:17:32,000
!الأسلحة المصنوعة في بلاد وانو ممتازة

189
00:17:32,000 --> 00:17:35,210
،بفضل مصانع الأسلحة في بلاد وانو

190
00:17:35,210 --> 00:17:40,710
!لدينا نحن قراصنة مملكة الحيوان مختلف الأسلحة

191
00:17:40,710 --> 00:17:45,300
!تعالوا محلّقين صوبنا كما فعلتم سابقًا

192
00:17:50,820 --> 00:17:53,770
!دافعوا عن السّفينة! نحن قريبون جدًّا

193
00:18:05,030 --> 00:18:08,200
...سُحقًا! ظننت أنّهم هربوا بسهولة

194
00:18:10,790 --> 00:18:14,000
!إلى الأمام بأقصى سرعة! علينا الاقتراب أكثر

195
00:18:17,270 --> 00:18:21,530
!لا أهتمّ كم من سفن السّاموراي ستغرق

196
00:18:48,030 --> 00:18:51,850
...كلاّ! إن حافظوا على هذه المسافة

197
00:18:52,790 --> 00:18:55,000
!سنغرق جميعًا

198
00:19:12,240 --> 00:19:14,220
!انتهى الأمر الآن

199
00:19:14,580 --> 00:19:17,390
!لا يسعهم فعل أيّ شيء

200
00:19:27,910 --> 00:19:29,870
!أطلقوا! أطلقوا

201
00:19:34,540 --> 00:19:38,120
!كاراتي البرمائيّين

202
00:19:38,120 --> 00:19:40,960
!موجة الرّمح

203
00:19:59,410 --> 00:20:00,770
!ثمّة ثقب في السّفينة

204
00:20:00,770 --> 00:20:01,580
!النّجدة

205
00:20:01,580 --> 00:20:02,610
!سأقع

206
00:20:08,300 --> 00:20:11,620
!كاراتي البرمائيّين

207
00:20:11,620 --> 00:20:16,160
!موجة الرّمح: موراسامي

208
00:20:26,670 --> 00:20:28,970
!...المدفع بعيد المدى

209
00:20:32,280 --> 00:20:34,510
.حدث أمر ما

210
00:20:34,510 --> 00:20:37,430
...ربّما هي أشباح الرُّضّع الغارقين

211
00:20:37,430 --> 00:20:40,060
...تقوم بقتلهم

212
00:20:40,060 --> 00:20:43,060
!بدا ذلك مسالمًا أكثر ممّا يحدث

213
00:20:43,060 --> 00:20:44,520
!ما الّذي يحدث؟

214
00:21:05,810 --> 00:21:07,210
أهنالك أحد ما؟

215
00:21:20,870 --> 00:21:22,690
!إلى كلّ الموجودين

216
00:21:23,160 --> 00:21:25,650
!أعيروني مسامعكم

217
00:21:28,830 --> 00:21:32,110
...وُلدتُ في بلاد في قاع البحر

218
00:21:32,110 --> 00:21:37,330
.في حيّ البرمائيّين من مملكة تُدعى ريوغو

219
00:21:40,100 --> 00:21:46,340
تسبّبت بالكثير من المتاعب لزملائي
،الأكبر حول العالم

220
00:21:46,340 --> 00:21:52,670
وها أنا الآن، سأتشارك كأس ساكي
...مع زعيمي قبّعة القشّ-سان

221
00:21:52,980 --> 00:21:56,500
!بصفتي العضو الجديد

222
00:22:00,720 --> 00:22:02,810
...يمكنكم مناداتي

223
00:22:02,810 --> 00:22:06,290
!فارس البحر" جينبي"

224
00:22:09,200 --> 00:22:10,980
!هذا غير ممكن

225
00:22:10,980 --> 00:22:14,200
!سينضمّ إلى طاقم قبّعة القشّ؟

226
00:22:15,550 --> 00:22:19,160
،تذكّروا وجهي رجاءً

227
00:22:19,160 --> 00:22:23,020
!وأطلب منكم دعمكم المتواصل

228
00:22:29,460 --> 00:22:31,360
!جينبي-سان

229
00:22:29,460 --> 00:22:34,470
!جينبي

230
00:22:31,360 --> 00:22:32,690
!يا زعيم

231
00:22:36,820 --> 00:22:41,100
!شكرًا لتساهلكم معي

232
00:22:41,100 --> 00:22:45,140
!لوفي! عدتُ حيًّا كما وعدتك

233
00:22:45,140 --> 00:22:48,310
!سعيد لأنّني جئت في الوقت المناسب للقتال

234
00:23:04,500 --> 00:23:10,250
لوفي والبقيّة متحمّسون لرؤية جينبي وهم في
.طريقهم الآن لأونيغاشيما، حصن يصعب اختراقه

235
00:23:10,250 --> 00:23:15,920
،بينما يضع السّاموراي خطّة جديدة
.يعترض طريقهم حرّاس بوّابة توري عملاقة

236
00:23:15,920 --> 00:23:18,890
،بوجود عضو جديد وزيادة قوّتهم

237
00:23:18,890 --> 00:23:22,560
يقاتل طاقم قبّعة القشّ الأعداء
!بعمل جماعي هائل

238
00:23:22,560 --> 00:23:26,940
:في الحلقة القادمة من وان بيس
"!عضو جديد! فارس البحر جينبي"

239
00:23:26,940 --> 00:23:30,670
!ملك القراصنة، لن يكون إلاّ أنا