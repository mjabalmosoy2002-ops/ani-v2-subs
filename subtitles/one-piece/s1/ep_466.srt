1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,790
"وأقول "أريد أن أصير أقوى

5
00:00:47,950 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,370 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,590 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,520 --> 00:03:22,940
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:22,940 --> 00:03:25,760
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:25,760 --> 00:03:27,740
!الّذي اقترب موعد إعدامه

40
00:03:28,220 --> 00:03:32,580
أثناء ذلك، يغير قراصنة اللّحية
...البيضاء على مارينفورد

41
00:03:32,580 --> 00:03:36,000
!وتنشب بينهم وبين الحربيّة حرب شاملة

42
00:03:38,330 --> 00:03:40,120
...إيس-كُن

43
00:03:40,120 --> 00:03:42,590
!أورز

44
00:03:47,880 --> 00:03:51,430
!تسلّقوا جسد أورز وتقدّموا

45
00:03:56,570 --> 00:03:57,880
ما هذا؟

46
00:04:01,650 --> 00:04:03,350
!مرحى

47
00:04:18,080 --> 00:04:22,870
!وصول فريق قبّعة القشّ"
"!يتصاعد التّوتّر على ساحة المعركة

48
00:04:25,390 --> 00:04:28,120
!أشعر أنّ قلبي سيتوقّف

49
00:04:28,120 --> 00:04:30,800
!يا شريكي! أبإمكانك فعل شيء ما؟

50
00:04:30,800 --> 00:04:34,010
!هل تظنّ فعلاً أنّ الشّمع سيساعد في وضعنا هذا؟

51
00:04:34,930 --> 00:04:37,970
لماذا لوفي والبقيّة يسقطون من السّماء؟

52
00:04:37,970 --> 00:04:43,400
علينا الرّجوع للوراء بعض الوقت
.لمعرفة ما الّذي حدث لهم

53
00:04:44,440 --> 00:04:49,530
السّفينة الّتي كانوا على متنها علقت
.في زلزال اللّحية البيضاء البحريّ

54
00:04:50,080 --> 00:04:52,280
!إنّها تسرع

55
00:04:55,490 --> 00:04:58,490
!مـ-مهلاً! انظروا هناك

56
00:05:01,750 --> 00:05:04,130
!ما-ما هذا؟

57
00:05:05,550 --> 00:05:08,220
!إنّها تسونامي

58
00:05:08,920 --> 00:05:10,010
!إنّها ضخمة

59
00:05:10,010 --> 00:05:11,220
!سنعلق فيها

60
00:05:13,930 --> 00:05:18,250
تراجع البحر فجأة وها هي ذي
.تسونامي ضخمة بعد ذلك

61
00:05:18,250 --> 00:05:19,400
...لا بدّ أنّه

62
00:05:19,400 --> 00:05:22,100
...يا جينبي! علينا فعل شيء ما وإلاّ

63
00:05:24,480 --> 00:05:28,900
!لا أريد أن أُهزم على يد تسونامي هنا

64
00:05:28,900 --> 00:05:31,940
!عليّ... عليّ إنقاذ إيس

65
00:05:32,990 --> 00:05:34,950
!أنزلوا الأشرعة

66
00:05:34,950 --> 00:05:37,410
!لوفي-كُن، لنركب التسونامي

67
00:05:37,410 --> 00:05:40,080
!ألا يجب علينا الهرب؟

68
00:05:40,080 --> 00:05:43,250
!ما الّذي تقوله أيّها المغفّل؟

69
00:05:43,250 --> 00:05:45,000
!استدر في الحال

70
00:05:45,000 --> 00:05:46,710
!توقّف يا هذا

71
00:05:46,710 --> 00:05:48,210
!علينا أن نسرع

72
00:05:48,210 --> 00:05:49,250
!اقفزوا للبحر

73
00:05:49,250 --> 00:05:50,920
!النّجدة! النّجدة

74
00:05:51,420 --> 00:05:53,840
منذ متى وأنتم قراصنة؟

75
00:05:55,510 --> 00:05:57,800
هل أنتم مجرّد حفنة هواة؟

76
00:05:58,970 --> 00:06:03,610
إن استدرنا الآن، فسنخاطر أن تضربنا الموجة
.من الجانب وستغرق السّفينة

77
00:06:04,100 --> 00:06:06,730
.لا خيار آخر أمامنا

78
00:06:06,730 --> 00:06:08,310
!هذا صحيح

79
00:06:08,310 --> 00:06:12,190
!تمسّكوا جيّدًا لكي لا تنجرفوا بسبب الموجة العاتية

80
00:06:12,190 --> 00:06:13,610
!سُحقًا

81
00:06:13,610 --> 00:06:15,030
!بسرعة

82
00:06:15,030 --> 00:06:17,530
!تمسّك بشيء ما فحسب

83
00:06:17,530 --> 00:06:18,870
.وجهي كبير للغاية

84
00:07:13,170 --> 00:07:14,430
ما الّذي حدث؟

85
00:07:14,430 --> 00:07:16,300
!توقّفت الموجة عن التّحرّك

86
00:07:16,300 --> 00:07:18,430
!ماذا حدث؟

87
00:07:19,180 --> 00:07:21,000
!ما هذا؟

88
00:07:21,000 --> 00:07:25,890
!تجمّدت السّفينة وحوصرنا بالكامل

89
00:07:26,980 --> 00:07:29,350
...لا بدّ أنّ هذا من صنيع

90
00:07:31,920 --> 00:07:35,990
.انزلوا للأسفل. بالإمكان رؤية ما يحدث

91
00:07:37,780 --> 00:07:38,910
...الوالد

92
00:07:38,910 --> 00:07:40,910
.بدأت الحرب بالفعل

93
00:07:41,650 --> 00:07:45,830
.لا بدّ أنّ الوالد قد أطلق تلك التسونامي كإعلان حرب

94
00:07:45,830 --> 00:07:50,210
.وبعدها قام الأميرال أوكيجي بتجميدها

95
00:07:50,210 --> 00:07:51,880
!اسمعوا جميعًا

96
00:07:52,340 --> 00:07:54,800
!لديّ فكرة لتخطّي هذا الوضع

97
00:07:54,800 --> 00:08:00,430
علينا الإسراع! أمامنا أقلّ
!من 3 ساعات قبل إعدام إيس

98
00:08:00,430 --> 00:08:02,010
نعم. وبعد؟

99
00:08:02,010 --> 00:08:03,470
!ماذا؟

100
00:08:04,020 --> 00:08:07,390
!تريد أن تجعل السّفينة تنزلق من الموجة المجمّدة؟

101
00:08:07,800 --> 00:08:12,230
إنّها الطّريقة الوحيدة! علينا تحرير
!السّفينة من الجليد أوّلاً

102
00:08:16,360 --> 00:08:18,360
!هذا صحيح أيّها الغبيّ

103
00:08:18,360 --> 00:08:21,910
!بإمكاننا ذلك إن عملنا معًا

104
00:08:21,910 --> 00:08:24,990
.يجعلني ذلك أظنّ أنّنا نستطيع

105
00:08:25,400 --> 00:08:30,290
،أجل! لدينا القبطان باغي
!ملك القراصنة التّالي في صفّنا

106
00:08:30,290 --> 00:08:34,750
،عندما يقول القبطان أنّه يستطيع
!فسيقوم بذلك بكلّ تأكيد

107
00:08:35,290 --> 00:08:37,510
...رنين، رنين، رنين

108
00:08:38,040 --> 00:08:42,340
!انتباه لكلّ السّفن والجنود
!"الهدف "تي أو تي تي زد

109
00:08:42,340 --> 00:08:45,470
.غيّروا الخطّ وانتقلوا للعمليّة 3

110
00:08:45,890 --> 00:08:48,140
.إنّها رسالة عمليّات البحريّة

111
00:08:48,140 --> 00:08:49,520
!ابدؤوا الاستعدادات

112
00:08:49,520 --> 00:08:52,440
تي أو تي"... ماذا؟"

113
00:08:52,440 --> 00:08:54,770
.لا أدري. لا بدّ أنّها شيفرة من نوع ما

114
00:08:55,190 --> 00:08:58,100
...عندما تجهزون جميعًا، سنسرّع جدولنا

115
00:08:58,100 --> 00:09:01,280
.وسنعدم إيس في الحال. هذا كلّ شيء

116
00:09:04,750 --> 00:09:05,950
...لوفي-كُن

117
00:09:05,950 --> 00:09:07,120
!لننطلق

118
00:09:07,120 --> 00:09:10,790
!لا يمكن الانتظار أكثر! لا وقت لدينا للجدال

119
00:09:10,790 --> 00:09:14,540
!لنبدأ العمل بخطّة الفتى قبّعة القشّ جميعًا

120
00:09:17,210 --> 00:09:19,010
!هيّا بنا

121
00:09:25,090 --> 00:09:26,140
!مـ-مهلاً

122
00:09:27,510 --> 00:09:29,890
!كلاّ! ذلك ليس الجانب الصّحيح

123
00:09:33,820 --> 00:09:37,720
!وهكذا سقط لوفي والبقيّة من السّماء

124
00:10:11,240 --> 00:10:15,060
ما الّذي حدث للتّوّ؟! هل سقطت
!سفينة بحريّة من السّماء؟

125
00:10:16,650 --> 00:10:20,020
.إنّها مياه، لقد نجونا. سقطنا في الماء

126
00:10:20,020 --> 00:10:23,190
!ظننتُ أنّني سأموت بسقوطي على الجليد

127
00:10:23,600 --> 00:10:26,160
لماذا البحر ليس متجمّدًا هنا؟

128
00:10:26,160 --> 00:10:31,080
انظروا! سقطت السّفينة في المنطقة
!الّتي أزال منها جوزو الجليد

129
00:10:32,620 --> 00:10:34,660
أهو هجوم مفاجئ من البحريّة؟

130
00:10:34,660 --> 00:10:37,080
.كلاّ، لا يبدون كالبحريّة

131
00:10:37,080 --> 00:10:39,340
!اصعدوا! اصعدوا للأعلى

132
00:10:39,340 --> 00:10:43,010
.هذا لا شيء مقارنة بالتّعذيب بالماء في الجحيم

133
00:10:53,320 --> 00:10:56,270
.عجز آكلي فاكهة الشّيطان عن السّباحة مزعج للغاية

134
00:11:11,700 --> 00:11:13,740
أين أنا؟

135
00:11:15,520 --> 00:11:19,670
.صحيح، سقطت من هناك

136
00:11:24,960 --> 00:11:26,390
!إيس

137
00:11:46,390 --> 00:11:48,650
!أين أنت؟ أين أنت يا إيس؟

138
00:11:48,650 --> 00:11:49,990
...إيس

139
00:12:03,210 --> 00:12:05,000
!اصعدوا السّفينة

140
00:12:05,000 --> 00:12:07,130
!ليس على هذا الجانب

141
00:12:15,960 --> 00:12:17,770
!أين أنت يا إيس؟

142
00:12:22,900 --> 00:12:26,150
!انتظرني يا إيس! سأوافيك قريبًا

143
00:12:35,820 --> 00:12:38,660
!لا تقفوا في طريقي

144
00:12:50,480 --> 00:12:52,130
!إيس

145
00:13:50,530 --> 00:13:51,780
...إيس

146
00:14:14,390 --> 00:14:24,230
!إيس

147
00:14:26,110 --> 00:14:29,520
!لوفي

148
00:14:31,030 --> 00:14:36,450
!إيس

149
00:14:40,360 --> 00:14:42,240
!أستطيع رؤيتك أخيرًا

150
00:14:57,830 --> 00:14:59,470
!لوفي

151
00:15:00,170 --> 00:15:03,060
...إيس! تماسك! فأنا

152
00:15:03,900 --> 00:15:05,980
!...مـ-مهلاً، أيعقل أنّه

153
00:15:06,310 --> 00:15:07,690
!كروكودايل

154
00:15:07,690 --> 00:15:10,940
!إنّه ليس وحده! من معه أيضًا؟

155
00:15:11,570 --> 00:15:15,240
!كلّ القوّات هنا من كِلا الجانبين
!ثمّة الكثير من الأسماء الكبيرة

156
00:15:16,400 --> 00:15:18,680
!على العالم أن يستعدّ لهذا

157
00:15:20,370 --> 00:15:22,830
!إيس، أتينا لإنقاذك

158
00:15:23,160 --> 00:15:26,000
!نحن هنا لأجلك

159
00:15:27,500 --> 00:15:30,790
!غارب! إنّها عائلتك ثانية

160
00:15:31,130 --> 00:15:32,710
!لوفي

161
00:15:32,710 --> 00:15:35,420
!انظروا! ليس قبّعة القشّ فحسب

162
00:15:35,420 --> 00:15:39,100
!جينبي وإيفانكوف من الجيش الثّوريّ أيضًا

163
00:15:39,100 --> 00:15:43,150
وخلفهم العديد من القراصنة الّذين
!صنعوا اسمًا لأنفسهم في الماضي

164
00:15:43,150 --> 00:15:45,720
!لا بدّ أنّهم الهاربون من إمبل داون

165
00:15:46,170 --> 00:15:49,940
.يتسبّب في المشاكل دائمًا... قبّعة القشّ ذاك

166
00:15:49,940 --> 00:15:53,520
!قبّعة القشّ

167
00:15:53,520 --> 00:15:56,320
ما الّذي أتى به إلى هنا؟

168
00:15:56,320 --> 00:15:58,700
.إنّه ليس مع طاقمه

169
00:15:59,200 --> 00:16:02,620
!لوفي! أنا سعيدة لأنّك على قيد الحياة

170
00:16:02,620 --> 00:16:04,620
!انظر يا هيلميبّو-سان

171
00:16:04,620 --> 00:16:07,960
...ماذا؟! لا يوجد ما قد يفاجئني أكثر

172
00:16:07,960 --> 00:16:09,460
!قبّعة القشّ

173
00:16:09,460 --> 00:16:14,210
سمعتُ أنّهم أمسكوا به
!في إمبل داون! إنّه مذهل فعلاً

174
00:16:14,640 --> 00:16:17,170
!أحضر معه بعض الوجوه المهمّة

175
00:16:19,470 --> 00:16:23,600
.لم أتوقّع رؤيته ثانية بهذه السّرعة

176
00:16:23,930 --> 00:16:27,060
.إنّه الأخ الّذي كان إيس يتحدّث عنه

177
00:16:27,060 --> 00:16:30,140
!ثمّة شيتشيبوكاي سابق وحاليّ معًا

178
00:16:31,440 --> 00:16:36,650
،ويفترض أنّ ذاك هو قبّعة القشّ
!النّاشئ مفتعل المشاكل

179
00:16:37,050 --> 00:16:38,980
!سموكر-سان، انظر

180
00:16:39,450 --> 00:16:40,780
!مت

181
00:16:43,510 --> 00:16:47,830
قبّعة القشّ وكروكودايل... لماذا هما معًا؟

182
00:16:48,580 --> 00:16:50,790
.هذا هو إذًا

183
00:16:51,120 --> 00:16:57,090
.حفيد البطل غارب وابن الثّوريّ دراغون

184
00:16:59,210 --> 00:17:02,630
!سأتولّى أمره للأبد

185
00:17:07,310 --> 00:17:12,900
من بين كلّ الاحتمالات، قرّرت العمل
...مع قبّعة القشّ لوفي

186
00:17:12,900 --> 00:17:15,520
!أهذا هو جوابك يا جينبي؟

187
00:17:15,520 --> 00:17:18,780
!هذا صحيح! أنا أتخلّى عن لقبي كشيتشيبوكاي

188
00:17:19,280 --> 00:17:23,200
.من الغريب أنّ هؤلاء تحالفوا معًا

189
00:17:24,320 --> 00:17:27,480
سجناء وقائد في الجيش الثّوريّ

190
00:17:27,480 --> 00:17:30,660
...وبعض الأشخاص غريبو المنظر

191
00:17:31,910 --> 00:17:33,620
.وكروكودايل

192
00:17:33,620 --> 00:17:37,800
.لا أظنّ أنّ لهم هدفًا مشتركًا

193
00:17:37,800 --> 00:17:40,340
.في هذه المعركة على الأقلّ

194
00:18:19,000 --> 00:18:20,460
أين الفتى كروكو؟

195
00:18:20,460 --> 00:18:24,630
...ماذا؟ أعتقد أنّ جبُن و

196
00:18:24,630 --> 00:18:26,370
!ها هو هناك

197
00:18:29,890 --> 00:18:32,090
!لقد سبقني

198
00:18:33,520 --> 00:18:36,060
!يستهدف كروكودايل اللّحية البيضاء

199
00:18:36,060 --> 00:18:36,690
!والدي

200
00:18:37,010 --> 00:18:39,900
.لم أرك منذ مدّة أيّها اللّحية البيضاء

201
00:18:39,900 --> 00:18:42,320
.أنت لا تتعلّم أبدًا

202
00:19:05,260 --> 00:19:10,220
.إنّه يعرف تمام المعرفة كيف يقاتل ضدّي

203
00:19:10,350 --> 00:19:14,850
.لا يمكنك التّحوّل لرمال بمجرّد أن تتبلّل

204
00:19:20,170 --> 00:19:25,900
.بما أنّنا وصلنا إلى هنا، فقد انتهى اتّفاقنا

205
00:19:25,900 --> 00:19:28,450
!لماذا تريد حماية اللّحية البيضاء؟

206
00:19:28,450 --> 00:19:31,320
.كما توقّعت، هذا العجوز هو اللّحية البيضاء

207
00:19:31,320 --> 00:19:33,160
!دعه وشأنه إذًا

208
00:19:33,160 --> 00:19:35,830
!يحبّ إيس هذا العجوز

209
00:19:35,830 --> 00:19:39,170
.أخو إيس مقاتل ممتاز

210
00:19:40,750 --> 00:19:42,590
!لا تدعوه يقترب من والدنا

211
00:19:58,190 --> 00:20:03,420
نزل خبر فقدان شخص من مقامك
لذراعه في الأزرق الشّرقيّ

212
00:20:03,420 --> 00:20:05,570
.كالصّاعقة على الجميع

213
00:20:06,350 --> 00:20:11,030
أيّ عدوّ تمكّن من سلبك ذراعك؟

214
00:20:14,810 --> 00:20:18,870
.راهنتُ بها... على عصرٍ جديد

215
00:20:18,870 --> 00:20:22,670
...أيّها الولد، قبّعة القشّ الّتي ترتديها

216
00:20:22,670 --> 00:20:26,340
.تبدو مثل الّتي كان يرتديه أحمر الشّعر في الماضي

217
00:20:27,010 --> 00:20:29,760
أتعرف شانكس أيّها العجوز؟

218
00:20:29,760 --> 00:20:32,840
.تركها شانكس في عهدتي

219
00:20:33,470 --> 00:20:37,290
!انظر يا والدي! هذا هو أخي الصّغير

220
00:20:40,940 --> 00:20:43,770
أتيتَ لتنقذ أخاك الكبير؟

221
00:20:43,770 --> 00:20:44,990
.صحيح

222
00:20:44,990 --> 00:20:48,320
!أتعرف مع من تعبث؟

223
00:20:53,530 --> 00:20:57,550
!سينتهي المطاف بشقيّ مثلك جثّة هادمة

224
00:21:17,650 --> 00:21:21,350
!اخرس! ذلك ليس شيئًا تقرّره أنت

225
00:21:25,520 --> 00:21:27,480
!أعرف ما هدفك

226
00:21:27,480 --> 00:21:30,490
!تريد أن تصير ملك القراصنة، صحيح؟

227
00:21:33,610 --> 00:21:37,740
!ملك القراصنة، لن يكون إلاّ أنا

228
00:22:16,200 --> 00:22:18,450
!يا لك من وقح

229
00:22:19,640 --> 00:22:23,370
لن أسامحك إن تسبّبت لي بالمشاكل
!أيّها الشّقيّ المدلّل

230
00:22:23,720 --> 00:22:25,920
!سأقوم بما يحلو لي

231
00:22:28,740 --> 00:22:30,550
!سأنقذ إيس

232
00:22:30,550 --> 00:22:32,420
...إ-إنّه ينافس

233
00:22:32,420 --> 00:22:33,710
!اللّحية البيضاء

234
00:22:33,710 --> 00:22:35,550
!مستحيل

235
00:22:43,400 --> 00:22:48,860
،بإمكاننا معاقبتهم جميعًا بالموت
صحيح يا سنغوكو-سان؟

236
00:22:49,520 --> 00:22:50,570
.بالطّبع

237
00:22:51,310 --> 00:22:54,280
...لوفي... والدي

238
00:22:54,280 --> 00:22:56,700
!انتظر يا إيس

239
00:22:57,530 --> 00:22:59,160
...سآتي إليك

240
00:23:00,470 --> 00:23:02,950
!سآتي إليك قريبًا

241
00:23:11,480 --> 00:23:16,130
في مقرّ البحريّة، يندفع لوفي مهاجمًا
.ضدّ حشد كبير من القوّات

242
00:23:16,130 --> 00:23:19,140
،وبينما يتوافد رجال بحريّة مهاجمين لوفي

243
00:23:19,140 --> 00:23:21,600
.يصرخ إيس طالبًا منه الرّحيل

244
00:23:21,970 --> 00:23:25,730
ماذا ستكون إجابة لوفي لرغبة أخيه؟

245
00:23:25,730 --> 00:23:27,100
:في الحلقة القادمة من وان بيس

246
00:23:27,100 --> 00:23:30,650
!وإن عنى ذلك الموت"
"!بداية معركة لوفي ضدّ البحريّة

247
00:23:30,650 --> 00:23:33,230
!ملك القراصنة، لن يكون إلاّ أنا

248
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة