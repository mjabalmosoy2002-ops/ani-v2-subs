1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:04,140 --> 00:02:08,780
دامت المعركة بين قراصنة روجر وقراصنة
،اللّحية البيضاء ثلاثة أيّام بلياليها

29
00:02:08,780 --> 00:02:11,410
.وأمست وليمة في النّهاية

30
00:02:11,640 --> 00:02:17,250
في نفس الوقت، اكتشف روجر أن أودن قادر
،على قراءة النّص على بونيغليف الطّريق

31
00:02:20,280 --> 00:02:23,920
!أعرني أودن لسنة واحدة فقط

32
00:02:24,510 --> 00:02:26,680
!أرجوك يا نيوغيت

33
00:02:28,040 --> 00:02:29,910
!أنا أتوسّل إليك

34
00:02:29,910 --> 00:02:31,850
!تبًّا لك

35
00:02:34,830 --> 00:02:38,810
روجر! هل تحاول أخذ عضو
!من عائلتي بعيدًا عنّي؟

36
00:02:39,550 --> 00:02:41,360
!أيّها اللّحية-كيتشي-تشان

37
00:02:41,360 --> 00:02:43,360
!أريد الذّهاب

38
00:02:43,360 --> 00:02:45,740
!اسمح لي بالذّهاب أرجوك

39
00:02:47,970 --> 00:02:51,700
"!كرّس حياته لها! مغامرة روجر"

40
00:03:17,170 --> 00:03:21,480
نحمل ساكي بينكس وفي طريقنا لنوصله

41
00:03:21,480 --> 00:03:25,820
نتبع نسيم البحر ونركب أمواجه

42
00:03:25,820 --> 00:03:29,740
بعيدًا خلف الأعماق المالحة... تبتهج شمس المساء

43
00:03:29,740 --> 00:03:34,370
بينما تغنّي الطّيور وهي تخطّ دوائر في السّماء

44
00:03:34,370 --> 00:03:38,330
نودّع ميناء القرية وأهلها يلوّحون لنا

45
00:03:38,330 --> 00:03:42,540
بينما نشرع في إبحارنا، سنغنّي من قلوبنا

46
00:03:42,540 --> 00:03:47,170
أمواج البحر الفضّيّة والذّهبيّة ترشّنا

47
00:03:47,170 --> 00:03:51,140
صوب أقاصي البحار، نشدّ رحالنا

48
00:03:53,330 --> 00:03:55,210
.أحبّ هذه السّفينة

49
00:03:55,210 --> 00:03:56,290
...وأنا أيضًا

50
00:03:56,290 --> 00:03:59,380
!أريد الإبحار هكذا للأبد

51
00:03:59,380 --> 00:04:02,090
...نعم، ما دام الوقت يسمح بذلك

52
00:04:02,090 --> 00:04:03,400
!افعلها الآن

53
00:04:03,670 --> 00:04:05,530
!اخرس! لا تتحرّك

54
00:04:07,400 --> 00:04:09,200
ماذا؟ هل أصبت بالزّكام أيّها القبطان؟

55
00:04:09,680 --> 00:04:12,180
.نعم، لكنّه أمر بسيط

56
00:04:12,180 --> 00:04:14,740
!ليس بالأمر البسيط أيّها المغفّل

57
00:04:14,740 --> 00:04:17,450
!بقي له في الحياة عام واحد على الأكثر

58
00:04:17,450 --> 00:04:18,760
!ماذا؟

59
00:04:20,360 --> 00:04:23,750
.أنا أعيش الحياة بأقصى سرعتها

60
00:04:28,740 --> 00:04:33,150
تشير البوصلة المُسجِّلة إلى السّماء... أهي معطّلة؟

61
00:04:33,370 --> 00:04:35,930
.كلاّ... لننطلق

62
00:04:35,930 --> 00:04:37,100
ننطلق إلى أين؟

63
00:04:39,920 --> 00:04:41,350
!إلى السّماء

64
00:04:46,520 --> 00:04:49,530
!ها هو قادم... تيّار المحيط الصّاعد

65
00:05:00,230 --> 00:05:01,750
!سأموت

66
00:05:18,010 --> 00:05:19,140
!ثمّة جزيرة

67
00:05:22,310 --> 00:05:23,640
...هذه إذًا

68
00:05:28,800 --> 00:05:30,570
!جزيرة السّماء

69
00:05:30,570 --> 00:05:33,750
.مرحبًا بالوافدين من البحر الأزرق

70
00:05:34,700 --> 00:05:36,880
!هيسو

71
00:05:38,770 --> 00:05:41,830
!العالم كبير! وما خفي منه أعظم بكثير

72
00:05:41,830 --> 00:05:46,500
حتّى البوذا ما كان ليتخيّل أنّه يوجد
!أشخاص يعيشون في السّماء

73
00:05:55,370 --> 00:05:58,930
.يتطلّب إتقان قيادة ويفر 10 سنين على الأقلّ

74
00:06:07,650 --> 00:06:09,070
!اهربوا

75
00:06:21,230 --> 00:06:24,360
!إذًا فهذه هي مدينة الذّهب شاندورا

76
00:06:24,360 --> 00:06:25,960
!مذهل

77
00:06:31,110 --> 00:06:34,010
.اكتموا دافعنا الحقيقيّ في قلوبكم"

78
00:06:34,720 --> 00:06:37,470
...نحن الّذين ننسج التّاريخ

79
00:06:37,470 --> 00:06:40,470
".مع طنين برج الجرس العظيم

80
00:06:41,330 --> 00:06:42,850
برج الجرس العظيم؟

81
00:06:43,460 --> 00:06:45,540
!وجدته

82
00:06:45,540 --> 00:06:47,310
!إذًا فقد كان هنا؟

83
00:06:53,690 --> 00:06:56,610
!لا بدّ أنّه برج جرس شاندورا العظيم

84
00:06:56,610 --> 00:07:00,730
!إنّه ذهب خالص! كيف سنأخذه أيّها القبطان؟

85
00:07:00,730 --> 00:07:02,620
.ليس لديّ وقت

86
00:07:02,620 --> 00:07:06,750
،بمجرّد أن تصبح قبطانًا
.تعال وخذه بنفسك يا باغي

87
00:07:06,750 --> 00:07:10,460
!ماذا؟! لنأخذ قطعة منه الآن على الأقلّ

88
00:07:10,460 --> 00:07:14,550
يسهل العثور على هذا الحجر
.بما أنّ له صوتًا قويًّا بداخله

89
00:07:14,550 --> 00:07:17,130
إنّه يتحدّث عن قوّة عظيمة، صحيح؟

90
00:07:26,560 --> 00:07:29,800
.تتحدّث الكتابات عن سلاح يُدعى بوسيدون

91
00:07:29,800 --> 00:07:30,940
...فهمت

92
00:07:32,470 --> 00:07:36,190
!أودن، أيمكنك الكتابة أيضًا؟

93
00:07:36,190 --> 00:07:38,250
.نعم، بالطّبع

94
00:07:38,800 --> 00:07:40,240
!انقش هذه الرّسالة

95
00:07:49,290 --> 00:07:51,830
...اقترب روجر من نهاية حياته

96
00:07:51,830 --> 00:07:55,640
يصعب تصديق هذا، لكن إن كان
،عجولاً في عيش حياته في مدّة قصيرة

97
00:07:55,640 --> 00:07:58,050
!فسأرافقه حتّى النّهاية

98
00:08:00,080 --> 00:08:01,510
ما رأيك؟

99
00:08:01,510 --> 00:08:05,010
!نعم... هذا مثاليّ يا أودن

100
00:08:05,710 --> 00:08:10,640
وصلتُ إلى هنا. سأرشد هذا"
.النّصّ إلى أقاصي الأرض

101
00:08:10,640 --> 00:08:13,190
".القرصان غول د. روجر

102
00:08:23,720 --> 00:08:26,200
.عليّ رؤيته يا روجر

103
00:08:26,200 --> 00:08:30,580
الفصل الأخير للمغامرة العظيمة
!الّتي كرّست حياتك لها

104
00:08:38,800 --> 00:08:41,930
!يا رفاق! لنعد إلى البحر الأزرق

105
00:08:41,930 --> 00:08:43,680
!أجل

106
00:09:02,860 --> 00:09:03,740
!هيسو

107
00:09:07,160 --> 00:09:11,290
إن لم نفعل شيئًا، فستحطّمنا
!الأمواج إلى قطع صغيرة

108
00:09:11,290 --> 00:09:15,020
!ها نحن أولاء! بالون سكايبيا الأخطبوط المشهور

109
00:09:25,830 --> 00:09:27,350
!أخطبوط؟

110
00:09:29,220 --> 00:09:30,560
!تبًّا

111
00:09:32,840 --> 00:09:34,270
!ما هذا؟

112
00:09:34,800 --> 00:09:36,520
ماذا؟ ماذا؟

113
00:09:38,220 --> 00:09:39,620
!إنّه بالون

114
00:09:39,880 --> 00:09:41,880
!كم هذا مثير للاهتمام

115
00:09:57,540 --> 00:09:59,710
!يفرغ الأخطبوط من الهواء

116
00:10:10,790 --> 00:10:12,310
!هذا مؤلم

117
00:10:13,080 --> 00:10:14,270
!هذا بارد

118
00:10:25,110 --> 00:10:26,600
.كان ذلك مخيفًا-مياو

119
00:10:26,850 --> 00:10:28,070
أكان تسرّبًا في الهواء؟

120
00:10:31,560 --> 00:10:34,510
...استطعنا من الهبوط أحياء

121
00:10:35,860 --> 00:10:40,840
،بمساعدة غان فول، الإله فوق السّحاب
.هبطنا إلى البحر بأمان

122
00:10:40,840 --> 00:10:41,800
!إنّه القطب الشّماليّ

123
00:10:41,800 --> 00:10:43,050
!لا، بل القطب الجنوبيّ

124
00:10:43,050 --> 00:10:44,200
!القطب الشّماليّ

125
00:10:44,280 --> 00:10:45,000
!القطب الجنوبيّ

126
00:10:45,140 --> 00:10:46,300
!أستواصل هذا؟

127
00:10:46,300 --> 00:10:49,350
!نعم! لأنّني على حقّ

128
00:10:49,350 --> 00:10:50,510
!هذا يكفي

129
00:10:51,460 --> 00:10:54,270
!إنّكما تتشاجران طوال الوقت

130
00:10:54,790 --> 00:10:59,150
!من يهتمّ إن كان القطب الشّمالي أبرد أم الجنوبيّ؟

131
00:10:59,520 --> 00:11:03,400
،إن كنتما تريدان أن تعرفا فعلاً
!اذهبا إليهما واعرفا بنفسيكما

132
00:11:03,400 --> 00:11:05,750
!اهدآ أيّها الغبيّان

133
00:11:06,780 --> 00:11:10,450
أريد الذّهاب للقطب الشّماليّ
!والقطب الجنوبيّ أيضًا

134
00:11:10,850 --> 00:11:13,410
روجر، إلى أين نذهب الآن؟

135
00:11:14,060 --> 00:11:18,330
طبعًا ستكون وجهتنا هي الجزيرة
!الأخيرة في الغراند لاين

136
00:11:18,330 --> 00:11:23,090
لكن للوصول إلى هناك، نحتاج لنسخ
.من كلّ بونيغليف الطّريق الأربعة

137
00:11:23,090 --> 00:11:27,470
الحجر الّذي وجدناه في جزيرة السّماء؟
.ثمّة واحد في بلاد وانو

138
00:11:27,470 --> 00:11:30,300
.في موطننا دوقيّة موكومو، يوجد واحد أيضًا-مياو

139
00:11:30,300 --> 00:11:33,760
!ثمّة حجارة مثلها في بلديكم؟

140
00:11:33,760 --> 00:11:35,750
...على عكس الحجر الّذي في جزيرة السّماء

141
00:11:35,750 --> 00:11:37,020
!حجرنا أحمر اللّون

142
00:11:37,020 --> 00:11:40,440
!وذلك هو ما أبتغيه أكثر من غيره
!لماذا لم تخبروني؟

143
00:11:40,440 --> 00:11:42,610
!لدينا اثنان من أصل أربعة إذًا

144
00:11:42,610 --> 00:11:47,950
لا، لديّ نسخة من بونيغليف الطّريق
!الخاصّ بلينلين الّتي نهبتُها منها

145
00:11:47,950 --> 00:11:51,390
.وأظنّ أنّني أعرف أين البقيّة

146
00:11:51,390 --> 00:11:53,030
!ممتاز يا روجر

147
00:11:53,030 --> 00:11:57,510
!نعم، لا أصدّق هذا! سنحظى بالأربعة فعلاً

148
00:11:58,410 --> 00:12:03,100
،آسف لإفساد متعتكم
.لكن ثمّة خطب في السّفينة

149
00:12:03,100 --> 00:12:04,000
!ماذا؟

150
00:12:04,000 --> 00:12:08,010
.لا أستطيع معرفة ما المعطّل فيها بعينيّ المتعبتين

151
00:12:08,010 --> 00:12:10,340
.حسنًا، أعرف أين وجهتنا التّالية

152
00:12:10,540 --> 00:12:11,340
أين؟

153
00:12:11,340 --> 00:12:13,830
!ووتر سيفن، مدينة الماء

154
00:12:13,830 --> 00:12:15,170
مدينة الماء؟

155
00:12:15,400 --> 00:12:16,850
!تبدو رومانسيّة

156
00:12:16,850 --> 00:12:18,960
!يا رفاق، لننطلق

157
00:12:18,960 --> 00:12:20,980
!أجل

158
00:12:21,420 --> 00:12:27,940
وهكذا، اتّجهنا صوب مدينة
.بناء السّفن لإصلاح السّفينة

159
00:12:33,930 --> 00:12:35,520
!جزيرة

160
00:12:35,520 --> 00:12:37,620
!أرى جزيرة

161
00:12:37,620 --> 00:12:39,120
!ما-ما هذه؟

162
00:12:39,120 --> 00:12:41,330
!هذه هي ووتر سيفن

163
00:13:28,450 --> 00:13:31,780
!لم أرَ سحر ماء هائل كهذا من قبل

164
00:13:31,780 --> 00:13:32,930
.هذه نوافير

165
00:13:32,930 --> 00:13:35,760
.لكنّ النّوافير الّتي هنا ضخمة بالفعل

166
00:13:40,870 --> 00:13:42,560
.هذا المكان جميل

167
00:13:43,540 --> 00:13:46,040
مدينة الماء؟

168
00:13:47,260 --> 00:13:49,020
.ممتاز

169
00:14:06,940 --> 00:14:09,300
!وصلتم إلى هنا بكلّ عزم يا روجر

170
00:14:09,300 --> 00:14:12,460
!توم

171
00:14:12,920 --> 00:14:14,090
!توم-سان

172
00:14:16,870 --> 00:14:19,220
!مرّ وقت طويل يا رفاق

173
00:14:19,220 --> 00:14:21,220
!نعم، اشتقت لك

174
00:14:22,540 --> 00:14:24,380
!هل أنهيتَ القطار؟

175
00:14:24,380 --> 00:14:30,070
!تقصد القطار البحريّ؟! مستحيل
!ما زلت أصمّمه

176
00:14:32,440 --> 00:14:34,780
!أخبرني، ما الّذي حطّمتموه؟

177
00:14:34,780 --> 00:14:38,410
.لا تأتون إلى هنا إلاّ إن احتاجت سفينتكم للإصلاح

178
00:14:38,410 --> 00:14:41,950
.صحيح، لقد وقعت من مكان شاهق

179
00:14:41,950 --> 00:14:44,000
!أذهبتم لجزيرة السّماء؟

180
00:14:44,000 --> 00:14:46,460
!أكيد! وبكلّ عزم

181
00:14:46,460 --> 00:14:50,170
!ولكن بعد ذلك، وقعنا في البحر بكلّ عزم

182
00:14:50,170 --> 00:14:51,560
.فهمت

183
00:14:57,280 --> 00:14:59,970
!إنّكم صاخبون كالعادة يا رفاق

184
00:14:59,970 --> 00:15:01,620
!مرحبًا يا كوكورو

185
00:15:01,620 --> 00:15:07,390
،نريد سماع كلّ شيء عن رحلتكم
!لكن لماذا لا تأكلون أوّلاً؟

186
00:15:07,630 --> 00:15:09,690
!ثمّة بعض الطّعام جاهز لكم

187
00:15:19,260 --> 00:15:23,990
،أرى أنّك تعمل بلباسك الدّاخليّ
!يا لك من فتى عالي الهمّة

188
00:15:23,990 --> 00:15:25,790
!لا تزعجني، اغرب عن وجهي

189
00:15:25,790 --> 00:15:30,380
!هل أنت يتيم؟! أتريدني أن أقدّمك لقبطاننا؟

190
00:15:31,240 --> 00:15:32,990
أنتم قراصنة، صحيح؟

191
00:15:32,990 --> 00:15:34,210
وماذا في ذلك؟

192
00:15:34,490 --> 00:15:38,370
!أرفض إن كنتم قراصنة
.سبق وتخلّى عنّي قراصنة من الأساس

193
00:15:38,370 --> 00:15:39,390
!تخلّوا عنك؟

194
00:15:47,540 --> 00:15:51,650
نحمل ساكي بينكس وفي طريقنا لنوصله

195
00:15:51,650 --> 00:15:56,280
إنّا قراصنة نشقّ البحر وأهواله

196
00:15:56,280 --> 00:16:00,660
الأمواج وسائدنا والسّفينة معقلنا

197
00:16:00,660 --> 00:16:04,540
نبحر والجمجمة الفخورة ترفرف على أعلامنا وأشرعتنا

198
00:16:04,540 --> 00:16:09,000
ها قد ضربت عاصفة من سماء بعيدة

199
00:16:09,000 --> 00:16:13,000
وعلى قرع طبولكم ترقص الأمواج سعيدة

200
00:16:13,240 --> 00:16:17,380
إن هبّت الرّياح الجبانة، فتلك هي القارعة

201
00:16:17,380 --> 00:16:22,280
فغدًا ستشرق شمسه

202
00:16:44,470 --> 00:16:46,370
!لنبحر

203
00:16:53,980 --> 00:16:56,270
!جزيرة البرمائيّين؟

204
00:16:56,740 --> 00:16:59,160
!لقد زُرتها مع اللّحية-كيتشي-تشان

205
00:16:59,160 --> 00:17:01,220
!لا ترخِ دفاعاتك

206
00:17:01,220 --> 00:17:05,400
!لا يهمّ كم مرّة زرتها، ففرص موتك لن تقلّ

207
00:17:10,790 --> 00:17:12,060
...سيولد

208
00:17:13,840 --> 00:17:17,070
.قائدنا سيولد

209
00:17:17,070 --> 00:17:19,490
ريلي! أسمعتَ ذلك؟

210
00:17:19,490 --> 00:17:22,860
.عمّ تتحدّث؟ إنّنا في قاع البحر الصّامت

211
00:17:22,860 --> 00:17:24,970
.كلاّ، سمعتُ ذلك أيضًا

212
00:17:24,970 --> 00:17:27,050
أنت أيضًا يا أودن؟

213
00:17:27,980 --> 00:17:32,000
!من يتكلّم في أعماق البحار هذه؟

214
00:17:35,400 --> 00:17:38,200
!توكي! تلك هي جزيرة البرمائيّين

215
00:17:38,200 --> 00:17:43,150
...كم هذا مثير للاهتمام
...تبدو الجزيرة بأكملها في فقاعة

216
00:17:43,530 --> 00:17:44,550
!...هؤلاء

217
00:17:44,550 --> 00:17:45,820
قبيلة البرمائيّين؟

218
00:17:45,940 --> 00:17:47,200
!إنّهم يحيطون بنا

219
00:17:47,200 --> 00:17:50,430
!ما الّذي تريدون يا سكّان السّطح؟

220
00:17:50,430 --> 00:17:55,080
!أجيبوا بحذر، فحياتكم رهن ما ستقولونه

221
00:17:59,010 --> 00:18:01,110
!مهلاً، مهلاً، أمعن النّظر

222
00:18:01,110 --> 00:18:04,570
!هذا أنا روجر أيّها الفارس العظيم نبتون

223
00:18:04,850 --> 00:18:06,510
روجر؟

224
00:18:07,140 --> 00:18:11,680
!فهمت! ستقومون بالأمر إذًا

225
00:18:14,710 --> 00:18:17,040
!لا ننوي فعل أيّ شيء سيّئ

226
00:18:17,040 --> 00:18:21,960
ما بالك؟ لماذا تخاف من نبوءة؟
!أنت أفضل من ذلك

227
00:18:21,960 --> 00:18:27,180
تحكي النّبوءة عن قدوم شخص
!سيدمّر بوّابة جزيرة البرمائيّين قريبًا

228
00:18:27,180 --> 00:18:30,310
...وبما أنّكم هنا، فهذا يعني

229
00:18:33,920 --> 00:18:38,150
!نبتون-ساما، لقد دُمّرت
!قضم ملوك البحر البوّابة

230
00:18:38,150 --> 00:18:43,170
!ملوك البحر الوديعة فعلت شيئًا كهذا؟
!غير ممكن

231
00:18:43,170 --> 00:18:44,280
...تحقّقت النّبوءة

232
00:18:45,900 --> 00:18:47,770
!ثمّة ثغرة في الفقاعة الخارجيّة

233
00:18:47,940 --> 00:18:50,280
!أغلقوها! أصلحوها بسرعة

234
00:18:50,280 --> 00:18:52,330
!لم نتمكّن من منع هذا

235
00:18:52,330 --> 00:18:54,960
!أرأيت؟ لم نكن نحن

236
00:18:57,920 --> 00:19:02,840
جنّ جنون ملوك البحر لأنّها
.تنتظر ولادة الأميرة الحوريّة

237
00:19:02,840 --> 00:19:05,760
.الأميرة الحوريّة؟! هذه نبوءة أخرى

238
00:19:05,760 --> 00:19:07,880
!إذًا فسيحظى الملك بمولودة؟

239
00:19:07,880 --> 00:19:09,870
!علينا الاحتفال

240
00:19:09,870 --> 00:19:13,640
!مهلاً، مهلاً! لم أتزوّج بعد-جامون

241
00:19:13,640 --> 00:19:17,230
!اعتليت العرش قبل بضعة شهور فحسب-جامون

242
00:19:17,230 --> 00:19:19,150
...لكن يا نبتون-ساما

243
00:19:19,380 --> 00:19:24,920
!لكنّها تكهّنت حتّى بيوم موت الملك السّابق

244
00:19:26,610 --> 00:19:28,910
...ومظاهرة تلك الحوريّة الجذّابة

245
00:19:28,910 --> 00:19:34,200
أقصد مظاهرة تلك الحوريّة أوتوهيمي
!المقيتة السّياسيّة تنبّأتها أيضًا

246
00:19:34,200 --> 00:19:35,720
!أوتوهيمي؟

247
00:19:36,270 --> 00:19:39,290
!لـ-ليس وكأنّ الأمر أراحني أو أيّ شيء

248
00:19:42,610 --> 00:19:47,050
...في هذه الأيّام، البلاد بأكملها تهتزّ بنبوءات تلك الفتاة

249
00:19:47,550 --> 00:19:51,680
!لسنا هنا للاستماع لقصصك الخاصّة يا نبتون

250
00:19:51,680 --> 00:19:53,560
.نعم، هذا صحيح

251
00:19:54,620 --> 00:19:56,020
ما رأيك يا أودن؟

252
00:19:56,280 --> 00:19:56,930
...حسنًا

253
00:19:57,420 --> 00:20:00,560
هنالك اثنان، لذلك ظننتُ أنّنا قد نحصل
،على الكثير من المعلومات

254
00:20:00,560 --> 00:20:03,400
.لكنّ أحدهما ليس بتلك الأهمّيّة

255
00:20:03,400 --> 00:20:06,680
.إنّها رسالة اعتذار من شخص يُدعى جويبوي

256
00:20:06,680 --> 00:20:10,010
!لا أصدّق هذا! يستطيع قراءة النّصوص بالفعل

257
00:20:10,010 --> 00:20:13,910
نعم. وبالمناسبة، هل لديكم
سلاح يتحكّم بملوك البحر؟

258
00:20:13,910 --> 00:20:15,290
!سلاح؟

259
00:20:15,700 --> 00:20:19,250
.ذُكر في حجر جزيرة السّماء أنّه هنا

260
00:20:19,610 --> 00:20:22,810
...السّلاح العتيق الّذي يحمل اسم إله

261
00:20:23,780 --> 00:20:26,000
."بوسيدون"

262
00:20:27,240 --> 00:20:29,590
...لأصدقك القول

263
00:20:29,590 --> 00:20:34,600
تملّكني شعور غريب عندما سمعتُ
.نبوءة شارلي قبل قليل-جامون

264
00:20:36,460 --> 00:20:39,350
،مرّة كلّ بعضة قرون في هذه البلاد

265
00:20:39,350 --> 00:20:44,230
.تولد حوريّة بإمكانها التّحدّث مع ملوك البحر

266
00:20:49,760 --> 00:20:52,450
...ربّما تلك الحوريّة

267
00:20:52,450 --> 00:20:56,950
أي أنّ ابنتك ستصبح السّلاح
!الّذي سيدمّر العالم يومًا ما؟

268
00:20:57,480 --> 00:20:59,910
!إنّها مجرّد نبوءة-جامون

269
00:20:59,910 --> 00:21:04,290
،وحتّى إن وُصف بالسّلاح العتيق
!فليس من الضّروريّ أن يُستعمل

270
00:21:04,610 --> 00:21:07,750
!لم أعتقد قطّ أن يكون بوسيدون حوريّة

271
00:21:17,390 --> 00:21:21,180
يا شارلي، متى ستولد الأميرة الحوريّة؟

272
00:21:29,320 --> 00:21:30,530
!عشرة

273
00:21:31,390 --> 00:21:33,280
...أظنها تقصد بعد عشر سنوات

274
00:21:33,280 --> 00:21:38,580
!لكن يا روجر، لا أصدّق أنّك مهتمّ بسلاح كهذا
!لقد خاب ظنّي فيك

275
00:21:38,580 --> 00:21:41,480
نبتون، إنّ ما نسعى إليه

276
00:21:41,480 --> 00:21:46,380
هي كمّيّات الكنوز الهائلة الّتي تركها
!النّاس الّذين وصفوه بالسّلاح

277
00:21:47,570 --> 00:21:49,170
هل ارتحت؟

278
00:21:49,170 --> 00:21:54,180
!لن نأتي لاختطاف ابنتك المشعّرة الّتي ستولد يومًا ما

279
00:21:54,740 --> 00:21:56,300
!لن تكون مشعّرة

280
00:22:08,880 --> 00:22:13,150
نحمل ساكي بينكس وفي طريقنا لنوصله

281
00:22:13,150 --> 00:22:17,530
عاجلاً أم آجلاً، سأضيع في حلم وأسهو

282
00:22:17,530 --> 00:22:21,870
ما لي بتلك اليد الملوّحة من لقاء

283
00:22:21,870 --> 00:22:26,040
لكن لم القلق؟ ولدينا مع ضوءِ القمرِ ليلةَ غدٍ لقاء

284
00:22:26,040 --> 00:22:30,460
نحمل ساكي بينكس وفي طريقنا لنوصله

285
00:22:30,460 --> 00:22:34,720
بينما نشرع في إبحارنا، سنغنّي من قلوبنا

286
00:22:34,720 --> 00:22:38,760
مصيرنا أن نتحوّل إلى عظام على كلّ حال

287
00:22:38,760 --> 00:22:43,580
فما الحياة إلاّ قصّة ضحكٍ بلا نهاية ولا مآل

288
00:23:04,580 --> 00:23:09,790
يوشك روجر أن يحقّق حلمه غير المسبوق
!وصعب المنال بالإبحار حول العالم

289
00:23:09,790 --> 00:23:13,000
بينما يقوّي جسده الّذي نخره المرض

290
00:23:13,000 --> 00:23:17,130
.وتحت راية العهد، يأخذ زمام مصيره بيديه ويُبحر

291
00:23:17,130 --> 00:23:22,350
،وفي آخر جزيرة في الغراند لاين
...أصبح غازي البحر و

292
00:23:22,350 --> 00:23:23,830
:في الحلقة القادمة من وان بيس

293
00:23:23,830 --> 00:23:27,510
"!وُلد ملك القراصنة! الوصول للجزيرة الأخيرة"

294
00:23:27,510 --> 00:23:30,420
!ملك القراصنة، لن يكون إلاّ أنا