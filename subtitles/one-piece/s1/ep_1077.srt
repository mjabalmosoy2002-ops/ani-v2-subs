1
00:00:14,650 --> 00:00:18,320
بوجود الضّعف كحليف لي

2
00:00:18,320 --> 00:00:21,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:21,950 --> 00:00:24,660
من المؤسف البقاء في مكان كهذا

4
00:00:24,660 --> 00:00:28,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:29,200 --> 00:00:32,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:32,870 --> 00:00:36,500
إن كان قلبي أيضًا ضائعًا

7
00:00:36,500 --> 00:00:39,210
فلن أتمكّن من إيجادك

8
00:00:39,210 --> 00:00:43,260
لا لطفك ولا قوّتك

9
00:00:43,260 --> 00:00:49,060
أعلم مسبقًا

10
00:00:49,060 --> 00:00:50,970
إنّ بزوغ الفجر وشيك

11
00:00:50,970 --> 00:00:54,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:54,150 --> 00:00:58,320
سأندفع عبر الطّريق بأكمله

13
00:00:58,320 --> 00:01:01,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:01:01,070 --> 00:01:05,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:01:05,570 --> 00:01:08,330
بوجود العالم كعدوّ لي

16
00:01:08,330 --> 00:01:12,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:01:12,790 --> 00:01:15,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:15,580 --> 00:01:20,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:29,970 --> 00:01:35,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:02:37,060 --> 00:02:39,710
...المنتصر في معركة سماء بلاد وانو

21
00:02:39,710 --> 00:02:42,350
...على سطح قبّة الجمجمة في أونيغاشيما

22
00:02:42,350 --> 00:02:45,710
...كان كايدو سابقًا

23
00:02:49,950 --> 00:02:51,480
!لوفي

24
00:03:11,240 --> 00:03:16,390
"!أسدل السّتار! المنتصر هو قبّعة القشّ لوفي"

25
00:03:29,650 --> 00:03:32,660
.أحسنت يا مومونوسكي-كُن

26
00:03:35,650 --> 00:03:40,290
.أنقذتنا سُحب اللّهب الّتي أنشأتَها جميعًا

27
00:03:42,110 --> 00:03:45,740
!أبليتما حسنًا! لقد أذهلتماني بالكامل

28
00:03:46,050 --> 00:03:49,670
!أنا في غاية السّعادة

29
00:04:01,020 --> 00:04:04,610
.أنقذ حياتنا وحياة أولئك الّذين في العاصمة

30
00:04:04,610 --> 00:04:09,180
!احتجنا للشّوغن خاصّتنا لتحقيق إنجاز كهذا

31
00:04:19,020 --> 00:04:23,450
،القوارب الطّافية لمهرجان النّار
.إنّها تشعرني بالحنين للماضي

32
00:04:23,450 --> 00:04:24,530
...بالمناسبة

33
00:04:26,920 --> 00:04:29,490
!لا مجال للشّكّ

34
00:04:29,490 --> 00:04:33,290
!أرسل لوفي كايدو إلى أعماق الأرض

35
00:04:33,760 --> 00:04:35,500
،كانت أونيغاشيما تهوي

36
00:04:35,500 --> 00:04:40,070
.لكنّ مومونوسكي-ساما تحوّل لتنّين وأوقفها

37
00:04:41,180 --> 00:04:42,740
أهذا ما حدث؟

38
00:04:42,880 --> 00:04:43,880
!الضّبط

39
00:04:45,680 --> 00:04:50,030
ذلك التّنّين الورديّ كان مومونوسكي-ساما؟

40
00:04:50,030 --> 00:04:51,470
!لديه قدرة كهذه؟

41
00:04:54,110 --> 00:04:56,450
...بعد عشرين سنة طويلة

42
00:04:58,620 --> 00:05:01,070
وُضع حدّ أخيرًا لندم أودن-ساما

43
00:05:01,070 --> 00:05:04,400
.وانتهت هذه الحرب بالانتقام له

44
00:05:07,780 --> 00:05:11,290
!واليوم، صار النّصر حليفنا

45
00:05:13,970 --> 00:05:17,020
!لقد أطحنا باثنين من اليونكو

46
00:05:17,020 --> 00:05:21,340
من كان يظنّ أنّنا سنخرج من هذه المعركة أحياء؟

47
00:05:21,340 --> 00:05:24,250
!أخبار مذهلة

48
00:05:30,980 --> 00:05:32,640
!مياو

49
00:05:35,530 --> 00:05:38,000
!نجحنا

50
00:05:39,680 --> 00:05:42,400
!أحسنت يا لوفي

51
00:05:49,000 --> 00:05:50,570
!هيّا بنا

52
00:05:50,570 --> 00:05:52,410
.بقي القليل فحسب

53
00:05:53,550 --> 00:05:55,910
!تشوبّر

54
00:06:39,490 --> 00:06:41,960
.شعور الإطاحة بخصم كهذا شعور مذهل

55
00:06:45,140 --> 00:06:47,240
.عبء وانزاح عن قلوبنا

56
00:06:52,650 --> 00:06:56,200
!قبطان

57
00:06:57,060 --> 00:06:59,910
...قبـ

58
00:06:59,910 --> 00:07:02,550
!قبطان

59
00:07:04,330 --> 00:07:07,000
.تمهّل، أنت ثقيل

60
00:07:14,750 --> 00:07:18,660
!هزم قبّعة القشّ كايدو؟

61
00:07:22,020 --> 00:07:23,460
!نعم

62
00:07:23,460 --> 00:07:26,230
!فاز لوفي

63
00:07:27,270 --> 00:07:30,730
!أخي الكبير هو الأفضل

64
00:07:31,380 --> 00:07:34,030
!ممتاز! لنحتفل

65
00:07:34,030 --> 00:07:35,440
.هزمه لوفي

66
00:07:35,440 --> 00:07:37,600
!أخي الكبير

67
00:07:42,700 --> 00:07:45,360
.فعلتها يا لوفي

68
00:07:50,080 --> 00:07:53,690
.إنّه يحبّ فعلاً التّسبّب لنا بالمشاكل

69
00:08:04,680 --> 00:08:08,740
.ينتهي بهم المطاف على شفير الموت دائمًا

70
00:08:13,560 --> 00:08:16,570
!ليس لديّ دواء يكفي الجميع

71
00:08:16,570 --> 00:08:18,800
!النّجدة

72
00:08:18,800 --> 00:08:22,230
!لديّ مصابان في حالة حرجة يا تشوبّر

73
00:08:24,850 --> 00:08:28,480
!تشوبّر! زورو فاقد للوعي ولا يستيقظ

74
00:08:31,530 --> 00:08:33,580
!تشوبّر

75
00:08:33,580 --> 00:08:36,780
!صرتُ كومة عظام بعد أن احترقتُ بالكامل

76
00:08:37,870 --> 00:08:40,490
.لا وقت لديّ لنكاتك

77
00:08:40,490 --> 00:08:43,870
.على الأقلّ صرتَ رمادًا ولن تحتاج قبرًا

78
00:08:47,260 --> 00:08:48,590
!هذا مخيف

79
00:08:48,590 --> 00:08:51,230
.تبدوان في حالة جيّدة كلاكما

80
00:08:51,230 --> 00:08:53,850
!النّجدة أيّها الطّبيب تشوبّر

81
00:08:53,850 --> 00:08:54,840
.حالاً

82
00:08:54,840 --> 00:08:57,510
!نحن بحاجتك هنا أيّها الطّبيب تشوبّر

83
00:08:57,810 --> 00:09:01,220
!انفتح جرحي ثانية أيّها الطّبيب تشوبّر

84
00:09:01,220 --> 00:09:03,200
!أيّها الطّبيب –
!أيّها الطّبيب تشوبّر –

85
00:09:03,200 --> 00:09:04,350
!رجاءً

86
00:09:04,350 --> 00:09:07,910
!مياغي! هناك مصابون في كلّ مكان

87
00:09:07,910 --> 00:09:11,280
.من الجيّد أنّي هنا للمساعدة إذًا

88
00:09:11,540 --> 00:09:15,570
.جمعتُ كلّ الأدوية والأدوات الّتي استطعت إيجادها

89
00:09:20,260 --> 00:09:22,360
،أمّا بالنّسبة لعاصمة الزّهور

90
00:09:22,650 --> 00:09:26,460
.كان مهرجان النّار يوشك أن يبلغ نهايته

91
00:09:32,060 --> 00:09:34,380
!ارتفع عاليًا

92
00:09:41,230 --> 00:09:42,930
.أخبرني يا تنغو-سان

93
00:09:45,280 --> 00:09:47,100
ماذا يا أوتوكو؟

94
00:09:51,900 --> 00:09:55,570
.سمعتُ أنّ أبي كان رجلاً مهمًّا للغاية في الماضي

95
00:09:57,530 --> 00:10:01,710
.كان يعلم أنّه سيُقتل إن تمّ الإمساك به

96
00:10:02,960 --> 00:10:07,460
.لكن قيل لي أنّه سمح لنفسه بأن يُعتقل في كلّ الأحوال

97
00:10:08,310 --> 00:10:09,880
أتدري لماذا؟

98
00:10:11,810 --> 00:10:13,050
.نعم

99
00:10:17,440 --> 00:10:22,150
.لأنّ ياسويي-دونو منح بذلك فرصة لبلادنا

100
00:10:23,980 --> 00:10:26,410
...لو أنّ ياسويي-دونو لم يفعل

101
00:10:31,450 --> 00:10:34,070
،ما فعله وقتها

102
00:10:34,070 --> 00:10:38,360
لكنّا ودّعنا الآن كلّ بصيص أمل

103
00:10:38,700 --> 00:10:40,740
.جمعناه حتّى ذلك الوقت

104
00:10:42,630 --> 00:10:44,920
!غطّوا عيون أطفالكم

105
00:10:44,920 --> 00:10:48,130
...إنّ آخر الدّايميو الّذين خدموا كوزكي

106
00:10:48,130 --> 00:10:52,010
...بل أقصد الرّجل المرح من بلدة إبيسو

107
00:10:52,010 --> 00:10:54,420
!سينتقل الآن إلى الحياة الآخرة

108
00:11:02,810 --> 00:11:06,570
،من أجل حماية مستقبل بلاد وانو

109
00:11:06,570 --> 00:11:09,180
.اختار التّضحية بحياته

110
00:11:09,400 --> 00:11:11,160
...آملاً أنّه في المستقبل

111
00:11:11,160 --> 00:11:14,920
.ستعيشين حياة سعيدة

112
00:11:16,040 --> 00:11:17,690
فعل ذلك من أجلي؟

113
00:11:45,020 --> 00:11:46,590
!توكو

114
00:11:48,330 --> 00:11:49,100
...توكو

115
00:11:51,570 --> 00:11:52,640
،يا ابنتي العزيزة

116
00:11:52,860 --> 00:11:55,110
هل أكلت تلك الفاكهة؟

117
00:11:55,110 --> 00:11:57,670
!أخبرتك ألاّ تقتربي منها

118
00:12:04,420 --> 00:12:06,050
.أنا آسفة

119
00:12:08,760 --> 00:12:11,080
!كنت أتضوّر جوعًا

120
00:12:39,870 --> 00:12:42,280
ماذا سيحلّ بي؟

121
00:12:43,500 --> 00:12:45,950
!لا يمكنني التّوقّف عن الضّحك

122
00:12:48,670 --> 00:12:49,880
...توكو

123
00:12:59,100 --> 00:13:01,130
هل احتفظتِ ببعضها لي؟

124
00:13:03,030 --> 00:13:05,630
.إنّني أتضوّر جوعًا أيضًا

125
00:13:33,090 --> 00:13:36,630
!ابتسامة تقود لابتسامة أخرى

126
00:13:36,630 --> 00:13:41,000
،لا يسعنا سوى الضّحك
.لذلك فلنضحك ونضحك باستمرار

127
00:13:41,000 --> 00:13:42,330
أرأيت؟

128
00:13:44,770 --> 00:13:48,360
!هيّا أريني ابتسامة، ابتسامة

129
00:13:50,820 --> 00:13:52,570
أتريدين الرّقص؟

130
00:13:52,570 --> 00:13:53,570
!نعم

131
00:13:57,280 --> 00:13:59,090
!لديك موهبة ممتازة في الرّقص

132
00:13:59,090 --> 00:14:02,710
.ستصيرين أفضل راقصة في البلاد بأكملها يومًا ما

133
00:14:02,710 --> 00:14:03,910
فعلاً؟

134
00:14:14,460 --> 00:14:15,890
...أبي

135
00:14:16,290 --> 00:14:19,760
أراد أن أعيش حياة سعيدة؟

136
00:14:19,760 --> 00:14:21,380
.هذا صحيح

137
00:14:22,350 --> 00:14:23,870
...في تلك الحالة

138
00:14:24,130 --> 00:14:26,150
.أريد تغيير رسالتي

139
00:14:33,150 --> 00:14:34,840
ألا بأس بها هكذا؟

140
00:14:37,070 --> 00:14:38,330
.نعم

141
00:14:40,870 --> 00:14:42,770
.إنّها مذهلة

142
00:14:43,120 --> 00:14:44,890
...أريد أن أقول لك

143
00:14:44,890 --> 00:14:47,340
،أنّه كمحارب

144
00:14:48,150 --> 00:14:52,690
.لا شرف أعظم من هذا

145
00:15:14,730 --> 00:15:17,920
!ارتفع عاليًا

146
00:15:41,050 --> 00:15:42,500
...زونيشا

147
00:15:45,370 --> 00:15:47,900
زونيشا! هل تسمعني؟

148
00:15:48,850 --> 00:15:51,150
.فكّرت في الأمر مليًّا

149
00:15:52,140 --> 00:15:53,590
...لا أعتقد أنّ الوقت مناسب

150
00:15:55,440 --> 00:15:57,640
.لفتح حدود البلاد بعد

151
00:15:59,110 --> 00:16:00,600
...حسنًا

152
00:16:01,260 --> 00:16:04,560
.سأحترم قرارك

153
00:16:04,950 --> 00:16:07,350
.أنا أثق بحُكمك

154
00:16:07,350 --> 00:16:09,420
.شكرًا لك، أقدّر لك هذا

155
00:16:12,500 --> 00:16:14,440
،لديّ واجب تجاه شعب هذه البلاد

156
00:16:15,040 --> 00:16:16,870
.حمايتهم تقع على عاتقي

157
00:16:22,290 --> 00:16:27,130
.الوقت باكر على الاحتفال
!لا نزال نفوقكم عددًا

158
00:16:27,130 --> 00:16:30,590
.تهاونوا وستخسرون –
!استسلموا –

159
00:16:30,690 --> 00:16:35,550
.محال أنّ كايدو-سان قد هُزم
!نحن طاقمُ واحدٍ من اليونكو

160
00:16:35,940 --> 00:16:39,010
! سُحقًا! لا يعرفون متى يستسلمون

161
00:16:39,220 --> 00:16:41,520
ما زلتم تريدون القتال؟

162
00:16:41,520 --> 00:16:44,190
!أنا جاهز لكلّ ما لديكم

163
00:16:44,770 --> 00:16:46,650
!اهدأ يا فرانكي-سان

164
00:16:46,650 --> 00:16:48,730
!اتركني

165
00:16:48,730 --> 00:16:51,230
!تراجعوا يا قراصنة مملكة الحيوان

166
00:16:54,170 --> 00:16:56,060
ألا تفهمون؟

167
00:16:56,250 --> 00:16:58,620
!سبق ودنوتم من الموت جميعًا مرّة

168
00:16:59,800 --> 00:17:01,580
...سيّدي الصّغير ياماتو

169
00:17:01,580 --> 00:17:06,750
!تسبّب تلاشي سحب لهب كايدو في سقوط أونيغاشيما

170
00:17:06,750 --> 00:17:08,080
...وقائدنا نحن

171
00:17:08,080 --> 00:17:10,960
!كوزكي مومونوسكي-كُن هو من أوقفها

172
00:17:10,960 --> 00:17:13,170
!لقد صار إلى جانب العدوّ

173
00:17:13,170 --> 00:17:16,470
.أنقذ حياتكم بعد أن هُزمتم

174
00:17:16,470 --> 00:17:19,470
،وإن هممتم بالهجوم رغم ذلك

175
00:17:20,430 --> 00:17:22,980
.فأنا من سيطيح بكم

176
00:17:29,160 --> 00:17:31,540
ما سبب هذه الهزّة؟

177
00:17:36,370 --> 00:17:38,590
ما هذا؟ زلزال؟

178
00:17:56,800 --> 00:17:58,770
ماذا يجري؟

179
00:17:58,940 --> 00:18:00,470
!بابانوكي-سان

180
00:18:00,470 --> 00:18:01,750
ماذا؟

181
00:18:01,750 --> 00:18:03,850
!شيء ما يهتزّ في قاع البحر

182
00:18:03,850 --> 00:18:06,100
!أرني ما يحدث –
!حاضر –

183
00:18:08,780 --> 00:18:10,540
ما هذا الجنون؟

184
00:18:10,810 --> 00:18:14,110
!لا تقفوا هناك بلا حراك، تحرّوا الأمر

185
00:18:45,310 --> 00:18:47,270
ماذا؟

186
00:18:47,270 --> 00:18:50,520
ثوران بركان تحت الماء؟

187
00:19:05,200 --> 00:19:07,380
...المنتصر في معركة سماء بلاد وانو

188
00:19:07,380 --> 00:19:10,340
...ليس كايدو كما تمّ الإعلان سابقًا

189
00:19:10,340 --> 00:19:12,250
!بل هو قبّعة القشّ لوفي

190
00:19:20,260 --> 00:19:22,760
!ثوران بركان؟ –
!في اتّجاه أودون –

191
00:19:22,760 --> 00:19:24,850
وماذا عن هذه الهزّة؟

192
00:19:24,850 --> 00:19:27,800
أيخطّط كايدو والبقيّة لشيء ما؟

193
00:19:28,600 --> 00:19:30,730
!شيء ما ينزل من السّماء

194
00:19:34,520 --> 00:19:36,100
!لا داعي للقلق

195
00:19:36,100 --> 00:19:38,000
!ما عاد هنالك أيّ خطر

196
00:19:46,680 --> 00:19:48,780
أهذا كايدو؟

197
00:19:48,780 --> 00:19:50,250
ماذا تفعل هنا؟

198
00:19:50,250 --> 00:19:53,260
!هذا هو يوم حرّيّتنا الوحيد

199
00:19:56,570 --> 00:19:57,800
،يا شعب وانو

200
00:19:58,100 --> 00:20:00,220
!أنا لستُ كايدو

201
00:20:01,170 --> 00:20:02,300
ماذا؟

202
00:20:02,520 --> 00:20:04,270
!انتهت الحرب

203
00:20:04,720 --> 00:20:08,800
ذلك الثّوران الّذي سمعتموه كان
...آخر إشارة لنهاية

204
00:20:08,800 --> 00:20:11,890
سطوة كايدو، القائد الأعلى لقراصنة
!مملكة الحيوان

205
00:20:22,040 --> 00:20:23,700
!أين اختفى ذلك التّنّين؟

206
00:20:24,680 --> 00:20:26,160
!انظروا

207
00:20:36,720 --> 00:20:37,920
...هناك أشخاص يخرجون

208
00:20:46,690 --> 00:20:48,490
...من خلف هذا الغبار

209
00:21:10,120 --> 00:21:11,830
!إنّها كوموراساكي-ساما

210
00:21:11,830 --> 00:21:15,960
!مستحيل! أهذا شبحها؟
!حضرنا جنازتها قبل وقت قصير

211
00:21:16,420 --> 00:21:18,630
هل أنا أحلم؟

212
00:21:18,630 --> 00:21:20,920
!لكنّ لا أحد يضاهيها في ذلك الجمال

213
00:21:24,700 --> 00:21:26,440
!الزّعيم كيوشيرو

214
00:21:27,470 --> 00:21:29,560
ماذا حدث لتسريحته العزيزة؟

215
00:21:32,820 --> 00:21:34,030
...أيّها الحضور

216
00:21:34,430 --> 00:21:36,390
...هذه قصّة طويلة

217
00:21:40,460 --> 00:21:44,790
!لكنّي أحضرت لكم الشّوغن الجديد لبلاد وانو

218
00:22:05,380 --> 00:22:08,690
انتهى الوقت

219
00:22:09,440 --> 00:22:13,010
هنالك من ضحك ثانية

220
00:22:13,400 --> 00:22:20,120
لا بأس، فإنّ الغمّيضة الآن انتهت

221
00:22:20,900 --> 00:22:25,070
تعال معي
(سنراها قريبًا)

222
00:22:25,070 --> 00:22:28,820
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

223
00:22:28,820 --> 00:22:33,200
شيء ما سيتغيّر
(سنراها قريبًا)

224
00:22:33,200 --> 00:22:37,460
كن قويًّا، ما زال هنالك وقت
(3-2-1)

225
00:22:45,340 --> 00:22:49,430
لكنّنا شباب، لذلك فنحن أحرار

226
00:22:49,430 --> 00:22:54,060
لنعش جميعًا أحلامنا الأكثر حماقة

227
00:22:54,060 --> 00:22:57,980
سننير الطّريق المظلم أمامنا

228
00:22:57,980 --> 00:23:02,110
لنقف على أقدامنا ونحاول

229
00:23:02,110 --> 00:23:06,030
لنكتشف معًا أصقاع العالم

230
00:23:06,030 --> 00:23:10,130
أنا وأنت، سنحلّق بعيدًا

231
00:23:18,500 --> 00:23:21,210
يعمّ الصّمت على عاصمة الزّهور بسبب الذّهول

232
00:23:21,210 --> 00:23:23,580
.أمام الأكازايا التّسعة الجدد

233
00:23:23,940 --> 00:23:28,590
ومن خلف الغبار يخرج رجل بشعر
.طويل وحاجبين مهيبين

234
00:23:28,590 --> 00:23:32,590
تقدّم وريث إرادة أودن عشرين سنة

235
00:23:32,590 --> 00:23:35,220
.وصار رجلاً أمام سماء المستقبل

236
00:23:36,600 --> 00:23:38,050
:في الحلقة القادمة من وان بيس

237
00:23:38,050 --> 00:23:41,770
"!عاد للبلاد! شوغن وانو، كوزكي مومونوسكي"

238
00:23:41,770 --> 00:23:44,570
!ملك القراصنة، لن يكون إلاّ أنا