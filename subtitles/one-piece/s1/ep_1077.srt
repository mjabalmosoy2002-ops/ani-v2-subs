1
00:00:00,650 --> 00:00:04,320
بوجود الضّعف كحليف لي

2
00:00:04,320 --> 00:00:07,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,950 --> 00:00:10,660
من المؤسف البقاء في مكان كهذا

4
00:00:10,660 --> 00:00:14,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,200 --> 00:00:18,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,870 --> 00:00:22,500
إن كان قلبي أيضًا ضائعًا

7
00:00:22,500 --> 00:00:25,210
فلن أتمكّن من إيجادك

8
00:00:25,210 --> 00:00:29,260
لا لطفك ولا قوّتك

9
00:00:29,260 --> 00:00:35,060
أعلم مسبقًا

10
00:00:35,060 --> 00:00:36,970
إنّ بزوغ الفجر وشيك

11
00:00:36,970 --> 00:00:40,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,150 --> 00:00:44,320
سأندفع عبر الطّريق بأكمله

13
00:00:44,320 --> 00:00:47,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,070 --> 00:00:51,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,570 --> 00:00:54,330
بوجود العالم كعدوّ لي

16
00:00:54,330 --> 00:00:58,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,790 --> 00:01:01,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,580 --> 00:01:06,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:15,970 --> 00:01:21,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:02:23,060 --> 00:02:25,710
...المنتصر في معركة سماء بلاد وانو

21
00:02:25,710 --> 00:02:28,350
...على سطح قبّة الجمجمة في أونيغاشيما

22
00:02:28,350 --> 00:02:31,710
...كان كايدو سابقًا

23
00:02:35,950 --> 00:02:37,480
!لوفي

24
00:02:57,240 --> 00:03:02,390
"!أسدل السّتار! المنتصر هو قبّعة القشّ لوفي"

25
00:03:15,650 --> 00:03:18,660
.أحسنت يا مومونوسكي-كُن

26
00:03:21,650 --> 00:03:26,290
.أنقذتنا سُحب اللّهب الّتي أنشأتَها جميعًا

27
00:03:28,110 --> 00:03:31,740
!أبليتما حسنًا! لقد أذهلتماني بالكامل

28
00:03:32,050 --> 00:03:35,670
!أنا في غاية السّعادة

29
00:03:47,020 --> 00:03:50,610
.أنقذ حياتنا وحياة أولئك الّذين في العاصمة

30
00:03:50,610 --> 00:03:55,180
!احتجنا للشّوغن خاصّتنا لتحقيق إنجاز كهذا

31
00:04:05,020 --> 00:04:09,450
،القوارب الطّافية لمهرجان النّار
.إنّها تشعرني بالحنين للماضي

32
00:04:09,450 --> 00:04:10,530
...بالمناسبة

33
00:04:12,920 --> 00:04:15,490
!لا مجال للشّكّ

34
00:04:15,490 --> 00:04:19,290
!أرسل لوفي كايدو إلى أعماق الأرض

35
00:04:19,760 --> 00:04:21,500
،كانت أونيغاشيما تهوي

36
00:04:21,500 --> 00:04:26,070
.لكنّ مومونوسكي-ساما تحوّل لتنّين وأوقفها

37
00:04:27,180 --> 00:04:28,740
أهذا ما حدث؟

38
00:04:28,880 --> 00:04:29,880
!الضّبط

39
00:04:31,680 --> 00:04:36,030
ذلك التّنّين الورديّ كان مومونوسكي-ساما؟

40
00:04:36,030 --> 00:04:37,470
!لديه قدرة كهذه؟

41
00:04:40,110 --> 00:04:42,450
...بعد عشرين سنة طويلة

42
00:04:44,620 --> 00:04:47,070
وُضع حدّ أخيرًا لندم أودن-ساما

43
00:04:47,070 --> 00:04:50,400
.وانتهت هذه الحرب بالانتقام له

44
00:04:53,780 --> 00:04:57,290
!واليوم، صار النّصر حليفنا

45
00:04:59,970 --> 00:05:03,020
!لقد أطحنا باثنين من اليونكو

46
00:05:03,020 --> 00:05:07,340
من كان يظنّ أنّنا سنخرج من هذه المعركة أحياء؟

47
00:05:07,340 --> 00:05:10,250
!أخبار مذهلة

48
00:05:16,980 --> 00:05:18,640
!مياو

49
00:05:21,530 --> 00:05:24,000
!نجحنا

50
00:05:25,680 --> 00:05:28,400
!أحسنت يا لوفي

51
00:05:35,000 --> 00:05:36,570
!هيّا بنا

52
00:05:36,570 --> 00:05:38,410
.بقي القليل فحسب

53
00:05:39,550 --> 00:05:41,910
!تشوبّر

54
00:06:25,490 --> 00:06:27,960
.شعور الإطاحة بخصم كهذا شعور مذهل

55
00:06:31,140 --> 00:06:33,240
.عبء وانزاح عن قلوبنا

56
00:06:38,650 --> 00:06:42,200
!قبطان

57
00:06:43,060 --> 00:06:45,910
...قبـ

58
00:06:45,910 --> 00:06:48,550
!قبطان

59
00:06:50,330 --> 00:06:53,000
.تمهّل، أنت ثقيل

60
00:07:00,750 --> 00:07:04,660
!هزم قبّعة القشّ كايدو؟

61
00:07:08,020 --> 00:07:09,460
!نعم

62
00:07:09,460 --> 00:07:12,230
!فاز لوفي

63
00:07:13,270 --> 00:07:16,730
!أخي الكبير هو الأفضل

64
00:07:17,380 --> 00:07:20,030
!ممتاز! لنحتفل

65
00:07:20,030 --> 00:07:21,440
.هزمه لوفي

66
00:07:21,440 --> 00:07:23,600
!أخي الكبير

67
00:07:28,700 --> 00:07:31,360
.فعلتها يا لوفي

68
00:07:36,080 --> 00:07:39,690
.إنّه يحبّ فعلاً التّسبّب لنا بالمشاكل

69
00:07:50,680 --> 00:07:54,740
.ينتهي بهم المطاف على شفير الموت دائمًا

70
00:07:59,560 --> 00:08:02,570
!ليس لديّ دواء يكفي الجميع

71
00:08:02,570 --> 00:08:04,800
!النّجدة

72
00:08:04,800 --> 00:08:08,230
!لديّ مصابان في حالة حرجة يا تشوبّر

73
00:08:10,850 --> 00:08:14,480
!تشوبّر! زورو فاقد للوعي ولا يستيقظ

74
00:08:17,530 --> 00:08:19,580
!تشوبّر

75
00:08:19,580 --> 00:08:22,780
!صرتُ كومة عظام بعد أن احترقتُ بالكامل

76
00:08:23,870 --> 00:08:26,490
.لا وقت لديّ لنكاتك

77
00:08:26,490 --> 00:08:29,870
.على الأقلّ صرتَ رمادًا ولن تحتاج قبرًا

78
00:08:33,260 --> 00:08:34,590
!هذا مخيف

79
00:08:34,590 --> 00:08:37,230
.تبدوان في حالة جيّدة كلاكما

80
00:08:37,230 --> 00:08:39,850
!النّجدة أيّها الطّبيب تشوبّر

81
00:08:39,850 --> 00:08:40,840
.حالاً

82
00:08:40,840 --> 00:08:43,510
!نحن بحاجتك هنا أيّها الطّبيب تشوبّر

83
00:08:43,810 --> 00:08:47,220
!انفتح جرحي ثانية أيّها الطّبيب تشوبّر

84
00:08:47,220 --> 00:08:49,200
!أيّها الطّبيب –
!أيّها الطّبيب تشوبّر –

85
00:08:49,200 --> 00:08:50,350
!رجاءً

86
00:08:50,350 --> 00:08:53,910
!مياغي! هناك مصابون في كلّ مكان

87
00:08:53,910 --> 00:08:57,280
.من الجيّد أنّي هنا للمساعدة إذًا

88
00:08:57,540 --> 00:09:01,570
.جمعتُ كلّ الأدوية والأدوات الّتي استطعت إيجادها

89
00:09:06,260 --> 00:09:08,360
،أمّا بالنّسبة لعاصمة الزّهور

90
00:09:08,650 --> 00:09:12,460
.كان مهرجان النّار يوشك أن يبلغ نهايته

91
00:09:18,060 --> 00:09:20,380
!ارتفع عاليًا

92
00:09:27,230 --> 00:09:28,930
.أخبرني يا تنغو-سان

93
00:09:31,280 --> 00:09:33,100
ماذا يا أوتوكو؟

94
00:09:37,900 --> 00:09:41,570
.سمعتُ أنّ أبي كان رجلاً مهمًّا للغاية في الماضي

95
00:09:43,530 --> 00:09:47,710
.كان يعلم أنّه سيُقتل إن تمّ الإمساك به

96
00:09:48,960 --> 00:09:53,460
.لكن قيل لي أنّه سمح لنفسه بأن يُعتقل في كلّ الأحوال

97
00:09:54,310 --> 00:09:55,880
أتدري لماذا؟

98
00:09:57,810 --> 00:09:59,050
.نعم

99
00:10:03,440 --> 00:10:08,150
.لأنّ ياسويي-دونو منح بذلك فرصة لبلادنا

100
00:10:09,980 --> 00:10:12,410
...لو أنّ ياسويي-دونو لم يفعل

101
00:10:17,450 --> 00:10:20,070
،ما فعله وقتها

102
00:10:20,070 --> 00:10:24,360
لكنّا ودّعنا الآن كلّ بصيص أمل

103
00:10:24,700 --> 00:10:26,740
.جمعناه حتّى ذلك الوقت

104
00:10:28,630 --> 00:10:30,920
!غطّوا عيون أطفالكم

105
00:10:30,920 --> 00:10:34,130
...إنّ آخر الدّايميو الّذين خدموا كوزكي

106
00:10:34,130 --> 00:10:38,010
...بل أقصد الرّجل المرح من بلدة إبيسو

107
00:10:38,010 --> 00:10:40,420
!سينتقل الآن إلى الحياة الآخرة

108
00:10:48,810 --> 00:10:52,570
،من أجل حماية مستقبل بلاد وانو

109
00:10:52,570 --> 00:10:55,180
.اختار التّضحية بحياته

110
00:10:55,400 --> 00:10:57,160
...آملاً أنّه في المستقبل

111
00:10:57,160 --> 00:11:00,920
.ستعيشين حياة سعيدة

112
00:11:02,040 --> 00:11:03,690
فعل ذلك من أجلي؟

113
00:11:31,020 --> 00:11:32,590
!توكو

114
00:11:34,330 --> 00:11:35,100
...توكو

115
00:11:37,570 --> 00:11:38,640
،يا ابنتي العزيزة

116
00:11:38,860 --> 00:11:41,110
هل أكلت تلك الفاكهة؟

117
00:11:41,110 --> 00:11:43,670
!أخبرتك ألاّ تقتربي منها

118
00:11:50,420 --> 00:11:52,050
.أنا آسفة

119
00:11:54,760 --> 00:11:57,080
!كنت أتضوّر جوعًا

120
00:12:25,870 --> 00:12:28,280
ماذا سيحلّ بي؟

121
00:12:29,500 --> 00:12:31,950
!لا يمكنني التّوقّف عن الضّحك

122
00:12:34,670 --> 00:12:35,880
...توكو

123
00:12:45,100 --> 00:12:47,130
هل احتفظتِ ببعضها لي؟

124
00:12:49,030 --> 00:12:51,630
.إنّني أتضوّر جوعًا أيضًا

125
00:13:19,090 --> 00:13:22,630
!ابتسامة تقود لابتسامة أخرى

126
00:13:22,630 --> 00:13:27,000
،لا يسعنا سوى الضّحك
.لذلك فلنضحك ونضحك باستمرار

127
00:13:27,000 --> 00:13:28,330
أرأيت؟

128
00:13:30,770 --> 00:13:34,360
!هيّا أريني ابتسامة، ابتسامة

129
00:13:36,820 --> 00:13:38,570
أتريدين الرّقص؟

130
00:13:38,570 --> 00:13:39,570
!نعم

131
00:13:43,280 --> 00:13:45,090
!لديك موهبة ممتازة في الرّقص

132
00:13:45,090 --> 00:13:48,710
.ستصيرين أفضل راقصة في البلاد بأكملها يومًا ما

133
00:13:48,710 --> 00:13:49,910
فعلاً؟

134
00:14:00,460 --> 00:14:01,890
...أبي

135
00:14:02,290 --> 00:14:05,760
أراد أن أعيش حياة سعيدة؟

136
00:14:05,760 --> 00:14:07,380
.هذا صحيح

137
00:14:08,350 --> 00:14:09,870
...في تلك الحالة

138
00:14:10,130 --> 00:14:12,150
.أريد تغيير رسالتي

139
00:14:19,150 --> 00:14:20,840
ألا بأس بها هكذا؟

140
00:14:23,070 --> 00:14:24,330
.نعم

141
00:14:26,870 --> 00:14:28,770
.إنّها مذهلة

142
00:14:29,120 --> 00:14:30,890
...أريد أن أقول لك

143
00:14:30,890 --> 00:14:33,340
،أنّه كمحارب

144
00:14:34,150 --> 00:14:38,690
.لا شرف أعظم من هذا

145
00:15:00,730 --> 00:15:03,920
!ارتفع عاليًا

146
00:15:27,050 --> 00:15:28,500
...زونيشا

147
00:15:31,370 --> 00:15:33,900
زونيشا! هل تسمعني؟

148
00:15:34,850 --> 00:15:37,150
.فكّرت في الأمر مليًّا

149
00:15:38,140 --> 00:15:39,590
...لا أعتقد أنّ الوقت مناسب

150
00:15:41,440 --> 00:15:43,640
.لفتح حدود البلاد بعد

151
00:15:45,110 --> 00:15:46,600
...حسنًا

152
00:15:47,260 --> 00:15:50,560
.سأحترم قرارك

153
00:15:50,950 --> 00:15:53,350
.أنا أثق بحُكمك

154
00:15:53,350 --> 00:15:55,420
.شكرًا لك، أقدّر لك هذا

155
00:15:58,500 --> 00:16:00,440
،لديّ واجب تجاه شعب هذه البلاد

156
00:16:01,040 --> 00:16:02,870
.حمايتهم تقع على عاتقي

157
00:16:08,290 --> 00:16:13,130
.الوقت باكر على الاحتفال
!لا نزال نفوقكم عددًا

158
00:16:13,130 --> 00:16:16,590
.تهاونوا وستخسرون –
!استسلموا –

159
00:16:16,690 --> 00:16:21,550
.محال أنّ كايدو-سان قد هُزم
!نحن طاقمُ واحدٍ من اليونكو

160
00:16:21,940 --> 00:16:25,010
! سُحقًا! لا يعرفون متى يستسلمون

161
00:16:25,220 --> 00:16:27,520
ما زلتم تريدون القتال؟

162
00:16:27,520 --> 00:16:30,190
!أنا جاهز لكلّ ما لديكم

163
00:16:30,770 --> 00:16:32,650
!اهدأ يا فرانكي-سان

164
00:16:32,650 --> 00:16:34,730
!اتركني

165
00:16:34,730 --> 00:16:37,230
!تراجعوا يا قراصنة مملكة الحيوان

166
00:16:40,170 --> 00:16:42,060
ألا تفهمون؟

167
00:16:42,250 --> 00:16:44,620
!سبق ودنوتم من الموت جميعًا مرّة

168
00:16:45,800 --> 00:16:47,580
...سيّدي الصّغير ياماتو

169
00:16:47,580 --> 00:16:52,750
!تسبّب تلاشي سحب لهب كايدو في سقوط أونيغاشيما

170
00:16:52,750 --> 00:16:54,080
...وقائدنا نحن

171
00:16:54,080 --> 00:16:56,960
!كوزكي مومونوسكي-كُن هو من أوقفها

172
00:16:56,960 --> 00:16:59,170
!لقد صار إلى جانب العدوّ

173
00:16:59,170 --> 00:17:02,470
.أنقذ حياتكم بعد أن هُزمتم

174
00:17:02,470 --> 00:17:05,470
،وإن هممتم بالهجوم رغم ذلك

175
00:17:06,430 --> 00:17:08,980
.فأنا من سيطيح بكم

176
00:17:15,160 --> 00:17:17,540
ما سبب هذه الهزّة؟

177
00:17:22,370 --> 00:17:24,590
ما هذا؟ زلزال؟

178
00:17:42,800 --> 00:17:44,770
ماذا يجري؟

179
00:17:44,940 --> 00:17:46,470
!بابانوكي-سان

180
00:17:46,470 --> 00:17:47,750
ماذا؟

181
00:17:47,750 --> 00:17:49,850
!شيء ما يهتزّ في قاع البحر

182
00:17:49,850 --> 00:17:52,100
!أرني ما يحدث –
!حاضر –

183
00:17:54,780 --> 00:17:56,540
ما هذا الجنون؟

184
00:17:56,810 --> 00:18:00,110
!لا تقفوا هناك بلا حراك، تحرّوا الأمر

185
00:18:31,310 --> 00:18:33,270
ماذا؟

186
00:18:33,270 --> 00:18:36,520
ثوران بركان تحت الماء؟

187
00:18:51,200 --> 00:18:53,380
...المنتصر في معركة سماء بلاد وانو

188
00:18:53,380 --> 00:18:56,340
...ليس كايدو كما تمّ الإعلان سابقًا

189
00:18:56,340 --> 00:18:58,250
!بل هو قبّعة القشّ لوفي

190
00:19:06,260 --> 00:19:08,760
!ثوران بركان؟ –
!في اتّجاه أودون –

191
00:19:08,760 --> 00:19:10,850
وماذا عن هذه الهزّة؟

192
00:19:10,850 --> 00:19:13,800
أيخطّط كايدو والبقيّة لشيء ما؟

193
00:19:14,600 --> 00:19:16,730
!شيء ما ينزل من السّماء

194
00:19:20,520 --> 00:19:22,100
!لا داعي للقلق

195
00:19:22,100 --> 00:19:24,000
!ما عاد هنالك أيّ خطر

196
00:19:32,680 --> 00:19:34,780
أهذا كايدو؟

197
00:19:34,780 --> 00:19:36,250
ماذا تفعل هنا؟

198
00:19:36,250 --> 00:19:39,260
!هذا هو يوم حرّيّتنا الوحيد

199
00:19:42,570 --> 00:19:43,800
،يا شعب وانو

200
00:19:44,100 --> 00:19:46,220
!أنا لستُ كايدو

201
00:19:47,170 --> 00:19:48,300
ماذا؟

202
00:19:48,520 --> 00:19:50,270
!انتهت الحرب

203
00:19:50,720 --> 00:19:54,800
ذلك الثّوران الّذي سمعتموه كان
...آخر إشارة لنهاية

204
00:19:54,800 --> 00:19:57,890
سطوة كايدو، القائد الأعلى لقراصنة
!مملكة الحيوان

205
00:20:08,040 --> 00:20:09,700
!أين اختفى ذلك التّنّين؟

206
00:20:10,680 --> 00:20:12,160
!انظروا

207
00:20:22,720 --> 00:20:23,920
...هناك أشخاص يخرجون

208
00:20:32,690 --> 00:20:34,490
...من خلف هذا الغبار

209
00:20:56,120 --> 00:20:57,830
!إنّها كوموراساكي-ساما

210
00:20:57,830 --> 00:21:01,960
!مستحيل! أهذا شبحها؟
!حضرنا جنازتها قبل وقت قصير

211
00:21:02,420 --> 00:21:04,630
هل أنا أحلم؟

212
00:21:04,630 --> 00:21:06,920
!لكنّ لا أحد يضاهيها في ذلك الجمال

213
00:21:10,700 --> 00:21:12,440
!الزّعيم كيوشيرو

214
00:21:13,470 --> 00:21:15,560
ماذا حدث لتسريحته العزيزة؟

215
00:21:18,820 --> 00:21:20,030
...أيّها الحضور

216
00:21:20,430 --> 00:21:22,390
...هذه قصّة طويلة

217
00:21:26,460 --> 00:21:30,790
!لكنّي أحضرت لكم الشّوغن الجديد لبلاد وانو

218
00:21:51,380 --> 00:21:54,690
انتهى الوقت

219
00:21:55,440 --> 00:21:59,010
هنالك من ضحك ثانية

220
00:21:59,400 --> 00:22:06,120
لا بأس، فإنّ الغمّيضة الآن انتهت

221
00:22:06,900 --> 00:22:11,070
تعال معي
(سنراها قريبًا)

222
00:22:11,070 --> 00:22:14,820
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

223
00:22:14,820 --> 00:22:19,200
شيء ما سيتغيّر
(سنراها قريبًا)

224
00:22:19,200 --> 00:22:23,460
كن قويًّا، ما زال هنالك وقت
(3-2-1)

225
00:22:31,340 --> 00:22:35,430
لكنّنا شباب، لذلك فنحن أحرار

226
00:22:35,430 --> 00:22:40,060
لنعش جميعًا أحلامنا الأكثر حماقة

227
00:22:40,060 --> 00:22:43,980
سننير الطّريق المظلم أمامنا

228
00:22:43,980 --> 00:22:48,110
لنقف على أقدامنا ونحاول

229
00:22:48,110 --> 00:22:52,030
لنكتشف معًا أصقاع العالم

230
00:22:52,030 --> 00:22:56,130
أنا وأنت، سنحلّق بعيدًا

231
00:23:04,500 --> 00:23:07,210
يعمّ الصّمت على عاصمة الزّهور بسبب الذّهول

232
00:23:07,210 --> 00:23:09,580
.أمام الأكازايا التّسعة الجدد

233
00:23:09,940 --> 00:23:14,590
ومن خلف الغبار يخرج رجل بشعر
.طويل وحاجبين مهيبين

234
00:23:14,590 --> 00:23:18,590
تقدّم وريث إرادة أودن عشرين سنة

235
00:23:18,590 --> 00:23:21,220
.وصار رجلاً أمام سماء المستقبل

236
00:23:22,600 --> 00:23:24,050
:في الحلقة القادمة من وان بيس

237
00:23:24,050 --> 00:23:27,770
"!عاد للبلاد! شوغن وانو، كوزكي مومونوسكي"

238
00:23:27,770 --> 00:23:30,570
!ملك القراصنة، لن يكون إلاّ أنا