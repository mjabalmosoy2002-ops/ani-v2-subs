1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:45,990 --> 00:02:48,300
!دُمّرت الزّنزانة الممنوع فتحها مطلقًا

29
00:02:48,300 --> 00:02:51,080
!لا ندري من المسجون بها

30
00:02:51,080 --> 00:02:53,460
...أعتقد أنّه كان مقيّدًا بالسّلاسل

31
00:02:53,460 --> 00:02:58,420
لا بدّ أنّه مات في الدّاخل
.بعد عجزه عن الهرب

32
00:03:02,000 --> 00:03:05,020
!يا لها من رائحة حلوة وغنيّة

33
00:03:05,020 --> 00:03:08,470
!وثمّة الكثير منه

34
00:03:09,510 --> 00:03:13,640
!استحقّ هذا قطع كلّ هذه المسافة

35
00:03:14,140 --> 00:03:16,930
!حساء الفاصولياء الحمراء

36
00:03:27,650 --> 00:03:30,870
!كان حساء الفاصولياء الحمراء لذيذًا

37
00:03:30,870 --> 00:03:32,330
!يا فتى قبّعة القشّ

38
00:03:32,330 --> 00:03:34,160
...أنت هو

39
00:03:34,160 --> 00:03:37,370
!من تناوله

40
00:03:44,500 --> 00:03:49,840
"!إيقاف اليونكو! خطّة كوين السّرّيّة"

41
00:03:50,890 --> 00:03:52,900
!لماذا أكلتَه؟

42
00:03:52,900 --> 00:03:55,350
!شقيّ صغير

43
00:04:05,270 --> 00:04:06,030
!أيّها العجوز

44
00:04:08,530 --> 00:04:11,320
!سُحقًا! لن أسمح بموتك
!لن أموت أيضًا

45
00:04:11,660 --> 00:04:13,840
!انتزع! انتزع

46
00:04:13,840 --> 00:04:15,830
!انس الأمر! هذا يكفي

47
00:04:17,000 --> 00:04:19,120
!انتزع

48
00:04:45,770 --> 00:04:48,070
...هذا مؤلم، مؤلم، مؤلم

49
00:04:58,620 --> 00:04:59,870
!أيّها العجوز

50
00:04:59,870 --> 00:05:02,460
!انتزعت الطّوقين

51
00:05:02,460 --> 00:05:05,340
!ماذا فعلتُ؟! هذا رائع

52
00:05:05,340 --> 00:05:07,670
!مرحى

53
00:05:09,260 --> 00:05:12,430
...لا أصدّق

54
00:05:13,090 --> 00:05:15,140
...أنّ ذلك كان

55
00:05:21,680 --> 00:05:23,560
!هربتَ ثانية

56
00:05:25,730 --> 00:05:28,440
!حسنًا! لنهرب أيّها العجوز

57
00:05:30,030 --> 00:05:31,400
!يا فتى قبّعة القشّ

58
00:05:32,950 --> 00:05:36,210
،قبل نسيانك لذلك الشّعور

59
00:05:36,210 --> 00:05:38,620
!احمني

60
00:05:38,620 --> 00:05:41,250
!ما الّذي تقوله؟! لنذهب

61
00:05:41,250 --> 00:05:44,420
!ستُكشَف قوّتك الحقيقيّة في لحظة أزمة

62
00:05:44,420 --> 00:05:46,730
!لن أسمح لك بالهرب

63
00:05:46,730 --> 00:05:49,260
!سأتدرّب الآن؟! هل أنت مجنون؟

64
00:05:49,260 --> 00:05:53,340
!ستموت إن فشلتُ

65
00:05:53,680 --> 00:05:54,970
!أنا مدرك لذلك

66
00:06:00,680 --> 00:06:03,350
!أريني ما لديك أيّتها اليونكو

67
00:06:04,350 --> 00:06:09,270
!أعجز عن القيام بما قام به ريلي حينها

68
00:06:27,960 --> 00:06:32,300
.سأنزع طوقك الآن
هل أنت جاهزة يا فتاة؟

69
00:06:33,010 --> 00:06:37,090
!تمهّل أيّها العجوز
!لا تتهوّر! سينفجر الطّوق

70
00:06:37,090 --> 00:06:40,560
!رأينا طوق عبد ينفجر من قبل

71
00:06:40,560 --> 00:06:43,310
!هذه فكرّة سيّئة! فكرة سيّئة للغاية

72
00:06:43,310 --> 00:06:45,480
!هل أنت واثق من هذا يا لوفي؟

73
00:06:46,980 --> 00:06:50,400
.لا داعي للقلق. لا تتحرّكي فحسب

74
00:06:53,230 --> 00:06:57,410
!سبق وأخبرتك أنّ الأمر خطير جدًّا
!لن يُنتزع بدون مفتاح

75
00:07:05,750 --> 00:07:09,540
!إنّه يرنّ! ما الّذي سنفعله؟

76
00:07:14,630 --> 00:07:16,340
!توقّف! توقّف

77
00:07:19,890 --> 00:07:23,100
!كيمي

78
00:07:30,480 --> 00:07:32,150
!انتزع الطّوق بيديه العاريتين؟

79
00:07:37,320 --> 00:07:38,890
!أجل

80
00:07:38,890 --> 00:07:43,080
!هذا بالضّبط ما فعله ريلي حينها

81
00:07:43,530 --> 00:07:45,660
!أقصد ما قمتُ به للتّوّ

82
00:07:46,000 --> 00:07:50,040
لم أقترب حتّى من إتقان ذلك
!حتّى بعد سنتين من التّدريب

83
00:07:50,710 --> 00:07:53,670
.كان ذلك هو ريو إذًا

84
00:07:53,670 --> 00:07:58,260
.لكنّني كنت يائسًا للغاية
!لا أذكر كيف قمت بذلك

85
00:07:59,720 --> 00:08:01,890
!لا يمكنك الهرب الآن

86
00:08:06,060 --> 00:08:10,980
...يا فتى قبّعة القشّ
...تقنية ريو الّتي أظهرتَها توًّا

87
00:08:10,980 --> 00:08:15,440
!كانت أعلى مكانة ممّا يمكنني تعليمك

88
00:08:15,860 --> 00:08:18,900
!لذا أنا واثق من قدرتك على إيقافها

89
00:08:18,900 --> 00:08:22,370
،صُدّ قبضة تلك المرأة الوحشيّة

90
00:08:22,740 --> 00:08:25,950
!وأنقذ حياتنا

91
00:08:26,540 --> 00:08:28,620
!واثق من مقدرتك

92
00:08:28,620 --> 00:08:33,250
!هيّا! لنرَ ما لديك

93
00:08:35,670 --> 00:08:37,050
!تعلم أنّك قد تموت؟

94
00:08:37,510 --> 00:08:38,590
!لا أمانع ذلك

95
00:08:39,880 --> 00:08:40,910
!حسنًا

96
00:08:40,910 --> 00:08:44,110
!هل يحاول صدّها؟
!يا للتّهوّر

97
00:08:44,110 --> 00:08:45,050
...كلاّ

98
00:08:45,050 --> 00:08:47,390
!واثق أنّ لوفي قادر على ذلك

99
00:08:49,020 --> 00:08:53,560
يجدر بي السّماح للهاكي بالتّدفّق
!لقبضتَيّ بدل محاولة إجهاد نفسي

100
00:08:54,150 --> 00:08:55,190
!هيّا

101
00:09:13,370 --> 00:09:15,000
!لوفيتارو-سان

102
00:09:15,960 --> 00:09:18,090
!لوفي

103
00:09:29,310 --> 00:09:31,890
!لوفي

104
00:09:31,890 --> 00:09:35,360
!كم هذا متوقّع

105
00:09:45,820 --> 00:09:47,700
!سُحقًا

106
00:09:52,120 --> 00:09:54,970
!آسف أيّها العجوز! لقد فشلت

107
00:09:54,970 --> 00:09:56,830
!لا تمت

108
00:09:59,920 --> 00:10:02,010
...هذا مؤلم، مؤلم، مؤلم

109
00:10:02,920 --> 00:10:04,630
!هل أنت بخير أيّها العجوز؟

110
00:10:05,800 --> 00:10:10,680
ا-استعملت الريو للحماية
...من باب الحيطة

111
00:10:10,680 --> 00:10:11,850
!أيّها العجوز

112
00:10:14,350 --> 00:10:16,900
!ما زلت حيًّا؟

113
00:10:20,860 --> 00:10:22,440
...استمع لي

114
00:10:24,860 --> 00:10:28,030
...كلّ ما يمكنني تعليمك

115
00:10:28,780 --> 00:10:33,090
هو أنّ تقنية الريو الّتي تغطّي
...الجزء الخارجيّ من جسدك

116
00:10:33,090 --> 00:10:34,680
...إنّه ما تدعونه أنتم الهاكي

117
00:10:34,680 --> 00:10:36,170
!كفّ عن الكلام

118
00:10:38,920 --> 00:10:40,460
...الهاكي

119
00:10:40,920 --> 00:10:47,340
قوّة شديدة للغاية تحميك كدرع خفيّ
.ويمكن استعمالها للهجوم أيضًا

120
00:10:53,530 --> 00:10:57,360
،سيصبح الهاكي الّذي يغطّيك أقوى بكثير

121
00:10:57,360 --> 00:11:03,530
!وسيدخل جسد العدوّ ويدمّره من الدّاخل

122
00:11:05,450 --> 00:11:08,540
...سابقًا، ذلكما الطّوقان الفولاذيّان

123
00:11:08,540 --> 00:11:14,080
!دُمّرا من الدّاخل باستعمال الهاكي خاصّتك

124
00:11:16,710 --> 00:11:19,460
!أتقنت الأمر سلفًا

125
00:11:21,250 --> 00:11:22,550
...أيّها العجوز

126
00:11:22,550 --> 00:11:28,760
!اكتسبتَ سلفًا الهاكي الّذي يغطّي جسمك

127
00:11:31,100 --> 00:11:33,260
...لا تدرك الأمر بعد فحسب

128
00:11:36,180 --> 00:11:39,810
!ثق بقوّتك

129
00:11:44,820 --> 00:11:46,570
!مهلاً! لا تمت

130
00:11:46,570 --> 00:11:48,780
!أيّها العجوز

131
00:11:49,200 --> 00:11:52,910
!هل مات أخيرًا؟! هيوغورو الزّهرة

132
00:12:00,040 --> 00:12:01,670
!أيّها العجوز! أجبني

133
00:12:01,670 --> 00:12:04,880
!لا تتركني أيّها العجوز! أجبني

134
00:12:14,510 --> 00:12:18,060
!أيّها العجوز! لا تمت! هيّا

135
00:12:18,560 --> 00:12:21,650
!أيّها العجوز

136
00:12:52,890 --> 00:12:54,800
!أيّها العجوز

137
00:12:54,800 --> 00:12:56,970
!لا تمت أيّها العجوز

138
00:12:56,970 --> 00:13:01,140
!هيّا! لا تتركني! أيّها العجوز

139
00:13:03,020 --> 00:13:04,520
!أجبني! لا تمت

140
00:13:04,690 --> 00:13:05,610
!هيّا

141
00:13:06,020 --> 00:13:09,360
!أيّها العجوز

142
00:13:12,950 --> 00:13:17,160
كيف تجرؤ على تناول حساء الفاصولياء
!الحمراء الّذي كان من حقّي وحقّ الآخرين؟

143
00:13:21,580 --> 00:13:23,540
!لن أسامحك

144
00:13:28,760 --> 00:13:31,380
!حظًّا سعيدًا يا فتى قبّعة القشّ

145
00:13:31,760 --> 00:13:33,890
!أنت حيّ! حمدًا على هذا

146
00:13:37,430 --> 00:13:39,810
!أفلتّ منّي ثانية

147
00:13:40,560 --> 00:13:42,350
!لن أسامحك

148
00:13:42,350 --> 00:13:46,730
!تبًّا! إنّه حيّ! يا لهيوغورو اللّعين ذاك

149
00:13:46,730 --> 00:13:48,860
!كم هذا مزعج

150
00:14:00,410 --> 00:14:02,890
!سُحقًا! استسلم فحسب

151
00:14:02,890 --> 00:14:05,830
!حساء الفاصولياء الحمراء

152
00:14:18,810 --> 00:14:21,490
!أنت، لا يمكنني الاتّصال

153
00:14:21,490 --> 00:14:25,290
!سمعت أنّ الحلزون الزّعيم اختفى

154
00:14:25,290 --> 00:14:26,060
!ماذا؟

155
00:14:45,830 --> 00:14:47,420
!لماذا تهتزّ الأرض؟

156
00:15:17,280 --> 00:15:19,570
!بـ-بيغ مام؟

157
00:15:21,700 --> 00:15:23,370
!توقّف

158
00:15:25,250 --> 00:15:28,210
!لن أدعك تفلت

159
00:15:30,590 --> 00:15:32,390
.هذه مصيبة لا رادع لها الآن

160
00:15:32,390 --> 00:15:36,010
من ذلك الشّابّ؟

161
00:15:42,430 --> 00:15:46,740
!انفجر الفرن في سجن ورشات التّنقيب عن الحديد

162
00:15:46,740 --> 00:15:50,650
!وماذا بوسعنا فعله؟
!بيغ مام واحدة من اليونكو

163
00:15:58,780 --> 00:16:04,240
...حتّى كوين-ساما لم يكن ندًّا لها
!لا فرصة أمامنا لإيقافها

164
00:16:11,580 --> 00:16:13,500
!كـ-كوين-ساما

165
00:16:13,500 --> 00:16:16,720
.بلاد وانو منطقة تابعة لكايدو-سان

166
00:16:16,720 --> 00:16:20,300
!لن أسمح لتلك الشّمطاء بفعل ما يحلو لها

167
00:16:23,300 --> 00:16:26,140
!توقّف

168
00:16:37,150 --> 00:16:39,450
.لديّ خطّة

169
00:16:39,450 --> 00:16:42,820
.أمامنا فرصة واحدة فقط
!أصغوا إليّ بإمعان

170
00:16:47,000 --> 00:16:50,290
!لا يمكنك الهرب منّي يا شقيّ

171
00:17:01,090 --> 00:17:04,850
!إنّ بيغ مام أشبه بخنزير برّيّ الآن

172
00:17:13,860 --> 00:17:18,990
ستندفع قُدمًا حول أودون
!وستدور في دوائر

173
00:17:18,990 --> 00:17:21,280
!لذلك جهّزوا فخًّا لها هنا

174
00:17:23,240 --> 00:17:25,990
!سأتخلّص منها

175
00:17:28,790 --> 00:17:29,700
!سُحقًا لك

176
00:17:29,810 --> 00:17:32,040
!خذ هذا

177
00:17:37,880 --> 00:17:39,380
!انتظر

178
00:17:44,010 --> 00:17:45,600
!علينا إيقاف أولين-سان

179
00:17:46,800 --> 00:17:50,520
!مهلاً! لا يمكننا منافستها

180
00:17:50,520 --> 00:17:52,810
!دعي أمرها للوفيتارو

181
00:17:57,940 --> 00:18:00,440
!يا له من فتى مثير للاهتمام

182
00:18:00,780 --> 00:18:06,200
!قلب موازين وضعٍ فظيع بمفرده

183
00:18:18,800 --> 00:18:20,460
!يمكننا الخروج الآن

184
00:18:20,460 --> 00:18:21,420
!ممتاز

185
00:18:21,420 --> 00:18:26,140
!واصلوا! واصلوا

186
00:18:52,870 --> 00:18:56,580
!كوين-ساما! نحن جاهزون

187
00:19:06,590 --> 00:19:08,720
!كوين-ساما! لقد وصلت

188
00:19:17,730 --> 00:19:20,060
!سُحقًا! إنّها مثابرة للغاية

189
00:19:20,060 --> 00:19:22,280
!توقّف

190
00:19:34,580 --> 00:19:40,920
!حساء الفاصولياء الحمراء

191
00:19:43,460 --> 00:19:44,840
!أجل! تناولت الطُّعم

192
00:19:46,260 --> 00:19:47,470
!مرحى

193
00:19:53,560 --> 00:19:54,640
!القِدر فارغ

194
00:19:57,560 --> 00:20:00,650
!تناولتَه كلّه ثانية

195
00:20:02,230 --> 00:20:03,570
!اللّعنة عليك

196
00:20:03,570 --> 00:20:05,940
!كلاّ! لم أتناول أيًّا من ذلك

197
00:20:07,150 --> 00:20:08,610
...انفجار

198
00:20:10,700 --> 00:20:12,240
