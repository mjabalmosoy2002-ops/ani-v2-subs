1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:01,690 --> 00:02:06,260
حوّل أودن أرض كوري الخارجة عن
،القانون إلى مكان صالح للعيش

29
00:02:06,260 --> 00:02:11,950
ومُنح لقب دايميو كوري من طرف
.كوزكي سوكياكي، الشّوغن وقتها

30
00:02:24,670 --> 00:02:32,140
في تلك البحار الواسعة، لا بدّ من وجود
!أمور استثنائيّة تفوق مخيّلتي

31
00:02:35,940 --> 00:02:38,190
!أريد رؤيتها

32
00:02:38,810 --> 00:02:41,020
!أريد أن أختبر العالم

33
00:02:46,150 --> 00:02:49,120
تسلّقنا الشّلاّلات، صحيح؟

34
00:02:52,370 --> 00:02:56,160
فلماذا هنالك بحر وجزيرة هنا؟

35
00:03:01,420 --> 00:03:02,750
...أيعقل أنّهم

36
00:03:05,300 --> 00:03:07,680
!لدينا مشكلة يا كانجورو-دونو

37
00:03:08,970 --> 00:03:09,800
ما هي؟

38
00:03:10,140 --> 00:03:12,430
!اهدأ، صوتك مرتفع جدًّا

39
00:03:12,710 --> 00:03:16,210
وصلنا بلاغ بأنّ سفينة قراصنة
!رست في ميناء إيتاتشي

40
00:03:16,210 --> 00:03:17,520
!قراصنة؟

41
00:03:22,570 --> 00:03:25,440
!أودن-ساما! إلى أين تذهب؟

42
00:03:25,820 --> 00:03:27,280
!إلى الميناء

43
00:03:28,820 --> 00:03:31,280
!هيّا! هيّا

44
00:03:32,700 --> 00:03:35,370
!حسنًا، سنذهب لإحضار الطّعام والمؤن

45
00:03:35,370 --> 00:03:37,250
!سآتي أيضًا

46
00:03:37,250 --> 00:03:40,210
!لا يمكنك. أنت مجرّد متدرّب

47
00:03:40,210 --> 00:03:41,750
!لا تقولي ذلك

48
00:03:41,750 --> 00:03:44,510
!يا والدي! أيمكنني الذّهاب؟

49
00:03:44,510 --> 00:03:46,510
.افعل ما يحلو لك

50
00:03:47,220 --> 00:03:50,050
!حسنًا! لننطلق

51
00:03:47,630 --> 00:03:50,050
!بسرعة! بسرعة

52
00:03:50,050 --> 00:03:53,180
!قلتُ لا يسمح للمتدرّبين بالمجيء! ابق هنا

53
00:03:53,550 --> 00:03:57,230
!ماذا؟! ذهب أودن-ساما إلى الميناء؟

54
00:03:58,060 --> 00:03:59,730
!لماذا سمحت له بالذّهاب؟

55
00:03:59,730 --> 00:04:02,110
!سمعتُ أنّه توجد سفينة قراصنة في ميناء إيتاتشي

56
00:04:02,110 --> 00:04:03,560
!إنّها لا تشبه السّفن الأخرى

57
00:04:03,560 --> 00:04:05,690
!قيل أنّها كبيرة وقراصنتها أشدّاء

58
00:04:06,280 --> 00:04:07,660
!علينا إيقافه

59
00:04:07,660 --> 00:04:10,410
!ذهب لطردهم فحسب، صحيح؟

60
00:04:10,410 --> 00:04:13,200
...مستحيل! أنا واثق أنّك على دراية

61
00:04:14,030 --> 00:04:15,540
!بحلم أودن-ساما

62
00:04:20,210 --> 00:04:23,210
!أهذه هي؟! سفينة قراصنة؟

63
00:04:23,210 --> 00:04:25,250
...انتظرتُ

64
00:04:25,960 --> 00:04:28,630
!هذه اللّحظة طويلاً

65
00:04:30,130 --> 00:04:31,550
!نحن في ورطة

66
00:04:33,300 --> 00:04:35,260
!تراجعوا يا رجال

67
00:04:36,600 --> 00:04:38,870
!ثمّة شخص قادم

68
00:04:38,870 --> 00:04:40,810
!شخص غير عاديّ بالمرّة

69
00:04:40,810 --> 00:04:42,590
!مرحبًا

70
00:04:42,590 --> 00:04:48,070
أنا جدّ سعيد لتمكّنكم من الوصول
!إلى هنا رغم الجوّ السّيّئ والشّلاّلات

71
00:05:06,210 --> 00:05:08,800
!كنتُ في انتظاركم

72
00:05:08,800 --> 00:05:10,970
!أيّها القراصنة

73
00:05:41,500 --> 00:05:43,580
!أوقفتَ سيفي

74
00:05:43,920 --> 00:05:45,250
!مثير للإعجاب

75
00:05:46,710 --> 00:05:49,500
!أيّها العجوز! أنت مذهل

76
00:05:52,090 --> 00:05:56,260
!كيف يجرؤ على السّخرية من والدنا؟
!سأجعله يدفع الثّمن

77
00:05:57,930 --> 00:05:59,560
!أودن-ساما

78
00:06:00,850 --> 00:06:02,730
!الإشاعة صحيحة، إنّهم قراصنة

79
00:06:03,480 --> 00:06:05,560
!لا تعترض طريقي يا كينييمون

80
00:06:06,770 --> 00:06:07,810
!أودن-ساما؟

81
00:06:08,400 --> 00:06:11,070
...لقد استخفّ بي

82
00:06:13,400 --> 00:06:16,320
!أرني ما لديك أيّها الشّقيّ

83
00:06:45,440 --> 00:06:48,440
!كنتُ في انتظار شخص مثلك

84
00:06:48,940 --> 00:06:51,460
!اسمي كوزكي أودن

85
00:06:51,460 --> 00:06:54,190
...لا أعرف من تكون، لكن اسمح لي

86
00:06:54,740 --> 00:06:56,070
!بالإبحار على سفينتك

87
00:07:09,960 --> 00:07:12,420
!أسلوب أودن ذو السّيفين

88
00:07:14,710 --> 00:07:17,380
!شلاّل الفردوس

89
00:08:17,320 --> 00:08:19,070
!أنت مزعج

90
00:08:19,610 --> 00:08:22,240
!ابتعد عن ناظريّ

91
00:08:24,200 --> 00:08:25,350
!اللّعنة عليك

92
00:08:25,350 --> 00:08:27,850
!من تظنّه في رأيك؟

93
00:08:27,850 --> 00:08:31,420
!إنّه دايميو كوري، كوزكي أودن-ساما

94
00:08:31,420 --> 00:08:35,950
!هل تعرف عواقب تصويب سيف في وجهه؟

95
00:08:35,950 --> 00:08:38,010
إنّه دايميو؟

96
00:08:38,420 --> 00:08:42,260
!أيّها القراصنة الأوغاد
!غادروا هذه البلاد في الحال

97
00:08:42,260 --> 00:08:46,390
...سُحقًا لكم! سأجعلكم تندمون

98
00:08:46,390 --> 00:08:48,850
!على عبثكم مع قراصنة اللّحية البيضاء

99
00:08:52,810 --> 00:08:56,770
!أريد اكتشاف العالم! إنّه حلمي

100
00:08:58,610 --> 00:09:00,800
!لنبحر معًا

101
00:09:00,800 --> 00:09:02,950
!علينا المغادرة حالاً

102
00:09:03,360 --> 00:09:05,910
!لا يمكنك ذلك

103
00:09:06,370 --> 00:09:07,410
!اخرسوا

104
00:09:08,120 --> 00:09:10,930
!أريد مغادرة هذه الأرض المليئة بالقيود

105
00:09:10,930 --> 00:09:13,710
!أريد رؤية العالم الحرّ

106
00:09:15,210 --> 00:09:17,630
!رجاءً! خذوني معكم

107
00:09:20,380 --> 00:09:23,720
!يا هذا! أولم تحاول قتل قبطاننا للتّوّ؟

108
00:09:23,720 --> 00:09:24,760
!أتوسّل إليكم

109
00:09:24,760 --> 00:09:27,600
!توقّف! إنّه قرصان

110
00:09:28,430 --> 00:09:31,520
!أنتم مصدر إزعاج! غادروا هذه البلاد حالاً

111
00:09:33,020 --> 00:09:35,610
...أتمنّى لو أستطيع

112
00:09:36,690 --> 00:09:41,490
لكنّ سفينتنا تحطّمت في طريقنا
!إلى هنا ولا يمكننا الذّهاب لأيّ مكان

113
00:09:41,990 --> 00:09:44,950
!هذا مؤسف! لنصلحها بسرعة

114
00:09:46,320 --> 00:09:49,700
...تبًّا! إن بقيتم هنا، فإنّ أودن-ساما

115
00:09:50,370 --> 00:09:52,870
!أصلحوها في الحال وغادروا

116
00:09:54,040 --> 00:09:56,580
.حسنًا، سنفعل ذلك

117
00:10:02,010 --> 00:10:04,880
!هيّا! احملوها إلى هناك

118
00:10:05,680 --> 00:10:08,640
!عفوًا! أيّها-غارا الرّفاق

119
00:10:09,470 --> 00:10:11,520
!حان وقت الأكل

120
00:10:12,270 --> 00:10:15,100
!هيّا، تفضّلوا

121
00:10:16,850 --> 00:10:18,770
!يبدو لذيذًا

122
00:10:24,820 --> 00:10:27,870
!هذا هو الأودن الخاصّ بأودن-ساما

123
00:10:31,950 --> 00:10:35,250
ما كان الأودن ليُسمّى أودن
!إن لم يكن يغلي! تفضّلوا

124
00:10:35,830 --> 00:10:38,000
هل أعجبك أيّها اللّحية البيضاء؟

125
00:10:38,000 --> 00:10:40,420
!شكرًا لك يا أودن

126
00:10:44,010 --> 00:10:48,310
!لم أتذوّق شيئًا كهذا من قبل
!هذا هو إذًا مذاق بلاد أجنبيّة

127
00:10:48,310 --> 00:10:50,270
.إنّه خمر مصنوع من العنب

128
00:10:50,270 --> 00:10:54,060
!ثمّة أمور عدّة أجهلها، صحيح؟

129
00:10:55,520 --> 00:10:57,080
!لنخض غمار البحر

130
00:10:57,080 --> 00:11:00,860
!أرني العالم الّذي لم أره من قبل

131
00:11:00,860 --> 00:11:05,190
!لستَ من النّوع الّذي يخدم تحت إمرة شخص آخر

132
00:11:05,190 --> 00:11:07,410
...إن أبحرت معنا

133
00:11:09,030 --> 00:11:12,120
...عندما يجتمع أشخاص أنانيّون مثلك معًا

134
00:11:12,120 --> 00:11:12,580
!يا ويلي

135
00:11:13,160 --> 00:11:15,250
فما الّذي سيحلّ بالفريق؟

136
00:11:18,290 --> 00:11:20,960
!هذا ساخن جدًّا

137
00:11:22,800 --> 00:11:27,260
تعلّمتُ ذلك بالطّريقة الصّعبة في طاقم
.القراصنة الّذي كنتُ فيه سابقًا

138
00:11:30,350 --> 00:11:32,180
!خض غمار البحر وحدك

139
00:11:33,930 --> 00:11:36,700
!لو أمكنني ذلك، لكنتُ قد فعلته سلفًا

140
00:11:36,700 --> 00:11:39,580
!حاولت عشرات المرّات، لكنّني فشلت

141
00:11:39,580 --> 00:11:42,690
!لا أملك أيّ مهارات للإبحار بسفينة

142
00:11:43,110 --> 00:11:46,160
!استسلم إذًا وأدِّ عملك كدايميو

143
00:11:46,160 --> 00:11:48,840
!ثمّة عدّة قيود في هذه البلاد

144
00:11:48,840 --> 00:11:51,200
!لا يمكنني تحمّلها! خذوني معكم

145
00:11:51,200 --> 00:11:52,680
!أيّها اللّحية البيضاء

146
00:11:52,680 --> 00:11:56,370
!لبلاد وانو قانون صارم يمنع النّاس من مغادرتها

147
00:11:57,080 --> 00:12:02,540
،إنّ أودن-ساما هو دايميو كوري الآن
!لذلك لن يُغفر له إن خرق هذا القانون

148
00:12:02,540 --> 00:12:04,250
!لا تخبره بذلك

149
00:12:05,760 --> 00:12:10,010
!سرّتني معرفة ذلك! تفكيرنا متشابه

150
00:12:10,010 --> 00:12:12,930
!لا أنوي اصطحاب أودن معي أيضًا

151
00:12:14,350 --> 00:12:17,390
!لا أهتمّ لقوانين هذه البلاد

152
00:12:18,810 --> 00:12:23,610
أودن، ما زال لديك عمل لتؤدّيه هنا، صحيح؟

153
00:12:23,610 --> 00:12:24,230
!ماذا؟

154
00:12:24,230 --> 00:12:30,150
أودن-ساما شخص لا غنى عنه
.في كوري وفي بلاد وانو بأكملها

155
00:12:31,610 --> 00:12:33,910
!اخرس يا كينييمون

156
00:12:34,450 --> 00:12:37,560
!دعني أبحر على متن سفينتك أيّها اللّحية البيضاء

157
00:12:37,560 --> 00:12:39,520
!لا

158
00:12:39,520 --> 00:12:42,710
!سأخوض غمار البحر

159
00:12:43,170 --> 00:12:47,170
!تكاد قيود هذه البلاد تخنقني
!لا أريد العودة للدّيار

160
00:12:47,880 --> 00:12:51,090
!فكّوا وثاقي! توقّفوا

161
00:12:55,220 --> 00:12:56,680
!افتحوها

162
00:12:58,560 --> 00:13:00,230
!لن أستسلم

163
00:13:03,770 --> 00:13:05,320
!انتظروني

164
00:13:05,690 --> 00:13:08,110
!أيّها اللّحية البيضاء

165
00:13:25,710 --> 00:13:28,000
!خمس جُزر في العالم؟

166
00:13:30,670 --> 00:13:32,470
!هذا خاطئ تمامًا

167
00:13:32,470 --> 00:13:33,470
!ماذا؟

168
00:13:33,470 --> 00:13:37,980
!ثمّة أزيد من عشرة أو عشرين مليون

169
00:13:37,980 --> 00:13:39,810
!ثمّة جُزر بهذا القدر؟

170
00:13:40,310 --> 00:13:42,910
لا تعرفان أيّ شيء؟

171
00:13:42,910 --> 00:13:46,190
!المغامرات ممتعة! لا بدّ أنّك مهتمّ

172
00:13:46,810 --> 00:13:48,690
!بالطّبع أنا مهتمّ

173
00:13:49,530 --> 00:13:50,450
!توقّف

174
00:13:50,450 --> 00:13:53,070
!لن أدعك تذهب

175
00:13:55,070 --> 00:13:57,120
!هذا يكفي

176
00:13:58,080 --> 00:14:00,160
!العالم الواسع

177
00:14:00,750 --> 00:14:05,080
!لا يستطيع أيّ أحد عدّ الجزر الموجودة فيه

178
00:14:05,420 --> 00:14:09,000
...مـ-مـ-مهلاً لحظة

179
00:14:16,340 --> 00:14:19,330
!أبليتم حسنًا يا رجال

180
00:14:19,330 --> 00:14:23,520
!اكتملت إصلاحات سفينة موبي ديك

181
00:14:24,350 --> 00:14:26,480
!استعدّوا الآن

182
00:14:26,480 --> 00:14:29,480
!سوف نبحر

183
00:14:36,360 --> 00:14:37,910
!إلى أين العزم يا ترى؟

184
00:14:37,910 --> 00:14:39,290
!ماذا؟ إيزو

185
00:14:39,290 --> 00:14:41,490
إلى أين تذهب يا أودن-ساما؟

186
00:14:41,490 --> 00:14:43,040
!لقد أخفتني

187
00:14:43,040 --> 00:14:45,790
ربّما ذلك صحيح، لكن إلى أين العزم؟

188
00:14:46,710 --> 00:14:51,550
!دعني أذهب للحمّام متى أشاء
!أولستُ الدّايميو؟

189
00:14:51,550 --> 00:14:54,970
.أنا أعتذر... جوّ اللّيل بارد

190
00:14:56,720 --> 00:14:58,760
!عليّ أن أتبوّل

191
00:15:02,520 --> 00:15:05,520
،أشعر بالسّوء حيال أودن
.لكن علينا المغادرة خلسة في اللّيل

192
00:15:08,020 --> 00:15:12,480
.نظرًا لقوتّه، لربّما كان إضافة نافعة لنا

193
00:15:13,280 --> 00:15:17,700
...كما أنّه حاز على إعجاب والدنا

194
00:15:17,700 --> 00:15:19,740
!ماذا؟! عمّ تتحدّث؟

195
00:15:20,200 --> 00:15:22,160
!لا تدّعِ الغباء

196
00:15:26,960 --> 00:15:30,710
،حتّى إن كان قد حاز على إعجابي

197
00:15:31,250 --> 00:15:35,070
...الأمر أقرب لاختطاف فرد من أسرة مالكة

198
00:15:35,070 --> 00:15:37,090
.سيكون الثّمن الّذي سندفعه باهظًا

199
00:15:37,590 --> 00:15:40,010
هل تركتم صندوق الكنز كعربون شكر؟

200
00:15:40,010 --> 00:15:43,680
...لقد قدّموا لنا طعامًا وأخشابًا

201
00:15:49,600 --> 00:15:50,690
!ما الّذي يحدث؟

202
00:15:50,690 --> 00:15:54,210
!عرفتُ أنّك ستفعل هذا

203
00:15:54,210 --> 00:15:56,280
!أيّها اللّحية البيضاء

204
00:15:56,990 --> 00:15:57,860
!أودن؟

205
00:15:57,860 --> 00:16:00,600
!دعني أبحر على متن سفينتك

206
00:16:00,600 --> 00:16:05,680
!أودن-ساما! عرفتُ أنّك ستفعل هذا

207
00:16:05,680 --> 00:16:06,750
!لن أسمح لك بالذّهاب

208
00:16:09,750 --> 00:16:10,880
!ذلك الغبيّ

209
00:16:11,670 --> 00:16:12,880
!اصطحبني معكم

210
00:16:12,880 --> 00:16:15,340
!أرني العالم

211
00:16:15,340 --> 00:16:19,430
!عد رجاءً! أنت الشّوغن التّالي

212
00:16:19,430 --> 00:16:21,530
!يا له من تهوّر

213
00:16:21,530 --> 00:16:24,810
.مع السّلامة يا أودن! استسلم وعد أدراجك

214
00:16:24,810 --> 00:16:26,390
!انتظر يا ماركو

215
00:16:27,020 --> 00:16:31,690
!أحضر الشّخص الّذي أتى خلفه

216
00:16:33,690 --> 00:16:35,190
...يا إلهي

217
00:16:35,780 --> 00:16:38,460
!تشبّثوا بالسّفينة جميعًا

218
00:16:38,460 --> 00:16:41,580
!هذا ليس وقتًا مناسبًا لكم لتقلقوا حيال الآخرين

219
00:16:41,580 --> 00:16:44,870
!إنّنا نحلّق فوق الشّلاّلات

220
00:16:48,160 --> 00:16:50,210
!لا، لا، لا، مصيبة

221
00:16:55,750 --> 00:16:58,630
!أنت! لماذا أنقذتني؟

222
00:16:59,630 --> 00:17:00,800
!أودن-ساما

223
00:17:00,800 --> 00:17:03,510
!النّجدة

224
00:17:07,100 --> 00:17:09,230
!اختفى أودن-ساما

225
00:17:09,230 --> 00:17:12,190
!غادرت سفينة اللّحية البيضاء الميناء أيضًا

226
00:17:12,190 --> 00:17:14,440
!كنتُ أخشى حدوث هذا

227
00:17:15,110 --> 00:17:18,860
أخي الكبير إيزو... وإينو-تشان
!ونيكو-تشان اختفوا أيضًا

228
00:17:18,860 --> 00:17:20,800
!لا داعي للبكاء يا أوكيكو

229
00:17:20,800 --> 00:17:24,290
!لنبحث عنهم بدل أن نتوقّع حدوث الأسوأ

230
00:17:24,290 --> 00:17:25,620
مفهوم؟

231
00:17:25,620 --> 00:17:26,450
.نعم

232
00:17:26,450 --> 00:17:30,370
!ابحثوا! ابحثوا في أرجاء البلاد

233
00:17:39,210 --> 00:17:43,590
!أيّها اللّحية البيضاء
!اسحب أودن-ساما! سوف يموت

234
00:17:44,050 --> 00:17:47,810
!إنّه يحمل مستقبل بلاد وانو على عاتقه

235
00:17:48,600 --> 00:17:52,390
رأيتني أرفض طلبه مرارًا أيّها الفتى، صحيح؟

236
00:17:52,770 --> 00:17:56,380
!لكنّه غادر البلاد رغم ذلك

237
00:17:56,380 --> 00:18:00,150
!لذلك لنخضع لقوانيننا نحن

238
00:18:03,700 --> 00:18:05,490
...سُحقًا

239
00:18:06,370 --> 00:18:07,780
!أرجوك

240
00:18:08,080 --> 00:18:14,540
لا يمكنني قبول رجل خطير مثله
.ببساطة وتعريض عائلتي للأخطار

241
00:18:15,120 --> 00:18:18,170
.إن كنتَ تريد إيقافه، فعليك إقناعه

242
00:18:20,050 --> 00:18:21,960
!اسمع يا أودن

243
00:18:22,970 --> 00:18:24,530
!أمامك ثلاثة أيّام

244
00:18:24,530 --> 00:18:29,890
سأرحّب بك على السّفينة إن تمكّنت
!من التّشبّث بتلك السّلسلة لثلاثة أيّام

245
00:18:32,930 --> 00:18:35,690
!أأنت واثق أيّها اللّحية البيضاء؟

246
00:18:36,310 --> 00:18:38,860
!نعم، أعدك بذلك

247
00:19:20,820 --> 00:19:23,690
!سأصعد على متن تلك السّفينة

248
00:19:24,150 --> 00:19:27,820
!انتظرني أيّها اللّحية البيضاء

249
00:19:38,880 --> 00:19:41,130
أما زال أودن هناك؟

250
00:19:42,880 --> 00:19:44,610
...نعم، ما زال

251
00:19:44,610 --> 00:19:46,380
...لكنّه يبدو في حالة سيّئة

252
00:19:47,010 --> 00:19:51,740
انتفخ وجهه ولا يمكن التّعرّف عليه
!بسبب الاصطدامات والمياه

253
00:19:51,740 --> 00:19:53,370
!وكأنّه يوشك أن ينفجر

254
00:19:53,370 --> 00:19:56,120
!بقيت لك ساعة فقط

255
00:19:56,120 --> 00:19:59,020
!تمسّك يا أودن

256
00:19:59,020 --> 00:20:01,530
!مهلاً، لماذا تشجّعه؟

257
00:20:01,530 --> 00:20:05,400
،لأنّه إن نجح في ذلك
فسيصير فردًا من طاقمنا، صحيح؟

258
00:20:05,740 --> 00:20:08,070
!سيصبح أودن فردًا من طاقمنا

259
00:20:11,370 --> 00:20:15,240
سيصبح أودن فردًا من طاقمنا؟

260
00:20:20,630 --> 00:20:26,710
!تمسّك يا أودن

261
00:20:31,180 --> 00:20:33,680
!لا تستسلم يا أودن

262
00:20:37,350 --> 00:20:38,810
...أولئك الحمقى

263
00:20:41,520 --> 00:20:45,840
لن أسامحك لأنّك جعلت سيّدي
!يمرّ بكلّ هذه المشاقّ

264
00:20:45,840 --> 00:20:46,940
!أيّها اللّحية البيضاء

265
00:20:51,280 --> 00:20:54,620
!واصل يا أودن

266
00:20:54,620 --> 00:20:55,370
!أودن

267
00:20:55,370 --> 00:20:56,910
!بقي القليل

268
00:20:56,910 --> 00:20:58,750
!أودن

269
00:20:59,710 --> 00:21:01,250
!أودن-ساما

270
00:21:03,790 --> 00:21:06,380
!اتركني! لا تلمسني

271
00:21:17,310 --> 00:21:19,540
!يا لجمالك

272
00:21:19,540 --> 00:21:21,520
!راقية جدًّا

273
00:21:21,980 --> 00:21:24,000
!لماذا تهربين أيّتها المرأة؟

274
00:21:24,000 --> 00:21:28,360
!سنأخذك إلى بلاد وانو على سفينة كما أردت

275
00:21:28,780 --> 00:21:32,550
!تعالي! لا نريد أذيّتك

276
00:21:32,550 --> 00:21:34,160
!أعرف أنّكم لن تؤذوني

277
00:21:34,530 --> 00:21:36,740
!هذه سفينة عبيد

278
00:21:37,080 --> 00:21:39,540
!إن آذيتموني، فسينخفض ثمني

279
00:21:40,040 --> 00:21:43,620
لا أصدّق أنّني سمحت لنفسي
!أن أنخدع بأنذال أشرار مثلكم

280
00:21:43,620 --> 00:21:45,080
!يا لحُمقي

281
00:21:48,050 --> 00:21:51,780
!لا يوجد خلفك سوى البحر
!لا ملاذ لك تلجئين له

282
00:21:51,780 --> 00:21:53,510
!استسلمي فحسب

283
00:21:53,510 --> 00:21:56,040
!كلاّ، لديّ مكان أهرب إليه

284
00:21:56,040 --> 00:22:00,500
!المكان الوحيد الّذي تنتمين إليه هو سفينتنا

285
00:22:00,500 --> 00:22:03,440
!سنعاملك بكلّ لطف

286
00:22:04,520 --> 00:22:08,400
.هذه النّهاية... سأنتقل للمستقبل ثانية

287
00:22:20,120 --> 00:22:22,460
!ما-ما-ما هذا الشّيء؟

288
00:22:32,130 --> 00:22:35,130
!روح بحر

289
00:22:37,300 --> 00:22:41,730
...سمعتُ صوت امرأة... طالبة النّجدة

290
00:22:41,730 --> 00:22:42,600
!وحش؟

291
00:22:46,650 --> 00:22:48,630
!هل أنت بخير؟

292
00:22:49,980 --> 00:22:52,900
لم تتأذّي، صحيح؟

293
00:23:04,410 --> 00:23:10,020
!بدأت مغامرة أودن العظيمة
!التقى بأشخاص جدد وواجه تحدّيات

294
00:23:10,020 --> 00:23:13,990
!سافر عبر عالم مجهول يفوق مخيّلته بكثير

295
00:23:13,990 --> 00:23:17,860
أصبحت قصّة مفتعل المشاكل أودن
،معروفة في كلّ العالم في وقت وجيز

296
00:23:17,860 --> 00:23:22,220
!ووصلت أخيرًا لهذا الرّجل

297
00:23:22,430 --> 00:23:23,600
:في الحلقة القادمة من وان بيس

298
00:23:23,600 --> 00:23:26,560
!أخو اللّحية البيضاء الصّغير"
"!مغامرة أودن العظيمة

299
00:23:27,080 --> 00:23:29,520
!ملك القراصنة، لن يكون إلاّ أنا