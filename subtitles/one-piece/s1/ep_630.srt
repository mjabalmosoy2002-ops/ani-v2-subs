.البحر العاتي حيث يبسط اليونكو سيطرتهم

44
00:03:20,830 --> 00:03:25,110
بعد إمساكهم بسيزار رفقة حليفهم
،القرصان ترافالغار لو

45
00:03:25,110 --> 00:03:29,800
.وصلوا أخيرًا إلى وجهتهم التّالية، دريسروزا

46
00:03:31,990 --> 00:03:36,790
"!استكشاف! مملكة الحبّ والشّغف دريسروزا"

47
00:03:51,990 --> 00:03:55,330
!وصلنا إلى دريسروزا

48
00:03:55,580 --> 00:04:00,400
!صوتك مرتفع جدًّا يا لوفي
!نحن في منطقة العدوّ الآن

49
00:04:03,020 --> 00:04:04,170
...يا إلهي

50
00:04:07,480 --> 00:04:09,190
...هذا الأسبوع، أنا

51
00:04:09,590 --> 00:04:11,580
!خارق

52
00:04:11,580 --> 00:04:15,330
!سأجد المصنع في الحال وسأفجّره

53
00:04:15,330 --> 00:04:17,920
!إنّ أصواتكم عالية جدًّا يا رفاق

54
00:04:18,270 --> 00:04:21,640
علينا الذّهاب للبلدة فحسب، صحيح؟

55
00:04:21,640 --> 00:04:22,320
.نعم

56
00:04:22,640 --> 00:04:25,120
.اسمعوا، لا ترخوا دفاعاتكم

57
00:04:25,600 --> 00:04:29,390
،إن فشلنا في تدمير المصنع
.فسيفسد ذلك خطّتنا بالكامل

58
00:04:29,390 --> 00:04:30,860
!صحيح

59
00:04:30,930 --> 00:04:33,130
!اسمع! راودتني فكرة للتّوّ

60
00:04:33,660 --> 00:04:35,220
!مومو

61
00:04:39,270 --> 00:04:42,890
!حسنًا، هيّا يا مومو! إلى البلدة بدون توقّف

62
00:04:42,890 --> 00:04:44,820
!طر

63
00:04:45,680 --> 00:04:47,760
!أنت ثقيل! انزل عنّي

64
00:04:47,760 --> 00:04:50,750
!لا يمكنني الطّيران ولن أدخل هذه الجزيرة

65
00:04:50,750 --> 00:04:52,650
!منعني أبي من ذلك

66
00:04:52,650 --> 00:04:54,950
!لا يمكنك الطّيران؟! ما الّذي تقوله؟

67
00:04:55,890 --> 00:04:58,260
!رأيتك تطير بالفعل

68
00:04:58,800 --> 00:05:01,910
!لا أعلم عمّ تتكلّم! قلتُ لك لا أستطيع

69
00:05:01,910 --> 00:05:04,450
!رأيته يطير بالفعل

70
00:05:04,860 --> 00:05:06,700
.لكنّه لا يملك أجنحة

71
00:05:08,030 --> 00:05:11,700
!أرأيت؟ سبق وأخبرتك! لا أذكر أنّني طرت

72
00:05:12,280 --> 00:05:15,320
...حـ-حتّى إن استطعت ذلك

73
00:05:21,330 --> 00:05:22,910
ما اسمك؟

74
00:05:24,570 --> 00:05:29,020
!فـ-فلن أقوم بشيء مروّع كذلك ثانية

75
00:05:30,010 --> 00:05:34,530
!لن أطير في السّماء

76
00:05:35,040 --> 00:05:37,630
ماذا؟ أتخاف المرتفعات؟

77
00:05:38,170 --> 00:05:39,450
!أيّها الوغد

78
00:05:41,420 --> 00:05:42,600
!هذا مؤلم

79
00:05:42,790 --> 00:05:46,480
!لا تقلّل من احترامي! لا نهاب نحن المحاربون شيئًا

80
00:05:47,040 --> 00:05:49,840
!...هذا مؤلم، مؤلم... أيّها الـ

81
00:05:50,160 --> 00:05:52,800
!توقّف أيّها المغفّل

82
00:05:53,460 --> 00:05:55,640
!ماذا تظنّ نفسك فاعلاً؟

83
00:05:55,640 --> 00:05:56,820
...هذا مؤلم، مؤلم

84
00:05:56,820 --> 00:05:58,120
!لن أسامحك أبدًا

85
00:05:58,620 --> 00:06:00,560
ما الّذي يفعلانه؟

86
00:06:01,870 --> 00:06:04,260
...لوفي-سان، إنّه طفل في الثّامنة

87
00:06:04,340 --> 00:06:06,260
!كفّ عن هراء "المحاربين" لك

88
00:06:06,260 --> 00:06:10,200
!أنا الرّجل الّذي سيصير ملك القراصنة أيّها الغبيّ

89
00:06:10,200 --> 00:06:16,030
!وأنا سأصير شوغن بلاد وانو يومًا ما أيّها المغفّل

90
00:06:17,050 --> 00:06:18,850
!ماذا قلت أيّها الأنقليس؟

91
00:06:18,850 --> 00:06:20,890
!يا لتعجرفك أيّها القرد

92
00:06:20,890 --> 00:06:23,310
!من تصف بالقرد؟! أنت تهين القردة بذلك

93
00:06:23,430 --> 00:06:25,330
!يكفي يا مومونوسكي

94
00:06:25,330 --> 00:06:27,040
!لقد أنقذ حياتنا

95
00:06:35,070 --> 00:06:38,770
.أنا آسف يا لوفي-دونو. سامحه رجاءً

96
00:06:38,770 --> 00:06:42,330
.إنّه محارب فخور لبلاد وانو رغم أنّه طفل

97
00:06:42,330 --> 00:06:47,440
ولكن، لا أصدّق أنّك تأخذ طفلاً
!في الثّامنة على محمل الجدّ

98
00:06:48,370 --> 00:06:51,370
!أنا لا أحبّ الجبناء أيّها الغبيّ

99
00:06:53,090 --> 00:06:54,240
...يا لك من

100
00:06:56,220 --> 00:06:58,160
!"قلتُ "يكفي

101
00:06:58,840 --> 00:07:00,380
!سُحقًا

102
00:07:00,380 --> 00:07:04,120
!أونامي

103
00:07:01,180 --> 00:07:04,120
!على رسلك يا مومو-تشان، اهدأ

104
00:07:04,270 --> 00:07:07,180
...ذلك القرد

105
00:07:07,180 --> 00:07:08,520
.أعلم، أعلم

106
00:07:10,040 --> 00:07:10,660
...أيّها

107
00:07:10,660 --> 00:07:11,260
...الشّقيّ

108
00:07:11,260 --> 00:07:11,960
!اللّعين

109
00:07:12,290 --> 00:07:14,410
!ابتعد عنها

110
00:07:14,830 --> 00:07:15,730
ما مشكلتهم؟

111
00:07:16,390 --> 00:07:20,630
!هذا الشّبل من ذاك الأسد
!كنتُ أجهل أنّ المحاربين أنذال

112
00:07:21,090 --> 00:07:24,500
!معه حقّ! أريد وصفكم بالمنحرفين بدل المحاربين

113
00:07:24,850 --> 00:07:26,610
!كـ-كيف تجرآن على ذلك؟

114
00:07:28,840 --> 00:07:31,680
!يا كينييمون! لنذهب للبلدة بسرعة

115
00:07:31,870 --> 00:07:33,410
...كيف يجب أن ننحرف

116
00:07:33,410 --> 00:07:36,520
أقصد كيف يجب أن نغيّر ملابسنا لنتنكّر؟

117
00:07:36,840 --> 00:07:39,620
!صحيح

118
00:07:40,110 --> 00:07:42,090
!قمصان للرّجال

119
00:07:42,090 --> 00:07:44,490
لا شيء
للنّساء

120
00:07:42,340 --> 00:07:44,490
!ولا شيء للنّساء

121
00:07:45,000 --> 00:07:48,830
.هذا ما يرتديه النّاس في دريسروزا

122
00:07:49,920 --> 00:07:54,270
!لنغيّر ملابس الجميع لتنسجموا مع السّكّان

123
00:07:54,380 --> 00:07:57,300
!دريسروزا هي الأفضل

124
00:07:57,300 --> 00:07:58,040
!أجل

125
00:07:59,570 --> 00:08:01,390
!كاذب

126
00:08:02,790 --> 00:08:04,280
...أ-أونامي

127
00:08:05,640 --> 00:08:06,660
.اسمعي

128
00:08:07,740 --> 00:08:10,050
.أريدك أن تحتفظي بهذه

129
00:08:12,130 --> 00:08:14,320
أهي فيفر كارد؟

130
00:08:14,690 --> 00:08:18,760
نعم. إنّها تشير نحو جزيرة تُدعى زو
.سبق وحدّثتكم عنها

131
00:08:19,990 --> 00:08:24,150
،بعد تسليم سيزار وتدمير مصنع سمايل

132
00:08:24,150 --> 00:08:25,960
.كنتُ سأتّجه صوب زو

133
00:08:26,570 --> 00:08:28,290
.طاقمي موجود هناك

134
00:08:29,350 --> 00:08:32,770
!لكن إن حدث أمر ما لنا، اذهبوا مباشرة إلى هناك

135
00:08:32,790 --> 00:08:34,890
!مـ-مهلاً لحظة

136
00:08:36,220 --> 00:08:39,800
ماذا تقصد بـ"إن حدث أمر ما"؟
لن يحدث أيّ شيء، صحيح؟

137
00:08:39,800 --> 00:08:41,050
.لا أحد يدري

138
00:08:41,050 --> 00:08:42,410
ما هذه؟

139
00:08:42,410 --> 00:08:43,980
.هذه خريطة رسمها عضو في طاقمي

140
00:08:45,130 --> 00:08:46,350
!عجبًا! إنّها فظيعة

141
00:08:47,340 --> 00:08:50,920
.نحن هنا الآن، في السّاحل الغربيّ لدريسروزا

142
00:08:51,320 --> 00:08:55,530
.يوجد قصر دوفلامينغو في مركز دريسروزا

143
00:08:55,810 --> 00:08:59,650
لا بدّ أنّ مصنع تصنيع سمايل
.في مكان ما على الجزيرة

144
00:08:59,990 --> 00:09:04,900
.لا نملك الكثير من الوقت
.على فريق تدمير المصنع التّحرّك بسرعة

145
00:09:07,090 --> 00:09:08,440
ما هذه الرّائحة؟

146
00:09:08,620 --> 00:09:11,740
...ونحن فريق تسليم سيزار

147
00:09:12,230 --> 00:09:17,120
سنمرّ عبر دريسروزا ونعبر الجسر الطّويل شمالاً

148
00:09:17,120 --> 00:09:18,720
.ونلتقي في غرين بيت

149
00:09:18,800 --> 00:09:21,750
لماذا علينا المرور عبر دريسروزا؟

150
00:09:21,750 --> 00:09:24,160
!بإمكاننا أخذ السّفينة جميعنا

151
00:09:24,550 --> 00:09:25,820
.سمعت أنّ الإبحار مستحيل

152
00:09:26,070 --> 00:09:28,080
.عجبًا، يبدو هذا ممتعًا

153
00:09:28,080 --> 00:09:30,260
!أ-أوصلوني بسلام أرجوكم

154
00:09:31,300 --> 00:09:34,570
.كلاّ. أعاني مرض الخوف من الذّهاب لدريسروزا

155
00:09:35,020 --> 00:09:38,040
.كانجورو... آمل أن يكون قيد الحياة

156
00:09:38,410 --> 00:09:40,170
،وأنتم جميعًا يا فريق حراسة ساني

157
00:09:40,170 --> 00:09:42,070
.عليكم الانتباه من هجوم العدوّ

158
00:09:42,460 --> 00:09:44,840
!لا تسمحوا لهم بأخذ السّفينة

159
00:09:44,890 --> 00:09:47,170
!ماذا؟! ماذا تعني بذلك؟

160
00:09:47,170 --> 00:09:49,040
!ها سيهاجموننا؟

161
00:09:49,040 --> 00:09:52,100
ماذا؟! ظننتُ أنّ حراسة السّفينة
!هو العمل الأكثر أمانًا

162
00:09:52,100 --> 00:09:54,700
.يا رفاق، نحن في معقل العدوّ

163
00:09:54,700 --> 00:09:57,870
...لكنّ سانجي برفقتنا، لذا

164
00:10:00,480 --> 00:10:02,830
!ماذا؟! سانجي ليس هنا

165
00:10:03,260 --> 00:10:05,350
!لوفي والبقيّة ليسوا هنا أيضًا

166
00:10:06,020 --> 00:10:08,750
!إنّهم مفتاح نجاح هذه الخطّة
!إلى أين ذهبوا؟

167
00:10:08,750 --> 00:10:13,170
!مهلاً! من سيحمينا نحن؟

168
00:10:20,500 --> 00:10:27,150
.تُسلب عقول زوّار هذه المملكة بسبب عدّة أشياء

169
00:10:30,900 --> 00:10:34,330
أوّلاً، بعبق الأزهار الفوّاحة

170
00:10:37,790 --> 00:10:40,930
.ورائحة الطّعام المحلّيّ اللّذيذ

171
00:10:45,490 --> 00:10:48,270
!رائحة زكيّة

172
00:10:52,160 --> 00:10:53,480
،ثانيًا

173
00:10:53,980 --> 00:10:57,700
.رقص النّساء المحلّيّات الشّغوف بلا كلل أو ملل

174
00:10:59,700 --> 00:11:01,590
!رائحة ممتازة

175
00:11:04,240 --> 00:11:06,390
...وشيء آخر

176
00:11:08,000 --> 00:11:10,330
!مهلاً! انتظر! أعدها

177
00:11:11,080 --> 00:11:13,900
!انتظر يا ماريو! تمهّل

178
00:11:13,900 --> 00:11:16,800
!أعد إليّ ذراعي

179
00:11:17,110 --> 00:11:21,270
!يا لك من كلب سيّئ! إنّ القطن يسقط منها

180
00:11:24,550 --> 00:11:26,710
!مهلاً

181
00:11:27,000 --> 00:11:27,930
!كلاّ

182
00:11:28,030 --> 00:11:30,950
!جانبي يؤلمني من الرّكض
!رغم أنّه لا يوجد سوى قطن بداخلي

183
00:11:31,170 --> 00:11:33,120
!د-دمى محشوّة؟

184
00:11:33,560 --> 00:11:38,490
.إنّها صدمة مفاجئة لكلّ زوّار هذه المملكة

185
00:11:38,960 --> 00:11:40,470
!مرحبًا

186
00:11:41,560 --> 00:11:43,480
!أنا جنديّ

187
00:11:43,480 --> 00:11:47,300
ماذا؟ ألم نتقابل من قبل؟

188
00:11:47,820 --> 00:11:49,570
.تبدو وجوهكم مألوفة

189
00:11:53,760 --> 00:11:56,660
...صحيح! اعتلت وجوهكم صحيفة الصّباح

190
00:11:56,660 --> 00:11:57,930
!هذا مؤلم

191
00:11:57,930 --> 00:12:00,380
!كلاّ! اشتبكت الخيوط! ساعدوني

192
00:12:00,760 --> 00:12:02,800
!ما هذا؟! لعبة؟

193
00:12:02,800 --> 00:12:04,380
!انظر هناك يا لوفي

194
00:12:12,840 --> 00:12:14,360
،أينما نظرتم

195
00:12:14,830 --> 00:12:17,220
ستجدونهم منسجمين مع البلدة

196
00:12:18,610 --> 00:12:22,670
.ويعيشون جنبًا إلى جنب مع البشر

197
00:12:23,850 --> 00:12:27,590
.إنّهم ألعاب حيّة

198
00:12:32,360 --> 00:12:36,180
.هذه مملكة الحبّ والشّغف والألعاب

199
00:12:36,700 --> 00:12:40,020
.مدينة الميناء أكاسيا

200
00:12:41,200 --> 00:12:43,870
!طُعن رجل

201
00:12:44,540 --> 00:12:46,790
ماذا؟ ثانية؟

202
00:12:46,790 --> 00:12:48,500
ماذا تقصد بـ"ثانية"؟

203
00:12:48,500 --> 00:12:50,500
هل هناك طاعن متسلسل أو ما شابه؟

204
00:12:50,630 --> 00:12:55,820
لا. نساء هذه المملكة شغوفات
.حيال الحبّ ومن النّوع الغيور جدًّا

205
00:12:55,820 --> 00:13:00,510
،لذلك عندما يخون رجل ما امرأة
.تصير الأمور عنيفة جدًّا

206
00:13:00,510 --> 00:13:01,570
!كم هذا مخيف

207
00:13:01,660 --> 00:13:04,990
!كلّما كنّ جميلات، زادت احتمالات طعنهنّ لرجل

208
00:13:06,790 --> 00:13:09,780
!تتحرّك الألعاب من تلقاء نفسها، لكن لا بأس بذلك

209
00:13:09,780 --> 00:13:12,010
!لنذهب للأكل

210
00:13:25,850 --> 00:13:28,380
!مهلاً! انتظرني، انتظرني

211
00:14:09,190 --> 00:14:12,280
!حسنًا! نحن متنكّرون الآن

212
00:14:13,410 --> 00:14:15,120
!أشعر بالجوع

213
00:14:16,830 --> 00:14:18,520
!لنذهب من هنا

214
00:14:24,180 --> 00:14:26,130
!اسمعوا! لنأكل هنا

215
00:15:36,220 --> 00:15:37,560
.المعذرة

216
00:15:44,310 --> 00:15:47,640
.سمعتُ بوجود دار قمار هنا في الأرجاء

217
00:15:47,960 --> 00:15:50,510
هل تدري أين أجدها؟

218
00:15:52,260 --> 00:15:55,980
.آسف أيّها العجوز. هذه أوّل زيارة لي بهذه البلدة

219
00:15:56,840 --> 00:15:59,150
لماذا لا تسأل شخصًا ما في ذلك المطعم؟

220
00:15:59,650 --> 00:16:03,960
.هكذا إذًا. شكرًا على لطفك

221
00:16:23,230 --> 00:16:24,440
!ما الّذي تفعله؟

222
00:16:24,720 --> 00:16:28,770
!لا وقت لديّ للعبث هكذا

223
00:16:29,160 --> 00:16:32,250
!عليّ البحث عن كانجورو في أقرب فرصة ممكنة

224
00:16:33,300 --> 00:16:35,560
.مهلاً، اهدأ

225
00:16:35,560 --> 00:16:41,320
أعلم أنّ علينا الإسراع، لكن من الأفضل جمع
.بعض المعلومات بدل الرّكض في كلّ مكان

226
00:16:43,100 --> 00:16:45,240
ألا تجدون هذا غريبًا؟

227
00:16:46,020 --> 00:16:50,000
.تخلّى ملكهم عن العرش هذا الصّباح فحسب

228
00:16:50,490 --> 00:16:53,140
.ظننتُ أنّه سيكون هنالك ارتباك أكثر

229
00:16:53,160 --> 00:16:55,220
.ربّما لا يعلمون بعد

230
00:16:55,840 --> 00:16:57,530
.ذلك مستحيل

231
00:16:59,630 --> 00:17:02,030
!لنسألهم. أيّها الجدّ

232
00:17:02,350 --> 00:17:03,170
!إيّاك

233
00:17:03,170 --> 00:17:04,490
!ما مشكلتك؟

234
00:17:04,490 --> 00:17:06,920
!كنتَ على الصّفحة الأولى لصحيفة هذا الصّباح

235
00:17:09,110 --> 00:17:10,450
.إليكم طلبكم

236
00:17:11,250 --> 00:17:12,690
...شكرًا على الانتظار

237
00:17:13,610 --> 00:17:15,160
!أو لا

238
00:17:15,730 --> 00:17:18,260
!ها قد أتى! سئمت الانتظار

239
00:17:18,260 --> 00:17:20,020
!بايلا قريدس دريس

240
00:17:20,910 --> 00:17:23,050
!باستا روز بحبر الحبّار

241
00:17:24,050 --> 00:17:27,540
!وغازباتشو يقطين الجنّيّات

242
00:17:27,540 --> 00:17:29,110
!يبدو كلّ شيء شهيًّا

243
00:17:29,230 --> 00:17:31,540
!لنأكل

244
00:17:33,160 --> 00:17:34,650
!لذيذ، لذيذ

245
00:17:35,650 --> 00:17:37,700
ما هو "يقطين الجنّيّات"؟

246
00:17:38,070 --> 00:17:44,720
،إنّ ذلك... في هذه البلاد
!ما زلنا نصدّق خرافة حول الجنّيّات

247
00:17:45,320 --> 00:17:46,730
!أو لا

248
00:17:46,730 --> 00:17:47,730
ما هذه الخرافة؟

249
00:17:48,990 --> 00:17:52,400
!هناك من يدّعي أنهم رأوا جنّيات! أو لا

250
00:17:52,610 --> 00:17:54,200
رأوا جنّيّات؟

251
00:17:55,240 --> 00:17:57,810
!نعم! أليس هذا مثيرًا للاهتمام؟

252
00:17:58,200 --> 00:17:59,770
!وطوال قرون

253
00:18:00,370 --> 00:18:03,580
.رغم أنّ معظمنا لم يروها، لكنّها موجودة

254
00:18:03,930 --> 00:18:06,850
...يسمّي النّاس هذه الجنّيّات

255
00:18:07,880 --> 00:18:12,320
!"آلهة دريسروزا الحارسة"

256
00:18:12,320 --> 00:18:13,710
!أو لا

257
00:18:13,710 --> 00:18:14,990
!حسنًا، اخرس

258
00:18:15,720 --> 00:18:20,830
.حسنًا أيّها المسافرون، اعتنوا بأنفسكم رجاءً

259
00:18:20,830 --> 00:18:22,420
!أو لا

260
00:18:24,750 --> 00:18:26,090
...يا إلهي

261
00:18:26,590 --> 00:18:28,770
.إنّهم أكثر غرابة من الجنّيّات

262
00:18:29,290 --> 00:18:32,810
!أصاب ثانية! 14 مرّة على التّوالي

263
00:18:32,810 --> 00:18:35,860
.ماذا يحدث؟ المكان صاخب قليلاً هناك

264
00:18:36,030 --> 00:18:37,530
.إنّها لعبة روليت

265
00:18:38,340 --> 00:18:41,000
.ثمّة رجل أعمى يفوز بكلّ دور

266
00:18:41,430 --> 00:18:43,220
رجل أعمى؟

267
00:18:52,100 --> 00:18:54,070
!ضع رهانك

268
00:18:58,280 --> 00:18:59,800
.اتّخذت قراري

269
00:19:03,050 --> 00:19:06,270
.على الأسود، رجاءً

270
00:19:06,290 --> 00:19:07,930
!هل سمعتموه؟ على الأسود

271
00:19:07,930 --> 00:19:08,810
!سأراهن على الأسود

272
00:19:08,810 --> 00:19:09,410
!أنا أيضًا

273
00:19:09,410 --> 00:19:10,980
!وكذلك أنا

274
00:19:12,550 --> 00:19:14,650
!لا مزيد من الرّهانات

275
00:19:28,860 --> 00:19:30,230
!الأسود 29

276
00:19:30,530 --> 00:19:33,170
!أجل، إنّه أسود

277
00:19:33,750 --> 00:19:36,270
!لا أصدّق هذا! إنّه الفوز 15 على التّوالي

278
00:19:36,270 --> 00:19:38,940
!شكرًا لك! شكرًا جزيلاً لك

279
00:19:38,940 --> 00:19:41,940
!صرنا أغنياء بفضلك

280
00:19:41,940 --> 00:19:44,160
...لا عليكم

281
00:19:44,160 --> 00:19:46,680
.كنتُ محظوظًا فحسب

282
00:19:46,680 --> 00:19:49,640
.هذا ليس بالكثير، لكن تفضّل
!إنّه هديّة منّي

283
00:19:49,640 --> 00:19:52,410
!وهذه منّي! واصل اللّعب

284
00:19:52,410 --> 00:19:53,350
!هذه منّي

285
00:19:53,350 --> 00:19:54,040
!وهذه أيضًا

286
00:20:12,520 --> 00:20:15,570
أنت مراهن ممتاز، صحيح؟

287
00:20:16,000 --> 00:20:18,910
لنلعب أنا وأنت فحسب! ما قولك؟

288
00:20:19,170 --> 00:20:21,350
ماذا؟ أنت وأنا فحسب؟

289
00:20:21,690 --> 00:20:22,740
!هذا صحيح

290
00:20:22,740 --> 00:20:25,970
!أريد اللّعب في مواجهة رجل محظوظ مثلك

291
00:20:25,970 --> 00:20:29,320
.لا تقل لي أنّك ستنسحب الآن

292
00:20:31,560 --> 00:20:36,180
،لا، حصلت على رقائق من الجميع كما ترى

293
00:20:36,180 --> 00:20:39,200
.لذلك سألعب أكثر

294
00:20:39,400 --> 00:20:43,000
!ممتاز! أنت تروق لي أيّها العجوز

295
00:20:43,540 --> 00:20:48,710
.ليذهب البقيّة إذًا للغرفة الخلفيّة لاستبدال رقائقهم

296
00:20:52,400 --> 00:20:54,140
.حسنًا، ضع رهانك

297
00:20:55,250 --> 00:20:57,520
.على الأبيض رجاءً

298
00:20:57,600 --> 00:20:59,350
.حسنًا

299
00:21:00,130 --> 00:21:02,640
.سأراهن على الأسود إذًا

300
00:21:05,020 --> 00:21:07,790
أين توقّفت؟ ما هي النّتيجة؟

301
00:21:13,670 --> 00:21:16,900
!هذا مؤسف! إنّه أسود

302
00:21:17,650 --> 00:21:19,580
!أخطأت هذه المرّة

303
00:21:19,910 --> 00:21:23,210
!فعلاً؟ سأصيب المرّة القادمة إذًا

304
00:21:24,460 --> 00:21:26,140
!هيّا، توقّفي في الأبيض

305
00:21:26,460 --> 00:21:27,750
.لنرَ

306
00:21:29,170 --> 00:21:32,380
!أخطأت ثانية. رست على الأبيض 20

307
00:21:32,970 --> 00:21:34,290
!سترسو على الأبيض هذه المرّة

308
00:21:38,420 --> 00:21:40,680
!أسود ثانية

309
00:21:40,980 --> 00:21:41,860
!أبيض

310
00:21:42,980 --> 00:21:44,000
!أسود

311
00:21:44,080 --> 00:21:45,280
!أبيض

312
00:21:45,680 --> 00:21:46,800
!أسود

313
00:21:48,580 --> 00:21:49,970
!أبيض

314
00:21:51,290 --> 00:21:53,270
!أنا آسف

315
00:21:53,860 --> 00:21:54,940
!أسود

316
00:21:55,660 --> 00:21:57,290
!هذا فظيع

317
00:21:57,390 --> 00:21:59,500
!إنّهم يجلبون العار لدونكيهوتي

318
00:21:59,800 --> 00:22:01,520
ما خطبهم؟

319
00:22:02,980 --> 00:22:05,220
!حسنًا، ودّع كلّ رهاناتك

320
00:22:05,500 --> 00:22:08,820
بإمكاننا جني الكثير من المال عندما
.لا يكون بوفالو-سان هنا

321
00:22:08,850 --> 00:22:10,010
.أنت على حقّ

322
00:22:10,410 --> 00:22:14,590
.أظنّ أنّ حظّي خانني هذه المرّة
.هذا ليس جيّدًا

323
00:22:15,100 --> 00:22:17,600
ماذا تريد أن تفعل؟ أتريد التّوقّف؟

324
00:22:18,950 --> 00:22:20,230
.لا

325
00:22:21,520 --> 00:22:23,670
.رهان واحد أخير

326
00:22:23,950 --> 00:22:25,600
!سأراهن بكلّ شيء

327
00:22:26,920 --> 00:22:28,170
!مثير للاهتمام

328
00:22:28,510 --> 00:22:32,830
.سأراهن بكلّ شيء إذًا على اللّون الّذي لن تختاره

329
00:22:32,830 --> 00:22:35,830
!لنلعب كالرّجال

330
00:22:35,830 --> 00:22:37,750
بكلّ شيء؟ أأنت واثق؟

331
00:22:38,060 --> 00:22:39,090
.نعم

332
00:22:40,230 --> 00:22:41,990
.حسنًا، لنفعل ذلك

333
00:22:43,740 --> 00:22:45,190
!ضع رهانك

334
00:22:50,210 --> 00:22:52,230
.اتّخذت قراري

335
00:22:52,590 --> 00:22:55,900
!الأبيض رجاءً