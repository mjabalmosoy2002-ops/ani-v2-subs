1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,310 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,710
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:45,970 --> 00:02:52,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,340 --> 00:02:59,070
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,370 --> 00:03:06,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,680 --> 00:03:08,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:09,070 --> 00:03:12,500
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:16,040 --> 00:03:18,470
،بعد نجاتهم من معركة حامية

37
00:03:18,470 --> 00:03:21,270
.يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:24,410 --> 00:03:28,490
،رسوا في بانك هازارد، جزيرة من جزئين
،أحدها مشتعل بالنّيران والآخر متجمّد

39
00:03:29,110 --> 00:03:31,600
وقد أُسروا في قفص

40
00:03:31,600 --> 00:03:35,120
على يد سيزار كلاون الّذي يحكم الجزيرة

41
00:03:35,120 --> 00:03:38,620
.وتعرّضوا لشينوكوني، سلاح دمار شامل

42
00:03:38,620 --> 00:03:44,210
لكنّهم هربوا من القفص بفضل مناورات
حليفهم الشّيتشيبوكاي ترافالغار لو البارعة

43
00:03:44,210 --> 00:03:46,460
.والتمّ شمل الطّاقم

44
00:03:47,670 --> 00:03:51,370
يمتلك المكان بأكمله بالغاز السّامّ
،خارج هذا المختبر الآن

45
00:03:51,370 --> 00:03:56,310
لكن هنالك ممرّ واحد سيُجنّبنا الهواء
!في الخارج ويقودنا مباشرة للبحر

46
00:03:56,760 --> 00:04:03,820
"ثمّة بوّابة كبيرة كُتب عليها "ر-66
.وهي مدخل للممرّ المؤدّي للبحر

47
00:04:03,820 --> 00:04:08,460
لا أريد التّسبّب في مذبحة، ولكنّ ساعتين
.هي أقصى مدّة يمكنني منحها لكم

48
00:04:09,150 --> 00:04:11,950
،وإنّ من سيبقون منكم أطول من ذلك

49
00:04:11,950 --> 00:04:14,350
.لا يسعني ضمان سلامتهم

50
00:04:16,160 --> 00:04:21,240
!ثمّة في هذا المختبر أطفال اختُطفوا قبل سنتين

51
00:04:21,240 --> 00:04:25,960
!"جدوهم وتوجّهوا نحو البوّابة "ر-66

52
00:04:26,500 --> 00:04:30,510
!انتظرني يا مومونوسكي! سأنقذك مهما كلّف الأمر

53
00:04:30,510 --> 00:04:32,890
!يا لوفي

54
00:04:33,320 --> 00:04:35,650
!لا وقت للتّخاذل

55
00:04:35,650 --> 00:04:37,930
!هذه بداية العالم الجديد فحسب

56
00:04:38,610 --> 00:04:41,520
!نعم، آسف! لن أرخي دفاعاتي ثانية

57
00:04:42,250 --> 00:04:46,080
بينما لوفي في المقدّمة، يبدؤون تحرّكهم

58
00:04:46,080 --> 00:04:49,340
!لإنقاذ الأطفال واختطاف سيزار

59
00:04:51,110 --> 00:04:53,070
...فاكهة المطّاط

60
00:05:03,130 --> 00:05:04,420
!الصّحن الطّائر

61
00:05:24,240 --> 00:05:29,220
"!دموع تاشيغي! خطّة اختراق جي-5 اليائسة"

62
00:05:51,320 --> 00:05:52,880
!لماذا؟

63
00:05:58,470 --> 00:06:00,850
!لماذا هم داخل المبنى؟

64
00:06:04,690 --> 00:06:06,470
!السّماسرة يشاهدون هذا

65
00:06:06,470 --> 00:06:09,210
!سُحقًا! يا للإذلال

66
00:06:11,480 --> 00:06:15,290
...طاقم قبّعة القشّ ومجموعة جنود البحريّة

67
00:06:15,290 --> 00:06:18,030
!يركضون نحو الممرّ للهرب

68
00:06:32,330 --> 00:06:34,880
ماذا أفعل؟ ماذا أفعل؟

69
00:06:35,650 --> 00:06:37,140
!ماذا أفعل؟

70
00:06:49,370 --> 00:06:52,470
!ذلك السّيّد! إنّه أشبه بشيطان

71
00:06:52,470 --> 00:06:56,610
!لكن يبدو أنّ الجميع بخير

72
00:06:59,170 --> 00:07:00,950
.لا أدري من أعطاني هذه الورقة

73
00:07:01,420 --> 00:07:06,410
لكن هل كان يقصد أنّ لوفي
!والبقيّة بإمكانهم الهرب وحدهم؟

74
00:07:07,590 --> 00:07:09,880
كيف هربوا من ذلك القفص؟

75
00:07:09,880 --> 00:07:11,230
من أعطاني هذه؟

76
00:07:13,510 --> 00:07:15,490
.هذا غير مهمّ الآن

77
00:07:15,780 --> 00:07:17,300
!أنا طبيب

78
00:07:18,150 --> 00:07:20,340
!عليّ إنقاذ أولئك الأطفال

79
00:07:21,260 --> 00:07:26,150
!وجدت صيغة المخدّر ولديّ المهدّئات

80
00:07:26,150 --> 00:07:27,550
!انتظروني يا أطفال

81
00:07:27,550 --> 00:07:30,030
!سأعالجكم مهما كلّف الأمر

82
00:07:51,150 --> 00:07:53,670
!لكن عليّ أن أعرف أين أذهب أوّلاً

83
00:07:54,870 --> 00:07:56,810
ما الّذي يفعله جنودي؟

84
00:07:56,810 --> 00:08:00,130
!"انتقل جنود لمواجهتهم في المبنى "أ

85
00:08:00,130 --> 00:08:05,340
الوحدة الرّئيسيّة تتجهّز لاعتراضهم
!"وفي نقطة في مؤخّرة المبنى "ب

86
00:08:08,930 --> 00:08:13,190
.أنا واثق أنّ الهرب من الجزيرة هي غايتهم

87
00:08:13,190 --> 00:08:15,940
...ولذلك، لا بدّ أنّهم في الطّريق إلى

88
00:08:15,940 --> 00:08:20,350
!الممرّ المؤدّي للمبنى "ر" مباشرة، البوّابة 66

89
00:08:39,130 --> 00:08:41,470
!لن أسمح لهم بذلك

90
00:08:41,470 --> 00:08:45,390
!"أغلقوا الممرّ بين المبنيين "أ" و"ب

91
00:08:46,170 --> 00:08:49,690
!"أغلقوا البوّابة هناك واعزلوا المبنى "أ

92
00:08:54,550 --> 00:08:57,940
"وثمّ، دمّروا المبنى "أ

93
00:08:58,720 --> 00:09:00,700
!ودعوا شينوكوني يتسرّب إليه

94
00:09:00,700 --> 00:09:04,910
،ماذا؟! لكن إن فعلنا هذا
...فسيقتل ذلك حرّاسنا أيضًا

95
00:09:04,910 --> 00:09:07,010
!قم بذلك فحسب

96
00:09:07,010 --> 00:09:09,620
!لا تنس وضع حلازين اتّصال المراقبة

97
00:09:09,620 --> 00:09:12,500
...ماذا؟! سـ-سيّدي

98
00:09:12,500 --> 00:09:17,210
.لنبدأ هذه التّجربة المفتوحة من أجل السّماسرة

99
00:09:17,210 --> 00:09:21,330
!لم أرهم بعد كفائتي العلميّة العالية بالكامل

100
00:09:24,010 --> 00:09:25,730
!اذهب فحسب

101
00:09:25,730 --> 00:09:26,470
!حاضر

102
00:09:27,390 --> 00:09:29,220
!لا فائدة منهم

103
00:09:36,110 --> 00:09:38,690
ماذا ستفعل يا فيرغو؟

104
00:09:38,690 --> 00:09:43,070
.وحدهم الأغبياء سيقعون في فخّ كهذا

105
00:09:43,070 --> 00:09:46,580
لستَ الوحيد الّذي سيفقد ماء وجهه

106
00:09:46,580 --> 00:09:48,700
.إذا ما سمحتَ لسموكر ولو بالهرب يا سيزار

107
00:09:48,700 --> 00:09:50,660
.لا أستطيع أن أثق بك لتولّي هذا الأمر

108
00:09:52,210 --> 00:09:54,710
!سأقطع كلّ شيء

109
00:09:56,890 --> 00:09:58,600
.ماذا؟ هذا غريب

110
00:09:58,600 --> 00:10:00,130
.لا أستطيع إيجاد سيفي

111
00:10:00,940 --> 00:10:03,800
.أنت لست سيّافًا

112
00:10:04,620 --> 00:10:07,700
.صحيح، أنا لست سيّافًا

113
00:10:07,700 --> 00:10:11,310
.حسنًا، سأذهب لأطيح بأولئك الضّعفاء

114
00:10:15,470 --> 00:10:18,130
!أين أنت يا سيزار؟

115
00:10:16,850 --> 00:10:20,320
"مبنى المختبر "أ

116
00:10:28,160 --> 00:10:31,580
!لن أسمح لك بالعبور من هنا يا قبّعة القشّ

117
00:10:34,710 --> 00:10:37,210
!أنا حارس البوّابة للمبنى "ب" وقرصان سابق

118
00:10:37,210 --> 00:10:40,210
!يناديني النّاس رون الماتشيتي

119
00:10:40,210 --> 00:10:43,920
!باسم السّيّد سيزار، عالِم الحبّ

120
00:10:43,920 --> 00:10:45,850
!ليس لديك سيقان حيوانات

121
00:10:45,850 --> 00:10:47,840
!لا تروق لي أبدًا

122
00:10:48,580 --> 00:10:50,680
!أيّ نوع من القناطير أنت؟

123
00:10:51,010 --> 00:10:53,310
...أنا

124
00:10:53,310 --> 00:10:54,680
.عنكبوت

125
00:11:01,730 --> 00:11:03,730
!ابتعدوا عن طريقي

126
00:11:10,910 --> 00:11:14,870
"الممرّ بين المبنى "أ" و"ب

127
00:11:20,070 --> 00:11:21,750
!إنّه نفق ضخم

128
00:11:37,960 --> 00:11:40,480
لو! ما هذا الإنذار؟

129
00:11:41,410 --> 00:11:44,770
.إنّه للتّحذير بشأن إغلاق بوّابة ما في هذا المبنى

130
00:11:44,770 --> 00:11:48,200
."وذاك هو الممرّ الوحيد للمبنى "ب

131
00:11:48,510 --> 00:11:49,780
!ماذا؟

132
00:11:49,780 --> 00:11:52,540
.أظنّ أنّه يحاول إبقاءنا خارجًا

133
00:11:53,550 --> 00:11:56,910
.من الأفضل أن تخبر رجالك بأن يسرعوا

134
00:12:42,860 --> 00:12:47,130
لا أدري ما الّذي قصده ترافالغار لو عندما
،قال أنّ بإمكانه منحنا ساعتين فحسب

135
00:12:47,820 --> 00:12:51,030
!لكن لن نسمح لكم بالهرب يا طاقم قبّعة القشّ

136
00:12:51,030 --> 00:12:52,550
!لا مهرب لكم

137
00:13:01,500 --> 00:13:03,020
ما هذا الإنذار؟

138
00:13:03,730 --> 00:13:05,020
!إيّاكم

139
00:13:16,030 --> 00:13:17,620
!لا تقفوا في طريقنا

140
00:13:21,580 --> 00:13:22,670
!هذا مؤلم

141
00:13:23,490 --> 00:13:24,750
!هذا ساخن

142
00:13:26,210 --> 00:13:27,090
!هذا بارد

143
00:13:30,800 --> 00:13:33,360
!كم يُعتمد عليكم أيّها السّيّافون الثّلاثة

144
00:13:33,360 --> 00:13:34,510
!حسنًا، لننطلق

145
00:13:35,040 --> 00:13:36,260
!إنّهم قادمون

146
00:13:42,980 --> 00:13:47,700
أظنّ أنّ بإمكاننا الوصول إلى الأطفال
.بسهولة إن واصلنا على هذه الوتيرة

147
00:13:47,700 --> 00:13:50,150
.شكرا لك على حملنا أيّها اللّحية البنّيّة

148
00:13:50,730 --> 00:13:53,610
لا شكر على واجب. ولكن يا رفاق

149
00:13:53,610 --> 00:13:56,100
لماذا أحضرتم معكم ذلك التّنّين؟

150
00:13:56,100 --> 00:13:56,870
ماذا؟

151
00:13:59,330 --> 00:14:03,580
ظننّا أنّ بإمكاننا الهرب من الغاز
،بالطّيران على متنه

152
00:14:04,170 --> 00:14:06,380
.لكنّه لم يطر على الإطلاق

153
00:14:07,620 --> 00:14:11,210
.إنّه لا يطير الآن لأنّه حُقت بمهدّئات

154
00:14:11,610 --> 00:14:17,180
.لكنّ إدخاله معنا للمختبر لم تكن فكرة جيّدة

155
00:14:17,180 --> 00:14:18,630
أهو خطير؟

156
00:14:18,630 --> 00:14:20,600
...يبدو ظريفًا نوعًا ما

157
00:14:24,560 --> 00:14:27,120
!هذه فرصة نادرة لنا

158
00:14:27,120 --> 00:14:28,920
!لنطح بهم

159
00:14:28,920 --> 00:14:30,940
!سيكون فضل إبادتهم لي

160
00:14:30,940 --> 00:14:33,690
!ألم أقل لكم "إيّاكم"؟

161
00:15:06,190 --> 00:15:08,020
!أ-أيّتها النّقيب-تشان؟

162
00:15:10,150 --> 00:15:14,190
أرى أنّك صرت نقيبًا أيّتها المُقلِّدة؟

163
00:15:14,190 --> 00:15:16,240
.لكن لا روح قتاليّة لك

164
00:15:19,360 --> 00:15:21,370
.صحيح. واصلوا تقدّمكم فحسب

165
00:15:23,470 --> 00:15:25,330
!نعم، نعم

166
00:15:25,330 --> 00:15:26,780
!شكرًا جزيلاً لك

167
00:15:31,250 --> 00:15:32,590
!مهلاً

168
00:15:32,590 --> 00:15:36,900
!يا جي-5! هذا ليس وقتًا مناسبًا للقتال

169
00:15:36,900 --> 00:15:38,930
!اذهبوا للمرّ في الخلف حالاً

170
00:15:38,930 --> 00:15:40,140
!ماذا؟

171
00:15:40,140 --> 00:15:44,180
.البوّابة الوحيدة في هذا المبنى تُغلق الآن

172
00:15:44,810 --> 00:15:48,580
.يحاول سيزار محاصرتنا هنا

173
00:15:49,560 --> 00:15:51,950
،إن لم نستطع الوصول للجانب الآخر من البوّابة

174
00:15:51,950 --> 00:15:54,370
!فلن نستطيع الهرب من بانك هازارد

175
00:15:54,790 --> 00:15:56,110
!هيّا انطلقوا

176
00:15:56,110 --> 00:15:57,360
!ماذا؟

177
00:15:58,860 --> 00:16:00,740
!هذا سيّئ

178
00:16:00,740 --> 00:16:02,330
!أسرعوا يا رجال

179
00:16:02,330 --> 00:16:04,390
!افعلوا ما قالته تاشيغي-تشان

180
00:16:04,390 --> 00:16:06,120
!احملوا المصابين

181
00:16:07,200 --> 00:16:08,380
!أسرعوا

182
00:16:08,380 --> 00:16:11,730
!اذهبوا مباشرة للبوّابة

183
00:16:35,650 --> 00:16:36,980
!كم هذا فظيع

184
00:16:38,440 --> 00:16:40,480
روبين، أين كنت؟

185
00:16:40,480 --> 00:16:41,660
!روبين-تشان

186
00:16:43,070 --> 00:16:45,280
.طلب منّي لوفي القيام بأمر معيّن

187
00:16:45,280 --> 00:16:48,370
على أيّ حال، أسمعتَ ما قالته فتاة البحريّة؟

188
00:16:48,370 --> 00:16:50,560
!تماسك أيّها اللّحية البنّيّة-تشي

189
00:16:50,560 --> 00:16:52,320
!أسرع أكثر

190
00:16:52,320 --> 00:16:53,710
.هذا مستحيل

191
00:16:54,420 --> 00:16:56,430
.لا يمكنني الرّكض أسرع من هذا

192
00:16:58,250 --> 00:17:00,440
!ضقت ذرعًا من الرّكض

193
00:17:00,440 --> 00:17:01,990
هل تشتكي؟

194
00:17:01,990 --> 00:17:02,720
!لا

195
00:17:03,060 --> 00:17:06,680
!لست ساموراي، لذا سأشتكي

196
00:17:06,680 --> 00:17:08,680
!هذا يكفي

197
00:17:09,350 --> 00:17:13,220
!مهلاً، لماذا اللّحية البنّيّة مع أولئك القراصنة؟

198
00:17:13,220 --> 00:17:14,920
!ذلك الوغد

199
00:17:14,920 --> 00:17:16,770
!هل يخون السّيّد؟

200
00:17:16,770 --> 00:17:18,910
!السّيّد هو منقذنا العظيم

201
00:17:18,910 --> 00:17:20,120
!لنركّز في الرّكض فحسب

202
00:17:20,120 --> 00:17:21,760
!نحن في خطر أيضًا

203
00:17:27,600 --> 00:17:29,540
!هيّا يا جي-5

204
00:17:31,870 --> 00:17:33,660
!البوّابة هناك تمامًا

205
00:17:33,660 --> 00:17:34,290
!أسرعوا

206
00:17:34,290 --> 00:17:36,680
!سيُغلق قريبًا بالفعل

207
00:17:36,680 --> 00:17:38,760
!بسرعة، بسرعة

208
00:17:39,350 --> 00:17:42,070
!مدافع التّجربة، استعداد

209
00:17:50,350 --> 00:17:54,310
خارج المختبر

210
00:17:55,920 --> 00:18:00,180
!صوّبوا على الجدار الخارجيّ للمبنى "أ" للمختبر الثّالث

211
00:18:16,920 --> 00:18:18,290
!أطلقوا

212
00:18:24,770 --> 00:18:26,680
!هُدم الجدار

213
00:18:29,180 --> 00:18:31,900
...مـ-مهلاً، لا يمكن

214
00:18:36,650 --> 00:18:38,520
!هذا سيّئ للغاية

215
00:18:51,540 --> 00:18:53,290
!اهربوا! اهربوا

216
00:19:02,880 --> 00:19:04,420
!كلاّ

217
00:19:05,320 --> 00:19:06,660
ماذا هنالك؟

218
00:19:08,040 --> 00:19:09,390
!اخرسوا

219
00:19:09,390 --> 00:19:13,800
!أيّها اللّحية البنّيّة-تشي! أسرع، أسرع

220
00:19:21,360 --> 00:19:23,870
.ساعدي أولئك الحمقى على الهرب

221
00:19:23,870 --> 00:19:24,820
.والأطفال أيضًا

222
00:19:30,040 --> 00:19:31,930
!لا تنظروا للخلف وواصلوا الرّكض

223
00:19:31,930 --> 00:19:33,200
!سأهتمّ بالأمر

224
00:19:34,620 --> 00:19:36,500
!تاشيغي-تشان

225
00:19:44,250 --> 00:19:45,580
...النّجدة

226
00:19:48,010 --> 00:19:49,380
!بسرعة

227
00:20:02,930 --> 00:20:04,730
!اعبروا البوّابة

228
00:20:04,730 --> 00:20:08,030
!ستموتون إن لم تعبروا البوّابة

229
00:20:09,990 --> 00:20:13,280
!بسرعة! بسرعة! بسرعة

230
00:20:18,000 --> 00:20:19,540
!تماسكوا

231
00:20:34,490 --> 00:20:36,010
!أجل، نجحنا

232
00:20:36,010 --> 00:20:38,400
!نجحنا بالفعل

233
00:20:38,400 --> 00:20:39,430
!بالكاد

234
00:20:41,810 --> 00:20:43,770
!مهلاً، أين تاشيغي-تشان؟

235
00:20:43,770 --> 00:20:46,910
!طلبت منّا تاشيغي-تشان أن نسبقها

236
00:20:46,910 --> 00:20:47,820
!ماذا؟

237
00:20:47,820 --> 00:20:50,950
!لا تتوقّفوا واعبروا البوّابة

238
00:20:50,950 --> 00:20:52,700
!هيّا! أسرعوا

239
00:20:52,700 --> 00:20:53,490
!أسرعوا

240
00:20:58,960 --> 00:21:01,790
!ماذا تفعلون؟! أنزلوني

241
00:21:00,160 --> 00:21:01,790
!بسرعة

242
00:21:01,790 --> 00:21:04,380
!تاشيغي-تشان! هذا يكفي

243
00:21:04,720 --> 00:21:06,420
!عليك النّجاة بحياتك

244
00:21:07,570 --> 00:21:09,500
!الوداع

245
00:21:12,510 --> 00:21:15,170
!ماذا؟! حلّقت النّقيب-تشان إلى هنا

246
00:21:15,170 --> 00:21:16,220
!ما الّذي يحدث؟

247
00:21:16,220 --> 00:21:17,850
!كم سرّني هذا

248
00:21:17,850 --> 00:21:19,680
...لكن كيف حلّقت إلى هنا

249
00:21:19,680 --> 00:21:20,820
!ابتعدوا عن طريقي

250
00:21:20,820 --> 00:21:23,360
!ما زال هنالك جنود بحريّة في الخارج

251
00:21:23,360 --> 00:21:25,360
!كلاّ! الغاز يملأ المكان هناك

252
00:21:25,360 --> 00:21:26,250
!ابتعد

253
00:21:26,250 --> 00:21:26,680
!لن أفعل

254
00:21:26,680 --> 00:21:28,210
...إنّ البوّابة سوف

255
00:21:28,210 --> 00:21:31,030
...اتركوني! ما زالوا

256
00:21:31,030 --> 00:21:31,660
...ما زالوا

257
00:21:31,660 --> 00:21:35,030
...لكنّ البوّابة تُغلق

258
00:21:31,660 --> 00:21:35,030
!ما زالوا... اتركوني

259
00:21:35,030 --> 00:21:37,780
...أخبرني سموكر-سان

260
00:21:37,780 --> 00:21:40,160
!أن أساعدهم

261
00:21:40,160 --> 00:21:42,280
!لذلك ابتعدوا عن طريقي

262
00:21:42,280 --> 00:21:45,570
!كلاّ أيّتها النّقيب-تشان، فات الأوان

263
00:21:42,280 --> 00:21:45,570
!بسرعة... الوقت يداهمنا

264
00:21:46,850 --> 00:21:48,600
!ما هذا الهراء السّخيف؟

265
00:21:48,600 --> 00:21:51,590
!ما زال زملاؤكم في الجانب الآخر من البوّابة

266
00:21:51,590 --> 00:21:52,840
!لذلك ابتعدوا عن طريقي

267
00:21:53,250 --> 00:21:56,470
!لا تعني لا أيّتها النّقيب تاشيغي

268
00:21:58,150 --> 00:22:00,470
!أبليتم حسنًا يا رجال

269
00:22:00,470 --> 00:22:05,520
!النّقيب-تشان المحبوبة سالمة بين أيدينا

270
00:22:48,210 --> 00:22:49,700
!يا لهم من حثالة

271
00:22:49,700 --> 00:22:52,610
.لا أصدّق أنّ عددًا كبيرًا منهم قد نجوا

272
00:22:55,150 --> 00:22:57,910
...لكنّي لن أدع أيّ أحد

273
00:22:57,910 --> 00:23:00,450
!يفلت منّي

274
00:23:10,650 --> 00:23:16,130
،رغم عبورهم من البوّابة بنجاح
!يهاجم فيرغو جي-5 البحريّة

275
00:23:16,680 --> 00:23:22,060
بينما تاشيغي تبكي وهي ترى رئيسها الّذي
،وثقت به يُطيح بزملائها الواحد تلو الآخر

276
00:23:22,060 --> 00:23:25,220
!يظهر رجل معيّن من طاقم قبّعة القشّ

277
00:23:25,680 --> 00:23:27,220
:في الحلقة القادمة من وان بيس

278
00:23:27,220 --> 00:23:30,070
"!نائب الأميرال الخائن! شيطان الخيزران فيرغو"

279
00:23:30,070 --> 00:23:32,180
!ملك القراصنة، لن يكون إلاّ أنا

280
00:23:35,990 --> 00:23:40,990
!!نراكم في الحلقة القادمة