1
00:00:00,000 --> 00:00:01,610
حلم واحد، أمنية واحدة

2
00:00:01,610 --> 00:00:06,450
إن أردتم تحقيقه، فانطلقوا للقمّة

3
00:00:22,390 --> 00:00:26,010
سنبدأ رحلتنا نحو العالم المجهول

4
00:00:27,100 --> 00:00:31,190
نشقّ طريقنا عبر الرّياح والأمواج العاتية

5
00:00:31,230 --> 00:00:35,900
عليّ الاستمرار لأنّني أريد الوصول أوّلاً

6
00:00:35,940 --> 00:00:42,160
سنقلق لاحقًا بما أنّ النّجاح أو الفشل كجهولين

7
00:00:44,280 --> 00:00:48,700
عندما يبدو عدوّكم مرعبًا

8
00:00:48,750 --> 00:00:53,790
فتلك علامة على أنّ قلبكم ينكمش

9
00:00:54,250 --> 00:00:56,340
الهرب ليس خيارًا

10
00:00:56,380 --> 00:00:58,460
اقتربوا أكثر ولو بخطوة

11
00:00:58,510 --> 00:01:00,970
وإن نُعتّ بالوقاحة فتلك مجاملة، صحيح؟

12
00:01:00,970 --> 00:01:05,300
عندما يصعب الحال، يكون الوقت مناسبًا للضّحك

13
00:01:06,850 --> 00:01:11,270
إن أردتم البحث عن غد جديد

14
00:01:11,310 --> 00:01:16,520
فاصقلوا ثقتكم الفريدة

15
00:01:16,560 --> 00:01:21,070
إلى أن تصبح خطاكم

16
00:01:21,110 --> 00:01:24,740
أجل! إلى أن تصبح خريطة

17
00:01:24,780 --> 00:01:29,290
أفق جديد، فانظروا كم شوطًا قطعتم

18
00:01:29,330 --> 00:01:34,330
إنّه أكثر إشراقًا ومستوى الصّعوبة يزداد

19
00:01:34,710 --> 00:01:39,050
عيشوا حلمكم وأطلقوا إعصارًا

20
00:01:39,090 --> 00:01:43,880
الآن! هزّوا التّرتيب

21
00:01:43,930 --> 00:01:48,180
حلم واحد، أمنية واحدة

22
00:01:48,220 --> 00:01:52,730
الأحلام لا تهرب... أبعدوا كلّ شيء عن طريقكم

23
00:01:53,060 --> 00:01:55,060
وانطلق للقمّة

24
00:01:58,150 --> 00:01:59,320
هل أنت مستعدّة؟

25
00:01:59,730 --> 00:02:00,860
.نعم

26
00:02:11,120 --> 00:02:15,550
،مهمًا كان من يقوم بذلك
.التّمرّد على الشّوغن جريمة خطيرة

27
00:02:16,580 --> 00:02:19,260
.هذه قاعدة لا حياد عنها

28
00:02:30,760 --> 00:02:35,230
الرّابط بين سجينين"
"!لوفي والعجوز هيو

29
00:02:41,480 --> 00:02:42,530
...هذا

30
00:02:42,530 --> 00:02:44,990
!الأرزّ ذو الخمسة ألوان
!لا بدّ أنّها شينوبو

31
00:02:45,530 --> 00:02:47,620
..."انتظروا عند البئر الجافّ"

32
00:02:49,450 --> 00:02:51,030
!هل هم هناك؟

33
00:02:52,580 --> 00:02:55,460
!أنا سعيد لأنّكم أحياء جميعًا

34
00:02:55,460 --> 00:03:00,380
لم أعتقد أنّكم هربتم كلّ هذه المسافة
.إلى منطقة رينغو لتختبئوا من المطاردين

35
00:03:00,630 --> 00:03:04,210
لن يطاردنا رجال أوروتشي
.كلّ هذه المسافة

36
00:03:04,920 --> 00:03:09,260
لم أتوقّع أن تُقتل الأويران
.الشّهيرة كوموراساكي

37
00:03:09,260 --> 00:03:13,180
.نعم. أدخل ذلك عاصمة الزّهور في حالة فوضى

38
00:03:13,180 --> 00:03:14,350
،أعني

39
00:03:14,350 --> 00:03:19,730
.كلّ ما فعلته هو معارضة أوروتشي بكلامها
!فكيف له أن يستعجل في قتل امرأةٍ هكذا؟

40
00:03:21,230 --> 00:03:22,940
...أنا خائفة من السّاموراي

41
00:03:23,320 --> 00:03:27,160
الرّجل الّذي قطع كوموراساكي
.هو كيوشيرو الغافي

42
00:03:27,150 --> 00:03:31,040
.كيوشيرو... لم أسمع بذلك الاسم من قبل

43
00:03:31,280 --> 00:03:36,290
قبل 20 سنة، كان هنالك رجل من أعظم
...زعماء الياكوزا في بلاد وانو

44
00:03:36,540 --> 00:03:39,540
.اسمه هيوغورو الزّهرة

45
00:03:41,380 --> 00:03:44,300
.يا له من اسم مبهج

46
00:03:44,300 --> 00:03:48,380
إنّ الزّعيم هيوغورو الّذي يقدّر
،الشّرف ويساعد الضّعيف

47
00:03:48,380 --> 00:03:52,230
.ما كان أبدًا ليهتمّ بالأمر بهذه الطّريقة القاسية

48
00:03:55,180 --> 00:03:59,060
.كيوشيرو الغافي... يا لفظاعة ذلك الرّجل

49
00:03:59,060 --> 00:04:03,520
ربّما لا يجب علينا إعادة أوتوكو-تشان
...إلى ماخور كيوشيرو

50
00:04:03,520 --> 00:04:06,480
،رغم أنّها أغضبت الشّوغن

51
00:04:06,480 --> 00:04:11,200
...فلا أعتقد أنّ كيوشيرو سيواصل مطاردته لطفلة

52
00:04:11,360 --> 00:04:16,160
.لكنّه قتل حتّى أكثر النّساء شعبيّة من ماخوره

53
00:04:16,160 --> 00:04:17,830
...أنا قلقة

54
00:04:17,830 --> 00:04:20,670
.لنعد إلى عاصمة الزّهور

55
00:04:21,790 --> 00:04:23,210
الجوّ بارد، صحيح؟

56
00:04:23,250 --> 00:04:25,970
!هذا ساخن! شكرًا لك يا شينوبو-تشان

57
00:04:27,210 --> 00:04:30,260
،اسمعوا، إن كنّا سنعود لعاصمة الزّهور

58
00:04:30,260 --> 00:04:34,140
.فلنأخذ حمّامًا لنريح عظامنا المتعبة

59
00:04:34,140 --> 00:04:35,350
.بما أنّني عظام فقط

60
00:04:37,020 --> 00:04:42,980
نعم. من الجيّد أن ندفئ أنفسنا في حمّام
.في عاصمة الزّهور بينما نقوم بالبحث

61
00:04:43,020 --> 00:04:45,030
!يبدو الحمّام فكرة جيّدة

62
00:04:45,060 --> 00:04:47,700
.نعم. نريد أن ننعش أنفسنا

63
00:04:47,730 --> 00:04:52,360
يجب أن نرتدي تنكّرًا. المياه السّاخنة
.ومياه الشّرب تحت إدارة أوروتشي

64
00:04:52,360 --> 00:04:55,870
،في عاصمة الزّهور
.كلّ مظاهر الحياة مُتحكَّم بها

65
00:04:56,120 --> 00:05:02,040
قبل ذلك يا أوروبي-دونو، أودّ سماع
.المعلومات الّتي جمعتِها حتّى الآن

66
00:05:03,580 --> 00:05:07,340
...هذا مؤسف... كلّ ما اكتشفتُه حتّى الآن

67
00:05:07,340 --> 00:05:10,720
هو الوقت الّذي سيستيقظ
،فيه أوروتشي يوم المعركة

68
00:05:10,720 --> 00:05:13,930
،والهدايا الّتي سيأخذونها إلى أونيغاشيما

69
00:05:13,930 --> 00:05:17,010
،وطعام كايدو المفضّل وخريطة التّنظيم

70
00:05:17,010 --> 00:05:19,770
...وعدد جنوده وأسلحته

71
00:05:20,430 --> 00:05:21,860
!هذا عمل متقن

72
00:05:21,890 --> 00:05:25,230
!بالمناسبة، اكتشفت أحد البونيغليف

73
00:05:25,230 --> 00:05:27,820
.لكنّه لم يكن أحمرًا

74
00:05:27,860 --> 00:05:28,780
!أأنت واثق؟

75
00:05:28,820 --> 00:05:31,780
أنت محظوظ فعلاً مع الحجارة
!يا ذا العظام-كيتشي

76
00:05:32,030 --> 00:05:34,820
.كان موجودًا في قبو له باب حصين

77
00:05:34,820 --> 00:05:38,080
.كانت غرفة غريبة بها دمى خشبيّة

78
00:05:38,120 --> 00:05:43,630
إذًا، بونيغليف الطّريق الّذي سيقودنا إلى
.لافتيل قد يكون في أونيغاشيما كما توقّعت

79
00:05:43,660 --> 00:05:46,290
أونيغاشيما؟

80
00:05:46,290 --> 00:05:53,510
نعم. بكلّ هذه المعلومات، بإمكاننا
.القول أنّ المهمّة سارت بنجاح

81
00:05:53,670 --> 00:05:58,890
.شكرًا لكم. كلّ هذا بسبب دعمكم

82
00:05:59,510 --> 00:06:01,890
!حسنًا يا أوروبي-سان وأونامي-سان

83
00:06:01,890 --> 00:06:05,320
!لنذهب إلى الحمّام لنتعافى وأرى ملابسكما الدّاخليّة

84
00:06:05,350 --> 00:06:07,820
!لا يمكنك المجيء لأنّك ستجلب الأنظار

85
00:06:08,400 --> 00:06:10,320
!مستحيل

86
00:06:10,360 --> 00:06:12,240
!أخبار عاجلة! أخبار عاجلة

87
00:06:12,240 --> 00:06:16,280
،الأويران كوموراساكي
،أكبر رموز عاصمة الزّهور

88
00:06:16,280 --> 00:06:20,790
قد قُطعت على يد الزّعيم كيوشيرو
!أثناء وليمة الشّوغن-ساما

89
00:06:20,790 --> 00:06:23,960
!بإمكانكم معرفة المزيد هنا

90
00:06:29,170 --> 00:06:32,300
!كوموراساكي-تشان

91
00:06:32,300 --> 00:06:34,050
!كيف حدث هذا؟

92
00:06:36,590 --> 00:06:40,060
!لماذا أنت حزين؟
.بالكاد قابلتها مرّة واحدة

93
00:06:40,100 --> 00:06:42,850
موت جميلة مثلها هو خسارة
!للعالم بأسره أيّها الغبيّ

94
00:06:42,890 --> 00:06:44,900
.ستُقام الجنازة غدًا

95
00:06:44,930 --> 00:06:47,650
!أنت معدوم الإحساس

96
00:06:48,440 --> 00:06:50,030
...بذلة الغارات

97
00:06:50,060 --> 00:06:52,740
هل تعتقد أنّهم أمسكوا بأوروبي والبقيّة؟

98
00:06:52,820 --> 00:06:57,450
أنا قلق. هل أحاول الاتّصال بهم بالحلزون الذّكّي؟

99
00:06:57,450 --> 00:06:59,410
ما رأيك يا سانجي؟

100
00:06:59,490 --> 00:07:01,780
.القدرة لأصبح خفيًّا

101
00:07:01,780 --> 00:07:04,750
...أعتقد أنّ عليّ اختبارها هناك

102
00:07:04,790 --> 00:07:06,000
!يا سانجي

103
00:07:06,040 --> 00:07:07,590
!في حمّام النّساء

104
00:07:09,080 --> 00:07:10,800
!نعم، صحيح

105
00:07:11,000 --> 00:07:16,390
بالمناسبة يا ترا-أو، هل هنالك أيّ جديد
عن أودون؟ بشأن لوفيتارو؟

106
00:07:16,420 --> 00:07:20,560
!صحيح، أظنّه بدأ يفقد صبره وبدأ بالهيجان

107
00:07:20,640 --> 00:07:23,440
!معك حقّ! لا أطيق الانتظار حتّى ألقاه ثانية

108
00:07:23,890 --> 00:07:26,680
...لا مقالات عن قبّعة القشّ-يا

109
00:07:26,680 --> 00:07:27,730
...مهلاً

110
00:07:27,730 --> 00:07:29,030
!يوستاس-يا؟

111
00:07:29,060 --> 00:07:32,820
!ماذا؟! هل قلتَ يويا، أي حمّام؟
!أتقصد حمّام النّساء؟

112
00:07:33,940 --> 00:07:37,070
!بل أعني أنّه في بلاد وانو إذًا؟

113
00:07:37,200 --> 00:07:42,330
،بما أنّ حليفه هوكينس هنا
.لا عجب في تواجده هنا أيضًا

114
00:07:42,950 --> 00:07:45,620
...لكنّه كان محتجزًا في سجن أودون

115
00:07:45,620 --> 00:07:47,080
.ثمّ هرب

116
00:07:47,120 --> 00:07:48,580
!أقلتَ هرب؟

117
00:07:48,580 --> 00:07:50,340
!مهلاً، ماذا عن لوفي؟

118
00:07:50,670 --> 00:07:54,470
.أعتقد أنّ شيئًا آخر سيحدث في أودون

119
00:07:58,510 --> 00:07:59,600
...بالمناسبة

120
00:08:01,090 --> 00:08:02,850
هل هنالك حمّام؟

121
00:08:02,890 --> 00:08:05,060
!هذا ليس وقتًا مناسبًا لذلك أيّها الوغد

122
00:08:05,060 --> 00:08:07,390
!أنت لا تستمع لنا من الأساس

123
00:08:07,390 --> 00:08:08,980
!أيّها الغبيّ

124
00:08:09,060 --> 00:08:10,270
!مهلاً لحظة

125
00:08:11,480 --> 00:08:12,530
!ماذا هناك؟

126
00:08:16,190 --> 00:08:21,120
أنا قلق. ذهب بيبو والآخرون لاكتشاف
.المنطقة ولم يعودوا بعد

127
00:08:21,280 --> 00:08:24,830
.أتمنّى ألاّ نواجه المزيد من المتاعب

128
00:08:27,250 --> 00:08:29,750
.يا إلهي، لعق

129
00:08:29,750 --> 00:08:33,710
من بين كلّ الأماكن، سقطت ماما
!من السّفينة فوق الشّلاّل

130
00:08:33,750 --> 00:08:38,300
لا يمكننا العودة إلى هناك
.بما أنّ كينغ يدافع عن المنطقة جوًّا

131
00:08:39,130 --> 00:08:42,510
إنّها لمعجزة سلفًا أنّ سفينة
كوين ماما شانتي" لم تنقلب"

132
00:08:42,510 --> 00:08:45,560
.بعد سقوطها من ذلك الارتفاع

133
00:08:45,600 --> 00:08:47,980
أخبروني! هل الانتظار هو كلّ ما نستطيعه؟

134
00:08:48,060 --> 00:08:49,520
.نعم، في الوقت الحاليّ

135
00:08:49,520 --> 00:08:53,190
إنّنا نحن مستعملو القوى نصبح
.بلا حول إذا ما سقطنا من السّفينة

136
00:08:53,230 --> 00:08:56,530
!كلاّ! إذًا فقد غرقت ماما في البحر؟

137
00:08:57,190 --> 00:08:58,740
!لا تقلقي

138
00:08:59,190 --> 00:09:01,280
...هذه معجزة أيضًا

139
00:09:01,280 --> 00:09:04,830
!تُظهر ورقة حياة ماما أنّها حيّة

140
00:09:04,910 --> 00:09:07,080
!ممتاز! إنّها حيّة

141
00:09:07,080 --> 00:09:09,500
!لكن أين تكون الآن؟

142
00:09:09,540 --> 00:09:14,800
هذا يعني أنّ قراصنة مملكة
!الحيوان انتشلوها وهي أسيرة لديهم

143
00:09:15,170 --> 00:09:18,550
...تقصد جماعة كايدو؟ هذا يعقّد الأمور

144
00:09:18,590 --> 00:09:21,510
،ماما وكايدو كانا زميلين في نفس الطّاقم

145
00:09:21,510 --> 00:09:26,430
.لكنّهما الآن اثنان من اليونكو وباتا عدوّين يتنافسان معًا

146
00:09:26,600 --> 00:09:29,730
.سيقتلها بكلّ تأكيد

147
00:09:29,810 --> 00:09:32,520
!ماذا؟! ماذا سيحدث لنا حينها؟

148
00:09:34,060 --> 00:09:35,150
!لعق

149
00:09:36,150 --> 00:09:38,950
...سيصبح قراصنة بيغ مام

150
00:09:39,610 --> 00:09:43,780
!قراصنة بيروسبيرو؟! لعق

151
00:09:43,820 --> 00:09:46,160
!مهلاً! عمّ تتحدّث يا أخي الكبير بيروس؟

152
00:09:46,160 --> 00:09:48,870
!سيكون كاتاكوري هو القائد التّالي

153
00:09:48,910 --> 00:09:51,210
!الأسبقيّة للأكبر! لعق

154
00:09:51,290 --> 00:09:53,250
!لا تكن سخيفًا! الجودة أهمّ

155
00:09:53,290 --> 00:09:55,880
!على الابن الأكبر أن يقود

156
00:09:56,670 --> 00:09:59,510
!هل تريدني أن أستدعي الجنّيّ؟
!سأقوم بذلك الآن

157
00:09:59,590 --> 00:10:01,180
!توقّفا

158
00:10:01,300 --> 00:10:03,180
!لا تفترضا أنّ ماما ستموت

159
00:10:03,510 --> 00:10:07,390
!لا تعتبرا أنّها إنسانة عاديّة أيّها الغبيّان

160
00:10:08,180 --> 00:10:10,270
!بيغ مام؟

161
00:10:10,310 --> 00:10:13,520
!نعم، إنّها شخص قويّ جدًّا من خارج البلاد

162
00:10:15,900 --> 00:10:20,860
هذا الحيوان المدعوّ التّمساح القرش
!هادئ جدًّا ولطيف

163
00:10:22,360 --> 00:10:25,790
!ضربتِ الحيوان مرّتين لترويضه

164
00:10:25,820 --> 00:10:31,450
مهلاً! لا أفهم لماذا عليكم الذّهاب
!إلى أودون مع بيغ مام هذه

165
00:10:31,450 --> 00:10:35,420
!سننقذ أخي الكبير بمساعدتها

166
00:10:35,460 --> 00:10:37,500
!أ-أنا لا أفهم

167
00:10:37,500 --> 00:10:41,220
!عودي فحسب يا أوتاما
!فسّري لي بعض التّفاصيل

168
00:10:41,460 --> 00:10:47,680
أخبرني كينييمون-دونو أن أحرس
!مومونوسكي-دونو جيّدًا

169
00:10:47,720 --> 00:10:50,310
!سنكون بخير أيّها المعلّم-ساما

170
00:10:50,430 --> 00:10:55,140
!سأحمي مومو-كُن بأيّ ثمن بصفتي كونويتشي

171
00:10:55,140 --> 00:10:56,890
...من... من

172
00:10:56,890 --> 00:11:00,770
!من تقصدين بالكونويتشي؟
!لستِ حتّى نصف جاهزة بعد

173
00:11:00,770 --> 00:11:05,620
!لا تتصرّفي بسخافة وعودي في الحال يا أوتاما

174
00:11:06,360 --> 00:11:09,660
!هيتتسو-دونو! نحن في طريقنا إلى هناك سلفًا

175
00:11:09,700 --> 00:11:12,330
!ماذا؟! كلاّ! أوكيكو-دونو

176
00:11:12,330 --> 00:11:14,500
!عودوا في الحال

177
00:11:14,540 --> 00:11:16,460
!أبلغ تحيّاتي إلى كوماتشيو والآخرين

178
00:11:16,500 --> 00:11:17,920
.إغلاق

179
00:11:20,210 --> 00:11:24,510
،اسمعي، بما أنّ هيتتسو قلق
...ربّما يجدر بنا العودة

180
00:11:24,630 --> 00:11:28,260
!سننقذ أخي الكبير يا تشوبّريمون

181
00:11:28,260 --> 00:11:29,680
!أليس كذلك يا أولين-سان؟

182
00:11:29,720 --> 00:11:34,430
بالمناسبة، سمعتُك للتّوّ
..."تقولين "بيغ مام

183
00:11:34,430 --> 00:11:36,230
...يبدو ذلك مألوفًا

184
00:11:36,350 --> 00:11:39,110
!لا تهتمّي يا أولين! أنت أولين

185
00:11:39,350 --> 00:11:40,770
!أليس كذلك يا أولين؟

186
00:11:40,770 --> 00:11:43,650
!أولين، أولين، أولين

187
00:11:43,690 --> 00:11:47,200
!أنت ظريف جدًّا يا تشوبّريمون

188
00:11:47,490 --> 00:11:52,870
.على أيّ حال، كان سكّان بلدة أوكوبوري لطفاء معي

189
00:11:53,160 --> 00:11:56,950
،إنّهم لا يعرفونني وحتّى أنا لا أعرف من أكون

190
00:11:56,950 --> 00:12:01,630
لكنّ تلك المرأة قدّمت لي حساء
.الفاصولياء الحمراء الحلوة اللّذيذ

191
00:12:01,670 --> 00:12:07,090
تلك القبّعة المتكلّمة لم تنطق بأيّ
كلمة، هل فقد ذاكرته هو أيضًا؟

192
00:12:07,130 --> 00:12:09,720
...أتذكّر الآن

193
00:12:09,840 --> 00:12:12,980
.أريد شرب حساء الفاصولياء الحمراء ثانية

194
00:12:13,010 --> 00:12:14,730
!لا تنظري إليّ عندما تقولين ذلك

195
00:12:14,760 --> 00:12:19,230
ما بيدي حيلة بما أنّك ظريف
.جدًّا لدرجة أنّني قد آكلك

196
00:12:19,270 --> 00:12:21,690
!لستُ طعامًا

197
00:12:22,560 --> 00:12:24,900
!أنت تعمل بجدّ يا مومو-كُن

198
00:12:24,940 --> 00:12:29,150
!أنا في قلب هذه المعركة
!عليّ البقاء متيقّظًا

199
00:12:29,150 --> 00:12:31,660
!سوناتشي

200
00:12:32,320 --> 00:12:34,620
!أنا آسف! أنا جدّ آسف

201
00:12:36,160 --> 00:12:41,210
"بالمناسبة، ماذا تعني "سوناتشي
الّتي كنتَ تصرخ بها؟

202
00:12:41,250 --> 00:12:45,460
!سوناتشي كلمة تمنحك الطّاقة

203
00:12:45,460 --> 00:12:48,890
!سوناتشي

204
00:12:48,960 --> 00:12:51,430
!سوناتشي! سوناتشي

205
00:12:51,800 --> 00:12:55,100
!أنت على حقّ! لديّ طاقة كبيرة

206
00:12:55,140 --> 00:12:56,810
!أرأيت؟ هيّا

207
00:12:56,850 --> 00:12:59,440
!سوناتشي! سوناتشي! سوناتشي

208
00:12:59,480 --> 00:13:01,730
!توقّفا كلاكما

209
00:13:02,140 --> 00:13:03,190
ماذا يا كيكو؟

210
00:13:03,350 --> 00:13:05,030
أين تعلّمتَ تلك الكلمة؟

211
00:13:05,060 --> 00:13:08,360
هذا ما يصرخون به في مبارزة
!سيوف خارج البلاد

212
00:13:08,530 --> 00:13:10,950
!تعلّمتها من زوروجورو

213
00:13:10,950 --> 00:13:14,870
قال أنّها كلمة حظّ للرّفع من الرّوح
.عندما يفتقر المرء للشّجاعة

214
00:13:15,070 --> 00:13:17,160
!لكنّني أمنعك عن قولها

215
00:13:17,200 --> 00:13:19,500
!ماذا؟! لماذا؟

216
00:13:19,540 --> 00:13:24,790
قد تكون مجرّد مصادفة، لكن ثمّة صرخة
.معركة مشابهة بلهجة كوري القديمة

217
00:13:24,790 --> 00:13:27,550
.ليس من اللاّئق أن تقولها أنت

218
00:13:27,550 --> 00:13:29,630
!ماذا؟! ليس عدلاً

219
00:13:29,630 --> 00:13:30,550
!قلتُ لك لا

220
00:13:30,550 --> 00:13:32,890
.إنّها كلمة تعطي المرء الشّجاعة

221
00:13:32,930 --> 00:13:35,180
!لا تعني لا

222
00:13:37,100 --> 00:13:41,980
أنا جائعة. ألم نصل إلى أودون بعد؟

223
00:13:41,980 --> 00:13:45,440
...أنا جائعة جدًّا، لذلك

224
00:13:45,560 --> 00:13:48,110
!لا تنظري إليّ ولعابك يسيل

225
00:13:48,150 --> 00:13:52,450
في الحقيقة يا أولين-سان، ما زالت
.منطقة أودون بعيدة عن هنا قليلاً

226
00:13:52,490 --> 00:13:54,200
!أهذا صحيح؟

227
00:13:55,450 --> 00:13:58,530
.هذه خريطة بسيطة عن بلاد وانو

228
00:13:58,530 --> 00:14:03,080
،توجد ستّ مناطق في بلاد وانو يفصل بينها نهر

229
00:14:03,080 --> 00:14:05,540
.ولكلّ منطقة مناخها الخاصّ

230
00:14:05,540 --> 00:14:08,920
.في أقصى الغرب، لدينا منطقة كوري

231
00:14:09,210 --> 00:14:14,510
.تقابلنا قرب شاطئ قرية أميغاسا في كوري

232
00:14:14,760 --> 00:14:17,600
اعتادت بلدة باكورا أن تكون
.بلدة قلعة لقلعة أودن

233
00:14:17,600 --> 00:14:20,730
كانت أوتسورو-سان في بلدة
.أوكوبوري قربها مباشرة

234
00:14:20,760 --> 00:14:23,860
!هناك تناولت حساء الفاصولياء الحمراء

235
00:14:27,230 --> 00:14:30,070
ولكن أين أودون؟

236
00:14:30,110 --> 00:14:33,280
،إن اتّجهنا شرقًا من كوري
.فسنجد منطقة أودون

237
00:14:33,280 --> 00:14:37,370
.نتّجه الآن إلى معسكر التّنقيب الموجود هنالك

238
00:14:37,410 --> 00:14:40,910
!أخي الكبير! سننقذك مهما كلّف الأمر

239
00:14:40,910 --> 00:14:42,240
...حسنًا! سونا

240
00:14:42,240 --> 00:14:43,540
!أنا آسفة

241
00:14:43,750 --> 00:14:46,340
.منطقة كيبي أرض قفرة

242
00:14:46,710 --> 00:14:49,420
.وفوجياما هي مركز بلاد وانو

243
00:14:49,420 --> 00:14:51,590
...وفي سفح جبلها

244
00:14:51,590 --> 00:14:54,550
.نجد عاصمة الزّهور المترفة

245
00:14:54,590 --> 00:14:58,970
إنّ ازدهارها كان على حساب
.تضحيات العديد من العامّة

246
00:14:58,970 --> 00:15:02,640
أوروتشي البغيض هو المسؤول
!على ذلك. عليّ تصويب الأمر

247
00:15:02,640 --> 00:15:03,680
...سونا

248
00:15:03,680 --> 00:15:04,940
!أنا آسف

249
00:15:05,390 --> 00:15:07,900
،وشرق عاصمة الزّهور

250
00:15:07,900 --> 00:15:10,320
.نجد منطقة رينغو المُثلِجة

251
00:15:10,360 --> 00:15:13,450
!أعتقد أنّ بروك في المقبرة الشّماليّة

252
00:15:14,070 --> 00:15:17,030
.ثمّة بلدات ميناء في منطقة هاكوماي

253
00:15:17,030 --> 00:15:19,620
...ويوجد جنوب بلاد وانو مباشرة

254
00:15:19,620 --> 00:15:20,910
.أونيغاشيما

255
00:15:20,910 --> 00:15:23,750
!حيث ننوي ضرب ضربتنا

256
00:15:23,830 --> 00:15:29,000
.علينا جمع حلفاء من أنحاء البلاد

257
00:15:29,960 --> 00:15:32,170
!لننقذ أخي الكبير أوّلاً

258
00:15:32,210 --> 00:15:35,550
!لا غنى عن لوفي عندنا

259
00:15:36,470 --> 00:15:39,300
...أودون بعيدة جدًّا

260
00:15:39,300 --> 00:15:42,850
.أصبحت جائعة أكثر بعدما رأيت الخريطة

261
00:15:42,890 --> 00:15:46,770
!أخبرتك ألاّ تنظري إليّ ولعابك يسيل

262
00:16:26,850 --> 00:16:31,820
.تلك الأداة ثقيلة جدًّا ليستعملها شخص واحد

263
00:16:32,560 --> 00:16:34,700
!أيّها العجوز، دعني أساعدك

264
00:16:34,730 --> 00:16:38,030
!لا يا فتى قبّعة القشّ
!ليس عليك أن تساعدني

265
00:16:38,070 --> 00:16:39,740
!هذا لا شيء

266
00:16:46,450 --> 00:16:49,290
.شكرًا لك يا فتى قبّعة القشّ

267
00:16:49,710 --> 00:16:53,880
.لا أقوم بهذا من أجلك
!أقوم بهذا من أجلي

268
00:16:54,290 --> 00:16:58,260
سأصبح أقوى وسأخرج
!من هنا مهما كلّف الأمر

269
00:17:00,840 --> 00:17:03,180
!أستطيع فعل هذا أيضًا

270
00:17:04,220 --> 00:17:06,600
!حسنًا

271
00:17:09,730 --> 00:17:12,110
!أيّها العجوز

272
00:17:12,940 --> 00:17:14,480
!هل أنت بخير؟

273
00:17:14,860 --> 00:17:16,440
.خذ هذه

274
00:17:16,440 --> 00:17:19,070
!أنت جائع جدًّا لتعمل، صحيح؟

275
00:17:20,940 --> 00:17:22,660
...يا فتى قبّعة القشّ

276
00:17:22,990 --> 00:17:26,160
.شكرًا لك مجدّدًا يا فتى قبّعة القشّ

277
00:17:26,200 --> 00:17:28,170
!اذهب وكل الدّانغو الآن

278
00:17:28,620 --> 00:17:31,420
.شكرًا لك مجدّدًا يا فتى قبّعة القشّ

279
00:17:31,910 --> 00:17:33,590
.شكرًا جزيلاً لك

280
00:17:34,750 --> 00:17:36,750
.إنّه عجوز ممتع

281
00:17:36,750 --> 00:17:38,220
...حسنًا

282
00:17:40,920 --> 00:17:43,140
!هذا مقرف

283
00:17:43,510 --> 00:17:46,520
!أنت هناك

284
00:17:47,890 --> 00:17:50,480
.أحتاج لأسألك عن شيء

285
00:17:50,520 --> 00:17:51,690
!ما هو؟

286
00:17:52,730 --> 00:17:57,560
.كما تعلم، هرب السّجين يوستاس كيد

287
00:17:57,560 --> 00:18:00,360
.أراهن أنّك تعرف شيئًا

288
00:18:03,360 --> 00:18:04,450
!هذا قذر

289
00:18:07,030 --> 00:18:10,580
.لم آكل هذا القدر من الطّعام منذ مدّة

290
00:18:12,330 --> 00:18:16,800
.منذ أن أتى فتى قبّعة القشّ إلى هنا، بوركت حياتي

291
00:18:17,040 --> 00:18:19,590
!إن كنتَ جائعًا، فلن تستطيع حتّى العمل

292
00:18:19,630 --> 00:18:23,350
،ليس مرّة واحدة فقط
...بل أنقذني مرّات عدّة

293
00:18:23,760 --> 00:18:26,930
!شكرًا لك يا فتى قبّعة القشّ

294
00:18:26,930 --> 00:18:31,440
.سآكلها... سآكلها وكلّي امتنان

295
00:18:31,970 --> 00:18:33,480
!مهلاً

296
00:18:35,690 --> 00:18:38,320
!أطعمني القليل منها

297
00:18:38,650 --> 00:18:42,200
!تبدو هذه الدّانغو لذيذة

298
00:18:47,950 --> 00:18:49,540
...ما أعنيه هو

299
00:18:49,700 --> 00:18:53,410
!أليس لديك علاقة ما بهروب كيد؟

300
00:18:53,410 --> 00:18:56,380
!كنتما تتحدّثان معًا كثيرًا

301
00:18:56,420 --> 00:18:58,260
...بصاقه مقرف

302
00:18:58,290 --> 00:19:01,670
!مقرف؟! هل تعبث معي؟

303
00:19:01,670 --> 00:19:05,390
!لا تنسَ أنّك مقيّد بأصفاد حجر بحريّ

304
00:19:06,590 --> 00:19:10,430
لكنّها مسألة وقت فحسب
!قبل أن يتمّ الإمساك به

305
00:19:10,430 --> 00:19:13,810
.لم يكن هروبه من السّجن مُحكمًا

306
00:19:13,810 --> 00:19:17,810
ما زال هو الآخر مقيّدًا بأصفاد
.الحجر البحريّ بكلّ حماقة

307
00:19:17,810 --> 00:19:21,740
!لذلك سيتمّ الإمساك به قريبًا وسيتحمّل العواقب

308
00:19:21,770 --> 00:19:25,070
!توقّف! بصاقك مقرف جدًّا

309
00:19:26,490 --> 00:19:28,950
!لا تقل لي أنّك تعبث معي؟

310
00:19:28,950 --> 00:19:31,740
!هل تريد أن نراجع القوانين ثانية؟

311
00:19:31,740 --> 00:19:34,950
!ستُقطع ذراعاك في إساءتك الأولى

312
00:19:34,950 --> 00:19:38,000
!وستُقطع ساقاك في الإساءة الثّانية

313
00:19:38,000 --> 00:19:40,670
!وسيُحكم عليك بالموت في إساءتك الثّالثة

314
00:19:40,670 --> 00:19:42,050
!غبيّ

315
00:19:42,210 --> 00:19:45,720
!لا يجدر بكم العبث معنا

316
00:19:50,930 --> 00:19:54,600
!توقّف عن أذيّة العجوز هيو
!ستقتله

317
00:19:56,100 --> 00:19:57,730
هل تعبثون معي؟

318
00:19:58,060 --> 00:20:00,570
...لا، لسنا كذلك

319
00:20:00,690 --> 00:20:03,730
!أقوم بهذا من أجلكم أيضًا

320
00:20:03,730 --> 00:20:08,570
تحصلون أنتم السّجناء على
الدّانغو لقاء عملكم، صحيح؟

321
00:20:08,570 --> 00:20:10,530
...ماذا إن وُجد شخص ما

322
00:20:10,530 --> 00:20:16,920
لا يعمل حتّى ليستحقّها ويستعمل
بطاقات حصل عليها من شخص آخر؟

323
00:20:17,080 --> 00:20:22,510
،بما أنّكم تعملون بجدّ كبير
فهل بإمكانكم مسامحة غشّاش مثله؟

324
00:20:22,540 --> 00:20:25,550
!بالطّبع لا يمكنكم ذلك

325
00:20:24,250 --> 00:20:25,550
...طعامي

326
00:20:25,550 --> 00:20:30,260
.القواعد هي القواعد
!إن لم يتّبعها أحدكم، فعليه أن يموت

327
00:20:26,260 --> 00:20:28,640
...الكيبي دانغو العزيزة

328
00:20:30,260 --> 00:20:32,180
ألا تعتقدون ذلك؟

329
00:20:32,260 --> 00:20:33,520
...الدّانغو

330
00:20:33,550 --> 00:20:37,180
تقول القاعدة أنّ بإمكانكم فقط
.أكل ما تجنونه من عملكم

331
00:20:37,180 --> 00:20:40,390
!إن لم تستطيعوا العمل، موتوا جوعًا فحسب

332
00:20:40,390 --> 00:20:42,940
!ألا توافقني أيّها العجوز؟

333
00:20:43,730 --> 00:20:46,530
!مهلاً، هل تحاول الهرب هكذا؟

334
00:20:46,530 --> 00:20:49,610
،أخبرني، لا تستطيع حتّى العمل

335
00:20:49,610 --> 00:20:53,160
فكيف حصلتَ على كلّ بطاقات الطّعام هذه؟

336
00:20:53,160 --> 00:20:54,790
من أعطاك إيّاها؟

337
00:20:54,990 --> 00:20:57,870
...الدّانغو

338
00:20:58,370 --> 00:21:01,040
...الدّانغو الغالية

339
00:21:01,080 --> 00:21:03,420
!عجوز طمّاع

340
00:21:15,800 --> 00:21:17,440
!لذيذة جدًّا

341
00:21:17,470 --> 00:21:19,640
!ماذا تفعل؟

342
00:21:19,640 --> 00:21:23,900
!لا يحقّ لك تناول أيّ شيء

343
00:21:25,440 --> 00:21:28,190
!لا تأكل الدّانغو إن كنتَ لا تعمل

344
00:21:28,190 --> 00:21:30,990
!ابصقها! ابصقها أيّها العجوز اللّعين

345
00:21:34,110 --> 00:21:36,540
!توقّف أرجوك

346
00:21:43,330 --> 00:21:45,840
.لن أبصقها

347
00:21:46,250 --> 00:21:50,760
...يا فتى قبّعة القشّ، أعطيتني هذه الدّانغو

348
00:21:50,760 --> 00:21:53,720
...فلن... لن

349
00:21:54,130 --> 00:21:55,970
!أضيّعها أبدًا

350
00:21:56,720 --> 00:21:59,560
!اسمع، عليك مشاهدة هذا أيضًا

351
00:22:03,480 --> 00:22:04,980
!العجوز! لماذا؟

352
00:22:05,020 --> 00:22:09,360
!يستحقّ ذلك! هذا ما تجنيه من العبث معنا

353
00:22:09,360 --> 00:22:11,320
!ضع ذلك حلقة في أذنك

354
00:22:14,700 --> 00:22:17,070
!والآن، ابصق الدّانغو

355
00:22:17,070 --> 00:22:21,460
!من الغبيّ الّذي كان يعطيك البطاقات؟

356
00:22:25,710 --> 00:22:27,630
!لقد أكلتُها

357
00:22:27,750 --> 00:22:32,300
كم تريد العبث معي؟

358
00:22:32,300 --> 00:22:36,840
،لن أتهاون معك. سأجبرك على إخباري باسم شريكك

359
00:22:36,840 --> 00:22:40,730
!وسأقتلكما معًا

360
00:23:04,500 --> 00:23:09,710
يطيح لوفي بأحد الحرّاس من النّجوم
.ويتسلّق الجدار بهدف الهروب

361
00:23:09,710 --> 00:23:14,170
ولكن، يتردّد صوت صدى غناء
!حماسيّ في الأرجاء

362
00:23:14,170 --> 00:23:16,380
،وعلى إيقاع الهتافات الحماسيّة

363
00:23:16,380 --> 00:23:22,230
يبدأ كوين، أحد كبار قادة قراصنة
!مملكة الحيوان، العرض

364
00:23:22,260 --> 00:23:23,930
:في الحلقة القادمة من وان بيس

365
00:23:23,930 --> 00:23:26,980
!من كبار النّجوم"
"!ظهور كوين الطّاعون

366
00:23:26,980 --> 00:23:31,320
!ملك القراصنة، لن يكون إلاّ أنا