1
00:01:29,240 --> 00:01:34,580
"!لعبة رهائن حقيرة! تهديدات سومرز الوقحة"

2
00:01:52,100 --> 00:01:55,090
!ممتاز! تمّ إخماد الحريق

3
00:01:55,090 --> 00:01:57,690
!أنا قادم يا أطفال

4
00:02:02,650 --> 00:02:03,990
ساول؟

5
00:02:11,750 --> 00:02:16,080
...ستكون اللّحظة المثاليّة

6
00:02:19,380 --> 00:02:20,500
...ساول

7
00:02:20,540 --> 00:02:23,630
.اختبئا يا روبين وتشوبّر

8
00:02:23,630 --> 00:02:26,840
.رأيتُ ذلك الرّجل من قبل
...إنّه من

9
00:02:27,340 --> 00:02:29,140
!فرسان الإله

10
00:02:32,060 --> 00:02:35,480
!إنّهم خالدون. لا فرصة لنا أمامه

11
00:02:35,480 --> 00:02:39,440
.اختبئا وانتظرا فرصة لإنقاذ الأطفال

12
00:02:41,020 --> 00:02:44,780
!يا لها من مفاجأة سارّة

13
00:02:47,950 --> 00:02:49,070
...حسنًا

14
00:02:50,910 --> 00:02:54,200
ما الّذي تفعله هنا؟

15
00:03:05,340 --> 00:03:06,970
!يا إلهي

16
00:03:09,090 --> 00:03:11,550
...أعتقد أنّ هذا يعني

17
00:03:11,550 --> 00:03:14,220
.أنّه كان هنالك ناجيان اثنان من أوهارا

18
00:03:14,520 --> 00:03:17,480
.قامت البحريّة بعمل رديء بالفعل

19
00:03:17,640 --> 00:03:19,060
!هذا مؤلم

20
00:03:22,360 --> 00:03:25,240
!هلاّ كنت أكثر لطفًا؟

21
00:03:25,240 --> 00:03:27,610
!يا غونكو

22
00:03:28,700 --> 00:03:31,660
هل أمسكتِ بطاقم قبّعة القشّ؟

23
00:03:33,030 --> 00:03:34,990
.هذا يزيد الأمور حماسة

24
00:03:35,210 --> 00:03:37,880
هل علينا أخذهم معنا يا كيلينغام؟

25
00:03:37,880 --> 00:03:39,120
ماذا نفعل بهم؟

26
00:03:39,120 --> 00:03:41,330
!لا تكن سخيفًا يا سومرز

27
00:03:41,330 --> 00:03:45,590
هل تحاولان إثارة غضب قبّعة القشّ لوفي؟

28
00:03:45,590 --> 00:03:49,050
.لننجز مهمّتنا ونعود أدراجنا فحسب

29
00:03:50,930 --> 00:03:54,560
ساول المسكين يتعذّب
!ونحن سمحنا باختطاف كولون

30
00:03:54,560 --> 00:03:58,040
!كنت معنا يا جينبي
!كيف سمحت بحدوث ذلك؟

31
00:03:58,040 --> 00:04:00,030
!أسرع وقم بشيء ما

32
00:04:00,030 --> 00:04:04,150
ربّما سأتمكّن من التّفكير في شيء
.إن توقّفتِ عن الصّراح

33
00:04:05,190 --> 00:04:06,530
،على أيّ حال

34
00:04:06,530 --> 00:04:10,570
...كنتُ أتساءل كيف تعمل تلك القوى

35
00:04:10,950 --> 00:04:15,700
!تلك الفتاة مخيفة جدًّا
!ظننتُ أنّنا هالكون

36
00:04:16,330 --> 00:04:18,790
...هنالك شيء بخصوص تلك الفتاة

37
00:04:21,580 --> 00:04:25,290
.لا، ربّما أنا أتخيّل أمورًا فحسب

38
00:04:27,840 --> 00:04:31,220
!كلاّ، عادت المرأة الزّومبي

39
00:04:33,390 --> 00:04:35,510
...أ-أيّتها الشّابّة

40
00:04:35,510 --> 00:04:37,060
...أيعقل أنّك

41
00:04:40,440 --> 00:04:41,850
!بروك

42
00:04:43,940 --> 00:04:45,690
...اسمع يا هذا

43
00:04:46,650 --> 00:04:50,110
.أريدك أن تؤلّف أغانٍ لي لبقيّة حياتك

44
00:04:50,700 --> 00:04:53,070
.ستصير عبدي

45
00:04:53,070 --> 00:04:54,280
!ماذا؟

46
00:04:54,280 --> 00:04:58,830
ماذا؟ هل تعرف أغاني بروك؟
!ملك السّول؟

47
00:04:59,000 --> 00:05:02,210
لـ-لدى بروك معجبون حتّى بين
!التّنانين السّماويّين؟

48
00:05:02,500 --> 00:05:06,290
!ويا لها من معجبة

49
00:05:06,290 --> 00:05:09,260
!هذا يكفي يا غونكو

50
00:05:09,260 --> 00:05:13,430
أفضّل ألاّ ندخل في قتالٍ
.مع أحد أباطرة البحر

51
00:05:14,340 --> 00:05:16,300
.لنعد إلى عملنا فحسب

52
00:05:22,560 --> 00:05:26,060
...فهمت، أنت من معجبي ملك السّول

53
00:05:27,320 --> 00:05:30,230
.أنا جدّ آسف أيّتها الشّابّة

54
00:05:31,780 --> 00:05:36,450
لكنّ اليوم الّذي أعطاني فيه القبطان
،قبّعة القشّ فرصة ثانية في الحياة

55
00:05:36,530 --> 00:05:40,330
هو اليوم الّذي أقسمت له فيه

56
00:05:40,420 --> 00:05:43,750
.بولائي له وحد دون سواه

57
00:05:55,830 --> 00:05:58,720
وماذا لو قلتُ أنّي سأقتلك إن رفضت؟

58
00:06:00,680 --> 00:06:02,430
،إذًا فأنا أفضّل الموت

59
00:06:02,680 --> 00:06:05,850
.فهو أهون عندي من العيش بلا مروءة

60
00:06:06,520 --> 00:06:08,310
!انتبه يا بروك

61
00:06:38,430 --> 00:06:41,260
!توقّفي –
!بروك –

62
00:06:47,100 --> 00:06:49,520
أكلّ شيء جاهز الآن يا كيلينغام؟

63
00:06:49,520 --> 00:06:51,690
.نعم، يمكنك أن تبدأ

64
00:06:54,900 --> 00:06:58,630
.اختبار، اختبار. اختبار، اختبار

65
00:06:58,630 --> 00:07:00,870
أتسمعوني يا ساكني إلباف؟

66
00:07:01,030 --> 00:07:03,740
.أتحدّث مباشرة إلى محاربي إلباف

67
00:07:12,590 --> 00:07:14,890
.اختبار، اختبار

68
00:07:14,890 --> 00:07:16,370
من الّذي يتحدّث؟

69
00:07:16,370 --> 00:07:18,260
ما هذا البثّ؟

70
00:07:18,590 --> 00:07:22,210
يا محاربي إلباف، لا بدّ أنّكم مشغولون الآن

71
00:07:22,210 --> 00:07:27,520
بالتّعامل مع الحوادث الغريبة
.الّتي تقع من حولكم

72
00:07:28,560 --> 00:07:32,400
.إنّها من صنيعنا بالطّبع

73
00:07:54,090 --> 00:07:56,420
!أيّها القبطانان

74
00:07:57,050 --> 00:07:58,200
!ماذا؟

75
00:07:58,200 --> 00:08:02,220
أيّها القبطانان! هنالك من يبثّ
!رسالة إلى كلّ أنحاء إلباف

76
00:08:03,050 --> 00:08:05,060
!ما الّذي حدث لأنجي؟

77
00:08:05,060 --> 00:08:07,390
.اختبار، اختبار

78
00:08:07,390 --> 00:08:08,890
أيمكنكم سماعي؟

79
00:08:09,560 --> 00:08:14,610
.إنّنا نلعب لعبة صغيرة في إلباف الآن

80
00:08:14,610 --> 00:08:15,940
...مهلاً

81
00:08:15,940 --> 00:08:18,440
.نسيت التّعريف عن نفسي

82
00:08:21,820 --> 00:08:25,540
...أنا خنجر أرض ماريجوا المقدّسة

83
00:08:26,490 --> 00:08:30,000
!واسمي سومرز من فرسان الإله

84
00:08:30,000 --> 00:08:32,000
!فرسان الإله؟

85
00:08:32,580 --> 00:08:35,710
إنّه يكشف عن هويّته من تلقاء نفسه؟

86
00:08:35,710 --> 00:08:39,800
قرية الحرفيّين
الجنوب الشّرقيّ

87
00:08:35,710 --> 00:08:39,800
!ماريجوا؟! إنّه من حكومة العالم إذًا؟

88
00:08:39,800 --> 00:08:42,130
!لماذا قد يفعلون شيئًا كهذا؟

89
00:08:42,130 --> 00:08:44,600
قرية الصّيّادين
الشّمال الغربيّ

90
00:08:44,600 --> 00:08:47,470
!هل الأطفال بخير؟

91
00:08:47,470 --> 00:08:49,930
،أنا واثق أنّكم تعرفون سلفًا

92
00:08:49,930 --> 00:08:55,020
.أنّنا أخذنا عشرة من أبنائكم كرهائن

93
00:08:56,070 --> 00:08:57,780
...إضافة لذلك

94
00:08:57,780 --> 00:09:01,720
سحقنا الرّجل ذو اللّحية البرتقاليّة
...الّذي هاجمَنا في المدرسة

95
00:09:01,720 --> 00:09:04,370
...وحاول بكلّ يأس أن ينقذهم

96
00:09:06,580 --> 00:09:09,120
.وهو الآن على الأرض غارقًا في دمائه

97
00:09:09,620 --> 00:09:11,580
!هل يتحدّث عن ساول؟

98
00:09:12,670 --> 00:09:14,040
،بتعبير آخر

99
00:09:14,040 --> 00:09:16,240
بينما كنتم تظنّون بكلّ سذاجة

100
00:09:16,240 --> 00:09:20,090
...أنّ شخصًا آخر سيقوم بإنقاذ أطفالكم

101
00:09:21,510 --> 00:09:23,180
،فإنّهم في هذه اللّحظة

102
00:09:23,180 --> 00:09:25,860
.يواصلون السّير إلى خطّ النّهاية

103
00:09:26,470 --> 00:09:29,060
.كم هذا مملّ

104
00:09:31,890 --> 00:09:33,520
...الأطفال

105
00:09:33,520 --> 00:09:36,190
.بدأت اللّعبة الحقيقيّة للتّوّ

106
00:09:36,730 --> 00:09:40,440
.من المؤسف أنّه لا يوجد بثّ مرئيّ

107
00:09:43,400 --> 00:09:46,240
...هل تعرفين أسماء كلّ الأطفال

108
00:09:46,820 --> 00:09:48,950
!الّذين غادروا من هنا مشيًا؟

109
00:09:48,950 --> 00:09:51,200
!بـ-بالطّبع

110
00:09:52,540 --> 00:09:55,540
...إذًا لنبلغ آباءهم بأسمائهم

111
00:09:56,630 --> 00:10:01,460
بما أنّ الأطفال سيستيقظون
.من أحلامهم قريبًا

112
00:10:10,180 --> 00:10:14,220
مهلاً، لماذا تتحرّك أرجلنا من تلقاء نفسها؟

113
00:10:14,220 --> 00:10:15,810
!إلى أين نحن ذاهبون؟

114
00:10:16,100 --> 00:10:19,020
!لا أدري، لكنّه مكان بعيد على الأرجح

115
00:10:19,020 --> 00:10:21,560
!كاذب! هذا الغصن رقم 8

116
00:10:21,560 --> 00:10:23,150
!الطّريق الّتي أسلك إلى المنزل

117
00:10:23,150 --> 00:10:24,730
!نعم، أعلم ذلك

118
00:10:24,730 --> 00:10:28,490
.لكنّنا لا نتحكّم بحركاتنا
!لذلك لا خيار أمامنا سوى السّير

119
00:10:28,830 --> 00:10:31,240
...تعرّضنا للعنة بكلّ تأكيد

120
00:10:31,240 --> 00:10:34,360
!أنا متعب

121
00:10:34,360 --> 00:10:36,920
.إنّ الشّكوى والتّذمّر لن يغيّرا أيّ شيء

122
00:10:36,920 --> 00:10:39,620
!أهذا يعني أنّه لا يمكننا الذّهاب إلى المنزل؟

123
00:10:39,620 --> 00:10:41,920
!لا أحبّ هذا

124
00:10:45,340 --> 00:10:46,760
...كولون

125
00:10:47,090 --> 00:10:49,220
سنستطيع العودة للمنزل، صحيح؟

126
00:10:51,180 --> 00:10:52,890
كولون؟

127
00:10:56,940 --> 00:10:59,340
!لا

128
00:10:59,340 --> 00:11:02,760
!أريد رؤية أبي! أريد رؤية أمّي

129
00:11:02,760 --> 00:11:03,780
!لا

130
00:11:04,030 --> 00:11:06,240
!أبي! أمّي

131
00:11:06,240 --> 00:11:08,240
!لا يمكننا رؤيتهم

132
00:11:13,830 --> 00:11:17,620
!لا يمكننا رؤيتهم! نحن نتعرّض للاختطاف

133
00:11:23,460 --> 00:11:27,590
!ماذا؟! نتعرّض للاختطاف؟

134
00:11:27,590 --> 00:11:30,200
!لا تهلعوا! أنا هنا معكم

135
00:11:30,200 --> 00:11:33,810
،على عكسكم أيّها الجبناء
!فأنا محارب

136
00:11:33,810 --> 00:11:34,970
محارب؟

137
00:11:34,970 --> 00:11:38,140
...هذا صحيح! سأحميكم بالتّأكيد

138
00:11:44,190 --> 00:11:47,900
!وحش –
!شبح –

139
00:11:47,900 --> 00:11:50,070
!ساعدنا يا كولون

140
00:11:50,070 --> 00:11:51,780
!أجل! أنت محارب، صحيح؟

141
00:11:58,120 --> 00:12:01,000
!وحوش

142
00:12:03,340 --> 00:12:05,590
!كولون

143
00:12:10,590 --> 00:12:12,800
!يبدو أنّهم هزموا ساول

144
00:12:13,430 --> 00:12:15,010
!لنستدر

145
00:12:15,010 --> 00:12:17,520
!لنذهب لإنقاذ الأطفال

146
00:12:17,520 --> 00:12:21,480
!ولكن أيّها القبطانان، ثمّة ثقب في قاع السّفينة

147
00:12:21,510 --> 00:12:22,730
!ماذا؟

148
00:12:24,820 --> 00:12:27,490
!وكسروا مجاديفنا أيضًا

149
00:12:29,950 --> 00:12:32,700
!تبًّا! ما هذه القوّة؟

150
00:12:32,700 --> 00:12:35,090
!أيّ نوع من الوحوش هذه؟

151
00:12:35,090 --> 00:12:37,660
!لا أدري! لكنّها وحوشٌ نساء

152
00:12:39,710 --> 00:12:42,860
...ذاك يبدو مثل زوجتي نوعًا ما

153
00:12:42,860 --> 00:12:44,670
!انتبه لكلامك يا رجل

154
00:12:44,670 --> 00:12:48,300
أيّها القبطانان! ذلك الوحش يبدو
!مثل زوجتي أيضًا

155
00:12:48,300 --> 00:12:49,510
!ماذا؟

156
00:12:49,510 --> 00:12:50,970
...مهلاً لحظة

157
00:12:51,470 --> 00:12:53,470
...هذه الوحوش

158
00:12:55,930 --> 00:13:00,060
إنّها جميعًا وليدة مخاوف الأطفال، أليس كذلك؟

159
00:13:00,060 --> 00:13:03,390
.نعم، هذا ما قالته أنجي على أيّ حال

160
00:13:03,390 --> 00:13:06,520
...وزوجتك هذه

161
00:13:07,020 --> 00:13:09,990
هي والدة بينت، صحيح؟

162
00:13:09,990 --> 00:13:11,900
.نعم، بالطّبع

163
00:13:12,450 --> 00:13:15,660
إن كان ذلك هو ما يفكّر فيه بينت

164
00:13:16,030 --> 00:13:19,790
...عندما تخيّل أكثر شيء يخشاه

165
00:13:23,540 --> 00:13:26,420
...فإنّ الوحش الّذي يوجد أمامنا هنا

166
00:13:36,390 --> 00:13:39,680
!"أمّه"

167
00:13:44,270 --> 00:13:47,480
!هذا أكثر ما نخشاه نحن أيضًا

168
00:13:47,480 --> 00:13:51,570
!انتهى أمرنا –
!انهارت معنويّاتنا بالكامل –

169
00:13:53,570 --> 00:13:55,160
...أنا آسف يا عزيـ

170
00:14:05,620 --> 00:14:08,090
!ستندم

171
00:14:09,590 --> 00:14:12,590
!لا فرصة لدينا أمام زوجاتنا

172
00:14:33,150 --> 00:14:35,900
!أهذه إريك العظيمة؟

173
00:14:36,910 --> 00:14:39,490
!توقّفي يا عزيزتي

174
00:14:40,870 --> 00:14:44,000
!آسف لأنّي نسيت رمي القمامة يا عزيزتي

175
00:14:44,000 --> 00:14:47,330
!آسف لأنّي أقضي وقتًا كثير في الشّرب يا عزيزتي

176
00:14:47,330 --> 00:14:50,330
آسف لأنّي أكلت كعكة العسل
!المخصّصة للضّيوف

177
00:14:50,330 --> 00:14:53,010
!كلاّ! إنّ سُحب الجزر تتعرّض للضّرر

178
00:14:53,010 --> 00:14:56,440
!أيّها القبطانان! سوف نقع

179
00:14:56,440 --> 00:14:59,220
!أنا آسف

180
00:15:02,100 --> 00:15:06,560
لقد تحطّمت سفينة طاقم
!القراصنة العمالقة المرعبة

181
00:15:06,560 --> 00:15:09,220
.إنّ بعض تلك النّوميّات وحوش قويّة بالفعل

182
00:15:09,220 --> 00:15:12,360
!ماذا؟ طاقم دوري وبروغي؟

183
00:15:14,320 --> 00:15:16,200
!انظرن، لقد تحطّمت

184
00:15:16,200 --> 00:15:20,120
هذا لا يُصدّق! سفار طاقم
!القراصنة العمالقة؟

185
00:15:20,180 --> 00:15:21,330
!بسرعة

186
00:15:21,330 --> 00:15:23,360
.آمل أن يكون القبطانان بخير

187
00:15:23,360 --> 00:15:25,040
!سنعرف بعد أن نصل إلى هناك

188
00:15:27,120 --> 00:15:28,500
...حسنًا

189
00:15:28,500 --> 00:15:31,290
.سأدخل صلب الموضوع مباشرة

190
00:15:31,490 --> 00:15:34,920
.أيّها المحارب الأسطوريّ لحية الجبل يارول

191
00:15:35,130 --> 00:15:38,720
،بما أنّه لا ملك يجلس على عرش إلباف الآن

192
00:15:38,720 --> 00:15:41,010
.فإنّك هو أعلى سلطة تنوب عنه

193
00:15:42,050 --> 00:15:45,520
.إنّ غرضنا في غاية البساطة

194
00:15:45,770 --> 00:15:49,810
.نريد أن نجعل من العمالقةِ محاربينَ عبيدًا لنا

195
00:15:51,270 --> 00:15:55,150
وكخطوة أولى، عليّ أن أعرف
...ما مدى كفاءة

196
00:15:56,360 --> 00:15:59,070
.هؤلاء الأطفال الأشقياء كرهائن

197
00:15:59,320 --> 00:16:01,670
...لا بدّ أنّكم متشوّقون لمعرفة

198
00:16:01,670 --> 00:16:04,490
.من هم الأطفال العشرة المختطَفون

199
00:16:04,950 --> 00:16:06,250
ما أسماؤهم؟

200
00:16:09,540 --> 00:16:11,460
...هذه هي أسماء

201
00:16:11,920 --> 00:16:14,040
...أولئك الأطفال

202
00:16:14,380 --> 00:16:16,920
...الّذين اختُطفوا

203
00:16:21,590 --> 00:16:23,100
...أوّلاً

204
00:16:23,680 --> 00:16:25,060
.إلفا

205
00:16:25,890 --> 00:16:27,560
!أمّي

206
00:16:27,560 --> 00:16:28,890
!إلفا

207
00:16:28,890 --> 00:16:32,730
!ماذا؟! إلفا هي حفيدةُ حفيدتي

208
00:16:32,730 --> 00:16:35,020
...ثمّ سكالدي

209
00:16:35,020 --> 00:16:37,480
أليس بوسعنا فعل أيّ شيء بالفعل؟

210
00:16:37,480 --> 00:16:38,700
.أولاف

211
00:16:38,700 --> 00:16:40,950
!هذا مجرّد حلم! كابوس لا غير

212
00:16:40,950 --> 00:16:42,320
!أيّها القبطانان

213
00:16:42,320 --> 00:16:45,240
!أولاف هو حفيدي

214
00:16:45,240 --> 00:16:46,490
.كارين

215
00:16:47,620 --> 00:16:50,960
.حظّي عاثر في كلّ مرّة

216
00:16:50,960 --> 00:16:52,230
.ماغ

217
00:16:52,230 --> 00:16:55,030
!أنا قويّ، لكن لا أستطيع إيقاف نفسي

218
00:16:55,030 --> 00:16:56,340
.رونيا

219
00:16:56,370 --> 00:16:59,010
!لا داعي للقلق! سيكون كلّ شيء بخير

220
00:16:59,420 --> 00:17:02,720
!رونيا؟! ابنتي أيضًا؟

221
00:17:02,870 --> 00:17:05,600
!عليّ الإسراع إلى الغصن 8 لإنقاذها

222
00:17:10,020 --> 00:17:11,520
!سأتولّى أنا الأمور هنا

223
00:17:12,980 --> 00:17:15,190
...وبينت

224
00:17:15,400 --> 00:17:18,150
!ستكون أمّي غاضبة جدًّا منّي

225
00:17:19,150 --> 00:17:20,560
.يوهانا

226
00:17:20,560 --> 00:17:23,610
.على الأقلّ لديكم آباؤكم وأمّهاتكم

227
00:17:24,200 --> 00:17:26,580
...مع أنّي لا أريد والدين من الأساس

228
00:17:26,580 --> 00:17:27,860
.بيورن

229
00:17:27,860 --> 00:17:30,610
...آمل أن ينقذوني أنا على الأقلّ

230
00:17:30,610 --> 00:17:33,990
!أنت فظيع! كيف تقول كلامًا كهذا يا بيورن؟

231
00:17:33,990 --> 00:17:35,490
...آ-آسف

232
00:17:35,490 --> 00:17:37,130
!أنت مثلك أخيك تمامًا

233
00:17:37,800 --> 00:17:40,960
لا تضعيني في نفس الكفّة
...مع ذلك المريب

234
00:17:44,470 --> 00:17:46,100
...هذه هي

235
00:17:48,350 --> 00:17:51,520
...كانت هذه هي أسماء الأطفال المختطفين

236
00:17:51,520 --> 00:17:53,310
.من المدرسة

237
00:17:58,230 --> 00:18:00,400
!أيّها القبطانان

238
00:18:01,690 --> 00:18:03,670
...يا لها من كارثة

239
00:18:03,670 --> 00:18:04,780
!يا-سان

240
00:18:05,200 --> 00:18:06,780
!هذه أنت يا ريبلي

241
00:18:06,780 --> 00:18:08,370
!إنّكم جميعًا بخير

242
00:18:08,950 --> 00:18:10,240
ومن تكون...؟

243
00:18:10,240 --> 00:18:12,080
.إنّهم تسعة أطفال

244
00:18:13,750 --> 00:18:17,710
...ولكن، انضمّ إليهم محارب صغير

245
00:18:17,710 --> 00:18:21,710
بعد أن حاول إنقاذ أصدقائه
!يُدعى كولون

246
00:18:22,130 --> 00:18:24,300
.وبهذا، يصير عدد الأطفال عشرة

247
00:18:24,300 --> 00:18:26,260
!ماذا؟! كولون؟

248
00:18:26,470 --> 00:18:30,470
أسمعت ذلك يا ريبلي؟
!أنا فخور بك يا بُنيّ

249
00:18:30,470 --> 00:18:33,020
.هذا ليس وقتًا مناسبًا لذلك

250
00:18:33,980 --> 00:18:36,190
.والآن، إليكم أوامري

251
00:18:36,190 --> 00:18:38,230
.اسمعوا جيّدًا يا عمالقة إلباف

252
00:18:38,650 --> 00:18:41,480
!لا فائدة لمدرستكم في الحرب

253
00:18:42,360 --> 00:18:46,110
ومكتبتكم مليئة بسجلاّت
!الماضي عديمة القيمة

254
00:18:47,530 --> 00:18:50,160
!أريد منكم إحراقهما عن بكرة أبيهما حالاً

255
00:18:57,290 --> 00:19:00,790
!وبعد ذلك، ستقسمون بالولاء لنا

256
00:19:04,630 --> 00:19:06,630
...وإن رفضتم

257
00:19:06,630 --> 00:19:08,180
...فإنّ أطفالكم

258
00:19:09,600 --> 00:19:11,310
...سيلقون حتفهم

259
00:19:11,640 --> 00:19:13,520
.الواحد تلو الآخر

260
00:19:24,150 --> 00:19:26,610
!لقد فقد عقله بالكامل

261
00:19:30,030 --> 00:19:32,330
!نحن نعرف مكان الأطفال

262
00:19:32,660 --> 00:19:33,790
!نعم

263
00:19:34,490 --> 00:19:37,000
...لنذهب ونوسعهم ضربًا

264
00:19:37,000 --> 00:19:39,580
!وننقذ الأطفال

265
00:19:44,380 --> 00:19:45,510
!حسنًا

266
00:19:45,880 --> 00:19:47,880
...والآن أيّها الشّيخ يارول

267
00:19:49,090 --> 00:19:51,470
.أصبح القرار لك

268
00:19:52,260 --> 00:19:54,100
لي؟

269
00:19:56,560 --> 00:19:58,640
!انتظر رجاءً

270
00:19:58,640 --> 00:20:01,020
!هذا قاس للغاية

271
00:20:01,690 --> 00:20:05,400
إنّ المدرسة رمز للسّلام الّذي يخيّم
!على إلباف الآن

272
00:20:05,900 --> 00:20:07,610
...والمكتبة

273
00:20:08,610 --> 00:20:11,990
...تضمّ المكتبة تاريخ إلباف العريق

274
00:20:11,990 --> 00:20:17,910
ومعارف من العالم صارت متوفّرة لدينا
!بفضل تضحيات علماء أوهارا

275
00:20:22,330 --> 00:20:23,590
...روبين

276
00:20:23,590 --> 00:20:25,210
...هذه المكتبة

277
00:20:25,210 --> 00:20:29,170
!ثروة لا تنتمي لإلباف فحسب

278
00:20:29,880 --> 00:20:31,970
...اهدئي يا امرأة

279
00:20:33,180 --> 00:20:35,430
!اهدئي يا روبين

280
00:20:35,430 --> 00:20:36,890
!إيّاكِ

281
00:20:37,770 --> 00:20:39,350
ما قرارك؟

282
00:20:40,140 --> 00:20:41,730
...الأطفال

283
00:20:44,730 --> 00:20:46,820
أم ولاؤكم لنا؟

284
00:20:51,700 --> 00:20:53,700
!رجاءً يا يا-سان

285
00:20:54,830 --> 00:20:55,830
!أجل

286
00:21:04,290 --> 00:21:06,420
...لن أسمح لهم

287
00:21:08,420 --> 00:21:10,170
!بفعل أيّ من ذلك

288
00:21:11,590 --> 00:21:16,600
يُتبع

289
00:22:50,360 --> 00:22:54,150
يتصاعد التّوتّر في إلباف الآن بعد
.أن صار بعض أطفالها رهائن

290
00:22:54,150 --> 00:22:58,700
يهدّد فرسان الإله القساة حياة طفلة
.صغيرة للضّغط على العمالقة

291
00:22:58,700 --> 00:23:01,450
،مع بدء العدّ التّنازليّ المميت

292
00:23:01,450 --> 00:23:05,460
.يواجه يارول خيارًا مستحيلاً
ماذا سيقرّر يا ترى؟

293
00:23:05,610 --> 00:23:07,290
:في الحلقة القادمة من وان بيس

294
00:23:07,290 --> 00:23:11,170
- حماية الماضي والمستقبل"
"روبن وغابان يهاجمان

295
00:23:11,320 --> 00:23:13,590
!ملك القراصنة، لن يكون إلاّ أنا