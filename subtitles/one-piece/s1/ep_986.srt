1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,100 --> 00:02:01,860
،بينما يسير المهرجان الذّهبيّ على قدم وساق

29
00:02:02,230 --> 00:02:07,200
.أوكلت مهمّة للتّوبي روبّو الّذين اجتمعوا حول كايدو

30
00:02:07,950 --> 00:02:12,200
.لذلك، إليكم ما أريد منكم فعله

31
00:02:12,450 --> 00:02:15,670
،اختفى ابني الغبيّ ياماتو اليوم

32
00:02:15,670 --> 00:02:18,670
!وأريد منكم إحضاره لي

33
00:02:20,880 --> 00:02:27,720
أثناء ذلك، كان لوفي والبقيّة ممّن تسلّلوا
...إلى أونيغاشيما للإطاحة بكايدو

34
00:02:28,600 --> 00:02:31,220
!مهلاً! إنّ الحساء يغطّيك بالكامل

35
00:02:31,220 --> 00:02:35,310
!لا يأكل المرء حساء الفاصولياء الحمراء
!بل يغطّي نفسه به

36
00:02:36,560 --> 00:02:40,690
!أحضروا الحساء! سنسكبه على بعضنا

37
00:02:47,860 --> 00:02:50,240
...فاكهة المطّاط

38
00:02:51,620 --> 00:02:54,330
!مسدّس الفيل

39
00:03:16,180 --> 00:03:21,150
!لماذا لا تستطيع التّسلّل بهدوء؟

40
00:03:24,150 --> 00:03:28,530
"!موسيقى القتال! قدرة تؤذي لوفي"

41
00:03:50,890 --> 00:03:56,310
!إنّه لذيذ! هذا الحساء لذيذ للغاية

42
00:03:59,560 --> 00:04:03,360
هؤلاء الحمقى كانوا يسكبون
!حساء الفاصولياء الحمراء قصدًا

43
00:04:07,190 --> 00:04:09,990
!ماذا؟ حساء الفاصولياء الحمراء؟

44
00:04:23,500 --> 00:04:26,550
!في تلك الحالة، عليّ تقطيعهم جميعًا

45
00:04:26,550 --> 00:04:27,960
...نعم

46
00:04:27,960 --> 00:04:29,760
!إنّه لذيذ

47
00:04:34,010 --> 00:04:36,260
ما هذه المفاجأة؟

48
00:04:39,850 --> 00:04:44,440
حساء فاصولياء حمراء؟
لماذا غضبا بسبب شيء كهذا؟

49
00:04:44,440 --> 00:04:48,150
أهو أمر يثير حفيظتهما؟
...لا أفهم ما يجري

50
00:04:48,150 --> 00:04:51,900
.لا فائدة من ذلك الطّاقم
.لا يمكنني العمل معهم

51
00:04:52,860 --> 00:04:58,540
كان من المستحيل لذلك الغبيّين بالبقاء
.بعيدًا عن الأنظار من الأساس

52
00:04:59,530 --> 00:05:00,710
ما العمل؟

53
00:05:00,710 --> 00:05:04,560
.انس الأمر. علينا مواصلة التّقدّم

54
00:05:04,560 --> 00:05:06,460
!إنّنا قريبون جدًّا

55
00:05:07,630 --> 00:05:10,420
.أحدثنا فوضى كبيرة في النّهاية

56
00:05:10,710 --> 00:05:13,890
.هذا صحيح، لكن لم يكن أمامنا خيار

57
00:05:13,890 --> 00:05:17,850
نعم، لم يكن أمامنا خيار بما أنّ للأمر
.علاقة بحساء الفاصولياء الحمراء

58
00:05:18,840 --> 00:05:23,480
.لكن لم يحن الوقت لبدء معركة بعد

59
00:05:23,770 --> 00:05:27,730
.أعلم. ما زالوا لا يعرفون من نكون

60
00:05:31,990 --> 00:05:34,410
أأنت سعيد الآن؟

61
00:05:34,690 --> 00:05:35,780
!نعم

62
00:05:36,070 --> 00:05:37,950
...في تلك الحالة

63
00:05:46,130 --> 00:05:47,420
!لنهرب

64
00:05:47,420 --> 00:05:48,170
!أجل

65
00:05:48,170 --> 00:05:49,960
!إنّهما يهربان

66
00:05:52,210 --> 00:05:54,260
!أمسكا بهما

67
00:05:58,840 --> 00:06:02,890
!مهلاً، ما الّذي يحدث؟

68
00:06:07,110 --> 00:06:09,520
...إنّهما... غير معقول

69
00:06:17,450 --> 00:06:19,330
!أبا-بايو! استمعوا لهذا

70
00:06:20,700 --> 00:06:25,830
!كوين-سان، أحتاج لإخبارك بشيء مهمّ، فاستمع لي

71
00:06:29,090 --> 00:06:30,710
!أجل! استمعوا

72
00:06:30,710 --> 00:06:33,170
!حسنًا يا أبو! أبو! أبو

73
00:06:33,170 --> 00:06:38,640
!أطلعني بالأمر المهمّ بأنغام الأخ أبو الجميلة، بو

74
00:06:40,050 --> 00:06:42,940
!حسنًا، حسنًا! أبا-باو

75
00:06:54,650 --> 00:06:56,610
ما الخطب يا كيد؟

76
00:07:02,990 --> 00:07:07,330
!هذا هو وقتي! سوف أخاطر بحياتي
!وسأرسل أفضل موجاتي

77
00:07:07,580 --> 00:07:09,630
...هذا الصّوت

78
00:07:25,140 --> 00:07:26,350
!استمعوا

79
00:07:26,350 --> 00:07:30,980
الهرب تحت سطوتك في أودون
!يجعل المجرّبين له فاشلون

80
00:07:32,390 --> 00:07:35,280
،الفئران المأسورة هناك بلا مهرب

81
00:07:37,950 --> 00:07:40,280
!لكن انظر لهذين الاثنين عن قرب

82
00:07:43,990 --> 00:07:45,580
هل نقاتل؟

83
00:07:48,080 --> 00:07:53,420
!عث فسادًا بنفسك وأطلق العنان له
!فلا يمكن لي أن أنسى ذلك الوجه

84
00:08:00,210 --> 00:08:01,840
!غير ممكن

85
00:08:17,320 --> 00:08:19,700
...بل ممكن! لا بدّ أنّهما

86
00:08:23,900 --> 00:08:29,210
!قبّعة القشّ لوفي وصائد القراصنة زورو بعينهما

87
00:08:34,710 --> 00:08:37,380
...إذًا فقد هرب من السّجن

88
00:08:46,720 --> 00:08:48,850
!كيف يعقل هذا؟

89
00:08:48,850 --> 00:08:50,430
!فتح

90
00:08:51,140 --> 00:08:53,060
!مرحبًا، هذا كوين

91
00:08:53,060 --> 00:08:57,230
!معك المأمور بابانوكي من أودون

92
00:08:57,230 --> 00:08:59,800
قبّعة القشّ وكابتن كيد

93
00:08:59,800 --> 00:09:03,860
.وبقيّة الصّعاليك جميعهم خلف القضبان الآن

94
00:09:03,860 --> 00:09:05,030
...فهمت

95
00:09:05,030 --> 00:09:07,790
...اتّصلت بك فقط لأعلمك أنّ كلّ شيء بخير

96
00:09:09,250 --> 00:09:11,440
!ذلك اللّعين بابانوكي

97
00:09:11,440 --> 00:09:14,130
!هل كذب عليّ؟

98
00:09:22,840 --> 00:09:25,680
!اليوم هو المهرجان الذّهبيّ السّعيد

99
00:09:27,600 --> 00:09:31,560
!وكهديّة لي، أمسكوا بهما من جديد

100
00:09:33,060 --> 00:09:37,940
!يا كوين-سان! علام سيحصل من سيمسك بهما؟

101
00:09:37,940 --> 00:09:42,950
...شاءت الصّدف أنّني أريد التّخلّص

102
00:09:44,740 --> 00:09:47,330
!من أحد التّوبي روبّو

103
00:10:17,770 --> 00:10:23,070
سأنحّي أحد أعضاء التّوبي روبّو وسأمنح
!المنصب الشّاغر لماسك الفئران

104
00:10:34,080 --> 00:10:35,920
.التّوبي روبّو إذًا

105
00:10:35,920 --> 00:10:39,130
!هذه مكافأة تستحقّ العناء

106
00:10:41,040 --> 00:10:43,420
!سيكون ذلك المنصب لي

107
00:10:50,850 --> 00:10:52,720
!مهلاً يا كيد

108
00:10:52,720 --> 00:10:55,640
!مكافأة تجعل الهدف يستحقّ السّعي خلفه

109
00:11:13,200 --> 00:11:16,330
!عرفتُ أنّه كان أنت

110
00:11:19,660 --> 00:11:22,340
!مرحبًا يا كابتن كيد

111
00:11:22,580 --> 00:11:26,510
!تبدو منزعجًا كالعادة

112
00:11:27,210 --> 00:11:30,340
!سكراتشمن! ما الّذي تفعله؟

113
00:11:30,340 --> 00:11:33,760
!أحدثت فوضى عارمة في معقلنا

114
00:11:33,760 --> 00:11:38,120
.كنتُ أحرص أنّك لا تملك أيّ قنّاصين

115
00:11:38,120 --> 00:11:42,730
.هذا ما كان ليفعله أيّ أحد إن استدعاه عدوّه

116
00:11:42,730 --> 00:11:44,440
!أرأيت يا كيلر؟

117
00:11:44,440 --> 00:11:48,320
!لهذا السّبب أخبرتك ألاّ تستدعيه

118
00:11:48,320 --> 00:11:52,340
.اهدأ. إنّه رجل قويّ

119
00:11:52,340 --> 00:11:57,620
.إنّه لاستهتار منك أن تدع ضيوفك ينتظرون

120
00:11:59,120 --> 00:12:01,900
...وغد تلو الآخر

121
00:12:01,900 --> 00:12:04,040
!سأقتلكما معًا الآن

122
00:12:21,900 --> 00:12:24,750
!ما هذا الوحش؟

123
00:12:24,750 --> 00:12:28,820
!سُحقًا! رأسي يؤلمني

124
00:12:29,610 --> 00:12:32,430
.أفترض أنّه من الصّعب الموت

125
00:12:32,430 --> 00:12:34,660
!نجوتُ ثانية

126
00:12:38,620 --> 00:12:44,170
تمكّن اللّحية البيضاء العجوز ذاك
.من أن ينجح في ذلك

127
00:12:56,760 --> 00:13:00,480
!لا خيار أمامي الآن، صحيح؟

128
00:13:19,580 --> 00:13:24,580
!قبّعة القشّ لوفي! ترافالغار لو

129
00:13:25,000 --> 00:13:29,480
ذلكما الشّقيّان يظنّان أنّهما مميّزان
!فقط لأنّهما أطاحا بشيتشيبوكاي

130
00:13:29,480 --> 00:13:34,890
!لا بدّ أنّهما قد أدركا أنّهما أفسدا عملي

131
00:13:40,600 --> 00:13:43,480
!سُحقًا لهما

132
00:13:49,730 --> 00:13:56,580
!اسمع أنت! أخبر ذلكما الغبيّين من جيلك

133
00:13:57,580 --> 00:14:03,960
من الأفضل أن تهربا! ما كنّا نفعله"
"!كان مجرّد لعبة قراصنة لا غير

134
00:14:04,830 --> 00:14:09,090
!يوستاس "كابتن" كيد

135
00:14:10,580 --> 00:14:12,680
!أبو

136
00:14:38,110 --> 00:14:40,530
!لا بدّ أنّها قلعة كايدو في الخلف

137
00:14:40,530 --> 00:14:42,870
!لنؤجّل القتال ونتّجه إلى هناك فحسب

138
00:14:42,870 --> 00:14:43,950
!أكيد

139
00:15:03,220 --> 00:15:07,100
.لا يوجد هنا سوى مثيرو المشاكل

140
00:15:07,100 --> 00:15:11,320
أظنّ أنّ جميعهم مستعملو قوى
!فاكهة سمايل! يا لوفي

141
00:15:11,940 --> 00:15:15,270
!هذه قلعة أحد اليونكو

142
00:15:15,270 --> 00:15:20,160
...إن ثرنا هنا بلا هدف، فلن تظلّ لنا طاقة

143
00:15:20,450 --> 00:15:21,830
!لهزيمة كايدو

144
00:15:21,830 --> 00:15:23,160
!أكيد

145
00:15:29,830 --> 00:15:33,800
!أبا-باو! أشعر بهذا الإيقاع العظيم بكلّ حواسي

146
00:15:45,140 --> 00:15:47,180
ما هذا الصّوت؟

147
00:15:57,650 --> 00:16:00,700
!استمعا لموسيقى القتال خاصّتي

148
00:16:00,700 --> 00:16:02,160
!خدش

149
00:16:04,410 --> 00:16:05,410
!ضرب

150
00:16:13,460 --> 00:16:14,590
!لوفي

151
00:16:14,590 --> 00:16:16,760
!ماذا؟! لُكمتُ للتّوّ؟

152
00:16:21,630 --> 00:16:25,600
...كان ذلك الرّجل حليف المسنّن والبقيّة

153
00:16:27,180 --> 00:16:28,520
!تقطيع

154
00:16:30,140 --> 00:16:31,230
!زورو

155
00:16:31,230 --> 00:16:32,600
!قُطعت؟

156
00:16:35,400 --> 00:16:40,280
لكنّه لم يكن يملك سيفًا
.ولم أستطع رؤية خطّ هجومه إطلاقًا

157
00:16:41,070 --> 00:16:43,410
ما نوع القدرة الّتي يملكها؟

158
00:16:48,080 --> 00:16:49,000
!انفجار

159
00:16:52,290 --> 00:16:53,580
!لوفي

160
00:16:53,580 --> 00:16:56,170
!ا-ا-ا... استمعوا

161
00:16:57,790 --> 00:17:01,970
!مهلاً، كان ذلك سهلاً! أيعقل هذا؟

162
00:17:08,390 --> 00:17:10,850
!لا فائدة! علينا الابتعاد من هنا

163
00:17:10,850 --> 00:17:16,040
!أنتم هناك! لا تسمحوا لهما بالهرب

164
00:17:16,040 --> 00:17:21,280
إن كنتم تريدون أن تصبحوا
!من التّوبي روبّو، فاستحقّوا ذلك

165
00:17:22,360 --> 00:17:25,200
...إن تلقّينا أيّ ضرر هنا

166
00:17:29,200 --> 00:17:32,080
!فلن نتمكّن من قتال كايدو

167
00:17:32,080 --> 00:17:34,830
.كما هو مُتوقّع، تعدادهم ليس كلّ شيء

168
00:17:35,790 --> 00:17:37,880
.جميعهم أقوياء

169
00:17:37,880 --> 00:17:40,300
!منصب التّوبي روبّو لي أنا

170
00:17:45,550 --> 00:17:48,760
.آسف. أنا بخير الآن

171
00:17:48,760 --> 00:17:51,150
.بالطّبع أنت كذلك

172
00:17:51,350 --> 00:17:53,100
.لا تسبّب لي المشاكل

173
00:17:56,060 --> 00:17:58,980
.ما من حاجة لارتداء هذه الآن

174
00:17:58,980 --> 00:18:02,690
.معك حقّ. كان من الصّعب القتال بها أيضًا

175
00:18:02,690 --> 00:18:04,370
.حسنًا

176
00:18:06,400 --> 00:18:09,790
!لا مزيد من التّنكّر! لنخرج من هنا بسرعة

177
00:18:10,160 --> 00:18:11,660
!حاضر

178
00:18:12,000 --> 00:18:16,940
.لا فائدة. أنتما في مرماي

179
00:18:16,940 --> 00:18:18,460
!استمعوا

180
00:18:22,380 --> 00:18:23,630
!تقطيع

181
00:18:25,460 --> 00:18:26,470
!زورو

182
00:18:26,470 --> 00:18:27,340
!ضرب

183
00:18:36,350 --> 00:18:37,400
!لوفي

184
00:18:42,520 --> 00:18:44,990
...لديه القدرة لاستعمال الموسيقى كسلاح

185
00:18:46,780 --> 00:18:49,250
كيف نحمي أنفسنا؟

186
00:18:50,780 --> 00:18:52,040
!خدش

187
00:19:21,400 --> 00:19:22,860
!استمعوا

188
00:19:38,120 --> 00:19:40,080
!سأقتله

189
00:19:42,590 --> 00:19:44,170
!إيّاك يا كيد

190
00:20:09,780 --> 00:20:11,620
!ستُكتشف هويّتك

191
00:20:38,140 --> 00:20:40,900
!لا أهتمّ

192
00:20:56,240 --> 00:20:57,830
!ماذا؟

193
00:21:02,040 --> 00:21:04,250
!مفاجأة

194
00:21:19,060 --> 00:21:23,020
!ذلك الخائن اللّعين

195
00:21:40,660 --> 00:21:44,750
!أنت المُلام على كلّ شيء

196
00:22:00,640 --> 00:22:03,600
!إلى الجحيم يا أبو

197
00:22:03,600 --> 00:22:05,060
!كيد

198
00:22:05,060 --> 00:22:07,520
...الوتر

199
00:22:20,370 --> 00:22:22,790
!المغناطيسيّ

200
00:22:33,340 --> 00:22:35,350
...أبو

201
00:23:04,160 --> 00:23:10,690
!يظهر أحد الأرقام العمالقة الضّخام
!يهيج في ساحة الوليمة ويحوّلها جحيمًا

202
00:23:10,690 --> 00:23:15,340
،بينما بدأت خطّتهم تأخذ مجرى خاطئًا
!يُصدم سانجي بشدّة؟

203
00:23:15,970 --> 00:23:22,270
!إنّ شارع البغاء يمتلئ بالفتن
!تزيد رغباتك كلّما اقتربت أكثر

204
00:23:22,560 --> 00:23:27,170
:في الحلقة القادمة من وان بيس
"!حُطّم حُلمه؟! الفخّ الّذي استدرج سانجي"

205
00:23:27,170 --> 00:23:31,690
!ملك القراصنة، لن يكون إلاّ أنا