1
00:00:08,210 --> 00:00:11,240
!العالم... نعم

2
00:00:11,780 --> 00:00:13,440
...اسعوا نحو الحرّيّة

3
00:00:13,440 --> 00:00:17,620
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,950 --> 00:00:21,350
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,850 --> 00:00:23,220
!فتجاوزوها

6
00:00:23,620 --> 00:00:26,590
!تحت راية ما تؤمنون به

7
00:00:31,060 --> 00:00:36,670
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,670 --> 00:00:39,900
متّجهًا نحو عالم بلا نهاية

9
00:00:41,310 --> 00:00:46,180
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,180 --> 00:00:54,590
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,590 --> 00:01:00,320
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,320 --> 00:01:04,760
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,760 --> 00:01:10,400
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,400 --> 00:01:14,270
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,270 --> 00:01:19,210
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,210 --> 00:01:26,950
متّجهين نحو الأفق

17
00:01:26,950 --> 00:01:32,460
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,460 --> 00:01:37,160
متّجهًا نحو عالم بلا نهاية

19
00:01:37,160 --> 00:01:42,400
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,400 --> 00:01:48,670
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:01,020 --> 00:02:04,060
،بعد دخول غابة الوهم في السّاحة العليا

22
00:02:04,620 --> 00:02:08,690
"واجه لوفي والبقيّة "محنة الكرات
!العنيفة من الكاهن ساتوري

23
00:02:12,030 --> 00:02:16,300
في تلك الأثناء، هُزم غان فول
.على يد الكاهن شورا

24
00:02:16,300 --> 00:02:18,370
!يا فارس السّماء

25
00:02:21,940 --> 00:02:26,280
!يا نامي! أترين أيّ شيء؟

26
00:02:26,510 --> 00:02:30,620
مهاجمتي تعني إعلان
!الحرب ضدّ الإله إنيل العظيم

27
00:02:30,980 --> 00:02:33,320
.أغلق فمك! وإلاّ تسرّبت النّكهة

28
00:02:34,090 --> 00:02:36,420
!هذه... محنة الحبّ

29
00:02:36,620 --> 00:02:40,320
!أهذا الشّخص أحمق أيضًا؟

30
00:02:41,530 --> 00:02:43,260
!سحق

31
00:02:47,930 --> 00:02:51,440
!أشعلوا نار شاندورا"
".المحارب وايبر

32
00:02:53,440 --> 00:02:57,510
.دخل الإله السّابق غان فول للسّاحة العليا

33
00:02:58,440 --> 00:03:01,110
.أشكّ أنّ إنيل قد يدعه وشأنه

34
00:03:01,650 --> 00:03:04,320
هل يحاول غان فول مواجهة إنيل؟

35
00:03:04,320 --> 00:03:09,320
مستحيل... يصعب التّفكير
.أنّ ذلك العجوز بذلك العزم

36
00:03:24,440 --> 00:03:26,340
ما الخطب يا أيسا؟

37
00:03:26,970 --> 00:03:28,940
.اختفى صوتان

38
00:03:28,940 --> 00:03:29,810
!ماذا قلتِ؟

39
00:03:31,180 --> 00:03:32,280
أهذه المانترا خاصّتك؟

40
00:03:32,280 --> 00:03:35,750
...نعم... قبل قليل

41
00:03:38,680 --> 00:03:42,350
أهذا ما تقوله لك المانترا خاصّتك يا أيسا؟

42
00:03:42,350 --> 00:03:45,720
!ما عدتِ تسمعين صوتين... صحيح؟

43
00:03:48,660 --> 00:03:49,790
.لا مجال للشّكّ

44
00:03:50,160 --> 00:03:54,030
تعلمون جميعًا أنّ باستطاعتها
،استعمال المانترا منذ ولادتها

45
00:03:54,030 --> 00:03:59,340
وهي قوّة غامضة تمكّنها من
.استشعار النّاس حتّى عن بعد

46
00:04:00,500 --> 00:04:02,770
ما عدت تسمعين صوت شخصين، صحيح؟

47
00:04:02,770 --> 00:04:05,180
...نعم... اختفيا في نفس الوقت

48
00:04:05,780 --> 00:04:09,610
...أعتقد أنّهما لغان فول وأحد الكهنة

49
00:04:09,610 --> 00:04:10,380
أقتلا بعضهما؟

50
00:04:10,380 --> 00:04:12,280
.أحسنت أيّها العجوز

51
00:04:12,280 --> 00:04:13,950
.بقي الآن ثلاثة كهنة

52
00:04:13,950 --> 00:04:15,520
.هذا يصبّ في مصلحتنا

53
00:04:16,650 --> 00:04:20,460
.يبدو أنّ السّماء لبّت صلواتنا

54
00:04:21,760 --> 00:04:25,300
.هذه فرصتنا لسحق الكهنة

55
00:04:25,600 --> 00:04:26,900
!نعم

56
00:04:27,330 --> 00:04:30,800
سنشنّ هجومًا شاملاً على السّاحة
!العليا في الحال

57
00:04:31,270 --> 00:04:32,400
!أجل

58
00:04:36,070 --> 00:04:40,310
لم تشعري بالرّاحة أبدًا حول وايبر، صحيح؟

59
00:04:40,510 --> 00:04:41,810
.والآن، ابتعدي عن الطّريق

60
00:04:41,810 --> 00:04:42,350
!هذا مؤلم

61
00:04:44,220 --> 00:04:45,950
!انتظري يا راكي

62
00:04:46,580 --> 00:04:47,550
ماذا هنالك؟

63
00:04:47,750 --> 00:04:50,520
.لم يُهزم الكاهن على يد غان فول

64
00:04:50,520 --> 00:04:53,720
،ثمّة أشخاص آخرون هناك
.وكان ذلك من صنيعهم

65
00:04:54,130 --> 00:04:55,060
أشخاص آخرون؟

66
00:04:55,390 --> 00:04:58,060
تقصدين سكّان البحر الأزرق
الّذين دخلوا سكايبيا؟

67
00:04:58,060 --> 00:05:01,030
!لا أدري، لكنّهم مخيفون بكلّ تأكيد

68
00:05:01,630 --> 00:05:02,600
...لذلك

69
00:05:04,670 --> 00:05:05,970
.كوني حذرة

70
00:05:08,840 --> 00:05:13,410
.مفهوم... أعطني حقيبتك يا أيسا

71
00:05:13,410 --> 00:05:17,920
ماذا؟! كلاّ! هذه حقيبتي السّرّيّة
!وكنزي موجود فيها

72
00:05:18,250 --> 00:05:19,520
.أعلم ذلك

73
00:05:22,490 --> 00:05:25,390
.سأحضر بعضه من أجلك أيضًا

74
00:05:25,390 --> 00:05:26,120
!فعلاً؟

75
00:05:26,120 --> 00:05:26,690
.نعم

76
00:05:32,900 --> 00:05:35,270
.توقّف عن ثرثرته أخيرًا

77
00:05:35,570 --> 00:05:38,900
يا له من وغد لسخريته منّا
...ببعض الحيل الغبيّة

78
00:05:38,900 --> 00:05:43,640
ما بالهم؟ كيف عرف هجماتنا وما شابه؟

79
00:05:43,910 --> 00:05:45,610
!اسمعا

80
00:05:45,610 --> 00:05:48,410
!لوفي! سانجي! وجدتُ القارب

81
00:05:48,410 --> 00:05:51,550
!أسرعا! وإلاّ غادر الغابة

82
00:05:53,180 --> 00:05:54,690
.كان أوسوبّ بخير

83
00:05:54,690 --> 00:05:56,990
!مهلاً، قال أنّ القارب يغادر الغابة

84
00:05:57,620 --> 00:06:01,860
!مصيبة! يكاد يصل إلى مخرج الغابة

85
00:06:03,560 --> 00:06:06,230
!اسمعا! تشبّثا بجسدي

86
00:06:06,230 --> 00:06:06,730
!بجسدك؟

87
00:06:07,200 --> 00:06:08,330
!هيّا بنا

88
00:06:08,330 --> 00:06:14,310
!أوسوبّ آا-اا-اه

89
00:06:19,240 --> 00:06:21,410
!حسنًا! أمسكت به

90
00:06:21,410 --> 00:06:23,710
!مرحى! أنت مدهش يا أوسوبّ

91
00:06:23,710 --> 00:06:26,980
!ذلك مؤلم! هل تحاولان قتلي؟

92
00:06:26,980 --> 00:06:27,720
.تحمّستُ قليلاً فحسب

93
00:06:27,720 --> 00:06:30,250
!لقد اعوجّ ظهري

94
00:06:30,250 --> 00:06:31,790
مهلاً! يمكنك إصلاحه بتلك السّهولة؟

95
00:06:31,790 --> 00:06:32,990
.لا شيء مستحيل عندي

96
00:06:32,990 --> 00:06:34,990
!بإمكانك أن تكون رائعًا أحيانًا

97
00:06:35,030 --> 00:06:37,360
!أجل! استخففتما بي، صحيح؟

98
00:06:41,330 --> 00:06:42,900
!مـ-مـ-مهلاً لحظة
!ماذا تفعل؟! اتركني

99
00:06:42,900 --> 00:06:45,640
!مهلاً يا سانجي-كُن
!إن كنّا سنموت، فسنموت معًا

100
00:06:45,640 --> 00:06:46,840
!و-وأنا أيضًا؟

101
00:06:58,380 --> 00:07:00,380
...هذا سهل

102
00:07:00,380 --> 00:07:02,590
!سأحاسبك لاحقًا على هذا

103
00:07:02,590 --> 00:07:07,260
.لكن الأمر أفضل لو مدّدتُ نفسي

104
00:07:08,730 --> 00:07:12,930
.على كلّ حال، إنّنا نخرج من غابة الوهم الآن

105
00:07:25,980 --> 00:07:29,580
.لا... لا يمكنني السّباحة

106
00:07:32,980 --> 00:07:34,650
!فارس السّماء

107
00:07:36,290 --> 00:07:37,560
.ذلك الطّائر الغريب أيضًا

108
00:07:38,320 --> 00:07:42,960
صحيح، إنّه من مستعملي
.فاكهة الشّيطان مثلي

109
00:07:43,890 --> 00:07:49,030
.سُحقًا! لم أستطع... إنقاذهما

110
00:07:58,540 --> 00:08:02,810
.كلاّ... أشعر... بالضّعف

111
00:08:04,180 --> 00:08:06,180
.سقط ساتوري

112
00:08:07,320 --> 00:08:10,250
!يا له من مبتدئ، شتّت المانترا خاصّته

113
00:08:11,120 --> 00:08:14,530
إن لم أكن مخطئًا، فإنّ الوافدين
.غير القانونيّين أتوا من البحر الأزرق

114
00:08:14,530 --> 00:08:16,860
.يبدو أنّهم ليسوا أشخاصًا عاديّين

115
00:08:16,860 --> 00:08:19,500
.إنّ القرابين تتجوّل في الأرجاء بحرّيّة أيضًا

116
00:08:19,500 --> 00:08:21,770
،ولكن، حتّى إن تركناهم وشأنهم الآن

117
00:08:21,770 --> 00:08:24,300
على الأرجح أنّهم لن يجدوا طريقة
.لمغادرة هذه الجزيرة

118
00:08:26,040 --> 00:08:27,270
...والأهمّ من ذلك، علينا أن

119
00:08:38,550 --> 00:08:41,550
هل تشعر بصوت محارب حزين يا هولي؟

120
00:08:42,720 --> 00:08:45,290
،لا يهمّ كم مرّة سنتقاتل
.فالنّتيجة لا تتغيّر

121
00:08:45,960 --> 00:08:49,860
،هزم شورا غان فول
.لكنّ "محنة الكرات" قد حُطّمت

122
00:08:50,630 --> 00:08:53,230
!يا له من يوم مضطرب

123
00:08:54,200 --> 00:08:58,440
لن أسمح لهم بالمرور. حتّى
.محاولتهم لرؤية الإله ستكون وقاحة

124
00:08:59,440 --> 00:09:01,540
،رغم أنّ الشّمس ستغرب قريبًا

125
00:09:01,540 --> 00:09:03,140
...يبدو أنّ السّاحة العليا ستصبح الآن

126
00:09:05,610 --> 00:09:07,680
.متزعزعة نوعًا ما

127
00:09:10,080 --> 00:09:12,720
.لا أهتمّ بالهاربين بعد الآن

128
00:09:12,720 --> 00:09:17,150
يبدو أنّه ظهر بعض الخصوم
.الّذين عليهم مواجهة غضبي

129
00:09:41,580 --> 00:09:43,250
!اسمعوا يا رفاق

130
00:09:43,680 --> 00:09:46,420
!السّاحة العليا متزعزعة الآن

131
00:09:46,920 --> 00:09:49,350
!هذه فرصة العمر

132
00:09:49,720 --> 00:09:52,720
!اتّجهوا صوب "ضريح الإله" مهما حدث

133
00:09:53,490 --> 00:09:55,560
!لا تخشوا إنيل

134
00:09:56,330 --> 00:10:01,230
إنّ المحارب العظيم كالغارا
!هو حامينا الوحيد والأوحد

135
00:10:01,830 --> 00:10:03,330
!أجل

136
00:10:04,040 --> 00:10:05,140
!براهام

137
00:10:05,140 --> 00:10:05,770
!نعم

138
00:10:05,770 --> 00:10:06,800
!كاماكيري

139
00:10:07,740 --> 00:10:08,670
!غينبو

140
00:10:08,670 --> 00:10:11,210
!نعم

141
00:10:09,840 --> 00:10:10,710
!راكي

142
00:10:11,840 --> 00:10:14,650
!كونوا حذرين! سننفصل هنا

143
00:10:19,320 --> 00:10:24,020
نعهد للمحارب العظيم كالغارا
!بأن نشعل نار شاندورا

144
00:10:24,020 --> 00:10:25,590
!أجل

145
00:10:29,830 --> 00:10:32,600
!ها قد أتيتم إذًا يا شهب شانديا

146
00:10:41,570 --> 00:10:43,940
!أيعقل... أنّ هذه الجزيرة...؟

147
00:11:08,900 --> 00:11:10,770
!ما كان ذلك؟

148
00:11:10,770 --> 00:11:12,540
.كان انفجارًا ما

149
00:11:12,540 --> 00:11:16,070
،سمعتُ بعضها قبل قليل
.لكنّ هذا يبدو مختلفًا

150
00:11:18,040 --> 00:11:20,110
!الأهمّ الآن هو أنّ علينا المواصلة

151
00:11:20,110 --> 00:11:21,480
!حسنًا

152
00:11:21,880 --> 00:11:23,580
!لِمَ العجلة يا نامي؟

153
00:11:23,910 --> 00:11:25,540
.أنت تتصرّفين بغرابة

154
00:11:26,200 --> 00:11:27,220
ما الّذي رأيتِه؟

155
00:11:27,220 --> 00:11:28,990
!هل رأيتِ الإله أو ما شابه؟

156
00:11:29,590 --> 00:11:30,920
!لا، ليس كذلك

157
00:11:31,520 --> 00:11:34,360
،حتّى إن شرحتُ الأمر
...فعلى الأرجح أنّكما ستعجزان عن

158
00:11:38,460 --> 00:11:41,770
!سُحقًا! لا أنفكّ عن الانزلاق
!لماذا المشي صعب جدًّا هنا؟

159
00:11:41,770 --> 00:11:45,470
أنت من قال أنّ هذه
.الطّريقة ستكون أسرع

160
00:11:45,700 --> 00:11:49,670
!قولي لنا فحسب! ما الّذي رأيتِه؟

161
00:11:49,670 --> 00:11:51,810
!لا أسئلة. اتبعاني فحسب

162
00:11:51,810 --> 00:11:53,480
.علينا الوصول إلى الشّاطئ بطريقة ما

163
00:11:54,750 --> 00:11:56,950
!أنتما! ساعداني

164
00:11:56,950 --> 00:11:59,920
ألا يجدر بك أن تكوني في المقدّمة
!إن كنتِ تريدين أن نتبعك؟

165
00:12:00,180 --> 00:12:01,150
الشّاطئ؟

166
00:12:01,150 --> 00:12:02,220
.هذا صحيح

167
00:12:02,220 --> 00:12:04,990
على أيّ حال، علينا الاقتراب
...أكثر لأتحقّق من الأمر

168
00:12:07,890 --> 00:12:11,760
.لأنّني ما زلت لا أصدّق ما رأته عينيّ

169
00:12:12,430 --> 00:12:13,660
...وأنا أيضًا

170
00:12:14,070 --> 00:12:16,330
...أنا أيضًا لديّ شيء يزعجني

171
00:12:18,970 --> 00:12:21,340
.رغم أنّ لا دليل لديّ

172
00:12:22,710 --> 00:12:27,650
...إن اتّضح أنّ هذه النّظريّة صحيحة

173
00:12:28,710 --> 00:12:30,000
.فستكون مثيرة للاهتمام

174
00:12:30,490 --> 00:12:31,620
.مثيرة جدًّا للاهتمام

175
00:12:33,120 --> 00:12:38,090
.ربّما ما زال من الممكن تحقيق هدفي في الحياة

176
00:12:41,390 --> 00:12:43,690
.لكنّها مجرّد نظريّة

177
00:12:56,410 --> 00:12:57,440
ماذا؟

178
00:12:58,180 --> 00:13:00,880
أنا حيّ؟

179
00:13:02,750 --> 00:13:04,320
!هذا مؤلم

180
00:13:08,450 --> 00:13:09,990
!يا فارس السّماء

181
00:13:10,350 --> 00:13:12,560
!طبيب! طبيب! إنّه أنا

182
00:13:15,530 --> 00:13:17,700
.جيّد... ما زال حيًّا

183
00:13:24,300 --> 00:13:26,270
.لكنّ هذا غريب

184
00:13:26,840 --> 00:13:29,370
.ظننتُ أنّنا غرقنا في النّهر

185
00:13:29,870 --> 00:13:31,880
.أتساءل كيف خرجنا منه

186
00:13:34,950 --> 00:13:36,410
...من قال ذلك؟ قال أنّ الإله

187
00:13:37,080 --> 00:13:38,920
!من تحدّث للتّوّ؟

188
00:13:57,270 --> 00:13:58,570
كيف...؟

189
00:13:58,570 --> 00:13:59,800
.نحن قريبون من البحر

190
00:14:00,740 --> 00:14:03,770
...أستطيع سماع الأمواج. أصغيا

191
00:14:08,050 --> 00:14:10,880
!معك حقّ! نكاد نصل

192
00:14:13,350 --> 00:14:16,550
!هيّا بنا! أسرعا

193
00:14:14,420 --> 00:14:16,550
ما الّذي يوجد هناك؟

194
00:14:18,190 --> 00:14:19,690
!هل جننتِ؟

195
00:14:20,460 --> 00:14:23,690
.أسمع أصواتًا تختلط مع صوت الأمواج أيضًا

196
00:14:23,690 --> 00:14:26,660
.نعم، وكأنّها أصوات معركة

197
00:14:33,340 --> 00:14:36,170
...صوت العديد من النّاس يندفعون

198
00:14:37,010 --> 00:14:39,580
.سمعتُ الكثير مثله في ألاباستا

199
00:14:39,910 --> 00:14:41,180
.أتساءل إن كانت الأوضاع بخير

200
00:14:41,180 --> 00:14:43,450
،إن كنتِ تقصدين تشوبّر
.فلا تقلقي بشأنه

201
00:14:43,450 --> 00:14:46,120
بإمكانه الاهتمام بنفسه
.عندما يتطلّب الأمر ذلك

202
00:14:46,120 --> 00:14:48,490
.لا، قصدتُ قائدنا والبقيّة

203
00:14:48,490 --> 00:14:49,550
لوفي؟

204
00:14:49,550 --> 00:14:52,590
أشكّ في أنّه سيجلس مكتوف
.اليدين بعد أن اختُطفنا

205
00:14:52,590 --> 00:14:55,160
صحيح، هو من أراد المجيء
.إلى هذه الجزيرة من البداية

206
00:14:55,160 --> 00:14:58,460
،لا أعرف ما غاية هذا الإله

207
00:14:58,460 --> 00:15:00,930
لكن على الأرجح أنّه ما كان
.ليسمح لهم بالمرور

208
00:15:00,930 --> 00:15:05,040
.ويجري الآن قتال مختلف تمامًا

209
00:15:05,040 --> 00:15:07,340
.أصبح الوضع أكثر تعقيدًا بعض الشّيء

210
00:15:07,340 --> 00:15:08,610
.نعم، معك حقّ

211
00:15:08,970 --> 00:15:12,810
لكنّهم بخير على الأرجح، فقد
.اعتادوا المرور بشتّى المشاكل

212
00:15:12,810 --> 00:15:15,510
إنّ القلق حيال أمور صغيرة
.كهذه لن يفيدنا بأيّ شيء

213
00:15:16,580 --> 00:15:17,580
.معك حقّ

214
00:15:18,450 --> 00:15:19,950
...كم هذا مؤلم

215
00:15:31,960 --> 00:15:34,070
!يا نامي! اسمعي

216
00:15:36,500 --> 00:15:38,900
.هكذا يجب أن تفعلها يا أوسوبّ

217
00:15:39,100 --> 00:15:39,800
.حسنًا

218
00:15:39,800 --> 00:15:42,570
!أنت! حان الوقت للاستيقاظ

219
00:15:43,040 --> 00:15:45,210
ماذا؟ أحلّ الصّباح؟

220
00:15:48,550 --> 00:15:50,720
!مثل زورو تمامًا

221
00:15:50,720 --> 00:15:52,480
!ابنتها أيّها الغبيّان

222
00:15:53,180 --> 00:15:56,650
لا ندري حتّى ما الّذي يحدث
.مع نامي-سان وروبين-تشان

223
00:15:56,650 --> 00:15:58,260
وماذا عن زورو وتشوبّر...؟

224
00:15:58,260 --> 00:16:00,630
.ما زال هنالك ثلاثة كهنة آخرين

225
00:16:00,630 --> 00:16:02,960
.قد تكون هنالك محن أخرى في انتظارنا

226
00:16:02,960 --> 00:16:05,500
.هذه... محنة الحبّ

227
00:16:09,170 --> 00:16:11,740
على أيّ حال، لا خيار أمامنا
.إلاّ الذّهاب للمذبح بسرعة

228
00:16:11,740 --> 00:16:13,070
!ما قولكما؟

229
00:16:13,070 --> 00:16:16,270
!نعم، نحن آسفان

230
00:16:20,310 --> 00:16:22,050
.أتساءل ما الّذي جعلها تنطلق فجأة

231
00:16:22,550 --> 00:16:26,450
يا إلهي، أصبحت نشيطة جدًّا
.بمجرّد رؤيتها للبحر

232
00:16:28,790 --> 00:16:31,460
!إذًا رأيتُه بالفعل

233
00:16:32,890 --> 00:16:33,720
!...هذا

234
00:16:33,720 --> 00:16:37,930
.يا نامي! هذا يكفي
...حان الوقت لتخبرينا

235
00:16:40,360 --> 00:16:45,100
لا داعي للشّرح، صحيح؟
.انظرا لهذا

236
00:16:46,170 --> 00:16:47,810
تعرّفتما عليه، صحيح؟

237
00:16:48,940 --> 00:16:50,910
...لن يكون أمر التّعرّف عليه صعبًا

238
00:16:52,940 --> 00:16:55,280
.فقد رأيناه آخر مرّة هذا الصّباح فحسب

239
00:16:58,920 --> 00:17:00,350
!ما الّذي يحدث؟

240
00:17:00,620 --> 00:17:04,490
لماذا يوجد شيء ما من الأرض هنا؟
إنّه نفسه، صحيح؟

241
00:17:04,490 --> 00:17:05,720
.لا، ليس هو

242
00:17:05,720 --> 00:17:06,520
!ماذا؟

243
00:17:06,920 --> 00:17:09,490
هذا هو النّصف الآخر للبناء
.الّذي رأيناه على الأرض

244
00:17:09,490 --> 00:17:10,600
!النّصف الآخر؟

245
00:17:11,030 --> 00:17:12,700
.كان هذا يزعجني طوال الوقت

246
00:17:13,030 --> 00:17:16,470
هذه الأرض التّرابيّة لا يجب
.أن توجد في البحر الأبيض-الأبيض

247
00:17:17,030 --> 00:17:21,840
حقيقة أنّ هذه الجزيرة ليست مصنوعة
.من السّحب كانت لغزًا لي من البداية

248
00:17:22,270 --> 00:17:25,780
بعبارة أخرى، هذه الجزيرة الّتي
...تُدعى السّاحة العليا

249
00:17:27,180 --> 00:17:29,450
.كانت على الأرض في الأصل

250
00:17:30,450 --> 00:17:32,650
،ظننتُ أنّ ذلك المنزل كان غريبًا

251
00:17:33,320 --> 00:17:39,120
،فقد كان له طابق ثانٍ
.لكن لم يكن لديه دَرج

252
00:17:39,660 --> 00:17:42,930
وما كان هنالك أيّ سبب يدعو
.لبناء منزل على الحافّة مثله

253
00:17:43,490 --> 00:17:46,860
!"كان الشّاطئ عبارة عن "انقسام في الجزيرة

254
00:17:48,430 --> 00:17:50,670
!هـ-هذا مذهل

255
00:17:50,670 --> 00:17:52,540
.غبيّان! أمعنا النّظر

256
00:17:52,540 --> 00:17:57,280
.حالم؟ يبدو لي ساعيًا لجلب الانتباه

257
00:17:57,280 --> 00:17:57,980
لماذا؟

258
00:17:57,980 --> 00:18:01,280
!ماذا...؟! إنّه مجّرد لوح

259
00:18:06,550 --> 00:18:10,290
هذا هو النّصف الآخر للجزيرة
.الّذي انقسم منها

260
00:18:12,890 --> 00:18:15,560
!هذه الجزيرة جزء من جايا

261
00:18:17,960 --> 00:18:21,970
أي أنّ الجزيرة انقسمت
،لنصفين قبل زمن طويل

262
00:18:21,970 --> 00:18:24,440
.واندفع أحد النّصفين إلى السّماء

263
00:18:27,170 --> 00:18:30,240
لكن كيف لأمر كهذا أن يحدث...؟

264
00:18:31,840 --> 00:18:36,750
...ثمّة الكثير من طيور الجنوب
...لكن لماذا هي

265
00:18:37,450 --> 00:18:39,920
!لماذا هي بهذه الضّخامة؟

266
00:18:41,450 --> 00:18:43,790
،لا بدّ أنّ هذا من صنيع ذلك التّيّار الوحشيّ

267
00:18:44,460 --> 00:18:46,890
.رغم أنّ الأمر يبدو سخيفًا

268
00:18:53,500 --> 00:18:57,130
!أنت من أنقذنا من الغرق؟

269
00:18:58,900 --> 00:19:02,010
!ماذا؟! هو الإله؟

270
00:19:16,450 --> 00:19:19,360
.اسمي مونبلان كريكت

271
00:19:23,230 --> 00:19:24,860
.آسف لتسبّبي بالمشاكل لكم

272
00:19:25,300 --> 00:19:29,330
ظننتُ أنّكم مجرّد أغبياء
.يسعون خلف الذّهب

273
00:19:29,330 --> 00:19:31,040
!هل جزيرة السّماء غير موجودة؟

274
00:19:31,500 --> 00:19:34,910
.أعرف شخصًا قال أنّها موجودة

275
00:19:35,540 --> 00:19:38,110
!لكنّه يوصف بالكاذب الكبير الأسطوريّ

276
00:19:38,440 --> 00:19:39,940
!ليس أنا

277
00:19:40,340 --> 00:19:42,480
...نولاند الكذّاب

278
00:19:42,810 --> 00:19:47,420
رأيت جبلاً من الذّهب على"
.جزيرة في البحر العظيم

279
00:19:47,420 --> 00:19:51,420
أبحر الملك الشّجاع إلى البحر العظيم
،ليرى إن كانت القصّة حقيقيّة

280
00:19:51,420 --> 00:19:56,690
".ولكن، ما وجدوه كان مجرّد غابة

281
00:19:57,030 --> 00:19:59,230
رُسم وجه تعلوه ملامح
...الغباء في الكتاب

282
00:19:59,230 --> 00:20:03,270
لكنّه ذرف دموعًا كثيرة
.ومات ميتة يملؤها النّدم

283
00:20:03,940 --> 00:20:06,900
أصرّ نولاند أنّ الأطلال غرقت
،بسبب تحرّكات القشرة الأرضيّة

284
00:20:06,900 --> 00:20:10,340
لكنّ الجميع ظنّ أنّه يختلق أعذارًا
.بسبب وضعه اليائس

285
00:20:11,410 --> 00:20:16,350
.هذا نزال مع الرّجل الّذي دمّر حياتي

286
00:20:17,450 --> 00:20:21,350
لهذا السّبب واصلتَ الغوص
.إلى أن أصبتَ بالمرض

287
00:20:21,590 --> 00:20:24,820
.لستُ أريد إثبات براءته

288
00:20:24,820 --> 00:20:28,930
.أريد أن أسوّي الأمر معه قبل أن أموت

289
00:20:29,760 --> 00:20:31,460
...رجل ولا كلّ الرّجال

290
00:20:31,960 --> 00:20:35,630
!لنسوّ هذا الأمر يا نولاند

291
00:21:22,880 --> 00:21:24,280
♪ ...خذ بيدي ♪

292
00:21:24,280 --> 00:21:25,320
!لا تغنّيا

293
00:21:31,620 --> 00:21:36,960
مدينة الذّهب" الّتي وُجدت ذات
مرّة على الأرض ورآها نولاند

294
00:21:36,960 --> 00:21:39,230
.لم تغرق في المحيط

295
00:21:41,300 --> 00:21:43,070
...كان هذا الجزء من جايا

296
00:21:43,940 --> 00:21:45,840
!يحلّق في السّماء طوال هذا الوقت

297
00:22:01,850 --> 00:22:08,550
حتّى إن فرّقت بيننا المسافات

298
00:22:08,550 --> 00:22:15,030
فلا أريدك أن تنسى

299
00:22:15,030 --> 00:22:24,600
أنّه في الأيّام الّتي قد تذرف فيها
الدّموع سيكون لك

300
00:22:24,600 --> 00:22:29,210
صديق إلى جانبك لمشاركتك الألم

301
00:22:31,910 --> 00:22:38,780
لا يمكننا الاستسلام عن ذلك الحلم

302
00:22:38,780 --> 00:22:45,360
لن أسمح بأن يكون مجرّد حلم

303
00:22:45,360 --> 00:22:52,030
التّألّق الأبديّ الّذي يسعى إليه الجميع

304
00:22:52,030 --> 00:22:59,870
كلّي ثقة أنّنا سنمسك به بين أيدينا

305
00:23:12,280 --> 00:23:14,150
!لنتّجه نحو المذبح القربانيّ

306
00:23:14,150 --> 00:23:15,520
!أجل! انتظرونا يا رفاق

307
00:23:15,520 --> 00:23:17,850
!أنتما! لسنا في نزهة هنا

308
00:23:17,850 --> 00:23:20,590
.لا تكن سريع الغضب
!لنستمتع بالرّحلة

309
00:23:20,590 --> 00:23:23,060
إنّه محقّ! انظرا، هنالك أشخاص
.مرحون قادمون من هنا

310
00:23:23,060 --> 00:23:25,400
!أيّها الغبيّ! إنّهم فدائيّون يشنّون هجومًا

311
00:23:25,400 --> 00:23:26,660
!مذهل

312
00:23:26,660 --> 00:23:27,800
:في الحلقة القادمة من ون بيس

313
00:23:27,800 --> 00:23:31,200
!جايا، مدينة الذّهب في السّماء"
"!لنتّجه إلى ضريح الإله

314
00:23:31,200 --> 00:23:33,640
!ملك القراصنة، لن يكون إلاّ أنا