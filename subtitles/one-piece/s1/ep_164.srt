1
00:00:22,210 --> 00:00:25,240
!العالم... نعم

2
00:00:25,780 --> 00:00:27,440
...اسعوا نحو الحرّيّة

3
00:00:27,440 --> 00:00:31,620
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,950 --> 00:00:35,350
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,850 --> 00:00:37,220
!فتجاوزوها

6
00:00:37,620 --> 00:00:40,590
!تحت راية ما تؤمنون به

7
00:00:45,060 --> 00:00:50,670
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,670 --> 00:00:53,900
متّجهًا نحو عالم بلا نهاية

9
00:00:55,310 --> 00:01:00,180
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,180 --> 00:01:08,590
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,590 --> 00:01:14,320
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,320 --> 00:01:18,760
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,760 --> 00:01:24,400
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,400 --> 00:01:28,270
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,270 --> 00:01:33,210
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,210 --> 00:01:40,950
متّجهين نحو الأفق

17
00:01:40,950 --> 00:01:46,460
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,460 --> 00:01:51,160
متّجهًا نحو عالم بلا نهاية

19
00:01:51,160 --> 00:01:56,400
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,400 --> 00:02:02,670
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:15,020 --> 00:02:18,060
،بعد دخول غابة الوهم في السّاحة العليا

22
00:02:18,620 --> 00:02:22,690
"واجه لوفي والبقيّة "محنة الكرات
!العنيفة من الكاهن ساتوري

23
00:02:26,030 --> 00:02:30,300
في تلك الأثناء، هُزم غان فول
.على يد الكاهن شورا

24
00:02:30,300 --> 00:02:32,370
!يا فارس السّماء

25
00:02:35,940 --> 00:02:40,280
!يا نامي! أترين أيّ شيء؟

26
00:02:40,510 --> 00:02:44,620
مهاجمتي تعني إعلان
!الحرب ضدّ الإله إنيل العظيم

27
00:02:44,980 --> 00:02:47,320
.أغلق فمك! وإلاّ تسرّبت النّكهة

28
00:02:48,090 --> 00:02:50,420
!هذه... محنة الحبّ

29
00:02:50,620 --> 00:02:54,320
!أهذا الشّخص أحمق أيضًا؟

30
00:02:55,530 --> 00:02:57,260
!سحق

31
00:03:01,930 --> 00:03:05,440
!أشعلوا نار شاندورا"
".المحارب وايبر

32
00:03:07,440 --> 00:03:11,510
.دخل الإله السّابق غان فول للسّاحة العليا

33
00:03:12,440 --> 00:03:15,110
.أشكّ أنّ إنيل قد يدعه وشأنه

34
00:03:15,650 --> 00:03:18,320
هل يحاول غان فول مواجهة إنيل؟

35
00:03:18,320 --> 00:03:23,320
مستحيل... يصعب التّفكير
.أنّ ذلك العجوز بذلك العزم

36
00:03:38,440 --> 00:03:40,340
ما الخطب يا أيسا؟

37
00:03:40,970 --> 00:03:42,940
.اختفى صوتان

38
00:03:42,940 --> 00:03:43,810
!ماذا قلتِ؟

39
00:03:45,180 --> 00:03:46,280
أهذه المانترا خاصّتك؟

40
00:03:46,280 --> 00:03:49,750
...نعم... قبل قليل

41
00:03:52,680 --> 00:03:56,350
أهذا ما تقوله لك المانترا خاصّتك يا أيسا؟

42
00:03:56,350 --> 00:03:59,720
!ما عدتِ تسمعين صوتين... صحيح؟

43
00:04:02,660 --> 00:04:03,790
.لا مجال للشّكّ

44
00:04:04,160 --> 00:04:08,030
تعلمون جميعًا أنّ باستطاعتها
،استعمال المانترا منذ ولادتها

45
00:04:08,030 --> 00:04:13,340
وهي قوّة غامضة تمكّنها من
.استشعار النّاس حتّى عن بعد

46
00:04:14,500 --> 00:04:16,770
ما عدت تسمعين صوت شخصين، صحيح؟

47
00:04:16,770 --> 00:04:19,180
...نعم... اختفيا في نفس الوقت

48
00:04:19,780 --> 00:04:23,610
...أعتقد أنّهما لغان فول وأحد الكهنة

49
00:04:23,610 --> 00:04:24,380
أقتلا بعضهما؟

50
00:04:24,380 --> 00:04:26,280
.أحسنت أيّها العجوز

51
00:04:26,280 --> 00:04:27,950
.بقي الآن ثلاثة كهنة

52
00:04:27,950 --> 00:04:29,520
.هذا يصبّ في مصلحتنا

53
00:04:30,650 --> 00:04:34,460
.يبدو أنّ السّماء لبّت صلواتنا

54
00:04:35,760 --> 00:04:39,300
.هذه فرصتنا لسحق الكهنة

55
00:04:39,600 --> 00:04:40,900
!نعم

56
00:04:41,330 --> 00:04:44,800
سنشنّ هجومًا شاملاً على السّاحة
!العليا في الحال

57
00:04:45,270 --> 00:04:46,400
!أجل

58
00:04:50,070 --> 00:04:54,310
لم تشعري بالرّاحة أبدًا حول وايبر، صحيح؟

59
00:04:54,510 --> 00:04:55,810
.والآن، ابتعدي عن الطّريق

60
00:04:55,810 --> 00:04:56,350
!هذا مؤلم

61
00:04:58,220 --> 00:04:59,950
!انتظري يا راكي

62
00:05:00,580 --> 00:05:01,550
ماذا هنالك؟

63
00:05:01,750 --> 00:05:04,520
.لم يُهزم الكاهن على يد غان فول

64
00:05:04,520 --> 00:05:07,720
،ثمّة أشخاص آخرون هناك
.وكان ذلك من صنيعهم

65
00:05:08,130 --> 00:05:09,060
أشخاص آخرون؟

66
00:05:09,390 --> 00:05:12,060
تقصدين سكّان البحر الأزرق
الّذين دخلوا سكايبيا؟

67
00:05:12,060 --> 00:05:15,030
!لا أدري، لكنّهم مخيفون بكلّ تأكيد

68
00:05:15,630 --> 00:05:16,600
...لذلك

69
00:05:18,670 --> 00:05:19,970
.كوني حذرة

70
00:05:22,840 --> 00:05:27,410
.مفهوم... أعطني حقيبتك يا أيسا

71
00:05:27,410 --> 00:05:31,920
ماذا؟! كلاّ! هذه حقيبتي السّرّيّة
!وكنزي موجود فيها

72
00:05:32,250 --> 00:05:33,520
.أعلم ذلك

73
00:05:36,490 --> 00:05:39,390
.سأحضر بعضه من أجلك أيضًا

74
00:05:39,390 --> 00:05:40,120
!فعلاً؟

75
00:05:40,120 --> 00:05:40,690
.نعم

76
00:05:46,900 --> 00:05:49,270
.توقّف عن ثرثرته أخيرًا

77
00:05:49,570 --> 00:05:52,900
يا له من وغد لسخريته منّا
...ببعض الحيل الغبيّة

78
00:05:52,900 --> 00:05:57,640
ما بالهم؟ كيف عرف هجماتنا وما شابه؟

79
00:05:57,910 --> 00:05:59,610
!اسمعا

80
00:05:59,610 --> 00:06:02,410
!لوفي! سانجي! وجدتُ القارب

81
00:06:02,410 --> 00:06:05,550
!أسرعا! وإلاّ غادر الغابة

82
00:06:07,180 --> 00:06:08,690
.كان أوسوبّ بخير

83
00:06:08,690 --> 00:06:10,990
!مهلاً، قال أنّ القارب يغادر الغابة

84
00:06:11,620 --> 00:06:15,860
!مصيبة! يكاد يصل إلى مخرج الغابة

85
00:06:17,560 --> 00:06:20,230
!اسمعا! تشبّثا بجسدي

86
00:06:20,230 --> 00:06:20,730
!بجسدك؟

87
00:06:21,200 --> 00:06:22,330
!هيّا بنا

88
00:06:22,330 --> 00:06:28,310
!أوسوبّ آا-اا-اه

89
00:06:33,240 --> 00:06:35,410
!حسنًا! أمسكت به

90
00:06:35,410 --> 00:06:37,710
!مرحى! أنت مدهش يا أوسوبّ

91
00:06:37,710 --> 00:06:40,980
!ذلك مؤلم! هل تحاولان قتلي؟

92
00:06:40,980 --> 00:06:41,720
.تحمّستُ قليلاً فحسب

93
00:06:41,720 --> 00:06:44,250
!لقد اعوجّ ظهري

94
00:06:44,250 --> 00:06:45,790
مهلاً! يمكنك إصلاحه بتلك السّهولة؟

95
00:06:45,790 --> 00:06:46,990
.لا شيء مستحيل عندي

96
00:06:46,990 --> 00:06:48,990
!بإمكانك أن تكون رائعًا أحيانًا

97
00:06:49,030 --> 00:06:51,360
!أجل! استخففتما بي، صحيح؟

98
00:06:55,330 --> 00:06:56,900
!مـ-مـ-مهلاً لحظة
!ماذا تفعل؟! اتركني

99
00:06:56,900 --> 00:06:59,640
!مهلاً يا سانجي-كُن
!إن كنّا سنموت، فسنموت معًا

100
00:06:59,640 --> 00:07:00,840
!و-وأنا أيضًا؟

101
00:07:12,380 --> 00:07:14,380
...هذا سهل

102
00:07:14,380 --> 00:07:16,590
!سأحاسبك لاحقًا على هذا

103
00:07:16,590 --> 00:07:21,260
.لكن الأمر أفضل لو مدّدتُ نفسي

104
00:07:22,730 --> 00:07:26,930
.على كلّ حال، إنّنا نخرج من غابة الوهم الآن

105
00:07:39,980 --> 00:07:43,580
.لا... لا يمكنني السّباحة

106
00:07:46,980 --> 00:07:48,650
!فارس السّماء

107
00:07:50,290 --> 00:07:51,560
.ذلك الطّائر الغريب أيضًا

108
00:07:52,320 --> 00:07:56,960
صحيح، إنّه من مستعملي
.فاكهة الشّيطان مثلي

109
00:07:57,890 --> 00:08:03,030
.سُحقًا! لم أستطع... إنقاذهما

110
00:08:12,540 --> 00:08:16,810
.كلاّ... أشعر... بالضّعف

111
00:08:18,180 --> 00:08:20,180
.سقط ساتوري

112
00:08:21,320 --> 00:08:24,250
!يا له من مبتدئ، شتّت المانترا خاصّته

113
00:08:25,120 --> 00:08:28,530
إن لم أكن مخطئًا، فإنّ الوافدين
.غير القانونيّين أتوا من البحر الأزرق

114
00:08:28,530 --> 00:08:30,860
.يبدو أنّهم ليسوا أشخاصًا عاديّين

115
00:08:30,860 --> 00:08:33,500
.إنّ القرابين تتجوّل في الأرجاء بحرّيّة أيضًا

116
00:08:33,500 --> 00:08:35,770
،ولكن، حتّى إن تركناهم وشأنهم الآن

117
00:08:35,770 --> 00:08:38,300
على الأرجح أنّهم لن يجدوا طريقة
.لمغادرة هذه الجزيرة

118
00:08:40,040 --> 00:08:41,270
...والأهمّ من ذلك، علينا أن

119
00:08:52,550 --> 00:08:55,550
هل تشعر بصوت محارب حزين يا هولي؟

120
00:08:56,720 --> 00:08:59,290
،لا يهمّ كم مرّة سنتقاتل
.فالنّتيجة لا تتغيّر

121
00:08:59,960 --> 00:09:03,860
،هزم شورا غان فول
.لكنّ "محنة الكرات" قد حُطّمت

122
00:09:04,630 --> 00:09:07,230
!يا له من يوم مضطرب

123
00:09:08,200 --> 00:09:12,440
لن أسمح لهم بالمرور. حتّى
.محاولتهم لرؤية الإله ستكون وقاحة

124
00:09:13,440 --> 00:09:15,540
،رغم أنّ الشّمس ستغرب قريبًا

125
00:09:15,540 --> 00:09:17,140
...يبدو أنّ السّاحة العليا ستصبح الآن

126
00:09:19,610 --> 00:09:21,680
.متزعزعة نوعًا ما

127
00:09:24,080 --> 00:09:26,720
.لا أهتمّ بالهاربين بعد الآن

128
00:09:26,720 --> 00:09:31,150
يبدو أنّه ظهر بعض الخصوم
.الّذين عليهم مواجهة غضبي

129
00:09:55,580 --> 00:09:57,250
!اسمعوا يا رفاق

130
00:09:57,680 --> 00:10:00,420
!السّاحة العليا متزعزعة الآن

131
00:10:00,920 --> 00:10:03,350
!هذه فرصة العمر

132
00:10:03,720 --> 00:10:06,720
!اتّجهوا صوب "ضريح الإله" مهما حدث

133
00:10:07,490 --> 00:10:09,560
!لا تخشوا إنيل

134
00:10:10,330 --> 00:10:15,230
إنّ المحارب العظيم كالغارا
!هو حامينا الوحيد والأوحد

135
00:10:15,830 --> 00:10:17,330
!أجل

136
00:10:18,040 --> 00:10:19,140
!براهام

137
00:10:19,140 --> 00:10:19,770
!نعم

138
00:10:19,770 --> 00:10:20,800
!كاماكيري

139
00:10:21,740 --> 00:10:22,670
!غينبو

140
00:10:22,670 --> 00:10:25,210
!نعم

141
00:10:23,840 --> 00:10:24,710
!راكي

142
00:10:25,840 --> 00:10:28,650
!كونوا حذرين! سننفصل هنا

143
00:10:33,320 --> 00:10:38,020
نعهد للمحارب العظيم كالغارا
!بأن نشعل نار شاندورا

144
00:10:38,020 --> 00:10:39,590
!أجل

145
00:10:43,830 --> 00:10:46,600
!ها قد أتيتم إذًا يا شهب شانديا

146
00:10:55,570 --> 00:10:57,940
!أيعقل... أنّ هذه الجزيرة...؟

147
00:11:22,900 --> 00:11:24,770
!ما كان ذلك؟

148
00:11:24,770 --> 00:11:26,540
.كان انفجارًا ما

149
00:11:26,540 --> 00:11:30,070
،سمعتُ بعضها قبل قليل
.لكنّ هذا يبدو مختلفًا

150
00:11:32,040 --> 00:11:34,110
!الأهمّ الآن هو أنّ علينا المواصلة

151
00:11:34,110 --> 00:11:35,480
!حسنًا

152
00:11:35,880 --> 00:11:37,580
!لِمَ العجلة يا نامي؟

153
00:11:37,910 --> 00:11:39,540
.أنت تتصرّفين بغرابة

154
00:11:40,200 --> 00:11:41,220
ما الّذي رأيتِه؟

155
00:11:41,220 --> 00:11:42,990
!هل رأيتِ الإله أو ما شابه؟

156
00:11:43,590 --> 00:11:44,920
!لا، ليس كذلك

157
00:11:45,520 --> 00:11:48,360
،حتّى إن شرحتُ الأمر
...فعلى الأرجح أنّكما ستعجزان عن

158
00:11:52,460 --> 00:11:55,770
!سُحقًا! لا أنفكّ عن الانزلاق
!لماذا المشي صعب جدًّا هنا؟

159
00:11:55,770 --> 00:11:59,470
أنت من قال أنّ هذه
.الطّريقة ستكون أسرع

160
00:11:59,700 --> 00:12:03,670
!قولي لنا فحسب! ما الّذي رأيتِه؟

161
00:12:03,670 --> 00:12:05,810
!لا أسئلة. اتبعاني فحسب

162
00:12:05,810 --> 00:12:07,480
.علينا الوصول إلى الشّاطئ بطريقة ما

163
00:12:08,750 --> 00:12:10,950
!أنتما! ساعداني

164
00:12:10,950 --> 00:12:13,920
ألا يجدر بك أن تكوني في المقدّمة
!إن كنتِ تريدين أن نتبعك؟

165
00:12:14,180 --> 00:12:15,150
الشّاطئ؟

166
00:12:15,150 --> 00:12:16,220
.هذا صحيح

167
00:12:16,220 --> 00:12:18,990
على أيّ حال، علينا الاقتراب
...أكثر لأتحقّق من الأمر

168
00:12:21,890 --> 00:12:25,760
.لأنّني ما زلت لا أصدّق ما رأته عينيّ

169
00:12:26,430 --> 00:12:27,660
...وأنا أيضًا

170
00:12:28,070 --> 00:12:30,330
...أنا أيضًا لديّ شيء يزعجني

171
00:12:32,970 --> 00:12:35,340
.رغم أنّ لا دليل لديّ

172
00:12:36,710 --> 00:12:41,650
...إن اتّضح أنّ هذه النّظريّة صحيحة

173
00:12:42,710 --> 00:12:44,000
.فستكون مثيرة للاهتمام

174
00:12:44,490 --> 00:12:45,620
.مثيرة جدًّا للاهتمام

175
00:12:47,120 --> 00:12:52,090
.ربّما ما زال من الممكن تحقيق هدفي في الحياة

176
00:12:55,390 --> 00:12:57,690
.لكنّها مجرّد نظريّة

177
00:13:10,410 --> 00:13:11,440
ماذا؟

178
00:13:12,180 --> 00:13:14,880
أنا حيّ؟

179
00:13:16,750 --> 00:13:18,320
!هذا مؤلم

180
00:13:22,450 --> 00:13:23,990
!يا فارس السّماء

181
00:13:24,350 --> 00:13:26,560
!طبيب! طبيب! إنّه أنا

182
00:13:29,530 --> 00:13:31,700
.جيّد... ما زال حيًّا

183
00:13:38,300 --> 00:13:40,270
.لكنّ هذا غريب

184
00:13:40,840 --> 00:13:43,370
.ظننتُ أنّنا غرقنا في النّهر

185
00:13:43,870 --> 00:13:45,880
.أتساءل كيف خرجنا منه

186
00:13:48,950 --> 00:13:50,410
...من قال ذلك؟ قال أنّ الإله

187
00:13:51,080 --> 00:13:52,920
!من تحدّث للتّوّ؟

188
00:14:11,270 --> 00:14:12,570
كيف...؟

189
00:14:12,570 --> 00:14:13,800
.نحن قريبون من البحر

190
00:14:14,740 --> 00:14:17,770
...أستطيع سماع الأمواج. أصغيا

191
00:14:22,050 --> 00:14:24,880
!معك حقّ! نكاد نصل

192
00:14:27,350 --> 00:14:30,550
!هيّا بنا! أسرعا

193
00:14:28,420 --> 00:14:30,550
ما الّذي يوجد هناك؟

194
00:14:32,190 --> 00:14:33,690
!هل جننتِ؟

195
00:14:34,460 --> 00:14:37,690
.أسمع أصواتًا تختلط مع صوت الأمواج أيضًا

196
00:14:37,690 --> 00:14:40,660
.نعم، وكأنّها أصوات معركة

197
00:14:47,340 --> 00:14:50,170
...صوت العديد من النّاس يندفعون

198
00:14:51,010 --> 00:14:53,580
.سمعتُ الكثير مثله في ألاباستا

199
00:14:53,910 --> 00:14:55,180
.أتساءل إن كانت الأوضاع بخير

200
00:14:55,180 --> 00:14:57,450
،إن كنتِ تقصدين تشوبّر
.فلا تقلقي بشأنه

201
00:14:57,450 --> 00:15:00,120
بإمكانه الاهتمام بنفسه
.عندما يتطلّب الأمر ذلك

202
00:15:00,120 --> 00:15:02,490
.لا، قصدتُ قائدنا والبقيّة

203
00:15:02,490 --> 00:15:03,550
لوفي؟

204
00:15:03,550 --> 00:15:06,590
أشكّ في أنّه سيجلس مكتوف
.اليدين بعد أن اختُطفنا

205
00:15:06,590 --> 00:15:09,160
صحيح، هو من أراد المجيء
.إلى هذه الجزيرة من البداية

206
00:15:09,160 --> 00:15:12,460
،لا أعرف ما غاية هذا الإله

207
00:15:12,460 --> 00:15:14,930
لكن على الأرجح أنّه ما كان
.ليسمح لهم بالمرور

208
00:15:14,930 --> 00:15:19,040
.ويجري الآن قتال مختلف تمامًا

209
00:15:19,040 --> 00:15:21,340
.أصبح الوضع أكثر تعقيدًا بعض الشّيء

210
00:15:21,340 --> 00:15:22,610
.نعم، معك حقّ

211
00:15:22,970 --> 00:15:26,810
لكنّهم بخير على الأرجح، فقد
.اعتادوا المرور بشتّى المشاكل

212
00:15:26,810 --> 00:15:29,510
إنّ القلق حيال أمور صغيرة
.كهذه لن يفيدنا بأيّ شيء

213
00:15:30,580 --> 00:15:31,580
.معك حقّ

214
00:15:32,450 --> 00:15:33,950
...كم هذا مؤلم

215
00:15:45,960 --> 00:15:48,070
!يا نامي! اسمعي

216
00:15:50,500 --> 00:15:52,900
.هكذا يجب أن تفعلها يا أوسوبّ

217
00:15:53,100 --> 00:15:53,800
.حسنًا

218
00:15:53,800 --> 00:15:56,570
!أنت! حان الوقت للاستيقاظ

219
00:15:57,040 --> 00:15:59,210
ماذا؟ أحلّ الصّباح؟

220
00:16:02,550 --> 00:16:04,720
!مثل زورو تمامًا

221
00:16:04,720 --> 00:16:06,480
!ابنتها أيّها الغبيّان

222
00:16:07,180 --> 00:16:10,650
لا ندري حتّى ما الّذي يحدث
.مع نامي-سان وروبين-تشان

223
00:16:10,650 --> 00:16:12,260
وماذا عن زورو وتشوبّر...؟

224
00:16:12,260 --> 00:16:14,630
.ما زال هنالك ثلاثة كهنة آخرين

225
00:16:14,630 --> 00:16:16,960
.قد تكون هنالك محن أخرى في انتظارنا

226
00:16:16,960 --> 00:16:19,500
.هذه... محنة الحبّ

227
00:16:23,170 --> 00:16:25,740
على أيّ حال، لا خيار أمامنا
.إلاّ الذّهاب للمذبح بسرعة

228
00:16:25,740 --> 00:16:27,070
!ما قولكما؟

229
00:16:27,070 --> 00:16:30,270
!نعم، نحن آسفان

230
00:16:34,310 --> 00:16:36,050
.أتساءل ما الّذي جعلها تنطلق فجأة

231
00:16:36,550 --> 00:16:40,450
يا إلهي، أصبحت نشيطة جدًّا
.بمجرّد رؤيتها للبحر

232
00:16:42,790 --> 00:16:45,460
!إذًا رأيتُه بالفعل

233
00:16:46,890 --> 00:16:47,720
!...هذا

234
00:16:47,720 --> 00:16:51,930
.يا نامي! هذا يكفي
...حان الوقت لتخبرينا

235
00:16:54,360 --> 00:16:59,100
لا داعي للشّرح، صحيح؟
.انظرا لهذا

236
00:17:00,170 --> 00:17:01,810
تعرّفتما عليه، صحيح؟

237
00:17:02,940 --> 00:17:04,910
...لن يكون أمر التّعرّف عليه صعبًا

238
00:17:06,940 --> 00:17:09,280
.فقد رأيناه آخر مرّة هذا الصّباح فحسب

239
00:17:12,920 --> 00:17:14,350
!ما الّذي يحدث؟

240
00:17:14,620 --> 00:17:18,490
لماذا يوجد شيء ما من الأرض هنا؟
إنّه نفسه، صحيح؟

241
00:17:18,490 --> 00:17:19,720
.لا، ليس هو

242
00:17:19,720 --> 00:17:20,520
!ماذا؟

243
00:17:20,920 --> 00:17:23,490
هذا هو النّصف الآخر للبناء
.الّذي رأيناه على الأرض

244
00:17:23,490 --> 00:17:24,600
!النّصف الآخر؟

245
00:17:25,030 --> 00:17:26,700
.كان هذا يزعجني طوال الوقت

246
00:17:27,030 --> 00:17:30,470
هذه الأرض التّرابيّة لا يجب
.أن توجد في البحر الأبيض-الأبيض

247
00:17:31,030 --> 00:17:35,840
حقيقة أنّ هذه الجزيرة ليست مصنوعة
.من السّحب كانت لغزًا لي من البداية

248
00:17:36,270 --> 00:17:39,780
بعبارة أخرى، هذه الجزيرة الّتي
...تُدعى السّاحة العليا

249
00:17:41,180 --> 00:17:43,450
.كانت على الأرض في الأصل

250
00:17:44,450 --> 00:17:46,650
،ظننتُ أنّ ذلك المنزل كان غريبًا

251
00:17:47,320 --> 00:17:53,120
،فقد كان له طابق ثانٍ
.لكن لم يكن لديه دَرج

252
00:17:53,660 --> 00:17:56,930
وما كان هنالك أيّ سبب يدعو
.لبناء منزل على الحافّة مثله

253
00:17:57,490 --> 00:18:00,860
!"كان الشّاطئ عبارة عن "انقسام في الجزيرة

254
00:18:02,430 --> 00:18:04,670
!هـ-هذا مذهل

255
00:18:04,670 --> 00:18:06,540
.غبيّان! أمعنا النّظر

256
00:18:06,540 --> 00:18:11,280
.حالم؟ يبدو لي ساعيًا لجلب الانتباه

257
00:18:11,280 --> 00:18:11,980
لماذا؟

258
00:18:11,980 --> 00:18:15,280
!ماذا...؟! إنّه مجّرد لوح

259
00:18:20,550 --> 00:18:24,290
هذا هو النّصف الآخر للجزيرة
.الّذي انقسم منها

260
00:18:26,890 --> 00:18:29,560
!هذه الجزيرة جزء من جايا

261
00:18:31,960 --> 00:18:35,970
أي أنّ الجزيرة انقسمت
،لنصفين قبل زمن طويل

262
00:18:35,970 --> 00:18:38,440
.واندفع أحد النّصفين إلى السّماء

263
00:18:41,170 --> 00:18:44,240
لكن كيف لأمر كهذا أن يحدث...؟

264
00:18:45,840 --> 00:18:50,750
...ثمّة الكثير من طيور الجنوب
...لكن لماذا هي

265
00:18:51,450 --> 00:18:53,920
!لماذا هي بهذه الضّخامة؟

266
00:18:55,450 --> 00:18:57,790
،لا بدّ أنّ هذا من صنيع ذلك التّيّار الوحشيّ

267
00:18:58,460 --> 00:19:00,890
.رغم أنّ الأمر يبدو سخيفًا

268
00:19:07,500 --> 00:19:11,130
!أنت من أنقذنا من الغرق؟

269
00:19:12,900 --> 00:19:16,010
!ماذا؟! هو الإله؟

270
00:19:30,450 --> 00:19:33,360
.اسمي مونبلان كريكت

271
00:19:37,230 --> 00:19:38,860
.آسف لتسبّبي بالمشاكل لكم

272
00:19:39,300 --> 00:19:43,330
ظننتُ أنّكم مجرّد أغبياء
.يسعون خلف الذّهب

273
00:19:43,330 --> 00:19:45,040
!هل جزيرة السّماء غير موجودة؟

274
00:19:45,500 --> 00:19:48,910
.أعرف شخصًا قال أنّها موجودة

275
00:19:49,540 --> 00:19:52,110
!لكنّه يوصف بالكاذب الكبير الأسطوريّ

276
00:19:52,440 --> 00:19:53,940
!ليس أنا

277
00:19:54,340 --> 00:19:56,480
...نولاند الكذّاب

278
00:19:56,810 --> 00:20:01,420
رأيت جبلاً من الذّهب على"
.جزيرة في البحر العظيم

279
00:20:01,420 --> 00:20:05,420
أبحر الملك الشّجاع إلى البحر العظيم
،ليرى إن كانت القصّة حقيقيّة

280
00:20:05,420 --> 00:20:10,690
".ولكن، ما وجدوه كان مجرّد غابة

281
00:20:11,030 --> 00:20:13,230
رُسم وجه تعلوه ملامح
...الغباء في الكتاب

282
00:20:13,230 --> 00:20:17,270
لكنّه ذرف دموعًا كثيرة
.ومات ميتة يملؤها النّدم

283
00:20:17,940 --> 00:20:20,900
أصرّ نولاند أنّ الأطلال غرقت
،بسبب تحرّكات القشرة الأرضيّة

284
00:20:20,900 --> 00:20:24,340
لكنّ الجميع ظنّ أنّه يختلق أعذارًا
.بسبب وضعه اليائس

285
00:20:25,410 --> 00:20:30,350
.هذا نزال مع الرّجل الّذي دمّر حياتي

286
00:20:31,450 --> 00:20:35,350
لهذا السّبب واصلتَ الغوص
.إلى أن أصبتَ بالمرض

287
00:20:35,590 --> 00:20:38,820
.لستُ أريد إثبات براءته

288
00:20:38,820 --> 00:20:42,930
.أريد أن أسوّي الأمر معه قبل أن أموت

289
00:20:43,760 --> 00:20:45,460
...رجل ولا كلّ الرّجال

290
00:20:45,960 --> 00:20:49,630
!لنسوّ هذا الأمر يا نولاند

291
00:21:36,880 --> 00:21:38,280
♪ ...خذ بيدي ♪

292
00:21:38,280 --> 00:21:39,320
!لا تغنّيا

293
00:21:45,620 --> 00:21:50,960
مدينة الذّهب" الّتي وُجدت ذات
مرّة على الأرض ورآها نولاند

294
00:21:50,960 --> 00:21:53,230
.لم تغرق في المحيط

295
00:21:55,300 --> 00:21:57,070
...كان هذا الجزء من جايا

296
00:21:57,940 --> 00:21:59,840
!يحلّق في السّماء طوال هذا الوقت

297
00:22:15,850 --> 00:22:22,550
حتّى إن فرّقت بيننا المسافات

298
00:22:22,550 --> 00:22:29,030
فلا أريدك أن تنسى

299
00:22:29,030 --> 00:22:38,600
أنّه في الأيّام الّتي قد تذرف فيها
الدّموع سيكون لك

300
00:22:38,600 --> 00:22:43,210
صديق إلى جانبك لمشاركتك الألم

301
00:22:45,910 --> 00:22:52,780
لا يمكننا الاستسلام عن ذلك الحلم

302
00:22:52,780 --> 00:22:59,360
لن أسمح بأن يكون مجرّد حلم

303
00:22:59,360 --> 00:23:06,030
التّألّق الأبديّ الّذي يسعى إليه الجميع

304
00:23:06,030 --> 00:23:13,870
كلّي ثقة أنّنا سنمسك به بين أيدينا

305
00:23:26,280 --> 00:23:28,150
!لنتّجه نحو المذبح القربانيّ

306
00:23:28,150 --> 00:23:29,520
!أجل! انتظرونا يا رفاق

307
00:23:29,520 --> 00:23:31,850
!أنتما! لسنا في نزهة هنا

308
00:23:31,850 --> 00:23:34,590
.لا تكن سريع الغضب
!لنستمتع بالرّحلة

309
00:23:34,590 --> 00:23:37,060
إنّه محقّ! انظرا، هنالك أشخاص
.مرحون قادمون من هنا

310
00:23:37,060 --> 00:23:39,400
!أيّها الغبيّ! إنّهم فدائيّون يشنّون هجومًا

311
00:23:39,400 --> 00:23:40,660
!مذهل

312
00:23:40,660 --> 00:23:41,800
:في الحلقة القادمة من ون بيس

313
00:23:41,800 --> 00:23:45,200
!جايا، مدينة الذّهب في السّماء"
"!لنتّجه إلى ضريح الإله

314
00:23:45,200 --> 00:23:47,640
!ملك القراصنة، لن يكون إلاّ أنا