1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:11,840 --> 00:02:13,150
...أهذا

29
00:02:19,010 --> 00:02:23,120
...أيّها الحضور! هذا الشّقيّ هنا

30
00:02:26,080 --> 00:02:28,770
!أمعنوا النّظر

31
00:02:28,770 --> 00:02:34,190
إنّه ابن كوزكي أودن الّذي اعتُقد
!أنّه قد مات قبل 20 سنة

32
00:02:34,190 --> 00:02:36,650
،اللّيلة، سأري هذا الشّقيّ الرّحمة

33
00:02:36,650 --> 00:02:41,470
!وسأرسله ليلقى والده

34
00:02:45,080 --> 00:02:47,930
!الصّقر الأحمر

35
00:03:03,930 --> 00:03:05,750
...هذا يذكّرني

36
00:03:06,390 --> 00:03:09,000
!بقتالي مع ذلك الرّجل

37
00:03:12,310 --> 00:03:16,170
"!الرّغبة في أن يكون أودن! حلم ياماتو"

38
00:03:25,740 --> 00:03:29,140
!ذلك الرّجل؟ عمّن تتحدّث؟

39
00:03:29,140 --> 00:03:33,190
!لن أتركك حتّى تستمع إليّ

40
00:03:33,190 --> 00:03:34,770
.حسنًا

41
00:03:35,170 --> 00:03:38,320
!سأمنحك 10 ثوانٍ

42
00:03:38,320 --> 00:03:41,080
‫10 ثوانٍ؟! هذا مستحيل!

43
00:03:41,080 --> 00:03:42,870
‫30 ثانية إذًا!

44
00:03:42,870 --> 00:03:44,070
‫10 دقائق!

45
00:03:44,340 --> 00:03:48,290
!دقيقة واحدة! لن أتنازل أكثر

46
00:03:57,980 --> 00:04:00,420
!سُحقًا! لقد اختفيا

47
00:04:00,420 --> 00:04:03,300
ماذا يحدث؟ أين ياماتو؟

48
00:04:03,530 --> 00:04:06,900
!أنا آسف! فقدناهما كلاهما

49
00:04:06,900 --> 00:04:10,490
!علينا إيجادهما! ستغضب أختي كثيرًا

50
00:04:10,490 --> 00:04:11,640
!حسنًا

51
00:04:26,890 --> 00:04:28,030
...مومو-تشان

52
00:04:28,430 --> 00:04:30,450
...لقد تعرّض لضرب شديد

53
00:04:30,450 --> 00:04:32,580
...مومونوسكي-ساما

54
00:04:37,230 --> 00:04:40,530
!ابن كوزكي أودن، مومونوسكي

55
00:04:40,530 --> 00:04:45,590
لماذا ما زال حيًّا؟ ولماذا ما زال طفلاً؟

56
00:04:45,590 --> 00:04:47,930
!أتريدون أن تعرفوا؟

57
00:04:50,290 --> 00:04:54,160
!هذا حماسيّ، صحيح يا رفاق؟

58
00:04:54,160 --> 00:04:57,080
!لكن أخفضوا أصواتكم

59
00:04:57,080 --> 00:05:01,110
!أوغاد

60
00:05:02,340 --> 00:05:05,860
...في اليوم الّذي مات فيه كوزكي أودن

61
00:05:14,850 --> 00:05:19,420
!انهار معقله، قلعة أودن، أيضًا

62
00:05:22,610 --> 00:05:28,960
لكنّ مجموعة من النّاس كانت
!في القلعة اختفت كأنّها لم تكن

63
00:05:28,960 --> 00:05:33,310
!ساموراي الأكازايا وهذا الشّقيّ

64
00:05:35,660 --> 00:05:38,650
إلى أين ذهبوا؟

65
00:05:40,210 --> 00:05:42,490
!إلى المستقبل

66
00:05:43,090 --> 00:05:47,240
!لقد عبروا الزّمن 20 سنة للأمام

67
00:05:47,240 --> 00:05:52,830
وظهروا اليوم في بلاد وانو
!كما كانوا يبدون في الماضي بالضّبط

68
00:05:56,020 --> 00:05:59,810
!من كان المسؤول عن سحر كهذا؟

69
00:05:59,810 --> 00:06:01,880
...سأخبركم من كان

70
00:06:01,880 --> 00:06:05,170
!اسمها هو كوزكي توكي

71
00:06:09,360 --> 00:06:14,770
كانت توكي زوجة أودن مشعوذة
!بإمكانها إرسال حاملي الضّغينة للمستقبل

72
00:06:18,750 --> 00:06:20,620
!مستحيل

73
00:06:20,620 --> 00:06:25,230
ثمّة العديد من الأشقياء بالتشونماغي
!على رؤوسهم مثله في بلاد وانو

74
00:06:26,010 --> 00:06:29,470
!انقرضت عشيرة كوزكي قبل زمن بعيد

75
00:06:29,470 --> 00:06:31,450
!صحيح يا أخوتي؟

76
00:06:34,640 --> 00:06:36,160
!نعم يا رجل

77
00:06:36,160 --> 00:06:38,750
!أ-أنت على حقّ تمامًا

78
00:06:40,400 --> 00:06:42,690
!يا، يا أوروتشي-ساما

79
00:06:42,690 --> 00:06:45,570
!لا تقم بالأمر بعيدًا هكذا

80
00:06:45,570 --> 00:06:50,650
!أحضر لي الفتى إلى هنا! دعني أفقع عينيه

81
00:06:50,650 --> 00:06:53,220
!نعم، يبدو ذلك جيّدًا

82
00:06:57,120 --> 00:06:59,660
!كيف تجرؤ على وصف أمّاه بالمشعوذة؟

83
00:06:59,660 --> 00:07:01,880
!يا للإهانة

84
00:07:01,880 --> 00:07:04,570
!سأجعلك تدفع الثّمن يا أوروتشي

85
00:07:06,150 --> 00:07:07,760
!مهلاً، مهلاً، مهلاً

86
00:07:07,760 --> 00:07:11,670
!مع من تتحدّث هكذا في ظنّك؟

87
00:07:11,670 --> 00:07:13,410
!لا تقلق

88
00:07:13,410 --> 00:07:16,180
.سأرسلك إلى الحياة الأخرى قريبًا

89
00:07:16,180 --> 00:07:19,660
!ثمّ بإمكانك أن تبكي لأمّك هناك

90
00:07:20,690 --> 00:07:25,070
!حُلمي... أعني حلم أبي، لن يموت أبدًا

91
00:07:25,070 --> 00:07:27,980
،حتّى إن قمت بإعدامي

92
00:07:27,980 --> 00:07:35,180
فإنّ أتباعي ولوفي-دونو سيفتحون
!بلاد وانو ويشقّون الطّريق نحو المستقبل

93
00:07:35,660 --> 00:07:39,450
!أيّها القصير! لا تتظاهر بالقوّة

94
00:07:39,450 --> 00:07:42,500
!كيف أقوم بإعدامك؟

95
00:07:42,500 --> 00:07:47,690
!بالطّعن؟ بالرّصاص؟ أو ربّما سأقوم بغليك؟

96
00:07:47,690 --> 00:07:50,580
!أطلق عليه! أطلق عليه! أطلق عليه حتّى الموت

97
00:07:50,580 --> 00:07:53,030
!أنا أصوّت للغلي

98
00:07:53,030 --> 00:07:57,170
لا يستطيع ذلك الشّقيّ الصّغير
!النّجاة لساعة كما فعل والده

99
00:07:57,170 --> 00:07:59,080
!لا يستطيع قطعًا

100
00:08:04,770 --> 00:08:09,430
ماذا نفعل أيّها الزّعيم-سان؟
!لا أتحمّل مشاهدة مومو-تشان هكذا

101
00:08:09,430 --> 00:08:12,290
.سيقوم محاربو السّاموراي بشيء ما

102
00:08:12,290 --> 00:08:15,680
!عليك الانتظار يا نيكو روبين

103
00:08:17,490 --> 00:08:20,230
!اضحكي! واصلي الضّحك فحسب

104
00:08:25,710 --> 00:08:33,740
!مومونوسكي-ساما

105
00:08:34,630 --> 00:08:38,260
رغم كلّ الإحباط الّذي يشعرون به
،لعجزهم على إنقاذ مومونوسكي

106
00:08:38,260 --> 00:08:42,790
إلاّ أنّ الجنود من عمليّة الغارة
.قد نجحوا في الاختلاط في الوليمة

107
00:08:53,900 --> 00:08:59,780
،أثناء ذلك، وصلت غوّاصة لو، بولار تانغ
...الّتي تحمل ساموراي الأكازايا

108
00:08:59,780 --> 00:09:02,770
.للجهة الخلفيّة للجزيرة

109
00:09:10,750 --> 00:09:12,650
...بدأ الأمر يصبح أصعب

110
00:09:12,920 --> 00:09:14,260
.نعم

111
00:09:14,260 --> 00:09:17,780
.أشعر أنّ هذا نذير عن المعركة الّتي ستنشب

112
00:09:17,780 --> 00:09:22,870
،لا يهمّ كن ستكون المعركة صعبة
!فسندقّ عنق كايدو بالتّأكيد

113
00:09:27,710 --> 00:09:30,000
!عدّلوا التّوازن، 38 درجة

114
00:09:30,000 --> 00:09:32,210
!تعديل، 38 درجة

115
00:09:33,030 --> 00:09:35,310
!اقترب بقدر ما تستطيع من الجزيرة

116
00:09:35,310 --> 00:09:36,130
!حاضر

117
00:09:41,200 --> 00:09:44,930
!تتشكّل التّيّارات القويّة على نطاق واسع

118
00:09:57,470 --> 00:10:01,620
.نفس الأمر في الأعلى
!ستسنح لنا فرصة واحدة عندما سنصعد

119
00:10:01,620 --> 00:10:02,990
!مفهوم

120
00:10:03,260 --> 00:10:06,040
!نحن نعتمد عليك يا تورا-أو-سان

121
00:10:06,310 --> 00:10:10,040
!بيبو! شاتشي! بينغين! هل أنتم جاهزون؟

122
00:10:10,040 --> 00:10:12,180
!أجل يا قبطان

123
00:10:12,180 --> 00:10:13,680
!أجل يا سيّدي

124
00:10:13,680 --> 00:10:18,010
!لنشقّ طريقنا إلى كايدو

125
00:10:19,200 --> 00:10:22,800
!كلّ الأنظمة سالمة! بإمكاننا الصّعود في أيّ وقت

126
00:10:24,450 --> 00:10:26,430
!حسنًا! صعود للسّطح

127
00:10:49,020 --> 00:10:50,840
...إنّها تُثلج

128
00:10:54,230 --> 00:10:55,930
!غرفة

129
00:11:11,080 --> 00:11:12,440
!تبادل

130
00:11:14,420 --> 00:11:15,610
!لقد اختفوا

131
00:11:17,300 --> 00:11:20,570
!أغلقوا الباب! سنغوص ثانية

132
00:11:20,570 --> 00:11:23,490
!عُلم! غوص سريع

133
00:11:31,980 --> 00:11:33,380
!نحن هنا

134
00:11:34,650 --> 00:11:37,750
!مهاراتك رائعة بالفعل

135
00:11:39,440 --> 00:11:43,890
...وصلنا إلى أونيغاشيما أخيرًا

136
00:11:45,700 --> 00:11:47,510
...فهمت

137
00:11:47,510 --> 00:11:49,500
.ثمّة مدخلان

138
00:11:49,500 --> 00:11:52,480
.سيكون كايدو في الأعلى بكلّ تأكيد

139
00:11:52,770 --> 00:11:55,660
!نحن قريبون جدًّا من كايدو

140
00:11:55,660 --> 00:12:00,130
.سنطيح به وبأوروتشي ونعيد المجد لعشيرة كوزكي

141
00:12:00,130 --> 00:12:05,280
اللّحظة الّتي انتظرناها طوال
...عشرين سنة ونحن نعاني

142
00:12:05,280 --> 00:12:12,340
اللّحظة الّتي سنعيد فيها السّلام لبلاد وانو
...ونفتح حدودها كما رغب أودن-ساما تمامًا

143
00:12:12,340 --> 00:12:16,040
!قد حانت... قد حانت أخيرًا

144
00:12:24,030 --> 00:12:27,900
!مهلاً! لماذا لا تعاملني بلطف أكثر؟

145
00:12:27,900 --> 00:12:31,770
!أنت تطلب الكثير
!أهذه هي فكرتك الجيّدة-يوي؟

146
00:12:32,810 --> 00:12:34,820
!مهلاً لحظة

147
00:12:35,420 --> 00:12:36,940
...لا بدّ أنّه

148
00:12:50,720 --> 00:12:52,620
...هذا مؤلم

149
00:12:52,620 --> 00:12:55,840
.يا إلهي... كان ذلك فظيعًا

150
00:12:55,840 --> 00:12:57,470
!نيكوماموشي

151
00:12:57,470 --> 00:13:00,420
!صار حجمك ضخمًا

152
00:13:01,360 --> 00:13:04,300
!كاواماتسو! أنت حيّ

153
00:13:05,110 --> 00:13:08,060
!أشورا! أنت هنا أيضًا

154
00:13:08,060 --> 00:13:10,220
!نعم، لم أرك منذ زمن

155
00:13:13,160 --> 00:13:16,390
!ماركو! هل حملته إلى هنا؟

156
00:13:17,290 --> 00:13:20,690
!أنا متعب من حمل شخصين-يوي

157
00:13:20,920 --> 00:13:22,490
!شخصين؟

158
00:13:33,600 --> 00:13:35,790
!إيزو

159
00:14:29,320 --> 00:14:30,930
...أخي الكبير

160
00:14:43,420 --> 00:14:48,280
!أودن-ساما! كنت أعلم أنّك ستقوم بهذا

161
00:14:48,280 --> 00:14:49,490
!لن أسمح لك بالذّهاب

162
00:14:50,130 --> 00:14:53,780
أخي الكبير إيزو... وإينو-تشان
!ونيكو-تشان اختفوا أيضًا

163
00:15:07,820 --> 00:15:09,340
...أخي الكبير

164
00:15:13,660 --> 00:15:16,890
!أخي الكبير

165
00:15:21,420 --> 00:15:24,910
.كيكو، صرتِ ساموراي مذهلاً

166
00:15:24,910 --> 00:15:26,820
!إيزو

167
00:15:26,820 --> 00:15:28,900
!كم هذا مطمئن

168
00:15:28,900 --> 00:15:31,150
!أنا جدّ سعيد بعودتك

169
00:15:31,680 --> 00:15:35,080
!لم أخبركم بشأنه

170
00:15:35,350 --> 00:15:40,340
،قال ماركو أنّه كان يعلم أين يجد إيزو
!لذلك ذهب إلى هناك لرؤيته

171
00:15:40,340 --> 00:15:43,260
.ماركو! لم تتغيّر البتّة

172
00:15:43,260 --> 00:15:44,560
أتظنّ ذلك؟

173
00:15:44,560 --> 00:15:47,550
!لنتحدّث عن الأيّام الخوالي لاحقًا

174
00:15:48,820 --> 00:15:53,720
،ثمّة شيء ما في البحر جذب انتباهي
.لذلك سأذهب للتّحقّق منه

175
00:15:56,990 --> 00:15:59,180
!ماركو! شكرًا لك

176
00:16:05,630 --> 00:16:08,650
.أنا سعيد لأنّني انتظرت 20 سنة

177
00:16:16,390 --> 00:16:20,120
!لنطح بكايدو مهما كلّف الثّمن

178
00:16:26,860 --> 00:16:30,800
لم يجدوا ياماتو بعد؟

179
00:16:30,800 --> 00:16:33,170
.لا، ذلك ما يبدو

180
00:16:33,170 --> 00:16:35,760
!يا لذلك الابن الغبيّ

181
00:16:38,810 --> 00:16:40,100
!باو فان

182
00:16:41,120 --> 00:16:42,740
!حاضرة

183
00:16:42,740 --> 00:16:45,320
!أخبريني، ألم تجهز لينلين بعد؟

184
00:16:45,320 --> 00:16:49,650
!صحيح، بيغ مام-ساما في طريقها إلى هنا سلفًا

185
00:16:50,690 --> 00:16:53,570
!كان عليك إخباري بذلك يا باو فان

186
00:16:54,800 --> 00:16:56,450
!أنا آسفة

187
00:16:57,470 --> 00:16:59,330
.لا بأس

188
00:16:59,890 --> 00:17:04,670
!سنقدّم إعلاننا الكبير مع إعدام مومونوسكي

189
00:17:05,230 --> 00:17:06,670
!هيّا بنا

190
00:17:32,170 --> 00:17:35,030
!أسمعوني أصواتكم! اشربوا

191
00:17:40,810 --> 00:17:44,200
!سينتهي تاريخ كوزكي هنا

192
00:17:44,200 --> 00:17:50,010
،حتّى إن أتى ساموراي الأكازايا إلى هنا
!سيكون الأوان قد فات

193
00:17:58,010 --> 00:18:02,890
!حسنًا! لنشرب احتفالاً بالإعدام

194
00:18:05,480 --> 00:18:07,850
!ماذا؟ كايدو-ساما؟

195
00:18:21,970 --> 00:18:25,620
!ها قد أتى كايدو-ساما

196
00:18:35,030 --> 00:18:36,210
!كايدو

197
00:18:38,950 --> 00:18:40,760
!اسمعوا

198
00:18:41,660 --> 00:18:43,430
!يا رفاق

199
00:18:43,830 --> 00:18:49,230
دعوني أضيف أمرًا مثيرًا للاهتمام
.لعمليّة إعدام هذا الشّقيّ المملّة

200
00:18:52,400 --> 00:18:56,990
!إنّه مشروع أونيغاشيما الجديدة

201
00:18:58,530 --> 00:19:01,490
أقال مشروع أونيغاشيما الجديدة؟

202
00:19:07,060 --> 00:19:09,790
!ما الّذي يسعون إليه؟

203
00:19:31,080 --> 00:19:32,730
!سأعطيك خمس دقائق

204
00:19:33,310 --> 00:19:34,690
!حسنًا

205
00:19:35,840 --> 00:19:37,650
،في أحد الأيّام

206
00:19:38,380 --> 00:19:39,990
...أخبرت والدي

207
00:19:40,800 --> 00:19:43,320
.أنّني أريد أن أصير كوزكي أودن

208
00:19:45,120 --> 00:19:47,550
.ثمّ أوسعني والدي ضربًا

209
00:19:47,550 --> 00:19:52,290
!لماذا تخبرني بهذا؟! ولماذا الآن بالتّحديد؟

210
00:19:52,810 --> 00:19:56,750
...قبل 20 سنة، شهدت على إعدام أودن

211
00:19:57,400 --> 00:20:00,340
.السّاعة الأسطوريّة

212
00:20:00,780 --> 00:20:03,810
.لم يوجد أيّ ساموراي بنفس عظمته قطّ

213
00:20:04,320 --> 00:20:06,280
...وإنّ من قتلاه

214
00:20:06,280 --> 00:20:08,690
...هما أوروتشي ووالدي

215
00:20:09,370 --> 00:20:10,890
!كايدو

216
00:20:11,910 --> 00:20:13,610
...كان ذلك محبطًا

217
00:20:14,080 --> 00:20:15,860
،ولكنّ ما هو أكثر من ذلك

218
00:20:16,210 --> 00:20:19,690
.هو تأثّري بشدّة وعجزي عن الكفّ عن البكاء

219
00:20:33,810 --> 00:20:38,340
.ولاحقًا، وجدت هذه في كوري

220
00:20:40,320 --> 00:20:43,560
.إنّها سجلّ إبحار كوزكي أودن

221
00:20:43,560 --> 00:20:45,800
!إنّها يوميّاته

222
00:20:46,820 --> 00:20:48,010
.نعم

223
00:20:49,060 --> 00:20:51,310
!كتابي المقدّس

224
00:20:52,270 --> 00:20:56,140
حتّى والدي والبقيّة لا يعرفون
!بأمر هذه اليوميّات

225
00:20:56,140 --> 00:21:01,360
قصصه البطوليّة وحكاياته المهمّة
.الأخرى مدوّنة هنا

226
00:21:02,740 --> 00:21:06,970
،التقى بإدوارد نيوغيت، الرّجل الأقوى في العالم

227
00:21:06,970 --> 00:21:09,830
.وانضمّ إلى قراصنة اللّحية البيضاء

228
00:21:10,100 --> 00:21:14,480
.ثمّ انطلق للبحر وخاض عدّة مغامرات

229
00:21:14,480 --> 00:21:18,330
.وفي النّهاية، التقى بغولد روجر الشّهير

230
00:21:19,110 --> 00:21:21,530
،وبعد انضمامه لقراصنة روجر

231
00:21:21,530 --> 00:21:24,170
،زار عدّة جزر

232
00:21:24,170 --> 00:21:26,320
،وقابل مختلف النّاس

233
00:21:26,320 --> 00:21:28,930
.ورأى أشياء من كلّ الأنواع

234
00:21:29,280 --> 00:21:30,830
...ثمّ أدرك

235
00:21:30,830 --> 00:21:34,560
!كم أنّ العالم واسع

236
00:21:36,420 --> 00:21:39,250
،بما أنّ ساموراي الأكازايا أموات الآن

237
00:21:39,250 --> 00:21:42,360
!على أحد ما أن يحمل إرادة أودن

238
00:21:43,380 --> 00:21:44,990
...لذلك السّبب

239
00:21:46,720 --> 00:21:49,370
!سأفتح حدود هذه البلاد

240
00:22:07,860 --> 00:22:09,390
...أنت

241
00:22:18,000 --> 00:22:20,980
!دعني أقاتل إلى جانبك

242
00:22:25,920 --> 00:22:29,160
.قلت أنّك ابن كايدو

243
00:22:31,100 --> 00:22:36,670
كان كوزكي أودن رجلاً، صحيح؟
.لذلك صرتُ رجلاً أيضًا

244
00:22:37,180 --> 00:22:39,770
.أنت قويّ جدًّا

245
00:22:39,770 --> 00:22:43,380
لم تكن تقاتل بكلّ ما لديك ضدّي، صحيح؟

246
00:22:50,610 --> 00:22:52,600
.لقد ذكّرتني بإيس

247
00:23:18,600 --> 00:23:23,440
خطّة كايدو الكبرى الّتي تحرم ياماتو
!من حرّيّته قد بدأت

248
00:23:23,440 --> 00:23:26,980
.ستشوّش مكيدة اليونكو الشّرّيرة العالم

249
00:23:26,980 --> 00:23:31,070
،ولتحقيق حلمه المستحيل
!سيقاتل ياماتو إلى جانب لوفي

250
00:23:31,070 --> 00:23:35,980
!باسم كوزكي أودن، يجب الإطاحة بأحدهم

251
00:23:36,490 --> 00:23:41,210
:في الحلقة القادمة من وان بيس
"!انفجار؟! الأصفاد الّتي تقيّد حرّيّة ياماتو"

252
00:23:41,210 --> 00:23:45,650
!ملك القراصنة، لن يكون إلاّ أنا