1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,840 --> 00:01:59,150
...أهذا

29
00:02:05,010 --> 00:02:09,120
...أيّها الحضور! هذا الشّقيّ هنا

30
00:02:12,080 --> 00:02:14,770
!أمعنوا النّظر

31
00:02:14,770 --> 00:02:20,190
إنّه ابن كوزكي أودن الّذي اعتُقد
!أنّه قد مات قبل 20 سنة

32
00:02:20,190 --> 00:02:22,650
،اللّيلة، سأري هذا الشّقيّ الرّحمة

33
00:02:22,650 --> 00:02:27,470
!وسأرسله ليلقى والده

34
00:02:31,080 --> 00:02:33,930
!الصّقر الأحمر

35
00:02:49,930 --> 00:02:51,750
...هذا يذكّرني

36
00:02:52,390 --> 00:02:55,000
!بقتالي مع ذلك الرّجل

37
00:02:58,310 --> 00:03:02,170
"!الرّغبة في أن يكون أودن! حلم ياماتو"

38
00:03:11,740 --> 00:03:15,140
!ذلك الرّجل؟ عمّن تتحدّث؟

39
00:03:15,140 --> 00:03:19,190
!لن أتركك حتّى تستمع إليّ

40
00:03:19,190 --> 00:03:20,770
.حسنًا

41
00:03:21,170 --> 00:03:24,320
!سأمنحك 10 ثوانٍ

42
00:03:24,320 --> 00:03:27,080
‫10 ثوانٍ؟! هذا مستحيل!

43
00:03:27,080 --> 00:03:28,870
‫30 ثانية إذًا!

44
00:03:28,870 --> 00:03:30,070
‫10 دقائق!

45
00:03:30,340 --> 00:03:34,290
!دقيقة واحدة! لن أتنازل أكثر

46
00:03:43,980 --> 00:03:46,420
!سُحقًا! لقد اختفيا

47
00:03:46,420 --> 00:03:49,300
ماذا يحدث؟ أين ياماتو؟

48
00:03:49,530 --> 00:03:52,900
!أنا آسف! فقدناهما كلاهما

49
00:03:52,900 --> 00:03:56,490
!علينا إيجادهما! ستغضب أختي كثيرًا

50
00:03:56,490 --> 00:03:57,640
!حسنًا

51
00:04:12,890 --> 00:04:14,030
...مومو-تشان

52
00:04:14,430 --> 00:04:16,450
...لقد تعرّض لضرب شديد

53
00:04:16,450 --> 00:04:18,580
...مومونوسكي-ساما

54
00:04:23,230 --> 00:04:26,530
!ابن كوزكي أودن، مومونوسكي

55
00:04:26,530 --> 00:04:31,590
لماذا ما زال حيًّا؟ ولماذا ما زال طفلاً؟

56
00:04:31,590 --> 00:04:33,930
!أتريدون أن تعرفوا؟

57
00:04:36,290 --> 00:04:40,160
!هذا حماسيّ، صحيح يا رفاق؟

58
00:04:40,160 --> 00:04:43,080
!لكن أخفضوا أصواتكم

59
00:04:43,080 --> 00:04:47,110
!أوغاد

60
00:04:48,340 --> 00:04:51,860
...في اليوم الّذي مات فيه كوزكي أودن

61
00:05:00,850 --> 00:05:05,420
!انهار معقله، قلعة أودن، أيضًا

62
00:05:08,610 --> 00:05:14,960
لكنّ مجموعة من النّاس كانت
!في القلعة اختفت كأنّها لم تكن

63
00:05:14,960 --> 00:05:19,310
!ساموراي الأكازايا وهذا الشّقيّ

64
00:05:21,660 --> 00:05:24,650
إلى أين ذهبوا؟

65
00:05:26,210 --> 00:05:28,490
!إلى المستقبل

66
00:05:29,090 --> 00:05:33,240
!لقد عبروا الزّمن 20 سنة للأمام

67
00:05:33,240 --> 00:05:38,830
وظهروا اليوم في بلاد وانو
!كما كانوا يبدون في الماضي بالضّبط

68
00:05:42,020 --> 00:05:45,810
!من كان المسؤول عن سحر كهذا؟

69
00:05:45,810 --> 00:05:47,880
...سأخبركم من كان

70
00:05:47,880 --> 00:05:51,170
!اسمها هو كوزكي توكي

71
00:05:55,360 --> 00:06:00,770
كانت توكي زوجة أودن مشعوذة
!بإمكانها إرسال حاملي الضّغينة للمستقبل

72
00:06:04,750 --> 00:06:06,620
!مستحيل

73
00:06:06,620 --> 00:06:11,230
ثمّة العديد من الأشقياء بالتشونماغي
!على رؤوسهم مثله في بلاد وانو

74
00:06:12,010 --> 00:06:15,470
!انقرضت عشيرة كوزكي قبل زمن بعيد

75
00:06:15,470 --> 00:06:17,450
!صحيح يا أخوتي؟

76
00:06:20,640 --> 00:06:22,160
!نعم يا رجل

77
00:06:22,160 --> 00:06:24,750
!أ-أنت على حقّ تمامًا

78
00:06:26,400 --> 00:06:28,690
!يا، يا أوروتشي-ساما

79
00:06:28,690 --> 00:06:31,570
!لا تقم بالأمر بعيدًا هكذا

80
00:06:31,570 --> 00:06:36,650
!أحضر لي الفتى إلى هنا! دعني أفقع عينيه

81
00:06:36,650 --> 00:06:39,220
!نعم، يبدو ذلك جيّدًا

82
00:06:43,120 --> 00:06:45,660
!كيف تجرؤ على وصف أمّاه بالمشعوذة؟

83
00:06:45,660 --> 00:06:47,880
!يا للإهانة

84
00:06:47,880 --> 00:06:50,570
!سأجعلك تدفع الثّمن يا أوروتشي

85
00:06:52,150 --> 00:06:53,760
!مهلاً، مهلاً، مهلاً

86
00:06:53,760 --> 00:06:57,670
!مع من تتحدّث هكذا في ظنّك؟

87
00:06:57,670 --> 00:06:59,410
!لا تقلق

88
00:06:59,410 --> 00:07:02,180
.سأرسلك إلى الحياة الأخرى قريبًا

89
00:07:02,180 --> 00:07:05,660
!ثمّ بإمكانك أن تبكي لأمّك هناك

90
00:07:06,690 --> 00:07:11,070
!حُلمي... أعني حلم أبي، لن يموت أبدًا

91
00:07:11,070 --> 00:07:13,980
،حتّى إن قمت بإعدامي

92
00:07:13,980 --> 00:07:21,180
فإنّ أتباعي ولوفي-دونو سيفتحون
!بلاد وانو ويشقّون الطّريق نحو المستقبل

93
00:07:21,660 --> 00:07:25,450
!أيّها القصير! لا تتظاهر بالقوّة

94
00:07:25,450 --> 00:07:28,500
!كيف أقوم بإعدامك؟

95
00:07:28,500 --> 00:07:33,690
!بالطّعن؟ بالرّصاص؟ أو ربّما سأقوم بغليك؟

96
00:07:33,690 --> 00:07:36,580
!أطلق عليه! أطلق عليه! أطلق عليه حتّى الموت

97
00:07:36,580 --> 00:07:39,030
!أنا أصوّت للغلي

98
00:07:39,030 --> 00:07:43,170
لا يستطيع ذلك الشّقيّ الصّغير
!النّجاة لساعة كما فعل والده

99
00:07:43,170 --> 00:07:45,080
!لا يستطيع قطعًا

100
00:07:50,770 --> 00:07:55,430
ماذا نفعل أيّها الزّعيم-سان؟
!لا أتحمّل مشاهدة مومو-تشان هكذا

101
00:07:55,430 --> 00:07:58,290
.سيقوم محاربو السّاموراي بشيء ما

102
00:07:58,290 --> 00:08:01,680
!عليك الانتظار يا نيكو روبين

103
00:08:03,490 --> 00:08:06,230
!اضحكي! واصلي الضّحك فحسب

104
00:08:11,710 --> 00:08:19,740
!مومونوسكي-ساما

105
00:08:20,630 --> 00:08:24,260
رغم كلّ الإحباط الّذي يشعرون به
،لعجزهم على إنقاذ مومونوسكي

106
00:08:24,260 --> 00:08:28,790
إلاّ أنّ الجنود من عمليّة الغارة
.قد نجحوا في الاختلاط في الوليمة

107
00:08:39,900 --> 00:08:45,780
،أثناء ذلك، وصلت غوّاصة لو، بولار تانغ
...الّتي تحمل ساموراي الأكازايا

108
00:08:45,780 --> 00:08:48,770
.للجهة الخلفيّة للجزيرة

109
00:08:56,750 --> 00:08:58,650
...بدأ الأمر يصبح أصعب

110
00:08:58,920 --> 00:09:00,260
.نعم

111
00:09:00,260 --> 00:09:03,780
.أشعر أنّ هذا نذير عن المعركة الّتي ستنشب

112
00:09:03,780 --> 00:09:08,870
،لا يهمّ كن ستكون المعركة صعبة
!فسندقّ عنق كايدو بالتّأكيد

113
00:09:13,710 --> 00:09:16,000
!عدّلوا التّوازن، 38 درجة

114
00:09:16,000 --> 00:09:18,210
!تعديل، 38 درجة

115
00:09:19,030 --> 00:09:21,310
!اقترب بقدر ما تستطيع من الجزيرة

116
00:09:21,310 --> 00:09:22,130
!حاضر

117
00:09:27,200 --> 00:09:30,930
!تتشكّل التّيّارات القويّة على نطاق واسع

118
00:09:43,470 --> 00:09:47,620
.نفس الأمر في الأعلى
!ستسنح لنا فرصة واحدة عندما سنصعد

119
00:09:47,620 --> 00:09:48,990
!مفهوم

120
00:09:49,260 --> 00:09:52,040
!نحن نعتمد عليك يا تورا-أو-سان

121
00:09:52,310 --> 00:09:56,040
!بيبو! شاتشي! بينغين! هل أنتم جاهزون؟

122
00:09:56,040 --> 00:09:58,180
!أجل يا قبطان

123
00:09:58,180 --> 00:09:59,680
!أجل يا سيّدي

124
00:09:59,680 --> 00:10:04,010
!لنشقّ طريقنا إلى كايدو

125
00:10:05,200 --> 00:10:08,800
!كلّ الأنظمة سالمة! بإمكاننا الصّعود في أيّ وقت

126
00:10:10,450 --> 00:10:12,430
!حسنًا! صعود للسّطح

127
00:10:35,020 --> 00:10:36,840
...إنّها تُثلج

128
00:10:40,230 --> 00:10:41,930
!غرفة

129
00:10:57,080 --> 00:10:58,440
!تبادل

130
00:11:00,420 --> 00:11:01,610
!لقد اختفوا

131
00:11:03,300 --> 00:11:06,570
!أغلقوا الباب! سنغوص ثانية

132
00:11:06,570 --> 00:11:09,490
!عُلم! غوص سريع

133
00:11:17,980 --> 00:11:19,380
!نحن هنا

134
00:11:20,650 --> 00:11:23,750
!مهاراتك رائعة بالفعل

135
00:11:25,440 --> 00:11:29,890
...وصلنا إلى أونيغاشيما أخيرًا

136
00:11:31,700 --> 00:11:33,510
...فهمت

137
00:11:33,510 --> 00:11:35,500
.ثمّة مدخلان

138
00:11:35,500 --> 00:11:38,480
.سيكون كايدو في الأعلى بكلّ تأكيد

139
00:11:38,770 --> 00:11:41,660
!نحن قريبون جدًّا من كايدو

140
00:11:41,660 --> 00:11:46,130
.سنطيح به وبأوروتشي ونعيد المجد لعشيرة كوزكي

141
00:11:46,130 --> 00:11:51,280
اللّحظة الّتي انتظرناها طوال
...عشرين سنة ونحن نعاني

142
00:11:51,280 --> 00:11:58,340
اللّحظة الّتي سنعيد فيها السّلام لبلاد وانو
...ونفتح حدودها كما رغب أودن-ساما تمامًا

143
00:11:58,340 --> 00:12:02,040
!قد حانت... قد حانت أخيرًا

144
00:12:10,030 --> 00:12:13,900
!مهلاً! لماذا لا تعاملني بلطف أكثر؟

145
00:12:13,900 --> 00:12:17,770
!أنت تطلب الكثير
!أهذه هي فكرتك الجيّدة-يوي؟

146
00:12:18,810 --> 00:12:20,820
!مهلاً لحظة

147
00:12:21,420 --> 00:12:22,940
...لا بدّ أنّه

148
00:12:36,720 --> 00:12:38,620
...هذا مؤلم

149
00:12:38,620 --> 00:12:41,840
.يا إلهي... كان ذلك فظيعًا

150
00:12:41,840 --> 00:12:43,470
!نيكوماموشي

151
00:12:43,470 --> 00:12:46,420
!صار حجمك ضخمًا

152
00:12:47,360 --> 00:12:50,300
!كاواماتسو! أنت حيّ

153
00:12:51,110 --> 00:12:54,060
!أشورا! أنت هنا أيضًا

154
00:12:54,060 --> 00:12:56,220
!نعم، لم أرك منذ زمن

155
00:12:59,160 --> 00:13:02,390
!ماركو! هل حملته إلى هنا؟

156
00:13:03,290 --> 00:13:06,690
!أنا متعب من حمل شخصين-يوي

157
00:13:06,920 --> 00:13:08,490
!شخصين؟

158
00:13:19,600 --> 00:13:21,790
!إيزو

159
00:14:15,320 --> 00:14:16,930
...أخي الكبير

160
00:14:29,420 --> 00:14:34,280
!أودن-ساما! كنت أعلم أنّك ستقوم بهذا

161
00:14:34,280 --> 00:14:35,490
!لن أسمح لك بالذّهاب

162
00:14:36,130 --> 00:14:39,780
أخي الكبير إيزو... وإينو-تشان
!ونيكو-تشان اختفوا أيضًا

163
00:14:53,820 --> 00:14:55,340
...أخي الكبير

164
00:14:59,660 --> 00:15:02,890
!أخي الكبير

165
00:15:07,420 --> 00:15:10,910
.كيكو، صرتِ ساموراي مذهلاً

166
00:15:10,910 --> 00:15:12,820
!إيزو

167
00:15:12,820 --> 00:15:14,900
!كم هذا مطمئن

168
00:15:14,900 --> 00:15:17,150
!أنا جدّ سعيد بعودتك

169
00:15:17,680 --> 00:15:21,080
!لم أخبركم بشأنه

170
00:15:21,350 --> 00:15:26,340
،قال ماركو أنّه كان يعلم أين يجد إيزو
!لذلك ذهب إلى هناك لرؤيته

171
00:15:26,340 --> 00:15:29,260
.ماركو! لم تتغيّر البتّة

172
00:15:29,260 --> 00:15:30,560
أتظنّ ذلك؟

173
00:15:30,560 --> 00:15:33,550
!لنتحدّث عن الأيّام الخوالي لاحقًا

174
00:15:34,820 --> 00:15:39,720
،ثمّة شيء ما في البحر جذب انتباهي
.لذلك سأذهب للتّحقّق منه

175
00:15:42,990 --> 00:15:45,180
!ماركو! شكرًا لك

176
00:15:51,630 --> 00:15:54,650
.أنا سعيد لأنّني انتظرت 20 سنة

177
00:16:02,390 --> 00:16:06,120
!لنطح بكايدو مهما كلّف الثّمن

178
00:16:12,860 --> 00:16:16,800
لم يجدوا ياماتو بعد؟

179
00:16:16,800 --> 00:16:19,170
.لا، ذلك ما يبدو

180
00:16:19,170 --> 00:16:21,760
!يا لذلك الابن الغبيّ

181
00:16:24,810 --> 00:16:26,100
!باو فان

182
00:16:27,120 --> 00:16:28,740
!حاضرة

183
00:16:28,740 --> 00:16:31,320
!أخبريني، ألم تجهز لينلين بعد؟

184
00:16:31,320 --> 00:16:35,650
!صحيح، بيغ مام-ساما في طريقها إلى هنا سلفًا

185
00:16:36,690 --> 00:16:39,570
!كان عليك إخباري بذلك يا باو فان

186
00:16:40,800 --> 00:16:42,450
!أنا آسفة

187
00:16:43,470 --> 00:16:45,330
.لا بأس

188
00:16:45,890 --> 00:16:50,670
!سنقدّم إعلاننا الكبير مع إعدام مومونوسكي

189
00:16:51,230 --> 00:16:52,670
!هيّا بنا

190
00:17:18,170 --> 00:17:21,030
!أسمعوني أصواتكم! اشربوا

191
00:17:26,810 --> 00:17:30,200
!سينتهي تاريخ كوزكي هنا

192
00:17:30,200 --> 00:17:36,010
،حتّى إن أتى ساموراي الأكازايا إلى هنا
!سيكون الأوان قد فات

193
00:17:44,010 --> 00:17:48,890
!حسنًا! لنشرب احتفالاً بالإعدام

194
00:17:51,480 --> 00:17:53,850
!ماذا؟ كايدو-ساما؟

195
00:18:07,970 --> 00:18:11,620
!ها قد أتى كايدو-ساما

196
00:18:21,030 --> 00:18:22,210
!كايدو

197
00:18:24,950 --> 00:18:26,760
!اسمعوا

198
00:18:27,660 --> 00:18:29,430
!يا رفاق

199
00:18:29,830 --> 00:18:35,230
دعوني أضيف أمرًا مثيرًا للاهتمام
.لعمليّة إعدام هذا الشّقيّ المملّة

200
00:18:38,400 --> 00:18:42,990
!إنّه مشروع أونيغاشيما الجديدة

201
00:18:44,530 --> 00:18:47,490
أقال مشروع أونيغاشيما الجديدة؟

202
00:18:53,060 --> 00:18:55,790
!ما الّذي يسعون إليه؟

203
00:19:17,080 --> 00:19:18,730
!سأعطيك خمس دقائق

204
00:19:19,310 --> 00:19:20,690
!حسنًا

205
00:19:21,840 --> 00:19:23,650
،في أحد الأيّام

206
00:19:24,380 --> 00:19:25,990
...أخبرت والدي

207
00:19:26,800 --> 00:19:29,320
.أنّني أريد أن أصير كوزكي أودن

208
00:19:31,120 --> 00:19:33,550
.ثمّ أوسعني والدي ضربًا

209
00:19:33,550 --> 00:19:38,290
!لماذا تخبرني بهذا؟! ولماذا الآن بالتّحديد؟

210
00:19:38,810 --> 00:19:42,750
...قبل 20 سنة، شهدت على إعدام أودن

211
00:19:43,400 --> 00:19:46,340
.السّاعة الأسطوريّة

212
00:19:46,780 --> 00:19:49,810
.لم يوجد أيّ ساموراي بنفس عظمته قطّ

213
00:19:50,320 --> 00:19:52,280
...وإنّ من قتلاه

214
00:19:52,280 --> 00:19:54,690
...هما أوروتشي ووالدي

215
00:19:55,370 --> 00:19:56,890
!كايدو

216
00:19:57,910 --> 00:19:59,610
...كان ذلك محبطًا

217
00:20:00,080 --> 00:20:01,860
،ولكنّ ما هو أكثر من ذلك

218
00:20:02,210 --> 00:20:05,690
.هو تأثّري بشدّة وعجزي عن الكفّ عن البكاء

219
00:20:19,810 --> 00:20:24,340
.ولاحقًا، وجدت هذه في كوري

220
00:20:26,320 --> 00:20:29,560
.إنّها سجلّ إبحار كوزكي أودن

221
00:20:29,560 --> 00:20:31,800
!إنّها يوميّاته

222
00:20:32,820 --> 00:20:34,010
.نعم

223
00:20:35,060 --> 00:20:37,310
!كتابي المقدّس

224
00:20:38,270 --> 00:20:42,140
حتّى والدي والبقيّة لا يعرفون
!بأمر هذه اليوميّات

225
00:20:42,140 --> 00:20:47,360
قصصه البطوليّة وحكاياته المهمّة
.الأخرى مدوّنة هنا

226
00:20:48,740 --> 00:20:52,970
،التقى بإدوارد نيوغيت، الرّجل الأقوى في العالم

227
00:20:52,970 --> 00:20:55,830
.وانضمّ إلى قراصنة اللّحية البيضاء

228
00:20:56,100 --> 00:21:00,480
.ثمّ انطلق للبحر وخاض عدّة مغامرات

229
00:21:00,480 --> 00:21:04,330
.وفي النّهاية، التقى بغولد روجر الشّهير

230
00:21:05,110 --> 00:21:07,530
،وبعد انضمامه لقراصنة روجر

231
00:21:07,530 --> 00:21:10,170
،زار عدّة جزر

232
00:21:10,170 --> 00:21:12,320
،وقابل مختلف النّاس

233
00:21:12,320 --> 00:21:14,930
.ورأى أشياء من كلّ الأنواع

234
00:21:15,280 --> 00:21:16,830
...ثمّ أدرك

235
00:21:16,830 --> 00:21:20,560
!كم أنّ العالم واسع

236
00:21:22,420 --> 00:21:25,250
،بما أنّ ساموراي الأكازايا أموات الآن

237
00:21:25,250 --> 00:21:28,360
!على أحد ما أن يحمل إرادة أودن

238
00:21:29,380 --> 00:21:30,990
...لذلك السّبب

239
00:21:32,720 --> 00:21:35,370
!سأفتح حدود هذه البلاد

240
00:21:53,860 --> 00:21:55,390
...أنت

241
00:22:04,000 --> 00:22:06,980
!دعني أقاتل إلى جانبك

242
00:22:11,920 --> 00:22:15,160
.قلت أنّك ابن كايدو

243
00:22:17,100 --> 00:22:22,670
كان كوزكي أودن رجلاً، صحيح؟
.لذلك صرتُ رجلاً أيضًا

244
00:22:23,180 --> 00:22:25,770
.أنت قويّ جدًّا

245
00:22:25,770 --> 00:22:29,380
لم تكن تقاتل بكلّ ما لديك ضدّي، صحيح؟

246
00:22:36,610 --> 00:22:38,600
.لقد ذكّرتني بإيس

247
00:23:04,600 --> 00:23:09,440
خطّة كايدو الكبرى الّتي تحرم ياماتو
!من حرّيّته قد بدأت

248
00:23:09,440 --> 00:23:12,980
.ستشوّش مكيدة اليونكو الشّرّيرة العالم

249
00:23:12,980 --> 00:23:17,070
،ولتحقيق حلمه المستحيل
!سيقاتل ياماتو إلى جانب لوفي

250
00:23:17,070 --> 00:23:21,980
!باسم كوزكي أودن، يجب الإطاحة بأحدهم

251
00:23:22,490 --> 00:23:27,210
:في الحلقة القادمة من وان بيس
"!انفجار؟! الأصفاد الّتي تقيّد حرّيّة ياماتو"

252
00:23:27,210 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا