1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,500 --> 00:03:36,000
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:36,000 --> 00:03:40,740
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:41,500 --> 00:03:47,400
!لكنّ كلاًّ من إيس واللّحية البيضاء قد فقدا حياتهما

40
00:03:48,490 --> 00:03:51,100
...اللّحية البيضاء، إيس

41
00:03:51,100 --> 00:03:54,560
.دعونا نتكفّل بدفن الاثنين

42
00:03:55,420 --> 00:03:58,880
!سأسمح بهذا فقط لأنّك طلبت يا أحمر الشّعر

43
00:03:58,880 --> 00:04:00,140
!...ولكن

44
00:04:00,900 --> 00:04:03,270
!سأتحمّل اللّوم

45
00:04:04,880 --> 00:04:05,930
.شكرًا

46
00:04:06,500 --> 00:04:08,680
!عالجوا الجرحى الآن

47
00:04:12,730 --> 00:04:15,020
...هذه الحرب

48
00:04:15,020 --> 00:04:17,000
!منتهية

49
00:04:25,330 --> 00:04:29,880
!القادة العظماء يواجهون بعضهم بعضًا"
"!التّبشير بالعصر الجديد

50
00:04:53,860 --> 00:04:56,500
.ما خطب البثّ؟ لا أستطيع سماعه

51
00:04:56,500 --> 00:04:58,860
هل بسبب الاتّصال السّيّئ؟

52
00:04:59,360 --> 00:05:02,360
ماذا حدث في الحرب في النّهاية؟

53
00:05:02,360 --> 00:05:04,360
هل فازت البحريّة؟

54
00:05:04,360 --> 00:05:05,700
فازت، أليس كذلك؟

55
00:05:05,710 --> 00:05:07,730
.بدأ يتّضح الآن

56
00:05:07,730 --> 00:05:09,880
هل هُزم طاقم اللّحية البيضاء؟

57
00:05:09,940 --> 00:05:12,200
هل انتصرت البحريّة فعلاً؟

58
00:05:13,000 --> 00:05:15,410
بخصوص الحرب القائمة في مارينفورد

59
00:05:15,410 --> 00:05:18,900
،والّتي أطرافها هم طاقم اللّحية البيضاء ونحن مقرّ البحريّة

60
00:05:18,900 --> 00:05:24,160
استغرقت أطول ممّا توقّعنا بسبب مثابرة العدوّ

61
00:05:24,160 --> 00:05:27,800
لكن كلّ جنود البحريّة قاتلوا بحسّ العدالة

62
00:05:27,800 --> 00:05:32,930
وهزموا كلّ أفراد طاقم اللّحية البيضاء ومن حالفهم

63
00:05:32,930 --> 00:05:38,070
ويسرّنا الآن أن نخبركم أنّ مقرّ البحريّة
...حقّق نصرًا ساحقًا

64
00:05:40,310 --> 00:05:41,770
!نجحوا

65
00:05:45,030 --> 00:05:49,410
!البحريّة لا تُهزم! يحيا أبطالنا

66
00:06:01,790 --> 00:06:06,470
!أريد أن أُستدعى للواجب يومًا ما

67
00:06:10,390 --> 00:06:12,600
!انتهت الحرب

68
00:06:12,600 --> 00:06:14,180
!أجل

69
00:06:14,180 --> 00:06:15,720
!أنا مسرور

70
00:06:15,720 --> 00:06:19,660
!القرصان الأسطوريّ، اللّحية البيضاء قد خسر

71
00:06:23,690 --> 00:06:25,990
انتهت الحرب، صحيح؟

72
00:06:25,990 --> 00:06:28,200
!أجل! أنت بأمان الآن

73
00:06:28,200 --> 00:06:29,710
!هذا عظيم

74
00:06:29,770 --> 00:06:31,030
!لقد نجحوا

75
00:06:31,030 --> 00:06:32,370
!نحن بأمان

76
00:06:32,370 --> 00:06:35,780
!تحيا البحريّة! تحيا حكومة العالم

77
00:06:35,780 --> 00:06:40,480
!ومن أجل النّصر والعدالة والسّلام! مرحى

78
00:06:51,140 --> 00:06:57,470
!في ساحة المعركة، مارينفورد! ثمّة سبع سفن في البحر

79
00:06:58,100 --> 00:07:00,640
...أولئك الّذين سيشاركون في العصر الجديد

80
00:07:00,640 --> 00:07:04,780
.هناك ليشهدوا هذا التّحوّل العظيم في التّاريخ

81
00:07:05,690 --> 00:07:08,740
،مشاهدين الغبار المتخلّف من المعركة الطّاحنة في مارينفورد

82
00:07:08,740 --> 00:07:12,320
،الّتي توضح عمل العدالة في عصر القراصنة العظيم

83
00:07:12,320 --> 00:07:16,580
.وهم يشعرون باضطراب التّغيير في العصور

84
00:07:17,120 --> 00:07:18,290
.أيّها القبطان دريك

85
00:07:18,950 --> 00:07:21,710
.انتهت... أخيرًا

86
00:07:21,710 --> 00:07:25,320
.على البحريّة أن تتغيّر أيضًا

87
00:07:26,000 --> 00:07:28,130
،قريبًا

88
00:07:28,130 --> 00:07:34,050
ستغرق مناطق اللّحية البيضاء
.في بحر من الدّماء في هذه الدوّامة

89
00:07:35,510 --> 00:07:37,430
.اللّحية السّوداء هو المفتاح

90
00:07:37,430 --> 00:07:41,890
.اكتسب تابعين جدد وقوّة اللّحية البيضاء

91
00:07:41,890 --> 00:07:46,150
!أنا واثق أنّهم سيحكمون لفترة

92
00:07:50,110 --> 00:07:53,950
!كلّ هذا... خطؤه

93
00:07:53,950 --> 00:07:56,410
!سأتعقّبه قريبًا

94
00:07:56,910 --> 00:07:59,250
!لنذهب! إلى العالم الجديد

95
00:08:01,330 --> 00:08:03,590
ما الّذي يجري بالضّبط؟

96
00:08:03,590 --> 00:08:06,210
عمّ تتحدّث يا أبو-سان؟

97
00:08:06,210 --> 00:08:11,380
سيصبح ذلك الشّخص عدوّه. هل سينقذه حقًّا؟

98
00:08:11,380 --> 00:08:12,300
ماذا؟

99
00:08:12,300 --> 00:08:16,970
.أقصد بحديثي ترافالغار لو. إنّه معروف بوحشيّته

100
00:08:17,720 --> 00:08:23,100
.ما كان لينقذ قبّعة القشّ إلّم يكن في الأمر مكسب له

101
00:08:26,080 --> 00:08:27,690
.هذا غريب

102
00:08:27,690 --> 00:08:31,070
ما الخطب أيّها القبطان هوكينس؟

103
00:08:31,070 --> 00:08:35,570
كنتُ أحاول رؤية احتمالات بقاء لوفي قيد الحياة

104
00:08:35,570 --> 00:08:37,880
.لكنّها لم تصل إلى الصّفر إطلاقًا

105
00:08:41,120 --> 00:08:44,520
،للأمانة، خفتُ عندما اندلعت الحرب

106
00:08:44,520 --> 00:08:46,750
.لكن الآن، مات القرصان العظيم اللّحية البيضاء

107
00:08:47,410 --> 00:08:49,750
لذا انتهت فعلاً، أليس كذلك؟

108
00:08:50,160 --> 00:08:51,840
.أجل

109
00:08:58,100 --> 00:09:00,400
!ما الّذي انتهى؟

110
00:09:01,500 --> 00:09:08,650
،القوّة الجديدة الّتي ظهرت في هذه الحرب
!اللّحية السّوداء رجل لا يستهان به

111
00:09:11,230 --> 00:09:14,530
.العالم الجديد يحكمه اليونكو

112
00:09:15,610 --> 00:09:20,240
.اللّحية البيضاء وأحمر الشّعر وكايدو وبيغ مام

113
00:09:20,240 --> 00:09:22,120
،لكن بما أنّه مات أحدهم

114
00:09:22,120 --> 00:09:26,080
!اختلّ توازن العالم وما عاد أحد يستطيع التّكهّن بالعواقب

115
00:09:26,080 --> 00:09:32,630
!هذه بداية العصر الجديد الّذي لم ير له أحد مثيل

116
00:09:42,470 --> 00:09:45,890
،أخبار انتصار البحريّة بالحرب في مارينفورد

117
00:09:45,890 --> 00:09:49,060
،الحرب الأعظم منذ بداية عصر القراصنة العظيم

118
00:09:49,730 --> 00:09:52,220
انتشرت من حول العالم كالنّار في الهشيم

119
00:09:52,220 --> 00:09:54,990
.والنّاس يحتفلون بالأخبار في كلّ مكان

120
00:09:54,990 --> 00:09:56,700
.الأزرق الشّرقيّ

121
00:09:56,700 --> 00:09:57,990
!مرحى

122
00:09:57,990 --> 00:10:00,170
!مات اللّحية البيضاء

123
00:10:00,170 --> 00:10:02,080
!أجل

124
00:10:02,080 --> 00:10:03,750
!نحن بأمان الآن

125
00:10:03,750 --> 00:10:05,580
!أنا مسرور حقًّا

126
00:10:05,580 --> 00:10:07,470
.الأزرق الغربيّ

127
00:10:08,250 --> 00:10:11,380
!ستشهد البحار السّلام الآن

128
00:10:11,380 --> 00:10:12,960
!مرحى

129
00:10:12,960 --> 00:10:14,670
.الأزرق الجنوبيّ

130
00:10:14,670 --> 00:10:16,300
!سنبيع بخصم اليوم

131
00:10:16,300 --> 00:10:18,090
!ونحن أيضًا

132
00:10:18,090 --> 00:10:19,970
!انتصرت البحريّة

133
00:10:19,970 --> 00:10:21,470
!حمدًا لهذا

134
00:10:21,470 --> 00:10:23,430
.الأزرق الشّماليّ

135
00:10:24,860 --> 00:10:27,310
!أجل! أنا مسرور حقًّا

136
00:10:27,310 --> 00:10:29,440
!لنشرب جميعًا

137
00:10:29,450 --> 00:10:31,360
!لدينا شراب كثير

138
00:10:31,360 --> 00:10:33,150
.الغراند لاين

139
00:10:33,230 --> 00:10:35,160
ماذا نفعل غدًا؟

140
00:10:35,160 --> 00:10:36,530
!أريد لعب لعبة الملاحقة

141
00:10:36,530 --> 00:10:38,030
!الغمّيضة

142
00:10:38,030 --> 00:10:39,660
!حسنًا

143
00:10:40,950 --> 00:10:44,450
!يا إلهي! أشكرك

144
00:10:45,720 --> 00:10:51,880
،كما حدث في معظم التّاريخ
قُطعت بعض الحقائق أثناء نقلها

145
00:10:51,880 --> 00:10:56,590
."وفقط كلمتان برزتا، "انتصار البحريّة

146
00:10:56,590 --> 00:11:01,500
،ومن فرط حماسهم بسماع الأخبار
...لم يلحظ النّاس شيئًا

147
00:11:03,080 --> 00:11:04,550
!مـ-ما الّذي يجري؟

148
00:11:08,140 --> 00:11:10,480
!انظروا إلى حالكم! كم هذا مضحك

149
00:11:10,480 --> 00:11:16,110
قال اللّحية البيضاء أنّ الكنز العظيم
!الوان بيس موجود

150
00:11:16,550 --> 00:11:19,030
!سأجده

151
00:11:22,320 --> 00:11:27,120
!ينتظرنا الكثير في عرض البحر! لنشدّ رحالنا

152
00:11:31,690 --> 00:11:33,710
.انتصار البحريّة

153
00:11:33,710 --> 00:11:39,510
...النّتيجة ليس بالضّرورة سلام

154
00:11:44,430 --> 00:11:48,140
!لـ-لا تتقدّموا أكثر! لا تدخلوا بلدتنا

155
00:11:49,930 --> 00:11:55,190
،مع زوال العائق، أي تهديد اللّحية البيضاء

156
00:11:55,190 --> 00:11:58,480
...أصبح عالم البحار متقلّبًا حقًّا

157
00:12:18,590 --> 00:12:20,960
!أميرال الأسطول سنغوكو

158
00:12:22,630 --> 00:12:24,480
!أنت هنا

159
00:12:25,550 --> 00:12:27,800
!وردنا خبر من إمبل داون

160
00:12:28,220 --> 00:12:30,310
هل ماجيلان بخير؟

161
00:12:30,310 --> 00:12:32,810
.تعرّض لإصابات خطيرة وبالكاد حيّ

162
00:12:33,240 --> 00:12:36,610
.تلقّى علاجات مكثّفة من قبل الطّاقم الطّبّيّ

163
00:12:36,610 --> 00:12:41,110
.إنّه رجل صاحب إحساس بالواجب، وهو يلوم نفسه

164
00:12:41,110 --> 00:12:45,200
.قيل أنّه إن استطاع الحراك الآن، فسيقتل نفسه

165
00:12:45,200 --> 00:12:48,620
!لا تدعوه يرتكب شيئًا غبيًّا

166
00:12:48,620 --> 00:12:50,520
!حـ-حاضر

167
00:12:51,790 --> 00:12:54,460
ما الّذي يجري في السّجن؟

168
00:12:54,460 --> 00:12:56,880
.اسمح لي أن أخبرك بالوضع الرّاهن

169
00:12:56,880 --> 00:13:01,300
.الوضع في المستوى 6 بالضّبط سيّئ. إنّه كارثة بحقّ

170
00:13:03,090 --> 00:13:04,760
كارثة؟

171
00:13:20,440 --> 00:13:22,470
ما الأمر؟

172
00:13:22,470 --> 00:13:27,000
أنتم أيّها السّجناء محكوم عليكم
!بالبقاء خلف القضبان إلى الأبد

173
00:13:27,740 --> 00:13:30,450
!لا تملكون شيئًا تفعلون سوى انتظار الموت

174
00:13:30,450 --> 00:13:35,540
!ما رأيكم بهذا إذًا؟! لِمَ لا تقاتلون بعضكم في الزّنزانة؟

175
00:13:37,020 --> 00:13:42,670
!سأحرّر النّاجين منكم كأعضاء في طاقمي

176
00:13:42,670 --> 00:13:43,920
!حقًّا؟

177
00:13:43,920 --> 00:13:45,510
!أخرجني من هنا

178
00:13:45,510 --> 00:13:47,520
!ضمّني إلى طاقمك

179
00:13:56,560 --> 00:14:02,650
!إذًا فقد حرّر أعضاءً مختارين من أسوأ مجرمي العالم؟

180
00:14:02,960 --> 00:14:06,000
.أجل. لكنّه أخذ أربعة سجناء فقط

181
00:14:06,000 --> 00:14:11,200
سان خوان ولف وأفالو بيزارو
.وفاسكو شوت وكاتارينا ديفون

182
00:14:11,200 --> 00:14:17,210
!لكن من الواضح غياب مساجين أكثر من المستوى 6

183
00:14:17,210 --> 00:14:18,670
...ما يعني

184
00:14:26,720 --> 00:14:32,510
!فهمت. إذًا هناك هاربون أكثر من المستوى 6

185
00:14:32,510 --> 00:14:38,230
،إن تسلّل ولو سجين واحد من المستوى 6 إلى بلاد ما

186
00:14:38,230 --> 00:14:41,480
!سيكون النّاس في خطر كبير

187
00:14:41,480 --> 00:14:44,980
.تفقّد واعرف كم هربوا

188
00:14:44,980 --> 00:14:49,200
!اعرف أسماءهم وأصدر لائحة مطلوبين للغاية حالاً

189
00:14:50,410 --> 00:14:51,910
ما الخطب؟

190
00:14:51,910 --> 00:14:54,580
...في الواقع، أنا

191
00:14:54,580 --> 00:14:58,220
أملك أوامر من حكومة العالم

192
00:14:58,880 --> 00:15:00,400
.بإبقاء مسألة المستوى 6 هذه سرًّا

193
00:15:01,190 --> 00:15:05,630
.المزيد من الأخطاء الفادحة ستضرّ بسمعة الحكومة

194
00:15:10,220 --> 00:15:12,400
!سحقًا لهم

195
00:15:59,560 --> 00:16:02,100
!أيّها الوغد

196
00:16:02,100 --> 00:16:04,020
!دوفلامينغو

197
00:16:05,360 --> 00:16:10,690
.موريا، أنت ضعيف جدًّا على أن تواصل حمل لقب شيتشيبوكاي

198
00:16:11,990 --> 00:16:16,280
...مات في حرب القمّة" يبدو خبرًا أفضل"

199
00:16:16,280 --> 00:16:18,990
."من "قتلته الحكومة

200
00:16:19,760 --> 00:16:23,370
!فكرة من هذه؟! سنغوكو؟

201
00:16:23,820 --> 00:16:27,380
!لا، بل شخص أعلى شأنًا

202
00:16:38,760 --> 00:16:41,390
...حارّ... الجوّ حارّ

203
00:16:41,390 --> 00:16:45,100
.لِمَ الجوّ حارّ هكذا؟ لا أحتمله

204
00:16:45,100 --> 00:16:49,570
!هلاّ خرست؟! تجعلني أشعر بالحرارة أيضًا

205
00:16:49,570 --> 00:16:52,030
.أنت مغطّى بالفرو. لا ألومك

206
00:16:53,150 --> 00:16:54,890
.أكره عندما نغطس

207
00:16:54,890 --> 00:16:56,970
...علينا البقاء في مكان ضيّق

208
00:16:56,970 --> 00:16:59,530
.مع أشخاص مقرفين

209
00:16:59,530 --> 00:17:01,410
!أنت أكثر شخص مقرف

210
00:17:01,410 --> 00:17:04,830
...لا أستطيع الاحتمال! لا خيار لديّ سوى

211
00:17:05,900 --> 00:17:07,540
!أجعلكما تعرفان شعوري

212
00:17:07,540 --> 00:17:09,210
!توقّف

213
00:17:09,210 --> 00:17:10,310
!هذا حارّ

214
00:17:10,310 --> 00:17:11,710
!هذا مقرف

215
00:17:11,710 --> 00:17:13,720
!بربّك

216
00:17:13,720 --> 00:17:17,720
!أترجّاك! لا بأس بالقليل
!دعني أحصل على بعض الهواء النّقيّ

217
00:17:18,180 --> 00:17:21,930
!حسنًا! كفّ عن حكّ عرقك بي

218
00:17:21,930 --> 00:17:25,600
!إلى السّطح! دعونا نصعد إلى السّطح الآن

219
00:17:41,990 --> 00:17:46,500
!هذا منعش حقًّا! كم الجوّ جميل في الخارج

220
00:17:46,500 --> 00:17:49,540
!بردتُ الآن! الجانب الأيمن، آمن

221
00:17:49,540 --> 00:17:51,290
!الجانب الأيسر، آمن

222
00:17:52,000 --> 00:17:54,090
...الأمام

223
00:17:54,090 --> 00:17:56,090
!أفعى، آمن! أفعى؟

224
00:17:57,050 --> 00:17:58,260
!ما هذا؟

225
00:17:58,260 --> 00:17:59,560
!كيف أتت أفعى إلى هنا؟

226
00:18:02,260 --> 00:18:03,560
!لا

227
00:18:05,230 --> 00:18:07,810
!سفينة بحريّة

228
00:18:07,810 --> 00:18:09,250
!أخبرا القبطان

229
00:18:09,250 --> 00:18:10,270
!ثمّة أحد هناك

230
00:18:11,080 --> 00:18:14,980
!شيتشيبوكاي، الإمبراطورة القرصانة بوا هانكوك

231
00:18:22,120 --> 00:18:27,120
.لا تقلقوا. حوّلتُ كلّ جنود البحريّة إلى حجر

232
00:18:27,120 --> 00:18:30,360
كيف حال لوفي إذًا؟

233
00:18:30,360 --> 00:18:32,870
أحالته سيّئة؟ سيتعافى، أليس كذلك؟

234
00:18:33,710 --> 00:18:36,970
كيف علمت أنّنا سنصعد هنا؟

235
00:18:36,970 --> 00:18:40,970
.خفتُ وظننت أنّ البحريّة ما زالت تلاحقنا

236
00:18:41,350 --> 00:18:43,800
.جعلت سالوم تتبعكم تحت الماء

237
00:18:44,430 --> 00:18:45,220
!فهمت

238
00:18:45,220 --> 00:18:48,180
!لا تغيّر الموضوع أيّها الوحش الغامض

239
00:18:48,830 --> 00:18:49,770
!آسف

240
00:18:49,770 --> 00:18:50,520
!ضعيف

241
00:18:51,020 --> 00:18:54,520
...كيف حال لوفي؟ أخبروني الآن

242
00:18:55,480 --> 00:18:57,110
!أيّها القبطان

243
00:18:59,150 --> 00:19:01,110
.فعلتُ كلّ ما في استطاعتي

244
00:19:01,110 --> 00:19:03,830
أتقصد أنّه بخير؟

245
00:19:03,830 --> 00:19:09,660
...تمكنّا من جعل حالته تستقرّ. ولكن

246
00:19:09,660 --> 00:19:12,720
.تكبّد ضررًا أكبر ممّا تظنّين

247
00:19:13,390 --> 00:19:15,460
.لا ضمان أنّه سينجو بعد

248
00:19:19,420 --> 00:19:21,550
!لا عجب في ذلك

249
00:19:21,550 --> 00:19:23,040
من يتكلّم؟

250
00:19:23,040 --> 00:19:28,400
!لم يستطع فتى قبّعة القشّ حتّى الوقوف في إمبل داون

251
00:19:28,400 --> 00:19:30,690
!كان قبّعة القشّ يخاطر بحياته

252
00:19:30,690 --> 00:19:32,980
!خرجنا من السّجن بفضله

253
00:19:32,980 --> 00:19:36,120
:بفضله، نستطيع تحقيق حلمنا

254
00:19:36,120 --> 00:19:37,650
!الذّهاب إلى مملكة كاماباكّا

255
00:19:37,650 --> 00:19:38,820
!لنذهب

256
00:19:38,820 --> 00:19:42,270
!إلى ديار نيوكاما في بلاد نيوكاما

257
00:19:46,110 --> 00:19:47,540
ما هم؟

258
00:19:47,930 --> 00:19:52,440
.إنّهم سجناء من إمبل داون
.يبدو أنّهم أصدقاء لوفي

259
00:19:52,440 --> 00:19:54,330
.لقد تسلّلوا إلى السّفينة

260
00:19:56,180 --> 00:19:59,760
!لا أصدّق أنّه تحامل على نفسك لهذا الحدّ

261
00:19:59,760 --> 00:20:03,470
!كان يريد إنقاذ أخيه إيس بهذا القدر

262
00:20:03,470 --> 00:20:08,100
!هذا صحيح! ندري كم ضغط على نفسه لفعل ذلك

263
00:20:08,770 --> 00:20:12,850
...لكنّ أخاه مات نصب عينيه

264
00:20:13,420 --> 00:20:15,810
...من أجل أن يحميه

265
00:20:18,240 --> 00:20:22,950
!لا توجد أيّ عدالة في العالم
!ليس من المفاجئ أنّه انهار

266
00:20:22,950 --> 00:20:26,450
!سحقًا لكلّ ذلك! تماسك يا قبّعة القشّ

267
00:20:26,450 --> 00:20:29,620
!عليك أن تعيش! عليك ذلك يا قبّعة القشّ

268
00:20:36,270 --> 00:20:42,390
!يا لها من مأساة! يا ليتني أستطيع أخذ محلّه

269
00:20:42,390 --> 00:20:45,090
!لوفي المسكين

270
00:20:48,050 --> 00:20:49,280
...أشعر بالغيرة

271
00:20:49,280 --> 00:20:52,230
لا بدّ أنّ من الجميل أن تهتمّ لك
...أميرة الثّعابين هكذا

272
00:20:52,230 --> 00:20:53,230
...أجل، أجل

273
00:20:53,230 --> 00:20:56,230
بالمناسبة، هل أنت صديق الفتى قبّعة القشّ؟

274
00:20:56,760 --> 00:20:59,190
.لا، لم أكن مضطرًّا لإنقاذه على الإطلاق

275
00:20:59,190 --> 00:21:02,900
،وإن كنت تتساءل حيال دافعي
.فبإمكاني اختلاق سبب ما

276
00:21:02,900 --> 00:21:07,120
.لا، لا بأس. أحيانًا تخبرك غرائز ما عليك فعله

277
00:21:07,120 --> 00:21:08,160
!انتظر

278
00:21:08,170 --> 00:21:09,830
!لا يمكنك السّير بعد

279
00:21:09,830 --> 00:21:11,960
!لا تتحامل على نفسك هكذا

280
00:21:11,960 --> 00:21:14,010
!أخبرك أن تستريح

281
00:21:14,010 --> 00:21:15,630
!قد يُفتح الجرح من جديد

282
00:21:15,630 --> 00:21:17,270
ماذا تفعل؟

283
00:21:22,550 --> 00:21:24,070
!جينبي

284
00:21:25,930 --> 00:21:29,600
أنت ترافالغار لو من الأزرق الشّماليّ، أليس كذلك؟

285
00:21:32,390 --> 00:21:36,450
مهلاً، ألا بأس بأن تتحرّك هكذا؟

286
00:21:37,310 --> 00:21:39,130
!شكرًا

287
00:21:40,440 --> 00:21:41,980
!لقد أنقذت حياتي

288
00:21:41,980 --> 00:21:44,280
.عليك أن تستريح. وإلاّ قد تموت

289
00:21:45,650 --> 00:21:48,530
!لا يمكنني أن أريح بالي. ذلك مستحيل

290
00:21:48,530 --> 00:21:52,910
!ما خسرته للتّوّ كان مهمًّا جدًّا بالنّسبة لي

291
00:21:52,910 --> 00:21:57,830
!لهذا أنا واثق أنّ لوفي-كن يمرّ بوضع أسوأ بكثير

292
00:21:57,830 --> 00:22:04,090
على الأقلّ، أرغمته غريزته لحماية
!نفسه بفقدانه وعيه في ذلك الوقت

293
00:22:04,090 --> 00:22:06,960
،حتّى إن نجا

294
00:22:06,960 --> 00:22:11,050
لا أستطيع التّوقّف عن القلق بشأن
.اللّحظة الّتي سيستيقظ فيها

295
00:22:18,010 --> 00:22:21,200
أنت، أيّها الوحش الغامض، هل لديك حلزون اتّصال؟

296
00:22:22,190 --> 00:22:25,350
!حاضر.... أقصد حاضر يا سيّدتي

297
00:22:25,350 --> 00:22:26,400
!آسف

298
00:22:26,400 --> 00:22:29,820
...أشعر بالغيرة. إنّه كخادمها

299
00:22:31,390 --> 00:22:36,330
سأستدعي سفينة كوجا لكي نعبر
.الحزام الهادئ حتّى بهذه الغوّاصة

300
00:22:36,330 --> 00:22:40,970
!إن اكتشفت الحكومة أنّ لوفي حيّ، سيلاحقونه

301
00:22:40,970 --> 00:22:43,210
!لنؤويه في جزيرة النّساء

302
00:22:43,920 --> 00:22:44,960
!ماذا؟

303
00:22:46,210 --> 00:22:50,960
،إن كانوا ما زالوا يعتبرونني شيتشيبوكاي
.فيمكن للوفي أن يرتاح بأمان

304
00:23:13,820 --> 00:23:15,160
...لوفي

305
00:23:25,440 --> 00:23:26,730
،باقتراح من هانكوك

306
00:23:26,730 --> 00:23:30,050
،أُخذَ لوفي إلى جزيرة النّساء كي تُشفى جراحه

307
00:23:30,050 --> 00:23:32,800
.حيث يستعيد وعيه أخيرًا

308
00:23:32,800 --> 00:23:36,150
،لكن بينما تعود ذكرياته من المعركة

309
00:23:36,150 --> 00:23:39,810
.يتملّك لوفي يأس عميق

310
00:23:39,810 --> 00:23:41,210
:في الحلقة القادمة من وان بيس

311
00:23:41,210 --> 00:23:45,020
"!الهبوط في جزيرة النّساء! يستوعب لوفي الواقع الأليم"

312
00:23:45,020 --> 00:23:47,450
!ملك القراصنة، لن يكون إلاّ أنا

313
00:23:50,000 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة