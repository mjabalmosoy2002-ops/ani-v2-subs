1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,430
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,600
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,600 --> 00:01:12,700
فلنلوّنها بألواننا الخاصّة

13
00:01:38,060 --> 00:01:43,190
"!ذروة لوفي، الوصول للمستوى الخامس"

14
00:02:02,830 --> 00:02:06,240
.أستطيع سماع طبول التّحرير

15
00:02:11,060 --> 00:02:13,720
...أنا أسمعها لأوّل مرّة منذ 800 عام

16
00:02:15,320 --> 00:02:17,960
!إنّها طبول التّحرير

17
00:02:26,220 --> 00:02:27,590
...أنا واثق

18
00:02:31,060 --> 00:02:32,930
!أنّه هنا

19
00:02:44,080 --> 00:02:46,460
...جويبوي

20
00:02:46,610 --> 00:02:49,260
!عاد

21
00:02:57,680 --> 00:02:59,610
...ماذا حدث

22
00:02:59,830 --> 00:03:01,000
لي؟

23
00:03:11,330 --> 00:03:14,560
لماذا ما زلت أستطيع الوقوف؟

24
00:03:18,160 --> 00:03:20,200
!لقد خسرت

25
00:03:24,530 --> 00:03:27,050
!لكنّني مستمتع جدًّا لسبب ما

26
00:03:29,460 --> 00:03:30,960
جويبوي؟

27
00:03:30,960 --> 00:03:32,160
أهو لوفي؟

28
00:03:33,030 --> 00:03:36,250
أهذا ما أخبرك به زونيشا؟

29
00:03:51,280 --> 00:03:54,030
!سأحظى ببعض المرح أخيرًا

30
00:04:03,410 --> 00:04:07,090
هل أنت مستيقظ يا سيّدي القرصان؟

31
00:04:08,030 --> 00:04:08,950
لوفي؟

32
00:04:14,530 --> 00:04:15,620
ماذا؟

33
00:04:15,620 --> 00:04:17,790
أهذا فتى قبّعة القشّ؟

34
00:04:19,250 --> 00:04:20,710
قبّعة القشّ؟

35
00:04:20,870 --> 00:04:21,580
!مهلاً

36
00:04:22,250 --> 00:04:24,540
!ما زال قيد الحياة-يوي

37
00:04:24,540 --> 00:04:26,420
نجى لوفي؟

38
00:04:26,420 --> 00:04:29,120
أخي الكبير حيّ؟

39
00:04:30,510 --> 00:04:32,680
!يا لها من فرحة

40
00:04:51,290 --> 00:04:54,700
،ضحّينا بواحد من نخبة عملائنا

41
00:04:55,130 --> 00:04:59,120
.ولزيادة الطّين بلّة، أثرنا غضب كايدو

42
00:05:02,340 --> 00:05:04,830
،كان القرار الأفضل لأجل المستقبل

43
00:05:04,830 --> 00:05:07,960
.وهذه النّتيجة هي أفضل ما كنّا لنأمله

44
00:05:08,730 --> 00:05:12,800
من صالحنا دائمًا القضاء حتّى على
...أقلّ الاحتمالات خطورة

45
00:05:14,060 --> 00:05:15,970
حاولت حكومة العالم

46
00:05:15,970 --> 00:05:21,520
.منذ وقت طويل وضع يدها على فاكهة المطّاط

47
00:05:21,520 --> 00:05:26,690
.وبالطّبع لم تنجح في ذلك على الإطلاق

48
00:05:26,950 --> 00:05:29,150
.وهذا لمدّة 800 سنة

49
00:05:32,430 --> 00:05:33,920
يراودني شعور

50
00:05:34,370 --> 00:05:36,260
بأنّ فاكهة الشّيطان هذه

51
00:05:36,790 --> 00:05:39,700
.تسعى جاهدة للهرب منّا

52
00:05:41,250 --> 00:05:43,840
.وذلك ما يحدث بالفعل

53
00:05:46,350 --> 00:05:49,920
.تملك الفواكه من نوع زون إرادة خاصّة بها

54
00:05:50,430 --> 00:05:54,460
.وتحمل هذه الفاكهة بالتّحديد اسم إله

55
00:05:54,850 --> 00:05:59,010
.تملك فاكهة المطّاط اسمًا آخر لا يعلمه الكثيرون

56
00:06:02,020 --> 00:06:05,810
،فاكهة البشر من نوع زون

57
00:06:05,810 --> 00:06:08,610
...النّوع الخرافيّ، صنف

58
00:06:10,530 --> 00:06:12,040
.نيكا

59
00:06:13,710 --> 00:06:19,200
،يتميّز جسد آكلها بخصائص المطّاط

60
00:06:19,330 --> 00:06:22,520
.والشّيء الوحيد الّذي قد يحدّ قدراتها هو مخيّلته

61
00:06:22,740 --> 00:06:25,920
،يرسم آكلها الابتسامات على وجوه النّاس

62
00:06:28,550 --> 00:06:30,960
.ويُعرف بمحارب التّحرير

63
00:06:31,630 --> 00:06:33,170
...ويُعرف أيضًا

64
00:06:33,640 --> 00:06:37,070
!بإله الشّمس نيكا

65
00:06:40,940 --> 00:06:46,040
إيقاظ تلك الفاكهة يزيد من مرونة الجسم

66
00:06:46,310 --> 00:06:48,770
.بأضعاف مضاعفة ويمنحه الحرّيّة الكاملة

67
00:06:51,320 --> 00:06:56,110
وقيل أنّه لا يوجد قوّة أكثر سخافة
.منها في العالم بأسره

68
00:06:56,880 --> 00:06:58,820
.هذا كلّ ما نعرفه

69
00:07:10,680 --> 00:07:15,170
الموسيقى المفضّلة لدى كوزكي أودن؟

70
00:07:36,970 --> 00:07:38,710
!كوموراساكي

71
00:07:39,270 --> 00:07:40,780
هيوري؟

72
00:07:42,630 --> 00:07:46,660
.أنا أيضًا أحببت أودن من أعماق قلبي

73
00:07:48,080 --> 00:07:49,790
.لا تتهوّري

74
00:07:49,790 --> 00:07:53,170
.كان كايدو يستغلّني، هذه هي الحقيقة

75
00:07:57,440 --> 00:07:59,720
!بإمكاننا الهرب من غضبه معًا

76
00:07:59,980 --> 00:08:02,390
!أزيلي المسامير الآن

77
00:08:08,760 --> 00:08:10,810
...لقد رددت الجميل

78
00:08:11,240 --> 00:08:14,770
...الّذي أظهره لك السّاموراي بالعداوة

79
00:08:15,010 --> 00:08:20,150
قبل قليل، فكّرت في تخفيف عقوبتك
.إلى الإعدام بالرّصاص

80
00:08:20,150 --> 00:08:23,570
...ولن نعدم أودن وحده

81
00:08:23,570 --> 00:08:26,550
!بل وعائلته بالكامل أيضًا

82
00:08:29,010 --> 00:08:33,000
من قد يصّدق الهراء الّذي تتفوّه به؟

83
00:08:38,140 --> 00:08:39,240
...إنّ والدي

84
00:08:40,190 --> 00:08:42,230
.وفى بوعده لك

85
00:08:43,120 --> 00:08:44,300
أم تُراني أهذي؟

86
00:08:46,230 --> 00:08:48,490
.لقد صدّق كلماتكما أنت وكايدو

87
00:08:49,240 --> 00:08:51,520
آمن أنّ خلاص بلاد وانو ممكنًا

88
00:08:53,570 --> 00:08:55,590
،طوال خمس سنين طويلة

89
00:08:55,700 --> 00:08:58,220
.ورقص خلالها كالأبله

90
00:09:00,210 --> 00:09:02,730
.دون أن يفسّر سبب أفعاله لعائلته

91
00:09:09,880 --> 00:09:12,210
!وفى والدي بوعده

92
00:09:14,850 --> 00:09:18,430
كان مقتنعًا أنّكما بدوركما ستفيان بوعدكما

93
00:09:19,920 --> 00:09:22,090
.وتحمّل تعذيبكما له طوال ساعة

94
00:09:24,150 --> 00:09:27,050
!لقد تحمّل آلام الزّيت الّذي أذاب جسده

95
00:09:30,530 --> 00:09:34,020
.ورغم كلّ ذلك، واصل الابتسام

96
00:09:35,740 --> 00:09:38,190
،ولأنّ رعايا بلادنا كانوا رهائن عندكما

97
00:09:39,040 --> 00:09:43,090
تحمّل والدي المعاناة في صمت
.وحيدًا دون أيّ دعم

98
00:09:43,620 --> 00:09:45,750
!لا يمكنني حتّى تصوّر الألم الّذي عاناه

99
00:09:55,760 --> 00:09:57,970
ما الخطب يا هيوري؟

100
00:09:59,180 --> 00:10:02,810
ألا تشعر بالسّوء يا والدي من سخرية الجميع منك؟

101
00:10:02,810 --> 00:10:05,280
.أنا لا أهتمّ لذلك البتّة

102
00:10:05,280 --> 00:10:06,180
لماذا؟

103
00:10:06,180 --> 00:10:09,100
.عائلتي هنا إلى جانبي، وهذا كلّ ما أحتاجه

104
00:10:09,100 --> 00:10:13,200
!أهذا صحيح؟ إذًا فلن نتركك أبدًا

105
00:10:17,580 --> 00:10:21,900
!أدرك الآن كم كان أودن ساموراي عظيم

106
00:10:21,900 --> 00:10:23,710
.إنّه يستحقّ كلّ الثّناء

107
00:10:23,710 --> 00:10:28,280
...وبصفتي الشّوغن، كان عليّ أن أكافئه

108
00:10:33,920 --> 00:10:35,540
!إيّاك أن تنسى من أكون

109
00:10:36,090 --> 00:10:37,870
!أنا كوزكي هيوري

110
00:10:39,810 --> 00:10:42,630
!اصمت أيّها الفاسد اللّعين

111
00:10:46,680 --> 00:10:50,070
سواء كانت معدتي تقرقر من الجوع
،أو أرتدي خرقًا بالية

112
00:10:50,230 --> 00:10:53,810
.فلم أجلب العار يومًا لاسم والدي

113
00:10:54,650 --> 00:10:59,680
.لم أعتبرك يومًا شوغن لبلادنا هذه

114
00:11:01,160 --> 00:11:03,280
!يا لك من حقير بائس وجاهل

115
00:11:04,120 --> 00:11:08,500
كلّ يوم مرّ على بلاد وانو وأنت على رأسها
!إهانة لأرواح من سقطوا في سبيلها

116
00:11:10,240 --> 00:11:14,620
!توقّفي! لا تتسرّعي

117
00:11:15,050 --> 00:11:18,750
!أمسى الانتقام أثرًا من الماضي الآن

118
00:11:19,330 --> 00:11:21,240
،يمكنك قتلي

119
00:11:21,240 --> 00:11:24,260
!لكنّ ذلك لن يهزم كايدو

120
00:11:24,500 --> 00:11:26,920
...أوروتشي-ساما

121
00:11:28,190 --> 00:11:31,510
...لقد فشلت

122
00:11:31,660 --> 00:11:34,810
أهذا أنت يا كانجورو؟

123
00:11:34,810 --> 00:11:37,730
.صارت لحظاتي في هذه الحياة معدودة

124
00:11:37,730 --> 00:11:39,770
.أتيت في الوقت المناسب

125
00:11:40,120 --> 00:11:42,570
!لديّ مشهد جديد لك لتؤدّيه

126
00:11:42,820 --> 00:11:45,400
!احرق هذه المرأة حتّى الموت

127
00:11:45,400 --> 00:11:47,690
!اقفز إليها

128
00:11:51,420 --> 00:11:55,700
سنسمّي المشهد "فشل انتقام المرأة
،"الّذي تأجّج لعشرين سنة

129
00:11:55,880 --> 00:11:58,760
!كم هذا مأساويّ

130
00:11:58,890 --> 00:12:00,170
هل فهمتِ

131
00:12:00,550 --> 00:12:05,170
يا هيوري ناجية عشيرة كوزكي؟

132
00:12:05,170 --> 00:12:08,170
،لطالما ابتسم الحظّ في وجوه الأقوياء

133
00:12:08,170 --> 00:12:10,890
!هذا كلّ ما يعنيه هذا

134
00:12:14,070 --> 00:12:17,140
...أوروتشي-ساما

135
00:12:18,830 --> 00:12:21,270
!لا تقترب منّي! ابتعد! بل اذهب إليها

136
00:12:25,810 --> 00:12:28,040
!أيّها الأبله كانجورو

137
00:12:28,210 --> 00:12:30,750
!النّجدة يا هيوري

138
00:12:31,290 --> 00:12:33,920
!أنا أحترق! أحترق

139
00:12:36,760 --> 00:12:39,750
.سيبزغ الفجر لا محالة

140
00:12:40,630 --> 00:12:42,040
...ونحن الكوزكي

141
00:12:42,340 --> 00:12:45,300
!نفي دائمًا بوعودنا

142
00:12:50,940 --> 00:12:54,890
!أستطيع القيام بكلّ ما أرغب به

143
00:12:56,610 --> 00:12:59,930
.أعتقد أنّ بإمكاني القتال أكثر

144
00:13:00,940 --> 00:13:04,520
.حتّى صوت نبضات قلبي يدفعني للضّحك

145
00:13:10,050 --> 00:13:14,800
!هذه هي ذروة قوّتي

146
00:13:16,550 --> 00:13:17,790
...سأسمّيها

147
00:13:19,250 --> 00:13:21,910
!المستوى الخامس

148
00:14:43,510 --> 00:14:45,160
ما الّذي يحدث؟

149
00:14:45,160 --> 00:14:47,210
لِمن هاكي الملك الأسمى هذا؟

150
00:14:47,380 --> 00:14:49,160
من أين مصدره؟

151
00:14:49,770 --> 00:14:52,300
!يا رجال

152
00:15:00,400 --> 00:15:03,350
ماذا يوجد هناك على السّطح؟

153
00:15:27,730 --> 00:15:28,960
كايدو-سان؟

154
00:15:30,220 --> 00:15:31,880
!قبّعة القشّ

155
00:15:31,880 --> 00:15:34,300
!إنّه لوفي

156
00:15:46,160 --> 00:15:47,740
!عضلات! عضلات

157
00:15:47,740 --> 00:15:49,020
!عضلات

158
00:15:57,570 --> 00:15:58,820
!استعداد

159
00:17:03,360 --> 00:17:05,470
...قبّعة القشّ

160
00:17:05,470 --> 00:17:07,550
هل نجوت؟

161
00:17:07,550 --> 00:17:09,640
!أشكرك جزيل الشّكر

162
00:17:27,330 --> 00:17:29,070
!نفَس الدّمار

163
00:17:53,750 --> 00:17:55,900
!عد من حيث أتيت

164
00:18:51,120 --> 00:18:53,320
!المستوى الخامس

165
00:19:05,640 --> 00:19:09,080
.آسف لأنّ هنالك من قاطع نزالانا

166
00:19:13,020 --> 00:19:14,890
...مسدّس

167
00:19:14,890 --> 00:19:17,520
...زئير باغوا

168
00:19:19,230 --> 00:19:20,520
!الجسد الحديديّ

169
00:19:22,150 --> 00:19:26,280
!سي بي-0؟! لماذا هو هنا؟

170
00:20:15,920 --> 00:20:19,580
.لم أكن أريد الفوز هكذا

171
00:20:24,680 --> 00:20:26,340
!لا تشغل بالك بذلك

172
00:20:27,690 --> 00:20:29,400
.لنواصل نزالنا

173
00:21:51,380 --> 00:21:54,330
انتهى الوقت

174
00:21:55,330 --> 00:21:58,720
ولا تنتهي السّخرية أبدًا

175
00:21:59,280 --> 00:22:01,090
هذا مثاليّ

176
00:22:01,090 --> 00:22:04,130
لعبة الغمّيضة

177
00:22:04,460 --> 00:22:05,780
انتهت

178
00:22:06,900 --> 00:22:10,900
تعال معي
(سنراها قريبًا)

179
00:22:10,900 --> 00:22:14,650
دع قلبك ينبض بسرعة
(الجزيرة لنا أنا وأنت)

180
00:22:14,650 --> 00:22:19,040
شيء ما تغيّر
(سنراها قريبًا)

181
00:22:19,040 --> 00:22:23,290
لديك الوقت لتكبر
(3-2-1)

182
00:22:23,290 --> 00:22:27,040
عاليًا وقويًّا
اقبل ما تشعر به بالكامل

183
00:22:27,040 --> 00:22:31,170
لا تُعاش الحياة وحيدًا

184
00:22:31,170 --> 00:22:35,270
لكنّنا نحن الشّباب أحرار

185
00:22:35,270 --> 00:22:38,230
لنعش جميعًا أحلامنا

186
00:22:38,600 --> 00:22:39,890
الأكثر جنونًا

187
00:22:39,890 --> 00:22:43,810
ستنير الطّريق أمامنا

188
00:22:43,810 --> 00:22:47,940
لنحاول التّقدّم للأمام

189
00:22:47,940 --> 00:22:51,870
لنكتشف معًا أصقاع العالم

190
00:22:51,870 --> 00:22:55,770
أنا وأنت، سنحلّق بعيدًا

191
00:23:04,580 --> 00:23:06,550
ما عاد المنطق ينفع

192
00:23:06,550 --> 00:23:08,470
.وحتّى الأرض صارت جزءًا من اللّعبة

193
00:23:08,470 --> 00:23:10,710
.صارت الهجمات غير قابلة للتّصديق

194
00:23:10,710 --> 00:23:14,310
هل لوفي إله أم أنّه شيء آخر؟

195
00:23:14,310 --> 00:23:18,510
!كوميديا مضحكة ستجعل العيون تخرج من مُقلها

196
00:23:18,510 --> 00:23:21,850
!انتباه، هذه هي ذروة الأحداث

197
00:23:22,560 --> 00:23:23,930
:في الحلقة القادمة من وان بيس

