1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,480 --> 00:02:27,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:30,630 --> 00:02:32,740
!تشوبّر! ما الخطب؟

33
00:02:32,740 --> 00:02:35,060
!انظر إليّ جيّدًا! هذه أنا نامي

34
00:02:43,290 --> 00:02:44,250
!تشوبّر

35
00:02:49,170 --> 00:02:50,410
!توقّف يا تشوبّر

36
00:03:07,120 --> 00:03:09,510
.سأسرع وأنهي الأمر ها هنا

37
00:03:09,510 --> 00:03:10,390
!ساق العاصفة

38
00:03:11,440 --> 00:03:15,560
.هذا سيّئ! حتّى نعل حذائي زلق
!لا يمكنني تفاديه

39
00:03:18,520 --> 00:03:20,510
!ماذا؟! يمكنني تفاديه

40
00:03:21,190 --> 00:03:23,130
.عادت ساقي اليمنى لطبيعتها

41
00:03:23,130 --> 00:03:26,490
لماذا؟ ما سبب ذلك؟

42
00:03:27,560 --> 00:03:28,680
...إنّها مبلّلة

43
00:03:28,680 --> 00:03:31,410
.تبلّلت بسبب الفوضى السّابقة
!هذا صحيح

44
00:03:32,510 --> 00:03:37,210
!الماء! أستطيع غسل صابون قوّتها بالماء

45
00:03:50,790 --> 00:03:52,180
.أراك متفائلة كثيرًا

46
00:03:52,720 --> 00:03:56,170
حتّى إن اكتشفتِ كيف تبطلين
،الفقاعات الذّهبيّة

47
00:03:56,170 --> 00:03:58,270
.فمن المستحيل أن أسمح لك بذلك

48
00:04:01,770 --> 00:04:04,730
!سحابة الخروف: فقاعات الاسترخاء

49
00:04:06,170 --> 00:04:08,990
!سأعصف بكلّ تلك الفقاعات برياحي

50
00:04:09,480 --> 00:04:10,590
...جوّ العاصـ

51
00:04:12,510 --> 00:04:13,840
!كلاّ

52
00:04:16,760 --> 00:04:20,460
...لا... لا... إنّ قواي

53
00:04:23,710 --> 00:04:25,040
!مسدّس الإصبع المنحني

54
00:04:26,260 --> 00:04:27,130
...عصاي

55
00:04:27,130 --> 00:04:27,950
!السّوط

56
00:04:44,660 --> 00:04:46,080
.كان ذلك مفيدًا

57
00:04:46,080 --> 00:04:47,230
مفيدًا؟

58
00:04:49,570 --> 00:04:52,480
،إن عصفتِ بي كما فعلتِ

59
00:04:53,150 --> 00:04:55,740
.فإنّك ستعصفين أيضًا بالفقاعات المزعجة

60
00:04:56,740 --> 00:05:01,210
،ما هذه إلاّ خدعة. إن كان هذا ما تريدين
.فسأعصف بك إلى أن تموتين

61
00:05:05,060 --> 00:05:07,020
!التّوقّعات الجوّيّة غائمة

62
00:05:07,020 --> 00:05:08,730
!الجوّ الغائم

63
00:05:12,170 --> 00:05:15,350
هذا مختلف عن عرض الألعاب
!السّحريّة الّتي اعتدت فعلها

64
00:05:17,220 --> 00:05:19,950
سُحب؟ المزيد من البرق؟

65
00:05:22,600 --> 00:05:26,040
.لا يتمّ توليد البرق من سُحب خفيفة كهذه

66
00:05:26,040 --> 00:05:28,940
!وبدل ذلك، سأقوم بتكثيفها

67
00:05:29,600 --> 00:05:32,670
!مستحيل...! كلاّ، قد تفعل ذلك

68
00:05:33,500 --> 00:05:35,280
!التّوقّعات الجوّيّة ماطرة

69
00:05:35,280 --> 00:05:36,410
!الكرة الباردة

70
00:05:36,410 --> 00:05:37,080
!انتقال آنيّ

71
00:05:39,110 --> 00:05:40,120
!أمطري

72
00:05:40,700 --> 00:05:42,360
!الجوّ الممطر

73
00:05:50,090 --> 00:05:54,300
لستِ ظريفة إطلاقًا. أفسدتِ بشرتك
.النّاعمة الّتي منحتك إيّاها لطفًا منّي

74
00:05:54,710 --> 00:05:58,630
إن كانت الظّرافة تعني ألاّ أقاتل
.بدوري، فلا أريد ذلك

75
00:05:59,220 --> 00:06:00,340
!الشّحنة الباردة

76
00:06:07,010 --> 00:06:08,790
!جوّ السّراب

77
00:06:11,780 --> 00:06:12,860
!اختفت؟

78
00:06:12,860 --> 00:06:16,570
...أصبحت الآن... أفهم قدراتك

79
00:06:18,190 --> 00:06:20,240
.إضافة لقوّة السّي بي 9

80
00:06:20,740 --> 00:06:22,280
!ما هذا؟

81
00:06:24,810 --> 00:06:26,540
:جوّ السّراب

82
00:06:27,690 --> 00:06:29,630
!فاتا مورغانا

83
00:06:32,960 --> 00:06:37,150
قرار نامي! أطلقوا على تشوبّر"
"!الخارج عن السّيطرة

84
00:06:42,710 --> 00:06:44,420
...إنّه ذلك السّراب ثانية

85
00:06:44,420 --> 00:06:46,440
.لديك جسد واحد في نهاية المطاف

86
00:06:46,830 --> 00:06:49,150
.هذا صحيح. إحداهنّ هي أنا الحقيقيّة

87
00:06:49,150 --> 00:06:53,900
والأربع الأخريات مجرّد وهم
.تعكسه البرودة الّتي في الجوّ

88
00:06:55,140 --> 00:06:56,890
أقلت وهمًا؟

89
00:06:56,890 --> 00:06:59,410
.يبدو ذلك غامضًا وجميلاً

90
00:07:00,060 --> 00:07:02,120
،لكن عند التّفكير في الأمر بهدوء

91
00:07:02,120 --> 00:07:04,790
يصبح من الواضح أنّ تلك الأوهام
.لا تملك قوّة هجوميّة

92
00:07:05,960 --> 00:07:09,750
.بعبارة أخرى، إنّها مجرّد تهديدات جوفاء

93
00:07:09,750 --> 00:07:10,960
.هذا صحيح

94
00:07:11,810 --> 00:07:15,050
.أصبحتِ جريئة إذًا؟ ما عدت ظريفة

95
00:07:15,050 --> 00:07:16,130
!شحنة البرق

96
00:07:18,070 --> 00:07:20,970
.واحدة فقط من بين الأربع هي أنا الحقيقيّة

97
00:07:21,420 --> 00:07:22,970
وماذا في ذلك؟

98
00:07:23,390 --> 00:07:24,430
...وأيضًا

99
00:07:24,430 --> 00:07:26,270
!كرة البرق

100
00:07:27,320 --> 00:07:31,480
.فقط 20% من هجماتي حقيقيّة أيضًا
لماذا لا تحاولين تفاديها؟

101
00:07:32,450 --> 00:07:34,730
!سُحقًا! عليّ حماية نفسي
!أيّها هي الحقيقيّة؟

102
00:07:38,320 --> 00:07:40,590
.%أمّا قوّتها من جهة أخرى، فهي 100

103
00:07:40,590 --> 00:07:43,160
سبق وأخبرتك أنّني سأفاجئك
ودفاعاتك مرخيّة، أليس كذلك؟

104
00:07:55,640 --> 00:07:58,390
.تختلف هذه عن عصا الطّقس القديمة

105
00:07:58,390 --> 00:08:00,930
يملك مجرّد هجوم كرة برق
.كل هذا القدر من القوّة

106
00:08:01,270 --> 00:08:04,390
.وبهجومي القويّ التّالي، ستسقطين

107
00:08:05,330 --> 00:08:09,350
أيّ نوع من التّنبّؤات هذا؟
...يا لغرورك

108
00:08:09,350 --> 00:08:12,060
.ليست تنبّؤات. بل توقّعات جوّيّة

109
00:08:12,410 --> 00:08:14,530
.تحكّمت بكلّ من الرّطوبة والحرارة هنا

110
00:08:14,530 --> 00:08:16,900
!الطّقس في هذه الغرفة تحت سيطرتي

111
00:08:18,390 --> 00:08:20,850
وما أهمّيّة السّيطرة على الطّقس؟

112
00:08:20,850 --> 00:08:23,240
القوى السّتّ هي تقنيات
.تتجاوز قدرات البشر

113
00:08:23,930 --> 00:08:24,580
!يا للوقاحة

114
00:08:25,960 --> 00:08:26,910
!لم تكن الحقيقيّة

115
00:08:27,340 --> 00:08:30,620
إنّ احتمالية الإمساك
.%بالحقيقيّة بيننا هي 20

116
00:08:38,680 --> 00:08:42,390
،وحسب التّوقّعات الجوّيّة لسماء اليوم
،رغم أنّ الضّغط الجوّيّ مستقرّ

117
00:08:42,390 --> 00:08:46,110
ستظلّ السّحب الصّغيرة الدّاكنة
ذات التّيّارات الهوائيّة العنيفة ثابتة

118
00:08:46,110 --> 00:08:49,770
لبعض الوقت، وسرعان ما ستطلق
.صواعق ستمرّ خلال صدرك

119
00:08:50,630 --> 00:08:53,770
!انتبهي رجاءً من أن يُشلّ قلبك

120
00:08:54,200 --> 00:08:55,980
!جوّ السّحب الدّاكنة

121
00:08:56,500 --> 00:08:59,940
إن كان هذا برقًا، فقد أريتك في
.البداية أنّ بإمكاني حماية نفسي

122
00:08:59,940 --> 00:09:01,150
...ما دمتُ حذرة

123
00:09:01,690 --> 00:09:06,250
إنّ العيب في تلك التّقنية هو عجزك
.عن الحركة عندما تستعملينها

124
00:09:12,560 --> 00:09:17,270
إنّك تستخفّين بي بالفعل. أتحاولين
إخباري أنّني سأبطلها لأهاجم؟

125
00:09:17,270 --> 00:09:18,170
...في تلك الحالة

126
00:09:18,710 --> 00:09:20,130
!خروف الصّابون

127
00:09:20,820 --> 00:09:23,610
.ليس عليّ أن أعرف أيكنّ هي الحقيقيّة

128
00:09:23,610 --> 00:09:27,220
سأبتلع كلّ شيء بموجة كبيرة
.من فقاعات الاسترخاء

129
00:09:29,020 --> 00:09:30,390
:سحابة الخروف

130
00:09:32,610 --> 00:09:34,270
!الموجة العاتية

131
00:09:40,290 --> 00:09:42,030
.سيُقضى عليّ إن أصابتني

132
00:09:42,030 --> 00:09:45,350
إنّ من ستظلّ هنا بعد أن أبتلع
.كلّ شيء ستكون الحقيقيّة بينكنّ

133
00:09:45,350 --> 00:09:47,450
!لن يحدث ذلك

134
00:09:47,450 --> 00:09:49,160
!جوّ العاصفة

135
00:09:51,440 --> 00:09:53,160
!استعملت الرّياح لإبعاد الفقاعات

136
00:10:00,690 --> 00:10:04,500
لكن يبدو أنّ من مرّت
.من خلالها هي الحقيقيّة

137
00:10:21,110 --> 00:10:21,980
!مسدّس الإصبع

138
00:10:24,200 --> 00:10:27,240
.ماذا؟ ظننتُ أنّها وهم آخر

139
00:10:29,270 --> 00:10:31,020
.لن أسمح لك بالرّكض في الأرجاء بعد الآن

140
00:10:31,020 --> 00:10:33,950
.سأملأ جسدك بالثّقوب فحسب

141
00:10:39,330 --> 00:10:40,920
نسيت الأمر سلفًا، صحيح؟

142
00:10:42,270 --> 00:10:45,840
عليك أن تنتبهي للتّوقّعات
.الجوّيّة الّتي يقولها الملاّحون

143
00:10:51,740 --> 00:10:53,610
...من السّحب الدّاكنة إلى عصا الطّقس

144
00:10:54,280 --> 00:10:55,560
!...ستنطلق صاعقة

145
00:11:02,950 --> 00:11:03,320
!هيّا

146
00:11:07,900 --> 00:11:08,820
!...الهجوم السّابق

147
00:11:14,660 --> 00:11:15,910
!جوّ رمح البرق

148
00:11:21,370 --> 00:11:23,050
...لا يهمّ كم أنت قويّة

149
00:11:23,550 --> 00:11:25,760
.توقّعاتي الجوّيّة لا تخطئ أبدًا

150
00:11:44,440 --> 00:11:47,600
.أصدقائي في الانتظار. سآخذ مفتاحك

151
00:11:57,450 --> 00:12:00,920
!ذلك الوغد... الغزال الغوريلاّ اللّعين

152
00:12:16,960 --> 00:12:21,100
!تعمّ الفوضى في هذه الجزيرة بأكملها

153
00:12:21,100 --> 00:12:24,060
.من الأفضل أن يكونوا بخير جميعًا

154
00:12:27,770 --> 00:12:29,990
!يا رجال البحريّة! عودوا

155
00:12:30,780 --> 00:12:32,950
!خذونا معكم

156
00:12:40,290 --> 00:12:41,170
!ساق العاصفة

157
00:12:41,670 --> 00:12:43,290
!قاطع السّماء

158
00:12:44,400 --> 00:12:46,170
!تشوبّر! ما الّذي يؤخّرك كثيرًا؟

159
00:13:22,000 --> 00:13:23,600
!ما الّذي تعتقدين نفسك فاعلة؟

160
00:13:24,950 --> 00:13:27,040
!انتظري يا نيكو روبين

161
00:14:41,580 --> 00:14:42,450
!جيّد

162
00:15:25,250 --> 00:15:27,650
!أيّها الغزال الغوريلاّ! إلى أين ذهبت؟

163
00:15:27,650 --> 00:15:30,810
!فرانكي! ما الّذي تفعله هنا؟

164
00:15:30,810 --> 00:15:32,710
.هذه أنت يا فتاة

165
00:15:33,730 --> 00:15:36,910
أتى وحش الغزال الغوريلاّ ذاك
من طاقمكم إلى هنا، صحيح؟

166
00:15:36,910 --> 00:15:39,010
غزال... تقصد تشوبّر؟

167
00:15:39,010 --> 00:15:40,930
.نعم، ذلك الغزال الغوريلاّ

168
00:15:41,290 --> 00:15:45,220
صحيح. ما الخطب؟ ماذا حدث له؟

169
00:15:45,220 --> 00:15:47,390
وما أدراني؟! أريد طرح ذلك
!السّؤال عليك أنا أيضًا

170
00:15:47,390 --> 00:15:49,720
إنّه ليس شخصًا يستطيع
التّحوّل لشيء كهذا، صحيح؟

171
00:15:51,260 --> 00:15:54,110
!وكيف لي أن أعرف؟
!لم أره من قبل في تلك الهيئة

172
00:15:54,500 --> 00:15:58,700
فهمت... ظننتُ أنّكم قد تعرفون
.كيف تتعاملون مع ذلك الشّيء

173
00:15:59,390 --> 00:16:01,740
.حسنًا، أظنّني سأضطرّ لقتله

174
00:16:03,860 --> 00:16:07,580
.إن قلتَ ذلك ثانية، أنا من ستقتلك

175
00:16:07,580 --> 00:16:10,330
.لـ-لن أقول ذلك ثانية. على الإطلاق

176
00:16:12,190 --> 00:16:15,050
.لكن ما زال علينا فعل شيء ما

177
00:16:15,050 --> 00:16:17,920
،إن ثار هائجًا في الأرجاء وهو بتلك الضّخامة

178
00:16:18,420 --> 00:16:21,110
.فلا يمكن الجزم إلى متى سيصمد هذا البرج

179
00:16:22,330 --> 00:16:26,980
صحيح. إنّه ليس في وضع
.يمكّنه من الاستماع لنا

180
00:16:27,880 --> 00:16:32,940
،بدا وكأنّه لم يتعرّف إليّ
.لذلك أظنّه قد خرج عن وعيه

181
00:16:32,940 --> 00:16:34,770
ما سبب ذلك؟

182
00:16:35,270 --> 00:16:36,760
،لستُ واثقة تمامًا

183
00:16:36,760 --> 00:16:41,000
لكن ربّما للأمر علاقة بقوى
.فاكهة الشّيطان الّتي أكلها

184
00:16:41,000 --> 00:16:44,320
إذًا فهنالك طريقة واحد لحلّ
...هذه المشكلة

185
00:16:46,460 --> 00:16:50,850
.بالمناسبة، لستِ سيّئة على الإطلاق
هل هزمت هذه المرأة؟

186
00:16:50,850 --> 00:16:54,260
.مفتاحها مهمّ. مفتاح الرّقم 2

187
00:16:54,260 --> 00:16:57,500
.المفتاح... مهلاً لحظة. سأبحث عنه

188
00:16:57,870 --> 00:17:01,010
المفتاح! المفتاح! أين أخفيته؟

189
00:17:01,800 --> 00:17:03,220
!فضيحة ممتازة

190
00:17:03,610 --> 00:17:06,240
!تراجع! تراجع

191
00:17:06,240 --> 00:17:10,420
،اسمعا كلاكما! في الحقيقة
...لديّ 8000 رجل تحت إمرتي

192
00:17:10,420 --> 00:17:12,860
أعني تحت إمرة صديقي
!المقرّب أوسوبّ-كُن

193
00:17:12,860 --> 00:17:15,730
.لـ-لذلك، فإنّ هذه الجزيرة محاصرة سلفًا

194
00:17:15,730 --> 00:17:18,320
!أوقفا مقاومتكما العقيمة واستسلما

195
00:17:19,660 --> 00:17:22,930
أقال 8000؟ سيكون قتلهم
.من دواعي سروري

196
00:17:22,930 --> 00:17:24,990
.أسرع واستدعهم إلى هنا

197
00:17:25,350 --> 00:17:28,710
.لا تكن سخيفًا. واضح أنّه يكذب

198
00:17:28,710 --> 00:17:31,650
لا أصدّق أنّك وقعت ضحيّة كذبة
...واضحة كهذه بسهولة

199
00:17:31,650 --> 00:17:34,490
.أنت عار على سي بي 9

200
00:17:34,490 --> 00:17:38,590
،من الأبله هنا؟ أنا أعلم أنّها كذبة
.كنت أسخر منه فحسب

201
00:17:39,000 --> 00:17:42,800
لا أطيق كم أنّك صريح بشكل
.مبالغ وجادّ بشكل لا يُتصوّر

202
00:17:42,800 --> 00:17:45,500
ما الخطب في كون المرء جادًّا وصريحًا؟

203
00:17:45,500 --> 00:17:49,180
بل إنّ كونها بشكل مبالغ ولا يُتصوّر
!هو الجانب السّيّئ أيّها المغفّل

204
00:17:52,670 --> 00:17:54,930
...نجحت خطّتي. أجل

205
00:17:56,100 --> 00:17:58,130
...حسنًا الآن

206
00:17:58,130 --> 00:18:00,530
...نداء الدّمار" وشيك لا محالة"

207
00:18:00,530 --> 00:18:01,490
!كلاّ

208
00:18:01,490 --> 00:18:04,520
...وقد أضعنا الكثير من الوقت

209
00:18:04,520 --> 00:18:06,450
...لنقاتل كلانا بجدّيّة

210
00:18:07,320 --> 00:18:09,360
وننهِ هذا الأمر، صحيح؟

211
00:18:07,320 --> 00:18:09,360
وننهِ هذا الأمر، أليس كذلك؟

212
00:18:09,360 --> 00:18:12,110
!ماذا؟ مـ-مهلاً لحظة. اهدآ

213
00:18:12,110 --> 00:18:13,080
!نحن هادئان

214
00:18:14,670 --> 00:18:15,750
!ساق العاصفة

215
00:18:19,350 --> 00:18:20,620
!هذا سيّئ

216
00:18:23,680 --> 00:18:24,130
!احمله

217
00:18:24,130 --> 00:18:24,630
!حاضر

218
00:18:24,630 --> 00:18:26,840
!مسدّس الإصبع

219
00:18:30,700 --> 00:18:33,360
.يبدو أنّ وقت اللّعب انتهى
.لا ترخِ دفاعاتك

220
00:18:33,360 --> 00:18:34,560
...كلاّ

221
00:18:35,310 --> 00:18:35,850
!انتقال آنيّ

222
00:18:38,400 --> 00:18:40,010
...هذا مؤلم

223
00:18:40,940 --> 00:18:44,280
.هذا سيّئ. إنّهما متحمّسان كثيرًا

224
00:18:44,280 --> 00:18:46,330
.من الأفضل أن نسرع وخلع هذه

225
00:18:46,330 --> 00:18:48,990
!تشوبّر! تعال بسرعة

226
00:18:49,990 --> 00:18:52,320
!ما هذا الوحش؟

227
00:18:53,170 --> 00:18:56,810
كان هنالك آكل فاكهة شيطان
!آخر من نوع زون؟

228
00:18:56,810 --> 00:18:59,300
!هل يعني هذا أنّه مع السّي بي 9 أيضًا؟

229
00:18:59,300 --> 00:19:01,460
.بالتّفكير في الأمر، أشعر أنّني رأيته من قبل

230
00:19:03,420 --> 00:19:05,130
!تـ-تشوبّر؟

231
00:19:10,630 --> 00:19:12,930
!ما الّذي تفعله يا تشوبّر؟! هذا نحن

232
00:19:12,930 --> 00:19:14,680
!كلاّ! توقّف

233
00:19:16,890 --> 00:19:20,610
!هل هذا هو تشوبّر بالفعل؟
!كيف لا يتعرّف إلينا؟

234
00:19:20,690 --> 00:19:24,990
!لا أدري، لكن لا بدّ أنّه تشوبّر
!من غيره لديه تلك القرون والقبّعة؟

235
00:19:25,770 --> 00:19:28,710
!إذًا ماذا عن أملنا والمفتاح رقم 2؟

236
00:19:28,710 --> 00:19:32,080
.لا أدري. هذه النّهاية! سوف نموت

237
00:19:32,080 --> 00:19:34,410
.لكن هنالك أمر ليس في محلّه

238
00:19:35,570 --> 00:19:38,870
!أليس هو من يبدو أنّه يوشك على الموت؟

239
00:19:39,260 --> 00:19:42,170
.يبدو وكأنّ حيويّته تخفت بسرعة

240
00:19:42,170 --> 00:19:45,080
ما-ما-ما معنى ذلك؟

241
00:19:45,080 --> 00:19:49,510
ربّما يكون بقاؤه في تلك الهيئة
.يستنزف طاقة كثيرة أو ما شابه

242
00:19:49,510 --> 00:19:53,360
ماذا؟! ما الّذي سنفعله حياله
!وحيال الآخرَين؟

243
00:19:53,360 --> 00:19:56,700
وما الّذي سيحدث للمفتاح؟
المفتاح رقم 2؟

244
00:19:56,700 --> 00:19:59,550
،لا أدري ما الّذي حدث

245
00:19:59,550 --> 00:20:03,090
...لكن لا بدّ أنّه قاتل بشدّة

246
00:20:03,900 --> 00:20:06,110
.إلى درجة أنّه تحوّل إلى هذا

247
00:20:06,110 --> 00:20:06,860
...الرّقم 2

248
00:20:12,260 --> 00:20:16,070
تمّت مقاطعتنا. ما ذلك الوحش؟

249
00:20:16,070 --> 00:20:18,500
...يحدث هذا و"نداء الدّمار" وشيك

250
00:20:18,500 --> 00:20:21,790
طبعًا سيقاطعنا. يبدو أنّه واحد
.من أولئك القراصنة

251
00:20:22,870 --> 00:20:24,290
...إنّ أيّ شيء يعترض طريقنا

252
00:20:24,290 --> 00:20:25,830
.يجب القضاء عليه

253
00:20:28,990 --> 00:20:30,370
...مع أنّه ليس بشيء يذكر

254
00:20:30,370 --> 00:20:32,140
.إلاّ أنّ لدينا فريسة أخرى الآن

255
00:20:33,280 --> 00:20:35,720
!سُحقًا! سوف يهاجمان تشوبّر

256
00:20:35,720 --> 00:20:38,400
افرد ظهرك أيّها السّيف
.العظيم أنف العاصفة

257
00:20:38,400 --> 00:20:40,850
!مـ-مهلاً! ما الّذي ستفعله؟

258
00:20:40,850 --> 00:20:43,360
!مدفع العنقاء ذو السّتّة والثّلاثين رطلاً

259
00:20:46,400 --> 00:20:47,150
!أيّها الوغد

260
00:20:48,150 --> 00:20:49,530
!ابتعدا كلاكما

261
00:20:50,110 --> 00:20:51,360
!...إنّه

262
00:20:51,360 --> 00:20:53,780
!فرانكي! ما الّذي تحاول فعله؟

263
00:20:53,780 --> 00:20:54,990
...إنّه واحد منّا

264
00:20:54,990 --> 00:20:57,040
.أعلم ذلك! اصمت فحسب

265
00:21:01,230 --> 00:21:03,920
هذه هي الطّريقة الوحيدة
.الّتي تخطر على بالي للتّعامل معه

266
00:21:03,920 --> 00:21:06,040
...إنّ لمستعملي القدرات نقطة ضعف

267
00:21:06,040 --> 00:21:08,300
.سأدفعه إلى البحر

268
00:21:08,300 --> 00:21:10,510
!سأتساهل معك، لذلك تحمّل قليلاً

269
00:21:12,530 --> 00:21:14,680
...مدفع

270
00:21:15,890 --> 00:21:16,810
!الرّياح

271
00:21:27,050 --> 00:21:30,060
!أيّها الوغد فرانكي! كان هذا متهوّرًا

272
00:21:30,060 --> 00:21:32,400
!ما الّذي تفعله لصديقنا؟

273
00:21:33,170 --> 00:21:36,450
.لا تقلق. سبق وناقش هذا معي

274
00:21:50,490 --> 00:21:54,510
ما الّذي يفعلونه بمهاجمة واحد منهم؟

275
00:21:54,510 --> 00:21:57,180
.إنّهم في فوضى عارمة بالفعل

276
00:22:06,160 --> 00:22:07,730
تحرّرتما أخيرًا؟

277
00:22:11,530 --> 00:22:14,110
من الأفضل أن تكفّوا
.عن الضّحك وتبدؤوا بالنّدم

278
00:22:14,700 --> 00:22:16,570
...لن تحظوا أبدًا

279
00:22:17,400 --> 00:22:22,110
بفرصة ثانية كالتي حظيتم بها
...قبل قليل لقتلي

280
00:22:23,650 --> 00:22:25,380
!يا حكومة العالم

281
00:22:32,420 --> 00:22:35,570
لماذا لا تهرب كما فعلت سابقًا
!أيّها المقنّع الغبيّ؟

282
00:22:35,570 --> 00:22:37,510
!أرجوك! لا تقتل أوسوبّ

283
00:22:37,510 --> 00:22:40,350
!غبيّة! ستموتين بعده

284
00:22:40,350 --> 00:22:41,410
!والآن، هذه نهايتك

285
00:22:41,410 --> 00:22:42,490
!كلاّ

286
00:22:43,480 --> 00:22:44,100
...مستحيل

287
00:22:44,100 --> 00:22:46,020
!من أنت يا هذا؟

288
00:22:46,020 --> 00:22:47,180
:في الحلقة القادمة من وان بيس

289
00:22:47,180 --> 00:22:50,860
ظهور الصّيّاد سانجي؟"
".مرثاة على ذئب كاذب

290
00:22:50,860 --> 00:22:53,110
!ملك القراصنة، لن يكون إلاّ أنا

291
00:22:55,990 --> 00:23:00,990
نلقاكم في الحلقة القادمة