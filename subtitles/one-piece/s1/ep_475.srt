1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,910 --> 00:03:22,980
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:22,980 --> 00:03:27,230
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:28,010 --> 00:03:30,590
يحاول لوفي وقراصنة اللّحية البيضاء
،للوصول إلى المنصّة

40
00:03:30,850 --> 00:03:35,060
!لكن تمّت محاصرتهم

41
00:03:35,680 --> 00:03:39,080
لكن بمساعدة جينبي، تمكّن
لوفي من تجاوز الجدار

42
00:03:39,460 --> 00:03:41,750
!ووصل إلى السّاحة أخيرًا

43
00:03:42,900 --> 00:03:43,680
!لوفي

44
00:03:44,050 --> 00:03:45,310
!أنا قادم

45
00:03:46,780 --> 00:03:49,600
!إيس

46
00:03:54,370 --> 00:03:55,390
!ما-ما هذا؟

47
00:04:04,950 --> 00:04:06,310
!نحن محاصرون

48
00:04:06,630 --> 00:04:08,290
!ما هذا؟

49
00:04:10,140 --> 00:04:12,160
!ابدأ يا أكاينو

50
00:04:16,280 --> 00:04:18,120
!بركان الشّهب

51
00:04:27,910 --> 00:04:30,260
!إنّه يطلق حممًا نحو السّماء

52
00:04:32,870 --> 00:04:34,570
!لا يمكنهم الهرب

53
00:04:35,250 --> 00:04:38,350
!أذب الجليد الّذي يقفون عليه

54
00:05:01,570 --> 00:05:03,390
...أنا آسف

55
00:05:04,030 --> 00:05:05,780
!تسير الخطّة كما يجب

56
00:05:06,160 --> 00:05:07,880
...لننتقل الآن إلى

57
00:05:07,880 --> 00:05:11,270
...إعدام بورتغاس د. إيس

58
00:05:12,110 --> 00:05:13,590
!في الحال

59
00:05:18,080 --> 00:05:19,060
!جينبي

60
00:05:20,410 --> 00:05:23,860
!أريدك أن تسديني خدمة

61
00:05:23,860 --> 00:05:28,890
!رمية كتف تيّار المحيط

62
00:05:32,400 --> 00:05:35,030
!عجبًا! وصلتَ أخيرًا

63
00:05:35,720 --> 00:05:39,630
!ما زلت واقفًا على قدميك يا ابن دراغون

64
00:05:39,700 --> 00:05:43,750
!إنّ شبابه أخافني

65
00:05:43,760 --> 00:05:50,420
!سأستعيد إيس

66
00:05:55,280 --> 00:05:57,390
...فاكهة المطّاط

67
00:05:57,390 --> 00:06:00,930
!مدفع الطّابع الرّشّاش

68
00:06:17,380 --> 00:06:22,030
!الانتقال للمرحلة الأخيرة"
"!خطّة اللّحية البيضاء لقلب الموازين

69
00:06:39,480 --> 00:06:44,010
لا أصدّق أنّه يهاجم ثلاثة أميرالات
!بشكل مباشر هكذا

70
00:06:44,010 --> 00:06:47,470
!واضح أنّه مغفّل! سيقتلونه

71
00:06:53,710 --> 00:06:55,360
!المستوى الثّاني

72
00:06:59,340 --> 00:07:02,500
!لا وقت لديّ لمقاتلة هؤلاء

73
00:07:03,790 --> 00:07:05,960
!لقد خدَعنا

74
00:07:12,570 --> 00:07:14,430
!أنت بطيء

75
00:07:25,920 --> 00:07:27,420
!لوفي-سان

76
00:07:27,850 --> 00:07:29,520
!هذا ما خشيته

77
00:07:38,950 --> 00:07:40,200
!سُحقًا

78
00:07:52,720 --> 00:07:53,880
!استعدّا

79
00:07:54,200 --> 00:07:54,960
!حاضر

80
00:08:00,750 --> 00:08:01,650
!ابدآ

81
00:08:06,290 --> 00:08:07,570
!إيس

82
00:08:07,750 --> 00:08:09,020
!إيس-سان

83
00:08:09,190 --> 00:08:11,060
!إيس

84
00:08:31,840 --> 00:08:35,720
!إيس

85
00:09:04,620 --> 00:09:05,730
!من كان الفاعل؟

86
00:09:14,280 --> 00:09:15,880
!أيّها الوغد

87
00:09:17,300 --> 00:09:20,240
ظننتُ أنّ تواجدك هنا سيكون لمصلحتنا

88
00:09:20,240 --> 00:09:23,280
.بما أنّك تكنّ ضغينة تجاه اللّحية البيضاء

89
00:09:24,570 --> 00:09:26,350
!كروكودايل

90
00:09:30,840 --> 00:09:31,780
!...يا له من

91
00:09:34,100 --> 00:09:37,230
.ماذا؟ ظننتُ أنّ هذه لحظتي لأتألّق-يوي

92
00:09:37,950 --> 00:09:41,520
.كان يحاول قتل العجوز من قبل

93
00:09:41,520 --> 00:09:44,210
!أرى أنّ الرّياح تهبّ لصالحنا

94
00:09:48,400 --> 00:09:53,220
.بإمكاني قتل ذلك العجوز الخرِف المحتضر لاحقًا

95
00:09:54,930 --> 00:09:56,330
،لكن قبل ذلك

96
00:09:57,100 --> 00:10:01,300
!لا أريد أن أسمح لكم بتذوّق النّصر

97
00:10:14,190 --> 00:10:16,610
!مهلاً، مهلاً أيّها التّمساح

98
00:10:17,010 --> 00:10:18,500
!د-دوفلامينغو

99
00:10:18,900 --> 00:10:22,360
،رفضت عرضي قبل قليل
والآن تريد التّحالف مع اللّحية البيضاء؟

100
00:10:27,230 --> 00:10:29,970
.يدفعني ذلك للشّعور بالغيرة

101
00:10:34,260 --> 00:10:37,120
.لن أتحالف مع أيّ أحد

102
00:10:37,690 --> 00:10:42,170
.هذا يعني أنّك ما زلت تدير ظهرك لي

103
00:10:42,920 --> 00:10:44,280
.ذلك ما يبدو

104
00:11:02,270 --> 00:11:05,830
!لا أدري ما الغاية من كلّ هذا، لكنّه أنقذني

105
00:11:06,160 --> 00:11:08,740
!هذه نهايتك يا قبّعة القشّ

106
00:11:09,420 --> 00:11:10,610
!مت

107
00:11:21,600 --> 00:11:23,330
...لا تقفوا أبدًا

108
00:11:24,340 --> 00:11:26,720
!في طريقي

109
00:11:35,930 --> 00:11:37,720
!توقّف يا قبّعة القشّ

110
00:11:38,210 --> 00:11:39,940
!لن أسمح لك بالتّقدّم أكثر

111
00:11:40,130 --> 00:11:40,940
!ابتعد

112
00:11:40,940 --> 00:11:41,740
!انتقال

113
00:11:42,910 --> 00:11:43,770
!مشية القمر

114
00:11:45,700 --> 00:11:47,230
...الجسد الحديديّ

115
00:11:47,230 --> 00:11:48,040
!سحق

116
00:11:54,870 --> 00:11:56,290
...فاكهة المطّاط

117
00:11:56,290 --> 00:11:57,570
!الجسد الحديديّ

118
00:11:57,900 --> 00:11:59,550
!الرّصاصة

119
00:12:06,900 --> 00:12:09,000
!أوقفوا قبّعة القشّ

120
00:12:09,010 --> 00:12:10,960
!لا تسمحوا له بالتّقدّم أكثر

121
00:12:13,200 --> 00:12:14,520
!الأميرال ساكازوكي

122
00:12:27,660 --> 00:12:30,810
!هذا مؤلم! سُحقًا

123
00:12:31,210 --> 00:12:34,180
أدين بخدمة لجدّك

124
00:12:34,820 --> 00:12:36,820
!لكن لا خيار لديّ

125
00:12:36,970 --> 00:12:40,300
!فقد اخترتَ المخاطرة بحياتك

126
00:12:40,430 --> 00:12:43,460
...أيّها المغفّل! لن أسمح لك بفعل ذلك بلوفي

127
00:12:53,790 --> 00:12:54,830
!أيّها الأميرال

128
00:12:55,600 --> 00:12:56,640
!...ذلك

129
00:12:58,950 --> 00:13:01,750
!قائد الوحدة الأولى ماركو

130
00:13:05,300 --> 00:13:06,980
!شكرًا لك! أنقذت حياتي

131
00:13:07,940 --> 00:13:09,600
!على الرّحب والسّعة-يوي

132
00:13:13,610 --> 00:13:16,160
!لدينا ثلاثة متعدّين في السّاحة

133
00:13:16,500 --> 00:13:19,590
!بإمكان آكلي فاكهة الشّيطان تجاوز الجدار

134
00:13:21,260 --> 00:13:23,170
ثـ... ثلاثة؟

135
00:13:23,610 --> 00:13:28,210
هـ-هل أنا واحد من الثّلاثة الّذين يتحدّثون عنهم؟

136
00:13:28,590 --> 00:13:31,970
!لكن متى اكتشفوا أمري؟

137
00:13:32,540 --> 00:13:35,900
بالكاد هربت من هجوم الأميرال أوكيجي

138
00:13:36,270 --> 00:13:39,010
!ونجوت من عدّة أزمات

139
00:13:39,230 --> 00:13:41,610
!ووصلت أخيرًا إلى هنا

140
00:13:42,600 --> 00:13:45,500
!لكنّني لست آمنًا هنا أيضًا

141
00:13:45,500 --> 00:13:48,660
!ألا يوجد أيّ مكان آمن؟

142
00:13:51,280 --> 00:13:52,290
!أحدهم قادم

143
00:13:58,380 --> 00:13:59,570
...لقد كانوا

144
00:14:06,330 --> 00:14:09,510
!اعبروا البحر نحو أورز

145
00:14:10,170 --> 00:14:13,810
!اذهبوا للسّاحة مهما كلّف الأمر

146
00:14:17,860 --> 00:14:19,390
!يا أميرال الأسطول

147
00:14:19,880 --> 00:14:23,100
!يتصرّف القراصنة داخل الخليج بغرابة

148
00:14:58,340 --> 00:15:02,060
!اعبروا البحر نحو أورز

149
00:15:02,790 --> 00:15:07,140
!اذهبوا للسّاحة مهما كلّف الأمر

150
00:15:07,980 --> 00:15:10,220
.إنّهم يائسون

151
00:15:10,710 --> 00:15:12,550
!احموا الثّغرة المفتوحة في الجدار

152
00:15:12,550 --> 00:15:13,400
!حاضر

153
00:15:17,720 --> 00:15:21,010
فقدوا رشدهم بعد خسارتهم لسفنهم
والجليد الّذي يقفون عليه

154
00:15:21,010 --> 00:15:22,810
!يا لهم من قراصنة أغبياء

155
00:15:23,180 --> 00:15:25,450
!إنّهم أهداف سهلة لنا! أطلقوا

156
00:15:50,970 --> 00:15:54,400
!لا تتردّدوا! واصلوا التّقدّم

157
00:15:55,650 --> 00:15:58,380
!اتّجهوا نحو أورز

158
00:16:03,580 --> 00:16:05,390
!اذهبوا للسّاحة

159
00:16:06,440 --> 00:16:08,700
ما-ما خطبهم؟

160
00:16:08,700 --> 00:16:11,250
كيف لهم أن يحافظوا على معنويّاتهم
!في وضع كهذا؟

161
00:16:11,650 --> 00:16:13,760
!تقدّموا

162
00:17:15,980 --> 00:17:19,200
!ليصعد الجميع

163
00:17:21,280 --> 00:17:23,320
!تمسّكوا جيّدًا

164
00:17:23,640 --> 00:17:25,850
!كـ-كلاّ! إنّها سفينة

165
00:17:26,750 --> 00:17:31,200
!لدينا مشكلة! دخلت سفينة مغلّفة أخرى الخليج

166
00:17:35,970 --> 00:17:39,090
سُحقًا! لا بدّ أنّها كانت مخبّأة
!في قاع البحر كلّ هذا الوقت

167
00:17:59,840 --> 00:18:04,120
.لا أذكر أنّني قلتُ أنّ تلك كانت كلّ سفننا

168
00:18:11,410 --> 00:18:15,210
إنّها سفينة بمجاديف وهي قادمة
!نحونا بكلّ سرعتها

169
00:18:15,980 --> 00:18:17,000
!ماذا؟

170
00:18:20,370 --> 00:18:23,390
!أغرقوها كما أغرقتم موبي ديك

171
00:18:36,890 --> 00:18:40,780
!كلاّ! ليس السّفينة! بل أطلقوا على أورز

172
00:18:41,050 --> 00:18:42,820
!ماذا؟ أورز؟

173
00:18:43,680 --> 00:18:45,320
!فات الأوان الآن

174
00:18:45,650 --> 00:18:47,700
!استعدّوا جميعًا

175
00:19:08,450 --> 00:19:11,500
!لقد أخرج السّفينة من المياه

176
00:19:11,810 --> 00:19:14,950
!لقد حطّموا الجدران المطوّقة بأكملها

177
00:19:24,320 --> 00:19:26,370
!وصلنا إلى السّاحة

178
00:19:27,660 --> 00:19:30,320
!لننقذ إيس

179
00:19:30,790 --> 00:19:33,330
!لنحرق مقرّ البحرية عن بكرة أبيه

180
00:19:33,930 --> 00:19:37,210
!انتظرنا يا إيس

181
00:19:38,180 --> 00:19:39,850
!نالوا منّا

182
00:19:39,850 --> 00:19:42,350
!كانت مجرّد ثغرة بحجم جُحر جرذ

183
00:19:42,800 --> 00:19:45,210
!لكنّهم استغلّوها بدهاء

184
00:19:46,040 --> 00:19:49,940
!قد تصير الجدران عائقًا لنا هذه المرّة

185
00:19:51,020 --> 00:19:53,690
!يا والدي

186
00:19:53,950 --> 00:19:55,450
!اللّحية البيضاء

187
00:19:56,570 --> 00:20:00,660
!ما زال رأسك بين كتفيك، صحيح يا إيس؟

188
00:20:03,780 --> 00:20:05,680
!نجحنا

189
00:20:06,710 --> 00:20:11,750
...بإمكاننا إنقاذ إيس-كُن

190
00:20:15,210 --> 00:20:16,460
!أورز

191
00:20:22,650 --> 00:20:26,890
...أنقذوا إيس-كُن مهما كلّف

192
00:20:45,460 --> 00:20:46,810
...أورز

193
00:21:34,800 --> 00:21:38,010
!نزل اللّحية البيضاء إلى السّاحة

194
00:21:44,400 --> 00:21:48,080
!تراجعوا يا أبنائي

195
00:22:21,250 --> 00:22:25,160
...يا رجال! أنقذوا إيس

196
00:22:25,580 --> 00:22:29,720
!ودمّروا البحريّة

197
00:22:36,350 --> 00:22:37,670
.غارب

198
00:22:38,180 --> 00:22:39,170
.نعم

199
00:22:43,660 --> 00:22:48,530
!لا أظنّ أنّ بإمكاننا النّجاة سالمين من هذا

200
00:22:59,040 --> 00:23:02,130
!أنا قادم يا إيس

201
00:23:11,380 --> 00:23:14,050
