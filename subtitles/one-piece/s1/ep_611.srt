1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,310 --> 00:02:52,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,730 --> 00:02:57,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:03:00,070 --> 00:03:06,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:03:07,410 --> 00:03:12,460
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:14,210 --> 00:03:20,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,680 --> 00:03:22,390
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:22,930 --> 00:03:26,640
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:29,690 --> 00:03:32,190
،بعد نجاتهم من معركة حامية

37
00:03:32,190 --> 00:03:35,010
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:35,010 --> 00:03:37,190
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:38,030 --> 00:03:41,940
،رسوا في بانك هازارد، جزيرة من جزأين
.أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:42,360 --> 00:03:46,410
،بعد اكتشافهم لدافع للسّيّد سيزار كلاون حاكم الجزيرة

41
00:03:46,410 --> 00:03:52,840
وبينما يحاولون الهرب من شينوكوني إلى جانب
،حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

42
00:03:52,840 --> 00:03:55,960
،هم في طريقهم الآن لاختطاف سيزار

43
00:03:55,960 --> 00:03:59,000
.وإنقاذ الأطفال والهرب من الجزيرة

44
00:03:59,540 --> 00:04:01,260
أقلت شيئًا ما؟

45
00:04:01,640 --> 00:04:02,930
!من تكون؟

46
00:04:06,490 --> 00:04:08,890
!من تكون أنت؟

47
00:04:11,160 --> 00:04:14,770
"!تنّين صغير! ظهور مومونوسكي"

48
00:04:29,480 --> 00:04:30,990
مومونوسكي؟

49
00:04:30,160 --> 00:04:34,830
"مكبّ نفايات في قبو المبنى "س
— جانب لوفي —

50
00:04:30,990 --> 00:04:33,100
.ذاك هو اسمي

51
00:04:34,830 --> 00:04:37,400
.سمعتُ ذلك الاسم من قبل

52
00:04:37,400 --> 00:04:39,020
أين يا ترى؟

53
00:04:39,020 --> 00:04:39,960
أنّى لي أن أعلم؟

54
00:04:39,960 --> 00:04:41,390
.لا بدّ أنّه شخص آخر

55
00:04:41,390 --> 00:04:43,580
...الأهمّ الآن، عليك

56
00:04:48,600 --> 00:04:50,970
!أن توقف سيلان لعابك

57
00:04:52,100 --> 00:04:55,310
!لا يمكنك أكلي

58
00:04:55,310 --> 00:04:57,600
!سآكلك أوّلاً إن حاولت أكلي

59
00:04:58,080 --> 00:04:59,920
!أحسن التّصرّف

60
00:04:58,400 --> 00:05:02,570
(مومونوسكي (تنّين

61
00:05:04,910 --> 00:05:05,580
ماذا؟

62
00:05:05,580 --> 00:05:08,470
ربّما يكون مومونوسكي عالقًا على التّنّين

63
00:05:08,470 --> 00:05:10,190
...ويتحدّث بضرطاته

64
00:05:10,190 --> 00:05:12,400
!أتسمعني؟ أين أنت؟

65
00:05:12,400 --> 00:05:14,370
!ما الّذي تفعله؟

66
00:05:15,250 --> 00:05:16,370
!ها نحن أولاء

67
00:05:19,530 --> 00:05:21,800
!انقسم إلى نصفين! أنا آسف

68
00:05:22,990 --> 00:05:25,260
!انفصلت عنه أخيرًا-بو

69
00:05:26,390 --> 00:05:28,300
!أنا لا أتكلّم بضرطاتي

70
00:05:28,300 --> 00:05:29,680
!كم هذا وقح

71
00:05:29,680 --> 00:05:31,890
!عمّ تتحدّث؟

72
00:05:31,890 --> 00:05:35,840
بالتّفكير في الأمر، كان ذلك التّنّين أكبر

73
00:05:35,840 --> 00:05:38,010
.وسبق وأكلناه

74
00:05:38,010 --> 00:05:39,270
من تكون إذًا؟

75
00:05:39,600 --> 00:05:40,910
!ماذا؟

76
00:05:40,910 --> 00:05:43,580
!ثمّة أنقليس يُكلّمني؟

77
00:05:44,820 --> 00:05:46,900
!أوقف سيلان لعابك

78
00:05:46,900 --> 00:05:48,940
!أنا لستُ أنقليسًا

79
00:05:53,120 --> 00:05:55,830
تتضوّر جوعًا أيضًا، صحيح؟

80
00:05:56,390 --> 00:05:58,100
.ما هذه السّخافة

81
00:05:58,930 --> 00:06:03,600
لا يشعر محاربو السّاموراي بالجوع
.بعد عشرة أيّام فقط بلا طعام

82
00:06:05,550 --> 00:06:06,980
!عشرة أيّام؟

83
00:06:09,700 --> 00:06:12,680
من تكون ولماذا أنت هنا؟

84
00:06:13,420 --> 00:06:14,980
.أنا لوفي

85
00:06:14,980 --> 00:06:17,020
!أنّا الرّجل الّذي سيصير ملك القراصنة

86
00:06:17,020 --> 00:06:19,020
...قـ-قـ-قـ-قـ

87
00:06:19,540 --> 00:06:20,570
...قـ

88
00:06:23,810 --> 00:06:25,450
.لا بدّ أنّك تكذب

89
00:06:27,290 --> 00:06:30,810
.القراصنة رجال ضخام البنية

90
00:06:30,810 --> 00:06:34,200
.إنّهم أكثر عنفًا وأقوى

91
00:06:34,200 --> 00:06:38,780
...على أيّ حال أيّها الأنقليس، كيف أستطيع

92
00:06:38,780 --> 00:06:39,870
!اسمي مومونوسكي

93
00:06:42,440 --> 00:06:45,090
أنت من مكان آخر أيضًا، صحيح؟

94
00:06:47,470 --> 00:06:52,170
كلّ ما أعرفه هو أنّ هنالك الكثير
.من الأطفال المرضى هنا

95
00:06:54,020 --> 00:06:59,690
.لا أعرف حتّى طبيعة هذه الجزيرة ما حصل لي

96
00:07:01,080 --> 00:07:05,730
.وأصلُ الأمر يعود إلى وقت تسلّلي إلى سفينة

97
00:07:07,580 --> 00:07:11,410
،حاولت أن أكون فظًّا قدر المستطاع

98
00:07:11,760 --> 00:07:15,120
.لكنّ أولئك الأطفال كانوا طيّبين معي

99
00:07:17,490 --> 00:07:19,060
.إنّهم يوزّعون الطّعام

100
00:07:19,060 --> 00:07:20,290
هل أنت جائع؟

101
00:07:20,290 --> 00:07:22,370
!اخرسي! لا أريد أيّ طعام

102
00:07:25,210 --> 00:07:27,520
!أنا ساموراي

103
00:07:27,520 --> 00:07:29,980
!أنا لا أقبل الصّدقة

104
00:07:32,300 --> 00:07:36,140
...كانوا لطفاء معي، ولكنّ مزاجي كان معكّرًا حينها

105
00:07:36,570 --> 00:07:38,470
.أحضرت لك بعض الطّعام

106
00:07:38,820 --> 00:07:41,070
!قلت أنّي لا أريد طعامًا

107
00:07:42,140 --> 00:07:44,020
.من الأفضل أن تأكل شيئًا

108
00:07:44,020 --> 00:07:46,190
،فُصلنا جميعًا عن والدينا
...لذلك علينا أن نتكاتف معًا

109
00:07:46,570 --> 00:07:49,780
!لا يفهم أيّ أحد ما أشعر به

110
00:07:56,160 --> 00:07:59,620
غرفة البسكويت

111
00:08:00,190 --> 00:08:03,280
!أنا "السّيّد" سيزار

112
00:08:03,280 --> 00:08:05,210
!تفضّلوا

113
00:08:05,210 --> 00:08:08,820
!هذا ملعبكم من اليوم

114
00:08:10,270 --> 00:08:12,230
!ثمّة العديد من الأطفال العمالقة

115
00:08:12,230 --> 00:08:14,050
أهم مرضى أيضًا؟

116
00:08:14,320 --> 00:08:17,570
!يمكنكم الاعتماد عليّ

117
00:08:17,570 --> 00:08:21,600
!سأعالجكم جميعًا بأيّ ثمن كان

118
00:08:21,600 --> 00:08:23,080
!مرحبًا

119
00:08:23,080 --> 00:08:25,430
!جميعنا أصدقاء ابتداءً من اليوم

120
00:08:25,430 --> 00:08:26,700
!شكرًا لك

121
00:08:27,650 --> 00:08:28,970
ماذا عنك؟

122
00:08:28,970 --> 00:08:29,940
ما اسمك؟

123
00:08:30,650 --> 00:08:33,450
.لا اسم لديّ

124
00:08:37,150 --> 00:08:38,490
.تفضّل

125
00:08:38,910 --> 00:08:40,950
.إليك بعض الشّكولاطة

126
00:08:42,190 --> 00:08:43,000
!لا أريد

127
00:08:43,470 --> 00:08:44,370
حلوى؟

128
00:08:44,600 --> 00:08:45,500
!لا أريد

129
00:08:52,130 --> 00:08:55,590
بعد بضعة أيّام

130
00:08:55,830 --> 00:08:58,760
أنت، هل صحيح أنّ أحد الأطفال قد هرب؟

131
00:08:59,110 --> 00:09:02,870
.نعم، لكنّ كلّ من على لائحة ركوب السّفينة موجود

132
00:09:02,870 --> 00:09:03,770
.هذا غريب

133
00:09:03,770 --> 00:09:06,480
.في كلّ الأحوال، لننفصل ونبحث عنه

134
00:09:20,970 --> 00:09:23,370
كيف أستطيع الخروج من هنا؟

135
00:10:35,300 --> 00:10:36,370
!أيّها الفتى

136
00:10:38,090 --> 00:10:40,810
.كنتَ على نفس السّفينة معي

137
00:10:40,810 --> 00:10:42,030
هل تتذكّرني؟

138
00:10:45,370 --> 00:10:48,550
.فعلاً؟ اسمك مومونوسكي-كُن إذًا

139
00:10:49,250 --> 00:10:52,700
.هذه "الغرفة السّرّيّة" وهي محظورة على الجميع

140
00:10:52,700 --> 00:10:56,800
.أنت مزعجة جدًّا. لا تتورّطي معي

141
00:10:57,180 --> 00:10:58,610
لماذا؟

142
00:10:58,610 --> 00:10:59,620
...لأنّ

143
00:11:00,680 --> 00:11:02,690
!لا يوجد سبب

144
00:11:02,690 --> 00:11:06,230
.أنا أبحث عن المخرج فحسب. سأخرج من هنا

145
00:11:06,230 --> 00:11:08,510
.ثمّة أمر عليّ فعله

146
00:11:08,510 --> 00:11:13,110
أعلم أنّ الأمر صعب، لكنّ كلّ الأطفال
.هنا يمرّون بنفس الوضع

147
00:11:15,090 --> 00:11:19,280
يريد الجميع رؤية آبائهم وأمّهاتهم
.في أسرع وقت ممكن

148
00:11:21,490 --> 00:11:26,660
أتينا جميعنا إلى هنا من جُزر مختلفة
.لنُعالج، لكن يتشارك الجميع نفس الشّعور

149
00:11:27,990 --> 00:11:32,620
ثمّة أشياء عديدة أريد القيام بها
!إن استطعت العودة للمنزل

150
00:11:32,970 --> 00:11:37,000
الجميع لطفاء في غرفة البسكويت
.ونستمتع بوقنا هناك

151
00:11:37,000 --> 00:11:39,070
.بإمكانك نسيان الألم

152
00:11:39,070 --> 00:11:43,170
!لذلك لماذا لا تأكل شيئًا ما يا مومونوسكي-كُن؟

153
00:11:43,170 --> 00:11:44,590
...حسنًا، ولكن

154
00:11:47,090 --> 00:11:47,990
ماذا؟

155
00:11:47,990 --> 00:11:48,810
ما الخطب؟

156
00:11:48,810 --> 00:11:50,600
!كلاّ، أحدهم قادم

157
00:11:51,280 --> 00:11:52,890
!هيّا بنا يا مومونوسكي-كُن

158
00:11:57,370 --> 00:11:59,690
!باب الغرفة السّرّيّة مفتوح

159
00:12:00,790 --> 00:12:01,530
!بسرعة

160
00:12:02,410 --> 00:12:05,200
!لا تقلقي حيالي! اذهبي فحسب

161
00:12:24,170 --> 00:12:25,340
!هل من أحد هنا؟

162
00:12:28,390 --> 00:12:30,030
!ما-ما هذا؟

163
00:12:30,030 --> 00:12:30,680
!من هناك؟

164
00:12:44,070 --> 00:12:45,570
!تـ-تنّين؟

165
00:12:52,490 --> 00:12:53,960
ما الّذي يحدث؟

166
00:12:53,960 --> 00:12:55,080
.لا أدري

167
00:12:57,560 --> 00:13:00,500
...مـ-مومونوسكي-كُن

168
00:13:06,530 --> 00:13:07,580
!انظر

169
00:13:07,580 --> 00:13:12,690
إن لم تخنّي الذّاكرة، فقد كانت هنا
.فاكهة الشّيطان اصطناعيّة صنعها فيغابانك

170
00:13:12,690 --> 00:13:14,950
.سمعتُ أنّها كانت فاشلة

171
00:13:14,950 --> 00:13:17,060
.نعم، سمعت ذلك أيضًا

172
00:13:24,980 --> 00:13:29,900
ظننتُ أنّ قلبي سينفجر بعد ذلك الألم
!الّذي أحسست به فجأة في صدري

173
00:13:30,340 --> 00:13:33,790
.واجهت مشاكل في الهرب من قبل

174
00:13:34,170 --> 00:13:35,200
...ما الّذي

175
00:14:10,470 --> 00:14:14,030
.لذلك أنا بشريّ في الأصل

176
00:14:16,810 --> 00:14:19,500
أكلت فاكهة شيطان إذًا؟

177
00:14:19,980 --> 00:14:21,610
وقد حوّلتك إلى رجل أنقليس؟

178
00:14:21,610 --> 00:14:25,380
.لا يملك الأنقليس قرونًا

179
00:14:25,650 --> 00:14:29,010
.لماذا لا تتحوّل إلى بشريّ ثانية

180
00:14:29,250 --> 00:14:30,360
!ماذا؟

181
00:14:30,360 --> 00:14:33,870
!أ-أستطيع تحويل شكلي لسابق عهده؟

182
00:14:33,870 --> 00:14:35,060
!كيف؟

183
00:14:35,060 --> 00:14:36,510
.لا أدري

184
00:14:36,510 --> 00:14:38,980
.لستُ مستعمل فاكهة من نوع زون

185
00:14:39,590 --> 00:14:42,770
.بالمناسبة، أتساءل ما مدى ارتفاع السّقف

186
00:14:42,770 --> 00:14:44,940
.لا أرى حتّى الحفرة الّتي سقطت منها

187
00:14:45,580 --> 00:14:50,680
،أريد الخروج من هنا أيضًا
!وإطلاع أولئك الأطفال بالحقيقة

188
00:14:51,100 --> 00:14:52,820
!صادف ووصل إلى مسامعي أمر ما

189
00:14:54,750 --> 00:14:58,100
...ذلك المدعوّ سيزار

190
00:15:07,290 --> 00:15:10,260
.لدينا مجموعة أخرى من الأطفال جيّدين المطيعين

191
00:15:14,120 --> 00:15:17,680
.يكبر بقيّة الأطفال بلا أيّ مشاكل

192
00:15:17,680 --> 00:15:22,180
.لكنّ هذه تجربة لرؤية حدود جرعات المخدّر

193
00:15:22,180 --> 00:15:24,480
.لا أظنّ أنّهم يستطيعون تحمّل الأمر طويلاً

194
00:15:26,020 --> 00:15:30,600
.أفترض أنّهم سيموتون جميعًا بعد خمس سنوات

195
00:15:32,620 --> 00:15:35,830
.لذلك نحتاج للعثور على أطفال أكثر

196
00:15:36,130 --> 00:15:39,070
.تعرف كلّ التّجارب الفشل

197
00:15:39,070 --> 00:15:41,000
.إنّها تضحية لا غنى عنها

198
00:15:41,290 --> 00:15:44,700
بإمكان أولئك الأطفال الأغبياء
مساعدة أعظم علماء العالم

199
00:15:44,700 --> 00:15:50,740
.السّيّد سيزار كلاون-ساما بما فيه نفع للعالم

200
00:15:50,740 --> 00:15:55,320
،حتّى إن كانت حياة قصيرة
!فعليهم أن يكونوا سعداء بها

201
00:15:55,320 --> 00:15:55,890
!صحيح؟

202
00:16:01,060 --> 00:16:08,440
ظننتُ أنّه كان طبيبًا، لكنّه رجل سيّئ
!في الواقع وسيقود الأطفال لهلاكهم

203
00:16:08,440 --> 00:16:10,020
.وهم يجهلون ذلك تمامًا

204
00:16:11,670 --> 00:16:13,070
.تفضّل

205
00:16:13,070 --> 00:16:15,240
.إليك بعض الشّكولاطة

206
00:16:15,570 --> 00:16:20,120
أعلم أنّ الأمر صعب، لكنّ كلّ الأطفال
.هنا يمرّون بنفس الوضع

207
00:16:20,530 --> 00:16:24,970
يريد الجميع رؤية آبائهم وأمّهاتهم
.في أسرع وقت ممكن

208
00:16:27,530 --> 00:16:30,130
.أشعر بالأسى حيالهم

209
00:16:30,410 --> 00:16:34,650
إن لم أفعل شيئًا، فعليّ الشّعور
!بالخزي من نفسي كمحارب ساموراي

210
00:16:34,650 --> 00:16:41,390
كنتُ في طريقي لإخبار الأطفال، لكنّي وقعت
.هنا عندما حاولت الاختباء في حاوية القمامة

211
00:16:43,730 --> 00:16:45,900
!سيزار

212
00:16:49,970 --> 00:16:54,130
.حسنًا يا مومو، سأتسلّق للأعلى

213
00:16:54,130 --> 00:16:55,500
!وسآخذك معي

214
00:16:55,500 --> 00:16:56,260
!ماذا؟

215
00:16:56,260 --> 00:16:58,120
!كيف ستتسلّق كلّ ذلك العلوّ؟

216
00:16:59,380 --> 00:17:00,750
.سأتسلّق الجدار

217
00:17:01,460 --> 00:17:02,580
!تمسّك بي

218
00:17:02,580 --> 00:17:03,870
!ماذا؟

219
00:17:03,870 --> 00:17:06,260
.لا تقلق على الأطفال

220
00:17:07,680 --> 00:17:09,840
.أصدقائي في طريقهم لمساعدتهم

221
00:17:10,530 --> 00:17:11,880
!فعلاً؟

222
00:17:12,100 --> 00:17:17,260
!لطالما وفوا بوعودهم! لذا فلا عليك من القلق

223
00:17:19,240 --> 00:17:20,540
!حسنًا

224
00:17:21,640 --> 00:17:23,200
!كنتُ على حقّ

225
00:17:23,200 --> 00:17:26,060
...لستُ قرصانًا

226
00:17:26,060 --> 00:17:28,860
...عاديًّا

227
00:17:31,110 --> 00:17:32,300
ما الخطب؟

228
00:17:34,340 --> 00:17:36,370
!ماذا حدث؟! هل أنت جائع جدًّا؟

229
00:17:36,370 --> 00:17:37,700
!تمالك نفسك

230
00:17:37,700 --> 00:17:40,430
!تمالك نفسك! تمالك نفسك

231
00:17:40,960 --> 00:17:43,580
!هيّا، تمالك نفسك

232
00:17:43,580 --> 00:17:47,520
!تمالك نفسك! تمالك نفسك! هيّا

233
00:17:47,520 --> 00:17:51,670
!تمالك نفسك

234
00:17:52,300 --> 00:17:57,690
!تمالك نفسك! تمالك نفسك
!تمالك نفسك

235
00:17:57,690 --> 00:18:00,550
!تمالك نفسك

236
00:18:03,230 --> 00:18:03,970
!ما-ماذا؟

237
00:18:08,830 --> 00:18:09,730
ما الّذي يحدث؟

238
00:18:19,940 --> 00:18:21,780
!مهلاً، ماذا هنالك؟

239
00:18:22,210 --> 00:18:23,660
!مـ-مهلاً

240
00:18:26,580 --> 00:18:28,250
!مهلاً، انتظر

241
00:18:33,240 --> 00:18:35,380
!إنّنا نطير

242
00:18:42,510 --> 00:18:46,140
خلف الطّابق الثّاني للمبنى "ب" - طريق إلى غرفة الفحص

243
00:18:53,510 --> 00:18:56,970
!أنتساءل إن كانت نامي والبقيّ بخير بدوني

244
00:18:56,970 --> 00:18:59,450
!على الأقلّ زورو معهم

245
00:18:59,830 --> 00:19:04,950
!سأنقذك مهما تطلّب الأمر منّي يا مومونوسكي

246
00:19:05,330 --> 00:19:06,480
!بروك

247
00:19:06,480 --> 00:19:10,170
أخبرني إن رأيت أغلال الحجر البحريّ
!الّتي طلبت منّا روبين إيجادها

248
00:19:10,500 --> 00:19:12,210
!أنا آسف أيّها الجثّة-دونو

249
00:19:12,210 --> 00:19:14,760
!أنا مضطرّ للاعتماد على سحرك

250
00:19:15,610 --> 00:19:17,570
!يمكنك الاعتماد عليّ

251
00:19:17,570 --> 00:19:22,740
عليّ البحث عن ابن السّاموراي-سان
وأغلال الحجر البحريّ، صحيح؟

252
00:19:22,740 --> 00:19:24,640
.لنتحقّق من الجانب الآخر لذلك الجدار

253
00:19:27,340 --> 00:19:29,730
هل كان اسمه مومونوسكي-كُن؟

254
00:19:29,730 --> 00:19:35,150
!أراهن أنّه صبيّ يرتدي ملابس ساموراي

255
00:19:35,810 --> 00:19:39,570
!أين أنت؟

256
00:19:40,570 --> 00:19:43,910
"المبنى "د" - غرفة تصنيع "إس إيْ دي

257
00:19:48,570 --> 00:19:54,130
.يفوق هاكي التّسليح خاصّتي قدراتك بكثير

258
00:19:59,210 --> 00:20:05,010
أظنّ أنّك ذكيّ بما يكفي لتعرف
.أنّه لا فائدة من القتال ضدّي

259
00:20:10,160 --> 00:20:12,000
.سموكر

260
00:20:12,930 --> 00:20:18,150
أم أنّك تحاول الانتقام لموت أولئك الحمقى؟

261
00:20:23,610 --> 00:20:27,870
!لن يموتوا بتلك السّهولة، فهم ليسوا بذلك الضّعف

262
00:20:27,870 --> 00:20:31,870
،قد يكونون مجموعة مشاكسين
!لكنّهم ما زالوا جنود بحريّة

263
00:20:37,600 --> 00:20:38,390
!انتقال

264
00:20:54,340 --> 00:20:56,380
!لا تعبث مع البحريّة

265
00:21:02,740 --> 00:21:06,780
لم أكن أعلم أنّك تهتمّ لهذا القدر
.برجالك يا سموكر-كُن

266
00:21:13,500 --> 00:21:17,170
المبنى "ب" - قرب غرفة البسكويت

267
00:21:17,730 --> 00:21:19,260
!من هنا يا رجال

268
00:21:19,260 --> 00:21:21,670
!اذهبوا إلى غرفة البسكويت حيث الأطفال

269
00:21:21,670 --> 00:21:23,720
!بسرعة! بسرعة

270
00:21:23,720 --> 00:21:25,880
!أنتم بطيئون جدًّا

271
00:21:27,340 --> 00:21:30,120
!الغاز المميت خلفكم بمباشرة

272
00:21:30,120 --> 00:21:32,270
!اركضوا بشكل أسرع إن كنتم لا تريدون الموت

273
00:21:33,060 --> 00:21:34,060
!هيّا بسرعة

274
00:21:34,060 --> 00:21:34,600
!هذا مؤلم

275
00:21:34,600 --> 00:21:35,810
!لا تركلني يا أخي

276
00:21:36,890 --> 00:21:39,150
!هذا مؤلم يا أخي

277
00:21:39,150 --> 00:21:41,940
!هيّا يا رجال! بسرعة

278
00:21:44,440 --> 00:21:45,570
!لا تركلني

279
00:21:45,570 --> 00:21:46,610
!هذا مؤلم

280
00:21:46,610 --> 00:21:50,680
سيقتلنا أخي السّاق السّوداء
!قبل أن يقتلنا الغاز المميت

281
00:21:51,530 --> 00:21:52,810
!لا تتصرّفوا كالأطفال

282
00:21:52,810 --> 00:21:54,000
!إنّه مجنون

283
00:21:54,890 --> 00:21:56,890
!بسرعة

284
00:21:56,890 --> 00:22:00,420
اذهبوا لغرفة البسكويت الآن
!إن كنتم تريدون إنقاذ الأطفال

285
00:22:00,540 --> 00:22:04,340
الطّابق الثّالث للمبنى "ب" - غرفة البسكويت

286
00:22:08,130 --> 00:22:11,200
!الجوّ بارد! تضرب عاصفة ثلجيّة الغرفة بأكملها

287
00:22:11,200 --> 00:22:12,410
!خلعت معطفي قبل قليل فحسب

288
00:22:12,410 --> 00:22:14,410
!ما فاكهة الثّلج هذه؟

289
00:22:14,410 --> 00:22:16,010
!سُحقًا لامرأة الثّلج تلك

290
00:22:16,010 --> 00:22:17,840
!توقّفوا جميعًا

291
00:22:17,840 --> 00:22:19,880
!ليس عليكم أكل الحلوى

292
00:22:19,880 --> 00:22:21,770
!اهربي يا موتشا

293
00:22:21,770 --> 00:22:23,770
!انتظري يا موتشا

294
00:22:23,770 --> 00:22:25,680
!أعطنا الحلوى

295
00:22:25,680 --> 00:22:27,650
!كلاّ! عليكم العودة لرشدكم جميعًا

296
00:22:28,710 --> 00:22:30,720
!لا يمكنك الحصول عليها وحدك

297
00:22:30,720 --> 00:22:31,780
!كفّي عن الهرب

298
00:22:33,030 --> 00:22:34,740
.سأحاول الإمساك بهم ولو لوقت قصير

299
00:22:39,180 --> 00:22:40,210
.لا تتدخّلي

300
00:22:41,380 --> 00:22:42,500
!روبين

301
00:22:44,070 --> 00:22:45,800
!هل أنت بخير؟

302
00:22:58,350 --> 00:22:59,420
!ماذا؟

303
00:23:01,650 --> 00:23:05,940
!أنت صائد القراصنة زورو ومكافأتك 120 مليون بيري

304
00:23:06,190 --> 00:23:08,570
!اذهبوا لإيقاف الأطفال

305
00:23:12,000 --> 00:23:13,710
.فاكهتها من نوع لوغيا

306
00:23:14,510 --> 00:23:16,950
!سأتولّى أمرها

307
00:23:24,640 --> 00:23:28,090
حتّى وإن كان تحت رحمة قدرات
،موني الّتي تتلاعب بالثّلج

308
00:23:28,090 --> 00:23:32,720
ما زال زورو يحاول السّماح لنامي والبقيّة
.بالهرب رغم الهجمات المتواصلة

309
00:23:32,720 --> 00:23:37,260
وحينها تتحوّل موني إلى وحش
.مرعب ويزداد الوضع سوءًا

310
00:23:37,260 --> 00:23:39,980
.ويجد الطّاقم نفسه محاصرًا

311
00:23:39,980 --> 00:23:41,450
:في الحلقة القادمة من وان بيس

312
00:23:41,450 --> 00:23:44,690
!قتال مميت في عاصفة ثلجيّة"
"!طاقم قبّعة القشّ ضدّ امرأة الثّلج

313
00:23:44,690 --> 00:23:46,980
!ملك القراصنة، لن يكون إلاّ أنا

314
00:23:49,990 --> 00:23:54,990
!!نراكم في الحلقة القادمة