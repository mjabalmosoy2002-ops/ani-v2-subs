1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,310 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:46,070 --> 00:02:52,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,410 --> 00:02:58,460
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,210 --> 00:03:06,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,680 --> 00:03:08,390
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:08,930 --> 00:03:12,640
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:15,690 --> 00:03:18,190
،بعد نجاتهم من معركة حامية

37
00:03:18,190 --> 00:03:21,010
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:21,010 --> 00:03:23,190
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:24,030 --> 00:03:27,940
،رسوا في بانك هازارد، جزيرة من جزأين
.أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:28,360 --> 00:03:32,410
،بعد اكتشافهم لدافع للسّيّد سيزار كلاون حاكم الجزيرة

41
00:03:32,410 --> 00:03:38,840
وبينما يحاولون الهرب من شينوكوني إلى جانب
،حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

42
00:03:38,840 --> 00:03:41,960
،هم في طريقهم الآن لاختطاف سيزار

43
00:03:41,960 --> 00:03:45,000
.وإنقاذ الأطفال والهرب من الجزيرة

44
00:03:45,540 --> 00:03:47,260
أقلت شيئًا ما؟

45
00:03:47,640 --> 00:03:48,930
!من تكون؟

46
00:03:52,490 --> 00:03:54,890
!من تكون أنت؟

47
00:03:57,160 --> 00:04:00,770
"!تنّين صغير! ظهور مومونوسكي"

48
00:04:15,480 --> 00:04:16,990
مومونوسكي؟

49
00:04:16,160 --> 00:04:20,830
"مكبّ نفايات في قبو المبنى "س
— جانب لوفي —

50
00:04:16,990 --> 00:04:19,100
.ذاك هو اسمي

51
00:04:20,830 --> 00:04:23,400
.سمعتُ ذلك الاسم من قبل

52
00:04:23,400 --> 00:04:25,020
أين يا ترى؟

53
00:04:25,020 --> 00:04:25,960
أنّى لي أن أعلم؟

54
00:04:25,960 --> 00:04:27,390
.لا بدّ أنّه شخص آخر

55
00:04:27,390 --> 00:04:29,580
...الأهمّ الآن، عليك

56
00:04:34,600 --> 00:04:36,970
!أن توقف سيلان لعابك

57
00:04:38,100 --> 00:04:41,310
!لا يمكنك أكلي

58
00:04:41,310 --> 00:04:43,600
!سآكلك أوّلاً إن حاولت أكلي

59
00:04:44,080 --> 00:04:45,920
!أحسن التّصرّف

60
00:04:44,400 --> 00:04:48,570
(مومونوسكي (تنّين

61
00:04:50,910 --> 00:04:51,580
ماذا؟

62
00:04:51,580 --> 00:04:54,470
ربّما يكون مومونوسكي عالقًا على التّنّين

63
00:04:54,470 --> 00:04:56,190
...ويتحدّث بضرطاته

64
00:04:56,190 --> 00:04:58,400
!أتسمعني؟ أين أنت؟

65
00:04:58,400 --> 00:05:00,370
!ما الّذي تفعله؟

66
00:05:01,250 --> 00:05:02,370
!ها نحن أولاء

67
00:05:05,530 --> 00:05:07,800
!انقسم إلى نصفين! أنا آسف

68
00:05:08,990 --> 00:05:11,260
!انفصلت عنه أخيرًا-بو

69
00:05:12,390 --> 00:05:14,300
!أنا لا أتكلّم بضرطاتي

70
00:05:14,300 --> 00:05:15,680
!كم هذا وقح

71
00:05:15,680 --> 00:05:17,890
!عمّ تتحدّث؟

72
00:05:17,890 --> 00:05:21,840
بالتّفكير في الأمر، كان ذلك التّنّين أكبر

73
00:05:21,840 --> 00:05:24,010
.وسبق وأكلناه

74
00:05:24,010 --> 00:05:25,270
من تكون إذًا؟

75
00:05:25,600 --> 00:05:26,910
!ماذا؟

76
00:05:26,910 --> 00:05:29,580
!ثمّة أنقليس يُكلّمني؟

77
00:05:30,820 --> 00:05:32,900
!أوقف سيلان لعابك

78
00:05:32,900 --> 00:05:34,940
!أنا لستُ أنقليسًا

79
00:05:39,120 --> 00:05:41,830
تتضوّر جوعًا أيضًا، صحيح؟

80
00:05:42,390 --> 00:05:44,100
.ما هذه السّخافة

81
00:05:44,930 --> 00:05:49,600
لا يشعر محاربو السّاموراي بالجوع
.بعد عشرة أيّام فقط بلا طعام

82
00:05:51,550 --> 00:05:52,980
!عشرة أيّام؟

83
00:05:55,700 --> 00:05:58,680
من تكون ولماذا أنت هنا؟

84
00:05:59,420 --> 00:06:00,980
.أنا لوفي

85
00:06:00,980 --> 00:06:03,020
!أنّا الرّجل الّذي سيصير ملك القراصنة

86
00:06:03,020 --> 00:06:05,020
...قـ-قـ-قـ-قـ

87
00:06:05,540 --> 00:06:06,570
...قـ

88
00:06:09,810 --> 00:06:11,450
.لا بدّ أنّك تكذب

89
00:06:13,290 --> 00:06:16,810
.القراصنة رجال ضخام البنية

90
00:06:16,810 --> 00:06:20,200
.إنّهم أكثر عنفًا وأقوى

91
00:06:20,200 --> 00:06:24,780
...على أيّ حال أيّها الأنقليس، كيف أستطيع

92
00:06:24,780 --> 00:06:25,870
!اسمي مومونوسكي

93
00:06:28,440 --> 00:06:31,090
أنت من مكان آخر أيضًا، صحيح؟

94
00:06:33,470 --> 00:06:38,170
كلّ ما أعرفه هو أنّ هنالك الكثير
.من الأطفال المرضى هنا

95
00:06:40,020 --> 00:06:45,690
.لا أعرف حتّى طبيعة هذه الجزيرة ما حصل لي

96
00:06:47,080 --> 00:06:51,730
.وأصلُ الأمر يعود إلى وقت تسلّلي إلى سفينة

97
00:06:53,580 --> 00:06:57,410
،حاولت أن أكون فظًّا قدر المستطاع

98
00:06:57,760 --> 00:07:01,120
.لكنّ أولئك الأطفال كانوا طيّبين معي

99
00:07:03,490 --> 00:07:05,060
.إنّهم يوزّعون الطّعام

100
00:07:05,060 --> 00:07:06,290
هل أنت جائع؟

101
00:07:06,290 --> 00:07:08,370
!اخرسي! لا أريد أيّ طعام

102
00:07:11,210 --> 00:07:13,520
!أنا ساموراي

103
00:07:13,520 --> 00:07:15,980
!أنا لا أقبل الصّدقة

104
00:07:18,300 --> 00:07:22,140
...كانوا لطفاء معي، ولكنّ مزاجي كان معكّرًا حينها

105
00:07:22,570 --> 00:07:24,470
.أحضرت لك بعض الطّعام

106
00:07:24,820 --> 00:07:27,070
!قلت أنّي لا أريد طعامًا

107
00:07:28,140 --> 00:07:30,020
.من الأفضل أن تأكل شيئًا

108
00:07:30,020 --> 00:07:32,190
،فُصلنا جميعًا عن والدينا
...لذلك علينا أن نتكاتف معًا

109
00:07:32,570 --> 00:07:35,780
!لا يفهم أيّ أحد ما أشعر به

110
00:07:42,160 --> 00:07:45,620
غرفة البسكويت

111
00:07:46,190 --> 00:07:49,280
!أنا "السّيّد" سيزار

112
00:07:49,280 --> 00:07:51,210
!تفضّلوا

113
00:07:51,210 --> 00:07:54,820
!هذا ملعبكم من اليوم

114
00:07:56,270 --> 00:07:58,230
!ثمّة العديد من الأطفال العمالقة

115
00:07:58,230 --> 00:08:00,050
أهم مرضى أيضًا؟

116
00:08:00,320 --> 00:08:03,570
!يمكنكم الاعتماد عليّ

117
00:08:03,570 --> 00:08:07,600
!سأعالجكم جميعًا بأيّ ثمن كان

118
00:08:07,600 --> 00:08:09,080
!مرحبًا

119
00:08:09,080 --> 00:08:11,430
!جميعنا أصدقاء ابتداءً من اليوم

120
00:08:11,430 --> 00:08:12,700
!شكرًا لك

121
00:08:13,650 --> 00:08:14,970
ماذا عنك؟

122
00:08:14,970 --> 00:08:15,940
ما اسمك؟

123
00:08:16,650 --> 00:08:19,450
.لا اسم لديّ

124
00:08:23,150 --> 00:08:24,490
.تفضّل

125
00:08:24,910 --> 00:08:26,950
.إليك بعض الشّكولاطة

126
00:08:28,190 --> 00:08:29,000
!لا أريد

127
00:08:29,470 --> 00:08:30,370
حلوى؟

128
00:08:30,600 --> 00:08:31,500
!لا أريد

129
00:08:38,130 --> 00:08:41,590
بعد بضعة أيّام

130
00:08:41,830 --> 00:08:44,760
أنت، هل صحيح أنّ أحد الأطفال قد هرب؟

131
00:08:45,110 --> 00:08:48,870
.نعم، لكنّ كلّ من على لائحة ركوب السّفينة موجود

132
00:08:48,870 --> 00:08:49,770
.هذا غريب

133
00:08:49,770 --> 00:08:52,480
.في كلّ الأحوال، لننفصل ونبحث عنه

134
00:09:06,970 --> 00:09:09,370
كيف أستطيع الخروج من هنا؟

135
00:10:21,300 --> 00:10:22,370
!أيّها الفتى

136
00:10:24,090 --> 00:10:26,810
.كنتَ على نفس السّفينة معي

137
00:10:26,810 --> 00:10:28,030
هل تتذكّرني؟

138
00:10:31,370 --> 00:10:34,550
.فعلاً؟ اسمك مومونوسكي-كُن إذًا

139
00:10:35,250 --> 00:10:38,700
.هذه "الغرفة السّرّيّة" وهي محظورة على الجميع

140
00:10:38,700 --> 00:10:42,800
.أنت مزعجة جدًّا. لا تتورّطي معي

141
00:10:43,180 --> 00:10:44,610
لماذا؟

142
00:10:44,610 --> 00:10:45,620
...لأنّ

143
00:10:46,680 --> 00:10:48,690
!لا يوجد سبب

144
00:10:48,690 --> 00:10:52,230
.أنا أبحث عن المخرج فحسب. سأخرج من هنا

145
00:10:52,230 --> 00:10:54,510
.ثمّة أمر عليّ فعله

146
00:10:54,510 --> 00:10:59,110
أعلم أنّ الأمر صعب، لكنّ كلّ الأطفال
.هنا يمرّون بنفس الوضع

147
00:11:01,090 --> 00:11:05,280
يريد الجميع رؤية آبائهم وأمّهاتهم
.في أسرع وقت ممكن

148
00:11:07,490 --> 00:11:12,660
أتينا جميعنا إلى هنا من جُزر مختلفة
.لنُعالج، لكن يتشارك الجميع نفس الشّعور

149
00:11:13,990 --> 00:11:18,620
ثمّة أشياء عديدة أريد القيام بها
!إن استطعت العودة للمنزل

150
00:11:18,970 --> 00:11:23,000
الجميع لطفاء في غرفة البسكويت
.ونستمتع بوقنا هناك

151
00:11:23,000 --> 00:11:25,070
.بإمكانك نسيان الألم

152
00:11:25,070 --> 00:11:29,170
!لذلك لماذا لا تأكل شيئًا ما يا مومونوسكي-كُن؟

153
00:11:29,170 --> 00:11:30,590
...حسنًا، ولكن

154
00:11:33,090 --> 00:11:33,990
ماذا؟

155
00:11:33,990 --> 00:11:34,810
ما الخطب؟

156
00:11:34,810 --> 00:11:36,600
!كلاّ، أحدهم قادم

157
00:11:37,280 --> 00:11:38,890
!هيّا بنا يا مومونوسكي-كُن

158
00:11:43,370 --> 00:11:45,690
!باب الغرفة السّرّيّة مفتوح

159
00:11:46,790 --> 00:11:47,530
!بسرعة

160
00:11:48,410 --> 00:11:51,200
!لا تقلقي حيالي! اذهبي فحسب

161
00:12:10,170 --> 00:12:11,340
!هل من أحد هنا؟

162
00:12:14,390 --> 00:12:16,030
!ما-ما هذا؟

163
00:12:16,030 --> 00:12:16,680
!من هناك؟

164
00:12:30,070 --> 00:12:31,570
!تـ-تنّين؟

165
00:12:38,490 --> 00:12:39,960
ما الّذي يحدث؟

166
00:12:39,960 --> 00:12:41,080
.لا أدري

167
00:12:43,560 --> 00:12:46,500
...مـ-مومونوسكي-كُن

168
00:12:52,530 --> 00:12:53,580
!انظر

169
00:12:53,580 --> 00:12:58,690
إن لم تخنّي الذّاكرة، فقد كانت هنا
.فاكهة الشّيطان اصطناعيّة صنعها فيغابانك

170
00:12:58,690 --> 00:13:00,950
.سمعتُ أنّها كانت فاشلة

171
00:13:00,950 --> 00:13:03,060
.نعم، سمعت ذلك أيضًا

172
00:13:10,980 --> 00:13:15,900
ظننتُ أنّ قلبي سينفجر بعد ذلك الألم
!الّذي أحسست به فجأة في صدري

173
00:13:16,340 --> 00:13:19,790
.واجهت مشاكل في الهرب من قبل

174
00:13:20,170 --> 00:13:21,200
...ما الّذي

175
00:13:56,470 --> 00:14:00,030
.لذلك أنا بشريّ في الأصل

176
00:14:02,810 --> 00:14:05,500
أكلت فاكهة شيطان إذًا؟

177
00:14:05,980 --> 00:14:07,610
وقد حوّلتك إلى رجل أنقليس؟

178
00:14:07,610 --> 00:14:11,380
.لا يملك الأنقليس قرونًا

179
00:14:11,650 --> 00:14:15,010
.لماذا لا تتحوّل إلى بشريّ ثانية

180
00:14:15,250 --> 00:14:16,360
!ماذا؟

181
00:14:16,360 --> 00:14:19,870
!أ-أستطيع تحويل شكلي لسابق عهده؟

182
00:14:19,870 --> 00:14:21,060
!كيف؟

183
00:14:21,060 --> 00:14:22,510
.لا أدري

184
00:14:22,510 --> 00:14:24,980
.لستُ مستعمل فاكهة من نوع زون

185
00:14:25,590 --> 00:14:28,770
.بالمناسبة، أتساءل ما مدى ارتفاع السّقف

186
00:14:28,770 --> 00:14:30,940
.لا أرى حتّى الحفرة الّتي سقطت منها

187
00:14:31,580 --> 00:14:36,680
،أريد الخروج من هنا أيضًا
!وإطلاع أولئك الأطفال بالحقيقة

188
00:14:37,100 --> 00:14:38,820
!صادف ووصل إلى مسامعي أمر ما

189
00:14:40,750 --> 00:14:44,100
...ذلك المدعوّ سيزار

190
00:14:53,290 --> 00:14:56,260
.لدينا مجموعة أخرى من الأطفال جيّدين المطيعين

191
00:15:00,120 --> 00:15:03,680
.يكبر بقيّة الأطفال بلا أيّ مشاكل

192
00:15:03,680 --> 00:15:08,180
.لكنّ هذه تجربة لرؤية حدود جرعات المخدّر

193
00:15:08,180 --> 00:15:10,480
.لا أظنّ أنّهم يستطيعون تحمّل الأمر طويلاً

194
00:15:12,020 --> 00:15:16,600
.أفترض أنّهم سيموتون جميعًا بعد خمس سنوات

195
00:15:18,620 --> 00:15:21,830
.لذلك نحتاج للعثور على أطفال أكثر

196
00:15:22,130 --> 00:15:25,070
.تعرف كلّ التّجارب الفشل

197
00:15:25,070 --> 00:15:27,000
.إنّها تضحية لا غنى عنها

198
00:15:27,290 --> 00:15:30,700
بإمكان أولئك الأطفال الأغبياء
مساعدة أعظم علماء العالم

199
00:15:30,700 --> 00:15:36,740
.السّيّد سيزار كلاون-ساما بما فيه نفع للعالم

200
00:15:36,740 --> 00:15:41,320
،حتّى إن كانت حياة قصيرة
!فعليهم أن يكونوا سعداء بها

201
00:15:41,320 --> 00:15:41,890
!صحيح؟

202
00:15:47,060 --> 00:15:54,440
ظننتُ أنّه كان طبيبًا، لكنّه رجل سيّئ
!في الواقع وسيقود الأطفال لهلاكهم

203
00:15:54,440 --> 00:15:56,020
.وهم يجهلون ذلك تمامًا

204
00:15:57,670 --> 00:15:59,070
.تفضّل

205
00:15:59,070 --> 00:16:01,240
.إليك بعض الشّكولاطة

206
00:16:01,570 --> 00:16:06,120
أعلم أنّ الأمر صعب، لكنّ كلّ الأطفال
.هنا يمرّون بنفس الوضع

207
00:16:06,530 --> 00:16:10,970
يريد الجميع رؤية آبائهم وأمّهاتهم
.في أسرع وقت ممكن

208
00:16:13,530 --> 00:16:16,130
.أشعر بالأسى حيالهم

209
00:16:16,410 --> 00:16:20,650
إن لم أفعل شيئًا، فعليّ الشّعور
!بالخزي من نفسي كمحارب ساموراي

210
00:16:20,650 --> 00:16:27,390
كنتُ في طريقي لإخبار الأطفال، لكنّي وقعت
.هنا عندما حاولت الاختباء في حاوية القمامة

211
00:16:29,730 --> 00:16:31,900
!سيزار

212
00:16:35,970 --> 00:16:40,130
.حسنًا يا مومو، سأتسلّق للأعلى

213
00:16:40,130 --> 00:16:41,500
!وسآخذك معي

214
00:16:41,500 --> 00:16:42,260
!ماذا؟

215
00:16:42,260 --> 00:16:44,120
!كيف ستتسلّق كلّ ذلك العلوّ؟

216
00:16:45,380 --> 00:16:46,750
.سأتسلّق الجدار

217
00:16:47,460 --> 00:16:48,580
!تمسّك بي

218
00:16:48,580 --> 00:16:49,870
!ماذا؟

219
00:16:49,870 --> 00:16:52,260
.لا تقلق على الأطفال

220
00:16:53,680 --> 00:16:55,840
.أصدقائي في طريقهم لمساعدتهم

221
00:16:56,530 --> 00:16:57,880
!فعلاً؟

222
00:16:58,100 --> 00:17:03,260
!لطالما وفوا بوعودهم! لذا فلا عليك من القلق

223
00:17:05,240 --> 00:17:06,540
!حسنًا

224
00:17:07,640 --> 00:17:09,200
!كنتُ على حقّ

225
00:17:09,200 --> 00:17:12,060
...لستُ قرصانًا

226
00:17:12,060 --> 00:17:14,860
...عاديًّا

227
00:17:17,110 --> 00:17:18,300
ما الخطب؟

228
00:17:20,340 --> 00:17:22,370
!ماذا حدث؟! هل أنت جائع جدًّا؟

229
00:17:22,370 --> 00:17:23,700
!تمالك نفسك

230
00:17:23,700 --> 00:17:26,430
!تمالك نفسك! تمالك نفسك

231
00:17:26,960 --> 00:17:29,580
!هيّا، تمالك نفسك

232
00:17:29,580 --> 00:17:33,520
!تمالك نفسك! تمالك نفسك! هيّا

233
00:17:33,520 --> 00:17:37,670
!تمالك نفسك

234
00:17:38,300 --> 00:17:43,690
!تمالك نفسك! تمالك نفسك
!تمالك نفسك

235
00:17:43,690 --> 00:17:46,550
!تمالك نفسك

236
00:17:49,230 --> 00:17:49,970
!ما-ماذا؟

237
00:17:54,830 --> 00:17:55,730
ما الّذي يحدث؟

238
00:18:05,940 --> 00:18:07,780
!مهلاً، ماذا هنالك؟

239
00:18:08,210 --> 00:18:09,660
!مـ-مهلاً

240
00:18:12,580 --> 00:18:14,250
!مهلاً، انتظر

241
00:18:19,240 --> 00:18:21,380
!إنّنا نطير

242
00:18:28,510 --> 00:18:32,140
خلف الطّابق الثّاني للمبنى "ب" - طريق إلى غرفة الفحص

243
00:18:39,510 --> 00:18:42,970
!أنتساءل إن كانت نامي والبقيّ بخير بدوني

244
00:18:42,970 --> 00:18:45,450
!على الأقلّ زورو معهم

245
00:18:45,830 --> 00:18:50,950
!سأنقذك مهما تطلّب الأمر منّي يا مومونوسكي

246
00:18:51,330 --> 00:18:52,480
!بروك

247
00:18:52,480 --> 00:18:56,170
أخبرني إن رأيت أغلال الحجر البحريّ
!الّتي طلبت منّا روبين إيجادها

248
00:18:56,500 --> 00:18:58,210
!أنا آسف أيّها الجثّة-دونو

249
00:18:58,210 --> 00:19:00,760
!أنا مضطرّ للاعتماد على سحرك

250
00:19:01,610 --> 00:19:03,570
!يمكنك الاعتماد عليّ

251
00:19:03,570 --> 00:19:08,740
عليّ البحث عن ابن السّاموراي-سان
وأغلال الحجر البحريّ، صحيح؟

252
00:19:08,740 --> 00:19:10,640
.لنتحقّق من الجانب الآخر لذلك الجدار

253
00:19:13,340 --> 00:19:15,730
هل كان اسمه مومونوسكي-كُن؟

254
00:19:15,730 --> 00:19:21,150
!أراهن أنّه صبيّ يرتدي ملابس ساموراي

255
00:19:21,810 --> 00:19:25,570
!أين أنت؟

256
00:19:26,570 --> 00:19:29,910
"المبنى "د" - غرفة تصنيع "إس إيْ دي

257
00:19:34,570 --> 00:19:40,130
.يفوق هاكي التّسليح خاصّتي قدراتك بكثير

258
00:19:45,210 --> 00:19:51,010
أظنّ أنّك ذكيّ بما يكفي لتعرف
.أنّه لا فائدة من القتال ضدّي

259
00:19:56,160 --> 00:19:58,000
.سموكر

260
00:19:58,930 --> 00:20:04,150
أم أنّك تحاول الانتقام لموت أولئك الحمقى؟

261
00:20:09,610 --> 00:20:13,870
!لن يموتوا بتلك السّهولة، فهم ليسوا بذلك الضّعف

262
00:20:13,870 --> 00:20:17,870
،قد يكونون مجموعة مشاكسين
!لكنّهم ما زالوا جنود بحريّة

263
00:20:23,600 --> 00:20:24,390
!انتقال

264
00:20:40,340 --> 00:20:42,380
!لا تعبث مع البحريّة

265
00:20:48,740 --> 00:20:52,780
لم أكن أعلم أنّك تهتمّ لهذا القدر
.برجالك يا سموكر-كُن

266
00:20:59,500 --> 00:21:03,170
المبنى "ب" - قرب غرفة البسكويت

267
00:21:03,730 --> 00:21:05,260
!من هنا يا رجال

268
00:21:05,260 --> 00:21:07,670
!اذهبوا إلى غرفة البسكويت حيث الأطفال

269
00:21:07,670 --> 00:21:09,720
!بسرعة! بسرعة

270
00:21:09,720 --> 00:21:11,880
!أنتم بطيئون جدًّا

271
00:21:13,340 --> 00:21:16,120
!الغاز المميت خلفكم بمباشرة

272
00:21:16,120 --> 00:21:18,270
!اركضوا بشكل أسرع إن كنتم لا تريدون الموت

273
00:21:19,060 --> 00:21:20,060
!هيّا بسرعة

274
00:21:20,060 --> 00:21:20,600
!هذا مؤلم

275
00:21:20,600 --> 00:21:21,810
!لا تركلني يا أخي

276
00:21:22,890 --> 00:21:25,150
!هذا مؤلم يا أخي

277
00:21:25,150 --> 00:21:27,940
!هيّا يا رجال! بسرعة

278
00:21:30,440 --> 00:21:31,570
!لا تركلني

279
00:21:31,570 --> 00:21:32,610
!هذا مؤلم

280
00:21:32,610 --> 00:21:36,680
سيقتلنا أخي السّاق السّوداء
!قبل أن يقتلنا الغاز المميت

281
00:21:37,530 --> 00:21:38,810
!لا تتصرّفوا كالأطفال

282
00:21:38,810 --> 00:21:40,000
!إنّه مجنون

283
00:21:40,890 --> 00:21:42,890
!بسرعة

284
00:21:42,890 --> 00:21:46,420
اذهبوا لغرفة البسكويت الآن
!إن كنتم تريدون إنقاذ الأطفال

285
00:21:46,540 --> 00:21:50,340
الطّابق الثّالث للمبنى "ب" - غرفة البسكويت

286
00:21:54,130 --> 00:21:57,200
!الجوّ بارد! تضرب عاصفة ثلجيّة الغرفة بأكملها

287
00:21:57,200 --> 00:21:58,410
!خلعت معطفي قبل قليل فحسب

288
00:21:58,410 --> 00:22:00,410
!ما فاكهة الثّلج هذه؟

289
00:22:00,410 --> 00:22:02,010
!سُحقًا لامرأة الثّلج تلك

290
00:22:02,010 --> 00:22:03,840
!توقّفوا جميعًا

291
00:22:03,840 --> 00:22:05,880
!ليس عليكم أكل الحلوى

292
00:22:05,880 --> 00:22:07,770
!اهربي يا موتشا

293
00:22:07,770 --> 00:22:09,770
!انتظري يا موتشا

294
00:22:09,770 --> 00:22:11,680
!أعطنا الحلوى

295
00:22:11,680 --> 00:22:13,650
!كلاّ! عليكم العودة لرشدكم جميعًا

296
00:22:14,710 --> 00:22:16,720
!لا يمكنك الحصول عليها وحدك

297
00:22:16,720 --> 00:22:17,780
!كفّي عن الهرب

298
00:22:19,030 --> 00:22:20,740
.سأحاول الإمساك بهم ولو لوقت قصير

299
00:22:25,180 --> 00:22:26,210
.لا تتدخّلي

300
00:22:27,380 --> 00:22:28,500
!روبين

301
00:22:30,070 --> 00:22:31,800
!هل أنت بخير؟

302
00:22:44,350 --> 00:22:45,420
!ماذا؟

303
00:22:47,650 --> 00:22:51,940
!أنت صائد القراصنة زورو ومكافأتك 120 مليون بيري

304
00:22:52,190 --> 00:22:54,570
!اذهبوا لإيقاف الأطفال

305
00:22:58,000 --> 00:22:59,710
.فاكهتها من نوع لوغيا

306
00:23:00,510 --> 00:23:02,950
!سأتولّى أمرها

307
00:23:10,640 --> 00:23:14,090
حتّى وإن كان تحت رحمة قدرات
،موني الّتي تتلاعب بالثّلج

308
00:23:14,090 --> 00:23:18,720
ما زال زورو يحاول السّماح لنامي والبقيّة
.بالهرب رغم الهجمات المتواصلة

309
00:23:18,720 --> 00:23:23,260
وحينها تتحوّل موني إلى وحش
.مرعب ويزداد الوضع سوءًا

310
00:23:23,260 --> 00:23:25,980
.ويجد الطّاقم نفسه محاصرًا

311
00:23:25,980 --> 00:23:27,450
:في الحلقة القادمة من وان بيس

312
00:23:27,450 --> 00:23:30,690
!قتال مميت في عاصفة ثلجيّة"
"!طاقم قبّعة القشّ ضدّ امرأة الثّلج

313
00:23:30,690 --> 00:23:32,980
!ملك القراصنة، لن يكون إلاّ أنا

314
00:23:35,990 --> 00:23:40,990
!!نراكم في الحلقة القادمة