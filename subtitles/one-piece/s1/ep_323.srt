1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:42,570 --> 00:02:44,560
!زورو! سانجي

33
00:02:44,990 --> 00:02:46,560
!مصيبة

34
00:02:47,050 --> 00:02:50,110
!عاد جدّك يا لوفي

35
00:02:50,110 --> 00:02:51,560
.إنّهم في السّاحل المقابل

36
00:02:51,560 --> 00:02:54,270
!إنّهم يبحثون عنّا الآن! سيهاجموننا

37
00:02:54,270 --> 00:02:58,240
.ماذا؟! لماذا؟! قال أنّه لن يقبض علينا

38
00:02:58,890 --> 00:03:02,110
!وما أدرانا؟! استعدّوا للإبحار بسرعة

39
00:03:05,990 --> 00:03:06,790
!سأعيده لك

40
00:03:15,060 --> 00:03:17,460
...والآن، اركب معنا يا فرانكي

41
00:03:18,090 --> 00:03:19,840
.اركب سفينتي

42
00:03:21,450 --> 00:03:23,890
!لا تعتدّ بنفسك

43
00:03:23,890 --> 00:03:27,220
أنتم هوّاة تمامًا بالكاد تستطيعون
!تدبّر التّرقيعات المؤقّتة

44
00:03:27,220 --> 00:03:32,850
سيكون من المؤسف ألاّ تملك هذه
.السّفينة العظيمة نجّار سفن على متنها

45
00:03:32,850 --> 00:03:35,980
!أظنّني لا أملك خيارًا عدا مساعدتكم

46
00:03:35,980 --> 00:03:41,240
!أنا فرانكي، سأكون نجّار سفينتكم

47
00:03:44,400 --> 00:03:49,620
!مغادرة مدينة الماء"
"!يضع الرّجل أوسوبّ خاتمة للنّزال

48
00:03:52,570 --> 00:03:54,070
!يا نائب الأميرال غارب

49
00:03:56,170 --> 00:03:58,080
!وجدنا طاقم قبّعة القشّ

50
00:03:58,080 --> 00:04:02,550
إنّهم في جزيرة الخردة في السّاحل
!الجنوب شرقيّ، ويوشكون على الإبحار

51
00:04:02,550 --> 00:04:05,580
!سنتّجه إلى هناك حالاً! اركبوا على فور

52
00:04:05,580 --> 00:04:06,510
!حاضر

53
00:04:15,980 --> 00:04:20,230
يا نائب الأميرال غارب! سبق وافترقنا
.بلطافة مع لوفي-سان والبقيّة

54
00:04:20,230 --> 00:04:22,070
!هذا محرج للغاية

55
00:04:22,070 --> 00:04:23,700
!إن كانت لديك شكوى، وجّهها لسنغوكو

56
00:04:24,130 --> 00:04:27,160
!هو من وبّخني وأخبرني أن أعود إلى هنا

57
00:04:27,780 --> 00:04:29,120
.يا له من متسلّط

58
00:04:30,370 --> 00:04:33,870
ذلك لأنّك قلتَ له عبر حلزون
"...الاتّصال، "إنّه حفيدي، لذا

59
00:04:34,270 --> 00:04:37,840
.اخرس! اهتمّ بشؤونك أيّها الغرّ

60
00:04:39,110 --> 00:04:43,280
أ-أيّها الأميرال، ماذا عنك؟
ألا بأس أن تكون هنا؟

61
00:04:43,280 --> 00:04:47,800
.من الشّاقّ جدًّا العودة بالدرّاجة
.لا تقلقوا، لن أفعل شيئًا

62
00:04:49,170 --> 00:04:52,980
أظنّ أنّ ذلك سيكون مشكلة أيضًا
.عند مواجهة العدوّ

63
00:04:53,510 --> 00:04:55,720
!افردوا الأشرعة

64
00:04:58,440 --> 00:05:03,900
!يا أخي! اعتن بنفسك جيّدًا

65
00:05:03,900 --> 00:05:06,910
!ستواصل عائلة فرانكي العيش إلى الأبد

66
00:05:07,600 --> 00:05:10,370
!يا طاقم قبّعة القشّ! اعتنوا بأنفسكم أيضًا

67
00:05:11,200 --> 00:05:13,140
!مهلاً يا لوفي

68
00:05:13,140 --> 00:05:14,580
!لوفي

69
00:05:15,750 --> 00:05:20,040
أواثق حقًّا أنّك لست بحاجة لانتظار
شخص آخر يا قبّعة القشّ؟

70
00:05:20,690 --> 00:05:24,510
،انتظرتُ بالفعل. مذ سمعتُ ما قاله سانجي

71
00:05:25,060 --> 00:05:28,450
.حاولتُ لكي لا تكون غرفتنا في غالي-لا فارغة

72
00:05:32,400 --> 00:05:35,390
!ماذا؟ أوسوبّ سيعود؟

73
00:05:35,850 --> 00:05:39,900
نعم. كان يتدرّب بمفرده على كيف
.سينضمّ لنا من جديد في السّاحل

74
00:05:44,590 --> 00:05:48,030
.حقًّا؟! يريد أن يعود حقًّا إذًا

75
00:05:48,030 --> 00:05:50,440
!لنذهب لأخذه على الفور إذًا

76
00:05:50,440 --> 00:05:51,710
!أجل

77
00:05:51,710 --> 00:05:53,790
.دائمًا ما يفعل الأمور بالطّريقة الشّاقّة

78
00:05:54,970 --> 00:05:58,000
!أوسوبّ سيعود

79
00:05:58,450 --> 00:06:00,000
!انتظروا يا رفاق

80
00:06:02,420 --> 00:06:06,380
.لن أسمح لأيّ منّا بالذّهاب لأخذه

81
00:06:06,380 --> 00:06:07,720
ماذا؟ لماذا؟

82
00:06:09,070 --> 00:06:12,640
.أيّما فعلت، لا تتصرّف معه بإذلال يا لوفي

83
00:06:13,900 --> 00:06:14,810
...زورو

84
00:06:14,810 --> 00:06:18,980
.لن أقبل عودته إلى أن يعتذر أوّلاً

85
00:06:18,980 --> 00:06:22,400
!زورو! لماذا؟

86
00:06:20,420 --> 00:06:22,400
...مهلاً! من أنت لتُقرّر

87
00:06:22,400 --> 00:06:23,270
!اخرسي

88
00:06:25,440 --> 00:06:29,850
مهما كانت المشاعر المشمولة
،في جدال لوفي وأوسوبّ الأوّل

89
00:06:29,850 --> 00:06:32,280
...ومهمًا كان منهما على حقّ

90
00:06:32,280 --> 00:06:35,330
،فور أن يُقرّر المرء خوض نزال

91
00:06:35,330 --> 00:06:38,160
.فإنّ نتيجة النّزال هي ما تحسم ذلك الجدال

92
00:06:42,260 --> 00:06:46,200
.صحيح أنّ السّفينة تنتمي لك أنت القائد

93
00:06:46,200 --> 00:06:48,590
...لذلك قاتلني

94
00:06:49,280 --> 00:06:52,690
.سأهزمك وآخذ ميري

95
00:06:52,690 --> 00:06:54,100
!يا مونكي د. لوفي

96
00:06:54,770 --> 00:06:58,100
!خض نزالاً معي

97
00:06:59,670 --> 00:07:02,060
...لقد خسر

98
00:07:02,060 --> 00:07:04,400
.وافترق معنا بمحض إرادته

99
00:07:05,360 --> 00:07:09,320
،اسمعوا يا رفاق. قد يكون أبلهًا
.لكنّه لا يزال قائدنا

100
00:07:10,090 --> 00:07:12,880
،إلّم يُعامله أوسوبّ باحترام عند الأوقات الحرجة

101
00:07:12,880 --> 00:07:15,030
.فنحن أفضل حالاً من دونه في طاقمنا

102
00:07:15,500 --> 00:07:20,540
،إن توقّف القائد عن طلب الاحترام
.فسيتداعى طاقمه دون أدنى شكّ

103
00:07:24,880 --> 00:07:27,800
اسمع! لا أهتمّ إن كنت تريد
،معاملة أيّ شيء ببالٍ هانئ

104
00:07:28,390 --> 00:07:32,260
،لكن إن أظهرت أنت، قائدي، أيّ ضعف

105
00:07:32,260 --> 00:07:35,220
!فأنا من سيغادر هذا الطّاقم المرّة القادمة

106
00:07:36,470 --> 00:07:38,430
!مهلاً، ذلك لن يحلّ أيّ شيء

107
00:07:40,800 --> 00:07:45,400
.من الجيّد أنّ ذلك الأحمق يريد العودة الآن

108
00:07:45,400 --> 00:07:46,400
...لكن

109
00:07:47,270 --> 00:07:51,740
إن حاول تجاهل هذه المسألة
،دون تحمّل أيّ مسؤوليّة

110
00:07:52,350 --> 00:07:54,700
!فلن أقبل ذلك مهما كان

111
00:07:55,710 --> 00:07:58,350
.وإن حدث ذلك، سنتركه في هذه الجزيرة

112
00:07:58,910 --> 00:08:03,020
،انتظر يا زورو. صحيحٌ أنّ تصرّفاته لم تكن لائقة

113
00:08:03,020 --> 00:08:05,830
...لكن يمكننا أن نوبّخه فور أن يعـ

114
00:08:09,080 --> 00:08:12,840
!هل ترك الطّاقم أمرٌ تافه؟

115
00:08:12,840 --> 00:08:14,510
.لا

116
00:08:14,510 --> 00:08:15,710
...لكن

117
00:08:15,710 --> 00:08:17,350
.نامي-سان

118
00:08:18,330 --> 00:08:23,250
.مع الأسف، ما يقوله هذه المرّة صحيح

119
00:08:24,140 --> 00:08:30,010
لا يمكننا الوثوق برجل يفعل
.مثل ذلك بدون تفكير

120
00:08:30,780 --> 00:08:32,830
.هذا هو بيت القصيد

121
00:08:32,830 --> 00:08:36,410
إن كان أوّل ما ينطق به أوسوبّ
.هو اعتذار صادق، فلا بأس

122
00:08:36,870 --> 00:08:40,620
.وإلاّ لا مكان له بيننا يرجع إليه

123
00:08:43,690 --> 00:08:47,580
.لسنا أطفالاً يلعبون لعبة القراصنة

124
00:08:57,340 --> 00:08:59,760
.افعل ما تشاء بميري

125
00:09:01,900 --> 00:09:07,810
سنحصل على سفينة جديدة
!ونشدّ رحالنا في البحار القادمة

126
00:09:10,210 --> 00:09:12,240
...مع السّلامة يا أوسوبّ

127
00:09:12,240 --> 00:09:15,260
.قضينا أوقاتًا ممتعة

128
00:09:17,670 --> 00:09:19,240
.معك حقّ

129
00:09:19,240 --> 00:09:22,130
.لقد افترقنا

130
00:09:22,130 --> 00:09:25,840
ما زالت أمامنا بضعة أيّام إلى
.أن تكتمل السّفينة ونشدّ رحالنا

131
00:09:27,260 --> 00:09:29,250
.لنبقَ هنا فحسب وننتظره

132
00:09:31,260 --> 00:09:34,690
.انتظرته هناك طوال الوقت، لكنّه لم يعد

133
00:09:35,380 --> 00:09:36,550
.ذلك هو جوابه

134
00:09:39,320 --> 00:09:40,600
...قبّعة القشّ

135
00:09:40,970 --> 00:09:43,520
.أنا واثق... أنّه سيستمتع بحياته أيضًا

136
00:09:43,980 --> 00:09:49,150
،لن يترك القرصنة على الأغلب
!لذا آمل أن نقابله في البحر يومًا ما

137
00:09:58,240 --> 00:10:01,530
!حسنًا! سأعود إلى أصدقائي

138
00:10:01,930 --> 00:10:05,500
!لدينا سفينة عظيمة! إنّهم ينتظرونني

139
00:10:06,080 --> 00:10:09,240
المسألة هي كيف سأعود لهم بشكل طبيعيّ؟

140
00:10:09,240 --> 00:10:13,840
!لا يهمّ، كيفما تصرّفوا، لديّ مئة استراتيجيّة

141
00:10:14,600 --> 00:10:18,300
.على أولى كلماتي أن تكون هكذا في النّهاية

142
00:10:18,300 --> 00:10:21,450
،إن كنتم تترجّونني إلى حدّ البكاء"

143
00:10:21,450 --> 00:10:24,210
".أظنّني سأقبل العودة إن جعلتموني نائب القائد

144
00:10:24,210 --> 00:10:27,810
"!شكرًا لك يا نائب القائد أوسوبّ! مرحى"

145
00:10:28,290 --> 00:10:32,020
سنفعل أيّ ما تطلبه، لذا عد"
!إلينا رجاءً" قد يقولون هذا

146
00:10:33,270 --> 00:10:35,440
!يا لروعتي

147
00:10:35,440 --> 00:10:38,990
!أنا خير مثال للرّجل الّذي يستفيد من أخطائه

148
00:10:39,410 --> 00:10:44,450
في هذا الموقف المعكوس، سأحبّب
.نفسي لهم أكثر وأعيش بسعادة

149
00:10:45,110 --> 00:10:47,410
!حسنًا! يجب أن أسرع

150
00:10:48,080 --> 00:10:53,750
بقدر ما أريد أن أبقى، عليّ توديعك
!يا مدينة الماء، ووتر سيفن

151
00:10:59,220 --> 00:11:00,980
...أوسوبّ

152
00:11:01,590 --> 00:11:06,680
.لوفي، دعنا ننتظر أكثر قليلاً
.لسنا مستعجلين أو ما شابه

153
00:11:06,680 --> 00:11:08,760
!يا لوفي

154
00:11:12,890 --> 00:11:13,810
!ماذا؟

155
00:11:17,880 --> 00:11:20,610
!سحقًا! لقد وجدونا! إنّها البحريّة

156
00:11:22,090 --> 00:11:23,370
!جدّي؟

157
00:11:23,940 --> 00:11:25,890
!إنّها سفينة نائب الأميرال غارب البحريّة

158
00:11:25,890 --> 00:11:29,040
!أخي! قبّعة القشّ! ابتعدوا من هنا

159
00:11:30,230 --> 00:11:33,920
!يا لوفي! هل تسمعني؟

160
00:11:33,920 --> 00:11:38,380
!هذا جدّك! هذا جدّك
!إن كنت تسمعني، قل شيئًا

161
00:11:38,380 --> 00:11:40,780
!يا جدّي! ماذا تفعل؟

162
00:11:40,780 --> 00:11:43,840
!قلت أنّك لن تقبض علينا هنا

163
00:11:44,410 --> 00:11:46,950
.في الواقع، حدث الكثير مذّاك الحين

164
00:11:46,950 --> 00:11:49,310
!آسف، لكنّي سأغرقكم

165
00:11:49,310 --> 00:11:51,140
!ماذا؟

166
00:11:51,140 --> 00:11:54,220
،لا أفعل هذا كاعتذار على ذلك أو هكذا شيء

167
00:11:54,220 --> 00:11:56,220
!لكن سأقاتل طاقمك بنفسي

168
00:11:56,770 --> 00:11:57,480
.أعطوني قذيفة

169
00:11:58,490 --> 00:12:00,440
.تـ-تفضّل

170
00:12:01,690 --> 00:12:02,860
ما الّذي يحاول فعله؟

171
00:12:07,830 --> 00:12:11,330
!نيزك... البراجم

172
00:12:20,170 --> 00:12:24,640
!أ-أطلق قذيفة مدفعيّة بيده العارية

173
00:12:25,370 --> 00:12:27,600
قصفتنا بقوّة أكبر من القذائف
!الّتي يُطلقها المدفع

174
00:12:27,600 --> 00:12:29,220
!ليس وكأنّه يرمي كرة قاعدة

175
00:12:33,080 --> 00:12:35,850
.كانت قوّتي في تراجع مؤخّرًا

176
00:12:37,840 --> 00:12:40,030
!لا خيار أمامنا سوى الابتعاد من هنا فورًا

177
00:12:40,030 --> 00:12:42,690
!ستُفجّر سفينتنا الجديدة كليًّا

178
00:12:42,690 --> 00:12:44,880
!أحضروا لي ألف قذيفة مدفعيّة

179
00:12:44,880 --> 00:12:46,200
!حاضر

180
00:12:46,200 --> 00:12:46,740
!أسرعوا

181
00:12:51,560 --> 00:12:54,500
!هذا سيّئ! ستنهال علينا الكثير من تلك الأشياء

182
00:12:54,500 --> 00:12:56,350
!وابل نيازك البراجم

183
00:12:56,350 --> 00:13:01,600
.يا إلهي... لن تصمد أيّ سفينة أمام ذلك

184
00:13:10,930 --> 00:13:14,020
والآن، هل نبدأ يا فتيان؟

185
00:13:14,500 --> 00:13:18,980
!لا تظنّوا أنّكم تستطيعون الهرب منّي! استعدّوا

186
00:13:18,980 --> 00:13:23,000
!إلى الأمام بأقصى سرعة! سنعتني بأمر القذائف

187
00:13:23,000 --> 00:13:23,650
!مفهوم

188
00:13:26,980 --> 00:13:29,990
!سحقًا! ألن يأتي حقًّا؟

189
00:13:30,460 --> 00:13:32,020
ما الّذي يفعله؟

190
00:13:38,960 --> 00:13:40,840
!لقد أتى

191
00:13:42,660 --> 00:13:44,420
!أتى أوسوبّ

192
00:13:45,680 --> 00:13:49,290
!يا رفاق! لقد أتى أوسوبّ

193
00:13:49,290 --> 00:13:50,430
حقًّا؟

194
00:13:50,430 --> 00:13:51,680
!أجل

195
00:14:25,100 --> 00:14:27,260
!أفسحوا الطّريق! أفسحوا الطّريق

196
00:14:27,260 --> 00:14:30,470
!عـ-عذرًا! د-دعوني أعبر

197
00:14:30,470 --> 00:14:33,930
!صاحب الأنف! ماذا تفعل هنا؟

198
00:14:37,230 --> 00:14:39,450
مـ-ما الّذي يجري؟

199
00:14:40,240 --> 00:14:43,570
لِمَ يبحرون لمجرّد أنّ البحريّة هنا؟

200
00:14:43,570 --> 00:14:45,320
.حسبتُ أنّك ركبت معهم

201
00:14:45,320 --> 00:14:50,490
!ماذا تفعلون يا رفاق؟! ما زلتُ هنا

202
00:14:50,490 --> 00:14:54,520
!لماذا؟ لماذا؟ لماذا؟

203
00:14:54,520 --> 00:14:58,970
!حتّى بعد أن قاتلنا سويًّا بعد جدالنا؟

204
00:15:01,000 --> 00:15:01,980
.سوغيكينغ

205
00:15:03,290 --> 00:15:05,250
.أطلق على ذلك العلم

206
00:15:05,250 --> 00:15:06,630
.عُلم

207
00:15:07,380 --> 00:15:10,800
هذا سلاحي الجديد، المقلاع
!الضّخم... وأسميته كابوتو

208
00:15:11,340 --> 00:15:13,760
!أمعنوا النّظر إلى قوّته

209
00:15:13,760 --> 00:15:17,180
!القتل المؤكّد: نجم طائر النّار

210
00:15:22,370 --> 00:15:23,060
...ذلك

211
00:15:23,060 --> 00:15:24,790
!تبًّا

212
00:15:27,570 --> 00:15:29,080
!أنت سيف

213
00:15:29,080 --> 00:15:31,110
!ليحضر لي أحد محاميًا

214
00:15:41,130 --> 00:15:42,670
.لا تقولوا أنّكم نسيتم

215
00:15:43,240 --> 00:15:47,630
!أنا من قاتل ببسالة كملك القنّاصين، سوغيكينغ

216
00:15:49,670 --> 00:15:54,140
!هل تخلّيتم عنّي لأنّني اختفيت؟

217
00:15:54,710 --> 00:15:56,390
!انتظروا

218
00:15:58,260 --> 00:16:01,520
!اسمع! الدّرج مكسور! احترس

219
00:16:01,520 --> 00:16:03,230
!ما الّذي يجري؟ أنتم

220
00:16:06,370 --> 00:16:09,300
!يا رفاق! لا داعي للقلق بعد الآن

221
00:16:09,300 --> 00:16:14,920
!عدتُ لكم يا رفاق

222
00:16:24,640 --> 00:16:25,940
...أيّها الأنذال

223
00:16:28,130 --> 00:16:29,510
!...توقّفوا

224
00:16:40,350 --> 00:16:43,350
!فاكهة المطّاط: البالون

225
00:16:57,510 --> 00:17:00,830
!أوسوبّ قادم يا لوفي! أوسوبّ قادم

226
00:17:01,540 --> 00:17:03,910
!احموا السّفينة

227
00:17:07,040 --> 00:17:10,460
!افرحوا! هذا أنا

228
00:17:11,060 --> 00:17:15,370
!تشوبّر! الطّقس جميل اليوم
!لنصطد بعض الأسماك

229
00:17:15,370 --> 00:17:18,220
!حسنًا، أظنّ أنّ الوقت ليس مناسبًا لذلك

230
00:17:19,500 --> 00:17:21,890
!صحيح، لديّ أخبار سارّة

231
00:17:21,890 --> 00:17:23,980
،صدّقوا أم لا، لكن عندما أعود

232
00:17:24,490 --> 00:17:28,440
!لن أمانع أن أكون نائب القائد! ما رأيكم؟

233
00:17:28,440 --> 00:17:32,220
!يا لوفي! رفاق

234
00:17:32,220 --> 00:17:33,440
!أعلم

235
00:17:34,040 --> 00:17:36,950
!أنتم تبكون من شدّة الفرح، صحيح؟

236
00:17:37,490 --> 00:17:39,660
!تبكون، أليس كذلك؟

237
00:17:40,430 --> 00:17:44,670
.لوفي! لا أستطيع مرافقتك بعد الآن

238
00:17:44,670 --> 00:17:47,920
.آسف لتسبّبي بالمشاكل حتّى الآن

239
00:17:47,920 --> 00:17:52,340
!لا تقل أنّك صدّقت تلك المزحة بالفعل

240
00:17:52,800 --> 00:17:54,300
!نحن أصدقاء منذ وقت طويل

241
00:17:54,300 --> 00:17:57,480
!محالٌ أن أقول شيئًا كذاك بجدّ

242
00:17:57,480 --> 00:17:59,810
،مع أنّنا تبادلنا الكثير من الكلام
!إلاّ أنّنا نظلّ أصدقاء

243
00:17:59,810 --> 00:18:02,310
!سأنسى هذه الأشياء التّافهة

244
00:18:02,740 --> 00:18:03,640
!اسمعوا

245
00:18:04,570 --> 00:18:06,350
!قولوا شيئًا

246
00:18:17,090 --> 00:18:19,740
!يكفي أيّها الأنذال

247
00:18:30,030 --> 00:18:32,090
!لوفي! أوسوبّ يتحدّث لنا

248
00:18:33,040 --> 00:18:34,130
.لا أسمعه

249
00:18:36,130 --> 00:18:37,600
!زورو

250
00:18:37,600 --> 00:18:38,720
!لا أسمع أيّ شيء

251
00:18:39,100 --> 00:18:41,430
!هذا كذب! واثق أنّكما تسمعان

252
00:18:52,380 --> 00:18:55,280
.كفّوا... عن المزاح

253
00:18:56,460 --> 00:18:57,490
.هكذا الأمر إذًا

254
00:18:57,490 --> 00:19:00,270
تحاولون فراقي حقًّا إذًا؟

255
00:19:00,880 --> 00:19:03,700
.فهمت... فليكن

256
00:19:04,740 --> 00:19:09,460
اسمع يا لوفي! لا يستطيع الجميع
!العيش والتّطلّع للأمام مثلك

257
00:19:10,110 --> 00:19:13,880
لا أستطيع التّخلّي عن صديق مصاب
!هنا ومواصلة ترحالي في البحار

258
00:19:16,170 --> 00:19:20,760
باشر بالتّخلّص من أصدقائك غير المفيدين
.الواحد تلو الآخر وواصل تقدّمك

259
00:19:21,590 --> 00:19:23,720
.كنت أفكّر في هذا لفترة

260
00:19:25,390 --> 00:19:26,770
،بصراحة

261
00:19:26,770 --> 00:19:31,030
كنت أفكّر أنّه ليس باستطاعتي
.مجاراة قواكم الوحشيّة

262
00:19:35,340 --> 00:19:38,180
لا تحتاج أصدقاء ضعفاء، صحيح؟

263
00:19:38,180 --> 00:19:43,000
.لوفي... أنت الرّجل الّذي سيصبح ملك القراصنة

264
00:19:43,740 --> 00:19:47,620
.لكن ليس عليّ الارتقاء معك لتلك الدّرجة

265
00:19:47,620 --> 00:19:54,540
بالتّفكير في الأمر، عندما كنتُ أوشك
.على الإبحار، طلبتم منّي الانضمام لكم

266
00:19:59,560 --> 00:20:01,010
.ذلك كلّ ما يربط بيننا

267
00:20:01,870 --> 00:20:05,990
ليس علينا الإبحار معًا عندما
!يكون لدينا اختلاف آراء

268
00:20:06,660 --> 00:20:08,700
...إن كان هذا ما تريدون

269
00:20:09,600 --> 00:20:13,320
...دعوني أخبركم بشيء أخير

270
00:20:14,190 --> 00:20:16,270
.حيث أذهب الآن هو شأني أنا

271
00:20:16,700 --> 00:20:19,850
.لم يعد لديكم علاقة بذلك يا رفاق

272
00:20:20,590 --> 00:20:21,880
...أنا

273
00:20:21,880 --> 00:20:25,330
.سأترك الطّاقم

274
00:20:35,960 --> 00:20:39,420
!أنا آسف

275
00:20:40,880 --> 00:20:43,820
!آسف لأنّي عنيد

276
00:20:43,820 --> 00:20:47,600
!كنتُ مخطئًا

277
00:20:57,190 --> 00:20:58,360
!أوسوبّ

278
00:21:01,590 --> 00:21:07,320
.أعلم أنّي مثير للشّفقة
.أعلم أنّني قلتُ أنّي سأترك الطّاقم

279
00:21:07,320 --> 00:21:12,790
!لكن... أيمكنني أن أسحب كلامي؟

280
00:21:13,510 --> 00:21:15,100
!أيمكنني ذلك؟

281
00:21:15,100 --> 00:21:17,500
!رجاءً

282
00:21:20,510 --> 00:21:23,100
...أرجوكم أن تدعوني

283
00:21:23,100 --> 00:21:26,840
!أبقى معكم

284
00:21:27,450 --> 00:21:29,350
...مرّة أخرى

285
00:21:29,350 --> 00:21:34,020
!دعوني أنضمّ لكم يا رفاق

286
00:21:49,260 --> 00:21:51,030
...لوفي

287
00:21:51,030 --> 00:21:55,400
!أيّها الغبيّ! أمسك بيدي بسرعة

288
00:22:08,080 --> 00:22:09,680
!أنت الغبيّ

289
00:22:12,270 --> 00:22:14,640
!أنتما سخيفان

290
00:22:25,440 --> 00:22:27,860
!صعد الجميع أخيرًا

291
00:22:28,350 --> 00:22:30,550
سنسرع باجتياز هذه القذائف المدفعيّة

292
00:22:30,550 --> 00:22:33,720
!لكي نستأنف رحلتنا يا رفاق

293
00:22:33,720 --> 00:22:35,750
!أجل

294
00:22:45,170 --> 00:22:48,670
.بالمناسبة يا تشوبّر. ثمّة مكافأة علينا أخيرًا أيضًا

295
00:22:49,760 --> 00:22:51,760
!كما قلت، لا يمكنني قبول ذلك

296
00:22:51,760 --> 00:22:54,990
خمسون...؟ خمسون...؟

297
00:22:54,990 --> 00:22:58,020
نوجيكو وغين-سان والجميع
...في قرية كوكوياشي

298
00:22:58,020 --> 00:23:00,690
أتساءل كيف سيكون شعورهم
...عند رؤية هذا

299
00:23:00,690 --> 00:23:01,880
:في الحلقة القادمة من وان بيس

300
00:23:01,880 --> 00:23:04,940
!ملصقات المطلوبين تنتشر حول العالم"
"!احتفالات في أوطانهم بينما تتقدّم السّفينة

301
00:23:04,940 --> 00:23:07,590
!ملك القراصنة، لن يكون إلاّ أنا

302
00:23:10,050 --> 00:23:15,050
نلقاكم في الحلقة القادمة