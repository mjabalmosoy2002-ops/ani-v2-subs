1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:28,570 --> 00:02:30,560
!زورو! سانجي

33
00:02:30,990 --> 00:02:32,560
!مصيبة

34
00:02:33,050 --> 00:02:36,110
!عاد جدّك يا لوفي

35
00:02:36,110 --> 00:02:37,560
.إنّهم في السّاحل المقابل

36
00:02:37,560 --> 00:02:40,270
!إنّهم يبحثون عنّا الآن! سيهاجموننا

37
00:02:40,270 --> 00:02:44,240
.ماذا؟! لماذا؟! قال أنّه لن يقبض علينا

38
00:02:44,890 --> 00:02:48,110
!وما أدرانا؟! استعدّوا للإبحار بسرعة

39
00:02:51,990 --> 00:02:52,790
!سأعيده لك

40
00:03:01,060 --> 00:03:03,460
...والآن، اركب معنا يا فرانكي

41
00:03:04,090 --> 00:03:05,840
.اركب سفينتي

42
00:03:07,450 --> 00:03:09,890
!لا تعتدّ بنفسك

43
00:03:09,890 --> 00:03:13,220
أنتم هوّاة تمامًا بالكاد تستطيعون
!تدبّر التّرقيعات المؤقّتة

44
00:03:13,220 --> 00:03:18,850
سيكون من المؤسف ألاّ تملك هذه
.السّفينة العظيمة نجّار سفن على متنها

45
00:03:18,850 --> 00:03:21,980
!أظنّني لا أملك خيارًا عدا مساعدتكم

46
00:03:21,980 --> 00:03:27,240
!أنا فرانكي، سأكون نجّار سفينتكم

47
00:03:30,400 --> 00:03:35,620
!مغادرة مدينة الماء"
"!يضع الرّجل أوسوبّ خاتمة للنّزال

48
00:03:38,570 --> 00:03:40,070
!يا نائب الأميرال غارب

49
00:03:42,170 --> 00:03:44,080
!وجدنا طاقم قبّعة القشّ

50
00:03:44,080 --> 00:03:48,550
إنّهم في جزيرة الخردة في السّاحل
!الجنوب شرقيّ، ويوشكون على الإبحار

51
00:03:48,550 --> 00:03:51,580
!سنتّجه إلى هناك حالاً! اركبوا على فور

52
00:03:51,580 --> 00:03:52,510
!حاضر

53
00:04:01,980 --> 00:04:06,230
يا نائب الأميرال غارب! سبق وافترقنا
.بلطافة مع لوفي-سان والبقيّة

54
00:04:06,230 --> 00:04:08,070
!هذا محرج للغاية

55
00:04:08,070 --> 00:04:09,700
!إن كانت لديك شكوى، وجّهها لسنغوكو

56
00:04:10,130 --> 00:04:13,160
!هو من وبّخني وأخبرني أن أعود إلى هنا

57
00:04:13,780 --> 00:04:15,120
.يا له من متسلّط

58
00:04:16,370 --> 00:04:19,870
ذلك لأنّك قلتَ له عبر حلزون
"...الاتّصال، "إنّه حفيدي، لذا

59
00:04:20,270 --> 00:04:23,840
.اخرس! اهتمّ بشؤونك أيّها الغرّ

60
00:04:25,110 --> 00:04:29,280
أ-أيّها الأميرال، ماذا عنك؟
ألا بأس أن تكون هنا؟

61
00:04:29,280 --> 00:04:33,800
.من الشّاقّ جدًّا العودة بالدرّاجة
.لا تقلقوا، لن أفعل شيئًا

62
00:04:35,170 --> 00:04:38,980
أظنّ أنّ ذلك سيكون مشكلة أيضًا
.عند مواجهة العدوّ

63
00:04:39,510 --> 00:04:41,720
!افردوا الأشرعة

64
00:04:44,440 --> 00:04:49,900
!يا أخي! اعتن بنفسك جيّدًا

65
00:04:49,900 --> 00:04:52,910
!ستواصل عائلة فرانكي العيش إلى الأبد

66
00:04:53,600 --> 00:04:56,370
!يا طاقم قبّعة القشّ! اعتنوا بأنفسكم أيضًا

67
00:04:57,200 --> 00:04:59,140
!مهلاً يا لوفي

68
00:04:59,140 --> 00:05:00,580
!لوفي

69
00:05:01,750 --> 00:05:06,040
أواثق حقًّا أنّك لست بحاجة لانتظار
شخص آخر يا قبّعة القشّ؟

70
00:05:06,690 --> 00:05:10,510
،انتظرتُ بالفعل. مذ سمعتُ ما قاله سانجي

71
00:05:11,060 --> 00:05:14,450
.حاولتُ لكي لا تكون غرفتنا في غالي-لا فارغة

72
00:05:18,400 --> 00:05:21,390
!ماذا؟ أوسوبّ سيعود؟

73
00:05:21,850 --> 00:05:25,900
نعم. كان يتدرّب بمفرده على كيف
.سينضمّ لنا من جديد في السّاحل

74
00:05:30,590 --> 00:05:34,030
.حقًّا؟! يريد أن يعود حقًّا إذًا

75
00:05:34,030 --> 00:05:36,440
!لنذهب لأخذه على الفور إذًا

76
00:05:36,440 --> 00:05:37,710
!أجل

77
00:05:37,710 --> 00:05:39,790
.دائمًا ما يفعل الأمور بالطّريقة الشّاقّة

78
00:05:40,970 --> 00:05:44,000
!أوسوبّ سيعود

79
00:05:44,450 --> 00:05:46,000
!انتظروا يا رفاق

80
00:05:48,420 --> 00:05:52,380
.لن أسمح لأيّ منّا بالذّهاب لأخذه

81
00:05:52,380 --> 00:05:53,720
ماذا؟ لماذا؟

82
00:05:55,070 --> 00:05:58,640
.أيّما فعلت، لا تتصرّف معه بإذلال يا لوفي

83
00:05:59,900 --> 00:06:00,810
...زورو

84
00:06:00,810 --> 00:06:04,980
.لن أقبل عودته إلى أن يعتذر أوّلاً

85
00:06:04,980 --> 00:06:08,400
!زورو! لماذا؟

86
00:06:06,420 --> 00:06:08,400
...مهلاً! من أنت لتُقرّر

87
00:06:08,400 --> 00:06:09,270
!اخرسي

88
00:06:11,440 --> 00:06:15,850
مهما كانت المشاعر المشمولة
،في جدال لوفي وأوسوبّ الأوّل

89
00:06:15,850 --> 00:06:18,280
...ومهمًا كان منهما على حقّ

90
00:06:18,280 --> 00:06:21,330
،فور أن يُقرّر المرء خوض نزال

91
00:06:21,330 --> 00:06:24,160
.فإنّ نتيجة النّزال هي ما تحسم ذلك الجدال

92
00:06:28,260 --> 00:06:32,200
.صحيح أنّ السّفينة تنتمي لك أنت القائد

93
00:06:32,200 --> 00:06:34,590
...لذلك قاتلني

94
00:06:35,280 --> 00:06:38,690
.سأهزمك وآخذ ميري

95
00:06:38,690 --> 00:06:40,100
!يا مونكي د. لوفي

96
00:06:40,770 --> 00:06:44,100
!خض نزالاً معي

97
00:06:45,670 --> 00:06:48,060
...لقد خسر

98
00:06:48,060 --> 00:06:50,400
.وافترق معنا بمحض إرادته

99
00:06:51,360 --> 00:06:55,320
،اسمعوا يا رفاق. قد يكون أبلهًا
.لكنّه لا يزال قائدنا

100
00:06:56,090 --> 00:06:58,880
،إلّم يُعامله أوسوبّ باحترام عند الأوقات الحرجة

101
00:06:58,880 --> 00:07:01,030
.فنحن أفضل حالاً من دونه في طاقمنا

102
00:07:01,500 --> 00:07:06,540
،إن توقّف القائد عن طلب الاحترام
.فسيتداعى طاقمه دون أدنى شكّ

103
00:07:10,880 --> 00:07:13,800
اسمع! لا أهتمّ إن كنت تريد
،معاملة أيّ شيء ببالٍ هانئ

104
00:07:14,390 --> 00:07:18,260
،لكن إن أظهرت أنت، قائدي، أيّ ضعف

105
00:07:18,260 --> 00:07:21,220
!فأنا من سيغادر هذا الطّاقم المرّة القادمة

106
00:07:22,470 --> 00:07:24,430
!مهلاً، ذلك لن يحلّ أيّ شيء

107
00:07:26,800 --> 00:07:31,400
.من الجيّد أنّ ذلك الأحمق يريد العودة الآن

108
00:07:31,400 --> 00:07:32,400
...لكن

109
00:07:33,270 --> 00:07:37,740
إن حاول تجاهل هذه المسألة
،دون تحمّل أيّ مسؤوليّة

110
00:07:38,350 --> 00:07:40,700
!فلن أقبل ذلك مهما كان

111
00:07:41,710 --> 00:07:44,350
.وإن حدث ذلك، سنتركه في هذه الجزيرة

112
00:07:44,910 --> 00:07:49,020
،انتظر يا زورو. صحيحٌ أنّ تصرّفاته لم تكن لائقة

113
00:07:49,020 --> 00:07:51,830
...لكن يمكننا أن نوبّخه فور أن يعـ

114
00:07:55,080 --> 00:07:58,840
!هل ترك الطّاقم أمرٌ تافه؟

115
00:07:58,840 --> 00:08:00,510
.لا

116
00:08:00,510 --> 00:08:01,710
...لكن

117
00:08:01,710 --> 00:08:03,350
.نامي-سان

118
00:08:04,330 --> 00:08:09,250
.مع الأسف، ما يقوله هذه المرّة صحيح

119
00:08:10,140 --> 00:08:16,010
لا يمكننا الوثوق برجل يفعل
.مثل ذلك بدون تفكير

120
00:08:16,780 --> 00:08:18,830
.هذا هو بيت القصيد

121
00:08:18,830 --> 00:08:22,410
إن كان أوّل ما ينطق به أوسوبّ
.هو اعتذار صادق، فلا بأس

122
00:08:22,870 --> 00:08:26,620
.وإلاّ لا مكان له بيننا يرجع إليه

123
00:08:29,690 --> 00:08:33,580
.لسنا أطفالاً يلعبون لعبة القراصنة

124
00:08:43,340 --> 00:08:45,760
.افعل ما تشاء بميري

125
00:08:47,900 --> 00:08:53,810
سنحصل على سفينة جديدة
!ونشدّ رحالنا في البحار القادمة

126
00:08:56,210 --> 00:08:58,240
...مع السّلامة يا أوسوبّ

127
00:08:58,240 --> 00:09:01,260
.قضينا أوقاتًا ممتعة

128
00:09:03,670 --> 00:09:05,240
.معك حقّ

129
00:09:05,240 --> 00:09:08,130
.لقد افترقنا

130
00:09:08,130 --> 00:09:11,840
ما زالت أمامنا بضعة أيّام إلى
.أن تكتمل السّفينة ونشدّ رحالنا

131
00:09:13,260 --> 00:09:15,250
.لنبقَ هنا فحسب وننتظره

132
00:09:17,260 --> 00:09:20,690
.انتظرته هناك طوال الوقت، لكنّه لم يعد

133
00:09:21,380 --> 00:09:22,550
.ذلك هو جوابه

134
00:09:25,320 --> 00:09:26,600
...قبّعة القشّ

135
00:09:26,970 --> 00:09:29,520
.أنا واثق... أنّه سيستمتع بحياته أيضًا

136
00:09:29,980 --> 00:09:35,150
،لن يترك القرصنة على الأغلب
!لذا آمل أن نقابله في البحر يومًا ما

137
00:09:44,240 --> 00:09:47,530
!حسنًا! سأعود إلى أصدقائي

138
00:09:47,930 --> 00:09:51,500
!لدينا سفينة عظيمة! إنّهم ينتظرونني

139
00:09:52,080 --> 00:09:55,240
المسألة هي كيف سأعود لهم بشكل طبيعيّ؟

140
00:09:55,240 --> 00:09:59,840
!لا يهمّ، كيفما تصرّفوا، لديّ مئة استراتيجيّة

141
00:10:00,600 --> 00:10:04,300
.على أولى كلماتي أن تكون هكذا في النّهاية

142
00:10:04,300 --> 00:10:07,450
،إن كنتم تترجّونني إلى حدّ البكاء"

143
00:10:07,450 --> 00:10:10,210
".أظنّني سأقبل العودة إن جعلتموني نائب القائد

144
00:10:10,210 --> 00:10:13,810
"!شكرًا لك يا نائب القائد أوسوبّ! مرحى"

145
00:10:14,290 --> 00:10:18,020
سنفعل أيّ ما تطلبه، لذا عد"
!إلينا رجاءً" قد يقولون هذا

146
00:10:19,270 --> 00:10:21,440
!يا لروعتي

147
00:10:21,440 --> 00:10:24,990
!أنا خير مثال للرّجل الّذي يستفيد من أخطائه

148
00:10:25,410 --> 00:10:30,450
في هذا الموقف المعكوس، سأحبّب
.نفسي لهم أكثر وأعيش بسعادة

149
00:10:31,110 --> 00:10:33,410
!حسنًا! يجب أن أسرع

150
00:10:34,080 --> 00:10:39,750
بقدر ما أريد أن أبقى، عليّ توديعك
!يا مدينة الماء، ووتر سيفن

151
00:10:45,220 --> 00:10:46,980
...أوسوبّ

152
00:10:47,590 --> 00:10:52,680
.لوفي، دعنا ننتظر أكثر قليلاً
.لسنا مستعجلين أو ما شابه

153
00:10:52,680 --> 00:10:54,760
!يا لوفي

154
00:10:58,890 --> 00:10:59,810
!ماذا؟

155
00:11:03,880 --> 00:11:06,610
!سحقًا! لقد وجدونا! إنّها البحريّة

156
00:11:08,090 --> 00:11:09,370
!جدّي؟

157
00:11:09,940 --> 00:11:11,890
!إنّها سفينة نائب الأميرال غارب البحريّة

158
00:11:11,890 --> 00:11:15,040
!أخي! قبّعة القشّ! ابتعدوا من هنا

159
00:11:16,230 --> 00:11:19,920
!يا لوفي! هل تسمعني؟

160
00:11:19,920 --> 00:11:24,380
!هذا جدّك! هذا جدّك
!إن كنت تسمعني، قل شيئًا

161
00:11:24,380 --> 00:11:26,780
!يا جدّي! ماذا تفعل؟

162
00:11:26,780 --> 00:11:29,840
!قلت أنّك لن تقبض علينا هنا

163
00:11:30,410 --> 00:11:32,950
.في الواقع، حدث الكثير مذّاك الحين

164
00:11:32,950 --> 00:11:35,310
!آسف، لكنّي سأغرقكم

165
00:11:35,310 --> 00:11:37,140
!ماذا؟

166
00:11:37,140 --> 00:11:40,220
،لا أفعل هذا كاعتذار على ذلك أو هكذا شيء

167
00:11:40,220 --> 00:11:42,220
!لكن سأقاتل طاقمك بنفسي

168
00:11:42,770 --> 00:11:43,480
.أعطوني قذيفة

169
00:11:44,490 --> 00:11:46,440
.تـ-تفضّل

170
00:11:47,690 --> 00:11:48,860
ما الّذي يحاول فعله؟

171
00:11:53,830 --> 00:11:57,330
!نيزك... البراجم

172
00:12:06,170 --> 00:12:10,640
!أ-أطلق قذيفة مدفعيّة بيده العارية

173
00:12:11,370 --> 00:12:13,600
قصفتنا بقوّة أكبر من القذائف
!الّتي يُطلقها المدفع

174
00:12:13,600 --> 00:12:15,220
!ليس وكأنّه يرمي كرة قاعدة

175
00:12:19,080 --> 00:12:21,850
.كانت قوّتي في تراجع مؤخّرًا

176
00:12:23,840 --> 00:12:26,030
!لا خيار أمامنا سوى الابتعاد من هنا فورًا

177
00:12:26,030 --> 00:12:28,690
!ستُفجّر سفينتنا الجديدة كليًّا

178
00:12:28,690 --> 00:12:30,880
!أحضروا لي ألف قذيفة مدفعيّة

179
00:12:30,880 --> 00:12:32,200
!حاضر

180
00:12:32,200 --> 00:12:32,740
!أسرعوا

181
00:12:37,560 --> 00:12:40,500
!هذا سيّئ! ستنهال علينا الكثير من تلك الأشياء

182
00:12:40,500 --> 00:12:42,350
!وابل نيازك البراجم

183
00:12:42,350 --> 00:12:47,600
.يا إلهي... لن تصمد أيّ سفينة أمام ذلك

184
00:12:56,930 --> 00:13:00,020
والآن، هل نبدأ يا فتيان؟

185
00:13:00,500 --> 00:13:04,980
!لا تظنّوا أنّكم تستطيعون الهرب منّي! استعدّوا

186
00:13:04,980 --> 00:13:09,000
!إلى الأمام بأقصى سرعة! سنعتني بأمر القذائف

187
00:13:09,000 --> 00:13:09,650
!مفهوم

188
00:13:12,980 --> 00:13:15,990
!سحقًا! ألن يأتي حقًّا؟

189
00:13:16,460 --> 00:13:18,020
ما الّذي يفعله؟

190
00:13:24,960 --> 00:13:26,840
!لقد أتى

191
00:13:28,660 --> 00:13:30,420
!أتى أوسوبّ

192
00:13:31,680 --> 00:13:35,290
!يا رفاق! لقد أتى أوسوبّ

193
00:13:35,290 --> 00:13:36,430
حقًّا؟

194
00:13:36,430 --> 00:13:37,680
!أجل

195
00:14:11,100 --> 00:14:13,260
!أفسحوا الطّريق! أفسحوا الطّريق

196
00:14:13,260 --> 00:14:16,470
!عـ-عذرًا! د-دعوني أعبر

197
00:14:16,470 --> 00:14:19,930
!صاحب الأنف! ماذا تفعل هنا؟

198
00:14:23,230 --> 00:14:25,450
مـ-ما الّذي يجري؟

199
00:14:26,240 --> 00:14:29,570
لِمَ يبحرون لمجرّد أنّ البحريّة هنا؟

200
00:14:29,570 --> 00:14:31,320
.حسبتُ أنّك ركبت معهم

201
00:14:31,320 --> 00:14:36,490
!ماذا تفعلون يا رفاق؟! ما زلتُ هنا

202
00:14:36,490 --> 00:14:40,520
!لماذا؟ لماذا؟ لماذا؟

203
00:14:40,520 --> 00:14:44,970
!حتّى بعد أن قاتلنا سويًّا بعد جدالنا؟

204
00:14:47,000 --> 00:14:47,980
.سوغيكينغ

205
00:14:49,290 --> 00:14:51,250
.أطلق على ذلك العلم

206
00:14:51,250 --> 00:14:52,630
.عُلم

207
00:14:53,380 --> 00:14:56,800
هذا سلاحي الجديد، المقلاع
!الضّخم... وأسميته كابوتو

208
00:14:57,340 --> 00:14:59,760
!أمعنوا النّظر إلى قوّته

209
00:14:59,760 --> 00:15:03,180
!القتل المؤكّد: نجم طائر النّار

210
00:15:08,370 --> 00:15:09,060
...ذلك

211
00:15:09,060 --> 00:15:10,790
!تبًّا

212
00:15:13,570 --> 00:15:15,080
!أنت سيف

213
00:15:15,080 --> 00:15:17,110
!ليحضر لي أحد محاميًا

214
00:15:27,130 --> 00:15:28,670
.لا تقولوا أنّكم نسيتم

215
00:15:29,240 --> 00:15:33,630
!أنا من قاتل ببسالة كملك القنّاصين، سوغيكينغ

216
00:15:35,670 --> 00:15:40,140
!هل تخلّيتم عنّي لأنّني اختفيت؟

217
00:15:40,710 --> 00:15:42,390
!انتظروا

218
00:15:44,260 --> 00:15:47,520
!اسمع! الدّرج مكسور! احترس

219
00:15:47,520 --> 00:15:49,230
!ما الّذي يجري؟ أنتم

220
00:15:52,370 --> 00:15:55,300
!يا رفاق! لا داعي للقلق بعد الآن

221
00:15:55,300 --> 00:16:00,920
!عدتُ لكم يا رفاق

222
00:16:10,640 --> 00:16:11,940
...أيّها الأنذال

223
00:16:14,130 --> 00:16:15,510
!...توقّفوا

224
00:16:26,350 --> 00:16:29,350
!فاكهة المطّاط: البالون

225
00:16:43,510 --> 00:16:46,830
!أوسوبّ قادم يا لوفي! أوسوبّ قادم

226
00:16:47,540 --> 00:16:49,910
!احموا السّفينة

227
00:16:53,040 --> 00:16:56,460
!افرحوا! هذا أنا

228
00:16:57,060 --> 00:17:01,370
!تشوبّر! الطّقس جميل اليوم
!لنصطد بعض الأسماك

229
00:17:01,370 --> 00:17:04,220
!حسنًا، أظنّ أنّ الوقت ليس مناسبًا لذلك

230
00:17:05,500 --> 00:17:07,890
!صحيح، لديّ أخبار سارّة

231
00:17:07,890 --> 00:17:09,980
،صدّقوا أم لا، لكن عندما أعود

232
00:17:10,490 --> 00:17:14,440
!لن أمانع أن أكون نائب القائد! ما رأيكم؟

233
00:17:14,440 --> 00:17:18,220
!يا لوفي! رفاق

234
00:17:18,220 --> 00:17:19,440
!أعلم

235
00:17:20,040 --> 00:17:22,950
!أنتم تبكون من شدّة الفرح، صحيح؟

236
00:17:23,490 --> 00:17:25,660
!تبكون، أليس كذلك؟

237
00:17:26,430 --> 00:17:30,670
.لوفي! لا أستطيع مرافقتك بعد الآن

238
00:17:30,670 --> 00:17:33,920
.آسف لتسبّبي بالمشاكل حتّى الآن

239
00:17:33,920 --> 00:17:38,340
!لا تقل أنّك صدّقت تلك المزحة بالفعل

240
00:17:38,800 --> 00:17:40,300
!نحن أصدقاء منذ وقت طويل

241
00:17:40,300 --> 00:17:43,480
!محالٌ أن أقول شيئًا كذاك بجدّ

242
00:17:43,480 --> 00:17:45,810
،مع أنّنا تبادلنا الكثير من الكلام
!إلاّ أنّنا نظلّ أصدقاء

243
00:17:45,810 --> 00:17:48,310
!سأنسى هذه الأشياء التّافهة

244
00:17:48,740 --> 00:17:49,640
!اسمعوا

245
00:17:50,570 --> 00:17:52,350
!قولوا شيئًا

246
00:18:03,090 --> 00:18:05,740
!يكفي أيّها الأنذال

247
00:18:16,030 --> 00:18:18,090
!لوفي! أوسوبّ يتحدّث لنا

248
00:18:19,040 --> 00:18:20,130
.لا أسمعه

249
00:18:22,130 --> 00:18:23,600
!زورو

250
00:18:23,600 --> 00:18:24,720
!لا أسمع أيّ شيء

251
00:18:25,100 --> 00:18:27,430
!هذا كذب! واثق أنّكما تسمعان

252
00:18:38,380 --> 00:18:41,280
.كفّوا... عن المزاح

253
00:18:42,460 --> 00:18:43,490
.هكذا الأمر إذًا

254
00:18:43,490 --> 00:18:46,270
تحاولون فراقي حقًّا إذًا؟

255
00:18:46,880 --> 00:18:49,700
.فهمت... فليكن

256
00:18:50,740 --> 00:18:55,460
اسمع يا لوفي! لا يستطيع الجميع
!العيش والتّطلّع للأمام مثلك

257
00:18:56,110 --> 00:18:59,880
لا أستطيع التّخلّي عن صديق مصاب
!هنا ومواصلة ترحالي في البحار

258
00:19:02,170 --> 00:19:06,760
باشر بالتّخلّص من أصدقائك غير المفيدين
.الواحد تلو الآخر وواصل تقدّمك

259
00:19:07,590 --> 00:19:09,720
.كنت أفكّر في هذا لفترة

260
00:19:11,390 --> 00:19:12,770
،بصراحة

261
00:19:12,770 --> 00:19:17,030
كنت أفكّر أنّه ليس باستطاعتي
.مجاراة قواكم الوحشيّة

262
00:19:21,340 --> 00:19:24,180
لا تحتاج أصدقاء ضعفاء، صحيح؟

263
00:19:24,180 --> 00:19:29,000
.لوفي... أنت الرّجل الّذي سيصبح ملك القراصنة

264
00:19:29,740 --> 00:19:33,620
.لكن ليس عليّ الارتقاء معك لتلك الدّرجة

265
00:19:33,620 --> 00:19:40,540
بالتّفكير في الأمر، عندما كنتُ أوشك
.على الإبحار، طلبتم منّي الانضمام لكم

266
00:19:45,560 --> 00:19:47,010
.ذلك كلّ ما يربط بيننا

267
00:19:47,870 --> 00:19:51,990
ليس علينا الإبحار معًا عندما
!يكون لدينا اختلاف آراء

268
00:19:52,660 --> 00:19:54,700
...إن كان هذا ما تريدون

269
00:19:55,600 --> 00:19:59,320
...دعوني أخبركم بشيء أخير

270
00:20:00,190 --> 00:20:02,270
.حيث أذهب الآن هو شأني أنا

271
00:20:02,700 --> 00:20:05,850
.لم يعد لديكم علاقة بذلك يا رفاق

272
00:20:06,590 --> 00:20:07,880
...أنا

273
00:20:07,880 --> 00:20:11,330
.سأترك الطّاقم

274
00:20:21,960 --> 00:20:25,420
!أنا آسف

275
00:20:26,880 --> 00:20:29,820
!آسف لأنّي عنيد

276
00:20:29,820 --> 00:20:33,600
!كنتُ مخطئًا

277
00:20:43,190 --> 00:20:44,360
!أوسوبّ

278
00:20:47,590 --> 00:20:53,320
.أعلم أنّي مثير للشّفقة
.أعلم أنّني قلتُ أنّي سأترك الطّاقم

279
00:20:53,320 --> 00:20:58,790
!لكن... أيمكنني أن أسحب كلامي؟

280
00:20:59,510 --> 00:21:01,100
!أيمكنني ذلك؟

281
00:21:01,100 --> 00:21:03,500
!رجاءً

282
00:21:06,510 --> 00:21:09,100
...أرجوكم أن تدعوني

283
00:21:09,100 --> 00:21:12,840
!أبقى معكم

284
00:21:13,450 --> 00:21:15,350
...مرّة أخرى

285
00:21:15,350 --> 00:21:20,020
!دعوني أنضمّ لكم يا رفاق

286
00:21:35,260 --> 00:21:37,030
...لوفي

287
00:21:37,030 --> 00:21:41,400
!أيّها الغبيّ! أمسك بيدي بسرعة

288
00:21:54,080 --> 00:21:55,680
!أنت الغبيّ

289
00:21:58,270 --> 00:22:00,640
!أنتما سخيفان

290
00:22:11,440 --> 00:22:13,860
!صعد الجميع أخيرًا

291
00:22:14,350 --> 00:22:16,550
سنسرع باجتياز هذه القذائف المدفعيّة

292
00:22:16,550 --> 00:22:19,720
!لكي نستأنف رحلتنا يا رفاق

293
00:22:19,720 --> 00:22:21,750
!أجل

294
00:22:31,170 --> 00:22:34,670
.بالمناسبة يا تشوبّر. ثمّة مكافأة علينا أخيرًا أيضًا

295
00:22:35,760 --> 00:22:37,760
!كما قلت، لا يمكنني قبول ذلك

296
00:22:37,760 --> 00:22:40,990
خمسون...؟ خمسون...؟

297
00:22:40,990 --> 00:22:44,020
نوجيكو وغين-سان والجميع
...في قرية كوكوياشي

298
00:22:44,020 --> 00:22:46,690
أتساءل كيف سيكون شعورهم
...عند رؤية هذا

299
00:22:46,690 --> 00:22:47,880
:في الحلقة القادمة من وان بيس

300
00:22:47,880 --> 00:22:50,940
!ملصقات المطلوبين تنتشر حول العالم"
"!احتفالات في أوطانهم بينما تتقدّم السّفينة

301
00:22:50,940 --> 00:22:53,590
!ملك القراصنة، لن يكون إلاّ أنا

302
00:22:56,050 --> 00:23:01,050
نلقاكم في الحلقة القادمة