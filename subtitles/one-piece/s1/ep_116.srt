.كشفتُ نقطة ضعفك

175
00:12:07,340 --> 00:12:11,050
.كشفتُ أمر فاكهة النّسخ خاصّتك

176
00:12:25,790 --> 00:12:28,030
.كشفتُ أمر فاكهة النّسخ خاصّتك

177
00:12:28,330 --> 00:12:29,830
!مذكّرات يوم صيفيّ

178
00:12:29,830 --> 00:12:30,670
!ركلة الخدّ

179
00:12:36,040 --> 00:12:38,340
.كما توقّعت. لا شكّ في ذلك

180
00:12:38,570 --> 00:12:41,740
!أقلتَ كشفتها؟ كشفت ماذا بها؟

181
00:12:41,740 --> 00:12:46,050
أيّ جزء من قدرتي كشفه شخص مثلك؟

182
00:12:46,480 --> 00:12:51,320
لا يمكنك استخدام كينبو الباليه خاصّتك
وأنت متّخذًا جسد نامي-سان، صحيح؟

183
00:12:54,260 --> 00:12:57,330
،صحيح أنّني قد لا أستطيع مهاجمتك

184
00:12:57,330 --> 00:13:02,060
،لكن عندما تهاجمني
.دائمًا ما تعود إلى طبيعتك

185
00:13:02,600 --> 00:13:05,530
.عن طريق لمس خدّك بيدك اليسرى

186
00:13:11,610 --> 00:13:15,280
!ماذا؟ ماذا قلت؟ لا أستطيع سماعك

187
00:13:15,610 --> 00:13:17,140
يا هذا! أنا محقّ، صحيح؟

188
00:13:17,750 --> 00:13:21,680
!و-وإن كنت؟

189
00:13:21,680 --> 00:13:26,390
أجل، أجل، دون هذا الجسد
المرن الّذي طوّرته

190
00:13:26,390 --> 00:13:28,820
بالتّدريب اليوميّ شاقّ
،والدّروس المُجهدة

191
00:13:28,820 --> 00:13:31,360
.لا أستطيع تأدية كينبو الباليه خاصّتي

192
00:13:31,360 --> 00:13:32,460
وماذا إذًا؟

193
00:13:32,460 --> 00:13:35,430
،أنت في حالة يرثى لها بالفعل
!أليس كذلك؟

194
00:13:36,030 --> 00:13:40,070
.والأكثر من ذلك، متّع ناظرك بهذا
!المؤديّة الرّئيسيّة في كينبو الباليه

195
00:13:40,070 --> 00:13:42,140
.سأخبرك بهذا القدر بشأنها فحسب

196
00:13:42,740 --> 00:13:45,870
من وجهة نظرك، الّتي في اليسار
.هي بجعة أنثى واليمين بجعة ذكر

197
00:13:46,510 --> 00:13:47,610
من يهتمّ؟

198
00:13:49,710 --> 00:13:54,050
!سواء كشفتها أم لا، فذلك لا يهمّ

199
00:13:54,050 --> 00:13:56,420
...خذ هذه! كينبو الباليه

200
00:13:57,150 --> 00:13:58,520
!المِدفعيّ

201
00:14:02,960 --> 00:14:05,560
!ماذا؟! أتلك العلامة من ركلته؟

202
00:14:08,260 --> 00:14:10,530
!الخيار الصّائب
!تفاديها كان الخيار الصّائب

203
00:14:10,530 --> 00:14:13,370
إنّهما يملكان منقارين فولاذيّين
!في طرف عنقيهما الملتويين

204
00:14:14,200 --> 00:14:17,170
!لا يوجد حتّى شقّ حول ذلك الثّقب

205
00:14:17,640 --> 00:14:20,810
قوّتها حقيقيّة، فعندما
،تُضغط على نقطة واحدة

206
00:14:21,140 --> 00:14:23,140
.لا تدمّر أيّ شيء بغير ضرورة

207
00:14:23,940 --> 00:14:28,180
لتعتبر أنّ إحدى ركلاتي
.تضاهي طلقةً من بندقيّة

208
00:14:28,180 --> 00:14:31,720
.إلاّ أنّ الرّصاصة هنا أكبر قليلاً

209
00:14:32,150 --> 00:14:34,290
!سأثقبك

210
00:14:34,660 --> 00:14:35,590
!آن

211
00:14:35,790 --> 00:14:36,720
!دو

212
00:14:37,360 --> 00:14:38,430
!ركلة العنق

213
00:14:38,430 --> 00:14:39,090
!كورا

214
00:14:40,530 --> 00:14:41,960
!لن يفلح ذلك

215
00:14:44,300 --> 00:14:46,970
سحقًا! ثمّة اختلاف كبير
!بين نطاق ركلتنا

216
00:14:50,440 --> 00:14:52,110
!هذا القتال محسوم، صحيح؟

217
00:14:52,370 --> 00:14:54,810
!طيران، طيران، أنا أطير

218
00:14:55,110 --> 00:15:00,780
!كينبو الباليه
!مذّكرات سماء شتويّة

219
00:15:01,680 --> 00:15:05,290
،لكن كلّما طال امتداد ركلته
.زادت مدّة التّعافي منها

220
00:15:07,990 --> 00:15:11,230
،إن استطعتُ تفادي ركلته
!ستكون لي الأفضليّة في السّرعة

221
00:15:11,590 --> 00:15:13,660
!مت الآن

222
00:15:19,030 --> 00:15:21,040
يا للأسف. ما رأيك؟

223
00:15:21,040 --> 00:15:23,500
.لديك شيء عالق على خدّك الأيسر

224
00:15:24,340 --> 00:15:25,310
حقًّا؟

225
00:15:26,310 --> 00:15:27,940
!شوي الكتف

226
00:15:31,010 --> 00:15:31,950
!ركلة الخصر

227
00:15:33,250 --> 00:15:34,250
!ركلة التّرقوة

228
00:15:38,250 --> 00:15:38,920
!ضربة البطن

229
00:15:38,920 --> 00:15:39,490
!آن

230
00:15:43,720 --> 00:15:44,690
!دو

231
00:15:44,690 --> 00:15:45,360
!أورا

232
00:15:45,360 --> 00:15:46,130
!ركلة الرّدف

233
00:15:47,630 --> 00:15:54,800
!ركلة التّرقوة! ركلة الرّدف! ركلة الكتف
!ضربة البطن! ركلة الفخذ! ركلة الظّنبوب

234
00:15:48,100 --> 00:15:54,800
!آن، دو، أورا

235
00:15:54,800 --> 00:15:55,370
!سحقًا

236
00:15:55,370 --> 00:15:56,000
!دو

237
00:15:56,000 --> 00:15:57,200
!ركلة العنق

238
00:15:56,000 --> 00:15:57,200
!كورا

239
00:16:02,740 --> 00:16:11,550
!ركلة الظّنبوب! ركلة العنق! ركلة الرّدف
!ضربة البطن! ركلة السّاق! ركلة أسفل الظّهر

240
00:16:02,740 --> 00:16:11,550
!آن، دو، أورا

241
00:16:13,150 --> 00:16:15,690
!آن، دو، كورا

242
00:16:15,690 --> 00:16:17,060
!آن! دو

243
00:16:17,360 --> 00:16:18,590
!ركلة العصعص

244
00:16:17,360 --> 00:16:18,590
.كورا

245
00:16:43,450 --> 00:16:45,120
!ركلة لحم العجل

246
00:16:43,450 --> 00:16:45,120
!أرابيسك المدفعيّ

247
00:17:42,010 --> 00:17:44,150
...أ-أستسلم

248
00:17:45,080 --> 00:17:48,520
أذهلتني. أما زلت حيًّا؟

249
00:17:50,150 --> 00:17:51,090
ما الأمر؟

250
00:17:51,090 --> 00:17:55,320
إن حوّلت نفسك إلى نامي-سان
.ثانيةً، فلن أستطيع الإجهاز عليك

251
00:17:56,160 --> 00:17:59,530
...يا للسّخف... لا أستطيع الحراك
...في حالتي الرّاهنة

252
00:17:59,530 --> 00:18:02,330
ما الفائدة الّتي قد أجنيها
من تجنّب نتيجة هذا القتال؟

253
00:18:02,600 --> 00:18:06,030
.لقد فزت. اقتلني

254
00:18:08,140 --> 00:18:11,670
بات محكومًا عليّ أن أُقتَل
.من قبل المنظّمة على أيّ حال

255
00:18:12,840 --> 00:18:15,140
فما الّذي تنتظره؟

256
00:18:15,640 --> 00:18:18,010
...أسرع ووجّه الضّربة القاضية

257
00:18:21,580 --> 00:18:23,550
.لقد كان قتالاً جيّدًا

258
00:18:24,420 --> 00:18:27,490
.لا داعي لقول أكثر من ذلك

259
00:18:37,500 --> 00:18:41,700
،هذه وبلا أدنى شكّ
.شهادة عن صداقة بين خصمين

260
00:18:42,100 --> 00:18:44,140
...لكنّي لن أبكي

261
00:18:47,210 --> 00:18:51,250
.إلى اللّقاء. سآخذ نظّارات قنّاصنا

262
00:18:52,080 --> 00:18:54,720
لـ-لقد وجّه لي الضّربة
...القاضية بالفعل

263
00:18:59,220 --> 00:19:01,820
يبدو أنّني كسرت بعضًا
.من عظامي ثانيةً

264
00:19:19,740 --> 00:19:22,240
!كـ-كلّ شيء جاهز من جانبنا

265
00:19:22,510 --> 00:19:24,710
يمكننا إشعال الفتيل
!في أيّ لحظة أيضًا

266
00:19:29,820 --> 00:19:35,160
احتضنت هذه القلعة
.تاريخ 4،000 سنة من أراباستا

267
00:19:42,230 --> 00:19:44,230
.كانت مصدر فخر لي

268
00:19:47,870 --> 00:19:50,710
،لكن إن دمّرنا القصر الملكيّ

269
00:19:50,710 --> 00:19:53,370
.سيتوقّف النّاس عن القتال وينتبهون

270
00:19:53,940 --> 00:19:57,980
!وسأستطيع إخبارهم بالحقيقة بكلماتي

271
00:20:06,390 --> 00:20:08,260
!حسنًا، أشعله

272
00:20:08,520 --> 00:20:09,490
!حاضر

273
00:20:20,630 --> 00:20:22,300
!مـ-ما هذا؟

274
00:20:28,140 --> 00:20:28,980
!هل أنت بخير؟

275
00:20:29,280 --> 00:20:32,980
!...إ-إنّه هو

276
00:20:35,750 --> 00:20:37,220
.لا يمكنكم ذلك

277
00:20:47,700 --> 00:20:52,500
،كان فعلاً ينمّ عن الغدر حقًّا
أليس كذلك يا آنسة وينزداي؟

278
00:20:53,000 --> 00:20:56,470
.سيكون هذا بيتي عمّا قريب

279
00:20:56,740 --> 00:20:58,340
!كروكودايل

280
00:21:01,180 --> 00:21:02,580
!جلالة الملك

281
00:21:02,580 --> 00:21:03,780
!أبي

282
00:21:06,110 --> 00:21:09,780
.من الجميل حقًّا امتلاك المرء لقصر

283
00:21:12,990 --> 00:21:16,320
فهو مكان جيّد لرؤية
.المنحطّين في الأسفل

284
00:21:17,930 --> 00:21:19,830
أ-أين هو لوفي-سان؟

285
00:21:21,630 --> 00:21:23,130
هل تقصدين قبّعة القشّ؟

286
00:21:24,330 --> 00:21:26,300
ذلك الغرّ التّافه؟

287
00:21:29,840 --> 00:21:32,370
.لقد مات

288
00:22:06,570 --> 00:22:10,880
لطالما أردتُ أن أحدّثك بهذا

289
00:22:10,880 --> 00:22:17,590
لكنّي لم أقوَ على بوح
ولو بنصف ما في قلبي

290
00:22:17,590 --> 00:22:28,100
إلى جانبك، أتألّق كلّما تشاركنا حُلُمًا

291
00:22:28,100 --> 00:22:41,480
نظرت لي بابتسامةٍ سعيدةٍ ورقيقةٍ

292
00:22:41,480 --> 00:22:43,680
مجدٌ مجدٌ، تجعلني أتألّق

293
00:22:43,680 --> 00:22:52,450
لأنّك إلى جانبي، حتّى
دموعي تتحوّل إلى شجاعة

294
00:22:52,450 --> 00:22:58,190
،أريد أن أكون قويّة
أريد أن أتشارك معك

295
00:22:58,190 --> 00:23:04,000
كلّي ثقة أنّي سأصل إلى النَّوى

296
00:23:11,570 --> 00:23:13,710
.آمل أنّ نامي استطاعت الهرب بسلام

297
00:23:13,710 --> 00:23:15,280
.لا يمكنها أن تقارع شخصًا بتلك القدرات

298
00:23:15,280 --> 00:23:18,380
نامي، يبدو أنّه حان الوقت
.لتستخدميه أخيرًا

299
00:23:18,380 --> 00:23:19,580
.وجدتك يا فتاة

300
00:23:19,580 --> 00:23:21,320
...سلاحك الجديد

301
00:23:21,320 --> 00:23:22,950
!أوسوبّ، تماسك

302
00:23:22,950 --> 00:23:25,390
!خذي هذه يا آنسة دبلفينغر

303
00:23:25,890 --> 00:23:27,390
:في الحلقة القادمة من ون بيس

304
00:23:27,390 --> 00:23:30,860
!إعصار نامي المنذر"
"!انفجار عصا الطّقس

305
00:23:30,860 --> 00:23:33,430
!ملك القراصنة، لن يكون إلاّ أنا