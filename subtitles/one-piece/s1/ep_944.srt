1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,610 --> 00:02:00,860
!أسلوب السّيفين

29
00:02:01,900 --> 00:02:03,780
!ردّ تسلّق البرج

30
00:02:09,580 --> 00:02:12,370
!ملك السّول

31
00:02:13,910 --> 00:02:15,870
!الرّوح

32
00:02:16,330 --> 00:02:19,750
!لعنةٌ عليكم

33
00:02:22,210 --> 00:02:24,480
!ظهر ثانيةً

34
00:02:24,480 --> 00:02:27,610
!غاشادوكورو

35
00:02:27,610 --> 00:02:30,100
!ساق الشّيطان

36
00:02:32,770 --> 00:02:35,730
!لحم مفروم فاخر

37
00:02:45,530 --> 00:02:49,910
.لديّ أربع حيوات الآن

38
00:02:59,500 --> 00:03:04,130
...بإمكانك تقطيعي فقط بعد أن تقتل

39
00:03:04,460 --> 00:03:06,420
.الأعضاء الثّلاثة من طاقمك

40
00:03:07,590 --> 00:03:10,890
...في تلك الأثناء في مخيّم أودون للتّنقيب

41
00:03:16,560 --> 00:03:19,320
مع من تتكلّم في رأيك؟

42
00:03:19,320 --> 00:03:22,280
!لا تستفزّني

43
00:03:22,280 --> 00:03:24,480
!أوغاد

44
00:03:33,660 --> 00:03:40,540
"!ضربت العاصفة! بيغ مام الهائجة"

45
00:03:44,960 --> 00:03:46,630
...لم أتوقّع

46
00:03:47,130 --> 00:03:52,970
أن تسقط عاصمة الزّهور في فوضى
...كهذه بعد إعدام ياسويي-دونو

47
00:03:53,300 --> 00:03:57,820
أعرف كيف شعر زوروجورو-دونو
...وسانغورو-دونو

48
00:03:57,820 --> 00:03:59,310
.ما كان باليد حيلة

49
00:03:59,310 --> 00:04:03,230
!لنذهب ونهزم هولديم شرّ هزيمة

50
00:04:03,230 --> 00:04:04,900
!أجل

51
00:04:06,400 --> 00:04:08,740
!مهلاً لحظة يا أشورا

52
00:04:12,820 --> 00:04:15,240
.أريد إطلاعك على أمر ما

53
00:04:25,800 --> 00:04:28,880
أهذا صحيح؟

54
00:04:28,880 --> 00:04:33,010
.نعم، هذه هي الحقيقة

55
00:04:33,010 --> 00:04:36,230
...استفززنا هولديم

56
00:04:36,230 --> 00:04:37,930
.أعني أنّني استفززته

57
00:04:39,680 --> 00:04:42,070
.كان أمرًا منّي

58
00:04:42,070 --> 00:04:45,330
،أخبرتهم أن يسرقوا طعامًا وأسلحة من هولديم

59
00:04:45,330 --> 00:04:49,150
وجعلت الأمر يبدو وكأنّ جماعة
.لصوص أتاماياما هي الجانية

60
00:04:49,570 --> 00:04:54,370
.لهذا السّبب غضب هولديم وهاجم جماعتكم

61
00:05:09,210 --> 00:05:12,840
.أنت تستعمل كلّ الوسائل الممكنة بالفعل

62
00:05:12,840 --> 00:05:15,260
أليس كذلك يا كينييمون؟

63
00:05:30,280 --> 00:05:34,110
!وبسبب ذلك، دُمّر أتاماياما بالنّيران

64
00:05:39,120 --> 00:05:42,260
!أخبرتك أنّ خدعك الرّخيصة لن تنفع معي

65
00:05:42,260 --> 00:05:44,460
!قاتلني بإنصاف

66
00:05:45,540 --> 00:05:49,170
!ألم تلاحظ بعد؟ انظر حولك

67
00:05:49,840 --> 00:05:53,760
...جبلُنا... أتاماياما

68
00:05:59,140 --> 00:06:00,060
!كينييمون

69
00:06:00,060 --> 00:06:04,980
!أكنت تحاول محاصرتنا؟

70
00:06:05,440 --> 00:06:08,060
!توقّف يا أشورا! نحن جدّ آسفون

71
00:06:10,530 --> 00:06:14,530
...فعلتُ ذلك بغرض تحفيزك

72
00:06:22,700 --> 00:06:27,420
!ساقتني تلك الفكرة

73
00:06:28,130 --> 00:06:29,090
!...ولكن

74
00:06:29,090 --> 00:06:31,210
!كلّي أسف يا أشورا

75
00:06:31,750 --> 00:06:34,890
!وجب عليّ القدوم إليك بدل ذلك

76
00:06:34,890 --> 00:06:38,020
،كنت أبرّر أفعالي باسم سيّدنا

77
00:06:38,020 --> 00:06:42,930
ولم يكن لديّ ما يكفي من الوقت، لذلك
...لم يسعني إلاّ اللّجوء لإجراءات قصوى

78
00:06:42,930 --> 00:06:45,850
!لكنّني كنت مخطئًا بالكامل

79
00:06:52,440 --> 00:06:55,410
!عشرون سنة مدّة طويلة

80
00:06:55,410 --> 00:06:58,580
،العالم بحدّ ذاته تغيّر
!ناهيك عن قلوب النّاس

81
00:06:58,580 --> 00:07:01,290
!لم أفكّر في ذلك قطّ

82
00:07:01,290 --> 00:07:04,410
!كلاّ، حاولت ألاّ أرى ذلك

83
00:07:05,160 --> 00:07:12,760
لكنّني أدركت أنّه ما زالت هنالك بعض القلوب
!ذات الإيمان الثّابت الّتي لم تتغيّر في هذه البلاد

84
00:07:12,760 --> 00:07:15,800
!...عندما رأيت ياسويي-ساما

85
00:07:25,480 --> 00:07:28,950
!ما زالت خطّتنا آمنة

86
00:07:28,950 --> 00:07:33,610
ضلّل ياسويي-ساما العدوّ
!من أجلنا مضحّيًا بحياته

87
00:07:34,690 --> 00:07:39,820
العلامة على كواحل أولئك
...الّذين اعتقلهم أوروتشي

88
00:07:40,620 --> 00:07:47,660
يعرف أولئك السّاموراي حقّ المعرفة
!أنّ وشم الهلال ليس مجرّد تصميم شائع

89
00:07:49,500 --> 00:07:54,100
!سنغير على أونيغاشيما في ليلة مهرجان النّار

90
00:07:54,100 --> 00:07:58,060
سيُطلق سراح أولئك السّاموراي
،في العاصمة بسبب ما حدث

91
00:07:58,060 --> 00:08:00,590
!وأنا واثق أنّهم سينضمّون إلينا

92
00:08:01,550 --> 00:08:07,390
نحن بحاجتك بكلّ تأكيد للإطاحة
!بكايدو وأوروتشي

93
00:08:07,390 --> 00:08:12,060
!هلاّ قاتلت جنبًا إلى جنب معنا يا أشورا؟

94
00:08:33,170 --> 00:08:34,670
...عشرون سنة

95
00:08:43,930 --> 00:08:50,100
.لن تدرك أبدًا ثقل السّنوات العشرين الماضية

96
00:09:13,250 --> 00:09:14,380
...اتبعوني

97
00:09:16,380 --> 00:09:19,920
!ثمّة أمر أريد أن أريكم إيّاه

98
00:09:28,100 --> 00:09:30,100
!مهلاً! ما كانت تلك الضّجّة؟

99
00:09:30,100 --> 00:09:35,060
،صدرت من خارج البوّابة
...لكنّ الاتّصال انقطع مع الحرّاس

100
00:09:39,780 --> 00:09:42,450
...حساء الفاصولياء الحمراء

101
00:09:44,200 --> 00:09:48,910
!حساء الفاصولياء الحمراء

102
00:09:59,050 --> 00:10:01,760
!أنقذي أخي الكبير بأيّ ثمن

103
00:10:01,760 --> 00:10:04,170
!انطلقي يا أولين-تشان

104
00:10:04,170 --> 00:10:07,490
!لا، لا، لا تبذلي كلّ جهدك

105
00:10:07,490 --> 00:10:09,100
!حساء الفاصولياء الحمراء

106
00:10:11,060 --> 00:10:14,700
.من المستحيل أن يكون لديهم ذلك الحساء هنا

107
00:10:14,700 --> 00:10:19,520
إن عرفت بيغ مام ذلك، فقد تعيد
...لها الصّدمة ذكرياتها

108
00:10:23,440 --> 00:10:26,160
!وسنُقتل بكلّ تأكيد

109
00:10:27,820 --> 00:10:33,160
.هذا هو مخيّم أعمال التّنقيب
.إنّه أشدّ ممّا توقّعت

110
00:10:33,160 --> 00:10:40,290
حتّى بوجود بيغ مام، أليس من المستحيل
كسر تلك البوّابة الفولاذيّة السّميكة؟

111
00:10:44,550 --> 00:10:45,760
!حساء الفاصولياء الحمراء

112
00:10:47,640 --> 00:10:50,890
!أجل يا أولين-تشان! واصلي

113
00:10:50,890 --> 00:10:52,980
!كلاّ، هذا يكفي

114
00:10:52,980 --> 00:10:55,350
!لا تواصلي هكذا

115
00:11:02,400 --> 00:11:06,240
!حساء الفاصولياء الحمراء

116
00:11:06,950 --> 00:11:09,320
...حساء الفاصولياء الحمراء

117
00:11:09,910 --> 00:11:12,950
!حساء الفاصولياء الحمراء

118
00:11:17,170 --> 00:11:19,210
!لقد نجحت

119
00:11:27,880 --> 00:11:29,900
!أولين-تشان، أنت قويّة جدًّا

120
00:11:29,900 --> 00:11:31,720
...كلاّ، لقد فعلتها

121
00:11:33,390 --> 00:11:34,600
ما الّذي يحدث؟

122
00:11:34,600 --> 00:11:39,060
!نحن نتعرّض للهجوم
!دُمّرت البوّابة الأماميّة

123
00:11:39,690 --> 00:11:40,750
!مستحيل

124
00:11:40,750 --> 00:11:44,750
!من فعل أمرًا كهذا؟

125
00:11:44,750 --> 00:11:48,340
!دخيلة لعينة! سألقّنك درسًا

126
00:11:48,340 --> 00:11:50,070
!جهّزي نفسك

127
00:12:02,170 --> 00:12:05,340
...شمّ، شمّ... شمّ

128
00:12:06,420 --> 00:12:10,140
أين تحتفظون بحساء الفاصولياء
الحمراء اللّذيذ ذلك؟

129
00:12:10,140 --> 00:12:11,140
.لعق

130
00:12:14,010 --> 00:12:19,390
!ألم تسمعوني؟! قلت حساء الفاصولياء الحمراء

131
00:12:35,370 --> 00:12:39,960
!هذه هي النّهاية! سأموت
!سأموت بكلّ تأكيد

132
00:12:50,970 --> 00:12:53,180
ماذا يحدث؟

133
00:13:02,650 --> 00:13:05,780
!اخترقت الدّخيلة البوّابة الثّانية

134
00:13:05,780 --> 00:13:08,150
!إنّها تقترب من البّوابة الثّالثة الآن

135
00:13:08,150 --> 00:13:09,820
!ماذا؟

136
00:13:10,360 --> 00:13:12,320
...البوّابة الثّالثة

137
00:13:18,160 --> 00:13:19,120
!ما الّذي...؟

138
00:13:29,300 --> 00:13:30,300
...هذا

139
00:13:40,100 --> 00:13:43,650
أيوجد حساء فاصولياء حمراء أفضل هنا؟

140
00:14:00,910 --> 00:14:01,910
!ما الّذي...؟

141
00:14:14,970 --> 00:14:18,180
!...بيـ

142
00:14:18,890 --> 00:14:22,390
!بيغ مام؟

143
00:14:23,730 --> 00:14:27,560
!ماذا؟! هل أنا أحلم؟

144
00:14:27,860 --> 00:14:29,220
...بيغ مام

145
00:14:29,220 --> 00:14:30,330
!إنّها بيغ مام

146
00:14:30,330 --> 00:14:35,030
ماذا؟ أهو لذيذ؟

147
00:14:35,030 --> 00:14:37,490
!لماذا هي هنا؟

148
00:14:37,950 --> 00:14:41,450
!سمعتُ أنّ سفينتها قد غرقت

149
00:14:48,630 --> 00:14:52,010
!أنا جائعة

150
00:14:52,800 --> 00:14:53,970
...لا-لا أصدّق

151
00:14:53,970 --> 00:14:57,430
!أنّها دمّرت البوّابة الفولاذيّة

152
00:14:57,430 --> 00:15:00,140
!تلك العجوز خطيرة جدًّا

153
00:15:00,760 --> 00:15:06,200
...إنّ بيغ مام إمبراطورة بحر مثل كايدو-سان

154
00:15:06,200 --> 00:15:09,810
!ما الّذي أتى بها إلى أودون؟

155
00:15:10,650 --> 00:15:16,400
...حساء الفاصولياء الحمراء

156
00:15:19,200 --> 00:15:20,870
!حساء الفاصولياء الحمراء

157
00:15:20,870 --> 00:15:23,160
ماذا؟ حساء الفاصولياء الحمراء؟

158
00:15:24,450 --> 00:15:28,830
!أوتاما-تشان! تعالي بسرعة

159
00:15:28,830 --> 00:15:31,790
!أشمّ رائحة حساء الفاصولياء الحمراء

160
00:15:32,800 --> 00:15:35,610
!أولين-تشان تناديني

161
00:15:35,610 --> 00:15:39,820
!لنأكله معًا

162
00:15:40,860 --> 00:15:43,510
!هيّا لنأكل حساء الفاصولياء الحمراء الآن

163
00:15:44,680 --> 00:15:47,940
!لماذا هنالك حساء فاصولياء حمراء هنا؟

164
00:15:47,940 --> 00:15:51,940
!قلتُ تلك الكذبة المميتة مخاطرًا بحياتي

165
00:15:51,940 --> 00:15:55,990
.كما أنّ البوّابة قد فُتحت

166
00:15:55,990 --> 00:16:00,410
.ظننت أنّ الدّخول سيكون مشكلة

167
00:16:00,870 --> 00:16:04,490
!لنذهب لإنقاذ أخي الكبير الآن

168
00:16:04,950 --> 00:16:06,720
!مومو-كُن، لنذهب

169
00:16:06,720 --> 00:16:10,420
...نـ-نعم! لننقذ لوفي

170
00:16:10,420 --> 00:16:11,540
.كلاّ

171
00:16:13,000 --> 00:16:16,880
عليكما الاختباء والانتظار في الخارج
.يا أوتاما-تشان ومومونوسكي-ساما

172
00:16:16,880 --> 00:16:19,260
!ماذا؟! لماذا؟

173
00:16:19,260 --> 00:16:23,180
واضح تمامًا أنّ الوضع خطير عليكما
.بعد هذه المرحلة يا أوتاما-تشان

174
00:16:23,760 --> 00:16:28,450
كما أنّه لا يجب أن يراك أيّ أحد
.يا مومونوسكي-ساما مهما كلّف الأمر

175
00:16:28,450 --> 00:16:30,730
...نعم... ما باليد حيلة

176
00:16:31,600 --> 00:16:34,960
أوكيكو، لا يجب أن يعرفوا
!أنّك على قيد الحياة أيضًا

177
00:16:34,960 --> 00:16:36,030
!معك حقّ

178
00:16:36,030 --> 00:16:38,440
!شكرًا على النّصيحة

179
00:16:38,440 --> 00:16:40,860
!سأخفي هويّتي بهذا

180
00:16:46,490 --> 00:16:47,500
...هذا

181
00:16:48,330 --> 00:16:49,910
!مثاليّ

182
00:16:49,910 --> 00:16:54,500
!لن يعرف أيّ أحد من أكون

183
00:16:55,290 --> 00:16:59,670
لماذا تظنّون أيّها السّاموراي أنّ قطعة
!قماش تغطّي الوجه قد تكون مقنِعة؟

184
00:17:00,220 --> 00:17:01,300
!تشوبّريمون-سان

185
00:17:02,840 --> 00:17:04,760
...إنّ أودون تحت سيادة

186
00:17:05,140 --> 00:17:09,640
أحد كبار النّجوم في قراصنة
!مملكة الحيوان، واسمه كوين

187
00:17:12,980 --> 00:17:14,810
!لنكن حذرين

188
