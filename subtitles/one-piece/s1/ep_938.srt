1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,400 --> 00:02:00,480
!أخبروا كينييمون-كُن والبقيّة رجاءً

29
00:02:01,690 --> 00:02:06,450
!أخبروهم أنّنا سنقاتل إلى جانبكم مهما كلّف الأمر

30
00:02:06,610 --> 00:02:08,490
كينييمون... كُن؟

31
00:02:10,580 --> 00:02:13,750
...أنا جدّ سعيد لرؤيتكما أيضًا

32
00:02:13,790 --> 00:02:16,620
!حسنًا، لديّ بعض الأعمال

33
00:02:16,790 --> 00:02:18,250
!مهلاً أيّها العمّ

34
00:02:18,380 --> 00:02:25,180
هنالك العديد من النّاس الّذين لن يعيشوا
!هذا الأسبوع قبل المعركة العظيمة

35
00:02:25,470 --> 00:02:27,720
!لذلك أستأذن منكم

36
00:02:40,980 --> 00:02:45,450
.أعتقد أنّك متعب للغاية أيّها الشّرطيّ

37
00:02:45,490 --> 00:02:48,530
.أنا جائع أيضًا

38
00:02:52,040 --> 00:02:53,160
!ماذا؟

39
00:02:53,330 --> 00:02:57,620
.سأكرّر كلامي مرّة تلو الأخرى حتّى تصدّقوني

40
00:02:57,670 --> 00:03:04,380
أنا اللّصّ العظيم أوشيميتسو كوزو
!الّذي أحدث الفوضى في عاصمة الزّهور

41
00:03:04,510 --> 00:03:08,890
،اخرس! إن كنتَ هو بالفعل

42
00:03:11,550 --> 00:03:13,890
!لماذا ظهرتَ حوالي منتصف اللّيل؟

43
00:03:17,140 --> 00:03:21,110
!لا تضحك! أنت تستخفّ بي

44
00:03:21,230 --> 00:03:23,480
!لن تخرج من هنا قيد الحياة

45
00:03:33,950 --> 00:03:35,160
!...إنّه

46
00:03:36,000 --> 00:03:37,040
!ابتعد

47
00:03:40,750 --> 00:03:44,130
...فهمت. لا عجب أنّنا لم نلاحظ

48
00:03:48,300 --> 00:03:52,970
خبرّ يهزّ البلاد، هويّة اللّص"
".الشّهم أوشيميتسو كوزو

49
00:03:54,100 --> 00:03:56,520
!أخبار هامّة! أخبار هامّة

50
00:03:56,640 --> 00:04:01,400
اللّصّ العظيم أوشيميتسو كوزو الّذي
...تسبّب بالمشاكل في عاصمة الزّهور

51
00:04:01,400 --> 00:04:04,610
!ألقي عليه القبض أخيرًا

52
00:04:04,770 --> 00:04:07,900
!مستحيل! لا أصدّق هذا

53
00:04:08,650 --> 00:04:11,530
...حانت ساعته أخيرًا

54
00:04:11,660 --> 00:04:14,830
!تقرير خاصّ! تقرير خاصّ! ثمّة أخبار هامّة

55
00:04:18,580 --> 00:04:20,580
أوشيميتسو كوزو؟

56
00:04:23,380 --> 00:04:24,920
.أوروتشي-ساما

57
00:04:25,500 --> 00:04:29,380
.أوروتشي-ساما، ثمّة أمر أريد إطلاعك عليه

58
00:04:29,670 --> 00:04:33,640
...إنّه يخصّ أوشيميتسو كوزو الّذي قُبض عليه البارحة

59
00:04:34,930 --> 00:04:36,890
!اخرس

60
00:04:37,020 --> 00:04:43,440
!تعجزون جميعًا عن فهم ألم فقدان المحبوب

61
00:04:44,020 --> 00:04:48,480
إنّني أتعاطف معك من كلّ قلبي
.بشأن موت الأويران كوموراساكي

62
00:04:48,530 --> 00:04:50,190
،لكن وبكلّ احترام

63
00:04:50,950 --> 00:04:53,610
.كان قرار كيوشيرو صائبًا

64
00:04:53,820 --> 00:04:57,200
،إن سُمح لشخص وقف في وجهك بمواصلة العيش

65
00:04:57,540 --> 00:05:00,830
.لقلّل ذلك من سلطتك وسمعتك

66
00:05:19,310 --> 00:05:20,350
!أوروتشي-ساما

67
00:05:20,520 --> 00:05:24,400
!لا أهتمّ لأمر أوشيميتسو كوزو

68
00:05:24,850 --> 00:05:32,240
!لا توجد امرأة أخرى بجمال كوموراساكي في العالم

69
00:05:32,280 --> 00:05:35,370
!ألا يمكنك إدراك ذلك؟

70
00:05:35,570 --> 00:05:39,160
!من الجيّد جدًّا رؤيتك يا أوروتشي-ساما

71
00:05:39,200 --> 00:05:42,040
.استمع لي رجاءً

72
00:05:42,160 --> 00:05:47,500
!أوشيميتسو كوزو لم يكن مجرّد لصّ حقير

73
00:05:48,250 --> 00:05:52,920
أوشيميتسو كوزو، اللّصّ الجبان الّذي
...أحدث الفوضى في عاصمة الزّهور

74
00:05:54,010 --> 00:06:00,140
إنّه مخادع حقير متمنٍّ للبطولة يوزّع المال
.والأغراض الّتي يسرقها على الفقراء

75
00:06:02,480 --> 00:06:07,900
،إنّنا نحتجزه في معقل السّجناء في بلدة راستسو

76
00:06:08,270 --> 00:06:10,610
...لكنّ حقيقة هويّته هي

77
00:06:12,320 --> 00:06:13,530
!ماذا؟

78
00:06:20,240 --> 00:06:21,950
...إنّه

79
00:06:27,630 --> 00:06:32,090
!أ-أهو... حيّ؟

80
00:06:35,010 --> 00:06:39,300
!مستحيل... لا أصدّق هذا

81
00:06:39,550 --> 00:06:41,260
...إنّه

82
00:06:41,850 --> 00:06:46,060
.أنت من عائلة كوروزومي إذًا
لماذا لم تخبرني؟

83
00:06:57,110 --> 00:07:00,910
...إنّه... إنّه

84
00:07:01,990 --> 00:07:04,450
!سيّدي! سيّدي

85
00:07:04,580 --> 00:07:08,080
ماذا نفعل بشأن أوشيميتسو كوزو؟

86
00:07:10,630 --> 00:07:12,800
لماذا عليك أن تسأل؟

87
00:07:12,960 --> 00:07:18,430
!أعدموه! وأظهروا إعدامه للعموم ليكون عبرةً

88
00:07:18,550 --> 00:07:23,220
!أنيروا لفائف الضّوء في كلّ أنحاء بلاد وانو في الحال

89
00:07:23,810 --> 00:07:26,930
.تمّ تجهيز لفائف الضّوء مسبقًا

90
00:07:27,100 --> 00:07:28,440
!كيوشيرو

91
00:07:28,560 --> 00:07:33,570
.ستُعقد اليوم جنازة كوموراساكي في عاصمة الزّهور

92
00:07:33,820 --> 00:07:38,450
إنّنا نتوقّع حضور حشود من النّاس
...وسيكون الوضع فوضويًّا

93
00:07:38,910 --> 00:07:41,530
.لهذا السّبب قمنا باستعداداتنا مسبقًا

94
00:07:41,660 --> 00:07:44,290
!هذا متوقّع من كيوشيرو

95
00:07:47,160 --> 00:07:49,080
ماذا نفعل الآن؟

96
00:07:51,580 --> 00:07:54,050
!حسنًا! هذا ما سنقوم بفعله

97
00:07:54,300 --> 00:07:58,550
!سنجعل أوشيميتسو كوزو يتبع كوموراساكي إلى القبر

98
00:07:58,800 --> 00:08:02,140
!سيكون مصيره كمصيرها

99
00:08:06,100 --> 00:08:11,810
من الخزي خسارة أكبر اثنين من
!مشاهير العاصمة في نفس الوقت

100
00:08:12,560 --> 00:08:16,780
.وحدك من قد تراوده فكرة ممتازة كهذه

101
00:08:17,070 --> 00:08:18,820
!سأكون حاضرًا هناك أيضًا

102
00:08:19,860 --> 00:08:23,620
!سأشهد على إعدامه حتّى النّهاية
!أحتاج لمِحَفَّة الآن

103
00:08:26,450 --> 00:08:28,660
!هذه كذبة

104
00:08:29,080 --> 00:08:33,380
كفّ عن قول نكات سيّئة
!في الصّباح الباكر يا كايدو-سان

105
00:08:36,300 --> 00:08:38,130
!ليست مزحة

106
00:08:38,710 --> 00:08:42,340
.أتتنا الأخبار من عاصمة الزّهور

107
00:08:50,060 --> 00:08:52,400
!ماتت كوموراساكي

108
00:08:52,690 --> 00:08:54,520
!ماتت

109
00:08:54,770 --> 00:08:58,900
إن ظننتَ أنّها كذبة، شغّل حلزون
!لفائف الضّوء خاصّتك

110
00:09:01,150 --> 00:09:03,610
...لا يمكن! هذا مستحيل

111
00:09:03,660 --> 00:09:05,370
!مستحيل

112
00:09:07,660 --> 00:09:10,410
!كوموراساكي-تان

113
00:09:12,830 --> 00:09:14,040
!اسمع

114
00:09:14,500 --> 00:09:17,300
!لقد عرف بموت كوموراساكي

115
00:09:17,460 --> 00:09:21,050
.أنا واثق أنّه سيكون في مزاج سيّئ لفترة

116
00:09:21,220 --> 00:09:24,340
نحن في ورطة. ماذا نفعل؟

117
00:09:25,050 --> 00:09:28,010
!أيّها البالون

118
00:09:28,140 --> 00:09:31,230
!تعال بسرعة

119
00:09:31,810 --> 00:09:35,860
!اخرس! لا وقت لديّ لهذا الآن

120
00:09:36,980 --> 00:09:41,530
أيّها البالون! هل نستطيع بدء
!نزالات السّومو لهذا اليوم؟

121
00:09:41,570 --> 00:09:43,530
!أسرع في ذلك

122
00:09:44,660 --> 00:09:48,240
!هل زاد وزنكما بين ليلة وضحاها أيّها الغبيّان؟

123
00:09:48,370 --> 00:09:52,000
!كلاّ، لم يزد! أنت تتخيّل فحسب

124
00:09:52,830 --> 00:09:54,710
.حـ-حسنًا

125
00:09:53,790 --> 00:09:54,710
!اسمع

126
00:09:54,870 --> 00:09:57,290
!انس الأمر

127
00:09:54,870 --> 00:09:58,630
هل نخبره أنّ كلّ حساء الفاصولياء الحمراء اختفى؟

128
00:09:58,790 --> 00:10:02,840
!مستحيل! قد تقوده صدمة أخرى للجنون

129
00:10:03,010 --> 00:10:04,260
!أوافقك

130
00:10:04,510 --> 00:10:08,850
.لكن أتساءل أين اختفى حساء الفاصولياء الحمراء

131
00:10:09,350 --> 00:10:13,600
.لهذا السّبب أخبرتُ لوفي-دونو ألاّ يأكل كثيرًا

132
00:10:13,730 --> 00:10:18,150
.إنّ تناوله لكلّ الحساء في القِدر كان أكثر من اللاّزم

133
00:10:18,310 --> 00:10:21,820
كيف لغبيّ مثله أن ينجو؟

134
00:10:21,940 --> 00:10:24,400
!لنخض نزال سومو فحسب

135
00:10:24,450 --> 00:10:27,530
!هيّا! دوسكوي

136
00:10:27,660 --> 00:10:32,540
!لا وقت لديّ للتّعامل مع غبيّ
!عليّ اكتشاف الحقيقة

137
00:10:32,660 --> 00:10:36,210
!أنت! دعني أرى عاصمة الزّهور الآن

138
00:10:36,370 --> 00:10:38,500
!جهّزوا حلزون لفيفة الضّوء

139
00:10:41,550 --> 00:10:44,050
!حلزون لفيفة الضّوء جاهز

140
00:10:47,010 --> 00:10:49,050
!صلوه بعاصمة الزّهور

141
00:10:50,300 --> 00:10:52,060
أهو حلزون عرض؟

142
00:10:56,600 --> 00:11:00,060
.ماذا؟ لا بدّ أنّ تلك هي عاصمة الزّهور

143
00:11:23,710 --> 00:11:29,220
!لا أصدّق أنّهم يهاجمون أتاماياما
!سُحقًا لهم

144
00:11:32,390 --> 00:11:36,890
!شوتنمارو، هذه هي نهايتك

145
00:11:36,930 --> 00:11:40,520
!هذا انتقامي! سأجعلك تدفع الثّمن

146
00:12:08,010 --> 00:12:10,550
.سُحقًا لكم يا جماعة لصوص أتاماياما

147
00:12:10,590 --> 00:12:15,260
!كيف تجرؤون على سرقة كلّ طعامي وأسلحتي؟

148
00:12:17,390 --> 00:12:19,390
...هو-هولديم-ساما

149
00:12:21,980 --> 00:12:25,020
!لن أسامحك يا شوتنمارو

150
00:12:33,370 --> 00:12:36,290
!سأسحقكم أيّها الأوغاد سحقًا

151
00:12:38,080 --> 00:12:42,420
!هذا مضحك! ماذا بوسعك فعله؟

152
00:13:14,780 --> 00:13:17,990
ما-ماذا علينا فعله؟

153
00:13:18,330 --> 00:13:23,960
لم أتوقّع أنّ سرقة الطّعام والأسلحة
...قد تسبّب كلّ هذه المشاكل

154
00:13:24,580 --> 00:13:26,420
!يا سيّدي الدّوق! كين-سان

155
00:13:26,590 --> 00:13:28,460
!مرحبًا

156
00:13:29,340 --> 00:13:30,510
!حسنًا

157
00:13:31,050 --> 00:13:35,680
...سرقنا الكثير. الطّعام
!إضافة للأسلحة من المصنع

158
00:13:36,010 --> 00:13:38,850
أحسنتم. هل تركتم الملاحظة؟

159
00:13:39,010 --> 00:13:40,520
!نعم، بالضّبط

160
00:13:43,140 --> 00:13:45,980
!هل نحن المسؤولون عن هذا؟

161
00:13:46,150 --> 00:13:47,690
!لا تهلعي

162
00:13:48,230 --> 00:13:50,610
...هذه هي خطّة كين-سان

163
00:13:51,070 --> 00:13:52,780
!راقبي بتمعّن

164
00:13:52,950 --> 00:13:53,780
!حاضرة

165
00:14:00,450 --> 00:14:03,080
!ليس الطّعام والأسلحة فقط

166
00:14:04,460 --> 00:14:06,290
!أيّها الجبان

167
00:14:06,290 --> 00:14:06,920
!ماذا؟

168
00:14:07,250 --> 00:14:09,630
!لا تدّعي البراءة

169
00:14:11,510 --> 00:14:13,420
!انظر ما حلّ بجسدي

170
00:14:13,550 --> 00:14:19,390
قام أعوانك بإحداث فوضى عارمة
!في بلدة باكورا وألحقوا بي الأذى

171
00:14:21,310 --> 00:14:23,270
...فاكهة المطّاط

172
00:14:25,900 --> 00:14:29,150
!النّسر الأحمر

173
00:14:32,230 --> 00:14:36,360
!ماذا؟! عمّ تتحدّث؟! لا علاقة لي بذلك

174
00:14:36,820 --> 00:14:40,280
هل تتظاهر أنّك لا تعرف؟
.لا بأس بذلك

175
00:14:40,330 --> 00:14:42,910
!لننهِ الأمر فحسب

176
00:14:46,750 --> 00:14:50,210
!إليك هجوم سيف الخدعة الآليّة خاصّتي

177
00:14:58,090 --> 00:14:59,600
!لديّ المزيد

178
00:15:03,770 --> 00:15:07,140
!خدعك الرّخيصة لن تنفع معي

179
00:15:07,270 --> 00:15:10,900
!فعلاً؟ سأزيد الحرارة إذًا! هيّا يا كاميجيرو

180
00:15:11,320 --> 00:15:13,940
!انظر لهذه النّار

181
00:15:22,990 --> 00:15:26,120
!أخبرتك أنّ خدعك الرّخيصة لن تنفع معي

182
00:15:26,160 --> 00:15:28,330
!قاتلني بإنصاف

183
00:15:29,420 --> 00:15:33,630
!ألم تلاحظ بعد؟ انظر حولك

184
00:15:34,210 --> 00:15:37,260
!أرأيت. انتشرت النّيران في كلّ الاتّجاهات

185
00:15:40,720 --> 00:15:44,310
!لماذا قد أزعج نفسي بقتالك مباشرة؟

186
00:15:44,600 --> 00:15:47,850
!أنا هنا لتدمير أتاماياما

187
00:15:48,020 --> 00:15:49,020
!ماذا؟

188
00:15:54,110 --> 00:15:57,570
...جبلُنا... أتاماياما

189
00:16:02,410 --> 00:16:06,500
!انسوا أمر هولديم الآن! لنتراجع

190
00:16:06,790 --> 00:16:07,500
!حاضر

191
00:16:12,330 --> 00:16:13,460
!لا تدعوهم يهربون

192
00:16:14,840 --> 00:16:15,710
!انتظروا

193
00:16:17,380 --> 00:16:19,550
...هذا يكفي

194
00:16:19,590 --> 00:16:25,390
دُمّر مخبأ شوتنمارو! ما عاد
!لديهم مكان يختبئون فيه

195
00:16:25,810 --> 00:16:29,180
!هذه هي نهاية مجموعة لصوص أتاماياما

196
00:16:36,360 --> 00:16:38,530
!لا فائدة! تنتشر النّيران بسرعة

197
00:16:38,690 --> 00:16:41,200
!من المستحيل إخمادها يا شوتنمارو-سان

198
00:16:43,280 --> 00:16:45,780
!سُحقًا لهولديم

199
00:16:45,950 --> 00:16:47,950
!لنذهب لبلدة باكورا

200
00:16:48,120 --> 00:16:52,120
!بلدة باكورا؟! سيسعى جيش كايدو خلفنا

201
00:16:52,290 --> 00:16:54,210
!وماذا في ذلك؟

202
00:16:54,960 --> 00:16:58,010
!سأوسعهم ضربًا جميعًا

203
00:16:58,590 --> 00:17:01,300
...مستحيل... هذا غير معقول

204
00:17:01,590 --> 00:17:03,760
...لم نخطّط لهذا

205
00:17:04,140 --> 00:17:06,470
.لنعلم السّيّد الدّوق بهذا

206
00:17:10,890 --> 00:17:15,650
.هكذا إذًا... أشعر بالأسى على أشورا دوجي

207
00:17:15,860 --> 00:17:18,690
.نعم... لكن كان ذلك للمصلحة العامّة

208
00:17:19,650 --> 00:17:21,110
.ما باليد حيلة

209
00:17:21,780 --> 00:17:23,410
!لنذهب لبلدة باكورا

210
00:17:24,620 --> 00:17:28,790
.أُحبطت خطّتنا ولا نعلم ما العمل الآن بعد

211
00:17:29,450 --> 00:17:34,290
ففي الوقت الحاليّ، نحتاج ليشعر أشورا
.بالعداء نحو قراصنة مملكة الحيوان

212
00:17:34,420 --> 00:17:38,670
!لأنّنا نحتاج لمساعدته بكلّ تأكيد

213
00:17:44,510 --> 00:17:47,510
.ربّما عادت نامي-سان والبقيّة

214
00:17:48,010 --> 00:17:49,520
...لقد عدت

215
00:17:57,400 --> 00:18:00,320
!من أنت؟! ماذا يحدث؟

216
00:18:00,360 --> 00:18:02,650
!ما-ما-ما الّذي يحدث؟

217
00:18:03,650 --> 00:18:08,740
هذا أنت يا بروك... ماذا هنالك؟
لماذا أنت هنا؟

218
00:18:09,790 --> 00:18:14,370
زورو-سان! تكاد تجعل عينيّ
!تخرجان من مكانها

219
00:18:14,410 --> 00:18:18,290
!أعني إن كان لديّ عينان من الأساس

220
00:18:19,250 --> 00:18:22,460
!آسف على المقاطعة

221
00:18:23,300 --> 00:18:26,180
!أنت، لا تسئ فهم الأمر! عد إلى هنا

222
00:18:26,340 --> 00:18:30,260
...ماذا؟ لا بأس... إن أردت ذلك

223
00:18:32,350 --> 00:18:34,390
!يا لجمالها

224
00:18:34,730 --> 00:18:39,310
أنا آسف، هل أستطيع رؤية ملابسك الدّاخليّة؟

225
00:18:46,820 --> 00:18:49,410
!شبح

226
00:18:49,410 --> 00:18:51,910
!مهلاً! لا داعي للخوف منه

227
00:18:54,450 --> 00:18:58,580
!أنا جائع. سألقي لعنة عليك

228
00:19:00,040 --> 00:19:02,000
!أنا خائفة

229
00:19:02,670 --> 00:19:07,340
أخبرني كينييمون-سان أن أبقى
...وأردّد ذلك للنّاس

230
00:19:08,390 --> 00:19:12,600
لهذا السّبب هنالك العديد
.من العطايا في المدخل

231
00:19:12,760 --> 00:19:17,310
!نعم، لا أصدّق أنّك أخت مومونوسكي-سان

232
00:19:17,350 --> 00:19:21,860
!أنت بنفس جمال الأويران

233
00:19:22,400 --> 00:19:24,400
!بالطّبع! هذا لأنّها أويران بالفعل

234
00:19:24,740 --> 00:19:29,360
لا بدّ أنّ من اللّطيف جدًّا وجود شخص مثلها
!إلى جانبك. كم أحسدك يا زورو-سان

235
00:19:29,530 --> 00:19:32,620
...كنت نائمًا فحسب، لكنّها

236
00:19:32,910 --> 00:19:37,250
...أنا آسفة! ظننت أنّك تشعر بالبرد

237
00:19:37,290 --> 00:19:42,420
لكنّني أجعل لعاب الرّجال يسيل
!دائمًا كلّما نمت إلى جانبهم

238
00:19:42,630 --> 00:19:46,300
!هل أعجبك ذلك؟ كلاّ، واثقة أنّه أعجبك

239
00:19:46,470 --> 00:19:48,720
...أنت صريحة للغاية يا هذه

240
00:19:48,720 --> 00:19:49,380
!نعم

241
00:19:49,550 --> 00:19:53,850
.على أيّ حال، أتساءل أين نامي-سان والبقيّة

242
00:19:54,140 --> 00:19:59,810
ذهبن إلى حمّام البارحة، لذلك حاولت الذّهاب
...للقائهنّ، لكن لم أستطع إيجادهنّ

243
00:19:59,850 --> 00:20:04,150
صحيح، بالمناسبة، إنّ عاصمة
!الزّهور في فوضى عارمة الآن

244
00:20:05,230 --> 00:20:11,070
،اليوم جنازة الأويران كوموراساكي-سان
...المرأة الأكثر جمالاً في بلاد وانو

245
00:20:12,570 --> 00:20:16,410
وفوق ذلك، قُبض على اللّصّ العظيم
أوشيميتسو كوزو

246
00:20:16,410 --> 00:20:19,960
الّذي يوزّع المال على الفقراء
!وسبّب ذلك فوضى كبيرة أيضًا

247
00:20:20,120 --> 00:20:22,380
!قُبض عل أوشيميتسو كوزو؟! مستحيل

248
00:20:22,630 --> 00:20:24,540
.إنّها الحقيقة

249
00:20:24,540 --> 00:20:27,130
.انظري، ذلك مكتوب على هذا المنشور

250
00:20:27,380 --> 00:20:32,720
...سيتمّ إعدامه في العاصمة اليوم
.وقد اكتشفوا هويّته

251
00:20:32,760 --> 00:20:35,720
...أعتقد أنّه معروف في بلدة إبيسو

252
00:20:35,970 --> 00:20:37,390
!أقلت بلدة إبيسو؟

253
00:20:37,520 --> 00:20:40,890
...نعم. وقد كان اسمه

254
00:20:40,940 --> 00:20:43,270
...ياسو أو ما شابه

255
00:20:43,480 --> 00:20:44,230
!تونوياسو؟

256
00:20:44,400 --> 00:20:47,030
!نعم، نعم. هذا اسمه

257
00:20:49,610 --> 00:20:50,490
!توكو

258
00:21:01,160 --> 00:21:02,710
!مهلاً! ما الخطب؟

259
00:21:02,870 --> 00:21:03,880
!انتظري يا توكو

260
00:21:06,710 --> 00:21:11,010
!شكرًا على إنقاذي البارحة
!لن أنسى لطفك ما حييت

261
00:21:11,430 --> 00:21:12,550
!انتظري يا حمقاء

262
00:21:12,680 --> 00:21:15,390
!لم تستطيعي حمايتها البارحة

263
00:21:15,970 --> 00:21:19,930
!ماذا؟! لقد عدتُ للتّوّ

264
00:21:20,180 --> 00:21:23,940
!انتظروني رجاءً! تمهّلوا

265
00:21:36,450 --> 00:21:37,580
...أبي

266
00:21:37,780 --> 00:21:39,200
!أنت، حان الوقت

267
00:21:40,080 --> 00:21:44,920
.ماذا؟ أتيتم لاصطحابي؟ يا لكرمكم

268
00:21:58,810 --> 00:22:00,470
...مـ-مستحيل

269
00:22:01,060 --> 00:22:02,850
...ذلك الرّجل

270
00:22:09,570 --> 00:22:13,610
!أين تعتقدين نفسك ذاهبة؟
!حياتك في خطر

271
00:22:14,990 --> 00:22:16,740
!دعني أذهب

272
00:22:17,410 --> 00:22:18,410
!عليّ الذّهاب

273
00:22:18,530 --> 00:22:21,080
!مهلاً! تمالكي نفسك

274
00:22:21,240 --> 00:22:22,950
!دعني أذهب

275
00:22:23,870 --> 00:22:25,330
!ما الّذي يحدث؟

276
00:22:25,460 --> 00:22:26,420
!توكو

277
00:22:26,580 --> 00:22:28,840
!سيعدمونه

278
00:22:29,960 --> 00:22:31,920
!دعني أذهب

279
00:22:31,920 --> 00:22:34,050
!سيُقتل

280
00:22:34,300 --> 00:22:37,180
!إنّه أبي

281
00:22:40,930 --> 00:22:41,970
...توكو

282
00:22:42,220 --> 00:22:43,640
!ماذا قلتِ؟

283
00:22:49,860 --> 00:22:55,610
يبدو أنّ اليوم سيكون يومًا جميلاً
...في عاصمة الزّهور

284
00:23:04,450 --> 00:23:07,250
.يقترب موعد إعدام تونوياسو

285
00:23:07,250 --> 00:23:12,460
ينطلق طاقم قبّعة القشّ لإيقاف
.الإعدام مطيحين بالحرّاس المنيعين

286
00:23:12,460 --> 00:23:17,130
!هل سيتشارك تونوياسو مصير براعم الكرز؟

287
00:23:17,130 --> 00:23:22,180
!سيتمّ الكشف عن الحقيقة خلف ابتسامته

288
00:23:22,310 --> 00:23:23,600
:في الحلقة القادمة من وان بيس

289
00:23:23,600 --> 00:23:27,060
!اندفاع طاقم قبّعة القشّ"
"!إنقاذ تونوياسو الأسير

290
00:23:27,060 --> 00:23:29,190
!ملك القراصنة، لن يكون إلاّ أنا