1
00:00:13,920 --> 00:00:15,450
...إرادة موروثة

2
00:00:15,450 --> 00:00:17,690
...تعاقب الأزمنة... أحلام النّاس

3
00:00:18,360 --> 00:00:21,190
.لا رادع لهذه الأشياء

4
00:00:21,190 --> 00:00:24,290
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:24,290 --> 00:00:26,930
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:35,540 --> 00:00:41,910
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:41,910 --> 00:00:47,420
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:00:47,420 --> 00:00:53,420
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:00:53,420 --> 00:00:56,930
أشعر بـ"الجمال" في كلّ مكان

10
00:00:56,930 --> 00:01:00,230
أنا متمسّك بكم بشدّة بالفعل

11
00:01:00,230 --> 00:01:06,870
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:06,870 --> 00:01:10,170
إلى أن أحصل عليه بكلّ إثارة

13
00:01:10,170 --> 00:01:17,180
!آمنوا ببلاد العجائب

14
00:01:19,080 --> 00:01:25,290
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:25,290 --> 00:01:31,290
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:31,290 --> 00:01:34,400
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:34,400 --> 00:01:37,730
،بل أريدها حياة عاديّة لا غير

18
00:01:37,730 --> 00:01:40,970
فاركضوا نحو النّعيم بدل ذلك

19
00:01:41,170 --> 00:01:50,910
!آمنوا ببلاد العجائب

20
00:01:59,690 --> 00:02:03,890
بلدة ترحّب بالقراصنة؟"
".الوصول إلى ويسكي بيك

21
00:02:18,940 --> 00:02:21,340
ما قصّة هذا الثّلج؟

22
00:02:21,340 --> 00:02:23,910
.كان الجوّ ساخنًا قبل مدّة قصيرة

23
00:02:26,480 --> 00:02:28,080
!حسنًا! انتهيت

24
00:02:28,580 --> 00:02:31,820
هذا هو الرّجل الّذي سقط
!من السّماء، السّيد برميل الثّلج

25
00:02:33,350 --> 00:02:36,220
...يا له من رجل ثلج بشع

26
00:02:36,220 --> 00:02:36,860
!ماذا؟

27
00:02:37,820 --> 00:02:42,060
انظر لعمليّ الفنّيّ المليء
!بالرّوح، ملكة الثّلج

28
00:02:42,330 --> 00:02:44,060
!مذهل! ذلك رائع

29
00:02:44,060 --> 00:02:46,030
!حسنًا! لكمة برميل الثّلج

30
00:02:51,400 --> 00:02:53,640
!ما الّذي تفعله؟

31
00:02:54,270 --> 00:02:55,670
!السّيّد برميل الثّلج

32
00:02:55,670 --> 00:02:56,810
!كيف تجرؤ؟

33
00:02:57,140 --> 00:02:58,740
!سُحقًا لك! سُحقًا لك! سُحقًا لك

34
00:02:58,940 --> 00:03:01,050
!ما رأيك في هذه؟

35
00:03:01,050 --> 00:03:03,250
!أيّها الوغد! تمهّل يا لوفي

36
00:03:05,350 --> 00:03:09,050
لماذا هما مفعمان بالحيويّة
في هذا الجوّ البارد؟

37
00:03:13,460 --> 00:03:16,360
نامي-سان! كم من تجريف
ثلج الحبّ تريدين منّي أن أفعل؟

38
00:03:16,360 --> 00:03:18,960
واصل حتّى تتوقّف الثّلوج
!يا سانجي-كُن

39
00:03:18,960 --> 00:03:20,700
!حاضر يا نامي-سان

40
00:03:21,100 --> 00:03:25,040
أنتِ. ألا يوجد سخّان في هذه السّفينة؟

41
00:03:25,040 --> 00:03:26,540
.أشعر بالبرد

42
00:03:26,540 --> 00:03:31,010
!اخرسا! أنتما لستما ضيفين
!اخرجا لتجرفا الثّلج أو ما شابه

43
00:03:33,780 --> 00:03:34,780
!برق؟

44
00:03:35,750 --> 00:03:38,750
!ما الّذي يحدث مع هذا الطّقس هنا؟

45
00:03:43,120 --> 00:03:45,190
.كان الجوّ صحوًا قبل مدّة قصيرة

46
00:03:45,190 --> 00:03:48,320
...ثمّ بدأت السّماء تُثلج والآن تُبرق

47
00:03:48,320 --> 00:03:51,230
إنّ المواسم وكذلك الطّقس
.تحدث بشكل عشوائيّ

48
00:03:51,230 --> 00:03:53,200
.تمامًا كما قال كروكس-سان

49
00:03:53,460 --> 00:03:56,170
.هكذا هو الحال في الغراند لاين

50
00:03:56,170 --> 00:03:58,670
.يبدو أنّك جاهلة بأحوال الغراند لاين

51
00:03:59,370 --> 00:04:02,540
لم تقومي بتوجيه السّفينة لمدّة طويلة
الآن. ألا بأس بذلك بالفعل؟

52
00:04:03,940 --> 00:04:06,110
.تحقّقتُ للتّوّ من الاتّجاه

53
00:04:10,010 --> 00:04:10,850
ماذا هناك؟

54
00:04:10,850 --> 00:04:11,950
ما الخطب؟

55
00:04:11,950 --> 00:04:13,780
!هل من خطب ما يا نامي-سان؟

56
00:04:15,050 --> 00:04:16,090
!مستحيل

57
00:04:16,450 --> 00:04:19,150
!أديروا السّفينة 180 درجة! بسرعة

58
00:04:19,150 --> 00:04:22,120
‫180 درجة؟! لماذا سنعود أدراجنا؟!

59
00:04:22,120 --> 00:04:23,290
هل نسينا شيئًا ما؟

60
00:04:23,630 --> 00:04:26,800
استدارت السّفينة وهي تسير
!الآن في الاتّجاه المعاكس

61
00:04:26,800 --> 00:04:29,600
عندما أبعدتُ نظري عن اللوغ
...بوس للحظة

62
00:04:30,230 --> 00:04:31,930
...كانت الأمواج هادئة قبل قليل

63
00:04:32,270 --> 00:04:35,070
هل أنت ملاّحة بالفعل؟

64
00:04:35,940 --> 00:04:41,740
لا يمكن الوثوق بالرّياح والسّماء والأمواج
...والغيوم أو أيّ شيء في هذا البحر

65
00:04:41,740 --> 00:04:45,980
الشّيء الوحيد الّذي لا يتغيّر هو الاتّجاه
.الّذي تشير إليه اللوغ بوس

66
00:04:45,980 --> 00:04:47,550
هل تفهمين ذلك؟

67
00:04:48,880 --> 00:04:52,520
كفاكما من أمرًا ونهيًا عليّ والبطّانيّات
!تلفّكما واخرجا للمساعدة

68
00:04:53,090 --> 00:04:54,420
!شدّوا عمود الشّراع

69
00:04:54,420 --> 00:04:57,830
!واجهوا الرّياح من الميمنة
!أديروا السّفينة 180 درجة يسارًا

70
00:04:57,830 --> 00:04:58,930
!أوسوبّ! تولّ الشّراع المثلّث

71
00:04:58,930 --> 00:04:59,260
!حاضر

72
00:04:59,260 --> 00:05:00,360
!سانجي-كُن! تولّ المقود

73
00:05:00,360 --> 00:05:01,230
!أنا لها يا نامي-سان

74
00:05:01,530 --> 00:05:03,000
!أنتما! أعتمد عليكما

75
00:05:03,000 --> 00:05:05,200
.إنّها تشغّلنا كالعبيد

76
00:05:05,730 --> 00:05:07,970
.مهلاً! تغيّرت الرّياح

77
00:05:07,970 --> 00:05:08,940
!مستحيل

78
00:05:12,840 --> 00:05:14,240
!إنّها أولى نفحات الرّبيع

79
00:05:14,240 --> 00:05:15,010
لماذا؟

80
00:05:15,340 --> 00:05:18,250
!لا تنم فحسب والثّلوج تتراكم عليك

81
00:05:20,580 --> 00:05:23,850
!يا رفاق! رأيتُ دلفينًا يقفز هناك
.لنذهب إليه

82
00:05:23,850 --> 00:05:25,320
!أنت اخرس

83
00:05:29,560 --> 00:05:31,360
!إنّ الأمواج ترتفع

84
00:05:31,360 --> 00:05:33,090
أرى جبلاً جليديًّا في اتّجاه
!السّاعة العاشرة

85
00:05:33,460 --> 00:05:34,930
!نامي-سان! الضّباب ينتشر

86
00:05:34,930 --> 00:05:37,200
!ما خطب هذا البحر؟

87
00:05:37,530 --> 00:05:40,770
!ما-ما... سنصطدم به

88
00:05:57,080 --> 00:05:59,180
اسمعي! ثمّة مياه تتسرّب
!من أسفل السّفينة

89
00:05:59,180 --> 00:06:00,320
!علينا ترقيع التّسرّب حالاً

90
00:06:00,320 --> 00:06:00,950
!أنا لها

91
00:06:05,090 --> 00:06:06,630
!تتحرّك السّحب بسرعة

92
00:06:11,460 --> 00:06:12,700
!ثمّة رياح قادمة

93
00:06:13,800 --> 00:06:14,370
!إنّها قويّة

94
00:06:15,100 --> 00:06:16,000
!إنّها قادمة

95
00:06:18,040 --> 00:06:20,410
!لفّوا الأشرعة! الرّياح قويّة جدًّا

96
00:06:20,410 --> 00:06:22,410
!سوف ننقلب إن واجهناها مباشرة

97
00:06:22,940 --> 00:06:25,540
!يا رفاق! وقت الطّعام
!لنستجمع قوّتنا

98
00:06:28,350 --> 00:06:29,980
!أنت تأكل الكثير

99
00:06:33,150 --> 00:06:35,290
!مصيبة! سيتمزّق الشّراع

100
00:06:35,290 --> 00:06:37,490
.انس بشأن الأمور هنا
!أصلح أسفل السّفينة

101
00:06:37,490 --> 00:06:39,220
!تضرّر جزء آخر من أسفل السّفينة

102
00:06:39,220 --> 00:06:40,390
!سُحقًا

103
00:07:06,450 --> 00:07:08,620
.كان ذلك جيّدًا

104
00:07:17,960 --> 00:07:22,400
،لا يهمّ كم أنّ الجوّ صحو
.لا يجب عليكم أن تتكاسلوا

105
00:07:23,400 --> 00:07:25,400
.من الأفضل أن نكون في الطّريق الصّحيح

106
00:07:25,770 --> 00:07:28,040
...يا لك من

107
00:07:29,640 --> 00:07:31,440
لماذا أنتما على متن هذه السّفينة؟

108
00:07:31,440 --> 00:07:32,610
!فهمك بطيء

109
00:07:33,440 --> 00:07:37,510
.نحن في طريقنا إلى بلدتهما الآن
.إنّها تدعى ويسكي بيك

110
00:07:37,510 --> 00:07:41,380
تقصد أنّنا سنعيدهما لبلدتهما؟
.لا تدين لهما بأيّ شيء

111
00:07:41,380 --> 00:07:42,980
.نعم، معك حقّ

112
00:07:43,690 --> 00:07:45,350
...حسنًا، ذلك لا يهمّني

113
00:07:46,190 --> 00:07:49,320
نعم، نعم، واضح من وجهيكما
.أنّكما لا تنويان على خير

114
00:07:49,690 --> 00:07:51,590
ما كانت أسماؤكما؟

115
00:07:52,430 --> 00:07:54,960
.أ-أنا سيّد 9

116
00:07:55,430 --> 00:07:57,300
.وأنا آنسة وينزداي

117
00:07:57,670 --> 00:08:02,870
صحيح... هنالك شيء ما يزعجني
...مذ أن سمعتُ باسميكما

118
00:08:03,400 --> 00:08:07,110
أشعر وكأنّني سمعتها من قبل
...أو ما شابه

119
00:08:08,340 --> 00:08:10,010
...حسنًا، في كلّ الأحوال

120
00:08:12,880 --> 00:08:17,020
كيف تجرؤ على النّوم بكلّ
راحة طوال هذا الوقت...؟

121
00:08:17,020 --> 00:08:20,120
...تواصل النّوم مهما حاولنا إيقاظك

122
00:08:20,120 --> 00:08:21,360
!ماذا؟

123
00:08:26,460 --> 00:08:30,430
!لا ترخوا دفاعاتكم يا رفاق
.لا ندري ما قد يحدث ثانية

124
00:08:30,800 --> 00:08:33,270
تمكّنت أخيرًا من إدراك
.خطر هذا البحر للتّوّ

125
00:08:33,700 --> 00:08:36,240
.تمكّنت من إدراك سبب تسميته بالغراند لاين

126
00:08:37,600 --> 00:08:42,480
لا شكّ في الأمر، بما أنّ مهاراتي
.الملاحيّة لا تفيد على الإطلاق

127
00:08:43,280 --> 00:08:46,780
يا للصّراحة... هل سنكون بخير؟

128
00:08:47,710 --> 00:08:50,720
.سنكون بخير! سننجح في رحلتنا بكلّ تأكيد

129
00:08:51,150 --> 00:08:52,820
...في الحقيقة

130
00:08:52,820 --> 00:08:56,290
.انظروا! انتهت رحلتنا الأولى

131
00:09:08,900 --> 00:09:10,370
!إنّها جزيرة

132
00:09:12,570 --> 00:09:14,410
...تلك هي ويسكي بيك

133
00:09:15,510 --> 00:09:18,410
.لكنّها جزيرة غريبة المظهر بالفعل

134
00:09:18,410 --> 00:09:20,680
!أشجار الصّبّار تلك ضخمة

135
00:09:24,780 --> 00:09:26,820
.سنغادر الآن

136
00:09:26,820 --> 00:09:29,120
.شكرًا لإيصالنا لموطننا يا أعزّائي

137
00:09:29,120 --> 00:09:30,760
!سنلتقي ثانية إن كان القدر سيجمعنا

138
00:09:31,690 --> 00:09:33,220
!مع السّلامة يا أعزّائي

139
00:09:39,800 --> 00:09:41,200
...لقد ذهبا

140
00:09:41,200 --> 00:09:43,500
من كانا من الأساس؟

141
00:09:43,500 --> 00:09:45,640
!من يهتمّ؟ سوف نُرسي

142
00:09:46,670 --> 00:09:50,440
ثمّة نهر أمامنا. يبدو أنّ بإمكاننا
.الإبحار فيه بالسّفينة

143
00:09:52,980 --> 00:09:56,480
هـ-هل ممكن أنّ هنالك
وحوشًا أو ما شابه؟

144
00:09:56,910 --> 00:10:00,550
.ذلك احتمال وارد بالتّأكيد
.نحن في الغراند لاين

145
00:10:00,550 --> 00:10:03,520
سنغادر الجزيرة ببساطة
.إن قابلنا وحوشًا

146
00:10:04,150 --> 00:10:05,560
.مهلاً لحظة

147
00:10:05,560 --> 00:10:10,490
لا تنس أنّ علينا البقاء على
.هذه الجزيرة لمدّة معيّنة

148
00:10:11,190 --> 00:10:12,200
لماذا؟

149
00:10:12,860 --> 00:10:16,200
ما لم نسجّل مجال هذه الجزيرة
،المغناطيسيّ في اللوغ بوس

150
00:10:16,200 --> 00:10:18,570
.فلن نستطيع الذّهاب للجزيرة التّالية

151
00:10:18,570 --> 00:10:21,700
بما أنّ كلّ جزيرة تحتاج لوقت
،مختلف لتسجيل مجالها

152
00:10:21,700 --> 00:10:24,670
تتطلّب بعض الجزر بضع
.ساعات فقط، بينما أخرى أيّامًا

153
00:10:25,140 --> 00:10:29,080
إ-إذًا حتّى إن كانت جزيرة وحوش
،نودّ الهرب منها في الحال

154
00:10:29,080 --> 00:10:33,120
فمن الممكن أن يكون علينا البقاء هنا
لعدّة أيّام إلى أن نسجّل المجال؟

155
00:10:33,120 --> 00:10:34,520
.هذا صحيح

156
00:10:35,250 --> 00:10:38,720
حسنًا، بإمكاننا التّفكير في ذلك
!عندما يحدث. فدعونا نذهب

157
00:10:39,050 --> 00:10:43,030
.لوفي على حقّ. فلنذهب
.لا يستحقّ الأمر التّفكير فيه

158
00:10:43,030 --> 00:10:46,730
.سأحمي نامي-سان مهما حدث

159
00:10:47,200 --> 00:10:51,170
...مـ-مهلاً يا رفاق. مرضي المزمن قد

160
00:10:51,170 --> 00:10:53,170
..."أعاني مرض "لا تذهب للجزيرة

161
00:10:53,170 --> 00:10:54,400
.لنذهب إذًا

162
00:10:54,400 --> 00:10:57,640
اسمعوا. كونوا متأهّبين للهرب
.كما أنتم متأهّبين للقتال

163
00:10:55,140 --> 00:10:55,840
...كلاّ

164
00:10:57,640 --> 00:11:02,380
...حسنًا... كما قلت، مرضي المزمن

165
00:11:02,380 --> 00:11:04,110
...أعتقد أنّكم لا تستمعون لي

166
00:11:04,410 --> 00:11:06,580
...أتساءل ما الّذي سيظهر

167
00:11:07,050 --> 00:11:08,980
...أ-أرجوك

168
00:11:21,900 --> 00:11:24,300
.انظروا، سفينة قراصنة

169
00:11:26,170 --> 00:11:28,000
!أتى القراصنة

170
00:11:57,030 --> 00:11:59,270
.ماذا؟ ثمّة شيء يتحرّك

171
00:11:59,600 --> 00:12:01,770
!بشر؟ إنّهم بشر

172
00:12:02,970 --> 00:12:04,540
.يا رفاق، كونوا حذرين

173
00:12:04,840 --> 00:12:08,240
،سُحقًا! بما أنّ الأمر آل إلى هذا
.فقد جهّزت نفسي

174
00:12:09,180 --> 00:12:13,310
،سواء كنتم وحوشًا أم لا
!فأظهروا أنفسكم

175
00:12:24,820 --> 00:12:26,660
!مرحبًا بكم في الغراند لاين

176
00:12:26,660 --> 00:12:28,390
!مرحبًا بكم في بلدتنا

177
00:12:28,390 --> 00:12:30,630
!إنّها البلدة المضيافة ويسكي بيك

178
00:12:31,200 --> 00:12:35,200
!لـ... ليسوا وحوشًا، إنّهم يرحّبون بنا

179
00:12:37,870 --> 00:12:39,370
ما الّذي يحدث؟

180
00:12:39,370 --> 00:12:42,140
!أيّها القراصنة! مرحبًا في بلدتنا

181
00:12:42,140 --> 00:12:45,440
!مرحى لأبطال البحار

182
00:12:49,880 --> 00:12:51,720
!ثمّة الكثير من الفتيات الجميلات

183
00:12:51,980 --> 00:12:54,790
!انظروا إلى هنا! إنّهم وسيمون

184
00:12:56,650 --> 00:13:01,260
.ربّما القراصنة هم أبطال النّاس

185
00:13:01,530 --> 00:13:03,430
!مرحبًا

186
00:13:07,500 --> 00:13:08,770
...مرحـ

187
00:13:11,140 --> 00:13:13,040
...ما-ما-ما

188
00:13:13,040 --> 00:13:14,400
.مرحبًا بكم

189
00:13:17,640 --> 00:13:22,610
.اسمي إيغارابّوي. أنا عمدة ويسكي بيك

190
00:13:22,610 --> 00:13:25,220
.أنا لوفي. سررت بلقائك

191
00:13:25,580 --> 00:13:27,450
.أيّها العمّ، لقد تماديت في لفّ شعرك

192
00:13:27,780 --> 00:13:31,520
ويسكي بيك بلدة تزدهر بصناعة
.الخمور والموسيقى

193
00:13:31,520 --> 00:13:33,920
.الضّيافة هي فخر بلدتنا

194
00:13:33,920 --> 00:13:36,560
،أمّا خمورنا الّتي نفخر بها
.فهي وفيرة وفرة مياه البحر

195
00:13:36,560 --> 00:13:39,530
هلاّ سمحتم لنا بإقامة حفلة لكم

196
00:13:39,530 --> 00:13:41,900
...لنستمع للقصص الّتي ستروونها

197
00:13:43,800 --> 00:13:46,500
...ما-ما-ما

198
00:13:47,100 --> 00:13:48,640
!عن مغامراتكم؟

199
00:13:48,970 --> 00:13:50,770
!سيسرّنا ذلك

200
00:13:51,910 --> 00:13:52,910
!ممتاز

201
00:13:53,280 --> 00:13:54,410
...ثلاثة أغبياء

202
00:13:54,980 --> 00:13:56,410
،بالمناسبة

203
00:13:56,410 --> 00:13:58,880
كم ستحتاج البوصلة إلى
أن يتمّ تسجيل المجال؟

204
00:13:58,880 --> 00:14:02,720
.تسجيل المجال؟ انسي تلك الأمور المملّة

205
00:14:02,720 --> 00:14:04,620
.ارتاحي فقط بعد رحلتكم الطّويلة

206
00:14:05,020 --> 00:14:09,890
!يا رفاق! استعدّوا للحفلة
!غنوّا للتّرفيه عن المغامرين

207
00:14:10,230 --> 00:14:12,990
!وقت الاحتفال

208
00:14:41,990 --> 00:14:44,930
،ثمّ قلتُ بكلّ روعة

209
00:14:44,930 --> 00:14:48,000
."يا ملوك البحر، لا تلمسوا أصدقائي"

210
00:14:48,530 --> 00:14:51,630
!أنت مذهل

211
00:14:48,530 --> 00:14:51,630
!قائد أوسوبّ

212
00:14:52,000 --> 00:14:56,970
،ولكن بالنّسبة للحزام الهادئ
.فحتّى أنا ارتعشت

213
00:14:56,970 --> 00:14:58,140
!ارتعشتُ حماسًا

214
00:14:58,140 --> 00:14:59,210
!مذهل

215
00:14:59,210 --> 00:15:00,910
!في صّحة أوسوبّ-سان

216
00:15:00,910 --> 00:15:03,880
.حسنًا، اشربي ولا تتهاوني

217
00:15:03,880 --> 00:15:07,010
.لا، شكرًا. أفضّل ألاّ أشرب الكحول

218
00:15:07,010 --> 00:15:08,520
...لا تقلـ

219
00:15:09,720 --> 00:15:12,420
...ما-ما-ما

220
00:15:12,420 --> 00:15:13,890
.لا تقلقي

221
00:15:13,890 --> 00:15:19,030
إنّه مشروب خاصّ مُعدّ من عنب
.فاخر يُستعمل لصنع نبيذ فاخر

222
00:15:19,430 --> 00:15:23,360
،مذاقه كمذاق النّبيذ بعينه
.لكنّه لا يحتوي أيّ كحول

223
00:15:23,660 --> 00:15:25,000
...هكذا إذًا

224
00:15:26,330 --> 00:15:28,170
!معك حقّ! إنّه لذيذ

225
00:15:28,470 --> 00:15:30,770
.كان حصاد العنب وفيرًا هذه السّنة أيضًا

226
00:15:30,770 --> 00:15:35,170
والآن، سنقيم مسابقة تقديم النّخب
.الاعتياديّة احتفالاً بالحصاد

227
00:15:35,810 --> 00:15:41,080
سنقوم بتقديم نخب تلو الآخر
.وآخر المتبقّين هو الفائز

228
00:15:41,080 --> 00:15:42,380
.انضمّوا لمسابقتنا رجاءً

229
00:15:42,920 --> 00:15:45,780
.لا، شكرًا. لا يمكنني شرب كلّ ذلك

230
00:15:45,780 --> 00:15:49,450
!مبلغ جائزة الفائز هو 100 ألف بيري

231
00:15:50,760 --> 00:15:51,860
!كأس أخرى

232
00:15:52,360 --> 00:15:55,390
!زورو! شارك أنت أيضًا
لا مال لديك، صحيح؟

233
00:15:55,390 --> 00:15:56,190
!ماذا؟

234
00:15:56,190 --> 00:15:57,500
!في صحّتكم

235
00:16:01,370 --> 00:16:03,600
!مهلاً! هذا رائع! لقد أنهى الكأس العاشرة

236
00:16:04,270 --> 00:16:07,170
.يكفي. لا يمكنني شرب المزيد

237
00:16:08,240 --> 00:16:10,880
!أنهت الفتاة كأسها الثّاني عشر

238
00:16:12,480 --> 00:16:14,050
!أجل

239
00:16:14,050 --> 00:16:15,610
!المزيد من الطّعام

240
00:16:15,610 --> 00:16:19,080
!مذهل! أنهى القائد وجبة لعشرين شخص

241
00:16:19,080 --> 00:16:20,620
!انهار الطّبّاخ

242
00:16:21,320 --> 00:16:22,750
...لا يمكنني المواصلة

243
00:16:23,950 --> 00:16:27,860
يحاول هذا الشّابّ مغازلة
!عشرين فتاة في آن واحد

244
00:16:27,860 --> 00:16:29,760
!ما هذا الطّاقم؟

245
00:16:31,400 --> 00:16:33,060
...إنّهم مرحون فعـ

246
00:16:34,630 --> 00:16:37,170
...ما-ما-ما

247
00:16:37,170 --> 00:16:38,670
!مرحون فعلاً

248
00:16:38,670 --> 00:16:42,210
.أنا سعيد لأنّكم تبدون جميعًا مستمتعين

249
00:16:47,380 --> 00:16:50,550
...بل أنا جدّ سعيد بالفعل

250
00:16:51,550 --> 00:16:58,150
ولذلك السّبب، فشلنا في
...مهمّة تأمين الطّعام

251
00:16:58,150 --> 00:17:02,730
ولكن، نودّ أن نبلغكم أنّنا نجحنا

252
00:17:02,730 --> 00:17:08,130
في استدراج الطّاقم لجزيرة
.الصّبّار يا أعزّائي

253
00:17:08,130 --> 00:17:12,700
حسنًا! إن أرسلنا هذه، فسنكون قادرين
.على تبرئة اسمينا بطريقة ما

254
00:17:13,070 --> 00:17:15,670
صحيح. سأضعها في صندوق
.المشؤومين في الحال

255
00:17:21,340 --> 00:17:23,250
...سيوصلانه من أجلنا

256
00:17:27,650 --> 00:17:28,820
...إلى الزّعيم

257
00:17:29,820 --> 00:17:31,720
.هذا يكفي. أستسلم. سأخلد للنّوم

258
00:17:32,590 --> 00:17:36,690
مهلاً! بلغ الشّابّ حدوده أخيرًا
.بعد الكأس الثّالث عشر

259
00:17:36,690 --> 00:17:40,030
!ماذا؟! لا أمل منك يا زورو

260
00:17:40,030 --> 00:17:41,500
.بقي اثنتان فحسب

261
00:17:41,500 --> 00:17:43,670
.لقد وصلا لكأسهما الخامس عشر
.إنّها تنافس الأخت

262
00:17:44,600 --> 00:17:47,200
،عليك أن تتوقّفي قريبًا أيضًا
.من أجل مصلحتك

263
00:17:47,200 --> 00:17:52,340
لا تكوني سخيفة! لن أستسلم بكلّ
.تأكيد حتّى أحصل على الجائزة

264
00:17:55,240 --> 00:17:58,380
.شكرًا على الطّعام
.لا يمكنني أكل المزيد

265
00:17:58,380 --> 00:18:00,580
!انهار ثلاثة طبّاخين أيضًا

266
00:18:00,580 --> 00:18:02,150
.سعيد لأنّ الطّعام أعجبك

267
00:18:04,280 --> 00:18:05,690
.لا يمكنني المواصلة

268
00:18:06,020 --> 00:18:07,790
!لقد فزت

269
00:18:10,560 --> 00:18:12,590
!كم هذا ممتع

270
00:18:12,590 --> 00:18:14,160
.انهارت أخيرًا

271
00:18:16,200 --> 00:18:18,470
...يا لها من بلدة رائعة

272
00:18:19,570 --> 00:18:22,040
.أنا في النّعيم

273
00:18:31,710 --> 00:18:34,080
إذًا فقد أنهكوا أنفسهم
...بالاحتفال وخلدوا للنّوم

274
00:18:37,650 --> 00:18:38,990
...أحلامًا سعيدة

275
00:18:40,790 --> 00:18:42,520
...أيّها المغامرون

276
00:18:44,590 --> 00:18:49,130
صخور الصّبّار جميلة اليوم أيضًا
.وهي ترقص تحت ضوء القمر

277
00:18:52,900 --> 00:18:57,700
.أنت شاعر بارع يا إيغارابّوي... بل يا سيّد 8

278
00:18:58,100 --> 00:18:59,300
...هذا أنتما

279
00:19:01,270 --> 00:19:02,210
ماذا حدث لهم؟

280
00:19:02,770 --> 00:19:04,010
...لقد انهاروا

281
00:19:07,950 --> 00:19:09,410
...وفي طريقهم للجحيم

282
00:19:12,420 --> 00:19:18,520
،يا إلهي... بما أنّهم كانوا عنيدين جدًّا
.أضفت القليل من الكحول لمشروباتهم

283
00:19:18,790 --> 00:19:21,090
وإلاّ لكانوا لا يزالون مستيقظين
.ويستمتعون بوقتهم

284
00:19:21,460 --> 00:19:26,230
لكن هل كان من الضّروريّ فعلاً
...التّخطيط لكلّ هذا بالتّفصيل

285
00:19:29,370 --> 00:19:31,900
من أجل خمسة ضعفاء فحسب؟

286
00:19:32,370 --> 00:19:38,210
.كان علينا هزيمتهم في الميناء
.تفتقر البلدة للطّعام من الأساس

287
00:19:38,680 --> 00:19:41,150
وأيضًا، لم ترتفع آمالنا من أجل
.لحم الحوت من البداية

288
00:19:41,150 --> 00:19:44,550
!لا داعي لقول ذلك
!لقد بذلنا كلّ ما بوسعنا

289
00:19:44,950 --> 00:19:49,520
.اهدآ. انظروا لهذا
.تحقّقت من أمرهم مسبقًا

290
00:19:50,720 --> 00:19:52,890
!ثـ-ثلاثون مليون بيري؟

291
00:19:52,890 --> 00:19:54,220
!هؤلاء؟

292
00:19:54,520 --> 00:19:59,330
من الغباء الحكم على قدرات القراصنة
...من مظهرهم فحسب يا آنسة مانـ

293
00:20:01,730 --> 00:20:03,470
...ما-ما-ما

294
00:20:03,470 --> 00:20:05,100
.يا آنسة مانداي

295
00:20:05,500 --> 00:20:07,470
.آ-آسفة

296
00:20:08,140 --> 00:20:10,610
.لكنّنا اهتممنا بالأمر سلفًا

297
00:20:10,610 --> 00:20:12,780
يبدو أنّ بإمكاننا إرسال
.تقرير جيّد للزّعيم

298
00:20:12,780 --> 00:20:15,850
صادروا كلّ المال والأشياء الثّمينة
.الّتي على سفينتهم في الحال

299
00:20:15,850 --> 00:20:17,650
وماذا عنهم؟

300
00:20:17,650 --> 00:20:18,550
ماذا سنفعل؟

301
00:20:19,120 --> 00:20:22,020
إن قتلناهم، ستنقص المكافأة
.بنسبة 30 بالمائة

302
00:20:22,380 --> 00:20:25,720
.تسعى الحكومة دائمًا للإعدامات العلنيّة

303
00:20:28,590 --> 00:20:30,730
!اذهبوا! أمسكوهم أحياء

304
00:20:31,530 --> 00:20:34,200
...عفوًا... أنا آسف

305
00:20:36,430 --> 00:20:38,970
لكن هلاّ تركتموهم نائمين؟

306
00:20:38,970 --> 00:20:41,370
.إنّهم متعبون جرّاء رحلتهم هذا المساء

307
00:20:47,510 --> 00:20:49,010
!سيّد 8! آنسة مانداي

308
00:20:49,010 --> 00:20:51,410
لقد هرب الرّجل ذو حزام الهاراماكي
!من الغرفة في غفلةٍ منّا

309
00:20:52,410 --> 00:20:53,580
.إنّه يقف هناك

310
00:20:54,020 --> 00:20:57,290
!وغد! ظننتُ أنّك تغطّ في نوم عميق

311
00:20:58,120 --> 00:21:02,760
إنّ السّيّافين لا يخطئون أبدًا
.ويرخون دفاعاتهم لذلك الحدّ

312
00:21:03,320 --> 00:21:07,230
.لذلك، دعوني أرى إن كنتُ محقًّا
.هذا وكر لصيّادي المكافآت

313
00:21:08,560 --> 00:21:14,000
تخدعون القراصنة ذوي الرّوح العالية
.جرّاء دخولهم توًّا للغراند لاين

314
00:21:14,940 --> 00:21:18,110
.يبدو أنّ ثمّة حوالي 100 صائد مكافآت هنا

315
00:21:19,510 --> 00:21:23,310
!سأقاتلكم جميعًا... يا باروك وركس

316
00:21:23,580 --> 00:21:26,280
!أيّها الوغد! كيف تعرف اسم شركتنا؟

317
00:21:27,150 --> 00:21:32,420
تمّ تجنيدي من طرف شركتكم إحدى
.المرّات عندما كنتُ أمارس نفس عملكم

318
00:21:32,420 --> 00:21:34,250
.لكنّني رفضتُ طبعًا

319
00:21:34,520 --> 00:21:39,160
لا يعرف العاملون هويّات بعضهم
.بعضًا ويستعملون أسماء رمزيّة

320
00:21:39,160 --> 00:21:42,960
وطبعًا يظلّ مخبأ الزّعيم
.وهويّته سرًّا حتّى لهم

321
00:21:42,960 --> 00:21:47,970
الباروك وركس جماعة إجراميّة
.تنفّذ أوامرها بكلّ إخلاص

322
00:21:49,740 --> 00:21:50,800
أكان ذلك سرًّا؟

323
00:21:52,370 --> 00:21:54,210
...هذا مفاجئ

324
00:21:55,470 --> 00:21:59,280
إن كنت تعرف أسرارنا، فلا خيار
.آخر أمامنا سوى قتلك

325
00:22:02,450 --> 00:22:03,820
...سيُضاف شاهد قبر آخر

326
00:22:05,120 --> 00:22:07,790
...لمقبرة صخور الصّبّار

327
00:22:33,540 --> 00:22:34,710
!اقتلوه

328
00:22:39,980 --> 00:22:41,850
!...لـ... لقد اختفى

329
00:22:56,770 --> 00:23:00,600
!أنا إلى جانبك

330
00:23:00,600 --> 00:23:04,310
آهٍ يا لها من أغنية رقيقة

331
00:23:04,310 --> 00:23:10,650
تصل إلى كلينا

332
00:23:11,550 --> 00:23:17,720
هدمت الأمواج تلك القلعة الرّمليّة الصّغيرة

333
00:23:19,160 --> 00:23:26,600
ونظرتَ إلى الغيوم المارّة بابتسامة كئيبة

334
00:23:27,330 --> 00:23:34,570
،حتّى إن امتلأ العالم بأعداء لنا

335
00:23:34,940 --> 00:23:38,240
فأنا أحمي ظهرك دائمًا

336
00:23:38,670 --> 00:23:46,680
فلا تفقد ثقتك

337
00:23:46,680 --> 00:23:50,550
!أنا إلى جانبك

338
00:23:50,550 --> 00:23:54,260
آهٍ يا حبّي

339
00:23:54,260 --> 00:24:00,460
سأمسك بك بين ذراعيّ للأبد

340
00:24:02,160 --> 00:24:05,930
!أنا إلى جانبك

341
00:24:11,240 --> 00:24:13,440
البلدة المضيافة هي
.وكر لصيّادي المكافآت

342
00:24:13,440 --> 00:24:15,410
هل أنت واثق أنّ عليك
إضافة شاهد قبر واحد؟

343
00:24:15,410 --> 00:24:17,810
ألن يأكل أحد ذلك اللّحم؟
.أريد أكله

344
00:24:17,810 --> 00:24:20,380
إنّها فرصة جيّدة لتجربة
كيتتسو الثّالث ويوباشيري

345
00:24:20,380 --> 00:24:21,720
اللّذين حصلتُ عليهما
.في لوغتاون

346
00:24:21,720 --> 00:24:23,780
.يا آنساتي، اقتربن أكثر

347
00:24:23,780 --> 00:24:25,750
!أنا القائد أوسوبّ

348
00:24:25,750 --> 00:24:27,860
!سأقدّم كلّ ما لديّ

349
00:24:28,120 --> 00:24:29,560
:في الحلقة القادمة من ون بيس

350
00:24:29,560 --> 00:24:32,230
!أسلوب السّيوف الثّلاثة المتفجّر"
"!زورو ضدّ شركة باروك وركس

351
00:24:32,230 --> 00:24:34,460
!ملك القراصنة، لن يكون إلاّ أنا