1
00:00:01,570 --> 00:00:03,490
...الثّروة والشّهرة والسّلطة

2
00:00:03,490 --> 00:00:05,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:05,450 --> 00:00:07,370
.ملك القراصنة، غولد روجر

4
00:00:07,370 --> 00:00:11,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:11,080 --> 00:00:14,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:14,840 --> 00:00:18,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:20,800 --> 00:00:25,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:25,720 --> 00:00:28,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:29,520 --> 00:00:34,110
سنجمع كل أحلامنا

10
00:00:35,110 --> 00:00:40,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:40,950 --> 00:00:42,570
!وان بيس

12
00:00:47,080 --> 00:00:51,920
لا تجلب البوصلات سوى التّأخيرات

13
00:00:52,750 --> 00:00:57,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:00:58,460 --> 00:01:03,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:03,760 --> 00:01:09,310
!فإنّها ليست أسطورة إذًا

16
00:01:10,520 --> 00:01:16,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:16,230 --> 00:01:21,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:21,400 --> 00:01:23,990
!وتظاهر أنّها غير موجودة

19
00:01:24,990 --> 00:01:29,830
سنجمع كلّ أحلامنا

20
00:01:30,830 --> 00:01:36,340
ونبحر باحثين عن شيء

21
00:01:36,340 --> 00:01:39,340
،عملة في جيبي

22
00:01:39,340 --> 00:01:42,590
وتريد أن تصبح صديقي؟

23
00:01:42,590 --> 00:01:47,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:47,970 --> 00:01:49,890
!إنّنا كذلك

25
00:01:52,790 --> 00:01:56,000
...الثّروة والشّهرة والسّلطة

26
00:01:57,100 --> 00:02:01,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:02,840 --> 00:02:08,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:09,320 --> 00:02:13,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:13,400 --> 00:02:17,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:18,260 --> 00:02:22,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:23,350 --> 00:02:27,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:49,520 --> 00:02:51,160
!لا تتكلّم بسخف

33
00:02:51,160 --> 00:02:54,120
أتظنّ أنّك تستطيع شراء سيف
!حقيقيّ بذلك المبلغ الزّهيد؟

34
00:02:54,120 --> 00:02:55,470
...حسنٌ

35
00:02:55,470 --> 00:02:57,140
!انقلع إن كنت لن تشتري أيّ شيء

36
00:02:57,140 --> 00:02:58,560
...يا إلهي

37
00:03:02,990 --> 00:03:04,750
...على أيّ حال

38
00:03:18,440 --> 00:03:20,520
...إلّم تخنّي الذّاكرة، إنّهما

39
00:03:20,520 --> 00:03:22,270
!تقدّم رجاءً

40
00:03:23,360 --> 00:03:25,000
...حقًّا

41
00:03:25,000 --> 00:03:28,250
!آسفان لأنّنا حاولنا ابتزازك

42
00:03:28,250 --> 00:03:31,530
لا تقلقا بشأن ذلك! شكرًا على
!إرشادي إلى الطّريق! إلى اللّقاء

43
00:03:33,540 --> 00:03:35,540
.الشّقيّان اللّذان دلاّني إلى الطّريق تلك المرّة

44
00:03:36,080 --> 00:03:37,290
!زورو-سان! زورو-سان

45
00:03:37,620 --> 00:03:39,500
!كن أخانا الكبير رجاءً

46
00:03:46,330 --> 00:03:50,540
!الأمّهات قويّات"
"!أعمال زورو المنزليّة المحمومة

47
00:03:52,360 --> 00:03:53,390
.أرفض

48
00:03:53,390 --> 00:03:55,080
!ماذا؟! حقًّا؟

49
00:03:55,080 --> 00:03:59,190
لِمَ عساي أصبح أخًا كبيرًا لشقيّين مثلكما؟

50
00:03:59,900 --> 00:04:01,640
.بربّك، لا تكن هكذا

51
00:04:01,640 --> 00:04:05,850
!لقد أعجبنا بك كثيرًا بعد رؤيتك تهزم البحريّة

52
00:04:05,850 --> 00:04:08,780
.أنا مايكل. سعيد للقائك

53
00:04:08,780 --> 00:04:09,950
.وأنا هويكل

54
00:04:10,530 --> 00:04:13,950
حول الشّوارع الخلفيّة، نحن الأخوان
...مشهوران قليلاً بـ

55
00:04:14,910 --> 00:04:17,750
!عليك أن تنصت للنّاس

56
00:04:18,500 --> 00:04:20,750
.أخي، سنأخذك حيثما تشاء

57
00:04:20,750 --> 00:04:22,800
أتريد الذّهاب لشراء بعض اللّحم؟
ماذا عن بعض الخضراوات؟

58
00:04:22,800 --> 00:04:23,710
.أرفض

59
00:04:23,710 --> 00:04:25,070
ترفض؟ ترفض ماذا؟

60
00:04:25,070 --> 00:04:27,380
.أن أصبح أخاكما الكبير وأن تدلاّني إلى الطّريق

61
00:04:27,380 --> 00:04:29,020
.اغربا عن وجهي

62
00:04:29,020 --> 00:04:31,340
نعم، صحيح! أخي، أنت تسعى
لشراء سيف، صحيح؟

63
00:04:31,340 --> 00:04:35,310
رفض أن يبيعني صاحب محلّ السّيوف
.سابقًا بما أنّني لا أملك الكثير من المال

64
00:04:35,620 --> 00:04:39,990
.إذًا عليك الذّهاب لمحلّ البضع المُستعملة
!أراهن أنّك ستجد صفقة رائعة

65
00:04:39,990 --> 00:04:42,980
نعم! سندلّ أخانا الكبير
!إلى محلّ البضع المستعملة

66
00:04:44,610 --> 00:04:45,940
.أظنّ أنّ ذلك لن يضرّ

67
00:04:46,330 --> 00:04:49,730
لكن دعاني أوضّح لكما أنّني
.لم أقبل أن أصبح أخاكما الكبير

68
00:04:49,730 --> 00:04:51,210
!نعم يا أخونا الكبير

69
00:04:51,990 --> 00:04:54,320
!هيّا، أفسحوا الطّريق، أفسحوا الطّريق

70
00:04:54,320 --> 00:04:56,500
!صائد القراصنة زورو-ساما سيمرّ

71
00:04:56,500 --> 00:04:57,160
!توقّفا

72
00:05:17,190 --> 00:05:20,020
.تهرّبا من المدرسة ويتسكّعان ثانيةً

73
00:05:20,020 --> 00:05:22,840
.لن يكونا مفيدين في شيء عندما يكبران
...يا لهما من طفلين جاحدين

74
00:05:22,840 --> 00:05:25,830
...في بيتهما، الأمّ هي الّتي

75
00:05:25,830 --> 00:05:28,360
.أشعر بالأسى على ذلكما الطّفلين

76
00:05:38,350 --> 00:05:39,990
.لم يحالفني الحظّ هنا أيضًا

77
00:05:40,820 --> 00:05:42,290
!إلامَ تنظران؟

78
00:05:42,290 --> 00:05:44,000
!هذا فظّ تجاه أخينا الكبير زورو

79
00:05:47,960 --> 00:05:50,280
اسمع، أليس ذلك السّياف الّذي برفقتهما

80
00:05:50,280 --> 00:05:53,670
هو أحد القراصنة الّذين أنقذوا أيسبرغ-سان؟

81
00:05:53,670 --> 00:05:56,130
.ماذا؟ ظننتُ أنّه بطل

82
00:05:56,130 --> 00:05:58,300
.أهو مجرّد رعاع إذًا؟ أخطأتُ الحكم عليه

83
00:05:59,490 --> 00:06:01,770
.لديكما سمعة استثنائيّة

84
00:06:01,770 --> 00:06:04,670
.أهل البلدة جاهلون

85
00:06:04,670 --> 00:06:06,940
.دعهم يقولون ما يشاؤون عنّا. لا نهتمّ لهم

86
00:06:06,940 --> 00:06:08,570
.حقًّا؟ طوبى لكما إذًا

87
00:06:08,570 --> 00:06:09,970
.حسنًا، إلى اللّقاء

88
00:06:09,970 --> 00:06:11,230
مـ-ماذا تقصد؟

89
00:06:11,230 --> 00:06:13,400
!هل ستتخلّى عن أخويك الصّغيرين العزيزين؟

90
00:06:13,400 --> 00:06:15,830
!كما قلت، لم أوافق أن أصبح أخاكما الكبير

91
00:06:15,830 --> 00:06:17,600
هل قلت شيئًا؟

92
00:06:17,600 --> 00:06:19,490
.لا نسمع أيّ شيء

93
00:06:19,490 --> 00:06:23,250
!عجبًا! ما ذلك؟

94
00:06:23,250 --> 00:06:24,930
!ماذا؟! ماذا؟

95
00:06:36,890 --> 00:06:38,370
.حسنًا، تخلّصت منهما

96
00:06:38,370 --> 00:06:39,470
!أخي

97
00:06:39,470 --> 00:06:41,100
!ماذا؟

98
00:06:50,000 --> 00:06:50,780
!أخي

99
00:06:58,970 --> 00:06:59,860
!أخي

100
00:07:02,360 --> 00:07:03,200
!أخي

101
00:07:04,500 --> 00:07:07,210
!أخي! أخي! أخي

102
00:07:07,210 --> 00:07:08,650
!أخي

103
00:07:19,480 --> 00:07:22,210
.نعرف هذه البلدة عن ظهر قلب

104
00:07:22,210 --> 00:07:24,350
.لا يمكنك أن تهرب منّا

105
00:07:25,030 --> 00:07:29,400
!اخرس! كفّا عن السّخريّة منّي أيّها الشّقيّان

106
00:07:30,330 --> 00:07:32,050
!هذا قاسٍ يا أخي

107
00:07:32,050 --> 00:07:34,110
!لا تنادني بأخيك

108
00:07:39,230 --> 00:07:40,500
من أنت يا هذه؟

109
00:07:40,500 --> 00:07:42,700
ماذا تظنّ نفسك فاعلاً بضربك لطفليّ؟

110
00:07:42,700 --> 00:07:45,200
...طفلاك؟ إذًا

111
00:07:47,450 --> 00:07:51,670
!يا لها من قوّة! ما بال هذه المرأة؟

112
00:07:54,790 --> 00:07:56,950
.لا بأس بك يا فتى

113
00:07:56,950 --> 00:08:01,810
!إذًا... الهجوم الخاصّ! زوبعة بام-بام

114
00:08:04,810 --> 00:08:07,570
!توقّفي يا أمّي! لم يرتكب أيّ خطأ

115
00:08:07,570 --> 00:08:08,980
!كان خطأنا نحن

116
00:08:10,580 --> 00:08:14,190
!هل أسأتما التّصرّف ثانيةً؟! أيّها الغبيّان

117
00:08:21,240 --> 00:08:22,740
.آسفة بشأن ذلك

118
00:08:22,740 --> 00:08:26,180
لكن أظنّ أنّ لا بأس، صحيح؟
بما أنّك أصبحت أخاهما الكبير؟

119
00:08:26,180 --> 00:08:27,700
.كلاّ، لم أصبح كذلك

120
00:08:28,620 --> 00:08:30,690
.اخرجوا يا أولاد وألقوا التّحيّة

121
00:08:30,690 --> 00:08:31,870
.أنا يوكو

122
00:08:31,870 --> 00:08:33,130
.أنا يويا

123
00:08:34,010 --> 00:08:34,960
.أنا شو

124
00:08:34,960 --> 00:08:36,270
.أنا أياكو

125
00:08:36,270 --> 00:08:37,590
.أنا أكيهيرو

126
00:08:37,770 --> 00:08:39,790
!رفاق، هذا أخونا الكبير زورو

127
00:08:39,790 --> 00:08:41,790
!إنّه أخونا الكبير الجديد

128
00:08:41,790 --> 00:08:45,180
أخوكما الكبير؟ لا تقولا لي أنّكما تريدان
منّي أن أصبح أخاكما الكبير حقًّا؟

129
00:08:46,160 --> 00:08:48,460
،تعال معنا. نحن متخلّفون في أعمالنا المنزليّة

130
00:08:48,460 --> 00:08:51,140
بما أنّنا أمضينا الكثير من الوقت
.في ترميم بيتنا عقب أكوا لاغونا

131
00:08:52,740 --> 00:08:54,870
!أخي! أخي

132
00:08:54,870 --> 00:08:59,080
!انتظروا! لم أوافق على هذا! دعوني

133
00:08:59,080 --> 00:09:00,720
!والآن، لنعد إلى البيت يا أولاد

134
00:09:00,720 --> 00:09:02,450
!أجل

135
00:09:14,950 --> 00:09:16,290
بالمناسبة، ما ذلك؟

136
00:09:16,660 --> 00:09:20,140
بينما تخرج أمّي للعمل، نذهب
لجمع خشب الخردة من الميناء

137
00:09:20,140 --> 00:09:21,980
،بينما نجالس أشقّاءنا

138
00:09:21,980 --> 00:09:24,860
،وعندما نحصل على ما يكفي من الخشب
.نذهب لبيعه في غالي-لا عند نهاية الأسبوع

139
00:09:24,860 --> 00:09:27,020
يمكننا أن نجني الكثير من
.أموال مصروفنا بتلك الطّريقة

140
00:09:28,330 --> 00:09:30,490
.حسنًا، ودّعا أمّكما عنّي

141
00:09:30,490 --> 00:09:31,990
هل ستغادر حقًّا؟

142
00:09:31,990 --> 00:09:34,550
...آسف، لكن لا علاقة لي بهذا، لذا

143
00:09:34,550 --> 00:09:35,060
!احترس

144
00:09:40,520 --> 00:09:41,170
...يا إلهي

145
00:09:41,170 --> 00:09:42,150
!أحسنت في رعاية الطّفل

146
00:09:44,000 --> 00:09:44,990
!أخي

147
00:09:50,830 --> 00:09:52,900
.لا بأس بك حقًّا

148
00:09:52,900 --> 00:09:55,000
!كما توقّعت، أنت بارع مع الأطفال

149
00:09:57,380 --> 00:09:59,460
!لقد بلّل نفسه

150
00:10:01,030 --> 00:10:02,360
.ناوله لي

151
00:10:03,250 --> 00:10:04,430
.اذهب وغيّر حفّاظاته

152
00:10:04,430 --> 00:10:04,970
!عُلم

153
00:10:04,970 --> 00:10:08,100
!أ-أنت! ماذا تفعلين؟! هل أنت منحرفة؟

154
00:10:08,100 --> 00:10:10,680
.سنغسله. ارتد هذا ريثما يجفّ

155
00:10:12,640 --> 00:10:15,060
!مـ-ما هذا؟

156
00:10:15,930 --> 00:10:17,340
اعتن به، مفهوم؟

157
00:10:17,340 --> 00:10:20,490
!حسنًا يا أولاد! لنعمل بجدّ وننظّف البيت

158
00:10:20,490 --> 00:10:21,890
!أجل

159
00:10:27,880 --> 00:10:30,410
...يا هويكل. آسف، لكنّي

160
00:10:36,540 --> 00:10:38,260
!أنت، أنت... أنت

161
00:10:38,260 --> 00:10:39,260
!توقّف

162
00:10:41,850 --> 00:10:44,260
...يا مايكل! افعل شيئًا بشأنهما

163
00:10:47,020 --> 00:10:47,970
!توقّف

164
00:11:02,960 --> 00:11:05,540
...أنتم! أين أضع هؤلاء الـ

165
00:11:09,600 --> 00:11:12,340
.لديك موهبة فطريّة في هذا. واصل

166
00:11:22,840 --> 00:11:25,970
.حسنًا، أحسنوا التّصرّف

167
00:11:29,530 --> 00:11:33,470
.يا سيّدتي. سأعود الآن. أعيدي لي قميصي

168
00:11:34,140 --> 00:11:35,630
عمّ تتحدّث؟

169
00:11:35,630 --> 00:11:38,650
ألديك ملجأ آخر أساسًا غير هذا البيت؟

170
00:11:38,650 --> 00:11:40,640
.نعم. أصدقائي ينتظرونني

171
00:11:40,640 --> 00:11:44,110
يا للغباء! الأصدقاء أو العائلة... أيّهم أهمّ؟

172
00:11:44,110 --> 00:11:48,190
،لستُ من عائلتك. لا أذكر أنّك أنجبتني

173
00:11:48,190 --> 00:11:49,700
.كما أنّنا لسنا مرتبطين بصلة دمّ

174
00:11:49,700 --> 00:11:52,800
!اخرس! بئس روابط الدّم

175
00:11:52,800 --> 00:11:54,830
!هل روابط الدّم بتلك الأهمّيّة؟

176
00:11:59,810 --> 00:12:02,130
.سنسوّي هذه المسألة اليوم بالتّأكيد

177
00:12:02,610 --> 00:12:03,710
.اغربوا

178
00:12:03,710 --> 00:12:08,290
،أتيت إلى هنا البارحة وما قبل البارحة
!لكنّك لم تردّي لنا الدّين أيّتها الحقيرة

179
00:12:08,290 --> 00:12:09,940
ماذا؟ ومن أنت؟

180
00:12:09,940 --> 00:12:12,980
.أشعر وكأنّني رأيتك في مكان ما من قبل
هل أنت عضو جديد في عائلتهم؟

181
00:12:12,980 --> 00:12:13,810
.نعم

182
00:12:12,980 --> 00:12:13,810
.لا

183
00:12:13,800 --> 00:12:15,400
!نعم أم لا؟

184
00:12:15,400 --> 00:12:16,880
.لا يهمّ

185
