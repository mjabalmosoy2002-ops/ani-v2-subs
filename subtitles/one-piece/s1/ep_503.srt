1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,830 --> 00:03:23,820
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:23,820 --> 00:03:27,150
.اُجتيح لوفي بحزن لا يطاق

39
00:03:28,100 --> 00:03:31,640
...إلاّ أنّ هنالك قصّة لم تُحكَ عن الإخوة

40
00:03:31,640 --> 00:03:36,920
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كانا طفلين

41
00:03:42,560 --> 00:03:46,800
"!اعتن به جيّدًا! رسالة من الأخ"

42
00:03:49,510 --> 00:03:52,030
!إيس لم يمت

43
00:03:52,030 --> 00:03:55,900
.هوّن عليك، أعلم. أعلم كيف تشعر

44
00:03:55,900 --> 00:03:58,550
لكن من الخطير جدًّا أن تذهب إلى غري ترمينال الآن

45
00:03:58,550 --> 00:04:00,770
!بما أنّك مصاب وهناك قوّات في كلّ مكان

46
00:04:00,770 --> 00:04:01,860
!—لكن

47
00:04:01,860 --> 00:04:05,400
...كان حريقًا هائلاً! والاحتمالات

48
00:04:06,030 --> 00:04:11,630
ضئيلة لكنّنا نريد جميعًا أن نعتقد
.أنّ الزّعيمة وإيس ما زالا قيد الحياة

49
00:04:11,630 --> 00:04:14,990
ذهب دوغرا إلى هناك للبحث
.عنهما الآن لذا ثق به وانتظر

50
00:04:16,030 --> 00:04:19,710
.الجميع يواجهون وقتًا صعبًا، وليس أنت فقط يا لوفي

51
00:04:23,800 --> 00:04:25,550
!أصيب قارب الصّيد

52
00:04:25,550 --> 00:04:26,880
كيف حال الطّفل؟

53
00:04:26,880 --> 00:04:29,510
!لقد أغضب التّنّين السّماويّ

54
00:04:30,130 --> 00:04:31,090
!سابو

55
00:04:32,160 --> 00:04:35,140
!سحقًا! السّفينة تحترق

56
00:04:35,140 --> 00:04:36,810
لِمَ أطلقوا عليّ هكذا؟

57
00:04:37,560 --> 00:04:40,430
!أيّها القدّيس جالماك! هناك طفل على السّفينة

58
00:04:45,340 --> 00:04:47,440
...لكن الأهمّ

59
00:04:52,060 --> 00:04:52,910
!سحقًا

60
00:04:53,230 --> 00:04:57,410
!لا يجب على عامّيّ أن يسير في طريق سفينتي

61
00:05:18,350 --> 00:05:21,260
مهلاً! ما الّذي تفعله تلك السّفينة؟

62
00:05:21,260 --> 00:05:23,200
!هذا حفل مهمّ

63
00:05:23,200 --> 00:05:26,650
!لا نريد تعكير مزاج التّنّين السّماويّ

64
00:05:26,650 --> 00:05:29,400
!أزيحوا حطام السّفينة بسرعة

65
00:05:51,760 --> 00:05:53,050
!يا رفاق

66
00:05:53,050 --> 00:05:55,550
...رفاق، ذلكما الاثنان

67
00:05:55,550 --> 00:05:56,720
أين؟

68
00:05:58,130 --> 00:06:00,060
!لقد عادا

69
00:06:20,990 --> 00:06:22,950
!حمدًا لهذا

70
00:06:23,680 --> 00:06:26,250
...إيس... الزّعيمة

71
00:06:26,250 --> 00:06:30,230
!إنّها مصابة بشدّة! أسرعوا وعالجوها

72
00:06:30,860 --> 00:06:32,400
هل أنت بخير؟

73
00:06:34,210 --> 00:06:36,010
!إيس

74
00:06:36,600 --> 00:06:37,660
!لوفي

75
00:06:40,050 --> 00:06:43,140
هل ظننت أنّني متّ؟

76
00:06:43,140 --> 00:06:44,310
...لكن

77
00:06:44,310 --> 00:06:45,440
!لماذا تبكي؟

78
00:06:46,860 --> 00:06:49,470
!لم أمت أيّها الأحمق

79
00:06:49,470 --> 00:06:52,320
.على رسلك، هذا يكفي

80
00:06:52,820 --> 00:06:54,930
.لوفي فرح فحسب

81
00:07:00,860 --> 00:07:03,210
أيمكنني أن أسالك عن ليلة الحريق؟

82
00:07:03,210 --> 00:07:05,530
،بعد أن غادرنا مع لوفي

83
00:07:05,530 --> 00:07:08,510
ماذا حدث لك وللزّعيمة؟

84
00:07:08,920 --> 00:07:11,630
...قاتلنا بلوجام

85
00:07:38,910 --> 00:07:40,700
.وهزمناه بشقّ الأنفس

86
00:07:44,390 --> 00:07:47,210
وحاولنا أن نتبعكم على الفور

87
00:07:48,330 --> 00:07:51,000
.لكنّ النّار وقفت حائلاً بيننا

88
00:07:51,000 --> 00:07:53,170
!سحقًا! لا يوجد مهرب

89
00:07:53,170 --> 00:07:56,010
!لا خيار أمامنا

90
00:07:56,010 --> 00:07:57,050
!انتظر

91
00:07:57,050 --> 00:07:58,090
!ماذا تفعلين؟

92
00:07:58,550 --> 00:08:02,630
لا أملك خيارًا بما أنّني أخبرتهم

93
00:08:02,630 --> 00:08:05,280
...أنّني سأتحمّل مسؤوليّة إحضارك إلى البيت

94
00:08:07,240 --> 00:08:12,190
!اتبعني. لا تنفصل عنّي مهما كان

95
00:08:13,650 --> 00:08:14,610
!دادان

96
00:08:25,120 --> 00:08:28,450
!يا دادان! هل أنت بخير يا دادان؟

97
00:08:28,450 --> 00:08:31,260
تجاوزنا النّار أخيرًا

98
00:08:31,260 --> 00:08:33,540
.لكنّ دادان حرقت بشكل شديد

99
00:08:34,060 --> 00:08:37,990
.تمكنّا من الوصول إلى ضفّة النّهر في الغابة الوسطى

100
00:08:43,780 --> 00:08:47,010
!تماسكي! لا يمكنك أن تموتي

101
00:08:47,010 --> 00:08:48,470
!لصّ

102
00:08:48,470 --> 00:08:50,770
!انتظر! توقّف

103
00:08:51,600 --> 00:08:55,650
ذهبت إلى البلدة لسرقة بعض
الأدوية وأحصل على شيء نأكله

104
00:08:56,570 --> 00:08:59,070
.وحاولت إنقاذ حياة دادان

105
00:09:06,280 --> 00:09:10,080
،لست بحاجة للقلق بشأني
.لذا اذهب فحسب يا إيس

106
00:09:10,480 --> 00:09:14,360
كفى هراءً! يفترض أنّك المسؤولة
!عن إحضاري إلى البيت

107
00:09:15,170 --> 00:09:18,380
!لن أدعك تموتين

108
00:09:18,380 --> 00:09:19,300
!اسمعوا

109
00:09:19,300 --> 00:09:22,840
!قد يكون بعض النّاجين هنا

110
00:09:22,840 --> 00:09:25,090
!لا تدعوا أيّ أحد يهرب! نالوا منهم

111
00:09:25,090 --> 00:09:26,220
!حاضر

112
00:09:29,850 --> 00:09:31,690
.حسنًا، حسنًا، فهمنا

113
00:09:31,690 --> 00:09:34,940
!على أيّ حال، أنا مسرور لأنّكما نجوتما

114
00:09:34,940 --> 00:09:36,810
.آسفة لإقلاقكم

115
00:09:37,860 --> 00:09:41,580
.لا أصدّق ما حدث في غري ترمينال

116
00:09:41,580 --> 00:09:43,570
.أتساءل إن كان سابو قلقًا علينا

117
00:09:43,570 --> 00:09:46,910
!يحيا

118
00:09:46,910 --> 00:09:51,290
.قد يظهر عامّيّ وقح آخر في أيّ لحظة

119
00:09:51,290 --> 00:09:53,710
.راقبا جيّدًا

120
00:09:53,710 --> 00:09:54,500
!حاضر

121
00:10:00,020 --> 00:10:02,350
.أتساءل كيف يبلي سابو

122
00:10:02,350 --> 00:10:07,300
.لكنّي مسرور لأنّ إيس عاد ودادان تتعافى

123
00:10:08,560 --> 00:10:10,770
...إيس، في تلك اللّحظة

124
00:10:11,850 --> 00:10:14,600
!لن أهرب

125
00:10:16,060 --> 00:10:17,440
لِمَ لم تهرب؟

126
00:10:17,980 --> 00:10:21,230
.لا أستطيع سوى أن أتحمّس أحيانًا

127
00:10:21,230 --> 00:10:25,560
،أنا خائف دائمًا أنّه إن هربت
.سأترك شيئًا مهمًّا خلفي

128
00:10:25,950 --> 00:10:26,910
...في تلك اللّحظة

129
00:10:29,520 --> 00:10:32,660
.كان لوفي خلفي

130
00:10:33,670 --> 00:10:36,450
.لا أدري لكن أظنّ لذلك السّبب

131
00:10:39,670 --> 00:10:43,420
،حتّى عندما واجه حشدًا من الأعداء يفوقون طاقته

132
00:10:44,130 --> 00:10:46,590
.لم يهرب روجر أبدًا

133
00:10:46,590 --> 00:10:49,850
.أكان انتحاريًّا؟ الهرب يعدّ استراتيجيّة أيضًا

134
00:10:49,850 --> 00:10:52,000
.هذا صحيح لكنّه لا يفعل ذلك أبدًا

135
00:10:52,000 --> 00:10:55,520
.لأنّه بذلك سيترك من يحبّ خلفه

136
00:10:55,520 --> 00:10:59,190
.إن هرب، سيعرّض طاقمه للخطر

137
00:10:59,640 --> 00:11:03,320
في الواقع، ليس من الصّائب القول
."أنّه "ما كان ليهرب

138
00:11:03,320 --> 00:11:07,950
.بل لن يدع للعدوّ فرصة لمهاجمة طاقمه

139
00:11:07,950 --> 00:11:11,330
.كان يتحوّل إلى شيطان في تلك اللّحظات

140
00:11:11,330 --> 00:11:13,620
دمّر جيش دولةٍ بأكمله ذات مرّة

141
00:11:13,620 --> 00:11:15,960
.لأنّهم تحدّثوا بسوء عن طاقمه

142
00:11:16,720 --> 00:11:19,080
.يصبح عنيفًا عندما يغضب

143
00:11:19,080 --> 00:11:20,740
.كان حادّ المزاج وأنانيًّا

144
00:11:20,740 --> 00:11:26,340
.وكان ساذجًا وصريحًا كالأطفال في نفس الوقت

145
00:11:26,340 --> 00:11:29,680
.ذلك لأنّ حياته المبكّرة كانت كحياة إيس

146
00:11:29,680 --> 00:11:33,810
.كره أن يخسر من يحبّ

147
00:11:37,400 --> 00:11:39,920
،كان طائشًا لكنّه كان ينجو

148
00:11:39,920 --> 00:11:43,070
.وأصبح ملك القراصنة

149
00:11:44,280 --> 00:11:49,530
،مع أنّه كان يملك سمعةً شائنة
.إلاّ أنّ طاقمه وثق به ثقةً عمياء

150
00:11:49,530 --> 00:11:54,740
.حتّى أنا كجنديّ بحريّة لم أستطع سوى احترامه

151
00:11:55,290 --> 00:11:58,210
.ولهذا قرّرت الاعتناء بإيس

152
00:11:58,210 --> 00:12:00,210
!نحن من نعتني به

153
00:12:00,210 --> 00:12:03,090
ماذا؟ أتريدين قول شيء؟

154
00:12:03,090 --> 00:12:04,420
.لا، لا شيء

155
00:12:06,010 --> 00:12:09,510
.ما زالت شعوب العالم تكره روجر

156
00:12:09,510 --> 00:12:11,090
،وبينما يكره إيس والده

157
00:12:11,920 --> 00:12:14,760
."ينطبق عليه مثل "من شابه أباه فما ظلم

158
00:12:14,760 --> 00:12:18,600
...حسنًا! لنرَ أيّكما سيفوز

159
00:12:18,600 --> 00:12:19,810
!دوغرا

160
00:12:21,520 --> 00:12:24,450
كنت تبحث عن إيس ودادان، صحيح؟

161
00:12:24,450 --> 00:12:26,300
!لقد عادا

162
00:12:26,300 --> 00:12:30,860
.حقًّا؟ هذا ممتاز

163
00:12:31,610 --> 00:12:34,450
...مـ-ماذا؟! سابو

164
00:12:35,790 --> 00:12:39,660
!كفّ عن الكذب أيّها الأحمق
!إيّاك حتّى أن تمزح في ذلك

165
00:12:39,660 --> 00:12:40,710
!توقّف يا إيس

166
00:12:40,710 --> 00:12:44,960
!لستُ أكذب أو أمزح! حدث ذلك فجأةً

167
00:12:44,960 --> 00:12:47,460
!بالكاد استطعت تصديق ما رأيت

168
00:12:47,460 --> 00:12:50,590
!ظننت أنّني أحلم

169
00:12:50,590 --> 00:12:54,050
!اخرس! عاد سابو إلى بيت عائلته

170
00:12:54,460 --> 00:12:56,640
!فكيف أمكنه أن يكون في البحر؟

171
00:12:56,640 --> 00:12:58,640
!هذا صحيح! عاد إلى بيته

172
00:12:58,640 --> 00:13:01,840
!يمكن لقاطع طريق مثلي أن يفهم كيف يشعر

173
00:13:01,840 --> 00:13:04,560
!ليس كلّ النّاس يريدون العودة إلى منازلهم

174
00:13:05,480 --> 00:13:10,900
!لو أنّه كان سعيدًا حقًّا، لما قصد البحر

175
00:13:10,900 --> 00:13:16,780
ولَما ذهب إلى البحر لوحده رافعًا
!علمًا أسودًا على سفينته

176
00:13:26,290 --> 00:13:27,840
...سابو

177
00:13:28,630 --> 00:13:32,680
!لم يكن سعيدًا

178
00:13:32,840 --> 00:13:36,010
!كنتُ وحيدًا حتّى وأنا أملك أبوين

179
00:13:36,470 --> 00:13:40,930
!لماذا؟! لِمَ لم نعد إلى هناك لإعادته؟

180
00:13:42,080 --> 00:13:46,270
!أين الشّخص الّذي قتل سابو الآن؟! سأقتله

181
00:13:46,270 --> 00:13:48,900
...تـ-تقتل التّنّين السّماويّ؟! هذا مستحيل

182
00:13:48,900 --> 00:13:50,780
!سأجعله يدفع الثّمن

183
00:13:50,780 --> 00:13:51,900
!انتظر يا إيس

184
00:13:53,450 --> 00:13:55,780
!توقّف أيّها الحقير

185
00:13:55,780 --> 00:13:56,950
...تنحّي

186
00:13:57,200 --> 00:13:58,830
!تنحّي عن طريقي

187
00:13:58,830 --> 00:14:03,210
أنّى لك أن تكون بهذه الثّقة
!مع أنّك لست بتلك القوّة؟

188
00:14:03,210 --> 00:14:06,460
!ماذا يمكنك أن تفعل؟! سيقتلونك فحسب

189
00:14:06,460 --> 00:14:08,860
!ستموت وسينساك النّاس غدًا

190
00:14:08,860 --> 00:14:11,860
!ما أنت سوى صبيّ مغمور

191
00:14:12,630 --> 00:14:17,010
!قُتل سابو من قبل هذه البلاد! هذا العالم

192
00:14:17,010 --> 00:14:19,930
!ماذا يمكنك أن تفعل بشأن ذلك؟

193
00:14:20,990 --> 00:14:23,600
!غيّر والدك العالم بموته

194
00:14:23,600 --> 00:14:26,130
،عندما تصبح رجلاً بتلك الأهمّيّة

195
00:14:26,130 --> 00:14:28,810
!حينها افعل ما يحلو لك

196
00:14:32,400 --> 00:14:34,650
!اربطوا هذا الأحمق

197
00:14:34,650 --> 00:14:35,820
!حـ-حاضر

198
00:14:36,550 --> 00:14:40,450
!سابو

199
00:14:40,450 --> 00:14:41,410
!سحقًا

200
00:14:43,790 --> 00:14:48,360
!اخرس! الرّجال لا يبكون يا لوفي

201
00:15:18,820 --> 00:15:21,660
هل عدت لصوابك يا إيس؟

202
00:15:25,770 --> 00:15:27,120
.فكّ وثاقه

203
00:15:27,120 --> 00:15:27,710
.حاضر

204
00:15:29,720 --> 00:15:31,320
.تمهّل

205
00:15:31,320 --> 00:15:32,340
أين لوفي؟

206
00:15:32,340 --> 00:15:34,960
.كان يبكي طوال اللّيل وهو نائم الآن

207
00:15:36,210 --> 00:15:39,260
!أيّتها الزّعيمة! لن تصدّقي هذا

208
00:15:39,260 --> 00:15:41,970
!وردتنا رسالة من سابو

209
00:15:41,970 --> 00:15:44,930
!لا بدّ أنّه أرسلها قبل ذهابه إلى البحر

210
00:15:46,440 --> 00:15:47,720
!أعطني إيّاها

211
00:15:47,720 --> 00:15:51,520
لن أذهب إلى البلدة! إنّها لنا، أليس كذلك؟

212
00:15:58,060 --> 00:16:02,320
.إيس، لوفي، آمل أنّكما لم تتأذّيا في الحريق"

213
00:16:02,320 --> 00:16:05,200
.أنا قلق بشأنكما لكن أعتقد أنّكما بخير

214
00:16:06,000 --> 00:16:11,460
آسف لقول هذا يا رفاق، لكن عندما
...تصلكما هذه الرّسالة، سأكون قد

215
00:16:12,710 --> 00:16:14,480
.أبحرت بالفعل

216
00:16:15,740 --> 00:16:19,090
.حصل ما حصل وقرّرت أن أبحر قبلكما

217
00:16:25,010 --> 00:16:29,310
.ستكون وجهتي أيّ مكان غير هذا المكان

218
00:16:30,120 --> 00:16:34,940
!سأصبح أقوى وسأصبح قرصانًا

219
00:16:36,230 --> 00:16:38,440
.علينا أن نصبح أكثر قراصنة أحرار على الإطلاق

220
00:16:38,440 --> 00:16:42,200
.ونلتقي نحن الثّلاثة في مكان ما ثانيةً يومًا ما

221
00:16:42,700 --> 00:16:48,180
!مكان في البحر الواسع! يومًا ما بالتّأكيد

222
00:16:50,410 --> 00:16:55,920
بالمناسبة يا إيس، من منّا تظنّ أنّه الأخ الأكبر؟

223
00:16:56,700 --> 00:17:00,150
.أخوان كبيران وأخ صغير

224
00:17:01,280 --> 00:17:04,850
.هذا غريب لكنّ أخوّتنا هي كنزي

225
00:17:10,430 --> 00:17:15,310
...ما زال لوفي طفلاً بكّاءً ولكن

226
00:17:20,820 --> 00:17:24,730
"!إنّه أخونا الصّغير فاعتنِ به جيّدًا

227
00:17:51,940 --> 00:17:55,770
كيف يعتبرون أنفسهم مراقبين
!وهم يحتفلون كلّ يوم؟

228
00:17:57,980 --> 00:18:01,350
...لم يغطّوا قصّة سابو

229
00:18:01,350 --> 00:18:03,570
.سمعت أنّ أبويه لم يقوما بأيّ خطوة

230
00:18:03,990 --> 00:18:05,910
أبواه نبيلان

231
00:18:05,910 --> 00:18:10,670
لكن لا حول لهما ولا قوّة أمام
.حكومة العالم والتّنانين السّماويّين

232
00:18:11,620 --> 00:18:13,290
كيف يبلي لوفي؟

233
00:18:13,290 --> 00:18:16,000
.ما زال لا يأكل كثيرًا

234
00:18:16,000 --> 00:18:18,290
!لكنّه مع ذلك يأكل ضعف ما نأكله نحن

235
00:18:18,290 --> 00:18:21,420
...أراهن أنّ موت سابو أثّر عليه كثيرًا

236
00:18:47,070 --> 00:18:48,740
!إيس! لوفي

237
00:18:49,420 --> 00:18:52,580
!علينا أن نبحر يومًا ما

238
00:18:52,580 --> 00:18:55,710
!لنخرج من هذه البلاد ونعش أحرارًا

239
00:18:57,540 --> 00:18:59,250
،لذا من الآن فصاعدًا

240
00:19:00,360 --> 00:19:01,880
!نحن إخوة

241
00:19:23,780 --> 00:19:25,740
إلى متى ستظلّ مستلقيًا هناك؟

242
00:19:28,860 --> 00:19:33,120
.لقد ذهب كلّ الكنز الّذي كنّا نخبّئه في الغابة

243
00:19:34,360 --> 00:19:39,260
.أخذه النّاجون من طاقم بلوجام أو ربّما وجده العسكر

244
00:19:39,790 --> 00:19:41,790
.لا أدري أين ذهب

245
00:19:42,280 --> 00:19:46,120
.لكنّي ما عدت أهتمّ للكنز

246
00:19:46,120 --> 00:19:51,430
كانت مدّخرات القراصنة الّتي كنت سأشاركها مع سابو

247
00:19:51,430 --> 00:19:54,890
.لكنّ سابو لم يحتجها في النّهاية

248
00:19:54,890 --> 00:19:59,140
.لذا سأنسى أمرها أيضًا

249
00:19:59,140 --> 00:20:02,570
لا فائدة من امتلاك الكنز إن كنت
.لا تستطيع حتّى حمايته

250
00:20:03,200 --> 00:20:05,980
...إ-إيس... أنا

251
00:20:09,030 --> 00:20:11,110
!أريد أن أصير أقوى

252
00:20:12,280 --> 00:20:14,620
...أكثر وأكثر

253
00:20:15,160 --> 00:20:18,580
...أكثر وأكثر وأكثر

254
00:20:18,580 --> 00:20:23,510
...أكثر وأكثر وأكثر وأكثر

255
00:20:23,510 --> 00:20:27,380
...أكثر وأكثر... وأكثر وأكثر

256
00:20:27,380 --> 00:20:29,090
!أريد أن أصبح أقوى أكثر

257
00:20:29,720 --> 00:20:35,310
!حينها سأستطيع حماية أيّ شيء أو أيّ أحد
!ولن أعود بحاجة لفقدان أيّ أحد

258
00:20:37,020 --> 00:20:39,430
!أترجّاك

259
00:20:39,430 --> 00:20:43,770
!إيس، لا تمت أرجوك

260
00:20:43,770 --> 00:20:48,530
!يكفي! اقلق على نفسك أوّلاً

261
00:20:48,530 --> 00:20:50,650
!فأنت أضعف منّي بكثير

262
00:20:51,160 --> 00:20:53,620
!اسمع جيّدًا يا لوفي

263
00:20:54,730 --> 00:20:56,290
!لن أموت أبدًا

264
00:21:01,300 --> 00:21:04,240
.أخبرني سابو أن أعتني بك أيضًا

265
00:21:04,850 --> 00:21:08,050
!أعدك أنّني لن أموت أبدًا

266
00:21:09,100 --> 00:21:13,000
كيف لي أن أترك أخًا بكّاءً مثلك وأرحل؟

267
00:21:15,600 --> 00:21:21,730
.لستُ ذكيًّا لذا لا أعرف ما قتل سابو بالضّبط بعد

268
00:21:22,160 --> 00:21:26,610
.لكن لا بدّ أنّه شيء يناقض الحرّيّة

269
00:21:26,610 --> 00:21:29,900
.مات سابو قبل أن يعرف معنى الحرّيّة

270
00:21:30,520 --> 00:21:33,620
!تبادلنا نفس كأس السّاكي وما زلنا حيّين

271
00:21:37,660 --> 00:21:40,700
.لذا أنصت يا لوفي

272
00:21:40,700 --> 00:21:44,940
.علينا أن نعيش بلا أيّ ندم

273
00:21:59,960 --> 00:22:02,230
...الأولاد من العائلات النّبيلة

274
00:22:02,230 --> 00:22:05,850
.يصبحون نبلاء معترف بهم عندما يدركون الـ18

275
00:22:07,280 --> 00:22:10,610
!لهذا أنا بحاجة لمغادرة هذا المكان قبل إكمال الـ17

276
00:22:13,710 --> 00:22:18,260
...علينا أن نبحر يومًا ما

277
00:22:19,000 --> 00:22:23,190
.ونعيش كما نريد. أكثر حرّيّة من أيّ أحد

278
00:22:26,010 --> 00:22:30,960
.ما يعني أنّني سنكسب الكثير من الأعداء

279
00:22:30,960 --> 00:22:33,230
.وحتّى العجوز سيصبح عدوّنا

280
00:22:33,230 --> 00:22:34,820
.عليك أن تخاطر بكلّ شيء

281
00:22:35,470 --> 00:22:38,230
!لنبحر في سنّ الـ17

282
00:22:38,230 --> 00:22:41,800
!وسنصبح... قراصنة

283
00:23:11,490 --> 00:23:14,090
،لوفي وإيس غارقان في الحزن

284
00:23:14,090 --> 00:23:17,150
لكنّهما يتشبّثان بحلمهما في أن يصبحا قرصانين

285
00:23:17,150 --> 00:23:20,010
.ويمضيان نحو المستقبل ثانيةً

286
00:23:20,010 --> 00:23:22,470
...سيحين يوم مغادرتهما

287
00:23:22,470 --> 00:23:26,480
!لتحقيق الحلم الّذي لم يستطع سابو تحقيقه

288
00:23:26,480 --> 00:23:27,960
:في الحلقة القادمة من وان بيس

289
00:23:27,960 --> 00:23:31,110
"!للوفاء بالوعد! مغادرة كلّ منهما"

290
00:23:31,110 --> 00:23:33,510
!ملك القراصنة، لن يكون إلاّ أنا

291
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة