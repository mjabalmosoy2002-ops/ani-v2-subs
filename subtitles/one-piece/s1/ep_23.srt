1
00:00:02,490 --> 00:00:04,330
...الثّروة والشّهرة والسّلطة

2
00:00:04,630 --> 00:00:06,500
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,500 --> 00:00:08,400
.ملك القراصنة، غولد روجر

4
00:00:08,800 --> 00:00:12,570
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,570 --> 00:00:16,170
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,440 --> 00:00:20,040
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,650 --> 00:00:26,720
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:27,350 --> 00:00:30,290
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,190 --> 00:00:35,790
سنجمع كل أحلامنا

10
00:00:36,790 --> 00:00:42,230
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,630 --> 00:00:48,270
!ون بيس

12
00:00:48,770 --> 00:00:53,610
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,440 --> 00:00:59,050
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,150 --> 00:01:05,120
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,450 --> 00:01:10,990
!فإنّها ليست أسطورة إذًا

16
00:01:12,190 --> 00:01:17,870
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:17,930 --> 00:01:22,770
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,070 --> 00:01:25,670
!وتظاهر أنّها غير موجودة

19
00:01:26,640 --> 00:01:31,510
سنجمع كلّ أحلامنا

20
00:01:32,510 --> 00:01:37,690
ونبحر باحثين عن شيء

21
00:01:38,020 --> 00:01:40,920
،عملة في جيبي

22
00:01:41,020 --> 00:01:44,190
وتريد أن تصبح صديقي؟

23
00:01:44,290 --> 00:01:48,800
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,660 --> 00:01:50,830
!إننا كذلك

25
00:01:59,470 --> 00:02:01,680
.تفضّل يا غين. أطعمه إيّاه

26
00:02:01,680 --> 00:02:02,840
...سانجي-سان

27
00:02:03,310 --> 00:02:04,340
!شكرًا لك

28
00:02:18,420 --> 00:02:20,590
.يا له من مطعم جيّد

29
00:02:21,530 --> 00:02:23,130
.سآخذ هذه السّفينة

30
00:02:25,200 --> 00:02:28,130
...إذًا... هذا ما تريد

31
00:02:28,130 --> 00:02:31,570
!كرات لحم الهلاك

32
00:02:42,010 --> 00:02:43,980
!أنتم مزعجون

33
00:02:50,060 --> 00:02:52,460
!لا تتحدّوني

34
00:02:53,020 --> 00:02:55,490
،عندما آمركم بتحضير الطّعام

35
00:02:55,490 --> 00:02:58,000
!كلّ ما عليكم فعله هو إطاعة الأوامر

36
00:02:58,560 --> 00:03:00,730
!لا تتحدّوني

37
00:03:04,040 --> 00:03:06,540
يوجد هنا ما يكفي لمئة
.وجبة على الأرجح

38
00:03:06,540 --> 00:03:08,770
.خذه إلى سفينتك في الحال

39
00:03:08,770 --> 00:03:10,010
!أيّها المالك زيف

40
00:03:12,280 --> 00:03:15,610
أ... أقلتم زيف؟

41
00:03:18,680 --> 00:03:23,150
!حماية باراتيي"
"!القرصان العظيم زيف ذو السّاق الحمراء

42
00:03:37,300 --> 00:03:39,900
!ما الّذي تفعله؟
!هل فقدت عقلك؟

43
00:03:40,400 --> 00:03:42,870
،إن أعدنا الحياة لأولئك الّذين على السّفينة

44
00:03:42,870 --> 00:03:45,740
!فإنّهم سيستولون على مطعمنا بالكامل

45
00:03:45,740 --> 00:03:49,550
...هذا إن كانوا يملكون الإرادة للقتال

46
00:03:51,150 --> 00:03:54,880
أليس كذلك يا محارب
الغراند لاين المهزوم؟

47
00:03:57,950 --> 00:03:59,860
...أ... أيعقل

48
00:03:59,860 --> 00:04:02,190
...الدّون كريغ محارب مهزوم

49
00:04:02,660 --> 00:04:05,560
إذًا فحتّى المسيطر على
...الأزرق الشّرقيّ لم يستطع

50
00:04:05,560 --> 00:04:09,870
حتّى أسطول القراصنة ذو الخمسين
...سفينة لم يستطع الإبحار فيه

51
00:04:10,370 --> 00:04:11,830
الغراند لاين؟

52
00:04:12,970 --> 00:04:18,440
!لا... لا بدّ أنّك زيف ذو السّاق الحمراء

53
00:04:20,210 --> 00:04:22,480
...أن حيّ إذًا

54
00:04:22,480 --> 00:04:27,050
قرصان لا مثيل له كان طبّاخًا
...قبطان سفينة أيضًا

55
00:04:27,720 --> 00:04:30,290
وماذا إن كنتُ حيًّا؟

56
00:04:30,290 --> 00:04:32,920
.لا علاقة لذلك بك أنت

57
00:04:32,920 --> 00:04:37,060
.أعيش حياتي كطبّاخ الآن كما ترى

58
00:04:40,560 --> 00:04:43,160
يبدو هذا جيّدًا عندما تصفه
...بهذه الطّريقة

59
00:04:43,160 --> 00:04:46,930
،لكن بدل العيش كطبّاخ

60
00:04:46,930 --> 00:04:50,140
.يبدو أنّك لا تستطيع العيش إلاّ كطبّاخ

61
00:04:50,710 --> 00:04:57,650
زيف ذو السّاق الحمراء سيّد الرّكلات
.لم يستعمل يديه أبدًا في معركة

62
00:04:58,180 --> 00:05:02,150
سمعتُ أنّ ساقيه القويّتين
قادرتان على سحق الصّخور

63
00:05:02,150 --> 00:05:05,450
.وترك آثار حتّى على الفولاذ

64
00:05:06,320 --> 00:05:09,660
ولقب السّاق الحمراء يشير لأحذيتك
الّتي كانت مغطّاة دائمًا بالدّماء

65
00:05:09,660 --> 00:05:12,390
.الّتي تطايرت بينما تركل أعداءك

66
00:05:15,400 --> 00:05:20,130
لكن ما عدت تملك تلك
...السّاق العزيزة عليك

67
00:05:21,100 --> 00:05:23,670
...سمعتُ الإشاعة

68
00:05:23,670 --> 00:05:26,970
يا لحظّك السّيّئ الّذي تسبّب
...لك بحادثة في البحر

69
00:05:27,610 --> 00:05:33,710
بالنّسبة لك، لا بدّ أنّ خسارة إحدى ساقيك
.عنت أنّك غير قادر على القتال

70
00:05:34,550 --> 00:05:36,720
وما دخل القتال؟

71
00:05:36,720 --> 00:05:41,720
أستطيع الطّبخ بدون ساق
.ما دمتُ أملك هاتين اليدين

72
00:05:41,720 --> 00:05:45,630
فما الّذي تحاول قوله؟
!قل ما لديك دون مماطلة

73
00:05:47,360 --> 00:05:49,360
.يا زيف ذا السّاق الحمراء

74
00:05:49,360 --> 00:05:54,800
أنت الرّجل الّذي دخل الغراند لاين
...سابقًا وخرج سالمًا معافى

75
00:05:55,470 --> 00:05:58,940
لا بدّ أنّه ثمّة سجلّ للسّنة الكاملة

76
00:05:58,940 --> 00:06:01,610
...الّتي خضت رحلتك فيها

77
00:06:01,610 --> 00:06:03,340
!أعطني إيّاه

78
00:06:04,940 --> 00:06:09,250
مذهل! سبق وزرت الغراند لاين أيّها العمّ؟

79
00:06:09,250 --> 00:06:10,150
...صحيح

80
00:06:11,050 --> 00:06:16,190
.قلتَ سجلّي؟ لديّ واحد بالفعل

81
00:06:16,720 --> 00:06:19,320
.لكن لا أستطيع إعطاءك إيّاه

82
00:06:20,690 --> 00:06:25,760
سجلّ السّفينة هو فخر كلّ أفراد
.الطّاقم الّذين أبحرتُ معهم

83
00:06:25,760 --> 00:06:30,070
.إنّه أهمّ من أن أعطيه لك

84
00:06:30,770 --> 00:06:33,300
.في تلك الحالة، سآخذه منك بالقوّة

85
00:06:34,110 --> 00:06:37,540
.صحيح أنّني فشلت في الغراند لاين

86
00:06:37,540 --> 00:06:41,280
،ورغم ذلك، ما أزال الدّون كريغ
.الرّجل الأقوى

87
00:06:42,080 --> 00:06:45,980
.إنّها مجرّد طريقة بحريّة مظلمة
...لديّ القوّة الكافية لأبحر فيها

88
00:06:45,980 --> 00:06:48,650
!كما لديّ الرّجال والطّموح

89
00:06:50,490 --> 00:06:54,760
الشّيء الوحيد الّذي ندمت عليه
.هو افتقاري للمعلومات

90
00:06:54,760 --> 00:06:57,130
...تنقصني معرفة بعض الأشياء فحسب

91
00:06:58,230 --> 00:07:00,730
.سآخذ سجلّك

92
00:07:00,730 --> 00:07:06,370
وسأشكّل أسطول قراصنة كبيرًا
."ثانية وأضع يديّ على "ون بيس

93
00:07:06,800 --> 00:07:10,070
وحينها، سأقف على قمّة
!عصر القراصنة العظيم هذا

94
00:07:21,650 --> 00:07:23,120
!مهلًا لحظة

95
00:07:23,120 --> 00:07:25,190
!أنا هو من سيصبح ملك القراصنة

96
00:07:26,490 --> 00:07:27,020
!الفتى العامل

97
00:07:28,260 --> 00:07:32,630
!تراجع أيّها الفتى العامل
!أنت لست ندًّا له

98
00:07:32,630 --> 00:07:35,330
.لا أستطيع التّراجع عن ذلك

99
00:07:37,330 --> 00:07:39,800
هل قلتَ شيئًا ما يا ولد؟

100
00:07:40,570 --> 00:07:42,870
...أستطيع تجاهل ما قلتَه

101
00:07:42,870 --> 00:07:46,780
.ليس عليك ذلك
.أخبرتك بالحقيقة فحسب

102
00:07:47,710 --> 00:07:49,740
.هذه ليست لعبة

103
00:07:50,350 --> 00:07:53,720
.بالطّبع لا. سأقهر الغراند لاين

104
00:07:54,520 --> 00:07:56,620
!هذه ليست مزحة أيّها الشّقيّ

105
00:07:56,620 --> 00:07:58,520
،صحيح أنّنا لم نملك المعلومات الكافية

106
00:07:58,520 --> 00:08:01,660
لكنّ أسطولًا بخمسة آلاف رجل
!أُبيد في سبعة أيّام فقط

107
00:08:01,660 --> 00:08:02,720
!إنّه بحر شيطانيّ

108
00:08:02,720 --> 00:08:04,790
من المستحيل لشخص مثلك
!أن يستطيع الإبحار فيه

109
00:08:04,790 --> 00:08:06,990
!سـ-سبعة أيّام؟

110
00:08:06,990 --> 00:08:09,700
أُبيدت سفن قراصنة كريغ
!في سبعة أيّام فقط؟

111
00:08:10,400 --> 00:08:12,030
ما الّذي حدث يا ترى؟

112
00:08:12,730 --> 00:08:16,640
لسوء الحظّ، لا أجد هذا النّوع
.من المزاح مضحكًا

113
00:08:17,340 --> 00:08:19,770
،إن كنتَ لن تتراجع عن كلامك

114
00:08:19,770 --> 00:08:22,040
...فما رأيك أن أسحقك ها هنا

115
00:08:22,640 --> 00:08:24,610
...يمكنك أن تحاول

116
00:08:27,180 --> 00:08:28,620
.لا مانع لي

117
00:08:29,320 --> 00:08:32,950
.سأرسلك إلى حتفك كما ترغب

118
00:08:49,170 --> 00:08:52,210
ستقاتل يا لوفي؟ أتحتاج مساعدة؟

119
00:08:52,210 --> 00:08:54,370
لا-لا بأس أيضًا إن كنتَ
...لن تـ-تحتاج المساعدة

120
00:08:56,810 --> 00:09:00,110
زورو! أوسوبّ! أتيتما أيضًا؟

121
00:09:00,110 --> 00:09:01,780
.لا تقلقا. شاهدا فحسب

122
00:09:01,780 --> 00:09:04,220
،فـ-فعلًا؟ هـ-هذا مؤسف

123
00:09:04,220 --> 00:09:06,490
...لكن ما بيدنا حيلة بعد ما قلتَه

124
00:09:06,490 --> 00:09:09,190
،لـ-لكن إن تطلّب الأمر تدخّلنا
.فسنساعدك

125
00:09:09,190 --> 00:09:10,790
!لـ-لـ-لذلك، حظًّا سـ-سعيدًا

126
00:09:12,660 --> 00:09:14,760
!لماذا فعلتَ ذلك يا زورو؟

127
00:09:14,760 --> 00:09:16,900
!اخرس! الزم الصّمت فحسب

128
00:09:19,900 --> 00:09:22,430
هل هما من طاقمك؟

129
00:09:23,070 --> 00:09:25,440
!ياله من طاقم صغير

130
00:09:25,840 --> 00:09:28,540
!ماذا قلت؟! لديّ عضوان آخران

131
00:09:28,540 --> 00:09:30,410
!أنت! قمتَ بعدّي أيضًا، صحيح؟

132
00:09:36,850 --> 00:09:39,220
.سأتعامل معكم لاحقًا

133
00:09:39,980 --> 00:09:42,920
.سأذهب لإطعام رجالي

134
00:09:45,760 --> 00:09:50,630
بإمكان من لا يرغبون في الموت
.مغادرة المطعم والنّجاة بحياتهم

135
00:09:51,400 --> 00:09:56,000
كلّ ما أسعى إليه هو السّجلّ
.وهذه السّفينة

136
00:09:59,500 --> 00:10:02,640
...لكن إن كنتم تتمنّون الموت بلا فائدة

137
00:10:03,810 --> 00:10:06,740
فسأدفنكم في البحر
.وإن كان ذلك مزعجًا

138
00:10:07,440 --> 00:10:08,810
.أُعذر من أنذر

139
00:10:25,530 --> 00:10:27,830
.أصبح الوضع هادئًا

140
00:10:27,830 --> 00:10:31,500
.ذهب أخي الكبير زورو إلى هناك
.يجب أن نكون بخير

141
00:10:31,500 --> 00:10:34,400
نعم... لكن هل هم بخير بالفعل؟

142
00:10:34,400 --> 00:10:36,210
...بعد التّفكير في الأمر

143
00:10:36,210 --> 00:10:40,080
،أخبرينا يا أختي الكبيرة نامي
هل علينا الدّخول أيضًا؟

144
00:10:44,610 --> 00:10:45,650
!يا أختي الكبيرة؟

145
00:10:45,650 --> 00:10:46,580
!مهلًا، مهلًا

146
00:10:56,560 --> 00:10:58,790
أ-أختي الكبيرة نامي؟

147
00:10:59,800 --> 00:11:02,760
نعم، ماذا؟ هل من خطب؟

148
00:11:17,950 --> 00:11:19,910
.آسف يا سانجي-سان

149
00:11:19,910 --> 00:11:22,750
...لم أتخيّر أبدًا حدوث هذا

150
00:11:22,750 --> 00:11:26,520
هذا ليس شيئًا يجب
.أن تعتذر بسببه أيّها التابع

151
00:11:28,390 --> 00:11:34,630
يتصرّف كلّ طبّاخ في هذا المطعم
.حسبما يعتبرونه صوابًا. هذا كلّ شيء

152
00:11:34,630 --> 00:11:40,900
أيّها المالك! لماذا تتصرّف وكأنّك
!موافق على ما فعله سانجي؟

153
00:11:40,900 --> 00:11:44,840
هذا صحيح! إنّه مسؤول
!عن كلّ ما يحدث

154
00:11:45,510 --> 00:11:48,380
!سوف يتسبّب بإفلاس مطعمك الغالي

155
00:11:48,380 --> 00:11:50,210
!اخرسوا أيّها الأغبياء

156
00:11:51,550 --> 00:11:57,380
هل سبق وجرّبتم شعور أن تكونوا
!على حافّة الموت بسبب الجوع؟

157
00:11:57,880 --> 00:12:03,290
فقدان الماء والطّعام في هذا
...المحيط الواسع

158
00:12:03,290 --> 00:12:08,160
!هل تدركون كم أنّ ذلك مخيف؟
!هل تدركون كم ذلك صعب؟

159
00:12:08,160 --> 00:12:11,660
ماذا؟! ماذا تعني أيّها المالك؟

160
00:12:12,060 --> 00:12:14,370
الفرق بين سانجي وبينكم جميعًا

161
00:12:14,370 --> 00:12:16,770
.هو معرفتكم لذلك الشّعور أم لا

162
00:12:19,340 --> 00:12:21,610
ماذا؟ ماذا يعني؟

163
00:12:21,610 --> 00:12:24,080
ماذا يقصد أن سانجي يعرف؟

164
00:12:27,110 --> 00:12:29,750
،إن كان لديكم وقت للتّذمّر

165
00:12:29,750 --> 00:12:32,580
!غادروا المطعم من الباب الخلفيّ بسرعة

166
00:12:35,350 --> 00:12:37,790
.أنا باقٍ لأقتال

167
00:12:37,790 --> 00:12:41,090
.لن أتحمّل إن ضُربتُ ولم أردّ القتال

168
00:12:41,090 --> 00:12:45,130
!أنا باقٍ أيضًا! هذا هو المطعم حيث أعمل

169
00:12:45,130 --> 00:12:47,500
لا مكان آخر لدينا لنذهب إليه
!على أيّ حال

170
00:12:54,910 --> 00:13:00,040
!ما الّذي تعتقدون أنفسكم فاعلين؟
!رأيتم كم أنّ دون قويّ، صحيح؟

171
00:13:00,040 --> 00:13:00,910
!اسمع يا غين

172
00:13:02,050 --> 00:13:03,650
.دعني أخبرك بشيء ما

173
00:13:03,650 --> 00:13:08,450
إطعام شخص جائع أمر
.تمليه عليّ أخلاقي

174
00:13:08,450 --> 00:13:09,250
...ولكن

175
00:13:14,630 --> 00:13:17,930
من سنتعامل معهم هم
.مجموعة لصوص ببطون ممتلئة

176
00:13:18,830 --> 00:13:23,570
لن أدعك تشتكي حتّى بعد
.أن أهزم رفاقك القراصنة

177
00:13:23,570 --> 00:13:25,440
إن وُجد من يريد الاستيلاء
،على هذا المطعم

178
00:13:25,440 --> 00:13:29,140
!فسأقتله بدون أيّ تردّد وإن كان أنت

179
00:13:29,810 --> 00:13:30,870
أتدرك ذلك؟

180
00:13:34,240 --> 00:13:38,380
سمحتَ له بالعيش والآن قد تقتله؟
...حالتك ميؤوس منها يا سانجي

181
00:13:38,380 --> 00:13:39,820
!اخرس أيّها الطّبّاخ اللّعين

182
00:13:40,280 --> 00:13:42,750
أرأيتما؟ إنّه رائع، صحيح؟

183
00:13:42,750 --> 00:13:44,920
!من يهتمّ لأمره الآن؟

184
00:13:44,920 --> 00:13:47,090
!من الأفضل أن نهرب في الحال

185
00:13:47,090 --> 00:13:51,290
اهدأ! إنّه في حالة ميؤوس منها
!ومصاب، حتّى وإن كان كريغ

186
00:13:53,030 --> 00:13:57,300
غين! قلتَ أنّك لا تدري شيئًا
.عن الغراند لاين

187
00:13:57,300 --> 00:13:59,170
رغم أنّك ذهبت إلى هناك؟

188
00:14:04,570 --> 00:14:07,110
.جهلي لما حدث حقيقة

189
00:14:08,140 --> 00:14:12,210
ما حدث في اليوم السّابع
...بعد دخولنا للغراند لاين

190
00:14:12,210 --> 00:14:15,920
...لا أدري إن كان حلمًا أم حقيقة

191
00:14:16,890 --> 00:14:20,760
ما زلت غير قادر على إدراك
...ما حدث

192
00:14:21,720 --> 00:14:24,160
...ما زلت لا أصدّق

193
00:14:25,960 --> 00:14:28,800
...أنّ أسطولًا من خمسين سفينة

194
00:14:30,570 --> 00:14:33,840
...أُبيد على يد رجل واحد

195
00:14:38,840 --> 00:14:41,110
!ماذا؟

196
00:15:03,730 --> 00:15:05,530
...حدث الأمر فجأة

197
00:15:07,170 --> 00:15:12,810
،بمجرّد أن ظهر هذا الرّجل
.أغرق السّفن الواحدة تلو الأخرى

198
00:15:17,210 --> 00:15:20,710
،لولا أنّ الحظّ حالفنا بتلك العاصفة

199
00:15:20,710 --> 00:15:24,320
لكانت سفينتنا الرّئيسيّة
...قد دُمّرت بالكامل أيضًا

200
00:15:31,860 --> 00:15:35,130
...لا أدري كم سفينة بقيت لنا

201
00:15:35,790 --> 00:15:40,130
كنت غارقًا في حزني لدرجة أنّني
...لم أرد تقبّل أنّ ذلك هو الواقع

202
00:15:40,130 --> 00:15:42,370
...لا أريد تذكّره

203
00:15:43,240 --> 00:15:45,070
...ذلك الرّجل

204
00:15:45,070 --> 00:15:51,310
كانت له عينان حادّتان كعيني الصّقر
.نظراتهما مرعبة حتّى الموت

205
00:15:52,010 --> 00:15:53,040
...ما

206
00:15:54,950 --> 00:15:56,550
!ما الّذي قاله للتّوّ؟

207
00:16:00,590 --> 00:16:02,490
...لا بدّ

208
00:16:03,020 --> 00:16:06,090
...أنّه كان عين الصّقر

209
00:16:06,090 --> 00:16:07,090
ماذا؟

210
00:16:07,760 --> 00:16:13,560
إنّ شعورك أنّ عينيه كانتا كعيني
،الصّقر ليس دليلًا أنّه هو

211
00:16:14,000 --> 00:16:19,670
لكنّ ما فعله هذا الرّجل دليل
...كافٍ على أنّه هو بالفعل

212
00:16:20,400 --> 00:16:22,040
!عين الصّقر

213
00:16:22,040 --> 00:16:24,380
ماذا؟ هل تعرفه يا زورو؟

214
00:16:25,810 --> 00:16:29,350
.نعم... إنّه الرّجل الّذي أبحث عنه

215
00:16:29,980 --> 00:16:33,120
.دخلت غمار البحر لألتقي به

216
00:16:35,290 --> 00:16:39,290
أليس ممكنًا أنّ ذلك الرّجل لديه
ضغينة كبيرة ضدّكم؟

217
00:16:39,290 --> 00:16:41,360
!لن نفعل أيّ شيء له

218
00:16:41,360 --> 00:16:43,790
ربّما أقلقتم راحته وهو يأخذ
...قيلولة أو ما شابه

219
00:16:43,790 --> 00:16:45,560
!لا تكن سخيفًا

220
00:16:45,560 --> 00:16:48,630
من المستحيل أنّه سحق أسطولنا
!بأكمله لذلك السّبب

221
00:16:50,100 --> 00:16:53,600
.لا تتحمّس كثيرًا. إنّه مجرّد مثال

222
00:16:54,440 --> 00:16:59,580
أنا أعطي مثالًا فحسب لما
.هو عليه الحال في الغراند لاين

223
00:16:59,940 --> 00:17:02,250
أيّ نوع من الأماكن هو هذا؟

224
00:17:02,250 --> 00:17:04,910
.على الأرجح أنّه يعني أنّ كلّ شيء وارد

225
00:17:06,050 --> 00:17:09,350
!يا لوفي! دعنا لا نذهب لمكان كهذا

226
00:17:09,350 --> 00:17:10,950
!لوفي

227
00:17:15,060 --> 00:17:17,030
يا لوفي؟

228
00:17:19,030 --> 00:17:20,960
!يبدو هذا محمّسًا

229
00:17:20,960 --> 00:17:23,030
!هكذا يجب أن يكون

230
00:17:23,030 --> 00:17:25,330
"عليك أن تقحم مفهوم "الخطر
!في جمجمتك الثّخينة تلك

231
00:17:25,330 --> 00:17:30,110
لكنّ هدفي الآن أصبح مركّزًا
.بالكامل على الغراند لاين

232
00:17:32,070 --> 00:17:36,440
ذلك الرّجل... بإمكاني لقاء ذلك
...الرّجل إن ذهبتُ إلى هناك

233
00:17:38,550 --> 00:17:40,250
هل أنتم أغبياء أم ماذا؟

234
00:17:41,120 --> 00:17:43,450
.يموت أمثالكم قبل البقيّة

235
00:17:43,890 --> 00:17:47,290
صحيح، لكن لم يكن هنالك داعٍ
."لوصفنا بـ"الأغبياء

236
00:17:48,490 --> 00:17:51,230
،عندما قرّرتُ أن أصبح أقوى سيّاف

237
00:17:51,230 --> 00:17:53,260
.قرّرتُ أيضًا تكريس حياتي لذلك الهدف

238
00:17:53,790 --> 00:17:57,970
بما أنّه كان قراري، فالوحيد الّذي
.بإمكانه وصفي بالغبيّ هو أنا

239
00:18:00,130 --> 00:18:02,470
!نعم! أنا أيضًا، أنا أيضًا

240
00:18:02,470 --> 00:18:05,570
وأنا كذلك! ذلك طبيعيّ
!بصفتي رجل بحر

241
00:18:05,570 --> 00:18:06,940
.هذه كذبة في حالتك أنت

242
00:18:09,440 --> 00:18:11,140
...يا له من هراء

243
00:18:15,650 --> 00:18:17,020
!مهلًا، مهلًا

244
00:18:17,620 --> 00:18:22,190
!هل تدركون الوضع الحاليّ أيّها الأغبياء؟

245
00:18:22,190 --> 00:18:25,960
ثمّة سفينة شراعيّة ضخمة
،راسية أمام المطعم الآن

246
00:18:25,960 --> 00:18:28,900
،وهي للدّون كريغ
!أميرال أسطول قراصنة

247
00:18:28,900 --> 00:18:31,030
،إن كنتم تريدون الهرب من الواقع

248
00:18:31,030 --> 00:18:33,230
فافعلوا ذلك بعد النّجاة
!من هذه الأزمة المميتة

249
00:18:44,510 --> 00:18:47,280
!لقد نجونا

250
00:18:47,280 --> 00:18:49,280
!ممتاز! ما زلنا أحياء

251
00:18:49,280 --> 00:18:50,750
!وكأنّه كان حلمًا

252
00:18:50,750 --> 00:18:53,390
!تحرّرنا من ذلك الكابوس

253
00:18:53,390 --> 00:18:57,820
!عدنا أحياءً من مقبرة القراصنة

254
00:18:59,960 --> 00:19:00,930
...صحيح

255
00:19:01,760 --> 00:19:06,000
ممّا يعني أنّ بإمكاننا الآن
.التّوجّه للغراند لاين ثانية

256
00:19:09,070 --> 00:19:11,740
ماذا؟ ما هذه الوجوه؟

257
00:19:12,470 --> 00:19:14,670
هـ-هل ما زلت تريد الذّهاب إلى هناك؟

258
00:19:21,450 --> 00:19:25,180
لا اعتراضات أخرى، صحيح؟

259
00:19:36,890 --> 00:19:42,030
أوّلًا، لنتخلّى عن هذه السّفينة المحطّمة
!الّتي قد تغرق في أيّة لحظة

260
00:19:42,030 --> 00:19:44,030
.ونستولي على المطعم

261
00:19:44,030 --> 00:19:47,470
.عدوّنا مجرّد مجموعة طبّاخين أشقياء

262
00:19:47,470 --> 00:19:49,910
،حتّى إن استخففتم بخصمكم
...فما زال ذلك أكثر من كافٍ

263
00:20:01,920 --> 00:20:02,890
!هجوم

264
00:20:08,320 --> 00:20:10,790
!ها هم قادمون
!بإمكاننا سماع صراخهم

265
00:20:10,790 --> 00:20:14,930
!سنحمي هذه السّفينة حتّى النّهاية
!هذا مطعمنا

266
00:20:19,800 --> 00:20:22,340
!ابتعدوا عن طريقنا أيّها الطّبّاخون

267
00:20:42,720 --> 00:20:43,590
!ما هذا؟

268
00:20:44,990 --> 00:20:46,600
!ما الّذي حدث؟

269
00:20:47,160 --> 00:20:49,130
!الدّون كريغ

270
00:20:49,530 --> 00:20:53,070
!السّفينة الرّئيسيّة... قُطّعت

271
00:20:53,070 --> 00:20:56,070
!قُطّعت؟! أقلت قُطّعت؟

272
00:20:56,070 --> 00:20:58,710
!مع أنّها سفينة شراعيّة ضخمة؟

273
00:20:58,710 --> 00:21:04,580
!مستحيل أن يكون ذلك صحيحًا

274
00:21:15,560 --> 00:21:16,390
!حاضر

275
00:21:18,830 --> 00:21:22,960
هذا سيّئ! نامي ويوساكو وجوني
!ما زالوا على سفينتنا هناك

276
00:21:23,960 --> 00:21:26,470
!سُحقًا! ربّما يكون الأوان قد فات

277
00:21:35,140 --> 00:21:39,250
!أخي الكبير! أخي الكبير

278
00:21:39,250 --> 00:21:41,780
!يوساكو! جوني

279
00:21:41,780 --> 00:21:43,320
هل أنتما بخير؟

280
00:21:43,320 --> 00:21:45,790
!أين السّفينة؟! لا أراها
!ماذا حدث لنامي؟

281
00:21:45,790 --> 00:21:50,360
.ذلك... أنا آسف يا أخي الكبير
.لقد غادرت

282
00:21:50,990 --> 00:21:53,530
...مع السّلامة! أخبراهم

283
00:21:53,530 --> 00:21:55,600
...أختي الكبيرة نامي

284
00:21:55,600 --> 00:21:57,630
،إن كان القدر يربط بيننا
.فسنلتقي ثانية

285
00:21:58,330 --> 00:22:02,270
!أخذت كلّ الكنز وهربت

286
00:22:02,270 --> 00:22:05,570
!ما-ما الّذي قلته؟

287
00:22:17,950 --> 00:22:19,580
...ذلك الرّجل

288
00:22:32,460 --> 00:22:36,800
!ذ-ذلك الوغد! لقد تبعنا

289
00:22:48,780 --> 00:22:51,920
...أيعقل... أنّه

290
00:22:52,720 --> 00:22:54,750
!المدعوّ عين الصّقر؟

291
00:22:55,790 --> 00:23:10,030
عندما كنت صغيرًا، راودتني رؤية عن خريطة كنز

292
00:23:10,030 --> 00:23:16,970
ولطالما بحثت عن ذلك المكان الإعجازيّ

293
00:23:16,970 --> 00:23:24,150
لكي لا يسبقني أحد آخر إليه

294
00:23:26,680 --> 00:23:38,160
إن كان العالم سيتغيّر

295
00:23:38,160 --> 00:23:45,170
قبل أن أحقّق حلمي

296
00:23:45,170 --> 00:23:52,240
فخذوني إلى الوقت الّذي كنت فيه جاهلًا

297
00:23:52,240 --> 00:24:05,620
لكي لا تمحى ذكرياتي

298
00:24:11,090 --> 00:24:12,390
من يكون؟

299
00:24:12,390 --> 00:24:15,830
الرّجل الّذي أبحث عنه. لم أتوقّع
.أن أتمكّن من لقائه بهذه السّرعة

300
00:24:15,830 --> 00:24:17,060
هل ستقاتله؟

301
00:24:17,060 --> 00:24:19,300
.نعم. لهذا السّبب دخلت غمار البحر

302
00:24:19,300 --> 00:24:20,970
يا زورو، ما الخطب؟

303
00:24:20,970 --> 00:24:22,600
هل أنا بعيد كلّ هذا البعد
من الأقوى في العالم؟

304
00:24:22,600 --> 00:24:25,040
...هذا هو الأقوى في العالم إذًا

305
00:24:25,040 --> 00:24:26,240
!زورو

306
00:24:26,240 --> 00:24:27,610
:في الحلقة القادمة من ون بيس

307
00:24:27,610 --> 00:24:31,150
!عين الصّقر ميهوك"
".السّيّاف الّذي دفع زورو للإبحار

308
00:24:31,150 --> 00:24:33,380
!ملك القراصنة، لن يكون إلاّ أنا