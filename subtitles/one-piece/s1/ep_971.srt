1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,420 --> 00:02:01,110
،في العام الثّاني بعد عودة أودن إلى بلاد وانو

29
00:02:01,110 --> 00:02:06,490
بدأت المعركة بين قراصنة غيكّو
.وقراصنة مملكة الحيوان في رينغو

30
00:02:06,760 --> 00:02:10,030
.تواجه غيكّو موريا وكايدو ضدّ بعضهما

31
00:02:10,030 --> 00:02:11,910
!إلى الجحيم

32
00:02:17,980 --> 00:02:20,380
،وفي نفس الوقت

33
00:02:21,070 --> 00:02:24,590
.تمّ نهب قبر إله السّيف ريوما

34
00:02:25,160 --> 00:02:28,140
...وحتّى تحت ظلّ تلك الأحداث

35
00:02:28,160 --> 00:02:30,740
!فجل، غانمو

36
00:02:32,200 --> 00:02:34,080
!تشيكوا وبيض

37
00:02:36,060 --> 00:02:40,190
!واحد، اثنان، ثلاثة، تفضّلوا بالأكل

38
00:02:40,190 --> 00:02:45,360
ظهر أودن في عاصمة الزّهور مرّة في
.الأسبوع وجعل نفسه يبدو كالأحمق

39
00:02:45,360 --> 00:02:47,010
!أريد الرّقص أيضًا

40
00:02:47,010 --> 00:02:48,030
.إيّاك

41
00:02:48,030 --> 00:02:51,910
!العنصر الضّروريّ للمذاق هو المرق

42
00:02:51,910 --> 00:02:54,660
...ما كان الأودن ليُسمّى أودن

43
00:02:55,810 --> 00:02:59,290
!إن لم يكن يغلي

44
00:02:59,820 --> 00:03:01,860
.إنّه ذلك السّيّد السّخيف

45
00:03:01,860 --> 00:03:04,010
.أشعر بالسّوء حيال ساكنة كوري

46
00:03:04,360 --> 00:03:06,630
سيّد كوري السّخيف؟

47
00:03:07,910 --> 00:03:10,950
.حتّى مناداته بذلك تعتبر مبالغة في المديح

48
00:03:10,950 --> 00:03:16,060
أما زلتم لا تمانعون أن تعملوا كتابعين لي؟

49
00:03:16,080 --> 00:03:18,690
وإلى أين قد نذهب؟

50
00:03:18,690 --> 00:03:22,880
.سبق ورأينا رقصة أودن-ساما العارية منذ زمن بعيد

51
00:03:22,880 --> 00:03:25,750
!صحيح، لا شيء جديد حيالها

52
00:03:29,640 --> 00:03:35,080
!صحيح، صحيح. سأواصل العمل على رقصتي

53
00:03:35,080 --> 00:03:37,640
!رقصتي العارية

54
00:03:40,280 --> 00:03:41,650
...أودن-ساما

55
00:03:41,650 --> 00:03:44,170
!كونبو، مهمّ

56
00:03:44,400 --> 00:03:46,590
.هوت عشيرة كوزكي للحضيض

57
00:03:46,590 --> 00:03:50,090
.سمعتُ أنّ ابنه ووريثه مومونوسكي-ساما مغفّل أيضًا

58
00:03:50,090 --> 00:03:54,140
!العنصر الضّروريّ للمذاق هو المرق

59
00:03:54,140 --> 00:03:56,660
...ما كان الأودن ليُسمّى أودن

60
00:03:57,880 --> 00:04:01,540
!إن لم يكن يغلي

61
00:04:01,540 --> 00:04:04,440
!سترقص العشيرة بأكملها عارية قريبًا

62
00:04:09,600 --> 00:04:14,180
"!غارة! أودن والأكازايا التّسعة"

63
00:04:17,940 --> 00:04:20,080
!مهلاً، مهلاً يا هيوري

64
00:04:20,080 --> 00:04:21,000
!كلاّ

65
00:04:21,140 --> 00:04:22,830
!قلت لك انتظري

66
00:04:23,480 --> 00:04:27,740
...جعلت عائلتي هدفًا للسّخرية في النّهاية

67
00:04:27,740 --> 00:04:29,550
!والدي

68
00:04:30,780 --> 00:04:32,800
ألن تتدرّب اليوم؟

69
00:04:33,580 --> 00:04:36,450
!أنا أحبّ رقصتك

70
00:04:36,450 --> 00:04:38,100
!وأنا أيضًا

71
00:04:41,630 --> 00:04:42,750
...توكي

72
00:04:42,750 --> 00:04:43,860
نعم؟

73
00:04:44,960 --> 00:04:46,520
أتريدين تركي؟

74
00:04:46,760 --> 00:04:49,490
هل تمزح؟ أتحاول إغضابي؟

75
00:04:50,930 --> 00:04:52,660
.سيّد كوري السّخيف

76
00:04:52,660 --> 00:04:56,660
،هذا ما وصفته به بلاد وانو بأكملها

77
00:04:56,660 --> 00:05:01,080
.ولم يحدّثه إلاّ عائلته وأتباعه وقلّة من الدّاعمين فقط

78
00:05:02,860 --> 00:05:05,440
!تريد مقابلة الزّعيم هيوغورو؟

79
00:05:05,440 --> 00:05:09,030
!مهلاً، مهلاً! ابق بعيدًا عنه أيّها السّيّد السّخيف

80
00:05:09,030 --> 00:05:10,400
!كفاكما

81
00:05:10,720 --> 00:05:12,580
!هذا مؤلم

82
00:05:12,580 --> 00:05:15,450
!لا تغترّا بنفسيكما! تراجعا

83
00:05:15,450 --> 00:05:16,340
!سيّدتي

84
00:05:16,400 --> 00:05:17,470
!حالاً

85
00:05:17,470 --> 00:05:18,770
!أهلاً يا سيّدتي

86
00:05:18,770 --> 00:05:23,540
!آسفة. تفضّل واحتس بعض الشّاي

87
00:05:23,540 --> 00:05:26,400
!هيو-سان! أودن-تشان هنا

88
00:05:28,340 --> 00:05:34,110
!يأبى أوروتشي تركي وشأني
من قد يرغب بخدمة رجل مثله؟

89
00:05:35,930 --> 00:05:38,940
.لا تعرّض نفسك للخطر يا هيو-سان

90
00:05:38,940 --> 00:05:40,950
.رأيتك ذلك اليوم

91
00:05:40,950 --> 00:05:44,230
.تحسّن رقصك يا أودن-تشان

92
00:05:44,230 --> 00:05:46,130
!كفاك يا سيّدتي

93
00:05:49,360 --> 00:05:51,840
!ناولني كوبك، إليك المزيد

94
00:05:52,130 --> 00:05:54,620
.مرّت ثلاث سنوات

95
00:05:54,620 --> 00:05:57,360
!فجل، غانمو

96
00:05:58,660 --> 00:06:00,500
!تشيكوا وبيض

97
00:06:00,500 --> 00:06:02,710
.انظر. ها هو ذا هذا الأسبوع أيضًا

98
00:06:02,710 --> 00:06:06,730
حتّى في هذه الثّلوج؟
.إنّه سيّد سخيف ميؤوس منه

99
00:06:06,730 --> 00:06:09,170
...ما كان الأودن ليُسمّى أودن

100
00:06:08,380 --> 00:06:10,840
!إنّه أودن! يا لك من غبيّ

101
00:06:10,820 --> 00:06:13,670
.إنّه غبيّ كما العادة

102
00:06:10,840 --> 00:06:13,670
!إن لم يكن يغلي

103
00:06:13,670 --> 00:06:15,910
!إنّكم لا تعلمون أيّ شيء أيّها الحمقى

104
00:06:16,180 --> 00:06:20,910
.أعرف أنّ لأودن-ساما سبب وجيه

105
00:06:20,910 --> 00:06:23,470
...لهذا السّبب هو

106
00:06:25,190 --> 00:06:29,630
.صحيح، تُمسي تلك الرّقصة أفضل وأفضل

107
00:06:29,630 --> 00:06:32,510
.لنشاهده مهما طال الأمر

108
00:06:34,240 --> 00:06:36,180
...الثّلج يزعجني

109
00:06:41,010 --> 00:06:42,110
!عار عليك

110
00:06:42,280 --> 00:06:43,500
!إنّه مقرف

111
00:06:43,500 --> 00:06:44,850
.كم هو مزعج

112
00:06:44,880 --> 00:06:45,480
!غادر

113
00:06:46,000 --> 00:06:51,620
،مرّت أربع سنوات في لمح البصر
.لكن لم يتغيّر شيء في بلاد وانو

114
00:06:52,260 --> 00:06:56,550
.وفي السّنة الخامسة، بادر أوروتشي بالتّحرّك

115
00:07:02,120 --> 00:07:05,390
!إنّه الشّوغن! الشّوغن أوروتشي

116
00:07:41,600 --> 00:07:43,870
!كنت أتوقّع حضورك

117
00:07:43,870 --> 00:07:45,470
!أيّها الشّوغن

118
00:07:46,810 --> 00:07:49,790
.مرّ وقت طويل يا أودن

119
00:07:50,080 --> 00:07:54,420
مرّت خمس سنوات بالضّبط على ذلك
...اليوم. حان الوقت للوفاء بالوعد

120
00:07:54,820 --> 00:07:56,300
الوعد؟

121
00:07:57,820 --> 00:07:59,010
.لا أذكر

122
00:08:00,240 --> 00:08:05,810
كيف جعلت من كوري الجامحة تلك بلدة جميلة هكذا؟

123
00:08:05,810 --> 00:08:07,140
!أثرت إعجابي

124
00:08:09,140 --> 00:08:14,480
.أريد بناء العديد من مصانع الأسلحة هنا

125
00:08:15,630 --> 00:08:17,000
مفهوم؟

126
00:08:17,470 --> 00:08:20,860
.أحتاج لتعاونك يا أودن

127
00:08:20,860 --> 00:08:24,080
لكن أيّها الشّوغن، ماذا عن السّفينة؟

128
00:08:24,080 --> 00:08:26,870
...وعدتني أنت وكايدو أن

129
00:08:32,900 --> 00:08:34,540
!عمّ تتحدّث؟

130
00:08:38,950 --> 00:08:45,300
،إن أمسكت بجميع من هنا وأجبرتهم على العمل ليل نهار

131
00:08:48,560 --> 00:08:49,700
!صحيح؟

132
00:08:51,920 --> 00:08:53,520
...إنّ بلاد وانو

133
00:08:54,510 --> 00:08:58,150
!ستصبح مركزًا لصناعة الأسلحة

134
00:09:02,060 --> 00:09:05,300
!ا-انتظر رجاءً

135
00:09:05,910 --> 00:09:08,450
...صحيح، بالمناسبة

136
00:09:08,450 --> 00:09:13,000
،كان التّعامل مع هيوغورو صعبًا

137
00:09:13,000 --> 00:09:14,960
.لذلك تركته عهدة لكايدو

138
00:09:17,420 --> 00:09:22,730
أردت أن أجعل حاكم عالم جريمة بلاد
.وانو حليفًا لي، لكنّي أستسلم الآن

139
00:09:22,990 --> 00:09:25,850
.ولكن، ربّما يكون قد قُتل أيضًا

140
00:09:27,220 --> 00:09:30,020
.قاوم أتباعه مقاومة مزعجة بالفعل

141
00:09:30,020 --> 00:09:32,140
!أعد لنا زعيمنا

142
00:09:34,270 --> 00:09:36,730
.لذلك تسبّب الأمر لنا بمتاعب أكثر من المتوقّع

143
00:09:36,730 --> 00:09:38,620
...صحيح، صحيح

144
00:09:40,720 --> 00:09:44,660
بالحديث عن ذلك، أتذكر
زوجة هيوغورو العجوز تلك؟

145
00:09:44,660 --> 00:09:48,580
!سمعتُ أنّها صرخت وألقت بنفسها عليهم أيضًا

146
00:09:48,580 --> 00:09:50,410
!وقد أردوها قتيلة

147
00:09:51,100 --> 00:09:53,370
!كلاّ

148
00:09:53,370 --> 00:09:57,520
!توقّف! لا تأخذوه

149
00:10:00,030 --> 00:10:03,020
...هيو-سان

150
00:10:08,250 --> 00:10:12,140
،بصفتها زوجة ياكوزا
!ما كان عليها التّصرّف بخزي

151
00:10:14,960 --> 00:10:17,830
...بالمناسبة، طفلاك

152
00:10:17,830 --> 00:10:22,490
مومونوسكي وهيوري. كم عمرهما الآن؟

153
00:10:22,490 --> 00:10:25,030
الأطفال ظرفاء، صحيح؟

154
00:10:25,030 --> 00:10:28,700
.أعتقد أنّهما ظريفان جدًّا الآن

155
00:10:29,310 --> 00:10:31,330
.اهتمّ بهما جيّدًا

156
00:10:34,610 --> 00:10:38,040
!سأترك بناء المصانع لك

157
00:10:50,000 --> 00:10:51,410
...إيّاك

158
00:10:52,000 --> 00:10:56,870
!إيّاك

159
00:10:56,870 --> 00:10:58,690
.أودن-تشان

160
00:10:59,050 --> 00:11:01,720
.لا بدّ أنّ الجوّ كان باردًا على الرّقص اليوم

161
00:11:01,720 --> 00:11:03,230
!عملت بجدّ بالفعل

162
00:11:03,530 --> 00:11:07,180
.يا سيّدتي، لا يؤثّر البردّ فيّ إطلاقًا

163
00:11:07,180 --> 00:11:09,570
.سمعتُ أنّ هنالك من رمى حجرًا عليك

164
00:11:11,270 --> 00:11:12,890
!حدث ذلك اليوم أيضًا

165
00:11:12,890 --> 00:11:15,230
!إنّك تبلي بلاء حسنًا

166
00:11:15,230 --> 00:11:17,940
.إنّنا نرحّب بزيارتك لنا في أيّ وقت

167
00:11:17,940 --> 00:11:21,460
.إنّنا إلى جانبك دائمًا

168
00:11:21,960 --> 00:11:25,920
!والدي

169
00:11:26,170 --> 00:11:29,160
!أريد أن أكون مثلك

170
00:11:29,160 --> 00:11:32,600
!فعلاً؟ كُل كثيرًا إذًا

171
00:11:32,600 --> 00:11:35,070
!أريد أن أرقص مثلك

172
00:11:40,050 --> 00:11:43,110
.ماذا؟ جميعكم هنا

173
00:11:43,110 --> 00:11:45,390
!والدي

174
00:11:45,390 --> 00:11:46,600
!أودن

175
00:11:46,740 --> 00:11:47,780
!أودن-تشان

176
00:11:56,440 --> 00:11:58,210
...مهلاً، توقّفوا

177
00:12:01,580 --> 00:12:05,760
!كلاّ! توقّفوا

178
00:12:31,560 --> 00:12:34,700
،كما توقّعت عائلته وأتباعه

179
00:12:34,700 --> 00:12:42,170
كان هذا السّاموراي العظيم يحمل عبئًا
.على عاتقه وحده طوال خمس سنوات

180
00:13:12,140 --> 00:13:14,130
...يا أوروتشي

181
00:13:14,850 --> 00:13:16,780
...وأنت يا كايدو

182
00:13:16,780 --> 00:13:17,950
!سننال منكما

183
00:13:24,150 --> 00:13:29,340
!كنّا ننتظر أن تقول هذه الكلمات طوال هذا الوقت

184
00:13:32,580 --> 00:13:34,720
!سنذهب إلى جزيرته

185
00:13:35,790 --> 00:13:40,930
!سأقطع رأسه بينما ينام بعد الشّرب

186
00:13:43,880 --> 00:13:46,110
...ما الّذي توشكون على رؤيته الآن

187
00:13:49,190 --> 00:13:55,450
هو اهتياج عُمر كوزكي أودن بأكمله
.الّذي بكت عليه بلاد وانو بأسرها

188
00:13:56,060 --> 00:14:01,010
.تسعة رجال ضمّهم إليه ليصبحوا ساموراي

189
00:14:01,010 --> 00:14:02,660
.كان الوقت شفقًا

190
00:14:03,360 --> 00:14:10,130
ولوّنت الشّمس الحمراء السّاطعة الرّجال الّذين
،ساروا بشجاعة نحو معركة بلون أحمر محترق

191
00:14:10,130 --> 00:14:14,880
حتّى السّيوف الّتي يحملونها
.على خواصرهم أظهرت أرواحًا حمراء

192
00:14:16,580 --> 00:14:20,470
،كرّم النّاس ولاءهم الشّديد لاحقًا

193
00:14:20,470 --> 00:14:24,310
.ووصفوهم بالأغماد الحُمر، الأكازايا التّسعة

194
00:14:24,310 --> 00:14:26,250
!أنا أقفز أعلى منك

195
00:14:26,250 --> 00:14:29,270
!لا، أنا من تقفز أعلى منك

196
00:14:34,140 --> 00:14:37,570
.كان عدوّهم كايدو
،ودون أن يضعوا أنظارهم على غيره

197
00:14:37,570 --> 00:14:40,410
.واصلوا مسيرتهم، شيء من الماضي للأسف

198
00:14:41,140 --> 00:14:44,910
.ما ينتظرهم هو الإعدام العلنيّ لكوزكي أودن

199
00:14:53,490 --> 00:14:56,970
وحتّى السّاعة الأسطوريّة
،الّتي سيتغنّى بها الأجيال

200
00:14:57,540 --> 00:15:02,490
!نناشدكم أن تشاهدوا دون أن يغمض لكم جفن

201
00:15:17,640 --> 00:15:19,780
!ماذا؟! من أودن؟

202
00:15:21,640 --> 00:15:24,500
!أحضروا حصاني، أنا ذاهب إلى كوري

203
00:15:45,180 --> 00:15:46,710
!ما هذا يا أخي؟

204
00:15:46,710 --> 00:15:49,200
!توقّفي! ذلك الكتاب مهمّ لي

205
00:16:46,730 --> 00:16:49,290
!مستحيل! ما معنى هذا؟

206
00:16:58,460 --> 00:17:00,590
!لم أتوقّع هذا

207
00:17:00,990 --> 00:17:03,050
!أتباع كايدو

208
00:17:03,050 --> 00:17:05,350
!هل هم جميعًا...؟

209
00:17:05,350 --> 00:17:08,200
!ثمّة المئات منهم هنا

210
00:17:34,190 --> 00:17:37,400
!مستحيل! لماذا هو هنا؟

211
00:17:37,740 --> 00:17:38,840
!كايدو

212
00:17:43,660 --> 00:17:46,550
.لم أكن أتوقّع حربًا

213
00:17:46,790 --> 00:17:51,680
!لماذا هم على أهبة الاستعداد؟
!كيف عرفوا أنّنا قادمون؟

214
00:17:54,710 --> 00:17:59,170
.ربّما هنالك جاسوس في قلعتك

215
00:18:02,100 --> 00:18:07,870
لا أريد تحويل قصري المبنيّ
...حديثًا إلى ساحة معركة

216
00:18:07,870 --> 00:18:10,370
.لذلك أتيتُ إليك بنفسي

217
00:18:11,150 --> 00:18:13,330
،في ذلك اليوم قبل خمس سنوات

218
00:18:13,330 --> 00:18:16,290
...قطعنا وعدًا أنا وأنتما

219
00:18:17,650 --> 00:18:22,800
!أكان كلّ ذلك كذبة يا كايدو؟

220
00:18:22,800 --> 00:18:27,950
.صحيح... كان كذبة بالكامل

221
00:18:27,950 --> 00:18:32,080
.حينها، ظننّا أننا لا نملك الأفضليّة

222
00:18:32,330 --> 00:18:35,770
،كنت قد عدت لتوّك وإن اتّحدت مع هيوغورو

223
00:18:35,770 --> 00:18:40,360
.لصار كلّ السّاموراي والياكوزا في بلاد وانو أعداءً لنا

224
00:18:41,130 --> 00:18:45,200
...لم يكن لدينا الكثير من الأتباع حينها

225
00:18:45,200 --> 00:18:52,200
إن كنتَ رجلاً مجنونًا لا يأبه بخسارة
،الأرواح كما سمعت عنك

226
00:18:54,230 --> 00:18:57,460
.لكانت معركة صعبة لنا

227
00:18:57,460 --> 00:19:04,380
لكنّك صدّقت كلمات أوروتشي
.واخترت الطّريقة الّتي لن يتأذّى بها أحد

228
00:19:04,380 --> 00:19:09,390
كان نيوغيت وروجر قراصنة
.من تلك الطّينة أيضًا

229
00:19:10,120 --> 00:19:14,060
.إنّهما قويّان، لكن ساذجان أيضًا

230
00:19:14,060 --> 00:19:16,350
!وأنت لا تختلف عنهما

231
00:19:16,350 --> 00:19:18,850
!مجرّد أحمق واصل الرّقص

232
00:19:18,850 --> 00:19:23,250
!عارٍ ومحلّ سخرية وازدراء

233
00:19:25,300 --> 00:19:30,660
!ما عدت تملك كرامة كوزكي القديمة

234
00:19:38,900 --> 00:19:41,750
.قمتُ بالخيار الصّائب ذلك اليوم

235
00:19:42,400 --> 00:19:45,630
.لنتحدّث عن المستقبل الآن

236
00:20:31,290 --> 00:20:33,600
!اتبعوا أودن-ساما

237
00:21:49,570 --> 00:21:52,170
!مهلاً، مهلاً! أهذه هي قوّة السّاموراي؟

238
00:21:52,170 --> 00:21:55,590
!لا تتردّدوا! قوّتنا في تعدادنا

239
00:21:57,250 --> 00:21:59,100
!تقدّموا، تقدّموا

240
00:21:59,330 --> 00:22:01,640
!اتبعوا أودن-ساما

241
00:22:15,930 --> 00:22:17,930
!أخي، لنلعب

242
00:22:17,930 --> 00:22:19,510
!توقّفي يا هيوري

243
00:22:19,510 --> 00:22:20,580
!لنلعب

244
00:22:20,580 --> 00:22:24,040
.وصلني مبعوث من أودن يحمل رسالة

245
00:22:24,370 --> 00:22:27,880
.جاء فيها، "زوجتي وطفلاي سيُستهدفون
."أنقذهم رجاءً

246
00:22:27,880 --> 00:22:29,750
!الرّكلة الهاوية

247
00:22:34,280 --> 00:22:36,220
!كيف تجرئين؟

248
00:22:36,220 --> 00:22:37,220
!انتظري

249
00:22:37,220 --> 00:22:42,220
مومونوسكي... أقصد مومونوسكي-ساما
...في الثّامنة سلفًا

250
00:22:42,960 --> 00:22:45,810
.أوتوكي-سان، عليك أن تكوني جاهزة

251
00:22:47,630 --> 00:22:51,650
...إن خسر أودن

252
00:22:52,970 --> 00:22:55,610
.فتنتهي هذه البلاد

253
00:23:04,480 --> 00:23:08,630
!حوّل هجوم كايدو بلاد وانو إلى ساحة معركة

254
00:23:08,630 --> 00:23:10,920
،وبينما يحترقون بلهيب الأمل الّذي كادوا يفقدونه

255
00:23:10,920 --> 00:23:14,310
!يشقّ أودن والأكازايا طريقهم إلى المستقبل

256
00:23:14,310 --> 00:23:17,180
،وواضعًا المعاناة الّتي تكبّدها على سيفه

257
00:23:17,180 --> 00:23:19,410
!يقاتل أودن مصدر الشّرّ مباشرة

258
00:23:19,410 --> 00:23:21,950
!كلّ هذا لاستعادة بلاد وانو

259
00:23:22,330 --> 00:23:23,850
:في الحلقة القادمة من وان بيس

260
00:23:23,880 --> 00:23:26,690
"!نهاية المعركة! أودن ضدّ كايدو"

261
00:23:26,690 --> 00:23:29,330
!ملك القراصنة، لن يكون إلاّ أنا