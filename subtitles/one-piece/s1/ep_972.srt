1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:59,880 --> 00:02:01,880
...يا أوروتشي

29
00:02:02,590 --> 00:02:04,530
...وأنت يا كايدو

30
00:02:04,530 --> 00:02:05,700
!سننال منكما

31
00:02:06,350 --> 00:02:11,290
!كنّا ننتظر أن تقول هذه الكلمات طوال هذا الوقت

32
00:02:15,150 --> 00:02:17,330
،في ذلك اليوم قبل خمس سنوات

33
00:02:17,330 --> 00:02:20,300
...قطعنا وعدًا أنا وأنتما

34
00:02:21,650 --> 00:02:26,680
!أكان كلّ ذلك كذبة يا كايدو؟

35
00:02:27,050 --> 00:02:31,970
.صحيح... كان كذبة بالكامل

36
00:02:31,970 --> 00:02:36,100
...لم يكن لدينا الكثير من الأتباع حينها

37
00:02:36,100 --> 00:02:43,030
إن كنتَ رجلاً مجنونًا لا يأبه بخسارة
،الأرواح كما سمعت عنك

38
00:02:45,100 --> 00:02:48,280
.لكانت معركة صعبة لنا

39
00:02:48,280 --> 00:02:55,210
لكنّك صدّقت كلمات أوروتشي
.واخترت الطّريقة الّتي لن يتأذّى بها أحد

40
00:03:03,660 --> 00:03:06,550
.قمتُ بالخيار الصّائب ذلك اليوم

41
00:03:07,200 --> 00:03:10,430
.لنتحدّث عن المستقبل الآن

42
00:03:12,040 --> 00:03:16,480
"!نهاية المعركة! أودن ضدّ كايدو"

43
00:03:33,100 --> 00:03:35,810
!مهلاً، مهلاً! أهذه هي قوّة السّاموراي؟

44
00:03:35,810 --> 00:03:39,120
!لا تتردّدوا! قوّتنا في تعدادنا

45
00:03:40,780 --> 00:03:42,630
!تقدّموا، تقدّموا

46
00:03:42,940 --> 00:03:45,170
!اتبعوا أودن-ساما

47
00:03:58,630 --> 00:03:59,690
!أنت في عداد الموتى

48
00:04:03,210 --> 00:04:04,270
!ماذا حدث؟

49
00:04:05,760 --> 00:04:06,610
من أنت؟

50
00:04:07,640 --> 00:04:10,410
.أنا هنا لتقديم يد العون لكم

51
00:04:10,410 --> 00:04:13,620
،أودن-ساما، واثقة أنّك لا تتذكّرني

52
00:04:13,950 --> 00:04:16,950
...لكن عندما كان سوكياكي-ساما لا يزال حيًّا

53
00:04:18,100 --> 00:04:20,120
!شينوبو من فيلق النّينجا؟

54
00:04:21,730 --> 00:04:24,290
!نعم! تلك أنا

55
00:04:24,290 --> 00:04:28,210
لماذا أنت هنا وحدك؟ ماذا حلّ بالبقيّة؟

56
00:04:29,570 --> 00:04:31,510
...فيلق نينجا كوزكي

57
00:04:31,830 --> 00:04:35,760
.خاننا فوكوروجوكو لصالح أوروتشي

58
00:04:36,210 --> 00:04:40,600
لا لوم على من لم يستطيعوا
.وضع ثقتهم في سيّدهم السّخيف

59
00:04:43,300 --> 00:04:47,070
.لطالما أردت أن أخدمك

60
00:04:47,070 --> 00:04:49,300
!ما زلتُ نينجا كوزكي

61
00:04:49,300 --> 00:04:51,900
!تتقدّمنا رحلة وعرة الدّروب يا شينوبو

62
00:04:51,900 --> 00:04:55,780
!نعم، أدرك ذلك! سأرافقكم حتّى النّهاية

63
00:04:55,780 --> 00:04:58,160
!هيّا بنا يا رفاق

64
00:04:59,350 --> 00:05:00,540
!خذوا هذه

65
00:05:07,860 --> 00:05:09,170
!كيف تجرئين؟

66
00:05:09,630 --> 00:05:11,660
!يا هيوري! مهلاً

67
00:05:11,660 --> 00:05:13,180
!مستحيل

68
00:05:13,180 --> 00:05:16,640
.وصلني مبعوث من أودن يحمل رسالة

69
00:05:16,640 --> 00:05:20,480
.جاء فيها، "زوجتي وطفلاي سيُستهدفون
."أنقذهم رجاءً

70
00:05:20,830 --> 00:05:25,480
مومونوسكي... أقصد مومونوسكي-ساما
...في الثّامنة سلفًا

71
00:05:26,210 --> 00:05:29,070
.أوتوكي-سان، عليك أن تكوني جاهزة

72
00:05:30,130 --> 00:05:34,090
...إن خسر أودن

73
00:05:34,970 --> 00:05:37,280
.فستنتهي هذه البلاد

74
00:05:38,690 --> 00:05:40,640
!أودن-سان

75
00:05:46,790 --> 00:05:49,460
.هذه الوحدة الأولى. تمّت الإطاحة بنا

76
00:05:51,490 --> 00:05:55,720
!كان كوزكي أودن أقوى بكثير ممّا توقّعنا

77
00:05:56,040 --> 00:05:58,970
!تبًّا! مثير للشّفقة

78
00:05:58,970 --> 00:06:03,310
!لماذا يتطلّب القضاء على أحد عشر ساموراي كلّ هذا الوقت؟

79
00:06:03,310 --> 00:06:05,600
.لدينا ألف رجل

80
00:06:05,600 --> 00:06:07,440
.لا أطيق المشاهدة

81
00:06:11,510 --> 00:06:13,490
!سأذهب

82
00:06:27,070 --> 00:06:28,170
!ماذا؟

83
00:06:31,610 --> 00:06:33,590
!ما الّذي يوشك أن يحدث؟

84
00:06:36,700 --> 00:06:39,220
!نَفس الانفجار

85
00:07:11,440 --> 00:07:14,550
!لماذا لا تستسلم؟

86
00:07:20,760 --> 00:07:26,980
أتظنّ أنّ أحد عشر منكم قادرون
على الإطاحة بهذا العدد من الرّجال؟

87
00:07:40,160 --> 00:07:42,780
،إن كنت تريد قتالي

88
00:07:42,780 --> 00:07:45,120
!اصعد إليّ

89
00:07:45,120 --> 00:07:47,210
!حسنًا، ها أنا قادم

90
00:07:49,730 --> 00:07:51,420
!هجوم

91
00:07:57,120 --> 00:07:59,090
!اقطعوا رأس أودن

92
00:07:59,090 --> 00:08:01,620
!لنؤخّر الأتباع

93
00:08:01,620 --> 00:08:02,850
!أجل

94
00:08:03,190 --> 00:08:05,100
!لن أسمح لكم

95
00:08:07,420 --> 00:08:10,230
!سأقاتلكم

96
00:08:10,460 --> 00:08:12,060
!لا مانع لديّ

97
00:08:12,300 --> 00:08:13,230
!كين-سان

98
00:08:19,510 --> 00:08:21,360
!نينبو: شوريكن الزّهور

99
00:08:50,500 --> 00:08:52,560
!كايدو

100
00:08:54,920 --> 00:08:57,440
...كلّ ما أرغبه

101
00:08:58,180 --> 00:09:00,110
!هو قطع راسك

102
00:09:00,550 --> 00:09:03,240
!رجم مضحك

103
00:09:03,680 --> 00:09:05,740
!شلاّل الفردوس

104
00:09:47,770 --> 00:09:48,950
!أودن-ساما

105
00:10:11,580 --> 00:10:13,600
!كوزكي أودن

106
00:10:16,210 --> 00:10:20,610
!كنت أنتظر رجلاً مثلك

107
00:10:23,070 --> 00:10:28,870
!لن أسمح لك بحكم بلاد وانو على هواك بعد الآن

108
00:10:31,100 --> 00:10:33,250
.مثير للاهتمام

109
00:10:54,390 --> 00:10:56,690
!أسلوب أودن ذو السّيفين

110
00:10:58,670 --> 00:11:00,230
!فردوس توتسوكا

111
00:11:07,260 --> 00:11:08,780
!أودن-ساما

112
00:11:10,390 --> 00:11:14,750
!لا يمكنني أن أخسر الآن

113
00:11:18,980 --> 00:11:22,420
!لا يمكنني أن أخسر

114
00:11:23,450 --> 00:11:24,460
!ماذا؟

115
00:11:24,990 --> 00:11:27,720
!فردوس توتسوكا

116
00:11:46,690 --> 00:11:47,900
!نعم

117
00:11:49,850 --> 00:11:52,990
!هل جرح كايدو-ساما المنيع؟

118
00:12:11,990 --> 00:12:14,010
!هذه هي

119
00:12:20,880 --> 00:12:23,000
...إيّاك والعودة

120
00:12:23,420 --> 00:12:26,210
!إلى بلاد وانو

121
00:12:42,940 --> 00:12:44,130
!النّجدة

122
00:12:47,240 --> 00:12:51,220
!والدي! ساعدني يا والدي

123
00:12:52,030 --> 00:12:55,780
!مومو

124
00:13:19,650 --> 00:13:21,720
!مومو

125
00:13:35,910 --> 00:13:37,470
!هذه أنا

126
00:13:40,370 --> 00:13:42,620
!أودن-ساما

127
00:13:48,010 --> 00:13:49,070
!أشورا

128
00:13:51,340 --> 00:13:53,070
...أودن-ساما

129
00:14:11,860 --> 00:14:19,560
.وهكذا، انتهت معركة كوزكي أودن والأكازايا الأسطوريّة

130
00:14:50,280 --> 00:14:55,630
أشعلت المعركة الحامية بين ساموراي
الأكازايا وقراصنة مملكة الحيوان

131
00:14:55,630 --> 00:15:02,770
حريقًا في غابة في أودون دام لخمسة
.أيّام ولم يخمد حتّى أمطرت

132
00:15:15,190 --> 00:15:16,490
!والدتي

133
00:15:18,310 --> 00:15:21,080
!متى سيعود والدي؟

134
00:15:21,450 --> 00:15:23,340
!صنعت بالونًا له

135
00:15:23,340 --> 00:15:25,930
!انظري لهذا

136
00:15:35,320 --> 00:15:37,220
والدتي؟

137
00:15:39,950 --> 00:15:42,180
لا تطيقان الانتظار لرؤيته، صحيح؟

138
00:15:42,180 --> 00:15:45,390
!نعم! أريد اللّعب مع والدي بشدّة

139
00:15:53,840 --> 00:15:58,400
،دايميو كوري كوزكي أودن
،والتّسّعة الآخرون قد أُسروا

140
00:15:58,760 --> 00:16:06,370
وسُجنوا في عاصمة الزّهور منتظرين صدور
.الحكم عليهم كمتمرّدين ضدّ الشّوغن

141
00:16:06,550 --> 00:16:11,290
،كان عامّة النّاس يجهلون السّبب
...لذلك عاملوهم بازدراء وبرود

142
00:16:11,290 --> 00:16:12,790
...سبق وخذلنا

143
00:16:12,790 --> 00:16:14,250
.فات الأوان

144
00:16:14,250 --> 00:16:19,780
لن نتمكّن من رؤية رقصته العارية
!الأسبوعيّة بعد الآن؟ يا للخسارة

145
00:16:19,780 --> 00:16:21,690
!مهلاً، ذلك غير لائق

146
00:16:21,690 --> 00:16:24,450
.ويحي. آسف، آسف

147
00:16:28,330 --> 00:16:30,310
...أودن-ساما

148
00:16:30,880 --> 00:16:32,710
!سُحقًا! دعوني

149
00:16:32,710 --> 00:16:34,860
!الزمي الصّمت

150
00:16:36,510 --> 00:16:37,440
!أودن-ساما

151
00:16:38,180 --> 00:16:42,360
!إنّها حليفة لكم أيضًا، صحيح؟! سنسجنها

152
00:16:43,970 --> 00:16:45,910
من تكون؟

153
00:16:47,850 --> 00:16:51,420
!إنّها ليست من أتباعي

154
00:16:51,420 --> 00:16:54,000
!أعتقد أنّها أتت لقتلي

155
00:16:55,190 --> 00:16:56,900
أودن-ساما؟

156
00:16:56,900 --> 00:17:00,130
!لا تناديني بأودن-ساما! كفاك تظاهرًا

157
00:17:00,220 --> 00:17:03,360
!اخرسي وابتعدي عن ناظريّ أيّتها الكونويتشي

158
00:17:11,390 --> 00:17:17,620
!صدر الحكم ضدّ السّاموراي

159
00:17:21,070 --> 00:17:30,330
السّاموراي العشرة الّذين قادوا تمرّدًا
...ضدّ الشوغن أوروتشي مؤخّرًا

160
00:17:41,570 --> 00:17:48,470
حُكم عليهم بالإعدام العلنيّ عن طريق
!غليهم بعد ثلاثة أيّام من الآن

161
00:17:55,960 --> 00:17:58,420
...وبعد ثلاثة أيّام

162
00:18:00,720 --> 00:18:03,240
!لا تتسنّى لنا رؤية شخص يغلي دائمًا

163
00:18:03,800 --> 00:18:06,490
!سيغلونهم في الزّيت، لذلك لن يدوم الأمر

164
00:18:06,490 --> 00:18:08,120
!علينا أن نسرع إذًا

165
00:18:09,180 --> 00:18:10,580
!كلاّ

166
00:18:11,100 --> 00:18:13,860
!مومونوسكي، لم يتمّ التّأكّد أنّه ليس مسمومًا بعد

167
00:18:13,860 --> 00:18:15,810
.اسمح لي

168
00:18:18,650 --> 00:18:20,000
...يا والدتي

169
00:18:20,450 --> 00:18:23,670
لماذا هنالك من يسعى خلف حياتي؟

170
00:18:25,780 --> 00:18:28,260
،لأنّ والدك رجل عظيم

171
00:18:28,260 --> 00:18:33,620
.وأنت من سيحكم هذه البلاد يومًا ما

172
00:18:39,300 --> 00:18:42,300
.تفضّلا يا مومونوسكي-ساما وهيوري-ساما

173
00:18:42,300 --> 00:18:44,420
!وقت الأكل

174
00:18:45,720 --> 00:18:47,420
أخي؟

175
00:18:51,350 --> 00:18:53,330
!يا والدتي

176
00:18:55,900 --> 00:19:01,210
...اليوم... والدي سوف

177
00:19:08,240 --> 00:19:11,030
...والدي

178
00:19:11,390 --> 00:19:15,660
!والدي

179
00:19:57,420 --> 00:19:59,980
!حسنًا! حان وقت الإعدام

180
00:20:03,880 --> 00:20:10,990
سنبدأ الآن الإعدام العلنيّ
!لكوزكي أودن وأتباعه التّسعة

181
00:20:24,990 --> 00:20:28,110
!لم يستطع هزيمة كايدو في النّهاية

182
00:20:28,280 --> 00:20:32,640
!رغم أنّه سيّد سخيف، إلاّ أنّني ظننته قويًّا جدًّا

183
00:20:33,160 --> 00:20:36,320
!ما كانت فائدته من الأساس؟

184
00:20:40,710 --> 00:20:42,160
.تقدّم

185
00:21:25,310 --> 00:21:28,320
!ادخل القِدر

186
00:21:36,480 --> 00:21:39,040
.امنحني فرصة

187
00:21:39,040 --> 00:21:42,560
!يجب أن أعيش

188
00:21:42,560 --> 00:21:45,420
!لا تكن سخيفًا

189
00:21:47,900 --> 00:21:52,470
كفّ عن دفعي للضّحك بالتّوسّل
!من أجل حياتك! ادخل فحسب

190
00:21:57,330 --> 00:21:58,680
...النّجدة

191
00:22:00,180 --> 00:22:02,020
!ا-ابتعد

192
00:22:08,520 --> 00:22:10,070
!يكفي

193
00:22:10,320 --> 00:22:14,010
!لماذا قد أعطيك فرصة؟

194
00:22:14,010 --> 00:22:16,130
!كوزكي أودن

195
00:22:16,520 --> 00:22:18,370
!ما الّذي تنوي عليه؟

196
00:22:19,390 --> 00:22:22,080
.سندخل القِدر كلّنا دفعة واحدة

197
00:22:24,310 --> 00:22:25,920
ماذا؟

198
00:22:34,370 --> 00:22:39,220
ضع أيّ مهلة تريد وإن نجى
...أيّ أحد منّا طوالها

199
00:22:49,670 --> 00:22:52,280
!ستمنحنا حرّيّتنا

