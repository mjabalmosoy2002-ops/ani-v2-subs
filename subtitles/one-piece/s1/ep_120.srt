1
00:00:08,290 --> 00:00:11,330
!العالم... نعم

2
00:00:11,860 --> 00:00:13,530
...اسعوا نحو الحرّيّة

3
00:00:13,530 --> 00:00:17,570
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:18,030 --> 00:00:21,370
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,900 --> 00:00:23,370
!فتجاوزوها

6
00:00:23,670 --> 00:00:26,640
!تحت راية ما تؤمنون به

7
00:00:31,110 --> 00:00:36,720
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,720 --> 00:00:39,950
متّجهًا نحو عالم بلا نهاية

9
00:00:41,360 --> 00:00:46,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,230 --> 00:00:54,640
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,640 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,810
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,810 --> 00:01:10,450
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,450 --> 00:01:14,320
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,320 --> 00:01:19,260
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,260 --> 00:01:27,000
متّجهين نحو الأفق

17
00:01:27,000 --> 00:01:32,510
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,510 --> 00:01:37,210
متّجهًا نحو عالم بلا نهاية

19
00:01:37,210 --> 00:01:42,450
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,450 --> 00:01:48,720
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:55,700 --> 00:01:57,600
مشاعر أولئك الّذين يعانون من كرب

22
00:01:57,600 --> 00:02:00,100
.لاقت سحقًا من سحابة الرّمال الجافّة

23
00:02:00,900 --> 00:02:04,610
،هنالك من في الأمل ساعٍ
.وهنالك من فيه متشبّث

24
00:02:05,140 --> 00:02:07,740
تشابكت مشاعرهم وهم في ريبةٍ من أمرهم

25
00:02:07,740 --> 00:02:11,110
.واسمةً حقبةً من التّاريخ يختمها الحزن

26
00:02:12,550 --> 00:02:15,780
يحاول كروكودايل معرفة مكان البونيغليف

27
00:02:16,220 --> 00:02:19,850
وأعرب أنّ قذيفة مدفعيّة
.ستُنسِف ميدان القصر

28
00:02:20,990 --> 00:02:22,620
هل ستكون هذه نهاية أراباستا؟

29
00:02:23,490 --> 00:02:25,790
أم أنّها ستنعم بالسّلام الحقيقيّ؟

30
00:02:27,900 --> 00:02:33,000
بدأت ساعة القدر الرّمليّة
.بالعدّ التّنازليّ النّهائيّ ثانيةً

31
00:02:46,150 --> 00:02:48,650
!ابتعدوا عن الطّريق! ابتعدوا
!تنحّوا عن الطّريق

32
00:02:48,650 --> 00:02:50,150
!...أولئك

33
00:02:57,660 --> 00:02:59,230
!انتظر رجاءً يا تشاكا-ساما

34
00:03:02,760 --> 00:03:03,960
من هم؟

35
00:03:04,370 --> 00:03:05,500
...أنتم

36
00:03:05,870 --> 00:03:07,340
!قوّات المخالب الحادّة

37
00:03:17,240 --> 00:03:18,710
!إيّاكم

38
00:03:19,250 --> 00:03:21,580
!لا تقتربوا من هذا الرّجل

39
00:03:25,550 --> 00:03:27,920
!لقد حطّموا البوّابة
!إنّهم قوّات المخالب الحادّة

40
00:03:27,920 --> 00:03:29,160
!هذا ما نتوقّعه من وحدة النّخبة

41
00:03:29,160 --> 00:03:31,130
!رجاءً أنقذوا جلالته وفيفي-ساما

42
00:03:32,030 --> 00:03:37,330
يا صاحب الجلالة! حمايتك
!حتّى الموت هي مهمّتنا

43
00:03:37,800 --> 00:03:39,900
...لا يمكننا أن نبقى بعيدين عنه

44
00:03:40,840 --> 00:03:43,170
...إن كنّا سنتعامل مع أحد الشّيتشيبوكاي

45
00:03:43,440 --> 00:03:46,140
،علينا القيام بما يلزم
.حتّى وإن كان عاريًا من النّزاهة

46
00:03:46,770 --> 00:03:48,380
...نحن الأربعة

47
00:03:48,910 --> 00:03:50,580
...سنقاتل

48
00:03:50,950 --> 00:03:52,410
.لتصويب الأمور

49
00:03:53,510 --> 00:03:56,480
.يبدو أنّكم ذوو شعبيّة

50
00:03:56,480 --> 00:04:00,620
،سأصفح عن حياتكم
.لذا عودوا من حيث أتيتم

51
00:04:00,620 --> 00:04:02,390
!لا يمكننا ذلك

52
00:04:03,260 --> 00:04:06,090
.لدينا سبب يمنعنا من الانسحاب

53
00:04:06,590 --> 00:04:07,760
سبب؟

54
00:04:10,460 --> 00:04:15,370
...إن كنت قائد هذه التّمرّد حقًّا

55
00:04:19,710 --> 00:04:20,810
!...تلك الكدمات

56
00:04:23,110 --> 00:04:24,580
...لا يعقل أنّكم

57
00:04:28,820 --> 00:04:29,920
هل أتكفّل؟

58
00:04:29,920 --> 00:04:32,520
.لا تزعجي نفسك. إنّهم محض حشرات

59
00:04:35,720 --> 00:04:36,520
...لا يعقل أنّهم

60
00:04:40,090 --> 00:04:42,730
!تشاكا! ثمّة خطب بهم

61
00:04:42,730 --> 00:04:45,800
...لأجل تعزيز قوّتهم مؤقّتًا... قاموا

62
00:04:46,670 --> 00:04:48,770
...بشرب الماء الّذي يقصّر من حياتهم

63
00:04:49,570 --> 00:04:51,040
!الوقود القاتل

64
00:04:51,510 --> 00:04:54,440
...بقيت في حياتهم بضع دقائق فحسب

65
00:04:54,840 --> 00:04:56,080
...لا يمكننا إنقاذهم

66
00:04:56,080 --> 00:04:57,350
...لا يعقل

67
00:05:00,010 --> 00:05:03,150
.توقّعت هذا

68
00:05:03,150 --> 00:05:06,790
هل تتحدّونني على حساب حياتكم؟

69
00:05:07,420 --> 00:05:12,130
تشاكا-ساما... سامحنا رجاءً
.لأنّنا فعلنا هذا دون استشارتك

70
00:05:12,130 --> 00:05:16,930
...لكن، يجب أن نجعله يدرك
...ألم هذه البلاد

71
00:05:35,750 --> 00:05:38,150
...أيّها... الأغبياء

72
00:05:38,850 --> 00:05:43,320
...يجب أن نجعله يدرك
...ما تشعر به هذه البلاد

73
00:05:48,330 --> 00:05:51,170
!من غضب

74
00:06:05,350 --> 00:06:07,480
.هذا ليس تصرّفًا ذكيًّا

75
00:06:08,220 --> 00:06:10,990
.يجب أن تقدّروا حياتكم

76
00:06:11,490 --> 00:06:13,320
.لكن أظنّ أنّ الأوان فات على قول هذا

77
00:06:19,790 --> 00:06:24,300
،إن كنتم ستموتون على أيّ حال
فلستُ بحاجة لقتلكم، صحيح؟

78
00:06:24,700 --> 00:06:27,170
!لن تقاتل حتّى؟

79
00:06:43,780 --> 00:06:45,850
...تشاكا-ساما

80
00:06:51,790 --> 00:06:55,300
.أنتم خير مثال على الغباء

81
00:06:56,700 --> 00:06:58,530
!أيّها الشّيطان اللّعين

82
00:07:02,700 --> 00:07:04,540
!أيّها الوغد

83
00:07:06,640 --> 00:07:07,880
!تشاكا

84
00:07:08,180 --> 00:07:12,510
!توقّف يا تشاكا! لا تتبعهم إلى التّهلكة

85
00:07:13,780 --> 00:07:15,280
...نوع زون

86
00:07:15,280 --> 00:07:19,450
!فاكهة الكلب، صنف ابن آوى

87
00:07:20,420 --> 00:07:22,260
!الأنياب العاوية

88
00:07:26,160 --> 00:07:32,400
إذًا فأنت أيضًا من النّوع
الّذي يموت لأجل الغير؟

89
00:07:46,880 --> 00:07:49,550
...سحقًا! نزفتُ كثيرًا

90
00:07:50,380 --> 00:07:53,590
أظنّني محظوظًا لأنّ الجراح
...ليست عميقة للغاية

91
00:07:53,590 --> 00:07:56,490
....لكنّها مؤلمة بحقّ

92
00:07:58,630 --> 00:08:00,230
...أتساءل كيف حال البقيّة

93
00:08:00,660 --> 00:08:02,560
...من الأفضل لهم ألاّ يموتوا

94
00:08:03,130 --> 00:08:04,970
...أريد أن أعرف ما يجري

95
00:08:05,770 --> 00:08:10,100
!ماذا؟! عليّ أن أشكّل ثنائيًّا مع رموش؟

96
00:08:11,670 --> 00:08:15,210
!إنّه جمل كما ترون

97
00:08:15,210 --> 00:08:18,050
!لا تستهن بمدى ضعفي

98
00:08:18,980 --> 00:08:21,850
لم يحالفك الحظّ في السّحب
!فحسب! تقبّل الأمر

99
00:08:21,850 --> 00:08:25,120
!حسنًا، عدني بشيءٍ واحد إذًا

100
00:08:25,120 --> 00:08:26,890
...إن وقعنا في ورطة

101
00:08:26,890 --> 00:08:28,490
!احرص على إنقاذنا رجاءً

102
00:08:28,490 --> 00:08:31,860
.غبيّ. أنا أنقذ الآنسات فحسب

103
00:08:34,600 --> 00:08:35,760
...أوسوبّ

104
00:08:38,800 --> 00:08:43,240
يا أوسوبّ. لماذا تبكي؟

105
00:08:43,240 --> 00:08:46,240
!من تقصد أنّه يبكي؟! يبكي؟

106
00:08:46,240 --> 00:08:48,510
من يزعم أنّ أحدًا يبكي
!هو من يبكي في الواقع

107
00:08:48,510 --> 00:08:50,010
.كلامك غير منطقيّ

108
00:08:50,440 --> 00:08:51,680
...لكن

109
00:08:52,550 --> 00:08:59,190
...قالت الخلد الشّمطاء
...أنّ لوفي مات، لذا

110
00:08:59,650 --> 00:09:01,660
...أ-أتساءل إن كان ذلك صحيحًا

111
00:09:02,420 --> 00:09:04,630
هل صدّقتما ذلك؟

112
00:09:05,160 --> 00:09:08,130
!بالطّبع لا! هل أنت غبيّ؟

113
00:09:08,130 --> 00:09:11,230
!ولا أنا! لا أصدّق ذلك إطلاقًا

114
00:09:12,670 --> 00:09:14,100
!مفهوم

115
00:09:14,100 --> 00:09:18,110
ما علينا فعله الآن هو الوصول
.إلى القصر بأسرع ما يمكننا

116
00:09:19,010 --> 00:09:23,310
.امسحا مخاطكما حتّى انتهاء هدير المعركة

117
00:09:25,380 --> 00:09:26,480
!لم أقل ابتلعه

118
00:09:30,020 --> 00:09:31,890
...شكرًا لكم... يا رفاق

119
00:09:32,750 --> 00:09:34,360
.من المبكّر شكرنا

120
00:09:34,690 --> 00:09:38,190
معه حقّ. كما أنّك إن أردت
...شكر قراصنة

121
00:09:38,190 --> 00:09:40,060
.عليك أن تعطينا بعض المال

122
00:09:40,060 --> 00:09:43,330
!فقط كم تنوين السّحب من هذه البلاد؟

123
00:09:44,000 --> 00:09:47,670
هل نامي بخير؟
هل تمكّنت من الهروب...؟

124
00:09:55,310 --> 00:09:56,740
...نجحت أخيرًا

125
00:09:57,140 --> 00:10:01,720
هذا ما كان يقصده بهجومٍ واحد قويّ؟

126
00:10:02,950 --> 00:10:06,420
...موجة المتمرّدين قريبة بالفعل

127
00:10:10,930 --> 00:10:12,560
.مع أنّ الوضع تغيّر

128
00:10:13,060 --> 00:10:14,960
.عليّ الذّهاب للقصر على أيّ حال

129
00:10:20,070 --> 00:10:23,640
ماذا يجري مع فيفي...؟
...يبدو أنّ المعركة بدأت

130
00:10:25,440 --> 00:10:29,010
.بالمناسبة يا فيفي-تشان
.عليك تذكّر هذا

131
00:10:29,710 --> 00:10:33,010
عقب أيّ معركة... يأكل ذلك
...الشّخص بشراهة

132
00:10:33,710 --> 00:10:34,550
.نعم

133
00:10:35,020 --> 00:10:37,620
!سننتظرك في ألوبارنا، اتّفقنا؟

134
00:10:37,620 --> 00:10:40,990
!أجل

135
00:10:40,990 --> 00:10:43,260
.حسنًا، ستكون هذه النّقطة الفيصل

136
00:10:45,660 --> 00:10:46,960
!لا مجال للإخفاق

137
00:10:47,500 --> 00:10:51,100
!هيّا بنا! لنتقابل في قصر ألوبارنا

138
00:11:06,780 --> 00:11:07,850
!تشاكا

139
00:11:13,820 --> 00:11:17,760
...الضّعف... جريمة

140
00:11:21,560 --> 00:11:22,600
!فيفي

141
00:11:53,930 --> 00:11:55,960
!كـ... كوزا

142
00:12:03,200 --> 00:12:07,110
أنت... فهمت، أتيت من الطّريق
...المختصر الّذي اعتدتَ استخدامه

143
00:12:08,680 --> 00:12:11,080
هل هناك خطب في عينيّ؟

144
00:12:21,760 --> 00:12:25,030
...أتيتُ لإقناع الجيش الملكيّ، لكن

145
00:12:27,400 --> 00:12:28,260
...تشاكا

146
00:12:29,760 --> 00:12:34,900
والملك... على وشك أن يُقتل
...على يد بطل البلاد

147
00:12:35,270 --> 00:12:37,470
!يصعب عليّ تصديق ما أراه

148
00:12:40,470 --> 00:12:42,810
!أصبح الوضع مثيرًا للاهتمام

149
00:12:43,380 --> 00:12:45,850
،أنتم في خضمّ المعركة الآن

150
00:12:45,850 --> 00:12:50,480
إلاّ أنّ قائدَي الطّرفين
.يواجهان بعضهما هنا

151
00:12:50,480 --> 00:12:55,460
باتت هذه الحرب قتالاً حتّى
.الموت بين سحالي قُطع رأسها

152
00:12:58,190 --> 00:13:02,360
...يبدو أنّك مشوّش. هذا ردّ فعل طبيعيّ

153
00:13:02,730 --> 00:13:03,730
.لكنّ الأمر بسيط

154
00:13:05,270 --> 00:13:09,870
.فقط تخيّل أسوأ مآلٍ ممكن

155
00:13:14,280 --> 00:13:17,480
.لا ترتب يا كوزا

156
00:13:25,090 --> 00:13:26,890
هل تحبّ هذه البلاد؟

157
00:13:35,560 --> 00:13:37,830
!نعم! لقد وُلدتُ فيها

158
00:13:38,800 --> 00:13:40,330
!وأنا أيضًا

159
00:13:43,770 --> 00:13:45,010
...كوزا، اسمع

160
00:13:45,010 --> 00:13:48,880
!فيفي! من سلب الشّتاء عن هذه البلاد؟

161
00:13:50,950 --> 00:13:52,110
...كلّ شيء كان

162
00:13:52,580 --> 00:13:54,220
.كان أنا يا كوزا

163
00:13:55,780 --> 00:13:59,920
كلّ ما ظننت أنّه من فعل الملك

164
00:14:00,420 --> 00:14:03,090
.كان في الواقع "فخًّا" من شركتي

165
00:14:03,420 --> 00:14:08,800
،خلال العامين المنصرمين
...كنتم تحت سيطرتنا التّامّة

166
00:14:09,900 --> 00:14:15,600
بينما كانت العائلة المالكة
.والجيش يلاحقون ظلالنا باستماتة

167
00:14:21,480 --> 00:14:26,150
ربّما أمكنك أن تموت سعيدًا
...لو لم تعرف بهذه الحقائق

168
00:14:32,950 --> 00:14:35,190
!لا تصغ إليه يا كوزا

169
00:14:36,520 --> 00:14:37,530
...الملك

170
00:14:37,990 --> 00:14:40,330
!ما زال هناك ما تستطيع فعله

171
00:14:40,800 --> 00:14:43,500
!أنقذ أكبر عددٍ ممكن من الشّعب

172
00:14:45,100 --> 00:14:50,440
...فبعد أقلّ من نصف ساعة
!سيُفجّر ميدان القصر

173
00:14:50,810 --> 00:14:52,040
!ماذا؟

174
00:14:52,510 --> 00:14:54,640
...ما زلتَ حيًّا إذًا

175
00:14:59,450 --> 00:15:02,320
!أسرع

176
00:15:13,360 --> 00:15:14,630
!لا

177
00:15:16,930 --> 00:15:18,000
!...فيفي

178
00:15:18,630 --> 00:15:21,540
!تنحّي عنّي يا فيفي! ماذا تفعلين؟

179
00:15:21,540 --> 00:15:24,940
.سيصبح الميدان ساحة معركة
...إن انفجر حقًّا

180
00:15:24,940 --> 00:15:28,240
!لن... لن أدعه يصبح ساحة معركة

181
00:15:31,880 --> 00:15:34,750
!ما زلت هلعًا

182
00:15:35,050 --> 00:15:37,250
ماذا تظنّ سيحدث

183
00:15:37,250 --> 00:15:39,920
!إن عرفوا الآن أنّ الميدان سيُفجّر؟

184
00:15:39,920 --> 00:15:43,090
!لن يبثّ ذلك الدّعر وحده

185
00:15:43,720 --> 00:15:48,460
فور أن يحدث ذلك، لن تتوقّف
!الحرب! ولن يُنقَذ أيّ أحد

186
00:15:52,730 --> 00:15:54,000
أليس كذلك؟

187
00:15:56,040 --> 00:15:58,370
...يا له من حكم حذق

188
00:15:58,810 --> 00:16:01,780
سبق وتقرّر ما على عاتقنا
!فعله من البداية

189
00:16:04,580 --> 00:16:07,680
!وهو إيقاف هذا التّمرّد المدبّر

190
00:16:09,280 --> 00:16:13,290
!وأنت الوحيد الّذي يستطيع فعل ذلك

191
00:16:31,440 --> 00:16:32,410
...فيفي

192
00:16:38,410 --> 00:16:43,420
وهل تظنّان أنّني سأقف متفرّجًا فحسب؟

193
00:16:55,000 --> 00:16:56,000
!تشاكا

194
00:16:58,700 --> 00:17:02,500
!أنا ابن آوى، إله أراباستا الحارس

195
00:17:02,840 --> 00:17:05,740
!ومدمّر أعداء العائلة المالكة

196
00:17:12,080 --> 00:17:15,320
!سأقاتل ما دام فيّ عرق ينبض

197
00:17:16,180 --> 00:17:18,950
.هذا ما نسمّيه بالغباء

198
00:17:18,950 --> 00:17:21,560
!افعلا ما على عاتقكما أنتما الاثنان

199
00:17:21,560 --> 00:17:24,490
أظنّني أستطيع أن أصدّه
!لبضع دقائق أخرى على الأقلّ

200
00:17:25,560 --> 00:17:26,460
!حسنًا

201
00:17:28,060 --> 00:17:29,260
!تشاكا

202
00:17:29,260 --> 00:17:32,430
.أظنّ أنّ قائد جماعة الرّمل ليس قويًّا جدًّا

203
00:17:36,870 --> 00:17:38,370
ما الخطب الآن؟

204
00:17:43,510 --> 00:17:45,450
!هذا مؤلم

205
00:17:46,410 --> 00:17:49,920
!ما قصّتك؟! أنت تتصرّف بصبيانيّة
!تريّث معي

206
00:17:49,920 --> 00:17:51,650
.أنت مزعج

207
00:17:53,390 --> 00:17:56,420
.أنت من طلب منّي أن أدرّبك

208
00:18:11,270 --> 00:18:13,610
!تقرير من وحدة الحراسة 2 إلى المقرّ

209
00:18:14,440 --> 00:18:16,080
!من وحدة الحراسة 2 إلى المقرّ

210
00:18:16,510 --> 00:18:19,580
!لقد اختُرقَ... الخطّ 4

211
00:18:27,090 --> 00:18:30,560
إنّ جيش المتمرّدين يمرّ حاليًّا عبر
!السّاحة المركزيّة صوب المجمّع الشّماليّ

212
00:18:30,560 --> 00:18:32,430
!سيبلغون القصر

213
00:18:40,940 --> 00:18:44,640
!استسلموا الآن أيّها الجيش الملكيّ

214
00:18:45,110 --> 00:18:47,380
!فيفي-ساما! ما الّذي تقوله؟

215
00:18:47,380 --> 00:18:48,680
!نستسلم؟

216
00:18:48,680 --> 00:18:52,080
!ماذا عساه يحلّ ببلادنا إن فعلنا ذلك؟

217
00:18:52,680 --> 00:18:55,550
!...انظروا! ذلك

218
00:18:55,980 --> 00:19:00,250
إنّه كوزا! لِمَ قائد جيش المتمرّدين هنا؟

219
00:19:00,860 --> 00:19:03,060
!أصغوا لفيفي

220
00:19:03,720 --> 00:19:07,060
!ما عدنا نبتغي النّصر أو القتال

221
00:19:07,360 --> 00:19:10,060
!أريدكم أن توقفوا هذا القتال

222
00:19:10,360 --> 00:19:12,630
!ماذا؟! ما الّذي يجري؟

223
00:19:13,730 --> 00:19:19,340
سوف أُبلغ جيش المتمرّدين
...أنّ هذا القتال كان بلا أيّ معنى

224
00:19:20,170 --> 00:19:23,610
!وأنّه ما عاد لنا سبب للقتال

225
00:19:30,150 --> 00:19:31,250
!أرجوكم

226
00:19:37,020 --> 00:19:39,990
!بات رأس الملك في متناولنا

227
00:19:40,230 --> 00:19:43,460
!نعم! بات برج السّاعة أمام ناظرنا

228
00:19:49,440 --> 00:19:51,740
!إنّنا نقترب من ميدان القصر

229
00:19:52,640 --> 00:19:55,040
!تأهّبوا للهجوم

230
00:20:08,190 --> 00:20:09,690
!ا-انتظروا

231
00:20:17,300 --> 00:20:18,770
!رايات بيضاء؟

232
00:20:28,740 --> 00:20:30,180
!كوزا-سان

233
00:20:30,580 --> 00:20:32,080
!إ-إنّه كوزا-سان

234
00:20:32,080 --> 00:20:33,880
ما الّذي يفعله كوزا-سان هنا؟

235
00:20:33,880 --> 00:20:36,080
كوزا-سان؟ ما الّذي يفعله هنا؟

236
00:20:36,080 --> 00:20:37,150
لماذا؟

237
00:20:37,690 --> 00:20:40,090
!انتهى القتال

238
00:20:40,720 --> 00:20:44,730
!جميعًا! أخمدوا غضبكم واخفضوا أسلحتكم

239
00:20:46,060 --> 00:20:49,760
!ما عاد الجيش الملكيّ يملك رغبةً للقتال

240
00:20:52,870 --> 00:20:54,400
!...توقّفوا رجاءً

241
00:21:23,660 --> 00:21:25,670
!أهذا صحيح...؟ كوزا-سان...؟

242
00:21:26,030 --> 00:21:28,740
...أجل... هذه المعركة

243
00:21:47,360 --> 00:21:52,030
!كوزا

244
00:22:06,640 --> 00:22:12,750
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

245
00:22:12,750 --> 00:22:18,690
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

246
00:22:18,690 --> 00:22:24,930
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

247
00:22:24,930 --> 00:22:30,360
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

248
00:22:30,360 --> 00:22:36,600
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

249
00:22:36,600 --> 00:22:42,040
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

250
00:22:42,810 --> 00:22:45,810
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

251
00:22:45,810 --> 00:22:49,580
دعنا نرسم قصّة المستقبل

252
00:22:49,580 --> 00:22:54,820
سأضع كلّ مشاعري
في رياح جديدة تمامًا الآن

253
00:22:54,820 --> 00:22:57,830
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

254
00:22:57,830 --> 00:23:00,830
رحلة لا نهاية لها لنكون معًا

255
00:23:00,830 --> 00:23:06,030
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

256
00:23:11,340 --> 00:23:15,180
.أفيقي يا سموّ الأميرة
.لا يمكنك إنقاذ هذه البلاد

257
00:23:15,180 --> 00:23:18,480
...ما عاد صوتي يصل إلى أيّ أحد

258
00:23:18,480 --> 00:23:20,480
...إلّم نفعل شيئًا، فهذه البلاد سوف

259
00:23:20,480 --> 00:23:23,880
.لا تقلقي! صوتك يصلنا نحن

260
00:23:23,880 --> 00:23:24,650
!لوفي-سان

261
00:23:24,990 --> 00:23:27,050
!سأضع نهايةً... لكلّ هذا

262
00:23:27,420 --> 00:23:28,790
:في الحلقة القادمة من ون بيس

263
00:23:28,790 --> 00:23:31,960
!حيث يُسمع صوت فيفي"
"!هبوط البطل

264
00:23:31,960 --> 00:23:34,260
!ملك القراصنة، لن يكون إلاّ أنا