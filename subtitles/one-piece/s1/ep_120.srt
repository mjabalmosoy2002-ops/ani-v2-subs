1
00:00:22,290 --> 00:00:25,330
!العالم... نعم

2
00:00:25,860 --> 00:00:27,530
...اسعوا نحو الحرّيّة

3
00:00:27,530 --> 00:00:31,570
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:32,030 --> 00:00:35,370
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,900 --> 00:00:37,370
!فتجاوزوها

6
00:00:37,670 --> 00:00:40,640
!تحت راية ما تؤمنون به

7
00:00:45,110 --> 00:00:50,720
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,720 --> 00:00:53,950
متّجهًا نحو عالم بلا نهاية

9
00:00:55,360 --> 00:01:00,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,230 --> 00:01:08,640
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,640 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,810
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,810 --> 00:01:24,450
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,450 --> 00:01:28,320
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,320 --> 00:01:33,260
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,260 --> 00:01:41,000
متّجهين نحو الأفق

17
00:01:41,000 --> 00:01:46,510
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,510 --> 00:01:51,210
متّجهًا نحو عالم بلا نهاية

19
00:01:51,210 --> 00:01:56,450
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,450 --> 00:02:02,720
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:09,700 --> 00:02:11,600
مشاعر أولئك الّذين يعانون من كرب

22
00:02:11,600 --> 00:02:14,100
.لاقت سحقًا من سحابة الرّمال الجافّة

23
00:02:14,900 --> 00:02:18,610
،هنالك من في الأمل ساعٍ
.وهنالك من فيه متشبّث

24
00:02:19,140 --> 00:02:21,740
تشابكت مشاعرهم وهم في ريبةٍ من أمرهم

25
00:02:21,740 --> 00:02:25,110
.واسمةً حقبةً من التّاريخ يختمها الحزن

26
00:02:26,550 --> 00:02:29,780
يحاول كروكودايل معرفة مكان البونيغليف

27
00:02:30,220 --> 00:02:33,850
وأعرب أنّ قذيفة مدفعيّة
.ستُنسِف ميدان القصر

28
00:02:34,990 --> 00:02:36,620
هل ستكون هذه نهاية أراباستا؟

29
00:02:37,490 --> 00:02:39,790
أم أنّها ستنعم بالسّلام الحقيقيّ؟

30
00:02:41,900 --> 00:02:47,000
بدأت ساعة القدر الرّمليّة
.بالعدّ التّنازليّ النّهائيّ ثانيةً

31
00:03:00,150 --> 00:03:02,650
!ابتعدوا عن الطّريق! ابتعدوا
!تنحّوا عن الطّريق

32
00:03:02,650 --> 00:03:04,150
!...أولئك

33
00:03:11,660 --> 00:03:13,230
!انتظر رجاءً يا تشاكا-ساما

34
00:03:16,760 --> 00:03:17,960
من هم؟

35
00:03:18,370 --> 00:03:19,500
...أنتم

36
00:03:19,870 --> 00:03:21,340
!قوّات المخالب الحادّة

37
00:03:31,240 --> 00:03:32,710
!إيّاكم

38
00:03:33,250 --> 00:03:35,580
!لا تقتربوا من هذا الرّجل

39
00:03:39,550 --> 00:03:41,920
!لقد حطّموا البوّابة
!إنّهم قوّات المخالب الحادّة

40
00:03:41,920 --> 00:03:43,160
!هذا ما نتوقّعه من وحدة النّخبة

41
00:03:43,160 --> 00:03:45,130
!رجاءً أنقذوا جلالته وفيفي-ساما

42
00:03:46,030 --> 00:03:51,330
يا صاحب الجلالة! حمايتك
!حتّى الموت هي مهمّتنا

43
00:03:51,800 --> 00:03:53,900
...لا يمكننا أن نبقى بعيدين عنه

44
00:03:54,840 --> 00:03:57,170
...إن كنّا سنتعامل مع أحد الشّيتشيبوكاي

45
00:03:57,440 --> 00:04:00,140
،علينا القيام بما يلزم
.حتّى وإن كان عاريًا من النّزاهة

46
00:04:00,770 --> 00:04:02,380
...نحن الأربعة

47
00:04:02,910 --> 00:04:04,580
...سنقاتل

48
00:04:04,950 --> 00:04:06,410
.لتصويب الأمور

49
00:04:07,510 --> 00:04:10,480
.يبدو أنّكم ذوو شعبيّة

50
00:04:10,480 --> 00:04:14,620
،سأصفح عن حياتكم
.لذا عودوا من حيث أتيتم

51
00:04:14,620 --> 00:04:16,390
!لا يمكننا ذلك

52
00:04:17,260 --> 00:04:20,090
.لدينا سبب يمنعنا من الانسحاب

53
00:04:20,590 --> 00:04:21,760
سبب؟

54
00:04:24,460 --> 00:04:29,370
...إن كنت قائد هذه التّمرّد حقًّا

55
00:04:33,710 --> 00:04:34,810
!...تلك الكدمات

56
00:04:37,110 --> 00:04:38,580
...لا يعقل أنّكم

57
00:04:42,820 --> 00:04:43,920
هل أتكفّل؟

58
00:04:43,920 --> 00:04:46,520
.لا تزعجي نفسك. إنّهم محض حشرات

59
00:04:49,720 --> 00:04:50,520
...لا يعقل أنّهم

60
00:04:54,090 --> 00:04:56,730
!تشاكا! ثمّة خطب بهم

61
00:04:56,730 --> 00:04:59,800
...لأجل تعزيز قوّتهم مؤقّتًا... قاموا

62
00:05:00,670 --> 00:05:02,770
...بشرب الماء الّذي يقصّر من حياتهم

63
00:05:03,570 --> 00:05:05,040
!الوقود القاتل

64
00:05:05,510 --> 00:05:08,440
...بقيت في حياتهم بضع دقائق فحسب

65
00:05:08,840 --> 00:05:10,080
...لا يمكننا إنقاذهم

66
00:05:10,080 --> 00:05:11,350
...لا يعقل

67
00:05:14,010 --> 00:05:17,150
.توقّعت هذا

68
00:05:17,150 --> 00:05:20,790
هل تتحدّونني على حساب حياتكم؟

69
00:05:21,420 --> 00:05:26,130
تشاكا-ساما... سامحنا رجاءً
.لأنّنا فعلنا هذا دون استشارتك

70
00:05:26,130 --> 00:05:30,930
...لكن، يجب أن نجعله يدرك
...ألم هذه البلاد

71
00:05:49,750 --> 00:05:52,150
...أيّها... الأغبياء

72
00:05:52,850 --> 00:05:57,320
...يجب أن نجعله يدرك
...ما تشعر به هذه البلاد

73
00:06:02,330 --> 00:06:05,170
!من غضب

74
00:06:19,350 --> 00:06:21,480
.هذا ليس تصرّفًا ذكيًّا

75
00:06:22,220 --> 00:06:24,990
.يجب أن تقدّروا حياتكم

76
00:06:25,490 --> 00:06:27,320
.لكن أظنّ أنّ الأوان فات على قول هذا

77
00:06:33,790 --> 00:06:38,300
،إن كنتم ستموتون على أيّ حال
فلستُ بحاجة لقتلكم، صحيح؟

78
00:06:38,700 --> 00:06:41,170
!لن تقاتل حتّى؟

79
00:06:57,780 --> 00:06:59,850
...تشاكا-ساما

80
00:07:05,790 --> 00:07:09,300
.أنتم خير مثال على الغباء

81
00:07:10,700 --> 00:07:12,530
!أيّها الشّيطان اللّعين

82
00:07:16,700 --> 00:07:18,540
!أيّها الوغد

83
00:07:20,640 --> 00:07:21,880
!تشاكا

84
00:07:22,180 --> 00:07:26,510
!توقّف يا تشاكا! لا تتبعهم إلى التّهلكة

85
00:07:27,780 --> 00:07:29,280
...نوع زون

86
00:07:29,280 --> 00:07:33,450
!فاكهة الكلب، صنف ابن آوى

87
00:07:34,420 --> 00:07:36,260
!الأنياب العاوية

88
00:07:40,160 --> 00:07:46,400
إذًا فأنت أيضًا من النّوع
الّذي يموت لأجل الغير؟

89
00:08:00,880 --> 00:08:03,550
...سحقًا! نزفتُ كثيرًا

90
00:08:04,380 --> 00:08:07,590
أظنّني محظوظًا لأنّ الجراح
...ليست عميقة للغاية

91
00:08:07,590 --> 00:08:10,490
....لكنّها مؤلمة بحقّ

92
00:08:12,630 --> 00:08:14,230
...أتساءل كيف حال البقيّة

93
00:08:14,660 --> 00:08:16,560
...من الأفضل لهم ألاّ يموتوا

94
00:08:17,130 --> 00:08:18,970
...أريد أن أعرف ما يجري

95
00:08:19,770 --> 00:08:24,100
!ماذا؟! عليّ أن أشكّل ثنائيًّا مع رموش؟

96
00:08:25,670 --> 00:08:29,210
!إنّه جمل كما ترون

97
00:08:29,210 --> 00:08:32,050
!لا تستهن بمدى ضعفي

98
00:08:32,980 --> 00:08:35,850
لم يحالفك الحظّ في السّحب
!فحسب! تقبّل الأمر

99
00:08:35,850 --> 00:08:39,120
!حسنًا، عدني بشيءٍ واحد إذًا

100
00:08:39,120 --> 00:08:40,890
...إن وقعنا في ورطة

101
00:08:40,890 --> 00:08:42,490
!احرص على إنقاذنا رجاءً

102
00:08:42,490 --> 00:08:45,860
.غبيّ. أنا أنقذ الآنسات فحسب

103
00:08:48,600 --> 00:08:49,760
...أوسوبّ

104
00:08:52,800 --> 00:08:57,240
يا أوسوبّ. لماذا تبكي؟

105
00:08:57,240 --> 00:09:00,240
!من تقصد أنّه يبكي؟! يبكي؟

106
00:09:00,240 --> 00:09:02,510
من يزعم أنّ أحدًا يبكي
!هو من يبكي في الواقع

107
00:09:02,510 --> 00:09:04,010
.كلامك غير منطقيّ

108
00:09:04,440 --> 00:09:05,680
...لكن

109
00:09:06,550 --> 00:09:13,190
...قالت الخلد الشّمطاء
...أنّ لوفي مات، لذا

110
00:09:13,650 --> 00:09:15,660
...أ-أتساءل إن كان ذلك صحيحًا

111
00:09:16,420 --> 00:09:18,630
هل صدّقتما ذلك؟

112
00:09:19,160 --> 00:09:22,130
!بالطّبع لا! هل أنت غبيّ؟

113
00:09:22,130 --> 00:09:25,230
!ولا أنا! لا أصدّق ذلك إطلاقًا

114
00:09:26,670 --> 00:09:28,100
!مفهوم

115
00:09:28,100 --> 00:09:32,110
ما علينا فعله الآن هو الوصول
.إلى القصر بأسرع ما يمكننا

116
00:09:33,010 --> 00:09:37,310
.امسحا مخاطكما حتّى انتهاء هدير المعركة

117
00:09:39,380 --> 00:09:40,480
!لم أقل ابتلعه

118
00:09:44,020 --> 00:09:45,890
...شكرًا لكم... يا رفاق

119
00:09:46,750 --> 00:09:48,360
.من المبكّر شكرنا

120
00:09:48,690 --> 00:09:52,190
معه حقّ. كما أنّك إن أردت
...شكر قراصنة

121
00:09:52,190 --> 00:09:54,060
.عليك أن تعطينا بعض المال

122
00:09:54,060 --> 00:09:57,330
!فقط كم تنوين السّحب من هذه البلاد؟

123
00:09:58,000 --> 00:10:01,670
هل نامي بخير؟
هل تمكّنت من الهروب...؟

124
00:10:09,310 --> 00:10:10,740
...نجحت أخيرًا

125
00:10:11,140 --> 00:10:15,720
هذا ما كان يقصده بهجومٍ واحد قويّ؟

126
00:10:16,950 --> 00:10:20,420
...موجة المتمرّدين قريبة بالفعل

127
00:10:24,930 --> 00:10:26,560
.مع أنّ الوضع تغيّر

128
00:10:27,060 --> 00:10:28,960
.عليّ الذّهاب للقصر على أيّ حال

129
00:10:34,070 --> 00:10:37,640
ماذا يجري مع فيفي...؟
...يبدو أنّ المعركة بدأت

130
00:10:39,440 --> 00:10:43,010
.بالمناسبة يا فيفي-تشان
.عليك تذكّر هذا

131
00:10:43,710 --> 00:10:47,010
عقب أيّ معركة... يأكل ذلك
...الشّخص بشراهة

132
00:10:47,710 --> 00:10:48,550
.نعم

133
00:10:49,020 --> 00:10:51,620
!سننتظرك في ألوبارنا، اتّفقنا؟

134
00:10:51,620 --> 00:10:54,990
!أجل

135
00:10:54,990 --> 00:10:57,260
.حسنًا، ستكون هذه النّقطة الفيصل

136
00:10:59,660 --> 00:11:00,960
!لا مجال للإخفاق

137
00:11:01,500 --> 00:11:05,100
!هيّا بنا! لنتقابل في قصر ألوبارنا

138
00:11:20,780 --> 00:11:21,850
!تشاكا

139
00:11:27,820 --> 00:11:31,760
...الضّعف... جريمة

140
00:11:35,560 --> 00:11:36,600
!فيفي

141
00:12:07,930 --> 00:12:09,960
!كـ... كوزا

142
00:12:17,200 --> 00:12:21,110
أنت... فهمت، أتيت من الطّريق
...المختصر الّذي اعتدتَ استخدامه

143
00:12:22,680 --> 00:12:25,080
هل هناك خطب في عينيّ؟

144
00:12:35,760 --> 00:12:39,030
...أتيتُ لإقناع الجيش الملكيّ، لكن

145
00:12:41,400 --> 00:12:42,260
...تشاكا

146
00:12:43,760 --> 00:12:48,900
والملك... على وشك أن يُقتل
...على يد بطل البلاد

147
00:12:49,270 --> 00:12:51,470
!يصعب عليّ تصديق ما أراه

148
00:12:54,470 --> 00:12:56,810
!أصبح الوضع مثيرًا للاهتمام

149
00:12:57,380 --> 00:12:59,850
،أنتم في خضمّ المعركة الآن

150
00:12:59,850 --> 00:13:04,480
إلاّ أنّ قائدَي الطّرفين
.يواجهان بعضهما هنا

151
00:13:04,480 --> 00:13:09,460
باتت هذه الحرب قتالاً حتّى
.الموت بين سحالي قُطع رأسها

152
00:13:12,190 --> 00:13:16,360
...يبدو أنّك مشوّش. هذا ردّ فعل طبيعيّ

153
00:13:16,730 --> 00:13:17,730
.لكنّ الأمر بسيط

154
00:13:19,270 --> 00:13:23,870
.فقط تخيّل أسوأ مآلٍ ممكن

155
00:13:28,280 --> 00:13:31,480
.لا ترتب يا كوزا

156
00:13:39,090 --> 00:13:40,890
هل تحبّ هذه البلاد؟

157
00:13:49,560 --> 00:13:51,830
!نعم! لقد وُلدتُ فيها

158
00:13:52,800 --> 00:13:54,330
!وأنا أيضًا

159
00:13:57,770 --> 00:13:59,010
...كوزا، اسمع

160
00:13:59,010 --> 00:14:02,880
!فيفي! من سلب الشّتاء عن هذه البلاد؟

161
00:14:04,950 --> 00:14:06,110
...كلّ شيء كان

162
00:14:06,580 --> 00:14:08,220
.كان أنا يا كوزا

163
00:14:09,780 --> 00:14:13,920
كلّ ما ظننت أنّه من فعل الملك

164
00:14:14,420 --> 00:14:17,090
.كان في الواقع "فخًّا" من شركتي

165
00:14:17,420 --> 00:14:22,800
،خلال العامين المنصرمين
...كنتم تحت سيطرتنا التّامّة

166
00:14:23,900 --> 00:14:29,600
بينما كانت العائلة المالكة
.والجيش يلاحقون ظلالنا باستماتة

167
00:14:35,480 --> 00:14:40,150
ربّما أمكنك أن تموت سعيدًا
...لو لم تعرف بهذه الحقائق

168
00:14:46,950 --> 00:14:49,190
!لا تصغ إليه يا كوزا

169
00:14:50,520 --> 00:14:51,530
...الملك

170
00:14:51,990 --> 00:14:54,330
!ما زال هناك ما تستطيع فعله

171
00:14:54,800 --> 00:14:57,500
!أنقذ أكبر عددٍ ممكن من الشّعب

172
00:14:59,100 --> 00:15:04,440
...فبعد أقلّ من نصف ساعة
!سيُفجّر ميدان القصر

173
00:15:04,810 --> 00:15:06,040
!ماذا؟

174
00:15:06,510 --> 00:15:08,640
...ما زلتَ حيًّا إذًا

175
00:15:13,450 --> 00:15:16,320
!أسرع

176
00:15:27,360 --> 00:15:28,630
!لا

177
00:15:30,930 --> 00:15:32,000
!...فيفي

178
00:15:32,630 --> 00:15:35,540
!تنحّي عنّي يا فيفي! ماذا تفعلين؟

179
00:15:35,540 --> 00:15:38,940
.سيصبح الميدان ساحة معركة
...إن انفجر حقًّا

180
00:15:38,940 --> 00:15:42,240
!لن... لن أدعه يصبح ساحة معركة

181
00:15:45,880 --> 00:15:48,750
!ما زلت هلعًا

182
00:15:49,050 --> 00:15:51,250
ماذا تظنّ سيحدث

183
00:15:51,250 --> 00:15:53,920
!إن عرفوا الآن أنّ الميدان سيُفجّر؟

184
00:15:53,920 --> 00:15:57,090
!لن يبثّ ذلك الدّعر وحده

185
00:15:57,720 --> 00:16:02,460
فور أن يحدث ذلك، لن تتوقّف
!الحرب! ولن يُنقَذ أيّ أحد

186
00:16:06,730 --> 00:16:08,000
أليس كذلك؟

187
00:16:10,040 --> 00:16:12,370
...يا له من حكم حذق

188
00:16:12,810 --> 00:16:15,780
سبق وتقرّر ما على عاتقنا
!فعله من البداية

189
00:16:18,580 --> 00:16:21,680
!وهو إيقاف هذا التّمرّد المدبّر

190
00:16:23,280 --> 00:16:27,290
!وأنت الوحيد الّذي يستطيع فعل ذلك

191
00:16:45,440 --> 00:16:46,410
...فيفي

192
00:16:52,410 --> 00:16:57,420
وهل تظنّان أنّني سأقف متفرّجًا فحسب؟

193
00:17:09,000 --> 00:17:10,000
!تشاكا

194
00:17:12,700 --> 00:17:16,500
!أنا ابن آوى، إله أراباستا الحارس

195
00:17:16,840 --> 00:17:19,740
!ومدمّر أعداء العائلة المالكة

196
00:17:26,080 --> 00:17:29,320
!سأقاتل ما دام فيّ عرق ينبض

197
00:17:30,180 --> 00:17:32,950
.هذا ما نسمّيه بالغباء

198
00:17:32,950 --> 00:17:35,560
!افعلا ما على عاتقكما أنتما الاثنان

199
00:17:35,560 --> 00:17:38,490
أظنّني أستطيع أن أصدّه
!لبضع دقائق أخرى على الأقلّ

200
00:17:39,560 --> 00:17:40,460
!حسنًا

201
00:17:42,060 --> 00:17:43,260
!تشاكا

202
00:17:43,260 --> 00:17:46,430
.أظنّ أنّ قائد جماعة الرّمل ليس قويًّا جدًّا

203
00:17:50,870 --> 00:17:52,370
ما الخطب الآن؟

204
00:17:57,510 --> 00:17:59,450
!هذا مؤلم

205
00:18:00,410 --> 00:18:03,920
!ما قصّتك؟! أنت تتصرّف بصبيانيّة
!تريّث معي

206
00:18:03,920 --> 00:18:05,650
.أنت مزعج

207
00:18:07,390 --> 00:18:10,420
.أنت من طلب منّي أن أدرّبك

208
00:18:25,270 --> 00:18:27,610
!تقرير من وحدة الحراسة 2 إلى المقرّ

209
00:18:28,440 --> 00:18:30,080
!من وحدة الحراسة 2 إلى المقرّ

210
00:18:30,510 --> 00:18:33,580
!لقد اختُرقَ... الخطّ 4

211
00:18:41,090 --> 00:18:44,560
إنّ جيش المتمرّدين يمرّ حاليًّا عبر
!السّاحة المركزيّة صوب المجمّع الشّماليّ

212
00:18:44,560 --> 00:18:46,430
!سيبلغون القصر

213
00:18:54,940 --> 00:18:58,640
!استسلموا الآن أيّها الجيش الملكيّ

214
00:18:59,110 --> 00:19:01,380
!فيفي-ساما! ما الّذي تقوله؟

215
00:19:01,380 --> 00:19:02,680
!نستسلم؟

216
00:19:02,680 --> 00:19:06,080
!ماذا عساه يحلّ ببلادنا إن فعلنا ذلك؟

217
00:19:06,680 --> 00:19:09,550
!...انظروا! ذلك

218
00:19:09,980 --> 00:19:14,250
إنّه كوزا! لِمَ قائد جيش المتمرّدين هنا؟

219
00:19:14,860 --> 00:19:17,060
!أصغوا لفيفي

220
00:19:17,720 --> 00:19:21,060
!ما عدنا نبتغي النّصر أو القتال

221
00:19:21,360 --> 00:19:24,060
!أريدكم أن توقفوا هذا القتال

222
00:19:24,360 --> 00:19:26,630
!ماذا؟! ما الّذي يجري؟

223
00:19:27,730 --> 00:19:33,340
سوف أُبلغ جيش المتمرّدين
...أنّ هذا القتال كان بلا أيّ معنى

224
00:19:34,170 --> 00:19:37,610
!وأنّه ما عاد لنا سبب للقتال

225
00:19:44,150 --> 00:19:45,250
!أرجوكم

226
00:19:51,020 --> 00:19:53,990
!بات رأس الملك في متناولنا

227
00:19:54,230 --> 00:19:57,460
!نعم! بات برج السّاعة أمام ناظرنا

228
00:20:03,440 --> 00:20:05,740
!إنّنا نقترب من ميدان القصر

229
00:20:06,640 --> 00:20:09,040
!تأهّبوا للهجوم

230
00:20:22,190 --> 00:20:23,690
!ا-انتظروا

231
00:20:31,300 --> 00:20:32,770
!رايات بيضاء؟

232
00:20:42,740 --> 00:20:44,180
!كوزا-سان

233
00:20:44,580 --> 00:20:46,080
!إ-إنّه كوزا-سان

234
00:20:46,080 --> 00:20:47,880
ما الّذي يفعله كوزا-سان هنا؟

235
00:20:47,880 --> 00:20:50,080
كوزا-سان؟ ما الّذي يفعله هنا؟

236
00:20:50,080 --> 00:20:51,150
لماذا؟

237
00:20:51,690 --> 00:20:54,090
!انتهى القتال

238
00:20:54,720 --> 00:20:58,730
!جميعًا! أخمدوا غضبكم واخفضوا أسلحتكم

239
00:21:00,060 --> 00:21:03,760
!ما عاد الجيش الملكيّ يملك رغبةً للقتال

240
00:21:06,870 --> 00:21:08,400
!...توقّفوا رجاءً

241
00:21:37,660 --> 00:21:39,670
!أهذا صحيح...؟ كوزا-سان...؟

242
00:21:40,030 --> 00:21:42,740
...أجل... هذه المعركة

243
00:22:01,360 --> 00:22:06,030
!كوزا

244
00:22:20,640 --> 00:22:26,750
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

245
00:22:26,750 --> 00:22:32,690
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

246
00:22:32,690 --> 00:22:38,930
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

247
00:22:38,930 --> 00:22:44,360
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

248
00:22:44,360 --> 00:22:50,600
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

249
00:22:50,600 --> 00:22:56,040
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

250
00:22:56,810 --> 00:22:59,810
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

251
00:22:59,810 --> 00:23:03,580
دعنا نرسم قصّة المستقبل

252
00:23:03,580 --> 00:23:08,820
سأضع كلّ مشاعري
في رياح جديدة تمامًا الآن

253
00:23:08,820 --> 00:23:11,830
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

254
00:23:11,830 --> 00:23:14,830
رحلة لا نهاية لها لنكون معًا

255
00:23:14,830 --> 00:23:20,030
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

256
00:23:25,340 --> 00:23:29,180
.أفيقي يا سموّ الأميرة
.لا يمكنك إنقاذ هذه البلاد

257
00:23:29,180 --> 00:23:32,480
...ما عاد صوتي يصل إلى أيّ أحد

258
00:23:32,480 --> 00:23:34,480
...إلّم نفعل شيئًا، فهذه البلاد سوف

259
00:23:34,480 --> 00:23:37,880
.لا تقلقي! صوتك يصلنا نحن

260
00:23:37,880 --> 00:23:38,650
!لوفي-سان

261
00:23:38,990 --> 00:23:41,050
!سأضع نهايةً... لكلّ هذا

262
00:23:41,420 --> 00:23:42,790
:في الحلقة القادمة من ون بيس

263
00:23:42,790 --> 00:23:45,960
!حيث يُسمع صوت فيفي"
"!هبوط البطل

264
00:23:45,960 --> 00:23:48,260
!ملك القراصنة، لن يكون إلاّ أنا