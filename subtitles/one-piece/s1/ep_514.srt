1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,910
"وأقول "أريد أن أصير أقوى

5
00:00:47,910 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,830 --> 00:03:23,980
أدرك لوفي اليائس بعد فقدانه لأخيه
إيس في الحرب ضدّ البحريّة

38
00:03:25,060 --> 00:03:29,700
.أهمّيّة الصّداقة وبعث رسالة لطاقمه

39
00:03:35,000 --> 00:03:39,430
"!العيش في الجحيم! قتال سانجي من أجل رجولته"

40
00:03:42,060 --> 00:03:45,880
...على جزيرة السّماء الصّغير ويذاريا

41
00:03:46,300 --> 00:03:48,010
!ها هي هناك

42
00:03:48,010 --> 00:03:49,660
!وجدناها أخيرًا

43
00:03:49,660 --> 00:03:51,350
كيف أمكنك خداعنا؟

44
00:03:51,350 --> 00:03:54,700
...لم تسرقي ملاحظات بحوثنا فحسب

45
00:03:54,700 --> 00:03:56,890
...لكنّك تلاعبتِ أيضًا

46
00:03:56,890 --> 00:03:58,630
!بقلوبنا النّقيّة

47
00:03:58,630 --> 00:04:00,800
!سلّمي نفسك حالاً

48
00:04:00,800 --> 00:04:02,960
!أيّتها الفتاة اللّصّة

49
00:04:02,960 --> 00:04:04,270
.حسنًا

50
00:04:05,130 --> 00:04:06,650
!ملاحظات بحوثنا

51
00:04:06,650 --> 00:04:07,760
!كرة الطّقس

52
00:04:07,760 --> 00:04:09,860
!والسّيّد هارداس الرّهينة

53
00:04:09,860 --> 00:04:12,990
!تصرّفاتك لا تغتفر حتّى وإن أعدت كلّ شيء

54
00:04:13,330 --> 00:04:15,450
.أنا آسفة. أنا نادمة على ما فعلت

55
00:04:15,450 --> 00:04:17,500
!كلاّ، لا يمكننا أن نثق بها

56
00:04:17,500 --> 00:04:20,210
!جرّدوها حتّى من ملابسها وانفوها

57
00:04:20,510 --> 00:04:24,500
...ذلك... بذيء

58
00:04:24,500 --> 00:04:26,630
!ماذا؟ بذيء؟

59
00:04:27,360 --> 00:04:28,670
...بذيء

60
00:04:28,670 --> 00:04:34,200
!لا، لا، لا، لا! ذلك لم يكن قصدي
...ما كنت أقصده هو

61
00:04:34,200 --> 00:04:37,810
!لقد غيّرت الموضوع... لقد غيّرت الموضوع

62
00:04:37,810 --> 00:04:38,830
!تبًّا

63
00:04:38,830 --> 00:04:40,480
هل شتمتِ للتّوّ؟

64
00:04:40,480 --> 00:04:43,350
!كلاّ! كم هذا فظيع! هذه تهمة ظالمة

65
00:04:43,350 --> 00:04:45,130
!نعم، كان ذلك مبالغًا فيه

66
00:04:45,130 --> 00:04:49,080
!أكانت غلطتي؟! ألم تسمعوا ذلك؟

67
00:04:49,080 --> 00:04:49,700
...لا أظنّ

68
00:04:49,700 --> 00:04:50,950
!لا تسمحوا لها بخداعكم

69
00:04:50,950 --> 00:04:53,490
!لا بدّ أنّه كان خطأ! ما كنت لأفعل شيئًا كهذا

70
00:04:53,490 --> 00:04:56,910
...ر-ربّما أخطأت السّمع

71
00:04:57,560 --> 00:05:00,080
.إنّها تتلاعب بهم كخاتم في إصبعها

72
00:05:00,410 --> 00:05:01,620
!إنّها شرّيرة

73
00:05:01,620 --> 00:05:04,170
!لنطردها في الحال

74
00:05:04,170 --> 00:05:06,660
!كلاّ! أنا آسفة! أنا نادمة على ما فعلت

75
00:05:06,660 --> 00:05:09,000
!كيف لنا أن نصدّقك؟

76
00:05:09,000 --> 00:05:14,090
،نعم، أفهم مقصدكم. سأريكم كم أنّني آسفة

77
00:05:14,530 --> 00:05:17,430
.وسأقفز في الماء

78
00:05:17,430 --> 00:05:20,310
!سامحوني رجاءً في الحياة الأخرى

79
00:05:20,960 --> 00:05:22,350
!الوداع

80
00:05:22,350 --> 00:05:24,020
!جعلناها تبكي

81
00:05:24,020 --> 00:05:25,560
!لا تتسرّعي

82
00:05:25,560 --> 00:05:29,150
!ما زلت صغيرة لتضعي حدًّا لحياتك

83
00:05:29,800 --> 00:05:30,920
!الوداع

84
00:05:30,920 --> 00:05:32,320
!نحن آسفون

85
00:05:33,880 --> 00:05:35,910
!حسنًا، أنا أسامحكم

86
00:05:37,530 --> 00:05:41,900
!والآن، سأمكث هنا وقتًا أطول وسأدرس الطّقس

87
00:05:41,900 --> 00:05:44,330
.اسمي نامي. بإمكانكم مناداتي نامي-سان

88
00:05:44,670 --> 00:05:48,460
.أحتاج لمنزل أعيش فيه
.يحتاج الجميع للخصوصيّة

89
00:05:48,820 --> 00:05:53,130
إضافة إلى سرير جيّد ومريح
!وحوض استحمام وخزانة كبيرة أيضًا

90
00:05:53,450 --> 00:05:56,180
!شكرًا لكم يا أجداد السّماء

91
00:05:56,180 --> 00:05:59,470
!حسنًا، لنبذل جهدنا! أجل

92
00:05:59,470 --> 00:06:02,180
!ساعدنا يا سيّد هارداس! بسرعة

93
00:06:02,810 --> 00:06:04,640
...يا إلهي

94
00:06:18,410 --> 00:06:21,800
.كنتِ متلهّفة لمغادرة هذه الجزيرة من قبل

95
00:06:21,800 --> 00:06:24,960
ما الّذي جعلك تغيّرين رأيك؟

96
00:06:24,960 --> 00:06:27,830
.ثمّة أمور كثيرة تحدث هنا
هلاّ أخبرتني عنها الآن؟

97
00:06:27,830 --> 00:06:29,890
.حسنًا، موافق

98
00:06:30,290 --> 00:06:36,220
تتنقّل ويذاريا بفضل الرّياح
.وتتجوّل في أرجاء سماء العالم

99
00:06:36,220 --> 00:06:40,760
ننزل أحيانًا للحصول على المؤن والمعلومات

100
00:06:40,760 --> 00:06:42,520
.ثمّ نواصل طريقنا

101
00:06:42,520 --> 00:06:43,680
معلومات؟

102
00:06:43,680 --> 00:06:46,350
.نعم، لنتحقّق من السّجلاّت

103
00:06:46,350 --> 00:06:50,640
ما زال هنالك العديد من حالات الطّقس
والظّواهر المجهولة

104
00:06:50,640 --> 00:06:53,230
!يصعب استيعابها

105
00:06:53,230 --> 00:06:53,940
!ما هذا؟

106
00:06:53,940 --> 00:06:55,360
هل تستمعين؟

107
00:06:55,360 --> 00:06:57,970
!ماذا؟ هذا غير معقول

108
00:06:57,970 --> 00:06:59,620
!صواعق برق كالمطر؟

109
00:06:59,620 --> 00:07:03,370
.نعم، إنّها كالمطر بالفعل

110
00:07:03,370 --> 00:07:06,250
.هكذا يضرب البرق تلك الجزيرة

111
00:07:06,250 --> 00:07:09,320
.إنّها تقع في العالم الجديد

112
00:07:09,320 --> 00:07:12,090
،إن كنت تنوين الذّهاب لذلك البحر

113
00:07:12,090 --> 00:07:16,630
.عليك فتح عقلك لغير المتوقّع

114
00:07:18,220 --> 00:07:19,760
!إنّه عالم كبير

115
00:07:21,220 --> 00:07:24,020
،أتوسّل إليك. علّمني يا هارداس-سان

116
00:07:24,550 --> 00:07:26,600
...علّمني كلّ شيء تعرفه

117
00:07:28,350 --> 00:07:30,040
!عن الطّقس في العالم الجديد

118
00:07:30,810 --> 00:07:32,690
.أنت يائسة

119
00:07:32,690 --> 00:07:36,940
!بالطّبع أنا كذلك! حياة كلّ أصدقائي بين يديّ

120
00:07:37,250 --> 00:07:39,200
!أنا ملاّحة

121
00:07:39,200 --> 00:07:41,990
!عليّ تولّي المسؤوليّة ونحن على متن السّفينة

122
00:07:42,510 --> 00:07:46,910
!عليّ إرشادهم إلى الطّريق الّذي يختاره قبطاني

123
00:07:52,880 --> 00:07:56,420
.يريد لوفي أن يصير ملك القراصنة

124
00:07:56,420 --> 00:08:00,300
!لذلك عليّ تحسين مهاراتي كملاّحة

125
00:08:01,220 --> 00:08:06,320
لا بدّ أنّ قبطانك سعيد لامتلاكه
.عضوة طاقم حريصة مثلك

126
00:08:07,670 --> 00:08:08,980
.لا خيار آخر لديّ

127
00:08:08,980 --> 00:08:10,100
لا خيار لديك؟

128
00:08:10,100 --> 00:08:16,150
.نعم. إنّه متبجّح كثيرًا، لكنّه يجهل كلّ شيء عن البحر

129
00:08:25,720 --> 00:08:30,250
.يقوم بأمور سخيفة دائمًا
...إن تركته وحيدًا

130
00:08:33,080 --> 00:08:34,460
...لوفي

131
00:08:35,840 --> 00:08:37,380
...ساعدني

132
00:08:43,890 --> 00:08:46,430
!بالطّبع سأفعل

133
00:08:50,890 --> 00:08:53,900
.إن تركته وحيدًا، فسينتهي به الأمر ميتًا على الأرجح

134
00:08:56,480 --> 00:08:59,650
!إنّه غبيّ نوعًا ما ومتعِب في التّعامل معه

135
00:09:01,530 --> 00:09:03,660
.لا بدّ أنّ من الصّعب امتلاك قبطان مثله

136
00:09:04,490 --> 00:09:08,160
.نعم. لهذا السّبب أريد مساعدته

137
00:09:09,500 --> 00:09:11,460
.كما ساعدني هو

138
00:09:11,460 --> 00:09:14,380
.حسنًا، أخبرني عن كرة الطّقس

139
00:09:14,380 --> 00:09:19,010
.الأمر ليس بتلك البساطة
!إنّها من أعظم ابتكارات ويذاريا

140
00:09:19,010 --> 00:09:23,180
إن أسأت استعمالها، فقد تقلب
!العالم رأسًا على عقب

141
00:09:23,180 --> 00:09:25,240
أيمكن استعمالها كسلاح؟

142
00:09:25,240 --> 00:09:28,470
.مهلاً، مهلاً، ذلك خطير جدًّا

143
00:09:28,470 --> 00:09:29,920
!لا تبتسمي هكذا

144
00:09:42,650 --> 00:09:44,780
!نامي

145
00:09:44,780 --> 00:09:48,490
!أنت صديقتي أنا

146
00:10:14,980 --> 00:10:21,650
في تلك الأثناء في الغراند لاين في أرض
...المستقبل بالديمور على جزيرة كاراكوري

147
00:10:22,320 --> 00:10:26,160
!حدث انفجار غير المتوقّع في مختبر الدّكتور فيغابانك

148
00:10:26,910 --> 00:10:29,700
!لم نعثر بعد على الفاعل

149
00:10:29,700 --> 00:10:31,670
!هيّا، بسرعة

150
00:10:35,750 --> 00:10:39,000
لن تكون مبالغة إن قلنا أنّها كانت
!من أكبر الخسائر في زماننا

151
00:10:39,410 --> 00:10:41,570
هل لديكم أيّ معلومات؟

152
00:10:41,570 --> 00:10:45,550
.سمعتُ أنّ هنالك متسلّلاً يشبه الغوريلاّ

153
00:10:45,550 --> 00:10:48,300
!كم هذا غامض

154
00:10:48,300 --> 00:10:54,140
بهدف الوصول إلى ميناء هذه
.الجزيرة، يحتاج المرء إلى كاسحة جليد

155
00:10:54,620 --> 00:10:56,890
.لكن لم ير أيّ أحد واحدة منها

156
00:10:57,600 --> 00:11:02,230
يُقال أنّ المتسلّل كان السّايبورغ
،فرانكي من قراصنة قبّعة القشّ

157
00:11:02,940 --> 00:11:07,950
لكنّه شوهد في أرخبيل شابوندي
...خلال الشّهر الماضي فحسب

158
00:11:07,950 --> 00:11:10,990
.لا ندري كيف من الممكن أن يصل إلى بالديمور

159
00:11:10,990 --> 00:11:14,830
أيّها النّقيب غوريلاّ! سيغادر
!فريق البحث إلى الجبال

160
00:11:14,830 --> 00:11:16,960
!حسنًا! سآتي معهم

161
00:11:17,920 --> 00:11:19,040
!...هـ-هذه

162
00:11:19,040 --> 00:11:22,250
.كُشف المدخل الخفيّ بعد الانفجار

163
00:11:22,250 --> 00:11:25,630
.يا لها من مفاجأة
.لم نكن نعرف بشأن هذا المكان

164
00:11:27,320 --> 00:11:29,510
.لا أصدّق هذا

165
00:11:29,510 --> 00:11:32,930
!كان هنالك مختبر آخر

166
00:11:33,760 --> 00:11:38,310
لا بدّ أنّ الحيوانات السّايبورغ
.العاملة قد صُنعت هنا

167
00:11:40,440 --> 00:11:41,790
!أنت، لا تكسرها

168
00:11:41,790 --> 00:11:43,820
!لا يمكنك التّحدّث معي هكذا

169
00:11:44,290 --> 00:11:46,900
،في المختبر الّذي انفجر

170
00:11:46,900 --> 00:11:51,040
كانت هنالك ابتكارات غير تقليديّ
.مفيدة في الحياة اليوميّة

171
00:11:51,620 --> 00:11:56,020
،لكن ما أردت معرفته هي ابتكارات الأسلحة

172
00:11:56,020 --> 00:11:58,330
.كالموجودة هنا

173
00:12:00,710 --> 00:12:05,710
هذا مذهل! كلّ شيء ابتداءً من السّفن
...الحربيّة إلى الخلايا البشريّة

174
00:12:05,710 --> 00:12:08,590
كيف فكّر في كلّ هذه الأشياء؟

175
00:12:11,050 --> 00:12:13,390
!حسنًا! اتّخذت قراري

176
00:12:14,140 --> 00:12:15,310
!سأعيش هنا

177
00:12:15,310 --> 00:12:16,770
!ماذا؟ هنا؟

178
00:12:16,770 --> 00:12:17,750
!نعم

179
00:12:19,640 --> 00:12:22,480
سأنزل من الجبل من وقت لآخر

180
00:12:22,480 --> 00:12:24,440
.للحصول على الكولا من منزلكما

181
00:12:24,440 --> 00:12:25,680
أهذا ممكن؟

182
00:12:26,570 --> 00:12:28,440
!لا داعي للقلق

183
00:12:28,440 --> 00:12:30,510
،ما دمتما لن تخبرا أيّ أحد

184
00:12:30,510 --> 00:12:34,070
.فلن أتسبّب لكم بالمشاكل لأنّني سأعيش هنا

185
00:12:34,530 --> 00:12:37,360
!لا تهلعوا في كلّ مرّة ترون فيها وجهي

186
00:12:37,360 --> 00:12:38,710
!لا تنظر إلينا

187
00:12:38,710 --> 00:12:39,790
!صار ذلك الوجه المخيف مخيفًا أكثر

188
00:12:39,790 --> 00:12:42,510
!ما رأيكم بهذا؟ بساط نمر

189
00:12:44,170 --> 00:12:45,460
...ليس سيّئًا

190
00:12:45,460 --> 00:12:47,130
!فـ-فـ-فرانكي

191
00:12:48,560 --> 00:12:50,550
.أشعر بالبرد، وخاصّة رجلاي

192
00:12:50,550 --> 00:12:51,800
لماذا لا ترتدي سروالك؟

193
00:12:54,210 --> 00:12:56,390
!حسنًا، صار الجوّ دافئًا الآن

194
00:12:56,390 --> 00:12:58,180
لماذا لا ترتدي سروالاً فحسب؟

195
00:12:58,180 --> 00:13:01,850
لكنّك قلت أنّك تريد مغادرة هذه
الجزيرة. فما الّذي حدث؟

196
00:13:03,330 --> 00:13:05,150
...حسنًا، ليس الكثير

197
00:13:09,000 --> 00:13:10,970
...لكنّ حلمي

198
00:13:12,440 --> 00:13:16,120
...أريدكم أن تبحروا على السّفينة

199
00:13:16,120 --> 00:13:18,290
!الّتي سأبنيها

200
00:13:19,020 --> 00:13:20,430
...لوفي

201
00:13:21,250 --> 00:13:25,800
.جعلتني أتبنّى حُلمًا

202
00:13:27,290 --> 00:13:28,960
!فرانكي

203
00:13:30,150 --> 00:13:32,690
!شكرًا على السّفينة

204
00:13:32,690 --> 00:13:35,850
!إنّها أفضل سفينة على الإطلاق! سنعتني بها جيّدًا

205
00:13:36,400 --> 00:13:39,270
إن كنت تريدني أن أعيد لك
،لباس السّباحة هذا

206
00:13:39,650 --> 00:13:42,070
!انضمّ لنا

207
00:13:42,770 --> 00:13:48,560
!أحضرتني إلى هذا العالم الكبير

208
00:13:51,120 --> 00:13:57,160
.سنعبر بحارًا عديدة ونخوض تحدّيات ومعارك كثيرة

209
00:13:57,830 --> 00:14:00,980
،وعندما نبلغ نهاية البحر

210
00:14:00,980 --> 00:14:04,990
."فسأسمّيها "سفينة الأحلام

211
00:14:07,130 --> 00:14:08,820
.يا لوفي

212
00:14:09,550 --> 00:14:12,880
.ما زالت حياة ثاوزند ساني طويلة

213
00:14:14,140 --> 00:14:16,930
...أنت هو القبطان الوحيد الّذي يمكنه جعلها

214
00:14:18,000 --> 00:14:19,640
."سفينة الأحلام"

215
00:14:21,700 --> 00:14:26,850
سأمتلك المهارات الّتي ستسمح لنا

216
00:14:27,780 --> 00:14:29,590
.بخوض مغامرات مروّعة أكثر من ذي قبل

217
00:14:29,590 --> 00:14:31,110
!...لذلك يا لوفي

218
00:14:33,030 --> 00:14:35,490
.مهلاً، النّمر يحترق

219
00:14:39,740 --> 00:14:41,880
...هذا ساخن، ساخن، ساخن

220
00:14:43,370 --> 00:14:45,040
!ما هذا؟

221
00:14:45,040 --> 00:14:46,830
!وحش؟! انتبهوا

222
00:14:59,640 --> 00:15:05,330
لذلك يا لوفي، علينا أن نعبر بحر
!العالم الجديد العاتي

223
00:15:08,980 --> 00:15:12,240
ستُعرف هذه الحادثة في الغراند لاين

224
00:15:12,240 --> 00:15:16,240
.بأسطورة وحش بالديمور المقدّس المحترق

225
00:15:33,380 --> 00:15:36,550
...في مملكة كاماباكّا في الغراند لاين

226
00:15:36,550 --> 00:15:40,390
أخبرني، ما الّذي قرأته في الصّحيفة؟

227
00:15:40,550 --> 00:15:41,720
!فهمت

228
00:15:42,010 --> 00:15:44,560
.صرتَ هادئًا فجأة

229
00:15:44,560 --> 00:15:50,160
تلقّيت رسالة من لوفي
،ما كان ليفهمها إلاّ أصدقاؤه

230
00:15:50,160 --> 00:15:52,150
.من تلك الصّحيفة

231
00:15:52,150 --> 00:15:56,400
،إن كنت لا تصدّق أنّني صديقه
!فلن أخبرك أيّها الغبيّ

232
00:15:56,400 --> 00:15:57,740
!هذا الرّجل مزعج

233
00:16:00,410 --> 00:16:02,910
مهلاً، من أعدّ هذه الوجبة؟

234
00:16:02,910 --> 00:16:06,580
!لديك حاسّة تذوّق مميّزة بالفعل

235
00:16:06,890 --> 00:16:12,210
إنّ مذاقها جيّد، وأشعر أنّ جسدي
!مفعم بالطّاقة بشكل غريب

236
00:16:14,000 --> 00:16:16,630
!هذا صحيح! إنّه الطّبخ الهجوميّ

237
00:16:17,800 --> 00:16:20,650
ثمّة الكثير من الطّهاة بإمكانهم
!إعداد ذلك على هذه الجزيرة

238
00:16:20,650 --> 00:16:24,020
!نعم

239
00:16:24,970 --> 00:16:30,100
!انظر لهذه الأجسام القويّة الجميلة لهؤلاء الكاندي

240
00:16:30,100 --> 00:16:32,230
.إضافة لقلوبهم اللّطيفة

241
00:16:32,890 --> 00:16:36,860
صار هؤلاء الكاندي هكذا عن طريق
!أكل الطّبخ الهجوميّ

242
00:16:37,530 --> 00:16:40,030
فما يأكله المرء مهمّ لوضعه

243
00:16:40,030 --> 00:16:42,240
!وجسده وشخصيّته

244
00:16:42,240 --> 00:16:45,120
!إنّه يبني الجسد البشريّ بالكامل

245
00:16:45,490 --> 00:16:49,250
...إن شرب كلّ سكّان العالم الحليب كلّ يوم

246
00:16:53,210 --> 00:16:55,940
فسيكون هنالك جرائم أقلّ، ألا توافقني؟

247
00:16:56,500 --> 00:17:00,510
!لذلك، من الجيّد أن نكون هجوميّين

248
00:17:01,290 --> 00:17:06,680
.طعام يبني الجسد؟ لم أفكّر في ذلك من قبل

249
00:17:07,380 --> 00:17:12,240
.أستطيع مساعدتهم لبناء أجسادهم بوجبات يوميّة

250
00:17:15,560 --> 00:17:16,900
،لكن إضافة لذلك

251
00:17:16,900 --> 00:17:21,610
ماذا سأفعل إن صار جسدا نامي-سان
!وروبين-تشان أكثر جاذبيّة من الآن

252
00:17:21,970 --> 00:17:23,530
!ماذا سنفعل بهذا الرّجل؟

253
00:17:23,530 --> 00:17:25,280
!ماذا سأفعل؟

254
00:17:25,790 --> 00:17:27,280
!أنا أشتعل شغفًا

255
00:17:27,280 --> 00:17:30,000
!علّموني كيف أطبخ الطّبخ الهجوميّ

256
00:17:30,000 --> 00:17:32,830
!"الإجابة هي "لا

257
00:17:34,540 --> 00:17:35,920
...هذا مؤلم

258
00:17:35,920 --> 00:17:39,340
!يا لها من فكرة حلوة لكن لا تحلم

259
00:17:39,340 --> 00:17:42,590
..."هذه "الوصفات الحيويّة الـ99

260
00:17:42,590 --> 00:17:48,140
جزء من تقنيات كينبو النيوكاما، تدريب
!الحياة الزّوجيّة، المتوارث في مملكة كاماباكّا

261
00:17:48,140 --> 00:17:53,230
!لا أستطيع تعليمه لنكرة مثلك

262
00:17:53,230 --> 00:17:56,350
...إن كنت تريد تعلّمه، عليك امتلاك قلب أنثويّ

263
00:17:57,260 --> 00:17:59,550
!وتعلّم كينبو النيوكاما

264
00:18:00,700 --> 00:18:02,110
!مستحيل

265
00:18:03,320 --> 00:18:07,860
.لم أولد لأكون صديقًا للنّساء

266
00:18:07,860 --> 00:18:09,830
...وُلدت

267
00:18:10,470 --> 00:18:12,790
!لأحبّ النّساء

268
00:18:12,790 --> 00:18:14,250
!كلاّ

269
00:18:14,250 --> 00:18:16,910
!مرحى

270
00:18:20,260 --> 00:18:23,720
!أنت رجل معقول. أثرت إعجابي

271
00:18:23,720 --> 00:18:25,470
!حسنًا، سأمنحك فرصة

272
00:18:25,470 --> 00:18:26,840
فرصة؟

273
00:18:29,400 --> 00:18:33,390
سأسلّم الوصفات لـ99 من الخبراء الكبار

274
00:18:33,390 --> 00:18:36,730
!لكينبو النيوكاما على هذه الجزيرة

275
00:18:37,320 --> 00:18:42,900
!إن كنت قرصانًا حقيقيًّا، احصل على الوصفات منهم

276
00:18:42,900 --> 00:18:46,200
ولكن، كلّ النيوكاما على هذه الجزيرة

277
00:18:46,200 --> 00:18:50,740
سيحاولون جعلك ترتدي هذا
!الفستان الحلو ليلاً ونهارًا

278
00:18:51,040 --> 00:18:54,250
.أتساءل إن كان بمقدورك الحفاظ على رجولتك

279
00:18:56,870 --> 00:18:58,750
!سانجي-كُن

280
00:18:58,750 --> 00:19:00,750
!لن نسمح لك بالنّوم

281
00:19:00,750 --> 00:19:02,710
!الفستان الحلو

282
00:19:02,710 --> 00:19:06,680
!سأعيد المشاعر الحماسيّة لارتداء التّنّورات

283
00:19:06,680 --> 00:19:10,070
!سانجي! من اللّطيف ان نتصرّف بأنثويّة

284
00:19:12,080 --> 00:19:13,430
...أنت

285
00:19:13,830 --> 00:19:18,520
!ضدّ معقل كينبو النيوكاما

286
00:19:18,520 --> 00:19:23,730
إن استطعت الفوز بهذه القتالات، سأمنحك
!سفينة أيضًا! بإمكانك الحصول على كلّ شيء

287
00:19:23,730 --> 00:19:25,490
!فما قولك؟

288
00:19:28,290 --> 00:19:29,450
!أيّها الطّبّاخ

289
00:19:30,550 --> 00:19:33,040
!انضمّ لطاقمي

290
00:19:33,040 --> 00:19:33,870
ماذا؟

291
00:19:33,870 --> 00:19:36,710
!فلتصبح طبّاخ سفينتي

292
00:19:39,960 --> 00:19:41,380
.لن أموت

293
00:19:50,490 --> 00:19:53,390
.لن أموت هنا

294
00:19:53,690 --> 00:19:57,390
...نرى أغبياء مثله من حين لآخر

295
00:19:57,390 --> 00:20:02,410
أغبياء سيقاتلون حتّى الموت بمجرّد
...امتلاكهم لهدف نصب أعينهم

296
00:20:07,280 --> 00:20:11,330
،لا أستطيع سماع إجابتك
أيعني ذلك أنّك تستسلم؟

297
00:20:11,330 --> 00:20:13,520
...نعم، إن خسرت

298
00:20:13,520 --> 00:20:15,160
...عندما أفوز

299
00:20:16,310 --> 00:20:22,290
عندما أهزمهم جميعًا، أراهن أنّني
.سأكون أقوى بكثير ممّا أنا عليه الآن

300
00:20:23,780 --> 00:20:27,460
،مهما كثرت الأسلحة الّتي بحوزته

301
00:20:27,460 --> 00:20:31,950
بالإمكان أن يُهزم على يد شخص
.يملك رمح عزيمة عمياء

302
00:20:32,800 --> 00:20:37,720
.يا لوفي، لا تخسر

303
00:20:39,300 --> 00:20:43,160
...لكنّني آمل الذّهاب يومًا ما
.إلى الغراند لاين

304
00:20:43,160 --> 00:20:45,710
.لنذهب الآن إذًا

305
00:20:45,710 --> 00:20:47,730
.لم يحن الوقت المناسب بعد

306
00:20:49,740 --> 00:20:53,120
أخبرني... هل تعرف الأزرق الكامل؟

307
00:20:53,120 --> 00:20:53,840
...لا

308
00:20:53,840 --> 00:20:57,910
!ألا تعرفه بالفعل؟! إنّه البحر المعجزة

309
00:20:59,830 --> 00:21:03,330
.لكلينا أحلام سخيفة

310
00:21:05,290 --> 00:21:09,880
...ولكي أصل إل هدفي، الأزرق الكامل

311
00:21:09,880 --> 00:21:10,720
سانجي؟

312
00:21:10,720 --> 00:21:15,140
!"صحيح. سأرافقك... في رحلتك لتصبح "ملك القراصنة

313
00:21:17,440 --> 00:21:20,230
.سأصبح الطّبّاخ في سفينتك

314
00:21:22,390 --> 00:21:26,440
...لوفي، إن أمكنني رؤيتك ثانية

315
00:21:27,360 --> 00:21:28,810
...فسوف

316
00:21:29,650 --> 00:21:32,330
أدعمك أفضل دعم في العالم

317
00:21:32,330 --> 00:21:35,560
!بإمكان طبّاخ أن يمنحه لتصير ملك القراصنة

318
00:21:37,740 --> 00:21:38,850
...بعد

319
00:21:40,410 --> 00:21:41,910
...أن أتجاوز

320
00:21:43,420 --> 00:21:45,060
!هذا الجحيم

321
00:21:49,520 --> 00:21:50,980
...أقبل

322
00:21:52,610 --> 00:21:53,800
!هذا التّحدّي

323
00:21:55,870 --> 00:21:59,880
!ممتاز! لن نتساهل معك

324
00:21:59,880 --> 00:22:01,410
!أتطلّع لذلك

325
00:22:01,410 --> 00:22:04,020
!حسنًا، لننطلق

326
00:22:05,810 --> 00:22:06,900
!سانجي-كُن

327
00:22:08,020 --> 00:22:10,860
!لا تعاملني ببرود

328
00:22:10,860 --> 00:22:11,900
!اخرس

329
00:22:11,900 --> 00:22:13,110
...وإلاّ

330
00:22:16,620 --> 00:22:20,700
!لا يمكنني أن أخسر هنا

331
00:22:22,040 --> 00:22:23,540
!كلاّ

332
00:22:25,120 --> 00:22:26,460
!لن يفيدك ذلك

333
00:22:28,520 --> 00:22:30,050
!نلت منك

334
00:22:34,800 --> 00:22:38,260
!لن أخسر أيضًا يا لوفي

335
00:22:38,930 --> 00:22:42,020
!سأقاتلك الآن

336
00:22:42,020 --> 00:22:46,190
!خذ الوصفة منّي أنا كارولاين

337
00:22:46,740 --> 00:22:49,200
!هذا ممتاز

338
00:22:49,200 --> 00:22:52,570
!سأحصل على انتقامي عمّ حدث ذلك اليوم

339
00:22:55,390 --> 00:22:56,660
!ها أنذا

340
00:22:58,440 --> 00:23:01,750
!سأفوز قطعًا

341
00:23:11,380 --> 00:23:15,170
.وصلت رسالة لوفي لأصدقائه بأمان

342
00:23:15,170 --> 00:23:18,120
،بعد اعتبارهم لمشاعر لوفي كأنّها لهم

343
00:23:18,120 --> 00:23:20,890
.قرّر أصدقاؤه أن يسعوا خلف حلم جديد

344
00:23:20,890 --> 00:23:23,280
،وبغرض الاجتماع بقبطانهم مرّة أخرى

345
00:23:23,280 --> 00:23:26,480
وضعوا نصب أعينهم اليوم الّذي
!سينطلقون فيه في مغامرة جديدة

346
00:23:26,480 --> 00:23:27,770
:في الحلقة القادمة من وان بيس

347
00:23:27,770 --> 00:23:30,870
!سأصير أقوى وأقوى بكثير"
".عهد زورو لقبطانه

348
00:23:30,870 --> 00:23:33,100
!ملك القراصنة، لن يكون إلاّ أنا

349
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة