1
00:02:06,610 --> 00:02:07,910
!أدون

2
00:02:14,330 --> 00:02:16,290
!سوناتشي

3
00:02:29,720 --> 00:02:32,690
...النّدبة الّتي تركني بها أودن

4
00:02:33,140 --> 00:02:35,160
لماذا تؤلمني؟

5
00:02:35,160 --> 00:02:38,560
كيف اخترق النّصل جسدي؟

6
00:02:46,110 --> 00:02:51,120
!هل يستعملون ريوو أودن؟

7
00:02:54,580 --> 00:02:57,420
!فلتخترقك أنصالنا حتّى الجانب الآخر

8
00:03:25,650 --> 00:03:29,220
.لا أصدّق أنّكم تعاونتم مع قراصنة

9
00:03:29,220 --> 00:03:34,120
...الإشاعة عن الظّلال في أطلال قلعة أودن

10
00:03:34,120 --> 00:03:36,030
.بانك هازارد

11
00:03:36,030 --> 00:03:37,790
.دريسروزا

12
00:03:37,790 --> 00:03:40,460
.الجزيرة الوهميّة زو

13
00:03:40,460 --> 00:03:44,970
!وخلف كلّ ذلك نجد طاقم قبّعة القشّ

14
00:03:45,330 --> 00:03:47,530
،ويا لها من صدفة غريبة

15
00:03:47,530 --> 00:03:53,220
كنتم تختبئون خلف طاقم قبّعة القشّ
.الّذين أعتبرهم أعداءً لي

16
00:03:53,220 --> 00:03:58,370
بعضكم تحمّل لعشرين سنة بينما
،قفز البقيّة عبر الزّمن وهربوا

17
00:03:58,370 --> 00:04:01,270
.وانتهى بكم المطاف بحشد كلّ القوّات

18
00:04:02,560 --> 00:04:06,900
!لكنّ القراصنة سيطعنونكم في الظّهر

19
00:04:09,280 --> 00:04:12,160
!إنّك تهينه بكلامك هذا

20
00:04:13,660 --> 00:04:16,700
!لا يشبهكم لوفي-دونو على الإطلاق

21
00:04:16,700 --> 00:04:20,980
!أنت وكايدو ورجالكما وأوروتشي وكلّ أتباعه

22
00:04:20,980 --> 00:04:24,500
!سأوسعكم ضربًا جميعًا

23
00:04:25,210 --> 00:04:29,550
!إنّه الرّجل الّذي سيقف على قمّة البحر يومًا ما

24
00:04:31,130 --> 00:04:34,490
،حتّى إن كان الموت مصيرنا
!فسيظلّ واقفًا هنا

25
00:04:34,490 --> 00:04:38,060
!سيحلّ الفجر على بلاد وانو ثانية

26
00:04:38,060 --> 00:04:39,480
...لأنّ

27
00:04:40,060 --> 00:04:42,810
!ذلك ما وعدنا به سيّدنا

28
00:04:46,020 --> 00:04:49,650
!ستكون حربًا شاملة

29
00:04:51,980 --> 00:04:56,620
المعركة تحت القمر! المحاربون"
"!الهائجون، سولونغ أسد القمر

30
00:05:15,470 --> 00:05:18,200
!هذا ما توقّعته من أخيك يا إيس

31
00:05:18,200 --> 00:05:21,430
!أنا سعيد بالقتال إلى جانبه

32
00:05:21,930 --> 00:05:26,360
.صمدنا لعشرين سنة ووصلنا لهذا الحدّ أخيرًا

33
00:05:27,520 --> 00:05:32,070
!لا يوجد ما نخشاه الآن

34
00:05:32,070 --> 00:05:36,030
!تشبّثوا برأس كايدو وإن قتلكم ذلك

35
00:05:53,760 --> 00:06:00,060
تسنّت لنا فرصة مواجهتك أخيرًا
.بفضل دعم لوفي-دونو والبقيّة

36
00:06:01,810 --> 00:06:06,150
!لن نسمح لك بالخروج من هنا حيًّا

37
00:06:22,830 --> 00:06:25,310
.لا تختبروا صبري

38
00:06:25,310 --> 00:06:28,540
!لا تتعدّى قوّاتكم بضعة مئات المحاربين

39
00:06:37,640 --> 00:06:40,620
!إنّها محقّة. أغبياء

40
00:06:40,620 --> 00:06:43,080
!لدينا ثلاثون ألف جنديّ

41
00:06:43,080 --> 00:06:46,060
ماذا بوسعكم فعله ببضعة مئات فحسب؟

42
00:06:46,060 --> 00:06:52,300
...رنين، رنين، رنين... رنين، رنين، رنين

43
00:06:52,300 --> 00:06:53,360
.فتح

44
00:06:53,360 --> 00:06:54,280
ماذا؟

45
00:06:54,280 --> 00:06:59,370
!حالة طارئة! الآلاف من الغازين يدخلون من الخلف

46
00:07:00,820 --> 00:07:02,580
!ماذا؟

47
00:07:02,580 --> 00:07:05,670
!كيف يعقل هذا؟

48
00:07:09,960 --> 00:07:11,510
!هيّا بنا

49
00:07:18,300 --> 00:07:21,350
...حسنًا! إن كان هذا ما تريدون

50
00:07:29,350 --> 00:07:31,390
.سأقطّعكم بقدر ما تشاؤون

51
00:07:31,390 --> 00:07:32,650
!سحقًا لك

52
00:07:32,650 --> 00:07:35,740
!نعم، هلاككم مضمون

53
00:07:37,110 --> 00:07:38,580
!لماذا...؟

54
00:07:40,160 --> 00:07:41,530
...ساموراي

55
00:07:47,120 --> 00:07:50,370
!زوروجورو-دونو! سنساعدك

56
00:07:52,170 --> 00:07:54,420
.لا أحتاج لمساعدتكم

57
00:07:57,130 --> 00:07:59,470
!هذه النّقطة ب داخل القلعة

58
00:07:59,470 --> 00:08:02,850
!انضمّ محاربو السّاموراي إلى رورونوا زورو

59
00:08:02,850 --> 00:08:07,180
هذه النّقطة ج! السّاموراي الّذي
...أُسر في عاصمة الزّهور

60
00:08:07,180 --> 00:08:10,440
!وسجناء أودون يثورون أيضًا

61
00:08:15,770 --> 00:08:17,820
!ما الّذي يحدث؟

62
00:08:30,370 --> 00:08:32,210
...الوتر

63
00:08:32,210 --> 00:08:34,260
!المغناطيسيّ

64
00:08:46,810 --> 00:08:50,230
!يا رفاق، لا تتهاونوا

65
00:08:52,980 --> 00:08:57,060
.شكرًا لفتحك الطّريق لنا حتّى الآن

66
00:08:57,060 --> 00:08:59,170
.لا تسيئي فهمي

67
00:08:59,170 --> 00:09:02,570
.أنا هنا لقطع رأس كايدو فحسب

68
00:09:02,570 --> 00:09:06,660
،إن وقفتم في طريقي
.فلن أصفح عن أيّ أحد منكم أيضًا

69
00:09:06,660 --> 00:09:08,960
.شكرًا على التّحذير

70
00:09:09,870 --> 00:09:11,380
!غرفة

71
00:09:13,790 --> 00:09:15,340
!فلتمت

72
00:09:16,540 --> 00:09:17,960
!بتر

73
00:09:19,590 --> 00:09:21,130
!خلط

74
00:09:21,590 --> 00:09:22,760
ماذا؟

75
00:09:32,220 --> 00:09:35,500
...القراصنة الّذين أتى بهم كينييمون-دونو

76
00:09:35,500 --> 00:09:37,650
!يُعتمد عليهم بشدّة

77
00:09:38,350 --> 00:09:41,490
!ما الغاية من كلّ هذا؟

78
00:09:41,490 --> 00:09:43,880
.أتى الشيتشيبوكاي السّابق لو أيضًا

79
00:09:43,880 --> 00:09:47,410
!جميعهم متّحدون وقوّتهم في تزايد

80
00:09:47,410 --> 00:09:48,450
!ماذا؟

81
00:09:48,450 --> 00:09:50,040
!كوين-ساما

82
00:09:50,040 --> 00:09:51,540
!هناك المزيد؟

83
00:09:51,540 --> 00:09:53,810
،في مدخل الجزيرة

84
00:09:53,810 --> 00:09:57,130
...يتقاتل العنقاء ماركو وبيروسبيرو

85
00:09:58,670 --> 00:10:01,170
!مهلاً! ماذا حدث؟

86
00:10:01,170 --> 00:10:03,050
!مرحبًا؟

87
00:10:06,010 --> 00:10:07,760
!عذراء السّكاكر

88
00:10:11,770 --> 00:10:13,350
!ماذا يحدث؟

89
00:10:13,350 --> 00:10:15,560
!لماذا يتّحدون معًا؟

90
00:10:21,400 --> 00:10:25,070
.والآن، بدأت إبادة الغيلان-يوي

91
00:10:25,070 --> 00:10:30,600
سأحوّل كلّ عضو من قراصنة مملكة
.الحيوان إلى رجل سكاكر

92
00:10:30,600 --> 00:10:32,200
!لعق

93
00:10:34,790 --> 00:10:37,980
!اتّحد ماركو وبيروسبيرو؟

94
00:10:37,980 --> 00:10:42,420
،بابانوكي في البداية، ثمّ كيوشيرو
والآن هذا؟ ما الّذي يحدث؟

95
00:10:45,840 --> 00:10:49,140
!أيّها الأوغاد السّكارى في أنحاء أونيغاشيما

96
00:10:51,140 --> 00:10:53,600
!تمّ إلغاء وليمة اللّيلة

97
00:10:54,010 --> 00:10:55,810
!احملوا أسلحتكم

98
00:10:59,770 --> 00:11:02,400
!أغار العدوّ علينا

99
00:11:10,110 --> 00:11:12,080
...يا رفاق

100
00:11:16,040 --> 00:11:20,790
رغم رحيل كايدو، إلاّ أنّه ما زال هنالك
.ثلاثة من كبار النّجوم هنا

101
00:11:21,250 --> 00:11:23,750
!لكنّي واثقة أنّه ستكون هنالك فرصة

102
00:11:24,130 --> 00:11:29,390
...مومونوسكي-ساما! انتظر قليلاً فحسب

103
00:11:30,220 --> 00:11:32,140
!لنقم بهذا

104
00:11:32,140 --> 00:11:34,850
!فوزوا واسترجعوا بلاد وانو

105
00:12:01,630 --> 00:12:04,440
!سمعتك يا قبّعة القشّ

106
00:12:04,440 --> 00:12:07,510
ستوسعني ضربًا؟

107
00:12:07,510 --> 00:12:12,140
!أرني ما لديك! قبلت تحدّيك

108
00:12:20,850 --> 00:12:25,270
!سأريك قوّة أعظم جيوش العالم

109
00:12:47,290 --> 00:12:48,960
!لوفي-دونو

110
00:12:56,260 --> 00:12:58,050
!شكرًا لك

111
00:12:58,050 --> 00:13:00,980
!كينييمون! سأوافيك لاحقًا

112
00:13:03,600 --> 00:13:05,310
!كايدو-سان

113
00:13:49,150 --> 00:13:53,530
.استفقت بالكامل

114
00:13:58,620 --> 00:14:03,080
إن كنتم تريدون قتالاً مميتًا، فمن
.الأفضل خوضه في مكان مفتوح

115
00:14:03,080 --> 00:14:06,000
...كما ذلك اليوم

116
00:14:06,790 --> 00:14:08,710
!كايدو

117
00:14:10,420 --> 00:14:12,890
...كلّ ما أريد فعله

118
00:14:13,670 --> 00:14:15,760
!هو قطع رأس كايدو

119
00:14:16,050 --> 00:14:18,890
!يا له من رجل مضحك

120
00:14:18,890 --> 00:14:21,560
!أسلوب أودن ذو السّيفين

121
00:14:23,140 --> 00:14:24,730
!توتسكا الفردوس

122
00:14:28,100 --> 00:14:31,700
!لا يمكنني أن أخسر

123
00:14:32,440 --> 00:14:35,320
!توتسكا الفردوس

124
00:14:45,080 --> 00:14:49,920
.لكن على خلاف ذلك اليوم، أودن ميت فعلاً

125
00:15:00,510 --> 00:15:03,390
.هنالك أمر مختلف عن ذلك اليوم

126
00:15:03,390 --> 00:15:06,480
،استنتجنا أنّه عندما تتحوّل إلى تنّين

127
00:15:06,480 --> 00:15:10,440
.فلن تتمكّن من القتال داخل القبّة

128
00:15:31,420 --> 00:15:36,050
!تجهل تمامًا كم كنت أتوق شوقًا لهذا اليوم

129
00:15:36,050 --> 00:15:40,220
!أردت منك أن تتذوّق مدى غضبنا بأقسى الطّرق

130
00:15:40,220 --> 00:15:41,840
...قبيلة المينك

131
00:15:41,840 --> 00:15:46,100
.أحضرنا المحاربين من مملكتنا

132
00:15:52,520 --> 00:15:54,860
.ثمّة ثلوج خفيفة في سماء صافية

133
00:15:55,360 --> 00:15:59,870
.والقمر البدر واضح تمامًا

134
00:16:01,450 --> 00:16:03,310
...صحيح

135
00:16:03,310 --> 00:16:09,790
تتحوّلون أنتم المينك إلى محاربين هائجين
.يُدعون السّولونغ عندما يكون القمر بدرًا

136
00:16:27,140 --> 00:16:28,650
!جاك

137
00:16:34,440 --> 00:16:38,280
!لا أصدّق أنّكم قمتم بهذا أيّها السّاموراي الأوغاد

138
00:16:38,610 --> 00:16:42,950
.السّماح بدخول الكثير منكم كان خطأنا

139
00:16:43,610 --> 00:16:48,750
!لن تقتربوا من كايدو-سان ثانية

140
00:16:51,700 --> 00:16:54,510
!مهلاً، يا رفاق-غارا

141
00:16:54,750 --> 00:17:01,220
جاك عدّونا نحن اللّدود الّذي حطّم
.مملكتنا الّتي عمّرت لألف سنة

142
00:17:03,640 --> 00:17:07,940
...أخبرناه عدّة مرّات أنّ السّاموراي لم يكن هناك

143
00:17:15,520 --> 00:17:18,260
!حسنًا، أعطوه لنا الآن

144
00:17:18,260 --> 00:17:23,200
أعلم أنّ محاربًا من بلاد وانو
!يُدعى رايزو موجود هنا

145
00:17:24,150 --> 00:17:27,160
محارب من بلاد وانو؟ رايزو؟

146
00:17:27,160 --> 00:17:28,950
!لا نعرف أيّ أحد بهذا الاسم

147
00:17:52,180 --> 00:17:54,320
!أجيبوا على السّؤال

148
00:17:55,150 --> 00:17:57,350
أين المحارب من بلاد وانو؟

149
00:17:57,350 --> 00:17:58,780
!إنّه ليس هنا

150
00:18:10,320 --> 00:18:13,960
!لن أنسى هذا حتّى إن متّ يا جاك

151
00:18:13,960 --> 00:18:18,170
حتّى اليوم الّذي سألعنك-غارا حتّى
!الموت بضغينة القطط خاصّتي

152
00:18:25,510 --> 00:18:29,470
!المحارب الّذي قالوا أنّه ليس موجودًا هو أنا يا جاك

153
00:18:30,470 --> 00:18:32,100
...إنّه أنت

154
00:18:32,100 --> 00:18:38,060
!أنقذوا حياتي! وسأردّ الدّين بأكثر من صاع

155
00:18:38,060 --> 00:18:40,710
!أرني أفضل ما لديك

156
00:18:40,710 --> 00:18:43,950
!لديّ حساب أصفّيه معكم أيضًا

157
00:19:08,380 --> 00:19:12,100
!أريدكم أن تسدّدوه بحياتكم

158
00:19:12,100 --> 00:19:13,970
!أرينا ما لديك

159
00:19:13,970 --> 00:19:16,440
!قم بكلّ ما تستطيع

160
00:19:31,330 --> 00:19:33,160
...كلاّ، أنت يا سيّدي ورفاقك

161
00:19:33,160 --> 00:19:35,250
.عليكم الاستعداد لكايدو

162
00:19:35,250 --> 00:19:37,000
!أنت أيضًا أيّها الدّوق-ساما

163
00:19:51,420 --> 00:19:53,890
.سأترك أمرهم لكم إذًا

164
00:19:53,890 --> 00:19:55,550
!شكرًا لكم

165
00:19:55,550 --> 00:20:00,600
في تلك الحالة، سأستعمل كلّ ما
!بوسعي للإطاحة بكايدو

166
00:21:41,870 --> 00:21:45,580
!لا تخشوا شيئًا! مدّة السّولونغ قصيرة

167
00:21:45,580 --> 00:21:49,210
!أرونا ما لديكم! نحن وحوش أيضًا

168
00:22:11,360 --> 00:22:12,690
!ماذا؟

169
00:22:36,760 --> 00:22:39,430
!جاريني يا نيكو

170
00:22:39,430 --> 00:22:42,270
!اقلق على نفسك-غارا فحسب يا إينو

171
00:23:04,160 --> 00:23:07,670
.الوقت غير مناسب للخسارة بينما يضعف مومونوسكي أكثر

172
00:23:07,670 --> 00:23:09,770
.تتعرّض شينوبو الّتي تحاول المساعدة لهجوم كينغ

173
00:23:09,770 --> 00:23:14,530
يدافع لوفي والبقيّة عن أنفسهم
.ضدّ تهديدات بيغ مام بيأس

174
00:23:22,560 --> 00:23:27,140
:في الحلقة القادمة من وان بيس
"!خيانة زوس؟! نامي محاصرة"

175
00:23:27,140 --> 00:23:30,340
!ملك القراصنة، لن يكون إلاّ أنا