1
00:00:00,000 --> 00:00:03,660
مدّ يدك واقطع الرّياح

2
00:00:03,660 --> 00:00:08,330
ارسم خريطتك الخاصّة

3
00:00:12,920 --> 00:00:19,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:19,590 --> 00:00:26,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:26,060 --> 00:00:32,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:32,350 --> 00:00:35,730
لا يمكن لأحد الجزم بذلك

7
00:00:35,730 --> 00:00:42,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:42,240 --> 00:00:49,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:00:49,200 --> 00:00:55,840
مدّ يدك واقطع الرّياح

10
00:00:55,840 --> 00:01:00,510
اركل الظّلمة بعيدًا

11
00:01:01,510 --> 00:01:08,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:08,720 --> 00:01:12,600
وأنا جاهز لذلك

13
00:01:12,600 --> 00:01:18,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:18,360 --> 00:01:25,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:25,070 --> 00:01:31,790
مدّ يدك واقطع الرّياح

16
00:01:31,790 --> 00:01:37,420
اركل الظّلمة بعيدًا

17
00:01:37,420 --> 00:01:44,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:44,630 --> 00:01:49,430
فلنلوّنها بألواننا الخاصّة

19
00:02:00,280 --> 00:02:04,570
"!ماضي ياماتو! الرّجل الّذي أتى ساعيًا خلف اليونكو"

20
00:02:06,370 --> 00:02:08,370
!ذهب من هناك

21
00:02:08,370 --> 00:02:10,110
!انتظر

22
00:02:10,370 --> 00:02:13,580
،عندما يتّخذ الرّجل قراره
!فلا تحاولن الوقوف في طريقه

23
00:02:16,420 --> 00:02:18,500
...إنّه يتركنا ويغادر

24
00:02:18,500 --> 00:02:20,010
!توقّف

25
00:02:20,010 --> 00:02:21,920
!مهلاً لحظة

26
00:02:22,430 --> 00:02:24,490
،حتّى إن أخبرتماني أن أنتظر

27
00:02:24,490 --> 00:02:26,460
!لكنّني لا أستطيع فعل ذلك

28
00:02:30,690 --> 00:02:32,760
!سُحقًا! ما هذا؟

29
00:02:33,230 --> 00:02:34,690
!فكّي وثاقي

30
00:02:34,690 --> 00:02:37,650
...كفّ عن القتال هكذا

31
00:02:38,190 --> 00:02:41,650
.فتى سيّئ... لا تحاول الهرب

32
00:02:43,280 --> 00:02:45,020
...أنت

33
00:02:45,320 --> 00:02:49,240
.قلت أنّك أحببتني

34
00:02:59,510 --> 00:03:03,800
.ابق هنا للأبد. ستكون حيواني الأليف

35
00:03:03,800 --> 00:03:06,570
...ما هذا الهراء؟! أنا

36
00:03:06,570 --> 00:03:08,380
!عليّ الذّهاب

37
00:03:08,380 --> 00:03:09,760
...لكن

38
00:03:12,180 --> 00:03:13,550
...أينما نظرت

39
00:03:14,020 --> 00:03:15,640
...لا أرى سوى

40
00:03:15,860 --> 00:03:18,140
!النّساء، النّساء، النّساء

41
00:03:21,150 --> 00:03:22,770
...أهذه

42
00:03:22,770 --> 00:03:24,190
الجنّة؟

43
00:03:25,200 --> 00:03:27,400
.لا بدّ وأنّه فقد عقله

44
00:03:28,620 --> 00:03:31,900
،يا لظرافتك. مكافأة لك على ذلك

45
00:03:32,200 --> 00:03:34,790
.سأفتح باب الجنّة لك

46
00:03:34,790 --> 00:03:35,410
!كلاّ

47
00:03:36,120 --> 00:03:37,240
!هذه خدمة خاصّة

48
00:03:42,460 --> 00:03:44,420
!توقّف يا قبّعة القشّ

49
00:03:45,550 --> 00:03:49,050
!ستتأذّون إن لم تبتعدوا عن طريقي

50
00:03:56,440 --> 00:03:59,390
.أرى أنّ قبّعة القشّ سبقك

51
00:03:59,690 --> 00:04:03,230
...سيسبّب ذلك المشاكل لكايدو-سان

52
00:04:11,280 --> 00:04:13,200
...هلاّ توقّفت

53
00:04:13,910 --> 00:04:16,530
عن مضايقة أعواني؟

54
00:04:21,090 --> 00:04:26,500
.أنت شيتشيبوكاي سابق يا فارس البحر جينبي
كيف لك أن تكون صبيانيًّا هكذا؟

55
00:04:27,430 --> 00:04:30,930
!أنا ربّان سفينة طاقم قبّعة القشّ

56
00:04:31,220 --> 00:04:34,310
ألا يمكنك استعمال لقبي الأكثر قيمة؟

57
00:04:34,310 --> 00:04:36,550
.عفوًا، أنا آسف

58
00:04:37,100 --> 00:04:41,440
...رأيتك مرّة عندما كنتَ شيتشيبوكاي

59
00:04:41,440 --> 00:04:42,650
ماذا؟

60
00:04:42,650 --> 00:04:47,060
.يغيّر النّاس مواقفهم تمامًا أحيانًا

61
00:04:47,320 --> 00:04:52,780
.لذلك ربّما كنت أقف إلى جانبك في الماضي

62
00:04:53,580 --> 00:04:54,610
.جينبي

63
00:04:57,160 --> 00:04:59,240
.حسنًا، انس الأمر

64
00:04:59,460 --> 00:05:01,950
من تكون؟

65
00:05:02,250 --> 00:05:05,080
.من يدري؟ أتساءل من أكون

66
00:05:05,420 --> 00:05:09,790
.إن نزعتُ قناعك، فقد أتمكّن من التّعرّف إليك

67
00:05:12,050 --> 00:05:14,470
.لن يحدث ذلك

68
00:05:15,560 --> 00:05:17,640
.ها أنت ذي

69
00:05:18,310 --> 00:05:19,680
.شكرًا لك

70
00:05:20,480 --> 00:05:22,480
لـ-لماذا تضحك؟

71
00:05:22,480 --> 00:05:24,630
.أنا آسف

72
00:05:24,630 --> 00:05:26,020
...يذكّرني هذا بالماضي

73
00:05:26,570 --> 00:05:30,280
...ذكريات الجراح الّتي أصبته بها

74
00:05:30,280 --> 00:05:32,510
جراح أصبته بها؟

75
00:05:32,510 --> 00:05:35,030
إذًا قاتلته وهزمته؟

76
00:05:35,290 --> 00:05:36,610
...لا

77
00:05:37,120 --> 00:05:38,820
.بل خسرت

78
00:05:39,080 --> 00:05:42,330
.لكنّ فوزي أو خسارتي لم يكونا مهمّين

79
00:05:42,630 --> 00:05:43,490
،فكما ترى

80
00:05:45,880 --> 00:05:47,460
...معنى الحياة

81
00:05:47,880 --> 00:05:52,360
...كان هو بلا أدنى شكّ من علّمني ذلك

82
00:05:52,360 --> 00:05:54,050
.كان إيس

83
00:06:02,230 --> 00:06:05,230
...المكان الّذي قالوا أنّ الأطفال محتجزون فيه

84
00:06:05,400 --> 00:06:07,850
.لا بدّ أنّه هذه الجزيرة على ما يبدو

85
00:06:10,740 --> 00:06:12,270
.وصلنا أخيرًا

86
00:06:13,820 --> 00:06:15,930
...سأقاتلك

87
00:06:15,930 --> 00:06:17,740
!يا كايدو

88
00:06:24,880 --> 00:06:26,580
.هيّا بنا

89
00:06:27,670 --> 00:06:31,280
.ظننتُ أنّ حرّاس بوّابة أونيغاشيما سيكونون أقوى

90
00:06:31,280 --> 00:06:33,460
.خيّب هذا أملي

91
00:06:33,880 --> 00:06:38,390
.أنت، لا ترخي دفاعاتك
.عدوّنا هو ذلك اليونكو ذائع الصّيت

92
00:06:38,390 --> 00:06:40,130
.نعم، أعلم

93
00:06:41,600 --> 00:06:44,220
ماذا؟ لا أحد هنا؟

94
00:06:55,240 --> 00:06:56,780
!ثمّة دخلاء

95
00:06:57,700 --> 00:07:00,030
!كايدو هو الوحيد الّذي نحتاج لرؤيته

96
00:07:06,630 --> 00:07:07,550
!إيس

97
00:07:07,550 --> 00:07:10,170
!يا رفاق، اذهبوا لإنقاذ الأطفال بينما ذلك ممكن

98
00:07:10,170 --> 00:07:11,340
!مفهوم

99
00:07:11,340 --> 00:07:12,330
!دع الأمر لنا

100
00:07:15,010 --> 00:07:16,670
!يا له من شخص مثابر

101
00:07:22,180 --> 00:07:24,800
!من أنت؟! ما اسمك؟

102
00:07:25,480 --> 00:07:27,020
!أنت أوّلاً

103
00:07:31,490 --> 00:07:32,900
!أنا إيس

104
00:07:33,150 --> 00:07:35,360
!أنا هنا لقطع رأس كايدو

105
00:07:49,590 --> 00:07:52,120
!وجدتهم! تعالوا إلى هنا

106
00:07:54,510 --> 00:07:57,460
.لا تخفن. نحن هنا لإنقاذكنّ

107
00:07:57,680 --> 00:07:59,590
.هيّا، لنذهب

108
00:08:08,640 --> 00:08:10,390
.أنت قويّ

109
00:08:19,240 --> 00:08:20,190
!إيس

110
00:08:21,370 --> 00:08:23,450
!كلّ الأطفال بخير

111
00:08:23,450 --> 00:08:26,710
!لكن لا يمكنا العثور على هدفنا كايدو

112
00:08:26,710 --> 00:08:27,920
!ماذا؟

113
00:08:27,920 --> 00:08:31,750
.والدي والبقيّة ذهبوا في رحلة استطلاعيّة
،وفي الوقت الحاليّ

114
00:08:32,000 --> 00:08:33,920
!لا يوجد ولا أحد من ضبّاطه هنا

115
00:08:33,920 --> 00:08:35,380
!والدي؟

116
00:08:35,380 --> 00:08:36,630
!ماذا؟

117
00:08:36,630 --> 00:08:40,000
!أهي إذًا ابنة كايدو؟

118
00:08:42,140 --> 00:08:43,670
!أنا ياماتو

119
00:08:44,100 --> 00:08:47,090
!أظنّ أنّنا نلنا كفايتنا من هذه الفوضى

120
00:08:47,390 --> 00:08:51,500
،إن كان لديكم وقت لتتساءلوا من أكون
،فغادروا المكان في الحال

121
00:08:51,500 --> 00:08:54,640
!وأعيدوهنّ إلى عائلاتهنّ

122
00:08:56,900 --> 00:08:58,610
.ذلك هو هدفنا

123
00:08:59,530 --> 00:09:01,860
لكن ألن تضرّك حقيقة تركنا نذهب؟

124
00:09:01,860 --> 00:09:05,450
.لا يوجد ما يدفعني للدّفاع عن هذه الجزيرة

125
00:09:05,700 --> 00:09:10,830
قبل كلّ شيء، أكره رؤيتهم يختطفون
!هؤلاء الأطفال الصّغار

126
00:09:16,170 --> 00:09:21,100
أسمعتم ما قالته؟ إن لم يكن كايدو
.هنا، فلا جدوى من البقاء هنا

127
00:09:21,100 --> 00:09:22,250
!لنعد

128
00:09:33,650 --> 00:09:36,360
.حسنًا، لنعد إلى بلاد وانو

129
00:09:36,360 --> 00:09:38,320
!عائلاتكنّ في انتظاركنّ

130
00:09:38,320 --> 00:09:39,780
!أراحني هذا

131
00:09:39,780 --> 00:09:42,030
!أنا مدينة لكم لبقيّة حياتي

132
00:09:42,030 --> 00:09:43,680
.ما من داعٍ

133
00:09:43,680 --> 00:09:47,450
.الأهمّ الآن، أظهرن لعائلاتكنّ أنّكنّ بخير

134
00:09:47,450 --> 00:09:51,380
!شكرًا جزيلاً لكم! شكرًا لكم

135
00:09:51,380 --> 00:09:53,200
أواثق من هذا يا إيس؟

136
00:09:53,590 --> 00:09:56,040
.سنعود إلى اليابسة الرّئيسيّة بدونك

137
00:09:56,040 --> 00:10:00,750
.نعم، اهتمّوا بهم. سأوافيكم لاحقًا

138
00:10:05,380 --> 00:10:09,680
لستُ مقتنعًا أنّ شخصًا قويًّا مثلك
...ليس قائدًا أو ما شابه

139
00:10:10,140 --> 00:10:11,600
!سأسوّي هذا الأمر

140
00:10:11,600 --> 00:10:14,000
...نال منّي الملل على أيّة حال

141
00:10:14,000 --> 00:10:15,230
!سأقاتلك

142
00:10:26,450 --> 00:10:27,690
!قبضة النّار

143
00:10:49,270 --> 00:10:53,550
لماذا... لماذا  لم تخض غمار البحر
!إذا كنت بهذه القوّة؟

144
00:10:54,060 --> 00:10:55,970
...أريد ذلك، لكنّي لا أستطيع

145
00:10:56,230 --> 00:10:59,570
!لن تتمكّن من فهم مشاعري أبدًا

146
00:10:59,570 --> 00:11:00,600
!ماذا؟

147
00:11:01,200 --> 00:11:05,020
...سبب بقائي هنا بدل الخروج للبحر

148
00:11:06,120 --> 00:11:08,440
.خطؤه هو بالكامل

149
00:11:09,580 --> 00:11:11,280
...والدي

150
00:11:11,830 --> 00:11:12,990
!كايدو

151
00:11:14,420 --> 00:11:17,200
...خطؤه هو بالكامل

152
00:11:17,710 --> 00:11:19,750
...لا أصدّق أنّه والدي

153
00:11:20,550 --> 00:11:23,710
كلّ هذا خطأ والدك؟

154
00:11:25,760 --> 00:11:28,130
ما هذه الأعذار؟

155
00:11:30,470 --> 00:11:34,090
!لا يمكننا اختيار آبائنا يا ياماتو

156
00:11:50,490 --> 00:11:52,530
غول د. روجر؟

157
00:11:53,830 --> 00:11:58,190
تقصد غولد روجر؟ أتسألني إن كنت أعرفه؟

158
00:11:58,190 --> 00:12:03,870
ألا تدرك لماذا هنالك الكثير من
الدّمار في العالم بسبب القراصنة؟

159
00:12:03,880 --> 00:12:06,590
!كلّ ذلك خطأ روجر

160
00:12:06,970 --> 00:12:08,050
خطأ روجر؟

161
00:12:08,050 --> 00:12:16,500
سمعتُ أنّ قُبيل إعدامه، تفوّه بترّاهات
...عن كنز عظيم أو ما شابه

162
00:12:16,500 --> 00:12:20,970
ما دفع القراصنة الأغبياء الّذين
.صدّقوه ليعيثوا فسادًا

163
00:12:21,150 --> 00:12:24,940
!لم يكن يجدر أن يولد من الأساس

164
00:12:24,940 --> 00:12:27,280
!كان مجرّد وغد بلا قيمة

165
00:12:27,280 --> 00:12:30,280
!كان مصدر إزعاج، سواء حيًّا أو ميتًا

166
00:12:30,280 --> 00:12:31,990
روجر؟

167
00:12:31,990 --> 00:12:37,200
!لا تذكر الاسم الّذي يثير غثياني يا ولد
!أن تفسدي مشروبي هكذا! غادر

168
00:12:38,540 --> 00:12:40,120
!إلام تنظر؟

169
00:12:42,420 --> 00:12:45,750
!ما الّذي تفعله في رأيك أيّها الشّقيّ القذر؟

170
00:12:47,590 --> 00:12:52,130
.يا إيس؟ سمعتُ أنّك خارج السّيطرة هذه الأيّام

171
00:12:53,520 --> 00:12:54,390
.أيّها العجوز

172
00:12:58,650 --> 00:12:59,890
...هل تظنّ

173
00:13:03,030 --> 00:13:05,690
أنّني أستحقّ أن أولد؟

174
00:13:10,660 --> 00:13:12,860
...هذا شيء

175
00:13:14,450 --> 00:13:16,820
.ستعرفه بينما تعيش

176
00:13:21,160 --> 00:13:22,660
...لا يمكنك

177
00:13:24,000 --> 00:13:26,750
.اختيار والديك يا ياماتو

178
00:13:27,210 --> 00:13:31,420
!اخرس! ليس عليك إخباري بذلك

179
00:13:32,300 --> 00:13:34,470
أواثق من ذلك؟

180
00:13:34,470 --> 00:13:38,590
!ما دام هو والدي، فلن أكون حرًّا

181
00:13:40,810 --> 00:13:42,140
...كلّ ما أملكه

182
00:13:44,600 --> 00:13:46,500
...إ-إنّها ثقيلة

183
00:13:46,500 --> 00:13:48,770
!لماذا تكبّلني؟

184
00:13:48,770 --> 00:13:51,740
.لأنّك تفكّر بالأمور الخطأ

185
00:13:51,740 --> 00:13:55,740
!لا تملك ولو سببًا جيّدًا واحدًا لمغادرة الجزيرة

186
00:13:56,080 --> 00:14:01,160
!إن كنت ابني، صر أقوى منّي
!لا تفكّر في أيّ شيء آخر

187
00:14:01,460 --> 00:14:04,440
!كلاّ... انزع أغلالي

188
00:14:04,440 --> 00:14:06,910
!والدي

189
00:14:08,880 --> 00:14:11,380
كنتُ محتجزًا على هذه الجزيرة اللّعينة

190
00:14:12,010 --> 00:14:15,260
.وكُبّلتُ بالأغلال الّتي ستنفجر إن غادرتها

191
00:14:16,310 --> 00:14:20,970
.لا خيار لديّ سوى البقاء هنا طوال حياتي

192
00:14:22,150 --> 00:14:27,480
...فقط لأنّ ذلك الوغد المسمّى كايدو أنجبني

193
00:14:28,820 --> 00:14:33,190
،رغم أنّه لا مفرّ من تلك الأغلال
،فإن كنت تكره والدك لهذا الحدّ

194
00:14:33,190 --> 00:14:35,900
!فلماذا تسمح لها بأن تكبّل قلبك؟

195
00:14:37,950 --> 00:14:41,390
هل صرت أقوى لحماية والدك؟

196
00:14:41,390 --> 00:14:46,270
أم للتّنفيس عن غضبك بقتال شخص مثلي؟

197
00:14:46,270 --> 00:14:49,660
!كلاّ! صرت أقوى من أجل نفسك

198
00:14:53,010 --> 00:14:54,530
!ياماتو

199
00:14:54,530 --> 00:14:57,010
!ما الّذي تريد القيام به بالفعل؟

200
00:15:18,120 --> 00:15:19,950
.فكّر في الأمر

201
00:15:20,700 --> 00:15:23,370
...ألا تحمل الإجابة

202
00:15:23,370 --> 00:15:27,830
عميقًا، عميقًا داخل قلبك؟

203
00:15:30,710 --> 00:15:34,040
...عميقًا داخل قلبي

204
00:15:50,440 --> 00:15:52,560
...أ-أنا

205
00:15:53,780 --> 00:15:55,020
...أنا

206
00:16:28,310 --> 00:16:32,310
!ما الّذي تريد القيام به بالفعل؟

207
00:16:50,710 --> 00:16:55,080
!لا تملك ولو سببًا جيّدًا واحدًا لمغادرة الجزيرة

208
00:17:15,860 --> 00:17:17,100
...أعترف

209
00:17:18,070 --> 00:17:20,480
.كنت أكبح نفسي

210
00:17:20,910 --> 00:17:23,030
...لم يسعني سوى أن أحلم

211
00:17:23,490 --> 00:17:26,450
.لكنّي لم أستطع القيام بما أردت

212
00:17:27,250 --> 00:17:29,320
...هذه الأغلال المتفجّرة

213
00:17:29,830 --> 00:17:31,790
...ابن كايدو

214
00:17:32,380 --> 00:17:34,690
...حلم مستحيل

215
00:17:34,690 --> 00:17:37,630
".سأظلّ عالقًا على هذه الجزيرة اللّعينة"

216
00:17:37,630 --> 00:17:39,340
".لا خيار لديّ"

217
00:17:39,340 --> 00:17:41,970
".كلّ هذا خطأ والدي"

218
00:17:41,970 --> 00:17:43,590
.هذا ما كنت أقنع نفسي به

219
00:17:44,720 --> 00:17:46,550
.لكنّني أدركت الآن

220
00:17:47,230 --> 00:17:51,390
!أريد خوض غمار البحر والذّهاب في مغامرة

221
00:17:51,690 --> 00:17:54,850
!أريد أن أعيش بحرّيّة مثل أودن

222
00:17:55,780 --> 00:17:58,690
...إلى البحر

223
00:17:58,900 --> 00:18:01,310
...وأغادر هذه الجزيرة التّعيسة

224
00:18:01,740 --> 00:18:05,070
!أريد أن أعيش بحرّيّة

225
00:18:09,160 --> 00:18:10,910
!هذا هو الجواب يا ياماتو

226
00:18:24,720 --> 00:18:26,300
.هذا ما يجب أن يكون

227
00:18:27,810 --> 00:18:29,550
.صرت تعلم ما العمل الآن

228
00:18:37,860 --> 00:18:39,100
!نعم

229
00:18:47,700 --> 00:18:51,950
لا أصدّق أنّ المطاف انتهى به هكذا
.مع شخص أتى ليقتل والدي

230
00:18:53,040 --> 00:18:54,830
.إذًا فأنت تحبّ والدك

231
00:18:54,830 --> 00:18:56,420
!ذلك مستحيل

232
00:18:56,420 --> 00:19:01,090
.يا إلهي! لا تنفكّ تهاجم نقاط ضعفي

233
00:19:01,090 --> 00:19:02,470
.آسف، آسف

234
00:19:02,470 --> 00:19:04,750
هل أنت آسف فعلاً؟

235
00:19:11,600 --> 00:19:13,050
.والآن يا إيس

236
00:19:13,730 --> 00:19:15,010
.أخبرني

237
00:19:15,400 --> 00:19:18,480
...عنك وعن مغامراتك

238
00:19:18,900 --> 00:19:20,560
...وعن العالم

239
00:19:20,780 --> 00:19:23,060
.وعن كلّ شيء وأيّ شيء

240
00:19:24,490 --> 00:19:25,820
.حسنًا

241
00:19:26,870 --> 00:19:30,030
.لكنّ ذلك سيأخذ وقتًا طويلاً، فاستعدّ

242
00:19:32,990 --> 00:19:36,120
!وعاد للمنزل في حالة يرثى لها

243
00:19:36,120 --> 00:19:40,540
تسبّب لي بالكثير من المتاعب
!فعلاً عندما كنّا أطفالاً

244
00:19:40,840 --> 00:19:43,250
!أخوك هذا مثير للاهتمام

245
00:19:43,250 --> 00:19:43,790
!فعلاً؟

246
00:19:44,630 --> 00:19:47,130
!أخبرني، كيف هي الأمور في الخارج؟

247
00:19:47,130 --> 00:19:49,680
!أهنالك الكثير من اليافعين يسعون للشّهرة؟

248
00:19:49,680 --> 00:19:52,340
...اليافعين؟ لنرَ

249
00:19:52,730 --> 00:19:55,270
.يتحدّث الجميع عن شخص يدعى كافن-شيء ما

250
00:19:55,270 --> 00:19:56,850
!فعلاً؟

251
00:19:56,850 --> 00:19:59,580
،حسنًا، أنا في مستوى مختلف وحدي

252
00:19:59,580 --> 00:20:03,440
لكنّي سمعت عن بعض الأشخاص الخطرين
.يعيثون فسادًا في كلّ البحار

253
00:20:03,440 --> 00:20:04,780
!نعم، نعم

254
00:20:04,780 --> 00:20:06,920
...كيد من الأزرق الجنوبيّ

255
00:20:06,920 --> 00:20:09,860
.ولو من الشّماليّ وبيجي من الغربيّ

256
00:20:10,950 --> 00:20:14,370
لكنّ الأشدّ من بينهم سيخرج للبحر
...بعد بضعة سنوات

257
00:20:14,580 --> 00:20:16,490
!وهو أخي الصّغير

258
00:20:17,410 --> 00:20:20,000
!سيكون قويًّا للغاية

259
00:20:20,000 --> 00:20:23,260
كم مرّة ستذكر فيها أخاك الصّغير؟

260
00:20:23,260 --> 00:20:25,250
!من يهتمّ؟ استمع فحسب

261
00:20:25,250 --> 00:20:26,470
!هذا مؤلم، مؤلم

262
00:20:26,470 --> 00:20:27,970
!أنت... هذا مؤلم

263
00:20:27,970 --> 00:20:29,500
!يكفي، توقّف

264
00:20:34,020 --> 00:20:36,440
...يا له من صديق مذهل

265
00:20:36,440 --> 00:20:42,020
.نعم. في الحقيقة، أنا من كسر تمثال التّنّين هذا

266
00:20:43,070 --> 00:20:44,770
،لكنّه قال

267
00:20:45,360 --> 00:20:50,950
"!هذا تحذير منّي لكايدو لإعلامه أنّني سأعود ثانية"

268
00:20:50,950 --> 00:20:52,510
...فهمت

269
00:20:52,510 --> 00:20:56,540
لم أكن أعلم أنّ هنالك قرصانًا
...حاول إنقاذ بلاد وانو

270
00:20:56,540 --> 00:20:58,770
،أغضب ذلك والدي كثيرًا

271
00:20:58,770 --> 00:21:01,160
.لكن في النّهاية، لم يعد إيس

272
00:21:01,880 --> 00:21:03,000
...مهلاً

273
00:21:03,000 --> 00:21:03,830
والدك؟

274
00:21:04,760 --> 00:21:07,380
ألم أقل أنّ كايدو هو والدي؟

275
00:21:11,140 --> 00:21:13,740
!مهلاً، لا داعي للخوف

276
00:21:13,740 --> 00:21:18,190
!لكنّني أكرهه! أخبرتكما أنّني أودن، صحيح؟

277
00:21:18,190 --> 00:21:19,980
!إنّ ذلك يربكنا أكثر

278
00:21:19,980 --> 00:21:23,290
.لا داعي للخوف. أنا أكره كايدو

279
00:21:23,290 --> 00:21:27,900
،حلمت بالخروج للبحر والمغامرات
!لذلك صرتُ أودن الّذي عاش بحرّيّة

280
00:21:27,900 --> 00:21:29,780
.إنّنا نفهم معظم الأمر

281
00:21:29,780 --> 00:21:31,990
!إنّنا نقدّر معاملتك

282
00:21:31,990 --> 00:21:34,290
!كفّا عن التّصرّف برسميّة وتعالا إلى هنا

283
00:21:34,290 --> 00:21:36,450
...إن كنت مصرًّا يا سيّدي

284
00:21:36,450 --> 00:21:37,660
!يكفي

285
00:21:37,660 --> 00:21:39,080
،لكن يا ياماتو

286
00:21:39,080 --> 00:21:42,710
!أين هو الرّجل الّذي حاول إنقاذ بلاد وانو الآن؟

287
00:21:42,710 --> 00:21:46,000
.مات إيس قبل سنتين

288
00:21:46,500 --> 00:21:49,130
أوتاما، أتعرفين إيس؟

289
00:21:49,130 --> 00:21:51,780
!نعم، كنّا مقرّبين كثيرًا

290
00:21:51,780 --> 00:21:56,320
كنتُ أحاول أن أصير كونويتشي
،واضعة ثقتي في إيس

291
00:21:56,320 --> 00:21:59,590
...لكنّ أخي الكبير لوفي قال بشكل غير حسّاس

292
00:22:00,810 --> 00:22:03,680
.مات إيس

293
00:22:04,650 --> 00:22:09,070
.قال ذلك لي فجأة وأحزنني كثيرًا

294
00:22:09,070 --> 00:22:13,450
.أنا آسفة. هكذا هو

295
00:22:13,450 --> 00:22:17,620
.لكن اسمعي يا أوتاما، عانى لوفي الأمرّين أيضًا

296
00:22:17,620 --> 00:22:18,620
...عندما حدث ذلك

297
00:22:18,620 --> 00:22:19,320
ماذا؟

298
00:22:19,750 --> 00:22:23,450
...لم نستطع فعل أيّ شيء وقتها أيضًا

299
00:22:24,000 --> 00:22:27,500
!فقد لوفي إيس أمام عينيه

300
00:22:29,130 --> 00:22:32,900
.فهمت. لم يعد معنا في هذه الحياة

301
00:22:32,900 --> 00:22:34,710
...لكن يا ياماتو

302
00:22:35,100 --> 00:22:36,010
...لكن

303
00:22:36,010 --> 00:22:39,680
.كنتُ في انتظار أخيه

304
00:22:39,980 --> 00:22:40,930
...فبوجود

305
00:22:41,940 --> 00:22:46,060
قبّعة القشّ لوفي الّذي ورث
...إرادة إيس، أستطيع أن

306
00:22:48,270 --> 00:22:49,980
!سُحقًا لك يا قبّعة القشّ

307
00:23:04,540 --> 00:23:08,380
يعمل زورو وماركو معًا لمواجهة
.هجمات أحد كبار النّجوم الشّرسة

308
00:23:08,380 --> 00:23:14,280
!نحو قمّة عالم القراصنة مع لوفي
!يهاجم زورو مصدّقًا بذلك بكلّ ما لديه

309
00:23:14,280 --> 00:23:18,430
يرى ماركو في شجاعته تلك
.صورة الزّميل الّذي أقسم بالولاء له

310
00:23:18,430 --> 00:23:21,720
!حتّى إن كان لن يراه أبدًا، فستدوم رابطتهما للأبد

311
00:23:22,390 --> 00:23:27,290
:في الحلقة القادمة من وان بيس
"!دموع ماركو! رابطة قراصنة اللّحية البيضاء"

312
00:23:27,290 --> 00:23:31,640
!ملك القراصنة، لن يكون إلاّ أنا