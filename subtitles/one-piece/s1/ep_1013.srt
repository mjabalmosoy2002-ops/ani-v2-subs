1
00:00:10,480 --> 00:00:17,660
مدّ يدك واقطع الرّياح

2
00:00:17,660 --> 00:00:22,330
ارسم خريطتك الخاصّة

3
00:00:26,920 --> 00:00:33,590
بينما نعيش أيّامنا كالبحار العاصفة

4
00:00:33,590 --> 00:00:40,060
فحتّى القيم الّتي أنشأناها أوشكت أن تنهار

5
00:00:40,060 --> 00:00:46,350
من يدري إن كانت البوصلة تشير للاتّجاه الصّحيح

6
00:00:46,350 --> 00:00:49,730
لا يمكن لأحد الجزم بذلك

7
00:00:49,730 --> 00:00:56,240
إن تنفّست بعمق وأغلقت أعينك

8
00:00:56,240 --> 00:01:03,200
فما سيظهر هو الطّريق الّذي ستكشفه روحك

9
00:01:03,200 --> 00:01:09,840
مدّ يدك واقطع الرّياح

10
00:01:09,840 --> 00:01:14,510
اركل الظّلمة بعيدًا

11
00:01:15,510 --> 00:01:22,720
أفعل ذلك من أجلي، وكذلك تفعل أنت، أليس كذلك؟

12
00:01:22,720 --> 00:01:26,600
وأنا جاهز لذلك

13
00:01:26,600 --> 00:01:32,360
بدعم شخص أستطيع الاعتماد عليه

14
00:01:32,360 --> 00:01:39,070
اغتنم المستقبل الّذي يفوق مخيّلتك

15
00:01:39,070 --> 00:01:45,790
مدّ يدك واقطع الرّياح

16
00:01:45,790 --> 00:01:51,420
اركل الظّلمة بعيدًا

17
00:01:51,420 --> 00:01:58,630
سنذهب حيث نريد الذّهاب، الدّموع والشّكوك ترافقنا

18
00:01:58,630 --> 00:02:03,430
فلنلوّنها بألواننا الخاصّة

19
00:02:14,280 --> 00:02:18,570
"!ماضي ياماتو! الرّجل الّذي أتى ساعيًا خلف اليونكو"

20
00:02:20,370 --> 00:02:22,370
!ذهب من هناك

21
00:02:22,370 --> 00:02:24,110
!انتظر

22
00:02:24,370 --> 00:02:27,580
،عندما يتّخذ الرّجل قراره
!فلا تحاولن الوقوف في طريقه

23
00:02:30,420 --> 00:02:32,500
...إنّه يتركنا ويغادر

24
00:02:32,500 --> 00:02:34,010
!توقّف

25
00:02:34,010 --> 00:02:35,920
!مهلاً لحظة

26
00:02:36,430 --> 00:02:38,490
،حتّى إن أخبرتماني أن أنتظر

27
00:02:38,490 --> 00:02:40,460
!لكنّني لا أستطيع فعل ذلك

28
00:02:44,690 --> 00:02:46,760
!سُحقًا! ما هذا؟

29
00:02:47,230 --> 00:02:48,690
!فكّي وثاقي

30
00:02:48,690 --> 00:02:51,650
...كفّ عن القتال هكذا

31
00:02:52,190 --> 00:02:55,650
.فتى سيّئ... لا تحاول الهرب

32
00:02:57,280 --> 00:02:59,020
...أنت

33
00:02:59,320 --> 00:03:03,240
.قلت أنّك أحببتني

34
00:03:13,510 --> 00:03:17,800
.ابق هنا للأبد. ستكون حيواني الأليف

35
00:03:17,800 --> 00:03:20,570
...ما هذا الهراء؟! أنا

36
00:03:20,570 --> 00:03:22,380
!عليّ الذّهاب

37
00:03:22,380 --> 00:03:23,760
...لكن

38
00:03:26,180 --> 00:03:27,550
...أينما نظرت

39
00:03:28,020 --> 00:03:29,640
...لا أرى سوى

40
00:03:29,860 --> 00:03:32,140
!النّساء، النّساء، النّساء

41
00:03:35,150 --> 00:03:36,770
...أهذه

42
00:03:36,770 --> 00:03:38,190
الجنّة؟

43
00:03:39,200 --> 00:03:41,400
.لا بدّ وأنّه فقد عقله

44
00:03:42,620 --> 00:03:45,900
،يا لظرافتك. مكافأة لك على ذلك

45
00:03:46,200 --> 00:03:48,790
.سأفتح باب الجنّة لك

46
00:03:48,790 --> 00:03:49,410
!كلاّ

47
00:03:50,120 --> 00:03:51,240
!هذه خدمة خاصّة

48
00:03:56,460 --> 00:03:58,420
!توقّف يا قبّعة القشّ

49
00:03:59,550 --> 00:04:03,050
!ستتأذّون إن لم تبتعدوا عن طريقي

50
00:04:10,440 --> 00:04:13,390
.أرى أنّ قبّعة القشّ سبقك

51
00:04:13,690 --> 00:04:17,230
...سيسبّب ذلك المشاكل لكايدو-سان

52
00:04:25,280 --> 00:04:27,200
...هلاّ توقّفت

53
00:04:27,910 --> 00:04:30,530
عن مضايقة أعواني؟

54
00:04:35,090 --> 00:04:40,500
.أنت شيتشيبوكاي سابق يا فارس البحر جينبي
كيف لك أن تكون صبيانيًّا هكذا؟

55
00:04:41,430 --> 00:04:44,930
!أنا ربّان سفينة طاقم قبّعة القشّ

56
00:04:45,220 --> 00:04:48,310
ألا يمكنك استعمال لقبي الأكثر قيمة؟

57
00:04:48,310 --> 00:04:50,550
.عفوًا، أنا آسف

58
00:04:51,100 --> 00:04:55,440
...رأيتك مرّة عندما كنتَ شيتشيبوكاي

59
00:04:55,440 --> 00:04:56,650
ماذا؟

60
00:04:56,650 --> 00:05:01,060
.يغيّر النّاس مواقفهم تمامًا أحيانًا

61
00:05:01,320 --> 00:05:06,780
.لذلك ربّما كنت أقف إلى جانبك في الماضي

62
00:05:07,580 --> 00:05:08,610
.جينبي

63
00:05:11,160 --> 00:05:13,240
.حسنًا، انس الأمر

64
00:05:13,460 --> 00:05:15,950
من تكون؟

65
00:05:16,250 --> 00:05:19,080
.من يدري؟ أتساءل من أكون

66
00:05:19,420 --> 00:05:23,790
.إن نزعتُ قناعك، فقد أتمكّن من التّعرّف إليك

67
00:05:26,050 --> 00:05:28,470
.لن يحدث ذلك

68
00:05:29,560 --> 00:05:31,640
.ها أنت ذي

69
00:05:32,310 --> 00:05:33,680
.شكرًا لك

70
00:05:34,480 --> 00:05:36,480
لـ-لماذا تضحك؟

71
00:05:36,480 --> 00:05:38,630
.أنا آسف

72
00:05:38,630 --> 00:05:40,020
...يذكّرني هذا بالماضي

73
00:05:40,570 --> 00:05:44,280
...ذكريات الجراح الّتي أصبته بها

74
00:05:44,280 --> 00:05:46,510
جراح أصبته بها؟

75
00:05:46,510 --> 00:05:49,030
إذًا قاتلته وهزمته؟

76
00:05:49,290 --> 00:05:50,610
...لا

77
00:05:51,120 --> 00:05:52,820
.بل خسرت

78
00:05:53,080 --> 00:05:56,330
.لكنّ فوزي أو خسارتي لم يكونا مهمّين

79
00:05:56,630 --> 00:05:57,490
،فكما ترى

80
00:05:59,880 --> 00:06:01,460
...معنى الحياة

81
00:06:01,880 --> 00:06:06,360
...كان هو بلا أدنى شكّ من علّمني ذلك

82
00:06:06,360 --> 00:06:08,050
.كان إيس

83
00:06:16,230 --> 00:06:19,230
...المكان الّذي قالوا أنّ الأطفال محتجزون فيه

84
00:06:19,400 --> 00:06:21,850
.لا بدّ أنّه هذه الجزيرة على ما يبدو

85
00:06:24,740 --> 00:06:26,270
.وصلنا أخيرًا

86
00:06:27,820 --> 00:06:29,930
...سأقاتلك

87
00:06:29,930 --> 00:06:31,740
!يا كايدو

88
00:06:38,880 --> 00:06:40,580
.هيّا بنا

89
00:06:41,670 --> 00:06:45,280
.ظننتُ أنّ حرّاس بوّابة أونيغاشيما سيكونون أقوى

90
00:06:45,280 --> 00:06:47,460
.خيّب هذا أملي

91
00:06:47,880 --> 00:06:52,390
.أنت، لا ترخي دفاعاتك
.عدوّنا هو ذلك اليونكو ذائع الصّيت

92
00:06:52,390 --> 00:06:54,130
.نعم، أعلم

93
00:06:55,600 --> 00:06:58,220
ماذا؟ لا أحد هنا؟

94
00:07:09,240 --> 00:07:10,780
!ثمّة دخلاء

95
00:07:11,700 --> 00:07:14,030
!كايدو هو الوحيد الّذي نحتاج لرؤيته

96
00:07:20,630 --> 00:07:21,550
!إيس

97
00:07:21,550 --> 00:07:24,170
!يا رفاق، اذهبوا لإنقاذ الأطفال بينما ذلك ممكن

98
00:07:24,170 --> 00:07:25,340
!مفهوم

99
00:07:25,340 --> 00:07:26,330
!دع الأمر لنا

100
00:07:29,010 --> 00:07:30,670
!يا له من شخص مثابر

101
00:07:36,180 --> 00:07:38,800
!من أنت؟! ما اسمك؟

102
00:07:39,480 --> 00:07:41,020
!أنت أوّلاً

103
00:07:45,490 --> 00:07:46,900
!أنا إيس

104
00:07:47,150 --> 00:07:49,360
!أنا هنا لقطع رأس كايدو

105
00:08:03,590 --> 00:08:06,120
!وجدتهم! تعالوا إلى هنا

106
00:08:08,510 --> 00:08:11,460
.لا تخفن. نحن هنا لإنقاذكنّ

107
00:08:11,680 --> 00:08:13,590
.هيّا، لنذهب

108
00:08:22,640 --> 00:08:24,390
.أنت قويّ

109
00:08:33,240 --> 00:08:34,190
!إيس

110
00:08:35,370 --> 00:08:37,450
!كلّ الأطفال بخير

111
00:08:37,450 --> 00:08:40,710
!لكن لا يمكنا العثور على هدفنا كايدو

112
00:08:40,710 --> 00:08:41,920
!ماذا؟

113
00:08:41,920 --> 00:08:45,750
.والدي والبقيّة ذهبوا في رحلة استطلاعيّة
،وفي الوقت الحاليّ

114
00:08:46,000 --> 00:08:47,920
!لا يوجد ولا أحد من ضبّاطه هنا

115
00:08:47,920 --> 00:08:49,380
!والدي؟

116
00:08:49,380 --> 00:08:50,630
!ماذا؟

117
00:08:50,630 --> 00:08:54,000
!أهي إذًا ابنة كايدو؟

118
00:08:56,140 --> 00:08:57,670
!أنا ياماتو

119
00:08:58,100 --> 00:09:01,090
!أظنّ أنّنا نلنا كفايتنا من هذه الفوضى

120
00:09:01,390 --> 00:09:05,500
،إن كان لديكم وقت لتتساءلوا من أكون
،فغادروا المكان في الحال

121
00:09:05,500 --> 00:09:08,640
!وأعيدوهنّ إلى عائلاتهنّ

122
00:09:10,900 --> 00:09:12,610
.ذلك هو هدفنا

123
00:09:13,530 --> 00:09:15,860
لكن ألن تضرّك حقيقة تركنا نذهب؟

124
00:09:15,860 --> 00:09:19,450
.لا يوجد ما يدفعني للدّفاع عن هذه الجزيرة

125
00:09:19,700 --> 00:09:24,830
قبل كلّ شيء، أكره رؤيتهم يختطفون
!هؤلاء الأطفال الصّغار

126
00:09:30,170 --> 00:09:35,100
أسمعتم ما قالته؟ إن لم يكن كايدو
.هنا، فلا جدوى من البقاء هنا

127
00:09:35,100 --> 00:09:36,250
!لنعد

128
00:09:47,650 --> 00:09:50,360
.حسنًا، لنعد إلى بلاد وانو

129
00:09:50,360 --> 00:09:52,320
!عائلاتكنّ في انتظاركنّ

130
00:09:52,320 --> 00:09:53,780
!أراحني هذا

131
00:09:53,780 --> 00:09:56,030
!أنا مدينة لكم لبقيّة حياتي

132
00:09:56,030 --> 00:09:57,680
.ما من داعٍ

133
00:09:57,680 --> 00:10:01,450
.الأهمّ الآن، أظهرن لعائلاتكنّ أنّكنّ بخير

134
00:10:01,450 --> 00:10:05,380
!شكرًا جزيلاً لكم! شكرًا لكم

135
00:10:05,380 --> 00:10:07,200
أواثق من هذا يا إيس؟

136
00:10:07,590 --> 00:10:10,040
.سنعود إلى اليابسة الرّئيسيّة بدونك

137
00:10:10,040 --> 00:10:14,750
.نعم، اهتمّوا بهم. سأوافيكم لاحقًا

138
00:10:19,380 --> 00:10:23,680
لستُ مقتنعًا أنّ شخصًا قويًّا مثلك
...ليس قائدًا أو ما شابه

139
00:10:24,140 --> 00:10:25,600
!سأسوّي هذا الأمر

140
00:10:25,600 --> 00:10:28,000
...نال منّي الملل على أيّة حال

141
00:10:28,000 --> 00:10:29,230
!سأقاتلك

142
00:10:40,450 --> 00:10:41,690
!قبضة النّار

143
00:11:03,270 --> 00:11:07,550
لماذا... لماذا  لم تخض غمار البحر
!إذا كنت بهذه القوّة؟

144
00:11:08,060 --> 00:11:09,970
...أريد ذلك، لكنّي لا أستطيع

145
00:11:10,230 --> 00:11:13,570
!لن تتمكّن من فهم مشاعري أبدًا

146
00:11:13,570 --> 00:11:14,600
!ماذا؟

147
00:11:15,200 --> 00:11:19,020
...سبب بقائي هنا بدل الخروج للبحر

148
00:11:20,120 --> 00:11:22,440
.خطؤه هو بالكامل

149
00:11:23,580 --> 00:11:25,280
...والدي

150
00:11:25,830 --> 00:11:26,990
!كايدو

151
00:11:28,420 --> 00:11:31,200
...خطؤه هو بالكامل

152
00:11:31,710 --> 00:11:33,750
...لا أصدّق أنّه والدي

153
00:11:34,550 --> 00:11:37,710
كلّ هذا خطأ والدك؟

154
00:11:39,760 --> 00:11:42,130
ما هذه الأعذار؟

155
00:11:44,470 --> 00:11:48,090
!لا يمكننا اختيار آبائنا يا ياماتو

156
00:12:04,490 --> 00:12:06,530
غول د. روجر؟

157
00:12:07,830 --> 00:12:12,190
تقصد غولد روجر؟ أتسألني إن كنت أعرفه؟

158
00:12:12,190 --> 00:12:17,870
ألا تدرك لماذا هنالك الكثير من
الدّمار في العالم بسبب القراصنة؟

159
00:12:17,880 --> 00:12:20,590
!كلّ ذلك خطأ روجر

160
00:12:20,970 --> 00:12:22,050
خطأ روجر؟

161
00:12:22,050 --> 00:12:30,500
سمعتُ أنّ قُبيل إعدامه، تفوّه بترّاهات
...عن كنز عظيم أو ما شابه

162
00:12:30,500 --> 00:12:34,970
ما دفع القراصنة الأغبياء الّذين
.صدّقوه ليعيثوا فسادًا

163
00:12:35,150 --> 00:12:38,940
!لم يكن يجدر أن يولد من الأساس

164
00:12:38,940 --> 00:12:41,280
!كان مجرّد وغد بلا قيمة

165
00:12:41,280 --> 00:12:44,280
!كان مصدر إزعاج، سواء حيًّا أو ميتًا

166
00:12:44,280 --> 00:12:45,990
روجر؟

167
00:12:45,990 --> 00:12:51,200
!لا تذكر الاسم الّذي يثير غثياني يا ولد
!أن تفسدي مشروبي هكذا! غادر

168
00:12:52,540 --> 00:12:54,120
!إلام تنظر؟

169
00:12:56,420 --> 00:12:59,750
!ما الّذي تفعله في رأيك أيّها الشّقيّ القذر؟

170
00:13:01,590 --> 00:13:06,130
.يا إيس؟ سمعتُ أنّك خارج السّيطرة هذه الأيّام

171
00:13:07,520 --> 00:13:08,390
.أيّها العجوز

172
00:13:12,650 --> 00:13:13,890
...هل تظنّ

173
00:13:17,030 --> 00:13:19,690
أنّني أستحقّ أن أولد؟

174
00:13:24,660 --> 00:13:26,860
...هذا شيء

175
00:13:28,450 --> 00:13:30,820
.ستعرفه بينما تعيش

176
00:13:35,160 --> 00:13:36,660
...لا يمكنك

177
00:13:38,000 --> 00:13:40,750
.اختيار والديك يا ياماتو

178
00:13:41,210 --> 00:13:45,420
!اخرس! ليس عليك إخباري بذلك

179
00:13:46,300 --> 00:13:48,470
أواثق من ذلك؟

180
00:13:48,470 --> 00:13:52,590
!ما دام هو والدي، فلن أكون حرًّا

181
00:13:54,810 --> 00:13:56,140
...كلّ ما أملكه

182
00:13:58,600 --> 00:14:00,500
...إ-إنّها ثقيلة

183
00:14:00,500 --> 00:14:02,770
!لماذا تكبّلني؟

184
00:14:02,770 --> 00:14:05,740
.لأنّك تفكّر بالأمور الخطأ

185
00:14:05,740 --> 00:14:09,740
!لا تملك ولو سببًا جيّدًا واحدًا لمغادرة الجزيرة

186
00:14:10,080 --> 00:14:15,160
!إن كنت ابني، صر أقوى منّي
!لا تفكّر في أيّ شيء آخر

187
00:14:15,460 --> 00:14:18,440
!كلاّ... انزع أغلالي

188
00:14:18,440 --> 00:14:20,910
!والدي

189
00:14:22,880 --> 00:14:25,380
كنتُ محتجزًا على هذه الجزيرة اللّعينة

190
00:14:26,010 --> 00:14:29,260
.وكُبّلتُ بالأغلال الّتي ستنفجر إن غادرتها

191
00:14:30,310 --> 00:14:34,970
.لا خيار لديّ سوى البقاء هنا طوال حياتي

192
00:14:36,150 --> 00:14:41,480
...فقط لأنّ ذلك الوغد المسمّى كايدو أنجبني

193
00:14:42,820 --> 00:14:47,190
،رغم أنّه لا مفرّ من تلك الأغلال
،فإن كنت تكره والدك لهذا الحدّ

194
00:14:47,190 --> 00:14:49,900
!فلماذا تسمح لها بأن تكبّل قلبك؟

195
00:14:51,950 --> 00:14:55,390
هل صرت أقوى لحماية والدك؟

196
00:14:55,390 --> 00:15:00,270
أم للتّنفيس عن غضبك بقتال شخص مثلي؟

197
00:15:00,270 --> 00:15:03,660
!كلاّ! صرت أقوى من أجل نفسك

198
00:15:07,010 --> 00:15:08,530
!ياماتو

199
00:15:08,530 --> 00:15:11,010
!ما الّذي تريد القيام به بالفعل؟

200
00:15:32,120 --> 00:15:33,950
.فكّر في الأمر

201
00:15:34,700 --> 00:15:37,370
...ألا تحمل الإجابة

202
00:15:37,370 --> 00:15:41,830
عميقًا، عميقًا داخل قلبك؟

203
00:15:44,710 --> 00:15:48,040
...عميقًا داخل قلبي

204
00:16:04,440 --> 00:16:06,560
...أ-أنا

205
00:16:07,780 --> 00:16:09,020
...أنا

206
00:16:42,310 --> 00:16:46,310
!ما الّذي تريد القيام به بالفعل؟

207
00:17:04,710 --> 00:17:09,080
!لا تملك ولو سببًا جيّدًا واحدًا لمغادرة الجزيرة

208
00:17:29,860 --> 00:17:31,100
...أعترف

209
00:17:32,070 --> 00:17:34,480
.كنت أكبح نفسي

210
00:17:34,910 --> 00:17:37,030
...لم يسعني سوى أن أحلم

211
00:17:37,490 --> 00:17:40,450
.لكنّي لم أستطع القيام بما أردت

212
00:17:41,250 --> 00:17:43,320
...هذه الأغلال المتفجّرة

213
00:17:43,830 --> 00:17:45,790
...ابن كايدو

214
00:17:46,380 --> 00:17:48,690
...حلم مستحيل

215
00:17:48,690 --> 00:17:51,630
".سأظلّ عالقًا على هذه الجزيرة اللّعينة"

216
00:17:51,630 --> 00:17:53,340
".لا خيار لديّ"

217
00:17:53,340 --> 00:17:55,970
".كلّ هذا خطأ والدي"

218
00:17:55,970 --> 00:17:57,590
.هذا ما كنت أقنع نفسي به

219
00:17:58,720 --> 00:18:00,550
.لكنّني أدركت الآن

220
00:18:01,230 --> 00:18:05,390
!أريد خوض غمار البحر والذّهاب في مغامرة

221
00:18:05,690 --> 00:18:08,850
!أريد أن أعيش بحرّيّة مثل أودن

222
00:18:09,780 --> 00:18:12,690
...إلى البحر

223
00:18:12,900 --> 00:18:15,310
...وأغادر هذه الجزيرة التّعيسة

224
00:18:15,740 --> 00:18:19,070
!أريد أن أعيش بحرّيّة

225
00:18:23,160 --> 00:18:24,910
!هذا هو الجواب يا ياماتو

226
00:18:38,720 --> 00:18:40,300
.هذا ما يجب أن يكون

227
00:18:41,810 --> 00:18:43,550
.صرت تعلم ما العمل الآن

228
00:18:51,860 --> 00:18:53,100
!نعم

229
00:19:01,700 --> 00:19:05,950
لا أصدّق أنّ المطاف انتهى به هكذا
.مع شخص أتى ليقتل والدي

230
00:19:07,040 --> 00:19:08,830
.إذًا فأنت تحبّ والدك

231
00:19:08,830 --> 00:19:10,420
!ذلك مستحيل

232
00:19:10,420 --> 00:19:15,090
.يا إلهي! لا تنفكّ تهاجم نقاط ضعفي

233
00:19:15,090 --> 00:19:16,470
.آسف، آسف

234
00:19:16,470 --> 00:19:18,750
هل أنت آسف فعلاً؟

235
00:19:25,600 --> 00:19:27,050
.والآن يا إيس

236
00:19:27,730 --> 00:19:29,010
.أخبرني

237
00:19:29,400 --> 00:19:32,480
...عنك وعن مغامراتك

238
00:19:32,900 --> 00:19:34,560
...وعن العالم

239
00:19:34,780 --> 00:19:37,060
.وعن كلّ شيء وأيّ شيء

240
00:19:38,490 --> 00:19:39,820
.حسنًا

241
00:19:40,870 --> 00:19:44,030
.لكنّ ذلك سيأخذ وقتًا طويلاً، فاستعدّ

242
00:19:46,990 --> 00:19:50,120
!وعاد للمنزل في حالة يرثى لها

243
00:19:50,120 --> 00:19:54,540
تسبّب لي بالكثير من المتاعب
!فعلاً عندما كنّا أطفالاً

244
00:19:54,840 --> 00:19:57,250
!أخوك هذا مثير للاهتمام

245
00:19:57,250 --> 00:19:57,790
!فعلاً؟

246
00:19:58,630 --> 00:20:01,130
!أخبرني، كيف هي الأمور في الخارج؟

247
00:20:01,130 --> 00:20:03,680
!أهنالك الكثير من اليافعين يسعون للشّهرة؟

248
00:20:03,680 --> 00:20:06,340
...اليافعين؟ لنرَ

249
00:20:06,730 --> 00:20:09,270
.يتحدّث الجميع عن شخص يدعى كافن-شيء ما

250
00:20:09,270 --> 00:20:10,850
!فعلاً؟

251
00:20:10,850 --> 00:20:13,580
،حسنًا، أنا في مستوى مختلف وحدي

252
00:20:13,580 --> 00:20:17,440
لكنّي سمعت عن بعض الأشخاص الخطرين
.يعيثون فسادًا في كلّ البحار

253
00:20:17,440 --> 00:20:18,780
!نعم، نعم

254
00:20:18,780 --> 00:20:20,920
...كيد من الأزرق الجنوبيّ

255
00:20:20,920 --> 00:20:23,860
.ولو من الشّماليّ وبيجي من الغربيّ

256
00:20:24,950 --> 00:20:28,370
لكنّ الأشدّ من بينهم سيخرج للبحر
...بعد بضعة سنوات

257
00:20:28,580 --> 00:20:30,490
!وهو أخي الصّغير

258
00:20:31,410 --> 00:20:34,000
!سيكون قويًّا للغاية

259
00:20:34,000 --> 00:20:37,260
كم مرّة ستذكر فيها أخاك الصّغير؟

260
00:20:37,260 --> 00:20:39,250
!من يهتمّ؟ استمع فحسب

261
00:20:39,250 --> 00:20:40,470
!هذا مؤلم، مؤلم

262
00:20:40,470 --> 00:20:41,970
!أنت... هذا مؤلم

263
00:20:41,970 --> 00:20:43,500
!يكفي، توقّف

264
00:20:48,020 --> 00:20:50,440
...يا له من صديق مذهل

265
00:20:50,440 --> 00:20:56,020
.نعم. في الحقيقة، أنا من كسر تمثال التّنّين هذا

266
00:20:57,070 --> 00:20:58,770
،لكنّه قال

267
00:20:59,360 --> 00:21:04,950
"!هذا تحذير منّي لكايدو لإعلامه أنّني سأعود ثانية"

268
00:21:04,950 --> 00:21:06,510
...فهمت

269
00:21:06,510 --> 00:21:10,540
لم أكن أعلم أنّ هنالك قرصانًا
...حاول إنقاذ بلاد وانو

270
00:21:10,540 --> 00:21:12,770
،أغضب ذلك والدي كثيرًا

271
00:21:12,770 --> 00:21:15,160
.لكن في النّهاية، لم يعد إيس

272
00:21:15,880 --> 00:21:17,000
...مهلاً

273
00:21:17,000 --> 00:21:17,830
والدك؟

274
00:21:18,760 --> 00:21:21,380
ألم أقل أنّ كايدو هو والدي؟

275
00:21:25,140 --> 00:21:27,740
!مهلاً، لا داعي للخوف

276
00:21:27,740 --> 00:21:32,190
!لكنّني أكرهه! أخبرتكما أنّني أودن، صحيح؟

277
00:21:32,190 --> 00:21:33,980
!إنّ ذلك يربكنا أكثر

278
00:21:33,980 --> 00:21:37,290
.لا داعي للخوف. أنا أكره كايدو

279
00:21:37,290 --> 00:21:41,900
،حلمت بالخروج للبحر والمغامرات
!لذلك صرتُ أودن الّذي عاش بحرّيّة

280
00:21:41,900 --> 00:21:43,780
.إنّنا نفهم معظم الأمر

281
00:21:43,780 --> 00:21:45,990
!إنّنا نقدّر معاملتك

282
00:21:45,990 --> 00:21:48,290
!كفّا عن التّصرّف برسميّة وتعالا إلى هنا

283
00:21:48,290 --> 00:21:50,450
...إن كنت مصرًّا يا سيّدي

284
00:21:50,450 --> 00:21:51,660
!يكفي

285
00:21:51,660 --> 00:21:53,080
،لكن يا ياماتو

286
00:21:53,080 --> 00:21:56,710
!أين هو الرّجل الّذي حاول إنقاذ بلاد وانو الآن؟

287
00:21:56,710 --> 00:22:00,000
.مات إيس قبل سنتين

288
00:22:00,500 --> 00:22:03,130
أوتاما، أتعرفين إيس؟

289
00:22:03,130 --> 00:22:05,780
!نعم، كنّا مقرّبين كثيرًا

290
00:22:05,780 --> 00:22:10,320
كنتُ أحاول أن أصير كونويتشي
،واضعة ثقتي في إيس

291
00:22:10,320 --> 00:22:13,590
...لكنّ أخي الكبير لوفي قال بشكل غير حسّاس

292
00:22:14,810 --> 00:22:17,680
.مات إيس

293
00:22:18,650 --> 00:22:23,070
.قال ذلك لي فجأة وأحزنني كثيرًا

294
00:22:23,070 --> 00:22:27,450
.أنا آسفة. هكذا هو

295
00:22:27,450 --> 00:22:31,620
.لكن اسمعي يا أوتاما، عانى لوفي الأمرّين أيضًا

296
00:22:31,620 --> 00:22:32,620
...عندما حدث ذلك

297
00:22:32,620 --> 00:22:33,320
ماذا؟

298
00:22:33,750 --> 00:22:37,450
...لم نستطع فعل أيّ شيء وقتها أيضًا

299
00:22:38,000 --> 00:22:41,500
!فقد لوفي إيس أمام عينيه

300
00:22:43,130 --> 00:22:46,900
.فهمت. لم يعد معنا في هذه الحياة

301
00:22:46,900 --> 00:22:48,710
...لكن يا ياماتو

302
00:22:49,100 --> 00:22:50,010
...لكن

303
00:22:50,010 --> 00:22:53,680
.كنتُ في انتظار أخيه

304
00:22:53,980 --> 00:22:54,930
...فبوجود

305
00:22:55,940 --> 00:23:00,060
قبّعة القشّ لوفي الّذي ورث
...إرادة إيس، أستطيع أن

306
00:23:02,270 --> 00:23:03,980
!سُحقًا لك يا قبّعة القشّ

307
00:23:18,540 --> 00:23:22,380
يعمل زورو وماركو معًا لمواجهة
.هجمات أحد كبار النّجوم الشّرسة

308
00:23:22,380 --> 00:23:28,280
!نحو قمّة عالم القراصنة مع لوفي
!يهاجم زورو مصدّقًا بذلك بكلّ ما لديه

309
00:23:28,280 --> 00:23:32,430
يرى ماركو في شجاعته تلك
.صورة الزّميل الّذي أقسم بالولاء له

310
00:23:32,430 --> 00:23:35,720
!حتّى إن كان لن يراه أبدًا، فستدوم رابطتهما للأبد

311
00:23:36,390 --> 00:23:41,290
:في الحلقة القادمة من وان بيس
"!دموع ماركو! رابطة قراصنة اللّحية البيضاء"

312
00:23:41,290 --> 00:23:45,640
!ملك القراصنة، لن يكون إلاّ أنا