1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,480
...اسعوا نحو الحرّيّة

3
00:00:13,480 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,360 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:57,990 --> 00:02:01,060
...سمعتُ الإشاعات عنك للتّوّ

22
00:02:01,630 --> 00:02:02,960
ألديك شأن ما معي؟

23
00:02:02,960 --> 00:02:06,430
!نعم! أعد ذهب العمّ ذو الرّأس الماسيّ

24
00:02:06,430 --> 00:02:08,030
ذهب؟

25
00:02:09,430 --> 00:02:12,670
تقصد أغراض العجوز كريكت؟

26
00:02:25,750 --> 00:02:31,190
لماذا عليّ إعادتها؟
.سرقت أشياءه بصفتي قرصانًا

27
00:02:31,190 --> 00:02:36,060
وبما أنّك قرصان أيضًا، فلستَ في موضع
!يخوّلك لترى ما فعلتُه خاطئًا

28
00:02:36,060 --> 00:02:36,930
.وأنا أيضًا

29
00:02:37,760 --> 00:02:42,200
.إنّهم أصدقائي. لذلك سأسرقها منك

30
00:02:49,510 --> 00:02:54,710
رجل المائة مليون! أعظم قوّة"
"!في العالم وقراصنة اللّحية السّوداء

31
00:03:00,890 --> 00:03:04,020
!أكره أن أسأل هذا، لكن أبإمكانك القتال؟

32
00:03:04,020 --> 00:03:06,560
!هل تعرف حتّى كيف تلكم؟

33
00:03:08,330 --> 00:03:11,430
!ما الّذي باستطاعة جبان مثلك فعله؟

34
00:03:13,800 --> 00:03:17,770
!لا-لا شكّ في الأمر! إنّه هو

35
00:03:18,170 --> 00:03:22,310
!أنت، أما زلت تحمل تلك؟
!مزّقها وارمها في الحال

36
00:03:22,310 --> 00:03:25,940
...لكن إن كان هذا الملصق حقيقيًّا

37
00:03:25,940 --> 00:03:29,750
حتّى بيلامي لا فرصة أمامه لمواجهة
!قرصان مكافأته مائة مليون

38
00:03:30,510 --> 00:03:36,620
!هذا سخيف! انظر لذلك الشّقيّ فحسب
!هل يبدو شخصًا شنيعًا؟

39
00:03:36,620 --> 00:03:39,720
يجعلني ذلك أشكّك في ملصق
!مكافأته ذو الثّلاثين مليون أيضًا

40
00:03:39,720 --> 00:03:42,690
إن تسمّرتَ مكانك خوفًا كما
،فعلتَ هذا المساء

41
00:03:42,690 --> 00:03:47,130
!فلن تسرق أيّ شيء منّي أيّها الجبان

42
00:03:47,570 --> 00:03:50,030
.ما حدث هذا المساء كان مختلفًا

43
00:03:52,100 --> 00:03:55,340
فعلاً؟ وكيف هو مختلف يا ترى؟

44
00:03:55,340 --> 00:03:59,640
هذه المرّة، سأغلق فمك
!المتذاكي ذاك للأبد

45
00:04:02,380 --> 00:04:03,610
!إنّه ينهار

46
00:04:03,610 --> 00:04:06,280
!سأنهي أمرك في رمشة عين

47
00:04:06,280 --> 00:04:08,090
...النّابض

48
00:04:08,090 --> 00:04:09,720
!القانص

49
00:04:14,060 --> 00:04:16,390
!انظروا! لقد حلّق قبّعة القشّ أيضًا

50
00:04:22,100 --> 00:04:23,700
...حثالة هاوٍ

51
00:04:28,270 --> 00:04:31,140
!لماذا قدم ذلك الشّقيّ إلى هنا؟

52
00:04:32,040 --> 00:04:35,550
!لنجلس جميعًا ونستمتع بعرض بيلامي

53
00:04:36,480 --> 00:04:40,220
،كان يقول كلامًا كبيرًا
!لكنّه يهرب فحسب الآن

54
00:04:42,990 --> 00:04:45,290
...لم يختلف أيّ شيء

55
00:04:49,690 --> 00:04:52,530
!الأمر تمامًا كما هذا المساء

56
00:04:56,530 --> 00:04:59,670
!ستسرق الذّهب ثانية منّي؟

57
00:04:59,670 --> 00:05:03,410
،ما أنت إلاّ ضعيف ثرثار
،لا يستطيع أبدًا مواجهتي

58
00:05:03,410 --> 00:05:08,750
وعاجز عن فعل أيّ شيء
!سوى التّفاخر بالأحلام

59
00:05:10,720 --> 00:05:11,650
!إنّه قادم ناحيتنا

60
00:05:11,650 --> 00:05:12,080
!اهربوا

61
00:05:18,020 --> 00:05:19,560
...كافح كما تشاء

62
00:05:19,560 --> 00:05:23,090
!لا مهرب من قوّة فاكهة النّابض خاصّتي

63
00:05:23,490 --> 00:05:25,560
!انتهى أمره سلفًا؟ هذا مثير للشّفقة

64
00:05:26,260 --> 00:05:29,270
من المستحيل أن تكون لذلك الفتى
!فرصة أمام بيلامي

65
00:05:32,740 --> 00:05:34,910
لم يقتلك ذلك، صحيح؟

66
00:05:39,480 --> 00:05:40,280
!لقد وقف

67
00:05:42,850 --> 00:05:45,080
!ما زال الوقت باكرًا على الموت

68
00:05:45,080 --> 00:05:48,590
!بدأ عرضي يدخل فصله الجيّد

69
00:05:48,590 --> 00:05:50,690
...النّابض

70
00:05:50,690 --> 00:05:52,220
!الواثب

71
00:06:00,530 --> 00:06:02,170
!اختفى بيلامي

72
00:06:02,170 --> 00:06:04,840
!فعل هذا عندما قتل روشيو الجلاّد

73
00:06:04,840 --> 00:06:07,540
!إنّهم أصدقاؤك؟

74
00:06:09,040 --> 00:06:13,810
بالمناسبة، كان ذلك العجوز وذلاكما
!القردان الضّخمان مثلك تمامًا

75
00:06:13,810 --> 00:06:16,850
أنتم مجموعة حمقى بالفطرة
تصدّقون قصّة ملفّقة

76
00:06:16,850 --> 00:06:18,880
!رواها رجل ما قبل 400 سنة

77
00:06:18,880 --> 00:06:21,890
!مدينة ذهب؟ جزيرة سماء؟

78
00:06:21,890 --> 00:06:26,290
عصر الأحلام قد ولّى
!أيّها القراصنة المثيرون للشّفقة

79
00:06:26,920 --> 00:06:29,760
سألتَ هل أعرف كيف ألكُم؟

80
00:06:31,300 --> 00:06:36,100
نل منه يا بيلامي! ذلك الأحمق
!ليس أهلاً ليعيش في الواقع

81
00:06:37,800 --> 00:06:39,800
!الوداع يا قبّعة القشّ

82
00:07:14,570 --> 00:07:17,580
...مهلاً... كفّ عن المزاح يا بيلامي

83
00:07:17,580 --> 00:07:19,780
!هيّا! أنت تمزح، صحيح؟

84
00:07:20,380 --> 00:07:21,380
!قُل شيئًا

85
00:07:25,620 --> 00:07:28,390
!يا بيلامي! كفاك تظاهرًا

86
00:07:28,820 --> 00:07:32,820
هيّا، انهض! واصل عرضك
!المعتاد يا بيلامي

87
00:07:33,090 --> 00:07:37,090
أنت المبتدئ عالي الشّأن
!صاحب مكافأة 55 مليون

88
00:07:37,500 --> 00:07:40,000
!هذا صحيح! إنّهما من كانا هنا هذا المساء

89
00:07:45,000 --> 00:07:48,510
!مكافآتهما أعلى من مكافأتك يا بيلامي

90
00:07:50,910 --> 00:07:53,410
!...أ-أرأيت؟ لقد أخبرتك

91
00:07:56,280 --> 00:07:59,380
.أعيدوا ذهب العمّ

92
00:08:15,970 --> 00:08:18,400
!إنّهم أقوياء جدًّا

93
00:08:18,400 --> 00:08:21,340
...تعرّضوا للضّرب، لكنّهم بخير الآن

94
00:08:22,370 --> 00:08:27,080
،أعلم أنّ تشوبّر عالجهم
...لكن يبدو وكأنّهم خالدون

95
00:08:29,080 --> 00:08:31,220
لماذا لم تذهب أيضًا؟

96
00:08:31,220 --> 00:08:32,650
!ماذا؟ ما خطبك؟

97
00:08:33,120 --> 00:08:37,620
!تقولين "لا تقاتل! افعل هذا
"!لا تذهب! اذهب

98
00:08:38,020 --> 00:08:41,330
!كلاّ! ما أعنيه أنّهم هزموك أيضًا

99
00:08:45,130 --> 00:08:46,900
هزموني؟

100
00:08:46,900 --> 00:08:51,170
ليس وكأنّهم كانوا يعترضون
.طريقنا أو ما شابه

101
00:08:51,870 --> 00:08:54,910
إنّ القتالات الّتي لا تكون نتيجتها
.سوى الشّفقة تكون صعبة

102
00:08:55,310 --> 00:08:58,040
ماذا؟ هل أنت غبيّ؟

103
00:08:58,040 --> 00:09:00,810
!اخرسي واغربي عن وجهي
!أنت تعترضين طريقنا

104
00:09:00,810 --> 00:09:03,980
!ماذا قلت؟! أنت من لا يسمع أبدًا

105
00:09:03,980 --> 00:09:06,250
لماذا عليّ الاستماع لك؟

106
00:09:04,650 --> 00:09:08,250
!مهلاً، مهلاً، كونا أكثر حذرًا أيّها الغبيّان

107
00:09:06,250 --> 00:09:10,090
أتساءل بشأن ذلك؟
!ربّما لأنّي على صواب دائمًا

108
00:09:08,250 --> 00:09:11,320
...هذه السّفينة هي أغلى كنوزنا

109
00:09:10,090 --> 00:09:12,760
!اغربي عن وجهي فحسب

110
00:09:11,320 --> 00:09:12,990
!مهلاً، مهلاً، يكفي أيّها الوغدان

111
00:09:12,760 --> 00:09:13,460
ماذا قلت؟

112
00:09:12,990 --> 00:09:14,190
!كفى أيّها الوغدان

113
00:09:13,460 --> 00:09:14,190
!كفّ عن قول ذلك

114
00:09:20,300 --> 00:09:21,830
!حصلتُ عليه

115
00:09:22,430 --> 00:09:25,840
!ذلك الشّقيّ... ضربة حظّ

116
00:09:27,510 --> 00:09:28,840
!أنت

117
00:09:28,840 --> 00:09:31,610
!توقّف! ما زلتُ أنا هنا

118
00:09:31,610 --> 00:09:32,880
!هيّا! أرني ما لديك

119
00:09:33,580 --> 00:09:36,210
من المستحيل أن نخسر أمام
!حمقى يطاردون الأحلام

120
00:09:36,210 --> 00:09:39,580
!ما الخطب؟! يا قبّعة القشّ
!إلى أين أنت ذاهب؟

121
00:09:42,090 --> 00:09:42,920
إلى أين؟

122
00:09:47,760 --> 00:09:48,490
!السّماء

123
00:10:02,840 --> 00:10:06,480
إذًا فهؤلاء هم من هزموا السّير كروكودايل

124
00:10:06,480 --> 00:10:09,650
...أحد الشّيتشيبوكاي الملكيّين

125
00:10:09,980 --> 00:10:14,120
...مونكي د. لوفي... ورورونوا زورو

126
00:10:14,120 --> 00:10:15,850
!مهارة أسلوب السّيوف الثّلاثة السّرّيّة

127
00:10:17,660 --> 00:10:19,290
!العوالم الثّلاثة آلاف

128
00:10:24,030 --> 00:10:26,360
...النّدوب في الظّهر هي عار السّيّاف

129
00:10:27,000 --> 00:10:27,800
!مثير للإعجاب

130
00:10:31,970 --> 00:10:36,570
!حاول التّغلّب عليّ يا رورونوا زورو

131
00:10:39,440 --> 00:10:44,280
إذًا فأولئك الأطفال كبروا لدرجة أنّ
...حكومة العالم لا تستطيع تجاهلهم

132
00:11:10,520 --> 00:11:12,850
!ماذا؟ أحمر الشّعر؟

133
00:11:13,220 --> 00:11:15,320
...نعم. تصرّفاته تثير القلق

134
00:11:16,190 --> 00:11:18,820
لكن أفترض أنّه لم يقم
بأيّ حركة بنفسه؟

135
00:11:18,820 --> 00:11:21,690
،صحيح. قام بذلك بشكل غير مباشر
...باستعمال رسول

136
00:11:22,160 --> 00:11:26,030
لكن من الخطير جدًّا للّحية البيضاء
!وأحمر الشّعر أن يتواصلا معًا

137
00:11:26,500 --> 00:11:28,700
.نعم، هذا صحيح

138
00:11:29,170 --> 00:11:32,570
،لكنّ أحمر الشّعر لا يثير القلق إلاّ إن استُفزّ

139
00:11:32,570 --> 00:11:35,740
إنّه ليس من الرّجال الّذين
.قد يغيّر العالم بمفرده

140
00:11:35,740 --> 00:11:38,280
.لنتحلّ بالصّبر ونراقب

141
00:11:38,280 --> 00:11:40,550
.الشّيتشيبوكاي أكثر أهمّيّة الآن

142
00:11:40,550 --> 00:11:42,880
.علينا إيجاد بديل لكروكودايل بسرعة

143
00:11:43,680 --> 00:11:46,120
.لا تستخفّوا بخسارته

144
00:11:46,120 --> 00:11:50,760
إنّ الانهيار في توازن القوى الثّلاثة
.العظمى سيمزّق العالم بحدّ ذاته

145
00:11:51,160 --> 00:11:52,720
.يجب المحافظة على التّوازن

146
00:11:52,720 --> 00:11:56,560
حاضر! لهذا السّبب قمنا باستدعاء
،الشّيتشيبوكاي إلى هنا

147
00:11:56,990 --> 00:11:59,130
.لكن لا ندري كم منهم سيحضر

148
00:12:00,030 --> 00:12:03,030
...إنّهم قراصنة. يقومون بما يحلو لهم

149
00:12:03,030 --> 00:12:06,640
.سُحقًا لك يا كروكودايل
...وضعتنا في وضع مروّع

150
00:12:07,410 --> 00:12:12,480
ما عدنا نستطيع ترك هذا الرّجل
...الّذي هزمك حرًّا طليقًا

151
00:12:13,140 --> 00:12:15,650
...مونكي د. لوفي

152
00:12:19,220 --> 00:12:21,650
.من مقرّ البحريّة الرّئيسيّ إلى ماريجوا

153
00:12:21,650 --> 00:12:25,390
إنّ الشّيتشيبوكاي الملكيّان
دونكيهوتي دوفلامينغو-ساما

154
00:12:25,390 --> 00:12:28,460
.وبارثولوميو كوما-ساما وصلا

155
00:12:40,100 --> 00:12:43,370
!مهلاً! توقّف! ماذا تفعل؟

156
00:12:43,710 --> 00:12:45,840
!لا أفعل شيئًا! تتحرّك يداي من تلقاء نفسها

157
00:12:45,840 --> 00:12:48,350
!لا تتصرّف بحماقة! هذا ليس وقتًا للمزاح

158
00:12:48,350 --> 00:12:51,650
!لستُ أمزح! لا يمكنني التّحكّم بجسدي

159
00:12:51,650 --> 00:12:54,120
!كيف لا تستطيع...؟! أعجز عن التّنفّس

160
00:12:54,120 --> 00:12:56,290
!توقّفا! ماذا تظنّان أنّكما فاعلان؟

161
00:12:57,090 --> 00:12:58,520
هل تحاول قتلي؟

162
00:12:58,520 --> 00:12:59,190
!ليس أنا

163
00:12:59,190 --> 00:13:02,490
!توقّفا! ألا تدركان أين أنتما؟

164
00:13:03,900 --> 00:13:06,400
!دوفلامينغو! هذا من صنيعك
!أوقف هذا في الحال

165
00:13:10,440 --> 00:13:17,040
،إذًا ابدأ بالكلام بسرعة
!وإلاّ أنهيتُ هذا الاجتماع الرّديء

166
00:13:21,650 --> 00:13:23,950
!مهلاً! توقّف أيّها الغبيّ

167
00:13:23,950 --> 00:13:26,820
!توقّف! أوقفه يا دوفلامينغو
!اللّعنة عليك

168
00:13:27,290 --> 00:13:28,390
!هذا يكفي

169
00:13:28,920 --> 00:13:33,060
!لا تتصرّفوا بحماقة
!هل أتيتم إلى هنا لبدء حرب؟

170
00:13:41,270 --> 00:13:45,670
.أعتذر على ترحيبي المتأخّر
.شكرًا لقدومكم يا حثالة البحر

171
00:13:46,670 --> 00:13:50,440
...مهلاً، مهلاً. استمعوا لهذه الكلمات الكبيرة

172
00:13:51,480 --> 00:13:55,510
.فلنبدأ. أشكّ في وصول البقيّة

173
00:13:55,510 --> 00:14:00,020
.اثنان من أصل ستّة أكثر ممّا توقّعت

174
00:14:00,020 --> 00:14:01,520
.أراهن على ذلك

175
00:14:01,520 --> 00:14:06,490
لم أنوِ على المجيء أيضًا، لكنّ شؤون
...جزيرتي تسير على ما يرام

176
00:14:09,190 --> 00:14:11,200
.لدرجة أنّني أتيتُ بدافع الملل

177
00:14:11,200 --> 00:14:13,700
.فهمت. سماع هذا يثير قلقي

178
00:14:14,000 --> 00:14:19,070
لا يوجد ما هو أكثر إحباطًا لنا
.من صناعة قراصنة مزدهرة

179
00:14:21,070 --> 00:14:23,780
!إنّك لا تخشى المجابهة أبدًا

180
00:14:24,440 --> 00:14:28,510
إنّك تخون لقب "البوذا" هكذا
!أيّها الأميرال سِنغوكو

181
00:14:31,220 --> 00:14:33,990
...أسمع مشادّات كلاميّة مملّة

182
00:14:35,550 --> 00:14:38,820
هل تُراني أتيتُ للمكان الخطأ؟

183
00:14:38,820 --> 00:14:39,990
!عين الصّقر

184
00:14:40,290 --> 00:14:42,390
.مقرّ البحريّة الرّئيسيّ والشّيتشيبوكاي

185
00:14:42,390 --> 00:14:47,100
تبدو تلك الطّاولة المستديرة
.بلا مغزى لهاتين القوّتين المتعارضتين

186
00:14:47,630 --> 00:14:51,740
!يا إلهي! وصل رجل لم نكن نتوقّعه

187
00:14:52,140 --> 00:14:54,040
...هل يُعقل أنّك

188
00:14:55,340 --> 00:14:57,980
.ماذا؟ أنا هنا كمتفرّج فحسب

189
00:14:58,580 --> 00:15:02,480
أنا مهتمّ قليلاً ببعض القراصنة المتورّطين
.في المسألة الّتي نحن بصددها

190
00:15:03,310 --> 00:15:04,550
.هذا كلّ شيء

191
00:15:04,550 --> 00:15:09,250
...في تلك الحالة، أنا متفرّج أيضًا
أهذا مقبول؟

192
00:15:10,290 --> 00:15:14,330
...حسنًا، أفترض أنّني لست "متفرّجًا" بالضّبط

193
00:15:14,960 --> 00:15:18,430
!من تكون؟! كيف دخلتَ إلى هنا؟

194
00:15:18,760 --> 00:15:22,130
...لكن يا لها من مجموعة متميّزة هنا

195
00:15:22,630 --> 00:15:25,900
...أتيتُ وكلّي أمل

196
00:15:29,910 --> 00:15:32,580
...أن يُسمح لي بالانضمام لاجتماعكم

197
00:15:35,650 --> 00:15:37,580
.إن كان ذلك ممكنًا

198
00:15:38,720 --> 00:15:42,950
أعتقد فعلاً أنّكم سحبتم من كروكودايل لقبه

199
00:15:43,450 --> 00:15:46,490
وتبحثون الآن عن بديل له؟

200
00:15:47,590 --> 00:15:50,190
!أنت... هل أنت لافيت؟

201
00:15:50,830 --> 00:15:51,930
لافيت؟

202
00:15:51,930 --> 00:15:54,870
هل تعرف اسمي؟

203
00:15:55,370 --> 00:15:57,170
!هذا شرف كبير لي

204
00:15:57,640 --> 00:16:00,910
إنّه ضابط سلام معروف جدًّا
!في الأزرق الغربيّ

205
00:16:01,510 --> 00:16:04,580
تمّ طرده من بلاده بسبب
!استعماله للعنف المفرط

206
00:16:05,640 --> 00:16:07,110
.كان ذلك منذ زمن بعيد

207
00:16:07,610 --> 00:16:11,220
!هويّتي ليست بالأمر المهمّ

208
00:16:11,220 --> 00:16:16,250
أتيتُ لأقترح اسم رجل معيّن
.ليحمل لقب الشّيتشيبوكاي

209
00:16:19,960 --> 00:16:23,530
شانكس... يعيد لي هذا
...الاسم الذّكريات

210
00:16:24,400 --> 00:16:27,130
إذًا فهذه رسالة من شانكس؟

211
00:16:27,130 --> 00:16:31,770
،نعم. يبدو أنّها بالغة الأهمّيّة
!لذلك كلّفني بتبليغها

212
00:16:31,770 --> 00:16:34,910
!فهمت! أحسنت عملاً

213
00:16:34,910 --> 00:16:38,740
.كلاّ، ما زلتُ حديث العهد بين قراصنة أحمر الشّعر

214
00:16:40,980 --> 00:16:43,310
،رغم أنّني كنتُ قرصانًا من قبل

215
00:16:43,310 --> 00:16:46,720
...وأعتقد أنّ اسمي صار معروفًا

216
00:16:47,050 --> 00:16:50,690
!أنتم! سمعتم بروكستار من قبل، صحيح؟

217
00:16:51,390 --> 00:16:53,890
.كلاّ. لم أسمع به من قبل

218
00:16:53,890 --> 00:16:57,200
...على أيّ حال، كان مذاق ملك البحر

219
00:17:00,130 --> 00:17:01,770
!مهلاً! ما الّذي...؟

220
00:17:01,770 --> 00:17:05,240
...يبعث لي برسالة لعينة

221
00:17:05,240 --> 00:17:09,510
منذ متى أصبح ذلك الفتى
!شخصًا بالغ الأهمّيّة هكذا؟

222
00:17:11,010 --> 00:17:12,780
!مهلاً! تمهّل قليلاً

223
00:17:13,240 --> 00:17:16,010
!لقد تصرّف وكأنّ هذه كانت رسالة مهمّة

224
00:17:17,220 --> 00:17:20,620
!أنت تتعامل مع أحمر الشّعر هنا
!هل فقدت عقلك؟

225
00:17:21,390 --> 00:17:23,250
!أنا اللّحية البيضاء

226
00:17:26,190 --> 00:17:29,130
أيّها القائد. ربّما عليك التّقليل
...من شرب الكحول حاليًّا

227
00:17:29,130 --> 00:17:33,770
غبيّة! إنّ شرب شيء عند الحاجة
!للشّرب لا يمكن أن يكون مضرًّا

228
00:17:33,770 --> 00:17:36,100
!قال زعيمي أنّها رسالة عاجلة

229
00:17:37,170 --> 00:17:42,210
.لديّ فكرة شاملة عن فحواها
.إيس واللّحية السّوداء

230
00:17:42,210 --> 00:17:46,710
اذهب وأخبر الفتى أحمر الشّعر
،أنّه إن أراد محادثتي

231
00:17:46,710 --> 00:17:49,710
،فعليه أن يأتي بنفسه
!ويحضر معه بعض السّاكي الجيّد

232
00:17:51,320 --> 00:17:52,820
.عد أدراجك إن كنت فهمت

233
00:17:53,580 --> 00:17:56,620
لا رغبة لي بالحديث مع غرّ
...يسيل أنفه مثلك

234
00:17:57,890 --> 00:17:59,120
.أيّها الأبله

235
00:18:10,440 --> 00:18:12,570
!لم يتغيّر ذلك العجوز أبدًا

236
00:18:13,100 --> 00:18:15,770
!هذا لا يدعو للضّحك يا زعيم

237
00:18:17,580 --> 00:18:20,240
.كنت أتوقّع حدوث شيء كهذا

238
00:18:22,380 --> 00:18:26,250
!امنحني المزيد من الوقت
!لم أُهن هكذا من قبل

239
00:18:26,980 --> 00:18:29,690
مهلاً، مهلاً! ما الّذي تنوي فعله؟
!انس الأمر

240
00:18:30,290 --> 00:18:33,020
.شكرًا على المساعدة
.بإمكانك العودة مباشرة الآن

241
00:18:34,430 --> 00:18:37,630
!...لـ-لكن، لديّ كرامتي

242
00:18:37,630 --> 00:18:40,670
.حياتك أكثر أهمّيّة من كرامتك

243
00:18:40,670 --> 00:18:44,700
.لا يسعك فعل أيّ شيء الآن
.آسف على كلّ هذه المشاكل

244
00:18:46,540 --> 00:18:48,410
ما الّذي ستفعله الآن يا زعيم؟

245
00:18:49,410 --> 00:18:52,310
!سأذهب! تجهّزوا للإبحار

246
00:18:52,310 --> 00:18:53,850
!ستقابل اللّحية البيضاء؟

247
00:18:54,210 --> 00:18:55,750
!نعم، هذا صحيح

248
00:18:55,750 --> 00:18:59,020
هل تعتقد أنّ الحكومة ستقف
مكتوفة اليدين إن فعلتَ ذلك؟

249
00:18:59,820 --> 00:19:02,290
.هذا ليس وقتًا مناسبًا لذلك

250
00:19:03,760 --> 00:19:04,990
.هذا لا شيء

251
00:19:05,990 --> 00:19:08,590
على الأرجح أنّ الحكومة
...لن تقف مكتوفة اليدين

252
00:19:08,590 --> 00:19:11,900
،لكن إن وقفت في طريقنا
!فأيدينا لن تكون مكتوفة أيضًا

253
00:19:12,630 --> 00:19:15,330
!يا رجال! وقت القتال

254
00:19:15,870 --> 00:19:19,100
!حسنًا! أحضروا لي أفضل أنواع السّاكي

255
00:19:21,870 --> 00:19:23,170
تيتش؟

256
00:19:23,170 --> 00:19:27,010
.نعم. قائد طاقم قراصنتنا

257
00:19:27,510 --> 00:19:30,980
.لم أسمع به من قبل
لن يشكّل شخص مجهول

258
00:19:31,220 --> 00:19:33,790
.تهديدًا لباقي القراصنة

259
00:19:33,790 --> 00:19:36,190
.نعم، نحن ندرك ذلك

260
00:19:37,320 --> 00:19:40,890
،ولذلك السّبب، وضعنا خطّة بكلّ عناية

261
00:19:41,530 --> 00:19:43,560
.لذلك أطلب منكم بعض الوقت

262
00:19:44,600 --> 00:19:48,530
!هذا ممتع! دعهم يحاولون يا سِنغوكو

263
00:19:49,870 --> 00:19:56,240
.نحن قراصنة اللّحية السّوداء
...تذكّروا هذا الاسم رجاءً

264
00:20:00,950 --> 00:20:03,780
!مهلاً، هل سمعت؟! هُزم بيلامي

265
00:20:03,780 --> 00:20:05,980
!ماذا؟! على يد من؟

266
00:20:11,860 --> 00:20:13,060
...مائة مليون

267
00:20:13,060 --> 00:20:16,030
من ناحية الرّوح الطّموحة، لم أعتقد
...حتّى أنّه يساوي 30 مليونًا

268
00:20:16,290 --> 00:20:17,630
...لا أصدّق أنّها مرتفعة هكذا

269
00:20:17,630 --> 00:20:19,960
ما الخطّة أيّها القائد؟

270
00:20:21,200 --> 00:20:23,940
!أيّها الوغد! لا تعترض طريق الآخرين هكذا

271
00:20:24,400 --> 00:20:26,840
!لستُ في مزاج جيّد على الإطلاق

272
00:20:26,840 --> 00:20:28,170
!اخرس

273
00:20:35,710 --> 00:20:37,850
!لا شأن لي مع الضّعفاء

274
00:20:37,850 --> 00:20:42,350
كنتُ أبحث عن رأس تساوي
!مائة مليون أو أكثر

275
00:20:42,350 --> 00:20:45,260
!نوشك على الانضمام لطاولة الكبار الآن

276
00:20:47,630 --> 00:20:50,160
!حان وقت صيد بعض الفرائس أخيرًا

277
00:20:51,630 --> 00:20:56,970
أيّها القائد! ألم يكن يُفترض بنا
!لقاء لافيت في هذه البلدة؟

278
00:21:01,010 --> 00:21:05,380
!يبدو أنّنا انفصلنا عن بعض
!لكن هكذا هو الحظّ أحيانًا

279
00:21:05,380 --> 00:21:07,510
أليس كذلك يا أوغر؟

280
00:21:18,690 --> 00:21:24,160
!بالتّحديد! يقيس القدر قيمة المرء دائمًا

281
00:21:38,280 --> 00:21:41,950
!أيّها العمّ ذو الرّأس الماسيّ
!ذهبك معي

282
00:21:41,950 --> 00:21:47,390
!انتظر! سأعود... سأعود قريبًا

283
00:21:55,640 --> 00:22:03,540
آه، خلف السّماء الّتي لا نهاية لها

284
00:22:03,540 --> 00:22:14,150
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

285
00:22:22,030 --> 00:22:29,470
مرّت عليّ أيّام كدت أخسر فيها نفسي

286
00:22:29,470 --> 00:22:37,880
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

287
00:22:37,880 --> 00:22:46,090
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

288
00:22:46,090 --> 00:22:54,930
دفعوا بي للأمام، أليس كذلك؟

289
00:22:54,930 --> 00:23:03,240
آه، إنّ النّجوم تهوي من السّماء

290
00:23:03,240 --> 00:23:06,370
...وهذه اللّحظة الفريدة

291
00:23:11,750 --> 00:23:14,750
!على مهلكم! أنا خائف

292
00:23:14,750 --> 00:23:16,450
!إنّنا نُجرّ إلى دوّامة

293
00:23:16,450 --> 00:23:19,920
!لم يخبرنا أحد عن دوّامة عملاقة
!لقد خدعتمونا

294
00:23:19,920 --> 00:23:22,520
!لنعد! جزيرة السّماء مجرّد حلم في حلم

295
00:23:22,520 --> 00:23:23,860
!جزيرة في حلم في حلم

296
00:23:24,020 --> 00:23:27,490
سأندم طوال حياتي إن فوّتّ
!مغامرة كبيرة كهذه

297
00:23:27,490 --> 00:23:29,030
:في الحلقة القادمة من ون بيس

298
00:23:29,030 --> 00:23:32,130
!الانطلاق نحو السّماء"
".ركوب تيّار المحيط الصّاعد

299
00:23:32,130 --> 00:23:34,230
!ملك القراصنة، لن يكون إلاّ أنا