1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:11,990 --> 00:02:15,060
...سمعتُ الإشاعات عنك للتّوّ

22
00:02:15,630 --> 00:02:16,960
ألديك شأن ما معي؟

23
00:02:16,960 --> 00:02:20,430
!نعم! أعد ذهب العمّ ذو الرّأس الماسيّ

24
00:02:20,430 --> 00:02:22,030
ذهب؟

25
00:02:23,430 --> 00:02:26,670
تقصد أغراض العجوز كريكت؟

26
00:02:39,750 --> 00:02:45,190
لماذا عليّ إعادتها؟
.سرقت أشياءه بصفتي قرصانًا

27
00:02:45,190 --> 00:02:50,060
وبما أنّك قرصان أيضًا، فلستَ في موضع
!يخوّلك لترى ما فعلتُه خاطئًا

28
00:02:50,060 --> 00:02:50,930
.وأنا أيضًا

29
00:02:51,760 --> 00:02:56,200
.إنّهم أصدقائي. لذلك سأسرقها منك

30
00:03:03,510 --> 00:03:08,710
رجل المائة مليون! أعظم قوّة"
"!في العالم وقراصنة اللّحية السّوداء

31
00:03:14,890 --> 00:03:18,020
!أكره أن أسأل هذا، لكن أبإمكانك القتال؟

32
00:03:18,020 --> 00:03:20,560
!هل تعرف حتّى كيف تلكم؟

33
00:03:22,330 --> 00:03:25,430
!ما الّذي باستطاعة جبان مثلك فعله؟

34
00:03:27,800 --> 00:03:31,770
!لا-لا شكّ في الأمر! إنّه هو

35
00:03:32,170 --> 00:03:36,310
!أنت، أما زلت تحمل تلك؟
!مزّقها وارمها في الحال

36
00:03:36,310 --> 00:03:39,940
...لكن إن كان هذا الملصق حقيقيًّا

37
00:03:39,940 --> 00:03:43,750
حتّى بيلامي لا فرصة أمامه لمواجهة
!قرصان مكافأته مائة مليون

38
00:03:44,510 --> 00:03:50,620
!هذا سخيف! انظر لذلك الشّقيّ فحسب
!هل يبدو شخصًا شنيعًا؟

39
00:03:50,620 --> 00:03:53,720
يجعلني ذلك أشكّك في ملصق
!مكافأته ذو الثّلاثين مليون أيضًا

40
00:03:53,720 --> 00:03:56,690
إن تسمّرتَ مكانك خوفًا كما
،فعلتَ هذا المساء

41
00:03:56,690 --> 00:04:01,130
!فلن تسرق أيّ شيء منّي أيّها الجبان

42
00:04:01,570 --> 00:04:04,030
.ما حدث هذا المساء كان مختلفًا

43
00:04:06,100 --> 00:04:09,340
فعلاً؟ وكيف هو مختلف يا ترى؟

44
00:04:09,340 --> 00:04:13,640
هذه المرّة، سأغلق فمك
!المتذاكي ذاك للأبد

45
00:04:16,380 --> 00:04:17,610
!إنّه ينهار

46
00:04:17,610 --> 00:04:20,280
!سأنهي أمرك في رمشة عين

47
00:04:20,280 --> 00:04:22,090
...النّابض

48
00:04:22,090 --> 00:04:23,720
!القانص

49
00:04:28,060 --> 00:04:30,390
!انظروا! لقد حلّق قبّعة القشّ أيضًا

50
00:04:36,100 --> 00:04:37,700
...حثالة هاوٍ

51
00:04:42,270 --> 00:04:45,140
!لماذا قدم ذلك الشّقيّ إلى هنا؟

52
00:04:46,040 --> 00:04:49,550
!لنجلس جميعًا ونستمتع بعرض بيلامي

53
00:04:50,480 --> 00:04:54,220
،كان يقول كلامًا كبيرًا
!لكنّه يهرب فحسب الآن

54
00:04:56,990 --> 00:04:59,290
...لم يختلف أيّ شيء

55
00:05:03,690 --> 00:05:06,530
!الأمر تمامًا كما هذا المساء

56
00:05:10,530 --> 00:05:13,670
!ستسرق الذّهب ثانية منّي؟

57
00:05:13,670 --> 00:05:17,410
،ما أنت إلاّ ضعيف ثرثار
،لا يستطيع أبدًا مواجهتي

58
00:05:17,410 --> 00:05:22,750
وعاجز عن فعل أيّ شيء
!سوى التّفاخر بالأحلام

59
00:05:24,720 --> 00:05:25,650
!إنّه قادم ناحيتنا

60
00:05:25,650 --> 00:05:26,080
!اهربوا

61
00:05:32,020 --> 00:05:33,560
...كافح كما تشاء

62
00:05:33,560 --> 00:05:37,090
!لا مهرب من قوّة فاكهة النّابض خاصّتي

63
00:05:37,490 --> 00:05:39,560
!انتهى أمره سلفًا؟ هذا مثير للشّفقة

64
00:05:40,260 --> 00:05:43,270
من المستحيل أن تكون لذلك الفتى
!فرصة أمام بيلامي

65
00:05:46,740 --> 00:05:48,910
لم يقتلك ذلك، صحيح؟

66
00:05:53,480 --> 00:05:54,280
!لقد وقف

67
00:05:56,850 --> 00:05:59,080
!ما زال الوقت باكرًا على الموت

68
00:05:59,080 --> 00:06:02,590
!بدأ عرضي يدخل فصله الجيّد

69
00:06:02,590 --> 00:06:04,690
...النّابض

70
00:06:04,690 --> 00:06:06,220
!الواثب

71
00:06:14,530 --> 00:06:16,170
!اختفى بيلامي

72
00:06:16,170 --> 00:06:18,840
!فعل هذا عندما قتل روشيو الجلاّد

73
00:06:18,840 --> 00:06:21,540
!إنّهم أصدقاؤك؟

74
00:06:23,040 --> 00:06:27,810
بالمناسبة، كان ذلك العجوز وذلاكما
!القردان الضّخمان مثلك تمامًا

75
00:06:27,810 --> 00:06:30,850
أنتم مجموعة حمقى بالفطرة
تصدّقون قصّة ملفّقة

76
00:06:30,850 --> 00:06:32,880
!رواها رجل ما قبل 400 سنة

77
00:06:32,880 --> 00:06:35,890
!مدينة ذهب؟ جزيرة سماء؟

78
00:06:35,890 --> 00:06:40,290
عصر الأحلام قد ولّى
!أيّها القراصنة المثيرون للشّفقة

79
00:06:40,920 --> 00:06:43,760
سألتَ هل أعرف كيف ألكُم؟

80
00:06:45,300 --> 00:06:50,100
نل منه يا بيلامي! ذلك الأحمق
!ليس أهلاً ليعيش في الواقع

81
00:06:51,800 --> 00:06:53,800
!الوداع يا قبّعة القشّ

82
00:07:28,570 --> 00:07:31,580
...مهلاً... كفّ عن المزاح يا بيلامي

83
00:07:31,580 --> 00:07:33,780
!هيّا! أنت تمزح، صحيح؟

84
00:07:34,380 --> 00:07:35,380
!قُل شيئًا

85
00:07:39,620 --> 00:07:42,390
!يا بيلامي! كفاك تظاهرًا

86
00:07:42,820 --> 00:07:46,820
هيّا، انهض! واصل عرضك
!المعتاد يا بيلامي

87
00:07:47,090 --> 00:07:51,090
أنت المبتدئ عالي الشّأن
!صاحب مكافأة 55 مليون

88
00:07:51,500 --> 00:07:54,000
!هذا صحيح! إنّهما من كانا هنا هذا المساء

89
00:07:59,000 --> 00:08:02,510
!مكافآتهما أعلى من مكافأتك يا بيلامي

90
00:08:04,910 --> 00:08:07,410
!...أ-أرأيت؟ لقد أخبرتك

91
00:08:10,280 --> 00:08:13,380
.أعيدوا ذهب العمّ

92
00:08:29,970 --> 00:08:32,400
!إنّهم أقوياء جدًّا

93
00:08:32,400 --> 00:08:35,340
...تعرّضوا للضّرب، لكنّهم بخير الآن

94
00:08:36,370 --> 00:08:41,080
،أعلم أنّ تشوبّر عالجهم
...لكن يبدو وكأنّهم خالدون

95
00:08:43,080 --> 00:08:45,220
لماذا لم تذهب أيضًا؟

96
00:08:45,220 --> 00:08:46,650
!ماذا؟ ما خطبك؟

97
00:08:47,120 --> 00:08:51,620
!تقولين "لا تقاتل! افعل هذا
"!لا تذهب! اذهب

98
00:08:52,020 --> 00:08:55,330
!كلاّ! ما أعنيه أنّهم هزموك أيضًا

99
00:08:59,130 --> 00:09:00,900
هزموني؟

100
00:09:00,900 --> 00:09:05,170
ليس وكأنّهم كانوا يعترضون
.طريقنا أو ما شابه

101
00:09:05,870 --> 00:09:08,910
إنّ القتالات الّتي لا تكون نتيجتها
.سوى الشّفقة تكون صعبة

102
00:09:09,310 --> 00:09:12,040
ماذا؟ هل أنت غبيّ؟

103
00:09:12,040 --> 00:09:14,810
!اخرسي واغربي عن وجهي
!أنت تعترضين طريقنا

104
00:09:14,810 --> 00:09:17,980
!ماذا قلت؟! أنت من لا يسمع أبدًا

105
00:09:17,980 --> 00:09:20,250
لماذا عليّ الاستماع لك؟

106
00:09:18,650 --> 00:09:22,250
!مهلاً، مهلاً، كونا أكثر حذرًا أيّها الغبيّان

107
00:09:20,250 --> 00:09:24,090
أتساءل بشأن ذلك؟
!ربّما لأنّي على صواب دائمًا

108
00:09:22,250 --> 00:09:25,320
...هذه السّفينة هي أغلى كنوزنا

109
00:09:24,090 --> 00:09:26,760
!اغربي عن وجهي فحسب

110
00:09:25,320 --> 00:09:26,990
!مهلاً، مهلاً، يكفي أيّها الوغدان

111
00:09:26,760 --> 00:09:27,460
ماذا قلت؟

112
00:09:26,990 --> 00:09:28,190
!كفى أيّها الوغدان

113
00:09:27,460 --> 00:09:28,190
!كفّ عن قول ذلك

114
00:09:34,300 --> 00:09:35,830
!حصلتُ عليه

115
00:09:36,430 --> 00:09:39,840
!ذلك الشّقيّ... ضربة حظّ

116
00:09:41,510 --> 00:09:42,840
!أنت

117
00:09:42,840 --> 00:09:45,610
!توقّف! ما زلتُ أنا هنا

118
00:09:45,610 --> 00:09:46,880
!هيّا! أرني ما لديك

119
00:09:47,580 --> 00:09:50,210
من المستحيل أن نخسر أمام
!حمقى يطاردون الأحلام

120
00:09:50,210 --> 00:09:53,580
!ما الخطب؟! يا قبّعة القشّ
!إلى أين أنت ذاهب؟

121
00:09:56,090 --> 00:09:56,920
إلى أين؟

122
00:10:01,760 --> 00:10:02,490
!السّماء

123
00:10:16,840 --> 00:10:20,480
إذًا فهؤلاء هم من هزموا السّير كروكودايل

124
00:10:20,480 --> 00:10:23,650
...أحد الشّيتشيبوكاي الملكيّين

125
00:10:23,980 --> 00:10:28,120
...مونكي د. لوفي... ورورونوا زورو

126
00:10:28,120 --> 00:10:29,850
!مهارة أسلوب السّيوف الثّلاثة السّرّيّة

127
00:10:31,660 --> 00:10:33,290
!العوالم الثّلاثة آلاف

128
00:10:38,030 --> 00:10:40,360
...النّدوب في الظّهر هي عار السّيّاف

129
00:10:41,000 --> 00:10:41,800
!مثير للإعجاب

130
00:10:45,970 --> 00:10:50,570
!حاول التّغلّب عليّ يا رورونوا زورو

131
00:10:53,440 --> 00:10:58,280
إذًا فأولئك الأطفال كبروا لدرجة أنّ
...حكومة العالم لا تستطيع تجاهلهم

132
00:11:24,520 --> 00:11:26,850
!ماذا؟ أحمر الشّعر؟

133
00:11:27,220 --> 00:11:29,320
...نعم. تصرّفاته تثير القلق

134
00:11:30,190 --> 00:11:32,820
لكن أفترض أنّه لم يقم
بأيّ حركة بنفسه؟

135
00:11:32,820 --> 00:11:35,690
،صحيح. قام بذلك بشكل غير مباشر
...باستعمال رسول

136
00:11:36,160 --> 00:11:40,030
لكن من الخطير جدًّا للّحية البيضاء
!وأحمر الشّعر أن يتواصلا معًا

137
00:11:40,500 --> 00:11:42,700
.نعم، هذا صحيح

138
00:11:43,170 --> 00:11:46,570
،لكنّ أحمر الشّعر لا يثير القلق إلاّ إن استُفزّ

139
00:11:46,570 --> 00:11:49,740
إنّه ليس من الرّجال الّذين
.قد يغيّر العالم بمفرده

140
00:11:49,740 --> 00:11:52,280
.لنتحلّ بالصّبر ونراقب

141
00:11:52,280 --> 00:11:54,550
.الشّيتشيبوكاي أكثر أهمّيّة الآن

142
00:11:54,550 --> 00:11:56,880
.علينا إيجاد بديل لكروكودايل بسرعة

143
00:11:57,680 --> 00:12:00,120
.لا تستخفّوا بخسارته

144
00:12:00,120 --> 00:12:04,760
إنّ الانهيار في توازن القوى الثّلاثة
.العظمى سيمزّق العالم بحدّ ذاته

145
00:12:05,160 --> 00:12:06,720
.يجب المحافظة على التّوازن

146
00:12:06,720 --> 00:12:10,560
حاضر! لهذا السّبب قمنا باستدعاء
،الشّيتشيبوكاي إلى هنا

147
00:12:10,990 --> 00:12:13,130
.لكن لا ندري كم منهم سيحضر

148
00:12:14,030 --> 00:12:17,030
...إنّهم قراصنة. يقومون بما يحلو لهم

149
00:12:17,030 --> 00:12:20,640
.سُحقًا لك يا كروكودايل
...وضعتنا في وضع مروّع

150
00:12:21,410 --> 00:12:26,480
ما عدنا نستطيع ترك هذا الرّجل
...الّذي هزمك حرًّا طليقًا

151
00:12:27,140 --> 00:12:29,650
...مونكي د. لوفي

152
00:12:33,220 --> 00:12:35,650
.من مقرّ البحريّة الرّئيسيّ إلى ماريجوا

153
00:12:35,650 --> 00:12:39,390
إنّ الشّيتشيبوكاي الملكيّان
دونكيهوتي دوفلامينغو-ساما

154
00:12:39,390 --> 00:12:42,460
.وبارثولوميو كوما-ساما وصلا

155
00:12:54,100 --> 00:12:57,370
!مهلاً! توقّف! ماذا تفعل؟

156
00:12:57,710 --> 00:12:59,840
!لا أفعل شيئًا! تتحرّك يداي من تلقاء نفسها

157
00:12:59,840 --> 00:13:02,350
!لا تتصرّف بحماقة! هذا ليس وقتًا للمزاح

158
00:13:02,350 --> 00:13:05,650
!لستُ أمزح! لا يمكنني التّحكّم بجسدي

159
00:13:05,650 --> 00:13:08,120
!كيف لا تستطيع...؟! أعجز عن التّنفّس

160
00:13:08,120 --> 00:13:10,290
!توقّفا! ماذا تظنّان أنّكما فاعلان؟

161
00:13:11,090 --> 00:13:12,520
هل تحاول قتلي؟

162
00:13:12,520 --> 00:13:13,190
!ليس أنا

163
00:13:13,190 --> 00:13:16,490
!توقّفا! ألا تدركان أين أنتما؟

164
00:13:17,900 --> 00:13:20,400
!دوفلامينغو! هذا من صنيعك
!أوقف هذا في الحال

165
00:13:24,440 --> 00:13:31,040
،إذًا ابدأ بالكلام بسرعة
!وإلاّ أنهيتُ هذا الاجتماع الرّديء

166
00:13:35,650 --> 00:13:37,950
!مهلاً! توقّف أيّها الغبيّ

167
00:13:37,950 --> 00:13:40,820
!توقّف! أوقفه يا دوفلامينغو
!اللّعنة عليك

168
00:13:41,290 --> 00:13:42,390
!هذا يكفي

169
00:13:42,920 --> 00:13:47,060
!لا تتصرّفوا بحماقة
!هل أتيتم إلى هنا لبدء حرب؟

170
00:13:55,270 --> 00:13:59,670
.أعتذر على ترحيبي المتأخّر
.شكرًا لقدومكم يا حثالة البحر

171
00:14:00,670 --> 00:14:04,440
...مهلاً، مهلاً. استمعوا لهذه الكلمات الكبيرة

172
00:14:05,480 --> 00:14:09,510
.فلنبدأ. أشكّ في وصول البقيّة

173
00:14:09,510 --> 00:14:14,020
.اثنان من أصل ستّة أكثر ممّا توقّعت

174
00:14:14,020 --> 00:14:15,520
.أراهن على ذلك

175
00:14:15,520 --> 00:14:20,490
لم أنوِ على المجيء أيضًا، لكنّ شؤون
...جزيرتي تسير على ما يرام

176
00:14:23,190 --> 00:14:25,200
.لدرجة أنّني أتيتُ بدافع الملل

177
00:14:25,200 --> 00:14:27,700
.فهمت. سماع هذا يثير قلقي

178
00:14:28,000 --> 00:14:33,070
لا يوجد ما هو أكثر إحباطًا لنا
.من صناعة قراصنة مزدهرة

179
00:14:35,070 --> 00:14:37,780
!إنّك لا تخشى المجابهة أبدًا

180
00:14:38,440 --> 00:14:42,510
إنّك تخون لقب "البوذا" هكذا
!أيّها الأميرال سِنغوكو

181
00:14:45,220 --> 00:14:47,990
...أسمع مشادّات كلاميّة مملّة

182
00:14:49,550 --> 00:14:52,820
هل تُراني أتيتُ للمكان الخطأ؟

183
00:14:52,820 --> 00:14:53,990
!عين الصّقر

184
00:14:54,290 --> 00:14:56,390
.مقرّ البحريّة الرّئيسيّ والشّيتشيبوكاي

185
00:14:56,390 --> 00:15:01,100
تبدو تلك الطّاولة المستديرة
.بلا مغزى لهاتين القوّتين المتعارضتين

186
00:15:01,630 --> 00:15:05,740
!يا إلهي! وصل رجل لم نكن نتوقّعه

187
00:15:06,140 --> 00:15:08,040
...هل يُعقل أنّك

188
00:15:09,340 --> 00:15:11,980
.ماذا؟ أنا هنا كمتفرّج فحسب

189
00:15:12,580 --> 00:15:16,480
أنا مهتمّ قليلاً ببعض القراصنة المتورّطين
.في المسألة الّتي نحن بصددها

190
00:15:17,310 --> 00:15:18,550
.هذا كلّ شيء

191
00:15:18,550 --> 00:15:23,250
...في تلك الحالة، أنا متفرّج أيضًا
أهذا مقبول؟

192
00:15:24,290 --> 00:15:28,330
...حسنًا، أفترض أنّني لست "متفرّجًا" بالضّبط

193
00:15:28,960 --> 00:15:32,430
!من تكون؟! كيف دخلتَ إلى هنا؟

194
00:15:32,760 --> 00:15:36,130
...لكن يا لها من مجموعة متميّزة هنا

195
00:15:36,630 --> 00:15:39,900
...أتيتُ وكلّي أمل

196
00:15:43,910 --> 00:15:46,580
...أن يُسمح لي بالانضمام لاجتماعكم

197
00:15:49,650 --> 00:15:51,580
.إن كان ذلك ممكنًا

198
00:15:52,720 --> 00:15:56,950
أعتقد فعلاً أنّكم سحبتم من كروكودايل لقبه

199
00:15:57,450 --> 00:16:00,490
وتبحثون الآن عن بديل له؟

200
00:16:01,590 --> 00:16:04,190
!أنت... هل أنت لافيت؟

201
00:16:04,830 --> 00:16:05,930
لافيت؟

202
00:16:05,930 --> 00:16:08,870
هل تعرف اسمي؟

203
00:16:09,370 --> 00:16:11,170
!هذا شرف كبير لي

204
00:16:11,640 --> 00:16:14,910
إنّه ضابط سلام معروف جدًّا
!في الأزرق الغربيّ

205
00:16:15,510 --> 00:16:18,580
تمّ طرده من بلاده بسبب
!استعماله للعنف المفرط

206
00:16:19,640 --> 00:16:21,110
.كان ذلك منذ زمن بعيد

207
00:16:21,610 --> 00:16:25,220
!هويّتي ليست بالأمر المهمّ

208
00:16:25,220 --> 00:16:30,250
أتيتُ لأقترح اسم رجل معيّن
.ليحمل لقب الشّيتشيبوكاي

209
00:16:33,960 --> 00:16:37,530
شانكس... يعيد لي هذا
...الاسم الذّكريات

210
00:16:38,400 --> 00:16:41,130
إذًا فهذه رسالة من شانكس؟

211
00:16:41,130 --> 00:16:45,770
،نعم. يبدو أنّها بالغة الأهمّيّة
!لذلك كلّفني بتبليغها

212
00:16:45,770 --> 00:16:48,910
!فهمت! أحسنت عملاً

213
00:16:48,910 --> 00:16:52,740
.كلاّ، ما زلتُ حديث العهد بين قراصنة أحمر الشّعر

214
00:16:54,980 --> 00:16:57,310
،رغم أنّني كنتُ قرصانًا من قبل

215
00:16:57,310 --> 00:17:00,720
...وأعتقد أنّ اسمي صار معروفًا

216
00:17:01,050 --> 00:17:04,690
!أنتم! سمعتم بروكستار من قبل، صحيح؟

217
00:17:05,390 --> 00:17:07,890
.كلاّ. لم أسمع به من قبل

218
00:17:07,890 --> 00:17:11,200
...على أيّ حال، كان مذاق ملك البحر

219
00:17:14,130 --> 00:17:15,770
!مهلاً! ما الّذي...؟

220
00:17:15,770 --> 00:17:19,240
...يبعث لي برسالة لعينة

221
00:17:19,240 --> 00:17:23,510
منذ متى أصبح ذلك الفتى
!شخصًا بالغ الأهمّيّة هكذا؟

222
00:17:25,010 --> 00:17:26,780
!مهلاً! تمهّل قليلاً

223
00:17:27,240 --> 00:17:30,010
!لقد تصرّف وكأنّ هذه كانت رسالة مهمّة

224
00:17:31,220 --> 00:17:34,620
!أنت تتعامل مع أحمر الشّعر هنا
!هل فقدت عقلك؟

225
00:17:35,390 --> 00:17:37,250
!أنا اللّحية البيضاء

226
00:17:40,190 --> 00:17:43,130
أيّها القائد. ربّما عليك التّقليل
...من شرب الكحول حاليًّا

227
00:17:43,130 --> 00:17:47,770
غبيّة! إنّ شرب شيء عند الحاجة
!للشّرب لا يمكن أن يكون مضرًّا

228
00:17:47,770 --> 00:17:50,100
!قال زعيمي أنّها رسالة عاجلة

229
00:17:51,170 --> 00:17:56,210
.لديّ فكرة شاملة عن فحواها
.إيس واللّحية السّوداء

230
00:17:56,210 --> 00:18:00,710
اذهب وأخبر الفتى أحمر الشّعر
،أنّه إن أراد محادثتي

231
00:18:00,710 --> 00:18:03,710
،فعليه أن يأتي بنفسه
!ويحضر معه بعض السّاكي الجيّد

232
00:18:05,320 --> 00:18:06,820
.عد أدراجك إن كنت فهمت

233
00:18:07,580 --> 00:18:10,620
لا رغبة لي بالحديث مع غرّ
...يسيل أنفه مثلك

234
00:18:11,890 --> 00:18:13,120
.أيّها الأبله

235
00:18:24,440 --> 00:18:26,570
!لم يتغيّر ذلك العجوز أبدًا

236
00:18:27,100 --> 00:18:29,770
!هذا لا يدعو للضّحك يا زعيم

237
00:18:31,580 --> 00:18:34,240
.كنت أتوقّع حدوث شيء كهذا

238
00:18:36,380 --> 00:18:40,250
!امنحني المزيد من الوقت
!لم أُهن هكذا من قبل

239
00:18:40,980 --> 00:18:43,690
مهلاً، مهلاً! ما الّذي تنوي فعله؟
!انس الأمر

240
00:18:44,290 --> 00:18:47,020
.شكرًا على المساعدة
.بإمكانك العودة مباشرة الآن

241
00:18:48,430 --> 00:18:51,630
!...لـ-لكن، لديّ كرامتي

242
00:18:51,630 --> 00:18:54,670
.حياتك أكثر أهمّيّة من كرامتك

243
00:18:54,670 --> 00:18:58,700
.لا يسعك فعل أيّ شيء الآن
.آسف على كلّ هذه المشاكل

244
00:19:00,540 --> 00:19:02,410
ما الّذي ستفعله الآن يا زعيم؟

245
00:19:03,410 --> 00:19:06,310
!سأذهب! تجهّزوا للإبحار

246
00:19:06,310 --> 00:19:07,850
!ستقابل اللّحية البيضاء؟

247
00:19:08,210 --> 00:19:09,750
!نعم، هذا صحيح

248
00:19:09,750 --> 00:19:13,020
هل تعتقد أنّ الحكومة ستقف
مكتوفة اليدين إن فعلتَ ذلك؟

249
00:19:13,820 --> 00:19:16,290
.هذا ليس وقتًا مناسبًا لذلك

250
00:19:17,760 --> 00:19:18,990
.هذا لا شيء

251
00:19:19,990 --> 00:19:22,590
على الأرجح أنّ الحكومة
...لن تقف مكتوفة اليدين

252
00:19:22,590 --> 00:19:25,900
،لكن إن وقفت في طريقنا
!فأيدينا لن تكون مكتوفة أيضًا

253
00:19:26,630 --> 00:19:29,330
!يا رجال! وقت القتال

254
00:19:29,870 --> 00:19:33,100
!حسنًا! أحضروا لي أفضل أنواع السّاكي

255
00:19:35,870 --> 00:19:37,170
تيتش؟

256
00:19:37,170 --> 00:19:41,010
.نعم. قائد طاقم قراصنتنا

257
00:19:41,510 --> 00:19:44,980
.لم أسمع به من قبل
لن يشكّل شخص مجهول

258
00:19:45,220 --> 00:19:47,790
.تهديدًا لباقي القراصنة

259
00:19:47,790 --> 00:19:50,190
.نعم، نحن ندرك ذلك

260
00:19:51,320 --> 00:19:54,890
،ولذلك السّبب، وضعنا خطّة بكلّ عناية

261
00:19:55,530 --> 00:19:57,560
.لذلك أطلب منكم بعض الوقت

262
00:19:58,600 --> 00:20:02,530
!هذا ممتع! دعهم يحاولون يا سِنغوكو

263
00:20:03,870 --> 00:20:10,240
.نحن قراصنة اللّحية السّوداء
...تذكّروا هذا الاسم رجاءً

264
00:20:14,950 --> 00:20:17,780
!مهلاً، هل سمعت؟! هُزم بيلامي

265
00:20:17,780 --> 00:20:19,980
!ماذا؟! على يد من؟

266
00:20:25,860 --> 00:20:27,060
...مائة مليون

267
00:20:27,060 --> 00:20:30,030
من ناحية الرّوح الطّموحة، لم أعتقد
...حتّى أنّه يساوي 30 مليونًا

268
00:20:30,290 --> 00:20:31,630
...لا أصدّق أنّها مرتفعة هكذا

269
00:20:31,630 --> 00:20:33,960
ما الخطّة أيّها القائد؟

270
00:20:35,200 --> 00:20:37,940
!أيّها الوغد! لا تعترض طريق الآخرين هكذا

271
00:20:38,400 --> 00:20:40,840
!لستُ في مزاج جيّد على الإطلاق

272
00:20:40,840 --> 00:20:42,170
!اخرس

273
00:20:49,710 --> 00:20:51,850
!لا شأن لي مع الضّعفاء

274
00:20:51,850 --> 00:20:56,350
كنتُ أبحث عن رأس تساوي
!مائة مليون أو أكثر

275
00:20:56,350 --> 00:20:59,260
!نوشك على الانضمام لطاولة الكبار الآن

276
00:21:01,630 --> 00:21:04,160
!حان وقت صيد بعض الفرائس أخيرًا

277
00:21:05,630 --> 00:21:10,970
أيّها القائد! ألم يكن يُفترض بنا
!لقاء لافيت في هذه البلدة؟

278
00:21:15,010 --> 00:21:19,380
!يبدو أنّنا انفصلنا عن بعض
!لكن هكذا هو الحظّ أحيانًا

279
00:21:19,380 --> 00:21:21,510
أليس كذلك يا أوغر؟

280
00:21:32,690 --> 00:21:38,160
!بالتّحديد! يقيس القدر قيمة المرء دائمًا

281
00:21:52,280 --> 00:21:55,950
!أيّها العمّ ذو الرّأس الماسيّ
!ذهبك معي

282
00:21:55,950 --> 00:22:01,390
!انتظر! سأعود... سأعود قريبًا

283
00:22:09,640 --> 00:22:17,540
آه، خلف السّماء الّتي لا نهاية لها

284
00:22:17,540 --> 00:22:28,150
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

285
00:22:36,030 --> 00:22:43,470
مرّت عليّ أيّام كدت أخسر فيها نفسي

286
00:22:43,470 --> 00:22:51,880
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

287
00:22:51,880 --> 00:23:00,090
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

288
00:23:00,090 --> 00:23:08,930
دفعوا بي للأمام، أليس كذلك؟

289
00:23:08,930 --> 00:23:17,240
آه، إنّ النّجوم تهوي من السّماء

290
00:23:17,240 --> 00:23:20,370
...وهذه اللّحظة الفريدة

291
00:23:25,750 --> 00:23:28,750
!على مهلكم! أنا خائف

292
00:23:28,750 --> 00:23:30,450
!إنّنا نُجرّ إلى دوّامة

293
00:23:30,450 --> 00:23:33,920
!لم يخبرنا أحد عن دوّامة عملاقة
!لقد خدعتمونا

294
00:23:33,920 --> 00:23:36,520
!لنعد! جزيرة السّماء مجرّد حلم في حلم

295
00:23:36,520 --> 00:23:37,860
!جزيرة في حلم في حلم

296
00:23:38,020 --> 00:23:41,490
سأندم طوال حياتي إن فوّتّ
!مغامرة كبيرة كهذه

297
00:23:41,490 --> 00:23:43,030
:في الحلقة القادمة من ون بيس

298
00:23:43,030 --> 00:23:46,130
!الانطلاق نحو السّماء"
".ركوب تيّار المحيط الصّاعد

299
00:23:46,130 --> 00:23:48,230
!ملك القراصنة، لن يكون إلاّ أنا