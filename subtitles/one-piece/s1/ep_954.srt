1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,310 --> 00:01:59,320
!أسلوب الكابّا

29
00:01:59,320 --> 00:02:00,610
!أسلوب السّيفين

30
00:02:00,610 --> 00:02:02,150
!نهر القِصاص

31
00:02:00,860 --> 00:02:01,940
نهر القِصاص

32
00:02:02,150 --> 00:02:03,320
!التفاف وحيد القرن

33
00:02:02,360 --> 00:02:03,320
التفاف وحيد القرن

34
00:02:09,620 --> 00:02:12,080
...كاواماتسو-ساما

35
00:02:14,790 --> 00:02:18,040
!مهلاً! هل تهرب ثانية؟

36
00:02:18,630 --> 00:02:21,130
!سُحقًا لك! أعد لي سيفي شوسوي

37
00:02:25,970 --> 00:02:29,890
...ذلك الوغد مصاب لكنّه يأبى الاستسلام

38
00:02:30,930 --> 00:02:34,230
...على أيّ حال، إن تبعت بقع الدّم هذه

39
00:03:00,040 --> 00:03:02,840
!أعد لي سيفي في الحال

40
00:03:06,970 --> 00:03:09,260
ما هذا المكان؟

41
00:03:09,970 --> 00:03:15,020
!الأهمّ من ذلك، إلى أين ذهب؟

42
00:03:18,900 --> 00:03:22,980
"!اسمه إنما! سيف أودن العظيم"

43
00:03:26,030 --> 00:03:29,780
...ذهب السّاموراي خلف الرّاهب المحارب الضّخم

44
00:03:30,280 --> 00:03:33,700
...أتساءل من كان ذلك الرّاهب المحارب

45
00:03:34,740 --> 00:03:38,410
،على أيّ حال يا كاواماتسو
!أنا جدّ سعيدة لأنّك قيد الحياة

46
00:03:38,410 --> 00:03:43,040
...أنا ممتنّ للغاية لاهتمامك بي

47
00:03:45,710 --> 00:03:47,760
!يا صاحبة السّموّ! تراجعي

48
00:03:49,090 --> 00:03:53,220
!يا لكايدو اللّعين... ما زال يطارد الباقين بلا هوادة

49
00:03:54,140 --> 00:03:56,100
!انظر

50
00:03:56,100 --> 00:03:57,730
...لقد هُزموا

51
00:03:58,390 --> 00:04:00,060
!انخروا جسده بالرّصاص

52
00:04:03,900 --> 00:04:05,150
!أسلوب الكابّا

53
00:04:05,570 --> 00:04:06,860
!يوريكيري

54
00:04:14,830 --> 00:04:20,080
!كاواماتسو

55
00:04:20,170 --> 00:04:21,020
!صاحبة السّموّ

56
00:04:21,210 --> 00:04:23,790
!كاواماتسو... هل أنت بخير؟

57
00:04:25,340 --> 00:04:27,210
!لا داعي للقلق

58
00:04:27,630 --> 00:04:32,400
.قد نصادف المزيد من الأعداء
.لنغادر هذا المكان

59
00:04:33,390 --> 00:04:34,430
...أنت على حقّ

60
00:04:36,970 --> 00:04:39,850
.اصعدي! يصعب المشي هنا

61
00:04:41,390 --> 00:04:45,270
!تمهّل! لستُ طفلة يا كاواماتسو

62
00:04:46,900 --> 00:04:48,200
فعلاً؟

63
00:04:48,200 --> 00:04:52,010
لكنّ لا ينفخ البالغون خدودهم
.عابسين هكذا كالأسماك المنتفخة

64
00:04:52,010 --> 00:04:53,820
!ماذا؟ كيف أمكنك قول ذلك؟

65
00:05:00,040 --> 00:05:02,540
.يذكّرني هذا بالماضي بالفعل

66
00:05:02,540 --> 00:05:06,850
.لا أصدّق أنّه تسنّى لي المشي معك ثانية

67
00:05:06,850 --> 00:05:11,510
،أريد أن أحدّثك في أمور عدّة
لكن أوّلاً، لماذا أنت هنا؟

68
00:05:11,510 --> 00:05:16,970
بعد اختفائك، شققت طريقي
...إلى هنا أؤدّي أعمالاً عاديّة

69
00:05:16,970 --> 00:05:22,400
،وكما هو حال هاكوماي المجاورة
فإنّ هذه المنطقة الشّماليّة من رينغو

70
00:05:22,400 --> 00:05:27,990
كانت تحت حكم عشيرة شيموتسكي
.الّذين اشتهروا بقوّتهم

71
00:05:27,990 --> 00:05:31,500
!كان اسم الدّايميو هو شيموتسكي أوشيمارو-ساما

72
00:05:31,500 --> 00:05:36,160
.كان سيّافًا خبيرًا يرافقه ثعلب على الدّوام

73
00:05:36,160 --> 00:05:37,530
ثعلب؟

74
00:05:37,530 --> 00:05:44,920
ولكن، دمّر كايدو رينغو تمامًا
.كما فعل بالمناطق الأخرى

75
00:05:45,670 --> 00:05:50,920
يا صاحبة السّموّ، هل تعرفين
تقليد القبور الأبديّة لرينغو؟

76
00:05:50,920 --> 00:05:56,510
نعم، سمعتُ أنّ الجثث توضع في توابيت
.ولا تتحلّل لقرون بسبب البرد

77
00:05:56,510 --> 00:06:01,720
هذا صحيح. ويُفترض أنّ شواهد
.القبور عبارة عن سيوف

78
00:06:02,230 --> 00:06:06,490
.يُمنح سكّان رينغو سيوفًا عندما يولدون

79
00:06:06,490 --> 00:06:09,950
.إذ يكبرون معها ويحتفظون  بها في شيخوختهم

80
00:06:09,950 --> 00:06:14,610
وعندما يموتون، تصبح السّيوف
.الّتي حملوها شواهد لقبورهم

81
00:06:14,610 --> 00:06:17,960
.ترافق السّيوف أصحابها إلى الأبد

82
00:06:17,960 --> 00:06:21,450
.لهذا السّبب تسمّى هذه القبور بالقبور الأبديّة

83
00:06:22,870 --> 00:06:28,750
لكن بما أنّ بعضها عبارة عن سيوف عظيمة
.مشهورة، أمسى نبش القبور مشكلة مستمرّة

84
00:06:29,540 --> 00:06:33,210
...ولهذا السّبب منطقة رينغو هذه

85
00:06:34,050 --> 00:06:39,680
دعيني أخبرك ماذا حدث عندما
...أتيت إلى هنا قبل ثلاث عشرة سنة

86
00:06:51,110 --> 00:06:55,700
،كنت عازمًا أنّني إن شققت بطني
...فسأفعل ذلك في هذه المنطقة

87
00:06:58,530 --> 00:07:02,160
!أتمنّى أن تكوني سالمة يا صاحبة السّموّ

88
00:07:07,870 --> 00:07:11,380
!سُحقًا! أهذا وحش؟! كم هو مريب

89
00:07:13,130 --> 00:07:15,750
!سنأخذ الأسلحة لاحقًا! اهربوا

90
00:07:15,750 --> 00:07:17,840
!هذه لعنة السّاموراي من رينغو؟

91
00:07:23,680 --> 00:07:28,900
!كم هذا مزعج
لماذا لا يدعونني أموت بسلام؟

92
00:07:35,530 --> 00:07:36,910
!هذا أنت

93
00:07:36,910 --> 00:07:40,660
!نعم. قابلتك مرّة من قبل

94
00:07:42,990 --> 00:07:45,620
!أنت أونيمارو، صحيح؟

95
00:07:46,160 --> 00:07:49,590
.كان اسم ثعلب الكوما ذاك هو أونيمارو

96
00:07:49,590 --> 00:07:54,920
،كان رفيق شيموتسكي أوشيمارو-ساما
.دايميو رينغو الرّاحل

97
00:08:04,850 --> 00:08:06,560
...أهذا

98
00:08:07,020 --> 00:08:10,850
!أكنت تحمي هذا وحدك تمامًا؟

99
00:08:11,310 --> 00:08:14,160
،لأزيد من خمس سنوات منذ دمار رينغو

100
00:08:14,160 --> 00:08:20,860
كان أونيمارو يقاتل وحيدًا ضدّ نابشي القبور
.الّذين أتوا لسرقة الأسلحة من القبور الأبديّة

101
00:08:22,120 --> 00:08:24,700
.هيّا. لا يجب عليك أن تخاف

102
00:08:24,700 --> 00:08:27,250
.أنا حليفك

103
00:08:30,870 --> 00:08:33,040
...أنت مصاب

104
00:08:39,880 --> 00:08:40,510
!أونيمارو

105
00:08:40,930 --> 00:08:42,800
!ابق معي

106
00:09:00,070 --> 00:09:01,400
!أنت مستيقظ

107
00:09:01,950 --> 00:09:03,780
!إليك طعامك

108
00:09:03,780 --> 00:09:07,410
تحبّ الثّعالب التّوفو المقليّ، صحيح؟

109
00:09:10,960 --> 00:09:14,720
.ما الخطب؟ لن يلتئم ذلك الجرح ما لم تأكل

110
00:09:14,720 --> 00:09:17,250
.لن تستطيع حراسة قبر سيّدك إن متّ

111
00:09:17,880 --> 00:09:19,720
.كُل

112
00:09:19,720 --> 00:09:23,180
.هيّا. جرّبه

113
00:09:29,520 --> 00:09:34,310
.حسنًا، معدتي تؤلمني
.أعتقد أنّني أكثرت من الأكل

114
00:09:38,480 --> 00:09:40,650
!ذلك لا يهمّ

115
00:09:40,650 --> 00:09:42,820
!هيّا! لا تخجل

116
00:09:58,960 --> 00:10:00,000
!هل أحببته؟

117
00:10:41,750 --> 00:10:44,340
.أونيمارو! لا تحدث جلبة

118
00:10:47,050 --> 00:10:49,180
!سامحني! أعرف ما تودّ قوله

119
00:10:57,730 --> 00:10:59,020
!اتركني

120
00:11:01,940 --> 00:11:04,530
!كيف لي أن أشرح الأمر لك؟

121
00:11:04,900 --> 00:11:08,570
!لا أودّ أن أؤرق نوم الأموات

122
00:11:08,570 --> 00:11:13,450
!لكن عليّ فعل هذا الآن

123
00:11:16,210 --> 00:11:19,290
!توكي-ساما، المكان خطير هنا! لنغادر

124
00:11:20,710 --> 00:11:22,630
.سأبقى

125
00:11:23,920 --> 00:11:28,930
!توكي-ساما! سنحميك ما دام فينا عرق ينبض

126
00:11:29,760 --> 00:11:32,720
!غادروا... إلى المستقبل

127
00:11:33,260 --> 00:11:35,930
...لا يستطيع النّاس العودة للماضي أبدًا

128
00:11:36,640 --> 00:11:39,600
.لكن بإمكانكم الذّهاب للأمام نحو المستقبل

129
00:11:51,820 --> 00:11:56,870
،بعد ثلاث عشرة سنة من الآن
!ستحدث معركة كبيرة ثانية

130
00:12:04,750 --> 00:12:11,220
اسمعوا! أنا واثقة أنّه سيحلّ يوم سيقف
!فيه السّاموراي من أقاصي البلاد شامخين

131
00:12:11,220 --> 00:12:16,420
،وعند حدوث ذلك
!فسنحتاج لأطنان من السّيوف

132
00:12:16,420 --> 00:12:22,030
وفي ساحة المعركة، سنحمل سيوف
...زملائنا الّذين قضوا أمام أعيننا

133
00:12:22,030 --> 00:12:24,080
!وسنتقدّم

134
00:12:24,080 --> 00:12:30,280
ستجعل الأرواح الّتي ترقد في تلك السّيوف
!السّاموراي أقوى وأجدر بهزيمة الأعداء

135
00:12:30,280 --> 00:12:35,200
!ما زالت هذه ساحة معركة

136
00:12:52,090 --> 00:12:53,930
!اسمع يا أونيمارو

137
00:12:54,430 --> 00:12:59,890
إنّ المعركة بين قراصنة مملكة الحيوان
!وبلاد وانو لم تنتهِ بعد

138
00:13:00,350 --> 00:13:03,600
!ما زال الوقت أبكر من أن ترقد هذه السّيوف بسلام

139
00:13:03,600 --> 00:13:06,480
...وإلى أن يحين ذلك اليوم

140
00:13:06,480 --> 00:13:11,400
!لا يجب لنا السّماح لأولئك اللّصوص بأخذ السّيوف

141
00:13:12,570 --> 00:13:15,580
وعوض ذلك، سأجمعها كلّها

142
00:13:16,200 --> 00:13:17,990
!وأخفيها

143
00:13:19,250 --> 00:13:22,170
...أنا أفهم

144
00:13:23,210 --> 00:13:25,840
...أنّ هذا هو الدّور الوحيد

145
00:13:26,670 --> 00:13:28,630
!الّذي مُنحتُ إيّاه

146
00:13:33,930 --> 00:13:35,390
...يا صاحبة السّمو

147
00:13:36,010 --> 00:13:38,890
!هيوري-ساما

148
00:13:47,770 --> 00:13:51,860
...لم أستطع حماية هيوري-ساما

149
00:13:52,990 --> 00:13:54,530
...لذلك

150
00:13:55,110 --> 00:14:00,450
!هذا أقلّ ما بإمكاني فعله

151
00:14:02,250 --> 00:14:06,710
عليّ إبقاء نفسي منشغلاً بشيء ما
...وإلاّ عذّبني النّدم وقتلني

152
00:14:07,290 --> 00:14:08,880
،إن كنتَ جائعًا

153
00:14:08,880 --> 00:14:13,010
!فاقضم هذه الذّراع بسرعة وخذها

154
00:14:13,010 --> 00:14:17,760
!لن أكفّ عن سرقة القبور

155
00:15:04,770 --> 00:15:07,190
...أونيمارو

156
00:15:21,990 --> 00:15:22,950
!ماذا؟

157
00:15:22,950 --> 00:15:25,370
ما الّذي حلّ بك؟

158
00:15:25,370 --> 00:15:28,250
هل فهمت ما قلتُه؟

159
00:15:30,630 --> 00:15:33,460
!حسنًا يا أونيمارو! سأنضمّ إليك

160
00:15:34,840 --> 00:15:39,150
وهكذا، اتّحدنا أنا وأونيمارو لحماية القبور

161
00:15:39,150 --> 00:15:42,310
.وجمع السّيوف

162
00:15:51,690 --> 00:15:55,280
!حسنًا! يوم جديد لسرقة القبور

163
00:16:01,950 --> 00:16:04,950
!البرد قارس اليوم

164
00:16:06,700 --> 00:16:10,750
،إن استمرّ الوضع هكذا
...فلن يظلّ لنا مكان للنّوم

165
00:16:11,330 --> 00:16:14,340
.لنحفر حفرة ونخفيها فيها

166
00:16:17,130 --> 00:16:18,800
...أنا جائع

167
00:16:19,340 --> 00:16:23,050
،إن بعت سيفًا أو سيفين في العاصمة

168
00:16:23,050 --> 00:16:27,810
...فسأجني مالاً لشراء طعام يكفي لمدّة

169
00:16:28,310 --> 00:16:29,140
!أونيمارو؟

170
00:16:32,400 --> 00:16:34,690
!كنتُ أمزح، أمزح

171
00:16:37,530 --> 00:16:39,950
...لا يمكن لجيش التّقدّم بمعدة خاوية

172
00:16:42,700 --> 00:16:45,950
!هذا من أجل مصلحة أعظم! سامحوني

173
00:16:47,250 --> 00:16:48,910
!لقد عدتُ يا أونيمارو

174
00:16:48,910 --> 00:16:52,170
!أحضرت بعض الطّعام

175
00:16:52,500 --> 00:16:56,210
!إليك التّوفو المقليّ المفضّل لديك

176
00:17:02,470 --> 00:17:05,470
!ثمّة فرصة لجني المالي في مكان كهذا؟

177
00:17:05,470 --> 00:17:08,470
بينغو، هل أنت واثق؟

178
00:17:08,470 --> 00:17:13,980
.نعم، لقد تحقّقت منه
!القبور الأبديّة عبارة عن كنز دفين

179
00:17:14,520 --> 00:17:17,280
!بإمكاننا سرقة ما نشاء من السّيوف. انظروا

180
00:17:17,280 --> 00:17:20,900
.الجانب الرّئيسيّ من رينغو خلف ذلك الجسر

181
00:17:26,830 --> 00:17:27,700
!ماذا هنالك؟

182
00:17:27,700 --> 00:17:30,470
!غادروا أيّها اللّصوص

183
00:17:30,470 --> 00:17:34,500
!لا يستطيع منحطّون مثلكم الحصول على أيّ سيف

184
00:17:35,250 --> 00:17:38,050
!كفاك عبثًا! هيّا بنا يا بُنغو وبونغو

185
00:17:38,080 --> 00:17:38,600
!أجل

186
00:17:38,770 --> 00:17:39,760
!أونيمارو

187
00:17:47,510 --> 00:17:49,970
!من... من أنت أيّها الوغد؟

188
00:17:50,350 --> 00:17:54,440
...أتريد معرفة اسمي؟ حسنًا

189
00:17:55,440 --> 00:17:56,440
!مهلاً

190
00:17:59,320 --> 00:18:00,900
!لديّ فكرة

191
00:18:00,900 --> 00:18:02,900
...اسمي

192
00:18:02,900 --> 00:18:05,740
...قابع جسر قطّاع الطّرق

193
00:18:07,700 --> 00:18:12,790
!غيوكيمارو

194
00:18:14,710 --> 00:18:18,000
!والآن، دعوا أسلحتكم وغادروا

195
00:18:27,140 --> 00:18:29,760
!غيوكيمارو؟! أهذه مصادفة؟

196
00:18:29,760 --> 00:18:33,120
...يحمل الرّاهب المحارب نفس الاسم

197
00:18:33,120 --> 00:18:38,980
،وبعد وقت قصير من ذلك
،ذهبت للعاصمة لإحضار الطّعام

198
00:18:38,980 --> 00:18:41,160
،ولكن لسبب معيّن

199
00:18:41,160 --> 00:18:45,570
.لم أستطع العودة

200
00:18:48,070 --> 00:18:50,660
...يا سكّان العاصمة، أنا آسف

201
00:18:56,040 --> 00:18:58,210
!أنت رهن الاعتقال

202
00:18:59,090 --> 00:19:03,420
!أمسكنا به! كفاك مقاومة يا لصّ التّوفو المقليّ

203
00:19:04,300 --> 00:19:08,390
...هذه أخطر غلطة في حياتي

204
00:19:16,100 --> 00:19:18,560
...سامحني يا أونيمارو

205
00:19:21,730 --> 00:19:24,610
وكُنت سجينًا لثلاث عشرة سنة؟

206
00:19:25,320 --> 00:19:27,530
.كان ذلك فشلاً ذريعًا

207
00:19:27,530 --> 00:19:31,740
إذًا فقد أتيت اليوم إلى هنا لرؤية ذلك الثّعلب؟

208
00:19:32,120 --> 00:19:37,130
كلاّ، أنا واثق أنّ أونيمارو
.قد تخلّى عنّي بما أنّني لم أعد

209
00:19:37,130 --> 00:19:41,960
...لقد مرّت ثلاث عشرة سنة بالفعل
.لا أظنّ أنّه ما زال هنا

210
00:19:47,840 --> 00:19:49,470
!زوروجورو-سان

211
00:19:49,930 --> 00:19:52,590
ما الّذي حلّ بذلك الرّاهب المحارب؟

212
00:19:52,590 --> 00:19:57,480
.فتح هذا الباب وهرب

213
00:19:57,940 --> 00:20:00,510
...فتح الباب؟ هذا المكان

214
00:20:00,510 --> 00:20:03,690
ما الّذي كان يفكّر به؟

215
00:20:04,070 --> 00:20:10,280
أيعقل أنّ هذا هو الطّريق المؤدّي
...للمكان التّحأرضيّ الّذي أنشأناه

216
00:20:11,240 --> 00:20:15,080
...رنين، رنين، رنين... رنين، رنين، رنين

217
00:20:15,080 --> 00:20:16,260
.فتح

218
00:20:16,260 --> 00:20:18,210
!مرحبًا؟ أهذا أنت يا كينييمون؟

219
00:20:18,210 --> 00:20:22,630
!هذا أنت يا كاواماتسو! أنا سعيد لأنّك حيّ

220
00:20:22,630 --> 00:20:28,260
،لدينا الكثير لنتحدّث عنه
.لكن أنا بحاجة لإخبارك بأمر أوّلاً

221
00:20:28,260 --> 00:20:31,990
تعرف أنّنا أخضعنا أودون، صحيح؟

222
00:20:31,990 --> 00:20:33,760
،نعم، بشأن ذلك

223
00:20:34,600 --> 00:20:38,310
أخبرني رايزو أنّ أعداد الجنود في جانبنا

224
00:20:38,310 --> 00:20:40,630
.قد تزايدت بفضل لوفيتارو-دونو

225
00:20:41,600 --> 00:20:44,440
.لكنّني أراهن أنّكم لا تملكون سيوفًا بما يكفي

226
00:20:44,440 --> 00:20:50,080
هذا صحيح تمامًا! شغل ذلك
!الموضوع بالنا طوال الوقت

227
00:20:50,080 --> 00:20:51,910
!أوروتشي اللّعين

228
00:20:51,910 --> 00:20:55,640
كان يسلب النّاس سيوفهم في كلّ أرجاء
!البلاد في السّنوات العشرين الماضية

229
00:20:55,640 --> 00:20:57,160
...ذلك ما توقّعته

230
00:20:57,700 --> 00:20:59,330
!لكن لا داعي للقلق

231
00:20:59,330 --> 00:21:02,210
،حتّى إن جمعتم آلاف الجنود

232
00:21:02,210 --> 00:21:05,090
!أستطيع تزويدكم بقدر ما تشاؤون من السّيوف

233
00:21:05,090 --> 00:21:07,400
!ماذا؟! أأنت جادّ؟

234
00:21:07,400 --> 00:21:10,680
أرسل بعض الأشخاص إلى المكان
!الّذي سأخبرك عنه الآن

235
00:21:10,680 --> 00:21:12,890
!لك ذلك! سأفعل هذا في الحال

236
00:21:12,890 --> 00:21:14,600
.إغلاق

237
00:21:15,850 --> 00:21:17,770
لكن كيف...؟

238
00:21:17,770 --> 00:21:22,160
أفعل أونيمارو هذا؟
...لكن يستطيع البشر فقط فعل هذا

239
00:21:22,160 --> 00:21:25,440
من فعل هذا إذًا؟

240
00:21:32,660 --> 00:21:34,460
...كاواماتسو-ساما

241
00:21:34,460 --> 00:21:38,870
...لقد أدّيت... واجبي

242
00:21:38,870 --> 00:21:40,540
!بالتّوفيق

243
00:21:57,510 --> 00:22:01,060
.يبدو أنّ هنالك أسلحة بما يكفي للسّاموراي

244
00:22:01,520 --> 00:22:02,410
...نعم

245
00:22:02,410 --> 00:22:05,730
.كلّ ما بقي الآن هو استعادة سيفي شوسوي

246
00:22:05,730 --> 00:22:08,420
ذلك الوغد... أين ذهب؟

247
00:22:08,420 --> 00:22:10,110
!زوروجورو-سان

248
00:22:10,110 --> 00:22:14,500
،إن كان سيفك هو شوسوي الحقيقيّ

249
00:22:14,500 --> 00:22:16,200
!أعده إلى بلاد وانو

250
00:22:16,200 --> 00:22:18,790
!أخبرتك! إنّه سيفي

251
00:22:21,200 --> 00:22:22,750
!سأمنحك بديلاً عنه

252
00:22:24,080 --> 00:22:27,710
...سيف ورثته عن والدي المتوفّى

253
00:22:30,840 --> 00:22:32,720
!السّيف العظيم إنما

254
00:22:33,090 --> 00:22:34,050
...إنما

255
00:22:34,680 --> 00:22:39,060
إنّه سيف أسطوريّ والسّلاح الوحيد
!الّذي جرح كايدو على الإطلاق

256
00:22:46,150 --> 00:22:48,230
...سأعطيك إيّاه

257
00:22:48,770 --> 00:22:51,150
...السّيف الّذي قطع كايدو

258
00:22:52,150 --> 00:22:54,110
...إنما

259
00:23:04,580 --> 00:23:07,460
!إنّها معركة بين اليونكو كايدو وبيغ مام

260
00:23:07,460 --> 00:23:10,220
،وبينما تتواصل لمستويات غير متوقّعة

261
00:23:10,220 --> 00:23:14,840
يصل أبو من الجيل الأسوأ ومجموعة من
!الكائنات العملاقة تُدعى الأرقام إلى وانو

262
00:23:14,840 --> 00:23:22,470
،انضمام شخص قويّ آخر إلى جيش كايدو المنيع
!يضع لوفي ورفاقه في وضع لا يحسدون عليه

263
00:23:22,470 --> 00:23:23,910
:في الحلقة القادمة من وان بيس

264
00:23:23,940 --> 00:23:27,200
"!تحالف جديد؟! تجمّع جيش كايدو"

265
00:23:27,200 --> 00:23:30,650
!ملك القراصنة، لن يكون إلاّ أنا