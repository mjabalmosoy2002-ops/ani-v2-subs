1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,490
...اسعوا نحو الحرّيّة

3
00:00:13,490 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:02,130 --> 00:02:05,400
!سحقًا، سحقًا، سحقًا

22
00:02:05,400 --> 00:02:09,370
!كم مرّة ستواصل البحريّة الهجوم علينا؟

23
00:02:09,630 --> 00:02:12,700
،إن كنت تريد النّجاة من هذا
!واصل التّجديف وتوقّف عن التذمّر

24
00:02:18,080 --> 00:02:21,910
!سنموت

25
00:02:24,620 --> 00:02:27,020
!يا لوفي! ساعدنا

26
00:02:27,320 --> 00:02:30,990
...لا، لقد خارت قوّتي
...لم آكل شيئًا منذ الصّباح

27
00:02:31,960 --> 00:02:33,960
!أهذا الوقت المناسب لتجوع؟

28
00:02:37,160 --> 00:02:39,000
!أيّها الرّائد! أيّها الرّائد باسكوا

29
00:02:39,000 --> 00:02:42,330
امتثل في نقطة المراقبة حالاً رجاءً
!أيّها الرّائد باسكوا

30
00:02:42,830 --> 00:02:44,100
!أيّها الرّائد باسكوا

31
00:02:48,470 --> 00:02:51,180
!اخرس أيّها المعتوه

32
00:02:51,510 --> 00:02:53,180
.يكفي أن تناديني مرّةً

33
00:02:53,180 --> 00:02:55,180
.أ-أنا جدّ آسف أيّها الرّائد

34
00:02:55,180 --> 00:02:58,550
،لكنّنا التحمنا مع المجرم المطلوب
!مونكي د. لوفي

35
00:02:58,850 --> 00:03:00,020
!ماذا؟

36
00:03:04,690 --> 00:03:06,260
.أخذت وقتك في المجيء

37
00:03:07,090 --> 00:03:09,660
.كدتَ تفوّت اللّقاء التّاريخيّ

38
00:03:10,230 --> 00:03:11,400
.ناوليني المنظار

39
00:03:13,870 --> 00:03:17,300
.لا شكّ في ذلك. إنّها راية قبّعة القشّ لوفي

40
00:03:17,770 --> 00:03:18,670
.نعم، صحيح

41
00:03:20,710 --> 00:03:22,470
...ذلك الغبيّ

42
00:03:23,010 --> 00:03:25,310
،كنّا نطلق عليهم طلقات تحذيريّة لوهلة

43
00:03:25,310 --> 00:03:26,910
.لكنّهم لم يظهروا أيّ نيّة في التّوقّف

44
00:03:26,910 --> 00:03:28,610
...أيّها الرّائد، هلاّ فعلت "ذلك" رجاءً

45
00:03:28,610 --> 00:03:30,780
...أفعل "ذلك"؟ إن كنت مصرًّا

46
00:03:31,880 --> 00:03:32,980
.أظنّني سأفعل

47
00:03:33,620 --> 00:03:36,960
!ها هي ذي! المهارة الخاصّة للرّائد

48
00:03:36,960 --> 00:03:39,490
المهارة الّتي أسقطت عددًا
...لا يحصى من سفن القراصنة

49
00:03:39,490 --> 00:03:40,760
!قنبلة الإصبع

50
00:03:53,670 --> 00:03:54,440
ماذا؟

51
00:03:54,440 --> 00:03:56,840
!ماذا فعلت أيّها الرّائد؟

52
00:04:00,410 --> 00:04:01,280
ما كان ذلك؟

53
00:04:01,280 --> 00:04:02,780
هل يطلقون على بعضهم؟

54
00:04:05,620 --> 00:04:07,350
!هذا جزاؤكم يا حثالة البحريّة

55
00:04:07,350 --> 00:04:09,920
!تنبّأتُ أنّ هذا سيحدث من البداية

56
00:04:10,320 --> 00:04:11,790
متى تنبّأت به؟

57
00:04:12,560 --> 00:04:13,290
!حسنًا

58
00:04:13,290 --> 00:04:16,530
،بينما تتداعى تشكيلتهم
!سننتهز هذه الفرصة للهرب

59
00:04:16,530 --> 00:04:19,500
أنقذوا الرّجال الّذين سقطوا
!في البحر من السّفينة الغارقة

60
00:04:19,500 --> 00:04:21,500
!هل أنتم بخير؟

61
00:04:22,070 --> 00:04:24,270
!تبتعد سفينة غوينغ ميري أكثر

62
00:04:24,500 --> 00:04:25,500
!حسنٌ

63
00:04:25,500 --> 00:04:26,740
!لا شيء حسن في هذا

64
00:04:27,310 --> 00:04:29,310
...فرصتي لنيل مليار بيري

65
00:04:27,310 --> 00:04:30,610
بدأت عجلة الحظّ تدور، صحيح؟

66
00:04:29,310 --> 00:04:34,010
!لا، ترقيتي... تتلاشى أيّها الرّائد باسكوا

67
00:04:31,840 --> 00:04:35,080
.أجل. كلّ شيء يسير مسار التّاريخ

68
00:04:35,350 --> 00:04:36,580
!عالجوا الجرحى

69
00:04:36,580 --> 00:04:40,290
!سيُبحر الأسطول إلى لولوكا كما هو مخطّط

70
00:04:44,590 --> 00:04:48,890
!أسطورة ضباب قوس قزح"
".جزيرة لولوكا والعجوز هينزو

71
00:05:00,310 --> 00:05:01,210
أين البحريّة؟

72
00:05:01,540 --> 00:05:02,970
.يبدو أنّنا نفدنا منهم

73
00:05:04,040 --> 00:05:06,880
.كانوا يلاحقوننا بشكل مكثّف مؤخرًا

74
00:05:07,250 --> 00:05:09,510
عند وجود شخصين بمكافأة على رأسيهما

75
00:05:09,510 --> 00:05:12,150
على متن السّفينة، فمن الطّبيعيّ
.أن تلاحقنا البحريّة بجدّيّة

76
00:05:23,090 --> 00:05:24,400
...لوفي

77
00:05:25,200 --> 00:05:26,830
.احذر

78
00:05:26,830 --> 00:05:29,930
يبدو أنّ هنالك الكثير
.من الشّعاب تحت الأمواج

79
00:05:40,850 --> 00:05:42,050
!ثمّة ميناء

80
00:05:42,050 --> 00:05:43,650
!ماذا؟! ميناء؟

81
00:05:43,650 --> 00:05:45,480
!انظرا! يمكنكما رؤية المنارة

82
00:05:46,650 --> 00:05:48,120
ميناء إذًا؟

83
00:05:48,120 --> 00:05:49,890
!ما يعني أنّ هنالك ما يُؤكل

84
00:05:56,130 --> 00:05:58,400
.ماذا؟ ليست منارة

85
00:05:58,400 --> 00:06:00,930
.إنّه برج طويل حقًّا

86
00:06:01,330 --> 00:06:03,600
!من يهتمّ؟ لنجد طعامًا نأكله! طعام

87
00:06:03,600 --> 00:06:05,570
.فهمنا. فقط امسح لعابك

88
00:06:11,780 --> 00:06:12,980
!انتظروا يا هؤلاء

89
00:06:14,350 --> 00:06:19,880
في جزيرة لولوكا، على كلّ السّفن الّتي
،ترسوا في مينائنا أو حتّى بين الصّخور

90
00:06:20,520 --> 00:06:22,250
!أن تدفع رسوم الميناء

91
00:06:22,250 --> 00:06:23,920
رسوم الميناء؟

92
00:06:23,920 --> 00:06:26,720
بيت القصيد هو أنّنا يجب
.أن ندفع لهم مالاً

93
00:06:26,720 --> 00:06:31,030
مهلاً، لِمَ علينا أن ندفع
الضّريبة فقط على الرّسو هنا؟

94
00:06:31,030 --> 00:06:33,000
!لأنّه واجبكم

95
00:06:33,000 --> 00:06:34,530
!ستدفعون أم لا؟

96
00:06:35,030 --> 00:06:35,830
...اسمع

97
00:06:36,730 --> 00:06:38,900
.لا تتحدّث بهذا الأسلوب مع آنسة

98
00:06:39,340 --> 00:06:40,610
!ماذا؟

99
00:06:45,010 --> 00:06:46,850
!طعام

100
00:06:46,850 --> 00:06:49,110
!طعام! طعام! طعام! طعام

101
00:06:50,220 --> 00:06:52,420
...ذلك الوغد

102
00:06:52,420 --> 00:06:53,550
هل أنت بخير؟

103
00:06:53,550 --> 00:06:55,650
!نعم! بخير حال

104
00:06:56,190 --> 00:06:57,560
.هيّا، لنذهب

105
00:06:57,560 --> 00:06:59,990
أريد أن أشتري بعض ورق
.الرّسم لأرسم بعض الخرائط

106
00:06:59,990 --> 00:07:02,030
!سأرافقك يا نامي-سان

107
00:07:02,030 --> 00:07:04,160
!سـ-سآتي معكما

108
00:07:04,530 --> 00:07:07,930
...مـ-مهلاً! سآتي أيضًا! أنا أيضًا

109
00:07:06,600 --> 00:07:07,930
!أنتم يا هؤلاء

110
00:07:13,200 --> 00:07:15,910
.هناك ما أريد أن أسألكم

111
00:07:16,370 --> 00:07:18,540
نوع جديد من المهرّجين؟

112
00:07:18,540 --> 00:07:20,880
.قد يكون بائعًا مخادعًا

113
00:07:21,180 --> 00:07:22,550
!لستُ أيًّا منهما

114
00:07:23,780 --> 00:07:27,090
هل رأيتم ضبابًا بألوان الطّيف؟

115
00:07:28,050 --> 00:07:30,760
ماذا؟ ضباب بألوان الطّيف؟

116
00:07:30,760 --> 00:07:32,560
.لا فائدة. إنّه غبيّ

117
00:07:32,560 --> 00:07:33,730
هل استبق الحكم عليّ؟

118
00:07:33,730 --> 00:07:35,360
!مهلاً، انتظر لحظة

119
00:07:35,360 --> 00:07:38,460
!ما هذا الأسلوب بعد أن سألتني سؤالاً؟

120
00:07:38,460 --> 00:07:40,870
.أتساءل إن كان بإمكانك إخباري عنه

121
00:07:46,910 --> 00:07:48,670
!أيّها العمّ، أريد المزيد

122
00:07:48,670 --> 00:07:50,580
!حالاً! طبق خاصّ آخر

123
00:07:50,580 --> 00:07:51,880
!المزيد لأجلي أيضًا

124
00:07:52,240 --> 00:07:53,550
.تفضّل طبقك الخاصّ

125
00:07:54,210 --> 00:07:56,080
تستطيع دفع ثمن الطّعام، صحيح؟

126
00:07:56,080 --> 00:07:57,850
.سيدفع عنّي

127
00:07:57,850 --> 00:07:59,150
!ماذا؟ أنا؟

128
00:07:59,850 --> 00:08:02,850
.سأخبرك بأسرار ضباب قوس قزح

129
00:08:02,850 --> 00:08:04,660
.لذا من الطّبيعيّ أن تدفع

130
00:08:04,660 --> 00:08:06,560
!لست من طلب منك أن تخبره

131
00:08:08,230 --> 00:08:10,530
.اسمي هينزو

132
00:08:10,530 --> 00:08:15,730
أنا عبقريّ، لا، أنا عالم عبقريّ
.أجري بحثًا عن ضباب قوس قزح

133
00:08:15,730 --> 00:08:18,340
.لا يمكنك أن تدعو نفسك بعبقريّ

134
00:08:18,340 --> 00:08:20,640
.أيّ من يدعو نفسه كذلك ليس صادقًا

135
00:08:20,640 --> 00:08:21,770
...سيّد هينزو

136
00:08:22,240 --> 00:08:24,110
.ادعوني بالأستاذ

137
00:08:24,110 --> 00:08:24,740
!أنت

138
00:08:25,140 --> 00:08:27,580
أيّها الأستاذ، هل تعرف هذا الكتاب؟

139
00:08:28,750 --> 00:08:29,650
أذاك...؟

140
00:08:30,250 --> 00:08:32,050
.وجدته في ألاباستا

141
00:08:32,050 --> 00:08:35,820
صحيح. فكّرتُ أنّني سمعت عن
،ضباب قوس قزح في مكان ما من قبل

142
00:08:35,820 --> 00:08:38,420
ليتّضح أنّه اسم الكتاب
.الّذي تقرئينه يا روبين

143
00:08:39,320 --> 00:08:41,360
،لا أعرف من مؤلّفه

144
00:08:41,360 --> 00:08:44,230
.لكنّه أُصدر قبل 40 سنة

145
00:08:44,230 --> 00:08:48,900
وفقًا للكتاب، ضباب قوس قزح هو
.حديقة الآلهة، أو ربّما إل دورادو

146
00:08:49,370 --> 00:08:52,100
.سُجّل على أنّه مدخل مدينة الذّهب

147
00:08:53,040 --> 00:08:55,570
.تلك ما إلاّ أسطورة

148
00:08:55,570 --> 00:09:00,410
،أُغويَ العديد من قبل تلك الأسطورة

149
00:09:00,410 --> 00:09:03,310
،وذهبوا في رحلة لإيجاد ضباب قوس قزح

150
00:09:03,310 --> 00:09:05,880
.لكن لم يعد منها أيّ منهم

151
00:09:06,250 --> 00:09:08,850
.نعم حتّى أصدقائي

152
00:09:15,330 --> 00:09:18,200
.لهذا السّبب تبحث في أمر الضّباب إذًا

153
00:09:18,760 --> 00:09:20,300
...سيّدي

154
00:09:20,570 --> 00:09:24,070
.من الأفضل ألاّ تأخذوا ما يقوله محمل الجدّ

155
00:09:24,570 --> 00:09:25,700
ماذا تقصد؟

156
00:09:26,040 --> 00:09:28,670
.إنّه أحد كلاب المحافظ ويتّون

157
00:09:28,670 --> 00:09:29,810
كلاب؟

158
00:09:29,810 --> 00:09:33,650
صحيح! إنّه يتلقّى تمويلاً للبحث من
،قبل المحافظ ويعيش حياة الرّفاهيّة

159
00:09:33,950 --> 00:09:36,280
!إنّه عالم كاذب

160
00:09:45,060 --> 00:09:48,160
!فـ-فرقة تحصيل الضّرائب
!أتت فرقة تحصيل الضّرائب

161
00:09:48,360 --> 00:09:49,330
ماذا؟

162
00:09:49,330 --> 00:09:51,230
!أسرع واشرب ذلك

163
00:10:02,010 --> 00:10:04,640
.عجبًا، عجبًا أيّها المواطنون الصّالحون

164
00:10:05,210 --> 00:10:08,550
هل تستمتعون بوجباتكم؟

165
00:10:11,250 --> 00:10:14,090
.أنت هناك. يبدو أنّك تشرب شرابًا لذيذًا

166
00:10:14,090 --> 00:10:17,760
عندما تشرب الشّراب، عليك دفع
ضريبة شرب الشّراب، صحيح؟

167
00:10:21,160 --> 00:10:22,730
!مـ-مهلاً، انتظروا لحظة

168
00:10:23,090 --> 00:10:27,270
كـ-كلّ ما أملك في جيبي
!هو قوت عيش زوجتي وأولادي

169
00:10:27,630 --> 00:10:30,300
.من واجب المواطن أن يدفع الضّرائب

170
00:10:31,640 --> 00:10:36,410
من يتجاهل التزاماته، لا يملك
.الحقّ في العيش في هذه البلدة

171
00:10:37,310 --> 00:10:38,740
من هذا الشّخص؟

172
00:10:38,740 --> 00:10:40,710
.ابن المحافظ ويتّون، فيليب

173
00:10:41,450 --> 00:10:45,220
وغدٌ بغيض يستأصل منّا
.كلّ أنواع الضّرائب

174
00:10:47,920 --> 00:10:51,260
...عجبًا، عجبًا، الأستاذ هينزو

175
00:10:51,260 --> 00:10:53,830
.كان أبي يبحث عنك

176
00:10:53,830 --> 00:10:56,230
كان يتساءل كيف يسير
.بحثك عن الضّباب

177
00:10:56,490 --> 00:10:58,230
.كحاله

178
00:10:58,230 --> 00:11:02,430
لا يمكننا أن نجزم متى أو
.أين سيظهر الضّباب في النّهاية

179
00:11:02,770 --> 00:11:08,640
يا إلهي. بحثك مدعوم
.من أموال ضرائب المواطنين

180
00:11:08,640 --> 00:11:13,610
تمّ بناء برج قوس قزح هناك
.بناءً على بحثك

181
00:11:13,950 --> 00:11:16,450
،تذكّر أنّه كلّما تباطأ بحثك

182
00:11:16,450 --> 00:11:19,880
.تضايق الجميع هنا

183
00:11:20,320 --> 00:11:21,890
.حسنًا، سأراك لاحقًا

184
00:11:29,360 --> 00:11:31,230
...عجبًا، عجبًا

185
00:11:31,230 --> 00:11:34,630
يا هذا، إنّك تأكل طبقًا
مكوّمًا بالمعكرونة، صحيح؟

186
00:11:34,630 --> 00:11:37,240
.نعم، كنتُ جائعًا

187
00:11:38,670 --> 00:11:43,340
تناول طبق مكوّم يعني أنّك
ستدفع ضرائب مكوّمة، صحيح؟

188
00:11:43,810 --> 00:11:46,080
.هو من سيدفع

189
00:11:46,080 --> 00:11:47,480
!أنا؟

190
00:11:54,090 --> 00:11:57,090
لِمَ أنا يا إلهي؟

191
00:11:57,960 --> 00:11:58,590
!شكرًا

192
00:11:58,590 --> 00:12:00,060
!لا تعبث معي

193
00:12:05,430 --> 00:12:07,000
.فهمتم الآن

194
00:12:07,000 --> 00:12:10,500
إن كنتم لا تريدون أن يفكّر
،فيكم أهل البلدة بسوء

195
00:12:11,040 --> 00:12:12,600
.كفّوا عن التّسكّع مع هينزو

196
00:12:13,570 --> 00:12:15,110
.شكرًا على التّحذير

197
00:12:15,340 --> 00:12:18,310
.لكنّ ذلك ليس قراري

198
00:12:18,910 --> 00:12:20,080
.بل قرار القائد

199
00:12:40,600 --> 00:12:42,670
أ-أما زلت تتسوّقين؟

200
00:12:43,170 --> 00:12:44,840
.بالطّبع

201
00:12:44,840 --> 00:12:46,570
.عليّ أن أشتري أوراق الرّسم

202
00:12:46,570 --> 00:12:49,340
،إن نفدت منّا ونحن في البحر
.فسنكون في مأزق

203
00:12:49,340 --> 00:12:53,240
لكنّك تشترين الكثير من
.الأشياء الّتي لا حاجة لنا بها

204
00:12:53,710 --> 00:12:58,550
نامي-سان، سأتبعك حتّى قاع الجحيم
!لمرافقتك وأنت تتسوّقين

205
00:13:00,390 --> 00:13:02,850
!إنّهم هناك يا ليك-ساما! إنّهم هم

206
00:13:04,590 --> 00:13:06,220
أنتم أولئك المتغطرسون

207
00:13:06,220 --> 00:13:09,830
الّذين لم يدفعوا ضرائبهم
في الميناء، أليس كذلك؟

208
00:13:15,570 --> 00:13:18,570
!أنا حفيد المحافظ ويتّون، ليك

209
00:13:19,100 --> 00:13:23,740
أنا الضّابط الّذي يأخذ الضّرائب
!المتخلّف دفعها من المتغطرسين

210
00:13:23,740 --> 00:13:26,180
،لستُ واثقًا ممّا يجري هنا بالضّبط

211
00:13:26,180 --> 00:13:29,050
لكن إن أتيت إلى هنا بهدف
،تعكير رحلة تسوّقنا الممتعة

212
00:13:29,050 --> 00:13:30,620
.لن أظهر لك أيّ رحمة

213
00:13:45,960 --> 00:13:47,270
!سانجي

214
00:13:47,270 --> 00:13:48,670
!تبًّا، ما الّذي تفعله؟

215
00:13:49,070 --> 00:13:53,570
.شـ-شعرتُ بصدمة فور أن لمستُ جسده

216
00:13:53,570 --> 00:13:58,240
.لا فائدة. هذا ما يحدث لأيّ أحد يلمسني

217
00:13:58,740 --> 00:13:59,780
كهرباء؟

218
00:13:59,780 --> 00:14:00,780
.فهمت

219
00:14:00,780 --> 00:14:02,880
!إنّه يملك قدرات فاكهة الشّيطان

220
00:14:08,350 --> 00:14:10,360
!مُولّدك الخاصّ؟

221
00:14:23,430 --> 00:14:26,810
يبدو هذا مشؤومًا بطريقةٍ ما، صحيح؟

222
00:14:28,910 --> 00:14:32,280
!اختبر قوّة بذلة الصّدمة الكهربائيّة خاصّتي

223
00:14:32,780 --> 00:14:34,910
!الرّعد الجيّاش

224
00:14:42,550 --> 00:14:44,220
ماذا؟ أكان ذلك رعد؟

225
00:14:49,130 --> 00:14:50,330
!كان ذلك وشيكًا

226
00:14:50,330 --> 00:14:54,970
أحسنت في تفاديه، لكنّك
!لن تفلت هذه المرّة

227
00:14:57,070 --> 00:14:59,070
.تشوبّر، اعتن بنامي

228
00:14:59,070 --> 00:15:00,000
!مفهوم

229
00:15:00,240 --> 00:15:02,740
سانجي-كن، لا تقم بأيّ حماقة، اتّفقنا؟

230
00:15:03,810 --> 00:15:06,210
!حاضر، لا تقلقي عليّ

231
00:15:06,640 --> 00:15:09,180
.بل أنا قلقة على تلك

232
00:15:09,180 --> 00:15:09,910
هذه؟

233
00:15:10,250 --> 00:15:12,380
.إ-إنّها الشّيطان بعينه

234
00:15:12,620 --> 00:15:13,590
.لا بأس

235
00:15:13,590 --> 00:15:17,460
،لن أحافظ عليها من الضّرر فحسب
.بل لن تتّسخ بالغبار حتّى

236
00:15:18,690 --> 00:15:21,430
.لديكم محافظ ظالم حقًّا هنا

237
00:15:21,430 --> 00:15:24,960
يأخذ المال من كلّ شيء
.ويقول أنّه لأجل الضّرائب

238
00:15:24,960 --> 00:15:28,770
كيف يجرؤ على تسميتها
!ضرائب مكوّمة؟ يا لها من سرقة

239
00:15:28,770 --> 00:15:31,470
...آسف جميعًا

240
00:15:32,600 --> 00:15:34,370
لِمَ تعتذر أيّها العمّ؟

241
00:15:34,370 --> 00:15:37,680
ألم تصغ لما قاله أولئك الأشخاص؟

242
00:15:37,680 --> 00:15:38,680
.كلاّ، إطلاقًا

243
00:15:38,680 --> 00:15:42,150
.حسنًا، هذا العمّ متواطئ مع أولئك اللّصوص

244
00:15:42,150 --> 00:15:46,480
.يُهدر مال الجميع على حساب بحثه الغريب

245
00:15:47,820 --> 00:15:49,620
هل تفهم ما يجري حقًّا؟

246
00:15:49,620 --> 00:15:52,720
.كلاّ، إطلاقًا

247
00:15:50,520 --> 00:15:51,820
اسمع يا لوفي، هل سمعت بالقواقع؟

248
00:15:52,720 --> 00:15:53,930
ما الّذي يجري؟

249
00:15:53,930 --> 00:15:56,490
!إنّها سفينة! سفينة غاليون في الميناء

250
00:15:57,260 --> 00:15:58,200
سفينة غاليون؟

251
00:15:58,200 --> 00:15:59,400
...لا-لا يمكن

252
00:15:59,700 --> 00:16:01,970
!يبدو هذا مثيرًا للاهتمام! هيّا بنا

253
00:16:01,970 --> 00:16:03,470
!انتظر يا لوفي

254
00:16:15,580 --> 00:16:16,880
!إنّها ضخمة

255
00:16:20,920 --> 00:16:23,090
.إنّها سفينة قديمة جدًّا

256
00:16:23,090 --> 00:16:24,790
.إنّها التّالييليسين

257
00:16:25,090 --> 00:16:28,230
!التّـ-التاليـ...؟ مـ-مهلاً أيّها العمّ

258
00:16:38,040 --> 00:16:40,040
!مذهل

259
00:16:41,070 --> 00:16:43,410
!رائع

260
00:16:45,440 --> 00:16:48,780
!ممتاز! مذهل! أريد واحدة
!أريد واحدة حقًّا

261
00:16:48,780 --> 00:16:51,320
.نعم، هذا من طبعك

262
00:16:56,890 --> 00:16:58,060
...الرّعد

263
00:17:03,860 --> 00:17:05,630
!لا فائدة

264
00:17:10,840 --> 00:17:11,540
!سانجي

265
00:17:11,540 --> 00:17:12,900
!حقائب التّسوّق

266
00:17:13,840 --> 00:17:18,240
...هـ-هذا غباء... لقد تفاديتها

267
00:17:19,780 --> 00:17:21,180
!أنت الغبيّ

268
00:17:22,180 --> 00:17:23,820
!إنّه المعدن يا سانجي

269
00:17:23,820 --> 00:17:26,020
المقتنيات الثّمينة تسحب
!الكهرباء! تخلّص منها

270
00:17:26,020 --> 00:17:27,120
!لا

271
00:17:27,650 --> 00:17:29,120
!كانت غالية

272
00:17:29,120 --> 00:17:31,990
تعلم ما سيحدث لك
!إن أسقطتها، أليس كذلك؟

273
00:17:31,990 --> 00:17:35,160
نعم، لكن... بعد تلقّيه لتيّار
،كهربائيّ بتلك القوّة

274
00:17:35,160 --> 00:17:36,690
...كان الشّخص العاديّ لـ

275
00:17:36,690 --> 00:17:38,360
!ليس شخصًا عاديًّا، لذا لا مشكلة

276
00:17:40,530 --> 00:17:42,270
...هذا سيّئ

277
00:17:42,270 --> 00:17:45,400
...إن كانت هجماتي المباشرة لا تفلح

278
00:17:49,810 --> 00:17:50,380
!إنّه يهرب

279
00:17:50,380 --> 00:17:51,380
!انتظر

280
00:17:51,380 --> 00:17:52,580
!ليك-ساما

281
00:17:55,550 --> 00:17:56,380
!لنذهب بينما نستطيع

282
00:17:56,380 --> 00:17:58,620
!أحكم حمل حقائبي

283
00:17:58,620 --> 00:17:59,120
!حاضر

284
00:17:59,450 --> 00:18:02,890
،إن كانت بتلك الأهميّة
فلمَ لا تحمليها بنفسك؟

285
00:18:02,890 --> 00:18:03,890
أهذا خاطئ؟

286
00:18:03,890 --> 00:18:04,660
...لا

287
00:18:05,590 --> 00:18:08,060
!رابا نوي! إيسوكا

288
00:18:09,090 --> 00:18:10,430
!رونغو! بوكاو

289
00:18:11,560 --> 00:18:12,330
!أكيبي

290
00:18:12,900 --> 00:18:16,030
!رفاق! يا رفاق

291
00:18:28,550 --> 00:18:30,180
!أيّها العمّ

292
00:18:31,180 --> 00:18:32,150
...غومو غومو نوو

293
00:18:33,720 --> 00:18:35,120
!الصّاروخ

294
00:18:35,620 --> 00:18:36,720
!...ذ-ذراعك

295
00:18:38,260 --> 00:18:40,230
!أيّها العمّ، أعطني ذلك القارب

296
00:18:40,230 --> 00:18:42,860
هـ-هل أكلت فاكهة شيطان...؟

297
00:18:42,860 --> 00:18:46,200
.أنا؟ أنا رجل مطّاطيّ، أكلت فاكهة المطّاط

298
00:18:47,430 --> 00:18:51,670
."لا يمكنني إعطاؤك آلة الـ"إتش-1

299
00:18:51,670 --> 00:18:55,470
!ماذا؟ لا تقل هذا، أعطها لي

300
00:18:59,840 --> 00:19:02,450
يبدو أنّه كان هناك أشخاص
.هنا قبل وهلة فقط

301
00:19:03,310 --> 00:19:06,420
.لا يوجد أيّ شخص على هذه السّفينة

302
00:19:08,790 --> 00:19:13,860
لقد انجرفت هذه السّفينة
.منذ خمسين سنة

303
00:19:13,860 --> 00:19:15,690
!خمسون سنة؟

304
00:19:16,230 --> 00:19:18,760
.أجد تصديق ذلك صعبًا

305
00:19:20,570 --> 00:19:22,170
.لا شكّ في ذلك

306
00:19:22,500 --> 00:19:24,540
.ما زالت السّفينة كما كانت عليه آنذاك

307
00:19:24,540 --> 00:19:27,470
مهلاً، عمّاذا تتحدّث أيّها العمّ؟

308
00:19:29,840 --> 00:19:31,110
مـ-ما ذلك؟

309
00:19:31,880 --> 00:19:32,880
...إ-إنّه

310
00:19:35,680 --> 00:19:37,480
!إنّ راداري يتفاعل

311
00:19:37,480 --> 00:19:40,020
!لم أحصل على قراءة بهذه الكثافة من قبل

312
00:19:46,930 --> 00:19:48,660
!إنّه ضباب قوس قزح

313
00:19:48,660 --> 00:19:52,860
سحقًا، لا أستطيع الخروج
."إلى عرض البحر بالـ"إتش-1

314
00:19:52,860 --> 00:19:53,700
ما العمل؟

315
00:19:54,000 --> 00:19:55,170
!وجدتها

316
00:19:57,370 --> 00:19:58,540
!سأستعير هذه

317
00:19:58,540 --> 00:19:59,770
!ماذا؟

318
00:20:00,040 --> 00:20:01,770
!لا تسرق سفينتنا

319
00:20:01,770 --> 00:20:04,680
!إن أردت الذّهاب، فخذ الغاليون

320
00:20:05,940 --> 00:20:11,650
،ما زال مقود التّالييليسين محطّمًا
.على يد ويتّون

321
00:20:11,650 --> 00:20:14,120
ماذا تقول أيّها العمّ؟

322
00:20:14,120 --> 00:20:16,490
كيف تعرف ذلك؟

323
00:20:16,790 --> 00:20:21,460
،لأنّه قبل خمسين سنة
.كنتُ على متن التّالييليسين

324
00:20:25,200 --> 00:20:26,030
!لقد اختفت

325
00:20:26,030 --> 00:20:28,000
!اختفت الغوينغ ميري

326
00:20:28,000 --> 00:20:30,400
!مهلاً، ما الّذي يجري هنا؟

327
00:20:30,640 --> 00:20:34,610
لا بدّ أنّ أولئك الأشخاص
!أخذوها بدلاً من الضّرائب

328
00:20:34,610 --> 00:20:36,310
!في تلك الحالة، ستكون في الميناء

329
00:20:36,310 --> 00:20:39,380
!سحقًا، رأس الطّحلب ذاك لا ينفع بشيء

330
00:20:42,550 --> 00:20:44,920
مهلاً، هل سندخل إلى هناك؟

331
00:20:44,920 --> 00:20:47,620
،إنّه مكان تحدّاه الكثير من المغامرين

332
00:20:47,620 --> 00:20:49,950
لكن لم يرجع أيّ منهم، صحيح؟

333
00:20:50,290 --> 00:20:51,160
.سندخل

334
00:20:51,520 --> 00:20:55,930
هذا السّبب الّذي واصلت
.بحثي لأجله حتّى اليوم

335
00:20:56,330 --> 00:20:57,400
هل أنت خائف؟

336
00:20:57,400 --> 00:20:59,400
!مـ-مستحيل أن أخاف

337
00:20:59,400 --> 00:21:04,040
أنا الّذي يجوب غمار
!الغراند لاين، القائد أوسوبّ

338
00:21:06,040 --> 00:21:08,940
!سننطلق إلى ضباب قوس قزح

339
00:21:35,900 --> 00:21:37,470
أيّها الأستاذ، أين نحن؟

340
00:21:37,470 --> 00:21:39,370
."حفلة القرد"

341
00:21:39,370 --> 00:21:41,410
.حفلة القرد"؟ لا يعقل"

342
00:21:41,410 --> 00:21:42,610
!مـ-ماذا تعني؟

343
00:21:43,410 --> 00:21:47,080
مقبرة سفن، حيث من يدخلها
.لا يرجع منها أبدًا

344
00:21:47,380 --> 00:21:49,050
!مـ-ماذا؟

345
00:21:49,410 --> 00:21:52,020
!رائع

346
00:21:55,720 --> 00:22:03,790
آه، خلف السّماء الّتي لا نهاية لها

347
00:22:03,790 --> 00:22:14,410
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

348
00:22:22,280 --> 00:22:29,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

349
00:22:29,720 --> 00:22:38,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

350
00:22:38,130 --> 00:22:46,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

351
00:22:46,340 --> 00:22:55,180
دفعوا بي للأمام، أليس كذلك؟

352
00:22:55,180 --> 00:23:03,490
آه، إنّ النّجوم تهوي من السّماء

353
00:23:03,490 --> 00:23:06,620
...وهذه اللّحظة الفريدة

354
00:23:11,830 --> 00:23:14,700
.كنتُ قرصانًا من قبل، مثلكم تمامًا

355
00:23:14,700 --> 00:23:16,730
.لستُ خائفًا من مكان هكذا

356
00:23:16,730 --> 00:23:18,770
.أنت، قرصان؟ لا تبدو كذلك بالنّسبة لي

357
00:23:18,770 --> 00:23:22,010
عندما كنتُ صغيرًا، كان لي إيمان
.راسخ بأنّني أستطيع القيام بأيّ شيء

358
00:23:22,010 --> 00:23:25,940
لكنّ ذلك القرصان اليافع
.ما زال حيًّا، في قلبك

359
00:23:25,940 --> 00:23:28,310
.أخبرني بقصّتك أيّها الجدّ

360
00:23:28,310 --> 00:23:29,810
:في الحلقة القادمة من ون بيس

361
00:23:29,810 --> 00:23:32,750
"!سكّان أرض البقاء! قراصنة اليقطين"

362
00:23:32,750 --> 00:23:35,090
!ملك القراصنة، لن يكون إلاّ أنا