1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:00,150 --> 00:02:02,070
!لا وقت لنضيّعه

29
00:02:02,070 --> 00:02:05,320
!لنأخذ الشّمطاء إلى كايدو-سان

30
00:02:05,320 --> 00:02:07,160
!بسرعة

31
00:02:12,790 --> 00:02:14,540
!استعدّوا للإبحار

32
00:02:24,380 --> 00:02:28,970
!يزداد التّوتّر في أونيغاشيما"
"!لقاء بين اثنين من اليونكو؟

33
00:02:38,190 --> 00:02:41,360
.حسنًا. سنترك الأمر لك

34
00:02:41,980 --> 00:02:44,190
!اعتمدوا عليّ

35
00:02:45,400 --> 00:02:48,660
...سآخذ على عاتقي

36
00:02:48,660 --> 00:02:54,580
.مسؤوليّة رقود جثمان ياسويي-ساما في كوري بسلام

37
00:03:06,920 --> 00:03:10,010
.توخّ الكثير من الحذر

38
00:03:10,010 --> 00:03:12,430
...بالطّبع

39
00:03:12,810 --> 00:03:18,770
...ندين بالكثير لياسويي-ساما أيضًا

40
00:03:23,570 --> 00:03:25,150
...هنالك أمر آخر

41
00:03:25,690 --> 00:03:29,410
.أريد الاعتذار عنه

42
00:03:29,410 --> 00:03:33,830
بشأن تلك المنشورات ذات العلامة
...الّتي انتشرت مؤخّرًا

43
00:03:33,830 --> 00:03:37,170
.مرّت عشرون سنة مذ اندثر اسم كوزكي

44
00:03:37,170 --> 00:03:40,330
لا أستطيع الآن جمع ما يكفي
،من الجنود لتحقيق انتقامي

45
00:03:40,670 --> 00:03:43,920
...وأشعر بالسّوء حيال عشيرة كوزكي

46
00:03:44,800 --> 00:03:47,050
!لذلك صنعت تلك المنشورات

47
00:03:47,260 --> 00:03:50,770
.لا يعني الرّمز أيّ شيء

48
00:03:50,770 --> 00:03:51,680
...إنّه

49
00:03:52,050 --> 00:03:55,180
!مجرّد مقلب

50
00:03:56,430 --> 00:03:59,140
!ماذا؟

51
00:03:59,940 --> 00:04:04,770
...لكنّ أوروتشي كان جبانًا أكبر ممّا ظننت

52
00:04:05,230 --> 00:04:11,740
اضطرب وسَجن الأبرياء الّذين كان لديهم
!وشم الهلال الّذي هو تصميم شائع

53
00:04:12,780 --> 00:04:15,550
!ياسويي اللّعين

54
00:04:15,550 --> 00:04:18,500
!سأملأ جسدك بالرّصاص

55
00:04:18,910 --> 00:04:20,500
!أوروتشي

56
00:04:22,170 --> 00:04:26,920
هل تريدني أن أردّد اللّعنة الّتي تقيّد قلبك؟

57
00:04:32,180 --> 00:04:35,720
...ما كان رجل قليل الشّأن"

58
00:04:37,180 --> 00:04:41,810
"!ليعرف أبدًا طعم الأودن ما حيا

59
00:04:53,070 --> 00:04:55,120
!ياسويي

60
00:05:13,340 --> 00:05:19,100
...لم تُسحق أمنيتنا العزيزة بفضل ياسويي-ساما

61
00:05:19,100 --> 00:05:21,940
،لا يمكننا إقامة جنازة كبيرة

62
00:05:21,940 --> 00:05:27,150
لكن نريد على الأقلّ أن ندفنه
.تحت نفس الأرض مع أودن-ساما

63
00:05:27,520 --> 00:05:29,280
...أرجوك

64
00:05:29,280 --> 00:05:32,240
!اعتن به جيّدًا

65
00:05:35,240 --> 00:05:36,970
!نعتمد عليك

66
00:05:36,970 --> 00:05:39,370
!أرجوك

67
00:05:36,970 --> 00:05:39,370
!شكرًا لك

68
00:05:43,370 --> 00:05:45,090
!جميعنا جاهزون

69
00:05:45,090 --> 00:05:47,630
!لننطلق يا نامي وكانجورو

70
00:05:47,630 --> 00:05:48,730
!حسنًا

71
00:05:48,730 --> 00:05:52,090
!انتظروني! لنذهب معًا

72
00:05:55,930 --> 00:05:57,970
!مع السّلامة لكم جميعًا

73
00:05:57,970 --> 00:06:00,810
!رافقتكم السّلامة

74
00:06:18,030 --> 00:06:22,080
عند ميناء على الطّريق المؤدّي
...إلى كوري من عاصمة الزّهور

75
00:06:27,000 --> 00:06:33,130
أثناء ذلك، وبغرض الإمساك بالمجرمين الخطيرين
،الّذين حاولوا قتل أوروتشي-ساما والهرب

76
00:06:33,130 --> 00:06:37,510
!وضعنا نقاط تفتيش في كلّ أنحاء عاصمة الزّهور

77
00:06:42,310 --> 00:06:45,000
!أظهروا وجوهكم جميعًا

78
00:06:45,000 --> 00:06:46,440
ماذا علينا أن نفعل؟

79
00:06:47,150 --> 00:06:50,570
.عرفت أنّهم لن يسمحوا لنا بالفرار بسهولة

80
00:06:50,980 --> 00:06:54,920
.علينا ركوب ذلك القارب إن أردنا مغادرة كوري

81
00:06:54,920 --> 00:06:58,700
.ينبغي لنا التّفكير في خطّة للعبور

82
00:07:04,700 --> 00:07:06,160
!حسنًا، يمكنكما المرور

83
00:07:06,710 --> 00:07:07,710
!التّالي

84
00:07:22,140 --> 00:07:23,770
!ماذا؟

85
00:07:28,140 --> 00:07:33,270
!لعنةٌ عليكم

86
00:07:35,360 --> 00:07:38,610
!إ-إنّهما ملبوسان بشبح

87
00:07:39,280 --> 00:07:42,120
.يـ-يمكنكما المرور

88
00:07:52,710 --> 00:07:55,840
.نجحنا في المرور

89
00:07:56,170 --> 00:07:57,780
كيف حال أوتوكو-تشان؟

90
00:07:57,780 --> 00:08:01,890
،لا بدّ أنّها متعبة من البكاء
.إنّها نائمة بين ذراعيّ

91
00:08:04,970 --> 00:08:09,350
...أجهل ما سأقوله لها بصراحة

92
00:08:09,940 --> 00:08:12,520
!أبي

93
00:08:19,570 --> 00:08:21,360
!أبي

94
00:08:35,130 --> 00:08:37,380
.أيّها العظميّ-كيتشي، سآخذها عنك

95
00:08:37,380 --> 00:08:40,050
.فما من دفء في جسدك

96
00:08:41,180 --> 00:08:42,340
!هذا قاسٍ

97
00:08:51,230 --> 00:08:53,270
ذلك ليس صحيحًا، أليس كذلك؟

98
00:09:06,240 --> 00:09:11,040
مرّ دهر منذ آخر مرّة مشينا فيها
...كتفًا لكتف هكذا

99
00:09:11,370 --> 00:09:13,880
.بعد ذكرك للأمر، فكلامك صحيح

100
00:09:14,750 --> 00:09:18,960
.كان ذلك منذ أيّام فحسب بالنّسبة لي

101
00:09:20,210 --> 00:09:21,840
.أشورا

102
00:09:21,840 --> 00:09:24,590
ما الّذي يوجد هنا في مكان كهذا؟

103
00:09:25,140 --> 00:09:28,220
.ثمّة أمر أردت أن أريه لكم

104
00:09:31,770 --> 00:09:34,690
!...هـ-هذه

105
00:09:35,310 --> 00:09:37,060
!غير ممكن

106
00:09:37,060 --> 00:09:38,130
سفن؟

107
00:09:38,130 --> 00:09:41,030
!سفن

108
00:09:49,660 --> 00:09:52,310
!يعجز لساني عن الكلام! أشورا

109
00:09:52,310 --> 00:09:55,000
...إنّها بحاجة لبعض الإصلاحات

110
00:09:55,540 --> 00:10:00,960
لكنّني أحضرتها إلى هنا من موانئ
.حول البلاد دمّرها كايدو

111
00:10:00,960 --> 00:10:06,260
!بحوزتنا ما يكفي لنقل آلاف المحاربين إلى أونيغاشيما

112
00:10:07,010 --> 00:10:11,370
!يمكن الاعتماد عليك بالفعل
!تحسّن رأيي فيك

113
00:10:11,370 --> 00:10:16,270
.نعم، ورأيي أيضًا
.لم تكن تكترث كثيرًا سابقًا

114
00:10:20,110 --> 00:10:23,490
!لم أقضِ عشرين سنة مكتوف اليدين

115
00:10:23,860 --> 00:10:28,700
.سأطلب من فرانوسكي-دونو إصلاحها لاحقًا

116
00:10:29,910 --> 00:10:34,580
...كان الطّريق إلى هنا وعرًا وطويلًا

117
00:10:37,880 --> 00:10:43,510
!لكنّ يوم شنّنا للغارة وشيك

118
00:11:05,150 --> 00:11:06,800
...لم يكن ذلك صائبًا

119
00:11:06,800 --> 00:11:09,160
!ما الّذي تفعله يا لوفي؟

120
00:11:09,570 --> 00:11:12,380
!ما زلتَ بحاجة للرّاحة

121
00:11:12,380 --> 00:11:13,450
!عد في الحال

122
00:11:13,450 --> 00:11:16,140
الجميع يتجهّزون، صحيح؟

123
00:11:16,140 --> 00:11:17,230
ماذا؟

124
00:11:17,230 --> 00:11:19,710
.عليّ إتقان هذه التّقنية أيضًا

125
00:11:19,710 --> 00:11:21,420
أيّ تقنية؟

126
00:11:21,420 --> 00:11:23,090
.إنّها ريو

127
00:11:26,470 --> 00:11:29,470
،إن كنت بحاجة لتدريب مكثّف
.سأكون زميلك في التّدريب

128
00:11:32,060 --> 00:11:33,890
!اضربني بلا أيّ هوادة

129
00:11:34,680 --> 00:11:35,580
!لك ذلك

130
00:11:35,580 --> 00:11:38,520
!ماذا؟! هل ستكون بخير؟

131
00:11:44,860 --> 00:11:49,320
!السّماح للهاكي بالتّدفّق... داخل جسمي

132
00:12:02,630 --> 00:12:04,000
!هذا مذهل

133
00:12:16,980 --> 00:12:19,560
أهذا هو ريو؟

134
00:12:21,520 --> 00:12:24,150
...حينها، كان فتى قبّعة القشّ

135
00:12:24,730 --> 00:12:27,740
!يستعمل ريو بكلّ تأكيد

136
00:12:30,860 --> 00:12:35,170
...أفترض أنّ كاواماتسو الكابّا قويّ جدًّا

137
00:12:35,170 --> 00:12:38,620
.لأنّه استعمل ريو أيضًا

138
00:12:38,620 --> 00:12:43,350
،بمجرّد أن يتقنه فتى قبّعة القشّ
.واثق أنّه سيساعده في قتاله ضدّ كايدو

139
00:12:43,350 --> 00:12:45,170
!مرّة أخرى

140
00:12:46,130 --> 00:12:47,460
!حاضر

141
00:13:01,440 --> 00:13:04,110
...لا أصدّق أنّ الأمر أخذ كلّ هذه السّنين

142
00:13:04,110 --> 00:13:07,690
...فقط لإحضار بعض التّوفو المقليّ

143
00:13:11,400 --> 00:13:17,040
.لا يمكنني حتّى التّفكير أنّها ما زالت في انتظاري

144
00:13:36,930 --> 00:13:40,030
.لم تتعلّم أيّ شيء وعدت

145
00:13:40,030 --> 00:13:43,650
.كان هنالك تدخّل غير مرغوب فيه في آخر مرّة

146
00:13:44,520 --> 00:13:48,400
.أراهن أنّك لا تحبّ تركه بلا تسوية أيضًا

147
00:13:49,690 --> 00:13:53,450
!إذًا، سآخذ بقيّة سيوفك أيضًا

148
00:14:52,210 --> 00:14:53,590
...أسلوب السّيفين

149
00:14:54,840 --> 00:14:57,340
!مدفع العنقاء ذو الـ720 رطلاً

150
00:15:07,940 --> 00:15:10,230
!لديّ أسلحة أكثر منك

151
00:15:21,160 --> 00:15:23,660
من تكون على أيّ حال؟

152
00:15:24,620 --> 00:15:26,710
!أأنت عدوّ أم حليف؟

153
00:15:29,290 --> 00:15:31,250
!من تكون؟

154
00:15:49,350 --> 00:15:55,150
لماذا تسرق أسلحة من الأشخاص
!الّذين يعبرون الجسر؟

155
00:15:55,150 --> 00:15:57,950
!أعد لي سيفي

156
00:15:58,530 --> 00:16:02,660
!لا تضيّع حياتك مقابل سيف

157
00:16:12,130 --> 00:16:13,630
...زوروجورو-سان

158
00:16:28,560 --> 00:16:32,480
!لن أعيده لك
!سأعطيك أيّ سيف سواه

159
00:16:40,530 --> 00:16:45,330
سيف شوسوي الّذي كنت
!تحمله كان كنزًا سُرق من بلاد وانو

160
00:16:47,620 --> 00:16:49,720
!ماذا؟ شوسوي؟

161
00:16:49,720 --> 00:16:54,090
!بدأت هذه المأساة برمّتها عندما أُخذ

162
00:16:54,750 --> 00:16:57,550
،وبسبب ذلك، استعرّ غضب إله السّيوف خاصّتنا

163
00:16:57,550 --> 00:17:00,770
!وهُزمت كلّ منطقة الواحدة تلو الأخرى

164
00:17:00,880 --> 00:17:03,720
!وفي النّهاية، استُلي على البلاد

165
00:17:07,850 --> 00:17:09,310
عن أيّ إله تتحدّث؟

166
00:17:10,520 --> 00:17:13,310
!كفاك ازدراءً

167
00:17:31,040 --> 00:17:33,790
!كفّا عن القتال

168
00:17:52,350 --> 00:17:58,410
ما الّذي يدفع ساموراي وراهب للقتال هكذا في البرّيّة؟

169
00:17:58,410 --> 00:18:02,530
من الغريب أنّ لا أحد منكما
...يملك نيّة قتل الآخر

170
00:18:03,110 --> 00:18:04,160
برمائيّ؟

171
00:18:29,390 --> 00:18:32,270
...كاوا... ماتسو

172
00:18:32,560 --> 00:18:35,020
!كاواماتسو؟! أهذا أنت؟

173
00:18:36,900 --> 00:18:38,560
!كيف تعرفين اسمي؟

174
00:18:57,710 --> 00:19:01,460
!لم تقم بعملك على أحسن وجه
!سُحقًا لك يا كينغ

175
00:19:02,380 --> 00:19:06,340
...أنا واثق أنّني أسقطت السّفينة من الشّلاّل

176
00:19:13,180 --> 00:19:16,290
يا أخي الكبير كوين، لماذا أحضرتها إلى هنا؟

177
00:19:16,290 --> 00:19:21,440
اخرس! وماذا عساي أفعل في أودن
!حيث الاتّصالات مقطوعة؟

178
00:19:23,900 --> 00:19:24,990
!كينغ

179
00:19:26,110 --> 00:19:29,630
،أنا جاهزة لنسيات ما فعلته لي

180
00:19:29,630 --> 00:19:31,990
!لذلك ما رأيك في الانضمام لي؟

181
00:19:37,290 --> 00:19:43,050
لدينا أشخاص من كلّ الأجناس
.في بلادنا ما عدا ثلاثة فقط

182
00:19:43,050 --> 00:19:47,970
قد يكون إحداها قد تلاشى
...واختفى عبر الزّمن

183
00:19:47,970 --> 00:19:50,630
.لكنّك ما زلت حيًّا

184
00:19:50,630 --> 00:19:51,720
!أرفض

185
00:20:11,120 --> 00:20:13,030
.يا للأسف

186
00:20:16,620 --> 00:20:19,390
حسنًا، لماذا لا تفكّون وثاقي؟

187
00:20:19,390 --> 00:20:22,750
!ما الّذي تعنينه بذلك؟
!لن نحرّرك أيّتها الشّمطاء

188
00:20:28,380 --> 00:20:31,090
...يا للقسوة

189
00:20:31,090 --> 00:20:33,180
هل كنت تعلم؟

190
00:20:33,970 --> 00:20:39,640
كان كلّ من بيغ مام وكايدو-ساما عضوين
!في نفس طاقم القراصنة في الماضي

191
00:20:40,060 --> 00:20:42,530
.فكّوا أغلالها

192
00:20:42,530 --> 00:20:44,570
ما الّذي تفعلونه؟

193
00:20:47,530 --> 00:20:48,900
!كايدو-ساما؟

194
00:20:48,900 --> 00:20:52,620
...وصلتِ أخيرًا يا لينلين

195
00:20:56,330 --> 00:20:58,250
.كايدو

196
00:21:15,470 --> 00:21:19,120
...أنتم! أخبركم أن تفكّوا أغلالي

197
00:21:19,120 --> 00:21:20,810
!ماذا؟

198
00:21:20,810 --> 00:21:24,150
...لا، لا، لا بدّ أنّه يمزح

199
00:21:24,150 --> 00:21:25,690
!فكّوا أغلالها

200
00:21:26,070 --> 00:21:27,530
!كايدو-سان

201
00:21:36,410 --> 00:21:39,040
...لم أرك منذ عقود

202
00:21:41,540 --> 00:21:43,250
!نابوليون

203
00:21:47,340 --> 00:21:49,260
!حاضر يا ماما

204
00:21:49,260 --> 00:21:52,140
!أنا سعيد لعودتك لسابق عهدك

205
00:21:52,140 --> 00:21:54,970
،أنا خجل في حضرة الغرباء
.لذلك لم أعرف ما العمل

206
00:21:56,350 --> 00:21:59,720
...أخبرتك أنّني سأقتلك إن أتيت

207
00:21:59,720 --> 00:22:03,270
!ما الأحمق هذا الّذي قد يسعى لموته بنفسه؟

208
00:23:04,460 --> 00:23:08,960
يتحمّس لوفي كثيرًا بوجود
!زعماء عالم الجريمة إلى جانبه

209
00:23:09,290 --> 00:23:14,170
في تلك الأثناء، يتقابل كاواماتسو وهيوري
!ثانية أخيرًا، لكنّ جيش أوروتشي يشنّ هجومًا

210
00:23:14,170 --> 00:23:16,850
!تُستلّ السّيوف! زورو وكاواماتسو

211
00:23:16,850 --> 00:23:22,020
!يلوّحان بسيوفهما الغالية عازمين على حماية هيوري

212
00:23:22,390 --> 00:23:23,770
:في الحلقة القادمة من وان بيس

213
00:23:23,770 --> 00:23:27,200
!اعتراف هيوري"
"!لمّ شمل على جسر قطّاع الطّرق

214
00:23:27,200 --> 00:23:31,480
!ملك القراصنة، لن يكون إلاّ أنا