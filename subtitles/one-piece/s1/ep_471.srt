1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,750 --> 00:03:36,010
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:36,010 --> 00:03:40,570
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:41,050 --> 00:03:44,080
،يحاول لوفي وقراصنة اللّحية البيضاء الوصول للمنصّة

40
00:03:44,080 --> 00:03:47,810
.لكنّ البحريّة تقف في طريقهم
!وتصير المعركة حامية أكثر

41
00:03:48,080 --> 00:03:53,910
وفجأة، يظهر جيش أسلحة البحريّة
!البشريّة يُدعى الباسيفيستا

42
00:03:57,380 --> 00:03:59,940
!انظروا لرأس الخليج! ثمّة شيء ما

43
00:04:01,950 --> 00:04:03,960
!ما-ما هؤلاء؟

44
00:04:04,550 --> 00:04:08,930
.هذا هو سلاح الحكومة البشريّ الّذي سمعنا عنه

45
00:04:11,450 --> 00:04:12,390
كـ-كوما؟

46
00:04:16,260 --> 00:04:20,770
!بداية العمل باستراتيجيّة الإبادة"
"!قوّة جيش الباسيفيستا

47
00:04:37,540 --> 00:04:39,840
!الشّيتشيبوكاي بارثولوميو كوما

48
00:04:40,160 --> 00:04:42,550
لماذا يوجد الكثير من كوما؟

49
00:04:43,320 --> 00:04:44,820
ما الّذي يحدث هنا؟

50
00:04:54,170 --> 00:04:57,200
!إنّهم من عاثوا فسادًا في شابوندي من قبل

51
00:04:57,950 --> 00:05:00,460
!ثمّة الكثير من بارثولوميو كوما

52
00:05:01,070 --> 00:05:03,130
!لديهم الكثير منهم الآن

53
00:05:15,740 --> 00:05:17,750
!إلى المكتب الرّئيسيّ! إلى المكتب الرّئيسيّ

54
00:05:18,210 --> 00:05:19,450
!لديّ أخبار هامّة

55
00:05:20,210 --> 00:05:22,440
!مرحبًا؟ مرحبًا؟

56
00:05:35,600 --> 00:05:38,070
أهذا هو الحقيقيّ؟

57
00:05:38,560 --> 00:05:40,510
سمعتُ من وقت لآخر

58
00:05:40,940 --> 00:05:45,180
أنّ الدّكتور فيغابانك يحاول بناء سلاح بشريّ

59
00:05:45,180 --> 00:05:49,100
.وكان يرسل نماذج أوّليّة إلى أماكن مختلفة مرارًا

60
00:05:49,350 --> 00:05:52,440
إذًا فهؤلاء هم السّلاح البشريّ؟

61
00:05:52,440 --> 00:05:54,920
لماذا يبدون جميعًا مثل كوما؟

62
00:05:55,550 --> 00:05:59,500
!يا عمّي! ألم يسر كلّ شيء كما خطّطتم؟

63
00:06:00,460 --> 00:06:02,180
سمعت أنّ القراصنة

64
00:06:02,180 --> 00:06:06,220
!سيُحاصرون بكلّ سهولة داخل الخليج عند خروجنا

65
00:06:06,950 --> 00:06:09,390
!لكنّهم منتشرون في كلّ مكان

66
00:06:12,300 --> 00:06:15,400
.يصرخ صاحب الفأس الكبيرة بشيء ما

67
00:06:19,090 --> 00:06:21,700
!أرى ما كانت البحريّة تخطّط له

68
00:06:22,940 --> 00:06:27,610
في البداية، سرّبوا معلومة إعدام إيس المبكّر

69
00:06:28,180 --> 00:06:30,330
.لدفعنا للاستعجال

70
00:06:30,740 --> 00:06:33,760
ثمّ تراجعوا بشكل بطيء

71
00:06:34,260 --> 00:06:37,340
...واستدرجوا كلّ القراصنة داخل الخليج

72
00:06:37,340 --> 00:06:40,900
ثمّ سدّوا رأس الخليج بالأسلحة
.البشريّة لإغلاق فخّهم

73
00:06:40,900 --> 00:06:42,390
!وكش ملك

74
00:06:43,180 --> 00:06:48,130
لهذا السّبب قال اللّحية البيضاء أنّ علينا
.إغراق سفن البحريّة الّتي حولنا أوّلاً

75
00:06:48,760 --> 00:06:50,260
.توقّع حدوث ذلك

76
00:06:50,450 --> 00:06:52,850
.لم نُحاصر بفضله

77
00:06:53,210 --> 00:06:54,390
.نعم

78
00:07:07,050 --> 00:07:08,840
،رغم أنّنا لم نستطع محاصرتهم

79
00:07:08,840 --> 00:07:11,230
!بإمكاننا مهاجمتهم من الأمام والخلف

80
00:07:11,550 --> 00:07:14,740
.هاجموا تحالف القراصنة أوّلاً كما خطّطنا

81
00:07:15,160 --> 00:07:19,080
!تخلّصوا من الّذين يبتعدون عن التّطويق

82
00:07:22,090 --> 00:07:23,880
هل سمعت ذلك؟

83
00:07:24,160 --> 00:07:27,000
يا عمّي، ألا بأس إن أصابت هجماتنا
بعض سفن البحريّة؟

84
00:07:27,440 --> 00:07:29,720
.لتكن الخسائر قليلة

85
00:07:30,620 --> 00:07:31,680
!عُلم

86
00:07:33,940 --> 00:07:35,050
!لنبدأ

87
00:07:46,810 --> 00:07:51,160
،لا أدري ما الّذي يجري
!لكن لا يمكنكم هزيمتنا بتلك السّهولة

88
00:08:07,730 --> 00:08:09,880
!كـ... كلاّ

89
00:08:26,190 --> 00:08:28,480
!انطلقوا أيّها الباسيفيستا

90
00:08:45,170 --> 00:08:46,290
!لقد فجّرهم

91
00:09:11,270 --> 00:09:14,740
.إنّهم جاهزون للتّضحية حتّى برجالهم

92
00:09:22,740 --> 00:09:25,260
!لا تخشوا شيئًا يا رجال

93
00:09:25,650 --> 00:09:28,750
!لنندفع نحو السّاحة بلا توقّف

94
00:09:45,830 --> 00:09:48,260
.التّراجع ليس خيارًا حتّى

95
00:09:49,470 --> 00:09:52,870
!سأصل إلى إيس قبل أن ينالوا منّي

96
00:09:59,430 --> 00:10:01,810
!يا رجال، غادروا السّفينة

97
00:10:02,210 --> 00:10:04,600
!صدّوا الأسلحة البشريّة

98
00:10:12,330 --> 00:10:13,590
.هيّا

99
00:10:16,130 --> 00:10:17,710
!سأقاتلكم

100
00:10:29,620 --> 00:10:32,980
!إلى كلّ الوحدات، ابتعدوا عن الجليد في الحال

101
00:10:34,000 --> 00:10:37,490
!لا تسمحوا للقراصنة بالوصول للسّاحة

102
00:10:38,240 --> 00:10:39,750
!تراجعوا

103
00:10:41,780 --> 00:10:42,860
!بسرعة

104
00:10:56,020 --> 00:11:01,500
لم أتوقّع أنّه سيتسنّى لي قتال أعظم
.سيّافي العالم في هذه الحرب

105
00:11:03,130 --> 00:11:05,190
.يا لحظّي السّعيد

106
00:11:06,560 --> 00:11:09,680
.أنت السّيّاف الأوّل بين قراصنة اللّحية البيضاء

107
00:11:10,070 --> 00:11:13,750
."دعني أرى مهارات مسايفة "سيف الزّهور

108
00:11:14,450 --> 00:11:16,280
.لديك أفضل مقعد للمشاهدة

109
00:11:16,860 --> 00:11:18,780
!رقصة الورد الدّائريّة

110
00:11:46,460 --> 00:11:49,680
أيّ نوع من الزّهور عليّ جعلها تتفتّح تاليًا؟

111
00:11:57,610 --> 00:12:00,160
!ادفعوهم للدّاخل أيّها الباسيفيستا

112
00:12:00,230 --> 00:12:02,860
!لن أسمح لك! خذ هذه

113
00:12:06,000 --> 00:12:06,830
!تستحقّ ذلك

114
00:12:20,380 --> 00:12:22,770
!ممّاذا صُنعوا؟

115
00:12:23,260 --> 00:12:25,290
!إنّهم ليسوا بشرًا

116
00:12:25,290 --> 00:12:26,520
!هل هم منيعون؟

117
00:12:30,480 --> 00:12:31,900
...البثّ

118
00:12:43,350 --> 00:12:45,230
،لا يهمّ كم ستقاتل

119
00:12:45,600 --> 00:12:48,750
!سنحتفظ باليد العليا أيّها اللّحية البيضاء

120
00:12:51,220 --> 00:12:55,580
،عندما سيتمّ قطع البثّ بالكامل
.فعّلوا الأسوار المطوّقة

121
00:12:56,380 --> 00:13:02,060
.وعندئذ، سنعدم إيس وسنحاصر كلّ أعدائنا

122
00:13:02,800 --> 00:13:03,680
!عُلم

123
00:13:09,750 --> 00:13:10,810
!ابتعدوا عن طريقي

124
00:13:19,200 --> 00:13:21,530
!إيس في خطر! عليّ الإسراع

125
00:13:25,280 --> 00:13:27,870
!عد إلى البداية

126
00:13:29,310 --> 00:13:30,530
!لوفي-كُن

127
00:13:40,200 --> 00:13:41,480
!جينبي

128
00:13:46,710 --> 00:13:48,470
!اعترضني الأميرال

129
00:13:49,200 --> 00:13:50,020
!سُحقًا

130
00:13:51,360 --> 00:13:53,190
!علينا الإسراع رغم صعوبة الأمر

131
00:13:53,850 --> 00:14:00,530
أتينا إلى هنا ونحن نعلم أنّ أعداءً
!أقوياء سيقفون في طريقنا

132
00:14:03,880 --> 00:14:06,470
!مت يا ابن دراغون

133
00:14:14,110 --> 00:14:17,600
يا أخا إيس الصّغير، هل تعبت بهذه السّرعة؟

134
00:14:23,090 --> 00:14:25,050
!القادة هنا

135
00:14:25,050 --> 00:14:27,870
!يا لها من مساعدة مذهلة

136
00:14:28,180 --> 00:14:30,440
!لا تدع رجلاً واحدًا يوقفك عند حدّك

137
00:14:30,440 --> 00:14:31,380
!تعال معنا

138
00:14:31,900 --> 00:14:33,850
!حسنًا! ذلك الوغد

139
00:14:34,550 --> 00:14:37,180
!تتراجع البحريّة حاليًّا وهذه فرصتنا

140
00:14:37,180 --> 00:14:39,380
!لنخترقهم دفعة واحدة

141
00:14:41,470 --> 00:14:44,290
!هذا صعب نوعًا ما

142
00:15:09,790 --> 00:15:13,190
!قائد الوحدة العاشرة كورييل

143
00:15:13,550 --> 00:15:18,150
!إن كنت ستسعى خلفي، فسأطيح بك بسهولة

144
00:15:19,390 --> 00:15:23,020
!أنت هالك إن بقيتَ داخل الخليج

145
00:15:23,240 --> 00:15:28,030
!سيموت إيس وستُحاصرون جميعًا ويُقضى عليكم

146
00:15:28,310 --> 00:15:31,790
،لا أهتمّ بتاتًا من الّذي سيفوز

147
00:15:31,790 --> 00:15:36,110
!لكن سيكون من الممتع رؤية اللّحية البيضاء يموت

148
00:15:36,400 --> 00:15:39,450
!لن أسمح بموت والدي أو إيس

149
00:15:48,630 --> 00:15:51,720
هلاّ أجّلنا هذا القتال يا فيستا؟

150
00:15:53,050 --> 00:15:56,260
.يبدو أنّ ذلك سيكون لصالح كلينا

151
00:16:03,180 --> 00:16:06,020
!وصلتنا أوامر بالتّراجع يا سموكر-سان

152
00:16:06,450 --> 00:16:07,830
!علينا الذّهاب

153
00:16:10,120 --> 00:16:11,410
.حسنًا

154
00:16:12,270 --> 00:16:13,660
.أعلم

155
00:16:15,860 --> 00:16:16,950
!قبّعة القشّ

156
00:16:23,850 --> 00:16:26,950
!لوفي! أسرع وأنقذ أخاك

157
00:16:32,910 --> 00:16:35,180
هل قطعتم البثّ؟

158
00:16:35,460 --> 00:16:37,780
!لا، أمهلنا بعض الوقت

159
00:16:38,130 --> 00:16:39,720
!أجيبوا، ألم تجدوه

160
00:16:40,090 --> 00:16:43,350
!كـ-كلاّ! ما زلنا نبحث عنه

161
00:16:46,060 --> 00:16:47,160
!نحن جاهزون

162
00:16:47,160 --> 00:16:48,750
.يا تقنيّ الإضاءة، ابتعد قليلاً

163
00:16:50,130 --> 00:16:52,810
...قطعوا كلّ البثّ فيما عدى واحد

164
00:16:53,620 --> 00:16:56,080
!لماذا علينا الانتظار؟

165
00:17:06,030 --> 00:17:07,550
!تمّ اختبار الكاميرا

166
00:17:08,120 --> 00:17:10,740
!حسنًا، لنبدأ البثّ

167
00:17:10,740 --> 00:17:11,840
!بعد 5 ثوانٍ

168
00:17:11,840 --> 00:17:16,410
!أربعة، ثلاثة، اثنان، واحد، حركة

169
00:17:16,980 --> 00:17:18,490
!عاد البثّ

170
00:17:19,140 --> 00:17:20,930
...عـ... عفوًا

171
00:17:22,490 --> 00:17:25,640
.آسفون على التّأخير أيّها المشاهدون

172
00:17:25,640 --> 00:17:27,230
!هنالك من يتكلّم

173
00:17:27,510 --> 00:17:31,040
.نحن حاليًّا في مارينفورد

174
00:17:31,040 --> 00:17:34,270
.ثمّة الكثير من جثث القراصنة والبحريّة

175
00:17:34,270 --> 00:17:35,860
يقومون بالتّعليق؟

176
00:17:37,520 --> 00:17:40,580
!أنت! ما هذا؟! ما الّذي يحدث؟

177
00:17:41,060 --> 00:17:43,670
!...ماذا؟! لا بدّ أنّ ذلك الرّجل هو

178
00:17:44,290 --> 00:17:48,220
!...ماذا؟ أهو...! أيعقل أن يكون

179
00:17:48,220 --> 00:17:50,910
...كان يخفي أصله

180
00:17:50,910 --> 00:17:56,340
ولكنّه كان جزءًا من طاقم
!ملك القراصنة غولد روجر

181
00:17:57,350 --> 00:17:58,380
من هذا؟

182
00:17:58,640 --> 00:18:02,300
!القرصان العظيم، القبطان باغي المهرّج؟

183
00:18:04,750 --> 00:18:06,970
!نعم، أنا هو بشحمه ولحمه

184
00:18:11,480 --> 00:18:14,770
...هذا سرّيّ للغاية

185
00:18:14,780 --> 00:18:17,370
.ولكنّني قرصان أسطوريّ

186
00:18:17,670 --> 00:18:20,580
!مـ-مهلاً أيّها القبطان باغي

187
00:18:20,580 --> 00:18:22,180
!أنفك ينزف

188
00:18:26,810 --> 00:18:28,730
!قطع! قطع

189
00:18:28,730 --> 00:18:30,010
!امسحه

190
00:18:30,740 --> 00:18:33,090
!ما الّذي يحدث؟

191
00:18:33,460 --> 00:18:37,000
!قلت لكم أن تقطعوا هذا البثّ الغبيّ في الحال

192
00:18:37,420 --> 00:18:39,860
!لا يمكننا المواصلة هكذا

193
00:18:40,250 --> 00:18:41,960
...أ-أخشى أنّ

194
00:18:41,960 --> 00:18:44,110
أحد حلازين الاتّصال الخاصّ بالبثّ

195
00:18:44,110 --> 00:18:47,530
!قد سُرق من طرف سجناء إمبل داون

196
00:18:48,600 --> 00:18:50,400
!ماذا قلت؟

197
00:18:51,370 --> 00:18:52,370
!المكياج

198
00:18:52,650 --> 00:18:53,850
!نحن جاهزون

199
00:18:54,310 --> 00:18:56,400
!حسنًا، المحاولة الثّانية

200
00:18:56,910 --> 00:18:59,890
...ثلاثة، اثنان، واحد

201
00:19:00,420 --> 00:19:02,950
!ماذا؟! ذلك الرّجل هناك

202
00:19:03,710 --> 00:19:06,150
...إنّه واحد من أعضاء طاقم روجر الأسطوريّ

203
00:19:06,150 --> 00:19:08,740
!أخو اليونكو "أحمر الشّعر" في الكفاح

204
00:19:09,290 --> 00:19:12,650
!القرصان العظيم، القبطان باغي المهرّج؟

205
00:19:13,380 --> 00:19:15,140
!نعم، أنا هو بشحمه ولحمه

206
00:19:15,640 --> 00:19:18,310
!أوقفوهم في الحال

207
00:19:20,890 --> 00:19:22,650
!كلاّ! كان ذلك وشيكًا

208
00:19:22,650 --> 00:19:24,430
!لقد عثروا علينا! اهربوا

209
00:19:27,150 --> 00:19:30,480
،قام "عين الصّقر" ميهوك الشّهير بتقطيعك للتّوّ

210
00:19:30,480 --> 00:19:32,600
!لكن لا يبدو أنّك تأذّيت على الإطلاق

211
00:19:33,420 --> 00:19:34,610
تتحدّث إليّ؟

212
00:19:36,160 --> 00:19:37,990
!نعم، أنا باغي

213
00:19:38,920 --> 00:19:40,480
!الأسطوريّ

214
00:19:40,480 --> 00:19:43,220
!فجّروهم جميعًا

215
00:19:43,940 --> 00:19:46,100
!دعونا نرى الحرب

216
00:19:46,100 --> 00:19:48,080
!ما الّذي حدث لشاشتَيْ البثّ الأخريتين؟

217
00:19:48,080 --> 00:19:51,130
!دعونا نرى إيس الّذي يوشك أن يُعدم

218
00:19:51,130 --> 00:19:53,850
!دعونا نرى جيش بارثولوميو كوما

219
00:20:04,150 --> 00:20:06,130
!لا ينفكّون عن محاصرتنا

220
00:20:09,820 --> 00:20:11,470
!لا تستسلموا

221
00:20:11,650 --> 00:20:15,190
!لا يجب أن نُهزم حتّى ننقذ إيس

222
00:20:15,420 --> 00:20:16,610
!هيّا بنا

223
00:20:42,350 --> 00:20:43,350
.يا والدي

224
00:20:47,220 --> 00:20:48,300
!سكوارد

225
00:20:48,760 --> 00:20:50,290
!أنا سعيد لأنّك بخير

226
00:20:50,290 --> 00:20:52,190
.نعم، بالكاد

227
00:20:52,190 --> 00:20:55,500
.هكذا إذًا. كنت أناديك قبل لحظات

228
00:20:55,920 --> 00:20:58,030
كيف الوضع في الخليج الآن؟

229
00:20:58,550 --> 00:21:01,640
.عانى حلفاؤك كثيرًا

230
00:21:02,000 --> 00:21:05,700
.وصلت إلى هنا لأنّني وجدت مخرجًا بالصّدفة

231
00:21:06,110 --> 00:21:08,370
.لا يملك سنغوكو أيّ رحمة

232
00:21:08,370 --> 00:21:11,530
.إنّه يستعمل كلّ قوّاته لهزيمتنا

233
00:21:12,610 --> 00:21:16,130
يا والدي، لاحظتَ ما الّذي تسعى إليه البحريّة؟

234
00:21:17,560 --> 00:21:21,140
.أنا أعرف سنغوكو منذ مدّة

235
00:21:27,980 --> 00:21:29,060
.فهمت

236
00:21:29,570 --> 00:21:33,420
.من الجيّد لنا إن كانوا سيهاجموننا من الخلف

237
00:21:34,210 --> 00:21:38,020
!سأتقدّم للأمام أيضًا
!علينا أن نغزو بلا توقّف

238
00:21:38,580 --> 00:21:40,060
.أوافقك

239
00:21:42,440 --> 00:21:45,280
سكوارد؟ لماذا هو هناك؟

240
00:21:45,570 --> 00:21:48,670
هنالك 43 قبطانًا حليفًا لنا

241
00:21:49,070 --> 00:21:52,370
!وجميعنا ندين لك بالكثير

242
00:21:53,150 --> 00:21:56,660
!إنّنا نخاطر بأرواحنا من أجل قراصنة اللّحية البيضاء

243
00:22:03,070 --> 00:22:04,900
.شكرًا لك

244
00:22:05,480 --> 00:22:06,630
!...لكنّنا

245
00:22:06,630 --> 00:22:07,860
.أعلم

246
00:22:08,390 --> 00:22:11,220
.أنتم تقاتلون لإنقاذ فرد من عائلتكم

247
00:22:11,690 --> 00:22:15,390
.القرصان اللّحية البيضاء لن يتخلّى عن عائلته

248
00:22:16,090 --> 00:22:20,500
تبعك الجميع إلى هذه الجحيم
.لأنّ تلك هي شيمك كرجل

249
00:22:26,110 --> 00:22:28,200
...أتمنّى لو

250
00:22:30,530 --> 00:22:31,880
...أنّنا كنّا

251
00:22:33,930 --> 00:22:36,130
.جميعًا أفرادًا من عائلتك

252
00:23:25,410 --> 00:23:27,250
.كانت خيانة سكوارد غير متوقّعة

253
00:23:27,630 --> 00:23:32,630
،بينما يرونه يقترب من اللّحية البيضاء
.تزداد الشّكوك بين البحريّة أيضًا

254
00:23:33,190 --> 00:23:36,430
الرّابطة القويّة الّتي يتشاركها قراصنة
...اللّحية البيضاء قد دُمّرت

255
00:23:36,860 --> 00:23:40,300
.هذا هو الوضع الّذي وصفته البحريّة

256
00:23:40,300 --> 00:23:41,810
:في الحلقة القادمة من وان بيس

257
00:23:41,810 --> 00:23:45,070
"!مكيدة أكاينو! اللّحية البيضاء محاصر"

258
00:23:45,070 --> 00:23:47,240
!ملك القراصنة، لن يكون إلاّ أنا

259
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة