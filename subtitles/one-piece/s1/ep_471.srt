1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,750 --> 00:03:22,010
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:22,010 --> 00:03:26,570
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:27,050 --> 00:03:30,080
،يحاول لوفي وقراصنة اللّحية البيضاء الوصول للمنصّة

40
00:03:30,080 --> 00:03:33,810
.لكنّ البحريّة تقف في طريقهم
!وتصير المعركة حامية أكثر

41
00:03:34,080 --> 00:03:39,910
وفجأة، يظهر جيش أسلحة البحريّة
!البشريّة يُدعى الباسيفيستا

42
00:03:43,380 --> 00:03:45,940
!انظروا لرأس الخليج! ثمّة شيء ما

43
00:03:47,950 --> 00:03:49,960
!ما-ما هؤلاء؟

44
00:03:50,550 --> 00:03:54,930
.هذا هو سلاح الحكومة البشريّ الّذي سمعنا عنه

45
00:03:57,450 --> 00:03:58,390
كـ-كوما؟

46
00:04:02,260 --> 00:04:06,770
!بداية العمل باستراتيجيّة الإبادة"
"!قوّة جيش الباسيفيستا

47
00:04:23,540 --> 00:04:25,840
!الشّيتشيبوكاي بارثولوميو كوما

48
00:04:26,160 --> 00:04:28,550
لماذا يوجد الكثير من كوما؟

49
00:04:29,320 --> 00:04:30,820
ما الّذي يحدث هنا؟

50
00:04:40,170 --> 00:04:43,200
!إنّهم من عاثوا فسادًا في شابوندي من قبل

51
00:04:43,950 --> 00:04:46,460
!ثمّة الكثير من بارثولوميو كوما

52
00:04:47,070 --> 00:04:49,130
!لديهم الكثير منهم الآن

53
00:05:01,740 --> 00:05:03,750
!إلى المكتب الرّئيسيّ! إلى المكتب الرّئيسيّ

54
00:05:04,210 --> 00:05:05,450
!لديّ أخبار هامّة

55
00:05:06,210 --> 00:05:08,440
!مرحبًا؟ مرحبًا؟

56
00:05:21,600 --> 00:05:24,070
أهذا هو الحقيقيّ؟

57
00:05:24,560 --> 00:05:26,510
سمعتُ من وقت لآخر

58
00:05:26,940 --> 00:05:31,180
أنّ الدّكتور فيغابانك يحاول بناء سلاح بشريّ

59
00:05:31,180 --> 00:05:35,100
.وكان يرسل نماذج أوّليّة إلى أماكن مختلفة مرارًا

60
00:05:35,350 --> 00:05:38,440
إذًا فهؤلاء هم السّلاح البشريّ؟

61
00:05:38,440 --> 00:05:40,920
لماذا يبدون جميعًا مثل كوما؟

62
00:05:41,550 --> 00:05:45,500
!يا عمّي! ألم يسر كلّ شيء كما خطّطتم؟

63
00:05:46,460 --> 00:05:48,180
سمعت أنّ القراصنة

64
00:05:48,180 --> 00:05:52,220
!سيُحاصرون بكلّ سهولة داخل الخليج عند خروجنا

65
00:05:52,950 --> 00:05:55,390
!لكنّهم منتشرون في كلّ مكان

66
00:05:58,300 --> 00:06:01,400
.يصرخ صاحب الفأس الكبيرة بشيء ما

67
00:06:05,090 --> 00:06:07,700
!أرى ما كانت البحريّة تخطّط له

68
00:06:08,940 --> 00:06:13,610
في البداية، سرّبوا معلومة إعدام إيس المبكّر

69
00:06:14,180 --> 00:06:16,330
.لدفعنا للاستعجال

70
00:06:16,740 --> 00:06:19,760
ثمّ تراجعوا بشكل بطيء

71
00:06:20,260 --> 00:06:23,340
...واستدرجوا كلّ القراصنة داخل الخليج

72
00:06:23,340 --> 00:06:26,900
ثمّ سدّوا رأس الخليج بالأسلحة
.البشريّة لإغلاق فخّهم

73
00:06:26,900 --> 00:06:28,390
!وكش ملك

74
00:06:29,180 --> 00:06:34,130
لهذا السّبب قال اللّحية البيضاء أنّ علينا
.إغراق سفن البحريّة الّتي حولنا أوّلاً

75
00:06:34,760 --> 00:06:36,260
.توقّع حدوث ذلك

76
00:06:36,450 --> 00:06:38,850
.لم نُحاصر بفضله

77
00:06:39,210 --> 00:06:40,390
.نعم

78
00:06:53,050 --> 00:06:54,840
،رغم أنّنا لم نستطع محاصرتهم

79
00:06:54,840 --> 00:06:57,230
!بإمكاننا مهاجمتهم من الأمام والخلف

80
00:06:57,550 --> 00:07:00,740
.هاجموا تحالف القراصنة أوّلاً كما خطّطنا

81
00:07:01,160 --> 00:07:05,080
!تخلّصوا من الّذين يبتعدون عن التّطويق

82
00:07:08,090 --> 00:07:09,880
هل سمعت ذلك؟

83
00:07:10,160 --> 00:07:13,000
يا عمّي، ألا بأس إن أصابت هجماتنا
بعض سفن البحريّة؟

84
00:07:13,440 --> 00:07:15,720
.لتكن الخسائر قليلة

85
00:07:16,620 --> 00:07:17,680
!عُلم

86
00:07:19,940 --> 00:07:21,050
!لنبدأ

87
00:07:32,810 --> 00:07:37,160
،لا أدري ما الّذي يجري
!لكن لا يمكنكم هزيمتنا بتلك السّهولة

88
00:07:53,730 --> 00:07:55,880
!كـ... كلاّ

89
00:08:12,190 --> 00:08:14,480
!انطلقوا أيّها الباسيفيستا

90
00:08:31,170 --> 00:08:32,290
!لقد فجّرهم

91
00:08:57,270 --> 00:09:00,740
.إنّهم جاهزون للتّضحية حتّى برجالهم

92
00:09:08,740 --> 00:09:11,260
!لا تخشوا شيئًا يا رجال

93
00:09:11,650 --> 00:09:14,750
!لنندفع نحو السّاحة بلا توقّف

94
00:09:31,830 --> 00:09:34,260
.التّراجع ليس خيارًا حتّى

95
00:09:35,470 --> 00:09:38,870
!سأصل إلى إيس قبل أن ينالوا منّي

96
00:09:45,430 --> 00:09:47,810
!يا رجال، غادروا السّفينة

97
00:09:48,210 --> 00:09:50,600
!صدّوا الأسلحة البشريّة

98
00:09:58,330 --> 00:09:59,590
.هيّا

99
00:10:02,130 --> 00:10:03,710
!سأقاتلكم

100
00:10:15,620 --> 00:10:18,980
!إلى كلّ الوحدات، ابتعدوا عن الجليد في الحال

101
00:10:20,000 --> 00:10:23,490
!لا تسمحوا للقراصنة بالوصول للسّاحة

102
00:10:24,240 --> 00:10:25,750
!تراجعوا

103
00:10:27,780 --> 00:10:28,860
!بسرعة

104
00:10:42,020 --> 00:10:47,500
لم أتوقّع أنّه سيتسنّى لي قتال أعظم
.سيّافي العالم في هذه الحرب

105
00:10:49,130 --> 00:10:51,190
.يا لحظّي السّعيد

106
00:10:52,560 --> 00:10:55,680
.أنت السّيّاف الأوّل بين قراصنة اللّحية البيضاء

107
00:10:56,070 --> 00:10:59,750
."دعني أرى مهارات مسايفة "سيف الزّهور

108
00:11:00,450 --> 00:11:02,280
.لديك أفضل مقعد للمشاهدة

109
00:11:02,860 --> 00:11:04,780
!رقصة الورد الدّائريّة

110
00:11:32,460 --> 00:11:35,680
أيّ نوع من الزّهور عليّ جعلها تتفتّح تاليًا؟

111
00:11:43,610 --> 00:11:46,160
!ادفعوهم للدّاخل أيّها الباسيفيستا

112
00:11:46,230 --> 00:11:48,860
!لن أسمح لك! خذ هذه

113
00:11:52,000 --> 00:11:52,830
!تستحقّ ذلك

114
00:12:06,380 --> 00:12:08,770
!ممّاذا صُنعوا؟

115
00:12:09,260 --> 00:12:11,290
!إنّهم ليسوا بشرًا

116
00:12:11,290 --> 00:12:12,520
!هل هم منيعون؟

117
00:12:16,480 --> 00:12:17,900
...البثّ

118
00:12:29,350 --> 00:12:31,230
،لا يهمّ كم ستقاتل

119
00:12:31,600 --> 00:12:34,750
!سنحتفظ باليد العليا أيّها اللّحية البيضاء

120
00:12:37,220 --> 00:12:41,580
،عندما سيتمّ قطع البثّ بالكامل
.فعّلوا الأسوار المطوّقة

121
00:12:42,380 --> 00:12:48,060
.وعندئذ، سنعدم إيس وسنحاصر كلّ أعدائنا

122
00:12:48,800 --> 00:12:49,680
!عُلم

123
00:12:55,750 --> 00:12:56,810
!ابتعدوا عن طريقي

124
00:13:05,200 --> 00:13:07,530
!إيس في خطر! عليّ الإسراع

125
00:13:11,280 --> 00:13:13,870
!عد إلى البداية

126
00:13:15,310 --> 00:13:16,530
!لوفي-كُن

127
00:13:26,200 --> 00:13:27,480
!جينبي

128
00:13:32,710 --> 00:13:34,470
!اعترضني الأميرال

129
00:13:35,200 --> 00:13:36,020
!سُحقًا

130
00:13:37,360 --> 00:13:39,190
!علينا الإسراع رغم صعوبة الأمر

131
00:13:39,850 --> 00:13:46,530
أتينا إلى هنا ونحن نعلم أنّ أعداءً
!أقوياء سيقفون في طريقنا

132
00:13:49,880 --> 00:13:52,470
!مت يا ابن دراغون

133
00:14:00,110 --> 00:14:03,600
يا أخا إيس الصّغير، هل تعبت بهذه السّرعة؟

134
00:14:09,090 --> 00:14:11,050
!القادة هنا

135
00:14:11,050 --> 00:14:13,870
!يا لها من مساعدة مذهلة

136
00:14:14,180 --> 00:14:16,440
!لا تدع رجلاً واحدًا يوقفك عند حدّك

137
00:14:16,440 --> 00:14:17,380
!تعال معنا

138
00:14:17,900 --> 00:14:19,850
!حسنًا! ذلك الوغد

139
00:14:20,550 --> 00:14:23,180
!تتراجع البحريّة حاليًّا وهذه فرصتنا

140
00:14:23,180 --> 00:14:25,380
!لنخترقهم دفعة واحدة

141
00:14:27,470 --> 00:14:30,290
!هذا صعب نوعًا ما

142
00:14:55,790 --> 00:14:59,190
!قائد الوحدة العاشرة كورييل

143
00:14:59,550 --> 00:15:04,150
!إن كنت ستسعى خلفي، فسأطيح بك بسهولة

144
00:15:05,390 --> 00:15:09,020
!أنت هالك إن بقيتَ داخل الخليج

145
00:15:09,240 --> 00:15:14,030
!سيموت إيس وستُحاصرون جميعًا ويُقضى عليكم

146
00:15:14,310 --> 00:15:17,790
،لا أهتمّ بتاتًا من الّذي سيفوز

147
00:15:17,790 --> 00:15:22,110
!لكن سيكون من الممتع رؤية اللّحية البيضاء يموت

148
00:15:22,400 --> 00:15:25,450
!لن أسمح بموت والدي أو إيس

149
00:15:34,630 --> 00:15:37,720
هلاّ أجّلنا هذا القتال يا فيستا؟

150
00:15:39,050 --> 00:15:42,260
.يبدو أنّ ذلك سيكون لصالح كلينا

151
00:15:49,180 --> 00:15:52,020
!وصلتنا أوامر بالتّراجع يا سموكر-سان

152
00:15:52,450 --> 00:15:53,830
!علينا الذّهاب

153
00:15:56,120 --> 00:15:57,410
.حسنًا

154
00:15:58,270 --> 00:15:59,660
.أعلم

155
00:16:01,860 --> 00:16:02,950
!قبّعة القشّ

156
00:16:09,850 --> 00:16:12,950
!لوفي! أسرع وأنقذ أخاك

157
00:16:18,910 --> 00:16:21,180
هل قطعتم البثّ؟

158
00:16:21,460 --> 00:16:23,780
!لا، أمهلنا بعض الوقت

159
00:16:24,130 --> 00:16:25,720
!أجيبوا، ألم تجدوه

160
00:16:26,090 --> 00:16:29,350
!كـ-كلاّ! ما زلنا نبحث عنه

161
00:16:32,060 --> 00:16:33,160
!نحن جاهزون

162
00:16:33,160 --> 00:16:34,750
.يا تقنيّ الإضاءة، ابتعد قليلاً

163
00:16:36,130 --> 00:16:38,810
...قطعوا كلّ البثّ فيما عدى واحد

164
00:16:39,620 --> 00:16:42,080
!لماذا علينا الانتظار؟

165
00:16:52,030 --> 00:16:53,550
!تمّ اختبار الكاميرا

166
00:16:54,120 --> 00:16:56,740
!حسنًا، لنبدأ البثّ

167
00:16:56,740 --> 00:16:57,840
!بعد 5 ثوانٍ

168
00:16:57,840 --> 00:17:02,410
!أربعة، ثلاثة، اثنان، واحد، حركة

169
00:17:02,980 --> 00:17:04,490
!عاد البثّ

170
00:17:05,140 --> 00:17:06,930
...عـ... عفوًا

171
00:17:08,490 --> 00:17:11,640
.آسفون على التّأخير أيّها المشاهدون

172
00:17:11,640 --> 00:17:13,230
!هنالك من يتكلّم

173
00:17:13,510 --> 00:17:17,040
.نحن حاليًّا في مارينفورد

174
00:17:17,040 --> 00:17:20,270
.ثمّة الكثير من جثث القراصنة والبحريّة

175
00:17:20,270 --> 00:17:21,860
يقومون بالتّعليق؟

176
00:17:23,520 --> 00:17:26,580
!أنت! ما هذا؟! ما الّذي يحدث؟

177
00:17:27,060 --> 00:17:29,670
!...ماذا؟! لا بدّ أنّ ذلك الرّجل هو

178
00:17:30,290 --> 00:17:34,220
!...ماذا؟ أهو...! أيعقل أن يكون

179
00:17:34,220 --> 00:17:36,910
...كان يخفي أصله

180
00:17:36,910 --> 00:17:42,340
ولكنّه كان جزءًا من طاقم
!ملك القراصنة غولد روجر

181
00:17:43,350 --> 00:17:44,380
من هذا؟

182
00:17:44,640 --> 00:17:48,300
!القرصان العظيم، القبطان باغي المهرّج؟

183
00:17:50,750 --> 00:17:52,970
!نعم، أنا هو بشحمه ولحمه

184
00:17:57,480 --> 00:18:00,770
...هذا سرّيّ للغاية

185
00:18:00,780 --> 00:18:03,370
.ولكنّني قرصان أسطوريّ

186
00:18:03,670 --> 00:18:06,580
!مـ-مهلاً أيّها القبطان باغي

187
00:18:06,580 --> 00:18:08,180
!أنفك ينزف

188
00:18:12,810 --> 00:18:14,730
!قطع! قطع

189
00:18:14,730 --> 00:18:16,010
!امسحه

190
00:18:16,740 --> 00:18:19,090
!ما الّذي يحدث؟

191
00:18:19,460 --> 00:18:23,000
!قلت لكم أن تقطعوا هذا البثّ الغبيّ في الحال

192
00:18:23,420 --> 00:18:25,860
!لا يمكننا المواصلة هكذا

193
00:18:26,250 --> 00:18:27,960
...أ-أخشى أنّ

194
00:18:27,960 --> 00:18:30,110
أحد حلازين الاتّصال الخاصّ بالبثّ

195
00:18:30,110 --> 00:18:33,530
!قد سُرق من طرف سجناء إمبل داون

196
00:18:34,600 --> 00:18:36,400
!ماذا قلت؟

197
00:18:37,370 --> 00:18:38,370
!المكياج

198
00:18:38,650 --> 00:18:39,850
!نحن جاهزون

199
00:18:40,310 --> 00:18:42,400
!حسنًا، المحاولة الثّانية

200
00:18:42,910 --> 00:18:45,890
...ثلاثة، اثنان، واحد

201
00:18:46,420 --> 00:18:48,950
!ماذا؟! ذلك الرّجل هناك

202
00:18:49,710 --> 00:18:52,150
...إنّه واحد من أعضاء طاقم روجر الأسطوريّ

203
00:18:52,150 --> 00:18:54,740
!أخو اليونكو "أحمر الشّعر" في الكفاح

204
00:18:55,290 --> 00:18:58,650
!القرصان العظيم، القبطان باغي المهرّج؟

205
00:18:59,380 --> 00:19:01,140
!نعم، أنا هو بشحمه ولحمه

206
00:19:01,640 --> 00:19:04,310
!أوقفوهم في الحال

207
00:19:06,890 --> 00:19:08,650
!كلاّ! كان ذلك وشيكًا

208
00:19:08,650 --> 00:19:10,430
!لقد عثروا علينا! اهربوا

209
00:19:13,150 --> 00:19:16,480
،قام "عين الصّقر" ميهوك الشّهير بتقطيعك للتّوّ

210
00:19:16,480 --> 00:19:18,600
!لكن لا يبدو أنّك تأذّيت على الإطلاق

211
00:19:19,420 --> 00:19:20,610
تتحدّث إليّ؟

212
00:19:22,160 --> 00:19:23,990
!نعم، أنا باغي

213
00:19:24,920 --> 00:19:26,480
!الأسطوريّ

214
00:19:26,480 --> 00:19:29,220
!فجّروهم جميعًا

215
00:19:29,940 --> 00:19:32,100
!دعونا نرى الحرب

216
00:19:32,100 --> 00:19:34,080
!ما الّذي حدث لشاشتَيْ البثّ الأخريتين؟

217
00:19:34,080 --> 00:19:37,130
!دعونا نرى إيس الّذي يوشك أن يُعدم

218
00:19:37,130 --> 00:19:39,850
!دعونا نرى جيش بارثولوميو كوما

219
00:19:50,150 --> 00:19:52,130
!لا ينفكّون عن محاصرتنا

220
00:19:55,820 --> 00:19:57,470
!لا تستسلموا

221
00:19:57,650 --> 00:20:01,190
!لا يجب أن نُهزم حتّى ننقذ إيس

222
00:20:01,420 --> 00:20:02,610
!هيّا بنا

223
00:20:28,350 --> 00:20:29,350
.يا والدي

224
00:20:33,220 --> 00:20:34,300
!سكوارد

225
00:20:34,760 --> 00:20:36,290
!أنا سعيد لأنّك بخير

226
00:20:36,290 --> 00:20:38,190
.نعم، بالكاد

227
00:20:38,190 --> 00:20:41,500
.هكذا إذًا. كنت أناديك قبل لحظات

228
00:20:41,920 --> 00:20:44,030
كيف الوضع في الخليج الآن؟

229
00:20:44,550 --> 00:20:47,640
.عانى حلفاؤك كثيرًا

230
00:20:48,000 --> 00:20:51,700
.وصلت إلى هنا لأنّني وجدت مخرجًا بالصّدفة

231
00:20:52,110 --> 00:20:54,370
.لا يملك سنغوكو أيّ رحمة

232
00:20:54,370 --> 00:20:57,530
.إنّه يستعمل كلّ قوّاته لهزيمتنا

233
00:20:58,610 --> 00:21:02,130
يا والدي، لاحظتَ ما الّذي تسعى إليه البحريّة؟

234
00:21:03,560 --> 00:21:07,140
.أنا أعرف سنغوكو منذ مدّة

235
00:21:13,980 --> 00:21:15,060
.فهمت

236
00:21:15,570 --> 00:21:19,420
.من الجيّد لنا إن كانوا سيهاجموننا من الخلف

237
00:21:20,210 --> 00:21:24,020
!سأتقدّم للأمام أيضًا
!علينا أن نغزو بلا توقّف

238
00:21:24,580 --> 00:21:26,060
.أوافقك

239
00:21:28,440 --> 00:21:31,280
سكوارد؟ لماذا هو هناك؟

240
00:21:31,570 --> 00:21:34,670
هنالك 43 قبطانًا حليفًا لنا

241
00:21:35,070 --> 00:21:38,370
!وجميعنا ندين لك بالكثير

242
00:21:39,150 --> 00:21:42,660
!إنّنا نخاطر بأرواحنا من أجل قراصنة اللّحية البيضاء

243
00:21:49,070 --> 00:21:50,900
.شكرًا لك

244
00:21:51,480 --> 00:21:52,630
!...لكنّنا

245
00:21:52,630 --> 00:21:53,860
.أعلم

246
00:21:54,390 --> 00:21:57,220
.أنتم تقاتلون لإنقاذ فرد من عائلتكم

247
00:21:57,690 --> 00:22:01,390
.القرصان اللّحية البيضاء لن يتخلّى عن عائلته

248
00:22:02,090 --> 00:22:06,500
تبعك الجميع إلى هذه الجحيم
.لأنّ تلك هي شيمك كرجل

249
00:22:12,110 --> 00:22:14,200
...أتمنّى لو

250
00:22:16,530 --> 00:22:17,880
...أنّنا كنّا

251
00:22:19,930 --> 00:22:22,130
.جميعًا أفرادًا من عائلتك

252
00:23:11,410 --> 00:23:13,250
.كانت خيانة سكوارد غير متوقّعة

253
00:23:13,630 --> 00:23:18,630
،بينما يرونه يقترب من اللّحية البيضاء
.تزداد الشّكوك بين البحريّة أيضًا

254
00:23:19,190 --> 00:23:22,430
الرّابطة القويّة الّتي يتشاركها قراصنة
...اللّحية البيضاء قد دُمّرت

255
00:23:22,860 --> 00:23:26,300
.هذا هو الوضع الّذي وصفته البحريّة

256
00:23:26,300 --> 00:23:27,810
:في الحلقة القادمة من وان بيس

257
00:23:27,810 --> 00:23:31,070
"!مكيدة أكاينو! اللّحية البيضاء محاصر"

258
00:23:31,070 --> 00:23:33,240
!ملك القراصنة، لن يكون إلاّ أنا

259
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة