1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,790
"وأقول "أريد أن أصير أقوى

5
00:00:47,950 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,370 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,590 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,470 --> 00:03:23,100
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:23,100 --> 00:03:28,460
اندفع نحو مقرّ البحريّة لإنقاذ أخيه
.إيس الّذي أوشك موعد إعدامه

39
00:03:34,970 --> 00:03:36,090
!مستحيل

40
00:03:39,330 --> 00:03:43,250
.أظنّه سيظهر من آخر مكان نتوقّعه

41
00:03:43,250 --> 00:03:45,040
.ربّما جهّزنا التّشكيلة الخطأ

42
00:03:48,070 --> 00:03:50,050
!أرى ظلاًّ في الخليج

43
00:03:50,480 --> 00:03:53,820
...فهمت الآن! إنّ جميع سفنهم

44
00:03:54,490 --> 00:03:57,520
!مغلّفة واقتربت منّا من تحت البحر

45
00:04:09,250 --> 00:04:11,830
!ها هي السّفينة موبي ديك

46
00:04:25,240 --> 00:04:29,540
"!بداية الحرب! ماضي إيس واللّحية البيضاء"

47
00:04:41,490 --> 00:04:42,580
!مستحيل

48
00:04:42,580 --> 00:04:44,010
ثمّة المزيد؟

49
00:04:49,200 --> 00:04:52,730
!هـ-هنالك ثلاثة سفن أخرى لقراصنة اللّحية البيضاء

50
00:04:57,820 --> 00:04:59,830
!لقد تسلّلوا للخليج

51
00:05:02,600 --> 00:05:04,080
...ذ-ذاك هو

52
00:05:04,600 --> 00:05:06,610
!قائد الوحدة الأولى ماركو

53
00:05:08,390 --> 00:05:10,470
...ثمّة 14 قائدًا

54
00:05:11,170 --> 00:05:12,600
!لقد حضروا جميعًا

55
00:05:54,740 --> 00:05:57,440
.لم أرك منذ مدّة يا سنغوكو

56
00:05:57,990 --> 00:05:59,440
.اللّحية البيضاء

57
00:06:00,020 --> 00:06:02,350
...من الأفضل أن يكون ابني العزيز

58
00:06:03,340 --> 00:06:05,230
.على خير ما يرام

59
00:06:17,360 --> 00:06:19,880
!لا أصدّق أنّنا سمحنا لهم بالاقتراب لهذا الحدّ

60
00:06:26,710 --> 00:06:28,930
...لقد عبرنا البوّابة، ولكن

61
00:06:28,930 --> 00:06:34,490
.ما أنا قلق بشأنه هو هل سيكون أبوكما هنا أم لا

62
00:06:34,570 --> 00:06:35,300
أبونا"؟"

63
00:06:35,690 --> 00:06:40,480
...لا أعتقد أنّ دراغون سيسمح لهم بقتل ابنه

64
00:06:40,720 --> 00:06:43,470
.صحيح، أبي وأبو إيس ليسا نفس الشّخص

65
00:06:45,240 --> 00:06:47,680
،أبي هو دراغون

66
00:06:47,680 --> 00:06:50,700
.بينما أبو إيس هو غولد روجر

67
00:06:52,690 --> 00:06:55,540
.كان أبوه عظيمًا، لكنّه لم يقابله أبدًا

68
00:06:56,130 --> 00:06:58,330
.كان يغضب في كلّ مرّة أذكر ذلك

69
00:06:59,680 --> 00:07:01,590
.ربّما ما كان عليّ قول هذا

70
00:07:16,460 --> 00:07:19,310
.أمهلني لحظة يا إيس

71
00:07:25,680 --> 00:07:27,620
!يا والدي

72
00:07:47,100 --> 00:07:48,400
!ما-ما هذا؟

73
00:07:48,400 --> 00:07:49,880
أحدث صدوعًا في الهواء؟

74
00:08:01,050 --> 00:08:03,280
!ما مصدر ذلك الانفجار؟

75
00:08:03,280 --> 00:08:05,850
!هذا سيّئ! سطح الماء مرتفع جدًّا

76
00:08:06,020 --> 00:08:09,390
!زلزال بحريّ! إنّه يشوّه البحر

77
00:08:10,070 --> 00:08:11,650
!في الجانب الآخر أيضًا

78
00:08:11,940 --> 00:08:13,990
!هذه هي قوّة اللّحية البيضاء

79
00:08:30,660 --> 00:08:32,360
!سأغادر أوّلاً

80
00:08:37,950 --> 00:08:39,720
!اعتنِ بنفسك يا إيس

81
00:08:39,880 --> 00:08:42,420
!أكيد. إلى اللّقاء يا لوفي

82
00:08:42,580 --> 00:08:43,320
!نعم

83
00:08:43,320 --> 00:08:48,140
سأكون أقوى بكثير عندما سأغادر
!بعد ثلاث سنوات

84
00:08:48,280 --> 00:08:49,350
!أكيد

85
00:08:50,990 --> 00:08:53,090
!إيس

86
00:09:02,490 --> 00:09:04,430
!سأريهم كيف تسير الأمور

87
00:09:06,350 --> 00:09:09,340
!ذلك الوغد! صار قرصانًا

88
00:09:09,530 --> 00:09:12,420
!إنّهم قراصنة! لم أر علمهم من قبل

89
00:09:19,460 --> 00:09:23,050
.إنّه قرصان أصبح قويًّا جدًّا بسرعة مؤخّرًا

90
00:09:23,280 --> 00:09:25,530
د"؟ من أين هو؟"

91
00:09:25,530 --> 00:09:28,180
لا يمكننا معرفة ذلك بالتّحديد

92
00:09:28,180 --> 00:09:30,360
.لكنّه يملك قوّة لوغيا مع أنّه ناشئ

93
00:09:33,030 --> 00:09:37,060
.يا له من شابّ مندفع في الغراند لاين

94
00:09:37,060 --> 00:09:39,730
.لقد رفض عرض الانضمام للشّيتشيبوكاي

95
00:09:40,130 --> 00:09:42,920
منذ متى وهو على هذا الحال؟

96
00:09:42,920 --> 00:09:44,210
.ما زالوا يافعين

97
00:09:44,900 --> 00:09:47,460
.ليس عليهم الاستعجال

98
00:09:48,360 --> 00:09:50,790
أأنت واثق يا قبطان؟

99
00:09:51,080 --> 00:09:52,420
...عليّ أن أقابله

100
00:09:52,910 --> 00:09:54,510
.شانكس أحمر الشّعر

101
00:09:56,220 --> 00:09:58,050
قراصنة سبِيْد؟

102
00:09:58,870 --> 00:10:02,930
أتى النّاشئ الخارق ذائع الصّيت
ليلقي التّحيّة عليّ؟

103
00:10:03,830 --> 00:10:05,640
.ليس الأمر كما تظنّ

104
00:10:06,430 --> 00:10:10,340
إنّ أخي لا يكفّ عن الحديث عن إنقاذك لحياته

105
00:10:10,340 --> 00:10:12,600
.لذلك أردت المجيء لشكرك

106
00:10:12,600 --> 00:10:13,770
أنت أخو لوفي؟

107
00:10:13,920 --> 00:10:16,520
.ماذا؟ لم أكن أعرف أنّ له أخًا

108
00:10:17,010 --> 00:10:19,540
!هكذا إذًا، سررت بلقائك

109
00:10:19,700 --> 00:10:21,470
!أخبرني كلّ شيء عنك

110
00:10:22,220 --> 00:10:23,630
!لنقم وليمة

111
00:10:28,370 --> 00:10:32,550
إذًا فما زال يتحدّث عن حلمه
بأن يصير ملك القراصنة؟

112
00:10:32,760 --> 00:10:34,580
.أظنّها جملته المفضّلة

113
00:10:37,720 --> 00:10:39,220
...لكنّي أشعر بالسّوء حياله

114
00:10:40,150 --> 00:10:42,210
.فأنا من سيصير ملك القراصنة التّالي

115
00:10:42,210 --> 00:10:44,710
فعلاً؟ أتظنّ ذلك؟

116
00:10:45,070 --> 00:10:48,640
.أوّلاً، سأدع العالم بأسره يعرف ما مدى قوّتي

117
00:10:48,820 --> 00:10:51,310
فعلاً؟ كيف ستفعل ذلك؟

118
00:10:51,770 --> 00:10:55,230
!عن طريق هزيمة أقوى رجل في العالم

119
00:10:55,430 --> 00:10:57,130
تقصد اللّحية البيضاء؟

120
00:11:00,120 --> 00:11:03,360
أيّها الضّخم، أريد رؤية الرّجل
.المدعوّ اللّحية البيضاء

121
00:11:03,530 --> 00:11:08,500
!لا يمكنني تقديم شابّ يافع ماكر مثلك للوالد

122
00:11:08,630 --> 00:11:10,640
!أيّها القبطان، إنّه جينبي

123
00:11:10,640 --> 00:11:12,830
ماذا؟ أنت شيتشيبوكاي؟

124
00:11:13,820 --> 00:11:15,930
.سأحصل على بعض الهيبة بهزيمته

125
00:11:16,480 --> 00:11:19,700
أنا لستُ جزءًا من قراصنة اللّحية البيضاء

126
00:11:20,120 --> 00:11:22,290
!لكنّني مدين له، لذلك سأقاتلك

127
00:11:33,120 --> 00:11:37,060
.مرّت خمسة أيّام مذ بدؤوا القتال

128
00:11:37,060 --> 00:11:39,020
!سيموت كلاهما

129
00:11:51,540 --> 00:11:53,720
!إيس

130
00:12:01,940 --> 00:12:03,510
!ما هذا؟

131
00:12:04,210 --> 00:12:08,090
من منكم يودّ قتلي؟

132
00:12:10,980 --> 00:12:15,150
.سأقاتلهم كما يحبّون

133
00:12:16,700 --> 00:12:18,690
!قراصنة اللّحية البيضاء

134
00:12:19,690 --> 00:12:22,380
.سأقاتلكم بمفردي

135
00:12:31,420 --> 00:12:33,120
!يا رفاق

136
00:12:33,880 --> 00:12:35,780
!سياج اللّهب

137
00:12:37,610 --> 00:12:38,480
!أيّها القبطان

138
00:12:38,480 --> 00:12:40,490
!ماذا تفعل أيّها القبطان إيس؟

139
00:12:40,670 --> 00:12:42,100
!اهربوا أنتم

140
00:12:42,310 --> 00:12:43,910
!أيّها القبطان

141
00:12:45,920 --> 00:12:49,380
ما الأمر؟ هل تتراجع أخيرًا؟

142
00:12:49,750 --> 00:12:53,270
...دع طاقمي يذهب. وفي المقابل

143
00:12:53,270 --> 00:12:54,440
!سأظلّ أنا

144
00:12:55,460 --> 00:12:56,850
!أيّها الغرّ

145
00:12:57,000 --> 00:12:58,810
!يا لصفاقتك

146
00:13:24,280 --> 00:13:28,070
.إذًا فهذا هو الرّجل الّذي صارعه على السّيادة

147
00:13:33,120 --> 00:13:34,260
...لن

148
00:13:37,000 --> 00:13:38,600
ما زالت تودّ القتال؟

149
00:13:41,380 --> 00:13:44,110
.إنّك أكثر قيمة من أن تكون الآن يا فتى

150
00:13:45,190 --> 00:13:47,160
،إن كنت ما زلت تريد إطلاق عنانك

151
00:13:47,160 --> 00:13:51,580
.فافعل ذلك بقدر ما يحلو لك تحت رايتي

152
00:13:56,680 --> 00:13:58,380
!اغدُ ابني

153
00:13:59,240 --> 00:14:01,360
!سُحقًا لك

154
00:14:50,330 --> 00:14:51,330
!أنت

155
00:14:52,200 --> 00:14:54,260
.أنا قائد الوحدة الرّابعة

156
00:14:56,160 --> 00:14:57,210
.اسمي ثاتش

157
00:14:58,720 --> 00:14:59,980
،إن كنت ستنضمّ لنا

158
00:15:02,060 --> 00:15:03,430
!فعلينا أن نصير صديقين

159
00:15:03,680 --> 00:15:04,800
!اخرس

160
00:15:07,100 --> 00:15:09,230
إذًا يكون مزاجك سيّئًا عندما تستيقظ؟

161
00:15:09,480 --> 00:15:13,190
صحيح، تريد معرفة ما حدث بعد فقدانك للوعي؟

162
00:15:14,060 --> 00:15:17,230
عاد طاقمك لأخذك

163
00:15:17,550 --> 00:15:19,760
.لذلك هزمناهم شرّ هزيمة

164
00:15:20,250 --> 00:15:23,760
.لكنّهم ليسوا أمواتًا. إنّهم على السّفينة أيضًا

165
00:15:25,410 --> 00:15:28,790
ألا يجدر بكم تقييدي بالسّلاسل أو الأصفاد؟

166
00:15:28,790 --> 00:15:31,970
!أصفاد؟ لسنا بحاجتها

167
00:15:54,050 --> 00:15:56,720
!على مهلك! ما الّذي تفعله؟

168
00:15:56,720 --> 00:15:58,780
أتعرف كم السّاعة الآن؟

169
00:16:13,700 --> 00:16:15,490
!لقد سقط عن السّفينة

170
00:16:15,490 --> 00:16:16,810
.لا يمكنه السّباحة

171
00:16:16,810 --> 00:16:18,550
.ليساعده أحد ما

172
00:16:21,120 --> 00:16:22,860
.يومًا تلو يوم

173
00:16:23,120 --> 00:16:25,480
.أعترف بشجاعته

174
00:16:27,100 --> 00:16:28,510
لا بدّ أنّها محاولته المائة الآن؟

175
00:16:28,510 --> 00:16:29,820
.أظنّ ذلك

176
00:16:46,620 --> 00:16:47,700
...لماذا

177
00:16:48,980 --> 00:16:51,530
تنادونه "والدي" جميعكم؟

178
00:16:54,610 --> 00:16:58,610
."لأنّه ينادينا "أبنائي

179
00:17:00,100 --> 00:17:03,260
.يكرهنا العالم جميعنا

180
00:17:04,120 --> 00:17:05,560
.لذا فذلك يسعدنا

181
00:17:05,930 --> 00:17:07,330
.أعلم أنّها مجرّد كلمة

182
00:17:08,570 --> 00:17:09,870
.لكنّها تسعدنا رغم ذلك

183
00:17:18,570 --> 00:17:23,000
أستواصل القيام بهذا بعد أن نجوت بحياتك؟

184
00:17:23,940 --> 00:17:25,750
.عليك اتّخاذ قرارك

185
00:17:26,630 --> 00:17:29,710
.لستَ قادرًا على قتله

186
00:17:30,930 --> 00:17:33,520
...فإمّا أن نغادر هذه السّفينة وتبدأ من جديد

187
00:17:35,280 --> 00:17:36,700
...أو تظلّ هنا

188
00:17:39,050 --> 00:17:41,640
!وتحمل رمز اللّحية البيضاء على ظهرك

189
00:17:49,260 --> 00:17:50,850
هل أنت دوما؟

190
00:17:56,310 --> 00:17:58,470
!فعلها إيس ثانية

191
00:17:58,470 --> 00:18:01,490
!جعل دوما وطاقمه يستسلمون وحده

192
00:18:01,960 --> 00:18:03,980
تريدون منّي قيادة الوحدة الثّانية؟

193
00:18:04,300 --> 00:18:07,050
.كان منصب القائد شاغرًا لمدّة
...إن شغلته أنت

194
00:18:07,050 --> 00:18:08,320
.فلن يعترض أحد على ذلك

195
00:18:11,460 --> 00:18:15,210
أنت أحد الأعضاء الأصليّين، صحيح؟
ألا تمانع هذا على الإطلاق؟

196
00:18:17,000 --> 00:18:19,090
.لا بأس، لا داعي للقلق

197
00:18:19,370 --> 00:18:22,130
.ليس لي طموح كهذا

198
00:18:23,550 --> 00:18:26,470
!قم بذلك من أجلنا أيّها القائد إيس

199
00:18:50,840 --> 00:18:53,080
يا والدي، ألديك بعض الوقت؟

200
00:18:58,150 --> 00:19:00,500
.حسنًا، كان ذلك مفاجئًا

201
00:19:00,500 --> 00:19:02,220
.لم أعلم ذلك

202
00:19:04,800 --> 00:19:07,390
.لا تشبه شخصيّتك روجر على الإطلاق

203
00:19:08,970 --> 00:19:12,390
كان عدوّك، صحيح؟ ألا تريد طردي؟

204
00:19:12,670 --> 00:19:17,820
.قلتَ أنّ الأمر مهمّ لكن اتّضح العكس

205
00:19:19,130 --> 00:19:23,150
.لا يهمّ من يكون أبوك، فجميعنا أبناء البحر

206
00:19:32,470 --> 00:19:35,740
!سيصير إيس قائدًا لوحدتنا الثّانية

207
00:19:41,240 --> 00:19:44,590
!أنت نجم الآن، فلا تنبهر. خذ

208
00:19:58,770 --> 00:19:59,700
!خذ

209
00:20:07,750 --> 00:20:11,580
،على مهلك، لا داعي للعجلة
.ثمّة ما يكفي من الطّعام

210
00:20:11,580 --> 00:20:13,880
...وأنت نجم هذه الوليمة

211
00:20:18,280 --> 00:20:19,620
!غطّ في النّوم

212
00:20:22,960 --> 00:20:26,260
.ضمّ اللّحية البيضاء ناشئًا قويًّا آخر

213
00:20:26,620 --> 00:20:28,640
!سمعتُ أنّه قويّ للغاية

214
00:20:36,870 --> 00:20:38,750
!أتت الوحدة الثّانية لمساعدتنا

215
00:20:42,130 --> 00:20:42,920
!إيس

216
00:20:42,920 --> 00:20:44,100
ثاتش، أأنت بخير؟

217
00:20:44,100 --> 00:20:46,110
!نعم. شكرًا لك

218
00:20:51,360 --> 00:20:53,440
!سترتفع مكافأتك ثانية

219
00:20:53,440 --> 00:20:54,500
.على الأرجح

220
00:20:54,500 --> 00:20:56,920
.إيس، عثرت على شيء مثير للاهتمام

221
00:20:57,260 --> 00:20:59,660
ماذا؟ أتلك فاكهة شيطان؟

222
00:20:59,660 --> 00:21:02,300
.لا أعرف أيّ نوع من الفاكهة بعد

223
00:21:19,930 --> 00:21:22,810
!توقّف يا إيس، هدّئ من روعك

224
00:21:23,160 --> 00:21:25,920
.قال والدي أنّ هذا استثناء

225
00:21:25,920 --> 00:21:27,520
!ليس عليك السّعي خلف تيتش

226
00:21:27,520 --> 00:21:30,610
!دعني! ما زلتُ قائده

227
00:21:31,110 --> 00:21:35,040
!إن لم أفعل أيّ شيء، فلن ترتاح روح ثاتش

228
00:21:35,720 --> 00:21:36,820
.إيس

229
00:21:38,880 --> 00:21:42,200
.لا بأس. هذا استثناء

230
00:21:42,910 --> 00:21:45,460
.يراودني شعور سيّئ حيال هذا

231
00:21:46,250 --> 00:21:49,010
!قتل زميله في الطّاقم وهرب

232
00:21:49,370 --> 00:21:51,800
إنّه يدين لك بالكثير لعقود من الزّمن

233
00:21:51,800 --> 00:21:54,180
!ولكنّه ردّ على النّعمة بالإهانة

234
00:21:56,130 --> 00:21:58,620
وفوق كلّ ذلك، ألحق العار باسم والدي

235
00:21:59,370 --> 00:22:01,030
.وهذا ما لن أسمح به

236
00:22:01,770 --> 00:22:03,780
!سأهتمّ بهذا الأمر

237
00:22:09,690 --> 00:22:11,870
!مهلاً! انتظر! عد يا إيس

238
00:22:28,060 --> 00:22:29,460
هل انتهى الأمر؟

239
00:22:29,770 --> 00:22:32,050
ما سبب ذلك الزّلزال؟

240
00:22:34,860 --> 00:22:35,990
.يا والدي

241
00:22:38,090 --> 00:22:39,170
.يا رفاق

242
00:22:42,540 --> 00:22:45,260
!تجاهلت نصيحتكم ورحلت

243
00:22:45,260 --> 00:22:47,730
!لماذا لم تتخلّوا عنّي فحسب؟

244
00:22:47,880 --> 00:22:49,950
!أنا من تسبّب بكلّ هذا

245
00:22:52,550 --> 00:22:53,700
.كلاّ

246
00:22:57,110 --> 00:23:00,110
.أنا من أخبرك أن تذهب

247
00:23:01,850 --> 00:23:03,040
.يا بنيّ

248
00:23:11,490 --> 00:23:13,160
.حضر الجميع

249
00:23:13,440 --> 00:23:18,390
أحدثت قوّة اللّحية البيضاء الهائلة
أمواجًا عاتية هدّدت بابتلاع

250
00:23:18,390 --> 00:23:21,400
،كلّ الرّجال الشّجعان في مارينفورد
.إضافة إلى السّلام والعدالة هناك

251
00:23:22,220 --> 00:23:25,650
!تبدأ معركة تعبر الأجيال أخيرًا

252
00:23:25,890 --> 00:23:27,400
:في الحلقة القادمة من وان بيس

253
00:23:27,400 --> 00:23:30,890
!القّوة الّتي يمكنها تدمير العالم"
"!قوّة فاكهة الاهتزاز

254
00:23:30,890 --> 00:23:33,190
!ملك القراصنة، لن يكون إلاّ أنا

255
00:23:36,070 --> 00:23:41,080
!!نلقاكم في الحلقة القادمة