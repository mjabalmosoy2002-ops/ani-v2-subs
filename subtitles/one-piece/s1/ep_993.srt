1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,570 --> 00:02:03,610
تسلّل لوفي والبقيّة إلى أونيغاشيما واحدًا
.تلو الآخر وهم يتقدّمون في غارتهم

29
00:02:03,610 --> 00:02:08,200
!إنّه مشروع أونيغاشيما الجديدة

30
00:02:10,160 --> 00:02:14,210
...قبل 20 سنة، شهدت على إعدام أودن

31
00:02:14,790 --> 00:02:17,790
.السّاعة الأسطوريّة

32
00:02:18,130 --> 00:02:21,050
.لم يوجد أيّ ساموراي بنفس عظمته قطّ

33
00:02:21,680 --> 00:02:23,380
...وإنّ من قتلاه

34
00:02:23,740 --> 00:02:25,930
...هما أوروتشي ووالدي

35
00:02:26,720 --> 00:02:28,340
!كايدو

36
00:02:28,340 --> 00:02:31,370
،بما أنّ ساموراي الأكازايا أموات الآن

37
00:02:31,370 --> 00:02:34,180
!على أحد ما أن يحمل إرادة أودن

38
00:02:35,400 --> 00:02:37,100
...لذلك السّبب

39
00:02:38,730 --> 00:02:41,070
!سأفتح حدود هذه البلاد

40
00:02:51,500 --> 00:02:54,540
!دعني أقاتل إلى جانبك

41
00:02:55,040 --> 00:02:58,370
.قلت أنّك ابن كايدو

42
00:03:00,210 --> 00:03:05,510
كان كوزكي أودن رجلاً، صحيح؟
.لذلك صرتُ رجلاً أيضًا

43
00:03:06,380 --> 00:03:08,970
.أنت قويّ جدًّا

44
00:03:09,270 --> 00:03:11,350
.لقد ذكّرتني بإيس

45
00:03:18,860 --> 00:03:23,400
"!انفجار؟! الأصفاد الّتي تقيّد حرّيّة ياماتو"

46
00:03:46,630 --> 00:03:48,840
!تعرف إيس؟

47
00:03:48,840 --> 00:03:49,880
!نعم

48
00:03:57,980 --> 00:04:03,440
.أتى إلى هنا في الماضي لدقّ عنق كايدو

49
00:04:10,950 --> 00:04:14,160
.تحدّث كثيرًا عنك

50
00:04:15,830 --> 00:04:17,370
...فهمت

51
00:04:20,920 --> 00:04:23,840
،عندما أوشك هو وطاقمه على المغادرة

52
00:04:23,840 --> 00:04:28,130
!أردت الذّهاب معهم في مغامرة في الحقيقة

53
00:04:28,550 --> 00:04:30,720
لماذا ما زلت هنا؟

54
00:04:33,100 --> 00:04:36,180
.هنالك سبب وجيه يمنعني

55
00:05:07,800 --> 00:05:09,090
ماذا؟

56
00:05:09,930 --> 00:05:12,630
!أيّها القبطان، لن نقاتل إلى جانبهم؟

57
00:05:14,310 --> 00:05:17,060
.لديّ سببي الخاصّ

58
00:05:17,060 --> 00:05:18,600
!تعالوا معي في الحال

59
00:05:18,600 --> 00:05:20,810
!حاضر أيّها القبطان

60
00:05:22,020 --> 00:05:23,600
!لو-دونو

61
00:05:24,980 --> 00:05:28,940
.شكرًا على كلّ شيء
!أتمنّى لك أوفر الحظوظ

62
00:05:33,740 --> 00:05:35,240
!بالتّوفيق

63
00:05:36,070 --> 00:05:38,620
هل أنتم جميعًا جاهزون؟

64
00:05:38,620 --> 00:05:41,790
!بالطّبع! أنا سعيد لمجيئي إلى هنا

65
00:05:41,790 --> 00:05:46,420
.قطّ واحد ليس بتعزيزات كبيرة

66
00:05:46,420 --> 00:05:47,590
!ماذا؟

67
00:05:49,960 --> 00:05:53,800
!أيمكنك-غارا قول ذلك بعد رؤية هذه؟

68
00:05:53,800 --> 00:05:54,680
ما هذه؟

69
00:05:54,680 --> 00:05:55,970
!أليست رائعة؟

70
00:05:55,970 --> 00:05:59,640
!ستملأ هذه كايدو بالرّصاص

71
00:05:59,640 --> 00:06:00,930
...رائع

72
00:06:00,930 --> 00:06:07,110
.كيكو، لديّ قصص مغامرات كثيرة لأخبرك بها

73
00:06:07,110 --> 00:06:10,070
...نعم، وكذلك أنا

74
00:06:10,070 --> 00:06:11,160
...لكن

75
00:06:11,990 --> 00:06:15,830
!علينا الإطاحة بكايدو أوّلاً

76
00:06:15,830 --> 00:06:17,200
!نعم

77
00:06:23,250 --> 00:06:26,290
...أنقذ أودن-ساما حياتنا

78
00:06:31,500 --> 00:06:34,260
!فلنراهن بها هذه اللّيلة

79
00:06:47,270 --> 00:06:48,940
!إنّهم قادمون

80
00:06:49,190 --> 00:06:50,490
!أجل

81
00:07:08,210 --> 00:07:09,420
...إنّهم

82
00:07:23,470 --> 00:07:24,930
...إنّهم

83
00:07:26,230 --> 00:07:28,310
!لا بدّ أنّهم من رسمه هو

84
00:07:35,940 --> 00:07:37,780
أهو في الأعلى؟

85
00:08:24,960 --> 00:08:27,660
...عرفت أنّكم ستأتون

86
00:08:29,250 --> 00:08:34,460
رغم أنّنا لم نعثر على أيّ علامة
،على دخول محاربي ساموراي

87
00:08:34,460 --> 00:08:37,760
.كان من الصّعب تصديق أنّكم لم تكونوا هنا

88
00:08:39,550 --> 00:08:43,890
!أعلم كم أنّكم مثابرون أكثر من أيّ أحد آخر

89
00:08:44,680 --> 00:08:46,760
!أنتم هنا بالفعل

90
00:08:46,760 --> 00:08:51,060
بعد اختفائكم كالفئران لعشرين
!سنة منذ حادثة الغليان

91
00:08:52,520 --> 00:08:53,980
...كانجورو

92
00:08:53,980 --> 00:08:55,900
!هل خنتنا؟

93
00:08:57,780 --> 00:09:00,440
.لن أسمح لكم بأن تغيروا علينا

94
00:09:00,900 --> 00:09:06,160
إيزو، أراك قد عدت... لتقاتل معركة خاسرة؟

95
00:09:09,080 --> 00:09:13,960
محاربون يقاتلون حتّى بعد أن قُطعت
.رؤوسهم... رسم ممتاز

96
00:09:13,960 --> 00:09:16,840
!يبدون مثلكم يا رفاق، صحيح؟

97
00:09:16,840 --> 00:09:22,170
حتّى بعد خسارتكم لرأسكم أودن، ما زلتم
.أيّها السّاموراي الخاسرون تتلوّون كالدّيدان

98
00:09:22,170 --> 00:09:24,510
...إذًا فهذه هي حقيقتك

99
00:09:25,640 --> 00:09:27,760
!يا لك من ممثلّ رائع

100
00:09:27,760 --> 00:09:30,600
!ما زال رأسنا بين أكتافنا

101
00:09:30,600 --> 00:09:33,440
!سيّدنا هو مومونوسكي-ساما

102
00:09:33,440 --> 00:09:35,860
!هل مومونوسكي-ساما بخير؟

103
00:09:37,650 --> 00:09:41,740
...لا يمكنني الجزم بذلك

104
00:09:45,120 --> 00:09:46,910
!ما الّذي تعنيه؟

105
00:09:46,910 --> 00:09:51,170
.لقد حاول جاهدًا الهرب

106
00:09:53,080 --> 00:09:56,040
!كيف أصل إلى أوروتشي-ساما؟

107
00:10:07,800 --> 00:10:09,640
!توقّف

108
00:10:16,230 --> 00:10:21,110
!لن أكون عبئًا لهم

109
00:10:46,470 --> 00:10:48,840
ما الّذي تفعله؟

110
00:11:02,650 --> 00:11:04,400
،إن هربت

111
00:11:06,200 --> 00:11:09,280
!فلا يمكنني تحقيق دوري

112
00:11:13,750 --> 00:11:17,060
،كنتُ سأفقده وعيه فحسب

113
00:11:17,060 --> 00:11:20,330
...لكنّني بالغت قليلاً

114
00:11:20,330 --> 00:11:24,300
،بفضل تشبّثه بالحياة

115
00:11:24,300 --> 00:11:27,680
.استطعت تسليمه لأوروتشي-ساما

116
00:11:29,140 --> 00:11:30,800
!مومونوسكي-ساما

117
00:11:30,800 --> 00:11:31,890
!أيّها الوغد

118
00:11:31,890 --> 00:11:38,350
كيف أمكنك فعل هذا بشخص كان
!سيّدك فيما سبق ومجرّد طفل أيضًا؟

119
00:11:40,310 --> 00:11:45,380
.هذا لا شيء مقارنة بما مرّت به عشيرة كوروزومي

120
00:11:45,380 --> 00:11:48,860
.وما كان ذلك إلاّ البداية

121
00:11:49,120 --> 00:11:51,700
،على الخشبة في الدّاخل

122
00:11:51,700 --> 00:11:55,830
!سيُقام إعدام مومونوسكي العلنيّ قريبًا

123
00:12:08,800 --> 00:12:12,450
.كلّ ما علينا فعله هو إيقافكم ها هنا

124
00:12:12,450 --> 00:12:16,470
.سينتهي تاريخ كوزكي بعد بضع دقائق

125
00:12:16,470 --> 00:12:19,140
!لا تعبث معنا يا كانجورو

126
00:12:20,940 --> 00:12:26,980
لتحقيق حلم أودن-ساما الغالي
،الّذي عهد لنا به، تحمّلنا المصاعب

127
00:12:27,360 --> 00:12:32,530
،لم نجذب الانتباه لنا لعشرين سنة
!بل وسافرنا حتّى عبر الزّمن

128
00:12:32,870 --> 00:12:36,260
!لن نتوقّف هنا

129
00:12:36,260 --> 00:12:37,980
،إن حاولت إيقافنا

130
00:12:37,980 --> 00:12:40,920
!فسنقوم بتقطيعك ومواصلة طريقنا فحسب

131
00:12:43,340 --> 00:12:45,380
...حسنًا

132
00:12:45,380 --> 00:12:49,610
في تلك الحالة، علينا القتال
.ووضع حدّ لأمركم هنا

133
00:12:49,610 --> 00:12:54,600
لن نوقفكم فحسب، بل سنقاتلكم
...أيّها الأكازايا المتعطّشون للانتقام

134
00:12:57,060 --> 00:13:01,440
!وسنقضي عليكم حتّى آخر رجل

135
00:13:08,820 --> 00:13:10,820
!كانجورو

136
00:13:11,490 --> 00:13:13,830
!تقدّموا

137
00:13:38,810 --> 00:13:41,230
!تقدّموا

138
00:13:52,400 --> 00:13:53,700
!أسلوب الكابّا

139
00:13:55,950 --> 00:13:57,660
!يوريكيري

140
00:13:58,870 --> 00:14:01,040
!شوركن الزّهور

141
00:14:11,640 --> 00:14:14,170
!إلى الجحيم

142
00:14:20,310 --> 00:14:22,680
!أنت-غارا! ما الّذي حدث لساقك؟

143
00:14:24,360 --> 00:14:27,190
!هذا أسلوب السّيفين خاصّتي
أليس رائعًا؟

144
00:14:27,190 --> 00:14:28,360
!إنّه رائع

145
00:14:40,960 --> 00:14:44,830
ما الخطب يا كيكو؟ ألن تهاجميني؟

146
00:14:45,960 --> 00:14:49,590
.قبل ذلك، دعني أطرح عليك سؤالاً

147
00:14:55,800 --> 00:15:00,100
...أعلم أنّك خدعتنا

148
00:15:00,100 --> 00:15:05,060
!لكنّنا قضينا الكثير من الوقت معًا أيضًا

149
00:15:07,070 --> 00:15:10,920
!أكان كلّ ذلك كذبًا؟

150
00:15:10,920 --> 00:15:14,690
!ألم تكن هنالك أيّ حقيقة لصداقتنا؟

151
00:15:27,590 --> 00:15:29,630
...أنا سعيد للغاية

152
00:15:30,710 --> 00:15:34,630
!لسماع ثناء كهذا على تمثيلي

153
00:15:36,380 --> 00:15:40,820
،ما زلت تحاولين أن تثقي بي بعد خيانة كهذه

154
00:15:40,820 --> 00:15:46,350
ممّا يعني أنّني أدّيت دوري على أكمل وجه، صحيح؟

155
00:15:46,350 --> 00:15:47,940
!سبق وأخبرتكم

156
00:15:47,940 --> 00:15:52,110
!صرت متبلّد الشّعور عندما كنت طفلاً

157
00:15:52,610 --> 00:15:54,730
...لهذا السّبب

158
00:15:54,860 --> 00:15:57,740
!الدّايميو

159
00:15:59,240 --> 00:16:04,200
كان باستطاعتي الابتسام حولكم
!رغم أنّني لم أكن مستمتعًا

160
00:16:05,330 --> 00:16:10,500
!افتحوا بلاد وانو

161
00:16:16,300 --> 00:16:20,010
!اهربوا! إلى كوري

162
00:16:20,390 --> 00:16:25,010
.وكان باستطاعتي البكاء رغم أنّني لم أكن حزينًا

163
00:16:27,100 --> 00:16:33,490
.صرت الآن ممتلئًا بالمشاعر ثانية يا كيكو

164
00:16:34,490 --> 00:16:37,570
لم تكن هنالك شائبة في تمثيلي، صحيح؟

165
00:16:41,410 --> 00:16:45,060
!ابكي، ابكي حتّى تجفّ عيناك

166
00:16:45,060 --> 00:16:50,020
كلّما بكيتِ، شعرتُ أكثر أنّ تمثيلي
.كان يستحقّ كلّ ذلك

167
00:16:50,020 --> 00:16:54,210
.وشعرتُ أكثر أنّني أنجزت دوري بنجاح

168
00:17:06,890 --> 00:17:09,160
ما الخطب يا كيكو؟

169
00:17:09,160 --> 00:17:12,640
!ابكي... ابكي أكثر

170
00:17:13,110 --> 00:17:16,610
...هيّا

171
00:17:16,610 --> 00:17:18,030
!هيّا

172
00:17:24,410 --> 00:17:28,370
.كفّ عن الحديث يا كانجورو-سان

173
00:17:31,790 --> 00:17:35,380
...في نظري، وابل المساء كانجورو

174
00:17:36,260 --> 00:17:38,460
.كان صديقًا عزيزًا

175
00:17:42,180 --> 00:17:44,200
.جهّز نفسك

176
00:17:44,200 --> 00:17:48,140
.سيتبعك الجرح من هذا السّيف إلى قبرك

177
00:17:48,690 --> 00:17:51,120
،كما يتبقّى الثّلج قُبيل الرّبيع

178
00:17:51,120 --> 00:17:54,360
!فسأواصل إرهاب روحك

179
00:17:59,610 --> 00:18:01,070
!أرني ما لديك يا كيكو

180
00:18:14,460 --> 00:18:16,580
!توقّف

181
00:18:18,470 --> 00:18:20,550
!لن أسمح لك بالهرب

182
00:18:20,550 --> 00:18:24,550
!إن أمسك بك، فسيأخذك لبيغ مام

183
00:18:24,550 --> 00:18:28,220
!كلاّ! أنا واثق أنّه سيُقضى عليّ

184
00:18:28,220 --> 00:18:30,310
!ساعدوني يا هؤلاء

185
00:18:35,640 --> 00:18:37,150
!شاميسن

186
00:18:37,820 --> 00:18:39,650
!ما هذه الوحوش؟

187
00:18:39,860 --> 00:18:45,320
إنّها يوكاي! مخلوقات خرافيّة
!من قصص أشباح بلاد وانو

188
00:18:48,990 --> 00:18:50,120
!كلاّ

189
00:18:51,620 --> 00:18:54,120
!جوّ سليل الرّعد

190
00:18:57,300 --> 00:18:58,710
!شكرًا لك

191
00:18:59,210 --> 00:19:01,260
!اتركني

192
00:19:01,630 --> 00:19:03,380
!اهربي يا شينوبو-تشان

193
00:19:03,890 --> 00:19:05,590
...لا يمكنني ذلك

194
00:19:05,590 --> 00:19:08,800
،إن أمسكوا بك أيضًا
!فمن سينقذ مومو-تشان؟

195
00:19:14,520 --> 00:19:16,140
!توقّفي

196
00:19:16,140 --> 00:19:18,310
!اتركوا نامي

197
00:19:26,950 --> 00:19:30,320
!أنتم! شغّلوا شاشات حلازين الاتّصال بسرعة

198
00:19:30,320 --> 00:19:32,960
!بدأ خطاب كايدو-سان مسبقًا

199
00:19:32,960 --> 00:19:35,410
!اخرس! أنا أعمل على ذلك

200
00:19:36,080 --> 00:19:39,290
...ظننتُ بصفتي كوزكي أودن

201
00:19:39,290 --> 00:19:45,210
أنّك بصفتك أخا إيس، ستسمح لي بالصّعود
.على سفينتك، لذلك جمعت معلومات عنك

202
00:19:45,210 --> 00:19:49,140
!مهلاً! يحبّ الجميع كوزكي أودن

203
00:19:49,140 --> 00:19:51,850
!لا يمكنك أن تصير هو ببساطة

204
00:19:52,680 --> 00:19:55,220
!أعلم أنّك أودن أكثر منّي

205
00:19:55,220 --> 00:19:57,810
!ما قصدك بأنّي أودن أكثر منك؟

206
00:19:58,860 --> 00:20:02,320
...رغم أنّني أودن، فلستُ حرًّا

207
00:20:03,570 --> 00:20:06,200
!بسبب هذه الأصفاد

208
00:20:08,530 --> 00:20:12,580
أردت أن أخوض غمار البحر
...رفقة إيس والبقيّة

209
00:20:14,620 --> 00:20:19,370
لكنّني كنت أسيرًا على هذه الجزيرة
!مذ كنت في الثّامنة

210
00:20:21,090 --> 00:20:23,000
!أليست هذه للسّجناء؟

211
00:20:23,000 --> 00:20:28,770
نعم! قال والدي أنّها ستنفجر
.إن غادرت هذه الجزيرة

212
00:20:28,770 --> 00:20:32,570
...ولأصدقك القول، أظنّه قد كذب

213
00:20:32,570 --> 00:20:35,850
!فأيّ والد قد يفجّر ابنه من لحمه ودمه؟

214
00:20:36,390 --> 00:20:40,710
،لكن عند التّفكير في أسوأ الاحتمالات
.لا أقوى على الوقوف

215
00:20:40,710 --> 00:20:42,940
!لأنّ والدي نذل لتلك الدّرجة

216
00:20:42,940 --> 00:20:45,440
أتريد منّي أن أنزعها؟

217
00:20:45,650 --> 00:20:46,690
!ماذا؟

218
00:20:46,690 --> 00:20:51,360
أتريد فعلاً القتال إلى جانبنا؟

219
00:20:51,360 --> 00:20:55,450
حتّى إن كنت هناك، فستراني وأنا
!أوسع كايدو ضربًا بأمّ عينيك

220
00:20:55,450 --> 00:20:57,430
!أتمنّى لو أمكنني ذلك بنفسي

221
00:20:57,430 --> 00:21:02,230
!لا أدري كم مرّة ضربني فيها منذ صغري

222
00:21:02,230 --> 00:21:05,250
!في كلّ مرّة أتحدّاه فيها، أُهزم

223
00:21:05,250 --> 00:21:07,720
!فهمت. حسنًا، سأنزعها عنك

224
00:21:07,720 --> 00:21:12,510
...ستنزعها؟ لقد قيّدت حرّيّتي لعشرين سنة

225
00:21:12,510 --> 00:21:14,640
...الأمر ليس بتلك السّهولة

226
00:21:14,640 --> 00:21:18,140
!مرّت سنتان على حرب القمّة ضدّ اللّحية البيضاء

227
00:21:23,730 --> 00:21:26,820
!إنّه بثّ من طابق العرض

228
00:21:28,450 --> 00:21:31,930
!بدأ العالم بالتّحرّك أخيرًا

229
00:21:31,930 --> 00:21:37,200
لقد قرّروا إلغاء نظام الشّيتشيبوكاي
!ليس لأنّ الحكومة قد فقدت عقلها

230
00:21:42,290 --> 00:21:49,130
إنّها علامة على ثقتهم بأنّ بإمكانهم
!بالسّيطرة علينا بقوّات البحريّة الجديدة

231
00:21:53,130 --> 00:21:57,970
،لكن بينما حكومة العالم مقتنعة بذلك

232
00:21:58,510 --> 00:22:01,500
،فسنجمع أقوى القوى في هذا العالم

233
00:22:01,500 --> 00:22:04,310
!الأسلحة القديمة

234
00:22:09,650 --> 00:22:11,990
...ولتحقيق ذلك

235
00:22:20,870 --> 00:22:24,120
!تحالفنا مع بيغ مام

236
00:22:43,150 --> 00:22:45,270
...هل قمت

237
00:22:46,150 --> 00:22:49,690
!بمناداتي يا كايدو؟

238
00:23:04,410 --> 00:23:09,650
،يبدأ كايدو تحرّكاته للحصول على الكنز الأعظم
!لكنّ تصرّفه العنيف يهزّ أونيغاشيما

239
00:23:09,650 --> 00:23:14,090
،وفي ظلّ هذه الظّروف المخيفة
!يسخر كانجورو من أعضاء الأكازايا

240
00:23:14,300 --> 00:23:19,050
وتسحب أوكيكو الّتي بكت بسبب خيانته سيفها

241
00:23:19,050 --> 00:23:22,020
!وتندفع لإنقاذ زميلها الّذي ضاع في الظّلام

242
00:23:22,470 --> 00:23:27,640
:في الحلقة القادمة من وان بيس
"!مواجهة الأكازايا! كيكونجو ضدّ كانجورو"

243
00:23:27,640 --> 00:23:30,190
!ملك القراصنة، لن يكون إلاّ أنا