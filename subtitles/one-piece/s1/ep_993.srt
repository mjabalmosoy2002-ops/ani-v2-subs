1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:12,570 --> 00:02:17,610
تسلّل لوفي والبقيّة إلى أونيغاشيما واحدًا
.تلو الآخر وهم يتقدّمون في غارتهم

29
00:02:17,610 --> 00:02:22,200
!إنّه مشروع أونيغاشيما الجديدة

30
00:02:24,160 --> 00:02:28,210
...قبل 20 سنة، شهدت على إعدام أودن

31
00:02:28,790 --> 00:02:31,790
.السّاعة الأسطوريّة

32
00:02:32,130 --> 00:02:35,050
.لم يوجد أيّ ساموراي بنفس عظمته قطّ

33
00:02:35,680 --> 00:02:37,380
...وإنّ من قتلاه

34
00:02:37,740 --> 00:02:39,930
...هما أوروتشي ووالدي

35
00:02:40,720 --> 00:02:42,340
!كايدو

36
00:02:42,340 --> 00:02:45,370
،بما أنّ ساموراي الأكازايا أموات الآن

37
00:02:45,370 --> 00:02:48,180
!على أحد ما أن يحمل إرادة أودن

38
00:02:49,400 --> 00:02:51,100
...لذلك السّبب

39
00:02:52,730 --> 00:02:55,070
!سأفتح حدود هذه البلاد

40
00:03:05,500 --> 00:03:08,540
!دعني أقاتل إلى جانبك

41
00:03:09,040 --> 00:03:12,370
.قلت أنّك ابن كايدو

42
00:03:14,210 --> 00:03:19,510
كان كوزكي أودن رجلاً، صحيح؟
.لذلك صرتُ رجلاً أيضًا

43
00:03:20,380 --> 00:03:22,970
.أنت قويّ جدًّا

44
00:03:23,270 --> 00:03:25,350
.لقد ذكّرتني بإيس

45
00:03:32,860 --> 00:03:37,400
"!انفجار؟! الأصفاد الّتي تقيّد حرّيّة ياماتو"

46
00:04:00,630 --> 00:04:02,840
!تعرف إيس؟

47
00:04:02,840 --> 00:04:03,880
!نعم

48
00:04:11,980 --> 00:04:17,440
.أتى إلى هنا في الماضي لدقّ عنق كايدو

49
00:04:24,950 --> 00:04:28,160
.تحدّث كثيرًا عنك

50
00:04:29,830 --> 00:04:31,370
...فهمت

51
00:04:34,920 --> 00:04:37,840
،عندما أوشك هو وطاقمه على المغادرة

52
00:04:37,840 --> 00:04:42,130
!أردت الذّهاب معهم في مغامرة في الحقيقة

53
00:04:42,550 --> 00:04:44,720
لماذا ما زلت هنا؟

54
00:04:47,100 --> 00:04:50,180
.هنالك سبب وجيه يمنعني

55
00:05:21,800 --> 00:05:23,090
ماذا؟

56
00:05:23,930 --> 00:05:26,630
!أيّها القبطان، لن نقاتل إلى جانبهم؟

57
00:05:28,310 --> 00:05:31,060
.لديّ سببي الخاصّ

58
00:05:31,060 --> 00:05:32,600
!تعالوا معي في الحال

59
00:05:32,600 --> 00:05:34,810
!حاضر أيّها القبطان

60
00:05:36,020 --> 00:05:37,600
!لو-دونو

61
00:05:38,980 --> 00:05:42,940
.شكرًا على كلّ شيء
!أتمنّى لك أوفر الحظوظ

62
00:05:47,740 --> 00:05:49,240
!بالتّوفيق

63
00:05:50,070 --> 00:05:52,620
هل أنتم جميعًا جاهزون؟

64
00:05:52,620 --> 00:05:55,790
!بالطّبع! أنا سعيد لمجيئي إلى هنا

65
00:05:55,790 --> 00:06:00,420
.قطّ واحد ليس بتعزيزات كبيرة

66
00:06:00,420 --> 00:06:01,590
!ماذا؟

67
00:06:03,960 --> 00:06:07,800
!أيمكنك-غارا قول ذلك بعد رؤية هذه؟

68
00:06:07,800 --> 00:06:08,680
ما هذه؟

69
00:06:08,680 --> 00:06:09,970
!أليست رائعة؟

70
00:06:09,970 --> 00:06:13,640
!ستملأ هذه كايدو بالرّصاص

71
00:06:13,640 --> 00:06:14,930
...رائع

72
00:06:14,930 --> 00:06:21,110
.كيكو، لديّ قصص مغامرات كثيرة لأخبرك بها

73
00:06:21,110 --> 00:06:24,070
...نعم، وكذلك أنا

74
00:06:24,070 --> 00:06:25,160
...لكن

75
00:06:25,990 --> 00:06:29,830
!علينا الإطاحة بكايدو أوّلاً

76
00:06:29,830 --> 00:06:31,200
!نعم

77
00:06:37,250 --> 00:06:40,290
...أنقذ أودن-ساما حياتنا

78
00:06:45,500 --> 00:06:48,260
!فلنراهن بها هذه اللّيلة

79
00:07:01,270 --> 00:07:02,940
!إنّهم قادمون

80
00:07:03,190 --> 00:07:04,490
!أجل

81
00:07:22,210 --> 00:07:23,420
...إنّهم

82
00:07:37,470 --> 00:07:38,930
...إنّهم

83
00:07:40,230 --> 00:07:42,310
!لا بدّ أنّهم من رسمه هو

84
00:07:49,940 --> 00:07:51,780
أهو في الأعلى؟

85
00:08:38,960 --> 00:08:41,660
...عرفت أنّكم ستأتون

86
00:08:43,250 --> 00:08:48,460
رغم أنّنا لم نعثر على أيّ علامة
،على دخول محاربي ساموراي

87
00:08:48,460 --> 00:08:51,760
.كان من الصّعب تصديق أنّكم لم تكونوا هنا

88
00:08:53,550 --> 00:08:57,890
!أعلم كم أنّكم مثابرون أكثر من أيّ أحد آخر

89
00:08:58,680 --> 00:09:00,760
!أنتم هنا بالفعل

90
00:09:00,760 --> 00:09:05,060
بعد اختفائكم كالفئران لعشرين
!سنة منذ حادثة الغليان

91
00:09:06,520 --> 00:09:07,980
...كانجورو

92
00:09:07,980 --> 00:09:09,900
!هل خنتنا؟

93
00:09:11,780 --> 00:09:14,440
.لن أسمح لكم بأن تغيروا علينا

94
00:09:14,900 --> 00:09:20,160
إيزو، أراك قد عدت... لتقاتل معركة خاسرة؟

95
00:09:23,080 --> 00:09:27,960
محاربون يقاتلون حتّى بعد أن قُطعت
.رؤوسهم... رسم ممتاز

96
00:09:27,960 --> 00:09:30,840
!يبدون مثلكم يا رفاق، صحيح؟

97
00:09:30,840 --> 00:09:36,170
حتّى بعد خسارتكم لرأسكم أودن، ما زلتم
.أيّها السّاموراي الخاسرون تتلوّون كالدّيدان

98
00:09:36,170 --> 00:09:38,510
...إذًا فهذه هي حقيقتك

99
00:09:39,640 --> 00:09:41,760
!يا لك من ممثلّ رائع

100
00:09:41,760 --> 00:09:44,600
!ما زال رأسنا بين أكتافنا

101
00:09:44,600 --> 00:09:47,440
!سيّدنا هو مومونوسكي-ساما

102
00:09:47,440 --> 00:09:49,860
!هل مومونوسكي-ساما بخير؟

103
00:09:51,650 --> 00:09:55,740
...لا يمكنني الجزم بذلك

104
00:09:59,120 --> 00:10:00,910
!ما الّذي تعنيه؟

105
00:10:00,910 --> 00:10:05,170
.لقد حاول جاهدًا الهرب

106
00:10:07,080 --> 00:10:10,040
!كيف أصل إلى أوروتشي-ساما؟

107
00:10:21,800 --> 00:10:23,640
!توقّف

108
00:10:30,230 --> 00:10:35,110
!لن أكون عبئًا لهم

109
00:11:00,470 --> 00:11:02,840
ما الّذي تفعله؟

110
00:11:16,650 --> 00:11:18,400
،إن هربت

111
00:11:20,200 --> 00:11:23,280
!فلا يمكنني تحقيق دوري

112
00:11:27,750 --> 00:11:31,060
،كنتُ سأفقده وعيه فحسب

113
00:11:31,060 --> 00:11:34,330
...لكنّني بالغت قليلاً

114
00:11:34,330 --> 00:11:38,300
،بفضل تشبّثه بالحياة

115
00:11:38,300 --> 00:11:41,680
.استطعت تسليمه لأوروتشي-ساما

116
00:11:43,140 --> 00:11:44,800
!مومونوسكي-ساما

117
00:11:44,800 --> 00:11:45,890
!أيّها الوغد

118
00:11:45,890 --> 00:11:52,350
كيف أمكنك فعل هذا بشخص كان
!سيّدك فيما سبق ومجرّد طفل أيضًا؟

119
00:11:54,310 --> 00:11:59,380
.هذا لا شيء مقارنة بما مرّت به عشيرة كوروزومي

120
00:11:59,380 --> 00:12:02,860
.وما كان ذلك إلاّ البداية

121
00:12:03,120 --> 00:12:05,700
،على الخشبة في الدّاخل

122
00:12:05,700 --> 00:12:09,830
!سيُقام إعدام مومونوسكي العلنيّ قريبًا

123
00:12:22,800 --> 00:12:26,450
.كلّ ما علينا فعله هو إيقافكم ها هنا

124
00:12:26,450 --> 00:12:30,470
.سينتهي تاريخ كوزكي بعد بضع دقائق

125
00:12:30,470 --> 00:12:33,140
!لا تعبث معنا يا كانجورو

126
00:12:34,940 --> 00:12:40,980
لتحقيق حلم أودن-ساما الغالي
،الّذي عهد لنا به، تحمّلنا المصاعب

127
00:12:41,360 --> 00:12:46,530
،لم نجذب الانتباه لنا لعشرين سنة
!بل وسافرنا حتّى عبر الزّمن

128
00:12:46,870 --> 00:12:50,260
!لن نتوقّف هنا

129
00:12:50,260 --> 00:12:51,980
،إن حاولت إيقافنا

130
00:12:51,980 --> 00:12:54,920
!فسنقوم بتقطيعك ومواصلة طريقنا فحسب

131
00:12:57,340 --> 00:12:59,380
...حسنًا

132
00:12:59,380 --> 00:13:03,610
في تلك الحالة، علينا القتال
.ووضع حدّ لأمركم هنا

133
00:13:03,610 --> 00:13:08,600
لن نوقفكم فحسب، بل سنقاتلكم
...أيّها الأكازايا المتعطّشون للانتقام

134
00:13:11,060 --> 00:13:15,440
!وسنقضي عليكم حتّى آخر رجل

135
00:13:22,820 --> 00:13:24,820
!كانجورو

136
00:13:25,490 --> 00:13:27,830
!تقدّموا

137
00:13:52,810 --> 00:13:55,230
!تقدّموا

138
00:14:06,400 --> 00:14:07,700
!أسلوب الكابّا

139
00:14:09,950 --> 00:14:11,660
!يوريكيري

140
00:14:12,870 --> 00:14:15,040
!شوركن الزّهور

141
00:14:25,640 --> 00:14:28,170
!إلى الجحيم

142
00:14:34,310 --> 00:14:36,680
!أنت-غارا! ما الّذي حدث لساقك؟

143
00:14:38,360 --> 00:14:41,190
!هذا أسلوب السّيفين خاصّتي
أليس رائعًا؟

144
00:14:41,190 --> 00:14:42,360
!إنّه رائع

145
00:14:54,960 --> 00:14:58,830
ما الخطب يا كيكو؟ ألن تهاجميني؟

146
00:14:59,960 --> 00:15:03,590
.قبل ذلك، دعني أطرح عليك سؤالاً

147
00:15:09,800 --> 00:15:14,100
...أعلم أنّك خدعتنا

148
00:15:14,100 --> 00:15:19,060
!لكنّنا قضينا الكثير من الوقت معًا أيضًا

149
00:15:21,070 --> 00:15:24,920
!أكان كلّ ذلك كذبًا؟

150
00:15:24,920 --> 00:15:28,690
!ألم تكن هنالك أيّ حقيقة لصداقتنا؟

151
00:15:41,590 --> 00:15:43,630
...أنا سعيد للغاية

152
00:15:44,710 --> 00:15:48,630
!لسماع ثناء كهذا على تمثيلي

153
00:15:50,380 --> 00:15:54,820
،ما زلت تحاولين أن تثقي بي بعد خيانة كهذه

154
00:15:54,820 --> 00:16:00,350
ممّا يعني أنّني أدّيت دوري على أكمل وجه، صحيح؟

155
00:16:00,350 --> 00:16:01,940
!سبق وأخبرتكم

156
00:16:01,940 --> 00:16:06,110
!صرت متبلّد الشّعور عندما كنت طفلاً

157
00:16:06,610 --> 00:16:08,730
...لهذا السّبب

158
00:16:08,860 --> 00:16:11,740
!الدّايميو

159
00:16:13,240 --> 00:16:18,200
كان باستطاعتي الابتسام حولكم
!رغم أنّني لم أكن مستمتعًا

160
00:16:19,330 --> 00:16:24,500
!افتحوا بلاد وانو

161
00:16:30,300 --> 00:16:34,010
!اهربوا! إلى كوري

162
00:16:34,390 --> 00:16:39,010
.وكان باستطاعتي البكاء رغم أنّني لم أكن حزينًا

163
00:16:41,100 --> 00:16:47,490
.صرت الآن ممتلئًا بالمشاعر ثانية يا كيكو

164
00:16:48,490 --> 00:16:51,570
لم تكن هنالك شائبة في تمثيلي، صحيح؟

165
00:16:55,410 --> 00:16:59,060
!ابكي، ابكي حتّى تجفّ عيناك

166
00:16:59,060 --> 00:17:04,020
كلّما بكيتِ، شعرتُ أكثر أنّ تمثيلي
.كان يستحقّ كلّ ذلك

167
00:17:04,020 --> 00:17:08,210
.وشعرتُ أكثر أنّني أنجزت دوري بنجاح

168
00:17:20,890 --> 00:17:23,160
ما الخطب يا كيكو؟

169
00:17:23,160 --> 00:17:26,640
!ابكي... ابكي أكثر

170
00:17:27,110 --> 00:17:30,610
...هيّا

171
00:17:30,610 --> 00:17:32,030
!هيّا

172
00:17:38,410 --> 00:17:42,370
.كفّ عن الحديث يا كانجورو-سان

173
00:17:45,790 --> 00:17:49,380
...في نظري، وابل المساء كانجورو

174
00:17:50,260 --> 00:17:52,460
.كان صديقًا عزيزًا

175
00:17:56,180 --> 00:17:58,200
.جهّز نفسك

176
00:17:58,200 --> 00:18:02,140
.سيتبعك الجرح من هذا السّيف إلى قبرك

177
00:18:02,690 --> 00:18:05,120
،كما يتبقّى الثّلج قُبيل الرّبيع

178
00:18:05,120 --> 00:18:08,360
!فسأواصل إرهاب روحك

179
00:18:13,610 --> 00:18:15,070
!أرني ما لديك يا كيكو

180
00:18:28,460 --> 00:18:30,580
!توقّف

181
00:18:32,470 --> 00:18:34,550
!لن أسمح لك بالهرب

182
00:18:34,550 --> 00:18:38,550
!إن أمسك بك، فسيأخذك لبيغ مام

183
00:18:38,550 --> 00:18:42,220
!كلاّ! أنا واثق أنّه سيُقضى عليّ

184
00:18:42,220 --> 00:18:44,310
!ساعدوني يا هؤلاء

185
00:18:49,640 --> 00:18:51,150
!شاميسن

186
00:18:51,820 --> 00:18:53,650
!ما هذه الوحوش؟

187
00:18:53,860 --> 00:18:59,320
إنّها يوكاي! مخلوقات خرافيّة
!من قصص أشباح بلاد وانو

188
00:19:02,990 --> 00:19:04,120
!كلاّ

189
00:19:05,620 --> 00:19:08,120
!جوّ سليل الرّعد

190
00:19:11,300 --> 00:19:12,710
!شكرًا لك

191
00:19:13,210 --> 00:19:15,260
!اتركني

192
00:19:15,630 --> 00:19:17,380
!اهربي يا شينوبو-تشان

193
00:19:17,890 --> 00:19:19,590
...لا يمكنني ذلك

194
00:19:19,590 --> 00:19:22,800
،إن أمسكوا بك أيضًا
!فمن سينقذ مومو-تشان؟

195
00:19:28,520 --> 00:19:30,140
!توقّفي

196
00:19:30,140 --> 00:19:32,310
!اتركوا نامي

197
00:19:40,950 --> 00:19:44,320
!أنتم! شغّلوا شاشات حلازين الاتّصال بسرعة

198
00:19:44,320 --> 00:19:46,960
!بدأ خطاب كايدو-سان مسبقًا

199
00:19:46,960 --> 00:19:49,410
!اخرس! أنا أعمل على ذلك

200
00:19:50,080 --> 00:19:53,290
...ظننتُ بصفتي كوزكي أودن

201
00:19:53,290 --> 00:19:59,210
أنّك بصفتك أخا إيس، ستسمح لي بالصّعود
.على سفينتك، لذلك جمعت معلومات عنك

202
00:19:59,210 --> 00:20:03,140
!مهلاً! يحبّ الجميع كوزكي أودن

203
00:20:03,140 --> 00:20:05,850
!لا يمكنك أن تصير هو ببساطة

204
00:20:06,680 --> 00:20:09,220
!أعلم أنّك أودن أكثر منّي

205
00:20:09,220 --> 00:20:11,810
!ما قصدك بأنّي أودن أكثر منك؟

206
00:20:12,860 --> 00:20:16,320
...رغم أنّني أودن، فلستُ حرًّا

207
00:20:17,570 --> 00:20:20,200
!بسبب هذه الأصفاد

208
00:20:22,530 --> 00:20:26,580
أردت أن أخوض غمار البحر
...رفقة إيس والبقيّة

209
00:20:28,620 --> 00:20:33,370
لكنّني كنت أسيرًا على هذه الجزيرة
!مذ كنت في الثّامنة

210
00:20:35,090 --> 00:20:37,000
!أليست هذه للسّجناء؟

211
00:20:37,000 --> 00:20:42,770
نعم! قال والدي أنّها ستنفجر
.إن غادرت هذه الجزيرة

212
00:20:42,770 --> 00:20:46,570
...ولأصدقك القول، أظنّه قد كذب

213
00:20:46,570 --> 00:20:49,850
!فأيّ والد قد يفجّر ابنه من لحمه ودمه؟

214
00:20:50,390 --> 00:20:54,710
،لكن عند التّفكير في أسوأ الاحتمالات
.لا أقوى على الوقوف

215
00:20:54,710 --> 00:20:56,940
!لأنّ والدي نذل لتلك الدّرجة

216
00:20:56,940 --> 00:20:59,440
أتريد منّي أن أنزعها؟

217
00:20:59,650 --> 00:21:00,690
!ماذا؟

218
00:21:00,690 --> 00:21:05,360
أتريد فعلاً القتال إلى جانبنا؟

219
00:21:05,360 --> 00:21:09,450
حتّى إن كنت هناك، فستراني وأنا
!أوسع كايدو ضربًا بأمّ عينيك

220
00:21:09,450 --> 00:21:11,430
!أتمنّى لو أمكنني ذلك بنفسي

221
00:21:11,430 --> 00:21:16,230
!لا أدري كم مرّة ضربني فيها منذ صغري

222
00:21:16,230 --> 00:21:19,250
!في كلّ مرّة أتحدّاه فيها، أُهزم

223
00:21:19,250 --> 00:21:21,720
!فهمت. حسنًا، سأنزعها عنك

224
00:21:21,720 --> 00:21:26,510
...ستنزعها؟ لقد قيّدت حرّيّتي لعشرين سنة

225
00:21:26,510 --> 00:21:28,640
...الأمر ليس بتلك السّهولة

226
00:21:28,640 --> 00:21:32,140
!مرّت سنتان على حرب القمّة ضدّ اللّحية البيضاء

227
00:21:37,730 --> 00:21:40,820
!إنّه بثّ من طابق العرض

228
00:21:42,450 --> 00:21:45,930
!بدأ العالم بالتّحرّك أخيرًا

229
00:21:45,930 --> 00:21:51,200
لقد قرّروا إلغاء نظام الشّيتشيبوكاي
!ليس لأنّ الحكومة قد فقدت عقلها

230
00:21:56,290 --> 00:22:03,130
إنّها علامة على ثقتهم بأنّ بإمكانهم
!بالسّيطرة علينا بقوّات البحريّة الجديدة

231
00:22:07,130 --> 00:22:11,970
،لكن بينما حكومة العالم مقتنعة بذلك

232
00:22:12,510 --> 00:22:15,500
،فسنجمع أقوى القوى في هذا العالم

233
00:22:15,500 --> 00:22:18,310
!الأسلحة القديمة

234
00:22:23,650 --> 00:22:25,990
...ولتحقيق ذلك

235
00:22:34,870 --> 00:22:38,120
!تحالفنا مع بيغ مام

236
00:22:57,150 --> 00:22:59,270
...هل قمت

237
00:23:00,150 --> 00:23:03,690
!بمناداتي يا كايدو؟

238
00:23:18,410 --> 00:23:23,650
،يبدأ كايدو تحرّكاته للحصول على الكنز الأعظم
!لكنّ تصرّفه العنيف يهزّ أونيغاشيما

239
00:23:23,650 --> 00:23:28,090
،وفي ظلّ هذه الظّروف المخيفة
!يسخر كانجورو من أعضاء الأكازايا

240
00:23:28,300 --> 00:23:33,050
وتسحب أوكيكو الّتي بكت بسبب خيانته سيفها

241
00:23:33,050 --> 00:23:36,020
!وتندفع لإنقاذ زميلها الّذي ضاع في الظّلام

242
00:23:36,470 --> 00:23:41,640
:في الحلقة القادمة من وان بيس
"!مواجهة الأكازايا! كيكونجو ضدّ كانجورو"

243
00:23:41,640 --> 00:23:44,190
!ملك القراصنة، لن يكون إلاّ أنا