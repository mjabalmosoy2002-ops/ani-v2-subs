1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,030 --> 00:03:36,560
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:36,560 --> 00:03:41,730
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:41,730 --> 00:03:43,240
لكنّ كفاحه ذهب سدى

40
00:03:44,760 --> 00:03:51,290
.وحرب القمّة الأسطوريّة في مارينفورد انتهت

41
00:04:03,630 --> 00:04:07,810
"!الهبوط في جزيرة النّساء! يستوعب لوفي الواقع الأليم"

42
00:04:38,130 --> 00:04:40,370
!ثمّة سفينة تقترب من لاس كامب في الأزرق الغربيّ

43
00:04:40,370 --> 00:04:43,960
!لكنّ القواعد في تلك المنطقة لا تأوي سفنًا

44
00:04:43,960 --> 00:04:45,260
...القواعد الأقرب لتلك المنطقة هي

45
00:04:46,160 --> 00:04:48,640
!سترسل الوحدة الـ80 الدّعم

46
00:04:54,180 --> 00:04:55,190
!سحقًا

47
00:04:55,190 --> 00:05:01,780
ظننت أنّ القراصنة سيخافون منّا بعد
!قتلنا للّحية البيضاء وظفرنا بالنّصر

48
00:05:02,190 --> 00:05:06,130
،بدلاً من أن يتواروا عن الأنظار
!فهم يهيجون في كلّ مكان

49
00:05:06,130 --> 00:05:08,300
ماذا دهاهم؟

50
00:05:08,300 --> 00:05:10,910
!أغار القراصنة على لاس كامب

51
00:05:13,690 --> 00:05:16,000
!أكرّر، أرسلوا الدّعم إلى لاس كامب

52
00:05:18,130 --> 00:05:22,850
!حمّلوا المؤن! لنذهب إلى الغراند لاين

53
00:05:28,100 --> 00:05:31,130
،بعد أسبوعين من حرب القمّة

54
00:05:31,130 --> 00:05:35,020
.بدأ النّاس يرون آثارها في كلّ مكان

55
00:05:39,460 --> 00:05:43,150
!لـ-لا يمكنكم التّقدّم أكثر! لا تدخلوا بلدتنا

56
00:05:47,010 --> 00:05:49,530
سمعت الأخبار، أليس كذلك؟

57
00:05:53,860 --> 00:05:58,880
.إذًا تعلم أنّ هذه الجزيرة ما عادت تابعةً للّحية البيضاء

58
00:05:58,880 --> 00:06:01,960
!لا معنى من هذا الرّمز الآن

59
00:06:01,960 --> 00:06:05,800
!هذا صحيح! مات اللّحية البيضاء

60
00:06:23,000 --> 00:06:26,690
!اسمع، وضع هذا الكلام حلقة في أذنك

61
00:06:27,160 --> 00:06:33,530
من يسيطر على هذه الجزيرة اعتبارًا
!من اليوم هو أنا القرصان اللّحية البنّيّة

62
00:06:36,790 --> 00:06:41,290
.انتهت الحرب بموت اللّحية البيضاء وانتصار البحريّة

63
00:06:41,290 --> 00:06:44,020
،لكن على نقيض ما ظنّته البحريّة

64
00:06:44,020 --> 00:06:48,130
.صار الوضع متوتّرًا في كلّ أرجاء العالم

65
00:06:50,470 --> 00:06:52,390
،في نفس الأثناء، قبل وقت قصير

66
00:06:52,390 --> 00:06:55,150
قرّر كلّ من هانكوك وجينبي والبقيّة

67
00:06:55,150 --> 00:06:58,270
التّوجّه إلى جزيرة النّساء لإيواء لوفي الغائب عن الوعي

68
00:06:58,270 --> 00:07:01,980
.وانضمّوا إلى سفينة كوجا

69
00:07:01,980 --> 00:07:04,690
!أختي

70
00:07:04,690 --> 00:07:06,190
!أميرة الثّعابين-ساما

71
00:07:06,940 --> 00:07:12,110
!آسفة على إقلاقكنّ يا ساندرسونيا وماريغولد والبقيّة

72
00:07:13,280 --> 00:07:15,910
!شكرًا على ترحيبكنّ الحارّ

73
00:07:16,280 --> 00:07:21,580
!نحن جميعًا ممتنّات على عملك العظيم كشيتشيبوكاي

74
00:07:23,830 --> 00:07:29,630
.حسنًا، هنا ينتهي دوري في مساندة الفتى قبّعة القشّ

75
00:07:29,630 --> 00:07:31,630
!مرحى

76
00:07:31,630 --> 00:07:34,930
ألا بأس أن أترك الباقي لك يا جينبي؟

77
00:07:34,930 --> 00:07:38,220
.أجل. لا أستطيع السّباحة كما أريد بعد

78
00:07:38,220 --> 00:07:42,060
.أقلّ ما أستطيع فعله هو البقاء هنا إلى أن تتحسّن حالته

79
00:07:42,770 --> 00:07:46,370
.لكن لا أعرف كيف أستطيع مساعدته

80
00:07:47,400 --> 00:07:50,320
.كان لقاؤك منعطفًا غريبًا في القدر

81
00:07:50,320 --> 00:07:51,850
.أوافق

82
00:07:51,850 --> 00:07:54,020
مع أنّ كلينا كنّا محبوسين

83
00:07:54,020 --> 00:07:56,700
،في السّجن الأعظم في العالم، إمبل داون

84
00:07:56,980 --> 00:07:59,660
،فلولا لوفي-كن

85
00:07:59,660 --> 00:08:04,250
.لما كنّا التقينا بعضنا أبدًا على الإطلاق على ما أظنّ

86
00:08:04,710 --> 00:08:11,050
كلانا حاولنا بجدّ مجاراة الفتى قبّعة
القشّ في مارينفورد، أليس كذلك؟

87
00:08:11,510 --> 00:08:13,720
من الصّعب توديعكم

88
00:08:13,720 --> 00:08:18,550
.لكنّ أعزّائي الكاندي ينتظرون عودتي في المملكة

89
00:08:18,970 --> 00:08:22,480
!اعتنوا بالفتى قبّعة القشّ جيّدًا

90
00:08:26,900 --> 00:08:30,440
!الوداع يا قبّعة القشّ! شكرًا على تحريرنا

91
00:08:30,440 --> 00:08:34,280
!أستطيع تحقيق حلمي بسببك

92
00:08:34,280 --> 00:08:36,950
!ألقوا التّحيّة عليه عندما يستيقظ

93
00:08:36,950 --> 00:08:40,080
!لنلتق ثانيةً إن سنحت لنا الفرصة

94
00:08:40,080 --> 00:08:41,120
!تماسك

95
00:08:41,120 --> 00:08:44,080
!لا يمكنك أن تموت يا قبّعة القشّ

96
00:08:44,080 --> 00:08:46,880
!حسنًا، لنذهب

97
00:08:46,880 --> 00:08:51,380
!إلى موطن النيوكاما وقبلتنا

98
00:08:51,380 --> 00:08:55,380
!إلى مملكة ماكاباكا! مرحى

99
00:08:55,380 --> 00:08:59,220
.علينا التّوجّه إلى جزيرة النّساء أيضًا

100
00:09:00,430 --> 00:09:05,060
وهكذا وصلت سفينة القراصنة الّتي يركبها
،لوفي إلى جزيرة النّساء أمازون ليلي

101
00:09:05,060 --> 00:09:07,590
حيث تتواجد إمبراطوريّة النّساء المحرّمة على الرّجال

102
00:09:07,590 --> 00:09:11,130
.وحيث تعيش كوجا، قبيلة المحاربات

103
00:09:12,780 --> 00:09:15,490
!أميرة الثّعابين-ساما

104
00:09:15,490 --> 00:09:17,610
!مرحبًا بعودتك

105
00:09:21,740 --> 00:09:24,910
!أنا مسرورة حقًّا لأنّ الأميرة بأمان

106
00:09:24,910 --> 00:09:26,960
!هناك رجال في السّفينة الغريبة في الوراء

107
00:09:27,880 --> 00:09:30,170
!انظروا! لا يوجد فيها سوى النّساء

108
00:09:30,170 --> 00:09:32,750
!صحيح أنّها جزيرة النّساء فقط

109
00:09:32,750 --> 00:09:36,970
!تسلّلوا إلى السّفينة! هذا لا يغتفر

110
00:09:36,970 --> 00:09:37,470
!ا-انتظري

111
00:09:37,780 --> 00:09:39,470
!الرّائحة زكيّة

112
00:09:39,470 --> 00:09:41,600
!أشعر بالدّوار

113
00:09:41,600 --> 00:09:43,520
!لا بدّ أنّ هذه الجنّة

114
00:09:43,520 --> 00:09:45,100
.أنتم

115
00:09:45,560 --> 00:09:49,560
.عليكم أن تدخلوا، وإلاّ ستموتون

116
00:09:56,280 --> 00:09:59,660
!توقّفن! إنّهم ليسوا أعداءً

117
00:09:59,660 --> 00:10:00,660
!أميرة الثّعابين-ساما

118
00:10:00,660 --> 00:10:04,180
!لوفي في تلك السّفينة

119
00:10:04,180 --> 00:10:07,500
،تكبّد أضرارًا جسيمة، ذهنيًّا وجسديًّا
أثناء المعركة في مارينفورد

120
00:10:07,500 --> 00:10:10,830
.وهو يصارع للبقاء على الحياة الآن

121
00:10:10,830 --> 00:10:12,540
!لوفي هنا؟

122
00:10:12,540 --> 00:10:16,920
!يا آنسات، احملن لوفي إلى قلعة كوجا في أسرع وقت

123
00:10:17,590 --> 00:10:20,180
...سأعتني بلوفي

124
00:10:20,180 --> 00:10:22,100
!انتظري لحظة يا أميرة الثّعابين

125
00:10:24,100 --> 00:10:25,470
!الجدّة نيون

126
00:10:25,470 --> 00:10:27,560
.لا بأس بلوفي فقط

127
00:10:27,560 --> 00:10:30,230
لكن لا يمكننا أن نسمح لأولئك الرّجال
على تلك السّفينة الغريبة

128
00:10:30,230 --> 00:10:32,520
.أن يدخلوا جزيرة النّساء

129
00:10:32,520 --> 00:10:35,900
!هذا ضدّ سياسة بلادنا

130
00:10:35,900 --> 00:10:39,950
...إذًا، لنسمح للطّبيب فقط بأن يأتي معه كي

131
00:10:39,950 --> 00:10:41,190
!لا

132
00:10:41,190 --> 00:10:45,650
لا يمكننا أن نسمح لأيّ رجل بدخول
!الجزيرة، حتّى إن كان طبيبًا

133
00:10:46,240 --> 00:10:49,790
!لدينا الكثير من الطّبيبات البارعات في هذه الجزيرة

134
00:10:50,510 --> 00:10:53,170
...لا أهتمّ على أيّ حال، ولكن

135
00:10:53,620 --> 00:10:58,720
هل لديكنّ نفس المعدّات الطّبّيّة
والتّقنيات كما في سفينتي؟

136
00:11:01,130 --> 00:11:04,390
.إن فُتح جرحه ثانيةً، سيموت

137
00:11:04,800 --> 00:11:07,810
.خذن قبّعة القشّ-يا إن كنتنّ لا تكترثن لذلك

138
00:11:07,810 --> 00:11:09,790
!لوفي سيموت؟

139
00:11:09,790 --> 00:11:14,360
...إن حدث ذلك... أنا... أنا سوف

140
00:11:14,360 --> 00:11:19,490
من الواضح أنّنا لا نستطيع إنقاذ
.لوفي-كن دون هذا الرّجل

141
00:11:19,490 --> 00:11:22,580
.إن كان لا يستطيع الدّخول فلا خيار لدينا

142
00:11:22,580 --> 00:11:24,340
.علينا الذّهاب لمكان آخر

143
00:11:24,340 --> 00:11:27,410
!مستحيل! سنُهاجم من قبل ملوك البحر

144
00:11:27,830 --> 00:11:32,370
!وحتّى إن هربنا منها، ستجدنا البحريّة في أيّ لحظة

145
00:11:32,720 --> 00:11:35,380
!ما العمل؟

146
00:11:35,380 --> 00:11:39,460
...لنرَ... سنفعل هذا كاستثناء فقط ولكن

147
00:11:40,720 --> 00:11:43,430
.يمكنكم البقاء في منطقة الخليج

148
00:11:43,430 --> 00:11:47,390
.لن تهاجمكم ملوك البحر هناك

149
00:11:47,880 --> 00:11:51,100
...إذًا، سأظلّ معهم للاعتناء بلوفي

150
00:11:51,100 --> 00:11:52,520
!لا

151
00:11:53,040 --> 00:11:57,320
!سحقًا لك أيّتها الجدّة نيون
!تواصلين قول "لا" في وجهي

152
00:11:57,320 --> 00:12:00,690
!لوفي! آمل أن تتحسّن قريبًا

153
00:12:01,130 --> 00:12:03,540
،هذا فصل "بالنّظر إلى أميرة الثّعابين-ساما

154
00:12:03,540 --> 00:12:06,410
."بإمكاني أن أعرف أنّ لوفي في حالة حرجة

155
00:12:07,780 --> 00:12:09,330
...لوفي

156
00:12:10,410 --> 00:12:12,330
.مضى أسبوعان

157
00:12:12,330 --> 00:12:15,290
...لو والبقيّة يمكثون في الخليج

158
00:12:15,290 --> 00:12:18,170
.لتوفير العلاج للوفي

159
00:12:20,170 --> 00:12:23,590
...إلى متى علينا البقاء في مثل هذا المكان الصّغير

160
00:12:23,590 --> 00:12:27,060
...أجل، المكان الوحيد الّذي نتطلّع له هو

161
00:12:27,060 --> 00:12:28,850
!رفاق، آسفة على التّأخّر

162
00:12:28,850 --> 00:12:30,430
."هذا فصل "إنّه وقت الأكل

163
00:12:30,430 --> 00:12:32,140
!أخيرًا

164
00:12:32,140 --> 00:12:33,350
.تفضّلوا

165
00:12:33,350 --> 00:12:36,570
!عزاؤنا الوحيد هو أنّ الطّعام لذيذ

166
00:12:36,570 --> 00:12:37,230
!أوافق

167
00:12:37,230 --> 00:12:39,150
!تفضّلوا

168
00:12:39,150 --> 00:12:39,780
...شكرًا

169
00:12:39,780 --> 00:12:44,200
.لا تتدافعوا رجاءً وانتظروا أدواركم

170
00:12:44,200 --> 00:12:46,160
!أفلاندرا

171
00:12:46,550 --> 00:12:48,750
!لا تحدّثي الرّجال

172
00:12:48,750 --> 00:12:52,370
.لوفي هو الاستثناء لأنّها أوامر أميرة الثّعابين-ساما

173
00:12:52,370 --> 00:12:54,000
!لا تنسي

174
00:12:54,000 --> 00:12:55,420
!حسنًا

175
00:12:55,420 --> 00:12:59,610
!بربّك، ليس بالأمر الجلل
أليس كذلك يا أفلاندرا-تشان؟

176
00:13:04,370 --> 00:13:06,640
!لن أكرّر كلامي

177
00:13:06,640 --> 00:13:09,350
!نحن آسفون

178
00:13:12,090 --> 00:13:13,230
.المعذرة

179
00:13:14,490 --> 00:13:16,230
هل أفاق لوفي؟

180
00:13:18,690 --> 00:13:19,940
.فهمت

181
00:13:19,940 --> 00:13:22,940
.الأمر راجع لروح قبّعة القشّ-يا المعنويّة

182
00:13:23,310 --> 00:13:27,320
.ما إن كان يريد العيش أم لا

183
00:13:27,320 --> 00:13:29,410
!مارغريت، هيّا بسرعة

184
00:13:29,410 --> 00:13:30,580
!أنا قادمة

185
00:13:30,580 --> 00:13:33,910
!آسفة! اعتن جيّدًا بلوفي

186
00:13:34,160 --> 00:13:38,830
!مارغريت، كم مرّة يجب أن أخبرك ألاّ تحدّثيهم؟

187
00:13:38,830 --> 00:13:40,200
!آسفة

188
00:13:54,140 --> 00:13:55,680
...أختي

189
00:14:01,610 --> 00:14:02,610
...لوفي

190
00:14:08,960 --> 00:14:13,080
!لطالما كنت هكذا يا لوفي

191
00:14:13,410 --> 00:14:15,910
...لم تصغ إليّ قطّ

192
00:14:16,400 --> 00:14:19,420
!ودائمًا ما فعلتَ أشياء جنونيّة

193
00:14:26,630 --> 00:14:28,160
...توقّف

194
00:14:28,160 --> 00:14:29,840
!توقّف

195
00:14:35,600 --> 00:14:37,190
!توقّف يا قبّعة القشّ

196
00:14:37,190 --> 00:14:39,500
!أتريد تدمير السّفينة؟

197
00:14:46,150 --> 00:14:48,030
...إيس

198
00:14:59,830 --> 00:15:01,260
!لوفي-كن

199
00:15:07,710 --> 00:15:11,640
...إيس

200
00:15:14,430 --> 00:15:19,020
!أين هو إيس؟

201
00:15:46,670 --> 00:15:50,160
!هذا خطير! اهدأ يا قبّعة القشّ

202
00:15:50,160 --> 00:15:52,470
ماذا سيحدث إن تركناه هكذا؟

203
00:15:53,200 --> 00:15:58,260
،الأمر بسيط. كما قلت عندما وصلنا إلى هنا

204
00:15:58,260 --> 00:16:02,090
.إن فُتح جرحه ثانيةً، سيموت

205
00:16:04,730 --> 00:16:06,920
!أجل، هذه هي فرصتنا

206
00:16:07,440 --> 00:16:09,610
!ابتعدوا عنّي، سحقًا

207
00:16:09,610 --> 00:16:11,030
!اثبت يا قبّعة القشّ

208
00:16:11,030 --> 00:16:13,870
!اخرس! إنّي أبحث عن إيس

209
00:16:13,870 --> 00:16:15,490
...لكنّي أخبرتك أنّ قبضة النّار قد

210
00:16:15,490 --> 00:16:17,830
"!قلت "ابتعدوا عنّي

211
00:16:19,450 --> 00:16:21,750
!أين هو إيس؟

212
00:16:22,070 --> 00:16:24,280
!إيس

213
00:16:24,290 --> 00:16:26,460
!سحقًا! فقد السّيطرة على نفسه

214
00:16:26,460 --> 00:16:27,880
!إنّه لوفي

215
00:16:27,880 --> 00:16:30,090
!علينا إخبار أميرة الثّعابين-ساما

216
00:16:30,500 --> 00:16:34,760
!أميرة الثّعابين-ساما! أميرة الثّعابين-ساما

217
00:16:35,120 --> 00:16:37,140
!استيقظ لوفي

218
00:16:37,140 --> 00:16:38,600
!لوفي-ساما؟

219
00:16:38,600 --> 00:16:39,850
!حقًّا؟

220
00:16:39,850 --> 00:16:42,730
!حمدًا لهذا. أريد أن أراه على الفور

221
00:16:42,730 --> 00:16:44,560
!لا يمكنك ذلك يا أميرة الثّعابين

222
00:16:44,560 --> 00:16:47,520
.يريد الجميع رؤيته

223
00:16:47,520 --> 00:16:51,740
.لا يمكنك ضبط شعبك إن سمحت لنفسك بالذّهب لرؤيته

224
00:16:52,420 --> 00:16:55,110
.فهذه الجزيرة محرّمة على الرّجال

225
00:16:55,110 --> 00:16:59,720
تركنا رجالاً غرباء يظلّون في منطقة الخليج

226
00:16:59,720 --> 00:17:03,250
!وهذا استثناء أكثر من كاف بالنّسبة لنا

227
00:17:03,250 --> 00:17:05,220
...أدري، لكن

228
00:17:05,220 --> 00:17:07,890
.قبل ذلك يا أختي، عليك أن تأكلي شيئًا

229
00:17:07,890 --> 00:17:12,880
!معها حقّ يا أختي! بالكاد أكلت شيئًا مذ رجعت

230
00:17:12,880 --> 00:17:16,380
!هذا صحيح! لا بدّ أنّ لوفي جائع جدًّا أيضًا

231
00:17:16,380 --> 00:17:19,640
!حضّرن الكثير من الأطباق العظيمة الّتي ستمدّه بالطّاقة

232
00:17:19,640 --> 00:17:21,390
!حسنًا، من دواعي سرورنا

233
00:17:21,390 --> 00:17:25,810
!سأساعدكنّ! لنفعل ذلك الآن يا آنسات

234
00:17:25,810 --> 00:17:27,900
!حاضر يا أميرة الثّعابين-ساما

235
00:17:27,900 --> 00:17:32,730
.عليّ أن أدعها تفعل ذلك فحسب
...تريد فقط أن تحضّر بعض الأقلّ

236
00:17:32,730 --> 00:17:35,860
!ثمّ سآخذها إليه

237
00:17:35,860 --> 00:17:37,410
!ستذهبين إذًا؟

238
00:17:37,410 --> 00:17:43,330
.وعدنا بأن ندعو لوفي لوحده عندما يتعافى

239
00:17:43,330 --> 00:17:45,080
!انتظري تلك اللّحظة

240
00:17:45,080 --> 00:17:48,710
!لا أستطيع! أنا الإمبراطورة! لا تملي عليّ ما أفعل

241
00:17:48,710 --> 00:17:49,870
!قلت لا

242
00:17:49,870 --> 00:17:53,090
!الشّيء الأهمّ هي سياسة هذه البلاد الوراثيّة

243
00:17:53,910 --> 00:17:58,430
!صدقًا! لقد أصبت بفيروس قويّ

244
00:17:58,430 --> 00:18:02,470
لا أصدّق أنّ الإمبراطورة القرصانة المخيفة
!أصبحت عاشقة ولهانة

245
00:18:03,520 --> 00:18:07,560
لكن، لا بدّ أنّه كان كنملة صغيرة

246
00:18:07,560 --> 00:18:11,150
.أقحمت نفسها في عاصفة في إمبل داون ومقرّ البحريّة

247
00:18:11,150 --> 00:18:15,990
.لا بدّ أنّ الرّبّ أراده أن يعيش وأن يعود إلى هنا

248
00:18:15,990 --> 00:18:21,160
.أتساءل ماذا يتوقّع الرّبّ منه

249
00:18:22,490 --> 00:18:24,370
.أنت، ناولني المفتاح

250
00:18:24,370 --> 00:18:25,910
.حسنًا، خذ

251
00:18:25,910 --> 00:18:28,960
أنت، أتظنّ أنّ باستطاعتك إصلاح السّفينة؟

252
00:18:28,960 --> 00:18:33,210
،أجل، سأتدبّر أمري. على أيّ حال
أين ذهب قبّعة القشّ؟

253
00:18:33,210 --> 00:18:35,150
.جينبي غير موجود أيضًا

254
00:18:35,150 --> 00:18:37,120
.لا أدري

255
00:18:38,480 --> 00:18:41,670
سمعت أنّه إن دخل رجل

256
00:18:41,670 --> 00:18:44,090
جزيرة النّساء، سيتحوّل إلى حجر

257
00:18:44,090 --> 00:18:46,220
.لكن ربّما يستحقّ الأمر الموت

258
00:18:46,220 --> 00:18:51,520
.وفقًا لأفلاندرا-تشان، لم تكن كلّ النّساء في الميناء

259
00:18:51,520 --> 00:18:56,530
!جزيرة النّساء الّتي حلمت بها
!يا ليتني أستطيع النّظر داخلها

260
00:18:56,530 --> 00:18:58,650
.ستموت أيّها الغبيّ

261
00:18:58,650 --> 00:19:00,740
...أتساءل إن كان هناك إيناث دببة

262
00:19:00,740 --> 00:19:02,540
!إنّها جزيرة النّساء

263
00:19:02,540 --> 00:19:03,800
.آسف

264
00:19:03,800 --> 00:19:06,610
!البشر فقط! هناك بشر فقط

265
00:19:06,610 --> 00:19:08,640
!آسف حقًّا

266
00:19:52,600 --> 00:19:55,210
أين أنا؟

267
00:19:56,740 --> 00:20:00,010
...ربّما كان كلّ ذلك حلمًا

268
00:20:15,260 --> 00:20:18,860
...آسف يا لوفي

269
00:20:22,660 --> 00:20:25,840
.لم أستطع أن أدعك تنقذني

270
00:20:36,220 --> 00:20:39,250
!ابتعد! ابتعد

271
00:20:39,250 --> 00:20:40,630
!لوفي

272
00:20:41,880 --> 00:20:44,590
!لا

273
00:20:51,020 --> 00:20:55,700
!ابتعد! ابتعد

274
00:21:33,710 --> 00:21:36,440
...إلّم أنجُ من الموت

275
00:21:37,580 --> 00:21:42,230
آسف لكن هلاّ اعتنيت بأخي؟

276
00:21:44,620 --> 00:21:47,310
!انتهت الحرب

277
00:21:47,310 --> 00:21:48,820
...إيس-سان قد

278
00:21:49,130 --> 00:21:52,160
!لا تقلها! لا تقل أيّ شيء

279
00:21:53,530 --> 00:21:58,360
!قرصتُ نفسي بشدّة بالفعل حتّى مزّقتُ جلدي

280
00:22:01,030 --> 00:22:03,170
!لو كان حلمًا، ينبغي أن أكون قد استيقظت

281
00:22:05,660 --> 00:22:08,050
ليس حلمًا، أليس كذلك؟

282
00:22:16,890 --> 00:22:20,980
!إيس مات حقًّا، أليس كذلك؟

283
00:22:27,840 --> 00:22:30,590
!أجل، لقد مات

284
00:22:38,780 --> 00:22:42,020
أخبرني يا جدّي، من هو إيس؟

285
00:22:42,020 --> 00:22:44,630
...إيس هو

286
00:22:45,210 --> 00:22:49,380
!الشّخص الّذي سيصبح أخاك

287
00:22:50,340 --> 00:22:55,220
،لوفي. عندما نلتقي في المرّة القادمة
!سنكون كلانا في قمّة عالم القراصنة

288
00:22:55,680 --> 00:22:57,870
!لنتقابل في القمّة

289
00:23:13,740 --> 00:23:17,920
!إيس

290
00:23:25,320 --> 00:23:27,840
الحلقة القادمة عبارة عن عمل
!مشترك خاصّ مع توريكو

291
00:23:27,840 --> 00:23:29,590
!تلك الخنازير المشويّة مخيفة

292
00:23:29,590 --> 00:23:31,520
!لقد امتلأت بطني! كان ذلك لذيذًا

293
00:23:31,520 --> 00:23:33,820
!يبدو أنّ هناك الكثير من هذه الأشياء

294
00:23:33,820 --> 00:23:34,680
!حقًّا؟

295
00:23:34,680 --> 00:23:37,170
!هذا ما قاله توريكو! أريد الذّهاب إلى الدّيار

296
00:23:37,170 --> 00:23:39,100
!حسنًا! سنذهب مع توريكو

297
00:23:39,100 --> 00:23:40,310
!ماذا؟

298
00:23:40,310 --> 00:23:42,850
في الحلقة القادمة، حلقة توريكو
!ووان بيس المشتركة الخاصّة

299
00:23:42,850 --> 00:23:45,750
"!الفريق الأقوى! كفاح لوفي وتوريكو الشّاقّ"

300
00:23:45,750 --> 00:23:47,220
!لا تفوّتوه