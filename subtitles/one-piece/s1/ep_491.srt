1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,790 --> 00:00:53,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,290 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,030 --> 00:03:22,560
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:22,560 --> 00:03:27,730
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:27,730 --> 00:03:29,240
لكنّ كفاحه ذهب سدى

40
00:03:30,760 --> 00:03:37,290
.وحرب القمّة الأسطوريّة في مارينفورد انتهت

41
00:03:49,630 --> 00:03:53,810
"!الهبوط في جزيرة النّساء! يستوعب لوفي الواقع الأليم"

42
00:04:24,130 --> 00:04:26,370
!ثمّة سفينة تقترب من لاس كامب في الأزرق الغربيّ

43
00:04:26,370 --> 00:04:29,960
!لكنّ القواعد في تلك المنطقة لا تأوي سفنًا

44
00:04:29,960 --> 00:04:31,260
...القواعد الأقرب لتلك المنطقة هي

45
00:04:32,160 --> 00:04:34,640
!سترسل الوحدة الـ80 الدّعم

46
00:04:40,180 --> 00:04:41,190
!سحقًا

47
00:04:41,190 --> 00:04:47,780
ظننت أنّ القراصنة سيخافون منّا بعد
!قتلنا للّحية البيضاء وظفرنا بالنّصر

48
00:04:48,190 --> 00:04:52,130
،بدلاً من أن يتواروا عن الأنظار
!فهم يهيجون في كلّ مكان

49
00:04:52,130 --> 00:04:54,300
ماذا دهاهم؟

50
00:04:54,300 --> 00:04:56,910
!أغار القراصنة على لاس كامب

51
00:04:59,690 --> 00:05:02,000
!أكرّر، أرسلوا الدّعم إلى لاس كامب

52
00:05:04,130 --> 00:05:08,850
!حمّلوا المؤن! لنذهب إلى الغراند لاين

53
00:05:14,100 --> 00:05:17,130
،بعد أسبوعين من حرب القمّة

54
00:05:17,130 --> 00:05:21,020
.بدأ النّاس يرون آثارها في كلّ مكان

55
00:05:25,460 --> 00:05:29,150
!لـ-لا يمكنكم التّقدّم أكثر! لا تدخلوا بلدتنا

56
00:05:33,010 --> 00:05:35,530
سمعت الأخبار، أليس كذلك؟

57
00:05:39,860 --> 00:05:44,880
.إذًا تعلم أنّ هذه الجزيرة ما عادت تابعةً للّحية البيضاء

58
00:05:44,880 --> 00:05:47,960
!لا معنى من هذا الرّمز الآن

59
00:05:47,960 --> 00:05:51,800
!هذا صحيح! مات اللّحية البيضاء

60
00:06:09,000 --> 00:06:12,690
!اسمع، وضع هذا الكلام حلقة في أذنك

61
00:06:13,160 --> 00:06:19,530
من يسيطر على هذه الجزيرة اعتبارًا
!من اليوم هو أنا القرصان اللّحية البنّيّة

62
00:06:22,790 --> 00:06:27,290
.انتهت الحرب بموت اللّحية البيضاء وانتصار البحريّة

63
00:06:27,290 --> 00:06:30,020
،لكن على نقيض ما ظنّته البحريّة

64
00:06:30,020 --> 00:06:34,130
.صار الوضع متوتّرًا في كلّ أرجاء العالم

65
00:06:36,470 --> 00:06:38,390
،في نفس الأثناء، قبل وقت قصير

66
00:06:38,390 --> 00:06:41,150
قرّر كلّ من هانكوك وجينبي والبقيّة

67
00:06:41,150 --> 00:06:44,270
التّوجّه إلى جزيرة النّساء لإيواء لوفي الغائب عن الوعي

68
00:06:44,270 --> 00:06:47,980
.وانضمّوا إلى سفينة كوجا

69
00:06:47,980 --> 00:06:50,690
!أختي

70
00:06:50,690 --> 00:06:52,190
!أميرة الثّعابين-ساما

71
00:06:52,940 --> 00:06:58,110
!آسفة على إقلاقكنّ يا ساندرسونيا وماريغولد والبقيّة

72
00:06:59,280 --> 00:07:01,910
!شكرًا على ترحيبكنّ الحارّ

73
00:07:02,280 --> 00:07:07,580
!نحن جميعًا ممتنّات على عملك العظيم كشيتشيبوكاي

74
00:07:09,830 --> 00:07:15,630
.حسنًا، هنا ينتهي دوري في مساندة الفتى قبّعة القشّ

75
00:07:15,630 --> 00:07:17,630
!مرحى

76
00:07:17,630 --> 00:07:20,930
ألا بأس أن أترك الباقي لك يا جينبي؟

77
00:07:20,930 --> 00:07:24,220
.أجل. لا أستطيع السّباحة كما أريد بعد

78
00:07:24,220 --> 00:07:28,060
.أقلّ ما أستطيع فعله هو البقاء هنا إلى أن تتحسّن حالته

79
00:07:28,770 --> 00:07:32,370
.لكن لا أعرف كيف أستطيع مساعدته

80
00:07:33,400 --> 00:07:36,320
.كان لقاؤك منعطفًا غريبًا في القدر

81
00:07:36,320 --> 00:07:37,850
.أوافق

82
00:07:37,850 --> 00:07:40,020
مع أنّ كلينا كنّا محبوسين

83
00:07:40,020 --> 00:07:42,700
،في السّجن الأعظم في العالم، إمبل داون

84
00:07:42,980 --> 00:07:45,660
،فلولا لوفي-كن

85
00:07:45,660 --> 00:07:50,250
.لما كنّا التقينا بعضنا أبدًا على الإطلاق على ما أظنّ

86
00:07:50,710 --> 00:07:57,050
كلانا حاولنا بجدّ مجاراة الفتى قبّعة
القشّ في مارينفورد، أليس كذلك؟

87
00:07:57,510 --> 00:07:59,720
من الصّعب توديعكم

88
00:07:59,720 --> 00:08:04,550
.لكنّ أعزّائي الكاندي ينتظرون عودتي في المملكة

89
00:08:04,970 --> 00:08:08,480
!اعتنوا بالفتى قبّعة القشّ جيّدًا

90
00:08:12,900 --> 00:08:16,440
!الوداع يا قبّعة القشّ! شكرًا على تحريرنا

91
00:08:16,440 --> 00:08:20,280
!أستطيع تحقيق حلمي بسببك

92
00:08:20,280 --> 00:08:22,950
!ألقوا التّحيّة عليه عندما يستيقظ

93
00:08:22,950 --> 00:08:26,080
!لنلتق ثانيةً إن سنحت لنا الفرصة

94
00:08:26,080 --> 00:08:27,120
!تماسك

95
00:08:27,120 --> 00:08:30,080
!لا يمكنك أن تموت يا قبّعة القشّ

96
00:08:30,080 --> 00:08:32,880
!حسنًا، لنذهب

97
00:08:32,880 --> 00:08:37,380
!إلى موطن النيوكاما وقبلتنا

98
00:08:37,380 --> 00:08:41,380
!إلى مملكة ماكاباكا! مرحى

99
00:08:41,380 --> 00:08:45,220
.علينا التّوجّه إلى جزيرة النّساء أيضًا

100
00:08:46,430 --> 00:08:51,060
وهكذا وصلت سفينة القراصنة الّتي يركبها
،لوفي إلى جزيرة النّساء أمازون ليلي

101
00:08:51,060 --> 00:08:53,590
حيث تتواجد إمبراطوريّة النّساء المحرّمة على الرّجال

102
00:08:53,590 --> 00:08:57,130
.وحيث تعيش كوجا، قبيلة المحاربات

103
00:08:58,780 --> 00:09:01,490
!أميرة الثّعابين-ساما

104
00:09:01,490 --> 00:09:03,610
!مرحبًا بعودتك

105
00:09:07,740 --> 00:09:10,910
!أنا مسرورة حقًّا لأنّ الأميرة بأمان

106
00:09:10,910 --> 00:09:12,960
!هناك رجال في السّفينة الغريبة في الوراء

107
00:09:13,880 --> 00:09:16,170
!انظروا! لا يوجد فيها سوى النّساء

108
00:09:16,170 --> 00:09:18,750
!صحيح أنّها جزيرة النّساء فقط

109
00:09:18,750 --> 00:09:22,970
!تسلّلوا إلى السّفينة! هذا لا يغتفر

110
00:09:22,970 --> 00:09:23,470
!ا-انتظري

111
00:09:23,780 --> 00:09:25,470
!الرّائحة زكيّة

112
00:09:25,470 --> 00:09:27,600
!أشعر بالدّوار

113
00:09:27,600 --> 00:09:29,520
!لا بدّ أنّ هذه الجنّة

114
00:09:29,520 --> 00:09:31,100
.أنتم

115
00:09:31,560 --> 00:09:35,560
.عليكم أن تدخلوا، وإلاّ ستموتون

116
00:09:42,280 --> 00:09:45,660
!توقّفن! إنّهم ليسوا أعداءً

117
00:09:45,660 --> 00:09:46,660
!أميرة الثّعابين-ساما

118
00:09:46,660 --> 00:09:50,180
!لوفي في تلك السّفينة

119
00:09:50,180 --> 00:09:53,500
،تكبّد أضرارًا جسيمة، ذهنيًّا وجسديًّا
أثناء المعركة في مارينفورد

120
00:09:53,500 --> 00:09:56,830
.وهو يصارع للبقاء على الحياة الآن

121
00:09:56,830 --> 00:09:58,540
!لوفي هنا؟

122
00:09:58,540 --> 00:10:02,920
!يا آنسات، احملن لوفي إلى قلعة كوجا في أسرع وقت

123
00:10:03,590 --> 00:10:06,180
...سأعتني بلوفي

124
00:10:06,180 --> 00:10:08,100
!انتظري لحظة يا أميرة الثّعابين

125
00:10:10,100 --> 00:10:11,470
!الجدّة نيون

126
00:10:11,470 --> 00:10:13,560
.لا بأس بلوفي فقط

127
00:10:13,560 --> 00:10:16,230
لكن لا يمكننا أن نسمح لأولئك الرّجال
على تلك السّفينة الغريبة

128
00:10:16,230 --> 00:10:18,520
.أن يدخلوا جزيرة النّساء

129
00:10:18,520 --> 00:10:21,900
!هذا ضدّ سياسة بلادنا

130
00:10:21,900 --> 00:10:25,950
...إذًا، لنسمح للطّبيب فقط بأن يأتي معه كي

131
00:10:25,950 --> 00:10:27,190
!لا

132
00:10:27,190 --> 00:10:31,650
لا يمكننا أن نسمح لأيّ رجل بدخول
!الجزيرة، حتّى إن كان طبيبًا

133
00:10:32,240 --> 00:10:35,790
!لدينا الكثير من الطّبيبات البارعات في هذه الجزيرة

134
00:10:36,510 --> 00:10:39,170
...لا أهتمّ على أيّ حال، ولكن

135
00:10:39,620 --> 00:10:44,720
هل لديكنّ نفس المعدّات الطّبّيّة
والتّقنيات كما في سفينتي؟

136
00:10:47,130 --> 00:10:50,390
.إن فُتح جرحه ثانيةً، سيموت

137
00:10:50,800 --> 00:10:53,810
.خذن قبّعة القشّ-يا إن كنتنّ لا تكترثن لذلك

138
00:10:53,810 --> 00:10:55,790
!لوفي سيموت؟

139
00:10:55,790 --> 00:11:00,360
...إن حدث ذلك... أنا... أنا سوف

140
00:11:00,360 --> 00:11:05,490
من الواضح أنّنا لا نستطيع إنقاذ
.لوفي-كن دون هذا الرّجل

141
00:11:05,490 --> 00:11:08,580
.إن كان لا يستطيع الدّخول فلا خيار لدينا

142
00:11:08,580 --> 00:11:10,340
.علينا الذّهاب لمكان آخر

143
00:11:10,340 --> 00:11:13,410
!مستحيل! سنُهاجم من قبل ملوك البحر

144
00:11:13,830 --> 00:11:18,370
!وحتّى إن هربنا منها، ستجدنا البحريّة في أيّ لحظة

145
00:11:18,720 --> 00:11:21,380
!ما العمل؟

146
00:11:21,380 --> 00:11:25,460
...لنرَ... سنفعل هذا كاستثناء فقط ولكن

147
00:11:26,720 --> 00:11:29,430
.يمكنكم البقاء في منطقة الخليج

148
00:11:29,430 --> 00:11:33,390
.لن تهاجمكم ملوك البحر هناك

149
00:11:33,880 --> 00:11:37,100
...إذًا، سأظلّ معهم للاعتناء بلوفي

150
00:11:37,100 --> 00:11:38,520
!لا

151
00:11:39,040 --> 00:11:43,320
!سحقًا لك أيّتها الجدّة نيون
!تواصلين قول "لا" في وجهي

152
00:11:43,320 --> 00:11:46,690
!لوفي! آمل أن تتحسّن قريبًا

153
00:11:47,130 --> 00:11:49,540
،هذا فصل "بالنّظر إلى أميرة الثّعابين-ساما

154
00:11:49,540 --> 00:11:52,410
."بإمكاني أن أعرف أنّ لوفي في حالة حرجة

155
00:11:53,780 --> 00:11:55,330
...لوفي

156
00:11:56,410 --> 00:11:58,330
.مضى أسبوعان

157
00:11:58,330 --> 00:12:01,290
...لو والبقيّة يمكثون في الخليج

158
00:12:01,290 --> 00:12:04,170
.لتوفير العلاج للوفي

159
00:12:06,170 --> 00:12:09,590
...إلى متى علينا البقاء في مثل هذا المكان الصّغير

160
00:12:09,590 --> 00:12:13,060
...أجل، المكان الوحيد الّذي نتطلّع له هو

161
00:12:13,060 --> 00:12:14,850
!رفاق، آسفة على التّأخّر

162
00:12:14,850 --> 00:12:16,430
."هذا فصل "إنّه وقت الأكل

163
00:12:16,430 --> 00:12:18,140
!أخيرًا

164
00:12:18,140 --> 00:12:19,350
.تفضّلوا

165
00:12:19,350 --> 00:12:22,570
!عزاؤنا الوحيد هو أنّ الطّعام لذيذ

166
00:12:22,570 --> 00:12:23,230
!أوافق

167
00:12:23,230 --> 00:12:25,150
!تفضّلوا

168
00:12:25,150 --> 00:12:25,780
...شكرًا

169
00:12:25,780 --> 00:12:30,200
.لا تتدافعوا رجاءً وانتظروا أدواركم

170
00:12:30,200 --> 00:12:32,160
!أفلاندرا

171
00:12:32,550 --> 00:12:34,750
!لا تحدّثي الرّجال

172
00:12:34,750 --> 00:12:38,370
.لوفي هو الاستثناء لأنّها أوامر أميرة الثّعابين-ساما

173
00:12:38,370 --> 00:12:40,000
!لا تنسي

174
00:12:40,000 --> 00:12:41,420
!حسنًا

175
00:12:41,420 --> 00:12:45,610
!بربّك، ليس بالأمر الجلل
أليس كذلك يا أفلاندرا-تشان؟

176
00:12:50,370 --> 00:12:52,640
!لن أكرّر كلامي

177
00:12:52,640 --> 00:12:55,350
!نحن آسفون

178
00:12:58,090 --> 00:12:59,230
.المعذرة

179
00:13:00,490 --> 00:13:02,230
هل أفاق لوفي؟

180
00:13:04,690 --> 00:13:05,940
.فهمت

181
00:13:05,940 --> 00:13:08,940
.الأمر راجع لروح قبّعة القشّ-يا المعنويّة

182
00:13:09,310 --> 00:13:13,320
.ما إن كان يريد العيش أم لا

183
00:13:13,320 --> 00:13:15,410
!مارغريت، هيّا بسرعة

184
00:13:15,410 --> 00:13:16,580
!أنا قادمة

185
00:13:16,580 --> 00:13:19,910
!آسفة! اعتن جيّدًا بلوفي

186
00:13:20,160 --> 00:13:24,830
!مارغريت، كم مرّة يجب أن أخبرك ألاّ تحدّثيهم؟

187
00:13:24,830 --> 00:13:26,200
!آسفة

188
00:13:40,140 --> 00:13:41,680
...أختي

189
00:13:47,610 --> 00:13:48,610
...لوفي

190
00:13:54,960 --> 00:13:59,080
!لطالما كنت هكذا يا لوفي

191
00:13:59,410 --> 00:14:01,910
...لم تصغ إليّ قطّ

192
00:14:02,400 --> 00:14:05,420
!ودائمًا ما فعلتَ أشياء جنونيّة

193
00:14:12,630 --> 00:14:14,160
...توقّف

194
00:14:14,160 --> 00:14:15,840
!توقّف

195
00:14:21,600 --> 00:14:23,190
!توقّف يا قبّعة القشّ

196
00:14:23,190 --> 00:14:25,500
!أتريد تدمير السّفينة؟

197
00:14:32,150 --> 00:14:34,030
...إيس

198
00:14:45,830 --> 00:14:47,260
!لوفي-كن

199
00:14:53,710 --> 00:14:57,640
...إيس

200
00:15:00,430 --> 00:15:05,020
!أين هو إيس؟

201
00:15:32,670 --> 00:15:36,160
!هذا خطير! اهدأ يا قبّعة القشّ

202
00:15:36,160 --> 00:15:38,470
ماذا سيحدث إن تركناه هكذا؟

203
00:15:39,200 --> 00:15:44,260
،الأمر بسيط. كما قلت عندما وصلنا إلى هنا

204
00:15:44,260 --> 00:15:48,090
.إن فُتح جرحه ثانيةً، سيموت

205
00:15:50,730 --> 00:15:52,920
!أجل، هذه هي فرصتنا

206
00:15:53,440 --> 00:15:55,610
!ابتعدوا عنّي، سحقًا

207
00:15:55,610 --> 00:15:57,030
!اثبت يا قبّعة القشّ

208
00:15:57,030 --> 00:15:59,870
!اخرس! إنّي أبحث عن إيس

209
00:15:59,870 --> 00:16:01,490
...لكنّي أخبرتك أنّ قبضة النّار قد

210
00:16:01,490 --> 00:16:03,830
"!قلت "ابتعدوا عنّي

211
00:16:05,450 --> 00:16:07,750
!أين هو إيس؟

212
00:16:08,070 --> 00:16:10,280
!إيس

213
00:16:10,290 --> 00:16:12,460
!سحقًا! فقد السّيطرة على نفسه

214
00:16:12,460 --> 00:16:13,880
!إنّه لوفي

215
00:16:13,880 --> 00:16:16,090
!علينا إخبار أميرة الثّعابين-ساما

216
00:16:16,500 --> 00:16:20,760
!أميرة الثّعابين-ساما! أميرة الثّعابين-ساما

217
00:16:21,120 --> 00:16:23,140
!استيقظ لوفي

218
00:16:23,140 --> 00:16:24,600
!لوفي-ساما؟

219
00:16:24,600 --> 00:16:25,850
!حقًّا؟

220
00:16:25,850 --> 00:16:28,730
!حمدًا لهذا. أريد أن أراه على الفور

221
00:16:28,730 --> 00:16:30,560
!لا يمكنك ذلك يا أميرة الثّعابين

222
00:16:30,560 --> 00:16:33,520
.يريد الجميع رؤيته

223
00:16:33,520 --> 00:16:37,740
.لا يمكنك ضبط شعبك إن سمحت لنفسك بالذّهب لرؤيته

224
00:16:38,420 --> 00:16:41,110
.فهذه الجزيرة محرّمة على الرّجال

225
00:16:41,110 --> 00:16:45,720
تركنا رجالاً غرباء يظلّون في منطقة الخليج

226
00:16:45,720 --> 00:16:49,250
!وهذا استثناء أكثر من كاف بالنّسبة لنا

227
00:16:49,250 --> 00:16:51,220
...أدري، لكن

228
00:16:51,220 --> 00:16:53,890
.قبل ذلك يا أختي، عليك أن تأكلي شيئًا

229
00:16:53,890 --> 00:16:58,880
!معها حقّ يا أختي! بالكاد أكلت شيئًا مذ رجعت

230
00:16:58,880 --> 00:17:02,380
!هذا صحيح! لا بدّ أنّ لوفي جائع جدًّا أيضًا

231
00:17:02,380 --> 00:17:05,640
!حضّرن الكثير من الأطباق العظيمة الّتي ستمدّه بالطّاقة

232
00:17:05,640 --> 00:17:07,390
!حسنًا، من دواعي سرورنا

233
00:17:07,390 --> 00:17:11,810
!سأساعدكنّ! لنفعل ذلك الآن يا آنسات

234
00:17:11,810 --> 00:17:13,900
!حاضر يا أميرة الثّعابين-ساما

235
00:17:13,900 --> 00:17:18,730
.عليّ أن أدعها تفعل ذلك فحسب
...تريد فقط أن تحضّر بعض الأقلّ

236
00:17:18,730 --> 00:17:21,860
!ثمّ سآخذها إليه

237
00:17:21,860 --> 00:17:23,410
!ستذهبين إذًا؟

238
00:17:23,410 --> 00:17:29,330
.وعدنا بأن ندعو لوفي لوحده عندما يتعافى

239
00:17:29,330 --> 00:17:31,080
!انتظري تلك اللّحظة

240
00:17:31,080 --> 00:17:34,710
!لا أستطيع! أنا الإمبراطورة! لا تملي عليّ ما أفعل

241
00:17:34,710 --> 00:17:35,870
!قلت لا

242
00:17:35,870 --> 00:17:39,090
!الشّيء الأهمّ هي سياسة هذه البلاد الوراثيّة

243
00:17:39,910 --> 00:17:44,430
!صدقًا! لقد أصبت بفيروس قويّ

244
00:17:44,430 --> 00:17:48,470
لا أصدّق أنّ الإمبراطورة القرصانة المخيفة
!أصبحت عاشقة ولهانة

245
00:17:49,520 --> 00:17:53,560
لكن، لا بدّ أنّه كان كنملة صغيرة

246
00:17:53,560 --> 00:17:57,150
.أقحمت نفسها في عاصفة في إمبل داون ومقرّ البحريّة

247
00:17:57,150 --> 00:18:01,990
.لا بدّ أنّ الرّبّ أراده أن يعيش وأن يعود إلى هنا

248
00:18:01,990 --> 00:18:07,160
.أتساءل ماذا يتوقّع الرّبّ منه

249
00:18:08,490 --> 00:18:10,370
.أنت، ناولني المفتاح

250
00:18:10,370 --> 00:18:11,910
.حسنًا، خذ

251
00:18:11,910 --> 00:18:14,960
أنت، أتظنّ أنّ باستطاعتك إصلاح السّفينة؟

252
00:18:14,960 --> 00:18:19,210
،أجل، سأتدبّر أمري. على أيّ حال
أين ذهب قبّعة القشّ؟

253
00:18:19,210 --> 00:18:21,150
.جينبي غير موجود أيضًا

254
00:18:21,150 --> 00:18:23,120
.لا أدري

255
00:18:24,480 --> 00:18:27,670
سمعت أنّه إن دخل رجل

256
00:18:27,670 --> 00:18:30,090
جزيرة النّساء، سيتحوّل إلى حجر

257
00:18:30,090 --> 00:18:32,220
.لكن ربّما يستحقّ الأمر الموت

258
00:18:32,220 --> 00:18:37,520
.وفقًا لأفلاندرا-تشان، لم تكن كلّ النّساء في الميناء

259
00:18:37,520 --> 00:18:42,530
!جزيرة النّساء الّتي حلمت بها
!يا ليتني أستطيع النّظر داخلها

260
00:18:42,530 --> 00:18:44,650
.ستموت أيّها الغبيّ

261
00:18:44,650 --> 00:18:46,740
...أتساءل إن كان هناك إيناث دببة

262
00:18:46,740 --> 00:18:48,540
!إنّها جزيرة النّساء

263
00:18:48,540 --> 00:18:49,800
.آسف

264
00:18:49,800 --> 00:18:52,610
!البشر فقط! هناك بشر فقط

265
00:18:52,610 --> 00:18:54,640
!آسف حقًّا

266
00:19:38,600 --> 00:19:41,210
أين أنا؟

267
00:19:42,740 --> 00:19:46,010
...ربّما كان كلّ ذلك حلمًا

268
00:20:01,260 --> 00:20:04,860
...آسف يا لوفي

269
00:20:08,660 --> 00:20:11,840
.لم أستطع أن أدعك تنقذني

270
00:20:22,220 --> 00:20:25,250
!ابتعد! ابتعد

271
00:20:25,250 --> 00:20:26,630
!لوفي

272
00:20:27,880 --> 00:20:30,590
!لا

273
00:20:37,020 --> 00:20:41,700
!ابتعد! ابتعد

274
00:21:19,710 --> 00:21:22,440
...إلّم أنجُ من الموت

275
00:21:23,580 --> 00:21:28,230
آسف لكن هلاّ اعتنيت بأخي؟

276
00:21:30,620 --> 00:21:33,310
!انتهت الحرب

277
00:21:33,310 --> 00:21:34,820
...إيس-سان قد

278
00:21:35,130 --> 00:21:38,160
!لا تقلها! لا تقل أيّ شيء

279
00:21:39,530 --> 00:21:44,360
!قرصتُ نفسي بشدّة بالفعل حتّى مزّقتُ جلدي

280
00:21:47,030 --> 00:21:49,170
!لو كان حلمًا، ينبغي أن أكون قد استيقظت

281
00:21:51,660 --> 00:21:54,050
ليس حلمًا، أليس كذلك؟

282
00:22:02,890 --> 00:22:06,980
!إيس مات حقًّا، أليس كذلك؟

283
00:22:13,840 --> 00:22:16,590
!أجل، لقد مات

284
00:22:24,780 --> 00:22:28,020
أخبرني يا جدّي، من هو إيس؟

285
00:22:28,020 --> 00:22:30,630
...إيس هو

286
00:22:31,210 --> 00:22:35,380
!الشّخص الّذي سيصبح أخاك

287
00:22:36,340 --> 00:22:41,220
،لوفي. عندما نلتقي في المرّة القادمة
!سنكون كلانا في قمّة عالم القراصنة

288
00:22:41,680 --> 00:22:43,870
!لنتقابل في القمّة

289
00:22:59,740 --> 00:23:03,920
!إيس

290
00:23:11,320 --> 00:23:13,840
الحلقة القادمة عبارة عن عمل
!مشترك خاصّ مع توريكو

291
00:23:13,840 --> 00:23:15,590
!تلك الخنازير المشويّة مخيفة

292
00:23:15,590 --> 00:23:17,520
!لقد امتلأت بطني! كان ذلك لذيذًا

293
00:23:17,520 --> 00:23:19,820
!يبدو أنّ هناك الكثير من هذه الأشياء

294
00:23:19,820 --> 00:23:20,680
!حقًّا؟

295
00:23:20,680 --> 00:23:23,170
!هذا ما قاله توريكو! أريد الذّهاب إلى الدّيار

296
00:23:23,170 --> 00:23:25,100
!حسنًا! سنذهب مع توريكو

297
00:23:25,100 --> 00:23:26,310
!ماذا؟

298
00:23:26,310 --> 00:23:28,850
في الحلقة القادمة، حلقة توريكو
!ووان بيس المشتركة الخاصّة

299
00:23:28,850 --> 00:23:31,750
"!الفريق الأقوى! كفاح لوفي وتوريكو الشّاقّ"

300
00:23:31,750 --> 00:23:33,220
!لا تفوّتوه