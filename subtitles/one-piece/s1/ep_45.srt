1
00:00:02,700 --> 00:00:04,540
...الثّروة والشّهرة والسّلطة

2
00:00:04,840 --> 00:00:06,710
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:06,710 --> 00:00:08,610
.ملك القراصنة، غولد روجر

4
00:00:09,010 --> 00:00:12,780
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:12,780 --> 00:00:16,380
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:16,650 --> 00:00:20,250
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:22,860 --> 00:00:26,930
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:27,560 --> 00:00:30,500
!دخل العالم في عصر قراصنة عظيم

9
00:00:31,400 --> 00:00:36,000
سنجمع كل أحلامنا

10
00:00:37,000 --> 00:00:42,440
ونبحر باحثين عن شيء، باحثين عن

11
00:00:42,840 --> 00:00:48,480
!ون بيس

12
00:00:48,980 --> 00:00:53,820
لا تجلب البوصلات سوى التّأخيرات

13
00:00:54,650 --> 00:00:59,260
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:00,360 --> 00:01:05,330
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:05,660 --> 00:01:11,200
!فإنّها ليست أسطورة إذًا

16
00:01:12,400 --> 00:01:18,080
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:18,140 --> 00:01:22,980
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:23,280 --> 00:01:25,880
!وتظاهر أنّها غير موجودة

19
00:01:26,850 --> 00:01:31,720
سنجمع كلّ أحلامنا

20
00:01:32,720 --> 00:01:37,900
ونبحر باحثين عن شيء

21
00:01:38,230 --> 00:01:41,130
،عملة في جيبي

22
00:01:41,230 --> 00:01:44,400
وتريد أن تصبح صديقي؟

23
00:01:44,500 --> 00:01:49,010
!إنّنا، إنّنا في رحلة بحريّة

24
00:01:49,870 --> 00:01:51,040
!إننا كذلك

25
00:02:01,990 --> 00:02:05,090
!ألا تظنّ أنّ أسعارك مبالغ فيها؟

26
00:02:15,000 --> 00:02:17,530
.ما المشكلة؟ إنّها مجرّد ورقة أو ورقتين

27
00:02:17,530 --> 00:02:20,070
!ليس عندما تشتريها كلّ يوم

28
00:02:20,640 --> 00:02:22,770
لم تعودي بحاجةٍ لتوفير المال

29
00:02:22,770 --> 00:02:26,240
.لشراء قريتك من أرلونغ كما تعلمين

30
00:02:26,240 --> 00:02:28,680
.ولا أن تكوني مهووسةً به

31
00:02:28,680 --> 00:02:29,880
!أنت غبيّ حقًّا

32
00:02:29,880 --> 00:02:35,080
،بعد أن انتهى كلّ شيء
!سأجمع المال لنفسي الآن

33
00:02:35,320 --> 00:02:39,290
لا أريد أن أكون قرصانة فقيرة
!لا تستطيع حتّى توفير تكاليف لباسها

34
00:02:39,290 --> 00:02:41,460
!اهدئي

35
00:02:41,460 --> 00:02:44,490
أنا في خضمّ تطوير تقنية
!نجم الصلصة الحارّة الخاصّة

36
00:02:47,660 --> 00:02:51,400
طلقة من هذه على العين
...ستجعل أيّ شرّير

37
00:02:55,400 --> 00:02:58,110
!بربّك! واحدة فحسب

38
00:02:55,400 --> 00:02:58,110
!ماء! ماء! ماء

39
00:02:58,110 --> 00:02:59,270
!لا

40
00:02:59,540 --> 00:03:01,840
!هذا بستان اليوسفيّ الخاصّ بنامي-سان

41
00:03:02,110 --> 00:03:04,410
!لن أدع أيّ أحد يلمسه

42
00:03:05,050 --> 00:03:08,220
!نامي-سان! حماية حبّك معصومة

43
00:03:08,220 --> 00:03:10,250
.نعم. شكرًا يا سانجي-كن

44
00:03:10,790 --> 00:03:14,320
سانجي ذاك يسمح
...لها باستغلاله

45
00:03:16,790 --> 00:03:20,430
!بربّك! أعطني ثمرة يوسفيّ واحدة فحسب

46
00:03:20,660 --> 00:03:21,960
!يا لك من بخيل يا سانجي

47
00:03:21,960 --> 00:03:23,300
!لا

48
00:03:24,430 --> 00:03:27,400
!لا يهمّ! أنا سعيد الآن على أيّ حال

49
00:03:29,940 --> 00:03:34,340
.العالم مضطرب بالفعل
...ثمّة انقلاب آخر في فيرا

50
00:03:37,040 --> 00:03:38,080
منشور؟

51
00:03:52,730 --> 00:03:57,200
مكافأة! يصبح قبّعة القّشّ"
".لوفي معروفًا لدى العالم

52
00:04:22,090 --> 00:04:28,230
إذًا على الأقل، لم تعد شُعبنا
تقوى على التّكفّل بهم؟

53
00:04:28,760 --> 00:04:32,030
نعم. حتّى قبل أن ينشئ
،طاقم القراصنة خاصّته

54
00:04:32,030 --> 00:04:35,930
،هزم قائد شعبة البحريّة
،يد الفأس مورغان

55
00:04:36,200 --> 00:04:39,340
.ولم يظهر أيّ تردّد في فعل ذلك

56
00:04:40,040 --> 00:04:42,540
.باغي المهرّج، 15 مليونًا

57
00:04:42,540 --> 00:04:45,940
عميد أسطول القراصنة
.الدّون كريغ. 17 مليونًا

58
00:04:45,940 --> 00:04:49,380
،القرصان البرمائيّ
.أسنان المنشار أرلونغ. 20 مليونًا

59
00:04:50,250 --> 00:04:54,190
تجاوز كلّ من هؤلاء القراصنة
الكبار مكافأة الـ10 مليون بيري

60
00:04:54,390 --> 00:04:58,620
في الأزرق الشّرقيّ، حيث متوسّط
...المكافآت هو ثلاثة ملايين بيري

61
00:04:58,620 --> 00:04:59,660
.لكنّهم أطاحوا بهم جميعًا

62
00:05:00,960 --> 00:05:05,330
لم يسبق عالميًّا وضع
،‫30 مليونًا كأوّل مكافأة

63
00:05:05,560 --> 00:05:07,870
.لكنّه ليس ثمنًا عاليًا بإسراف

64
00:05:08,130 --> 00:05:10,870
،لعلّ من الأفضل استئصال بذور الرّذالة مبكّرًا

65
00:05:10,870 --> 00:05:13,070
قبل أن تسنح لهم الفرصة
!للخروج عن السّيطرة

66
00:05:15,840 --> 00:05:17,240
.تمامًا

67
00:05:37,760 --> 00:05:40,730
!إن كان أحدكم يريد الهرب، فليفعل الآن

68
00:05:41,030 --> 00:05:45,770
لن يتهاون حصن السّلام مع
!أيّ ضعف في عصر القراصنة هذا

69
00:05:46,540 --> 00:05:50,840
!ضعف وعجز العامّة ليس خطيئة
!العدالة بجانبنا

70
00:05:51,040 --> 00:05:53,310
،إن كان هنالك شرّ عنيد في البحار

71
00:05:53,480 --> 00:05:58,550
!فعلينا نحن، البحريّة دحره بأقصى قوّة

72
00:05:59,210 --> 00:06:02,480
!باسم العدالة المطلقة

73
00:06:04,020 --> 00:06:05,550
!حاضر

74
00:06:10,930 --> 00:06:12,760
!آنستي

75
00:06:15,330 --> 00:06:16,900
!يا آنسة كايا

76
00:06:19,670 --> 00:06:20,740
!آنستي

77
00:06:21,000 --> 00:06:22,670
!ما الخطب يا ميري؟

78
00:06:22,670 --> 00:06:24,540
!ألقي نظرة على هذه

79
00:06:27,710 --> 00:06:28,940
!أوسوبّ-سان

80
00:06:31,080 --> 00:06:34,620
!ذلك ظهر أوسوبّ-سان بالتّأكيد

81
00:06:35,320 --> 00:06:38,020
...على ذكر الأمر، أنت محقّة

82
00:06:46,430 --> 00:06:50,930
!أهلاً! تبدين بحال أفضل بكثير يا كايا

83
00:06:51,470 --> 00:06:53,670
أيّ قصّة أرويها لك اليوم؟

84
00:06:54,630 --> 00:06:58,240
!يسعى أوسوبّ-سان لتحقيق حلمه

85
00:07:05,280 --> 00:07:11,080
وأنا أسعى لتحقيق حلمي
!لأصبح طبيبةً تساعد النّاس أيضًا

86
00:07:11,080 --> 00:07:13,650
،أنا واثقة أنّه يومًا ما وفي مكانٍ ما

87
00:07:13,650 --> 00:07:17,490
!سيتحقّق كلّ من حلمي وحلم أوسوبّ-سان

88
00:07:32,240 --> 00:07:35,570
!أخيرًا... أخيرًا... أخيرًا

89
00:07:35,740 --> 00:07:39,410
!لوفي-سان! وطأت نحو تحقيق حلمك أخيرًا

90
00:07:40,750 --> 00:07:44,580
!أنا لوفي! الرّجل الّذي سيصبح ملك القراصنة

91
00:07:48,150 --> 00:07:50,920
!إلى اللّقاء

92
00:07:51,390 --> 00:07:56,060
،لكن عندما نلتقي ثانيةً
!قد نكون أعداء

93
00:08:18,280 --> 00:08:19,880
!أيّها القائد

94
00:08:57,390 --> 00:08:59,790
!أنا من سيصبح ملك القراصنة

95
00:09:00,360 --> 00:09:03,630
.لكلينا أحلام سخيفة

96
00:09:05,130 --> 00:09:07,400
.أفعل هذا لتحقيق هدفي

97
00:09:25,550 --> 00:09:29,280
بالمناسبة... هل تعرف أول بلو؟

98
00:09:30,850 --> 00:09:34,720
شكرًا على كلّ شيء لعين فعلته
!من أجلي طوال هذه السّنوات

99
00:09:53,670 --> 00:09:56,280
!نحن مجرمون مطلوبون الآن

100
00:09:56,740 --> 00:10:01,650
!حيًّا أو ميّتًا؟ 30 مليون بيري؟

101
00:10:01,980 --> 00:10:04,080
!تقول أنّ مكافأتي 30 مليون بيري

102
00:10:05,690 --> 00:10:09,760
!انظروا! سيراني العالم أجمع
!قد يقعن الفتيات في حبّي

103
00:10:09,760 --> 00:10:13,360
ماذا؟! أضافوا صاحب
!الأنف الطّويل واستثنوني؟

104
00:10:14,860 --> 00:10:17,760
!أين أنت؟! لا أراك في أيّ مكان

105
00:10:17,760 --> 00:10:19,230
!انظر

106
00:10:20,730 --> 00:10:23,940
.إنّها مؤخّرة رأسك فحسب
.لا شيء يدعو للتّفاخر

107
00:10:23,940 --> 00:10:25,570
!لا تكتئب هكذا

108
00:10:25,570 --> 00:10:29,240
يمكنك الحصول على مكافأة دون حاجةٍ
!لتكون قائدًا إن أصبحتَ مهمًّا أكثر

109
00:10:29,240 --> 00:10:30,140
!حقًّا؟

110
00:10:30,140 --> 00:10:32,210
!واصل المحاولة بجدّ فحسب

111
00:10:34,480 --> 00:10:37,580
!دعونا نعجّل إلى الغراند لاين يا رجال

112
00:10:38,380 --> 00:10:42,920
!أنتم لا تفهمون خطورة الوضع ثانية

113
00:10:43,320 --> 00:10:46,430
!هذا يعني أنّ حياتنا في خطر الآن

114
00:10:47,290 --> 00:10:51,560
هذا ليس الوقت المناسب للتريّث
...والاسترخاء في الأزرق الشّرقيّ

115
00:10:55,700 --> 00:10:57,470
...‫30 مليون بيري

116
00:10:58,000 --> 00:11:00,610
بذلك القدر، أراهن أنّ مقرّ
،البحريّة سيتحرّك

117
00:11:00,610 --> 00:11:03,340
...ولن يدعنا صائدو المكافآت وشأننا

118
00:11:04,440 --> 00:11:07,410
سيكونون في مستوى مختلف
!عن أيٍّ ممّن واجهناه حتّى الآن

119
00:11:08,310 --> 00:11:11,980
!هيّا بنا! هيّا بنا! إلى الغراند لاين

120
00:11:57,360 --> 00:12:01,430
...سحقًا... الشّراب الرّخيص يمرض معدتي

121
00:12:02,370 --> 00:12:04,130
كم أحنّ إلى تلك الأيّام

122
00:12:04,400 --> 00:12:08,000
حينما كنتُ محاطًا بالنّساء
...الحسناوات والنّبيذ الفاخر

123
00:12:15,780 --> 00:12:21,420
تغيّر قدري تمامًا بعد لقائي
...الوحيد مع ذلك النّادل النّذل

124
00:12:21,650 --> 00:12:27,460
خسرتُ رتبتي كملازم بحريّ
بعد تشويهي لاسم البحريّة

125
00:12:27,460 --> 00:12:31,490
كما جعلوني مسؤولاً عن هذه
...الخردة في مكانٍ معدوم

126
00:12:34,300 --> 00:12:35,900
!ملازم البحريّة السّابق فولبودي

127
00:12:36,560 --> 00:12:38,300
!ماذا تريد؟! أنت مزعج

128
00:12:38,300 --> 00:12:40,540
!أ-أملك ملصق مطلوبين جديد

129
00:12:40,540 --> 00:12:43,170
.ضعه هناك فحسب

130
00:12:43,170 --> 00:12:46,610
،أشكّ أنّه يعني لنا أيّ شيء
...بما أنّنا في أقاصي الـ

131
00:12:49,040 --> 00:12:52,180
...هذا الوجه... رأيته في مكانٍ ما من قبل

132
00:12:52,610 --> 00:12:54,250
.لم أرَ ذلك العلم من قبل

133
00:12:56,780 --> 00:13:01,360
،أنا فولبودي ذو القبضة الحديديّة
!ملازم في البحريّة

134
00:13:01,760 --> 00:13:04,120
!من هو قائدكم؟! أعلن عن اسمك

135
00:13:04,430 --> 00:13:05,930
!أنا لوفي

136
00:13:06,230 --> 00:13:08,130
!وأنا أوسوبّ

137
00:13:09,000 --> 00:13:11,630
!صادف وأن صنعنا علم قراصنتنا قبل يومين

138
00:13:12,230 --> 00:13:14,530
!أجل! إنّه هو

139
00:13:14,530 --> 00:13:15,740
!شكرًا لك

140
00:13:15,740 --> 00:13:19,610
وهبني الرّب الفرصة للخروج
!من هذه الحفرة الجحيميّة المملّة

141
00:13:20,170 --> 00:13:22,940
!بإمكاني القبض على ذلك الشّقيّ بسهولة

142
00:13:23,380 --> 00:13:28,050
وسأستغلّ ذلك الإنجاز لأستعيد
!منصبي كملازم بحريّة ثانية

143
00:13:28,850 --> 00:13:30,320
!اصطفّوا

144
00:13:40,430 --> 00:13:42,530
!يا رجال! إنّنا ذاهبون إلى القتال

145
00:13:43,760 --> 00:13:46,870
القتال؟ أين سنفعل ذلك؟

146
00:13:47,330 --> 00:13:51,700
فـ-فلنرَ... في مطعم البحر على ما أظنّ؟

147
00:13:52,070 --> 00:13:53,770
!مطعم

148
00:13:53,770 --> 00:13:55,170
!ممتاز! وليمة كبيرة

149
00:13:55,170 --> 00:13:56,740
!على حساب القائد

150
00:13:56,740 --> 00:13:58,240
!حقًّا؟

151
00:13:58,240 --> 00:13:59,340
!لا، أسأتم الفهم

152
00:13:58,240 --> 00:14:00,050
!مرحى! مرحى

153
00:14:08,320 --> 00:14:09,720
...كانت تلك

154
00:14:10,420 --> 00:14:14,460
!التفّوا يسارًا! عدوّنا أمامنا مباشرةً

155
00:14:17,600 --> 00:14:21,900
هل تظنّ أنّ قراصنةً هاجموها؟
...تلك سفينة خردة

156
00:14:22,070 --> 00:14:26,100
ليس من الجيّد على البحريّة أن
...ترمي سفن خردتها في المحيط

157
00:14:26,900 --> 00:14:30,940
!هذه ليست سفينة خردة
!هل أنتما أعميان؟

158
00:14:30,940 --> 00:14:34,210
هل نسيتما كيف يبدو
!فولبودي ذو القبضة الحديديّة؟

159
00:14:34,210 --> 00:14:37,150
أنت ذاك الشّخص من
!البحريّة الّذي التقيناه سابقًا

160
00:14:37,150 --> 00:14:39,380
هل أنت عالق؟ أتريدنا أن نساعدك؟

161
00:14:40,280 --> 00:14:44,420
!كفّ عن العبث
!لقاءنا هذا يعني نفاد حظّك

162
00:14:44,420 --> 00:14:47,360
!مونكي د. لوفي! أنت رهن الاعتقال

163
00:14:47,520 --> 00:14:50,190
!نعم! إنّها صورة جيّدة لي، صحيح؟

164
00:14:50,190 --> 00:14:51,930
!ولمؤخّرة رأسي

165
00:14:53,300 --> 00:14:57,070
..."مذكور هنا "حيًّا أو ميّتًا

166
00:14:57,270 --> 00:14:58,400
!وجّهوا برج المدفع

167
00:15:01,840 --> 00:15:04,270
ما كلّ هذه الجلبة؟ ما الّذي يجري؟

168
00:15:06,780 --> 00:15:08,550
ماذا؟ هل ستطلقون علينا؟

169
00:15:08,550 --> 00:15:12,520
!إنّهم يصوّبون نحونا! هذا سيّئ

170
00:15:12,520 --> 00:15:15,750
!حسنًا! دع الأمر لي
!سأردّها لهم

171
00:15:15,750 --> 00:15:17,850
.لوفي. دعني أتكفّل بهذا

172
00:15:17,850 --> 00:15:20,690
!أجل، أجل! ابق أنت في الخلف

173
00:15:19,560 --> 00:15:20,690
لـ-لماذا؟

174
00:15:20,690 --> 00:15:23,860
.لأنّك تفسد الأمور
!هيّا! تعال إلى هنا

175
00:15:24,060 --> 00:15:25,630
!ارتجف ونم

176
00:15:33,140 --> 00:15:34,370
!مذهل

177
00:15:34,740 --> 00:15:36,340
!هذا مستحيل

178
00:15:37,040 --> 00:15:40,310
ماذا؟ ما كلّ هذا الضّجيج؟

179
00:15:44,280 --> 00:15:46,280
.لا تزعجوا النّاس وهم نيام

180
00:15:48,120 --> 00:15:50,490
!ما زلنا نملك الكثير منها! أطلقوا

181
00:15:51,890 --> 00:15:53,620
.ماذا؟ هذا سيّئ

182
00:15:53,620 --> 00:15:54,590
!حقًّا؟

183
00:16:03,000 --> 00:16:06,100
.أرأيت؟ كانت هناك شقوق في المدفع

184
00:16:06,100 --> 00:16:07,670
.أجل، هذا سيّئ بالتّأكيد

185
00:16:09,800 --> 00:16:11,310
!أيّها الأشقياء الملاعين

186
00:16:11,310 --> 00:16:14,110
إيّاكم أن تسخروا من قوّة ملازم
!سابق في البحريّة

187
00:16:14,110 --> 00:16:16,180
!علينا أن نقاتل مباشرةً فحسب

188
00:16:16,180 --> 00:16:18,150
!اتبعوني يا رجال

189
00:16:20,050 --> 00:16:21,250
!سأنال من رأسك

190
00:16:23,650 --> 00:16:25,750
...غومو غومو نوو

191
00:16:26,020 --> 00:16:26,850
!الجرس

192
00:16:40,500 --> 00:16:45,810
أنت جريء لتفتعل القتال
.أثناء وقت الطّعام أيّها الصّلب

193
00:16:46,140 --> 00:16:48,310
.لا أملك أيّ أطباق حساء اليوم

194
00:16:48,310 --> 00:16:50,140
أم أنّك تنوي لعق سطح السّفينة؟

195
00:16:51,980 --> 00:16:54,310
!مـ-ما الّذي يفعله ذاك النّادل هنا؟

196
00:17:02,390 --> 00:17:04,520
ماذا؟ هل انتهى بالفعل؟

197
00:17:04,890 --> 00:17:06,090
!كان يثرثر فحسب

198
00:17:06,830 --> 00:17:09,260
.إنّه جبان كعادته

199
00:17:10,060 --> 00:17:12,770
!بربّكم يا رفاق! اهدؤوا

200
00:17:12,770 --> 00:17:15,730
صدقًا! لا أستطيع حتّى
!الاسترخاء وقراءة الجريدة هنا

201
00:17:15,730 --> 00:17:19,170
!نامي-سان! انتهيت من إعداد وجبتك

202
00:17:19,170 --> 00:17:24,210
!أنا أتضوّر جوعًا! فلنأكل! طعام! طعام

203
00:17:33,650 --> 00:17:34,820
ما ذلك؟

204
00:17:37,220 --> 00:17:38,120
.دعني أرى

205
00:17:46,630 --> 00:17:48,970
!عين الصّقر! ما الّذي أتى بك إلى هنا؟

206
00:17:49,570 --> 00:17:52,600
.اهدؤوا. لا شأن لي معكم

207
00:17:53,040 --> 00:17:54,940
أين قائدكم؟

208
00:17:56,970 --> 00:18:01,250
...يخيّم في جزيرةٍ كهذه
.يا له من رجلٍ هانئ

209
00:18:03,180 --> 00:18:07,220
!ز-ز-زعيم

210
00:18:17,230 --> 00:18:20,260
!عـ-عـ-عين الصّقر

211
00:18:25,240 --> 00:18:28,500
.مرحبًا يا عين الصّقر
...يا لها من زيارةٍ فريدة

212
00:18:29,440 --> 00:18:33,710
...لا أشعر بخير حقًّا هذه اللّحظة
هل أتيت لقتالي يا ترى؟

213
00:18:34,940 --> 00:18:37,410
لا أملك أيّ نيّة في تسوية الأمور معك

214
00:18:37,410 --> 00:18:40,420
.بعد أن فقدتَ ذراعك اليسرى

215
00:18:41,380 --> 00:18:43,750
،وجدتُ قرصانًا مثيرًا للاهتمام

216
00:18:44,150 --> 00:18:47,020
.وتذكّرتُ فجأةً قصّةً كنتَ ترويها

217
00:18:48,320 --> 00:18:52,490
قصّة عن صبيّ مثيرٍ للاهتمام
...من قرية صغيرة معيّنة

218
00:18:53,460 --> 00:18:54,230
!...لا يمكن

219
00:19:01,740 --> 00:19:03,910
!نجحتَ يا لوفي

220
00:19:06,710 --> 00:19:08,640
...في تلك الحالة يا عين الصّقر

221
00:19:11,310 --> 00:19:14,320
.لا يمكنني أن أتركك ترحل الآن

222
00:19:20,420 --> 00:19:22,390
!هكذا إذًا يا عين الصّقر؟

223
00:19:22,390 --> 00:19:26,360
!حسنًا! اشرب! اشرب
!لدينا حفلة اليوم

224
00:19:27,030 --> 00:19:28,600
ظننتُك تعاني من خُمار؟

225
00:19:28,600 --> 00:19:31,030
!لا تهتمّ! إنّه مشروب احتفاليّ

226
00:19:31,030 --> 00:19:32,400
!هيّا! هيّا

227
00:19:32,630 --> 00:19:36,070
!اشربه عن آخره

228
00:19:37,870 --> 00:19:40,210
!أحببتك! فلنشرب! فلنشرب

229
00:19:40,210 --> 00:19:41,310
!أجل

230
00:19:41,310 --> 00:19:46,180
لكن مهلاً يا زعيم! قلتَ أنّك
!لا تشعر بخير لأنّك أسرفت في الشّرب

231
00:19:46,180 --> 00:19:49,580
أيّها الأحمق! لا أستطيع أن أمتنع
!عن الشّرب في يومٍ بهيجٍ كهذا

232
00:19:49,580 --> 00:19:50,880
.لا تزال الشّمس ساطعة

233
00:19:50,880 --> 00:19:52,390
!لا عليك

234
00:19:53,390 --> 00:19:55,190
!فلنحتفل بشدّة

235
00:20:00,460 --> 00:20:03,230
!اسمعوا! أصبح لوفي رجلاً مطلوبًا

236
00:20:03,230 --> 00:20:05,160
!طوبى له

237
00:20:05,160 --> 00:20:08,170
من يدري؟ قد تولّد هذه القرية
!قرصانًا عظيمًا

238
00:20:08,170 --> 00:20:09,540
!سيكون ذلك رائعًا

239
00:20:09,540 --> 00:20:12,440
!اصمتوا أيّها الحمقى

240
00:20:12,440 --> 00:20:13,910
!العمدة

241
00:20:13,910 --> 00:20:17,240
!ما الجيّد في انتماء مجرمٍ إلى قريتنا؟

242
00:20:17,240 --> 00:20:19,080
!نخبكم

243
00:20:21,110 --> 00:20:24,220
!...صدقًا! جميعهم

244
00:20:26,220 --> 00:20:29,320
!انظر أيّها العمدة! يبدو لوفي سعيدًا حقًّا

245
00:20:29,660 --> 00:20:31,890
!يبقى القرصان قرصانًا

246
00:20:33,890 --> 00:20:36,030
!سأصبح ملك القراصنة

247
00:20:36,960 --> 00:20:42,130
لكنّه حلمه. هل أنت قلق؟

248
00:20:43,840 --> 00:20:47,440
...الأحلام... القدر

249
00:20:53,950 --> 00:20:58,380
...إنّنا نقترب من الغراند لاين أخيرًا

250
00:20:58,380 --> 00:21:02,350
يبدو أنّ الطّريق الوحيد المؤدّي
.إليه عبر هذا الجبل العكسيّ

251
00:21:02,650 --> 00:21:06,320
يا للإزعاج. ألا يمكننا أن نبحر إليه
مباشرةً فحسب؟

252
00:21:06,760 --> 00:21:08,030
.كلاّ

253
00:21:08,030 --> 00:21:11,730
،وفقًا لما أخبرني به ذاك العجوز اللّعين
.إنّه مدخل القوارب الوحيد

254
00:21:12,900 --> 00:21:14,060
أنّى ذلك؟

255
00:21:14,060 --> 00:21:15,500
.لأنّه يُفترض أن يكون خطيرًا

256
00:21:15,500 --> 00:21:17,270
!لكن كيف؟

257
00:21:17,270 --> 00:21:19,470
!هذا كلّ ما أعرفه

258
00:21:19,770 --> 00:21:21,000
...السّبب وراء ذلك هو

259
00:21:21,000 --> 00:21:25,040
!حسنًا، فهمت! دعونا نتّجه إليه مباشرةً

260
00:21:25,810 --> 00:21:27,880
!هل أنت منتبه أساسًا؟

261
00:21:27,880 --> 00:21:29,680
!لكن يبدو هذا ممتعًا

262
00:21:29,980 --> 00:21:33,150
كما أنّه سيكون أفضل بكثير
!إن اتّجهنا إليه مباشرةً

263
00:21:35,820 --> 00:21:38,690
...الحديث معك يدفعني للجنون

264
00:21:39,220 --> 00:21:43,730
على أيّ حال، دعونا نتوقّف عند جزيرةٍ
!ما أوّلاً ونحصل على بعض اللّحم

265
00:21:43,960 --> 00:21:44,660
!لحم! لحم

266
00:21:47,360 --> 00:21:51,100
...ثمّة مدينة مشهورة في هذه الجزيرة
.تدعى لوغتاون

267
00:21:51,470 --> 00:21:53,200
لوغتاون؟

268
00:21:53,200 --> 00:21:56,070
ماذا؟ هل هي مشهورة بلحمها؟

269
00:21:56,470 --> 00:21:59,040
...تُعرف أيضًا بمدينة البداية والنّهاية

270
00:21:59,810 --> 00:22:01,780
.أنا واثق أنّني سمعتُ بهذا من قبل

271
00:22:03,250 --> 00:22:06,980
إنّها البلدة الّتي نشأ فيها ملك
القراصنة القديم غولد روجر

272
00:22:06,980 --> 00:22:08,750
.وأُعدم فيها أيضًا

273
00:22:12,450 --> 00:22:14,760
...البلدة الّتي مات فيها ملك القراصنة

274
00:22:16,630 --> 00:22:17,690
هل تريد أن تذهب؟

275
00:22:18,030 --> 00:22:19,960
!نعم! أريد أن أراها

276
00:22:20,300 --> 00:22:22,730
أريد رؤية البلدة الّتي شهدت
...نشأة وموت

277
00:22:22,730 --> 00:22:25,200
..."الرّجل الّذي نال "الون بيس

278
00:22:25,470 --> 00:22:28,170
!وكلّ شيء في هذا العالم

279
00:22:57,060 --> 00:23:01,900
مشاعري الجيّاشة لا تتّصل

280
00:23:01,900 --> 00:23:06,740
بينما أشدّ على يدك بثبات

281
00:23:06,740 --> 00:23:11,640
،سأشدّ الشّراع بنفسي

282
00:23:11,640 --> 00:23:17,320
لذا واصل مشاهدتي
باهتمام بينما أبتعد

283
00:23:21,620 --> 00:23:26,830
كان يجول هذا في ذهني قليلاً
منذ هذا الصّباح

284
00:23:26,830 --> 00:23:31,430
لمَ الجوّ حار؟

285
00:23:31,430 --> 00:23:41,740
،بدءًا من تلك النّقطة
لم أستطع التّهرّب من ذلك

286
00:23:42,740 --> 00:23:47,750
أريد أن أمسك تلك المشاعر
،الّتي رحلت بسرعة

287
00:23:47,750 --> 00:23:52,580
حتّى أنّني مستعدّ لأباغت نفسي

288
00:23:52,580 --> 00:23:57,620
أريد أن أعانق أحلامي
الّتي قفزت من صدري

289
00:23:57,620 --> 00:24:02,730
معك، أستطيع الرّكض إلى هناك

290
00:24:11,570 --> 00:24:14,310
بالمناسبة! ما كان يدعى
ذلك الشّيء ذو الأنف الأحمر؟

291
00:24:14,340 --> 00:24:15,310
رنّة؟

292
00:24:15,310 --> 00:24:16,670
لا، بل أقصد ذلك الشّخص
!ذو الأنف الكبير

293
00:24:16,670 --> 00:24:18,140
ذلك إذًا؟

294
00:24:18,140 --> 00:24:20,410
كان اسمه بوغي أو باغي
!الأهوج أو شيءٌ كهذا

295
00:24:20,410 --> 00:24:23,650
!كلاّ! بل باغي المهرّج! باغي

296
00:24:23,650 --> 00:24:24,550
!أجل! بالضّبط

297
00:24:24,550 --> 00:24:27,020
...أتساءل ماذا حدث له بعد ذلك

298
00:24:27,020 --> 00:24:27,990
:في الحلقة القادمة من ون بيس

299
00:24:28,250 --> 00:24:31,320
!مطاردة قبّعة القّشّ"
".مغامرة باغي الصّغير الكبيرة

300
00:24:31,320 --> 00:24:33,490
!ملك القراصنة، لن يكون إلاّ أنا