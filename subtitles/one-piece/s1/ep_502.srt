1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,800 --> 00:03:37,400
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:37,780 --> 00:03:40,950
.اُجتيح لوفي بحزن لا يطاق

39
00:03:40,950 --> 00:03:44,780
...لكن، قبل عشر سنوات في الأزرق الشّرقيّ

40
00:03:44,780 --> 00:03:46,740
!ماذا فعلت؟

41
00:03:48,900 --> 00:03:50,200
!إيس

42
00:03:50,800 --> 00:03:53,730
!لا تفعل

43
00:04:00,330 --> 00:04:04,800
"!أين يمكن إيجاد الحرّيّة؟ رحيل فتى محزن"

44
00:04:12,640 --> 00:04:13,960
!دادان

45
00:04:15,700 --> 00:04:18,440
!توقّف يا مخبول البحر

46
00:04:21,300 --> 00:04:23,900
!دع إيس وشأنه

47
00:04:35,100 --> 00:04:36,630
ماذا تفعلون هنا؟

48
00:04:37,230 --> 00:04:38,630
!وجدناكما أخيرًا

49
00:04:38,630 --> 00:04:43,060
إنّك مصاب بشدّة يا لوفي! هل أنت بخير؟

50
00:04:43,950 --> 00:04:45,580
...دوغرا

51
00:04:47,130 --> 00:04:49,760
!لا أرى سابو في أيّ مكان

52
00:04:49,760 --> 00:04:53,400
.عاد سابو إلى بيته. ليس هنا

53
00:04:58,330 --> 00:04:59,620
!إيس

54
00:04:59,620 --> 00:05:03,160
!أنت زعيمة القردة من جبل كولبو

55
00:05:03,160 --> 00:05:05,290
!أنا لصّة الجبل دادان

56
00:05:05,290 --> 00:05:10,080
.لا أدري لماذا، لكنّني مسجّلة كوالدتهما بالتّبنّي

57
00:05:12,980 --> 00:05:17,560
...لن أقف وأشاهد أحدًا يقتل أولادي

58
00:05:17,560 --> 00:05:20,540
!وإلّم أكن أمّهما الحقيقيّة

59
00:05:21,200 --> 00:05:23,050
.سأدعك تذهب إن تراجعت

60
00:05:23,920 --> 00:05:28,140
!وإلّم تتراجع، سأضطرّ للّجوء إلى العنف

61
00:05:38,730 --> 00:05:40,060
!جرّبي

62
00:05:40,060 --> 00:05:42,940
...حقًّا؟ حسنًا إذًا

63
00:05:48,030 --> 00:05:49,620
!اهربوا

64
00:05:49,620 --> 00:05:51,530
!حاضر

65
00:05:53,200 --> 00:05:55,040
!مهلاً، ماذا تفعل؟

66
00:05:55,040 --> 00:05:57,220
!إيس، أسرع

67
00:05:57,870 --> 00:05:58,790
!إيس

68
00:06:01,340 --> 00:06:02,480
...أنا

69
00:06:05,590 --> 00:06:07,010
!لن أهرب

70
00:06:08,590 --> 00:06:12,850
!ماذا تقول يا إيس؟! لا تحاول قتاله

71
00:06:13,310 --> 00:06:15,970
!بلوجام مجرم حقيقيّ

72
00:06:15,970 --> 00:06:19,650
!لا يمكن لطفل مثلك هزيمته

73
00:06:19,650 --> 00:06:21,690
!د-دعني أقاتل أيضا

74
00:06:21,690 --> 00:06:23,230
!لا تفعل يا لوفي

75
00:06:26,690 --> 00:06:30,240
!أنتم، خذوا لوفي واسبقونا

76
00:06:30,660 --> 00:06:31,740
!أ-أيّتها الزّعيمة

77
00:06:32,370 --> 00:06:36,290
!سأتحمّل مسؤوليّة إعادة إيس إلى الدّيار

78
00:06:39,000 --> 00:06:40,390
!أيّتها الزّعيمة

79
00:06:41,920 --> 00:06:43,340
!اذهبوا

80
00:06:43,340 --> 00:06:44,750
!حـ-حاضر

81
00:06:44,750 --> 00:06:46,090
!إيس

82
00:06:46,090 --> 00:06:49,680
!أيّتها الزّعيمة! عودي إلى الدّيار بأمان

83
00:06:53,930 --> 00:06:55,810
.امرأة وطفل

84
00:06:57,640 --> 00:07:02,730
،إن بالغتما في تقدير قدرتكما
!ستتعرّضان للأذى فحسب

85
00:07:03,310 --> 00:07:07,610
!فقط القويّ والجبان ينجيان في الحرب

86
00:07:08,280 --> 00:07:11,820
.الشّجاع مصيره الموت

87
00:07:12,700 --> 00:07:14,510
هكذا إذًا؟

88
00:07:15,200 --> 00:07:16,240
!يا لك من حمقاء

89
00:07:26,550 --> 00:07:29,800
!سحقًا

90
00:07:29,800 --> 00:07:34,010
!أنا هالك! النّار من كلّ جهة

91
00:07:34,010 --> 00:07:36,510
!كيف حدث هذا فجأةً؟

92
00:07:36,510 --> 00:07:38,890
!ساخن! المكان ساخن

93
00:07:38,890 --> 00:07:40,890
!لا مهرب

94
00:07:45,230 --> 00:07:47,320
!علينا أن نستسلم

95
00:08:12,170 --> 00:08:14,180
ما الّذي حدث للتّوّ؟

96
00:08:15,320 --> 00:08:16,760
!إنّه طريق

97
00:08:17,210 --> 00:08:19,460
!خلّف الانفجار طريقًا

98
00:08:19,460 --> 00:08:21,560
!لا أدري ما الّذي يجري لكنّ هذا ممتاز

99
00:08:21,880 --> 00:08:25,710
!انظروا، هنالك سفينة

100
00:08:25,710 --> 00:08:27,440
!أرى سفينة

101
00:08:27,440 --> 00:08:30,040
!يقود هذا الطّريق إلى الشّاطئ

102
00:08:30,040 --> 00:08:32,600
!يمكننا الهرب إن اتّبعناه

103
00:08:33,200 --> 00:08:36,620
!لنذهب قبل أن تعود النّار

104
00:08:39,780 --> 00:08:44,790
!كم هم فظيعون لإحراق المنطقة وأهاليها ما زالوا هناك

105
00:08:45,290 --> 00:08:47,100
،بالمناسبة

106
00:08:47,100 --> 00:08:51,870
كيف عرفت الوضع في دولة نائية في الأزرق الشّرقيّ؟

107
00:08:52,550 --> 00:08:55,930
هل من شيء خاصّ في هذه البلاد؟

108
00:08:55,930 --> 00:08:59,930
.هذه البلاد خير مثال لكيف سيكون العالم في المستقبل

109
00:09:00,410 --> 00:09:05,630
.لا سعادة في عالم يتخلّصون فيه من غير المرغوب بهم

110
00:09:06,230 --> 00:09:11,160
!يومًا ما، سأغيّر العالم

111
00:09:11,730 --> 00:09:16,820
!إن بقيت هنا... لن أكون حرًّا أبدًا

112
00:09:18,280 --> 00:09:22,660
.حتّى في دولة كهذه، يوجد أطفال

113
00:09:34,260 --> 00:09:41,180
!ليصعد منكم من يريد القتال من أجل الحرّيّة

114
00:09:58,570 --> 00:10:00,450
هل وجدوا سابو؟

115
00:10:00,450 --> 00:10:05,830
.اتّصلت بالعسكر للتّوّ. سيجدونه عمّا قريب

116
00:10:05,830 --> 00:10:09,440
فهمت. سابو يتسبّب لنا بوقت عصيب، أليس كذلك؟

117
00:10:10,130 --> 00:10:11,380
...نعم

118
00:10:15,050 --> 00:10:17,700
هل هذه البلدة آمنة حقًّا؟

119
00:10:17,700 --> 00:10:20,680
!يبدو أنّ النّار قد تبتلع البلدة في أيّة لحظة

120
00:10:23,490 --> 00:10:27,470
هل من طريقة لدخول المدينة العليا؟

121
00:10:27,470 --> 00:10:28,820
.لا

122
00:10:29,350 --> 00:10:33,020
!لا يسمحون حتّى للحشرات بالدّخول، فقط النّبلاء

123
00:10:33,020 --> 00:10:37,740
!أيّتها الزّعيمة

124
00:10:38,280 --> 00:10:39,950
!إيس

125
00:10:39,950 --> 00:10:42,070
!أيّتها الزّعيمة

126
00:10:42,070 --> 00:10:44,370
!إيس

127
00:10:44,370 --> 00:10:47,140
!أيّتها الزّعيمة

128
00:10:48,460 --> 00:10:56,420
.إيس ودادان لم يرجعا من غري ترمينال المحترقة

129
00:11:10,060 --> 00:11:14,310
.هوّن عليك، انتظر يا لوفي
لم تتعاف بعد، إلى أين أنت ذاهب؟

130
00:11:14,310 --> 00:11:17,330
!عليّ أن أذهب للبحث عن إيس ودادان

131
00:11:17,330 --> 00:11:18,820
!لا يمكنك ذلك

132
00:11:21,200 --> 00:11:22,420
!هذا مؤلم

133
00:11:23,070 --> 00:11:25,200
.أرأيت؟ هذا ما أخبرتك

134
00:11:29,370 --> 00:11:34,130
.إصاباتك بليغة. عليك أن ترتاح جيّدًا

135
00:11:34,130 --> 00:11:40,920
هنالك الكثير من القوّات في غري ترمينال
.الآن للاعتناء بالفوضى الّتي خلّفها الحريق

136
00:11:41,420 --> 00:11:45,800
،فهم لا يتخلّصون من القمامة المحترقة فقط

137
00:11:45,800 --> 00:11:48,640
.بل وحتّى النّاجين

138
00:11:48,640 --> 00:11:51,440
.سيقتلونك إن ذهبت إلى هناك

139
00:11:51,440 --> 00:11:52,980
!...لكن

140
00:12:03,240 --> 00:12:05,990
!أريد رؤية إيس

141
00:12:05,990 --> 00:12:10,090
!أعلم أنّ سابو قلق بشأننا أيضًا

142
00:12:16,750 --> 00:12:18,880
!يا له من منظر رائع

143
00:12:18,880 --> 00:12:20,520
كيف يمكنك أن تكون سعيدًا هكذا؟

144
00:12:20,520 --> 00:12:23,180
!إنّه لمن المزعج تنظيف هذه الفوضى

145
00:12:31,140 --> 00:12:35,040
.إن وجدنا ناجٍ، سنطلق عليه على الفور

146
00:12:35,040 --> 00:12:36,400
.لا يوجد أيّ ناجٍ

147
00:12:36,960 --> 00:12:39,780
.لكن لا توجد جثث كثيرة كما توقّعت

148
00:12:39,780 --> 00:12:43,110
.كان حريقًا هائلاً. ربّما حرق حتّى عظامهم

149
00:12:45,110 --> 00:12:47,770
،كنت متوتّرًا البارحة

150
00:12:47,770 --> 00:12:51,370
.وظننت أنّ النّار قد تصل لهذا الجانب من الجدار

151
00:12:51,370 --> 00:12:53,870
.يقال أنّ سفينة بلوجام كانت تحترق أيضًا

152
00:12:54,340 --> 00:12:57,890
!من الجيّد أنّ أولئك الجانحين حُرقوا أيضًا

153
00:13:04,450 --> 00:13:05,960
!حلّ الصّباح

154
00:13:22,900 --> 00:13:25,740
مرحبًا! إنّه يوم جميل، أليس كذلك؟

155
00:13:25,740 --> 00:13:29,620
!أجل، إنّه صباح جميل

156
00:13:42,170 --> 00:13:44,100
!ما زال هناك الكثير منهم

157
00:13:46,780 --> 00:13:51,640
يكفي من لعبة المطاردة هذه، اتّفقنا يا فتى؟

158
00:14:14,530 --> 00:14:17,120
!مهما هربت من البيت فلن تستطيع الابتعاد أبدًا يا سابو

159
00:14:17,940 --> 00:14:22,750
!كلّ ضبّاط الشّرطة والقوّات يملكون صورتك الآن

160
00:14:22,750 --> 00:14:26,230
...لن تخرج من المدينة العليا أبدًا

161
00:14:26,230 --> 00:14:27,840
!ولن تخرج حتّى من هذا البيت

162
00:14:29,560 --> 00:14:34,670
.أنتما، غيّرا زيّكما وابدآ العمل هنا كحارسين

163
00:14:34,670 --> 00:14:36,730
...لكن لدينا مهامّنا

164
00:14:36,730 --> 00:14:40,540
.لا يوجد شيء يعجز عنه رجل نبيل

165
00:14:40,540 --> 00:14:43,110
.سأحصل على موافقة ضابطكما المسؤول

166
00:14:46,990 --> 00:14:49,920
سابو، عليك أن تحصّن نفسك في غرفتك

167
00:14:49,920 --> 00:14:53,380
!وتثقّف نفسك بصفتك نبيلاً

168
00:14:53,380 --> 00:14:54,330
!لا

169
00:14:54,700 --> 00:15:00,290
.كما تعلم، يمكنني أن أفعل ما أريد بمجرّد إعطاء أمر

170
00:15:00,570 --> 00:15:04,500
.لذا بإمكاني تولّي أمرك أو ذلكما الاثنين بسهولة

171
00:15:05,360 --> 00:15:06,840
أكلامي مفهوم؟

172
00:15:08,240 --> 00:15:09,540
...أبي

173
00:15:12,130 --> 00:15:15,510
...إيس... لوفي

174
00:15:20,020 --> 00:15:26,070
.لذا عليك أن تصلح سبيلك وتدرس جيّدًا كستيلي

175
00:15:26,070 --> 00:15:27,480
...و

176
00:15:27,480 --> 00:15:30,160
ادرس لكي تجعل والديك

177
00:15:30,160 --> 00:15:33,620
!اللّذان أنجباك سعيدين

178
00:15:34,620 --> 00:15:37,790
!لأنّ ذلك سيسعدك أنت أيضًا

179
00:15:37,790 --> 00:15:39,830
ألا تظنّ ذلك؟

180
00:15:42,290 --> 00:15:44,140
!أبي

181
00:15:45,890 --> 00:15:47,920
!لا تقلق! أنا هنا لأجلك

182
00:15:50,300 --> 00:15:52,510
!أنت مؤتمن حقًّا يا ستيلي

183
00:15:52,510 --> 00:15:55,390
حسنًا، دعني أشتري لك بعض الثّياب الفاخرة

184
00:15:55,390 --> 00:15:57,720
.لأنّ الحفل بعد غد

185
00:15:57,720 --> 00:16:00,610
!هناك، سنرى التّنّين السّماويّ شخصيًّا

186
00:16:09,320 --> 00:16:12,820
!أنا... عاجز

187
00:16:16,960 --> 00:16:20,120
.حسنًا، يكفي لليوم

188
00:16:26,710 --> 00:16:29,710
.سأتفقّد واجبك المنزليّ غدًا

189
00:16:30,330 --> 00:16:32,390
!حسنًا، طاب يومك

190
00:16:41,650 --> 00:16:44,350
...إيس... لوفي

191
00:16:45,080 --> 00:16:48,820
.لا أظنّ أنّك متّ في الحريق

192
00:16:49,740 --> 00:16:52,740
أنتما بخير، أليس كذلك؟

193
00:17:02,830 --> 00:17:06,620
.يا ليتني كنت أستطيع رؤيتكما

194
00:17:09,000 --> 00:17:14,550
.لكن أدري أنّني سأعرّضكما للخطر إن حاولت رؤيتكما الآن

195
00:17:15,480 --> 00:17:17,260
!هذا المكان أشبه بقفص

196
00:17:18,030 --> 00:17:23,540
لا أظنّني أستطيع احتمال العيش
.في هذه البلاد المليئة بالهواء الفاسد

197
00:17:30,200 --> 00:17:32,740
ما هي الحرّيّة؟

198
00:17:33,630 --> 00:17:35,280
وأين يمكنني إيجادها؟

199
00:17:36,570 --> 00:17:38,280
.انتهت مناوبتك

200
00:17:38,280 --> 00:17:40,910
أحان الوقت بالفعل؟

201
00:17:40,910 --> 00:17:43,040
.لا ينبغي أن تنام أثناء العمل

202
00:17:43,040 --> 00:17:46,920
آسف. بالمناسبة، كيف الأوضاع في البلدة؟

203
00:17:46,920 --> 00:17:49,080
الحفل بعد يوم فقط، صحيح؟

204
00:17:49,560 --> 00:17:53,050
.هذا جنون. النّاس هائجون في الإعداد له

205
00:17:53,560 --> 00:17:56,120
!يا له من حظّ عاثر

206
00:17:56,120 --> 00:18:00,760
.إنّه أمر يحدث مرّة في العمر بينما عليّ البقاء هنا

207
00:18:00,760 --> 00:18:05,600
.هذا الفتى وأنا سنكون الوحيدان في هذا البيت غدًا

208
00:18:07,430 --> 00:18:10,400
.أردتُ رؤية التّنّين السّماويّ

209
00:18:11,150 --> 00:18:13,530
.ذلك يعتمد على نظرتك

210
00:18:13,530 --> 00:18:17,820
.كلّ المدنيّين سيكونون في الميناء غدًا

211
00:18:17,820 --> 00:18:20,430
،سيكون من المزعج جدًّا الحراسة هناك

212
00:18:20,430 --> 00:18:23,260
!مقارنة بمجالسة الطّفل السّهلة هذه

213
00:18:23,260 --> 00:18:26,040
إذًا، ما رأيك أن تحلّ محلّي؟

214
00:18:27,210 --> 00:18:28,780
!محال

215
00:18:32,040 --> 00:18:34,050
.حسنًا، سنغادر الآن

216
00:18:34,700 --> 00:18:37,440
.اعتن بسابو جيّدًا

217
00:18:37,440 --> 00:18:39,430
.حاضر

218
00:19:05,320 --> 00:19:08,580
يوم زيارة أحد نبلاء العالم من الغراند لاين

219
00:19:08,580 --> 00:19:11,410
.لمملكة غوا قد حان

220
00:19:12,740 --> 00:19:18,090
.حيث تمّ تحضير حفل فخم لوصول السّفينة

221
00:19:23,440 --> 00:19:27,720
،رنين، رنين، رنين... رنين
!رنين، رنين... فتح

222
00:19:27,720 --> 00:19:29,600
.مرحبًا، هذا فريق أ في السّاحل

223
00:19:29,600 --> 00:19:35,490
.ستصل سفينة التّنّين السّماوي بعد بضع دقائق

224
00:19:35,490 --> 00:19:39,000
.عُلم. كلّ شيء هادئ هنا

225
00:19:39,000 --> 00:19:41,360
.سنواصل الحراسة

226
00:19:41,360 --> 00:19:42,320
!إغلاق

227
00:19:50,580 --> 00:19:55,080
!انظروا! ثمّة سفينة تغادر الميناء

228
00:19:55,800 --> 00:19:56,800
ماذا؟

229
00:19:56,800 --> 00:19:57,820
أهو قارب صيد؟

230
00:19:59,590 --> 00:20:04,730
!أنت! عد إلى هنا! لا تعترض الحفل

231
00:20:05,550 --> 00:20:09,920
!إنّه طفل! ثمّة طفل على السّفينة

232
00:20:09,920 --> 00:20:13,990
.طفل؟ أتساءل من أيّ عائلة هو

233
00:20:13,990 --> 00:20:15,440
طفل؟

234
00:20:15,440 --> 00:20:17,730
!عزيزي، أيمكن...؟

235
00:20:17,730 --> 00:20:22,220
!لا، هذا مستحيل! هناك حارس يراقبه

236
00:20:33,900 --> 00:20:37,590
!يا له من يوم جميل! إنّه يوم مثاليّ للإبحار

237
00:20:43,310 --> 00:20:49,030
!لا! إنّه لي! سرق أحدهم قارب الصّيد خاصّتي

238
00:20:51,840 --> 00:20:54,430
!هل يظنّ أنّه قرصان؟

239
00:20:54,430 --> 00:20:57,110
!مستحيل! لا يمكن لفتى أن يصبح قرصانًا

240
00:20:57,710 --> 00:20:59,480
إلى أين هو ذاهب؟

241
00:20:59,480 --> 00:21:01,780
.إنّه يعطّل الحفل

242
00:21:01,780 --> 00:21:04,990
!ستصل سفينة الحكومة قريبًا

243
00:21:04,990 --> 00:21:06,660
!أسرع وافعل شيئًا

244
00:21:06,660 --> 00:21:08,130
!حـ-حاضر

245
00:21:08,130 --> 00:21:09,830
!أنت

246
00:21:10,350 --> 00:21:13,830
!يا ولد، عد إلى هنا فورًا

247
00:21:16,000 --> 00:21:20,630
المصير الأكثر رعبًا بالنّسبة لي
...هو أن أفقد نفسي في هذه البلاد

248
00:21:21,400 --> 00:21:23,550
!وأصبح أحدًا آخر

249
00:21:27,610 --> 00:21:29,640
!لن أعود

250
00:21:32,880 --> 00:21:35,980
أذلك سابو على متن السّفينة؟

251
00:21:38,060 --> 00:21:42,000
!وصلت سفينة الحكومة

252
00:22:00,160 --> 00:22:02,900
!يا لها من سفينة ضخمة

253
00:22:02,900 --> 00:22:05,440
.سأموت إن ارتطمت بها

254
00:22:06,310 --> 00:22:07,590
.سأتفادى ذلك

255
00:22:12,680 --> 00:22:15,850
.جيّد. إنّه يبتعد

256
00:22:23,330 --> 00:22:27,390
.يبدو أنّ العامّة يرحّبون بنا

257
00:22:27,390 --> 00:22:28,450
.نعم

258
00:22:30,930 --> 00:22:35,240
!إنّهم مباركون لدرجة أنّ من النّادر حتّى رؤيتهم

259
00:22:35,240 --> 00:22:39,290
!لا أصدّق أنّ أحد التّنانين السّماويّين على متن تلك السّفينة

260
00:22:39,290 --> 00:22:43,300
بالمناسبة، ما ذلك؟

261
00:22:44,000 --> 00:22:46,800
.يبدو ذلك كقارب صيد

262
00:22:50,950 --> 00:22:54,600
!سيكون من الجميل أن أكون قبطان سفينة كهذه يومًا ما

263
00:22:57,540 --> 00:22:59,060
!عامّيّ

264
00:23:08,030 --> 00:23:09,570
!يا لوقاحته

265
00:23:10,470 --> 00:23:13,210
!أصيب قارب الصّيد

266
00:23:25,440 --> 00:23:28,390
.يعود كلّ من إيس ودادان إلى مخبئهما

267
00:23:28,390 --> 00:23:30,640
،بينما يفرح الجميع بعودتهما الآمنة

268
00:23:30,640 --> 00:23:34,360
.يعلمون بشأن الفاجعة الّتي ألمّت سابو في الميناء

269
00:23:34,360 --> 00:23:37,120
،بعد أن أدركا بعطف ما كان يحاول سابو فعله

270
00:23:37,120 --> 00:23:40,480
.وقع لوفي وإيس في النّدم والحزن

271
00:23:40,480 --> 00:23:41,960
:في الحلقة القادمة من وان بيس

272
00:23:41,960 --> 00:23:45,010
"!اعتن به جيّدًا! رسالة من الأخ"

273
00:23:45,010 --> 00:23:47,470
!ملك القراصنة، لن يكون إلاّ أنا

274
00:23:50,030 --> 00:23:55,030
!!نلقاكم في الحلقة القادمة