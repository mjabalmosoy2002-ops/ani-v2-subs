1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,800 --> 00:03:23,400
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:23,780 --> 00:03:26,950
.اُجتيح لوفي بحزن لا يطاق

39
00:03:26,950 --> 00:03:30,780
...لكن، قبل عشر سنوات في الأزرق الشّرقيّ

40
00:03:30,780 --> 00:03:32,740
!ماذا فعلت؟

41
00:03:34,900 --> 00:03:36,200
!إيس

42
00:03:36,800 --> 00:03:39,730
!لا تفعل

43
00:03:46,330 --> 00:03:50,800
"!أين يمكن إيجاد الحرّيّة؟ رحيل فتى محزن"

44
00:03:58,640 --> 00:03:59,960
!دادان

45
00:04:01,700 --> 00:04:04,440
!توقّف يا مخبول البحر

46
00:04:07,300 --> 00:04:09,900
!دع إيس وشأنه

47
00:04:21,100 --> 00:04:22,630
ماذا تفعلون هنا؟

48
00:04:23,230 --> 00:04:24,630
!وجدناكما أخيرًا

49
00:04:24,630 --> 00:04:29,060
إنّك مصاب بشدّة يا لوفي! هل أنت بخير؟

50
00:04:29,950 --> 00:04:31,580
...دوغرا

51
00:04:33,130 --> 00:04:35,760
!لا أرى سابو في أيّ مكان

52
00:04:35,760 --> 00:04:39,400
.عاد سابو إلى بيته. ليس هنا

53
00:04:44,330 --> 00:04:45,620
!إيس

54
00:04:45,620 --> 00:04:49,160
!أنت زعيمة القردة من جبل كولبو

55
00:04:49,160 --> 00:04:51,290
!أنا لصّة الجبل دادان

56
00:04:51,290 --> 00:04:56,080
.لا أدري لماذا، لكنّني مسجّلة كوالدتهما بالتّبنّي

57
00:04:58,980 --> 00:05:03,560
...لن أقف وأشاهد أحدًا يقتل أولادي

58
00:05:03,560 --> 00:05:06,540
!وإلّم أكن أمّهما الحقيقيّة

59
00:05:07,200 --> 00:05:09,050
.سأدعك تذهب إن تراجعت

60
00:05:09,920 --> 00:05:14,140
!وإلّم تتراجع، سأضطرّ للّجوء إلى العنف

61
00:05:24,730 --> 00:05:26,060
!جرّبي

62
00:05:26,060 --> 00:05:28,940
...حقًّا؟ حسنًا إذًا

63
00:05:34,030 --> 00:05:35,620
!اهربوا

64
00:05:35,620 --> 00:05:37,530
!حاضر

65
00:05:39,200 --> 00:05:41,040
!مهلاً، ماذا تفعل؟

66
00:05:41,040 --> 00:05:43,220
!إيس، أسرع

67
00:05:43,870 --> 00:05:44,790
!إيس

68
00:05:47,340 --> 00:05:48,480
...أنا

69
00:05:51,590 --> 00:05:53,010
!لن أهرب

70
00:05:54,590 --> 00:05:58,850
!ماذا تقول يا إيس؟! لا تحاول قتاله

71
00:05:59,310 --> 00:06:01,970
!بلوجام مجرم حقيقيّ

72
00:06:01,970 --> 00:06:05,650
!لا يمكن لطفل مثلك هزيمته

73
00:06:05,650 --> 00:06:07,690
!د-دعني أقاتل أيضا

74
00:06:07,690 --> 00:06:09,230
!لا تفعل يا لوفي

75
00:06:12,690 --> 00:06:16,240
!أنتم، خذوا لوفي واسبقونا

76
00:06:16,660 --> 00:06:17,740
!أ-أيّتها الزّعيمة

77
00:06:18,370 --> 00:06:22,290
!سأتحمّل مسؤوليّة إعادة إيس إلى الدّيار

78
00:06:25,000 --> 00:06:26,390
!أيّتها الزّعيمة

79
00:06:27,920 --> 00:06:29,340
!اذهبوا

80
00:06:29,340 --> 00:06:30,750
!حـ-حاضر

81
00:06:30,750 --> 00:06:32,090
!إيس

82
00:06:32,090 --> 00:06:35,680
!أيّتها الزّعيمة! عودي إلى الدّيار بأمان

83
00:06:39,930 --> 00:06:41,810
.امرأة وطفل

84
00:06:43,640 --> 00:06:48,730
،إن بالغتما في تقدير قدرتكما
!ستتعرّضان للأذى فحسب

85
00:06:49,310 --> 00:06:53,610
!فقط القويّ والجبان ينجيان في الحرب

86
00:06:54,280 --> 00:06:57,820
.الشّجاع مصيره الموت

87
00:06:58,700 --> 00:07:00,510
هكذا إذًا؟

88
00:07:01,200 --> 00:07:02,240
!يا لك من حمقاء

89
00:07:12,550 --> 00:07:15,800
!سحقًا

90
00:07:15,800 --> 00:07:20,010
!أنا هالك! النّار من كلّ جهة

91
00:07:20,010 --> 00:07:22,510
!كيف حدث هذا فجأةً؟

92
00:07:22,510 --> 00:07:24,890
!ساخن! المكان ساخن

93
00:07:24,890 --> 00:07:26,890
!لا مهرب

94
00:07:31,230 --> 00:07:33,320
!علينا أن نستسلم

95
00:07:58,170 --> 00:08:00,180
ما الّذي حدث للتّوّ؟

96
00:08:01,320 --> 00:08:02,760
!إنّه طريق

97
00:08:03,210 --> 00:08:05,460
!خلّف الانفجار طريقًا

98
00:08:05,460 --> 00:08:07,560
!لا أدري ما الّذي يجري لكنّ هذا ممتاز

99
00:08:07,880 --> 00:08:11,710
!انظروا، هنالك سفينة

100
00:08:11,710 --> 00:08:13,440
!أرى سفينة

101
00:08:13,440 --> 00:08:16,040
!يقود هذا الطّريق إلى الشّاطئ

102
00:08:16,040 --> 00:08:18,600
!يمكننا الهرب إن اتّبعناه

103
00:08:19,200 --> 00:08:22,620
!لنذهب قبل أن تعود النّار

104
00:08:25,780 --> 00:08:30,790
!كم هم فظيعون لإحراق المنطقة وأهاليها ما زالوا هناك

105
00:08:31,290 --> 00:08:33,100
،بالمناسبة

106
00:08:33,100 --> 00:08:37,870
كيف عرفت الوضع في دولة نائية في الأزرق الشّرقيّ؟

107
00:08:38,550 --> 00:08:41,930
هل من شيء خاصّ في هذه البلاد؟

108
00:08:41,930 --> 00:08:45,930
.هذه البلاد خير مثال لكيف سيكون العالم في المستقبل

109
00:08:46,410 --> 00:08:51,630
.لا سعادة في عالم يتخلّصون فيه من غير المرغوب بهم

110
00:08:52,230 --> 00:08:57,160
!يومًا ما، سأغيّر العالم

111
00:08:57,730 --> 00:09:02,820
!إن بقيت هنا... لن أكون حرًّا أبدًا

112
00:09:04,280 --> 00:09:08,660
.حتّى في دولة كهذه، يوجد أطفال

113
00:09:20,260 --> 00:09:27,180
!ليصعد منكم من يريد القتال من أجل الحرّيّة

114
00:09:44,570 --> 00:09:46,450
هل وجدوا سابو؟

115
00:09:46,450 --> 00:09:51,830
.اتّصلت بالعسكر للتّوّ. سيجدونه عمّا قريب

116
00:09:51,830 --> 00:09:55,440
فهمت. سابو يتسبّب لنا بوقت عصيب، أليس كذلك؟

117
00:09:56,130 --> 00:09:57,380
...نعم

118
00:10:01,050 --> 00:10:03,700
هل هذه البلدة آمنة حقًّا؟

119
00:10:03,700 --> 00:10:06,680
!يبدو أنّ النّار قد تبتلع البلدة في أيّة لحظة

120
00:10:09,490 --> 00:10:13,470
هل من طريقة لدخول المدينة العليا؟

121
00:10:13,470 --> 00:10:14,820
.لا

122
00:10:15,350 --> 00:10:19,020
!لا يسمحون حتّى للحشرات بالدّخول، فقط النّبلاء

123
00:10:19,020 --> 00:10:23,740
!أيّتها الزّعيمة

124
00:10:24,280 --> 00:10:25,950
!إيس

125
00:10:25,950 --> 00:10:28,070
!أيّتها الزّعيمة

126
00:10:28,070 --> 00:10:30,370
!إيس

127
00:10:30,370 --> 00:10:33,140
!أيّتها الزّعيمة

128
00:10:34,460 --> 00:10:42,420
.إيس ودادان لم يرجعا من غري ترمينال المحترقة

129
00:10:56,060 --> 00:11:00,310
.هوّن عليك، انتظر يا لوفي
لم تتعاف بعد، إلى أين أنت ذاهب؟

130
00:11:00,310 --> 00:11:03,330
!عليّ أن أذهب للبحث عن إيس ودادان

131
00:11:03,330 --> 00:11:04,820
!لا يمكنك ذلك

132
00:11:07,200 --> 00:11:08,420
!هذا مؤلم

133
00:11:09,070 --> 00:11:11,200
.أرأيت؟ هذا ما أخبرتك

134
00:11:15,370 --> 00:11:20,130
.إصاباتك بليغة. عليك أن ترتاح جيّدًا

135
00:11:20,130 --> 00:11:26,920
هنالك الكثير من القوّات في غري ترمينال
.الآن للاعتناء بالفوضى الّتي خلّفها الحريق

136
00:11:27,420 --> 00:11:31,800
،فهم لا يتخلّصون من القمامة المحترقة فقط

137
00:11:31,800 --> 00:11:34,640
.بل وحتّى النّاجين

138
00:11:34,640 --> 00:11:37,440
.سيقتلونك إن ذهبت إلى هناك

139
00:11:37,440 --> 00:11:38,980
!...لكن

140
00:11:49,240 --> 00:11:51,990
!أريد رؤية إيس

141
00:11:51,990 --> 00:11:56,090
!أعلم أنّ سابو قلق بشأننا أيضًا

142
00:12:02,750 --> 00:12:04,880
!يا له من منظر رائع

143
00:12:04,880 --> 00:12:06,520
كيف يمكنك أن تكون سعيدًا هكذا؟

144
00:12:06,520 --> 00:12:09,180
!إنّه لمن المزعج تنظيف هذه الفوضى

145
00:12:17,140 --> 00:12:21,040
.إن وجدنا ناجٍ، سنطلق عليه على الفور

146
00:12:21,040 --> 00:12:22,400
.لا يوجد أيّ ناجٍ

147
00:12:22,960 --> 00:12:25,780
.لكن لا توجد جثث كثيرة كما توقّعت

148
00:12:25,780 --> 00:12:29,110
.كان حريقًا هائلاً. ربّما حرق حتّى عظامهم

149
00:12:31,110 --> 00:12:33,770
،كنت متوتّرًا البارحة

150
00:12:33,770 --> 00:12:37,370
.وظننت أنّ النّار قد تصل لهذا الجانب من الجدار

151
00:12:37,370 --> 00:12:39,870
.يقال أنّ سفينة بلوجام كانت تحترق أيضًا

152
00:12:40,340 --> 00:12:43,890
!من الجيّد أنّ أولئك الجانحين حُرقوا أيضًا

153
00:12:50,450 --> 00:12:51,960
!حلّ الصّباح

154
00:13:08,900 --> 00:13:11,740
مرحبًا! إنّه يوم جميل، أليس كذلك؟

155
00:13:11,740 --> 00:13:15,620
!أجل، إنّه صباح جميل

156
00:13:28,170 --> 00:13:30,100
!ما زال هناك الكثير منهم

157
00:13:32,780 --> 00:13:37,640
يكفي من لعبة المطاردة هذه، اتّفقنا يا فتى؟

158
00:14:00,530 --> 00:14:03,120
!مهما هربت من البيت فلن تستطيع الابتعاد أبدًا يا سابو

159
00:14:03,940 --> 00:14:08,750
!كلّ ضبّاط الشّرطة والقوّات يملكون صورتك الآن

160
00:14:08,750 --> 00:14:12,230
...لن تخرج من المدينة العليا أبدًا

161
00:14:12,230 --> 00:14:13,840
!ولن تخرج حتّى من هذا البيت

162
00:14:15,560 --> 00:14:20,670
.أنتما، غيّرا زيّكما وابدآ العمل هنا كحارسين

163
00:14:20,670 --> 00:14:22,730
...لكن لدينا مهامّنا

164
00:14:22,730 --> 00:14:26,540
.لا يوجد شيء يعجز عنه رجل نبيل

165
00:14:26,540 --> 00:14:29,110
.سأحصل على موافقة ضابطكما المسؤول

166
00:14:32,990 --> 00:14:35,920
سابو، عليك أن تحصّن نفسك في غرفتك

167
00:14:35,920 --> 00:14:39,380
!وتثقّف نفسك بصفتك نبيلاً

168
00:14:39,380 --> 00:14:40,330
!لا

169
00:14:40,700 --> 00:14:46,290
.كما تعلم، يمكنني أن أفعل ما أريد بمجرّد إعطاء أمر

170
00:14:46,570 --> 00:14:50,500
.لذا بإمكاني تولّي أمرك أو ذلكما الاثنين بسهولة

171
00:14:51,360 --> 00:14:52,840
أكلامي مفهوم؟

172
00:14:54,240 --> 00:14:55,540
...أبي

173
00:14:58,130 --> 00:15:01,510
...إيس... لوفي

174
00:15:06,020 --> 00:15:12,070
.لذا عليك أن تصلح سبيلك وتدرس جيّدًا كستيلي

175
00:15:12,070 --> 00:15:13,480
...و

176
00:15:13,480 --> 00:15:16,160
ادرس لكي تجعل والديك

177
00:15:16,160 --> 00:15:19,620
!اللّذان أنجباك سعيدين

178
00:15:20,620 --> 00:15:23,790
!لأنّ ذلك سيسعدك أنت أيضًا

179
00:15:23,790 --> 00:15:25,830
ألا تظنّ ذلك؟

180
00:15:28,290 --> 00:15:30,140
!أبي

181
00:15:31,890 --> 00:15:33,920
!لا تقلق! أنا هنا لأجلك

182
00:15:36,300 --> 00:15:38,510
!أنت مؤتمن حقًّا يا ستيلي

183
00:15:38,510 --> 00:15:41,390
حسنًا، دعني أشتري لك بعض الثّياب الفاخرة

184
00:15:41,390 --> 00:15:43,720
.لأنّ الحفل بعد غد

185
00:15:43,720 --> 00:15:46,610
!هناك، سنرى التّنّين السّماويّ شخصيًّا

186
00:15:55,320 --> 00:15:58,820
!أنا... عاجز

187
00:16:02,960 --> 00:16:06,120
.حسنًا، يكفي لليوم

188
00:16:12,710 --> 00:16:15,710
.سأتفقّد واجبك المنزليّ غدًا

189
00:16:16,330 --> 00:16:18,390
!حسنًا، طاب يومك

190
00:16:27,650 --> 00:16:30,350
...إيس... لوفي

191
00:16:31,080 --> 00:16:34,820
.لا أظنّ أنّك متّ في الحريق

192
00:16:35,740 --> 00:16:38,740
أنتما بخير، أليس كذلك؟

193
00:16:48,830 --> 00:16:52,620
.يا ليتني كنت أستطيع رؤيتكما

194
00:16:55,000 --> 00:17:00,550
.لكن أدري أنّني سأعرّضكما للخطر إن حاولت رؤيتكما الآن

195
00:17:01,480 --> 00:17:03,260
!هذا المكان أشبه بقفص

196
00:17:04,030 --> 00:17:09,540
لا أظنّني أستطيع احتمال العيش
.في هذه البلاد المليئة بالهواء الفاسد

197
00:17:16,200 --> 00:17:18,740
ما هي الحرّيّة؟

198
00:17:19,630 --> 00:17:21,280
وأين يمكنني إيجادها؟

199
00:17:22,570 --> 00:17:24,280
.انتهت مناوبتك

200
00:17:24,280 --> 00:17:26,910
أحان الوقت بالفعل؟

201
00:17:26,910 --> 00:17:29,040
.لا ينبغي أن تنام أثناء العمل

202
00:17:29,040 --> 00:17:32,920
آسف. بالمناسبة، كيف الأوضاع في البلدة؟

203
00:17:32,920 --> 00:17:35,080
الحفل بعد يوم فقط، صحيح؟

204
00:17:35,560 --> 00:17:39,050
.هذا جنون. النّاس هائجون في الإعداد له

205
00:17:39,560 --> 00:17:42,120
!يا له من حظّ عاثر

206
00:17:42,120 --> 00:17:46,760
.إنّه أمر يحدث مرّة في العمر بينما عليّ البقاء هنا

207
00:17:46,760 --> 00:17:51,600
.هذا الفتى وأنا سنكون الوحيدان في هذا البيت غدًا

208
00:17:53,430 --> 00:17:56,400
.أردتُ رؤية التّنّين السّماويّ

209
00:17:57,150 --> 00:17:59,530
.ذلك يعتمد على نظرتك

210
00:17:59,530 --> 00:18:03,820
.كلّ المدنيّين سيكونون في الميناء غدًا

211
00:18:03,820 --> 00:18:06,430
،سيكون من المزعج جدًّا الحراسة هناك

212
00:18:06,430 --> 00:18:09,260
!مقارنة بمجالسة الطّفل السّهلة هذه

213
00:18:09,260 --> 00:18:12,040
إذًا، ما رأيك أن تحلّ محلّي؟

214
00:18:13,210 --> 00:18:14,780
!محال

215
00:18:18,040 --> 00:18:20,050
.حسنًا، سنغادر الآن

216
00:18:20,700 --> 00:18:23,440
.اعتن بسابو جيّدًا

217
00:18:23,440 --> 00:18:25,430
.حاضر

218
00:18:51,320 --> 00:18:54,580
يوم زيارة أحد نبلاء العالم من الغراند لاين

219
00:18:54,580 --> 00:18:57,410
.لمملكة غوا قد حان

220
00:18:58,740 --> 00:19:04,090
.حيث تمّ تحضير حفل فخم لوصول السّفينة

221
00:19:09,440 --> 00:19:13,720
،رنين، رنين، رنين... رنين
!رنين، رنين... فتح

222
00:19:13,720 --> 00:19:15,600
.مرحبًا، هذا فريق أ في السّاحل

223
00:19:15,600 --> 00:19:21,490
.ستصل سفينة التّنّين السّماوي بعد بضع دقائق

224
00:19:21,490 --> 00:19:25,000
.عُلم. كلّ شيء هادئ هنا

225
00:19:25,000 --> 00:19:27,360
.سنواصل الحراسة

226
00:19:27,360 --> 00:19:28,320
!إغلاق

227
00:19:36,580 --> 00:19:41,080
!انظروا! ثمّة سفينة تغادر الميناء

228
00:19:41,800 --> 00:19:42,800
ماذا؟

229
00:19:42,800 --> 00:19:43,820
أهو قارب صيد؟

230
00:19:45,590 --> 00:19:50,730
!أنت! عد إلى هنا! لا تعترض الحفل

231
00:19:51,550 --> 00:19:55,920
!إنّه طفل! ثمّة طفل على السّفينة

232
00:19:55,920 --> 00:19:59,990
.طفل؟ أتساءل من أيّ عائلة هو

233
00:19:59,990 --> 00:20:01,440
طفل؟

234
00:20:01,440 --> 00:20:03,730
!عزيزي، أيمكن...؟

235
00:20:03,730 --> 00:20:08,220
!لا، هذا مستحيل! هناك حارس يراقبه

236
00:20:19,900 --> 00:20:23,590
!يا له من يوم جميل! إنّه يوم مثاليّ للإبحار

237
00:20:29,310 --> 00:20:35,030
!لا! إنّه لي! سرق أحدهم قارب الصّيد خاصّتي

238
00:20:37,840 --> 00:20:40,430
!هل يظنّ أنّه قرصان؟

239
00:20:40,430 --> 00:20:43,110
!مستحيل! لا يمكن لفتى أن يصبح قرصانًا

240
00:20:43,710 --> 00:20:45,480
إلى أين هو ذاهب؟

241
00:20:45,480 --> 00:20:47,780
.إنّه يعطّل الحفل

242
00:20:47,780 --> 00:20:50,990
!ستصل سفينة الحكومة قريبًا

243
00:20:50,990 --> 00:20:52,660
!أسرع وافعل شيئًا

244
00:20:52,660 --> 00:20:54,130
!حـ-حاضر

245
00:20:54,130 --> 00:20:55,830
!أنت

246
00:20:56,350 --> 00:20:59,830
!يا ولد، عد إلى هنا فورًا

247
00:21:02,000 --> 00:21:06,630
المصير الأكثر رعبًا بالنّسبة لي
...هو أن أفقد نفسي في هذه البلاد

248
00:21:07,400 --> 00:21:09,550
!وأصبح أحدًا آخر

249
00:21:13,610 --> 00:21:15,640
!لن أعود

250
00:21:18,880 --> 00:21:21,980
أذلك سابو على متن السّفينة؟

251
00:21:24,060 --> 00:21:28,000
!وصلت سفينة الحكومة

252
00:21:46,160 --> 00:21:48,900
!يا لها من سفينة ضخمة

253
00:21:48,900 --> 00:21:51,440
.سأموت إن ارتطمت بها

254
00:21:52,310 --> 00:21:53,590
.سأتفادى ذلك

255
00:21:58,680 --> 00:22:01,850
.جيّد. إنّه يبتعد

256
00:22:09,330 --> 00:22:13,390
.يبدو أنّ العامّة يرحّبون بنا

257
00:22:13,390 --> 00:22:14,450
.نعم

258
00:22:16,930 --> 00:22:21,240
!إنّهم مباركون لدرجة أنّ من النّادر حتّى رؤيتهم

259
00:22:21,240 --> 00:22:25,290
!لا أصدّق أنّ أحد التّنانين السّماويّين على متن تلك السّفينة

260
00:22:25,290 --> 00:22:29,300
بالمناسبة، ما ذلك؟

261
00:22:30,000 --> 00:22:32,800
.يبدو ذلك كقارب صيد

262
00:22:36,950 --> 00:22:40,600
!سيكون من الجميل أن أكون قبطان سفينة كهذه يومًا ما

263
00:22:43,540 --> 00:22:45,060
!عامّيّ

264
00:22:54,030 --> 00:22:55,570
!يا لوقاحته

265
00:22:56,470 --> 00:22:59,210
!أصيب قارب الصّيد

266
00:23:11,440 --> 00:23:14,390
.يعود كلّ من إيس ودادان إلى مخبئهما

267
00:23:14,390 --> 00:23:16,640
،بينما يفرح الجميع بعودتهما الآمنة

268
00:23:16,640 --> 00:23:20,360
.يعلمون بشأن الفاجعة الّتي ألمّت سابو في الميناء

269
00:23:20,360 --> 00:23:23,120
،بعد أن أدركا بعطف ما كان يحاول سابو فعله

270
00:23:23,120 --> 00:23:26,480
.وقع لوفي وإيس في النّدم والحزن

271
00:23:26,480 --> 00:23:27,960
:في الحلقة القادمة من وان بيس

272
00:23:27,960 --> 00:23:31,010
"!اعتن به جيّدًا! رسالة من الأخ"

273
00:23:31,010 --> 00:23:33,470
!ملك القراصنة، لن يكون إلاّ أنا

274
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة