1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:09,860 --> 00:02:12,000
!كوزكي أودن

29
00:02:14,290 --> 00:02:19,010
!كنت في انتظار رجل مثلك

30
00:02:21,170 --> 00:02:27,260
!لن أسمح لك بحكم بلاد وانو على هواك بعد الآن

31
00:02:29,260 --> 00:02:31,640
.مثير للاهتمام

32
00:02:38,980 --> 00:02:43,530
!اختاروا الآن يا ساموراي أوروتشي

33
00:02:44,400 --> 00:02:48,410
!أتريدون الموت مع سيّدكم أوروتشي هنا؟

34
00:02:48,410 --> 00:02:50,990
!أم تريدون غزو العالم معنا؟

35
00:02:52,700 --> 00:02:57,040
.أعلم ما مدى ولائكم أيّها السّاموراي

36
00:02:57,750 --> 00:03:03,000
!حتّى أولئك الّذين تحدّوني يحظون بإعجابي

37
00:03:05,710 --> 00:03:08,430
.ستتغيّر بلاد وانو

38
00:03:08,430 --> 00:03:11,700
،إلى جانب حلفائنا الجدد

39
00:03:11,700 --> 00:03:16,810
!سنبني أسسًا جديدة لهذا العالم

40
00:03:25,730 --> 00:03:28,110
ما الّذي ستفعلونه؟

41
00:03:41,080 --> 00:03:46,760
!قوّات نينجا بلاد وانو والأونيوابانشو
!خمسة آلاف محارب

42
00:03:46,760 --> 00:03:49,630
!نودّ خدمتك

43
00:03:50,170 --> 00:03:54,410
،وكذلك قوّات ساموراي بلاد وانو
!خمسة آلاف محارب

44
00:03:54,410 --> 00:03:56,430
!سنخدمك بدءًا من الآن

45
00:03:58,680 --> 00:04:00,690
!نرحّب بكم

46
00:04:06,110 --> 00:04:08,030
...أوروتشي-ساما

47
00:04:08,480 --> 00:04:10,150
...لا أحد يهتمّ

48
00:04:11,530 --> 00:04:16,570
ممتاز! لم أكن أريد أن أصير عدوّكم
!فجأة ومحاولة قتلكم

49
00:04:16,570 --> 00:04:18,660
!أتطلّع قدمًا للعمل معكم

50
00:04:22,540 --> 00:04:25,420
!لا يستحقّون حتّى أن يوصفون بالسّاموراي

51
00:04:25,420 --> 00:04:27,670
!اصبر الآن أيّها الزّعيم هيوغورو

52
00:04:31,590 --> 00:04:37,060
...لا أصدّق أنّك جنّدت أتباع الشّوغن عديم النّفع

53
00:04:37,060 --> 00:04:40,100
!أنت بارع للغاية

54
00:04:46,650 --> 00:04:51,450
!والآن، القوّات منظّمة جيّدًا

55
00:04:58,660 --> 00:05:00,160
!اتركوني

56
00:05:00,160 --> 00:05:03,040
!كلاّ! توقّف

57
00:05:03,040 --> 00:05:06,090
...أبقوهما مقيّدتان

58
00:05:10,130 --> 00:05:13,070
!لن أسمح للأمور بالسّير على هواكم

59
00:05:13,070 --> 00:05:16,510
،إن استطاعت شينوبو-تشان الهرب
!فستكون لدينا فرصة

60
00:05:16,720 --> 00:05:18,620
!أنا آسفة يا أونامي

61
00:05:18,620 --> 00:05:20,600
!سأواصل وحدي

62
00:05:21,140 --> 00:05:23,310
!أسرعي لإنقاذ مومو-تشان

63
00:05:24,430 --> 00:05:26,920
!علم أودن-ساما بهذا

64
00:05:26,920 --> 00:05:29,860
!الإطاحة بأوروتشي لن تغيّر أيّ شيء

65
00:05:30,190 --> 00:05:35,200
لعشرين سنة، كان كايدو هو الوحيد
!الّذي يجب علينا الإطاحة به

66
00:05:38,410 --> 00:05:40,160
!يا رفاق

67
00:05:40,160 --> 00:05:43,290
،لنثأر لسيّدنا أودن-ساما الرّاحل

68
00:05:43,290 --> 00:05:44,790
...و

69
00:05:44,790 --> 00:05:49,210
،لإنقاذ مومونوسكي-ساما
!فإنّ هدفنا واحد لن يتغيّر

70
00:05:51,880 --> 00:05:53,940
!قطع رأس كايدو

71
00:05:53,940 --> 00:05:56,090
!هيّا بنا

72
00:05:58,510 --> 00:06:03,310
"!غارة! إرادة أودن الموروثة"

73
00:06:15,700 --> 00:06:18,280
،في بلاد وانو الآن

74
00:06:18,280 --> 00:06:23,790
!لا يوجد شوغن أو ساموراي يعملون تحت إمرته

75
00:06:24,830 --> 00:06:27,500
...لا بدّ أنّ سكّان عاصمة الزّهور الحمقى

76
00:06:27,500 --> 00:06:32,670
منغمسون بالاحتفاليّات كثيرًا ولن يلحظوا
!أنّ هذا سيكون يومهم الأخير

77
00:06:42,890 --> 00:06:46,730
ما الّذي تراه في المستقبل الّذي تتخيّله؟

78
00:06:47,180 --> 00:06:51,400
.أيّها الشّقيّ! لطالما ساورتني الشّكوك

79
00:06:52,190 --> 00:06:54,920
...إنّ جبانًا مثلك

80
00:06:54,920 --> 00:06:59,540
!لا يمكن أن يكون ابن كوزكي أودن الجريء ذاك

81
00:07:01,410 --> 00:07:03,410
...أنا

82
00:07:06,080 --> 00:07:12,550
إنّ الغاية من هذا الإعدام هو وضع
.حدّ لبلاد وانو القديمة

83
00:07:12,550 --> 00:07:15,950
،بالنّظر إلى ذلك اليوم قبل 20 سنة

84
00:07:15,950 --> 00:07:18,890
....في القلعة المحترقة، فإنّك

85
00:07:20,600 --> 00:07:24,390
!لم تجبني عن سؤالي

86
00:07:28,850 --> 00:07:31,690
...النّجدة

87
00:07:37,740 --> 00:07:41,120
.كان والدك سيّدًا سخيفًا

88
00:07:41,700 --> 00:07:45,830
...كان والدي ساموراي عظيمًا

89
00:07:46,200 --> 00:07:48,040
...وأنا

90
00:07:49,370 --> 00:07:56,970
!من سيحكم هذه البلاد يومًا ما

91
00:07:57,380 --> 00:07:59,430
!ما اسمك؟

92
00:07:59,880 --> 00:08:01,550
!انطق به

93
00:08:02,130 --> 00:08:03,600
...مو

94
00:08:05,510 --> 00:08:07,180
!يا والدي

95
00:08:07,470 --> 00:08:10,610
!ليساعدني أحد ما

96
00:08:18,400 --> 00:08:23,550
،إن لم تكن ابن كوزكي أودن وتوكي

97
00:08:23,550 --> 00:08:26,620
.فسألغي إعدامك في الحال

98
00:08:27,070 --> 00:08:31,460
.سيلحق بي العار لأنّه سيكون اتّهامًا كاذبًا

99
00:08:35,750 --> 00:08:40,090
،لكنّك إن قلت أنّك ابنهما بإصرار

100
00:08:40,550 --> 00:08:45,390
.فستواجه نفس مصير أودن

101
00:08:49,470 --> 00:08:50,940
!مومو-تشان

102
00:08:51,270 --> 00:08:54,110
!دعني أذهب! لا أتحمّل هذا أكثر

103
00:09:00,690 --> 00:09:03,870
.دعني أسألك مرّة أخرى أيّها الشّقيّ

104
00:09:05,280 --> 00:09:07,290
!ما اسمك؟

105
00:09:11,250 --> 00:09:13,410
!يا لكرم كايدو-ساما

106
00:09:13,410 --> 00:09:18,510
!كلّ ما على ذلك الشّقيّ فعله هو الكذب وسينجو

107
00:09:19,840 --> 00:09:23,680
!فكّر في اسم مضحك يا فتى

108
00:09:27,720 --> 00:09:31,730
!ابق حيًّا أرجوك حتّى إن عنى ذلك أن تكذب

109
00:09:31,730 --> 00:09:34,110
!مومونوسكي-ساما

110
00:09:59,920 --> 00:10:02,650
...ماذا؟! ذلك الفتى

111
00:10:02,650 --> 00:10:05,800
!هو كوزكي مومونوسكي الحقيقيّ؟

112
00:10:05,800 --> 00:10:09,680
!هذا صحيح! جميع أتباع أودن أحياء

113
00:10:10,350 --> 00:10:11,850
!ماذا؟

114
00:10:15,470 --> 00:10:16,900
!دخلاء

115
00:10:21,780 --> 00:10:24,400
!ابتعدوا عن طريقي

116
00:10:29,030 --> 00:10:34,250
...إن كان جميع ساموراي الأكازايا الّذين رأيتهم ذلك اليوم

117
00:10:36,660 --> 00:10:40,290
!إن كانوا ما زالوا أحياء، فذلك عظيم

118
00:10:40,290 --> 00:10:42,550
!هذا عظيم

119
00:10:42,550 --> 00:10:44,800
!لا أصدّق

120
00:10:45,630 --> 00:10:47,840
!مومونوسكي في انتظاركم

121
00:10:49,140 --> 00:10:53,430
!لنسرع! إنّهم هنا، صحيح؟ الأكازايا التّسعة

122
00:10:53,430 --> 00:10:55,940
!أنزلني يا ياما-أو

123
00:10:56,470 --> 00:10:58,680
ياما-أو؟ لماذا تناديني هكذا؟

124
00:10:58,680 --> 00:11:02,360
!توقّف رجاءً يا ياماتو-ساما

125
00:11:03,110 --> 00:11:04,520
!توقّف

126
00:11:04,520 --> 00:11:08,160
السّيّد الصّغير ياماتو وقبّعة القشّ
!لوفي متّجهان إلى الطّابق

127
00:11:08,160 --> 00:11:09,950
إلى طابق العرض؟

128
00:11:09,950 --> 00:11:12,740
!نعم! سوف نمسك بهما

129
00:11:12,740 --> 00:11:15,830
...لا، لا تحاولوا. لستم ندًّا لهما

130
00:11:17,410 --> 00:11:19,960
!كيف أمكنهما العبث مع رجالي؟

131
00:11:20,330 --> 00:11:22,840
!ياماتو

132
00:11:23,250 --> 00:11:25,460
!سأجعلك تدفع الثّمن

133
00:11:31,680 --> 00:11:34,720
!لا يا أوسوبّ! ليس كهذا

134
00:11:34,720 --> 00:11:37,100
!يبدو هذا خطيرًا

135
00:11:37,100 --> 00:11:40,250
!سمعتَ البثّ قبل قليل

136
00:11:40,250 --> 00:11:42,280
!سيقتلون مومو

137
00:11:43,730 --> 00:11:45,190
!العمالقة

138
00:11:46,150 --> 00:11:50,410
!سيلتهموننا! لنعد أدراجنا يا أوسوبّ

139
00:11:50,410 --> 00:11:54,990
!لا تخف يا تشوبّر! قاتلنا أحد اليونكو بشكل متقارب

140
00:11:55,200 --> 00:11:59,960
ضع ثقتك بصلابة الجنرال فرانكي
!الّذي تحمّل حتّى هجمات بيغ مام

141
00:11:59,960 --> 00:12:03,330
!لا يمكنني! لا يمكنني تحمّل أولئك الوحوش

142
00:12:03,330 --> 00:12:06,960
!لا تستسلم! لا تستسلم أبدًا

143
00:12:06,960 --> 00:12:10,140
!ما أوامرك يا قائد الدّبّابة تشوبّر؟

144
00:12:12,840 --> 00:12:14,760
!انسحاب! انسحاب

145
00:12:14,760 --> 00:12:16,850
!جاكي

146
00:12:21,350 --> 00:12:23,150
!كم هذا مزعج

147
00:12:23,150 --> 00:12:26,820
!ما الّذي يفعله أحد بقايا قراصنة اللّحية البيضاء هنا؟

148
00:12:26,820 --> 00:12:31,660
!أنا هنا للقضاء على الآفات
!شكّلتم تحالفًا مع كايدو، صحيح؟

149
00:12:34,400 --> 00:12:38,670
!أنا هنا لتحطيم ذلك التّحالف

150
00:12:39,290 --> 00:12:44,060
!لا نحتاج للانضمام إلى جانب أولئك الوحوش

151
00:12:44,060 --> 00:12:46,710
!لن يجلب لنا سوى المشاكل

152
00:12:47,040 --> 00:12:49,650
!وكذلك أنت يا ماركو

153
00:12:49,650 --> 00:12:51,680
!لن أسامحك أبدًا

154
00:12:54,300 --> 00:12:58,790
.أتمنّى أن أقول ذلك، لكنّني لستُ غبيًّا

155
00:12:58,790 --> 00:13:01,440
...أنا في مواجهة أحد اليونكو

156
00:13:01,440 --> 00:13:03,930
!ما الّذي تثرثر به-يوي؟

157
00:13:03,930 --> 00:13:08,980
كايدو عدوّ مشترك لنا، صحيح؟

158
00:13:11,900 --> 00:13:14,530
.راودتني فكرة جيّدة

159
00:13:16,780 --> 00:13:21,790
!سيغزو قراصنة بيغ مام هذا العالم

160
00:13:21,790 --> 00:13:25,410
!وستصبح ماما ملك القراصنة

161
00:13:25,410 --> 00:13:27,670
...سوف نقتل

162
00:13:27,670 --> 00:13:31,800
.كلّ من يقفون في طريقنا

163
00:13:51,320 --> 00:13:54,320
!انطق به أيّها الشّقيّ

164
00:13:54,320 --> 00:13:56,750
!ما اسمك؟

165
00:13:59,410 --> 00:14:03,350
...من المستحيل لي

166
00:14:03,350 --> 00:14:06,040
!أن أطيح بكايدو

167
00:14:06,580 --> 00:14:09,190
،لأنّ والدك رجل عظيم

168
00:14:09,190 --> 00:14:14,350
.وأنت هو الرّجل الّذي سيحكم هذه البلاد يومًا ما

169
00:14:15,840 --> 00:14:17,640
...والدتي

170
00:14:19,090 --> 00:14:21,020
!هل أنت خائف؟

171
00:14:22,390 --> 00:14:27,810
!كفاك من هراء السّاموراي ذاك
!سوف أصير ملك القراصنة يومًا ما

172
00:14:29,690 --> 00:14:32,570
!هل أنت مجرّد دمية يا مومو؟

173
00:14:33,440 --> 00:14:35,450
!هل ستبكي فحسب؟

174
00:14:48,040 --> 00:14:50,330
معنى اسمك؟

175
00:14:50,330 --> 00:14:51,250
!نعم

176
00:14:53,460 --> 00:14:59,560
أريدك أن تصير رجلاً عطوفًا
.وواسع الأفق ومحطّ إعجاب

177
00:15:03,390 --> 00:15:04,640
!مومو

178
00:15:06,140 --> 00:15:07,730
..."كلمة "مومو

179
00:15:07,730 --> 00:15:11,400
!"تعني "لا مثيل له

180
00:15:12,480 --> 00:15:14,400
...واسمي هو

181
00:15:14,400 --> 00:15:17,320
!كوزكي مومونوسكي

182
00:15:17,690 --> 00:15:21,300
...إنّ شوغن بلاد وانو

183
00:15:21,300 --> 00:15:26,580
!لن يكون سواي أنا

184
00:15:32,670 --> 00:15:34,710
!مومونوسكي-ساما

185
00:15:36,590 --> 00:15:39,390
!يا لشجاعتك يا مومونوسكي

186
00:15:45,680 --> 00:15:49,770
!سأنقذك مهما كلّف الثّمن يا مومونوسكي-ساما

187
00:15:51,100 --> 00:15:54,050
!أحسنت القول يا مومونوسكي

188
00:15:54,050 --> 00:15:55,570
!كدنا نصل يا لوفي

189
00:15:58,030 --> 00:16:01,030
!سأنتزع هذه كما وعدت

190
00:16:01,030 --> 00:16:02,200
!أرجوك

191
00:16:03,490 --> 00:16:06,220
...من باب الحيطة فحسب

192
00:16:06,220 --> 00:16:08,000
...ارمهما بعيدًا

193
00:16:08,000 --> 00:16:12,130
...مع أنّي لا أظنّ أنّهما سينفجران

194
00:16:21,210 --> 00:16:24,970
!ألا يوجد سوى الأغبياء في بلاد وانو؟

195
00:16:32,600 --> 00:16:35,690
...والدي... والدتي

196
00:16:35,900 --> 00:16:39,110
...أردت فقط أن أكون الرّجل

197
00:16:39,440 --> 00:16:45,540
الّذي لن يكون خجلاً من نفسه
.عندما يلتقي بكما في الحياة الأخرى

198
00:16:45,910 --> 00:16:50,360
...هيوري، أتمنّى لو أمكنني رؤيتك ثانية ولو قليلاً

199
00:16:50,360 --> 00:16:52,440
!لا أريد الموت

200
00:16:52,440 --> 00:16:54,790
!لا أريد البكاء

201
00:16:54,790 --> 00:16:57,920
...لا يجب على السّاموراي البكاء أمام النّاس

202
00:16:57,920 --> 00:17:00,260
...كم هذا محرج

203
00:17:10,480 --> 00:17:11,770
!انتزعتهما

204
00:17:16,560 --> 00:17:19,440
!ما الّذي يحدث؟

205
00:17:19,860 --> 00:17:22,320
!هذا ساخن! ساخن! ساخن

206
00:17:23,610 --> 00:17:24,700
!لا يمكن

207
00:17:24,700 --> 00:17:25,950
!لوفي؟

208
00:17:25,950 --> 00:17:28,290
!سُحقًا

209
00:17:28,290 --> 00:17:32,290
!ذلك الغوريلاّ الثّور

210
00:17:33,330 --> 00:17:37,590
!كان سيقتلني

211
00:17:39,540 --> 00:17:42,150
!ما كان ذلك الانفجار؟

212
00:17:42,150 --> 00:17:44,340
!اكتشفوا الأمر حالاً

213
00:17:52,010 --> 00:17:53,870
!فهمت

214
00:17:53,870 --> 00:17:57,770
!ما عاد أبي

215
00:17:58,400 --> 00:18:01,240
!الـ-الـ-السّيّد الصّغير

216
00:18:01,530 --> 00:18:05,070
!سأتولّى أمره بنفسي

217
00:18:06,740 --> 00:18:10,450
!هل أنت من وراء هذا أيّها الشّقيّ المدلّل؟

218
00:18:29,180 --> 00:18:30,600
!تمهّل يا ياما-أو

219
00:18:31,050 --> 00:18:33,900
!أب لعين

220
00:18:49,700 --> 00:18:51,450
!اتركني

221
00:18:51,450 --> 00:18:54,030
!اهدأ يا ياما-أو

222
00:18:54,030 --> 00:18:57,170
!اسمي ياماتو! لا تقف في طريقي

223
00:19:01,670 --> 00:19:03,860
...وصلنا في الوقت المناسب

224
00:19:03,860 --> 00:19:06,720
!لكن لا يفترض أن يكون أنا أو ياما-أو

225
00:19:13,140 --> 00:19:17,520
!لسنا من سيبدأ هذه المعركة الكبيرة

226
00:20:28,460 --> 00:20:30,130
!ساموراي الأكازايا

227
00:20:30,130 --> 00:20:31,930
!من أين أتوا؟

228
00:20:36,850 --> 00:20:40,690
!حاكما المينك؟! إنهما حيّان

229
00:20:43,770 --> 00:20:47,110
!هؤلاء الأشباح الملاعين! سأردّ هجومكم

230
00:20:51,320 --> 00:20:52,820
!إيزو

231
00:20:55,120 --> 00:20:57,390
!حمقى

232
00:20:57,390 --> 00:20:59,620
!كفاكم شربًا

233
00:21:00,370 --> 00:21:02,250
!احملوا أسلحتكم

234
00:21:02,250 --> 00:21:04,790
!نتعرّض لغارة

235
00:21:05,870 --> 00:21:07,300
...هل أنت

236
00:21:07,300 --> 00:21:09,430
!كيوشيرو؟

237
00:21:09,800 --> 00:21:11,840
!كايدو

238
00:21:14,800 --> 00:21:17,600
!أيّها الأوغاد نصف الأموات

239
00:21:23,140 --> 00:21:25,560
.تخلّوا عن أسمائكم

240
00:21:25,890 --> 00:21:28,150
.تخلّوا عن أذهانكم

241
00:21:29,030 --> 00:21:31,470
...إن أنصالكم

242
00:21:31,470 --> 00:21:34,490
!لا يمكنها قطعي

243
00:21:41,080 --> 00:21:45,420
!ضعوا حياتكم على المحكّ لهذه الهجمة

244
00:21:47,080 --> 00:21:49,050
!أودن

245
00:21:49,050 --> 00:21:53,430
!إيّاك والرّجوع لبلاد وانو

246
00:22:06,940 --> 00:22:09,900
!سوناتشي

247
00:22:27,500 --> 00:22:29,630
...أودن

248
00:22:33,590 --> 00:22:37,270
!لا يمكنني أن أخسر

249
00:23:04,120 --> 00:23:07,940
!ينزل أعضاء الأكازايا أخيرًا العقاب على كايدو

250
00:23:07,940 --> 00:23:12,590
يتردّد صدى صرخات مؤلمة في جميع أنحاء
!أونيغاشيما ويبدأ تحالف اليونكو بالانهيار

251
00:23:12,590 --> 00:23:16,240
!ويتحدّى لوفي بيغ مام الغاضبة للقتال

252
00:23:16,240 --> 00:23:22,230
المعركة الكبيرة من أجل مستقبل
!بلاد وانو ولقب ملك القراصنة بدأت

253
00:23:22,510 --> 00:23:27,640
:في الحلقة القادمة من وان بيس
"!شغب في أونيغاشيما! تبدأ حرب لوفي الشّاملة"

254
00:23:27,640 --> 00:23:31,650
!ملك القراصنة، لن يكون إلاّ أنا