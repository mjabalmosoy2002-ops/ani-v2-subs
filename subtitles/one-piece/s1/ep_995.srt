1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:23,860 --> 00:02:26,000
!كوزكي أودن

29
00:02:28,290 --> 00:02:33,010
!كنت في انتظار رجل مثلك

30
00:02:35,170 --> 00:02:41,260
!لن أسمح لك بحكم بلاد وانو على هواك بعد الآن

31
00:02:43,260 --> 00:02:45,640
.مثير للاهتمام

32
00:02:52,980 --> 00:02:57,530
!اختاروا الآن يا ساموراي أوروتشي

33
00:02:58,400 --> 00:03:02,410
!أتريدون الموت مع سيّدكم أوروتشي هنا؟

34
00:03:02,410 --> 00:03:04,990
!أم تريدون غزو العالم معنا؟

35
00:03:06,700 --> 00:03:11,040
.أعلم ما مدى ولائكم أيّها السّاموراي

36
00:03:11,750 --> 00:03:17,000
!حتّى أولئك الّذين تحدّوني يحظون بإعجابي

37
00:03:19,710 --> 00:03:22,430
.ستتغيّر بلاد وانو

38
00:03:22,430 --> 00:03:25,700
،إلى جانب حلفائنا الجدد

39
00:03:25,700 --> 00:03:30,810
!سنبني أسسًا جديدة لهذا العالم

40
00:03:39,730 --> 00:03:42,110
ما الّذي ستفعلونه؟

41
00:03:55,080 --> 00:04:00,760
!قوّات نينجا بلاد وانو والأونيوابانشو
!خمسة آلاف محارب

42
00:04:00,760 --> 00:04:03,630
!نودّ خدمتك

43
00:04:04,170 --> 00:04:08,410
،وكذلك قوّات ساموراي بلاد وانو
!خمسة آلاف محارب

44
00:04:08,410 --> 00:04:10,430
!سنخدمك بدءًا من الآن

45
00:04:12,680 --> 00:04:14,690
!نرحّب بكم

46
00:04:20,110 --> 00:04:22,030
...أوروتشي-ساما

47
00:04:22,480 --> 00:04:24,150
...لا أحد يهتمّ

48
00:04:25,530 --> 00:04:30,570
ممتاز! لم أكن أريد أن أصير عدوّكم
!فجأة ومحاولة قتلكم

49
00:04:30,570 --> 00:04:32,660
!أتطلّع قدمًا للعمل معكم

50
00:04:36,540 --> 00:04:39,420
!لا يستحقّون حتّى أن يوصفون بالسّاموراي

51
00:04:39,420 --> 00:04:41,670
!اصبر الآن أيّها الزّعيم هيوغورو

52
00:04:45,590 --> 00:04:51,060
...لا أصدّق أنّك جنّدت أتباع الشّوغن عديم النّفع

53
00:04:51,060 --> 00:04:54,100
!أنت بارع للغاية

54
00:05:00,650 --> 00:05:05,450
!والآن، القوّات منظّمة جيّدًا

55
00:05:12,660 --> 00:05:14,160
!اتركوني

56
00:05:14,160 --> 00:05:17,040
!كلاّ! توقّف

57
00:05:17,040 --> 00:05:20,090
...أبقوهما مقيّدتان

58
00:05:24,130 --> 00:05:27,070
!لن أسمح للأمور بالسّير على هواكم

59
00:05:27,070 --> 00:05:30,510
،إن استطاعت شينوبو-تشان الهرب
!فستكون لدينا فرصة

60
00:05:30,720 --> 00:05:32,620
!أنا آسفة يا أونامي

61
00:05:32,620 --> 00:05:34,600
!سأواصل وحدي

62
00:05:35,140 --> 00:05:37,310
!أسرعي لإنقاذ مومو-تشان

63
00:05:38,430 --> 00:05:40,920
!علم أودن-ساما بهذا

64
00:05:40,920 --> 00:05:43,860
!الإطاحة بأوروتشي لن تغيّر أيّ شيء

65
00:05:44,190 --> 00:05:49,200
لعشرين سنة، كان كايدو هو الوحيد
!الّذي يجب علينا الإطاحة به

66
00:05:52,410 --> 00:05:54,160
!يا رفاق

67
00:05:54,160 --> 00:05:57,290
،لنثأر لسيّدنا أودن-ساما الرّاحل

68
00:05:57,290 --> 00:05:58,790
...و

69
00:05:58,790 --> 00:06:03,210
،لإنقاذ مومونوسكي-ساما
!فإنّ هدفنا واحد لن يتغيّر

70
00:06:05,880 --> 00:06:07,940
!قطع رأس كايدو

71
00:06:07,940 --> 00:06:10,090
!هيّا بنا

72
00:06:12,510 --> 00:06:17,310
"!غارة! إرادة أودن الموروثة"

73
00:06:29,700 --> 00:06:32,280
،في بلاد وانو الآن

74
00:06:32,280 --> 00:06:37,790
!لا يوجد شوغن أو ساموراي يعملون تحت إمرته

75
00:06:38,830 --> 00:06:41,500
...لا بدّ أنّ سكّان عاصمة الزّهور الحمقى

76
00:06:41,500 --> 00:06:46,670
منغمسون بالاحتفاليّات كثيرًا ولن يلحظوا
!أنّ هذا سيكون يومهم الأخير

77
00:06:56,890 --> 00:07:00,730
ما الّذي تراه في المستقبل الّذي تتخيّله؟

78
00:07:01,180 --> 00:07:05,400
.أيّها الشّقيّ! لطالما ساورتني الشّكوك

79
00:07:06,190 --> 00:07:08,920
...إنّ جبانًا مثلك

80
00:07:08,920 --> 00:07:13,540
!لا يمكن أن يكون ابن كوزكي أودن الجريء ذاك

81
00:07:15,410 --> 00:07:17,410
...أنا

82
00:07:20,080 --> 00:07:26,550
إنّ الغاية من هذا الإعدام هو وضع
.حدّ لبلاد وانو القديمة

83
00:07:26,550 --> 00:07:29,950
،بالنّظر إلى ذلك اليوم قبل 20 سنة

84
00:07:29,950 --> 00:07:32,890
....في القلعة المحترقة، فإنّك

85
00:07:34,600 --> 00:07:38,390
!لم تجبني عن سؤالي

86
00:07:42,850 --> 00:07:45,690
...النّجدة

87
00:07:51,740 --> 00:07:55,120
.كان والدك سيّدًا سخيفًا

88
00:07:55,700 --> 00:07:59,830
...كان والدي ساموراي عظيمًا

89
00:08:00,200 --> 00:08:02,040
...وأنا

90
00:08:03,370 --> 00:08:10,970
!من سيحكم هذه البلاد يومًا ما

91
00:08:11,380 --> 00:08:13,430
!ما اسمك؟

92
00:08:13,880 --> 00:08:15,550
!انطق به

93
00:08:16,130 --> 00:08:17,600
...مو

94
00:08:19,510 --> 00:08:21,180
!يا والدي

95
00:08:21,470 --> 00:08:24,610
!ليساعدني أحد ما

96
00:08:32,400 --> 00:08:37,550
،إن لم تكن ابن كوزكي أودن وتوكي

97
00:08:37,550 --> 00:08:40,620
.فسألغي إعدامك في الحال

98
00:08:41,070 --> 00:08:45,460
.سيلحق بي العار لأنّه سيكون اتّهامًا كاذبًا

99
00:08:49,750 --> 00:08:54,090
،لكنّك إن قلت أنّك ابنهما بإصرار

100
00:08:54,550 --> 00:08:59,390
.فستواجه نفس مصير أودن

101
00:09:03,470 --> 00:09:04,940
!مومو-تشان

102
00:09:05,270 --> 00:09:08,110
!دعني أذهب! لا أتحمّل هذا أكثر

103
00:09:14,690 --> 00:09:17,870
.دعني أسألك مرّة أخرى أيّها الشّقيّ

104
00:09:19,280 --> 00:09:21,290
!ما اسمك؟

105
00:09:25,250 --> 00:09:27,410
!يا لكرم كايدو-ساما

106
00:09:27,410 --> 00:09:32,510
!كلّ ما على ذلك الشّقيّ فعله هو الكذب وسينجو

107
00:09:33,840 --> 00:09:37,680
!فكّر في اسم مضحك يا فتى

108
00:09:41,720 --> 00:09:45,730
!ابق حيًّا أرجوك حتّى إن عنى ذلك أن تكذب

109
00:09:45,730 --> 00:09:48,110
!مومونوسكي-ساما

110
00:10:13,920 --> 00:10:16,650
...ماذا؟! ذلك الفتى

111
00:10:16,650 --> 00:10:19,800
!هو كوزكي مومونوسكي الحقيقيّ؟

112
00:10:19,800 --> 00:10:23,680
!هذا صحيح! جميع أتباع أودن أحياء

113
00:10:24,350 --> 00:10:25,850
!ماذا؟

114
00:10:29,470 --> 00:10:30,900
!دخلاء

115
00:10:35,780 --> 00:10:38,400
!ابتعدوا عن طريقي

116
00:10:43,030 --> 00:10:48,250
...إن كان جميع ساموراي الأكازايا الّذين رأيتهم ذلك اليوم

117
00:10:50,660 --> 00:10:54,290
!إن كانوا ما زالوا أحياء، فذلك عظيم

118
00:10:54,290 --> 00:10:56,550
!هذا عظيم

119
00:10:56,550 --> 00:10:58,800
!لا أصدّق

120
00:10:59,630 --> 00:11:01,840
!مومونوسكي في انتظاركم

121
00:11:03,140 --> 00:11:07,430
!لنسرع! إنّهم هنا، صحيح؟ الأكازايا التّسعة

122
00:11:07,430 --> 00:11:09,940
!أنزلني يا ياما-أو

123
00:11:10,470 --> 00:11:12,680
ياما-أو؟ لماذا تناديني هكذا؟

124
00:11:12,680 --> 00:11:16,360
!توقّف رجاءً يا ياماتو-ساما

125
00:11:17,110 --> 00:11:18,520
!توقّف

126
00:11:18,520 --> 00:11:22,160
السّيّد الصّغير ياماتو وقبّعة القشّ
!لوفي متّجهان إلى الطّابق

127
00:11:22,160 --> 00:11:23,950
إلى طابق العرض؟

128
00:11:23,950 --> 00:11:26,740
!نعم! سوف نمسك بهما

129
00:11:26,740 --> 00:11:29,830
...لا، لا تحاولوا. لستم ندًّا لهما

130
00:11:31,410 --> 00:11:33,960
!كيف أمكنهما العبث مع رجالي؟

131
00:11:34,330 --> 00:11:36,840
!ياماتو

132
00:11:37,250 --> 00:11:39,460
!سأجعلك تدفع الثّمن

133
00:11:45,680 --> 00:11:48,720
!لا يا أوسوبّ! ليس كهذا

134
00:11:48,720 --> 00:11:51,100
!يبدو هذا خطيرًا

135
00:11:51,100 --> 00:11:54,250
!سمعتَ البثّ قبل قليل

136
00:11:54,250 --> 00:11:56,280
!سيقتلون مومو

137
00:11:57,730 --> 00:11:59,190
!العمالقة

138
00:12:00,150 --> 00:12:04,410
!سيلتهموننا! لنعد أدراجنا يا أوسوبّ

139
00:12:04,410 --> 00:12:08,990
!لا تخف يا تشوبّر! قاتلنا أحد اليونكو بشكل متقارب

140
00:12:09,200 --> 00:12:13,960
ضع ثقتك بصلابة الجنرال فرانكي
!الّذي تحمّل حتّى هجمات بيغ مام

141
00:12:13,960 --> 00:12:17,330
!لا يمكنني! لا يمكنني تحمّل أولئك الوحوش

142
00:12:17,330 --> 00:12:20,960
!لا تستسلم! لا تستسلم أبدًا

143
00:12:20,960 --> 00:12:24,140
!ما أوامرك يا قائد الدّبّابة تشوبّر؟

144
00:12:26,840 --> 00:12:28,760
!انسحاب! انسحاب

145
00:12:28,760 --> 00:12:30,850
!جاكي

146
00:12:35,350 --> 00:12:37,150
!كم هذا مزعج

147
00:12:37,150 --> 00:12:40,820
!ما الّذي يفعله أحد بقايا قراصنة اللّحية البيضاء هنا؟

148
00:12:40,820 --> 00:12:45,660
!أنا هنا للقضاء على الآفات
!شكّلتم تحالفًا مع كايدو، صحيح؟

149
00:12:48,400 --> 00:12:52,670
!أنا هنا لتحطيم ذلك التّحالف

150
00:12:53,290 --> 00:12:58,060
!لا نحتاج للانضمام إلى جانب أولئك الوحوش

151
00:12:58,060 --> 00:13:00,710
!لن يجلب لنا سوى المشاكل

152
00:13:01,040 --> 00:13:03,650
!وكذلك أنت يا ماركو

153
00:13:03,650 --> 00:13:05,680
!لن أسامحك أبدًا

154
00:13:08,300 --> 00:13:12,790
.أتمنّى أن أقول ذلك، لكنّني لستُ غبيًّا

155
00:13:12,790 --> 00:13:15,440
...أنا في مواجهة أحد اليونكو

156
00:13:15,440 --> 00:13:17,930
!ما الّذي تثرثر به-يوي؟

157
00:13:17,930 --> 00:13:22,980
كايدو عدوّ مشترك لنا، صحيح؟

158
00:13:25,900 --> 00:13:28,530
.راودتني فكرة جيّدة

159
00:13:30,780 --> 00:13:35,790
!سيغزو قراصنة بيغ مام هذا العالم

160
00:13:35,790 --> 00:13:39,410
!وستصبح ماما ملك القراصنة

161
00:13:39,410 --> 00:13:41,670
...سوف نقتل

162
00:13:41,670 --> 00:13:45,800
.كلّ من يقفون في طريقنا

163
00:14:05,320 --> 00:14:08,320
!انطق به أيّها الشّقيّ

164
00:14:08,320 --> 00:14:10,750
!ما اسمك؟

165
00:14:13,410 --> 00:14:17,350
...من المستحيل لي

166
00:14:17,350 --> 00:14:20,040
!أن أطيح بكايدو

167
00:14:20,580 --> 00:14:23,190
،لأنّ والدك رجل عظيم

168
00:14:23,190 --> 00:14:28,350
.وأنت هو الرّجل الّذي سيحكم هذه البلاد يومًا ما

169
00:14:29,840 --> 00:14:31,640
...والدتي

170
00:14:33,090 --> 00:14:35,020
!هل أنت خائف؟

171
00:14:36,390 --> 00:14:41,810
!كفاك من هراء السّاموراي ذاك
!سوف أصير ملك القراصنة يومًا ما

172
00:14:43,690 --> 00:14:46,570
!هل أنت مجرّد دمية يا مومو؟

173
00:14:47,440 --> 00:14:49,450
!هل ستبكي فحسب؟

174
00:15:02,040 --> 00:15:04,330
معنى اسمك؟

175
00:15:04,330 --> 00:15:05,250
!نعم

176
00:15:07,460 --> 00:15:13,560
أريدك أن تصير رجلاً عطوفًا
.وواسع الأفق ومحطّ إعجاب

177
00:15:17,390 --> 00:15:18,640
!مومو

178
00:15:20,140 --> 00:15:21,730
..."كلمة "مومو

179
00:15:21,730 --> 00:15:25,400
!"تعني "لا مثيل له

180
00:15:26,480 --> 00:15:28,400
...واسمي هو

181
00:15:28,400 --> 00:15:31,320
!كوزكي مومونوسكي

182
00:15:31,690 --> 00:15:35,300
...إنّ شوغن بلاد وانو

183
00:15:35,300 --> 00:15:40,580
!لن يكون سواي أنا

184
00:15:46,670 --> 00:15:48,710
!مومونوسكي-ساما

185
00:15:50,590 --> 00:15:53,390
!يا لشجاعتك يا مومونوسكي

186
00:15:59,680 --> 00:16:03,770
!سأنقذك مهما كلّف الثّمن يا مومونوسكي-ساما

187
00:16:05,100 --> 00:16:08,050
!أحسنت القول يا مومونوسكي

188
00:16:08,050 --> 00:16:09,570
!كدنا نصل يا لوفي

189
00:16:12,030 --> 00:16:15,030
!سأنتزع هذه كما وعدت

190
00:16:15,030 --> 00:16:16,200
!أرجوك

191
00:16:17,490 --> 00:16:20,220
...من باب الحيطة فحسب

192
00:16:20,220 --> 00:16:22,000
...ارمهما بعيدًا

193
00:16:22,000 --> 00:16:26,130
...مع أنّي لا أظنّ أنّهما سينفجران

194
00:16:35,210 --> 00:16:38,970
!ألا يوجد سوى الأغبياء في بلاد وانو؟

195
00:16:46,600 --> 00:16:49,690
...والدي... والدتي

196
00:16:49,900 --> 00:16:53,110
...أردت فقط أن أكون الرّجل

197
00:16:53,440 --> 00:16:59,540
الّذي لن يكون خجلاً من نفسه
.عندما يلتقي بكما في الحياة الأخرى

198
00:16:59,910 --> 00:17:04,360
...هيوري، أتمنّى لو أمكنني رؤيتك ثانية ولو قليلاً

199
00:17:04,360 --> 00:17:06,440
!لا أريد الموت

200
00:17:06,440 --> 00:17:08,790
!لا أريد البكاء

201
00:17:08,790 --> 00:17:11,920
...لا يجب على السّاموراي البكاء أمام النّاس

202
00:17:11,920 --> 00:17:14,260
...كم هذا محرج

203
00:17:24,480 --> 00:17:25,770
!انتزعتهما

204
00:17:30,560 --> 00:17:33,440
!ما الّذي يحدث؟

205
00:17:33,860 --> 00:17:36,320
!هذا ساخن! ساخن! ساخن

206
00:17:37,610 --> 00:17:38,700
!لا يمكن

207
00:17:38,700 --> 00:17:39,950
!لوفي؟

208
00:17:39,950 --> 00:17:42,290
!سُحقًا

209
00:17:42,290 --> 00:17:46,290
!ذلك الغوريلاّ الثّور

210
00:17:47,330 --> 00:17:51,590
!كان سيقتلني

211
00:17:53,540 --> 00:17:56,150
!ما كان ذلك الانفجار؟

212
00:17:56,150 --> 00:17:58,340
!اكتشفوا الأمر حالاً

213
00:18:06,010 --> 00:18:07,870
!فهمت

214
00:18:07,870 --> 00:18:11,770
!ما عاد أبي

215
00:18:12,400 --> 00:18:15,240
!الـ-الـ-السّيّد الصّغير

216
00:18:15,530 --> 00:18:19,070
!سأتولّى أمره بنفسي

217
00:18:20,740 --> 00:18:24,450
!هل أنت من وراء هذا أيّها الشّقيّ المدلّل؟

218
00:18:43,180 --> 00:18:44,600
!تمهّل يا ياما-أو

219
00:18:45,050 --> 00:18:47,900
!أب لعين

220
00:19:03,700 --> 00:19:05,450
!اتركني

221
00:19:05,450 --> 00:19:08,030
!اهدأ يا ياما-أو

222
00:19:08,030 --> 00:19:11,170
!اسمي ياماتو! لا تقف في طريقي

223
00:19:15,670 --> 00:19:17,860
...وصلنا في الوقت المناسب

224
00:19:17,860 --> 00:19:20,720
!لكن لا يفترض أن يكون أنا أو ياما-أو

225
00:19:27,140 --> 00:19:31,520
!لسنا من سيبدأ هذه المعركة الكبيرة

226
00:20:42,460 --> 00:20:44,130
!ساموراي الأكازايا

227
00:20:44,130 --> 00:20:45,930
!من أين أتوا؟

228
00:20:50,850 --> 00:20:54,690
!حاكما المينك؟! إنهما حيّان

229
00:20:57,770 --> 00:21:01,110
!هؤلاء الأشباح الملاعين! سأردّ هجومكم

230
00:21:05,320 --> 00:21:06,820
!إيزو

231
00:21:09,120 --> 00:21:11,390
!حمقى

232
00:21:11,390 --> 00:21:13,620
!كفاكم شربًا

233
00:21:14,370 --> 00:21:16,250
!احملوا أسلحتكم

234
00:21:16,250 --> 00:21:18,790
!نتعرّض لغارة

235
00:21:19,870 --> 00:21:21,300
...هل أنت

236
00:21:21,300 --> 00:21:23,430
!كيوشيرو؟

237
00:21:23,800 --> 00:21:25,840
!كايدو

238
00:21:28,800 --> 00:21:31,600
!أيّها الأوغاد نصف الأموات

239
00:21:37,140 --> 00:21:39,560
.تخلّوا عن أسمائكم

240
00:21:39,890 --> 00:21:42,150
.تخلّوا عن أذهانكم

241
00:21:43,030 --> 00:21:45,470
...إن أنصالكم

242
00:21:45,470 --> 00:21:48,490
!لا يمكنها قطعي

243
00:21:55,080 --> 00:21:59,420
!ضعوا حياتكم على المحكّ لهذه الهجمة

244
00:22:01,080 --> 00:22:03,050
!أودن

245
00:22:03,050 --> 00:22:07,430
!إيّاك والرّجوع لبلاد وانو

246
00:22:20,940 --> 00:22:23,900
!سوناتشي

247
00:22:41,500 --> 00:22:43,630
...أودن

248
00:22:47,590 --> 00:22:51,270
!لا يمكنني أن أخسر

249
00:23:18,120 --> 00:23:21,940
!ينزل أعضاء الأكازايا أخيرًا العقاب على كايدو

250
00:23:21,940 --> 00:23:26,590
يتردّد صدى صرخات مؤلمة في جميع أنحاء
!أونيغاشيما ويبدأ تحالف اليونكو بالانهيار

251
00:23:26,590 --> 00:23:30,240
!ويتحدّى لوفي بيغ مام الغاضبة للقتال

252
00:23:30,240 --> 00:23:36,230
المعركة الكبيرة من أجل مستقبل
!بلاد وانو ولقب ملك القراصنة بدأت

253
00:23:36,510 --> 00:23:41,640
:في الحلقة القادمة من وان بيس
"!شغب في أونيغاشيما! تبدأ حرب لوفي الشّاملة"

254
00:23:41,640 --> 00:23:45,650
!ملك القراصنة، لن يكون إلاّ أنا