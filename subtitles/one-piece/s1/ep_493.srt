1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:21,000 --> 00:03:23,700
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:23,700 --> 00:03:28,070
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:29,100 --> 00:03:35,220
.لكنّ كفاحه ذهب سدى عندما انتهت الحرب

40
00:03:40,800 --> 00:03:44,420
!إيس مات حقًّا، أليس كذلك؟

41
00:03:44,420 --> 00:03:47,170
!أجل، لقد مات

42
00:04:02,030 --> 00:04:06,280
!إيس

43
00:04:10,000 --> 00:04:13,870
"!لوفي وإيس! قصّة لقاء الأخوين"

44
00:04:19,830 --> 00:04:25,550
.تركت حرب القمّة في مارينفورد ندبةً في عقول الكثير

45
00:04:26,430 --> 00:04:29,700
،قبل 10 سنوات، في الأزرق الشّرقيّ

46
00:04:31,800 --> 00:04:36,930
كانت هناك قرية صغيرة تدعى قرية فوشا
حيث عاش النّاس بسلام

47
00:04:38,300 --> 00:04:41,590
.لكن يقع قربها جبل كولبو الّذي نادرًا ما يطأ النّاس عليه

48
00:04:42,560 --> 00:04:49,610
فقط الأقوياء يستطيعون النّجاة هناك بينما
.الضّعفاء الّذين يدخلون يكون مصيرهم الموت

49
00:04:51,390 --> 00:04:55,030
...أقصد يا جدّي

50
00:04:55,030 --> 00:04:57,330
...سأصبح ملك القراصنة

51
00:04:57,330 --> 00:04:59,580
!كفّ عن هذا الهراء

52
00:04:59,580 --> 00:05:01,750
!دعني... دعني

53
00:05:01,750 --> 00:05:05,630
،علاوة على أنّك تناولت فاكهة شيطان
!إلاّ أنّك تتكلّم بالهراء

54
00:05:05,630 --> 00:05:08,200
لوفي! عليك أنت وإيس أن تصبحا

55
00:05:08,200 --> 00:05:10,880
!أقوى جنود البحريّة

56
00:05:10,880 --> 00:05:13,060
!مؤلم، مؤلم، مؤلم، سحقًا

57
00:05:13,060 --> 00:05:15,430
!جسدي من المطّاط فلماذا هذا مؤلم؟

58
00:05:15,430 --> 00:05:17,790
!دعني يا جدّي

59
00:05:17,790 --> 00:05:21,080
!كان تركك في قرية فوشي خطأً

60
00:05:21,080 --> 00:05:24,480
!ألم تجد شيئًا تحبّه سوى القراصنة؟! أيّها الأحمق

61
00:05:25,160 --> 00:05:29,600
!لا يمكنك أن تكون صديقًا لأحمر الشّعر شانكس

62
00:05:29,600 --> 00:05:31,310
...أريد أن أصبح

63
00:05:31,310 --> 00:05:32,500
!هذا مؤلم

64
00:05:32,500 --> 00:05:34,200
!رجلاً قويًّا مثل شانكس

65
00:05:34,200 --> 00:05:35,370
!أنت

66
00:05:43,610 --> 00:05:45,120
ما هذا المكان؟

67
00:05:46,880 --> 00:05:51,710
!توقّف! أيًّا كنت، هل تريد أن تموت؟

68
00:05:51,710 --> 00:05:52,760
.هذا أنا

69
00:05:56,030 --> 00:05:58,100
!غـ-غارب-سان

70
00:06:10,900 --> 00:06:12,530
.تبدون بخير

71
00:06:12,530 --> 00:06:17,410
!بربّك! رجاءً، عليك أن ترحمني

72
00:06:17,410 --> 00:06:19,950
!إيس في العاشرة من عمره الآن

73
00:06:19,950 --> 00:06:23,580
أبالفعل؟ كيف حاله؟

74
00:06:23,580 --> 00:06:25,730
!هذا ليس مضحكًا

75
00:06:25,730 --> 00:06:29,540
!ما عاد بإمكاننا التّعامل معه! عليك أن تأخذه

76
00:06:29,540 --> 00:06:30,920
...بصرف النّظر عن ذلك

77
00:06:30,920 --> 00:06:32,510
!لا تغيّر الموضوع

78
00:06:32,510 --> 00:06:34,970
!أنت مزعج يا ولد

79
00:06:34,970 --> 00:06:36,590
.اعتنوا به أيضًا

80
00:06:38,090 --> 00:06:40,300
.يا لوفي، ألق التّحيّة عليهم

81
00:06:40,300 --> 00:06:41,010
!أهلاً

82
00:06:41,010 --> 00:06:43,720
من ذلك الفتى؟

83
00:06:43,720 --> 00:06:46,350
.إنّه حفيدي

84
00:06:46,350 --> 00:06:47,350
ماذا؟

85
00:06:47,350 --> 00:06:49,400
!ماذا؟

86
00:06:49,400 --> 00:06:51,070
!واحد آخر؟

87
00:06:51,070 --> 00:06:55,450
!إنّه حفيد... أقصد، حفيد غارب-سان؟

88
00:06:55,540 --> 00:06:56,740
!لا نستطيع

89
00:06:56,740 --> 00:06:59,120
.حسنًا إذًا، إليكم خياركم

90
00:06:59,120 --> 00:07:02,700
هل تريدون أن تمضوا ما تبقّى
من حياتكم في السّجن أم تربيته؟

91
00:07:02,700 --> 00:07:06,080
.لقد اقترفتم الكثير من الجرائم الّتي تجاهلتها

92
00:07:07,840 --> 00:07:09,540
!بربّك

93
00:07:09,540 --> 00:07:12,630
...لا أريد أن يتمّ اعتقالي، لكن

94
00:07:12,630 --> 00:07:18,300
أحيانًا أفكّر أنّه ربّما من الأفضل أن أكون
...في السّجن على أن أعتني بإيس

95
00:07:18,300 --> 00:07:23,390
إلاّ أنّك تريدنا أن نعتني بحفيدك أيضًا؟
.لا بدّ أنّه وحش بدوره

96
00:07:23,390 --> 00:07:25,020
!كوخ سيّئ

97
00:07:25,020 --> 00:07:27,190
!هل تريد القتال؟

98
00:07:27,190 --> 00:07:28,480
!لا ينصت

99
00:07:28,480 --> 00:07:30,560
!أيّتها الزّعيمة! هل أنت بخير؟

100
00:07:30,560 --> 00:07:34,530
!ما هذا؟! مقرف، بصق! مقرف

101
00:07:34,530 --> 00:07:36,030
!من فعل هذا؟

102
00:07:37,140 --> 00:07:38,910
!أتت

103
00:07:38,910 --> 00:07:41,740
!اعتذر! هذا مقرف

104
00:07:41,740 --> 00:07:43,160
!إيس

105
00:07:43,160 --> 00:07:45,310
هل عدت يا إيس؟

106
00:07:51,000 --> 00:07:53,170
!أنت، اعتذر

107
00:07:54,720 --> 00:07:59,430
.لوفي، هذا إيس. إنّه أكبر منك بثلاث سنوات

108
00:07:59,430 --> 00:08:02,140
.ستعيش هنا معهم اعتبارًا من اليوم

109
00:08:02,760 --> 00:08:05,290
!ماذا؟! لا يمكنك أن تفعل ذلك

110
00:08:10,360 --> 00:08:11,400
!تأدّب

111
00:08:11,400 --> 00:08:13,360
!هل قُضي الأمر؟

112
00:08:13,360 --> 00:08:14,570
هل لديكم مشكلة؟

113
00:08:17,110 --> 00:08:18,690
!سنأويه

114
00:08:18,690 --> 00:08:22,490
.هذا كلّ شيء. سآتي للزّيارة عندما أملك الوقت

115
00:08:22,490 --> 00:08:25,540
عذرًا... ماذا عن منحة الطّفل؟

116
00:08:25,540 --> 00:08:26,290
.أضيفوها إلى فاتورتي

117
00:08:26,290 --> 00:08:27,660
...هذه ليست حانة

118
00:08:27,660 --> 00:08:28,250
ماذا؟

119
00:08:28,250 --> 00:08:29,750
!على الرّحب والسّعة

120
00:08:29,750 --> 00:08:32,580
!أيّتها الزّعيمة، لا يمكننا الاعتناء بطفل آخر

121
00:08:32,580 --> 00:08:34,800
!اخرس! لنأكل أوّلاً! أصلحه

122
00:08:34,800 --> 00:08:36,130
!حسنًا

123
00:08:36,620 --> 00:08:38,090
!اعتذر

124
00:08:38,090 --> 00:08:39,420
!انتظر

125
00:08:41,150 --> 00:08:43,270
.سأعهد لك بهذه القبّعة

126
00:08:56,320 --> 00:08:57,900
أين ذهب؟

127
00:08:59,570 --> 00:09:00,320
من أنت؟

128
00:09:00,320 --> 00:09:01,860
!دعوني

129
00:09:01,860 --> 00:09:03,920
!أعطني مالك وإلاّ قتلتك

130
00:09:03,920 --> 00:09:05,630
!لا أملك أيّ مال

131
00:09:05,630 --> 00:09:08,680
!إذًا أخبر والديك أن يحضرا بعض المال إلى هنا

132
00:09:08,680 --> 00:09:09,830
...جدّي هو الوحيد

133
00:09:09,830 --> 00:09:12,770
لا بأس. ما اسمه؟

134
00:09:12,770 --> 00:09:15,010
.غارب-سان

135
00:09:15,010 --> 00:09:16,410
!هل هذا الولد...؟

136
00:09:16,410 --> 00:09:18,840
.سيعيش هنا معنا

137
00:09:18,840 --> 00:09:21,370
!لماذا قبلتم؟

138
00:09:21,370 --> 00:09:23,010
!هذه ليست حضانة

139
00:09:23,010 --> 00:09:24,890
!زعيمتنا لا تملك الجرأة

140
00:09:25,430 --> 00:09:27,970
!اخرسوا جميعًا

141
00:09:27,970 --> 00:09:29,850
!حان وقت الأكل

142
00:09:31,850 --> 00:09:33,520
!هاته أيّها الأحمق

143
00:09:33,520 --> 00:09:34,980
!إنّه لحمي

144
00:09:34,980 --> 00:09:37,020
!أريد بعض اللّحم

145
00:09:38,690 --> 00:09:40,450
!أكلتَ بالفعل

146
00:09:40,450 --> 00:09:41,400
!أريد المزيد

147
00:09:41,400 --> 00:09:43,400
!لن أستسلم للشّباب

148
00:09:43,400 --> 00:09:44,650
!عليك أن تشاركني

149
00:09:44,650 --> 00:09:46,280
.إنّه قانون الغاب

150
00:09:48,990 --> 00:09:50,560
!لقد امتدّت ذراعه

151
00:09:53,460 --> 00:09:54,670
كلب؟

152
00:09:56,790 --> 00:09:59,200
!حان دورك لغسل الأطباق

153
00:09:59,200 --> 00:10:01,630
!أيمكنني تناول المزيد يا عمّ

154
00:10:01,630 --> 00:10:03,670
!أنا امرأة

155
00:10:03,670 --> 00:10:06,950
!هل تدري أين أنت الآن أساسًا؟

156
00:10:06,950 --> 00:10:07,690
.لا

157
00:10:07,690 --> 00:10:09,060
.سأخبرك إذًا

158
00:10:09,060 --> 00:10:12,810
هذا عرين عائلة دادان، لصوص
!الجبل الّذين يحكمون جبل كولبو

159
00:10:12,810 --> 00:10:16,560
!لصوص الجبل؟ أكره لصوص الجبل

160
00:10:18,190 --> 00:10:23,150
!اخرس أيّها الحقير الصّغير
!نحن من ننزعج بوجود طفل مثلك معنا

161
00:10:23,150 --> 00:10:25,400
!إن كنت لا تريد البقاء هنا، فلا بأس

162
00:10:25,400 --> 00:10:27,950
!ارحل ومت ككلب في مكان ما

163
00:10:27,950 --> 00:10:29,580
.هوّني عليك يا زعيمة

164
00:10:29,580 --> 00:10:31,540
...أريد أكل المزيد

165
00:10:33,080 --> 00:10:35,370
.أريد تناول ذلك اللّحم أيضًا

166
00:10:42,800 --> 00:10:46,840
.كلّ هذا اللّحم من ثور جلبه إيس

167
00:10:46,840 --> 00:10:50,220
.أعطانا جزءًا من الغنيمة كي يأكل الجميع

168
00:10:50,220 --> 00:10:52,220
.حياة لصوص الجبل صعبة للغاية

169
00:10:52,220 --> 00:10:55,220
!عليك أن تعمل بجدّ من الغد

170
00:10:55,220 --> 00:10:59,520
،التّنظيف والغسيل وتلميع الأحذية والأسلحة

171
00:10:59,520 --> 00:11:02,730
!والسّطو والاحتيال والسّرقة والقتل

172
00:11:02,730 --> 00:11:07,740
!تذكّر، لا يمكنك أن تخبر غارب بما نجعلك تفعله

173
00:11:07,740 --> 00:11:12,450
!زبديّة أرزّ وكأس من الماء كلّ يوم

174
00:11:12,450 --> 00:11:14,620
.هذا كلّ ما يمكنني أن أضمن لك

175
00:11:14,620 --> 00:11:18,960
.عليك أن تحصل على الباقي بنفسك وتكبر بنفسك

176
00:11:18,960 --> 00:11:20,000
!حسنًا

177
00:11:20,000 --> 00:11:23,210
حسنًا"؟! لماذا لا تبكِ أو ما شابه؟"

178
00:11:23,210 --> 00:11:27,130
أنا بخير لأنّ جدّي رمى بي في الأدغال ذات مرّة

179
00:11:27,130 --> 00:11:32,470
وكان هناك ماء صالح للشّرب وضفادع
!وأفاعٍ وفطر للأكل في الغابة

180
00:11:32,470 --> 00:11:35,930
...كما أنّني سأصير قرصانًا يومًا ما لذا

181
00:11:35,930 --> 00:11:38,600
!عليّ أن أكون قويًّا هكذا

182
00:11:38,600 --> 00:11:39,480
!أيّتها الزّعيمة

183
00:11:39,480 --> 00:11:40,310
!هل أنت بخير؟

184
00:11:40,310 --> 00:11:41,610
!ماذا تفعلين؟

185
00:11:41,610 --> 00:11:43,980
!استعداد

186
00:11:45,150 --> 00:11:47,110
!إلى أين يذهب؟

187
00:11:47,110 --> 00:11:48,450
!استعداد

188
00:11:49,990 --> 00:11:51,770
!ماذا تفعل؟

189
00:11:51,770 --> 00:11:53,620
هل قلت "قرصان"؟

190
00:11:53,620 --> 00:11:55,450
!لا ينصت

191
00:11:55,450 --> 00:11:56,750
!أنت

192
00:12:00,830 --> 00:12:03,460
!أرأيتم؟ إنّه صعب المراس

193
00:12:03,460 --> 00:12:06,090
!لهذا السّبب لم أرد الاعتناء بحفيد غارب

194
00:12:06,090 --> 00:12:07,760
.هوّني عليك يا زعيمة

195
00:12:08,390 --> 00:12:09,990
!أنت

196
00:12:10,510 --> 00:12:12,050
!انتظرني

197
00:12:13,220 --> 00:12:14,820
!أنت

198
00:12:17,940 --> 00:12:22,940
!اسمي لوفي! ما عدت غاضبًا لأنّك بصقت على وجهي

199
00:12:27,690 --> 00:12:29,450
!لماذا تضحك؟

200
00:12:30,350 --> 00:12:34,370
.لقد سكب عليّ بعض الشّراب فحسب
.لا شيء يدعو للغضب

201
00:12:34,370 --> 00:12:37,890
!لا سبب يدعو للغضب. لنصبح صديقين

202
00:12:38,450 --> 00:12:39,830
!هل أنت ذاهب لمكان ما؟

203
00:12:52,430 --> 00:12:54,680
!إنّه طريق مسدود

204
00:14:08,950 --> 00:14:12,170
!لقد عاد إيس

205
00:14:12,170 --> 00:14:13,970
!طعام

206
00:14:15,770 --> 00:14:18,260
إيس، هل عدت لوحدك؟

207
00:14:18,260 --> 00:14:22,200
.أين هو لوفي؟ ظننت أنّه معك

208
00:14:22,200 --> 00:14:23,200
.لا أدري

209
00:14:26,350 --> 00:14:30,230
ذلك الأحمق، أين هو وما الّذي يفعله؟

210
00:14:30,230 --> 00:14:33,490
.ربّما مات بالفعل

211
00:14:33,490 --> 00:14:36,030
.نحن في عداد الموتى إن عرف غارب بهذا

212
00:14:36,030 --> 00:14:39,120
!لا بدّ أنّ الزّعيمة قلقة للغاية

213
00:14:40,410 --> 00:14:43,000
!تماسكي يا زعيمة

214
00:14:43,000 --> 00:14:44,200
!ماذا قلت؟

215
00:14:44,200 --> 00:14:47,920
!قلت أنّه ليس من الجيّد أنّنا فقدناه في اليوم الأوّل

216
00:14:47,920 --> 00:14:51,250
!من يهتمّ؟! إن مات فقد مات

217
00:14:51,250 --> 00:14:54,760
.سيقتلنا غارب

218
00:14:54,760 --> 00:14:59,430
!أساسًا، لِمَ علينا الاعتناء بحفيد غارب؟

219
00:14:59,430 --> 00:15:05,730
!لسنا مربّيات! عليه الاعتناء بحفيده بنفسه

220
00:15:05,730 --> 00:15:07,770
لِمَ لا تخبريه بذلك؟

221
00:15:07,770 --> 00:15:09,020
!هل لديك مشكلة؟

222
00:15:22,660 --> 00:15:26,210
ماذا إن كان غولد روجر يملك ابنًا؟

223
00:15:26,640 --> 00:15:31,040
!بالطّبع أعرف ما سيصيبه! سيُقطع رأسه بالتّأكيد

224
00:15:31,040 --> 00:15:34,920
:أريد أن أسمعه يقول وهو يُحتضر

225
00:15:34,920 --> 00:15:40,260
"!أنا آسف لأنّني وُلدت! ما أنا إلاّ قمامة"

226
00:15:47,980 --> 00:15:52,650
!سأتخلّى عن إيس هو الآخر

227
00:15:53,480 --> 00:15:58,930
.لا أهتمّ إن مات أم لا
.سأخبر غارب أنّه كان حادثًا فحسب

228
00:15:58,930 --> 00:16:02,990
"!صحيح أنّ "أبناء الشّياطين يملكون حظّ الشّيطان

229
00:16:02,990 --> 00:16:05,120
!إنّه ابن شيطان

230
00:16:05,910 --> 00:16:12,170
،إن عرفت الحكومة بشأن هذا
!ماذا سيفعلون بنا بظنّكم؟

231
00:16:12,170 --> 00:16:14,130
.هوّني عليك يا زعيمة

232
00:16:14,130 --> 00:16:17,920
!إنّك تسرفين في الشّرب

233
00:16:20,320 --> 00:16:21,890
...بعد أسبوع

234
00:16:28,610 --> 00:16:31,290
!كم هذا مزعج

235
00:16:32,310 --> 00:16:35,690
لِمَ لا تخرس؟

236
00:16:36,800 --> 00:16:38,900
!أيّتها الزّعيمة! أيّتها الزّعيمة دادان

237
00:16:38,900 --> 00:16:41,740
من هناك؟

238
00:16:41,740 --> 00:16:43,490
!هذا أنت

239
00:16:43,490 --> 00:16:46,660
!عاد لوفي

240
00:16:51,520 --> 00:16:56,500
!...أيّها الأحمق! أنت حيّ! أنت

241
00:16:56,500 --> 00:16:58,260
.هوّني عليك يا زعيمة

242
00:16:58,260 --> 00:17:00,800
!أين كنت؟

243
00:17:00,800 --> 00:17:03,800
على رسلكما. أين كنت وماذا كنت تفعل؟

244
00:17:04,400 --> 00:17:07,680
.لقد طوردت من قبل الذّئاب في قاع الوادي

245
00:17:07,680 --> 00:17:10,980
وماذا كنت تفعل في قاع الوادي؟

246
00:17:13,230 --> 00:17:17,030
.على أيّ حال، من الجيّد أنّك بخير

247
00:17:17,030 --> 00:17:17,690
.أجل

248
00:17:17,690 --> 00:17:21,700
!بل هناك بأس! لقد عاد المزعج

249
00:17:22,740 --> 00:17:27,540
لِمَ لا تأوي إلى الفراش اللّيلة؟
!لديك عمل بدءًا من الغد

250
00:17:27,540 --> 00:17:28,490
بهذه السّرعة؟

251
00:17:37,620 --> 00:17:39,050
ما الأخبار؟

252
00:17:39,050 --> 00:17:41,420
هل أنت ذاهب إلى مكان ما اليوم يا إيس؟

253
00:17:41,420 --> 00:17:45,430
!خذني معك! لنصبح صديقين

254
00:17:45,970 --> 00:17:47,260
!انتظرني

255
00:17:47,260 --> 00:17:49,810
!أيّتها الزّعيمة! إنّه يلاحق إيس ثانيةً

256
00:17:50,520 --> 00:17:54,520
!أنت! علينا أن تقوم بالأعمال الرّتيبة من حول البيت

257
00:17:55,560 --> 00:17:58,110
!لا أريد

258
00:17:58,690 --> 00:18:01,340
!أيّها الحقير الصّغير! أنت خارج عن السّيطرة

259
00:18:01,340 --> 00:18:02,690
.هوّني عليك يا زعيمة

260
00:18:02,690 --> 00:18:04,530
!أعده فورًا

261
00:18:04,530 --> 00:18:05,160
.حاضر

262
00:18:05,560 --> 00:18:07,370
!مهلاً

263
00:18:30,220 --> 00:18:32,380
!يا إيس

264
00:18:37,810 --> 00:18:40,960
!يا إيس! لنصبح صديقين

265
00:18:49,490 --> 00:18:51,080
...اليوم الثّامن

266
00:18:51,950 --> 00:18:53,260
!إيس

267
00:18:53,260 --> 00:18:54,960
!انتظرني

268
00:18:54,960 --> 00:18:55,870
!أيّتها الزّعيمة

269
00:18:55,870 --> 00:18:57,920
!اعمل أيّها الحقير الصّغير

270
00:18:57,920 --> 00:18:59,080
...لا فائدة

271
00:18:59,080 --> 00:19:00,380
!أعده

272
00:19:00,380 --> 00:19:00,840
.حاضر

273
00:19:00,840 --> 00:19:02,670
!لن أفقد أثرك اليوم

274
00:19:04,670 --> 00:19:06,180
!يمكنني ذلك

275
00:19:09,890 --> 00:19:11,930
!لنصبح صديقين

276
00:19:15,600 --> 00:19:17,560
...مرّت عشرة أيّام

277
00:19:17,560 --> 00:19:18,770
!لوفي

278
00:19:18,770 --> 00:19:20,440
...لقد ذهب بالفعل

279
00:19:20,440 --> 00:19:22,110
!ابحثا عنه

280
00:19:26,360 --> 00:19:28,910
.ما انفكّ يلاحق إيس ويفقد أثره

281
00:19:32,280 --> 00:19:34,840
.لكنّ الأمر استمرّ كلّ يوم

282
00:19:34,840 --> 00:19:36,460
!إيس

283
00:19:44,450 --> 00:19:46,090
...بعد شهر

284
00:19:47,420 --> 00:19:48,630
...بعد شهرين

285
00:19:49,040 --> 00:19:50,670
!إيس

286
00:19:50,670 --> 00:19:54,230
...حتّى إن كانت تُمطر أو كانت الرّياح قويّة

287
00:19:56,480 --> 00:19:58,560
!إيس

288
00:19:58,560 --> 00:20:02,150
.استمرّ لوفي بملاحقة إيس بيأس

289
00:20:04,960 --> 00:20:07,950
!هل يلاحق لوفي إيس ثانيةً؟

290
00:20:07,950 --> 00:20:12,220
كيف يعقل أنّه لا يتعلّم درسه أبدًا مهما تأذّى من مرّة؟

291
00:20:12,220 --> 00:20:14,990
!سحقًا! عليه أن يتوقّف عن إقلاقي

292
00:20:14,990 --> 00:20:16,960
.أنت قلقة إذًا

293
00:20:16,960 --> 00:20:19,920
!مـ-مستحيل! كفّ عن قول الهراء

294
00:20:22,250 --> 00:20:24,530
.وقعت عليّ خليّة نحل

295
00:20:25,970 --> 00:20:27,050
من أنت؟

296
00:20:30,690 --> 00:20:32,800
!يا إيس

297
00:20:40,730 --> 00:20:44,440
!إيس! يا إيس

298
00:20:44,440 --> 00:20:48,290
.لا أصدّق أنّه أتى لهذا الحدّ. إنّه لحوح حقًّا

299
00:20:50,110 --> 00:20:51,260
!تبًّا

300
00:20:52,240 --> 00:20:56,420
!سحقًا! فقدت أثره ثانيةً! إيس يركض بسرعة

301
00:20:58,210 --> 00:20:59,410
!أهو إيس؟

302
00:21:07,500 --> 00:21:12,380
!ذلك وحش جبل كولبو! لا يستطيع أحد هزيمته

303
00:21:14,930 --> 00:21:17,510
!لِمَ لا يهرب؟! سيأكله

304
00:21:17,510 --> 00:21:21,640
!أ-أشعر أنّ ركبتي واهنة

305
00:21:21,640 --> 00:21:23,310
!ذاك الأحمق

306
00:22:30,450 --> 00:22:34,990
كان لوفي يلاحق إيس لثلاثة أشهر والجراح
...والكدمات تغطّي جسده

307
00:22:42,310 --> 00:22:44,790
.إنّها نهاية الغابة

308
00:23:00,520 --> 00:23:01,950
ما هذا المكان؟

309
00:23:11,470 --> 00:23:14,630
.قمامة مهملة تشغل كلّ مكان والدّخان يملأ الجوّ

310
00:23:14,630 --> 00:23:17,300
.هذه غري ترمينال، بلدة جانحين

311
00:23:18,050 --> 00:23:20,720
،كان إيس يتأمّر البلطجيّة هنا ذات مرّة

312
00:23:20,720 --> 00:23:24,020
.وكان يجمع المال من أجل أن يصير قرصانًا يومًا ما

313
00:23:24,020 --> 00:23:27,100
...إلى جانب صديق آخر

314
00:23:27,100 --> 00:23:28,480
:في الحلقة القادمة من وان بيس

315
00:23:28,480 --> 00:23:31,270
"!ها هو ذا سابو! الفتى في غري ترمينال"

316
00:23:31,270 --> 00:23:33,820
!ملك القراصنة، لن يكون إلاّ أنا

317
00:23:36,000 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة