1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:05,200 --> 00:02:08,410
!سأثأر للجميع بأيّ ثمن

29
00:02:08,990 --> 00:02:14,080
،حتّى في الأوقات العصيبة
...أستطيع المواصلة دونما استسلام

30
00:02:14,080 --> 00:02:16,330
.بسبب أمنية واحدة

31
00:02:16,620 --> 00:02:21,890
...ولتحقيقها، أحتاج حلفاء من نفس الطّينة

32
00:02:21,890 --> 00:02:27,220
أحتاج مساعدتكم جميعًا
!يا من تعيشون في بلاد وانو

33
00:02:27,590 --> 00:02:31,350
!نتشارك جميعنا أمنية واحدة

34
00:02:32,640 --> 00:02:36,140
!ألا وهي استعادة بلاد وانو

35
00:02:36,140 --> 00:02:39,270
،أيّها النّاس... طوال السّنوات العشرين الماضية

36
00:02:39,690 --> 00:02:43,690
!انتظرتمونا وأنا أشكركم على ذلك

37
00:02:43,690 --> 00:02:47,610
...أنا وريث لقب دايميو بلاد وانو

38
00:02:48,870 --> 00:02:51,340
!كوزكي مومونوسكي

39
00:02:51,340 --> 00:02:54,080
!آن الأوان لننهض

40
00:02:57,250 --> 00:03:01,500
!فرقة أوروتشي للمطاردة"
"!مجموعة النّينجا ضدّ زورو

41
00:03:11,720 --> 00:03:12,890
!زوروجورو

42
00:03:15,810 --> 00:03:17,230
!لا تخافي! اركضي

43
00:03:17,980 --> 00:03:18,810
!حاضرة

44
00:03:25,900 --> 00:03:28,380
!سأهتمّ بأمرهم هنا، فاسبقيني أنت

45
00:03:28,380 --> 00:03:31,320
!أنا آسفة. كن حذرًا رجاءً

46
00:04:01,230 --> 00:04:02,440
!عددهم كبير

47
00:04:02,860 --> 00:04:04,400
!زوروجورو-سان

48
00:04:21,750 --> 00:04:22,790
!أسلوب السّيفين

49
00:04:22,790 --> 00:04:24,840
!ردّ تسلّق البرج

50
00:04:42,770 --> 00:04:44,730
!زوروجورو

51
00:04:50,570 --> 00:04:54,030
أنت مجرم خطير أشهر سيفه
!في وجه أوروتشي-ساما

52
00:05:31,110 --> 00:05:35,490
!سأجعلك تندم على تحدّيك لأوروتشي-ساما

53
00:05:38,530 --> 00:05:42,330
!زوروجورو! جهّز نفسك

54
00:05:59,760 --> 00:06:02,230
...سُحقًا لك

55
00:06:12,360 --> 00:06:14,410
أهذا كلّ شيء؟

56
00:06:14,410 --> 00:06:17,870
كم يوجد هنالك من نينجا؟

57
00:06:19,450 --> 00:06:21,100
هل أنت بخير؟

58
00:06:21,100 --> 00:06:22,790
.أنا على ما يرام

59
00:06:23,710 --> 00:06:26,870
...آسفة لأنّي عرقلت طريقك

60
00:06:27,250 --> 00:06:28,750
...نعم

61
00:06:29,750 --> 00:06:32,060
.حسنًا، لا داعي للقلق

62
00:06:32,060 --> 00:06:36,430
.ما كنتُ لأستطيع مواجهة مومونوسكي إن قُتلتِ

63
00:06:42,600 --> 00:06:45,500
تريدين العودة للمنزل في المنطقة الثّلجيّة، صحيح؟

64
00:06:45,500 --> 00:06:50,320
.لا يهمّ ذلك ما دمت أستطيع إخفاء نفسي

65
00:06:53,740 --> 00:06:57,240
.أريد العودة للرّجل الّذي سرق سيفي

66
00:06:58,740 --> 00:07:03,080
سأرشدك إليه بالطّبع. كان في جسر
قطّاع الطّرق في رينغو، صحيح؟

67
00:07:07,580 --> 00:07:10,040
.من الضّروريّ أن أستعيده قبل المعركة الكبيرة

68
00:07:10,840 --> 00:07:13,590
.لا أشعر بالرّاحة بدونه

69
00:07:19,090 --> 00:07:22,400
...أظنّني أغضبتُ أوروتشي كثيرًا

70
00:07:22,400 --> 00:07:25,100
.فرقة المطاردة خاصّته مزعجة جدًّا

71
00:07:28,270 --> 00:07:31,810
...أتساءل إن كانت أوتوكو بخير

72
00:07:31,810 --> 00:07:33,860
!ياسويي

73
00:07:39,070 --> 00:07:44,580
!أبي

74
00:07:45,370 --> 00:07:48,550
...بعد ذلك الفِعل الشّنيع الّذي حدث لوالدها

75
00:07:48,550 --> 00:07:51,040
...أنا قلقة لأنّني عجزتُ عن مساندتها

76
00:07:51,670 --> 00:07:53,970
!إنّها مع طاقمي

77
00:07:53,970 --> 00:07:56,880
...ستكون بخير، جسديًّا على الأقلّ

78
00:08:02,890 --> 00:08:04,930
!لن أغفر لأوروتشي أبدًا

79
00:08:06,770 --> 00:08:10,350
!سأثأر لتونوياسو بأيّ ثمن

80
00:08:31,790 --> 00:08:34,920
...أتمنّى... لو أستطيع

81
00:08:36,340 --> 00:08:37,960
!قتله بنفسي

82
00:09:01,990 --> 00:09:03,660
!ماذا قلت؟

83
00:09:05,120 --> 00:09:08,950
!سمحت لهما بالهرب؟

84
00:09:08,950 --> 00:09:11,750
!ماذا عن الرّونين الّذي هاجمني؟

85
00:09:13,000 --> 00:09:15,130
...أنا أعتذر

86
00:09:15,130 --> 00:09:18,190
!خاب أملي فيكم

87
00:09:18,190 --> 00:09:22,180
.لكنّنا قبضنا على رجل يُدعى ترافالغار

88
00:09:23,470 --> 00:09:26,220
ترا... فالغار؟

89
00:09:26,850 --> 00:09:28,470
!ومن من يكون؟

90
00:09:29,350 --> 00:09:32,030
!إنّه واحد من عقولهم المدبّرة تمامًا مثل قبّعة القشّ

91
00:09:32,030 --> 00:09:36,110
!إذًا أمسى اثنان من قادة مجموعة الدّخلاء في قبضتنا

92
00:09:36,110 --> 00:09:38,270
أين هو الآن؟

93
00:09:40,610 --> 00:09:45,990
!إنّ رياح الخيانة لا تكفّ عن الهبوب في عالم القراصنة

94
00:09:53,250 --> 00:09:57,840
،حتّى بعد تعذيبنا له
.بإمكاننا استغلاله بطرق عدّة

95
00:09:59,380 --> 00:10:02,470
.يبدو ذلك جيّدًا

96
00:10:03,300 --> 00:10:06,470
ما وضع العاصمة؟

97
00:10:06,970 --> 00:10:08,510
!لا داعي للقلق

98
00:10:09,180 --> 00:10:11,930
إنّها في حالة تأهّب عالية

99
00:10:11,930 --> 00:10:17,310
ونشرنا دوريّات من قوّات السّاموراي
!والنّينجا في كلّ أرجائها

100
00:10:17,810 --> 00:10:20,610
،وإلى أن يُقبض على كلّ الدّخلاء

101
00:10:21,030 --> 00:10:25,200
!فسأحرص كلّ الحرص على حمايتك جيّدًا

102
00:10:29,490 --> 00:10:33,410
أبلغوا عن الأمر في الحال
!إذا ما رأيتم أيًّا من هذه الوجوه

103
00:10:36,120 --> 00:10:38,850
!كلّ هذه ملصقات مطلوبين؟

104
00:10:38,850 --> 00:10:44,840
اعلموا أنّ السّماح لهم بالهرب
!أو إخفائهم سيُعدّ تآمرًا

105
00:10:46,010 --> 00:10:47,760
...يا إلهي

106
00:10:49,680 --> 00:10:52,680
.سيكون علينا البقاء بعيدين عن العاصمة حاليًّا

107
00:10:53,350 --> 00:10:56,690
!ليس العاصمة فحسب
!نحن مطلوبون في كلّ البلاد

108
00:10:57,270 --> 00:11:02,690
.سيكون قتلةُ أروتشي لنا بالمرصاد أينما حللنا

109
00:11:02,690 --> 00:11:05,900
!للإمساك بنا

110
00:11:05,900 --> 00:11:09,700
نُشرت ملصقات المطلوبين خاصّتنا
!عبر بلاد وانو بأكملها

111
00:11:09,700 --> 00:11:12,990
!لذلك فالعاصمة ليست المكان الوحيد الخطير

112
00:11:14,250 --> 00:11:17,560
.إنّنا نُعتبر من أسوأ الجانحين

113
00:11:17,560 --> 00:11:21,590
.لكنّ شأننا في العاصمة قد تمّ بطريقة ما

114
00:11:21,960 --> 00:11:26,760
كان هدفنا هو إيجاد السّاموراي
.الحاملين لوشم الهلال

115
00:11:30,260 --> 00:11:32,600
...لكنّ كلّ أولئك السّاموراي

116
00:11:32,600 --> 00:11:34,930
.خلف القضبان الآن

117
00:11:35,730 --> 00:11:38,520
!أخرجونا من هنا في الحال

118
00:11:40,060 --> 00:11:41,940
!اخرسوا

119
00:11:42,730 --> 00:11:48,450
ظننتُ أنّهم سيُعتبرون أبرياء بعد إلقاء
...تونوياسو لذلك الخطاب مخاطرًا بحياته

120
00:11:48,910 --> 00:11:51,870
.قد لا يكون الأمر بهذه السّهولة

121
00:11:52,330 --> 00:11:58,620
.مقرّ السّجناء مكان واسع
.أفترض أنّه تمّ أسر حوالي الألف منهم

122
00:11:59,120 --> 00:12:01,960
مهلاً، ألم يتمّ تحريرهم بعد؟

123
00:12:02,790 --> 00:12:06,550
أتظنّ أنّ أوروتشي-ساما سيقول "إنّني مخطئ"؟

124
00:12:07,010 --> 00:12:10,070
.لن يعترف أنّه أخطأ أبدًا

125
00:12:10,070 --> 00:12:11,430
.أنت محقّة

126
00:12:11,970 --> 00:12:15,360
...لكنّنا بتنا نعرف الآن أنّهم حلفاؤنا

127
00:12:15,360 --> 00:12:19,770
!إنّنا في أمسّ الحاجة لعونهم
!من واجبنا فعل شيء حيال ذلك

128
00:12:20,850 --> 00:12:23,400
.طاقم لو موجود هناك أيضًا

129
00:12:36,870 --> 00:12:40,210
،بالمناسبة يا شينوبو-تشان
ما الّذي يفعلونه؟

130
00:12:40,830 --> 00:12:43,640
!صحيح، إنّهم يصنعون قوارب سماء

131
00:12:43,640 --> 00:12:44,710
قوارب سماء؟

132
00:12:45,040 --> 00:12:48,590
،إنّ مهرجان النّار وشيك
.لذلك تراهم يحضّرون له

133
00:12:49,090 --> 00:12:53,110
.فقدوا شخصين مهمّين
.أراهن أنّهم ليسوا في مزاج للاحتفال

134
00:12:53,110 --> 00:12:56,390
!كلاّ! على العكس تمامًا

135
00:13:03,940 --> 00:13:09,860
إنّ مهرجان النّار في عاصمة الزّهور
.هو حدثٌ لتكريم الأموات

136
00:13:10,780 --> 00:13:15,720
كلّما كان المهرجان ضخمًا، كانت
.فرص بلوغ مشاعرنا للأموات أكبر

137
00:13:17,620 --> 00:13:20,330
.إنّه مهرجان مهمّ لهم إذًا

138
00:14:25,600 --> 00:14:27,460
!ما-ما الّذي يحدث؟

139
00:14:27,460 --> 00:14:29,270
!يا فتى قبّعة القشّ

140
00:14:35,990 --> 00:14:37,120
!لوفي

141
00:14:37,120 --> 00:14:41,740
.لا تقلقا. إنّ الدّواء يجدي نفعًا
!سيكون بخير عمّا قريب

142
00:14:49,090 --> 00:14:51,150
!هل أجدى الدّواء نفعًا بالفعل؟

143
00:14:51,150 --> 00:14:53,840
!لوفي! لا تضغط على نفسك

144
00:14:55,970 --> 00:14:58,950
!يا أخي الكبير! هل أنت بخير؟

145
00:14:58,950 --> 00:15:02,240
...أريد... شيئًا... لآكله

146
00:15:02,240 --> 00:15:04,600
!ماذا؟! ماذا قلت؟

147
00:15:08,440 --> 00:15:11,110
!أحضروا لي شيئًا لآكله

148
00:15:19,780 --> 00:15:22,660
!تفضّل وكل بقدر ما تشاء

149
00:15:23,040 --> 00:15:23,830
!أريد المزيد

150
00:15:23,830 --> 00:15:24,240
!أنت سريع

151
00:15:25,040 --> 00:15:27,980
!أنا سعيد لأنّك تحسّنت

152
00:15:27,980 --> 00:15:29,430
!تشوبّريمون-سان

153
00:15:29,430 --> 00:15:33,050
.تخلّص البقيّة بأكملهم من آثار المرض أيضًا

154
00:15:33,380 --> 00:15:35,300
.كم هذا مريح

155
00:15:37,130 --> 00:15:39,900
!مهاراتك أدهشتني

156
00:15:39,900 --> 00:15:42,200
!نعم! أبليتَ حسنًا

157
00:15:42,200 --> 00:15:47,560
!ثناؤكم لا يُسعدني أيّها الأغبياء

158
00:15:53,400 --> 00:15:56,680
!أشعر بالقوّة تتدفّق داخلي

159
00:15:56,680 --> 00:15:58,610
!شكرًا يا رفاق

160
00:16:00,490 --> 00:16:01,620
!أخي الكبير

161
00:16:01,620 --> 00:16:04,910
!كن بانتظاري يا كايدو

162
00:16:17,970 --> 00:16:19,680
!أنا سعيدة لأنّكم أحياء

163
00:16:21,010 --> 00:16:25,600
...نعم، آسفون على إقلاقكم

164
00:16:25,970 --> 00:16:29,140
!سمعتُ أنّكم قد أُسرتم

165
00:16:29,140 --> 00:16:31,440
!لحسن الحظّ أنّنا هربنا

166
00:16:31,440 --> 00:16:32,100
!جيّد

167
00:16:32,110 --> 00:16:34,360
!مهلاً، صحيح

168
00:16:35,150 --> 00:16:37,320
...ألقي نظرة على هذه

169
00:16:37,320 --> 00:16:39,880
...قبل موته، قام دايميو يُدعى ياسويي

170
00:16:39,880 --> 00:16:41,450
!ماذا؟! ياسويي؟

171
00:16:41,450 --> 00:16:46,240
.رسم هذا الرّمز وأراه لمن كانوا في السّجن

172
00:16:46,620 --> 00:16:48,000
...مهلاً لحظة

173
00:16:48,450 --> 00:16:51,960
!ثمّة خطّان إضافيّان للأفعى؟

174
00:16:51,960 --> 00:16:53,680
!نعم، هذا صحيح

175
00:16:53,680 --> 00:16:58,210
أظنّ أنّ المقصود من الرّمز
.قد تغيّر بهذين الخطّين

176
00:16:58,210 --> 00:17:01,440
.عرف شعب بلاد وانو المقصود منه

177
00:17:01,440 --> 00:17:03,930
.إنّها رسالة ياسويي الأخيرة

178
00:17:04,260 --> 00:17:06,610
!هذا مهمّ للغاية

179
00:17:06,610 --> 00:17:08,980
!سأحرص على تبليغها لكينييمون

180
00:17:09,100 --> 00:17:10,430
!أعتمد عليك

181
00:17:10,430 --> 00:17:11,850
!أكيد

182
00:17:13,400 --> 00:17:15,580
!تعالوا إلى قرية أميغاسا إن احتجتم للمساعدة

183
00:17:15,580 --> 00:17:20,150
!أكيد! بلّغي سلامنا للبقيّة

184
00:17:26,660 --> 00:17:28,120
...أيّها القائد

185
00:17:33,920 --> 00:17:36,170
...إنّها غلطتنا

186
00:17:38,670 --> 00:17:40,420
!سُحقًا

187
00:17:42,630 --> 00:17:46,350
!أنا آسف أيّها القائد

188
00:17:51,350 --> 00:17:53,980
ما الّذي فعلتموه بدبّنا الأبيض؟

189
00:17:54,480 --> 00:17:59,040
بإمكانك إخراجهم من هناك
.في رمشة عين بقدرتك

190
00:17:59,040 --> 00:18:05,570
أيّ نوع من الحمقى قد يُبقي
كلّ رهائنه في مكان واحد واضح؟

191
00:18:05,870 --> 00:18:08,870
.سأزجّ بك في ذلك السّجن أيضًا

192
00:18:11,700 --> 00:18:14,620
.لا يمكنك الإطاحة بي

193
00:18:19,250 --> 00:18:20,340
!هذا مؤلم

194
00:18:22,010 --> 00:18:22,840
!ساتشي

195
00:18:27,550 --> 00:18:31,640
.لديّ أربع حيوات الآن

196
00:18:38,480 --> 00:18:42,940
...بإمكانك تقطيعي فقط بعد أن تقتل

197
00:18:43,360 --> 00:18:45,410
.الأعضاء الثّلاثة من طاقمك

198
00:18:53,040 --> 00:18:54,880
...لا خيار أمامي

199
00:18:54,880 --> 00:18:58,840
.على الزّعيم تحمّل مسؤوليّة هفوات تابعيه

200
00:19:00,460 --> 00:19:03,130
!سأقطّع كُلاًّ منكم في الحال

201
00:19:04,920 --> 00:19:06,970
!يا لك من وغد

202
00:19:19,480 --> 00:19:21,110
!أيّها القائد

203
00:19:21,770 --> 00:19:25,190
.كانت حياتكم هي ورقة مساومته

204
00:19:25,570 --> 00:19:28,870
!مساومة"؟ ماذا تعني بذلك؟"

205
00:19:29,700 --> 00:19:33,330
...إن رفضتُ، فإنّ ترافالغار لو

206
00:19:33,750 --> 00:19:38,920
.سيسلبني حياتي إلى جانب حياتكم

207
00:19:39,210 --> 00:19:44,060
تهديد من رجل غير عازم
...على المراهنة بالغد

208
00:19:44,060 --> 00:19:47,880
.لهو أمر يُثير القلق حيال حياتي أنا

209
00:19:49,140 --> 00:19:52,060
!آسف أيّها القائد! إنّها غلطتنا

210
00:19:58,190 --> 00:20:01,190
!هذه هي حيواتكم أنتم الثّلاثة

211
00:20:04,610 --> 00:20:07,000
...أنتم أحرار بالكامل

212
00:20:07,000 --> 00:20:10,570
ليست لديك أيّ مشاكل، صحيح يا ترافالغار؟

213
00:20:15,120 --> 00:20:16,840
!كلاّ، كلاّ

214
00:20:16,840 --> 00:20:20,330
!لا تذهب أيّها القائد

215
00:20:20,670 --> 00:20:22,130
.أصغوا يا رفاق

216
00:20:24,750 --> 00:20:30,240
!إيّاكم أن تخبروا قبّعة القشّ-يا والبقيّة أنّني أُسرت

217
00:20:30,240 --> 00:20:32,350
!ماذا؟ لماذا؟

218
00:20:32,760 --> 00:20:34,430
!أيّها القائد

219
00:20:39,560 --> 00:20:41,020
!انتظر

220
00:20:41,020 --> 00:20:43,270
!أيّها القائد

221
00:20:44,320 --> 00:20:47,030
!لا تذهب

222
00:20:47,030 --> 00:20:50,320
!أيّها القائد

223
00:20:56,830 --> 00:20:57,790
...أنا آسف

224
00:20:59,000 --> 00:21:02,000
...يا رفاق... بسبب غلطتنا

225
00:21:02,500 --> 00:21:04,460
...القائد

226
00:21:08,880 --> 00:21:10,760
!لا يمكننا الجلوس مكتوفي الأيدي

227
00:21:11,510 --> 00:21:14,190
!إنّنا قراصنة القلب

228
00:21:14,190 --> 00:21:17,230
!لنستعد قائدنا

229
00:21:17,230 --> 00:21:22,230
!حياة قائدنا أكثر أهمّيّة من خطّة كينييمون

230
00:21:32,780 --> 00:21:34,950
!ترافالغار لو

231
00:21:35,410 --> 00:21:36,780
!وغد

232
00:21:37,410 --> 00:21:39,410
.هذا أكثر من كافٍ

233
00:21:40,330 --> 00:21:44,330
.ما الخطب؟ أنت تتصرّف بغرابة

234
00:21:44,710 --> 00:21:47,300
.لا، ما من خطب

235
00:21:49,460 --> 00:21:51,880
.لننه هذا الأمر

236
00:21:52,800 --> 00:21:55,890
.صحيح، إنّها مسألة سهلة

237
00:22:18,410 --> 00:22:20,910
.سينتهي الأمر بمجرّد أن تفصح بما لديك

238
00:22:23,290 --> 00:22:27,540
.ثمّة اتّفاق بين طاقمه وطاقم قبّعة القشّ

239
00:22:33,760 --> 00:22:38,350
ما الغاية الّتي أتت بكم إلى بلاد وانو؟

240
00:22:39,180 --> 00:22:41,390
.أخبرنا بكلّ شيء

241
00:23:04,500 --> 00:23:08,430
بغرض الإطاحة بكايدو، نجد طاقم
قبّعة القشّ وحلفاءهم في بلاد وانو

242
00:23:08,430 --> 00:23:11,890
يستعدّون للمعركة الكبيرة
!ويوطّدون علاقاتهم ببعض

243
00:23:11,890 --> 00:23:17,390
في تلك الأثناء في أونيغاشيما، يلتقي كلّ من بيغ مام
!وكايدو أخيرًا في مواجهة تملأ الأجواء بالتّوتّر

244
00:23:17,390 --> 00:23:22,350
!إنّه وضع غير مستقرّ
!ما الّذي سيحلّ ببلاد وانو؟

245
00:23:22,350 --> 00:23:23,680
:في الحلقة القادمة من وان بيس

246
00:23:23,680 --> 00:23:27,440
!يزداد التّوتّر في أونيغاشيما"
"!لقاء بين اثنين من اليونكو؟

247
00:23:27,440 --> 00:23:30,030
!ملك القراصنة، لن يكون إلاّ أنا