1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,490
...اسعوا نحو الحرّيّة

3
00:00:13,490 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:01:51,980 --> 00:01:53,250
أنتم أولئك المتغطرسون

22
00:01:53,250 --> 00:01:55,950
الّذين لم يدفعوا ضرائبهم
في الميناء، أليس كذلك؟

23
00:02:05,930 --> 00:02:06,930
!سانجي

24
00:02:06,930 --> 00:02:08,600
!تبًّا، ما الّذي تفعله؟

25
00:02:12,100 --> 00:02:13,870
!إنّه ضباب قوس قزح

26
00:02:25,350 --> 00:02:26,990
أيّها الأستاذ، أين نحن؟

27
00:02:26,990 --> 00:02:28,950
."حفلة القرد"

28
00:02:28,950 --> 00:02:30,920
.حفلة القرد"؟ لا يعقل"

29
00:02:30,920 --> 00:02:31,960
!مـ-ماذا تعني؟

30
00:02:34,330 --> 00:02:38,230
مقبرة سفن، حيث من يدخلها
.لا يرجع منها أبدًا

31
00:02:42,130 --> 00:02:46,100
"!سكّان أرض البقاء! قراصنة اليقطين"

32
00:03:02,350 --> 00:03:06,090
انظروا! لا شيء في مرآنا
!سوى السّفن الغارقة

33
00:03:06,090 --> 00:03:10,400
لنتراجع عن هذا. يبدو وكأنّ
.قائدًا شبحًا سيظهر في أيّ لحظة

34
00:03:10,400 --> 00:03:12,800
!حقًّا؟ أيّها القائد الشّبح

35
00:03:12,800 --> 00:03:13,570
!لا تنادي عليه

36
00:03:14,430 --> 00:03:17,670
.يوجد خلف ضباب قوس قزح عالم البقاء

37
00:03:17,670 --> 00:03:19,740
.الجنّة النّهائيّة المتبقّية في الأرض

38
00:03:20,470 --> 00:03:22,170
،وهي مليئة بكنوز الذّهب والفضّة

39
00:03:22,170 --> 00:03:25,180
حيث يعيش النّاس خالدين
.دون أن يكبروا أو يجوعوا

40
00:03:25,540 --> 00:03:27,750
.هذا ما ذُكر في هذا الكتاب

41
00:03:27,750 --> 00:03:32,220
.أخبرتك أنّ ذلك ما إلاّ أسطورة

42
00:03:33,050 --> 00:03:36,920
أيّها الأستاذ، هل عرفت أنّ هذا
المكان عبارة عن مقبرة سفن؟

43
00:03:37,290 --> 00:03:42,390
نعم. قبل خمسين سنة، ألقيتُ
.نظرة خاطفة عن هذا المكان

44
00:03:42,690 --> 00:03:44,100
إن كنت تعرف هذا، فلمَ أتيت؟

45
00:03:44,100 --> 00:03:46,030
.أخبرتك أيضًا

46
00:03:46,030 --> 00:03:51,840
كنتُ أجري بحثي لإنقاذ أصدقائي
.الّذين ابتلعهم هذا الضّباب

47
00:03:51,840 --> 00:03:55,370
،حتّى أنّني أصبحتُ كلبًا لدى ويتّون

48
00:03:55,370 --> 00:03:57,140
.وتحمّلت أصابع اللّوم لذلك الهدف

49
00:04:01,410 --> 00:04:03,110
!رفاق

50
00:04:03,620 --> 00:04:05,420
!انظروا إلى هذا

51
00:04:11,490 --> 00:04:12,460
ما هذا؟

52
00:04:13,990 --> 00:04:15,890
أليس رائعًا؟

53
00:04:15,890 --> 00:04:17,930
!ثمّة المزيد داخل السّفينة

54
00:04:18,460 --> 00:04:20,200
!سأذهب للاستكشاف أكثر

55
00:04:20,830 --> 00:04:23,000
،سواء كانت هذه جنّة أم لا

56
00:04:23,000 --> 00:04:27,940
إلاّ أنّ جزئيّة "مليئة بالكنوز" لا تبدو
كذبة عمومًا، أليس ذلك أيّها الأستاذ؟

57
00:04:46,520 --> 00:04:49,990
...أيا من تقلقون راحة الأموات

58
00:04:50,700 --> 00:04:52,430
!مـ-ما هذا؟

59
00:04:52,430 --> 00:04:55,870
،دعوا الصّناديق وارحلوا فورًا

60
00:04:56,300 --> 00:05:02,070
!وإلاّ ألحقنا بكم لعنة الموتى

61
00:05:02,070 --> 00:05:04,540
!...أ-أنا خـ-خائف

62
00:05:05,110 --> 00:05:05,940
من هناك؟

63
00:05:09,650 --> 00:05:11,220
!ها قد ظهرت

64
00:05:15,650 --> 00:05:19,660
...والآن، سلّمونا الصّندوق بلا مقاومة

65
00:05:20,090 --> 00:05:22,030
...وإلاّ

66
00:05:24,800 --> 00:05:27,070
...كان ذلك وشيكًا! أيّها الـ

67
00:05:32,570 --> 00:05:35,440
!...أيّها القائد الشّبح

68
00:05:42,110 --> 00:05:44,180
!إنّها فارغة

69
00:05:44,480 --> 00:05:48,150
!...إنّها... الأشباح... حقًّا

70
00:05:50,390 --> 00:05:53,220
.لكنّ السّهم أتى من هنالك

71
00:05:53,220 --> 00:05:53,930
ماذا؟

72
00:05:56,760 --> 00:05:58,230
!لوفي! هنالك

73
00:05:58,560 --> 00:06:02,200
!ثمّة شخص هنالك
!أصغ إليّ يا لوفي

74
00:06:02,500 --> 00:06:04,900
!يا لوفي

75
00:06:04,900 --> 00:06:05,740
.قوس سهام

76
00:06:10,980 --> 00:06:12,710
!لوفي! احذر

77
00:06:17,580 --> 00:06:18,620
!...لوفي

78
00:06:20,150 --> 00:06:21,220
!...أيّها الـ

79
00:06:26,320 --> 00:06:28,690
!القتل المؤكّد: نجم النّار

80
00:06:40,770 --> 00:06:41,540
ما هذا؟

81
00:06:42,340 --> 00:06:43,210
!أكيبي

82
00:06:43,210 --> 00:06:44,610
!انتظر يا رونغو

83
00:06:46,310 --> 00:06:47,350
!أكيبي

84
00:06:47,350 --> 00:06:48,750
!تمهّل يا رونغو

85
00:06:50,580 --> 00:06:53,380
ماذا؟ أنتم محض أطفال إذًا؟

86
00:06:53,720 --> 00:06:54,720
!رونغو

87
00:06:56,090 --> 00:06:57,390
!أكيبي

88
00:06:57,790 --> 00:06:59,560
!أيّها الغبيّ، تراجع! اهرب

89
00:07:05,030 --> 00:07:07,030
...غومو غومو نوو

90
00:07:07,030 --> 00:07:08,130
!لقد عدت

91
00:07:10,740 --> 00:07:12,740
.أهلاً، شكرًا على إنقاذي سابقًا

92
00:07:12,740 --> 00:07:14,010
.العفو

93
00:07:15,040 --> 00:07:15,840
!رونغو

94
00:07:22,150 --> 00:07:23,520
!هذا يكفي

95
00:07:27,890 --> 00:07:32,790
،نحن قراصنة اليقطين
!و"حفلة القرد" هي منطقتنا

96
00:07:32,790 --> 00:07:35,930
أطلقوا سراح أصدقائي وأعيدوا لنا
!حمولتنا إن كنتم تريدون العيش

97
00:07:37,630 --> 00:07:38,430
قنبلة؟

98
00:07:39,000 --> 00:07:39,900
!رابا نوي

99
00:07:41,630 --> 00:07:42,870
هل يعقل...؟

100
00:07:43,300 --> 00:07:47,040
!مهلاً، إن استخدمتها، فسنهلك جميعًا

101
00:07:47,040 --> 00:07:49,440
!نحن على نفس القارب

102
00:07:49,440 --> 00:07:51,580
!نعيش ونموت سويًّا

103
00:07:58,150 --> 00:07:58,920
.لنذهب

104
00:07:58,920 --> 00:08:00,620
!أنا آسفة يا رابا نوي. رونغو

105
00:08:03,090 --> 00:08:04,360
رابا نوي...؟

106
00:08:05,220 --> 00:08:06,090
أهذا أنت يا رابا نوي؟

107
00:08:07,790 --> 00:08:11,230
...وأيضًا... إيسوكا ورونغو

108
00:08:11,630 --> 00:08:12,730
...هذا أنتم حقًّا

109
00:08:13,930 --> 00:08:16,000
!ألم تعرفوني؟ هذا أنا

110
00:08:16,000 --> 00:08:19,300
!لطالما كنّا نلعب معًا في رأس لولوكا

111
00:08:20,270 --> 00:08:20,970
!هينزو؟

112
00:08:21,740 --> 00:08:22,910
هل تعرفهم؟

113
00:08:24,040 --> 00:08:27,480
!...هينزو؟ لا يعقل أنّك

114
00:08:27,850 --> 00:08:30,010
...أيّتها الغبيّة! هذا مستحيل

115
00:08:30,680 --> 00:08:34,350
!تراجع! سـ-سأفجّرها! قلت تراجع

116
00:08:34,850 --> 00:08:36,150
!تـ-توقّف

117
00:08:46,300 --> 00:08:50,270
.المتفجّر رمز ثلاثة
.أنا من اخترعه في النّهاية

118
00:08:50,740 --> 00:08:53,300
.إنّها مجرّد أداة للتّحايل

119
00:09:04,620 --> 00:09:06,020
!سحقًا، إنّه دخان ساتر

120
00:09:07,320 --> 00:09:09,790
ما كلّ هذه الجلبة؟

121
00:09:09,790 --> 00:09:11,720
!هل أفقت الآن؟

122
00:09:12,160 --> 00:09:15,190
وأيضًا... من ذلك العجوز؟

123
00:09:15,190 --> 00:09:18,930
.سنستغرق بعض الوقت لنشرح لك

124
00:09:24,400 --> 00:09:26,940
.مهلاً، لقد اختفوا من هناك أيضًا

125
00:09:26,940 --> 00:09:29,610
من كان ذلك للتّوّ؟

126
00:09:30,440 --> 00:09:32,840
أخبرنا أيّها العمّ؟

127
00:10:10,850 --> 00:10:12,920
!هينزو! أسرع وانزل

128
00:10:13,520 --> 00:10:15,020
!أ-أنا خائف

129
00:10:15,020 --> 00:10:18,890
!لا تخف من شيءٍ كهذا
!نحن قراصنة اليقطين

130
00:10:42,810 --> 00:10:46,350
.عندما أكبر، سأصير قرصانًا حقيقيًّا

131
00:10:46,720 --> 00:10:50,120
،لكنّ والدك في البحريّة
أليس كذلك يا رابا نوي؟

132
00:10:50,120 --> 00:10:51,960
هل سيسمح لك؟

133
00:10:51,960 --> 00:10:53,890
.أبي هو أبي

134
00:10:53,890 --> 00:10:57,330
أريد خوض مغامرات في أماكن
!لم يشهدها أحد من قبل

135
00:10:57,660 --> 00:11:00,300
أماكن لم يشهدها أحد من قبل؟

136
00:11:00,300 --> 00:11:04,700
أكيد. توجد في هذا العالم الكثير
.من الأشياء الّتي لا يعرفها أحد

137
00:11:06,270 --> 00:11:07,670
.أريد أن أراها أيضًا

138
00:11:07,670 --> 00:11:10,180
.وأنا أيضًا. سأكون قرصانة

139
00:11:10,710 --> 00:11:14,110
لكن سنضطرّ لقتال القراصنة
الآخرين أيضًا، صحيح؟

140
00:11:14,110 --> 00:11:16,680
لا يمكن لشخص ضعيف
.مثلي فعل ذلك

141
00:11:16,680 --> 00:11:19,220
هينزو، تستطيع اختراع
شتّى الأشياء، أليس كذلك؟

142
00:11:19,720 --> 00:11:23,160
سوف تخترع العتاد الّذي
.سنحتاجه في مغامراتنا

143
00:11:24,220 --> 00:11:25,120
!صحيح

144
00:11:25,520 --> 00:11:27,730
!حسنًا، سأكون قرصانًا أيضًا

145
00:11:28,190 --> 00:11:30,330
!إقناعك سهل يا هينزو

146
00:11:39,500 --> 00:11:41,940
.كنّا في غاية السّعادة

147
00:11:42,910 --> 00:11:45,410
...اللّعب كأصدقاء والدّردشة

148
00:11:45,910 --> 00:11:48,280
.أمضيتُ أفضل أيّام حياتي معهم

149
00:11:49,410 --> 00:11:55,450
،كان كلّ يوم برّاقًا
.حتّى بريق الكنوز لا يجابهه

150
00:11:57,860 --> 00:12:01,490
إلى أن حدثت تلك
...الحادثة المروعة

151
00:12:17,610 --> 00:12:18,510
!هينزو

152
00:12:22,310 --> 00:12:24,180
!هينزو! هل أنت بخير؟

153
00:12:28,620 --> 00:12:30,660
!لقد أكملتُ المتفجّر رمز ثلاثة

154
00:12:34,330 --> 00:12:36,860
!أيّها الأحمق! لا تخفنا هكذا

155
00:12:36,860 --> 00:12:38,930
تقوم بالكثير من الإنذارات
الكاذبة حقًّا، صحيح؟

156
00:12:44,000 --> 00:12:46,570
!مصيبة! البلدة تحترق

157
00:12:46,570 --> 00:12:48,940
!بلدة لولوكا تحترق

158
00:12:58,720 --> 00:13:00,190
...هذا

159
00:13:00,190 --> 00:13:01,650
...بلدتنا

160
00:13:03,090 --> 00:13:04,860
!أبي! أمّي

161
00:13:06,020 --> 00:13:07,160
!رونغو

162
00:13:18,340 --> 00:13:19,940
!أحرقوا! أحرقوا

163
00:13:20,240 --> 00:13:22,740
!لا تتركوا أيّ شيء قيّم

164
00:13:22,740 --> 00:13:27,410
اقتلوا أيّ من يعادينا نحن
!قراصنة ويتّون! مفهوم؟

165
00:13:28,280 --> 00:13:30,550
!لا تظهروا أيّ رحمة للنّساء والأطفال

166
00:13:41,730 --> 00:13:42,990
!قراصنة

167
00:13:43,960 --> 00:13:45,260
ماذا؟

168
00:13:45,260 --> 00:13:48,330
ما زال هناك صبية لم يهربوا بعد؟

169
00:13:49,900 --> 00:13:51,500
.اسمعوا يا رفاق

170
00:13:51,500 --> 00:13:53,310
.سنجد سفنًا إن ذهبنا إلى الميناء

171
00:13:53,810 --> 00:13:56,780
.سنأخذ أيًّا منها ونغادر من هنا

172
00:13:56,780 --> 00:13:58,940
!لكن ماذا عن أبي والبقيّة؟

173
00:13:58,940 --> 00:14:00,580
!أيّها الغبيّ! هل تريد أن تُقتَل؟

174
00:14:00,950 --> 00:14:01,710
!هيّا

175
00:14:17,730 --> 00:14:19,030
...أولئك الأشقياء

176
00:14:32,210 --> 00:14:33,380
!...السّفن

177
00:14:33,380 --> 00:14:35,810
!لا بدّ أنّ أولئك الأشخاص أغرقوها

178
00:14:37,220 --> 00:14:39,250
!هناك! سنركب على متن تلك

179
00:14:39,250 --> 00:14:40,520
ماذا؟

180
00:14:40,520 --> 00:14:42,320
!لا توجد سواها، صحيح؟ لنذهب

181
00:14:50,260 --> 00:14:51,960
!ما الّذي تفعلونه بسفينتي؟

182
00:14:54,870 --> 00:14:56,030
!إنّه آتٍ

183
00:15:02,340 --> 00:15:03,180
!سحقًا

184
00:15:11,250 --> 00:15:12,820
!لقد سقط

185
00:15:19,620 --> 00:15:22,990
مستعدّون للتّوبيخ، أليس كذلك؟

186
00:15:39,080 --> 00:15:40,410
!بسرعة، إلى الأعلى

187
00:15:47,390 --> 00:15:50,920
أتظنّ أنّ شخصًا مثلك يمكنه
استخدام هذه الفأس؟

188
00:15:52,720 --> 00:15:55,160
.لا تغترّ بنفسك كثيرًا أيّها الصّبيّ

189
00:15:55,730 --> 00:15:57,000
!لستُ صبيًّا

190
00:15:57,500 --> 00:16:00,870
!أنا قائد قراصنة اليقطين رابا نوي

191
00:16:01,200 --> 00:16:02,370
!رابا نوي

192
00:16:02,370 --> 00:16:04,240
!لا بأس! إنّه لوحده

193
00:16:04,240 --> 00:16:06,570
!دعونا نوحّد قوّتنا جميعًا ونهزمه

194
00:16:09,240 --> 00:16:12,080
ماذا هناك أيّها القائد؟
هل سنبحر من الآن؟

195
00:16:12,080 --> 00:16:14,180
!هناك واحد آخر

196
00:16:23,190 --> 00:16:25,120
ماذا؟ من أنتم؟

197
00:16:40,740 --> 00:16:41,940
!ما ذلك؟

198
00:16:43,740 --> 00:16:45,310
!ضباب قوس قزح

199
00:16:45,310 --> 00:16:46,780
!أنتم، أسرعوا وأديروا المقود

200
00:16:46,780 --> 00:16:49,750
!إن سُحبنا إلى هناك، فلن نستطيع العودة

201
00:16:50,050 --> 00:16:52,220
!دُمّر المقود

202
00:16:54,190 --> 00:16:56,490
!أيّها الـ... ستدفعون ثمن هذا

203
00:16:57,490 --> 00:16:58,290
!أكيبي

204
00:16:58,790 --> 00:17:02,330
.لا تظنّوا أنّكم ستخرجون من هنا أحياء

205
00:17:15,010 --> 00:17:15,840
!أكيبي

206
00:17:18,410 --> 00:17:20,050
.لقد خُلع كتفك

207
00:17:20,050 --> 00:17:21,350
!رابا نوي

208
00:17:23,520 --> 00:17:25,020
!ستدفع ثمن هذا

209
00:17:32,190 --> 00:17:36,090
!هينزو

210
00:17:37,660 --> 00:17:39,900
!عودوا! أعيدوا السّفينة إلى الوراء

211
00:17:39,900 --> 00:17:42,270
!لا نستطيع! المقود مكسور

212
00:17:43,400 --> 00:17:47,010
!...ضباب قوس قزح... ضباب قوس قزح

213
00:17:47,470 --> 00:17:48,540
!رابا نوي

214
00:17:49,610 --> 00:17:52,840
!اذهبوا! تابعوا طريقكم ولا تقلقوا بشأني

215
00:17:53,180 --> 00:17:54,310
!هينزو

216
00:17:54,680 --> 00:17:56,880
!أعدكم أن ألحق بكم لاحقًا

217
00:17:56,880 --> 00:18:01,120
!أنا عضو من قراصنة اليقطين أيضًا

218
00:18:03,920 --> 00:18:05,120
...هينزو

219
00:18:10,230 --> 00:18:12,130
...مذّاك الحين

220
00:18:13,470 --> 00:18:17,440
.لم يعد رابا نوي والبقيّة مذّاك الحين

221
00:18:18,700 --> 00:18:23,140
لا أصدّق أنّهم أصبحوا قراصنة
...في مكان كهذا

222
00:18:23,480 --> 00:18:27,180
أجل، لكنّ ذلك حدث قبل
خمسين سنة، صحيح؟

223
00:18:27,180 --> 00:18:29,980
.كانوا لا يزالون أطفالاً صغار

224
00:18:30,620 --> 00:18:35,890
يبدو أنّ سير الوقت في ضباب
.قوس قزح مختلف

225
00:18:35,890 --> 00:18:39,260
،قد يعادل يومٌ هنا أسبوعًا

226
00:18:39,260 --> 00:18:42,590
.أو حتّى عامًا في العالم الخارجيّ

227
00:18:42,590 --> 00:18:44,260
!مـ-ماذا؟

228
00:18:44,260 --> 00:18:47,830
إن كان ذلك صحيحًا، علينا إيجاد
،طريقة للخروج من هنا بسرعة

229
00:18:47,830 --> 00:18:50,000
.وإلاّ لن نستطيع العودة

230
00:18:50,000 --> 00:18:50,700
لِمَ لا؟

231
00:18:50,700 --> 00:18:52,470
.أنت بليد حقًّا

232
00:18:52,470 --> 00:18:57,080
قد يصيبنا نفس ما أصاب
!أولئك الفتية وذاك العجوز

233
00:18:57,080 --> 00:18:59,210
،بينما نحن هنا نأخذ الأمور بروية

234
00:18:59,210 --> 00:19:02,910
قد تصبح نامي والبقيّة
!في الخارج كبارًا في السّنّ

235
00:19:02,910 --> 00:19:03,980
!ماذا؟

236
00:19:04,180 --> 00:19:06,180
!اسمع أيّها العمّ، لنعد بسرعة

237
00:19:06,180 --> 00:19:09,990
!كما قال، لا نعلم كيف نرجع

238
00:19:09,990 --> 00:19:11,860
!ماذا؟! أهذا صحيح؟

239
00:19:11,120 --> 00:19:13,290
إذًا؟ لا توجد عودة؟

240
00:19:13,130 --> 00:19:16,060
!ما الّذي كنت تصغي إليه يا لوفي؟

241
00:19:13,290 --> 00:19:14,190
.كلاّ

242
00:19:14,190 --> 00:19:15,990
.لا بدّ من وجود طريقة

243
00:19:16,060 --> 00:19:20,000
!لا بدّ أنّهم شرحوا الأمر ثلاث مرّات على الأقلّ

244
00:19:16,260 --> 00:19:18,700
."من أجل الخروج من "حفلة القرد

245
00:19:20,000 --> 00:19:21,170
ثلاث مرّات؟

246
00:19:26,470 --> 00:19:29,310
.تبًّا، إنّهم عنيدون

247
00:19:29,310 --> 00:19:31,110
.ذلك السّلاح مزعج

248
00:19:31,410 --> 00:19:33,280
!اخرسوا! سأجهز عليكم

249
00:19:44,790 --> 00:19:45,890
!ليك-ساما

250
00:19:45,890 --> 00:19:47,490
هل أنت بخير يا ليك-ساما؟

251
00:19:53,570 --> 00:19:55,970
!هل أنتم من رمى ذلك؟

252
00:19:55,970 --> 00:19:57,200
.كلاّ، ليس نحن

253
00:19:57,200 --> 00:19:59,200
ألم يكن ينظر إلينا أساسًا؟

254
00:19:59,200 --> 00:20:01,640
.لا تنسيا أنّه يرتدي ذلك الشّيء

255
00:20:01,840 --> 00:20:04,010
!سألتكم، أكان أنتم؟

256
00:20:04,840 --> 00:20:06,480
وماذا إن قلنا نعم؟

257
00:20:07,750 --> 00:20:08,580
.حسنًا

258
00:20:09,480 --> 00:20:10,950
!هل التقطتها؟

259
00:20:12,050 --> 00:20:15,750
.لقد حصّلتُ رسوم إرسائكم في الميناء

260
00:20:15,750 --> 00:20:19,660
.وأرحّب بكم الآن رسميًّا كمواطنين من لولوكا

261
00:20:22,830 --> 00:20:25,030
حفلة القرد"؟"

262
00:20:25,030 --> 00:20:25,800
.نعم

263
00:20:26,330 --> 00:20:29,700
قال بعض الجنود أنّهم رؤوا سفينتكم

264
00:20:29,700 --> 00:20:32,340
.تدخل إلى ضباب قوس قزح بلا شكّ

265
00:20:32,770 --> 00:20:38,280
.وفقًا لما قاله المحافظ، إنّها مليئة بالكنوز

266
00:20:38,280 --> 00:20:39,340
!كنوز؟

267
00:20:40,350 --> 00:20:43,320
.يقال أنّ "حفلة القرد" مقبرة للسّفن

268
00:20:44,180 --> 00:20:48,950
السّفن المحطّمة هنالك تحتوي
.على صناديق كنوز سليمة

269
00:20:48,950 --> 00:20:50,860
،يريد المحافظ الكنوز الّتي هنالك

270
00:20:50,860 --> 00:20:55,530
ولهذا عيّن عالمًا يدعى هينزو للبحث
."عن طريقة للدّخول إلى "حفلة القرد

271
00:20:55,530 --> 00:20:59,400
صحيح، صنع ذلك العجوز هذه
.البذلة ذات الصّدمة الكهربائيّة أيضًا

272
00:20:59,400 --> 00:21:02,330
ما رأيكم؟ مصقولة حقًّا، أليس كذلك؟

273
00:21:03,000 --> 00:21:05,840
إنّه يحبّ الثرثرة حقًّا، صحيح؟

274
00:21:05,840 --> 00:21:09,210
ألا يجدر أن يسعد بتحصيل
الضّرائب فحسب؟

275
00:21:09,610 --> 00:21:11,480
!لا يمكننا البقاء هنا

276
00:21:11,480 --> 00:21:14,410
!سندخل إلى ذلك الضّباب أيضًا

277
00:21:14,410 --> 00:21:16,180
!أجل يا نامي-سان

278
00:21:16,550 --> 00:21:19,050
،لكن فور أن ندخل إلى هناك
!لن نستطيع العودة

279
00:21:19,050 --> 00:21:20,650
!ما الفائدة من الخوف؟

280
00:21:20,650 --> 00:21:22,690
!كنزنا ينتظرنا

281
00:21:22,690 --> 00:21:23,490
!ماذا؟

282
00:21:24,160 --> 00:21:28,630
لن يدخل أيّ أحد إلى
.حفلة القرد" بدون إذنٍ منّي"

283
00:21:30,800 --> 00:21:31,800
!جدّي

284
00:21:31,800 --> 00:21:32,860
!أيّها الأبله

285
00:21:34,200 --> 00:21:35,730
جدّه؟

286
00:21:36,400 --> 00:21:38,800
.ذاكرتك سيّئة

287
00:21:38,800 --> 00:21:40,570
ألم أخبرك دائمًا؟

288
00:21:41,940 --> 00:21:45,980
".يجب أن تدعوني بـ"المحافظ

289
00:21:48,380 --> 00:21:50,620
."المحافظ ويتّون"

290
00:21:55,390 --> 00:22:03,460
آه، خلف السّماء الّتي لا نهاية لها

291
00:22:03,460 --> 00:22:14,080
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

292
00:22:21,950 --> 00:22:29,390
مرّت عليّ أيّام كدت أخسر فيها نفسي

293
00:22:29,390 --> 00:22:37,800
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

294
00:22:37,800 --> 00:22:46,010
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

295
00:22:46,010 --> 00:22:54,850
دفعوا بي للأمام، أليس كذلك؟

296
00:22:54,850 --> 00:23:03,160
آه، إنّ النّجوم تهوي من السّماء

297
00:23:03,160 --> 00:23:06,290
...وهذه اللّحظة الفريدة

298
00:23:11,630 --> 00:23:15,140
أيمكنك أن تصدّق أنّ ذلك العجوز
وأولئك الأطفال كانوا في نفس السّنّ؟

299
00:23:15,140 --> 00:23:16,570
ما الّذي تفعله يا لوفي؟

300
00:23:16,570 --> 00:23:18,510
،فكّرتُ أنّنا إن حرّكنا السّفينة
.يمكننا الخروج من هنا

301
00:23:18,510 --> 00:23:20,210
!أيجب أن نفعل ذلك بدون نامي؟

302
00:23:20,210 --> 00:23:21,910
.لا بدّ أنّها مستاءة لأنّها لم تأت معنا

303
00:23:21,910 --> 00:23:24,280
ربّما أصبحت عجوزًا الآن؟

304
00:23:25,280 --> 00:23:26,950
!لا تقل شيئًا مخيفًا هكذا

305
00:23:27,320 --> 00:23:28,580
:في الحلقة القادمة من ون بيس

306
00:23:28,580 --> 00:23:31,920
مشاعر الحنين! مقبرة القراصنة"
"!الّتي لا خروج منها

307
00:23:31,920 --> 00:23:34,160
!ملك القراصنة، لن يكون إلاّ أنا