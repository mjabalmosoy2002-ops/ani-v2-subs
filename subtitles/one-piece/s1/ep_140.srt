1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:05,980 --> 00:02:07,250
أنتم أولئك المتغطرسون

22
00:02:07,250 --> 00:02:09,950
الّذين لم يدفعوا ضرائبهم
في الميناء، أليس كذلك؟

23
00:02:19,930 --> 00:02:20,930
!سانجي

24
00:02:20,930 --> 00:02:22,600
!تبًّا، ما الّذي تفعله؟

25
00:02:26,100 --> 00:02:27,870
!إنّه ضباب قوس قزح

26
00:02:39,350 --> 00:02:40,990
أيّها الأستاذ، أين نحن؟

27
00:02:40,990 --> 00:02:42,950
."حفلة القرد"

28
00:02:42,950 --> 00:02:44,920
.حفلة القرد"؟ لا يعقل"

29
00:02:44,920 --> 00:02:45,960
!مـ-ماذا تعني؟

30
00:02:48,330 --> 00:02:52,230
مقبرة سفن، حيث من يدخلها
.لا يرجع منها أبدًا

31
00:02:56,130 --> 00:03:00,100
"!سكّان أرض البقاء! قراصنة اليقطين"

32
00:03:16,350 --> 00:03:20,090
انظروا! لا شيء في مرآنا
!سوى السّفن الغارقة

33
00:03:20,090 --> 00:03:24,400
لنتراجع عن هذا. يبدو وكأنّ
.قائدًا شبحًا سيظهر في أيّ لحظة

34
00:03:24,400 --> 00:03:26,800
!حقًّا؟ أيّها القائد الشّبح

35
00:03:26,800 --> 00:03:27,570
!لا تنادي عليه

36
00:03:28,430 --> 00:03:31,670
.يوجد خلف ضباب قوس قزح عالم البقاء

37
00:03:31,670 --> 00:03:33,740
.الجنّة النّهائيّة المتبقّية في الأرض

38
00:03:34,470 --> 00:03:36,170
،وهي مليئة بكنوز الذّهب والفضّة

39
00:03:36,170 --> 00:03:39,180
حيث يعيش النّاس خالدين
.دون أن يكبروا أو يجوعوا

40
00:03:39,540 --> 00:03:41,750
.هذا ما ذُكر في هذا الكتاب

41
00:03:41,750 --> 00:03:46,220
.أخبرتك أنّ ذلك ما إلاّ أسطورة

42
00:03:47,050 --> 00:03:50,920
أيّها الأستاذ، هل عرفت أنّ هذا
المكان عبارة عن مقبرة سفن؟

43
00:03:51,290 --> 00:03:56,390
نعم. قبل خمسين سنة، ألقيتُ
.نظرة خاطفة عن هذا المكان

44
00:03:56,690 --> 00:03:58,100
إن كنت تعرف هذا، فلمَ أتيت؟

45
00:03:58,100 --> 00:04:00,030
.أخبرتك أيضًا

46
00:04:00,030 --> 00:04:05,840
كنتُ أجري بحثي لإنقاذ أصدقائي
.الّذين ابتلعهم هذا الضّباب

47
00:04:05,840 --> 00:04:09,370
،حتّى أنّني أصبحتُ كلبًا لدى ويتّون

48
00:04:09,370 --> 00:04:11,140
.وتحمّلت أصابع اللّوم لذلك الهدف

49
00:04:15,410 --> 00:04:17,110
!رفاق

50
00:04:17,620 --> 00:04:19,420
!انظروا إلى هذا

51
00:04:25,490 --> 00:04:26,460
ما هذا؟

52
00:04:27,990 --> 00:04:29,890
أليس رائعًا؟

53
00:04:29,890 --> 00:04:31,930
!ثمّة المزيد داخل السّفينة

54
00:04:32,460 --> 00:04:34,200
!سأذهب للاستكشاف أكثر

55
00:04:34,830 --> 00:04:37,000
،سواء كانت هذه جنّة أم لا

56
00:04:37,000 --> 00:04:41,940
إلاّ أنّ جزئيّة "مليئة بالكنوز" لا تبدو
كذبة عمومًا، أليس ذلك أيّها الأستاذ؟

57
00:05:00,520 --> 00:05:03,990
...أيا من تقلقون راحة الأموات

58
00:05:04,700 --> 00:05:06,430
!مـ-ما هذا؟

59
00:05:06,430 --> 00:05:09,870
،دعوا الصّناديق وارحلوا فورًا

60
00:05:10,300 --> 00:05:16,070
!وإلاّ ألحقنا بكم لعنة الموتى

61
00:05:16,070 --> 00:05:18,540
!...أ-أنا خـ-خائف

62
00:05:19,110 --> 00:05:19,940
من هناك؟

63
00:05:23,650 --> 00:05:25,220
!ها قد ظهرت

64
00:05:29,650 --> 00:05:33,660
...والآن، سلّمونا الصّندوق بلا مقاومة

65
00:05:34,090 --> 00:05:36,030
...وإلاّ

66
00:05:38,800 --> 00:05:41,070
...كان ذلك وشيكًا! أيّها الـ

67
00:05:46,570 --> 00:05:49,440
!...أيّها القائد الشّبح

68
00:05:56,110 --> 00:05:58,180
!إنّها فارغة

69
00:05:58,480 --> 00:06:02,150
!...إنّها... الأشباح... حقًّا

70
00:06:04,390 --> 00:06:07,220
.لكنّ السّهم أتى من هنالك

71
00:06:07,220 --> 00:06:07,930
ماذا؟

72
00:06:10,760 --> 00:06:12,230
!لوفي! هنالك

73
00:06:12,560 --> 00:06:16,200
!ثمّة شخص هنالك
!أصغ إليّ يا لوفي

74
00:06:16,500 --> 00:06:18,900
!يا لوفي

75
00:06:18,900 --> 00:06:19,740
.قوس سهام

76
00:06:24,980 --> 00:06:26,710
!لوفي! احذر

77
00:06:31,580 --> 00:06:32,620
!...لوفي

78
00:06:34,150 --> 00:06:35,220
!...أيّها الـ

79
00:06:40,320 --> 00:06:42,690
!القتل المؤكّد: نجم النّار

80
00:06:54,770 --> 00:06:55,540
ما هذا؟

81
00:06:56,340 --> 00:06:57,210
!أكيبي

82
00:06:57,210 --> 00:06:58,610
!انتظر يا رونغو

83
00:07:00,310 --> 00:07:01,350
!أكيبي

84
00:07:01,350 --> 00:07:02,750
!تمهّل يا رونغو

85
00:07:04,580 --> 00:07:07,380
ماذا؟ أنتم محض أطفال إذًا؟

86
00:07:07,720 --> 00:07:08,720
!رونغو

87
00:07:10,090 --> 00:07:11,390
!أكيبي

88
00:07:11,790 --> 00:07:13,560
!أيّها الغبيّ، تراجع! اهرب

89
00:07:19,030 --> 00:07:21,030
...غومو غومو نوو

90
00:07:21,030 --> 00:07:22,130
!لقد عدت

91
00:07:24,740 --> 00:07:26,740
.أهلاً، شكرًا على إنقاذي سابقًا

92
00:07:26,740 --> 00:07:28,010
.العفو

93
00:07:29,040 --> 00:07:29,840
!رونغو

94
00:07:36,150 --> 00:07:37,520
!هذا يكفي

95
00:07:41,890 --> 00:07:46,790
،نحن قراصنة اليقطين
!و"حفلة القرد" هي منطقتنا

96
00:07:46,790 --> 00:07:49,930
أطلقوا سراح أصدقائي وأعيدوا لنا
!حمولتنا إن كنتم تريدون العيش

97
00:07:51,630 --> 00:07:52,430
قنبلة؟

98
00:07:53,000 --> 00:07:53,900
!رابا نوي

99
00:07:55,630 --> 00:07:56,870
هل يعقل...؟

100
00:07:57,300 --> 00:08:01,040
!مهلاً، إن استخدمتها، فسنهلك جميعًا

101
00:08:01,040 --> 00:08:03,440
!نحن على نفس القارب

102
00:08:03,440 --> 00:08:05,580
!نعيش ونموت سويًّا

103
00:08:12,150 --> 00:08:12,920
.لنذهب

104
00:08:12,920 --> 00:08:14,620
!أنا آسفة يا رابا نوي. رونغو

105
00:08:17,090 --> 00:08:18,360
رابا نوي...؟

106
00:08:19,220 --> 00:08:20,090
أهذا أنت يا رابا نوي؟

107
00:08:21,790 --> 00:08:25,230
...وأيضًا... إيسوكا ورونغو

108
00:08:25,630 --> 00:08:26,730
...هذا أنتم حقًّا

109
00:08:27,930 --> 00:08:30,000
!ألم تعرفوني؟ هذا أنا

110
00:08:30,000 --> 00:08:33,300
!لطالما كنّا نلعب معًا في رأس لولوكا

111
00:08:34,270 --> 00:08:34,970
!هينزو؟

112
00:08:35,740 --> 00:08:36,910
هل تعرفهم؟

113
00:08:38,040 --> 00:08:41,480
!...هينزو؟ لا يعقل أنّك

114
00:08:41,850 --> 00:08:44,010
...أيّتها الغبيّة! هذا مستحيل

115
00:08:44,680 --> 00:08:48,350
!تراجع! سـ-سأفجّرها! قلت تراجع

116
00:08:48,850 --> 00:08:50,150
!تـ-توقّف

117
00:09:00,300 --> 00:09:04,270
.المتفجّر رمز ثلاثة
.أنا من اخترعه في النّهاية

118
00:09:04,740 --> 00:09:07,300
.إنّها مجرّد أداة للتّحايل

119
00:09:18,620 --> 00:09:20,020
!سحقًا، إنّه دخان ساتر

120
00:09:21,320 --> 00:09:23,790
ما كلّ هذه الجلبة؟

121
00:09:23,790 --> 00:09:25,720
!هل أفقت الآن؟

122
00:09:26,160 --> 00:09:29,190
وأيضًا... من ذلك العجوز؟

123
00:09:29,190 --> 00:09:32,930
.سنستغرق بعض الوقت لنشرح لك

124
00:09:38,400 --> 00:09:40,940
.مهلاً، لقد اختفوا من هناك أيضًا

125
00:09:40,940 --> 00:09:43,610
من كان ذلك للتّوّ؟

126
00:09:44,440 --> 00:09:46,840
أخبرنا أيّها العمّ؟

127
00:10:24,850 --> 00:10:26,920
!هينزو! أسرع وانزل

128
00:10:27,520 --> 00:10:29,020
!أ-أنا خائف

129
00:10:29,020 --> 00:10:32,890
!لا تخف من شيءٍ كهذا
!نحن قراصنة اليقطين

130
00:10:56,810 --> 00:11:00,350
.عندما أكبر، سأصير قرصانًا حقيقيًّا

131
00:11:00,720 --> 00:11:04,120
،لكنّ والدك في البحريّة
أليس كذلك يا رابا نوي؟

132
00:11:04,120 --> 00:11:05,960
هل سيسمح لك؟

133
00:11:05,960 --> 00:11:07,890
.أبي هو أبي

134
00:11:07,890 --> 00:11:11,330
أريد خوض مغامرات في أماكن
!لم يشهدها أحد من قبل

135
00:11:11,660 --> 00:11:14,300
أماكن لم يشهدها أحد من قبل؟

136
00:11:14,300 --> 00:11:18,700
أكيد. توجد في هذا العالم الكثير
.من الأشياء الّتي لا يعرفها أحد

137
00:11:20,270 --> 00:11:21,670
.أريد أن أراها أيضًا

138
00:11:21,670 --> 00:11:24,180
.وأنا أيضًا. سأكون قرصانة

139
00:11:24,710 --> 00:11:28,110
لكن سنضطرّ لقتال القراصنة
الآخرين أيضًا، صحيح؟

140
00:11:28,110 --> 00:11:30,680
لا يمكن لشخص ضعيف
.مثلي فعل ذلك

141
00:11:30,680 --> 00:11:33,220
هينزو، تستطيع اختراع
شتّى الأشياء، أليس كذلك؟

142
00:11:33,720 --> 00:11:37,160
سوف تخترع العتاد الّذي
.سنحتاجه في مغامراتنا

143
00:11:38,220 --> 00:11:39,120
!صحيح

144
00:11:39,520 --> 00:11:41,730
!حسنًا، سأكون قرصانًا أيضًا

145
00:11:42,190 --> 00:11:44,330
!إقناعك سهل يا هينزو

146
00:11:53,500 --> 00:11:55,940
.كنّا في غاية السّعادة

147
00:11:56,910 --> 00:11:59,410
...اللّعب كأصدقاء والدّردشة

148
00:11:59,910 --> 00:12:02,280
.أمضيتُ أفضل أيّام حياتي معهم

149
00:12:03,410 --> 00:12:09,450
،كان كلّ يوم برّاقًا
.حتّى بريق الكنوز لا يجابهه

150
00:12:11,860 --> 00:12:15,490
إلى أن حدثت تلك
...الحادثة المروعة

151
00:12:31,610 --> 00:12:32,510
!هينزو

152
00:12:36,310 --> 00:12:38,180
!هينزو! هل أنت بخير؟

153
00:12:42,620 --> 00:12:44,660
!لقد أكملتُ المتفجّر رمز ثلاثة

154
00:12:48,330 --> 00:12:50,860
!أيّها الأحمق! لا تخفنا هكذا

155
00:12:50,860 --> 00:12:52,930
تقوم بالكثير من الإنذارات
الكاذبة حقًّا، صحيح؟

156
00:12:58,000 --> 00:13:00,570
!مصيبة! البلدة تحترق

157
00:13:00,570 --> 00:13:02,940
!بلدة لولوكا تحترق

158
00:13:12,720 --> 00:13:14,190
...هذا

159
00:13:14,190 --> 00:13:15,650
...بلدتنا

160
00:13:17,090 --> 00:13:18,860
!أبي! أمّي

161
00:13:20,020 --> 00:13:21,160
!رونغو

162
00:13:32,340 --> 00:13:33,940
!أحرقوا! أحرقوا

163
00:13:34,240 --> 00:13:36,740
!لا تتركوا أيّ شيء قيّم

164
00:13:36,740 --> 00:13:41,410
اقتلوا أيّ من يعادينا نحن
!قراصنة ويتّون! مفهوم؟

165
00:13:42,280 --> 00:13:44,550
!لا تظهروا أيّ رحمة للنّساء والأطفال

166
00:13:55,730 --> 00:13:56,990
!قراصنة

167
00:13:57,960 --> 00:13:59,260
ماذا؟

168
00:13:59,260 --> 00:14:02,330
ما زال هناك صبية لم يهربوا بعد؟

169
00:14:03,900 --> 00:14:05,500
.اسمعوا يا رفاق

170
00:14:05,500 --> 00:14:07,310
.سنجد سفنًا إن ذهبنا إلى الميناء

171
00:14:07,810 --> 00:14:10,780
.سنأخذ أيًّا منها ونغادر من هنا

172
00:14:10,780 --> 00:14:12,940
!لكن ماذا عن أبي والبقيّة؟

173
00:14:12,940 --> 00:14:14,580
!أيّها الغبيّ! هل تريد أن تُقتَل؟

174
00:14:14,950 --> 00:14:15,710
!هيّا

175
00:14:31,730 --> 00:14:33,030
...أولئك الأشقياء

176
00:14:46,210 --> 00:14:47,380
!...السّفن

177
00:14:47,380 --> 00:14:49,810
!لا بدّ أنّ أولئك الأشخاص أغرقوها

178
00:14:51,220 --> 00:14:53,250
!هناك! سنركب على متن تلك

179
00:14:53,250 --> 00:14:54,520
ماذا؟

180
00:14:54,520 --> 00:14:56,320
!لا توجد سواها، صحيح؟ لنذهب

181
00:15:04,260 --> 00:15:05,960
!ما الّذي تفعلونه بسفينتي؟

182
00:15:08,870 --> 00:15:10,030
!إنّه آتٍ

183
00:15:16,340 --> 00:15:17,180
!سحقًا

184
00:15:25,250 --> 00:15:26,820
!لقد سقط

185
00:15:33,620 --> 00:15:36,990
مستعدّون للتّوبيخ، أليس كذلك؟

186
00:15:53,080 --> 00:15:54,410
!بسرعة، إلى الأعلى

187
00:16:01,390 --> 00:16:04,920
أتظنّ أنّ شخصًا مثلك يمكنه
استخدام هذه الفأس؟

188
00:16:06,720 --> 00:16:09,160
.لا تغترّ بنفسك كثيرًا أيّها الصّبيّ

189
00:16:09,730 --> 00:16:11,000
!لستُ صبيًّا

190
00:16:11,500 --> 00:16:14,870
!أنا قائد قراصنة اليقطين رابا نوي

191
00:16:15,200 --> 00:16:16,370
!رابا نوي

192
00:16:16,370 --> 00:16:18,240
!لا بأس! إنّه لوحده

193
00:16:18,240 --> 00:16:20,570
!دعونا نوحّد قوّتنا جميعًا ونهزمه

194
00:16:23,240 --> 00:16:26,080
ماذا هناك أيّها القائد؟
هل سنبحر من الآن؟

195
00:16:26,080 --> 00:16:28,180
!هناك واحد آخر

196
00:16:37,190 --> 00:16:39,120
ماذا؟ من أنتم؟

197
00:16:54,740 --> 00:16:55,940
!ما ذلك؟

198
00:16:57,740 --> 00:16:59,310
!ضباب قوس قزح

199
00:16:59,310 --> 00:17:00,780
!أنتم، أسرعوا وأديروا المقود

200
00:17:00,780 --> 00:17:03,750
!إن سُحبنا إلى هناك، فلن نستطيع العودة

201
00:17:04,050 --> 00:17:06,220
!دُمّر المقود

202
00:17:08,190 --> 00:17:10,490
!أيّها الـ... ستدفعون ثمن هذا

203
00:17:11,490 --> 00:17:12,290
!أكيبي

204
00:17:12,790 --> 00:17:16,330
.لا تظنّوا أنّكم ستخرجون من هنا أحياء

205
00:17:29,010 --> 00:17:29,840
!أكيبي

206
00:17:32,410 --> 00:17:34,050
.لقد خُلع كتفك

207
00:17:34,050 --> 00:17:35,350
!رابا نوي

208
00:17:37,520 --> 00:17:39,020
!ستدفع ثمن هذا

209
00:17:46,190 --> 00:17:50,090
!هينزو

210
00:17:51,660 --> 00:17:53,900
!عودوا! أعيدوا السّفينة إلى الوراء

211
00:17:53,900 --> 00:17:56,270
!لا نستطيع! المقود مكسور

212
00:17:57,400 --> 00:18:01,010
!...ضباب قوس قزح... ضباب قوس قزح

213
00:18:01,470 --> 00:18:02,540
!رابا نوي

214
00:18:03,610 --> 00:18:06,840
!اذهبوا! تابعوا طريقكم ولا تقلقوا بشأني

215
00:18:07,180 --> 00:18:08,310
!هينزو

216
00:18:08,680 --> 00:18:10,880
!أعدكم أن ألحق بكم لاحقًا

217
00:18:10,880 --> 00:18:15,120
!أنا عضو من قراصنة اليقطين أيضًا

218
00:18:17,920 --> 00:18:19,120
...هينزو

219
00:18:24,230 --> 00:18:26,130
...مذّاك الحين

220
00:18:27,470 --> 00:18:31,440
.لم يعد رابا نوي والبقيّة مذّاك الحين

221
00:18:32,700 --> 00:18:37,140
لا أصدّق أنّهم أصبحوا قراصنة
...في مكان كهذا

222
00:18:37,480 --> 00:18:41,180
أجل، لكنّ ذلك حدث قبل
خمسين سنة، صحيح؟

223
00:18:41,180 --> 00:18:43,980
.كانوا لا يزالون أطفالاً صغار

224
00:18:44,620 --> 00:18:49,890
يبدو أنّ سير الوقت في ضباب
.قوس قزح مختلف

225
00:18:49,890 --> 00:18:53,260
،قد يعادل يومٌ هنا أسبوعًا

226
00:18:53,260 --> 00:18:56,590
.أو حتّى عامًا في العالم الخارجيّ

227
00:18:56,590 --> 00:18:58,260
!مـ-ماذا؟

228
00:18:58,260 --> 00:19:01,830
إن كان ذلك صحيحًا، علينا إيجاد
،طريقة للخروج من هنا بسرعة

229
00:19:01,830 --> 00:19:04,000
.وإلاّ لن نستطيع العودة

230
00:19:04,000 --> 00:19:04,700
لِمَ لا؟

231
00:19:04,700 --> 00:19:06,470
.أنت بليد حقًّا

232
00:19:06,470 --> 00:19:11,080
قد يصيبنا نفس ما أصاب
!أولئك الفتية وذاك العجوز

233
00:19:11,080 --> 00:19:13,210
،بينما نحن هنا نأخذ الأمور بروية

234
00:19:13,210 --> 00:19:16,910
قد تصبح نامي والبقيّة
!في الخارج كبارًا في السّنّ

235
00:19:16,910 --> 00:19:17,980
!ماذا؟

236
00:19:18,180 --> 00:19:20,180
!اسمع أيّها العمّ، لنعد بسرعة

237
00:19:20,180 --> 00:19:23,990
!كما قال، لا نعلم كيف نرجع

238
00:19:23,990 --> 00:19:25,860
!ماذا؟! أهذا صحيح؟

239
00:19:25,120 --> 00:19:27,290
إذًا؟ لا توجد عودة؟

240
00:19:27,130 --> 00:19:30,060
!ما الّذي كنت تصغي إليه يا لوفي؟

241
00:19:27,290 --> 00:19:28,190
.كلاّ

242
00:19:28,190 --> 00:19:29,990
.لا بدّ من وجود طريقة

243
00:19:30,060 --> 00:19:34,000
!لا بدّ أنّهم شرحوا الأمر ثلاث مرّات على الأقلّ

244
00:19:30,260 --> 00:19:32,700
."من أجل الخروج من "حفلة القرد

245
00:19:34,000 --> 00:19:35,170
ثلاث مرّات؟

246
00:19:40,470 --> 00:19:43,310
.تبًّا، إنّهم عنيدون

247
00:19:43,310 --> 00:19:45,110
.ذلك السّلاح مزعج

248
00:19:45,410 --> 00:19:47,280
!اخرسوا! سأجهز عليكم

249
00:19:58,790 --> 00:19:59,890
!ليك-ساما

250
00:19:59,890 --> 00:20:01,490
هل أنت بخير يا ليك-ساما؟

251
00:20:07,570 --> 00:20:09,970
!هل أنتم من رمى ذلك؟

252
00:20:09,970 --> 00:20:11,200
.كلاّ، ليس نحن

253
00:20:11,200 --> 00:20:13,200
ألم يكن ينظر إلينا أساسًا؟

254
00:20:13,200 --> 00:20:15,640
.لا تنسيا أنّه يرتدي ذلك الشّيء

255
00:20:15,840 --> 00:20:18,010
!سألتكم، أكان أنتم؟

256
00:20:18,840 --> 00:20:20,480
وماذا إن قلنا نعم؟

257
00:20:21,750 --> 00:20:22,580
.حسنًا

258
00:20:23,480 --> 00:20:24,950
!هل التقطتها؟

259
00:20:26,050 --> 00:20:29,750
.لقد حصّلتُ رسوم إرسائكم في الميناء

260
00:20:29,750 --> 00:20:33,660
.وأرحّب بكم الآن رسميًّا كمواطنين من لولوكا

261
00:20:36,830 --> 00:20:39,030
حفلة القرد"؟"

262
00:20:39,030 --> 00:20:39,800
.نعم

263
00:20:40,330 --> 00:20:43,700
قال بعض الجنود أنّهم رؤوا سفينتكم

264
00:20:43,700 --> 00:20:46,340
.تدخل إلى ضباب قوس قزح بلا شكّ

265
00:20:46,770 --> 00:20:52,280
.وفقًا لما قاله المحافظ، إنّها مليئة بالكنوز

266
00:20:52,280 --> 00:20:53,340
!كنوز؟

267
00:20:54,350 --> 00:20:57,320
.يقال أنّ "حفلة القرد" مقبرة للسّفن

268
00:20:58,180 --> 00:21:02,950
السّفن المحطّمة هنالك تحتوي
.على صناديق كنوز سليمة

269
00:21:02,950 --> 00:21:04,860
،يريد المحافظ الكنوز الّتي هنالك

270
00:21:04,860 --> 00:21:09,530
ولهذا عيّن عالمًا يدعى هينزو للبحث
."عن طريقة للدّخول إلى "حفلة القرد

271
00:21:09,530 --> 00:21:13,400
صحيح، صنع ذلك العجوز هذه
.البذلة ذات الصّدمة الكهربائيّة أيضًا

272
00:21:13,400 --> 00:21:16,330
ما رأيكم؟ مصقولة حقًّا، أليس كذلك؟

273
00:21:17,000 --> 00:21:19,840
إنّه يحبّ الثرثرة حقًّا، صحيح؟

274
00:21:19,840 --> 00:21:23,210
ألا يجدر أن يسعد بتحصيل
الضّرائب فحسب؟

275
00:21:23,610 --> 00:21:25,480
!لا يمكننا البقاء هنا

276
00:21:25,480 --> 00:21:28,410
!سندخل إلى ذلك الضّباب أيضًا

277
00:21:28,410 --> 00:21:30,180
!أجل يا نامي-سان

278
00:21:30,550 --> 00:21:33,050
،لكن فور أن ندخل إلى هناك
!لن نستطيع العودة

279
00:21:33,050 --> 00:21:34,650
!ما الفائدة من الخوف؟

280
00:21:34,650 --> 00:21:36,690
!كنزنا ينتظرنا

281
00:21:36,690 --> 00:21:37,490
!ماذا؟

282
00:21:38,160 --> 00:21:42,630
لن يدخل أيّ أحد إلى
.حفلة القرد" بدون إذنٍ منّي"

283
00:21:44,800 --> 00:21:45,800
!جدّي

284
00:21:45,800 --> 00:21:46,860
!أيّها الأبله

285
00:21:48,200 --> 00:21:49,730
جدّه؟

286
00:21:50,400 --> 00:21:52,800
.ذاكرتك سيّئة

287
00:21:52,800 --> 00:21:54,570
ألم أخبرك دائمًا؟

288
00:21:55,940 --> 00:21:59,980
".يجب أن تدعوني بـ"المحافظ

289
00:22:02,380 --> 00:22:04,620
."المحافظ ويتّون"

290
00:22:09,390 --> 00:22:17,460
آه، خلف السّماء الّتي لا نهاية لها

291
00:22:17,460 --> 00:22:28,080
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

292
00:22:35,950 --> 00:22:43,390
مرّت عليّ أيّام كدت أخسر فيها نفسي

293
00:22:43,390 --> 00:22:51,800
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

294
00:22:51,800 --> 00:23:00,010
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

295
00:23:00,010 --> 00:23:08,850
دفعوا بي للأمام، أليس كذلك؟

296
00:23:08,850 --> 00:23:17,160
آه، إنّ النّجوم تهوي من السّماء

297
00:23:17,160 --> 00:23:20,290
...وهذه اللّحظة الفريدة

298
00:23:25,630 --> 00:23:29,140
أيمكنك أن تصدّق أنّ ذلك العجوز
وأولئك الأطفال كانوا في نفس السّنّ؟

299
00:23:29,140 --> 00:23:30,570
ما الّذي تفعله يا لوفي؟

300
00:23:30,570 --> 00:23:32,510
،فكّرتُ أنّنا إن حرّكنا السّفينة
.يمكننا الخروج من هنا

301
00:23:32,510 --> 00:23:34,210
!أيجب أن نفعل ذلك بدون نامي؟

302
00:23:34,210 --> 00:23:35,910
.لا بدّ أنّها مستاءة لأنّها لم تأت معنا

303
00:23:35,910 --> 00:23:38,280
ربّما أصبحت عجوزًا الآن؟

304
00:23:39,280 --> 00:23:40,950
!لا تقل شيئًا مخيفًا هكذا

305
00:23:41,320 --> 00:23:42,580
:في الحلقة القادمة من ون بيس

306
00:23:42,580 --> 00:23:45,920
مشاعر الحنين! مقبرة القراصنة"
"!الّتي لا خروج منها

307
00:23:45,920 --> 00:23:48,160
!ملك القراصنة، لن يكون إلاّ أنا