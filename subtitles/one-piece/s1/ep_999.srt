1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,690 --> 00:02:01,860
!تزداد شدّة المعركة الكبيرة في أونيغاشيما

29
00:02:04,820 --> 00:02:10,070
وقف كينغ في طريق شينوبو
...الّتي تحاول إنقاذ مومونوسكي

30
00:02:15,000 --> 00:02:18,790
.لكنّ سانجي يظهر ببسالة لإيقاف ذلك

31
00:02:22,720 --> 00:02:24,380
!مومونوسكي-ساما

32
00:02:26,680 --> 00:02:28,260
!يا مومو

33
00:02:29,180 --> 00:02:31,410
...تعريفك بنفسك قبل قليل

34
00:02:31,410 --> 00:02:32,680
!أشعرني بالقشعريرة

35
00:02:33,600 --> 00:02:35,270
!سانغورو

36
00:02:35,270 --> 00:02:38,130
!لا، لا، لا، لا، لا، هذا مستحيل

37
00:02:38,130 --> 00:02:40,480
!نامي! ستقتلني

38
00:02:40,480 --> 00:02:42,190
!زوس

39
00:02:42,490 --> 00:02:48,050
أشيح نظري عنك للحظة وتعود لها؟

40
00:02:48,050 --> 00:02:49,740
!تصرّف سيّئ

41
00:02:49,740 --> 00:02:52,470
!آسف يا نامي

42
00:02:52,470 --> 00:02:55,210
!ارقدي بسلام

43
00:02:55,210 --> 00:02:57,400
!أنا أكرهك

44
00:02:57,400 --> 00:02:59,580
!انتهت علاقتنا بالكامل

45
00:03:02,550 --> 00:03:04,920
!النّجدة

46
00:03:09,390 --> 00:03:11,240
!أنا راكب حرّ

47
00:03:11,240 --> 00:03:14,640
!فرانكي

48
00:03:29,410 --> 00:03:31,400
!حسنًا، لقد قُطعت

49
00:03:33,280 --> 00:03:34,950
!ماذا؟

50
00:03:36,040 --> 00:03:36,990
ماذا؟

51
00:03:42,380 --> 00:03:46,210
!يا ويحي! أظنّني دهست شيئًا ما

52
00:03:49,600 --> 00:03:51,130
!ومن يهتمّ؟

53
00:03:51,810 --> 00:03:54,390
.ما دمت لم أدهس زهرة

54
00:03:57,690 --> 00:04:01,870
"!سأحميك! لقاء ياماتو بمومونوسكي"

55
00:04:06,490 --> 00:04:08,770
!ماما

56
00:04:09,030 --> 00:04:11,240
!إنّهم هالكون

57
00:04:11,370 --> 00:04:14,070
!إنّهم في عداد الموتى

58
00:04:16,240 --> 00:04:19,950
!لقد دهس بيغ مام بدرّاجته

59
00:04:24,340 --> 00:04:26,170
!يا أخي الكبير

60
00:04:29,010 --> 00:04:31,130
!شكرًا لك يا فرانكي

61
00:04:31,430 --> 00:04:32,800
!نامي

62
00:04:33,220 --> 00:04:34,510
!هل أنت بخير؟

63
00:04:34,510 --> 00:04:36,390
!نعم! نعم! أنا بخير

64
00:04:36,770 --> 00:04:39,810
!إن كان أخي الكبير هنا، فسيساعدنا ذلك كثيرًا

65
00:04:40,730 --> 00:04:42,890
!هيّا! يا محاربي السّاموراي

66
00:05:00,380 --> 00:05:02,490
!بدأت الغارة سلفًا

67
00:05:02,960 --> 00:05:05,040
...إنّه قتال ضخم وفوضويّ

68
00:05:05,260 --> 00:05:09,010
.علينا أن نبذل جهدًا أكثر من البقيّة بما أنّنا متأخّرون

69
00:05:09,010 --> 00:05:13,320
.يا إلهي... انظري ما الّذي صادفوه

70
00:05:13,320 --> 00:05:15,980
.ساعديني قليلاً يا نيكو روبين

71
00:05:15,980 --> 00:05:18,140
.أكيد، يسرّني ذلك

72
00:05:19,770 --> 00:05:23,390
!ممتاز! هذا ما توقّعته من فرانكي وبروك

73
00:05:23,390 --> 00:05:25,730
...سأذهب إذًا

74
00:05:26,190 --> 00:05:28,310
...لمساعدة كينييمون

75
00:05:28,490 --> 00:05:30,150
!الآن

76
00:05:49,170 --> 00:05:53,420
!سُحقًا! العمالقة الثّملون

77
00:05:53,970 --> 00:05:57,170
!كيف تجرّأتم على معاملة براكيو كلعبة؟

78
00:06:26,290 --> 00:06:29,290
!تماسك! لنعد للقتال

79
00:06:49,690 --> 00:06:51,690
!لا بأس! لا داعي للقلق

80
00:06:52,030 --> 00:06:54,610
!ضع ثقتك في براكيو

81
00:06:58,240 --> 00:07:02,240
،لقد تعرّضت للكثير من الهجمات
.لكنّ جسدها الخارق لم يتكبّد ولو خدشًا واحدًا

82
00:07:02,240 --> 00:07:05,370
!جسد خارق

83
00:07:05,370 --> 00:07:09,290
!خليط وابوميتال المعدنيّ الخارق صلب بالفعل

84
00:07:10,300 --> 00:07:12,090
!لنبدأ بردّ القتال

85
00:07:12,090 --> 00:07:13,420
!تغيير في المسار

86
00:07:17,890 --> 00:07:20,720
!بسرعة

87
00:07:28,360 --> 00:07:30,040
!الأهداف خلفنا

88
00:07:30,040 --> 00:07:32,650
!استديروا وواجهوهم

89
00:07:32,650 --> 00:07:35,860
!حاضر! أيّها القائد تشوبّر

90
00:07:41,040 --> 00:07:43,240
!استعدّ للإطلاق

91
00:07:48,370 --> 00:07:57,340
!نار

92
00:08:06,060 --> 00:08:08,040
!مرحى

93
00:08:08,040 --> 00:08:09,820
!أصابت كلّ الطّلقات أهدافها

94
00:08:09,820 --> 00:08:14,100
!رأيتم الآن مدى قوّتنا أنا وأوسوبّ وبراكيو

95
00:08:15,150 --> 00:08:19,440
!أبليتَ حسنًا أيّها المدفعيّ أوسوبّ

96
00:08:20,450 --> 00:08:24,490
!وكانت أوامرك ممتازة أيّها القائد تشوبّر

97
00:08:26,290 --> 00:08:29,410
!هذا ما نحن قادرون عليه

98
00:08:31,050 --> 00:08:35,170
!سواء كانت بيغ مام أو العمالقة أو أيًّا كان، فنحن لها

99
00:08:41,390 --> 00:08:42,760
...قنابل شديدة الانفجار

100
00:08:44,180 --> 00:08:45,760
...مضادّة للدّبّابات

101
00:08:46,060 --> 00:08:47,760
...لم تُجد

102
00:08:48,720 --> 00:08:51,470
!نفعًا

103
00:09:00,620 --> 00:09:03,910
...الـ-الدّبّابة منيعة

104
00:09:04,200 --> 00:09:09,160
لكنّنا لا نستطيع التّحمّل إن قمت
...بهزّها بشدّة هكذا

105
00:09:11,710 --> 00:09:16,290
!توقّف رجاءً

106
00:09:26,520 --> 00:09:30,140
!يا-ياماتو، توقّف

107
00:09:34,940 --> 00:09:36,480
!سُحقًا لك

108
00:09:36,690 --> 00:09:38,730
!ياماتو

109
00:09:39,360 --> 00:09:42,930
،سأوسعك ضربًا حتّى تصبح على شفير الموت

110
00:09:42,930 --> 00:09:47,400
!ثمّ سآخذك إلى كايدو-ساما

111
00:09:49,710 --> 00:09:52,160
!لا وقت لديّ لك

112
00:09:53,170 --> 00:09:56,210
!ولن أعود لكايدو أبدًا

113
00:09:58,130 --> 00:10:01,790
!لديّ مهمّتي الخاصّة

114
00:10:02,050 --> 00:10:03,170
!دعيني وشأني

115
00:10:03,170 --> 00:10:04,470
!كم هذا مزعج

116
00:10:05,050 --> 00:10:06,420
!سأوسعك ضربًا

117
00:10:13,360 --> 00:10:15,810
...كفّ عن تفاديّ أيّها الـ

118
00:10:20,490 --> 00:10:21,780
!أولتي

119
00:10:21,780 --> 00:10:23,900
!سأشقّ طريقي بالقوّة

120
00:10:40,220 --> 00:10:42,580
.لذلك اعذروني جميعًا

121
00:10:45,010 --> 00:10:46,460
.انتظرني

122
00:10:46,850 --> 00:10:48,640
!أنا قادم

123
00:11:08,240 --> 00:11:10,010
...سامحني رجاءً

124
00:11:10,010 --> 00:11:14,350
!لن أتركك أبدًا

125
00:11:14,350 --> 00:11:19,080
!سأحميك، أنا شينوبو، وإن كلّفني ذلك حياتي

126
00:11:19,800 --> 00:11:21,710
...أعتمد عليك

127
00:11:30,310 --> 00:11:34,890
.سيرونك هنا. لنختبئ في ذلك المبنى

128
00:11:38,570 --> 00:11:40,020
!ها أنتما

129
00:11:41,780 --> 00:11:43,400
!سرّني أنّك بخير

130
00:11:43,400 --> 00:11:45,730
!كوزكي مومونوسكي

131
00:11:48,120 --> 00:11:49,320
!من تكونين؟

132
00:11:56,670 --> 00:11:58,620
!يا شينوبو

133
00:11:59,920 --> 00:12:03,460
!إنّه حليف لنا. بإمكانك أن تثقي به

134
00:12:03,460 --> 00:12:05,790
!ماذا؟ حليف لنا؟

135
00:12:08,640 --> 00:12:11,760
.البقاء معه أكثر أمانًا من البقاء وحدكما

136
00:12:14,180 --> 00:12:15,430
!إلى اللّقاء

137
00:12:18,900 --> 00:12:20,940
هل أنت حليف لنا بالفعل؟

138
00:12:20,940 --> 00:12:22,060
!نعم

139
00:12:26,110 --> 00:12:28,690
.حسنًا. أنا أصدّقك

140
00:12:28,690 --> 00:12:30,980
ما اسمك؟

141
00:12:32,410 --> 00:12:33,280
!ماذا؟

142
00:12:34,450 --> 00:12:35,610
...أنا

143
00:12:40,880 --> 00:12:43,410
!أنا كوزكي أودن

144
00:12:46,050 --> 00:12:48,210
!سوف أحميك

145
00:12:51,010 --> 00:12:52,670
...والدي

146
00:12:53,810 --> 00:12:55,550
...أودن-ساما

147
00:13:02,020 --> 00:13:04,390
والدي؟

148
00:13:05,070 --> 00:13:06,230
...أثداء

149
00:13:06,530 --> 00:13:08,110
!قرون؟

150
00:13:08,110 --> 00:13:10,910
!لا يعقل أن تكون والدي

151
00:13:10,910 --> 00:13:14,370
!أنت مثير كثيرًا للشّبهات! أكيد أنّك عدوّنا

152
00:13:14,370 --> 00:13:15,570
!ماذا؟

153
00:13:17,660 --> 00:13:19,450
!تقنية الهروب في الدّخان

154
00:13:19,450 --> 00:13:20,620
!مهلاً

155
00:13:21,120 --> 00:13:23,290
!لماذا تهرب؟

156
00:13:35,720 --> 00:13:39,270
.إنّهم يفوقوننا عددًا
.سيستغرق هذا الكثير من الوقت

157
00:13:39,270 --> 00:13:40,910
!معك حقّ

158
00:13:40,910 --> 00:13:45,020
إنّ قتال كلّ هؤلاء الأتباع الضّعفاء
!مضيعة للوقت فحسب

159
00:13:45,020 --> 00:13:49,550
الدّيناصورات الملقّبون بالتّوبي روبّو
...الّذين تحدّث عنهم دنجيرو

160
00:13:49,550 --> 00:13:52,070
هل علينا الذّهاب للإطاحة بهم؟

161
00:13:52,070 --> 00:13:54,690
...حتّى إن لم نكن ندًّا لهم

162
00:13:55,950 --> 00:13:59,490
!ما زال بإمكاننا تعطيلهم

163
00:14:06,380 --> 00:14:07,750
...والآن

164
00:14:07,750 --> 00:14:13,670
.لا أظنّ أنّها ستواصل النّوم كالأطفال للأبد

165
00:14:50,840 --> 00:14:55,840
...يا إلهي... لم أتوقّع حدوث ذلك

166
00:14:56,140 --> 00:14:58,420
!توشك بيغ مام عن الخروج عن السّيطرة

167
00:14:58,420 --> 00:15:00,550
!اهربوا

168
00:15:11,700 --> 00:15:13,520
...أخيرًا

169
00:15:14,950 --> 00:15:16,690
.ها قد استيقظت

170
00:15:21,040 --> 00:15:24,910
...إنّكم تظهرون الواحد تلو الآخر

171
00:15:26,250 --> 00:15:29,160
!يا طاقم قبّعة القشّ

172
00:15:52,690 --> 00:15:56,270
.يا ملك السّول! لم أرك منذ مدّة

173
00:15:56,910 --> 00:16:02,240
.إنّ طاقمك يضمّ فعلاً أندر المخلوقات

174
00:16:03,000 --> 00:16:06,990
.لا أطيق الانتظار حتّى أضيفك إلى مجموعتي

175
00:16:08,710 --> 00:16:10,660
!لديك ذوق رفيع

176
00:16:11,250 --> 00:16:15,210
!أتحبّين جسدي الحديديّ أيّتها الشّمطاء؟

177
00:16:16,130 --> 00:16:18,210
...اسمي هو

178
00:16:22,180 --> 00:16:24,180
!فرانكي

179
00:16:24,890 --> 00:16:27,100
!أنا سايبورغ

180
00:16:30,360 --> 00:16:32,850
!أنا نادر وقويّ جدًّا

181
00:16:33,030 --> 00:16:35,020
!كلاّ، كلاكما

182
00:16:35,320 --> 00:16:37,940
!لنهرب! إنّها أحد اليونكو

183
00:16:38,620 --> 00:16:40,150
يونكو؟

184
00:16:41,410 --> 00:16:43,450
سنهرب إذًا؟

185
00:16:45,210 --> 00:16:48,700
...يا نامي. ألا تريدين أن يصير

186
00:16:49,420 --> 00:16:51,200
...قبطاننا

187
00:16:53,760 --> 00:16:59,090
!ملك القراصنة؟

188
00:17:07,640 --> 00:17:10,220
...شعاع

189
00:17:11,360 --> 00:17:13,980
...فرانكي

190
00:17:13,980 --> 00:17:16,390
...الجذ

191
00:17:17,990 --> 00:17:21,860
!ما... ما هذه الأشياء العملاقة؟

192
00:17:26,080 --> 00:17:30,620
!يا هؤلاء! لقد وضعتم في قاعة وليمة أخرى

193
00:17:32,000 --> 00:17:33,830
!أيّها الأرقام

194
00:17:40,050 --> 00:17:41,920
!كلاّ

195
00:17:41,920 --> 00:17:45,550
!إنّهم بضخامة أورز! ما قصّتهم؟

196
00:17:47,310 --> 00:17:49,930
...إنّهم يذكّرونني بثريلر بارك

197
00:17:53,520 --> 00:17:59,340
هل هم تجارب إعادة إنشاء العمالقة
...القدامى الفاشلة

198
00:17:59,340 --> 00:18:02,690
!الّتي حصل عليها كايدو من بانك هازارد؟

199
00:18:08,790 --> 00:18:10,910
...ممتاز

200
00:18:14,460 --> 00:18:16,210
!ها قد بدأنا

201
00:18:16,210 --> 00:18:17,120
!شكرًا

202
00:18:21,050 --> 00:18:22,920
!يُتوقّع سقوط أمطار

203
00:18:25,840 --> 00:18:27,930
!أنا أدوّرها

204
00:18:27,930 --> 00:18:30,140
!إطلاق

205
00:18:30,850 --> 00:18:32,640
.لا أستطيع الحراك

206
00:18:36,690 --> 00:18:37,810
.توخ الحذر

207
00:18:39,110 --> 00:18:40,940
!المستوى الثّالث

208
00:18:42,200 --> 00:18:43,690
!بالون العظام

209
00:18:44,070 --> 00:18:45,360
...أسلوب السّيوف الثّلاثة

210
00:18:45,360 --> 00:18:46,610
!الفنون السّرّيّة

211
00:18:49,700 --> 00:18:51,830
!العوالم الثّلاثة آلاف

212
00:18:51,830 --> 00:18:54,030
...فاكهة المطّاط

213
00:18:54,460 --> 00:18:55,580
...البازوكا

214
00:18:57,380 --> 00:19:00,000
!العملاقة

215
00:19:00,510 --> 00:19:06,050
...تطلّب الأمر قوّتنا جميعًا لهزيمة أورز وحده

216
00:19:06,720 --> 00:19:08,340
!انظروا هناك

217
00:19:10,430 --> 00:19:13,090
...ما يوجد في يد ذلك الوحش

218
00:19:13,600 --> 00:19:15,500
!هو دبّابة براكيو

219
00:19:15,500 --> 00:19:17,390
!إنّه فريق أوسوبّ

220
00:19:20,190 --> 00:19:23,170
!اتركها

221
00:19:23,170 --> 00:19:26,190
!أيّها الخلد الضّخم

222
00:19:28,240 --> 00:19:30,240
...شعاع

223
00:19:32,660 --> 00:19:34,950
...فرانكي

224
00:19:36,910 --> 00:19:39,250
!الجذريّ

225
00:19:54,140 --> 00:19:57,040
...لا يوجد ما يوقف

226
00:19:57,040 --> 00:19:59,060
!شعاع اللّيزر خاصّتي الآن

227
00:20:01,690 --> 00:20:04,900
ألم تكن تريد أن تطلقه في هذه الجهة؟

228
00:20:05,900 --> 00:20:08,360
...أيّها الرّجل الحديديّ

229
00:20:17,870 --> 00:20:19,580
!أعرني ذراعك

230
00:20:20,420 --> 00:20:22,750
!جوجتسو البرمائيّين

231
00:20:23,090 --> 00:20:24,580
!ألف زهرة

232
00:20:29,970 --> 00:20:35,510
!رمية كتف الدّوّامة

233
00:20:39,850 --> 00:20:41,470
!زهرة العائق

234
00:20:44,020 --> 00:20:46,820
!اللّعنة عليك يا جينبي

235
00:20:46,820 --> 00:20:49,510
!أتذكر ما فعلته لأسطولنا

236
00:20:49,510 --> 00:20:53,070
!سأقتلك أيضًا

237
00:20:56,620 --> 00:20:58,990
!أرني ما لديك

238
00:21:05,470 --> 00:21:06,960
كيف سار الأمر؟

239
00:21:10,220 --> 00:21:12,280
!أفضل من المتوقّع

240
00:21:12,280 --> 00:21:14,670
!ستعود أكثر غضبًا

241
00:21:16,770 --> 00:21:20,050
.إنّك امرأة مذهلة بالفعل

242
00:21:21,890 --> 00:21:25,340
!آسف! شكرًا

243
00:21:25,340 --> 00:21:27,150
!جينبي! روبين

244
00:21:27,150 --> 00:21:30,520
!نعم. أنا سعيد لأنّك بخير

245
00:21:31,160 --> 00:21:33,030
...والآن

246
00:21:37,290 --> 00:21:39,950
...إنّها اللّحظة الّتي كنّا بانتظارها

247
00:21:40,250 --> 00:21:48,230
...رنين، رنين، رنين... رنين، رنين، رنين

248
00:21:48,230 --> 00:21:49,300
.فتح

249
00:21:49,300 --> 00:21:52,550
!أجب أيّها القائد تشوبّر

250
00:21:54,760 --> 00:21:58,260
!أوسوبّ! استيقظ! أوسوبّ

251
00:21:58,690 --> 00:22:00,470
!لدينا اتّصال من فرانكي

252
00:22:00,650 --> 00:22:03,560
!اسمعا! هل أنتما بخير؟

253
00:22:05,280 --> 00:22:09,850
...دبّابة براكيو الأفضل في العالم

254
00:22:10,690 --> 00:22:13,070
!هل تذكران الوعد؟

255
00:22:14,530 --> 00:22:16,690
الوعد؟

256
00:22:16,910 --> 00:22:21,280
!قرصان مصنوع من الحديد، القرصان الحديديّ

257
00:22:21,790 --> 00:22:23,830
!لنقم بالدّمج

258
00:22:24,000 --> 00:22:24,990
...أقال

259
00:22:25,300 --> 00:22:27,210
الدّمج؟

260
00:22:32,630 --> 00:22:36,340
!الدّمج

261
00:22:51,400 --> 00:22:54,730
!انتظرني يا كينييمون

262
00:23:04,330 --> 00:23:10,000
يسعى لوفي إلى الانتقام ويتّجه إلى ساحة المعركة
!حيث ينتظر كايدو بين الشّرارات الطّائرة

263
00:23:10,170 --> 00:23:15,300
يقوم طاقم قبّعة القشّ بالإطاحة بالكثير
!من الأعداء الأقوياء ويحوّلون المحنة إلى نجاح

264
00:23:15,300 --> 00:23:17,130
،متغلّبين على موجة الحرب العاتية

265
00:23:17,130 --> 00:23:22,050
سيشقّ قراصنة الجيل الجديد الطّريق
!نحو مستقبل بلاد وانو

266
00:23:22,430 --> 00:23:27,640
:في الحلقة القادمة من وان بيس
"!قوّة ساحقة! اجتماع طاقم قبّعة القشّ"

267
00:23:27,640 --> 00:23:31,640
!ملك القراصنة، لن يكون إلاّ أنا