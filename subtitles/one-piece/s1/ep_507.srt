1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,730 --> 00:03:36,350
،بعد حرب القمّة ضدّ البحريّة

38
00:03:36,350 --> 00:03:38,560
...وصل لوفي إلى جزيرة النّساء

39
00:03:38,560 --> 00:03:41,610
.لكنّه أصيب بالاكتئاب من مشاعر ضعفه

40
00:03:42,060 --> 00:03:45,660
!ما الّذي ما زلت تملكه؟

41
00:03:52,510 --> 00:03:57,030
!لقاء مع ملك الظّلام ريلي"
"!وقت اتّخاذ القرار بالنّسبة للوفي

42
00:04:13,830 --> 00:04:16,350
.توقّف عن الصّراخ

43
00:04:16,350 --> 00:04:21,300
.على ذكر الأمر، أتساءل أين هو قبّعة القشّ

44
00:04:21,300 --> 00:04:23,750
سيموت إن فُتحَ جرحه، صحيح؟

45
00:04:29,420 --> 00:04:30,790
!اصطدتُ واحدة

46
00:04:37,860 --> 00:04:39,330
ما الخطب؟

47
00:04:39,930 --> 00:04:41,380
...أظنّني رأيت سمكةً للتّوّ

48
00:04:42,760 --> 00:04:44,630
!إ-إنّها كبيرة

49
00:04:54,890 --> 00:04:57,930
!انظروا! إنّه ملك بحر ضخم

50
00:04:57,930 --> 00:04:59,650
هل يقاتل؟

51
00:05:08,860 --> 00:05:11,330
!إنّه ميّت! لقد قُتل

52
00:05:12,330 --> 00:05:13,650
!لكنّه ضخم

53
00:05:13,650 --> 00:05:15,640
!لم أستطع رؤية ما قتله

54
00:05:15,640 --> 00:05:17,170
.المكان مخيف هنا

55
00:05:21,920 --> 00:05:23,130
رجل؟

56
00:05:23,130 --> 00:05:25,260
!أنت! من أنت؟

57
00:05:28,060 --> 00:05:29,930
...يا إلهي

58
00:05:30,360 --> 00:05:31,630
...مـ

59
00:05:33,090 --> 00:05:33,640
...حسنًا

60
00:05:33,640 --> 00:05:34,480
...مـ

61
00:05:34,480 --> 00:05:36,600
!ملك الظّلام ريلي

62
00:05:36,600 --> 00:05:38,060
!ماذا؟

63
00:05:38,060 --> 00:05:41,770
.هذا أنتم. تقابلنا في أرخبيل شابوندي

64
00:05:46,780 --> 00:05:50,200
!كان نائب القبطان ملك القراصنة روجر

65
00:05:50,200 --> 00:05:56,250
في الواقع، غرقت سفينتي في العاصفة
.ولم يكن لديّ خيار سوى أن أسبح

66
00:05:56,250 --> 00:06:01,320
!عاصفة؟! الحزام الهادئ هادئ دائمًا، لا يهيج أبدًا

67
00:06:01,320 --> 00:06:02,780
!لا ينبغي أن تحدث عاصفة

68
00:06:02,780 --> 00:06:07,510
ما يعني أنّ سفينته تحطّمت في مكان
!بعيد وسبح كلّ المسافة إلى هنا؟

69
00:06:08,680 --> 00:06:10,590
.أنا أجيد سباحة الصّدر جيّدًا

70
00:06:10,590 --> 00:06:12,830
.هذا ليس بيت القصيد

71
00:06:12,830 --> 00:06:15,350
...إذًا، كان ملك البحر ذاك

72
00:06:15,350 --> 00:06:17,180
!يقاتلك؟

73
00:06:17,180 --> 00:06:20,690
!فقط قرصان أسطوريّ يستطيع فعل ذلك

74
00:06:22,610 --> 00:06:23,820
.آسف

75
00:06:23,820 --> 00:06:26,320
!لِمَ الأسف؟

76
00:06:26,780 --> 00:06:28,240
!صحيح

77
00:06:30,320 --> 00:06:33,620
.أفترض أنّ لوفي-كن في هذه الجزيرة

78
00:06:38,580 --> 00:06:40,400
...هل سمعتنّ

79
00:06:40,400 --> 00:06:42,040
...أنّ أميرة الثّعابين-ساما والبقيّة

80
00:06:42,040 --> 00:06:44,460
ذهبن للتّوّ لتوصيل الطّعام للوفي؟

81
00:06:44,880 --> 00:06:47,510
!أريد تمديد جسده ثانيةً

82
00:06:47,510 --> 00:06:51,260
.قلن أنّه سيدعينه بعد أن تتحسّن حالته

83
00:06:51,260 --> 00:06:53,260
!لا أطيق الانتظار

84
00:06:53,260 --> 00:06:56,260
!لم أتوقّع رؤيته ثانيةً مبكّرًا هكذا

85
00:06:56,770 --> 00:06:59,770
!الرّجال مثيرون للاهتمام

86
00:06:59,770 --> 00:07:04,480
،إن كان بإمكاني أن أصبح رجلاً
!لكان جسدي يتمدّد كجسده

87
00:07:04,980 --> 00:07:06,730
!"هذا فصل "لا أطيق الانتظار

88
00:07:08,070 --> 00:07:11,570
...أجل، ربّما سأعدّ له ثيابًا ثانيةً

89
00:07:11,570 --> 00:07:13,280
!بلا زخرفة

90
00:07:17,830 --> 00:07:21,580
!نحن منعزلان مع أنّنا عروسان

91
00:07:21,580 --> 00:07:24,290
!أشعر كبطلة مأساة

92
00:07:24,290 --> 00:07:28,670
"!لكن يا هانكوك... لا، زوجتي العزيزة"

93
00:07:28,670 --> 00:07:30,050
"!نـ-نعم"

94
00:07:30,050 --> 00:07:34,050
"!مهما كنّا بعيدين عن بعضنا، حبّنا أبديّ"

95
00:07:34,480 --> 00:07:36,430
"!لوفي"

96
00:07:36,840 --> 00:07:42,850
!يا زوجي الحنون! قلبي مشتعل

97
00:07:42,850 --> 00:07:45,480
،ما قلت من قبل يا أميرة الثّعابين

98
00:07:45,480 --> 00:07:49,490
،فقط لأنّ أحدًا يعانقك أو يناديك باسمك

99
00:07:49,490 --> 00:07:51,360
.لا يعني أنّكما متزوّجان

100
00:07:51,360 --> 00:07:54,160
إذًا، ما الّذي يعدّ كزواج؟

101
00:07:54,160 --> 00:07:57,330
.لنرَ... ذلك سؤال صعب

102
00:08:00,360 --> 00:08:03,580
.لا يمكنك الذّهاب لشابوندي الآن بذلك الجرح

103
00:08:03,970 --> 00:08:07,560
.لكنّي أريد رؤية أصدقائي في أسرع وقت

104
00:08:07,560 --> 00:08:11,150
.يجب أن أذهب إلى هناك كما وعدت

105
00:08:11,150 --> 00:08:12,800
...لكن

106
00:08:13,360 --> 00:08:18,680
.ماذا؟ ذهبت الغوّاصة

107
00:08:18,980 --> 00:08:20,680
!لوفي-كن

108
00:08:20,680 --> 00:08:23,270
!ماذا؟! العمّ ريلي

109
00:08:24,210 --> 00:08:25,900
!مسرور لرؤيتك في هذا الوقت القريب

110
00:08:26,390 --> 00:08:28,270
!لِمَ أنت هنا؟

111
00:08:28,270 --> 00:08:32,860
.كنت على وشك الذّهاب إلى شابوندي باستخدام الفيفر كارد

112
00:08:34,530 --> 00:08:35,780
هل رأيت أصدقائي؟

113
00:08:35,780 --> 00:08:39,160
.لا، لا أظنّ أنّهم وصلوا إلى هناك بعد

114
00:08:39,740 --> 00:08:43,710
...أعطيت الفيفر كارد خاصّتي لشاكي

115
00:08:43,710 --> 00:08:48,880
.لكي أذهب حيثما شئت

116
00:08:48,880 --> 00:08:54,090
!ملك الظّلام ريلي! أهذا أنت حقًّا؟ لا أصدّق

117
00:08:54,420 --> 00:08:57,090
...لا بدّ أنّك الشّيتشيبوكاي السّابق

118
00:08:57,090 --> 00:08:59,560
.إنّه جينبي، لقد أنقذ حياتي

119
00:09:01,100 --> 00:09:02,560
ما الخطب؟

120
00:09:02,560 --> 00:09:06,900
.في الواقع، لم أتوقّع رؤية أسطورة حيّة هنا

121
00:09:06,900 --> 00:09:09,690
خذ. أليست هذه القبّعة مهمّة لك؟

122
00:09:09,690 --> 00:09:11,150
.أجل. شكرًا

123
00:09:15,610 --> 00:09:20,160
!لا أشعر بالارتياح من دونها في النّهاية

124
00:09:23,250 --> 00:09:26,250
هل رأيت مجموعة قراصنة هنا؟

125
00:09:26,250 --> 00:09:29,590
.إن كنت تقصد ترافالغار لو فقد غادر لتوّه

126
00:09:30,450 --> 00:09:34,170
.قال أنّ عليك الاستراحة في الفراش لأسبوعين آخرين

127
00:09:37,090 --> 00:09:38,890
لقد أنقذ حياتك، أليس كذلك؟

128
00:09:44,720 --> 00:09:48,190
...يا للخسارة! وصلنا لذلك الحدّ

129
00:09:48,190 --> 00:09:51,560
.أردت دخول الإمبراطوريّة المحرّمة على الرّجال

130
00:09:51,560 --> 00:09:53,360
.كنّ يسمحن بدخول الدّببة

131
00:09:53,360 --> 00:09:54,650
!اخرس

132
00:09:55,090 --> 00:09:56,320
.آسف

133
00:09:56,320 --> 00:09:57,740
!ضعيف جدًّا

134
00:09:58,030 --> 00:10:00,790
.أتساءل ما الّذي ينوي ملك الظّلام فعله

135
00:10:00,790 --> 00:10:03,730
...مهما كان، أنا واثق أنّ "د" سيجلبون عاصفة مجدّدًا

136
00:10:04,930 --> 00:10:07,460
.لا أطيق الانتظار لرؤيته ثانيةً

137
00:10:08,280 --> 00:10:12,590
!ريلي؟! لا بدّ أنّك ريلي

138
00:10:12,590 --> 00:10:16,550
!غلوريوسا! مضى وقت طويل

139
00:10:16,550 --> 00:10:17,930
!ريلي

140
00:10:17,930 --> 00:10:19,090
!ري-سان

141
00:10:19,090 --> 00:10:21,050
!أنتما هنا أيضًا

142
00:10:21,410 --> 00:10:22,890
!لوفي

143
00:10:22,890 --> 00:10:27,100
يا أختي! كيف تتجاهلين الرّجل الّذي أنقذ حياتك؟

144
00:10:27,520 --> 00:10:30,850
تعرفن العمّ ريلي؟

145
00:10:30,850 --> 00:10:32,230
!أجل

146
00:10:32,230 --> 00:10:34,650
.إنّها قصّة طويلة

147
00:10:34,650 --> 00:10:37,110
.لوفي، أفقت إذًا الآن

148
00:10:37,110 --> 00:10:39,360
.لم أذق طعم النّوم لأيّام من قلقي عليك

149
00:10:39,360 --> 00:10:42,410
.لا بدّ أنّك جائع. أحضرت بعض الطّعام

150
00:10:42,410 --> 00:10:44,410
...لذا بادر وكل

151
00:10:44,410 --> 00:10:46,550
.لا تستطيعين حتّى النّظر إليه

152
00:10:46,550 --> 00:10:49,290
فكيف تسمّينه زواجًا؟

153
00:10:49,290 --> 00:10:50,550
...اخدمه

154
00:10:51,680 --> 00:10:53,880
!قدّم له وجبةً بسرعة

155
00:10:57,110 --> 00:11:00,970
!جينبي! هذه ليست لك

156
00:11:01,550 --> 00:11:03,140
.يمكنك أكل القليل

157
00:11:03,140 --> 00:11:07,350
حـ-حسنًا. لوفي-كن، ما رأيك أن نأكل؟

158
00:11:09,350 --> 00:11:14,980
!لوفي-كن، عليك أن تأكل. الأكل هو الحياة

159
00:11:30,380 --> 00:11:33,380
!هكذا! أحسنت يا عزيزي لوفي-كن

160
00:11:46,890 --> 00:11:52,390
!"جينبي! قلت "كل القليل فحسب

161
00:11:57,040 --> 00:11:59,940
.شكرًا لإحضارك الرّسالة من شاكي

162
00:12:01,490 --> 00:12:04,450
.يبدو أنّها لم تتغيّر

163
00:12:04,450 --> 00:12:08,830
.أجل، إنّها على نفس حالها مذ كنت في شابوندي

164
00:12:08,830 --> 00:12:10,830
.إنّها بخير

165
00:12:10,830 --> 00:12:17,630
أصبحن هؤلاء الفتيات جميلات جدًّا
.وقويّات في غضون السّنوات الـ13 الماضية

166
00:12:17,630 --> 00:12:20,920
.ريلي، شاكي، الجدّة نيون

167
00:12:20,920 --> 00:12:26,140
.حميتمونا أنتم الثّلاثة عندما كنّا نهرب من التّنّانين السّماويّين

168
00:12:26,520 --> 00:12:28,720
.لكن لدينا مشكلة

169
00:12:28,720 --> 00:12:33,560
.علينا أن نوفّر الملجأ للوفي من البحريّة

170
00:12:33,560 --> 00:12:37,150
،مع أنّ ريلي يعرف لوفي من قبل

171
00:12:37,150 --> 00:12:41,310
،إن كان يسهل توقّع أنّ لوفي هنا

172
00:12:41,310 --> 00:12:43,150
.فيجدر أن نقلق

173
00:12:43,150 --> 00:12:45,960
!ماذا؟! يا له من وجه مألوف

174
00:12:45,960 --> 00:12:48,620
أنت ريلي، أليس كذلك؟

175
00:12:48,620 --> 00:12:51,290
!هل لاحظت الآن فقط؟! ما مدى فتنك به؟

176
00:12:52,960 --> 00:12:56,790
.كلاّ، لا أظنّ أنّ البحريّة يمكنها أن تتوقّع أنّه هنا

177
00:12:57,580 --> 00:13:01,200
أساسًا، الرّجل الّذي قذفه بعيدًا

178
00:13:01,200 --> 00:13:04,720
.أخبرني أنّه أرسله في هذا الاتّجاه

179
00:13:07,300 --> 00:13:08,220
...كوما

180
00:13:09,620 --> 00:13:12,300
.أعمل لصالح الجيش الثّوريّ

181
00:13:12,300 --> 00:13:14,310
.بما أنّ لديّ صلة بهم

182
00:13:14,310 --> 00:13:16,390
.أريد أن أدعهم يهربون من هنا

183
00:13:16,850 --> 00:13:19,400
.لا أصدّق ذلك

184
00:13:20,330 --> 00:13:23,070
وأين هو مونكي-تشان الآن؟

185
00:13:24,110 --> 00:13:25,780
.لا أدري

186
00:13:28,950 --> 00:13:31,700
.أعتذر عن أسلوبي الجافي سابقًا

187
00:13:32,450 --> 00:13:34,960
أيمكنني أن أحدّثك للحظة؟

188
00:13:35,580 --> 00:13:37,300
...لا أملك

189
00:13:38,380 --> 00:13:40,000
.الكثير من الوقت

190
00:13:41,340 --> 00:13:42,920
...ينبغي بقبّعة القشّ

191
00:13:44,300 --> 00:13:48,680
،يوجد في الاتّجاه الّذي أرسل بارثولوميو كوما لوفي-كن إليه

192
00:13:48,680 --> 00:13:51,970
.جزيرة النّساء

193
00:13:52,440 --> 00:13:54,230
.هذا ليس كلّ شيء

194
00:13:54,230 --> 00:13:58,310
.اكتشفت بعض المعلومات المثيرة للاهتمام بشأن حرب القمّة

195
00:13:58,310 --> 00:14:03,190
وهي تخصّ عمليّة الهرب من سجن
.إمبل داون من قبل لوفي-كن والبقيّة

196
00:14:03,190 --> 00:14:08,530
عندما فكّرت في كيف استطاع لوفي-كن
،التّسلّل إلى السّجن العظيم

197
00:14:09,060 --> 00:14:10,450
اتّضح لي أنّ لوفي-كن

198
00:14:10,450 --> 00:14:15,290
...تسلّل إلى سفينة بحريّة على الأغلب رفقة هانكوك، لكن

199
00:14:19,230 --> 00:14:22,840
،بما أنّ هانكوك تكره كلاًّ من الحكومة والرّجال

200
00:14:22,840 --> 00:14:25,400
،لا أظنّ أنّها ستركب سفينة حكومة

201
00:14:25,400 --> 00:14:27,760
.لا سيّما لمساعدة رجل

202
00:14:28,900 --> 00:14:31,140
.والآن، هذا الجزء نظريّ بالكامل

203
00:14:31,960 --> 00:14:33,810
لكن ماذا عن هذا؟

204
00:14:35,560 --> 00:14:40,310
،لنفترض أنّ هانكوك وقعت في حبّ مونكي-تشان

205
00:14:40,310 --> 00:14:42,110
.حينها سيكون كلّ شيء منطقيًّا

206
00:14:44,230 --> 00:14:47,070
.مونكي-تشان شخص وسيم

207
00:14:48,400 --> 00:14:51,530
،وإن كنتُ هانكوك

208
00:14:51,530 --> 00:14:55,990
.كنتُ لأمنحه الملجأ في جزيرة النّساء لأخدع البحريّة

209
00:14:57,330 --> 00:15:00,170
.هذه نظريّة ذاتيّة جدًّا يا شاكي

210
00:15:03,250 --> 00:15:06,710
.حدس النّساء مذهل

211
00:15:06,710 --> 00:15:08,550
!هذه شاكي الّتي أعرفها

212
00:15:08,550 --> 00:15:11,930
.لقد أصابت كبد الحقيقة كما ترى

213
00:15:11,930 --> 00:15:15,060
!حقًّا؟ هل أعجبك؟ جيّد

214
00:15:16,120 --> 00:15:19,980
.لن تتحرّك البحريّة بناء على نظريّة سخيفة كهذه

215
00:15:20,750 --> 00:15:22,690
.لذا هذا المكان آمن

216
00:15:23,320 --> 00:15:25,770
.والآن، لندخل صلب الموضوع

217
00:15:27,310 --> 00:15:28,800
.لوفي-كن

218
00:15:29,760 --> 00:15:34,760
قلت أنّك ذاهب لشابوندي، أليس كذلك؟

219
00:15:37,700 --> 00:15:39,540
.أنا بحاجة لرؤية أصدقائي

220
00:15:41,710 --> 00:15:45,040
أهذا ما تريد حقًّا؟

221
00:16:03,360 --> 00:16:05,190
.أرخبيل شابوندي

222
00:16:06,680 --> 00:16:09,610
أتذكر ما حدث لكم في تلك الجزيرة؟

223
00:16:17,780 --> 00:16:21,400
!ركّزوا على الهرب جميعًا

224
00:16:22,440 --> 00:16:28,040
!لا يمكننا هزيمة هؤلاء الأشخاص في مستوانا الحاليّ

225
00:16:45,950 --> 00:16:50,900
!...لم أستطع أن أنقذ أيّ أحد من أصدقائي

226
00:17:12,720 --> 00:17:17,920
هل تظنّ أنّك تستطيع مواجهة تلك
القوى الجبّارة في مستواك الحاليّ؟

227
00:17:34,780 --> 00:17:36,490
...لكنّي

228
00:17:36,870 --> 00:17:41,200
هل تريد أن تجتمع مع أصدقائك فقط لتواجه نفس المصير؟

229
00:17:43,080 --> 00:17:45,490
.لديّ اقتراح لك

230
00:17:46,480 --> 00:17:48,530
...وبالطّبع أنت حرّ

231
00:17:49,760 --> 00:17:51,210
.في قبوله أم لا

232
00:18:00,500 --> 00:18:05,680
...في نفس الأثناء في أرخبيل بوين في الغراند لاين

233
00:18:06,560 --> 00:18:09,400
!توقّف! أوسوبّن

234
00:18:09,400 --> 00:18:11,820
!لا توقفني يا هراكلسن

235
00:18:12,430 --> 00:18:14,190
...أوسوبّ

236
00:18:14,190 --> 00:18:17,520
يحرّك جسده الّذي صار ضخمًا

237
00:18:17,520 --> 00:18:19,950
...من أكله لطعام وفير ومتنوّع في الغابة

238
00:18:23,440 --> 00:18:24,900
.ويركض

239
00:18:26,760 --> 00:18:28,500
!هذا مُستحيلُن

240
00:18:28,500 --> 00:18:31,000
!لا، ليس كذلك! لهذا سأحاول ثانيةً

241
00:18:31,540 --> 00:18:32,790
!يمكنني النّجاح هذه المرّة

242
00:18:38,030 --> 00:18:39,670
!وجدتك

243
00:18:43,160 --> 00:18:45,680
!ابتعدي عن طريقي

244
00:18:46,590 --> 00:18:48,100
...القتل المؤكّد

245
00:18:50,770 --> 00:18:53,930
!لان! أوسوبّن

246
00:18:59,080 --> 00:19:01,360
هل أنت بخير يا أوسوبّن؟

247
00:19:02,270 --> 00:19:03,760
...سحقًا

248
00:19:03,760 --> 00:19:07,830
.لا يمكنك فعل ذلك
،إن حاولت الخروج من هذه الجزيرة

249
00:19:08,620 --> 00:19:11,290
ستعترض طريقك أشياء حيّة مرعبة

250
00:19:11,290 --> 00:19:14,500
.وتعيدك إلى الغابتِن

251
00:19:20,940 --> 00:19:25,180
لن يوقفك أيّ شيء من دخول الجزيرَتِن

252
00:19:26,250 --> 00:19:28,880
!لكن فور أن تطأ عليها فأنت ميّت

253
00:19:28,880 --> 00:19:30,890
!لا أحد يغادر هذه الجزيرة حيَّن

254
00:19:30,890 --> 00:19:34,850
!واسمي هراكلسن

255
00:19:36,070 --> 00:19:39,050
!ماذا؟! أوسوبّ! إلى أين ذهبت؟

256
00:19:45,410 --> 00:19:46,580
!إنّه في خطرِن

257
00:19:46,580 --> 00:19:49,540
!لقد دخل المخلوق البحريّ الجزيرة للتّوّ

258
00:19:50,020 --> 00:19:52,750
!أوسوبّن في خطر

259
00:19:56,080 --> 00:20:00,700
...رائحة أرخبيل بوين الحلوة تجذب انتباه

260
00:20:00,700 --> 00:20:04,090
...الحشرات العملاقة والطّيور العملاقة

261
00:20:04,090 --> 00:20:06,990
.وحتّى المخلوقات البحريّة وملوك البحر

262
00:20:08,500 --> 00:20:10,390
!إنّه فرس نهر بحريّ

263
00:20:12,030 --> 00:20:14,980
!لا ينبغي أن أفتن به الآن

264
00:20:15,370 --> 00:20:19,110
...تغويها الرّائحة أعمق إلى الغابة

265
00:20:19,110 --> 00:20:22,450
.حيث تجد الغابة المليئة بالطّعام

266
00:20:26,270 --> 00:20:28,450
...من السّهل دخول الجزيرة

267
00:20:30,250 --> 00:20:32,450
...لكن من الصّعب مغادرتها

268
00:20:36,420 --> 00:20:40,000
!ابتعدي عن طريقي! القتل المؤكّد: النّجم المتفجّر

269
00:20:42,190 --> 00:20:44,340
!سأخرج من هنا

270
00:20:44,340 --> 00:20:48,680
!لا تعترضي طريقي

271
00:20:49,510 --> 00:20:53,520
!عليّ أن أعود

272
00:20:53,520 --> 00:20:55,810
!إلى شابوندي

273
00:20:57,110 --> 00:21:07,240
!النّجم المتفجّر

274
00:21:10,560 --> 00:21:11,790
!أوسوبّن

275
00:21:13,500 --> 00:21:15,560
!ستتحرك الجزر ثانيةً

276
00:21:15,560 --> 00:21:16,850
ماذا؟

277
00:21:20,880 --> 00:21:24,340
!أوسوبّن! تشبّث بشجرة

278
00:21:24,340 --> 00:21:25,840
!هل يحدث هذا ثانيةً؟

279
00:21:25,840 --> 00:21:28,430
!ستأكل شيئًا

280
00:21:34,570 --> 00:21:38,100
...اسم هذه الزّهرة الّتي تبدو كجزيرة

281
00:21:50,760 --> 00:21:52,550
.هو ما يدعوه النّاس بأرخبيل بوين

282
00:21:52,550 --> 00:21:56,500
!لكنّ الاسم العلميّ هو ستوماك بارون: نبتة آكلة للّحوم

283
00:21:58,050 --> 00:22:00,670
!أوسوبّن

284
00:22:09,340 --> 00:22:11,840
ما خطبك يا أوسوبّن؟

285
00:22:13,920 --> 00:22:18,310
!تغيّر حالك مذ قرأت الصّحيفة الّتي أحضرها نورس الأخبار

286
00:22:21,770 --> 00:22:23,320
...أنا

287
00:22:23,780 --> 00:22:30,470
!لا أملك وقتًا أضيّعه هنا الآن

288
00:22:34,970 --> 00:22:40,170
!فقد لوفي أخاه في الحرب

289
00:22:40,170 --> 00:22:45,210
!لا بدّ أنّه يواجه وقتًا عصيبًا الآن

290
00:23:03,190 --> 00:23:07,070
،عندما يواجه صديقك وقتًا عصيبًا

291
00:23:07,070 --> 00:23:12,060
!عليك أن تكون إلى جانبه

292
00:23:13,260 --> 00:23:17,370
!لوفي

293
00:23:25,480 --> 00:23:28,270
،يبادر أصدقاء لوفي من قلقهم عليه

294
00:23:28,270 --> 00:23:32,290
.لكنّ نامي سُجنت من قبل باحثي ويذاريا

295
00:23:32,290 --> 00:23:36,600
في نفس الأثناء، في جزيرة شتويّة، يتّجه
.فرانكي إلى مكان معيّن بحثًا عن كاسحة جليد

296
00:23:36,600 --> 00:23:39,810
!ما الزّرّ الخطير للغاية الّذي وجده هناك؟

297
00:23:39,810 --> 00:23:41,310
:في الحلقة القادمة من وان بيس

298
00:23:41,310 --> 00:23:45,020
العودة لقبطاننا! هروب من السّجن"
'!في جزيرة السّماء وحادثة جزيرة الشّتاء

299
00:23:45,020 --> 00:23:47,530
!ملك القراصنة، لن يكون إلاّ أنا

300
00:23:50,030 --> 00:23:55,030
!!نلقاكم في الحلقة القادمة