1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:19,730 --> 00:03:22,350
،بعد حرب القمّة ضدّ البحريّة

38
00:03:22,350 --> 00:03:24,560
...وصل لوفي إلى جزيرة النّساء

39
00:03:24,560 --> 00:03:27,610
.لكنّه أصيب بالاكتئاب من مشاعر ضعفه

40
00:03:28,060 --> 00:03:31,660
!ما الّذي ما زلت تملكه؟

41
00:03:38,510 --> 00:03:43,030
!لقاء مع ملك الظّلام ريلي"
"!وقت اتّخاذ القرار بالنّسبة للوفي

42
00:03:59,830 --> 00:04:02,350
.توقّف عن الصّراخ

43
00:04:02,350 --> 00:04:07,300
.على ذكر الأمر، أتساءل أين هو قبّعة القشّ

44
00:04:07,300 --> 00:04:09,750
سيموت إن فُتحَ جرحه، صحيح؟

45
00:04:15,420 --> 00:04:16,790
!اصطدتُ واحدة

46
00:04:23,860 --> 00:04:25,330
ما الخطب؟

47
00:04:25,930 --> 00:04:27,380
...أظنّني رأيت سمكةً للتّوّ

48
00:04:28,760 --> 00:04:30,630
!إ-إنّها كبيرة

49
00:04:40,890 --> 00:04:43,930
!انظروا! إنّه ملك بحر ضخم

50
00:04:43,930 --> 00:04:45,650
هل يقاتل؟

51
00:04:54,860 --> 00:04:57,330
!إنّه ميّت! لقد قُتل

52
00:04:58,330 --> 00:04:59,650
!لكنّه ضخم

53
00:04:59,650 --> 00:05:01,640
!لم أستطع رؤية ما قتله

54
00:05:01,640 --> 00:05:03,170
.المكان مخيف هنا

55
00:05:07,920 --> 00:05:09,130
رجل؟

56
00:05:09,130 --> 00:05:11,260
!أنت! من أنت؟

57
00:05:14,060 --> 00:05:15,930
...يا إلهي

58
00:05:16,360 --> 00:05:17,630
...مـ

59
00:05:19,090 --> 00:05:19,640
...حسنًا

60
00:05:19,640 --> 00:05:20,480
...مـ

61
00:05:20,480 --> 00:05:22,600
!ملك الظّلام ريلي

62
00:05:22,600 --> 00:05:24,060
!ماذا؟

63
00:05:24,060 --> 00:05:27,770
.هذا أنتم. تقابلنا في أرخبيل شابوندي

64
00:05:32,780 --> 00:05:36,200
!كان نائب القبطان ملك القراصنة روجر

65
00:05:36,200 --> 00:05:42,250
في الواقع، غرقت سفينتي في العاصفة
.ولم يكن لديّ خيار سوى أن أسبح

66
00:05:42,250 --> 00:05:47,320
!عاصفة؟! الحزام الهادئ هادئ دائمًا، لا يهيج أبدًا

67
00:05:47,320 --> 00:05:48,780
!لا ينبغي أن تحدث عاصفة

68
00:05:48,780 --> 00:05:53,510
ما يعني أنّ سفينته تحطّمت في مكان
!بعيد وسبح كلّ المسافة إلى هنا؟

69
00:05:54,680 --> 00:05:56,590
.أنا أجيد سباحة الصّدر جيّدًا

70
00:05:56,590 --> 00:05:58,830
.هذا ليس بيت القصيد

71
00:05:58,830 --> 00:06:01,350
...إذًا، كان ملك البحر ذاك

72
00:06:01,350 --> 00:06:03,180
!يقاتلك؟

73
00:06:03,180 --> 00:06:06,690
!فقط قرصان أسطوريّ يستطيع فعل ذلك

74
00:06:08,610 --> 00:06:09,820
.آسف

75
00:06:09,820 --> 00:06:12,320
!لِمَ الأسف؟

76
00:06:12,780 --> 00:06:14,240
!صحيح

77
00:06:16,320 --> 00:06:19,620
.أفترض أنّ لوفي-كن في هذه الجزيرة

78
00:06:24,580 --> 00:06:26,400
...هل سمعتنّ

79
00:06:26,400 --> 00:06:28,040
...أنّ أميرة الثّعابين-ساما والبقيّة

80
00:06:28,040 --> 00:06:30,460
ذهبن للتّوّ لتوصيل الطّعام للوفي؟

81
00:06:30,880 --> 00:06:33,510
!أريد تمديد جسده ثانيةً

82
00:06:33,510 --> 00:06:37,260
.قلن أنّه سيدعينه بعد أن تتحسّن حالته

83
00:06:37,260 --> 00:06:39,260
!لا أطيق الانتظار

84
00:06:39,260 --> 00:06:42,260
!لم أتوقّع رؤيته ثانيةً مبكّرًا هكذا

85
00:06:42,770 --> 00:06:45,770
!الرّجال مثيرون للاهتمام

86
00:06:45,770 --> 00:06:50,480
،إن كان بإمكاني أن أصبح رجلاً
!لكان جسدي يتمدّد كجسده

87
00:06:50,980 --> 00:06:52,730
!"هذا فصل "لا أطيق الانتظار

88
00:06:54,070 --> 00:06:57,570
...أجل، ربّما سأعدّ له ثيابًا ثانيةً

89
00:06:57,570 --> 00:06:59,280
!بلا زخرفة

90
00:07:03,830 --> 00:07:07,580
!نحن منعزلان مع أنّنا عروسان

91
00:07:07,580 --> 00:07:10,290
!أشعر كبطلة مأساة

92
00:07:10,290 --> 00:07:14,670
"!لكن يا هانكوك... لا، زوجتي العزيزة"

93
00:07:14,670 --> 00:07:16,050
"!نـ-نعم"

94
00:07:16,050 --> 00:07:20,050
"!مهما كنّا بعيدين عن بعضنا، حبّنا أبديّ"

95
00:07:20,480 --> 00:07:22,430
"!لوفي"

96
00:07:22,840 --> 00:07:28,850
!يا زوجي الحنون! قلبي مشتعل

97
00:07:28,850 --> 00:07:31,480
،ما قلت من قبل يا أميرة الثّعابين

98
00:07:31,480 --> 00:07:35,490
،فقط لأنّ أحدًا يعانقك أو يناديك باسمك

99
00:07:35,490 --> 00:07:37,360
.لا يعني أنّكما متزوّجان

100
00:07:37,360 --> 00:07:40,160
إذًا، ما الّذي يعدّ كزواج؟

101
00:07:40,160 --> 00:07:43,330
.لنرَ... ذلك سؤال صعب

102
00:07:46,360 --> 00:07:49,580
.لا يمكنك الذّهاب لشابوندي الآن بذلك الجرح

103
00:07:49,970 --> 00:07:53,560
.لكنّي أريد رؤية أصدقائي في أسرع وقت

104
00:07:53,560 --> 00:07:57,150
.يجب أن أذهب إلى هناك كما وعدت

105
00:07:57,150 --> 00:07:58,800
...لكن

106
00:07:59,360 --> 00:08:04,680
.ماذا؟ ذهبت الغوّاصة

107
00:08:04,980 --> 00:08:06,680
!لوفي-كن

108
00:08:06,680 --> 00:08:09,270
!ماذا؟! العمّ ريلي

109
00:08:10,210 --> 00:08:11,900
!مسرور لرؤيتك في هذا الوقت القريب

110
00:08:12,390 --> 00:08:14,270
!لِمَ أنت هنا؟

111
00:08:14,270 --> 00:08:18,860
.كنت على وشك الذّهاب إلى شابوندي باستخدام الفيفر كارد

112
00:08:20,530 --> 00:08:21,780
هل رأيت أصدقائي؟

113
00:08:21,780 --> 00:08:25,160
.لا، لا أظنّ أنّهم وصلوا إلى هناك بعد

114
00:08:25,740 --> 00:08:29,710
...أعطيت الفيفر كارد خاصّتي لشاكي

115
00:08:29,710 --> 00:08:34,880
.لكي أذهب حيثما شئت

116
00:08:34,880 --> 00:08:40,090
!ملك الظّلام ريلي! أهذا أنت حقًّا؟ لا أصدّق

117
00:08:40,420 --> 00:08:43,090
...لا بدّ أنّك الشّيتشيبوكاي السّابق

118
00:08:43,090 --> 00:08:45,560
.إنّه جينبي، لقد أنقذ حياتي

119
00:08:47,100 --> 00:08:48,560
ما الخطب؟

120
00:08:48,560 --> 00:08:52,900
.في الواقع، لم أتوقّع رؤية أسطورة حيّة هنا

121
00:08:52,900 --> 00:08:55,690
خذ. أليست هذه القبّعة مهمّة لك؟

122
00:08:55,690 --> 00:08:57,150
.أجل. شكرًا

123
00:09:01,610 --> 00:09:06,160
!لا أشعر بالارتياح من دونها في النّهاية

124
00:09:09,250 --> 00:09:12,250
هل رأيت مجموعة قراصنة هنا؟

125
00:09:12,250 --> 00:09:15,590
.إن كنت تقصد ترافالغار لو فقد غادر لتوّه

126
00:09:16,450 --> 00:09:20,170
.قال أنّ عليك الاستراحة في الفراش لأسبوعين آخرين

127
00:09:23,090 --> 00:09:24,890
لقد أنقذ حياتك، أليس كذلك؟

128
00:09:30,720 --> 00:09:34,190
...يا للخسارة! وصلنا لذلك الحدّ

129
00:09:34,190 --> 00:09:37,560
.أردت دخول الإمبراطوريّة المحرّمة على الرّجال

130
00:09:37,560 --> 00:09:39,360
.كنّ يسمحن بدخول الدّببة

131
00:09:39,360 --> 00:09:40,650
!اخرس

132
00:09:41,090 --> 00:09:42,320
.آسف

133
00:09:42,320 --> 00:09:43,740
!ضعيف جدًّا

134
00:09:44,030 --> 00:09:46,790
.أتساءل ما الّذي ينوي ملك الظّلام فعله

135
00:09:46,790 --> 00:09:49,730
...مهما كان، أنا واثق أنّ "د" سيجلبون عاصفة مجدّدًا

136
00:09:50,930 --> 00:09:53,460
.لا أطيق الانتظار لرؤيته ثانيةً

137
00:09:54,280 --> 00:09:58,590
!ريلي؟! لا بدّ أنّك ريلي

138
00:09:58,590 --> 00:10:02,550
!غلوريوسا! مضى وقت طويل

139
00:10:02,550 --> 00:10:03,930
!ريلي

140
00:10:03,930 --> 00:10:05,090
!ري-سان

141
00:10:05,090 --> 00:10:07,050
!أنتما هنا أيضًا

142
00:10:07,410 --> 00:10:08,890
!لوفي

143
00:10:08,890 --> 00:10:13,100
يا أختي! كيف تتجاهلين الرّجل الّذي أنقذ حياتك؟

144
00:10:13,520 --> 00:10:16,850
تعرفن العمّ ريلي؟

145
00:10:16,850 --> 00:10:18,230
!أجل

146
00:10:18,230 --> 00:10:20,650
.إنّها قصّة طويلة

147
00:10:20,650 --> 00:10:23,110
.لوفي، أفقت إذًا الآن

148
00:10:23,110 --> 00:10:25,360
.لم أذق طعم النّوم لأيّام من قلقي عليك

149
00:10:25,360 --> 00:10:28,410
.لا بدّ أنّك جائع. أحضرت بعض الطّعام

150
00:10:28,410 --> 00:10:30,410
...لذا بادر وكل

151
00:10:30,410 --> 00:10:32,550
.لا تستطيعين حتّى النّظر إليه

152
00:10:32,550 --> 00:10:35,290
فكيف تسمّينه زواجًا؟

153
00:10:35,290 --> 00:10:36,550
...اخدمه

154
00:10:37,680 --> 00:10:39,880
!قدّم له وجبةً بسرعة

155
00:10:43,110 --> 00:10:46,970
!جينبي! هذه ليست لك

156
00:10:47,550 --> 00:10:49,140
.يمكنك أكل القليل

157
00:10:49,140 --> 00:10:53,350
حـ-حسنًا. لوفي-كن، ما رأيك أن نأكل؟

158
00:10:55,350 --> 00:11:00,980
!لوفي-كن، عليك أن تأكل. الأكل هو الحياة

159
00:11:16,380 --> 00:11:19,380
!هكذا! أحسنت يا عزيزي لوفي-كن

160
00:11:32,890 --> 00:11:38,390
!"جينبي! قلت "كل القليل فحسب

161
00:11:43,040 --> 00:11:45,940
.شكرًا لإحضارك الرّسالة من شاكي

162
00:11:47,490 --> 00:11:50,450
.يبدو أنّها لم تتغيّر

163
00:11:50,450 --> 00:11:54,830
.أجل، إنّها على نفس حالها مذ كنت في شابوندي

164
00:11:54,830 --> 00:11:56,830
.إنّها بخير

165
00:11:56,830 --> 00:12:03,630
أصبحن هؤلاء الفتيات جميلات جدًّا
.وقويّات في غضون السّنوات الـ13 الماضية

166
00:12:03,630 --> 00:12:06,920
.ريلي، شاكي، الجدّة نيون

167
00:12:06,920 --> 00:12:12,140
.حميتمونا أنتم الثّلاثة عندما كنّا نهرب من التّنّانين السّماويّين

168
00:12:12,520 --> 00:12:14,720
.لكن لدينا مشكلة

169
00:12:14,720 --> 00:12:19,560
.علينا أن نوفّر الملجأ للوفي من البحريّة

170
00:12:19,560 --> 00:12:23,150
،مع أنّ ريلي يعرف لوفي من قبل

171
00:12:23,150 --> 00:12:27,310
،إن كان يسهل توقّع أنّ لوفي هنا

172
00:12:27,310 --> 00:12:29,150
.فيجدر أن نقلق

173
00:12:29,150 --> 00:12:31,960
!ماذا؟! يا له من وجه مألوف

174
00:12:31,960 --> 00:12:34,620
أنت ريلي، أليس كذلك؟

175
00:12:34,620 --> 00:12:37,290
!هل لاحظت الآن فقط؟! ما مدى فتنك به؟

176
00:12:38,960 --> 00:12:42,790
.كلاّ، لا أظنّ أنّ البحريّة يمكنها أن تتوقّع أنّه هنا

177
00:12:43,580 --> 00:12:47,200
أساسًا، الرّجل الّذي قذفه بعيدًا

178
00:12:47,200 --> 00:12:50,720
.أخبرني أنّه أرسله في هذا الاتّجاه

179
00:12:53,300 --> 00:12:54,220
...كوما

180
00:12:55,620 --> 00:12:58,300
.أعمل لصالح الجيش الثّوريّ

181
00:12:58,300 --> 00:13:00,310
.بما أنّ لديّ صلة بهم

182
00:13:00,310 --> 00:13:02,390
.أريد أن أدعهم يهربون من هنا

183
00:13:02,850 --> 00:13:05,400
.لا أصدّق ذلك

184
00:13:06,330 --> 00:13:09,070
وأين هو مونكي-تشان الآن؟

185
00:13:10,110 --> 00:13:11,780
.لا أدري

186
00:13:14,950 --> 00:13:17,700
.أعتذر عن أسلوبي الجافي سابقًا

187
00:13:18,450 --> 00:13:20,960
أيمكنني أن أحدّثك للحظة؟

188
00:13:21,580 --> 00:13:23,300
...لا أملك

189
00:13:24,380 --> 00:13:26,000
.الكثير من الوقت

190
00:13:27,340 --> 00:13:28,920
...ينبغي بقبّعة القشّ

191
00:13:30,300 --> 00:13:34,680
،يوجد في الاتّجاه الّذي أرسل بارثولوميو كوما لوفي-كن إليه

192
00:13:34,680 --> 00:13:37,970
.جزيرة النّساء

193
00:13:38,440 --> 00:13:40,230
.هذا ليس كلّ شيء

194
00:13:40,230 --> 00:13:44,310
.اكتشفت بعض المعلومات المثيرة للاهتمام بشأن حرب القمّة

195
00:13:44,310 --> 00:13:49,190
وهي تخصّ عمليّة الهرب من سجن
.إمبل داون من قبل لوفي-كن والبقيّة

196
00:13:49,190 --> 00:13:54,530
عندما فكّرت في كيف استطاع لوفي-كن
،التّسلّل إلى السّجن العظيم

197
00:13:55,060 --> 00:13:56,450
اتّضح لي أنّ لوفي-كن

198
00:13:56,450 --> 00:14:01,290
...تسلّل إلى سفينة بحريّة على الأغلب رفقة هانكوك، لكن

199
00:14:05,230 --> 00:14:08,840
،بما أنّ هانكوك تكره كلاًّ من الحكومة والرّجال

200
00:14:08,840 --> 00:14:11,400
،لا أظنّ أنّها ستركب سفينة حكومة

201
00:14:11,400 --> 00:14:13,760
.لا سيّما لمساعدة رجل

202
00:14:14,900 --> 00:14:17,140
.والآن، هذا الجزء نظريّ بالكامل

203
00:14:17,960 --> 00:14:19,810
لكن ماذا عن هذا؟

204
00:14:21,560 --> 00:14:26,310
،لنفترض أنّ هانكوك وقعت في حبّ مونكي-تشان

205
00:14:26,310 --> 00:14:28,110
.حينها سيكون كلّ شيء منطقيًّا

206
00:14:30,230 --> 00:14:33,070
.مونكي-تشان شخص وسيم

207
00:14:34,400 --> 00:14:37,530
،وإن كنتُ هانكوك

208
00:14:37,530 --> 00:14:41,990
.كنتُ لأمنحه الملجأ في جزيرة النّساء لأخدع البحريّة

209
00:14:43,330 --> 00:14:46,170
.هذه نظريّة ذاتيّة جدًّا يا شاكي

210
00:14:49,250 --> 00:14:52,710
.حدس النّساء مذهل

211
00:14:52,710 --> 00:14:54,550
!هذه شاكي الّتي أعرفها

212
00:14:54,550 --> 00:14:57,930
.لقد أصابت كبد الحقيقة كما ترى

213
00:14:57,930 --> 00:15:01,060
!حقًّا؟ هل أعجبك؟ جيّد

214
00:15:02,120 --> 00:15:05,980
.لن تتحرّك البحريّة بناء على نظريّة سخيفة كهذه

215
00:15:06,750 --> 00:15:08,690
.لذا هذا المكان آمن

216
00:15:09,320 --> 00:15:11,770
.والآن، لندخل صلب الموضوع

217
00:15:13,310 --> 00:15:14,800
.لوفي-كن

218
00:15:15,760 --> 00:15:20,760
قلت أنّك ذاهب لشابوندي، أليس كذلك؟

219
00:15:23,700 --> 00:15:25,540
.أنا بحاجة لرؤية أصدقائي

220
00:15:27,710 --> 00:15:31,040
أهذا ما تريد حقًّا؟

221
00:15:49,360 --> 00:15:51,190
.أرخبيل شابوندي

222
00:15:52,680 --> 00:15:55,610
أتذكر ما حدث لكم في تلك الجزيرة؟

223
00:16:03,780 --> 00:16:07,400
!ركّزوا على الهرب جميعًا

224
00:16:08,440 --> 00:16:14,040
!لا يمكننا هزيمة هؤلاء الأشخاص في مستوانا الحاليّ

225
00:16:31,950 --> 00:16:36,900
!...لم أستطع أن أنقذ أيّ أحد من أصدقائي

226
00:16:58,720 --> 00:17:03,920
هل تظنّ أنّك تستطيع مواجهة تلك
القوى الجبّارة في مستواك الحاليّ؟

227
00:17:20,780 --> 00:17:22,490
...لكنّي

228
00:17:22,870 --> 00:17:27,200
هل تريد أن تجتمع مع أصدقائك فقط لتواجه نفس المصير؟

229
00:17:29,080 --> 00:17:31,490
.لديّ اقتراح لك

230
00:17:32,480 --> 00:17:34,530
...وبالطّبع أنت حرّ

231
00:17:35,760 --> 00:17:37,210
.في قبوله أم لا

232
00:17:46,500 --> 00:17:51,680
...في نفس الأثناء في أرخبيل بوين في الغراند لاين

233
00:17:52,560 --> 00:17:55,400
!توقّف! أوسوبّن

234
00:17:55,400 --> 00:17:57,820
!لا توقفني يا هراكلسن

235
00:17:58,430 --> 00:18:00,190
...أوسوبّ

236
00:18:00,190 --> 00:18:03,520
يحرّك جسده الّذي صار ضخمًا

237
00:18:03,520 --> 00:18:05,950
...من أكله لطعام وفير ومتنوّع في الغابة

238
00:18:09,440 --> 00:18:10,900
.ويركض

239
00:18:12,760 --> 00:18:14,500
!هذا مُستحيلُن

240
00:18:14,500 --> 00:18:17,000
!لا، ليس كذلك! لهذا سأحاول ثانيةً

241
00:18:17,540 --> 00:18:18,790
!يمكنني النّجاح هذه المرّة

242
00:18:24,030 --> 00:18:25,670
!وجدتك

243
00:18:29,160 --> 00:18:31,680
!ابتعدي عن طريقي

244
00:18:32,590 --> 00:18:34,100
...القتل المؤكّد

245
00:18:36,770 --> 00:18:39,930
!لان! أوسوبّن

246
00:18:45,080 --> 00:18:47,360
هل أنت بخير يا أوسوبّن؟

247
00:18:48,270 --> 00:18:49,760
...سحقًا

248
00:18:49,760 --> 00:18:53,830
.لا يمكنك فعل ذلك
،إن حاولت الخروج من هذه الجزيرة

249
00:18:54,620 --> 00:18:57,290
ستعترض طريقك أشياء حيّة مرعبة

250
00:18:57,290 --> 00:19:00,500
.وتعيدك إلى الغابتِن

251
00:19:06,940 --> 00:19:11,180
لن يوقفك أيّ شيء من دخول الجزيرَتِن

252
00:19:12,250 --> 00:19:14,880
!لكن فور أن تطأ عليها فأنت ميّت

253
00:19:14,880 --> 00:19:16,890
!لا أحد يغادر هذه الجزيرة حيَّن

254
00:19:16,890 --> 00:19:20,850
!واسمي هراكلسن

255
00:19:22,070 --> 00:19:25,050
!ماذا؟! أوسوبّ! إلى أين ذهبت؟

256
00:19:31,410 --> 00:19:32,580
!إنّه في خطرِن

257
00:19:32,580 --> 00:19:35,540
!لقد دخل المخلوق البحريّ الجزيرة للتّوّ

258
00:19:36,020 --> 00:19:38,750
!أوسوبّن في خطر

259
00:19:42,080 --> 00:19:46,700
...رائحة أرخبيل بوين الحلوة تجذب انتباه

260
00:19:46,700 --> 00:19:50,090
...الحشرات العملاقة والطّيور العملاقة

261
00:19:50,090 --> 00:19:52,990
.وحتّى المخلوقات البحريّة وملوك البحر

262
00:19:54,500 --> 00:19:56,390
!إنّه فرس نهر بحريّ

263
00:19:58,030 --> 00:20:00,980
!لا ينبغي أن أفتن به الآن

264
00:20:01,370 --> 00:20:05,110
...تغويها الرّائحة أعمق إلى الغابة

265
00:20:05,110 --> 00:20:08,450
.حيث تجد الغابة المليئة بالطّعام

266
00:20:12,270 --> 00:20:14,450
...من السّهل دخول الجزيرة

267
00:20:16,250 --> 00:20:18,450
...لكن من الصّعب مغادرتها

268
00:20:22,420 --> 00:20:26,000
!ابتعدي عن طريقي! القتل المؤكّد: النّجم المتفجّر

269
00:20:28,190 --> 00:20:30,340
!سأخرج من هنا

270
00:20:30,340 --> 00:20:34,680
!لا تعترضي طريقي

271
00:20:35,510 --> 00:20:39,520
!عليّ أن أعود

272
00:20:39,520 --> 00:20:41,810
!إلى شابوندي

273
00:20:43,110 --> 00:20:53,240
!النّجم المتفجّر

274
00:20:56,560 --> 00:20:57,790
!أوسوبّن

275
00:20:59,500 --> 00:21:01,560
!ستتحرك الجزر ثانيةً

276
00:21:01,560 --> 00:21:02,850
ماذا؟

277
00:21:06,880 --> 00:21:10,340
!أوسوبّن! تشبّث بشجرة

278
00:21:10,340 --> 00:21:11,840
!هل يحدث هذا ثانيةً؟

279
00:21:11,840 --> 00:21:14,430
!ستأكل شيئًا

280
00:21:20,570 --> 00:21:24,100
...اسم هذه الزّهرة الّتي تبدو كجزيرة

281
00:21:36,760 --> 00:21:38,550
.هو ما يدعوه النّاس بأرخبيل بوين

282
00:21:38,550 --> 00:21:42,500
!لكنّ الاسم العلميّ هو ستوماك بارون: نبتة آكلة للّحوم

283
00:21:44,050 --> 00:21:46,670
!أوسوبّن

284
00:21:55,340 --> 00:21:57,840
ما خطبك يا أوسوبّن؟

285
00:21:59,920 --> 00:22:04,310
!تغيّر حالك مذ قرأت الصّحيفة الّتي أحضرها نورس الأخبار

286
00:22:07,770 --> 00:22:09,320
...أنا

287
00:22:09,780 --> 00:22:16,470
!لا أملك وقتًا أضيّعه هنا الآن

288
00:22:20,970 --> 00:22:26,170
!فقد لوفي أخاه في الحرب

289
00:22:26,170 --> 00:22:31,210
!لا بدّ أنّه يواجه وقتًا عصيبًا الآن

290
00:22:49,190 --> 00:22:53,070
،عندما يواجه صديقك وقتًا عصيبًا

291
00:22:53,070 --> 00:22:58,060
!عليك أن تكون إلى جانبه

292
00:22:59,260 --> 00:23:03,370
!لوفي

293
00:23:11,480 --> 00:23:14,270
،يبادر أصدقاء لوفي من قلقهم عليه

294
00:23:14,270 --> 00:23:18,290
.لكنّ نامي سُجنت من قبل باحثي ويذاريا

295
00:23:18,290 --> 00:23:22,600
في نفس الأثناء، في جزيرة شتويّة، يتّجه
.فرانكي إلى مكان معيّن بحثًا عن كاسحة جليد

296
00:23:22,600 --> 00:23:25,810
!ما الزّرّ الخطير للغاية الّذي وجده هناك؟

297
00:23:25,810 --> 00:23:27,310
:في الحلقة القادمة من وان بيس

298
00:23:27,310 --> 00:23:31,020
العودة لقبطاننا! هروب من السّجن"
'!في جزيرة السّماء وحادثة جزيرة الشّتاء

299
00:23:31,020 --> 00:23:33,530
!ملك القراصنة، لن يكون إلاّ أنا

300
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة