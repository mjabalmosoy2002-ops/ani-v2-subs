1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,790
"وأقول "أريد أن أصير أقوى

5
00:01:01,950 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,370 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,590 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,520 --> 00:03:37,150
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:37,150 --> 00:03:40,740
اندفع لإنقاذ أخيه إيس الّذي يوشك أن يُعدم

39
00:03:40,740 --> 00:03:46,530
في مارينفورد حيث نشبت معركة بين
!قراصنة اللّحية البيضاء والبحريّة

40
00:03:46,950 --> 00:03:48,950
!انتباه لكلّ السّفن والجنود

41
00:03:48,950 --> 00:03:51,250
...عندما تجهزون جميعًا، سنسرّع جدولنا

42
00:03:51,750 --> 00:03:54,490
.وسنعدم إيس في الحال. هذا كلّ شيء

43
00:03:56,790 --> 00:03:58,250
...لوفي-كُن

44
00:03:58,250 --> 00:03:59,340
!لننطلق

45
00:04:02,050 --> 00:04:04,130
!هيّا بنا

46
00:04:06,790 --> 00:04:07,850
!مـ-مهلاً

47
00:04:09,180 --> 00:04:11,680
!كلاّ! ذلك ليس الجانب الصّحيح

48
00:04:31,250 --> 00:04:40,500
!إيس

49
00:04:41,670 --> 00:04:43,510
!...مـ-مهلاً، أيعقل أنّه

50
00:04:43,510 --> 00:04:45,220
!كروكودايل

51
00:04:45,220 --> 00:04:48,350
!إنّه ليس وحده! من معه أيضًا؟

52
00:04:48,350 --> 00:04:52,220
!كلّ القوّات هنا من كِلا الجانبين
!ثمّة الكثير من الأسماء الكبيرة

53
00:04:53,350 --> 00:04:55,800
!على العالم أن يستعدّ لهذا

54
00:04:56,310 --> 00:04:59,060
!إيس، أتينا لإنقاذك

55
00:04:59,060 --> 00:05:01,740
!نحن هنا لأجلك

56
00:05:02,690 --> 00:05:05,900
!غارب! إنّها عائلتك ثانية

57
00:05:06,160 --> 00:05:07,820
!لوفي

58
00:05:08,160 --> 00:05:14,370
.حفيد البطل غارب وابن الثّوريّ دراغون

59
00:05:16,170 --> 00:05:19,670
!سأتولّى أمره للأبد

60
00:05:21,250 --> 00:05:22,760
أين الفتى كروكو؟

61
00:05:22,760 --> 00:05:26,930
...ماذا؟ أعتقد أنّ جبُن و

62
00:05:26,930 --> 00:05:28,640
!ها هو هناك

63
00:05:29,970 --> 00:05:32,270
!لقد سبقني

64
00:05:33,100 --> 00:05:36,100
.لم أرك منذ مدّة أيّها اللّحية البيضاء

65
00:05:36,100 --> 00:05:38,560
.أنت لا تتعلّم أبدًا

66
00:05:51,490 --> 00:05:57,250
.بما أنّنا وصلنا إلى هنا، فقد انتهى اتّفاقنا

67
00:05:57,250 --> 00:05:59,830
!لماذا تريد حماية اللّحية البيضاء؟

68
00:05:59,830 --> 00:06:02,630
.كما توقّعت، هذا العجوز هو اللّحية البيضاء

69
00:06:02,630 --> 00:06:07,170
!دعه وشأنه إذًا! يحبّ إيس هذا العجوز

70
00:06:07,170 --> 00:06:10,590
.أخو إيس مقاتل ممتاز

71
00:06:10,590 --> 00:06:13,310
أتيتَ لتنقذ أخاك الكبير؟

72
00:06:13,310 --> 00:06:14,260
.صحيح

73
00:06:14,630 --> 00:06:17,810
!أتعرف مع من تعبث؟

74
00:06:22,020 --> 00:06:26,040
!سينتهي المطاف بشقيّ مثلك جثّة هادمة

75
00:06:28,070 --> 00:06:31,820
!اخرس! ذلك ليس شيئًا تقرّره أنت

76
00:06:32,370 --> 00:06:34,280
!أعرف ما هدفك

77
00:06:34,280 --> 00:06:37,580
!تريد أن تصير ملك القراصنة، صحيح؟

78
00:06:38,240 --> 00:06:42,040
!ملك القراصنة، لن يكون إلاّ أنا

79
00:06:53,300 --> 00:06:55,600
!يا لك من وقح

80
00:06:56,720 --> 00:07:00,520
لن أسامحك إن تسبّبت لي بالمشاكل
!أيّها الشّقيّ المدلّل

81
00:07:00,520 --> 00:07:03,060
!سأقوم بما يحلو لي

82
00:07:05,070 --> 00:07:07,290
!سأنقذ إيس

83
00:07:11,200 --> 00:07:15,920
!وإن عنى ذلك الموت"
"!بداية معركة لوفي ضدّ البحريّة

84
00:07:21,790 --> 00:07:26,170
!إنّه... النّاشئ قبّعة القشّ

85
00:07:26,550 --> 00:07:28,840
كيف يعرف اللّحية البيضاء؟

86
00:07:29,210 --> 00:07:30,920
!لا أفهم

87
00:07:30,920 --> 00:07:34,760
!كان عليه الاختباء بعد الهرب من السّجن العظيم

88
00:07:34,760 --> 00:07:38,330
!لماذا تكبّد عناء المجيء لهذا الجحيم؟

89
00:07:38,850 --> 00:07:40,640
.لأنّه لوفي-سان

90
00:07:41,730 --> 00:07:43,940
!هكذا هي طبيعته

91
00:07:47,070 --> 00:07:49,820
!والدي! لوفي

92
00:07:50,900 --> 00:07:54,200
.هذا هو قبّعة القشّ

93
00:07:56,740 --> 00:07:57,740
.أيّها العجوز

94
00:07:58,950 --> 00:08:02,160
...سمعتُ بينما كنتُ على سفينة البحريّة

95
00:08:02,160 --> 00:08:03,660
!يا له من مغفّل

96
00:08:03,660 --> 00:08:06,790
!أتمنّى أن يوسَع ضربًا فحسب! غبيّ

97
00:08:06,790 --> 00:08:10,460
.يا لشجاعته! وحده ابنه قادر على هذا

98
00:08:11,070 --> 00:08:14,430
إذًا فسيقومون بإعدام إيس في الحال؟

99
00:08:14,430 --> 00:08:16,680
هل أنت واثق؟

100
00:08:16,680 --> 00:08:20,020
قالوا أنّهم سيشرعون في ذلك
...بعد تجهيز شيء ما

101
00:08:20,020 --> 00:08:22,440
لكنّهم كانوا يستعملون شيفرة ما
.لذلك لم أتمكّن من فهم الأمر

102
00:08:23,600 --> 00:08:27,190
،أعلم أنّك تريد إنقاذ إيس أيضًا
!لذلك أردت تشارك ذلك معك

103
00:08:28,070 --> 00:08:32,070
.فهمت. كانت تلك معلومة مهمّة

104
00:08:32,070 --> 00:08:33,700
.شكرًا لك

105
00:08:33,700 --> 00:08:35,700
.لا داعي للشّكر

106
00:08:36,410 --> 00:08:40,160
كيف يستطيع الكلام مع اللّحية البيضاء
!وكأنّهما على قدم المساواة؟

107
00:08:40,500 --> 00:08:44,560
!حسنًا! إيس، أنا قادم

108
00:08:46,790 --> 00:08:48,290
من أين له كلّ هذه الثّقة؟

109
00:08:52,460 --> 00:08:54,380
...فاكهة المطّاط

110
00:08:54,380 --> 00:08:56,890
!البازوكا

111
00:08:57,250 --> 00:08:59,890
!ابتعدوا عن طريقي

112
00:08:59,890 --> 00:09:02,980
.إنّه أخو إيس إذًا

113
00:09:02,980 --> 00:09:06,900
!احذوا حذو الفتى! هيّا بنا أيّتها الوحدة الثّالثة

114
00:09:08,360 --> 00:09:10,360
!علينا الذّهاب أيضًا

115
00:09:10,360 --> 00:09:11,690
!ما-ماذا؟

116
00:09:13,690 --> 00:09:15,650
!فعلاً؟

117
00:09:17,530 --> 00:09:20,830
!أيّتها الوحدة الرّابعة عشر، لنتقدّم للأمام

118
00:09:20,830 --> 00:09:22,290
!حاضر أيّها القائد جيل

119
00:09:26,120 --> 00:09:27,210
...لوفي

120
00:09:28,170 --> 00:09:33,260
تشجّعوا لهذا الحدّ بسبب متهوّر واحد؟

121
00:09:33,260 --> 00:09:35,630
.لكنّ استراتيجيّتنا مُحكمة

122
00:09:36,220 --> 00:09:39,760
!لا تتردّدوا! افعلوا ما أقول

123
00:09:41,080 --> 00:09:42,950
!تبًّا لسنغوكو ذاك

124
00:09:42,950 --> 00:09:48,230
أراهن أنّه يعتقد أنّه لا يحتاج
.لاحترام موعد إعدام مجرّد قرصان

125
00:09:48,230 --> 00:09:51,690
المفتاح هو... ما الّذي سيتجهّزون له؟

126
00:09:54,280 --> 00:09:59,570
يا والدي! سمعتُ أنّهم سيعجّلون
!في موعد إعدام إيس

127
00:09:59,570 --> 00:10:03,290
سمعت ذلك. ما وضع سكوارد والبقيّة؟

128
00:10:03,810 --> 00:10:09,210
إنّهم مشغولون مع بعض نوّاب الأميرالات
...في رأس الخليج. سأطير إليهم للمساعدة

129
00:10:09,210 --> 00:10:11,120
.لا، انتظر

130
00:10:11,790 --> 00:10:17,170
أراهن أنّ تسرّب بعض المعلومات والتّقدّم
.على أساسها كان جزءًا من خطّته

131
00:10:18,440 --> 00:10:24,690
ما كان سنغوكو ليسمح للعدوّ بمعرفة
.استراتيجيّته بسهولة

132
00:10:24,690 --> 00:10:26,850
.ليس رجلاً بتلك الحماقة

133
00:10:26,850 --> 00:10:28,560
!واصلوا

134
00:10:32,310 --> 00:10:34,360
!ركلة بسرعة الضّوء؟

135
00:10:36,940 --> 00:10:42,950
.لا تخاطروا كثيرًا. لن أسمح لكم بغزونا بسهولة

136
00:10:42,950 --> 00:10:44,620
!إنّها الأميرال كيزارو

137
00:10:47,250 --> 00:10:49,580
!أنت الّذي التقيناه في شابوندي

138
00:10:49,580 --> 00:10:55,090
نعم، كنتُ سأقضي عليك هناك
.لأنّ التّنانين السّماويّين أرادوا ذلك

139
00:10:55,600 --> 00:10:57,300
.قبّعة القشّ لوفي

140
00:10:59,340 --> 00:11:02,590
!قـ-قبّعة القشّ لوفي في عداد الموتى

141
00:11:02,590 --> 00:11:04,260
...غمزة

142
00:11:04,260 --> 00:11:06,390
!الموت

143
00:11:14,400 --> 00:11:17,150
!كلاّ! أريد الذّهاب للمنزل

144
00:11:17,150 --> 00:11:19,990
!ماذا أيّها القبطان باغي؟

145
00:11:19,990 --> 00:11:21,820
!لا أصدّق ما قلته للتّوّ؟

146
00:11:23,200 --> 00:11:28,790
تقصد أنّك تريد تدمير كيزارو بسرعة
!لتتمكّن من العودة للمنزل

147
00:11:28,790 --> 00:11:33,210
وحده قرصان أسطوريّ بإمكانه مواجهة
!الأميرال كيزارو دون خوف

148
00:11:34,290 --> 00:11:36,590
!إنّكم إيجابيّون للغاية

149
00:11:36,590 --> 00:11:38,880
هل أنت بخير يا فتى قبّعة القشّ؟

150
00:11:38,880 --> 00:11:41,340
!كان ذلك وشيكًا! شكرًا لك يا إيفان-تشان

151
00:11:41,660 --> 00:11:46,430
!مهمّتي الوحيدة هي إنقاذك

152
00:11:47,280 --> 00:11:48,520
!كيزارو ثانية

153
00:11:49,010 --> 00:11:52,190
...ماذا؟ لا، ليس هو! هذا

154
00:11:52,190 --> 00:11:53,020
!كوما

155
00:11:53,020 --> 00:11:57,520
!إنّه الشّبيه بالدّبّ الّذي فرّقنا جميعًا

156
00:11:59,760 --> 00:12:02,610
!التّدحرج التّجميليّ

157
00:12:08,160 --> 00:12:09,620
!بارثولوميو كوما

158
00:12:09,620 --> 00:12:11,320
!كم هذا فظيع

159
00:12:11,320 --> 00:12:14,580
...أعلم أنّك لك دورًا كشيتشيبوكاي، لكن

160
00:12:14,580 --> 00:12:19,250
.إنّنا نعرف بعضنا منذ مدّة
!كيف استطعت إطلاق ليزر عليّ؟

161
00:12:19,250 --> 00:12:21,010
...أنت، كيف

162
00:12:24,590 --> 00:12:26,220
!ثقب

163
00:12:27,260 --> 00:12:28,470
!إيفان-تشان

164
00:12:28,470 --> 00:12:31,350
!لا تقلق حيالي

165
00:12:31,350 --> 00:12:34,640
!دع هذا الأمر لي وتقدّم أنت

166
00:12:34,640 --> 00:12:35,900
!مفهوم

167
00:12:37,040 --> 00:12:39,230
!لنقم بهذا

168
00:13:00,920 --> 00:13:05,050
!إنّ حظّك عاثر لأنّك التقيت بنا

169
00:13:05,050 --> 00:13:08,680
!يا قبّعة القشّ، ستموت ها هنا

170
00:13:08,680 --> 00:13:11,390
ماذا؟ من تكونان؟

171
00:13:12,450 --> 00:13:14,640
!أنا فولبودي

172
00:13:14,640 --> 00:13:18,100
!عليك دفع ثمن ما حدث في مطعم باراتيي البحريّ

173
00:13:18,530 --> 00:13:20,610
.صحيح، أوسعك سانجي ضربًا

174
00:13:21,780 --> 00:13:24,820
.لا بدّ أنّك تتذكّر هذا التشاكرام

175
00:13:25,450 --> 00:13:29,370
أنت المنوّم المغناطيسيّ من قرية
أوسوبّ. لماذا أنت هنا؟

176
00:13:30,620 --> 00:13:34,720
.صقلت مهاراتي في البحريّة

177
00:13:35,420 --> 00:13:37,620
.وباثنين من التشاكرام، سيتضاعف التّأثير

178
00:13:37,620 --> 00:13:41,290
،"عندما أقول "واحد، اثنان، جانغو
.ستشعر بالتّعب

179
00:13:41,290 --> 00:13:43,750
...واحد، اثنان

180
00:13:44,210 --> 00:13:45,880
!جانغو

181
00:13:53,800 --> 00:13:55,760
ما الّذي تفعلانه؟

182
00:13:59,020 --> 00:14:00,360
.خاب ظنّ هينا

183
00:14:00,620 --> 00:14:03,540
!كنتِ في ألاباستا، صحيح؟

184
00:14:03,540 --> 00:14:06,650
!لا وقت لديّ للّعب معكم الآن

185
00:14:06,650 --> 00:14:07,780
!لن أسمح لك بالفرار

186
00:14:07,780 --> 00:14:09,680
!قفص كُمّ الكيمونو

187
00:14:13,620 --> 00:14:18,080
!أستطيع تقييم كلّ من يمرّون خلالي

188
00:14:18,080 --> 00:14:20,290
!إنّها جملته المفضّلة

189
00:14:20,290 --> 00:14:22,380
!الآنسة هينا آسرة للغاية

190
00:14:22,840 --> 00:14:24,800
!سئمت تواجدي خلف القضبان

191
00:14:24,800 --> 00:14:26,840
!المستوى الثّاني

192
00:14:32,010 --> 00:14:34,430
!كـ-كم هو سريع! لم أستطع رؤيته

193
00:14:35,520 --> 00:14:37,100
!فشلت هينا

194
00:14:37,100 --> 00:14:39,350
!فشلنا أيضًا

195
00:14:39,350 --> 00:14:43,020
!حلقنا في شباك الآنسة هينا، جسدًا وروحًا

196
00:14:49,740 --> 00:14:53,370
!لا تقاتلوا نوّاب الأميرالات وحدكم
!سيهزمونكم

197
00:14:56,400 --> 00:14:59,760
!أيّها القبطان سكوارد! الفوضى تعمّ الخليج

198
00:14:59,760 --> 00:15:00,960
!أعلم ذلك

199
00:15:01,450 --> 00:15:03,750
.عليّ الإسراع والوصول لإيس

200
00:15:05,000 --> 00:15:08,010
...الجدّار الّذي حطّمه أورز

201
00:15:08,010 --> 00:15:11,760
.إن تسلّلت من هنا، ربّما أستطيع أن أفوقهم دهاءً

202
00:15:21,900 --> 00:15:23,890
!...أنت

203
00:15:40,120 --> 00:15:41,870
!توقّف

204
00:15:51,340 --> 00:15:52,630
...فاكهة المطّاط

205
00:15:52,630 --> 00:15:54,280
!السّوط

206
00:16:01,600 --> 00:16:03,600
!جميعهم أقوياء

207
00:16:16,700 --> 00:16:21,080
!قبّعة القشّ! إنّ روحه عالية كالعادة

208
00:16:21,080 --> 00:16:26,790
!صحيح! سأقصّ ظلّه وأزرعه في أورز ثانية

209
00:16:30,130 --> 00:16:32,720
!تعالوا يا جنود الزّومبي

210
00:16:41,560 --> 00:16:47,560
!حسنًا يا جنود الزّومبي
!انطلقوا وأمسكوا بقبّعة القشّ

211
00:16:48,200 --> 00:16:51,070
!موريا! لا أريد التّعامل معه الآن

212
00:17:07,300 --> 00:17:08,980
!استعيدوا رصاصكم

213
00:17:14,090 --> 00:17:15,590
!أعدادهم تزيد

214
00:17:15,930 --> 00:17:22,220
،نعم، لأنّنا في ساحة معركة
!وتوفّر لي كلّ هذه الجثث زومبي جدد

215
00:17:22,600 --> 00:17:24,100
!أمسكوا بقبّعة القشّ

216
00:17:24,100 --> 00:17:26,100
!إنّه المشتبه به الرّئيسيّ في عمليّة الهروب

217
00:17:26,440 --> 00:17:28,520
!واصلوا

218
00:17:29,380 --> 00:17:31,900
!عليه مقاتلة كلّ هؤلاء الضّبّاط

219
00:17:32,560 --> 00:17:35,280
!أتساءل إلى متى يمكنه المواصلة

220
00:17:38,140 --> 00:17:39,370
!لوفي

221
00:17:59,470 --> 00:18:02,110
!ارحل يا لوفي

222
00:18:17,230 --> 00:18:19,780
!أعلم أنّك تعلم

223
00:18:20,200 --> 00:18:22,370
!كلانا قرصان

224
00:18:22,790 --> 00:18:25,410
!دخل كِلانا غمار البحر كما رغبنا

225
00:18:25,750 --> 00:18:28,670
!لديّ مغامرتي الخاصّة

226
00:18:29,420 --> 00:18:32,150
!لديّ أصدقائي

227
00:18:33,650 --> 00:18:34,670
!إيس

228
00:18:35,000 --> 00:18:36,260
...أريدك

229
00:18:36,260 --> 00:18:39,130
!ألاّ تقترب منهم

230
00:18:39,720 --> 00:18:42,800
!يريد ضعيف مثلك أن ينقذني؟

231
00:18:42,800 --> 00:18:43,830
!ابتعد عن طريقي

232
00:18:43,830 --> 00:18:47,140
!أتظنّ أنّني سأسمح لك بذلك؟

233
00:18:47,480 --> 00:18:49,310
!هذا مهين للغاية

234
00:18:49,840 --> 00:18:53,270
!ارجع يا لوفي! لماذا أتيت إلى هنا؟

235
00:18:55,630 --> 00:19:00,730
أتوسّل إليك يا لوفي
!لا أريدك أن تشاركني قدري

236
00:19:02,280 --> 00:19:05,640
!كلّ هذا خطئي أنا

237
00:19:07,620 --> 00:19:09,290
...أنا

238
00:19:09,760 --> 00:19:12,210
!أخوك الصّغير

239
00:19:18,640 --> 00:19:19,880
أتعلم؟

240
00:19:20,530 --> 00:19:23,960
!بإمكاننا أن نصير إخوة إن تقاسمنا كأس ساكي

241
00:19:26,140 --> 00:19:29,370
!من الآن فصاعدًا، نحن إخوة

242
00:19:37,400 --> 00:19:40,110
"هل قال للتّوّ "أنا أخوك الصّغير؟

243
00:19:40,110 --> 00:19:41,700
إنّه ابن روجر أيضًا؟

244
00:19:42,040 --> 00:19:46,580
.عندما وُلد إيس، مات كِلا والديه
!هذا مستحيل

245
00:19:47,820 --> 00:19:49,660
...لا أهتمّ إطلاقًا

246
00:19:50,640 --> 00:19:52,330
!لقوانين القراصنة

247
00:19:52,330 --> 00:19:54,100
!أيّها المغفّل

248
00:19:57,240 --> 00:20:00,260
!هيّا يا جنودي الزّومبي

249
00:20:08,700 --> 00:20:10,230
!مـ-ماء بحر؟

250
00:20:13,020 --> 00:20:14,410
!جينبي

251
00:20:14,410 --> 00:20:18,940
،إن أسعفتني الذّاكرة يا موريا
.فجنودك الزّومبي لا يتحمّلون الملح

252
00:20:20,360 --> 00:20:23,280
!لوفي-كُن، دعني أتولّى أمرهم

253
00:20:23,280 --> 00:20:23,700
!ممتاز

254
00:20:24,030 --> 00:20:25,740
!فارس البحر جينبي

255
00:20:25,740 --> 00:20:27,160
.شيتشيبوكاي سابق

256
00:20:27,160 --> 00:20:32,120
ما الّذي تفعلونه؟! لا تسمحوا لهذا
!النّاشئ بالسّيطرة على الحرب

257
00:20:32,120 --> 00:20:34,540
!ابتعدوا عن الطّريق

258
00:20:34,540 --> 00:20:36,990
!سأسحقه

259
00:20:42,840 --> 00:20:46,140
!هذا الرّجل خطر على المستقبل أيضًا

260
00:20:46,590 --> 00:20:50,480
لقد كبُر معتبرًا إيس كأخ أكبر له

261
00:20:50,480 --> 00:20:55,600
.وهو الابن الفعليّ للثّوريّ دراغون

262
00:20:55,940 --> 00:20:57,820
!الثّوريّ دراغون؟

263
00:20:57,820 --> 00:21:00,020
!أسوأ مجرم في التّاريخ؟

264
00:21:00,020 --> 00:21:02,950
!يبدو ذلك مألوفًا للغاية

265
00:21:02,950 --> 00:21:04,860
!إنّ والده شخص مهمّ للغاية

266
00:21:04,860 --> 00:21:06,700
!لقد كشف الأمر

267
00:21:06,700 --> 00:21:08,090
...لوفي-سان

268
00:21:09,990 --> 00:21:11,580
...لوفي

269
00:21:11,580 --> 00:21:14,620
!ما كنت لأهتمّ حتّى إن كنت ابن الشّيطان بعينه

270
00:21:18,330 --> 00:21:19,710
!لم أكن أعرف ذلك

271
00:21:20,520 --> 00:21:22,040
!هكذا إذًا

272
00:21:22,040 --> 00:21:23,590
!أيّها الوغد

273
00:21:23,590 --> 00:21:26,680
!فاكهة المطّاط: المسدّس

274
00:21:36,560 --> 00:21:39,560
!فهمت أخيرًا ما الّذي حدث في لوغتاون

275
00:21:40,260 --> 00:21:42,860
.لهذا السّبب أنقذ دراغون لوفي

276
00:21:42,860 --> 00:21:44,570
أسمعتم ذلك؟

277
00:21:46,030 --> 00:21:48,280
!يقصدون دراغون ذاك؟

278
00:21:48,280 --> 00:21:52,700
!إلى المكتب الرّئيسيّ! أنا أتّصل من شابوندي
!اكتشفنا أخبارًا مهمّة

279
00:21:52,700 --> 00:21:54,910
!انشروا هذا في كلّ أرجاء العالم

280
00:21:56,160 --> 00:21:58,080
!لا يجب أن نسمح له بالعيش

281
00:21:59,220 --> 00:22:00,880
!اقتلوه مهما كلّف الأمر

282
00:22:02,300 --> 00:22:06,050
.من يهتمّ؟ لا حاجة لإخفاء الأمر على أيّ حال

283
00:22:06,050 --> 00:22:10,680
لن تؤذيه تلك التّسمية لأنّ سمعة
.لوفي كخارج عن القانون سيّئة سلفًا

284
00:22:12,560 --> 00:22:15,430
.يا لحُمقكما أيّها الأخوان

285
00:22:16,130 --> 00:22:17,440
!المستوى الثّالث

286
00:22:25,360 --> 00:22:27,530
...فاكهة المطّاط

287
00:22:28,070 --> 00:22:29,820
...البندقيّة

288
00:22:30,240 --> 00:22:33,950
!العملاقة

289
00:22:41,080 --> 00:22:43,670
!إيس

290
00:22:45,710 --> 00:22:48,720
!بإمكانك قول ما تشاء

291
00:22:48,720 --> 00:22:52,850
!سأنقذك وإن عنى ذلك موتي

292
00:22:52,850 --> 00:22:54,390
!ذلك الشّقيّ

293
00:22:54,390 --> 00:22:56,390
!نتشارك جميعًا ذلك الشّعور

294
00:22:56,390 --> 00:22:58,900
!نحن عائلة إيس أيضًا

295
00:22:58,900 --> 00:23:00,350
!سننقذه مهما كلّف الأمر

296
00:23:02,360 --> 00:23:05,820
.ماركو، لا يجب السّماح بموت ذلك الفتى

297
00:23:05,820 --> 00:23:07,110
.عُلم

298
00:23:14,490 --> 00:23:16,140
!لوفي

299
00:23:25,510 --> 00:23:28,660
.يواصل لوفي وقراصنة اللّحية البيضاء التّقدّم إلى الأمام

300
00:23:28,660 --> 00:23:32,140
بينما يشاهد إيس أصدقاءه
،يواجهون أعداءً بقوّة هائلة

301
00:23:32,140 --> 00:23:35,300
.يتّخذ قرارًا

302
00:23:35,300 --> 00:23:38,930
.في تلك الأثناء، تضع البحريّة خطّة جديدة

303
00:23:38,930 --> 00:23:40,480
:في الحلقة القادمة من وان بيس

304
00:23:40,480 --> 00:23:44,680
!معارك صعبة الواحدة تلو الأخرى"
"!آكلو فاكهة الشّيطان ضدّ آكلي فاكهة الشّيطان

305
00:23:44,680 --> 00:23:47,180
!ملك القراصنة، لن يكون إلاّ أنا

306
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة