1
00:00:26,430 --> 00:00:31,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,520 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,190 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:45,030 --> 00:00:47,790
"وأقول "أريد أن أصير أقوى

5
00:00:47,950 --> 00:00:53,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,370 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,510 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,090 --> 00:01:09,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,810
هيّا بنا

10
00:01:11,890 --> 00:01:15,110
دون توقّف

11
00:01:15,230 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,490 --> 00:01:25,910
سأواصل النّهوض على قدميّ

13
00:01:26,030 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,540 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,880 --> 00:01:42,010
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,390 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,390 --> 00:01:55,400
أوه

19
00:01:55,520 --> 00:01:57,690
هيّا بنا

20
00:01:57,810 --> 00:02:00,980
دون توقّف

21
00:02:01,110 --> 00:02:06,160
دون استسلام لمرور الوقت

22
00:02:06,280 --> 00:02:11,830
سأواصل النّهوض على قدميّ

23
00:02:12,000 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,590 --> 00:02:25,680
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,520 --> 00:03:23,150
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:23,150 --> 00:03:26,740
اندفع لإنقاذ أخيه إيس الّذي يوشك أن يُعدم

39
00:03:26,740 --> 00:03:32,530
في مارينفورد حيث نشبت معركة بين
!قراصنة اللّحية البيضاء والبحريّة

40
00:03:32,950 --> 00:03:34,950
!انتباه لكلّ السّفن والجنود

41
00:03:34,950 --> 00:03:37,250
...عندما تجهزون جميعًا، سنسرّع جدولنا

42
00:03:37,750 --> 00:03:40,490
.وسنعدم إيس في الحال. هذا كلّ شيء

43
00:03:42,790 --> 00:03:44,250
...لوفي-كُن

44
00:03:44,250 --> 00:03:45,340
!لننطلق

45
00:03:48,050 --> 00:03:50,130
!هيّا بنا

46
00:03:52,790 --> 00:03:53,850
!مـ-مهلاً

47
00:03:55,180 --> 00:03:57,680
!كلاّ! ذلك ليس الجانب الصّحيح

48
00:04:17,250 --> 00:04:26,500
!إيس

49
00:04:27,670 --> 00:04:29,510
!...مـ-مهلاً، أيعقل أنّه

50
00:04:29,510 --> 00:04:31,220
!كروكودايل

51
00:04:31,220 --> 00:04:34,350
!إنّه ليس وحده! من معه أيضًا؟

52
00:04:34,350 --> 00:04:38,220
!كلّ القوّات هنا من كِلا الجانبين
!ثمّة الكثير من الأسماء الكبيرة

53
00:04:39,350 --> 00:04:41,800
!على العالم أن يستعدّ لهذا

54
00:04:42,310 --> 00:04:45,060
!إيس، أتينا لإنقاذك

55
00:04:45,060 --> 00:04:47,740
!نحن هنا لأجلك

56
00:04:48,690 --> 00:04:51,900
!غارب! إنّها عائلتك ثانية

57
00:04:52,160 --> 00:04:53,820
!لوفي

58
00:04:54,160 --> 00:05:00,370
.حفيد البطل غارب وابن الثّوريّ دراغون

59
00:05:02,170 --> 00:05:05,670
!سأتولّى أمره للأبد

60
00:05:07,250 --> 00:05:08,760
أين الفتى كروكو؟

61
00:05:08,760 --> 00:05:12,930
...ماذا؟ أعتقد أنّ جبُن و

62
00:05:12,930 --> 00:05:14,640
!ها هو هناك

63
00:05:15,970 --> 00:05:18,270
!لقد سبقني

64
00:05:19,100 --> 00:05:22,100
.لم أرك منذ مدّة أيّها اللّحية البيضاء

65
00:05:22,100 --> 00:05:24,560
.أنت لا تتعلّم أبدًا

66
00:05:37,490 --> 00:05:43,250
.بما أنّنا وصلنا إلى هنا، فقد انتهى اتّفاقنا

67
00:05:43,250 --> 00:05:45,830
!لماذا تريد حماية اللّحية البيضاء؟

68
00:05:45,830 --> 00:05:48,630
.كما توقّعت، هذا العجوز هو اللّحية البيضاء

69
00:05:48,630 --> 00:05:53,170
!دعه وشأنه إذًا! يحبّ إيس هذا العجوز

70
00:05:53,170 --> 00:05:56,590
.أخو إيس مقاتل ممتاز

71
00:05:56,590 --> 00:05:59,310
أتيتَ لتنقذ أخاك الكبير؟

72
00:05:59,310 --> 00:06:00,260
.صحيح

73
00:06:00,630 --> 00:06:03,810
!أتعرف مع من تعبث؟

74
00:06:08,020 --> 00:06:12,040
!سينتهي المطاف بشقيّ مثلك جثّة هادمة

75
00:06:14,070 --> 00:06:17,820
!اخرس! ذلك ليس شيئًا تقرّره أنت

76
00:06:18,370 --> 00:06:20,280
!أعرف ما هدفك

77
00:06:20,280 --> 00:06:23,580
!تريد أن تصير ملك القراصنة، صحيح؟

78
00:06:24,240 --> 00:06:28,040
!ملك القراصنة، لن يكون إلاّ أنا

79
00:06:39,300 --> 00:06:41,600
!يا لك من وقح

80
00:06:42,720 --> 00:06:46,520
لن أسامحك إن تسبّبت لي بالمشاكل
!أيّها الشّقيّ المدلّل

81
00:06:46,520 --> 00:06:49,060
!سأقوم بما يحلو لي

82
00:06:51,070 --> 00:06:53,290
!سأنقذ إيس

83
00:06:57,200 --> 00:07:01,920
!وإن عنى ذلك الموت"
"!بداية معركة لوفي ضدّ البحريّة

84
00:07:07,790 --> 00:07:12,170
!إنّه... النّاشئ قبّعة القشّ

85
00:07:12,550 --> 00:07:14,840
كيف يعرف اللّحية البيضاء؟

86
00:07:15,210 --> 00:07:16,920
!لا أفهم

87
00:07:16,920 --> 00:07:20,760
!كان عليه الاختباء بعد الهرب من السّجن العظيم

88
00:07:20,760 --> 00:07:24,330
!لماذا تكبّد عناء المجيء لهذا الجحيم؟

89
00:07:24,850 --> 00:07:26,640
.لأنّه لوفي-سان

90
00:07:27,730 --> 00:07:29,940
!هكذا هي طبيعته

91
00:07:33,070 --> 00:07:35,820
!والدي! لوفي

92
00:07:36,900 --> 00:07:40,200
.هذا هو قبّعة القشّ

93
00:07:42,740 --> 00:07:43,740
.أيّها العجوز

94
00:07:44,950 --> 00:07:48,160
...سمعتُ بينما كنتُ على سفينة البحريّة

95
00:07:48,160 --> 00:07:49,660
!يا له من مغفّل

96
00:07:49,660 --> 00:07:52,790
!أتمنّى أن يوسَع ضربًا فحسب! غبيّ

97
00:07:52,790 --> 00:07:56,460
.يا لشجاعته! وحده ابنه قادر على هذا

98
00:07:57,070 --> 00:08:00,430
إذًا فسيقومون بإعدام إيس في الحال؟

99
00:08:00,430 --> 00:08:02,680
هل أنت واثق؟

100
00:08:02,680 --> 00:08:06,020
قالوا أنّهم سيشرعون في ذلك
...بعد تجهيز شيء ما

101
00:08:06,020 --> 00:08:08,440
لكنّهم كانوا يستعملون شيفرة ما
.لذلك لم أتمكّن من فهم الأمر

102
00:08:09,600 --> 00:08:13,190
،أعلم أنّك تريد إنقاذ إيس أيضًا
!لذلك أردت تشارك ذلك معك

103
00:08:14,070 --> 00:08:18,070
.فهمت. كانت تلك معلومة مهمّة

104
00:08:18,070 --> 00:08:19,700
.شكرًا لك

105
00:08:19,700 --> 00:08:21,700
.لا داعي للشّكر

106
00:08:22,410 --> 00:08:26,160
كيف يستطيع الكلام مع اللّحية البيضاء
!وكأنّهما على قدم المساواة؟

107
00:08:26,500 --> 00:08:30,560
!حسنًا! إيس، أنا قادم

108
00:08:32,790 --> 00:08:34,290
من أين له كلّ هذه الثّقة؟

109
00:08:38,460 --> 00:08:40,380
...فاكهة المطّاط

110
00:08:40,380 --> 00:08:42,890
!البازوكا

111
00:08:43,250 --> 00:08:45,890
!ابتعدوا عن طريقي

112
00:08:45,890 --> 00:08:48,980
.إنّه أخو إيس إذًا

113
00:08:48,980 --> 00:08:52,900
!احذوا حذو الفتى! هيّا بنا أيّتها الوحدة الثّالثة

114
00:08:54,360 --> 00:08:56,360
!علينا الذّهاب أيضًا

115
00:08:56,360 --> 00:08:57,690
!ما-ماذا؟

116
00:08:59,690 --> 00:09:01,650
!فعلاً؟

117
00:09:03,530 --> 00:09:06,830
!أيّتها الوحدة الرّابعة عشر، لنتقدّم للأمام

118
00:09:06,830 --> 00:09:08,290
!حاضر أيّها القائد جيل

119
00:09:12,120 --> 00:09:13,210
...لوفي

120
00:09:14,170 --> 00:09:19,260
تشجّعوا لهذا الحدّ بسبب متهوّر واحد؟

121
00:09:19,260 --> 00:09:21,630
.لكنّ استراتيجيّتنا مُحكمة

122
00:09:22,220 --> 00:09:25,760
!لا تتردّدوا! افعلوا ما أقول

123
00:09:27,080 --> 00:09:28,950
!تبًّا لسنغوكو ذاك

124
00:09:28,950 --> 00:09:34,230
أراهن أنّه يعتقد أنّه لا يحتاج
.لاحترام موعد إعدام مجرّد قرصان

125
00:09:34,230 --> 00:09:37,690
المفتاح هو... ما الّذي سيتجهّزون له؟

126
00:09:40,280 --> 00:09:45,570
يا والدي! سمعتُ أنّهم سيعجّلون
!في موعد إعدام إيس

127
00:09:45,570 --> 00:09:49,290
سمعت ذلك. ما وضع سكوارد والبقيّة؟

128
00:09:49,810 --> 00:09:55,210
إنّهم مشغولون مع بعض نوّاب الأميرالات
...في رأس الخليج. سأطير إليهم للمساعدة

129
00:09:55,210 --> 00:09:57,120
.لا، انتظر

130
00:09:57,790 --> 00:10:03,170
أراهن أنّ تسرّب بعض المعلومات والتّقدّم
.على أساسها كان جزءًا من خطّته

131
00:10:04,440 --> 00:10:10,690
ما كان سنغوكو ليسمح للعدوّ بمعرفة
.استراتيجيّته بسهولة

132
00:10:10,690 --> 00:10:12,850
.ليس رجلاً بتلك الحماقة

133
00:10:12,850 --> 00:10:14,560
!واصلوا

134
00:10:18,310 --> 00:10:20,360
!ركلة بسرعة الضّوء؟

135
00:10:22,940 --> 00:10:28,950
.لا تخاطروا كثيرًا. لن أسمح لكم بغزونا بسهولة

136
00:10:28,950 --> 00:10:30,620
!إنّها الأميرال كيزارو

137
00:10:33,250 --> 00:10:35,580
!أنت الّذي التقيناه في شابوندي

138
00:10:35,580 --> 00:10:41,090
نعم، كنتُ سأقضي عليك هناك
.لأنّ التّنانين السّماويّين أرادوا ذلك

139
00:10:41,600 --> 00:10:43,300
.قبّعة القشّ لوفي

140
00:10:45,340 --> 00:10:48,590
!قـ-قبّعة القشّ لوفي في عداد الموتى

141
00:10:48,590 --> 00:10:50,260
...غمزة

142
00:10:50,260 --> 00:10:52,390
!الموت

143
00:11:00,400 --> 00:11:03,150
!كلاّ! أريد الذّهاب للمنزل

144
00:11:03,150 --> 00:11:05,990
!ماذا أيّها القبطان باغي؟

145
00:11:05,990 --> 00:11:07,820
!لا أصدّق ما قلته للتّوّ؟

146
00:11:09,200 --> 00:11:14,790
تقصد أنّك تريد تدمير كيزارو بسرعة
!لتتمكّن من العودة للمنزل

147
00:11:14,790 --> 00:11:19,210
وحده قرصان أسطوريّ بإمكانه مواجهة
!الأميرال كيزارو دون خوف

148
00:11:20,290 --> 00:11:22,590
!إنّكم إيجابيّون للغاية

149
00:11:22,590 --> 00:11:24,880
هل أنت بخير يا فتى قبّعة القشّ؟

150
00:11:24,880 --> 00:11:27,340
!كان ذلك وشيكًا! شكرًا لك يا إيفان-تشان

151
00:11:27,660 --> 00:11:32,430
!مهمّتي الوحيدة هي إنقاذك

152
00:11:33,280 --> 00:11:34,520
!كيزارو ثانية

153
00:11:35,010 --> 00:11:38,190
...ماذا؟ لا، ليس هو! هذا

154
00:11:38,190 --> 00:11:39,020
!كوما

155
00:11:39,020 --> 00:11:43,520
!إنّه الشّبيه بالدّبّ الّذي فرّقنا جميعًا

156
00:11:45,760 --> 00:11:48,610
!التّدحرج التّجميليّ

157
00:11:54,160 --> 00:11:55,620
!بارثولوميو كوما

158
00:11:55,620 --> 00:11:57,320
!كم هذا فظيع

159
00:11:57,320 --> 00:12:00,580
...أعلم أنّك لك دورًا كشيتشيبوكاي، لكن

160
00:12:00,580 --> 00:12:05,250
.إنّنا نعرف بعضنا منذ مدّة
!كيف استطعت إطلاق ليزر عليّ؟

161
00:12:05,250 --> 00:12:07,010
...أنت، كيف

162
00:12:10,590 --> 00:12:12,220
!ثقب

163
00:12:13,260 --> 00:12:14,470
!إيفان-تشان

164
00:12:14,470 --> 00:12:17,350
!لا تقلق حيالي

165
00:12:17,350 --> 00:12:20,640
!دع هذا الأمر لي وتقدّم أنت

166
00:12:20,640 --> 00:12:21,900
!مفهوم

167
00:12:23,040 --> 00:12:25,230
!لنقم بهذا

168
00:12:46,920 --> 00:12:51,050
!إنّ حظّك عاثر لأنّك التقيت بنا

169
00:12:51,050 --> 00:12:54,680
!يا قبّعة القشّ، ستموت ها هنا

170
00:12:54,680 --> 00:12:57,390
ماذا؟ من تكونان؟

171
00:12:58,450 --> 00:13:00,640
!أنا فولبودي

172
00:13:00,640 --> 00:13:04,100
!عليك دفع ثمن ما حدث في مطعم باراتيي البحريّ

173
00:13:04,530 --> 00:13:06,610
.صحيح، أوسعك سانجي ضربًا

174
00:13:07,780 --> 00:13:10,820
.لا بدّ أنّك تتذكّر هذا التشاكرام

175
00:13:11,450 --> 00:13:15,370
أنت المنوّم المغناطيسيّ من قرية
أوسوبّ. لماذا أنت هنا؟

176
00:13:16,620 --> 00:13:20,720
.صقلت مهاراتي في البحريّة

177
00:13:21,420 --> 00:13:23,620
.وباثنين من التشاكرام، سيتضاعف التّأثير

178
00:13:23,620 --> 00:13:27,290
،"عندما أقول "واحد، اثنان، جانغو
.ستشعر بالتّعب

179
00:13:27,290 --> 00:13:29,750
...واحد، اثنان

180
00:13:30,210 --> 00:13:31,880
!جانغو

181
00:13:39,800 --> 00:13:41,760
ما الّذي تفعلانه؟

182
00:13:45,020 --> 00:13:46,360
.خاب ظنّ هينا

183
00:13:46,620 --> 00:13:49,540
!كنتِ في ألاباستا، صحيح؟

184
00:13:49,540 --> 00:13:52,650
!لا وقت لديّ للّعب معكم الآن

185
00:13:52,650 --> 00:13:53,780
!لن أسمح لك بالفرار

186
00:13:53,780 --> 00:13:55,680
!قفص كُمّ الكيمونو

187
00:13:59,620 --> 00:14:04,080
!أستطيع تقييم كلّ من يمرّون خلالي

188
00:14:04,080 --> 00:14:06,290
!إنّها جملته المفضّلة

189
00:14:06,290 --> 00:14:08,380
!الآنسة هينا آسرة للغاية

190
00:14:08,840 --> 00:14:10,800
!سئمت تواجدي خلف القضبان

191
00:14:10,800 --> 00:14:12,840
!المستوى الثّاني

192
00:14:18,010 --> 00:14:20,430
!كـ-كم هو سريع! لم أستطع رؤيته

193
00:14:21,520 --> 00:14:23,100
!فشلت هينا

194
00:14:23,100 --> 00:14:25,350
!فشلنا أيضًا

195
00:14:25,350 --> 00:14:29,020
!حلقنا في شباك الآنسة هينا، جسدًا وروحًا

196
00:14:35,740 --> 00:14:39,370
!لا تقاتلوا نوّاب الأميرالات وحدكم
!سيهزمونكم

197
00:14:42,400 --> 00:14:45,760
!أيّها القبطان سكوارد! الفوضى تعمّ الخليج

198
00:14:45,760 --> 00:14:46,960
!أعلم ذلك

199
00:14:47,450 --> 00:14:49,750
.عليّ الإسراع والوصول لإيس

200
00:14:51,000 --> 00:14:54,010
...الجدّار الّذي حطّمه أورز

201
00:14:54,010 --> 00:14:57,760
.إن تسلّلت من هنا، ربّما أستطيع أن أفوقهم دهاءً

202
00:15:07,900 --> 00:15:09,890
!...أنت

203
00:15:26,120 --> 00:15:27,870
!توقّف

204
00:15:37,340 --> 00:15:38,630
...فاكهة المطّاط

205
00:15:38,630 --> 00:15:40,280
!السّوط

206
00:15:47,600 --> 00:15:49,600
!جميعهم أقوياء

207
00:16:02,700 --> 00:16:07,080
!قبّعة القشّ! إنّ روحه عالية كالعادة

208
00:16:07,080 --> 00:16:12,790
!صحيح! سأقصّ ظلّه وأزرعه في أورز ثانية

209
00:16:16,130 --> 00:16:18,720
!تعالوا يا جنود الزّومبي

210
00:16:27,560 --> 00:16:33,560
!حسنًا يا جنود الزّومبي
!انطلقوا وأمسكوا بقبّعة القشّ

211
00:16:34,200 --> 00:16:37,070
!موريا! لا أريد التّعامل معه الآن

212
00:16:53,300 --> 00:16:54,980
!استعيدوا رصاصكم

213
00:17:00,090 --> 00:17:01,590
!أعدادهم تزيد

214
00:17:01,930 --> 00:17:08,220
،نعم، لأنّنا في ساحة معركة
!وتوفّر لي كلّ هذه الجثث زومبي جدد

215
00:17:08,600 --> 00:17:10,100
!أمسكوا بقبّعة القشّ

216
00:17:10,100 --> 00:17:12,100
!إنّه المشتبه به الرّئيسيّ في عمليّة الهروب

217
00:17:12,440 --> 00:17:14,520
!واصلوا

218
00:17:15,380 --> 00:17:17,900
!عليه مقاتلة كلّ هؤلاء الضّبّاط

219
00:17:18,560 --> 00:17:21,280
!أتساءل إلى متى يمكنه المواصلة

220
00:17:24,140 --> 00:17:25,370
!لوفي

221
00:17:45,470 --> 00:17:48,110
!ارحل يا لوفي

222
00:18:03,230 --> 00:18:05,780
!أعلم أنّك تعلم

223
00:18:06,200 --> 00:18:08,370
!كلانا قرصان

224
00:18:08,790 --> 00:18:11,410
!دخل كِلانا غمار البحر كما رغبنا

225
00:18:11,750 --> 00:18:14,670
!لديّ مغامرتي الخاصّة

226
00:18:15,420 --> 00:18:18,150
!لديّ أصدقائي

227
00:18:19,650 --> 00:18:20,670
!إيس

228
00:18:21,000 --> 00:18:22,260
...أريدك

229
00:18:22,260 --> 00:18:25,130
!ألاّ تقترب منهم

230
00:18:25,720 --> 00:18:28,800
!يريد ضعيف مثلك أن ينقذني؟

231
00:18:28,800 --> 00:18:29,830
!ابتعد عن طريقي

232
00:18:29,830 --> 00:18:33,140
!أتظنّ أنّني سأسمح لك بذلك؟

233
00:18:33,480 --> 00:18:35,310
!هذا مهين للغاية

234
00:18:35,840 --> 00:18:39,270
!ارجع يا لوفي! لماذا أتيت إلى هنا؟

235
00:18:41,630 --> 00:18:46,730
أتوسّل إليك يا لوفي
!لا أريدك أن تشاركني قدري

236
00:18:48,280 --> 00:18:51,640
!كلّ هذا خطئي أنا

237
00:18:53,620 --> 00:18:55,290
...أنا

238
00:18:55,760 --> 00:18:58,210
!أخوك الصّغير

239
00:19:04,640 --> 00:19:05,880
أتعلم؟

240
00:19:06,530 --> 00:19:09,960
!بإمكاننا أن نصير إخوة إن تقاسمنا كأس ساكي

241
00:19:12,140 --> 00:19:15,370
!من الآن فصاعدًا، نحن إخوة

242
00:19:23,400 --> 00:19:26,110
"هل قال للتّوّ "أنا أخوك الصّغير؟

243
00:19:26,110 --> 00:19:27,700
إنّه ابن روجر أيضًا؟

244
00:19:28,040 --> 00:19:32,580
.عندما وُلد إيس، مات كِلا والديه
!هذا مستحيل

245
00:19:33,820 --> 00:19:35,660
...لا أهتمّ إطلاقًا

246
00:19:36,640 --> 00:19:38,330
!لقوانين القراصنة

247
00:19:38,330 --> 00:19:40,100
!أيّها المغفّل

248
00:19:43,240 --> 00:19:46,260
!هيّا يا جنودي الزّومبي

249
00:19:54,700 --> 00:19:56,230
!مـ-ماء بحر؟

250
00:19:59,020 --> 00:20:00,410
!جينبي

251
00:20:00,410 --> 00:20:04,940
،إن أسعفتني الذّاكرة يا موريا
.فجنودك الزّومبي لا يتحمّلون الملح

252
00:20:06,360 --> 00:20:09,280
!لوفي-كُن، دعني أتولّى أمرهم

253
00:20:09,280 --> 00:20:09,700
!ممتاز

254
00:20:10,030 --> 00:20:11,740
!فارس البحر جينبي

255
00:20:11,740 --> 00:20:13,160
.شيتشيبوكاي سابق

256
00:20:13,160 --> 00:20:18,120
ما الّذي تفعلونه؟! لا تسمحوا لهذا
!النّاشئ بالسّيطرة على الحرب

257
00:20:18,120 --> 00:20:20,540
!ابتعدوا عن الطّريق

258
00:20:20,540 --> 00:20:22,990
!سأسحقه

259
00:20:28,840 --> 00:20:32,140
!هذا الرّجل خطر على المستقبل أيضًا

260
00:20:32,590 --> 00:20:36,480
لقد كبُر معتبرًا إيس كأخ أكبر له

261
00:20:36,480 --> 00:20:41,600
.وهو الابن الفعليّ للثّوريّ دراغون

262
00:20:41,940 --> 00:20:43,820
!الثّوريّ دراغون؟

263
00:20:43,820 --> 00:20:46,020
!أسوأ مجرم في التّاريخ؟

264
00:20:46,020 --> 00:20:48,950
!يبدو ذلك مألوفًا للغاية

265
00:20:48,950 --> 00:20:50,860
!إنّ والده شخص مهمّ للغاية

266
00:20:50,860 --> 00:20:52,700
!لقد كشف الأمر

267
00:20:52,700 --> 00:20:54,090
...لوفي-سان

268
00:20:55,990 --> 00:20:57,580
...لوفي

269
00:20:57,580 --> 00:21:00,620
!ما كنت لأهتمّ حتّى إن كنت ابن الشّيطان بعينه

270
00:21:04,330 --> 00:21:05,710
!لم أكن أعرف ذلك

271
00:21:06,520 --> 00:21:08,040
!هكذا إذًا

272
00:21:08,040 --> 00:21:09,590
!أيّها الوغد

273
00:21:09,590 --> 00:21:12,680
!فاكهة المطّاط: المسدّس

274
00:21:22,560 --> 00:21:25,560
!فهمت أخيرًا ما الّذي حدث في لوغتاون

275
00:21:26,260 --> 00:21:28,860
.لهذا السّبب أنقذ دراغون لوفي

276
00:21:28,860 --> 00:21:30,570
أسمعتم ذلك؟

277
00:21:32,030 --> 00:21:34,280
!يقصدون دراغون ذاك؟

278
00:21:34,280 --> 00:21:38,700
!إلى المكتب الرّئيسيّ! أنا أتّصل من شابوندي
!اكتشفنا أخبارًا مهمّة

279
00:21:38,700 --> 00:21:40,910
!انشروا هذا في كلّ أرجاء العالم

280
00:21:42,160 --> 00:21:44,080
!لا يجب أن نسمح له بالعيش

281
00:21:45,220 --> 00:21:46,880
!اقتلوه مهما كلّف الأمر

282
00:21:48,300 --> 00:21:52,050
.من يهتمّ؟ لا حاجة لإخفاء الأمر على أيّ حال

283
00:21:52,050 --> 00:21:56,680
لن تؤذيه تلك التّسمية لأنّ سمعة
.لوفي كخارج عن القانون سيّئة سلفًا

284
00:21:58,560 --> 00:22:01,430
.يا لحُمقكما أيّها الأخوان

285
00:22:02,130 --> 00:22:03,440
!المستوى الثّالث

286
00:22:11,360 --> 00:22:13,530
...فاكهة المطّاط

287
00:22:14,070 --> 00:22:15,820
...البندقيّة

288
00:22:16,240 --> 00:22:19,950
!العملاقة

289
00:22:27,080 --> 00:22:29,670
!إيس

290
00:22:31,710 --> 00:22:34,720
!بإمكانك قول ما تشاء

291
00:22:34,720 --> 00:22:38,850
!سأنقذك وإن عنى ذلك موتي

292
00:22:38,850 --> 00:22:40,390
!ذلك الشّقيّ

293
00:22:40,390 --> 00:22:42,390
!نتشارك جميعًا ذلك الشّعور

294
00:22:42,390 --> 00:22:44,900
!نحن عائلة إيس أيضًا

295
00:22:44,900 --> 00:22:46,350
!سننقذه مهما كلّف الأمر

296
00:22:48,360 --> 00:22:51,820
.ماركو، لا يجب السّماح بموت ذلك الفتى

297
00:22:51,820 --> 00:22:53,110
.عُلم

298
00:23:00,490 --> 00:23:02,140
!لوفي

299
00:23:11,510 --> 00:23:14,660
.يواصل لوفي وقراصنة اللّحية البيضاء التّقدّم إلى الأمام

300
00:23:14,660 --> 00:23:18,140
بينما يشاهد إيس أصدقاءه
،يواجهون أعداءً بقوّة هائلة

301
00:23:18,140 --> 00:23:21,300
.يتّخذ قرارًا

302
00:23:21,300 --> 00:23:24,930
.في تلك الأثناء، تضع البحريّة خطّة جديدة

303
00:23:24,930 --> 00:23:26,480
:في الحلقة القادمة من وان بيس

304
00:23:26,480 --> 00:23:30,680
!معارك صعبة الواحدة تلو الأخرى"
"!آكلو فاكهة الشّيطان ضدّ آكلي فاكهة الشّيطان

305
00:23:30,680 --> 00:23:33,180
!ملك القراصنة، لن يكون إلاّ أنا

306
00:23:35,990 --> 00:23:40,990
!!نلقاكم في الحلقة القادمة