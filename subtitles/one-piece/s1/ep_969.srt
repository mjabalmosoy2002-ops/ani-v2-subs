1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,960 --> 00:02:00,980
،انضمّ أودن لقراصنة روجر

29
00:02:07,870 --> 00:02:10,240
،وبإرشاد من البونيغليف

30
00:02:10,240 --> 00:02:14,870
!وصل غول د. روجر أخيرًا إلى الجزيرة الأخيرة

31
00:02:16,980 --> 00:02:22,630
!أثنى النّاس بسخاء على إنجاز روجر

32
00:02:25,990 --> 00:02:30,560
"!إلى بلاد وانو! حلّ قراصنة روجر"

33
00:03:14,620 --> 00:03:18,390
يا أودن. ما رأيك بالجزيرة الأخيرة؟

34
00:03:20,310 --> 00:03:22,400
!كانت جزيرة عظيمة

35
00:03:22,400 --> 00:03:26,360
!ما زال جسدي يرتعش حماسًا

36
00:03:27,640 --> 00:03:28,780
!يراودني نفس الإحساس

37
00:03:30,240 --> 00:03:32,840
!يا روجر

38
00:03:34,020 --> 00:03:36,410
...ريلي، أنت هنا

39
00:03:38,270 --> 00:03:39,290
...روجر

40
00:03:41,250 --> 00:03:45,670
أتذكر ما قلته لي عند أوّل لقاء لنا؟

41
00:03:48,550 --> 00:03:51,390
...نعم، أتذكّر

42
00:03:55,640 --> 00:03:58,960
سنقلب العالم رأسًا على عقب"، صحيح؟"

43
00:03:58,960 --> 00:04:01,940
."قلتَ أيضًا، "إنّ لقاءنا كان مقدّرًا

44
00:04:08,990 --> 00:04:11,530
هل وفيت بالوعد؟

45
00:04:13,410 --> 00:04:14,490
!نعم

46
00:04:58,490 --> 00:04:59,700
!با-باغي

47
00:04:59,700 --> 00:05:02,580
!...إنّ القبطان...! إنّ القبطان روجر

48
00:05:10,670 --> 00:05:13,090
!لقد عادوا

49
00:05:14,010 --> 00:05:16,400
!عادوا بكلّ بهرجة

50
00:05:17,500 --> 00:05:20,730
!القبطان

51
00:05:42,040 --> 00:05:47,420
سأل أحمرتارو روجر الّذي عاد
،من لافتيل عن شيء ما

52
00:05:47,420 --> 00:05:49,960
...ثمّ أجهش بالبكاء

53
00:05:58,620 --> 00:06:02,520
،جنّ جنون العالم بولادة ملك القراصنة

54
00:06:02,520 --> 00:06:06,150
.وبدأت البحريّة بالتّحرّك بعدوانيّة

55
00:06:07,420 --> 00:06:10,730
...الثّروة والشّهرة والسّلطة"

56
00:06:10,730 --> 00:06:13,280
،الرّجل الّذي نال كلّ شيء في العالم

57
00:06:13,280 --> 00:06:16,700
"!ملك القراصنة، غولد روجر

58
00:06:18,780 --> 00:06:21,290
!إنّه غول د. روجر

59
00:06:21,600 --> 00:06:25,830
.لكنّ وصفي بملك القراصنة ليس بالأمر السّيّئ

60
00:06:25,830 --> 00:06:31,840
صرت الآن أدرك لماذا تسعى حكومة
.العالم التّستّر على اسمك هكذا

61
00:06:33,450 --> 00:06:38,050
...وصل العالم كلّ شيء اكتسبه روجر إجمالاً

62
00:06:38,330 --> 00:06:43,020
!"الكنز العظيم "وان بيس

63
00:06:43,020 --> 00:06:45,240
!إنّهم يجهلون كلّ شيء

64
00:06:46,630 --> 00:06:51,400
!لكن بسبب شهرتك، سيسعى الجميع خلفك يا روجر

65
00:06:55,360 --> 00:06:57,380
!أطيحوا بروجر

66
00:07:04,440 --> 00:07:07,100
!جدوا روجر

67
00:07:07,100 --> 00:07:09,430
!انهبوا كنزه

68
00:07:09,430 --> 00:07:12,500
!يملك غولد روجر كلّ شيء

69
00:07:28,000 --> 00:07:31,230
.بالنّظر للوراء، كان كلّ شيء كمعجزة

70
00:07:31,230 --> 00:07:35,820
لا أصدّق أنّني بلغت هذا الحدّ
.رغم عُمري المحدود

71
00:07:37,300 --> 00:07:40,200
!لا أكنّ لكم يا رفاق سوى الامتنان

72
00:07:42,700 --> 00:07:44,080
!مهلاً، مهلاً، مهلاً، مهلاً

73
00:07:44,080 --> 00:07:47,410
!لماذا تتحدّث بشكل رسميّ هكذا؟
!اللّعنة عليك أيّها القبطان

74
00:07:47,410 --> 00:07:49,360
!لا تجعلني أحمرّ خجلاً أيّها المغفّل

75
00:07:49,360 --> 00:07:51,640
!مغفّل

76
00:08:01,830 --> 00:08:03,550
!سأقولها فحسب إذًا

77
00:08:03,550 --> 00:08:06,310
!هيّا! أنا جاهز

78
00:08:16,340 --> 00:08:19,610
!تمّ حلّ قراصنة روجر

79
00:09:00,680 --> 00:09:02,810
...سيولد

80
00:09:02,810 --> 00:09:05,870
...ملكنا سيولد

81
00:09:05,870 --> 00:09:09,250
...سيولد واحد آخر في بحر بعيد

82
00:09:09,250 --> 00:09:15,250
حتّى الحيتان ستسعد لمعرفة أنّ الملكين
...سيتقابلان ثانية يومًا ما

83
00:09:18,710 --> 00:09:22,860
...كنّا في الانتظار لوقت طويل جدًّا أيضًا

84
00:09:25,910 --> 00:09:30,140
...لن يطول كثيرًا... سينجح الأمر هذه المرّة

85
00:09:30,140 --> 00:09:33,040
.عشرة سنوات حتّى الولادة

86
00:09:33,040 --> 00:09:36,110
.خمس عشرة سنة حتّى يكبران

87
00:09:39,930 --> 00:09:41,110
!من أنتم؟

88
00:09:41,470 --> 00:09:45,800
!كيف يمكنكم التّحدّث عميقًا تحت البحر؟

89
00:09:48,230 --> 00:09:52,230
يا شارلي، متى ستولد الأميرة الحوريّة؟

90
00:09:52,230 --> 00:09:53,290
!عشرة

91
00:09:57,320 --> 00:09:58,710
...ذلك الصّوت

92
00:09:59,950 --> 00:10:01,010
!الصّوت؟

93
00:10:01,490 --> 00:10:05,380
.أعتقد أنّه يقول الحقيقة. سيولد أحد ما

94
00:10:05,380 --> 00:10:09,860
...وذلك الشّخص سيتجاوزنا

95
00:10:14,670 --> 00:10:17,790
...أتينا أبكر بكثير

96
00:10:17,790 --> 00:10:21,610
.الوان بيس؟ أتساءل من سيجده

97
00:10:23,300 --> 00:10:25,920
.أعتقد أنّه سيكون ابني

98
00:10:25,920 --> 00:10:27,110
.لا ابن لك

99
00:10:27,110 --> 00:10:30,090
!سأنجب واحدًا في المستقبل

100
00:10:33,900 --> 00:10:36,540
!حسنًا! لنشرب

101
00:10:36,830 --> 00:10:41,530
!أبحروا إلى مكان حيث لا توجد بحريّة
!سأنزل أوّلاً

102
00:10:41,530 --> 00:10:44,300
!نعم

103
00:10:48,580 --> 00:10:52,680
!يا رفاق! خدوا أودن إلى موطنه

104
00:10:54,290 --> 00:10:55,400
!أكيد

105
00:10:55,420 --> 00:10:57,240
!بالطّبع

106
00:10:58,670 --> 00:11:03,570
صحيح يا أودن! أفكّر في لقاء
.اللّحية البيضاء قبل موتي

107
00:11:04,640 --> 00:11:07,490
هل تريد لإيزو أن يعود لبلاد وانو أيضًا؟

108
00:11:08,030 --> 00:11:09,510
...لا

109
00:11:10,180 --> 00:11:12,990
.صار جزءًا من طاقم تلك السّفينة

110
00:11:13,350 --> 00:11:17,440
.أخبره أن يعتني باللّحية-كيتشي-تشان

111
00:11:17,440 --> 00:11:19,980
.حسنًا، لك ذلك

112
00:11:36,630 --> 00:11:44,120
،بعد تبادل بضع كلمات مع ريلي
...أقدم الأعضاء والمعروف بملك الظّلام

113
00:11:50,390 --> 00:11:53,510
.غادر روجر السّفينة

114
00:11:54,060 --> 00:11:59,000
.تلقّى حزمة من الأدوية من طبيب السّفينة كروكس

115
00:12:00,040 --> 00:12:02,940
...كان قد بلغ المرحلة الأخيرة من مرضه

116
00:12:03,530 --> 00:12:09,020
،لكن كما هو الوداع عند كلّ رجل
.لم تُذرف دمعة واحدة

117
00:12:11,370 --> 00:12:14,030
...طاقم ملك القراصنة

118
00:12:15,120 --> 00:12:18,660
.لا يذرف الدّموع

119
00:13:01,840 --> 00:13:03,810
!ما زال هذا مذهلاً

120
00:13:05,170 --> 00:13:07,980
...سفن محطّمة لم تقوَ على دخول البلاد

121
00:13:08,630 --> 00:13:09,900
...نعم

122
00:13:10,180 --> 00:13:13,110
،إن سرت على التّيّار الخاطئ

123
00:13:13,110 --> 00:13:17,410
.فستُدمّر السّفينة دون الاقتراب حتّى من بلاد وانو

124
00:13:17,410 --> 00:13:20,290
.في الماضي، كان لسياسة العزلة هذه غاية

125
00:13:20,290 --> 00:13:26,380
!لكن علينا فتح البلاد قبل مجيء "جويبوي" يومًا ما

126
00:13:32,450 --> 00:13:33,990
!شكرًا على كلّ شيء

127
00:13:33,990 --> 00:13:35,320
!أكيد

128
00:13:36,080 --> 00:13:37,220
!اعتن بنفسك

129
00:13:37,310 --> 00:13:37,890
!نعم

130
00:13:46,520 --> 00:13:48,120
!أودن

131
00:13:48,760 --> 00:13:51,860
!ذلك الوغد! إنّه يسير مبتعدًا بكلّ بهرجة

132
00:13:54,350 --> 00:13:57,740
!مع السّلامة يا رفاق

133
00:14:00,900 --> 00:14:03,680
.أنا لا أحتضر

134
00:14:03,680 --> 00:14:07,250
.لذلك ودّعنا بعضنا مبتسمين

135
00:14:07,250 --> 00:14:10,300
!لأنّني سأراهم ثانية يومًا ما

136
00:14:28,110 --> 00:14:30,320
!أودن-سان

137
00:14:30,320 --> 00:14:32,670
!لقد افتقدتك

138
00:14:32,670 --> 00:14:34,550
!يا رفاق

139
00:14:34,550 --> 00:14:36,630
!اذهبي يا هيوري

140
00:14:38,430 --> 00:14:39,990
!توكي

141
00:14:39,990 --> 00:14:41,790
!مومونوسكي

142
00:14:41,790 --> 00:14:43,200
!هيوري

143
00:14:44,480 --> 00:14:48,920
!افتقدتكم جميعًا أيضًا

144
00:15:02,960 --> 00:15:07,450
!هيّا يا هيوري! إلى الأعلى

145
00:15:11,630 --> 00:15:14,710
!ما هذه؟

146
00:15:16,010 --> 00:15:17,700
!والدي

147
00:15:18,100 --> 00:15:20,810
!ماذا قلت للتّوّ؟

148
00:15:20,810 --> 00:15:21,580
!نعم

149
00:15:21,580 --> 00:15:24,450
!"ناديتك "والدي

150
00:15:26,270 --> 00:15:28,500
!أثرت إعجابي

151
00:15:28,500 --> 00:15:33,030
!كبرت كثيرًا يا مومونوسكي

152
00:15:33,030 --> 00:15:36,130
!نعم! آمل أنّ كلّ شيء على ما يرام بالنّسبة لك أيضًا

153
00:15:38,580 --> 00:15:41,390
!كم هذا مهذّب

154
00:15:44,000 --> 00:15:45,600
!مرحبًا بعودتك

155
00:15:47,750 --> 00:15:49,060
!أيّها الوغد

156
00:15:49,840 --> 00:15:52,360
!كيف تتصرّف بفظاظة هكذا؟

157
00:15:54,130 --> 00:15:56,990
!أتظنّ أنّك تستحقّ معاملة مهذّبة؟

158
00:16:03,520 --> 00:16:05,730
!أودن-ساما

159
00:16:05,730 --> 00:16:07,940
!أودن-ساما! عود حميد

160
00:16:07,940 --> 00:16:09,320
!أودن-ساما

161
00:16:09,320 --> 00:16:11,580
!أنا سعيد من أجلك يا أوتوكي-ساما

162
00:16:18,470 --> 00:16:21,430
!انظروا كم يحبّونني

163
00:16:21,430 --> 00:16:26,750
.لقد أهملت البلاد لوقت طويل
...ظننتُ أنّهم سينتقدونني

164
00:16:26,750 --> 00:16:30,290
!اشكر زوجتك توكي-ساما

165
00:16:30,290 --> 00:16:32,600
...إنّها امرأة مذهلة بالفعل

166
00:16:32,600 --> 00:16:38,440
عندما شفيت من مرضها، ذهبت إلى البلدة
.وساعدت المواطنين كلّ يوم

167
00:16:38,440 --> 00:16:40,990
.لم تتصرّف يومًا بتعالٍ لأنّها زوجة الدّايميو

168
00:16:40,990 --> 00:16:45,530
عملت بجدّ مع الجميع وتشاركت معهم
.قصص مغامراتك بكلّ بهجة

169
00:16:45,530 --> 00:16:50,610
!توكي-ساما وطفلاك محبوبين كثيرًا في كوري الآن

170
00:16:50,610 --> 00:16:53,960
...وقد واصلوا قول أمور لطيفة عنك

171
00:16:55,090 --> 00:17:00,590
وفي مرحلة معيّنة، كفّ الجميع عن
.إساءة الحديث عن تصرّفك الأنانيّ

172
00:17:00,590 --> 00:17:04,720
!هكذا إذًا! شكرًا لكم

173
00:17:04,720 --> 00:17:09,160
!لا شكر على واجب! إنّنا نحبّك فعلاً
!أليس كذلك أيّها الطّفلان؟

174
00:17:10,460 --> 00:17:14,000
!أنا أحسدك! أريد أن أُحبّ أيضًا

175
00:17:17,930 --> 00:17:20,320
...كيكو! عليّ إخبارك بأمر إيزو

176
00:17:21,180 --> 00:17:25,070
!أخبرني إينو-تشان ونيكو-تشان كلّ شيء
!أنا بخير ما دام هو بخير

177
00:17:25,470 --> 00:17:26,780
!حسنًا

178
00:17:26,780 --> 00:17:30,540
بالمناسبة، ما الّذي حلّ بدنجيرو وأشورا؟

179
00:17:30,540 --> 00:17:32,540
...لم أرهما قبل سنة أيضًا

180
00:17:32,940 --> 00:17:39,090
أصبح أشورا زعيم الياكوزا وقطّاع طرق
!الجبل في كوري لإحكام السّيطرة عليهم

181
00:17:39,090 --> 00:17:44,470
،ودنجيرو يجول في الأجواء
.يستعير المال ويردّه

182
00:17:45,200 --> 00:17:50,850
لا تبدو حياتهما مريحة سواء كانت
.مشاجرة قطّاع طرق أو استدانة المال

183
00:17:51,420 --> 00:17:52,390
.نعم

184
00:17:52,710 --> 00:17:57,520
.ثمّة سبب آخر لسعادة الجميع بعودتك

185
00:17:58,630 --> 00:18:00,920
.سأطلعك على القصّة من البداية

186
00:18:01,180 --> 00:18:09,620
بعد رحيلك، استطعنا إدارة كوري
.دون دايميو بمساعدة النّاس

187
00:18:09,980 --> 00:18:12,910
.هكذا إذًا، لا بدّ أنّ ذلك كان صعبًا

188
00:18:12,910 --> 00:18:14,920
على أيّ حال، كيف هو حال أبي؟

189
00:18:21,360 --> 00:18:22,610
...الشّوغن-ساما

190
00:18:22,610 --> 00:18:24,090
!فهمت

191
00:18:25,700 --> 00:18:29,050
...إذًا فلم يكن في أحسن حال

192
00:18:31,930 --> 00:18:35,440
.خسارة أنّني لم أكن إلى جانبه عندما مات

193
00:18:35,790 --> 00:18:38,900
!تكمن المشكلة في خليفة الشّوغن-ساما

194
00:18:38,900 --> 00:18:42,690
يصعب فهم الأمر، لكن نزولاً
،لطلب والدك سوكياكي-ساما

195
00:18:42,690 --> 00:18:44,820
...فإنّ أوروتشي ذاك

196
00:18:45,890 --> 00:18:48,780
!أعرني مالاً أرجوك

197
00:18:50,520 --> 00:18:53,120
.شعرتُ بالحيرة وأنا أستمع إليه

198
00:18:53,560 --> 00:18:55,960
!كان أوروتشي أشبه بالأخ الصّغير لي؟

199
00:18:55,960 --> 00:18:59,330
.أعرته المال فقط احترامًا لياسو-سان

200
00:18:59,330 --> 00:19:02,670
!لم يردّ لي ولو عملة فضّيّة واحدة

201
00:19:03,130 --> 00:19:09,320
اكتشفت أيضًا أنّ أوروتشي سليل لعشيرة كوروزومي
.الّتي تسبّبت في مشاكل كبيرة في الماضي

202
00:19:09,320 --> 00:19:15,640
يبدو أنّ كوروزومي أوروتشي يعتلي
.كرسيّ الشّوغن الآن كنائب لي

203
00:19:15,980 --> 00:19:19,190
،أنا واثق أنّك رأيتها في طريقك إلى هنا

204
00:19:19,510 --> 00:19:24,780
لكن لكلّ منطقة عدّة مصانع أسلحة
.وأشخاص يشرفون على العمالة فيها

205
00:19:24,780 --> 00:19:32,120
وقد أُجبر رجال كلّ منطقة على العمل هناك
.ويجنون أجورًا بخسة بأمر من الشّوغن

206
00:19:32,120 --> 00:19:37,080
ولماذا هذا؟! لماذا يستمع الجميع
!لشخص مثل أوروتشي؟

207
00:19:37,370 --> 00:19:41,590
هذا لأنّ قرصانًا يُدعى كايدو يدعمه

208
00:19:41,590 --> 00:19:44,030
!ولديه قوّة تعادل الوحوش

209
00:19:44,030 --> 00:19:47,010
!وبسبب ذلك، يفعل أوروتشي كلّ ما يمليه عليه

210
00:19:47,340 --> 00:19:49,590
...نعم! حاولنا مهاجمة أوروتشي

211
00:19:49,590 --> 00:19:51,510
!كلاّ يا كينييمون

212
00:19:51,510 --> 00:19:53,210
!لا تخبره

213
00:19:53,210 --> 00:19:55,720
!بل أخبرني! ما الّذي حدث؟

214
00:19:58,000 --> 00:19:58,980
!رايزو

215
00:19:59,420 --> 00:20:02,790
!خذ مومونوسكي-ساما وهيوري-ساما للغرفة الأخرى

216
00:20:03,380 --> 00:20:04,620
!عذرًا

217
00:20:07,260 --> 00:20:09,760
ما الّذي حدث؟

218
00:20:09,760 --> 00:20:13,580
...نعم، قبل حوالي نصف عام

219
00:20:13,580 --> 00:20:17,790
رفض رجل وعائلته العمل
...في أحد مصانع الأسلحة

220
00:20:19,570 --> 00:20:21,380
!فتمّ إعدامهم

221
00:20:22,750 --> 00:20:27,300
،لم نستطع تحمّل المزيد من قساوة أوروتشي

222
00:20:27,300 --> 00:20:33,050
فتقدّمنا نحو معقل أوروتشي في عاصمة الزّهور
...والغضب يعترينا والسّيوف في أيدينا

223
00:20:34,410 --> 00:20:38,980
لكنّهم مكروا لنا وأتى أتباع كايدو
!إلى كوري في نفس الوقت

224
00:20:40,100 --> 00:20:42,750
...لقد غزوا القلعة

225
00:20:44,670 --> 00:20:50,860
وسمحنا لهم بمهاجمة مومونوسكي-ساما
!الّذي هو الوريث التّالي بعدك يا أودن-ساما

226
00:20:57,810 --> 00:20:58,830
...وفي النّهاية

227
00:21:01,060 --> 00:21:07,130
تمّت هزيمة الأعداء على يد كاواماتسو
...وإينواراشي اللّذان بقيا لحراسة القلعة

228
00:21:11,990 --> 00:21:15,930
...لكنّ من أنقذه من أوّل هجوم سهام لهم

229
00:21:17,920 --> 00:21:21,990
!كانت توكي-ساما الّتي حمته بجسدها

230
00:21:22,850 --> 00:21:25,310
!أنا آسف كلّ الأسف

231
00:21:25,310 --> 00:21:29,650
تكبّدت توكي-ساما إصابة بليغة
!في ساقها بسبب فعلنا الطّائش

232
00:21:29,650 --> 00:21:33,360
!وضعنا أرواح أفراد عائلتك في خطر

233
00:21:33,360 --> 00:21:38,290
!أنا آسف كلّ الأسف

234
00:21:38,480 --> 00:21:40,300
.دعيني أرى يا توكي

235
00:21:40,300 --> 00:21:44,020
!لا تقلق يا أودن-سان! لقد سبق وشفيت

236
00:21:51,160 --> 00:21:55,110
!شكرًا على حمايتك لطفلنا

237
00:21:56,950 --> 00:21:58,510
!لا بدّ أنّ ذلك آلمك

238
00:22:00,710 --> 00:22:05,600
تمهّل يا أودن-سان! إن فقدت أعصابك
!بسبب أمر هيّن كهذا، سنُهاجَم ثانية

239
00:22:06,420 --> 00:22:08,830
...أ... أ

240
00:22:09,420 --> 00:22:12,240
!أمر هيّن؟

241
00:22:14,050 --> 00:22:15,860
...توكي، إنّك

242
00:22:15,860 --> 00:22:20,680
لم تسمعي القصص عن ماضيّ، صحيح؟

243
00:22:22,060 --> 00:22:23,690
قصص عن ماضيك؟

244
00:22:23,690 --> 00:22:29,880
حسنًا، مذ أن كان طفلاً، كان أودن-ساما معروفًا
.بالشّرب والقتال، وانتهى به المطاف مُعتقلاً

245
00:22:30,150 --> 00:22:34,510
كان شخصًا عنيفًا خشيه جميع
...من في عاصمة الزّهور

246
00:22:39,000 --> 00:22:42,350
!أنا أفهم كيف يقوم أوروتشي بأعماله

247
00:22:42,750 --> 00:22:47,040
!يا رفاق! احموا عائلتي

248
00:22:48,260 --> 00:22:49,440
!أودن-سان

249
00:22:52,630 --> 00:22:55,780
!احموا كوري

250
00:23:04,520 --> 00:23:08,170
لا يستطيع أودن مسامحة أفعال أوروتشي
!الشّرّيرة ويعتريه الغضب

251
00:23:08,170 --> 00:23:11,880
ويصبح رأس الشّوغن مسعاه الوحيد
!وسيفه إنما في يده

252
00:23:11,880 --> 00:23:14,670
،وعندما يوشك مصير بلاد وانو أن يتغيّر

253
00:23:14,670 --> 00:23:22,510
تنتشر أخبار عن ملك القراصنة في الأزرق الشّرقيّ
.ستُدخل العالم بأسره في جذل وجدل

254
00:23:22,510 --> 00:23:27,600
:في الحلقة القادمة من وان بيس
"!أخبار محزنة! بداية عصر القراصنة العظيم"

255
00:23:27,600 --> 00:23:30,020
!ملك القراصنة، لن يكون إلاّ أنا