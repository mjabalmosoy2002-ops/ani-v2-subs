1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:11,940 --> 00:02:16,360
يحاول لوفي والبقيّة الوصول إلى
.سطح القبّة حيث يوجد كايدو

29
00:02:19,620 --> 00:02:21,490
!هجوم

30
00:02:26,710 --> 00:02:28,450
!سنتولّى أمر البقيّة

31
00:02:28,710 --> 00:02:30,120
.مهلاً

32
00:02:31,130 --> 00:02:32,540
.كينييمون

33
00:02:34,800 --> 00:02:36,750
!إينو! نيكو

34
00:02:44,640 --> 00:02:46,140
!يا رفاق-غارا

35
00:02:46,480 --> 00:02:48,390
!سنتولّى الأمر

36
00:02:48,650 --> 00:02:50,610
!يا زورو

37
00:02:50,610 --> 00:02:53,480
هذا أنت يا لوفي! إلى أين تذهب؟

38
00:02:53,480 --> 00:02:55,520
.للأعلى حيث كايدو

39
00:02:56,150 --> 00:02:57,530
.سأرافقك

40
00:02:58,950 --> 00:03:01,740
...فاكهة المطّاط

41
00:03:01,740 --> 00:03:04,280
!الصّاروخ

42
00:03:13,210 --> 00:03:15,420
!سُحقًا

43
00:03:16,130 --> 00:03:18,750
!لن أسمح لكم بالذّهاب أيّها الحمقى

44
00:03:21,430 --> 00:03:24,050
!لن أسمح لكم بدخول هذه المنطقة

45
00:03:27,730 --> 00:03:30,150
!لن نتمكّن من الصّعود إلى هناك

46
00:03:30,150 --> 00:03:32,680
!الأمن شديد للغاية

47
00:03:45,580 --> 00:03:48,910
!ما زال هنالك الكثير من الأعداء حولنا

48
00:03:48,910 --> 00:03:51,480
،ولكن لسبب ما

49
00:03:51,480 --> 00:03:53,590
.لا أشعر أنّنا سنخسر

50
00:03:53,590 --> 00:03:55,040
!معك حقّ

51
00:03:55,040 --> 00:03:56,540
!نعم، وكذلك أنا

52
00:03:56,540 --> 00:03:59,760
هذا غريب. لماذا يساورنا هذا الشّعور؟

53
00:03:59,760 --> 00:04:01,900
!أليس الأمر واضحًا؟

54
00:04:01,900 --> 00:04:04,840
!هذا لأنّ فتى قبّعة القشّ معنا

55
00:04:05,850 --> 00:04:07,880
!هيّا بنا يا قبطان

56
00:04:10,560 --> 00:04:13,600
!نعم! لنقم بهذا مرّة أخرى! أجاهزون؟

57
00:04:14,520 --> 00:04:17,710
!يا رفاق! سأترك الباقي لكم

58
00:04:17,710 --> 00:04:19,440
!ادعمونا

59
00:04:34,540 --> 00:04:37,160
...فأنا يا كايدو

60
00:04:37,460 --> 00:04:40,130
!قادم لإيساعك ضربًا

61
00:04:54,690 --> 00:04:58,770
"!دعوة محفوفة بالمخاطر! مكيدة للإطاحة بكوين"

62
00:05:33,640 --> 00:05:37,390
.يملك لوفي-سان القدرة على جلب النّاس إليه

63
00:05:40,070 --> 00:05:41,100
،بالفعل

64
00:05:41,900 --> 00:05:45,520
.تغيّرت الأجواء عندما ظهر قبّعة القشّ

65
00:05:51,870 --> 00:05:54,950
كنت خائفًا بشأن ما قد يحدث
...عندما قرّر كايدو وبيغ مام

66
00:05:56,000 --> 00:05:57,790
.الإعلان عن تحالفهما

67
00:06:00,580 --> 00:06:05,210
...هذا الارتباك الّذي خلقه قبّعة القشّ

68
00:06:05,760 --> 00:06:09,170
.ليس أمرًا سيّئًا لي

69
00:06:22,530 --> 00:06:25,600
...ليس طاقم قبّعة القشّ أيضًا

70
00:06:25,600 --> 00:06:29,070
.هؤلاء سجناء أودون بكلّ تأكيد

71
00:06:31,990 --> 00:06:34,200
!حتّى هيوغورو هنا

72
00:06:34,200 --> 00:06:38,580
ما الّذي حدث في مخيّم التّنقيب في أودون؟

73
00:06:39,250 --> 00:06:42,040
هل تمّ تهديد بابانوكي؟

74
00:06:42,260 --> 00:06:46,340
!معك المأمور بابانوكي من أودون

75
00:06:46,340 --> 00:06:48,990
قبّعة القشّ لوفي وكابتن كيد

76
00:06:48,990 --> 00:06:52,970
.وبقيّة الصّعاليك خلف القضبان جميعًا

77
00:06:52,970 --> 00:06:55,760
.اتّصلت لأقول أنّ كلّ شيء بخير فحسب

78
00:06:57,190 --> 00:06:59,100
.لا شيء من هذا منطقيّ

79
00:07:03,070 --> 00:07:05,560
.لن ألومك الآن

80
00:07:05,570 --> 00:07:08,690
.لطالما كنت أبلهًا

81
00:07:08,690 --> 00:07:11,820
!لطالما كان كلامك سبب مشاكلك

82
00:07:11,820 --> 00:07:14,450
هل سبق وسمعت بكلمة "طيبة" من قبل؟

83
00:07:18,120 --> 00:07:22,500
.علينا البتّ في هذا الأمر بسرعة

84
00:07:26,170 --> 00:07:29,170
!بدأت تبدو كقائد الآن

85
00:07:30,510 --> 00:07:33,550
!قبّعة القشّ اللّعين! ذلك الوغد

86
00:07:35,980 --> 00:07:38,970
...تعمّ الفوضى أونيغاشيما

87
00:07:41,270 --> 00:07:42,770
.هوكينس

88
00:07:43,110 --> 00:07:46,980
ألا تظنّ أنّ هذه فرصة جيّدة؟

89
00:07:46,980 --> 00:07:49,900
.إن أتى عدوّ ما، فسأقطعه فحسب

90
00:07:50,120 --> 00:07:52,820
."لا أدري ما الّذي تقصد بكلمة "فرصة

91
00:07:52,820 --> 00:07:58,030
.لم أكن أعلم أنّك وفيّ جدًّا لكايدو... ساما

92
00:07:59,710 --> 00:08:03,830
.أنت هنا فقط لأنّ أبو خدعك

93
00:08:05,630 --> 00:08:09,420
...شكّلتَ تحالفًا مع كيد وأبو

94
00:08:09,420 --> 00:08:13,000
!لكنّ أبو خانكما

95
00:08:13,260 --> 00:08:16,760
.انضممتَ لقراصنة مملكة الحيوان مجبورًا

96
00:08:17,480 --> 00:08:19,720
...والآن هو أفضل وقت لخيانتهم

97
00:08:23,690 --> 00:08:26,350
هل تشجّعني على خيانتهم؟

98
00:08:27,190 --> 00:08:29,350
.لا تستخفّ بي

99
00:08:34,450 --> 00:08:36,490
.واحد في المائة

100
00:08:36,750 --> 00:08:38,860
ما الّذي كنت تحاول توقّعه؟

101
00:08:39,750 --> 00:08:43,330
.احتماليّة أنّ هذا الرّجل سينجو حتّى الغد

102
00:08:43,540 --> 00:08:46,960
.واحد في المائة فقط... أشعر بالأسى عليه

103
00:08:46,960 --> 00:08:50,550
...رنين، رنين، رنين... رنين، رنين، رنين

104
00:08:50,550 --> 00:08:51,800
.فتح

105
00:08:51,800 --> 00:08:54,800
!أجيبوا أيّها التّوبي روبّو

106
00:08:56,510 --> 00:08:59,840
!كم هذا مزعج! ماذا تريد يا كينغ؟

107
00:09:00,140 --> 00:09:03,140
،يا رفاق... كما تعلمون

108
00:09:03,610 --> 00:09:05,770
.تغيّر الضوع

109
00:09:06,400 --> 00:09:08,980
،في يوم مهرجان النّار السّنويّ

110
00:09:08,980 --> 00:09:13,820
سمحنا لساموراي الأكازايا بغزونا
.من بين جميع أعدائنا

111
00:09:14,410 --> 00:09:19,240
.هذه أسوأ هفوة في تاريخ أونيغاشيما

112
00:09:20,580 --> 00:09:22,930
...علينا أن نوقف خلافاتنا الدّاخليّة

113
00:09:22,930 --> 00:09:25,490
.الّتي يشجّعها كايدو-سان

114
00:09:25,750 --> 00:09:27,080
الخلافات الدّاخليّة؟

115
00:09:27,080 --> 00:09:29,250
.للأمر علاقة بالسّيّد الصّغير ياماتو

116
00:09:29,510 --> 00:09:32,980
...إنّ من سيُعيد السّيّد الصّغير ياماتو المفقود

117
00:09:32,980 --> 00:09:38,380
سينال الحقّ لتحدّي واحد منّا نحن
.النّجوم الكبار لأخذ مكاننا

118
00:09:38,720 --> 00:09:40,840
،رغم أنّني كنت أتطلّع شوقًا لهذا

119
00:09:41,140 --> 00:09:43,970
.إلاّ أنّ علينا تأجيله

120
00:09:43,970 --> 00:09:45,600
!ماذا؟! أهذا معقول؟

121
00:09:45,600 --> 00:09:47,390
.بالطّبع

122
00:09:47,390 --> 00:09:50,270
.انظري حولك يا أختي

123
00:09:50,270 --> 00:09:53,510
!هذا أنت يا بي-تان! كنت أبحث عنك

124
00:09:53,510 --> 00:09:57,990
،هرب ياماتو منّي متسلّقًا الجدار
...أريدك أن تحملني على ظهرك

125
00:09:57,990 --> 00:09:58,820
!مستحيل

126
00:09:58,820 --> 00:09:59,700
!عليك ذلك

127
00:09:59,700 --> 00:10:01,400
.هذا يكفي أيّها الطّفلان الشّقيّان

128
00:10:02,370 --> 00:10:03,950
!من نعتّ بالطّفلين للتّوّ؟

129
00:10:03,950 --> 00:10:06,210
!لم أعد طفلاً، فلا تنعتني بذلك

130
00:10:06,210 --> 00:10:08,200
.كايدو موجود على السّطح

131
00:10:09,000 --> 00:10:13,170
.سيصعد الأعداء إلى قمّة القلعة من الدّاخل

132
00:10:13,760 --> 00:10:17,250
على كلّ واحد منكم الوقوف
.في طريقهم بأيّ طريقة متوفّرة لكم

133
00:10:17,760 --> 00:10:20,320
.لدينا 30 ألف مقاتل

134
00:10:20,320 --> 00:10:23,890
.أمّا هم، فلديهم خمسة آلاف فقط

135
00:10:24,230 --> 00:10:27,750
.لكن من الأفضل ألاّ تستهينوا بهم

136
00:10:27,750 --> 00:10:29,850
.حظًّا سعيدًا

137
00:10:31,770 --> 00:10:33,390
.إغلاق

138
00:10:34,900 --> 00:10:36,650
!يا دريك

139
00:10:36,650 --> 00:10:40,280
.وُلدت فرصة من هذه الفوضى
.تعال معي

140
00:10:40,580 --> 00:10:42,820
.من الصّعب جدًّا عليّ أن أذهب وحدي

141
00:10:43,830 --> 00:10:45,200
إلى أين ستذهب؟

142
00:10:45,200 --> 00:10:47,660
!سأقتل من أريد قتله

143
00:10:49,290 --> 00:10:51,420
.حيث يوجد كوين

144
00:10:51,420 --> 00:10:55,820
،حتّى إن قُتل مسؤول في خضمّ هذا الارتباك

145
00:10:55,820 --> 00:10:58,630
.فسيُعتبر ضحيّة حرب

146
00:10:59,100 --> 00:11:02,470
.لا تقحمني في منافستك

147
00:11:02,680 --> 00:11:04,760
هل تريد التّقليل من قوّاتنا؟

148
00:11:04,760 --> 00:11:06,640
.إنّه بلا فائدة من الأساس

149
00:11:07,150 --> 00:11:09,140
...أشكّ في ذلك

150
00:11:09,140 --> 00:11:11,350
.اتبعني فحسب

151
00:11:13,740 --> 00:11:16,480
.يعجبني سير الأحداث هذا

152
00:11:18,900 --> 00:11:20,760
!يا قبّعة القشّ-سان ورفاقه

153
00:11:20,760 --> 00:11:24,240
!سنفتح الطّريق لكم وصولاً للقلعة

154
00:11:24,240 --> 00:11:29,450
!نعم! لذلك لا تضيّعوا جهدكم

155
00:11:35,340 --> 00:11:37,540
!تقدّموا

156
00:11:37,720 --> 00:11:42,960
!أرسلوا قبّعة القشّ-سان ورفاقه إلى القلعة

157
00:11:56,650 --> 00:11:58,310
!لا تسمحوا لهم بالتّقدّم

158
00:11:58,530 --> 00:12:00,440
!إنّهم مساجين وياكوزا لعناء

159
00:12:04,830 --> 00:12:07,490
.الفوضى تعمّ المكان بالكامل

160
00:12:14,710 --> 00:12:17,290
!علينا إبعاد ذلك الضّخم عن الطّريق أيضًا

161
00:12:17,290 --> 00:12:19,800
.لا أصدّق أنّ بشرًا مثله موجودين

162
00:12:20,010 --> 00:12:22,550
!لا تخشوه! علينا القيام بهذا

163
00:12:22,550 --> 00:12:24,920
!هاجموا قدميه

164
00:13:03,260 --> 00:13:05,710
.كان ذلك وشيكًا

165
00:13:06,010 --> 00:13:07,170
.يا رجال

166
00:13:07,170 --> 00:13:09,010
!جينبي-سان

167
00:13:11,690 --> 00:13:15,870
...ماذا؟! أقلت أنّ هنالك خائنًا

168
00:13:15,870 --> 00:13:17,430
!بين ضبّاطنا المسؤولين؟

169
00:13:18,400 --> 00:13:22,020
أذلك صحيح يا هوز هو؟

170
00:13:22,200 --> 00:13:23,030
.نعم

171
00:13:23,030 --> 00:13:26,880
.بالتّفكير في الأمر، كان بابانوكي يتصرّف بغرابة

172
00:13:26,880 --> 00:13:31,030
هل اكتشفت من يكون؟

173
00:13:31,160 --> 00:13:32,120
...نعم

174
00:13:34,540 --> 00:13:36,200
من تظنّه في رأيك؟

175
00:13:39,710 --> 00:13:41,870
!ماذا؟

176
00:13:44,460 --> 00:13:46,530
...لا تقولا لي أنّكما

177
00:13:46,530 --> 00:13:51,050
!تحاولان أخذ مكان رئيسكما؟

178
00:13:51,640 --> 00:13:53,470
...ذلك احتمال وارد

179
00:13:55,810 --> 00:14:00,230
!هو... هو... هوكينس، أنت أيضًا؟

180
00:14:00,230 --> 00:14:04,530
!ادفع ثمن خيانتك وذق أبشع ألم

181
00:14:04,530 --> 00:14:09,870
!ماما! لا أريد أن أموت

182
00:14:09,870 --> 00:14:11,030
!أنت ممثّل سيّئ

183
00:14:17,040 --> 00:14:21,090
كيف سمحت لأمر كهذا أن يخدعك؟

184
00:14:21,090 --> 00:14:25,170
!لا تصف تمثيلاً جيّدًا كهذا بالسّيّئ

185
00:14:30,270 --> 00:14:33,340
ألم أؤدّي دوري جيّدًا؟

186
00:14:33,340 --> 00:14:36,180
.حسنًا، لنترك هذا الموضوع على حاله الآن

187
00:14:36,180 --> 00:14:38,260
!ما الّذي يحدث؟

188
00:14:38,560 --> 00:14:41,890
...إنّ احتماليّة نجاتك حتّى الغد

189
00:14:42,030 --> 00:14:43,690
.هي واحد في المائة

190
00:14:44,030 --> 00:14:47,570
...توقّعي للمستقبل

191
00:14:47,570 --> 00:14:50,480
.كنت طيّبًا بما يكفي لإطلاعك عليه

192
00:14:51,200 --> 00:14:53,620
.يا دييس دريك

193
00:14:53,620 --> 00:14:57,750
!نحن من نريد أن نعرف ماذا يحدث

194
00:14:57,750 --> 00:15:04,460
نحن قراصنة مملكة الحيوان لسنا طائشين
.لدرجة أنّنا لن نلحظ وجود خائن بيننا

195
00:15:47,760 --> 00:15:50,250
!لماذا شككتم في أمري؟

196
00:15:50,250 --> 00:15:53,920
!سل نفسك ذلك

197
00:15:56,680 --> 00:16:01,890
تركت ترافالغار لو يهرب
في عاصمة الزّهور، صحيح؟

198
00:16:10,370 --> 00:16:14,110
...إن كنت تخطّط لتركي أهرب

199
00:16:14,790 --> 00:16:16,360
.فأنا معك

200
00:16:19,710 --> 00:16:21,620
...كان هنالك حارس

201
00:16:23,460 --> 00:16:27,380
.لم يكن هنالك تخمين آخر سواك

202
00:16:27,380 --> 00:16:29,500
ما هي غايتك؟

203
00:16:30,510 --> 00:16:34,220
...فهمت... من أردتَ قتله

204
00:16:34,220 --> 00:16:36,800
!هو أنت أيّها القمامة

205
00:16:36,800 --> 00:16:40,180
.علينا أن نشعر بالخزي لسماحنا بوجود واش بيننا

206
00:16:42,020 --> 00:16:43,790
ما الّذي تسعى إليه؟

207
00:16:43,790 --> 00:16:47,230
هل تسلّلت بين صفوفنا وحدك
أم لديك شركاء آخرين؟

208
00:16:47,480 --> 00:16:49,520
!من تكون يا هذا؟

209
00:16:49,990 --> 00:16:52,730
.الصّدق خيارك الوحيد

210
00:17:03,790 --> 00:17:07,460
.أظنّ أنّها النّهاية... من المستحيل اختلاق عذر

211
00:17:10,880 --> 00:17:12,710
...لسوء الحظّ، أنا

212
00:17:13,090 --> 00:17:16,090
!لن أخبركم أيّ شيء وإن عنى ذلك موتي

213
00:17:19,010 --> 00:17:21,300
...لن نقتلك

214
00:17:21,480 --> 00:17:25,180
.ستعاني الأمرّين من تعذيبي النّفسيّ

215
00:17:27,650 --> 00:17:32,310
.لا أطيق الانتظار يا دريك

216
00:17:49,090 --> 00:17:53,080
!أصدقاء فتى قبّعة القشّ أقوياء جدًّا

217
00:17:53,080 --> 00:17:54,630
...ذلك الوحش

218
00:17:57,180 --> 00:17:58,840
!يا قبّعة القشّ-سان

219
00:18:02,100 --> 00:18:05,060
...شاهدوا فحسب! قاتلنا في السّابق

220
00:18:05,060 --> 00:18:08,140
!ضدّ واحد بنفس ضخامته

221
00:18:09,530 --> 00:18:11,190
!زهور السّاق

222
00:18:14,740 --> 00:18:16,490
!ها أنا ذا

223
00:18:16,490 --> 00:18:17,730
!أعتمد عليك

224
00:18:21,660 --> 00:18:23,870
!توقعات الجوّ، أمطار وشيكة

225
00:18:23,870 --> 00:18:25,620
!جوّ المطر

226
00:18:27,960 --> 00:18:30,250
!أدورها

227
00:18:30,250 --> 00:18:32,370
!إطلاق

228
00:18:38,100 --> 00:18:40,090
!تثلجت

229
00:18:40,390 --> 00:18:42,050
.لا أستطيع الحراك

230
00:18:47,100 --> 00:18:48,510
!سلسلة

231
00:18:48,510 --> 00:18:50,930
!مذهل يا سانجي

232
00:18:52,980 --> 00:18:54,560
.سأرميك حقًا

233
00:18:54,560 --> 00:18:57,940
!لا بأس! أنا رجل مطاطي

234
00:18:58,490 --> 00:18:59,950
.توخ الحذر

235
00:19:00,910 --> 00:19:02,700
!المستوى الثالث

236
00:19:04,080 --> 00:19:05,950
!بالون العظام

237
00:19:09,750 --> 00:19:11,310
.اترك الأمر لي

238
00:19:11,310 --> 00:19:12,960
...أسلوب السّيوف الثّلاثة

239
00:19:15,260 --> 00:19:16,830
!السريّ

240
00:19:19,430 --> 00:19:21,960
!العوالم الثلاثة آلاف

241
00:19:24,430 --> 00:19:26,600
...فاكهة المطّاط

242
00:19:26,600 --> 00:19:28,180
...البازوكا

243
00:19:29,150 --> 00:19:31,270
!العملاقة

244
00:19:33,150 --> 00:19:35,440
.ذلك الوحش مثل أورز تمامًا

245
00:19:35,440 --> 00:19:41,280
في السّابق، تطلّب الأمر قوّتنا جميعًا
.لنطيح بذلك الشّيء الضّخم أخيرًا

246
00:19:43,820 --> 00:19:45,450
!لكنّ الأمور تغيّرت الآن

247
00:19:52,130 --> 00:19:53,410
!لوفي

248
00:20:00,800 --> 00:20:02,880
!المستوى الرّابع

249
00:20:03,810 --> 00:20:05,890
!الرّجل الواثب

250
00:20:08,600 --> 00:20:10,730
!ها قد فعلها ثانية

251
00:20:10,730 --> 00:20:14,020
!تلك الهيئة... إنّه أشبه بالميوو، ملك الحكمة

252
00:20:32,290 --> 00:20:33,740
ماذا عليّ أن أفعل؟

253
00:20:34,340 --> 00:20:36,250
،حتّى إن هربت منهم

254
00:20:36,250 --> 00:20:39,830
.سأكون محاطًا بجيش من قراصنة مملكة الحيوان

255
00:20:40,090 --> 00:20:42,470
...أظنّ أنّه لا يوجد أمل

256
00:20:42,470 --> 00:20:43,590
!مذهل

257
00:20:44,390 --> 00:20:47,260
!هل ستتكلّم أم لا؟

258
00:20:50,520 --> 00:20:52,010
.حسنًا

259
00:20:52,900 --> 00:20:55,290
لا تريد أن تتعذّب إذًا؟

260
00:20:55,290 --> 00:20:57,690
...كم هذا مؤسف

261
00:21:00,030 --> 00:21:01,190
...هذه

262
00:21:01,650 --> 00:21:04,110
...عربون شكر

263
00:21:05,740 --> 00:21:07,110
!منّي

264
00:21:12,290 --> 00:21:12,950
!انبطحوا

265
00:21:19,420 --> 00:21:21,960
ماذا الآن؟ كيف سأهرب؟

266
00:21:22,130 --> 00:21:24,630
!ما من طريقة للعودة للبحريّة؟

267
00:21:24,850 --> 00:21:27,920
!كلاّ! لا يجب التّفكير في ذلك الآن

268
00:21:32,060 --> 00:21:35,220
!ما زال هنالك أمل

269
00:21:38,190 --> 00:21:40,730
...فاكهة المطّاط

270
00:21:41,820 --> 00:21:43,070
!ابتعد عن طريقي

271
00:21:43,070 --> 00:21:44,860
!يا جوكي

272
00:21:46,900 --> 00:21:48,870
...إكس

273
00:21:50,620 --> 00:21:51,990
...مسدّس

274
00:21:51,990 --> 00:21:53,370
!كونغ

275
00:21:51,990 --> 00:21:53,370
!كاليبور

276
00:22:25,740 --> 00:22:27,480
!إنّه مذهل

277
00:22:29,120 --> 00:22:29,940
...هذا

278
00:22:30,120 --> 00:22:31,990
!دريك من التّوبي روبّو

279
00:22:31,990 --> 00:22:34,070
!لماذا هاجم العملاق؟

280
00:22:38,380 --> 00:22:40,080
...ما زال هنالك

281
00:22:41,630 --> 00:22:43,170
.أمل

282
00:22:50,390 --> 00:22:51,260
!سُحقًا

283
00:22:51,260 --> 00:22:54,470
!لوفي-سان مذهل

284
00:22:54,470 --> 00:22:56,390
!يا قبّعة القشّ لوفي

285
00:22:56,730 --> 00:22:59,470
!أنا أقاتل وحدي لسبب ما

286
00:23:01,480 --> 00:23:02,880
!أرجوك

287
00:23:02,880 --> 00:23:06,190
!دعني أقاتل إلى جانبكم

288
00:23:18,290 --> 00:23:20,710
!لن يُسامَح الخائن أبدًا

289
00:23:20,710 --> 00:23:24,320
يتورّط محاربو السّاموراي في هجوم جيش كايدو

290
00:23:24,320 --> 00:23:26,570
.على دريك الّذي قرّر القتال إلى جانب لوفي

291
00:23:26,570 --> 00:23:29,670
.كما أنّ نامي تقف لإنقاذ صديقها المحاصر

292
00:23:29,670 --> 00:23:32,220
!خصمها هي التّوبي روبّو أولتي

293
00:23:32,220 --> 00:23:35,510
.إنّها تتحدّى عدوّة قويّة مخاطرة بحياتها

294
00:23:36,470 --> 00:23:40,580
:في الحلقة القادمة من وان بيس
"!منافسة جديدة! نامي وأولتي"

295
00:23:40,580 --> 00:23:42,940
!ملك القراصنة، لم يكون إلاّ أنا