1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:57,940 --> 00:02:02,360
يحاول لوفي والبقيّة الوصول إلى
.سطح القبّة حيث يوجد كايدو

29
00:02:05,620 --> 00:02:07,490
!هجوم

30
00:02:12,710 --> 00:02:14,450
!سنتولّى أمر البقيّة

31
00:02:14,710 --> 00:02:16,120
.مهلاً

32
00:02:17,130 --> 00:02:18,540
.كينييمون

33
00:02:20,800 --> 00:02:22,750
!إينو! نيكو

34
00:02:30,640 --> 00:02:32,140
!يا رفاق-غارا

35
00:02:32,480 --> 00:02:34,390
!سنتولّى الأمر

36
00:02:34,650 --> 00:02:36,610
!يا زورو

37
00:02:36,610 --> 00:02:39,480
هذا أنت يا لوفي! إلى أين تذهب؟

38
00:02:39,480 --> 00:02:41,520
.للأعلى حيث كايدو

39
00:02:42,150 --> 00:02:43,530
.سأرافقك

40
00:02:44,950 --> 00:02:47,740
...فاكهة المطّاط

41
00:02:47,740 --> 00:02:50,280
!الصّاروخ

42
00:02:59,210 --> 00:03:01,420
!سُحقًا

43
00:03:02,130 --> 00:03:04,750
!لن أسمح لكم بالذّهاب أيّها الحمقى

44
00:03:07,430 --> 00:03:10,050
!لن أسمح لكم بدخول هذه المنطقة

45
00:03:13,730 --> 00:03:16,150
!لن نتمكّن من الصّعود إلى هناك

46
00:03:16,150 --> 00:03:18,680
!الأمن شديد للغاية

47
00:03:31,580 --> 00:03:34,910
!ما زال هنالك الكثير من الأعداء حولنا

48
00:03:34,910 --> 00:03:37,480
،ولكن لسبب ما

49
00:03:37,480 --> 00:03:39,590
.لا أشعر أنّنا سنخسر

50
00:03:39,590 --> 00:03:41,040
!معك حقّ

51
00:03:41,040 --> 00:03:42,540
!نعم، وكذلك أنا

52
00:03:42,540 --> 00:03:45,760
هذا غريب. لماذا يساورنا هذا الشّعور؟

53
00:03:45,760 --> 00:03:47,900
!أليس الأمر واضحًا؟

54
00:03:47,900 --> 00:03:50,840
!هذا لأنّ فتى قبّعة القشّ معنا

55
00:03:51,850 --> 00:03:53,880
!هيّا بنا يا قبطان

56
00:03:56,560 --> 00:03:59,600
!نعم! لنقم بهذا مرّة أخرى! أجاهزون؟

57
00:04:00,520 --> 00:04:03,710
!يا رفاق! سأترك الباقي لكم

58
00:04:03,710 --> 00:04:05,440
!ادعمونا

59
00:04:20,540 --> 00:04:23,160
...فأنا يا كايدو

60
00:04:23,460 --> 00:04:26,130
!قادم لإيساعك ضربًا

61
00:04:40,690 --> 00:04:44,770
"!دعوة محفوفة بالمخاطر! مكيدة للإطاحة بكوين"

62
00:05:19,640 --> 00:05:23,390
.يملك لوفي-سان القدرة على جلب النّاس إليه

63
00:05:26,070 --> 00:05:27,100
،بالفعل

64
00:05:27,900 --> 00:05:31,520
.تغيّرت الأجواء عندما ظهر قبّعة القشّ

65
00:05:37,870 --> 00:05:40,950
كنت خائفًا بشأن ما قد يحدث
...عندما قرّر كايدو وبيغ مام

66
00:05:42,000 --> 00:05:43,790
.الإعلان عن تحالفهما

67
00:05:46,580 --> 00:05:51,210
...هذا الارتباك الّذي خلقه قبّعة القشّ

68
00:05:51,760 --> 00:05:55,170
.ليس أمرًا سيّئًا لي

69
00:06:08,530 --> 00:06:11,600
...ليس طاقم قبّعة القشّ أيضًا

70
00:06:11,600 --> 00:06:15,070
.هؤلاء سجناء أودون بكلّ تأكيد

71
00:06:17,990 --> 00:06:20,200
!حتّى هيوغورو هنا

72
00:06:20,200 --> 00:06:24,580
ما الّذي حدث في مخيّم التّنقيب في أودون؟

73
00:06:25,250 --> 00:06:28,040
هل تمّ تهديد بابانوكي؟

74
00:06:28,260 --> 00:06:32,340
!معك المأمور بابانوكي من أودون

75
00:06:32,340 --> 00:06:34,990
قبّعة القشّ لوفي وكابتن كيد

76
00:06:34,990 --> 00:06:38,970
.وبقيّة الصّعاليك خلف القضبان جميعًا

77
00:06:38,970 --> 00:06:41,760
.اتّصلت لأقول أنّ كلّ شيء بخير فحسب

78
00:06:43,190 --> 00:06:45,100
.لا شيء من هذا منطقيّ

79
00:06:49,070 --> 00:06:51,560
.لن ألومك الآن

80
00:06:51,570 --> 00:06:54,690
.لطالما كنت أبلهًا

81
00:06:54,690 --> 00:06:57,820
!لطالما كان كلامك سبب مشاكلك

82
00:06:57,820 --> 00:07:00,450
هل سبق وسمعت بكلمة "طيبة" من قبل؟

83
00:07:04,120 --> 00:07:08,500
.علينا البتّ في هذا الأمر بسرعة

84
00:07:12,170 --> 00:07:15,170
!بدأت تبدو كقائد الآن

85
00:07:16,510 --> 00:07:19,550
!قبّعة القشّ اللّعين! ذلك الوغد

86
00:07:21,980 --> 00:07:24,970
...تعمّ الفوضى أونيغاشيما

87
00:07:27,270 --> 00:07:28,770
.هوكينس

88
00:07:29,110 --> 00:07:32,980
ألا تظنّ أنّ هذه فرصة جيّدة؟

89
00:07:32,980 --> 00:07:35,900
.إن أتى عدوّ ما، فسأقطعه فحسب

90
00:07:36,120 --> 00:07:38,820
."لا أدري ما الّذي تقصد بكلمة "فرصة

91
00:07:38,820 --> 00:07:44,030
.لم أكن أعلم أنّك وفيّ جدًّا لكايدو... ساما

92
00:07:45,710 --> 00:07:49,830
.أنت هنا فقط لأنّ أبو خدعك

93
00:07:51,630 --> 00:07:55,420
...شكّلتَ تحالفًا مع كيد وأبو

94
00:07:55,420 --> 00:07:59,000
!لكنّ أبو خانكما

95
00:07:59,260 --> 00:08:02,760
.انضممتَ لقراصنة مملكة الحيوان مجبورًا

96
00:08:03,480 --> 00:08:05,720
...والآن هو أفضل وقت لخيانتهم

97
00:08:09,690 --> 00:08:12,350
هل تشجّعني على خيانتهم؟

98
00:08:13,190 --> 00:08:15,350
.لا تستخفّ بي

99
00:08:20,450 --> 00:08:22,490
.واحد في المائة

100
00:08:22,750 --> 00:08:24,860
ما الّذي كنت تحاول توقّعه؟

101
00:08:25,750 --> 00:08:29,330
.احتماليّة أنّ هذا الرّجل سينجو حتّى الغد

102
00:08:29,540 --> 00:08:32,960
.واحد في المائة فقط... أشعر بالأسى عليه

103
00:08:32,960 --> 00:08:36,550
...رنين، رنين، رنين... رنين، رنين، رنين

104
00:08:36,550 --> 00:08:37,800
.فتح

105
00:08:37,800 --> 00:08:40,800
!أجيبوا أيّها التّوبي روبّو

106
00:08:42,510 --> 00:08:45,840
!كم هذا مزعج! ماذا تريد يا كينغ؟

107
00:08:46,140 --> 00:08:49,140
،يا رفاق... كما تعلمون

108
00:08:49,610 --> 00:08:51,770
.تغيّر الضوع

109
00:08:52,400 --> 00:08:54,980
،في يوم مهرجان النّار السّنويّ

110
00:08:54,980 --> 00:08:59,820
سمحنا لساموراي الأكازايا بغزونا
.من بين جميع أعدائنا

111
00:09:00,410 --> 00:09:05,240
.هذه أسوأ هفوة في تاريخ أونيغاشيما

112
00:09:06,580 --> 00:09:08,930
...علينا أن نوقف خلافاتنا الدّاخليّة

113
00:09:08,930 --> 00:09:11,490
.الّتي يشجّعها كايدو-سان

114
00:09:11,750 --> 00:09:13,080
الخلافات الدّاخليّة؟

115
00:09:13,080 --> 00:09:15,250
.للأمر علاقة بالسّيّد الصّغير ياماتو

116
00:09:15,510 --> 00:09:18,980
...إنّ من سيُعيد السّيّد الصّغير ياماتو المفقود

117
00:09:18,980 --> 00:09:24,380
سينال الحقّ لتحدّي واحد منّا نحن
.النّجوم الكبار لأخذ مكاننا

118
00:09:24,720 --> 00:09:26,840
،رغم أنّني كنت أتطلّع شوقًا لهذا

119
00:09:27,140 --> 00:09:29,970
.إلاّ أنّ علينا تأجيله

120
00:09:29,970 --> 00:09:31,600
!ماذا؟! أهذا معقول؟

121
00:09:31,600 --> 00:09:33,390
.بالطّبع

122
00:09:33,390 --> 00:09:36,270
.انظري حولك يا أختي

123
00:09:36,270 --> 00:09:39,510
!هذا أنت يا بي-تان! كنت أبحث عنك

124
00:09:39,510 --> 00:09:43,990
،هرب ياماتو منّي متسلّقًا الجدار
...أريدك أن تحملني على ظهرك

125
00:09:43,990 --> 00:09:44,820
!مستحيل

126
00:09:44,820 --> 00:09:45,700
!عليك ذلك

127
00:09:45,700 --> 00:09:47,400
.هذا يكفي أيّها الطّفلان الشّقيّان

128
00:09:48,370 --> 00:09:49,950
!من نعتّ بالطّفلين للتّوّ؟

129
00:09:49,950 --> 00:09:52,210
!لم أعد طفلاً، فلا تنعتني بذلك

130
00:09:52,210 --> 00:09:54,200
.كايدو موجود على السّطح

131
00:09:55,000 --> 00:09:59,170
.سيصعد الأعداء إلى قمّة القلعة من الدّاخل

132
00:09:59,760 --> 00:10:03,250
على كلّ واحد منكم الوقوف
.في طريقهم بأيّ طريقة متوفّرة لكم

133
00:10:03,760 --> 00:10:06,320
.لدينا 30 ألف مقاتل

134
00:10:06,320 --> 00:10:09,890
.أمّا هم، فلديهم خمسة آلاف فقط

135
00:10:10,230 --> 00:10:13,750
.لكن من الأفضل ألاّ تستهينوا بهم

136
00:10:13,750 --> 00:10:15,850
.حظًّا سعيدًا

137
00:10:17,770 --> 00:10:19,390
.إغلاق

138
00:10:20,900 --> 00:10:22,650
!يا دريك

139
00:10:22,650 --> 00:10:26,280
.وُلدت فرصة من هذه الفوضى
.تعال معي

140
00:10:26,580 --> 00:10:28,820
.من الصّعب جدًّا عليّ أن أذهب وحدي

141
00:10:29,830 --> 00:10:31,200
إلى أين ستذهب؟

142
00:10:31,200 --> 00:10:33,660
!سأقتل من أريد قتله

143
00:10:35,290 --> 00:10:37,420
.حيث يوجد كوين

144
00:10:37,420 --> 00:10:41,820
،حتّى إن قُتل مسؤول في خضمّ هذا الارتباك

145
00:10:41,820 --> 00:10:44,630
.فسيُعتبر ضحيّة حرب

146
00:10:45,100 --> 00:10:48,470
.لا تقحمني في منافستك

147
00:10:48,680 --> 00:10:50,760
هل تريد التّقليل من قوّاتنا؟

148
00:10:50,760 --> 00:10:52,640
.إنّه بلا فائدة من الأساس

149
00:10:53,150 --> 00:10:55,140
...أشكّ في ذلك

150
00:10:55,140 --> 00:10:57,350
.اتبعني فحسب

151
00:10:59,740 --> 00:11:02,480
.يعجبني سير الأحداث هذا

152
00:11:04,900 --> 00:11:06,760
!يا قبّعة القشّ-سان ورفاقه

153
00:11:06,760 --> 00:11:10,240
!سنفتح الطّريق لكم وصولاً للقلعة

154
00:11:10,240 --> 00:11:15,450
!نعم! لذلك لا تضيّعوا جهدكم

155
00:11:21,340 --> 00:11:23,540
!تقدّموا

156
00:11:23,720 --> 00:11:28,960
!أرسلوا قبّعة القشّ-سان ورفاقه إلى القلعة

157
00:11:42,650 --> 00:11:44,310
!لا تسمحوا لهم بالتّقدّم

158
00:11:44,530 --> 00:11:46,440
!إنّهم مساجين وياكوزا لعناء

159
00:11:50,830 --> 00:11:53,490
.الفوضى تعمّ المكان بالكامل

160
00:12:00,710 --> 00:12:03,290
!علينا إبعاد ذلك الضّخم عن الطّريق أيضًا

161
00:12:03,290 --> 00:12:05,800
.لا أصدّق أنّ بشرًا مثله موجودين

162
00:12:06,010 --> 00:12:08,550
!لا تخشوه! علينا القيام بهذا

163
00:12:08,550 --> 00:12:10,920
!هاجموا قدميه

164
00:12:49,260 --> 00:12:51,710
.كان ذلك وشيكًا

165
00:12:52,010 --> 00:12:53,170
.يا رجال

166
00:12:53,170 --> 00:12:55,010
!جينبي-سان

167
00:12:57,690 --> 00:13:01,870
...ماذا؟! أقلت أنّ هنالك خائنًا

168
00:13:01,870 --> 00:13:03,430
!بين ضبّاطنا المسؤولين؟

169
00:13:04,400 --> 00:13:08,020
أذلك صحيح يا هوز هو؟

170
00:13:08,200 --> 00:13:09,030
.نعم

171
00:13:09,030 --> 00:13:12,880
.بالتّفكير في الأمر، كان بابانوكي يتصرّف بغرابة

172
00:13:12,880 --> 00:13:17,030
هل اكتشفت من يكون؟

173
00:13:17,160 --> 00:13:18,120
...نعم

174
00:13:20,540 --> 00:13:22,200
من تظنّه في رأيك؟

175
00:13:25,710 --> 00:13:27,870
!ماذا؟

176
00:13:30,460 --> 00:13:32,530
...لا تقولا لي أنّكما

177
00:13:32,530 --> 00:13:37,050
!تحاولان أخذ مكان رئيسكما؟

178
00:13:37,640 --> 00:13:39,470
...ذلك احتمال وارد

179
00:13:41,810 --> 00:13:46,230
!هو... هو... هوكينس، أنت أيضًا؟

180
00:13:46,230 --> 00:13:50,530
!ادفع ثمن خيانتك وذق أبشع ألم

181
00:13:50,530 --> 00:13:55,870
!ماما! لا أريد أن أموت

182
00:13:55,870 --> 00:13:57,030
!أنت ممثّل سيّئ

183
00:14:03,040 --> 00:14:07,090
كيف سمحت لأمر كهذا أن يخدعك؟

184
00:14:07,090 --> 00:14:11,170
!لا تصف تمثيلاً جيّدًا كهذا بالسّيّئ

185
00:14:16,270 --> 00:14:19,340
ألم أؤدّي دوري جيّدًا؟

186
00:14:19,340 --> 00:14:22,180
.حسنًا، لنترك هذا الموضوع على حاله الآن

187
00:14:22,180 --> 00:14:24,260
!ما الّذي يحدث؟

188
00:14:24,560 --> 00:14:27,890
...إنّ احتماليّة نجاتك حتّى الغد

189
00:14:28,030 --> 00:14:29,690
.هي واحد في المائة

190
00:14:30,030 --> 00:14:33,570
...توقّعي للمستقبل

191
00:14:33,570 --> 00:14:36,480
.كنت طيّبًا بما يكفي لإطلاعك عليه

192
00:14:37,200 --> 00:14:39,620
.يا دييس دريك

193
00:14:39,620 --> 00:14:43,750
!نحن من نريد أن نعرف ماذا يحدث

194
00:14:43,750 --> 00:14:50,460
نحن قراصنة مملكة الحيوان لسنا طائشين
.لدرجة أنّنا لن نلحظ وجود خائن بيننا

195
00:15:33,760 --> 00:15:36,250
!لماذا شككتم في أمري؟

196
00:15:36,250 --> 00:15:39,920
!سل نفسك ذلك

197
00:15:42,680 --> 00:15:47,890
تركت ترافالغار لو يهرب
في عاصمة الزّهور، صحيح؟

198
00:15:56,370 --> 00:16:00,110
...إن كنت تخطّط لتركي أهرب

199
00:16:00,790 --> 00:16:02,360
.فأنا معك

200
00:16:05,710 --> 00:16:07,620
...كان هنالك حارس

201
00:16:09,460 --> 00:16:13,380
.لم يكن هنالك تخمين آخر سواك

202
00:16:13,380 --> 00:16:15,500
ما هي غايتك؟

203
00:16:16,510 --> 00:16:20,220
...فهمت... من أردتَ قتله

204
00:16:20,220 --> 00:16:22,800
!هو أنت أيّها القمامة

205
00:16:22,800 --> 00:16:26,180
.علينا أن نشعر بالخزي لسماحنا بوجود واش بيننا

206
00:16:28,020 --> 00:16:29,790
ما الّذي تسعى إليه؟

207
00:16:29,790 --> 00:16:33,230
هل تسلّلت بين صفوفنا وحدك
أم لديك شركاء آخرين؟

208
00:16:33,480 --> 00:16:35,520
!من تكون يا هذا؟

209
00:16:35,990 --> 00:16:38,730
.الصّدق خيارك الوحيد

210
00:16:49,790 --> 00:16:53,460
.أظنّ أنّها النّهاية... من المستحيل اختلاق عذر

211
00:16:56,880 --> 00:16:58,710
...لسوء الحظّ، أنا

212
00:16:59,090 --> 00:17:02,090
!لن أخبركم أيّ شيء وإن عنى ذلك موتي

213
00:17:05,010 --> 00:17:07,300
...لن نقتلك

214
00:17:07,480 --> 00:17:11,180
.ستعاني الأمرّين من تعذيبي النّفسيّ

215
00:17:13,650 --> 00:17:18,310
.لا أطيق الانتظار يا دريك

216
00:17:35,090 --> 00:17:39,080
!أصدقاء فتى قبّعة القشّ أقوياء جدًّا

217
00:17:39,080 --> 00:17:40,630
...ذلك الوحش

218
00:17:43,180 --> 00:17:44,840
!يا قبّعة القشّ-سان

219
00:17:48,100 --> 00:17:51,060
...شاهدوا فحسب! قاتلنا في السّابق

220
00:17:51,060 --> 00:17:54,140
!ضدّ واحد بنفس ضخامته

221
00:17:55,530 --> 00:17:57,190
!زهور السّاق

222
00:18:00,740 --> 00:18:02,490
!ها أنا ذا

223
00:18:02,490 --> 00:18:03,730
!أعتمد عليك

224
00:18:07,660 --> 00:18:09,870
!توقعات الجوّ، أمطار وشيكة

225
00:18:09,870 --> 00:18:11,620
!جوّ المطر

226
00:18:13,960 --> 00:18:16,250
!أدورها

227
00:18:16,250 --> 00:18:18,370
!إطلاق

228
00:18:24,100 --> 00:18:26,090
!تثلجت

229
00:18:26,390 --> 00:18:28,050
.لا أستطيع الحراك

230
00:18:33,100 --> 00:18:34,510
!سلسلة

231
00:18:34,510 --> 00:18:36,930
!مذهل يا سانجي

232
00:18:38,980 --> 00:18:40,560
.سأرميك حقًا

233
00:18:40,560 --> 00:18:43,940
!لا بأس! أنا رجل مطاطي

234
00:18:44,490 --> 00:18:45,950
.توخ الحذر

235
00:18:46,910 --> 00:18:48,700
!المستوى الثالث

236
00:18:50,080 --> 00:18:51,950
!بالون العظام

237
00:18:55,750 --> 00:18:57,310
.اترك الأمر لي

238
00:18:57,310 --> 00:18:58,960
...أسلوب السّيوف الثّلاثة

239
00:19:01,260 --> 00:19:02,830
!السريّ

240
00:19:05,430 --> 00:19:07,960
!العوالم الثلاثة آلاف

241
00:19:10,430 --> 00:19:12,600
...فاكهة المطّاط

242
00:19:12,600 --> 00:19:14,180
...البازوكا

243
00:19:15,150 --> 00:19:17,270
!العملاقة

244
00:19:19,150 --> 00:19:21,440
.ذلك الوحش مثل أورز تمامًا

245
00:19:21,440 --> 00:19:27,280
في السّابق، تطلّب الأمر قوّتنا جميعًا
.لنطيح بذلك الشّيء الضّخم أخيرًا

246
00:19:29,820 --> 00:19:31,450
!لكنّ الأمور تغيّرت الآن

247
00:19:38,130 --> 00:19:39,410
!لوفي

248
00:19:46,800 --> 00:19:48,880
!المستوى الرّابع

249
00:19:49,810 --> 00:19:51,890
!الرّجل الواثب

250
00:19:54,600 --> 00:19:56,730
!ها قد فعلها ثانية

251
00:19:56,730 --> 00:20:00,020
!تلك الهيئة... إنّه أشبه بالميوو، ملك الحكمة

252
00:20:18,290 --> 00:20:19,740
ماذا عليّ أن أفعل؟

253
00:20:20,340 --> 00:20:22,250
،حتّى إن هربت منهم

254
00:20:22,250 --> 00:20:25,830
.سأكون محاطًا بجيش من قراصنة مملكة الحيوان

255
00:20:26,090 --> 00:20:28,470
...أظنّ أنّه لا يوجد أمل

256
00:20:28,470 --> 00:20:29,590
!مذهل

257
00:20:30,390 --> 00:20:33,260
!هل ستتكلّم أم لا؟

258
00:20:36,520 --> 00:20:38,010
.حسنًا

259
00:20:38,900 --> 00:20:41,290
لا تريد أن تتعذّب إذًا؟

260
00:20:41,290 --> 00:20:43,690
...كم هذا مؤسف

261
00:20:46,030 --> 00:20:47,190
...هذه

262
00:20:47,650 --> 00:20:50,110
...عربون شكر

263
00:20:51,740 --> 00:20:53,110
!منّي

264
00:20:58,290 --> 00:20:58,950
!انبطحوا

265
00:21:05,420 --> 00:21:07,960
ماذا الآن؟ كيف سأهرب؟

266
00:21:08,130 --> 00:21:10,630
!ما من طريقة للعودة للبحريّة؟

267
00:21:10,850 --> 00:21:13,920
!كلاّ! لا يجب التّفكير في ذلك الآن

268
00:21:18,060 --> 00:21:21,220
!ما زال هنالك أمل

269
00:21:24,190 --> 00:21:26,730
...فاكهة المطّاط

270
00:21:27,820 --> 00:21:29,070
!ابتعد عن طريقي

271
00:21:29,070 --> 00:21:30,860
!يا جوكي

272
00:21:32,900 --> 00:21:34,870
...إكس

273
00:21:36,620 --> 00:21:37,990
...مسدّس

274
00:21:37,990 --> 00:21:39,370
!كونغ

275
00:21:37,990 --> 00:21:39,370
!كاليبور

276
00:22:11,740 --> 00:22:13,480
!إنّه مذهل

277
00:22:15,120 --> 00:22:15,940
...هذا

278
00:22:16,120 --> 00:22:17,990
!دريك من التّوبي روبّو

279
00:22:17,990 --> 00:22:20,070
!لماذا هاجم العملاق؟

280
00:22:24,380 --> 00:22:26,080
...ما زال هنالك

281
00:22:27,630 --> 00:22:29,170
.أمل

282
00:22:36,390 --> 00:22:37,260
!سُحقًا

283
00:22:37,260 --> 00:22:40,470
!لوفي-سان مذهل

284
00:22:40,470 --> 00:22:42,390
!يا قبّعة القشّ لوفي

285
00:22:42,730 --> 00:22:45,470
!أنا أقاتل وحدي لسبب ما

286
00:22:47,480 --> 00:22:48,880
!أرجوك

287
00:22:48,880 --> 00:22:52,190
!دعني أقاتل إلى جانبكم

288
00:23:04,290 --> 00:23:06,710
!لن يُسامَح الخائن أبدًا

289
00:23:06,710 --> 00:23:10,320
يتورّط محاربو السّاموراي في هجوم جيش كايدو

290
00:23:10,320 --> 00:23:12,570
.على دريك الّذي قرّر القتال إلى جانب لوفي

291
00:23:12,570 --> 00:23:15,670
.كما أنّ نامي تقف لإنقاذ صديقها المحاصر

292
00:23:15,670 --> 00:23:18,220
!خصمها هي التّوبي روبّو أولتي

293
00:23:18,220 --> 00:23:21,510
.إنّها تتحدّى عدوّة قويّة مخاطرة بحياتها

294
00:23:22,470 --> 00:23:26,580
:في الحلقة القادمة من وان بيس
"!منافسة جديدة! نامي وأولتي"

295
00:23:26,580 --> 00:23:28,940
!ملك القراصنة، لم يكون إلاّ أنا