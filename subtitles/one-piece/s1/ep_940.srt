1
00:00:00,000 --> 00:00:00,000
افتح الخريطة الّتي لا حدود لها

2
00:00:00,000 --> 00:00:02,820
نحو المكان الّذي لا نهاية له

3
00:00:07,410 --> 00:00:10,250
ولنلتحق بالرّياح

4
00:00:15,750 --> 00:00:19,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:19,880 --> 00:00:22,930
فلن أتراجع أبدًا

6
00:00:22,930 --> 00:00:26,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:26,720 --> 00:00:31,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:31,140 --> 00:00:33,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:33,650 --> 00:00:39,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:39,900 --> 00:00:43,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:43,990 --> 00:00:45,280
هيّا، تشجّع

12
00:00:45,280 --> 00:00:46,870
كلّ شيء سيكون بخير

13
00:00:46,870 --> 00:00:50,580
فالرّوابط القويّة ستستمر

14
00:00:50,580 --> 00:00:53,330
افتح الخريطة الّتي لا حدود لها

15
00:00:53,330 --> 00:00:56,540
نحو المكان الّذي لا نهاية له

16
00:00:56,540 --> 00:01:02,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:02,010 --> 00:01:04,760
افتح الخريطة الّتي لا حدود لها

18
00:01:04,760 --> 00:01:07,470
الرّاية الّتي تنادي وعودنا

19
00:01:07,470 --> 00:01:10,310
تواصل القتال

20
00:01:10,310 --> 00:01:14,900
فابقَ صادقًا مع نفسك

21
00:01:14,900 --> 00:01:19,280
تمسّك بالحلم وواصل

22
00:01:19,730 --> 00:01:24,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:25,370 --> 00:01:28,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:28,120 --> 00:01:32,540
جميعها كنوز

25
00:01:32,960 --> 00:01:35,750
افتح الخريطة الّتي لا حدود لها

26
00:01:35,750 --> 00:01:38,800
نحو المكان الّذي لا نهاية له

27
00:01:38,800 --> 00:01:43,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:01:58,710 --> 00:02:02,240
!أوّلاً، أريد الاعتذار للجميع بشأن أمرين

29
00:02:02,640 --> 00:02:05,910
!ثمّ أريد قول أمر واحد لأوروتشي الغبيّ

30
00:02:08,730 --> 00:02:12,710
.سأقرأ التّهم الموجّهة للمتّهم

31
00:02:15,670 --> 00:02:20,460
.ليلة البارحة، ارتكب جريمة سرقة في عاصمة الزّهور

32
00:02:20,910 --> 00:02:22,800
.لقد هوى بشكل مروّع

33
00:02:22,800 --> 00:02:28,890
إنّه الدّايميو السّابق لهاكوماي
!الّذي يجني قوت يومه كغيشا رجل

34
00:02:28,890 --> 00:02:32,350
!اسمه شيموتسكي ياسويي

35
00:02:32,630 --> 00:02:39,270
ولقاء جريمة التّمرّد الفظيعة ضدّ
،الشّوغن أوروتشي-ساما في الماضي

36
00:02:39,270 --> 00:02:42,610
،وكقربان لقبر الأويران كوموراساكي

37
00:02:43,390 --> 00:02:46,650
.نحكم عليه بموتٍ مخزٍ

38
00:02:48,820 --> 00:02:52,830
!انظروا إلى عاصمة الزّهور الجميلة

39
00:02:59,490 --> 00:03:04,100
!إنّ منظر بلاد وانو هذا لا نظير له

40
00:03:07,880 --> 00:03:14,140
ولأجيال عدّة، تطوّر هذا المشهد
.على يد عشيرة كوزكي وعامّة الشّعب

41
00:03:14,140 --> 00:03:17,070
.إنّنا فخورون جدًّا به

42
00:03:17,300 --> 00:03:18,600
!أسرعوا

43
00:03:18,850 --> 00:03:21,270
!أسرعوا أكثر

44
00:03:21,270 --> 00:03:24,190
!بدأ يتحدّث بالهراء

45
00:03:24,930 --> 00:03:27,320
!هل تسمعني يا أوروتشي؟

46
00:03:27,850 --> 00:03:32,080
.كانت هنالك غابات شاسعة وسهول خضراء

47
00:03:33,580 --> 00:03:35,330
!أنهار

48
00:03:35,330 --> 00:03:37,000
!قرى

49
00:03:37,080 --> 00:03:41,330
!وكلّ ما فعلته هو تلويثها بتراب الجشع

50
00:03:42,450 --> 00:03:45,960
!ما أنت إلاّ آفة

51
00:03:47,580 --> 00:03:50,260
!ذلك الوغد

52
00:03:53,500 --> 00:03:57,350
"!غضب زورو! الحقيقة وراء سمايل"

53
00:04:21,960 --> 00:04:23,960
!هولديم اللّعين

54
00:04:23,960 --> 00:04:28,550
!كيف يجرؤ على إضرام النّار في مخبئي؟

55
00:04:31,110 --> 00:04:34,480
!أين أنت؟! اخرج

56
00:04:35,130 --> 00:04:37,100
!هولديم

57
00:04:45,930 --> 00:04:47,230
...هل هذا

58
00:04:54,570 --> 00:04:57,330
!ياسويي-ساما، لا تتمادَ كثيرًا

59
00:04:57,580 --> 00:04:59,750
!لن تستطيع التّراجع

60
00:05:04,910 --> 00:05:06,380
...هنالك أمر آخر

61
00:05:07,400 --> 00:05:10,590
.أريد الاعتذار عنه

62
00:05:11,460 --> 00:05:15,850
بشأن تلك المنشورات ذات العلامة
...الّتي انتشرت مؤخّرًا

63
00:05:17,650 --> 00:05:20,730
.مرّت عشرون سنة مذ اندثر اسم كوزكي

64
00:05:20,740 --> 00:05:23,980
لا أستطيع الآن جمع ما يكفي
،من الجنود لتحقيق انتقامي

65
00:05:28,440 --> 00:05:30,900
!لذلك صنعت تلك المنشورات

66
00:05:30,900 --> 00:05:32,780
!ماذا؟

67
00:05:36,620 --> 00:05:39,830
.لا يعني الرّمز أيّ شيء

68
00:05:39,830 --> 00:05:40,750
...إنّه

69
00:05:41,030 --> 00:05:44,010
!مجرّد مقلب

70
00:05:45,530 --> 00:05:48,390
!ماذا؟

71
00:05:49,580 --> 00:05:52,050
!ما الغاية من كلّ هذا؟

72
00:06:00,890 --> 00:06:03,690
!ها أنت ذا يا أشورا

73
00:06:05,510 --> 00:06:09,980
!كينييمون! إينواراشي! لا أصدّق الأمر

74
00:06:09,980 --> 00:06:10,820
!انظرا

75
00:06:10,820 --> 00:06:14,490
!يبدو أنّ ياسويي-ساما ما زال حيًّا

76
00:06:14,730 --> 00:06:18,580
.نعم، اكتشفتُ ذلك للتّوّ أيضًا

77
00:06:18,650 --> 00:06:20,790
.أصبح هذا عرضًا مميّزًا

78
00:06:20,790 --> 00:06:23,750
،مات أودن قبل عشرين سنة

79
00:06:24,160 --> 00:06:28,880
وسأل أوروتشي الدّايميو الأربعة
...المتبقّين بمن فيهم أنا

80
00:06:29,500 --> 00:06:32,170
إن كنّا نريد أن نخدم تحت
...جناح كوروزومي

81
00:06:32,170 --> 00:06:34,560
.أو نقاتلهم

82
00:06:43,710 --> 00:06:45,600
!يا لها من أضحوكة

83
00:06:49,220 --> 00:06:51,940
!كانت ديونك لأودن كبيرة

84
00:06:52,020 --> 00:06:56,070
ومع ذلك استوليت على منصب
.الشّوغن بالمكر والخداع

85
00:06:56,070 --> 00:06:58,450
!كان ذلك غير مقبول

86
00:06:59,250 --> 00:07:04,290
استلّ الدّايميو والنّاس من كلّ
،منطقة سيوفهم دونما تردّد

87
00:07:04,860 --> 00:07:09,080
،لكنّ الوحش المسمّى كايدو اعترض طريق انتقامهم

88
00:07:09,580 --> 00:07:12,590
.وغرقت بلاد وانو في ألسنة اللّهب

89
00:07:19,540 --> 00:07:26,820
لم أكن أرغب بالنّجاة، لكنّني فعلت
،وعشت في بلدة إبيسو سرًّا

90
00:07:27,390 --> 00:07:31,360
لكنّني لم أرد أيضًا أن أواصل
.العيش إلى أن أموت ميتة طبيعيّة

91
00:07:31,800 --> 00:07:37,700
لذلك استعملت الطّفل الّذي بداخلي
.وفكّرت في مقلب المنشورات ونفّذته

92
00:07:39,910 --> 00:07:43,000
!سامحوني أرجوكم

93
00:07:44,050 --> 00:07:48,790
...لكنّ أوروتشي كان جبانًا أكبر ممّا ظننت

94
00:07:49,450 --> 00:07:55,760
اضطرب وسجن الأبرياء الّذين كان لديهم
!وشم الهلال الّذي هو تصميم شائع

95
00:07:56,710 --> 00:07:58,100
!ماذا؟

96
00:07:58,170 --> 00:08:00,560
!كلّ هذا في مخيّلة أوروتشي-ساما فحسب؟

97
00:08:00,630 --> 00:08:04,060
!ماذا نفعل؟! أمسكنا بالكثير منهم

98
00:08:04,060 --> 00:08:05,060
!ماذا؟

99
00:08:05,600 --> 00:08:09,270
!هل يعني ذلك أنّهم ليسوا متمرّدين من الأساس؟

100
00:08:12,650 --> 00:08:14,360
!ياسويي-ساما

101
00:08:14,360 --> 00:08:16,110
!ابتعدوا عن طريقنا

102
00:08:16,110 --> 00:08:18,790
!ابتعدوا

103
00:08:22,730 --> 00:08:25,490
!أوروتشي-ساما! أراه الآن

104
00:08:28,360 --> 00:08:31,210
!ياسويي اللّعين

105
00:08:31,210 --> 00:08:34,170
!سأملأ جسدك بالرّصاص

106
00:08:35,660 --> 00:08:37,050
...ها قد أتى

107
00:08:38,170 --> 00:08:41,130
!أوروتشي، لم أرك منذ مدّة

108
00:08:41,290 --> 00:08:45,560
!هل من كلمات أخيرة يا ياسويي؟

109
00:08:45,920 --> 00:08:49,820
...أوروتشي! لنرَ

110
00:08:50,550 --> 00:08:55,360
هل تريدني أن أردّد اللّعنة
الّتي تقيّد قلبك؟

111
00:09:00,560 --> 00:09:04,740
...ما كان رجل قليل الشّأن

112
00:09:05,610 --> 00:09:11,330
"!ليعرف أبدًا طعم الأودن ما حيا

113
00:09:41,490 --> 00:09:45,250
!بدأ الأمر يصبح مثيرًا للاهتمام

114
00:09:52,490 --> 00:09:55,210
...أعتقد أنّه رجل صالح

115
00:09:55,700 --> 00:09:59,170
!نعم، إنّه مخلص جدًّا للآخرين

116
00:10:03,620 --> 00:10:08,180
...كان أودن-ساما وياسويي-ساما كأخوَيْ قَسم

117
00:10:32,950 --> 00:10:34,540
!مستحيل

118
00:10:37,070 --> 00:10:38,710
!ياسويي-دونو

119
00:10:49,050 --> 00:10:51,190
!أبي

120
00:10:51,260 --> 00:10:53,060
!انتظري يا توكو

121
00:11:07,060 --> 00:11:07,990
!مومو

122
00:11:08,400 --> 00:11:11,210
لماذا لا تأخذ استراحة؟

123
00:11:12,820 --> 00:11:14,290
!هذا لا شيء

124
00:11:14,290 --> 00:11:16,880
!المعركة العظيمة وشيكة

125
00:11:25,920 --> 00:11:27,520
!ما الخطب؟

126
00:11:27,580 --> 00:11:33,540
عمليّة الغارة الّتي كنّا نستعدّ لها
.كُشف عنها بالكامل بطريقة ما

127
00:11:33,540 --> 00:11:34,720
!ماذا؟

128
00:11:34,920 --> 00:11:38,770
...ظننّا أنّ الأمر كلّه قد بطُل، لكن

129
00:11:40,220 --> 00:11:44,730
أعتقد أنّ ياسويي-دونو يحاول
!إخراجنا من الورطة وحده

130
00:11:56,700 --> 00:11:59,260
.هذه هي نهايتي

131
00:12:00,240 --> 00:12:05,090
...تعرفون ما العمل يا كينييمون
!ويا ساموراي أكازايا

132
00:12:05,370 --> 00:12:09,050
!وأيّها الشّوغن المستقبليّ مومونوسكي

133
00:12:12,460 --> 00:12:17,220
!عادت خطّتكم الآن للعمل

134
00:12:17,880 --> 00:12:21,190
سأعطي حلفاءكم الّذين اعتُقلوا في بلدة راستسو

135
00:12:21,190 --> 00:12:24,620
.نقطة لقاء جديدة

136
00:12:28,270 --> 00:12:33,320
هذا ليس بالكثير، لكنّه كلّ
.ما أستطيع فعله بحياتي

137
00:12:33,570 --> 00:12:39,840
!هل يحاول التّضحية بنفسه لإبقاء خطّتنا حيّة؟

138
00:12:41,990 --> 00:12:43,460
!ياسويي-دونو

139
00:12:49,870 --> 00:12:51,980
!شكرًا لك

140
00:12:57,130 --> 00:13:03,650
،مهما كان ما سيصرخ به الجبان أوروتشي
...لن يستمع له جنوده بعد الآن

141
00:13:03,890 --> 00:13:06,620
!سئمت من ارتياب الشّوغن

142
00:13:06,680 --> 00:13:08,440
!توقّف! سيسمعك شخص ما

143
00:13:12,650 --> 00:13:13,910
!أبي

144
00:13:14,860 --> 00:13:15,530
!ياسو

145
00:13:28,620 --> 00:13:35,900
!طوال عشرين سنة، لم يستطع أحد قطع رأس كايدو

146
00:13:36,340 --> 00:13:38,690
!...لكن هذه المرّة

147
00:13:38,800 --> 00:13:41,310
!غطّوا عيون أطفالكم

148
00:13:41,310 --> 00:13:44,600
...إنّ آخر الدّايميو الّذين خدموا كوزكي

149
00:13:44,600 --> 00:13:48,320
...بل أقصد الرّجل المرح من بلدة إبيسو

150
00:13:48,320 --> 00:13:50,860
!سينتقل الآن إلى الحياة الآخرة

151
00:13:52,140 --> 00:13:54,200
!ياسويي

152
00:14:00,330 --> 00:14:02,290
!لنغنّ وأنا راحل

153
00:14:02,290 --> 00:14:05,500
!هيّا بنا

154
00:14:33,190 --> 00:14:35,240
!ياسويي

155
00:14:36,280 --> 00:14:38,280
!لنغنّ وأنا راحل

156
00:14:38,280 --> 00:14:41,080
!هيّا بنا

157
00:14:48,490 --> 00:14:50,040
!أطلقوا

158
00:15:04,130 --> 00:15:06,350
!اغزوا أونيغاشيما

159
00:15:08,180 --> 00:15:11,150
!انتقموا لسيّدكم

160
00:15:13,390 --> 00:15:16,850
!سأنتظر الأخبار الجيّدة في العالم الآخر

161
00:15:23,240 --> 00:15:26,210
لماذا حاولت سرقة كلّ هذا المال؟

162
00:15:26,530 --> 00:15:29,460
!يحتاج أودن-ساما للمال

163
00:15:29,660 --> 00:15:32,170
!لماذا لا تقتلنا فحسب؟

164
00:15:32,490 --> 00:15:34,560
!أيّها القنفذ

165
00:15:36,040 --> 00:15:39,840
...أودن... اتّخذ أتباعًا غريبين جدًّا

166
00:15:41,960 --> 00:15:43,310
!يا رجال

167
00:15:43,550 --> 00:15:48,530
!بإمكانكم أخذ كلّ المال الّذي حاولتم سرقته

168
00:15:49,390 --> 00:15:51,910
!ماذا؟

169
00:15:52,010 --> 00:15:54,070
!تمهّل قليلاً يا ياسويي-ساما

170
00:15:54,310 --> 00:15:57,490
!ستواجه هاكوماي صعوبات ماليّة هكذا

171
00:15:57,560 --> 00:16:01,580
!لا أهتمّ... الأهمّ من ذلك، فكّ وثاقهم

172
00:16:01,650 --> 00:16:02,370
!ماذا؟

173
00:16:09,410 --> 00:16:12,210
!بإمكانكم استعمال هذا أيضًا

174
00:16:12,210 --> 00:16:13,590
!خذوه

175
00:16:13,910 --> 00:16:15,670
!المزيد من المال؟

176
00:16:15,670 --> 00:16:18,850
!لا بدّ أنّك تمزح! هذا فخّ

177
00:16:18,920 --> 00:16:21,840
!ياسويي-ساما، هذا يكفي أرجوك

178
00:16:23,750 --> 00:16:25,600
هل تحبّون أودن؟

179
00:16:26,340 --> 00:16:30,310
!بالطّبع نحبّه! إنّنا ندين له بالكثير

180
00:16:30,310 --> 00:16:31,770
!هذا صحيح

181
00:16:33,640 --> 00:16:35,020
...فهمت

182
00:16:35,220 --> 00:16:37,150
...في تلك الحالة، سخّروا هذا المال

183
00:16:37,150 --> 00:16:42,500
للتّحسين من أنفسكم وعاداتكم
!واشتروا كتبًا وثقّفوا أنفسكم

184
00:16:43,480 --> 00:16:48,580
إنّ امتلاك صعاليك مثلكم كتابعين
!سيجلب العار على أودن

185
00:16:50,160 --> 00:16:52,380
...سينتهي به المطاف

186
00:16:52,700 --> 00:16:56,050
!ليصبح شوغن بلاد وانو

187
00:16:57,290 --> 00:17:03,600
إنّ على من يدعمونه أنّ يكونوا
!أفضل السّاموراي في بلاد وانو

188
00:17:34,450 --> 00:17:38,100
.ناهيكم عن قول أنّه يجب عليكم حماية سيّدكم

189
00:17:38,910 --> 00:17:41,130
