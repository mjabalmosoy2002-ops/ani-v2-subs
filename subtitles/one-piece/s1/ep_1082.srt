1
00:00:00,650 --> 00:00:04,320
بوجود الضّعف كحليف لي

2
00:00:04,320 --> 00:00:07,950
أحلّق أعلى من أيّ أحد آخر

3
00:00:07,950 --> 00:00:10,660
من المؤسف البقاء في مكان كهذا

4
00:00:10,660 --> 00:00:14,870
لأنّ الأشياء الّتي ضاعت ستفقد شرارتها

5
00:00:15,200 --> 00:00:18,870
في الأوقات الّتي تضيع فيها في مكان ما

6
00:00:18,870 --> 00:00:22,500
إن كان قلبي أيضًا ضائعًا

7
00:00:22,500 --> 00:00:25,210
فلن أتمكّن من إيجادك

8
00:00:25,210 --> 00:00:29,260
لا لطفك ولا قوّتك

9
00:00:29,260 --> 00:00:35,060
أعلم مسبقًا

10
00:00:35,060 --> 00:00:36,970
إنّ بزوغ الفجر وشيك

11
00:00:36,970 --> 00:00:40,150
لنصبو إلى أعلى نقطة ممكنة

12
00:00:40,150 --> 00:00:44,320
سأندفع عبر الطّريق بأكمله

13
00:00:44,320 --> 00:00:47,070
أراهن أنّك تضحك ولا تشعر بأيّ شيء

14
00:00:47,070 --> 00:00:51,570
لأنّ ألم تلك الأيّام ربّما صار الآن في الماضي

15
00:00:51,570 --> 00:00:54,330
بوجود العالم كعدوّ لي

16
00:00:54,330 --> 00:00:58,790
أقف ثابتًا وإن ارتعشت قدماي

17
00:00:58,790 --> 00:01:01,580
واصل التّقدّم قليلاً فحسب من أجلي

18
00:01:01,580 --> 00:01:06,220
نقطة الإيقاظ
وقت العودة للحياة قد حان

19
00:01:15,970 --> 00:01:21,190
نقطة الإيقاظ
وقت العودة للحياة قد حان

20
00:01:28,740 --> 00:01:31,040
.استعادت بلاد وانو سلامها

21
00:01:31,180 --> 00:01:34,080
،بينما يستمتع سكّانها بالمهرجان

22
00:01:34,250 --> 00:01:38,800
تسبّبت أفعال سابو من الجيش الثّوريّ
.بالاضطراب في العالم بأسره

23
00:01:38,940 --> 00:01:40,630
!يا إلهي

24
00:01:40,880 --> 00:01:44,590
...يا له من وقت اخترتُ أن أصير فيه أميرال أسطول

25
00:01:46,720 --> 00:01:49,390
!لكن لا يهمّ ما أو من قد أجد في طريقي

26
00:01:49,600 --> 00:01:50,930
!أنا في انتظارهم

27
00:01:51,310 --> 00:01:54,670
!سأرسل كلّ واحد منهم إلى أعماق البحر

28
00:01:55,100 --> 00:01:59,110
.كما بدأ أحمر الشّعر شانكس تحرّكاته

29
00:02:03,590 --> 00:02:05,250
...اسمع يا بيك

30
00:02:07,880 --> 00:02:10,430
أعتقد أنّ الوقت قد حان لنتحرّك
...ونسعى خلف

31
00:02:17,030 --> 00:02:18,790
.الوان بيس

32
00:02:20,800 --> 00:02:22,010
!أوقفوني إذًا

33
00:02:24,540 --> 00:02:25,680
!مومونوسكي-كُن

34
00:02:27,330 --> 00:02:28,600
!ياماتو

35
00:02:29,400 --> 00:02:31,860
!إيّاك أن تقاتل

36
00:02:58,140 --> 00:03:00,630
!بالتّوفيق يا أونامي-تشان

37
00:03:17,770 --> 00:03:21,380
.أخطأت الهدف! هذا مؤسف يا آنسة

38
00:03:25,450 --> 00:03:28,400
!تبًّا، أخطأت الهدف بقليل فحسب

39
00:03:28,540 --> 00:03:30,870
!أنا أيضًا، أريد تكرار المحاولة

40
00:03:30,990 --> 00:03:32,870
!وأنا، وأنا

41
00:03:35,290 --> 00:03:36,620
!اسمعوا

42
00:03:38,920 --> 00:03:41,290
.اسمعوا يا هؤلاء

43
00:03:41,500 --> 00:03:44,880
هل نسيتم شخصًا ما في هذه القصّة؟

44
00:03:46,700 --> 00:03:48,340
!أوسوبّ

45
00:03:50,800 --> 00:03:55,150
!سأهتمّ أنا بالتّصويب الصّحيح

46
00:04:00,180 --> 00:04:01,530
!أنت بارع جدًّا

47
00:04:01,650 --> 00:04:03,860
!أنت قنّاص ممتاز يا فتى

48
00:04:04,190 --> 00:04:07,360
!سنخلق جوًّا مذهلاً لحفلة ضخمة

49
00:04:07,490 --> 00:04:11,240
!أجل

50
00:04:14,750 --> 00:04:19,060
"!اقتراب حقبة جديدة! غضب اليونكو أحمر الشّعر"

51
00:04:26,670 --> 00:04:30,060
.لعابي يسيل بسبب ذلك

52
00:04:30,460 --> 00:04:32,220
أتريد بعضها يا زوس؟

53
00:04:32,340 --> 00:04:34,680
أيمكنني ذلك يا نامي؟

54
00:04:34,810 --> 00:04:38,020
.بالطّبع، علينا مكافأة جهودك أيضًا

55
00:04:38,200 --> 00:04:39,960
!ممتاز، هذا لذيذ

56
00:04:42,940 --> 00:04:45,900
.لكنّي ما زالت أفضّل الكرات السّوداء

57
00:04:48,570 --> 00:04:50,450
.السّعادة تغمرنا

58
00:04:52,990 --> 00:04:54,040
هل أعجبك هذا؟

59
00:04:54,880 --> 00:04:56,910
.أستمتع به بشدّة

60
00:04:57,080 --> 00:05:00,520
!تعالوا إلى هنا يا رفاق
!يوجد ثلج مبشور هنا

61
00:05:00,790 --> 00:05:02,420
ثلج؟

62
00:05:02,540 --> 00:05:05,380
!أودّ بشدّة تذوّقه

63
00:05:05,790 --> 00:05:08,660
أتأتين معي يا أونامي-تشان؟

64
00:05:08,800 --> 00:05:09,800
.طبعًا

65
00:05:09,960 --> 00:05:12,720
!تعالي بسرعة يا أونامي-تشان

66
00:05:13,510 --> 00:05:15,640
.هناك نكهات عديدة

67
00:05:15,760 --> 00:05:18,290
أيّها سآكل يا ترى؟

68
00:05:18,430 --> 00:05:21,730
.أريد ثلجًا بنكهة الفاصولياء الحمراء

69
00:05:30,740 --> 00:05:32,600
!يا للإزعاج

70
00:05:39,740 --> 00:05:41,450
...هجماته لا تتوقّف

71
00:05:44,420 --> 00:05:47,090
.مومونوسكي-كُن، يمكنني مساعدتك

72
00:05:49,500 --> 00:05:50,510
!كلاّ

73
00:05:51,920 --> 00:05:55,590
ماذا؟ لماذا لا يمكنني قتاله؟

74
00:05:55,760 --> 00:05:58,220
!لا تتدخّل في هذا تحت أيّ ظرف

75
00:05:58,610 --> 00:05:59,840
!ياماتو

76
00:06:19,580 --> 00:06:24,310
،لن تحقّقوا أيّ شيء من هذا
!أحضروا لي قبّعة القشّ لوفي

77
00:06:31,510 --> 00:06:33,210
!مومونوسكي-ساما

78
00:06:33,570 --> 00:06:35,360
!يا ثعبان البحريّة

79
00:06:38,890 --> 00:06:41,640
!نينبو: جتسو اللّفيفة

80
00:06:49,020 --> 00:06:50,270
!تحرير النّار

81
00:06:58,610 --> 00:06:59,780
هل نلت منه؟

82
00:07:03,660 --> 00:07:05,960
.احترق، سأجعلك رمادًا بهذا

83
00:07:07,870 --> 00:07:09,580
!يا جنديّ النّحس

84
00:07:15,760 --> 00:07:17,340
...لا أظنّ ذلك

85
00:07:23,760 --> 00:07:25,140
!الغابة المضادّة للحرائق

86
00:07:27,140 --> 00:07:30,440
،لو كانت لديّ نقطة ضعف واضحة كهذه

87
00:07:30,730 --> 00:07:34,190
كيف كنت لأصير أميرالاً في المقرّ الرّئيسيّ للبحريّة؟

88
00:07:43,620 --> 00:07:48,960
كلّ من الطّبيعة والبشريّة يحتاجان
.لريّ عطشهما بالماء يا صغيري

89
00:07:49,960 --> 00:07:51,380
!دعني

90
00:08:02,180 --> 00:08:03,720
!رايزو

91
00:08:03,970 --> 00:08:06,810
!كلّما قطعنا منه، نما المزيد

92
00:08:06,950 --> 00:08:08,600
!رايزو-سان

93
00:08:14,480 --> 00:08:17,230
أليس لديه نقاط ضعف؟

94
00:08:17,360 --> 00:08:20,610
علينا مواصلة تقطيعه فحسب؟

95
00:08:21,260 --> 00:08:22,070
!وغد

96
00:08:24,620 --> 00:08:25,490
!لا

97
00:08:35,550 --> 00:08:37,290
.لا تفهمون أبدًا

98
00:08:37,500 --> 00:08:40,840
!خسرتم في اللّحظة الّتي خطوت فيها في بلاد وانو

99
00:08:41,220 --> 00:08:43,090
...مومونوسكي-كُن

100
00:08:43,680 --> 00:08:44,970
لماذا...؟

101
00:08:52,170 --> 00:08:53,140
درج؟

102
00:08:59,190 --> 00:09:02,000
.إنّه يمتدّ عميقًا بعد

103
00:09:02,360 --> 00:09:03,570
.اتبعيني

104
00:09:05,560 --> 00:09:06,280
!حسنًا

105
00:09:06,620 --> 00:09:08,400
.لديك حدس ممتاز

106
00:09:08,880 --> 00:09:12,080
.كان من المريب ألاّ تكوني في المهرجان

107
00:09:12,530 --> 00:09:14,540
.لا تتصرّفي وكأنّي مُطارد مريب

108
00:09:14,790 --> 00:09:16,920
غلبك الفضول أنت أيضًا؟

109
00:09:18,800 --> 00:09:20,290
.اتبعاني إذًا

110
00:09:22,170 --> 00:09:24,260
.انتبها أين تخطوان

111
00:09:24,510 --> 00:09:25,850
.هناك عفن في كلّ مكان

112
00:09:34,230 --> 00:09:38,150
.لم أخبر أبدًا كايدو أو أوروتشي بهذا الممرّ

113
00:09:38,440 --> 00:09:41,900
،ولكن لأنّ أحد النّجوم المدعوّ جاك كان برمائيًّا

114
00:09:42,030 --> 00:09:45,780
.استطاعوا اكتشاف هذا البونيغليف بسرعة

115
00:09:45,990 --> 00:09:48,730
ما علاقة هذا بكونه برمائيّ؟

116
00:09:48,870 --> 00:09:50,370
.ستعرفين ذلك قريبًا

117
00:09:51,610 --> 00:09:54,210
إلى متى سنواصل النّزول؟

118
00:09:54,460 --> 00:09:56,100
.سؤال وجيه

119
00:09:56,290 --> 00:09:58,790
...لنقل لعدّة قرون إلى الماضي

120
00:10:08,010 --> 00:10:09,680
...أخبرني يا تنغو-سان

121
00:10:09,920 --> 00:10:12,020
من أين يصدر هذا الضّوء الخافت؟

122
00:10:15,650 --> 00:10:18,290
.هناك جدار زجاجيّ في نهاية ذلك النّفق

123
00:10:18,430 --> 00:10:20,480
.خذي نظرة إن كان ذلك يثير انتباهك

124
00:10:22,940 --> 00:10:25,110
.إنّنا في قاع البحر حاليًّا

125
00:10:27,820 --> 00:10:29,010
.غرفة

126
00:10:32,600 --> 00:10:33,580
.هذا غشّ

127
00:10:36,120 --> 00:10:37,380
أتريانها؟

128
00:10:47,590 --> 00:10:49,600
!إنّها وانو تحت البحر؟

129
00:10:53,470 --> 00:10:57,220
.البلاد الّتي ترونها هي وانو قبل 800 سنة

130
00:10:57,650 --> 00:10:59,270
.وانو مختلفة

131
00:11:04,970 --> 00:11:08,280
قبل 800 سنة؟ ما معنى ذلك؟

132
00:11:08,660 --> 00:11:10,360
.كلامي واضح تمامًا

133
00:11:10,490 --> 00:11:14,460
!لكن أجهل ما الأحداث الّتي أدّت لهذه النّهاية

134
00:11:17,940 --> 00:11:22,460
.ظلّ كلّ شيء على حاله لأنّ هذه ليست مياه بحر

135
00:11:22,960 --> 00:11:24,730
...دعاني أشرح لكما

136
00:11:25,170 --> 00:11:29,390
.في الماضي، كان جبل فوجياما يطلّ على بلاد وانو

137
00:11:29,890 --> 00:11:32,790
،وفي أحد الأيّام، بُني جدار حول الجزيرة

138
00:11:32,910 --> 00:11:34,930
.وتجمّعت مياه الأمطار في الدّاخل

139
00:11:35,360 --> 00:11:38,060
كان على النّاس التّخلّي عن مدنهم
،الّتي دمّرتها الفيضانات

140
00:11:38,190 --> 00:11:41,440
،وبنوا مدنًا أخرى على حافّة الجبل

141
00:11:41,560 --> 00:11:43,270
.وهكذا تأسّست البلاد

142
00:11:46,110 --> 00:11:48,110
وتلك هي وانو الحاليّة؟

143
00:11:48,570 --> 00:11:49,860
.تمامًا

144
00:12:04,660 --> 00:12:06,130
.لقد وصلنا

145
00:12:47,800 --> 00:12:49,590
...بونيغليف الطّريق

146
00:12:50,620 --> 00:12:53,010
.هذا ثالث واحد أراه

147
00:12:53,560 --> 00:12:56,720
بقي واحد آخر فقط
.وسنتمكّن من الوصول إلى لافتيل

148
00:12:58,850 --> 00:13:03,060
.إنّنا الآن في الكهوف الّتي أسفل جبل فوجياما

149
00:13:06,900 --> 00:13:08,900
...وفي الأسفل قليلاً بعد

150
00:13:09,190 --> 00:13:12,450
.المكان الّذي يوجد فيه السّلاح القديم بلوتون

151
00:13:14,510 --> 00:13:19,120
.لم أره من قبل بنفسي... ولا يمكنني أن أريه لكما الآن

152
00:13:19,620 --> 00:13:23,880
علينا إسقاط الجدار الّذي حول
.الجزيرة لاستخراج بلوتون

153
00:13:24,120 --> 00:13:27,710
"لذلك فعبارة "فتح حدود وانو

154
00:13:27,840 --> 00:13:31,080
تعني تدمير الدّفاعات الطّبيعيّة للبلاد
!وإطلاق السّلاح القديم

155
00:13:38,470 --> 00:13:40,930
!فتح حدود البلاد سيُطلق السّلاح؟

156
00:13:41,230 --> 00:13:44,520
!لماذا أراد كوزكي أودن فعل ذلك؟

157
00:13:48,150 --> 00:13:52,930
!افتحوا حدود بلاد وانو

158
00:13:59,240 --> 00:14:02,340
أخبرتكما بكلّ ما توارثته عائلتي
.من خلال سلالة الشّوغن

159
00:14:02,960 --> 00:14:07,670
.أجهل ما اكتشفه أودن خلال ترحاله في البحار

160
00:14:15,080 --> 00:14:16,550
!هذا لذيذ جدًّا

161
00:14:17,260 --> 00:14:18,880
!كم هذا ممتع

162
00:14:22,020 --> 00:14:25,900
!يا بيبو! هناك متجر مثلّجات قريب

163
00:14:26,040 --> 00:14:28,520
ماذا؟ لديهم ثلج مبشور؟ أين هو؟

164
00:14:42,550 --> 00:14:44,290
!عد من حيث أتيت

165
00:14:44,410 --> 00:14:45,870
!مومونوسكي-ساما

166
00:14:48,210 --> 00:14:52,170
.لا يستطيع البشر الضّعفاء مجابهة الطّبيعة

167
00:14:52,340 --> 00:14:53,780
ألا تفهمون؟

168
00:14:53,900 --> 00:14:57,300
تواجد كايدو هنا كان الرّادع الوحيد
!الّذي منعني من الحضور من قبل

169
00:14:58,280 --> 00:15:01,560
،مع أنّ ما سأقوله يُحزنني
إلاّ أنّ حكم كايدو الطّاغي

170
00:15:01,680 --> 00:15:05,520
.هو ما حمى هذه الجزيرة من الأعداء الخارجيّين

171
00:15:07,280 --> 00:15:10,770
!بعد أن فهمتم هذا الآن، أحضروا لي قبّعة القشّ لوفي

172
00:15:11,130 --> 00:15:15,280
،عندما سأحصل على رأسه
!فسأترك بلادكم هذه وأغادر

173
00:15:17,030 --> 00:15:20,070
.مومونوسكي-كُن! يمكننا الاعتماد على لوفي وطاقمه

174
00:15:20,200 --> 00:15:21,990
!سيسحقونه في الحال

175
00:15:27,000 --> 00:15:28,790
!ذلك ليس خيارًا على الإطلاق

176
00:15:29,330 --> 00:15:30,290
ماذا؟

177
00:15:30,670 --> 00:15:33,750
.لا أريد مساعدتك أيضًا
!لذلك لن أطلبها

178
00:15:34,210 --> 00:15:37,470
.كنتَ محبوسًا هنا في أونيغاشيما مذ كنتَ طفلاً

179
00:15:37,720 --> 00:15:39,810
!وهذه هي فرصتك لتكون حرًّا أخيرًا

180
00:15:40,760 --> 00:15:42,590
!لن آخذ ذلك منك أبدًا

181
00:15:43,170 --> 00:15:46,800
.اعتمدنا كثيرًا على لوفي وزورو والبقيّة

182
00:15:47,580 --> 00:15:51,560
نحن من سنظلّ في وانو وسيتوجّب
.علينا إبعاد أيّ عدوّ عنها

183
00:15:53,660 --> 00:15:56,010
،إن اعتمدنا على مساعدة أشخاص سيغادروننا

184
00:15:56,880 --> 00:15:58,730
فكيف لنا

185
00:15:59,360 --> 00:16:01,780
أن نحمي بلادنا في المستقبل؟

186
00:16:03,950 --> 00:16:05,410
...مومونوسكي-كُن

187
00:16:05,540 --> 00:16:08,670
!ارحل يا وحش الغابة

188
00:16:13,760 --> 00:16:16,820
لا أعرف ما العمل... لماذا لا تخرج النّار؟

189
00:16:18,550 --> 00:16:21,820
...هذا الغرّ ثانية

190
00:16:22,090 --> 00:16:25,100
.لم أعرف أنّ التّنانين قد تكون مثيرة للشّفقة هكذا

191
00:16:28,850 --> 00:16:31,850
.سأدفنك تحت الأرض بسرعة

192
00:16:34,400 --> 00:16:35,770
!مومونوسكي-كُن

193
00:16:36,070 --> 00:16:39,450
.ارقد بسلام للأبد

194
00:16:44,530 --> 00:16:46,950
!يا سُحقًا! مومونوسكي-ساما

195
00:16:47,240 --> 00:16:49,000
!سحقًا! انطلق

196
00:16:49,140 --> 00:16:51,120
!مومونوسكي-ساما

197
00:16:52,960 --> 00:16:54,710
!مومونوسكي-ساما

198
00:16:56,130 --> 00:16:58,170
!انطلق! انطلق

199
00:17:03,010 --> 00:17:04,090
!انطلق

200
00:17:07,700 --> 00:17:08,460
!مومو

201
00:17:18,480 --> 00:17:20,150
!ارحل

202
00:17:30,790 --> 00:17:32,660
!أخيرًا

203
00:17:34,630 --> 00:17:36,260
!مومونوسكي-ساما

204
00:17:36,380 --> 00:17:38,960
!يا إلهي! صار مثل كايدو أكثر فأكثر

205
00:17:39,170 --> 00:17:40,770
!ارحل يا جنديّ البحريّة

206
00:17:41,480 --> 00:17:44,300
!إيّاك أن تفكّر في الحضور إلى وانو ثانية

207
00:17:44,990 --> 00:17:46,460
...أيّها الـ

208
00:17:46,600 --> 00:17:48,640
!سألقّنك درسًا أيّها الوغد

209
00:17:51,770 --> 00:17:55,440
!مذهل! أتقن أخيرًا استعمال جسد التّنّين خاصّته

210
00:17:56,000 --> 00:17:59,110
!مع أنّ تصويبه ليس دقيقًا للغاية

211
00:18:26,090 --> 00:18:27,800
!مذهل

212
00:18:40,610 --> 00:18:42,150
...يا لها من فوضى

213
00:18:42,480 --> 00:18:45,030
أتريد إحراق عاصمتك؟

214
00:18:46,060 --> 00:18:48,700
إن كان الأمر هكذا، فبإمكاننا تحقيق ذلك

215
00:18:49,320 --> 00:18:52,070
.يا نسخة كايدو الرّخيصة

216
00:18:52,200 --> 00:18:55,580
!سأفصلك لنصفين من الفم إلى الذّيل

217
00:19:10,260 --> 00:19:11,890
...لا أستطيع التّحرّك

218
00:19:12,990 --> 00:19:14,910
!هذا هاكي الملك الأسمى

219
00:19:15,280 --> 00:19:16,850
من الفاعل؟

220
00:19:24,530 --> 00:19:26,490
...غير ممكن

221
00:19:27,240 --> 00:19:29,620
...طاقم أحمر الشّعر

222
00:19:30,160 --> 00:19:32,280
قريب من هنا؟

223
00:19:35,210 --> 00:19:38,430
!يا زعيم، على مهلك بخصوص موجات الهاكي تلك

224
00:19:38,560 --> 00:19:40,960
.فقد الأعضاء الجدد وعيهم جميعًا

225
00:19:43,800 --> 00:19:47,190
،أنا لا أتّهمك بالجبن يا جنديّ البحريّة

226
00:19:48,110 --> 00:19:50,050
لكنّ هذه البراعم اليافعة

227
00:19:50,340 --> 00:19:52,570
.متعبة بعد تغييرها لتاريخ القرصنة

228
00:19:52,720 --> 00:19:55,430
لذلك ألا تظنّ أنّ مهاجمتهم الآن
!لا تعتبر من اللّباقة؟

229
00:19:57,340 --> 00:20:01,100
هل أنت خائف لهذه الدّرجة بالفعل
من الحقبة الجديدة القادمة؟

230
00:20:04,070 --> 00:20:06,610
.لا رغبة لي في قتالكم

231
00:20:06,890 --> 00:20:08,200
.ليس الآن على الأقلّ

232
00:20:09,240 --> 00:20:10,950
.فهمت رسالتك

233
00:20:16,620 --> 00:20:17,960
!مذهل

234
00:20:18,080 --> 00:20:21,170
.ممتاز يا مومونوسكي-كُن! لقد طردت العدوّ

235
00:20:21,330 --> 00:20:23,710
!حميتَ بلاد وانو

236
00:20:24,380 --> 00:20:27,260
أنا؟ استطعت ذلك؟

237
00:20:28,440 --> 00:20:30,720
هل دافعتُ عن بلادي؟

238
00:20:37,390 --> 00:20:39,520
هل حميت شعبي؟

239
00:20:43,400 --> 00:20:45,900
!كنتَ مذهلاً يا مومونوسكي-كُن

240
00:20:47,940 --> 00:20:49,190
!لقد هرب

241
00:20:49,360 --> 00:20:51,610
.أحسنت يا مومو

242
00:20:52,030 --> 00:20:53,950
ليس بحاجة إلينا؟

243
00:20:57,200 --> 00:21:00,460
على أيّ حال، هل شعرتم بذلك الهاكي الشّرس؟

244
00:21:00,660 --> 00:21:03,200
.نعم، أتساءل من كان مصدره

245
00:21:17,740 --> 00:21:20,060
.إنّه يذكّرني بوجه مألوف

246
00:21:51,340 --> 00:21:54,630
انتهى الوقت

247
00:21:55,390 --> 00:21:58,970
هنالك من ضحك ثانية

248
00:21:59,350 --> 00:22:06,060
لا بأس، فإنّ الغمّيضة الآن انتهت

249
00:22:06,860 --> 00:22:11,030
تعال معي
(سنراها قريبًا)

250
00:22:11,030 --> 00:22:14,780
دع قلبك ينبض بصوت أعلى
(الجزيرة لنا)

251
00:22:14,780 --> 00:22:19,160
شيء ما سيتغيّر
(سنراها قريبًا)

252
00:22:19,160 --> 00:22:23,410
كن قويًّا، ما زال هنالك وقت
(3-2-1)

253
00:22:31,300 --> 00:22:35,380
لكنّنا شباب، لذلك فنحن أحرار

254
00:22:35,380 --> 00:22:40,010
لنعش جميعًا أحلامنا الأكثر حماقة

255
00:22:40,010 --> 00:22:43,930
سننير الطّريق المظلم أمامنا

256
00:22:43,930 --> 00:22:48,060
لنقف على أقدامنا ونحاول

257
00:22:48,060 --> 00:22:51,980
لنكتشف معًا أصقاع العالم

258
00:22:51,980 --> 00:22:56,070
أنا وأنت، سنحلّق بعيدًا

259
00:23:04,480 --> 00:23:06,330
،عندما صار لوفي واحدًا من اليونكو

260
00:23:06,640 --> 00:23:09,660
.هزّت تلك الأخبار العالم

261
00:23:10,080 --> 00:23:12,170
،وفي السّرّاء والضّرّاء

262
00:23:12,300 --> 00:23:15,720
.هناك مسألة صادمة ستهدد البحريّة

263
00:23:16,080 --> 00:23:18,940
،وعلى رأس بعض الشّيتشيبوكاي السّابقين

264
00:23:19,090 --> 00:23:21,700
!يظهر رجل مشهور بأنف أحمر

265
00:23:22,560 --> 00:23:24,020
:في الحلقة القادمة من وان بيس

266
00:23:24,140 --> 00:23:27,590
.يشهد العالم تغيّرًا جديدًا"
"!المنظّمة الجديدة كروس غيلد

267
00:23:27,730 --> 00:23:30,080
!ملك القراصنة، لن يكون إلاّ أنا