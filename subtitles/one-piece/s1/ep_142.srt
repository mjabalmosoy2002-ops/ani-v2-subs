1
00:00:08,250 --> 00:00:11,280
!العالم... نعم

2
00:00:11,820 --> 00:00:13,490
...اسعوا نحو الحرّيّة

3
00:00:13,490 --> 00:00:17,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:17,990 --> 00:00:21,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:21,890 --> 00:00:23,260
!فتجاوزوها

6
00:00:23,660 --> 00:00:26,630
!تحت راية ما تؤمنون به

7
00:00:31,100 --> 00:00:36,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:36,710 --> 00:00:39,940
متّجهًا نحو عالم بلا نهاية

9
00:00:41,350 --> 00:00:46,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:00:46,220 --> 00:00:54,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:00:54,630 --> 00:01:00,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:00,370 --> 00:01:04,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:04,800 --> 00:01:10,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:10,440 --> 00:01:14,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:14,310 --> 00:01:19,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:19,250 --> 00:01:26,990
متّجهين نحو الأفق

17
00:01:26,990 --> 00:01:32,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:32,500 --> 00:01:37,200
متّجهًا نحو عالم بلا نهاية

19
00:01:37,200 --> 00:01:42,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:42,440 --> 00:01:48,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:11,500 --> 00:02:14,140
!ما الّذي تفعله؟! التقطها بسرعة

22
00:02:14,140 --> 00:02:15,770
!حسنًا

23
00:02:16,170 --> 00:02:17,440
.هدّئا من روعكما

24
00:02:18,140 --> 00:02:19,440
ما كلّ هذه الجلبة؟

25
00:02:19,780 --> 00:02:22,880
.سيأتون لأجلنا. يمكننا العودة إلى لولوكا

26
00:02:24,420 --> 00:02:26,890
!هل قادمون؟! ا-انتظر لحظة! مهلاً

27
00:02:27,350 --> 00:02:29,120
!أخرجني من هنا

28
00:02:29,120 --> 00:02:30,260
!أسرع

29
00:02:30,260 --> 00:02:30,820
!حسنًا

30
00:02:30,820 --> 00:02:32,120
!ا-انتظر

31
00:02:32,620 --> 00:02:35,230
!دعوني أذهب معكم أيضًا

32
00:02:35,630 --> 00:02:38,930
هل تريدون تركي هنا لوحدي؟

33
00:02:39,560 --> 00:02:42,200
!هل ستدعونني هنا لأموت من الجوع؟

34
00:02:42,200 --> 00:02:44,140
!...هيّا، أرجوك

35
00:02:44,140 --> 00:02:47,840
!أحضر المفتاح! لا تتركني

36
00:02:47,840 --> 00:02:49,870
.حسنًا، فهمت

37
00:02:50,310 --> 00:02:53,240
!شكرًا لك! أنا مدين لك لأجل هذا

38
00:02:57,480 --> 00:03:02,320
اشتباكٌ محتوم! مخطّطات"
".ويتّون وبرج قوس قزح

39
00:03:03,860 --> 00:03:08,630
!غومو غومو نوو: الصّاروخ

40
00:03:12,900 --> 00:03:14,770
!أفلتاني، سحقًا! أفلتاني

41
00:03:14,770 --> 00:03:16,370
!توقّف يا رابا نوي

42
00:03:16,370 --> 00:03:18,000
!لا بدّ أنّ هناك خطأ

43
00:03:18,370 --> 00:03:20,810
ما كان هينزو ليصبح أحد
.رجال ويتّون أبدًا

44
00:03:21,070 --> 00:03:23,640
هذا ليس بالشّيء الّذي يمكن
!التّغاضي عنه وكأنّه محض خطأ

45
00:03:23,640 --> 00:03:27,110
!لقد احترقت بلدتنا على يد ويتّون

46
00:03:28,680 --> 00:03:32,380
!احترقي! احترقي عن بكرة أبيك

47
00:03:32,620 --> 00:03:37,260
لو أنّه واصل حياته ولم ينسَ
،تلك المعاناة والبؤس

48
00:03:37,960 --> 00:03:40,890
فسيفضّل الموت على فعل
!أيّ ما يطلبه منه ويتّون

49
00:03:42,190 --> 00:03:46,660
أم أنّ تلك المشاعر تلاشت
!في السّنوات الخمسين أيضًا؟

50
00:03:48,400 --> 00:03:53,370
ما مضت عليه خمسون سنة بالنّسبة
!لك ما زال حديثَ العهد بالنّسبة لنا

51
00:03:53,970 --> 00:03:55,810
!انتظر يا رابا نوي

52
00:03:55,810 --> 00:03:58,210
!تقول هذا فقط لأنّك لا تعرف أيّ شيء

53
00:03:58,580 --> 00:04:03,310
هل تعي ما كان على هذا
العمّ التّعايش معه

54
00:04:03,310 --> 00:04:04,580
!لخمسين سنة؟

55
00:04:04,920 --> 00:04:05,650
ماذا...؟

56
00:04:05,920 --> 00:04:10,120
،كان محطّ انتقاد أهل البلدة
،نعتوه بكلب ويتّون

57
00:04:10,590 --> 00:04:15,430
إلاّ أنّه صبر على ذلك ليواصل
!بحثه عن ضباب قوس قزح

58
00:04:15,430 --> 00:04:16,090
لماذا؟

59
00:04:18,400 --> 00:04:22,230
!أليس هذا واضحًا؟ لأجل إنقاذكم

60
00:04:22,230 --> 00:04:27,210
.لا بأس. لا علاقة لذلك برابا نوي والبقيّة

61
00:04:28,570 --> 00:04:30,140
!اضربني يا رابا نوي

62
00:04:30,140 --> 00:04:35,280
تخلّيتُ عن عاري وفخري لأجل
!أن أعيش تحت حماية ويتّون

63
00:04:35,280 --> 00:04:37,380
!اضربني بقبضتك

64
00:04:38,420 --> 00:04:40,290
!هيّا اضربني

65
00:04:48,760 --> 00:04:52,800
سحقًا! لِمَ كان يجب أن تمرّ
!خمسون سنة؟

66
00:04:52,800 --> 00:04:56,330
مهما أردتُ ذلك، إلاّ أنّني لا أستطيع
!ضربك في سنّك هذا، أليس كذلك؟

67
00:05:05,580 --> 00:05:08,210
.تبًا، هؤلاء الأشخاص غرباء

68
00:05:08,910 --> 00:05:11,750
.هذا أفضل. أنتم أصدقاء على كلّ حال

69
00:05:11,750 --> 00:05:13,550
،مع أنّه مرّت خمسون سنة

70
00:05:13,550 --> 00:05:15,720
.إلاّ أنّكم ما زلتم تفهمون بعضكم

71
00:05:15,920 --> 00:05:17,290
...هينزو

72
00:05:17,920 --> 00:05:20,160
...رابا نوي

73
00:05:26,600 --> 00:05:27,670
!آسف

74
00:05:27,670 --> 00:05:28,270
!لوفي

75
00:05:28,270 --> 00:05:30,000
!ذلك الغبيّ

76
00:05:30,000 --> 00:05:31,270
.لا بأس

77
00:05:31,270 --> 00:05:33,340
.فداخل الضّباب أشبه بحلقة

78
00:05:33,340 --> 00:05:35,110
...سيعودان قريبًا

79
00:05:35,940 --> 00:05:37,110
أو ربّما لا؟

80
00:05:38,610 --> 00:05:40,550
ما العمل الآن؟

81
00:05:40,550 --> 00:05:41,680
.لنبحث عنهما

82
00:05:41,680 --> 00:05:43,980
لا يمكننا أن نعرف ما قد يحدث
.داخل الضّباب

83
00:05:45,520 --> 00:05:47,320
.إنّه مزعج حقًّا

84
00:05:47,690 --> 00:05:48,850
...رابا نوي

85
00:05:57,630 --> 00:05:59,430
...مـ-مؤلم

86
00:06:03,430 --> 00:06:04,870
أين نحن؟

87
00:06:10,640 --> 00:06:11,380
!أجل

88
00:06:16,550 --> 00:06:18,720
!هـ-هذا غير معقول

89
00:06:18,720 --> 00:06:20,620
!اهربي يا نامي

90
00:06:21,990 --> 00:06:23,690
!أنت، افعل شيئًا

91
00:06:23,690 --> 00:06:26,060
على هذا الحال، ستُلتهم
...نامي-سان من قِبل

92
00:06:28,390 --> 00:06:29,060
!سانجي

93
00:06:29,060 --> 00:06:30,630
وما همّي؟

94
00:06:30,630 --> 00:06:33,260
!هذا ما تستحقّونه لمحاولتكم استباقنا

95
00:06:33,500 --> 00:06:36,770
لكن يا جدّي، لا نستطيع
،الدّخول إلى "حفلة القرد" أيضًا

96
00:06:36,770 --> 00:06:39,240
.مع وجود ذلك الوحش

97
00:06:39,240 --> 00:06:41,070
.أدري ذلك

98
00:06:41,070 --> 00:06:44,210
لكن لا يوجد ما يمكننا
.فعله بخصوص ذلك الوحش

99
00:06:44,740 --> 00:06:46,680
!سأموت! سأموت

100
00:06:46,680 --> 00:06:47,980
!سأموت

101
00:06:51,350 --> 00:06:54,590
!وجدتها! استخدمي عُدّة الأمان يا آنسة

102
00:06:55,420 --> 00:06:56,820
عُدّة الأمان؟

103
00:06:56,820 --> 00:06:59,020
!إنّه شيء من اختراع الأستاذ هينزو

104
00:06:59,390 --> 00:07:02,490
!لقد اخترعها لهذا الموقف دون شكّ

105
00:07:02,490 --> 00:07:04,100
الأستاذ هينزو؟

106
00:07:04,100 --> 00:07:07,330
!لا أدري من تكون، لكن ساعدني رجاءً

107
00:07:10,300 --> 00:07:11,440
حبل سلامة؟

108
00:07:15,910 --> 00:07:16,910
!نامي-سان

109
00:07:17,240 --> 00:07:18,740
!نامي

110
00:07:23,180 --> 00:07:24,820
!لا، ابتعد عنّي

111
00:07:38,260 --> 00:07:39,330
مـ-ماذا؟

112
00:07:43,940 --> 00:07:45,500
ما كان ذلك للتّوّ؟

113
00:07:47,510 --> 00:07:49,170
!تشوبّر! رجاءً

114
00:07:53,180 --> 00:07:54,580
!مـ-ماذا أفعل؟

115
00:07:55,610 --> 00:07:56,950
!حسنًا، أمسكته

116
00:07:57,350 --> 00:07:59,450
.ها أنا ذي، سأدخل إلى الضّباب

117
00:07:59,450 --> 00:08:02,090
!اسحب الحبل عندما أعطيك الإشارة

118
00:08:03,220 --> 00:08:04,590
!لك ذلك

119
00:08:04,990 --> 00:08:07,490
إنّها جريئة حقًّا، أليست كذلك؟

120
00:08:07,890 --> 00:08:10,800
،لم يدخل أيّ أحد ضباب قوس قزح

121
00:08:10,800 --> 00:08:12,800
.وخرج منه

122
00:08:14,630 --> 00:08:16,500
.ستعود بكلّ تأكيد

123
00:08:16,800 --> 00:08:20,170
ففي النّهاية، نامي-سان هي
.أفضل ملاّحة في العالم

124
00:08:20,170 --> 00:08:22,840
تشوبّر، لا تدع أيّ أحد يلمس ذلك الحبل

125
00:08:22,840 --> 00:08:25,410
.حتّى تعود نامي-سان

126
00:08:25,410 --> 00:08:26,340
.مفهوم

127
00:08:26,910 --> 00:08:28,350
.سيكون هذا شيّقًا

128
00:08:28,980 --> 00:08:30,850
.دعوها تفعل هذا

129
00:08:31,350 --> 00:08:36,320
سنراقب ونرى ما إن كانت
.ستخرج من هناك بسلام

130
00:08:38,120 --> 00:08:38,960
ماذا؟

131
00:08:38,960 --> 00:08:41,230
!سيغيّر المحافظ زيّه الآن

132
00:08:43,260 --> 00:08:44,560
ماذا؟

133
00:08:47,830 --> 00:08:49,500
!بذلة اللّهب

134
00:08:49,870 --> 00:08:54,240
!ابدؤوا تعبئة العنصر

135
00:08:56,440 --> 00:08:57,940
!تمّ تحرير آلية السّلامة

136
00:08:58,610 --> 00:09:00,710
!سأحرقكما حتّى النّخاع

137
00:09:09,220 --> 00:09:11,590
!مهلاً، انتظر لحظة
!إلى أين نحن ذاهبان؟

138
00:09:11,890 --> 00:09:14,460
أليس هذا واضحًا؟
.سنعود إلى أصدقائنا

139
00:09:14,460 --> 00:09:18,460
حقًّا؟ هل تعرف طريقة
للرّجوع إلى أصدقائنا؟

140
00:09:18,460 --> 00:09:19,800
.كلاّ. طبعًا لا أعرف

141
00:09:21,570 --> 00:09:22,270
ما الخطب؟

142
00:09:22,670 --> 00:09:25,400
نحن نركض عشوائيًّا فحسب إذًا؟

143
00:09:25,400 --> 00:09:28,140
.غير صحيح. لدي حدس

144
00:09:28,570 --> 00:09:30,640
.هذا يعني أنّنا نركض عبثًا

145
00:09:30,910 --> 00:09:35,110
!وإنّها غلطتك لجلبي إلى هنا من الأساس

146
00:09:35,350 --> 00:09:36,180
.آسف

147
00:09:36,180 --> 00:09:38,520
!لن يُصلح الاعتذار هذه الفوضى

148
00:09:38,520 --> 00:09:41,090
،لقد اجتمعتُ بهينزو أخيرًا

149
00:09:41,090 --> 00:09:43,150
.إلاّ أنّني لم أصافحه حتّى

150
00:09:43,920 --> 00:09:47,060
.لن أرجع إلى لولوكا الآن أبدًا أيضًا

151
00:09:47,630 --> 00:09:48,760
!سحقًا

152
00:09:50,730 --> 00:09:54,430
،سأموت هنا في هذا الضّباب
.كما مات أبي

153
00:09:54,430 --> 00:09:55,570
أبوك؟

154
00:09:55,930 --> 00:09:57,940
.كان أبي ضابط بحريّة

155
00:09:58,440 --> 00:09:59,940
،عندما كنتُ طفلاً

156
00:09:59,940 --> 00:10:02,440
ذهب في رحلة طويلة لاستكشاف
.بعض المناطق المجهولة في البحار

157
00:10:03,270 --> 00:10:08,180
.وظللتُ منتظرًا عودته منذئذٍ

158
00:10:09,280 --> 00:10:13,920
حتّى الآن، ما زال أبي"
".يُغامر في بحرٍ ما

159
00:10:13,920 --> 00:10:15,250
...هذا ما أخبرتُ نفسي. ولكن

160
00:10:23,960 --> 00:10:26,360
!أبي! أبي

161
00:10:26,760 --> 00:10:29,370
،بحثتُ باستماتة في كلّ أرجاء السّفينة

162
00:10:29,370 --> 00:10:31,800
.إلاّ أنّني لم أجد أبي في أيّ مكان

163
00:10:31,800 --> 00:10:35,210
.لن نخرج من هنا أحياء بالتّأكيد

164
00:10:35,210 --> 00:10:38,480
سنظلّ محبوسين داخل
.هذا الضّباب إلى الأبد

165
00:10:44,650 --> 00:10:46,420
مهلاً، إلى أين ذاهب؟

166
00:10:46,420 --> 00:10:48,290
.كما أخبرتك، لأعود إلى أصدقائي

167
00:10:48,290 --> 00:10:51,260
!لكن كيف؟! لا نعرف أين نحن حتّى

168
00:10:51,260 --> 00:10:54,090
إلاّ أنّك ستواصل المضيّ قدمًا
!داخل هذا الضّباب؟

169
00:10:54,660 --> 00:10:55,990
،إلّم نمضِ قدمًا

170
00:10:55,990 --> 00:10:58,060
لن نرجع إلى أصدقائنا، صحيح؟

171
00:11:25,970 --> 00:11:27,110
كيف الأمر من جهتك؟

172
00:11:27,110 --> 00:11:29,640
.لا فائدة. لم أرهما في أيّ مكان

173
00:11:30,240 --> 00:11:35,210
من المحتمل أنّهما رُمِيا
.إلى الجانب الآخر من الضّباب

174
00:11:35,610 --> 00:11:39,050
ماذا تقصد؟ ما عاد رابا نوي هنا؟

175
00:11:39,990 --> 00:11:41,520
.ذلك مرجّح

176
00:11:41,820 --> 00:11:42,950
...لا

177
00:11:48,890 --> 00:11:51,760
،تلك سفينة شراعيّة قديمة
.تعود لـ200 عام

178
00:11:52,430 --> 00:11:54,330
.لم أر تلك السّفينة من قبل

179
00:11:55,170 --> 00:11:57,970
،"من الممكن أنّ داخل "حفلة القرد

180
00:11:57,970 --> 00:11:59,800
...مسار الوقت نفسه

181
00:11:59,800 --> 00:12:02,440
!يا رفاق

182
00:12:07,410 --> 00:12:09,250
.هذه أنت يا نامي

183
00:12:09,250 --> 00:12:11,420
!ماذا تقصد بـ"هذه أنت"؟

184
00:12:11,420 --> 00:12:14,750
بعد أن قطعتُ كلّ هذه
!المسافة لإنقاذكم

185
00:12:14,750 --> 00:12:16,220
!يا لوقاحتك

186
00:12:16,220 --> 00:12:19,520
.كلامك غير مقنع بتاتًا

187
00:12:20,790 --> 00:12:22,430
.لا يهمّ، لا يهمّ

188
00:12:22,430 --> 00:12:24,300
ماذا؟ من هؤلاء الأطفال؟

189
00:12:24,900 --> 00:12:26,130
أين ذهب لوفي؟

190
00:12:26,570 --> 00:12:28,970
.ما الخطب؟ تبدون كئيبين جميعًا

191
00:12:29,600 --> 00:12:30,770
هل حدث شيء؟

192
00:12:31,270 --> 00:12:33,710
.لقد قُذفا خلف الضّباب

193
00:12:34,370 --> 00:12:37,840
.كما قلت، لقد رحلا. ما عادا هنا

194
00:12:37,840 --> 00:12:39,580
ماذا تقصد؟

195
00:12:39,580 --> 00:12:41,350
.كما قال

196
00:12:41,780 --> 00:12:45,380
،لم تكوني هنا لتشهدي على ذلك
.لذا يستحيل علينا أن نشرح لك

197
00:12:46,280 --> 00:12:48,820
!حسنًا. سننسحب

198
00:12:50,020 --> 00:12:51,090
!مهلاً لحظة

199
00:12:51,090 --> 00:12:52,860
!ماذا عن لوفي؟

200
00:12:52,860 --> 00:12:56,130
لا أدري ما حدث، لكن يستحيل
أنّه مات، أليس كذلك؟

201
00:12:56,130 --> 00:12:57,560
.دعوه فحسب، لا مشكلة

202
00:12:57,560 --> 00:12:59,130
!هيّا، سنرجع

203
00:12:59,630 --> 00:13:01,730
هل توجد طريقة للخروج؟

204
00:13:02,430 --> 00:13:03,400
.نوعًا ما

205
00:13:03,700 --> 00:13:05,500
!إنّه مجرّد حبل، أليس كذلك؟

206
00:13:06,170 --> 00:13:08,770
أنتم من أتوا من لولوكا، أليس كذلك؟

207
00:13:12,410 --> 00:13:13,480
!إيان

208
00:13:13,480 --> 00:13:15,110
من ذلك الشّخص؟

209
00:13:15,110 --> 00:13:16,280
.أحد أتباع ويتّون

210
00:13:16,620 --> 00:13:19,250
ما الّذي يفعله ذلك الشّخص هنا؟

211
00:13:22,290 --> 00:13:24,460
ما رأيك أن تناوليني ذلك الحبل؟

212
00:13:24,460 --> 00:13:25,820
ولِمَ عساي أفعل؟

213
00:13:25,820 --> 00:13:27,790
،إن كنتَ تريد الخروج أيضًا

214
00:13:27,790 --> 00:13:29,930
بوسعك أن تأتي معنا فحسب، صحيح؟

215
00:13:30,130 --> 00:13:32,560
ألا تهتمّين بمَ قد يحدث له؟

216
00:13:34,970 --> 00:13:35,930
.كلاّ، لا أهتمّ

217
00:13:36,600 --> 00:13:37,570
!ماذا؟

218
00:13:37,870 --> 00:13:39,570
من ذلك الطّفل على أيّ حال؟

219
00:13:39,570 --> 00:13:43,280
لستُ كريمةً لدرجة أن أنقذ
.طفلاً لم أره من قبل

220
00:13:43,280 --> 00:13:45,010
.صحيح، معك حقّ

221
00:13:45,410 --> 00:13:48,250
!ماذا؟! أيّتها النّذلة
!سأطلق عليه! سأفعل

222
00:13:49,480 --> 00:13:50,680
!أيّتها القاتلة

223
00:13:52,650 --> 00:13:54,650
!افعلي ما يقوله

224
00:13:54,650 --> 00:13:56,690
...ماذا؟ هذا سخيف

225
00:13:57,320 --> 00:13:58,660
!مـ-مهلاً، توقّفي

226
00:13:58,660 --> 00:14:01,060
!لا أريد أن أفقد المزيد من أصدقائي

227
00:14:01,060 --> 00:14:02,830
!افعلي ما يقوله رجاءً

228
00:14:04,430 --> 00:14:06,230
!أحسنت يا إيسوكا-تشان

229
00:14:06,230 --> 00:14:08,500
،بينما أنت بصدد ذلك
.اربطي الحبل بالقارب أيضًا

230
00:14:13,470 --> 00:14:15,540
إيسوكا-تشان، لِمَ لا تأتين معي؟

231
00:14:15,540 --> 00:14:18,440
لن نضطرّ للعمل مجدّدًا
.بامتلاكنا لكلّ هذا الكنز

232
00:14:18,780 --> 00:14:22,750
لا تسئ فهمي! رابا نوي
!هو قائدنا الوحيد

233
00:14:22,750 --> 00:14:25,420
!لا أملك أيّ نيّة في اتّباع جبان مثلك

234
00:14:25,950 --> 00:14:26,890
!ماذا؟

235
00:14:28,250 --> 00:14:29,590
!اهربي يا إيسوكا

236
00:14:29,590 --> 00:14:30,520
!الويل لك

237
00:14:32,020 --> 00:14:33,290
!رونغو

238
00:14:33,290 --> 00:14:34,760
!كيف تجرئين على العبث معي؟

239
00:14:34,760 --> 00:14:36,060
!توقّف

240
00:14:39,360 --> 00:14:42,330
!سحقًا، أفلتيني! أفلتيني

241
00:14:45,300 --> 00:14:47,110
مهلاً، ما الخطب؟

242
00:14:47,110 --> 00:14:48,410
...كايروسيكي

243
00:14:48,410 --> 00:14:49,510
!ماذا؟

244
00:14:53,080 --> 00:14:54,480
!سحقًا

245
00:14:55,850 --> 00:14:57,580
!انتظر أيّها الوغد

246
00:14:57,580 --> 00:14:58,820
!إيّاك أن تخطئ

247
00:14:59,120 --> 00:15:03,160
!أطلق عليه بسرعة
!أسرع! أسرع! أسرع

248
00:14:59,850 --> 00:15:02,820
،ا-انتظري، دعيني أصوّب
!دعيني أصوّب، دعيني أصوّب

249
00:15:02,820 --> 00:15:03,760
!لا أستطيع أن أُطلق

250
00:15:06,260 --> 00:15:08,290
!احترقا! احترقا

251
00:15:11,830 --> 00:15:14,400
!لا فائدة! لا يمكنني الابتعاد هكذا

252
00:15:16,430 --> 00:15:17,540
!رامبل

253
00:15:23,580 --> 00:15:24,710
!ليك، ها هو ذا

254
00:15:29,680 --> 00:15:30,720
!لن أدعك تهرب

255
00:15:31,120 --> 00:15:32,720
!شرارة التّنّين

256
00:15:34,890 --> 00:15:35,820
!تشوبّر

257
00:15:35,820 --> 00:15:38,160
!لا يجب أن تشيح نظرك عن خصمك

258
00:15:39,190 --> 00:15:40,630
!ما هذا؟

259
00:15:40,630 --> 00:15:42,890
!الشّواء الفضّيّ

260
00:15:43,430 --> 00:15:44,560
!شـ-شواء؟

261
00:15:45,960 --> 00:15:48,130
هلاّ أطبقت فمك؟

262
00:15:48,130 --> 00:15:52,300
.أنتما خير مثال للّذين لا يعرفون حدّهم

263
00:15:53,940 --> 00:15:56,140
!جدّي، إنّه يُسحب، يُسحب

264
00:15:56,140 --> 00:16:01,480
أتقصد أنّ تلك الفتاة
عائدة من داخل الضّباب حقًّا؟

265
00:16:01,480 --> 00:16:03,480
!أنت، اسحبها إلى هنا

266
00:16:03,480 --> 00:16:03,850
!حسنًا

267
00:16:05,920 --> 00:16:06,590
.ليس بعد

268
00:16:06,590 --> 00:16:07,720
ماذا؟

269
00:16:07,720 --> 00:16:10,390
،وعدتُ نامي أنّه إلى حين عودتها

270
00:16:10,390 --> 00:16:12,720
!لن أدع أيّ أحد يلمس هذا الحبل

271
00:16:12,920 --> 00:16:14,130
!لا تدفعني للضّحك

272
00:16:14,360 --> 00:16:17,730
!لتذهب إلى الجحيم أنت ووعدك
!أنت مثير للشّفقة وعنيد

273
00:16:17,730 --> 00:16:19,830
!هل تريدون الذّهب بهذا القدر؟

274
00:16:20,270 --> 00:16:22,600
.لا نريد ذلك

275
00:16:23,000 --> 00:16:25,800
.ستعود نامي-سان بكلّ تأكيد

276
00:16:26,140 --> 00:16:30,280
.نحن نحرس مكان عودتها بحياتنا فحسب

277
00:16:35,380 --> 00:16:37,320
!ركلة الخدّ

278
00:16:40,450 --> 00:16:42,890
!تمثيليّة الصّداقة هذه تصيبني بالاشمئزاز

279
00:16:43,320 --> 00:16:45,560
!أيّها المحافظ! ثمّة قارب راجع

280
00:16:45,960 --> 00:16:49,530
.حسنًا، اسحبوا الحبل وأرشدوه إلى هنا

281
00:16:52,730 --> 00:16:56,970
يا لكم من أطفال أغبياء
!لتعيشوا في هذا الضّباب إلى الأبد

282
00:16:57,640 --> 00:17:01,910
من المنعش حقًّا أن تكون
!تحت سماءٍ زرقاء

283
00:17:02,170 --> 00:17:04,910
!إنّي أراها، ها هي ذي! بلدة لولوكا

284
00:17:07,710 --> 00:17:09,510
أ-أذلك...؟

285
00:17:14,220 --> 00:17:15,920
!...ليست نامي

286
00:17:16,890 --> 00:17:18,390
مـ-من أنت؟

287
00:17:19,290 --> 00:17:21,860
!أعتذر على غيابي الطّويل! أنا إيان

288
00:17:22,560 --> 00:17:26,630
أيّها القائد ويتّون، تبدو في مظهر
!أفضل من أيّ وقت

289
00:17:26,900 --> 00:17:27,830
أ-أنا؟

290
00:17:28,230 --> 00:17:30,540
.أنا بخير، نعم

291
00:17:30,540 --> 00:17:32,540
إيان؟ هل قلت إيان؟

292
00:17:33,040 --> 00:17:35,340
إيان الّذي كان يعمل تحت إمرتي؟

293
00:17:35,570 --> 00:17:39,340
ماذا؟ من هذا العجوز أيّها القائد؟

294
00:17:39,340 --> 00:17:40,150
...في الواقع

295
00:17:40,510 --> 00:17:42,980
!أنا القائد! أنا هو ويتّون

296
00:17:43,250 --> 00:17:44,750
ماذا؟ من هذا إذًا؟

297
00:17:44,750 --> 00:17:45,880
.حفيدي، ليك

298
00:17:45,880 --> 00:17:47,490
.وأنا ابنه، فيليب

299
00:17:47,490 --> 00:17:50,990
لا بدّ أنّك تمزح! هل أنت
ذلك القزم المبلّل لفراشه؟

300
00:17:50,990 --> 00:17:54,760
!حتّى أنّ لديك ابنًا الآن؟
!هذا صاعق

301
00:17:54,760 --> 00:17:56,960
!كفّوا عن الضّحك
!قلت كفّوا عن الضّحك

302
00:17:56,960 --> 00:18:00,100
.أخبرني عن داخل الضّباب يا إيان

303
00:18:00,100 --> 00:18:01,270
.حـ-حاضر

304
00:18:01,700 --> 00:18:02,830
.تفضّلا، اشربا

305
00:18:02,830 --> 00:18:04,870
!مذهل، شكرًا

306
00:18:04,870 --> 00:18:05,440
وإذًا؟

307
00:18:05,440 --> 00:18:07,370
.لا فائدة، لا يمكنني الاتّصال

308
00:18:07,370 --> 00:18:09,810
،لا بدّ أنّها كانت حالة استثنائيّة

309
00:18:09,810 --> 00:18:11,710
.عندما التقطنا الإشارة سابقًا

310
00:18:12,140 --> 00:18:13,550
...شاء الحظّ

311
00:18:13,550 --> 00:18:17,680
أن توجد قطعة من الجواهر
...تحتوي على حجر بحريّ

312
00:18:18,250 --> 00:18:19,420
حجر بحريّ؟

313
00:18:19,750 --> 00:18:21,420
.إنّه بلّور بحريّ

314
00:18:21,420 --> 00:18:24,890
يملك القدرة على إلغاء
.قوى فاكهة الشّيطان

315
00:18:24,890 --> 00:18:28,730
يا إلهي، لا فائدة من امتلاك
كلّ هذا الذّهب

316
00:18:28,730 --> 00:18:31,330
.إن كنّا لا نستطيع الخروج به من هنا

317
00:18:31,330 --> 00:18:34,200
.أنت ملاّحة، صحيح؟ افعلي شيئًا

318
00:18:34,200 --> 00:18:37,100
لا يمكنني فعل شيء. فهذه أوّل مرّة
.أرى فيها منطقة سخيفة كهذه في البحر

319
00:18:37,100 --> 00:18:38,740
لا نملك خيارًا، صحيح؟

320
00:18:38,740 --> 00:18:41,070
.لا، سيعود

321
00:18:41,070 --> 00:18:42,440
ماذا؟

322
00:18:42,440 --> 00:18:46,810
هدف ويتّون الأسمى هو
."الذّهب القابع داخل "حفلة القرد

323
00:18:47,050 --> 00:18:49,210
،وبما أنّ تابعه إيان عاد حيًّا

324
00:18:49,210 --> 00:18:52,380
.سيبعث قوّات هائلة لاقتحام هذا المكان

325
00:18:52,380 --> 00:18:53,750
!لا يعقل

326
00:18:53,750 --> 00:18:54,920
!لنقاتل

327
00:18:54,920 --> 00:18:56,760
!لن نسلّم هذا الكنز لأيّ أحد

328
00:18:56,760 --> 00:18:58,060
...انظري إلى حالك

329
00:18:58,060 --> 00:19:01,330
...فقط لو أنّ رابا نوي كان معنا

330
00:19:10,540 --> 00:19:13,170
!أنت، اصمد

331
00:19:13,170 --> 00:19:14,140
!سحقًا

332
00:19:14,710 --> 00:19:15,610
!لا فائدة

333
00:19:15,610 --> 00:19:18,180
،مهما قمنا بالتّجديف
!ينتهي بنا المطاف حيث بدأنا

334
00:19:18,640 --> 00:19:23,010
.هذا مستحيل حقًّا
.لا يمكننا الخروج من هذا الضّباب

335
00:19:23,010 --> 00:19:24,750
ذلك ليس سيّئًا جدًّا، أليس كذلك؟

336
00:19:26,080 --> 00:19:27,890
.نحن الوحيدون هنا

337
00:19:27,890 --> 00:19:30,520
،يمكننا أن ننام متى شئنا
.ونلعب متى شئنا

338
00:19:30,520 --> 00:19:31,890
.إنّها جنّتنا

339
00:19:31,890 --> 00:19:33,990
!أرضُ الحرّيّة، أرض البقاء

340
00:19:33,990 --> 00:19:35,330
!رابا نوي

341
00:19:35,690 --> 00:19:40,230
.لسنا بحاجة للعودة إلى الدّيار
.لنصنع أرضنا بأنفسنا

342
00:19:40,770 --> 00:19:43,540
.أريد أن أعود إلى الدّيار، إلى بلدتنا

343
00:19:44,070 --> 00:19:46,240
.أريد أن أعود إلى لولوكا

344
00:19:50,140 --> 00:19:51,140
أبي؟

345
00:19:53,180 --> 00:19:55,680
!أبي... أبي

346
00:20:00,950 --> 00:20:02,320
ما ذلك الضّوء؟

347
00:20:03,920 --> 00:20:05,290
مهلاً، أليس ذلك...؟

348
00:20:05,290 --> 00:20:06,560
!مخرج

349
00:20:08,960 --> 00:20:12,760
أخيرًا سيتحقّق حلمي الّذي
.انتظرته 50 سنة

350
00:20:12,760 --> 00:20:18,570
ضباب قوس قزح وهذا العالم
.سيندمجان إلى الأبد

351
00:20:40,930 --> 00:20:42,530
!مـ-ما ذلك؟

352
00:20:59,010 --> 00:21:01,610
!يا رفاق، تمسّكوا بشيء جميعًا

353
00:21:04,620 --> 00:21:06,590
!مـ-ما ذلك؟

354
00:21:06,590 --> 00:21:08,550
!إنّه برج قوس قزح

355
00:21:10,290 --> 00:21:11,820
!يا للهول، كان ذلك وشيكًا

356
00:21:12,560 --> 00:21:13,530
.خذ قبّعتك

357
00:21:13,530 --> 00:21:14,890
.شكرًا لك

358
00:21:14,890 --> 00:21:16,500
بالمناسبة، ما ذلك؟

359
00:21:17,300 --> 00:21:20,370
."إنّهم ينوون اقتحام "حفلة القرد

360
00:21:20,370 --> 00:21:22,070
ماذا؟ من هم؟

361
00:21:22,070 --> 00:21:24,340
!لنسرع على أيّ حال. الجميع في خطر

362
00:21:29,840 --> 00:21:32,310
.أتيتَ أخيرًا إذًا يا ويتّون

363
00:21:32,640 --> 00:21:34,550
!تابعوا يا رجال

364
00:21:38,120 --> 00:21:42,450
لا تتركوا أيّ قطعة من الكنوز
!"في "حفلة القرد

365
00:21:55,430 --> 00:22:03,500
آه، خلف السّماء الّتي لا نهاية لها

366
00:22:03,500 --> 00:22:14,120
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

367
00:22:21,990 --> 00:22:29,430
مرّت عليّ أيّام كدت أخسر فيها نفسي

368
00:22:29,430 --> 00:22:37,840
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

369
00:22:37,840 --> 00:22:46,050
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

370
00:22:46,050 --> 00:22:54,890
دفعوا بي للأمام، أليس كذلك؟

371
00:22:54,890 --> 00:23:03,200
آه، إنّ النّجوم تهوي من السّماء

372
00:23:03,200 --> 00:23:06,330
...وهذه اللّحظة الفريدة

373
00:23:11,710 --> 00:23:13,140
!أتى ويتّون

374
00:23:13,140 --> 00:23:16,010
لكنّنا نواجه المحافظ، صحيح؟
.لديه الكثير من الأتباع

375
00:23:16,010 --> 00:23:20,380
،قاومته كلّ هذا الوقت لوحدي
.ولم أسلّم له قلبي

376
00:23:20,380 --> 00:23:23,380
.ألم تنس بشأننا؟ لست وحدك

377
00:23:23,380 --> 00:23:27,560
!لن أدعك تدنّس جنّة قراصنة اليقطين

378
00:23:27,560 --> 00:23:29,190
:في الحلقة القادمة من ون بيس

379
00:23:29,190 --> 00:23:32,360
!وهكذا تبدأ الأسطورة"
".الجانب الآخر من قوس قزح

380
00:23:32,360 --> 00:23:34,500
!ملك القراصنة، لن يكون إلاّ أنا