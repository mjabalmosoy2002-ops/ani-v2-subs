1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:25,500 --> 00:02:28,140
!ما الّذي تفعله؟! التقطها بسرعة

22
00:02:28,140 --> 00:02:29,770
!حسنًا

23
00:02:30,170 --> 00:02:31,440
.هدّئا من روعكما

24
00:02:32,140 --> 00:02:33,440
ما كلّ هذه الجلبة؟

25
00:02:33,780 --> 00:02:36,880
.سيأتون لأجلنا. يمكننا العودة إلى لولوكا

26
00:02:38,420 --> 00:02:40,890
!هل قادمون؟! ا-انتظر لحظة! مهلاً

27
00:02:41,350 --> 00:02:43,120
!أخرجني من هنا

28
00:02:43,120 --> 00:02:44,260
!أسرع

29
00:02:44,260 --> 00:02:44,820
!حسنًا

30
00:02:44,820 --> 00:02:46,120
!ا-انتظر

31
00:02:46,620 --> 00:02:49,230
!دعوني أذهب معكم أيضًا

32
00:02:49,630 --> 00:02:52,930
هل تريدون تركي هنا لوحدي؟

33
00:02:53,560 --> 00:02:56,200
!هل ستدعونني هنا لأموت من الجوع؟

34
00:02:56,200 --> 00:02:58,140
!...هيّا، أرجوك

35
00:02:58,140 --> 00:03:01,840
!أحضر المفتاح! لا تتركني

36
00:03:01,840 --> 00:03:03,870
.حسنًا، فهمت

37
00:03:04,310 --> 00:03:07,240
!شكرًا لك! أنا مدين لك لأجل هذا

38
00:03:11,480 --> 00:03:16,320
اشتباكٌ محتوم! مخطّطات"
".ويتّون وبرج قوس قزح

39
00:03:17,860 --> 00:03:22,630
!غومو غومو نوو: الصّاروخ

40
00:03:26,900 --> 00:03:28,770
!أفلتاني، سحقًا! أفلتاني

41
00:03:28,770 --> 00:03:30,370
!توقّف يا رابا نوي

42
00:03:30,370 --> 00:03:32,000
!لا بدّ أنّ هناك خطأ

43
00:03:32,370 --> 00:03:34,810
ما كان هينزو ليصبح أحد
.رجال ويتّون أبدًا

44
00:03:35,070 --> 00:03:37,640
هذا ليس بالشّيء الّذي يمكن
!التّغاضي عنه وكأنّه محض خطأ

45
00:03:37,640 --> 00:03:41,110
!لقد احترقت بلدتنا على يد ويتّون

46
00:03:42,680 --> 00:03:46,380
!احترقي! احترقي عن بكرة أبيك

47
00:03:46,620 --> 00:03:51,260
لو أنّه واصل حياته ولم ينسَ
،تلك المعاناة والبؤس

48
00:03:51,960 --> 00:03:54,890
فسيفضّل الموت على فعل
!أيّ ما يطلبه منه ويتّون

49
00:03:56,190 --> 00:04:00,660
أم أنّ تلك المشاعر تلاشت
!في السّنوات الخمسين أيضًا؟

50
00:04:02,400 --> 00:04:07,370
ما مضت عليه خمسون سنة بالنّسبة
!لك ما زال حديثَ العهد بالنّسبة لنا

51
00:04:07,970 --> 00:04:09,810
!انتظر يا رابا نوي

52
00:04:09,810 --> 00:04:12,210
!تقول هذا فقط لأنّك لا تعرف أيّ شيء

53
00:04:12,580 --> 00:04:17,310
هل تعي ما كان على هذا
العمّ التّعايش معه

54
00:04:17,310 --> 00:04:18,580
!لخمسين سنة؟

55
00:04:18,920 --> 00:04:19,650
ماذا...؟

56
00:04:19,920 --> 00:04:24,120
،كان محطّ انتقاد أهل البلدة
،نعتوه بكلب ويتّون

57
00:04:24,590 --> 00:04:29,430
إلاّ أنّه صبر على ذلك ليواصل
!بحثه عن ضباب قوس قزح

58
00:04:29,430 --> 00:04:30,090
لماذا؟

59
00:04:32,400 --> 00:04:36,230
!أليس هذا واضحًا؟ لأجل إنقاذكم

60
00:04:36,230 --> 00:04:41,210
.لا بأس. لا علاقة لذلك برابا نوي والبقيّة

61
00:04:42,570 --> 00:04:44,140
!اضربني يا رابا نوي

62
00:04:44,140 --> 00:04:49,280
تخلّيتُ عن عاري وفخري لأجل
!أن أعيش تحت حماية ويتّون

63
00:04:49,280 --> 00:04:51,380
!اضربني بقبضتك

64
00:04:52,420 --> 00:04:54,290
!هيّا اضربني

65
00:05:02,760 --> 00:05:06,800
سحقًا! لِمَ كان يجب أن تمرّ
!خمسون سنة؟

66
00:05:06,800 --> 00:05:10,330
مهما أردتُ ذلك، إلاّ أنّني لا أستطيع
!ضربك في سنّك هذا، أليس كذلك؟

67
00:05:19,580 --> 00:05:22,210
.تبًا، هؤلاء الأشخاص غرباء

68
00:05:22,910 --> 00:05:25,750
.هذا أفضل. أنتم أصدقاء على كلّ حال

69
00:05:25,750 --> 00:05:27,550
،مع أنّه مرّت خمسون سنة

70
00:05:27,550 --> 00:05:29,720
.إلاّ أنّكم ما زلتم تفهمون بعضكم

71
00:05:29,920 --> 00:05:31,290
...هينزو

72
00:05:31,920 --> 00:05:34,160
...رابا نوي

73
00:05:40,600 --> 00:05:41,670
!آسف

74
00:05:41,670 --> 00:05:42,270
!لوفي

75
00:05:42,270 --> 00:05:44,000
!ذلك الغبيّ

76
00:05:44,000 --> 00:05:45,270
.لا بأس

77
00:05:45,270 --> 00:05:47,340
.فداخل الضّباب أشبه بحلقة

78
00:05:47,340 --> 00:05:49,110
...سيعودان قريبًا

79
00:05:49,940 --> 00:05:51,110
أو ربّما لا؟

80
00:05:52,610 --> 00:05:54,550
ما العمل الآن؟

81
00:05:54,550 --> 00:05:55,680
.لنبحث عنهما

82
00:05:55,680 --> 00:05:57,980
لا يمكننا أن نعرف ما قد يحدث
.داخل الضّباب

83
00:05:59,520 --> 00:06:01,320
.إنّه مزعج حقًّا

84
00:06:01,690 --> 00:06:02,850
...رابا نوي

85
00:06:11,630 --> 00:06:13,430
...مـ-مؤلم

86
00:06:17,430 --> 00:06:18,870
أين نحن؟

87
00:06:24,640 --> 00:06:25,380
!أجل

88
00:06:30,550 --> 00:06:32,720
!هـ-هذا غير معقول

89
00:06:32,720 --> 00:06:34,620
!اهربي يا نامي

90
00:06:35,990 --> 00:06:37,690
!أنت، افعل شيئًا

91
00:06:37,690 --> 00:06:40,060
على هذا الحال، ستُلتهم
...نامي-سان من قِبل

92
00:06:42,390 --> 00:06:43,060
!سانجي

93
00:06:43,060 --> 00:06:44,630
وما همّي؟

94
00:06:44,630 --> 00:06:47,260
!هذا ما تستحقّونه لمحاولتكم استباقنا

95
00:06:47,500 --> 00:06:50,770
لكن يا جدّي، لا نستطيع
،الدّخول إلى "حفلة القرد" أيضًا

96
00:06:50,770 --> 00:06:53,240
.مع وجود ذلك الوحش

97
00:06:53,240 --> 00:06:55,070
.أدري ذلك

98
00:06:55,070 --> 00:06:58,210
لكن لا يوجد ما يمكننا
.فعله بخصوص ذلك الوحش

99
00:06:58,740 --> 00:07:00,680
!سأموت! سأموت

100
00:07:00,680 --> 00:07:01,980
!سأموت

101
00:07:05,350 --> 00:07:08,590
!وجدتها! استخدمي عُدّة الأمان يا آنسة

102
00:07:09,420 --> 00:07:10,820
عُدّة الأمان؟

103
00:07:10,820 --> 00:07:13,020
!إنّه شيء من اختراع الأستاذ هينزو

104
00:07:13,390 --> 00:07:16,490
!لقد اخترعها لهذا الموقف دون شكّ

105
00:07:16,490 --> 00:07:18,100
الأستاذ هينزو؟

106
00:07:18,100 --> 00:07:21,330
!لا أدري من تكون، لكن ساعدني رجاءً

107
00:07:24,300 --> 00:07:25,440
حبل سلامة؟

108
00:07:29,910 --> 00:07:30,910
!نامي-سان

109
00:07:31,240 --> 00:07:32,740
!نامي

110
00:07:37,180 --> 00:07:38,820
!لا، ابتعد عنّي

111
00:07:52,260 --> 00:07:53,330
مـ-ماذا؟

112
00:07:57,940 --> 00:07:59,500
ما كان ذلك للتّوّ؟

113
00:08:01,510 --> 00:08:03,170
!تشوبّر! رجاءً

114
00:08:07,180 --> 00:08:08,580
!مـ-ماذا أفعل؟

115
00:08:09,610 --> 00:08:10,950
!حسنًا، أمسكته

116
00:08:11,350 --> 00:08:13,450
.ها أنا ذي، سأدخل إلى الضّباب

117
00:08:13,450 --> 00:08:16,090
!اسحب الحبل عندما أعطيك الإشارة

118
00:08:17,220 --> 00:08:18,590
!لك ذلك

119
00:08:18,990 --> 00:08:21,490
إنّها جريئة حقًّا، أليست كذلك؟

120
00:08:21,890 --> 00:08:24,800
،لم يدخل أيّ أحد ضباب قوس قزح

121
00:08:24,800 --> 00:08:26,800
.وخرج منه

122
00:08:28,630 --> 00:08:30,500
.ستعود بكلّ تأكيد

123
00:08:30,800 --> 00:08:34,170
ففي النّهاية، نامي-سان هي
.أفضل ملاّحة في العالم

124
00:08:34,170 --> 00:08:36,840
تشوبّر، لا تدع أيّ أحد يلمس ذلك الحبل

125
00:08:36,840 --> 00:08:39,410
.حتّى تعود نامي-سان

126
00:08:39,410 --> 00:08:40,340
.مفهوم

127
00:08:40,910 --> 00:08:42,350
.سيكون هذا شيّقًا

128
00:08:42,980 --> 00:08:44,850
.دعوها تفعل هذا

129
00:08:45,350 --> 00:08:50,320
سنراقب ونرى ما إن كانت
.ستخرج من هناك بسلام

130
00:08:52,120 --> 00:08:52,960
ماذا؟

131
00:08:52,960 --> 00:08:55,230
!سيغيّر المحافظ زيّه الآن

132
00:08:57,260 --> 00:08:58,560
ماذا؟

133
00:09:01,830 --> 00:09:03,500
!بذلة اللّهب

134
00:09:03,870 --> 00:09:08,240
!ابدؤوا تعبئة العنصر

135
00:09:10,440 --> 00:09:11,940
!تمّ تحرير آلية السّلامة

136
00:09:12,610 --> 00:09:14,710
!سأحرقكما حتّى النّخاع

137
00:09:23,220 --> 00:09:25,590
!مهلاً، انتظر لحظة
!إلى أين نحن ذاهبان؟

138
00:09:25,890 --> 00:09:28,460
أليس هذا واضحًا؟
.سنعود إلى أصدقائنا

139
00:09:28,460 --> 00:09:32,460
حقًّا؟ هل تعرف طريقة
للرّجوع إلى أصدقائنا؟

140
00:09:32,460 --> 00:09:33,800
.كلاّ. طبعًا لا أعرف

141
00:09:35,570 --> 00:09:36,270
ما الخطب؟

142
00:09:36,670 --> 00:09:39,400
نحن نركض عشوائيًّا فحسب إذًا؟

143
00:09:39,400 --> 00:09:42,140
.غير صحيح. لدي حدس

144
00:09:42,570 --> 00:09:44,640
.هذا يعني أنّنا نركض عبثًا

145
00:09:44,910 --> 00:09:49,110
!وإنّها غلطتك لجلبي إلى هنا من الأساس

146
00:09:49,350 --> 00:09:50,180
.آسف

147
00:09:50,180 --> 00:09:52,520
!لن يُصلح الاعتذار هذه الفوضى

148
00:09:52,520 --> 00:09:55,090
،لقد اجتمعتُ بهينزو أخيرًا

149
00:09:55,090 --> 00:09:57,150
.إلاّ أنّني لم أصافحه حتّى

150
00:09:57,920 --> 00:10:01,060
.لن أرجع إلى لولوكا الآن أبدًا أيضًا

151
00:10:01,630 --> 00:10:02,760
!سحقًا

152
00:10:04,730 --> 00:10:08,430
،سأموت هنا في هذا الضّباب
.كما مات أبي

153
00:10:08,430 --> 00:10:09,570
أبوك؟

154
00:10:09,930 --> 00:10:11,940
.كان أبي ضابط بحريّة

155
00:10:12,440 --> 00:10:13,940
،عندما كنتُ طفلاً

156
00:10:13,940 --> 00:10:16,440
ذهب في رحلة طويلة لاستكشاف
.بعض المناطق المجهولة في البحار

157
00:10:17,270 --> 00:10:22,180
.وظللتُ منتظرًا عودته منذئذٍ

158
00:10:23,280 --> 00:10:27,920
حتّى الآن، ما زال أبي"
".يُغامر في بحرٍ ما

159
00:10:27,920 --> 00:10:29,250
...هذا ما أخبرتُ نفسي. ولكن

160
00:10:37,960 --> 00:10:40,360
!أبي! أبي

161
00:10:40,760 --> 00:10:43,370
،بحثتُ باستماتة في كلّ أرجاء السّفينة

162
00:10:43,370 --> 00:10:45,800
.إلاّ أنّني لم أجد أبي في أيّ مكان

163
00:10:45,800 --> 00:10:49,210
.لن نخرج من هنا أحياء بالتّأكيد

164
00:10:49,210 --> 00:10:52,480
سنظلّ محبوسين داخل
.هذا الضّباب إلى الأبد

165
00:10:58,650 --> 00:11:00,420
مهلاً، إلى أين ذاهب؟

166
00:11:00,420 --> 00:11:02,290
.كما أخبرتك، لأعود إلى أصدقائي

167
00:11:02,290 --> 00:11:05,260
!لكن كيف؟! لا نعرف أين نحن حتّى

168
00:11:05,260 --> 00:11:08,090
إلاّ أنّك ستواصل المضيّ قدمًا
!داخل هذا الضّباب؟

169
00:11:08,660 --> 00:11:09,990
،إلّم نمضِ قدمًا

170
00:11:09,990 --> 00:11:12,060
لن نرجع إلى أصدقائنا، صحيح؟

171
00:11:39,970 --> 00:11:41,110
كيف الأمر من جهتك؟

172
00:11:41,110 --> 00:11:43,640
.لا فائدة. لم أرهما في أيّ مكان

173
00:11:44,240 --> 00:11:49,210
من المحتمل أنّهما رُمِيا
.إلى الجانب الآخر من الضّباب

174
00:11:49,610 --> 00:11:53,050
ماذا تقصد؟ ما عاد رابا نوي هنا؟

175
00:11:53,990 --> 00:11:55,520
.ذلك مرجّح

176
00:11:55,820 --> 00:11:56,950
...لا

177
00:12:02,890 --> 00:12:05,760
،تلك سفينة شراعيّة قديمة
.تعود لـ200 عام

178
00:12:06,430 --> 00:12:08,330
.لم أر تلك السّفينة من قبل

179
00:12:09,170 --> 00:12:11,970
،"من الممكن أنّ داخل "حفلة القرد

180
00:12:11,970 --> 00:12:13,800
...مسار الوقت نفسه

181
00:12:13,800 --> 00:12:16,440
!يا رفاق

182
00:12:21,410 --> 00:12:23,250
.هذه أنت يا نامي

183
00:12:23,250 --> 00:12:25,420
!ماذا تقصد بـ"هذه أنت"؟

184
00:12:25,420 --> 00:12:28,750
بعد أن قطعتُ كلّ هذه
!المسافة لإنقاذكم

185
00:12:28,750 --> 00:12:30,220
!يا لوقاحتك

186
00:12:30,220 --> 00:12:33,520
.كلامك غير مقنع بتاتًا

187
00:12:34,790 --> 00:12:36,430
.لا يهمّ، لا يهمّ

188
00:12:36,430 --> 00:12:38,300
ماذا؟ من هؤلاء الأطفال؟

189
00:12:38,900 --> 00:12:40,130
أين ذهب لوفي؟

190
00:12:40,570 --> 00:12:42,970
.ما الخطب؟ تبدون كئيبين جميعًا

191
00:12:43,600 --> 00:12:44,770
هل حدث شيء؟

192
00:12:45,270 --> 00:12:47,710
.لقد قُذفا خلف الضّباب

193
00:12:48,370 --> 00:12:51,840
.كما قلت، لقد رحلا. ما عادا هنا

194
00:12:51,840 --> 00:12:53,580
ماذا تقصد؟

195
00:12:53,580 --> 00:12:55,350
.كما قال

196
00:12:55,780 --> 00:12:59,380
،لم تكوني هنا لتشهدي على ذلك
.لذا يستحيل علينا أن نشرح لك

197
00:13:00,280 --> 00:13:02,820
!حسنًا. سننسحب

198
00:13:04,020 --> 00:13:05,090
!مهلاً لحظة

199
00:13:05,090 --> 00:13:06,860
!ماذا عن لوفي؟

200
00:13:06,860 --> 00:13:10,130
لا أدري ما حدث، لكن يستحيل
أنّه مات، أليس كذلك؟

201
00:13:10,130 --> 00:13:11,560
.دعوه فحسب، لا مشكلة

202
00:13:11,560 --> 00:13:13,130
!هيّا، سنرجع

203
00:13:13,630 --> 00:13:15,730
هل توجد طريقة للخروج؟

204
00:13:16,430 --> 00:13:17,400
.نوعًا ما

205
00:13:17,700 --> 00:13:19,500
!إنّه مجرّد حبل، أليس كذلك؟

206
00:13:20,170 --> 00:13:22,770
أنتم من أتوا من لولوكا، أليس كذلك؟

207
00:13:26,410 --> 00:13:27,480
!إيان

208
00:13:27,480 --> 00:13:29,110
من ذلك الشّخص؟

209
00:13:29,110 --> 00:13:30,280
.أحد أتباع ويتّون

210
00:13:30,620 --> 00:13:33,250
ما الّذي يفعله ذلك الشّخص هنا؟

211
00:13:36,290 --> 00:13:38,460
ما رأيك أن تناوليني ذلك الحبل؟

212
00:13:38,460 --> 00:13:39,820
ولِمَ عساي أفعل؟

213
00:13:39,820 --> 00:13:41,790
،إن كنتَ تريد الخروج أيضًا

214
00:13:41,790 --> 00:13:43,930
بوسعك أن تأتي معنا فحسب، صحيح؟

215
00:13:44,130 --> 00:13:46,560
ألا تهتمّين بمَ قد يحدث له؟

216
00:13:48,970 --> 00:13:49,930
.كلاّ، لا أهتمّ

217
00:13:50,600 --> 00:13:51,570
!ماذا؟

218
00:13:51,870 --> 00:13:53,570
من ذلك الطّفل على أيّ حال؟

219
00:13:53,570 --> 00:13:57,280
لستُ كريمةً لدرجة أن أنقذ
.طفلاً لم أره من قبل

220
00:13:57,280 --> 00:13:59,010
.صحيح، معك حقّ

221
00:13:59,410 --> 00:14:02,250
!ماذا؟! أيّتها النّذلة
!سأطلق عليه! سأفعل

222
00:14:03,480 --> 00:14:04,680
!أيّتها القاتلة

223
00:14:06,650 --> 00:14:08,650
!افعلي ما يقوله

224
00:14:08,650 --> 00:14:10,690
...ماذا؟ هذا سخيف

225
00:14:11,320 --> 00:14:12,660
!مـ-مهلاً، توقّفي

226
00:14:12,660 --> 00:14:15,060
!لا أريد أن أفقد المزيد من أصدقائي

227
00:14:15,060 --> 00:14:16,830
!افعلي ما يقوله رجاءً

228
00:14:18,430 --> 00:14:20,230
!أحسنت يا إيسوكا-تشان

229
00:14:20,230 --> 00:14:22,500
،بينما أنت بصدد ذلك
.اربطي الحبل بالقارب أيضًا

230
00:14:27,470 --> 00:14:29,540
إيسوكا-تشان، لِمَ لا تأتين معي؟

231
00:14:29,540 --> 00:14:32,440
لن نضطرّ للعمل مجدّدًا
.بامتلاكنا لكلّ هذا الكنز

232
00:14:32,780 --> 00:14:36,750
لا تسئ فهمي! رابا نوي
!هو قائدنا الوحيد

233
00:14:36,750 --> 00:14:39,420
!لا أملك أيّ نيّة في اتّباع جبان مثلك

234
00:14:39,950 --> 00:14:40,890
!ماذا؟

235
00:14:42,250 --> 00:14:43,590
!اهربي يا إيسوكا

236
00:14:43,590 --> 00:14:44,520
!الويل لك

237
00:14:46,020 --> 00:14:47,290
!رونغو

238
00:14:47,290 --> 00:14:48,760
!كيف تجرئين على العبث معي؟

239
00:14:48,760 --> 00:14:50,060
!توقّف

240
00:14:53,360 --> 00:14:56,330
!سحقًا، أفلتيني! أفلتيني

241
00:14:59,300 --> 00:15:01,110
مهلاً، ما الخطب؟

242
00:15:01,110 --> 00:15:02,410
...كايروسيكي

243
00:15:02,410 --> 00:15:03,510
!ماذا؟

244
00:15:07,080 --> 00:15:08,480
!سحقًا

245
00:15:09,850 --> 00:15:11,580
!انتظر أيّها الوغد

246
00:15:11,580 --> 00:15:12,820
!إيّاك أن تخطئ

247
00:15:13,120 --> 00:15:17,160
!أطلق عليه بسرعة
!أسرع! أسرع! أسرع

248
00:15:13,850 --> 00:15:16,820
،ا-انتظري، دعيني أصوّب
!دعيني أصوّب، دعيني أصوّب

249
00:15:16,820 --> 00:15:17,760
!لا أستطيع أن أُطلق

250
00:15:20,260 --> 00:15:22,290
!احترقا! احترقا

251
00:15:25,830 --> 00:15:28,400
!لا فائدة! لا يمكنني الابتعاد هكذا

252
00:15:30,430 --> 00:15:31,540
!رامبل

253
00:15:37,580 --> 00:15:38,710
!ليك، ها هو ذا

254
00:15:43,680 --> 00:15:44,720
!لن أدعك تهرب

255
00:15:45,120 --> 00:15:46,720
!شرارة التّنّين

256
00:15:48,890 --> 00:15:49,820
!تشوبّر

257
00:15:49,820 --> 00:15:52,160
!لا يجب أن تشيح نظرك عن خصمك

258
00:15:53,190 --> 00:15:54,630
!ما هذا؟

259
00:15:54,630 --> 00:15:56,890
!الشّواء الفضّيّ

260
00:15:57,430 --> 00:15:58,560
!شـ-شواء؟

261
00:15:59,960 --> 00:16:02,130
هلاّ أطبقت فمك؟

262
00:16:02,130 --> 00:16:06,300
.أنتما خير مثال للّذين لا يعرفون حدّهم

263
00:16:07,940 --> 00:16:10,140
!جدّي، إنّه يُسحب، يُسحب

264
00:16:10,140 --> 00:16:15,480
أتقصد أنّ تلك الفتاة
عائدة من داخل الضّباب حقًّا؟

265
00:16:15,480 --> 00:16:17,480
!أنت، اسحبها إلى هنا

266
00:16:17,480 --> 00:16:17,850
!حسنًا

267
00:16:19,920 --> 00:16:20,590
.ليس بعد

268
00:16:20,590 --> 00:16:21,720
ماذا؟

269
00:16:21,720 --> 00:16:24,390
،وعدتُ نامي أنّه إلى حين عودتها

270
00:16:24,390 --> 00:16:26,720
!لن أدع أيّ أحد يلمس هذا الحبل

271
00:16:26,920 --> 00:16:28,130
!لا تدفعني للضّحك

272
00:16:28,360 --> 00:16:31,730
!لتذهب إلى الجحيم أنت ووعدك
!أنت مثير للشّفقة وعنيد

273
00:16:31,730 --> 00:16:33,830
!هل تريدون الذّهب بهذا القدر؟

274
00:16:34,270 --> 00:16:36,600
.لا نريد ذلك

275
00:16:37,000 --> 00:16:39,800
.ستعود نامي-سان بكلّ تأكيد

276
00:16:40,140 --> 00:16:44,280
.نحن نحرس مكان عودتها بحياتنا فحسب

277
00:16:49,380 --> 00:16:51,320
!ركلة الخدّ

278
00:16:54,450 --> 00:16:56,890
!تمثيليّة الصّداقة هذه تصيبني بالاشمئزاز

279
00:16:57,320 --> 00:16:59,560
!أيّها المحافظ! ثمّة قارب راجع

280
00:16:59,960 --> 00:17:03,530
.حسنًا، اسحبوا الحبل وأرشدوه إلى هنا

281
00:17:06,730 --> 00:17:10,970
يا لكم من أطفال أغبياء
!لتعيشوا في هذا الضّباب إلى الأبد

282
00:17:11,640 --> 00:17:15,910
من المنعش حقًّا أن تكون
!تحت سماءٍ زرقاء

283
00:17:16,170 --> 00:17:18,910
!إنّي أراها، ها هي ذي! بلدة لولوكا

284
00:17:21,710 --> 00:17:23,510
أ-أذلك...؟

285
00:17:28,220 --> 00:17:29,920
!...ليست نامي

286
00:17:30,890 --> 00:17:32,390
مـ-من أنت؟

287
00:17:33,290 --> 00:17:35,860
!أعتذر على غيابي الطّويل! أنا إيان

288
00:17:36,560 --> 00:17:40,630
أيّها القائد ويتّون، تبدو في مظهر
!أفضل من أيّ وقت

289
00:17:40,900 --> 00:17:41,830
أ-أنا؟

290
00:17:42,230 --> 00:17:44,540
.أنا بخير، نعم

291
00:17:44,540 --> 00:17:46,540
إيان؟ هل قلت إيان؟

292
00:17:47,040 --> 00:17:49,340
إيان الّذي كان يعمل تحت إمرتي؟

293
00:17:49,570 --> 00:17:53,340
ماذا؟ من هذا العجوز أيّها القائد؟

294
00:17:53,340 --> 00:17:54,150
...في الواقع

295
00:17:54,510 --> 00:17:56,980
!أنا القائد! أنا هو ويتّون

296
00:17:57,250 --> 00:17:58,750
ماذا؟ من هذا إذًا؟

297
00:17:58,750 --> 00:17:59,880
.حفيدي، ليك

298
00:17:59,880 --> 00:18:01,490
.وأنا ابنه، فيليب

299
00:18:01,490 --> 00:18:04,990
لا بدّ أنّك تمزح! هل أنت
ذلك القزم المبلّل لفراشه؟

300
00:18:04,990 --> 00:18:08,760
!حتّى أنّ لديك ابنًا الآن؟
!هذا صاعق

301
00:18:08,760 --> 00:18:10,960
!كفّوا عن الضّحك
!قلت كفّوا عن الضّحك

302
00:18:10,960 --> 00:18:14,100
.أخبرني عن داخل الضّباب يا إيان

303
00:18:14,100 --> 00:18:15,270
.حـ-حاضر

304
00:18:15,700 --> 00:18:16,830
.تفضّلا، اشربا

305
00:18:16,830 --> 00:18:18,870
!مذهل، شكرًا

306
00:18:18,870 --> 00:18:19,440
وإذًا؟

307
00:18:19,440 --> 00:18:21,370
.لا فائدة، لا يمكنني الاتّصال

308
00:18:21,370 --> 00:18:23,810
،لا بدّ أنّها كانت حالة استثنائيّة

309
00:18:23,810 --> 00:18:25,710
.عندما التقطنا الإشارة سابقًا

310
00:18:26,140 --> 00:18:27,550
...شاء الحظّ

311
00:18:27,550 --> 00:18:31,680
أن توجد قطعة من الجواهر
...تحتوي على حجر بحريّ

312
00:18:32,250 --> 00:18:33,420
حجر بحريّ؟

313
00:18:33,750 --> 00:18:35,420
.إنّه بلّور بحريّ

314
00:18:35,420 --> 00:18:38,890
يملك القدرة على إلغاء
.قوى فاكهة الشّيطان

315
00:18:38,890 --> 00:18:42,730
يا إلهي، لا فائدة من امتلاك
كلّ هذا الذّهب

316
00:18:42,730 --> 00:18:45,330
.إن كنّا لا نستطيع الخروج به من هنا

317
00:18:45,330 --> 00:18:48,200
.أنت ملاّحة، صحيح؟ افعلي شيئًا

318
00:18:48,200 --> 00:18:51,100
لا يمكنني فعل شيء. فهذه أوّل مرّة
.أرى فيها منطقة سخيفة كهذه في البحر

319
00:18:51,100 --> 00:18:52,740
لا نملك خيارًا، صحيح؟

320
00:18:52,740 --> 00:18:55,070
.لا، سيعود

321
00:18:55,070 --> 00:18:56,440
ماذا؟

322
00:18:56,440 --> 00:19:00,810
هدف ويتّون الأسمى هو
."الذّهب القابع داخل "حفلة القرد

323
00:19:01,050 --> 00:19:03,210
،وبما أنّ تابعه إيان عاد حيًّا

324
00:19:03,210 --> 00:19:06,380
.سيبعث قوّات هائلة لاقتحام هذا المكان

325
00:19:06,380 --> 00:19:07,750
!لا يعقل

326
00:19:07,750 --> 00:19:08,920
!لنقاتل

327
00:19:08,920 --> 00:19:10,760
!لن نسلّم هذا الكنز لأيّ أحد

328
00:19:10,760 --> 00:19:12,060
...انظري إلى حالك

329
00:19:12,060 --> 00:19:15,330
...فقط لو أنّ رابا نوي كان معنا

330
00:19:24,540 --> 00:19:27,170
!أنت، اصمد

331
00:19:27,170 --> 00:19:28,140
!سحقًا

332
00:19:28,710 --> 00:19:29,610
!لا فائدة

333
00:19:29,610 --> 00:19:32,180
،مهما قمنا بالتّجديف
!ينتهي بنا المطاف حيث بدأنا

334
00:19:32,640 --> 00:19:37,010
.هذا مستحيل حقًّا
.لا يمكننا الخروج من هذا الضّباب

335
00:19:37,010 --> 00:19:38,750
ذلك ليس سيّئًا جدًّا، أليس كذلك؟

336
00:19:40,080 --> 00:19:41,890
.نحن الوحيدون هنا

337
00:19:41,890 --> 00:19:44,520
،يمكننا أن ننام متى شئنا
.ونلعب متى شئنا

338
00:19:44,520 --> 00:19:45,890
.إنّها جنّتنا

339
00:19:45,890 --> 00:19:47,990
!أرضُ الحرّيّة، أرض البقاء

340
00:19:47,990 --> 00:19:49,330
!رابا نوي

341
00:19:49,690 --> 00:19:54,230
.لسنا بحاجة للعودة إلى الدّيار
.لنصنع أرضنا بأنفسنا

342
00:19:54,770 --> 00:19:57,540
.أريد أن أعود إلى الدّيار، إلى بلدتنا

343
00:19:58,070 --> 00:20:00,240
.أريد أن أعود إلى لولوكا

344
00:20:04,140 --> 00:20:05,140
أبي؟

345
00:20:07,180 --> 00:20:09,680
!أبي... أبي

346
00:20:14,950 --> 00:20:16,320
ما ذلك الضّوء؟

347
00:20:17,920 --> 00:20:19,290
مهلاً، أليس ذلك...؟

348
00:20:19,290 --> 00:20:20,560
!مخرج

349
00:20:22,960 --> 00:20:26,760
أخيرًا سيتحقّق حلمي الّذي
.انتظرته 50 سنة

350
00:20:26,760 --> 00:20:32,570
ضباب قوس قزح وهذا العالم
.سيندمجان إلى الأبد

351
00:20:54,930 --> 00:20:56,530
!مـ-ما ذلك؟

352
00:21:13,010 --> 00:21:15,610
!يا رفاق، تمسّكوا بشيء جميعًا

353
00:21:18,620 --> 00:21:20,590
!مـ-ما ذلك؟

354
00:21:20,590 --> 00:21:22,550
!إنّه برج قوس قزح

355
00:21:24,290 --> 00:21:25,820
!يا للهول، كان ذلك وشيكًا

356
00:21:26,560 --> 00:21:27,530
.خذ قبّعتك

357
00:21:27,530 --> 00:21:28,890
.شكرًا لك

358
00:21:28,890 --> 00:21:30,500
بالمناسبة، ما ذلك؟

359
00:21:31,300 --> 00:21:34,370
."إنّهم ينوون اقتحام "حفلة القرد

360
00:21:34,370 --> 00:21:36,070
ماذا؟ من هم؟

361
00:21:36,070 --> 00:21:38,340
!لنسرع على أيّ حال. الجميع في خطر

362
00:21:43,840 --> 00:21:46,310
.أتيتَ أخيرًا إذًا يا ويتّون

363
00:21:46,640 --> 00:21:48,550
!تابعوا يا رجال

364
00:21:52,120 --> 00:21:56,450
لا تتركوا أيّ قطعة من الكنوز
!"في "حفلة القرد

365
00:22:09,430 --> 00:22:17,500
آه، خلف السّماء الّتي لا نهاية لها

366
00:22:17,500 --> 00:22:28,120
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

367
00:22:35,990 --> 00:22:43,430
مرّت عليّ أيّام كدت أخسر فيها نفسي

368
00:22:43,430 --> 00:22:51,840
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

369
00:22:51,840 --> 00:23:00,050
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

370
00:23:00,050 --> 00:23:08,890
دفعوا بي للأمام، أليس كذلك؟

371
00:23:08,890 --> 00:23:17,200
آه، إنّ النّجوم تهوي من السّماء

372
00:23:17,200 --> 00:23:20,330
...وهذه اللّحظة الفريدة

373
00:23:25,710 --> 00:23:27,140
!أتى ويتّون

374
00:23:27,140 --> 00:23:30,010
لكنّنا نواجه المحافظ، صحيح؟
.لديه الكثير من الأتباع

375
00:23:30,010 --> 00:23:34,380
،قاومته كلّ هذا الوقت لوحدي
.ولم أسلّم له قلبي

376
00:23:34,380 --> 00:23:37,380
.ألم تنس بشأننا؟ لست وحدك

377
00:23:37,380 --> 00:23:41,560
!لن أدعك تدنّس جنّة قراصنة اليقطين

378
00:23:41,560 --> 00:23:43,190
:في الحلقة القادمة من ون بيس

379
00:23:43,190 --> 00:23:46,360
!وهكذا تبدأ الأسطورة"
".الجانب الآخر من قوس قزح

380
00:23:46,360 --> 00:23:48,500
!ملك القراصنة، لن يكون إلاّ أنا