1
00:00:09,830 --> 00:00:13,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:24,350 --> 00:00:31,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:31,770 --> 00:00:39,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:39,440 --> 00:00:46,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:00:46,910 --> 00:00:54,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:03,470 --> 00:01:06,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:06,850 --> 00:01:10,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:10,890 --> 00:01:12,310
!اصقلوا مهاراتكم أكثر

9
00:01:12,350 --> 00:01:14,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:14,560 --> 00:01:15,940
!ارتقوا دومًا

11
00:01:15,980 --> 00:01:17,860
!وحلّقوا فوق الأمواج

12
00:01:17,900 --> 00:01:21,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:21,490 --> 00:01:25,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:25,950 --> 00:01:32,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:32,120 --> 00:01:36,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:36,340 --> 00:01:40,550
...تحت هذا العلم

17
00:01:42,300 --> 00:01:45,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:45,760 --> 00:01:49,220
نقشته برويّة هناك ذات يوم

19
00:01:49,310 --> 00:01:52,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:01:52,890 --> 00:01:55,770
!فأنا أطبق عليها بين يديّ

21
00:02:04,450 --> 00:02:07,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:07,700 --> 00:02:11,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:11,870 --> 00:02:13,210
!اصقلوا مهاراتكم أكثر

24
00:02:13,250 --> 00:02:15,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:15,540 --> 00:02:16,920
!ارتقوا دومًا

26
00:02:16,960 --> 00:02:18,750
!وحلّقوا فوق الأمواج

27
00:02:18,790 --> 00:02:22,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:22,550 --> 00:02:26,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:35,390 --> 00:02:38,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:38,730 --> 00:02:43,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:46,030 --> 00:02:52,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:02:53,410 --> 00:02:59,130
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:00,460 --> 00:03:06,640
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:06,640 --> 00:03:08,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:09,050 --> 00:03:12,510
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:16,420 --> 00:03:18,600
،بعد نجاتهم من معركة ضارية

37
00:03:18,600 --> 00:03:21,980
،دخل طاقم قبّعة القشّ أخيرًا إلى العالم الجديد

38
00:03:21,980 --> 00:03:24,340
.البحر الأعنف الّذي يحكمه اليونكو

39
00:03:25,900 --> 00:03:27,510
،رسوا في جزيرة بانك هازارد

40
00:03:27,510 --> 00:03:30,200
،جزيرة منقسمة إلى جزئين
.الأراضي المشتعلة والأراضي المتجمّدة

41
00:03:31,530 --> 00:03:34,540
عرفَ لوفي بشأن التّجارب الشّنيعة

42
00:03:34,540 --> 00:03:37,030
،الّتي أجراها كلّ من السّيّد سيزار كلاون

43
00:03:37,030 --> 00:03:39,080
.وذهب ليتقصّى الأمر

44
00:03:39,620 --> 00:03:41,600
...لذا افترقت المجموعة. ولكن

45
00:03:42,000 --> 00:03:43,290
ما هذه؟

46
00:03:43,630 --> 00:03:45,670
إنّها آثار أقدام، أليس كذلك؟

47
00:03:46,130 --> 00:03:50,270
.أهي لحيوان؟ إن كان إنسانًا، لا بدّ أنّه عملاق

48
00:03:51,090 --> 00:03:53,300
.أستشعر شيئًا

49
00:03:53,610 --> 00:03:55,520
.مخلوقان شبيهان بالوحوش

50
00:03:55,720 --> 00:03:57,430
!ماذا سنفعل؟

51
00:03:57,430 --> 00:03:58,480
!أين هم؟

52
00:03:58,560 --> 00:04:00,860
لو؟ السّيّد؟

53
00:04:01,230 --> 00:04:05,070
!لا، نحن في جبل مكسيّ بالثّلوج، لذا لا بدّ أنّه هما

54
00:04:05,570 --> 00:04:10,360
!قاتلا الجبل الثّلجيّ، يظهران من عمق العاصفة الثّلجيّة

55
00:04:12,280 --> 00:04:13,540
أنت اللّحية البنّيّة، أليس كذلك؟

56
00:04:14,210 --> 00:04:18,370
.اسمك موجود في لائحة اغتيالنا أيضًا

57
00:04:21,020 --> 00:04:24,420
!أنتما، لم تؤذيا أصدقائي، أليس كذلك؟

58
00:04:35,030 --> 00:04:36,350
!ماذا؟ أين ذهب؟

59
00:04:37,640 --> 00:04:41,440
!آسف! أخذا نامي معهما

60
00:04:45,150 --> 00:04:49,200
"!أنقذ نامي! معركة لوفي في الجبال الثّلجيّة"

61
00:04:51,280 --> 00:04:53,030
!اختطفوا نامي؟

62
00:04:53,030 --> 00:04:54,540
.كان ذلك خطئي

63
00:04:54,540 --> 00:04:57,040
،مع أنّهما كانا ضخمان جدًّا

64
00:04:57,490 --> 00:04:59,670
لم ألحظ أنّهما هناك

65
00:04:59,670 --> 00:05:01,420
.إلى أن ظهرا أمامي فجأةً

66
00:05:01,580 --> 00:05:04,450
!أوّلاً القناطير والآن الرّجال الوحوش؟

67
00:05:04,450 --> 00:05:06,630
!هناك الكثير من المخلوقات الغريبة هنا

68
00:05:06,750 --> 00:05:11,800
.ربّما كانوا ينتظرون فرصتهم للهجوم علينا في مكان ما

69
00:05:11,920 --> 00:05:16,510
!ألم يأتيا إلى هنا لإنقاذ التّمساح البنّيّ؟

70
00:05:16,800 --> 00:05:21,140
.بدا أنّ هدفهما الأساسيّ هو قتلنا وأخذ الأطفال

71
00:05:21,730 --> 00:05:26,110
.لكن أوّلاً، قتلنا اللّحية البنّيّة بأمر من السّيّد

72
00:05:26,460 --> 00:05:28,480
.كان يفترض أن يكونوا حلفاء

73
00:05:28,480 --> 00:05:30,900
.أُعجبَ به اللّحية البنّيّة كثيرًا

74
00:05:31,320 --> 00:05:34,790
!كان السّيّد منقذنا الطّيّب

75
00:05:35,700 --> 00:05:36,950
!لوفي

76
00:05:36,950 --> 00:05:39,950
.هذا المدعو بالسّيّد هو شخص مخبول حقًّا

77
00:05:40,540 --> 00:05:45,330
!لا يمكنني أن أترك هؤلاء الأطفال يعودون إلى شرّير مثله

78
00:05:45,790 --> 00:05:49,380
!كما لا أستطيع سوى أن أقلق على نامي في جسد فرانكي

79
00:05:49,380 --> 00:05:50,880
!لا ندري ماذا قد يفعلون لها

80
00:05:52,590 --> 00:05:54,840
!أجل، سأستعيدها بأيّ ثمن

81
00:05:55,240 --> 00:05:57,260
!اعتنوا أنتم بالأطفال

82
00:05:57,260 --> 00:05:59,010
!انتظر يا لوفي

83
00:05:59,180 --> 00:06:01,810
!لقد أخذا جسدي

84
00:06:02,180 --> 00:06:05,040
!تشوبّر، لا أستطيع القتال هكذا

85
00:06:05,040 --> 00:06:07,730
أعطني حبّة الفول الّتي تأكلها عندما تحوّل

86
00:06:07,730 --> 00:06:09,190
!نفسك إلى وحش

87
00:06:09,480 --> 00:06:10,550
!ليست حبّة فول

88
00:06:10,550 --> 00:06:12,740
!كرة رامبل هي عقّار قوّة

89
00:06:12,740 --> 00:06:15,200
.لا أظنّك تستطيع التّحكّم به

90
00:06:15,660 --> 00:06:20,030
!يمكنني التّعامل مع الأمر بروحي الخارقة

91
00:06:20,030 --> 00:06:24,210
!أعطني إيّاها فحسب! لا نملك وقتًا

92
00:06:25,620 --> 00:06:26,830
.لا خيار أمامي

93
00:06:27,050 --> 00:06:27,880
ماذا؟

94
00:06:32,590 --> 00:06:34,050
واحدة فقط، مفهوم؟

95
00:06:34,050 --> 00:06:36,970
!حقًّا؟! أكانت في هذا الجيب طوال هذا الوقت؟

96
00:06:37,220 --> 00:06:39,680
.بالطّبع. إنّها لتشوبّر

97
00:06:39,970 --> 00:06:44,100
.اسمع. يمكنك أن تصبح وحشًا لثلاث دقائق فقط

98
00:06:44,100 --> 00:06:45,810
.لا يمكنك أن تقاتل بعد ذلك

99
00:06:46,310 --> 00:06:49,540
...لذا إن أمكنك، تحوّل إلى نقطة تعزيز الكونغ فو و

100
00:06:51,070 --> 00:06:53,030
!ماذا؟

101
00:06:54,280 --> 00:06:55,490
!خارق

102
00:06:55,490 --> 00:06:57,450
!هذا سابق لأوانه كثيرًا

103
00:07:00,370 --> 00:07:02,480
!هيّا يا فرانكي! من هنا

104
00:07:14,590 --> 00:07:17,090
!لماذا تهاجمني؟

105
00:07:23,180 --> 00:07:26,000
!لا! خرج عن السّيطرة كما ظننت

106
00:07:26,640 --> 00:07:30,360
إذًا أهناك مغزى من ذهاب فرانكي؟

107
00:07:30,480 --> 00:07:33,750
بعد أن ثار، لن يستطيع الحراك لفترة

108
00:07:33,750 --> 00:07:35,870
.لذا لن يكون ذا نفع إطلاقًا

109
00:07:35,870 --> 00:07:37,200
.بل سيكون عبئًا

110
00:07:44,490 --> 00:07:49,370
...لا أدري من أين حصل عليه، لكنّ هذا الـ"سّايبورغ" فرانكي

111
00:07:49,370 --> 00:07:52,290
.يملك سلاح ليزر فيغابانك مُركّبًا على جسده

112
00:07:53,130 --> 00:07:58,130
.سأستفيد جيّدًا من اختراع فيغابانك

113
00:07:58,820 --> 00:08:03,430
،بعد أن أقطع جسده وأستخرج منه نظام اللّيزر

114
00:08:03,680 --> 00:08:08,140
!سيكون بلا فائدة. حضّروا المحرقة

115
00:08:08,140 --> 00:08:08,980
.حاضر

116
00:08:09,320 --> 00:08:13,310
كيف يجري الأمر مع أغبياء البحريّة الّذين أتوا لسرقة السّفينة؟

117
00:08:13,480 --> 00:08:14,690
.صحيح

118
00:08:15,340 --> 00:08:18,320
...باغتناهم بنجاح ولكن

119
00:08:27,450 --> 00:08:29,040
!ما هم؟

120
00:08:29,040 --> 00:08:30,870
!بشر؟! لا، أحصنة؟

121
00:08:31,000 --> 00:08:32,920
!اقتلوهم جميعًا

122
00:08:33,880 --> 00:08:36,380
!لن نُهزم بتلك السّهولة

123
00:08:36,630 --> 00:08:38,550
!انظر خلفك

124
00:08:39,630 --> 00:08:40,510
!ماذا؟

125
00:08:49,890 --> 00:08:51,520
!ها نحن أولاء

126
00:08:51,520 --> 00:08:52,860
!هناك المزيد

127
00:08:52,860 --> 00:08:54,400
!هذا ليس جيّدًا

128
00:08:54,400 --> 00:08:55,400
!لا ملاذ لنا

129
00:08:57,730 --> 00:08:59,330
!علينا أن نغيّر تكتيكاتنا

130
00:08:59,330 --> 00:09:01,640
!لنحاول أخذ السّفينة بكلّ قوّتنا

131
00:09:15,280 --> 00:09:17,800
!النّقيب-تشان... أقصد، سموكر-سان

132
00:09:18,460 --> 00:09:21,220
.المعركة خارجة عن السّيطرة الآن

133
00:09:21,780 --> 00:09:22,940
...تقصد

134
00:09:24,180 --> 00:09:25,890
.أنّنا نعاني أمامهم

135
00:09:26,430 --> 00:09:27,890
...أقصد

136
00:09:30,700 --> 00:09:32,390
!لديّ فكرة

137
00:09:38,610 --> 00:09:40,940
سـ-سيّدي؟

138
00:09:42,900 --> 00:09:44,990
.إنّنا نتعامل مع البحريّة

139
00:09:44,990 --> 00:09:49,360
!إنّها الفرصة الأمثل لاختباره

140
00:09:51,200 --> 00:09:54,500
!أجل، ذلك ممتاز! لنفعل ذلك

141
00:09:57,250 --> 00:10:01,260
.اتّصلا بالقناطير الّذين يقومون بدوريّة الآن

142
00:10:01,260 --> 00:10:02,090
!حاضر

143
00:10:02,220 --> 00:10:07,210
أخبرا كلّ الجنود الآخرين أن يخلوا
.المكان إن كانوا يريدون النّجاة

144
00:10:17,810 --> 00:10:20,350
!دعاني! دعاني أيّهما الأحمقان

145
00:10:20,350 --> 00:10:22,900
!ما بالكما؟! أيّها المنحرفان

146
00:10:22,900 --> 00:10:25,290
!ماذا ستفعلان لي؟

147
00:10:25,290 --> 00:10:28,510
،أعلم أنّني جميلة وأملك قوامًا جميلاً

148
00:10:28,510 --> 00:10:30,470
!لذا لم تستطيعا سوى أن تختطفاني

149
00:10:30,470 --> 00:10:32,840
عمّ يتحدّث هذا الشّخص؟

150
00:10:32,840 --> 00:10:35,830
.لا بدّ أنّه أوكاما. هذا بارد

151
00:10:35,830 --> 00:10:40,000
!ستدفعان ثمن هذا! لن يسامحكما لوفي

152
00:10:40,000 --> 00:10:43,040
!آمل أن يوسعكما ضربًا

153
00:10:45,010 --> 00:10:48,690
...الزم الصّمت قليلاً. المزعجون من أمثالك

154
00:10:48,930 --> 00:10:50,810
.ليسوا رائعين

155
00:10:50,970 --> 00:10:55,020
...لكنّ الأسلحة المركّبة على جسدك

156
00:10:55,020 --> 00:10:56,350
.رائعة

157
00:10:56,350 --> 00:10:59,320
...إن أعطيناها للسّيّد، مكافأتنا ستكون

158
00:11:02,320 --> 00:11:04,340
!رائعة جدًّا

159
00:11:10,660 --> 00:11:13,410
.الجوّ بارد اليوم كما العادة

160
00:11:15,290 --> 00:11:17,230
!جسدي بارد

161
00:11:20,340 --> 00:11:21,590
!إذًا ارتديا بعض الثّياب

162
00:11:23,340 --> 00:11:28,300
.بنادقنا أشبه بالمدافع لكم أيّها البشر

163
00:11:28,300 --> 00:11:30,320
.لدينا عبوّات غازات سامّة أيضًا

164
00:11:30,320 --> 00:11:33,970
.لا يستطيع أيّ أحد هزيمتنا لأنّنا لا نظهر نفسينا

165
00:11:33,970 --> 00:11:35,270
أقلت أنّ صديقك سيأتي؟

166
00:11:35,730 --> 00:11:39,560
.أنا واثق أنّه سيأتي. نصبنا فخًّا لاستدراجه

167
00:11:39,560 --> 00:11:44,360
.لا يستطيع النّاس سوى تتبّع آثار الأقدام في الثّلج

168
00:11:51,180 --> 00:11:53,930
!آثار أقدام! آثار أقدام! هذا يساعد كثيرًا

169
00:11:53,930 --> 00:11:56,370
!من السّهل جدًّا ملاحقتهما

170
00:12:00,580 --> 00:12:03,650
!يا فرانكي، قلتُ توقّف

171
00:12:03,650 --> 00:12:04,590
ماذا؟

172
00:12:09,880 --> 00:12:11,680
...آثار الأقدام تنتهي هناك

173
00:12:18,140 --> 00:12:19,020
ماذا؟

174
00:12:19,140 --> 00:12:22,520
!لوفي وتشوبّر... لا، فرانكي؟

175
00:12:22,810 --> 00:12:24,760
!نامي

176
00:12:25,990 --> 00:12:28,380
!احذر! إنّهما في الجوار

177
00:12:32,950 --> 00:12:34,490
هل نفعلها يا سكوتش؟

178
00:12:34,490 --> 00:12:38,290
!حسنًا! لم يلحظ وجود جرف. إنّه طائش بحقّ

179
00:12:39,900 --> 00:12:42,040
!هنالك أشواك في الأسفل

180
00:12:43,130 --> 00:12:44,750
.موتا هباءً

181
00:12:44,750 --> 00:12:46,460
!فلتثقب جسداكما بأشواك الجليد

182
00:12:49,300 --> 00:12:50,840
!لون التّسلّح، التّصليب

183
00:12:51,240 --> 00:12:53,010
...فاكهة المطّاط

184
00:12:53,050 --> 00:12:57,310
!المدفع الرّشّاش

185
00:13:10,030 --> 00:13:13,530
.فهمت. لن يكون الأمر بتلك البساطة

186
00:13:17,980 --> 00:13:19,540
!ذلكما الاثنان من ذي قبل

187
00:13:22,480 --> 00:13:23,880
!المستوى الثّاني

188
00:13:25,420 --> 00:13:27,170
...فاكهة المطّاط

189
00:13:28,130 --> 00:13:29,420
...المسدّس

190
00:13:29,420 --> 00:13:31,300
!النّفّاث

191
00:13:35,220 --> 00:13:36,220
...الختم

192
00:13:37,570 --> 00:13:39,450
!النّفّاث

193
00:13:40,890 --> 00:13:42,140
!لقد اختفيا ثانيةً

194
00:13:48,560 --> 00:13:52,150
.أيّها الأحمق. نعرف هذه الجبال كما لو أنّها فناؤنا

195
00:13:52,330 --> 00:13:56,120
!هناك الكثير من الأماكن الّتي نستطيع الاختباء فيها

196
00:14:02,500 --> 00:14:04,170
.لا بدّ أنّه في الجوار

197
00:14:04,170 --> 00:14:06,170
.المكان الّذي ذكره السّيّد

198
00:14:10,280 --> 00:14:13,300
.إنّه مبنى ضخم

199
00:14:13,300 --> 00:14:14,950
أهو مستودع؟

200
00:14:14,950 --> 00:14:17,140
.إنّه غريب بعض الشّيء

201
00:14:17,140 --> 00:14:20,400
.هذا هو الباب، صحيح؟ حسنًا، سأحاول فتحه

202
00:14:33,570 --> 00:14:36,360
!إنّه متعنّت! ساعدوني يا رفاق

203
00:14:59,440 --> 00:15:02,040
.أظنّني سمعتُ شيئًا

204
00:15:02,040 --> 00:15:03,560
.لم أسمع أيّ شيء

205
00:15:03,870 --> 00:15:07,760
مهلاً، ألم يتمّ تحذيرنا من الاقتراب من هنا؟

206
00:15:08,180 --> 00:15:10,110
ألا بأس بفتحه فعلاً؟

207
00:15:10,680 --> 00:15:14,380
.السّيّد هو من أخبرنا بهذا وهو من يريد منّا فتحه

208
00:15:14,380 --> 00:15:16,900
ألا تثق بالسّيّد؟

209
00:15:17,180 --> 00:15:19,580
!لـ-لا، هذا ليس ما قصدت

210
00:15:19,580 --> 00:15:22,120
!إذًا كفّ عن الشّكوى وساعدنا

211
00:16:15,500 --> 00:16:17,820
.يتحرّكان بسرعة كبيرة مع أنّهما ضخمان

212
00:16:18,350 --> 00:16:19,300
!صحيح

213
00:16:19,560 --> 00:16:20,590
...فاكهة المطّاط

214
00:16:20,920 --> 00:16:22,350
!إنّه طريق مسدود

215
00:16:23,110 --> 00:16:25,060
!البالون

216
00:16:29,330 --> 00:16:30,890
من الخسارة استخدام هذه القوّة

217
00:16:30,890 --> 00:16:33,020
.دفاعيًّا فقط وترك الرّصاصات ترتدّ عشوائيًّا

218
00:16:33,540 --> 00:16:35,150
.هذا ما قال ريلي

219
00:16:35,690 --> 00:16:37,790
أخبرني أن أركّز على إعادة توجيه

220
00:16:37,790 --> 00:16:39,900
!كلّ واحدة منها بضعف القوّة

221
00:16:41,110 --> 00:16:42,700
...فاكهة المطّاط

222
00:16:42,700 --> 00:16:44,380
!تحيّة النّار

223
00:16:49,830 --> 00:16:50,790
!روك

224
00:16:50,790 --> 00:16:52,330
!نجح

225
00:16:58,820 --> 00:17:01,090
!توقّف يا فرانكي

226
00:17:01,840 --> 00:17:04,960
!لماذا تعاني معه أكثر؟

227
00:17:09,840 --> 00:17:11,670
.جسدي ساخن

228
00:17:11,670 --> 00:17:14,400
!هل يتجادلان الآن؟ بئسًا لهما

229
00:17:16,840 --> 00:17:17,730
!توقّف

230
00:17:18,480 --> 00:17:19,930
!انظر لهذا عليك اللّعنة

231
00:17:19,930 --> 00:17:21,900
.الجبال الجليديّة مليئة بالأسلحة المحتملة

232
00:17:31,750 --> 00:17:34,290
!احذرا! ستسقط قمّة الجبل الجليديّ

233
00:17:34,890 --> 00:17:37,420
!لوفي! فرانكي! احترسا

234
00:17:39,640 --> 00:17:42,010
!لا يمنكما الهرب منها

235
00:17:42,010 --> 00:17:44,280
!الآخر هناك أيضًا

236
00:17:45,430 --> 00:17:49,570
"فلتختنقا بعبوّة غاز "كي واي بي
هذه الّتي ستجعلك ثملين في لحظة

237
00:17:49,570 --> 00:17:51,930
!وموتا كأصدقائكما

238
00:18:00,280 --> 00:18:02,110
!قام بشيء فظيع

239
00:18:14,410 --> 00:18:17,290
!أجل! كان ذلك رائعًا يا فرانكي

240
00:18:20,990 --> 00:18:23,470
!أنت، يكفي

241
00:18:24,800 --> 00:18:26,010
!المستوى الثّالث

242
00:18:27,510 --> 00:18:29,470
...فاكهة المطّاط

243
00:18:29,710 --> 00:18:32,180
!مسدّس الفيل

244
00:18:36,730 --> 00:18:39,400
!هل استخدم أكبر هجماته عليه؟

245
00:18:41,150 --> 00:18:41,940
!لا

246
00:18:42,240 --> 00:18:43,990
!لوفي

247
00:18:46,120 --> 00:18:47,320
!لا

248
00:18:47,320 --> 00:18:49,240
!آسف يا فرانكي وتشوبّر

249
00:18:49,240 --> 00:18:51,840
!سأطلب من تشوبّر علاجك لاحقًا

250
00:18:51,840 --> 00:18:53,320
!انتظر

251
00:18:55,070 --> 00:18:58,570
.كما أخبرتك. نعرف هذه الجبال كما لو أنّها فناؤنا

252
00:18:58,570 --> 00:19:00,090
!لا يمكنك أن تلحق بي

253
00:19:00,200 --> 00:19:01,630
!النّجدة

254
00:19:28,320 --> 00:19:29,160
!نامي

255
00:19:29,760 --> 00:19:30,930
!أنت لا تستسلم

256
00:19:30,930 --> 00:19:32,950
!لكن أستطيع الوصول لأماكن أبعد منك

257
00:19:36,620 --> 00:19:38,920
.عجبًا! إنّه كقرد

258
00:19:38,920 --> 00:19:40,170
!حسنًا

259
00:19:53,300 --> 00:19:57,140
،سحقًا! بما أنّها سلسلة جبال كبيرة
!سيكون من المزعج أن أفقد أثرهما

260
00:20:05,380 --> 00:20:06,070
...إنّه

261
00:20:06,700 --> 00:20:10,240
أنت القاطن المجّانيّ ترافالغار لو، أليس كذلك؟

262
00:20:10,530 --> 00:20:12,310
.مسرور لرؤيتك هنا

263
00:20:12,510 --> 00:20:15,240
...كنت ملاحقًا من قبل قبّعة القشّ لوفي و

264
00:20:15,620 --> 00:20:16,580
.غرفة

265
00:20:19,870 --> 00:20:20,790
ماذا؟

266
00:20:57,360 --> 00:21:00,160
!أيّها الوغد! ما الّذي تفعله؟

267
00:21:13,860 --> 00:21:15,640
.الصّدمة المضادّة

268
00:21:40,890 --> 00:21:42,310
!شكرًا

269
00:21:42,310 --> 00:21:45,550
!لا! مهلاً، أعد لي جسدي

270
00:21:45,550 --> 00:21:47,130
!نامي

271
00:21:47,130 --> 00:21:47,920
!لوفي

272
00:21:49,330 --> 00:21:50,630
!تورا-أو

273
00:21:50,940 --> 00:21:53,380
هل أنقذت نامي؟

274
00:21:54,920 --> 00:21:56,730
.كنتُ أفكّر

275
00:21:58,230 --> 00:22:02,060
.وأتيت إلى هنا لأحدّثك عن أمرٍ ما يا قبّعة القشّ-يا

276
00:22:04,600 --> 00:22:07,950
.أظنّ أنّكم أتيتم إلى هذه الجزيرة صدفةً

277
00:22:08,970 --> 00:22:13,810
لكن هنالك مفتاح مهمّ يقبع في مكان ما في هذه الجزيرة

278
00:22:13,810 --> 00:22:16,230
.يمكنه أن يعيث فسادًا في العالم الجديد

279
00:22:17,890 --> 00:22:21,150
.ثمّة طريقتان فقط للنّجاة في العالم الجديد

280
00:22:23,660 --> 00:22:26,000
إمّا أن تعيش تحت راية اليونكو

281
00:22:26,780 --> 00:22:28,660
.أو أن تجابههم

282
00:22:30,800 --> 00:22:35,330
.وأظنّ أنّك لستَ بشخص قد يرغب في العمل تحت إمرة أحد

283
00:22:36,400 --> 00:22:39,310
.أجل، أريد أن أبقى قبطانًا

284
00:22:39,490 --> 00:22:44,410
!إذًا، علينا أن نشكّل تحالفًا

285
00:22:44,860 --> 00:22:45,750
ماذا؟

286
00:22:46,090 --> 00:22:47,320
تحالف؟

287
00:22:48,050 --> 00:22:51,820
.إن وحّدنا أنا وأنت قوّتنا، فربّما نستطيع النّجاح

288
00:22:57,490 --> 00:22:59,240
...لديّ خطّة

289
00:23:00,150 --> 00:23:02,380
!للإطاحة بأحد اليونكو

290
00:23:09,200 --> 00:23:11,830
.يعلن لو نيّته لهزيمة اليونكو

291
00:23:11,830 --> 00:23:15,740
لا يسع نامي والبقيّة إلاّ أن يتردّدوا
...بسبب التّفاصيل المرعبة

292
00:23:15,740 --> 00:23:18,600
،لكنّ إجابة لوفي لم تفاجئ طاقمه فحسب

293
00:23:18,600 --> 00:23:20,590
.بل ولو أيضًا

294
00:23:20,590 --> 00:23:24,600
في نفس الأثناء، كان سيزار بدوره

295
00:23:24,600 --> 00:23:26,390
.يضع خطّة شنيعة قيد التّنفيذ

296
00:23:26,390 --> 00:23:27,810
:في الحلقة القادمة من وان بيس

297
00:23:27,810 --> 00:23:30,690
"!شُكّل! تحالف قراصنة لوفي ولو"

298
00:23:30,690 --> 00:23:32,930
!ملك القراصنة، لن يكون إلاّ أنا

299
00:23:35,990 --> 00:23:40,990
!!نراكم في الحلقة القادمة