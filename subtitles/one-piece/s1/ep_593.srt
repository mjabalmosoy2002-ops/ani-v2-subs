1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,390 --> 00:02:52,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,730 --> 00:02:57,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:03:00,030 --> 00:03:06,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:03:07,410 --> 00:03:13,130
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:14,460 --> 00:03:20,640
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,640 --> 00:03:22,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:23,050 --> 00:03:26,510
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:30,420 --> 00:03:32,600
،بعد نجاتهم من معركة ضارية

37
00:03:32,600 --> 00:03:35,980
،دخل طاقم قبّعة القشّ أخيرًا إلى العالم الجديد

38
00:03:35,980 --> 00:03:38,340
.البحر الأعنف الّذي يحكمه اليونكو

39
00:03:39,900 --> 00:03:41,510
،رسوا في جزيرة بانك هازارد

40
00:03:41,510 --> 00:03:44,200
،جزيرة منقسمة إلى جزئين
.الأراضي المشتعلة والأراضي المتجمّدة

41
00:03:45,530 --> 00:03:48,540
عرفَ لوفي بشأن التّجارب الشّنيعة

42
00:03:48,540 --> 00:03:51,030
،الّتي أجراها كلّ من السّيّد سيزار كلاون

43
00:03:51,030 --> 00:03:53,080
.وذهب ليتقصّى الأمر

44
00:03:53,620 --> 00:03:55,600
...لذا افترقت المجموعة. ولكن

45
00:03:56,000 --> 00:03:57,290
ما هذه؟

46
00:03:57,630 --> 00:03:59,670
إنّها آثار أقدام، أليس كذلك؟

47
00:04:00,130 --> 00:04:04,270
.أهي لحيوان؟ إن كان إنسانًا، لا بدّ أنّه عملاق

48
00:04:05,090 --> 00:04:07,300
.أستشعر شيئًا

49
00:04:07,610 --> 00:04:09,520
.مخلوقان شبيهان بالوحوش

50
00:04:09,720 --> 00:04:11,430
!ماذا سنفعل؟

51
00:04:11,430 --> 00:04:12,480
!أين هم؟

52
00:04:12,560 --> 00:04:14,860
لو؟ السّيّد؟

53
00:04:15,230 --> 00:04:19,070
!لا، نحن في جبل مكسيّ بالثّلوج، لذا لا بدّ أنّه هما

54
00:04:19,570 --> 00:04:24,360
!قاتلا الجبل الثّلجيّ، يظهران من عمق العاصفة الثّلجيّة

55
00:04:26,280 --> 00:04:27,540
أنت اللّحية البنّيّة، أليس كذلك؟

56
00:04:28,210 --> 00:04:32,370
.اسمك موجود في لائحة اغتيالنا أيضًا

57
00:04:35,020 --> 00:04:38,420
!أنتما، لم تؤذيا أصدقائي، أليس كذلك؟

58
00:04:49,030 --> 00:04:50,350
!ماذا؟ أين ذهب؟

59
00:04:51,640 --> 00:04:55,440
!آسف! أخذا نامي معهما

60
00:04:59,150 --> 00:05:03,200
"!أنقذ نامي! معركة لوفي في الجبال الثّلجيّة"

61
00:05:05,280 --> 00:05:07,030
!اختطفوا نامي؟

62
00:05:07,030 --> 00:05:08,540
.كان ذلك خطئي

63
00:05:08,540 --> 00:05:11,040
،مع أنّهما كانا ضخمان جدًّا

64
00:05:11,490 --> 00:05:13,670
لم ألحظ أنّهما هناك

65
00:05:13,670 --> 00:05:15,420
.إلى أن ظهرا أمامي فجأةً

66
00:05:15,580 --> 00:05:18,450
!أوّلاً القناطير والآن الرّجال الوحوش؟

67
00:05:18,450 --> 00:05:20,630
!هناك الكثير من المخلوقات الغريبة هنا

68
00:05:20,750 --> 00:05:25,800
.ربّما كانوا ينتظرون فرصتهم للهجوم علينا في مكان ما

69
00:05:25,920 --> 00:05:30,510
!ألم يأتيا إلى هنا لإنقاذ التّمساح البنّيّ؟

70
00:05:30,800 --> 00:05:35,140
.بدا أنّ هدفهما الأساسيّ هو قتلنا وأخذ الأطفال

71
00:05:35,730 --> 00:05:40,110
.لكن أوّلاً، قتلنا اللّحية البنّيّة بأمر من السّيّد

72
00:05:40,460 --> 00:05:42,480
.كان يفترض أن يكونوا حلفاء

73
00:05:42,480 --> 00:05:44,900
.أُعجبَ به اللّحية البنّيّة كثيرًا

74
00:05:45,320 --> 00:05:48,790
!كان السّيّد منقذنا الطّيّب

75
00:05:49,700 --> 00:05:50,950
!لوفي

76
00:05:50,950 --> 00:05:53,950
.هذا المدعو بالسّيّد هو شخص مخبول حقًّا

77
00:05:54,540 --> 00:05:59,330
!لا يمكنني أن أترك هؤلاء الأطفال يعودون إلى شرّير مثله

78
00:05:59,790 --> 00:06:03,380
!كما لا أستطيع سوى أن أقلق على نامي في جسد فرانكي

79
00:06:03,380 --> 00:06:04,880
!لا ندري ماذا قد يفعلون لها

80
00:06:06,590 --> 00:06:08,840
!أجل، سأستعيدها بأيّ ثمن

81
00:06:09,240 --> 00:06:11,260
!اعتنوا أنتم بالأطفال

82
00:06:11,260 --> 00:06:13,010
!انتظر يا لوفي

83
00:06:13,180 --> 00:06:15,810
!لقد أخذا جسدي

84
00:06:16,180 --> 00:06:19,040
!تشوبّر، لا أستطيع القتال هكذا

85
00:06:19,040 --> 00:06:21,730
أعطني حبّة الفول الّتي تأكلها عندما تحوّل

86
00:06:21,730 --> 00:06:23,190
!نفسك إلى وحش

87
00:06:23,480 --> 00:06:24,550
!ليست حبّة فول

88
00:06:24,550 --> 00:06:26,740
!كرة رامبل هي عقّار قوّة

89
00:06:26,740 --> 00:06:29,200
.لا أظنّك تستطيع التّحكّم به

90
00:06:29,660 --> 00:06:34,030
!يمكنني التّعامل مع الأمر بروحي الخارقة

91
00:06:34,030 --> 00:06:38,210
!أعطني إيّاها فحسب! لا نملك وقتًا

92
00:06:39,620 --> 00:06:40,830
.لا خيار أمامي

93
00:06:41,050 --> 00:06:41,880
ماذا؟

94
00:06:46,590 --> 00:06:48,050
واحدة فقط، مفهوم؟

95
00:06:48,050 --> 00:06:50,970
!حقًّا؟! أكانت في هذا الجيب طوال هذا الوقت؟

96
00:06:51,220 --> 00:06:53,680
.بالطّبع. إنّها لتشوبّر

97
00:06:53,970 --> 00:06:58,100
.اسمع. يمكنك أن تصبح وحشًا لثلاث دقائق فقط

98
00:06:58,100 --> 00:06:59,810
.لا يمكنك أن تقاتل بعد ذلك

99
00:07:00,310 --> 00:07:03,540
...لذا إن أمكنك، تحوّل إلى نقطة تعزيز الكونغ فو و

100
00:07:05,070 --> 00:07:07,030
!ماذا؟

101
00:07:08,280 --> 00:07:09,490
!خارق

102
00:07:09,490 --> 00:07:11,450
!هذا سابق لأوانه كثيرًا

103
00:07:14,370 --> 00:07:16,480
!هيّا يا فرانكي! من هنا

104
00:07:28,590 --> 00:07:31,090
!لماذا تهاجمني؟

105
00:07:37,180 --> 00:07:40,000
!لا! خرج عن السّيطرة كما ظننت

106
00:07:40,640 --> 00:07:44,360
إذًا أهناك مغزى من ذهاب فرانكي؟

107
00:07:44,480 --> 00:07:47,750
بعد أن ثار، لن يستطيع الحراك لفترة

108
00:07:47,750 --> 00:07:49,870
.لذا لن يكون ذا نفع إطلاقًا

109
00:07:49,870 --> 00:07:51,200
.بل سيكون عبئًا

110
00:07:58,490 --> 00:08:03,370
...لا أدري من أين حصل عليه، لكنّ هذا الـ"سّايبورغ" فرانكي

111
00:08:03,370 --> 00:08:06,290
.يملك سلاح ليزر فيغابانك مُركّبًا على جسده

112
00:08:07,130 --> 00:08:12,130
.سأستفيد جيّدًا من اختراع فيغابانك

113
00:08:12,820 --> 00:08:17,430
،بعد أن أقطع جسده وأستخرج منه نظام اللّيزر

114
00:08:17,680 --> 00:08:22,140
!سيكون بلا فائدة. حضّروا المحرقة

115
00:08:22,140 --> 00:08:22,980
.حاضر

116
00:08:23,320 --> 00:08:27,310
كيف يجري الأمر مع أغبياء البحريّة الّذين أتوا لسرقة السّفينة؟

117
00:08:27,480 --> 00:08:28,690
.صحيح

118
00:08:29,340 --> 00:08:32,320
...باغتناهم بنجاح ولكن

119
00:08:41,450 --> 00:08:43,040
!ما هم؟

120
00:08:43,040 --> 00:08:44,870
!بشر؟! لا، أحصنة؟

121
00:08:45,000 --> 00:08:46,920
!اقتلوهم جميعًا

122
00:08:47,880 --> 00:08:50,380
!لن نُهزم بتلك السّهولة

123
00:08:50,630 --> 00:08:52,550
!انظر خلفك

124
00:08:53,630 --> 00:08:54,510
!ماذا؟

125
00:09:03,890 --> 00:09:05,520
!ها نحن أولاء

126
00:09:05,520 --> 00:09:06,860
!هناك المزيد

127
00:09:06,860 --> 00:09:08,400
!هذا ليس جيّدًا

128
00:09:08,400 --> 00:09:09,400
!لا ملاذ لنا

129
00:09:11,730 --> 00:09:13,330
!علينا أن نغيّر تكتيكاتنا

130
00:09:13,330 --> 00:09:15,640
!لنحاول أخذ السّفينة بكلّ قوّتنا

131
00:09:29,280 --> 00:09:31,800
!النّقيب-تشان... أقصد، سموكر-سان

132
00:09:32,460 --> 00:09:35,220
.المعركة خارجة عن السّيطرة الآن

133
00:09:35,780 --> 00:09:36,940
...تقصد

134
00:09:38,180 --> 00:09:39,890
.أنّنا نعاني أمامهم

135
00:09:40,430 --> 00:09:41,890
...أقصد

136
00:09:44,700 --> 00:09:46,390
!لديّ فكرة

137
00:09:52,610 --> 00:09:54,940
سـ-سيّدي؟

138
00:09:56,900 --> 00:09:58,990
.إنّنا نتعامل مع البحريّة

139
00:09:58,990 --> 00:10:03,360
!إنّها الفرصة الأمثل لاختباره

140
00:10:05,200 --> 00:10:08,500
!أجل، ذلك ممتاز! لنفعل ذلك

141
00:10:11,250 --> 00:10:15,260
.اتّصلا بالقناطير الّذين يقومون بدوريّة الآن

142
00:10:15,260 --> 00:10:16,090
!حاضر

143
00:10:16,220 --> 00:10:21,210
أخبرا كلّ الجنود الآخرين أن يخلوا
.المكان إن كانوا يريدون النّجاة

144
00:10:31,810 --> 00:10:34,350
!دعاني! دعاني أيّهما الأحمقان

145
00:10:34,350 --> 00:10:36,900
!ما بالكما؟! أيّها المنحرفان

146
00:10:36,900 --> 00:10:39,290
!ماذا ستفعلان لي؟

147
00:10:39,290 --> 00:10:42,510
،أعلم أنّني جميلة وأملك قوامًا جميلاً

148
00:10:42,510 --> 00:10:44,470
!لذا لم تستطيعا سوى أن تختطفاني

149
00:10:44,470 --> 00:10:46,840
عمّ يتحدّث هذا الشّخص؟

150
00:10:46,840 --> 00:10:49,830
.لا بدّ أنّه أوكاما. هذا بارد

151
00:10:49,830 --> 00:10:54,000
!ستدفعان ثمن هذا! لن يسامحكما لوفي

152
00:10:54,000 --> 00:10:57,040
!آمل أن يوسعكما ضربًا

153
00:10:59,010 --> 00:11:02,690
...الزم الصّمت قليلاً. المزعجون من أمثالك

154
00:11:02,930 --> 00:11:04,810
.ليسوا رائعين

155
00:11:04,970 --> 00:11:09,020
...لكنّ الأسلحة المركّبة على جسدك

156
00:11:09,020 --> 00:11:10,350
.رائعة

157
00:11:10,350 --> 00:11:13,320
...إن أعطيناها للسّيّد، مكافأتنا ستكون

158
00:11:16,320 --> 00:11:18,340
!رائعة جدًّا

159
00:11:24,660 --> 00:11:27,410
.الجوّ بارد اليوم كما العادة

160
00:11:29,290 --> 00:11:31,230
!جسدي بارد

161
00:11:34,340 --> 00:11:35,590
!إذًا ارتديا بعض الثّياب

162
00:11:37,340 --> 00:11:42,300
.بنادقنا أشبه بالمدافع لكم أيّها البشر

163
00:11:42,300 --> 00:11:44,320
.لدينا عبوّات غازات سامّة أيضًا

164
00:11:44,320 --> 00:11:47,970
.لا يستطيع أيّ أحد هزيمتنا لأنّنا لا نظهر نفسينا

165
00:11:47,970 --> 00:11:49,270
أقلت أنّ صديقك سيأتي؟

166
00:11:49,730 --> 00:11:53,560
.أنا واثق أنّه سيأتي. نصبنا فخًّا لاستدراجه

167
00:11:53,560 --> 00:11:58,360
.لا يستطيع النّاس سوى تتبّع آثار الأقدام في الثّلج

168
00:12:05,180 --> 00:12:07,930
!آثار أقدام! آثار أقدام! هذا يساعد كثيرًا

169
00:12:07,930 --> 00:12:10,370
!من السّهل جدًّا ملاحقتهما

170
00:12:14,580 --> 00:12:17,650
!يا فرانكي، قلتُ توقّف

171
00:12:17,650 --> 00:12:18,590
ماذا؟

172
00:12:23,880 --> 00:12:25,680
...آثار الأقدام تنتهي هناك

173
00:12:32,140 --> 00:12:33,020
ماذا؟

174
00:12:33,140 --> 00:12:36,520
!لوفي وتشوبّر... لا، فرانكي؟

175
00:12:36,810 --> 00:12:38,760
!نامي

176
00:12:39,990 --> 00:12:42,380
!احذر! إنّهما في الجوار

177
00:12:46,950 --> 00:12:48,490
هل نفعلها يا سكوتش؟

178
00:12:48,490 --> 00:12:52,290
!حسنًا! لم يلحظ وجود جرف. إنّه طائش بحقّ

179
00:12:53,900 --> 00:12:56,040
!هنالك أشواك في الأسفل

180
00:12:57,130 --> 00:12:58,750
.موتا هباءً

181
00:12:58,750 --> 00:13:00,460
!فلتثقب جسداكما بأشواك الجليد

182
00:13:03,300 --> 00:13:04,840
!لون التّسلّح، التّصليب

183
00:13:05,240 --> 00:13:07,010
...فاكهة المطّاط

184
00:13:07,050 --> 00:13:11,310
!المدفع الرّشّاش

185
00:13:24,030 --> 00:13:27,530
.فهمت. لن يكون الأمر بتلك البساطة

186
00:13:31,980 --> 00:13:33,540
!ذلكما الاثنان من ذي قبل

187
00:13:36,480 --> 00:13:37,880
!المستوى الثّاني

188
00:13:39,420 --> 00:13:41,170
...فاكهة المطّاط

189
00:13:42,130 --> 00:13:43,420
...المسدّس

190
00:13:43,420 --> 00:13:45,300
!النّفّاث

191
00:13:49,220 --> 00:13:50,220
...الختم

192
00:13:51,570 --> 00:13:53,450
!النّفّاث

193
00:13:54,890 --> 00:13:56,140
!لقد اختفيا ثانيةً

194
00:14:02,560 --> 00:14:06,150
.أيّها الأحمق. نعرف هذه الجبال كما لو أنّها فناؤنا

195
00:14:06,330 --> 00:14:10,120
!هناك الكثير من الأماكن الّتي نستطيع الاختباء فيها

196
00:14:16,500 --> 00:14:18,170
.لا بدّ أنّه في الجوار

197
00:14:18,170 --> 00:14:20,170
.المكان الّذي ذكره السّيّد

198
00:14:24,280 --> 00:14:27,300
.إنّه مبنى ضخم

199
00:14:27,300 --> 00:14:28,950
أهو مستودع؟

200
00:14:28,950 --> 00:14:31,140
.إنّه غريب بعض الشّيء

201
00:14:31,140 --> 00:14:34,400
.هذا هو الباب، صحيح؟ حسنًا، سأحاول فتحه

202
00:14:47,570 --> 00:14:50,360
!إنّه متعنّت! ساعدوني يا رفاق

203
00:15:13,440 --> 00:15:16,040
.أظنّني سمعتُ شيئًا

204
00:15:16,040 --> 00:15:17,560
.لم أسمع أيّ شيء

205
00:15:17,870 --> 00:15:21,760
مهلاً، ألم يتمّ تحذيرنا من الاقتراب من هنا؟

206
00:15:22,180 --> 00:15:24,110
ألا بأس بفتحه فعلاً؟

207
00:15:24,680 --> 00:15:28,380
.السّيّد هو من أخبرنا بهذا وهو من يريد منّا فتحه

208
00:15:28,380 --> 00:15:30,900
ألا تثق بالسّيّد؟

209
00:15:31,180 --> 00:15:33,580
!لـ-لا، هذا ليس ما قصدت

210
00:15:33,580 --> 00:15:36,120
!إذًا كفّ عن الشّكوى وساعدنا

211
00:16:29,500 --> 00:16:31,820
.يتحرّكان بسرعة كبيرة مع أنّهما ضخمان

212
00:16:32,350 --> 00:16:33,300
!صحيح

213
00:16:33,560 --> 00:16:34,590
...فاكهة المطّاط

214
00:16:34,920 --> 00:16:36,350
!إنّه طريق مسدود

215
00:16:37,110 --> 00:16:39,060
!البالون

216
00:16:43,330 --> 00:16:44,890
من الخسارة استخدام هذه القوّة

217
00:16:44,890 --> 00:16:47,020
.دفاعيًّا فقط وترك الرّصاصات ترتدّ عشوائيًّا

218
00:16:47,540 --> 00:16:49,150
.هذا ما قال ريلي

219
00:16:49,690 --> 00:16:51,790
أخبرني أن أركّز على إعادة توجيه

220
00:16:51,790 --> 00:16:53,900
!كلّ واحدة منها بضعف القوّة

221
00:16:55,110 --> 00:16:56,700
...فاكهة المطّاط

222
00:16:56,700 --> 00:16:58,380
!تحيّة النّار

223
00:17:03,830 --> 00:17:04,790
!روك

224
00:17:04,790 --> 00:17:06,330
!نجح

225
00:17:12,820 --> 00:17:15,090
!توقّف يا فرانكي

226
00:17:15,840 --> 00:17:18,960
!لماذا تعاني معه أكثر؟

227
00:17:23,840 --> 00:17:25,670
.جسدي ساخن

228
00:17:25,670 --> 00:17:28,400
!هل يتجادلان الآن؟ بئسًا لهما

229
00:17:30,840 --> 00:17:31,730
!توقّف

230
00:17:32,480 --> 00:17:33,930
!انظر لهذا عليك اللّعنة

231
00:17:33,930 --> 00:17:35,900
.الجبال الجليديّة مليئة بالأسلحة المحتملة

232
00:17:45,750 --> 00:17:48,290
!احذرا! ستسقط قمّة الجبل الجليديّ

233
00:17:48,890 --> 00:17:51,420
!لوفي! فرانكي! احترسا

234
00:17:53,640 --> 00:17:56,010
!لا يمنكما الهرب منها

235
00:17:56,010 --> 00:17:58,280
!الآخر هناك أيضًا

236
00:17:59,430 --> 00:18:03,570
"فلتختنقا بعبوّة غاز "كي واي بي
هذه الّتي ستجعلك ثملين في لحظة

237
00:18:03,570 --> 00:18:05,930
!وموتا كأصدقائكما

238
00:18:14,280 --> 00:18:16,110
!قام بشيء فظيع

239
00:18:28,410 --> 00:18:31,290
!أجل! كان ذلك رائعًا يا فرانكي

240
00:18:34,990 --> 00:18:37,470
!أنت، يكفي

241
00:18:38,800 --> 00:18:40,010
!المستوى الثّالث

242
00:18:41,510 --> 00:18:43,470
...فاكهة المطّاط

243
00:18:43,710 --> 00:18:46,180
!مسدّس الفيل

244
00:18:50,730 --> 00:18:53,400
!هل استخدم أكبر هجماته عليه؟

245
00:18:55,150 --> 00:18:55,940
!لا

246
00:18:56,240 --> 00:18:57,990
!لوفي

247
00:19:00,120 --> 00:19:01,320
!لا

248
00:19:01,320 --> 00:19:03,240
!آسف يا فرانكي وتشوبّر

249
00:19:03,240 --> 00:19:05,840
!سأطلب من تشوبّر علاجك لاحقًا

250
00:19:05,840 --> 00:19:07,320
!انتظر

251
00:19:09,070 --> 00:19:12,570
.كما أخبرتك. نعرف هذه الجبال كما لو أنّها فناؤنا

252
00:19:12,570 --> 00:19:14,090
!لا يمكنك أن تلحق بي

253
00:19:14,200 --> 00:19:15,630
!النّجدة

254
00:19:42,320 --> 00:19:43,160
!نامي

255
00:19:43,760 --> 00:19:44,930
!أنت لا تستسلم

256
00:19:44,930 --> 00:19:46,950
!لكن أستطيع الوصول لأماكن أبعد منك

257
00:19:50,620 --> 00:19:52,920
.عجبًا! إنّه كقرد

258
00:19:52,920 --> 00:19:54,170
!حسنًا

259
00:20:07,300 --> 00:20:11,140
،سحقًا! بما أنّها سلسلة جبال كبيرة
!سيكون من المزعج أن أفقد أثرهما

260
00:20:19,380 --> 00:20:20,070
...إنّه

261
00:20:20,700 --> 00:20:24,240
أنت القاطن المجّانيّ ترافالغار لو، أليس كذلك؟

262
00:20:24,530 --> 00:20:26,310
.مسرور لرؤيتك هنا

263
00:20:26,510 --> 00:20:29,240
...كنت ملاحقًا من قبل قبّعة القشّ لوفي و

264
00:20:29,620 --> 00:20:30,580
.غرفة

265
00:20:33,870 --> 00:20:34,790
ماذا؟

266
00:21:11,360 --> 00:21:14,160
!أيّها الوغد! ما الّذي تفعله؟

267
00:21:27,860 --> 00:21:29,640
.الصّدمة المضادّة

268
00:21:54,890 --> 00:21:56,310
!شكرًا

269
00:21:56,310 --> 00:21:59,550
!لا! مهلاً، أعد لي جسدي

270
00:21:59,550 --> 00:22:01,130
!نامي

271
00:22:01,130 --> 00:22:01,920
!لوفي

272
00:22:03,330 --> 00:22:04,630
!تورا-أو

273
00:22:04,940 --> 00:22:07,380
هل أنقذت نامي؟

274
00:22:08,920 --> 00:22:10,730
.كنتُ أفكّر

275
00:22:12,230 --> 00:22:16,060
.وأتيت إلى هنا لأحدّثك عن أمرٍ ما يا قبّعة القشّ-يا

276
00:22:18,600 --> 00:22:21,950
.أظنّ أنّكم أتيتم إلى هذه الجزيرة صدفةً

277
00:22:22,970 --> 00:22:27,810
لكن هنالك مفتاح مهمّ يقبع في مكان ما في هذه الجزيرة

278
00:22:27,810 --> 00:22:30,230
.يمكنه أن يعيث فسادًا في العالم الجديد

279
00:22:31,890 --> 00:22:35,150
.ثمّة طريقتان فقط للنّجاة في العالم الجديد

280
00:22:37,660 --> 00:22:40,000
إمّا أن تعيش تحت راية اليونكو

281
00:22:40,780 --> 00:22:42,660
.أو أن تجابههم

282
00:22:44,800 --> 00:22:49,330
.وأظنّ أنّك لستَ بشخص قد يرغب في العمل تحت إمرة أحد

283
00:22:50,400 --> 00:22:53,310
.أجل، أريد أن أبقى قبطانًا

284
00:22:53,490 --> 00:22:58,410
!إذًا، علينا أن نشكّل تحالفًا

285
00:22:58,860 --> 00:22:59,750
ماذا؟

286
00:23:00,090 --> 00:23:01,320
تحالف؟

287
00:23:02,050 --> 00:23:05,820
.إن وحّدنا أنا وأنت قوّتنا، فربّما نستطيع النّجاح

288
00:23:11,490 --> 00:23:13,240
...لديّ خطّة

289
00:23:14,150 --> 00:23:16,380
!للإطاحة بأحد اليونكو

290
00:23:23,200 --> 00:23:25,830
.يعلن لو نيّته لهزيمة اليونكو

291
00:23:25,830 --> 00:23:29,740
لا يسع نامي والبقيّة إلاّ أن يتردّدوا
...بسبب التّفاصيل المرعبة

292
00:23:29,740 --> 00:23:32,600
،لكنّ إجابة لوفي لم تفاجئ طاقمه فحسب

293
00:23:32,600 --> 00:23:34,590
.بل ولو أيضًا

294
00:23:34,590 --> 00:23:38,600
في نفس الأثناء، كان سيزار بدوره

295
00:23:38,600 --> 00:23:40,390
.يضع خطّة شنيعة قيد التّنفيذ

296
00:23:40,390 --> 00:23:41,810
:في الحلقة القادمة من وان بيس

297
00:23:41,810 --> 00:23:44,690
"!شُكّل! تحالف قراصنة لوفي ولو"

298
00:23:44,690 --> 00:23:46,930
!ملك القراصنة، لن يكون إلاّ أنا

299
00:23:49,990 --> 00:23:54,990
!!نراكم في الحلقة القادمة