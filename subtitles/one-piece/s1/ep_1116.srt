1
00:00:00,000 --> 00:00:05,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:09,660 --> 00:00:12,500
في نهاية الأحلام، في نهاية البحر

3
00:00:12,500 --> 00:00:15,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:15,000 --> 00:00:18,010
ولكن أوّلاً، علينا صنع

5
00:00:18,010 --> 00:00:22,890
أسطورة لامعة من أنفسنا

6
00:00:22,890 --> 00:00:25,720
شرارات متطايرة من هنا بلا حدود

7
00:00:25,720 --> 00:00:27,350
!وان بيس

8
00:00:27,350 --> 00:00:29,980
سنخبر جميعنا الرّحّالة

9
00:00:29,980 --> 00:00:33,980
هل ما زالت أحلامكم واضحة؟

10
00:00:35,360 --> 00:00:42,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:42,030 --> 00:00:48,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:00:48,500 --> 00:00:51,120
سنخبر جميعنا الرّحّالة

13
00:00:51,120 --> 00:00:54,880
لا توجد قتالات بلا معنى

14
00:00:56,540 --> 00:01:03,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:03,010 --> 00:01:09,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:09,600 --> 00:01:15,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:15,730 --> 00:01:22,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:28,240 --> 00:01:30,760
مرحبًا بالجميع! كيف حالكم؟

19
00:01:31,000 --> 00:01:33,620
ماذا؟ هل اشتقتم إليّ؟

20
00:01:33,790 --> 00:01:36,460
.من الصّعب أن يكون المرء نجمًا

21
00:01:38,550 --> 00:01:41,260
ما الهراء الّذي تتفوّه به يا كرنب؟

22
00:01:41,420 --> 00:01:44,300
!بارتولوميو! اسمي ليس كرنب

23
00:01:44,470 --> 00:01:46,510
،اسمي كافندش

24
00:01:46,640 --> 00:01:50,850
قبطان قراصنة السّفينة الأولى
.في أسطول قبّعة القشّ الكبير

25
00:01:51,020 --> 00:01:54,600
يبدو أنّنا سنقدّم هذا التّقرير
.الجيش الثّوريّ اليوم

26
00:01:54,730 --> 00:01:55,600
!بالتّأكيد

27
00:01:55,730 --> 00:01:59,480
،إنّها منظّمة لها ارتباط كبير بلوفي-سينباي

28
00:01:59,650 --> 00:02:02,150
.لذلك فلنراجع كلّ شيء بالتّفاصيل

29
00:02:02,320 --> 00:02:03,700
إنّ الثّورة الحقيقيّة

30
00:02:03,820 --> 00:02:08,120
.هي ما يجلبه جمالي لعصر القراصنة العظيم

31
00:02:08,280 --> 00:02:11,160
.يمكنكم إنجاز تقرير عنّي بدل ذلك إن أردتم

32
00:02:11,290 --> 00:02:14,410
!كفاك ثرثرة ولنبدأ يا كرنب

33
00:02:14,540 --> 00:02:16,500
!أخبرتك ألاّ تنادني كرنب

34
00:02:16,620 --> 00:02:17,500
...والآن

35
00:02:17,670 --> 00:02:19,130
!لنبدأ

36
00:02:20,750 --> 00:02:25,230
!سجلّ الثّورة المضطربة"
"!مناورات الجيش الثّوريّ السّرّيّة

37
00:02:28,720 --> 00:02:32,520
.يريد الجيش الثّوريّ الإطاحة بحكومة العالم

38
00:02:32,680 --> 00:02:37,440
.وهم تحت قيادة مونكي د. دراغون

39
00:02:37,580 --> 00:02:39,850
!إنّه والد لوفي-سينباي

40
00:02:39,990 --> 00:02:42,690
.علينا الذّهاب لإلقاء التّحيّة عليه يومًا ما

41
00:02:42,820 --> 00:02:45,320
،كانت هويّته مجهولة في السّابق

42
00:02:45,450 --> 00:02:48,660
.لكن تمّ الكشف عنها في حرب القمّة

43
00:02:51,280 --> 00:02:56,290
الغراند لاين
مقرّ الجيش الثّوريّ الرّئيسيّ   بالتيغو

44
00:02:52,200 --> 00:02:56,290
دراغون-سان! تُحقّق جيوش
!التّمرّد النّصر في كلّ أرجاء العالم

45
00:02:56,410 --> 00:03:02,550
القائد العام للجيش الثّوريّ
مونكي د. دراغون

46
00:02:56,830 --> 00:03:00,920
.كان لسقوط عائلة دونكيهوتي تأثيرًا كبيرًا

47
00:03:02,170 --> 00:03:06,230
.كانت هذه الدّول العديدة متورّطة في تهريب الأسلحة

48
00:03:07,020 --> 00:03:08,800
.ستزداد الحروب

49
00:03:09,010 --> 00:03:12,130
.لكن أخبرهم ألاّ يتحمّسوا كثيرًا بنصرهم

50
00:03:12,260 --> 00:03:13,010
!حاضر

51
00:03:13,270 --> 00:03:15,770
.لن تقف حكومة العالم بلا حراك طويلاً

52
00:03:15,900 --> 00:03:18,650
.لقد عزّزوا سايفر بول في السّنوات الأخيرة

53
00:03:18,790 --> 00:03:21,110
.لذلك أخبرهم أن يأخذوا حذرًا أكثر –
!حاضر –

54
00:03:24,360 --> 00:03:26,320
كيف حال روبين؟

55
00:03:26,590 --> 00:03:29,010
ألن تسأل عن حال لوفي-كُن؟

56
00:03:32,080 --> 00:03:35,200
.سمعت ما يكفي عنه

57
00:03:35,340 --> 00:03:38,540
.تقصد أنّ سابو-كُن أخبرك بالكثير

58
00:03:39,680 --> 00:03:42,510
...على أيّ حال يا كوالا –
.حاضرة –

59
00:03:42,860 --> 00:03:45,510
.إنّنا نحتاج لمساعدتهم

60
00:03:46,050 --> 00:03:47,080
مساعدتهم؟

61
00:03:49,020 --> 00:03:53,300
استدعي كلّ قادة الجيش الثّوريّ
!في كلّ أنحاء العالم

62
00:03:53,450 --> 00:03:54,330
.حاضرة

63
00:03:54,630 --> 00:03:58,480
ماذا؟! هل تريد فعلاً استدعاء كلّ تلك
!الشّخصيّات المهمّة ثانية؟

64
00:03:59,200 --> 00:04:01,520
،خلال مأساة أوهارا قبل 22 سنة

65
00:04:01,690 --> 00:04:06,530
،فقد دراغون صديقه كلوفر
.عالم الآثار الّذي قتلته الحكومة

66
00:04:06,690 --> 00:04:08,950
.وبسبب ذلك، أسّس الجيش الثّوريّ

67
00:04:09,070 --> 00:04:11,910
.لا يجب الاستهانة بوالد لوفي-سينباي أبدًا

68
00:04:12,040 --> 00:04:14,910
لحسن الحظّ أنّ حكومة العالم الّتي تُمثّلها

69
00:04:15,060 --> 00:04:17,790
لم تكتشف قيمة الكتب وإلاّ كانت
.عادت لتدمير ما بقي منها

70
00:04:17,960 --> 00:04:20,460
...ماذا؟ مهلاً لحظة، أنا لستُ

71
00:04:20,760 --> 00:04:22,440
.جعلتني هذه الأخبار أشعر بالغثيان

72
00:04:22,580 --> 00:04:25,920
...لا أصدّق أنّك صرت كلبًا للحكومة

73
00:04:28,420 --> 00:04:34,210
بسبب جريمة التّعبير عن آرائهم للقوّة
،القاسية وغير العادلة الّتي هي القانون

74
00:04:34,350 --> 00:04:36,760
سُحقّ أولئك الأكاديميّون
!بأشدّ أنواع العنف

75
00:04:39,530 --> 00:04:42,690
لكنّي سأؤسّس جيشًا قادرًا
!على القتال بالفعل

76
00:04:43,270 --> 00:04:45,520
!ستقوم بذلك رغم كرهك للحرب؟

77
00:04:46,110 --> 00:04:48,080
.انتظر فحسب يا فيغابانك

78
00:04:48,380 --> 00:04:50,360
!سأغيّر العالم

79
00:04:51,070 --> 00:04:52,660
...سأحرص كلّ الحرص

80
00:04:53,490 --> 00:04:56,630
!ألاّ يكون موت كلوفر ولا إرادة أوهارا هباءً

81
00:04:58,490 --> 00:05:01,410
.إنّ هذا الجيش مجموعة من الأشخاص الفريدين

82
00:05:01,660 --> 00:05:05,210
على سبيل المثال، قائد قوّات الغراند لاين

83
00:05:05,340 --> 00:05:06,960
.إمبوريو إيفانكوف

84
00:05:07,460 --> 00:05:12,430
إلى جانب كونه من مؤسّسي الجيش
.الثّوريّ، فهو أيضًا ملكة مملكة كاماباكّا

85
00:05:12,800 --> 00:05:17,430
تجعله قوّة فاكهة الهرمونات
.صانع معجزات حقيقيّ

86
00:05:17,590 --> 00:05:20,600
.كان سجينًا سابقًا في إمبل داون

87
00:05:20,850 --> 00:05:23,940
وهناك، أسّس أرض النيوكاما

88
00:05:24,140 --> 00:05:28,190
.لجمع رفاق وانتظار الفرصة المناسبة للهرب

89
00:05:28,510 --> 00:05:30,960
...مرحبًا بكم

90
00:05:32,780 --> 00:05:35,690
!في المستوى 5.5 من إمبل داون

91
00:05:35,820 --> 00:05:38,570
!إنّها حديقة سرّيّة للسّجناء

92
00:05:39,370 --> 00:05:42,490
!أرض النيوكاما

93
00:05:45,540 --> 00:05:49,960
.تسلّل قبّعة القشّ إلى إمبل داون لتحرير إيس

94
00:05:50,120 --> 00:05:52,720
.وأنقذ إيفانكوف حياته

95
00:05:53,680 --> 00:05:56,890
!يا لها من سعادة
!يا للوفي-سينباي المسكين

96
00:05:59,050 --> 00:06:00,830
.عشر سنوات من حياتك

97
00:06:01,280 --> 00:06:07,730
سوف يقتطع هذا العلاج عشر
سنوات من حياتك في المستقبل

98
00:06:07,900 --> 00:06:09,170
.يا فتى قبّعة القشّ

99
00:06:11,400 --> 00:06:12,690
!مفهوم

100
00:06:12,990 --> 00:06:18,740
!هرمونات إمبوريو الشّافية

101
00:06:25,320 --> 00:06:30,170
قابل سانجي بعد ذلك في كاماباكّا
.حيث قام بتدريبه

102
00:06:30,300 --> 00:06:34,270
،إنّه لا يعرف لوفي-سينباي فقط
!بل سانجي-سينباي أيضًا

103
00:06:34,420 --> 00:06:36,180
!يا له من شخص مميّز

104
00:06:36,310 --> 00:06:38,050
!لن نتساهل معك

105
00:06:38,430 --> 00:06:39,720
!أتطلّق قُدمًا لذلك

106
00:06:41,140 --> 00:06:42,140
!ها أنا ذا

107
00:06:44,770 --> 00:06:48,770
التّالي في التّقرير هو قائد سابق
.في الجيش الثّوريّ، بارثولوميو كوما

108
00:06:48,900 --> 00:06:51,980
،كان من مؤسّسي الجيش الثّوريّ أيضًا

109
00:06:52,110 --> 00:06:56,360
إلى جانب كونه شيتشيبوكاي سابق
.وملك سابق لمملكة سوربي

110
00:06:56,700 --> 00:07:00,370
.إنّه رجل الكفّ لأنّه أكل فاكهة الكفّ

111
00:07:01,320 --> 00:07:02,760
الكفّ؟

112
00:07:02,910 --> 00:07:04,950
أيّ نوع من القدرات هي هذه؟

113
00:07:05,740 --> 00:07:07,790
...صائد القراصنة زورو

114
00:07:08,330 --> 00:07:10,670
.سأبدأ بك

115
00:07:21,260 --> 00:07:24,400
!مدفع العنقاء ذو السّتّة والثّلاثين رطلاً

116
00:07:33,320 --> 00:07:35,780
!صدّ هجوم زورو بيده العارية

117
00:07:35,900 --> 00:07:37,320
!أهذا ممكن؟

118
00:07:37,820 --> 00:07:41,130
.أملك القوّة لصدّ الكثير من الأشياء

119
00:07:41,700 --> 00:07:45,950
.أنا رجل الكفّ، تناولتُ فاكهة الكفّ

120
00:07:50,740 --> 00:07:53,630
!مسكين زورو-سينباي، يبدو أنّه يتألّم كثيرًا

121
00:07:53,770 --> 00:07:56,180
.ليتني أستطيع أخذ مكانه

122
00:07:57,310 --> 00:07:58,550
!من تكون؟

123
00:07:59,050 --> 00:08:00,460
،وفي شابوندي

124
00:08:00,600 --> 00:08:05,040
يُعتقد أنّه استعمل قواه لإرسال
.الطّاقم بعيدًا عن البحريّة

125
00:08:05,330 --> 00:08:08,640
إن كنتَ ستسافر، فأين نريد أن تذهب؟

126
00:08:11,940 --> 00:08:13,540
—مهلاً، أنا ميّت بالفـ

127
00:08:17,150 --> 00:08:19,880
!سحقًا لك

128
00:08:25,750 --> 00:08:27,290
—لوفي... أنقـ

129
00:08:33,910 --> 00:08:35,330
!لوفي

130
00:08:37,380 --> 00:08:38,830
...الوداع

131
00:08:51,460 --> 00:08:54,790
،وبعد أن التقى بكوما في حرب القمّة

132
00:08:54,920 --> 00:08:57,100
.عرف إيفانكوف الحقيقة الصّادمة

133
00:08:57,450 --> 00:09:00,020
إيفا-تشان، هل تعرفه؟

134
00:09:00,160 --> 00:09:03,360
.نوعًا ما. لكنّه يتصرّف بغرابة

135
00:09:03,820 --> 00:09:09,260
بتعبير آخر، تطوّع ليكون فأر تجارب
...لدراسة لبناء سلاح بشريّ

136
00:09:09,400 --> 00:09:11,660
.تديرها الحكومة

137
00:09:12,240 --> 00:09:19,590
قاموا بتعديل جسمه شيئًا فشيئًا
.بينما كان عقله ما زال سليمًا

138
00:09:19,760 --> 00:09:23,380
ماذا؟ كان يفقد شخصيّته شيئًا فشيئًا؟

139
00:09:23,520 --> 00:09:25,090
!هذا فظيع

140
00:09:26,450 --> 00:09:28,760
،كان يُفترض أن يفقد شخصيّته بالكامل

141
00:09:28,910 --> 00:09:32,470
ولكن خلال فترة السّنتين
،الّتي كان الطّاقم يتدرّب فيها

142
00:09:32,600 --> 00:09:34,900
.قام بحماية السّفينة ساني

143
00:09:35,060 --> 00:09:36,650
.كنت أنتظرك

144
00:09:38,110 --> 00:09:40,320
!ما الّذي تفعله هنا؟

145
00:09:39,480 --> 00:09:40,320
فرانكي

146
00:09:41,420 --> 00:09:43,630
.تمّ إنجاز المهمّة

147
00:09:44,610 --> 00:09:48,200
!انظروا إليه يغادر وهو في حالة يُرثى لها

148
00:09:49,120 --> 00:09:50,900
.أريد البكاء

149
00:09:51,620 --> 00:09:55,630
.لقد صار بعد ذلك عبدًا للتّنانين السّماويّين

150
00:09:55,760 --> 00:10:00,000
!إنّه لا يصرخ حتّى. يا له من عبد ممتاز-إي

151
00:10:00,180 --> 00:10:03,170
!أحسدك يا والدي-ساما

152
00:10:04,120 --> 00:10:06,380
تسلّل الجيش الثّوري

153
00:10:06,520 --> 00:10:10,430
.إلى أرض ماريجوا المقدّسة لمساعدته على الهرب

154
00:10:10,660 --> 00:10:13,140
!كوما-سان، لا يجدر بك الحركة

155
00:10:13,270 --> 00:10:14,850
!ما زلت بحاجة للإصلاح

156
00:10:21,940 --> 00:10:23,740
!كوما-سان –
!ما الخطب؟ –

157
00:10:25,370 --> 00:10:28,200
!هل ما زالت البحريّة تتلاعب به؟

158
00:10:30,920 --> 00:10:32,220
!يا له من منعطف دراميّ

159
00:10:32,370 --> 00:10:36,420
،رغم أنّه كان يفترض به أن يفقد إرادته الحرّة

160
00:10:36,540 --> 00:10:38,790
،ذهب كوما إلى الرّيد لاين

161
00:10:38,920 --> 00:10:42,340
.وبدأ يتسلّق القارّة الضّخمة الّتي تضمّ ماريجوا

162
00:10:43,360 --> 00:10:45,880
!ما الّذي يبحث عنه يا ترى؟

163
00:10:52,720 --> 00:10:56,580
!جهّزوا أنفسكم لأنّنا سنتحدّث عن رجل مميّز الآن

164
00:10:58,220 --> 00:11:00,940
.لن أسمح لك بالحصول على فاكهة اللّهب

165
00:11:04,240 --> 00:11:06,450
!يا قبّعة القشّ لوفي

166
00:11:21,960 --> 00:11:25,220
من أنت في الحقيقة؟

167
00:11:28,090 --> 00:11:30,220
.اسمي سابو

168
00:11:36,480 --> 00:11:39,480
.نحن محاربون من الجيش الثّوريّ

169
00:11:39,770 --> 00:11:40,990
!الجيش الثّوريّ؟

170
00:11:41,110 --> 00:11:43,920
،وها هو ذا! الرّجل الثّاني في الجيش الثّوريّ

171
00:11:44,070 --> 00:11:46,820
!رئيس الأركان، سابو-سينباي

172
00:11:46,970 --> 00:11:48,900
!لا تصرخ عاليًا يا هذا

173
00:11:49,060 --> 00:11:53,140
!سابو-سينباي هو أخو لوفي-سينباي الأكبر

174
00:11:53,280 --> 00:11:56,200
!دع هذا الجزء لي

175
00:11:56,400 --> 00:11:58,460
!ماذا؟ إذًا، هل لوسي الأوّل أيضًا؟

176
00:11:58,870 --> 00:12:01,700
.على رأس لوسي الأوّل مكافأة تقدّر بـ400 مليون

177
00:12:01,830 --> 00:12:04,380
!إنّه الرّجل الّذي سيصير ملك القراصنة يومًا

178
00:12:04,990 --> 00:12:06,590
!قبعة القش لوفي

179
00:12:07,200 --> 00:12:08,450
!قرصان؟

180
00:12:08,720 --> 00:12:12,510
!نعم، إنّه أخي. اعتني به

181
00:12:12,720 --> 00:12:16,430
ولكن لماذا أنتم أيّها الجيش
الثّوريّ في هذه الدّولة؟

182
00:12:24,020 --> 00:12:25,220
...هذه

183
00:12:25,780 --> 00:12:30,740
هذه الأسلحة التي يصدرونها من هذا الميناء
.تزيد من خطورة الحروب في العالم

184
00:12:32,940 --> 00:12:34,180
...إنّنا هنا

185
00:12:34,830 --> 00:12:36,660
!لإيقاف ذلك

186
00:12:38,700 --> 00:12:43,960
،أرسل الجيش الثّوريّ جنودًا لهذه الدّولة عدّة مرّات

187
00:12:44,750 --> 00:12:47,590
،ولكن بما أنّهم جميعًا تحوّلوا لدمى

188
00:12:47,800 --> 00:12:51,040
.لم نتمكّن من معرفة هذه السّوق السّوداء

189
00:12:52,890 --> 00:12:56,720
.ولكن أعتقد أنّهم يصنعون الأسلحة في مكان آخر

190
00:12:59,140 --> 00:13:02,600
من أين تأتي؟

191
00:13:06,050 --> 00:13:07,730
،إن عرفنا ذلك

192
00:13:08,080 --> 00:13:11,600
.فسيسّر دراغون-سان

193
00:13:12,660 --> 00:13:16,530
تسلّل سابو-سينباي إلى دريسروزا لوضع حدّ

194
00:13:18,700 --> 00:13:22,500
،ثمّ عرف أنّ إرث إيس
،المتمثّل في فاكهة اللّهب

195
00:13:22,620 --> 00:13:26,070
،هو الجائزة الأولى في منافسات الكولوسيوم

196
00:13:26,230 --> 00:13:28,750
.حيث أخذ مكان لوفي

197
00:13:28,880 --> 00:13:29,960
...وبعد ذلك

198
00:13:35,970 --> 00:13:37,040
!مذاقها مقرف

199
00:13:38,540 --> 00:13:40,360
!قبضة اللّهب

200
00:13:51,110 --> 00:13:53,070
!إنّه قويّ للغاية

201
00:13:53,200 --> 00:13:55,990
!كان يفترض بي أنا أكل تلك الفاكهة

202
00:14:00,160 --> 00:14:04,290
!لا أهتمّ، ولكنّ إيس قال أنّه لن يغفر لك

203
00:14:04,420 --> 00:14:07,130
!إنّ سابو-سينباي يُذهلنا جميعًا

204
00:14:07,250 --> 00:14:09,920
كان قبّعة القشّ يظنّ أنّه ميت؟

205
00:14:10,050 --> 00:14:14,510
.نعم. ذلك لأنّه كان ضحيّة حادث مأساويّ

206
00:14:16,550 --> 00:14:21,810
قبل 12 سنة سابو 10 سنوات

207
00:14:16,680 --> 00:14:21,810
هـ-هل تعلم أنّه ستضرم نار في غري ترمينال اللّيلة؟

208
00:14:23,760 --> 00:14:26,560
!علينا أن نتستّر على الخطّة جميعًا

209
00:14:26,730 --> 00:14:28,940
!نحن استثناء

210
00:14:30,510 --> 00:14:32,320
!إيس! لوفي

211
00:14:32,570 --> 00:14:35,860
!ثمّة خطب بهذه البلدة! الجميع مجانين

212
00:14:36,280 --> 00:14:38,170
،مع أنّهم يعلمون أنّ النّاس سيموتون قريبًا

213
00:14:38,320 --> 00:14:41,080
إلاّ أنّهم يتصرّفون بشكل
!طبيعيّ وحتّى أنّهم يبتسمون

214
00:14:41,710 --> 00:14:45,750
!لا أريد البقاء هنا
!عليّ أن أخبرهما بسرعة

215
00:14:48,920 --> 00:14:51,550
!إيس! لوفي! اهربا

216
00:15:00,760 --> 00:15:02,840
ماذا حلّ بك يا فتى؟

217
00:15:09,730 --> 00:15:15,060
.هذه البلدة أوسخ من غري ترمينال

218
00:15:15,690 --> 00:15:19,430
!تفوح منها رائحة الفاسدين

219
00:15:21,200 --> 00:15:26,410
!إن بقيت هنا... فلن أتحرّر أبدًا

220
00:15:32,930 --> 00:15:35,460
ما هي الحرّيّة؟

221
00:15:36,200 --> 00:15:37,630
وأين يمكنني إيجادها؟

222
00:15:39,460 --> 00:15:43,680
لا يجب على عامّيّ أن يسير
!في طريق سفينتي

223
00:15:59,570 --> 00:16:02,350
...لهذا السّبب فقد ذاكرته

224
00:16:03,400 --> 00:16:07,080
،نعم، لكن بعد أن عرف بموت إيس من الصّحيفة

225
00:16:07,200 --> 00:16:09,580
.عادت إليه كلّ ذكرياته

226
00:16:12,170 --> 00:16:15,590
...من مات لم يكن مجرّد قرصان ما

227
00:16:20,970 --> 00:16:24,100
...كان إيس

228
00:16:24,890 --> 00:16:26,740
!أخي

229
00:16:34,200 --> 00:16:36,040
،وفي الكولوسيوم

230
00:16:36,200 --> 00:16:39,610
.كان اللّقاء بينه وبين لوفي-سينباي لقاءً مؤثّرًا

231
00:16:40,890 --> 00:16:42,980
.هذا أنا يا لوفي

232
00:16:44,490 --> 00:16:45,950
!أنا لوسي

233
00:16:46,120 --> 00:16:49,960
أتعتقد أنّني لن أميّز وجه أخي الصّغير
!فقط بسبب تنكّر ما؟

234
00:16:50,980 --> 00:16:52,170
!أخي الصّغير"؟"

235
00:16:52,430 --> 00:16:55,010
...اسمع، الوحيدين اللّذين بإمكانهما مناداتي أخي

236
00:16:55,140 --> 00:16:58,380
هو إيس المتوفّى والشّخص الّذي
...مات قبله بكثير

237
00:17:01,800 --> 00:17:03,120
...ما-مات

238
00:17:19,900 --> 00:17:23,490
!ما الّذي... أين كنت طوال هذا الوقت؟

239
00:17:23,780 --> 00:17:26,780
!ظننتُ أنّك ميت

240
00:17:30,710 --> 00:17:32,500
!شكرًا يا لوفي

241
00:17:33,880 --> 00:17:36,640
!أنا سعيد لأنّك حيّ

242
00:17:40,700 --> 00:17:44,210
أيمكنني أكل فاكهة اللّهب؟

243
00:17:46,010 --> 00:17:47,720
!نعم! نعم

244
00:17:48,850 --> 00:17:52,350
!سيكون ذلك ممتازًا
!هذا هو الخيار الوحيد الّذي لدينا

245
00:17:57,980 --> 00:17:59,880
.سأغادر الآن –
بهذه السّرعة؟ –

246
00:18:00,080 --> 00:18:01,360
...رأيتُ وجهه

247
00:18:04,080 --> 00:18:07,200
،حسنًا. قد يكون لوفي صعب المراس

248
00:18:07,330 --> 00:18:08,670
.ولكن اعتنوا به رجاءً

249
00:18:09,950 --> 00:18:12,790
!يا له من رجل طيّب جدًّا

250
00:18:12,910 --> 00:18:15,670
،لوفي-سينباي وسابو-سينباي

251
00:18:15,790 --> 00:18:18,250
!إنّ عظمة روحكما تملؤني بالبهجة

252
00:18:18,380 --> 00:18:20,250
...إنّك دراماتيكيّ للغاية

253
00:18:20,710 --> 00:18:22,130
!لنواصل

254
00:18:22,740 --> 00:18:27,760
كان الجيش الثّوريّ سيُعلن الحرب على
!التّنانين السّماويّين في قمّة اللّيفيلي

255
00:18:28,010 --> 00:18:31,680
إضافة إلى استعادة كوما
.أمام أنظار الجميع

256
00:18:32,410 --> 00:18:36,040
...في اللّيفيلي القادم، أخيرًا

257
00:18:38,040 --> 00:18:40,170
...سنعلن الحرب

258
00:18:39,230 --> 00:18:43,740
سابو
رئيس أركان الجيش الثّوريّ

259
00:18:41,400 --> 00:18:43,080
.على التّنانين السّماويّين

260
00:18:44,270 --> 00:18:46,530
‫أنت أيها الحارس! أخرج سلاحك!

261
00:18:47,030 --> 00:18:50,490
‫أسقط الغربان! ستفرقع الفقاعة!

262
00:18:52,550 --> 00:18:53,790
‫لا تقلق.

263
00:18:54,040 --> 00:18:57,290
‫ستكون بخير أيّها الملك ستيلي.

264
00:18:57,460 --> 00:18:58,880
،بعد هذه الحادثة

265
00:18:59,040 --> 00:19:02,620
.ذاع صيت سابو أكثر ولُقّب بإمبراطور اللّهب

266
00:19:02,770 --> 00:19:06,940
.أوصلت الصّحف أخباره لكلّ العالم

267
00:19:07,090 --> 00:19:11,360
يا للفضيحة! وجهي أنا هو الّذي
!يجب أن يكون على الصّفحة الأولى

268
00:19:11,640 --> 00:19:12,640
...سابو

269
00:19:12,890 --> 00:19:15,960
.إنّ العالم يعتبرونه بطلاً سلفًا

270
00:19:17,100 --> 00:19:21,770
من بين ذرّيّة مؤسّسي حكومة
،العالم العشرين قبل 800 سنة

271
00:19:21,900 --> 00:19:24,230
.وحده من حضر قمّة اللّيفيلي

272
00:19:25,020 --> 00:19:27,860
إنّ اغتيال ملك ألاباستا كوبرا

273
00:19:28,030 --> 00:19:31,410
.أثبت أنّه مهمّ للجيش الثّوريّ

274
00:19:33,040 --> 00:19:34,980
،قبل بضع ساعات من ذلك

275
00:19:35,110 --> 00:19:38,240
،على أرض الآلهة حيث يقيم التّنانين السّماويّون

276
00:19:38,380 --> 00:19:40,210
أعلن الجيش الحرب

277
00:19:40,330 --> 00:19:44,160
بتدميرهم لمخالب التّنانين السّماويّين
،الّتي هي علامة لنبلاء العالم

278
00:19:44,630 --> 00:19:48,530
على الرّغم من ردّ الفعل من الجنود
.بقيادة فوجيتورا وريوكوغيو

279
00:19:48,680 --> 00:19:49,760
...وفي النّهاية

280
00:19:49,900 --> 00:19:53,760
استطاع الجيش الثّوريّ تحرير رفيقهم
،السّابق بارثولوميو كوما

281
00:19:53,890 --> 00:19:56,100
.الّذي كان عبدًا للتّنانين السّماويّين

282
00:19:56,240 --> 00:19:58,060
.نجحوا جميعًا في الهرب

283
00:19:59,190 --> 00:20:02,650
وكلّ العناصر التّخريبيّة حول العالم

284
00:20:02,900 --> 00:20:07,650
.بدأت تبجّل سابو وكأنّه إله حقيقيّ

285
00:20:08,360 --> 00:20:11,870
!لقد لقّبوه بإمبراطور اللّهب

286
00:20:12,200 --> 00:20:14,330
،بعد مغادرة ماريجوا

287
00:20:14,450 --> 00:20:19,370
.شهِد سابو على الدّمار الشّامل لمملكة لولوسيا

288
00:20:30,800 --> 00:20:33,620
!محا ذلك السّلاح بلدًا بأكملها عن وجه الأرض

289
00:20:33,760 --> 00:20:36,850
كيف يُعقل وجود شيء مرعب كهذا؟

290
00:20:37,240 --> 00:20:41,210
لكنّ تسلّله إلى ماريجوا
،وخروجه من هناك حيًّا

291
00:20:41,360 --> 00:20:43,910
.هو إنجاز يليق بأخي لوفي-سينباي الكبير

292
00:20:44,060 --> 00:20:47,330
.كِلا الأخوين تحت الأضواء الآن

293
00:20:47,480 --> 00:20:49,520
.إنّهما ثنائيّ مذهل بكلّ تأكيد

294
00:20:49,690 --> 00:20:52,370
!يواصل قائدنا العظيم إذهالنا دائمًا

295
00:20:53,450 --> 00:20:54,870
.لنتوقّف هنا

296
00:20:55,030 --> 00:20:58,950
.إنّ الجيش الثّوريّ مرتبط بشدّة بالطّاقم

297
00:20:59,080 --> 00:21:00,790
.سيستمرّ دائمًا في إذهالي

298
00:21:00,940 --> 00:21:04,290
!كان عليّ أن أطلب توقيع سابو-سينباي

299
00:21:04,420 --> 00:21:08,210
.من الأفضل أن نراقب الجيش الثّوريّ

300
00:21:08,380 --> 00:21:11,840
ربّما يكون لهم شأن ما مع طاقم
.لوفي-سينباي ثانية في المستقبل

301
00:21:11,970 --> 00:21:13,640
!لا يجب أن نفوّت أيّ شيء

302
00:21:13,760 --> 00:21:16,050
.يكاد الوقت أن ينتهي

303
00:21:16,220 --> 00:21:17,720
!نلتقي في وقت آخر جميعًا

304
00:21:17,850 --> 00:21:21,060
!أريد مقابلة فرديّة المرّة القادمة

305
00:21:21,230 --> 00:21:23,560
!لن نقوم بذلك أبدًا

306
00:21:23,730 --> 00:21:26,060
!إلى اللّقاء يا رفاق

307
00:21:31,900 --> 00:21:37,490
إلى أيّ مدى هربنا؟

308
00:21:37,660 --> 00:21:44,620
نعدّ النّدوب دون أن نعرف

309
00:21:44,960 --> 00:21:51,880
وفي بالي دائمًا، خريطة كنز

310
00:21:51,880 --> 00:21:58,350
أبحث باستمرار عن المستقبل

311
00:21:58,350 --> 00:22:11,900
توجد الوعود الحقيقيّة عميقًا في القلب

312
00:22:11,900 --> 00:22:21,370
للجميع أحلام لا يستطيع أحد اللّحاق بها

313
00:22:21,370 --> 00:22:27,000
تمسّكوا بذلك الحلم فقط

314
00:22:27,000 --> 00:22:34,130
إليك يا من تبتسم مثل الشّمس

315
00:22:34,130 --> 00:22:41,100
لنغنّ نفس الأغنية مثل ذلك اليوم

316
00:22:41,100 --> 00:22:48,150
حتّى إن كبر بنا العمر، لا أريد أن أنسى

317
00:22:48,150 --> 00:22:55,570
إلى أن تصلك هذه الأمنية

318
00:23:05,370 --> 00:23:09,020
سيُكشف السّتار أخيرًا عن الهجوم الصّادم
!على أرض ماريجوا المقدّسة

319
00:23:09,170 --> 00:23:11,960
.اغتيال الملك كوبرا واختفاء الأميرة فيفي

320
00:23:12,130 --> 00:23:16,500
ما الّذي كان يحدث خلف كواليس
الحادثة الّتي هزّت العالم؟

321
00:23:16,650 --> 00:23:21,410
إنّ قوّات الجيش الثّوريّ الّتي يقودها
!سابو تحتشد في أرض الآلهة

322
00:23:21,560 --> 00:23:22,850
:في الحلقة القادمة من وان بيس

323
00:23:22,980 --> 00:23:26,480
"!عودة سابو! الحقيقة المروّعة الّتي يجب أن تُقال"

324
00:23:26,620 --> 00:23:28,970
!ملك القراصنة، لن يكون إلاّ أنا