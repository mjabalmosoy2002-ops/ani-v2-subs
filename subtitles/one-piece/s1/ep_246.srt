1
00:00:04,200 --> 00:00:05,740
!لا تذهبي يا روبين

2
00:00:06,200 --> 00:00:08,120
!لم ينته كلامنا بعد

3
00:00:08,120 --> 00:00:13,080
.بلى، انتهى. لن أراكم ثانيةً أبدًا

4
00:00:16,760 --> 00:00:19,880
!لوفي! أسرع وأمسك روبين

5
00:00:26,260 --> 00:00:27,020
!روبين

6
00:00:34,810 --> 00:00:37,610
!كيف لهم أن يكونوا أقوياء هكذا؟

7
00:00:43,410 --> 00:00:45,660
ما أنتم؟

8
00:00:46,410 --> 00:00:47,990
.نحن سي بي 9

9
00:00:48,830 --> 00:00:51,290
.هذا أمر فائق السّرّيّة على مستوى العالم

10
00:00:52,040 --> 00:00:55,380
.ليست مسألة ليتدخّل فيها أمثالكم

11
00:00:57,960 --> 00:01:01,590
.اقترب وقت انفجار أجهزة الإشعال
.علينا أن نسرع أيضًا

12
00:01:01,590 --> 00:01:02,470
.نعم

13
00:01:02,470 --> 00:01:04,300
.لكنّ هذه مناسبة نادرة

14
00:01:04,300 --> 00:01:07,560
.دعوني أريكم شيئًا مثيرًا للاهتمام قبل أن أذهب

15
00:01:29,370 --> 00:01:31,080
!فاكهة شيطان

16
00:01:32,710 --> 00:01:33,920
!ما هي؟

17
00:01:42,260 --> 00:01:45,300
لوتشي... ما الّذي...؟

18
00:01:47,180 --> 00:01:49,260
...فاكهة القطّ

19
00:01:52,890 --> 00:01:55,020
...من صنف النّمر المرقّط

20
00:01:56,730 --> 00:01:58,860
...إنسان نمر

21
00:01:58,860 --> 00:02:00,360
!إ-إنّه ضخم

22
00:02:01,110 --> 00:02:03,990
!ما بال شكله؟

23
00:02:04,950 --> 00:02:07,320
!ما أنت بالضّبط؟

24
00:02:14,000 --> 00:02:18,040
لا بأس! هيّا نمضي قُدمًا

25
00:02:18,340 --> 00:02:21,550
فالشّمس تُدفئ قلوبنا دومًا

26
00:02:21,710 --> 00:02:25,010
قوّةٌ تعبر بين أيادينا المتشابكة

27
00:02:25,130 --> 00:02:28,680
هيّا نُحقّق أمنيّاتنا

28
00:02:36,270 --> 00:02:42,480
بالعمل معًا، دعونا نركب الأمواج العاتية

29
00:02:43,780 --> 00:02:50,240
دعونا نسرع إلى التّشويق... ها هي إشارة البداية

30
00:02:57,960 --> 00:03:04,970
عبر الرّيح الملوّنة بألوان الطّيف نخترق صوبَ بحرِ المغامرة

31
00:03:05,090 --> 00:03:08,510
لن تسلم رحلتنا من الإصابات

32
00:03:08,590 --> 00:03:12,220
لكنّ ما نعتزّ به سيكون هناك

33
00:03:12,430 --> 00:03:16,350
وإن وقعت في مأزق

34
00:03:16,440 --> 00:03:18,350
ستجدني معك لأحميك

35
00:03:19,480 --> 00:03:23,320
لا بأس! هيّا نمضي قُدمًا

36
00:03:23,690 --> 00:03:26,780
فالشّمس تُدفئ قلوبنا دومًا

37
00:03:27,200 --> 00:03:30,320
حتّى إن عصفت عاصفة، سنعانق بعضنا

38
00:03:30,410 --> 00:03:34,200
ونوجّه ناظرنا إلى الضّوء البعيد

39
00:03:34,700 --> 00:03:37,920
إن جمعنا شظايا أحلامنا

40
00:03:38,420 --> 00:03:41,540
سنُشكّل خريطةً تقودنا إلى الغد

41
00:03:41,710 --> 00:03:44,670
لذا لنُحقّق أمنيّاتنا

42
00:03:45,130 --> 00:03:50,390
علمٌ واحد يجمعنا، نحن واحد

43
00:03:50,510 --> 00:03:52,470
وان بيس

44
00:04:03,040 --> 00:04:07,750
القضاء على قراصنة قبّعة القشّ؟"
"!تهديد صنف النّمر المرقّط

45
00:04:13,030 --> 00:04:14,780
!حريق

46
00:04:14,780 --> 00:04:16,740
!يا جماعة! استيقظوا

47
00:04:17,250 --> 00:04:20,960
سحقًا! أهذا من صنيع القراصنة؟

48
00:04:20,960 --> 00:04:23,670
!لا بدّ أنّه لا يزال الكثير من النّاس في الدّاخل

49
00:04:23,670 --> 00:04:27,300
!أين أيسبرغ-سان؟! ما الّذي يجري في الأعلى؟

50
00:04:27,300 --> 00:04:28,840
!لنذهب للتّفقّد

51
00:04:28,840 --> 00:04:33,300
!أسرعوا! أخمدوا النّار

52
00:04:44,440 --> 00:04:46,770
.يبدو أنّ النّار بدأت تنتشر

53
00:04:51,400 --> 00:04:55,280
لا أدري إن كنتَ إنسانًا نمرًا
...أم ماذا، لكن

54
00:04:55,280 --> 00:04:57,950
!لن أدعك تمسّ أيسبرغ-سان بسوء

55
00:05:00,290 --> 00:05:05,340
!يصبح مستخدمو نوع زون اللاّحم أكثر عدوانيّة

56
00:05:05,960 --> 00:05:11,840
صحيح. أنواع الفواكه هي لوغيا
...وزون وباراميسيا

57
00:05:11,840 --> 00:05:14,220
.توجد الكثير من القوى الفريدة

58
00:05:14,930 --> 00:05:21,270
.التّعزيز الجسديّ الحقيقيّ هو سمة أنواع زون

59
00:05:21,270 --> 00:05:24,730
.كلّما تدرّبنا، صرنا أقوى

60
00:05:26,940 --> 00:05:32,150
نوع زون هو أقوى الأصناف عندما
.يتعلّق الأمر بالهجوم القريب

61
00:05:32,950 --> 00:05:34,740
!اخرس

62
00:05:34,740 --> 00:05:38,740
!لا أريد أن أسمع أشياء عن الوحوش هكذا

63
00:05:39,870 --> 00:05:42,710
...لا نريد إهدار الوقت أيضًا

64
00:05:42,710 --> 00:05:48,090
بما أنّ علينا التّكفّل بكم قبل
.أن تلتهمنا ألسنة اللّهب

65
00:05:48,090 --> 00:05:49,550
!أيسبرغ-سان

66
00:05:49,550 --> 00:05:51,010
!رؤساء العمّال

67
00:05:52,340 --> 00:05:55,340
.لوتشي... إنّ الحرفيّين قادمون إلى الأعلى

68
00:05:55,930 --> 00:05:58,930
.لا تقلقي. لا يمكنهم الوصول إلى هنا

69
00:05:58,930 --> 00:06:00,970
!ساق العاصفة

70
00:06:12,150 --> 00:06:14,110
!...ارجعوا! إنّ السّقف

71
00:06:23,790 --> 00:06:24,660
!نامي

72
00:06:33,590 --> 00:06:35,050
!تشوبّر

73
00:06:36,430 --> 00:06:37,930
باولي، ما الّذي يجري؟

74
00:06:37,930 --> 00:06:40,100
!سأخرجك من هذا المكان مهما كان

75
00:06:40,100 --> 00:06:42,970
!هذا مستحيل! جراحك بليغة للغاية
...فكيف لك أن

76
00:06:44,480 --> 00:06:46,480
.توقّف يا باولي

77
00:06:50,440 --> 00:06:51,780
...لا تناديني باسمي

78
00:06:52,820 --> 00:06:54,490
!وكأنّنا صديقان

79
00:06:59,450 --> 00:07:03,660
!تنحّوا... عن طريقنا

80
00:07:09,000 --> 00:07:11,380
!...سحقًا لكم

81
00:07:11,960 --> 00:07:14,090
!لِمَ أنتم بالضّبط؟

82
00:07:15,050 --> 00:07:15,840
...أنا

83
00:07:16,920 --> 00:07:19,140
...على الأقلّ

84
00:07:20,300 --> 00:07:24,560
!اعتبرتكم أصدقائي طوال هذا الوقت

85
00:07:29,690 --> 00:07:31,560
.كان ذلك من جانبك فحسب

86
00:07:43,160 --> 00:07:45,620
!...وغد الحمامة

87
00:07:45,620 --> 00:07:46,950
!قبّعة القشّ

88
00:07:53,590 --> 00:07:55,250
.مسدّس الإصبع

89
00:07:56,550 --> 00:07:57,550
!لوفي

90
00:08:21,570 --> 00:08:24,200
!احظَ بتحليق ممتع خارج هذه الجزيرة

91
00:08:29,500 --> 00:08:31,620
!لوفي

92
00:08:34,250 --> 00:08:35,210
!أيّها الوغد

93
00:08:36,250 --> 00:08:38,260
.الجسد الحديديّ

94
00:08:53,350 --> 00:08:54,730
!زورو

95
00:09:09,250 --> 00:09:10,330
.أنت أيضًا

96
00:09:49,700 --> 00:09:54,710
!جدّتي! جدّتي! هنالك حريق كبير

97
00:09:54,710 --> 00:09:58,670
.إنّه مكتب غالي-لا الرّئيسيّ
...يا له من فعل مريع

98
00:10:00,630 --> 00:10:04,180
فعل مريع؟ هل الحريق من صنيع أحد؟

99
00:10:04,180 --> 00:10:06,680
...لا أدري

100
00:10:07,090 --> 00:10:11,020
.لكنّ الحدس السّيّئ يكون حقيقة أحيانًا

101
00:10:11,020 --> 00:10:13,140
.آمل أنّ أيسبرغ بخير

102
00:10:16,150 --> 00:10:21,360
.صدقًا، كلّ هذا بسبب ذلك الشّيء
.لا يجب أن يتواجد

103
00:10:31,160 --> 00:10:34,500
.ما يقوله القراصنة لا يُؤخذ كدليل

104
00:10:34,500 --> 00:10:37,290
.ستُدفن هذه الحادثة في غياهب الظّلام

105
00:10:38,580 --> 00:10:43,710
أيسبرغ-سان... مهما كنتَ
،مهندس بناء سفن بارع

106
00:10:43,710 --> 00:10:46,300
...وحتّى إن كنت عمدة هذه المدينة

107
00:10:46,840 --> 00:10:49,510
بما أنّك من عامّة النّاس، ما كان
يجب عليك أن تعصي

108
00:10:49,510 --> 00:10:52,010
.حكومة العالم القويّة

109
00:11:00,150 --> 00:11:04,530
...لنذهب. سنجد تلميذ توم الآخر، فرانكي

110
00:11:04,530 --> 00:11:09,030
.أو بالأحرى، كاتي فلام ونأخذ منه المخطّطات

111
00:11:25,010 --> 00:11:26,800
!هل أخرجتم الجميع؟

112
00:11:26,800 --> 00:11:30,550
!ما عدنا نستطيع الدّخول
!ليحسب كلّ فريق رجاله

113
00:11:30,550 --> 00:11:34,680
مهلاً، أين أيسبرغ-سان؟ هل رأيته؟

114
00:11:34,680 --> 00:11:37,440
...لا يعقل أنّه لا يزال في النّيران

115
00:11:37,440 --> 00:11:38,520
!أنا واثق أنّه بخير

116
00:11:39,190 --> 00:11:42,440
.ثلاثة من رؤسائنا معه. محال أنّه بقي هناك

117
00:11:42,440 --> 00:11:44,440
!اذهبوا وتفقّدوا المكان أيضًا

118
00:11:48,860 --> 00:11:50,240
...هذه المرأة

119
00:11:51,030 --> 00:11:54,200
!إنّها من طاقم قبّعة القشّ ممّا لا شكّ فيه

120
00:11:54,700 --> 00:11:57,000
هل قفزت من النّافذة؟

121
00:11:57,000 --> 00:12:00,500
.لا بدّ أنّ النّيران أحاطت بها وعانت لكي تهرب

122
00:12:01,290 --> 00:12:03,460
ماذا نفعل بها؟

123
00:12:03,460 --> 00:12:07,670
.صدقًا... يا له من فعلٍ مريع

124
00:12:07,670 --> 00:12:09,970
!سنسألها عن مكان البقيّة

125
00:12:09,970 --> 00:12:13,550
!سنقبض عليهم جميعًا ونسلّمهم إلى البحريّة

126
00:12:21,150 --> 00:12:25,020
بلونو... أكان فرانكي في حانتك؟

127
00:12:25,020 --> 00:12:26,190
.نعم

128
00:12:26,190 --> 00:12:28,740
.لكنّه هرع للبحث عن قبّعة القشّ

129
00:12:28,740 --> 00:12:30,360
...فهمت

130
00:12:32,070 --> 00:12:34,950
.يبدو أنّه لا يمكث في مكان واحد طويلاً

131
00:12:41,120 --> 00:12:41,830
.انظر

132
00:12:42,580 --> 00:12:44,840
!اسمع يا قبّعة القشّ

133
00:12:44,840 --> 00:12:46,800
!لقد قبضنا على طويل الأنف

134
00:12:46,800 --> 00:12:49,130
!أجل، إنّه معنا

135
00:12:49,130 --> 00:12:51,760
...إن كنت لا تريده أن يغرق في النّهر

136
00:12:51,760 --> 00:12:54,600
!غبيّ! ليس هكذا! كم مرّة يجب أن أخبرك؟

137
00:12:54,600 --> 00:12:56,810
!"بل "إن كنت لا تريده أن يغرق في البحر

138
00:12:57,260 --> 00:12:58,060
...في النّهر

139
00:12:58,060 --> 00:12:58,770
!"في البحر"

140
00:12:59,230 --> 00:13:02,310
!تبًّا، ما الّذي تنصت له؟

141
00:13:02,310 --> 00:13:05,520
!الأهمّ هو إيصال الرّسالة إلى قبّعة القشّ، صحيح؟

142
00:13:05,520 --> 00:13:07,570
!أخبرناك أنّ تلك الرّسالة لن تفلح

143
00:13:07,570 --> 00:13:09,650
.سيوسعك أخانا ضربًا

144
00:13:09,650 --> 00:13:11,700
يجب أن تقول، "إن كنت لا تريده
،أن يغرق في البحر

145
00:13:11,700 --> 00:13:14,450
!تعال إلى المستودع أسفل الجسر
"!مع تحيّات فرانكي

146
00:13:14,450 --> 00:13:15,830
!مفهوم؟

147
00:13:15,830 --> 00:13:21,540
.ناهيك أنّه حتّى إن أتى، سيوسعه أخي ضربًا

148
00:13:23,920 --> 00:13:28,130
قلتَ من ينتظر من وأين؟

149
00:13:28,130 --> 00:13:30,260
!من أنت؟

150
00:13:30,840 --> 00:13:33,800
!نحن مشغولون الآن! انصرف

151
00:13:33,800 --> 00:13:37,260
،إن كنتم لا تريدون الموت
.أجيبوا عن سؤالي بعد ثلاث ثوانٍ

152
00:13:39,970 --> 00:13:42,310
.هذا الشّخص يتفوّه بالهراء

153
00:13:42,310 --> 00:13:44,940
هل تعرف إلى أيّ عائلة ننتمي؟

154
00:13:48,570 --> 00:13:51,490
أيّ مكان تقصده بالمستودع الّذي أسفل الجسر؟

155
00:13:51,490 --> 00:13:54,280
فرانكي هناك، أليس كذلك؟

156
00:13:56,120 --> 00:13:58,990
أيّ شأن تملك مع أخي؟

157
00:13:58,990 --> 00:14:01,620
،إن كنت تريد الحديث معه
!فعليك الحديث معنا أوّلاً

158
00:14:16,970 --> 00:14:19,890
لا أصدّق أنّك تترك أصدقاءك
الّذين ارتحلت معهم

159
00:14:19,890 --> 00:14:22,270
كلّ هذه المسافة من الأزرق
...الشّرقيّ، من أجل السّفينة

160
00:14:23,310 --> 00:14:26,190
لماذا تبكون؟

161
00:14:26,190 --> 00:14:29,110
!غبيّ! لا نبكي يا غبيّ

162
00:14:29,110 --> 00:14:32,610
لكن صحيحٌ أنّني تأثّرت بحمايتك
لهذه السّفينة لوحدك

163
00:14:32,610 --> 00:14:34,530
!في خضمّ كلّ ما حدث

164
00:14:34,530 --> 00:14:38,240
!لسنا نبكي! لا أحد منّا يبكي

165
00:14:38,240 --> 00:14:40,580
ما بالهم؟

166
00:14:42,910 --> 00:14:47,630
على أيّ حال، بتّم تعرفون الآن أنّ أولئك
!الأشخاص لم يعودوا أصدقائي، صحيح؟

167
00:14:49,000 --> 00:14:50,380
...سوف

168
00:14:50,380 --> 00:14:53,050
!أغنّي من أجل صِعابك

169
00:14:53,050 --> 00:14:56,430
!عنوان الأغنيّة هو "صداقة مقطوعة
"!رياح الشّمال القاطعة

170
00:14:56,430 --> 00:14:58,300
!مرحى! أخي

171
00:14:58,300 --> 00:15:00,350
!هل تسخر منّي؟

172
00:15:06,270 --> 00:15:11,270
.هل الشّاي جاهز؟ أشعر بالعطش

173
00:15:11,270 --> 00:15:14,280
!حسنًا! سنحضره حالاً

174
00:15:15,690 --> 00:15:19,910
.أنهكني البكاء... ليس وكأنّني بكيت

175
00:15:23,540 --> 00:15:27,330
.تفضّل يا أخي. إنّه حامٍ قليلاً

176
00:15:29,420 --> 00:15:31,000
.شكرًا

177
00:15:31,590 --> 00:15:34,590
...فهمتُ إذًا يا أخي

178
00:15:35,880 --> 00:15:38,050
!هذا مؤلم، إنّه ساخن

179
00:15:38,050 --> 00:15:39,840
!هلاّ هدأت قليلاً؟

180
00:15:40,890 --> 00:15:44,180
.أنا آسفة يا أخي

181
00:15:44,180 --> 00:15:46,680
ما رأيك أن تأخذ استراحة
وتحتسي بعض الشّاي أيضًا؟

182
00:15:54,650 --> 00:15:56,530
.لا ألومك

183
00:15:56,530 --> 00:16:02,070
لا بدّ أنّك تكنّ ضغينة كبيرة تجاهنا
لأنّنا سرقنا منكم الـ200 مليون بيري

184
00:16:02,870 --> 00:16:06,700
.بما أنّ ذلك قاد إلى شجار كبير

185
00:16:07,500 --> 00:16:09,830
.كان ذلك مقدّرًا فحسب

186
00:16:09,830 --> 00:16:12,080
.لن تفيدني الضّغينة في شيء

187
00:16:13,130 --> 00:16:14,960
.تملك روحًا رياضيّة

188
00:16:14,960 --> 00:16:17,090
...فهمت

189
00:16:17,090 --> 00:16:18,670
...بشأن الـ200 مليون

190
00:16:19,590 --> 00:16:22,300
!أسرفتها كلّها

191
00:16:22,300 --> 00:16:23,890
هل تريدني أن أضربك؟

192
00:16:23,890 --> 00:16:27,140
.هوّن عليك... لا تغضب هكذا

193
00:16:27,140 --> 00:16:30,850
.أريتني مدى رجولتك

194
00:16:30,850 --> 00:16:35,980
لذا عليّ الآن أن أهدّئ أعصابي
بسبب الدّمار الكامل

195
00:16:35,980 --> 00:16:39,780
لمنزل فرانكي، الّذي كان منزلي
.ومصنع التّهديم

196
00:16:40,650 --> 00:16:44,280
!علاوةً على ذلك، قضيتم على أتباعي

197
00:16:44,280 --> 00:16:46,540
!كيف تجرؤون أيّها الأوغاد؟

198
00:16:46,540 --> 00:16:47,610
!أخي

199
00:16:47,610 --> 00:16:49,840
!لقد تصاعد غضبك

200
00:16:49,840 --> 00:16:51,790
!أوغاد

201
00:17:02,400 --> 00:17:04,680
،إذًا يا أخي، مع أنّ الكثير حدث

202
00:17:04,680 --> 00:17:07,560
دعنا نهدّئ غضبنا تجاه بعضنا
،البعض في هذه المسألة

203
00:17:07,560 --> 00:17:11,230
.ونحلّ الخلاف بالتّمادي

204
00:17:11,230 --> 00:17:13,020
.تقصد بالتّراضي

205
00:17:13,020 --> 00:17:16,320
.تقصد بالتّراضي يا أخي

206
00:17:16,320 --> 00:17:17,780
.أيًّا كان

207
00:17:19,990 --> 00:17:22,910
ماذا سنفعل الآن بما أنّك لوحدك؟

208
00:17:23,610 --> 00:17:25,530
ليس لديك مكان تقصده، صحيح؟

209
00:17:27,740 --> 00:17:31,960
.في تلك الحالة، يمكنني أن أضمّك لي
!اعمل لصالحي

210
00:17:32,620 --> 00:17:33,960
.أُعجبت بك

211
00:17:34,420 --> 00:17:38,210
.مستحيل! لا أريد أن أصبح عامل هدم

212
00:17:39,050 --> 00:17:41,920
!مع أنّني تركتُ مجموعتي، إلاّ أنّي لا أزال قرصانًا

213
00:17:43,630 --> 00:17:47,010
.استمعوا لأغنيّتي رجاءً
."بعنوان "قانون القراصنة

214
00:17:47,010 --> 00:17:49,140
!مرحى! أخي

215
00:17:49,140 --> 00:17:52,100
!سأسألك ثانيةً، هل تسخر منّي؟

216
00:17:52,600 --> 00:17:57,060
يا إلهي... إنّي أحاول أن أفكّر فيمَ
!يجب أن تفعل تاليًا، من أجل مصلحتك

217
00:17:57,060 --> 00:17:59,070
!ذلك ليس من شأنك

218
00:17:59,650 --> 00:18:03,240
وأيضًا، ألا بأس أن تسترخي في مكان كهذا؟

219
00:18:03,240 --> 00:18:05,030
ثمّة موجة عارمة تقترب، صحيح؟

220
00:18:05,030 --> 00:18:08,160
...أجل، ولهذا السّبب بالذّات

221
00:18:08,160 --> 00:18:12,000
،عندما تحلّ علينا أكوا لاغونا
.علينا مساعدة بعضنا

222
00:18:15,420 --> 00:18:17,250
،من الآن حتّى وقت متأخّر من اللّيل

223
00:18:17,250 --> 00:18:19,920
.ستُغمر المنازل بالمياه حتّى الطّابق الثّاني

224
00:18:19,920 --> 00:18:24,420
إن كنتَ في الشّوارع الخلفيّة أو الرّؤوس
.في وقتٍ كهذا، فأنت هالك لا محالة

225
00:18:24,420 --> 00:18:27,970
.لست بحاجة للقلق إن تركت سفينتك هنا أيضًا

226
00:18:28,720 --> 00:18:31,930
.شكرًا... أقدّر لك ذلك

227
00:18:31,930 --> 00:18:33,930
!أيّها الغبيّ! لا تتكلّم وكأنّنا غريبين عن بعضنا

228
00:18:33,930 --> 00:18:38,690
على أيّ حال، لا بدّ أنّ من الصّعب
.أن تتضرّروا من الفيضان هكذا كلّ عام

229
00:18:38,690 --> 00:18:42,780
الجميع معتادون على هذا الإخلاء
.السّنويّ على كلّ حال

230
00:18:43,740 --> 00:18:48,740
الإشكال الأكبر هو أنّ مستوى ماء
.البحر كان يتزايد كلّ عام

231
00:18:49,240 --> 00:18:53,750
المنطقة الخلفيّة الّتي ترونها فوق البحر
الآن هي في الواقع بلدة بُنيت على أسطح

232
00:18:53,750 --> 00:18:57,210
.بلدة قديمة تواجدت قبل مئات السّنين

233
00:18:57,210 --> 00:18:59,750
يقال أنّ جزيرة بناء السّفن والشّوارع الخلفيّة

234
00:18:59,750 --> 00:19:02,960
.كانت متّحدة على يابسة واحدة قبل وقتٍ طويل

235
00:19:02,960 --> 00:19:07,220
لكن باتت منطقة كبيرة منها غارقة
.تحت الماء وسُمّيت بالمدينة العائمة

236
00:19:07,220 --> 00:19:10,760
.أصبحت كلّ الأرصفة قنوات

237
00:19:10,760 --> 00:19:14,270
بالأحرى، بدلاً من القول
،أنّ مستوى الماء في ازدياد

238
00:19:14,270 --> 00:19:17,310
.نقول أنّ أساس الجزيرة يغرق

239
00:19:17,310 --> 00:19:21,980
على هذا الحال، المناطق الّتي نعيش
.فيها في البلدة ستتقلّص شيئًا فشيئًا

240
00:19:21,980 --> 00:19:27,740
فهمت... حتّى هذه المدينة
.العائمة الجميلة تمرّ بأزمات إذًا

241
00:19:29,160 --> 00:19:31,120
،لكن، إن اقتضت الحاجة

242
00:19:31,120 --> 00:19:34,240
بإمكانكم أخذ قطار البحر
.والذّهاب للعيش في مكانٍ آخر

243
00:19:34,450 --> 00:19:38,420
.بإمكانك قول ذلك الآن

244
00:19:38,420 --> 00:19:42,840
.لكنّ قطار البحر لم يُخترع إلاّ قبل نحو عقد

245
00:19:42,840 --> 00:19:47,880
.قبل ذلك الوقت، لم يكن التّنقّل عبر البحر سهلاً

246
00:19:49,550 --> 00:19:52,720
.بطبيعة الحال، قلّما استطاع النّاس التّنقّل بين الجزر

247
00:19:52,720 --> 00:19:53,890
،ففي هذه الجزيرة المعزولة

248
00:19:53,890 --> 00:19:58,520
تخيّل السّاكنة بشكل مبهم
أنّ أرضهم ستنغمر بالمياه يومًا ما

249
00:19:58,520 --> 00:20:02,110
.واستيأسوا تمامًا

250
00:20:13,450 --> 00:20:16,500
،وما طمأن قلوب النّاس حتّى عن المستقبل

251
00:20:16,500 --> 00:20:19,540
.كان قطار البحر، توم النّافث

252
00:20:19,540 --> 00:20:23,670
بإمكانهم الآن عبور البحر متى أرادوا
.دون الحاجة إلى بوصلة مسجّلة

253
00:20:23,670 --> 00:20:25,960
!لذا كان ذلك بمثابة تقدّم كبير

254
00:20:26,630 --> 00:20:28,920
.فهمت... لم أكن أعلم

255
00:20:28,920 --> 00:20:31,800
.قطار البحر شيء عظيم حقًّا

256
00:20:32,390 --> 00:20:35,560
.عادت ووتر سيفن إلى الحياة

257
00:20:35,560 --> 00:20:40,770
كلّ ذلك بفضل نجّار السّفن العظيم
.توم الّذي صنع قطار البحر

258
00:20:41,980 --> 00:20:46,020
.لقد أنقذنا جميعًا

259
00:20:54,240 --> 00:20:56,120
!أخي

260
00:20:59,370 --> 00:21:01,580
...النّجدة

261
00:21:06,210 --> 00:21:09,920
.سألقي التّحيّة على أخيكم من أجلكم

262
00:21:27,270 --> 00:21:28,230
.هيّا بنا

263
00:22:14,820 --> 00:22:19,450
جمعنا حلمٌ ذلك اليوم

264
00:22:19,450 --> 00:22:24,250
ثقتنا بأنفسنا

265
00:22:24,250 --> 00:22:33,300
ستقودنا لعبور البحر الشّاسع والعاصف

266
00:22:33,300 --> 00:22:42,810
أنت الأشجع والأكثر مراعاة بين الجميع

267
00:22:42,810 --> 00:22:53,030
إن تركت يومًا هذه السّفينة وذهبت للعيش في عالم آخر

268
00:22:53,030 --> 00:23:01,580
في النّهاية، سنبتسم سويًّا لا محالة

269
00:23:11,590 --> 00:23:13,800
أخبرني يا طويل الأنف، ماذا ستفعل
بعد إصلاحك لتلك السّفينة؟

270
00:23:13,800 --> 00:23:16,470
وماذا برأيك؟ سأذهب في مغامرة
...معها ثانيةً و

271
00:23:16,470 --> 00:23:18,550
.ذلك غير ممكن. لا تستطيع

272
00:23:18,550 --> 00:23:19,470
ماذا قلت؟

273
00:23:19,470 --> 00:23:22,970
لا تستطيع تلك السّفينة حتّى
.أن تدرك الجزيرة التّالية

274
00:23:22,970 --> 00:23:25,140
.سأساعدك على هدم تلك السّفينة

275
00:23:25,140 --> 00:23:28,060
!توقّف! ما الّذي تفعله؟

276
00:23:28,060 --> 00:23:29,020
:في الحلقة القادمة من وان بيس

277
00:23:29,020 --> 00:23:32,150
الرّجل الّذي يحظى بحبّ حتّى"
"!سفينته! دموع أوسوبّ

278
00:23:32,150 --> 00:23:34,480
!ملك القراصنة، لن يكون إلاّ أنا

279
00:23:36,110 --> 00:23:41,080
نلقاكم في الحلقة القادمة