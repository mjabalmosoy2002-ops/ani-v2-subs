1
00:00:26,390 --> 00:00:31,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:31,400 --> 00:00:37,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:37,150 --> 00:00:44,910
كنتُ أطارد ظهر شخص ما

4
00:00:44,910 --> 00:00:47,740
"وأقول "أريد أن أصير أقوى

5
00:00:47,740 --> 00:00:53,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:00:53,250 --> 00:00:58,380
فهل أصبح أقوى؟

7
00:00:58,380 --> 00:01:04,050
ما زلت أجهل الإجابة

8
00:01:04,050 --> 00:01:09,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:09,640 --> 00:01:11,850
هيّا بنا

10
00:01:11,850 --> 00:01:15,190
دون توقّف

11
00:01:15,190 --> 00:01:20,440
دون استسلام لمرور الوقت

12
00:01:20,440 --> 00:01:25,990
سأواصل النّهوض على قدميّ

13
00:01:25,990 --> 00:01:31,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:31,410 --> 00:01:36,840
ذلك الصّوت في داخلي

15
00:01:36,840 --> 00:01:42,170
يواصل دعمي

16
00:01:42,170 --> 00:01:47,260
والأمطار المخادعة ستعترض طريقي

17
00:01:47,260 --> 00:01:52,100
لكنّني لم أهرب بعيدًا

18
00:01:52,520 --> 00:01:55,400
أوه

19
00:01:55,400 --> 00:01:57,690
هيّا بنا

20
00:01:57,690 --> 00:02:00,980
دون توقّف

21
00:02:00,980 --> 00:02:06,200
دون استسلام لمرور الوقت

22
00:02:06,200 --> 00:02:11,870
سأواصل النّهوض على قدميّ

23
00:02:11,870 --> 00:02:17,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:17,460 --> 00:02:23,760
...نحو المستقبل الّذي أؤمن به

25
00:02:33,890 --> 00:02:36,980
.إنّه عصر القراصنة العظيم

26
00:02:36,980 --> 00:02:41,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:41,940 --> 00:02:44,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:45,650 --> 00:02:48,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:02:48,740 --> 00:02:50,660
،بعد أن أكل فاكهة المطّاط

30
00:02:50,660 --> 00:02:53,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:02:53,540 --> 00:02:57,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:02:57,540 --> 00:03:02,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:03,460 --> 00:03:05,130
!هذا شيّق

34
00:03:05,840 --> 00:03:08,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:08,760 --> 00:03:12,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:12,340 --> 00:03:15,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:20,230 --> 00:03:22,900
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:22,900 --> 00:03:27,630
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:27,630 --> 00:03:29,610
لكنّ كفاحه ذهب سدى

40
00:03:29,830 --> 00:03:35,680
.وحرب القمّة الأسطوريّة في مارينفورد انتهت

41
00:03:38,330 --> 00:03:45,210
...لكن قبل 10 سنوات، في الأزرق الشّرقيّ

42
00:03:45,210 --> 00:03:47,880
.لوفي، هذا إيس

43
00:03:47,880 --> 00:03:50,760
.ستعيش هنا معهم اعتبارًا من اليوم

44
00:03:50,760 --> 00:03:54,470
!خذني معك! لنصبح صديقين

45
00:04:14,700 --> 00:04:16,860
.إنّها نهاية الغابة

46
00:04:21,900 --> 00:04:26,230
"!ها هو ذا سابو! الفتى في غري ترمينال"

47
00:04:31,910 --> 00:04:34,400
!لا أصدّق أنّنا حقّقنا كلّ هذا المكسب

48
00:04:35,060 --> 00:04:37,140
!كان بورشيمي-سان محقًّا

49
00:04:38,030 --> 00:04:45,150
توسّل التّاجر الجشع للحصول عليه
!عندما أخبرناه أنّه كنز من الغراند لاين

50
00:04:45,150 --> 00:04:49,830
بينما في الواقع، كان مجرّد خردة
!وجدناها منفجرة في الشّاطئ

51
00:04:49,830 --> 00:04:53,350
!حالفنا الحظّ لأنّه كان مجرّد جبان لم يُبحر يومًا

52
00:04:54,580 --> 00:04:58,290
!لم نبحر نحن أيضًا

53
00:05:10,510 --> 00:05:13,340
مذهل! ما هذا المكان؟

54
00:05:14,730 --> 00:05:20,060
ثمّة مكان كهذا في الجانب الشّماليّ
.من جبل كولبو حيث تعيش عائلة دادان

55
00:05:21,040 --> 00:05:26,230
.ومعظمه كومة من القمامة المهملة

56
00:05:26,700 --> 00:05:29,690
.حيث ينتهي المطاف بالأشياء غير المرغوبة

57
00:05:30,630 --> 00:05:36,200
وهنا يعيش المحتالون الّذين تمّ
.نبذهم من المجتمع السّائد

58
00:05:36,530 --> 00:05:39,080
.ممّا لا يثير الدّهشة، إنّها منطقة منعدمة القانون

59
00:05:39,860 --> 00:05:44,030
.حيث تكثر الجرائم والأمراض نظرًا لعدم وجود أطبّاء

60
00:05:44,030 --> 00:05:47,960
.يدعى هذا المكان بغري ترمينال

61
00:05:50,200 --> 00:05:52,160
!إيس

62
00:05:57,000 --> 00:05:58,010
ما ذلك؟

63
00:06:12,000 --> 00:06:13,320
.ليس هنا

64
00:06:19,280 --> 00:06:23,000
!أنت! أين ذهبت؟

65
00:06:24,240 --> 00:06:26,120
!يا إيس

66
00:06:29,340 --> 00:06:31,800
!إيس

67
00:06:38,630 --> 00:06:41,650
.حلّ العصر بالفعل

68
00:06:43,680 --> 00:06:48,630
كنز، كنز! أيوجد أيّ شيء قيّم هنا؟

69
00:06:51,200 --> 00:06:53,030
!وجدتُ شيئًا

70
00:06:53,030 --> 00:06:54,400
!أعطني إيّاه

71
00:06:54,400 --> 00:06:55,610
!إنّه لي

72
00:06:55,610 --> 00:06:57,570
!توقّفوا! أنا من وجده

73
00:06:58,030 --> 00:07:00,070
!لا تلمسوه أيّها الحمقى

74
00:07:00,070 --> 00:07:02,580
!دعني أبعه من أجلك

75
00:07:02,580 --> 00:07:03,910
!لا يمكنك أخذه

76
00:07:03,910 --> 00:07:05,370
!توقّف

77
00:07:14,340 --> 00:07:15,250
!سحقًا لك

78
00:07:15,250 --> 00:07:15,880
!أعطني إيّاه

79
00:07:18,010 --> 00:07:22,650
!ما كنتَ لتتأذّى لو أنّك أعطيتني إيّاه

80
00:07:23,820 --> 00:07:25,520
!شكرًا جزيلاً

81
00:07:25,980 --> 00:07:28,150
!أيّها الحقير

82
00:07:30,310 --> 00:07:32,360
!لصّ

83
00:07:38,280 --> 00:07:40,320
!ابتعد عن طريقي أيّها الشّقيّ

84
00:07:41,200 --> 00:07:44,450
...أسرع! وإلاّ

85
00:07:44,450 --> 00:07:46,700
!ذهب من ذلك الاتّجاه

86
00:08:25,610 --> 00:08:27,450
!سابو! يا سابو، هل أنت هناك؟

87
00:08:30,280 --> 00:08:31,920
!هذا أنت يا إيس

88
00:08:32,580 --> 00:08:34,630
.آسف على التّأخّر

89
00:08:34,630 --> 00:08:36,050
.تأخّرت بالفعل

90
00:08:36,480 --> 00:08:39,570
.سبق وقمت ببعض الأعمال في المدينة

91
00:08:42,390 --> 00:08:45,100
.حقًّا؟ وأنا أيضًا

92
00:08:45,100 --> 00:08:46,890
!في آن واحد

93
00:08:46,890 --> 00:08:50,770
!عجبًا! حصلت على الكثير! أكثر ممّا كسبتُ بكثير

94
00:08:50,770 --> 00:08:53,770
ذلك مال كثير! كيف حصلت عليه؟

95
00:08:53,770 --> 00:08:57,280
!سرقتُ بعض البلطجيّة قرب البوّابة الرّئيسيّة

96
00:08:57,840 --> 00:09:01,280
!سحقًا! فزتَ ثانيةً

97
00:09:01,280 --> 00:09:03,420
.لا يهمّ إن فزت أو خسرت

98
00:09:04,070 --> 00:09:09,520
مضت خمس سنوات مذ بدأنا نضع
.المال في "مدّخرات القراصنة" خاصّتنا

99
00:09:12,750 --> 00:09:14,060
.عملنا بجدّ على ذلك

100
00:09:15,330 --> 00:09:16,590
.أجل

101
00:09:17,880 --> 00:09:22,380
سنغادر الأزرق الشّرقيّ ونذهب
.إلى مكان لم يحلم به هؤلاء النّاس قطّ

102
00:09:22,840 --> 00:09:25,790
!من الشّيّق مجرّد التّفكير في الأمر

103
00:09:32,270 --> 00:09:35,400
.والآن خبّئه. لا يمكننا أن ندع أيّ أحد يراه

104
00:09:35,400 --> 00:09:39,860
.أتساءل كم نحتاج للحصول على سفينة قراصنة

105
00:09:39,860 --> 00:09:43,820
لا أدري. ربّما 10 ملايين أو 100؟

106
00:09:43,820 --> 00:09:45,410
.ما زال الطّريق طويلاً أمامنا

107
00:09:45,410 --> 00:09:46,660
!سفينة قراصنة"؟"

108
00:09:47,330 --> 00:09:51,250
!يا رفاق! هل ستصبحان قرصانين؟

109
00:09:51,250 --> 00:09:54,920
!سأصبح كذلك أيضًا

110
00:10:04,760 --> 00:10:06,550
!اصمت

111
00:10:09,710 --> 00:10:13,600
!إيس! لم أعلم أنّك تقطع كلّ هذه المسافة كلّ يوم

112
00:10:13,600 --> 00:10:14,730
!اخرس

113
00:10:15,200 --> 00:10:18,560
أهذا هو لوفي الّذي كنت تتحدّث عنه؟

114
00:10:18,560 --> 00:10:21,190
!هل أخبرته عنّي؟

115
00:10:21,190 --> 00:10:23,740
.أخبرته كم أنت مزعج

116
00:10:23,740 --> 00:10:27,690
.أخبرني أيضًا أنّك غبيّ

117
00:10:28,370 --> 00:10:29,330
حقًّا؟

118
00:10:29,600 --> 00:10:32,620
لا تدرك أنّنا نقلّل من شأنك، أليس كذلك؟

119
00:10:32,620 --> 00:10:38,420
لحق بي إلى هنا أخيرًا مع أنّني لم أسلك
.أيّ طرق يمكن السّير عليها

120
00:10:38,420 --> 00:10:42,880
!هل أنت صديق إيس يا هذا؟ كن صديقي أيضًا يا هذا

121
00:10:42,880 --> 00:10:46,510
!"اخرس! وكفّ عن مناداتي "يا هذا

122
00:10:46,510 --> 00:10:48,390
ما اسمك إذًا؟

123
00:10:48,390 --> 00:10:49,140
...سا

124
00:10:49,140 --> 00:10:50,850
!لن أخبرك

125
00:10:50,850 --> 00:10:54,240
!لهذا أخبرتك أن تعيش هنا معي

126
00:10:54,240 --> 00:10:58,650
!اتّضح أنّ الرّحلة والتّدريب من وإلى الجبل فكرة سيّئة

127
00:10:58,650 --> 00:11:00,150
ما العمل؟

128
00:11:01,360 --> 00:11:06,480
.اكتشف سرّنا. سيخبر أحدًا ما لم نفعل شيئًا

129
00:11:13,200 --> 00:11:14,200
.علينا قتله

130
00:11:14,200 --> 00:11:16,120
.حسنًا، لنفعل ذلك

131
00:11:18,080 --> 00:11:20,290
!ماذا؟

132
00:11:20,960 --> 00:11:26,760
!لا تقتلاني! النّجدة! لا أريد الموت

133
00:11:26,760 --> 00:11:28,720
!اخرس أيّها الأحمق

134
00:11:29,110 --> 00:11:31,100
!سابو، اقتله بسرعة

135
00:11:31,100 --> 00:11:33,100
!ماذا؟! افعل ذلك أنت

136
00:11:33,100 --> 00:11:35,740
!لم أقتل أيّ أحد من قبل

137
00:11:35,740 --> 00:11:38,350
!ولا أنا! ولا أعرف كيف

138
00:11:38,730 --> 00:11:41,320
!لا ترمياني في الماء

139
00:11:41,320 --> 00:11:42,970
!حسنًا، لنذهب إلى النّهر

140
00:11:43,020 --> 00:11:45,230
لِمَ أخبرنا بذلك؟

141
00:11:45,230 --> 00:11:46,240
!إنّه غبيّ

142
00:11:46,240 --> 00:11:48,780
!النّجدة

143
00:11:48,780 --> 00:11:50,370
!اخرس

144
00:11:52,650 --> 00:11:54,830
!لا أريد أن أموت

145
00:11:55,430 --> 00:11:57,580
!أسمع صوتًا من الغابة

146
00:11:57,580 --> 00:11:58,750
!صوت صبيّ

147
00:11:58,750 --> 00:12:01,200
!لا! أحدهم قادم

148
00:12:01,200 --> 00:12:03,210
!حرّره في الوقت الرّاهن

149
00:12:03,210 --> 00:12:06,090
!علينا أن نتحرّك من هنا وإلاّ وجدوا كنزنا

150
00:12:08,960 --> 00:12:12,470
.الجميع يعرفون ذلكما الصبيّين هنا. إيس وسابو

151
00:12:13,560 --> 00:12:18,230
هل أنت واثق أنّ إيس من أخذ المال؟

152
00:12:18,230 --> 00:12:22,350
.أجل. نحن آسفون. لا يجب أن نهمل دفاعنا

153
00:12:22,860 --> 00:12:27,900
!كم ذلك الصّبيّ شائن! لا يمكنه سرقة مالنا ببساطة

154
00:12:28,630 --> 00:12:33,530
!إن اكتشف القبطان بلوجام بشأن هذا، سيقتلنا جميعًا

155
00:12:35,200 --> 00:12:40,100
سحقًا! لم أعلم أنّ أولئك البطلجيّون
!يعملون لصالح بلوجام

156
00:12:40,100 --> 00:12:43,000
أتقصد أنّك سرقت المال منهم؟

157
00:12:43,800 --> 00:12:46,500
...ما كان يجب أن آخذ ذلك المال

158
00:12:46,500 --> 00:12:50,550
.لديه سيف حقيقيّ
.ذلك بورشيمي الّذي يعمل لصالح بلوجام

159
00:12:51,360 --> 00:12:54,300
إنّه مجنون. هل علمت ذلك؟

160
00:12:55,440 --> 00:13:00,230
يقوم بسلخ فروة رأسك وأنت حيّ
!بعد أن تخسر نزالاً معه

161
00:13:03,900 --> 00:13:06,290
...لندعهم يمرّون فقط الآن

162
00:13:07,800 --> 00:13:09,240
ماذا؟ أين هو؟

163
00:13:11,990 --> 00:13:13,820
اتركني! ماذا تريد منّي؟

164
00:13:13,820 --> 00:13:16,080
كيف تركتهم يمسكون بك؟

165
00:13:16,080 --> 00:13:19,290
!دعني! أيّها الوغد

166
00:13:21,870 --> 00:13:23,620
من هذا الصّغير الحقير؟

167
00:13:23,620 --> 00:13:27,290
!النّجدة! إيس

168
00:13:27,960 --> 00:13:29,760
!ساعدني يا إيس

169
00:13:30,360 --> 00:13:34,010
!ذلك الأحمق! إنّه ينادي باسمي

170
00:13:30,360 --> 00:13:34,010
!النّجدة! إيس

171
00:13:49,800 --> 00:13:52,110
هل قلت "إيس" للتّوّ؟

172
00:13:53,030 --> 00:13:54,240
!وماذا إذًا؟

173
00:13:54,240 --> 00:13:56,910
هل تعرف إيس؟

174
00:13:58,370 --> 00:13:59,950
!أنا صديقه

175
00:14:00,640 --> 00:14:03,210
.لكنّه حاول قتلي للتّوّ

176
00:14:04,870 --> 00:14:07,750
!ذلك الأحمق! إنّه ثرثار

177
00:14:08,460 --> 00:14:15,470
لا أدري إن كنت تعرف هذا ولكنّ إيس
.سرق بعض المال منّا وهرب اليوم

178
00:14:15,470 --> 00:14:18,720
لا تعرف أين هو، أليس كذلك؟

179
00:14:23,170 --> 00:14:26,350
!لا! سيأخذون كلّ مالنا

180
00:14:26,350 --> 00:14:28,690
!آمل ألاّ يخبرهم ذلك الأحمق

181
00:14:36,240 --> 00:14:38,830
إذًا؟ ما قولك؟

182
00:14:42,240 --> 00:14:44,460
!ماذا؟

183
00:14:44,460 --> 00:14:47,350
...لـ-لا أدري

184
00:14:48,360 --> 00:14:49,960
!أنت فظيع في الكذب

185
00:14:58,250 --> 00:15:02,140
.حسنًا، حسنًا! ما باليد حيلة لأنّك لا تعرف

186
00:15:05,480 --> 00:15:08,900
!لا تقلق، سأساعدك على استعادة ذاكرتك

187
00:15:10,150 --> 00:15:13,190
!ماذا تفعل؟! اتركني! إلى أين تأخذني؟

188
00:15:13,190 --> 00:15:15,900
!سحقًا! غبيّ! اتركني

189
00:15:15,900 --> 00:15:19,370
!أيّها الوغد! دعني! ماذا تفعل أيّها الوغد؟

190
00:15:21,280 --> 00:15:22,660
!ما العمل؟

191
00:15:22,660 --> 00:15:25,340
...تعلم ما علينا فعله

192
00:15:33,670 --> 00:15:35,510
!دعني

193
00:15:35,510 --> 00:15:38,040
!لن أخبرك بأيّ شيء

194
00:15:45,720 --> 00:15:47,690
!أيّها الحقير الصّغير

195
00:16:01,920 --> 00:16:05,410
أخبرتك أنّ جسدي تحوّل إلى مطّاط
!بعدما أكلتُ فاكهة المطّاط

196
00:16:05,410 --> 00:16:07,290
!اخرس

197
00:16:08,570 --> 00:16:11,460
فاكهة الشّيطان إذًا؟

198
00:16:12,210 --> 00:16:14,230
.يبدو أنّ هذا حقيقيّ

199
00:16:16,760 --> 00:16:19,330
.اجلبوا لي قفّازين

200
00:16:19,330 --> 00:16:20,680
!حـ-حاضر

201
00:16:20,680 --> 00:16:24,300
!بسرعة، بسرعة! نحن هالكان إن عادوا

202
00:16:24,510 --> 00:16:27,240
!علينا أن ننقل كنزلنا إلى مكان آخر

203
00:16:28,060 --> 00:16:31,270
!إنّها مسألة وقت إلى أن يخبرهم لوفي

204
00:16:31,270 --> 00:16:34,650
لن يأخذوا ما سرقنا منهم فحسب

205
00:16:34,650 --> 00:16:38,860
بل وحتّى "مدّخرات القراصنة" الّتي
!أمضينا خمس سنوات في جمعها

206
00:16:44,450 --> 00:16:46,450
.اسمع أيّها الحقير الصّغير

207
00:16:46,450 --> 00:16:52,040
المال الّذي سرقه صديقك إيس مهمّ جدًّا
.من أجل طاقم قراصنتنا

208
00:16:52,850 --> 00:16:55,340
.وأنت تعرف أين هو

209
00:16:55,340 --> 00:16:57,960
.لذا أحتاج منك أن تخبرنا

210
00:16:59,510 --> 00:17:00,640
!لا

211
00:17:08,100 --> 00:17:09,730
!أفلح الأمر

212
00:17:13,940 --> 00:17:16,860
!لا تريد إغضاب قرصان

213
00:17:17,400 --> 00:17:21,990
!قبطاننا بلوجام قاسٍ حقًّا

214
00:17:29,580 --> 00:17:32,080
!هذا مؤلم! أنا خائف

215
00:17:32,080 --> 00:17:33,710
!النّجدة

216
00:17:36,710 --> 00:17:41,510
!أنتم، اذهبوا وابحثوا عن إيس وسابو
!لا نملك الوقت للوقوف

217
00:17:41,510 --> 00:17:42,920
!حـ-حاضر

218
00:17:51,000 --> 00:17:53,980
تسألانني إن كنت أعرف إيس وسابو؟

219
00:17:54,360 --> 00:17:57,040
.لا بدّ أنّكما مشاغبان من المدينة

220
00:17:57,880 --> 00:18:00,690
.لا أنصحكما بالعبث مع ذلكما الاثنين

221
00:18:01,740 --> 00:18:04,450
.إنّهما صبيّان لكن لا يجب أن تستخفّا بهما

222
00:18:04,450 --> 00:18:07,240
.إنّهما ككلبين مسعورين سيقتلان حتّى نمرًا

223
00:18:07,240 --> 00:18:10,560
.إيس وسابو؟ لم أرهما منذ مدّة

224
00:18:11,310 --> 00:18:16,360
على أيّ حال أيّها الشابّان، لِمَ لا تتركان
كلّ ما هو قيّم معكما هنا؟

225
00:18:16,360 --> 00:18:18,300
!بـ-بربّك يا صاح

226
00:18:18,300 --> 00:18:20,280
!سنسأل أحدًا آخر

227
00:18:20,840 --> 00:18:25,130
ما زالوا لا يعلمون أين نحن؟

228
00:18:25,560 --> 00:18:27,770
...ظننت أنّهم سيكونون قد عرفوا الآن

229
00:18:29,410 --> 00:18:30,720
!كلاّ

230
00:18:33,380 --> 00:18:35,270
.لم أدرك أنّ اللّيل وشيك

231
00:18:36,080 --> 00:18:37,980
!أجل! انتهيت

232
00:18:37,980 --> 00:18:40,320
!نقلنا كلّ الكنز

233
00:18:46,450 --> 00:18:49,490
ما بال ذلك الصّبيّ؟

234
00:18:53,370 --> 00:18:55,120
!يا إيس

235
00:18:55,120 --> 00:18:59,000
سابو! ما الخطب؟ هل أتوا للبحث عن المال؟

236
00:19:01,710 --> 00:19:04,210
!كلاّ، لم يأتوا

237
00:19:04,210 --> 00:19:07,090
!وأراهن أنّهم لن يأتوا

238
00:19:07,090 --> 00:19:08,360
ماذا تقصد؟

239
00:19:08,360 --> 00:19:10,260
...ذلك الفتى، لوفي

240
00:19:11,310 --> 00:19:13,600
!لم يخبرهم بأيّ شيء

241
00:19:15,180 --> 00:19:18,230
!أنا واثق أنّهم يعذّبونه

242
00:19:18,230 --> 00:19:22,440
!ظننت أنّه سيخبرهم بما أنّه مغفّل وبكّاء

243
00:19:22,440 --> 00:19:24,150
!هذا غير منطقيّ

244
00:19:25,740 --> 00:19:27,720
...إلّم نفعل شيئًا، سوف

245
00:19:36,460 --> 00:19:39,170
!تأخّر الوقت

246
00:19:39,580 --> 00:19:41,790
من المسؤول اليوم؟

247
00:19:42,540 --> 00:19:45,840
.بورشيمي أيّها القبطان بلوجام

248
00:19:46,640 --> 00:19:48,800
.أوشك المغيب

249
00:19:52,550 --> 00:19:56,210
.أنا واثق أنّهما صرفا الكنز بالفعل الآن

250
00:19:56,850 --> 00:20:00,190
.ربّما يهرب بالمال

251
00:20:01,240 --> 00:20:06,490
مستحيل! لا أظنّ أنّه سيخاطر
!بأن يُقتل ليحاول فعل شيء كهذا

252
00:20:08,160 --> 00:20:09,950
!لا أظنّ ذلك أيضًا

253
00:20:17,800 --> 00:20:20,790
!أخبرنا بسرعة

254
00:20:24,040 --> 00:20:29,340
!بـ-بـ-بورشيمي-سان
!لا فائدة من فعل ذلك بعد الآن

255
00:20:31,840 --> 00:20:35,100
!ما عاد يملك الطّاقة حتّى ليصرخ الآن

256
00:20:39,730 --> 00:20:45,600
،أراهن أنّه لن يقول أيّ شيء وللأمانة
!لا أطيق مشاهدة هذا... هذا قاسٍ بحقّ

257
00:20:45,600 --> 00:20:48,320
!أظهر بعض الرّأفة

258
00:20:50,740 --> 00:20:54,780
ابحث عن إيس وسابو إن كنت تملك
!الوقت للدّفاع عن الصّبيّ

259
00:20:55,320 --> 00:20:59,160
!حياتنا نحن المهدّدة! ألا ترى؟

260
00:20:59,540 --> 00:21:04,790
!تأخّرنا بالفعل لإعطاء ذلك المال للقبطان بلوجام

261
00:21:09,510 --> 00:21:13,520
كيف أمكنهم فعل ذلك لصبيّ صغير؟
أيجب أن نستدعي رئيس شرطة المدينة؟

262
00:21:14,060 --> 00:21:17,850
.لا فائدة. هذه المنطقة ليست مشملة بقانون البلاد

263
00:21:17,850 --> 00:21:22,080
.كما أنّه عضو في طاقم بلوجام

264
00:21:22,080 --> 00:21:24,400
.وهم يدفعون مالاً للنّبلاء

265
00:21:24,400 --> 00:21:29,400
.سيغفلون عن أيّ جرائم أو قتل مرتكبة في هذه البلاد

266
00:21:30,110 --> 00:21:34,870
.لن تصرف جثّة أخرى انتباه أيّ أحد هنا

267
00:21:36,030 --> 00:21:38,080
!أجبني

268
00:21:39,340 --> 00:21:40,700
.لن أخبرك

269
00:21:41,730 --> 00:21:46,420
!أيّها الحقير الصّغير
!كفّ عن محاولة صون سرّ كالكبار

270
00:21:50,210 --> 00:21:52,720
!أخبرني

271
00:21:55,260 --> 00:22:01,310
!لن أخبرك

272
00:22:05,010 --> 00:22:06,810
!لن أخبرك

273
00:22:16,800 --> 00:22:18,700
.حسنًا. يكفي

274
00:22:37,610 --> 00:22:39,010
.فلتمت إذًا

275
00:23:00,080 --> 00:23:02,990
!توقّف

276
00:23:11,510 --> 00:23:16,590
.أغار إيس وسابو على مخبأ بورشيمي لإنقاذ لوفي الأسير

277
00:23:16,590 --> 00:23:18,890
،على الرّغم من قوّة القراصنة الكاسحة

278
00:23:18,890 --> 00:23:22,890
،يجد سابو فرصة لإنقاذ لوفي ويحاول من أجل ذلك

279
00:23:22,890 --> 00:23:26,440
...في حين يفصح إيس عن قرار مفاجئ

280
00:23:26,440 --> 00:23:27,920
:في الحلقة القادمة من وان بيس

281
00:23:27,920 --> 00:23:31,190
"!لن أهرب! عمليّة إنقاذ إيس اليائسة"

282
00:23:31,190 --> 00:23:33,840
!ملك القراصنة، لن يكون إلاّ أنا

283
00:23:36,030 --> 00:23:41,030
!!نلقاكم في الحلقة القادمة