198
00:13:54,910 --> 00:14:00,150
تمكّنتُ من التقدّم للأمام بفضل
كلّ الأشخاص الذين ساندوني

199
00:14:01,210 --> 00:14:02,510
...ثمّ، أتى ذاك اليوم

200
00:14:10,830 --> 00:14:12,690
كنتُ بغاية السعادة

201
00:14:13,240 --> 00:14:15,610
شعرتُ أنّي نجحت أخيراً

202
00:14:16,800 --> 00:14:18,270
...نجحتِ

203
00:14:18,810 --> 00:14:19,590
...ثمّ

204
00:14:20,580 --> 00:14:24,400
...شعرتُ بالرضا من تحقيق حلمي، أو ذلك ما ظننته

205
00:14:24,710 --> 00:14:27,670
لكنّي أشعر بشيء يتأجّج داخلي

206
00:14:28,010 --> 00:14:30,750
شعور متأجّج؟

207
00:14:30,750 --> 00:14:31,680
أجل

208
00:14:32,360 --> 00:14:33,690
أرغب بمواصلة الركض

209
00:14:37,180 --> 00:14:38,560
...أدركت

210
00:14:39,190 --> 00:14:44,720
أنّي لم أصبح فتاة خيل
رائعة وقويّة مثل الرئيسة بعد

211
00:14:46,320 --> 00:14:52,100
لم أستطع أن أصبح فائزة بالتاج الثلاثيّ
بلا هزائم، فتخلّيتُ عن ذاك الحلم

212
00:14:53,160 --> 00:14:57,940
لكن في أعماقي، كانت لا تزال هناك شعلة

213
00:15:00,940 --> 00:15:04,650
لذا قرّرتُ السعي نحو دوري جائزة الأحلام

214
00:15:05,090 --> 00:15:10,520
فأنا لا أزال أريد أن أصبح الإمبراطورة
التي تتجاوز الفائتة

215
00:15:11,220 --> 00:15:15,590
ومهما حصل... سيدفعني ذاك الشعور لمواصلة الركض

216
00:15:19,600 --> 00:15:20,640
حسنٌ

217
00:15:21,480 --> 00:15:26,940
،لن أسألكِ ما الذي يقلقكِ الآن يا كيتا-تشان
لكنّي أعتقد أنّكِ ستكونين بخير

218
00:15:28,080 --> 00:15:32,450
فأنا متأكّدة أنّ لديكِ شيئاً مثله
لن يزول أبداً

219
00:15:33,740 --> 00:15:35,050
...تيو-سان

220
00:15:52,420 --> 00:15:54,270
...شيء لن يزول

221
00:15:54,270 --> 00:15:57,710
واحد، اثنان، ثلاثة، أربعة

222
00:15:57,710 --> 00:16:01,560
اثنان، اثنان، ثلاثة، أربعة

223
00:16:01,560 --> 00:16:04,680
واحد، اثنان، ثلاثة، أربعة

224
00:16:04,680 --> 00:16:07,770
اثنان، اثنان، ثلاثة، أربعة

225
00:16:05,500 --> 00:16:07,770
حسناً، الركض تالياً

226
00:16:07,770 --> 00:16:08,820
!أمرك

227
00:16:09,540 --> 00:16:13,920
...شيء كان موجوداً منذ البداية
ولا أستطيع التخلّي عنه

228
00:16:17,120 --> 00:16:18,950
...أداء أبي

229
00:16:23,580 --> 00:16:29,130
كان الجميع مُبتسمون، في ذاك المكان دافئ الجوّ

230
00:16:32,130 --> 00:16:33,890
سباقات تيو-سان

231
00:16:34,420 --> 00:16:38,700
حماس الجماهير الذي جعل الجوّ مشحوناً

232
00:16:38,700 --> 00:16:41,240
كان مشتعلاً وحيويّاً

233
00:16:42,710 --> 00:16:47,390
ومتلألئاً ولامعاً جدّاً بحيث أشعرني بالدوار

234
00:16:49,460 --> 00:16:51,990
ذلك أوّل يخطر في بالي

235
00:16:52,230 --> 00:16:57,990
المشاهد والأصوات... أتذكّرها جميعاً
لحدٍّ يؤلم صدري

236
00:16:58,620 --> 00:17:03,000
أعرف أنّ ذلك مُستحيل، لكن لا تزال تلمع بشدّة

237
00:17:03,610 --> 00:17:04,410
...مع ذلك

238
00:17:04,410 --> 00:17:07,000
!لدينا تخفيضات

239
00:17:07,000 --> 00:17:10,000
!ولوقت محدود فحسب، إنّها أفضل

240
00:17:10,000 --> 00:17:15,310
!خذوا شيئاً! أنا أوصي بموز اليوم تحديداً

241
00:17:15,310 --> 00:17:17,720
!سأجعله أفضل أداءٍ ممكن

242
00:17:17,720 --> 00:17:20,350
!سأحرص على جعله جديراً بالذكرى

243
00:17:21,530 --> 00:17:24,570
!تعالوا وخذوا موزاً

244
00:17:24,570 --> 00:17:26,350
!مرحباً بكم

245
00:17:26,350 --> 00:17:27,960
مرحباً

246
00:17:27,960 --> 00:17:29,730
كيتا-تشان، مرحباً بكِ

247
00:17:29,730 --> 00:17:32,950
الجوّ باردٌ اليوم، صحيح؟ أسترتك الرياضيّة
دافئة بما يكفي؟

248
00:17:32,950 --> 00:17:34,740
حسناً، كنت أركض

249
00:17:34,740 --> 00:17:39,070
!فهمت، أنتِ في خضم ركضكِ الآن؟ إنّكِ تعملين جاهدة

250
00:17:39,070 --> 00:17:40,490
...لـ-لا

251
00:17:41,580 --> 00:17:44,560
—المعذرة، بخصوص أريما

252
00:17:44,560 --> 00:17:47,820
!صحيح، لديّ شيءٌ رائع لكِ يا كيتا-تشان

253
00:17:48,970 --> 00:17:50,220
انتظريني قليلاً

254
00:17:50,630 --> 00:17:53,610
عزيزتي، أين ذاك الشيء الذي وضعناه جانباً؟

255
00:17:53,610 --> 00:17:56,170
أيّ شيءٍ تقصد؟

256
00:17:56,170 --> 00:17:58,830
!تعرفين، ذاك الشيء! لأجل كيتا-تشان

257
00:17:58,830 --> 00:18:01,700
!أنت هكذا دوماً يا عزيزي

258
00:18:02,530 --> 00:18:05,510
كيف أعرف ما الشيء الذي تقصده
دون أن تحدّده؟

259
00:18:04,330 --> 00:18:06,650
...تعرفين، ذاك الشيء الذي

260
00:18:09,400 --> 00:18:14,000
!مرحباً بكم! لدينا الكثير من القطع الطازجة

261
00:18:14,000 --> 00:18:15,670
تفضّلي

262
00:18:15,670 --> 00:18:17,620
لديّ جزرٌ ممتاز

263
00:18:17,620 --> 00:18:18,910
!خذيه معكِ

264
00:18:19,390 --> 00:18:21,290
أ-أأنت متأكّد؟

265
00:18:21,290 --> 00:18:25,840
بالطبع، خذيه معكِ وكلي ملء معدتكِ الليلة

266
00:18:25,840 --> 00:18:26,910
...في تلك الحالة

267
00:18:27,210 --> 00:18:29,830
خذي هذه الطماطم معكِ أيضاً يا كيتا-تشان

268
00:18:29,830 --> 00:18:31,340
!إنّها حلوة ولذيذة

269
00:18:31,340 --> 00:18:32,970
!لا-لا أستطيع فعل ذلك

270
00:18:32,970 --> 00:18:37,160
ليست مشكلة، هذا أقلّ ما يمكننا فعله لكِ

271
00:18:38,170 --> 00:18:42,180
أنتِ نجمة السوق العزيزة

272
00:18:43,590 --> 00:18:44,930
...نجمة

273
00:18:51,260 --> 00:18:52,980
!فكرة حسنة

274
00:18:52,980 --> 00:18:55,980
في تلك الحالة، خذي سمكاً أيضاً

275
00:18:55,980 --> 00:18:58,090
!جرّبي منتجي الجديد يا كيتا-تشان

276
00:18:58,090 --> 00:18:59,500
تحبّين العسل، صحيح؟

277
00:18:59,500 --> 00:19:01,490
في تلك الحالة، لدي كعك مبخّر

278
00:19:01,490 --> 00:19:03,430
!خذي لحماً أيضاً

279
00:19:03,430 --> 00:19:05,260
أتريدين تفّاحاً؟

280
00:19:05,260 --> 00:19:07,210
خذي حلويّات مخبوزة أيضاً

281
00:19:07,210 --> 00:19:10,000
هاكِ، جلبتُ لكِ سمكاً طازجاً من الأفضل

282
00:19:10,000 --> 00:19:12,250
!لا يمكنها أخذ كلّ هذا

283
00:19:12,250 --> 00:19:15,500
في تلك الحالة، خذي واحدة من سلالي

284
00:19:20,250 --> 00:19:22,880
...أ-أنا... هذا

285
00:19:22,880 --> 00:19:25,260
هذا كلّ ما نستطيع فعله

286
00:19:25,260 --> 00:19:27,120
لكن فلتعرفي أنّنا نشجّعكِ

287
00:19:27,120 --> 00:19:31,320
أجل، كان أريما كينين رائعاً

288
00:19:31,320 --> 00:19:33,900
!بُحّ صوتي مع انتهائه

289
00:19:33,900 --> 00:19:36,190
كان مذهلاً بحقّ

290
00:19:36,190 --> 00:19:38,980
أشعر برقرقة الدموع كلّما أتذكّر المعركة

291
00:19:38,980 --> 00:19:41,400
!قبل عبوركِ لخطّ النهاية

292
00:19:47,910 --> 00:19:51,740
...مكان دافئ مليء بالابتسامات

293
00:19:52,730 --> 00:19:55,790
مكان ينعم بالشغف والحيويّة

294
00:19:55,790 --> 00:20:01,850
ومتلألئ ومشتعل ولامع
لحدّ يشعرك بالدوران

295
00:20:04,610 --> 00:20:08,500
...حلمي الأوّل

296
00:20:11,220 --> 00:20:14,370
ظننتُ أنّي ألقيته جانباً

297
00:20:16,220 --> 00:20:18,970
...ظننتُني استسلمت

298
00:20:25,280 --> 00:20:28,550
كيتا-تشان؟ ما الخطب؟ أتشعرين بتوعّك؟

299
00:20:28,550 --> 00:20:31,080
لا، ليس كذلك

300
00:20:31,080 --> 00:20:33,720
...أنا... أنا

301
00:20:35,480 --> 00:20:39,670
!شكراً جزيلاً لكم

302
00:20:38,780 --> 00:20:39,670
!لحظة

303
00:20:40,800 --> 00:20:41,920
!كيتا-تشان

304
00:20:42,710 --> 00:20:44,540
!كيتا-تشان؟

305
00:20:46,590 --> 00:20:49,590
أين ذهبت كيتا-تشان؟

306
00:20:51,800 --> 00:20:52,680
!رجعت

307
00:20:52,680 --> 00:20:54,460
مرحباً بعودتكِ يا كيتا-تشان

308
00:20:54,460 --> 00:20:56,690
ما قصّة هذه الأشياء؟

309
00:20:56,690 --> 00:20:58,440
!سأغادر

310
00:21:03,420 --> 00:21:07,850
!نظيفة ومنتعشة

311
00:21:18,140 --> 00:21:19,750
ابذلي جهدكِ يا كيتا-تشان

312
00:21:21,420 --> 00:21:24,560
أنا أحبّ ابتسام الجميع

313
00:21:26,300 --> 00:21:30,390
أحبّ الأماكن مثل المهرجان
التي تمتلئ بالابتسامات

314
00:21:30,920 --> 00:21:34,520
...المشهد الذي صنعته تيو-سان ذاك اليوم

315
00:21:34,520 --> 00:21:37,820
لا أستطيع مقاومة حبّي له

316
00:21:38,570 --> 00:21:42,480
،لم أستطع أن أصبح مثل تيو-سان
لا أستطيع اللمعان

317
00:21:42,880 --> 00:21:47,440
لستُ موهوبة... لذا استسلمت

318
00:21:48,700 --> 00:21:52,850
،لوقتٍ طويل، لم تئل الأمور لما أردت

319
00:21:52,850 --> 00:21:55,010
وسيستمرّ ذلك بالتأكيد

320
00:21:55,660 --> 00:22:00,400
...لا أستطيع أن أصبح نابغة، لا أستطيع أن أصبحة نجمة

321
00:22:00,930 --> 00:22:03,800
أعرف ذلك

322
00:22:04,330 --> 00:22:07,070
!لكن مع ذلك، لا أريد الاستسلام

323
00:22:07,810 --> 00:22:11,430
!أريد ملاحقته من جديد! أريد إكمال حلمي من حيث توقّف

324
00:22:11,720 --> 00:22:14,930
!أريد صنع مشهدٍ كذاك

325
00:22:15,550 --> 00:22:17,140
!وسأفعل