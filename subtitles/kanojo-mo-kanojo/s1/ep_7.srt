.وميليكا-سان

213
00:16:29,800 --> 00:16:34,160
.مرحبا يا ناويا

214
00:16:34,160 --> 00:16:35,470
.تصرفاتها واضحة

215
00:16:35,890 --> 00:16:38,090
.على أية حال، تعال رفقتي يا ناويا

216
00:16:38,090 --> 00:16:39,840
.عليّ التحدث إليك

217
00:16:39,840 --> 00:16:41,130
بخصوص ماذا؟

218
00:16:41,130 --> 00:16:42,890
.لن أسمح لك بالتحدث إليه بمفردك

219
00:16:42,890 --> 00:16:45,400
.هذا لا يخصك

220
00:16:45,400 --> 00:16:46,900
!بلى يخصني

221
00:16:46,900 --> 00:16:48,420
ساكي ساكي؟

222
00:16:50,390 --> 00:16:52,180
.لا بأس يا ساكي-تشان

223
00:16:54,450 --> 00:16:56,870
.فلنتحدّث كما ينبغي يا ريكا-سان

224
00:16:57,440 --> 00:16:59,160
.أجل

225
00:17:01,200 --> 00:17:02,730
...ناويا

226
00:17:04,280 --> 00:17:06,090
!إنه رفقة هوشيزاكي-سان

227
00:17:06,090 --> 00:17:07,710
ما قصته؟

228
00:17:08,210 --> 00:17:11,670
."ناداني "ريكا

229
00:17:15,900 --> 00:17:19,640
.أولا، أنا آسف بخصوص كل شيء

230
00:17:20,800 --> 00:17:22,850
بخصوص ماذا؟

231
00:17:23,150 --> 00:17:26,410
.عرضت عليّ بأن تكوني خليلتي

232
00:17:26,410 --> 00:17:28,940
.وأنا، وغد في علاقة مزدوجة، رفضت طلبك

233
00:17:29,360 --> 00:17:31,780
.قمت بإذلالك

234
00:17:32,610 --> 00:17:33,720
...لذا

235
00:17:42,000 --> 00:17:45,830
.يمكنك الانتقام مني عن طريق التقاط صور محرجة لي

236
00:17:46,190 --> 00:17:49,120
.ونشرها على الانترنت

237
00:17:49,120 --> 00:17:50,330
...انتظر

238
00:17:50,330 --> 00:17:51,580
.سأرتدي ملابس فتاة حتى

239
00:17:51,580 --> 00:17:53,110
أم يجدر بي أن أتعرى؟

240
00:17:55,120 --> 00:17:57,580
ما-ما هذا؟

241
00:17:59,150 --> 00:18:03,350
!كيف يعقل ان يكون مراعيا ورائعا هكذا؟

242
00:18:04,680 --> 00:18:07,350
.لم تفعلي أيّ سوء يا ميليكا-سان

243
00:18:07,350 --> 00:18:09,980
!لا تلمسني

244
00:18:10,430 --> 00:18:12,410
!وجهي احمرّ كثيرا

245
00:18:13,230 --> 00:18:14,730
.أنت ظريفة للغاية

246
00:18:14,730 --> 00:18:16,860
!وفيديوهاتك رائعة للغاية ولديك صدر هائل

247
00:18:17,130 --> 00:18:18,940
!توقّف

248
00:18:23,200 --> 00:18:28,370
!كل ما في الأمر أنه لديّ خليلتان غاليتان على قلبي

249
00:18:32,880 --> 00:18:36,430
!لديه عزيمة قويّة

250
00:18:36,840 --> 00:18:40,470
.إن أردت صديقا حميما فسأساعدك في العثور على شخص جيّد

251
00:18:40,810 --> 00:18:42,440
.سأعوضك عن ذلك

252
00:18:42,440 --> 00:18:45,100
.لذا أرجو أن تتوقفي عن محاولة جعلي أقع في حبك

253
00:18:45,780 --> 00:18:48,420
.أنت جذابة للغاية

254
00:18:51,350 --> 00:18:56,360
!لهذا السبب لا يمكنني أن أقع في حبك وأصبح في علاقة ثلاثية

255
00:18:59,420 --> 00:19:02,500
!إنه يرمي بتلميحات كثيرة

256
00:19:07,120 --> 00:19:13,170
أهذا كل ما ترغب في إخباري به يا ناويا؟

257
00:19:13,170 --> 00:19:13,930
.أجل

258
00:19:15,360 --> 00:19:17,510
...إذا

259
00:19:18,580 --> 00:19:22,010
.حان دورك لتستمع إليّ

260
00:19:24,220 --> 00:19:30,040
تتذكّر كيف كان والدي يرغب في حذف حسابي، صحيح؟

261
00:19:30,660 --> 00:19:32,020
...أعني

262
00:19:32,820 --> 00:19:35,400
...كيف أقول هذا

263
00:19:36,850 --> 00:19:41,380
.شكرا لك على إنقاذي من والدي

264
00:19:53,040 --> 00:19:54,540
هذا كل شيء؟

265
00:19:55,700 --> 00:19:57,190
...لم تكن مضطرا لذلك

266
00:19:57,190 --> 00:19:58,300
!ما-ماذا؟

267
00:19:59,540 --> 00:20:03,050
!كان ذلك أمرا مهما للغاية بالنسبة لي

268
00:20:03,560 --> 00:20:10,930
لا يتوقّف والدي عن توبيخي بخصوص عدم وجود
.خيارات كثيرة بدل الدراسة

269
00:20:05,430 --> 00:20:07,000
!ما الذي تعتقدين أنك تفعلينه؟

270
00:20:07,000 --> 00:20:08,880
!هذه العلامات غير مقبولة

271
00:20:08,880 --> 00:20:10,930
!احصلي على 40 بالمئة! 40 بالمئة

272
00:20:11,860 --> 00:20:17,190
،لكني لا أريد أن أقوم بشيءٍ لا أرغب فيه

273
00:20:17,190 --> 00:20:19,270
.حتى وإن كان ذلك من أجل مستقبلي

274
00:20:21,700 --> 00:20:27,690
لكني كنت أعرف أنّني لا أملك أيّ شيء
.لذلك أردت فعل ما أستطيعه

275
00:20:27,690 --> 00:20:30,410
.بدأت في صنع الفيديوهات لكي أحظى بالاستقلالية

276
00:20:32,360 --> 00:20:34,970
لم يكن ذلك لتبرزي صدرك الهائل؟

277
00:20:35,640 --> 00:20:37,080
!طبعا لا

278
00:20:39,360 --> 00:20:40,390
...على أية حال

279
00:20:41,350 --> 00:20:46,500
.قناة الميتيوب خاصتي بدأت تظهر النتائج أخيرا

280
00:20:49,240 --> 00:20:52,030
.صحيح أنني أستخدم صدري لجلب الناس

281
00:20:52,030 --> 00:20:53,560
.ولديّ العديد من الكارهين

282
00:20:53,950 --> 00:20:56,100
لكني أعمل بجدّ على أفكاري

283
00:20:56,100 --> 00:20:58,560
.ولأجعلها قناة جيدة

284
00:20:58,990 --> 00:21:01,070
.بذلت جهدا كبيرا فيها

285
00:21:01,470 --> 00:21:03,910
.وكانت مهمة جدا بالنسبة لي

286
00:21:05,040 --> 00:21:09,780
وقمت أنت بحمايتها بالرغم من أنك لن تنال
.أيّ شيء مقابل ذلك

287
00:21:11,950 --> 00:21:13,450
...أنا حقا

288
00:21:13,880 --> 00:21:15,460
...حقا

289
00:21:16,100 --> 00:21:19,430
!أقدر لك ذلك

290
00:21:24,390 --> 00:21:25,970
.فهمت

291
00:21:26,640 --> 00:21:28,020
،لكن في تلك الحالة

292
00:21:29,260 --> 00:21:32,970
.أنا سعيد لأنني تمكنت من إنقاذها

293
00:21:44,100 --> 00:21:47,600
!توقّف عن ذلك

294
00:21:53,530 --> 00:21:55,110
...ميليكا-سان

295
00:21:56,560 --> 00:21:59,080
...لم أنتهِ بعد

296
00:22:12,160 --> 00:22:14,900
...نا... نا

297
00:22:17,340 --> 00:22:18,830
...ناويا

298
00:22:18,830 --> 00:22:20,490
.أحبك كثيرا

299
00:22:33,880 --> 00:22:37,540
!أيتها العاهرة ذات الصدر الهائل

300
00:22:37,960 --> 00:22:40,920
هل ناويا-كن بخير؟

301
00:24:12,470 --> 00:24:13,630
!خيارا خليلة

302
00:24:13,630 --> 00:24:14,990
هل تحب زيّ فتاة الأرنب أم الخادمة؟

303
00:24:14,990 --> 00:24:16,350
أيهما تحبّ أكثر؟

304
00:24:16,350 --> 00:24:17,600
...حسنا

305
00:24:17,600 --> 00:24:20,020
،زيّ فتاة الأرنب مكشوف وجذاب

306
00:24:20,020 --> 00:24:22,670
وأن تتمّ مناداتي "سيدي" من قبل الخادمة
.مثير للغاية

307
00:24:22,670 --> 00:24:23,610
أيهما تفضل؟

308
00:24:23,610 --> 00:24:24,230
!لا أستطيع الاختيار

309
00:24:24,230 --> 00:24:25,520
!عليّ اختيار كليهما

310
00:24:25,520 --> 00:24:27,020
!سأرتدي كلاهما