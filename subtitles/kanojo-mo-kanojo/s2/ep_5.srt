.إنهما يأكلان منها

214
00:14:28,920 --> 00:14:30,760
!كانت شهية

215
00:14:31,110 --> 00:14:33,450
!لكني أحب البيتزا

216
00:14:33,450 --> 00:14:35,060
...أعلم، لكن

217
00:14:35,060 --> 00:14:38,580
ناغيسا-تشان، أين طعام المخيم الجميل الخاص بي؟

218
00:14:39,560 --> 00:14:42,110
...فـ-في الواقع

219
00:14:43,980 --> 00:14:45,230
!لقد احترق

220
00:14:45,230 --> 00:14:47,570
.من الصعب حقًا تعديل الحرارة

221
00:14:47,570 --> 00:14:48,940
.أخبرتك

222
00:14:48,940 --> 00:14:51,530
.الأمر ليس بتلك السهولة

223
00:14:51,930 --> 00:14:52,740
.حسنًا

224
00:14:53,020 --> 00:14:56,080
!حقق لي مقطع فيديو طهي المخيم هذا أكثر من 300 ألف مشاهدة

225
00:14:59,500 --> 00:15:04,070
الباييلا الفاخرة للغاية التي صنعتها
!لمقطع بمناسبة بلوغي 70 ألف مشترك

226
00:15:05,500 --> 00:15:07,800
!والكاري الكلاسيكي

227
00:15:10,760 --> 00:15:12,350
...طعام المخيم

228
00:15:12,350 --> 00:15:14,460
!ساكي-تشان، ابقي هادئة

229
00:15:14,930 --> 00:15:16,760
.لا يمكنك مواكبة مهارتي

230
00:15:16,760 --> 00:15:20,730
هل لديكم أدنى فكرة منذ متى وأنا أخيم وأصنع الفيديوهات؟

231
00:15:26,020 --> 00:15:28,990
.لا أهتم إن سممتني

232
00:15:29,760 --> 00:15:30,900
!ساكيساكي

233
00:15:30,900 --> 00:15:33,530
!حتى أنني سأخلد إلى النوم وأنهض أكبر من العادة

234
00:15:33,530 --> 00:15:34,700
!ماذا؟

235
00:15:36,410 --> 00:15:39,500
...ميريكا-ساما، بركاتك

236
00:15:39,500 --> 00:15:41,960
.حسنًا

237
00:15:43,560 --> 00:15:46,170
.لكن ليس قبل أن يأتي ناويا أولًا

238
00:15:47,580 --> 00:15:49,740
.صنعته من أجل ناويا في النهاية

239
00:15:49,740 --> 00:15:51,270
.كل يا ناويا

240
00:15:53,860 --> 00:15:55,130
.حسنًا

241
00:16:08,630 --> 00:16:09,820
.إنه شهي

242
00:16:13,320 --> 00:16:14,330
أليس كذلك؟

243
00:16:18,070 --> 00:16:19,660
.حسنًا، سآكل

244
00:16:19,660 --> 00:16:21,350
.كلوا

245
00:16:21,350 --> 00:16:22,750
.أنا أيضًا

246
00:16:22,750 --> 00:16:25,030
.طوبى لك يا أوني-تشان

247
00:16:26,680 --> 00:16:28,880
!لذيذ

248
00:16:28,880 --> 00:16:30,620
.إنه لذيذ حقًا

249
00:16:31,680 --> 00:16:33,540
.تناولي بعضه يا شينو

250
00:16:35,990 --> 00:16:37,390
.إنه شهي

251
00:16:37,680 --> 00:16:39,270
...ميريكا-سان

252
00:16:39,850 --> 00:16:44,500
كيف لك أن تكون بهذه اللا مبالاة

253
00:16:45,310 --> 00:16:48,780
بعد كل ما فعلتُ في يوم الألعاب النارية؟

254
00:16:49,770 --> 00:16:53,120
.لأنك يا ناويا، بدأت تحبني

255
00:16:59,940 --> 00:17:02,860
!هـ-هل فقدت عقلك؟

256
00:17:02,860 --> 00:17:03,950
.ليس تمامًا

257
00:17:03,950 --> 00:17:07,210
.أنا فقط أقوم بتقييم موضوعي

258
00:17:07,210 --> 00:17:09,980
!أخبرها يا ناويا

259
00:17:12,930 --> 00:17:14,090
ناويا؟

260
00:17:15,620 --> 00:17:17,460
...هذا ليس شيئًا

261
00:17:18,770 --> 00:17:20,060
.يمكنني أن أنكره

262
00:17:20,060 --> 00:17:21,260
!أنت

263
00:17:31,990 --> 00:17:36,340
بـ-بدأتَ... تحب ميريكا؟

264
00:17:42,740 --> 00:17:44,470
!عرفت ذلك

265
00:17:46,850 --> 00:17:51,450
!علي أن أواصل هكذا فحسب، وناويا سيكون لي يومًا ما

266
00:17:51,450 --> 00:17:53,840
!أحببت هذا! أحببت هذا! أجل

267
00:17:56,490 --> 00:17:58,470
!لن يحدث ذلك

268
00:17:58,930 --> 00:18:01,320
!أنا منجذب لها نوعًا ما فحسب

269
00:18:01,320 --> 00:18:02,390
!لا بأس

270
00:18:02,720 --> 00:18:05,350
!لا شيء من ذلك يبدو صائبًا

271
00:18:05,350 --> 00:18:06,890
!ناويا، أيها الغبي

272
00:18:06,890 --> 00:18:10,110
!أنت غائط! أنت في الواقع غائط

273
00:18:10,110 --> 00:18:11,310
!توقفي! ساكي-تشان

274
00:18:12,800 --> 00:18:17,460
.ربما ينظر ناويا إلى غيرك لأنك عنيفة جدًا

275
00:18:22,030 --> 00:18:24,750
!لطالما كنتُ هكذا معه! لا بأس

276
00:18:24,750 --> 00:18:27,220
.ناويا يملك ذوقًا سيئًا

277
00:18:27,960 --> 00:18:30,300
أوني-تشان؟

278
00:18:31,110 --> 00:18:32,420
نعم يا ريسا؟

279
00:18:32,420 --> 00:18:36,760
هل يملك ناويا-أونيتشان حبيبة؟

280
00:18:37,360 --> 00:18:38,460
.بالطبع

281
00:18:38,460 --> 00:18:39,530
!أنا

282
00:18:40,080 --> 00:18:41,590
!أ-أنا أيضًا

283
00:18:45,830 --> 00:18:48,770
لم أخبرك بعد، أليس كذلك؟

284
00:18:49,250 --> 00:18:52,300
.ناويا يواعد تلكما الاثنتان

285
00:18:55,710 --> 00:18:57,800
.إنهما يواعد كلتاهما بإذن منهما

286
00:18:57,800 --> 00:19:00,480
.مع تلكما الاثنتان بالضبط، لزيادة الطين بلة

287
00:19:03,240 --> 00:19:06,980
هل وقعت في حب رجل يواعد امرأتين؟

288
00:19:06,980 --> 00:19:09,280
.أ-أنت تجعلينني أخجل

289
00:19:09,280 --> 00:19:11,020
...وقعت في حبه، لكن

290
00:19:15,000 --> 00:19:18,300
وتحاولين أن تخطفيه منهما؟

291
00:19:18,300 --> 00:19:20,050
!بالطبع

292
00:19:20,680 --> 00:19:24,970
.لكن حتى بعد أن طلبت منه مواعدتي، لم ينفصل بهما

293
00:19:24,970 --> 00:19:26,890
.إنه حقًا عنيد

294
00:19:27,570 --> 00:19:31,230
.مع أنني أحب ذلك فيه أيضًا

295
00:19:34,630 --> 00:19:36,440
!أيها المغفل

296
00:19:36,440 --> 00:19:38,030
!أجل! أجل

297
00:19:38,030 --> 00:19:43,030
أنت ظريفة جدًا وتعملين بجد على
...فيديوهاتك وناجحة وتعاملينني بلطف

298
00:19:43,340 --> 00:19:45,340
!انت امرأة صالحة

299
00:19:45,340 --> 00:19:47,850
!اذهبي وجدي رجلًا أفضل لك

300
00:19:49,200 --> 00:19:52,000
!ناويا رجل صالح، حتى إن كان يواعد اثنتين

301
00:19:52,000 --> 00:19:54,250
!إنه يواعد فتاتين! هذا سيئ ما يكفي

302
00:19:54,250 --> 00:19:57,340
!وما قصتك، تعبثين مع حبيب فتاة أخرى؟

303
00:19:57,340 --> 00:19:58,380
!تمامًا

304
00:19:58,680 --> 00:20:02,120
!بل كيف لا تمانعين أن يواعد غيرك؟

305
00:20:02,120 --> 00:20:04,340
.لقد أحرجني ريسابون للتو

306
00:20:04,820 --> 00:20:07,580
.أنت تزعجين كلًا من ساكيساكي وموكاي-كن

307
00:20:07,580 --> 00:20:09,060
لمَ لا تمضين قدمًا فحسب؟

308
00:20:09,620 --> 00:20:11,640
ولمَ عساي؟

309
00:20:12,070 --> 00:20:13,220
...أنت

310
00:20:13,600 --> 00:20:18,020
.ليس وكأنني لا أشعر بالذنب لفعل هذا لكم

311
00:20:18,880 --> 00:20:21,660
لكن ما الغاية من الاستسلام؟

312
00:20:27,510 --> 00:20:31,040
.لا أهتم إن كان يملك ناويا حبيبتين أو إن كنتُ مصدر إزعاج

313
00:20:31,040 --> 00:20:33,500
.لا أستطيع تغيير حقيقة أنني أحبه

314
00:20:35,960 --> 00:20:39,300
.لذا لا يسعني سوى الهجوم

315
00:20:39,840 --> 00:20:46,520
.أن أهاجم وأهاجم وأهاجم وأسقط ذلك الجدار الضخم يومًا ما

316
00:20:51,030 --> 00:20:55,980
.وفي ذلك اليوم، سآخذ ناويا منكما

317
00:20:58,840 --> 00:21:02,040
.كما أنه يبدو أن هناك شق في الجدار بالفعل

318
00:21:04,000 --> 00:21:08,180
.هـ-هناك شيء متأكدة منه الآن

319
00:21:08,740 --> 00:21:12,270
!لا يمكننا أن ندع ناويا لوحده مع ميريكا مجددًا أبدًا

320
00:21:12,270 --> 00:21:13,450
!مـ-معك حق

321
00:21:17,780 --> 00:21:18,940
!أنتما

322
00:21:18,940 --> 00:21:19,850
!ناويا

323
00:21:19,850 --> 00:21:20,880
!ناويا-كن

324
00:21:21,230 --> 00:21:25,680
.ستخبرني لاحقًا ماذا حدث بينك وميريكا

325
00:21:25,680 --> 00:21:28,430
...أ-أكيد، لا بأس

326
00:21:28,850 --> 00:21:30,810
.لكن اسمعاني

327
00:21:33,150 --> 00:21:35,870
.صحيح أن ميريكا-سان جذابة

328
00:21:35,870 --> 00:21:38,920
.وصحيح أنني منجذب إليها نوعًا ما

329
00:21:39,480 --> 00:21:43,690
!لكني لن أفعل أي شيء قد يحزنكما أنتما الاثنتان

330
00:21:45,150 --> 00:21:48,630
...لأنني

331
00:21:51,520 --> 00:21:52,620
!لا تنم

332
00:21:52,910 --> 00:21:58,220
...مـ-مهلًا... أنا أيضًا... أشعرُ

333
00:22:00,680 --> 00:22:02,470
!ميريكا، لم تفعلي

334
00:22:05,590 --> 00:22:06,650
.بالطبع

335
00:22:06,650 --> 00:22:10,760
.في كل البيتزا ما عدا الشريحة الأولى التي أكلت

336
00:22:10,760 --> 00:22:12,190
!أهذه الفتاة بعقلها؟

337
00:22:12,190 --> 00:22:13,350
!لم أعلم هذا أبدًا

338
00:22:15,010 --> 00:22:16,650
...أشعر بالنعاس

339
00:22:27,800 --> 00:22:33,440
!بدء عملية التخييم الرومانسي مع ناويا

340
00:24:13,360 --> 00:24:15,850
!عرض مسبق للحلقة القادمة، لكنه على تلفاز ريسابون

341
00:24:15,850 --> 00:24:19,180
في الحلقة السادسة، ستقدم أوني-تشان
!على المزيد من الحركات تجاه ناويا-أونيتشان

342
00:24:19,870 --> 00:24:23,040
.لا أملك الوقت لأكون لطيفة إن كنت سأكون مع ناويا

343
00:24:23,040 --> 00:24:25,060
.لا، حقًا، هذه جريمة

344
00:24:25,060 --> 00:24:26,120
.آسفة