1
00:01:38,330 --> 00:01:42,870
،عندما انضمّت طائفة الميودا إلى نِظام الصّليب الحقيقيّ

2
00:01:42,870 --> 00:01:45,940
.ظننتُ بأنّ كلّ شيءٍ سيكون على مايُرام

3
00:01:46,670 --> 00:01:49,070
...لكن ذلك الرّجل

4
00:01:52,880 --> 00:01:54,130
.رئيس الكهنة تاتسوما

5
00:01:55,870 --> 00:01:59,230
ألا تنوي الإنضمام إلى النّظام حقّاً؟

6
00:01:59,230 --> 00:02:01,330
!ماموشي! لا تُشتّتي انتباه رئيس الكهنة

7
00:02:01,330 --> 00:02:03,300
.لا أنوي هذا، كلّا

8
00:02:03,300 --> 00:02:06,260
.قد لا يبدو عليّ هذا، لكنّني كثير الإنشغال هذه الأيّام

9
00:02:06,260 --> 00:02:08,800
.بمُهمّةٍ شديدة الأهمّيّة

10
00:02:09,360 --> 00:02:14,410
.لَم أتمكّن من التّخلّص من شُعوري بأنّ تصرّف رئيس الكهنة كان مُريباً

11
00:02:20,600 --> 00:02:26,810
.نما ذلك الشكّ كلّ يومٍ في قلبي حتّى استهلكَ عقلي بأكمله

12
00:02:28,720 --> 00:02:32,820
.كان كسُمٍّ ينتشر في جميع أنحاء جسدي

13
00:02:40,190 --> 00:02:42,170
!هاي، هوجو سان

14
00:02:46,350 --> 00:02:50,510
أنتِ من مَعبد الميودا ذاك، صحيح؟

15
00:02:50,510 --> 00:02:51,750
.نعم، بالفِعل

16
00:02:51,750 --> 00:02:54,380
إذاً لابدّ من أنّ هذا يعني بأنّكِ تعرفين شيما سينباي جيّداً، هاه؟

17
00:02:54,380 --> 00:02:57,230
هل تعلَمين إن كان لَديه حبيبة؟

18
00:02:57,230 --> 00:02:59,310
.أردتّ أن أصنع له وَجبة غداء

19
00:02:59,660 --> 00:03:01,710
كيف يُحبّ تناول البيض؟

20
00:03:01,710 --> 00:03:03,070
ما العلامة التّجاريّة التي يرتدي ملابسه منها؟

21
00:03:03,070 --> 00:03:04,960
ما الهديّة التي ستكون مُناسبةً لإعطائها له؟

22
00:03:04,960 --> 00:03:06,530
!هاي، لا غِشّ

23
00:03:07,900 --> 00:03:08,900
هذا ثانيةً؟

24
00:03:08,900 --> 00:03:11,470
هاه؟ أيّ نوعٍ من العلامات التّجاريّة هي هذه؟

25
00:03:12,290 --> 00:03:15,940
لماذا تأتين لسُؤالي هذه الأسئلة؟
.إذهبن و اسألنَه بأنفسكنّ فقط

26
00:03:27,310 --> 00:03:30,920
لماذا أنا سيّئةٌ جدّاً بهذا؟

27
00:03:43,990 --> 00:03:45,700
.مرحباً، هوجو كن

28
00:03:49,130 --> 00:03:52,400
أعتذر، هل سرقتُ مكانكِ المُعتاد؟

29
00:03:52,890 --> 00:03:56,110
.كلّا، لا بأس بك

30
00:04:12,410 --> 00:04:14,350
لا يبدو بأنّه يُمكنكِ الإنسجام مع الآخرين، هاه؟

31
00:04:15,750 --> 00:04:20,260
.تبدين لوَحدكِ دائماً، في كِلا المدرسة المسائيّة و الأكاديميّة

32
00:04:20,950 --> 00:04:23,490
.لكن هذا لَيس شيئاً سيّئاً بالضّرورة

33
00:04:23,490 --> 00:04:26,890
.لا أُجيد التّعامل مع الآخرين أيضاً

34
00:04:29,030 --> 00:04:31,630
.لكن لا يجب أن تشعري بالضّغط لتغيير نفسك

35
00:04:33,190 --> 00:04:39,110
.إن أجبرتِ نفسكِ على الإنسجام مع الآخرين، شُعوركِ بالذّات سيتشوّه

36
00:04:39,110 --> 00:04:44,620
.مُحاولة الحياة مع هذا التّشوّه سيُصعّب الأُمور عليكِ فقط

37
00:04:46,080 --> 00:04:49,580
.هذا شيءٌ مُؤلِمٌ جدّاً لتضعي نفسكِ خِلاله

38
00:04:51,410 --> 00:04:55,870
ألَيس العمل الجّماعيّ من أهمّ المهارات الضّروريّة للمُعوّذ؟

39
00:04:55,870 --> 00:04:57,550
العمل الجّماعيّ، هاه؟

40
00:04:59,520 --> 00:05:01,910
،إقتباساً من إحدى أكثر القصائد المُفضّلة لَديّ

41
00:05:01,910 --> 00:05:05,980
".الطّريق المُستقيم تملؤه الوِحده"

42
00:05:05,980 --> 00:05:07,120
من كتابات سانتوكا؟

43
00:05:07,120 --> 00:05:08,560
.مُتفاجئٌ لمَعرفتكِ به

44
00:05:09,200 --> 00:05:13,750
ألا تظنّين بأنّ تلك القصيدة تُلخّص ما يعنيه أن تكون بَشراً؟

45
00:05:14,490 --> 00:05:16,190
ماذا تعني؟

46
00:05:20,510 --> 00:05:21,700
.لَديّ فِكرة

47
00:05:24,790 --> 00:05:28,410
هلّا قُمتِ بوَاجبٍ منزليٍّ إضافيٍّ لأجلي؟

48
00:05:30,850 --> 00:05:34,050
.قد يُساعدكِ باكتشاف ماهيّة مُشكلتك

49
00:05:45,370 --> 00:05:47,100
كيف يكون هذا وَاجباً منزليّاً؟

50
00:05:54,250 --> 00:05:57,270
.يجعلُني فقط أقوم بأعمالٍ وَضيعة

51
00:05:57,270 --> 00:05:57,940
...إضافةً إلى هذا

52
00:05:59,450 --> 00:06:01,450
لماذا أنتَ هُنا، أيّها القِرد؟

53
00:06:01,450 --> 00:06:03,610
.أنا من يُفترض أن أسألكِ هذا

54
00:06:05,040 --> 00:06:08,770
،عرفتُ بأنّ شخصاً آخر كان سيُساعدُني بهذا

55
00:06:09,980 --> 00:06:11,330
لكن لماذا يجب أن تكوني أنتِ؟

56
00:06:11,840 --> 00:06:15,280
لماذا أحتاج للنّظر إلى وَجهكَ الغبيّ في العُطلَة أيضاً؟

57
00:06:15,280 --> 00:06:17,090
.ثانيةً، هذا ما أُريد أن أسألكِ إيّاه

58
00:06:17,970 --> 00:06:21,120
،أعارَني تودو سينساي كِتاباً قبل أيّام

59
00:06:21,120 --> 00:06:24,020
.و عرضتّ أن أقوم بالمُساعدة بشيءٍ لردّ المَعروف

60
00:06:24,020 --> 00:06:26,880
.لذا طلَب منّي البارحة أن آتي و أفعل هذا

61
00:06:27,540 --> 00:06:29,720
لماذا أنتِ هُنا؟

62
00:06:30,400 --> 00:06:31,550
.هذا هو الأسوأ

63
00:06:32,520 --> 00:06:36,480
.تأخّر الوَقتُ كثيراً على الشّكوى الآن
.سيكون عليكِ فقط التّعايش مع هذا

64
00:06:36,990 --> 00:06:39,090
.وَجهكِ أكثر إزعاجاً حتّى عندما تعبسين

65
00:06:39,090 --> 00:06:40,110
!ماذا قُلت؟

66
00:06:46,950 --> 00:06:48,370
.حسناً، يكفي جِدالاً

67
00:06:49,230 --> 00:06:53,870
.لا أُريد أن يأخذ هذا العمل طوال المَساء

68
00:06:57,520 --> 00:07:02,060
،يُمكننا العودة بحمل الباريون في حقائبنا عن طريق وَضع التّعاويذ عليها لاحقاً

69
00:06:57,520 --> 00:07:02,060
.الباريون: شياطينٌ مُتدنّية المُستوى

70
00:07:02,060 --> 00:07:04,340
.لكن للآن، لنُكوّمها هُناك فقط

71
00:07:05,130 --> 00:07:08,710
.سأبحث في هذه الأنحاء. خُذي الجّانب الآخر

72
00:07:09,950 --> 00:07:13,100
ما الذي يجعلكَ تظنّ أنّ بإمكانكَ أن تأمرني كما تُريد؟

73
00:07:17,810 --> 00:07:23,440
.سأبحث هُنا. سيكون قِردٌ مثلكَ بحالٍ أفضل هناك حيث ستكون الرّؤية أسهل

74
00:07:23,440 --> 00:07:24,670
.حسناً، إذهب

75
00:07:24,670 --> 00:07:27,280
لا تملكين أيّ عظمةٍ ظريفةٍ في جسدك، صحيح؟

76
00:07:30,400 --> 00:07:32,040
.إعتني بشُؤونكَ الخاصّة

77
00:07:55,520 --> 00:07:56,640
.تفضّلي

78
00:07:57,970 --> 00:07:59,360
ماذا تفعل؟

79
00:07:59,850 --> 00:08:01,440
.أُعطيكِ شراباً

80
00:08:03,150 --> 00:08:04,190
.أُتركني و شأني

81
00:08:04,590 --> 00:08:08,450
.لا تفهمي الأمر بشكلٍ خاطئ
.لَم أُحضره لأجلك

82
00:08:09,380 --> 00:08:12,060
،أخبرَني تودو سينساي بأنّ شخصاً آخر سيكون هُنا

83
00:08:12,060 --> 00:08:15,040
.لذا أحضرتُ إثنان من هذه الأشياء

84
00:08:15,040 --> 00:08:17,100
.لَديّ خاصّتي أيضاً

85
00:08:17,870 --> 00:08:18,820
كم كان ثمنُه؟

86
00:08:18,820 --> 00:08:21,340
.ماذا؟ لَستِ بحاجةٍ لأن تدفعي لي

87
00:08:23,070 --> 00:08:25,710
.لا أقبل بأيّ صدَقاتٍ من قِرد

88
00:08:25,710 --> 00:08:29,140
.أنتِ حقّاً لا تملكين أيّ عظمةٍ ظريفةٍ في جسدك

89
00:08:42,020 --> 00:08:44,590
ألَديكِ أيّ أصدقاءٍ في الأكاديميّة؟

90
00:08:45,930 --> 00:08:47,710
.أنتِ دائماً لوَحدك

91
00:08:49,060 --> 00:08:52,910
ماذا في ذلك؟ لماذا تهتمّ بهذا؟

92
00:08:52,910 --> 00:08:55,530
.طُلِبَ منّي الإعتناء بكِ

93
00:08:56,900 --> 00:09:00,310
من قِبَل من بالضّبط؟ أبي؟

94
00:09:00,310 --> 00:09:02,330
.كلّا، رئيس الكهنة

95
00:09:02,710 --> 00:09:06,210
.كان قلِقاً عليكِ

96
00:09:06,730 --> 00:09:11,670
.من السّهل أن يُساء فهمُها، لكنّها فتاةٌ جيّدةٌ في قلبها

97
00:09:11,670 --> 00:09:15,250
لذا تأكّد من الإعتناء بها، حسناً؟

98
00:09:15,250 --> 00:09:16,720
.بالتّأكيد

99
00:09:17,250 --> 00:09:19,980
.إن قُلتَ هذا، يا رئيس الكهنة

100
00:09:21,110 --> 00:09:23,820
.هكذا جرى الأمر

101
00:09:26,690 --> 00:09:29,190
.حسناً، لنَعُد إلى العمل

102
00:09:42,900 --> 00:09:46,420
لماذا لَم تنضمّ إلى نِظام الصّليب الحقيقيّ، يا رئيس الكهنة تاتسوما؟

103
00:09:47,280 --> 00:09:49,990
...إن كنتَ تهتمّ حقّاً لأمر طائفة الميودا

104
00:09:49,990 --> 00:09:53,260
...إن رغبتَ بحمايتها

105
00:09:53,260 --> 00:09:57,680
ألا يُفترض أن تأخذ زِمام المُبادرة و أن تُصبح مُعوّذاً لتتمكّن
من الإستمرار بقيادة الجّميع؟

106
00:09:58,170 --> 00:10:02,140
.بدلاً من هذا، تختفي كلّ يومٍ دون قول شيء

107
00:10:02,140 --> 00:10:06,070
!توَقّفتَ عن إعطاء الخُطَب حتّى

108
00:10:06,780 --> 00:10:08,320
ما الذي تُحاول فِعله؟

109
00:10:09,060 --> 00:10:12,260
هل الميودا لَيست بهذه الأهمّيّة بالنّسبة لك؟

110
00:10:23,210 --> 00:10:25,130
.أظنّنا حصلنا على ما يكفي

111
00:10:25,690 --> 00:10:29,000
.إن لَم نعُد قريباً، سيبدأ تودو سينساي بالقلَق

112
00:10:30,580 --> 00:10:33,470
.لكنّكَ وَجدتّ أكثر منّي بكثير

113
00:10:34,000 --> 00:10:35,300
ماذا؟

114
00:10:35,300 --> 00:10:37,350
.لَم أنتهي بعد

115
00:10:37,350 --> 00:10:38,640
!توَقّفي عن كونكِ بهذا العِناد

116
00:10:39,260 --> 00:10:41,810
.يُصبح الشّياطين أقوى بعد غُروب الشّمس

117
00:10:41,810 --> 00:10:44,550
.حتّى الباريون تكون خطِرةً عند الإستخفاف بها

118
00:10:44,550 --> 00:10:45,790
!أعلَم هذا

119
00:10:46,740 --> 00:10:47,610
!هاي

120
00:10:52,530 --> 00:10:54,030
!هناك وَاحد

121
00:11:04,210 --> 00:11:05,080
!هذا سيّء

122
00:11:05,080 --> 00:11:06,670
!إبتعدي عن ذلك الشّيء

123
00:11:12,740 --> 00:11:13,470
!ماموشي

124
00:11:16,950 --> 00:11:17,340
!أوه لا

125
00:11:17,340 --> 00:11:18,420
!كريك

126
00:11:30,300 --> 00:11:32,190
!بماذا كنتِ تُفكّرين؟

127
00:11:32,190 --> 00:11:34,230
!من الوَاضح أنّ ذاك كان بالِغاً و أكثر قوّة

128
00:11:34,230 --> 00:11:36,450
!لأمكنكِ التّسبّب بانفشاخ رأسك

129
00:11:41,110 --> 00:11:42,410
.شييش

130
00:11:43,280 --> 00:11:45,940
.مهما يكن. سعيدٌ لأنّكِ بخير

131
00:11:45,940 --> 00:11:49,020
!لا أذكر طلَب المُساعدة منك

132
00:11:50,400 --> 00:11:53,750
!توَقّف عن كونكَ قِرداً مُتطفّلاً هكذا و اعتني بشؤونكَ الخاصّة

133
00:11:56,030 --> 00:11:58,930
.أنا فظيعة

134
00:12:01,990 --> 00:12:04,140
.تعالي، لنَعُد

135
00:12:13,020 --> 00:12:13,980
ما الخطب؟

136
00:12:15,250 --> 00:12:16,980
.لا شيء

137
00:12:22,710 --> 00:12:23,760
!ماموشي

138
00:12:25,150 --> 00:12:26,580
هل تأذّيتِ؟

139
00:12:26,580 --> 00:12:29,030
.أخبرتكَ للتّوّ أنّه لا شيء

140
00:12:30,350 --> 00:12:32,340
...لماذا أنتِ بهذا

141
00:12:40,860 --> 00:12:42,630
ماذا تفعل؟

142
00:12:42,630 --> 00:12:43,850
.إصعدي

143
00:12:45,100 --> 00:12:47,620
...لـ-لماذا قد أسمح لقِردٍ مثلكَ

144
00:12:47,620 --> 00:12:49,500
!هذا لَيس الوَقت المُناسب لهذا

145
00:12:51,330 --> 00:12:52,370
.أسرِعي

146
00:12:54,480 --> 00:12:58,260
.إن حمَلتَني، لا يُمكننا إعادة الباريون معنا

147
00:12:58,260 --> 00:13:01,740
.سألحق بكَ حالَما يختفي الألَم، لذا غادر من دُوني

148
00:13:01,740 --> 00:13:02,740
هل أنتِ غبيّة؟

149
00:13:03,930 --> 00:13:05,200
!لَيسوا سوى باريون

150
00:13:05,520 --> 00:13:07,610
!شخصٌ مُتألّمٌ سيكون أكثر أهمّيّةً بالتّأكيد

151
00:13:07,610 --> 00:13:12,330
لَو كنتُ من تأذّى، هل كنتِ ستتركيني بالخلف مع بعض الباريون الغبيّة؟

152
00:13:15,190 --> 00:13:17,860
.يُمكننا دائماً العودة لاحقاً لأجلها

153
00:13:17,860 --> 00:13:20,560
.أنتِ عنيدةٌ جدّاً

154
00:13:22,900 --> 00:13:24,930
.أسرِعي و اصعدي، أيّتها الغبيّة

155
00:13:39,360 --> 00:13:40,870
!سبعة

156
00:13:40,870 --> 00:13:42,330
!ثمانية

157
00:13:42,330 --> 00:13:43,620
!تسعة

158
00:13:43,620 --> 00:13:44,850
!عشرة

159
00:13:44,850 --> 00:13:46,940
!سأُمسك بكما، أيّها القِردان القذران

160
00:13:46,940 --> 00:13:49,160
!أه-أوه، ها هي قادمة! أُهرب

161
00:13:51,460 --> 00:13:52,460
!هاي، ماموشي

162
00:13:52,880 --> 00:13:54,570
!لا تقتربي من هذا المكان

163
00:13:56,850 --> 00:13:58,090
.أوه، يا إلهي

164
00:13:58,090 --> 00:14:00,470
.إذاً كنتِ هُنا، ماموشي

165
00:14:00,830 --> 00:14:02,970
.كان وَالِدكِ قلِقاً جدّاً

166
00:14:03,780 --> 00:14:05,970
هل أنتِ مُستعدّةٌ للعودة إلى المنزل؟

167
00:14:07,630 --> 00:14:11,690
!لَقد كبرتِ كثيراً، ماموشي

168
00:14:18,660 --> 00:14:22,430
.لَم تُراودني أيّ شُكوكٍ بشأن رئيس الكهنة وَقتها

169
00:14:22,430 --> 00:14:25,120
،ظننتُ بأنّه مادُمنا نتبعه

170
00:14:25,120 --> 00:14:27,700
.سيقود الجّميع عبر الطّريق الصّحيح

171
00:14:27,700 --> 00:14:29,440
.وَثقتُ به بشكلٍ كامل

172
00:14:32,000 --> 00:14:32,950
...لكن

173
00:14:36,740 --> 00:14:37,590
كيف؟

174
00:14:38,610 --> 00:14:41,550
كيف انتهت الأُمور بهذا الشّكل؟

175
00:14:42,350 --> 00:14:44,250
هل أنتِ بخير؟ أمازالَت تُؤلمكِ؟

176
00:14:46,730 --> 00:14:51,310
لماذا لا ينضمّ رئيس الكهنة إلى النّظام؟

177
00:14:51,310 --> 00:14:55,050
.لَديه أُمورٌ أكثر أهمّيّةً لفِعلها
.أخبركِ بهذا سابقاً

178
00:14:55,050 --> 00:14:57,400
ماذا يُمكن أن يكون "أهمّ" من هذا؟

179
00:14:57,890 --> 00:15:03,070
،ألا يُفترض برئيس الكهنة أن يكون أوّل من يُصبح مُعوّذاً

180
00:15:03,070 --> 00:15:05,890
ليتمكّن من قيادة بقيّة الميودا؟

181
00:15:06,460 --> 00:15:08,830
ألَيس هذا ما يُفترض برئيس الكهنة أن يفعله؟

182
00:15:11,460 --> 00:15:13,850
هل كنتِ قلِقةً بشأن هذا طوال هذا الوَقت؟

183
00:15:13,850 --> 00:15:15,850
.هذه المرّة الأُولى التي أقول بها هذا بصوتٍ مَسموع

184
00:15:16,900 --> 00:15:19,590
.وَاثقٌ من أنّ رئيس الكهنة لَديه أسبابه

185
00:15:19,590 --> 00:15:23,110
.كلّ ما يُمكننا فِعله هو الثّقة بحُكمه

186
00:15:23,110 --> 00:15:24,540
الثّقة به؟

187
00:15:24,540 --> 00:15:26,240
.بالتّأكيد

188
00:15:26,240 --> 00:15:28,300
.إنّه رئيس كهنتِنا

189
00:15:28,300 --> 00:15:30,060
.يجب أن نثق به

190
00:15:38,830 --> 00:15:42,570
أ-أوه، يا إلهي. ماذا أصاب قدمكِ؟

191
00:15:42,910 --> 00:15:44,130
...حسناً

192
00:15:44,790 --> 00:15:48,670
.ذهبنا إلى المُستوصف للتّوّ و أخبرونا بأنّه التواء

193
00:15:48,670 --> 00:15:52,190
.أعتذر بشأن الباريون
.سأعود لأجلها في الغد

194
00:15:55,990 --> 00:16:00,790
.إنسى هذا. أنا سعيدٌ فقط لأنّ إصابتكِ لَيست خطِرة، هوجو كن

195
00:16:00,790 --> 00:16:02,730
.نعم، أنا أيضاً

196
00:16:05,510 --> 00:16:10,710
أرغب بإجراء نِقاشٍ خاصٍّ مع هوجو كن، لذا هل يُمكنني أن أطلُب منكَ المُغادرة؟

197
00:16:10,710 --> 00:16:12,000
.نعم، بالتّأكيد

198
00:16:13,550 --> 00:16:15,600
.نادِني إن حصل أيّ شيء

199
00:16:21,530 --> 00:16:25,030
.يُذكّرُني بالعديد من الأشخاص الذين أعرفهم

200
00:16:26,150 --> 00:16:30,370
،لَيس بسبب شخصيّته أو مَظهره

201
00:16:30,720 --> 00:16:32,940
.بل لأنّه لا يملك شكّاً في نفسه

202
00:16:32,940 --> 00:16:36,480
.يقوم بأيّ مُهمّةٍ بإرادةٍ قويّةٍ و تركيزٍ كامل

203
00:16:37,760 --> 00:16:42,620
.وَاثقٌ من أنّ الكثيرين يحترمونه و يُعجبون به، و لا شكّ في أنّه سيُصبح مُعوّذاً رائعاً

204
00:16:45,030 --> 00:16:47,840
...و مُقارنةً به، أنا

205
00:16:47,840 --> 00:16:50,550
.لكنّكِ شخصٌ مُختلف

206
00:16:51,710 --> 00:16:54,620
.لا حاجة لأن تُصبحي شبيهةً بشخصٍ آخر

207
00:16:54,620 --> 00:16:58,740
.المُهمّ هو أن تكوني حذرةً من مُحيطك

208
00:17:00,820 --> 00:17:03,110
.و أنتِ مُتمكّنةٌ جدّاً من هذا

209
00:17:20,010 --> 00:17:23,790
.من السّهل بشكلٍ رائعٍ التّلاعب بها

210
00:17:27,840 --> 00:17:31,300
الآن، أيّهما يجب أن أستخدم؟

211
00:17:36,190 --> 00:17:40,150
!بالتّأكيد، لابدّ من أن تكون أنتِ

212
00:17:41,050 --> 00:17:42,320
.أوه، البَشر

213
00:17:42,320 --> 00:17:47,750
،كلّما أصبحنا أكثر يأساً للثّقة بأحدهم، كلّما جرّنا ذلك الشّعور نحو الهاوية أكثر

214
00:17:47,750 --> 00:17:51,470
.حتّى تستهلكنا شُكوكنا

215
00:17:54,460 --> 00:17:56,830
.أنتِ عُرضةٌ لهذا بشكلٍ خاصّ

216
00:18:02,660 --> 00:18:06,170
،سأستغلّكِ جيّداً

217
00:18:06,960 --> 00:18:09,280
.هونجو ماموشي كن

218
00:18:12,800 --> 00:18:15,370
،أطلُب أن تُبقي هذا الأمر بيننا

219
00:18:15,370 --> 00:18:18,400
لكن هل تعرفين عن شيءٍ يُدعى بالعين اليُسرى للملِك المُلوّث؟

220
00:18:18,400 --> 00:18:19,780
العين اليُسرى؟

221
00:18:19,780 --> 00:18:22,860
هـ-هل هناك وُجودٌ لشيءٍ كهذا؟

222
00:18:22,860 --> 00:18:28,660
،في الوَاقع، تُخالِجُني شُكوكٌ بشأن تصرّفات ميفيستو منذ وَقتٍ طويل

223
00:18:28,660 --> 00:18:34,220
.و أعتقد بأنّ رئيس كهنة طائفة الميودا، تاتسوما سوغورو، قد يكون مُتآمراً معه أيضاً

224
00:18:34,220 --> 00:18:35,290
...هذا مُستحيل

225
00:18:35,290 --> 00:18:36,610
رئيس الكهنة؟

226
00:18:37,300 --> 00:18:41,570
هلّا ساعدتّني، هوجو كن؟

227
00:18:44,150 --> 00:18:48,570
.كلّ هذا لحماية منزلي، طائفة الميودا

228
00:19:04,810 --> 00:19:09,020
.وَاثقةٌ من أنّ الجّميع سيتفهّم الأمر يوماً ما

229
00:20:45,760 --> 00:20:47,210
.إذاً هذا هو الأمر

230
00:20:47,210 --> 00:20:48,960
!قرّرتُ أن أتزوّج من ماموشي

231
00:20:51,040 --> 00:20:53,360
!كـ-كيف تجرؤ على التّحدّث بإسمي

232
00:20:53,360 --> 00:20:55,590
!لَم أُوَافق على أيّ شيء

233
00:20:55,590 --> 00:20:59,510
ماذا تعنين؟ ألَيس هذا طبيعيّاً فقط بعد ما حصل البارحة؟

234
00:21:00,500 --> 00:21:03,140
!هذا يكفي
!لا-لا تتحدّث عن هذا بهذا الشّكل العرضيّ

235
00:21:03,140 --> 00:21:05,760
!سأقتُلك! سأقتُلك

236
00:21:06,730 --> 00:21:10,190
!أيّها القِرد البغيض
ماذا فعلتَ بأُختِنا؟

237
00:21:10,190 --> 00:21:14,400
!جوزو! هل ستخوننا لأجل هذه الفتاة النّحيلة الأفعى؟

238
00:21:14,400 --> 00:21:18,650
!كان يُفترض بكَ أن تجد جميلةً شقراء بجسدٍ جذّابٍ لتتزوّج منها

239
00:21:18,650 --> 00:21:20,810
!ماذا قُلت، يا قِرد شيما المُنحرف؟

240
00:21:20,810 --> 00:21:22,400
!لا يُمكنكَ السّخرية من أُختِنا هكذا

241
00:21:22,400 --> 00:21:23,570
من الذي تدعينه بالقِرد المُنحرف؟

242
00:21:23,570 --> 00:21:25,430
ماذا يحصل هُنا؟

243
00:21:27,260 --> 00:21:29,290
!واو، هذا عظيم

244
00:21:29,290 --> 00:21:31,230
!سيتزوّج أخوك

245
00:21:31,230 --> 00:21:32,380
ألَستَ مُتحمّساً؟

246
00:21:32,380 --> 00:21:35,040
.لكنّهما عمليّاً من الأقرباء. هذا يُقشعرني

247
00:21:36,170 --> 00:21:39,410
.الحُبّ لا يقوده المَنطق أو العقل

248
00:21:39,410 --> 00:21:42,310
!إيزومي، لَم أعلَم بأنّكِ خبيرةٌ بالحُبّ

249
00:21:43,410 --> 00:21:45,010
!إخرس

250
00:21:45,010 --> 00:21:51,280
.أتسائل من سيُشبه طِفلُهما
!لا يُمكنني الإنتظار لأرى هذا

251
00:21:51,280 --> 00:21:53,530
!أنا أيضاً

252
00:21:53,530 --> 00:21:55,270
!وَاثقةٌ من أنّها سيحصلان على طِفلٍ ظريف

253
00:21:55,270 --> 00:21:57,570
لماذا تتحدّثان عن طِفلِهما بالفِعل؟

254
00:21:57,570 --> 00:22:00,740
!توَقّفا! لَم أرغب بتخيّل هذا

255
00:22:00,740 --> 00:22:04,500
.تخيّلوا طِفلاً بعينا جوزو و أنف ماموشي

256
00:22:04,500 --> 00:22:06,240
.هذا ما أرغب برُؤيته

257
00:22:09,750 --> 00:22:11,750
.لا أشعر بأيّ تعاطفٍ مع هذا الموضوع

258
00:22:12,430 --> 00:22:15,590
ألَم يُوَافق وَالِداهما على هذا بسهولةٍ تامّة؟

259
00:22:15,590 --> 00:22:17,380
إنتظر، لماذا قد يرفُضان؟

260
00:22:18,150 --> 00:22:19,880
...حسناً

261
00:22:22,870 --> 00:22:23,840
!هُدوء

262
00:22:27,670 --> 00:22:29,520
...جـ-جوزو

263
00:22:30,950 --> 00:22:34,980
.لا يبدو بأنّ ماموشي تشان تتّفق معك

264
00:22:35,680 --> 00:22:38,300
!بالفِعل! أُختُنا أفضل من مُستواكَ بكثير

265
00:22:39,570 --> 00:22:40,820
.ماموشي

266
00:22:41,890 --> 00:22:45,070
.أنا جادٌّ بشأن الزّواج منكِ
ألَن تُعيدي التّفكير بالأمر؟

267
00:22:46,140 --> 00:22:51,040
.سأُعاقَب
.لَن يُسمح لي بالزّواج

268
00:22:51,040 --> 00:22:53,100
!هذه لَيست مُشكلةً على الإطلاق

269
00:22:53,100 --> 00:22:55,940
!فكّري بأنّ الزّواج بي عِقابٌ لكِ فقط

270
00:22:55,940 --> 00:22:57,930
.وَقتها سينجح كلّ شيء

271
00:22:59,030 --> 00:23:01,550
!أيّ نوعٍ من الحمقى تظنّني؟

272
00:23:02,380 --> 00:23:05,510
...أ-أنا لَن

273
00:23:05,510 --> 00:23:07,260
.أعتبر هذا كعِقاب

274
00:23:07,570 --> 00:23:09,480
!أُختي

275
00:23:12,210 --> 00:23:14,540
...أطلُب منكَ بشكلٍ رسميّ، أوابامي ساما

276
00:23:15,620 --> 00:23:17,440
!أعطِني برَكتكَ للزّواج من ماموشي

277
00:23:21,100 --> 00:23:23,230
!أرجوكَ اعتني بابنتي الصّغيرة جيّداً

278
00:23:23,230 --> 00:23:24,560
!كان ذلك سريعاً

279
00:23:24,560 --> 00:23:25,950
!شُكراً جزيلاً لك

280
00:23:25,950 --> 00:23:27,880
...إنتظر، مازلتُ لَم أُوَافق

281
00:23:29,870 --> 00:23:31,610
!هذا رائع

282
00:23:31,610 --> 00:23:33,190
.نهايةٌ مُلائمة

283
00:23:33,190 --> 00:23:35,860
!أنتُم تقتلونني بهذا

284
00:23:35,860 --> 00:23:37,610
.أستسلِم

285
00:23:39,190 --> 00:23:41,350
.سعيدٌ لأنّهما حصلا على نهايةٍ سعيدة

286
00:23:41,350 --> 00:23:42,590
صحيح، سوغورو؟

287
00:23:43,370 --> 00:23:45,840
.كما تُريد، ساتان ساما

288
00:23:45,840 --> 00:23:49,470
مـ-متى أصبحتُ ساتان نفسه؟

289
00:23:49,470 --> 00:23:51,790
!ألا يُمكنكم التّوَقّف عن هذه المزحة بالفِعل؟

290
00:23:53,700 --> 00:23:56,180
.كلّا، سنبدأ على الأرجح بمُناداتكَ بساتان فقط

291
00:23:56,180 --> 00:23:57,250
!ماذا؟

292
00:23:57,250 --> 00:23:59,990
!هيّا الآن، هذا مُضحك