1
00:01:32,000 --> 00:01:33,440
!غوتن مورغان

2
00:01:33,780 --> 00:01:37,480
.إذاً، كنتَ في أكاديميّة الصّليب الحقيقيّ لشهرٍ حتّى الآن

3
00:01:37,480 --> 00:01:39,910
هل اعتدتّ عليها؟

4
00:01:40,340 --> 00:01:42,040
!بالتّأكيد فعلت

5
00:01:42,040 --> 00:01:45,500
!المَبنى جميل، و جميع الفتيات ظريفاتٌ أيضاً

6
00:01:45,780 --> 00:01:48,180
.أستمتع كثيراً هُنا

7
00:01:48,180 --> 00:01:49,940
.من الجيّد سماع ذلك

8
00:01:50,740 --> 00:01:52,210
.من جهةٍ أُخرى، شيما

9
00:01:52,600 --> 00:01:56,920
ما هي أهمّ مهارةٍ لَدى الجّاسوس برأيك؟

10
00:01:57,260 --> 00:02:00,700
.ستكون مهارة خِداع أعداءه

11
00:02:02,890 --> 00:02:07,730
.سأكون كريماً و أُعطيكَ 60 نُقطةً على هذه الإجابة

12
00:02:07,730 --> 00:02:11,400
.المُهمّ حقّاً هي المَعلومات التي يحصل عليها الجّاسوس

13
00:02:11,860 --> 00:02:16,900
.يكذِب الجّواسيس فقط للحصول على المَعلومات

14
00:02:17,440 --> 00:02:24,660
.في النّهاية، يجب أيضاً أن تكون مُستعدّاً لخيانة عائلتك، أصدقاءك، و حتّى نفسك

15
00:02:25,180 --> 00:02:30,420
.بمَعنىً آخر، يجب ألّا يتردّد قلب الجّاسوس أبداً عند السّعي لهدَفه

16
00:02:30,420 --> 00:02:31,130
...صحيح

17
00:02:31,130 --> 00:02:37,380
.و بقول هذا، أرغب بإعطاءكَ 3 مُهمّاتٍ خاصّةٍ مُصمّمةً لتدريبك

18
00:02:37,380 --> 00:02:41,200
.إن أنجزتَ الـ3 جميعاً، ستُكافأ جيّداً

19
00:02:42,180 --> 00:02:44,300
.ستكون هذه مُكافأتك

20
00:02:46,000 --> 00:02:48,340
...هـ-هل هذه

21
00:02:48,340 --> 00:02:49,270
...مُستحيل

22
00:02:49,740 --> 00:02:53,110
!لابدّ من أنّني أتخيّل، صحيح؟

23
00:02:54,980 --> 00:02:57,570
،بالفِعل، تنظُر إلى أكثر الكُتب أهمّيّة

24
00:02:58,420 --> 00:03:04,530
.المجموعة النّادرة جدّاً لرسمات إمبراطور النّشوَة الغير مَنشورة

25
00:03:04,960 --> 00:03:08,140
!المَجلّة الأُسطوريّة التي تُباع بالكامل في يومٍ وَاحد؟

26
00:03:08,780 --> 00:03:09,500
.نعم

27
00:03:10,300 --> 00:03:12,630
.يجدُر بي الذّكر بأنّ هذه النّسخة غير خاضعةٍ للرّقابة

28
00:03:14,060 --> 00:03:17,220
...غير خاضعةٍ للرّقابة

29
00:03:22,540 --> 00:03:24,060
هل أنتَ وَاثقٌ من هذا؟

30
00:03:24,060 --> 00:03:26,310
.أعني، أنتَ مُدير الأكاديميّة

31
00:03:26,720 --> 00:03:29,600
هل يجدُر بكَ امتلاك شيءٍ كهذا حتّى؟

32
00:03:29,980 --> 00:03:32,230
.أوه، لكنّني شيطانٌ أيضاً

33
00:03:32,230 --> 00:03:34,060
!سأتبعكَ حتّى يوم مماتي

34
00:03:34,600 --> 00:03:38,420
أفهم بأنّكَ قبلتَ المُهمّة إذاً؟

35
00:03:38,420 --> 00:03:39,530
!بالتّأكيد

36
00:03:44,820 --> 00:03:45,990
!شيما

37
00:03:46,400 --> 00:03:47,320
.إلى هُنا

38
00:03:49,920 --> 00:03:52,940
.لَدينا مُهمّة تطهيرٍ اليوم

39
00:03:52,940 --> 00:03:54,320
تطهير؟

40
00:03:56,600 --> 00:04:01,050
!ما هذا؟! يبدو كخلفيّة فِلم رُعب

41
00:04:01,740 --> 00:04:05,680
،كان مِلكاً لشركة وَجباتٍ خفيفة

42
00:04:06,440 --> 00:04:11,500
لكن تقاتلَ أفراد عائلة المالِك بوَحشيّةٍ لتحديد من سيرثه

43
00:04:11,500 --> 00:04:13,440
.حتّى نجمَ من ذلك العديد من الوَفيّات

44
00:04:14,280 --> 00:04:16,140
.أفلَسَت الشّركة بعدها

45
00:04:16,140 --> 00:04:23,700
.تمّ إغلاق المَصانع، لكن مازالَت تُوجد شائعاتٌ بظُهور أشباحٍ في المَساء

46
00:04:24,360 --> 00:04:30,680
إذاً تقول بأنّ أشباح من ماتوا بتلك القِتالات هُنا؟

47
00:04:31,360 --> 00:04:32,540
.كلّا

48
00:04:32,540 --> 00:04:36,330
.لَم نجِد أيّ أشباحٍ عندما تحقّقنا من المَبنى

49
00:04:36,720 --> 00:04:40,380
.ما وَجدناه كان تفشّياً للكول تار

50
00:04:40,380 --> 00:04:42,540
.لابدّ من أنّ أحدهم قد أخطأ باعتبارهم أشباحاً

51
00:04:42,540 --> 00:04:44,260
أوه، هذا فقط؟

52
00:04:44,260 --> 00:04:47,680
.بسبب تلك الشّائعات، لا يُباع المَبنى

53
00:04:48,460 --> 00:04:52,440
،لكن مُؤخّراً فقط، أصبح المُدير العامّ لشركة ترفيهٍ مُهتمّاً به

54
00:04:52,440 --> 00:04:56,560
.لذا تمّ توكيلنا بمُهمّة تطهير المَبنى

55
00:04:56,860 --> 00:05:02,160
!هواه، أشعر كما لَو أنّني صائد أشباحٍ بهذا الشّيء

56
00:05:02,160 --> 00:05:06,320
لكن سينساي، ألَيس الكول تار هُم الأضعف من بين الشّياطين؟

57
00:05:06,900 --> 00:05:11,260
.كلّ ما يفعلونه هو الطّفو في الأرجاء، و لا يُمكن لمُعظم البَشر رُؤيتهم حتّى

58
00:05:11,910 --> 00:05:16,100
!لَيسوا مُؤذين على الإطلاق إلّا إن اندمجَت مجموعةٌ منهم معاً

59
00:05:16,100 --> 00:05:18,380
.هذا صحيح، لكن المنطقة تحوي على عددٍ كبيرٍ منهم

60
00:05:18,880 --> 00:05:24,080
.لرُبّما اندمجَ بعضهم ليتحوّلوا إلى كوكس بالفِعل، لذا أنا من سيعتني بأمرهم

61
00:05:24,080 --> 00:05:25,760
...لَحظة، إذاً ماذا سأفعل

62
00:05:26,060 --> 00:05:28,760
.ستصدّ التشوتشي

63
00:05:29,140 --> 00:05:31,360
أوه، هل يُمكنكَ إعادة هذا؟

64
00:05:31,360 --> 00:05:32,360
.التشوتشي

65
00:05:35,420 --> 00:05:38,690
!هل تعني أولئكَ التشوتشي؟

66
00:05:39,040 --> 00:05:43,120
،لَن يُوجد الكثير منهم، لكن يُمكن أيضاً أن يحملوا صراصير

67
00:05:43,120 --> 00:05:44,940
.لذا تأكّد من الإعتناء بأمرهم أيضاً

68
00:05:46,720 --> 00:05:51,370
.أصابَني ألَمٌ بالمَعِدة للتّوّ، لذا لَن أُشارك بهذا

69
00:05:51,800 --> 00:05:53,960
.أعتذر، لكن لا يُمكنني السّماح بهذا

70
00:05:53,960 --> 00:05:58,200
!لماذا؟ يُمكنكَ فِعل هذا بنفسك

71
00:05:58,200 --> 00:06:00,250
!أتوَسّل إليك، أفلِتني

72
00:06:00,250 --> 00:06:04,860
.السيّد فيليس هو من أرادكَ أن تتعامل مع التشوتشي

73
00:06:05,800 --> 00:06:08,900
.أخبرَني أيضاً بأن أُوقِفكَ عن الهرَب خلال المُهمّة

74
00:06:08,900 --> 00:06:12,560
،قال إن تعاطفتُ معكَ و سمحتُ لكَ بالمُغادرة

75
00:06:12,560 --> 00:06:14,810
.سيخصم 90% من راتبي

76
00:06:14,810 --> 00:06:17,980
ماذا، 90%؟ هل هذا قانونيّ؟

77
00:06:17,980 --> 00:06:22,190
!أيضاً، ما الأهمّ، النّقود أم تِلميذكَ الظّريف؟

78
00:06:22,900 --> 00:06:28,420
."أعتذر، لكنّني سأُعاني من وَقتٍ عصيبٍ جدّاً بالتّفكير بأنّكَ "ظريف

79
00:06:29,680 --> 00:06:32,240
.و لَديّ فواتير لأدفعها

80
00:06:33,960 --> 00:06:36,280
!أوكومورا سينساي، أنتَ شيطان

81
00:06:36,280 --> 00:06:38,460
!سألعنكَ حتّى يوم مماتي

82
00:06:38,460 --> 00:06:40,560
و سأُخبِر جميع مُعجباتكَ الشّغوفات

83
00:06:40,560 --> 00:06:46,720
!مجموعة كذِباتٍ بأنّكَ شرّيرٌ جدّاً و لَديكَ الكثير من التّخيّلات المُنحرفة

84
00:06:49,590 --> 00:06:53,600
!كلّا! توَقّف! لَم أعني ما قُلت

85
00:06:53,600 --> 00:06:55,220
!ساعدوني

86
00:06:58,980 --> 00:07:00,650
كيف كان الأمر؟

87
00:07:03,020 --> 00:07:09,570
.حسناً، تعلّمتُ على الأقلّ ألّا أُغضِب أوكومورا سينساي

88
00:07:10,140 --> 00:07:11,530
ذلك الرّجل

89
00:07:12,040 --> 00:07:13,640
،ساديّ

90
00:07:12,360 --> 00:07:13,640
.إنزل إلى هناك

91
00:07:13,640 --> 00:07:14,920
،شيطان

92
00:07:14,920 --> 00:07:16,450
!و مَخبولٌ بنفس الوَقت

93
00:07:17,200 --> 00:07:18,900
.يا إلهي

94
00:07:18,900 --> 00:07:22,790
.حسناً، هذا جيّدٌ بما يكفي لاعتباره نجاحاً بمُهمّتكَ الأُولى

95
00:07:22,790 --> 00:07:24,240
حقّاً؟

96
00:07:24,240 --> 00:07:25,250
.نعم

97
00:07:25,250 --> 00:07:27,720
.إلى المُهمّة التّالية

98
00:07:27,720 --> 00:07:30,100
،يجب أن يتمكّن الجّواسيس من التّأقلُم مع أيّ مُحيط

99
00:07:30,100 --> 00:07:33,220
.الإمتزاج معه بشكلٍ طبيعيٍّ كما الهواء

100
00:07:33,700 --> 00:07:38,260
.ستُكلّف في النّهاية بمُهمّةٍ شديدة الأهمّيّة

101
00:07:38,260 --> 00:07:43,350
.يُمكنني أن أُؤكّد لكَ بأنّ هذه المهارة ستُثبت أهمّيّتها عندما يحين الوَقت

102
00:07:43,660 --> 00:07:45,220
التّكيّف كيف؟

103
00:07:45,220 --> 00:07:47,610
.إسمح لي بأن أُريك

104
00:07:50,680 --> 00:07:52,540
.بعدك

105
00:07:53,480 --> 00:07:56,200
إلى أين يُوصِل ذلك المِفتاح؟

106
00:07:57,220 --> 00:07:59,200
لِمَ لا ترى بنفسك؟

107
00:08:09,020 --> 00:08:14,390
ألَيس هذا المَسكن الذي يعيش فيه الأخوَان أوكومورا؟

108
00:08:14,780 --> 00:08:16,740
!دينغ دينغ دينغ

109
00:08:16,740 --> 00:08:19,960
.هذا مِفتاح مَسكن الصّبيان الأكبر

110
00:08:19,960 --> 00:08:21,480
لِمَ نحن هُنا مع ذلك؟

111
00:08:21,480 --> 00:08:23,980
،ستدخل قاعة الطّعام

112
00:08:23,980 --> 00:08:28,140
،تأكل عشاء أوكومورا سينساي بشكلٍ طبيعيٍّ كما لَو كان عشاءك

113
00:08:28,140 --> 00:08:30,900
.و بعدها تتمَخطر خارجاً مُباشرةً كما لَو أنّ شيئاً لَم يحصل

114
00:08:32,220 --> 00:08:34,360
.هذا سيختتم مُهمّتكَ الثّانية

115
00:08:34,360 --> 00:08:36,120
!مُستحيل

116
00:08:39,460 --> 00:08:41,040
!من المُستحيل أن أتمكّن من فِعل هذا

117
00:08:41,040 --> 00:08:42,580
.لا تقلَق

118
00:08:43,120 --> 00:08:47,920
،أعطيتُ أوكومورا سينساي بعض المُهمّات الصّعبة بشكلٍ لا يُمكن تصوّره مُسبقاً

119
00:08:47,920 --> 00:08:49,840
.لذا سيكون في الخارج لفترةٍ طويلة

120
00:08:49,840 --> 00:08:52,970
!صعبةٌ بشكلٍ لا يُمكن تصوّره؟ هذا يجعل الأمر أسوأ حتّى

121
00:08:53,260 --> 00:08:58,200
!تخيّل العودة للمنزل بعد مثل ذلك اليوم و تجد شخصاً آخر يأكل عشاءك

122
00:08:58,200 --> 00:09:01,350
!حتّى قِدّيسٌ لَن يتسامح مع هذا

123
00:09:01,640 --> 00:09:03,400
.ستكون بخير

124
00:09:03,400 --> 00:09:06,080
.أوكومورا سينساي طيّب القلب كثيراً

125
00:09:06,080 --> 00:09:08,270
.وَاثقٌ من أنّه سيضحك على هذا ببساطة

126
00:09:08,270 --> 00:09:12,400
!كلّا، كلّا! لا تقُل هذا كما لَو كنتَ تعرف طبيعته الحقيقيّة

127
00:09:12,400 --> 00:09:17,360
لِمَ يجب عليّ التّصرّف مثل شيطان النوراريهيو على أيّة حال؟

128
00:09:17,360 --> 00:09:19,760
،هذا لَيس تدريباً على التّجسّس

129
00:09:19,760 --> 00:09:21,540
!هذه سرِقةٌ وَاضحةٌ فقط

130
00:09:21,540 --> 00:09:24,120
!هذا ما قد أتوَقّعه من عُضوٍ من الميودا

131
00:09:24,120 --> 00:09:27,290
.مَعرفتكَ بالتّراث الشّعبيّ مُثيرةٌ للإعجاب

132
00:09:27,700 --> 00:09:30,480
.شُكراً، لكن هذا لَيس المَغزى الحقيقيّ

133
00:09:31,240 --> 00:09:33,260
إذاً لَن تُنفّذ المُهمّة؟

134
00:09:33,260 --> 00:09:34,540
.لا فُرصة لذلك

135
00:09:40,040 --> 00:09:43,850
...مجموعة رسمات إمبراطور النّشوَة الغير مَنشورة

136
00:09:47,680 --> 00:09:49,300
.غير خاضعةٍ للرّقابة

137
00:09:49,300 --> 00:09:50,360
...سأفعل

138
00:09:53,080 --> 00:09:55,200
!لا تُخدَع بهذا

139
00:09:55,200 --> 00:09:59,000
!لا يُمكنني السّماح بالتّلاعب بي بتلك السّهولة

140
00:10:01,080 --> 00:10:02,420
!كلّا

141
00:10:02,420 --> 00:10:03,620
!إبقى قويّاً

142
00:10:07,880 --> 00:10:10,040
.كما تشاء

143
00:10:11,880 --> 00:10:13,680
،إن لَم تنجح الجّزرة

144
00:10:13,680 --> 00:10:16,500
.لا خيار لَديّ سوى بإخراج العصا

145
00:10:16,500 --> 00:10:22,010
.في بداية صباح يوم الإثنين، سأبدأ ببيع مجلّة الشّائعات الرّائعة هذه

146
00:10:23,400 --> 00:10:29,480
،تُوجد جميع مُختلَف الشّائعات المُغرِضة عن أوكومورا سينساي هُنا

147
00:10:29,480 --> 00:10:32,720
.مُعظمها سيّئةٌ جدّاً لتُقال جهراً

148
00:10:32,720 --> 00:10:36,740
،إن تمّ نشر شيءٍ كهذا الآن

149
00:10:36,740 --> 00:10:38,740
،أظنّكَ تعلَم ما سيحصل

150
00:10:39,360 --> 00:10:41,740
صحيح، شيما؟

151
00:10:42,580 --> 00:10:44,820
!سألعنكَ حتّى يوم مماتي

152
00:10:44,820 --> 00:10:46,940
و سأُخبِر جميع مُعجباتكَ الشّغوفات

153
00:10:46,940 --> 00:10:52,630
!مجموعة كذِباتٍ بأنّكَ شرّيرٌ جدّاً و لَديكَ الكثير من التّخيّلات المُنحرفة

154
00:10:53,140 --> 00:10:56,630
!سيظنّ بأنّني الجّاني بالتّأكيد

155
00:11:00,540 --> 00:11:02,940
إذاً، هل أعدتّ التّفكير بالأمر؟

156
00:11:03,560 --> 00:11:05,780
.نـ-نعم

157
00:11:05,780 --> 00:11:07,600
.سأفعل هذا

158
00:11:07,600 --> 00:11:11,280
.سآكل عشاءه بسرور

159
00:11:11,280 --> 00:11:13,810
.هذا ما توَقّعتُه

160
00:11:14,220 --> 00:11:16,180
!مَساء الخير

161
00:11:16,180 --> 00:11:18,960
كيف حالك، أوكومورا؟

162
00:11:18,960 --> 00:11:21,570
أوه، شيما. ما المُناسبة؟

163
00:11:21,960 --> 00:11:23,160
هل أنتَ هُنا وَحدك؟

164
00:11:23,160 --> 00:11:25,450
أين سوغورو و كونيكومارو؟

165
00:11:25,450 --> 00:11:28,380
،ذهبَ كونيكو إلى اجتماع نادٍ من نوعٍ ما

166
00:11:28,380 --> 00:11:30,120
.و بون غادر ليتدرّب

167
00:11:30,120 --> 00:11:32,260
.أوه، فهمت

168
00:11:32,260 --> 00:11:35,710
!أوه، يا رجل، الرّائحة لَذيذة

169
00:11:35,710 --> 00:11:37,000
صحيح؟

170
00:11:37,000 --> 00:11:40,240
!حصلتُ على بعض السّمك المُمتاز بنصف السّعر

171
00:11:40,240 --> 00:11:46,180
.لكن بما أنّه لَم يُوجد منه ما يكفي، أضفتُ الأفوكادو كتعبئةٍ من الخُضار

172
00:11:46,180 --> 00:11:50,780
إنتظر، أوكومورا، تعرف بأنّ الأفوكادو فاكهة، صحيح؟

173
00:11:50,780 --> 00:11:52,740
أيّ نوعٍ من الخُضار يحوي بذرةً كبيرة؟

174
00:11:52,740 --> 00:11:55,980
!أوه، ووبس! أرتكب هذا الخطأ دائماً

175
00:11:58,120 --> 00:12:00,640
!هذا أسوأ الأوضاع حقّاً

176
00:12:00,640 --> 00:12:04,300
.إن احتاج لإضافة تعبئةٍ فقط لجعلها وَجبةً كاملة، إذاً لا يُمكن وُجود كمّيّاتٍ إضافيّة

177
00:12:04,300 --> 00:12:09,790
!إن فعلتُ هذا، لَن يكون لَدى أوكومورا سينساي ما يأكله اللّيلة

178
00:12:09,790 --> 00:12:15,280
.أكرَه الإعتراف بهذا، لكنّني تأخّرتُ بالنّوم هذا الصّباح و لَم أقُم بإعداء الغداء ليوكيو

179
00:12:15,280 --> 00:12:19,500
.و كان مَشغولاً جدّاً في الآونة الأخيرة حتّى أنّه لَم يملك الوَقت لشراء الطّعام

180
00:12:19,500 --> 00:12:22,050
.سيكون يتضوّر جوعاً على الأرجح وَقت عودته

181
00:12:22,050 --> 00:12:26,300
.يُصبح غاضباً دائماً عندما يكون جائعاً

182
00:12:26,300 --> 00:12:30,180
لِمَ تُخبرني بهذا الآن؟
!هذا آخر ما قد أرغب بسماعه

183
00:12:31,040 --> 00:12:37,320
.لكن لا أظنّ بأنّ المُدير كان يُخادِع بشأن ما سيفعله لَو تراجعت

184
00:12:37,320 --> 00:12:39,180
...و بعدها سأكون

185
00:12:40,900 --> 00:12:42,260
!لَيس لَديّ خيارٌ آخر

186
00:12:42,260 --> 00:12:43,300
ماذا؟

187
00:12:43,300 --> 00:12:45,120
.كلّا. إنسى الأمر

188
00:12:46,820 --> 00:12:50,950
.حسناً، يُفترض أن أتمكّن من استغلال مَدى سذاجته

189
00:12:51,420 --> 00:12:53,860
!بالفِعل مع ذلك، يبدو هذا لَذيذاً جدّاً

190
00:12:53,860 --> 00:12:56,780
.حتّى الألوان تبدو لَذيذة

191
00:12:56,780 --> 00:13:00,520
هل ستُصبح أفضل طاهٍ في العالَم إضافةً لكونكَ مُعوّذاً؟

192
00:13:00,520 --> 00:13:02,800
!لا أعلَم بشأن ذلك

193
00:13:04,080 --> 00:13:06,820
هاي، شيما، ماذا تفعل؟

194
00:13:06,820 --> 00:13:08,660
.هذا لأجل يوكيو

195
00:13:08,660 --> 00:13:12,140
!أوه، يا رجل، يبدو لَذيذاً جدّاً حتّى أنّ أصابعي تحرّكَت وَحدها

196
00:13:12,140 --> 00:13:13,940
.حسناً، لا تأكله

197
00:13:13,940 --> 00:13:16,960
.إن كنتَ جائعاً جدّاً، سأُعِدّ لكَ بعضاً من الرّامين الفوريّ

198
00:13:16,960 --> 00:13:18,730
.حسناً، كما تشاء

199
00:13:19,280 --> 00:13:22,360
.كلّا، لا يُمكنني التّراجع الآن

200
00:13:22,360 --> 00:13:23,190
!لا يُمكنني

201
00:13:23,680 --> 00:13:27,120
.أنتَ مُذهلٌ بالفِعل، أوكومورا

202
00:13:27,120 --> 00:13:30,600
!إن عرف الجّميع مَدى براعتكَ في الطّهو، وَاثقٌ من أنّ الفتيات سيُلاحقنك

203
00:13:30,600 --> 00:13:31,360
هل تظنّ؟

204
00:13:31,360 --> 00:13:32,410
!نعم، بالتّأكيد

205
00:13:32,860 --> 00:13:37,370
.أوه، لكن خدَعَني يوكيو بقول هذا مرّة

206
00:13:37,860 --> 00:13:42,590
.على الأقلّ عرفتُ بأنّ العمل الجادّ لا يجعل منكَ مَحبوباً

207
00:13:42,590 --> 00:13:44,800
.أنا جادّ، لا تأكل ذلك

208
00:13:44,800 --> 00:13:47,060
.يكون مُخيفاً و هو غاضب

209
00:13:47,060 --> 00:13:48,800
!أعلَم، أعلَم

210
00:13:49,220 --> 00:13:54,270
لكن أوكومورا، أصبحتَ أفضل بالطّهو منذ وَقتها، صحيح؟

211
00:13:54,540 --> 00:13:56,940
.حسناً، نعم، هذا وَاضح

212
00:13:56,940 --> 00:13:59,880
.و بالتّفكير بالأمر الآن، أنتَ وَسيمٌ أيضاً

213
00:13:59,880 --> 00:14:02,380
أتسائل إن كنتَ ستحصل على نادٍ للمُعجبات قريباً؟

214
00:14:02,380 --> 00:14:03,650
نادٍ للمُعجبات؟

215
00:14:03,650 --> 00:14:06,840
!واو، هذا سيكون رائعاً جدّاً

216
00:14:06,840 --> 00:14:09,620
!يُمكنني أخيراً الحصول على دوري تحت الأضواء

217
00:14:10,540 --> 00:14:15,020
!الفتيات... الإفتتان... الطّعام المَجّانيّ

218
00:14:15,020 --> 00:14:17,500
!أوه، يا رجل! هذا سيكون عظيماً جدّاً

219
00:14:17,500 --> 00:14:18,820
!هيّا، أكثر قليلاً فقط

220
00:14:18,820 --> 00:14:21,960
!أحتاج لأن أخرُج من هُنا قبل عودة أوكومورا سينساي

221
00:14:21,960 --> 00:14:26,620
...نادٍ للمُعجبات لأجلي، مع ذلك
!لَن يحصل هذا أبداً

222
00:14:26,620 --> 00:14:30,090
!لا تقُل هذا، أوكومورا
!فلتملك بعض الثّقة بنفسك

223
00:14:30,090 --> 00:14:31,360
!أنتَ مُحقّ

224
00:14:31,360 --> 00:14:33,800
نوادي المُعجبات يقُمنَ بإعداد أحداث، صحيح؟

225
00:14:33,800 --> 00:14:36,890
!الأحداث تحوي مُوسيقى، و رقصٌ أحياناً حتّى

226
00:14:36,890 --> 00:14:40,850
.أوه، شيما، لَدينا معالق إن أردتّ
.و سأعدّ لكَ بعض الشّاي

227
00:14:40,850 --> 00:14:44,980
.أوه، لا تُزعج نفسك. إنتهيتُ بالفِعل

228
00:14:44,980 --> 00:14:46,320
إنتهيتَ من ماذا؟

229
00:14:46,600 --> 00:14:49,400
...كما قُلت، إنتهيتُ من أكل

230
00:14:52,960 --> 00:14:57,520
لِمَ تجلِس في مقعدي و تأكل عشائي؟

231
00:14:57,520 --> 00:15:01,020
.لَديكَ تفسيرٌ مَنطقيٌّ لأجلي بالتّأكيد

232
00:15:02,140 --> 00:15:05,500
.إنّها قِصّةٌ طويلة

233
00:15:06,900 --> 00:15:08,220
.دعني أسمعها

234
00:15:08,700 --> 00:15:12,090
.أخشى بأنّه لا يُمكنني إخبارك

235
00:15:12,980 --> 00:15:20,980
لكن ألَن تُسامح تِلميذكَ الظّريف على مزحته البريئة؟

236
00:15:21,280 --> 00:15:22,220
ماذا؟

237
00:15:29,500 --> 00:15:31,820
.عملٌ رائعٌ البارحة

238
00:15:32,180 --> 00:15:34,910
إذاً، كيف جرى الأمر؟

239
00:15:35,820 --> 00:15:41,640
.أجبرَني على الجّلوس و باريون فوق ساقاي لساعتين

240
00:15:41,640 --> 00:15:45,340
.و عندما انتهى هذا، صرخ عليّ لساعةٍ أُخرى

241
00:15:45,340 --> 00:15:46,940
.كم هذا مُثيرٌ للإهتمام

242
00:15:46,940 --> 00:15:52,050
.أظنّ بأنّ أوكومورا سينساي يحمل حِقداً عندما يُهدّد طعامه

243
00:15:52,540 --> 00:15:56,160
إذاً، ما رأيكَ بطبق أرزّ أوكومورا؟

244
00:15:56,160 --> 00:15:58,020
.كان لَذيذاً لدرجة أنّني بكيت

245
00:15:59,520 --> 00:16:01,500
.حسناً

246
00:16:01,500 --> 00:16:05,610
.عانيتَ من وَقتٍ عصيب، لذا سأُعطيكَ درجة النّجاح

247
00:16:05,610 --> 00:16:10,120
إذاً، هل يُمكنني الحصول على مجموعة رسمات إمبراطور النّشوَة الغير مَنشورة؟

248
00:16:10,120 --> 00:16:13,570
.ستكون لكَ بعد إنجازكَ لمُهمّةٍ أخيرة

249
00:16:13,570 --> 00:16:14,540
!شُكراً، أيّها السيّد

250
00:16:14,540 --> 00:16:15,320
.أنا شيطان

251
00:16:15,320 --> 00:16:17,500
!سأتبعكَ حتّى يوم مماتي

252
00:16:17,500 --> 00:16:19,500
هذا ثانيةً؟

253
00:16:20,340 --> 00:16:22,840
.حسناً، إلى المُهمّة الأخيرة

254
00:16:22,840 --> 00:16:27,540
.لاختبار مهاراتكَ بالتّنكّر و الإنسلال، سأجعلكَ تتسلّل إلى مَسكن الفتيات

255
00:16:28,040 --> 00:16:32,380
،إن أمكنكَ دخول المَبنى دون اكتشاف هويّتك

256
00:16:32,380 --> 00:16:34,100
،سأعتبر بأنّ المُهمّة قد أُنجِزَت

257
00:16:34,100 --> 00:16:36,500
.و ستكون المجلّة لك

258
00:16:37,920 --> 00:16:40,100
!عُلِم

259
00:16:42,480 --> 00:16:44,120
!أخيراً

260
00:16:44,120 --> 00:16:46,690
!سأحصل على مُهمّة تجسّسٍ حقيقيّةٍ أخيراً

261
00:16:47,380 --> 00:16:51,240
!هذا هو العالَم المُتحرّر الذي كنتُ بانتظاره

262
00:16:51,800 --> 00:16:57,120
!دون ذِكر حصولي على إذن المُدير لدخول مَسكن الفتيات

263
00:16:57,120 --> 00:16:59,080
!هذا أفضل من أن يكون حقيقة

264
00:17:04,440 --> 00:17:07,400
.لَن أخدَع أحداً هكذا

265
00:17:07,400 --> 00:17:08,660
.كلّا، لَحظة

266
00:17:08,660 --> 00:17:11,500
!الشّكّ بنفسي سيجعلني أكثر بُروزاً حتّى

267
00:17:11,500 --> 00:17:13,980
.إن تصرّفتُ بشكلٍ طبيعيٍّ فقط، ستكون هناك إمكانيّةٌ للنّجاح

268
00:17:13,980 --> 00:17:15,580
!كلّا، سأجعله ينجح

269
00:17:15,580 --> 00:17:18,010
!كرجلٍ حقيقيّ

270
00:17:19,360 --> 00:17:22,980
.أعتذر لاستدعاءكما في يوم عُطلَتكما

271
00:17:22,980 --> 00:17:26,120
.لا بأس. لا تقلَق بشأن هذا

272
00:17:26,120 --> 00:17:31,190
.لابدّ من أنّكَ جادٌّ جدّاً لتمضية يوم عُطلتكَ لدراسة كتابة الكانجي المُتّصلة

273
00:17:31,190 --> 00:17:32,180
.هذا لا شيء

274
00:17:32,180 --> 00:17:34,720
،حصلتُ على نَصٍّ مُثيرٍ للإهتمام في الآونة الأخيرة

275
00:17:34,720 --> 00:17:37,660
.لكنّه مَكتوبٌ بكانجي مُتّصلٍ بشكلٍ حُرٍّ جدّاً

276
00:17:37,660 --> 00:17:42,120
.أه، نعم، يُمكنني تفهّم كيف يُمكن أن تكون قِراءتها صعبةً إن لَم تكُن مُعتاداً عليها

277
00:17:42,740 --> 00:17:45,680
،أخبرَني السيّد فيليس بأنّه يُفترض أن تكونا مُتمكّنان جيّداً فيها

278
00:17:45,680 --> 00:17:49,060
.بما أنّكما من المَعبد

279
00:17:49,060 --> 00:17:52,360
!أتيتَ للأشخاص الصّحيحين
.لَدينا كِتابٌ عنها

280
00:17:52,360 --> 00:17:54,460
.يُفترض أن يكون في غُرفة شيما

281
00:17:54,980 --> 00:17:56,930
!هيّا

282
00:18:04,100 --> 00:18:06,060
هاه؟

283
00:18:07,160 --> 00:18:11,190
.شيما... لَم أعلَم بأنّكَ مُهتمٌّ بهذه الأشياء

284
00:18:11,190 --> 00:18:13,260
!لَحظة، كونيكو، الأمر لَيس كما يبدو

285
00:18:13,260 --> 00:18:14,100
...أنت

286
00:18:14,100 --> 00:18:16,700
!أنتَ أيضاً، بون؟ دعاني أُفسّر الأمر

287
00:18:17,660 --> 00:18:19,320
.إهدأ

288
00:18:19,320 --> 00:18:21,160
.دَعه يُفسّر الأمر

289
00:18:21,820 --> 00:18:24,760
ألَديكَ سببٌ ما لارتداء هذا الزيّ؟

290
00:18:26,340 --> 00:18:29,860
أوكومورا سينساي؟

291
00:18:32,220 --> 00:18:35,300
هل كنتَ تُخطّط لفِعل شيءٍ بغيض؟

292
00:18:37,010 --> 00:18:40,260
...كلّا! إحتجتُ فقط للذّهاب إلى مَكسن الفتيات

293
00:18:44,420 --> 00:18:46,180
.حسناً، سعيدٌ لاعترافكَ بهذا

294
00:18:47,080 --> 00:18:50,400
إرتداء ملابس الفتيات بنيّة التّسلّل إلى مَسكن الفتيات

295
00:18:50,400 --> 00:18:52,780
.هي جريمةٌ بالتّأكيد

296
00:18:52,780 --> 00:18:54,900
.شيما، أنتَ حقير

297
00:18:54,900 --> 00:18:56,040
...أنتَ

298
00:18:56,040 --> 00:18:57,620
.لَستَ مُخطئاً

299
00:18:57,620 --> 00:18:59,780
!لكن هذا لَيس ما تظنّونه! صدّقوني

300
00:19:01,020 --> 00:19:04,300
.إتّصل بالشّرطة، يجب أن يتمّ احتجازه

301
00:19:05,080 --> 00:19:06,320
.حسناً

302
00:19:06,320 --> 00:19:08,790
هذا لمَصلَحته، صحيح؟

303
00:19:09,060 --> 00:19:11,300
ما الذي تتحدّثان عنه؟

304
00:19:11,300 --> 00:19:13,290
أنتُما تمزحان، صحيح؟

305
00:19:14,360 --> 00:19:15,550
!أعتذر بشدّة، شيما

306
00:19:15,550 --> 00:19:17,780
!لا تتّصل بهم حقّاً

307
00:19:17,780 --> 00:19:20,040
!لا حاجة للمُبالغة بردّ فِعلكم

308
00:19:20,040 --> 00:19:21,300
!أعتذر بشدّة

309
00:19:21,300 --> 00:19:25,760
!لذا أرجوكَ أغلِق الهاتف، كونيكو

310
00:19:30,220 --> 00:19:32,230
بـ-بون؟

311
00:19:32,230 --> 00:19:35,480
.قِف، شيما

312
00:19:35,480 --> 00:19:38,650
.سأضربكَ حتّى تعود لصوابك

313
00:19:40,880 --> 00:19:42,860
!لا تفعل! ستقتُلني

314
00:19:42,860 --> 00:19:45,410
!سأموت قبل أن أتعلّم درسي

315
00:19:45,780 --> 00:19:47,360
،لا تقلَق

316
00:19:47,360 --> 00:19:49,870
.حالما أنتهي منك، سأتبعكَ مُباشرةً

317
00:19:49,870 --> 00:19:53,640
!هذا يجعل الأمر أكثر إقلاقاً حتّى
هل يُمكنكَ أن تهدأ رجاءً؟

318
00:19:53,640 --> 00:19:56,320
!يُوجد بالأمر أكثر ممّا تراه

319
00:19:56,320 --> 00:20:00,880
هل تظنّون حقّاً بأنّني قد أفعل مثل هذا الشّيء؟

320
00:20:01,400 --> 00:20:02,760
.نعم.                             -نعم-
.نعم-

321
00:20:03,140 --> 00:20:06,470
!أيّها الوُحوش! لا يُمكنني تصديق هذا

322
00:20:07,040 --> 00:20:10,320
أيّ كلِماتٍ أخيرةٍ أُخرى؟

323
00:20:16,540 --> 00:20:17,730
...ما

324
00:20:17,730 --> 00:20:20,740
!ماذا؟

325
00:20:22,040 --> 00:20:26,450
مجموعة رسمات إمبراطور النّشوَة الغير مَنشورة و الغير خاضعةٍ للرّقابة؟

326
00:20:27,020 --> 00:20:30,580
.شيما، أنتَ بصِدقٍ أسوأ شخصٍ قابلتُه في حياتي

327
00:20:30,580 --> 00:20:33,900
...كلّا، لَحظة! هذا فقط

328
00:20:37,820 --> 00:20:42,420
.قِراءة هذه المجلّات البذيئة هو ما أفسد عقلكَ هكذا

329
00:20:43,240 --> 00:20:45,220
!يجب أن تخجل من نفسك

330
00:20:52,140 --> 00:20:56,020
.تبدو سعيداً، أخي

331
00:20:56,500 --> 00:20:58,320
حقّاً؟

332
00:20:58,320 --> 00:20:59,230
.نعم

333
00:20:59,230 --> 00:21:03,560
.لابدّ من أنّ السّبب هو اكتشافي لماسّةٍ غير مَصقولة

334
00:21:03,560 --> 00:21:05,320
هل تعني رينزو شيما ذاك؟

335
00:21:06,200 --> 00:21:09,530
ظننتُه فشل بجميع المُهمّات التي أعطيتَها له؟

336
00:21:10,480 --> 00:21:14,520
.لَم يُوجد أيّ مَعنىً حقيقيٍّ خلف المُهمّات التي أعطيتُها له

337
00:21:14,520 --> 00:21:19,290
.أردتّ فقط اكتشاف إن كان مُلائماً للعمل كجاسوسي الخاصّ

338
00:21:19,920 --> 00:21:23,120
.و ظهرَ بأنّه مِثاليٌّ لهذا

339
00:21:24,100 --> 00:21:26,800
.يبدو بالنّسبة لي كغبيٍّ عاديّ

340
00:21:27,740 --> 00:21:29,760
.أنتَ ساذج، أخي الصّغير

341
00:21:30,760 --> 00:21:35,480
،هو وَفيٌّ لرَغباته الخاصّة الجّشعة فقط

342
00:21:35,480 --> 00:21:39,140
،ممّا يجعله بَشريّاً ضعيفاً و سطحيّاً

343
00:21:39,140 --> 00:21:41,960
.مع ذلك لا يخشاني على الإطلاق

344
00:21:41,960 --> 00:21:48,870
.لا يهمّه التّذلّل لأصحاب السّلطة، لذا لَن يتمّ غسل دِماغه بسهولة

345
00:21:49,280 --> 00:21:53,330
.هو بالفِعل شيءٌ مُثيرٌ للإهتمام و مُفيد

346
00:21:54,280 --> 00:22:01,080
،لا أبحث عن جُنديٍّ سيُضحّي بنفسه لزرع مَعلوماتٍ خاطئةٍ مرّة

347
00:22:01,080 --> 00:22:04,300
.بل بالأحرى جاسوسٌ يُمكنه إبلاغي بما يحصل للعديد من المرّات

348
00:22:05,080 --> 00:22:07,040
هل تفهم، أمايمون؟

349
00:22:08,140 --> 00:22:13,500
.لَيس تماماً، لكن إفعل ما تشاء

350
00:22:19,120 --> 00:22:23,700
.سأتأكّد من إنشاءكَ بعِناية