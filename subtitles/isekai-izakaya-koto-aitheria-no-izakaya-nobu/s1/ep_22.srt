1
00:00:09,490 --> 00:00:11,760
هذا إيزاكايا نوبو

2
00:00:12,360 --> 00:00:16,490
إنه إيزاكايا عادي، لكن هناك شيء استثنائي واحد

3
00:00:13,060 --> 00:00:14,990
(نوبوياكي يازاوا (32
"مالك الإيزاكايا "نوبو

4
00:00:18,000 --> 00:00:24,600
!يُفتح بابنا الأمامي على كونٍ مُوازٍ

5
00:00:18,060 --> 00:00:20,000
(شينوبو سينكي (23
"نادلة في الإيزاكايا "نوبو

6
00:00:38,680 --> 00:00:41,290
شينوبو-تشان، تجمّدتِ

7
00:00:41,290 --> 00:00:44,420
هل من مشكلة؟ هذا ليس من طباعكِ

8
00:00:45,960 --> 00:00:49,020
أنا سعيدة حقّاً أنّ نوبو لم تعانِ

9
00:00:49,020 --> 00:00:51,370
،من أي أضرار من تلك القضيّة

10
00:00:51,370 --> 00:00:55,420
...لكن أنا غير راضية تماماً أو شيء من هذا القبيل

11
00:00:55,420 --> 00:00:58,820
هذا طبيعي، فالأمور دائماً عِرضة للتغيير

12
00:00:58,820 --> 00:01:01,050
نعم، هذا ما أظنّه

13
00:01:01,820 --> 00:01:04,930
،أفشِلَتْ خطّة باكيشوف

14
00:01:04,040 --> 00:01:08,050
غيرنوت (37)
جابي ضرائب
مدينة أيتيريا القديمة

15
00:01:04,930 --> 00:01:08,050
لكن هذا لا يغيّر من حقيقة أنّ اللاغر
هو بضاعة محظورة

16
00:01:08,050 --> 00:01:12,820
ينبغي على الأرجح أن تكفّوا طوعاً عن
تقديم أي شيء صنبور لبعض الوقت

17
00:01:13,300 --> 00:01:17,020
وكالعادة، أريد ثلاثة بينتو أنقليص

18
00:01:20,730 --> 00:01:23,140
،أكره فعل هذا لزبائننا

19
00:01:23,140 --> 00:01:25,400
لكن نحن مضطرّون للتوقّف عن تقديم
البيرة لبعض الوقت

20
00:01:26,200 --> 00:01:27,620
!أهلاً وسهلاً

21
00:01:27,700 --> 00:01:28,190
!مرحباً

22
00:01:28,200 --> 00:01:30,200
الإمبراطور السّابق (78)
إمبراطور الإمبراطوريّة السابق

23
00:01:28,200 --> 00:01:30,200
يوهان غوستاف (30)
كونت بادينبورغ

24
00:01:28,590 --> 00:01:30,190
!يوهان-سان

25
00:01:30,190 --> 00:01:33,080
مضى وقت طويل. تفضّلا بالجلوس

26
00:01:33,450 --> 00:01:36,070
إنّه فارغ على نحو غير معهود اليوم

27
00:01:36,070 --> 00:01:41,580
يبدو أنّ الاجتماع الضخم المقبل سيضع
المدينة بأكملها على المحكّ

28
00:01:41,920 --> 00:01:43,550
ربّما هذا هو السبب

29
00:01:43,550 --> 00:01:45,290
هكذا إذاً

30
00:01:45,290 --> 00:01:47,580
هذا فظيع حقّاً بالنسبة إلى حانة

31
00:01:47,580 --> 00:01:51,080
حسناً، سنستفيد من هذا لتوفير
أفضل خدمة لك

32
00:01:51,710 --> 00:01:53,230
تفضّل منديلك اليدوي

33
00:01:54,900 --> 00:01:57,730
إنّه جميل وبارد

34
00:01:58,100 --> 00:02:00,510
في آخر مرّة كنتُ فيها هنا كان دافئاً

35
00:02:00,510 --> 00:02:02,650
تغيّرونه بحسب الموسم، صحيح؟

36
00:02:02,650 --> 00:02:04,560
الجوّ حرٌّ في الخارج

37
00:02:04,560 --> 00:02:06,300
تفضّلا طعامكما الخفيف

38
00:02:06,300 --> 00:02:07,090
ما هذا؟

39
00:02:07,110 --> 00:02:09,610
نانبانزوكي إسقمري صغير

40
00:02:07,110 --> 00:02:09,610
السّمك المخلّل شهيّ وصولاً للعِظام الصّالحة
للأكل! الفليفلة الحارّة تمنحه لدعة جيّدة

41
00:02:07,680 --> 00:02:09,600
إنّه نانبانزوكي يُحضَّر مع سمك إسقمري صغير

42
00:02:09,960 --> 00:02:11,600
،يُقلى الإسقمري أوّلاً

43
00:02:11,600 --> 00:02:14,460
ومن ثمّ يُخلَّل بخلطة تنكيه حلوة
وحامضة، ومن ثمّ يُترَك جانباً ليبرد

44
00:02:14,460 --> 00:02:17,390
إنّه ممتاز في هذا الطقس الحارّ

45
00:02:23,390 --> 00:02:25,620
رائع

46
00:02:25,830 --> 00:02:27,900
هذا لذيذ حقّاً يا يوهان

47
00:02:27,900 --> 00:02:29,680
نعم يا جدّي

48
00:02:29,680 --> 00:02:32,360
الحموضة تساهم في تحفيز الشهيّة

49
00:02:32,360 --> 00:02:33,750
التي تكون منخفضة في الصّيف
الحارّ في العادة

50
00:02:33,750 --> 00:02:38,300
في البداية ظننتُ أنّ تخليل شيء مقليّ
،هو ضرب من الحماقة

51
00:02:38,300 --> 00:02:41,000
لكن أعتقد أنّ تبريده يسمح للزيت
،والحمض بالاختلاط

52
00:02:41,000 --> 00:02:43,390
مشكّلاً حموضة رقيقة وناعمة

53
00:02:43,390 --> 00:02:46,830
لكن أعتقد أنّ هذا البهار الحارّ الخفي هو ما

54
00:02:46,830 --> 00:02:49,270
يجعل الطبق كلّه متماسكاً؟

55
00:02:49,270 --> 00:02:50,670
معك حقّ

56
00:02:50,670 --> 00:02:53,560
إنّها فليفلة حارّة نطلق عليها
بمخلب الصقر

57
00:02:53,560 --> 00:02:55,720
مخلب الصقر؟

58
00:02:55,720 --> 00:02:58,350
يبدو ذلك كبهار جدير بما يكفي لك يا جدّي

59
00:02:58,350 --> 00:03:00,400
قد يكون هذا نذيراً بحظٍّ سعيد

60
00:03:00,940 --> 00:03:02,940
،بالمناسبة يا آنسة

61
00:03:02,940 --> 00:03:08,000
يبدو أنّ هذا الطبق لذيذ جدّاً حتّى
من دون مشروب

62
00:03:08,000 --> 00:03:10,330
حسناً، هل تودّ مشروباً؟

63
00:03:10,330 --> 00:03:12,390
ماذا كان يُدعى؟

64
00:03:12,390 --> 00:03:15,850
حنفة؟ لا، أيل؟

65
00:03:15,850 --> 00:03:17,810
هل لديكم بيرة بهذا الاسم؟

66
00:03:18,410 --> 00:03:20,830
تقصد شيء الصنبور

67
00:03:20,830 --> 00:03:24,670
أنا آسفة حقّاً، نظراً لظروف معيّنة، نحن
لا نقدّمه الآن

68
00:03:24,670 --> 00:03:27,490
ألا تستطيعون أن تجعلوني استثناء؟

69
00:03:27,490 --> 00:03:29,820
أتيتُ إلى هنا لأجله

70
00:03:29,820 --> 00:03:32,840
سمعنا بالضجّة التي أثارها باكيشوف

71
00:03:33,240 --> 00:03:38,270
لكن ألن يكون من المُمكن تلبية جدّي
الذي سافر كلّ هذه المسافة البعيدة؟

72
00:03:38,270 --> 00:03:39,600
عُلِم

73
00:03:39,600 --> 00:03:40,830
تايشو؟

74
00:03:40,830 --> 00:03:43,790
،شينوبو-تشان، فكّرتُ في الأمر

75
00:03:43,790 --> 00:03:46,510
لكن أريد من زبائننا أن يستمتعوا فحسب

76
00:03:51,120 --> 00:03:56,870
تفضّلا، بيرة البرميل التي طلبتماها

77
00:03:58,220 --> 00:04:02,500
هذه. هذه هي. من دونها فلا يُعتبَر
!هذا إيزاكايا نوبو

78
00:04:02,500 --> 00:04:06,990
كان هذا آخر قطعة أرادها قلبي
!كي يشعر بالرّضا

79
00:04:07,390 --> 00:04:10,640
كانت شينوبو-تشان هي أكثر من أرادت
تقديم هذا

80
00:04:10,630 --> 00:04:13,870
شيء الصنبور

81
00:04:10,630 --> 00:04:13,870
إن كان طعمه جيّداً، فكلّ شيء يكون
على ما يُرام حينها

82
00:04:10,640 --> 00:04:13,040
هذا هو شيء الصنبور

83
00:04:13,040 --> 00:04:14,200
حسناً إذاً

84
00:04:16,130 --> 00:04:17,970
فوَران

85
00:04:28,280 --> 00:04:29,880
هذا مضحك للغاية

86
00:04:30,530 --> 00:04:34,270
قلتَ أنّ هناك شخص ادّعى أنّ هذا
لاغر العاصمة الإمبراطوريّة

87
00:04:34,270 --> 00:04:37,660
نعم، سمعتُ أنّه تاجر يُدعى باكيشوف

88
00:04:38,130 --> 00:04:40,880
،لا أعلم ما الذي يعرفه عن اللّاغر

89
00:04:40,880 --> 00:04:43,730
لكن هذا شيء مختلف عن اللّاغر
الذي يأتي من العاصمة

90
00:04:44,400 --> 00:04:46,170
هو أيل إذاً؟

91
00:04:46,170 --> 00:04:49,080
لا، إنه لاغر على الأرجح

92
00:04:49,080 --> 00:04:54,160
لكن اللّاغر الذي يعدّونه في العاصمة
،له مذاق أكثر شموليّة

93
00:04:54,160 --> 00:04:57,900
بينما شيء الصنبور له طعم لاحِق منظِّف

94
00:04:57,900 --> 00:05:00,220
تبدو كخبير

95
00:05:00,220 --> 00:05:02,180
ليس تماماً

96
00:05:02,180 --> 00:05:06,450
بما أنّك تستطيع تمييز هذا الفرق
فسيكون هذا على حسابنا

97
00:05:06,450 --> 00:05:07,770
!استمتع ببيرة البرميل خاصّتك

98
00:05:08,110 --> 00:05:11,050
بيرة برميل، بيرة برميل، بيرة برميل

99
00:05:10,160 --> 00:05:13,290
سأخصم ذلك من راتبك

100
00:05:15,630 --> 00:05:17,640
ينبغي أن تتناول كأساً آخر كذلك

101
00:05:17,640 --> 00:05:19,750
لنأكل ونشرب جيّداً اللّيلة

102
00:05:19,750 --> 00:05:20,300
حسناً

103
00:05:20,600 --> 00:05:23,070
ماذا تودّان أن تأكلان إذاً؟

104
00:05:23,070 --> 00:05:25,340
سنثِق بكم، لذا أحضروا ما تشاؤون

105
00:05:25,340 --> 00:05:26,310
عُلِم

106
00:05:26,310 --> 00:05:28,530
حسناً إذاً، لنفعل هذا من جديد

107
00:05:29,790 --> 00:05:31,040
!بصحّتك

108
00:05:31,040 --> 00:05:32,760
شكراً على الانتظار

109
00:05:31,040 --> 00:05:33,780
إسقمري مقليّ

110
00:05:31,040 --> 00:05:33,780
اغمرها بكثير من الصّلصة وعضّها
!كشخص همجيّ

111
00:05:32,760 --> 00:05:36,540
هذا إسقمري مقليّ، استمتعا به
مع هذه الصّلصة من فضلكما

112
00:05:37,460 --> 00:05:40,040
يدعوننا نضع الصّلصة بأنفسنا

113
00:05:40,390 --> 00:05:42,310
هذه فكرة مثيرة

114
00:05:42,990 --> 00:05:44,660
،جدّي

115
00:05:44,660 --> 00:05:48,440
يبدو حجم هذا كبير جداً، سأقطّعه لك

116
00:05:48,440 --> 00:05:51,580
يجب ألّا يؤكل الإسقمري المقليّ بالسّلوك الأنيق

117
00:05:51,580 --> 00:05:56,670
قضم لقمة كبيرة كهذه هو الطريقة السرّية
!ليكون المذاق في ذروته

118
00:05:56,670 --> 00:05:58,950
قضم لقمة كبيرة؟

119
00:06:00,000 --> 00:06:00,470
قرمشة

120
00:06:00,700 --> 00:06:03,050
لم أفعل هذا منذ مدّة طويلة جداً

121
00:06:03,740 --> 00:06:04,840
قرمشة

122
00:06:08,390 --> 00:06:12,490
هذا الخبز الخفيف المقرمش يصبح جزءاً
واحداً مع الزيت والصّلصة

123
00:06:12,490 --> 00:06:15,110
!ونكهة لحم الإسقمري الخفيفة

124
00:06:15,510 --> 00:06:18,680
قضمه بهذا الشّكل هو الطريقة الصّائبة
أيّتها الآنسة الصغيرة

125
00:06:26,660 --> 00:06:29,050
على ذكر ذلك، سمعتُ أنّ الناس ما زالوا يأكلون

126
00:06:29,050 --> 00:06:31,860
بأيديهم في المناطق الشماليّة الثلاث

127
00:06:31,860 --> 00:06:36,830
نعم، أعتقد أنّ شخصاً من حاشية وينديلمارك
قد استاء كثيراً

128
00:06:36,830 --> 00:06:41,140
لأنّهم انحرجوا في مأدبةٍ أقيمت في العاصمة

129
00:06:41,520 --> 00:06:46,420
أعتقد أنّ مثل هذه الفوارق البسيطة
تؤدّي إلى عداوات

130
00:06:46,420 --> 00:06:47,880
شكراً لصبركما

131
00:06:47,880 --> 00:06:49,390
هذا سمك مُفلطح مسلوق بصلصة الصوّيا

132
00:06:49,740 --> 00:06:52,770
سمك مُفلطح في أيتيريا

133
00:06:52,770 --> 00:06:54,900
ونموذج مدهش كهذا أيضاً

134
00:07:01,670 --> 00:07:03,390
!أنا آسفة جداً

135
00:07:03,390 --> 00:07:06,730
!أنا آسفة! الطعام اللّذيذ

136
00:07:06,730 --> 00:07:08,760
هل تأذّيت؟

137
00:07:08,760 --> 00:07:10,730
...أنا بخير، لكن هي

138
00:07:10,730 --> 00:07:13,370
أنا آسفة! هذا فظيع

139
00:07:13,370 --> 00:07:14,900
هل أنتِ بخير؟

140
00:07:16,300 --> 00:07:18,670
لنتأكّد من أنّكِ لم تحترقي

141
00:07:18,670 --> 00:07:22,020
أمسكي بهذه وانقعيها بالماء وبرّدي يديكِ

142
00:07:22,020 --> 00:07:24,410
شكراً جزيلاً لك

143
00:07:25,610 --> 00:07:27,610
أعتذر كثيراً عن ذلك

144
00:07:27,610 --> 00:07:28,910
لا داعي للقلق

145
00:07:28,910 --> 00:07:32,260
لكن أنا حزين جداً على السّمكة المُفلطحة

146
00:07:32,260 --> 00:07:34,990
،سأحضّر سمكة أخرى حالاً

147
00:07:34,990 --> 00:07:36,480
أمهلني بضع لحظات من فضلك

148
00:07:36,480 --> 00:07:37,030
ماذا؟

149
00:07:37,570 --> 00:07:40,410
،بعد رؤية مثل هذه السّمكة المُفلطحة المدهشة

150
00:07:40,410 --> 00:07:43,400
لا ينبغي أن نتأمّل كثيراً من السمكة التالية

151
00:07:45,980 --> 00:07:49,840
إنّ ترك هذا الطبق يبرد يسمح للنكهة
بأن تتسرّب أكثر

152
00:07:49,840 --> 00:07:52,020
،بما أنّ هذه السمكة أكبر حجماً

153
00:07:52,020 --> 00:07:54,730
لم أكن متأكّداً من أنّ النكهة قد
تسرّبت للأعماق بما يكفي

154
00:07:54,730 --> 00:07:56,290
لكن يبدو أنّها ستكون على ما يُرام الآن

155
00:07:56,640 --> 00:07:58,700
غير معقول

156
00:07:58,700 --> 00:08:01,060
سمكة أكبر حجماً حتّى

157
00:08:01,060 --> 00:08:05,150
،أقارن هذا بقلبِ فارس يواجه تنّيناً

158
00:08:06,060 --> 00:08:13,640
وهو يعلم أنّ تنّيناً أكبر حجماً ينتظره
خلف التنّين الأوّل

159
00:08:14,940 --> 00:08:15,800
ممتاز

160
00:08:16,370 --> 00:08:19,940
لنستمتع بهذا السّمك المُفلطَح الفاخر معاً

161
00:08:19,940 --> 00:08:23,950
مذهل، سمك الفيليه كبير جداً لدرجة أنّه
لا يتّسع في الصحن

162
00:08:24,310 --> 00:08:26,440
لذا لنقطّعه إلى نصفين

163
00:08:26,960 --> 00:08:28,450
تفضّل يا جدّي

164
00:08:30,090 --> 00:08:31,320
ريّان

165
00:08:36,360 --> 00:08:43,130
ريّان

166
00:08:36,910 --> 00:08:40,290
،لم أتناول سمكاً مُفلطحاً مُبهّراً هكذا من قبل

167
00:08:40,290 --> 00:08:43,240
لكن النكهة الحلوة والمالحة تنتشر
في كل أنحاء السمكة

168
00:08:43,240 --> 00:08:46,360
سيّدي، يبدو أنّك تستمتع بالسّمك

169
00:08:46,360 --> 00:08:50,110
إن كان لديك طلب، فسوف نحضّر شيئاً
للتعويض عمّا حدث من قبل

170
00:08:50,520 --> 00:08:54,980
،في بلدةِ صيد السّمك التي ترعرعتُ فيها

171
00:08:54,980 --> 00:08:57,840
كنّا نأكل سلموناً مُدخّناً بالملح كثيراً

172
00:08:57,840 --> 00:09:01,620
سلمون؟ أعتقد أنّ لدينا منه

173
00:09:01,620 --> 00:09:06,860
في الواقع، الجلد المُحمَّر منه هو
طعامي المفضّل

174
00:09:06,860 --> 00:09:09,470
نعم، ذلك الجلد شهيّ

175
00:09:09,470 --> 00:09:10,870
سأحضّر منه

176
00:09:10,870 --> 00:09:14,370
لم أكن أعلم أنّ شيئاً كهذا هو
طعامك المفضّل

177
00:09:14,690 --> 00:09:17,120
الجلد لن يشبعك

178
00:09:17,120 --> 00:09:20,000
يصرّ بعض الناس على التخلُّص منه

179
00:09:20,480 --> 00:09:24,600
لكن ما لم تجرّبه، لن تعرف أنّه من المؤسف
التخلّص منه

180
00:09:24,600 --> 00:09:27,550
هل ستقلق بشأن ما يقوله الآخرون
،وتتخلّص منه

181
00:09:27,550 --> 00:09:30,210
أم أنّك ستفهم طبيعته الحقيقيّة؟

182
00:09:30,770 --> 00:09:33,130
،الإمبراطوريّة هي لحم السّلمون

183
00:09:33,130 --> 00:09:35,750
والمناطق الشماليّة هي الجلد؟

184
00:09:35,750 --> 00:09:36,780
...حسناً

185
00:09:37,140 --> 00:09:38,520
شكراً على الانتظار

186
00:09:38,520 --> 00:09:41,030
جلد سلمون محمّر

187
00:09:38,520 --> 00:09:41,030
جلد السلمون هو حقّاً لذيذ، أليس كذلك؟

188
00:09:39,740 --> 00:09:41,020
!هذا! هذا هو

189
00:09:42,790 --> 00:09:43,900
مقرمش

190
00:09:45,480 --> 00:09:48,800
لا شيء يتفوّق على أومامي ورائحة
!جلد السّلمون الدّسم

191
00:09:49,360 --> 00:09:52,170
!إنّه أطيب طعام خفيف مع الشراب

192
00:09:54,910 --> 00:09:59,510
إيزاكايا نوبو

193
00:09:55,590 --> 00:09:58,920
!زورانا مجدّداً رجاء

194
00:10:00,750 --> 00:10:04,230
يجب أن نلغي الأمر الإمبراطوري الذي يقضي
بحظر اللّاغر

195
00:10:04,230 --> 00:10:05,340
!جدّي

196
00:10:05,340 --> 00:10:09,100
حسناً، اعتبر هذا كمكافأة على جلد
السلمون الشهيّ

197
00:10:09,100 --> 00:10:10,900
!شكراً جزيلاً لك

198
00:10:10,900 --> 00:10:15,170
يوهان، بغضّ النظر عن الأمر الإمبراطوري، ثمّة
شيء أريدك أن تفعله

199
00:10:15,170 --> 00:10:16,000
نعم؟

200
00:10:16,000 --> 00:10:19,470
أريد إجراء تغيير على قائمةِ الطعام
في الاجتماع

201
00:10:20,080 --> 00:10:21,990
في يوم ما بعد غد

202
00:10:29,200 --> 00:10:31,290
فيما يلي، فقرة نوبو الإضافية

203
00:10:31,190 --> 00:10:35,030
نوبو

204
00:10:35,050 --> 00:10:43,760
شينباشي

205
00:10:35,320 --> 00:10:37,710
حسناً، وصلنا إلى هنا، إلى شيباشي

206
00:10:37,710 --> 00:10:40,320
قد يُعتبَر مكاناً مقدّساً للموظّفين

207
00:10:40,320 --> 00:10:43,750
،هناك عدد غير طبيعي من الحانات هنا

208
00:10:40,860 --> 00:10:43,060
كينيتشي ناغيرا

209
00:10:43,750 --> 00:10:45,440
وذكّرني مشاهدة إيزاكايا نوبو

210
00:10:45,440 --> 00:10:46,000
ذكّرك بماذا؟

211
00:10:46,000 --> 00:10:49,210
بأنّني يابانيّ. لا بدّ أن يكون سمكاً فحسب

212
00:10:49,210 --> 00:10:49,930
هذا ما تعنيه إذاً

213
00:10:49,930 --> 00:10:51,160
هل ينبغي أن أتّبع غريزتي فحسب؟

214
00:10:51,160 --> 00:10:53,420
!لا، سأدلّك إلى مطعم جيّد

215
00:10:52,740 --> 00:10:57,260
الرّاوية
تيو إتشيريوساي

216
00:10:52,770 --> 00:10:58,840
سيتجوّل كينيتشي ناغيرا بين المطاعم هنا
"لإيجاد الأطباق المذهلة المُقدّمة في "نوبو

217
00:10:57,610 --> 00:10:59,750
"يبحث كينيتشي ناغيرا عن حانة "نوبو

218
00:11:00,600 --> 00:11:03,280
قلتِ لي في شارع جانبي، لكن
يوجد الكثير منها

219
00:11:03,280 --> 00:11:06,170
وأشعر بالدُّوار من كثرة ما بحثت
فوقي وتحتي

220
00:11:06,170 --> 00:11:07,720
!اقتربنا من الوصول

221
00:11:06,180 --> 00:13:29,090
شينباشي
مطعم سمك

222
00:11:07,720 --> 00:11:08,270
إنه هنا

223
00:11:08,270 --> 00:11:10,080
أرأيت؟ أخبرتك

224
00:11:10,080 --> 00:11:11,460
!وجدتُه

225
00:11:11,460 --> 00:11:13,620
هامانكورا هو مطعم يمكنك فيه التمتّع
بسمك طازج

226
00:11:12,120 --> 00:11:16,620
مطعم الأسماك هامانكورا

227
00:11:13,620 --> 00:11:16,630
أُرسِلَ مباشرةً من ميناء أماكوسا لصيد
الأسماك التابع لمُحافظة كوماموتو

228
00:11:16,620 --> 00:11:21,930
هامانكورا
ناكاجيما يوكو-سان

229
00:11:16,630 --> 00:11:18,740
أنا ممتنّ، أعشق هذا النوع من الأماكن

230
00:11:18,740 --> 00:11:19,490
رأيت؟

231
00:11:19,490 --> 00:11:20,810
أهلاً وسهلاً، شكراً لقدومك

232
00:11:20,810 --> 00:11:21,620
شكراً لك

233
00:11:21,920 --> 00:11:25,990
عندما أنظر حولي، كلّ ما أراه هو
أماكوسا، أماكوسا، أماكوسا، أماكوسا

234
00:11:25,990 --> 00:11:29,390
زوجي يرسل السّمك من أماكوسا

235
00:11:29,390 --> 00:11:31,600
لديكم سمك أماكوسا طازج هنا إذاً؟

236
00:11:31,600 --> 00:11:31,900
نعم

237
00:11:31,900 --> 00:11:33,210
وزوجكِ موجود هناك دوماً؟

238
00:11:33,210 --> 00:11:35,290
نعم، يغوص ويرسلها إلى هنا

239
00:11:35,290 --> 00:11:35,950
هل هو راكب أمواج إذاً؟

240
00:11:35,950 --> 00:11:37,060
لماذا تسأل هذا السّؤال حتّى؟

241
00:11:36,270 --> 00:11:38,670
لا، إنّه صيّاد سمك وغوّاص حرّ

242
00:11:38,670 --> 00:11:39,530
ليس راكب أمواج إذاً

243
00:11:39,530 --> 00:11:41,610
لا، ليس راكب أمواج

244
00:11:42,350 --> 00:11:46,870
الشيء الذي ستحضّره لنا اليوم هو
!ساشيمي سمك أبيض

245
00:11:48,830 --> 00:11:50,140
هذا سمك لاسِع

246
00:11:50,140 --> 00:11:53,210
!سمك لاسِع؟ هذا نوع ممتاز

247
00:11:52,600 --> 00:11:53,490
نعم

248
00:11:53,210 --> 00:11:54,110
!مدهش بحَقّ

249
00:11:54,110 --> 00:11:54,830
أتّفق

250
00:11:55,990 --> 00:11:57,990
يمكنك أن تندهش لاحقاً، كُل الآن

251
00:11:57,990 --> 00:12:00,420
!ما رأيك بالنكهة، بالقوام؟

252
00:12:00,420 --> 00:12:01,700
...هذا قوام مقرمش بعض الشيء

253
00:12:01,700 --> 00:12:02,940
نعم، يمتلك هذا القوام

254
00:12:02,940 --> 00:12:04,000
إنّه مدهش

255
00:12:04,000 --> 00:12:07,130
هذه تجربة ممتعة للأسنان أيضاً. شهيّ

256
00:12:05,990 --> 00:12:07,000
صحيح

257
00:12:07,130 --> 00:12:08,350
!يعجبني نضج هذه الأسماك

258
00:12:08,350 --> 00:12:11,040
وهذا هو كبد السّمكة اللّاسِعة

259
00:12:11,040 --> 00:12:14,290
من الصّعوبة الحصول على هذه في طوكيو
ما رأيك بهذا الكبد الثّمين؟

260
00:12:14,290 --> 00:12:15,100
ما رأيك به؟

261
00:12:15,980 --> 00:12:17,660
!أشعر بالغيرة الشديدة

262
00:12:16,680 --> 00:12:17,660
إنّه لذيذ

263
00:12:17,660 --> 00:12:18,160
!أريد منه

264
00:12:18,160 --> 00:12:18,900
هذه بيوض؟

265
00:12:18,900 --> 00:12:19,660
نعم

266
00:12:19,660 --> 00:12:22,480
لم أرَ بيوضَ سمك لاسِع من قبل
لكن هذه كبيرة الحجم

267
00:12:22,480 --> 00:12:25,250
فعلاً، هذه أوّل مرّة أراها أيضاً

268
00:12:27,390 --> 00:12:30,540
حسناً، ما مذاقها؟ أغار منك

269
00:12:31,520 --> 00:12:33,050
لذيذة للغاية

270
00:12:32,350 --> 00:12:35,060
بالطبع! هذا جليٌّ من ابتسامتك

271
00:12:33,960 --> 00:12:34,890
الجلد؟

272
00:12:34,890 --> 00:12:36,340
نعم، الجلد

273
00:12:36,340 --> 00:12:39,020
نأكل الجلد فحسب إذاً

274
00:12:37,000 --> 00:12:38,160
كولاجين

275
00:12:39,000 --> 00:12:41,030
أعني نفعل الشيء ذاته مع سمك الينفوخ أيضاً

276
00:12:40,110 --> 00:12:41,490
!إنّه نافع للبشرة أيضاً

277
00:12:41,030 --> 00:12:41,770
من الآمن أكله، صحيح؟

278
00:12:41,770 --> 00:12:42,670
آمن، أجل

279
00:12:42,110 --> 00:12:43,410
!يا للوقاحة

280
00:12:44,110 --> 00:12:46,620
لا تقولي "أكله ناغيرا" لاحقاً

281
00:12:46,620 --> 00:12:48,530
!كفّ عن قول مثل هذا الكلام

282
00:12:48,530 --> 00:12:51,220
قد يكون الجلد هو أشهى ما فيه

283
00:12:51,220 --> 00:12:52,350
رأيت؟

284
00:12:51,540 --> 00:12:52,650
إنّه ناعم جدّاً

285
00:12:52,650 --> 00:12:53,920
تفاجأت

286
00:12:53,920 --> 00:12:55,480
أريد تذوّقه أيضاً

287
00:12:55,480 --> 00:12:56,440
ثمّ لدينا هذا

288
00:12:56,440 --> 00:12:58,130
نعم، إنّه حلزون بحري

289
00:12:58,130 --> 00:13:01,430
يمكن لهذا الحلزون أن يُصطاد
في كلّ أنحاء البلد

290
00:13:01,430 --> 00:13:03,500
يشبه حافرَ حصان، لذا يُدعى أحياناً

291
00:13:03,500 --> 00:13:08,870
حلزون الحصان، لكن له أكثر من 200 اسم آخر

292
00:13:08,870 --> 00:13:10,620
معلوماتك وافرة في هذا الاختصاص

293
00:13:10,620 --> 00:13:12,740
نعم، أنا لا... أصهل

294
00:13:12,740 --> 00:13:14,970
كانت ضحكة توتُّر

295
00:13:14,970 --> 00:13:20,450
لم أكن أعرف هذا المكان، لكن سوف
أتي إلى هنا بانتظام الآن

296
00:13:20,450 --> 00:13:22,070
أتطلّع قدماً لذلك

297
00:13:22,070 --> 00:13:27,020
حتّى ناغيرا-سان يشهد بمطعم الأسماك الطازجة التي يصطادها
غوّاص حرّ، هامانكورا هذا

298
00:13:26,280 --> 00:13:29,090
يتبع                                 المساعد: غورونابي

299
00:13:27,020 --> 00:13:29,090
يبعد مسافة مشي لدقيقتين عن محطّة شيباشي

300
00:13:29,090 --> 00:13:32,080
إذا أردت أن تستمتع بالطعم الحقيقيّ
!للسمك، فتعال إلى هنا، تعال إلى هنا

301
00:14:48,440 --> 00:14:54,170
"الحلقة القادمة من "إيسيكاي إيزاكايا
"الملقّب بـ"إيزاكايا نوبو في أيتيريا

302
00:14:54,500 --> 00:14:57,500
من فضلكم تذوّقوا الحكايات اللّذيذة