1
00:00:02,610 --> 00:00:04,100
أنقذني أشخاص ما

2
00:00:04,410 --> 00:00:08,150
.عندما انفصلتُ عن أمّي وهاجمني طائر حدأة

3
00:00:11,380 --> 00:00:16,090
.ثمّ عشت معهم لسنوات عديدة جدًّا بعدها

4
00:00:17,050 --> 00:00:19,950
،وذات يوم، طوّرتُ وعيًا واضحًا

5
00:00:21,130 --> 00:00:21,960
...وثمّ

6
00:00:23,600 --> 00:00:25,220
.صرت نيكوماتا

7
00:00:26,810 --> 00:00:29,440
،تقبّلت عائلتي تحوّلي

8
00:00:30,080 --> 00:00:31,320
...وأنا الآن

9
00:00:31,790 --> 00:00:33,800
،أبحث عن الطّريقة الصّحيحة للعيش

10
00:00:34,300 --> 00:00:36,500
.وهدف للعيش، كنيكوماتا

11
00:02:10,920 --> 00:02:13,620
يجب أن يتمّ اصطحابنا لأنّ هنالك من رأى نوي؟

12
00:02:13,620 --> 00:02:15,070
.إنّهم يبالغون كثيرًا

13
00:02:15,070 --> 00:02:17,420
...عفوًا، بخصوص هذا

14
00:02:17,420 --> 00:02:21,070
أيّ نوع من الوحوش الخرافيّة هو النّوي؟

15
00:02:21,070 --> 00:02:24,280
...يقال أنّها كبيرة ويصل حجمها لحجم دبّ

16
00:02:25,110 --> 00:02:28,470
.وإن سمعت صوتها، فسيصيبك سوء الحظّ

17
00:02:28,470 --> 00:02:30,120
.وهي تخشى الأقواس والسّهام

18
00:02:30,380 --> 00:02:31,560
الأقواس والسّهام؟

19
00:02:31,830 --> 00:02:35,060
.لأنّه تمكّن قائد حربيّ من قتل أحدها في الماضي

20
00:02:35,060 --> 00:02:36,190
.هكذا إذًا

21
00:02:36,190 --> 00:02:39,700
،إن قابلت أحدًا ما يحملها
.فستُذعر وتلوذ بالفرار

22
00:02:41,200 --> 00:02:42,630
!كنتُ لأفعل ذلك أيضًا

23
00:02:56,820 --> 00:02:58,400
...كلاّ... كلاّ

24
00:03:02,750 --> 00:03:03,660
بوتشيو؟

25
00:03:27,320 --> 00:03:28,780
...بوتشيو

26
00:03:29,540 --> 00:03:33,050
!كان ذلك رائعًا! كنتَ رائعًا جدًّا

27
00:03:33,840 --> 00:03:35,390
...تاكومي-كُن

28
00:03:40,340 --> 00:03:41,620
...حمدًا على هذا

29
00:03:43,200 --> 00:03:46,950
.حمدًّا لأنّك بخير

30
00:03:48,520 --> 00:03:50,280
!كنتُ خائفًا جدًّا

31
00:03:52,080 --> 00:03:53,750
...بوتشيو

32
00:03:55,920 --> 00:03:57,330
!واجَهَ نوي؟

33
00:03:57,330 --> 00:03:58,110
!نعم

34
00:03:58,110 --> 00:04:01,630
.تحوّل إلى محارب وسحب قوسه هكذا

35
00:04:01,800 --> 00:04:03,560
لكن هل أنت بخير؟

36
00:04:03,560 --> 00:04:04,490
ماذا تقصدين؟

37
00:04:04,490 --> 00:04:05,960
.سمعتَ صوت النّوي

38
00:04:05,960 --> 00:04:08,180
!صحيح! سوء الحظّ؟

39
00:04:08,520 --> 00:04:11,040
ماذا سيحدث؟ لن يتسنّى
لي تناول غدائي في المدرسة مثلاً؟

40
00:04:11,040 --> 00:04:13,240
هل يُعدّ ذلك سوء حظّ؟

41
00:04:24,030 --> 00:04:26,080
ما رأيك؟

42
00:04:28,100 --> 00:04:29,440
.جيّد. نجحت

43
00:04:30,310 --> 00:04:31,730
!أجل

44
00:04:31,730 --> 00:04:33,000
.ركّز

45
00:04:36,940 --> 00:04:41,170
لكنّي أعتقد أنّي أتقنت الأمر
.منذ مواجهة النّوي

46
00:04:41,940 --> 00:04:44,990
عندما أفكّر فيما كان ليحدث
...لو لم أتعلّم منك

47
00:04:46,940 --> 00:04:49,680
.شكرًا جزيلاً لك من أعماق قلبي

48
00:04:50,410 --> 00:04:52,500
لكن لا تتهوّر كثير، مفهوم؟

49
00:04:52,500 --> 00:04:53,330
.نعم

50
00:04:53,330 --> 00:04:55,550
!مهلاً! لديّ فكرة

51
00:04:55,550 --> 00:04:58,600
هل ستلاحظ أمّي إن تحوّل بوتشيو وأخذ شكلي؟

52
00:04:58,600 --> 00:04:59,660
!صحيح

53
00:04:59,660 --> 00:05:01,400
.لا تبالغا فحسب

54
00:05:03,030 --> 00:05:03,940
.حسنًا

55
00:05:04,250 --> 00:05:05,330
.بوتشيو

56
00:05:05,330 --> 00:05:06,330
!أنا جاهز

57
00:05:07,150 --> 00:05:09,040
.لقد عدت للمنزل

58
00:05:09,040 --> 00:05:10,890
!بوتشيو! انتبه لطريقة كلامك

59
00:05:10,890 --> 00:05:13,240
!عفوًا... لقد عدت

60
00:05:17,240 --> 00:05:18,820
أمّي؟

61
00:05:19,640 --> 00:05:22,290
.تاكومي. مرحبًا بك

62
00:05:22,680 --> 00:05:25,210
.احرص على غسل يديك وفمك

63
00:05:25,210 --> 00:05:26,440
.حاضر

64
00:05:29,890 --> 00:05:32,410
.أنت مهذّب أكثر من اللاّزم اليوم

65
00:05:33,090 --> 00:05:35,000
إنّك تخفي شيئًا ما، صحيح؟

66
00:05:35,000 --> 00:05:38,020
!كلاّ، إطلاقًا! لا شيء على الإطلاق

67
00:05:38,970 --> 00:05:40,190
!لا شيء

68
00:05:43,440 --> 00:05:47,680
بالمناسبة يا تاكومي، هل شكرت بوتشيو؟

69
00:05:47,680 --> 00:05:48,400
ماذا؟

70
00:05:48,600 --> 00:05:50,960
أنقذ حياتك من النّوي، صحيح؟

71
00:05:51,870 --> 00:05:54,410
.أنت مدين بحياتك له

72
00:05:54,410 --> 00:05:55,280
صحيح؟

73
00:06:06,760 --> 00:06:10,290
.لا فكرة لديك كم أنا ممتنّة لك

74
00:06:10,830 --> 00:06:13,330
.شكرًا لك يا بوتشيو

75
00:06:15,310 --> 00:06:16,590
...وأيضًا

76
00:06:17,060 --> 00:06:19,410
تاكومي، أتختبئ هناك؟

77
00:06:19,410 --> 00:06:20,970
!كلاّ، كشفت أمري

78
00:06:22,380 --> 00:06:24,840
.كلاّ. لقد ارتخى هذا الجزء

79
00:06:24,840 --> 00:06:28,410
.سأذهب لإحضار صندوق الخياطة
.انتظري هنا

80
00:06:33,080 --> 00:06:35,830
.مو-تشان، تبدين مكتئبة مؤخّرًا

81
00:06:36,760 --> 00:06:39,040
هل هنالك ما يزعجك؟

82
00:06:41,070 --> 00:06:45,000
يصير جيرو مخيفًا جدًّا عندما
.يتحدّث عن عمله

83
00:06:45,000 --> 00:06:46,420
.لا يعجبني ذلك

84
00:06:46,840 --> 00:06:49,540
.لا يوجد ما قد يخيفك

85
00:06:49,880 --> 00:06:52,450
.إنّه يفعل ما يفترض بالتّنغو فعله

86
00:06:52,450 --> 00:06:54,880
.من الطّبيعيّ أن يبدو وجهه صارمًا أحيانًا

87
00:06:55,720 --> 00:06:59,560
ما يفترض به فعله؟ تقصدين
حماية الجبال، صحيح؟

88
00:07:00,240 --> 00:07:01,350
.نعم

89
00:07:03,160 --> 00:07:06,130
أنت تحبّين جيرو، صحيح يا مو-تشان؟

90
00:07:07,190 --> 00:07:08,180
.نعم

91
00:07:10,110 --> 00:07:14,600
ما رأيك أن أخبرك بقصّة عن ماضي جيرو إذًا؟

92
00:07:15,090 --> 00:07:16,120
!كم أودّ ذلك

93
00:07:16,850 --> 00:07:20,400
...حدث هذا قبل مائة عام مضت

94
00:07:21,120 --> 00:07:24,580
.عندما كان تازنبو-سان لا يزال دايتنغو

95
00:07:25,160 --> 00:07:27,560
،نشبت حرب عظيمة

96
00:07:27,560 --> 00:07:31,360
.وغادر للقتال فيها مع العديد من التّنغو الآخرين

97
00:07:31,680 --> 00:07:36,130
.وأثناء غيابه، بدأ جيرو بالخدمة بدلاً منه

98
00:07:36,450 --> 00:07:40,220
،ثمّ ضربت عاصفة كبيرة المكان

99
00:07:40,690 --> 00:07:43,310
وتدفّقت الفيضانات كأفعى تطرح
.جلدها بين الجبال

100
00:07:43,710 --> 00:07:44,910
أفعى تطرح جلدها؟

101
00:07:44,910 --> 00:07:47,960
.نعم، كأفعى تطرح جلدها

102
00:07:47,960 --> 00:07:50,940
...نسمّي ذلك بـ"الانجرافات" أيضًا هذه الأيّام

103
00:07:51,440 --> 00:07:55,510
.لكنّ هذا الانجراف كان بسبب أفعى بالفعل

104
00:07:58,040 --> 00:08:02,170
.وكان من واجب جيرو حماية الجبال وساكنيها

105
00:08:02,380 --> 00:08:05,290
،حاولت الأفعى جعل قريتنا عشًّا لها

106
00:08:05,990 --> 00:08:08,540
.وخاطر جيرو بحياته لقتالها

107
00:08:10,480 --> 00:08:14,090
!سأحمل هذه الضّغينة يا من تحمل اسم جيروبو

108
00:08:19,300 --> 00:08:21,260
ماذا حدث لجيرو؟

109
00:08:21,640 --> 00:08:24,490
.جرفته السّيول بعيدًا

110
00:08:24,490 --> 00:08:27,640
.لكنّه استطاع النّجاة بطريقة ما

111
00:08:28,670 --> 00:08:32,860
تحدث أمور كهذه عندما يكون
.للنّاس واجب عليهم القيام به

112
00:08:33,970 --> 00:08:37,490
.لذلك علينا جميعًا مساعدة بعضنا

113
00:08:38,050 --> 00:08:40,700
،حتّى إن حدثت أمور لا يمكننا التّحكّم بها

114
00:08:40,700 --> 00:08:43,310
.علينا أن نكون موجودين لنُعين بعضنا

115
00:08:49,190 --> 00:08:50,120
،أيّها العجوز

116
00:08:50,480 --> 00:08:52,690
.سأذهب لتفقّد الجبال

117
00:08:52,690 --> 00:08:53,590
.حسنًا

118
00:08:55,220 --> 00:08:57,190
.إن حدث أيّ شيء، فتولّى أمره

119
00:09:08,440 --> 00:09:09,230
!جيرو

120
00:09:12,000 --> 00:09:15,040
مو-تشان؟ لماذا ترتدين هذه الملابس؟

121
00:09:16,720 --> 00:09:17,960
...جيرو

122
00:09:18,180 --> 00:09:20,400
!سأحميك يا جيرو

123
00:09:22,760 --> 00:09:23,280
—مو-تشا

124
00:09:23,280 --> 00:09:24,580
!أنا جادّة

125
00:09:25,650 --> 00:09:26,690
.أكره هذا

126
00:09:27,400 --> 00:09:31,840
.أكره فكرة رحيلك مقابل سلامتنا

127
00:09:36,370 --> 00:09:38,930
جيرو؟ هل أنت مريض؟

128
00:09:40,000 --> 00:09:43,140
.مو-تشان... أنا آسف

129
00:09:58,580 --> 00:10:00,530
...الحاجز يضعف

130
00:10:03,010 --> 00:10:04,920
لم أرك منذ مدّة

131
00:10:04,920 --> 00:10:06,960
.يا فوتشيبياما جيروبو

132
00:10:07,630 --> 00:10:08,760
...أنت

133
00:10:08,760 --> 00:10:13,370
—انتظرتُ طويلاً لأرى شجرة الأرْزِ هذه

134
00:10:13,370 --> 00:10:16,350
.جسدك الأصلي— وهي تُجرّد بالكامل

135
00:10:17,100 --> 00:10:22,110
.قتلتني والطّفل الّذي كنت أحمله

136
00:10:22,700 --> 00:10:23,680
...لذلك

137
00:10:23,940 --> 00:10:28,520
!عدتُ كروح منتقمة للعنك حتّى الموت

138
00:10:28,810 --> 00:10:30,190
...وقتها

139
00:10:30,760 --> 00:10:33,490
.فعلتُ ما وجب عليّ فعله

140
00:10:33,490 --> 00:10:35,860
.لا يوجد أيّ تردّد في قلبي بخصوص ذلك

141
00:10:36,430 --> 00:10:39,580
تصرّ على أنّك كنت على صواب؟

142
00:10:39,820 --> 00:10:44,780
إذًا هل ستقتلني للمرّة الثّانية يا جيروبو؟

143
00:10:45,560 --> 00:10:46,880
.لا

144
00:10:47,400 --> 00:10:49,870
.سأتقبّلك هذه المرّة

145
00:10:50,360 --> 00:10:53,340
ستتحمّل ضغينتي إذًا؟

146
00:10:57,200 --> 00:10:58,800
.حسنًا إذًا

147
00:11:01,150 --> 00:11:03,510
.آسف يا مو-تشان

148
00:11:05,680 --> 00:11:07,050
!ذلك الغبيّ

149
00:11:07,050 --> 00:11:09,570
!جيرو! استيقظ رجاءً

150
00:11:09,570 --> 00:11:11,030
!جيرو

151
00:11:11,650 --> 00:11:15,850
...أيّها العجوز... لقد سقط جيرو وثمّ

152
00:11:16,640 --> 00:11:18,080
!ماذا نفعل؟

153
00:11:18,920 --> 00:11:20,520
!هذا الغبيّ

154
00:11:21,240 --> 00:11:22,710
.سيكون بخير

155
00:11:22,710 --> 00:11:25,320
—لنأخذه للمنزل لكي يرتاح

156
00:11:35,600 --> 00:11:36,690
جيرو؟

157
00:11:43,850 --> 00:11:45,090
...تشيو-تشان

158
00:11:46,080 --> 00:11:48,080
أين جيرو-ساما؟

159
00:11:50,520 --> 00:11:52,050
...هل تلك الرّيشة

160
00:11:53,000 --> 00:11:54,640
.أظنّها ريشة لجيرو

161
00:11:57,520 --> 00:11:59,480
.قدّريها جيّدًا

162
00:12:01,910 --> 00:12:03,380
أين هو تازنبو-ساما؟

163
00:12:03,830 --> 00:12:07,490
قال أنّه سيذهب لشجرة الأرْزِ العظيمة
.وطلب منّي الانتظار هنا

164
00:12:08,260 --> 00:12:10,360
ما هي شجرة الأرْزِ العظيمة؟

165
00:12:12,250 --> 00:12:15,830
.شجرة الأرْزِ العظيم هي جسد جيرو الأساسيّ

166
00:12:16,190 --> 00:12:17,210
جسده الأساسيّ؟

167
00:12:18,040 --> 00:12:21,150
هل تعرفين كيف يولد تنغو الجبال؟

168
00:12:23,970 --> 00:12:26,950
تسكن روحٌ وهبها إله الجبل

169
00:12:26,950 --> 00:12:29,430
،في شجرة أو صخرة قديمة

170
00:12:29,430 --> 00:12:33,940
وهكذا يولد تنغو ويُكلّف
.بواجب حماية الجبل

171
00:12:34,370 --> 00:12:38,840
ما دام الجسد الأساسيّ حيًّا، يستطيع التّنغو
.أن يولد من جديد مرّة تلو الأخرى

172
00:12:39,420 --> 00:12:41,810
،لكن إن ذبل الجسد الأساسيّ ومات

173
00:12:42,040 --> 00:12:46,360
.لا يستطيع التّنغو البقاء وسيلقى حتفه الأخير

174
00:12:47,750 --> 00:12:50,530
.لا بدّ أنّ شيئًا ما حدث لشجرة الأرْز العظيمة

175
00:12:54,120 --> 00:12:57,080
.رأيتُ شجرة الأرْز العظيمة من قبل

176
00:12:57,610 --> 00:12:59,260
...هناك ما قادني إليها

177
00:12:59,530 --> 00:13:01,880
...هل كانت الرّؤيا الّتي رأيتِها وقتها

178
00:13:04,140 --> 00:13:05,330
.مرحبًا

179
00:13:06,120 --> 00:13:07,390
هل جيرو هنا؟

180
00:13:07,390 --> 00:13:09,100
.مرحبًا يا مو-تشان

181
00:13:11,720 --> 00:13:12,710
ما الخطب؟

182
00:13:22,260 --> 00:13:23,220
...ما الّذي

183
00:13:25,560 --> 00:13:27,170
!أريد الذّهاب أيضًا

184
00:13:27,620 --> 00:13:28,610
.لا يمكنك

185
00:13:28,610 --> 00:13:30,160
!أعلم أنّ هذه غلطتي

186
00:13:31,720 --> 00:13:35,590
أنا أحبّ جيرو ولا أستطيع البقاء
!هنا مكتوفة الأيدي

187
00:13:35,590 --> 00:13:36,840
...أريد

188
00:13:37,100 --> 00:13:39,670
!أريد إنقاذ جيرو! أريد حمايته

189
00:13:43,300 --> 00:13:47,260
.وأنا أيضًا أشاركك نفس الشّعور

190
00:14:04,900 --> 00:14:09,540
يحاول صدّ شيء كهذا بنفسه؟

191
00:14:11,400 --> 00:14:13,030
ما العمل...؟

192
00:14:14,000 --> 00:14:15,140
!أيّها العجوز

193
00:14:15,750 --> 00:14:17,050
!مو-تشان

194
00:14:17,050 --> 00:14:18,960
هاياتشيو، لماذا أحضرتها؟

195
00:14:20,640 --> 00:14:22,000
...تلك الأفعى

196
00:14:25,270 --> 00:14:27,110
...أيّتها الفتاة البشريّة

197
00:14:27,110 --> 00:14:30,350
.سأستطيع أخيرًا تحقيق انتقامي بفضلك

198
00:14:31,310 --> 00:14:35,400
.دخلتُ الحفرة في قلبك الّتي نشأت من وحدتك

199
00:14:35,400 --> 00:14:37,160
!كم هذا بهيج

200
00:14:37,590 --> 00:14:39,060
...جيروبو

201
00:14:39,060 --> 00:14:43,790
الفتاة الصّغيرة الّتي اهتممتَ
.لأمرها ستكون سبب هلاكك

202
00:14:43,790 --> 00:14:45,520
.لا تستمعي لها

203
00:14:45,520 --> 00:14:47,030
!يا رفاق

204
00:14:47,280 --> 00:14:48,940
جميعكم هنا أيضًا؟

205
00:14:49,600 --> 00:14:51,360
ماذا تفعله موتسومي هنا؟

206
00:14:51,650 --> 00:14:53,640
تايرا، ألم تحاول إيقافها؟

207
00:14:53,640 --> 00:14:56,160
!مهلاً، ما كنت لأستطيع إيقافها حتّى إن أردتُ ذلك

208
00:14:56,400 --> 00:14:59,360
.عندما يتّخذ المرء قراره، فلا أستطيع تجاهل ذلك

209
00:15:00,470 --> 00:15:02,840
علينا دعمها فحسب، صحيح؟

210
00:15:03,790 --> 00:15:07,080
.سأبذل جهدي لحماية جيرو

211
00:15:07,390 --> 00:15:09,200
هلاّ حميتموني؟

212
00:15:11,490 --> 00:15:13,720
.أظنّ أنّ لا خيار أمامنا

213
00:15:17,390 --> 00:15:20,260
لكنّ ذلك الشّيء الّذي يتلبّس الشّجرة
.سيكون مشكلة كبيرة لنا

214
00:15:20,260 --> 00:15:23,710
،إن هاجمنا الأفعى بشكل متهوّر
.فإنّ الشّجرة ستعاني من ذلك

215
00:15:23,710 --> 00:15:24,710
...عفوًا

216
00:15:25,400 --> 00:15:27,960
لماذا لا نشتّت انتباهها؟

217
00:15:29,820 --> 00:15:31,840
.لا يهمّ كم يوجد منكم

218
00:15:31,840 --> 00:15:34,240
—اقتربوا وسأقتلكم جميـ

219
00:15:36,090 --> 00:15:37,620
!جيروبو؟

220
00:15:38,280 --> 00:15:39,920
!كيف لا تزال واقفًا هناك؟

221
00:15:40,200 --> 00:15:43,040
!كيف تجرؤ؟! سوف أقتلك

222
00:15:49,920 --> 00:15:51,210
!اللّعنة عليك

223
00:16:01,940 --> 00:16:03,820
!شكرًا جزيلاً

224
00:16:03,820 --> 00:16:05,190
.أبليت بلاءً حسنًا

225
00:16:05,190 --> 00:16:08,150
!بسرعة! ستعود قريبًا

226
00:16:17,840 --> 00:16:19,280
...جميعكم

227
00:16:19,720 --> 00:16:21,960
لماذا تقفون في طريقي؟

228
00:16:22,160 --> 00:16:25,920
!لماذا وقد عانيتُ الكثير؟

229
00:16:46,070 --> 00:16:47,540
لا بأس إن قطعتُه؟

230
00:16:47,540 --> 00:16:48,350
!لا بأس

231
00:16:52,410 --> 00:16:53,560
أيمكنك بلوغه؟

232
00:16:53,560 --> 00:16:54,630
!نعم

233
00:16:54,630 --> 00:16:56,240
.اربطيه حول الجزء المتضرّر

234
00:16:56,920 --> 00:16:57,950
.هذا جيّد

235
00:17:02,840 --> 00:17:04,370
...سُحقًا لكم

236
00:17:09,120 --> 00:17:10,840
!لا تتدخّلي

237
00:17:15,540 --> 00:17:16,680
!انتهيت

238
00:17:39,700 --> 00:17:40,950
!جيرو

239
00:17:42,290 --> 00:17:43,700
جيرو؟

240
00:17:44,710 --> 00:17:46,280
!إنّه يتنفّس

241
00:18:02,120 --> 00:18:04,760
.قلتُ أنّي سأتقبّلك

242
00:18:05,010 --> 00:18:07,640
.سأتقبّل ضغينتك وروحك

243
00:18:07,920 --> 00:18:12,480
،عندما تولدين من جديد
.سأرحّب بك في هذه الأرض

244
00:18:12,770 --> 00:18:16,980
.وهذا لتجدي شيئًا لحمايته ثانية

245
00:18:24,430 --> 00:18:30,410
ذلك الرّجل اللّطيف الّذي قدّم عهدًا
...أبديًّا لي أنا إلهة الماء

246
00:18:31,160 --> 00:18:33,850
...والطفّل المحبوب في رحمي

247
00:18:34,760 --> 00:18:35,880
...ولكن

248
00:18:36,630 --> 00:18:39,760
.قام طرف غيور بتسميمي

249
00:18:51,050 --> 00:18:55,060
...بالكاد استطعتُ النّجاة، وعندما عدت

250
00:19:02,080 --> 00:19:05,360
...شعرتُ بحزن شديد، بألم شديد

251
00:19:05,660 --> 00:19:09,230
.لم أستطع مسامحتهما. لم يكن لديّ أمل

252
00:19:10,040 --> 00:19:11,500
...لذلك

253
00:19:18,370 --> 00:19:20,800
،لن أسامحك

254
00:19:21,320 --> 00:19:22,680
.لكنّي أشكرك

255
00:19:29,270 --> 00:19:29,790
!جيرو

256
00:19:29,790 --> 00:19:30,850
!جيرو-سان

257
00:19:37,460 --> 00:19:39,160
!جيرو

258
00:19:39,160 --> 00:19:40,360
...مو-تشان

259
00:19:40,920 --> 00:19:42,200
!أيّها الغبيّ

260
00:19:44,080 --> 00:19:45,350
.أنا آسف

261
00:19:45,350 --> 00:19:47,620
!لا تعتذر لي

262
00:19:48,350 --> 00:19:49,360
.حسنًا

263
00:19:49,740 --> 00:19:54,230
!عدني أنّك لن تتصرّف بهوّر ثانية

264
00:19:56,480 --> 00:19:57,330
.حسنًا

265
00:19:58,450 --> 00:19:59,940
.أعدك

266
00:20:11,480 --> 00:20:13,440
لماذا فعلت ذلك؟

267
00:20:14,430 --> 00:20:19,780
عندما أدركتُ أنّ روح تلك الأفعى
،عالقة هنا بسبب ضغينتها تجاهي

268
00:20:19,780 --> 00:20:23,730
.ظننتُ أنّ لا خيار أمامي سوى الاختفاء لأجلها

269
00:20:25,450 --> 00:20:28,200
...لكن عندما اختفى جسدي

270
00:20:29,170 --> 00:20:33,130
.كنتُ بين يديك قبل أن أدرك الأمر

271
00:20:33,500 --> 00:20:37,940
عندما سمعتُ أصوات جميع
،من يحاولون إنقاذي

272
00:20:37,940 --> 00:20:39,610
.فهمت أخيرًا

273
00:20:40,190 --> 00:20:43,830
.لديّ أشخاص يحمونني أيضًا

274
00:20:44,730 --> 00:20:47,260
...شكرًا لك. وأيضًا

275
00:20:47,580 --> 00:20:50,140
.دعيني أعتذر لك الآن

276
00:20:50,140 --> 00:20:51,170
.أنا آسف

277
00:20:53,650 --> 00:20:56,200
!لا أمل يُرجى منك يا جيرو

278
00:20:58,120 --> 00:20:59,130
...جيرو

279
00:20:59,660 --> 00:21:03,120
.أتدري؟ أدركتُ أمرًا أنا أيضًا

280
00:21:03,960 --> 00:21:10,570
أدركت أنّي شعرت بالوحدة
.منذ اختفاء أبي

281
00:21:11,290 --> 00:21:13,480
.أحدثَ ذلك حفرة في قلبي

282
00:21:13,760 --> 00:21:17,160
...ودفعني للتّفكير

283
00:21:17,160 --> 00:21:19,900
.في أنّه لا بدّ أنّ أبي شعر بذلك أيضًا

284
00:21:21,020 --> 00:21:25,410
فكما كنت أنا تحت سيطرة
...الأفعى، فربّما أبي

285
00:21:27,440 --> 00:21:29,680
!لكن لا بأس الآن

286
00:21:30,160 --> 00:21:31,810
!لستُ وحيدة

287
00:21:31,810 --> 00:21:34,340
،بعد أن قرّرتُ أنّي أريد حمايتك

288
00:21:34,340 --> 00:21:36,440
!أعتقد أنّي صرت أقوى بكثير

289
00:21:38,780 --> 00:21:41,200
.أنت رائعة جدًّا يا مو-تشان

290
00:21:41,200 --> 00:21:42,190
أتظنّ؟

291
00:21:47,780 --> 00:21:51,830
.أتمنّى أن نستطيع العيش جميعًا بسعادة وسلام

292
00:21:53,080 --> 00:21:56,650
.أيّتها الآلهة، أحيطينا برعايتك رجاءً

293
00:23:33,150 --> 00:23:36,640
هذا هو بوتشيو-كُن بعد
أن تطوّر إلى نيكوماتا؟