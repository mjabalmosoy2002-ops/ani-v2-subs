1
00:01:31,740 --> 00:01:34,740
!لم أسلك هذه الطّريق من قبل

2
00:01:34,740 --> 00:01:36,890
فعلاً؟ وماذا عن البحر؟

3
00:01:36,890 --> 00:01:39,080
.رأيته بضعة مرّات

4
00:01:39,640 --> 00:01:42,720
.ما زال حجمه الكبير يفاجئني في كلّ مرّة

5
00:01:43,390 --> 00:01:45,550
.كما أنّه جميل جدًّا

6
00:01:45,940 --> 00:01:46,560
...مهلاً

7
00:01:46,790 --> 00:01:48,240
.يوجد أوميبوزو هناك

8
00:01:49,390 --> 00:01:50,770
!مذهل

9
00:01:57,210 --> 00:02:00,510
.شكرًا على دعوتي في هذه الرّحلة بالسّيّارة

10
00:02:00,710 --> 00:02:01,940
.لا عليك

11
00:02:01,940 --> 00:02:05,120
لنقل أنّها بمناسبة حصول كلينا
.على رخصة السّياقة

12
00:02:06,320 --> 00:02:07,600
...بالمناسبة

13
00:02:08,280 --> 00:02:11,230
أنا وأنت صرنا صديقين الآن، صحيح؟

14
00:02:11,230 --> 00:02:12,270
ماذا؟

15
00:02:12,270 --> 00:02:15,690
.نعم. نحن صديقان

16
00:02:15,960 --> 00:02:19,620
لماذا لا نتحدّث بشكل أقلّ رسميّة
بما أنّنا صديقان الآن؟

17
00:02:19,620 --> 00:02:20,600
!ماذا؟

18
00:02:21,000 --> 00:02:24,150
.لكنّي أتحدّث هكذا حتّى مع عائلتي

19
00:02:24,150 --> 00:02:26,160
...لا أدري إن كنت أستطيع أن أتغيّر

20
00:02:27,200 --> 00:02:29,870
!ولكن لا يعني هذا أنّي أريد ترك مسافة بيننا

21
00:02:31,220 --> 00:02:33,610
إنّها مجرّد عادة إذًا؟

22
00:02:33,980 --> 00:02:37,040
.في تلك الحالة، سأقلّل من الشّكليّات فحسب

23
00:02:37,040 --> 00:02:39,290
.لنقم بذلك إذًا لو سمحت

24
00:02:39,810 --> 00:02:42,630
حسنًا، أهنالك شيء آخر تودّ أكله؟

25
00:02:42,920 --> 00:02:44,510
...دعني أرى

26
00:02:44,510 --> 00:02:48,340
.لم أجرّب غوهي موتشي من قبل
.سأطلب ذلك

27
00:02:48,340 --> 00:02:50,430
.وأنا سأطلب رامن

28
00:02:50,430 --> 00:02:52,430
!أحبّ تونكوتسو

29
00:02:59,760 --> 00:03:02,560
!لم أسر على شاطئ رمليّ من قبل

30
00:03:02,560 --> 00:03:03,680
ألا تشعر بالبرد؟

31
00:03:03,680 --> 00:03:04,450
!أنا بخير

32
00:03:05,990 --> 00:03:09,780
.انظر، ذلك الأوميبوزو بعيد جدًّا الآن

33
00:03:10,580 --> 00:03:13,960
يقال أنّه عندما يعودُ ديدارابوتشي
قضى الصّيفَ يسافر عبر اليابان

34
00:03:13,960 --> 00:03:18,300
.إلى البحر، فإنّه يُدعى حينها أوميبوزو

35
00:03:18,520 --> 00:03:22,290
.قال مذيع الأحوال الجوّيّة نفس الشّيء

36
00:03:22,750 --> 00:03:24,610
،عند رؤية واحد هكذا

37
00:03:24,610 --> 00:03:30,520
،هل تتساءل وتقول لنفسك
"أيعقل أنّ ذلك نِتاج للجوّ بالفعل؟"

38
00:03:31,610 --> 00:03:34,230
.بالنّسبة لي، يبدو أنّه يلعب فحسب

39
00:03:35,240 --> 00:03:36,340
.وأنا أيضًا

40
00:03:41,600 --> 00:03:47,600
إنّ ذلك يجعلني أفكّر
.في أين تنتمي الرّوح بالفعل

41
00:03:48,510 --> 00:03:50,020
.أوافقك

42
00:03:53,110 --> 00:03:54,750
هذا أوّل حمّام أقدام لك أيضًا؟

43
00:03:54,750 --> 00:03:55,920
!نعم

44
00:03:56,390 --> 00:03:59,660
.هذا المكان هو المفضّل لدى كازوهيكو-سان في الحقيقة

45
00:03:59,660 --> 00:04:00,830
.كان يزوره طوال الوقت

46
00:04:00,830 --> 00:04:02,220
فعلاً؟

47
00:04:03,000 --> 00:04:04,900
،قبل أن أولد من جديد

48
00:04:05,520 --> 00:04:07,790
.كان يأتي إلى هنا دائمًا رفقة زوجته ناميكو-سان

49
00:04:09,690 --> 00:04:13,600
كنت أراقب من موقف السّيّارات
.بينما يستعملان حمّام الأقدام

50
00:04:15,100 --> 00:04:16,970
.كانا يبدوان سعيدين دائمًا

51
00:04:18,320 --> 00:04:19,260
...لكن

52
00:04:20,420 --> 00:04:26,080
تغيّر كازوهيكو-سان بطريقة ما
.بعد فقدانه لناميكو-سان

53
00:04:27,360 --> 00:04:30,830
.أدركُ جيّدًا مدى صعوبة الأمر بالنّسبة له

54
00:04:31,380 --> 00:04:34,540
...لذلك أنا واثق أنّ ما باليد حيلة

55
00:04:35,680 --> 00:04:38,880
.لكن أشعر وكأنّه لا يعيش في الحاضر بالفعل

56
00:04:39,450 --> 00:04:41,740
.إنّه يفكّر فيما سيأتي لاحقًا فحسب

57
00:04:43,200 --> 00:04:47,130
.مثل قلقه عمّا سيحدث لي بعد مماته

58
00:04:48,320 --> 00:04:51,600
...أدرك أنّ لدينا أعمارًا مختلفة، لكن

59
00:04:54,520 --> 00:04:58,100
آسف! على الأرجح أنّي بدوت
...وكأنّي أشتكي

60
00:04:58,100 --> 00:05:00,190
.لا، لا بأس بذلك

61
00:05:02,380 --> 00:05:04,300
...الموت قبلي

62
00:05:06,050 --> 00:05:10,280
.أتساءل إن كانت عائلتي تفكّر بنفس الطّريقة

63
00:05:14,530 --> 00:05:15,970
.مرحبًا بكما

64
00:05:15,970 --> 00:05:17,420
.مرحبًا

65
00:05:16,280 --> 00:05:17,420
!مرحبًا

66
00:05:17,660 --> 00:05:18,950
.مساء الخير

67
00:05:18,950 --> 00:05:21,460
!أرى أنّك هنا سلفًا يا يوريبّي

68
00:05:21,680 --> 00:05:24,300
ذلك لأنّني اشتهيتُ أكل بعض الأسياخ
.المقليّة في أقرب وقت ممكن

69
00:05:24,940 --> 00:05:26,720
ما الّذي تريد شربه يا بوتشيو-سان؟

70
00:05:27,120 --> 00:05:28,840
.سأبدأ ببيرة

71
00:05:30,370 --> 00:05:32,050
.قال جيرو أنّه مشغول قليلاً

72
00:05:32,340 --> 00:05:33,520
مشغول قليلاً؟

73
00:05:33,930 --> 00:05:36,480
.إنّه اجتماع لجمعيّة التّنغو

74
00:05:36,680 --> 00:05:38,030
.فهمت

75
00:05:38,540 --> 00:05:41,340
.كان منزعجًا جدًّا. الأسياخ هنا لذيذة

76
00:05:41,340 --> 00:05:43,980
.لم أتناول الأسياخ المقليّة من قبل

77
00:05:44,120 --> 00:05:46,240
.طلبنا الكمّيّة المعتادة كبداية

78
00:05:46,240 --> 00:05:48,600
.تذكّر فقط ألاّ تخلط الصّلصات معًا

79
00:05:51,970 --> 00:05:53,260
!إنّها لذيذة

80
00:05:53,620 --> 00:05:56,090
ولكن ما هي بالضّبط؟

81
00:05:56,390 --> 00:05:57,840
.إنّها مكسرّات الجنكة

82
00:05:57,840 --> 00:05:58,860
...مذهلة

83
00:05:58,860 --> 00:06:00,820
!فطر بوق الملك لذيذ أيضًا

84
00:06:00,820 --> 00:06:01,990
تقصد هذا؟

85
00:06:01,990 --> 00:06:03,640
!نعم، هذا هو

86
00:06:05,680 --> 00:06:06,490
...أخبرنا

87
00:06:08,810 --> 00:06:11,390
.سمعتُ أنّ هنالك ما يزعجك

88
00:06:11,390 --> 00:06:12,160
ماذا؟

89
00:06:12,160 --> 00:06:16,020
كنت تنظر للأسفل في كلّ مرّة
.التقينا بك فيها مؤخّرًا

90
00:06:16,020 --> 00:06:17,410
.إنّنا قلقون نوعًا ما

91
00:06:18,960 --> 00:06:20,580
.ربّما كان ذلك تصرّفًا عديم الإحساس منّا

92
00:06:21,030 --> 00:06:22,580
.أنا آسف

93
00:06:22,580 --> 00:06:25,380
.إنّك أشبه بالكتاب المفتوح

94
00:06:25,940 --> 00:06:27,040
هل من خطب ما؟

95
00:06:30,950 --> 00:06:32,310
...في الحقيقة

96
00:06:34,890 --> 00:06:37,150
.هكذا إذًا

97
00:06:37,150 --> 00:06:39,450
الأعمار المختلفة؟

98
00:06:40,110 --> 00:06:42,650
.إنّه موضوع حسّاس بالفعل

99
00:06:42,880 --> 00:06:45,320
إنّه كذلك بالفعل، صحيح؟

100
00:06:45,320 --> 00:06:49,940
الأمر مختلف إن كان نقاشًا بين ببشريّين
...أو كائنين يعيشان طويلاً، لكن

101
00:06:51,840 --> 00:06:55,480
...عندما تحوّلت من قطّ إلى نيكوماتا

102
00:06:55,480 --> 00:07:00,700
كنتُ مدركًا تمامًا أنّي تحوّلت
.إلى يوكاي سيعيش أطول من البشر

103
00:07:01,240 --> 00:07:03,480
...عرفتُ ذلك، ولكن

104
00:07:03,900 --> 00:07:07,070
،عندما أفكّر في أنّ عائلتي ستموت قبلي

105
00:07:07,420 --> 00:07:10,510
.أشعر بالخوف فجأة

106
00:07:10,510 --> 00:07:12,570
...ولا أستطيع الحديث عن الأمر معهم

107
00:07:13,680 --> 00:07:15,120
...هل أنتم

108
00:07:15,120 --> 00:07:16,600
.الأمر ليس كذلك بالنّسبة لي

109
00:07:17,660 --> 00:07:19,860
.لا يعيش الباكيغيتسوني طويلاً

110
00:07:20,200 --> 00:07:22,790
،يبدو أنّ أسلافنا كانوا يعيشون طويلاً في الماضي

111
00:07:23,070 --> 00:07:25,720
.أمّا الآن، فنعيش حياة بقدر طول حياة البشر

112
00:07:25,720 --> 00:07:28,350
.هناك الكثير من اليوكاي هكذا في الحقيقة

113
00:07:28,350 --> 00:07:29,630
.مثلنا نحن الأوكوري-إيتاتشي أيضًا

114
00:07:32,970 --> 00:07:37,170
،سبق وشعرتُ بالخوف الّذي تشعر به

115
00:07:37,170 --> 00:07:38,310
.لذلك فأنا أفهم

116
00:07:39,280 --> 00:07:41,840
،عند التّفكير في الاختلاف بين أعمارنا

117
00:07:41,840 --> 00:07:46,510
فإنّه يجعلُ الجميعَ يرون كيفية تفاعلهم
.مع البشر واليوكاي بشكل مختلف

118
00:07:47,240 --> 00:07:50,580
هناك من يتجنّب العلاقات من الأساس

119
00:07:50,580 --> 00:07:54,970
لتفادي ذلك الخوف، أو لأنّهم
.يعتقدون أنّ ذلك أفضل للجانبين

120
00:07:55,660 --> 00:07:59,080
أعتقد أنّ ما سيقلّل من مخاوفك

121
00:07:59,080 --> 00:08:01,120
.يعتمد على ما تريد أنت أن تفعله

122
00:08:04,140 --> 00:08:05,450
...ولكن

123
00:08:05,450 --> 00:08:08,190
،بغضّ النّظر عن الأعمار الّتي يعيشها كلّ منّا

124
00:08:08,510 --> 00:08:11,650
فمن المستحيل أن يعرف المرء
.متى سيموت فعلاً

125
00:08:12,170 --> 00:08:15,440
لذلك ربّما لا حاجة من التّفكير
...كثيرًا في الأمر الآن

126
00:08:15,440 --> 00:08:17,600
.هذا ما أعتقده على الأقلّ

127
00:08:18,070 --> 00:08:19,000
.آسف

128
00:08:20,310 --> 00:08:22,620
.إنّه أمر صعب

129
00:08:23,480 --> 00:08:25,280
أتريد طلب بعض الأسياخ؟

130
00:08:25,280 --> 00:08:26,270
.حسنًا

131
00:08:27,650 --> 00:08:30,110
ما الّذي أريد أنا فعله؟

132
00:08:30,560 --> 00:08:32,800
...أتساءل ما الّذي يظنّه واغن-سان

133
00:08:35,710 --> 00:08:37,530
.صباح الخير يا تشياكي

134
00:08:37,760 --> 00:08:38,880
.صباح الخير

135
00:08:38,880 --> 00:08:41,750
مهلاً، ما هو اليوم؟

136
00:08:41,930 --> 00:08:43,360
.إنّه السّبت

137
00:08:43,360 --> 00:08:47,320
.كلاّ. كان دوري في إعداد الفطور

138
00:08:47,320 --> 00:08:49,880
.لا بأس. يمكنك إعداده غدًا

139
00:08:49,960 --> 00:08:51,640
.آسف، آسف

140
00:08:54,150 --> 00:08:56,090
.صباح الخير يا نامي-تشان

141
00:08:58,380 --> 00:09:00,480
كان كازوهيكو-سان وناميكو-سان

142
00:09:01,110 --> 00:09:05,180
.صديقا طفولة في البداية

143
00:09:11,050 --> 00:09:14,220
.لديك عينان جميلتان جدًّا يا نامي-تشان

144
00:09:16,900 --> 00:09:19,300
."سمعتُ أنّ ذلك اللّون يدعى "الزّمرّديّ

145
00:09:20,670 --> 00:09:22,070
...شكرًا لك

146
00:09:24,880 --> 00:09:27,210
.أخبروني أنّه أمر وراثيّ

147
00:09:27,560 --> 00:09:29,470
أترى تلك النّبتة في الحديقة؟

148
00:09:30,490 --> 00:09:34,490
.يقال أنّ جدّ جدّ جدّي كان باشو-نو-سي

149
00:09:36,470 --> 00:09:38,050
...باشو

150
00:09:44,480 --> 00:09:46,740
إذًا فإنّها روح تُجسّد نبتة الموز؟

151
00:09:49,280 --> 00:09:51,480
،عندما كان كلاهما في الثّالثة عشر

152
00:09:51,900 --> 00:09:54,440
،تطلّق والدا ناميكو-سان

153
00:09:54,440 --> 00:09:58,040
.وانتقلت للعيش مع والدتها

154
00:09:59,800 --> 00:10:04,120
لم يلتقيا ببعضهما ثانية
.حتّى صار كلاهما في التّاسعة عشر

155
00:10:07,130 --> 00:10:09,880
.أعتقد أنّنا لم نكن مناسبين لبعض فحسب

156
00:10:10,860 --> 00:10:12,090
.ذلك ما أعتقده

157
00:10:13,080 --> 00:10:16,010
هل من يجلسان خلفي... ينفصلان؟

158
00:10:27,640 --> 00:10:28,760
!نامي-تشان؟

159
00:10:28,760 --> 00:10:31,120
!كازو-كُن! لم أرك منذ مدّة

160
00:10:31,120 --> 00:10:33,310
هل انفصلتما للتّوّ؟

161
00:10:33,750 --> 00:10:34,800
...نعم

162
00:10:36,450 --> 00:10:39,070
،بعد أنّ تحدّثا معًا لوقت طويل

163
00:10:39,070 --> 00:10:42,840
.أدركا أنّهما يتشاركان نفس القيم والأحاسيس

164
00:10:43,350 --> 00:10:46,700
.ومع الوقت، صارا أفضل صديقين

165
00:10:48,310 --> 00:10:50,330
...ثمّ بعد سنة من لمّ شملهما

166
00:10:52,000 --> 00:10:53,700
.التقيا بي أنا

167
00:10:58,370 --> 00:11:00,810
...في أوّل قيادة لنا نحن الثّلاثة معًا

168
00:11:01,440 --> 00:11:04,670
لن أنسى أبدًا ذلك البحر الجميل
.الّذي رأيناه وقتها

169
00:11:07,720 --> 00:11:09,720
!لم أر البحر منذ وقت طويل

170
00:11:09,720 --> 00:11:11,190
.إنّه جميل بالفعل

171
00:11:12,440 --> 00:11:14,180
أتذكر ما أخبرتك به من قبل؟

172
00:11:14,680 --> 00:11:17,960
.أريد أن أعيش بطريقتي الخاصّة بقدر ما أشاء

173
00:11:18,840 --> 00:11:22,350
.أريد أن أموت مع الطّبيعة دون أن أقاومها

174
00:11:23,310 --> 00:11:26,350
لا أريد أن أتزوّج وأنجب أطفالاً
،على وجه الخصوص

175
00:11:27,070 --> 00:11:32,040
.لكنّي أريد أن أكون معك، على ما أظنّ

176
00:11:33,920 --> 00:11:38,440
أريد أن أكون معك أيضًا يا نامي-تشان
.وأودّ أيضًا لو أناديك زوجتي

177
00:11:39,880 --> 00:11:42,120
إلى الأبد، فما رأيك؟

178
00:11:44,430 --> 00:11:46,200
!لا تنادني زوجتي

179
00:11:46,580 --> 00:11:49,600
!هذا مؤلم! مؤلم

180
00:11:51,700 --> 00:11:56,690
.كنتُ سعيدًا جدًّا لأنّي كنت معهما أيضًا

181
00:11:58,670 --> 00:12:01,160
...عندما بلغ كلاهما السّتّين

182
00:12:01,870 --> 00:12:03,620
.صباح الخير يا نامي-تشان

183
00:12:05,530 --> 00:12:09,710
كازو-كُن... ما الّذي يحدث لي؟

184
00:12:13,120 --> 00:12:17,640
إنّ معظم أعضائها، بما في ذلك
.بشرتها، بدأت تتوقّف عن العمل

185
00:12:18,430 --> 00:12:21,290
يبدو أنّ السّبب هو أنّها تنحدر
،من باشو-نو-سي

186
00:12:21,290 --> 00:12:24,020
.أظنّ أنّه يمكننا وصف هذا بمرض وراثيّ

187
00:12:24,820 --> 00:12:27,450
،عندما تذبل نبتة الباشو الأصليّة

188
00:12:27,450 --> 00:12:28,890
.تذبل معها الرّوح أيضًا

189
00:12:29,590 --> 00:12:32,330
.لقد ظهرت خصائصها الأصليّة القديمة

190
00:12:34,930 --> 00:12:36,920
العلاج الوحيد الّذي يمكنني تقديمه

191
00:12:36,920 --> 00:12:40,480
.هو أدوية للتّقليل من طوّر الأعراض

192
00:12:45,430 --> 00:12:48,360
،ذهبت لزيارة منزل عائلتك القديم

193
00:12:48,900 --> 00:12:51,250
...وكانت نبتة الباشو تلك قد

194
00:12:51,840 --> 00:12:53,160
.هكذا إذًا

195
00:12:53,800 --> 00:12:56,920
بإمكانك معرفة ما أفكّر فيه، صحيح؟

196
00:13:00,410 --> 00:13:01,060
.نعم

197
00:13:04,420 --> 00:13:07,660
.كلّ أريده هو أن أعيش كما أنا وأموت كما أنا

198
00:13:07,660 --> 00:13:11,850
الذّبول بشكل طبيعيّ هو الخيار
،الصّحيح بالنّسبة لي

199
00:13:11,850 --> 00:13:14,020
.وليس إطالة حياتي بالأدوية

200
00:13:14,910 --> 00:13:17,740
...لم أترك خلفي أيّ ذرّيّة

201
00:13:18,370 --> 00:13:22,620
لكنّي أريد منك أن تظلّ معي
.حتّى أعود للتّراب ثانية

202
00:13:23,850 --> 00:13:25,150
.أعلم ذلك

203
00:13:26,590 --> 00:13:30,970
.وبعد ذلك، يمكنك مناداتي بزوجتك

204
00:13:31,920 --> 00:13:32,780
...نعم

205
00:13:35,360 --> 00:13:39,020
.لم أرَ ناميكو-سان في لحظاتها الأخيرة

206
00:13:42,640 --> 00:13:43,520
...لكن

207
00:13:43,990 --> 00:13:48,630
أخبرني كازوهيكو-سان أنّها بدت
.سعيدة عندما توفّيت

208
00:13:50,060 --> 00:13:55,520
أتمنّى فقط أن أستطيع تشارك حزن
،كازوهيكو-سان من الآن فصاعدًا

209
00:13:55,800 --> 00:13:56,950
.شيئًا فشيئًا

210
00:14:02,950 --> 00:14:04,900
.مو-تشان

211
00:14:04,900 --> 00:14:06,080
.مرحبًا

212
00:14:06,080 --> 00:14:07,240
.مرحبًا بك

213
00:14:07,240 --> 00:14:09,360
.أتيتُ مع عمّي اليوم

214
00:14:09,590 --> 00:14:11,620
.أتى للحصول على سمك منكما

215
00:14:11,620 --> 00:14:12,850
هكذا إذًا؟

216
00:14:13,890 --> 00:14:16,030
أهذا لأجل الحاجز؟

217
00:14:16,030 --> 00:14:19,020
.نعم. إنّها استعدادات له

218
00:14:19,020 --> 00:14:20,520
.تجربة من نوع ما

219
00:14:22,370 --> 00:14:27,730
،أريد جعل الحاجز أكثر سماكة
.لذلك أقوم بتجربة هذه

220
00:14:35,350 --> 00:14:37,890
لأنّه رقيق جدًّا لدرجة أنّي أستطيع كسره؟

221
00:14:39,320 --> 00:14:41,560
.هذه ليست غلطتك يا مو-تشان

222
00:14:47,980 --> 00:14:50,600
هل أنت غاضبة يا مو-تشان؟

223
00:14:51,420 --> 00:14:54,120
!على الإطلاق

224
00:14:56,550 --> 00:14:57,890
...أخبرني يا جيرو

225
00:15:00,330 --> 00:15:04,190
أتذكر عندما قلتَ "أريد تذكّر كلّ ذلك"؟

226
00:15:04,740 --> 00:15:07,050
هل تذكر كلّ ما حدث سلفًا أيضًا؟

227
00:15:08,120 --> 00:15:10,400
تقصدين ما قلتِه عند شجرة الأرْز العظيمة؟

228
00:15:10,760 --> 00:15:11,330
.نعم

229
00:15:12,040 --> 00:15:14,870
.نعم. ذلك صحيح

230
00:15:14,870 --> 00:15:16,260
مثل ذكرياتك؟

231
00:15:16,260 --> 00:15:17,920
.نعم، نعم

232
00:15:17,920 --> 00:15:22,390
،مثل كلّ النّاس الّذين في البلدة
.وأشياء أخرى حدثت منذ زمن

233
00:15:22,390 --> 00:15:24,570
هل تذكر عندما كانت جدّتي طفلة صغيرة؟

234
00:15:24,570 --> 00:15:26,190
.أذكر ذلك بالفعل

235
00:15:26,480 --> 00:15:30,050
.كانت كوزوي-سان تحبّ المقالب كثيرًا

236
00:15:30,050 --> 00:15:31,920
!فعلاً؟! فاجأني هذا

237
00:15:32,260 --> 00:15:35,240
...كانت توبّخها أمّها كثيرًا على ذلك

238
00:15:37,590 --> 00:15:41,870
جدّة أمّي هي... جدّتي الكبرى، صحيح؟

239
00:15:42,730 --> 00:15:44,110
...أخبرني يا جيرو

240
00:15:44,380 --> 00:15:48,080
آسف. عليّ الذّهاب للبحث
.عن أسلاك في المخزن

241
00:15:49,240 --> 00:15:51,930
.الجوّ بارد في الخارج، لذلك ابقي في المنزل

242
00:16:03,040 --> 00:16:04,560
!وجدته! إنّه هنا

243
00:16:05,060 --> 00:16:06,050
!أأنت حيّ؟

244
00:16:06,390 --> 00:16:07,150
!أجبنا

245
00:16:07,320 --> 00:16:08,110
!جيرو-سان

246
00:16:08,360 --> 00:16:09,560
الوضع ليس سيّئًا، صحيح؟

247
00:16:10,680 --> 00:16:12,040
...جيرو

248
00:16:13,740 --> 00:16:15,110
هل أنت بخير؟

249
00:16:17,120 --> 00:16:19,220
...هارو-تشان

250
00:16:25,990 --> 00:16:28,560
!جيرو! انظر

251
00:16:29,350 --> 00:16:31,570
.قطفتُ بعض توت العلّيق

252
00:16:32,640 --> 00:16:34,050
!لنأكله معًا

253
00:16:55,870 --> 00:16:57,420
.سُحقًا

254
00:17:04,080 --> 00:17:05,240
...أخبرني

255
00:17:05,240 --> 00:17:06,000
ماذا؟

256
00:17:06,320 --> 00:17:08,600
أهنالك شيء ما أردت الحديث عنه؟

257
00:17:09,010 --> 00:17:13,130
.لا، أردت الشّرب معك ثانية فحسب
.لم نقم بذلك منذ مدّة

258
00:17:13,440 --> 00:17:14,900
.هكذا إذًا

259
00:17:15,360 --> 00:17:19,600
في آخر مرّة خرجنا فيها للشّرب
.كمجموعة، كان بوتشيو-سان معنا

260
00:17:20,130 --> 00:17:21,900
.كانت هنالك أشياء كثيرة تقلقه

261
00:17:21,900 --> 00:17:23,040
أشياء تقلقه؟

262
00:17:23,540 --> 00:17:26,330
ذلك الموضوع الصّعب الّذي
.نواجهه جميعًا عاجلاً أم آجلاً

263
00:17:27,530 --> 00:17:28,720
.فهمت

264
00:17:29,840 --> 00:17:32,960
،أودّ أن أبهجه

265
00:17:32,960 --> 00:17:37,070
.لكنّ ذلك وحده لن يساعده

266
00:17:38,230 --> 00:17:42,450
.نعم. لا بدّ أنّه خائف جدًّا الآن

267
00:17:55,030 --> 00:17:57,910
،أخبرتك أنّه لا يوجد شيء أريد الحديث عنه

268
00:17:58,710 --> 00:18:02,470
لكن أعتقد أنّي قد أريد الحديث
.عن مستقبلنا أنا وأنت

269
00:18:02,760 --> 00:18:03,840
أنا وأنت؟

270
00:18:04,270 --> 00:18:10,860
،إنّك بالكاد تتحدّث عن نفسك
.ناهيك عن الحديث عن مستقبلك

271
00:18:11,480 --> 00:18:16,920
لا بدّ أنّ عقلك وقلبك مليئان
.بالأفكار والمشاعر عميقًا في داخلك

272
00:18:17,920 --> 00:18:25,030
.أنا قلق من أن تغرق في أعماق الوحدة

273
00:18:29,650 --> 00:18:33,170
لذلك أعتقد أنّه سيكون من اللّطيف

274
00:18:33,170 --> 00:18:36,360
لو نستطيع الحديث بشأن المستقبل
.بقلوب بهيجة أحيانًا

275
00:18:38,370 --> 00:18:40,080
هل تجاوزت حدودي؟

276
00:18:40,720 --> 00:18:42,390
.على الإطلاق

277
00:18:42,850 --> 00:18:45,110
.ذكّرني هذا أنّي لستُ وحيدًا

278
00:18:45,760 --> 00:18:46,800
.آسف

279
00:18:49,220 --> 00:18:51,440
.أُفضّل ألاّ تعتذر

280
00:18:58,360 --> 00:18:59,960
!تشيو-تشان

281
00:18:59,960 --> 00:19:02,100
.هذه أنت يا مو-تشان

282
00:19:05,000 --> 00:19:06,450
...أخبريني يا تشيو-تشان

283
00:19:06,600 --> 00:19:07,320
ماذا؟

284
00:19:08,220 --> 00:19:11,650
هل هنالك أحد... تحبّينه؟

285
00:19:11,650 --> 00:19:14,710
ماذا؟ لماذا تريدين معرفة هذا؟

286
00:19:16,190 --> 00:19:19,640
.لا أدري... أردتُ الحديث عن الرّومانسيّة فحسب

287
00:19:20,620 --> 00:19:21,680
.فهمت

288
00:19:22,410 --> 00:19:24,440
ومن هذا الّذي تحبّينه أنت؟

289
00:19:24,440 --> 00:19:25,530
.جيرو

290
00:19:25,880 --> 00:19:29,960
...إنّه جيرو، لكن... الآن

291
00:19:30,210 --> 00:19:33,860
...أنا أحبّه، ولكن... ليس بلهفة

292
00:19:34,850 --> 00:19:37,870
...بل إنّه الآن أقرب... لحبّ صادق

293
00:19:38,930 --> 00:19:42,700
...عندما أشاهد جيرو، فإنّ صدري

294
00:19:42,700 --> 00:19:45,910
.يضيق عليّ كما يحدث عندما أحزن

295
00:19:46,670 --> 00:19:50,130
،أنا أحبّه، وأريد حمايته

296
00:19:50,600 --> 00:19:52,330
...ولكنّي

297
00:20:01,010 --> 00:20:06,840
مو-تشان، أنت وجيرو-ساما مهمّان
.جدًّا بالنّسبة لي

298
00:20:08,030 --> 00:20:10,840
.كلّ ما أرغبه هو أنّ تكونا بصحّة جيّدة

299
00:20:11,650 --> 00:20:16,270
،لذلك إن واجهت أيّ مشكلة
.فاستدعيني في الحال رجاءً

300
00:20:16,840 --> 00:20:18,280
.سيكون كلّ شيء على ما يرام

301
00:20:21,680 --> 00:20:25,290
سماعك تقولين أنّ كلّ شيء سيكون
!على ما يرام مريح للغاية

302
00:20:25,290 --> 00:20:28,030
.في كلّ الأحوال، سرّني سماع ذلك

303
00:20:28,340 --> 00:20:31,040
!على أيّ حال، أخبريني من تحبّين

304
00:20:36,200 --> 00:20:37,400
.ذلك سرّ

305
00:20:37,400 --> 00:20:39,430
!ماذا؟

306
00:20:40,820 --> 00:20:43,890
.موتسومي، خذي حمّامك بسرعة

307
00:20:43,890 --> 00:20:45,230
.حاضرة

308
00:20:52,410 --> 00:20:56,150
.خذي يا مو-تشان. لقد غسلتُ منامتك

309
00:20:56,540 --> 00:20:58,470
...أخبريني يا جدّتي

310
00:20:59,430 --> 00:21:01,940
هل جدّتي الكبرى في هذه الصّور؟

311
00:21:02,380 --> 00:21:06,480
لا، إنّها ليست في أيّ من تلك الصّور. لماذا؟

312
00:21:06,840 --> 00:21:08,480
.حدّثني جيرو عنها

313
00:21:08,820 --> 00:21:10,180
جيرو؟

314
00:21:10,180 --> 00:21:13,450
قال أنّها كانت توبّخك كثيرًا

315
00:21:13,450 --> 00:21:15,100
.لأنّك كنت تقومين بالمقالب دائمًا

316
00:21:18,670 --> 00:21:20,160
...في الحقيقة

317
00:21:20,440 --> 00:21:23,880
،لم تكن جدّتك الكبرى تحبّ الكاميرات كثيرًا

318
00:21:23,880 --> 00:21:27,050
.لذلك لا توجد الكثير من صورها

319
00:21:27,560 --> 00:21:28,720
.ولكن انظري

320
00:21:29,880 --> 00:21:31,300
.هذه هي الصّورة الوحيدة

321
00:21:33,090 --> 00:21:35,460
.هذه هي جدّتك الكبرى

322
00:21:36,720 --> 00:21:39,730
.إنّها شابّة. لا تبدو كجدّة أبدًا

323
00:21:39,730 --> 00:21:41,240
.هذا صحيح

324
00:21:41,670 --> 00:21:45,130
.جيرو هو من التقط تلك الصّورة

325
00:21:45,450 --> 00:21:46,390
فعلاً؟

326
00:21:46,390 --> 00:21:47,310
.نعم

327
00:21:47,310 --> 00:21:50,280
.قالت أنّه طلب منها أن يصوّرها

328
00:22:07,620 --> 00:22:08,830
.أنا آسف