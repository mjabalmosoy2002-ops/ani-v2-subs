1
00:00:09,140 --> 00:00:10,650
!ماذا؟ نيكوماتا؟

2
00:00:10,650 --> 00:00:12,200
قطّ عائلتكم؟

3
00:00:12,200 --> 00:00:13,290
.نعم

4
00:00:13,290 --> 00:00:15,880
.بدأ ذيله ينقسم قبل بعضة أيّام

5
00:00:15,880 --> 00:00:17,200
!ماذا؟ –
!أهذا معقول؟ –

6
00:00:17,200 --> 00:00:19,680
.لذلك السّبب عليّ الإسراع للمنزل

7
00:00:19,680 --> 00:00:20,490
.إلى اللّقاء

8
00:00:21,540 --> 00:00:23,660
!أريد رؤيته أيضًا

9
00:00:23,660 --> 00:00:25,000
!هيّا بنا، هيّا

10
00:00:25,300 --> 00:00:27,850
...أُفضّل تركه وشأنه

11
00:00:27,850 --> 00:00:29,230
!دعنا نراه فحسب

12
00:00:33,080 --> 00:00:34,560
!إنّه نيكوماتا

13
00:00:34,560 --> 00:00:35,630
.بوتشيو

14
00:00:35,630 --> 00:00:38,340
.لقد صوّرتُ تحوّله إلى نيكوماتا

15
00:00:38,340 --> 00:00:40,100
!أحسنت يا أخا تاكومي

16
00:00:40,590 --> 00:00:42,560
لماذا تختبئ؟

17
00:00:42,870 --> 00:00:45,270
...لأنّني

18
00:00:47,350 --> 00:00:50,940
.أخجل بسهولة

19
00:00:52,150 --> 00:00:53,740
...لقد تكلّم

20
00:00:54,870 --> 00:00:59,170
."أنا ما قد أوصف بـ"خجول بطبعه

21
00:00:59,170 --> 00:01:00,300
خجول؟

22
00:01:00,300 --> 00:01:03,250
،عندما أدركت أنّي أتحوّل إلى نيكوماتا

23
00:01:03,250 --> 00:01:05,120
.شعرت بقلق شديد

24
00:01:05,360 --> 00:01:07,540
.لم أدري ما العمل

25
00:01:07,540 --> 00:01:09,340
ما العمل؟

26
00:01:09,580 --> 00:01:13,680
...إنّ النّيكوماتا يلفتون الانتباه سلفًا

27
00:01:13,680 --> 00:01:16,520
...وإن رآني النّاس على هذه الحالة

28
00:01:16,520 --> 00:01:19,220
!وفوق ذلك، اسمي بوتشيو

29
00:01:19,220 --> 00:01:21,400
من سمّاك بذلك؟

30
00:01:21,400 --> 00:01:22,560
.أنا

31
00:01:23,040 --> 00:01:26,210
.أريد أن أعيش حياة هادئة فحسب

32
00:01:26,210 --> 00:01:27,570
.بوتشيو

33
00:01:28,760 --> 00:01:31,120
.آسفة على كلّ هذه الفوضى

34
00:01:31,120 --> 00:01:33,110
.كنتُ سعيدة جدًّا فحسب

35
00:01:33,520 --> 00:01:36,040
،ظننتُ أنّك ستموت بسبب تقدّمك في العمر

36
00:01:36,040 --> 00:01:38,870
.كنتُ مسرورة لأنّك ستقضي وقتًا أطول معنا

37
00:01:40,240 --> 00:01:44,740
،لكنّ هذه هي حياتك الجديدة
.وسأدعمك بالكامل

38
00:01:44,740 --> 00:01:47,540
.وإن كنت لا تحبّ اسمك، يمكنك تغييره

39
00:01:50,180 --> 00:01:53,030
.لا بأس... باسمي الحاليّ

40
00:01:53,500 --> 00:01:56,980
أعتقد أنّ فيديو التّحوّل لنيكوماتا
.هذا سيظلّ سرًّا إذًا

41
00:01:56,980 --> 00:01:58,220
!هذا مذهل

42
00:01:58,220 --> 00:01:59,640
...كنت أتطلّع لنشره على ميتيوب

43
00:01:59,640 --> 00:02:02,180
!أرجوك يا أخي! لا تفعل ذلك

44
00:02:02,460 --> 00:02:04,770
.ظننتُ أنّه سينتشر بسرعة –
!كان ليحدث ذلك بالفعل –

45
00:02:04,770 --> 00:02:06,140
...لا تفعل رجاءً –
!كان ليحدث ذلك بالفعل –

46
00:02:06,670 --> 00:02:08,340
!إلى اللّقاء غدًا

47
00:02:08,340 --> 00:02:09,450
!نعم

48
00:02:18,840 --> 00:02:20,110
!جيرو

49
00:02:21,800 --> 00:02:24,160
.مو-تشان

50
00:02:24,600 --> 00:02:25,730
.مرحبًا بك

51
00:02:25,730 --> 00:02:26,920
!مرحبًا

52
00:02:26,920 --> 00:02:28,800
!رأيت نيكوماتا للتّوّ

53
00:02:28,800 --> 00:02:30,380
!إنّه بوتشيو قطُّ تاكومي

54
00:02:30,380 --> 00:02:33,880
هكذا إذًا؟ إذًا فقد وُلد ثانية كنيكوماتا؟

55
00:02:35,240 --> 00:02:37,940
.إنّك ترتدي قميصًا رائعًا جدًّا اليوم

56
00:02:37,940 --> 00:02:39,680
لاحظتِ ذلك؟

57
00:02:39,680 --> 00:02:41,510
.إنّك ترتدي قمصانًا غريبة في العادة

58
00:02:41,510 --> 00:02:45,140
.على رسلك. لن تفيدك المجاملة بأيّ شيء

59
00:02:45,140 --> 00:02:46,900
...مهلاً، ربّما

60
00:02:46,900 --> 00:02:48,100
ماذا؟

61
00:02:48,380 --> 00:02:50,980
!تفضّلي! مثلّجات

62
00:02:51,600 --> 00:02:53,400
.فزت بها في متجر البقالة

63
00:02:53,400 --> 00:02:54,680
أيمكنني أخذها؟

64
00:02:54,680 --> 00:02:55,930
.أكيد

65
00:02:55,930 --> 00:02:57,380
!شكرًا لك

66
00:02:57,380 --> 00:02:58,940
!بعد إذنك

67
00:02:58,940 --> 00:03:01,030
.الجوّ حارّ، لذلك احتمي في الظّلّ

68
00:03:01,230 --> 00:03:02,030
!حاضرة

69
00:03:02,630 --> 00:03:04,480
ألن تذهب للمنزل؟

70
00:03:04,480 --> 00:03:08,050
.سأذهب. فكّرت في أن يوصلني العجوز

71
00:03:08,050 --> 00:03:09,130
لماذا؟

72
00:03:09,130 --> 00:03:10,440
.لأنّ الجوّ حارّ

73
00:03:10,440 --> 00:03:12,080
لا يمكنك الطّيران للمنزل؟

74
00:03:12,080 --> 00:03:15,020
.الطّيران متعب للغاية في الحقيقة

75
00:03:15,020 --> 00:03:18,260
الأمر أشبه بالرّكض طوال الطّريق
.إلى المنزل بالنّسبة للبشر

76
00:03:18,560 --> 00:03:20,160
.يبدو ذلك فظيعًا

77
00:03:20,160 --> 00:03:21,500
.أكيد

78
00:03:21,500 --> 00:03:23,250
.مرحبًا، هذا جيرو

79
00:03:23,250 --> 00:03:26,100
.نعم، اشتريت الدّقيق أيضًا

80
00:03:26,100 --> 00:03:29,890
على أيّ حال، هل يمكنك المجيء
لتقلّني بما أنّ الجوّ حارّ؟

81
00:03:29,890 --> 00:03:31,850
.أنا في محطّة الحافلات

82
00:03:32,380 --> 00:03:36,040
...ماذا؟ لكنّ درجة الحرارة 34

83
00:03:36,040 --> 00:03:38,730
.نعم، حسنًا

84
00:03:39,110 --> 00:03:40,400
هل رفض؟

85
00:03:40,400 --> 00:03:41,950
.رفض بالفعل

86
00:03:42,260 --> 00:03:44,990
.قال أنّه لا يجب السّماح للحرارة بالتّغلّب عليّ

87
00:03:45,430 --> 00:03:46,280
ماذا؟

88
00:03:46,500 --> 00:03:49,200
جفّ عرقي! هل ذلك من فعلك؟

89
00:03:49,200 --> 00:03:50,450
ألديك قوّة خارقة؟

90
00:03:50,450 --> 00:03:52,630
.نعم. أنا الفاعل

91
00:03:53,000 --> 00:03:56,650
في الحقيقة، استعملتُ قوّتي
.الخارقة قبل ذلك أيضًا

92
00:03:56,650 --> 00:03:57,820
ماذا؟! متى؟

93
00:03:57,820 --> 00:03:59,000
.لن أخبرك

94
00:03:59,000 --> 00:04:00,650
!كلاّ

95
00:04:03,960 --> 00:04:09,390
.في هذه الأرض، يعيش النّاس والآلهة معًا

96
00:04:09,990 --> 00:04:13,770
وفي نهاية المطاف، بدأت كائنات
بقوى وأشكال غريبة

97
00:04:13,770 --> 00:04:15,930
.تُدعى "أياشي" بالظّهور

98
00:04:16,670 --> 00:04:19,390
...كائنات منحتها الآلهة الحياة

99
00:04:19,710 --> 00:04:23,400
كائنات وُلدت من قلوب النّاس
...والقوى الغامضة لكلماتهم

100
00:04:23,860 --> 00:04:27,600
.وهكذا بدأت الأياشي بالعيش بين البشر

101
00:04:27,600 --> 00:04:31,100
،حتّى بعد عودة العديد من الآلهة للسّماء

102
00:04:31,100 --> 00:04:33,410
.واصلت تلك الكائنات العيش ضمن البشر

103
00:04:34,640 --> 00:04:38,000
،والآن، هنا في فوتشيغاموري

104
00:04:38,000 --> 00:04:41,910
مدينة الوادي حيث تهبّ الرّياح
...في كثير من الأحيان

105
00:06:14,340 --> 00:06:17,020
...سجلّ إعادة ولادة اليوكاي

106
00:06:17,020 --> 00:06:19,230
دليل التّأمين الصّحّيّ لليوكاي؟

107
00:06:19,520 --> 00:06:22,820
هل تريد منّي القيام بالمعاملات الورقيّة؟

108
00:06:22,820 --> 00:06:26,770
!كلاّ! أريد أن أحاول القيام بالأمور بنفسي

109
00:06:26,770 --> 00:06:28,050
.حسنًا

110
00:06:28,050 --> 00:06:31,730
،إذًا سأساعدك على فهمها ببطء
.لذلك لا داعي من القلق

111
00:06:31,730 --> 00:06:32,410
!حاضر

112
00:06:32,720 --> 00:06:36,960
لكنّنا عائلة كما تعلم، لذلك ليس عليك
.التّحدّث معي بأدب شديد هكذا

113
00:06:36,960 --> 00:06:39,940
.أنا آسف. هذه طبيعتي فحسب

114
00:06:40,320 --> 00:06:41,380
...لكن

115
00:06:41,990 --> 00:06:44,840
.أنا مسرور لأنّنا عائلة

116
00:06:45,830 --> 00:06:47,840
،وُلدت من جديد كنيكوماتا

117
00:06:48,310 --> 00:06:50,220
.وهنّأتموني جميعًا على ذلك

118
00:06:51,160 --> 00:06:52,380
.أنا جدّ سعيد

119
00:06:55,130 --> 00:06:56,360
.بالطّبع

120
00:07:02,240 --> 00:07:04,160
.يا بوتشيو

121
00:07:04,160 --> 00:07:08,240
هل أستطيع استعمال شكل النّيكوماتا
خاصّتك لمشروعي الحرفيّ الصّيفيّ؟

122
00:07:08,460 --> 00:07:12,930
عفوًا... سأقدّر لك الأمر
.إن استعملت شكلي الأصليّ

123
00:07:12,930 --> 00:07:15,180
.أظنّ ذلك. مفهوم

124
00:07:16,680 --> 00:07:18,410
...اسمع يا بوتشيو

125
00:07:18,680 --> 00:07:21,800
هل يمكنك استعمال قوى اليوكاي أو ما شابه؟

126
00:07:21,800 --> 00:07:23,880
قوى اليوكاي؟

127
00:07:24,040 --> 00:07:25,650
.القوى الخارقة للطّبيعة

128
00:07:25,650 --> 00:07:29,010
.أنا... لستُ واثقًا من ذلك بعد

129
00:07:29,010 --> 00:07:30,470
.لا أدري ما الّذي يمكنني فعله

130
00:07:30,940 --> 00:07:34,550
إنّ أفضل طريقة لاكتشاف ذلك
.هي بسؤال اليوكاي الآخرين

131
00:07:35,100 --> 00:07:36,180
كجيرو مثلاً؟

132
00:07:36,460 --> 00:07:40,800
أليس جيرو-سان غرابَ تنغو يحمي الجبال؟

133
00:07:40,800 --> 00:07:42,170
.نعم، نعم

134
00:07:42,170 --> 00:07:45,320
.وهناك التّنغو العجوز المدعوّ تازنبو-سان أيضًا

135
00:07:45,320 --> 00:07:48,280
.على الأرجح أنّه سيقدّم لك نصيحة جيّدة

136
00:07:51,500 --> 00:07:53,410
!مـ-مرحبًا

137
00:07:53,600 --> 00:07:55,620
.تفضّل، تفضّل

138
00:07:55,620 --> 00:07:58,870
.أيّها العجوز. بوتشيو-كُن هنا

139
00:07:59,480 --> 00:08:01,580
.هكذا إذًا؟ مرحبًا بك

140
00:08:02,410 --> 00:08:05,710
!سـ-سررت بلقائك! اسمي بوتشيو

141
00:08:05,920 --> 00:08:08,670
يملك العجوز وجهًا مخيفًا بالفعل، صحيح؟

142
00:08:09,280 --> 00:08:11,810
.جيرو، حضّر بعض الشّاي

143
00:08:11,810 --> 00:08:13,380
.آسف

144
00:08:14,600 --> 00:08:17,010
هل بدأت تعتاد على جسد
النّيكوماتا خاصّتك بعد؟

145
00:08:17,380 --> 00:08:20,140
.نعم، شيئًا فشيئًا

146
00:08:20,790 --> 00:08:24,620
كانت المعاملات الورقيّة خلال
.الأسبوعين الماضيين الجزء الأصعب

147
00:08:24,620 --> 00:08:27,110
.أراهن أنّ ذلك كان صعبًا

148
00:08:27,310 --> 00:08:30,360
،العشرين هو سنّ شيخوخة متقدّم للقطط

149
00:08:30,360 --> 00:08:34,090
.أمّا كيوكاي... فأنت أشبه بمتخرّج جديد

150
00:08:34,090 --> 00:08:35,260
.ابذل جهدك

151
00:08:35,260 --> 00:08:37,070
!سأفعل

152
00:08:38,360 --> 00:08:42,830
بصراحة، إنّ ما حدث قبل قليل
.جعلني قلقًا بعض الشّيء

153
00:08:43,420 --> 00:08:46,850
.لا أعرف أيّ شيء عن نفسي

154
00:08:47,330 --> 00:08:49,410
.أنا آسف. لا أدري ما كان ذلك

155
00:08:50,260 --> 00:08:51,630
...لا عليك

156
00:08:51,630 --> 00:08:55,840
إنّ أفضل ما تقوم به عندما تكون جديدًا
.هو التّحدّث إلى الكثير من الأشخاص

157
00:08:56,300 --> 00:08:58,720
.سنقدّم لك يد العون

158
00:09:01,230 --> 00:09:02,940
.شكرًا جزيلاً

159
00:09:10,680 --> 00:09:12,680
!إنّه ديدارابوتشي

160
00:09:12,680 --> 00:09:14,820
.أتساءل إن كان سيجلب معه أمطارًا

161
00:09:20,750 --> 00:09:22,380
!مرحبًا

162
00:09:22,380 --> 00:09:23,450
جيرو؟

163
00:09:23,820 --> 00:09:25,800
!أحضرت لك صحيفة البلدة

164
00:09:25,800 --> 00:09:28,540
.مرحبًا بك. أشكرك على ذلك

165
00:09:30,720 --> 00:09:32,700
هل تُعدّ سوشي التشيراشي؟

166
00:09:32,700 --> 00:09:33,960
.لا

167
00:09:34,680 --> 00:09:36,120
.إنّه سوشي الإيناري

168
00:09:36,120 --> 00:09:38,880
.أنا لا أحبّ سوشي الإيناري كثيرًا

169
00:09:38,880 --> 00:09:39,720
فعلاً؟

170
00:09:40,070 --> 00:09:42,720
.أراهن أنّك ستحبّينه إن أعددتِه

171
00:09:42,720 --> 00:09:43,970
أتريدين مساعدتي؟

172
00:09:45,280 --> 00:09:47,130
.ليس لديّ خيار آخر

173
00:09:47,130 --> 00:09:48,290
.مرحى

174
00:09:53,550 --> 00:09:54,400
!انتهيت

175
00:09:54,400 --> 00:09:56,140
.يبدو جيّدًا

176
00:09:56,140 --> 00:09:56,820
!نعم

177
00:09:57,520 --> 00:09:59,970
هل تتحدّث الصّحيفة عن المهرجان؟

178
00:09:59,970 --> 00:10:02,320
.نعم. جدول المهرجان

179
00:10:02,320 --> 00:10:04,540
...أتى ذلك الوقت من السّنة بسرعة

180
00:10:04,830 --> 00:10:07,170
ستكونين راهبة، صحيح؟

181
00:10:07,170 --> 00:10:07,970
.نعم

182
00:10:08,240 --> 00:10:10,250
كيف تجري تداريب رقصة النّار؟

183
00:10:10,460 --> 00:10:12,200
!إنّها صعبة للغاية

184
00:10:12,200 --> 00:10:15,520
.حفظتُ الرّقصة، لكنّ التّدريب مزعج للغاية

185
00:10:15,520 --> 00:10:16,720
.فهمت

186
00:10:17,190 --> 00:10:19,880
.كما لن أستمتع بالمهرجان أيضًا

187
00:10:19,880 --> 00:10:20,930
.هذا سخيف

188
00:10:24,400 --> 00:10:28,240
مو-تشان، لماذا لا نضع
سوشي الإيناري على المذبح؟

189
00:10:28,240 --> 00:10:29,060
.حسنًا

190
00:10:31,000 --> 00:10:33,890
هل تحبّ الآلهة سوشي الإيناري؟

191
00:10:33,890 --> 00:10:36,780
.أعتقد أنّ الإله المحلّيّ هنا يحبّه

192
00:10:36,780 --> 00:10:37,770
فهلاً؟

193
00:10:50,390 --> 00:10:52,380
،إنّنا لا نلاحظ في العادة

194
00:10:52,380 --> 00:10:56,580
.لكنّ الآلهة تراقبنا دائمًا

195
00:10:56,580 --> 00:10:57,960
،إنّها لا تقول أيّ شيء

196
00:10:58,190 --> 00:11:00,420
.لكنّها تستمع لنا بكلّ تأكيد

197
00:11:03,750 --> 00:11:05,940
.حظًّا سعيدًا لك في تداريب الرّقص

198
00:11:05,940 --> 00:11:06,790
.شكرًا

199
00:11:11,900 --> 00:11:13,260
.إنّها تُمطر

200
00:11:13,260 --> 00:11:16,080
.ربّما ذلك بسبب الدّيدارابوتشي

201
00:11:16,080 --> 00:11:16,860
.نعم

202
00:11:18,360 --> 00:11:21,260
.سيحين موعد مهرجان القناديل قريبًا

203
00:11:22,320 --> 00:11:23,220
.نعم

204
00:11:31,500 --> 00:11:33,940
.آسف لدعوتك إلى هنا دون سابق إنذار

205
00:11:33,940 --> 00:11:35,380
.لا بأس

206
00:11:35,620 --> 00:11:37,050
...عفوًا

207
00:11:37,050 --> 00:11:39,510
.هناك شخص أريدك أن تقابله بشدّة

208
00:11:39,800 --> 00:11:41,010
...حسنًا

209
00:11:41,010 --> 00:11:44,240
هل وجدت أيّ شيء تودّ القيام به؟

210
00:11:44,240 --> 00:11:44,890
ماذا؟

211
00:11:45,230 --> 00:11:46,720
...لا، ليس بعد

212
00:11:47,140 --> 00:11:51,130
لكنّي سمعت أنّ التّحوّل هو من
.قدرات النّيكوماتا الأساسيّة الشّائعة

213
00:11:51,130 --> 00:11:52,190
...التّحوّل

214
00:11:52,520 --> 00:11:56,240
.كنت أبحث في أشياء مثل دروس التّحوّل

215
00:11:56,240 --> 00:11:59,020
.فهمت. هذا جيّد

216
00:11:59,020 --> 00:11:59,690
ماذا؟

217
00:12:08,790 --> 00:12:10,610
.أنت هو بوتشيو-كُن إذًا

218
00:12:10,610 --> 00:12:11,660
!نـ-نعم

219
00:12:12,000 --> 00:12:13,050
...إنّها

220
00:12:14,360 --> 00:12:17,070
...تحدّق بي بشدّة

221
00:12:18,480 --> 00:12:19,250
...حسنًا

222
00:12:19,750 --> 00:12:21,360
.سيفي هذا بالغرض

223
00:12:21,360 --> 00:12:23,590
إذًا ستقبلين به؟

224
00:12:23,980 --> 00:12:26,900
...بما أنّه طلب منك ومن تازنبو-ساما

225
00:12:26,900 --> 00:12:27,930
...عفوًا

226
00:12:28,150 --> 00:12:31,270
أنا آسف، لكن... عمّ تتحدّثان؟

227
00:12:31,760 --> 00:12:33,860
ماذا؟ ألم تخبراه؟

228
00:12:33,860 --> 00:12:34,640
.لا

229
00:12:34,990 --> 00:12:36,760
!مفاجأة

230
00:12:36,760 --> 00:12:37,980
.كم هذا مزعج

231
00:12:38,200 --> 00:12:39,940
...عفوًا

232
00:12:42,350 --> 00:12:45,410
.بصفتك نيكوماتا، فلديك موهبة فطريّة للتّحوّل

233
00:12:47,940 --> 00:12:49,950
.لن تتقدّم أبدًا إن لم تستعملها

234
00:12:51,870 --> 00:12:53,880
.دعني أعرّفك بها

235
00:12:54,960 --> 00:12:58,000
إنّها باكيغيتسوني واسمها
.تاتشيباما يوري-تشان

236
00:12:58,000 --> 00:13:01,380
.إنّها المعلّمة الّتي ستعلّمك كيف تتحوّل

237
00:13:06,200 --> 00:13:08,180
!أتقول الحقيقة؟

238
00:13:08,990 --> 00:13:10,730
.تساهلي معه رجاءً

239
00:13:11,550 --> 00:13:14,770
!معلّمتي... الخاصّة

240
00:13:17,300 --> 00:13:18,190
...حسنًا

241
00:13:18,440 --> 00:13:21,270
.سيصل الجدّ إلى البيت قريبًا

242
00:13:26,670 --> 00:13:27,620
.ربّما هذا هو

243
00:13:27,620 --> 00:13:29,690
.تارو، لا تنبح

244
00:13:37,210 --> 00:13:41,160
.ما هذا؟ أوشورو-ساما هنا، ولكنّ الجدّ لا

245
00:13:41,160 --> 00:13:42,210
فعلاً؟

246
00:13:42,210 --> 00:13:44,250
هل هو في الدّاخل؟

247
00:13:44,250 --> 00:13:47,010
.لطالما كان عديم الصّبر

248
00:13:47,010 --> 00:13:50,660
.موتسومي، أعطي بعض الطّعام لأوشورو-ساما

249
00:13:50,660 --> 00:13:52,260
.واشكريه على قدومه

250
00:13:52,520 --> 00:13:54,050
!شكرًا على قدومك

251
00:14:03,560 --> 00:14:05,850
.يا له من أوشورو-ساما ودود

252
00:14:05,850 --> 00:14:08,990
.لأنّني صنعته ليعيد جدّي للمنزل

253
00:14:09,190 --> 00:14:11,980
!أعطه ماءً أيضًا

254
00:14:11,980 --> 00:14:13,620
!مفهوم

255
00:14:17,020 --> 00:14:18,730
ما الخطب يا مو-تشان؟

256
00:14:18,730 --> 00:14:21,240
.ذهب جدّي إلى غرفة التّلفاز

257
00:14:21,240 --> 00:14:24,140
.معك حقّ. رأيته أنا أيضًا

258
00:14:24,140 --> 00:14:25,800
.أراهن أنّه يريد مشاهدة السّباقات

259
00:14:30,510 --> 00:14:31,270
.تفضّل

260
00:14:32,110 --> 00:14:33,300
.يمكنك الأكل

261
00:14:41,590 --> 00:14:43,660
لم ترَ أبي؟

262
00:14:45,230 --> 00:14:49,450
...كنتُ آمل أن يعود للمنزل مع جدّي

263
00:14:59,160 --> 00:15:03,630
.سيكون والدك حزينًا إن تصرّفتِ كأنّه ميت

264
00:15:09,580 --> 00:15:10,730
.آسفة

265
00:15:13,320 --> 00:15:16,490
.آسفة يا أبي

266
00:15:23,140 --> 00:15:25,070
...عـ-عفوًا

267
00:15:25,860 --> 00:15:27,280
يوري-سان؟

268
00:15:27,280 --> 00:15:30,610
أهذا درس تحوّل؟

269
00:15:34,550 --> 00:15:35,830
.آسف

270
00:15:36,040 --> 00:15:39,450
.أنا لا أعرف الكثير عن التّحوّل فحسب

271
00:15:40,500 --> 00:15:41,280
ماذا؟

272
00:15:41,280 --> 00:15:42,580
!أنا آسف

273
00:15:42,910 --> 00:15:46,040
إنّك تستعمل المقصّ الآن، صحيح؟

274
00:15:46,380 --> 00:15:47,030
ماذا؟

275
00:15:47,500 --> 00:15:50,890
لقد حوّلتَ يديك لتُناسب
.الأداة الّتي أردتَ استعمالها

276
00:15:50,890 --> 00:15:52,630
.قمتَ بذلك بلا وعي منك

277
00:15:52,980 --> 00:15:55,880
.لكنّ هذا ليس تحوّلاً

278
00:15:55,880 --> 00:15:57,850
.لن يعتبر كذلك حتّى تتحوّل بوعي منك

279
00:15:58,160 --> 00:16:00,120
...بوعيٍ منّي

280
00:16:00,120 --> 00:16:02,730
،لقد وُلتُ كباكيغيتسوني

281
00:16:02,730 --> 00:16:04,650
.لكنّك بدأت كقطّ

282
00:16:05,140 --> 00:16:06,060
.صحيح

283
00:16:06,470 --> 00:16:08,700
لماذا تحوّلتَ إلى نيكوماتا؟

284
00:16:08,700 --> 00:16:10,780
هل تعرف السّبب؟

285
00:16:16,950 --> 00:16:18,500
.لا أعرف

286
00:16:20,180 --> 00:16:21,620
.فهمت

287
00:16:22,660 --> 00:16:24,130
.أعطني يدك اليمنى

288
00:16:24,130 --> 00:16:24,790
ماذا؟

289
00:16:25,100 --> 00:16:26,720
...حسنًا

290
00:16:26,720 --> 00:16:30,200
يتطلّب التّحوّل الخيال والتّركيز

291
00:16:30,200 --> 00:16:32,660
.وشعورًا بالوعي الذّاتيّ

292
00:16:37,070 --> 00:16:38,900
!يـ-يدي

293
00:16:38,900 --> 00:16:42,020
إنّه تمرين تدريبيّ تعليميّ نقوم به
.نحن الباكيغيتسوني كأطفال

294
00:16:42,620 --> 00:16:43,980
مهمّتك الأولى

295
00:16:43,980 --> 00:16:46,980
.هي تحويل يدك إلى يد بشريّة

296
00:16:48,040 --> 00:16:49,620
.تعلّم ما هو شعور اليد

297
00:16:49,620 --> 00:16:50,190
!ماذا؟

298
00:16:50,190 --> 00:16:52,370
!سنبدأ بشيء كهذا مباشرة؟

299
00:16:52,370 --> 00:16:53,970
.سأعلّمك كيف تجعل الأمر أسهل

300
00:16:53,970 --> 00:16:56,180
.لا تعتد على الأمر فحسب
.بل عليك بذل جهد

301
00:17:09,360 --> 00:17:09,960
—نجحت

302
00:17:12,680 --> 00:17:14,210
.بذلتَ جهدًا أكثر من اللاّزم

303
00:17:14,210 --> 00:17:15,430
...آسف

304
00:17:15,870 --> 00:17:18,140
،يبدو أنّك تعرف كيف تتصوّر الأمر

305
00:17:18,140 --> 00:17:20,140
.لكنّك تفتقر للتّركيز

306
00:17:25,870 --> 00:17:27,490
هل أنت متوتّر؟

307
00:17:27,490 --> 00:17:29,810
...ما...؟ إنّني

308
00:17:29,810 --> 00:17:31,220
هل أنت خائف منّي؟

309
00:17:33,040 --> 00:17:34,480
.ليس عليك إخفاء ذلك

310
00:17:35,710 --> 00:17:38,380
.نعم. أنا آسف

311
00:17:40,430 --> 00:17:42,160
.أعتقد أنّ ذلك مسلّم به

312
00:17:44,170 --> 00:17:45,620
!بوتشيو

313
00:17:45,920 --> 00:17:47,670
.أتينا لنرى كيف تُبلي

314
00:17:47,800 --> 00:17:50,190
!تاكومي-كُن! ريو-كُن

315
00:17:51,260 --> 00:17:52,800
.مرحبًا يا يوري-سان

316
00:17:52,800 --> 00:17:53,760
.مرحبًا

317
00:17:53,760 --> 00:17:54,640
.أهلاً

318
00:17:54,640 --> 00:17:56,740
كيف هو الوضع يا بوتشيو؟

319
00:17:57,460 --> 00:17:59,560
.يبدو أنّه خائف منّي

320
00:17:59,560 --> 00:18:01,540
ولماذا ذلك؟

321
00:18:02,100 --> 00:18:04,180
.هيّا. جرّب ذلك ثانية

322
00:18:04,180 --> 00:18:05,560
...ماذا؟ لكن

323
00:18:06,040 --> 00:18:07,940
.تشجّع يا بوتشيو

324
00:18:22,920 --> 00:18:24,010
...نجحت

325
00:18:24,500 --> 00:18:26,490
!لقد نجح يا يوري-سان

326
00:18:26,490 --> 00:18:27,810
!هذا مذهل

327
00:18:27,810 --> 00:18:29,330
.جيّد. لقد نجحت

328
00:18:29,670 --> 00:18:31,760
!أحسنت يا بوتشيو

329
00:18:31,760 --> 00:18:32,780
!نعم

330
00:18:33,430 --> 00:18:36,260
!كلّ هذا لأنّك بقيت إلى جانبي وشجّعتني

331
00:18:45,660 --> 00:18:46,640
.لقد عدت

332
00:18:46,880 --> 00:18:49,600
.هكذا إذًا... حسنًا

333
00:18:50,430 --> 00:18:51,290
.نعم

334
00:18:52,240 --> 00:18:54,900
.حسنًا

335
00:19:08,710 --> 00:19:11,940
...يوري-تشان، بشأن الشّواء يوم الأحد

336
00:19:13,350 --> 00:19:15,730
مو-تشان؟ ما الخطب؟

337
00:19:15,730 --> 00:19:16,710
...جيرو

338
00:19:22,470 --> 00:19:25,130
.آسف. سأتّصل بك لاحقًا

339
00:19:26,840 --> 00:19:28,110
ما الخطب؟

340
00:19:30,420 --> 00:19:32,350
هل حدث أمر مخيف؟

341
00:19:37,700 --> 00:19:39,450
.ستكونين بخير

342
00:19:40,910 --> 00:19:42,420
.كلّ شيء بخير

343
00:19:50,850 --> 00:19:52,650
أتريد بعض الكرفس؟

344
00:19:52,650 --> 00:19:53,960
.شكرًا لك

345
00:19:53,960 --> 00:19:56,680
.هناك من أعطاه لنا، لكنّه أكثر ممّا يمكننا أكله

346
00:19:56,680 --> 00:19:58,170
.نقدّر لك هذا

347
00:19:58,500 --> 00:20:01,660
.أعتقد أنّي سأستعمله في عشاء اليوم

348
00:20:03,750 --> 00:20:05,070
هل من خطب ما؟

349
00:20:06,040 --> 00:20:07,190
...في الحقيقة

350
00:20:08,070 --> 00:20:09,640
.اتّصل بي محقّق

351
00:20:09,640 --> 00:20:12,590
.كان الأمر... عنه

352
00:20:13,340 --> 00:20:16,880
حقّقنا في إمكانيّة اختطافه
،أو اختفائه بشكل غامض

353
00:20:16,880 --> 00:20:18,150
...ولكن نظرًا للظّروف

354
00:20:18,310 --> 00:20:21,620
يؤسفني أن أقول أنّه ربّما ابتُلع
،من طرف الفراغ

355
00:20:21,620 --> 00:20:25,100
.بُعد خياليّ بين هذه الحياة والحياة الآخرة

356
00:20:26,710 --> 00:20:29,460
،بحثت في قضايا أشخاص مفقودين آخرين

357
00:20:29,460 --> 00:20:31,030
...لذلك كنت مستعدّة لسماع هذا، لكن

358
00:20:31,840 --> 00:20:32,980
هل أخبرت الجميع؟

359
00:20:33,910 --> 00:20:35,790
.لم أخبر الأطفال

360
00:20:36,400 --> 00:20:37,630
.فهمت

361
00:20:38,820 --> 00:20:41,820
.لا تكبتي الأمر بداخلك
.يمكنك الحديث معنا في أيّ وقت

362
00:20:41,820 --> 00:20:44,090
.نحن هنا لتقديم المساعدة دومًا

363
00:20:44,090 --> 00:20:46,570
.أنا محظوظة لامتلاكي جيرانًا يُعتمد عليهم مثلكما

364
00:20:46,950 --> 00:20:48,350
.شكرًا لك

365
00:20:48,910 --> 00:20:51,560
.إنّنا جيران منذ وقت طويل

366
00:20:51,560 --> 00:20:53,750
.وقت طويل جدًّا

367
00:21:00,540 --> 00:21:02,750
إنّه ليس خطأ أيّ أحد، صحيح؟

368
00:21:03,030 --> 00:21:05,950
.صحيح. ليس خطأ أيّ أحد

369
00:21:06,190 --> 00:21:08,980
.إنّ البشر لا يملكون فهمًا راسخًا لجوهرهم

370
00:21:08,980 --> 00:21:11,410
.هناك أمور لا يمكنهم فعل أيّ شيء حيالها

371
00:21:16,180 --> 00:21:20,610
.أعتقد أنّ مو-تشان تعرف ما حدث لوالدها

372
00:21:20,610 --> 00:21:22,850
لأنّ بإمكانها رؤية الأمر؟

373
00:21:22,850 --> 00:21:23,550
.نعم

374
00:21:23,980 --> 00:21:26,660
،تعلم أنّ الفراغ ابتلعه

375
00:21:26,660 --> 00:21:29,810
.لكنّها لا تستطيع قبول حقيقة أنّه اختفى

376
00:21:31,140 --> 00:21:34,530
،سأكون موجودًا لملء الفراغ الّذي تركه والدها

377
00:21:35,030 --> 00:21:37,470
.إلى أن تصير قادرة على قبول الحقيقة

378
00:21:40,210 --> 00:21:41,440
...جيرو

379
00:21:41,640 --> 00:21:45,040
.لهذا السّبب بالضّبط أنت نصف رجل فحسب

380
00:21:45,040 --> 00:21:48,030
.إنّ هذا هو جوهري في النّهاية

381
00:21:48,360 --> 00:21:51,450
على أيّ حال، أيّ نوع
من المايونيز تريد مع الكرفس؟

382
00:21:51,450 --> 00:21:52,990
.مايونيز الميسو

383
00:21:53,240 --> 00:21:54,570
.وليكن الميسو أحمرًا

384
00:21:54,570 --> 00:21:56,710
ماذا عن حساء الميسو لهذا اليوم إذًا؟