1
00:00:04,950 --> 00:00:09,180
.كان المكان يُغطّى بثلج ناصع البياض

2
00:00:12,600 --> 00:00:15,240
أحببت ذلك الوقت من السّنة
،عندما تفتّحت الزّهور هناك

3
00:00:15,700 --> 00:00:17,560
.مشيرة لنهاية ذلك الموسم

4
00:00:19,190 --> 00:00:20,680
أردت حبس

5
00:00:22,440 --> 00:00:24,290
.تلك اللّحظة الوجيزة للأبد

6
00:02:02,480 --> 00:02:05,510
.هناك الكثير من الأكشاك

7
00:02:08,640 --> 00:02:10,400
.مرحبًا يا تاتشيبانا-سان

8
00:02:10,400 --> 00:02:13,400
.مرحبًا. مسرورة دائمًا للعمل معك

9
00:02:13,400 --> 00:02:15,790
.هذا هو المنتوج الجديد الّذي ذكرتُه

10
00:02:16,230 --> 00:02:18,110
!دبابيس

11
00:02:18,600 --> 00:02:22,600
.إنّها رائعة! أراهن أنّها ستُباع بسرعة أيضًا

12
00:02:24,690 --> 00:02:26,080
!واغن-سان

13
00:02:26,080 --> 00:02:29,140
.هذا أنت يا بوتشيو-سان. يا لها من مصادفة

14
00:02:33,490 --> 00:02:38,180
مرحبًا. أنت هو بوتشيو-سان؟

15
00:02:38,180 --> 00:02:39,430
.سررت بلقائك

16
00:02:39,550 --> 00:02:41,200
.هذا هو شريكي

17
00:02:41,200 --> 00:02:44,030
.نعم... سررت بلقائك

18
00:02:44,320 --> 00:02:47,850
.اسمي نيشيا. أخبرني تشياكي الكثير عنك

19
00:02:47,850 --> 00:02:50,480
.أنا مسرور لأنّي استطعتُ لقاءك

20
00:02:50,480 --> 00:02:52,240
.كنتُ آمل لقاءك بالفعل

21
00:02:53,470 --> 00:02:54,690
...شكرًا

22
00:02:55,230 --> 00:02:59,560
.شكرًا لك لأنّك صديق لتشياكي

23
00:03:01,120 --> 00:03:05,000
.كازوهيكو-سان، إنّك تحاول التّعمّق كثيرًا هنا

24
00:03:05,000 --> 00:03:06,850
فعلاً؟

25
00:03:08,420 --> 00:03:11,790
إذًا هذه من صنع تاتشيبانا-سان؟

26
00:03:12,070 --> 00:03:13,710
.يا لها من مفاجأة

27
00:03:13,710 --> 00:03:16,710
.كنتُ أشتري أعمالها كثيرًا

28
00:03:17,470 --> 00:03:21,050
هل تقصد... لزوجتك؟

29
00:03:21,050 --> 00:03:21,870
.نعم

30
00:03:22,160 --> 00:03:25,400
.كانت زوجتي ترتدي دبابيس كهذه عادة

31
00:03:25,400 --> 00:03:26,640
.لقد أحبّتها كثيرًا

32
00:03:27,160 --> 00:03:29,620
.كانت جزءًا منها ببساطة

33
00:03:31,580 --> 00:03:34,150
وأين هي الآن؟

34
00:03:34,680 --> 00:03:37,320
.توفّيت السّنة الماضية جرّاء المرض

35
00:03:39,360 --> 00:03:41,290
،قالت لي في إحدى المرّات

36
00:03:41,740 --> 00:03:45,820
إنّ الأشياء الّتي يصنعها"
.هذا الشّخص ليست برّاقة

37
00:03:45,820 --> 00:03:50,030
الأمر أشبه بحبس لحظة من الموسم عندما
.كانت هذه الزّهور متفتّحة في كلّ دبّوس

38
00:03:50,030 --> 00:03:51,580
".إنّها جميلة جدًّا

39
00:03:53,430 --> 00:03:55,170
القدر شيء غريب، صحيح؟

40
00:03:55,560 --> 00:03:56,520
...نعم

41
00:03:58,030 --> 00:04:00,950
.أنا آسف. لم أقصد جعل الوضع حزينًا

42
00:04:07,600 --> 00:04:12,090
من الغريب أن أعرف أنّ الأشياء
.الّتي أصنعها تُستعمل بالفعل

43
00:04:12,090 --> 00:04:13,690
فعلاً؟

44
00:04:14,310 --> 00:04:17,610
حبس الموسم"؟"

45
00:04:18,470 --> 00:04:25,530
ربّما غروري هو الّذي جعلني أقطع تلك
.الزّهور عندما تكون في أجمل حالاتها

46
00:04:29,880 --> 00:04:30,760
.هيّا بنا

47
00:04:51,900 --> 00:04:52,880
.يوري

48
00:04:53,550 --> 00:04:55,120
.آسف لجعلك تنتظرين

49
00:04:58,040 --> 00:05:00,610
لم تزوري ساحة الرّماية منذ مدّة الآن؟

50
00:05:00,610 --> 00:05:02,940
.نعم... كنتُ أتفاداها

51
00:05:02,940 --> 00:05:04,930
لماذا قرّرت المجيء الآن؟

52
00:05:06,420 --> 00:05:07,970
.أردت الحديث

53
00:05:08,720 --> 00:05:10,410
عن عائلتك؟

54
00:05:12,070 --> 00:05:15,260
.أجد نفسي أتذكّر أشياء مؤخّرًا

55
00:05:16,060 --> 00:05:20,840
أردتُ نسيان عائلتي وبدء
...حياة جديدة هنا

56
00:05:21,660 --> 00:05:23,770
ما الّذي تغيّر الآن؟

57
00:05:24,940 --> 00:05:26,490
.لا أدري

58
00:05:27,140 --> 00:05:30,060
.أردتُ النّسيان بشدّة من قبل

59
00:05:30,650 --> 00:05:35,160
ربّما السّبب هو أنّك عميقًا في داخلك
.تودّين أن تواجهي عائلتك

60
00:05:37,090 --> 00:05:40,860
،حتّى إن كان ذلك صحيحًا
.لن يواجهني أيّ منهم

61
00:05:41,340 --> 00:05:44,080
لقد فرضوا عليّ أفكارهم القديمة

62
00:05:44,080 --> 00:05:46,190
.باسم الحفاظ على التّقاليد

63
00:05:46,190 --> 00:05:49,120
،عندما حاولت التّعبير عن رأيي
.رفضوا الاستماع إليّ

64
00:05:49,120 --> 00:05:52,960
!لذلك السّبب بالتّحديد أقسمت ألاّ أعود أبدًا

65
00:05:54,800 --> 00:05:58,930
.لستُ أنا من عليك تشارك هذه المشاعر معه

66
00:06:00,690 --> 00:06:02,260
.تحدّثي لوالدك

67
00:06:03,120 --> 00:06:07,050
،إن كنت لا تريدين نسيانهم
.اذهبي إليهم بنفسك

68
00:06:09,880 --> 00:06:12,240
.ليس لديّ أيّ سبب يدفعني لذلك

69
00:06:14,640 --> 00:06:15,930
...تازنبو-ساما

70
00:06:16,360 --> 00:06:20,840
هل كانت لديك غاية ما عندما
جمعتَ بيني وبين بوتشيو؟

71
00:06:21,690 --> 00:06:23,450
لماذا تسألين عن ذلك؟

72
00:06:24,450 --> 00:06:25,570
.لا تهتمّ

73
00:06:25,930 --> 00:06:27,970
.آسفة لأخذي من وقتك

74
00:06:28,620 --> 00:06:29,820
.سأغادر الآن

75
00:06:37,140 --> 00:06:38,190
...ثانية

76
00:06:38,800 --> 00:06:40,630
.أنا أتذكّر ثانية

77
00:06:42,310 --> 00:06:46,040
.يوري، إن امتلاك الفخر شيء رائع

78
00:06:46,900 --> 00:06:49,050
عليك أن تفخري بالتّقاليد

79
00:06:49,050 --> 00:06:52,510
.وبدماء الباكيغيتسوني الّتي ورثتيها

80
00:06:55,540 --> 00:06:59,300
إنّ عائلةَ تاتشيبانا من تونو في منطقة توهوكو

81
00:06:59,300 --> 00:07:01,240
،حافظت على تقاليد الفنون القتاليّة لأجيال

82
00:07:01,240 --> 00:07:03,480
.مع التّركيز على فروسيّة الباكي

83
00:07:04,100 --> 00:07:07,350
.إنّها عائلة باكيغيتسوني شريفة وقديمة

84
00:07:09,280 --> 00:07:11,950
.إنّ ابنةَ تاتشيبانا الكبرى موهوبة جدًّا

85
00:07:11,950 --> 00:07:14,530
إنّ دماء العائلة الرّئيسيّة تسري
.في عروقها بالفعل

86
00:07:15,330 --> 00:07:18,260
.دماء الباكيغيتسوني الشّريفة والقديمة

87
00:07:18,910 --> 00:07:20,970
.كنتُ فخورة جدًّا بذلك

88
00:07:23,380 --> 00:07:28,480
أخبريني يا ميو-تشان، والدك بشريّ، صحيح؟

89
00:07:29,800 --> 00:07:30,620
.نعم

90
00:07:31,680 --> 00:07:32,840
لماذا؟

91
00:07:33,490 --> 00:07:36,360
،أعرف أنّك من عائلة فرعيّة

92
00:07:36,360 --> 00:07:39,290
ولكن لماذا لا تحافظ عائلتك
على دماء الباكيغيتسومي؟

93
00:07:39,720 --> 00:07:41,880
.إنّ ذلك يجعلك نِصفًا فقط

94
00:07:42,120 --> 00:07:42,810
ماذا؟

95
00:07:43,680 --> 00:07:45,600
.لستُ نِصفًا

96
00:07:46,120 --> 00:07:50,480
.تجري في عروقي دماء أبي وأمّي معًا

97
00:07:50,990 --> 00:07:52,830
.لا توجد دماء أسمى أو أدنى

98
00:07:53,170 --> 00:07:56,680
وحدهم النّاس في العائلة
.الرّئيسيّة من يتحدّثون هكذا

99
00:07:58,370 --> 00:07:59,310
ماذا؟

100
00:08:01,360 --> 00:08:03,530
،عندما كرّرتُ ذلك الكلام لعائلتي

101
00:08:03,530 --> 00:08:06,380
،نظروا إليّ جميعًا وكأنّني غريبة

102
00:08:06,380 --> 00:08:07,750
.ورفضوا الاستماع إليّ

103
00:08:08,960 --> 00:08:12,390
ومنذ تلك اللّحظة، أصبحت
.حياتي خانقة أكثر وأكثر

104
00:08:13,820 --> 00:08:16,940
صار الشّتاء موسمًا عليّ أن أقضيه

105
00:08:16,940 --> 00:08:19,760
.في مكان مغلق مع عائلتي في منزل أكرهه

106
00:08:21,050 --> 00:08:25,580
كانت زهور الرّبيع الجميلة بمثابة
.وداع لتلك الأيّام المظلمة

107
00:08:26,880 --> 00:08:29,330
.كانت الزّهور بمثابة أمل لي

108
00:08:29,330 --> 00:08:30,680
...لم أرغب في فقدانها

109
00:08:31,960 --> 00:08:35,470
.لذلك حبستها لإبقائها قريبة منّي طوال الوقت

110
00:08:37,040 --> 00:08:40,680
يوري-سان؟

111
00:08:41,630 --> 00:08:43,000
هل أنت بخير؟

112
00:08:43,390 --> 00:08:46,440
...كنتِ تسحقين الزّهور

113
00:08:46,960 --> 00:08:50,030
لا يجدر بك الضّغط كثيرًا
.على نفسك إن لم ترغبي ذلك

114
00:08:50,030 --> 00:08:51,590
.لا تقلق

115
00:08:53,160 --> 00:08:55,080
...مهلاً يا يوريبّي

116
00:08:55,570 --> 00:08:59,690
إنّك متوتّرة بسبب عائلتك مؤخّرًا، صحيح؟

117
00:09:00,240 --> 00:09:02,520
.إن كنت تعلم ذلك، فلا تتدخّل

118
00:09:02,520 --> 00:09:04,330
.لا تحملي كلّ العبء وحدك

119
00:09:04,330 --> 00:09:06,870
.يمكنك الحديث معي. أنا مستعدّ لسماعك

120
00:09:06,870 --> 00:09:08,020
.اخرس

121
00:09:08,390 --> 00:09:12,250
ماذا سأجني من الحديث عن الأمر؟
.ستخبرني أنّ عليّ أن أتغيّر فحسب

122
00:09:13,040 --> 00:09:17,160
،أنا لا أريد أن أتغيّر
!ولا أنوي مسامحتهم أبدًا

123
00:09:17,160 --> 00:09:20,070
أهذا ما تشعرين به بالفعل؟

124
00:09:21,440 --> 00:09:22,310
ماذا؟

125
00:09:22,600 --> 00:09:23,830
...أنا

126
00:09:23,980 --> 00:09:28,970
،سمعتُ أنّك تخلّيت عن كلّ علاقاتك بعائلتك

127
00:09:28,970 --> 00:09:32,720
وقلتُ لنفسي لا بدّ أنّ ذلك
.يعني أنّه توجد عائلات كهذه فحسب

128
00:09:33,200 --> 00:09:35,790
،لكن مهما كان السّبب

129
00:09:35,790 --> 00:09:40,600
إن كنت ما زلت تهتمّين لأمر عائلتك
!على الإطلاق، فعليك الحديث معهم

130
00:09:40,600 --> 00:09:43,770
هناك أمور لن تعرفيها أبدًا
!إن لم تقومي بذلك

131
00:09:46,170 --> 00:09:50,690
.اسمع، إنّ رؤيتك تُغضبني بشدّة

132
00:09:51,170 --> 00:09:54,350
،عندما أراك سعيدًا جدًّا مع عائلتك

133
00:09:54,350 --> 00:09:57,920
...أشعر أنّي فاشلة ومثيرة للشّفقة

134
00:09:57,920 --> 00:10:01,070
!وكلّما حدث ذلك، تعود لي أسوأ ذكرياتي

135
00:10:01,480 --> 00:10:03,470
!إنّها غلطتك أنت

136
00:10:03,470 --> 00:10:06,270
!إنّ ما أشعر به من معاناة خطأك أنت

137
00:10:06,270 --> 00:10:06,870
!يوري

138
00:10:15,170 --> 00:10:16,310
.أتفهّم الأمر

139
00:10:16,800 --> 00:10:18,980
.اذهبي لتهدئة أعصابك لبعض الوقت

140
00:10:19,230 --> 00:10:21,520
.سأكون في انتظارك للحديث معي

141
00:10:24,920 --> 00:10:28,120
.مرحبًا! معكم محطّة الفضاء الدّوليّة

142
00:10:28,120 --> 00:10:30,840
،لقد صرت القائد هنا

143
00:10:30,840 --> 00:10:33,200
.ومعي كلّ هؤلاء الأصدقاء الّذين أثق بهم

144
00:10:33,200 --> 00:10:35,360
.ميكامي، تتصرّفين بجدّيّة كبيرة

145
00:10:36,240 --> 00:10:39,200
.يمكنكم أن تروا مدى وُدّ الجوّ الّذي بينهم

146
00:10:37,460 --> 00:10:39,200
!كم هذا مذهل

147
00:10:40,520 --> 00:10:41,820
بوتشيو؟

148
00:10:47,420 --> 00:10:49,250
هل حدث أمر ما؟

149
00:10:49,250 --> 00:10:51,450
.حدث شجار بينه وبين يوري-سان

150
00:10:55,670 --> 00:10:57,010
!بوتشيو

151
00:10:58,470 --> 00:11:00,430
أتريد تناول وجبة خفيفة معي؟

152
00:11:00,760 --> 00:11:02,890
انظر! أيّهما تفضّل؟

153
00:11:03,250 --> 00:11:05,760
.أظنّني أريد فطيرة كيوبيد

154
00:11:07,600 --> 00:11:09,910
.أريد تناول تلك أيضًا

155
00:11:09,910 --> 00:11:12,080
!حسنًا، لنحسم الأمر بحجر-ورقة-مقصّ

156
00:11:12,080 --> 00:11:13,920
!حجر، ورقة، مقصّ

157
00:11:13,920 --> 00:11:15,680
!كلاّ، خسرت

158
00:11:15,680 --> 00:11:16,780
.شكرًا على الوجبة الخفيفة

159
00:11:16,780 --> 00:11:21,200
تتواصل جهود جمع المعلومات عن مجموعة
الصّدوع الأخيرة الّتي ظهرت في الفضاء

160
00:11:21,200 --> 00:11:23,660
كجهد تعاونيّ من قبل جميع
...فروع مختبر الزّمكان

161
00:11:23,660 --> 00:11:26,830
إنّهم يتحدّثون عن هذا طوال
.الوقت في الأخبار مؤخّرًا

162
00:11:26,830 --> 00:11:31,220
بالتّفكير في الأمر، سمعتُ
.أنّه سيجري تحقيق هنا في البلدة

163
00:11:31,220 --> 00:11:32,220
تحقيق؟

164
00:11:32,220 --> 00:11:35,040
.من طرف مختبر الزّمكان هذا

165
00:11:35,040 --> 00:11:36,940
!ماذا؟ فعلاً؟

166
00:11:36,940 --> 00:11:38,000
!أريد رؤيتهم

167
00:11:38,360 --> 00:11:41,360
ألم يظهر رايجو في المدرسة مؤخّرًا؟

168
00:11:41,360 --> 00:11:44,090
!لقد ظهر من صدع في السّماء
أهذا هو سبب قدومهم؟

169
00:11:44,090 --> 00:11:48,070
!أجل! قد يطلبون منّي التّعاون في تحقيقهم

170
00:11:48,070 --> 00:11:52,560
ما الّذي يبحث فيه مختبر الزّمكان؟

171
00:11:52,560 --> 00:11:55,200
.إنّه يبحث في أمور عديدة

172
00:11:55,630 --> 00:11:57,280
الثّقوب الدّوديّة في الفضاء

173
00:11:57,280 --> 00:12:00,880
والثّقوب والتّشوّهات النّاجمة عن
...التّداخّلات في الزّمكان

174
00:12:00,880 --> 00:12:02,240
...مذهل

175
00:12:02,240 --> 00:12:04,610
!سمعتُ أنّهم يبحثون في الأبعاد البديلة أيضًا

176
00:12:04,610 --> 00:12:06,290
أبعاد بديلة؟

177
00:12:06,290 --> 00:12:08,600
!مثل العوالم الموازية

178
00:12:08,600 --> 00:12:11,470
!عوالم مختلفة بالكامل تبدو مثل عالمنا

179
00:12:11,470 --> 00:12:14,120
!لا أطيق الانتظار حتّى يبدأ هذا التّحقيق

180
00:12:14,470 --> 00:12:19,150
عوالم موازية تبدو مثل عالمنا هذا؟

181
00:12:21,400 --> 00:12:24,220
.انتهينا من ذلك التّغيير. بقي اثنان

182
00:12:24,560 --> 00:12:27,400
.كانت الرّوابط في حالة أسوأ ممّا توقّعت

183
00:12:27,400 --> 00:12:29,320
.معك حقّ

184
00:12:29,320 --> 00:12:32,720
بدأ تقدّم الزّمن يظهر على تلك
.المحطّة الّتي بلا عامل أيضًا

185
00:12:41,940 --> 00:12:43,070
!تحرّكوا

186
00:12:46,010 --> 00:12:47,580
!كان ذلك خطيرًا

187
00:12:47,580 --> 00:12:50,230
.كان يجب أن تكون القطارات قد توقّفت منذ مدّة

188
00:12:50,230 --> 00:12:51,080
...أليس هذا

189
00:12:51,360 --> 00:12:52,970
آخر قطار لليوم؟

190
00:12:57,730 --> 00:12:59,570
.لا أحد على متنه

191
00:13:02,780 --> 00:13:03,860
.هناك شخص ما

192
00:13:05,170 --> 00:13:06,540
.المعذرة

193
00:13:06,950 --> 00:13:08,450
هل أنت مسافرة؟

194
00:13:08,450 --> 00:13:11,240
...عفوًا... لستُ واثقة ممّا يحدث

195
00:13:11,240 --> 00:13:14,790
صعدت على متنه لأنّه كان آخر
،قطار، لكن لم يتوقّف

196
00:13:14,790 --> 00:13:17,100
...وفجأة لم يعد هنالك أيّ أحد

197
00:13:17,100 --> 00:13:19,450
أين أنا بالضّبط؟

198
00:13:19,450 --> 00:13:20,520
ما الخطب؟

199
00:13:21,330 --> 00:13:23,360
.تاكاياما-سان

200
00:13:23,870 --> 00:13:27,110
،أتت هذه الآنسة إلى هنا على متن القطار

201
00:13:27,260 --> 00:13:29,990
.لكن يبدو أنّها لا تعرف ما يحدث حولها

202
00:13:32,480 --> 00:13:34,160
!مهلاً

203
00:13:34,640 --> 00:13:36,350
!انتظري

204
00:13:39,200 --> 00:13:40,750
!لا تقترب منّي

205
00:13:41,170 --> 00:13:43,530
!مهلاً! هذا خطير

206
00:13:47,960 --> 00:13:48,800
...ما

207
00:13:49,440 --> 00:13:51,210
ما الّذي يحدث؟

208
00:13:57,380 --> 00:13:58,690
،باكرًا هذا الصّباح

209
00:13:58,690 --> 00:14:01,470
واجه عامل على مسار سكّة حديد
دينريو هاماناكو

210
00:14:01,470 --> 00:14:05,600
.قطارًا بدون سائق عن قرب

211
00:14:05,600 --> 00:14:09,550
لا يتّجه القطار الأخير على خطّ
.دن-هاما لأيّ مكان

212
00:14:09,550 --> 00:14:12,830
كما لا فكرة لديّ عن أين ذهبت
...تلك المرأة أيضًا

213
00:14:12,830 --> 00:14:17,160
حدّد المختبر أنّ هذه الظّاهرة
هي نتيجة لتشوه في الفضاء

214
00:14:16,010 --> 00:14:19,170
.محطّة كيساراغي؟ إنّها قريبة من هنا

215
00:14:17,160 --> 00:14:19,170
.ويقوم حاليا بالتّحقيق في الأمر

216
00:14:19,400 --> 00:14:23,080
لا بدّ أنّ هذا يعني أنّ القطار أتى
إلى هنا من عالم موازٍ، أليس كذلك؟

217
00:14:23,080 --> 00:14:27,760
هذه الصّدوع في الفضاء الّتي تحدث
.مؤخرًا هي أمر يحدث كلّ بضعة قرون

218
00:14:28,260 --> 00:14:32,070
...لكنّي لم أرها في فوتشيغاموري من قبل

219
00:14:32,530 --> 00:14:36,220
.آمل ألاّ ينتهي الأمر بالاتّصال بالبعد الخياليّ

220
00:14:38,870 --> 00:14:42,440
.إنّه نوع مختلف تمامًا من الأبعاد هذه المرّة

221
00:14:42,440 --> 00:14:46,790
،لا أستطيع تخيّل تواصل بين الاثنين
.ولكن علينا أن نكون حذرين

222
00:14:46,790 --> 00:14:47,610
.نعم

223
00:14:48,160 --> 00:14:49,480
.معك حقّ

224
00:15:12,750 --> 00:15:13,940
من هذا؟

225
00:15:18,680 --> 00:15:20,610
...أشعر بدوار مفاجئ

226
00:15:34,500 --> 00:15:36,710
.سأذهب للاطمئنان عليها أوّلاً

227
00:15:36,710 --> 00:15:37,800
.حسنًا

228
00:15:39,300 --> 00:15:41,580
.يوريبّي، أنا هنا

229
00:15:45,840 --> 00:15:46,890
يوريبّي؟

230
00:15:48,820 --> 00:15:49,790
ماذا؟

231
00:15:50,680 --> 00:15:52,020
يوريبّي؟

232
00:15:58,390 --> 00:16:00,750
!هذا أنت يا تايرا-كُن

233
00:16:00,750 --> 00:16:04,690
بدأت أشعر بدوار مفاجئ
...وشعرت بالهوان

234
00:16:04,690 --> 00:16:07,880
!ثمّ رأيت شيئًا مظلمًا في نهاية الرّواق

235
00:16:07,880 --> 00:16:09,780
!أنا خائفة جدًّا

236
00:16:12,160 --> 00:16:13,950
ما الخطب؟

237
00:16:13,950 --> 00:16:16,160
.تتصرّف يوريبّي بغرابة

238
00:16:16,160 --> 00:16:18,600
ماذا؟! ما-ماذا تقصد؟

239
00:16:19,290 --> 00:16:21,120
!هيّا، ادخل

240
00:16:21,120 --> 00:16:24,080
!كنت أتحدّث معك
لماذا أغلقت الباب؟

241
00:16:24,820 --> 00:16:26,540
يوري-سان؟

242
00:16:30,460 --> 00:16:32,540
تتكلّم من بطنك، صحيح؟

243
00:16:32,790 --> 00:16:33,630
ماذا؟

244
00:16:34,880 --> 00:16:38,430
لا، من المستحيل أن يتكلّم
.ويسير قطّ على ساقين

245
00:16:38,430 --> 00:16:40,520
.لا بدّ أنّي أحلم

246
00:16:40,520 --> 00:16:43,790
!من المضحك أنّي لاحظتُ ذلك وأنا أحلم

247
00:16:43,790 --> 00:16:46,580
على أيّ حال، إلى أين سنذهب؟

248
00:16:46,580 --> 00:16:47,750
.لن أخبرك

249
00:16:48,630 --> 00:16:51,320
.أعتذر. إليك بطاقتي

250
00:16:51,560 --> 00:16:54,030
.آسفة لأنّي طلبت منك هذا

251
00:16:54,030 --> 00:16:56,860
.شكرًا ثانية على تعاونك

252
00:16:58,600 --> 00:16:59,760
أجاءنا ضيف ما؟

253
00:16:59,760 --> 00:17:01,310
.سأفتح الباب

254
00:17:02,320 --> 00:17:06,560
أيّها العمّ! آسف لأنّي جئت
...بشكل مفاجئ، لكن

255
00:17:08,000 --> 00:17:08,950
يوري؟

256
00:17:11,570 --> 00:17:14,320
هل أنت... يوري؟

257
00:17:14,650 --> 00:17:16,800
!تـ-تنغو؟

258
00:17:16,800 --> 00:17:19,390
!مهلاً، هذا مخيف
!حتّى وإن كنتُ أعرف أنّه حلم

259
00:17:19,760 --> 00:17:21,120
هل من خطب ما؟

260
00:17:21,120 --> 00:17:23,910
.قد تكون هذه مشكلة كبيرة حقيقيّة

261
00:17:28,320 --> 00:17:29,770
!يوريبّي

262
00:17:29,770 --> 00:17:31,680
هل أنت بخير؟

263
00:17:32,730 --> 00:17:33,740
...هذا مؤلم

264
00:17:37,800 --> 00:17:39,150
...تايرا-كُن

265
00:17:39,650 --> 00:17:42,800
هذا حلم بالفعل، صحيح؟

266
00:17:42,800 --> 00:17:45,710
.لا، إنّه ليس حلمًا

267
00:17:49,500 --> 00:17:51,710
عفوًا... يوري-تشان؟

268
00:17:51,820 --> 00:17:54,010
!تايرا-كُن! افعل شيئًا

269
00:17:54,010 --> 00:17:54,670
!ماذا؟

270
00:17:54,670 --> 00:17:57,060
!ما عدت أعرف ما الّذي يحدث

271
00:17:57,880 --> 00:17:59,130
.أعتقد أنّ لا خيار أمامي

272
00:17:59,680 --> 00:18:01,810
.تايرا-كُن، أمسكها جيّدًا

273
00:18:01,810 --> 00:18:02,640
ماذا؟

274
00:18:03,170 --> 00:18:04,600
.أنا آسف

275
00:18:09,850 --> 00:18:11,220
ماذا فعلت؟

276
00:18:11,220 --> 00:18:13,420
.استعملتُ قواي لجعلها تنام

277
00:18:13,980 --> 00:18:17,040
.إنّها يوري-تشان... لكنّها ليست يوري-تشان

278
00:18:17,440 --> 00:18:19,180
.إنّها بشريّة

279
00:18:27,730 --> 00:18:29,320
لا يوجد شيء هناك؟

280
00:18:29,320 --> 00:18:30,380
يوري؟

281
00:18:30,570 --> 00:18:32,020
هل عدت؟

282
00:18:32,240 --> 00:18:33,590
مهلاً، ماذا؟

283
00:18:33,590 --> 00:18:37,040
كلب؟! ثعلب؟! كيف دخلت إلى هنا؟

284
00:18:37,040 --> 00:18:39,550
.أنت من دخل إلى هنا

285
00:18:39,550 --> 00:18:42,060
...كفاك عبثًا معي

286
00:18:53,850 --> 00:18:57,890
ما تلك الملامح الّتي علت وجهه؟
...كان ذلك مريبًا

287
00:18:58,870 --> 00:19:00,640
ما كان ذلك الّذي شهدتُه؟

288
00:19:03,920 --> 00:19:07,360
.أكره قول هذا، لكن عليّ الذّهاب إلى جيرو

289
00:19:13,020 --> 00:19:14,230
.هذا غريب

290
00:19:18,510 --> 00:19:20,960
.يجدر أن يكون منزل جيرو هنا

291
00:19:23,080 --> 00:19:25,010
.مرحبًا يا يوري-نِتشان

292
00:19:25,010 --> 00:19:27,540
!تسريحة جديدة؟ إنّها ذيل الحصان

293
00:19:28,780 --> 00:19:32,230
لا... موتسومي، أتعرفين أين جيرو؟

294
00:19:32,230 --> 00:19:35,190
جيرو؟ من جيرو؟

295
00:19:36,320 --> 00:19:37,780
!يا أبي

296
00:19:38,160 --> 00:19:39,880
هل تعرف شخصًا يُدعى جيرو؟

297
00:19:39,880 --> 00:19:42,560
...ماذا؟ لا أظنّ ذلك

298
00:19:42,560 --> 00:19:44,200
.هذه أنت يا يوري-تشان

299
00:19:44,560 --> 00:19:47,420
مرحبًا بك. هل سرت كلّ هذه
المسافة إلى هنا؟

300
00:19:47,420 --> 00:19:48,660
أكنت تتمرّنين؟

301
00:19:50,430 --> 00:19:51,610
...هذا

302
00:19:52,190 --> 00:19:54,470
.ليس العالم الّذي أعرفه

303
00:19:57,780 --> 00:20:01,840
.ظاهرة الشّبيه، وتُعرف أيضًا بتبادل الجسد

304
00:20:01,840 --> 00:20:06,550
.هناك احتمال كبير بأنّها أتت من عالم موازٍ

305
00:20:06,550 --> 00:20:09,180
،قبل أن نبدأ تحقيقنا المخطّط له

306
00:20:09,180 --> 00:20:11,500
أيمكننا منح الأولويّة لهذا؟

307
00:20:11,500 --> 00:20:12,140
.بالطّبع

308
00:20:13,730 --> 00:20:17,040
عفوًا، أين يوري الحقيقيّة؟

309
00:20:17,040 --> 00:20:20,110
سأخمّن أنّها أخذت مكان هذه
.المرأة في العالم الموازي

310
00:20:20,110 --> 00:20:22,240
...العالم الموازي

311
00:20:22,600 --> 00:20:25,590
أين رأيت تاتشيبانا-سان لأوّل مرّة؟

312
00:20:25,590 --> 00:20:27,950
.أمام باب منزلها

313
00:20:27,950 --> 00:20:31,490
إنّ الأبواب والبوّابات والجدران
الّتي تفصل الدّاخل عن الخارج

314
00:20:31,490 --> 00:20:35,820
.تؤدّي دورًا يشبه الحدود بين نقطتين في الفضاء

315
00:20:36,390 --> 00:20:41,800
سأخمّن أنّه بما أنّ روحًا واحدة
،فقط يمكن أن تتواجد كلّ عالم

316
00:20:41,800 --> 00:20:44,400
،ففي اللّحظة الّتي تواجهت فيها الرّوحان

317
00:20:44,400 --> 00:20:49,080
تجاوزتا المسموح به في الزّمكان
.واضطّرتا لتبادل الأماكن

318
00:20:49,840 --> 00:20:52,800
السّبب الأكثر ترجيحًا هو الطّبيعة
،غير المستقرّة للفضاء هنا

319
00:20:52,800 --> 00:20:56,270
لكن من الممكن أيضًا أنّ كلّ
.هذا بدأ بفراغ في قلبها

320
00:20:56,720 --> 00:20:58,730
.إنّه ليس خطأ أيّ أحد

321
00:20:59,200 --> 00:21:02,800
حدث هذا لأنّ مواقيتَ عدّةِ
.أحداث تداخلت فيما بينها

322
00:21:03,760 --> 00:21:05,370
...هل يوري-سان

323
00:21:06,050 --> 00:21:09,670
ألن تعود يوري-سان أبدًا؟

324
00:21:10,780 --> 00:21:17,330
...أنا... لم أحظ بفرصة أبدًا لأتصالح معها

325
00:21:20,440 --> 00:21:21,990
.سيكون كلّ شيء بخير

326
00:21:23,250 --> 00:21:24,320
.أساهينا-سان

327
00:21:24,650 --> 00:21:27,550
.حدّدنا مكان العالم الموازي

328
00:21:27,760 --> 00:21:31,760
.إنّه ع-رمز 758563-15

329
00:21:31,810 --> 00:21:34,120
.مورينو-سان، جهاز التّفعيل

330
00:21:34,120 --> 00:21:35,020
.ها هو

331
00:21:37,580 --> 00:21:41,140
.ما نوشك أن نفعله يُعتبر بالغ السّرّيّة

332
00:21:41,140 --> 00:21:44,070
.لذلك ليبق سرًّا بين الموجودين هناك فقط

333
00:21:51,860 --> 00:21:54,120
هل أحاول الهرب من الواقع؟

334
00:21:55,120 --> 00:21:57,520
.أشعر أنّ ذهني... مستيقظ بشكل غريب

335
00:22:00,000 --> 00:22:02,140
هل سأظلّ عالقة هنا للأبد؟

336
00:22:07,280 --> 00:22:09,920
.لم أعتذر أبدًا لأنّي نفّست عن إحباطي عليه

337
00:22:10,580 --> 00:22:12,590
.كلّ هذا بسبب عنادي الشّديد

338
00:22:15,750 --> 00:22:19,100
...هذا الشّهور ثانية

339
00:22:55,440 --> 00:22:58,180
!يوري! يوري

340
00:22:59,750 --> 00:23:00,980
!يوري

341
00:23:01,190 --> 00:23:02,590
أنت يوري، صحيح؟

342
00:23:06,000 --> 00:23:07,570
...حمدًا على هذا

343
00:23:09,370 --> 00:23:11,200
...يوري-سان

344
00:23:24,630 --> 00:23:27,150
.فهمت الآن

345
00:23:28,250 --> 00:23:29,960
يبدو أنّي أخيرًا

346
00:23:30,840 --> 00:23:34,280
.صرت جاهزة لأكون صريحة مع نفسي