1
00:00:48,170 --> 00:00:49,000
.إيشّين

2
00:00:49,450 --> 00:00:50,630
.لقد عدت

3
00:00:52,220 --> 00:00:53,050
.أهلاً بعودتك

4
00:00:54,260 --> 00:00:55,730
.شكرًا لخروجك في دوريّة حراسة

5
00:00:58,320 --> 00:01:00,270
أكنت تؤلّف أغنية؟

6
00:01:00,740 --> 00:01:02,560
.نعم. أغنية حبّ

7
00:01:03,440 --> 00:01:05,360
.أودّ لو تغنّينها معي

8
00:01:05,990 --> 00:01:07,070
أنا؟

9
00:01:07,070 --> 00:01:07,680
.نعم

10
00:01:08,500 --> 00:01:10,540
.أنا أحبّ صوتك

11
00:01:16,430 --> 00:01:18,280
.يا لجرأتك

12
00:01:18,680 --> 00:01:19,710
هل حدث شيء ما؟

13
00:01:21,220 --> 00:01:22,520
.رأيتُ أوني

14
00:01:23,110 --> 00:01:25,400
.لقد بدؤوا يظهرون كثيرًا مؤخّرًا

15
00:01:26,960 --> 00:01:31,220
.نعم. أسمع أصواتهم أيضًا

16
00:01:32,820 --> 00:01:33,720
هل أنت خائفة؟

17
00:01:36,400 --> 00:01:37,490
...هاياتشيو

18
00:01:37,910 --> 00:01:39,950
.لا تصمتي هكذا. ذلك يخيفني

19
00:01:41,730 --> 00:01:44,290
أهنالك ما يمكنني القيام به؟

20
00:01:45,680 --> 00:01:48,170
.أريد القيام بما أستطيع من أجل من أحبّ

21
00:01:50,530 --> 00:01:53,620
.أعلم أنّ هذا يبدو مبتذلاً، لكنّه فعلاً ما أودّ فعله

22
00:01:58,400 --> 00:02:00,670
هلاّ غنّيتَ لي؟

23
00:02:02,120 --> 00:02:05,510
.أحبّ صوتك أنا أيضًا

24
00:02:06,560 --> 00:02:09,250
.فعلاً؟ هذه أوّل مرّة أسمع فيها هذا

25
00:02:10,000 --> 00:02:10,960
.يا له من شرف

26
00:03:43,990 --> 00:03:46,200
!اخرجي أيّتها الأوني

27
00:03:46,200 --> 00:03:48,160
!وادخل أيّها الحظّ السّعيد

28
00:03:51,580 --> 00:03:52,710
!لقد اختفت

29
00:03:53,120 --> 00:03:56,020
ستحمي حبوب الفاصولياء تلك منزلنا الآن، صحيح؟

30
00:03:56,020 --> 00:03:56,800
.نعم

31
00:03:57,380 --> 00:04:00,510
،إنّ الّتي نرميها عاليًا هي نصيب الآلهة

32
00:04:00,880 --> 00:04:03,920
.والّتي نرميها على الأرض ستُبعد الأوني عنّا

33
00:04:04,200 --> 00:04:05,370
أوني؟

34
00:04:05,370 --> 00:04:07,680
تقصدين الكائنات الخطيرة الّتي تظهر
قرب الجبال البعيدة؟

35
00:04:08,130 --> 00:04:09,430
.لا، لا

36
00:04:09,430 --> 00:04:12,300
."المعنى الأصليّ لـ"أوني" هو "أشياء شرّيرة

37
00:04:12,300 --> 00:04:15,130
والغاية من الفاصولياء الّتي نرميها
.خلال سِتسوبون هي إبعاد تلك الأشياء

38
00:04:15,130 --> 00:04:16,620
...هكذا إذًا

39
00:04:17,690 --> 00:04:19,390
.هذه لك يا بوتشيو

40
00:04:19,390 --> 00:04:20,910
!شكرًا لك

41
00:04:21,170 --> 00:04:24,100
!كم أنت محظوظ
!حصلتَ على عشرين سلفًا

42
00:04:24,100 --> 00:04:27,410
.أنا أنسى أحيانًا أنّك أكبر منّي سنًّا

43
00:04:28,390 --> 00:04:31,420
.أنا أذكر عندما كنتَ لا تزال طفلاً

44
00:04:31,420 --> 00:04:34,290
...ماذا؟ فعلاً؟ ذلك محرج قليلاً

45
00:04:34,530 --> 00:04:39,230
مهلاً، هل يعني هذا أنّ لديّ أخوين كبيرين؟

46
00:04:40,210 --> 00:04:42,390
.في تلك الحالة، سيكون بوتشيو هو ابننا البكر

47
00:04:42,390 --> 00:04:43,060
!ماذا؟

48
00:04:43,400 --> 00:04:44,990
.أخي الكبير بوتشيو

49
00:04:44,990 --> 00:04:46,260
!ماذا؟

50
00:04:46,260 --> 00:04:48,820
.ممتاز، لذلك وقع جيّد على الآذان

51
00:04:53,940 --> 00:04:56,330
.مو، سأترك فاصولياءك هنا

52
00:04:57,730 --> 00:04:59,880
ما قصّة ذلك الكيس؟

53
00:04:59,880 --> 00:05:01,100
!إنّه تميمة

54
00:05:01,560 --> 00:05:02,840
!صنعتها بنفسي

55
00:05:03,390 --> 00:05:05,430
...لكنّها لا تبدو مُتقنة

56
00:05:05,890 --> 00:05:09,070
لماذا إذًا لا تطلبين من مختصّ صنعها لك؟

57
00:05:09,340 --> 00:05:12,680
بإمكان جدّتك صناعتها ويمكنك
.منحها التّصميم الّذي تريدين

58
00:05:13,800 --> 00:05:14,930
!يبدو ذلك رائعًا

59
00:05:16,250 --> 00:05:17,760
!مرحبًا

60
00:05:18,680 --> 00:05:22,020
.أحضرنا بعض البهشيّة والقليل من الخضروات

61
00:05:22,020 --> 00:05:23,520
!شكرًا لكما

62
00:05:24,160 --> 00:05:25,970
.مرحبًا يا مو-تشان

63
00:05:26,190 --> 00:05:27,080
!جيرو

64
00:05:27,320 --> 00:05:29,760
!انظر! صنعت جدّتي هذا لي

65
00:05:30,320 --> 00:05:31,570
تميمة؟

66
00:05:31,790 --> 00:05:34,480
علينا تعليق تميمة على شجرة
الأرز العظيمة خاصّتك، صحيح؟

67
00:05:34,630 --> 00:05:37,600
!أردتُ صنع واحد خاصّة بي

68
00:05:37,840 --> 00:05:40,000
.هكذا إذًا؟ يبدو ذلك لطيفًا

69
00:05:40,000 --> 00:05:41,050
فعلاً؟

70
00:05:41,590 --> 00:05:43,460
ما الّذي ستضعين فيها؟

71
00:05:43,460 --> 00:05:47,010
صحيح... ماذا قد أضع يا ترى؟

72
00:05:49,190 --> 00:05:50,700
ماذا عن هذه الفاصولياء؟

73
00:05:51,080 --> 00:05:52,320
.حسنًا، لا بأس

74
00:05:58,880 --> 00:06:00,530
.حسنًا. استعيديها إذًا

75
00:06:00,740 --> 00:06:02,840
لماذا حرقتها فجأة هكذا؟

76
00:06:04,920 --> 00:06:07,300
لأشكرك على التّميمة الحمراء الّتي
أعطيتني إيّاها على ما أظنّ؟

77
00:06:11,550 --> 00:06:12,510
.لا يهمّ

78
00:06:13,500 --> 00:06:15,750
تحتوي التّمائم على ورق أيضًا، صحيح؟

79
00:06:15,750 --> 00:06:17,100
.سأضيف واحدة من هذه

80
00:06:17,230 --> 00:06:19,180
تقصدين طقوس الصّلاة؟

81
00:06:19,180 --> 00:06:20,400
أيمكنك كتابة إحداها؟

82
00:06:20,400 --> 00:06:22,080
!اخرسي

83
00:06:22,380 --> 00:06:26,750
حسنًا، يمكنك كتابة مشاعر
.مهمّة تشعرين بها فحسب

84
00:06:25,710 --> 00:06:26,750
...أكان

85
00:06:26,750 --> 00:06:28,760
مثل... هدف ما؟

86
00:06:30,010 --> 00:06:30,800
ظلّ؟

87
00:06:31,110 --> 00:06:32,870
.نعم. واثق أنّي رأيته

88
00:06:33,450 --> 00:06:36,540
.من الأفضل أن نكون حذرين في الأماكن المظلة

89
00:06:36,830 --> 00:06:38,830
لماذا قريبًا جدًّا من منزلنا هكذا؟

90
00:06:38,830 --> 00:06:39,870
...لا أدري

91
00:06:40,100 --> 00:06:42,920
.لكن يبدو أنّه كان لديه إرادة خاصّة به

92
00:06:43,880 --> 00:06:46,600
.يبدو هذا مشابهًا كثيرًا لما حدث مع بنمارو

93
00:06:47,890 --> 00:06:50,840
.حسنًا. سأخبر الأطفال

94
00:06:51,390 --> 00:06:53,080
.سنظلّ متأهّبين أيضًا

95
00:07:01,030 --> 00:07:04,150
.موتسومي، أدخلي حذاءك

96
00:07:18,160 --> 00:07:19,780
...تبدو هذه الرّياح

97
00:07:30,010 --> 00:07:31,140
!جيرو

98
00:07:31,880 --> 00:07:32,980
.مو-تشان

99
00:07:32,980 --> 00:07:33,930
!مرحبًا

100
00:07:33,930 --> 00:07:36,090
.مرحبًا بك أيضًا

101
00:07:36,090 --> 00:07:38,180
!رأيتُ ريشتك تحلّق إليّ

102
00:07:38,370 --> 00:07:39,520
ما الّذي تفعله؟

103
00:07:39,520 --> 00:07:42,360
.أغيّر الرّيش في مروحة الرّيش خاصّتي

104
00:07:42,680 --> 00:07:45,120
.لقد نفدت منها القوّة الرّوحيّة

105
00:07:46,060 --> 00:07:49,840
.تركتُ الرّياح تحمل الرّيش الّذي أنهى مهمّته

106
00:07:51,950 --> 00:07:56,840
أخبرني، هل هذه الرّياح هي نفسها الّتي
كانت تهبّ في شجرة الأرز القديمة؟

107
00:07:56,840 --> 00:07:57,780
.بالتّأكيد

108
00:07:58,430 --> 00:08:02,480
وما هذه الرّياح إذًا؟
إنّها تساعدك كثيرًا، صحيح؟

109
00:08:03,200 --> 00:08:07,800
.إنّ هذه الرّياح تحمي آلهة الجبل

110
00:08:08,480 --> 00:08:11,120
أتعرفين لماذا الرّياح شديدة
في هذه البلدة دائمًا؟

111
00:08:11,490 --> 00:08:14,440
،يعود جزء كبير من ذلك إلى جغرافيا المكان

112
00:08:14,440 --> 00:08:16,890
.ولكنّ نصفها عبارة عن هذه الرّياح

113
00:08:17,070 --> 00:08:19,600
إذًا فالرّياح تحمي البلدة؟

114
00:08:19,860 --> 00:08:21,590
.هذا صحيح

115
00:08:21,590 --> 00:08:26,690
تتحوّل الأجيال السّابقة من التّنغو
.إلى رياح وتستمرّ في حمايتها

116
00:08:27,350 --> 00:08:31,030
عندما تصير الرّياح شديدة قليلاً
...حول شجرة الأرز

117
00:08:31,030 --> 00:08:35,010
.فذلك هو معلّمي من وجهة نظري

118
00:08:35,010 --> 00:08:36,640
معلّمك؟

119
00:08:36,640 --> 00:08:39,700
.التّنغو السّابق الّذي ربّاني

120
00:08:40,090 --> 00:08:42,840
.كان اسمه تنغنبو

121
00:08:42,840 --> 00:08:44,280
...تنغنبو

122
00:08:44,970 --> 00:08:47,640
وذاك هو من أنقذ جيرو؟

123
00:08:47,900 --> 00:08:49,050
.نعم

124
00:08:49,340 --> 00:08:51,320
!هكذا إذًا

125
00:08:52,370 --> 00:08:53,880
...إذًا أنت وجيرو

126
00:08:58,250 --> 00:09:02,200
هل ستتحوّلان أنت وجيرو إلى رياح يومًا ما أيضًا؟

127
00:09:05,070 --> 00:09:06,640
!لا تهتمّا لذلك

128
00:09:07,350 --> 00:09:10,240
إذًا فهذه مجرّد عصا الآن؟

129
00:09:10,240 --> 00:09:12,690
.سأضع عليها ريشًا جديدًا لاحقًا

130
00:09:13,090 --> 00:09:13,810
أتريدين المشاهدة؟

131
00:09:15,750 --> 00:09:17,040
.لا بأس

132
00:09:18,570 --> 00:09:21,160
.يبدو أنّها لن تُمطر

133
00:09:21,160 --> 00:09:24,040
...نعم. كنتُ قلقًا لأنّ الجوّ كان غائمًا

134
00:09:22,040 --> 00:09:23,240
...أليست هذه

135
00:09:28,670 --> 00:09:31,960
!جيرو! علقت ريشة من الّتي حرّرتها

136
00:09:32,480 --> 00:09:34,080
!نسيَتها الرّياح

137
00:09:34,400 --> 00:09:35,560
فعلاً؟

138
00:09:35,840 --> 00:09:36,970
.شكرًا

139
00:09:36,970 --> 00:09:38,830
!سأدعها تحلّق ثانية

140
00:09:40,180 --> 00:09:41,190
!مو-تشان

141
00:09:44,230 --> 00:09:45,120
جيرو؟

142
00:09:49,440 --> 00:09:50,480
جيرو؟

143
00:09:51,180 --> 00:09:52,210
!مو-تشان

144
00:10:15,140 --> 00:10:16,420
!إنّه ليس سهلاً

145
00:10:27,700 --> 00:10:28,490
كيف حالها؟

146
00:10:28,990 --> 00:10:29,980
.إنّها باردة

147
00:10:30,320 --> 00:10:33,230
.لقد ابتعدتْ كثيرًا. عليّ استعادتها

148
00:10:33,860 --> 00:10:36,060
.مو-تشان، عودي

149
00:10:37,050 --> 00:10:39,310
.مو-تشان، أرجوك

150
00:10:43,600 --> 00:10:45,440
مو-تشان! أيمكنك سماعي؟

151
00:10:49,460 --> 00:10:50,800
أتشعرين بالبرد؟

152
00:10:51,740 --> 00:10:53,000
...نعم

153
00:10:54,170 --> 00:10:56,990
.لا بأس

154
00:10:59,440 --> 00:11:01,220
.ما زال يراقب

155
00:11:02,720 --> 00:11:05,610
...يصعب التّصديق أنّه بهذا التّركيز

156
00:11:08,900 --> 00:11:11,180
.إلى أنّي كنتُ كذلك...

157
00:11:11,180 --> 00:11:13,150
...ثمّة عدّة تقارير لظلال سوداء

158
00:11:13,150 --> 00:11:15,170
يؤسفني أن أقول أنّه ربّما ابتُلع
...من طرف الفراغ

159
00:11:15,710 --> 00:11:17,850
...كنت نفس الشّيء

160
00:11:17,850 --> 00:11:19,390
!لن يعود أبدًا؟

161
00:11:18,420 --> 00:11:21,530
!لماذا؟

162
00:11:19,720 --> 00:11:22,040
هل ستختفي ذكرياتي عنه أيضًا؟

163
00:11:21,530 --> 00:11:22,510
!أريده أن يعود أيضًا

164
00:11:22,510 --> 00:11:25,220
...لا أذكر حتّى صوته

165
00:11:22,730 --> 00:11:23,780
...لماذا

166
00:11:27,800 --> 00:11:30,810
.يشعر الجميع بالوحدة أحيانًا

167
00:11:35,280 --> 00:11:37,640
.ماذا؟ هذا دافئ

168
00:11:39,940 --> 00:11:41,020
ما هذا؟

169
00:11:41,930 --> 00:11:43,470
...تبدو هذه اليد مألوفة

170
00:11:51,520 --> 00:11:52,650
!مهلاً

171
00:11:53,550 --> 00:11:54,760
!لا تذهب

172
00:12:04,680 --> 00:12:05,790
تشيو-تشان؟

173
00:12:06,290 --> 00:12:07,680
.صباح الخير

174
00:12:08,160 --> 00:12:10,000
هل تشعرين بأيّ تعب؟

175
00:12:12,810 --> 00:12:13,540
...لا

176
00:12:14,800 --> 00:12:16,130
.حمدًا على ذلك

177
00:12:16,760 --> 00:12:19,920
مهلاً، متى خلدتُ للنّوم؟

178
00:12:20,260 --> 00:12:21,950
لماذا أنت هنا يا تشيو-تشان؟

179
00:12:22,280 --> 00:12:23,560
...اسمعي يا مو-تشان

180
00:12:24,110 --> 00:12:27,920
.ذلك الظّلّ الأسود... ذلك الفراغ كاد يبتلعك

181
00:12:28,340 --> 00:12:29,480
هل تذكرين ذلك؟

182
00:12:29,850 --> 00:12:30,680
ماذا؟

183
00:12:30,960 --> 00:12:33,280
.أنقذك جيرو

184
00:12:34,670 --> 00:12:37,760
.إنّهما يتحدّثان مع ذلك الظّلّ الآن

185
00:12:38,510 --> 00:12:41,520
.سيكتشفان ما الّذي يريده

186
00:12:44,870 --> 00:12:47,560
.أعلم أنّنا أجفلناك قبل قليل

187
00:12:48,590 --> 00:12:50,710
هلاّ تحدّثنا؟

188
00:12:52,290 --> 00:12:54,160
مو! هل أنت بخير؟

189
00:12:54,460 --> 00:12:56,100
أأنت بحال جيّدة لتنهضي؟

190
00:12:56,100 --> 00:12:56,800
.نعم

191
00:12:58,240 --> 00:13:01,190
هلاّ سمحت لنا بسماع صوتك؟

192
00:13:02,440 --> 00:13:04,680
.لا بدّ أنّك تشعر بالوحدة

193
00:13:07,040 --> 00:13:10,180
...الـ... الوحدة

194
00:13:11,840 --> 00:13:13,060
...ذلك الصّوت

195
00:13:13,690 --> 00:13:18,120
.وحدة... لا... أفهم

196
00:13:18,120 --> 00:13:20,440
...هكذا إذًا

197
00:13:20,760 --> 00:13:24,410
...إنّ سبب تركيزك على هذا المنزل ومو-تشان

198
00:13:24,410 --> 00:13:25,690
.لا أدري

199
00:13:26,730 --> 00:13:28,160
.أنا أذكر الآن

200
00:13:29,600 --> 00:13:31,120
.أفتقدهم

201
00:13:32,590 --> 00:13:33,740
...أبي

202
00:13:36,460 --> 00:13:37,920
.مرحبًا يا -سان

203
00:13:38,320 --> 00:13:40,250
ستذهب إلى فوكووكا غدًا، صحيح؟

204
00:13:40,600 --> 00:13:44,380
.نعم. إنّه أبعد قليلاً عن آخر مرّة

205
00:13:44,550 --> 00:13:46,720
.اعتن بنفسك

206
00:13:46,720 --> 00:13:47,330
.أكيد

207
00:13:47,980 --> 00:13:51,450
!"أبي! قم بـ"أمسكتك

208
00:13:51,450 --> 00:13:53,400
!حسنًا، لنقم بذلك

209
00:13:53,960 --> 00:13:55,610
!أمسكتك

210
00:13:57,020 --> 00:13:58,050
!ثانية

211
00:13:58,050 --> 00:13:59,880
.هذا يكفي حتّى الآن

212
00:14:00,760 --> 00:14:02,600
.اعتنيا بها أثناء غيابي للعمل

213
00:14:02,600 --> 00:14:04,890
.بالطّبع. لا داعي للقلق

214
00:14:05,440 --> 00:14:07,360
.ودّعيه يا ساكي

215
00:14:09,400 --> 00:14:11,360
.ساكي، صافحيني

216
00:14:14,330 --> 00:14:15,780
متى ستعود؟

217
00:14:16,090 --> 00:14:19,400
.سآتي للمنزل من وقت لآخر. وسأتّصل أيضًا

218
00:14:19,400 --> 00:14:21,670
...كاذب! في آخر مرّة

219
00:14:23,390 --> 00:14:25,670
.كن حذرًا يا -سان

220
00:14:25,670 --> 00:14:29,660
ظهرت عدّة ظلال في المنطقة
.حول مساكن الشّركة مؤخّرًا

221
00:14:29,900 --> 00:14:33,640
!إنّ النّاس يختفون بنفس وتيرة حوادث السّير

222
00:14:33,640 --> 00:14:36,890
لا تبتعد عن الطّرق المضاءة حتّى
.إن اضطررت لسلك طريق طويل

223
00:14:38,530 --> 00:14:40,130
أيسير العمل على أحسن وجه؟

224
00:14:40,540 --> 00:14:41,150
.نعم

225
00:14:41,580 --> 00:14:43,420
متى ستستطيع العودة للمنزل؟

226
00:14:43,780 --> 00:14:47,360
حسنًا... الآن هو الوقت الّذي عليّ
.بذل كلّ جهدي فيه

227
00:14:47,800 --> 00:14:49,080
هل ستكون بخير؟

228
00:14:50,210 --> 00:14:53,970
إنّك تميل للمبالغة جدًّا في عملك
.بما أنّك تحبّه يا -كُن

229
00:14:54,490 --> 00:14:56,590
.عد إلى المنزل إن كنت تفتقدنا

230
00:14:57,820 --> 00:14:59,760
.إنّ الأطفال يفتقدونك بكلّ تأكيد

231
00:15:00,440 --> 00:15:02,790
.كما أنّ عيد مولد موتسومي وشيك أيضًا

232
00:15:08,640 --> 00:15:10,310
.أنا أفقدكم جميعًا بالفعل

233
00:15:12,310 --> 00:15:15,210
.ربّما أملأ وقتي بالعمل للتّغطية على ذلك

234
00:15:19,520 --> 00:15:21,980
.حسنًا. سآخذ إجازة مدفوعة

235
00:15:21,980 --> 00:15:24,140
!وسأشتري لها هديّة عيد مولد

236
00:15:26,400 --> 00:15:27,820
أهذا كاف؟

237
00:15:29,560 --> 00:15:32,650
.حلّ الظّلام بالفعل. سآخذ طريقًا مختصرًا

238
00:15:35,330 --> 00:15:38,210
.أراهن أنّ حجمه سيجعلها تبكي

239
00:15:38,660 --> 00:15:40,970
.لكنّ وجهه ظريف

240
00:15:42,390 --> 00:15:43,990
.لا أطيق الانتظار حتّى أراها

241
00:15:59,620 --> 00:16:02,830
!مهلاً! عليّ رؤية أطفالي

242
00:16:14,380 --> 00:16:16,280
هل ستذهبين للشّرطة ثانية؟

243
00:16:17,520 --> 00:16:18,990
أين أبي؟

244
00:16:19,300 --> 00:16:20,890
.واثقة أنّنا سنجده

245
00:16:21,520 --> 00:16:22,630
.انتظري فحسب

246
00:16:29,060 --> 00:16:30,960
تنتظرين أبي؟

247
00:16:31,240 --> 00:16:31,810
.نعم

248
00:16:32,240 --> 00:16:34,550
.سيقوم بـ"أمسكتك" معي

249
00:16:35,890 --> 00:16:37,500
.لن يعود

250
00:16:39,720 --> 00:16:40,850
!واثقة من ذلك

251
00:16:40,850 --> 00:16:43,080
!اكتفينا من انتظاره

252
00:16:42,140 --> 00:16:43,080
!لا

253
00:16:43,080 --> 00:16:45,350
!لا! لا

254
00:16:45,770 --> 00:16:48,690
!أبي

255
00:16:49,830 --> 00:16:54,920
!أريده... أن يعود للمنزل أيضًا

256
00:17:03,210 --> 00:17:04,560
...وحدة

257
00:17:04,890 --> 00:17:06,160
...لا أدري

258
00:17:06,880 --> 00:17:08,160
...وحدة

259
00:17:08,880 --> 00:17:14,920
.لقد التهمك الفراغ وفقدت جسدك وكلّ ذكرياتك

260
00:17:15,420 --> 00:17:18,250
.كلّ ما بقي هو روحك

261
00:17:19,350 --> 00:17:23,220
.وتلك الرّوح أنجبت إرادة قويّة

262
00:17:24,550 --> 00:17:26,080
.لديّ سؤال لك

263
00:17:27,000 --> 00:17:30,090
ما الّذي ترغب فيه إرادتك القويّة؟

264
00:17:30,640 --> 00:17:33,490
ما الّذي تريد القيام به؟

265
00:17:34,640 --> 00:17:35,940
.أريد رؤيتهم

266
00:17:37,790 --> 00:17:38,860
.لا أدري

267
00:17:39,310 --> 00:17:41,770
.لكنّي... أريد رؤيتهم

268
00:17:41,770 --> 00:17:44,120
كيف لي أن أراهم؟

269
00:17:44,720 --> 00:17:46,770
...أنا... إنّي

270
00:17:47,440 --> 00:17:48,400
...إنّني

271
00:17:49,590 --> 00:17:50,560
.أريد رؤيتهم

272
00:17:55,200 --> 00:17:56,550
.إذًا فقد اتّخذت قرارك

273
00:17:57,910 --> 00:17:59,680
.تعال معي

274
00:18:14,040 --> 00:18:15,530
.سيفي هذا بالغرض

275
00:18:16,230 --> 00:18:19,190
.سرّني أنّه كان لي بعض الملابس الواسعة

276
00:18:19,750 --> 00:18:21,600
.شكرًا لك يا بنمارو-كُن

277
00:18:21,970 --> 00:18:25,370
إن كان هنالك أيّ شيء يمكنني
.فعله، اطلبوه منّي فحسب

278
00:18:25,900 --> 00:18:27,860
.أنا بتوبتو-سان أيضًا في نهاية المطاف

279
00:18:28,170 --> 00:18:29,950
.شكرًا لك

280
00:18:30,600 --> 00:18:32,450
هلاّ أبقيت نظرك عليه هنا لوهلة؟

281
00:18:32,850 --> 00:18:33,450
.نعم

282
00:18:33,720 --> 00:18:36,570
.حتّى تستيقظ نفسه الجديدة

283
00:18:37,200 --> 00:18:38,170
...عفوًا

284
00:18:38,330 --> 00:18:42,980
هل سيظلّ شاردًا هكذا حتّى تستيقظ نفسه؟

285
00:18:43,370 --> 00:18:44,740
.ذلك صحيح

286
00:18:44,990 --> 00:18:49,140
جيرو-سان وتازنبو-سان اعتنيا بي
،عندما مررتُ بهذا

287
00:18:49,140 --> 00:18:52,570
.ولا أذكر الكثير عن ذلك الوقت على الإطلاق

288
00:18:54,000 --> 00:18:54,910
...لكن

289
00:18:55,830 --> 00:18:59,300
أذكر بشكل واضح اللّحظة
.الّتي استيقظت فيها نفسي

290
00:19:00,500 --> 00:19:03,870
كان ذلك عندما ظننتُ أنّ عصيدة
.الأرزّ الّتي قُدّمت لي كانت لذيذة

291
00:19:04,660 --> 00:19:08,700
،في تلك اللّحظة
.اتّخذ كلّ ما أستطيع رؤيتهُ لونًا

292
00:19:13,240 --> 00:19:15,890
،لا يمكنني الجزم بما كان الحافز

293
00:19:15,890 --> 00:19:19,050
.لكنّ لحظة استيقاظه ستحلّ عاجلاً أم آجلاً

294
00:19:20,820 --> 00:19:24,120
...أعلم أنّ ما سأسأله سيبدو فظًّا، ولكن

295
00:19:24,880 --> 00:19:28,230
أتظنّ أنّه لن يتذكّر أيّ شيء... من قبل؟

296
00:19:29,630 --> 00:19:34,910
لا أدري حتّى إن كنتُ بشرًا
.من قبل أو مجرّد ظلّ

297
00:19:35,570 --> 00:19:38,530
.وُلدت من جديد بشعور الوحدة فحسب

298
00:19:42,480 --> 00:19:46,600
لا بدّ أنّ الولادة من جديد أمر صعب

299
00:19:47,310 --> 00:19:51,470
.على النّاس الّذين عرفوا شكلك وقلبك في السّابق

300
00:19:52,770 --> 00:19:56,060
.لكنّ ظروفه لا تشبه ظروفي

301
00:19:56,490 --> 00:19:59,610
.إنّ مشاعره القويّة تُجاه عائلته هي ما أعادته

302
00:20:00,150 --> 00:20:05,940
لنراقب جميعًا ونرى كيف ستؤثّر
.تلك المشاعر على جوهره

303
00:20:06,450 --> 00:20:07,440
...حسنًا

304
00:20:08,120 --> 00:20:09,520
.أستأذن بالدّخول

305
00:20:09,520 --> 00:20:10,450
...مو-تشان

306
00:20:10,450 --> 00:20:11,600
.مرحبًا بعودتك

307
00:20:11,890 --> 00:20:13,820
هل أتيت للاطمئنان عليه؟

308
00:20:13,820 --> 00:20:14,480
.نعم

309
00:20:18,320 --> 00:20:21,030
.سنخرج لبعض الوقت

310
00:20:24,170 --> 00:20:25,150
.موتسومي

311
00:20:25,730 --> 00:20:27,690
تحدّثي معه كثيرًا، موافقة؟

312
00:20:27,980 --> 00:20:28,940
أتحدّث معه؟

313
00:20:29,160 --> 00:20:29,990
.نعم

314
00:20:30,400 --> 00:20:32,040
بماذا أناديه؟

315
00:20:32,040 --> 00:20:32,630
ماذا؟

316
00:20:34,670 --> 00:20:36,260
ماذا عن... ما-سان؟

317
00:20:36,750 --> 00:20:38,960
ما-سان؟ لماذا؟

318
00:20:39,450 --> 00:20:40,760
.مجرّد حدس

319
00:20:42,800 --> 00:20:45,560
.ما-سان، الجوّ أدفأ تحت الشّمس

320
00:20:45,960 --> 00:20:48,840
.ما زال لا يرتاح للضّوء السّاطع

321
00:20:49,110 --> 00:20:50,160
فعلاً؟

322
00:20:52,740 --> 00:20:53,760
...ما-سان

323
00:20:54,720 --> 00:20:57,170
هل نسي كلّ شيء بالفعل؟

324
00:20:58,060 --> 00:20:59,990
.لكنّي أتذكّر

325
00:21:00,480 --> 00:21:03,180
.تذكّرتُ بعد سماع صوته

326
00:21:03,850 --> 00:21:07,730
،حتّى بصفته بتوبتو-سان
.ما زال يملك نفس الصّوت

327
00:21:08,300 --> 00:21:10,640
هيّا... ألا تذكر؟

328
00:21:12,200 --> 00:21:14,140
...يا أبي

329
00:21:25,960 --> 00:21:29,630
من... أكون أنا؟

330
00:21:30,850 --> 00:21:31,620
...من

331
00:21:40,740 --> 00:21:41,740
موتسومي؟

332
00:21:41,990 --> 00:21:43,100
!موتسومي

333
00:21:45,570 --> 00:21:47,860
.أظنّ أنّ هذا يكفي

334
00:21:59,580 --> 00:22:02,310
.أشعر بالغباء الشّديد لتفويتي للنّادي