1
00:01:36,000 --> 00:01:36,960
...بوتشيو

2
00:01:38,200 --> 00:01:39,370
.أنا آسفة

3
00:01:39,370 --> 00:01:40,200
ماذا؟

4
00:01:41,080 --> 00:01:44,180
.نفّست عن إحباطي عليك وقلتُ أشياء فظيعة

5
00:01:44,180 --> 00:01:47,830
!كـ-كلاّ، لا بأس بذلك
...لست بحاجة للاعتذار

6
00:01:47,830 --> 00:01:49,800
.لا، بل عليّ الاعتذار

7
00:01:50,360 --> 00:01:52,690
آذتك كلماتي، صحيح؟

8
00:01:55,330 --> 00:01:56,610
...قلتُ أشياء

9
00:01:57,020 --> 00:02:00,400
.أساءت إليك أيضًا

10
00:02:01,440 --> 00:02:06,140
أعلم أنّك أخبرتني من قبل
...أنّه ليس الجميعُ مثلي

11
00:02:06,540 --> 00:02:09,640
.آسف لأنّي قلتُ أشياء أنانيّة كتلك

12
00:02:10,360 --> 00:02:14,640
.لا، لا بأس. أدّت كلماتك دورها

13
00:02:16,450 --> 00:02:19,060
هل ما زلنا... أصدقاء؟

14
00:02:19,670 --> 00:02:20,400
.نعم

15
00:02:23,330 --> 00:02:24,440
.بالطّبع، نحن أصدقاء

16
00:02:32,030 --> 00:02:33,690
.أنا آسف أيضًا

17
00:02:34,280 --> 00:02:36,400
تطفّلتُ أكثر من اللاّزم، صحيح؟

18
00:02:36,400 --> 00:02:39,220
.أنا معتادة على فضولك، لذلك فلا بأس

19
00:02:40,930 --> 00:02:43,240
!ما معنى ذلك؟ هذا قاسٍ

20
00:02:48,680 --> 00:02:49,880
،بالمناسبة

21
00:02:49,880 --> 00:02:52,940
.سمعتُ أنّ مختبر الزّمكان قام باستفسار ثانويّ

22
00:02:52,940 --> 00:02:53,860
.نعم

23
00:02:53,860 --> 00:02:57,430
.طرحوا عليّ أسئلة محدّدة
.كان ذلك صعبًا

24
00:02:57,430 --> 00:03:01,070
الاستجواب الّذي أجريته
.مع تاكومي-كُن كان شديدًا أيضًا

25
00:03:01,300 --> 00:03:03,410
!مختبر الزّمكان

26
00:03:03,550 --> 00:03:06,620
!أخبرني! أخبرني المزيد

27
00:03:08,530 --> 00:03:11,780
.لكنّ الوضع ما زال غريبًا

28
00:03:12,560 --> 00:03:15,720
.فلقد عدت إلى طبيعتك... بشكل مفاجئ

29
00:03:16,080 --> 00:03:20,280
.ويوري-سان الأخرى اختفت في نفس الوقت

30
00:03:20,280 --> 00:03:23,400
...قالوا أنّهم أعادوها إلى عالمها الأصليّ

31
00:03:23,400 --> 00:03:27,020
،لا أفهم حقًّا كيف يعمل كلّ ذلك
لكنّه أمر كالخيال، صحيح؟

32
00:03:37,250 --> 00:03:39,170
لماذا تحدّقين بي؟

33
00:03:39,170 --> 00:03:44,000
."كنت أفكّر فقط... بأنّي سعيدة لأنّك "تايرا

34
00:03:45,370 --> 00:03:47,880
ما الّذي رأيتِه هناك؟

35
00:03:49,630 --> 00:03:53,120
.سأخبرك يومًا ما. ربّما عندما أكون ثملة

36
00:03:53,720 --> 00:03:56,700
.حسنًا. سأتطلّع قدمًا لذلك

37
00:03:58,580 --> 00:04:00,480
.سرّني أنّك استطعت الحديث معها

38
00:04:00,480 --> 00:04:03,720
.نعم، ارتحت كثيرًا أنا أيضًا

39
00:04:03,720 --> 00:04:06,990
.بدت تعابيرها مرتاحة قليلاً أيضًا

40
00:04:07,240 --> 00:04:08,220
...المعذرة

41
00:04:09,050 --> 00:04:10,220
ماذا؟

42
00:04:10,220 --> 00:04:14,740
هل تعيش تاتشيبانا يوري-سان هنا؟

43
00:04:17,310 --> 00:04:18,580
يوريبّي؟

44
00:04:20,140 --> 00:04:22,070
ماذا؟ هل نسيت شيئًا ما؟

45
00:04:22,430 --> 00:04:25,230
.لا، ثمّة من أتى لرؤيتك

46
00:04:27,510 --> 00:04:29,540
!أ-أختي

47
00:04:30,430 --> 00:04:31,950
!وجدتك أخيرًا

48
00:04:33,610 --> 00:04:35,040
تسوباكي؟

49
00:04:36,800 --> 00:04:37,620
!نعم

50
00:04:39,760 --> 00:04:42,340
.كنتُ قلقًا عليك طوال هذا الوقت

51
00:04:42,340 --> 00:04:44,260
.لكن يبدو أنّك لم تتغيّري كثيرًا

52
00:04:49,430 --> 00:04:51,970
كنتَ تبحث عنها وحدك طوال هذا الوقت؟

53
00:04:51,970 --> 00:04:53,920
...نعم، صحيح

54
00:04:53,920 --> 00:04:56,740
.بدأت في البحث عنها قبل سنة

55
00:04:56,740 --> 00:05:00,230
...سألتُ أشخاص يعرفونك وما إلى ذلك، ثمّ

56
00:05:00,560 --> 00:05:02,360
.هذا هو ما قادني إلى هنا أخيرًا

57
00:05:02,360 --> 00:05:05,240
إنّها صورة انتشرت على مواقع
التّواصل الاجتماعيّ

58
00:05:05,240 --> 00:05:08,050
.مِن شخص رأى سيّارة مختبر الزّمكان

59
00:05:09,450 --> 00:05:12,680
وساعد ذلك على تقليل نقاط
...بحثي ولو قليلاً

60
00:05:13,110 --> 00:05:16,110
!وعندما رأيت ذلك، تحمّست كثيرًا

61
00:05:16,110 --> 00:05:18,320
...لديك موهبة حقيقيّة في تحديد الأشياء

62
00:05:18,320 --> 00:05:19,440
لماذا؟

63
00:05:21,460 --> 00:05:24,140
لماذا قرّرت البحث عنّي بعد كلّ هذا الوقت؟

64
00:05:25,080 --> 00:05:26,560
لا بدّ من سبب وجيه، صحيح؟

65
00:05:29,170 --> 00:05:29,810
.نعم

66
00:05:30,880 --> 00:05:31,970
...أختي

67
00:05:32,710 --> 00:05:34,400
.أمّي مريضة

68
00:05:35,870 --> 00:05:37,760
.أصابها المرض قبل سنة

69
00:05:38,660 --> 00:05:41,570
تساعدها الزّيارات المنتظمة
.والأدوية على إبقاء حالتها مستقرّة

70
00:05:42,600 --> 00:05:45,930
.كنتُ أبحث عنك لأنّها طلبت منّي ذلك

71
00:05:47,880 --> 00:05:49,450
،أردتُ رؤيتك أنا أيضًا

72
00:05:49,790 --> 00:05:52,270
.لكنّ أمّي أرادت رؤيتك أكثر من أيّ أحد

73
00:05:53,750 --> 00:05:57,800
.يعرف أبي أنّي أبحث عنك أيضًا

74
00:05:59,640 --> 00:06:02,490
...أعلم أنّك تركت المنزل لأنّك تكرهينه

75
00:06:04,110 --> 00:06:06,770
.لكن عودي للمنزل رجاءً
.ولو لمرّة واحدة

76
00:06:07,870 --> 00:06:10,290
،إن كنت لا ترغبين في ذلك
.فلن أضغط عليك أكثر

77
00:06:11,060 --> 00:06:13,890
—لكنّي... قد أخبرهم أنّك بخير

78
00:06:13,890 --> 00:06:14,780
...اسمع

79
00:06:14,780 --> 00:06:15,540
ماذا؟

80
00:06:17,180 --> 00:06:22,400
.اختفيتُ من هذا العالم لبعض الوقت قبل أيّام

81
00:06:23,500 --> 00:06:26,310
أجبرني وجودي وحيدة بالكامل في عالم مختلف

82
00:06:26,680 --> 00:06:28,760
.على مواجهة مشاعري أخيرًا

83
00:06:30,620 --> 00:06:34,360
.عرفتُ منذ مدّة ما أردتُ فعله

84
00:06:35,340 --> 00:06:37,230
.أردتُ فعلاً أن أتغيّر

85
00:06:39,020 --> 00:06:41,990
ظننتُ أنّ شيئًا ما سيتغيّر بمجرّد
،رحيلي عن لمنزل

86
00:06:42,490 --> 00:06:45,120
،لكنّ بالي ظلّ مشغولاً بالماضي

87
00:06:45,120 --> 00:06:48,080
.ولم أشأ الاعتراف بأنّي أخشى التّغيّر

88
00:06:49,770 --> 00:06:51,650
.أنا مجرّد ثعلبة خائفة

89
00:06:53,560 --> 00:06:55,820
.شكرًا يا تسوباكي

90
00:06:57,180 --> 00:06:59,010
.لأنّك أتيت لمواجهتي هكذا

91
00:07:00,320 --> 00:07:02,060
.اتّخذتُ قراري أخيرًا

92
00:07:03,710 --> 00:07:06,800
.سأعود للمنزل

93
00:07:12,570 --> 00:07:16,720
إذًا ما زال بإمكاني مواجهة
.الماضي الّذي أحمله معي بداخلي

94
00:07:29,840 --> 00:07:31,780
،عندما وُلد تسوباكي

95
00:07:32,110 --> 00:07:33,890
...قالت لي أمّي

96
00:07:34,870 --> 00:07:38,230
.لا تسمحي لما قالته ميو-تشان بالتّأثير عليك

97
00:07:39,560 --> 00:07:44,590
بدت أمّي مدركة للجوّ المظلم
،الّذي غلّف منزلنا

98
00:07:44,960 --> 00:07:46,620
.لكنّها لم تتحدّث عنه أبدًا

99
00:07:48,850 --> 00:07:51,150
،لم أستطع تحمّل بقائي في ذلك المنزل الخانق

100
00:07:52,060 --> 00:07:54,620
.لذلك قرّرت الرّحيل

101
00:07:58,240 --> 00:07:59,470
أختي؟

102
00:08:01,350 --> 00:08:02,800
إلى أين تذهبين؟

103
00:08:04,960 --> 00:08:09,410
.تسوباكي، لا تسمح لفخرك أن يسحقك

104
00:08:11,840 --> 00:08:13,150
!أختي

105
00:08:13,380 --> 00:08:15,200
!لا تذهبي

106
00:08:16,240 --> 00:08:18,080
!أختي

107
00:08:25,860 --> 00:08:26,850
!أختي

108
00:08:31,430 --> 00:08:34,170
شكرًا لقدومك. أتشعرين بالبرد؟

109
00:08:35,470 --> 00:08:37,240
.ليس للدّرجة الّتي ظننتُها

110
00:08:40,770 --> 00:08:44,210
.لم أعد للمنزل منذ وقت طويل أيضًا

111
00:08:44,640 --> 00:08:48,230
أعيش في مسكن طلبة بينما
.أرتاد مدرسة فوكوشيما الثّانويّة

112
00:08:48,770 --> 00:08:49,810
...وأيضًا

113
00:08:50,380 --> 00:08:52,410
.أنا أتعلّم تقليد مطاردة الخيول البرّيّة

114
00:08:53,760 --> 00:08:56,060
أردتُ أن أشكّل رأيي الخاصّ

115
00:08:56,600 --> 00:08:59,040
."حيال ماهية "التّقاليد" و"الفخر

116
00:09:00,200 --> 00:09:01,100
.هكذا إذًا

117
00:09:06,600 --> 00:09:07,750
.لقد عدت

118
00:09:09,280 --> 00:09:10,940
.ربّما أمّي في غرفتها

119
00:09:12,160 --> 00:09:13,760
.انتظرينا في غرفة المعيشة

120
00:09:33,470 --> 00:09:34,730
أهذه أنت يا يوري؟

121
00:09:37,570 --> 00:09:38,760
.اجلسي

122
00:09:46,590 --> 00:09:50,350
كنتُ في انتظارك هنا بعدما أبلغني
.تسوباكي بالأمر

123
00:09:51,510 --> 00:09:54,070
.ليس لديّ أيّ شيء بالتّحديد لأقوله لك

124
00:09:56,690 --> 00:09:58,840
.إن كان لديك ما تقولينه لي، فتفضّلي

125
00:10:01,050 --> 00:10:02,220
...تبدو

126
00:10:03,170 --> 00:10:04,800
.أصغر حجمًا الآن

127
00:10:06,220 --> 00:10:07,570
أهذا رأيك؟

128
00:10:08,190 --> 00:10:09,780
.تقدّمتُ في العمر

129
00:10:10,210 --> 00:10:14,020
.أترك معظم الأشياء لابني الثّاني ميزوكي الآن

130
00:10:15,080 --> 00:10:16,630
ليس لأخي الأكبر كيكو؟

131
00:10:16,830 --> 00:10:19,290
.منحتُ العمل للشّخص الّذي أراده

132
00:10:22,160 --> 00:10:23,760
.لديّ سؤال واحد

133
00:10:24,960 --> 00:10:30,710
"هل ما زلت تعتقد أن فكرة "الفخر
الّتي علّمتنا إيّاها كانت صائبة؟

134
00:10:31,830 --> 00:10:34,230
هل أنت نادم على أيّ شيء؟

135
00:10:35,640 --> 00:10:37,930
.لستُ نادمًا على أيّ شيء

136
00:10:39,630 --> 00:10:42,810
،"لقد نقلت ما أعتقد أنّه "التّقاليد" و"الفخر

137
00:10:43,200 --> 00:10:47,870
.ولا أعتقد أنّي كنتُ مخطئًا ولو قيد أنملة

138
00:10:48,850 --> 00:10:52,330
لكن... قرّرت أنّني لن أتدخّل

139
00:10:52,610 --> 00:10:55,120
.فيما قرّرتم القيام به أنتم الأطفال

140
00:10:59,000 --> 00:11:02,320
.هكذا إذًا. فهمت

141
00:11:06,130 --> 00:11:08,060
.إنّك عنيد بالفعل

142
00:11:09,710 --> 00:11:11,220
.مثلي تمامًا

143
00:11:18,730 --> 00:11:21,450
أمّي، كيف تشعرين؟

144
00:11:21,790 --> 00:11:23,930
.في أفضل حال في هذه اللّحظة

145
00:11:24,240 --> 00:11:26,910
.أنا مسرورة لرؤيتك تبلين حسنًا

146
00:11:27,280 --> 00:11:29,000
هل تحدّثت مع والدك؟

147
00:11:29,930 --> 00:11:30,870
.نعم

148
00:11:31,840 --> 00:11:34,320
،ما زلت لا أعتقد أنّ بإمكاني مسامحته

149
00:11:34,660 --> 00:11:36,610
.لكن أظنّ أنّ لا بأس بذلك

150
00:11:37,440 --> 00:11:40,430
.لم ألاحظ ما كان يجب أن يكون واضحًا

151
00:11:42,600 --> 00:11:45,000
.تتغيّر كلّ الأشياء مع الوقت

152
00:11:46,010 --> 00:11:47,140
.حتّى تسوباكي

153
00:11:47,440 --> 00:11:49,720
.كان ظريفًا عندما كان صغيرًا

154
00:11:50,390 --> 00:11:52,670
.لكنّه الآن صار أكبر منّي

155
00:11:52,670 --> 00:11:54,040
!أختي

156
00:11:55,130 --> 00:11:59,150
.إنّ ميو-تشان تزوّجت ورُزقت بطفل

157
00:12:00,270 --> 00:12:01,640
أتريدين رؤية صورة؟

158
00:12:03,950 --> 00:12:07,420
.قالت أنّها تمنّت لو استطاعت رؤيتك

159
00:12:09,520 --> 00:12:11,000
.سأذهب لزيارتها

160
00:12:12,770 --> 00:12:15,020
.عندما يحين موسم الزّهور ثانية

161
00:12:18,100 --> 00:12:19,960
هلاّ أعطيتني ذلك الطّبق الصّغير رجاءً؟

162
00:12:20,360 --> 00:12:22,130
!هذا لذيذ جدًّا

163
00:12:22,130 --> 00:12:24,790
.نعم. جعلتني أمّي أحضره معي

164
00:12:24,790 --> 00:12:25,840
فعلاً؟

165
00:12:25,840 --> 00:12:27,840
!انظري يا يوريبّي

166
00:12:27,840 --> 00:12:29,810
.تبادلت معلومات الاتّصال مع تسوباكي

167
00:12:30,300 --> 00:12:31,770
متى حدث ذلك؟

168
00:12:31,770 --> 00:12:34,160
.سيعلّمني كيف أركب الأحصنة

169
00:12:34,160 --> 00:12:38,260
.إنّك تنضح بالنّشاط يا تايرا

170
00:12:37,120 --> 00:12:40,890
هل يصير مسقط رأسك باردًا
في مثل هذا الوقت من السّنة؟

171
00:12:40,890 --> 00:12:41,740
.صحيح

172
00:12:42,080 --> 00:12:44,310
.ستتساقط الثّلوج قريبًا

173
00:12:44,310 --> 00:12:46,510
.لكن ما زال الجوّ دافئًا هنا

174
00:12:46,510 --> 00:12:47,970
.هكذا إذًا

175
00:12:49,060 --> 00:12:51,240
...ولكن بعد اعتبار كلّ شيء

176
00:12:51,670 --> 00:12:56,040
.ما زلت أحبّ الطّقس في تونو حيث نشأت

177
00:12:56,610 --> 00:12:59,140
شعرتُ بذلك عندما سرت هناك
.لأوّل مرّة بعد وقت طويل

178
00:12:59,790 --> 00:13:04,650
شعرتُ وكأنّ جسدي سينفجر
.من السّعادة في هواء تونو

179
00:13:05,080 --> 00:13:08,080
،وعندما عدتُ إلى فوتشيغاموري

180
00:13:08,600 --> 00:13:11,530
شعرتُ براحة شديدة
.وكأنّ بإمكاني الاسترخاء هنا

181
00:13:12,690 --> 00:13:16,790
.أعتقد أنّ كِلا المكانين صارا أساسيّين لي الآن

182
00:13:17,640 --> 00:13:20,940
الدّيار الّتي وُلدتِ فيها
والدّيار الّتي يعيش فيها قلبك؟

183
00:13:21,190 --> 00:13:22,990
.نعم، شيء من ذلك القبيل

184
00:13:23,890 --> 00:13:25,240
هكذا إذًا؟

185
00:13:25,240 --> 00:13:27,840
.أشهر بالسّعادة الآن نوعًا ما

186
00:13:27,840 --> 00:13:28,660
ماذا؟

187
00:13:28,660 --> 00:13:31,730
إنّ ذلك يُسعدني كمقيم قديم
.في فوتشيغاموري أيضًا

188
00:13:32,240 --> 00:13:33,620
ماذا عنك يا جيرو-سان؟

189
00:13:34,030 --> 00:13:38,100
.نعم، أنا ممتنّ لمعرفة أنّ ذلك هو ما تشعرين به

190
00:13:38,100 --> 00:13:41,000
من اللّطيف أن نسمع نحن ممّن
.يحمي هذا المكان كلامًا كهذا

191
00:13:43,600 --> 00:13:45,940
.لنقل أنّ هذا الكلام بسبب الكحول فحسب

192
00:13:45,940 --> 00:13:47,050
.ذلك مستحيل

193
00:13:52,360 --> 00:13:54,460
بوتشيو-سان، ما هذه؟

194
00:13:55,270 --> 00:13:57,200
!رخصة قيادة

195
00:13:58,860 --> 00:14:00,270
!تهانينا

196
00:14:00,270 --> 00:14:02,130
هل قرّرت ما نوع السّيّارة الّتي ستشتري؟

197
00:14:02,130 --> 00:14:05,030
!اشتر واحدة جديدة لتتحمّس لقيادتها

198
00:14:05,030 --> 00:14:06,010
ماذا؟

199
00:14:14,440 --> 00:14:15,800
!تشيو-تشان

200
00:14:16,490 --> 00:14:17,710
!لم أرك منذ مدّة

201
00:14:18,000 --> 00:14:20,320
.مرحبًا بك يا مو-تشان

202
00:14:20,320 --> 00:14:21,460
.مرحبًا

203
00:14:21,460 --> 00:14:23,160
تعملين مع جيرو؟

204
00:14:23,160 --> 00:14:25,920
.كنّا سنذهب لجمع بعض الكستناء فحسب

205
00:14:26,130 --> 00:14:27,290
أتريدين المجيء معنا؟

206
00:14:28,030 --> 00:14:29,380
!نعم

207
00:14:32,070 --> 00:14:35,560
بالمناسبة، هناك الكثير
.من فِطر الشّيتاكي هنا أيضًا

208
00:14:35,560 --> 00:14:36,840
أنجمع بعضه؟

209
00:14:36,840 --> 00:14:38,760
.نعم، كم أودّ أكل بعضه

210
00:14:40,230 --> 00:14:41,900
،بالمناسبة

211
00:14:41,900 --> 00:14:44,320
ما الّذي حدث بالحاجز
الّذي على شجرة الأرْز العظيمة؟

212
00:14:44,520 --> 00:14:46,440
وضعتَ واحدًا جديدًا بعد ذلك، صحيح؟

213
00:14:46,440 --> 00:14:49,020
...ماذا؟ ذلك

214
00:14:49,300 --> 00:14:51,710
.كنتُ أفكّر في ذلك

215
00:14:55,430 --> 00:14:56,580
....جيـ

216
00:14:56,800 --> 00:14:59,280
!جيرو! لماذا؟

217
00:14:59,280 --> 00:15:00,850
...إنّ.. إنّ ذلك

218
00:15:00,850 --> 00:15:04,540
أقوم بتغييره في كلّ موسم شتاء
—في العادة، لذلك كنتُ أنتظر

219
00:15:03,800 --> 00:15:04,540
...لكن

220
00:15:04,640 --> 00:15:07,680
!كان هذا مجرّد حاجز طارئ مؤقّت، صحيح؟

221
00:15:07,680 --> 00:15:09,160
!عليك تغييره بسرعة

222
00:15:09,160 --> 00:15:11,330
!أخبريه أن يقوم بذلك أيضًا يا تشيو-تشان

223
00:15:12,140 --> 00:15:13,800
.معك حقّ

224
00:15:15,040 --> 00:15:15,680
...لكن

225
00:15:16,120 --> 00:15:19,580
،رغم أنّه كان مجرّد حلّ مُرتجل
.فذلك لا يعني أنّه ضعيف

226
00:15:21,300 --> 00:15:24,910
.ما زال صامدًا ويحمي شجرة الأرْز العظيمة

227
00:15:26,620 --> 00:15:28,490
.لذلك لا داعي للقلق

228
00:15:29,870 --> 00:15:31,080
...مفهوم

229
00:15:32,260 --> 00:15:34,640
،عندما سأضع الحاجز الجديد

230
00:15:34,640 --> 00:15:37,450
.سيكون عليّ فكّ هذه العقدة

231
00:15:37,880 --> 00:15:41,140
.قد يكون القيام بذلك صعبًا قليلاً هذه السّنة

232
00:15:42,760 --> 00:15:43,800
...جيرو

233
00:15:45,400 --> 00:15:47,080
!انس ذلك

234
00:15:47,460 --> 00:15:51,540
...إنّك حقًّا... ما كانت الكلمة؟ رومان

235
00:15:51,540 --> 00:15:53,130
تقصدين "رومانتيكيّ"؟

236
00:15:53,130 --> 00:15:54,040
!نعم، ذلك

237
00:15:57,320 --> 00:15:58,520
...حسنًا

238
00:15:58,700 --> 00:16:01,870
.سأنقش هذا المنظر في ذاكرتي فحسب

239
00:16:01,870 --> 00:16:04,000
ألا يمكنك التقاط صورة فحسب؟

240
00:16:04,000 --> 00:16:06,480
...تلك فكرة جيّدة أيضًا. كما أنّ

241
00:16:06,680 --> 00:16:09,400
...حقيقة أنّك من ربطها من أجلي

242
00:16:09,400 --> 00:16:12,480
...وكيف أنّ الجميع ساعدوا في ذلك

243
00:16:13,530 --> 00:16:14,970
.تجعلني أريد تذكّر كلّ ذلك

244
00:16:15,880 --> 00:16:16,980
.للأبد

245
00:16:21,120 --> 00:16:26,750
هل يمكنني ربط الحبل الأحمر على
أحد أغصان الشّجرة كتميمة حماية؟

246
00:16:29,500 --> 00:16:30,750
.لا أمانع

247
00:16:31,470 --> 00:16:35,000
...عندما يحين ذلك الوقت
أتريدني أن أربطه ثانية؟

248
00:16:37,880 --> 00:16:39,040
.شكرًا لك

249
00:16:47,520 --> 00:16:52,110
.لا ينبغي عليك الاستخفاف بمشاعرها

250
00:16:52,410 --> 00:16:53,110
.نعم

251
00:16:53,660 --> 00:16:58,540
.إنّها تتمنّى من أعماق قلبها أن تحميك

252
00:16:59,160 --> 00:17:03,160
.عليك الاستجابة لمشاعرها بالاهتمام بنفسك

253
00:17:03,160 --> 00:17:04,500
!أنتما هناك

254
00:17:04,710 --> 00:17:06,990
!أسرعا

255
00:17:08,880 --> 00:17:10,030
.أعلم

256
00:17:11,050 --> 00:17:14,570
إنّ الوقت لا يجري بالنّسبة لها
.كما يجري بالنّسبة لنا

257
00:17:15,280 --> 00:17:19,000
الآن" هي الفرصة الوحيدة"
.الّتي لديك للرّدّ عليها

258
00:17:24,680 --> 00:17:27,270
.سررت لأنّنا خرجنا للصّيد معًا اليوم

259
00:17:27,400 --> 00:17:30,770
.قد لا تتسنّى لنا فرص أكثر من الآن فصاعدًا

260
00:17:30,770 --> 00:17:32,730
ماذا؟ أهذا صحيح؟

261
00:17:32,930 --> 00:17:35,350
تعرفان أنّ أمّي كانت في دار عجزة، صحيح؟

262
00:17:35,350 --> 00:17:37,610
.سنعتني بها في المنزل الآن

263
00:17:38,370 --> 00:17:41,080
إنّ مشاهدتها وهي تصير أضعف وأضعف

264
00:17:41,840 --> 00:17:44,480
.جعلتني أبدأ بالتّفكير أكثر في الموت

265
00:17:44,920 --> 00:17:49,040
وعندما أفكّر فيما أودّ فعله
،عندما تقترب ساعتي

266
00:17:49,610 --> 00:17:55,950
أدرك أنّي أريد قضاء بقيّة حياتي
.في مكان أشعر فيه بالرّاحة

267
00:17:57,630 --> 00:18:00,850
،لذلك سألتُ أمّي عمّا تريده فعلاً

268
00:18:00,850 --> 00:18:03,100
.وكانت تشعر كذلك أيضًا

269
00:18:03,760 --> 00:18:05,840
!يا إلهي! أنا آسف

270
00:18:05,840 --> 00:18:09,130
.لماذا تتأسف؟ لا تبالي، لا تبالي

271
00:18:09,130 --> 00:18:11,120
.هذا صحيح

272
00:18:11,120 --> 00:18:13,990
.يمكن أن يختلف طول العمر اختلافًا كبيرًا

273
00:18:13,990 --> 00:18:16,990
...من الصّعب عليّ التّعاطف الآن، ولكن

274
00:18:18,380 --> 00:18:20,960
،من بين الظّروف الكثيرة الّتي تعيشها

275
00:18:20,960 --> 00:18:24,850
واضح لي أنّك أعطيت الأوليّة لرغبات
.قلبك عندما فكّرت في هذا مليًّا

276
00:18:27,090 --> 00:18:28,080
.نعم

277
00:18:28,580 --> 00:18:31,400
.لا تتردّد في السّؤال إن احتجت لأيّ شيء

278
00:18:31,400 --> 00:18:33,000
.نحن هنا لتقديم يد العون

279
00:18:33,000 --> 00:18:36,250
.بإمكاني توصيل بعض خبزنا إلى منزلك

280
00:18:36,760 --> 00:18:39,330
.شكرًا لكما

281
00:18:42,490 --> 00:18:44,260
حسنًا، هل نعود لمنازلنا؟

282
00:18:44,550 --> 00:18:45,530
.نعم

283
00:18:47,740 --> 00:18:50,550
.صارت الرّياح أكثر برودة

284
00:18:50,550 --> 00:18:55,000
.أكيد. يبدو أنّه ينتظرنا شتاء بارد آخر

285
00:20:27,500 --> 00:20:29,180
هل سمعتم

286
00:20:29,520 --> 00:20:32,200
الإشاعة عن الحيوان المحنّط
في غرفة التّجارب العلميّة؟

287
00:20:32,660 --> 00:20:34,530
تقصد التّانوكي المحشوّ؟

288
00:20:34,530 --> 00:20:35,520
!نعم

289
00:20:35,520 --> 00:20:40,080
يُقال أنّه قُتل على يد شخص ما
...ظنّ أنّه مجرّد تانوكي

290
00:20:40,080 --> 00:20:42,590
!لكنّه في الحقيقة باكيدانوكي

291
00:20:43,080 --> 00:20:44,680
ماذا؟ معقول؟

292
00:20:44,680 --> 00:20:47,080
!كفّ عن هذا! أنت تخيفني

293
00:20:47,080 --> 00:20:48,050
!هناك المزيد

294
00:20:48,570 --> 00:20:51,200
،ما زال يحمل ضغينة لأنّه قُتل

295
00:20:51,200 --> 00:20:58,900
...حزين جدًّا... اللّعنة عليك... لن أسامحك

296
00:20:51,590 --> 00:20:56,260
وصار الآن روحًا منتقمة تجول الأرجاء وهي تُتمتم

297
00:20:56,260 --> 00:20:59,430
!بينما تبحث عن الشّخص الّذي قتلها

298
00:21:00,480 --> 00:21:01,730
.لن أسامحك

299
00:21:04,500 --> 00:21:05,600
!هذا مخيف

300
00:21:05,600 --> 00:21:07,990
.تقول الشّائعات أنّه يظهر بعد انتهاء الدّراسة

301
00:21:07,990 --> 00:21:09,120
!أي الآن

302
00:21:10,480 --> 00:21:12,200
!لنذهب ونرى إن كان ذلك صحيحًا

303
00:21:20,560 --> 00:21:21,730
.اذهب أنت

304
00:21:21,730 --> 00:21:23,130
!اذهب أنت يا ريو

305
00:21:23,130 --> 00:21:25,790
!لماذا أنا؟! كانت فكرتك

306
00:21:24,700 --> 00:21:26,730
لماذا لا نذهب جميعًا معًا؟

307
00:21:27,160 --> 00:21:27,680
.عفوًا

308
00:21:30,230 --> 00:21:32,960
!يا إلهي، لقد أخفتموني

309
00:21:32,960 --> 00:21:35,240
ما الّذي تفعلونه هنا؟

310
00:21:36,680 --> 00:21:40,440
شبح باكيدانوكي؟ أحد ألغاز المدرسة السّبعة؟

311
00:21:40,440 --> 00:21:43,850
ألا يفترض بكم أن تسألوا
يوسكي-كُن عن ذلك فحسب؟

312
00:21:45,240 --> 00:21:46,820
.فهمت

313
00:21:46,820 --> 00:21:49,160
تريدون أن تعرفوا ما حقيقة ذلك التّانوكي المحنّط؟

314
00:21:49,160 --> 00:21:50,860
.نعم، هذا صحيح

315
00:21:50,860 --> 00:21:52,610
ما هي يا يوسكي-كُن؟

316
00:21:54,000 --> 00:21:54,870
...حسنًا

317
00:21:56,870 --> 00:21:58,760
.إنّه مجرّد تانوكي

318
00:22:00,040 --> 00:22:01,630
.بالطّبع هو كذلك

319
00:22:02,060 --> 00:22:04,010
.ولكن عليكم أن تكونوا حذرين

320
00:22:04,010 --> 00:22:04,770
ماذا؟

321
00:22:05,040 --> 00:22:07,160
سمعتم عن الكوتوداما، صحيح؟

322
00:22:07,490 --> 00:22:10,180
.إنّها الطّاقة الرّوحيّة الّتي تسكن الكلمات

323
00:22:11,230 --> 00:22:13,900
،عندما تجتمع الكثير من الإشاعات والكوتوداما معًا

324
00:22:13,900 --> 00:22:16,640
.تولد روح جديدة

325
00:22:16,640 --> 00:22:20,250
.بتعبير آخر، تصير الإشاعات حقيقة

326
00:22:22,190 --> 00:22:24,200
.أنا خير مثال على ذلك

327
00:22:24,200 --> 00:22:27,790
صرتُ قادرًا على الحركة
.لأنّ الجميع نشر إشاعات عنّي

328
00:22:28,070 --> 00:22:29,450
...هذا صحيح

329
00:22:30,050 --> 00:22:32,520
.لذلك كونوا حذرين بخصوص ما تقولونه

330
00:22:34,280 --> 00:22:37,100
وذلك ينطبق على الإشاعات
.والإهانات على حدّ سواء

331
00:22:38,940 --> 00:22:40,080
،أي بتعبير آخر

332
00:22:40,080 --> 00:22:42,240
،ما دمنا لن ننشر الإشاعة

333
00:22:42,240 --> 00:22:44,600
فلن يكون هنالك أيّ باكيدانوكي؟

334
00:22:44,600 --> 00:22:46,920
.يبدو ذلك مملاًّ نوعًا ما

335
00:22:46,920 --> 00:22:48,710
!يا هذا

336
00:22:48,710 --> 00:22:51,690
!قل أشياء كهذه وسيطاردك شبح مخيف

337
00:22:50,390 --> 00:22:51,200
ماذا؟

338
00:22:51,410 --> 00:22:52,640
ماذا هنالك؟

339
00:22:53,080 --> 00:22:55,870
هل ينقصنا أحد ما؟

340
00:22:55,870 --> 00:22:57,650
.نعم، معك حقّ

341
00:22:57,650 --> 00:22:58,680
ماذا؟

342
00:22:58,680 --> 00:23:01,490
.ذلك الفتى حليق الشّعر ليس معنا

343
00:23:01,490 --> 00:23:03,170
ألم يكن معنا قبل قليل؟

344
00:23:03,170 --> 00:23:05,270
ربّما عاد للمنزل؟

345
00:23:05,270 --> 00:23:07,400
.بالتّفكير في الأمر، أنا لا أعرف حتّى اسمه

346
00:23:07,790 --> 00:23:09,780
من أيّ فصل هو؟

347
00:23:09,780 --> 00:23:11,860
.لم أرى أيّ فتى ممّا تصفانه هنا

348
00:23:12,560 --> 00:23:14,600
كنّا نحن فقط هناك، صحيح؟

349
00:23:16,180 --> 00:23:17,040
ماذا؟

350
00:23:33,710 --> 00:23:37,130
.لا شيء يخيف أكثر من إشاعة خطيرة