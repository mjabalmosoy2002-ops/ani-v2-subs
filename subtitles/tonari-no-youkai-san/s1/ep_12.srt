1
00:00:11,480 --> 00:00:14,510
.وفجأة، فُتح صدع كبير جدًّا في السّماء

2
00:00:15,220 --> 00:00:20,620
.وكانت تلك بداية يوم طويل جدًّا

3
00:01:54,210 --> 00:01:55,370
...مهلاً، إنّ هذا

4
00:01:55,370 --> 00:01:56,460
ما هذا؟

5
00:01:56,460 --> 00:01:57,900
!هناك شيء ما يسقط

6
00:01:58,500 --> 00:01:59,430
!اهربوا، اهربوا

7
00:02:00,320 --> 00:02:01,400
ما هذا؟

8
00:02:05,300 --> 00:02:06,640
!سانموتو؟

9
00:02:07,190 --> 00:02:09,320
.تمّ قطع رابطي بجسدي الأساسيّ

10
00:02:09,890 --> 00:02:13,310
.وبما أنّي مجرّد نسخة، أعتقد أنّي سأختفي قريبًا

11
00:02:14,050 --> 00:02:16,090
.أراك لاحقًا يا أبيند

12
00:02:19,750 --> 00:02:22,430
!سانموتو-سان! هل أنت بخير؟

13
00:02:23,630 --> 00:02:26,790
.أفتقر... للقوّة فحسب

14
00:02:27,590 --> 00:02:29,040
.آسف لأنّي جعلتك تمرّ بهذا

15
00:02:32,210 --> 00:02:33,480
—سانموتو

16
00:02:40,680 --> 00:02:42,780
لماذا يحدث هذا؟

17
00:02:59,160 --> 00:03:00,940
بوتشيو-سان، هل أنت بخير؟

18
00:03:00,940 --> 00:03:02,360
!ساكاكي-سان؟

19
00:03:02,360 --> 00:03:03,910
!أنا قادم

20
00:03:03,910 --> 00:03:06,040
!بوتشيو-سان

21
00:03:07,160 --> 00:03:07,990
!اركبوا

22
00:03:08,610 --> 00:03:09,440
!بسرعة

23
00:03:12,440 --> 00:03:14,450
!ما الّذي يحدث...؟

24
00:03:14,450 --> 00:03:16,330
.إنّه انكسار حدود

25
00:03:16,500 --> 00:03:18,330
!كانت الشّائعة صحيحة

26
00:03:18,710 --> 00:03:19,280
ماذا؟

27
00:03:19,760 --> 00:03:23,280
...إذًا فالوحش الّذي سقط من السّماء

28
00:03:23,280 --> 00:03:24,260
.إنّه أوني

29
00:03:24,260 --> 00:03:26,180
ماذا؟ كان ذلك أوني؟

30
00:03:26,180 --> 00:03:28,290
الكائنات الغامضة الّتي تأتي من بوّابة الشّيطان؟

31
00:03:28,650 --> 00:03:29,260
.نعم

32
00:03:30,950 --> 00:03:33,820
...مهلاً، بما أنّه أتى من الفتحة

33
00:03:34,440 --> 00:03:37,050
هل يعني ذلك أنّ "الأوني" كائنات من عالم آخر؟

34
00:03:38,540 --> 00:03:41,320
وهل بوّابة الشّيطان عبارة عن تشوّه في الفضاء؟

35
00:03:41,320 --> 00:03:43,340
مهلاً، ما الّذي تحمله؟

36
00:03:43,920 --> 00:03:45,580
.إنّه سانموتو-سان

37
00:03:45,580 --> 00:03:46,990
!ماذا؟! لا يعقل

38
00:03:47,360 --> 00:03:51,200
.تداعى جسده فجأة، وهذا ما بقي منه

39
00:03:52,230 --> 00:03:55,400
ساكاكي-سان... مهما تطلّب
...الأمر، فأنا سوف

40
00:03:56,120 --> 00:03:57,560
...إنّ سانموتو-سان

41
00:03:59,660 --> 00:04:00,800
.لا بأس

42
00:04:01,080 --> 00:04:04,330
.سانموتو-سان ملك شياطين. إنّه لا يموت

43
00:04:07,020 --> 00:04:07,640
...نعم

44
00:04:13,040 --> 00:04:13,900
!ماما-سان

45
00:04:14,620 --> 00:04:15,530
مرحبًا؟

46
00:04:15,530 --> 00:04:19,360
!بوتشيو! أنا مسرورة لأنّك أجبت

47
00:04:19,360 --> 00:04:21,300
هل أنتم سالمون؟ ماذا عن تاكومي؟

48
00:04:21,300 --> 00:04:22,310
!أنا بخير

49
00:04:22,460 --> 00:04:25,040
حسنًا... وواغن-سان؟

50
00:04:26,060 --> 00:04:26,880
...نعم

51
00:04:27,550 --> 00:04:29,030
ماذا عنكم أنتم؟

52
00:04:29,410 --> 00:04:32,440
.نحن بخير. عائلة أويشي كلّها سالمة

53
00:04:33,480 --> 00:04:35,960
.هذا مخيف، صحيح؟ أنا خائفة أيضًا

54
00:04:37,190 --> 00:04:39,140
.لكنّي سأبذل جهدي

55
00:04:40,250 --> 00:04:43,250
.بوتشيو... اعتنِ بتاكومي رجاءً

56
00:04:43,680 --> 00:04:44,350
.حاضر

57
00:04:46,480 --> 00:04:47,880
!لا تنظروا للخارج

58
00:04:47,880 --> 00:04:48,800
!تاكومي-كُن

59
00:04:50,240 --> 00:04:52,640
!أنا... سأحميك

60
00:04:53,960 --> 00:04:58,650
يتعرّض النّاس للهجوم في الخارج
من طرف الأوني؟

61
00:04:59,940 --> 00:05:01,180
...وكأنّنا في فيلم

62
00:05:03,960 --> 00:05:04,930
.كلاّ

63
00:05:06,020 --> 00:05:07,850
.هذا ليس فيلمًا

64
00:05:09,930 --> 00:05:12,900
.ليس فيلمًا على الإطلاق

65
00:05:16,290 --> 00:05:19,690
صدع في الفضاء... هل هناك من يتدخّل؟

66
00:05:20,900 --> 00:05:24,760
.جدار النّور ذاك... لقد وقع تمزّقٌ في الفضاء

67
00:05:25,820 --> 00:05:27,560
.إنّها إرادة هذا العالم

68
00:05:28,120 --> 00:05:30,800
.طريقة لإصلاح الجرح الّذي فُتح

69
00:05:30,800 --> 00:05:32,340
.بالإمكان وصفه بجُلبَة

70
00:05:33,000 --> 00:05:37,040
.ذكر أبي أنّ شيئًا مماثلاً حدث قبل 500 سنة

71
00:05:38,560 --> 00:05:41,240
كارثة جماعيّة سقطت فيها
.نيازك في العديد من الدّول

72
00:05:42,160 --> 00:05:45,840
على ما يبدو، جاءت تلك النيازك
.من عالم مختلف

73
00:05:47,010 --> 00:05:51,440
،كان وقتها مجرّد جرح صغير
...ولكنّ واحدًا بهذا الحجم قد

74
00:05:52,440 --> 00:05:55,010
إذًا كلّ ما يمكننا فعله هو أن ندعو
ليكون الجميع آمنين؟

75
00:05:57,510 --> 00:06:00,130
،وفقًا للفرع الياباني لمختبر الزّمكان

76
00:06:00,130 --> 00:06:02,980
،فإن الصّدع الّذي يُعتقد أنّه تداخل من عالم آخر

77
00:06:02,980 --> 00:06:07,770
يمتدّ على طول ساحل المحيط
.الهادئ من كانتو إلى كيوشو

78
00:06:08,200 --> 00:06:10,820
،وبسبب التّمزّق الفضائيّ

79
00:06:10,820 --> 00:06:14,640
أصبح السّفر إلى المناطق الخارجيّة
.والتّواصل معها مستحيلاً الآن

80
00:06:14,640 --> 00:06:18,160
هناك أيضًا تقارير متعدّدة عن الأضرار
.الّتي سبّبتها الأوني في جميع أنحاء المدينة

81
00:06:17,430 --> 00:06:18,650
هل الجميع هنا؟

82
00:06:20,860 --> 00:06:22,940
أوني؟ الكائنات من أعماق الجبال؟

83
00:06:22,940 --> 00:06:26,150
.نعم. ستظهر هنا قريبًا

84
00:06:27,930 --> 00:06:30,400
،واثق أنّ جمعيّة التّنغو ستتشارك المعلومات

85
00:06:30,400 --> 00:06:32,760
.لكن تذكّروا طريقة التّعامل مع الأوني

86
00:06:32,760 --> 00:06:34,080
طريقة التّعامل معها؟

87
00:06:34,430 --> 00:06:37,880
.الكلام. وبأقلّ قدر ممكن

88
00:06:38,160 --> 00:06:42,000
إنّها تتفاعل مع الأصوات الّتي تحمل
.الخوف والعداء على وجه الخصوص

89
00:06:42,600 --> 00:06:46,210
.سنذهب للمساعدة في الإخلاء ونشر المعلومات

90
00:06:47,180 --> 00:06:47,960
...ولكنّه

91
00:06:49,480 --> 00:06:51,320
هلاّ اعتنيتم بما-سان؟

92
00:06:54,330 --> 00:06:56,240
.نعم. سنعتني به

93
00:06:59,480 --> 00:07:03,170
.اسمعا كلاكما، كونا حذرين رجاءً

94
00:07:03,750 --> 00:07:05,440
.أكيد. وأنتم كذلك

95
00:07:11,230 --> 00:07:13,380
.حسنًا، من الأفضل أن ندخل

96
00:07:21,200 --> 00:07:22,840
!جيرو! أيّها العمّ

97
00:07:26,130 --> 00:07:27,080
مو-تشان؟

98
00:07:28,500 --> 00:07:29,300
هل أنت خائفة؟

99
00:07:30,460 --> 00:07:33,680
.نعم. قليلاً فحسب

100
00:07:34,970 --> 00:07:37,430
.لكنّي اتّخذت قراري

101
00:07:38,320 --> 00:07:40,550
!سأحمي ما-سان

102
00:07:41,010 --> 00:07:44,390
!وسأحمي نفسي، وأنت أيضًا

103
00:07:44,810 --> 00:07:45,450
.حسنًا

104
00:07:45,690 --> 00:07:47,600
!والعمّ أيضًا! وكذلك الجميع

105
00:07:47,770 --> 00:07:49,710
.نعم. أنت محقّة

106
00:07:50,510 --> 00:07:53,600
.سأحمي الجميع أيضًا. بيننا وعد قبل كلّ شيء

107
00:07:54,600 --> 00:07:58,760
قطعنا وعدًا بفعل كلّ ما نستطيع
.لمساعدة بعضنا

108
00:08:03,050 --> 00:08:04,150
.سيكون كلّ شيء بخير

109
00:08:07,490 --> 00:08:08,030
.نعم

110
00:08:16,640 --> 00:08:18,740
!لا أستطيع الموت الآن

111
00:08:27,240 --> 00:08:29,160
!آسف لاستعمالك كطُعم

112
00:08:30,560 --> 00:08:32,570
ماذا؟ هل تسجّل هذا؟

113
00:08:32,570 --> 00:08:34,620
.أسرع. ستظلّ في الخلف

114
00:08:38,440 --> 00:08:41,450
!أقسم أنّي سأنجو يا تشياكي

115
00:08:46,620 --> 00:08:47,480
...ني-تشان

116
00:08:48,230 --> 00:08:48,920
...تايرا

117
00:09:26,000 --> 00:09:26,800
!تايرا

118
00:09:54,190 --> 00:09:56,310
...أمّي

119
00:10:05,740 --> 00:10:09,300
...أ-أمّي

120
00:10:12,280 --> 00:10:16,080
...أين أنت؟ أشعر بالخوف

121
00:10:20,980 --> 00:10:21,680
ماذا؟

122
00:10:23,960 --> 00:10:28,170
.اكتمل تحليل مختبر الزّمكان للبعد الآخر

123
00:10:28,170 --> 00:10:31,520
،لقد تمّ تحديد أنّ البعد المتداخل هو نيينتي أ-0-6

124
00:10:31,520 --> 00:10:34,460
."والمعروف أيضًا بـ"العدم

125
00:10:34,790 --> 00:10:38,720
—أكرّر: اكتمل تحليل مختبر الزّمكان

126
00:10:36,900 --> 00:10:39,000
.سأكتم صوت التّلفاز

127
00:10:39,950 --> 00:10:42,270
.لنظلّ معًا جميعًا قدر الإمكان

128
00:10:50,200 --> 00:10:54,250
ذُكر هنا أنّ البُعد الّذي تداخل
.مع تلك الفتحة يُدعى نيينتي

129
00:10:54,610 --> 00:10:55,740
نيينتي؟

130
00:10:56,060 --> 00:10:58,190
.إنّه مكان غامض للغاية

131
00:10:59,120 --> 00:11:01,930
،تتواجد العديد منها بين العوالم

132
00:11:02,640 --> 00:11:04,880
...وكلّ الإشارات الّتي تُبعث هناك خلال المراقبة

133
00:11:05,440 --> 00:11:07,760
.تختفي في لحظة دخولها

134
00:11:08,390 --> 00:11:10,290
."لذلك السّبب يصفونه بـ"العدم

135
00:11:11,000 --> 00:11:16,000
إنّ خصائص هذا "العدم" تبدو
...مشابهة جدًّا للفراغ

136
00:11:19,190 --> 00:11:19,850
.قادم

137
00:11:24,510 --> 00:11:25,690
!ما-سان؟

138
00:11:25,690 --> 00:11:26,610
!مهلاً

139
00:11:26,610 --> 00:11:27,160
!ساناي

140
00:11:27,160 --> 00:11:27,960
!ما-سان

141
00:11:31,250 --> 00:11:32,120
...ما-سان

142
00:11:42,510 --> 00:11:44,720
...أنا... إنّني

143
00:11:45,450 --> 00:11:46,660
أين أنا؟

144
00:11:48,380 --> 00:11:52,390
.أعتقد أنّ هذا سيكون آخر انتقال لي

145
00:11:53,620 --> 00:11:55,830
.وبعد ذلك سأساعد في أعمال المنزل

146
00:11:56,270 --> 00:11:58,070
.أنا أحبّ الوظيفة الّتي لديّ الآن بالفعل

147
00:11:58,800 --> 00:12:00,660
.أريد أن أنهي الأمر بدون أيّ ندم

148
00:12:05,410 --> 00:12:06,260
...ولكن

149
00:12:06,260 --> 00:12:08,240
.لا تجهد نفسك كثيرًا فحسب

150
00:12:08,970 --> 00:12:13,500
إنّك تميل إلى إغفال نفسك
.عندما تنشغل بالعمل

151
00:12:17,920 --> 00:12:21,920
أكره نفسي لأنّني لم أفعل شيئًا
.سوى القلق في ذلك الوقت

152
00:12:22,830 --> 00:12:24,820
.لا أريد أن أنكر من أنت الآن

153
00:12:25,460 --> 00:12:27,780
...لذلك... لذلك السّبب

154
00:12:28,460 --> 00:12:30,210
...إن كان هنالك شيء واحد يمكنني قوله لك

155
00:12:34,390 --> 00:12:36,800
!فهو أنّي هنا إلى جانبك

156
00:12:43,240 --> 00:12:44,200
!ساناي

157
00:12:47,830 --> 00:12:50,670
!ابتعدي أيّتها الأوني

158
00:12:57,410 --> 00:12:58,250
جيرو؟

159
00:12:59,040 --> 00:13:01,040
!أسرعي بالدّخول

160
00:13:03,480 --> 00:13:05,040
!هل أنتم بخير؟

161
00:13:05,650 --> 00:13:07,380
!أوني... توجد أوني في الخارج

162
00:13:08,520 --> 00:13:09,570
!لندخل

163
00:13:15,970 --> 00:13:18,010
!كنت قلقة عليك

164
00:13:18,280 --> 00:13:20,730
.أختي، إنّك تؤذين ما-سان

165
00:13:21,090 --> 00:13:24,560
...ظننتُ أنّك غادرت لمكان ما ثانية

166
00:13:25,810 --> 00:13:26,570
...لكنّ

167
00:13:27,590 --> 00:13:30,300
...قول ذلك لك الآن

168
00:13:31,700 --> 00:13:32,720
!لا فائدة منه

169
00:13:55,980 --> 00:13:56,910
!تازنبو-سان

170
00:13:57,110 --> 00:13:58,020
.نعم

171
00:14:04,480 --> 00:14:06,990
.يجب عزل الأوني الآن

172
00:14:07,700 --> 00:14:08,940
.نعم

173
00:14:09,320 --> 00:14:12,100
آمل فقط ألاّ يكون الأوان
.قد تأخّر على هروب أيّ أحد

174
00:14:17,960 --> 00:14:19,070
.اذهب

175
00:14:20,280 --> 00:14:23,960
.وإيّاك أن تضحّي بمشاعرك الخاصّة

176
00:14:30,620 --> 00:14:31,210
.حاضر

177
00:14:32,330 --> 00:14:33,640
.سأترك الباقي لك

178
00:14:36,860 --> 00:14:39,720
اجلسوا على جانب الممرّ، مفهوم؟
.تجنّبوا جانب النّوافذ

179
00:14:46,380 --> 00:14:47,490
!يوسكي

180
00:14:48,240 --> 00:14:50,090
!ما الّذي تفعله على الأرض؟

181
00:14:50,620 --> 00:14:52,070
...ها-هاناكو

182
00:14:52,430 --> 00:14:54,990
...هذا غريب... صرتُ فجأة

183
00:14:54,990 --> 00:14:56,960
.غير قادر على تحريك قدميّ

184
00:15:00,240 --> 00:15:01,410
ما هذا؟

185
00:15:04,320 --> 00:15:06,460
.الطّريق مسدودة خلف هذه النّقطة

186
00:15:06,790 --> 00:15:08,180
.يمكنكم أن تحتموا في هذا المبنى

187
00:15:08,680 --> 00:15:11,810
.وضعتُ حاجزًا عليه، لذلك لن يدخله أيّ أوني

188
00:15:12,120 --> 00:15:13,350
.هيّا، ادخلوا

189
00:15:14,710 --> 00:15:17,730
.سيروا ببطء، وخذوا المصعد حتّى الأعلى

190
00:15:18,370 --> 00:15:19,940
!أسرع يا واغن-سان

191
00:15:20,480 --> 00:15:24,810
بوتشيو-سان، أنت متوتّر جدًّا
.لدرجة أنّ جسدك منقبض

192
00:15:25,650 --> 00:15:27,100
.يمكنكم أن تسبقوني

193
00:15:27,730 --> 00:15:28,690
...لكن

194
00:15:28,960 --> 00:15:30,240
.سأكون بخير

195
00:15:32,490 --> 00:15:35,760
.حسنًا. اعتن بنفسك

196
00:15:36,490 --> 00:15:37,050
.أكيد

197
00:15:42,360 --> 00:15:43,520
...كازوهيكو

198
00:15:49,200 --> 00:15:50,160
سانموتو-سان؟

199
00:15:52,070 --> 00:15:53,490
ماذا حدث؟

200
00:15:54,530 --> 00:16:01,030
تلقّيتُ تحذيرات على شكل رؤى من
.وقت لآخر مؤخّرًا من نفسي المستقبليّة

201
00:16:02,000 --> 00:16:05,000
.لكنّي لم أستطع رؤيتها بوضوح بسبب الضّجيج

202
00:16:06,080 --> 00:16:11,630
تركتُ نسخًا أكثر حول العالم
،من باب الحيطة

203
00:16:12,260 --> 00:16:14,730
.لكن كان ترك جسدي الأساسيّ في اليابان خطأ

204
00:16:15,870 --> 00:16:18,870
إنّ القوّة الرّوحيّة الّتي بذلتُها
.على كلّ نسخة لن تعود إليّ الآن

205
00:16:19,130 --> 00:16:21,640
.أنا الآن ملك شياطين بلا أيّ قوى

206
00:16:22,710 --> 00:16:26,930
.إنّك متعلّق بشدّة بنا— بالعالم الحقيقيّ

207
00:16:27,460 --> 00:16:28,280
.هذا كثير

208
00:16:28,920 --> 00:16:30,040
.معك حقّ تمامًا

209
00:16:30,640 --> 00:16:33,330
.ولكن قمتُ بكلّ ذلك بدافع الحبّ

210
00:16:33,820 --> 00:16:35,390
.أرجو ألاّ تلومينني على ذلك

211
00:16:37,670 --> 00:16:41,520
صارت الرّؤى الّتي لم أستطع
.رؤيتها من قبل واضحة الآن أخيرًا

212
00:16:42,130 --> 00:16:45,690
.إنّ كارثة تفوق الأوني بكثير في طريقها إلينا

213
00:16:47,270 --> 00:16:50,950
،وبسبب تدخّل العدم
،فإنّ القوّة الّتي تدعم هذا العالم

214
00:16:50,950 --> 00:16:54,310
...وهي قوّة الكوتوداما، تختفي

215
00:16:56,240 --> 00:16:58,660
.إلى جانب الآلهة والأرواح

216
00:17:00,450 --> 00:17:03,910
!أين واغن-سان؟ لماذا لم يأتِ بعد؟

217
00:17:04,530 --> 00:17:05,670
!تاكومي-كُن

218
00:17:06,640 --> 00:17:09,760
!واغن-سان

219
00:17:10,240 --> 00:17:11,710
تتظاهر أنّك نائم، صحيح؟

220
00:17:12,430 --> 00:17:12,960
!صحيح؟

221
00:17:15,380 --> 00:17:16,970
!واغن-سان

222
00:17:23,070 --> 00:17:24,250
!لن أصل في الوقت المناسب

223
00:17:24,960 --> 00:17:27,400
!لن تصله يداي

224
00:17:30,390 --> 00:17:32,830
...تاكومي-كُن... عليّ أن

225
00:17:52,080 --> 00:17:53,240
...بوتشيو

226
00:17:54,710 --> 00:17:56,930
...تاكومي-كُن

227
00:18:06,480 --> 00:18:07,740
!اختبئوا! بسرعة

228
00:18:32,660 --> 00:18:34,120
...أعتقد أنّ هذه الأوني

229
00:18:34,680 --> 00:18:36,530
.كانت بشرًا من قبل

230
00:18:37,880 --> 00:18:39,850
لماذا أخذت هذه الهيئة؟

231
00:18:40,890 --> 00:18:44,600
...لا أشعر بأيّ قوّة روحيّة
.لا قلب ولا روح فيها

232
00:18:45,070 --> 00:18:46,570
،إنّها مجرّد أوعية جوفاء

233
00:18:47,020 --> 00:18:49,890
لكنّ تلك الكلمات المبعثرة الّتي
...أواصل سماعها

234
00:18:50,430 --> 00:18:53,770
هل هي ذكريات ظلّت من أيّامها كبشر؟

235
00:18:54,670 --> 00:18:57,360
.لا، لا تفكّر في ذلك

236
00:19:10,760 --> 00:19:12,340
...هدأ الوضع الآن

237
00:19:21,960 --> 00:19:23,960
.لقد دخل أحدها

238
00:19:33,200 --> 00:19:33,860
...أريد

239
00:19:34,900 --> 00:19:36,650
...العودة للمنزل

240
00:19:39,890 --> 00:19:40,560
...أنا

241
00:19:41,590 --> 00:19:43,430
...أشتاق

242
00:19:43,830 --> 00:19:46,510
...لأطفالي

243
00:19:49,530 --> 00:19:50,690
مامورو-كُن؟

244
00:19:51,510 --> 00:19:53,370
ماذا؟ ما الّذي يحدث؟

245
00:19:53,760 --> 00:19:54,600
.إنّه هنا

246
00:20:09,160 --> 00:20:10,140
أبي؟

247
00:20:11,320 --> 00:20:12,540
أهذا أنت يا أبي؟

248
00:20:16,360 --> 00:20:17,280
أبي؟

249
00:20:18,010 --> 00:20:21,990
لدى كوتوداما مو-تشان تأثير على الأوني؟

250
00:20:22,740 --> 00:20:24,120
هل أنت أبي بالفعل؟

251
00:21:04,340 --> 00:21:05,320
.لقد عدت

252
00:21:10,560 --> 00:21:15,180
.مـ-مرحبًا بعودتك يا أبي

253
00:21:22,550 --> 00:21:23,680
!أبي؟

254
00:21:37,330 --> 00:21:38,560
!أبي

255
00:21:38,560 --> 00:21:39,540
!تماسك

256
00:21:39,540 --> 00:21:42,680
!أبي! أبي... أبي

257
00:21:47,160 --> 00:21:48,480
!هل أنت بخير؟

258
00:21:48,960 --> 00:21:51,530
.تدخّل نيينتي في تقدّم سريع

259
00:21:51,930 --> 00:21:54,100
.بدأ سوما الأوني بالتّدهور

260
00:21:54,790 --> 00:21:57,120
.إنهاء برنامج الإصلاح التّكميليّ

261
00:21:58,480 --> 00:22:00,750
،سأسجّل أكبر قدر ممكن من البيانات

262
00:22:01,440 --> 00:22:03,130
.لكنّ هذه هي النّهاية بالنّسبة لنا أيضًا

263
00:22:05,370 --> 00:22:07,920
.يوشك العالم أن يُعكَس