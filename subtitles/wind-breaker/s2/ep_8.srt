1
00:01:30,650 --> 00:01:31,980
...حسناً إذاً

2
00:01:32,440 --> 00:01:35,820
...كعربون شكر لكم على تشجيع العمّ إيتو-سان

3
00:01:36,240 --> 00:01:37,610
!بصحّتكم

4
00:01:37,780 --> 00:01:38,820
شكراً، شكراً

5
00:01:38,820 --> 00:01:41,580
لحظة! ساكورا-سان، يجب أن
!تشرب النّخب أوّلاً

6
00:01:42,370 --> 00:01:45,000
لا عليك، لا عليك. يمكنك أن تأكل

7
00:01:45,960 --> 00:01:49,920
لذيذ، أليس كذلك؟ الطّعام هنا
!شهيّ حقّاً أيضاً

8
00:01:50,170 --> 00:01:53,340
كُلوا كثيراً. الطّعام كُلّه على حسابي اليوم

9
00:01:53,500 --> 00:01:57,590
ساكورا-سان لا يُبالي حتّى عندما
يكون المكان مُوجّهاً للبالغين

10
00:01:57,590 --> 00:02:00,010
سو-سان، يبدو أنّك لا تُمانع ذلك أيضاً

11
00:02:00,010 --> 00:02:03,720
.العمّ مُفعم بالحيويّة مُؤخّراً
كأنّه شخص مُختلف تماماً الآن

12
00:02:04,680 --> 00:02:09,560
يتأنّق ويخرج لحضور أفلام
أو مسرحيّات كلّ يوم تقريباً

13
00:02:10,400 --> 00:02:14,820
قال بأنّه سيجمع قصصاً ليرويها
لزوجته قبل أن يلحق بها

14
00:02:15,190 --> 00:02:17,150
يبدو هذا سوداويّاً بعض الشّيء

15
00:02:17,570 --> 00:02:22,910
لكنّه قادر على التّفكير بتلك الطّريقة
بفضلكم جميعاً

16
00:02:25,490 --> 00:02:28,460
أشكركم من القلب

17
00:02:29,750 --> 00:02:31,880
!لـ-لم نفعل شيئاً

18
00:02:31,880 --> 00:02:33,250
أليس كذلك يا ساكورا-سان؟

19
00:02:34,210 --> 00:02:37,300
استمتعتُ بالتكلّم معه أيضاً

20
00:02:37,380 --> 00:02:38,670
أوه

21
00:02:39,510 --> 00:02:42,850
!طـ-طبق فاكهة! أحضروا لهؤلاء طبق فاكهة

22
00:02:39,970 --> 00:02:41,470
لُهاث لُهاث

23
00:02:42,850 --> 00:02:45,350
!مرحى! طبق فاكهة

24
00:02:45,890 --> 00:02:49,060
المعذرة! هل يمكنني الحصول على طبق
آخر من هذا قبل ذلك؟

25
00:02:49,310 --> 00:02:50,520
!ساكاكي-سان

26
00:02:50,520 --> 00:02:52,770
مرحباً. لاحظت أخيراً

27
00:02:52,980 --> 00:02:55,070
أنا مُمتنّ حقّاً يا صاح

28
00:02:55,070 --> 00:02:57,690
بفضلكم، حصلنا على وجبة مجّانيّة

29
00:02:57,690 --> 00:02:59,740
ماذا؟ ما كلّ هذه الصّحون؟

30
00:02:59,740 --> 00:03:02,620
!في الواقع، كلّ الأطباق لذيذة

31
00:03:02,700 --> 00:03:04,120
يا للهول

32
00:03:04,330 --> 00:03:06,740
!إلغاء! ألغِ طبق الفاكهة

33
00:03:06,740 --> 00:03:09,540
ماذا؟ كنتُ سأجعله تحليتنا

34
00:03:09,540 --> 00:03:11,250
إذاً هل لي بمجموعة كعك؟

35
00:03:11,250 --> 00:03:12,420
!أرفُض ذلك أيضاً

36
00:03:12,420 --> 00:03:13,210
!بخيل

37
00:03:13,210 --> 00:03:19,170
غضب

38
00:03:13,580 --> 00:03:15,670
ألا تعرفان معنى التحفُّظ؟

39
00:03:15,670 --> 00:03:17,250
مـ-مهلاً، مهلاً

40
00:03:17,250 --> 00:03:19,170
،أنا مُمتنّ للطّعام

41
00:03:19,720 --> 00:03:23,220
لكن كان رقصك مُبهراً حقّاً

42
00:03:23,390 --> 00:03:27,930
امتلأ قلبي بهجة بمُجرّد رؤية شيء مُذهل
كهذا. أليس كذلك يا ساكورا-سان؟

43
00:03:28,390 --> 00:03:30,600
فمُ ساكورا-كن مُمتلئ

44
00:03:30,850 --> 00:03:32,980
!عجباً لكم

45
00:03:33,100 --> 00:03:37,320
تمتلك موهبة كهذه وتستعرضها
!في مكان كهذا

46
00:03:37,320 --> 00:03:42,200
متى بدأت؟ أي نوع من الرّقصات كانت؟
لماذا ترقص هنا؟

47
00:03:42,400 --> 00:03:44,780
ألا تخجل عندما يتعلّق الأمر
بمثل هذه الأمور؟

48
00:03:44,780 --> 00:03:47,620
مهلاً! هذا ليس بالشّيء المُميّز

49
00:03:48,040 --> 00:03:49,660
كان ذلك رقصاً على العمود

50
00:03:49,660 --> 00:03:53,000
،بعد مُشاهدة بعض الفيديوهات على الإنترنت
أصبحتُ مُدمناً تماماً

51
00:03:53,670 --> 00:03:57,250
وبينما كنتُ أرقص، بدأتُ أشعر
بالرّغبة في الرّقص على مسرح

52
00:03:57,750 --> 00:04:01,550
،لكن لا توجد أماكن كهذه بالقرب من فورين
لذا خرجتُ إلى هنا، شارع كيسي

53
00:04:01,550 --> 00:04:05,390
توسّلتُ المُدير بشكل مُباشر
ليسمح لي بالرّقص هنا

54
00:04:05,510 --> 00:04:07,760
مُـ-مُذهل، أنت حازم جدّاً

55
00:04:07,760 --> 00:04:09,390
!أجل

56
00:04:09,390 --> 00:04:13,390
!أريد فعل ما أشاء. وأردتُ الرّقص هنا

57
00:04:13,600 --> 00:04:17,310
ما زلتُ أتذكّر نظرة المُدير عندما طلبتَ منه

58
00:04:17,610 --> 00:04:21,610
بدا وكأنّك لم تكُن ستُغادر ما لم تسمع
إجابة "نعم". كانت قد دمعت عيناك

59
00:04:21,990 --> 00:04:25,950
.لكن صعدتُ على المسرح الآن هكذا
لذا فالأمور بخير

60
00:04:22,860 --> 00:04:25,950
إنّهما مُنسجمان حقّاً -
أجل -

61
00:04:26,120 --> 00:04:27,620
ماذا عنك؟

62
00:04:27,620 --> 00:04:31,160
سمعتُ أنّك وطلّاب السّنة الأولى
أوقفتُم شِجار ثمالى. أليس كذلك؟

63
00:04:31,250 --> 00:04:31,870
بئساً

64
00:04:34,670 --> 00:04:35,830
هي هي

65
00:04:34,670 --> 00:04:36,380
!أجل، هذا صحيح

66
00:04:36,580 --> 00:04:37,460
خبطة خبطة

67
00:04:36,580 --> 00:04:38,840
!أنقذوني قبل قليل بالفعل

68
00:04:38,460 --> 00:04:38,840
خبطة

69
00:04:38,840 --> 00:04:41,340
!لا أعلم ما الّذي كان سيحدث لولاهم

70
00:04:40,460 --> 00:04:41,340
خبطة خبطة

71
00:04:41,340 --> 00:04:42,380
أ-أجل

72
00:04:42,670 --> 00:04:44,680
أحسنتم يا طُلّاب السّنة الأولى

73
00:04:44,880 --> 00:04:46,390
بئس الأمر

74
00:04:46,390 --> 00:04:49,680
أنت حارس شارع كيسي هذا، أليس كذلك؟
يجب أن ترتقي لهذا الاسم

75
00:04:50,010 --> 00:04:51,180
حارس؟

76
00:04:51,430 --> 00:04:54,850
أجل. هذا شارع الخمر والتّرفيه

77
00:04:55,480 --> 00:04:58,480
لا يسعك سوى خوض معارك ونِزاعات طوال الوقت

78
00:04:58,690 --> 00:05:02,190
حلّ الخِلافات والعمل كحارس شخصيّ
للفتيات اللّواتي يعملنَ هنا

79
00:05:02,650 --> 00:05:07,820
بدأ شباب يعملون في البلدة بنفس
العقليّة يتّحدون معاً تدريجيّاً

80
00:05:02,650 --> 00:05:07,820
شارع كيسي

81
00:05:08,070 --> 00:05:10,370
وشكّلوا ما يُدعى روبّو إتشيزا

82
00:05:10,990 --> 00:05:14,210
فهمت. هذا مُختلف عمّا تخيّلتُه

83
00:05:14,210 --> 00:05:16,040
هذا يُشبه فورين فحسب

84
00:05:16,040 --> 00:05:17,960
لا يختلفون عنّا كثيراً من حيث العمر أيضاً

85
00:05:18,170 --> 00:05:19,590
ماذا؟ -
بجدّية؟ -

86
00:05:19,840 --> 00:05:22,800
لكنّنا مُختلفون قليلاً عن فورين

87
00:05:22,800 --> 00:05:26,090
نستمرّ في مُعالجة تسرُّبات السّطح فحسب

88
00:05:27,720 --> 00:05:33,180
،وبينما نتعامل مع مُثيري الشّغب
ينضمّ إلينا أشخاص بنفس عقليّتنا

89
00:05:33,180 --> 00:05:36,980
بوفورين

90
00:05:33,770 --> 00:05:35,390
...لكن بوفورين

91
00:05:35,390 --> 00:05:41,770
شيّدَ البيت من الصّفر خلال فترة قصيرة فقط
من أجل التخلّص من سطح مليء بالتسرّبات

92
00:05:42,400 --> 00:05:45,780
إنّه رجلٌ حقيقيّ. نفود الصّبر أكثر منّي

93
00:05:45,780 --> 00:05:48,320
أعتقد هذا مُختلف عن "نفاد الصّبر"؟

94
00:05:48,490 --> 00:05:50,410
!مهلاً، توقّف مكانك

95
00:05:50,620 --> 00:05:51,950
!أنت تعي ذلك حقّاً

96
00:05:51,950 --> 00:05:53,790
لماذا تبدو مفتوناً جدّاً؟

97
00:05:54,040 --> 00:05:55,870
!قوّتك الغبيّة تُؤلمني

98
00:05:54,040 --> 00:05:57,620
...لكن مديحاً من رئيس روبّو إتشيزا

99
00:05:55,870 --> 00:05:59,750
ماذا تقصد يا غبيّ؟ -
!قلتُ غبيّ لأنّك غبيّ -

100
00:05:57,620 --> 00:05:59,750
هذا يُسعدنا أيضاً

101
00:06:00,380 --> 00:06:05,260
،على أيّ حال، كلّما كان الفعل أكبر
كانت ردّة الفعل أكبر

102
00:06:05,800 --> 00:06:08,130
!آمل ألّا يحدث أمر خطير في المُستقبل

103
00:06:08,380 --> 00:06:10,930
ماذا قلت؟ هذا ليس من شأنك

104
00:06:11,350 --> 00:06:14,430
قلتُ لك، هذا مُؤلم! هل تعي
كم أصبحت قويّ البُنية؟

105
00:06:14,430 --> 00:06:17,520
ذراعاي أشبه بالمارشميلو، لا ينبغي
!أن تُؤلماك كثيراً

106
00:06:17,520 --> 00:06:19,520
!لا يمكن أن تكون كتلة العضلات هذه مارشميلو

107
00:06:19,770 --> 00:06:22,520
على أيّ حال، لا أعتقد بأنّ هناك ضرورة لذلك

108
00:06:22,940 --> 00:06:25,360
أقصد بأنّ أولئك الأدنى منك يرتقون هكذا

109
00:06:28,610 --> 00:06:32,780
ماذا؟ أنت تنجذب إليهم حقّاً؟ إيّاك
والتّفكير في ترشيح أشخاص جدُد

110
00:06:33,120 --> 00:06:35,700
أجل. إذاً ما رأيكما أنتما التّوأمان بالانضمام لنا؟

111
00:06:35,700 --> 00:06:38,540
رغم أنّ الأصغر قد يُواجه مُشكلة
في مُحاولة خدمة الزّبائن

112
00:06:51,930 --> 00:06:55,180
،كنتُ أقول بأنّ شيزوكا-سان ليست موجودة
لكن ها هي ذي

113
00:06:55,350 --> 00:06:58,390
.يا جماعة، شيزوكا ستُغنّي الآن
لا تُصدِروا ضجيجاً، مفهوم؟

114
00:06:58,390 --> 00:07:00,560
أنت الأكثر ضجيجاً هنا

115
00:07:01,400 --> 00:07:08,990
لا تنفكّ هذه الثّلوج تتساقط

116
00:07:09,490 --> 00:07:15,910
مع ذلك إنّها لا تُسكّن الألم

117
00:07:15,910 --> 00:07:24,920
لكن دفئك بجانبي أشبه بضوء سحريّ

118
00:07:26,090 --> 00:07:33,390
ويُذيب هذا قلبي

119
00:07:35,760 --> 00:07:47,440
بعيد المنال، لكن منحتني مكاني
في ذلك الحلم

120
00:07:49,740 --> 00:08:05,000
تنهمر البرَكة وتفيض بينما تُظهِر
بهجتي نموّها اللّامحدود

121
00:08:04,080 --> 00:08:05,880
مُـ-مُبهر

122
00:08:05,880 --> 00:08:08,300
لديها صوت جميل حقّاً

123
00:08:08,500 --> 00:08:16,680
ينمو الجمال في هذا العالم الّذي تُظهِره
بانسياب لطيف، مُتوهّج دوماً

124
00:08:16,680 --> 00:08:24,400
كلّ يوم أحلم فيه بك يُغذّي مزاجي

125
00:08:24,730 --> 00:08:27,310
أُغنّي لأجلك

126
00:08:28,820 --> 00:08:31,570
أحلام أطاردها

127
00:08:32,530 --> 00:08:38,910
حُبّ حقيقيّ

128
00:08:35,070 --> 00:08:36,700
هذا يبعث على الاسترخاء

129
00:08:36,700 --> 00:08:41,580
بالطّبع. فقد أصبحت المُؤدّية الأُولى
لدينا في غضون ثلاثة أشهر

130
00:08:43,580 --> 00:08:45,750
!كان ذلك رائعاً يا شيزوكا-تشان

131
00:08:47,630 --> 00:08:49,880
ينبغي أن تعودي إلى العمل

132
00:08:52,630 --> 00:08:54,130
!شيزوكا

133
00:08:54,130 --> 00:08:55,510
!تسوباكي-تشان

134
00:08:57,090 --> 00:08:58,510
مهلاً

135
00:08:58,510 --> 00:09:00,510
ماذا حدث هنا؟

136
00:09:00,720 --> 00:09:03,640
لا شيء، تعثّرتُ فحسب

137
00:09:04,020 --> 00:09:06,270
ماذا؟ يجدر بكِ أن تكوني أكثر حذراً

138
00:09:05,310 --> 00:09:06,270
...أنتم

139
00:09:06,560 --> 00:09:09,150
شكراً على التكتّم على ذلك عن تسوباكي

140
00:09:11,280 --> 00:09:12,280
المعذرة

141
00:09:12,280 --> 00:09:16,990
هل يمكنكم التكتّم عن تسوباكي بشأن
الخطر الّذي تعرّضتْ له شيزوكا؟

142
00:09:18,910 --> 00:09:23,790
رُبّما بسبب التّقارب السنّي بينهما، لكن
،شيزوكا تعتبر تسوباكي كأخت كبرى

143
00:09:23,790 --> 00:09:27,210
وتسوباكي يعتني بشيزوكا كأخت صغرى

144
00:09:27,420 --> 00:09:30,130
،لذا إذا عَلِمَ بما حدث

145
00:09:30,130 --> 00:09:32,340
فقد يغضب تسوباكي غضباً
قد يجعل الأرض تهتزّ

146
00:09:32,800 --> 00:09:35,380
هل رأيتُم تسوباكي يوماً وهو غاضب؟

147
00:09:35,840 --> 00:09:37,260
لا بُدّ أنّ ذلك رهيب

148
00:09:37,680 --> 00:09:38,890
،فضلاً عن ذلك

149
00:09:38,890 --> 00:09:43,770
لا يمكننا إقحام فورين في شؤون هذه
البلدة أكثر ممّا فعلنا

150
00:09:47,230 --> 00:09:48,850
!مُصيبة يا كانجي-سان

151
00:09:49,480 --> 00:09:52,360
!شباب لم نرَهم من قبل يُسبّبون أعمال شغب

152
00:09:53,820 --> 00:09:56,070
ماذا؟ ماذا تقصد؟

153
00:09:56,280 --> 00:10:00,780
إنّهم يركلون كلّ شيء في المنطقة
!ويُداهمون الشّارع

154
00:10:01,120 --> 00:10:02,870
ماذا؟ ما الّذي يجري؟

155
00:10:03,330 --> 00:10:07,080
ويبدو أنّهم نفس أولئك الأشخاص

156
00:10:09,330 --> 00:10:10,670
فهمت

157
00:10:10,790 --> 00:10:15,090
أولئك"؟ تقصد الثّمالى الّذين أوقفَتْهم"
مجموعةُ ساكورا؟

158
00:10:15,380 --> 00:10:16,840
يجدر بنا أن نذهب أيضاً

159
00:10:17,340 --> 00:10:20,550
لا، أريدكم أن تبقوا هنا مع شيزوكا

160
00:10:22,140 --> 00:10:25,560
أشكركم على مشاعركم، لكنّنا
نُواجه الكثير منهم

161
00:10:26,060 --> 00:10:28,060
لا أعلم ما الّذي سيحدث هنا أيضاً

162
00:10:28,690 --> 00:10:33,690
أعلم أنّه من غير المنطقيّ أن أطلب هذا
من قائد فريق مُختلف

163
00:10:34,110 --> 00:10:37,070
لكن رغم ذلك، أتوسّل إليك

164
00:10:43,160 --> 00:10:44,660
ساكورا-سان؟

165
00:10:47,370 --> 00:10:51,710
هل يمكنكم البقاء هنا كذلك؟
هذه مُشكلة تخصّ هذه البلدة

166
00:10:51,710 --> 00:10:53,840
،إذا كانوا نفس الأشخاص السّابقين

167
00:10:54,300 --> 00:10:58,010
فمهما كان السّبب، لكمتُ أولئك الأشخاص بالفعل

168
00:10:58,510 --> 00:11:02,010
ما يعني بأنّها مُشكلتي كذلك

169
00:11:02,430 --> 00:11:04,140
...أنتم

170
00:11:04,140 --> 00:11:08,770
لا أعرف ما الّذي تخفونه، لكن إن كنتُم
ستذهبون، فافعلوها بشكل صحيح

171
00:11:09,390 --> 00:11:13,270
واحرصوا أنتم على إعادة طلّاب السّنة
الأُولى الواعدين بأمان إلينا

172
00:11:15,610 --> 00:11:16,780
!أشكرك

173
00:11:17,360 --> 00:11:18,150
!هيّا بنا

174
00:11:18,150 --> 00:11:18,860
!حاضر

175
00:11:22,820 --> 00:11:25,280
شكراً على المجيء معنا إلى هنا

176
00:11:25,490 --> 00:11:28,330
أنتم أشخاص طيّبون حقّاً

177
00:11:28,910 --> 00:11:31,580
قلتُ لك بأنّ هذه المعركة هي مُشكلتي

178
00:11:31,920 --> 00:11:33,630
لا أفعل هذا لأجلكم

179
00:11:34,080 --> 00:11:35,920
ساكورا، صحيح؟

180
00:11:36,380 --> 00:11:39,510
!أنت حقّاً شخص مُحترَم

181
00:11:39,510 --> 00:11:41,180
!كما توقّعتُ من فورين

182
00:11:41,180 --> 00:11:42,680
مـ-مؤلم

183
00:11:42,890 --> 00:11:44,390
،إذا كنّا سنُواجه مجموعة كبيرة

184
00:11:44,390 --> 00:11:47,930
أما كان من الأفضل أن ندع الأخوين
ساكاكي يُساعداننا على الأقلّ؟

185
00:11:47,930 --> 00:11:50,890
سمعتُ أنّ روبّو إتشيزا لا يملكون
عدداً كبيراً من الأعضاء

186
00:11:50,890 --> 00:11:54,150
لا مُشكلة. لا تستهن بروبّو إتشيزا

187
00:11:55,730 --> 00:11:57,110
!رأيتهم! إنّهم هناك

188
00:12:01,070 --> 00:12:04,280
بالفعل، هناك عدد أقلّ منّا مُقارنة بفورين

189
00:12:04,870 --> 00:12:09,580
!قد يكون عددنا قليلاً، لكنّنا النّخبة

190
00:12:15,750 --> 00:12:18,000
!يجب عليّ تطهير هذا من جديد

191
00:12:20,300 --> 00:12:22,840
لماذا أنت خفيف جدّاً؟

192
00:12:23,050 --> 00:12:25,510
!كُلوا جيّداً قبل أن تعودوا

193
00:12:26,350 --> 00:12:27,930
!تنحّوا جانباً، اللّعنة

194
00:12:28,720 --> 00:12:31,770
...دو... مي... صو

195
00:12:32,060 --> 00:12:33,270
لا، تِلك فا

196
00:12:36,110 --> 00:12:38,400
بئساً! لا نهاية لهذا

197
00:12:38,690 --> 00:12:40,320
!آسف لتأخُّري

198
00:12:40,900 --> 00:12:41,900
!كانجي

199
00:12:42,900 --> 00:12:44,320
!أنتم أولئك الأشخاص

200
00:12:44,320 --> 00:12:46,910
أجل! أتوا لمدّ يد العون لنا

201
00:12:47,070 --> 00:12:50,790
،ماذا؟ ظننتُ بأنّ لديكم أشخاص أكثر
لكن أربعة فقط؟

202
00:12:51,910 --> 00:12:54,420
لا يزال هناك الكثير منّا أيضاً

203
00:12:57,250 --> 00:12:59,170
ما مُشكلة هؤلاء؟

204
00:12:59,170 --> 00:13:01,590
لا يُبالون إطلاقاً لزُملائهم الّذين يتساقطون

205
00:13:01,590 --> 00:13:02,920
هذا مُريب

206
00:13:03,090 --> 00:13:06,800
هيّا، بسرعة! سلّموا شيزوكا-تشان

207
00:13:06,800 --> 00:13:10,640
وإلّا سنقلب هذا الشّارع بأكمله
رأساً على عقب، مفهوم؟

208
00:13:11,220 --> 00:13:12,220
مهلاً

209
00:13:12,220 --> 00:13:13,980
كم عددهم؟

210
00:13:19,520 --> 00:13:20,190
!مهلاً

211
00:13:20,190 --> 00:13:23,440
لا مُشكلة. يحدث هذا طوال الوقت

212
00:13:24,110 --> 00:13:27,070
رئيسنا مُتململ جدّاً

213
00:13:27,490 --> 00:13:29,910
ما هذا؟ اندفع شخصٌ واحدٌ بمُفرده فحسب

214
00:13:34,620 --> 00:13:35,830
...سوف

215
00:13:36,830 --> 00:13:38,500
تقلبون الشّارع رأساً على عقب؟

216
00:13:41,210 --> 00:13:44,220
لا ينبغي أن تتفوّهوا بهُراء دون دعمه بأفعال

217
00:13:45,800 --> 00:13:46,840
...هذا الشّعور

218
00:13:47,800 --> 00:13:49,180
راودني من قبل

219
00:13:49,800 --> 00:13:52,930
...مهما كانت المصاعب

220
00:13:53,220 --> 00:13:59,940
!لن أسمح بحدوث شيء كهذا على الإطلاق

221
00:14:34,890 --> 00:14:37,140
!ظهرك مكشوف

222
00:14:44,230 --> 00:14:45,230
مُذهل

223
00:14:45,570 --> 00:14:47,490
أو بالأحرى، عنيف

224
00:14:47,490 --> 00:14:50,110
قوّته وسرعته غير عاديّتين

225
00:14:50,490 --> 00:14:55,660
،إذاً هذا هو رئيس روبّو إتشيزا
!كانجي ناكامورا

226
00:15:02,040 --> 00:15:03,090
!ساكورا

227
00:15:05,670 --> 00:15:07,670
أنقذتني من جديد

228
00:15:07,670 --> 00:15:11,180
أيّاً يكن. كنتَ لتقذف ذلك الشّخص بسهولة

229
00:15:11,470 --> 00:15:14,890
!ولن أدعك تتباهى بمُفردك

230
00:15:15,510 --> 00:15:16,770
!والآن سوف تُواجهني

231
00:15:22,060 --> 00:15:23,860
!سأستعير ظهرك قليلاً

232
00:15:29,070 --> 00:15:31,450
هذا عربون شكر على إنقاذي

233
00:15:37,660 --> 00:15:40,500
!لا تقُم بهُراء لست بحاجة له

234
00:15:41,460 --> 00:15:42,920
ذلك الفتى رهيب حقّاً

235
00:15:43,380 --> 00:15:45,340
إنّه يُجاري كانجي بالتّحديد

236
00:15:45,540 --> 00:15:48,800
بالطّبع. فهو قائد صفّنا

237
00:15:57,100 --> 00:15:59,060
أنت أنيق جدّاً

238
00:15:59,310 --> 00:16:02,100
ما زال الطّريق أمامي طويلاً

239
00:16:02,350 --> 00:16:04,940
لدى فورين مُستقبل مُشرق

240
00:16:06,400 --> 00:16:09,690
رغم ذلك، هل ذلك الفتى بخير؟

241
00:16:10,400 --> 00:16:11,740
لا حاجة للقلق

242
00:16:12,360 --> 00:16:14,950
صحيح أنّه لا يستطيع فعل الكثير حاليّاً

243
00:16:15,530 --> 00:16:20,700
لكن رغبته في أن يصبح أقوى
أعظم من رغبة أيّ شخص

244
00:16:21,500 --> 00:16:24,330
ما الّذي يمكنني فعله؟ فكّر

245
00:16:24,630 --> 00:16:25,880
!فكّر

246
00:16:26,420 --> 00:16:29,800
نيري-كن، تتذكّر ما قلتُه، صحيح؟

247
00:16:29,800 --> 00:16:30,710
أجل

248
00:16:31,050 --> 00:16:34,090
الأهمّ من الفوز هو عدم الهزيمة

249
00:16:34,720 --> 00:16:39,600
لهذا السّبب لا أُشارك في القتال
وأبحث عمّا يمكنني فعله

250
00:16:40,180 --> 00:16:44,730
هذا مُحبط، لكن هذه هي حدودي الآن

251
00:16:45,940 --> 00:16:47,110
أجل

252
00:16:47,730 --> 00:16:50,480
أنا متأكّد أنّه من المُحبط أن تكون
الأشياء الّتي تستطيع فعلها قليلة

253
00:16:50,900 --> 00:16:54,110
لكن من الجيّد أن تنظر إلى نفسك
من ناحية موضوعيّة

254
00:16:54,450 --> 00:16:57,160
لا مُشكلة. ستتمكّن من فعلها
في الوقت المُناسب

255
00:16:57,490 --> 00:17:00,200
فقبل كلّ شيء، من هو مُعلّمك برأيك؟

256
00:17:01,910 --> 00:17:05,420
هل سأصبح كذلك يوماً ما؟

257
00:17:06,460 --> 00:17:08,290
...عـ-على أيّ حال

258
00:17:08,500 --> 00:17:11,710
كان هناك الكثير منهم، لكن من الواضح
أنّ اليد الطّولى كانت لنا

259
00:17:12,050 --> 00:17:13,300
يبعث هذا على التّفاؤل

260
00:17:13,800 --> 00:17:16,260
ما الّذي يجري هنا بالضّبط؟

261
00:17:16,430 --> 00:17:21,390
دخلتُم بأعداد كبيرة، لكن ما زلتُم
عالقين عند المدخل؟

262
00:17:21,640 --> 00:17:25,350
لنعُد ومعنا المومس بسرعة
ونحصل على المال

263
00:17:26,600 --> 00:17:29,860
!حينئذ سنقوم بحفلة مشويّات كما حلِمنا

264
00:17:32,570 --> 00:17:33,940
مهلاً، مهلاً

265
00:17:33,940 --> 00:17:34,950
معقول؟

266
00:17:35,200 --> 00:17:38,200
كم أعدادهم بالضّبط؟

267
00:17:39,830 --> 00:17:42,450
شباب ببدلة رسميّة يُعيقون التقدُّم

268
00:17:42,450 --> 00:17:45,330
إذاً لا بُدّ أنّكم روبّو إتشيزا الّذين سمعتُ عنهم

269
00:17:45,920 --> 00:17:49,500
يا للهول! سقط كثير من الأشخاص

270
00:17:49,790 --> 00:17:52,460
،ليس لديكم ذلك العدد الكبير من الأشخاص
لذا هذا مُبهر

271
00:17:52,960 --> 00:17:55,970
وماذا يعني؟ هل تصبحون أقوى عندما
ترتدون بدلة رسميّة أو ما شابه؟

272
00:17:57,380 --> 00:17:59,850
تبدون في مثل سنّنا

273
00:18:00,510 --> 00:18:03,390
ربّما سنُصبح أقوى بكثير إذا
ارتدينا بدلات رسميّة أيضاً

274
00:18:03,520 --> 00:18:05,430
فكرة سديدة. لنُجرّب ذلك

275
00:18:05,430 --> 00:18:08,560
هل هناك أماكن تبيع بدلات
رسميّة في هذه البلدة؟

276
00:18:08,560 --> 00:18:10,610
إذاً لنذهب ونسرق بعضاً كما نفعل عادة

277
00:18:09,610 --> 00:18:11,940
ما-ما مُشكلة هؤلاء؟

278
00:18:10,610 --> 00:18:14,530
.إذا جرّبناها ومضينا للخارج، فسوف يُمسكون بنا
فهذه ليست قمصاناً خفيفة

279
00:18:11,940 --> 00:18:14,530
هذا ليس شيئاً يجب التحدُّث عنه
وكأنّه أمر طبيعيّ

280
00:18:14,690 --> 00:18:18,530
،فقط لأنّ الأشخاص السّابقين قد سُحِقوا

281
00:18:18,530 --> 00:18:21,240
جلبتُم عدداً هائلاً من النّاس

282
00:18:21,240 --> 00:18:22,660
إلى أيّ درجة أنتم مُلِحّون؟

283
00:18:22,910 --> 00:18:25,580
السّابقون؟

284
00:18:25,910 --> 00:18:28,670
أولئك الأشخاص غير مُرتبطين بنا. أجل

285
00:18:28,790 --> 00:18:29,960
غير مُرتبطين؟

286
00:18:30,250 --> 00:18:35,210
لأنّهم أفسدوا الأمر، انتقل العمل إلينا

287
00:18:35,630 --> 00:18:39,590
نحن غرافيل. مجموعة من الأشخاص
من حيّ سونابا

288
00:18:40,220 --> 00:18:41,350
!سُرِرتُ بلقائكم

289
00:18:41,510 --> 00:18:44,100
غـ-غرافيل من حيّ سونابا؟

290
00:18:44,520 --> 00:18:46,140
ماذا؟ تعرفهم؟

291
00:18:46,140 --> 00:18:50,350
حـ-حيّ سونابا معروف بكونه منطقة
للخارجين عن القانون

292
00:18:50,350 --> 00:18:53,110
أي مثل فورين في الماضي

293
00:18:53,110 --> 00:18:54,530
لا

294
00:18:54,530 --> 00:18:57,740
ذلك المكان ليس مضطرباً بسبب
العنف والمعارك

295
00:18:57,740 --> 00:19:03,330
تدهورَ اقتصادهم، ممّا أدّى إلى كثير
من السّرقة وجرائم أُخرى

296
00:19:04,120 --> 00:19:07,910
سمعتُ أنّ هناك فريقاً من النّاس
!لا يذهب إلى المدرسة أو العمل

297
00:19:07,910 --> 00:19:12,920
ويوفّرون قوت يومهم كمُرتزقة
أو مُتعاقدين فرعيّين لفِرق أُخرى

298
00:19:13,250 --> 00:19:15,800
وذلك الفريق هو غرافيل

299
00:19:16,340 --> 00:19:19,550
هذا يُفسّر تلك المُحادثة الغريبة

300
00:19:20,050 --> 00:19:23,260
قالوا لنا بأنّهم سيعطوننا مالاً بمُجرّد
إحضار مومس واحدة

301
00:19:23,550 --> 00:19:27,470
،ولأنّ أولئك الأشخاص السّابقين فشلوا
ارتفع السّعر كذلك

302
00:19:27,470 --> 00:19:31,060
بذلك المال، نستطيع جميعنا
أن نأكل بعض المشويّات

303
00:19:31,440 --> 00:19:34,480
لذا سلِّمونا شيزوكا ناريتا، مفهوم؟

304
00:19:37,610 --> 00:19:40,610
فضلاً عن ذلك، لم نأتِ إلى هنا للمُشاجرة

305
00:19:40,910 --> 00:19:42,990
سلّموا تلك الفتاة وسنُغادر

306
00:19:43,530 --> 00:19:46,490
فضلاً عن ذلك، تبدون مُرهَقين

307
00:19:46,990 --> 00:19:48,540
،بهذا الفارق العدديّ

308
00:19:48,540 --> 00:19:51,580
،حتّى لو كنتُم أقوياء جدّاً
لن تتمكّنوا من الفوز

309
00:19:52,250 --> 00:19:54,040
،إن أسرعتُم وسلّمتموها

310
00:19:54,040 --> 00:19:59,220
فليس عليكم إظهار جانبكم المُثير
!للشّفقة، وسيكون الجميع راضين

311
00:20:00,590 --> 00:20:02,890
،لا يُبالي البتّة إذا سقط زملاؤه

312
00:20:03,590 --> 00:20:06,140
ولا نهاية لهم مهما أسقطنا منهم

313
00:20:06,680 --> 00:20:10,140
كيف علينا أن نتغلّب على هذا
الفارق العدديّ؟

314
00:20:10,350 --> 00:20:12,690
لا أُبالي إذا لم أستطع الفوز

315
00:20:13,560 --> 00:20:16,360
أسأتُم الفهم

316
00:20:16,650 --> 00:20:17,860
أسأنا الفهم؟

317
00:20:18,070 --> 00:20:23,320
نحن، روبّو إتشيزا، نريد من الأشخاص في هذه
،البلدة أن يُتقِنوا فنّهم بأمان

318
00:20:23,320 --> 00:20:28,120
ونريد من الأشخاص في هذه البلدة أن يستمتعوا
بالتّرفيه. هذا هو هدفنا

319
00:20:28,290 --> 00:20:32,500
إذا ضمنّا ذلك، فلا يهمّنا إن فزنا أو خسرنا معركة

320
00:20:32,870 --> 00:20:34,880
ماذا؟ عمّاذا يتكلّم؟

321
00:20:35,460 --> 00:20:37,920
!لا جدوى من القتال ما لم تفُز

322
00:20:38,300 --> 00:20:43,510
حتّى لو فشلنا جميعاً، مهما بدونا
...مُثيرين للشّفقة في نهاية المطاف

323
00:20:44,260 --> 00:20:47,510
...إذا كانت البلدة... إذا كانت شيزوكا بخير

324
00:20:48,810 --> 00:20:50,720
!فنحن بخير أيضاً

325
00:20:51,560 --> 00:20:55,100
معركة تخوضها وأنت تعتقد
بأنّك لست مُضطرّاً للفوز

326
00:20:55,480 --> 00:20:57,020
لم أفكّر بهذه الطّريقة من قبل

327
00:20:58,440 --> 00:21:01,110
يُقاتلون لحماية شيء

328
00:21:01,400 --> 00:21:04,410
كانت هناك أشياء أردتُ فعلها في القمّة

329
00:21:05,450 --> 00:21:07,200
...الأشخاص في القمّة

330
00:21:08,410 --> 00:21:10,240
...كلّ فرد منهم

331
00:21:12,160 --> 00:21:14,580
لا، لا أملك فكرة عمّا تتكلّم عنه

332
00:21:14,750 --> 00:21:17,590
،فضلاً عن ذلك، إن فشلتُم جميعاً
فهذا يعني هزيمتكم

333
00:21:17,920 --> 00:21:20,090
سنذهب إلى حيث توجد المومس

334
00:21:20,090 --> 00:21:23,130
لماذا تفترض بأنّ عدداً كبيراً
من النّاس سوف يعبر؟

335
00:21:23,130 --> 00:21:25,220
ماذا لو لم يكن غيرك فقط؟

336
00:21:26,800 --> 00:21:30,310
لديّ حُرّاس شخصيّون مُخيفون هُناك

337
00:21:32,560 --> 00:21:37,480
"بصيغة أُخرى، أنت تختار "القتال
"بدلاً من "الهرب

338
00:21:38,020 --> 00:21:39,900
بالطّبع

339
00:21:40,190 --> 00:21:45,360
حسناً، إن لم تكن هناك معركة زُعماء لكسب
غنائم، فلن أشعر بأنّني شاركتُ في اللّعبة

340
00:21:47,240 --> 00:21:49,330
يا إلهي

341
00:21:50,580 --> 00:21:55,290
أتتعامل مع مُغنّيتنا النّجمة كسلعة؟

342
00:21:57,500 --> 00:22:00,420
مهلاً، اهدأ. لا أُبالي لمثل هذه
—الأمور، لذا أسرع

343
00:22:00,420 --> 00:22:02,420
!كفى أنيناً

344
00:22:02,800 --> 00:22:04,720
من الأفضل أن تُجهّزوا أنفسكم

345
00:22:04,970 --> 00:22:08,220
سنظلّ نتحرّك حتّى لو لم تبقَ سِوى رؤوسنا

346
00:22:08,590 --> 00:22:13,390
سندعكم تندمون على مُحاولة حتّى
!لمس شخص من شارعنا

347
00:22:19,400 --> 00:22:21,980
خطوط جبهة مُشتركة

348
00:23:25,590 --> 00:23:28,260
غناء شيزوكا هو الأفضل حقّاً

349
00:23:28,380 --> 00:23:30,680
ما الأمر يا ساكورا؟ فمك فاغر

350
00:23:30,680 --> 00:23:32,010
!ا-اصمت

351
00:23:32,010 --> 00:23:33,260
لا تقع في غرامها

352
00:23:33,260 --> 00:23:35,930
.لا تقع في غرامي أيضاً
أنا مُخلص لأومي

353
00:23:35,930 --> 00:23:37,640
!لـ-لا تقل كلاماً غبيّاً

354
00:23:37,640 --> 00:23:39,770
أنت ظريف حقّاً يا ساكورا