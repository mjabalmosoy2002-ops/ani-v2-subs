1
00:01:45,510 --> 00:01:46,960
!يا متعهّد الجنائز

2
00:01:46,960 --> 00:01:48,540
أين فاش؟

3
00:01:49,760 --> 00:01:52,430
.لم يعد ذلك من شأني

4
00:01:52,430 --> 00:01:53,190
ماذا؟

5
00:01:55,980 --> 00:01:57,630
.كفاك عبثًا رجاءً

6
00:01:57,630 --> 00:01:58,220
ماذا؟

7
00:01:58,220 --> 00:02:00,530
أين فاش؟

8
00:02:00,530 --> 00:02:02,610
.أخبرتك أنّني لا أعرف

9
00:02:02,610 --> 00:02:05,250
.ربّما يحوّله نايفز إلى مومياء أو ما شابه

10
00:02:09,540 --> 00:02:10,560
ما كان الغرض من ذلك؟

11
00:02:10,560 --> 00:02:12,260
.خاب ظنّي فيك كثيرًا

12
00:02:12,260 --> 00:02:13,690
ماذا؟

13
00:02:15,520 --> 00:02:17,320
من تظنّ نفسها؟

14
00:02:31,470 --> 00:02:33,250
.لا تهلع يا فاش

15
00:02:48,060 --> 00:02:50,630
.لنبدأ الآن

16
00:02:56,420 --> 00:02:58,770
.اكتمل الرّبط الأوّل

17
00:02:58,440 --> 00:03:02,700
فاش

18
00:02:58,440 --> 00:03:02,700
نايفز

19
00:02:58,440 --> 00:03:02,700
بلانت

20
00:02:58,440 --> 00:03:02,700
سير المزامنة

21
00:02:58,770 --> 00:03:03,230
.الإشارات الحيويّة مستقرّة
.يبدو أنّ الرّبط كان ناجحًا

22
00:03:03,230 --> 00:03:08,200
ستُؤتي ثمار بحثي الّذي دام
...مائة عام أُكلها أخيرًا

23
00:03:11,540 --> 00:03:12,630
.توقّف

24
00:03:13,620 --> 00:03:14,670
.أنا جادّة

25
00:03:15,960 --> 00:03:17,780
.لن تُطلقي عليّ

26
00:03:19,740 --> 00:03:22,180
...إنّه زجاج مضادّ للرّصاص. إضافة لذلك

27
00:03:22,180 --> 00:03:25,970
.قطع الرّابط بالقوّة الآن قد يكون قاتلاً

28
00:03:27,900 --> 00:03:29,100
ما الّذي تحاول فعله؟

29
00:03:30,710 --> 00:03:35,130
.البلانت مجرّد أوعية

30
00:03:35,660 --> 00:03:39,520
.يوجد كيانها الحقيقيّ في مكان آخر

31
00:03:39,520 --> 00:03:44,020
.ليس هنا، ولكنّه بُعد مغاير. صعيد أسمى

32
00:03:44,570 --> 00:03:53,540
بُعد أسمى

33
00:03:44,570 --> 00:03:53,540
بلانت

34
00:03:45,400 --> 00:03:51,770
.ذاك هو أصل الطّاقة الّتي نستهلكها من البلانت

35
00:03:48,160 --> 00:03:53,540
حراريّة

36
00:03:49,660 --> 00:03:53,540
مائيّة

37
00:03:50,910 --> 00:03:53,540
كهربائيّة

38
00:03:52,160 --> 00:03:53,540
جاذبيّة

39
00:03:52,470 --> 00:03:57,540
.البلانت مجرّد نوافذ تربط البُعدين معًا

40
00:03:57,540 --> 00:03:59,360
!ما الّذي تريده إذًا؟

41
00:03:59,360 --> 00:04:03,630
لماذا تظنّين أنّ التّوأمين هما الوحيدان
اللّذان لديهما إرادة حرّة؟

42
00:04:04,470 --> 00:04:10,020
فرضيّتي هي أنّ الفارق الأساسيّ
بين البلانت والمستقلّين

43
00:04:10,020 --> 00:04:11,900
.هو وجود الرّوح

44
00:04:12,430 --> 00:04:17,110
.علينا ربط البلانت بالجوهر لمنحها أرواحًا

45
00:04:17,110 --> 00:04:18,630
الجوهر؟

46
00:04:18,630 --> 00:04:21,030
.تجسيد البداية والنّهاية

47
00:04:21,030 --> 00:04:23,400
بُعد أسمى

48
00:04:21,030 --> 00:04:23,400
بلانت

49
00:04:21,030 --> 00:04:23,400
حراريّة

50
00:04:21,030 --> 00:04:23,400
مائيّة

51
00:04:21,030 --> 00:04:23,400
كهربائيّة

52
00:04:21,030 --> 00:04:23,400
جاذبيّة

53
00:04:21,030 --> 00:04:24,920
.مصدر كلّ المادّة والطّاقة

54
00:04:21,030 --> 00:04:29,200
الجوهر

55
00:04:24,110 --> 00:04:29,200
البلانت

56
00:04:24,920 --> 00:04:29,200
.الولوج للجوهر. منح أرواح للبلانت

57
00:04:29,200 --> 00:04:30,910
.هذه هي غايتي

58
00:04:30,910 --> 00:04:35,830
هل تقول... أنّك تنوي جعل كلّ بلانت
على الكوكب مستقلاًّ؟

59
00:04:46,630 --> 00:04:48,040
...هذا المكان

60
00:04:48,890 --> 00:04:52,180
.يراودني الفضول لأنّ هذه هي أوّل ذكرى خطرت لي

61
00:04:53,460 --> 00:04:55,040
ماذا تقصد؟

62
00:04:55,040 --> 00:04:57,660
هل تذكر ما كان عهدي يومها؟

63
00:04:59,610 --> 00:05:03,680
.حقّقت هدفي. وجدت طريقة لتحريرها

64
00:05:04,580 --> 00:05:06,740
.لكنّي أحتاج لمساعدتك للقيام بهذا

65
00:05:06,740 --> 00:05:09,640
.هيّا. لننقذ إخوتنا معًا

66
00:05:11,750 --> 00:05:14,330
تعرف لماذا يسيء البشر للبلانت؟

67
00:05:14,330 --> 00:05:17,010
.لأنّ السُّبل تقطّعت بهم على هذا الكوكب العقيم

68
00:05:17,010 --> 00:05:18,710
!إنّها غلطتنا

69
00:05:19,530 --> 00:05:20,930
.فهمت

70
00:05:22,590 --> 00:05:27,550
!فلتُصلّب إذًا نيابة عن الباحثين الآثمين كما ترغب

71
00:05:33,390 --> 00:05:35,480
فاش

72
00:05:33,390 --> 00:05:35,480
نايفز

73
00:05:33,390 --> 00:05:35,480
بلانت

74
00:05:33,390 --> 00:05:35,480
سير المزامنة

75
00:05:35,480 --> 00:05:39,690
!لن تنجو البشريّة إن صارت كلّ البلانت مستقلّة

76
00:05:40,300 --> 00:05:44,920
.إنّها في خضمّ عمليّة تضحية بطيئة سلفًا

77
00:05:44,920 --> 00:05:48,760
.استقلال البلانت هي الطّريقة الوحيدة لعكس ذلك

78
00:05:49,250 --> 00:05:50,890
.نافذة" فاش مميّزة"

79
00:05:50,890 --> 00:05:55,210
إنّه الوحيد القادر على الأخذ
.من البُعد الأسمى والإرسال إليه

80
00:05:55,210 --> 00:05:58,470
!لن يوافق على شيء كهذا مطلقًا

81
00:05:58,470 --> 00:06:00,540
.لذلك السّبب ستتمّ إعادته صنعه

82
00:06:00,960 --> 00:06:03,020
إعادة صنعه"؟"

83
00:06:05,890 --> 00:06:08,040
.نجح الرّبط الثّاني

84
00:06:08,450 --> 00:06:13,110
بإمكاننا الآن التّدخّل في كلّ البلانت
.باستعمال فاش كنافذة

85
00:06:13,110 --> 00:06:15,100
.هذه نقطة اللاّ عودة

86
00:06:18,520 --> 00:06:20,770
!فاش! تمالك نفسك

87
00:06:21,190 --> 00:06:22,580
!فاش

88
00:06:24,170 --> 00:06:29,290
.بدء الاستيعاب والامتصاص والإيقاظ والتّلاعب بالذّاكرة

89
00:06:29,290 --> 00:06:31,220
التّلاعب بالذّاكرة؟

90
00:06:31,220 --> 00:06:32,450
.نايفز

91
00:06:32,450 --> 00:06:38,000
.يسير كلّ شيء على خير. أنا أتعمّق أكثر الآن

92
00:06:38,630 --> 00:06:41,340
.لن تتعرّف على أيّ شيء قريبًا

93
00:06:41,340 --> 00:06:44,840
...لا أنا ولا العالم

94
00:06:46,710 --> 00:06:48,030
.لا شيء

95
00:06:50,470 --> 00:06:51,800
.أنا مدين لك

96
00:07:00,130 --> 00:07:02,970
يجب الاختيار، صحيح؟

97
00:07:10,300 --> 00:07:12,280
!غادر هذه البلدة

98
00:07:14,700 --> 00:07:17,090
.قلتَ أنّك ستنقذنا

99
00:07:17,090 --> 00:07:18,080
...تونيس

100
00:07:19,130 --> 00:07:21,210
.قلتَ أنّك ستنقذنا

101
00:07:22,060 --> 00:07:23,070
!رولو

102
00:07:30,260 --> 00:07:33,430
تريدنا أن نواصل العيش حتّى إن كان ذلك كوحوش؟

103
00:07:35,010 --> 00:07:40,940
كيف لك أن تكون بهذا التّهوّر؟
.لا يمكنك حتّى الاعتناء بنا

104
00:07:42,030 --> 00:07:44,100
.اقتله. خلّصه من بؤسه

105
00:07:45,690 --> 00:07:47,600
...اقتل

106
00:07:48,340 --> 00:07:49,280
!...اقتل

107
00:07:49,280 --> 00:07:51,070
.لا يا رولو

108
00:07:52,570 --> 00:07:54,160
!هذا يكفي

109
00:08:07,050 --> 00:08:10,210
.لستَ بطلاً مسعاه إنقاذ الجميع

110
00:08:11,190 --> 00:08:16,240
.ما أنت إلاّ جبان لا يطيق رؤية أيّ أحد يموت

111
00:08:19,660 --> 00:08:21,840
أين أنا؟

112
00:08:22,570 --> 00:08:23,690
...يدي

113
00:08:26,090 --> 00:08:30,050
!هذا ليس حقيقيًّا
...إنّه حُلم تريني إيّاه فحسب

114
00:08:30,050 --> 00:08:31,300
!هذا مزيّف

115
00:08:41,830 --> 00:08:44,510
.عليّ الخروج من هنا

116
00:08:50,690 --> 00:08:52,390
.عليّ إيجاد المخرج

117
00:08:57,380 --> 00:09:00,600
.وصلت المزامنة لأربعين في المائة وهي في تزايد

118
00:09:00,600 --> 00:09:03,600
.لن أدعك تهرب يا فاش

119
00:09:26,780 --> 00:09:28,450
...هذا

120
00:09:28,450 --> 00:09:31,330
.صحيح. إنّه السّقوط الكبير

121
00:09:33,670 --> 00:09:37,090
ماذا سيكون ردّ فعلهم عندما يعرفون أنّها غلطتك؟

122
00:09:41,890 --> 00:09:43,670
.لا تقلق

123
00:09:44,560 --> 00:09:49,810
إنّهم مجرّد مخلوقات ضعيفة
.لا يمكنها حتّى العيش لقرن

124
00:09:49,810 --> 00:09:51,270
.انس الآن

125
00:09:51,970 --> 00:09:53,780
.انس واسترخ

126
00:09:59,460 --> 00:10:01,610
من كانا...؟

127
00:10:06,330 --> 00:10:08,570
.وصلت المزامنة لسبعين في المائة

128
00:10:08,040 --> 00:10:11,840
فاش

129
00:10:08,040 --> 00:10:11,840
نايفز

130
00:10:08,040 --> 00:10:11,840
بلانت

131
00:10:08,040 --> 00:10:11,840
سير المزامنة

132
00:10:08,570 --> 00:10:11,840
!سبعون، ثمانون... يا لها من سرعة

133
00:10:20,610 --> 00:10:22,000
ماذا يحدث؟

134
00:10:26,810 --> 00:10:29,570
!إنّ هذه... أشبه بالنّباتات

135
00:10:30,690 --> 00:10:32,940
ما هذا يا نايفز؟

136
00:10:32,940 --> 00:10:34,740
.لا تهلع

137
00:10:54,590 --> 00:10:59,130
!حرّر قواك يا فاش! لنعد بناء العالم

138
00:11:15,980 --> 00:11:18,670
...وصلت المزامنة لتسعين في المائة

139
00:11:18,650 --> 00:11:21,150
فاش

140
00:11:18,650 --> 00:11:21,150
نايفز

141
00:11:18,650 --> 00:11:21,150
بلانت

142
00:11:18,650 --> 00:11:21,150
سير المزامنة

143
00:11:20,140 --> 00:11:22,950
توقّت التّقدّم؟

144
00:11:44,020 --> 00:11:45,220
...تلك المرأة

145
00:11:46,090 --> 00:11:47,220
!ها أنت ذي

146
00:11:49,670 --> 00:11:51,720
!ريم سيفريم

147
00:11:54,790 --> 00:11:56,980
...حبّ البشريّة ضدّ

148
00:11:58,350 --> 00:12:00,300
.حبّ الأخ الصّغير

149
00:12:05,570 --> 00:12:08,550
.سيحدّد هذا مصير العالم

150
00:12:09,950 --> 00:12:12,960
خريطة اتّحاد المدن السّبعة

151
00:12:09,950 --> 00:12:12,960
محيط الرّمال العظيم

152
00:12:09,950 --> 00:12:12,960
جولاي

153
00:12:09,950 --> 00:12:12,960
ميتم هوبلاند

154
00:12:09,950 --> 00:12:12,960
صخرة جينيورا
المحطّة
قرية طاحونة الهواء

155
00:12:14,100 --> 00:12:17,000
.أرى أنّ شهيّتكم مفتوحة
هل أنتم في طريقكم للمنزل؟

156
00:12:17,000 --> 00:12:17,980
.لا

157
00:12:17,980 --> 00:12:19,350
.هكذا إذًا

158
00:12:19,350 --> 00:12:23,550
.ألم تسمع؟ تسلّل الإعصار البشريّ للمدينة

159
00:12:23,550 --> 00:12:25,740
.ماذا؟ مستحيل

160
00:12:25,740 --> 00:12:27,790
.لهذا السّبب نعمل طوال اللّيل

161
00:12:39,730 --> 00:12:40,820
!فاش

162
00:12:41,570 --> 00:12:44,750
!لا تدعهم يسيطرون عليك! استيقظ

163
00:12:47,530 --> 00:12:48,430
زهرة"؟"

164
00:12:48,430 --> 00:12:51,100
.نعم. إنّها زهرة نبات العَيْهون

165
00:12:51,100 --> 00:12:54,340
.كانت هنالك العديد من الزّهور الأخرى على الأرض أيضًا

166
00:12:54,340 --> 00:12:55,950
أيمكن أكلها؟

167
00:12:55,950 --> 00:12:58,240
.أخشى أنّها ليست من النّوع الّذي يُؤكل

168
00:12:58,240 --> 00:13:01,660
إذًا فهي للزّينة، صحيح يا ريم؟

169
00:13:01,660 --> 00:13:03,750
.تمامًا مثل الّتي في غرفة البلانت

170
00:13:05,630 --> 00:13:08,720
.ذلك صحيح يا ناي. لديك انتباه شديد

171
00:13:10,640 --> 00:13:12,930
...من المؤسف أنّها لا تُؤكل

172
00:13:12,930 --> 00:13:15,540
.لا تفكّر إلاّ في الأكل

173
00:13:15,540 --> 00:13:17,850
.آسف لأنّ ذلك هو كلّ ما أجيده

174
00:13:17,850 --> 00:13:19,160
.ذلك ليس ما قلتُه

175
00:13:19,160 --> 00:13:20,140
!لكنّه كان قصدك

176
00:13:20,140 --> 00:13:20,940
ماذا؟

177
00:13:20,940 --> 00:13:23,150
.إنّكما تتشاجران دائمًا

178
00:13:23,150 --> 00:13:26,520
—ناي، كونك الوحيد بقوى خاصّة لا يعني أنّ

179
00:13:26,520 --> 00:13:30,020
نعم، نعم. لا يعني أنّ عليّ التّباهي، صحيح؟

180
00:13:30,020 --> 00:13:34,330
،القوّة الّتي حصلتَ عليها مذهلة
...لكن عليك أن تعدني

181
00:13:34,330 --> 00:13:36,560
—عندما يستيقظ الجميع من النّوم البارد

182
00:13:36,560 --> 00:13:39,090
.لا يجب أن أريها لأيّ أحد سواك

183
00:13:39,090 --> 00:13:41,130
—حتّى إن كنت لا تحتاج

184
00:13:41,130 --> 00:13:43,420
.للتّظاهر بالأكل والشّرب

185
00:13:43,890 --> 00:13:45,260
.أعلم ذلك

186
00:13:47,670 --> 00:13:49,710
.عليك أن تقلقي أكثر حيال فاش

187
00:13:49,710 --> 00:13:52,530
.سيصير مجرّد بشريّ بالفعل على هذا المعدّل

188
00:13:55,930 --> 00:14:00,210
.لا بأس. لا حاجة لتقارن نفسك بأيّ أحد آخر

189
00:14:00,210 --> 00:14:02,500
.أنت هو ما أنت عليه، وذلك كلّ ما عليك أن تكونه

190
00:14:04,280 --> 00:14:06,700
.وأنت أيضًا يا ناي. تعال

191
00:14:08,110 --> 00:14:13,240
.كلاكما عزيز عليّ سواء كانت لديكما قوى أم لا

192
00:14:15,630 --> 00:14:17,160
.أحبّكما

193
00:14:20,560 --> 00:14:23,870
.لا بدّ أنّ هذا عنى شيئًا ما لك أيضًا

194
00:14:23,870 --> 00:14:26,120
أتظنّ ذلك بالفعل؟

195
00:14:47,710 --> 00:14:49,560
.هذا سيّئ يا ناي

196
00:14:49,560 --> 00:14:53,220
.عليك أن تتساءل أيضًا ما الّذي تخفيه ريم

197
00:14:55,240 --> 00:15:02,960
سيدس 05

198
00:14:56,620 --> 00:15:02,960
سرّيّ

199
00:15:02,290 --> 00:15:02,960
تمّ التّحقّق

200
00:15:07,550 --> 00:15:12,760
رمز المشروع نوع-تي

201
00:15:07,550 --> 00:15:14,100
سيدس 05

202
00:15:09,490 --> 00:15:10,640
أنا؟

203
00:15:10,640 --> 00:15:12,000
.وأنا أيضًا

204
00:15:13,180 --> 00:15:14,100
مجمّد

205
00:15:14,460 --> 00:15:16,470
رمز المشروع "نوع-تي"؟

206
00:15:17,050 --> 00:15:21,010
...مستقلّ آخر مثلنا وُلد على هذه السّفينة

207
00:15:21,010 --> 00:15:22,670
.قبل خمسين سنة

208
00:15:22,670 --> 00:15:26,320
يُحتفظ بالسّجلاّت... هنا؟

209
00:15:29,970 --> 00:15:31,340
ما-ماذا؟

210
00:15:32,530 --> 00:15:33,340
ماذا؟

211
00:15:44,500 --> 00:15:45,790
حــيّ

212
00:15:44,500 --> 00:15:45,790
تيسلا
‪‫4 أقدام 4 بوصات

213
00:15:44,500 --> 00:15:45,790
مستقلّون

214
00:15:44,500 --> 00:15:45,790
مجمّد

215
00:15:53,630 --> 00:15:55,290
!ناي! فاش

216
00:15:58,850 --> 00:16:01,900
.أعلم أنّ البشر فعلوا أمورًا فظيعة لها

217
00:16:02,470 --> 00:16:04,290
.أتفهّم لماذا قد تكرههم

218
00:16:04,860 --> 00:16:06,300
...ولكن رغم ذلك

219
00:16:06,300 --> 00:16:08,550
ما زلتَ لا تفهم؟

220
00:16:08,550 --> 00:16:12,340
.ما كان ذلك سوى حبّة رمل واحدة

221
00:16:34,020 --> 00:16:36,940
.يُكرّر البشر نفس المآسي

222
00:16:37,640 --> 00:16:42,250
،لا يوافقون على النّزاع
.ومع ذلك لم يخلُ عصر واحد من الحرب

223
00:16:43,390 --> 00:16:49,400
الكتاب المقدّس

224
00:16:43,920 --> 00:16:45,910
.التّاريخ دليل على ذلك

225
00:16:47,830 --> 00:16:49,410
أتقرأ ذلك ثانية؟

226
00:16:50,630 --> 00:16:52,470
.لا يتعلّم البشر أبدًا

227
00:16:55,450 --> 00:16:57,280
.ذلك ليس صحيحًا

228
00:16:58,990 --> 00:17:00,780
...أخبرتني ريم بهذا

229
00:17:00,780 --> 00:17:05,690
عندما وُلدنا، قطعتْ عهدًا بألاّ تسمح
.بحدوث تلك المأساة ثانية

230
00:17:06,300 --> 00:17:07,610
...لذلك

231
00:17:07,610 --> 00:17:09,420
.لنؤمن بالبشر

232
00:17:19,650 --> 00:17:24,910
.إنّك ضعيف جدًّا للعيش كبلانت بدون أيّ قوى

233
00:17:24,910 --> 00:17:28,850
.لذلك السّبب تتوق لحبّ البشر أكثر من أيّ شيء آخر

234
00:17:28,850 --> 00:17:34,020
احتجتَ لتبتسم وتُظهر سحرك
.وتتصرّف كحيوان أليف وديع

235
00:17:34,930 --> 00:17:40,370
.لن تجد السّعادة أبدًا على هذا الحال
.وجب عليّ حمايتك

236
00:17:40,370 --> 00:17:42,290
.لذلك تسبّبتُ في تحطّم السّفن

237
00:17:44,420 --> 00:17:46,420
إنّها غلطتي؟

238
00:17:46,420 --> 00:17:48,630
.فعلتُ كلّ ذلك من أجلك

239
00:18:07,340 --> 00:18:09,270
...هذه هي! الذّكرى الأخيرة

240
00:18:09,270 --> 00:18:11,400
فاش

241
00:18:09,270 --> 00:18:11,400
نايفز

242
00:18:09,270 --> 00:18:11,400
بلانت

243
00:18:09,270 --> 00:18:11,400
سير المزامنة

244
00:18:09,270 --> 00:18:12,070
.وصلت المزامنة لتسع وتسعين في المائة

245
00:18:12,070 --> 00:18:13,610
!أوقفها رجاءً

246
00:18:13,610 --> 00:18:15,000
!لم يفت الأوان بعد

247
00:18:15,540 --> 00:18:19,500
.بل فات الأوان بالفعل. فات قبل 150 سنة

248
00:18:25,250 --> 00:18:26,420
!فاش

249
00:18:27,940 --> 00:18:29,330
نيران مدفعيّة؟

250
00:18:29,680 --> 00:18:32,340
ظهر كائن ضخم مجهول
!في البرج المركزيّ! نحتاج للدّعم

251
00:18:35,410 --> 00:18:36,840
ما ذلك الشّيء؟

252
00:18:37,790 --> 00:18:39,840
...نحن وشيكون

253
00:18:43,100 --> 00:18:46,850
.كانت تلك المرأة سبب كلّ الارتباك

254
00:18:47,420 --> 00:18:54,320
ما كنتَ تحاول الإيمان به هو الحبّ
.يا فاش، كان مجرّد أعذار

255
00:18:54,990 --> 00:18:57,320
.مجرّد خيالات سخيفة

256
00:19:00,810 --> 00:19:02,950
!كلاّ! ريم

257
00:19:03,380 --> 00:19:05,950
!كلاّ! لا تتركيني

258
00:19:07,850 --> 00:19:09,600
.سأنقذك

259
00:19:23,510 --> 00:19:25,930
فاش

260
00:19:23,510 --> 00:19:25,930
نايفز

261
00:19:23,510 --> 00:19:25,930
بلانت

262
00:19:23,510 --> 00:19:25,930
:سير المزامنة

263
00:19:24,010 --> 00:19:25,930
اكتمل

264
00:19:24,190 --> 00:19:26,530
.وصلت المزامنة لمائة في المائة

265
00:19:26,530 --> 00:19:30,390
.اكتمل التّلاعب بالذّاكرة والاستيعاب

266
00:19:36,300 --> 00:19:38,230
!استعدته أخيرًا

267
00:19:43,930 --> 00:19:46,620
.عيد مولد سعيد يا فاش

268
00:20:02,870 --> 00:20:05,000
.نجح الرّبط الثّالث

269
00:20:05,450 --> 00:20:06,550
...هذا

270
00:20:07,010 --> 00:20:09,050
!المدخل للصّعيد الأسمى

271
00:20:30,620 --> 00:20:33,790
!من المدينة الثّالثة جولاي إلى تحالف المدن

272
00:20:33,790 --> 00:20:35,440
!نطلب مساعدة فوريّة

273
00:20:35,440 --> 00:20:40,800
،ستبخّر سهام من نار المُدن
...وسيطهّر فيضان الأراضي

274
00:20:41,590 --> 00:20:43,820
.اليوم هو معركة هار مچدو

275
00:20:58,360 --> 00:21:03,860
.سأدخل الصّعيد الأسمى وألمس الجوهر مباشرة

276
00:21:04,310 --> 00:21:06,120
.كن حذرًا يا نايفز

277
00:21:09,610 --> 00:21:10,580
...أنت

278
00:21:12,030 --> 00:21:14,250
.كانت رحلة طويلة

279
00:21:15,020 --> 00:21:20,490
.لم يكن مسموحًا لي الموت حتّى يحقّق نايفز رغباته

280
00:21:21,250 --> 00:21:23,440
.لكنّ كلّ هذا سينتهي قريبًا

281
00:21:28,230 --> 00:21:33,390
.هنا ينتهي الجنس البشريّ وإصراره المتعصّب للهيمنة

282
00:21:55,240 --> 00:21:57,460
...نحن المستقلّون

283
00:21:58,010 --> 00:22:03,200
!سنُحدث نظامًا جديدًا لهذا العالم