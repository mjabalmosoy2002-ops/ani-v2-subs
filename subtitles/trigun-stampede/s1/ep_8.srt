1
00:00:03,640 --> 00:00:05,320
.حسنًا، بدت التّصوير

2
00:00:05,320 --> 00:00:09,470
!اليوم هو عيد مولد التّوأمين الأوّل

3
00:00:09,990 --> 00:00:12,180
مرّت سنة سلفًا، أليس كذلك؟

4
00:00:12,180 --> 00:00:14,610
.مرّت كلمح البصر بالفعل

5
00:00:14,610 --> 00:00:16,990
.أعددتِ طعامًا لي ثانية

6
00:00:16,990 --> 00:00:19,550
!هيّا! لنأكل بسرعة

7
00:00:19,550 --> 00:00:22,600
.لستُ بحاجة للأكل مثل فاش

8
00:00:22,600 --> 00:00:24,520
.أنا بلانت أيضًا

9
00:00:25,360 --> 00:00:26,700
.يا لها من خسارة

10
00:00:26,700 --> 00:00:29,470
.لا يهمّ إن كنت ستأكله أم لا

11
00:00:29,470 --> 00:00:32,050
الغاية هنا هي الحرص أنّ الجميع
.سيحصل على حصّة

12
00:00:32,050 --> 00:00:33,820
.إنّها ليست خسارة على الإطلاق

13
00:00:33,820 --> 00:00:35,650
.ريم، ضوء التّسجيل مطفأ

14
00:00:35,650 --> 00:00:36,800
.معك حقّ

15
00:00:36,840 --> 00:00:37,320
!ماذا؟

16
00:00:41,010 --> 00:00:43,060
!أتسخران منّي؟

17
00:00:49,260 --> 00:00:51,260
تشاهدين ذلك ثانية؟

18
00:00:51,260 --> 00:00:53,060
.يا لها من والدة مُحبّة

19
00:00:53,060 --> 00:00:55,030
ألا تدريان؟

20
00:00:55,030 --> 00:00:57,340
...أنا أكثر والدة مُحبّة في الكون

21
00:00:57,340 --> 00:01:00,040
.للتّوأمين الأكثر ظرافة في الكون

22
00:01:01,730 --> 00:01:04,050
.لنُقم حفلة عيد مولد أخرى العام القادم

23
00:01:04,050 --> 00:01:05,520
.غير معقول

24
00:01:05,520 --> 00:01:07,460
.سنفعل ذلك بكلّ تأكيد

25
00:02:55,820 --> 00:02:58,410
ناي؟ أين ذهبت؟

26
00:03:23,970 --> 00:03:27,010
!نجاح باهر! نجحتُ أخيرًا

27
00:03:27,800 --> 00:03:29,990
!لكنّك قتلت حتّى ريم

28
00:03:29,990 --> 00:03:31,520
.لا توبّخني

29
00:03:31,880 --> 00:03:33,740
.أنت متواطئ معي

30
00:03:34,830 --> 00:03:38,530
!أنت من أعطاني شيفرة الدّخول للبرنامج

31
00:03:47,000 --> 00:03:51,670
أليس كذلك يا فاش؟

32
00:04:02,200 --> 00:04:05,940
...عليّ إيجاد ريم... إيجاد سفينتنا

33
00:04:19,470 --> 00:04:22,190
!أنا آسف، أنا آسف، أنا آسف

34
00:04:22,190 --> 00:04:24,570
!لم أتخيّل أبدًا حدوث أيّ شيء من هذا

35
00:04:46,220 --> 00:04:49,270
...أريد لكلّ هذا أن ينتهي

36
00:04:50,950 --> 00:04:53,110
...أريد أن أختفي

37
00:04:56,550 --> 00:04:59,040
!إنّه صبيّ! ما زال على قيد الحياة

38
00:05:05,670 --> 00:05:07,050
...عرفتُ هذا

39
00:05:07,700 --> 00:05:10,530
.لا مجال للخطأ. هذا تفاعُل بلانت

40
00:05:10,530 --> 00:05:12,800
.يبدو بشريًّا في نظري

41
00:05:16,420 --> 00:05:18,060
".مستقلّون"

42
00:05:18,060 --> 00:05:20,470
مستـ... ماذا؟

43
00:05:20,470 --> 00:05:24,800
.تُنسخ البلانت في العادة من خليّة أصليّة

44
00:05:24,800 --> 00:05:27,870
ولكن في حالات نادرة، البلانت
.قادرة على الولادة في الحقيقة

45
00:05:27,870 --> 00:05:31,620
أتحاولين القول أنّ هذا البلانت
.وُلد من بلانت آخر؟ لا يُعقل

46
00:05:31,100 --> 00:05:32,770
بالغ السّرّيّة

47
00:05:33,630 --> 00:05:35,480
ما المخاطر الّتي قد يشكّلها؟

48
00:05:35,480 --> 00:05:39,010
ألا يفترض بنا إلقاؤه في حاوية
كبقيّة البلانت العاديّة الأخرى؟

49
00:05:39,490 --> 00:05:41,950
.لا... لا أظنّ ذلك

50
00:05:41,950 --> 00:05:45,500
لستِ واثقة؟ من أدرى إذًا؟

51
00:05:45,500 --> 00:05:49,700
.أحد الآثمين في دراسات البلانت الجزيئيّة
.أو ربّما كونراد، قائد الفريق

52
00:05:49,700 --> 00:05:52,080
كونراد؟ من السّفينة الخامسة؟

53
00:05:54,750 --> 00:05:56,040
أين أنا؟

54
00:05:56,040 --> 00:05:57,320
!إنّه يتكلّم

55
00:05:57,320 --> 00:05:59,480
.طبيعيّ، فتكوينه الجينيّ بشريّ للغاية

56
00:05:59,480 --> 00:06:01,050
!ذلك ليس ما قصدته

57
00:06:01,050 --> 00:06:02,910
.ماذا قصدتَ إذًا؟ أنت منفعل جدًّا

58
00:06:02,910 --> 00:06:04,760
.تبّا! لا يهمّ

59
00:06:04,760 --> 00:06:09,510
أتتذكّر على متن أيّ سفينة كنت؟

60
00:06:10,120 --> 00:06:11,390
.السّفينة الخامسة

61
00:06:12,610 --> 00:06:16,830
أتدريان ما الّذي حدث للسّفينة؟ لريم؟

62
00:06:19,980 --> 00:06:25,100
الضّابط ريم سيفريم، كانت تؤدّي

63
00:06:19,980 --> 00:06:25,860
ريم سيفريم
ضابط ملاحة السّفينة

64
00:06:25,620 --> 00:06:26,720
هل تعرفها؟

65
00:06:27,700 --> 00:06:30,490
.لقد ربّتنا

66
00:06:30,490 --> 00:06:31,530
ربّتكم؟

67
00:06:31,530 --> 00:06:34,310
هل كان هنالك مستقلّون آخرون؟

68
00:06:35,240 --> 00:06:39,350
.واحد آخر فقط... لكنّه ميت على الأرجح

69
00:06:39,350 --> 00:06:43,080
أي أنّك تخلّيت عن الجميع وهربت وحدك؟

70
00:06:43,080 --> 00:06:44,130
.يا لك من حثالة

71
00:06:44,680 --> 00:06:46,190
!على مهلك يا براد

72
00:06:47,630 --> 00:06:49,450
.إنّه يُخفي شيئًا ما

73
00:06:49,450 --> 00:06:52,350
.أتظنّه مريبًا؟ إنّه مجرّد طفل

74
00:06:52,350 --> 00:06:54,260
.سأذهب للبحث عن السّفينة الخامسة

75
00:06:54,260 --> 00:06:57,180
.مرّت حوالي ثمان ساعات على الاصطدام

76
00:06:57,180 --> 00:06:59,890
.هنالك فرصة ضئيلة لنجاة أيّ أحد

77
00:06:59,890 --> 00:07:04,440
ربّما فعّلوا بلانت الجاذبيّة خاصّتهم
.في آخر لحظة كما فعلنا نحن

78
00:07:08,440 --> 00:07:10,490
لماذا أنقذتموني؟

79
00:07:10,490 --> 00:07:11,200
ماذا؟

80
00:07:11,730 --> 00:07:13,820
.أردت الموت هناك

81
00:07:14,900 --> 00:07:18,270
.نحن هنا لأنّنا محظوظون فحسب

82
00:07:18,270 --> 00:07:22,220
لذلك لا يجب علينا نحن النّاجون التّكلّم
.هكذا حتّى إن كنّا لا نقصد ذلك

83
00:07:29,120 --> 00:07:31,810
.لنفكّر فيما يمكننا فعله بدءًا من الآن

84
00:07:37,470 --> 00:07:38,640
ما اسمك؟

85
00:07:39,060 --> 00:07:40,390
.فاش

86
00:07:40,390 --> 00:07:42,890
.أنا لويدا لايتنر

87
00:07:42,890 --> 00:07:46,870
.انتهى بي المطاف مسؤولة عن السّفينة الثّالثة هذه

88
00:07:48,020 --> 00:07:49,860
هل يمكنني أن أسألك بعض الأسئلة؟

89
00:07:50,710 --> 00:07:54,370
ما الّذي تُنتجه كمولّد؟

90
00:07:54,370 --> 00:07:58,030
الكهرباء؟ مركّبات كيميائيّة؟
أو ربّما أحماض أنيميّة؟

91
00:07:58,030 --> 00:07:59,190
.لا شيء

92
00:07:59,890 --> 00:08:03,250
.لا أستطيع توليد أيّ شيء على عكس البلانت العاديّة

93
00:08:03,710 --> 00:08:09,810
.لم يكن الآخر مثلي
.كلّ ما أفعله هو الأكل والشّرب والنّوم

94
00:08:09,810 --> 00:08:12,960
.صحيح. مثل البشر

95
00:08:13,840 --> 00:08:17,970
أخبرتني أن أفكّر فيما يمكنني
...فعله بدءًا من الآن

96
00:08:17,970 --> 00:08:21,360
.لكنّي لا أستطيع فعل أيّ شيء
.لا شيء على الإطلاق

97
00:08:35,750 --> 00:08:38,660
.اتّصل براد قبل قليل

98
00:08:38,660 --> 00:08:43,120
تمكّن من إنقاذ بعض النّاجين من السّفينة
.الخامسة، لكنّ ريم لم تكن بينهم

99
00:08:43,620 --> 00:08:48,060
.كانت السّفينة مدمّرة، لذلك أنا آسفة
...على الأرجح أنّها

100
00:08:52,190 --> 00:08:56,870
بقيت ريم على متنها حتّى الرّمق الأخير
.محاولة إيقاف الاصطدام

101
00:08:56,870 --> 00:08:58,920
.أخبرَنا النّاجون بذلك

102
00:09:04,600 --> 00:09:07,100
هذا كلّ ما وجدتم من مقتنيات ريم؟

103
00:09:07,100 --> 00:09:10,510
.قضينا أسبوعين في الحطام لإيجاد هذا

104
00:09:10,510 --> 00:09:12,520
.لا أريد سماع أيّ شكاوى

105
00:09:12,520 --> 00:09:15,400
أنا آسفة. هل عثرتم على شيء آخر؟

106
00:09:15,400 --> 00:09:17,370
.استرجعنا الصّندوق الأسود

107
00:09:17,370 --> 00:09:21,580
.لكنّه متضرّر بالكامل
.لستُ واثقًا من إمكانيّة تحليله

108
00:09:21,580 --> 00:09:26,120
.وجدنا هذا أيضًا، لكن لا فائدة منه

109
00:09:26,630 --> 00:09:31,060
،دُمّرت السّفينة الخامسة
...وسفينتها في حالة يُرثى لها

110
00:09:31,060 --> 00:09:32,970
.نحن عالقون

111
00:09:32,970 --> 00:09:36,430
أخبريني، إلى متى ستحتفظين بذلك الفتى؟

112
00:09:38,390 --> 00:09:40,100
ألم يعجبك الطّعام؟

113
00:09:40,540 --> 00:09:44,200
.لن آكله. من الأفضل أن تتوقّفوا عن إحضاره

114
00:09:44,200 --> 00:09:45,390
.هذه مضيعة فحسب

115
00:09:46,750 --> 00:09:50,020
.لا يهمّ إن أكلته أم لا

116
00:09:52,920 --> 00:09:55,360
.عثرنا على هذه في حطام السّفينة الخامسة

117
00:09:58,920 --> 00:10:00,990
.اهتمّت لأمركما بالفعل

118
00:10:02,800 --> 00:10:07,900
آمن بنفسك. لا بدّ من وجود شيء
.لا يستطيع سواك القيام به

119
00:10:12,410 --> 00:10:15,450
...لا أستطيع فعل أيّ شيء

120
00:10:15,930 --> 00:10:18,550
أهذا هو الوحش؟

121
00:10:18,550 --> 00:10:20,290
.انظروا إليه! يا لبشاعته

122
00:10:20,290 --> 00:10:21,970
.اقتلوه فحسب

123
00:10:28,550 --> 00:10:32,560
...كان لقائي بكما مصدر الكثير من الفرح

124
00:11:11,070 --> 00:11:13,530
.لا فائدة من إبقائه على قيد الحياة

125
00:11:13,530 --> 00:11:16,620
.كما قال، إنّه بلانت لا يُولّد أيّ شيء

126
00:11:16,620 --> 00:11:18,760
أتستمعين لي يا لويدا؟

127
00:11:18,760 --> 00:11:21,950
.مهلاً. كدت أنتهي من إعادة بناء هذا

128
00:11:22,300 --> 00:11:23,280
!نجحت

129
00:11:22,360 --> 00:11:23,280
وحدة تسجيل
اكتمل التّحليل

130
00:11:24,220 --> 00:11:26,500
.خطأ خطير في إعدادات المِلاحة

131
00:11:26,500 --> 00:11:28,520
...الوقت المتبقّي حتّى إنعاش النّوم التّبريديّ

132
00:11:28,520 --> 00:11:32,040
...ساعة واحدة؟! لن ينجوا في الوقت المناسب هكذا

133
00:11:32,040 --> 00:11:36,390
!تمّ تغيير بيانات الحَقن؟! من فعل هذا...؟

134
00:11:32,750 --> 00:11:34,250
...مهلاً، هذا

135
00:11:36,390 --> 00:11:41,950
.إصلاح نظام التّحكّم المساريّ يدويًّا
.دافعات السّيطرة في أقصى طاقتها

136
00:11:41,950 --> 00:11:43,050
!بسرعة رجاءً

137
00:11:43,690 --> 00:11:44,980
!إنّه بلانت الكهرباء

138
00:11:47,970 --> 00:11:50,640
الزّهرة... تتفتّح؟

139
00:11:52,370 --> 00:11:55,110
.ما هذا؟ أنظمته الحيويّة في فوضى

140
00:11:55,110 --> 00:11:56,340
ما السّبب؟

141
00:11:56,340 --> 00:11:57,570
.لا أدري

142
00:11:58,260 --> 00:12:03,170
إن قلنا مثلاً أنّ البلانت ليست متناسبة
...مع جوّ هذا الكوكب

143
00:12:03,170 --> 00:12:05,620
فسنموت جميعنا هنا؟

144
00:12:06,830 --> 00:12:09,250
...بعد كلّ ما مررنا به للنّجاة

145
00:12:09,250 --> 00:12:10,810
ألا يوجد ما يمكننا فعله؟

146
00:12:12,070 --> 00:12:14,020
!اسمعوا! تعالوا إلى الزّنزانة

147
00:12:16,920 --> 00:12:18,010
ما الخطب؟

148
00:12:18,010 --> 00:12:19,420
!إنّه الفتى

149
00:12:21,360 --> 00:12:23,760
!أخبريني! هل حدث مكروه للبلانت؟

150
00:12:24,770 --> 00:12:25,970
كيف عرفت؟

151
00:12:25,970 --> 00:12:27,960
.لا بدّ أنّه سمع بالأمر بطريقة ما

152
00:12:28,500 --> 00:12:31,980
أنا آسفة، لكنّنا مشغولون وعليّ
...العودة إلى هناك

153
00:12:31,980 --> 00:12:33,740
!إنّه صوته! أستطيع سماعه

154
00:12:33,740 --> 00:12:36,180
!يطلب البلانت المساعدة

155
00:12:36,180 --> 00:12:38,770
.لا تثقي به. إنّه يفتعل ذلك فقط ليخرج

156
00:12:38,770 --> 00:12:42,230
!دعوني ألتقي بالبلانت! صوته يخفت

157
00:12:42,860 --> 00:12:44,550
!لا بدّ أنّه يكذب

158
00:12:45,320 --> 00:12:47,960
...على هذا المعدّل، سوف

159
00:12:49,220 --> 00:12:50,310
.لويدا

160
00:12:52,010 --> 00:12:54,930
سمعت التّسجيل من قبل، صحيح؟

161
00:12:54,930 --> 00:12:55,810
ماذا؟

162
00:12:55,810 --> 00:12:57,630
...لا أدري من كانت ريم، ولكن

163
00:12:57,630 --> 00:12:58,960
.مهلاً، مهلاً

164
00:12:58,960 --> 00:13:03,010
.لكنّها ضحّت بحياتها محاولة إيقاف اصطدام كبير

165
00:13:03,010 --> 00:13:05,140
.واثقة أنّ لا بأس بهذا

166
00:13:05,140 --> 00:13:06,120
!تمهّلي

167
00:13:06,120 --> 00:13:08,350
!وثقت ريم به. وكذلك أنا

168
00:13:19,250 --> 00:13:22,610
هل تذكران تلك القصّة الّتي أخبرتكما بها من قبل؟

169
00:13:23,100 --> 00:13:27,610
.لدينا جميعًا تذكرة فارغة لا وجهة محدّدة فيها

170
00:13:27,610 --> 00:13:30,910
.وما نضعه فيها يعتمد علينا

171
00:13:31,510 --> 00:13:33,630
،مهما كانت الظُّلمة الّتي قد نجد أنفسنا فيها

172
00:13:33,630 --> 00:13:38,540
ستكون تلك التّذكرة بانتظارنا دائمًا
.لنكتب عليها وجهتنا الّتي نريد

173
00:13:38,870 --> 00:13:44,010
.ناي، فاش... ستكونان بخير

174
00:13:51,820 --> 00:13:55,110
.أستطيع سماعك. لا تقلق

175
00:14:10,990 --> 00:14:13,310
.أنا هنا

176
00:14:15,000 --> 00:14:18,000
خريطة اتّحاد المدن السّبعة

177
00:14:15,000 --> 00:14:18,000
محيط الرّمال العظيم

178
00:14:15,000 --> 00:14:18,000
جولاي

179
00:14:15,000 --> 00:14:18,000
ميتم هوبلاند

180
00:14:15,000 --> 00:14:18,000
صخرة جينيورا
المحطّة
قرية طاحونة الهواء

181
00:14:23,460 --> 00:14:27,050
.شكرًا لك يا فاش. أنقذت أرواحًا عدّة اليوم

182
00:14:27,050 --> 00:14:30,710
.كان ذلك لا شيء. فعلتُ ما أستطيعه فحسب

183
00:14:38,120 --> 00:14:39,220
.تعال معي

184
00:14:45,730 --> 00:14:46,860
ما هذه؟

185
00:14:46,860 --> 00:14:48,540
!غرفتك

186
00:14:48,540 --> 00:14:52,580
.بدءًا من اليوم، صرتَ قاطنًا رسميًّا للسّفينة الثّالثة

187
00:14:53,150 --> 00:14:57,160
.آسفة على طريقة معاملتنا لك من قبل

188
00:15:04,920 --> 00:15:06,420
!شكرًا لك يا لويدا

189
00:15:06,420 --> 00:15:11,660
اشكر براد أيضًا. ما كنتُ لأستطيع
.إقناع الجميع وحدي

190
00:15:11,660 --> 00:15:12,890
براد؟

191
00:15:12,890 --> 00:15:14,920
.قلتُ لك ألاّ تخبريه

192
00:15:15,430 --> 00:15:17,250
.إنّه ألطف ممّا يبدو عليه

193
00:15:19,170 --> 00:15:22,010
.بدل الأصفاد، سيراقبك حارس بدءًا من الآن

194
00:15:22,010 --> 00:15:23,510
.تحمّل هذا الوضع لبعض الوقت

195
00:15:23,510 --> 00:15:25,750
.لن نحتاج لذلك قريبًا أيضًا

196
00:15:25,750 --> 00:15:29,200
.من يدري؟ ما زلتُ لا أثق به

197
00:15:29,200 --> 00:15:31,520
.سألقّنك درسًا إن قمت بحركة واحدة خاطئة

198
00:15:31,520 --> 00:15:32,790
.نعم، نعم

199
00:15:33,820 --> 00:15:38,580
...صحيح يا فاش، بشأن ما سنفعله بدءًا من الآن

200
00:15:39,680 --> 00:15:42,790
هلاّ ألقيت نظرة على البلانت الأخرى أيضًا؟

201
00:16:29,840 --> 00:16:31,720
هل أنت متعب؟

202
00:16:31,720 --> 00:16:32,760
.نوعًا ما

203
00:16:32,760 --> 00:16:35,410
.هذه رحلتنا الخامسة هذه السّنة

204
00:16:35,410 --> 00:16:38,220
.شكرًا على قدومك أيضًا يا براد

205
00:16:38,220 --> 00:16:43,020
.أخبرتك أنّ مهمّتي تقتضي أن أراقبك لا غير

206
00:16:44,070 --> 00:16:47,980
إضافة لذلك، هذا أشبه بالنّعيم
.مقارنة بالوضع بعد الاصطدام

207
00:16:54,780 --> 00:16:57,520
.اشرب. الطّريق طويل أمامنا

208
00:17:00,370 --> 00:17:01,970
.أنت رجل طيّب يا براد

209
00:17:02,490 --> 00:17:03,660
.رغم أنّك تبدو مخيفًا

210
00:17:03,660 --> 00:17:04,470
.أعد القنّينة

211
00:17:04,470 --> 00:17:05,960
!مستحيل

212
00:17:05,960 --> 00:17:07,310
...أيّها الـ

213
00:17:07,310 --> 00:17:08,330
.يا إلهي

214
00:17:11,190 --> 00:17:12,200
.فاش

215
00:17:13,220 --> 00:17:14,010
ماذا هنالك؟

216
00:17:17,430 --> 00:17:18,960
!انظر

217
00:17:18,960 --> 00:17:22,430
!هذا من أجلك يا فاش
!إنّه من الجميع في السّفينة الثّالثة

218
00:17:22,430 --> 00:17:27,430
!مذهل، إنّه جديد تمامًا
!من الصّعب الحصول على الملابس

219
00:17:30,270 --> 00:17:32,470
.يا له من لون أحمر جميل

220
00:17:32,470 --> 00:17:34,050
أيجلب الأنظار كثيرًا؟

221
00:17:34,050 --> 00:17:38,110
.لا، أحبّ اللّون الأحمر. وكذلك كانت ريم

222
00:17:38,110 --> 00:17:40,950
.ربّت الكثير من نبات العَيْهون

223
00:17:40,950 --> 00:17:42,460
العَيْهون؟

224
00:17:42,460 --> 00:17:43,080
.نعم

225
00:17:44,730 --> 00:17:48,160
.شكرًا لك. أنا مسرور جدًّا لأنّني أعيش معكم جميعًا

226
00:17:48,160 --> 00:17:49,910
.هذا هو منزلي

227
00:17:49,910 --> 00:17:53,630
!منزلك؟ أحببتُ هذا

228
00:17:53,630 --> 00:17:58,140
كنتُ أفكّر لبعض الوقت
.أنّ "السّفينة الثّالثة" اسم باهت

229
00:17:58,140 --> 00:18:01,180
!لذلك بدءًا من اليوم، سنسمّيها المنزل

230
00:18:03,350 --> 00:18:06,040
.منزلك ومنزلنا

231
00:18:13,820 --> 00:18:15,730
.ما زال كبيرًا عليّ بعض الشّيء

232
00:18:17,450 --> 00:18:19,460
...المنزل

233
00:18:25,460 --> 00:18:28,990
.علاقتك بفاش أفضل بكثير ممّا توقّعت

234
00:18:28,990 --> 00:18:33,310
ليس تمامًا. أنا أحرص فقط
.على ألاّ يفعل أيّ شيء سيّئ

235
00:18:33,310 --> 00:18:35,230
.لا تستطيع قول الصّراحة فحسب

236
00:18:36,060 --> 00:18:40,470
.ذلك... الصّندوق الأسود. ظننتك لم تستطع إصلاحه

237
00:18:40,470 --> 00:18:44,480
.ليس وقتها. لكن مرّت خمس سنوات وقد تغيّرت الأمور

238
00:18:44,480 --> 00:18:46,320
...التّكنولوجيا ومهاراتي

239
00:18:46,780 --> 00:18:49,110
ما زال الكثير من النّاس يلومون أنفسهم

240
00:18:49,110 --> 00:18:52,120
.لأنّنا لا نعرف ما الّذي تسبّب بالاصطدام

241
00:18:55,510 --> 00:18:56,580
!نجحت

242
00:19:00,360 --> 00:19:02,320
...أهذا

243
00:19:04,570 --> 00:19:07,330
!نجاح باهر! نجحتُ أخيرًا

244
00:19:07,330 --> 00:19:09,470
!لكنّك قتلت حتّى ريم

245
00:19:10,060 --> 00:19:12,040
.لا توبّخني

246
00:19:12,040 --> 00:19:14,070
.أنت متواطئ معي

247
00:19:14,950 --> 00:19:18,340
!أنت من أعطاني شيفرة الدّخول للبرنامج

248
00:19:18,340 --> 00:19:20,460
من ذاك مع فاش؟

249
00:19:20,460 --> 00:19:24,900
.لا بدّ أنّه مستقبلّ آخر. لم يمت في الاصطدام إذًا

250
00:19:24,900 --> 00:19:26,490
لماذا قد يكذب بشأن ذلك؟

251
00:19:26,490 --> 00:19:28,850
!واضح تمامًا لأنّهما يعملان معًا

252
00:19:28,850 --> 00:19:33,020
!لم يكن إلى جانب البشر على الإطلاق

253
00:19:33,480 --> 00:19:35,980
!كان يخوننا طوال هذا الوقت

254
00:19:52,260 --> 00:19:54,290
.لقد سمعَنا

255
00:19:54,290 --> 00:19:58,210
.لا بدّ من دليل هنا حول المستقلّ الآخر

256
00:20:06,590 --> 00:20:07,610
أوجدت شيئًا ما؟

257
00:20:11,460 --> 00:20:16,710
.بفضل الجميع، تمكّنت من الوقوف على قدميّ ثانية

258
00:20:17,580 --> 00:20:20,760
،أعتبركم جميعًا عائلة لي

259
00:20:21,820 --> 00:20:25,120
.لذلك لم أستطع مواصلة الكذب

260
00:20:25,870 --> 00:20:27,120
.أنا جدّ آسف

261
00:20:29,120 --> 00:20:33,110
،لا يهمّ كم سترغبون في نسيان الماضي
.فلا مهرب منه أبدًا

262
00:20:34,330 --> 00:20:36,890
حان الوقت لأواجه

263
00:20:38,380 --> 00:20:42,760
حقيقة أنّ على مستقلّ التّكفير
.عمّا اقترفه مستقلّ آخر

264
00:20:43,510 --> 00:20:46,440
".هذه هي كفّارتي"

265
00:20:47,660 --> 00:20:49,140
.علينا الذّهاب خلفه

266
00:20:49,850 --> 00:20:50,830
.لا توقفني

267
00:20:50,830 --> 00:20:52,360
.لن أفعل

268
00:20:52,360 --> 00:20:56,150
.عندما ترين فاش، اعتذري له نيابة عنّي
.تفوّهتُ بكلمات فظيعة

269
00:20:58,260 --> 00:21:01,780
!أخبره بنفسك لأنّني سأعيده معي

270
00:21:32,860 --> 00:21:34,100
...المنزل

271
00:21:35,540 --> 00:21:37,500
هل أنقذوني؟

272
00:22:16,660 --> 00:22:17,840
...ناي