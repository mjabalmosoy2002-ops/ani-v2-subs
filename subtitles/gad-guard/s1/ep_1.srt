00:17:59,680 --> 00:18:01,340
.خبئيه

211
00:18:01,340 --> 00:18:04,800
.ولكنني لن أراه ثانية أبدًا

212
00:18:19,150 --> 00:18:21,230
!اللعنة. كاتانا

213
00:18:22,440 --> 00:18:23,810
!إنه دوري

214
00:18:23,810 --> 00:18:24,730
!سأضربك بسوطي

215
00:18:39,350 --> 00:18:40,600
ما هذا؟

216
00:18:40,600 --> 00:18:41,850
روبوت؟

217
00:18:41,850 --> 00:18:43,130
!هاجيكي

218
00:18:44,640 --> 00:18:46,340
ما الخطب؟

219
00:18:46,850 --> 00:18:48,350
ماذا تفعلين؟

220
00:18:48,350 --> 00:18:49,600
!اذهبي إلى الداخل

221
00:18:49,600 --> 00:18:50,850
.يجب أن نتصل بالشرطة

222
00:18:51,470 --> 00:18:53,270
.لن تأتي الشرطة

223
00:18:53,270 --> 00:18:54,220
...لكن

224
00:19:05,470 --> 00:19:08,070
.سأذهب إلى البيت لأنام
.افعلي نفس الشيء

225
00:19:13,390 --> 00:19:14,040
...مهلًا، هذا

226
00:19:15,310 --> 00:19:16,870
!أعيديه لي

227
00:19:19,020 --> 00:19:20,080
!الفتى الظريف

228
00:19:33,600 --> 00:19:35,140
لماذا؟

229
00:19:35,140 --> 00:19:38,810
لماذا أصبحت مهووسًا بهذا الشيء؟

230
00:19:38,810 --> 00:19:39,560
.ضعه أرضًا

231
00:19:40,390 --> 00:19:42,440
.ضعه أرضًا هناك

232
00:20:09,930 --> 00:20:12,020
هل سينفجر؟

233
00:20:43,420 --> 00:20:44,350
ما هذا؟

234
00:20:50,600 --> 00:20:52,010
هل وُلد؟

235
00:21:34,350 --> 00:21:36,510
أهذا أيضًا روبوت؟

236
00:21:44,270 --> 00:21:46,600
!تـ-توقف