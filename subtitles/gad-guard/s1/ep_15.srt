.ليس لدينا الكثير هنا، ولكننا نرحب بكما

215
00:14:48,480 --> 00:14:50,310
.أقدر مساعدتك

216
00:14:50,310 --> 00:14:54,310
نحن ممتنان على الطعام
.الذي قدمته لنا أيضًا

217
00:14:59,640 --> 00:15:03,010
أتساءل متى سيعود ذلك المدعو كاتانا؟

218
00:15:03,010 --> 00:15:04,120
.لا أدري

219
00:15:04,390 --> 00:15:09,010
ألا تعتقد أن المبلغ الذي قدمه
موتشي لنا ليس كافيًا؟

220
00:15:09,010 --> 00:15:11,080
.إذا لم يعجبك فانسحب

221
00:15:13,470 --> 00:15:17,090
.أريد فقط القضاء على جميع الغادريان

222
00:15:17,090 --> 00:15:19,010
.أعلم ذلك

223
00:15:19,010 --> 00:15:21,160
.أنت تنتقم لشقيقك الأصغر

224
00:15:24,390 --> 00:15:26,020
...أخبرني يا رفيقي

225
00:15:28,010 --> 00:15:31,190
هل كان شقيقك الذي لم يهرب يشبهني؟

226
00:15:36,430 --> 00:15:38,760
.على الإطلاق

227
00:15:51,390 --> 00:15:54,840
.أتوا إلينا ووفروا علينا المشقة

228
00:16:02,760 --> 00:16:06,180
.روبوتات التيكود ليست كما تعتقد

229
00:16:06,680 --> 00:16:09,680
حسنًا، إذًا ماذا تكون؟

230
00:16:09,680 --> 00:16:10,600
ومن أين أتت؟

231
00:16:11,390 --> 00:16:12,350
...لا أعلم

232
00:16:12,720 --> 00:16:15,520
!أنت معمي بروبوتك التيكود العزيز

233
00:16:16,890 --> 00:16:18,440
!أنت مخطئ

234
00:16:20,400 --> 00:16:22,530
!إيسا--
!حاضر--

235
00:16:35,040 --> 00:16:36,640
!برق

236
00:16:38,060 --> 00:16:39,550
!هاجيكي

237
00:16:40,180 --> 00:16:41,760
!برق، تعال

238
00:16:45,260 --> 00:16:48,010
هذا جهاز قطع بالليزر
!يستخدمونه في المصانع

239
00:16:48,010 --> 00:16:50,640
!قمنا بتعديله، لذا فإنه سيقطع أي شيء

240
00:16:51,010 --> 00:16:53,640
ألست تبالغين قليلًا؟

241
00:16:53,640 --> 00:16:55,810
أنت من طلب مني هذا، أتذكر؟

242
00:16:57,600 --> 00:16:58,520
!برق

243
00:17:04,970 --> 00:17:06,910
.يا له من روبوت رائع لديك

244
00:17:07,220 --> 00:17:09,510
!غادر هذه الوحدة

245
00:17:09,510 --> 00:17:12,540
!هذه التيكودات لن تدمر الوحدة

246
00:17:14,010 --> 00:17:17,930
.ما تقوله وما تحمله لا يتطابقان

247
00:17:17,930 --> 00:17:20,960
سأدمر ذلك الغادريان
!سواء أعجبك ذلك أم لا

248
00:17:28,890 --> 00:17:30,230
!توقف يا برق

249
00:17:45,100 --> 00:17:47,180
أرأيت؟

250
00:17:47,180 --> 00:17:49,090
.إنه يرغب في القتال

251
00:17:51,080 --> 00:17:53,450
.وستفقد سيطرتك عليه أكثر بمرور الوقت

252
00:17:54,060 --> 00:17:55,160
!أنت مخطئ

253
00:17:55,430 --> 00:18:00,010
إذا كان ذلك صحيحًا فهل تقول
بأنك لم تستخدمه للقتال من قبل؟

254
00:18:00,010 --> 00:18:01,350
لقد فعلت، أليس كذلك؟

255
00:18:01,350 --> 00:18:02,300
!كانت صدفة

256
00:18:03,100 --> 00:18:06,350
!وُلد برق من أعماق قلبي

257
00:18:06,350 --> 00:18:08,430
!من المستحيل أن يفعل شيئًا كهذا

258
00:18:09,640 --> 00:18:12,180
...ولد لأنه أراد أن يكون

259
00:18:12,180 --> 00:18:13,430
.ويتحرك كما يشاء

260
00:18:14,010 --> 00:18:16,940
!إنه يتوق الآن للقتال

261
00:18:16,940 --> 00:18:19,810
!بـ-يل أنت من يتوق للقتال

262
00:18:22,510 --> 00:18:24,320
!كف عن هذا وعد إلى رشدك

263
00:18:31,510 --> 00:18:33,200
.سأتخلص منه هنا وفي الحال

264
00:18:36,220 --> 00:18:37,160
!تبا

265
00:18:47,050 --> 00:18:48,970
هـ-هل حماه؟

266
00:18:48,970 --> 00:18:50,220
...مستحيل

267
00:18:50,220 --> 00:18:52,390
...لا يرغب الغادريان سوى في القتال

268
00:18:52,390 --> 00:18:53,760
.أنت مخطئ

269
00:18:54,390 --> 00:18:57,020
.هذا ميسا شميت

270
00:18:57,020 --> 00:19:00,220
.ميسا صديقي

271
00:19:00,220 --> 00:19:03,510
.منحني القدرة على التحليق

272
00:19:03,510 --> 00:19:04,940
.ألق التحية على الرجل

273
00:19:07,030 --> 00:19:10,410
...الغادريان وحوش

274
00:19:11,850 --> 00:19:14,340
...قتلوا شقيقي الأصغر

275
00:19:16,100 --> 00:19:19,210
هل أنت أيضًا تعرضت للخداع
لتعتقد بأنه صديقك؟

276
00:19:19,210 --> 00:19:22,960
...لا أفهم

277
00:19:23,640 --> 00:19:27,470
.كيف وصل برق إلى هنا

278
00:19:27,470 --> 00:19:29,780
.لا أعرف ما يعنيه لي

279
00:19:37,310 --> 00:19:39,810
!إنه وحش

280
00:19:39,810 --> 00:19:41,900
!أنت مخطئ--
!تحرك--

281
00:19:42,180 --> 00:19:44,180
!إنه يتوق للقتال

282
00:19:53,640 --> 00:19:55,490
...برق

283
00:19:55,490 --> 00:19:56,870
!تحرك

284
00:19:56,870 --> 00:19:58,160
!هاجيكي

285
00:19:59,060 --> 00:20:00,000
...أرجوك

286
00:20:00,640 --> 00:20:02,640
!برق

287
00:20:21,810 --> 00:20:22,980
.ذلك الغبي

288
00:20:25,890 --> 00:20:27,010
...برق

289
00:20:28,390 --> 00:20:29,440
!هو حلمي

290
00:20:30,470 --> 00:20:31,860
!ليس وحشًا

291
00:20:33,260 --> 00:20:34,350
!يا رفيقي

292
00:20:34,350 --> 00:20:37,180
!ما خطبك؟ اقض عليه

293
00:20:37,180 --> 00:20:38,510
!يا رفيقي

294
00:20:48,970 --> 00:20:52,260
.عرفتها منذ البداية

295
00:20:54,100 --> 00:20:57,920
كنت أعلم أن شقيقي
.هو من اكتشف الغاد

296
00:20:59,180 --> 00:21:01,310
...و

297
00:21:01,310 --> 00:21:04,010
...كنت أعلم أن قلبه قد انجذب إلى الغاد

298
00:21:04,010 --> 00:21:05,210
.الغادريان

299
00:21:06,850 --> 00:21:08,150
...كنت أعرف ذلك

300
00:21:09,510 --> 00:21:13,050
.لكنني رفضت تصديق ذلك

301
00:21:17,510 --> 00:21:20,510
.لهذا السبب إذًا تسأل عن الغاد

302
00:21:21,890 --> 00:21:26,040
على أي حال، نحن نجوب
.الأرجاء لفهم الغاد أكثر

303
00:21:26,930 --> 00:21:31,380
.كل ما أعرفه عن الغاد هو إشاعة

304
00:21:31,930 --> 00:21:35,630
بالمناسبة، أكانت تلك
آخر مرة ترين فيها رفيقك؟

305
00:21:37,390 --> 00:21:38,550
.شكرًا على المشروب

306
00:21:44,430 --> 00:21:46,810
.لم أحصل على كثير من المعلومات منه

307
00:21:46,810 --> 00:21:49,810
كل هذا الوقت الذي قضيته
.هناك كان بدون جدوى

308
00:21:51,470 --> 00:21:54,510
.كنت أتحدث عن الماضي

309
00:21:56,600 --> 00:21:58,260
.يا لها من مضيعة للوقت

310
00:21:59,850 --> 00:22:04,720
.قررنا عندها عدم العبث مع الغاد بعد ذلك

311
00:22:04,720 --> 00:22:07,060
أتساءل لماذا نقوم بهذا إذًا؟

312
00:22:07,060 --> 00:22:08,930
.أنت تعرف لماذا

313
00:22:08,930 --> 00:22:13,560
.لأننا نحن المهووسون بالغاد