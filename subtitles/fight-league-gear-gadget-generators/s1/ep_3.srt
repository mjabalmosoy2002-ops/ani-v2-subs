1
00:01:05,910 --> 00:01:09,920
إنّه يوم آخر من المعارك المُتّقِدة
!"من كأس "جي جي جي

2
00:01:09,920 --> 00:01:11,730
،مقابلة البطل" اليوم مع بيرز"

3
00:01:11,730 --> 00:01:14,480
!مُقاتلة تحظى بكثير من الشّعبيّة هذه الأيّام

4
00:01:14,480 --> 00:01:15,420
!مرحبًا

5
00:01:15,870 --> 00:01:18,290
!حالف النّصر "كيو إي دي" اليوم مجدّدًا

6
00:01:18,290 --> 00:01:20,740
ما السّرّ وراء سلسلة انتصاراتكم؟

7
00:01:20,740 --> 00:01:23,270
!لا أحد يبالي بذلك

8
00:01:24,700 --> 00:01:28,730
،رينتش، في مباراتنا المُقبِلة
!سأكون أوّل من يدخل

9
00:01:28,730 --> 00:01:30,650
!لنفعلها بملء طاقتنا، أنا وأنتِ

10
00:01:30,650 --> 00:01:33,260
!لا تمسكي بالكاميرا من فضلكِ

11
00:01:31,040 --> 00:01:32,700
!إيّاكِ والهرب

12
00:01:34,060 --> 00:01:36,740
!ما فريق الّذي يُعلن عن مقاتله الأوّل؟

13
00:01:37,130 --> 00:01:38,610
.هذا طبعها

14
00:01:40,250 --> 00:01:42,760
أنت، أنتِ! من كانت؟

15
00:01:42,760 --> 00:01:44,690
.اسمها بيرز

16
00:01:44,690 --> 00:01:46,830
.إنّها صديقة طفولة رينتش

17
00:01:46,830 --> 00:01:48,500
صديقة طفولة؟

18
00:01:49,330 --> 00:01:50,310
!مستحيل

19
00:01:50,310 --> 00:01:52,880
.مُحال أن أعتبر هذه صداقة

20
00:01:53,150 --> 00:01:55,340
.أنتما تشتبكان معًا فقط لأنّكما متشابهتان

21
00:01:55,340 --> 00:01:57,090
!لسنا كذلك

22
00:01:57,670 --> 00:01:58,510
.آسفة على التّأخّر

23
00:01:59,130 --> 00:02:00,340
من أنتِ؟

24
00:02:01,190 --> 00:02:03,650
.أنا كبيرة المستقبلات مالتي آي

25
00:02:04,380 --> 00:02:07,980
.سنبدأ الآن بتسجيل اسم مونا كروم كمُقاتِلة

26
00:02:07,980 --> 00:02:09,200
.تعالي معي

27
00:02:10,630 --> 00:02:12,370
!قادمة

28
00:02:12,610 --> 00:02:14,260
!انتظري يا كروم

29
00:02:16,180 --> 00:02:18,070
.تمّت العمليّة بنجاح

30
00:02:18,380 --> 00:02:22,490
.تمّ تسجيل مونا كروم كمقاتلة في بولتيكس

31
00:02:23,610 --> 00:02:25,580
أليس هذا رائع يا كروم؟

32
00:02:25,580 --> 00:02:26,410
!نعم

33
00:02:26,910 --> 00:02:29,670
تستطيع أداتكِ استخدام طلقة انفجاريةّ قتاليّة

34
00:02:29,670 --> 00:02:31,040
.اعتني بها

35
00:02:31,040 --> 00:02:32,380
!مرحى

36
00:02:32,380 --> 00:02:34,550
!أنتِ مذهلة يا كروم

37
00:02:34,950 --> 00:02:37,330
ماذا يعني طلقة انفشاريّة قتاليّة؟

38
00:02:38,580 --> 00:02:40,110
!طلقة انفجاريّة قتاليّة

39
00:02:40,110 --> 00:02:42,680
إنّها حركة فائقة يستطيع قادة
.الفرق استخدامها

40
00:02:42,830 --> 00:02:44,930
!حظي فريقُنا بواحدة أخيرًا

41
00:02:47,320 --> 00:02:49,890
!حسنًا! هيّا نتدرّب

42
00:02:50,250 --> 00:02:52,100
!نعم

43
00:02:52,320 --> 00:02:54,670
!شكرًا جزيلاً لك

44
00:02:54,670 --> 00:02:57,180
!هيّا، لنتمرّن

45
00:02:59,440 --> 00:03:00,630
.كم هذا مشبوه

46
00:03:05,380 --> 00:03:07,370
!أنا متعبة للغاية

47
00:03:10,940 --> 00:03:11,750
.صحيح

48
00:03:11,750 --> 00:03:13,130
.كانت مفاجأة

49
00:03:13,560 --> 00:03:14,770
!ماذا؟

50
00:03:15,130 --> 00:03:17,840
لا تعلمين حتّى كيف تستخدمين
طلقة انفجاريّة قتاليّة؟

51
00:03:18,130 --> 00:03:19,180
!لا

52
00:03:19,180 --> 00:03:20,920
لكن... لماذا؟

53
00:03:21,490 --> 00:03:22,990
حركة فائقة؟

54
00:03:23,450 --> 00:03:26,320
.هذه حركة غونبار فائقة

55
00:03:26,320 --> 00:03:27,970
!إذًا لا أعلم

56
00:03:28,410 --> 00:03:30,880
!كيف لا تعلمين؟ إنّها أداتكِ

57
00:03:30,880 --> 00:03:32,760
!لا أعلم

58
00:03:33,420 --> 00:03:35,400
!إنّها لا تفقه شيئًا

59
00:03:35,400 --> 00:03:36,980
...هكذا إذًا

60
00:03:36,980 --> 00:03:40,590
ربّما للأمر علاقة بفقدان ذاكرتها؟

61
00:03:40,590 --> 00:03:41,400
.ربّما

62
00:03:46,780 --> 00:03:47,680
!نعم

63
00:03:47,680 --> 00:03:49,630
.فـ-فكرة سديدة

64
00:03:56,420 --> 00:04:00,210
...نعم. بما أنّ كروم لا تتذكّر شيئًا

65
00:04:00,210 --> 00:04:02,060
.وظلّتْ بشكلها الطّفوليّ

66
00:04:03,650 --> 00:04:06,410
.أنتنّ تقلقن أكثر من اللاّزم
!هذا ليس بالأمر الجلل

67
00:04:12,560 --> 00:04:13,790
.وإن يكن

68
00:04:13,790 --> 00:04:15,910
.تقول رينتش لا بأس بالأمر

69
00:04:18,430 --> 00:04:20,320
!كارا، لا تضغطي عليّ

70
00:04:20,630 --> 00:04:23,040
.أصبحتِ متوتّرة جدًّا مؤخّرًا

71
00:04:24,730 --> 00:04:27,030
هل تشعرين وكأنّكِ أصبحتِ معزولة؟

72
00:04:28,920 --> 00:04:30,290
.اهدآ، اهدآ

73
00:04:30,290 --> 00:04:32,730
،هناك أمور كثيرة ما زلنا نجهلها

74
00:04:32,730 --> 00:04:35,040
.لكن لنفكّر بكروم كتلميذة منتقلة

75
00:04:35,300 --> 00:04:36,750
.ينبغي أن ننسجم جميعًا معًا

76
00:04:46,910 --> 00:04:49,260
.تسلسل" هاتين التّوأمتين صعب"

77
00:04:49,890 --> 00:04:53,070
.عليّ أن أسحقهما مبكّرًا

78
00:04:54,250 --> 00:04:56,400
حسنًا، هل الجميع جاهزون؟

79
00:04:56,770 --> 00:05:04,300
معركة كأس جي جي جي 154.095.343
.على وشك البدء

80
00:05:05,500 --> 00:05:10,460
!أوّلاً، العدد الأخير... "كيو إي دي" يصل

81
00:05:10,830 --> 00:05:14,760
!يواجهون المستقلِّين الزُرق، بولتيكس

82
00:05:14,760 --> 00:05:16,830
!يبدو أنّهن متحمّسات اليوم

83
00:05:17,040 --> 00:05:19,340
!بولتيكس، لنكسّر بعض الرّؤوس

84
00:05:19,630 --> 00:05:20,830
!نعم

85
00:05:21,340 --> 00:05:26,220
أوّل من يدخل المجال من طرف بولتيكس
.هي الإعصار الدّوّار جي-رينتش

86
00:05:27,110 --> 00:05:29,970
وكما سبقَ وأعلنت، الأولى من طرف
!كيو إي دي" هي بيرز"

87
00:05:29,970 --> 00:05:31,870
!تتمتّع بقوّة اختراقيّة قاهرة

88
00:05:31,870 --> 00:05:33,350
!نتوقّع معركة عظيمة هنا

89
00:05:33,740 --> 00:05:36,850
!والآن، فلتبدأ المعركة

90
00:05:37,150 --> 00:05:40,460
!بيرز! انطلاق بأقصى سرعة

91
00:05:40,940 --> 00:05:42,740
!رينتش... لن أرحمكِ

92
00:05:42,740 --> 00:05:44,410
!سأحطّمكِ بكلّ ما أمتلك

93
00:06:03,540 --> 00:06:06,500
!مذهل! بدأتْ مباشرة بمعركة عن قرب

94
00:06:06,500 --> 00:06:08,760
!تردّ جي-رينتش الهجمات

95
00:06:08,760 --> 00:06:11,020
!أعرف كلّ تحرّكاتك

96
00:06:11,020 --> 00:06:13,220
!سأقضي عليكِ هنا وحالاً

97
00:06:13,480 --> 00:06:14,980
...كلام أكبر منك

98
00:06:14,980 --> 00:06:15,890
...لكن

99
00:06:17,370 --> 00:06:19,180
!ما رأيكِ بهذا؟

100
00:06:24,900 --> 00:06:26,230
ماذا كان ذلك؟

101
00:06:26,490 --> 00:06:28,110
!لم أشهد مثيلاً لهذا من قبل

102
00:06:29,420 --> 00:06:32,460
!طلبتُ من باي تعديلها لي

103
00:06:32,460 --> 00:06:35,490
!لم أعد بيرز القديمة بعد الآن

104
00:06:48,080 --> 00:06:49,090
!شكرًا

105
00:06:49,360 --> 00:06:54,100
أدخل فريق بولتيكس الشّقيقتين
!فيكس، كارابينا ووايرد

106
00:06:55,440 --> 00:06:56,840
...تعترضان طريقي

107
00:06:57,970 --> 00:07:02,320
"ولتحقيق التّوازن، يُدخل فريق "كيو إي دي
!البروفسورة باي وسنيبس

108
00:07:02,320 --> 00:07:04,880
.عرفتُ أنّنا سنراهما تاليًا

109
00:07:04,880 --> 00:07:06,340
.امضي يا سنيبس

110
00:07:06,340 --> 00:07:07,470
.عُلِم

111
00:07:09,300 --> 00:07:11,470
.مهارة التّفعيل

112
00:07:13,820 --> 00:07:15,280
.نشر المُكعّبين

113
00:07:22,540 --> 00:07:25,870
!تحرز مهارة المكعّب الخاصّة بسنيبس إصابة

114
00:07:26,710 --> 00:07:29,060
...باغتني ذلك

115
00:07:32,680 --> 00:07:33,550
ليس كافيًا؟

116
00:07:35,080 --> 00:07:38,070
!سأتولّى إنهاء العمل إذًا

117
00:07:42,300 --> 00:07:45,280
!تُنقَذ كارابينا في آخر لحظة

118
00:07:45,570 --> 00:07:47,860
!عمل ممتاز بواسطة وايرد

119
00:07:48,230 --> 00:07:49,340
هل أنتِ بخير؟

120
00:07:51,070 --> 00:07:52,570
!أنت من جديد؟

121
00:07:52,720 --> 00:07:54,750
!وايرد، أحسنتِ

122
00:07:55,450 --> 00:07:57,120
.فاقت موهبتك توقّعاتي

123
00:07:57,350 --> 00:08:01,030
أشارت حساباتي إلى أنّ ذلك
.كان سيقضي على واحدة منكنّ

124
00:08:03,540 --> 00:08:06,330
.لكنّ هذا ليس شيئًا لم آخذه في الحسبان

125
00:08:06,330 --> 00:08:09,580
.ما زال هذا ضمن هامش الخطأ

126
00:08:12,060 --> 00:08:12,930
ما هذا؟

127
00:08:13,180 --> 00:08:17,650
!"ما يجب إثباته"

128
00:08:20,130 --> 00:08:24,670
ها هي ذي طلقة باي الانفجاريّة
!القتاليّة، العدد الأخير

129
00:08:24,670 --> 00:08:29,150
إنّها حركة رئيسيّة تعزّز قدرات كافّة
!أعضاء الفريق

130
00:08:29,510 --> 00:08:30,650
!هيّا

131
00:08:30,650 --> 00:08:32,150
!بيرز، سنيبس

132
00:08:32,440 --> 00:08:33,550
!عُلِم

133
00:08:32,440 --> 00:08:33,550
!حاضرة

134
00:08:40,600 --> 00:08:43,160
!كارابينا! وايرد

135
00:08:43,900 --> 00:08:44,940
هل أنتما بخير؟

136
00:08:46,400 --> 00:08:48,010
ما زال هذا غير كافٍ؟

137
00:08:49,210 --> 00:08:50,800
.استعدّي إذًا

138
00:08:51,070 --> 00:08:54,130
!سأقضي على تلكما الاثنتين أوّلاً

139
00:08:54,540 --> 00:08:56,300
!لن أسمح بذلك

140
00:08:56,480 --> 00:08:59,190
!سأحميهما