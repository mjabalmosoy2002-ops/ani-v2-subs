1
00:01:05,040 --> 00:01:07,040
!اجتماع قادة طارئ

2
00:01:08,380 --> 00:01:10,750
...على الأقلّ، تلك كانت الخطّة، لكن

3
00:01:11,310 --> 00:01:13,760
ليسوا مُنظّمين على الإطلاق

4
00:01:13,980 --> 00:01:16,240
حسناً، ماذا تفعل هنا؟

5
00:01:16,590 --> 00:01:19,640
كلّفتني البروفسورة بواجب سكرتاري

6
00:01:19,640 --> 00:01:21,070
حسناً، أيّاً يكن

7
00:01:21,070 --> 00:01:24,830
ما رأيك ببقاء تلكما الاثنتين بجانب بعضهما؟

8
00:01:24,830 --> 00:01:27,530
إنّه منظر أي شخص يحسدهما عليه

9
00:01:28,110 --> 00:01:30,940
...الأداة المجهولة المعروفة بلوست غير

10
00:01:31,520 --> 00:01:36,220
بدأ الزمن يجري مجدّداً هنا والآن كما كان
يجري في عصرٍ ضائع قديم

11
00:01:37,190 --> 00:01:39,560
هلّا توقّفتِ عن إلقاء شِعر بصورة عفويّة؟

12
00:01:39,560 --> 00:01:41,450
المشكلة واضحة

13
00:01:41,900 --> 00:01:44,450
تلكما الاثنتان غامضتان للغاية

14
00:01:44,750 --> 00:01:47,960
عندما نتركهما معاً فكأنّنا نرحّب بهجوم علينا

15
00:01:48,450 --> 00:01:50,970
!تماماً! هذا ما أردتُ الحديث عنه

16
00:01:50,970 --> 00:01:52,800
ماذا ينبغي أن نفعل بشأن هذا؟

17
00:01:52,800 --> 00:01:54,130
ماذا برأيك؟

18
00:01:54,130 --> 00:01:57,440
!سنعمل معاً لحمايتهما

19
00:01:57,440 --> 00:01:58,930
!أيّاً من يظهر من الأعداء

20
00:01:59,380 --> 00:02:01,930
...إذا جمعنا شغفنا معاً

21
00:02:01,930 --> 00:02:04,540
!سنمتلك قوّةً مُدهشة

22
00:02:06,480 --> 00:02:08,080
لا نريد اتّخاذ قرارات تستند على أبطال خارقين

23
00:02:09,390 --> 00:02:11,610
!لهذا لديّ خطّة

24
00:02:19,220 --> 00:02:22,370
إذاً وقعت آمي في قبضتهم كذلك؟

25
00:02:22,630 --> 00:02:25,400
مسؤوليّتنا كبيرة حقّاً

26
00:02:25,400 --> 00:02:26,120
أجل

27
00:02:26,430 --> 00:02:31,880
لكن أمِرنا بإعطاء الأولويّة لاسترجاع كروم

28
00:02:32,120 --> 00:02:33,270
ماذا عن آمي؟

29
00:02:33,270 --> 00:02:35,410
لدينا أوامر من المسؤولين بعدم المساس بها

30
00:02:35,410 --> 00:02:36,130
لمَ لا؟

31
00:02:36,130 --> 00:02:37,880
لم يُسمَح لي بالسُّؤال عن السبب

32
00:02:38,130 --> 00:02:42,280
عندما نسترجع كروم، سنحصل على توصية
من سي

33
00:02:42,280 --> 00:02:43,070
!تفضّل

34
00:02:43,590 --> 00:02:44,670
!المعذرة

35
00:02:44,670 --> 00:02:48,640
أنا الموجة المُنعِشة أنتي من الفرع المدني

36
00:02:48,820 --> 00:02:51,200
سأفعل ما بوسعي للارتقاء بآمالك

37
00:02:51,200 --> 00:02:52,150
أنتي

38
00:02:52,150 --> 00:02:54,040
نعتمد على أداتِك

39
00:02:54,040 --> 00:02:55,650
!حاضرة! أتطلّع قدماً للعمل معك

40
00:02:55,840 --> 00:02:57,440
إنّها متحمّسة حقّاً

41
00:02:57,440 --> 00:02:59,150
إلى حدٍّ مُنعِش

42
00:03:00,530 --> 00:03:04,840
تحوُّل أداة كروم أسرع بـ0.3 ثانية

43
00:03:04,840 --> 00:03:07,160
من وقت تفعيل سلاح آمي

44
00:03:07,680 --> 00:03:10,160
بعكسِ ما كانا عليه عندما كانا معنا

45
00:03:10,950 --> 00:03:14,670
الفارق هو ما سيحدِّد الأفضل

46
00:03:15,260 --> 00:03:17,920
ما الذي يؤثِّر على كروم؟

47
00:03:18,790 --> 00:03:23,300
بولت صنع آمي اعتماداً على مفهوم
تصميم آلة قديمة

48
00:03:24,140 --> 00:03:27,520
لكن لم أقتنع بتلك المُنتحِلة

49
00:03:27,520 --> 00:03:32,310
بالتالي، صنعتُ كروم من آلة قديمة فعليّة

50
00:03:32,530 --> 00:03:34,810
كروم مِلكي أنا

51
00:03:36,120 --> 00:03:37,320
...لكن لماذا

52
00:03:37,590 --> 00:03:40,580
لماذا لم تُظهِر هذا النّشاط عندما كانت معي؟

53
00:03:41,960 --> 00:03:44,320
...ربّما يعمل بولت على تعديلِ كروم

54
00:03:49,400 --> 00:03:52,570
إنّه يتفوّق عليّ

55
00:03:53,160 --> 00:03:55,080
!قلتُ لك، مستحيل

56
00:03:55,350 --> 00:03:59,170
،إذا أرسل الـ ج.س.ف جيشاً ضخماً
!لا يمكننا حمايتهما

57
00:03:59,170 --> 00:04:00,260
!يمكننا وسوف نفعل

58
00:04:00,260 --> 00:04:01,840
!لا تتشاجرا

59
00:04:01,990 --> 00:04:05,210
!نحن لا نتشاجر! نحن نتناقش حول كيفيّة حمايتك

60
00:04:05,210 --> 00:04:05,920
—حتّى غانبار

61
00:04:05,920 --> 00:04:07,600
!لا اقتباسات من غانبار

62
00:04:07,600 --> 00:04:09,620
!ولا قرارات استناداً إلى أبطال خارقين

63
00:04:09,620 --> 00:04:13,600
!لنكون صريحات. كروم وآمي خطيرتان

64
00:04:14,000 --> 00:04:18,980
لكنّهما أيضاً مثيرتان جدّاً للفضول كونهما
وسيلة لتعقُّب أصول الأدوات

65
00:04:19,270 --> 00:04:22,240
عندما يكون الزمن غير محدود، اتبعي مخيّلتك

66
00:04:22,500 --> 00:04:25,190
أتعلمين حتّى عمّاذا نتكلّم؟

67
00:04:25,190 --> 00:04:26,070
أنتن

68
00:04:26,790 --> 00:04:28,670
سمعتُكن من الخارج

69
00:04:29,860 --> 00:04:31,630
ما رأيك يا جدّي؟

70
00:04:31,630 --> 00:04:33,620
بتركِ كروم وآمي معاً؟

71
00:04:34,040 --> 00:04:37,000
عليّ أن أجري صيانة لآمي

72
00:04:37,600 --> 00:04:39,460
ينبغي أن تعتني بكروم

73
00:04:40,120 --> 00:04:41,000
...إذاً

74
00:04:41,000 --> 00:04:43,640
أتعتقد أنّه من الأفضل فصلهما؟

75
00:04:43,640 --> 00:04:45,160
!حتّى أنت يا جدّي

76
00:04:45,160 --> 00:04:47,830
ألا ينبغي أن تقلقن أكثر بشأن الوقت؟

77
00:04:48,840 --> 00:04:51,640
أليس لديكن مُباراة اليوم؟

78
00:04:55,500 --> 00:04:56,400
!ها هم

79
00:04:56,740 --> 00:04:59,180
قائدة بولتيك، الإعصار الدوّار ج-رينتش

80
00:04:59,180 --> 00:05:01,890
!وكروم هنا أيضاً

81
00:05:01,890 --> 00:05:03,710
!آسفة لتأخُّرنا

82
00:05:03,710 --> 00:05:05,200
!آسفة لو جعلتكم تنتظرون

83
00:05:05,200 --> 00:05:07,700
!مدهش! تأخّرتا حقّاً

84
00:05:07,990 --> 00:05:10,110
إنّهما تسخران منّا

85
00:05:10,490 --> 00:05:11,700
!يا لها من مجموعة مسلّية

86
00:05:13,700 --> 00:05:16,240
ماذا تقصدين؟ مع من؟

87
00:05:17,420 --> 00:05:19,570
سأملئكما بالدُّخان

88
00:05:21,980 --> 00:05:23,050
!رينتش

89
00:05:25,730 --> 00:05:26,560
!ماذا؟

90
00:05:30,880 --> 00:05:31,680
!رينتش

91
00:05:31,850 --> 00:05:34,680
أنتِ بغيضة ومزعجة جداً

92
00:05:34,680 --> 00:05:38,020
ها هي هجمة دُخان مُستخدِم الضباب، أفعى

93
00:05:38,970 --> 00:05:40,330
اختفى بولت

94
00:05:44,920 --> 00:05:46,000
...كذلك آمي

95
00:05:46,000 --> 00:05:47,660
لا حاجة للهلع

96
00:05:48,390 --> 00:05:50,790
يتصرّفان بشكلٍ منفرد

97
00:05:51,350 --> 00:05:53,240
!الهجمات المُباغتة ليسَتْ عادلة

98
00:05:53,240 --> 00:05:55,040
هذه عقوبة على التأخُّر

99
00:05:56,140 --> 00:05:58,220
!تبقى المُباراة مُباراة! هيّا بنا

100
00:05:58,220 --> 00:05:59,300
!نعم

101
00:05:59,440 --> 00:06:01,350
!سوف غان-غان عليكم

102
00:06:01,350 --> 00:06:03,000
!تنقضُّ كروم أوّلاً

103
00:06:04,300 --> 00:06:07,060
!تساندها ج-رينتش من الخلف

104
00:06:10,960 --> 00:06:11,990
!كروم

105
00:06:13,050 --> 00:06:14,470
!الضخم قادم

106
00:06:14,470 --> 00:06:16,230
!اصمتي يا صغيرة

107
00:06:16,230 --> 00:06:18,010
!انظروا! إنّه أراكنوبوت

108
00:06:18,010 --> 00:06:20,480
!عزّز فينوميماس دفاعه

109
00:06:20,480 --> 00:06:23,480
نعلم كيف هي آليّة عمل فريقكن

110
00:06:24,920 --> 00:06:26,190
!ماتّي! انضمِّي إلينا

111
00:06:26,580 --> 00:06:28,280
!قادمة مُلبّيةً النداء

112
00:06:29,150 --> 00:06:31,000
هل ينبغي أن أغيّر الأسلوب؟

113
00:06:31,000 --> 00:06:31,940
!نعم

114
00:06:31,940 --> 00:06:33,590
!افعليها

115
00:06:33,590 --> 00:06:36,000
!تغيير أسلوب

116
00:06:36,340 --> 00:06:38,670
!لسنا بحاجةٍ لدفاع

117
00:06:38,670 --> 00:06:40,750
!نحن فريق هجوميّ خارق

118
00:06:42,910 --> 00:06:43,790
اليوم؟

119
00:06:43,790 --> 00:06:45,750
...إنّها ترتجل

120
00:06:45,990 --> 00:06:46,780
!هيّا بنا

121
00:06:46,780 --> 00:06:48,750
!هجوم الصّليب الثلاثي

122
00:06:49,300 --> 00:06:51,400
!أراكنوبوت هو الهدف

123
00:06:51,400 --> 00:06:52,010
!أنا؟

124
00:06:52,010 --> 00:06:53,270
ما هذا؟

125
00:06:53,270 --> 00:06:56,350
المُناورة الثلاثيّة التي استُخدِمَتْ مرّة واحدة
!فقط في الحلقة 42 من غانبار

126
00:06:56,350 --> 00:06:56,940
!نعم

127
00:06:56,940 --> 00:06:57,820
ماذا؟

128
00:06:57,820 --> 00:07:00,780
!تبّاً! لا أستطيع مُجاراتكما

129
00:07:06,220 --> 00:07:07,900
ما-ماذا؟

130
00:07:08,100 --> 00:07:09,030
ما الأمر؟

131
00:07:11,780 --> 00:07:13,410
!إنّه كذلك بالتأكيد

132
00:07:14,070 --> 00:07:15,410
ما ذلك الضوء؟

133
00:07:19,990 --> 00:07:21,790
اختفت ساحة المعركة؟

134
00:07:21,790 --> 00:07:22,850
لماذا؟

135
00:07:22,850 --> 00:07:24,210
!اِلزمن أماكنكن جميعاً

136
00:07:26,650 --> 00:07:28,340
!نحن الـ ج.س.ف

137
00:07:28,340 --> 00:07:30,630
!نُطالب بإنهاءٍ فوريّ لهذه المعركة

138
00:07:31,150 --> 00:07:33,590
!كفّا عن اعتراضِ طريقنا طوال الوقت

139
00:07:33,750 --> 00:07:34,550
!رينتش

140
00:07:34,550 --> 00:07:35,920
—لن أسمح لكما بأخذ كرو

141
00:07:38,310 --> 00:07:39,450
!رينتش

142
00:07:40,860 --> 00:07:42,730
قلتُ لا أحد يتحرّك

143
00:07:42,900 --> 00:07:45,130
!كروم، اهربي

144
00:07:45,130 --> 00:07:46,730
—ولا حتّى ج.س.ف

145
00:07:46,730 --> 00:07:47,930
!اصمتي

146
00:07:47,930 --> 00:07:49,740
لدينا أوامر

147
00:07:50,210 --> 00:07:51,690
هدفنا هو كروم

148
00:07:51,690 --> 00:07:53,560
المُقاومة يعني الاعتقال

149
00:07:53,560 --> 00:07:55,660
لدينا الأمر بالقتل إن لزمَ الأمر

150
00:07:55,660 --> 00:07:56,910
!اصمت

151
00:07:58,540 --> 00:07:59,820
!رينتش

152
00:07:59,820 --> 00:08:01,410
!لن أدعكما تأخذان كروم

153
00:08:01,410 --> 00:08:02,770
!رينتش، لا

154
00:08:02,770 --> 00:08:03,470
—لكن

155
00:08:03,470 --> 00:08:05,800
!هذا أفضل من مشاهدتكِ تموتين

156
00:08:07,230 --> 00:08:09,050
!وعدتُ أن أحميكِ

157
00:08:09,460 --> 00:08:10,660
...رينتش

158
00:08:12,740 --> 00:08:13,800
!كروم

159
00:08:14,480 --> 00:08:15,680
ما هذا؟

160
00:08:18,250 --> 00:08:20,430
!تمَّ تلقِّي موجات

161
00:08:20,730 --> 00:08:23,190
!سأبدأ بالعمل الآن

162
00:08:23,650 --> 00:08:27,190
مهمّتكِ هي ضربها بموجات كهرومغناطيسيّة
من المقرّ

163
00:08:27,700 --> 00:08:31,340
هذه الفتاة هي خطرٌ جسيمٌ على الأمن العام

164
00:08:31,340 --> 00:08:33,400
افعلي ما يُملى عليكِ فحسب

165
00:08:33,890 --> 00:08:35,740
!سأبذل قصارى جهدي

166
00:08:37,490 --> 00:08:38,950
!كروم

167
00:08:38,950 --> 00:08:40,200
!تماسكي

168
00:08:41,160 --> 00:08:42,590
مهِّدي الطريق يا فتاة

169
00:08:43,290 --> 00:08:45,460
الـ ج.س.ف سيحتجز كروم

170
00:08:52,480 --> 00:08:54,170
!آمي