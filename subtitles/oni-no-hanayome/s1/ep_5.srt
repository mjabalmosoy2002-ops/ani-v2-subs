1
00:00:01,890 --> 00:00:04,130
.أنتِ عروسي

2
00:00:04,130 --> 00:00:06,910
.بقيّة حياتك ملكي

3
00:00:07,340 --> 00:00:08,480
...رييا

4
00:00:10,120 --> 00:00:12,900
.أشعر بمدى قوّة مشاعره تجاهي

5
00:00:15,170 --> 00:00:18,220
.يريد أن يمتلكني بالكامل

6
00:00:21,420 --> 00:00:26,420
عيناه الحمراوان المتألّقتان بالرّغبة
.أسرتاني ولن تدعاني

7
00:00:26,740 --> 00:00:31,050
أعلم أنّك لا تستطيعين الوثوق
،بي تمامًا لأنّنا التقينا حديثًا

8
00:00:31,050 --> 00:00:33,930
.لكنّني لن أتخلّى عنك

9
00:00:34,660 --> 00:00:37,930
.حتّى لو شككتِ بي، ابقي معي

10
00:00:39,250 --> 00:00:44,430
لكن ماذا لو غيّرتَ رأيك كما فعل ياماتو؟

11
00:00:45,030 --> 00:00:47,560
.أقول لك، لن أفعل

12
00:00:47,560 --> 00:00:50,440
لستُ مثل والديك
.أو حبيبك الّذين تخلّوا عنك

13
00:00:50,760 --> 00:00:53,840
.إنّه لمن السّيّئ أنّك واعدت شخصًا من قبل

14
00:00:53,840 --> 00:00:56,630
.مقارنتي بذلك الوغد تُهينني

15
00:00:56,940 --> 00:01:00,880
.لا ​​يبدو غاضبًا، بل يبدو مُكتئبًا

16
00:01:00,880 --> 00:01:03,960
.إذا شعرتِ بالقلق يومًا، أخبريني

17
00:01:06,450 --> 00:01:12,460
.سأُخفّف قلقك كلّما احتجتِ حتّى تثقين بي

18
00:01:12,890 --> 00:01:14,050
...رييا

19
00:01:14,460 --> 00:01:18,120
.إذا أردتِ وظيفة، ساعديني في عملي

20
00:01:18,120 --> 00:01:19,330
عملك؟

21
00:01:19,330 --> 00:01:20,080
.نعم

22
00:01:20,440 --> 00:01:24,970
ستشعرين براحة أكبر إذا كنتِ تُغطّين
نفقات دراستك بنفسك، أليس كذلك؟

23
00:01:25,360 --> 00:01:28,340
.إنّه يُراعي مشاعري

24
00:01:29,070 --> 00:01:30,980
.نعم. شكرًا لك يا رييا

25
00:01:33,990 --> 00:01:37,890
هل سأثق به ثقةً مطلقةً يومًا ما؟

26
00:01:37,890 --> 00:01:44,480
هل سأثق يومًا ما بالحبّ الّذي
مُنح لي وأستمتع به تمامًا؟

27
00:01:45,290 --> 00:01:47,600
.أتمنّى ذلك يومًا ما

28
00:03:23,810 --> 00:03:25,830
.يوزو-ساما، اعتني بنفسك

29
00:03:25,830 --> 00:03:26,760
.سأفعل

30
00:03:27,120 --> 00:03:28,260
.يوزو

31
00:03:29,120 --> 00:03:30,280
.رييا

32
00:03:30,960 --> 00:03:33,270
.سأرسل من يأتي ليقلّك بعد المدرسة

33
00:03:33,270 --> 00:03:34,280
.حسنًا

34
00:03:36,050 --> 00:03:39,950
عفوًا، هل يجب أن يوصلني
أحد إلى المدرسة أيضًا؟

35
00:03:39,950 --> 00:03:41,350
.بالطّبع

36
00:03:42,730 --> 00:03:45,680
.رييا-ساما، لقد اقترب الموعد

37
00:03:45,680 --> 00:03:47,110
.وأنت أيضًا يا سيّدتي

38
00:03:47,410 --> 00:03:48,820
.حا-حاضرة

39
00:03:51,210 --> 00:03:56,480
هل يُعقل أنّ تاكاميتشي-سان لا يحبّني؟

40
00:04:02,390 --> 00:04:05,070
لا أستطيع التّعوّد على أن يوصلني
،أحد إلى كلّ مكان

41
00:04:05,070 --> 00:04:09,900
لكنّ نيانكيتشي-كُن حذّرني
.من مخاطر كوني عروس

42
00:04:09,900 --> 00:04:12,400
.على أيّ حال، كان الأمر رائعًا

43
00:04:12,760 --> 00:04:14,280
.إنّها يوزو

44
00:04:14,280 --> 00:04:16,190
.مرحبًا يا يوزو

45
00:04:16,430 --> 00:04:18,960
.لم أذهب إلى المدرسة منذ أيّام

46
00:04:18,960 --> 00:04:23,290
لم يتغيّر شيء، لكنّني اشتقت
.لهذا المكان كثيرًا

47
00:04:24,990 --> 00:04:27,080
.كنتُ مشغولة ببعض الأمور العائليّة

48
00:04:27,700 --> 00:04:29,500
أهذا ما حدث فقط؟

49
00:04:29,500 --> 00:04:33,280
.أنا الوحيدة الّتي تغيّرت بشكل جذريّ

50
00:04:34,590 --> 00:04:35,700
.صباح الخير

51
00:04:36,800 --> 00:04:39,900
.صباح الخير يا توكو ونيانكيتشي-كُن

52
00:04:39,900 --> 00:04:40,710
.مرحبًا

53
00:04:45,250 --> 00:04:51,600
جميع زملائنا في الصّفّ يُفسحون لهما
.المجال، ولكن ليس بطريقة سيّئة

54
00:04:52,170 --> 00:04:55,160
يُكنّ الجميع الاحترام للشّيطان
الوقور نيانكيتشي-كُن

55
00:04:55,160 --> 00:04:59,420
.ولعروسه توكو الّتي يُغدق عليها بالحبّ

56
00:04:59,420 --> 00:05:01,680
.لا يُمكنهم التّحدّث إليهما بشكل عاديّ

57
00:05:02,200 --> 00:05:06,290
بما أنّك في المدرسة، هل هذا
يعني أنّكما حللتما الأمور؟

58
00:05:06,290 --> 00:05:10,700
.نعم. سأعمل لدى رييا

59
00:05:10,700 --> 00:05:14,680
يبدو أنّه هو من اتّصل بعملي
.ليطلب الاستقالة

60
00:05:14,680 --> 00:05:15,700
.يا إلهي

61
00:05:16,070 --> 00:05:19,290
يُمكن للشّياطين أن يكونوا
شديدي التّملّك، صحيح؟

62
00:05:20,490 --> 00:05:24,220
.أنا ممتنّة لأنّه يسمح لي بالعمل أصلاً

63
00:05:24,220 --> 00:05:30,100
أنا مندهشة من سماح
.رييا-ساما لعروسه بالعمل

64
00:05:30,100 --> 00:05:32,710
.ربّما يريد قضاء المزيد من الوقت مع يوزو

65
00:05:32,710 --> 00:05:37,730
مهلاً... هل قلتِ للتّوّ أنّك عروس؟

66
00:05:37,730 --> 00:05:39,220
...في الواقع، أنا

67
00:05:39,220 --> 00:05:42,980
.تمّ اختيار يوزو لتكون عروسًا لغول

68
00:05:42,980 --> 00:05:45,490
توكو! لماذا تقولين ذلك؟

69
00:05:45,490 --> 00:05:46,850
أكان عليّ ألاّ أقول ذلك؟

70
00:05:47,140 --> 00:05:49,110
هل هذا صحيح يا يوزو؟

71
00:05:49,490 --> 00:05:51,750
مستحيل! غول؟

72
00:05:51,750 --> 00:05:53,640
!هذا رائع! تهانينا لك

73
00:05:52,340 --> 00:05:54,610
هل هو وسيم؟ هل هو كذلك؟

74
00:05:54,610 --> 00:05:57,460
هيّا، هل لديك أيّ صور له؟

75
00:05:57,460 --> 00:05:58,630
.كـ-كلاّ

76
00:05:58,830 --> 00:06:00,630
.أنا لديّ

77
00:06:00,630 --> 00:06:02,180
كيف يكون وسيمًا إلى هذا الحدّ؟

78
00:06:02,180 --> 00:06:03,870
هل هو حقيقيّ من الأساس؟

79
00:06:03,870 --> 00:06:04,920
!إنّه فاتن

80
00:06:04,920 --> 00:06:06,630
كيف أصبحتِ عروسه؟

81
00:06:06,950 --> 00:06:09,500
لماذا لديك هذه الصّورة؟

82
00:06:09,500 --> 00:06:11,900
.التقطتُها له وهو يغادر البارحة

83
00:06:11,900 --> 00:06:15,710
.كان سعيدًا بذلك مقابل صورة ليوزو

84
00:06:15,710 --> 00:06:18,140
متى اتّفقتما على ذلك؟

85
00:06:18,540 --> 00:06:22,010
!بدأ الدّرس! اجلسوا في أماكنكم

86
00:06:27,620 --> 00:06:29,650
الغولان الأدنيان؟ متى وصلتما إلى هنا؟

87
00:06:33,610 --> 00:06:35,380
من هذان؟

88
00:06:36,150 --> 00:06:37,620
!إنّهما في غاية الظّرافة

89
00:06:37,970 --> 00:06:40,220
.ظننتُ أنّني تركتكما في المنزل

90
00:06:40,220 --> 00:06:41,370
!مهلاً

91
00:06:41,640 --> 00:06:43,720
!الحيوانات الأليفة ممنوعة في المدرسة

92
00:06:43,720 --> 00:06:46,060
.إنّهما ليسا حيوانات أليفة

93
00:06:52,160 --> 00:06:55,940
حسنًا، ليس بوسعنا فعل الكثير
.الآن بما أنّهما هنا

94
00:06:55,940 --> 00:06:57,460
.حاولا أن تتصرّفا بأدب فحسب

95
00:06:58,260 --> 00:06:59,220
ماذا؟

96
00:06:59,770 --> 00:07:01,350
.لنبدأ

97
00:07:01,890 --> 00:07:07,230
.حتّى معلّمنا عاجز أمام ظرافتهما

98
00:07:08,380 --> 00:07:10,560
.أنا مُرهقة

99
00:07:10,560 --> 00:07:14,990
لا بدّ أنّ الاستجواب خلال كلّ
.استراحة كان صعبًا

100
00:07:14,990 --> 00:07:17,070
من المسؤول عن ذلك؟

101
00:07:17,070 --> 00:07:21,370
.هيّا، هيّا. لنستعد نشاطنا بتناول الغداء

102
00:07:21,370 --> 00:07:22,070
.نعم

103
00:07:23,580 --> 00:07:26,280
!يا له من غداء فاخر

104
00:07:26,280 --> 00:07:29,590
.أعدّه لي طاهي القصر الخاصّ

105
00:07:33,290 --> 00:07:34,790
!إنّه لذيذ جدًّا

106
00:07:35,410 --> 00:07:38,350
هل يعاملك آل كيريوين معاملة حسنة؟

107
00:07:38,350 --> 00:07:41,180
.نعم. الجميع لطيفون معي

108
00:07:41,180 --> 00:07:43,460
.يسعدني سماع ذلك

109
00:07:43,460 --> 00:07:48,110
كنت قلقة فحسب... بما أنّ السّيّد
.الصّغير مخطوب سلفًا

110
00:07:48,110 --> 00:07:48,600
ماذا؟

111
00:07:49,260 --> 00:07:52,300
.جمالها يفوق الوصف، وهي ذكيّةٌ أيضًا

112
00:07:52,300 --> 00:07:56,700
تحظى كياما ساكوراكو بشعبيّةٍ
.بين الغيلان الآخرين أيضًا

113
00:07:56,700 --> 00:07:58,120
مخطوبة؟

114
00:07:59,120 --> 00:08:00,540
من رييا؟

115
00:08:00,540 --> 00:08:03,700
نعم. مهلاً، ألم تكوني تعلمين ذلك؟

116
00:08:05,980 --> 00:08:08,080
رييا مخطوب؟

117
00:08:08,080 --> 00:08:12,200
.لم يذكر أحدٌ ذلك
فماذا أكون أنا إذًا؟

118
00:08:13,000 --> 00:08:15,160
،يُنادونني عروسه باستمرار

119
00:08:15,160 --> 00:08:18,420
،لكن إن كان مخطوبًا بالفعل
فلماذا يحتاجني؟

120
00:08:20,570 --> 00:08:25,330
توكو، أنت تُعطينها فكرةً خاطئةً
.بطرحك الأمر بهذه الطّريقة

121
00:08:25,330 --> 00:08:26,350
.أنا آسفة

122
00:08:26,350 --> 00:08:27,830
أيّ فكرةٍ خاطئة؟

123
00:08:29,020 --> 00:08:32,870
أوّلاً، لا يتزوّج الشّياطين عادة
.إلاّ من شياطين آخرين

124
00:08:32,870 --> 00:08:34,020
تعلمين ذلك بالفعل، أليس كذلك؟

125
00:08:34,020 --> 00:08:35,060
.نعم

126
00:08:35,320 --> 00:08:40,070
يتمّ اختيار شريكة كبير العشيرة
.القادم بواسطة لجنة

127
00:08:40,560 --> 00:08:45,870
اختارت عائلة رييا-ساما
.كياما ساكوراكو-ساما لتكون خطيبته

128
00:08:46,440 --> 00:08:51,090
اختاروها لأنّها تنتمي
،إلى أعظم فرع من العائلة

129
00:08:51,090 --> 00:08:54,690
وقوّتها الشّيطانيّة هي الأقوى
.بين فتيات العشيرة في مثل عمره

130
00:08:55,410 --> 00:08:59,860
،لكن عندما يُعثَر على عروس
.تُعطى الأولويّة لها

131
00:08:59,860 --> 00:09:00,690
فعلاً؟

132
00:09:00,940 --> 00:09:03,580
،كانت لديّ خطيبة من قبل أيضًا

133
00:09:03,580 --> 00:09:07,240
لكنّ خطوبتنا أُلغيت عندما
.ظهرت توكو في الصّورة

134
00:09:07,940 --> 00:09:12,430
هل أُهمِّش شخصًا مثلها لأصبح خطيبته؟

135
00:09:13,280 --> 00:09:15,690
.لم يخبرني رييا بأيّ بشيء

136
00:09:15,690 --> 00:09:18,580
.استُدعي البارحة إلى المنزل الرّئيسيّ مجدّدًا

137
00:09:18,580 --> 00:09:22,060
أنا الوحيدة الّتي لا تفهم معنى
.أن تكون الفتاة عروسًا

138
00:09:22,910 --> 00:09:27,150
،نيانكيتشي-كون
هل العرائس من النّساء فقط؟

139
00:09:27,150 --> 00:09:29,910
هل يُختار الرّجال من البشر أصلاً؟

140
00:09:29,910 --> 00:09:32,050
...حسنًا، بخصوص هذا

141
00:09:32,050 --> 00:09:36,430
.للنّساء الشّيطانات معايير أكثر صرامة من الرّجال

142
00:09:36,430 --> 00:09:39,050
.إنّهنّ يُقدّرن القوّة الشّيطانيّة والثّروة

143
00:09:39,050 --> 00:09:42,050
الرّجال من البشر الّذين لا يملكون أيّ
.قوّة شيطانيّة لا يستحقّون اهتمامهنّ

144
00:09:42,050 --> 00:09:43,790
.يبدو أنّهنّ قاسيات

145
00:09:43,790 --> 00:09:47,310
لا يزال هناك الكثير ممّا
.نجهله عن العرائس

146
00:09:47,540 --> 00:09:51,070
كيف يُنجبن شياطين أقوياء
وهنّ لا يملكن أيّ قوى شيطانيّة؟

147
00:09:51,070 --> 00:09:54,260
كيف يُعزّزن قوّة شريكهنّ الشّيطانيّة؟

148
00:09:54,260 --> 00:09:58,510
كيف يعرف الشّياطين من النّظرة
الأولى من هنّ عرائسهم؟

149
00:09:59,610 --> 00:10:04,850
،إذا كان حتّى الشّياطين لا يعرفون
فكيف لي أن أعرف؟

150
00:10:05,310 --> 00:10:09,050
كلّ ما نعرفه هو أنّ هذه
.هي طبيعة العرائس

151
00:10:09,370 --> 00:10:11,130
.لا أحد يعرف السّبب الحقيقيّ بالفعل

152
00:10:15,350 --> 00:10:17,890
.أتمنّى لو كنت أعرف

153
00:10:18,110 --> 00:10:21,370
.ما كنتُ حينها لأشعر بكلّ هذا القلق

154
00:10:21,370 --> 00:10:25,640
ربّما حينها أستطيع أن أقول
.بكلّ ثقة أنّني عروس رييا

155
00:10:26,570 --> 00:10:31,150
لأكون صريحة، أنا لا أفهم الحبّ
.والرّومانسيّة حقًّا

156
00:10:31,520 --> 00:10:36,270
لم أواعد ياماتو إلاّ لأنّني كنت
سعيدةً بإعجاب أحدهم بي

157
00:10:36,270 --> 00:10:38,520
.وكنتُ متحمّسةً لأنّه أراد مواعدتي

158
00:10:39,490 --> 00:10:43,240
عندما أفكّر في الأمر بهذه
.الطّريقة، لم أكن صادقةً تمامًا

159
00:10:43,860 --> 00:10:50,290
لطالما تمنّيتُ أن يُحبّني
.أحدهم، ثمّ التقيتُ برييا

160
00:10:50,930 --> 00:10:54,030
.يجب أن أستسلم لحبّ رييا فحسب

161
00:10:54,030 --> 00:10:56,150
.هناك جزءٌ منّي يهمس لي بذلك

162
00:10:57,120 --> 00:11:01,130
،لكن أتمنّى، في أفضل الأحوال
.أن أبادله الحبّ

163
00:11:06,950 --> 00:11:07,890
.شكرًا

164
00:11:08,520 --> 00:11:11,200
.حسنًا، سيفي هذا بالغرض

165
00:11:11,780 --> 00:11:13,270
.عليّ أن أجتهد

166
00:11:13,270 --> 00:11:16,460
أنا أتدرّب استعدادًا لبداية
.حياتي العمليّة كراشدة

167
00:11:23,880 --> 00:11:28,780
بصفته رئيس مجموعة كيريوين
.الضّخمة، فإنّ رييا مشغول للغاية

168
00:11:28,780 --> 00:11:33,540
،إنّه لطيف معي دائمًا
.لكنّه بارد وقاسٍ مع موظّفيه

169
00:11:33,790 --> 00:11:38,260
رييا-ساما، لقد دُعيتَ إلى عشاء
.مع مسؤول حكوميّ رفيع المستوى

170
00:11:38,260 --> 00:11:39,540
.ارفض الدّعوة

171
00:11:40,250 --> 00:11:43,080
.هذا ليس تصرّفًا صحّيًّا

172
00:11:46,050 --> 00:11:47,670
...الأهمّ من ذلك يا تاكاميتشي

173
00:11:47,670 --> 00:11:48,880
هل تبحث عن هذا؟

174
00:11:51,860 --> 00:11:54,690
رييا، لمَ لا تأخذ استراحة؟

175
00:11:54,690 --> 00:11:56,180
.بالتّأكيد

176
00:12:06,210 --> 00:12:07,570
.يوزو-ساما

177
00:12:08,030 --> 00:12:10,570
.أودّ مناقشة أمرٍ معك

178
00:12:10,570 --> 00:12:11,410
ماذا؟

179
00:12:11,410 --> 00:12:13,590
هل أخطأتُ في شيء ما؟

180
00:12:13,840 --> 00:12:17,520
.لديّ مهمّةٌ لك

181
00:12:17,520 --> 00:12:19,140
وما هي؟

182
00:12:19,140 --> 00:12:22,090
أودّ منك أن تأخذي استراحات
.مع رييا-ساما

183
00:12:22,090 --> 00:12:23,340
عفوًا؟

184
00:12:23,340 --> 00:12:27,740
،إذا تُرك رييا-ساما وشأنه
.فلن يتوقّف عن العمل أبدًا

185
00:12:27,740 --> 00:12:32,140
،طلبتُ منه مرارًا وتكرارًا أن يعتني بنفسه

186
00:12:32,140 --> 00:12:34,720
.لكنّه يرفض الاستماع

187
00:12:35,170 --> 00:12:39,920
.مع ذلك، يبدو أنّه قد يأخذ استراحاتٍ معك

188
00:12:41,200 --> 00:12:44,820
هل هذا هو سبب مراقبته لي؟

189
00:12:45,300 --> 00:12:47,340
.فهمت

190
00:12:51,300 --> 00:12:55,240
لم يأخذ استراحةً واحدةً منذ
.ثلاث ساعات. حان الوقت

191
00:12:56,450 --> 00:12:58,670
رييا، هل أُحضّر لك بعض الشّاي؟

192
00:12:58,670 --> 00:12:59,510
.أكيد

193
00:13:01,040 --> 00:13:02,140
.تفضّلا

194
00:13:05,020 --> 00:13:07,120
.أُقدّر إطراءك لي هذا كثيرًا

195
00:13:08,840 --> 00:13:13,390
يُحضر تاكاميتشي-سان الشّاي
.قبل حتّى أن أبدأ بتحضيره

196
00:13:14,300 --> 00:13:17,040
هل يستطيع التّنبّؤ بالمستقبل؟

197
00:13:23,480 --> 00:13:27,500
.لقد فاته الغداء لأنّ اجتماعه طال كثيرًا

198
00:13:27,500 --> 00:13:28,650
.يجب أن أذهب لأشتري شيئًا

199
00:13:29,900 --> 00:13:31,290
.المعذرة

200
00:13:31,650 --> 00:13:34,050
.تفضّلي يا يوزو-ساما

201
00:13:34,050 --> 00:13:35,730
.شكرًا لك

202
00:13:35,730 --> 00:13:38,920
.رييا، يجب أن تأكل شيئًا

203
00:13:40,850 --> 00:13:43,410
.لديّ شيء يمكنك أكله بيد واحدة

204
00:13:43,730 --> 00:13:45,900
أين وصلنا في هذا الموضوع؟

205
00:13:45,900 --> 00:13:48,430
هل تقصد العلامة التّجاريّة
الجديدة قيد التّطوير؟

206
00:13:48,800 --> 00:13:50,180
...بخصوص ذلك

207
00:13:52,430 --> 00:13:53,820
.تاكاميتشي

208
00:13:53,820 --> 00:13:55,090
.ها هو ذا

209
00:13:56,200 --> 00:14:02,680
عندما يطلب رييا شيئًا حتّى بدون
.تسميته، يُعطيه تاكاميتشي ما يحتاجه

210
00:14:03,200 --> 00:14:05,350
ويفهم تاكاميتشي ما يريده ويفعله
.رييا بمجرّد أن يناديه باسمه

211
00:14:05,350 --> 00:14:07,460
.إنّهما كزوجين متزوّجين منذ زمن طويل

212
00:14:07,940 --> 00:14:11,700
.لا يمكنني فعل ذلك

213
00:14:11,700 --> 00:14:15,240
،ورييا عادةً غير مبالٍ بالآخرين

214
00:14:15,240 --> 00:14:17,660
لكنّه يعامل تاكاميتشي-سان
.بشكل مختلف قليلاً

215
00:14:17,960 --> 00:14:21,110
.إنّهما أكثر من مجرّد رئيس وسكرتيره

216
00:14:21,110 --> 00:14:25,060
.ثقتهما ببعض أعمق من ذلك

217
00:14:26,550 --> 00:14:30,460
.أريد أن أكون مفيدة لرييا مثل تاكاميتشي

218
00:14:32,520 --> 00:14:34,650
هل اعتدتِ على العمل؟

219
00:14:34,650 --> 00:14:39,530
.نعم. كنتما أنت ورييا معلّمين رائعين

220
00:14:39,530 --> 00:14:40,720
.يسعدني سماع ذلك

221
00:14:41,410 --> 00:14:46,240
.الأجواء دائمًا مريحة، وكلاهما يراعي مشاعري

222
00:14:46,530 --> 00:14:51,090
.يأخذ رييا-ساما استراحات بفضلك أخيرًا

223
00:14:51,090 --> 00:14:55,150
ويُقال في المكتب
.أنّه أصبح أكثر لطفًا أيضًا

224
00:14:55,610 --> 00:15:01,460
.لم أفعل شيئًا
.أنا فقط آخذ استراحات معه

225
00:15:04,060 --> 00:15:05,010
...عفوًا

226
00:15:07,240 --> 00:15:10,760
هل من الخطأ أن تعمل العروس؟

227
00:15:12,340 --> 00:15:15,000
.نعم، أنا أعارض ذلك

228
00:15:16,080 --> 00:15:20,800
بشكل عامّ، تُعامَل العرائس
.بعناية ولا يُسمح لهنّ بالعمل

229
00:15:21,310 --> 00:15:26,980
قد تسخر منّا العشائر الأخرى لافتقارنا
.للموارد اللاّزمة لرعاية عرائسنا

230
00:15:28,780 --> 00:15:30,780
.من الأفضل أن تلتزم الصّمت

231
00:15:31,210 --> 00:15:32,800
.أنا أعتذر

232
00:15:33,300 --> 00:15:35,020
...رييا، أنا

233
00:15:35,020 --> 00:15:39,100
.يقول النّاس أنّني أجبرك على البقاء معي

234
00:15:39,100 --> 00:15:41,800
أنا لا أسبّب لك أيّ مشاكل، صحيح؟

235
00:15:41,800 --> 00:15:45,240
.لا بأس، طالما أستطيع البقاء معك

236
00:15:45,910 --> 00:15:48,000
.لا داعي للقلق حيال الأمر

237
00:15:48,000 --> 00:15:51,540
.أنت تدلّلني كثيرًا يا رييا

238
00:15:51,540 --> 00:15:54,510
.هذا شرفٌ مُنح لي

239
00:15:54,970 --> 00:15:56,640
.لن أدع أحدًا غيري يفعل ذلك

240
00:16:00,670 --> 00:16:05,710
،أنا قلقة بشأن أمور كثيرة
.لكنّني سأثق برييا الآن

241
00:16:06,840 --> 00:16:11,440
بالمناسبة يا رييا، هل يُمكنني زيارة
جدّي وجدّتي الأسبوع القادم؟

242
00:16:11,440 --> 00:16:12,870
...حسنًا

243
00:16:12,870 --> 00:16:15,010
ما هي الطّريقة المُناسبة
لتقديم طلب يا يوزو؟

244
00:16:15,410 --> 00:16:16,190
طلب؟

245
00:16:16,480 --> 00:16:18,090
!صحيح

246
00:16:18,490 --> 00:16:20,890
.لكنّ تاكاميتشي-سان هنا

247
00:16:20,890 --> 00:16:21,930
.لا، ليس هنا

248
00:16:22,190 --> 00:16:23,150
ماذا؟

249
00:16:23,700 --> 00:16:25,210
منذ متى؟

250
00:16:25,470 --> 00:16:30,210
اتّفاقي مع رييا هو أن أقبّله
.عندما أطلب منه شيئًا

251
00:16:30,210 --> 00:16:33,640
.بالطّبع، كانت فكرته بالكامل

252
00:16:38,700 --> 00:16:40,480
.لا-لا أستطيع

253
00:16:48,030 --> 00:16:53,660
في اليوم الّذي التقيت فيه
.بكيريوين رييا-ساما، تغيّرت حياتي

254
00:16:59,010 --> 00:17:00,990
كيريوين رييا؟

255
00:17:01,450 --> 00:17:06,030
لماذا عليّ أن أخدم طفلاً
بدأ لتوّه دراسته الابتدائيّة؟

256
00:17:06,030 --> 00:17:07,900
.أنت ما زلت طفلاً أيضًا

257
00:17:08,790 --> 00:17:12,490
إضافةً إلى ذلك، إنّه لشرف لك
.أن تخدم كبير العشيرة المستقبليّ

258
00:17:13,110 --> 00:17:16,520
.التقيت بكبير عشيرة كيريوين عدّة مرّات

259
00:17:17,290 --> 00:17:22,260
بصراحة، لا أتوقّع الكثير
.من ابن ذلك الرّجل النّحيل

260
00:17:37,830 --> 00:17:39,020
تاكاميتشي؟

261
00:17:43,260 --> 00:17:45,330
.أنا كيريوين رييا

262
00:17:46,340 --> 00:17:50,330
.عيناه الحمراوان جميلتان

263
00:17:51,200 --> 00:17:53,900
.ملامحه قاتمة وناضجة

264
00:17:53,900 --> 00:17:56,810
.جسده كلّه مُحاط بطاقة شيطانيّة جبّارة

265
00:17:56,810 --> 00:17:59,340
.له هيبة ملكيّة

266
00:17:59,800 --> 00:18:01,930
.يسعدني لقاؤك

267
00:18:06,780 --> 00:18:10,490
!هذا هو السّيّد الّذي أخدمه

268
00:18:11,790 --> 00:18:15,090
.أنا أراكي تاكاميتشي يا رييا-ساما

269
00:18:39,160 --> 00:18:40,930
.تأخّر الوقت بالفعل

270
00:18:45,830 --> 00:18:47,900
.أهلاً بعودتك يا رييا

271
00:18:50,220 --> 00:18:52,150
.لقد عدتُ يا يوزو

272
00:18:57,570 --> 00:19:02,170
.هذه لك. لهذا السّبب تأخّرت

273
00:19:02,170 --> 00:19:04,230
...إنّها كثيرة

274
00:19:04,930 --> 00:19:06,670
.ابدئي بهذه

275
00:19:07,830 --> 00:19:09,250
!كم هي ظريفة

276
00:19:11,360 --> 00:19:12,770
رسالة؟

277
00:19:14,990 --> 00:19:18,330
.يوزو، عيد ميلاد أوّل سعيد

278
00:19:18,330 --> 00:19:22,550
.أنا سعيد جدًّا بميلادك

279
00:19:22,550 --> 00:19:23,520
.من رييا

280
00:19:24,630 --> 00:19:26,000
ما هذا؟

281
00:19:30,020 --> 00:19:31,790
،عزيزتي يوزو ذات العامين

282
00:19:31,790 --> 00:19:34,410
.أراهن أنّك صرتِ تُجيدين الكلام الآن

283
00:19:37,170 --> 00:19:39,030
،عزيزتي يوزو ذات الثّلاثة أعوام

284
00:19:39,030 --> 00:19:40,940
هل أصبحتِ كثيرة المطالب؟

285
00:19:42,030 --> 00:19:43,650
،عزيزتي يوزو ذات السّتّ سنوات

286
00:19:43,650 --> 00:19:45,490
.بدأتِ المرحلة الابتدائيّة أخيرًا

287
00:19:45,490 --> 00:19:49,500
أعلم أنّك ستكوّنين الكثير من
.الصّداقات فورًا لأنّك لطيفة جدًّا

288
00:19:50,070 --> 00:19:51,830
،عزيزتي يوزو ذات العشر سنوات

289
00:19:51,830 --> 00:19:54,060
هل بدأتِ تنضجين؟

290
00:19:54,510 --> 00:19:56,250
،عزيزتي يوزو ذات الثّلاثة عشر عامًا

291
00:19:56,610 --> 00:19:58,590
.أنت الآن في المرحلة الإعداديّة

292
00:19:58,590 --> 00:20:01,330
.لا بد أنّك تبدين رائعة بزيّك المدرسيّ

293
00:20:02,570 --> 00:20:04,510
،عزيزتي يوزو ذات السّتّة عشر عامًا

294
00:20:04,510 --> 00:20:06,280
.ألف مبروك على دخولك المرحلة الثّانويّة

295
00:20:06,710 --> 00:20:09,770
.أتمنّى لك دوام الصّحّة والعافية حتّى تخرّجك

296
00:20:10,520 --> 00:20:12,250
،عزيزتي يوزو ذات السّبعة عشر عامًا

297
00:20:12,820 --> 00:20:15,780
.لقد صنعتُ لك عطرًا

298
00:20:15,780 --> 00:20:17,260
.سأراك قريبًا

299
00:20:17,260 --> 00:20:21,080
هل هذه هدايا عيدِ ميلاد لكلّ
السّنوات السّبعة عشر الماضية؟

300
00:20:21,080 --> 00:20:27,240
هل اشترى رييا كلّ هذه الأشياء لي؟

301
00:20:28,780 --> 00:20:32,930
.لم تحتفل عائلتي بعيد ميلادي قطّ

302
00:20:33,390 --> 00:20:36,030
.لطالما شعرتُ بالوحدة

303
00:20:37,730 --> 00:20:40,390
.هذا لك الآن وقد بلغتِ الثّامنة عشرة

304
00:20:42,020 --> 00:20:45,460
.أنا آسف لأنّي لم أجدك في وقت أقرب

305
00:20:49,440 --> 00:20:52,650
أعيش ثمانية عشر عامًا
.من السّعادة دفعة واحدة

306
00:20:53,730 --> 00:20:56,260
.أريد أن أردّ لك الجميل بطريقة ما

307
00:20:56,260 --> 00:20:59,190
.أريد تقديم هديّة لك

308
00:20:59,190 --> 00:21:01,520
.أريدك أن تكون سعيدًا أيضًا

309
00:21:02,010 --> 00:21:08,530
،لا أملك الكثير
لكن هل هناك شيء تريده؟

310
00:21:10,350 --> 00:21:13,030
.في هذه الحالة، أريد قبلة شكر

311
00:21:14,030 --> 00:21:15,040
ماذا؟

312
00:21:15,340 --> 00:21:17,790
.على الشّفاه، وليس الخدّ

313
00:21:18,280 --> 00:21:21,300
.لـ-لكنّني لستُ مستعدّة

314
00:21:21,900 --> 00:21:23,500
.أنا آسف لإحراجك

315
00:21:23,500 --> 00:21:25,830
،طالما أنت سعيدة
.لا أحتاج إلى أيّ شيء آخر

316
00:21:28,340 --> 00:21:29,540
.هذا مجدّدًا

317
00:21:30,710 --> 00:21:37,690
،يعاملني رييا بلطف شديد
.لكنّ كلّ ما أفعله هو إثقال كاهله

318
00:21:38,420 --> 00:21:42,250
.أريد أن أفعل شيئًا لك أيضًا

319
00:21:46,290 --> 00:21:48,910
.شكرًا لك يا رييا

320
00:21:52,710 --> 00:21:55,860
.شفتاي تستطيعان الانتظار قليلاً

321
00:21:56,580 --> 00:21:58,110
.أنا متشوّق لذلك

322
00:21:58,770 --> 00:22:03,970
ما زلتُ لا أعتقد أنّني أستطيع
،إسعاد أيّ شخص

323
00:22:03,970 --> 00:22:10,040
.وخاصّةً رييا، الّذي التقيتُ به حديثًا فقط

324
00:22:11,020 --> 00:22:13,510
،ولسببٍ ما

325
00:22:14,010 --> 00:22:19,110
.ابتسامة رييا تُشعرني بالسّعادة والدّفء

326
00:22:20,070 --> 00:22:22,770
ما اسم هذا الشّعور؟