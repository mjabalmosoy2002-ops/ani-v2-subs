1
00:00:06,990 --> 00:00:09,290
.هذا ليس مجرّد اختبار صغير

2
00:00:09,290 --> 00:00:13,340
.قد يفقد يوتا عروسه للأبد

3
00:00:16,250 --> 00:00:18,630
ماذا فعلت بحرّاس يوزو؟

4
00:00:18,630 --> 00:00:21,200
.لقد استبدلتهم في الحال

5
00:00:22,230 --> 00:00:26,040
.من الصّعب اكتشاف سحر الفتن

6
00:00:26,040 --> 00:00:28,590
.أشعر ببعض الأسف حيالهم

7
00:00:29,490 --> 00:00:32,090
.لقد سمحوا باقتراب آفات من يوزو

8
00:00:32,860 --> 00:00:36,530
.لو أنّها تأذّت، لكان مصيرهم أسوأ بكثير

9
00:00:37,340 --> 00:00:38,990
كيف حال يوزو؟

10
00:00:39,540 --> 00:00:41,450
.يبدو أنّها هدأت

11
00:00:42,550 --> 00:00:48,560
عزّزتُ قدرات الغولين الأدنَيَيْن
،القتاليّة ليستطيعا حماية يوزو

12
00:00:48,560 --> 00:00:50,970
.لذلك فإنّ قدراتهما على التّواصل قد قلّت

13
00:00:53,460 --> 00:00:56,210
.كان عليّ منحهما القدرة على التّخاطر

14
00:00:56,700 --> 00:01:00,810
تاكاميتشي، أحضر لي جهاز تنصّت
،يشبه قطعة مجوهرات

15
00:01:00,810 --> 00:01:03,210
.لتستطيع يوزو ارتداءه طوال الوقت

16
00:01:03,800 --> 00:01:07,120
.لا أعتقد أنّها ستحبّ ذلك

17
00:01:09,380 --> 00:01:16,240
وبالنّسبة لموضوع انتقال جَدَّيْ
...يوزو-ساما إلى ملحق القصر

18
00:01:17,290 --> 00:01:18,840
رفضا العرض؟

19
00:01:19,340 --> 00:01:22,660
نعم. إنّهما متعلّقان بذلك المنزل
،الّذي عاشا فيه لسنوات

20
00:01:22,660 --> 00:01:26,550
ولا يريدان مغادرة المكان الّذي لديهما
.فيه ذكريات عزيزة مع يوزو-ساما

21
00:01:26,550 --> 00:01:27,730
.فهمت

22
00:01:29,010 --> 00:01:32,490
لا أستطيع الإلحاح أكثر الآن
.بعد هذا الّذي قالاه

23
00:01:33,320 --> 00:01:36,380
.سيكون علينا إذًا وضع حاجز حول منزلهما

24
00:01:37,460 --> 00:01:42,050
،لو أنّي فعلتُ ذلك منذ البداية
.لاستطعتُ حماية يوزو من شعورها بالحزن

25
00:01:42,820 --> 00:01:45,100
.لكنّي فشلت في أخذ تلك الخطوة

26
00:01:45,100 --> 00:01:48,570
.افترضتُ أنّ حرّاسها سيبقونها بأمان

27
00:01:49,960 --> 00:01:52,160
.سأضع الحاجز بنفسي

28
00:01:52,160 --> 00:01:55,440
سأعود إلى القصر بمجرّد إنهاء
.ما تبقّى من عملي

29
00:01:55,970 --> 00:01:58,570
.أخبر يوزو أن تعود إلى المنزل أيضًا

30
00:01:58,570 --> 00:01:59,810
.حاضر يا سيّدي

31
00:02:04,350 --> 00:02:05,570
ماذا؟

32
00:02:06,780 --> 00:02:08,890
!مرحبًا يا رييا-كُن

33
00:02:13,350 --> 00:02:16,430
!اتركاني يا أبي وأمّي

34
00:02:16,940 --> 00:02:20,660
أليست عروسك هنا اليوم؟

35
00:02:20,660 --> 00:02:23,620
.سأحضرها في اليوم الأخير

36
00:02:24,680 --> 00:02:26,350
كم أنا مستعدّة لرؤيتها

37
00:02:26,350 --> 00:02:30,970
ورؤية كم ستُغدق عليها بالحبّ
.عندما تكون موجودة

38
00:02:30,970 --> 00:02:33,220
.نعم، نعم. وأنا أيضًا

39
00:02:33,420 --> 00:02:36,800
.أنا على عجلة من أمري. اتركاني رجاءً

40
00:02:36,800 --> 00:02:38,210
ماذا؟

41
00:02:38,440 --> 00:02:42,470
رييا-كُن على عجلة من أمره
.ليستطيع العودة إلى عروسه

42
00:02:42,650 --> 00:02:45,470
!فعلاً؟ يا للشّباب

43
00:02:45,470 --> 00:02:47,170
.يذكّرني هذا بماضيّ

44
00:02:47,170 --> 00:02:48,590
.لا بدّ أنّهما غارقان في الحبّ

45
00:02:48,590 --> 00:02:50,970
.نعم، نعم. غارقين بالكامل

46
00:02:51,470 --> 00:02:54,730
لماذا هما دائمًا بهذه الحيويّة العالية؟

47
00:02:54,730 --> 00:03:01,480
شخصيّاتنا وطباعنا مختلفة جدًّا، لدرجة
.أنّني ما زلت أتساءل إن كنتُ متبنًّى

48
00:03:02,570 --> 00:03:04,680
.المعذرة، سأستأذنكما الآن

49
00:03:05,120 --> 00:03:09,130
.كن حذرًا ألاّ تُفْتَن على يد ثعلب هذه المرّة

50
00:03:10,510 --> 00:03:15,090
على كبير عشيرة كيريوين التّالي
.أن يكون أفضل من ذلك

51
00:03:17,590 --> 00:03:21,910
يترصّف بشكل سخيف، لكنّه
.لا يزال كبير عشيرة كيريوين

52
00:03:22,340 --> 00:03:28,200
كيريوين سِنيا هو المثال المثاليّ لعبارة
.لا يمكن الحكم على الكتاب من غلافه

53
00:03:31,380 --> 00:03:32,860
.هذا من المسلّمات

54
00:03:42,490 --> 00:03:45,370
"عروس الغول"

55
00:05:04,950 --> 00:05:08,950
"الحلقة التّاسعة: الإدراك الذّاتيّ"

56
00:05:05,900 --> 00:05:07,820
.سأعود قريبًا

57
00:05:07,820 --> 00:05:09,920
.حسنًا، سنكون بانتظارك

58
00:05:09,920 --> 00:05:12,090
.احرصي على إحضار كيريوين-سان معك

59
00:05:12,590 --> 00:05:13,520
.حسنًا

60
00:05:39,760 --> 00:05:42,300
أيقبّلان بعضهما؟

61
00:05:45,440 --> 00:05:46,510
!رييا

62
00:05:47,100 --> 00:05:48,320
.لا

63
00:05:49,130 --> 00:05:50,300
.يوزو

64
00:05:51,070 --> 00:05:52,960
.لا. لا

65
00:05:53,910 --> 00:05:56,960
.قال رييا أنّه يحبّني أنا وحدي

66
00:05:57,590 --> 00:06:00,370
.وكلماته تلك أنقذتني

67
00:06:01,100 --> 00:06:04,900
شعرتُ بالضّياع أحيانًا. لم أصدّق
.أنّي كنت جيّدة بما يكفي

68
00:06:06,660 --> 00:06:08,930
.لكنّ لا شيء من ذلك مهمّ الآن

69
00:06:09,550 --> 00:06:12,000
.لا أريد لأيّ أحد أن يأخذ رييا منّي

70
00:06:23,220 --> 00:06:24,690
!أنا أحبّك يا رييا

71
00:06:26,380 --> 00:06:29,320
ما الّذي دهاك يا يوزو؟

72
00:06:29,610 --> 00:06:31,440
.أنا أحبّك يا رييا

73
00:06:31,440 --> 00:06:32,450
...لذلك

74
00:06:32,780 --> 00:06:36,770
.لذلك أحبّني أنا بدل تاكاميتشي-سان

75
00:06:38,900 --> 00:06:41,330
وما دخل تاكاميتشي في الأمر؟

76
00:06:41,640 --> 00:06:45,710
ألستما... تتواعدان؟

77
00:06:45,710 --> 00:06:47,430
لماذا تقولين هذا؟

78
00:06:47,430 --> 00:06:49,370
هل قال لك أحد ما هذا؟

79
00:06:49,830 --> 00:06:56,290
ساكوراكو-سان. وقالت كارين أنّ الجميع
.في المدرسة يعرفون بالأمر أيضًا

80
00:07:02,620 --> 00:07:04,770
.اتّصل بأوغا وساكوراكو في الحال

81
00:07:06,110 --> 00:07:08,100
.حا-حاضر يا سيّدي

82
00:07:08,100 --> 00:07:12,230
مرحبًا يا أوغا. تعال إلى قصر
!كيريوين مع ساكوراكو في الحال

83
00:07:34,810 --> 00:07:38,010
ظننتِ أنّني وتاكاميتشي نتواعد؟

84
00:07:38,310 --> 00:07:42,260
.هذا ما سمعتُه من ساكوراكو-سان وكارين

85
00:07:42,810 --> 00:07:45,420
.أخبرتك بهذا عدّة مرّات

86
00:07:45,690 --> 00:07:49,930
أنا أحبّك. فعلتُ كلّ ما بوسعي
.لإظهار ذلك لك

87
00:07:50,440 --> 00:07:55,120
لكنّك صدّقتِ كلمات ساكوراكو
وأختك بدل كلماتي؟

88
00:07:55,120 --> 00:07:57,060
...لكن... لكن

89
00:07:57,060 --> 00:08:00,710
.كنتَ تقبّل تاكاميتشي-سان قبل قليل

90
00:08:00,710 --> 00:08:02,880
قبل قليل؟ متى؟

91
00:08:02,880 --> 00:08:05,720
.رأيتكما وأنا في السّيّارة

92
00:08:07,300 --> 00:08:08,960
أواثقة ممّا رأيته؟

93
00:08:09,320 --> 00:08:10,330
ماذا؟

94
00:08:10,580 --> 00:08:14,420
.كان تاكاميتشي يدير ظهره إليك

95
00:08:14,420 --> 00:08:17,260
.لكنّ ذلك ما بدا لي

96
00:08:17,690 --> 00:08:22,430
كان تاكاميتشي يزيل بقعة
.من ربطة عنقي فحسب

97
00:08:23,240 --> 00:08:24,900
...ماذا؟ لكن

98
00:08:25,670 --> 00:08:27,730
.إنّك تتسرّعين في الاستنتاج

99
00:08:28,590 --> 00:08:32,810
،حـ-حتّى لو كنتُ مخطئة بشأن ذلك
.هنالك دليل آخر

100
00:08:34,540 --> 00:08:36,310
.مـ-مثل هذا

101
00:08:39,070 --> 00:08:40,570
.هذا هراء

102
00:08:41,080 --> 00:08:43,200
هراء؟

103
00:08:43,200 --> 00:08:45,450
ما هذا الدّليل؟

104
00:08:45,450 --> 00:08:47,730
التُقطت هذه الصّور لتبدو
.مُضلِّلة عن قصد

105
00:08:48,200 --> 00:08:52,210
.أنا وتاكاميتشي مجرّد مدير وسكرتيره

106
00:08:52,550 --> 00:08:54,940
.لا شيء أكثر، ولا شيء أقلّ

107
00:08:55,620 --> 00:08:56,930
فعلاً؟

108
00:08:56,930 --> 00:08:58,170
.فعلاً

109
00:08:59,700 --> 00:09:02,060
.ما كنتُ لأكذب عليك

110
00:09:03,980 --> 00:09:07,140
.ثقي بالرّجل الّذي وقع في حبّك

111
00:09:07,840 --> 00:09:11,240
.كانت تلك أوّل مرّة تعترفين فيها بحبّك لي

112
00:09:11,900 --> 00:09:14,050
...كا-كان ذلك

113
00:09:14,050 --> 00:09:16,140
أكنتِ تكذبين؟

114
00:09:16,570 --> 00:09:21,220
.لا. أنا أحبّك بالفعل، على ما أظنّ

115
00:09:22,910 --> 00:09:24,860
.لم يكن هنالك داع لذلك الجزء الأخير

116
00:09:34,460 --> 00:09:37,110
.تمكّنتُ أخيرًا من سماع كيف تشعرين

117
00:09:38,460 --> 00:09:41,920
سأكون قاسيًا بلا رحمة من
.الآن فصاعدًا، لذا استعدّي

118
00:09:42,400 --> 00:09:45,880
.لن تستطيعي أن تشكّكي بمشاعري ثانية

119
00:09:46,790 --> 00:09:50,480
.تـ-تهاون معي رجاءً

120
00:09:51,920 --> 00:09:53,070
...رييا

121
00:09:56,060 --> 00:09:57,120
...رييا

122
00:09:57,650 --> 00:10:00,710
.أحبّ رييا

123
00:10:05,250 --> 00:10:09,490
أعتذر عن تصرّف أختي
!ساكوراكو غير اللاّئق

124
00:10:11,290 --> 00:10:15,380
.أخي، لم أفعل أيّ شيء غير لائق

125
00:10:15,380 --> 00:10:19,640
!حمقاء! أخبرتِ عروسه بكلام فارغ

126
00:10:19,640 --> 00:10:22,880
!أخبرتها بالحقيقة فحسب

127
00:10:22,880 --> 00:10:27,270
ساكوراكو، لا أعرف ما الّذي جعلك
،مرتبكة إلى هذا الحدّ

128
00:10:27,270 --> 00:10:30,590
.لكن أنا ورييا-ساما لسنا على علاقة رومانسيّة

129
00:10:30,900 --> 00:10:35,350
.لا بأس يا تاكاميتشي-ساما. أنا أفهم

130
00:10:35,350 --> 00:10:38,670
الجنس والمكانة غير مهمّان
.عندما يتعلّق الأمر بالحبّ

131
00:10:39,240 --> 00:10:40,470
.أوغا

132
00:10:42,280 --> 00:10:45,370
هذا مؤلم يا أخي. ما الّذي تفعله؟

133
00:10:46,450 --> 00:10:49,660
.أرجوك، أغلقي فمك فحسب

134
00:10:49,660 --> 00:10:51,830
.أنت تحرجينني

135
00:10:52,800 --> 00:10:55,710
.ظننتُ أنّك أختٌ جيّدة

136
00:10:55,710 --> 00:10:58,290
.لم أكن أعلم أنّك واهمة لهذه الدّرجة

137
00:10:58,290 --> 00:11:05,190
ساكوراكو-سان، لماذا أنت واثقة جدًّا
من أنّهما على علاقة رومانسيّة؟

138
00:11:05,830 --> 00:11:09,180
.معها حقّ. أظهري بعض الاحترام لرييا-ساما

139
00:11:09,180 --> 00:11:13,930
لستُ متأكّدًا من أنّ ساكوراكو
.هي المسؤولة بالكامل

140
00:11:13,930 --> 00:11:17,570
.أنتما الاثنان تتحمّلان المسؤوليّة أيضًا

141
00:11:17,570 --> 00:11:19,980
كيف نتحمّل المسؤوليّة؟

142
00:11:19,980 --> 00:11:20,940
...حسنًا

143
00:11:20,940 --> 00:11:26,410
يتجاهل رييا-ساما كلّ امرأة
.جميلة تتقرّب منه

144
00:11:26,410 --> 00:11:28,670
.حتّى أنّه يُعامل الرّجال بقسوة أيضًا

145
00:11:29,380 --> 00:11:32,650
.لكنّه يسمح لك وحد بالتّواجد قربه

146
00:11:32,650 --> 00:11:35,840
،حتّى أنّه يتصرّف بلطف معك
...لذلك يظنّ النّاس

147
00:11:35,840 --> 00:11:38,580
!أ-أهذا ما يعتقده النّاس؟

148
00:11:38,580 --> 00:11:42,410
.أخذت بعض الفتيات الأمر على محمل الجدّ

149
00:11:42,760 --> 00:11:47,150
.ويُحزنني القول أنّ أختي واحدة منهنّ

150
00:11:47,150 --> 00:11:49,570
.أنا لا "أصدّق" أيّ شيء. إنّها الحقيقة

151
00:11:49,570 --> 00:11:53,820
.لذلك قرّرتُ حماية علاقتهما

152
00:11:54,060 --> 00:11:58,280
.أنا ورييا-ساما مجرّد مدير وسكرتيره

153
00:11:58,280 --> 00:12:04,230
لكنّك كنت غاضبًا لأنّ عروس رييا-ساما
.لم تكن جيّدة بما يكفي له

154
00:12:04,530 --> 00:12:06,790
!لا علاقة لذلك بهذا

155
00:12:06,790 --> 00:12:09,410
هل أنتما هكذا بالفعل؟

156
00:12:09,820 --> 00:12:13,390
لا، إنّك لا تعير الكثير من الاهتمام
.للآخرين فحسب يا رييا-ساما

157
00:12:13,390 --> 00:12:16,130
.لطالما كانا هكذا

158
00:12:16,130 --> 00:12:21,120
فهمت. ظننتُ أنّ ساكوراكو
.كانت امرأة أكثر حياءً

159
00:12:21,870 --> 00:12:25,290
،سمعتُ أنّه ليس مهتمًّا بالآخرين

160
00:12:25,630 --> 00:12:29,540
.لكن يبدو أنّ هذه مشكلة جدّيّة

161
00:12:30,580 --> 00:12:35,580
هنالك شائعة منتشرة عن الأمر
.في مدرسة ساكوراكو

162
00:12:35,580 --> 00:12:38,260
.لا بدّ أنّها وصلت إلى أختك

163
00:12:38,260 --> 00:12:40,260
.أنا جدّ آسف

164
00:12:40,260 --> 00:12:43,770
.تمّ حلّ سوء الفهم. لا داعي للقلق الآن

165
00:12:43,770 --> 00:12:46,910
.لا، ما فعلته ساكوراكو مشكلة بالفعل

166
00:12:46,910 --> 00:12:49,910
!حتّى أنّه كان لديها هذه

167
00:12:49,910 --> 00:12:53,170
!أخي، إنّها مجموعتي

168
00:12:55,820 --> 00:12:56,830
ما هذه؟

169
00:13:01,430 --> 00:13:05,170
.جعلتْ نادي المانغا في مدرستها يرسم هذه

170
00:13:05,440 --> 00:13:07,530
.إنّها ليست المجموعة كلّها من الأساس

171
00:13:15,170 --> 00:13:17,440
!مجموعتي

172
00:13:20,780 --> 00:13:26,820
،ساكوراكو، مهما كان ما تعتقدينه
.يوزو هي حبّي الوحيد

173
00:13:27,410 --> 00:13:31,480
.أسأتِ فهم ذلك وتسبّب في أذيّة مشاعر يوزو

174
00:13:31,480 --> 00:13:32,910
.لا أكنّ حيالك إلاّ مشاعر الغضب

175
00:13:36,540 --> 00:13:40,000
لا يوجد أيّ شيء بينك وبين
تاكاميتشي-ساما بالفعل؟

176
00:13:45,250 --> 00:13:46,670
.رييا-ساما

177
00:13:47,330 --> 00:13:51,360
.تمّ اختياري لأكون خطيبتك

178
00:13:51,360 --> 00:13:53,450
.اسمي كياما ساكوراكو

179
00:13:53,730 --> 00:13:54,810
.مفهوم

180
00:13:59,160 --> 00:14:02,050
بصفتي خطيبته، كان من واجبي

181
00:14:02,050 --> 00:14:07,990
كشريكة كبير عشيرة كيريوين
.دعم رييا-ساما

182
00:14:09,750 --> 00:14:14,420
حظي رييا-ساما، المثقل بمستقبل
،عائلاتنا منذ الولادة

183
00:14:14,950 --> 00:14:17,830
.بإعجاب العديد من الشّياطين

184
00:14:22,970 --> 00:14:24,170
...ولكن

185
00:14:25,760 --> 00:14:30,110
.أحيانًا، يبدو حزينًا بطريقة ما

186
00:14:34,180 --> 00:14:37,120
.فهمت. هكذا هو الأمر إذًا

187
00:14:38,940 --> 00:14:40,250
.لا تسمحي بتكرار الأمر ثانية

188
00:14:41,570 --> 00:14:42,570
.حاضرة

189
00:14:45,520 --> 00:14:49,710
،يا سيّدتي العروس
أنا جدّ آسفة حيال كلّ ما قلتُه

190
00:14:49,710 --> 00:14:54,710
.وأدّى لإزعاجك بسبب سوء فهمي

191
00:14:57,340 --> 00:14:59,380
.أنا أحبّ رييا

192
00:14:59,880 --> 00:15:06,540
أن أصبح عروسهُ يعني الغوصَ
.في عالم لا أستطيع تخيّله

193
00:15:07,490 --> 00:15:10,720
هل أنا جاهزة لذلك؟

194
00:15:12,550 --> 00:15:18,850
.الجميع لطفاء معي فقط لأنّي عروسه

195
00:15:20,420 --> 00:15:25,710
.لا ألومك لأنّ لديك مشاعر معقّدة حيالي

196
00:15:26,240 --> 00:15:28,980
.ساكوراكو-سان، سلوكك راقٍ

197
00:15:29,460 --> 00:15:34,100
لا بدّ أنّك قد تدرّبتِ كثيرًا
.بصفتك خطيبة رييا

198
00:15:34,770 --> 00:15:40,520
،تاكاميتشي-سان وأوغا-سان
.لقد دعمتما رييا منذ صغركما

199
00:15:40,990 --> 00:15:45,500
راقبتما بكلّ حبٍّ

200
00:15:45,840 --> 00:15:49,460
كبيرة عشيرة كيريوين المستقبليّ
.من أجل صالح رييا

201
00:15:50,630 --> 00:15:55,040
مقارنة بكم، أنا مجرّد بشريّة
.عاديّة بلا أيّ قوى

202
00:15:55,610 --> 00:15:59,500
لا ينبغي أن يكون لي أيّ علاقة
.بمثل هذه العشيرة المذهلة

203
00:15:59,810 --> 00:16:04,420
.لذلك أودّ أن أتعلّم الكثير منكم

204
00:16:05,560 --> 00:16:11,200
عن هذه العشيرة، وعن عادات
.الشّياطين، وعن رييا

205
00:16:11,900 --> 00:16:15,410
.سأبذل جهدي لاكتساب موافقتكم كعروسه

206
00:16:16,200 --> 00:16:19,450
.أقدّر مساعدتكم

207
00:16:22,020 --> 00:16:26,650
.إنها لا تفهم الأمر بالفعل

208
00:16:27,570 --> 00:16:32,450
عاش رييا-ساما تحت ضغط
.متواصل بسبب منصبه

209
00:16:32,960 --> 00:16:37,710
.لا يستطيع أيّ أحد منّا جلب السّكينة لقلبه

210
00:16:39,230 --> 00:16:43,200
.عندما قابلها رييا-ساما، تغيّر بالكامل

211
00:16:44,080 --> 00:16:48,430
إنّها ليست مجرّد بشريّة عاديّة
.بلا أيّ قوى على الإطلاق

212
00:16:49,190 --> 00:16:50,700
هل لأنّها عروسه؟

213
00:16:51,600 --> 00:16:54,880
.لا، أشعر أنّ الأمر أكثر من ذلك

214
00:16:54,880 --> 00:16:56,930
.ربّما هو القدر

215
00:16:57,390 --> 00:17:00,330
.يتمتّع كلاهما بالطّابع نفسه

216
00:17:00,660 --> 00:17:03,100
،يوزو-ساما، الّتي لم تحظى بحبّ والديها يومًا

217
00:17:03,100 --> 00:17:05,710
.ورييا-ساما، الّذي لم يفتح قلبه للآخرين يومًا

218
00:17:06,600 --> 00:17:08,910
اجتمعت روحاهما الوحيدتان

219
00:17:08,910 --> 00:17:13,680
.وكأنّ القدر قد جمع بينهما وتجاوبتا معًا

220
00:17:19,140 --> 00:17:20,340
،يوزو-ساما

221
00:17:21,070 --> 00:17:26,100
.أرجو أنّ تسامحيني على تصرّفي الفظّ

222
00:17:26,100 --> 00:17:28,160
تاكاميتشي-سان؟

223
00:17:29,460 --> 00:17:33,990
.أنت العروس الغالية لعائلة كيريوين

224
00:17:38,260 --> 00:17:42,980
،أنا مسرور لأنّك عروسه
.مع أنّي أكره الاعتراف بذلك

225
00:17:43,740 --> 00:17:49,910
شعرتُ بالغيرة فحسب لأنّ رييا-ساما
.ينظر إليك بلطف شديد

226
00:17:51,740 --> 00:17:55,920
.سنواصل دعمك بكلّ ما في وسعنا

227
00:17:58,760 --> 00:18:02,740
عثر رييا-ساما أخيرًا على مكان
.حيث يمكنه أن يشعر بالسّلام

228
00:18:03,230 --> 00:18:06,570
.وهذا ما توفّره العروس

229
00:18:13,320 --> 00:18:15,150
.صباح الخير

230
00:18:15,350 --> 00:18:16,560
تاكاميتشي-ساما؟

231
00:18:16,560 --> 00:18:19,910
ما الخطب؟ هل تشعر بتوعّك؟

232
00:18:20,490 --> 00:18:24,210
.لا، أنا بخير. لا تقلق عليّ

233
00:18:25,520 --> 00:18:27,500
...رييا، ساعدني! إنّ تاكاميتشي-سان

234
00:18:32,350 --> 00:18:33,370
!أنا آسفة

235
00:18:34,100 --> 00:18:36,080
ماذا عن تاكاميتشي؟

236
00:18:36,080 --> 00:18:38,220
.رييا، ارتدِ بعض الملابس

237
00:18:39,120 --> 00:18:42,630
.نحن حبيبان الآن. لا داعي للخجل

238
00:18:43,360 --> 00:18:45,260
...نعم، لكن

239
00:18:45,720 --> 00:18:50,830
صحيح. سأصطحبك إلى مأدبة
.الشّياطين في اليوم الأخير

240
00:18:50,830 --> 00:18:52,700
ماذا؟ أنا؟

241
00:18:53,440 --> 00:18:56,160
.ستقابلين والديّ

242
00:18:56,160 --> 00:18:58,560
هل أنت متأكّد أنّني سأكون بخير؟

243
00:18:58,560 --> 00:19:00,890
.لا تقلقي. سأكون معك

244
00:19:01,700 --> 00:19:02,550
.حسنًا

245
00:19:03,080 --> 00:19:04,670
...تذكّرت

246
00:19:04,910 --> 00:19:06,680
.تاكاميتشي-سان في مشكلة

247
00:19:06,680 --> 00:19:08,470
.بدا شاحبًا جدًّا

248
00:19:08,470 --> 00:19:09,710
.سأغادر الآن

249
00:19:11,170 --> 00:19:13,240
.يا إلهي

250
00:19:14,100 --> 00:19:17,150
.عاقب رييا-ساما تاكاميتشي-سان

251
00:19:17,380 --> 00:19:18,890
عاقبه؟

252
00:19:18,890 --> 00:19:24,630
أتتذكّرين عندما وشت ساكوراكو به
لأنّه اشتكى منك من وراء ظهرك؟

253
00:19:25,210 --> 00:19:28,040
.ظننتُ أنّ الأمر قد حُلّ سلفًا

254
00:19:28,040 --> 00:19:32,150
قد تكونين لطيفة بما يكفي
.لتسامحيه، لكنّ رييا-ساما لن يفعل

255
00:19:32,150 --> 00:19:36,400
كيف عُوقِب تاكاميتشي-سان؟

256
00:19:36,790 --> 00:19:39,940
.من الأفضل لك ألاّ تعرفي بعض الأمور

257
00:19:39,940 --> 00:19:41,020
ماذا؟

258
00:19:41,300 --> 00:19:45,580
.لا تزال هناك جوانب أخرى لرييا لا أعرفها

259
00:19:47,890 --> 00:19:49,790
.سأذهب إلى المنزل

260
00:19:49,790 --> 00:19:51,050
.كارين

261
00:19:51,050 --> 00:19:52,790
.لقد طفح الكيل

262
00:19:52,790 --> 00:19:56,560
سأفقد صوابي إن بقيتُ حبيسة
.غرفتي طوال اليوم

263
00:19:56,560 --> 00:19:58,900
كارين، كم مرّة عليّ أن أقول لك هذا؟

264
00:19:58,900 --> 00:20:00,960
.نحن تحت الإقامة الجبريّة

265
00:20:01,370 --> 00:20:05,480
هل تقول أنّ ناديشيكو-ساما أهمّ منّي؟

266
00:20:05,480 --> 00:20:07,550
ألا تهتمّ لأمري؟

267
00:20:07,830 --> 00:20:09,460
.أنا أكره هذا المكان

268
00:20:09,460 --> 00:20:12,250
.ينظر الجميع إليّ بازدراء

269
00:20:12,250 --> 00:20:15,170
.كنت أظنّ أنّ العرائس يُفترض أن يُقدَّرن

270
00:20:16,570 --> 00:20:19,460
.كارين، أنا أحبّك

271
00:20:20,420 --> 00:20:23,170
.أتمنّى لو أستطيع تحقيق كلّ رغباتك

272
00:20:23,510 --> 00:20:29,330
لكن لا يمكننا البقاء في عشيرة الشّياطين
.الثّعالب إذا عصينا ناديشيكو-ساما

273
00:20:29,330 --> 00:20:31,400
.تحلّي بالصّبر حاليًّا لو سمحت

274
00:20:34,410 --> 00:20:35,550
!كارين

275
00:20:38,970 --> 00:20:39,940
.كارين

276
00:20:40,850 --> 00:20:45,340
.أبي، أمّي. جئتما لأخذي لأنّكما كنتما قلقين

277
00:20:45,340 --> 00:20:47,970
.اسمعا، هذا المنزل فظيع

278
00:20:47,970 --> 00:20:51,590
.أنا سعيد لأنّنا وجدناك
هل يمكنك الاعتذار ليوزو؟

279
00:20:51,970 --> 00:20:52,970
ماذا؟

280
00:20:53,860 --> 00:20:56,270
.قطعت عشيرة كوغيتسو علاقتها بنا

281
00:20:56,710 --> 00:21:00,350
.وفوق ذلك، طُلب منّا الرّحيل بعيدًا

282
00:21:00,350 --> 00:21:05,360
أنا متأكّدة أنّ يوزو ستُقنع
.كيريوين-ساما بالصّفح عنّا

283
00:21:05,780 --> 00:21:07,030
.مستحيل

284
00:21:07,030 --> 00:21:10,550
لماذا عليّ الاعتذار لها؟

285
00:21:11,450 --> 00:21:14,480
.أنتِ أنانيّة دائمًا

286
00:21:14,480 --> 00:21:19,630
ما كانت عشيرة كوغيتسو لتتخلّى
.عنّا لو كنتِ أكثر نضجًا

287
00:21:19,970 --> 00:21:21,820
.على أيّ حال يا عزيزتي، أعطيه لها

288
00:21:21,820 --> 00:21:22,520
.حسنًا

289
00:21:24,320 --> 00:21:25,640
.هذا اعتذار مكتوب

290
00:21:25,990 --> 00:21:28,370
.إذا رأيتِ يوزو، أعطيها هذا رجاءً

291
00:21:28,890 --> 00:21:31,260
.هل فهمتِ؟ أراكِ لاحقًا

292
00:21:36,390 --> 00:21:37,380
...كارين

293
00:21:43,660 --> 00:21:45,560
!كارين، اهدئي

294
00:21:45,560 --> 00:21:46,960
!سُحقًا لهذا

295
00:21:46,960 --> 00:21:51,280
!أبي وأمّي يهتّمان الآن بأختي فقط

296
00:21:51,910 --> 00:21:57,540
.اعتنَيا بي جيّدًا وتفاخرا بي أمام الجميع

297
00:21:57,540 --> 00:22:02,650
.كنتَ لطيفًا معي وفعلتَ كلّ ما طلبته

298
00:22:02,650 --> 00:22:05,640
.لكن الآن، لا تفعل شيئًا من أجلي

299
00:22:07,000 --> 00:22:10,580
انقلب كلّ شيء رأسًا على عقب
.منذ أن اختيرت أختي كعروس

300
00:22:10,820 --> 00:22:12,550
.إنّها عاديّة

301
00:22:13,520 --> 00:22:16,230
.ليست مميّزة مثلي

302
00:22:18,120 --> 00:22:19,970
.هذا خطؤها

303
00:22:20,890 --> 00:22:23,650
.كلّ هذا خطأ أختي