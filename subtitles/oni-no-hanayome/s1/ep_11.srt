1
00:00:00,310 --> 00:00:02,090
.هيّا يا كارين. من هنا

2
00:00:06,210 --> 00:00:09,110
.كارين

3
00:00:25,500 --> 00:00:26,750
!كارين

4
00:00:44,780 --> 00:00:46,390
.هذا دافئ جدًّا

5
00:01:00,380 --> 00:01:02,260
هل أنت بخير يا يوزو؟

6
00:01:04,620 --> 00:01:07,040
.نعم، أنا بخير

7
00:01:14,730 --> 00:01:17,160
.كلّ هذا بسببها

8
00:01:18,930 --> 00:01:21,580
.إنّه خطؤها

9
00:01:23,810 --> 00:01:26,300
.أنت فتاة مختارة

10
00:01:28,790 --> 00:01:31,660
.نحن فخوران بك جدًّا

11
00:01:33,240 --> 00:01:37,310
.كارين-تشان، أنت عروسي

12
00:03:13,640 --> 00:03:16,370
.كانت الدّلافين رائعة

13
00:03:16,710 --> 00:03:19,230
ألم يكن ذلك ممتعًا يا أختي؟

14
00:03:19,230 --> 00:03:20,210
.نعم

15
00:03:20,610 --> 00:03:23,300
.انظري، هناك متجر

16
00:03:25,810 --> 00:03:28,800
.هذا ظريف. أنا أريده

17
00:03:28,800 --> 00:03:31,310
.عزيزتي، إنّه باهظ الثّمن

18
00:03:31,760 --> 00:03:35,120
.اشترِه لي. أرجوك يا أبي

19
00:03:35,460 --> 00:03:38,220
.تعرفين جيّدًا كيف تطلبين الأشياء يا كارين

20
00:03:38,220 --> 00:03:39,820
.حسنًا، لنشترِه

21
00:03:39,820 --> 00:03:41,290
!مرحى

22
00:03:41,290 --> 00:03:43,580
.أنت تدلّلها كثيرًا، كما تعلم

23
00:03:44,110 --> 00:03:45,830
.كم هذا ظريف

24
00:03:45,830 --> 00:03:48,640
.أمّي، أريد هذا

25
00:03:48,640 --> 00:03:53,730
.ماذا تقولين؟ تعلمين أنّه لا يمكننا تحمّل تكلفته

26
00:03:53,730 --> 00:03:55,590
...ماذا؟ لكن

27
00:03:59,120 --> 00:04:02,510
.أنت الأخت الكبرى يا يوزو
.تحمّلي الأمر

28
00:04:03,900 --> 00:04:06,220
.حسنًا

29
00:04:06,520 --> 00:04:11,020
هذا غريب. كان ينبغي أن تحصل
.هي أيضًا على شيء ما

30
00:04:11,350 --> 00:04:12,800
صحيح يا أبي؟

31
00:04:12,800 --> 00:04:15,490
.نعم، أكيد

32
00:04:18,440 --> 00:04:21,440
.أريد تناول هذا

33
00:04:21,440 --> 00:04:24,090
.تبدو هذه الشّطيرة لذيذة أيضًا

34
00:04:24,090 --> 00:04:25,700
.إذًا أريدها أيضًا

35
00:04:26,320 --> 00:04:28,460
.أنتِ تحبّين الشّطائر حقًّا

36
00:04:28,460 --> 00:04:29,330
.نعم

37
00:04:29,590 --> 00:04:32,690
ماذا ستطلبين يا أختي؟

38
00:04:33,230 --> 00:04:37,070
.سأطلب... عصير برتقال

39
00:04:38,040 --> 00:04:39,570
ولا شيء آخر؟

40
00:04:48,000 --> 00:04:50,260
.يا له من زيٍّ مدرسيّ ظريف

41
00:04:50,260 --> 00:04:53,600
.هذه تلميذة من أكاديميّة كاكورييو

42
00:04:53,600 --> 00:04:55,560
أكاديميّة كاكورييو؟

43
00:04:55,560 --> 00:04:59,100
.نعم. إنّها مدرسة للشّياطين

44
00:04:59,100 --> 00:05:01,800
ما الشّياطين؟

45
00:05:01,800 --> 00:05:05,610
.أشخاصٌ مذهلون يختلفون عن البشر

46
00:05:05,990 --> 00:05:08,570
أشخاصٌ مذهلون؟

47
00:05:13,170 --> 00:05:17,420
أبي، أمّي، أريد الذّهاب
.إلى أكاديميّة كاكورييو أيضًا

48
00:05:17,420 --> 00:05:21,890
.أريد ارتداء ذلك الزّيّ الظّريف
هل يمكنني ذلك؟

49
00:05:21,890 --> 00:05:22,670
ماذا؟

50
00:05:22,670 --> 00:05:23,990
...إنّ ذلك

51
00:05:25,720 --> 00:05:28,910
.عزيزي، عليك أن تكون صريحًا معها

52
00:05:29,350 --> 00:05:32,860
،الأمر ليس مستحيلاً
.لكنّنا لا نملك المال الكافي حقًّا

53
00:05:32,860 --> 00:05:35,520
.نـ-نعم، أعلم ذلك

54
00:05:35,520 --> 00:05:37,650
ألا يمكنني؟

55
00:05:37,650 --> 00:05:42,510
.كارين، من الصّعب ولوج أكاديميّة كاكورييو

56
00:05:42,510 --> 00:05:49,510
،يرغب الكثيرون في لقاء الشّياطين
.لذا فالمنافسة شديدة للغاية

57
00:05:49,510 --> 00:05:53,040
قد يكون الأمر صعبًا بعض
.الشّيء بالنّسبة لك

58
00:05:53,040 --> 00:05:54,830
ماذا...؟

59
00:06:09,770 --> 00:06:13,840
يا كارين، هناك مدارس أخرى
.ذات أزياء مشابهة

60
00:06:13,840 --> 00:06:15,470
.قد تكون إحداها خيارًا أفضل

61
00:06:15,470 --> 00:06:17,090
.انتظر يا عزيزي

62
00:06:17,090 --> 00:06:18,020
ماذا؟

63
00:06:18,020 --> 00:06:21,500
.كارين ظريفة للغاية

64
00:06:21,500 --> 00:06:25,390
.قد يتمّ اختيارها لتكون عروسًا

65
00:06:25,880 --> 00:06:27,140
عروس؟

66
00:06:28,160 --> 00:06:31,810
.صحيح. ربّما تمتلك المؤهّلات اللاّزمة

67
00:06:31,810 --> 00:06:37,370
بالضّبط. لِمَ لا نعتبر هذا
استثمارًا في مستقبلنا؟

68
00:06:37,610 --> 00:06:43,720
بمجرّد أن تصبح كارين عروسًا، يمكننا
.الحصول على دعم ماليّ من عائلة عريسها

69
00:06:43,720 --> 00:06:48,440
.لن نضطرّ عندها للمعاناة بعد الآن

70
00:06:50,700 --> 00:06:55,630
كارين، هل ترغبين حقًّا
في الالتحاق بأكاديميّة كاكورييو؟

71
00:06:55,630 --> 00:06:56,820
.نعم

72
00:06:56,820 --> 00:07:00,150
.سيتعيّن عليك الدّراسة بجدّ كبير

73
00:07:00,150 --> 00:07:04,520
.أستطيع فعل ذلك. سأدرس كثيرًا

74
00:07:07,510 --> 00:07:11,450
.ستكونين مشغولةً جدًّا يا كارين

75
00:07:11,740 --> 00:07:12,900
.حسنًا

76
00:07:43,570 --> 00:07:46,050
.أبليتِ بلاءً حسنًا يا كارين

77
00:07:46,050 --> 00:07:51,050
.حقًّا؟ لقد أجبتِ بكلّ ثقة

78
00:07:51,550 --> 00:07:56,470
كمكافأة، دعينا نتناول الغداء
.في الخارج قبل العودة إلى المنزل

79
00:07:56,470 --> 00:07:57,570
.حسنًا

80
00:07:57,570 --> 00:08:02,830
هل ستكون أختي بخير وحدها في المنزل؟

81
00:08:02,830 --> 00:08:08,130
ستكون بخير. بقايا طعام
.الأمس موجودة في الثّلاّجة

82
00:08:09,230 --> 00:08:13,260
.أنت أكثر أهمّيّة الآن
.لا داعي للقلق حيالها

83
00:08:13,260 --> 00:08:16,600
والآن، ماذا تريدين أن تأكلي؟
.سنطلب أيّ شيء ترغبين به

84
00:08:16,600 --> 00:08:18,570
أيّ شيء؟

85
00:08:18,570 --> 00:08:22,840
في هذه الحالة، أريد شريحة
...هامبورغ وعجّة بالأرزّ و

86
00:08:29,690 --> 00:08:32,600
!لقد نجحتِ! أحسنتِ يا كارين

87
00:08:32,600 --> 00:08:34,860
!بذلتِ جهدًا كبيرًا

88
00:08:35,220 --> 00:08:37,750
.لنحتفل

89
00:08:39,650 --> 00:08:41,680
أين حصّة أختي؟

90
00:08:42,360 --> 00:08:44,230
.عذرًا، نسيتُ تمامًا

91
00:08:44,230 --> 00:08:45,490
حقًّا؟

92
00:08:45,490 --> 00:08:48,750
.يمكننا إحضار شيء ليوزو لاحقًا

93
00:08:49,910 --> 00:08:52,880
.ما الأمر؟ لنأكل

94
00:08:54,510 --> 00:08:57,120
!كارين، تهانينا على القبول

95
00:08:57,120 --> 00:09:00,020
!نحن فخوران بك جدًّا

96
00:09:01,140 --> 00:09:04,200
.شكرًا يا أبي وأمّي

97
00:09:08,020 --> 00:09:09,880
.تبدين رائعة

98
00:09:09,880 --> 00:09:12,900
.إنّه يليق بك يا كارين

99
00:09:15,810 --> 00:09:18,990
.أختي، يوجد ثقب في جوربك

100
00:09:20,500 --> 00:09:24,740
،لا يزال بإمكانك ارتداؤه
أليس كذلك يا يوزو؟

101
00:09:26,320 --> 00:09:27,360
.نعم

102
00:09:28,400 --> 00:09:31,080
هل أنت مريضة؟

103
00:09:31,730 --> 00:09:32,950
.لا

104
00:09:33,700 --> 00:09:36,920
.ابتسمي إذًا. هيّا

105
00:09:41,740 --> 00:09:44,670
.يوزو فتاة كئيبة للغاية

106
00:09:44,670 --> 00:09:48,770
.نعم. إنّها تختبئ دائمًا في الزّاوية

107
00:10:19,100 --> 00:10:21,340
أنت كارين-تشان، أليس كذلك؟

108
00:10:21,870 --> 00:10:26,830
من أنت؟ وكيف تعرف اسمي؟

109
00:10:27,220 --> 00:10:28,980
.أنا كوغيتسو يوتا

110
00:10:29,490 --> 00:10:31,060
.أنا شيطانٌ ثعلب

111
00:10:31,540 --> 00:10:33,610
شيطانٌ ثعلب؟

112
00:10:33,840 --> 00:10:37,460
.رأيتك أثناء المقابلات

113
00:10:37,460 --> 00:10:42,850
،استغرق الأمر بعض الوقت
.لكنّني أدركتُ شيئًا

114
00:10:42,850 --> 00:10:44,000
أدركتَ ماذا؟

115
00:10:45,020 --> 00:10:49,290
.كارين-تشان، أنت عروسي

116
00:10:50,800 --> 00:10:52,140
عروس؟

117
00:10:52,140 --> 00:10:53,810
لعشيرة كوغيتسو؟

118
00:10:55,560 --> 00:10:58,550
.كنّا محقّين

119
00:10:58,550 --> 00:11:04,510
أجل. كنتُ أعلم أنّ كارين
.ستُختار لتكون العروس

120
00:11:04,960 --> 00:11:07,210
ما العروس؟

121
00:11:07,590 --> 00:11:09,390
...حسنًا

122
00:11:10,550 --> 00:11:13,350
.ذلك يعني أنّني أحبّك أكثر من أيّ شخص آخر

123
00:11:15,420 --> 00:11:17,070
...إذًا يا كارين-تشان

124
00:11:17,920 --> 00:11:20,360
هل تقبلين أن تكوني عروسي؟

125
00:11:21,040 --> 00:11:22,330
.نعم

126
00:11:26,460 --> 00:11:29,640
.اعتنِ بي جيّدًا يا يوتا-كُن

127
00:11:43,050 --> 00:11:46,510
.تشرّفت بلقائكم. أنا شينونومي كارين

128
00:11:52,560 --> 00:11:54,870
.يا لها من فتاة ظريفة

129
00:11:54,870 --> 00:11:57,060
.بالفعل

130
00:12:08,460 --> 00:12:11,540
يوتا-كُن، من هذه؟

131
00:12:11,540 --> 00:12:13,020
.ناديشيكو-ساما

132
00:12:13,880 --> 00:12:17,190
.إنّها أهمّ شيطانةٍ ثعلب

133
00:12:22,980 --> 00:12:26,260
.ناديشيكو-ساما، هذه هي عروسي

134
00:12:26,690 --> 00:12:28,710
.يسرّها التّعرّف عليك

135
00:12:30,810 --> 00:12:31,820
.فهمت

136
00:12:32,100 --> 00:12:35,980
أتمنّى أن تكوني عروسًا مخلصة
.لعشيرة كوغيستو

137
00:12:45,150 --> 00:12:46,980
.يوتا-كُن

138
00:12:46,980 --> 00:12:49,310
.لا بأس يا كارين-تشان

139
00:12:50,100 --> 00:12:51,680
.سيّدتي العروس

140
00:12:53,210 --> 00:12:55,820
.هناك مأدبة بعد قليل

141
00:12:55,820 --> 00:12:58,290
.ويمكن لوالديك الانضمام إلينا أيضًا

142
00:13:15,770 --> 00:13:17,480
.نعم يا كارين

143
00:13:17,480 --> 00:13:19,950
.أنت فتاة مختارة

144
00:13:21,070 --> 00:13:23,750
.عذرًا يا سيّدتي العروس

145
00:13:29,570 --> 00:13:32,230
.إنّها جميلة حقًّا

146
00:13:32,230 --> 00:13:34,700
.عشيرة كوغيستو في أمان الآن

147
00:13:37,060 --> 00:13:38,980
.عذرًا يا سيّدتي العروس

148
00:13:38,980 --> 00:13:41,120
.أنت فتاة مختارة

149
00:13:43,410 --> 00:13:45,580
.أنا فتاة مختارة

150
00:13:54,750 --> 00:13:59,370
.أرى ذلك. نعم، فهمت

151
00:14:01,890 --> 00:14:05,030
.يطلب خالك المال مجدّدًا

152
00:14:05,030 --> 00:14:07,320
هل هو فقير لتلك الدّرجة؟

153
00:14:07,630 --> 00:14:10,670
.أمّي، أريد شيئًا لآكله

154
00:14:11,230 --> 00:14:13,770
.هناك ذلك البودينغ الّذي أحضرناه

155
00:14:16,550 --> 00:14:23,090
أمّي، أودّ الذّهاب إلى حديقة
.الحيوان هذا الأحد

156
00:14:23,090 --> 00:14:25,890
حديقة الحيوان؟ ولماذا؟

157
00:14:25,890 --> 00:14:29,850
.عفوًا، لأنّ يوم الأحد هو عيد ميلادي

158
00:14:29,850 --> 00:14:34,100
ماذا؟ أنا لا أريد الذّهاب
.إلى حديقة الحيوان

159
00:14:34,100 --> 00:14:36,860
.أمّي، أسرعي بإحضار البودينغ

160
00:14:36,860 --> 00:14:40,350
إذا كانت كارين لا ترغب في الذّهاب
.إلى حديقة الحيوان، فلن نذهب

161
00:14:41,240 --> 00:14:42,430
...لكن

162
00:14:42,430 --> 00:14:44,510
كم مرّة أخبرتك بذلك؟

163
00:14:44,510 --> 00:14:49,440
نحن نعيش بهذه الطّريقة فقط
.لأنّ كارين عروس

164
00:14:49,860 --> 00:14:53,320
.عليكِ أن تكوني ممتنّة لها

165
00:15:00,200 --> 00:15:05,450
ألا تدرك بعد أنّنا نملك كلّ هذا بفضلي؟

166
00:15:08,400 --> 00:15:11,640
.أمي، زيارة الصّفّ غدًا

167
00:15:11,640 --> 00:15:15,320
لا أستطيع الذّهاب. زيارة
.صفّ كارين في ذلك اليوم

168
00:15:15,320 --> 00:15:18,830
ألا تعرفين جدول مواعيدي؟

169
00:15:23,400 --> 00:15:25,220
.حرارتي مرتفعة

170
00:15:25,220 --> 00:15:28,230
.أمّي، أبي

171
00:15:33,270 --> 00:15:37,820
.كارين، ماذا تفعلين؟ علينا الذّهاب

172
00:15:38,500 --> 00:15:41,930
.قالت أختي أنّ حرارتها مرتفعة

173
00:15:41,930 --> 00:15:44,470
.نعم، إنّها مصابة بالحمّى

174
00:15:44,470 --> 00:15:46,580
أعطيتِها الدّواء، أليس كذلك؟

175
00:15:46,580 --> 00:15:49,590
نعم. لا يمكننا السّماح لها بنقل
.العدوى إلى كارين

176
00:15:50,040 --> 00:15:52,190
.ابتعدي عنها

177
00:15:53,000 --> 00:15:57,190
،على أيّ حال، من الأفضل أن نغادر
.وإلاّ سنتأخّر عن الحفل الموسيقيّ

178
00:15:57,490 --> 00:15:59,290
.هيّا بنا يا كارين

179
00:15:59,770 --> 00:16:01,040
.حسنًا

180
00:16:05,610 --> 00:16:07,520
ما الّذي تفعلانه؟

181
00:16:08,220 --> 00:16:12,280
كيف يمكنكما تجاهل يوزو
وهي تعاني بوضوح؟

182
00:16:12,510 --> 00:16:16,590
.كارين ليست ابنتكما الوحيدة

183
00:16:16,590 --> 00:16:21,750
.نحن نعلم ذلك، لكنّ كارين عروس

184
00:16:22,030 --> 00:16:24,740
.من الطّبيعيّ أن نمنحها الأولويّة

185
00:16:24,740 --> 00:16:29,520
.نعم، ويوزو فتاة عاقلة ومتّزنة. إنّها بخير

186
00:16:30,710 --> 00:16:34,360
عاقلة ومتّزنة؟

187
00:16:37,590 --> 00:16:40,580
.نعم، هذا صحيح

188
00:16:46,860 --> 00:16:49,450
.أهلاً بك يا سيّدتي العروس

189
00:16:49,820 --> 00:16:53,440
.مِن هنا. يوتا-ساما في غرفته

190
00:16:54,970 --> 00:17:00,200
.اسمعي، اسمي كارين كما تعلمين
.ناديني باسمي فحسب

191
00:17:00,200 --> 00:17:03,120
.لكنّك عروس يا سيّدتي العروس

192
00:17:03,870 --> 00:17:07,870
إذًا ماذا كنت ستنادينني لو لم أكن عروسًا؟

193
00:17:08,810 --> 00:17:11,020
.يا له من كلام سخيف

194
00:17:11,020 --> 00:17:15,630
من ليست عروسًا لن تكون
.موضع ترحيب هنا

195
00:17:19,430 --> 00:17:23,750
.يوتا، أريد أن نقضي المزيد من الوقت معًا

196
00:17:24,200 --> 00:17:26,260
.وأنا كذلك يا كارين

197
00:17:27,150 --> 00:17:28,890
.أشعر بالقلق

198
00:17:28,890 --> 00:17:31,320
.لكن لا يوجد سبب يدعوك للقلق

199
00:17:31,920 --> 00:17:35,640
.ستحظين بي إلى الأبد

200
00:17:37,400 --> 00:17:41,150
.شكرًا لك. أحبّك يا يوتا

201
00:17:41,150 --> 00:17:43,040
.وأنا أحبّك يا كارين

202
00:17:45,410 --> 00:17:49,920
.كانت تلك أوقاتًا عصيبة

203
00:17:49,920 --> 00:17:54,910
اضطررنا لطلب المساعدة من
.أقاربنا لإلحاقك بالأكاديميّة

204
00:17:55,160 --> 00:18:01,680
بالتّأكيد. فعلنا ذلك من أجلك
.لكنّ الأمر جرح كبرياءنا

205
00:18:01,880 --> 00:18:04,530
كم مرّة سمعتُ هذا الكلام؟

206
00:18:04,530 --> 00:18:08,630
.سدّد يوتا ديونهم منذ زمن بعيد

207
00:18:11,230 --> 00:18:13,960
.شكرًا لكما يا أبي وأمّي

208
00:18:13,960 --> 00:18:16,040
.لا ​​بأس

209
00:18:16,040 --> 00:18:22,010
،على أيّة حال، عندما يأتي يوتا-كُن لزيارتنا
هل يمكنك إخباره بأنّنا بحاجة إلى بعض المال؟

210
00:18:22,720 --> 00:18:24,150
هل يمكنك فعل ذلك؟

211
00:18:25,220 --> 00:18:26,740
.حسنًا

212
00:18:31,340 --> 00:18:33,500
،الأمر يسبّب التّوتّر

213
00:18:33,500 --> 00:18:38,480
،لكن بصفتي العروس
.فأنا من تُعيل هذه العائلة

214
00:18:40,790 --> 00:18:41,980
.كارين

215
00:18:42,850 --> 00:18:45,790
ماذا تفعلين هنا؟

216
00:18:45,790 --> 00:18:48,090
.لم أستطع الانتظار لرؤيتك

217
00:18:48,790 --> 00:18:50,360
.وأنا أيضًا اشتقت إليك

218
00:18:53,680 --> 00:18:55,610
.اسمع يا يوتا

219
00:18:55,930 --> 00:19:00,810
قال والداي أنّهما بحاجة
.للمزيد من المال هذا الشّهر

220
00:19:01,680 --> 00:19:02,490
.أنا آسف

221
00:19:03,370 --> 00:19:07,070
.أنا آسف لأنّك اضطررت لذكر ذلك

222
00:19:07,070 --> 00:19:11,680
.أنا شخص سيّئ لأنّني تسبّبت في حزن عروسي

223
00:19:15,210 --> 00:19:19,760
.يوتا... إنّه دائمًا دافئ المشاعر

224
00:19:20,800 --> 00:19:26,860
،ربّما يمكنني فعل أيّ شيء
.وسيغفر لي يوتا

225
00:19:29,840 --> 00:19:32,140
.لا تغضبي هكذا يا كارين

226
00:19:32,140 --> 00:19:36,370
لكنّني قطعت كلّ هذه المسافة
.لألقي التّحيّة، ولم أستطع رؤيتها

227
00:19:36,370 --> 00:19:40,640
.ما باليد حيلة
.ناديشيكو-ساما مشغولة

228
00:19:49,500 --> 00:19:50,980
.إنّهن جميلات للغاية

229
00:19:52,050 --> 00:19:54,170
.لكنّني جميلة أيضًا

230
00:19:55,030 --> 00:19:58,200
سينظر إليّ النّاس باحتقار
.إن تهاونتُ ولو قليلاً

231
00:19:58,570 --> 00:20:01,050
.عليّ أن أبدو جميلة طوال الوقت

232
00:20:03,610 --> 00:20:07,370
.أنا عروس يوتا

233
00:20:08,820 --> 00:20:12,440
.هذا صحيح. أنا المختارة

234
00:20:13,510 --> 00:20:15,810
.لستُ مثل أختي

235
00:20:18,740 --> 00:20:21,360
.لستُ مثلها

236
00:20:32,250 --> 00:20:34,070
...أختي

237
00:20:37,450 --> 00:20:39,890
لماذا هي؟

238
00:20:41,580 --> 00:20:46,010
لماذا؟

239
00:20:53,250 --> 00:20:54,680
لماذا؟

240
00:20:55,680 --> 00:20:58,350
!كارين

241
00:21:03,880 --> 00:21:05,330
!يوتا

242
00:21:09,560 --> 00:21:11,190
...يا إلهي

243
00:21:12,050 --> 00:21:13,700
.كان خطأ فادحًا

244
00:21:16,010 --> 00:21:17,610
.بالفعل

245
00:21:20,870 --> 00:21:22,080
.يوتا

246
00:21:23,330 --> 00:21:26,460
.تلك الفتاة لم تعد عروسك

247
00:21:27,260 --> 00:21:31,230
.أنا، بصفتي كبيرة العشيرة، لا أقبل بها

248
00:21:39,500 --> 00:21:41,230
يـ-يوتا؟

249
00:21:42,030 --> 00:21:44,600
لماذا يا كارين؟

250
00:21:45,560 --> 00:21:50,640
.أخبرتك مرارًا وتكرارًا أن تبتعدي عن أختك

251
00:21:51,410 --> 00:21:55,490
!كان عليك ذلك، وإلاّ فلن نكون معًا

252
00:21:56,350 --> 00:22:02,740
...لكنّها أفسدت كلّ شيء، ولذا أنا

253
00:22:03,560 --> 00:22:05,160
.أنا آسفة يا يوتا

254
00:22:05,160 --> 00:22:07,780
الأمر لا يستحقّ البكاء، مفهوم؟

255
00:22:08,330 --> 00:22:10,020
.لن أفعل ذلك مجدّدًا

256
00:22:10,540 --> 00:22:12,830
.لقد فات الأوان

257
00:22:14,130 --> 00:22:15,080
...لم

258
00:22:16,520 --> 00:22:18,350
...لم تعودي

259
00:22:19,650 --> 00:22:21,380
.عروسي

260
00:22:22,980 --> 00:22:24,040
ماذا؟