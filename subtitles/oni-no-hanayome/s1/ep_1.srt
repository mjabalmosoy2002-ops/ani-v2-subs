1
00:00:23,460 --> 00:00:26,760
اندلعت حرب عظيمة بين الأمم
،في جميع أنحاء العالم

2
00:00:27,330 --> 00:00:32,240
.خلّفت مآسي وأحزانًا عظيمة

3
00:00:34,060 --> 00:00:39,250
،وبينما كان اليأس يعمّ الجميع
أنقذ العالمَ شياطينٌ

4
00:00:39,250 --> 00:00:43,790
.كانوا يعيشون في الظّلّ بين البشر

5
00:00:47,740 --> 00:00:50,570
ظهروا إلى النّور

6
00:00:50,570 --> 00:00:53,590
،بجمالهم الآسر وقدراتهم الخارقة للطّبيعة

7
00:00:53,590 --> 00:00:59,850
الّتي كان لها دور كبير في إعادة
.بناء اليابان بعد الحرب

8
00:01:02,000 --> 00:01:03,710
،والآن، في الوقت الحاضر

9
00:01:04,870 --> 00:01:11,750
تتغلغل الشّياطين في السّياسة والمال

10
00:01:11,750 --> 00:01:15,650
.والتّرفيه وغيرها من المجالات

11
00:01:24,480 --> 00:01:29,670
.وأحيانًا، يتّخذ الشّياطين عرائس من البشر

12
00:01:30,900 --> 00:01:35,460
،بالنّسبة لهؤلاء الشّياطين
.تُعدّ عرائسهم كنوزًا لا مثيل لها

13
00:01:35,460 --> 00:01:40,410
ولأنّ هؤلاء العرائس قيّمات
،ومُدلّلاتٌ للغاية

14
00:01:40,890 --> 00:01:45,970
.تحلم كلّ امرأة بشريّة بالزّواج من شيطان

15
00:01:53,290 --> 00:01:57,000
.لكن لا يُختار إلاّ عدد قليل منهنّ

16
00:01:57,420 --> 00:02:00,150
،وفي هرميّة الشّياطين

17
00:02:00,150 --> 00:02:04,060
.يُعتبر الغيلان الأقوى والأجمل

18
00:02:04,590 --> 00:02:11,240
وأعظم شرفٍ يمكن أن تناله امرأة
.هو أن تُختار عروسًا لغول

19
00:02:12,030 --> 00:02:14,930
.آسف يا يوزو، لننفصل

20
00:02:15,340 --> 00:02:16,140
ماذا؟

21
00:02:17,370 --> 00:02:21,710
.لماذا؟ لم نواعد بعضنا إلاّ لثلاثة أشهر

22
00:02:22,020 --> 00:02:24,120
.وقعتُ في حبّ فتاة أخرى

23
00:02:25,430 --> 00:02:26,700
.كارين-تشان

24
00:02:27,700 --> 00:02:28,700
...كارين

25
00:02:30,460 --> 00:02:34,020
كارين؟ لماذا هي؟ ولماذا الآن؟

26
00:02:34,670 --> 00:02:38,140
.قابلتها في منزلك قبل أيّام

27
00:02:38,140 --> 00:02:40,110
.كان حبًّا من النّظرة الأولى

28
00:02:41,590 --> 00:02:43,330
لماذا كارين؟

29
00:02:44,330 --> 00:02:46,580
.إنّها عروس

30
00:02:47,940 --> 00:02:50,340
...حتّى لو وقعتَ في حبّها

31
00:02:50,340 --> 00:02:51,680
!أعلم

32
00:02:52,060 --> 00:02:56,290
.لكن لا أستطيع السّيطرة على مشاعري

33
00:02:56,950 --> 00:02:59,510
.على أيّ حال، هذا كلّ ما في الأمر

34
00:04:37,460 --> 00:04:39,340
!أنا غاضبة جدًّا

35
00:04:39,340 --> 00:04:43,510
كيف يُعقل أن ينفصل
عنك ياماتو فجأة هكذا؟

36
00:04:43,510 --> 00:04:45,760
!سأقتله

37
00:04:46,220 --> 00:04:47,760
.لا تفعلي يا توكو

38
00:04:47,760 --> 00:04:49,140
.لا تمنعيني يا يوزو

39
00:04:49,140 --> 00:04:52,020
.نيانكيتشي-كُن، ساعدني في إيقاف توكو

40
00:04:52,930 --> 00:04:54,020
.حاضر، حاضر

41
00:04:54,310 --> 00:04:55,520
.اسمعي يا توكو

42
00:04:55,850 --> 00:04:58,940
.ستتسبّبين في مشاكل ليوزو بالعنف لا غير

43
00:04:59,360 --> 00:05:02,280
.لكنّ الأمور كانت على ما يرام حتّى الأمس

44
00:05:02,280 --> 00:05:05,400
ووقع في حبّها من النّظرة
الأولى، هي بالذّات؟

45
00:05:05,400 --> 00:05:07,950
لك الحقّ في أن تكوني
.أكثر غضبًا يا يوزو

46
00:05:08,490 --> 00:05:11,370
.لا أصدّق الأمر بعد

47
00:05:11,790 --> 00:05:15,500
وأعتقد أنّني أقلّ صدمةً من الانفصال نفسه

48
00:05:15,500 --> 00:05:19,080
.من كون السّبب هو كارين

49
00:05:20,210 --> 00:05:21,420
.كارين

50
00:05:21,420 --> 00:05:24,590
،مع أنّ لنا نفس الوالدين

51
00:05:24,590 --> 00:05:29,390
،إلاّ أنّ أختي، الأصغر منّي بسنة
.كانت دائمًا تُفضَّل عليّ

52
00:05:30,680 --> 00:05:33,680
.لا بدّ أنّها أغوته

53
00:05:34,100 --> 00:05:37,900
.أشكّ في ذلك. إنّها عروس

54
00:05:37,900 --> 00:05:40,810
.لن يسمح حبيبها الشّيطان بذلك أبدًا

55
00:05:40,810 --> 00:05:43,860
.يجب أن تعلمي ذلك
.أنت عروسُ شيطانِ قطّ

56
00:05:48,410 --> 00:05:50,280
.أظنّ ذلك

57
00:05:50,620 --> 00:05:53,910
نيكوتا توكيتشي، المعروف أيضًا
.باسم نيانكيتشي

58
00:05:54,410 --> 00:05:56,660
.إنّه شيطانٌ قطّ

59
00:05:56,660 --> 00:06:00,790
.وصديقة طفولتي توكو هي عروسه

60
00:06:03,300 --> 00:06:06,010
عادةً ما يرتاد الشّياطين

61
00:06:06,010 --> 00:06:10,390
.مدارس خاصّة بهم مع عرائسهم

62
00:06:11,140 --> 00:06:15,640
لكنّ توكو التحقت بمدرسة
.ثانويّة حكوميّة عاديّة معي

63
00:06:16,520 --> 00:06:20,560
.وانتقل نيانكيتشي-كُن ليكون معها

64
00:06:22,060 --> 00:06:24,690
.على أيّ حال، ياماتو غبيّ

65
00:06:24,690 --> 00:06:30,860
عائلتي لا تُقارن بعائلة الشّياطين
.الّتي اختارت كارين

66
00:06:30,860 --> 00:06:35,240
،الشّياطين الثّعالب أقوياء
.حتّى بالنّسبة للشّياطين

67
00:06:35,240 --> 00:06:37,910
.لا يملك ياماتو أيّ فرصة

68
00:06:39,670 --> 00:06:41,330
.لا مفرّ من ذلك

69
00:06:42,710 --> 00:06:45,380
.طلب منّي ياماتو الخروج معه

70
00:06:45,380 --> 00:06:48,170
إنّه نجم فريق كرة القدم
.ولديه الكثير من الأصدقاء

71
00:06:48,170 --> 00:06:50,130
.بدا شخصًا صادقًا

72
00:06:51,260 --> 00:06:54,720
.شعرت بالسّعادة عندما رغب بي أحدهم

73
00:06:55,720 --> 00:06:57,850
.ظننت أنّني قد أقع في حبّه

74
00:06:58,890 --> 00:07:00,190
...يوزو

75
00:07:01,350 --> 00:07:03,940
لماذا فعلت ذلك يا نيانكيتشي؟

76
00:07:03,940 --> 00:07:06,110
يوزو، ألا يجب عليك
الذّهاب إلى العمل؟

77
00:07:06,610 --> 00:07:08,150
.انظري إلى السّاعة

78
00:07:08,150 --> 00:07:10,490
.آسفة يا توكو ونيانكيتشي-كُن

79
00:07:14,320 --> 00:07:15,870
.أراكما غدًا

80
00:07:15,870 --> 00:07:17,830
.حسنًا، إلى اللّقاء

81
00:07:17,830 --> 00:07:18,620
.إلى اللّقاء

82
00:07:24,000 --> 00:07:30,380
منذ نعومة أظفاري، كان والداي
.مهتمّين بكارين أكثر من أيّ شيء آخر

83
00:07:30,970 --> 00:07:35,350
كان والداي يعتقدان أنّ كارين
.تصلح لتكون عروسًا لشيطان

84
00:07:35,760 --> 00:07:40,640
حتّى أنّهما اقترضا المال من الأقارب
.لإرسالها إلى مدرسة للشّياطين

85
00:07:41,060 --> 00:07:45,150
.وهناك لفتت انتباه شيطانٍ ثعلب

86
00:07:45,520 --> 00:07:48,650
بعد ذلك، أصبح كلّ شيء
.في منزلنا يدور حول كارين

87
00:07:49,440 --> 00:07:52,650
.أمي، زيارة الصّفّ غدًا

88
00:07:53,030 --> 00:07:56,580
لا أستطيع الذّهاب. زيارة
.صفّ كارين في ذلك اليوم

89
00:08:01,040 --> 00:08:04,210
.إنّها مجرّد نزلة برد. ستتحسّن بالرّاحة

90
00:08:04,210 --> 00:08:06,540
...أبي... أمّي

91
00:08:06,540 --> 00:08:08,380
...أنا مريضة جدًّا

92
00:08:08,380 --> 00:08:11,340
.مهما ناديتهما، لم يأتيا

93
00:08:19,680 --> 00:08:22,020
.وفي النّهاية، استسلمت

94
00:08:22,020 --> 00:08:25,770
،بمجرّد أن بدأت أرتاد الثّانويّة
.حصلتُ على هذه الوظيفة

95
00:08:26,400 --> 00:08:29,690
.كرهت العودة إلى منزل لا أنتمي إليه

96
00:08:31,320 --> 00:08:32,780
.تصبحون على خير

97
00:08:32,780 --> 00:08:34,570
.تصبحين على خير

98
00:08:52,460 --> 00:08:54,720
،أنا ذاهبة إلى المنزل الآن

99
00:08:55,510 --> 00:08:58,510
.لكن هذا الأمر يُحزنني دائمًا

100
00:09:08,360 --> 00:09:10,860
.صحيح، إنّه هنا

101
00:09:16,360 --> 00:09:18,530
يوزو، عدتِ إلى المنزل، صحيح؟

102
00:09:19,160 --> 00:09:23,290
إذا كنتِ هنا، فأسرعي
!وساعديني في تحضير العشاء

103
00:09:25,290 --> 00:09:27,040
.يا إلهي

104
00:09:27,040 --> 00:09:29,250
كان عليك الحضور قبل
.أن يُطلب منك ذلك

105
00:09:29,790 --> 00:09:30,750
.حسنًا

106
00:09:30,750 --> 00:09:34,050
!هذا ظريف جدًّا! قم بالمزيد

107
00:09:34,050 --> 00:09:35,760
.عجبًا، استمع لهما

108
00:09:36,840 --> 00:09:38,760
.انظرا لهذا

109
00:09:39,430 --> 00:09:41,760
أتريان؟ أليس ظريفًا؟

110
00:09:42,060 --> 00:09:43,520
.كوغيتسو يوتا

111
00:09:43,970 --> 00:09:49,060
شيطانٌ ثعلب من عائلة
.كوغيتسو يتمتّع بجمال خارق

112
00:09:50,020 --> 00:09:54,030
اختار كارين لتكون عروسه بعد
.أن التقى بها في مدرستهما

113
00:09:55,940 --> 00:09:59,070
يحتلّ الشّياطين الثّعالب مكانة
،رفيعة بين الشّياطين

114
00:09:59,070 --> 00:10:05,500
.وتُقدّم عائلته الثّريّة الدّعم الماليّ لعروسه

115
00:10:06,120 --> 00:10:11,170
سدّد والداي ديونهما
.ويعيشان الآن حياة رغيدة

116
00:10:12,210 --> 00:10:16,420
.هذه الشّريحة قاسية جدًّا يا أختي
.حضّري واحدة جديدة

117
00:10:17,010 --> 00:10:19,380
.يحبّ يوتا شريحة اللّحم نصف مطهوّة

118
00:10:19,680 --> 00:10:25,640
.حقًّا؟ أنا آسفة، لكن ليس لدينا المزيد

119
00:10:25,640 --> 00:10:27,640
.اذهبي إذًا واشتري بعضها

120
00:10:28,100 --> 00:10:30,900
.لا أستطيع جعل يوتا أكل هذه

121
00:10:30,900 --> 00:10:32,060
...كارين

122
00:10:32,060 --> 00:10:34,650
.يوزو، اذهبي واشتري المزيد من شرائح اللّحم

123
00:10:36,030 --> 00:10:39,910
كارين، لِمَ لا نذهب إلى مطعم
متخصّص في شرائح اللّحم؟

124
00:10:39,910 --> 00:10:42,070
.أعرف مكانًا رائعًا

125
00:10:42,070 --> 00:10:44,530
ماذا؟ حقًّا؟

126
00:10:45,290 --> 00:10:47,330
!أحبّك يا يوتا

127
00:10:49,330 --> 00:10:51,290
.يدلّل يوتا كارين كثيرًا

128
00:10:51,960 --> 00:10:56,920
.إنّ عروسَ شيطان عزيزة عليه لتلك الدّرجة

129
00:10:56,920 --> 00:10:59,130
.إنّها تعميه عن رؤية كلّ شيء آخر

130
00:10:59,380 --> 00:11:03,050
.يوزو، لا تعاملي يوتا-كُن بوقاحة

131
00:11:03,050 --> 00:11:06,140
.لقد سبّبتِ مشكلة لكارين
.أتمنّى أن تكوني آسفة

132
00:11:09,310 --> 00:11:10,770
.سأكون أكثر حذرًا

133
00:11:12,100 --> 00:11:16,110
.كارين عروس. قرّة عين والديّ

134
00:11:16,110 --> 00:11:18,190
إذًا ماذا أكون أنا؟

135
00:11:18,940 --> 00:11:22,450
هل يوجد شخص ما في هذا العالم

136
00:11:23,120 --> 00:11:27,120
يحبّني أنا فقط، كما يحبّ يوتا كارين؟

137
00:11:30,790 --> 00:11:32,330
...لكنّ طعمها لذيذ

138
00:11:35,340 --> 00:11:37,090
هل هذا لي؟

139
00:11:39,090 --> 00:11:40,760
.كم هو ظريف

140
00:11:40,760 --> 00:11:42,760
فعلاً؟

141
00:11:43,300 --> 00:11:45,350
من أين لك هذا يا جدّي؟

142
00:11:45,600 --> 00:11:51,140
.وجدته بالصّدفة وظننتُ أنّه سيناسبك

143
00:11:51,140 --> 00:11:52,600
.ذلك ليس ما حدث

144
00:11:52,600 --> 00:11:56,690
استعمل جدّك الّذي لا يفقه في التّكنولوجيا
هاتفه الذّكيّ للبحث عن متاجر

145
00:11:56,690 --> 00:11:59,530
مشهورة بين الفتيات، ووقف
.في الطّابور مبكّرًا لشرائه

146
00:11:59,530 --> 00:12:00,940
.رويدك

147
00:12:02,360 --> 00:12:06,950
عيد ميلادك قريب، أليس كذلك؟
.لذا أحضرت لك هذه الهديّة

148
00:12:07,240 --> 00:12:10,160
أنا آسفة لعدم تمكّننا من الزّيارة

149
00:12:10,160 --> 00:12:13,710
.لأنّني لم أكن أشعر بحالة جيّدة

150
00:12:19,380 --> 00:12:20,760
.أعياد الميلاد

151
00:12:20,760 --> 00:12:23,970
إنّ عيد ميلاد كارين دائمًا
،يكون احتفالاً كبيرًا

152
00:12:24,590 --> 00:12:27,970
.لكنّ والداي لا يتذكّران عيد ميلادي حتّى

153
00:12:28,720 --> 00:12:31,270
.عيدُ ميلادٍ ثامنَ عشرَ سعيدٌ يا يوزو

154
00:12:31,270 --> 00:12:32,980
.أتمنّى لك عامًا رائعًا

155
00:12:33,270 --> 00:12:36,310
.شكرًا يا جدّي وجدّتي

156
00:12:37,060 --> 00:12:38,570
.أنا سعيدة جدًّا

157
00:12:41,860 --> 00:12:44,280
!قلت لك ألاّ تزوري والدي

158
00:12:44,740 --> 00:12:47,910
!اتّصل ليشتكي مجدّدًا

159
00:12:47,910 --> 00:12:52,040
،قال أن نوليك اهتمامًا أكبر
!وليس كارين فقط

160
00:12:52,290 --> 00:12:56,370
ألا نقوم بتربيتك أيضًا؟
ما الّذي يدعوك للشّكوى؟

161
00:12:57,670 --> 00:13:00,170
.لم أشتكِ أبدًا

162
00:13:00,170 --> 00:13:03,300
.كارين عروس. إنّها ليست مثلك

163
00:13:03,840 --> 00:13:05,930
!بالطّبع نحن نقدّرها

164
00:13:06,380 --> 00:13:09,810
.نحن والدا عروسِ شيطان

165
00:13:09,810 --> 00:13:14,020
.يجب على جدّيك أن يُدركا الفرق بينكما

166
00:13:15,060 --> 00:13:16,440
.مهلاً

167
00:13:17,560 --> 00:13:22,400
هل يمكنكم الشّجار في مكان آخر؟
.سيأتي يوتا قريبًا

168
00:13:22,400 --> 00:13:24,690
.لا تُحرجوا أنفسكم أمامه

169
00:13:24,990 --> 00:13:27,360
.آسف يا كارين

170
00:13:27,360 --> 00:13:30,280
.ليس عليك القلق حيال أيّ شيء

171
00:13:31,330 --> 00:13:32,740
.إنّه يوتا

172
00:13:33,660 --> 00:13:36,080
!أهلاً بك يا يوتا

173
00:13:37,250 --> 00:13:39,040
.أهلاً بك

174
00:13:38,170 --> 00:13:39,750
.تفضّل بالدّخول

175
00:13:48,930 --> 00:13:50,350
...هذا مؤلم

176
00:13:51,390 --> 00:13:53,140
.يبدو أنّهم مستمتعون

177
00:13:53,640 --> 00:13:56,520
.أتمنّى أن يرحل يوتا قريبًا

178
00:13:57,980 --> 00:14:01,860
.لن يرحل. إنّه دائمًا ما يُطيل البقاء

179
00:14:02,320 --> 00:14:06,700
.لطالما اهتم جدّاي لأمري

180
00:14:07,490 --> 00:14:09,780
.لكنّهما يتقدّمان في السّنّ

181
00:14:10,280 --> 00:14:12,870
.لن يكونا موجودين لإنقاذي إلى الأبد

182
00:14:17,580 --> 00:14:20,500
أعتقد أنّني بقيت في حوض
.الاستحمام لفترة طويلة

183
00:14:24,380 --> 00:14:28,970
إلى متى سأظلّ أهرب من عائلتي؟

184
00:14:29,380 --> 00:14:33,510
لكن يؤلمني أن أرى كارين
.ويوتا ينسجمان هكذا

185
00:14:34,220 --> 00:14:37,140
.كأنّهما يتعمّدان تذكيري بأنّني غير محبوبة

186
00:14:37,680 --> 00:14:39,810
.أنا أخت كبرى سيّئة

187
00:14:43,020 --> 00:14:44,520
.ماذا؟ الأضواء منارة

188
00:14:51,070 --> 00:14:53,870
.أختي، هذا الفستان جميل

189
00:14:53,870 --> 00:14:55,830
أعطاه لك جدّي، أليس كذلك؟

190
00:14:55,830 --> 00:14:57,080
.أعطيني إيّاه

191
00:14:58,290 --> 00:15:00,000
.لا أستطيع

192
00:15:00,000 --> 00:15:01,960
.كان هديّة

193
00:15:02,330 --> 00:15:04,920
هيّا، ليس من العدل أن تحصلي
.أنت فقط على شيء

194
00:15:05,420 --> 00:15:06,920
...كارين

195
00:15:07,210 --> 00:15:09,970
أنت تغارين منّي، أليس كذلك؟

196
00:15:10,380 --> 00:15:13,600
.أنت تغارين لأنّني مميّزة

197
00:15:13,970 --> 00:15:15,890
.لهذا السّبب تعاملينني بلؤم

198
00:15:17,100 --> 00:15:19,480
.أعيديه فحسب

199
00:15:22,770 --> 00:15:24,150
!أعيديه

200
00:15:27,190 --> 00:15:28,940
!لا تقولي لي ما أفعل

201
00:15:34,870 --> 00:15:38,500
.أنت المخطئة لأنّك لم تعطيني إيّاه

202
00:15:38,790 --> 00:15:40,250
.قمامة قذرة

203
00:15:49,010 --> 00:15:51,680
ما سبب هذا الصّراخ؟

204
00:15:52,220 --> 00:15:56,930
.مزّقت كارين فستاني الثّمين

205
00:15:56,930 --> 00:15:59,180
!كلاّ، لم يكن ذلك عن قصد

206
00:15:59,180 --> 00:16:03,400
!أردتُ استعارته فقط، لكنّها ضربتني فجأة

207
00:16:03,400 --> 00:16:05,060
هل أنت بخير يا كارين؟

208
00:16:05,360 --> 00:16:07,190
من يهتمّ بفستان؟

209
00:16:07,190 --> 00:16:09,820
!أنت أختها الكبرى
!كان يجب أن تدعيها تستعيره

210
00:16:09,820 --> 00:16:12,610
.انظري إلى مدى احمرار وجهك

211
00:16:12,610 --> 00:16:16,070
يوزو، ماذا ستفعلين إذا ترك هذا أثرًا؟

212
00:16:17,660 --> 00:16:18,740
.أنت

213
00:16:20,500 --> 00:16:22,210
!يوتا

214
00:16:26,790 --> 00:16:28,250
ما-ماذا؟

215
00:16:28,800 --> 00:16:32,380
.سيدفع أيّ شخص يؤذي عروسي الثّمن

216
00:16:32,380 --> 00:16:35,890
.حتّى أختها

217
00:16:40,640 --> 00:16:42,480
!لا فائدة! لا أستطيع إطفاءها

218
00:16:43,230 --> 00:16:46,060
!النّار تحرقني! ذراعي تحترق

219
00:16:47,150 --> 00:16:48,310
...يوتا

220
00:16:55,570 --> 00:17:00,120
.هذه قوّةُ نارِ شيطانٍ ثعلب

221
00:17:01,160 --> 00:17:03,710
.إيّاك أن تؤذي كارين ثانية

222
00:17:07,580 --> 00:17:09,840
.أنا آسفة يا يوتا-كُن

223
00:17:09,840 --> 00:17:11,880
.سنوبّخ يوزو بشدّة

224
00:17:11,880 --> 00:17:15,300
.آسف على هذه الضّجة
هل نذهب الآن؟

225
00:17:16,590 --> 00:17:21,640
.لن يقف أحدٌ هنا في صفّي

226
00:17:58,840 --> 00:18:01,430
.كنتُ أكبح جماح نفسي حتّى الآن

227
00:18:01,810 --> 00:18:03,890
.لكنّني لم أستطع منع نفسي

228
00:18:08,440 --> 00:18:11,110
كيف سأعتذر لجدّي؟

229
00:18:20,240 --> 00:18:21,620
.هذا مؤلم

230
00:18:42,850 --> 00:18:44,350
.وجدتك

231
00:18:54,770 --> 00:18:56,190
...كنتُ أنتظر هذه اللّحظة

232
00:18:57,570 --> 00:18:59,200
.يا عروسي

233
00:19:08,120 --> 00:19:10,330
عروسك؟

234
00:19:21,220 --> 00:19:22,720
...هذه الطّاقة الرّوحيّة

235
00:19:23,600 --> 00:19:24,970
.هذا من فعل ثعلب

236
00:19:26,720 --> 00:19:27,770
ما اسمك؟

237
00:19:28,640 --> 00:19:29,730
...عفوًا

238
00:19:31,390 --> 00:19:33,150
.اسمي يوزو

239
00:19:34,810 --> 00:19:37,360
.يوزو، كنتُ أتوق لرؤيتك

240
00:19:37,780 --> 00:19:40,400
ماذا تقصد؟

241
00:19:41,360 --> 00:19:43,820
.لكنّنا لم نلتقِ من قبل

242
00:19:43,820 --> 00:19:45,280
.إنّه في غاية الجمال

243
00:19:45,910 --> 00:19:50,540
،يمتزج شعره الأسود الفاحم بالظّلام
.وعيناه حمراوان كلون الدّماء

244
00:19:51,040 --> 00:19:53,330
.ما كنتُ لأنساه أبدًا

245
00:19:53,830 --> 00:19:57,800
.أنا رييا. كيريوين رييا

246
00:19:59,710 --> 00:20:03,590
أنا عروسه؟ ماذا يقول؟

247
00:20:04,050 --> 00:20:06,050
...كنت أبحث عنك

248
00:20:06,970 --> 00:20:08,560
.يا عروسي

249
00:20:09,890 --> 00:20:11,270
...عفوًا

250
00:20:11,520 --> 00:20:15,440
سأوصلك إلى المنزل. لا يجب أن تكوني
.في الخارج في هذا الوقت المتأخّر

251
00:20:15,440 --> 00:20:16,690
أين منزلك؟

252
00:20:18,400 --> 00:20:19,530
...منزلي

253
00:20:24,660 --> 00:20:27,530
ما بك؟ ألا تريدين العودة إلى المنزل؟

254
00:20:44,010 --> 00:20:45,300
!يا للعجب

255
00:20:45,840 --> 00:20:47,890
هل أنت مصابة في أيّ مكان آخر؟

256
00:20:49,390 --> 00:20:51,560
هل أنت غول؟

257
00:20:52,100 --> 00:20:53,140
.نعم

258
00:20:54,560 --> 00:20:57,980
.كيريوين. حتّى أنا سمعتُ بهذا الاسم

259
00:20:58,440 --> 00:21:04,360
إنّهم عائلة من الغيلان والبشر
.في قمّة المجتمع اليابانيّ

260
00:21:05,700 --> 00:21:10,330
لماذا قد يساعدني شخص مثلك؟

261
00:21:10,870 --> 00:21:13,870
.أخبرتك. أنت عروسي

262
00:21:13,870 --> 00:21:15,370
ألا تصدّقينني؟

263
00:21:16,120 --> 00:21:18,170
أنا عروس؟

264
00:21:18,710 --> 00:21:20,250
مثل كارين؟

265
00:21:21,170 --> 00:21:24,170
لا يمكنني أن أكون عروس
.شيطان بهذه القوّة

266
00:21:24,800 --> 00:21:27,180
.هذا أسهل ممّا ينبغي

267
00:21:27,640 --> 00:21:29,510
لماذا أنا؟

268
00:21:30,510 --> 00:21:33,980
.كارين عروس. إنّها ليست مثلك

269
00:21:33,980 --> 00:21:36,440
!بالطّبع نحن نقدّرها

270
00:21:37,980 --> 00:21:42,400
،في ذلك المنزل الموحش
...تمنّيت وحلمت مرّات عديدة

271
00:21:43,650 --> 00:21:46,360
.أن يحبّني أحد ما

272
00:21:50,530 --> 00:21:52,910
.الوحدة تحزنني بشدّة

273
00:21:56,830 --> 00:22:00,750
هل ستحبّني؟

274
00:22:01,290 --> 00:22:04,630
...نعم. سأحبّك أنت وحدك

275
00:22:05,470 --> 00:22:06,760
.يا عروسي

276
00:22:07,220 --> 00:22:12,350
.إنّه شيطان، والشّياطين لا يخونون عرائسهم أبدًا

277
00:22:13,260 --> 00:22:18,690
هل سيحقّق أمنيتي وحلمي؟

278
00:22:19,850 --> 00:22:22,190
.ربّما سيحبّني