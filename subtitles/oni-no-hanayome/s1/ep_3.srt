1
00:00:13,830 --> 00:00:15,850
.سنصل قريبًا

2
00:00:15,850 --> 00:00:16,750
.شكرًا

3
00:00:24,570 --> 00:00:25,790
.شكرًا لك

4
00:00:29,570 --> 00:00:31,890
.لم أتواجد في المنزل منذ أيّام

5
00:00:33,110 --> 00:00:37,370
جهّزت جميع الأوراق المطلوبة
.لتبنّي يوزو-ساما

6
00:00:38,820 --> 00:00:42,720
كلّ ما نحتاجه الآن هو تواقيع
.والديها وجدّيها

7
00:00:42,720 --> 00:00:44,010
.مفهوم

8
00:00:44,390 --> 00:00:47,790
.سكرتير رييا، أراكي تاكاميتشي-سان

9
00:00:48,820 --> 00:00:51,280
.سمعتُ أنّه محامٍ كفؤ أيضًا

10
00:00:51,280 --> 00:00:53,540
.لا بدّ أنّه بارع

11
00:00:54,060 --> 00:00:57,410
هل غضب أبي وأمّي؟

12
00:00:57,410 --> 00:01:00,920
أم سيتظاهران بعدم الاكتراث؟

13
00:01:01,490 --> 00:01:04,300
.لا أعرف ماذا أتوقّع، وهذا يُقلقني

14
00:01:15,120 --> 00:01:18,020
.هذا صحيح. كوني شجاعة

15
00:01:19,670 --> 00:01:21,490
.لستُ وحدي

16
00:01:36,530 --> 00:01:39,370
"عروس الغول"

17
00:02:58,660 --> 00:03:00,060
.عدتُ إلى المنزل

18
00:02:59,030 --> 00:03:04,030
"الحلقة 3: قرار"

19
00:03:01,530 --> 00:03:04,270
!وتدّعيان أنّكما والدا يوزو؟

20
00:03:04,560 --> 00:03:06,560
!هذا ليس من شأنكما

21
00:03:06,560 --> 00:03:08,420
كيف لا يكون من شأني؟

22
00:03:08,420 --> 00:03:10,790
!إنّها حفيدتي أيضًا

23
00:03:10,790 --> 00:03:13,500
!لقد ضربتْ كارين

24
00:03:13,500 --> 00:03:16,570
!لا بدّ أنّ كارين فعلت شيئًا لاستفزازها

25
00:03:16,570 --> 00:03:22,170
لكنّكما جعلتما يوزو تبدو
.وكأنّها المذنبة ولم تستمعا إليها

26
00:03:22,170 --> 00:03:24,390
.أنا من ضُربت

27
00:03:24,390 --> 00:03:26,680
لماذا تحميانها هي؟

28
00:03:26,680 --> 00:03:30,310
.قد تكونان جدّي كارين، لكنّني لا أحبّ هذا

29
00:03:33,570 --> 00:03:34,720
.أختي

30
00:03:34,720 --> 00:03:35,780
!يوزو

31
00:03:37,520 --> 00:03:39,360
.لا بدّ أنّك كنتِ خائفة جدًّا

32
00:03:39,360 --> 00:03:42,110
.أنا سعيدة جدًّا لأنّك بخير يا يوزو

33
00:03:42,660 --> 00:03:47,270
.جدّي، جدّتي، أنا آسفة لإقلاقكما

34
00:03:47,270 --> 00:03:48,880
.هذا صحيح

35
00:03:48,880 --> 00:03:53,160
،لطالما كانت جدّتي، وليس أمّي
.هي من تعانقني

36
00:03:53,750 --> 00:03:59,550
.وكان جدّي، وليس أبي، من يبتسم بارتياح

37
00:04:00,210 --> 00:04:02,410
يوزو، ماذا تفعلين؟

38
00:04:02,410 --> 00:04:05,180
.أوّلاً، اعتذري عن ضرب كارين

39
00:04:05,670 --> 00:04:11,090
توقّف والداي عن كونهما
.والديّ منذ زمن طويل

40
00:04:11,690 --> 00:04:16,980
بصراحة، نحن نتجادل دائمًا
.مع جدّي وجدّتي بسببك

41
00:04:16,980 --> 00:04:18,190
.كارين

42
00:04:18,190 --> 00:04:20,230
كفّي عن هذا، مفهوم؟

43
00:04:20,230 --> 00:04:22,460
لا أصدّق أنّك هربت بعد
.أن بدأتِ هذه المشكلة

44
00:04:22,460 --> 00:04:24,190
هل تبحثين عن الاهتمام أم ماذا؟

45
00:04:24,460 --> 00:04:28,700
.لم تكتفين بضرب كارين، بل أحزنتِها أيضًا

46
00:04:29,120 --> 00:04:30,970
كيف تجرئين على معاملتها بهذه الطّريقة؟

47
00:04:32,770 --> 00:04:34,370
...في الحقيقة

48
00:04:35,810 --> 00:04:39,290
كيف تجرؤ أنت على معاملة
عروسي بهذه الطّريقة؟

49
00:04:42,250 --> 00:04:43,740
...أ-أنت

50
00:04:45,090 --> 00:04:46,570
يوتا؟

51
00:04:46,570 --> 00:04:49,370
ما الّذي أتى بحضرتك إلى هنا؟

52
00:04:50,400 --> 00:04:52,720
.لنبدأ يا تاكاميتشي

53
00:04:52,720 --> 00:04:54,000
.في حال يا سيّدي

54
00:04:54,880 --> 00:04:56,870
من أنتما؟

55
00:04:56,870 --> 00:04:58,860
.لا يمكنكما اقتحام منزلنا هكذا

56
00:04:59,690 --> 00:05:03,180
نحن هنا لنحصل على تواقيعكم

57
00:05:03,180 --> 00:05:06,870
.للموافقة على تبنّي يوزو وإتمامه

58
00:05:06,870 --> 00:05:09,340
ماذا؟ تبنّي؟

59
00:05:09,340 --> 00:05:11,860
.لم يخبرنا أحد بهذا

60
00:05:11,860 --> 00:05:16,290
لا يمكننا أن نتوقّع منكما
.رعاية يوزو بعد الآن

61
00:05:16,290 --> 00:05:18,720
.لذا سنأخذ يوزو معنا

62
00:05:18,720 --> 00:05:22,000
ماذا تقولان؟ لا يمكنكما فعل
!هذا ببساطة هكذا

63
00:05:22,000 --> 00:05:24,910
إنّها الطّريقة الوحيدة
.لكي تكون يوزو سعيدة

64
00:05:24,910 --> 00:05:29,230
.أنتما لا تهتمّان إلاّ بكارين
.لقد أهملتما يوزو

65
00:05:29,230 --> 00:05:31,510
.هذا غير صحيح

66
00:05:31,510 --> 00:05:35,920
.كارين مميّزة. بالطّبع أعطيناها الأولويّة

67
00:05:35,920 --> 00:05:38,070
.هذا كلّ ما يهمّكما

68
00:05:38,070 --> 00:05:40,510
إنّها عروس؟ وماذا في ذلك؟

69
00:05:40,760 --> 00:05:43,530
هل تعتقدان أنّ هذا يبرّر معاملتكما لها؟

70
00:05:44,700 --> 00:05:48,020
يوزو، ما هو شعورك حيال هذا؟

71
00:05:50,310 --> 00:05:53,030
!نحن من ربّيناك

72
00:05:50,340 --> 00:05:53,730
.أنا ممتنّة لهما لتربيتي حتّى الآن

73
00:05:53,030 --> 00:05:56,200
هل أنت متمرّدة لدرجة أنّك لا تدركين ذلك؟

74
00:05:54,480 --> 00:05:58,530
.لكنّني لا أنتمي إلى هذا المكان

75
00:05:56,710 --> 00:06:02,210
ألا تفهمين كم كان هذا صعبًا علينا؟

76
00:05:59,270 --> 00:06:01,550
...لم أستطع قول ذلك من قبل

77
00:06:02,220 --> 00:06:03,470
...أنا

78
00:06:03,910 --> 00:06:06,480
.لكن هذا ما أشعر به حقًّا

79
00:06:07,370 --> 00:06:10,740
.أود أن يتمّ تبنّيّ

80
00:06:10,740 --> 00:06:15,880
.لا أعتقد أنّني سأكون سعيدة هنا

81
00:06:20,000 --> 00:06:22,390
!يا لك من طفلة عاصية

82
00:06:22,390 --> 00:06:23,400
!سيضربني

83
00:06:25,580 --> 00:06:26,690
.رييا

84
00:06:27,990 --> 00:06:30,490
!ما-ما مشكلتك؟ اتركني

85
00:06:32,570 --> 00:06:34,360
!قلت لك اتركني

86
00:06:38,180 --> 00:06:39,320
!عزيزي

87
00:06:41,180 --> 00:06:43,610
مـ-من تكون يا هذا؟

88
00:06:43,610 --> 00:06:45,320
يوزو، ما الّذي يحدث هنا؟

89
00:06:45,820 --> 00:06:48,730
!يوزو، لقد كنتِ أنانيّة بما فيه الكفاية

90
00:06:48,730 --> 00:06:51,420
هل تستمتعين بخلق المشاكل لنا؟

91
00:06:51,420 --> 00:06:55,690
.هذا صحيح. كان كلّ شيء خطئي دائمًا

92
00:06:55,690 --> 00:06:57,870
...لا أبي ولا أمّي

93
00:06:55,940 --> 00:06:57,630
.الخطأ خطؤك دائمًا

94
00:06:57,630 --> 00:06:58,680
.بكلّ تأكيد

95
00:06:58,680 --> 00:07:02,250
.يعتقدان أنّهما ارتكبا أيّ خطأ

96
00:07:03,630 --> 00:07:08,540
أنا يائسة لدرجة أنّني مستعدّة
.للتّضحية بأقرب النّاس إليّ

97
00:07:09,250 --> 00:07:12,290
.لقد كان خيارًا مؤلمًا للغاية

98
00:07:14,730 --> 00:07:20,670
لطالما تمنّيتُ أن يقبلاني
،يومًا ما كفردٍ من العائلة

99
00:07:21,230 --> 00:07:26,120
.لكنّني أدرك أنّ ذلك مستحيل

100
00:07:26,990 --> 00:07:30,540
.إنّهما لا يفهمان رغباتي أو شكوكي

101
00:07:30,930 --> 00:07:32,640
.لن يفهما

102
00:07:36,050 --> 00:07:38,210
هل يحميانني؟

103
00:07:38,210 --> 00:07:41,050
هل يقولان لي أنّني لستُ
مُلزمةً بالاستماع إليهما؟

104
00:07:44,230 --> 00:07:45,800
.شكرًا لكما

105
00:07:46,390 --> 00:07:49,250
!يوزو، لا تقفي هناك بلا حراك! قولي شيئًا

106
00:07:49,250 --> 00:07:50,150
!هيّا يا يوزو

107
00:07:50,150 --> 00:07:51,310
!اصمتا

108
00:07:52,560 --> 00:07:55,930
.لا تفعلان شيئًا سوى إيذاء يوزو

109
00:07:56,520 --> 00:07:58,150
.وقّعا الأوراق في الحال

110
00:08:00,170 --> 00:08:05,160
لا أعرف من أنت، لكن ابق بعيدًا
.عن شؤون عائلتي

111
00:08:05,470 --> 00:08:09,680
.أنا عروس الشّيطان الثّعلب كوغيتسو يوتا

112
00:08:10,170 --> 00:08:12,590
.أنا أُعيل هذه العائلة

113
00:08:12,920 --> 00:08:18,440
أراهن أنّ أختي كذبت عليك
.لتشعر بالشّفقة عليها

114
00:08:18,440 --> 00:08:20,090
.كارين، توقّفي

115
00:08:20,090 --> 00:08:21,460
لماذا؟

116
00:08:21,460 --> 00:08:25,800
!اِحْرق هذا الوقح كما أحرقت أختي

117
00:08:26,140 --> 00:08:27,950
ما معنى هذا؟

118
00:08:27,950 --> 00:08:31,570
لماذا تنحاز إليها يا سيّدي؟

119
00:08:31,570 --> 00:08:34,580
.سبق وقلت لك، إنّها عروسي

120
00:08:34,940 --> 00:08:38,640
هـ-هذه المرأة هي عروسك؟
—هذا لا يُعقـ

121
00:08:53,760 --> 00:08:55,830
.تذوّق ألم يوزو

122
00:08:57,780 --> 00:09:01,470
هـ-هذه المرأة هي عروسك؟
—هذا لا يُعقـ

123
00:09:04,650 --> 00:09:06,630
.تذوّق ألم يوزو

124
00:09:19,240 --> 00:09:20,700
!يوتا

125
00:09:20,700 --> 00:09:23,000
!توقّف! أنت تقتله

126
00:09:29,270 --> 00:09:32,390
.لم أرَ تلك النّظرة القاسية من قبل

127
00:09:39,030 --> 00:09:43,560
.أنا بخير. لقد شفيتني

128
00:09:46,620 --> 00:09:50,220
.أسرتني عيناه الحمراوان، ولن تدعاني

129
00:09:53,140 --> 00:09:56,010
.إن كان هذا ما ترغبين به يا يوزو

130
00:10:18,650 --> 00:10:21,610
.رييا-ساما، تمّ ملء هذه الاستمارات

131
00:10:21,610 --> 00:10:22,830
.هذه الأخيرة

132
00:10:27,310 --> 00:10:31,600
عليك أن توقّع ذلك قبل
.أن تُغضبني بشدّة، لمصلحتك

133
00:10:31,890 --> 00:10:33,510
.وقّع هنا

134
00:10:35,430 --> 00:10:37,110
.كلّ شيء يبدو جيّدًا

135
00:10:38,190 --> 00:10:39,370
.يوزو

136
00:10:39,700 --> 00:10:41,280
نعم؟

137
00:10:41,620 --> 00:10:44,010
.لن نعود إلى هذا المكان أبدًا

138
00:10:44,010 --> 00:10:46,730
.خذي فقط ما تحتاجينه

139
00:10:48,280 --> 00:10:49,690
.هيّا بنا

140
00:10:53,620 --> 00:10:56,060
.أنا آسفة يا جدّتي

141
00:10:56,060 --> 00:10:59,820
كانت نيران رييا مخيفة، أليس كذلك؟

142
00:10:59,820 --> 00:11:01,730
.نعم، كانت مخيفة

143
00:11:01,730 --> 00:11:05,680
.لم أرَ شيطانًا يستخدم قواه من قبل

144
00:11:06,050 --> 00:11:08,890
أهذا صحيح؟

145
00:11:09,260 --> 00:11:11,280
.لقد أخافني أيضًا

146
00:11:13,350 --> 00:11:17,660
.سأحبّك أنت وحدك يا عروسي

147
00:11:18,840 --> 00:11:21,610
.رييا لطيفٌ معي

148
00:11:22,020 --> 00:11:26,580
حتّى الآن، كنتُ سعيدةً بفعل
...ما يقوله، لكن

149
00:11:27,980 --> 00:11:32,170
.كان قاسيًا جدًّا هناك، كأنّه شخصٌ آخر

150
00:11:32,590 --> 00:11:37,550
...قد تكون هذه حقيقته، لكن

151
00:11:37,550 --> 00:11:38,690
...ولكن

152
00:11:39,410 --> 00:11:44,030
.كان غاضبًا حقًّا من أجلك

153
00:11:45,390 --> 00:11:49,010
.لا أحد يستطيع الوقوف في وجه كوغيتسو يوتا

154
00:11:49,010 --> 00:11:53,980
،أصبحت كارين مدلّلةً أكثر فأكثر
.وكان والداك يُنفّذان أوامرها

155
00:11:54,980 --> 00:11:59,690
.رغم معاناتك، لم نكن نستطيع فعل شيء

156
00:12:00,250 --> 00:12:01,530
...وأيضًا

157
00:12:01,950 --> 00:12:06,690
ينظر إليك كيريوين-سان
.بألطف النّظرات على الإطلاق

158
00:12:06,690 --> 00:12:11,430
.كان رييا غاضبًا حقًّا من أجلي

159
00:12:11,430 --> 00:12:13,720
أتظنّين ذلك؟

160
00:12:18,200 --> 00:12:23,550
كلّ الأشياء الّتي أفتقدها بشدّة
.تتّسع في هذه الحقيبة الصّغيرة

161
00:12:24,220 --> 00:12:27,220
.يوزو، هيّا بنا

162
00:12:27,220 --> 00:12:28,340
.حسنًا

163
00:12:33,720 --> 00:12:36,950
.مع ذلك، قضيتُ سنواتٍ في هذه الغرفة

164
00:12:37,420 --> 00:12:43,460
هربتُ إلى هنا لأتخلّص من تلك
.العائلة كلّما شعرتُ بالألم أو الحزن

165
00:12:45,800 --> 00:12:47,080
.شكرًا لك

166
00:12:52,340 --> 00:12:53,820
...يوتا

167
00:12:53,820 --> 00:12:56,240
أنت تمزح، صحيح يا يوتا؟

168
00:13:01,040 --> 00:13:03,660
يوزو، هل هذا كلّ ما ستأخذينه؟

169
00:13:03,660 --> 00:13:04,510
.نعم

170
00:13:06,330 --> 00:13:09,410
رييا، هل سيكون بخير؟

171
00:13:09,970 --> 00:13:11,250
.سيكون بخير

172
00:13:11,250 --> 00:13:14,520
لقد هاجمته بقوّة شيطانيّة بسيطة
.لا غير. إنّه فاقدٌ للوعي فقط

173
00:13:15,100 --> 00:13:19,280
والشّيطانين الثّعالب يتعافون
.بسرعة من مثل تلك الحروق

174
00:13:19,710 --> 00:13:24,070
.استحقّ عقابًا بسيطًا لإيذائه لك يا يوزو

175
00:13:26,930 --> 00:13:29,270
إنّه حيّ، أليس كذلك؟

176
00:13:29,270 --> 00:13:33,460
ملابسه محترقة، لكنّ جلده
.يبدو سليمًا. هذا جيّد

177
00:13:33,460 --> 00:13:37,830
.البشر والشّياطين مختلفون حقًّا

178
00:13:38,430 --> 00:13:40,510
من كان هذا؟

179
00:13:40,510 --> 00:13:43,670
.هُزم يوتا-كُن بسهولة بالغة

180
00:13:44,260 --> 00:13:46,500
كان شيطانًا، أليس كذلك؟

181
00:13:46,500 --> 00:13:49,170
.كان وجهه وسيمًا بشكلٍ مخيف

182
00:13:49,170 --> 00:13:51,420
.رأيته في مكان آخر من قبل

183
00:13:51,750 --> 00:13:52,770
.هيّا بنا

184
00:13:53,740 --> 00:13:56,060
!مهلاً، انتظر

185
00:13:56,590 --> 00:14:00,190
.لن تفلت من العقاب بعد إيذاء عزيزي يوتا

186
00:14:00,190 --> 00:14:01,320
.ستدفع ثمن هذا

187
00:14:01,620 --> 00:14:04,310
.سأخبر عائلة كوغيتسو

188
00:14:04,310 --> 00:14:06,780
.عائلة يوتا رائعة

189
00:14:06,780 --> 00:14:08,510
.جهّزي نفسك

190
00:14:08,510 --> 00:14:12,230
.ستعانين أنت وذلك الرّجل

191
00:14:12,230 --> 00:14:13,420
.كارين

192
00:14:14,410 --> 00:14:18,830
لا بأس. وبينما أنت بصدد ذلك، أخبري
...كبير عشيرة الشّياطين الثّعالب

193
00:14:18,830 --> 00:14:25,330
أنّ الثّعلب الّذي على الأرض هناك قد
.ألحق إصابات بليغة بعروسي العزيزة

194
00:14:29,500 --> 00:14:32,180
أنت... من تكون؟

195
00:14:32,950 --> 00:14:37,790
أنا كبير عائلة كيريوين الرّئيسيّة
.التّالي، كيريوين رييا

196
00:14:38,890 --> 00:14:41,930
.ويوزو هي عروسي

197
00:14:42,440 --> 00:14:45,210
!كيريوين؟! هل... أنت غول؟

198
00:14:45,210 --> 00:14:47,190
!الأعظم بين كلّ الشّياطين؟

199
00:14:47,520 --> 00:14:50,710
أختي عروس غول؟

200
00:14:52,260 --> 00:14:54,190
.يوزو، هيّا بنا

201
00:14:54,190 --> 00:14:56,650
.لحظة من فضلك

202
00:14:59,170 --> 00:15:02,330
،كان رييا هو من دفعني للأمام

203
00:15:03,820 --> 00:15:06,010
.لكنّ هذا كان قراري

204
00:15:07,320 --> 00:15:11,310
.شكرًا لكم على تربيتي حتّى الآن

205
00:15:12,440 --> 00:15:14,090
.أنا ممتنّة جدًّا

206
00:15:14,610 --> 00:15:18,360
على الأرجح أنّي لن أقول
.عدت للمنزل" هنا ثانية"

207
00:15:24,610 --> 00:15:28,500
من الآن فصاعدًا، ستعيش يوزو
.مع عائلة كيريوين

208
00:15:28,990 --> 00:15:34,050
.لكن لا تقلق. سأضمن لكما رؤيتها متى شئتما

209
00:15:36,260 --> 00:15:38,950
.سيفي ثلاثة حرّاس بالغرض

210
00:15:38,950 --> 00:15:40,500
.رتّب الأمور

211
00:15:40,500 --> 00:15:41,930
حرّاس؟

212
00:15:41,930 --> 00:15:44,030
.لا داعي لذلك

213
00:15:44,030 --> 00:15:45,710
.سنكون بخير

214
00:15:45,710 --> 00:15:49,110
قد نكون كبارًا في السّنّ، لكنّنا قادرون
.على إبقاء منزلنا مغلقًا وآمنًا

215
00:15:49,110 --> 00:15:50,820
.لا، أنا أصرّ

216
00:15:50,820 --> 00:15:54,580
.هذا صحيح. أنتما عائلة العروس

217
00:15:55,440 --> 00:15:57,670
.المعذرة يا كيريوين-سان

218
00:15:57,670 --> 00:15:58,520
نعم؟

219
00:15:59,430 --> 00:16:02,890
.اعتن بيوزو جيّدًا رجاءً

220
00:16:05,440 --> 00:16:08,030
.إنّها فتاة طيّبة

221
00:16:08,710 --> 00:16:12,450
لهذا السّبب، تميل إلى تحمّل
.كلّ شيء بمفردها

222
00:16:14,970 --> 00:16:19,770
.لم تخبرنا بمعاناتها حتّى لا نقلق

223
00:16:19,770 --> 00:16:22,920
.لهذا السّبب تحمّلت والديها

224
00:16:23,820 --> 00:16:26,660
.العجائز مثلي عاجزون

225
00:16:26,660 --> 00:16:29,920
لا أستطيع أن أكون بجانبها عندما
.تكون في أمسّ الحاجة إليّ

226
00:16:30,270 --> 00:16:33,710
.اسمح لي إذًا بالاعتناء بيوزو

227
00:16:37,100 --> 00:16:40,430
.يوزو، كوني على وفاق مع كيريوين-سان

228
00:16:40,940 --> 00:16:43,080
.تفضّلا بزيارتنا في أيّ وقت

229
00:16:43,710 --> 00:16:46,970
.جدّتي، جدّي، شكرًا لكما

230
00:16:46,970 --> 00:16:48,940
.إلى اللّقاء. اعتنيا بنفسيكما

231
00:16:52,900 --> 00:16:54,700
...وأخيرًا

232
00:16:56,630 --> 00:16:59,950
.ستبدأ حياتي الجديدة حقًّا

233
00:17:05,750 --> 00:17:10,050
،كلّما رأيت هذا المكان أكثر
.أدركتُ مدى ضخامته

234
00:17:10,050 --> 00:17:12,540
.عائلة كيريوين رائعة

235
00:17:12,870 --> 00:17:15,930
.حقًّا؟ هذا بيتي لا غير

236
00:17:15,930 --> 00:17:18,260
.قصر العائلة الرّئيسيّة أكبر منه بكثير

237
00:17:18,260 --> 00:17:19,100
ماذا؟

238
00:17:19,490 --> 00:17:21,990
.يعيش والداي هناك

239
00:17:21,990 --> 00:17:24,870
.أنا وخدمي فقط من نعيش هنا

240
00:17:25,820 --> 00:17:28,770
.لا أصدّق أنّ هذا المكان مخصّص له وحده

241
00:17:28,770 --> 00:17:31,230
.لا بدّ أنّ عائلته ثريّة للغاية

242
00:17:36,570 --> 00:17:41,960
بما أنّك عروسي، فمن اليوم
.فصاعدًا، هذا بيتك أيضًا

243
00:17:42,510 --> 00:17:44,220
...عروسه

244
00:17:44,700 --> 00:17:48,050
ماذا يفترض بالعروس أن تفعل؟

245
00:17:49,990 --> 00:17:52,960
لحظة، هل هذا يعني أنّنا سنتزوّج؟

246
00:17:53,540 --> 00:17:56,000
ماذا تفعل توكو وخطيبها؟

247
00:18:00,180 --> 00:18:02,720
.أشعر فجأةً بالتّوتّر

248
00:18:03,070 --> 00:18:05,240
.ما بك؟ احمرّ وجهك

249
00:18:05,240 --> 00:18:08,230
.أنا... أنا متوتّرة قليلاً

250
00:18:08,550 --> 00:18:11,840
.فهمت. أنت جميلة حتّى وأنت متوتّرة

251
00:18:11,840 --> 00:18:13,230
.يا إلهي

252
00:18:13,570 --> 00:18:17,100
لم تمضِ سوى أيّام قليلة
،منذ أن التقيتُ برييا

253
00:18:17,100 --> 00:18:19,750
.لكنّ حياتي تغيّرت كثيرًا

254
00:18:21,760 --> 00:18:24,800
.أهلاً بك يا يوزو. يا عروسي

255
00:18:26,690 --> 00:18:30,200
.أتطلّع إلى التّعرّف عليك

256
00:18:33,920 --> 00:18:36,500
،سأكذب لو قلتُ أنّني لستُ قلقة

257
00:18:36,990 --> 00:18:42,090
.لكنّني أريد أن أؤمن بدفء يديه

258
00:18:44,630 --> 00:18:47,330
.هذا بيتي الجديد

259
00:19:02,300 --> 00:19:03,490
!يوتا

260
00:19:07,370 --> 00:19:09,130
يوتا، هل أنت بخير؟

261
00:19:09,130 --> 00:19:10,670
.نعم

262
00:19:13,270 --> 00:19:15,170
.أنا على قيد الحياة

263
00:19:18,050 --> 00:19:20,120
.كانت قوّته مرعبة

264
00:19:20,590 --> 00:19:23,260
لكن إن كانت هذه الحروق
،هي كلّ ما عانيتُ منه

265
00:19:23,260 --> 00:19:24,810
.فلا بدّ أنّه كان يكبح جماحه

266
00:19:26,010 --> 00:19:27,610
...عروسه

267
00:19:27,610 --> 00:19:31,600
.لا أصدّق أنّ أختك هي عروس ذلك الرّجل

268
00:19:32,030 --> 00:19:34,390
.ذ-ذلك غير ممكن

269
00:19:34,390 --> 00:19:37,520
.لن تُختار أختي أبدًا لتكون عروسًا

270
00:19:37,520 --> 00:19:42,240
.يوتا-كُن، قال ذلك الرّجل أنّه كيريوين

271
00:19:42,240 --> 00:19:43,530
هل هذا صحيح؟

272
00:19:43,530 --> 00:19:46,030
.نعم، هذا صحيح

273
00:19:46,420 --> 00:19:48,920
.كان ذلك كيريوين رييا-ساما

274
00:19:50,330 --> 00:19:54,290
بصفته غولاً، فهو أعلى رتبة
.من جميع الشّياطين

275
00:19:54,700 --> 00:19:57,290
واختار يوزو عروسًا له؟

276
00:19:57,630 --> 00:20:02,310
.أمّي، مستحيل أن يختارها شخص مثله

277
00:20:02,700 --> 00:20:05,980
ربّما شعر بالشّفقة عليها فقط
.لأنّها كانت مصابة

278
00:20:05,110 --> 00:20:06,020
.كارين

279
00:20:07,080 --> 00:20:10,310
.ذلك الرّجل ليس بهذا اللّين

280
00:20:11,010 --> 00:20:15,030
،حتّى لو كان هناك من يُحتضر أمامه
سيتجاهله كائنًا من كان

281
00:20:15,030 --> 00:20:17,890
.كأنّه حجر في الشّارع إلاّ إذا كانت عروسه

282
00:20:20,560 --> 00:20:24,320
عزيزي، هل من سبيل لاستعادة يوزو؟

283
00:20:24,320 --> 00:20:28,830
.لكنّني وقّعتُ أوراق التّبنّي سلفًا

284
00:20:29,130 --> 00:20:32,230
.لقد ربّيناها طوال هذا الوقت

285
00:20:32,230 --> 00:20:35,260
.إنّها عنيدة فحسب

286
00:20:35,260 --> 00:20:36,840
.أنتِ محقّة

287
00:20:37,400 --> 00:20:39,090
ماذا يحدث هنا؟

288
00:20:40,140 --> 00:20:42,810
يوتا-كُن، هل يمكنك مساعدتنا؟

289
00:20:42,810 --> 00:20:44,850
.نعم، لا بدّ من وجود حلّ

290
00:20:44,850 --> 00:20:49,350
.تغيّرت مواقفهما بسرعة كبيرة

291
00:20:50,470 --> 00:20:51,470
.لا أستطيع

292
00:20:51,470 --> 00:20:53,860
.تكبّد يوتا هزيمة مخزية أيضًا

293
00:20:54,120 --> 00:20:58,270
.إنّه ليس شخصًا يُمكنني التّحدّث إليه أبدًا

294
00:20:58,270 --> 00:21:01,860
.كنتُ أظنّ أنّ الشّياطين الثّعالب أقوياء

295
00:21:03,180 --> 00:21:04,860
.لن أقبل بهذا

296
00:21:05,260 --> 00:21:06,250
كارين؟

297
00:21:07,210 --> 00:21:10,550
.العرائس هنّ المختارات. نحن مميّزات

298
00:21:10,550 --> 00:21:13,760
.لا أصدّق أنّ أختي اُختيرت

299
00:21:14,300 --> 00:21:15,630
،ليس هذا فحسب

300
00:21:16,440 --> 00:21:20,630
.بل اُختيرت من قِبل غول جميل وقويّ

301
00:21:33,970 --> 00:21:35,700
.أرجوك يا يوتا

302
00:21:36,690 --> 00:21:39,150
.أعد أختي

303
00:21:39,150 --> 00:21:41,720
.سأنتزعها من ذلك الرّجل

304
00:21:41,720 --> 00:21:43,150
.كارين

305
00:21:43,730 --> 00:21:45,660
.إنّهم عائلة كيريوين

306
00:21:46,100 --> 00:21:48,030
.المخاطرة كبيرة جدًّا

307
00:21:48,030 --> 00:21:51,660
،لم يكبح جماحه سابقًا من أجلي

308
00:21:51,660 --> 00:21:55,030
بل للحفاظ على علاقته بعائلة
.كوغيتسو والشّياطين الثّعالب الآخرين

309
00:21:56,860 --> 00:22:02,770
لو فعلتُ ما هو أسوأ
.بتلك المرأة، لكنتُ ميتًا الآن

310
00:22:05,810 --> 00:22:10,030
.لكنّ كارين تطلب منّي فعل ذلك

311
00:22:12,440 --> 00:22:13,680
.حسنًا

312
00:22:13,990 --> 00:22:20,180
مهما كان، سأجعل أيّ رجل
.يُسيء إلى عروسي يدفع الثّمن