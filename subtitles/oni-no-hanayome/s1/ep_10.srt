1
00:00:10,730 --> 00:00:13,650
.أشعر بتوتّر شديد

2
00:00:14,180 --> 00:00:15,830
.بالتّأكيد

3
00:00:15,830 --> 00:00:20,030
هذه أوّل مرّة تقابلين فيها
.والديْ رييا-ساما

4
00:00:20,390 --> 00:00:25,300
يوكينو-سان، قابلتِ والديْ
رييا من قبل، أليس كذلك؟

5
00:00:25,300 --> 00:00:28,550
.نعم. كنتُ أعمل في المنزل الرّئيسيّ

6
00:00:28,880 --> 00:00:33,150
.كيف هما؟ أنا قلقة

7
00:00:33,960 --> 00:00:39,740
ماذا لو لم يُعجبا بي
أو لم يقبلاني عروسًا له؟

8
00:00:40,720 --> 00:00:42,330
.لا تقلقي

9
00:00:42,330 --> 00:00:46,560
بل على العكس، سيُعجبان بك بشدّة
.ولن يستطيعا مقاومة جاذبيّتك

10
00:00:46,560 --> 00:00:49,050
أ-أتعتقدين ذلك؟

11
00:00:58,900 --> 00:01:02,320
.بالكاد أتعرّف على نفسي

12
00:01:02,580 --> 00:01:06,170
.تبدين جميلة. هذا الزّيّ يليق بك

13
00:01:06,550 --> 00:01:09,330
.شـ-شكرًا لك

14
00:01:09,890 --> 00:01:10,960
.يوزو

15
00:01:19,320 --> 00:01:21,470
.يبدو أنّك مستعدّة

16
00:01:22,180 --> 00:01:23,400
.رييا

17
00:01:23,720 --> 00:01:28,950
.عفوًا... شكرًا لك على الكيمونو الجميل

18
00:01:29,860 --> 00:01:32,620
.لم أرتدِ شيئًا كهذا من قبل

19
00:01:33,460 --> 00:01:34,620
ما رأيك؟

20
00:01:38,370 --> 00:01:39,700
.تبدين رائعة الجمال

21
00:01:40,950 --> 00:01:45,030
أتمنّى لو أستطيع حبسك
.حتّى لا يراك أحدٌ هكذا

22
00:01:47,090 --> 00:01:51,580
،أستطيع الآن تقبّل كلمات رييا الرّقيقة

23
00:01:51,890 --> 00:01:57,950
ربّما لأنّني أخبرته بمشاعري
.وتقبّلتُ حبّي له

24
00:03:39,530 --> 00:03:42,470
.الهواء نقيٌّ جدًّا

25
00:03:43,000 --> 00:03:46,670
ربّما لأنّنا معزولون تمامًا
.عن العالم الخارجيّ

26
00:03:47,090 --> 00:03:52,050
أقام كبار العشائر المختلفة
.حواجز حول هذا المكان

27
00:03:52,050 --> 00:03:53,740
.فهمت

28
00:03:53,740 --> 00:03:57,720
لا يستطيع الوصول إلى القصر
.إلاّ من يحمل دعوة

29
00:03:57,720 --> 00:04:03,910
أيّ شخص يحاول الدّخول بدون دعوة
.سيتيه في هذه الغابة الكثيفة إلى الأبد

30
00:04:05,260 --> 00:04:08,220
هل يدرك كم يبدو هذا مرعبًا؟

31
00:04:30,840 --> 00:04:33,440
.والدا رييا هنا

32
00:04:34,270 --> 00:04:38,120
هل سيقبلانني؟

33
00:04:41,090 --> 00:04:42,020
.هيّا ندخل

34
00:04:57,000 --> 00:04:58,250
.مِن هنا

35
00:05:10,030 --> 00:05:11,580
.المكان صاخبٌ جدًّا

36
00:05:14,300 --> 00:05:15,200
ماذا؟

37
00:05:16,690 --> 00:05:21,220
.لكنّني لا أسمع شيئًا. لا يوجد أحد هنا

38
00:05:21,480 --> 00:05:23,960
،لا يستطيع البشر رصدهم

39
00:05:24,270 --> 00:05:27,670
لكن هناك مجموعة كبيرة في القاعة الكبرى
.في الجزء الخلفيّ من الطّابق الأوّل

40
00:05:28,140 --> 00:05:30,090
.يبدو أنّهم يستمتعون كثيرًا

41
00:05:30,710 --> 00:05:32,340
مجموعة كبيرة؟

42
00:05:32,340 --> 00:05:35,980
...لا بأس. المشكلة الأكبر هي

43
00:05:39,220 --> 00:05:41,240
.لا عليكِ. لا شيء

44
00:05:42,660 --> 00:05:47,240
.عليك إخباري الآن. أنت تُقلقني

45
00:05:47,980 --> 00:05:52,040
.ابقي قريبة منّي
.لا داعي للقلق بشأن أيّ شيء

46
00:05:52,720 --> 00:05:53,980
.حسنًا

47
00:06:00,120 --> 00:06:03,460
.والدا رييا هنا

48
00:06:03,870 --> 00:06:05,730
.أتساءل كيف هما

49
00:06:06,740 --> 00:06:08,790
.لا داعي للتّوّتر

50
00:06:08,790 --> 00:06:11,550
.في الحقيقة، لن يدوم توتّرك طويلاً

51
00:06:11,550 --> 00:06:13,770
ماذا يعني هذا؟

52
00:06:23,290 --> 00:06:26,270
—تـ-تشرّفت بلقائكم. أنا

53
00:06:29,380 --> 00:06:30,020
ماذا؟

54
00:06:30,020 --> 00:06:32,030
!لا بدّ أنّك يوزو-تشان

55
00:06:32,030 --> 00:06:36,060
!كنّا متشوّقين لرؤيتك

56
00:06:36,060 --> 00:06:37,670
...عفوًا

57
00:06:38,660 --> 00:06:41,260
!سارا-تشان، وأنا أيضًا

58
00:06:41,260 --> 00:06:42,290
ما-ماذا؟

59
00:06:44,790 --> 00:06:48,760
!أبي، أمّي، أنتما تُخيفان يوزو

60
00:06:48,760 --> 00:06:50,300
!ماذا؟

61
00:06:50,630 --> 00:06:53,310
أبوه وأمّه؟

62
00:06:53,310 --> 00:06:55,310
.هيّا، قليلاً فقط

63
00:06:55,310 --> 00:06:57,810
.لم أتمكّن من معانقتها بعد

64
00:06:58,160 --> 00:07:01,970
لحظة، هل هذان والدا رييا؟

65
00:07:02,820 --> 00:07:05,730
.ظننتُ أنّهما سيكونان أكثر صرامة

66
00:07:06,920 --> 00:07:12,020
عفوًا، هل هذا الشّخصان هما والدك بالفعل؟

67
00:07:12,020 --> 00:07:15,930
.للأسف، هما والداي الحقيقيّان بالفعل

68
00:07:15,930 --> 00:07:17,330
للأسف"؟"

69
00:07:17,330 --> 00:07:18,340
.هذا ليس لطيفًا

70
00:07:18,680 --> 00:07:21,800
.أنا والد رييا-كُن، سِنيا

71
00:07:21,800 --> 00:07:23,830
.أنا والدته سارة

72
00:07:24,140 --> 00:07:25,820
.أ-أنا يوزو

73
00:07:25,820 --> 00:07:28,770
أرأيتِ؟ لم تعودي متوتّرة، أليس كذلك؟

74
00:07:28,770 --> 00:07:30,620
.معك حقّ

75
00:07:31,090 --> 00:07:34,520
.إنّ رييا-سان يعتني بي عناية فائقة

76
00:07:34,520 --> 00:07:36,960
.يسعدني لقاؤكما كثيرًا

77
00:07:36,960 --> 00:07:38,650
.أتطلّع إلى التّعرّف عليكما

78
00:07:46,480 --> 00:07:48,630
.يسعدني لقاؤك أيضًا

79
00:07:48,630 --> 00:07:50,600
.تشرّفت بلقائك يا يوزو-تشان

80
00:07:51,100 --> 00:07:52,210
.شكرًا لكما

81
00:07:54,740 --> 00:07:58,940
اشترينا كمّيّة كبيرة من الحلويّات
.لأنّنا سمعنا أنّك قادمة

82
00:07:59,300 --> 00:08:02,180
هل تفضّلين الحلويّات الغربيّة أم اليابانيّة؟

83
00:08:04,400 --> 00:08:05,530
ما الأمر؟

84
00:08:06,900 --> 00:08:11,240
.نسيت أن أحضر هديّة لوالديك

85
00:08:11,240 --> 00:08:12,510
ماذا أفعل؟

86
00:08:12,510 --> 00:08:16,250
.لا داعي للقلق

87
00:08:16,250 --> 00:08:19,510
.نعم، يمكننا أن نأكلها معًا

88
00:08:19,820 --> 00:08:23,310
.لا بأس يا يوزو، لا تقلقي

89
00:08:30,090 --> 00:08:31,480
ما الأمر؟

90
00:08:31,770 --> 00:08:35,690
.نحن نعتذر. إنّنا مندهشان قليلاً فحسب

91
00:08:35,690 --> 00:08:39,760
.نعم، لم نكن نعلم أنّك بهذا اللّطف

92
00:08:43,490 --> 00:08:46,540
هل رييا-كُن لطيف معك؟

93
00:08:46,540 --> 00:08:48,270
.نـ-نعم

94
00:08:48,270 --> 00:08:49,790
فعلاً؟

95
00:08:49,790 --> 00:08:52,360
هل يبتسم كثيرًا في حضورك؟

96
00:08:52,660 --> 00:08:53,920
.نعم

97
00:08:53,920 --> 00:08:55,560
فعلاً؟

98
00:08:55,560 --> 00:08:58,550
.أخبرينا المزيد عنكما

99
00:08:58,550 --> 00:09:00,020
...عفوًا

100
00:09:00,020 --> 00:09:03,170
.أبي، أمّي، اهدآ قليلاً

101
00:09:13,420 --> 00:09:14,200
!اللّعنة

102
00:09:14,580 --> 00:09:16,340
أين هم؟

103
00:09:17,560 --> 00:09:22,700
.أشعر وكأنّنا ندور في حلقة مفرغة

104
00:09:23,170 --> 00:09:25,140
.يجب أن يكونوا هنا

105
00:09:26,100 --> 00:09:28,800
،بمجرّد أن نجد القصر ونسأل يوزو

106
00:09:28,800 --> 00:09:31,740
أنا متأكّد أنّ عائلة كيريوين
.ستقدّم لنا مساعدة ماليّة

107
00:09:31,740 --> 00:09:35,720
.نعم. يوزو ليست مثل كارين

108
00:09:36,000 --> 00:09:39,530
.إنّها لا ترفض لنا طلبًا أبدًا

109
00:09:43,100 --> 00:09:46,690
من الأفضل أن ننطلق
.قبل أن يغضب النّاس منّا

110
00:09:47,070 --> 00:09:49,290
.المأدبة هذا العام على وشك الانتهاء

111
00:09:49,990 --> 00:09:52,970
هل نُعرّفك على الجميع؟

112
00:10:04,160 --> 00:10:05,310
.سِنيا-ساما

113
00:10:07,410 --> 00:10:08,740
فعلاً؟

114
00:10:09,640 --> 00:10:14,050
يبدو أنّ والديكِ سمعا عن المأدبة
من عروس الشّيطان الثّعلب

115
00:10:14,050 --> 00:10:17,010
.ودخلا إلى المكان دون إذن

116
00:10:17,350 --> 00:10:18,390
ماذا؟

117
00:10:20,620 --> 00:10:22,950
والداي؟

118
00:10:23,920 --> 00:10:28,020
هل يُعقل أنّهما أتيا لرؤيتي؟
...ولكن

119
00:10:28,540 --> 00:10:34,540
رييا، ألم تقل أنّ كلّ من يدخل
دون إذن سيظلّ تائهًا للأبد؟

120
00:10:35,360 --> 00:10:37,510
.لا بأس يا يوزو-تشان

121
00:10:37,510 --> 00:10:40,290
.سنرسل من يصطحبهما في النّهاية

122
00:10:42,130 --> 00:10:46,800
لكن ربّما سنعاقبهما بجعلهما
.ينتظران حتّى بعد المأدبة

123
00:10:46,800 --> 00:10:51,410
ربّما تكون هذه محاولة يائسة
.أخيرة لطلب مساعدتك

124
00:10:51,830 --> 00:10:54,390
قطعت عشيرة الشّياطين الثّعالب
.مساعداتها لهما

125
00:10:54,390 --> 00:10:56,130
ماذا؟ فعلاً؟

126
00:10:56,130 --> 00:10:58,560
مع أنّ كارين عروسهم؟

127
00:10:59,320 --> 00:11:01,790
.كان هذا قرار كبيرة عشيرتهم

128
00:11:02,360 --> 00:11:07,350
كان هذا عقابهم على استخدام
.قوّة ثعلب للاقتراب منك

129
00:11:08,640 --> 00:11:13,290
سيُجبَر والداك أيضًا
.على الانتقال بعيدًا قريبًا

130
00:11:13,650 --> 00:11:15,650
.لن يرياك مجدّدًا

131
00:11:16,220 --> 00:11:19,010
.لم أكن أعلم أنّ الأمر سيتفاقم إلى هذا الحدّ

132
00:11:19,780 --> 00:11:25,920
إنّ إيذاءك يعني الدّخول
.في صراع مع عشيرة كيريوين

133
00:11:26,670 --> 00:11:32,550
أتمنّى أن تبقى أختك
.عروسهم حتىّ نهاية المأدبة

134
00:11:36,390 --> 00:11:37,810
ماذا يعني هذا؟

135
00:11:38,920 --> 00:11:39,800
.هيّا بنا

136
00:11:53,070 --> 00:11:55,000
.تعالي معي الآن

137
00:11:56,370 --> 00:11:58,150
.هيّا

138
00:11:59,460 --> 00:12:01,950
!هيّا بنا

139
00:12:02,780 --> 00:12:06,430
!سيّدي، شكرًا لحضورك

140
00:12:12,720 --> 00:12:16,240
.إنّهم حقًّا في قمّة مجتمع الشّياطين

141
00:12:20,730 --> 00:12:23,620
يا سيّدي، هل هذه هي؟

142
00:12:23,620 --> 00:12:26,770
.نعم، هذه هي عروس ابني المستقبليّة

143
00:12:26,770 --> 00:12:30,710
ماذا؟ وجد السّيّد الشّابّ عروسه؟

144
00:12:50,160 --> 00:12:51,470
هل أنت متعبة؟

145
00:12:52,470 --> 00:12:54,430
.أ-أنا بخير

146
00:12:57,360 --> 00:12:58,750
.شكرًا لكما

147
00:13:02,780 --> 00:13:06,750
لكن لماذا لم أدخل معك؟

148
00:13:06,990 --> 00:13:09,840
،إنّ تقديمك من طرف والدي
،كبير العشيرة الحاليّ

149
00:13:09,840 --> 00:13:14,530
.يؤكّد قبول آل كيريوين لكِ كعروس

150
00:13:14,970 --> 00:13:17,520
.بهذه الطّريقة، نستطيع حمايتك

151
00:13:17,520 --> 00:13:19,780
.إذن هذا هو السّبب

152
00:13:28,750 --> 00:13:30,360
ماذا تفعل هنا؟

153
00:13:31,740 --> 00:13:34,830
.عشيرة كوغيتسو عشيرة مرموقة

154
00:13:35,260 --> 00:13:39,510
.ليس من الغريب أن يحضروا مع عرائسهم

155
00:13:40,690 --> 00:13:42,140
.فهمت

156
00:13:42,770 --> 00:13:44,150
هل تريدين شيئًا لتأكليه؟

157
00:13:45,610 --> 00:13:46,620
.نعم

158
00:13:58,490 --> 00:14:01,810
.لم تعد كارين أختي الصّغيرة

159
00:14:02,490 --> 00:14:05,860
.لن نسلك نفس الطّريق مرّة أخرى

160
00:14:21,510 --> 00:14:23,060
ماذا هناك؟

161
00:14:23,660 --> 00:14:24,780
...نعم

162
00:14:29,700 --> 00:14:31,520
.إنّها كبيرة عشيرة الثّعالب

163
00:14:35,720 --> 00:14:37,030
.إنّها جميلة جدًّا

164
00:14:37,350 --> 00:14:42,520
كوسِتسو ناديشيكو. إنّها ثعلبة
.ذات تسعة ذيول، وأكبر من والدي

165
00:14:43,360 --> 00:14:45,150
ماذا؟ حقًّا؟

166
00:14:50,350 --> 00:14:52,890
هل هي قادمة إلينا؟

167
00:14:53,360 --> 00:14:54,850
.على ما يبدو

168
00:15:05,790 --> 00:15:09,320
.لديك عروس جميلة جدًّا أيّها السّيّد الشّابّ

169
00:15:09,320 --> 00:15:12,470
.أعلم ذلك. لستِ بحاجة لإخباري

170
00:15:14,220 --> 00:15:15,950
.أنت مغرم بها بشدّة

171
00:15:17,320 --> 00:15:18,700
.أنا ناديشيكو

172
00:15:19,800 --> 00:15:23,080
.أنا شينونومي يوزو. تشرّفت بمعرفتك

173
00:15:27,110 --> 00:15:31,570
.أساء أحد أفراد عشيرتي إليك

174
00:15:31,570 --> 00:15:33,180
.أرجو منك أن تسامحيه

175
00:15:38,210 --> 00:15:41,080
.لا بأس، لم يكن الأمر جللاً

176
00:15:41,080 --> 00:15:42,620
.لا تقلقي بشأن ذلك

177
00:15:47,050 --> 00:15:49,340
.أنت فتاة لطيفة

178
00:15:50,550 --> 00:15:55,970
.ليت عروسه كانت بمثل كرمك

179
00:16:01,980 --> 00:16:06,070
.لا يهمّ. أنا سعيدة برؤيتك

180
00:16:07,840 --> 00:16:08,960
.المعذرة

181
00:16:13,490 --> 00:16:15,950
.كـ-كنتُ متوتّرة للغاية

182
00:16:16,960 --> 00:16:22,770
حسنًا، إنّ نفوذها بين الشّياطين
.لا يقلّ إلاّ عن نفوذ والدي

183
00:16:22,770 --> 00:16:24,830
هل هي بهذه القوّة؟

184
00:16:25,250 --> 00:16:27,580
.يبدو أنّها معجبة بك

185
00:16:27,900 --> 00:16:30,200
أتظنّ ذلك؟

186
00:16:30,200 --> 00:16:32,840
.والآن، استرخي واستمتعي بوقتك

187
00:16:35,160 --> 00:16:38,020
.سأذهب إلى الحمّام

188
00:16:38,850 --> 00:16:40,140
هل أذهب معك؟

189
00:16:40,560 --> 00:16:42,970
.سـ-سأكون بخير وحدي

190
00:16:56,610 --> 00:16:58,270
.يجب أن أعود بسرعة

191
00:17:14,610 --> 00:17:15,870
...كارين

192
00:17:18,430 --> 00:17:24,210
.كنتُ صغيرةً جدًّا لأتذّكر ولادة كارين

193
00:17:25,900 --> 00:17:27,570
.إنّها صغيرة جدًّا

194
00:17:37,180 --> 00:17:42,430
لطالما كانت كارين محور
.عائلتنا، منذ نعومة أظفاري

195
00:17:43,160 --> 00:17:45,940
،تمنّيتُ لو أنّ والديّ دلّلاني أكثر

196
00:17:46,370 --> 00:17:49,530
.لذا كنتُ أغار دائمًا من أختي الصّغيرة

197
00:17:50,530 --> 00:17:57,540
لكنّ طريقة كارين في المشي
.خلفي كانت لطيفة

198
00:18:21,160 --> 00:18:22,350
هل أستطيع مساعدتك؟

199
00:18:23,320 --> 00:18:24,920
هل أنتِ جادّة؟

200
00:18:24,920 --> 00:18:28,570
.أنا أعاني لأنّه تمّ التّخلّي عنّا بسببك

201
00:18:28,980 --> 00:18:32,550
ألا يهمّك الأمر؟ ألا تشعرين بأيّ ذنب؟

202
00:18:32,550 --> 00:18:35,470
.لم أفعل شيئًا

203
00:18:36,020 --> 00:18:39,420
أنت المخطئة لعدم عودتك
.إلى المنزل حتّى الآن

204
00:18:39,420 --> 00:18:42,450
.كيريوين رييا لديه حبيب بالفعل

205
00:18:42,450 --> 00:18:44,520
.لن تكوني سعيدة أبدًا

206
00:18:44,970 --> 00:18:49,140
.قال رييا أنّها مجرّد إشاعة

207
00:18:49,140 --> 00:18:52,810
!هذا ليس صحيحًا! إنّه يكذب عليك

208
00:18:52,810 --> 00:18:54,140
!عودي إلى المنزل

209
00:18:56,060 --> 00:18:57,230
لماذا؟

210
00:18:57,640 --> 00:19:02,610
!لأنّك عاديّة جدًّا لتكوني عروسًا

211
00:19:09,270 --> 00:19:15,030
لماذا تصرّين على أنّني لستُ عروسه؟

212
00:19:15,320 --> 00:19:19,580
.أ-أنا فقط أهتمّ لأمرك

213
00:19:20,620 --> 00:19:23,190
أليس هذا لأنّك تتألّمين؟

214
00:19:23,720 --> 00:19:27,220
أليس هذا سبب عدم تقبّلك للأمر؟

215
00:19:28,000 --> 00:19:29,740
أتألّم؟

216
00:19:30,760 --> 00:19:32,040
أنا؟

217
00:19:33,670 --> 00:19:37,870
.كارين، أنتِ أنانيّةٌ دائمًا

218
00:19:37,870 --> 00:19:41,930
.نحن بحاجةٍ إلى أموالهم. اعتذري ليوزو

219
00:19:43,540 --> 00:19:48,950
لكن لا يمكننا البقاء في عشيرة الشّياطين
.الثّعالب إذا عصينا ناديشيكو-ساما

220
00:19:48,950 --> 00:19:50,910
.تحلّي بالصّبر حاليًّا لو سمحت

221
00:19:53,690 --> 00:19:55,210
من تظنّين نفسك؟

222
00:19:55,580 --> 00:19:59,530
.أبي وأمّي لا يحبّانكِ أصلاً

223
00:19:59,530 --> 00:20:01,610
.أنتِ مجرّد فتاة صغيرة مسكينة

224
00:20:02,380 --> 00:20:06,890
هل تعتقدين حقًّا أنّ كيريوين رييا يحبّك؟

225
00:20:06,890 --> 00:20:12,600
!هذا مستحيل! لن يحتاجك أحد أبدًا

226
00:20:12,600 --> 00:20:15,340
!حتّى عائلتك لا تحبّك

227
00:20:17,070 --> 00:20:18,680
...مع أنّني أعرف ذلك

228
00:20:19,270 --> 00:20:22,210
.يؤلمني أن يُذكّرني أحد بهذا

229
00:20:22,210 --> 00:20:26,280
.بالطّبع نحن نعتزّ بكارين. إنّها عروس

230
00:20:26,280 --> 00:20:28,360
.عليك فقط أن تتقبّلي الأمر يا يوزو

231
00:20:30,560 --> 00:20:33,290
مع ذلك، كنتُ ما زلتُ أرغب
.في أن يُحبّني والداي

232
00:20:33,720 --> 00:20:36,440
.التّشبّث بذلك الأمل الخافت آلمني

233
00:20:37,600 --> 00:20:40,880
ماذا؟ لا يمكنك حتّى الرّدّ، أليس كذلك؟

234
00:20:40,880 --> 00:20:44,580
.لأنّك تعلمين أنّ الأمر صحيح، لا أحد يحبّك

235
00:20:45,290 --> 00:20:48,350
.أنت محقّة. هذا صحيح

236
00:20:49,390 --> 00:20:51,220
أرأيت؟

237
00:20:51,220 --> 00:20:56,100
.لكنّ هذا لم يعد مهمًّا

238
00:20:57,230 --> 00:20:58,610
لم يعد مهمًّا؟

239
00:20:59,530 --> 00:21:00,740
...في ذلك اليوم

240
00:21:04,380 --> 00:21:09,670
تحرّر التّوتّر الّذي تراكم
.من تحمّل كلّ شيء

241
00:21:13,490 --> 00:21:16,720
.لكنّي قابلتُ رييا بعد ذلك

242
00:21:18,380 --> 00:21:22,110
.في مرحلة ما، تغلّبتُ عليه

243
00:21:22,760 --> 00:21:26,290
.سأنساكم من الآن فصاعدًا

244
00:21:28,160 --> 00:21:33,800
لستُ بحاجة إليك ولا إلى أبي
.ولا إلى أمّي في حاضري أو مستقبلي

245
00:21:35,250 --> 00:21:38,810
.لأنّني سعيدةٌ جدًّا الآن

246
00:21:45,380 --> 00:21:46,570
!كارين

247
00:21:51,070 --> 00:21:55,560
!كلّ هذا خطؤك! إنّه خطؤك

248
00:21:55,560 --> 00:21:56,520
!توقّفي

249
00:21:58,950 --> 00:22:00,240
!اهدئي

250
00:22:21,240 --> 00:22:22,630
ماذا؟