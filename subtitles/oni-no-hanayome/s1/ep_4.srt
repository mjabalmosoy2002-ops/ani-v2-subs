1
00:00:20,430 --> 00:00:23,960
،في اللّحظة الّتي يلتقون فيها بعرائسهم

2
00:00:24,370 --> 00:00:28,900
يقول البعض أنّهم شعروا
.بانجذاب سحريّ نحوهنّ

3
00:00:28,900 --> 00:00:33,600
.ويقول آخرون أنّ قلوبهم بدأت تخفق بشدّة

4
00:00:35,100 --> 00:00:38,850
هل هناك عروسٌ لي؟

5
00:00:39,490 --> 00:00:41,080
...إذا التقيتُ بها

6
00:00:42,510 --> 00:00:47,610
هل ستملأ الفراغ الّذي أشعر به دائمًا؟

7
00:01:00,830 --> 00:01:03,100
ما هذا؟

8
00:01:15,890 --> 00:01:16,950
!أوقف السّيّارة

9
00:01:28,200 --> 00:01:33,200
.قال كلّ شيطانٍ كانت له عروسٌ الشّيء نفسه

10
00:01:33,200 --> 00:01:36,640
.عندما تقابلها، ستعرف فورًا

11
00:02:07,370 --> 00:02:08,570
.لقد وجدتها

12
00:02:10,640 --> 00:02:13,380
.إنّها عروسي، ولن تكون لغيري

13
00:04:13,660 --> 00:04:14,850
.يوزو

14
00:04:17,610 --> 00:04:19,410
.لم أشعر هكذا من قبل

15
00:04:31,810 --> 00:04:34,370
.صباح الخير يا رييا

16
00:04:34,700 --> 00:04:38,410
.صباح الخير. لا داعي للقلق حيال أيّ شيء

17
00:04:38,880 --> 00:04:41,100
.أنتِ عروسي

18
00:04:41,100 --> 00:04:43,880
.ابتداءً من اليوم، أنت سيّدة هذا المنزل

19
00:04:44,110 --> 00:04:45,190
.حسنًا

20
00:04:45,660 --> 00:04:47,190
.سأبذل قصارى جهدي

21
00:04:48,760 --> 00:04:49,790
...مهلاً

22
00:04:54,770 --> 00:04:58,370
،يسرّنا من أعماق قلوبنا

23
00:04:58,370 --> 00:05:02,470
،نحن خدم القصر
!أن نرحّب بسيّدتنا العروس

24
00:05:05,820 --> 00:05:06,870
.حاضر

25
00:05:09,380 --> 00:05:11,830
.ستعيش هنا من الآن فصاعدًا

26
00:05:11,830 --> 00:05:14,040
.هذه يوزو، عروسي

27
00:05:14,630 --> 00:05:17,420
.يـ-يسعدني لقاؤكم جميعًا

28
00:05:19,490 --> 00:05:24,020
.لا حاجة لسيّدتنا العروس إلى الانحناء لنا

29
00:05:25,090 --> 00:05:28,300
أتأذنين لنا بأن نُعرّف عن أنفسنا؟

30
00:05:28,300 --> 00:05:29,760
.نعم، تفضّلوا

31
00:05:30,100 --> 00:05:31,860
.شكرًا جزيلاً لك

32
00:05:31,860 --> 00:05:36,560
.أنا كبير الخدم واسمي دوكو

33
00:05:36,980 --> 00:05:43,480
وهذه هي يوكينو الّتي ستتولّى
.العناية بشؤون سيّدتنا العروس

34
00:05:43,480 --> 00:05:45,290
.أنا يوكينو

35
00:05:45,290 --> 00:05:48,300
.سأخدمك بكلّ إخلاص وتفانٍ

36
00:05:50,120 --> 00:05:52,550
.التقينا حين جئتُ إلى هنا أوّل مرّة

37
00:05:52,550 --> 00:05:55,710
.نعم. يُشرّقني أنّك ما زلت تتذكّرينني

38
00:05:56,000 --> 00:05:58,560
لقد جهّزتِ غرفة يوزو، أليس كذلك؟

39
00:05:58,560 --> 00:06:00,540
.نعم يا رييا-ساما

40
00:06:00,890 --> 00:06:05,240
جهّزنا أرقى المقتنيات
.الّتي تليق بسمعة آل كيريوين

41
00:06:05,240 --> 00:06:06,040
.جيّد

42
00:06:06,570 --> 00:06:09,160
.كنتُ سأكتفي بغرفة عاديّة

43
00:06:09,160 --> 00:06:11,260
تُرى كيف تبدو الغرفة؟

44
00:06:11,260 --> 00:06:12,440
.رييا-ساما

45
00:06:13,780 --> 00:06:15,670
هل لديك بعض الوقت؟

46
00:06:15,670 --> 00:06:17,420
ما الأمر يا تاكاميتشي؟

47
00:06:17,420 --> 00:06:20,670
.وصلتنا رسالة مفاجئة

48
00:06:22,140 --> 00:06:23,680
.أنا آسف يا يوزو

49
00:06:24,780 --> 00:06:29,090
أتمنّى لو أستطيع البقاء معك، لكن
.تمّ استدعائي إلى المنزل الرّئيسيّ

50
00:06:30,080 --> 00:06:31,440
المنزل الرّئيسيّ؟

51
00:06:31,440 --> 00:06:35,710
نعم. ربّما يريدون منّي
.تقديم تقرير عن عروسي

52
00:06:36,700 --> 00:06:41,080
.سأغيب لبعض الوقت، لكن يمكنك الاسترخاء

53
00:06:41,080 --> 00:06:42,380
.حسنًا

54
00:06:43,210 --> 00:06:48,090
.أشعر ببعض الحزن لبقائي هنا وحدي

55
00:06:50,610 --> 00:06:51,590
رييا؟

56
00:06:52,110 --> 00:06:53,960
.كوني فتاة مطيعة من أجلي

57
00:06:56,400 --> 00:06:58,590
.لستُ طفلة

58
00:07:01,310 --> 00:07:05,260
لم يسبق لأحد أن ربّت على
.رأسي هكذا من قبل

59
00:07:06,600 --> 00:07:10,700
.أشعر براحة كبيرة لسبب ما

60
00:07:12,110 --> 00:07:15,930
.يوزو عروسٌ عزيزة لآل كيريوين

61
00:07:15,930 --> 00:07:20,850
.عاملوها كما لو أنّ كلّ ما تقوله صادرٌ عنّي

62
00:07:20,850 --> 00:07:21,700
.حاضر

63
00:07:49,790 --> 00:07:51,390
هل حدث شيء؟

64
00:07:52,300 --> 00:07:53,390
.لا

65
00:07:55,340 --> 00:08:01,700
يقولون أنّك تُفتن بالكامل
بعروسك بمجرّد أن تلتقي بها

66
00:08:01,700 --> 00:08:05,660
.وتمنحها كلّ حبّك لبقيّة حياتك

67
00:08:06,760 --> 00:08:07,920
أهذا ما أشعر به؟

68
00:08:20,020 --> 00:08:21,930
!كم أحسدها

69
00:08:22,740 --> 00:08:25,930
.هذه غرفتك يا سيّدتي العروس

70
00:08:38,540 --> 00:08:41,170
!إ-إنّها ظريفة

71
00:08:46,060 --> 00:08:50,450
ما رأيك؟ هل أعجبتك؟

72
00:08:50,790 --> 00:08:53,470
.نعم. بل هي أظرف ممّا توقّعت

73
00:08:54,470 --> 00:08:55,810
.يسعدني سماع ذلك

74
00:08:59,720 --> 00:09:03,560
.أبلغيني إذا ما احتجتِ أيّ شيء

75
00:09:03,560 --> 00:09:04,480
.سأفعل

76
00:09:04,780 --> 00:09:05,990
...عفوًا

77
00:09:05,990 --> 00:09:06,970
ماذا؟

78
00:09:07,260 --> 00:09:13,740
قال رييا-سان أنّني سبب
.استدعائه للمنزل الرّئيسيّ

79
00:09:14,020 --> 00:09:19,530
.نعم. رييا-ساما هو كبير عائلة كيريوين التّالي

80
00:09:20,640 --> 00:09:24,360
،وقد طلب منه كبير العائلة الحاليّ
،والده سينيا-ساما

81
00:09:24,360 --> 00:09:27,530
.أن يحضر إليه لإبلاغه مباشرة

82
00:09:27,530 --> 00:09:29,740
والد رييا-سان؟

83
00:09:30,370 --> 00:09:35,640
سينيا-ساما هو أعلى سلطة
.في مجتمع الشّياطين

84
00:09:36,750 --> 00:09:42,520
.ولا أحد يضاهيه في قوّته الشّيطانيّة

85
00:09:45,140 --> 00:09:48,280
إذًا سيُخبره بأمري؟

86
00:09:48,280 --> 00:09:50,170
.آمل أن تسير الأمور على خير

87
00:09:56,310 --> 00:09:57,430
ماذا؟

88
00:09:57,430 --> 00:09:58,470
!ماذا؟

89
00:09:59,170 --> 00:10:00,310
.هذان هما

90
00:10:00,760 --> 00:10:04,170
أليس هذا هو ابننا العزيز؟

91
00:10:04,170 --> 00:10:05,840
!بلى، إنّه هو

92
00:10:07,780 --> 00:10:11,130
!مرحبًا بعودتك يا رييا-كُن

93
00:10:15,950 --> 00:10:19,500
!اتركاني يا أبي وأمّي

94
00:10:19,500 --> 00:10:23,920
.لكنّك لا تزورنا أبدًا

95
00:10:23,920 --> 00:10:26,780
.وما زلتَ وسيمًا كالعادة

96
00:10:27,090 --> 00:10:30,110
ماذا؟ لكن أين عروسك؟

97
00:10:30,110 --> 00:10:32,540
ألم تحضرها معك؟

98
00:10:32,540 --> 00:10:35,110
.يا لك من خجول

99
00:10:35,110 --> 00:10:38,110
.سأحضرها قريبًا

100
00:10:38,810 --> 00:10:40,600
!يا له من خبر مفرح

101
00:10:40,600 --> 00:10:42,530
.أخبرنا كلّ شيء

102
00:10:42,530 --> 00:10:46,560
كيف هي؟ وما الّذي أعجبك فيها؟

103
00:10:46,560 --> 00:10:52,390
،لا شكّ أنّ عروسك رائعة
.لكنّنا متشوّقان لمعرفة المزيد عنها

104
00:10:59,350 --> 00:11:01,260
.أنتِ عروسي

105
00:11:01,260 --> 00:11:03,890
.ابتداءً من اليوم، أنت سيّدة هذا المنزل

106
00:11:04,890 --> 00:11:07,480
.عروس. سيّدة المنزل

107
00:11:08,330 --> 00:11:10,330
هل هذا صحيح حقًّا؟

108
00:11:11,270 --> 00:11:16,080
هل سيقول رييا يومًا ما
أنّه لا يحتاجني أيضًا؟

109
00:11:17,690 --> 00:11:21,310
هل أنا حقًّا عروسه؟

110
00:11:25,750 --> 00:11:29,490
.يبدو أنّكما تحبّان هذه الغرفة

111
00:11:41,390 --> 00:11:43,850
يا سيّدتي العروس؟ ما الأمر؟

112
00:11:43,850 --> 00:11:45,410
!سأخرج لبعض الوقت

113
00:11:46,550 --> 00:11:48,260
!ا-انتظري

114
00:11:48,490 --> 00:11:50,830
!نسيت الأمر تمامًا بسبب كلّ ما حدث

115
00:11:51,550 --> 00:11:53,160
!لديّ عمل

116
00:12:00,340 --> 00:12:02,210
.بالكاد وصلت

117
00:12:03,170 --> 00:12:05,410
ماذا؟ ما الّذي يجري؟

118
00:12:05,790 --> 00:12:09,120
.مرحبًا. آسفة على التّأخير

119
00:12:09,120 --> 00:12:10,990
.لم أقصد ذلك

120
00:12:11,560 --> 00:12:14,490
.سمعتُ أنّك استقلت

121
00:12:14,490 --> 00:12:16,290
ماذا؟ استقلت؟

122
00:12:16,610 --> 00:12:21,040
.اتّصل أولياء أمرك ليقولوا أنّك ستستقيلين

123
00:12:21,270 --> 00:12:22,790
...لكن

124
00:12:23,690 --> 00:12:25,730
هل هذه مزحة؟

125
00:12:26,580 --> 00:12:28,510
.اسمح لي بالعمل رجاءً

126
00:12:28,510 --> 00:12:30,400
.لا يمكنني ذلك

127
00:12:30,400 --> 00:12:33,410
يحتاج تلاميذ المرحلة الثّانويّة
،إلى موافقة أولياء أمورهم للعمل

128
00:12:33,410 --> 00:12:36,060
.ولقد وجدتُ بديلاً لك بالفعل

129
00:12:40,760 --> 00:12:43,290
،الآن وقد قطعتُ علاقتي بوالديّ

130
00:12:43,290 --> 00:12:46,300
.عليّ أن أتكفّل بنفقات تعليمي بنفسي

131
00:12:46,690 --> 00:12:50,580
أتساءل إن كان بإمكاني فعل
.ذلك أثناء دراستي

132
00:12:50,580 --> 00:12:53,690
.قد أضطرّ لترك الدّراسة

133
00:12:58,370 --> 00:12:59,560
.توكو

134
00:13:04,230 --> 00:13:07,430
نحن على وشك الوصول
.إلى منزل توكو ونيانكيتشي-كُن

135
00:13:08,470 --> 00:13:11,810
—أجبتِ أخيرًا. كنت أحاول

136
00:13:12,140 --> 00:13:14,320
!توكو

137
00:13:14,320 --> 00:13:15,570
مهلاً، ما الأمر؟

138
00:13:15,880 --> 00:13:19,470
.لا أعرف ماذا أفعل

139
00:13:19,470 --> 00:13:24,660
،عرفتُ فجأة أنّني عروس
.وقد أضطرّ لترك المدرسة

140
00:13:24,660 --> 00:13:28,550
يوزو، تعالي إلى منزلنا. سأستمع
.إلى كلّ ما لديك لتقوليه

141
00:13:29,660 --> 00:13:31,990
.توكو لطيفة جدًّا

142
00:13:45,270 --> 00:13:46,630
.استمتعا بوقتكما

143
00:13:57,050 --> 00:14:00,510
...يوزو-سان، أهلاً بك في

144
00:14:05,210 --> 00:14:07,710
.ماذا؟ نيانكيتشي-كُن

145
00:14:08,270 --> 00:14:09,640
...مساء الخـ

146
00:14:11,990 --> 00:14:14,310
...يوزو، أنت

147
00:14:15,170 --> 00:14:17,080
نيانكيتشي-كُن؟

148
00:14:19,360 --> 00:14:20,750
...كيف

149
00:14:21,300 --> 00:14:25,290
!كيف يُحيط بكل كلّ هذا؟

150
00:14:25,290 --> 00:14:28,460
.ماذا؟ لا يحيط بي أيّ شيء

151
00:14:29,800 --> 00:14:34,640
!لكنّ هنالك هالة غول حولك بالكامل

152
00:14:34,640 --> 00:14:36,860
ما سبب صراخ الجميع؟

153
00:14:36,860 --> 00:14:38,810
.يوزو. مرحبًا بك

154
00:14:39,200 --> 00:14:41,430
...هذا ليس وقتًا مناسبًا لهذا

155
00:14:41,430 --> 00:14:42,810
.هيّا ندخل

156
00:14:42,810 --> 00:14:43,820
.حسنًا

157
00:14:43,820 --> 00:14:46,290
.نيانكيتشي، أحضر لنا بعض الشّاي

158
00:14:48,380 --> 00:14:50,010
.مفهوم

159
00:14:51,370 --> 00:14:54,430
.يبدو أنّ كلّ شيء بخير يا رفاق

160
00:14:58,620 --> 00:15:01,580
.عد لزيارتنا قريبًا يا رييا-كُن

161
00:15:03,440 --> 00:15:07,150
.رييا-ساما، تلقّيتُ مكالمة

162
00:15:08,020 --> 00:15:10,870
.غادرت عروسك القصر

163
00:15:12,150 --> 00:15:14,590
ماذا؟ ما الّذي يحدث؟

164
00:15:15,640 --> 00:15:21,260
.يتغيّر المرء فعلاً عندما يقابل عروسه

165
00:15:25,850 --> 00:15:28,000
ماذا؟ احترقت؟

166
00:15:28,350 --> 00:15:30,370
على يد ذلك الثّعلب الوغد؟

167
00:15:33,340 --> 00:15:39,530
مزّقت كارين الفستان الّذي حصلتُ
.عليه في عيد ميلادي، فضربتُها

168
00:15:39,530 --> 00:15:41,510
.ذلك لا يهمّ

169
00:15:41,510 --> 00:15:44,270
!نيانكيتشي، اذهب واقتل ذلك الثّعلب الوغد

170
00:15:44,270 --> 00:15:47,540
.لا تكوني سخيفة
.لا أستطيع هزيمة شيطان ثعلب

171
00:15:47,960 --> 00:15:52,290
.رغم ما حدث، لا أشعر بأيّ قوّة ثعلب عليك

172
00:15:52,290 --> 00:15:54,550
لماذا أشعر بقوّة غول بدلاً من ذلك؟

173
00:15:54,800 --> 00:15:58,960
.ربّما لأنّ رييا عالج ذراعي المحروقة

174
00:15:58,960 --> 00:16:00,490
رييا؟

175
00:16:00,490 --> 00:16:04,060
.نعم. قابلته عندما هربت من المنزل

176
00:16:04,060 --> 00:16:06,070
.قال أنّي عروسه

177
00:16:06,070 --> 00:16:09,270
حقًّا؟ أنتِ عروسه؟

178
00:16:09,270 --> 00:16:12,320
إذًا ذلك الرّجل رييا شيطان؟

179
00:16:12,560 --> 00:16:14,180
.مهلاً لحظة

180
00:16:16,360 --> 00:16:21,570
رييا... هل تقصدين بذلك
رييا-ساما من آل كيريوين؟

181
00:16:21,570 --> 00:16:22,800
.نعم

182
00:16:22,800 --> 00:16:24,830
!مستحيل

183
00:16:24,830 --> 00:16:28,760
!أ-أنت هي عروس وريث عائلة كيريوين؟

184
00:16:28,760 --> 00:16:32,030
!لهذا السّبب شعرتُ بوجود هالة غولٍ حولك

185
00:16:32,030 --> 00:16:35,350
يا للعجب! إنّه كيريوين رييا، أليس كذلك؟

186
00:16:35,350 --> 00:16:36,910
.لا داعي للتّظاهر بالدّهشة

187
00:16:37,190 --> 00:16:39,370
!إنّه كيريوين! كبير العشيرة التّالي

188
00:16:39,370 --> 00:16:41,310
!قمّة مجتمع الشّياطين

189
00:16:41,310 --> 00:16:43,500
!هذا رائع يا يوزو

190
00:16:45,320 --> 00:16:49,850
في الحقيقة، كان يجب أن تضحكي
.على والديك وأختك

191
00:16:53,570 --> 00:16:56,350
.سنصل إلى مكان الشّيطانين الأدنيين قريبًا

192
00:16:57,620 --> 00:16:58,860
.أسرع

193
00:17:02,630 --> 00:17:04,180
.أنتما

194
00:17:05,350 --> 00:17:07,670
هل تركتما يوزو تبتعد عن أنظاركما؟

195
00:17:08,770 --> 00:17:10,770
.خذاني إليها

196
00:17:12,240 --> 00:17:18,640
لقد ساعدني في قطع علاقتي بوالديّ
.وساعد جدّي وجدّتي ليتبنّيانني

197
00:17:19,140 --> 00:17:20,410
.هكذا إذًا

198
00:17:20,410 --> 00:17:23,150
أعتقد أنّ رييا هو السّبب
.في قدرتي على اتّخاذ هذا القرار

199
00:17:23,150 --> 00:17:25,150
.أشعر بالارتياح الآن

200
00:17:29,010 --> 00:17:30,400
.أنا سعيدة

201
00:17:31,030 --> 00:17:33,950
.لديك الآن من يحميك

202
00:17:34,490 --> 00:17:36,900
.لم أستطع فعل أيّ شيء لك

203
00:17:37,500 --> 00:17:42,970
.توكو، لطالما كنت تستمعين إليّ

204
00:17:50,080 --> 00:17:53,660
،لا يُحبّ أن يأخذ أحد توكو منه
.حتّى لو كانت فتاة أخرى

205
00:17:54,160 --> 00:17:57,350
.أغار من رابطتهما القويّة

206
00:17:58,910 --> 00:18:05,200
هل سيحبّني رييا حقًّا لمجرّد أنّني عروسه؟

207
00:18:05,990 --> 00:18:09,540
.بالمناسبة، يبدو أنّك أتيت وحدك

208
00:18:09,540 --> 00:18:12,150
أخبرتيه أنّك قادمة، أليس كذلك؟

209
00:18:12,670 --> 00:18:14,450
.لا، لم أخبره

210
00:18:14,450 --> 00:18:17,650
هل أنت غبيّة؟
.لا بدّ أنّهم فقدوا صوابهم الآن

211
00:18:17,650 --> 00:18:18,860
لماذا؟

212
00:18:18,860 --> 00:18:21,990
.الشّياطين ليسوا كيانًا متجانسًا

213
00:18:22,410 --> 00:18:24,900
،هناك عشائر متنافسة

214
00:18:24,900 --> 00:18:29,170
لكن لا أحد يجرؤ على التّحرّك
.ضدّ عشائر الغيلان القويّة

215
00:18:29,910 --> 00:18:33,230
.هناك طريقة واحدة فقط للنّيل من الغيلان

216
00:18:33,230 --> 00:18:35,370
.سرقة عرائسهم

217
00:18:36,350 --> 00:18:39,070
.العرائس بشر عاديّات عاجزات

218
00:18:39,070 --> 00:18:41,170
ماذا لو كانت إحداهنّ تتجوّل بلا حماية؟

219
00:18:41,600 --> 00:18:43,300
.سيكون ذلك سيّئًا للغاية

220
00:18:43,670 --> 00:18:45,840
.بل أكثر من سيّئ

221
00:18:45,840 --> 00:18:49,150
.دائمًا ما أُعيّن حرّاسًا لتوكو

222
00:18:49,150 --> 00:18:50,750
.لذا كوني حذرة

223
00:18:50,750 --> 00:18:54,700
،بإمكانك أن تجلبي ازدهارًا كبيرًا لعشيرة كيريوين

224
00:18:55,020 --> 00:18:57,690
.لكنّك أيضًا نقطة ضعفهم الوحيدة

225
00:18:58,680 --> 00:19:02,200
.لذا سيتردّد البعض في التّرحيب بك في العائلة

226
00:19:02,200 --> 00:19:04,600
.كوني مستعدّة لذلك

227
00:19:05,670 --> 00:19:07,900
أنا نقطة ضعفهم؟

228
00:19:08,760 --> 00:19:14,100
.كنت سعيدة فقط لأنّ رييا احتاجني

229
00:19:15,490 --> 00:19:19,520
لذلك عليك الآن الاتّصال بعائلة
.كيريوين لتخبريهم أنّك بخير

230
00:19:19,520 --> 00:19:21,040
.حسنًا

231
00:19:21,040 --> 00:19:23,510
.مهلاً، ليس لديّ رقمهم

232
00:19:23,760 --> 00:19:28,250
نيانكيتشي، اتّصل أنت. أنا متأكّد
.من أنّك تستطيع إيجاده

233
00:19:28,250 --> 00:19:29,470
.نعم، نعم

234
00:19:29,470 --> 00:19:33,260
قلت أنّك ستضطرّين لترك
المدرسة، أليس كذلك؟

235
00:19:33,700 --> 00:19:38,030
اجعلي وريث عائلة كيريوين
.يدفع التّكاليف فحسب

236
00:19:38,030 --> 00:19:39,650
.أنتِ عروسه

237
00:19:40,190 --> 00:19:41,270
...لكن

238
00:19:41,990 --> 00:19:45,080
،إذا اعتمدتُ على رييا كثيرًا
.فلن يكون هناك سبيل للعودة

239
00:19:45,580 --> 00:19:50,450
...إذا قرّر فجأةً أنّه لا يحتاجني وطردني

240
00:19:51,300 --> 00:19:55,530
.أخشى ألاّ أستطيع إعالة نفسي

241
00:19:59,170 --> 00:20:00,390
.يوزو

242
00:20:02,930 --> 00:20:04,400
نيانكيتشي؟

243
00:20:06,130 --> 00:20:08,350
.يوزو، أنا هنا لأخذك

244
00:20:10,240 --> 00:20:11,760
.رييا

245
00:20:12,560 --> 00:20:15,550
.لكنّنا اتّصلنا بك للتّوّ

246
00:20:16,180 --> 00:20:18,670
.أعرف دائمًا مكان هذين الاثنين

247
00:20:18,670 --> 00:20:21,450
.إنّهما حارساك الشّخصيّان في النّهاية

248
00:20:22,500 --> 00:20:25,760
.أنا آسفة لأنّني غادرتُ دون أن أقول شيئًا

249
00:20:29,820 --> 00:20:33,010
.لا داعي للقلق بشأن ذلك

250
00:20:34,130 --> 00:20:36,710
.يوزو، عرّفينا

251
00:20:37,170 --> 00:20:42,330
.هذه صديقتي توكو
.إنّها عروس نيانكيتشي-كُن

252
00:20:42,330 --> 00:20:44,970
.أنا توكو. تشرّفتُ بمعرفتك

253
00:20:44,970 --> 00:20:48,130
.أتمنّى أن تستمرّ صداقتك مع يوزو

254
00:20:48,470 --> 00:20:50,140
!بالتّأكيد

255
00:20:51,150 --> 00:20:54,060
.لا تكوني وقحة مع كيريوين-ساما

256
00:20:54,060 --> 00:20:57,130
كما لم تظهر عليك هذه النّظرة
.من قبل وأنت معي

257
00:20:57,630 --> 00:21:00,110
لماذا أُكلّف نفسي عناء التّملّق لك الآن؟

258
00:21:00,110 --> 00:21:00,980
!ماذا؟

259
00:21:19,880 --> 00:21:24,120
رييا، هل يُمكنني العمل؟

260
00:21:25,780 --> 00:21:30,880
يبدو أنّ والديّ اتّصلا بمكان
.عملي ليقدّما استقالتي

261
00:21:30,880 --> 00:21:34,050
.أنا من اتّصل بمكان عملك

262
00:21:34,050 --> 00:21:35,930
ماذا؟ لماذا؟

263
00:21:35,930 --> 00:21:37,560
.لستِ بحاجة للعمل

264
00:21:37,560 --> 00:21:40,120
.سأهتمّ بكلّ ما تحتاجينه

265
00:21:46,070 --> 00:21:50,160
لا أريد أن أكون مُعتمدة
.عليك إلى هذا الحدّ

266
00:22:00,400 --> 00:22:02,510
.أنتِ عروسي

267
00:22:02,960 --> 00:22:08,660
،عندما قبلتِ ذلك
.أصبحت بقيّة حياتك ملكي

268
00:22:08,970 --> 00:22:12,190
.دعيني أتولّى كلّ شيء