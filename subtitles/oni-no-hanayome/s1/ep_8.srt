1
00:00:00,810 --> 00:00:07,600
علينا إعادة يوزو إلى المنزل
.دون فسخ خطوبتهما

2
00:00:07,600 --> 00:00:11,650
.ما هذا؟ يتحدّث الجميع عنها

3
00:00:13,060 --> 00:00:14,110
...لكنّني

4
00:00:14,990 --> 00:00:18,110
.أشكّ في أنّها تعلم ذلك

5
00:00:18,110 --> 00:00:22,000
.أشعر بالأسف الشّديد عليها

6
00:01:56,830 --> 00:01:58,310
ما الأمر يا كارين؟

7
00:01:58,310 --> 00:01:59,760
!كفاك هراءً

8
00:02:00,350 --> 00:02:03,130
!أعد أختي في الحال

9
00:02:03,460 --> 00:02:09,020
لا أطيق أنّها تفعل ما يحلو لها
.وهي بعيدة عن أنظاري

10
00:02:11,610 --> 00:02:13,590
بإمكانك فعل ذلك، أليس كذلك يا يوتا؟

11
00:02:16,070 --> 00:02:18,030
...في الوقت الحاليّ

12
00:02:18,030 --> 00:02:21,470
.يجتمع كبار عشائر الشّياطين

13
00:02:22,750 --> 00:02:24,840
.إنّه اجتماعهم السّنويّ

14
00:02:25,460 --> 00:02:27,780
.إذًا هذه فرصتنا

15
00:02:28,060 --> 00:02:32,000
هذا يعني أنّ كيريوين رييا
بعيد عن أختي، صحيح؟

16
00:02:32,360 --> 00:02:34,340
...نعم، لكن

17
00:02:37,220 --> 00:02:39,550
.سمعت أنّك أحرقتها

18
00:02:40,680 --> 00:02:41,750
.نعم

19
00:02:42,780 --> 00:02:46,800
وفي النّهاية، اتّضح أنّها عروس
.سيّد آل كيريوين الصّغير

20
00:02:47,690 --> 00:02:51,560
،لكنتَ قد فقدت رأسك الآن
.لو كان ذلك ما أراده

21
00:02:54,180 --> 00:03:00,710
لكنّه اختار ألاّ يُثير صراعًا
.لا داعي له بين عشائرنا

22
00:03:02,200 --> 00:03:09,200
لقد فضّل المنطق، بصفته كبير العشيرة
.القادم، على غريزته لحماية عروسه

23
00:03:09,200 --> 00:03:11,210
.على عكسك تمامًا

24
00:03:13,260 --> 00:03:15,080
.إيّاك أن تنس

25
00:03:15,710 --> 00:03:19,550
.لن أستطيع حمايتك في المرّة القادمة

26
00:03:20,660 --> 00:03:21,660
.حاضر

27
00:03:22,710 --> 00:03:26,850
أعلم أنّ الأمر صعب
،على شيطان لديه عروس

28
00:03:27,380 --> 00:03:30,700
.لكنّ هذا هو قدرك

29
00:03:32,540 --> 00:03:36,510
...إذا أغضبتُ آل كيريوين، فسوف

30
00:03:36,510 --> 00:03:37,730
.أرجوك

31
00:03:38,150 --> 00:03:41,700
.أعد أختي بينما ذلك الرّجل غائب

32
00:03:42,140 --> 00:03:44,160
.هيّا يا يوتا

33
00:03:46,540 --> 00:03:47,550
.حاضر

34
00:03:48,640 --> 00:03:51,220
.سأحقّق أمنية كارين

35
00:04:00,090 --> 00:04:03,680
.شكرًا على المساعدة يا يوزو

36
00:04:04,020 --> 00:04:08,050
.لا بأس. يسعدني القيام بالغسيل والتّنظيف

37
00:04:09,740 --> 00:04:13,180
.أنا سعيدة لأنّك تبدين بخير

38
00:04:13,570 --> 00:04:18,040
.وأنا أيضًا. أشعر بتحسّن بفضلك

39
00:04:19,030 --> 00:04:22,110
،الإعجاب يجعل وجنتيك تشعران بالدّفء

40
00:04:22,110 --> 00:04:26,920
.لكنّ الحبّ الحقيقيّ يجعل صدرك يشعر بالحرارة

41
00:04:28,360 --> 00:04:31,560
.أستطيع أن أثق برييا الآن

42
00:04:32,410 --> 00:04:34,510
.شكرًا يا جدّتي

43
00:04:41,290 --> 00:04:42,320
.مهلاً

44
00:05:04,010 --> 00:05:06,270
هل هذه قدرة شيطانٍ ثعلب؟

45
00:05:07,970 --> 00:05:09,550
.أحسنت

46
00:05:09,550 --> 00:05:12,460
.يمكنك الآن الذّهاب لرؤية أختك

47
00:05:12,460 --> 00:05:15,150
.حسنًا. شكرًا لك يا يوتا

48
00:05:26,710 --> 00:05:28,290
.سأرى من الطّارق

49
00:05:30,890 --> 00:05:32,630
.أنا قادمة

50
00:05:50,900 --> 00:05:52,220
.أبي

51
00:05:54,230 --> 00:05:56,290
.لم نرك منذ مدّة

52
00:05:56,650 --> 00:05:59,300
.كنّا قلقين عليك يا يوزو

53
00:05:59,900 --> 00:06:02,340
لـ-لماذا أنتما هنا؟

54
00:06:04,460 --> 00:06:06,670
يوزو، من كان الطّارق؟

55
00:06:10,370 --> 00:06:13,170
ماذا تفعلان هنا؟

56
00:06:13,530 --> 00:06:18,430
.لا تعاملانا كخاطفين. أنا ابنكما

57
00:06:18,660 --> 00:06:22,880
لم تسمحا لنا برؤية يوزو مهما
.اتّصلنا، لذلك جئنا شخصيًّا

58
00:06:23,680 --> 00:06:25,940
لماذا قد نسمح لكما برؤيتها؟

59
00:06:26,480 --> 00:06:30,940
كانا يحاولان رؤيتي؟ لماذا الآن؟

60
00:06:32,230 --> 00:06:34,500
.يوزو ابنتنا

61
00:06:35,590 --> 00:06:38,180
.ليس لكما الحقّ في الوقوف بيننا

62
00:06:38,730 --> 00:06:41,620
!لستما والديها بعد الآن

63
00:06:41,620 --> 00:06:44,160
!ليس منذ أن وقّعتما أوراق التّبنّي

64
00:06:44,450 --> 00:06:46,470
.إنّها مجرّد قصاصات ورق

65
00:06:46,470 --> 00:06:49,250
.تعلم تمامًا أنّنا أُجبرنا على توقيعها

66
00:06:50,630 --> 00:06:54,620
يوزو، هل أنتِ موافقة على هذا حقًّا؟

67
00:06:54,620 --> 00:06:58,390
هل ستتخلّين عن والديك بهذه السّهولة؟

68
00:06:58,670 --> 00:07:04,650
.أنا ووالدك نهتمّ لأمرك حقًّا

69
00:07:05,260 --> 00:07:07,160
.لستِ مُلزمة بالاستماع إليهما

70
00:07:07,410 --> 00:07:10,000
يهتمّان لأمري؟

71
00:07:12,840 --> 00:07:14,460
،عندما كنتُ أعيش في ذلك المنزل

72
00:07:15,850 --> 00:07:20,810
،لم أشعر أبدًا باهتمامهما
.مهما تمنّيتُ ذلك

73
00:07:28,950 --> 00:07:33,290
،أنا آسفة لأنّنا منحنا كارين كلّ هذا الاهتمام

74
00:07:33,740 --> 00:07:36,450
.لكنّك أختها الكبرى

75
00:07:37,130 --> 00:07:40,780
،أتفهّم أنّك تمرّين بمرحلة تمرّد

76
00:07:40,780 --> 00:07:44,130
.لكن حاولي ألاّ تكوني أنانيّة

77
00:07:46,270 --> 00:07:48,810
.ما زالا لا يفهمان الأمر على الإطلاق

78
00:07:52,380 --> 00:07:53,720
.يوزو

79
00:07:56,460 --> 00:07:59,280
.هذا صحيح. عودي إلينا يا يوزو

80
00:08:04,790 --> 00:08:08,110
.كنتُ وحيدة للغاية

81
00:08:10,770 --> 00:08:13,040
.أعطيتما كلّ اهتمامكما لكارين

82
00:08:13,720 --> 00:08:16,730
.كنتُ دائمًا مُهمّشة

83
00:08:17,660 --> 00:08:21,100
.لم تُفكّرا أبدًا في معاناتي

84
00:08:22,070 --> 00:08:24,680
.يوزو، استمعي إلينا

85
00:08:24,910 --> 00:08:29,700
!لم أشعر بأيّ حبّ منكما على الإطلاق

86
00:08:32,300 --> 00:08:34,220
!ولا مرّة واحدة في حياتي

87
00:08:35,530 --> 00:08:37,210
.ليس منكما

88
00:08:43,800 --> 00:08:45,830
.رييا إلى جانبي الآن

89
00:08:46,580 --> 00:08:48,160
.لن أعود للمنزل

90
00:08:49,760 --> 00:08:52,380
.يا لك من مسكينة

91
00:08:57,960 --> 00:08:59,230
.كارين

92
00:09:00,440 --> 00:09:02,700
.أشعر بالأسف الشّديد عليك

93
00:09:02,700 --> 00:09:06,720
أنت فقط سعيدةٌ لأنّك أصبحت
عروسًا، أليس كذلك؟

94
00:09:06,720 --> 00:09:08,860
.أنت لا تدركين حتّى أنّه لا يحبّك

95
00:09:09,290 --> 00:09:13,610
.سمعتُ أنّ كيريوين رييا لديه حبيب

96
00:09:13,610 --> 00:09:16,610
.ذلك السّكرتير الّذي لا يفارقه

97
00:09:22,730 --> 00:09:25,370
.ماذا؟ إذًا أنت تعلمين سلفًا

98
00:09:25,370 --> 00:09:28,800
فلماذا تتصرّفين وكأنّه يحبّك؟

99
00:09:29,160 --> 00:09:33,630
يعلم الجميع في المدرسة
.أنّه على علاقة بسكرتيره

100
00:09:34,360 --> 00:09:39,770
.تريدك عائلة كيريوين فقط لأنّك عروسه

101
00:09:40,140 --> 00:09:43,550
.لذلك عودي إلى المنزل

102
00:09:44,430 --> 00:09:49,400
صحيح يا يوزو، لا يوجد أحد
.تثقين به أكثر من عائلتك

103
00:09:49,400 --> 00:09:51,560
.نعم، عودي إلى المنزل

104
00:09:51,860 --> 00:09:54,660
.لسنا غاضبين ممّا فعلت

105
00:09:55,150 --> 00:09:56,070
!لا

106
00:09:56,800 --> 00:10:00,200
!رييا ليس الشّخص الّذي تصفونه الآن

107
00:10:00,440 --> 00:10:04,740
!ولا يهمّ ما يشعر به رييا تجاهي

108
00:10:04,740 --> 00:10:08,360
!لن أعود إلى منزلكم أبدًا

109
00:10:10,530 --> 00:10:13,830
!قرّرتُ بالفعل البقاء مع رييا

110
00:10:14,640 --> 00:10:16,150
!يوزو

111
00:10:16,150 --> 00:10:18,210
!لا تتصرّفي بعناد هكذا

112
00:10:21,850 --> 00:10:22,850
!مهلاً

113
00:10:22,850 --> 00:10:23,980
!توقّف

114
00:10:24,400 --> 00:10:25,900
!اتركها

115
00:10:25,900 --> 00:10:28,570
!هذا شأن عائليّ

116
00:10:32,690 --> 00:10:33,890
!جدّتي

117
00:10:34,220 --> 00:10:36,610
هل أنت بخير؟

118
00:10:40,240 --> 00:10:43,690
!كيف تجرؤين على النّظر إلى والدك هكذا؟

119
00:10:44,000 --> 00:10:47,710
!لقد آذيت جدّتي للتّوّ! أنت لست والدي

120
00:10:47,710 --> 00:10:49,200
ماذا قلتِ؟

121
00:10:49,780 --> 00:10:51,030
!سنرحل الآن

122
00:10:51,990 --> 00:10:53,210
!لا

123
00:10:54,850 --> 00:10:57,140
.جدتّي، جدّي

124
00:10:57,960 --> 00:11:00,010
.ساعديني يا رييا

125
00:11:13,660 --> 00:11:14,980
!الغولان الصّغيران

126
00:11:15,590 --> 00:11:17,430
من أنتما؟

127
00:11:18,770 --> 00:11:21,220
!هيّا يا يوزو! سنرحل

128
00:11:32,950 --> 00:11:34,300
!عزيزتي

129
00:11:34,890 --> 00:11:38,620
كيف سمحت لهذين الصّغيرين بالتّغلّب عليك؟

130
00:11:39,500 --> 00:11:40,760
!...أيّها

131
00:11:56,430 --> 00:11:57,940
.يوتا

132
00:11:58,360 --> 00:12:00,820
!كارين، يجب أن نرحل

133
00:12:00,820 --> 00:12:01,750
ماذا؟

134
00:12:01,750 --> 00:12:03,950
!إنّهما أليفان لعائلة كيريوين

135
00:12:03,950 --> 00:12:05,450
!إنّهما أقوى ممّا يبدوان عليه

136
00:12:05,450 --> 00:12:09,620
وإذا أحدثنا ضجّة، فسوف يزول
!السّحر الّذي وضعته على الحرّاس

137
00:12:19,220 --> 00:12:21,120
هل تستطيع السّير؟

138
00:12:21,120 --> 00:12:22,340
.سُحقًا

139
00:12:23,180 --> 00:12:25,450
!لم ينتهِ الأمر بعد

140
00:12:32,760 --> 00:12:34,600
جدّتي، هل أنت بخير؟

141
00:12:35,480 --> 00:12:38,510
.نعم. لم تكن سقطة قويّة

142
00:12:39,270 --> 00:12:41,820
.تأذّيتِ وأنت تحاولين إنقاذي

143
00:12:42,260 --> 00:12:43,760
.أنا آسفة

144
00:12:43,760 --> 00:12:45,610
.لا بأس يا يوزو

145
00:12:45,610 --> 00:12:50,900
.أنا آسفة لأنّ ابننا الأحمق كان قاسيًا عليك

146
00:12:50,900 --> 00:12:54,380
.نعم، نحن سعيدان لأنّك بخير

147
00:12:56,380 --> 00:12:59,110
.جدّي، جدّتي

148
00:13:00,130 --> 00:13:01,680
.كم أراحني هذا

149
00:13:05,580 --> 00:13:08,860
وأنتما أيضًا أحسنتما عملاً
.أيّها الغولان الصّغيران

150
00:13:08,860 --> 00:13:11,880
.كانت تلك قدرة مذهلة

151
00:13:18,400 --> 00:13:20,150
.لا تقلقا حيال ذلك

152
00:13:37,290 --> 00:13:38,480
.رييا-ساما

153
00:13:41,010 --> 00:13:43,120
...نسيتُ أن أذكر أمرًا

154
00:13:43,780 --> 00:13:48,050
ذهبت ساكوراكو لزيارة يوزو-ساما
.في منزل جدّيها

155
00:13:48,630 --> 00:13:51,170
حقًّا؟ لماذا؟

156
00:13:51,410 --> 00:13:53,030
.لا أعلم

157
00:13:53,030 --> 00:13:56,530
.إنّهما متقاربتان في العمر
.ربّما كانت تُعرّف بنفسها

158
00:13:57,600 --> 00:14:02,180
إذًا كانت تلك ساكوراكو التّي شعرتُ
.بها عندما أوصلتُ يوزو

159
00:14:02,840 --> 00:14:06,450
.لا يهمّ. لن تُسبّب ساكوراكو أيّ مشاكل

160
00:14:07,190 --> 00:14:08,300
.نعم

161
00:14:11,410 --> 00:14:12,620
ما الأمر؟

162
00:14:13,330 --> 00:14:14,510
!ماذا؟

163
00:14:18,490 --> 00:14:22,040
.رييا-ساما، هناك مشكلة

164
00:14:22,550 --> 00:14:26,460
.زارت عائلة يوزو-ساما السّابقة منزل جدّيها

165
00:14:28,440 --> 00:14:29,500
!هل يوزو بخير؟

166
00:14:29,840 --> 00:14:33,760
يـ-يبدو أنّها بخير. استطاع
.الغولان الصّغيران طردهم

167
00:14:34,800 --> 00:14:36,490
.أنا آسف

168
00:14:36,490 --> 00:14:39,310
.مع أنّي زدتُ الحراسة كما طلبت

169
00:14:41,150 --> 00:14:44,200
ولكن لسبب ما، لم يلاحظ
.أحد الأمر حتّى انتهى الأمر

170
00:14:45,000 --> 00:14:48,290
.أعتقد أنّهم فُتنوا

171
00:14:49,060 --> 00:14:51,820
.فُتنوا؟ فهمت

172
00:14:51,820 --> 00:14:54,870
.مع أنّي حذّرته

173
00:14:57,200 --> 00:14:59,680
اطلب مقابلة مع كبيرة عشيرة
.الشّياطين الثّعالب

174
00:15:00,560 --> 00:15:01,460
.حاضر

175
00:15:07,270 --> 00:15:11,030
قرّروا أن يجعلوني عدوًّا لهم إذًا؟

176
00:15:25,210 --> 00:15:28,780
.لا أصدقّ هذا. سيدفعون الثّمن

177
00:15:28,780 --> 00:15:29,940
.كارين

178
00:15:32,480 --> 00:15:34,570
!ماذا الآن؟ أوقف هذا

179
00:15:36,010 --> 00:15:37,040
مرحبًا؟

180
00:15:38,650 --> 00:15:40,200
آتي في الحال؟

181
00:15:43,170 --> 00:15:45,320
.نعم، فهمت

182
00:15:46,400 --> 00:15:48,110
ما الأمر؟

183
00:15:50,040 --> 00:15:53,460
.استدعاء من المنزل الرّئيسيّ

184
00:15:54,330 --> 00:15:55,980
...آل كيريوين

185
00:15:56,620 --> 00:15:59,420
.آل كيريوين غاضبون جدًّا

186
00:16:15,100 --> 00:16:18,580
.لم أتوقّع أبدًا أن يطلب السّيّد الصّغير رؤيتنا

187
00:16:21,360 --> 00:16:23,320
.إنّه شرف كبير

188
00:16:24,620 --> 00:16:28,530
،كوغيتسو ناديشيكو
.كبيرة عشيرة الشّياطين الثّعالب

189
00:16:28,910 --> 00:16:31,290
.إنّها شيطانة ثعلب التّسعة ذيول

190
00:16:32,080 --> 00:16:34,930
.قوّتها الشّيطانيّة لا تُضاهى إلاّ بقوّة رييا-ساما

191
00:16:34,930 --> 00:16:37,720
.علينا أن نتحلّى بالأدب في حضرتها

192
00:16:41,130 --> 00:16:44,600
.لا يبدو أنّك تحمل أخبارًا سارّة

193
00:16:46,350 --> 00:16:48,890
،بما أنّك استدعيتِه

194
00:16:48,890 --> 00:16:52,980
فأنا أشكّ في حاجتي لشرح سبب
.مجيئنا، لكنّني سأسأل على أيّ حال

195
00:16:54,110 --> 00:16:59,030
هل أنتَ من ساعد أولئك
الأوغاد على الاقتراب من عروسي؟

196
00:17:01,740 --> 00:17:04,150
.أنا آسف جدًّا على ذلك

197
00:17:04,150 --> 00:17:09,660
كما قلتَ، خدع هذا الأحمق حرّاسك

198
00:17:09,660 --> 00:17:12,750
.بناءً على طلب عروسه

199
00:17:13,490 --> 00:17:16,440
يوتا، أليس لديك ما تقوله؟

200
00:17:18,150 --> 00:17:23,260
.أردتُ فقط أن أُحقّق أمنية كارين

201
00:17:24,140 --> 00:17:26,910
إذًا أنت من ساعدتها؟

202
00:17:26,910 --> 00:17:29,410
.كان ذلك السّحر قويًّا بما يكفي لخداع الغيلان

203
00:17:30,240 --> 00:17:33,130
.لستَ قويًّا بما يكفي لفعل ذلك بمفردك

204
00:17:33,580 --> 00:17:35,650
هل استعنتَ بأفراد آخرين من العشيرة؟

205
00:17:36,920 --> 00:17:38,150
.نعم

206
00:17:38,410 --> 00:17:45,400
أعلم أنّك تعلم كيف عاملتْ
.عروسك وعائلتها عروسه

207
00:17:45,400 --> 00:17:46,570
...أنا

208
00:17:46,910 --> 00:17:49,810
.سبق ومنحتُه فرصة ثانية

209
00:17:49,810 --> 00:17:53,200
عادةً، يكفي هذا لردع أيّ شخص
.عن تحدّي الغيلان مجدّدًا

210
00:17:54,650 --> 00:17:59,360
.لكنّني استهنتُ بغرائز شيطانٍ له عروس

211
00:18:00,670 --> 00:18:02,350
.كنتُ مُهملاً

212
00:18:02,810 --> 00:18:06,520
.لا بدّ أنّ يوزو قلقة وحزينة للغاية الآن

213
00:18:07,420 --> 00:18:09,640
.لن أدعها تقلق بشأن أيّ شيء مجدّدًا

214
00:18:10,060 --> 00:18:11,910
.سأحسم الأمر هنا

215
00:18:13,500 --> 00:18:17,080
.كارين... هي من طلبت منّي ذلك

216
00:18:17,580 --> 00:18:20,170
...لم أستطع الرّفض

217
00:18:21,280 --> 00:18:24,760
مع أنّني كنت أعلم أنّ ذلك
.قد يُسبّب نزاعًا مع الغيلان

218
00:18:27,430 --> 00:18:32,490
الشّياطين الّذين حصلوا على عروس
.يواجهون مشقّة كبيرة

219
00:18:33,140 --> 00:18:36,890
.أحيانًا، تُضلّهم عرائسهم

220
00:18:37,250 --> 00:18:41,630
.برأيي، العرائس لعنة

221
00:18:42,270 --> 00:18:44,120
ألا توافقني الرّأي؟

222
00:18:50,500 --> 00:18:54,850
.إذا كان هذا الشّعور لعنة، فأنا أتقبّله

223
00:18:57,940 --> 00:19:03,380
كنتُ مجرّد شخص موجود بصفتي
.كبير عشيرة كيريوين القادم

224
00:19:04,320 --> 00:19:08,280
.لطالما شعرتُ بفراغٍ في قلبي

225
00:19:09,700 --> 00:19:12,800
.إلى أن التقيتُ يوزو

226
00:19:14,090 --> 00:19:20,290
عندما حملتها بين ذراعي لأوّل
.مرّة، انتابني شعورٌ جديد

227
00:19:20,950 --> 00:19:24,030
.حبٌّ لشخصٍ آخر

228
00:19:25,140 --> 00:19:30,820
ملأت يوزو الفراغ في قلبي
.وأضفت لونًا على حياتي

229
00:19:31,630 --> 00:19:35,370
.أجد نفسي هذه الأيّام أتصرّف بحماقة أحيانًا

230
00:19:38,600 --> 00:19:42,930
إذًا ترى لعنتك مصدرًا للفرح؟
.مثير للإعجاب

231
00:19:44,110 --> 00:19:46,910
.ليته كان ناضجًا مثلك

232
00:19:48,960 --> 00:19:51,100
،لعنتي لعنة

233
00:19:51,590 --> 00:19:56,350
،لكنّني لم أتخلَّ عن صوابي
.على عكس هذا الرّجل

234
00:19:58,250 --> 00:20:03,550
حاولت عشيرة الشّياطين الثّعالب
.إيذاء عروس كبير عشيرتنا القادم

235
00:20:04,080 --> 00:20:06,590
.هذا تمرّد على الغيلان

236
00:20:11,650 --> 00:20:16,820
أنت محقّ. حتّى أنا يجب
.أن أعتذر عمّا حدث

237
00:20:21,320 --> 00:20:25,950
،أقبل اعتذارك
ولكن هل تعتقدين حقًّا أنّ هذا كافٍ؟

238
00:20:29,240 --> 00:20:30,460
.يوتا

239
00:20:30,980 --> 00:20:32,090
.نعم

240
00:20:33,030 --> 00:20:37,220
.ستُعاقَب أنت وعروسك ووالديها

241
00:20:39,260 --> 00:20:43,200
سنوقف تقديم الدّعم الماليّ
.لعائلة عروسك

242
00:20:43,950 --> 00:20:48,540
ستُفصل عن والديها وتُوضع تحت
.المراقبة في منزل آل كوغيتسو

243
00:20:49,370 --> 00:20:51,170
.وهذا ليس كلّ شيء

244
00:20:52,590 --> 00:20:56,780
،إذا آذيتَ عروس السّيّد الصّغير مرّة أخرى

245
00:20:57,170 --> 00:21:01,010
،فستُنفى عروسك وعائلتها

246
00:21:01,760 --> 00:21:04,650
.ولن تراها ثانيةً

247
00:21:05,050 --> 00:21:06,780
...لكن

248
00:21:07,000 --> 00:21:11,410
.بقاؤها كعروسك من عدمه رهنٌ بسلوكك

249
00:21:12,450 --> 00:21:16,240
.أنا لا أتراجع أبدًا عن كلامي

250
00:21:21,670 --> 00:21:23,970
هل هذا يُرضيك يا سيّدي؟

251
00:21:24,950 --> 00:21:28,650
.بالنّظر إلى ما حدث ليوزو، هذا غير كافٍ

252
00:21:29,530 --> 00:21:34,640
لكنّ هذا الحلّ الوسط سيُمكّن
.كبيرة عشيرتهم من حفظ ماء وجهها

253
00:21:35,470 --> 00:21:36,810
.حسنًا

254
00:21:37,350 --> 00:21:40,280
.لا تدع تلك الفتاة تقترب من يوزو مجدّدًا

255
00:21:40,970 --> 00:21:42,070
.حاضر

256
00:21:46,640 --> 00:21:51,580
وأيضًا، أريد أن أرى هذه
.العروس الّتي أسعدتك

257
00:21:52,000 --> 00:21:55,450
.أحضرها في اليوم الأخير من الوليمة

258
00:21:55,820 --> 00:21:57,820
.كنت قد خطّطت لذلك بالفعل

259
00:21:58,710 --> 00:22:03,500
.جيّد. يُحضر يوتا عروسه كلّ عام

260
00:22:05,330 --> 00:22:06,840
ما الّذي تخطّطين له؟

261
00:22:07,700 --> 00:22:13,230
أريد أن أرى إن كان يوتا قادرًا
.على السّيطرة على عروسه

262
00:22:15,190 --> 00:22:18,370
.أحبّ المرح فحسب