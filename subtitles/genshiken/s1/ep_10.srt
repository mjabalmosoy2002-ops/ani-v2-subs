.أريني إياها

245
00:15:10,360 --> 00:15:12,060
ما هذا، حقًّا؟

246
00:15:12,560 --> 00:15:13,860
...هل هو...كما تعلمين

247
00:15:14,030 --> 00:15:16,900
...وهو المغني من

248
00:15:17,000 --> 00:15:18,870
...إنَّها ليست لي شخصيًّا

249
00:15:20,700 --> 00:15:24,610
.أظنُّ أنَّني الآن مهتمَّةٌ حقًّا بالذهاب إلى هناك

250
00:15:25,510 --> 00:15:26,980
.أظنُّ أنَّ عيونها قد تفتَّحت أخيرًا

251
00:15:27,540 --> 00:15:30,030
.سيكونُ مهرجان المانجا ممتعًا حقًّا

252
00:15:38,090 --> 00:15:40,060
لماذا تحوَّلت الأحداث هكذا، مجدَّدًا؟

253
00:15:40,120 --> 00:15:42,610
هذا صحيح، لماذا ني ـ سان هنا أيضًا؟

254
00:15:42,730 --> 00:15:43,780
.أنتِ آخر من يتحدَّث

255
00:15:44,590 --> 00:15:48,890
.لستُ بحاجةٍ لقول هذا، لكني لا أملكُ أيَّ شكٍّ بأنِّي سأصبح أوتاكو

256
00:15:49,600 --> 00:15:52,000
.أنا هنا فقط لأبقي عيني عليها

257
00:15:52,440 --> 00:15:53,800
هل فهمتم هذا؟

258
00:15:53,940 --> 00:15:55,060
فهمتم، أليسَ كذلك؟

259
00:15:55,370 --> 00:15:56,570
.بالطبع

260
00:15:56,940 --> 00:15:58,500
.طفوليٌّ بالكامل

261
00:15:58,810 --> 00:16:01,680
.على أحدٍ ما أن يعلِّمَ هؤلاء الأطفال وقاحة الكلام

262
00:16:02,050 --> 00:16:06,480
.حسنًا، نحنُ فهمنا هذا الجزء لكنَّنا لن نساعدكِ في شيء

263
00:16:06,620 --> 00:16:08,410
.سنكونُ مشغولينَ بالشراء

264
00:16:08,520 --> 00:16:09,040
!صحيح

265
00:16:09,420 --> 00:16:12,790
.أعرف هذا، لهذا لن أسمح لها بالابتعاد عني

266
00:16:12,920 --> 00:16:15,320
.[وكأنِّي سأبتعدُ عن [كوساكا-سان

267
00:16:16,030 --> 00:16:17,820
!لا تفكّري في هذا أبدًا

268
00:16:17,960 --> 00:16:19,660
!لن أفعل

269
00:16:19,800 --> 00:16:21,890
.لن تهربَ أبدًا

270
00:16:22,630 --> 00:16:23,760
...صحيح

271
00:16:35,140 --> 00:16:38,770
لماذا هم مصطفُّون في هذا الجوِّ الملتهب؟

272
00:16:39,550 --> 00:16:41,040
وكيف لي أن أعلم؟

273
00:16:43,890 --> 00:16:47,750
.آه، وأخيرًا بدأ مَن في المقدِّمة بالنهوض

274
00:16:48,190 --> 00:16:49,920
هل سيتحرَّكون؟

275
00:16:50,060 --> 00:16:52,360
.أنا سأرعف

276
00:16:53,860 --> 00:16:55,160
.آه، حسنًا

277
00:16:55,470 --> 00:16:56,520
.فهمت

278
00:16:56,970 --> 00:16:59,700
.قالوا بأنَّهم سيلحقون بنا عندما نتقدَّم أكثر

279
00:17:00,440 --> 00:17:03,740
...يا رجل، يالهم من محتالين

280
00:17:07,810 --> 00:17:09,780
.لا تدخلوا المناطق المعشَّبة رجاءً

281
00:17:10,780 --> 00:17:14,110
.ممنوعٌ الدخول إلى الأماكن المعشَّبة
.اخرجوا لو سمحتم

282
00:17:34,770 --> 00:17:35,830
![كوساكا]

283
00:17:35,910 --> 00:17:37,130
![كوساكا ـ سان]

284
00:17:37,740 --> 00:17:38,710
كوساكا]؟]

285
00:17:39,040 --> 00:17:40,570
كم يبعد المكان الذي أنت ذاهبٌ إليه؟

286
00:17:41,040 --> 00:17:43,510
.صفوف الانتظار للمجموعات الكبيرة تكونُ في الخارج

287
00:18:05,800 --> 00:18:09,860
لماذا يفعلونَ شيئًا كهذا؟

288
00:18:10,540 --> 00:18:14,530
ألا تظنينَ بأنَّ الأمر لا يستحقُّ أن تكوني أوتاكو لأجله؟

289
00:18:19,250 --> 00:18:20,650
.لا، سأفعلها

290
00:18:20,750 --> 00:18:23,150
!لديَّ ما يتطلَّبه الأمر، أنا أثقُ بذلك

291
00:18:25,120 --> 00:18:26,880
...شخصٌ من نادينا قال

292
00:18:28,960 --> 00:18:31,720
الأوتاكو هو ليسَ شيئًا تحاول أن تتحوَّل إليه"

293
00:18:32,660 --> 00:18:34,650
"بل ستكون واحدًا منهم قبلَ أن تعلم

294
00:18:44,540 --> 00:18:47,200
.لهذا لا يستطيعونَ التوقُّف عن كونهم كذلك

295
00:18:47,310 --> 00:18:51,580
.إنَّ هذا مثيرٌ للسخرية، لكن بالنسبة لنا إنَّها مأساة

296
00:18:52,750 --> 00:18:56,480
.أنتِ لا تفهمينَ حقًّا ماذا يعني أن تواعدي أوتاكو

297
00:18:58,120 --> 00:19:01,720
.لن يكونَ كافيًا أنَ تقولي بأنَّكِ ستصبحين واحدةً منهم

298
00:19:02,790 --> 00:19:03,950
ماذا تعنين؟

299
00:19:05,060 --> 00:19:07,190
...برأيي

300
00:19:08,260 --> 00:19:09,230
.لا، لن أخبركِ

301
00:19:09,770 --> 00:19:11,100
!هذا غير عادل

302
00:19:11,200 --> 00:19:12,930
أنتِ منافستي، ألستِ كذلك؟

303
00:19:13,040 --> 00:19:14,560
.وكأنِّي سأخبركِ

304
00:19:30,890 --> 00:19:33,790
هل رأيتِ تلكَ الدوجينشي المعروضة للبيع بالطريق إلى هنا؟

305
00:19:33,960 --> 00:19:35,980
.إنَّها عالمٌ مدهش

306
00:19:36,090 --> 00:19:38,080
.أنا لم أملك الوقت مطلقًا للنظر إليها

307
00:19:38,190 --> 00:19:39,660
.إذًا لنذهب ونلقي نظرة

308
00:19:39,800 --> 00:19:41,730
.أنا لا أملكُ النيَّة مطلقًا للذهاب

309
00:19:42,030 --> 00:19:43,930
.أنتِ ليس لديكِ أيُّ شيء

310
00:19:44,030 --> 00:19:45,330
...مطلقًا

311
00:19:46,100 --> 00:19:48,130
.رجاءً لا تدخلوا المناطق المعشَّبة

312
00:19:50,740 --> 00:19:51,600
.مرحبًا

313
00:19:51,770 --> 00:19:53,260
ماذا حدثَ لأولئك الاثنتين؟

314
00:19:53,640 --> 00:19:56,110
.لقد افترقنا، لذا اتصلتُ بهن

315
00:19:56,180 --> 00:19:57,910
...قالوا بأنَّهم سيكونونَ في المطعم حتَّى ننتهي

316
00:19:58,010 --> 00:19:59,880
.ونتصلُ بهنَّ عندما نغادر...

317
00:19:59,980 --> 00:20:02,850
.فقط أخبرهنّ أن يعُدن إلى المنزل

318
00:20:03,050 --> 00:20:04,580
.لماذا قد أتوا على أيِّ حال

319
00:20:05,020 --> 00:20:08,790
.إنَّ هذا مخيِّبٌ للآمال، فمنَ النادر أن تأتي [كوسكابي-سان] إلى هنا

320
00:20:08,960 --> 00:20:12,830
.الخطأ بعينه هو قدومهنّ في حال عدم انتمائهم إلى هنا

321
00:20:12,960 --> 00:20:14,190
.أنتَ محقّ

322
00:20:15,200 --> 00:20:16,630
...لكن

323
00:20:17,870 --> 00:20:21,770
.والآن نستطيع أن نفكّر في كلّ ما تحتاجه قلوبنا

324
00:20:22,310 --> 00:20:24,000
ماذا عن حزام [جام-جام]؟

325
00:20:24,170 --> 00:20:26,160
.هذا هو، لقد اشتريته

326
00:20:26,680 --> 00:20:29,140
.من المؤكَّد أنَّنا اشترينا الكثير هذه المرَّة

327
00:20:47,060 --> 00:20:50,830
أتقصدين بأنَّك لم تحاولي أن تصبحي أوتاكو من أجل [كوساكا]؟

328
00:20:50,930 --> 00:20:52,060
.مطلقًا

329
00:20:52,800 --> 00:20:56,900
.حسنًا، حاولتُ على الأقلِّ مرَّةً أن ألعبَ معهُ  ألعاب فيديو، لكن لم يفلح الأمر

330
00:20:57,410 --> 00:20:59,200
!إذًا فقد حاولتِ

331
00:20:59,410 --> 00:21:00,880
إذًا، هل فهمتِ الآن؟

332
00:21:01,710 --> 00:21:02,840
ماذا؟

333
00:21:03,350 --> 00:21:04,680
.أعطني تلميحًا

334
00:21:04,810 --> 00:21:05,300
.لا أريد

335
00:21:05,410 --> 00:21:07,640
لماذا؟

336
00:21:08,420 --> 00:21:10,610
.الناس يصبحونَ لا يطاقون عندما يتقدَّمونَ في السن

337
00:21:11,120 --> 00:21:11,680
!مؤلم

338
00:21:26,900 --> 00:21:30,240
.في النهاية قد كان مهرجانًا مثاليًّا بالنسبة لنا

339
00:21:30,440 --> 00:21:31,870
.أنتَ محقّ

340
00:21:32,810 --> 00:21:34,970
.لكن رُبَّما توجَّبَ علينا شراء الكثير هذه المرَّة

341
00:21:35,440 --> 00:21:36,910
![كيكو]

342
00:21:38,110 --> 00:21:39,980
إلى متى ستبقينَ في شقَّتي؟

343
00:21:40,280 --> 00:21:42,650
.سأغادر اليوم

344
00:21:43,790 --> 00:21:45,910
ماذا؟ حقًّا؟

345
00:21:46,020 --> 00:21:48,850
.أنتَ أحمقٌ حقًّا
منذُ متى ونحنُ مرتبطون؟

346
00:21:49,330 --> 00:21:51,690
ولقد أحضرتَ الكثير من الأشياء القذرة اليوم، أليس كذلك؟

347
00:21:54,460 --> 00:21:57,730
...إنَّ أختكَ الصغيرة تعرفُ أكثر من اللازم

348
00:21:57,830 --> 00:21:58,770
أليس كذلك؟

349
00:21:58,870 --> 00:22:00,360
.لا شيء جيِّدٌ يأتي منهن

350
00:22:01,940 --> 00:22:04,060
.إذًا لقد فهمتِ

351
00:22:04,440 --> 00:22:05,170
فهمتُ ماذا؟

352
00:22:05,270 --> 00:22:06,740
.كيفَ هي مواعدة أوتاكو

353
00:22:07,380 --> 00:22:08,430
.هكذا تكون

354
00:22:08,740 --> 00:22:11,800
!ماذا؟ أتعنينَ هكذا

355
00:22:11,980 --> 00:22:12,450
.أجل

356
00:22:12,520 --> 00:22:14,280
...إذًا اليوم أنتِ سوف

357
00:22:17,990 --> 00:22:19,820
.أجل سأعود إلى شقَّتي، بالطبع

358
00:22:21,260 --> 00:22:23,490
.هذا قاسٍ

359
00:22:24,060 --> 00:22:27,030
.حسنًا، عليَّ أن أغتنمَ هذا الوقت بما أنَّني وحيدة

360
00:22:27,760 --> 00:22:31,030
لكن، ألا يعتبرُ هذا وكأنَّه يخونكِ؟

361
00:22:31,800 --> 00:22:33,100
.وهو كذلك

362
00:22:34,240 --> 00:22:36,260
.أنت مذهلةٌ، يا ني ـ سان

363
00:22:36,440 --> 00:22:38,240
.المديح لن يجعلني سعيدة

364
00:22:39,110 --> 00:22:41,100
...في هذه الحالة دعيني أبقى في شقَّتكِ الليلة

365
00:22:41,280 --> 00:22:42,140
!عودي

366
00:22:42,280 --> 00:22:45,440
لمَ فعلتِ هذا؟ -

367
00:22:43,780 --> 00:22:45,440
.أظنُّ أنَّ علاقتهم قد تحسَّنت

368
00:22:45,550 --> 00:22:47,280
.هذا ليسَ جيِّدًا

369
