1
00:00:00,820 --> 00:00:03,190
إنّنا نختار فريقنا الجديد للمشاركة في تصفيات

2
00:00:03,520 --> 00:00:05,440
.أول جابان للمحافظات المقرّرة إجراؤها في أغسطس

3
00:00:05,440 --> 00:00:07,480
إنّه ذلك الوقت من السّنة إذًا؟

4
00:00:07,480 --> 00:00:08,520
.نعم

5
00:00:08,520 --> 00:00:09,900
.تصبح الأمور جدّيّة في هذه المرحلة

6
00:00:10,220 --> 00:00:13,050
.سنقوم بتدحرج أرضيّ ورقص وحركات خطرة

7
00:00:13,050 --> 00:00:15,990
نريد من الفريق أن يفوز للحفاظ على
.سلسلة فوزنا الّتي استمرت لعامين

8
00:00:16,320 --> 00:00:17,710
.مشاركة تلميذات السّنة الثّانية ليست مضمونة

9
00:00:17,710 --> 00:00:20,520
وكالعادة، قد ينتهي بنا المطاف بالفريق
.الأوّل من تلميذات السّنة الأولى

10
00:00:20,520 --> 00:00:26,250
ولكن، كانت كاناتا تلميذة السّنة الأولى الوحيدة
.في منافسات المحافظات السّنة الماضية

11
00:00:44,070 --> 00:00:45,270
كيف حال كاناتا؟

12
00:00:45,570 --> 00:00:47,150
.إنّها تقوم بمراجعة في المشفى مرّة في الشّهر

13
00:00:47,150 --> 00:00:48,980
.لا يُسمح لها حتّى بمشاهدة التّشجيع

14
00:00:49,610 --> 00:00:51,360
.أخبرتها ألاّ تأتي حتّى تستعيد كامل عافيتها

15
00:00:52,800 --> 00:00:55,550
إنّك تركّزين كثيرًا على تلميذات
.السّنة الأولى يا هانا-بي

16
00:00:55,550 --> 00:00:58,680
.إنّ هانا-تشان تهتمّ لزميلاتها الأصغر

17
00:00:58,680 --> 00:01:00,380
.إنّها قلقة فحسب

18
00:01:00,380 --> 00:01:01,290
صحيح؟

19
00:01:01,290 --> 00:01:03,080
.لا تستخفّي بي يا هي

20
00:01:03,080 --> 00:01:06,540
إنّ هانا-تشان هي أكثر واحدة
.تهتمّ لأمر كاناتا-تشان

21
00:01:06,860 --> 00:01:09,260
...إنّها تقدّم لها معاملة خاصّة

22
00:01:09,260 --> 00:01:10,710
.بالتّعامل معها بصرامة

23
00:01:10,710 --> 00:01:13,450
!لم أقدّم أيّ معاملة خاصّة

24
00:01:14,840 --> 00:01:17,480
.لكنّها ستحتاج لوقت طويل حتّى تتحسّن

25
00:01:17,480 --> 00:01:20,110
.وتميل كاناتا-تشان لتحمّل الكثير من المسؤوليّات

26
00:01:20,110 --> 00:01:22,680
.على عكس هانا-تشان المتطلّبة بالكامل

27
00:01:23,690 --> 00:01:26,470
أنا القائدة. من الطّبيعيّ أن تكون
.لديّ متطلّبات من حين لآخر

28
00:01:27,700 --> 00:01:30,320
إنّها لا تعرف بالفعل كيف
.تقلق على مشاكلها الخاصّة

29
00:03:02,300 --> 00:03:03,740
!لقد طرت

30
00:03:06,300 --> 00:03:07,640
لماذا أنت هنا؟

31
00:03:08,480 --> 00:03:09,960
يتعلّق الأمر بالفيديوهات، صحيح؟

32
00:03:10,520 --> 00:03:14,340
أرى أشخاصًا مثلك كثيرًا في طريقي
.للمدرسة وهم يحملون كاميرا

33
00:03:14,340 --> 00:03:16,280
يصوّرونني وينشرون فيديوهات لي

34
00:03:16,280 --> 00:03:17,930
.ويستمتعون بذلك
.دون طلب الإذن منّي

35
00:03:17,930 --> 00:03:18,590
.أنت مصدر إزعاج

36
00:03:19,820 --> 00:03:20,800
.وتانيزاكي-سان أيضًا

37
00:03:21,130 --> 00:03:22,580
!ذ-ذلك ليس صحيحًا

38
00:03:22,580 --> 00:03:23,510
...إنّ شيون-تشان

39
00:03:23,980 --> 00:03:25,010
تشان"؟"

40
00:03:26,750 --> 00:03:30,380
أقصد أنّي التقيتُ بشيون-تشان
!صدفة فحسب

41
00:03:30,380 --> 00:03:31,980
!ألقت عليّ التّحيّة لا غير

42
00:03:36,030 --> 00:03:38,760
.لذلك... أردت إخبارك بهذا فحسب

43
00:03:41,660 --> 00:03:44,160
قفزت من فوق تلك التّلّة
لتخبريني بذلك فحسب؟

44
00:03:50,270 --> 00:03:55,860
!لقد طرت

45
00:03:52,560 --> 00:03:53,720
!أجل

46
00:04:06,750 --> 00:04:08,760
كان ما حدث البارحة رائع، صحيح؟

47
00:04:10,840 --> 00:04:13,720
.رأيتُ كاناتا-تشان تطير فوق تلّة دانغوزاكا

48
00:04:14,180 --> 00:04:16,540
دانغوزاكا؟ ماذا تقصدين بـ"طارت"؟

49
00:04:16,540 --> 00:04:20,360
،كانت تركض خلف أوبوناي-سان
.ثمّ التفّت فوق سيّارة

50
00:04:20,780 --> 00:04:22,770
!ما الّذي كنت تفكّرين فيه؟
!ذلك خطير

51
00:04:22,770 --> 00:04:24,070
...كنتُ

52
00:04:24,460 --> 00:04:30,680
.كان ذلك مخيفًا، لكن لم يسعني سوى المشاهدة

53
00:04:30,680 --> 00:04:31,890
مشاهدتي؟

54
00:04:31,890 --> 00:04:35,020
مهلاً يا كاناتا، هذا ما درستموه في الفصل؟

55
00:04:36,130 --> 00:04:38,500
.أعتقد ذلك

56
00:04:38,500 --> 00:04:41,860
.أخذتِ ملاحظات عن المعادلات الخطّيّة

57
00:04:43,060 --> 00:04:46,340
تعلمين أنّه لا يُسمح لك بالقيام بأنشطة النّادي
إذا كانت درجاتك أقلّ من المتوسّط، صحيح؟

58
00:04:46,340 --> 00:04:48,220
.ماذا؟ ذلك صارم

59
00:04:48,520 --> 00:04:49,650
.معك حقّ

60
00:04:49,650 --> 00:04:50,840
...قالت الرّئيسة

61
00:04:50,840 --> 00:04:51,780
!إيساوا-سان؟

62
00:04:51,780 --> 00:04:53,390
!ظهرت على التّلفاز قبل أيّام

63
00:04:53,390 --> 00:04:55,260
...فعلاً؟ لم أرها

64
00:04:55,260 --> 00:04:57,010
!ماذا؟ عليك مشاهدتها

65
00:04:57,010 --> 00:05:03,170
انضمّت إلى فريق التّشجيع في تاكانوزاكي
!وفازت بمنافسة أول جابان في سنتها الأولى

66
00:05:03,170 --> 00:05:04,740
!إنّها مذهلة

67
00:05:04,740 --> 00:05:06,450
أول جابان؟

68
00:05:06,450 --> 00:05:08,810
.إنّها منافسة تشجيع وطنيّة

69
00:05:08,810 --> 00:05:10,450
المنافسات الإقليميّة وشيكة أيضًا، صحيح؟

70
00:05:10,450 --> 00:05:11,120
.نعم

71
00:05:11,120 --> 00:05:12,910
.ستُجرى تجارب لاختيار المشاركات

72
00:05:13,480 --> 00:05:15,410
.آمل أن تنضمّي للفريق الأوّل ثانية

73
00:05:16,590 --> 00:05:17,370
.نعم

74
00:05:17,370 --> 00:05:19,640
.سأبذل جهدي أنا أيضًا

75
00:05:19,640 --> 00:05:23,090
بمجرّد أن أستعيد عافيتي، سأنتقل إلى
!تاكانوزاكي وسأنضمّ لفريق التّشجيع

76
00:05:23,440 --> 00:05:24,650
مثل وعدكما؟

77
00:05:24,650 --> 00:05:28,050
وعد الفوز بالمنافسات الوطنيّة
.أنت وكاناتا-تشان معًا

78
00:05:28,510 --> 00:05:29,810
تعرفين بشأن ذلك؟

79
00:05:29,810 --> 00:05:32,660
.نعم، سمعتُ القليل عنه من قبل

80
00:05:32,660 --> 00:05:33,470
!هذا صحيح

81
00:05:33,470 --> 00:05:34,920
!تعمل كاناتا بجدّ

82
00:05:34,920 --> 00:05:36,140
!لذلك لا يمكنني الجلوس دون فعل شيء

83
00:05:37,410 --> 00:05:38,480
.نعم

84
00:05:38,810 --> 00:05:40,290
.لكنّك تعملين بجدّ بالفعل

85
00:05:40,290 --> 00:05:46,200
،إعادة التّأهيل صعبة للغاية
.لكنّك تأخذين دروسًا عن بعد أيضًا

86
00:05:46,200 --> 00:05:47,360
.أنت مذهلة بالفعل

87
00:05:48,490 --> 00:05:50,250
...لا، لا، لا

88
00:05:51,160 --> 00:05:53,520
.حسنًا، كفانا دردشة الآن

89
00:05:53,520 --> 00:05:55,450
!أرني بقيّة الموادّ

90
00:05:55,450 --> 00:05:57,500
!لنطلب المساعدة من شيون-تشان

91
00:05:58,750 --> 00:06:01,190
!كفانا دراسة اليوم

92
00:06:04,440 --> 00:06:06,470
مرحبًا؟ أنّا-تشان؟

93
00:06:06,760 --> 00:06:09,050
ماذا؟ الآن؟

94
00:06:09,490 --> 00:06:11,180
!أعتذر على التّطفّل

95
00:06:11,180 --> 00:06:12,870
!مرحبًا

96
00:06:11,650 --> 00:06:14,030
!خطرت ببالي فكرة مشروع مذهلة

97
00:06:14,030 --> 00:06:14,750
!هذا رائع

98
00:06:14,750 --> 00:06:15,630
مشروع؟

99
00:06:14,750 --> 00:06:16,120
.لا تعرفين ما هي الفكرة بعد

100
00:06:16,120 --> 00:06:17,090
!شيون

101
00:06:17,090 --> 00:06:19,280
!شكرًا على المساعدة ذلك اليوم

102
00:06:20,650 --> 00:06:22,520
ومن هذه؟ ميغو؟

103
00:06:22,520 --> 00:06:24,230
.نعم، ميغو

104
00:06:24,570 --> 00:06:25,480
!ميغو

105
00:06:25,480 --> 00:06:26,830
!سررت بلقائك

106
00:06:26,830 --> 00:06:27,950
!مهلاً، مهلاً

107
00:06:28,330 --> 00:06:30,590
!يبدو أنّهم يلقون التّحيّة هكذا في البرازيل

108
00:06:30,590 --> 00:06:32,410
ماذا؟ أين نودوكا-تشان؟

109
00:06:34,250 --> 00:06:35,320
...شكرًا على استضافتي

110
00:06:35,720 --> 00:06:38,620
أنّا-تشان! لا يمكنك تقبيل النّاس
!هكذا بكلّ بساطة

111
00:06:42,100 --> 00:06:43,590
!أجل

112
00:06:43,590 --> 00:06:45,670
!تحدّي الرّامن الحارّ جدًّا

113
00:06:45,930 --> 00:06:46,930
الحارّ جدًّا؟

114
00:06:46,930 --> 00:06:47,550
!لا

115
00:06:47,550 --> 00:06:50,090
ما رأيك بهذا إذًا؟

116
00:06:47,920 --> 00:06:52,260
،عفوًا... تدير عائلتي محلّ زينة مذابح

117
00:06:50,090 --> 00:06:54,130
.سباق تحمّل تقشير البصل لثمانية ساعات

118
00:06:52,260 --> 00:06:56,100
.وذكرت جدّتي أنّك طلبت جرس أورين منّا

119
00:06:54,130 --> 00:06:55,760
!مستحيل

120
00:06:56,100 --> 00:06:58,570
تقصدين محلّ مذبح أوتاني؟

121
00:06:56,550 --> 00:07:00,410
هل يفترض بذلك أن يُبهج مشاهديك بالفعل؟

122
00:06:58,570 --> 00:07:00,320
!نعم، ذاك هو

123
00:07:00,410 --> 00:07:02,490
...لا بأس إذًا

124
00:07:00,740 --> 00:07:02,670
.شكرًا على خدماتكم

125
00:07:02,670 --> 00:07:04,140
.لا شكر على واجب

126
00:07:03,020 --> 00:07:04,620
نودوكا! هل تستمعين؟

127
00:07:04,620 --> 00:07:05,230
ماذا؟

128
00:07:06,140 --> 00:07:06,930
!عفوًا

129
00:07:06,930 --> 00:07:07,940
.تفضّلي يا شيون

130
00:07:09,150 --> 00:07:12,680
ما الغاية من هذه الفيديوهات؟

131
00:07:13,540 --> 00:07:14,660
!سؤال وجيه

132
00:07:14,660 --> 00:07:17,070
ستشاركين فيها ولا تعرفين حتّى؟

133
00:07:17,070 --> 00:07:18,930
...ربّما لا أكون قد أخبرتهما

134
00:07:18,930 --> 00:07:20,460
!إنّها قناة موسيقيّة

135
00:07:20,460 --> 00:07:21,210
موسيقيّة؟

136
00:07:22,670 --> 00:07:25,550
تقصدين أنّها فيديوهات رقص وغناء؟

137
00:07:25,550 --> 00:07:26,280
.نعم

138
00:07:26,280 --> 00:07:29,650
فيديوهات نتحدّث فيها عن أغانٍ
.نحبّها أو نؤدّي أغانينا الخاصّة

139
00:07:26,900 --> 00:07:28,410
رقص؟

140
00:07:29,650 --> 00:07:31,460
.لم أكن أعلم

141
00:07:32,180 --> 00:07:33,840
أتؤلّفين الموسيقى؟

142
00:07:33,840 --> 00:07:34,890
!نعم

143
00:07:34,890 --> 00:07:36,300
...حسنًا، وتاليًا

144
00:07:36,300 --> 00:07:38,970
!منافسة الغيوزا بالثّوم الإضافيّ

145
00:07:39,260 --> 00:07:40,810
!مستحيل

146
00:07:40,810 --> 00:07:41,860
أهذه موسيقى؟

147
00:07:41,860 --> 00:07:43,440
.لن أستطيع الذّهاب للمدرسة غدًا بعدها

148
00:07:43,870 --> 00:07:44,690
غدًا؟

149
00:07:44,690 --> 00:07:45,810
مع أنّ الغد يوم الأحد؟

150
00:07:46,120 --> 00:07:48,260
...إنّ ذلك

151
00:07:48,260 --> 00:07:49,450
اجتماع لجنة؟

152
00:07:49,450 --> 00:07:50,030
.نعم

153
00:07:51,020 --> 00:07:55,610
لدى مدرستي لجنة تدعم الفرق
.الرّياضيّة في المنافسات

154
00:07:55,990 --> 00:07:58,420
...لا أريد الذّهاب، ولكن

155
00:07:58,420 --> 00:08:01,080
!نودوكا مشجّعة

156
00:08:02,460 --> 00:08:03,650
.هذا مذهل

157
00:08:03,650 --> 00:08:06,570
.لكنّي لستُ بمستوى تاكانوزاكي

158
00:08:06,570 --> 00:08:08,340
لا تشاركن في المنافسات؟

159
00:08:09,220 --> 00:08:10,210
لا يعدّ ذلك تشجيعًا إذًا؟

160
00:08:10,650 --> 00:08:12,490
.هنالك العديد من نشاطات التّشجيع

161
00:08:12,490 --> 00:08:16,720
بدأ الأمر كتشجيع، ثمّ صار منافسة
.أو حتّى رقصًا في بعض الأحيان

162
00:08:17,780 --> 00:08:19,290
!يبدو ذلك ممتعًا

163
00:08:19,290 --> 00:08:21,270
!لنصوّر فيديوهات عن ذلك؟

164
00:08:22,460 --> 00:08:23,640
!عن ذلك؟

165
00:08:24,010 --> 00:08:25,100
!التّشجيع

166
00:08:34,710 --> 00:08:37,520
!نالي منهم يا ميسورا

167
00:08:37,520 --> 00:08:38,130
...ماذا

168
00:08:38,130 --> 00:08:41,570
هذا صحيح. إنّنا نكتب أغانينا
!الخاصّة ونقوم بالتّشجيع بها

169
00:08:41,570 --> 00:08:42,960
.سنصنع أزياءنا الخاصّة أيضًا

170
00:08:42,960 --> 00:08:45,200
!سيُبهج ذلك الجميع

171
00:08:45,950 --> 00:08:46,920
.يبدو هذا جيّدًا

172
00:08:46,920 --> 00:08:48,720
.عليك القيام بشيء ما أيضًا يا كاناتا

173
00:08:49,350 --> 00:08:50,710
.قد يمنحني ذلك الإلهام

174
00:08:51,100 --> 00:08:55,050
.عفوًا... أعتقد أنّي سأنتظر قليلاً قبل ذلك

175
00:08:59,400 --> 00:09:01,080
.صباح الخير

176
00:09:08,730 --> 00:09:10,020
...عفوًا

177
00:09:10,020 --> 00:09:11,020
.طاب يومك

178
00:09:18,530 --> 00:09:21,470
أقصد أنّي التقيتُ بشيون-تشان
!صدفة فحسب

179
00:09:21,470 --> 00:09:23,540
!ألقت عليّ التّحيّة فحسب

180
00:09:26,370 --> 00:09:27,710
...عفوًا

181
00:09:38,340 --> 00:09:39,830
!ناباتامي-سينباي

182
00:09:40,510 --> 00:09:41,760
هل كاناتا هنا؟

183
00:09:42,040 --> 00:09:44,840
.لا، قالت أنّها ستذهب لشراء الغداء

184
00:09:44,840 --> 00:09:45,880
الآن؟

185
00:09:45,880 --> 00:09:48,100
هل سيكون لديها وقت حتّى للأكل؟

186
00:10:05,380 --> 00:10:07,580
هل ألقيتِ نظرة على مجموعة
دردشة فريق التّشجيع؟

187
00:10:09,050 --> 00:10:10,710
...هانا-سينباي

188
00:10:17,540 --> 00:10:20,180
.لسنا بحاجة لك في أجنحة الصّقر للفوز

189
00:10:21,800 --> 00:10:23,760
.انسحبي من التّجارب رجاءً

190
00:10:25,340 --> 00:10:27,850
لن يكون هرمك موجودًا لأجلك
.في الفريق الأوّل

191
00:10:28,660 --> 00:10:32,890
اذهبي للاعتذار لعضوات القاعدة
.والمنتصف اللاّتي دعمنك

192
00:10:32,890 --> 00:10:35,660
تستطيع عضوة القمّة الطّيران
.فقط بفضل الجميع

193
00:10:48,280 --> 00:10:49,960
.هذا ظريف جدًّا

194
00:10:50,740 --> 00:10:52,410
.وهذا الزّيّ أيضًا

195
00:10:52,810 --> 00:10:55,020
...وهذا

196
00:10:55,020 --> 00:10:56,170
ربّما؟

197
00:10:56,460 --> 00:10:57,490
...حسنًا

198
00:10:57,490 --> 00:11:01,390
يبدو أنّي تورّطت في المشاركة
.في الفيديوهات أيضًا

199
00:11:01,390 --> 00:11:02,140
...نعم

200
00:11:03,910 --> 00:11:05,790
هل كلّ شيء على ما يرام
في فريق التّشجيع؟

201
00:11:05,790 --> 00:11:07,100
.سمعتُ أنّ تجارب الاختيار وشيكة

202
00:11:07,580 --> 00:11:08,480
ماذا؟

203
00:11:08,770 --> 00:11:10,530
.نعم، لا بأس بها

204
00:11:10,530 --> 00:11:12,570
.بإمكاننا التّدرّب بحرّيّة الآن

205
00:11:12,570 --> 00:11:15,770
.يتدرّب الجميع في دروس الجمباز وما شابه

206
00:11:16,110 --> 00:11:18,180
الجمباز؟

207
00:11:18,180 --> 00:11:19,470
.هذا مذهل

208
00:11:19,470 --> 00:11:21,110
يشارك الجميع بطريقته الخاصّة، صحيح؟

209
00:11:21,110 --> 00:11:21,960
.نعم

210
00:11:21,960 --> 00:11:24,570
.هنالك فتيات تذهبن حتّى في أيّام النّادي

211
00:11:24,880 --> 00:11:25,870
ماذا عنك؟

212
00:11:27,040 --> 00:11:28,380
...أنا

213
00:11:28,380 --> 00:11:31,160
هل أتخيّل أم أنّك تبدين محبطة مؤخّرًا؟

214
00:11:31,160 --> 00:11:32,830
أ-أأبدو كذلك؟

215
00:11:32,830 --> 00:11:34,130
.نعم

216
00:11:34,130 --> 00:11:36,050
هل أنت قلقة من التّجارب؟

217
00:11:36,050 --> 00:11:37,550
أم أنّ هنالك شيئًا ما يشغل بالك؟

218
00:11:37,550 --> 00:11:39,550
!لا، لا، أنا بخير

219
00:11:45,740 --> 00:11:47,390
ألن تأكلي اليوكان خاصّتك؟

220
00:11:47,390 --> 00:11:48,380
.سآكله

221
00:11:51,060 --> 00:11:53,060
.أعتقد أنّ الأخريات في طريقهنّ إلى هنا

222
00:11:53,060 --> 00:11:54,410
خمسة، صحيح؟

223
00:12:34,460 --> 00:12:35,600
ما رأيكنّ بهذا؟

224
00:12:39,290 --> 00:12:41,330
أسيكون التّشجيع بذلك صعبًا؟

225
00:12:41,330 --> 00:12:45,280
بحثتُ في الأمر، وغالبًا ما تكون موسيقى
.هاوس تُعرف بالأربعة على الأرض

226
00:12:45,580 --> 00:12:46,670
.ذلك مذهل

227
00:12:46,670 --> 00:12:48,000
الأربعة على الأرض؟

228
00:12:48,000 --> 00:12:51,080
اخترتُ أغنية رقص أحبّها وقمتُ بإعادة
.توزيعها لتكون مناسبة للرّقص أكثر

229
00:12:51,530 --> 00:12:52,850
مناسبة للرّقص؟

230
00:12:52,850 --> 00:12:54,220
أعدت توزيعها؟

231
00:12:54,220 --> 00:12:55,250
...هكذا

232
00:13:03,440 --> 00:13:04,540
!أنا أعرفها

233
00:13:04,540 --> 00:13:05,950
.سمعتُها من قبل

234
00:13:05,950 --> 00:13:08,180
ألم تفز هذه الأغنية بجائزة غرامي العام الماضي؟

235
00:13:08,180 --> 00:13:09,210
!نعم

236
00:13:09,210 --> 00:13:10,460
.أنجيلا أكويناس

237
00:13:10,460 --> 00:13:11,520
.هذا رائع

238
00:13:11,520 --> 00:13:12,480
!مذهل

239
00:13:12,480 --> 00:13:13,700
.سرّني سماع هذا

240
00:13:13,700 --> 00:13:15,520
.سأسألها إن كان بإمكاني استعمالها إذًا

241
00:13:16,350 --> 00:13:17,860
أتعرفينها؟

242
00:13:17,860 --> 00:13:21,060
لا أعرفها، لكن لا بدّ أنّ لها حسابات
...على مواقع التّواصل الاجتماعيّ

243
00:13:21,060 --> 00:13:21,930
أرأيتنّ؟

244
00:13:21,930 --> 00:13:23,060
.معك حقّ

245
00:13:23,870 --> 00:13:24,740
.أرسلتُ لها رسالة خاصّة

246
00:13:26,200 --> 00:13:27,500
...مذهل

247
00:13:27,500 --> 00:13:28,780
.إنّها سريعة

248
00:13:34,130 --> 00:13:35,550
.لقد رفضت

249
00:13:36,280 --> 00:13:38,210
لا يمكننا استعمال الأغنية إذًا؟

250
00:13:38,210 --> 00:13:39,830
.رُفضت في الحال

251
00:13:42,850 --> 00:13:44,550
...عـ-عفوًا

252
00:13:48,730 --> 00:13:50,970
هل سينجح شيء كهذا؟

253
00:13:57,980 --> 00:13:59,600
.إنّها موسيقى جميلة

254
00:14:00,000 --> 00:14:02,070
أنت من ألّفها يا شيون-تشان؟

255
00:14:04,190 --> 00:14:05,660
.نـ-نعم

256
00:14:05,660 --> 00:14:06,610
.قبل مدّة

257
00:14:06,910 --> 00:14:07,780
قبل مدّة؟

258
00:14:07,780 --> 00:14:09,820
.لم أعلم أنّك تحبّين مثل هذه الأمور

259
00:14:10,120 --> 00:14:11,530
...نـ-نعم

260
00:14:11,880 --> 00:14:13,330
إنّها ليست مجرّد هواية، صحيح؟

261
00:14:13,630 --> 00:14:14,200
ماذا؟

262
00:14:14,620 --> 00:14:16,650
.هذه ليست أغنية سيّئة

263
00:14:17,150 --> 00:14:19,420
شيون، هل تدرسين التّلحين؟

264
00:14:19,420 --> 00:14:20,980
...ماذا؟ لا

265
00:14:20,980 --> 00:14:22,340
...هذا مذهل

266
00:14:22,340 --> 00:14:25,920
علّمني أستاذ البيانو خاصّتي
.بعض الأشياء فحسب

267
00:14:33,010 --> 00:14:34,450
...في الحقيقة

268
00:14:34,450 --> 00:14:36,870
،أعلم أنّي لن أنجح أبدًا

269
00:14:37,490 --> 00:14:41,850
.لكنّي أردتُ أن أصير مغنّية ومؤلّفة أغانٍ

270
00:14:42,360 --> 00:14:44,940
.أعني أنّ ذلك كان في الماضي

271
00:14:45,780 --> 00:14:47,340
ماذا؟ لماذا تخلّيت عن ذلك؟

272
00:14:47,340 --> 00:14:48,300
!يمكنك النّجاح

273
00:14:48,300 --> 00:14:50,490
.نعم، فقد ألّفت موسيقى كهذه

274
00:14:51,190 --> 00:14:52,700
...تانيزاكي-سان

275
00:14:52,700 --> 00:14:56,750
...إنّك فتاة ميسورة وجنّيّة نوماتا

276
00:14:57,060 --> 00:14:59,360
ومغنّية ومؤلّفة أغانٍ أيضًا؟

277
00:14:59,830 --> 00:15:01,580
!أ-أنت إله

278
00:15:02,440 --> 00:15:04,710
لهذه الأغنية كلمات، صحيح؟

279
00:15:08,380 --> 00:15:10,270
!غنّيها يا شيون

280
00:15:10,270 --> 00:15:11,180
!أريد سماعك

281
00:15:11,180 --> 00:15:12,700
!وأنا أيضًا

282
00:15:16,090 --> 00:15:17,190
...عفوًا

283
00:15:17,720 --> 00:15:20,720
"...سوف يبدأ"

284
00:15:20,720 --> 00:15:21,810
.إنّها مثل شيء كهذا

285
00:15:22,930 --> 00:15:24,720
...عفوًا

286
00:15:25,130 --> 00:15:27,160
"...بداية بطيئة"

287
00:15:27,160 --> 00:15:28,280
.وما شابه

288
00:15:29,780 --> 00:15:30,870
.لم أسمع ذلك

289
00:15:34,740 --> 00:15:36,080
لن تضحكن عليّ؟

290
00:15:36,940 --> 00:15:38,160
لماذا قد نضحك؟

291
00:15:40,090 --> 00:15:41,390
.لن نضحك

292
00:15:50,570 --> 00:15:56,720
،لدينا جميعًا بداية عادلة
.مع وجود فرصة في قلوبنا

293
00:15:57,140 --> 00:16:01,340
.على الأقلّ، هذا ما اعتقدت

294
00:16:01,340 --> 00:16:06,880
،الحياة ليست عادلة إلى هذا الحدّ
...لكنّي ما زلت أريد أن أكون

295
00:16:09,300 --> 00:16:10,500
!هنالك دخيل

296
00:16:15,150 --> 00:16:16,000
"!نوسّا"

297
00:16:16,000 --> 00:16:16,880
كونويتشي؟

298
00:16:16,880 --> 00:16:18,450
...أوبوناي-سان؟ لماذا

299
00:16:22,120 --> 00:16:23,220
!شيون-تشان؟

300
00:16:34,100 --> 00:16:36,940
.حـ-حسنًا، طاب يومكما

301
00:16:36,940 --> 00:16:37,810
.نعم

302
00:16:37,810 --> 00:16:39,190
.طاب يومك

303
00:16:49,840 --> 00:16:52,300
عفوًا... يا سوزوها-تشان؟

304
00:16:52,300 --> 00:16:53,150
...لماذا

305
00:16:53,150 --> 00:16:55,740
.تبعتُ تانيزاكي-سان وانتهى بي الأمر هنا

306
00:16:56,850 --> 00:16:57,700
تبعتها؟

307
00:17:05,220 --> 00:17:07,800
.تانيزاكي-سان لا تردّ

308
00:17:09,070 --> 00:17:10,340
!سأذهب للبحث عنها

309
00:17:10,340 --> 00:17:12,680
!أنّا-تشان، مهلاً

310
00:17:22,650 --> 00:17:23,830
.برونهيلد

311
00:17:26,770 --> 00:17:27,820
...سُحقًا

312
00:17:28,910 --> 00:17:31,440
ألن تقومي بالباركور اليوم؟

313
00:17:31,890 --> 00:17:32,910
...تبًّا

314
00:17:32,910 --> 00:17:35,150
كيف يفترض بي أن أحصل على مشاهدات الآن؟

315
00:17:41,110 --> 00:17:42,050
ماذا؟

316
00:17:42,050 --> 00:17:43,420
!لماذا ضربتني؟

317
00:17:43,420 --> 00:17:44,780
هل أنت بخير يا سوزوها؟

318
00:17:44,780 --> 00:17:46,120
لم يتصرّف بانحراف معك، صحيح؟

319
00:17:46,750 --> 00:17:47,460
.صحيح

320
00:17:47,710 --> 00:17:48,970
.ذلك جيّد

321
00:17:48,970 --> 00:17:50,920
عفوًا، هل رأيت شيون؟

322
00:17:51,950 --> 00:17:52,880
.عادت للمنزل

323
00:18:18,440 --> 00:18:19,720
.طاب يومكما

324
00:18:22,420 --> 00:18:25,410
أنت لطيفة جدًّا، صحيح يا تانيزاكي-سان؟

325
00:18:30,010 --> 00:18:32,800
.أنا مثيرة للشّفقة

326
00:18:33,640 --> 00:18:37,590
أبذل جهدًا شديدًا في محاولة
.إظهار نفسي كشخص لطيف

327
00:18:37,940 --> 00:18:41,260
لا أملك ثقة للقيام بالأشياء الّتي أحبّ
.القيام بها، لذلك أخفي كلّ شيء

328
00:18:41,640 --> 00:18:43,010
إنّها ليست مجرّد هواية، صحيح؟

329
00:18:52,690 --> 00:18:55,420
.آسفة لأنّي غادرت في منتصف لقائنا

330
00:18:55,950 --> 00:19:00,860
لكنّي أشعر براحة غريبة بعد
.أن استمعتنّ جميعًا لأغنيتي

331
00:19:01,550 --> 00:19:03,750
كنتُ متردّدة حيال حلمي
.طوال هذا الوقت

332
00:19:03,750 --> 00:19:04,680
حلم؟

333
00:19:05,290 --> 00:19:07,580
.قرّرتُ أخيرًا أن آخذ خطوة للأمام لتحقيقه

334
00:19:07,880 --> 00:19:10,550
...خطوة لتحقيق حلم

335
00:19:12,420 --> 00:19:16,170
!فزنا بالمنافسات الوطنيّة

336
00:19:18,710 --> 00:19:22,410
.سأدخل إلى تاكانوزاكي وأقوم بالتّشجيع

337
00:19:22,410 --> 00:19:24,390
!معك مرّة أخرى

338
00:19:26,130 --> 00:19:26,930
!أجل

339
00:19:27,230 --> 00:19:28,650
!سأكون في انتظارك

340
00:19:32,890 --> 00:19:34,060
.أنا أيضًا

341
00:19:34,400 --> 00:19:37,140
.شجّعتني شيون-تشان أنا أيضًا

342
00:19:37,980 --> 00:19:40,780
.أريد أن أتقدّم للأمام نحو حلمي أيضًا

343
00:19:41,330 --> 00:19:43,990
.أريد أن أطير ثانية

344
00:19:49,330 --> 00:19:52,920
.وسأحقّق حلمي مع ميغومي

345
00:19:53,740 --> 00:19:56,000
.دعيني رجاءً أشارك في تجارب الاختيار

346
00:19:57,790 --> 00:19:59,870
!سأواصل ممارسة التّشجيع

347
00:20:00,170 --> 00:20:02,130
!سأنتظر ميغومي

348
00:20:06,290 --> 00:20:07,710
.نجحت

349
00:20:07,710 --> 00:20:08,680
!نجحت

350
00:20:09,790 --> 00:20:11,390
.سأكون بخير الآن

351
00:20:12,310 --> 00:20:14,240
أنت بخير الآن يا كاناتا؟

352
00:20:14,240 --> 00:20:15,950
بإمكانك الانضمام لتجارب الاختيار؟

353
00:20:15,950 --> 00:20:16,660
.نعم

354
00:20:17,740 --> 00:20:19,160
.نحن سعيدات لأجلك

355
00:20:19,160 --> 00:20:19,820
.كاناتا

356
00:20:20,190 --> 00:20:21,110
نعم؟

357
00:20:21,400 --> 00:20:24,450
إن كنتِ ستشاركين، فأتوقّع منك
.أن تكوني جميلة متفانية

358
00:20:24,450 --> 00:20:25,500
!نعم

359
00:20:26,160 --> 00:20:27,490
.التّالية. هانا

360
00:20:27,490 --> 00:20:28,230
.حاضرة

361
00:20:32,840 --> 00:20:33,730
!هذا هو المتوقّع من هانا

362
00:20:33,730 --> 00:20:34,820
!إنّها رائعة

363
00:20:34,820 --> 00:20:35,540
!مذهلة

364
00:20:35,540 --> 00:20:36,750
.التّالية. كاناتا

365
00:20:37,170 --> 00:20:38,340
!حاضرة

366
00:20:38,340 --> 00:20:39,220
.حظًّا سعيدًا

367
00:20:39,220 --> 00:20:40,680
.لا تقلقي يا كاناتا

368
00:20:40,680 --> 00:20:41,700
!ستنجحين

369
00:20:42,130 --> 00:20:43,390
.أنا أستطيع

370
00:20:47,650 --> 00:20:49,310
!أنا أستطيع

371
00:21:02,050 --> 00:21:03,230
!كاناتا

372
00:21:03,230 --> 00:21:04,240
هل أنت بخير؟

373
00:21:10,430 --> 00:21:11,660
هل تعانين من أيّ ألم؟

374
00:21:12,280 --> 00:21:13,620
.أنا بخير

375
00:21:14,170 --> 00:21:15,580
.أبليت حسنًا

376
00:21:16,220 --> 00:21:18,460
...عفوًا... أنا

377
00:21:18,460 --> 00:21:21,560
.اقلقي حيال ذهنك وجسدك قبل النّتائج

378
00:21:22,100 --> 00:21:23,560
.لا تحضري التّدريبات

379
00:21:23,560 --> 00:21:24,800
.اتّبعي أوامر الطّبيب

380
00:21:25,060 --> 00:21:27,480
.دعيني أجرّب ثانية لو سمحت

381
00:21:27,480 --> 00:21:29,130
.استطعتُ الطّيران قبل أيّام

382
00:21:29,130 --> 00:21:30,200
!أنا أستطيع ذلك

383
00:21:30,200 --> 00:21:31,450
—إنّ الأخريات يشجّعن

384
00:21:31,450 --> 00:21:33,320
.كاناتا. لا تتعجّلي

385
00:21:33,320 --> 00:21:35,320
.أمامك سنتان أخريتان

386
00:21:35,320 --> 00:21:38,620
.يمكن لرياضتنا أن تكون مميتة

387
00:21:38,620 --> 00:21:41,900
.قد تتأذّى الأخريات إن لم تكن إحدانا مثاليّة

388
00:21:44,680 --> 00:21:45,620
.حسنًا

389
00:21:51,490 --> 00:21:52,620
لماذا؟