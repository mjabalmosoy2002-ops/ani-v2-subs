1
00:00:14,180 --> 00:00:15,300
...لا تتعجّلي

2
00:00:15,740 --> 00:00:16,780
...لا تتلعثمي

3
00:00:17,220 --> 00:00:18,830
.تكلّمي ببطء

4
00:00:19,370 --> 00:00:23,290
.ممثّلات التّلميذات الجديدات، أوبوناي سوزوها

5
00:00:23,290 --> 00:00:26,790
.حاضرة

6
00:00:24,370 --> 00:00:25,820
.تانيزاكي شيون

7
00:00:34,370 --> 00:00:35,760
هذا يُوتّر، صحيح؟

8
00:00:41,830 --> 00:00:49,340
مع فصل الرّبيع الدّافئ هذا، سنعبر
.اليوم بوّابة أكاديميّة أوجو للفتيات

9
00:00:50,290 --> 00:00:53,040
...تانيزاكي شيون-سان

10
00:00:55,490 --> 00:00:57,620
...آسفة، إنّ اليوم

11
00:01:02,980 --> 00:01:04,250
!إنّها تانيزاكي-سان

12
00:01:04,250 --> 00:01:06,350
أنا محظوظة لأنّي رأيتها في هذا
!الوقت الباكر من الصّباح

13
00:01:06,350 --> 00:01:08,250
.صباح الخير يا أوبوناي-سان

14
00:01:08,250 --> 00:01:10,720
.صوت تانيزاكي-سان جميل جدًّا

15
00:01:12,250 --> 00:01:16,440
أتوتّر جدًّا لدرجة العجز عن الحديث
.معها بشكل لائق عندما ألتقي بها

16
00:01:16,440 --> 00:01:17,960
.تعالي رجاءً وقتما تحبّين

17
00:01:17,960 --> 00:01:18,430
.أكيد

18
00:01:18,780 --> 00:01:23,390
.ترغب هؤلاء الفتيات في الحديث معك

19
00:01:23,740 --> 00:01:26,470
انظروا لهنّ وهنّ يحاولن استعمال
...تانيزاكي-سان للتّقرّب منّي

20
00:01:26,470 --> 00:01:28,980
لماذا هؤلاء الفتيان هنا من الأساس؟

21
00:01:30,710 --> 00:01:32,020
أوبوناي-سان؟

22
00:01:32,380 --> 00:01:35,290
أنت لطيفة جدًّا، صحيح يا تانيزاكي-سان؟

23
00:01:36,060 --> 00:01:39,620
أقصد أنّي التقيتُ بشيون-تشان
!صدفة فحسب

24
00:01:39,620 --> 00:01:41,240
!ألقت عليّ التّحيّة لا غير

25
00:01:42,740 --> 00:01:45,450
!مستحيل! لم يكن للأمر علاقة بتانيزاكي-سان

26
00:01:45,450 --> 00:01:48,080
.كلاّ، كنتُ فظّة معها كثيرًا

27
00:01:48,080 --> 00:01:49,790
كيف يمكنني النّظر إلى وجهها غدًا؟

28
00:01:49,790 --> 00:01:51,960
...أنظر إلى وجهها هكذا دائمًا، ولكن

29
00:02:00,130 --> 00:02:01,450
...عفوًا

30
00:02:01,450 --> 00:02:02,470
.طاب يومك

31
00:02:09,110 --> 00:02:11,270
.ذُعرت وسرت أمامها فحسب

32
00:02:11,270 --> 00:02:13,770
بدا ذلك تصرّفًا فظًّا للغاية، صحيح؟

33
00:02:14,110 --> 00:02:15,480
...عفوًا

34
00:02:15,480 --> 00:02:17,300
.لا تعيري ما قلتُه يومها أيّ اهتمام

35
00:02:17,300 --> 00:02:18,650
.كان مجرّد سوء فهم

36
00:02:18,650 --> 00:02:20,850
.لم تكن غلطتك على الإطلاق

37
00:02:20,850 --> 00:02:23,160
!مهلاً، إلى أين تذهبين؟

38
00:02:27,010 --> 00:02:29,010
!لا يمكنني التّكلّم معها

39
00:02:29,010 --> 00:02:31,790
.آمل أن تلاحظ وجودي

40
00:02:35,330 --> 00:02:37,610
ما الّذي تنوي تانيزاكي-سان عليه؟

41
00:02:38,400 --> 00:02:39,380
...في الحقيقة

42
00:02:39,800 --> 00:02:42,260
،أعلم أنّي لن أنجح أبدًا

43
00:02:42,770 --> 00:02:47,100
.لكنّي أردتُ أن أصير مغنّية ومؤلّفة أغانٍ

44
00:02:47,440 --> 00:02:49,020
!ماذا؟ ذلك مذهل

45
00:02:49,020 --> 00:02:50,980
.أريدها أن تقيم حفلات وما شابه

46
00:02:54,350 --> 00:02:55,280
هل تغنّي؟

47
00:02:55,280 --> 00:02:56,660
!هل تانيزاكي-سان تغنّي؟

48
00:02:56,660 --> 00:02:58,240
!أريد سماع المزيد

49
00:03:02,100 --> 00:03:03,210
!هنالك دخيل

50
00:03:03,700 --> 00:03:05,660
!لا! لا! لستُ كذلك

51
00:03:19,470 --> 00:03:21,970
.حـ-حسنًا، طاب يومكما

52
00:03:22,320 --> 00:03:24,440
.نعم. طاب يومك

53
00:03:24,440 --> 00:03:25,800
ما العمل؟

54
00:03:25,800 --> 00:03:28,560
.تانيزاكي-سان تكرهني الآن

55
00:03:28,560 --> 00:03:31,100
ألن تقومي بالباركور اليوم؟

56
00:03:36,260 --> 00:03:37,210
ماذا؟

57
00:03:37,210 --> 00:03:38,520
!لماذا ضربتني؟

58
00:03:38,520 --> 00:03:41,340
لم يتصرّف بانحراف معك، صحيح؟

59
00:03:41,340 --> 00:03:41,940
.صحيح

60
00:03:41,940 --> 00:03:43,130
.ذلك جيّد

61
00:03:43,130 --> 00:03:45,420
عفوًا، هل رأيت شيون؟

62
00:03:45,420 --> 00:03:46,460
.عادت للمنزل

63
00:03:48,930 --> 00:03:51,270
أنت هنا لتصوير فيديوهات لي أيضًا، صحيح؟

64
00:03:52,240 --> 00:03:54,900
.لا. أنا في طريقي لرؤية شيون

65
00:03:54,900 --> 00:03:58,130
لكنّي أرغب بالفعل أن تظهري
.في فيديوهاتي

66
00:03:58,770 --> 00:03:59,760
تانيزاكي-سان؟

67
00:03:59,760 --> 00:04:00,520
.نعم

68
00:04:00,520 --> 00:04:03,160
ما رأيك بجائزة مشاركة تتمثّل
في ثلاثة أقلام رصاص؟

69
00:04:03,660 --> 00:04:04,460
.موافقة

70
00:04:05,650 --> 00:04:07,680
.سأظهر في فيديوهاتك

71
00:04:11,890 --> 00:04:14,180
!سوزوها

72
00:04:15,240 --> 00:04:17,690
!انظرن! سوزوها هنا

73
00:04:20,040 --> 00:04:20,780
!لماذا؟

74
00:04:20,780 --> 00:04:24,490
أوبوناي-سان؟ مشجّعة القمّة
من الأرانب البلاتينيّة؟

75
00:04:26,950 --> 00:04:28,750
!هذا مذهل

76
00:04:28,750 --> 00:04:30,380
لهذا السّبب يمكنك القفز
.في الأرجاء كثيرًا

77
00:04:30,380 --> 00:04:32,600
!سوزوها شُحنةٌ بمليون فولت

78
00:04:32,600 --> 00:04:34,440
أعتقد أنّها تقصد أنّها تساوي مائة عضوة؟

79
00:04:38,540 --> 00:04:39,920
.أتطلّع للعمل معك

80
00:04:44,150 --> 00:04:48,790
أريد التّقرّب أكثر من تانيزاكي-سان
.والاعتذار لها بشكل لائق

81
00:04:50,170 --> 00:04:51,160
.آسفة

82
00:04:51,160 --> 00:04:52,590
.أنا آسفة

83
00:04:52,590 --> 00:04:54,520
.أعتذر بشدّة

84
00:04:54,930 --> 00:04:57,150
.أنا في غاية الأسف

85
00:04:58,670 --> 00:04:59,780
.آسفة

86
00:06:32,600 --> 00:06:35,330
.في القاعدة، لدينا هيراغي وريوكو وأينا

87
00:06:35,330 --> 00:06:36,290
!نعم

88
00:06:36,290 --> 00:06:39,070
.في القمّة، لدينا مينامي وماكوتو وهانا

89
00:06:39,070 --> 00:06:39,860
!نعم

90
00:06:41,850 --> 00:06:42,670
.نعم

91
00:06:42,670 --> 00:06:43,870
.هذا كلّ ما لديّ

92
00:06:43,870 --> 00:06:46,200
.انقسمن إلى فِرق وقمن بحركات شدّ عضلات

93
00:06:46,200 --> 00:06:47,170
!نعم

94
00:06:47,740 --> 00:06:48,640
.هانا

95
00:06:50,920 --> 00:06:52,390
.أرسلتُ كاناتا للمنزل

96
00:06:53,600 --> 00:06:54,760
هل ستذهب للمستشفى؟

97
00:06:55,030 --> 00:06:58,440
،لا يبدو أنّها أصابت رأسها
.لذلك سيكون عليها الانتظار فحسب

98
00:06:58,820 --> 00:07:02,520
أفترض أنّه يجب أن يتحلّى
.المرء بالصّبر مع أشخاص مثلها

99
00:07:03,950 --> 00:07:05,440
.إنّها غلطتي

100
00:07:05,890 --> 00:07:08,320
.حدث كلّ هذا لأنّي لم أمنعها

101
00:07:08,580 --> 00:07:11,030
.لم أمنعها من القيام بالتّجارب أيضًا

102
00:07:11,560 --> 00:07:13,990
كاناتا هي الوحيدة الّتي بإمكانها
.إنجاز ركلة الالتفاف الثّلاثيّ

103
00:07:13,990 --> 00:07:17,450
!سأتعلّم... سأتعلّم كيف أقوم بذلك

104
00:07:34,560 --> 00:07:35,680
هل ستغادرين يا كاناتا؟

105
00:07:37,350 --> 00:07:39,850
تُلفُّ الخيوط كلّ واحد على حدة؟

106
00:07:39,850 --> 00:07:43,580
يبدو أنّ هذه هي الطّريقة الّتي
.اعتمدتها لِجان التّشجيع لأجيال

107
00:07:43,580 --> 00:07:46,220
هل سنعمل على كلّ هذا يا نودوكا؟

108
00:07:46,220 --> 00:07:47,280
.ذلك صحيح

109
00:07:47,280 --> 00:07:48,340
.ثلاثة آلاف خيط

110
00:07:48,340 --> 00:07:49,690
!ثلاثة آلاف؟

111
00:07:51,450 --> 00:07:53,490
تأخّرتِ اليوم، صحيح يا كاناتا؟

112
00:07:53,490 --> 00:07:54,820
فـ-فعلاً؟

113
00:07:54,820 --> 00:07:56,530
.كانت كاناتا على وشك المغادرة

114
00:07:57,190 --> 00:07:58,410
!صه

115
00:07:59,210 --> 00:08:02,370
ألم تنجحي في الانضمام للفريق الأوّل؟

116
00:08:03,720 --> 00:08:06,590
.نعم... لم أنجح

117
00:08:07,070 --> 00:08:09,000
.كانت هانا-سينباي جيّدة جدًّا

118
00:08:09,000 --> 00:08:10,410
الفريق الأوّل؟

119
00:08:10,410 --> 00:08:12,520
.أقمنا تجارب لاختيار فريق التّشجيع

120
00:08:12,520 --> 00:08:14,190
.لا عجب أنّ فريقكنّ قويّ جدًّا

121
00:08:14,190 --> 00:08:15,260
ماذا عن الفريق الثّاني؟

122
00:08:16,530 --> 00:08:18,160
.لم أنجح في الانضمام للفريق الثّاني أيضًا

123
00:08:19,620 --> 00:08:21,310
لماذا؟ هل حدث أمر ما؟

124
00:08:22,310 --> 00:08:26,610
.إنّني... أخفقتُ نوعًا ما

125
00:08:32,530 --> 00:08:34,460
.لقد تأخّرت

126
00:08:37,450 --> 00:08:38,790
أوبوناي-سان؟

127
00:08:39,570 --> 00:08:40,810
ماذا هنالك؟

128
00:08:40,810 --> 00:08:43,080
ألن تذهبي إلى منزل ميغومي-تشان اليوم؟

129
00:08:46,930 --> 00:08:49,080
...كنتُ أنتظر تانيزاكي-سان

130
00:08:49,080 --> 00:08:51,550
لكنّي سأبدو مثل مترصّدة
!إن أخبرتها بذلك، صحيح؟

131
00:08:51,550 --> 00:08:54,640
!ماذا أفعل؟ لم أفكّر في الأمر مليًّا

132
00:08:56,180 --> 00:08:58,780
!كلاّ، تسمّرت في مكانها

133
00:08:58,780 --> 00:09:01,560
.ربّما ما كان عليّ الحديث معها

134
00:09:01,560 --> 00:09:06,470
،لكنّي أغضبتُها كثيرًا
...وصدمتها بغنائي الفظيع

135
00:09:07,770 --> 00:09:09,050
تانيزاكي-سان؟

136
00:09:09,740 --> 00:09:11,440
!كلاّ، تجاهلتُها ثانية

137
00:09:11,440 --> 00:09:13,000
!عليّ أن أعتذر

138
00:09:13,000 --> 00:09:13,860
...لكن

139
00:09:16,450 --> 00:09:19,210
...بما أنّ ملامح وجهي هكذا دائمًا

140
00:09:25,430 --> 00:09:28,290
إنّني ألفّ وألفّ ولا تريد
!هذه الخيوط أن تنتهي

141
00:09:28,680 --> 00:09:30,920
.البومبوم الّتي تعدّينها جميلة يا شيون-تشان

142
00:09:30,920 --> 00:09:32,000
فعلاً؟

143
00:09:32,280 --> 00:09:33,860
.إنّك بارعة للغاية

144
00:09:33,860 --> 00:09:35,470
...سوزوها-تشان

145
00:09:44,060 --> 00:09:45,510
هل أنت خرقاء فحسب؟

146
00:09:47,400 --> 00:09:48,750
!لنعدّ البومبوم لاحقًا

147
00:09:48,750 --> 00:09:50,270
.إنّك تستسلمين بسرعة

148
00:09:50,270 --> 00:09:53,360
لكن بما أنّنا جميعًا هنا الآن، فسيكون من
اللّطيف التّدرّب على التّشجيع، صحيح؟

149
00:09:55,090 --> 00:09:55,820
صحيح؟

150
00:09:56,110 --> 00:09:58,010
!حسنًا، لنتجهّز لذلك

151
00:09:59,320 --> 00:10:03,450
حسنًا، لماذا لا تؤدّي شيون-تشان
وأنّا-تشان دور الرّاصدتين هذه المرّة؟

152
00:10:03,770 --> 00:10:06,910
بينما سوزوها-تشان ونودوكا-تشان
.ستدعمان عضوة القمّة

153
00:10:07,250 --> 00:10:08,500
.وتلك هي كاناتا

154
00:10:08,500 --> 00:10:09,770
.لنجرّب الأمر

155
00:10:09,770 --> 00:10:10,660
.آسفة

156
00:10:11,610 --> 00:10:12,660
...آسفة

157
00:10:12,660 --> 00:10:15,120
.لا أشعر أنّي أهل لذلك اليوم

158
00:10:15,120 --> 00:10:17,090
.أعتقد أنّي سأؤدّي دور الرّاصدة

159
00:10:17,710 --> 00:10:18,930
هل أنت بخير؟

160
00:10:18,930 --> 00:10:19,870
هل تشعرين بتوعّك؟

161
00:10:19,870 --> 00:10:20,670
.لا

162
00:10:20,670 --> 00:10:22,170
...ليس تمامًا

163
00:10:22,170 --> 00:10:23,210
لا يمكنك الطّيران؟

164
00:10:23,810 --> 00:10:26,560
لقد تسمّرت لوهلة في ذلك اليوم
.عندما أوشكتِ على القفز

165
00:10:30,220 --> 00:10:32,430
.بدا الأمر وكأنّ جسدك كان خائفًا

166
00:10:33,460 --> 00:10:34,520
...كاناتا

167
00:10:36,890 --> 00:10:38,110
.آسفة

168
00:10:39,380 --> 00:10:41,030
!ها قد قلتُ أشياء لا يجب عليّ قولها

169
00:10:42,130 --> 00:10:45,270
.ما عدت أستطيع الطّيران لسبب ما

170
00:10:51,540 --> 00:10:52,760
...فقدان المهارة

171
00:10:53,170 --> 00:10:59,550
إنّها حالة نفسيّة يصير فيها الرّياضيّ
.غير قادر على تأدية نشاطاته فجأة

172
00:10:59,930 --> 00:11:02,880
.لا يوجد أيّ علاج واضح لها

173
00:11:04,490 --> 00:11:08,480
.شاركت كاناتا في منافسة التّشجيع في ماي

174
00:11:09,650 --> 00:11:12,850
كانت تلميذة السّنة الوحيدة
.الّتي اُختيرت للمشاركة

175
00:11:13,370 --> 00:11:16,400
،ولكن مع أنّهنّ كنّ الأوفر حظًّا للفوز

176
00:11:16,400 --> 00:11:17,880
.انتهى الأمر بفريقهم في نهاية التّرتيب

177
00:11:18,580 --> 00:11:22,620
ومذّاك الحين، كانت تظلّ في منزلي للحديث
.حتّى عندما كان لديها تداريب في الصّباح

178
00:11:24,690 --> 00:11:26,660
.لا بدّ أنّ الأمر كان يُثقل على كاهلها

179
00:11:27,230 --> 00:11:29,020
.ربّما أرادت إخبارنا طوال هذا الوقت

180
00:11:30,630 --> 00:11:31,850
...أو ربّما

181
00:11:33,530 --> 00:11:35,310
.لم تستطع إخبارنا

182
00:11:41,340 --> 00:11:42,680
.لقد عدت

183
00:11:43,040 --> 00:11:45,660
كاناتا، لم تتحقّقي من رسائلك، صحيح؟

184
00:11:46,410 --> 00:11:49,880
كانت معلّمة التّشجيع
.والقائدة هنا قبل قليل

185
00:11:49,880 --> 00:11:52,810
لا يمكنك الانضمام لتجارب الاختيار
.وأنت ممنوعة من نشاطات النّادي

186
00:11:53,210 --> 00:11:54,730
ما الّذي قالتاه؟

187
00:11:54,730 --> 00:11:58,740
،قالتا أنّهما ستنتظرانك
.حتّى إن تطلّب الأمر نصف سنة أو سنة

188
00:12:00,570 --> 00:12:01,780
.لا حاجة للهلع

189
00:12:01,780 --> 00:12:03,160
.خذي وقتك فحسب

190
00:12:03,900 --> 00:12:04,830
...نعم

191
00:12:05,910 --> 00:12:08,910
أعتقد أنّ عليها التّوقّف
.عن القيام بفيديوهات التّشجيع

192
00:12:09,580 --> 00:12:11,580
وليس التّوقّف عن الحركات الخطيرة فقط؟

193
00:12:11,580 --> 00:12:16,620
،عندما بحثت في حالات فقدان المهارة
.قيل أنّ أخذ استراحة أمر ضروريّ

194
00:12:16,620 --> 00:12:19,220
.يبدو أنّها لا تحضر لقاءات النّوادي أيضًا

195
00:12:19,220 --> 00:12:21,760
.قد لا يكون الضّغط عليها فكرة جيّدة

196
00:12:21,760 --> 00:12:24,440
.على الأرجح أنّ علينا منحها بعض الوقت

197
00:12:24,440 --> 00:12:25,240
.لا

198
00:12:25,930 --> 00:12:27,920
!لا يمكننا استبعاد كاناتا

199
00:12:27,920 --> 00:12:28,810
!كلاّ

200
00:12:29,150 --> 00:12:31,690
!إنّ التّعامل بلطف معها يعني دفعها بعيدًا

201
00:12:31,690 --> 00:12:33,980
"إنّ الكانجي لـ"التّصرّف بمراعاة
!يضمّ كلمة "بعيد" أيضًا

202
00:12:33,980 --> 00:12:35,000
!ألا تعلمن ذلك؟

203
00:12:35,000 --> 00:12:35,980
...أنّا-تشان

204
00:12:35,980 --> 00:12:38,480
.ستقرّر كاناتا إن كانت ستشارك أم لا

205
00:12:38,480 --> 00:12:40,570
!لا يمكننا اتّخاذ ذلك القرار نيابةً عنها

206
00:12:42,600 --> 00:12:45,300
.أتفهّم الأمر نوعًا ما

207
00:12:45,300 --> 00:12:48,130
كان من المزعج كيف كان النّاس
من حولي حذرين جدًّا معي

208
00:12:48,130 --> 00:12:50,640
.عندما دخلت المشفى في المدرسة الإعداديّة

209
00:12:51,290 --> 00:12:55,530
لكنّ كاناتا كانت تأتي وتتحدّث معي
.وكأنّ كلّ شيء طبيعيّ

210
00:12:55,530 --> 00:12:56,710
.أحببتُ لك

211
00:12:57,950 --> 00:13:01,590
.لا أعتقد أنّ كاناتا سترفض القيام بالتّشجيع

212
00:13:01,590 --> 00:13:02,990
.إنّها تحبّ التّشجيع

213
00:13:03,870 --> 00:13:06,430
لكن هل من المناسب فعلاً دعوتها؟

214
00:13:07,510 --> 00:13:09,930
.ربّما بإمكاننا دعم كاناتا

215
00:13:09,930 --> 00:13:10,780
دعم؟

216
00:13:10,780 --> 00:13:12,050
!هذه هي

217
00:13:12,050 --> 00:13:15,180
تقصدين أن ندعمها
من خلال التّشجيع، صحيح؟

218
00:13:15,180 --> 00:13:16,350
.هيّا يا سوزوها

219
00:13:16,350 --> 00:13:18,850
.كلاّ

220
00:13:17,270 --> 00:13:18,210
!لِمَ لا؟

221
00:13:18,850 --> 00:13:20,020
رغم أنّك كنت تمارسين التّشجيع؟

222
00:13:20,020 --> 00:13:21,040
.ليس بعد الآن

223
00:13:21,040 --> 00:13:22,970
...هكذا إذًا

224
00:13:22,970 --> 00:13:24,800
.سأكون عضوة القمّة إذًا

225
00:13:25,220 --> 00:13:28,120
.أنت كبيرة جدًّا على ذلك
.لن أستطيع حملك

226
00:13:29,330 --> 00:13:31,450
.قومي أنت بذلك إذًا يا نودوكا

227
00:13:39,000 --> 00:13:43,050
.ميغومي... قطعنا أنا وصديقتي وعدًا

228
00:13:43,050 --> 00:13:46,560
.ولا أريد أن أكون عبئًا على زميلاتي الأكبر

229
00:13:47,800 --> 00:13:51,360
يميل فقدان المهارة على التّأثير
.أكثر على الأشخاص الجادّين

230
00:13:51,360 --> 00:13:53,980
إنّك تقومين بالتّشجيع
منذ الصّفّ الخامس، صحيح؟

231
00:13:53,980 --> 00:13:54,960
.نعم

232
00:13:54,960 --> 00:13:59,790
ذهبتُ لمشاهدة مباراة كرة القاعدة مع
.عائلتي وأحببتُ كم كان التّشجيع ظريفًا

233
00:13:59,790 --> 00:14:01,170
فعلاً؟

234
00:14:01,170 --> 00:14:03,820
.لكنّ ذلك ليس كلّ شيء

235
00:14:03,820 --> 00:14:07,860
.إنّكنّ تضعن حياتكنّ بين أيدي بعضكنّ

236
00:14:08,730 --> 00:14:10,400
.لا بدّ أنّ ذلك أرعبك

237
00:14:18,850 --> 00:14:21,920
.لا يوجد أيّ علاج واضح لها

238
00:14:22,260 --> 00:14:24,820
.ربّما بإمكاننا دعم كاناتا

239
00:14:36,330 --> 00:14:37,640
أغنية جديدة؟

240
00:14:38,390 --> 00:14:40,720
عن كاناتا-تشان وميغومي-تشان؟

241
00:14:40,720 --> 00:14:41,770
.نعم

242
00:14:41,770 --> 00:14:44,480
...كنتُ أستمع لميغومي-تشان و

243
00:14:44,480 --> 00:14:45,610
...شيون-تشان

244
00:14:45,610 --> 00:14:48,680
سيكون من اللّطيف إن استطاع
!أحد ما أن يغنّيها

245
00:14:48,680 --> 00:14:49,240
ماذا؟

246
00:14:49,530 --> 00:14:50,140
لماذا؟

247
00:14:50,140 --> 00:14:51,060
لأنّك لا تميّزين بين النّغمات؟

248
00:14:51,060 --> 00:14:52,180
!أنّا-تشان

249
00:14:52,180 --> 00:14:53,210
.نعم

250
00:14:53,210 --> 00:14:58,040
لا يمكن التّركيز على الكلمات
.إن كان غنائي السّيّئ مشتِّتًا

251
00:14:58,460 --> 00:15:02,270
أظنّ أنّها ستكون مؤثّرة أكثر
.إن كانت من أداء مغنّية أفضل

252
00:15:02,270 --> 00:15:03,670
.ذلك ليس صحيحًا

253
00:15:03,670 --> 00:15:05,560
.أنت من ألّف الأغنية

254
00:15:05,560 --> 00:15:08,880
.إنّك تفهمين الأغنية أكثر من أيّ أحد

255
00:15:09,210 --> 00:15:11,810
أرغب في سماعك تغنّين أكثر من
.رغبتي في سماع مغنّية جيّدة تُغنّي

256
00:15:11,810 --> 00:15:12,970
.من الظّريف كم أنّك عاجزة عن تمييز النّغمات

257
00:15:12,970 --> 00:15:14,280
.أحبّ ذلك أكثر في الحقيقة

258
00:15:14,280 --> 00:15:15,950
تـ-تحبّين ذلك؟

259
00:15:18,090 --> 00:15:19,880
...سوزوها-تشان، أنت

260
00:15:21,670 --> 00:15:22,810
.لقد هربت

261
00:15:23,370 --> 00:15:25,070
!سوزوها

262
00:15:25,070 --> 00:15:27,360
!سوزوها-تشان

263
00:15:33,700 --> 00:15:35,040
أوبوناي-سان؟

264
00:15:37,370 --> 00:15:39,820
.أنا آسفة على ما حدث ذلك اليوم

265
00:15:41,330 --> 00:15:44,480
.أردتُ الاعتذار طوال هذا الوقت

266
00:15:44,990 --> 00:15:49,420
.لكنّي ظننتُ أنّك قد تكرهينني
.كنتُ خائفة

267
00:15:49,900 --> 00:15:50,990
لماذا؟

268
00:15:54,040 --> 00:15:56,650
لماذا أنت غاضبة دائمًا يا سوزوها-تشان؟

269
00:15:56,650 --> 00:15:58,500
لماذا لا تبتسمين؟

270
00:16:00,210 --> 00:16:02,480
.سوزوها-تشان مخيفة

271
00:16:03,690 --> 00:16:05,440
...لستُ غاضبة

272
00:16:09,330 --> 00:16:13,610
لا أجيد التّعبير بوجهي، فيأخذ النّاس
.فكرة خاطئة عنّي ويكرهونني

273
00:16:14,050 --> 00:16:16,870
.توقّفتُ عن التّشجيع لأنّي لا أستطيع الابتسام أيضًا

274
00:16:19,350 --> 00:16:23,750
.أعتقد أنّك مذهلة يا أوبوناي-سان

275
00:16:24,660 --> 00:16:27,610
.أنت مسترخية جدًّا وصريحة مع نفسك

276
00:16:27,610 --> 00:16:29,750
.وأنت حرّة، على عكسي

277
00:16:30,490 --> 00:16:34,180
كان ذلك ظنّي بك منذ مراسم
.الدّخول المدرسي

278
00:16:35,670 --> 00:16:37,880
.لكنّي لم أستطع إخبارك

279
00:16:37,880 --> 00:16:40,040
.لم يسعني سوى إلقاء التّحيّة عليك

280
00:16:41,290 --> 00:16:42,930
...إن كنت لا تمانعين، أريد أن

281
00:16:43,990 --> 00:16:45,190
...تانيزاكي-سان

282
00:16:45,830 --> 00:16:47,190
!سوزوها! أنت هناك

283
00:16:52,040 --> 00:16:53,360
!إنّنا نقوم بالتّشجيع

284
00:16:53,690 --> 00:16:56,030
!يجب أن تكوني عضوة القمّة

285
00:16:56,030 --> 00:16:57,280
أنا؟

286
00:16:57,280 --> 00:16:59,810
.أريد رؤيتك تقومين بالتّشجيع يا أوبوناي-سان

287
00:16:59,810 --> 00:17:01,870
.سأعمل على أغنيتي أيضًا

288
00:17:16,530 --> 00:17:17,160
نعم؟

289
00:17:17,900 --> 00:17:19,510
كاناتا؟

290
00:17:19,820 --> 00:17:21,630
ما الّذي تفعلينه؟ تختبئين؟

291
00:17:21,630 --> 00:17:23,200
...ذلك

292
00:17:23,200 --> 00:17:24,480
.هذا لا يهمّ

293
00:17:24,910 --> 00:17:26,410
كيف كانت الزّيارة للمصحّة؟

294
00:17:26,770 --> 00:17:28,700
.قالوا لي أن أسترخي

295
00:17:29,240 --> 00:17:32,930
.ما زلنا لا نعرف ما الّذي يسبّب فقداني للمهارة

296
00:17:32,930 --> 00:17:33,780
.هكذا إذًا

297
00:17:34,700 --> 00:17:37,850
من المخيف مواجهة شيء لا يمكنك فهمه، صحيح؟

298
00:17:39,300 --> 00:17:41,070
.سأساعدك في التّفكير في الأمر

299
00:17:42,270 --> 00:17:46,830
لم أكن قادرة حتّى على حمل
.عيدان الأكل بعد جراحتي

300
00:17:47,310 --> 00:17:50,320
.وظننتُ أنّي لن أقوم بالتّشجيع ثانية أبدًا

301
00:17:51,210 --> 00:17:54,880
.لكنّك أتيت دائمًا للاطمئنان عليّ

302
00:17:56,410 --> 00:18:02,000
وأنا قادرة على مواصلة إعادة
.التّأهيل لأنّك تؤمنين أنّي سأتحسّن

303
00:18:03,950 --> 00:18:06,130
.لذلك أنا أيضًا أؤمن بك

304
00:18:06,130 --> 00:18:07,360
.يمكنك إخباري بأيّ شيء

305
00:18:07,360 --> 00:18:09,120
.سأقوم بدور الرّاصدة لك

306
00:18:09,120 --> 00:18:11,800
.سأمسك بك

307
00:18:12,360 --> 00:18:13,400
.حسنًا

308
00:18:14,670 --> 00:18:15,860
...بالمناسبة

309
00:18:15,860 --> 00:18:18,910
آسفة لأنّي لم أستطع إخبارك
.بشأن حالة فقداني للمهارة

310
00:18:20,200 --> 00:18:21,380
.شكرًا لك

311
00:18:22,080 --> 00:18:23,120
.وأنا أيضًا

312
00:18:24,080 --> 00:18:25,740
.شعرك مبلّل يا كاناتا

313
00:18:25,740 --> 00:18:27,150
.عليك تجفيفه

314
00:18:29,580 --> 00:18:32,560
.كاناتا، توصّلنا ببعض الكرز

315
00:18:36,780 --> 00:18:39,760
هناك الكثير. هلاّ أخذت بعضه
لمنزل ميغو-تشان؟

316
00:18:40,520 --> 00:18:42,300
.حسنًا

317
00:18:45,670 --> 00:18:47,770
.والآن، استدرن هنا

318
00:19:01,700 --> 00:19:03,280
.لنكرّر ذلك مرّة أخرى

319
00:19:06,150 --> 00:19:07,000
!كاناتا-تشان –
!كاناتا –

320
00:19:07,900 --> 00:19:09,990
.مرحبًا بالجميع

321
00:19:10,900 --> 00:19:12,460
أغنية جديدة؟

322
00:19:12,460 --> 00:19:16,100
.كنّا سنخبرك بعد أن نقوم بتحسينها أكثر

323
00:19:16,100 --> 00:19:17,480
!إنّنا نقوم بها لدعمك

324
00:19:17,480 --> 00:19:18,340
!سنخبرها الآن؟

325
00:19:19,970 --> 00:19:22,720
عفوًا... أيمكنني الانضمام؟

326
00:19:23,480 --> 00:19:24,800
!أكيد! أكيد

327
00:19:24,800 --> 00:19:26,220
.الهدف منها هو تشجيعك أنت

328
00:19:26,850 --> 00:19:31,360
.لا يمكنني؟ أريد تشجيع نفسي أيضًا

329
00:19:31,690 --> 00:19:33,080
.نعم، نعم

330
00:19:34,110 --> 00:19:35,610
...كاناتا

331
00:19:37,920 --> 00:19:39,360
!كنّ حذرات

332
00:19:39,800 --> 00:19:41,480
.سأمسك بك

333
00:19:41,480 --> 00:19:42,350
.حسنًا

334
00:19:52,760 --> 00:19:53,710
.آسفة

335
00:19:53,710 --> 00:19:54,810
.لا بأس

336
00:19:55,350 --> 00:20:00,970
يقال أنّه يجب أن نؤمن بالشّخص
.الّذي ندعمه مهما كلّف الأمر

337
00:20:01,610 --> 00:20:02,930
نؤمن؟

338
00:20:02,930 --> 00:20:03,930
.نعم

339
00:20:03,930 --> 00:20:06,390
.ونحن نشجّعك أنت هذه المرّة

340
00:20:06,930 --> 00:20:09,360
تُؤمنّ بي أنا؟

341
00:20:10,980 --> 00:20:13,440
.سرقتُ تلك الجملة من زميلة في اللّجنة

342
00:20:14,450 --> 00:20:16,050
...بالمناسبة يا كاناتا

343
00:20:16,400 --> 00:20:17,610
ماذا؟

344
00:20:17,950 --> 00:20:19,570
.خذي. هذه لك

345
00:20:20,840 --> 00:20:22,450
صنعتها لي أنا؟

346
00:20:22,720 --> 00:20:24,360
.من أعماق قلبي

347
00:20:25,590 --> 00:20:27,410
...أنا أشجّعك أيضًا

348
00:20:27,410 --> 00:20:28,350
.حسنًا

349
00:20:37,070 --> 00:20:39,760
.أنت بارعة في ذلك. لنشجّع معًا

350
00:20:39,760 --> 00:20:40,570
!حسنًا

351
00:20:51,010 --> 00:20:52,230
.لقد طرت

352
00:20:57,880 --> 00:21:00,610
!نجحت يا كاناتا –
!أنّا-تشان –

353
00:21:00,610 --> 00:21:02,440
!نجحت يا كاناتا-تشان

354
00:21:04,940 --> 00:21:06,470
!كان ذلك رائعًا

355
00:22:45,490 --> 00:22:46,800
.أوبوناي-سان

356
00:22:49,170 --> 00:22:51,490
.أعجبني الرّاب خاصّتك

357
00:22:51,490 --> 00:22:52,620
فعلاً؟

358
00:22:52,620 --> 00:22:54,140
.كان ذلك بفضلك أنت

359
00:22:55,020 --> 00:22:57,450
.لم يكن بفضلي

360
00:23:00,630 --> 00:23:03,110
...عفوًا، إن لم تمانعي

361
00:23:03,550 --> 00:23:06,710
تذكرين تلك الأغنية
الّتي غنّيتِها في المعبد؟

362
00:23:07,160 --> 00:23:08,100
.أريد سماعها ثانية

363
00:23:10,290 --> 00:23:14,970
.إنّ تلك الأغنية تتحدّث عن روعتك

364
00:23:14,970 --> 00:23:17,080
.إنّها محرجة قليلاً

365
00:23:21,140 --> 00:23:22,380
!أوبوناي-سان؟

366
00:23:22,770 --> 00:23:24,960
!أوبوناي-سان