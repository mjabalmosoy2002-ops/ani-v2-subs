أشعر دائمًا أنّ بإمكاني بذل جهد أكبر
.في أيّ شيء عندما يشجّعني النّاس أيضًا

176
00:11:02,580 --> 00:11:05,780
لماذا لا نغيّر طريقة دعمنا لهم إذًا؟

177
00:11:05,780 --> 00:11:10,490
سنظلّ نشجّعهم جميعًا معًا، بينما سنحاول
.أيضًا التّعامل معهم بشكل فرديّ

178
00:11:10,490 --> 00:11:12,220
نقوم بالأمر وحدنا؟

179
00:11:12,220 --> 00:11:14,450
ربّما علينا تشكيل فرق أصغر؟

180
00:11:14,450 --> 00:11:17,340
!لن تكون بومبومز هي بومبومز لو لم نكن معًا

181
00:11:17,340 --> 00:11:18,190
...صحيح

182
00:11:22,410 --> 00:11:23,170
.إنّها تمطر

183
00:11:23,900 --> 00:11:25,440
!تركت هاتفي في الخارج

184
00:11:25,440 --> 00:11:26,540
!إنّها تمطر بغزارة

185
00:11:26,540 --> 00:11:27,200
!وفجأة هكذا؟

186
00:11:27,760 --> 00:11:28,860
!الدّرّاجة

187
00:11:28,860 --> 00:11:30,000
!كاناتا-تشان

188
00:11:58,690 --> 00:12:00,570
.الشّاي يا شي-تشان

189
00:12:00,570 --> 00:12:01,720
.شكرًا لك

190
00:12:02,480 --> 00:12:06,010
سوزوها، وماذا عنّي؟

191
00:12:06,010 --> 00:12:07,760
.شربتِ الماء سلفًا

192
00:12:08,610 --> 00:12:10,750
...بشأن اجتماعاتنا القادمة

193
00:12:10,750 --> 00:12:12,990
.سأذهب لزيارة زبائن في البلدة

194
00:12:12,990 --> 00:12:15,370
هل تستطيع إحداكنّ الذّهاب
إلى الأماكن البعيدة؟

195
00:12:15,370 --> 00:12:17,370
ما رأيك أن نذهب أنا وأنت يا كاناتا-تشان؟

196
00:12:17,370 --> 00:12:17,950
أتواقفين؟

197
00:12:17,950 --> 00:12:18,660
.أكيد

198
00:12:20,670 --> 00:12:24,330
!دماغي في حالة فوضى كبيرة

199
00:12:24,330 --> 00:12:25,640
...نودوكا

200
00:12:25,960 --> 00:12:29,030
كم أغنية عليّ أن أؤلّف بعد؟

201
00:12:29,800 --> 00:12:31,270
...عفوًا

202
00:12:36,690 --> 00:12:38,820
.هذا كثير جدًّا، حتّى إن ساعدتك أيضًا

203
00:12:40,130 --> 00:12:42,190
.من المستحيل أن نستطيع القيام بكلّ هذا

204
00:12:42,190 --> 00:12:44,280
حتّى بمساعدتك لي؟

205
00:12:44,280 --> 00:12:48,240
تقولين أنّك تستطيعين، لكنّك كنت تتّكئين
!على عمود النّور نائمة هذا الصّباح

206
00:12:48,560 --> 00:12:50,950
!ستنهارين إن واصلتِ هذا

207
00:12:52,010 --> 00:12:54,170
...كنت أفكّر

208
00:12:54,700 --> 00:12:58,320
أهكذا يجب أن يكون تشجيعنا فعلاً؟

209
00:12:58,970 --> 00:13:02,350
إنّنا منهكات للغاية من مجرّد
.تلبية جميع الطّلبات الّتي تصلنا

210
00:13:03,990 --> 00:13:06,580
.لا أعرف إن كنّا نُحدث أيّ تأثير بالفعل

211
00:13:14,100 --> 00:13:15,390
.لقد نامت

212
00:13:16,940 --> 00:13:19,610
.دعننا نرفض بعض الطّلبات

213
00:13:20,220 --> 00:13:22,830
.سيكون علينا تقرير ما لن نقوم به

214
00:13:22,830 --> 00:13:24,790
.وإلاّ، فسننهار

215
00:13:25,400 --> 00:13:30,310
كاناتا، هذا ما علينا فعله إن كنّا سنواصل
.تشجيع المزيد من النّاس

216
00:13:32,910 --> 00:13:33,680
...نعم

217
00:13:35,050 --> 00:13:36,150
.مفهوم

218
00:13:37,010 --> 00:13:38,490
كيف سنقرّر هذا؟

219
00:13:38,490 --> 00:13:40,030
.أنا سأقرّر

220
00:13:40,030 --> 00:13:41,750
!علينا أخذ تلك القرارات معًا

221
00:13:42,910 --> 00:13:44,340
.أنا جيّدة في مثل هذه الأمور

222
00:13:44,340 --> 00:13:48,320
لنرفض أيّ شيء قد لا نملك موسيقى
أو رقصات جاهزة له

223
00:13:48,320 --> 00:13:50,600
.وأيّ طلبات ليست واضحة تمامًا

224
00:13:50,930 --> 00:13:52,900
...هذا، وهذا، وهذا

225
00:13:52,900 --> 00:13:54,330
ذاك أيضًا؟

226
00:13:54,330 --> 00:13:56,170
.وخاصّة غير الواضحة منها

227
00:13:56,170 --> 00:13:57,790
.علينا رفضها كما يجب

228
00:14:05,910 --> 00:14:07,400
.لقد صارت أقلّ بكثير

229
00:14:11,420 --> 00:14:13,770
إنّه ليس أمرًا عليك أن تشعري
.بالإحباط بسببه يا كاناتا

230
00:14:16,430 --> 00:14:19,750
.أتمنّى لو كان بإمكاني القيام بشيء للمساعدة

231
00:14:20,700 --> 00:14:24,740
لكنّك تصوّرين الفيديوهات وتصمّمين
...الرّقصات والتّراكيب يا ميغو

232
00:14:24,740 --> 00:14:26,510
.إنّك تقومين بالكثير

233
00:14:26,510 --> 00:14:27,240
—لكن

234
00:14:27,240 --> 00:14:28,700
.لا بأس

235
00:14:28,700 --> 00:14:30,590
.سأعمل بجدّ أكثر

236
00:14:30,590 --> 00:14:31,550
موافقة؟

237
00:14:45,100 --> 00:14:46,020
.حسنًا

238
00:14:49,030 --> 00:14:50,510
.أنا قادمة

239
00:14:51,050 --> 00:14:53,150
!خدمة بومبومز لتوصيل التّشجيع

240
00:14:53,740 --> 00:14:56,500
.سبق وتلقّيتُ اعتذارًا برسالة إلكترونيّة

241
00:14:57,300 --> 00:14:59,860
لقد وصلتنا الكثير من الطّلبات
.ولا نستطيع الاستجابة لها كلّها

242
00:14:59,860 --> 00:15:03,300
.اسمحي لي بالاعتذار على رفض طلبك

243
00:15:03,300 --> 00:15:04,130
!أنا آسفة

244
00:15:04,600 --> 00:15:05,620
...حسنًا

245
00:15:06,950 --> 00:15:10,080
!أنا هنا وحدي، لكنّي سأشجّعك

246
00:16:21,550 --> 00:16:23,070
...كم أنا متعبة

247
00:16:25,550 --> 00:16:28,050
لدى ميغو علاج طبيعيّ، أليس كذلك؟

248
00:16:28,050 --> 00:16:29,690
.أتساءل إن عادت للمنزل

249
00:16:32,890 --> 00:16:34,630
.مرحبًا

250
00:16:47,600 --> 00:16:48,550
!ميغو

251
00:16:49,140 --> 00:16:51,360
ما الخطب يا كاناتا؟

252
00:16:51,360 --> 00:16:52,620
!ميغو

253
00:16:58,610 --> 00:17:00,200
.كوني حذرة

254
00:17:00,200 --> 00:17:01,700
.لا تضغطي على نفسك

255
00:17:02,930 --> 00:17:04,510
.العلاج الطّبيعيّ ليس كافيًا

256
00:17:05,290 --> 00:17:08,840
،علي المحاولة في المنزل أيضًا
.وإلاّ فلن أستطيع التّحسّن

257
00:17:09,200 --> 00:17:10,890
.ذلك ليس صحيحًا

258
00:17:10,890 --> 00:17:13,630
.إنّك تستعيدين قدرتك على الحركة تدريجيًّا

259
00:17:13,630 --> 00:17:16,300
!لن يتمّ أيّ شيء على هذا المعدّل

260
00:17:18,020 --> 00:17:20,650
.أعلم كم أنّكنّ تبذلن كلّ جهدكنّ

261
00:17:21,130 --> 00:17:23,450
.عليّ القيام بما أستطيع القيام به

262
00:17:24,220 --> 00:17:28,270
.أنا الوحيدة الّتي لا تفعل أيّ شيء

263
00:17:28,670 --> 00:17:30,440
!ذلك ليس صحيحًا

264
00:17:30,440 --> 00:17:31,910
.بل صحيح

265
00:17:32,330 --> 00:17:34,660
.لم أشجّع أيّ أحد

266
00:17:34,660 --> 00:17:35,700
!قلتُ لك ذلك ليس صحيحًا

267
00:17:36,040 --> 00:17:38,820
إنّنا قادرات على المواصلة فقط
.لأنّك معنا يا ميغو

268
00:17:38,820 --> 00:17:41,650
حتّى أنّنا فزنا بالمنافسات الوطنيّة
!معًا في الإعداديّة

269
00:17:41,650 --> 00:17:43,790
!وأنا لم أكن هناك

270
00:17:43,790 --> 00:17:45,710
!كنتُ طريحة الفراش في المشفى

271
00:18:23,890 --> 00:18:25,350
.سأغادر

272
00:18:50,610 --> 00:18:51,900
أعتقد أنّنا نُبلي حسنًا، صحيح؟

273
00:18:51,900 --> 00:18:54,830
.إنّ تقليل طلباتنا كان قرارًا صائبًا

274
00:18:57,120 --> 00:18:58,990
.لم نقم بالرّفع مؤخّرًا

275
00:18:58,990 --> 00:19:01,570
.لم أتحقّق مؤخّرًا من القناة حتّى

276
00:19:01,570 --> 00:19:02,860
فعلاً؟

277
00:19:02,860 --> 00:19:04,730
.لم يكن لدينا أيّ وقت

278
00:19:04,730 --> 00:19:07,330
ذلك واضح، لكنّي ما زلت أشعر
.بالسّوء حيال مشاهدينا

279
00:19:07,840 --> 00:19:10,700
!لكن يمكنني إلقاء نظرة أخيرًا

280
00:19:11,850 --> 00:19:14,760
.كانت حركاتك الأخيرة متصلّبة يا كاناتا

281
00:19:14,760 --> 00:19:16,370
.كنت لا بأس بك

282
00:19:16,370 --> 00:19:18,030
.كما أنّك نزلت بشكل جيّد

283
00:19:18,030 --> 00:19:19,260
صحيح يا ميغومي-تشان؟

284
00:19:23,340 --> 00:19:27,380
هل أتخيّل أم أنّ كاناتا-تشان
وميغومي-تشان ليستا على وفاق اليوم؟

285
00:19:27,380 --> 00:19:29,800
.إنّهما على هذه الحالة منذ مدّة الآن

286
00:19:35,460 --> 00:19:36,670
وحدها؟

287
00:19:42,530 --> 00:19:45,490
!لماذا نتعرّض للهجوم؟

288
00:19:57,210 --> 00:19:59,200
لماذا يحدث هذا؟

289
00:19:59,200 --> 00:20:00,830
...إنّنا نعمل بجدّ

290
00:20:02,820 --> 00:20:04,640
كاناتا-تشان، هل أنت بخير؟

291
00:20:05,080 --> 00:20:07,740
!كانوا إيجابيّين كثيرًا حتّى وقت ليس ببعيد

292
00:20:07,740 --> 00:20:08,560
!هذا هو السّبب

293
00:20:09,340 --> 00:20:11,010
،لا يمكنك الطّيران وأنت في النّادي"

294
00:20:11,010 --> 00:20:14,100
"لكن لا مشكلة لديك بالطّيران لأجل المرح؟

295
00:20:14,510 --> 00:20:16,580
كيف يعرفون بشأن نادي مدرستنا؟

296
00:20:18,170 --> 00:20:19,320
...مهلاً

297
00:20:20,510 --> 00:20:21,550
نادي التّشجيع؟

298
00:20:22,420 --> 00:20:24,420
!ما كانت أيّ واحدة منهنّ لتقوم بهذا

299
00:20:28,130 --> 00:20:31,320
ليس مسموحًا لنا بامتلاك وسائل
...تواصل اجتماعيّ

300
00:20:39,050 --> 00:20:40,380
.لنتدرّب

301
00:20:40,850 --> 00:20:43,590
.إنّ النّاس ينتظرون دعمنا لهم

302
00:20:53,470 --> 00:20:54,700
.كاناتا-تشان

303
00:20:56,150 --> 00:20:58,160
أتريدين النّزول يا كاناتا-تشان؟

304
00:21:02,980 --> 00:21:04,300
.لا

305
00:21:04,300 --> 00:21:06,680
.عليك أخذ أسبوع للرّاحة

306
00:21:06,680 --> 00:21:07,370
!كلاّ

307
00:21:07,370 --> 00:21:08,940
!علينا القيام بأمور غدًا أيضًا

308
00:21:08,940 --> 00:21:10,330
.غدًا؟ أظنّك مخطئة

309
00:21:12,130 --> 00:21:13,290
.لا تهتممن بذلك

310
00:21:15,660 --> 00:21:17,390
هل كنت تذهبين وحدك؟

311
00:21:17,390 --> 00:21:20,240
هل كنت تذهبين للتّشجيع والاعتذار؟

312
00:21:23,900 --> 00:21:25,590
.لا عجب أنّ الجميع غاضب

313
00:21:27,540 --> 00:21:29,730
لماذا قمتِ بذلك بدون علمنا؟

314
00:21:29,730 --> 00:21:32,090
.لم نرد أن نرفض طلباتهم نحن أيضًا

315
00:21:32,090 --> 00:21:35,770
هذا ما قرّرنا فعله حتّى نتمكّن من
.تشجيع أكبر عدد ممكن من النّاس

316
00:21:36,380 --> 00:21:40,220
لا معنى لمحاولة التّشجيع
.عندما نكون مشتّتات للغاية هكذا

317
00:21:41,990 --> 00:21:43,360
.هذا كلّ شيء لليوم

318
00:21:43,360 --> 00:21:46,610
.مهلاً، لنستمع لما كانت تفكّر به كاناتا-تشان

319
00:21:46,610 --> 00:21:48,710
.فكّرتْ في الأمر، وهذا كان هو جوابها

320
00:21:50,050 --> 00:21:50,950
...ميغومي-تشان