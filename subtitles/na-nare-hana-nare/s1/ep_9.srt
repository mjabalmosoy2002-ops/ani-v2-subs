1
00:00:00,670 --> 00:00:03,600
.مهلاً، لنستمع لما كانت تفكّر به كاناتا-تشان

2
00:00:03,600 --> 00:00:05,560
.فكّرتْ في الأمر، وهذا كان هو جوابها

3
00:00:07,110 --> 00:00:08,070
...ميغومي-تشان

4
00:00:12,940 --> 00:00:13,880
.سأغادر

5
00:00:18,540 --> 00:00:21,040
.علينا إنهاء تدريب اليوم

6
00:00:23,370 --> 00:00:25,750
.سأتولّى أمر ذلك يا ميغومي-تشان

7
00:00:26,770 --> 00:00:28,680
.لا بأس

8
00:00:28,680 --> 00:00:30,480
هل أحمل هذين؟

9
00:00:30,110 --> 00:00:31,450
.لنغيّر ملابسنا

10
00:00:30,480 --> 00:00:32,660
.نعم، أنا آسفة

11
00:00:33,110 --> 00:00:34,920
هل تحتاجين مساعدة للوقوف؟

12
00:00:35,340 --> 00:00:36,680
.شكرًا لك

13
00:00:43,010 --> 00:00:45,580
.الجميع متعبات فحسب

14
00:00:49,050 --> 00:00:51,790
.عليك أن ترتاحي أيضًا يا كاناتا-تشان

15
00:01:00,870 --> 00:01:02,020
!كاناتا-تشان

16
00:01:11,400 --> 00:01:13,080
...ميغومي-تشان

17
00:02:00,850 --> 00:02:02,740
.ليس منهنّ

18
00:02:03,830 --> 00:02:06,860
.من المخيف جدًّا أنّ لا أحد منهنّ يتكلّم

19
00:02:09,290 --> 00:02:12,590
...اتّفقنا سلفًا أن نتدرّب كلّ يوم

20
00:02:12,590 --> 00:02:14,600
.لكنّي لا أدري إن كنّ سيحضرن

21
00:04:10,430 --> 00:04:12,750
.حلّ الصّباح

22
00:04:16,410 --> 00:04:18,100
.صباح الخير

23
00:04:18,100 --> 00:04:22,650
ماذا؟ استيقظت بدون مساعدة أنّا-تشان؟

24
00:04:22,650 --> 00:04:24,620
...نعم

25
00:04:27,790 --> 00:04:30,890
.لا أعتقد أنّ أنّا-تشان قادمة اليوم

26
00:04:30,890 --> 00:04:33,350
لديكنّ تدريب اليوم، صحيح؟

27
00:04:34,090 --> 00:04:36,760
.نعم... على ما أظنّ

28
00:04:45,470 --> 00:04:47,370
.سأغادر

29
00:04:48,330 --> 00:04:52,470
—نعم. مع السّلا

30
00:05:05,100 --> 00:05:06,360
.أنّا-تشان

31
00:05:09,420 --> 00:05:11,120
...الموسيقى

32
00:05:13,180 --> 00:05:14,180
ماذا؟

33
00:05:14,180 --> 00:05:17,900
...آسفة، لم تسمعيني وأنا أناديك، لذا

34
00:05:17,900 --> 00:05:19,000
.لا تهتمّي

35
00:05:19,420 --> 00:05:21,150
هل تؤلّفين الموسيقى؟

36
00:05:21,150 --> 00:05:24,090
.أنا أقوم بتوزيع ما ألّفته شيون

37
00:05:24,090 --> 00:05:25,800
.ظننتُ أنّك كنت غاضبة

38
00:05:25,800 --> 00:05:27,290
.أنا غاضبة بالفعل

39
00:05:27,290 --> 00:05:28,090
.على كاناتا

40
00:05:28,860 --> 00:05:30,510
!نحن عائلة

41
00:05:30,510 --> 00:05:32,760
...ومع ذلك لا أصدّق أنّها قامت بـ

42
00:05:32,760 --> 00:05:34,440
.ذهبت للتّشجيع وحدها

43
00:05:34,440 --> 00:05:35,930
لماذا فعلت ذلك؟

44
00:05:37,890 --> 00:05:41,470
لكنّ ذلك لا يجعل من الصّواب
.ترك تشجيع بومبومز

45
00:05:41,470 --> 00:05:43,310
...بشأن تدريب اليوم

46
00:05:43,310 --> 00:05:44,940
.سأذهب إن انتهيت في الوقت المناسب

47
00:05:46,280 --> 00:05:48,540
.آسفة على المقاطعة

48
00:05:55,240 --> 00:05:56,860
.مرحبًا يا أوتاني

49
00:06:00,230 --> 00:06:02,460
!ر-رارا-سينباي؟

50
00:06:02,460 --> 00:06:03,920
!سررت بلقائك

51
00:06:04,430 --> 00:06:06,490
تتدرّبين على عروضك الأنيقة؟

52
00:06:06,490 --> 00:06:08,180
...نعم، على ما أظنّ

53
00:06:10,970 --> 00:06:12,540
.السّماء غائمة

54
00:06:15,680 --> 00:06:17,020
.مفهوم

55
00:06:17,020 --> 00:06:19,400
.ما كنت لأتوقّع ذلك

56
00:06:19,960 --> 00:06:23,320
.لا أشعر برغبة في الذّهاب للتّدريب

57
00:06:23,740 --> 00:06:27,310
من الصّعب رؤيتهنّ جميعًا
.يبذلن كلّ ما بوسعهنّ

58
00:06:27,310 --> 00:06:30,620
ولهذا السّبب توقّفت عن المشاركة
.مع لجنة التّشجيع

59
00:06:30,620 --> 00:06:32,280
...أنا

60
00:06:32,280 --> 00:06:34,690
.إنّك لطيفة جدًّا ببساطة

61
00:06:34,690 --> 00:06:38,450
تواجهين كلّ شيء مباشرة
.وتحاولين تخفيف أيّ ضائقة

62
00:06:38,450 --> 00:06:40,000
.بالطّبع سيزداد الأمر صعوبة عليك

63
00:06:40,890 --> 00:06:43,630
.لكنّ هذه هي طبيعة التّشجيع

64
00:06:43,930 --> 00:06:45,920
.مواجهة دائمة

65
00:06:45,920 --> 00:06:47,660
.بل وأحيانًا تتعارض الرّؤوس معًا

66
00:06:47,660 --> 00:06:50,840
.ونعبّر عن أفكارنا من أعماق قلوبنا

67
00:06:51,400 --> 00:06:52,430
...لكن

68
00:06:52,430 --> 00:06:54,750
فكّري في الوقت الّذي دعمتنا فيه
.في تلك المباراة قبل أيّام

69
00:06:56,970 --> 00:07:00,650
.كشفت عن نفسك وعبّرت عنها بكلّ صدق

70
00:07:00,650 --> 00:07:03,940
.ما زال تشجيعك يثلج صدري

71
00:07:03,940 --> 00:07:06,300
.شـ-شكرًا لك

72
00:07:06,300 --> 00:07:09,140
!أنا فخورة بك يا لبوة مايتاكا الرّاقدة

73
00:07:10,290 --> 00:07:12,220
.أنا أحبّ التّشجيع

74
00:07:12,220 --> 00:07:14,290
،ما دام هنالك شخص يتحدّى شيئًا ما

75
00:07:14,290 --> 00:07:16,580
.فأنا مستعدّة لمواصلة التّشجيع

76
00:07:19,060 --> 00:07:21,580
،إن كان هنالك أمر تتمنّين تحقيقه

77
00:07:21,580 --> 00:07:24,170
.أتمنّى تكريس كلّ كياني لدعمه

78
00:07:27,840 --> 00:07:29,610
!سـ-سينباي

79
00:07:29,610 --> 00:07:38,220
!هيّا، هيّا يا أوتاني

80
00:07:31,510 --> 00:07:33,240
...توقّفي! إنّ النّاس

81
00:07:34,110 --> 00:07:35,310
!الحارس ينظر إلينا

82
00:07:36,010 --> 00:07:37,830
!أخفضي صوتك

83
00:07:41,960 --> 00:07:43,800
...حصلتُ على هديّة

84
00:07:48,840 --> 00:07:50,030
!سوزوها-تشان؟

85
00:07:53,570 --> 00:07:55,080
...لا

86
00:07:55,080 --> 00:07:57,410
وابي... نهيلد؟

87
00:08:12,330 --> 00:08:14,290
.طاب يومك يا تانيزاكي-سان

88
00:08:14,290 --> 00:08:15,590
.طاب يومك

89
00:08:18,680 --> 00:08:20,570
ماذا هنالك يا نودوكا-تشان؟

90
00:08:20,570 --> 00:08:21,490
...أنا

91
00:08:21,490 --> 00:08:23,760
.كنتُ أتساءل إن كنّا سنذهب للتّدريب اليوم

92
00:08:23,760 --> 00:08:25,690
.كنتُ أنوي الذّهاب

93
00:08:27,990 --> 00:08:29,190
ماذا عن سوزوها-تشان؟

94
00:08:29,640 --> 00:08:32,370
.لم أرها منذ أن غادرنا البارحة

95
00:08:32,370 --> 00:08:33,990
...بالطّبع

96
00:08:34,530 --> 00:08:36,950
.قالت أنّا-تشان أنّها ستأتي إن كان لديها وقت

97
00:08:40,360 --> 00:08:41,500
.مانجو مخبوز

98
00:08:41,500 --> 00:08:42,680
أواثقة؟

99
00:08:42,680 --> 00:08:45,070
.نعم. إنّها هديّة

100
00:08:45,070 --> 00:08:46,220
.شكرًا

101
00:08:50,510 --> 00:08:51,310
.فاصولياء حمراء

102
00:08:51,310 --> 00:08:53,420
.تحبّ رارا-سينباي الحلويّات

103
00:08:53,420 --> 00:08:56,060
.إنّها لا تشتري إلاّ الفاصولياء الحمراء

104
00:08:56,060 --> 00:08:57,800
أذهبتِ إلى اللّجنة؟

105
00:08:58,210 --> 00:08:59,180
...لا

106
00:09:00,840 --> 00:09:04,970
كنتُ أحاول أن أقرّر إن كان
...عليّ الذّهاب للتّدريب، لذلك

107
00:09:10,270 --> 00:09:12,580
.ثمّ بدأتْ بتشجيعي بصوت مرتفع

108
00:09:12,580 --> 00:09:14,320
.كنّا نجلب الأنظار إلينا

109
00:09:14,320 --> 00:09:16,120
.شعرتُ بإحراج شديد

110
00:09:18,200 --> 00:09:22,300
.لكنّها أثنت على تشجيعنا آخر مرّة

111
00:09:22,300 --> 00:09:23,660
.أشعرني ذلك بتحسّن كبير

112
00:09:24,450 --> 00:09:25,700
.حمدًا على هذا

113
00:09:27,590 --> 00:09:32,880
لم أذهب إلى اللّجنة، لكنّي مسرورة
.لأنّ بإمكاني المشاركة في بومبومز

114
00:09:33,460 --> 00:09:34,690
.وأنا كذلك

115
00:09:34,690 --> 00:09:36,260
وأنت كذلك؟

116
00:09:36,870 --> 00:09:41,850
لم أتوقّع القيام بالتّشجيع، بل تأليف
...الموسيقى والكلمات وما شابه

117
00:09:42,410 --> 00:09:45,420
.هكذا إذًا. مغنّية ومؤلّفة أغانٍ

118
00:09:45,420 --> 00:09:49,150
.أخبرتكنّ عن حلمي وقبلتنّ به

119
00:09:50,300 --> 00:09:52,730
.أريد لبومبومز أن تستمرّ

120
00:09:53,460 --> 00:09:56,950
كيف وصلت الأمور لهذا الوضع السّيّئ؟

121
00:09:57,560 --> 00:10:00,280
.حتّى أنّ أنّا-تشان عادت لسابق عهدها

122
00:10:00,770 --> 00:10:04,580
لم أرَ ميغومي-تشان على تلك
.الحالة من قبل أيضًا

123
00:10:04,970 --> 00:10:07,530
منذ متى وأنتما صديقتين؟

124
00:10:07,530 --> 00:10:08,790
.منذ السّنة الثّالثة من الإعداديّة

125
00:10:09,400 --> 00:10:11,790
.رأيتها أثناء العلاج الطّبيعيّ

126
00:10:12,220 --> 00:10:14,420
...كانت تبذل الكثير من الجهد

127
00:10:14,830 --> 00:10:18,760
.لذلك بدأت أرافقها من وإلى العلاج الطّبيعيّ

128
00:10:18,760 --> 00:10:21,500
.أخبرتني بوعدها مع كاناتا-تشان

129
00:10:22,680 --> 00:10:24,130
وعدها؟

130
00:10:24,130 --> 00:10:24,980
.نعم

131
00:10:24,980 --> 00:10:28,220
وعدت بالفوز في منافسات التّشجيع
.الوطنيّة في الثّانويّة ثانية

132
00:10:28,220 --> 00:10:30,040
.لم أكن أعلم

133
00:10:30,040 --> 00:10:33,360
.لذلك لطالما أردتُ لقاء كاناتا-تشان

134
00:10:33,830 --> 00:10:34,900
ما كان رأيك؟

135
00:10:35,570 --> 00:10:37,150
.إنّها ما تتوقّعينه من كاناتا-تشان

136
00:10:39,140 --> 00:10:43,070
.احترما ودعما بعضهما البعض

137
00:10:43,070 --> 00:10:45,580
.إنّه أمر جميل بالفعل

138
00:10:46,170 --> 00:10:51,850
لذلك يبدو من الغريب ألاّ تكون
.كاناتا-تشان وميغومي-تشان على وفاق

139
00:11:14,560 --> 00:11:16,060
!المعذرة

140
00:11:16,060 --> 00:11:18,030
!مرحبًا

141
00:11:18,590 --> 00:11:19,740
.أتيتما

142
00:11:19,740 --> 00:11:21,790
.نعم. لدينا تدريب

143
00:11:23,430 --> 00:11:25,450
.قد لا ترغبان في ذلك

144
00:11:28,500 --> 00:11:29,710
هل من خطب ما؟

145
00:11:31,820 --> 00:11:35,630
.لا أعتقد أنّ كاناتا ستأتي بعد الآن

146
00:11:36,550 --> 00:11:37,390
لماذا؟

147
00:11:37,390 --> 00:11:38,590
ماذا حدث؟

148
00:11:40,970 --> 00:11:43,680
.انفجرتُ غضبًا على كاناتا

149
00:11:44,750 --> 00:11:45,950
أنت يا ميغومي-تشان؟

150
00:11:45,950 --> 00:11:46,930
لماذا؟

151
00:11:47,910 --> 00:11:53,190
،لا أستطيع الحركة كما أريد
.مهما حاولتُ بجدّ

152
00:11:53,780 --> 00:11:57,670
تحصل كاناتا على الكثير من الثّناء
.والامتنان على كلّ شيء تفعله

153
00:11:58,770 --> 00:12:05,690
شعرتُ أنّ كاناتا أخذت كلّ شيء رغبتُ
.فيه عندما فزنا بالمنافسات الوطنيّة

154
00:12:06,900 --> 00:12:09,430
.استطاعت كاناتا دخول تاكانوساكي

155
00:12:09,430 --> 00:12:11,100
.وانضمّت إلى نادي التّشجيع

156
00:12:11,860 --> 00:12:15,130
.بينما أنا لم أستطع حتّى الالتحاق بالثّانويّة

157
00:12:16,110 --> 00:12:18,960
أنا فعلاً ممتنّة لها لتحقيقها أمنيتي

158
00:12:18,960 --> 00:12:22,810
.بالفوز بالمنافسات الوطنيّة في الإعداديّة

159
00:12:24,020 --> 00:12:28,080
لكنّي أتساءل أحيانًا لماذا عليّ
.أنا فقط المرور بكلّ هذا

160
00:12:30,910 --> 00:12:33,320
تذكران ذلك التّعليق؟

161
00:12:33,960 --> 00:12:35,980
.أعرف كيف يشعر ذلك الشّخص

162
00:12:37,490 --> 00:12:42,760
لا يسعني سوى التّساؤل إن كان أحد ما
.قد نشره بدلاً منّي لأنّه عرف كيف أشعر

163
00:12:43,660 --> 00:12:49,160
لا أعتقد أنّ كاناتا قد تريد لقاء
.شخص يفكّر بهذه الطّريقة

164
00:12:49,160 --> 00:12:50,480
...ذلك ليس صحيحًا

165
00:12:53,380 --> 00:12:59,420
لستُ أنتِ، لذلك لا يمكنني فهم
...وضعك بالكامل

166
00:13:10,370 --> 00:13:15,920
لكنّي أعتقد أنّنا صرنا أقرب
.لبعضنا قليلاً لأنّك أخبرتنا

167
00:13:16,680 --> 00:13:19,040
.سأكون إلى جانبك يا ميغومي-تشان

168
00:13:21,100 --> 00:13:22,230
.وأنا أيضًا

169
00:13:57,880 --> 00:13:59,210
.وابيسكي

170
00:14:07,980 --> 00:14:09,160
.توقّعت أن أجدك هنا

171
00:14:09,810 --> 00:14:14,700
استطعتِ تنفيذ قفزة دورانيّة أماميّة وشقلبة
.وتمدّد مستقيم مع لفّة كاملة في هذا المكان

172
00:14:14,700 --> 00:14:16,240
.تريدين تجربة ذلك ثانية

173
00:14:17,570 --> 00:14:18,450
كيف عرفت...؟

174
00:14:18,450 --> 00:14:19,800
.عرفتُ فحسب

175
00:14:21,410 --> 00:14:23,150
.لا يجب أن تضغطي على نفسك

176
00:14:23,150 --> 00:14:25,590
لن تصيري قادرة على الطّيران بالفعل
.إن تعرّضت لإصابة

177
00:14:30,150 --> 00:14:32,280
.يمكنك أن تبدئي ثانية في وقت آخر

178
00:14:32,280 --> 00:14:33,820
.سأخرج معك إن كان لديك وقت

179
00:15:33,270 --> 00:15:34,210
مرحبًا؟

180
00:15:34,210 --> 00:15:35,550
!حمدًا على هذا

181
00:15:35,550 --> 00:15:41,350
،اتّصلتُ بنودوكا-تشان والأخريات
.لكنّك لم تردّي وانشغل بالي عليك

182
00:15:41,810 --> 00:15:43,170
...ذلك

183
00:15:43,170 --> 00:15:44,380
هل من خطب؟

184
00:15:44,670 --> 00:15:47,900
.كاناتا-تشان في المستشفى

185
00:15:48,920 --> 00:15:51,090
.لم تستعد وعيها بعد

186
00:15:51,540 --> 00:15:52,660
لماذا؟

187
00:15:52,660 --> 00:15:55,450
.تأذّت عند دانغوزاكا

188
00:16:19,620 --> 00:16:20,450
!أين كاناتا؟

189
00:16:20,780 --> 00:16:22,050
.في قسم الطّوارئ

190
00:16:22,050 --> 00:16:22,910
.من هنا

191
00:16:34,380 --> 00:16:35,390
!يا إلهي

192
00:16:35,710 --> 00:16:37,790
!لقد أقلقتني كثيرًا

193
00:16:38,200 --> 00:16:39,420
.نعم

194
00:16:39,420 --> 00:16:42,390
.سأذهب للحديث مع الأطبّاء

195
00:16:43,150 --> 00:16:44,120
...نعم

196
00:17:09,690 --> 00:17:10,680
!ميغو

197
00:17:13,590 --> 00:17:14,550
!أنا آسفة

198
00:17:15,560 --> 00:17:17,090
عـ-علام؟

199
00:17:17,380 --> 00:17:18,840
.كنتُ أتظاهر أنّي لم أرَ شيئًا

200
00:17:18,840 --> 00:17:20,510
رأيت ماذا؟

201
00:17:20,510 --> 00:17:22,180
.عرفتُ أنّك تعانين

202
00:17:22,460 --> 00:17:23,530
لقد قفزت، صحيح؟

203
00:17:23,530 --> 00:17:26,020
.حاولت الطّيران من أجل وعدنا

204
00:17:26,020 --> 00:17:27,530
!لم أفعل

205
00:17:27,530 --> 00:17:29,890
.وقع وابيسكي من السّماء

206
00:17:29,890 --> 00:17:31,440
.لقد فاجأني

207
00:17:31,440 --> 00:17:33,020
!توقّفي، لا تجيدين الكذب أبدًا

208
00:17:33,020 --> 00:17:35,500
!لا أكذب! كما أنّني بارعة فيه

209
00:17:35,500 --> 00:17:36,120
!لقد تأذّيتِ

210
00:17:36,120 --> 00:17:37,220
!إنّه مجرّد تورّم

211
00:17:37,220 --> 00:17:38,990
!لستِ بحاجة لإجبار نفسك على القفز

212
00:17:38,990 --> 00:17:40,290
!أنا لا أجبر نفسي

213
00:17:40,290 --> 00:17:41,800
!سأتمكّن من الطّيران قريبًا

214
00:17:41,800 --> 00:17:43,130
!كوني صريحة مع نفسك

215
00:17:43,130 --> 00:17:44,210
—كيف يمكنني

216
00:17:44,210 --> 00:17:45,220
!كاناتا

217
00:17:51,090 --> 00:17:53,250
.أنا بخير

218
00:17:53,250 --> 00:17:55,770
.بإمكانك التّوقّف عن تلك الابتسامة الزّائفة

219
00:17:56,860 --> 00:17:58,180
.يمكنك البكاء

220
00:17:58,180 --> 00:18:00,530
.يمكنك الكذب أيضًا إن أردت

221
00:18:00,530 --> 00:18:04,010
!لكن أخبريني أنا بالحقيقة على الأقلّ

222
00:18:04,010 --> 00:18:05,710
!لن أهرب بعد الآن

223
00:18:05,710 --> 00:18:08,520
!سأقبل بأيّ شيء فيك

224
00:18:09,650 --> 00:18:14,610
طِرتِ من أجلي في منافسات المدارس
الإعداديّة الوطنيّة، صحيح؟

225
00:18:14,610 --> 00:18:15,490
...لكن

226
00:18:27,040 --> 00:18:32,130
حتّى عندما ألمسك، لا أدري

227
00:18:33,010 --> 00:18:37,230
كلّ ما تفعلينه هو الابتسام

228
00:18:37,230 --> 00:18:40,480
...هل يمكنني التّقرّب إليك يومًا

229
00:18:39,150 --> 00:18:40,050
...ميغو

230
00:18:40,480 --> 00:18:45,520
عندما تعانين وحدك تمامًا؟

231
00:18:46,220 --> 00:18:50,480
خطّ النّهاية الرّائع، النّور الّذي نراه معًا

232
00:18:50,820 --> 00:18:56,800
...ألوان المجد والتّألّق، سماء لأجلك فقط

233
00:19:03,320 --> 00:19:05,070
أين كاناتا؟ أهي في المستشفى؟

234
00:19:05,070 --> 00:19:06,980
هل تأذّت؟ هل هي بخير؟

235
00:19:06,980 --> 00:19:07,790
.نعم

236
00:19:07,790 --> 00:19:10,750
.إنّها تتحدّث مع ميغومي-تشان الآن

237
00:19:11,450 --> 00:19:18,630
...تمنحينني الشّجاعة

238
00:19:19,650 --> 00:19:33,600
...والآن حان دوري لأشجّعك

239
00:19:47,700 --> 00:19:48,880
!ماذا؟

240
00:19:48,880 --> 00:19:49,830
...إنّ ميغو

241
00:19:52,270 --> 00:19:54,550
...تشجيعي

242
00:20:02,000 --> 00:20:04,970
!لنفسي

243
00:20:19,210 --> 00:20:20,440
...كاناتا

244
00:20:22,130 --> 00:20:22,940
...ميغو

245
00:20:30,630 --> 00:20:31,610
أيمكن الوقوف؟

246
00:20:36,500 --> 00:20:38,210
!ميغو! كاناتا

247
00:20:39,340 --> 00:20:43,530
!كفّا عن التّصرّف بتهوّر كلاكما

248
00:20:51,310 --> 00:20:54,120
.آسفة على كلّ المشاكل الّتي تسبّبت بها

249
00:21:03,900 --> 00:21:05,980
.أريد ممارسة التّشجيع

250
00:21:05,980 --> 00:21:11,750
إنّ وجود شخص واحد فقط
.لأشجّعه بإمكانه أن يجعلني قويّة

251
00:21:12,670 --> 00:21:17,210
.لذلك أريد التّشجيع ثانية مع بومبومز

252
00:21:22,570 --> 00:21:23,790
متى يمكننا أن نبدأ؟

253
00:21:27,640 --> 00:21:29,460
.الموسيقى جاهزة

254
00:21:29,460 --> 00:21:31,900
.سهرت اللّيل بطوله تعمل عليها

255
00:21:31,900 --> 00:21:33,240
ماذا عنك يا سوزو-تشان؟

256
00:21:33,240 --> 00:21:35,220
.أظنّ أنّ الأمر يعتمد على اجتماعات ناديك

257
00:21:38,070 --> 00:21:40,190
لماذا لا نتدرّب؟

258
00:21:40,760 --> 00:21:41,720
!نعم

259
00:23:18,580 --> 00:23:20,340
هل ستنسحبين بالفعل؟