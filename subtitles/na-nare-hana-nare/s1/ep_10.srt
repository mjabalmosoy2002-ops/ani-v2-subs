1
00:00:05,300 --> 00:00:07,390
.توقّف المطر

2
00:00:07,390 --> 00:00:08,090
.نعم

3
00:00:08,860 --> 00:00:11,140
.أحبّ الهواء بعد تساقط الأمطار

4
00:00:18,370 --> 00:00:23,370
بالتّفكير في الأمر، لطالما
.كانت ميغومي-تشان قويّة

5
00:00:25,030 --> 00:00:27,130
.أريد أن أصير أقوى أيضًا

6
00:00:28,250 --> 00:00:30,630
.أريد أن أكون ذات عون لأحد ما

7
00:00:34,150 --> 00:00:36,590
لأحد ما؟ ومن يكون؟

8
00:00:38,350 --> 00:00:40,810
.الجميع على ما أظنّ

9
00:00:45,770 --> 00:00:46,650
.أنا أيضًا

10
00:00:48,550 --> 00:00:49,660
.لا تهتمّي

11
00:00:53,510 --> 00:00:54,420
.أراك غدًا

12
00:00:56,930 --> 00:00:58,720
!نعم. إلى اللّقاء غدًا

13
00:01:07,420 --> 00:01:11,790
.مذاق الطّعام ألذّ عند أكله مع الآخرين

14
00:01:11,790 --> 00:01:13,510
.أوافقك

15
00:01:16,970 --> 00:01:18,190
...اسمعن

16
00:01:18,190 --> 00:01:20,110
أتردن التّوقّف عن تصوير الفيديوهات؟

17
00:01:22,330 --> 00:01:24,310
...فعلاً؟ لكنّنا جميعًا قد

18
00:01:24,620 --> 00:01:27,740
...حسنًا، كلّ ما في الأمر

19
00:01:27,740 --> 00:01:31,100
.أنّي أفهم دافع كاناتا

20
00:01:32,100 --> 00:01:38,360
،كان من الممتع أن نكون مشغولات
.لكن أريد أن يكون لتشجيعنا أهمّيّة أكبر

21
00:01:39,900 --> 00:01:41,700
.نجح تشجيع ميغومي

22
00:01:43,820 --> 00:01:45,410
.قد تكونين على حقّ

23
00:01:48,690 --> 00:01:50,000
!حسنًا إذًا

24
00:01:50,000 --> 00:01:52,500
!لنقم بجميع الطّلبات المتبقّية

25
00:03:28,100 --> 00:03:31,830
!هيّا بنا! هيّا بنا! هيّا، هيّا! قتال! فوز

26
00:03:32,280 --> 00:03:33,650
.أجل، جميعكنّ معًا

27
00:03:33,650 --> 00:03:35,530
!مرحى

28
00:03:35,530 --> 00:03:37,480
!مهلاً، انظرن للوقت

29
00:03:37,480 --> 00:03:38,980
هل أنتنّ جاهزات؟

30
00:03:38,980 --> 00:03:40,880
.علينا الإسراع إلى المحطّة

31
00:03:40,880 --> 00:03:43,280
.مهلاً، نسيت قنّينة مائك

32
00:03:43,280 --> 00:03:44,680
.هاتفك يا شي-تشان

33
00:03:44,680 --> 00:03:45,660
.شكرًا لك

34
00:03:45,660 --> 00:03:47,400
!لنذهب بسرعة

35
00:03:48,990 --> 00:03:52,440
!هيّا بنا! انطلاق! قتال! فوز

36
00:03:52,440 --> 00:03:55,570
!هيّا بنا، هيّا بنا! انطلق يا فريق ماستانغ

37
00:03:55,570 --> 00:04:00,300
!م-ا-س-ت-ا-ن-غ! انطلق يا فريق ماستانغ

38
00:04:00,300 --> 00:04:01,630
!انطلاق! قتال! فوز

39
00:04:15,880 --> 00:04:17,150
!شكرًا لكنّ

40
00:04:17,150 --> 00:04:20,820
لم أعلم أبدًا أنّ وجود من يشجّعنا شخصيًّا
.بإمكانه منحنا كلّ هذه الطّاقة

41
00:04:21,140 --> 00:04:22,610
!حمّسني ذلك كثيرًا بالفعل

42
00:04:22,610 --> 00:04:23,990
!شكرًا لكنّ

43
00:04:25,140 --> 00:04:26,280
.شكرًا لكنّ أيضًا

44
00:04:28,590 --> 00:04:32,040
!انطلق، انطلق يا فريق تونيغاوا

45
00:04:32,040 --> 00:04:33,680
!هيّا أيّها القادة

46
00:04:33,680 --> 00:04:38,560
!انطلق، انطلق يا فريق تونيغاوا

47
00:04:43,530 --> 00:04:44,630
!أيّهما الفائز؟

48
00:04:46,420 --> 00:04:47,790
...لا أدري

49
00:04:55,540 --> 00:04:58,780
!كانت صورة النّهاية تلك حماسيّة للغاية

50
00:04:58,780 --> 00:05:00,670
!كما أنّنا فزنا

51
00:05:00,670 --> 00:05:03,510
نودوكا-تشان، ألست قلقة حيال صوتك غدًا؟

52
00:05:03,990 --> 00:05:05,780
.كنتِ تصرخين بشدّة

53
00:05:05,780 --> 00:05:08,900
.أعتقد أنّ اليوغا خاصّتي قد تساعد في ذلك

54
00:05:08,900 --> 00:05:11,100
.التّنفّس الباطنيّ

55
00:05:11,100 --> 00:05:12,700
.ذلك منطقيّ

56
00:05:17,000 --> 00:05:20,540
!بومبومز

57
00:05:25,780 --> 00:05:29,990
!بومبومز

58
00:05:32,590 --> 00:05:33,800
.يا إلهي

59
00:05:33,800 --> 00:05:36,330
.ستضرّان صوتيكما بقيامكما بذلك

60
00:05:36,910 --> 00:05:39,940
.عليكما الانتباه إلى بطنيكما

61
00:05:43,130 --> 00:05:47,820
!بومبومز

62
00:05:45,980 --> 00:05:47,420
.إنّهنّ صاخبات

63
00:05:52,470 --> 00:05:54,350
.يبدو هذا من شيم بومبومز

64
00:05:56,390 --> 00:05:58,870
.ننظر جميعًا إلى نفس الاتّجاه

65
00:05:59,160 --> 00:06:00,430
.معك حقّ

66
00:06:00,430 --> 00:06:02,720
.مثل روبّونغيزاكا إيتشومي

67
00:06:03,470 --> 00:06:05,960
سنذهب جميعًا إلى البحر
.معًا في نهاية الأسبوع هذه

68
00:06:06,550 --> 00:06:08,500
!لا أطيق الانتظار

69
00:06:08,500 --> 00:06:10,450
.ليس لدينا بحر في محافظتنا

70
00:06:10,450 --> 00:06:12,490
!أنا أحبّ البحر

71
00:06:12,490 --> 00:06:14,880
.تعيش أفو في مدينة ميناء

72
00:06:14,880 --> 00:06:15,810
أبو؟

73
00:06:15,810 --> 00:06:16,930
أتلك كلمة برتغاليّة؟

74
00:06:17,230 --> 00:06:19,390
.أفو تعني جدّتي

75
00:06:19,390 --> 00:06:20,970
.وأفُوْ تعني جدّي

76
00:06:20,970 --> 00:06:22,360
.خبير صيد

77
00:06:22,870 --> 00:06:25,330
.لم أذهب إلى البحر منذ مجيئي إلى اليابان

78
00:06:25,330 --> 00:06:27,320
.ستكون أوّل مرّة منذ وقت طويل إذًا

79
00:06:27,730 --> 00:06:28,820
!ستّ سنوات

80
00:06:29,240 --> 00:06:31,300
هل سيكون لدينا وقت للسّباحة؟

81
00:06:31,300 --> 00:06:32,420
.على الأرجح لا

82
00:06:32,420 --> 00:06:34,790
.سنذهب لتوصيل التّشجيع

83
00:06:35,080 --> 00:06:36,840
...بالطّبع

84
00:06:42,820 --> 00:06:45,400
ماذا؟ لا فيديوهات؟

85
00:06:45,400 --> 00:06:47,410
.قدّمنا طلبنا لنظهر في فيديوهاتكنّ

86
00:06:47,410 --> 00:06:49,060
.ما عدنا نحتاج لخدماتكنّ إذًا

87
00:06:49,060 --> 00:06:50,180
لماذا لا تغادرن فحسب؟

88
00:06:54,560 --> 00:06:58,010
!هيّا! انطلقن يا فتيات الشّاطئ
!قاتلن! فزن

89
00:06:58,010 --> 00:07:01,400
!انطلقن يا فتيات الشّاطئ
!قاتلن! فزن

90
00:07:04,770 --> 00:07:06,690
!نجحنا

91
00:07:06,690 --> 00:07:08,860
!نجحنا بالفعل

92
00:07:10,070 --> 00:07:12,550
!شكرًا جزيلاً

93
00:08:16,280 --> 00:08:18,480
.لا تستطيع كاناتا الطّيران بعد

94
00:08:18,480 --> 00:08:20,570
على الأرجح أنّ علينا القيام
.برقصات بلا مجازفات

95
00:08:20,570 --> 00:08:22,520
مع المزيد من حركات الرّقص؟

96
00:08:22,520 --> 00:08:24,610
.نعم، أعتقد أنّ ذلك سيكون أفضل

97
00:08:24,610 --> 00:08:26,620
...الجوّ حارّ

98
00:08:26,620 --> 00:08:28,550
.علينا شرب الكثير من الماء

99
00:08:29,070 --> 00:08:31,150
.لديّ بعض الهدايا من داعمينا

100
00:08:31,150 --> 00:08:32,570
يوكان؟

101
00:08:32,570 --> 00:08:34,980
.مستحيل. إنّه الصّيف

102
00:08:34,980 --> 00:08:35,940
!ميزو يوكان

103
00:08:35,940 --> 00:08:38,090
.بل مثلّجات. إنّها في المجمّد

104
00:08:38,090 --> 00:08:39,240
!مرحى

105
00:08:39,240 --> 00:08:39,970
!نودوكا

106
00:08:39,970 --> 00:08:41,330
!أنّا-تشان

107
00:08:41,330 --> 00:08:44,250
ليس من اللاّئق فتح ثلاّجات
!الآخرين بدون طلب إذنهم

108
00:08:44,250 --> 00:08:47,790
سوزو-تشان، هل نجرّب الأمر مرّة أخرى؟

109
00:08:47,790 --> 00:08:48,550
.حسنًا

110
00:08:50,420 --> 00:08:58,990
،واحد، اثنان، ثلاثة، أربعة
...خمسة، ستّة، سبعة، ثمانية

111
00:08:56,050 --> 00:08:58,330
.شيون-تشان بارعة

112
00:08:58,330 --> 00:09:00,360
.إنّها جنّيّة نوماتا بالفعل

113
00:09:01,160 --> 00:09:02,510
...بربّك يا ميغومي-تشان

114
00:09:02,510 --> 00:09:04,970
.سبق وطلبتُ من ألاّ تناديني بذلك

115
00:09:06,620 --> 00:09:09,480
!المثلّجات! الوليمة لمن سبق

116
00:09:09,900 --> 00:09:11,940
.لا تتصرّفي كذلك يا أنّا-تشان

117
00:09:11,940 --> 00:09:13,490
ستتناول كاناتا نكهة الفراولة، صحيح؟

118
00:09:13,490 --> 00:09:14,350
!نعم

119
00:09:15,080 --> 00:09:16,880
!إنّها باردة

120
00:09:16,880 --> 00:09:18,900
!كم هذا منعش

121
00:09:18,900 --> 00:09:21,400
سوزو-تشان، أتريدين أنّ أفتحها لك؟

122
00:09:24,910 --> 00:09:26,330
!أهذا معقول؟

123
00:09:27,450 --> 00:09:30,100
.وبهذا تنتهي خدمة توصيل التّشجيع

124
00:09:30,100 --> 00:09:31,920
!نجحنا

125
00:09:31,920 --> 00:09:33,810
!أنجزناها كلّها

126
00:09:33,810 --> 00:09:35,800
.كما انتهت العطلة الصّيفيّة أيضًا

127
00:09:35,800 --> 00:09:38,900
!كان ذلك صيفًا كاملاً من توصيل التّشجيع

128
00:09:38,900 --> 00:09:40,240
.استمتعنا كثيرًا

129
00:09:40,240 --> 00:09:41,100
.نعم

130
00:09:41,100 --> 00:09:43,000
ما الّذي سنفعله الآن؟

131
00:09:46,970 --> 00:09:50,520
.أريد تعلّم المزيد عن تأليف الموسيقى

132
00:09:51,080 --> 00:09:52,190
!وأنا كذلك

133
00:09:52,190 --> 00:09:55,390
!إنّ واي جي يعلّمني بعض الأشياء الآن

134
00:09:55,390 --> 00:09:56,610
!مذهل

135
00:09:56,990 --> 00:10:00,900
.ظننتُ أنّ لديك منافسات جمباز يا شيون-تشان

136
00:10:00,900 --> 00:10:02,870
.يبدو من الصّعب مواكبة الأمرين معًا

137
00:10:03,150 --> 00:10:03,820
.نعم

138
00:10:04,230 --> 00:10:06,830
.لكنّي أريد القيام بالأمرين بالفعل

139
00:10:07,610 --> 00:10:09,370
!إلى النّادي

140
00:10:09,370 --> 00:10:11,120
.لم أكن أذهب على الإطلاق

141
00:10:11,120 --> 00:10:12,130
أتريدين مرافقتي يا نودوكا؟

142
00:10:12,130 --> 00:10:13,730
.لا أظنّني سأذهب

143
00:10:13,730 --> 00:10:15,460
.إنّني لا أجيد التّصرّف في مثل تلك الأماكن

144
00:10:15,460 --> 00:10:19,630
.في الحقيقة، أريد القيام بالمزيد من التّشجيع

145
00:10:20,590 --> 00:10:23,960
،أريد التّدرّب مع اللّجنة أكثر
...ومع بومبومز

146
00:10:23,960 --> 00:10:25,490
!نودوكا

147
00:10:25,490 --> 00:10:26,120
!أجل

148
00:10:26,120 --> 00:10:27,480
.توقّعتُ أن تقولي ذلك

149
00:10:27,780 --> 00:10:28,980
هل نتقابل كلّ يوم؟

150
00:10:28,980 --> 00:10:29,530
!نعم

151
00:10:29,530 --> 00:10:30,850
هل نقوم بهذا؟

152
00:10:31,140 --> 00:10:32,160
!حسنًا

153
00:10:32,690 --> 00:10:34,640
!اللّيلة هي ليلة الألعاب النّاريّة

154
00:10:44,170 --> 00:10:45,490
.طاب يومك

155
00:10:45,490 --> 00:10:47,540
.طاب يومك يا تانيزاكي-سان

156
00:10:47,540 --> 00:10:49,900
كيف قضيت صيفك؟

157
00:10:49,900 --> 00:10:52,200
.كنتُ مشغولة باجتماعات النّادي والتّشجيع

158
00:10:57,370 --> 00:10:58,280
.شي-تشان

159
00:10:58,280 --> 00:10:59,170
!شي-تشان؟

160
00:10:59,170 --> 00:11:01,260
.صباح الخير يا سوزو-تشان

161
00:11:01,260 --> 00:11:02,800
!سوزو-تشان؟

162
00:11:02,800 --> 00:11:03,850
.صباح الخير

163
00:11:09,020 --> 00:11:10,750
ما كان ذلك؟

164
00:11:10,750 --> 00:11:12,810
...هل قالت أوبوناي-سان

165
00:11:12,810 --> 00:11:14,520
!صباح الخير للتّوّ؟

166
00:11:18,360 --> 00:11:20,730
.نودوكا، سنذهب للمنزل

167
00:11:19,440 --> 00:11:21,780
...الأمر ليس أنّهنّ يكرهنك

168
00:11:22,190 --> 00:11:24,980
.آسفة، سألقاك لاحقًا

169
00:11:26,410 --> 00:11:27,700
.حسنًا

170
00:11:48,750 --> 00:11:52,810
!سعادة وابتسامات وحماسة وبأفضل حال

171
00:11:52,810 --> 00:11:54,940
!بأفضل حال

172
00:12:04,010 --> 00:12:05,990
.خذي شهيقًا آخر

173
00:12:07,950 --> 00:12:09,020
.والآن زفير

174
00:12:10,500 --> 00:12:13,490
.إنّك مسترخية أكثر من قبل

175
00:12:13,490 --> 00:12:15,220
كيف حال جسدك؟

176
00:12:15,630 --> 00:12:17,630
.ما زلت لا أستطيع الطّيران

177
00:12:17,960 --> 00:12:18,720
.حسنًا

178
00:12:18,720 --> 00:12:21,230
.لكنّي أريد القيام بما أستطيعه حاليًّا

179
00:12:21,780 --> 00:12:25,890
لم أستسلم بعد، لكن لا أعتقد
.أنّ عليّ أن أتعجّل أيضًا

180
00:12:26,190 --> 00:12:27,710
فعلاً؟

181
00:12:27,710 --> 00:12:29,850
.صارت تعابيرك أكثر ليونة الآن

182
00:12:31,000 --> 00:12:34,490
.يبدو أنّك مررت بنموّ عاطفيّ ما

183
00:12:36,190 --> 00:12:38,420
هل ننتقل إلى الخطوة التّالية؟

184
00:12:46,230 --> 00:12:47,900
.كاناتا، وقت الاستراحة

185
00:12:47,900 --> 00:12:48,940
.حسنًا

186
00:12:51,250 --> 00:12:53,220
.عليك أن تأخذي فترات استراحتك

187
00:12:55,780 --> 00:12:57,070
هذا ممتع، صحيح؟

188
00:12:58,330 --> 00:13:00,010
ما الّذي حملك على قول ذلك؟

189
00:13:00,010 --> 00:13:01,210
...تعلمين

190
00:13:01,540 --> 00:13:03,220
.لقد قمنا بتشجيعنا الصّباحيّ

191
00:13:03,710 --> 00:13:06,800
.ثمّ ذهبنا إلى مكان صديقات نودوكا-تشان

192
00:13:07,080 --> 00:13:08,260
.ثمّ إلى المستشفى

193
00:13:08,660 --> 00:13:11,130
.ودعتنا المدينة إلى حدثها أيضًا

194
00:13:15,460 --> 00:13:17,390
...الوتيرة بطيئة، ولكن

195
00:13:17,390 --> 00:13:18,200
.نعم

196
00:13:18,730 --> 00:13:21,870
.تشجيع بومبومز في انتشار مستمرّ

197
00:13:24,530 --> 00:13:25,680
...كنت أفكّر

198
00:13:26,600 --> 00:13:27,400
فيمَ؟

199
00:13:28,450 --> 00:13:32,490
،حتّى إن عجزت عن الطّيران
،وما عدت أستطيع العودة لنادي التّشجيع

200
00:13:32,970 --> 00:13:34,750
.فأنا أريد العثور على شيء يمكنني القيام به

201
00:13:35,800 --> 00:13:36,560
.نعم

202
00:13:37,820 --> 00:13:39,320
...إنّ تشجيعك يا ميغو

203
00:13:42,220 --> 00:13:43,450
.قد نجح

204
00:13:45,890 --> 00:13:48,200
.كان تشجيعًا يُرثى له

205
00:13:48,200 --> 00:13:49,390
.على الإطلاق

206
00:13:50,040 --> 00:13:53,540
.لقد كان التّشجيع الأكثر تأثيرًا فيّ

207
00:13:56,670 --> 00:13:57,890
فعلاً؟

208
00:13:58,910 --> 00:14:02,400
.سأفعل كلّ ما أستطيعه أيضًا

209
00:14:03,170 --> 00:14:07,470
.أعتقد أنّي سأبدأ من الأساسيّات أيضًا

210
00:14:07,470 --> 00:14:08,820
.الهتافات والرّقصات وما إلى ذلك

211
00:14:09,170 --> 00:14:14,120
بالحديث عن الرّقص، كانت كوشيدا-سينباي
.رائعة أثناء تشجيع مباراة كرة القاعدة

212
00:14:15,130 --> 00:14:16,510
!ميابي-ساما

213
00:14:47,830 --> 00:14:49,070
!ميابي-سينباي

214
00:14:50,060 --> 00:14:51,360
كاناتا؟

215
00:14:51,770 --> 00:14:52,920
لماذا أنت هنا؟

216
00:14:52,920 --> 00:14:55,490
.عفوًا، علّميني كيف أرقص رجاءً

217
00:14:55,490 --> 00:14:57,260
.هذه هي أجرة درسي

218
00:14:57,890 --> 00:14:58,960
ما خطبك؟

219
00:14:58,960 --> 00:15:02,410
...ما زلت لا أستطيع القيام بالمجازفات بعد

220
00:15:02,410 --> 00:15:05,380
لذلك السّبب أريد العمل أكثر
.على هتافي ورقصي

221
00:15:07,150 --> 00:15:07,950
ما هذا؟

222
00:15:07,950 --> 00:15:09,300
.مانجو مخبوز

223
00:15:09,300 --> 00:15:11,260
...لم أستطع المجيء خالية اليدين

224
00:15:14,830 --> 00:15:17,270
.لستُ جائعة الآن

225
00:15:21,280 --> 00:15:22,350
!موناكا الكستناء

226
00:15:23,150 --> 00:15:24,230
!راكوغان

227
00:15:25,230 --> 00:15:26,150
!كعك بطاطس

228
00:15:26,150 --> 00:15:27,570
!لا أريد

229
00:15:29,110 --> 00:15:30,200
!خوخ

230
00:15:34,450 --> 00:15:36,950
!هذا كلّ ما ستطيع شراءه بمصروفي

231
00:15:36,950 --> 00:15:39,070
.وصلتُ حدودي أيضًا

232
00:15:39,070 --> 00:15:40,660
.تعالي للنّادي فحسب

233
00:15:40,660 --> 00:15:42,180
فعلاً؟

234
00:15:43,530 --> 00:15:45,160
!ما الّذي تفكّرين فيه؟

235
00:15:45,160 --> 00:15:46,770
وماذا كان بوسعي فعله؟

236
00:15:46,770 --> 00:15:49,200
.إنّها مثابرة ولا أستطيع حتّى الرّقص

237
00:15:50,900 --> 00:15:52,010
ماذا قالت الطّبيبة؟

238
00:15:53,180 --> 00:15:55,790
.قالت أنّ الوقت حان للانتقال للخطوة التّالية

239
00:15:58,980 --> 00:16:01,850
.مل زلت لا أستطيع الطّيران بعد

240
00:16:02,280 --> 00:16:06,960
لكنّي أريد ردّ جميل كلّ الأشخاص الّذين دعموني

241
00:16:06,960 --> 00:16:08,980
.بينما كان كلّ ما أفعله هو الهلع

242
00:16:11,530 --> 00:16:12,950
.لا بأس

243
00:16:14,470 --> 00:16:16,000
!شكرًا لك

244
00:16:17,890 --> 00:16:20,620
.أعددتُ غداءك الباكر وغداءك العاديّ

245
00:16:20,620 --> 00:16:23,330
.كما أنّي أضفت أطباقك الجانبيّة المفضلّة له

246
00:16:23,330 --> 00:16:25,800
!مرحى! شكرًا لك

247
00:16:26,370 --> 00:16:28,670
عدتِ أخيرًا للنّادي وستبدئين اليوم، صحيح؟

248
00:16:29,040 --> 00:16:30,420
.مع السّلامة

249
00:16:30,840 --> 00:16:32,420
!ها أنا ذاهبة

250
00:16:48,860 --> 00:16:49,650
!ميغو

251
00:16:50,000 --> 00:16:51,320
.صباح الخير يا كاناتا

252
00:16:51,320 --> 00:16:52,530
.صباح الخير

253
00:16:52,530 --> 00:16:54,430
لديك تدريب صباحي ابتداءً
من اليوم، صحيح؟

254
00:16:54,430 --> 00:16:55,290
.نعم

255
00:16:55,290 --> 00:16:57,530
.احرصي على ألاّ تبذلي الكثير من الجهد

256
00:16:57,530 --> 00:16:58,930
ماذا تقولين؟

257
00:16:58,930 --> 00:17:00,260
.إلى اللّقاء

258
00:17:00,260 --> 00:17:02,620
.استعملي الدّرج عند نزولك من التّلّة

259
00:17:02,620 --> 00:17:04,500
!أعلم ذلك

260
00:17:06,900 --> 00:17:08,040
!وابيسكي

261
00:17:08,740 --> 00:17:10,110
!صباح الخير

262
00:17:21,110 --> 00:17:22,960
.أتطلّع للعمل معكنّ

263
00:17:59,400 --> 00:18:00,980
انفصلن إلى فِرق صغيرة
.وتدرّبن على الأساسيّات

264
00:18:00,980 --> 00:18:01,610
.نعم

265
00:18:01,610 --> 00:18:03,690
.كاناتا، ستذهبين لدعم الفريق الثّاني

266
00:18:03,690 --> 00:18:04,560
!حاضرة

267
00:18:05,760 --> 00:18:08,220
!واحد، اثنان، أسفل، أعلى

268
00:18:11,170 --> 00:18:12,230
.أتطلّع للعمل معك

269
00:18:16,700 --> 00:18:19,160
.وعضوة القمّة ستثِب

270
00:18:19,160 --> 00:18:21,220
هكذا من المفترض أن تسير
...الأمور على الأقلّ

271
00:18:24,130 --> 00:18:26,370
هلاّ كنتِ واضحة أكثر؟

272
00:18:27,260 --> 00:18:29,450
...أنا أحاول بذل جهدي هنا، ولكن

273
00:18:31,090 --> 00:18:34,340
.شرح الأمور صعب

274
00:18:35,160 --> 00:18:37,850
.كانت ذراعا عضوة القمّة ممدودتان كثيرًا

275
00:18:37,850 --> 00:18:40,920
.حاولي توجيههما مباشرة إلى السّماء أكثر

276
00:18:42,900 --> 00:18:44,160
ما الخطب؟

277
00:18:44,980 --> 00:18:46,280
.لا شيء

278
00:19:02,760 --> 00:19:03,910
.ميابي-سينباي

279
00:19:04,220 --> 00:19:06,800
.أتطلّع قدمًا لتدريب الرّقص

280
00:19:06,800 --> 00:19:09,200
...سبق وأخبرتك

281
00:19:14,880 --> 00:19:20,090
إنّ إصبعًا واحدًا هو كلّ ما يتطلّبه الأمر
.لجعل حركاتك حادّة أو لطيفة

282
00:19:21,100 --> 00:19:23,430
.أو حتّى لجعل أطرافك تبدو أطول

283
00:19:23,820 --> 00:19:28,430
.لكنّ المهمّ للتّشجيع هو أنّ الجميع معًا

284
00:19:29,190 --> 00:19:31,800
هل هذا التّدريب مهمّ من الأساس؟

285
00:19:31,800 --> 00:19:35,060
.حسنًا، إنّ بومبومز في مكان مختلف دائمًا

286
00:19:35,330 --> 00:19:37,540
.هكذا إذًا

287
00:19:37,540 --> 00:19:38,940
هل ذلك ممتع؟

288
00:19:42,020 --> 00:19:43,840
.حسنًا، انتهينا

289
00:19:46,680 --> 00:19:48,010
.سنغادر

290
00:19:48,010 --> 00:19:50,580
.حان وقت إغلاق الصّالة الرّياضيّة

291
00:19:50,900 --> 00:19:52,410
.حسنًا

292
00:19:52,410 --> 00:19:53,830
.حـ-حسنًا

293
00:19:56,300 --> 00:19:57,250
ماذا؟

294
00:19:59,160 --> 00:20:00,350
...عفوًا

295
00:20:00,350 --> 00:20:01,770
أين هي ماري-سينباي؟

296
00:20:04,520 --> 00:20:07,180
.لا أعتقد أنّه أمر نحتاج لإخفائه

297
00:20:08,600 --> 00:20:09,890
.لقد انسحبت

298
00:20:11,060 --> 00:20:12,310
ولكن لماذا؟

299
00:20:17,000 --> 00:20:20,240
قد تعثرين على ماري في المكتبة
.في مثل هذا الوقت

300
00:20:23,390 --> 00:20:25,410
.سنغلق بعد 15 دقيقة

301
00:20:26,040 --> 00:20:31,000
سيُغلق مكتب تأجير وإعادة الكتب
.بعد خمس دقائق

302
00:20:31,000 --> 00:20:34,970
.تعالوا بسرعة رجاءً إن كنتم بحاجة لاستعماله

303
00:20:41,640 --> 00:20:42,910
ماري-سينباي؟

304
00:20:47,260 --> 00:20:48,470
.ماري-سينباي

305
00:20:48,470 --> 00:20:52,430
...سمعتُ أنّك انسحبت من نادي التّشجيع

306
00:20:53,960 --> 00:20:57,900
.لا أستحقّ القيام بالتّشجيع بعد الآن

307
00:21:03,560 --> 00:21:06,890
.أنا من كتبتُ ذلك التّعليق

308
00:23:22,440 --> 00:23:24,000
...ماري-سينباي