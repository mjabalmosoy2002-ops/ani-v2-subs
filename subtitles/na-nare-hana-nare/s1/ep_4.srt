1
00:00:12,600 --> 00:00:15,780
!مذهل، المشاهدات في تزايد

2
00:00:15,780 --> 00:00:18,410
!انظري! تجاوزت المائة

3
00:00:18,410 --> 00:00:19,880
!مرحى

4
00:00:19,880 --> 00:00:21,270
!معك حقّ

5
00:00:21,270 --> 00:00:23,800
!ولكن لماذا بومبومز؟

6
00:00:25,130 --> 00:00:26,210
!انظرن

7
00:00:26,610 --> 00:00:27,710
!أعددته بنفسي

8
00:00:29,020 --> 00:00:30,760
!بمساعدة من ميغو

9
00:00:30,760 --> 00:00:32,050
!إنّه ظريف

10
00:00:32,050 --> 00:00:32,760
صحيح؟

11
00:00:32,760 --> 00:00:33,880
!صحيح

12
00:00:34,190 --> 00:00:35,670
بومبومز؟

13
00:00:37,630 --> 00:00:39,410
.تطلّب إعداد البومبومز الكثير من العمل

14
00:00:39,410 --> 00:00:41,360
.سأفكّر في مشروعي التّالي

15
00:00:41,360 --> 00:00:42,060
!من الآن؟

16
00:00:42,060 --> 00:00:45,120
.يجب مواصلة النّشر وإلاّ شعر النّاس بالملل

17
00:00:45,120 --> 00:00:47,240
النّاس لا يتسامحون، صحيح؟

18
00:00:47,240 --> 00:00:48,360
!مع السّلامة

19
00:00:48,360 --> 00:00:50,000
.حظًّا سعيدًا

20
00:01:00,780 --> 00:01:01,580
موسيقى الكاونتري؟

21
00:01:01,580 --> 00:01:04,680
.لا، إنّها أغنية فرقة بوب للكاباريه

22
00:01:05,070 --> 00:01:10,040
أحبّ أنّهم غريبون بما يكفي ليُكرّموا
.موسيقى كاونتري كلاسيكيّة في عزفهم

23
00:01:10,040 --> 00:01:11,260
.فعلاً

24
00:01:11,260 --> 00:01:12,910
من أين حصلت عليها؟

25
00:01:12,910 --> 00:01:13,880
.كانت هديّة

26
00:01:14,210 --> 00:01:15,300
هديّة؟

27
00:01:17,130 --> 00:01:18,090
".تشاو"

28
00:01:18,480 --> 00:01:20,070
!ميا

29
00:04:00,990 --> 00:04:03,680
.تاليًا، وضعيّة النّسر

30
00:04:13,970 --> 00:04:15,300
!نودوكا

31
00:04:15,870 --> 00:04:16,920
!ركّزي

32
00:04:30,310 --> 00:04:31,420
ماذا عن هذا؟

33
00:04:33,090 --> 00:04:39,640
إنّهم يطلبون أغنية نقيّة وحالمة
.ولكن ليست عاطفيّة جدًّا

34
00:04:39,640 --> 00:04:41,700
.ذلك معقّد للغاية

35
00:04:41,700 --> 00:04:45,720
عليّ تحقيق رغباتهم وجعل
.المراسم ذكرى لا تُنسى

36
00:04:45,720 --> 00:04:48,520
.ذلك هو سرّ نجاح منظّم حفلات الزّفاف الجيّد

37
00:04:50,050 --> 00:04:52,180
.كان أبي يحبّ تلك كثيرًا

38
00:04:52,180 --> 00:04:54,770
!فعلاً! جيمس بلاك

39
00:04:56,440 --> 00:04:57,700
أتذكرين؟

40
00:04:58,110 --> 00:05:01,740
عندما انتقلنا إلى هنا، كنت تمسكين
بتلك الأسطوانات وتبكين قائلة

41
00:05:01,740 --> 00:05:04,570
"لماذا لا نملك نحن مشغّل أسطوانات؟"

42
00:05:04,850 --> 00:05:06,650
.تردّدين تلك القصّة دائمًا

43
00:05:14,100 --> 00:05:15,660
!صباح الخير يا جدّة

44
00:05:18,590 --> 00:05:22,580
.صباح الخير يا أنّا-تشان

45
00:05:23,770 --> 00:05:26,010
.صباح الخير يا والدة نودوكا

46
00:05:26,010 --> 00:05:27,240
.صباح الخير

47
00:05:27,240 --> 00:05:28,140
أتريدين تناول الفطور معنا؟

48
00:05:28,140 --> 00:05:28,960
!أكيد

49
00:05:29,970 --> 00:05:31,720
.ممتاز

50
00:05:43,560 --> 00:05:44,590
!ماذا؟

51
00:05:49,090 --> 00:05:51,740
ما خطب ساقها؟

52
00:05:51,740 --> 00:05:53,760
.يمكنني ذلك وحدي

53
00:05:54,410 --> 00:05:57,810
من الأفضل أن تستيقظي بسرعة
.وإلاّ أكلت فطورك

54
00:05:57,810 --> 00:05:58,420
!كلاّ

55
00:05:59,500 --> 00:06:00,940
!شكرًا لكم

56
00:06:01,470 --> 00:06:03,060
.مع السّلامة

57
00:06:04,680 --> 00:06:06,400
.أكيد

58
00:06:06,970 --> 00:06:11,120
.مع السّلامة

59
00:06:13,630 --> 00:06:17,020
.أخبرتك ألاّ تدخلي بدون إذني

60
00:06:17,020 --> 00:06:19,900
.إنّه خطؤك لأنّك لم تستيقظي قبل وصولي

61
00:06:19,900 --> 00:06:22,330
.كان بإمكاني النّوم لعشر دقائق أخرى

62
00:06:22,330 --> 00:06:24,200
لماذا اليوم بالتّحديد...؟

63
00:06:25,210 --> 00:06:26,400
!صباح الخير

64
00:06:26,400 --> 00:06:27,560
.صباح الخير

65
00:06:29,710 --> 00:06:32,530
.راودتني فكرة للتّوّ

66
00:06:36,750 --> 00:06:38,710
!صباح الخير

67
00:06:38,710 --> 00:06:39,490
.كاناتا-تشان

68
00:06:39,490 --> 00:06:40,750
!كاناتا

69
00:06:43,300 --> 00:06:44,970
!راودتني فكرة رائعة للتّوّ

70
00:06:44,970 --> 00:06:46,140
فعلاً؟

71
00:06:46,140 --> 00:06:48,630
!أنّا-تشان، لا عناق رجاءً

72
00:06:48,960 --> 00:06:50,050
...عفوًا

73
00:06:50,050 --> 00:06:54,100
سأستعمل أسطواناتي المفضّلة
.لتأليف موسيقى ستحببنها جميعكنّ

74
00:06:54,510 --> 00:06:55,810
لأجل مشروعك التّالي؟

75
00:06:55,810 --> 00:06:56,640
.لا أدري

76
00:06:56,640 --> 00:06:58,520
،بما أنّ لدينا مشاهدات وفيديوهات أكثر الآن

77
00:07:01,180 --> 00:07:02,980
لذلك أحضرت أسطوانات والدك؟

78
00:07:03,480 --> 00:07:09,530
سأقوم بعمل توزيع رائع لموسيقاي
!المفضّلة ليستمتع بها الجميع

79
00:07:09,530 --> 00:07:13,030
سأستعمل معدّات واي جي
.لإعداد عيّنة عنها

80
00:07:13,940 --> 00:07:15,990
واي جي...؟

81
00:07:16,270 --> 00:07:19,550
.صاحب المتجر حيث تعمل أنّا-تشان

82
00:07:19,550 --> 00:07:21,540
...لطالما شغل بالي أمر ما

83
00:07:22,010 --> 00:07:22,960
وما هو؟

84
00:07:23,310 --> 00:07:25,790
لماذا تناديه واي جي؟

85
00:07:26,130 --> 00:07:28,750
.لطالما كان واي جي هو واي جي

86
00:07:28,750 --> 00:07:30,010
.ذلك ما يناديه به الجميع أيضًا

87
00:07:30,580 --> 00:07:32,260
الجميع؟

88
00:07:32,260 --> 00:07:34,140
تقصدين النّاس الّذين يمرّون
عليه في الصّيف؟

89
00:07:34,140 --> 00:07:36,600
إنّهم هنا خلال الصّيف؟
.ذلك رائع

90
00:07:36,600 --> 00:07:39,660
إنهم يأتون للعزف
.في المهرجانات كضيوف رئيسيّين

91
00:07:39,660 --> 00:07:42,370
مثل منسّقي الأغاني ومغنّي الرّاب
.وقادة الفرق الموسيقيّة وما شابه

92
00:07:42,370 --> 00:07:44,440
!يبدون كأشخاص مذهلين

93
00:07:44,440 --> 00:07:45,580
!أتظنّين؟

94
00:07:45,580 --> 00:07:49,010
!كان واي جي منسّق أغان بارعًا أيضًا

95
00:07:49,010 --> 00:07:53,490
يأتي النّاس إلى ستاوت ريكورد
!لشراء أشياء من مجموعته

96
00:07:53,490 --> 00:07:55,570
لكنّ المكان مظلم والدّرج شديد الانحدار

97
00:07:55,570 --> 00:07:58,010
.ويبدو النّاس هناك مثيرين للشّبهات

98
00:07:58,010 --> 00:07:59,780
أزرت المكان من قبل؟

99
00:07:59,780 --> 00:08:00,640
...كلاّ، ولكن

100
00:08:00,640 --> 00:08:01,250
ماذا هنالك؟

101
00:08:03,570 --> 00:08:05,920
!أنا أشتعل حماسة الآن

102
00:08:05,920 --> 00:08:08,050
!سأكون في المتجر

103
00:08:08,830 --> 00:08:10,880
!لا! لدينا مدرسة

104
00:08:11,880 --> 00:08:13,460
.عليّ الذّهاب أيضًا

105
00:08:13,460 --> 00:08:14,820
.إلى اللّقاء

106
00:08:14,820 --> 00:08:16,480
أ-أنّا-تشان؟

107
00:08:16,480 --> 00:08:17,800
!سأسبقك

108
00:08:18,270 --> 00:08:19,890
!انتظريني

109
00:08:19,890 --> 00:08:22,060
!أنّا-تشان

110
00:08:40,090 --> 00:08:42,040
تستمع لموسيقى البلوز اليوم؟

111
00:08:43,020 --> 00:08:44,580
.هذا هو مزاجي اليوم

112
00:08:44,580 --> 00:08:46,100
.هكذا إذًا

113
00:08:46,100 --> 00:08:47,630
أيمكنني استعارة معدّاتك؟

114
00:08:47,630 --> 00:08:48,520
.أكيد

115
00:08:51,780 --> 00:08:55,960
حصلتُ على أكثر من مائة مشاهدة
.في فيديو التّشجيع الّذي أخبرتك عنه

116
00:08:55,960 --> 00:08:57,580
.ذلك رائع

117
00:08:57,580 --> 00:08:58,840
أتظنّ؟

118
00:08:58,840 --> 00:09:00,970
.لديك فريق ممتاز

119
00:09:00,970 --> 00:09:05,560
عليّ التّفكير في أفكار أكثر والحصول على
...مشاهدات أكثر وستاوت ريكورد سوف

120
00:09:10,970 --> 00:09:13,470
.سأعزف موسيقاي الخاصّة هنا

121
00:09:13,470 --> 00:09:15,440
أتلك هي الغاية من الأسطوانة؟

122
00:09:15,440 --> 00:09:17,470
.أنا أستعملها كعيّنة

123
00:09:17,470 --> 00:09:19,380
هل يمكنني استعارة هذا لفترة؟

124
00:09:19,740 --> 00:09:20,970
.نعم

125
00:09:20,970 --> 00:09:22,490
.يمكنك الاحتفاظ به إن أردت

126
00:09:23,670 --> 00:09:25,200
!فعلاً؟ أتقول الحقيقة؟

127
00:09:25,200 --> 00:09:25,800
.نعم

128
00:09:25,800 --> 00:09:26,460
!مرحى

129
00:09:27,820 --> 00:09:29,840
ستشتري واحدًا جديدًا؟

130
00:09:30,730 --> 00:09:33,590
.لن أحتاجه بعد الآن

131
00:09:36,250 --> 00:09:41,350
سأقدّم المجموعة الّتي هنا
.إلى محلّ أسطوانات في طوكيو

132
00:09:43,190 --> 00:09:44,290
أيّ مجموعة؟

133
00:09:44,290 --> 00:09:46,890
الجاز؟ السّول؟ الرّيغي؟

134
00:09:47,230 --> 00:09:50,120
.آمل ألاّ تعطيهم المجموعة اللاّتينيّة

135
00:09:50,120 --> 00:09:51,530
.بل جميعها

136
00:09:51,530 --> 00:09:52,300
ماذا؟

137
00:09:53,200 --> 00:09:56,400
.سأغلق المتجر

138
00:10:01,120 --> 00:10:04,650
لقد أتوا إليّ وعرضوا أخذ كلّ شيء

139
00:10:04,650 --> 00:10:08,790
.لكي لا تضيع مجموعتي هباءً

140
00:10:14,820 --> 00:10:17,330
.سيتمكّن النّاس من رؤيتها في طوكيو

141
00:10:17,330 --> 00:10:19,920
،إنّ ذلك أفضل من تركها هنا
.حيث لا يأتي أحد

142
00:10:19,920 --> 00:10:20,800
!بل يأتون

143
00:10:21,560 --> 00:10:22,720
!يأتي النّاس بالفعل

144
00:10:22,720 --> 00:10:26,010
،انتقل العديد منهم للعيش بعيدًا

145
00:10:26,010 --> 00:10:30,900
لكنّهم يقضون أزيد من عشر ساعات
...في الطّائرة ويستقلّون عدّة قطارات و

146
00:10:33,900 --> 00:10:36,870
.ليس صحيحًا أنّ لا أحدي يأتي إلى هنا

147
00:10:37,430 --> 00:10:40,860
لماذا طوكيو إذًا؟
لماذا لا يمكنها أن تكون هنا؟

148
00:10:47,650 --> 00:10:50,240
إنّ المتجر منعزل لدرجة أنّ بإمكانك
،سماع تغريد الوقواق في الخارج

149
00:10:50,240 --> 00:10:53,890
.لكنّي أريد توديعها ببعض الجلبة

150
00:10:53,890 --> 00:10:59,470
سيكون كرنفال تاكاساكي في غينزا
.المركزيّة هو آخر يوم للمتجر

151
00:11:02,600 --> 00:11:04,860
!أنا لا أفهم

152
00:11:22,330 --> 00:11:24,020
أنّا-تشان؟

153
00:11:29,050 --> 00:11:30,620
...عجبًا

154
00:11:33,890 --> 00:11:35,790
!سأغادر

155
00:11:35,790 --> 00:11:37,260
.حسنًا

156
00:11:37,260 --> 00:11:39,300
—مع السّلا

157
00:11:42,020 --> 00:11:44,830
أنّا-تشان، هل أنت مستيقظة؟

158
00:11:45,340 --> 00:11:46,970
!سنتأخّر

159
00:12:01,550 --> 00:12:04,570
،عليّ فعل شيء ما
!وإلاّ اختفى المتجر للأبد

160
00:12:05,250 --> 00:12:06,960
هل سيُغلق المتجر؟

161
00:12:06,960 --> 00:12:08,080
!لا، لن يحدث ذلك

162
00:12:08,350 --> 00:12:09,500
.آسفة

163
00:12:11,070 --> 00:12:12,810
.ليس لدينا وقت

164
00:12:15,030 --> 00:12:16,540
.لن أذهب للمدرسة

165
00:12:17,490 --> 00:12:19,130
.لدينا اختبارات اليوم

166
00:12:19,130 --> 00:12:20,170
!اذهبي

167
00:12:22,260 --> 00:12:23,630
ما خطبك؟

168
00:12:50,690 --> 00:12:51,900
.وابيسكي

169
00:12:53,000 --> 00:12:53,960
.ها أقد وصلت

170
00:12:53,960 --> 00:12:54,650
...فتيات

171
00:12:54,650 --> 00:12:55,810
أتريدين بعض اليوكان؟

172
00:12:55,810 --> 00:12:56,580
.نعم

173
00:12:56,580 --> 00:12:58,640
لكن أين أنّا-تشان؟

174
00:12:59,690 --> 00:13:01,010
.لن تحضر اليوم

175
00:13:01,010 --> 00:13:01,760
لديها دروس دعم؟

176
00:13:01,760 --> 00:13:03,250
.إنّها ليست مثلك يا كاناتا

177
00:13:03,250 --> 00:13:05,250
!لم أضطرّ لأخذها أبدًا أيضًا

178
00:13:05,250 --> 00:13:08,350
أنا قلقة بعض الشّيء
.من أنّها لن تستطيع المجيء

179
00:13:08,350 --> 00:13:10,560
.إنّها دائمًا الأكثر حماسة

180
00:13:10,840 --> 00:13:11,740
.نعم

181
00:13:12,250 --> 00:13:16,570
.إنّ للأمر علاقة بإغلاق مكان عملها

182
00:13:23,990 --> 00:13:28,280
كانت أنّا-تشان خجولة جدًّا
.عندما أتت لليابان

183
00:13:28,280 --> 00:13:29,740
أنّا-تشان؟

184
00:13:29,740 --> 00:13:31,950
لأنّها لم تستطع التّحدّث باليابانيّة أو ما شابه؟

185
00:13:31,950 --> 00:13:33,170
.بل كانت تتحدّثها

186
00:13:33,170 --> 00:13:35,440
.أمّها يابانيّة

187
00:13:35,440 --> 00:13:40,010
ووالدها برازيليّ، لذلك تتحدّث
.البرتغاليّة والإنجليزيّة بطلاقة

188
00:13:40,010 --> 00:13:42,850
.تتحدّث ثلاثة لغات؟ هذا مذهل

189
00:13:42,850 --> 00:13:45,350
هل عادوا إلى هنا بسبب العمل؟

190
00:13:49,030 --> 00:13:51,810
.يبدو أنّهم عادوا بسبب موت والدها

191
00:13:56,990 --> 00:14:01,840
،لم تخبرني بذلك أبدًا
.لكنّ ذلك ما قاله لي والداي

192
00:14:01,840 --> 00:14:04,220
.يعرف معظم زملائنا في المدرسة ذلك

193
00:14:04,220 --> 00:14:05,890
.هكذا إذًا

194
00:14:05,890 --> 00:14:06,780
.نعم

195
00:14:06,780 --> 00:14:11,370
.كنّا في الإعداديّة، لذلك لم أعرف ما العمل

196
00:14:11,370 --> 00:14:13,290
.لذلك غضضت الطّرف عن الأمر فحسب

197
00:14:13,880 --> 00:14:18,020
.محظوظة! لديها شعر لامع
.إنّها تشبه دمية

198
00:14:18,020 --> 00:14:19,840
.إنّها لا تتكلّم أبدًا

199
00:14:19,840 --> 00:14:22,000
...ذلك لأنّ والدها

200
00:14:24,050 --> 00:14:26,320
.هيّا، اذهبوا أنتم للحديث معها

201
00:14:26,320 --> 00:14:28,920
!مستحيل! اذهبن أنتنّ

202
00:14:29,510 --> 00:14:34,200
كفاكم همسًا خلف ظهري
!وتعالوا للحديث معي

203
00:14:41,250 --> 00:14:45,290
كانت تلك الرّكلة كافية لتُرعب
.الفصل بأكمله

204
00:14:45,290 --> 00:14:46,820
.أتوقّع ذلك

205
00:14:46,820 --> 00:14:50,930
بدأ الجميع بالتّصرّف بحذر شديد
.معها مذّاك الحين

206
00:14:50,930 --> 00:14:52,570
...لذلك السّبب

207
00:14:52,930 --> 00:14:53,410
!كلاّ

208
00:14:53,760 --> 00:14:56,300
!إنّ التّعامل بلطف معها يعني دفعها بعيدًا

209
00:14:56,300 --> 00:14:58,570
"إنّ الكانجي لـ"التّصرّف بمراعاة
!يضمّ كلمة "بعيد" أيضًا

210
00:14:58,570 --> 00:14:59,580
!ألا تعلمن ذلك؟

211
00:14:59,960 --> 00:15:02,720
.إذًا فقد كانت تتحدّث عن نفسها

212
00:15:03,440 --> 00:15:04,260
.نعم

213
00:15:05,070 --> 00:15:08,260
.لكنّها هدأت بعد فترة

214
00:15:08,260 --> 00:15:09,760
.وألقت عليّ التّحيّة

215
00:15:10,740 --> 00:15:12,300
.صباح الخير

216
00:15:14,050 --> 00:15:16,240
.وهكذا صرتما صديقتين

217
00:15:16,240 --> 00:15:17,970
.حدث هذا بعد ذلك بمدّة

218
00:15:18,580 --> 00:15:23,080
ولكن يبدو أنّ مالك
ستاوت ريكورد حيث تعمل

219
00:15:23,080 --> 00:15:25,230
.هو من ساعدها ليسهل التّقرّب منها

220
00:15:25,700 --> 00:15:26,890
.فهمت

221
00:15:27,190 --> 00:15:31,820
يبدو الأمر وكأنّها عادت لما كانت
.عليه من قبل، وذلك يُقلقني

222
00:15:32,190 --> 00:15:33,110
!هيّا بنا

223
00:15:34,010 --> 00:15:35,900
...لكنّ ذلك المكان

224
00:15:37,710 --> 00:15:40,490
المتجر حيث تعمل في الأعلى؟

225
00:15:40,490 --> 00:15:41,590
.نعم

226
00:15:43,020 --> 00:15:45,710
.الأضواء مشتعلة

227
00:15:47,000 --> 00:15:49,050
.اذهبي أوّلاً يا نودوكا-تشان

228
00:15:49,390 --> 00:15:51,040
!ماذا؟ لماذا؟

229
00:15:51,040 --> 00:15:53,900
ألن يكون ذلك أسهل عليك
بما أنّك تعرفينهما؟

230
00:15:53,900 --> 00:15:57,220
.في الحقيقة، لم أدخل إلى هناك من قبل

231
00:15:57,220 --> 00:15:58,690
.لكنّه في الجهة المقابلة لمنزلك

232
00:15:58,690 --> 00:15:59,770
...صحيح

233
00:16:00,460 --> 00:16:02,890
.يأتي إليه الكثير من الزّبائن الأجانب وما شابه

234
00:16:03,400 --> 00:16:05,230
.وأنا لا أتحدّث الإنجليزيّة

235
00:16:07,280 --> 00:16:09,890
لـ-لماذا لا ندخل جميعنا معًا إذًا؟

236
00:16:09,890 --> 00:16:11,140
.أنا لن أدخل

237
00:16:11,660 --> 00:16:13,130
!لـ-لم لا؟

238
00:16:17,630 --> 00:16:19,110
ماذا نفعل؟

239
00:16:19,110 --> 00:16:22,060
...يبدو أنّ علينا الذّهاب وحدنا

240
00:16:22,060 --> 00:16:23,690
...لكنّي لا أريد الدّخول أوّلاً

241
00:16:23,690 --> 00:16:25,710
!لنختر جحر في البداية

242
00:16:25,710 --> 00:16:27,750
!حجر، ورقة، مقصّ

243
00:16:33,930 --> 00:16:35,910
أنّا-تشان؟

244
00:16:41,030 --> 00:16:43,100
...المعذرة

245
00:16:43,570 --> 00:16:44,550
ماذا؟

246
00:16:44,990 --> 00:16:47,770
.ينبغي أن تكون في العمل في هذا الوقت

247
00:16:49,850 --> 00:16:51,530
.مرحبًا بكنّ

248
00:16:52,330 --> 00:16:55,000
،أنا أوتاني نودوكا
.من متجر المذبح المقابل لك

249
00:16:55,000 --> 00:16:57,220
.وأنا ميسورا كاناتا من بومبومز

250
00:16:57,220 --> 00:16:59,110
.وأنا تانيزاكي شيون

251
00:16:59,560 --> 00:17:02,790
.إنّنا نقوم بفيديوهات تشجيع مع أنّا-تشان

252
00:17:02,790 --> 00:17:04,410
.أنا على علم بذلك

253
00:17:05,420 --> 00:17:08,230
.إنّنا نبحث عن أنّا-تشان

254
00:17:09,370 --> 00:17:11,200
.إنّها لم تحضر اليوم

255
00:17:13,110 --> 00:17:14,270
...عفوًا

256
00:17:14,270 --> 00:17:16,890
لماذا ستغلق المتجر؟

257
00:17:18,720 --> 00:17:21,220
...تبدو حزينًا بعض الشّيء، لذا

258
00:17:22,680 --> 00:17:25,540
.إنّ أنّا-تشان تحبّ هذا المتجر

259
00:17:25,540 --> 00:17:30,320
.وذلك بادٍ من منحها لنفس الاسم لقناة التّشجيع

260
00:17:32,550 --> 00:17:34,240
فعلاً؟

261
00:18:13,980 --> 00:18:16,300
.لدينا زبونة صغيرة

262
00:18:16,300 --> 00:18:17,280
.مرحبًا

263
00:18:19,410 --> 00:18:20,570
"!أولا"

264
00:18:21,250 --> 00:18:22,300
.تفضّلي

265
00:18:28,770 --> 00:18:29,780
.شغّل هذه

266
00:18:30,450 --> 00:18:33,380
،هذا متجر أسطوانات
.لذلك لا بدّ أنّ لديك مشغّل أسطوانات

267
00:18:34,460 --> 00:18:36,420
.بالطّبع لديّ

268
00:18:40,070 --> 00:18:41,510
.جي بي

269
00:18:41,510 --> 00:18:42,930
.لديك ذوق ممتاز

270
00:18:43,250 --> 00:18:46,590
...يحبّ أبي... هذه الأغنية

271
00:18:47,140 --> 00:18:49,030
.والدك مذهل

272
00:18:54,290 --> 00:18:55,650
.إنّها في حالة جيّدة

273
00:19:01,140 --> 00:19:02,890
.لا داعي للقلق

274
00:19:02,890 --> 00:19:05,120
.إنّه محلول تنظيف

275
00:19:05,400 --> 00:19:07,910
.إنّه يحافظ على نظافة الأسطوانات

276
00:19:11,260 --> 00:19:14,040
.يجب مسحه عليها هكذا برفق حتّى لا تتضرّر

277
00:19:14,530 --> 00:19:18,980
وبهذا نكون قد تخلّصنا من الغبار
.والأوساخ لمنع الشّوكة من الارتداد

278
00:19:19,810 --> 00:19:21,550
.سيُصدر صوتًا ممتازًا

279
00:19:39,600 --> 00:19:43,090
.أنارت بسمتها المتجر بالكامل

280
00:19:43,090 --> 00:19:45,720
صارت صديقة مع الزّبائن
.المعتادين بسرعة أيضًا

281
00:19:49,240 --> 00:19:53,640
لا بدّ أنّ هذا كان مكانًا جيّدًا
.لقضاء الوقت فيه بالنّسبة لها

282
00:19:55,150 --> 00:19:57,960
إذًا لم تكن مثلما كانت
.في المدرسة على الإطلاق

283
00:20:00,970 --> 00:20:03,890
.كان واضحًا أنّها لم تنسجم جيّدًا هناك

284
00:20:05,810 --> 00:20:08,060
أليس عليك اللّعب مع أصدقائك؟

285
00:20:08,530 --> 00:20:09,470
.لا

286
00:20:09,760 --> 00:20:12,480
.يقومون جميعًا بمشاهدتي عن بعد فحسب

287
00:20:12,970 --> 00:20:16,440
،إن لم يقتربوا منك
.يمكنك دائمًا أن تبادري أنت بذلك

288
00:20:16,860 --> 00:20:18,150
كيف؟

289
00:20:18,150 --> 00:20:21,740
هل تذكرين ما الّذي فعلته ميا
عندما التقت بك أوّل مرّة هنا؟

290
00:20:22,280 --> 00:20:23,320
"!أولا"

291
00:20:23,320 --> 00:20:24,430
.جيّد

292
00:20:24,430 --> 00:20:28,200
إنّ إلقاء التّحيّة يفتح الأبواب
.للحديث مع أيّ أحد

293
00:20:28,510 --> 00:20:31,930
حاولي إلقاء التّحيّة عندما تقابلين
.أحدًا ما في المدرسة غدًا

294
00:20:43,510 --> 00:20:48,080
أريدك أن تخبريني ماذا يمكننا
.فعله لأجل المتجر

295
00:20:48,940 --> 00:20:50,430
.إنّها ليست مشكلتك

296
00:20:51,100 --> 00:20:54,050
.هذا بيني وبين واي جي

297
00:20:54,050 --> 00:20:55,330
.إنّها مشكلتي بالفعل

298
00:20:55,330 --> 00:20:56,240
.كلاّ

299
00:20:56,240 --> 00:20:56,920
.بلى

300
00:20:58,000 --> 00:21:01,940
.اسم فرقة بومبومز هو ستاوت ريكورد

301
00:21:04,330 --> 00:21:06,750
.لقد أجبرتنا على القيام بالتّشجيع

302
00:21:06,750 --> 00:21:08,740
.لذلك لن أسمح لك بإخباري أنّها ليست مشكلتنا

303
00:21:09,080 --> 00:21:12,190
.لا تُبعدي نفسك عنّا فقد كمراعاة لمشاعرنا

304
00:21:20,790 --> 00:21:24,240
.لا أعرف ما العمل

305
00:21:28,490 --> 00:21:35,390
أعتقد أنّه يُمثّل منزلاً ثانيًا لها
.أكثر من كونه مكانًا لقضاء الوقت

306
00:21:35,640 --> 00:21:37,230
...فهمت

307
00:21:37,490 --> 00:21:40,320
،أعتقد أنّنا إن كنّا سنقوم بشيء ما
.فالآن هي فرصتنا الوحيدة

308
00:21:43,330 --> 00:21:45,600
.لنساعد ذلك المتجر ليظلّ مفتوحًا للأبد

309
00:21:46,420 --> 00:21:47,860
!لنقم بتشجيعٍ لأجله

310
00:21:49,640 --> 00:21:53,340
.التّشجيع والموسيقى هو ما نجيده