1
00:00:02,310 --> 00:00:06,020
!هكذا إذًا يا كيريس-كن، هذا يتخطّى مستوى قدراتك

2
00:00:07,020 --> 00:00:09,530
.أقدّم اعتذاري أيّها المدير

3
00:00:09,940 --> 00:00:15,780
.لكن لا يمكنني أن أكون طرفًا في حضّ الطلّاب على بذل جهدً من غير نتيجة

4
00:00:15,990 --> 00:00:21,950
بعد
عدّة
أشهر

5
00:00:18,450 --> 00:00:21,540
.فشلٌ آخر

6
00:00:22,450 --> 00:00:25,000
...إذًا، فالخطوة التالية

7
00:02:08,980 --> 00:02:12,770
"هنالك في هذا العالم أناسٌ يصنّفون ك "عباقرة

8
00:02:14,230 --> 00:02:16,150
.أنهيتها أيّتها المعلّمة

9
00:02:16,860 --> 00:02:21,200
إنّها صحيحةٌ بالفعل، لكن يا أوغاتا-سان، ماذا عن طرية الحلّ؟

10
00:02:21,990 --> 00:02:23,530
...طريقة الحلّ

11
00:02:24,240 --> 00:02:28,710
.اعذريني، علمت إجابتها من اللحظة التي رأيتها فيها، لذا تخطّيت طريقة الحلّ

12
00:02:30,290 --> 00:02:34,170
.بالنسبة للرياضيّات والفيزياء، فما من مثيلٍ لها

13
00:02:34,500 --> 00:02:36,880
.إنّها المدهشة بطول 143 سنتمترًا

14
00:02:37,130 --> 00:02:39,090
."إنّها "أميرة العمليّات الحسابيّة المبهمة

15
00:02:40,180 --> 00:02:41,510
.أوغاتا ريزو

16
00:02:42,260 --> 00:02:48,390
!فوروهاشي، يا لها، يا لها من مقالةٍ ملهمةٍ جيّاشة العاطفة

17
00:02:49,350 --> 00:02:52,610
.عذرًا، ليست سوى مقالةٍ عاديّة

18
00:02:52,860 --> 00:02:54,110
سأقولها مجدّدًا

19
00:02:54,520 --> 00:02:57,360
"هنالك في هذا العالم أناسٌ يصنّفون ك "عباقرة

20
00:02:57,570 --> 00:03:01,360
...رغم أنّ فوروهاشي-سان كانت نائمةً  إلى ما قبل تقديمنا للمقالةِ بعشرِ دقائق

21
00:03:01,910 --> 00:03:04,070
!العباقرة مختلفون عنّا حقًّا

22
00:03:04,070 --> 00:03:06,620
!وهي فاتنةٌ علاوة على هذا، ليتني كنت مثلها

23
00:03:08,290 --> 00:03:12,080
اليابانيّة المعاصرة، المؤلّفات التراثيّة، والأدبيّات الصينيّة
.إنّها تتربّع على قمّة هذه الموادّ الثلاثة

24
00:03:12,710 --> 00:03:14,540
.أميرة غابة الأدب النّائمة

25
00:03:15,630 --> 00:03:17,510
.فوروهاشي فوميتو

26
00:03:19,760 --> 00:03:23,140
.وهنالك من ليسوا عباقرةً طبعًا

27
00:03:23,800 --> 00:03:26,600
،طالبٌ بطيئ الفهم مذ أن كان طفلًا

28
00:03:27,010 --> 00:03:31,270
."عليه بذل جهدٍ مضاعف عن البقيّة ليتعلّم شيئًا، "طالبٌ بقدراتٍ عاديّة

29
00:03:32,270 --> 00:03:33,770
!إنّه أنا

30
00:03:44,660 --> 00:03:45,620
!ناري-تشان

31
00:03:46,030 --> 00:03:48,370
هل ستدرس في مكتبة المدرسة مجدّدًا؟

32
00:03:48,870 --> 00:03:49,660
.أجل

33
00:03:49,660 --> 00:03:51,750
.عليك أن تمضي معنا وقتًا بين الآونة والأخرى

34
00:03:52,160 --> 00:03:53,500
.ما من فائدة

35
00:03:53,500 --> 00:03:56,540
.إنّ ناري-تشان يضع توصية النّخبة المميّزة نصب عينه

36
00:03:56,540 --> 00:04:00,300
.بخصوص هذا، يقال أنّ طالبًا استثنائيّا مميّزًا واحدًا سيتمّ اختياره

37
00:04:00,510 --> 00:04:01,220
.صحيح

38
00:04:01,470 --> 00:04:03,680
،من يتمّ اختياره لتوصية النخبة المميّزة

39
00:04:03,680 --> 00:04:07,600
.سيتمكّن من الالتحاق بالجامعة الأمّ من غير التقدّم للاختبار، إضافةً لتغطية رسوم الجامعة

40
00:04:07,600 --> 00:04:10,770
!إنّه منهج الحلم الخاصّ بأكاديميّتنا

41
00:04:11,100 --> 00:04:15,600
.حسنًا، فهمت الأمر، إنّ عائلة يويغا مدقعة الفقر لذا

42
00:04:15,600 --> 00:04:17,480
!أنت، انتقِ كلماتك بعنايةٍ أكثر

43
00:04:17,480 --> 00:04:20,030
!"لأمكنك القول: "تعاني من ضائقة ماليّة

44
00:04:20,030 --> 00:04:24,200
،3-B يويغا ناريوكي من الفصل
فلتحضر لمكتب المدير رجاءً

45
00:04:24,570 --> 00:04:27,740
،3-B أكرّر، يويغا ناريوكي من الفصل

46
00:04:33,250 --> 00:04:36,130
،ليست مادّة واحدةً ما أنت مميزٌ استثنائيًّا فيها

47
00:04:36,130 --> 00:04:39,670
.لكنّك حافظت بشكلٍ جيّد على درجات بمقدار 80% أو أعلى في جميع المواد

48
00:04:39,670 --> 00:04:42,380
،وفيما يتعلّق يالسلوك، ما من أيّ شكوى أيضًا

49
00:04:42,920 --> 00:04:44,470
ما- ما- ما- ما هذا؟

50
00:04:44,470 --> 00:04:47,090
لمَ دُعيتُ فجأةً لمقابلةٍ كهذه؟

51
00:04:47,510 --> 00:04:48,430
.تقرّر الأمر

52
00:04:48,680 --> 00:04:52,470
.إنّني سعيدٌ بأن أمنحك توصية النّخبة المميّزة

53
00:04:52,810 --> 00:04:54,270
ح- حقًّا؟

54
00:04:54,270 --> 00:04:56,520
.رغم هذا، هنالك شرطٌ واحد

55
00:04:58,610 --> 00:04:59,860
.ادخلا

56
00:04:59,860 --> 00:05:01,230
.المعذرة

57
00:05:03,070 --> 00:05:04,530
!هاتان الاثنتان

58
00:05:05,110 --> 00:05:07,320
.واثقٌ أنّك تعرفهما سلفًا

59
00:05:07,320 --> 00:05:09,240
.لكنهما العبقريّتان التي تفخر مدرستنا بهما

60
00:05:09,530 --> 00:05:11,120
فوروهاشي فومينو-كن

61
00:05:11,120 --> 00:05:12,870
.وأوغاتا ريزو-كن أيضًا

62
00:05:13,410 --> 00:05:15,040
،يويغا ناريوكي-كن

63
00:05:15,500 --> 00:05:18,540
،كشرطٍ لحصولك على توصية النّخبة المميّزة

64
00:05:19,000 --> 00:05:21,550
،آمرك أن تكون معلّمهما

65
00:05:21,550 --> 00:05:23,960
!وساعدهما لدخول جامعةٍ بتخصّصهما

66
00:05:25,760 --> 00:05:27,220
متنزّه كوسوموتو

67
00:05:29,430 --> 00:05:33,180
معلّم؟ هاتان الاثنتان؟ أنا؟ ماذا سأعلّمهما؟

68
00:05:33,600 --> 00:05:37,020
بعدّه أيضًا، كم بلغ عدد المعلّمين؟

69
00:05:37,730 --> 00:05:39,900
!بالطبع هي المرّة الأولى التي يكون فيها طالبٌ معلّمًا

70
00:05:39,900 --> 00:05:42,730
.لكنّني واثقةٌ أنّك كما باقي المعلّمين الآخرين

71
00:05:42,730 --> 00:05:45,360
.ستهجرنا وتدفع بنا لأحدٍ آخر

72
00:05:49,070 --> 00:05:51,830
لمَ تظهر عيني جروٍ تمّ التخلّي عنه؟

73
00:05:52,410 --> 00:05:54,620
.لن أهجركما أو أدفع بكما لأحدٍ آخر؟

74
00:05:54,620 --> 00:05:57,540
.ففي النهاية، توصية النخبةِ المميّزةِ على المحكِّ بالنسبة لي

75
00:05:57,960 --> 00:06:00,000
حقًّا؟ أليس هذا مطمئنًا يا ري-تشان؟

76
00:06:02,920 --> 00:06:04,510
ما خطب كلتيهما؟

77
00:06:05,170 --> 00:06:07,130
.بأيّة حال، أظنّنا سنباشر

78
00:06:07,510 --> 00:06:09,680
اسمحن لي أن أسألكما أوّلًا، ما التخصص الذي اخترتماه؟

79
00:06:09,930 --> 00:06:12,260
...لم أحصر خياري بتخصص بعد، لكن

80
00:06:12,760 --> 00:06:13,200
.الأدب

81
00:06:13,200 --> 00:06:13,930
.العلوم

82
00:06:14,270 --> 00:06:15,770
.جامعةٌ مرموقةٌ بهذا

83
00:06:16,930 --> 00:06:18,690
!العكس أيّتها الحمقاوتان

84
00:06:19,100 --> 00:06:19,850
لمَ؟

85
00:06:20,100 --> 00:06:22,650
ألا تعيان تحديد نقاط قوّتهما؟

86
00:06:23,480 --> 00:06:25,110
!هدّئ من روعك يا ناريوكي

87
00:06:25,360 --> 00:06:28,070
،إنّهما عبقريّتان، حتّى لو لم يكن في مجال خبرتهما

88
00:06:28,070 --> 00:06:30,110
!بوسعهما أن تبليا حسنًا بهذا أيضًا

89
00:06:32,660 --> 00:06:34,660
أبوسعكما أن تحلّا من هذه؟

90
00:06:35,080 --> 00:06:36,540
.أجل، لا أمانع

91
00:06:36,540 --> 00:06:38,620
!حسنًا، سأبذل جهدي

92
00:06:55,810 --> 00:06:57,520
!لست أفهم شيئًا إطلاقًا

93
00:06:58,560 --> 00:07:00,270
!السؤال بحدّ ذاته خاطئ

94
00:07:00,520 --> 00:07:02,350
"اشرح مشاعر بطل الرّواية"

95
00:07:02,350 --> 00:07:05,020
،كطلب فكّ رموز بنية الدّماغ كاملة

96
00:07:05,020 --> 00:07:07,440
!والتي لم يقدر العلم حتّى على حلّها بعد

97
00:07:08,400 --> 00:07:10,450
!كلّا، لا تنظر إليّ

98
00:07:10,700 --> 00:07:15,450
،حينما أرى صيغًا عدديّة فإنّ عقلي يغدو خاويًا فجأةً
!لذا لا ترمقني هكذا

99
00:07:15,990 --> 00:07:20,920
!أعلم أنّي أدنى من أدنى دودة

100
00:07:21,370 --> 00:07:23,540
...حسنًا، حسنًا، يويغا ناريوكي

101
00:07:23,920 --> 00:07:28,010
.الآن تعلم على الأقلّ لمَ أُمِرتَ أن تكون معلّمهما

102
00:07:28,590 --> 00:07:32,550
.المشكلة فقط هي تطوير نقاط ضعفهما

103
00:07:32,890 --> 00:07:35,220
.سنتوقّف عند هذا لهذا اليوم

104
00:07:36,430 --> 00:07:38,470
،سأعطي كلًّا منكما واجبًا

105
00:07:38,470 --> 00:07:39,810
.لذا أنهيا حلّه بحلول الغد

106
00:07:40,230 --> 00:07:42,350
!سأختبركما به بعد ذلك

107
00:07:42,770 --> 00:07:44,730
اليوم التّالي

108
00:07:47,690 --> 00:07:49,610
.إنّها البداية وحسب

109
00:07:49,860 --> 00:07:52,910
.سنركّز الليلة على ما أخطأتما فيه

110
00:07:53,160 --> 00:07:54,780
.وسأختبركما مجدّدًا غدًا

111
00:07:54,780 --> 00:07:56,410
بعد
عدّة أيّام

112
00:07:56,830 --> 00:07:59,750
،لا بأس، طالما أنّكما لم ترتكبا الأخطاء ذاتها,

113
00:07:59,750 --> 00:08:02,250
.فلا شكّ أنّ نتائجكما سترتفع

114
00:08:02,250 --> 00:08:03,870
أيّامٍ أخرى

115
00:08:02,250 --> 00:08:03,870
بعد عدّة

116
00:08:04,460 --> 00:08:07,460
درجةٌ واحدةٌ كلّ يومٍ هي تقدّم، صحيح؟

117
00:08:07,880 --> 00:08:09,840
أسبوع

118
00:08:07,880 --> 00:08:09,840
بعد مرور

119
00:08:10,340 --> 00:08:12,760
!لمَ تسوء درجاتكما؟ لست أفهم أبدًا

120
00:08:13,010 --> 00:08:15,590
!كنتما تخضعان لذات الاختبار يوميًّا لأسبوع

121
00:08:15,590 --> 00:08:17,470
!لست سوى برغوث ماء
!آسفة! آسفة

122
00:08:17,850 --> 00:08:20,180
.هنالك خطأ ما في هذا الاختبار

123
00:08:20,520 --> 00:08:25,650
لم أتصوّر أبدًا أنّ هاتين العبقريتين بهذا السوء
.في المواد التي تشكّل نقاط ضعفهما

124
00:08:25,940 --> 00:08:28,110
.بوسعي تصوّر سبب التخلّي عنهما بسرعة

125
00:08:28,400 --> 00:08:29,280
!صحيح

126
00:08:29,690 --> 00:08:32,700
.كلتاكما، تبادلا الدفترين اللذان تستخدمانهما

127
00:08:32,700 --> 00:08:34,160
الرياضيّات

128
00:08:32,700 --> 00:08:34,160
الأدب المعاصر
والتراث الأدبي

129
00:08:34,700 --> 00:08:37,660
.كلٌّ منكما خبيرة في المجال التي تودّ الأخرى دراسته

130
00:08:37,910 --> 00:08:40,490
لذا، لمَ لا تحاولان تدريس بعضكما بعضًا؟

131
00:08:41,750 --> 00:08:42,750
...هذا

132
00:08:42,750 --> 00:08:43,790
.مستحيل...

133
00:08:44,370 --> 00:08:45,040
لمَ؟

134
00:08:45,370 --> 00:08:48,000
.لا أعلم ما لا أعلمه

135
00:08:48,380 --> 00:08:49,840
!يا لهما من عبقريتين

136
00:08:52,010 --> 00:08:54,180
...أصغيا يا فوروهاشي وأوغاتا

137
00:08:54,760 --> 00:08:57,260
.من الأجدر بكما أن تخضعا لاختبارٍ في تخصّصكما

138
00:08:58,640 --> 00:08:59,890
.أكره قول هذا

139
00:08:59,890 --> 00:09:03,060
!بما أنّه الأوّل من أيلول، فمن الصعوبة المذاكرة الآن

140
00:09:03,350 --> 00:09:06,480
.إضافةً إلى أنّ كلًّا منكما موهوبةٌ بمجالها

141
00:09:06,730 --> 00:09:08,770
.سيكون من الأسهل لو استخدمتما النعمة التي أنعمتما بها

142
00:09:09,190 --> 00:09:09,980
!توقّعت

143
00:09:10,360 --> 00:09:12,610
ستقوم بالتخلّي عنّا، أليس كذلك؟

144
00:09:12,940 --> 00:09:14,740
.إن كانت لديّ موهبةٌ أم لم تكن

145
00:09:14,990 --> 00:09:18,410
!سئمت من استخدام النّاس لهذه الكلمة لتقرير مصير حياتي

146
00:09:20,990 --> 00:09:21,990
!ري-تشان

147
00:09:23,870 --> 00:09:25,660
!قلت أنّك لن تتخلّى عنّا

148
00:09:25,660 --> 00:09:26,460
...ماذا؟ لست

149
00:09:29,750 --> 00:09:33,010
.واثقةٌ رغم ذلك أنّ ما تقوله صحيح

150
00:09:33,420 --> 00:09:38,640
.هذا ما قاله آباؤنا والمدرّسون الآخرون أيضًا

151
00:09:39,550 --> 00:09:42,770
...لكن، ورغم ذلك فإنّنا

152
00:09:44,230 --> 00:09:45,390
.شكرًا لك على هذا الأسبوع

153
00:09:45,390 --> 00:09:47,350
!أنت، فوروهاشي، تمهّلي

154
00:09:56,030 --> 00:09:57,950
ما بالمقدور عمله؟

155
00:09:58,200 --> 00:09:59,660
،مهما فكّرت بالأمر

156
00:09:59,910 --> 00:10:02,950
.سيكون عليهما فقط تغيير رغبة تخصّصهما

157
00:10:03,540 --> 00:10:05,870
،وفي سبيل توصية النخبة المميّزة خاصّتي

158
00:10:06,120 --> 00:10:09,420
.حينما أعيد دفتريهما غدًا، سأحاول إقناعهما مجدّدًا

159
00:10:10,840 --> 00:10:14,760
.يبدو على كلي الدفترين كثرة الاستخدام

160
00:10:15,050 --> 00:10:16,880
أكتبتا عليهما أيضًا؟

161
00:10:23,260 --> 00:10:27,390
.دفتراهما ممتلئان بالملاحظات من الغلاف للغلاف

162
00:10:27,770 --> 00:10:30,400
.لكنّ الملاحظات ذاتها من غير قيمة

163
00:10:30,770 --> 00:10:34,730
.حاولت أوغاتا حلّ أسئلة اليابانيّة المعاصرة بالحساب

164
00:10:35,530 --> 00:10:37,490
لا أفهم هذا إطلاقًا
هذا محبط

165
00:10:37,490 --> 00:10:39,450
كيف بوسعنا فهم
مشاعر الشخصيّة الرّئيسيّة؟

166
00:10:41,990 --> 00:10:43,740
.إن كانت لديّ موهبةٌ أم لم تكن

167
00:10:43,990 --> 00:10:47,580
!سئمت من استخدام النّاس لهذه الكلمة لتقرير مصير حياتي

168
00:10:48,540 --> 00:10:52,040
...لكن، ورغم ذلك فإنّنا

169
00:10:54,460 --> 00:10:56,050
.أتمنّى لو لم أرَ هذا

170
00:10:56,550 --> 00:10:59,050
.إنّهما تودّان فعل هذا حقًّا

171
00:11:04,100 --> 00:11:05,850
!هذا محبطٌ يا أبي

172
00:11:06,100 --> 00:11:09,140
!حاولت جاهدًا، لكنّي لا زلت أفشل

173
00:11:09,390 --> 00:11:11,440
ماذا؟ أربعة أسئلةٍ صحيحة فقط؟

174
00:11:12,480 --> 00:11:13,860
.لا بأس بهذا

175
00:11:14,110 --> 00:11:15,940
.هذا يظهر أنّ لديك مجالًا كبيرًا للنموّ

176
00:11:16,440 --> 00:11:19,070
.إنّك أفضل ممّن بوسعه حلّها من البداية

177
00:11:19,610 --> 00:11:20,950
،أصغي يا ناريوكي

178
00:11:21,200 --> 00:11:24,200
.لا تنسَ فقط الإحباط الذي تشعر به الآن

179
00:11:24,580 --> 00:11:28,410
.فلتغدو رجلًا بوسعه استيعاب النّاس ممّن ليس بقدورهم فعل شيء

180
00:11:28,870 --> 00:11:30,830
،لأنّ الشخص الذي يفشل في شيء

181
00:11:30,830 --> 00:11:33,040
.يستوعب شعور عدم القدرة على القيام بشيء

182
00:11:35,420 --> 00:11:36,710
...أيّها الأب

183
00:11:38,880 --> 00:11:41,050
.دومًا ما نطقت بأكثر العبارات جنونًا

184
00:11:41,070 --> 00:11:46,080
ما من فائدةٍ منها حقًّا، صحيح؟

185
00:11:41,070 --> 00:11:46,080
تُدَرَّس العلوم والآدب في الفصول ذاتها
لكنّها في الواقع صفوفٌ مختلفة

186
00:11:50,350 --> 00:11:51,140
.آسف

187
00:11:51,560 --> 00:11:53,100
!نظرت لما بداخلهما

188
00:11:56,520 --> 00:12:00,360
.حسنًا، لقد تركناهما خلفنا، لذا نتحمّل جزءًا من اللوم أيضًا

189
00:12:01,200 --> 00:12:04,820
.لذا، إلّم يكن هنالك من شيءٍ آخرٍ، فسنمضي في سبيلنا

190
00:12:05,320 --> 00:12:07,370
!لا، تمهّلي، هناك ما عليّ قوله

191
00:12:07,660 --> 00:12:10,870
!ما من كلامٍ لأقوله لك، ولن تغيّر رأيي أيضًا

192
00:12:11,120 --> 00:12:13,460
!حتّى لو فشلت في الاختبار فلن أغيّر ما أودّ دراسته

193
00:12:13,790 --> 00:12:14,880
،رغم هذا

194
00:12:15,130 --> 00:12:18,380
.لربّما تفشلين عدّة مرّاتٍ تواليًا وتبذلين قصارى جهدك للا شيء

195
00:12:19,000 --> 00:12:20,670
أتحاول أن تخوض عراكًا؟

196
00:12:23,010 --> 00:12:25,390
.أجل، رغم هذا

197
00:12:26,640 --> 00:12:27,810
.فهمت

198
00:12:28,140 --> 00:12:29,180
.ظننت هذا

199
00:12:29,930 --> 00:12:30,930
،إن لم تشعرا هكذا

200
00:12:31,310 --> 00:12:33,480
.فسيكون كلّ هذا العمل الشاقّ هباءً

201
00:12:33,890 --> 00:12:34,980
دفتر ملحوظات؟

202
00:12:34,980 --> 00:12:36,440
لمَ هذا؟

203
00:12:40,320 --> 00:12:41,940
...إن لم يفلح هذا

204
00:12:41,940 --> 00:12:43,360
!الإجابة ضمن النصّ دومًا

205
00:12:43,740 --> 00:12:46,990
!هذا، لا يعقل، أملأت كلّ دفترٍ بنفسك

206
00:12:47,240 --> 00:12:50,240
أكتبت ملاحظات النصح هذه لأجلنا؟

207
00:12:50,490 --> 00:12:52,620
.حينما نظرت لدفتريكما اللذين تركتماهما البارحة

208
00:12:52,620 --> 00:12:56,250
.أخذت فكرةً جيّدةً عن المواضع التي تقعان فيها بالخطأ بسهولة

209
00:12:56,500 --> 00:12:57,330
...ما

210
00:12:57,590 --> 00:12:59,500
إذًا فقد أعددت هذه طوال الليل؟

211
00:12:59,750 --> 00:13:00,710
لكن لمَ؟

212
00:13:01,130 --> 00:13:04,680
،تذكّرت كم كان مؤلمًا عدم فهم شيء ما

213
00:13:05,130 --> 00:13:08,470
.معرفتي أنّي لست جيّدًا لكن إجبار نفسي عليها جعل فهمي لها أقلّ حتّى

214
00:13:09,220 --> 00:13:12,520
.قبل وقتٍ طويل، كنت سيّئًا في المدرسة على نحوٍ مضحك

215
00:13:13,020 --> 00:13:15,980
.لم تتحسّن درجاتي أبدًا مهما درست

216
00:13:16,350 --> 00:13:21,360
لذا أعلم يقينًا كم من المحبط لكلتيكما ألا تقدرا على الاستيعاب

217
00:13:21,940 --> 00:13:25,360
،عبقريًّا كنت أم لا، ما من طريقة لتكون سعيدًا

218
00:13:25,610 --> 00:13:27,990
حينما يكون هنالك ما ترغب بفعله ولا تقدر، صحيح؟...

219
00:13:28,240 --> 00:13:29,330
...لذا

220
00:13:30,280 --> 00:13:32,700
!سأجعلكما سعيدتين

221
00:13:32,950 --> 00:13:34,870
!لذا فلتثقا بي

222
00:13:40,500 --> 00:13:43,010
أتعترف بحبّك لكلتينا في آن واحد؟

223
00:13:43,260 --> 00:13:44,300
.إنّها قمّة الوضاعة

224
00:13:44,550 --> 00:13:47,130
.ظننتك عفيفًا أكثر من هذا

225
00:13:48,010 --> 00:13:51,890
.كلّا، كلّا، ما عنيته أنّكما لن تغيّرا رأيكما لذا فلنبذل جهدنا سويًّا

226
00:13:51,890 --> 00:13:54,600
!كنت سأقترح التوجّه للمكتبة الآن للعمل على الأساسيّات

227
00:13:54,980 --> 00:13:56,480
أهذا ما عنيته؟

228
00:13:59,400 --> 00:14:01,190
...عذرًا، لكن

229
00:14:02,270 --> 00:14:02,940
...شك

230
00:14:03,320 --> 00:14:04,490
.شكرًا لك

231
00:14:14,660 --> 00:14:18,750
.بينما تدرس كلتاهما، عليّ أن أنهي واجبي

232
00:14:19,580 --> 00:14:22,090
.ففي النّهاية سأحظى بتوصية النخبة المميّزة

233
00:14:22,500 --> 00:14:24,050
.لكنّ فرصة حدوث هذا ستقلّ إن تدهورت درجاتي

234
00:14:24,300 --> 00:14:25,920
.لانشغالي برفقتهما

235
00:14:29,390 --> 00:14:30,550
فوروهاشي؟

236
00:14:31,350 --> 00:14:32,600
!آسفة يا يويغا-كن

237
00:14:32,850 --> 00:14:35,270
!دومًا ما أشعر بالنّعاس عند النظر للصيغ الرّقميّة

238
00:14:35,850 --> 00:14:36,680
.أجل

239
00:14:36,930 --> 00:14:39,480
!رائحتها زكيّة !رائحتها زكيّة

240
00:14:40,310 --> 00:14:41,690
!هدّئ روعك يا يويغا ناريوكي

241
00:14:41,940 --> 00:14:44,110
!لا تفقد رباطة جأشك من رائحةٍ زكيّة

242
00:14:44,360 --> 00:14:45,090
...يويغا-سان

243
00:14:45,090 --> 00:14:45,610
أجل؟

244
00:14:46,030 --> 00:14:49,820
.آسفة، لكنّي لا أفهم مغزى هذا السؤال

245
00:14:50,320 --> 00:14:52,160
أيّ واحدٍ يا أوغاتا؟

246
00:14:52,410 --> 00:14:54,160
.السؤال الثّاني

247
00:14:56,160 --> 00:15:00,420
!أظنّها تعني أن تختاري من الإجابات التالية ما له نفس معنى ما تحته خطّ

248
00:15:00,620 --> 00:15:02,920
!لقد لامستني مباشرةً، لامستني مباشرةً

249
00:15:03,540 --> 00:15:07,840
عجبًا! لا تبدو بحالٍ جيّد يا يويغا-كن، هل أنت بخير؟

250
00:15:08,090 --> 00:15:09,050
ح- حقًّا؟

251
00:15:09,630 --> 00:15:10,930
،لربّما لديك حمّى

252
00:15:10,930 --> 00:15:12,050
!هذا قريب! قريب! قريب

253
00:15:12,970 --> 00:15:14,930
.بالفعل، تبدو لا واعيًا نوعًا ما

254
00:15:15,260 --> 00:15:16,890
!هذا لأنّك قريبةٌ جدًّا منّي

255
00:15:20,230 --> 00:15:25,690
!الحاجز النفسيّ لكوني معلّمهم أعلى ممّا تصوّرت

256
00:15:32,910 --> 00:15:35,120
.آسفة، عليّ الانصراف

257
00:15:35,660 --> 00:15:38,500
أعليك المساعدة في المطعم الليلة يا ري-تشان؟

258
00:15:38,500 --> 00:15:39,160
المطعم؟

259
00:15:39,790 --> 00:15:42,120
.لدى عائلة ري-تشان مطعم أودون

260
00:15:45,340 --> 00:15:46,590
،بالتفكير بهذا

261
00:15:46,840 --> 00:15:49,170
،عدا عن حقيقة كونهما عبقريتين

262
00:15:49,420 --> 00:15:51,010
.فلا أعلم عنهما شيئًا

263
00:15:55,100 --> 00:15:57,310
،رغم أنّك عملت معي حتّى هذا الوقت المتأخّر

264
00:15:57,720 --> 00:15:59,890
!مرّة أخرى لم أؤدي أفضل من دودة، اعذرني

265
00:15:59,890 --> 00:16:02,940
.حسنًا كما تعلمين، من الأفضل أن يكون هنالك مجالٌ للتطوّر

266
00:16:02,940 --> 00:16:05,400
.على أن تكوني قادرةً على الحلّ مباشرةً

267
00:16:05,860 --> 00:16:08,150
.أو كما زعم والدي

268
00:16:08,400 --> 00:16:11,110
!صحيح، إنّك تدرك ما يجب أن يقال يا يويغا-كن

269
00:16:11,360 --> 00:16:12,610
!كان هذا تعافيًا سريعًا

270
00:16:13,160 --> 00:16:15,030
!حسنًا، سأبذل جهدي

271
00:16:15,280 --> 00:16:16,580
.أجل، أجل

272
00:16:28,920 --> 00:16:30,840
أمن خطبٍ ما يا فوروهاشي؟

273
00:16:31,470 --> 00:16:32,970
!كلّا، آسفة

274
00:16:33,220 --> 00:16:34,430
!ما من خطب

275
00:16:34,680 --> 00:16:36,050
.حسنًا

276
00:16:41,730 --> 00:16:44,100
أتحبّين النّجوم؟

277
00:16:45,600 --> 00:16:46,900
...في الحقيقة

278
00:16:47,690 --> 00:16:48,570
.أجل

279
00:16:50,320 --> 00:16:54,740
.دومًا ما عشقت النّجوم مذ أن كنت طفلة

280
00:16:55,030 --> 00:16:56,740
،في الليالي التي تشعّ النجوم فيها جمالًا

281
00:16:56,740 --> 00:17:00,950
.أجد نفسي أنظر لنجمة أمّي الرّاحلة

282
00:17:06,920 --> 00:17:07,840
!آسفة

283
00:17:08,090 --> 00:17:11,010
!بدا هذا حماقةً منّي حقًّا

284
00:17:11,710 --> 00:17:16,430
...لكنّ هذه كانت بداية حلمي

285
00:17:17,260 --> 00:17:20,220
.أودّ لحياتي أن تكون مرتبطةً بالنّجوم

286
00:17:20,470 --> 00:17:24,560
لكن لتحقيق هذا، عليّ اجتياز اختبار العلوم، أليس كذلك؟

287
00:17:25,440 --> 00:17:26,400
،لذا

288
00:17:26,770 --> 00:17:29,440
.سأقهر أيّ ذرّة ضعفٍ لديّ

289
00:17:29,940 --> 00:17:32,610
!وأدرس جديًّا علم الفلك

290
00:17:34,360 --> 00:17:37,070
.آمل أن تجدي نجمة والدتك

291
00:17:39,330 --> 00:17:42,290
أليس هذا غريبًا رغم هذا؟
!انسى الأمر، انساه

292
00:17:42,290 --> 00:17:45,250
...الايمان بأمرٍ طفوليًّ بينما أنا في الثانويّة

293
00:17:45,250 --> 00:17:46,620
ما الخطأ في هذا؟

294
00:17:47,830 --> 00:17:51,630
.في الواقع، كنت حتّى وقتٍ قريبٍ أؤمن بشيء مشابه

295
00:17:52,130 --> 00:17:58,340
.حسنًا، بأيّة حال، سأساعدك لتحرزي تقدّمًا في العلوم

296
00:17:59,180 --> 00:18:00,680
...يويغا-كن

297
00:18:04,600 --> 00:18:06,640
!كان هذا وعدًا

298
00:18:12,400 --> 00:18:13,860
.لم يكن هذا متوقّعًا

299
00:18:14,190 --> 00:18:17,240
.لم أدرك أنّ فوروهاشي كانت واثقةً جدًّا حيال ما ترغب بفعله

300
00:18:18,240 --> 00:18:21,370
.لربّما لدى أوغاتا أسبابٌ مماثلة

301
00:18:21,700 --> 00:18:22,370
أوغاتا؟

302
00:18:24,200 --> 00:18:25,200
...يويغا-سان

303
00:18:25,700 --> 00:18:27,540
ما الذي تفعلينه؟

304
00:18:27,790 --> 00:18:29,420
...في هذا الوقت المتأخّر في الحديقة

305
00:18:29,830 --> 00:18:31,840
،آخذ استراحةً على طريق عودتي من الطلبيّة

306
00:18:32,090 --> 00:18:32,920
طلبيّة؟

307
00:18:32,920 --> 00:18:35,590
أودون أوغاتا

308
00:18:33,340 --> 00:18:35,590
!فهمت، مطعم الأودون

309
00:18:36,300 --> 00:18:38,050
ما الذي تفعلينه في استراحتك إذًا؟

310
00:18:38,930 --> 00:18:41,800
.لعبةٌ ورقٍ تتمّ بين حدود شخصين إلى عشرة

311
00:18:42,640 --> 00:18:43,640
.لوحدي

312
00:18:43,640 --> 00:18:44,810
!هذا وحدانيّ جدًّا

313
00:18:45,600 --> 00:18:48,940
،أحبّ في الواقع ألعاب الألواح وألعاب البطاقات

314
00:18:49,190 --> 00:18:51,610
،لكنّي لا أعرف عديدًا من النّاس ممّن لديهم اهتمام بها لذا

315
00:18:52,110 --> 00:18:53,480
.لست معتادًا عليها

316
00:18:53,730 --> 00:18:55,530
.لكن، بوسعنا لعب لعبة لاثنين

317
00:18:55,780 --> 00:18:57,070
.أخبريني بالقواعد

318
00:18:57,650 --> 00:19:00,530
يويغا-سان، أتنوي هزيمتي؟

319
00:19:00,820 --> 00:19:03,080
!يا له من كلامٍ غامرٍ بالثقة

320
00:19:03,780 --> 00:19:06,830
!يبدو أنّني في خضمّ معركة صعبة

321
00:19:10,500 --> 00:19:12,420
.ربحت عشرين مرّة تواليًا

322
00:19:13,290 --> 00:19:17,460
أوغاتا، أيصدف أنّك ضعيفة مطلقًا في هذه؟

323
00:19:19,180 --> 00:19:20,970
.أجل، تمامًا

324
00:19:21,340 --> 00:19:25,180
.لذا سألتك قبلًا إن كنت تنوي هزيمتي

325
00:19:25,430 --> 00:19:26,680
أعنيتها بهذا الشّكل؟

326
00:19:29,020 --> 00:19:34,150
.يبدو أنّي مهما حاولت لم أبلغ أرجحيّةً في الختام

327
00:19:34,770 --> 00:19:39,360
.أظنّ أنّي ضعيفةٌ في الألعاب التنافسيّة  وأيّ شيءٍ يكنّ للمشاعر الانسانيّة

328
00:19:40,280 --> 00:19:42,660
.لذا أودّ أن أفهم عن هذا أكثر

329
00:19:43,280 --> 00:19:47,910
!لذا أودّ أن أجتاز امتحان الأدب وأدرس علم النفس

330
00:19:48,200 --> 00:19:51,620
!ما هذا؟ لديها أيضًا إذًا ما تودّ تحقيقه

331
00:19:52,250 --> 00:19:57,960
.حسنًا، أيًا يكن، توقّفي عن لعب الورق في الحديقة لوحدك ليلًا

332
00:19:58,210 --> 00:20:00,800
.إن كانت هذه استراحتك فبوسعي مشاركتك في أيّ وقت

333
00:20:01,130 --> 00:20:01,800
أيّ وقت؟

334
00:20:02,180 --> 00:20:04,890
.حسنًا، عنيت أيّ وقتٍ بشكلٍ مجازي

335
00:20:05,140 --> 00:20:05,970
.كلًا

336
00:20:06,970 --> 00:20:09,730
.سأكون سعيدة إن كانت مرّة كلّ فترة

337
00:20:09,980 --> 00:20:11,480
!أتطلّع لذلك

338
00:20:11,940 --> 00:20:15,230
.أجل، أتطلّع لذلك

339
00:20:28,290 --> 00:20:29,160
!عدت

340
00:20:29,750 --> 00:20:31,120
!مرحبًا بعودتك يا أخي

341
00:20:31,370 --> 00:20:33,920
!وجدنا العديد من النباتات الصّالحة للأكل الليلة

342
00:20:34,750 --> 00:20:36,290
.عملٌ جيّد

343
00:20:36,790 --> 00:20:38,090
!مرحبًا بعودتك

344
00:20:39,550 --> 00:20:41,300
.تأخّرت الليلة

345
00:20:41,760 --> 00:20:43,760
.جهز العشاء تقريبًا

346
00:20:44,260 --> 00:20:46,760
!تفوح منك رائحة فتاةٍ يا أخي

347
00:20:49,930 --> 00:20:50,770
...تحديدًا

348
00:20:51,020 --> 00:20:51,730
!هنا

349
00:20:52,020 --> 00:20:53,480
!وهنا

350
00:20:54,770 --> 00:20:56,230
ما الذي تقولينه يا ميزوكي؟

351
00:20:58,110 --> 00:21:00,860
.وها قد بدأت عقدة الأخ لديها

352
00:21:00,860 --> 00:21:01,780
.أجل

353
00:21:09,790 --> 00:21:11,540
هل يويغا-سان هنا؟

354
00:21:12,040 --> 00:21:13,910
