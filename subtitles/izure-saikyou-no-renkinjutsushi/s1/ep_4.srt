1
00:00:05,430 --> 00:00:10,390
هناك أربعة كُتُب فقط عن الخيمياء
في مكتبة ضخمة كهذه

2
00:00:10,900 --> 00:00:15,240
لماذا انحسر الاهتمام بالخيمياء
رغم بساطة آليّة عملها؟

3
00:00:16,010 --> 00:00:16,870
مهلاً

4
00:00:17,270 --> 00:00:18,580
هكذا إذاً

5
00:00:18,580 --> 00:00:21,760
لأنّها تعتمد على كتابة حضارة سحريّة قديمة

6
00:00:23,440 --> 00:00:25,130
،بما أنّني خُلِقتُ من جديد في هذا العالم

7
00:00:25,130 --> 00:00:27,770
أنا قادر على فهم كافّة لغاتها

8
00:00:28,510 --> 00:00:30,850
غالباً هذا بفضل برَكة نولين-ساما

9
00:00:30,850 --> 00:00:33,090
لا بدّ أنّ هذا السّبب الّذي يجعلني
أرى الخيمياء بسيطة

10
00:00:34,520 --> 00:00:37,940
لا أعتقد بأنّني سأكون قادرة
على نسيان ذلك لبعض الوقت

11
00:00:37,940 --> 00:00:38,730
نسيان ماذا؟

12
00:00:38,730 --> 00:00:40,160
!كان ذلك جميلاً للغاية

13
00:00:40,160 --> 00:00:42,000
منظركما في الأمس

14
00:00:42,000 --> 00:00:43,940
ماذا؟ هل كنتِ تتفرّجين؟

15
00:00:43,940 --> 00:00:44,940
!أجل

16
00:00:44,940 --> 00:00:47,010
!كانت الرّؤية واضحة

17
00:00:47,390 --> 00:00:49,230
مولايّ، رائع للغاية

18
00:00:49,230 --> 00:00:51,760
!رؤية صوفيا بهذا الشّكل

19
00:00:52,310 --> 00:00:55,310
!كانت أشبه بفارس يقسم بحماية أميرة

20
00:00:55,310 --> 00:00:57,160
!كان ذلك فاتناً للغاية

21
00:00:57,160 --> 00:00:59,520
!هل هذا يجعلني أميرة إذاً؟

22
00:00:59,520 --> 00:01:01,340
مولايّ، ظريف للغاية

23
00:02:35,450 --> 00:02:38,610
صنعنا الكثير من هذه المراحيض، صحيح؟

24
00:02:38,610 --> 00:02:41,590
أجل، ينبغي أن أكون قادراً
على تلبية الطّلب اليوم

25
00:02:42,170 --> 00:02:45,730
والآن أعتقد بأنّني سآخذ استراحة
من صنع المراحيض

26
00:02:45,730 --> 00:02:49,360
إذاً سوف تنتج شيئاً آخر؟

27
00:02:51,700 --> 00:02:55,860
لكن أفكّر أيضاً في خوض رحلة
متى شعرتُ برغبة في ذلك

28
00:02:55,860 --> 00:02:57,790
رحلة؟

29
00:02:58,230 --> 00:03:01,130
أريد محاولة إيجاد المواد والوجبات
،الفريدة بالنّسبة لأماكن معيّنة

30
00:03:02,020 --> 00:03:04,580
،ورؤية المشاهد الفريدة، واستكشاف بعض الأطلال

31
00:03:04,580 --> 00:03:06,320
والاستمتاع في القيام بذلك

32
00:03:07,050 --> 00:03:10,670
،سأدع صوفيا ترافقني كحارسة شخصيّة

33
00:03:10,960 --> 00:03:14,760
لذا غالباً سأطلب منكِ الدّفاع
عن مقرّنا أثناء غيابنا

34
00:03:15,550 --> 00:03:16,780
وأنا؟

35
00:03:17,230 --> 00:03:19,960
.أنتِ حيوانتي الأليفة يا قيقب
لذا سوف تأتين معي

36
00:03:20,630 --> 00:03:22,020
...المعذرة

37
00:03:22,020 --> 00:03:25,980
،إذا قلتُ بأنّني أريد الذّهاب معك أيضاً
فهل سأشكّل مصدر إزعاج؟

38
00:03:25,980 --> 00:03:28,470
...ماذا؟ في الواقع

39
00:03:28,470 --> 00:03:33,670
أعتقد سيكون ذلك خطيراً، وأحتاج
—مساعدتكِ في منزلنا

40
00:03:33,670 --> 00:03:39,420
إنّ القيام بكلّ الأعمال المنزليّة بمفردي
...في القصر من دونك أو صوفيا أو قيقب

41
00:03:39,770 --> 00:03:45,070
سيكون هذا أشبه بترك مرحاض وحيداً
!ومعزولاً في صحراء حارقة

42
00:03:45,070 --> 00:03:49,150
!سأكون أدنى من ذلك حتّى

43
00:03:49,430 --> 00:03:52,130
لماذا تشمل كلُّ استعاراتها المراحيض؟

44
00:03:52,130 --> 00:03:53,850
،لكن الآن بعد أن فكّرتُ في الأمر

45
00:03:53,850 --> 00:03:57,350
سأكون قلقاً على ماريا إذا تركتُها
وحيدة في قصر كبير كهذا

46
00:04:03,250 --> 00:04:06,560
—عندما تنظر إليّ هذه النّظرة

47
00:04:06,940 --> 00:04:08,650
اعذريني لحظة رجاء

48
00:04:15,830 --> 00:04:16,570
ماذا؟

49
00:04:17,560 --> 00:04:20,360
تاكومي-ساما؟

50
00:04:20,360 --> 00:04:22,380
!هذه الإحصائيّات ليست سيّئة إطلاقاً

51
00:04:22,380 --> 00:04:25,740
!إنّها خادمة قتاليّة، قادرة على القتال

52
00:04:26,310 --> 00:04:28,780
إحصائيّاتك جيّدة بما يكفي

53
00:04:28,780 --> 00:04:31,120
لكن هل أنتِ متأكّدة من أنّكِ تريدين الذّهاب؟

54
00:04:31,120 --> 00:04:33,210
!أعي الخطورة تماماً

55
00:04:33,210 --> 00:04:36,410
تاكومي-ساما، أنا أيضاً أطلب أن تُرافقنا

56
00:04:36,790 --> 00:04:40,620
أعقد يمكنني تعليمها السّحر وكيفيّة القتال

57
00:04:40,620 --> 00:04:42,180
!صوفيا

58
00:04:42,180 --> 00:04:45,750
إذاً هلّا طلبتُ منكِ أن تتدرّبي
معي ومع صوفيا؟

59
00:04:45,750 --> 00:04:47,080
!تاكومي-ساما

60
00:04:49,660 --> 00:04:54,010
الآن بعد أن حُسِم الأمر أعتقد سأصنع
أسلحة ودرعاً لكما

61
00:04:54,620 --> 00:04:56,060
ما طبيعة الأسلحة الّتي تريدانها؟

62
00:04:56,060 --> 00:04:57,950
أريد سيفاً طويلاً

63
00:04:57,950 --> 00:05:01,020
ورمحاً بطول مترين ونصف

64
00:05:01,250 --> 00:05:02,650
،قوس طويل للمدى البعيد

65
00:05:02,650 --> 00:05:04,570
وأيضاً سكّين أو اثنين

66
00:05:03,090 --> 00:05:05,070
تطلب هذه الأشياء دون تردُّد

67
00:05:05,070 --> 00:05:06,740
كما هو مُتوقَّع من مُحاربة

68
00:05:06,740 --> 00:05:08,230
لا تحتاجين ترساً؟

69
00:05:08,470 --> 00:05:12,410
إن أمكن، أريد ترساً صغيراً لا يكون ثقيلاً

70
00:05:12,410 --> 00:05:14,880
ما نوع السّلاح الّذين تريدين استخدامه يا ماريا؟

71
00:05:14,880 --> 00:05:18,250
تدرّبتُ على السّيوف القصيرة
،في شركة مولان التّجاريّة

72
00:05:18,250 --> 00:05:21,080
لذا جوهريّاً أيّ سيف قصير أو سكّين
صغير ينبغي أن يفي بالغرض

73
00:05:21,080 --> 00:05:25,470
إذا كان هذا كلّ ما لديكِ، فسوف
تفتقرين لقوّة الهجوم أمام الوحوش

74
00:05:25,470 --> 00:05:26,830
هكذا إذاً

75
00:05:26,830 --> 00:05:28,270
ما رأيكِ برمح؟

76
00:05:28,270 --> 00:05:30,370
يمكنني تعليمكِ كيفيّة استخدام واحد

77
00:05:30,370 --> 00:05:32,610
!أجل! من فضلكِ

78
00:05:35,960 --> 00:05:38,760
سبائك من الفولاذ السّحريّ ينبغي
أن تؤدّي الغرض بالنّسبة للمواد

79
00:05:39,330 --> 00:05:44,350
في هذا العالم، يحتاج المعدن لما هو أكثر
من الصّلابة، وإلّا فلا جدوى من استعماله

80
00:05:47,310 --> 00:05:49,270
!أخفضي مركز الجاذبيّة

81
00:05:51,440 --> 00:05:53,150
!أنتِ لا تبسطين ذراعيكِ بما يكفي

82
00:05:53,580 --> 00:05:54,710
!هكذا

83
00:06:02,880 --> 00:06:05,930
هذا يستنزف المانا حقّاً

84
00:06:06,830 --> 00:06:08,880
،أضفتُ شكلَ جناح إلى تصميم رمح صوفيا

85
00:06:09,870 --> 00:06:13,500
وشكلاً ناريّاً لرمح ماريا

86
00:06:14,300 --> 00:06:18,730
والآن حان وقت إلقاء تعويذتَي
...تعزيز الهجوم والإصلاح الذّاتيّ

87
00:06:20,400 --> 00:06:21,730
!فننتهي

88
00:06:22,360 --> 00:06:24,690
،والآن حان دور السّيف القصير الخاصّ بماريا

89
00:06:25,020 --> 00:06:26,720
...لكن بما أنّها خادمة قتاليّة

90
00:06:27,520 --> 00:06:30,040
!تحتاج سكاكينَ في فخذيها

91
00:06:32,370 --> 00:06:36,320
!أحمق! أحمق

92
00:06:34,060 --> 00:06:36,320
أجل، أنا أحمق

93
00:06:38,040 --> 00:06:39,130
ما الخطب؟

94
00:06:39,130 --> 00:06:42,820
شعرتُ بقشعريرة في فخذي للتو

95
00:06:43,500 --> 00:06:45,960
...التّالي هو الدّرع

96
00:06:45,960 --> 00:06:48,820
لكن يجب أن أحصل على مقاساتهما

97
00:06:49,320 --> 00:06:53,120
ليس من اللّائق أن أسأل عن قياساتهما

98
00:06:56,240 --> 00:06:58,490
!لحسن الحظّ، أنا مستعدّ

99
00:06:59,310 --> 00:07:01,430
!دا-دا-دا-دان

100
00:07:02,260 --> 00:07:05,050
دُمية صوفيا وماريا؟

101
00:07:05,050 --> 00:07:08,710
!صنعتُهما بمساعدة التّقييم إي.أكس

102
00:07:12,920 --> 00:07:15,280
هـ-هذا فاضح

103
00:07:15,280 --> 00:07:17,670
صوفيا وماريا، كلتاهما فاضحتان؟

104
00:07:18,550 --> 00:07:21,400
قيقب، هل يمكنني الاعتماد عليكِ
في صنع حرير العنكبوت؟

105
00:07:21,400 --> 00:07:22,370
!حاضرة

106
00:07:22,860 --> 00:07:26,550
سأستخدم ذَبْل الخنزير البرّي المُدرّع
الضّخم وجلده من أجل المواد

107
00:07:26,550 --> 00:07:29,910
ثمّ سأضيف قطعة قماش مصنوعة
من خيوط قيقب

108
00:07:30,710 --> 00:07:32,140
...وبالنّسبة للتّصميم

109
00:07:32,530 --> 00:07:36,290
الوظائف مهمّة، لكن المظهر مهمّ
أيضاً، أليس كذلك؟

110
00:07:36,730 --> 00:07:40,530
...أنا أطبّق حقّي كسيّد لكما

111
00:07:41,380 --> 00:07:43,980
!وأدع ذوقي يخرج عن السّيطرة

112
00:07:48,990 --> 00:07:52,100
!تبدوان رائعتين

113
00:07:52,100 --> 00:07:55,010
كيف هو شعوركما وأنتما ترتديانه؟
هل القياس مناسب؟

114
00:07:55,010 --> 00:07:57,010
!إنّه مناسب بشكل مثاليّ

115
00:07:57,010 --> 00:07:59,470
أجل. أشعر وكأنّه تكيّف معي حالما ارتديتُه

116
00:07:59,470 --> 00:08:01,320
!من السّهل التحرّك به حقّاً

117
00:08:01,670 --> 00:08:05,540
كيف تمكّنت من حساب مقاسنا بهذه الجودة؟

118
00:08:05,540 --> 00:08:07,630
—استخدم دمية منكما

119
00:08:07,630 --> 00:08:11,710
،ويتمتّع بصِفات دفاعيّة جيّدة أيضاً
!بفضل حرير العنكبوت

120
00:08:11,710 --> 00:08:13,250
مـ-ماذا عن الأسلحة؟

121
00:08:15,410 --> 00:08:17,210
تبدو وكأنّها جزء من قبضتي

122
00:08:17,210 --> 00:08:20,430
أجل! يبدو وكأنّ الافتتان يعمل بصورة جيّدة

123
00:08:23,120 --> 00:08:24,510
!هذا مُلائم

124
00:08:24,510 --> 00:08:27,380
!ممتاز! منظر مُبهر

125
00:08:27,380 --> 00:08:28,920
!أجل، أنا أحمق

126
00:08:28,920 --> 00:08:30,740
!يمكنك أن تضحك

127
00:08:31,610 --> 00:08:33,220
شكراً جزيلاً لك

128
00:08:33,220 --> 00:08:35,440
!يمكنني العمل بجدّ بهذا

129
00:08:35,440 --> 00:08:38,120
جيّد، جيّد! أيضاً، خذا هذه

130
00:08:38,900 --> 00:08:40,430
خواتم؟

131
00:08:40,430 --> 00:08:43,420
ارتأيتُ بأنّها قد تؤدّي وظيفة
البؤرة لإلقاء السّحر

132
00:08:44,360 --> 00:08:46,200
إنّها مشبعة بالمانا

133
00:08:46,200 --> 00:08:48,490
...تاكومي-ساما، غمرتنا بفضلك

134
00:08:55,610 --> 00:08:59,990
بفضل ذلك، حصلتُ على سحر
الجليد وسحر البرق

135
00:08:59,990 --> 00:09:01,660
!شكراً جزيلاً لك

136
00:09:02,270 --> 00:09:03,530
!العفو

137
00:09:05,450 --> 00:09:08,380
شققنا طريقنا إلى نقابة المُغامرين

138
00:09:08,860 --> 00:09:10,400
،قبل خوض رحلة

139
00:09:10,400 --> 00:09:14,430
يجب تسجيل صوفيا وماريا في النّقابة

140
00:09:15,320 --> 00:09:18,560
تفضّلا بطاقة النّقابة خاصّتكما

141
00:09:18,560 --> 00:09:20,020
كلتاهما بتصنيف هـ

142
00:09:20,020 --> 00:09:21,630
شكراً جزيلاً لك

143
00:09:21,980 --> 00:09:25,840
حسناً، أرغب أيضاً في تسجيل أنفسنا كفريق

144
00:09:25,840 --> 00:09:28,840
...عُلِم. بالمناسبة يا تاكومي

145
00:09:28,840 --> 00:09:31,300
بخصوص الرّسالة الاعتياديّة الّتي
...أرسلناها قبل أيّام

146
00:09:31,300 --> 00:09:32,240
!أجل

147
00:09:32,240 --> 00:09:33,710
!المهام

148
00:09:33,710 --> 00:09:36,010
أتيتُ إلى هنا على أمل تولّي
هذا الأمر أيضاً

149
00:09:36,300 --> 00:09:37,330
عظيم

150
00:09:38,760 --> 00:09:43,210
أعتقد سنحاول حاليّاً تولّي مهمّتين
بتصنيف هـ و ج

151
00:09:43,720 --> 00:09:47,830
لكن يا تاكومي-ساما، لن تكسب أي نقطة
إذا فعلنا ذلك، صحيح؟

152
00:09:47,830 --> 00:09:49,050
لا مُشكلة

153
00:09:52,510 --> 00:09:54,640
أيّتها الآنستان

154
00:09:54,880 --> 00:09:59,600
يمكننا تعليمكما كيفيّة أداء العمل
بشكل أفضل ممّا يستطيع ضعيف

155
00:09:59,600 --> 00:10:02,440
جميعنا بتصنيف د

156
00:10:02,440 --> 00:10:05,320
نحن أكثر مصداقيّة من هذا الشّخص

157
00:10:05,320 --> 00:10:09,280
يا فتى، من الواضح أنّ لِسان حالهما
!يقول بأنّهما يُفضّلاننا

158
00:10:09,280 --> 00:10:11,930
...والآن، فلنبدأ

159
00:10:12,490 --> 00:10:14,010
ماذا؟

160
00:10:14,290 --> 00:10:17,930
هل تخل بأنّك تستطيع مُعارضتي؟

161
00:10:18,270 --> 00:10:19,330
...تاكومي-سا

162
00:10:20,600 --> 00:10:21,690
!أنا خائف

163
00:10:21,690 --> 00:10:23,940
!من الدّاخل، أنا خائف حقّاً

164
00:10:23,940 --> 00:10:25,010
...لكن

165
00:10:25,010 --> 00:10:28,650
!كلتاهما صديقتايّ العزيزتان

166
00:10:28,650 --> 00:10:32,300
أعتقد لن تفهم ما لم نُلقّن جسدك درساً قاسياً

167
00:10:32,300 --> 00:10:34,040
وقح وفظّ

168
00:10:34,610 --> 00:10:35,890
!ماذا؟

169
00:10:35,890 --> 00:10:40,570
أنتم لستُم كالأعضاء الثّلاثة من ناب
الأسد الّذين التقيتُ بهم من قبل

170
00:10:40,570 --> 00:10:41,910
!أيّها الوغد

171
00:10:44,500 --> 00:10:45,830
!ديبول؟! ماذا حدث؟

172
00:10:45,830 --> 00:10:47,440
!يدي

173
00:10:48,650 --> 00:10:50,360
!أيّها الحقير

174
00:10:50,690 --> 00:10:53,590
!ماذا تفعلون بالضّبط أيّها الأوغاد؟

175
00:10:56,580 --> 00:10:59,510
هل كان هذا من صنيعك؟

176
00:10:59,510 --> 00:11:01,110
...المعذرة

177
00:11:01,110 --> 00:11:03,470
!تاكومي-ساما لم يفعل شيئاً

178
00:11:03,470 --> 00:11:06,930
لم يفعل؟ لكن هذا الحارس جريح، أليس كذلك؟

179
00:11:07,470 --> 00:11:08,910
يا رئيس النّقابة

180
00:11:08,910 --> 00:11:12,640
لقد تشاجروا، وكان تاكومي واقفاً
هناك فحسب فتلقّى ضربة

181
00:11:13,730 --> 00:11:14,870
رئيس النّقابة؟

182
00:11:15,100 --> 00:11:19,560
هذا باراك، رئيس نقابة المُغامرين الحاليّ

183
00:11:19,950 --> 00:11:22,840
أنت، عالج هذا الوغد

184
00:11:24,300 --> 00:11:25,880
تعالوا معي

185
00:11:27,090 --> 00:11:28,700
حسناً، ماذا فعلت؟

186
00:11:28,700 --> 00:11:30,790
ماذا فعلتُ...؟

187
00:11:32,000 --> 00:11:34,110
هل يجب عليّ أنا أجيب؟

188
00:11:34,110 --> 00:11:36,230
نحن نحمي المعلومات الشّخصيّة

189
00:11:36,780 --> 00:11:39,990
،كانت هناك آثار ضعيفة لمانا

190
00:11:39,990 --> 00:11:41,760
كان سحراً إذاً؟

191
00:11:44,010 --> 00:11:45,970
،إذا كان يستطيع الشّعور بالآثار العالقة

192
00:11:45,970 --> 00:11:49,000
فلا بدّ أنّ مهارة السّحر الحسّي
خاصّته بمستوى مرتفع جدّاً

193
00:11:49,940 --> 00:11:51,930
أنا متفاجئ من أنّك لاحظت

194
00:11:51,930 --> 00:11:55,230
لكن لم ألقِ أي سحر على أولئك الرّجال

195
00:11:57,570 --> 00:12:03,710
سحبتُ بعضاً من الفحم من صندوق
أدواتي فحسب ودهنتُ جسدي العلويّ به

196
00:12:04,190 --> 00:12:06,470
كان مجرّد فحم حقّاً؟

197
00:12:06,470 --> 00:12:10,410
لا، ركّبتُه فأصبح ألماساً

198
00:12:10,800 --> 00:12:13,620
لا عجب في أنّه حطّم يده

199
00:12:13,620 --> 00:12:15,130
خيمياء؟

200
00:12:15,130 --> 00:12:16,170
أجل

201
00:12:16,170 --> 00:12:20,270
،تذكّرت... عندما أتيتَ أوّل مرّة إلى هنا
أردتَ الانضمام لنقابة خيمياء

202
00:12:20,270 --> 00:12:21,360
أجل

203
00:12:21,360 --> 00:12:23,530
لكن قلتَ بأنّه لا يوجد

204
00:12:23,880 --> 00:12:26,350
حسناً، فهمتُ الفحوى

205
00:12:26,710 --> 00:12:29,990
أنتما زميلتاه في الفريق، صحيح؟

206
00:12:31,050 --> 00:12:33,700
...بوجود نساء حسناوات معه

207
00:12:33,700 --> 00:12:39,020
رئيس النّقابة، أقترح أن نرقّيه
إلى التّصنيف د مباشرة

208
00:12:39,020 --> 00:12:40,150
بالفعل

209
00:12:40,150 --> 00:12:44,270
إذا فعلنا ذلك، فلن ترى الكثير من الأغبياء
أمثاله يعتدون عليك

210
00:12:44,270 --> 00:12:48,580
هذا ما تقوله، لكن كلتيهما قد سُجِّلتا للتوّ

211
00:12:48,580 --> 00:12:49,770
ما رأيك؟

212
00:12:49,770 --> 00:12:52,370
هل ستقبل ببعض المهام الّتي اخترتُها

213
00:12:52,370 --> 00:12:55,660
لمساعدتكم أنتم الثّلاثة على ترقية
تصنيفكم بسهولة أكبر؟

214
00:12:57,800 --> 00:13:00,060
أظنّه عرضاً جيّداً

215
00:13:00,060 --> 00:13:03,350
،سأخاطر بحياتي لحمايتك

216
00:13:03,680 --> 00:13:07,430
لكن أتّفق مع تحسين قدراتنا وتصنيفنا

217
00:13:07,430 --> 00:13:11,630
أريد أن أكون مفيدة لتاكومي-ساما
!في أسرع وقت ممكن أيضاً

218
00:13:12,730 --> 00:13:14,720
حسناً إذاً، لو سمحت

219
00:13:15,460 --> 00:13:16,600
حسناً. فلنبدأ

220
00:13:21,640 --> 00:13:24,370
كان هانس قد حضّر ثلاث مهام لنا

221
00:13:25,270 --> 00:13:27,060
،مهمّة لإبادة العفاريت

222
00:13:27,060 --> 00:13:28,920
،ومهمّة لإبادة الكوبولد

223
00:13:28,920 --> 00:13:31,530
ومهمّة لجمع أعشاب ماريل

224
00:13:31,530 --> 00:13:34,000
مولايّ، خلف الشُّجيرات

225
00:13:34,270 --> 00:13:35,960
أربعة من الغوبلن

226
00:13:36,440 --> 00:13:38,270
تقرير من كشّافتنا

227
00:13:38,270 --> 00:13:40,230
أربعة بين الشّجيرات أمامنا

228
00:13:40,230 --> 00:13:42,080
سأقتل اثنين منهم

229
00:13:48,270 --> 00:13:51,780
كانت كلّ المهام الثّلاثة إمّا بأيّ
تصنيف أو بتصنيف ج

230
00:13:55,930 --> 00:13:59,390
،كانت المُكافأة حوالي خمسة أو ستّة فضّيات
وهو ليس بمبلغ سيّئ

231
00:13:58,070 --> 00:14:00,890
حسناً، لنحصل على أحجارهم السّحريّة

232
00:14:01,480 --> 00:14:06,850
بغضّ النّظر عن ذلك، ألا نواجه الغوبلن
والكوبولد بأعداد كبيرة؟

233
00:14:07,430 --> 00:14:11,110
قتلنا بالفعل ما يكفي لإنجاز المهام
بثلاثة أضعاف، صحيح؟

234
00:14:11,680 --> 00:14:15,250
،يوجد غالباً مُعسكر متوسّط الحجم قريب

235
00:14:15,250 --> 00:14:17,780
وقد يتواجد قائد عسكريّ بينهم

236
00:14:18,260 --> 00:14:19,990
قائد غوبلن؟

237
00:14:20,290 --> 00:14:22,170
هذا وحش بتصنيف سي

238
00:14:22,170 --> 00:14:26,940
يُقال بأنّه يتطلّب ما لا يقلّ عن خمسة
فِرق بتصنيف د أو أعلى

239
00:14:26,940 --> 00:14:30,010
لإبادة مُعسكر يهيمن عليه هؤلاء

240
00:14:30,720 --> 00:14:33,620
أي ليس نحن، صحيح؟

241
00:14:33,620 --> 00:14:35,590
،إذا استخدمنا سحري الشّبحيّ

242
00:14:35,590 --> 00:14:37,480
،وسحرك العنصريّ

243
00:14:37,480 --> 00:14:39,770
وسحر الأرض الخاصّ بماريا

244
00:14:39,770 --> 00:14:42,680
لشنّ هجوم مناطقيّ في البداية
،لتقليص أعدادهم

245
00:14:43,620 --> 00:14:47,400
فأعتقد حينها بأنّ لدينا فُرصة قويّة
لإبادتهم من تلقاء أنفسنا

246
00:14:47,810 --> 00:14:49,260
إنّها جاهزة لفعل ذلك

247
00:14:49,260 --> 00:14:51,690
إنّها في وضع القتال

248
00:14:51,690 --> 00:14:53,300
!إبادة الحشرات

249
00:14:53,300 --> 00:14:54,490
!أنا جاهزة للانطلاق

250
00:14:54,490 --> 00:14:55,610
وهي أيضاً

251
00:14:55,870 --> 00:14:57,080
مولايّ

252
00:14:57,080 --> 00:14:58,380
ما الأمر يا قيقب؟

253
00:14:58,380 --> 00:14:59,690
هل تتألّمين؟

254
00:14:59,690 --> 00:15:02,330
أتطوّر... قريباً

255
00:15:02,660 --> 00:15:04,260
!تتطوّرين؟

256
00:15:04,260 --> 00:15:05,290
!الآن؟

257
00:15:05,290 --> 00:15:06,520
!حسناً

258
00:15:06,520 --> 00:15:08,840
!ادخلي هنا وارتاحي

259
00:15:10,790 --> 00:15:14,270
هل كان ذلك... بُعداً جيبيّاً؟

260
00:15:15,120 --> 00:15:16,120
أجل

261
00:15:16,120 --> 00:15:20,720
تمكّنتُ من صنعه حالما بلغ سحري
الزّمكانيّ المستوى 3

262
00:15:21,430 --> 00:15:25,340
لم نعُد نمتلك دعم قيقب، لذا
لا يوجد سوانا نحن الثّلاثة الآن

263
00:15:26,190 --> 00:15:27,430
هذا كثير

264
00:15:30,280 --> 00:15:31,940
يوجد ثلاثمئة أو أربعمئة

265
00:15:31,940 --> 00:15:35,110
المعذرة... هل يجب علينا القيام بهذا؟

266
00:15:35,420 --> 00:15:37,990
تأكّدتُ من العدد بشبح رياح

267
00:15:37,990 --> 00:15:41,460
لا يوجد أي بشر هناك، لذا سوف
نضربهم بالسّحر

268
00:15:46,180 --> 00:15:47,980
!السّيوف المُقسّاة الخاصّة بشبح الرّياح

269
00:15:47,980 --> 00:15:49,590
!كومة الصّخور

270
00:15:49,590 --> 00:15:51,220
!عاصفة النّار

271
00:16:00,020 --> 00:16:01,410
!هل نلنا منهم؟

272
00:16:01,410 --> 00:16:03,720
لا، ليس بعد

273
00:16:06,290 --> 00:16:08,740
هناك قائد عسكريّ غوبلن وفارس غوبلن

274
00:16:08,740 --> 00:16:10,020
!كلاهما نوعان مُتقدِّمان

275
00:16:20,700 --> 00:16:22,690
!ها أنا ذا

276
00:16:29,650 --> 00:16:31,910
أنجزتموها كلّها في نصف يوم؟

277
00:16:31,910 --> 00:16:32,860
أجل

278
00:16:33,250 --> 00:16:35,970
أنجزنا كافّة المهام

279
00:16:36,830 --> 00:16:39,750
هلّا رافقتني إلى الخلف قليلاً؟

280
00:16:39,750 --> 00:16:41,760
سأذهب لاستدعاء رئيس النّقابة

281
00:16:44,370 --> 00:16:46,510
!مهلاً لحظة

282
00:16:46,510 --> 00:16:50,950
يتطلّب هذا فرقة إبادة ذات أعضاء
بتصنيف د أو أعلى

283
00:16:50,950 --> 00:16:53,800
أجل، هذا ما سمعتُه

284
00:16:53,800 --> 00:16:55,790
!سمعته"؟"

285
00:16:56,190 --> 00:16:57,850
!اسمع يا هذا

286
00:16:59,450 --> 00:17:01,130
آسفة على التأخُّر

287
00:17:02,290 --> 00:17:04,600
!قيقب قد وُلِدت من جديد

288
00:17:05,410 --> 00:17:06,620
!قيقب؟

289
00:17:06,620 --> 00:17:08,000
أراكني؟

290
00:17:08,000 --> 00:17:11,120
!يا إلهي! قيقب! أصبحتِ أظرف

291
00:17:11,340 --> 00:17:13,900
!ماريا! أردتُ التكلّم معكِ

292
00:17:13,900 --> 00:17:16,840
!يا للرّوعة! يمكنكِ التكلّم الآن أيضاً؟

293
00:17:17,170 --> 00:17:18,860
انسوا الأمر

294
00:17:18,860 --> 00:17:21,850
أنتم مُذهلون

295
00:17:21,850 --> 00:17:24,490
سأذهب لتحضير مُكافأتكم

296
00:17:24,490 --> 00:17:27,280
،وأيضاً ترقّى تاكومي إلى التّصنيف ي

297
00:17:27,280 --> 00:17:30,600
وكلّاً من صوفيا وماريا ترقّتا إلى التّصنيف ف

298
00:17:31,550 --> 00:17:34,740
تاكومي-ساما، هل لي بلحظة؟

299
00:17:34,740 --> 00:17:36,050
ما الأمر؟

300
00:17:36,370 --> 00:17:40,900
،المعذرة، إن كانت لديك أي بقايا قماش
فآمل أن تعطيني إيّاها

301
00:17:40,900 --> 00:17:43,690
—قماش؟ إذا أردتِ قماشاً، فاطلبي من قيقب

302
00:17:43,690 --> 00:17:44,760
!مُحال

303
00:17:44,760 --> 00:17:48,830
،خيوط وقماش قيقب عالي الجودة
لذا سيكون هذا إسرافاً

304
00:17:48,830 --> 00:17:50,220
ما الغرض من استخدامها؟

305
00:17:50,220 --> 00:17:51,410
...في الواقع

306
00:17:51,410 --> 00:17:54,360
كنتُ سأصنع ملابس داخليّة لي ولصوفيا

307
00:17:54,360 --> 00:17:55,380
...دا

308
00:17:55,380 --> 00:17:57,930
ألن يكون من الصّعب صنعها بمجرّد بقايا؟

309
00:17:57,930 --> 00:17:59,620
لا، ليس كذلك

310
00:17:59,620 --> 00:18:01,880
نعمل على تخييط القِطع معاً

311
00:18:03,410 --> 00:18:04,860
هكذا

312
00:18:05,160 --> 00:18:05,870
!ماذا؟

313
00:18:05,870 --> 00:18:08,560
!لا، اللّباس الدّاخليّ هو هكذا، صحيح؟

314
00:18:13,180 --> 00:18:16,200
هل ينبغي أن أحاول صنع طقم لكما؟

315
00:18:17,360 --> 00:18:20,650
!أنا آسف! أسحب كلامي

316
00:18:20,650 --> 00:18:22,770
!من فضلك افعل

317
00:18:22,770 --> 00:18:24,420
!حـ-حسناً

318
00:18:25,030 --> 00:18:27,160
مولايّ، جاء بابيك

319
00:18:27,590 --> 00:18:28,910
بابيك؟

320
00:18:31,280 --> 00:18:33,730
لماذا هو غائب عن الوعي؟

321
00:18:33,730 --> 00:18:37,050
،غاب عن الوعي عندما رآني
لذا حملتُه إلى هنا

322
00:18:37,050 --> 00:18:39,760
إذاً انصدم بتطوّركِ

323
00:18:41,370 --> 00:18:45,280
جاء بابيك ومعه طلب

324
00:18:45,280 --> 00:18:49,330
.من حاكم بولتون، ماركيز غودوين
أراد أن يلتقي بي

325
00:18:50,220 --> 00:18:53,180
!لـ-لماذا يريد الحاكم رؤيتي؟

326
00:18:53,180 --> 00:18:56,650
أعتقد يتعلّق الأمر بأدوات التّطهير السّحريّة

327
00:18:57,250 --> 00:18:58,930
المراحيض؟

328
00:18:58,930 --> 00:19:03,110
بالمناسبة، ذكرتَ سابقاً بأنّ لديك
معلومات عن بعض الدّعم

329
00:19:03,110 --> 00:19:05,950
الّذي سيمنع التدخُّل من إمبراطوريّة
سيدونيا المُقدّسة

330
00:19:06,680 --> 00:19:08,080
...لكن كان ذلك

331
00:19:08,380 --> 00:19:13,280
أجل، الحاكم. فخامته، الماركيز غودوين بولتون

332
00:19:13,590 --> 00:19:17,370
ما كنتُ لأرفض، نظراً إلى وضعي أنا وبابيك

333
00:19:19,310 --> 00:19:24,500
سيّد إيروما، الأداة السّحريّة الّتي صنعتَها
لتطهير النّفايات فعّالة جدّاً

334
00:19:24,500 --> 00:19:27,550
،بفضلك، تحسّن تعقيم المدينة

335
00:19:27,550 --> 00:19:29,510
ممّا ساعدنا على منع تفشّي الأمراض

336
00:19:29,510 --> 00:19:32,750
نحن مَدينون لك بالكثير

337
00:19:33,940 --> 00:19:35,250
أنا ممتنّ لك

338
00:19:35,970 --> 00:19:39,660
من فضلك. ليس عليك أن تنحني لي

339
00:19:39,940 --> 00:19:45,360
،لِمَ لا؟ إذا كان الانحناء سيُحسّن منطقتي
فسأنحني قدر ما يلزم ذلك

340
00:19:45,360 --> 00:19:47,300
يبدو حاكماً جيّداً

341
00:19:45,990 --> 00:19:48,330
أبدتَ أيضاً مُعسكر الغوبلن

342
00:19:48,910 --> 00:19:53,790
أشكرك ثانية على التّعامل مع شيء
كان فُرساني قد أهملوه

343
00:19:54,010 --> 00:19:56,990
لا، كنّا نؤدّي مهمّتنا الّتي كلّفتنا
بها النّقابة فحسب

344
00:19:56,990 --> 00:20:00,100
في العادة كان هذا ليكون عمل فُرساني

345
00:20:00,100 --> 00:20:02,610
قائد الفُرسان ممتنّ لك أيضاً

346
00:20:02,610 --> 00:20:03,800
سيّد إيروما

347
00:20:03,800 --> 00:20:07,660
أريدك أن تضع لنفسك الأولويّة من الآن فصاعداً

348
00:20:07,660 --> 00:20:09,220
،إذا أصابك مكروه

349
00:20:09,220 --> 00:20:13,660
فستكون تلك خسارة كبيرة لبلاد بولتون
وكذلك مملكتنا بأكملها

350
00:20:14,030 --> 00:20:15,470
أعتقد أنت تعطيني أكبر من حجمي

351
00:20:15,470 --> 00:20:20,360
يجب ألّا ترخي دفاعك، ولا سيّما
حالما تبدأ إمبراطوريّة

352
00:20:20,360 --> 00:20:21,940
سيدونيا المُقدّسة باستهدافك

353
00:20:24,740 --> 00:20:26,590
أنا مُرهَق نفسيّاً

354
00:20:27,150 --> 00:20:28,270
مولايّ

355
00:20:28,270 --> 00:20:29,780
أنهيتُهم

356
00:20:29,780 --> 00:20:33,250
ما الّذي كنتُ أحاول صنعه ثانية؟

357
00:20:34,420 --> 00:20:35,920
ملابس داخليّة

358
00:20:36,620 --> 00:20:38,540
ملابس داخليّة نسائيّة

359
00:20:38,800 --> 00:20:42,680
مولايّ، تبدو أكثر حزماً الآن ممّا كنت
عندما قاتلت القائد العسكريّ الغوبلن

360
00:20:43,110 --> 00:20:44,220
!شكراً لكِ

361
00:20:45,660 --> 00:20:50,520
...أخيراً... أصبحت... جاهزة

362
00:20:50,520 --> 00:20:52,790
...المعذرة يا تاكومي-ساما

363
00:20:52,790 --> 00:20:56,990
كنتَ مُنعزلاً في ورشتك لثلاثة أيّام
متتالية تصنع هذا اللّباس الداخليّ، صحيح؟

364
00:20:56,990 --> 00:20:58,190
هذا صحيح

365
00:20:58,580 --> 00:20:59,470
...رغم ذلك

366
00:20:59,470 --> 00:21:02,160
يبدو أنّك أرهقت نفسك تماماً

367
00:21:02,780 --> 00:21:04,480
إنّها جميلة للغاية

368
00:21:04,480 --> 00:21:06,100
!أجل! إنّها ظريفة جدّاً

369
00:21:06,640 --> 00:21:08,080
أتريدان تجربتها؟

370
00:21:10,650 --> 00:21:13,600
!لا! كان ذلك غير لائق منّي! أنا آسف

371
00:21:13,600 --> 00:21:16,680
هل... ستكون سعيداً إذا ارتدينا
هذا يا تاكومي-ساما؟

372
00:21:16,680 --> 00:21:17,550
ماذا؟

373
00:21:17,550 --> 00:21:20,520
إذا كان هذا سيُسعدك، فسوف أرتديها

374
00:21:22,680 --> 00:21:24,650
!مُحال أن أكون كذلك

375
00:21:25,580 --> 00:21:28,980
تاكومي-ساما جبان، أليس كذلك؟

376
00:21:28,980 --> 00:21:30,940
ماريا، هذه وقاحة

377
00:21:30,940 --> 00:21:33,350
ما رأيكِ إذاً يا صوفيا؟

378
00:21:34,010 --> 00:21:35,470
...غير شُجاع

379
00:21:36,610 --> 00:21:38,450
!تحمّل! اصبر

380
00:21:38,800 --> 00:21:40,120
!ما هذا؟

381
00:21:40,120 --> 00:21:42,590
!أشعر وكأنّ كلّ شيء فوضويّ

382
00:21:42,910 --> 00:21:49,310
ربّما هذه دلالة على أنّ جزءاً من برَكة
!نولين-ساما بدأ يتفكّك

383
00:21:49,310 --> 00:21:51,400
!يعتمد كلّ شيء عليّ الآن

384
00:21:51,400 --> 00:21:53,860
لا، لا علاقة لهذا بالأمر

385
00:21:54,950 --> 00:21:56,360
!صحيح

386
00:21:56,360 --> 00:21:57,840
يمكنني تجربتهم بنفسي

387
00:21:57,840 --> 00:22:01,290
!لا! ما الّذي أفكّر فيه حتّى؟

388
00:22:01,840 --> 00:22:03,540
تريد تجربتهم، أليس كذلك؟

389
00:22:03,540 --> 00:22:05,250
!لا، لا، لا

390
00:22:07,360 --> 00:22:09,210
...تاكومي