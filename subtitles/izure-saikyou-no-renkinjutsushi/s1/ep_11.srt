1
00:00:19,260 --> 00:00:22,420
أنا متفاجئة من بلوغهم مُستوى
مُغامرين برتبة أ

2
00:00:22,770 --> 00:00:25,520
بعد ثلاثة أشهر من استدعائهم إلى سيدونيا

3
00:00:25,990 --> 00:00:29,980
غالباً ستبدأ سيدونيا بتحرّكها التّالي قريباً

4
00:00:37,350 --> 00:00:40,370
ابتهجوا يا أبطالنا

5
00:00:40,730 --> 00:00:45,480
حان الوقت لنُعرّف دُول القارّة عليكم

6
00:00:45,820 --> 00:00:47,730
ماذا؟ أخيراً

7
00:00:47,730 --> 00:00:49,360
تأخّر ذلك قليلاً، أليس كذلك؟

8
00:00:49,360 --> 00:00:50,510
نحن الأبطال، صحيح؟

9
00:00:50,510 --> 00:00:52,390
مَن سيُنقذ العالم؟

10
00:00:52,390 --> 00:00:57,560
هذا سبب آخر يدفعنا للانتظار قبل
تعريف الدُّول الأخرى عليكم

11
00:00:57,950 --> 00:00:59,590
الآن هو الوقت المناسب

12
00:00:59,860 --> 00:01:01,250
دعي الأمر لنا

13
00:01:01,250 --> 00:01:05,820
سوف نتباهى ونثبت بأنّنا أبطال
!إمبراطوريّة سيدونيا المُقدّسة

14
00:01:06,400 --> 00:01:07,940
ما الأمر يا أكاني؟

15
00:01:07,940 --> 00:01:09,960
لا تبدين مُنخرطة في الأمر

16
00:01:09,960 --> 00:01:11,410
هذا مُحال

17
00:01:11,410 --> 00:01:14,160
...إنّ زيارة كلّ دولة كأبطال

18
00:01:14,160 --> 00:01:15,880
مُذهلة بحقّ

19
00:01:16,160 --> 00:01:19,210
إذاً سوف تُرافقين الآخرَين؟

20
00:01:19,590 --> 00:01:20,960
بكلّ سرور

21
00:02:52,600 --> 00:02:56,990
القرية الّتي بنيناها في الحدود قُرب بولتون

22
00:02:56,990 --> 00:03:00,240
سُمِّيَتْ ويدجفورت بواسطة الحاكم

23
00:03:00,240 --> 00:03:03,610
بُني الطّريق إلى بولتون بإتقان، وكُل
من التُجّار الرحّالة من بولتون

24
00:03:03,610 --> 00:03:06,750
والجنود المُتمركزون هنا قد سلكوه

25
00:03:07,740 --> 00:03:11,660
القرويّون الّذين يعيشون هنا يتعلّمون
من حِرَفيّي بولتون

26
00:03:11,660 --> 00:03:13,170
بينما ينشئون منازلهم

27
00:03:13,470 --> 00:03:15,190
ويبدؤون بالحِدادة

28
00:03:15,620 --> 00:03:20,080
المحاصيل تنمو بثبات. وبدأتْ
تُشبه بلدة حقيقيّة

29
00:03:21,240 --> 00:03:24,970
يبدو أنّ القرويّين يعيشون حياة مُرضية أيضاً

30
00:03:32,940 --> 00:03:35,330
!صوفيا، انظري إلى هذا

31
00:03:37,110 --> 00:03:39,700
!إنّه وحشٌ لم أره من قبل

32
00:03:40,260 --> 00:03:41,860
سحليّة شُجيرات؟

33
00:03:42,270 --> 00:03:43,930
هؤلاء الوحوش هنا أيضاً؟

34
00:03:45,630 --> 00:03:48,590
يبدو أنّ قوّة الوحوش تتزايد

35
00:03:49,440 --> 00:03:51,430
يزدادون قوّة؟

36
00:03:51,430 --> 00:03:54,330
هل ينبغي أن أساهم في إبادة
الوحوش أيضاً؟

37
00:03:54,330 --> 00:03:56,170
!سأنضمّ لكِ

38
00:03:56,170 --> 00:04:00,110
لا، إنّهم ليسوا أقوياء بما يكفي
لأواجه صعوبة أمامهم

39
00:04:00,500 --> 00:04:04,260
،كلّ ما في الأمر أنّهم يزدادون قوّة
مهما كان ذلك طفيفاً

40
00:04:04,610 --> 00:04:08,600
وأيضاً، نواجه وحوشاً لم نرهم من قبل

41
00:04:08,600 --> 00:04:10,930
كالسّحلية الّتي رأيناها اليوم؟

42
00:04:10,930 --> 00:04:16,340
أعتقد بأنّ وحوشاً من مناطق قريبة
بدأتْ بالتحرُّك نحونا

43
00:04:16,780 --> 00:04:18,730
لماذا يفعلون ذلك فجأة؟

44
00:04:18,730 --> 00:04:20,560
،لا أملك أي دليل

45
00:04:20,860 --> 00:04:25,320
لكن أعتقد بأنّ تقلُّباً غير عاديّ للمانا
شعرنا به قبل ثلاثة أشهر هو السّبب

46
00:04:25,320 --> 00:04:31,020
على الأقلّ، أعتقد يمكننا أن نفترض
بأنّ كان له تأثير ما على الوحوش

47
00:04:32,020 --> 00:04:35,440
،إذا كان ما قالته نولين-ساما صحيحاً

48
00:04:35,440 --> 00:04:38,220
فإذاً كان ذلك استدعاء البطل

49
00:04:41,050 --> 00:04:44,830
طلبَ باراك عودتك

50
00:04:44,830 --> 00:04:46,180
لديه مهمّة لأجلك

51
00:04:46,920 --> 00:04:48,120
عُلِم

52
00:04:48,580 --> 00:04:50,960
هل تغيّر أيّ شيء في بولتون؟

53
00:04:51,280 --> 00:04:52,930
لا شيء جديد

54
00:04:52,930 --> 00:04:54,810
لكن هناك إشاعة تنتقل من شخص إلى آخر

55
00:04:55,120 --> 00:04:56,150
إشاعة؟

56
00:04:56,620 --> 00:04:59,720
بأنّ الأبطال ظهروا في إمبراطوريّة
سيدونيا المُقدّسة

57
00:04:59,720 --> 00:05:01,660
!الأبطال في سيدونيا؟

58
00:05:01,660 --> 00:05:04,770
كان ذلك قبل حوالي ثلاثة أشهر، صحيح؟

59
00:05:05,840 --> 00:05:07,120
كيف عرفت ذلك؟

60
00:05:07,780 --> 00:05:10,570
...إذاً ذلك التقلُّب في المانا

61
00:05:14,260 --> 00:05:19,550
ماذا يعني إذا تمّ اختيار ظهور
الأبطال في سيدونيا؟

62
00:05:20,080 --> 00:05:22,260
قد يكون نذيراً جيّداً

63
00:05:22,550 --> 00:05:29,140
لعلّ الإلَهة أرسلَتْهم لتصحيح
سياسة سيدونيا الخاطئة

64
00:05:31,010 --> 00:05:32,430
لم تفعل

65
00:05:32,430 --> 00:05:34,540
لم يتمّ اختيار سيدونيا

66
00:05:35,810 --> 00:05:39,290
استخدموا سحراً مُحرَّماً واستدعوا
الأبطال بأنفسهم

67
00:05:40,330 --> 00:05:44,210
آمل أن يكون الّذين تمّ استدعاؤهم جيّدين

68
00:05:44,210 --> 00:05:48,010
يُصحّحون مسار سيدونيا كما اقترحتْ ماريا

69
00:05:54,020 --> 00:05:57,260
!نعتمد عليكم يا أبطال

70
00:05:57,260 --> 00:05:59,920
!عسى أن تحظوا ببركات آنات

71
00:05:59,920 --> 00:06:04,340
!والآن لنُرِ العالم من نكون

72
00:06:05,940 --> 00:06:08,760
أنتِ. هل ستذهب هذه معنا أيضاً؟

73
00:06:08,760 --> 00:06:10,380
—ا-المعذرة

74
00:06:10,380 --> 00:06:12,860
!إيّاكِ والتكلُّم معي

75
00:06:12,860 --> 00:06:14,720
لولو هي مُرافقتي

76
00:06:14,720 --> 00:06:17,910
ماذا؟ تقولين "مُرافِقة"، لكنّها عبدة، أليس كذلك؟

77
00:06:18,310 --> 00:06:21,000
مهلاً، مهلاً، ما أهمّية ذلك؟

78
00:06:21,000 --> 00:06:23,440
أنتِ لطيفة جدّاً يا أكاني

79
00:06:24,280 --> 00:06:25,880
هيّا يا لولو

80
00:06:31,410 --> 00:06:33,920
عسى أن تحظوا ببركات آنات

81
00:06:38,960 --> 00:06:41,350
...بخصوص أبطال سيدونيا

82
00:06:42,030 --> 00:06:44,430
،سمعنا أنّ هناك شابّين وامرأة صغيرة

83
00:06:44,430 --> 00:06:47,420
،جميعهم بشعر أسود وعينين سوداوتين
ليصبحوا ثلاثة بالمُجمل

84
00:06:47,420 --> 00:06:49,570
شعر أسود وعينان سوداوتان؟

85
00:06:50,270 --> 00:06:53,710
يبدو أنّهم يأخذون الأبطال في جولة
إلى كنائس النُّور المُقدّس

86
00:06:50,610 --> 00:06:51,650
مستحيل

87
00:06:51,650 --> 00:06:55,170
هل الّذين تمّ استدعاؤهم يابانيّون مثلي؟

88
00:06:53,710 --> 00:06:56,500
في مملكة روماليا ومملكة باركولا

89
00:06:56,500 --> 00:06:57,790
الكنائس؟

90
00:06:58,260 --> 00:07:01,190
،حسناً، تُفيد الإشاعات بأنّهم غير مُزيّفين

91
00:07:01,190 --> 00:07:04,310
إنّ تقديمهم للكنائس ليس إلّا
غطاء وهُم في الواقع

92
00:07:04,310 --> 00:07:08,490
يستهدفون دُولاً تحتوي على كثير من مُؤمني
كنيسة الخَلق، ممّا يُشكّل ضغطاً صامتاً

93
00:07:08,880 --> 00:07:10,570
لكن لندخل صلب الموضوع

94
00:07:10,570 --> 00:07:13,320
طلبتْ شركةُ بابيك حأن تحرسها أجنحة نولين

95
00:07:13,320 --> 00:07:16,080
وتُرافقها إلى العاصمة الملكيّة

96
00:07:16,380 --> 00:07:20,110
،إذا كانت شركة بابيك قد طلبَتْنا
فلا يمكننا الرّفض

97
00:07:21,470 --> 00:07:24,890
هل تمانعون أن تأخذوني معكم كذلك؟

98
00:07:25,280 --> 00:07:26,840
معنا؟

99
00:07:26,840 --> 00:07:31,540
،لا يوجد ما يضمن سلامة المهمّة
باعتبارها مهمّة مُرافقة

100
00:07:31,540 --> 00:07:32,910
لا ينبغي أن نستعجل كثيراً

101
00:07:33,490 --> 00:07:38,320
إنّ البقاء بمفردي في هذا القصر
...بينما تُغادرون جميعاً

102
00:07:38,320 --> 00:07:39,890
سيُشعرني بالوحشة...

103
00:07:40,380 --> 00:07:41,890
سيكون كذلك، أجل

104
00:07:42,150 --> 00:07:43,180
ماريا؟

105
00:07:43,850 --> 00:07:48,240
إنّ إبقاءها وحيدة بعد المجيء إلى قصرنا
،للمرّة الأولى اليوم

106
00:07:48,240 --> 00:07:51,320
هو الطّلب العجول للغاية

107
00:07:51,320 --> 00:07:53,860
أُقدّر مشاعر ماني أيضاً

108
00:07:58,170 --> 00:08:01,430
أستطيع استخدام سحر الأرض كذلك

109
00:08:02,050 --> 00:08:06,330
مـ-من فضلكِ لا تنظري إلىّ
بعينين دامعتين كهاتين

110
00:08:06,730 --> 00:08:08,050
حسناً

111
00:08:08,050 --> 00:08:11,790
في هذه الحالة يا ماني، سأطلب منكِ
العمل إمّا مع ماريا أو ريفا

112
00:08:11,790 --> 00:08:14,040
إذاً سوف تأخذني معكم؟

113
00:08:14,040 --> 00:08:16,520
لنُسجّلكِ في النّقابة غداً

114
00:08:16,520 --> 00:08:18,150
!شكراً جزيلاً لك

115
00:08:20,710 --> 00:08:24,810
تبّاً! ألا يمكن فعل شيء
بشأن هذا الاهتزاز؟

116
00:08:24,810 --> 00:08:27,030
كإضافة عازل صدمات

117
00:08:27,030 --> 00:08:31,460
يبدو أنّ هناك بالفعل عربات بعازل
!صدمات في باركولا وروماليا

118
00:08:31,900 --> 00:08:32,990
،على ذكر الأمر

119
00:08:32,990 --> 00:08:36,580
هناك كثير من الإيلف في عاصمة باركولا
الملكيّة الّتي نتوجّه إليها تالياً، صحيح؟

120
00:08:36,580 --> 00:08:38,250
أيمكننا أخذ بعضهن معنا؟

121
00:08:38,250 --> 00:08:39,910
هذه فكرة سديدة

122
00:08:39,910 --> 00:08:45,200
آكيرا-ساما، باركولا تمنع أخذ
عبيد من البلد

123
00:08:45,200 --> 00:08:48,220
!ولِمَ لا؟ نحن الأبطال

124
00:08:48,220 --> 00:08:50,720
ينبغي أن يبتهجنَ لأنّهن سيُرافقنَنا

125
00:08:50,720 --> 00:08:51,710
أليس كذلك؟

126
00:08:51,710 --> 00:08:55,060
فنحن مُغامرون درجة أولى
،نفوق المستوى 30

127
00:08:55,060 --> 00:08:59,870
وقريباً لن يكون هناك أحد في القارّة
يمكن مُقارنته بنا

128
00:08:59,870 --> 00:09:02,000
هذه البعثة هي فُرصتي الوحيدة

129
00:09:02,000 --> 00:09:03,400
يجب أن أفعل شيئاً

130
00:09:04,710 --> 00:09:08,270
،باكيلاتوس، عاصمة باركولا الملكيّة

131
00:09:08,270 --> 00:09:11,440
لا بدّ من وجود شيء فيها يمكنني
استخدامه لتصحيح هذا الوضع

132
00:09:11,440 --> 00:09:13,110
هذا الشّعور الّذي يُراودني

133
00:09:13,540 --> 00:09:17,670
أنا متأكّدة بأنّ مهارة الوحي خاصّتي
!تحاول أن تخبرني بشيء

134
00:09:32,340 --> 00:09:34,430
!أنتم، أفسحوا الطّريق

135
00:09:34,780 --> 00:09:36,470
ما مشكلتكم جميعاً؟

136
00:09:36,890 --> 00:09:38,500
أنتم تعترضون طريقي. ابتعدوا

137
00:09:38,500 --> 00:09:40,230
لم أركم من قبل

138
00:09:40,230 --> 00:09:41,260
هل أنتم جديدون؟

139
00:09:41,260 --> 00:09:42,960
!قلتُ لكم ابتعدوا

140
00:09:46,100 --> 00:09:50,370
أيّ شخص يردّ على الأبطال هذه نهايته

141
00:09:50,370 --> 00:09:53,340
!انظر. إنّها إيلف

142
00:09:53,340 --> 00:09:57,830
!آكيرا، ذات أُذنَي الأرنب تلك مُثيرة جدّاً

143
00:09:57,830 --> 00:10:01,030
أنت! سأشتري هذه المرأة منك

144
00:10:01,030 --> 00:10:02,750
اعتبره شرفاً

145
00:10:02,750 --> 00:10:05,260
هذا طلبٌ مُباشر من الأبطال

146
00:10:05,260 --> 00:10:06,370
مستحيل

147
00:10:06,630 --> 00:10:07,640
ماذا؟

148
00:10:07,640 --> 00:10:10,340
إن كان هذا كلّ شيء، فغادروا رجاء

149
00:10:10,340 --> 00:10:14,200
هل تعتقد بأنّك تستطيع عصياننا؟

150
00:10:14,200 --> 00:10:16,140
سلِّم نساءك بهدوء فحسب

151
00:10:16,140 --> 00:10:17,820
أنتما، هذا يكفي

152
00:10:17,820 --> 00:10:19,360
!لا تُحرِجانا هكذا

153
00:10:19,360 --> 00:10:20,820
!اصمتي أنتِ يا أكاني

154
00:10:21,580 --> 00:10:22,530
،أنتما

155
00:10:22,530 --> 00:10:24,260
تعالا معنا

156
00:10:24,550 --> 00:10:29,570
مع الأسف، لا ننوي ترك مولانا

157
00:10:29,570 --> 00:10:31,360
كذلك أنا

158
00:10:32,430 --> 00:10:33,600
!الحقيرتان

159
00:10:33,950 --> 00:10:35,680
سأطلب منكم مرّة واحدة فقط

160
00:10:35,680 --> 00:10:36,700
غادروا رجاء

161
00:10:36,700 --> 00:10:37,810
!اللّعنة عليك

162
00:10:37,810 --> 00:10:39,360
!إيّاك وإهانتنا؟

163
00:10:41,050 --> 00:10:42,080
تفكيك

164
00:10:42,770 --> 00:10:43,660
!ماذا؟

165
00:10:44,240 --> 00:10:45,950
...أيُّها

166
00:10:50,640 --> 00:10:52,350
!سيفي المُقدّس

167
00:10:52,350 --> 00:10:53,800
لا، إنّه ليس كذلك

168
00:10:53,800 --> 00:10:55,660
إنّه سيف عاديّ صُنِع من حديد سحريّ

169
00:10:56,100 --> 00:10:57,220
!أيّها الوغد

170
00:10:57,220 --> 00:11:01,400
أتعتقد بأنّ مُعارضة أبطال سيدونيا
!لن تكون عواقبها وخيمة عليك؟

171
00:11:01,400 --> 00:11:04,030
مَن منّا ستكون عاقبته وخيمة؟

172
00:11:07,090 --> 00:11:09,710
هل تعيان ما الّذي يعنيه إشهار السّيف

173
00:11:09,710 --> 00:11:11,880
ومُهاجمة شخص في نقابة المُغامرين؟

174
00:11:13,340 --> 00:11:16,200
!ستندم إذا عارضت كنيسة النُّور الإلهيّ

175
00:11:16,200 --> 00:11:19,100
!لن ننساك

176
00:11:19,100 --> 00:11:20,410
انقلعا فحسب

177
00:11:20,410 --> 00:11:21,660
جيّد أنّكم ستُغادرون

178
00:11:22,550 --> 00:11:24,500
أنا آسفة بشأنهما

179
00:11:24,960 --> 00:11:27,490
ليس عليكِ الاعتذار

180
00:11:28,000 --> 00:11:30,570
هلّا عرّفتني على اسمك؟

181
00:11:30,570 --> 00:11:31,880
اسمي؟

182
00:11:31,880 --> 00:11:34,840
اسمي أكاني ميساتو

183
00:11:37,140 --> 00:11:40,760
أنا قائد أجنحة نولين، تاكومي إيروما

184
00:11:41,660 --> 00:11:43,090
تاكومي؟

185
00:11:43,090 --> 00:11:45,010
!المعذرة، هل أنت...؟

186
00:11:45,470 --> 00:11:48,350
أكاني-ساما، يجب أن نُسرع

187
00:11:48,970 --> 00:11:51,480
أنوي البقاء في فندق ضفّة البُحيرة

188
00:11:56,410 --> 00:11:58,580
!تاكومي إيروما

189
00:11:58,580 --> 00:11:59,970
إنّه هو

190
00:11:59,970 --> 00:12:03,580
!هذا ما تخبرني به مهارة الوحي خاصّتي

191
00:12:05,630 --> 00:12:06,770
!ماذا؟

192
00:12:06,770 --> 00:12:09,240
!التقيتُم بالأبطال؟

193
00:12:09,240 --> 00:12:11,600
كانوا مختلّين حمقى

194
00:12:11,600 --> 00:12:13,460
"إنّهم يُلوّثون مُصطلح "البطل

195
00:12:13,460 --> 00:12:16,720
كانوا ينظرون إليّ وإلى صوفيا
كما لو أنّهم أرادوا اغتصابنا

196
00:12:16,720 --> 00:12:18,720
!مُقرف

197
00:12:19,090 --> 00:12:22,550
لكن المرأة الّتي معهما بدت
مُحترمة على الأقلّ

198
00:12:22,550 --> 00:12:23,360
أجل

199
00:12:23,840 --> 00:12:25,760
...ربّما هناك فرصة بأن تكون

200
00:12:27,040 --> 00:12:31,950
،أخبرتُها بأنّنا سنقيم في هذا الفندق
لكن ربّما كان ذلك استهتاراً منّي؟

201
00:12:31,950 --> 00:12:35,020
—لا مُشكلة! فلديك نحن

202
00:12:35,020 --> 00:12:36,480
!نحن معك

203
00:12:36,790 --> 00:12:39,690
...لا، لم أكن أقصد سلامتي

204
00:12:47,920 --> 00:12:51,360
أكاني-ساما، اتركيني وتابعي

205
00:12:51,360 --> 00:12:53,750
!لا، يجب أن تأتي معي

206
00:12:53,750 --> 00:12:54,680
!ها هما

207
00:12:55,080 --> 00:12:56,120
!هيّا

208
00:12:56,120 --> 00:12:58,540
!أكاني-ساما! عودي من فضلكِ

209
00:12:58,540 --> 00:13:00,000
!أكاني-ساما

210
00:13:06,260 --> 00:13:10,140
الفندق الّذي يُقيم فيه تاكومي-ساما
موجود بعد هذا الزّقاق مباشرة

211
00:13:11,420 --> 00:13:12,390
!أكاني-ساما

212
00:13:15,490 --> 00:13:16,410
!بسرعة

213
00:13:19,780 --> 00:13:22,640
أحسنتما صنعاً يا صوفيا وقيقب

214
00:13:23,490 --> 00:13:27,520
لا أعتقد بأنّ أحداً أدرك بأنّ هاتين
الاثنتين كانا مُتوجّهتين إلى هنا

215
00:13:27,520 --> 00:13:31,110
ربطتُهما بخيوط وتركتُهما مُعلّقتين
بواسطة أشجار الغابة

216
00:13:31,380 --> 00:13:34,040
!شكراً جزيلاً لكما

217
00:13:35,220 --> 00:13:36,860
تاكومي إيروما

218
00:13:36,860 --> 00:13:38,820
،سأكون صريحة وأسأل

219
00:13:39,440 --> 00:13:42,870
هل أنت سليل الشّخص اليابانيّ
الّذي تمّ استدعاؤه إلى هنا؟

220
00:13:43,170 --> 00:13:45,080
—لا أستطيع أن أدع المعلومات تتسرّب إلى سيدونيا

221
00:13:45,080 --> 00:13:46,650
!أقسم بأنّني لن أخبرهم

222
00:13:49,750 --> 00:13:51,520
أنا يابانيّ

223
00:13:51,520 --> 00:13:53,930
...ماذا؟ لكن وجهك

224
00:13:53,930 --> 00:13:55,560
أنا يابانيّ مثلكِ فحسب

225
00:13:56,220 --> 00:14:00,960
وسبب وجودي هنا مُرتبط بكم جميعاً كذلك

226
00:14:01,350 --> 00:14:03,490
...المعذرة، تاكومي-ساما

227
00:14:04,130 --> 00:14:06,200
لستُ أفهم

228
00:14:06,200 --> 00:14:08,440
ليس من المنطقيّ إخفاء الأمر بعد الآن

229
00:14:08,970 --> 00:14:12,690
أريد منكن جميعاً أن تحتفظن بما
سأخبركن به سرّاً بيننا

230
00:14:14,290 --> 00:14:16,320
أكاني وعبدتها اختفيتا؟

231
00:14:16,320 --> 00:14:17,760
لقد هربَتْ

232
00:14:17,760 --> 00:14:22,180
شعرتُ بغرابة تصرّفها منذ غادرنا سيدونيا

233
00:14:22,180 --> 00:14:28,050
على أيّ حال، يجدر بنا أن نلغي زيارتنا
المُقبلة إلى روماليا ونعود إلى سيدونيا

234
00:14:28,050 --> 00:14:31,120
سيتوجّب علينا مُراجعة خططنا
في تاريخ لاحق

235
00:14:32,710 --> 00:14:35,090
،إذاً يا تاكومي-ساما

236
00:14:35,090 --> 00:14:38,420
أتيت من نفس عالم الأبطال؟

237
00:14:38,420 --> 00:14:39,050
أجل

238
00:14:39,550 --> 00:14:42,960
بالإضافة إلى ذلك، أنت هنا
بمشيئة نولين-ساما؟

239
00:14:42,960 --> 00:14:46,020
!إذاً أنت مبعوث من نولين-ساما

240
00:14:46,020 --> 00:14:51,120
في الواقع، جميعكن تتقبّلن هذا
الأمر بسهولة بالغة، أنا في حيرة

241
00:14:51,120 --> 00:14:53,910
إذاً إمبراطوريّة سيدونيا المُقدّسة
هي الشرّير الرّئيسيّ

242
00:14:53,910 --> 00:14:57,380
تعويذة استدعاء سبّبتْ مثل هذا
...التقلُّب الشّديد في المانا

243
00:14:57,380 --> 00:14:59,910
لعلّ هذا قد أثّر بشكل سلبيّ
على هذا العالم

244
00:15:00,330 --> 00:15:02,060
أعلم، أجل

245
00:15:02,470 --> 00:15:05,530
وجدتُ لنفسي مكاناً هنا في هذا العالم

246
00:15:05,530 --> 00:15:08,300
أريد فقط أن أعيش حياة هادئة كمُنج

247
00:15:08,960 --> 00:15:12,390
لكن استدعاء البطل الخاصّة بسيدونيا
يُسبّب مُشكلة

248
00:15:12,390 --> 00:15:15,250
هل تعتقد بأنّهم يخطّطون لخوض
حرب مع دُول أخرى؟

249
00:15:15,250 --> 00:15:16,810
هذا مُمكن

250
00:15:16,810 --> 00:15:18,680
،لكن حتّى لو كانوا أبطالاً

251
00:15:18,680 --> 00:15:21,520
لا أعتقد بأنّهم قادرون على شنّ
حرب من تلقاء أنفسهم

252
00:15:21,520 --> 00:15:24,450
إذاً ربّما سيُستخدَمون لتحريض النّاس؟

253
00:15:24,450 --> 00:15:26,730
أجل، هذا أكثر منطقيّة

254
00:15:27,210 --> 00:15:30,700
رغم أنّه إذا أتاح هذا توسُّع
،نفوذ كنيسة النُّور الإلهيّ

255
00:15:30,700 --> 00:15:33,510
فهذا يُعرّضنا لخطر أكبر

256
00:15:33,510 --> 00:15:36,510
أنا آسفة لأنّني ورّطتُكم جميعاً

257
00:15:36,990 --> 00:15:40,400
لا، كلانا قد وقعنا ضحيّة هذا

258
00:15:40,400 --> 00:15:41,580
...الأهمّ

259
00:15:41,580 --> 00:15:44,340
لماذا يتصرّف ذلكما الاثنان هكذا؟

260
00:15:44,620 --> 00:15:48,300
آكيرا وياماتو لم يكونا كذلك في البداية

261
00:15:48,750 --> 00:15:51,910
،منذ مجيئنا إلى هنا، تغيّرتْ شخصيّتهما

262
00:15:51,910 --> 00:15:53,870
إلى درجة غير طبيعيّة

263
00:15:53,870 --> 00:15:55,960
أتعتقدين بأنّ شيئاً قد أصابهما؟

264
00:15:56,600 --> 00:15:59,120
ماذا فعلتم جميعاً لتأمين الطّعام والشّراب؟

265
00:15:59,120 --> 00:16:02,600
،لم أثق بسيدونيا منذ البداية

266
00:16:02,600 --> 00:16:07,060
لذا كنتُ دائماً ما أستخدم سحر التّطهير
قبل أكل أو شرب شيء

267
00:16:07,760 --> 00:16:11,190
لكن ذلكما الاثنين كانا يعطيان
،الأولويّة لمهاراتهما في المُبارزة بالسّيف

268
00:16:14,900 --> 00:16:20,350
إذاً لعلّه يوجد عقّار ما في الطّعام
والشّراب قد غسل دماغمهما

269
00:16:20,350 --> 00:16:21,710
!سيّد إيروما

270
00:16:22,280 --> 00:16:24,460
!أرجوك أنقذني أنا ولولو

271
00:16:24,940 --> 00:16:27,410
!لا، كفّي عن الرُّكوع رجاء

272
00:16:27,410 --> 00:16:30,520
كنتُ أنتظر لفترة طويلة من أجل فُرصة هرب

273
00:16:30,520 --> 00:16:33,240
...حتّى لو اضطررتَ لأخذي إلى بلد أُخرى

274
00:16:33,940 --> 00:16:35,280
!أرجوك

275
00:16:36,060 --> 00:16:39,470
ماذا تنوين أن تفعلي حالما تصبحين
في بلد أُخرى؟

276
00:16:39,470 --> 00:16:40,980
ستتمّ مُلاحقتكِ

277
00:16:43,510 --> 00:16:44,750
...أنا

278
00:16:45,320 --> 00:16:48,220
هذا دليل على عقدك، صحيح؟

279
00:16:48,660 --> 00:16:49,810
أجل

280
00:16:50,130 --> 00:16:52,200
لا أستطيع تحمُّل ذلك أيضاً

281
00:16:52,780 --> 00:16:55,500
...استعباد شخص آخر بياقة

282
00:16:59,010 --> 00:17:00,090
تبدّدي

283
00:17:04,120 --> 00:17:07,330
يبدو وكأنّ هذ ما تريده سيّدتكِ

284
00:17:07,330 --> 00:17:10,700
...أكاني-ساما، المعذرة

285
00:17:10,700 --> 00:17:13,670
!لا مكان آخر أذهب إليه

286
00:17:13,900 --> 00:17:14,870
ماذا؟

287
00:17:14,870 --> 00:17:17,510
أتتخلّين عنّي الآن؟

288
00:17:17,770 --> 00:17:19,230
!أرجوكِ

289
00:17:19,230 --> 00:17:20,940
!دعيني أبقى معكِ

290
00:17:20,940 --> 00:17:24,360
!هلّا سمحتِ لي بالبقاء معكِ لفترة أطول؟

291
00:17:24,360 --> 00:17:26,320
!أعدكِ ألّا أشكّل عقبة في وجهكِ

292
00:17:27,190 --> 00:17:29,680
سنكون معاً الآن وللأبد

293
00:17:30,580 --> 00:17:31,890
لكن اسمعي

294
00:17:31,890 --> 00:17:33,910
لن تكوني كعبدة أو بموجب عقد

295
00:17:34,590 --> 00:17:37,300
أريدكِ أن تكوني بجانبي كصديقة

296
00:17:37,300 --> 00:17:38,620
صديقة؟

297
00:17:39,620 --> 00:17:42,390
أردتُ هذا منذ فترة طويلة

298
00:17:42,390 --> 00:17:46,750
لولو، من الآن فصاعداً، نحن صديقتان

299
00:17:47,210 --> 00:17:49,620
...أكاني-ساما

300
00:17:50,540 --> 00:17:53,750
مبدئيّاً، سنتوجّه إلى قصري في بولتون

301
00:17:54,260 --> 00:17:56,820
لكن حينئذ سوف نُسبّب مُشكلة لك

302
00:17:57,640 --> 00:18:00,440
لا أستطيع التخلّي عن أبناء بلدي فحسب

303
00:18:00,840 --> 00:18:03,870
يجدر بنا الابتعاد عن العاصمة الملكيّة
في أسرع وقت مُمكن

304
00:18:07,900 --> 00:18:10,040
تفضّلي، كُلي

305
00:18:10,040 --> 00:18:11,560
...هل هذا

306
00:18:11,560 --> 00:18:13,080
!حساء بالكريمة؟

307
00:18:13,670 --> 00:18:17,550
انصدمتُ عندما علمتُ بأنّ
لديهم حليب وجبنة أيضاً

308
00:18:17,550 --> 00:18:20,070
أنوي الحصول على بعض الأرزّ
ذات يوم أيضاً

309
00:18:20,070 --> 00:18:22,530
هيّا، اجلسي يا لولو

310
00:18:22,890 --> 00:18:24,990
...أ-أنا

311
00:18:26,240 --> 00:18:28,200
!لولو، لنأكل

312
00:18:28,200 --> 00:18:30,210
!حـ-حسناً

313
00:18:31,010 --> 00:18:32,250
!حان وقت الأكل

314
00:18:32,250 --> 00:18:34,000
...حـ-حان وقت الأكل

315
00:18:38,630 --> 00:18:39,800
أكاني؟

316
00:18:39,800 --> 00:18:42,030
!هـ-هل هو سيّئ؟

317
00:18:42,030 --> 00:18:44,510
!أعددتُ الحساء اليوم

318
00:18:44,510 --> 00:18:47,340
!كنتُ أدع الأمر كلّه لماني مؤخّراً

319
00:18:47,340 --> 00:18:50,760
الآن أنا مجرّد ماء مالح أتظاهر
!بأنّني حساء بالكريمة فحسب

320
00:18:50,760 --> 00:18:53,070
!لا، أنا أدنى من ذلك حتّى

321
00:18:53,070 --> 00:18:55,540
!لـ-لا، أنا من قطّع الخضراوات

322
00:18:55,540 --> 00:18:57,230
!أنا آسفة جدّاً

323
00:18:57,610 --> 00:18:58,990
على العكس

324
00:18:58,990 --> 00:19:01,190
إنّه شهيّ جدّاً

325
00:19:02,060 --> 00:19:03,000
ماذا؟

326
00:19:03,670 --> 00:19:04,980
أكاني-ساما؟

327
00:19:05,380 --> 00:19:08,470
ظننتُ بأنّني لن أتمكّن من أكل
هذا ثانية أبداً

328
00:19:09,230 --> 00:19:10,700
أتفهّم ذلك

329
00:19:10,700 --> 00:19:14,160
أنا متأكّد بأنّها كانت مُتوتّرة طوال الوقت
منذ استدعائها إلى هنا

330
00:19:14,680 --> 00:19:18,320
لذا بعد تذوّقها طعاماً منزليّاً، تمكّنتْ
أخيراً من الاسترخاء قليلاً

331
00:19:26,410 --> 00:19:27,650
ماذا؟

332
00:19:27,650 --> 00:19:29,760
ماذا؟ الغابة تنمو؟

333
00:19:31,090 --> 00:19:32,560
!إنّه تدافُع وحوش

334
00:19:32,560 --> 00:19:34,060
!ارسلوا مبعوثاً إلى بولتون

335
00:19:34,060 --> 00:19:35,760
!بسرعة

336
00:19:39,310 --> 00:19:46,210
خطّطتُ للتكلّم مع جلالته من خلال
الحاكم حول أكاني ولولو غداً

337
00:19:46,210 --> 00:19:50,530
بما أنّهما ستكونان بأمان هنا
في القصر لبعض الوقت

338
00:19:52,190 --> 00:19:57,110
ريفا، أنا آسف، لكن هل يمكنكِ الذّهاب
ونداء صوفيا والأُخريات لأجلي؟

339
00:19:57,110 --> 00:19:59,650
أجل... بالطّبع

340
00:20:00,790 --> 00:20:04,210
اعتباراً من هذه اللّحظة، سوف أفضّ عقد الجميع

341
00:20:04,900 --> 00:20:09,490
في وقت لاحق، سأتعرّض لخطر أكبر حتّى

342
00:20:10,320 --> 00:20:11,690
!تاكومي-ساما

343
00:20:11,690 --> 00:20:14,210
!أتتفوّه بهذا الهُراء ثانية؟

344
00:20:14,210 --> 00:20:15,450
ثانية؟

345
00:20:15,450 --> 00:20:17,150
فعلها من قبل؟

346
00:20:17,150 --> 00:20:20,600
!أجل، فعلها! وغضبت ماريا في وجهه

347
00:20:20,600 --> 00:20:22,390
!من الطّبيعيّ أن أغضب

348
00:20:22,940 --> 00:20:23,970
مهلاً

349
00:20:23,970 --> 00:20:25,510
اسمحنَ لي بإكمال كلامي

350
00:20:25,510 --> 00:20:26,530
هذه المرّة الأمر مختلف

351
00:20:26,780 --> 00:20:30,740
في وقت لاحق، أريدكن أن تبقين
بجانبي بطريقة مختلفة

352
00:20:31,040 --> 00:20:32,890
طريقة مختلفة؟

353
00:20:32,890 --> 00:20:36,410
—كحليفات لي، كصديقاتي العزيزات

354
00:20:36,410 --> 00:20:38,590
لا، كعائلة لي؟

355
00:20:38,960 --> 00:20:41,550
،مضى عام منذ التقيتُ بصوفيا وماريا

356
00:20:41,550 --> 00:20:45,260
،وستّة أشهر منذ التقيتُ بريفا
وثلاثة أشهر بالنّسبة لماني

357
00:20:45,260 --> 00:20:48,860
،جميعكن قمتُن بأشياء رائعة لأجلي
وأنا مُمتنّ لكُن

358
00:20:48,860 --> 00:20:55,010
لهذا ارتأيتُ بأنّنا لا نحتاج أيّ عقد
،بيننا بعد الآن

359
00:20:55,010 --> 00:20:58,180
لأنّ هناك رابط أقوى وأكثر متانة بيننا

360
00:20:58,820 --> 00:21:00,050
...رابط

361
00:21:00,770 --> 00:21:04,580
