1
00:00:01,150 --> 00:00:04,490
إشاعات عن أنّ مملكة باركولا

2
00:00:04,490 --> 00:00:07,320
تستخدم أدوات سحريّة لتطهير مجاريرهم

3
00:00:07,320 --> 00:00:09,800
قد وصلت إلى بلاد سيدونيا خاصّتنا

4
00:00:10,090 --> 00:00:13,440
كنيسة النُّور الإلهيّ قد ناشدت

5
00:00:13,440 --> 00:00:17,280
البابا الخاصّ بإمبراطوريّة سيدونيا
المُقدّسة حول هذه المسألة

6
00:00:17,690 --> 00:00:23,000
يزعمون بأنّ سحر النُّور هو هِبة من الإله
،مُنِحت لكنيسة النُّور الإلهيّ

7
00:00:23,460 --> 00:00:26,360
وبالتّالي، سحر التّطهير

8
00:00:26,360 --> 00:00:29,360
يندرج تحت نطاق كنيسة النُّور الإلهيّ

9
00:00:29,360 --> 00:00:30,470
ما معنى هذا؟

10
00:00:32,010 --> 00:00:34,940
"قالوا، "دائرة سحر التّطهير وبراءة اختراعها

11
00:00:34,940 --> 00:00:37,770
"يجب تسليمها للكنيسة"

12
00:00:38,750 --> 00:00:41,830
،إذا قُدِمتْ قوّة من إلههم كهِبة

13
00:00:41,830 --> 00:00:45,600
فتستطيع الكنيسة إذاً صنع الدّائرة
السّحريّة بنفسها فحسب

14
00:00:46,560 --> 00:00:49,500
،أ-أضاف البابا أيضاً

15
00:00:49,500 --> 00:00:54,950
استخدام سحرنا التّطهيريّ المُقدّس"
"على مرحاض هو أمر غير مقبول

16
00:00:54,950 --> 00:00:58,460
"لذلك، "عليك وبشكل فوريّ تسليم الشّخص

17
00:00:58,460 --> 00:01:03,560
الّذي صنع أداة السّحر التطهيريّة هذه"
"لإمبراطوريّة سيدونيا المُقدّسة

18
00:01:03,560 --> 00:01:04,920
أرفُض ذلك

19
00:01:05,880 --> 00:01:11,040
يفكّر البابا في استدعاء كافّة
كهنة كنيسة النُّور الإلهيّ

20
00:01:11,040 --> 00:01:13,690
!الّذين يسكنون في مملكة باركولا

21
00:01:13,690 --> 00:01:16,960
من فضلك، يمكنك أن تستدعيهم

22
00:01:18,420 --> 00:01:22,080
لن نمنعك

23
00:02:54,700 --> 00:02:56,890
...هل كان من المُناسب حقّاً

24
00:02:57,120 --> 00:03:01,350
اتّخاذ موقف صارم كهذا
مع مبعوث سيدونيا؟

25
00:03:01,350 --> 00:03:03,460
هذه ليست مُشكلة

26
00:03:03,460 --> 00:03:07,060
لكن ألا يعني هذا قلب الكنيسة ضدّنا؟

27
00:03:07,060 --> 00:03:11,840
تاكومي-ساما، لعلّك لا تعرف هذا
،بما أنّك من بلدة ريفيّة

28
00:03:11,840 --> 00:03:16,640
لكن ثمّة دين آخر غير كنيسة
النُّور الإلهيّ في هذه المملكة

29
00:03:16,640 --> 00:03:20,100
كنيسة الخَلق، أليس كذلك؟

30
00:03:20,100 --> 00:03:21,770
ماذا؟ أنا متفاجئ من معرفتك بذلك

31
00:03:21,770 --> 00:03:25,720
أجل، كنيسة الخَلق الّتي تعبد الإلَهة نولين

32
00:03:25,720 --> 00:03:30,630
المعذرة، إذا كانت كنيسة الخَلق
،تعبد نولين-ساما

33
00:03:30,630 --> 00:03:33,440
فما الإله الّذي تعبده كنيسة النُّور الإلهيّ إذاً؟

34
00:03:33,440 --> 00:03:37,410
أعتقد بأنّه آنات

35
00:03:37,410 --> 00:03:38,830
آنات؟

36
00:03:38,830 --> 00:03:43,810
بصرف النّظر عن ذلك، تُطبِق مملكة
،باركولا حرّية الدّين

37
00:03:43,810 --> 00:03:47,400
لذا لديها الكثير من المُؤمنين
في كنيسة الخَلق القديمة

38
00:03:47,680 --> 00:03:51,890
أحد الأسباب هو أنّ كهنة كنيسة
الخَلق تستخدم سحر التّعافي

39
00:03:51,890 --> 00:03:54,570
من أجل إظهار الامتنان فحسب

40
00:03:54,830 --> 00:04:00,440
وبالمقابل، كهنة كنيسة النُّور الإلهيّ يفرضون
أجوراً باهظة حسبما أفهم؟

41
00:04:00,440 --> 00:04:01,290
أجل

42
00:04:01,560 --> 00:04:06,990
وكنيسة النُّور الإلهيّ مدعومة بواسطة
إمبراطوريّة سيدونيا المُقدّسة، صحيح؟

43
00:04:06,990 --> 00:04:13,080
لذا ما أحضرني إلى هنا اليوم هو
طلب منك يا تاكومي-ساما

44
00:04:07,340 --> 00:04:10,140
سيكون من الحكمة تجنُّب الاحتكاك معهم

45
00:04:13,530 --> 00:04:14,640
طلب؟

46
00:04:14,640 --> 00:04:15,840
...في الحقيقة

47
00:04:15,840 --> 00:04:19,400
،قابلتُ مولانا، الماركيز غودوين

48
00:04:19,400 --> 00:04:21,810
لأقدّم لجلالته عيّنات عن مرحاضك

49
00:04:21,810 --> 00:04:24,750
،بسحره التّطهيريّ، وكذلك برّادك

50
00:04:24,750 --> 00:04:26,340
...لذا، في الواقع

51
00:04:27,090 --> 00:04:33,030
!أمرَ بأن آخذك لمُقابلته

52
00:04:33,030 --> 00:04:35,170
!ا-انتظر لحظة

53
00:04:35,170 --> 00:04:40,120
!بالطّبع، جلالته لن يغضب إذا رفضت

54
00:04:40,120 --> 00:04:43,730
!لذا يعتمد الأمر عليك يا تاكومي-ساما

55
00:04:43,730 --> 00:04:47,680
إلى العاصمة الملكيّة باكيلاتوس؟

56
00:04:47,680 --> 00:04:48,900
أجل

57
00:04:48,900 --> 00:04:54,520
جلالته قد حماني من تدخُّل
،إمبراطوريّة سيدونيا المُقدّسة

58
00:04:54,520 --> 00:04:57,320
لذا بدا من الوقاحة الرّفض

59
00:04:57,320 --> 00:05:00,030
هل يمكنني أن أطلب منكما مُرافقتي؟

60
00:05:00,030 --> 00:05:01,240
بالطّبع

61
00:05:01,240 --> 00:05:04,260
هذه أوّل مرّة أزور فيها العاصمة الملكيّة

62
00:05:04,260 --> 00:05:06,790
هل زرتِها من قبل يا صوفيا؟

63
00:05:06,790 --> 00:05:09,250
لا، ستكون المرّة الأولى لي أيضاً

64
00:05:09,250 --> 00:05:11,740
!إنّها الأولى لي كذلك

65
00:05:12,220 --> 00:05:14,340
سوف ننطلق بعد أسبوع

66
00:05:14,340 --> 00:05:17,570
سوف نحتاج لتجهيز كثير
من الأمور في هذه الأثناء

67
00:05:17,840 --> 00:05:20,810
كم سيستغرق الوصول إلى العاصمة
الملكيّة من وقت؟

68
00:05:20,810 --> 00:05:23,870
قالوا حوالي سبعة أيّام بواسطة
عربة حصان وحش

69
00:05:23,870 --> 00:05:28,430
!إذاً سأحتاج لتحضير كثير من الطّعام أيضاً

70
00:05:28,760 --> 00:05:30,520
سأدع ذلك الأمر لك يا ماريا

71
00:05:30,520 --> 00:05:33,980
!دع كلّ الأعمال المنزليّة على عاتقي

72
00:05:33,980 --> 00:05:37,770
وأيضاً أفكّر في صنع عباءات جديدة لكما

73
00:05:37,770 --> 00:05:39,840
عباءات؟

74
00:05:40,440 --> 00:05:44,810
كنتُ قد طلبتُ من بابيك توفير بعض الأحجار
السّحريّة ذات عنصر الظّلام لي

75
00:05:45,100 --> 00:05:48,910
بهذه، أستطيع سَحر العباءات
بحجب الوعي

76
00:05:48,910 --> 00:05:51,000
...حجب الوعي

77
00:05:51,000 --> 00:05:53,610
سيكون هذا مُفيداً في القتال حتماً

78
00:05:54,230 --> 00:05:56,690
،وأيضاً إذا ارتديتِها في البلدة

79
00:05:56,690 --> 00:06:01,450
فأعتقد ستُساهم في تجنّب
تحرُّش الأشخاص السّيئين

80
00:06:01,800 --> 00:06:03,540
أتعلمين؟

81
00:06:03,540 --> 00:06:07,690
أشعر بأنّ تاكومي-ساما لا يُقدّر
نفسه كثيراً بما يكفي

82
00:06:07,690 --> 00:06:09,170
أتّفق

83
00:06:09,170 --> 00:06:10,700
،يتمتّع بوجه جميل من الأساس

84
00:06:10,700 --> 00:06:14,300
وهناك موهبته وقدرته الممتازة كمُنتِج

85
00:06:14,300 --> 00:06:16,430
—وأضيفي إلى ذلك شخصيّته و

86
00:06:16,860 --> 00:06:17,850
ما-ماذا؟

87
00:06:20,580 --> 00:06:24,820
!أ-أنا أصرّح فقط عن سبب روعته كسيّد

88
00:06:24,820 --> 00:06:27,420
أكيد، أكيد

89
00:06:27,420 --> 00:06:31,160
!ا-انظري! يوجد لحم جاموس أسود هناك

90
00:06:31,370 --> 00:06:34,740
!صوفيا، أنتِ غارقة في الحُبّ

91
00:06:42,260 --> 00:06:45,230
أين هِبتك؟

92
00:06:47,180 --> 00:06:48,550
نولين-ساما

93
00:06:48,550 --> 00:06:50,220
!تاكومي

94
00:06:50,220 --> 00:06:51,420
لم أرك منذ وقت

95
00:06:51,420 --> 00:06:53,590
سمعتُ بأنّك مُتوجّه إلى العاصمة الملكيّة

96
00:06:53,590 --> 00:06:56,130
وأتيت للصّلاة من أجل رحلة آمنة؟

97
00:06:56,330 --> 00:06:58,900
ولم تُحضر هِبة؟

98
00:06:58,900 --> 00:07:00,750
لديّ بعض الأسئلة

99
00:07:01,240 --> 00:07:04,710
إلَهة كنيسة النُّور الإلهيّ تُدعى آنات، صحيح؟

100
00:07:04,710 --> 00:07:05,740
هذا صحيح

101
00:07:05,740 --> 00:07:11,570
هل هي إلَهة منفصلة عنكِ؟

102
00:07:11,840 --> 00:07:14,790
في الحقيقة. أنا الإلَهة الوحيدة

103
00:07:14,790 --> 00:07:17,410
من تكون آنات إذاً؟

104
00:07:17,410 --> 00:07:20,120
حسناً، ستعرف ذلك في الوقت المُناسب

105
00:07:20,120 --> 00:07:21,560
في الوقت المُناسب؟

106
00:07:21,560 --> 00:07:22,630
ما هذا؟

107
00:07:22,630 --> 00:07:23,850
هل ينتابك فضول؟

108
00:07:24,320 --> 00:07:30,420
يبدو وكأنّ إمبراطوريّة سيدونيا المُقدّسة
كانت تتقرّب منّي

109
00:07:30,420 --> 00:07:36,630
ذكرتِ في السّابق بأنّ بعضاً من برَكتكِ
سوف تُلغى بحسب تصرُّفاتي

110
00:07:36,630 --> 00:07:37,250
أجل

111
00:07:37,250 --> 00:07:40,810
هل كان سبب ذلك هو التدخُّل من سيدويا؟

112
00:07:40,810 --> 00:07:42,240
لم يكن كذلك

113
00:07:42,240 --> 00:07:47,030
سيدونيا هي سبب وجودك هنا
في ميلدغارد من الأساس

114
00:07:47,030 --> 00:07:49,530
لذا هذا يتجاوز مستوى قوّة البرَكة

115
00:07:49,530 --> 00:07:51,460
هكذا إذاً

116
00:07:51,460 --> 00:07:56,240
إذاً هذا ما يحلّ بالأبطال الّذين تمّ
استدعاؤهم بواسطة سيدونيا؟

117
00:07:56,240 --> 00:07:59,700
في العادة كان ذلك ليُسبّب فوضى

118
00:07:59,700 --> 00:08:01,400
...الحقيقة هي

119
00:08:01,400 --> 00:08:05,110
عبثتُ بالزّمن عندما أرسلتُ في طريقك

120
00:08:05,110 --> 00:08:08,190
أرسلتُك إلى ما قبل عام
من استدعاء الأبطال

121
00:08:08,190 --> 00:08:08,890
!ماذا؟

122
00:08:08,890 --> 00:08:12,360
!تقصدين بأنّهم لم يتمّ استدعاؤهم بعد؟

123
00:08:12,360 --> 00:08:15,300
أجل. يحتاجون بضعة أشهر بعد

124
00:08:15,300 --> 00:08:16,640
!تمهّلي لحظة

125
00:08:16,640 --> 00:08:19,150
لِمَ تتكبّدين عناء إرسالي قبل
!عام من عمليّة الاستدعاء؟

126
00:08:19,150 --> 00:08:20,820
انتهى الوقت يا إيروما

127
00:08:20,820 --> 00:08:23,890
هذه ليست ساعات زيارة في سجن

128
00:08:24,180 --> 00:08:25,710
!حسناً، أراك لاحقاً

129
00:08:25,710 --> 00:08:27,730
!في المرّة المُقبلة، أحضِر هِبة

130
00:08:27,730 --> 00:08:29,470
!أحبّ الحلويّات

131
00:08:29,470 --> 00:08:32,160
—لحظة، لم تُجيبي عن سؤالي

132
00:08:37,490 --> 00:08:41,200
أشعر وكأنّها تجنّبت السُّؤال

133
00:08:41,470 --> 00:08:44,990
،حسناً، أنا لا أنوي مُقابلة الأبطال

134
00:08:44,990 --> 00:08:46,440
لذا أعتقد هذا غير مهمّ

135
00:08:48,630 --> 00:08:51,020
!هكذا يا سيّد آكيرا

136
00:08:52,770 --> 00:08:54,360
!رائع

137
00:08:54,360 --> 00:08:58,980
لو كنتُ أبطأ بثانية واحدة، لفقدتُ حياتي

138
00:08:58,980 --> 00:09:01,000
أنت تُجاملني

139
00:09:01,000 --> 00:09:02,470
لا، لا

140
00:09:02,470 --> 00:09:07,050
النموّ الّذي حقّقتَه في هذه الأسابيع القليلة
الماضية كان مُبهراً يا سيّد آكيرا

141
00:09:09,990 --> 00:09:12,220
!مُذهل

142
00:09:17,180 --> 00:09:19,030
!إنّها مُتطابقة مع لباس سيّدي

143
00:09:19,030 --> 00:09:21,670
إنّها فاضحة

144
00:09:21,670 --> 00:09:24,870
ماذا؟ لم يُعجبكما التّصميم

145
00:09:24,870 --> 00:09:27,220
!لا، يُعجبني

146
00:09:27,220 --> 00:09:28,590
!إنّه جميل

147
00:09:28,880 --> 00:09:30,420
يسرّني سماع ذلك إذاً

148
00:09:30,420 --> 00:09:33,300
أنتما جميلتان مهما ارتديتما

149
00:09:33,300 --> 00:09:36,040
!لا، لا، أنت تُبالغ الآن

150
00:09:37,480 --> 00:09:40,230
!هل قلتُ كلاماً غير ملائم ثانية؟

151
00:09:40,820 --> 00:09:42,710
!ماذا؟

152
00:09:42,960 --> 00:09:45,690
!أنت تصنع عربة؟

153
00:09:45,690 --> 00:09:47,690
،بعد التّفكير لمدّة طويلة

154
00:09:48,000 --> 00:09:52,640
ارتأيتُ أنّه من الأفضل بناء عربة مُريحة
لنفسي بدلاً من استعارة واحدة في كلّ مرّة

155
00:09:52,910 --> 00:09:56,090
يمكنني صنع العربة، لكن لا نمتلك
حصاناً وحشيّاً

156
00:09:56,090 --> 00:09:58,610
سيترتّب عليّ استعارة واحدة من النّقابة

157
00:10:00,120 --> 00:10:01,720
تاكومي-ساما

158
00:10:01,720 --> 00:10:07,340
هل تعرف لماذا تُدعى بولتون
بلدة المُغامرين"؟"

159
00:10:07,340 --> 00:10:08,320
...لا

160
00:10:08,320 --> 00:10:11,710
إنّها في الواقع المرّة الأولى الّتي
أعلم بأنّها تُدعى كذلك

161
00:10:14,710 --> 00:10:19,390
لا أصدّق بأنّني افترضتُك تعرف
!شيئاً في حين أنّك لا تعرف

162
00:10:20,080 --> 00:10:24,890
!أنا مجرّد مرحاض بارد يتظاهر بأنّه برّاد

163
00:10:25,210 --> 00:10:27,140
استعارة مرحاض أخرى؟

164
00:10:27,140 --> 00:10:29,590
إذاً، لماذا تُدعى بذلك؟

165
00:10:29,590 --> 00:10:32,390
أتتذكّر غابة الموت خارج بولتون؟

166
00:10:32,390 --> 00:10:34,900
هناك مناطق كثيرة أخرى مثلها يقطنها الوحوش

167
00:10:34,900 --> 00:10:38,460
وحتّى أنّ هناك يونيكورن وأحصنة دريك
،والّتي مُقارنة بالأحصنة الوحشيّة

168
00:10:38,460 --> 00:10:40,150
!أسرع وأقوى بكثير

169
00:10:40,150 --> 00:10:42,360
!سمعتُ أنّ هناك غريفون أيضاً

170
00:10:52,210 --> 00:10:55,630
هل أحصنة دريك أسرع بكثير
من الأحصنة الوحشيّة؟

171
00:10:55,630 --> 00:10:56,500
أجل

172
00:10:56,500 --> 00:10:58,660
تمتلك سرعة ولياقة أعظم بكثير

173
00:10:58,660 --> 00:11:01,170
من الأحصنة الوحشيّة، بالإضافة
إلى أنّها قويّة

174
00:11:01,170 --> 00:11:04,180
هل لأنّها نوع من وحوش التنّين؟

175
00:11:04,180 --> 00:11:06,470
لا، ليست وحوش تنّين

176
00:11:06,470 --> 00:11:08,640
إنّها تُشبه الأحصنة العاديّة كثيراً

177
00:11:08,640 --> 00:11:12,690
الفرق المُميّز بينها وبين الأحصنة
،هو قرن الكركدن الخاصّ بها

178
00:11:12,690 --> 00:11:16,330
وحقيقة أنّ أجسادها يُغطّيها
حراشف كما التنّين

179
00:11:16,820 --> 00:11:18,080
هكذا إذاً

180
00:11:18,080 --> 00:11:19,440
استُمِدّ الاسم من هنا إذاً

181
00:11:19,440 --> 00:11:23,410
!مولايّ، صوفيا، ماريا

182
00:11:23,410 --> 00:11:25,480
!بسرعة، بسرعة

183
00:11:25,820 --> 00:11:27,870
قيقب مُتحمّسة حقّاً

184
00:11:27,870 --> 00:11:31,520
لعلّها سعيدة لأنّها ستحصل
على كائن آخر مثلها

185
00:11:31,520 --> 00:11:34,080
!ماذا؟! قيقب

186
00:11:34,080 --> 00:11:37,310
!أليس لديكِ أنا بالفعل؟

187
00:11:40,670 --> 00:11:42,010
!ذئب دغل

188
00:11:43,420 --> 00:11:46,060
ماذا؟ عبرَ من جانبنا

189
00:11:46,060 --> 00:11:48,640
!يعزو الفضل لوعي الحجب الخاصّ بعباءاتنا

190
00:11:48,640 --> 00:11:53,560
،إذا كانت تستطيع خِداع أنف ذئب دغل
فهذا يعني بأنّها عباءات ممتازة

191
00:11:53,990 --> 00:11:56,380
...هذا صحيح. رغم أنّ

192
00:11:57,030 --> 00:11:58,010
!ماذا؟

193
00:11:58,010 --> 00:12:03,620
قد نضطرّ لخلع العباءات ونقاتل
من أجل أن نتدرّب

194
00:12:03,620 --> 00:12:07,430
انقلب مزاجها فجأة ثانية

195
00:12:11,550 --> 00:12:14,020
مُذهل. بضربة واحدة

196
00:12:14,020 --> 00:12:16,130
!حصلنا على لحم إضافيّ

197
00:12:16,130 --> 00:12:19,960
!يمكنني تجفيف اللّحم وإضافته لمخزوننا

198
00:12:19,960 --> 00:12:22,090
!لنسرع

199
00:12:22,090 --> 00:12:23,200
أجل

200
00:12:24,300 --> 00:12:26,020
هذه ترينت

201
00:12:26,020 --> 00:12:27,770
إنّها ميّتة

202
00:12:27,770 --> 00:12:30,320
لا ضير من أخذها، صحيح؟

203
00:12:30,760 --> 00:12:33,910
نحتاج خشب ترينت لصنع العربة

204
00:12:33,910 --> 00:12:36,850
...كنتُ أفكّر في شرائه من بابيك، لكن

205
00:12:36,850 --> 00:12:41,230
ترينت بهذا الحجم سيوفّر خشباً
كافياً للعربة بأكملها

206
00:12:41,230 --> 00:12:42,520
سأساعدك

207
00:12:42,520 --> 00:12:44,450
!مولايّ

208
00:12:44,450 --> 00:12:46,890
!لحم، لحم

209
00:12:46,890 --> 00:12:51,070
!خشب، خشب

210
00:12:51,370 --> 00:12:54,540
بئساً، سأسبقك

211
00:12:59,890 --> 00:13:03,850
هناك كثير من وحوش الشّجر في الأرض

212
00:13:04,970 --> 00:13:06,500
هل من شيء هناك؟

213
00:13:13,070 --> 00:13:14,420
!مُذهل

214
00:13:22,220 --> 00:13:25,310
هل أنتِ جريحة؟

215
00:13:46,320 --> 00:13:50,340
أنا قيقب. لديّ سيّد مُذهل

216
00:13:50,340 --> 00:13:52,230
سوف يُشفيك

217
00:13:58,180 --> 00:14:00,210
هل هذه الأشياء تؤذيك؟

218
00:14:07,050 --> 00:14:09,840
انتظري هنا. سأستدعي مولايّ

219
00:14:11,330 --> 00:14:13,330
!ابتعدوا

220
00:14:28,460 --> 00:14:30,790
!مولايّ! مولايّ

221
00:14:33,130 --> 00:14:35,640
!لماذا لا يستجيب؟

222
00:14:36,280 --> 00:14:39,180
كان مولايّ يركّز كثيراً على تلك الأشجار

223
00:14:39,850 --> 00:14:42,290
...إنّهم... إنّهم

224
00:14:42,290 --> 00:14:44,090
...أنا متأكّدة

225
00:14:44,090 --> 00:14:47,340
بأنّهم نسوني وعادوا إلى المنزل

226
00:14:59,890 --> 00:15:01,250
...مولايّ

227
00:15:02,570 --> 00:15:05,600
مولايّ... أيّها الأبله

228
00:15:06,660 --> 00:15:09,550
!مولايّ الغبيّ

229
00:15:13,450 --> 00:15:15,880
!لا... أستطيع

230
00:15:26,280 --> 00:15:27,410
مولايّ؟

231
00:15:27,810 --> 00:15:28,800
قيقب

232
00:15:29,660 --> 00:15:31,780
!مولايّ

233
00:15:33,140 --> 00:15:34,730
أبليتِ حسناً

234
00:15:35,340 --> 00:15:37,190
!مولايّ

235
00:15:37,460 --> 00:15:38,850
يسرّني أنّكِ بخير

236
00:15:38,850 --> 00:15:40,290
!قيقب

237
00:15:40,290 --> 00:15:41,640
!الجميع

238
00:15:41,640 --> 00:15:43,090
!ناديتكم

239
00:15:43,090 --> 00:15:45,730
!ناديتُك يا مولايّ

240
00:15:45,730 --> 00:15:46,750
أنا آسف

241
00:15:47,170 --> 00:15:48,460
كانت هذه عقبة

242
00:15:48,460 --> 00:15:52,680
أثناء حياكة هذه الخيوط لصنع طبقات
،مُتعدّة كدفاع متين

243
00:15:52,680 --> 00:15:54,890
يبدو أنّها حجبت المانا كذلك

244
00:15:55,320 --> 00:15:59,150
شعرتُ بأنّ هناك مُشكلة ما
،حالما انخفض رابط المانا بيننا

245
00:15:59,150 --> 00:16:00,980
لذا تعقّبتُ الأثر الّذي خلّفَتْه

246
00:16:01,950 --> 00:16:03,340
آسف لتأخُّري

247
00:16:03,340 --> 00:16:04,620
لا بدّ أنّكِ كنتِ خائفة

248
00:16:04,620 --> 00:16:06,550
!مولايّ

249
00:16:06,550 --> 00:16:08,230
...هـ-هذه الفتاة

250
00:16:08,230 --> 00:16:11,790
إنّها حصان دريك، أليس كذلك؟

251
00:16:11,790 --> 00:16:14,070
لا بدّ أنّه أغمي عليها بسبب جروحها البليغة

252
00:16:14,530 --> 00:16:16,760
!أرجوك يا مولايّ

253
00:16:16,760 --> 00:16:18,950
!يجب أن تنقذها

254
00:16:18,950 --> 00:16:20,060
هكذا إذاً

255
00:16:20,060 --> 00:16:22,390
كنتِ تحاولين حمايتها إذاً

256
00:16:22,390 --> 00:16:23,410
حسناً

257
00:16:27,130 --> 00:16:28,490
!صدّتْني؟

258
00:16:28,490 --> 00:16:32,300
لعلّها حذِرة حتّى أثناء غيابها عن الوعي

259
00:16:32,300 --> 00:16:33,330
!مستحيل

260
00:16:33,330 --> 00:16:34,770
!ستموت

261
00:16:35,750 --> 00:16:37,930
أشعر باقتراب وحوش آخرين

262
00:16:37,930 --> 00:16:39,390
البقاء هنا فترة أطول خطير

263
00:16:39,390 --> 00:16:43,050
!مولاي! لا تتركها! أرجوك

264
00:16:43,050 --> 00:16:44,040
لا تقلقي

265
00:16:44,040 --> 00:16:45,360
لن أتركها

266
00:16:47,380 --> 00:16:49,600
!ستضعها في بُعدك الجيبيّ؟

267
00:16:49,600 --> 00:16:52,730
قيقب، ابقي معها حتّى أستدعيكِ

268
00:16:53,000 --> 00:16:53,790
!حسناً

269
00:16:55,720 --> 00:16:57,110
!هذا تهوُّر

270
00:16:57,110 --> 00:17:00,400
لا يمكنك وضع وحش مُتقدِّم في الدّاخل
!من دون ميثاق كائن مُرافِق

271
00:17:00,400 --> 00:17:04,940
!إنّ القيام بذلك سيُشكّل جهداً على جسدك

272
00:17:04,940 --> 00:17:08,760
...لـ-لا مشكلة، لا مشكلة

273
00:17:10,030 --> 00:17:16,100
سأشرب جرعة وأتعافى

274
00:17:17,350 --> 00:17:18,870
!تاكومي-ساما

275
00:17:21,650 --> 00:17:24,890
مضى أكثر من عشرين ساعة ولم يستيقظ بعد

276
00:17:24,890 --> 00:17:26,350
هذا طبيعيّ

277
00:17:26,690 --> 00:17:28,160
،رغم أنّه نائم

278
00:17:28,160 --> 00:17:31,810
ما زال يحافظ على ذلك البُعد الجيبيّ
بالرّغم من عبئه الكبير

279
00:17:32,030 --> 00:17:34,790
وقيقب لا تخرج أيضاً

280
00:17:34,790 --> 00:17:38,240
،غالباً لأنّ تاكومي-ساما لم يستدعها

281
00:17:38,240 --> 00:17:40,340
وما زالت حصان دريك خائفة

282
00:17:40,930 --> 00:17:42,810
،ما لم تفتحه قيقب

283
00:17:42,810 --> 00:17:45,740
سيبقى البُعد الجيبيّ يحوي
،حصان دريك تلك

284
00:17:45,740 --> 00:17:48,430
وسيزداد تاكومي-ساما وهناً

285
00:17:49,440 --> 00:17:51,130
يجب أن نفعل شيئاً

286
00:17:51,460 --> 00:17:52,860
مثل ماذا؟

287
00:17:52,860 --> 00:17:54,650
...قبل أن يذبل

288
00:17:58,420 --> 00:18:00,130
!صوفيا؟

289
00:18:00,690 --> 00:18:02,930
...اتبعي تاكومي-ساما و

290
00:18:03,420 --> 00:18:04,390
قيقب؟

291
00:18:06,100 --> 00:18:08,770
قيقب، هل تسمعينني؟

292
00:18:08,770 --> 00:18:10,140
!قيقب

293
00:18:10,140 --> 00:18:11,600
صوفيا؟

294
00:18:11,600 --> 00:18:13,370
كيف حالها؟

295
00:18:13,370 --> 00:18:16,320
ما زالت خائفة

296
00:18:16,320 --> 00:18:18,430
هل يمكنكِ إخراجها من هناك؟

297
00:18:18,430 --> 00:18:21,890
قد تزداد ارتباكاً إذا ظهرتْ
فجأة في مكان غير مألوف

298
00:18:22,400 --> 00:18:26,380
رغم ذلك، لا يمكننا أن نُعالجها
إذا لم تخرج

299
00:18:26,380 --> 00:18:29,030
سيبقى تاكومي-ساما غائباً
عن الوعي أيضاً

300
00:18:29,440 --> 00:18:30,490
أجل

301
00:18:30,490 --> 00:18:34,160
هل يمكنكِ صنع نفس حاجز الخيوط
الّذي استخدمتِه في الغابة؟

302
00:18:34,160 --> 00:18:37,770
قد تُخفَّف مخاوف حصان دريك إذا
لم تستطع رؤية ما وراء الحاجز

303
00:18:38,600 --> 00:18:40,940
هكذا إذاً

304
00:18:40,940 --> 00:18:42,120
!عُلِم

305
00:18:43,380 --> 00:18:44,570
!سأفعلها

306
00:18:44,570 --> 00:18:46,260
!سأخرجها في الحديقة

307
00:18:47,950 --> 00:18:49,200
صوفيا؟

308
00:18:49,200 --> 00:18:50,500
إلى أين أنتِ ذاهبة؟

309
00:18:50,500 --> 00:18:52,020
شركة بابيك

310
00:18:52,710 --> 00:18:54,750
سأشتري بعض الأعشاب الطبّية للوحوش

311
00:18:54,750 --> 00:18:57,400
!من فضلكِ دعيني أتولّى هذه المهمّة

312
00:18:57,400 --> 00:19:03,230
صوفيا، من فضلكِ ابقي مع تاكومي-ساما
!كي تكوني هنا عندما يستيقظ

313
00:19:03,230 --> 00:19:04,740
!سأغادر

314
00:19:08,730 --> 00:19:12,730
هذا دافئ

315
00:19:13,150 --> 00:19:14,670
تاكومي-ساما

316
00:19:15,170 --> 00:19:17,030
استيقظ أرجوك

317
00:19:18,020 --> 00:19:21,170
!حضّرتُ حساء لذيذاً لك

318
00:19:21,170 --> 00:19:24,570
!مولايّ! أيّها النّعسان

319
00:19:24,570 --> 00:19:26,620
هكذا إذاً

320
00:19:27,160 --> 00:19:28,550
يجب أن أستيقظ

321
00:19:35,080 --> 00:19:36,990
...هذا الدّفء

322
00:19:43,610 --> 00:19:46,150
!تاكومي-ساما

323
00:19:46,150 --> 00:19:47,310
صباح الخير

324
00:19:47,720 --> 00:19:50,130
يبدو أنّكن كنتُن تبذلن قصارى جهدكن

325
00:19:50,130 --> 00:19:53,620
يسرّني وجودكن جميعاً معي

326
00:19:54,330 --> 00:19:57,170
والآن يجب عليّ مُداواة حصان دريك تلك

327
00:19:58,960 --> 00:20:01,510
!مولايّ، ادخل

328
00:20:06,730 --> 00:20:08,810
إنّه هو من كنتِ أحدّثكِ عنه

329
00:20:08,810 --> 00:20:10,690
الشّخص الّذي سينقذكِ

330
00:20:10,690 --> 00:20:12,720
تعافَتْ بشكل واضح

331
00:20:12,720 --> 00:20:16,040
بذلتْ قيقب قصارى جهدها لمُعالجتها

332
00:20:16,040 --> 00:20:17,050
...في هذه الحالة

333
00:20:17,620 --> 00:20:20,060
يبدو أنّكِ وقيقب أصبحتُما
صديقتين حميمتين الآن

334
00:20:20,060 --> 00:20:22,750
هلّا صرتِ صديقتي أيضاً؟

335
00:20:22,750 --> 00:20:24,110
من فضلكِ

336
00:20:36,000 --> 00:20:37,300
مولايّ؟

337
00:20:37,730 --> 00:20:38,740
!ممتاز

338
00:20:41,930 --> 00:20:43,640
!الشّفاء الرّفيع

339
00:21:02,520 --> 00:21:04,810
،بفضل كلّ الجهود الّتي بذلتنّها

340
00:21:05,280 --> 00:21:07,440
حصلنا على شريكة جديدة

341
00:21:07,690 --> 00:21:10,440
مولايّ، ماذا عن اسمها؟

342
00:21:10,440 --> 00:21:11,760
...لنرَ

343
00:21:11,760 --> 00:21:15,140
سمّيتُكِ قيقب بسبب الشّكل في بطنكِ

344
00:21:15,140 --> 00:21:17,090
الّذي يشبه ورقة القيقب، أليس كذلك؟

345
00:21:17,890 --> 00:21:21,200
!لنُسمّها باسم ورقة شجر أيضاً

346
00:21:26,960 --> 00:21:28,010
كاميليا

347
00:21:28,010 --> 00:21:29,340
كاميليا؟

348
00:21:29,340 --> 00:21:30,130
أجل

349
00:21:30,130 --> 00:21:32,480
،إنّها شجرة تستردّ أوراقها على مدار العام

350
00:21:32,790 --> 00:21:35,310
وتتفتّح بزهور حمراء وبيضاء

351
00:21:35,650 --> 00:21:37,770
!يا له من اسم جميل

352
00:21:37,770 --> 00:21:38,660
أجل

353
00:21:38,660 --> 00:21:41,160
!كاميليا! أنا مسرورة لأجلكِ

354
00:21:41,710 --> 00:21:45,210
أتعلمين؟ كنتُ أشعر بالوحشة عندما كنتُ
جريحة ووحيدة في الغابة

355
00:21:45,210 --> 00:21:47,120
...كنتُ حزينة وخائفة

356
00:21:47,120 --> 00:21:49,010
...ثمّ أنقذني مولايّ

357
00:21:49,010 --> 00:21:51,600
!فغمرتني السّعادة حقّاً

358
00:21:51,600 --> 00:21:54,030
لذا أردتُ مُساعدتكِ

359
00:21:54,030 --> 00:21:56,420
!حسناً! لنتناول بعض الطّعام

360
00:21:56,730 --> 00:21:59,590
!انتهيتُ من إعداد طعام لذيذ للتو

361
00:21:59,590 --> 00:22:02,300
!أنا أتضوّر جوعاً

362
00:22:02,300 --> 00:22:04,820
!هذا لأنّك لم تأكل ليوم كامل

363
00:22:04,820 --> 00:22:07,640
!أنا جائعة أيضاً