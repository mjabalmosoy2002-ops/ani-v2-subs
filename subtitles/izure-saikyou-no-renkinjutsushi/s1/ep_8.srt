1
00:00:19,750 --> 00:00:21,550
!هذا مُبهر

2
00:00:21,550 --> 00:00:24,170
...تركيب سبيكة الأدامانتيت

3
00:00:24,170 --> 00:00:26,550
...بدائرة خيمياء مُعقّدة كهذه

4
00:00:26,970 --> 00:00:33,490
رغم ذلك، التّركيبة الرّئيسيّة هي نفسها
تركيبة دائرة الحلويّات اللّولبيّة

5
00:00:33,490 --> 00:00:36,060
!سأفعل هذا

6
00:00:36,060 --> 00:00:41,010
ستتمكّنين من صنع دوائر خيمياء
كهذه عمّا قريب يا ريفا

7
00:00:42,140 --> 00:00:44,110
أتعتقد بأنّني سأفعل؟

8
00:00:44,110 --> 00:00:45,980
...إنّها مُتقدِّمة جدّاً

9
00:00:45,980 --> 00:00:47,360
ستفعلين بالطّبع

10
00:00:47,360 --> 00:00:53,530
فأساساً تمتلكين أكثر ميزة
هامّة يحتاجها الخيميائيّ

11
00:00:53,530 --> 00:00:55,180
ما هي؟

12
00:00:55,570 --> 00:00:59,900
عيناكِ تتلألآن حماساً بينما تُشاهدين
عمليّة تركيب الأمور معاً

13
00:01:00,150 --> 00:01:03,880
!أجل! هذا أخّاذ جدّاً

14
00:01:03,880 --> 00:01:06,540
حسناً، أعتقد إذاً بأنّني سأدعكِ تساهمين

15
00:01:06,540 --> 00:01:09,130
في تركيب بعض المُكوّنات البسيطة تالياً

16
00:01:09,130 --> 00:01:11,290
!أجل! سأفعلها

17
00:02:49,630 --> 00:02:52,960
أهذه عربتك؟

18
00:02:52,960 --> 00:02:54,350
لا

19
00:02:54,350 --> 00:02:57,030
إنّها عربة ستُقدّم لجلالة الملك

20
00:02:57,030 --> 00:02:58,870
صنعتُها مؤخّراً

21
00:02:58,870 --> 00:03:00,310
صنعتَها؟

22
00:03:00,310 --> 00:03:01,340
أنت من فعل؟

23
00:03:01,340 --> 00:03:02,350
أجل

24
00:03:02,350 --> 00:03:06,540
أنت أفضل حتّى ممّا سمعت
يا سيّد تاكومي إيروما

25
00:03:06,540 --> 00:03:09,130
ماذا؟ ما أدراك باسمي؟

26
00:03:09,130 --> 00:03:11,500
!جـ-جلالتك

27
00:03:11,500 --> 00:03:12,460
جلالتك"؟"

28
00:03:13,120 --> 00:03:15,490
أعتذر على التّعريف المتأخّر

29
00:03:15,490 --> 00:03:18,790
أنا من يحكم هذه المملكة، لوبوس باركولا

30
00:03:18,790 --> 00:03:22,450
!أنت الملك؟

31
00:03:23,470 --> 00:03:26,040
لا حاجة لهذه الرّسميّات يا سيّد إيروما

32
00:03:26,040 --> 00:03:28,430
هذه مُقابلة غير رسميّة

33
00:03:28,430 --> 00:03:32,890
ظـ-ظننتُ بأنّ المُقابلة ستكون
!في غرفة الاستقبال

34
00:03:32,890 --> 00:03:35,150
هل يوجد معنى أعمق وراء هذا؟

35
00:03:35,150 --> 00:03:36,400
بالطّبع

36
00:03:37,180 --> 00:03:41,700
أن أجعلك تنتظر في غرفة خانقة
،لمُقابلة شخصيّة معي

37
00:03:41,700 --> 00:03:46,110
فقط كي أظهر بموكب من الأتباع مُتباهياً

38
00:03:46,110 --> 00:03:49,110
!سيكون أمراً رسميّاً ومُملّاً

39
00:03:50,430 --> 00:03:53,070
حسناً، لنضع المُزاح جانباً

40
00:03:53,340 --> 00:03:58,290
أردتُ اللّقاء بهذا الخيميائيّ الشّهير
وأشكره دون رسميّات

41
00:03:58,290 --> 00:04:00,250
تـ-تشكرني؟

42
00:04:00,250 --> 00:04:01,650
سيّد إيروما

43
00:04:01,650 --> 00:04:05,430
بفضلك، وجدت العاصمة الملكيّة
حلّاً لمُشكلة المجارير خاصّتها

44
00:04:05,430 --> 00:04:06,370
أشكرك

45
00:04:06,370 --> 00:04:09,460
إ-إطلاقاً! لـ-ليس عليك الانحناء
!برأسك لي، جلالتك

46
00:04:10,070 --> 00:04:13,300
في العادة، كنتُ لأقيم مأدبة ضخمة

47
00:04:13,300 --> 00:04:16,190
وأمنحك مُكافآت فاخرة ومُترفة

48
00:04:16,590 --> 00:04:19,990
لكن قد يخلق ذلك مخاطر تدخُّل غير مرغوبة

49
00:04:19,990 --> 00:04:21,110
سامحني

50
00:04:21,110 --> 00:04:27,400
لا، أنا ممتنّ لإبقائك لي بعيداً
عن خطوط نيران سيدونيا

51
00:04:27,920 --> 00:04:32,400
إنّ حماية الشّعب هو واجبي كملِك

52
00:04:32,890 --> 00:04:34,370
هذا مُطمئن

53
00:04:34,370 --> 00:04:39,090
يبدو أنّه كما الحاكم، الملك ليس مغروراً

54
00:04:42,870 --> 00:04:47,980
أعطاني الملك مُكافأة على الأدوات
،السّحريّة الّتي حلّتْ مُشكلة مجاريرهم

55
00:04:47,980 --> 00:04:50,350
ثمّ غادرنا القلعة

56
00:04:52,230 --> 00:04:54,370
سايمون، غالاهات

57
00:04:54,370 --> 00:04:57,530
لم ألتقِ مع أحد اليوم

58
00:04:57,530 --> 00:04:58,430
مفهوم؟

59
00:04:58,430 --> 00:04:59,280
حاضر

60
00:04:59,280 --> 00:05:01,690
سأصدر أمراً بالكتمان على أولئك
الموجودين داخل القلعة

61
00:05:01,920 --> 00:05:05,570
لكن، حالما نُصدّر تلك الأدوات السّحريّة
،إلى دول أخرى

62
00:05:05,570 --> 00:05:09,350
فسينتشر نفوذ إيروما أكثر فأكثر

63
00:05:09,350 --> 00:05:12,500
هذا بالضّبط ما أنا قلق بشأنه

64
00:05:13,050 --> 00:05:17,390
حالما يحدث ذلك، فإنّ كنيسة النُّور
الإلهيّ سوف تتصرّف بلا شكّ

65
00:05:19,850 --> 00:05:22,560
بعد أيّام من عودتنا إلى بولتون
،من العاصمة الملكيّة

66
00:05:23,300 --> 00:05:28,620
اشتريتُ رسميّاً القصرَ الّذي كنتُ
أستأجره من خلال شركة بابيك

67
00:05:31,960 --> 00:05:35,900
إنّه... ديارنا الآن

68
00:05:38,920 --> 00:05:42,150
ماذا؟ لا تريدين أي أجور ثانية؟

69
00:05:42,150 --> 00:05:45,430
أنت توفّر لنا الكثير من الطّعام بالفعل

70
00:05:45,430 --> 00:05:48,920
لذا أنا سعيدة بالمصروف المعتاد
الّذي تقدّمه لي

71
00:05:48,920 --> 00:05:51,130
لستُ بحاجته أيضاً

72
00:05:51,360 --> 00:05:54,170
،رغم ذلك، حتّى لو لم تحتاجاه الآن

73
00:05:54,170 --> 00:06:00,080
ألن يكون من الجيّد ادّخار المال تحسُّباً
لليوم الّذي ينتهي فيه عقدكما معي؟

74
00:06:00,290 --> 00:06:04,870
كإيلف، سأعيش عمراً أطول من عمرك

75
00:06:04,870 --> 00:06:09,550
لذا سأقضي أيّامي المُتبقّية أحمي قبرك

76
00:06:09,550 --> 00:06:10,340
ماذا؟

77
00:06:10,340 --> 00:06:14,250
،إذا استطعتُ العيش أكثر منك بيوم واحد

78
00:06:14,250 --> 00:06:18,990
،ثمّ وُضِع قبري بجانب قبرك
!فسيكون ذلك مثاليّاً

79
00:06:21,890 --> 00:06:23,510
هكذا إذاً

80
00:06:23,890 --> 00:06:28,000
إذاً هذه هي الأداة السّحريّة الّتي تُستخدَم
لتطهير المجارير في بولتون

81
00:06:28,360 --> 00:06:33,450
أجل. اخترقنا باكيلاتوس وتمكنّا
من الحصول على واحدة

82
00:06:33,450 --> 00:06:36,820
يا لها من أداة سحريّة هرطقيّة مُثيرة للاشمئزاز

83
00:06:37,330 --> 00:06:40,490
يتصرّفون دون خوف من غضب آنات

84
00:06:40,490 --> 00:06:43,550
أبتي، البابا فالبار، قد حزن
حزناً شديداً على هذا

85
00:06:43,950 --> 00:06:45,940
،داخل كنيسة النُّور الإلهيّ

86
00:06:45,940 --> 00:06:50,510
هناك أولئك الّذين يقولون بأنّنا ينبغي
أن نستأصل هذا الشرّ فوراً

87
00:06:50,510 --> 00:06:53,250
تقصد سرب النُّور الإلهيّ على ما أعتقد

88
00:06:53,250 --> 00:06:53,980
أجل

89
00:06:54,560 --> 00:06:57,000
يقطن مصدر هذا الشرّ في بولتون

90
00:06:57,440 --> 00:07:01,480
لن نتحمّل أولئك الّذين يُهدِّدون
كرامة البابا وآنات

91
00:07:01,770 --> 00:07:05,690
لا ضير من استئصال هذه الكارثة
من جذورها وبسرعة

92
00:07:06,060 --> 00:07:09,290
عسى أن يسير كلّ شيء وفق
مشيئة آنات العظيمة

93
00:07:11,760 --> 00:07:14,110
التّسجيل في نقابة المُغامرين؟

94
00:07:14,110 --> 00:07:15,040
أجل

95
00:07:15,040 --> 00:07:19,590
،أرغب في المُساهمة كمُغامِرة أيضاً
مثلما تفعل صوفيا وماريا

96
00:07:19,590 --> 00:07:23,920
،من أجل مساعدتك كخيميائيّة وحِرفيّة

97
00:07:23,920 --> 00:07:27,290
أريد تعزيز إحصائيّاتي وتعزيز المانا
!خاصّتي أكثر فأكثر حتّى

98
00:07:27,560 --> 00:07:28,950
هكذا إذاً

99
00:07:28,950 --> 00:07:32,490
أعتقد من الصّحيح أنّ المُغامرة هي
وسيلة جيّدة لتعزيز المانا خاصّتك

100
00:07:32,490 --> 00:07:33,300
أجل

101
00:07:34,570 --> 00:07:37,220
تفضّلي بطاقتك الشّخصيّة يا ريفا

102
00:07:37,220 --> 00:07:39,400
!شكراً جزيلاً لك

103
00:07:39,400 --> 00:07:45,180
أنا ممتنّة لأنّك ترغب في إرسال مالي
!إلى المنزل بأجور بسيطة كذلك

104
00:07:45,180 --> 00:07:48,340
هناك الكثير من المُغامرين أمثالكِ
الّذين يطلبون منّا

105
00:07:48,340 --> 00:07:50,380
إرسال المال إلى عائلاتهم

106
00:07:50,650 --> 00:07:52,310
من السّهل التّعامل مع ذلك

107
00:07:52,310 --> 00:07:53,600
هذا نافع جدّاً

108
00:07:53,600 --> 00:07:55,670
،بالمناسبة يا تاكومي

109
00:07:55,670 --> 00:07:58,740
ألم تمنح اسماً لفريقك؟

110
00:07:58,740 --> 00:08:00,070
اسم لفريقي؟

111
00:08:00,270 --> 00:08:03,050
الجميع عدا ريفا برتبة د

112
00:08:03,050 --> 00:08:08,550
لكن، بصراحة، فريقك هو إحدى الفرق
النّخبة في نقابتنا

113
00:08:08,550 --> 00:08:10,830
لا يمكنكم البقاء بلا اسم للأبد

114
00:08:10,830 --> 00:08:14,830
اسم فريق... تقصد كناب الأسد؟

115
00:08:14,830 --> 00:08:15,510
أجل

116
00:08:15,510 --> 00:08:19,510
لكن لم تكن نيّتي أن أكون مُغامراً

117
00:08:19,510 --> 00:08:23,630
فضلاً عن ذلك، ليس لدينا تقسيم أدوار
واضح كالثّلاثة في ناب الأسد

118
00:08:23,630 --> 00:08:26,730
ليس لدينا مُقاتل جبهة ببساطة

119
00:08:26,730 --> 00:08:30,200
قد يكون من الأفضل لو أكون قادراً
على القتال في نقطة أقرب إلى الجبهة

120
00:08:30,200 --> 00:08:31,870
!دع هذا الأمر لي

121
00:08:32,930 --> 00:08:34,080
!باراك؟

122
00:08:34,080 --> 00:08:35,910
!إنّه ضخم

123
00:08:35,910 --> 00:08:37,950
!جسد المُغامر هو ثروته الكبرى

124
00:08:37,950 --> 00:08:40,910
إذا كان لديك جسد قويّ، فيمكنك حينها
!النّجاة من أيّ شيء يحدث

125
00:08:40,910 --> 00:08:42,830
هل سمعتَ ما قلتُه؟

126
00:08:42,830 --> 00:08:45,280
—أنا لا أطمح لأكون مُغامراً

127
00:08:45,280 --> 00:08:46,490
!سأدرّبك

128
00:08:49,650 --> 00:08:51,510
!انهض من جديد

129
00:08:52,970 --> 00:08:57,480
!أخبرك هانس أن تجد اسماً للفريق، صحيح؟

130
00:08:58,110 --> 00:08:59,950
!ألم تفكّر في شيء؟

131
00:08:59,950 --> 00:09:03,530
!فـ-فكّرتُ في شيء

132
00:09:03,530 --> 00:09:05,550
!ما الاسم الّذي تقترحه؟

133
00:09:05,550 --> 00:09:08,270
نـ-نحن مُغامرون

134
00:09:08,270 --> 00:09:11,250
!ماذا؟! مرفوض

135
00:09:11,250 --> 00:09:13,690
!مؤلم

136
00:09:14,250 --> 00:09:18,170
ما الّذي يرمز إلى تاكومي إيروما
!الّذي وُلِد في هذا العالم؟

137
00:09:18,410 --> 00:09:21,120
!والآن تكلّم! اذكر اسم فريقك

138
00:09:21,120 --> 00:09:23,580
ا-الأب الرُّوحيّ للمراحيض

139
00:09:23,580 --> 00:09:25,840
!هل تتّخذ الأمر بجدّية؟

140
00:09:26,030 --> 00:09:29,610
!اختر شيئاً أكثر اختصاراً مثل ناب الأسد

141
00:09:29,610 --> 00:09:31,130
!غطاء المرحاض

142
00:09:31,130 --> 00:09:33,500
!أخرج فكرة المراحيض من رأسك

143
00:09:33,500 --> 00:09:35,920
...الطّريق إلى تعلّم الخيميائيّة

144
00:09:35,920 --> 00:09:38,130
هو طريق شائك

145
00:09:39,860 --> 00:09:42,150
اسم فريقنا؟

146
00:09:42,150 --> 00:09:45,690
أجل. هل يمكنك إيجاد اسم جيّد؟

147
00:09:45,690 --> 00:09:50,170
،إنّه يلوّح بي ويرميني كلّما رفضَ اسماً
ولن يصمد جسدي على هذا المُعدّل

148
00:09:51,160 --> 00:09:54,390
ما رأيك بـ"تاكومي-ساما وخدمه"؟

149
00:09:54,690 --> 00:09:59,110
غالباً سيتمّ رميي بسبب الأسماء
ذات الوصف القصير

150
00:09:59,110 --> 00:10:00,270
!وجدتُها

151
00:10:00,270 --> 00:10:05,040
ما رأيك بـ"مُغامر يُتقن الخيمياء وحارسته
،الشّخصيّة، وخادمته

152
00:10:05,040 --> 00:10:09,600
وحيوانتيه الأليفتين، وخيميائيّة مُتدرِّبة"؟

153
00:10:09,600 --> 00:10:13,040
هذا وصف مُفصّل، لكنّه طويل جدّاً

154
00:10:13,040 --> 00:10:17,600
طلب منّي أن أبحث عن اسم
أفضل يُمثّل مَن نكون

155
00:10:18,260 --> 00:10:21,370
مراحيض وبرّادات ولِباس تحتيّ وتاكومي-ساما"؟"

156
00:10:21,370 --> 00:10:23,940
غالباً سيتمّ قذفي من أربع
إلى خمس مرّات مقابل هذا

157
00:10:25,210 --> 00:10:30,170
لـ-لا أصدّق بأنّني اقترحتُ اسماً سيؤدّي
!إلى رميك من أربع إلى خمس مرّات

158
00:10:30,170 --> 00:10:35,550
أنا مجرّد مرحاض سائر بلافتة كُتِب
--"!عليها "سأتولّى الأعمال المنزليّة

159
00:10:35,550 --> 00:10:38,400
!لا، بل أدنى من ذلك حتّى

160
00:10:39,240 --> 00:10:41,150
...ا-المعذرة يا ماريا

161
00:10:41,150 --> 00:10:45,230
أخبرني باراك بأن أُخرج من رأسي
فكرة المراحيض أيضاً

162
00:10:45,230 --> 00:10:48,400
من الصّعب إيجاد اسم، أليس كذلك؟

163
00:10:48,400 --> 00:10:50,120
هل لديك أي أفكار يا صوفيا؟

164
00:10:50,120 --> 00:10:51,750
!كيف يجرؤ؟

165
00:10:51,750 --> 00:10:54,070
!تاركاً تاكومي-ساما بائساً هكذا

166
00:10:54,440 --> 00:10:57,290
!كيف يجرؤ، كيف يجرؤ، كيف يجرؤ؟

167
00:10:57,290 --> 00:10:59,250
!صـ-صوفيا؟

168
00:10:59,250 --> 00:11:02,640
!سأغادر الآن لقتل ذلك الرّجل الضّخم

169
00:11:02,640 --> 00:11:04,520
!انتظري، انتظري

170
00:11:04,520 --> 00:11:06,270
!إنّه يدرّبني فحسب! هذا كلّ شيء

171
00:11:06,270 --> 00:11:07,190
...لكن

172
00:11:07,410 --> 00:11:10,530
صحيح أنّني، بفضله، تمكّنتُ من ترقية

173
00:11:10,530 --> 00:11:15,890
مهارات الحدس والمُراوغة والتحكُّم
بالجسد والفنون القتاليّة خاصّتي

174
00:11:18,350 --> 00:11:22,250
يبدو أنّني سأعاني حتّى نحدّد اسماً

175
00:11:33,330 --> 00:11:34,800
هيّا! ما الأمر؟

176
00:11:34,800 --> 00:11:36,360
أتتحفّظ من جديد؟

177
00:11:36,360 --> 00:11:37,750
!لستُ بحاجة ذلك بعد الآن

178
00:11:40,530 --> 00:11:43,150
لا ينفكّ يهاجم دون تردُّد

179
00:11:43,150 --> 00:11:45,470
لن يفلح ذلك في القتال الحقيقيّ

180
00:11:45,470 --> 00:11:47,600
وهل سينجح أسلوبك؟

181
00:11:47,600 --> 00:11:49,380
أنا بطل

182
00:11:49,380 --> 00:11:52,140
ياماتو وأنا نُدعى كذلك أيضاً

183
00:11:52,520 --> 00:11:55,980
الأهمّ، ما رأيكِ أن نترك هذا ونذهب
إلى مكان ما معاً؟

184
00:11:55,980 --> 00:11:56,600
لا، شكراً

185
00:11:56,780 --> 00:11:58,160
ماذا؟

186
00:11:58,160 --> 00:12:01,610
هل أنتِ قلقة من مُراقبة الخادمة
العبدة الخاصّة بك؟

187
00:12:01,610 --> 00:12:06,480
مهلاً، مهلاً، تتصرّفين مثلما كنتِ
قبل أن يتمّ استدعاؤنا

188
00:12:07,220 --> 00:12:09,590
كنتَ أقلّ سوءاً آنذاك

189
00:12:17,150 --> 00:12:22,350
خلقت آنات البشريّة، ثمّ خلقت البشر"
"الوحوش والإيلف لخدمتهم

190
00:12:22,660 --> 00:12:26,580
تعِظ كنيسة النُّور الإلهيّ بالسّيادة
المُطلَقة للبشريّة

191
00:12:26,580 --> 00:12:32,260
استناداً إى ما سمعتُه قبل أيّام
،من تجّار يُسافرون من بلد إلى آخر

192
00:12:32,260 --> 00:12:37,250
كنيسة الخلق تعلّم بأنّ "كافّة
"الأعراق هم أبناء نولين

193
00:12:38,050 --> 00:12:43,450
هذه الدّولة المحكومة بواسطة كنيسة
...النّور الإلهيّ استدعَتْنا، لذا ماذا يُفترض

194
00:12:45,270 --> 00:12:46,570
أن يكون دورنا؟

195
00:12:47,910 --> 00:12:50,320
،يخبروننا بأنّنا هنا من أجل السّلام العالميّ

196
00:12:50,870 --> 00:12:52,920
لكن ما الّذي يحاولون أن يجعلونا نفعل؟

197
00:12:54,150 --> 00:12:55,110
تفضّلي

198
00:12:55,580 --> 00:12:58,250
هل هذا لي؟

199
00:12:58,530 --> 00:13:02,960
إنّه خاتم لتفعيل التّعويذات، وقلتِ
،بأنّكِ تستطيعين استخدام عصا

200
00:13:02,960 --> 00:13:05,000
لذا صنعتُ لكِ واحدة من ترينت شيخ

201
00:13:05,500 --> 00:13:08,460
إنّه ملفوف بسبيكة ميثريليّة

202
00:13:08,900 --> 00:13:12,100
ستحتاجين عتاداً جيّداً عندما نذهب للمُغامرة

203
00:13:12,100 --> 00:13:13,670
!شكراً جزيلاً لك

204
00:13:14,050 --> 00:13:17,360
محظوظة! تحصلين على أسلحة

205
00:13:17,360 --> 00:13:18,840
هذا لكِ يا قيقب

206
00:13:18,840 --> 00:13:21,140
!سـ-سلاح لي أنا؟

207
00:13:21,140 --> 00:13:25,950
عرفتُ بأنّكِ ستحتاجين واحداً لا يعرقلكِ
عندما تتحكّمين بخيوطكِ

208
00:13:25,950 --> 00:13:28,110
طلبتُ من ريفا أن تُساعدني في صنعه

209
00:13:28,110 --> 00:13:31,760
!شكراً لك يا مولايّ! ويا ريفا

210
00:13:33,890 --> 00:13:35,280
!مِخلب القطّ

211
00:13:36,230 --> 00:13:38,490
!كفّ عن التّركيز على ناب الأسد

212
00:13:38,490 --> 00:13:39,900
!تاكومي-ساما

213
00:13:39,900 --> 00:13:44,710
،ما رأيك بـ"اسحق ذلك الضّخم
تاكومي-ساما وخادماته"؟

214
00:13:45,320 --> 00:13:46,680
!مؤلم

215
00:13:45,750 --> 00:13:46,680
!مرفوض

216
00:13:46,940 --> 00:13:48,050
هذا سيّئ

217
00:13:48,050 --> 00:13:50,950
على هذا المُعدّل، صوفيا قد تفقد صوابها

218
00:13:51,380 --> 00:13:54,090
!تاكومي-ساما، دفاعك ضعيف جدّاً

219
00:13:54,090 --> 00:13:54,860
ماذا؟

220
00:13:54,860 --> 00:13:56,440
!لديك كثير من الثّغرات

221
00:13:56,440 --> 00:13:57,820
!استجِب بشكل أسرع

222
00:13:57,820 --> 00:14:02,550
إنّ هجمات رئيس النّقابة تستهدف
!نقاط ضعفك بشكل مُباشر

223
00:14:02,550 --> 00:14:04,670
تحوّلَتْ إلى مُدرِّبة لي

224
00:14:05,400 --> 00:14:08,730
تاكومي، هل أنت مهتمّ بقبول مهمّة مُرافقة؟

225
00:14:08,730 --> 00:14:10,700
فكرة سديدة

226
00:14:10,700 --> 00:14:12,960
إن نجحت، سوف تترقّى رتبتك

227
00:14:12,960 --> 00:14:16,420
مُرافِق؟ كم يوماً سيستغرق ذلك؟

228
00:14:16,640 --> 00:14:22,890
في الواقع، بعربتك، سيستغرق وصولك
إلى بلدة كيلبوس والعودة أربعة أيّام

229
00:14:23,210 --> 00:14:25,820
الطّلب من شركة بابيك

230
00:14:25,820 --> 00:14:29,330
ألا يتولّى الثّلاثة من ناب الأسد
مهام المُرافقة في العادة؟

231
00:14:29,330 --> 00:14:33,820
مع الأسف، ناب الأسد في مهمّة
مختلفة في الوقت الحالي

232
00:14:34,250 --> 00:14:38,740
إنّ العمل كبديل لناب الأسد هو
مسؤوليّة ضخمة

233
00:14:42,270 --> 00:14:44,070
سنقبل بالمهمّة

234
00:14:44,370 --> 00:14:48,020
جِد اسماً لفريقك عندما تعود، حسناً؟

235
00:14:50,740 --> 00:14:53,710
!مرحى

236
00:14:52,150 --> 00:14:54,080
!هيّا يا وحوش

237
00:14:54,080 --> 00:14:56,190
!تعالوا إليّ إن استطعتم

238
00:14:57,290 --> 00:15:01,120
من المُطمئن أن تُرافقوني جميعاً

239
00:15:01,120 --> 00:15:04,830
سيكون من اللّطيف ألّا نتعرّض
لأيّ هجوم من وحش

240
00:15:05,100 --> 00:15:09,290
حزمنا الكثير من الحاجيّات اليوميّة
بالإضافة إلى أدوات السّحريّة التّطهيريّة

241
00:15:09,690 --> 00:15:14,130
طلب منّي رئيسنا شراء حليب في طريقي أيضاً

242
00:15:14,130 --> 00:15:16,260
ماذا؟ لديهم حليب هناك؟

243
00:15:16,260 --> 00:15:20,000
أجل، رغم أنّه نادراً ما يصل إلى بولتون

244
00:15:20,000 --> 00:15:22,630
لديهم مُنتجات أخرى من مشتقّات الحليب أيضاً

245
00:15:22,630 --> 00:15:26,820
كان... أجل، الجبنة

246
00:15:26,820 --> 00:15:28,030
!جبنة؟

247
00:15:28,460 --> 00:15:31,040
!لديهم حليب وجبنة

248
00:15:35,900 --> 00:15:37,180
وحوش؟

249
00:15:45,470 --> 00:15:48,710
يبدو أنّ صِراعاً على الأرض قد اندلع
بين الغوبلين وذئاب الدّغل

250
00:15:48,710 --> 00:15:51,520
!كاميليا، هيّا

251
00:16:01,100 --> 00:16:03,340
ماتوا بلمح البصر؟

252
00:16:03,340 --> 00:16:07,930
أشكّ في أنّ هناك وحوشاً ترغب
في مُهاجمة هذه القافلة

253
00:16:09,100 --> 00:16:11,490
!كانوا ضعفاء تماماً

254
00:16:17,520 --> 00:16:19,620
!إنّه حساء الكريمة

255
00:16:19,620 --> 00:16:22,710
!إنّه حساء أبيض؟ كم هذا غريب

256
00:16:22,710 --> 00:16:24,580
!لكن رائحته لطيفة

257
00:16:24,580 --> 00:16:26,870
!حان وقت الأكل

258
00:16:31,290 --> 00:16:33,010
!لذيذ

259
00:16:33,290 --> 00:16:36,730
،أجل، يحتاج بعض التّحسينات

260
00:16:37,230 --> 00:16:38,780
لكنّه مذاق يبعث على الحنين

261
00:16:40,710 --> 00:16:42,140
تاكومي-ساما؟

262
00:16:42,470 --> 00:16:45,960
يجب أن نشتري حليباً وجبنة قبل
أن نعود إلى المنزل

263
00:16:45,960 --> 00:16:49,110
سمعتُ أنّ السُّوق مفتوح ليلاً
في هذه البلدة

264
00:16:49,460 --> 00:16:50,330
أجل

265
00:16:54,570 --> 00:16:56,110
!لذيذ جدّاً

266
00:16:56,110 --> 00:16:59,270
هذه أوّل مرّة آكل فيها جبنة

267
00:16:59,270 --> 00:17:02,750
ليتني أستطيع أن أدع أمّي وأخي
الصّغير يتذوّقان هذا أيضاً

268
00:17:03,740 --> 00:17:07,160
لم يمضِ إلّا أشهر قليلة
،منذ جئتُ إلى هذا العالم

269
00:17:07,910 --> 00:17:11,170
ومع ذلك أشعر وكأنّه مضى سنوات بالفعل

270
00:17:12,100 --> 00:17:15,730
لن أعود أبداً إلى حياتي القديمة

271
00:17:15,730 --> 00:17:18,380
أنا في عالم آخر

272
00:17:18,880 --> 00:17:22,360
لا بدّ أنّ سبب مُراودة أفكار كهذه
لي هو الحليب والجبنة

273
00:17:22,360 --> 00:17:25,360
ما يجعلني أشعر بالحنين لعالمي القديم

274
00:17:26,730 --> 00:17:28,330
مُحال أن يكون هناك أرزّ؟

275
00:17:28,880 --> 00:17:31,020
لا يوجد أرزّ هنا، صحيح؟

276
00:17:31,340 --> 00:17:35,480
هل تشير إلى الحبوب الّتي يأكلونها
في مملكة ساماندور؟

277
00:17:35,860 --> 00:17:38,040
!لديهم أرزّ؟

278
00:17:38,040 --> 00:17:40,620
لكنّه غير مُتوفّر في السّوق في باركولا

279
00:17:40,620 --> 00:17:43,130
أعتقد كانوا يبيعونه في العاصمة الملكيّة

280
00:17:43,130 --> 00:17:46,250
!مستحيل

281
00:17:44,450 --> 00:17:48,660
!لو كنتُ أعلم، لألقيتُ نظرة في السّوق

282
00:17:48,660 --> 00:17:51,560
تريد أن تأكل أرزّاً إلى هذا الحدّ؟

283
00:17:51,560 --> 00:17:53,640
أجل، بالطّبع

284
00:17:53,980 --> 00:17:57,980
سـ-سمعتُ إشاعات، لذا أردتُ تجربته

285
00:17:59,600 --> 00:18:03,180
تاكومي-ساما؟ هل حدث شيء؟

286
00:18:03,620 --> 00:18:05,070
...صوفيا

287
00:18:05,070 --> 00:18:08,470
مضى أكثر من عقد منذ غادرتِ
موطنكِ، أليس كذلك؟

288
00:18:08,470 --> 00:18:09,810
ماذا؟ أجل

289
00:18:10,100 --> 00:18:11,450
...هل سبق

290
00:18:11,450 --> 00:18:14,280
وشعرتِ بحنين لموطنكِ، أو طعام موطنكِ؟

291
00:18:14,690 --> 00:18:16,980
هل تريدين العودة إلى موطنكِ يوماً؟

292
00:18:17,230 --> 00:18:21,450
أستمتع بالحاضر أكثر من تذكُّر موطني

293
00:18:21,450 --> 00:18:23,380
،لقرابة 50 عاماً

294
00:18:23,380 --> 00:18:28,150
عشتُ في ظلّ تلك اللّعنة كطائر في قفص

295
00:18:28,150 --> 00:18:33,120
لكن إبرام العقد معك قد سمح
لي بعَيش حياة جديدة

296
00:18:34,130 --> 00:18:37,580
أتساءل ما طبيعة التّجارب الّتي
،تنتظرني مع الجميع هنا

297
00:18:37,580 --> 00:18:39,950
والمضيّ قُدماً معكم جميعاً

298
00:18:40,490 --> 00:18:41,700
يبدو رائعاً

299
00:18:42,140 --> 00:18:43,320
وثميناً

300
00:18:43,930 --> 00:18:48,560
تاكومي-ساما، منحتني أجنحة
عندما كنتُ محبوسة في قفص

301
00:18:49,390 --> 00:18:51,010
أجنحة؟

302
00:18:51,010 --> 00:18:55,480
كان الزّمن قد توقّف بالنّسبة لي، لكن منحتني
الأجنحة للتّحليق والمضيّ قُدماً

303
00:18:55,480 --> 00:18:57,160
...لذا الآن

304
00:18:57,160 --> 00:19:00,700
لا أنظر إلّا إلى الحياة الّتي
تنتظرني في المُستقبل

305
00:19:01,010 --> 00:19:04,150
لا حاجة لأتذكّر الماضي القديم

306
00:19:04,440 --> 00:19:10,570
في كلّ يوم أجد نفسي أكثر حماساً
!لليوم واليوم الّذي يليه أيضاً

307
00:19:10,570 --> 00:19:13,610
!أنا أيضاً

308
00:19:14,390 --> 00:19:15,830
!كاميليا تقولها أيضاً

309
00:19:16,350 --> 00:19:17,530
هكذا إذاً

310
00:19:17,980 --> 00:19:21,200
بدأتُ أعيش حياة جديدة كذلك

311
00:19:22,000 --> 00:19:25,870
أعتقد يمكنك القول بأنّني مُنِحتُ أجنحة

312
00:19:26,390 --> 00:19:28,510
رغم أنّ الشّخص الّذي منحني
...هذه الأجنحة كان

313
00:19:31,960 --> 00:19:33,390
...أجنحة

314
00:19:33,390 --> 00:19:36,180
ما رأيكم بـ"أجنحة نولين"؟

315
00:19:36,790 --> 00:19:38,400
أجنحة نولين؟

316
00:19:38,400 --> 00:19:40,090
كاسم لفريقنا؟

317
00:19:40,090 --> 00:19:40,660
أجل

318
00:19:40,950 --> 00:19:45,360
أعتقد منحنا بعضنا الآخر أجنحة

319
00:19:45,360 --> 00:19:47,300
لهذا السّبب نستطيع المضيّ قُدماً

320
00:19:48,160 --> 00:19:49,650
أجنحة نولين

321
00:19:49,650 --> 00:19:50,580
يروقني

322
00:19:50,580 --> 00:19:52,300
!إنّه رائع

323
00:19:52,300 --> 00:19:54,000
!أنا مُوافقة عليه تماماً

324
00:19:54,000 --> 00:19:55,970
!لا اعتراضات هنا

325
00:19:56,480 --> 00:19:57,670
!حُسِم الأمر إذاً

326
00:19:57,670 --> 00:19:59,420
...اسم فريقنا سيكون

327
00:19:59,820 --> 00:20:01,670
!أجنحة نولين

328
00:20:03,570 --> 00:20:07,600
،بعد إتمام مهمّة المُرافقة خاصّتنا بأمان
عدنا إلى بولتون

329
00:20:07,600 --> 00:20:09,290
بعد ليلتين

330
00:20:16,690 --> 00:20:18,190
!سُمّ شلّ حركة؟

331
00:20:18,190 --> 00:20:19,800
!هناك سحابة سامّة تملأ القصر

332
00:20:19,800 --> 00:20:20,910
ولا حركة

333
00:20:24,120 --> 00:20:26,810
!تاكومي-ساما

334
00:20:33,520 --> 00:20:34,410
!ماذا؟

335
00:20:36,490 --> 00:20:37,950
!أيّها الوغد

336
00:20:45,040 --> 00:20:45,960
نجوت

337
00:20:45,960 --> 00:20:46,820
شكراً لك

338
00:20:46,820 --> 00:20:48,510
أنقذتِنا يا قيقب

339
00:20:48,820 --> 00:20:49,970
عِلاج

340
00:20:57,000 --> 00:20:59,400
زال التّخدير؟

341
00:20:59,930 --> 00:21:02,980
!تاكومي-ساما! أنا آسفة جدّاً

342
00:21:02,980 --> 00:21:04,290
!خذلتُك

343
00:21:04,640 --> 00:21:06,350
لم تكن غلطتكِ يا صوفيا

344
00:21:06,350 --> 00:21:09,830
لماذا لم تُشلّ حركتك يا تاكومي-ساما؟

345
00:21:10,210 --> 00:21:14,780
قيقب وأنا لدينا مهارتا مُقاومة
شلّ الحركة ومُقاومة السمّ

346
00:21:14,780 --> 00:21:16,850
لكن شعرتُ ببعض الخدر

347
00:21:17,240 --> 00:21:20,930
مولايّ، ماذا نفعل بأولئك الّذين في الخارج؟

348
00:21:21,760 --> 00:21:25,670
وجدتُهم يتجوّلون عندما قدتُ
كاميليا إلى الإسطبل الخاصّ بها

349
00:21:25,670 --> 00:21:28,090
،توقّعتُ أن يكون هناك البعض في الدّاخل أيضاً

350
00:21:28,090 --> 00:21:31,390
لذا دخلتُ البُعد الجيبيّ، ثمّ رأيتُ
رأيتُ الجميع يتعرّضون لهجوم

351
00:21:31,640 --> 00:21:33,950
كان المُهاجمون مُدجّجين بالسّلاح

352
00:21:33,950 --> 00:21:36,230
أعتقد كان هذا الهجوم مُخطَّطاً

353
00:21:36,710 --> 00:21:41,120
قد يكون من الأفضل طلب المُساعدة
من رابطة المُغامرين

354
00:21:41,120 --> 00:21:41,900
حسناً

355
00:21:41,900 --> 00:21:46,130
صوفيا، آسف للطّلب، لكن هل يمكنكِ
الذّهاب إلى النّقابة وإحضار باراك لنا؟

356
00:21:53,510 --> 00:21:55,020
تاكومي

357
00:21:55,020 --> 00:21:58,480
أعتقد ينبغي أن تبلغ الحاكم عن هذا الأمر فوراً

358
00:21:58,920 --> 00:22:01,540
أتعتقد بأنّ هذه مُصيبة أيضاً؟

359
00:22:01,540 --> 00:22:02,780
أجل

360
00:22:02,780 --> 00:22:05,770
إنّها غالباً أسوأ مُصيبة ممكنة