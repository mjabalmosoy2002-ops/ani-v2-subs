1
00:00:01,270 --> 00:00:02,810
توا وسيتسونا

2
00:00:02,850 --> 00:00:07,650
.بيننا نحن التوأم نصف الشيطانيّ، يتواجد عالمان في نفس الوقت

3
00:00:08,730 --> 00:00:10,150
.البشر والشياطين

4
00:00:10,440 --> 00:00:12,700
.العهد الإقطاعيّ والعصر الحديث

5
00:00:12,780 --> 00:00:14,070
.السلام والحرب

6
00:00:14,490 --> 00:00:15,780
.البهجة والحزن

7
00:00:16,280 --> 00:00:17,700
.الحلم والحقيقة

8
00:00:17,990 --> 00:00:19,450
.لحظة واحدة والأبديّة

9
00:00:19,790 --> 00:00:22,500
.وأخيرا، الحبّ والكراهيّة

10
00:00:23,460 --> 00:00:26,250
.قصّة خياليّة من العهد الإقطاعيّ، ياساهيمي: الأميرة نصف الشيطانية

11
00:00:26,710 --> 00:00:30,460
!سنواصل التقدّم عبر عقبات القدر

12
00:00:32,380 --> 00:00:34,010
تاجر الجثث

13
00:00:33,550 --> 00:00:36,550
.ريكو-ساما، أودّ إعادة هذه لك

14
00:00:36,640 --> 00:00:37,760
هل انتهيت منها؟

15
00:00:37,930 --> 00:00:41,430
القرصان التائه – ريكو

16
00:00:37,930 --> 00:00:41,430
– وكيل صائد الجوائز
تاجر الجثث جيوبي

17
00:00:37,970 --> 00:00:38,720
.أجل

18
00:00:38,760 --> 00:00:41,640
،لؤلؤة قوس المطر قدّمت لي المزيد من المكافآت

19
00:00:41,640 --> 00:00:44,060
.وسمحت لي بتحقيق ربح كبير

20
00:00:44,100 --> 00:00:44,850
أحقًّا ذلك؟

21
00:00:45,230 --> 00:00:46,900
.يسعدني سماع الأمر

22
00:00:47,730 --> 00:00:51,150
.أعتقد أنّ الوقت قد حان لأتحرّك

23
00:01:05,250 --> 00:01:06,420
.هذا هو المكان

24
00:01:18,300 --> 00:01:20,890
أحد الأخطار الأربعة – كونتون

25
00:01:25,140 --> 00:01:27,190
.أنت! لا تطأ تلك

26
00:01:27,900 --> 00:01:30,520
.يا إلهي، أنا آسف حقًّا

27
00:01:33,070 --> 00:01:36,530
.سيّد كونتون، يبدو أنك تأخذ كلّ وقتك

28
00:01:36,780 --> 00:01:37,700
ما الذي قلته؟

29
00:01:38,240 --> 00:01:42,790
.الأميرات نصف الشيطانيّات يواصلن هزيمتك، وبالكاد قمت بشيء

30
00:01:42,830 --> 00:01:44,080
أأنت راضٍ بذلك؟

31
00:01:46,540 --> 00:01:51,090
.قد يكون هذا صعب الفهم بالنسبة لك، لكنّي في طور تحضير مجال هنا

32
00:01:51,750 --> 00:01:52,710
مجال؟

33
00:01:52,800 --> 00:01:56,550
.إنه فخّ هروب ذو ثمانية مجالات يعتمد على سحر هوجوتسو

34
00:01:57,050 --> 00:01:59,430
.لكن لم أقرّر أيّ حجر أساس سأختار

35
00:01:59,640 --> 00:02:02,180
.إنها نقطة بؤرية ملحقة للقوّة

36
00:02:04,060 --> 00:02:05,640
أتريد التطوّع؟

37
00:02:05,680 --> 00:02:08,810
.كلّا، لست قويًّا بما يكفي من أجل المهمّة

38
00:02:08,850 --> 00:02:11,860
.ربما سيكون من الأفضل لو قمت بذلك الدور بنفسك

39
00:02:11,940 --> 00:02:14,360
.عليّ أن أكون الشخص الذي يتحكّم في المجال

40
00:02:14,650 --> 00:02:17,320
ماذا عن توتيتسو-سان إذًا؟

41
00:02:17,570 --> 00:02:19,150
توتيتسو؟

42
00:02:20,410 --> 00:02:22,240
...ذلك الشره

43
00:02:22,740 --> 00:02:25,040
،من بين الأخطار الأربعة التابعين لكيرينمارو-ساما

44
00:02:25,080 --> 00:02:28,620
.فأنت وتوتيتسو-سان هما الوحيدان المتبقّيان

45
00:02:29,040 --> 00:02:31,500
لمَ لا تعملان رفقة بعض من وقت لآخر؟

46
00:02:31,790 --> 00:02:34,550
.لا أعلم مكانه أو ما يفعله حاليًا

47
00:02:35,130 --> 00:02:39,050
.رجاءً دع هذا الأمر لي. سأبحث عنه وأحضره إلى هنا

48
00:02:39,470 --> 00:02:42,760
.إن أردت إحضار شخصٍ ما إلى هنا، فلتحضر الأميرات نصف الشيطانيّات

49
00:02:42,850 --> 00:02:46,430
.هذا المجال لن يكون ذا فائدة إلّا إذا استدرجهن أحد إليه

50
00:02:47,980 --> 00:02:51,270
.حسنًا، سأفكّر في خطّة من أجل ذلك أيضًا

51
00:02:51,310 --> 00:02:53,860
.تتصرّف بكرم مبالغ

52
00:02:54,110 --> 00:02:56,940
أمنية كيرينمارو-ساما هي سرقة لآلئ قوس المطر

53
00:02:57,030 --> 00:02:59,360
.من الأميرات نصف الشيطانيّات

54
00:02:59,860 --> 00:03:02,700
.أتمنّى ألا تكون قد نسيت ذلك

55
00:03:03,160 --> 00:03:04,700
.لم أنسَ

56
00:03:07,120 --> 00:03:09,540
...توتيتسو كحجر الأساس

57
00:04:49,970 --> 00:04:55,020
فخّ الأخطار المزدوج

58
00:04:51,270 --> 00:04:52,810
"فخّ الأخطار المزدوج"

59
00:04:55,230 --> 00:04:57,900
فتاة نصف شيطانيّة – توا هيغوراشي

60
00:04:55,230 --> 00:04:57,900
ماذا؟! هذا ليس جبل موسوبي؟

61
00:04:58,360 --> 00:05:01,780
.سمعت في القرية أنّ هذا هو جبل موسوبي

62
00:05:01,860 --> 00:05:03,820
.هذا جبل أوموسوبي

63
00:05:03,860 --> 00:05:05,030
أوموسوبي؟

64
00:05:05,070 --> 00:05:06,530
.انظري لذاك

65
00:05:06,990 --> 00:05:10,200
ألا يبدو ذلك الجبل شهيًّا؟

66
00:05:11,700 --> 00:05:15,210
قاتلة شياطين – سيتسونا

67
00:05:11,910 --> 00:05:14,370
أين هو جبل موسوبي إذًا؟

68
00:05:14,370 --> 00:05:17,040
.لم أسمع عن جبل بذلك الاسم

69
00:05:18,630 --> 00:05:20,210
...مستحيل

70
00:05:20,790 --> 00:05:22,800
قطّة شيطانيّة – كيرارا

71
00:05:23,510 --> 00:05:25,470
.يا له من سوء فهم

72
00:05:25,510 --> 00:05:27,430
.تتصرّفين وكأنّ هذه المشكلة لا تخصّك

73
00:05:27,470 --> 00:05:31,430
.إن لم نمسك بفراشة الأحلام، فلن تستعيدي نومك

74
00:05:31,890 --> 00:05:34,310
.لا مشكلة لديّ في ذلك

75
00:05:35,230 --> 00:05:36,980
.فلنعد

76
00:05:38,730 --> 00:05:42,690
فراشة الأحلام، أين أنت يا ترى؟

77
00:05:48,070 --> 00:05:53,580
تمّت هزيمة اثنين من الأخطار الأربعة
ولن تفعل أيّ شيءٍ حيال ذلك؟

78
00:05:54,830 --> 00:05:58,540
.كان يفترض بك قتل بنات سيشّومارو من أجلي

79
00:05:58,580 --> 00:06:00,380
حقًّا؟

80
00:06:00,420 --> 00:06:01,590
.أجل

81
00:06:01,750 --> 00:06:05,090
الملك الوحش الذي يحكم الأخطار الأربعة – كيرينمارو

82
00:06:02,670 --> 00:06:05,090
.يبدو أنّ ريكو يتحرّك

83
00:06:05,670 --> 00:06:07,550
ستدع الأمور له؟

84
00:06:05,670 --> 00:06:09,180
شيطانة غامضة جميلة – زيرو

85
00:06:07,590 --> 00:06:11,430
.إنه أكثر خادمٍ أثق به. سيكون الوضع على ما يرام

86
00:06:11,640 --> 00:06:13,390
...يا لك من شخص كسول

87
00:06:24,610 --> 00:06:26,990
تاجر الجثث

88
00:06:31,030 --> 00:06:31,990
.أنت

89
00:06:32,370 --> 00:06:34,790
.لا يزال هنالك بعض الغبار هنا

90
00:06:34,950 --> 00:06:36,580
.اخرس

91
00:06:36,620 --> 00:06:40,580
جيوبي-سان، ألا تملك أعمال صيد جوائز جيّدة من أجلي؟

92
00:06:40,670 --> 00:06:42,170
.لا يوجد أيّ منها بوضوح

93
00:06:42,500 --> 00:06:46,010
شيطان كلب الراكون الصغير – تاكيتشيو

94
00:06:42,500 --> 00:06:47,130
.تحرّكي! وإلّا فلن تكسبي ما يكفي من أجل وجبة اليوم

95
00:06:47,510 --> 00:06:50,760
صائدة جوائز – موروها

96
00:06:47,510 --> 00:06:51,140
!لا أصدّق أنك تستغلّني هكذا

97
00:06:51,180 --> 00:06:53,680
أنا من الصنف الذي يستطيع
!أن يدرّ عليك أموالًا كثيرة

98
00:06:53,970 --> 00:06:56,430
.لا زلت أعتقد أنك محظوظة فحسب

99
00:06:56,430 --> 00:06:58,480
.اخرس يا كلب الراكون

100
00:06:58,520 --> 00:07:00,230
!ماذا؟! أنت ربع شيطانة لا غير

101
00:07:00,270 --> 00:07:01,440
.مرحبًا

102
00:07:02,060 --> 00:07:03,440
ما الذي نحتفل به؟

103
00:07:03,730 --> 00:07:07,150
ريكو-ساما؟ ما الذي يجلبك إلى هنا؟

104
00:07:07,610 --> 00:07:10,450
في الحقيقة... أنت هنا إذًا؟

105
00:07:11,070 --> 00:07:13,200
.يا صائدة الجوائز العزيزة

106
00:07:13,240 --> 00:07:14,580
ماذا؟ أنا؟

107
00:07:15,080 --> 00:07:17,620
كيف تجري عمليّة قتل الأخطار الأربعة؟

108
00:07:17,660 --> 00:07:20,830
.إن لم تخنّي الذاكرة، فقد تركت مكافأة كبيرة

109
00:07:21,330 --> 00:07:25,920
،لو كان الأمر منوّطًا بي، لذهبت وقتلتهم بنفسي ثمّ حصدت المكافأة

110
00:07:25,960 --> 00:07:30,260
...ثمّ النهاية! أسدّد ديني وأتنفّس بحريّة أكبر

111
00:07:30,300 --> 00:07:32,800
.لكن لا فكرة لديّ إلى أين هربوا

112
00:07:33,260 --> 00:07:36,600
.يا إلهي، هذا ما توقّعته

113
00:07:36,930 --> 00:07:39,890
.سمعت عن إشاعة بخصوص توتيتسو

114
00:07:40,350 --> 00:07:43,480
.توتيتسو! الشيطان الذي يأكل الرهبان

115
00:07:43,810 --> 00:07:47,400
.أجل هو بالذات. سمعت أنّ أحدًا ما شاهده

116
00:07:48,190 --> 00:07:50,610
.إن عرفت مكانه، فاترك الباقي لي

117
00:07:50,650 --> 00:07:52,570
أين هنّ الفتيات قاتلات الشياطين؟

118
00:07:52,660 --> 00:07:55,120
.في القرية على الأرجح. هيّا بنا يا تاكيتشيو

119
00:07:56,120 --> 00:07:58,660
لحظة، لمَ عليّ الذهاب؟

120
00:07:58,660 --> 00:07:59,830
.اذهب لمساعدتهما

121
00:07:59,870 --> 00:08:01,210
.حسنًا

122
00:08:12,340 --> 00:08:15,640
.شجرة العصور لم تظهر منذ ذلك الوقت

123
00:08:20,680 --> 00:08:25,270
.هي من طلبت منّا قتل كيرينمارو، لكن أتساءل إذا استسلمت

124
00:08:25,900 --> 00:08:30,860
،أو ربما، بما أنّنا نقوم بهزيمة أتباعه بأية حال

125
00:08:30,900 --> 00:08:32,610
فهي تراقبنا فحسب؟

126
00:08:33,860 --> 00:08:37,410
...بدل كيرينمارو، أفضّل لو

127
00:08:49,290 --> 00:08:50,590
.وجدتهما

128
00:08:50,630 --> 00:08:52,050
!أنتما

129
00:08:54,800 --> 00:08:57,970
تاكيتشيو؟ أتساءل ما الأمر؟

130
00:08:58,470 --> 00:08:59,930
لمَ ريكو رفقتهما؟

131
00:09:02,350 --> 00:09:05,560
.نعلم مكان تواجد توتيتسو، لذا فلنذهب لقتله

132
00:09:06,190 --> 00:09:07,480
كيف عرفت ذلك؟

133
00:09:07,860 --> 00:09:11,360
.بعض أصدقائي القراصنة منحوني تلك المعلومة

134
00:09:11,940 --> 00:09:13,570
.هيّا فلنذهب

135
00:09:13,610 --> 00:09:15,320
لا تمانعين ذلك يا موروها؟

136
00:09:15,320 --> 00:09:16,570
ما الذي تقصدينه؟

137
00:09:17,490 --> 00:09:22,410
نحن على وشك قتل كيرينمارو، وهو ما طلبت
.منّا شجرة العصور فعله

138
00:09:22,790 --> 00:09:24,870
.ما دمت قادرة على جني المال، فلا مشكلة لديّ

139
00:09:25,250 --> 00:09:29,000
.بدل كيرينمارو، أرغب في إيجاد فراشة الأحلام أوّلاً

140
00:09:29,000 --> 00:09:30,500
.صحيح

141
00:09:31,090 --> 00:09:34,840
توا-ساما، كنت تبحثين عن فراشة الأحلام؟

142
00:09:34,880 --> 00:09:38,890
،هذه شائعة أخرى سمعتها من أحد أصدقائي القراصنة

143
00:09:38,930 --> 00:09:42,680
.لكنّ كيرينمارو وفراشة الأحلام متّصلان بطريقة ما

144
00:09:43,060 --> 00:09:44,020
حقًّا؟

145
00:09:44,480 --> 00:09:47,520
.رغم أنها مجرّد إشاعة

146
00:09:47,810 --> 00:09:50,230
أين هو كيرينمارو إذًا؟

147
00:09:50,610 --> 00:09:53,190
.في الحقيقة، لا فكرة لديّ

148
00:09:53,650 --> 00:09:58,530
لكن إن واصلتنّ هزيمة أتباعه، فسيظهر
.من تلقاء نفسه على الأرجح

149
00:09:58,570 --> 00:10:01,410
فهمت. ما الذي ننتظره إذًا؟

150
00:10:01,490 --> 00:10:04,410
!أجل، المكافأة الكبرى، ها أنا قادمة

151
00:10:04,830 --> 00:10:05,870
.سيتسونا

152
00:10:22,260 --> 00:10:23,560
.فلنذهب

153
00:10:28,100 --> 00:10:33,320
يُفترض أن يكون شرقًا بالقرب من النهر. سمعت أنه المكان
.الذي شوهد فيه توتيتسو مؤخّرا

154
00:10:33,650 --> 00:10:35,860
.أسرع يا تاكيتشيو

155
00:10:36,650 --> 00:10:39,200
.لم يسبق لي حمل هذا العدد من الأشخاص من قبل

156
00:10:39,780 --> 00:10:42,490
ريكو، كيف تعلم بخصوص كيرينمارو؟

157
00:10:42,490 --> 00:10:46,870
.حسنًا، يبدو أنه يملك شيئًا أريده

158
00:10:46,910 --> 00:10:48,330
لؤلؤة قوس مطر؟

159
00:10:48,500 --> 00:10:50,210
.شيءٌ أكثر قيمة

160
00:10:50,870 --> 00:10:53,000
ماذا؟ أيّ نوعٍ من الكنوز هو؟

161
00:10:53,920 --> 00:10:58,300
حسنًا، سيكون الأمر أكثر متعة
.إذا كانت مفاجأة

162
00:11:06,180 --> 00:11:07,060
ما الذي يحدث؟

163
00:11:07,100 --> 00:11:10,310
.راهب فاضل يعيش في ذلك المعبد هناك

164
00:11:10,810 --> 00:11:13,730
هل قرّر توتيتسو إظهار نفسه؟

165
00:11:13,730 --> 00:11:15,440
أهو هنا لأكل الراهب؟

166
00:11:15,690 --> 00:11:17,150
.بسرعة يا تاكيتشيو

167
00:11:20,070 --> 00:11:20,950
.حسنٌ

168
00:11:24,870 --> 00:11:27,830
أحد الأخطار الأربعة – توتيتسو

169
00:11:24,950 --> 00:11:28,330
!سوف آكلك! ها أنا ذا

170
00:11:30,830 --> 00:11:36,670
!يا إلهي، لا تبدو لذيذًا على الإطلاق. لكنّي سآكلك على أيّة حال

171
00:11:36,670 --> 00:11:38,260
!فليساعدني أحد

172
00:11:38,880 --> 00:11:42,050
إلى متى سأواصل القيام بهذا؟

173
00:11:42,510 --> 00:11:46,720
.لا أريد أكل هذا الراهب مقزّز المظهر

174
00:11:46,810 --> 00:11:48,390
!توقّف يا توتيتسو

175
00:11:49,600 --> 00:11:50,850
!أفلت ذلك الراهب

176
00:11:52,810 --> 00:11:56,440
.ظهرتنّ أخيرًا يا نصف الشيطانيّات السامّات

177
00:11:56,480 --> 00:11:57,780
.لا بدّ أنكنّ غبيّات

178
00:11:58,030 --> 00:11:58,650
ماذا؟

179
00:11:59,110 --> 00:12:02,110
لمَ عليّ إفلات هذا الراهب؟

180
00:12:02,570 --> 00:12:07,830
...حسنًا... لأنه رهينة؟ وإن لم تدعه يذهب

181
00:12:07,870 --> 00:12:09,870
.فسنقطعك دون شفقة

182
00:12:09,910 --> 00:12:11,540
...لكن الراهب

183
00:12:11,580 --> 00:12:14,790
.إن تورّط، فالحظّ لم يكن حليفه وحسب

184
00:12:15,000 --> 00:12:16,420
!ماذا؟

185
00:12:16,630 --> 00:12:18,340
.تعالا وهاجماني إذًا

186
00:12:18,670 --> 00:12:19,550
.جهّز نفسك

187
00:12:19,590 --> 00:12:21,970
...سيتسونا، الراهب

188
00:12:22,510 --> 00:12:24,220
!ساعداني

189
00:12:32,310 --> 00:12:33,190
ماذا؟

190
00:12:35,440 --> 00:12:37,150
!ساعداني

191
00:12:45,280 --> 00:12:46,030
ماذا؟

192
00:12:48,490 --> 00:12:49,200
!موروها

193
00:13:01,670 --> 00:13:03,300
ما الذي يحدث؟

194
00:13:18,650 --> 00:13:20,190
!عد إلى هنا

195
00:13:20,860 --> 00:13:23,280
!تاكيتشيو، لا تقف هكذا! هيّا بنا

196
00:13:23,400 --> 00:13:25,240
!تجعلينني أعمل دون توقّف

197
00:13:25,570 --> 00:13:27,490
.توا، سيتسونا، اقفزا

198
00:13:28,410 --> 00:13:30,830
!حسنًا، تشبّثوا

199
00:13:32,160 --> 00:13:34,620
هل تمّ إنقاذي؟

200
00:13:35,080 --> 00:13:36,830
!أمسكن بي إن استطعتن

201
00:13:36,870 --> 00:13:39,130
!عد إلى هنا

202
00:13:56,060 --> 00:13:57,060
!تاكيتشيو

203
00:14:06,530 --> 00:14:07,950
.ا-اختفين

204
00:14:36,850 --> 00:14:38,480
ما الذي يحدث؟

205
00:14:39,060 --> 00:14:41,020
.لقد دخلن المجال

206
00:14:41,020 --> 00:14:43,110
ما ذلك؟

207
00:14:43,150 --> 00:14:45,940
.لا أعلم ما الذي ستؤول إليه الأمور

208
00:14:47,740 --> 00:14:51,200
.لؤلؤة قوس المطر ستكون المرشدة على ما أعتقد

209
00:14:54,330 --> 00:14:57,200
.ظننتُ أنّنا في وادٍ ضيق، لكن المكان شاسع

210
00:14:57,750 --> 00:14:59,330
أين هو توتيتسو؟

211
00:14:59,750 --> 00:15:01,290
.وموروها أيضًا

212
00:15:02,210 --> 00:15:04,040
.فلنجرب الذهاب إلى هناك أوّلا

213
00:15:06,460 --> 00:15:08,300
!عد إلى هنا

214
00:15:10,550 --> 00:15:13,390
!تتصرّف كخاسر ذريع يا توتيتسو

215
00:15:13,800 --> 00:15:15,680
!موجة التنّين القرمزيّ

216
00:15:19,060 --> 00:15:19,640
ماذا؟

217
00:15:23,230 --> 00:15:26,320
هل كان ما قطعتُه وهمًا؟

218
00:15:43,040 --> 00:15:45,460
!سيتسونا! توا

219
00:15:46,460 --> 00:15:47,840
.شيءٌ ما ليس على ما يرام

220
00:15:48,380 --> 00:15:50,630
.لا يبدو أنّنا نقترب على الإطلاق

221
00:15:51,340 --> 00:15:53,930
.كما أنّ موروها وتوتيتسو ليسا في أيّ مكان

222
00:15:54,970 --> 00:15:58,850
!موروها

223
00:16:00,390 --> 00:16:02,310
!موروها

224
00:16:04,270 --> 00:16:05,860
.فلنتقدم أكثر

225
00:16:18,410 --> 00:16:21,410
ما عمق هذا الوادي الضيق يا ترى؟

226
00:16:22,080 --> 00:16:25,250
لا يمكن أن يكون بكلّ هذا العمق، صحيح؟

227
00:16:51,610 --> 00:16:55,240
.عبر بوّابة الافتتاح، عالق في بوّابة المفاجأة

228
00:16:55,450 --> 00:16:59,200
...والآن، الاثنتان عند بوّابة الراحة

229
00:17:00,160 --> 00:17:01,830
.هذا غريب

230
00:17:01,870 --> 00:17:06,330
أجل. نحن لا نقترب على الإطلاق. هل يجدر بنا العودة؟

231
00:17:08,630 --> 00:17:09,880
هل قطعنا كلّ هذه المسافة؟

232
00:17:10,420 --> 00:17:14,300
.يبدو أنّنا عالقتان في تعويذة ما

233
00:17:14,590 --> 00:17:15,510
تعويذة؟

234
00:17:16,300 --> 00:17:19,390
.نحن لا نسعى خلف توتيتسو فحسب

235
00:17:19,640 --> 00:17:24,270
.كونتون. كان شخصًا يستخدم تعويذات غريبة

236
00:17:24,520 --> 00:17:27,190
.توا، اقطعيني الكاتانا خاصتك

237
00:17:27,270 --> 00:17:28,310
ماذا؟

238
00:17:29,480 --> 00:17:31,150
.قلت لك أن تقطعيني

239
00:17:31,320 --> 00:17:34,240
.لمَ عساي أقوم بذلك؟ يستحيل أن أستطيع

240
00:17:34,610 --> 00:17:35,530
.فهمت

241
00:17:41,200 --> 00:17:42,410
سيتسونا؟

242
00:17:52,670 --> 00:17:55,630
،ظننت أنّني سأستفيق إن كانت هذه تعويذة وهم

243
00:17:55,760 --> 00:17:57,720
.لكنّ الأمور لا تبدو بتلك البساطة

244
00:17:58,050 --> 00:17:58,970
!لمَ فعلت ذلك؟

245
00:17:59,510 --> 00:18:00,970
.أنت لينةٌ جدًّا يا توا

246
00:18:01,890 --> 00:18:05,020
،ليس خطؤك تمامًا أنه ينقصك التدريب

247
00:18:05,060 --> 00:18:09,980
لكن قبل قليل، عندما كنّا نقاتل توتيتسو، قام بقراءة ملامح وجهك

248
00:18:10,020 --> 00:18:12,440
.واكتشف أنّ موروها تقف خلفه

249
00:18:12,570 --> 00:18:13,320
...لكن

250
00:18:13,900 --> 00:18:15,320
.لا تستخفّي بهذا العهد

251
00:18:19,070 --> 00:18:23,330
ماذا الآن؟ إن لم يكن هذا وهمًا، فما هذه التعويذة إذًا؟

252
00:18:24,200 --> 00:18:26,120
سيتسونا، انتظري هنا، مفهوم؟

253
00:18:26,370 --> 00:18:28,540
ما الأمر؟ هل سنفترق؟

254
00:18:29,040 --> 00:18:31,540
.سأستخدمك كدليل، لا تتحرّكي

255
00:19:01,740 --> 00:19:02,990
ما رأيك؟

256
00:19:11,670 --> 00:19:13,750
ما الذي يحدث هنا؟

257
00:19:14,250 --> 00:19:15,630
...لكن

258
00:19:25,680 --> 00:19:27,220
.تبًّا

259
00:19:37,690 --> 00:19:39,150
...هذه الشجرة

260
00:19:40,320 --> 00:19:42,820
.من المفترض أن تكون هذه الشجرة خلفي

261
00:19:43,410 --> 00:19:45,450
سيتسونا؟ سيتسونا؟

262
00:19:50,370 --> 00:19:53,500
.من بوّابة المفاجأة، إلى بوّابة الموت

263
00:19:53,960 --> 00:19:56,960
.لحظة، عليّ أن أهدأ

264
00:20:02,340 --> 00:20:04,180
.أشمّ رائحة دم سيتسونا

265
00:20:09,390 --> 00:20:16,610
!سيتسونا

266
00:20:14,520 --> 00:20:15,560
خلفي؟

267
00:20:17,110 --> 00:20:20,360
.لمَ أنت خلفي؟ لم أتحرّك على الإطلاق

268
00:20:20,650 --> 00:20:26,240
تعويذة كونتون تقوم بتحريف المساحة من حولنا
.وتجعلنا نتحرك في دوائر

269
00:20:27,120 --> 00:20:28,200
.اختفت

270
00:20:28,330 --> 00:20:29,620
.إنه شريط موبيوس

271
00:20:29,910 --> 00:20:30,870
ماذا؟

272
00:20:30,870 --> 00:20:34,000
،إن لم نتمكّن من الهرب من هذا الفخّ جسديًا

273
00:20:34,330 --> 00:20:37,040
.فعلينا قطع الدائرة نفسها

274
00:20:37,590 --> 00:20:40,380
إن أردت منّي قطع شيءٍ ما فبإمكاني ذلك، لكن أين؟

275
00:20:40,630 --> 00:20:45,010
لا أعلم إن كنا قادرتين على رؤيته، لكن هل توجد
عقدة للتعويذة في مكان ما؟

276
00:20:45,890 --> 00:20:47,970
.يمكننا ذلك إن كان صدع طاقة شيطانيّة

277
00:20:48,430 --> 00:20:49,680
ما الذي يعنيه ذلك؟

278
00:20:50,850 --> 00:20:56,810
.سمعت أنّ بإمكان قبيلتنا شمّ مكان التقاء صدع الطاقات الشيطانيّة

279
00:20:56,900 --> 00:20:58,400
.ويمكننا القطع من خلالها

280
00:20:59,110 --> 00:21:00,400
شمّها؟

281
00:21:00,900 --> 00:21:01,940
.سأجرّب ذلك

282
00:21:18,500 --> 00:21:19,380
.هذه الرائحة

283
00:21:19,750 --> 00:21:21,050
!كونتون

284
00:21:37,520 --> 00:21:38,520
.إنه قريب

285
00:21:38,560 --> 00:21:39,480
.أجل

286
00:21:41,320 --> 00:21:41,900
ماذا؟

287
00:21:56,370 --> 00:21:57,580
.تبًّا لكما

288
00:21:57,790 --> 00:21:59,250
.يا للبغض

289
00:23:30,050 --> 00:23:59,960
عرض مسبق للحلقة القادمة

290
00:23:31,890 --> 00:23:34,010
!عثرنا عليك يا كونتون، جهّز نفسك

291
00:23:34,470 --> 00:23:36,560
لكن أين ذهب توتيتسو؟

292
00:23:36,640 --> 00:23:38,480
هل ينوي الهرب إلى البحر؟

293
00:23:38,850 --> 00:23:42,150
لا بدّ أنه هرب لطلب المساعدة
.من مسؤوله الذي يعليه، كيرينمارو

294
00:23:42,190 --> 00:23:43,110
مسؤوله؟

295
00:23:43,150 --> 00:23:44,270
.شخصٌ يفوقه درجة

296
00:23:44,320 --> 00:23:46,030
هذا يعني أنه الزعيم، صحيح؟

297
00:23:46,070 --> 00:23:49,190
كم قطعة مون يساوي الزعيم كيرينمارو ذاك برأيكما؟

298
00:23:49,190 --> 00:23:51,660
لحظة، من هذا؟

299
00:23:51,860 --> 00:23:54,830
:في الحلقة القادمة من ياساهيمي :"الأميرة نصف الشيطانية
"سيشّومارو وكيرينمارو"

300
00:23:55,490 --> 00:23:57,910
ماذا؟ ذلك الشخص هو سيشّومارو؟