.وقف خادم ساموراي تحت بوّابة الرّاشومون ينتظر انقطاع المطر

188
00:14:52,080 --> 00:14:56,380
،الخادم الّذي كان يلبس كيمونو أزرق بالٍ
،جلس على العتبة السّابعة والعليا

189
00:14:56,380 --> 00:14:59,590
.ومضى يتأمّل المطر شاردًا

190
00:14:59,590 --> 00:15:06,550
".استرعت انتباهه بثرةٌ كبيرة تثير ضيقه في خدّه الأيمن

191
00:15:10,680 --> 00:15:11,970
أيّ جزءٍ تواجهين صعوبةٍ في فهمه؟

192
00:15:13,680 --> 00:15:16,150
...ليس أنّي لا أفهمه، حسنٌ

193
00:15:20,270 --> 00:15:21,360
ما السّؤال الّذي تواجهين صعوبةً معه؟

194
00:15:24,320 --> 00:15:26,110
.لنرَ

195
00:15:27,240 --> 00:15:31,990
ما رأيك في أفعال الخادم؟"
".اكتب عن ذلك بقدر ما تشاء

196
00:15:33,000 --> 00:15:35,620
.هذا سؤالٌ مركّب

197
00:15:35,620 --> 00:15:37,040
سؤال مركّب؟

198
00:15:37,040 --> 00:15:44,170
.السؤال الصّائب هو سؤالٌ يتحمّل منطقيًا إجابةً واحدة

199
00:15:44,470 --> 00:15:50,720
.لم أكن أبدًا من المفضّلين لمثل هذه الأسئلة الّتي تحتاج لتفسيرٍ فرديّ

200
00:15:53,390 --> 00:15:57,020
.قيل لي أنّ الإجابة عن هذا السؤال لن تؤثّر على علاماتي

201
00:15:57,020 --> 00:15:59,440
.في هذه الحالة، إنّها قصّةٌ أخرى

202
00:16:00,110 --> 00:16:04,900
.قراءة الرّوايات ممتعة حين تتمكّنين من تخيّل دوافع الشخصيات بحرية

203
00:16:06,530 --> 00:16:09,990
،الخادم الّذي سلّم إلى أنّ ليس له منأى عن الموت جوعًا

204
00:16:09,990 --> 00:16:13,040
.التقى بشخصٍ آخر داخل البرج

205
00:16:13,870 --> 00:16:17,870
.امرأةً عجوز تنتف شعر الجثث الملقاة هناك

206
00:16:18,580 --> 00:16:22,540
،رأى الخادم في ذلك عملًا شيطانيًا فاشتاط غضبًا

207
00:16:23,130 --> 00:16:26,050
.لكنّها أخبرته أنّها ستبيعه كشعرٍ مستعار

208
00:16:26,050 --> 00:16:28,180
،أساسًا، كانت تفعل ذلك في سبيل البقاء على قيد الحياة

209
00:16:28,800 --> 00:16:32,470
.حينها دبّت بعض الشّجاعة في قلب الخادم

210
00:16:32,470 --> 00:16:36,480
.الشّجاعة ليصبح لصًا بدل أن ينتظر الموت جوعًا

211
00:16:37,140 --> 00:16:40,310
،الشّيء الّذي اعتبره عملًا شيطانيًا إلى الآن

212
00:16:40,310 --> 00:16:43,520
.أصبح سببًا فاضلًا لأجل العيش

213
00:16:44,360 --> 00:16:48,490
.في كلّ الأحوال، انتهت هذه القصّة مع بعض المضامين

214
00:16:48,490 --> 00:16:49,400
...تكملة

215
00:16:49,400 --> 00:16:50,160
ماذا؟

216
00:16:50,160 --> 00:16:52,160
هل لها تكملة؟

217
00:16:52,160 --> 00:16:53,530
ماذا؟ تكملة؟

218
00:16:55,290 --> 00:16:57,290
.فهمت. تكملة إذًا

219
00:16:57,290 --> 00:17:00,330
.لم أفكّر في ذلك من قبل

220
00:17:00,330 --> 00:17:02,000
.هذا مضحكٌ بالفعل

221
00:17:02,000 --> 00:17:03,750
.آسف

222
00:17:05,090 --> 00:17:06,670
،لا توجد تكملةٌ لها

223
00:17:06,670 --> 00:17:10,260
.لكنّ أكوتاغاوا أعاد كتابة الجملة الأخيرة عدّة مرّات

224
00:17:12,220 --> 00:17:18,680
الجملة الّتي تسبق ذلك تقول أنّ الخادم
.توجّه إلى المدينة تحت المطر ليرتكب سرقة

225
00:17:19,730 --> 00:17:22,600
،لا أعلم ما كان يفكّر فيه أكوتاغاوا

226
00:17:22,980 --> 00:17:25,570
،لكن أعتقد أنّه عندما كان يكتب تلك الجملة

227
00:17:25,570 --> 00:17:30,280
.شجاعة الخادم ليصبح لصًا كانت بليغةً عند أكوتاغاوا

228
00:17:31,200 --> 00:17:32,740
.هذه وجهة نظري

229
00:17:36,660 --> 00:17:38,700
ماذا كنت لتفعل أيّها المدير؟

230
00:17:39,710 --> 00:17:40,290
ماذا؟

231
00:17:41,160 --> 00:17:42,620
،لو كنت مكان ذلك الخادم

232
00:17:43,170 --> 00:17:45,590
هل كنت لتصبح لصًا مثله؟

233
00:17:45,880 --> 00:17:47,050
...أنا

234
00:17:48,170 --> 00:17:50,840
.لا أظنّ أنّي كنت لأصبح لصًا

235
00:17:50,840 --> 00:17:53,390
.لا، لا أعتقد أنّي قادرٌ على ذلك

236
00:17:55,220 --> 00:17:58,720
.عندما تبلغين هذا العمر، يغلب عليك نمط العيش باستحياء

237
00:17:59,100 --> 00:18:01,440
.أريد تجنّب التسبّب في المتاعب قدر الإمكان

238
00:18:04,350 --> 00:18:05,860
،لو كنت مكان الخادم

239
00:18:05,860 --> 00:18:09,280
.أظنّني كنت لأجلس تحت البوّابة إلى أن يتوقّف المطر

240
00:18:12,320 --> 00:18:17,950
.ربّما لن أستطيع مبارحة ذلك المكان حتّى بعد توقّف المطر

241
00:18:19,700 --> 00:18:21,460
ماذا عنكِ يا تاتشيبانا-سان؟

242
00:18:21,460 --> 00:18:22,410
ماذا؟

243
00:18:23,790 --> 00:18:25,170
...لو كنت مكانه

244
00:18:30,550 --> 00:18:31,630
.آسف

245
00:18:31,630 --> 00:18:33,510
.كان سؤالًا صعبًا

246
00:18:33,510 --> 00:18:36,010
.هذا ما يسمّى سؤالًا مركّب

247
00:18:46,400 --> 00:18:49,110
.بثرة الخادم علامةٌ على شبابه

248
00:18:49,820 --> 00:18:53,570
.أما أنا فمجرّد كهل، حتّى البثور لم تعد تظهر عليه

249
00:18:54,320 --> 00:18:59,370
.لم أعد أملك الشّجاعة ولا الطّاقة لأغيّر عقليّتي كلّيًا

250
00:18:59,370 --> 00:19:00,290
!أيّها المدير

251
00:19:00,290 --> 00:19:01,580
!نعم

252
00:19:01,580 --> 00:19:03,000
!أنا قادم

253
00:19:25,560 --> 00:19:27,060
.لو سمحتِ

254
00:19:30,270 --> 00:19:32,860
.يا له من جوابٍ مثيرٍ للاهتمام

255
00:19:36,200 --> 00:19:38,820
.اختفت بثرتكِ

256
00:19:38,820 --> 00:19:39,740
.أجل

257
00:19:39,740 --> 00:19:44,000
.لقد أحببت قَصّة شعري الجديدة يا نيشيدا-سان

258
00:19:47,290 --> 00:19:48,630
.هذا مطمئن

259
00:19:48,630 --> 00:19:51,670
!يوشيزاوا-كُن

260
00:19:51,670 --> 00:19:55,550
!حلقت شعرك. فتًى مطيع

261
00:19:59,390 --> 00:20:00,510
.بوركت جهودكِ

262
00:20:00,510 --> 00:20:02,180
!بوركت جهودكِ

263
00:20:21,160 --> 00:20:24,910
ألا بأس من دعوتها يا ترى؟

264
00:20:43,720 --> 00:20:45,220
.آسفة على تأخّري

265
00:20:56,360 --> 00:20:57,150
.هيّا بنا