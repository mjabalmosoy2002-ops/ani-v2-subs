1
00:00:34,930 --> 00:00:36,350
ماذا تفعلين؟

2
00:00:38,350 --> 00:00:39,020
ماذا؟

3
00:00:43,400 --> 00:00:44,110
أتنظرين إلى القمر؟

4
00:00:44,110 --> 00:00:46,610
.نعم، نوعًا ما

5
00:00:46,610 --> 00:00:48,990
.إنّه ليس قمرًا عملاقًا اليوم

6
00:00:48,990 --> 00:00:50,200
.أعرف

7
00:00:50,200 --> 00:00:53,070
!لم أتصوّر أنّكِ تتمنّين الأماني

8
00:00:54,450 --> 00:00:55,790
.أفعل

9
00:00:55,790 --> 00:00:58,200
.سأذهب للاستحمام قبلكِ

10
00:01:04,500 --> 00:01:07,800
.أسرعي وأخرجي تلك الرّزم إلى الخارج

11
00:03:02,410 --> 00:03:03,710
!تاتشيبانا-سان

12
00:03:04,460 --> 00:03:06,500
.أعتذر على تأخّري

13
00:03:08,840 --> 00:03:11,550
.آسفة على دعوتك دون سابق إنذار

14
00:03:11,550 --> 00:03:13,050
.لا مشكلة

15
00:03:13,050 --> 00:03:15,220
...حسنٌ، بشأن اليوم

16
00:03:15,220 --> 00:03:16,430
...اليوم

17
00:03:16,930 --> 00:03:19,640
...مـ-مثل ما ذكرت في الرّسالة

18
00:03:20,560 --> 00:03:21,810
...حسنٌ

19
00:03:21,810 --> 00:03:25,600
!آمل أن توصيني ببعض الكتب كصديق

20
00:03:26,060 --> 00:03:26,890
.أكيد

21
00:03:26,890 --> 00:03:28,100
.اعتمدي عليّ

22
00:03:29,310 --> 00:03:33,280
!علي القول أنّ الطّقس رائعٌ اليوم

23
00:03:39,450 --> 00:03:42,200
.ثمّة الكثير من الباعة هنا اليوم

24
00:03:45,620 --> 00:03:46,960
!العجوز

25
00:03:46,960 --> 00:03:48,540
ماذا؟

26
00:03:48,540 --> 00:03:51,710
.لم أكن أعلم أنّك ستعرض بضاعتك هنا

27
00:03:51,710 --> 00:03:52,920
.أجل

28
00:03:52,920 --> 00:03:54,960
.إنّه عملٌ موسميّ

29
00:03:55,800 --> 00:03:57,380
عملٌ موسميّ؟

30
00:03:57,380 --> 00:04:00,600
.كان متجرك مغلقًا عندما كنت في تاكادانوبابا قبل أيام

31
00:04:00,600 --> 00:04:02,680
.ظننت أنّك تقاعدت عن العمل

32
00:04:03,930 --> 00:04:05,430
!على جثّتي

33
00:04:05,430 --> 00:04:09,100
.أصبحت مسنًا، لذلك لم أعد أعمل في المساء

34
00:04:09,100 --> 00:04:11,520
—جعلتني أقلق

35
00:04:11,520 --> 00:04:15,940
.هذا صاحب متجر الكتب المستعملة الّذي اعتدت زيارته في أيام دراستي

36
00:04:15,940 --> 00:04:17,820
.مرحبًا

37
00:04:22,780 --> 00:04:26,870
.لم أكن أعلم أنّ لك ابنةً بهذا الكِبر

38
00:04:26,870 --> 00:04:28,620
.السّنين تمضي بسرعة

39
00:04:29,370 --> 00:04:31,290
.إنّها ليست ابنتي

40
00:04:31,290 --> 00:04:32,040
—إنّها تعمل

41
00:04:32,040 --> 00:04:33,090
!نحن صديقان

42
00:04:34,130 --> 00:04:35,550
صديقان؟

43
00:04:37,550 --> 00:04:40,010
.د-دعك من ذلك

44
00:04:40,010 --> 00:04:42,300
إذًا، جلبت كتبًا جيّدة، صحيح؟

45
00:04:42,300 --> 00:04:43,220
.بالطّبع

46
00:04:43,220 --> 00:04:47,310
.جلبت الكثير من الكتب الجيّدة الّتي ستأسر قلوب عاشقي الكتب

47
00:04:48,560 --> 00:04:52,190
.تلك بطاقةٌ بريدية قديمة كتبها شخصٌ ما منذ عقود

48
00:04:53,400 --> 00:04:54,860
.مثيرٌ للاهتمام

49
00:04:55,230 --> 00:04:57,820
.صديقي الّذي يدير متجر تحف، طلب منّي بيعها

50
00:05:01,610 --> 00:05:03,740
.أجل. إنّها بسيطة

51
00:05:04,700 --> 00:05:06,830
.يا لها من رسالة

52
00:05:07,160 --> 00:05:08,750
...بالمناسبة يا تاتشيبانا-سان

53
00:05:08,750 --> 00:05:11,750
أتعلمين بشأن أقصر مراسلة في العالم؟

54
00:05:11,750 --> 00:05:12,750
.لا

55
00:05:12,750 --> 00:05:14,710
تقصد فيكتور هوغو، صحيح؟

56
00:05:14,710 --> 00:05:15,420
.نعم

57
00:05:15,800 --> 00:05:18,050
.إنّه كاتبٌ فرنسيّ بالمناسبة

58
00:05:18,050 --> 00:05:20,380
،أراد أن يعلم كيف كانت مبيعات كتابه

59
00:05:20,380 --> 00:05:24,470
.لذلك بعث رسالةً إلى النّاشر تحتوي على علامة استفهام فقط

60
00:05:24,470 --> 00:05:31,060
ردّ النّاشر بإرسال رسالةٍ تحتوي على علامة تعجّبٍ فقط
.ليخبره أنّ مبيعات الكتاب جيّدة

61
00:05:32,560 --> 00:05:38,190
بعبارةٍ أخرى، لأنّ فيكتور هوغو والنّاشر
،تجمعهما علاقةٌ وثيقة وتفاهمٌ متبادل

62
00:05:38,190 --> 00:05:41,110
.كان رمزٌ واحد كافيًا ليتواصلا مع بعضهما

63
00:05:41,400 --> 00:05:46,120
.ولذلك تعدّ أقصر مراسلةٍ في العالم

64
00:05:47,490 --> 00:05:50,580
،واثقٌ أنّه حتّى بين سطور هذه الرّسالة القصيرة

65
00:05:50,580 --> 00:05:54,330
.توجد الكثير من الأفكار الّتي لا يعلمها إلّا المرسل والمتلقّي

66
00:05:54,330 --> 00:05:58,500
.عجبًا، إنّك رومانسيّ كما عهدتك

67
00:05:58,500 --> 00:05:59,260
ماذا؟

68
00:05:59,260 --> 00:06:00,970
هل بدوت كذلك الآن؟

69
00:06:02,970 --> 00:06:06,720
.بالمناسبة، ربّما تروقك بعض الكتب الموجودة هناك

70
00:06:06,720 --> 00:06:07,640
حقًا؟

71
00:06:27,120 --> 00:06:28,910
...أيّها المدير، هذه البطاقة البريدية

72
00:06:30,910 --> 00:06:32,750
.لا فائدة

73
00:06:33,210 --> 00:06:37,210
.عندما يدخل في تلك الحالة فلا شيء مما يحيط به سيبلغ مسامعه

74
00:07:01,980 --> 00:07:06,070
.يبدو أنّه انجرف مع القراءة وحاد إلى مكانٍ ما

75
00:07:06,070 --> 00:07:06,660
ماذا؟

76
00:08:36,830 --> 00:08:39,250
.في النهاية تبقى بضاعة العجوز أفضل

77
00:08:40,830 --> 00:08:42,290
!يا ويلي

78
00:08:42,290 --> 00:08:43,340
!لقد نسيت كليًا

79
00:09:05,110 --> 00:09:07,610
ألم تجديه بعد؟

80
00:09:07,610 --> 00:09:10,780
.أعتقد أنّه سيعود قريبًا

81
00:09:12,070 --> 00:09:18,120
طوال سنوات عملي في هذا المجال
.لم أقابل شخصًا شغوفًا بالكتب أكثر منه

82
00:09:18,120 --> 00:09:19,210
حقًا؟

83
00:09:19,210 --> 00:09:22,580
.ما لم تخنّي الذّاكرة فقد كان يكتب أيضًا

84
00:09:22,580 --> 00:09:23,830
.تذكّرت

85
00:09:23,830 --> 00:09:26,750
.كان يطمح ليصير روائيًا

86
00:09:26,750 --> 00:09:28,300
روائيّ؟

87
00:09:28,300 --> 00:09:30,050
!آسف

88
00:09:30,050 --> 00:09:31,130
.آسف

89
00:09:33,840 --> 00:09:35,970
.انجرفت مع القراءة

90
00:09:35,970 --> 00:09:37,430
!آسف

91
00:09:37,430 --> 00:09:39,270
.لا، لا مشكلة

92
00:09:39,730 --> 00:09:42,980
.أعتقد أنّ هذا يحدث لأيٍّ كان

93
00:09:44,940 --> 00:09:47,150
.نِعم الابنة الصّالحة

94
00:09:48,530 --> 00:09:50,320
هل وجدت كتابًا جيّدًا؟

95
00:09:50,320 --> 00:09:50,900
ماذا؟

96
00:09:50,900 --> 00:09:54,870
.حسنٌ، يبدو أنّ أفضل تشكيلةٍ للكتب موجودةٌ هنا

97
00:09:55,320 --> 00:09:58,660
لذلك، أيمكنك أن تخفّض ثمن هذا الكتاب أيّها العجوز؟

98
00:09:58,660 --> 00:10:00,040
!لا

99
00:10:00,040 --> 00:10:02,250
!أرجوك! أترجّاك

100
00:10:02,250 --> 00:10:03,830
.يستحيل

101
00:10:03,830 --> 00:10:06,750
!أرجوك أيّها العجوز. خفّض ثمنه قليلًا

102
00:10:07,040 --> 00:10:09,460
.لا أحد غيري سيرغب بشراء كتابٍ كهذا

103
00:10:09,460 --> 00:10:11,340
!أحمق

104
00:10:11,340 --> 00:10:13,880
.إنّها الطّبعة الأولى

105
00:10:14,590 --> 00:10:17,510
ما رأيك بأن أعطيك معه بطاقةً بريدية قديمة مجانًا؟

106
00:10:17,510 --> 00:10:19,010
.سيكون ذلك كافيًا

107
00:10:21,600 --> 00:10:22,520
!حسنًا، سأشتريه

108
00:10:22,520 --> 00:10:24,020
.شكرًا

109
00:10:24,020 --> 00:10:25,860
!يا لك من مساومٍ بارع

110
00:10:25,860 --> 00:10:27,570
!مهووس كتبٍ أحمق

111
00:10:28,440 --> 00:10:30,900
.اختاري بطاقةً بريدية يا تاتشيبانا-سان

112
00:10:30,900 --> 00:10:31,780
ماذا؟

113
00:10:31,780 --> 00:10:35,320
.لشكركِ على هذا اليوم أو بالأحرى كاعتذارٍ

114
00:10:35,320 --> 00:10:37,740
.يبدو أنّي الوحيد الّذي استمتع بوقته

115
00:10:51,090 --> 00:10:53,170
هل وجدتِ واحدةً جيّدة يا تاتشيبانا-سان؟

116
00:10:53,550 --> 00:10:55,220
.إذًا سأختار هذه

117
00:10:55,220 --> 00:10:55,890
ماذا؟

118
00:10:55,890 --> 00:10:57,340
.اختيارٌ سريع

119
00:10:57,340 --> 00:10:59,260
.كانت على بالي منذ حين

120
00:11:07,860 --> 00:11:09,230
.يا لها من رسالةٍ جميلة

121
00:11:30,790 --> 00:11:32,130
هل رأيتنّ ذلك البارحة؟

122
00:11:32,130 --> 00:11:33,090
!نعم، رأيته

123
00:11:45,520 --> 00:11:47,650
!كيان! أسرعي

124
00:11:47,650 --> 00:11:49,190
!قادمة

125
00:11:52,650 --> 00:11:54,900
هل تعانين من خطبٍ ما في ساقكِ؟

126
00:11:54,900 --> 00:11:56,530
.لا. لا شيء على وجه التّحديد

127
00:11:57,200 --> 00:11:59,530
.أعتقد أنّ جرحكِ قد تماثل للشّفاء

128
00:11:59,530 --> 00:12:00,660
.أجل

129
00:12:00,660 --> 00:12:02,910
.حسنًا، هكذا نكون قد انتهينا من الفحص

130
00:12:02,910 --> 00:12:04,540
.أراكِ في المرّة القادمة

131
00:12:04,540 --> 00:12:05,450
.حسنًا

132
00:12:05,450 --> 00:12:06,960
ستقصدين العمل الآن؟

133
00:12:06,960 --> 00:12:07,960
.نعم

134
00:12:07,960 --> 00:12:09,250
.ما زلتِ مستمرةً في ذلك

135
00:12:09,250 --> 00:12:10,920
مطعمٌ عائليّ، صحيح؟

136
00:12:10,920 --> 00:12:11,880
.نعم

137
00:12:12,340 --> 00:12:13,500
.عن إذنكما

138
00:12:16,760 --> 00:12:21,930
لا يبدو أنّ أكيرا-تشان مهتمّةٌ بالخضوع لإعادة التّأهيل
للعودة إلى فريق المضمار والميدان، أليس كذلك؟

139
00:12:21,930 --> 00:12:24,140
.هذا ما قالته

140
00:12:24,140 --> 00:12:26,850
.رغم أنّها قادرةٌ على العدو من جديد إذا خضعت لإعادة التّأهيل

141
00:12:28,100 --> 00:12:31,940
.الأمر لا يتعلّق بحالتها الجسمانية فقط

142
00:12:32,610 --> 00:12:36,070
.إنّ ذلك صعبٌ في ظلّ عدم اهتمامها بذلك

143
00:12:39,030 --> 00:12:40,820
.تفضّل طلبك

144
00:12:46,290 --> 00:12:50,080
.مجدّدًا، نرحبّ بضيفنا اليوم في برنامجنا

145
00:12:50,500 --> 00:12:52,670
.الكاتب كوجو تشيهيرو-سان

146
00:12:53,250 --> 00:12:54,300
.شكرًا على استضافتي

147
00:12:55,670 --> 00:12:59,680
أخبرنا يا سيّد كوجو، ماذا تعني لك الرّوايات بالتّحديد؟

148
00:12:59,970 --> 00:13:02,140
.إنّه سؤالٌ صعب

149
00:13:02,140 --> 00:13:05,140
.لقد كانت الرّوايات رفيقة دربي

150
00:13:05,640 --> 00:13:09,600
.كنت أكتب الرّوايات دائمًا في السراء والضراء

151
00:13:10,520 --> 00:13:12,860
...بالنّسبة لي، الرّوايات

152
00:13:14,020 --> 00:13:16,030
.مثل الحبيبة

153
00:13:16,690 --> 00:13:19,740
.وأنا على يقينٍ أنّ ذلك لن يتغيّر

154
00:13:20,240 --> 00:13:23,870
إذًا فهذا يعني أنّك دائمًا في علاقةٍ عميقة بالرّوايات، صحيح؟

155
00:13:24,240 --> 00:13:28,330
.حسنًا، آمل أن تواصل كتاباتي تقديم نفس الانطباع

156
00:13:29,330 --> 00:13:31,920
.كان هذا ضيفنا اليوم، كوجو تشيهيرو-سان

157
00:13:31,920 --> 00:13:33,420
.شكرًا جزيلًا

158
00:13:36,710 --> 00:13:37,960
.شكرًا على الوجبة

159
00:13:37,960 --> 00:13:39,760
.شكرًا على زيارتنا

160
00:13:52,230 --> 00:13:54,980
.الرّوايات حبيبته إذًا

161
00:13:59,530 --> 00:14:01,450
.كنت مثله فيما مضى

162
00:14:13,120 --> 00:14:17,090
...في تلك الأيام، كانت الرّوايات تشغل تفكيري ليل نهار

163
00:14:17,920 --> 00:14:19,800
.وأكتب مثل رجلٍ ممسوس

164
00:14:29,720 --> 00:14:31,480
.يا إلهي

165
00:14:37,360 --> 00:14:39,320
...لكن في أحد الأيام

166
00:14:50,200 --> 00:14:52,830
.أصبح ذلك حبًا من طرفٍ واحد

167
00:14:57,210 --> 00:14:59,000
.ومع ذلك سعيت خلفه

168
00:14:59,750 --> 00:15:00,800
...سعيت خلفه

169
00:15:01,460 --> 00:15:02,590
.وواصلت السّعي خلفه

170
00:15:04,300 --> 00:15:07,850
.إلى أن آذيت النّاس من حولي

171
00:15:15,850 --> 00:15:20,940
ألا أحد يمكنه أن يخلّصني من هذا الشّعور الجامح نحو الأدب؟

172
00:15:37,040 --> 00:15:39,840
.فكّتكِ 158 ين

173
00:15:39,840 --> 00:15:41,500
.شكرًا جزيلًا

174
00:16:10,780 --> 00:16:12,330
.بوركت جهودك

175
00:16:12,330 --> 00:16:13,240
.بوركت جهودكِ

176
00:16:26,590 --> 00:16:28,300
.المعذرة، أيّها المدير

177
00:16:31,550 --> 00:16:35,430
.حسنٌ، اشتريت هذا في ذلك اليوم

178
00:16:35,430 --> 00:16:36,810
ذلك اليوم؟

179
00:16:36,810 --> 00:16:38,730
من معرض الكتب المستعملة؟

180
00:16:38,730 --> 00:16:39,900
.نعم

181
00:16:39,900 --> 00:16:42,440
.إنّه كاتب "وبعدها" من تأليف سوسيكي

182
00:16:42,810 --> 00:16:44,940
.أحد كتب أوّل ثلاثية له

183
00:16:44,940 --> 00:16:46,990
.اشتريته بسبب عنوانه فقط

184
00:16:47,610 --> 00:16:48,900
هل قرأته؟

185
00:16:48,900 --> 00:16:51,410
.ليس بعد. إنّه صعبٌ عليّ قليلًا

186
00:16:54,740 --> 00:16:56,120
.فاصل كتاب

187
00:16:57,250 --> 00:17:00,120
.يبدو أنّه استُعمل لوقتٍ طويل

188
00:17:00,120 --> 00:17:01,830
.كان بداخله عندما اشتريته

189
00:17:02,500 --> 00:17:06,800
.واثقٌ أنّ صاحبه يُطالع الكثير من الكتب

190
00:17:06,800 --> 00:17:10,840
ينبغي أن أرجعه، صحيح؟

191
00:17:10,840 --> 00:17:13,300
.لا، لا حاجة لذلك

192
00:17:13,300 --> 00:17:16,100
.إنّه جزءٌ من هذا الكتاب

193
00:17:16,850 --> 00:17:19,810
.يمكنكِ القول أنّه تاريخ هذا الكتاب بحدّ ذاته

194
00:17:20,270 --> 00:17:23,440
.هذا أحد أفضل أوجه الكتب المستعملة

195
00:17:23,440 --> 00:17:25,690
.وتصميم ورقة البرسيم جميل

196
00:17:25,690 --> 00:17:27,110
.احرصي على الاعتناء به

197
00:17:28,240 --> 00:17:29,780
...هذا

198
00:17:30,860 --> 00:17:32,200
!إنّه اكتشافٌ عظيم

199
00:17:34,160 --> 00:17:35,030
.انظري

200
00:17:36,410 --> 00:17:37,330
!إنّه طائر السنونو

201
00:17:38,330 --> 00:17:39,370
.أجل

202
00:17:40,290 --> 00:17:42,790
.لكن لا أعتقد أنّه من المفترض أن يكون شفافًا

203
00:17:43,420 --> 00:17:46,500
.أظنّ أنّ الورق بهُت مع مرور الوقت

204
00:17:49,590 --> 00:17:54,680
.بالحديث عن هذا، كان عشٌّ لطائر السّنونو فوق ذلك الباب

205
00:17:54,680 --> 00:17:56,970
ماذا؟ حقًا؟

206
00:17:56,970 --> 00:17:59,350
.قامت كوبو-سان بإزالته

207
00:17:59,350 --> 00:18:00,060
!ماذا؟

208
00:18:00,060 --> 00:18:02,230
.فضلات تلك الطّيور مريعة

209
00:18:02,230 --> 00:18:05,940
.لم يكن لنا خيارٌ آخر فهذا مطعم، لكنّي كنت متأسّفًا لذلك

210
00:18:05,940 --> 00:18:09,480
.لا تقلقي، لقد انتظرت إلى أن غادرته كلّ الفراخ

211
00:18:13,200 --> 00:18:16,530
،كان من بينها فرخٌ وجد صعوبةً في الطّيران

212
00:18:16,530 --> 00:18:20,120
.جعلني قلقًا، لكنّهم غادروا جميعًا العشّ بسلام في النّهاية

213
00:18:27,290 --> 00:18:28,300
...إن

214
00:18:29,760 --> 00:18:33,720
،إن لم يتمكّن ذلك السنونو من التّحليق مع الآخرين

215
00:18:33,720 --> 00:18:35,590
ماذا كان سيحدث له؟

216
00:18:46,440 --> 00:18:48,480
...حتّى إن عجز عن التّحليق

217
00:18:49,270 --> 00:18:54,660
.قد يجد بعض السّعادة إذا مكث هناك

218
00:18:55,740 --> 00:18:58,120
.وفي النّهاية ينسى رفاقه

219
00:18:59,030 --> 00:19:01,830
لكن، إن كان سبب عدم تحليق ذلك السّنونو

220
00:19:02,750 --> 00:19:05,040
...أنّه تخلّى عن المحاولة

221
00:19:06,380 --> 00:19:09,460
.فبالتأكيد سيحدّق إلى السّماء كلّ يوم

222
00:19:10,710 --> 00:19:13,510
.إلى أبد الآبدين

223
00:19:16,680 --> 00:19:17,840
.أمزح فحسب

224
00:19:19,470 --> 00:19:21,770
.آسف. أسهبت في الحديث

225
00:19:21,770 --> 00:19:23,730
.تفضّلي. شكرًا لكِ

226
00:19:24,690 --> 00:19:26,600
.ها أنا أقوم بنفس ما فعلته في معرض الكتب

227
00:19:26,600 --> 00:19:29,150
.لا فائدة ترجى منّي

228
00:19:34,610 --> 00:19:35,530
.أيّها المدير

229
00:19:38,280 --> 00:19:42,240
.أسعدني سماع كلماتك

230
00:19:42,660 --> 00:19:44,290
ماذا؟ كلماتي؟

231
00:19:45,080 --> 00:19:48,330
،أريد سماع المزيد من كلماتك

232
00:19:48,330 --> 00:19:51,800
.ويومًا ما، أرغب في قراءة كلماتك

233
00:19:53,800 --> 00:19:55,670
كلماتي؟

234
00:19:56,680 --> 00:20:01,560
أنت تدوّن ملاحظات من أجل الرّواية الّتي ستكتبها مستقبلًا، صحيح؟

235
00:20:05,560 --> 00:20:06,980
رغم حالي هذا؟

236
00:20:10,400 --> 00:20:12,360
.بالذّات لأنّك هكذا

237
00:20:13,730 --> 00:20:14,740
،وبعدها

238
00:20:15,740 --> 00:20:18,450
،إن كان ذلك السّنونو قد تخلّى عن التّحليق حقًا

239
00:20:19,320 --> 00:20:24,040
.على الأرجح كان لينسى حتّى النّظر إلى السّماء

240
00:20:26,540 --> 00:20:28,580
...السنونو يعلم

241
00:20:29,540 --> 00:20:31,540
...أنّ أيّ مكانٍ يقيك من المطر

242
00:20:32,380 --> 00:20:34,340
.سيحجب عنك أشعّة الشّمس أيضًا

243
00:20:38,550 --> 00:20:42,930
.أنا على يقينٍ أنّي سأحبّ الرّواية الّتي ستكتبها كيفما كانت

244
00:21:00,820 --> 00:21:02,490
.أريد أن يُغفر لي

245
00:21:02,490 --> 00:21:05,080
.ما كنت لأبتغي شيئًا دراميًّا كهذا

246
00:21:06,410 --> 00:21:10,370
.لكنّي أردت دائمًا أن أسمع تلك الكلمات من أحدهم

247
00:21:11,920 --> 00:21:13,080
".أنت على ما يرام كما أنت"

248
00:21:15,710 --> 00:21:16,760
.شكرًا