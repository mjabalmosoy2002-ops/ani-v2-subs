1
00:00:02,940 --> 00:00:05,820
.إنّكِ لا تستوعبين شيئًا يا تاتشيبانا-سان

2
00:00:05,820 --> 00:00:07,900
.لا تستوعبين شيئًا

3
00:00:07,900 --> 00:00:10,280
.جرّبي الخروج معي في موعد

4
00:00:10,280 --> 00:00:11,530
.واثقٌ أنّكِ ستفزعين

5
00:00:11,530 --> 00:00:12,740
!ستخرج معي في موعد؟

6
00:00:12,740 --> 00:00:14,330
...نعم، في موعد

7
00:00:14,330 --> 00:00:15,450
ماذا؟

8
00:00:15,450 --> 00:00:18,500
قلت للتّو إنّ عليّ الخروج معك في موعد، صحيح؟

9
00:00:18,500 --> 00:00:19,670
...ماذا؟ حسنٌ، ما قصدته

10
00:00:19,670 --> 00:00:21,080
قلت ذلك، أليس كذلك؟

11
00:00:24,090 --> 00:00:25,050
.قلتها

12
00:00:26,920 --> 00:00:32,140
.وقف خادم أحد الساموراي تحت بوّابة الرّاشومون ينتظر انقطاع المطر

13
00:00:32,140 --> 00:00:36,390
،لا أحد غير هذا الرّجل تحت البوّابة العريضة

14
00:00:36,390 --> 00:00:43,730
.على الدّعامة الضّخمة الّتي تقشّر اللّك الّذي يكسوها هنا وهناك، جثم صرّار

15
00:00:43,730 --> 00:00:46,820
،بما أنّ الرّاشومون تنتصب على جادة سوزاكو

16
00:00:46,820 --> 00:00:51,910
فقد كان يتوّقع أن تكون هناك قلّة من أناسٍ آخرين
،يعتمرون قبّعاتٍ من نبات السّعادي أو أعطية رأس نبلاء

17
00:00:51,910 --> 00:00:54,620
.ينتظرون انحسار العاصفة المطيرة

18
00:00:54,620 --> 00:00:57,620
.لكن لا أحد آخر في الجوار عدا هذا الرّجل

19
00:02:31,840 --> 00:02:34,680
.أجل، أُشاطرك الرّأي

20
00:02:33,130 --> 00:02:34,680
.بوركت جهودك

21
00:02:34,680 --> 00:02:36,430
!أجل، أجل

22
00:02:38,430 --> 00:02:40,560
.لك خالص اعتذاري

23
00:02:40,560 --> 00:02:42,520
.أجل، أجل

24
00:02:42,520 --> 00:02:44,390
.بكلّ تأكيد

25
00:02:44,770 --> 00:02:47,400
.أجل. لن يحدث هذا مجدّدًا

26
00:02:47,400 --> 00:02:48,560
.أجل

27
00:02:48,560 --> 00:02:51,030
.أستأذنك إذًا

28
00:02:52,740 --> 00:02:55,990
كاسي-كُن، هلّا ذهبت وحلقت شعرك؟

29
00:02:55,990 --> 00:02:57,700
.آسف

30
00:02:57,700 --> 00:02:59,410
.سأحلقه قبل مجيئي في المرّة القادمة

31
00:02:59,410 --> 00:03:01,620
.هذا ما تقوله دائمًا

32
00:03:01,620 --> 00:03:05,000
.تذكّرت، علّقت جدول ساعات العمل الجديد، ألقي نظرةً عليه

33
00:03:05,000 --> 00:03:06,210
.حاضر

34
00:03:15,800 --> 00:03:17,180
.بوركت جهودك

35
00:03:17,180 --> 00:03:19,140
.بوركت جهودكِ

36
00:03:29,900 --> 00:03:32,360
أنت متفرّغٌ هذا السّبت أيّها المدير، صحيح؟

37
00:03:33,530 --> 00:03:37,240
.رأيت ذلك في جدول ساعات العمل الجديد

38
00:03:38,990 --> 00:03:41,410
.نعم، أنا متفرّغٌ في ذلك اليوم

39
00:03:41,410 --> 00:03:43,080
.إنّه يوم عطلتي أيضًا

40
00:03:45,460 --> 00:03:47,290
...بشأن ذلك الأمر

41
00:03:49,500 --> 00:03:50,710
ذلك الأمر؟

42
00:03:51,040 --> 00:03:54,170
.قلت... إنّنا سنخرج في موعد

43
00:03:54,710 --> 00:03:57,260
—ذلك، قلت ذلك على سبيل المثال فقط

44
00:03:57,260 --> 00:03:58,970
ما رأيك بهذا السّبت؟

45
00:03:58,970 --> 00:03:59,970
ماذا؟ هذا السّبت؟

46
00:03:59,970 --> 00:04:00,930
.لأجل موعدنا

47
00:04:00,930 --> 00:04:02,600
...حسنٌ، هذا

48
00:04:02,600 --> 00:04:03,600
!من فضلك اخرج معي في موعد

49
00:04:03,600 --> 00:04:05,430
.حـ-حسنًا

50
00:04:05,430 --> 00:04:07,060
.هذا وعد

51
00:04:07,060 --> 00:04:07,770
.أجل

52
00:04:09,810 --> 00:04:11,360
.أتطلّع لذلك

53
00:04:15,990 --> 00:04:17,650
ماذا؟ وظيفة بدوامٍ جزئيّ؟

54
00:04:18,070 --> 00:04:19,860
.أملك واحدةً بالفعل

55
00:04:21,030 --> 00:04:22,120
.أجل

56
00:04:22,120 --> 00:04:24,870
.مدرّسٌ خصوصيّ إذن

57
00:04:24,870 --> 00:04:26,330
كم الأجر للسّاعة؟

58
00:04:28,120 --> 00:04:30,210
.في الواقع هذا مغرٍ

59
00:04:30,750 --> 00:04:32,080
أهوّ شخصٌ في الثّانوية؟

60
00:04:33,750 --> 00:04:35,960
.الإنجليزية إذن

61
00:04:39,510 --> 00:04:42,010
.حسنًا، أعتقد أنّي قادرٌ على فعلها

62
00:04:42,010 --> 00:04:43,140
.أجل

63
00:04:43,140 --> 00:04:43,930
.نعم

64
00:04:44,350 --> 00:04:47,390
.يبدو هذا مغريًا

65
00:04:53,520 --> 00:04:55,150
.أعتذر

66
00:04:55,150 --> 00:04:57,690
إذًا، هل تلميذة الثّانوية هذه ظريفة؟

67
00:04:58,820 --> 00:05:01,570
!ماذا؟ فتى؟ أتمازحني؟

68
00:05:02,410 --> 00:05:04,870
.إن كان الأمر يتعلّق بالثّانوية، فأنا أريد تدريس فتاة

69
00:05:04,870 --> 00:05:06,370
المكان خالٍ الآن، أليس كذلك؟

70
00:05:06,370 --> 00:05:07,290
.بالفعل

71
00:05:07,290 --> 00:05:08,870
...يا لحزني

72
00:05:08,870 --> 00:05:10,000
!حقًا؟

73
00:05:10,000 --> 00:05:12,920
.نعم. خسرت كلّ المال الّذي قبضته الشّهر الماضي

74
00:05:12,920 --> 00:05:14,340
في آلة القمار؟

75
00:05:14,340 --> 00:05:15,130
.نعم

76
00:05:15,130 --> 00:05:18,050
!يا إلهي، أليس هذا مروّعًا؟

77
00:05:18,420 --> 00:05:21,180
—استمع إلى هذا يا كاسي-سان. أوتسكا-سان

78
00:05:21,180 --> 00:05:21,970
.تاتشيبانا-تشان

79
00:05:21,970 --> 00:05:22,590
ماذا؟

80
00:05:22,590 --> 00:05:24,390
ماذا تريدين كوجبةٍ لكِ؟

81
00:05:25,720 --> 00:05:27,390
.ساندويتش لو سمحت

82
00:05:28,520 --> 00:05:29,850
.عُلم

83
00:05:32,350 --> 00:05:34,270
.تاتشيبانا أكيرا

84
00:05:34,270 --> 00:05:36,150
.تلميذةٌ في السّنة الثّانية من الثّانوية

85
00:05:36,150 --> 00:05:39,740
.إنّها هادئةٌ ومتبلّدة المشاعر مقارنةً بفتاةٍ في عمرها

86
00:06:05,850 --> 00:06:07,220
.لا أتصوّر ذلك

87
00:06:13,690 --> 00:06:14,310
.تاتشيبانا-تشان

88
00:06:15,020 --> 00:06:16,190
.وجبتكِ جاهزة

89
00:06:17,110 --> 00:06:18,570
.شكرًا جزيلًا لك

90
00:06:21,860 --> 00:06:23,360
إلى ما كانت تنظر؟

91
00:06:24,530 --> 00:06:25,820
.المعذرة يا كاسي-سان

92
00:06:25,820 --> 00:06:27,070
ما هذا؟

93
00:06:28,030 --> 00:06:29,660
.هذا

94
00:06:30,540 --> 00:06:31,790
.إنّها إضافةٌ منّي

95
00:06:34,870 --> 00:06:35,580
.شكرًا لك

96
00:06:40,500 --> 00:06:42,210
.يا لها من جامدة المشاعر

97
00:07:05,660 --> 00:07:06,570
.بوركت جهودكِ

98
00:07:06,570 --> 00:07:08,240
.بوركت جهودك

99
00:07:08,240 --> 00:07:10,370
ماذا؟ انتهيت من استراحتكِ بهذه السّرعة؟

100
00:07:10,370 --> 00:07:11,410
.نعم

101
00:07:14,040 --> 00:07:15,330
أكنتِ تدرسين؟

102
00:07:15,330 --> 00:07:15,960
.نعم

103
00:07:16,250 --> 00:07:17,420
.لديّ امتحانٌ قريب

104
00:07:17,420 --> 00:07:20,340
.رؤية ذلك الكتاب تعيد إليّ الذّكريات

105
00:07:20,340 --> 00:07:22,380
أتمانعين إن ألقيت نظرةً عليه؟

106
00:07:22,960 --> 00:07:23,800
لا تريدين؟

107
00:07:24,590 --> 00:07:26,090
.لا مانع على ما أظنّ

108
00:07:26,090 --> 00:07:27,430
.شكرًا

109
00:07:29,390 --> 00:07:31,850
.دعه هناك عندما تنتهي من تصفّحه

110
00:07:31,850 --> 00:07:33,020
.حسنًا

111
00:07:35,390 --> 00:07:36,850
.شكرًا على الوجبة

112
00:07:43,820 --> 00:07:46,990
أهلًا وسهلًا! كم عددكم؟

113
00:07:46,990 --> 00:07:47,950
.اثنان

114
00:07:47,950 --> 00:07:49,950
أتودّان طاولةً للتّدخين أم لا؟

115
00:07:49,950 --> 00:07:50,870
.لا

116
00:07:50,870 --> 00:07:52,410
.كما تأمر

117
00:07:52,410 --> 00:07:54,370
.تفضّلا بالجلوس في أيّ طاولةً تروقكما

118
00:08:06,590 --> 00:08:10,680
.لا يصحّ أن تخربشي أثناء الحصص الدّراسيّة

119
00:08:14,770 --> 00:08:16,390
.رجاءً لا تخبر أحدًا

120
00:08:18,020 --> 00:08:20,060
.لا مانع لديّ

121
00:08:24,480 --> 00:08:25,940
،لكن بالمقابل

122
00:08:26,940 --> 00:08:28,400
.عليكِ الخروج معي في موعد

123
00:08:29,820 --> 00:08:31,030
عفوًا؟

124
00:08:38,410 --> 00:08:39,370
.كاسي-سان

125
00:08:41,380 --> 00:08:42,380
ماذا؟

126
00:08:42,380 --> 00:08:43,920
أليس لديكِ دوامٌ مدرسيّ اليوم؟

127
00:08:43,920 --> 00:08:44,840
.بلى

128
00:08:44,840 --> 00:08:47,090
.إذًا فقد عدتِ إلى المنزل لتغيير ملابسكِ

129
00:08:47,090 --> 00:08:47,840
.نعم

130
00:08:49,800 --> 00:08:50,840
.فهمت

131
00:08:50,840 --> 00:08:52,430
حسنًا، هلّا ذهبنا؟

132
00:09:16,450 --> 00:09:17,080
.تفضّلي

133
00:09:17,450 --> 00:09:18,160
.شكرًا

134
00:09:18,160 --> 00:09:20,540
.سمعتُ أنّه مرعبٌ جدًا

135
00:09:20,540 --> 00:09:21,370
أستكونين بخير؟

136
00:09:22,920 --> 00:09:25,710
.يمكنكِ التشبّث بيدي إذا تملّككِ الخوف

137
00:09:27,130 --> 00:09:29,220
.المكان فارغ لأنّنا في منتصف الأسبوع

138
00:09:29,220 --> 00:09:30,090
.بالفعل

139
00:09:37,220 --> 00:09:39,230
ظننت أنّكِ ذهبتِ إلى صالون الأظافر؟

140
00:09:39,230 --> 00:09:40,430
!انجو بحياتك يا ناثان

141
00:09:40,430 --> 00:09:43,100
!إنّها لم تعد أنجيليكا الّتي نعرفها

142
00:09:43,100 --> 00:09:44,230
!هذا ليس صحيحًا

143
00:09:44,230 --> 00:09:46,440
أجيبيني يا أنجيليكا! هذا أنا! أنتِ تتذكّرينني، أليس كذلك؟

144
00:09:46,440 --> 00:09:48,070
...أسرعي و

145
00:09:49,400 --> 00:09:51,700
!ما هذا بحقّ يا أنجيليكا

146
00:09:53,990 --> 00:09:54,780
ماذا؟

147
00:09:54,780 --> 00:09:56,030
ستعودين إلى المنزل بهذه السّرعة؟

148
00:09:56,490 --> 00:09:58,080
ألستِ جائعة؟

149
00:09:59,790 --> 00:10:02,210
.أعدّت لي والدتي الغداء سلفًا

150
00:10:03,000 --> 00:10:04,210
.وإليك هذا

151
00:10:04,500 --> 00:10:06,670
.هذا ثمن تذكرة الفيلم والكتيّب والكولا

152
00:10:11,550 --> 00:10:13,180
.فلنشرب فنجان شايٍ على الأقل

153
00:10:13,180 --> 00:10:14,840
.فهذا يفترض أن يكون موعدًا

154
00:10:14,840 --> 00:10:16,640
.أهلًا وسهلًا

155
00:10:19,970 --> 00:10:21,430
.استمتعا بوقتكما

156
00:10:31,900 --> 00:10:34,280
أنتِ ضمن فريق المضمار والميدان يا تاتشيبانا-تشان، صحيح؟

157
00:10:35,450 --> 00:10:37,370
.كنتُ كذلك

158
00:10:37,740 --> 00:10:39,580
.سمعت أنّكِ اعتزلتِ بسبب الإصابة

159
00:10:39,910 --> 00:10:43,210
.قال يوشيزاوا-كُن أنّكِ كنتِ عدّاءةً فائقة السّرعة

160
00:10:44,000 --> 00:10:45,790
.كلّ ذلك من الماضي

161
00:10:45,790 --> 00:10:50,590
ما الشّعور الّذي ينجم عن خسارة شيءٍ كنتِ شغوفةً به فجأةً؟

162
00:10:51,210 --> 00:10:53,170
.أعتذر إن أسأت إليكِ

163
00:10:53,170 --> 00:10:55,050
فكلّ ذلك أضحى من الماضي، صحيح؟

164
00:10:59,260 --> 00:11:02,520
.كنتُ محبطةً خلال تلك الفترة، لكنّني بخيرٍ الآن

165
00:11:02,520 --> 00:11:04,100
.أستمتع بوقتي في العمل

166
00:11:04,100 --> 00:11:05,600
بسبب وجود المدير هناك؟

167
00:11:06,850 --> 00:11:08,440
.تلاقت أعيننا أخيرًا

168
00:11:09,360 --> 00:11:12,900
،بما أنّني وفيت بوعدي بالخروج معك
فستبقي ذلك طيّ الكتمان، صحيح؟

169
00:11:13,190 --> 00:11:15,150
أتسمّين هذا موعدًا؟

170
00:11:17,070 --> 00:11:22,580
،بعبارةٍ أخرى، خسرتِ فريق المضمار والميدان
والآن تملئين ذلك الفراغ بالحبّ؟

171
00:11:22,950 --> 00:11:26,750
لكن أليس مقرفًا أن يكون كهلًا في الـ45؟

172
00:11:29,420 --> 00:11:30,710
.سأنصرف

173
00:11:32,000 --> 00:11:32,500
...مهلًا

174
00:11:33,460 --> 00:11:34,760
.انتظري

175
00:11:34,760 --> 00:11:37,430
.لا حاجة لأن تدفعي ثمن شيء

176
00:11:39,050 --> 00:11:39,680
.قلت انتظري

177
00:11:42,100 --> 00:11:43,350
.أبعد يدك عنّي

178
00:11:45,430 --> 00:11:46,350
.هاتفكِ يرنّ

179
00:11:46,810 --> 00:11:47,810
...المتّصل هو

180
00:11:49,520 --> 00:11:50,520
.المدير

181
00:11:52,900 --> 00:11:53,900
تودّين الإجابة؟

182
00:12:02,370 --> 00:12:03,990
مرحبًا؟ مرحبًا؟

183
00:12:03,990 --> 00:12:06,410
.أ-أنا كوندو من مطعم جاردن

184
00:12:07,040 --> 00:12:08,420
هل هذا وقتٌ مناسبٌ للحديث؟

185
00:12:09,120 --> 00:12:10,130
.نعم

186
00:12:10,130 --> 00:12:16,590
...حسنٌ، بشأن ما تحدّثنا عنه سابقًا... مـ-مـ-موعدنا

187
00:12:16,590 --> 00:12:18,760
أترغبين بالذّهاب إلى مكانٍ معيّن؟

188
00:12:20,180 --> 00:12:23,600
.أ-أودّ الذّهاب إلى مكانٍ تودّ الذّهاب إليه

189
00:12:23,600 --> 00:12:25,680
.فـ-فهمت

190
00:12:25,680 --> 00:12:27,890
.إذًا سأفكّر في مكانٍ ما

191
00:12:28,560 --> 00:12:30,560
.أجل، من فضلك

192
00:12:49,330 --> 00:12:51,290
تكنّين له كلّ هذا الحبّ؟

193
00:12:55,550 --> 00:12:58,130
.لن تنجح العلاقة بينكِ وبين المدير

194
00:12:58,130 --> 00:12:59,220
.حتمًا

195
00:12:59,840 --> 00:13:02,180
.أنا لا أحاول أن أكون فظًّا

196
00:13:02,550 --> 00:13:05,930
.إنّما أحاول القول أنّ لديكِ خيارات أفضل يمكنكِ السّعي إليها

197
00:13:16,820 --> 00:13:18,360
.إنّها نصيحة

198
00:13:19,280 --> 00:13:21,320
.لنكتفِ اليوم بهذا

199
00:13:23,030 --> 00:13:24,700
.سنكمل حديثنا في المرّة القادمة

200
00:13:32,620 --> 00:13:34,000
.أهلًا بعودتكِ

201
00:13:34,000 --> 00:13:36,840
.هذا يبدو فيلمًا مشوّقًا

202
00:13:37,130 --> 00:13:39,050
أواثقة من رغبتكِ في التخلّص منه؟

203
00:13:39,380 --> 00:13:41,220
.نعم، لا بأس

204
00:13:41,220 --> 00:13:42,470
.تخلّصي منه رجاءً

205
00:13:51,690 --> 00:13:55,110
.أنا كوندو من مطعم جاردن

206
00:14:05,240 --> 00:14:07,450
.لن تنجح العلاقة بينكِ وبين المدير

207
00:14:15,750 --> 00:14:19,710
هذا هو مكان اللّقاء، صحيح؟

208
00:14:20,260 --> 00:14:22,550
.أحتاج سيجارة

209
00:14:22,550 --> 00:14:26,010
.لعلّي سأذهب لتدخين سيجارة

210
00:14:26,010 --> 00:14:29,310
.لكن من السيّئ لو جاءت في غيابي

211
00:14:29,310 --> 00:14:30,810
.ا-المدير

212
00:14:31,350 --> 00:14:32,600
.لقد تأخّرت

213
00:14:34,100 --> 00:14:35,440
.أعتذر

214
00:14:37,360 --> 00:14:38,190
...المعذرة

215
00:14:38,980 --> 00:14:41,030
.تبدين مختلفةً عن المعتاد

216
00:14:41,030 --> 00:14:45,110
.ربّما بسبب تسريحتي المختلفة

217
00:14:47,700 --> 00:14:49,620
إذًا هلّا ذهبنا؟

218
00:14:50,330 --> 00:14:51,040
.حسنًا

219
00:14:55,170 --> 00:14:57,170
ظننت أنّكِ ذهبتِ إلى صالون الأظافر؟

220
00:14:57,170 --> 00:14:58,380
!انجو بحياتك يا ناثان

221
00:14:58,380 --> 00:15:01,000
!إنّها لم تعد أنجيليكا الّتي نعرفها

222
00:15:01,000 --> 00:15:02,130
!هذا ليس صحيحًا

223
00:15:02,130 --> 00:15:04,380
!أجيبيني يا أنجيليكا! هذا أنا! أنتِ تتذكّرينني، أليس كذلك؟

224
00:15:04,380 --> 00:15:06,010
...أسرعي و

225
00:15:07,220 --> 00:15:08,890
!ما هذا بحقّ يا أنجيليكا

226
00:15:08,890 --> 00:15:10,100
!ناثان

227
00:15:10,100 --> 00:15:13,230
.كان فيلمًا ممتعًا

228
00:15:13,230 --> 00:15:16,440
.لا أستطيع المجيء لمشاهدة فيلمٍ كهذا عندما أكون مع يوتو

229
00:15:16,940 --> 00:15:18,400
ما رأيكِ به يا تاتشيبانا-سان؟

230
00:15:19,150 --> 00:15:20,440
...ماذا؟ حـ

231
00:15:21,280 --> 00:15:23,780
.كان مشوّقًا لدرجة أنّي أستطيع مشاهدته مرارًا وتكررًا

232
00:15:24,190 --> 00:15:25,360
.فهمت

233
00:15:25,360 --> 00:15:26,820
.يسعدني أنّه راقكِ

234
00:15:27,780 --> 00:15:30,660
إذًا هلّا عدنا أدرجنا بما أنّنا انتهينا من مشاهدة الفيلم؟

235
00:15:31,540 --> 00:15:35,040
.أودّ شرب شيء

236
00:15:33,790 --> 00:15:35,040
.أهلًا وسهلًا

237
00:15:35,910 --> 00:15:37,960
أيمكنني أخذ طلباتكما؟

238
00:15:40,380 --> 00:15:42,500
...حـ-حسنٌ

239
00:15:42,500 --> 00:15:44,550
.شاي برتقالٍ مثلّج من فضلك

240
00:15:44,550 --> 00:15:45,470
.حاضر

241
00:15:45,470 --> 00:15:50,600
...أنا، حسنٌ

242
00:15:51,470 --> 00:15:54,020
.قهوة كيليمانجارو ساخنة من فضلكِ

243
00:15:54,020 --> 00:15:55,230
.كما تأمر

244
00:15:55,230 --> 00:15:58,440
.بصري يضعف أكثر بسبب تقدّمي في السنّ

245
00:16:03,820 --> 00:16:06,530
.أعتذر لتصرّفي ككهل

246
00:16:08,030 --> 00:16:10,570
هل تتردّدين على هذا المكان كثيرًا يا تاتشيبانا-سان؟

247
00:16:10,570 --> 00:16:12,280
...لا

248
00:16:12,280 --> 00:16:14,120
.من حينٍ لآخر

249
00:16:14,120 --> 00:16:16,460
.فهمت

250
00:16:18,080 --> 00:16:18,710
.أيّها المدير

251
00:16:19,040 --> 00:16:20,040
كم؟

252
00:16:20,040 --> 00:16:22,130
.ماذا؟ خمسٌ وأربعون

253
00:16:23,750 --> 00:16:29,890
.واحد، اثنان، ثلاثة، أربعة، خمسة، ستّة، سبعة

254
00:16:24,130 --> 00:16:26,220
!تقصدين قطع السكّر؟

255
00:16:26,220 --> 00:16:27,670
!لا أحتاج للسكّر

256
00:16:30,390 --> 00:16:31,430
.آسفة

257
00:16:31,430 --> 00:16:33,390
.لا بأس

258
00:16:36,640 --> 00:16:37,560
.حلو

259
00:16:40,480 --> 00:16:41,480
...هذا المذاق

260
00:16:42,610 --> 00:16:46,940
.حاولت التّباهي وطلبت قهوةً سوداء في أوّل موعدٍ لي

261
00:16:47,530 --> 00:16:49,570
.لكنّ مذاقها كان شديد المرارة

262
00:16:49,570 --> 00:16:53,950
فانتهى بي المطاف بإضافة الكثير من قطع
.السكّر أثناء ذهاب رفيقتي إلى الحمّام

263
00:16:58,160 --> 00:17:01,500
.إنّه مذاق الشّباب الحلو والمرّ

264
00:17:08,260 --> 00:17:10,090
.أهلًا وسهلًا

265
00:17:10,090 --> 00:17:13,180
...بالمناسبة، الفيلم الّذي شاهدناه قبل قليل

266
00:17:13,180 --> 00:17:14,760
.لم يكن في المستوى

267
00:17:15,430 --> 00:17:16,220
.بالفعل

268
00:17:17,310 --> 00:17:18,390
ماذا؟ حقًا؟

269
00:17:18,390 --> 00:17:19,940
.نعم

270
00:17:19,940 --> 00:17:21,980
.هذا رائع

271
00:17:21,980 --> 00:17:23,270
إلى أين تودّين الذّهاب تاليًا؟

272
00:17:23,270 --> 00:17:25,440
.أينما أردت يا شون-كُن

273
00:17:25,440 --> 00:17:26,980
ما هذا المقهى؟

274
00:17:27,360 --> 00:17:28,690
.إنّه يعجّ باليافعين

275
00:17:34,160 --> 00:17:35,120
أيّها المدير؟

276
00:17:35,830 --> 00:17:36,790
.نعم

277
00:17:36,790 --> 00:17:39,370
.دعينا نذهب

278
00:17:40,750 --> 00:17:42,250
.لا حاجة للفاتورة

279
00:17:42,250 --> 00:17:44,080
.شكرًا جزيلًا لك

280
00:17:46,960 --> 00:17:47,630
...المعذرة

281
00:17:47,630 --> 00:17:48,300
نعم؟

282
00:17:48,630 --> 00:17:49,460
أيمكنني أخذها؟

283
00:18:05,730 --> 00:18:07,570
...حسنٌ

284
00:18:08,440 --> 00:18:09,780
.أستسمحكِ للحظة

285
00:18:17,200 --> 00:18:18,330
مرحبًا؟

286
00:18:18,330 --> 00:18:20,410
.بوركت جهودك

287
00:18:20,410 --> 00:18:21,290
.أجل

288
00:18:22,000 --> 00:18:22,620
.نعم

289
00:18:23,420 --> 00:18:24,880
أهذا صحيح؟

290
00:18:26,130 --> 00:18:27,750
.فهمت

291
00:18:37,140 --> 00:18:39,220
.أجل

292
00:18:39,220 --> 00:18:41,350
.حسنًا، شكرًا على اتّصالك

293
00:18:42,430 --> 00:18:43,560
—أعتذر يا تاتشيبانا-سـ

294
00:18:57,530 --> 00:19:03,460
.يعتصر الحزن صدري باستمرار بسبب شبابها وبراءتها

295
00:19:00,990 --> 00:19:01,950
.الجوّ حار

296
00:19:03,460 --> 00:19:08,170
.ولعدم تقبّلي لحقيقة أنّ أيّام شبابي قد ولّت

297
00:19:11,300 --> 00:19:12,840
.آسف

298
00:19:12,840 --> 00:19:15,090
.يجب أن أعود إلى المطعم

299
00:19:15,840 --> 00:19:18,430
.ليس فقط بسبب ما يقوله الآخرون

300
00:19:18,430 --> 00:19:22,060
.فوق كلّ ذلك، لا أريد أن أجرح نفسي

301
00:19:23,060 --> 00:19:26,020
.واثقٌ أنّها أحسّت بالضّجر رفقتي

302
00:19:26,020 --> 00:19:28,730
.هذا بدهيّ بما أنّه موعدٌ مع كهلٍ مثلي

303
00:19:29,520 --> 00:19:31,690
،ذلك الشّباب الحلو والمرّ انقضى

304
00:19:32,940 --> 00:19:35,150
.وكلّ ما تبقّى هو المعاناة

305
00:19:38,910 --> 00:19:41,740
.إذًا أراكِ لاحقًا في مطعم جاردن

306
00:19:41,740 --> 00:19:43,620
.شكرًا لك على هذا اليوم

307
00:19:43,620 --> 00:19:44,750
.العفو

308
00:19:46,500 --> 00:19:47,120
.بالإذن

309
00:20:43,260 --> 00:20:44,850
.لقد عدت

310
00:20:47,140 --> 00:20:48,480
!أكيرا

311
00:20:48,480 --> 00:20:51,690
هل ذهبتِ لمشاهدة نفس الفيلم مرّتين؟

312
00:20:51,690 --> 00:20:54,150
.مع أنّكِ قلتِ إنّه مملّ

313
00:20:55,230 --> 00:20:56,570
!أيّهما جلبت اليوم؟

314
00:20:56,570 --> 00:20:57,400
ماذا؟

315
00:20:57,400 --> 00:20:58,490
.لا أعرف

316
00:20:58,490 --> 00:21:00,530
!لماذا خلطتِ بينهما؟

317
00:21:00,530 --> 00:21:03,120
!ألم أخبركِ بأن تتخلّصي من السّابق؟

318
00:21:03,120 --> 00:21:04,790
لكنّهما متشابهان، أليس كذلك؟

319
00:21:04,790 --> 00:21:05,620
!ليسا كذلك

320
00:21:16,670 --> 00:21:19,340
.ليسا متشابهين مطلقًا