1
00:00:01,690 --> 00:00:04,860
.إنّي أحبّك أيّها المدير

2
00:00:14,870 --> 00:00:16,660
حقًا؟

3
00:00:16,660 --> 00:00:18,870
!شكرًا

4
00:00:43,940 --> 00:00:46,530
ماذا يقصد بقوله "شكرًا"؟

5
00:00:47,280 --> 00:00:51,780
أيعقل أنّي قلتها على نحوٍ خاطئ؟

6
00:02:27,590 --> 00:02:31,380
عندما أحسّ بالاكتئاب، لا شيء يساعدني
.على التّعافي أكثر من السّكاكر

7
00:02:31,380 --> 00:02:33,510
.أنتِ تفرطين في أكلها

8
00:02:33,510 --> 00:02:35,050
.لم يحن وقت الغداء بعد

9
00:02:35,050 --> 00:02:36,590
!وهذا سببٌ إضافيّ لأكلها

10
00:02:37,890 --> 00:02:39,310
!أشعر بالانتعاش مثل بسكويت الشّوكولاتة هذا

11
00:02:39,310 --> 00:02:41,310
.لا شكّ أنّ هذا يعني أنّكِ محطّمة لأشلاء

12
00:02:41,310 --> 00:02:44,230
.اسمعن، ثمّة ما أريد سؤالكنّ عنه

13
00:02:44,890 --> 00:02:45,900
ما الأمر؟

14
00:02:45,900 --> 00:02:48,150
.من النّادر أن تسألينا عن شيء يا أكيرا

15
00:02:48,150 --> 00:02:49,360
!هذا صحيح

16
00:02:49,690 --> 00:02:52,440
!هيّا، تفضّلي بالسّؤال

17
00:02:53,570 --> 00:02:55,740
إذًا ما الأمر؟

18
00:02:57,870 --> 00:03:00,410
.في الواقع، انسين الأمر

19
00:03:00,410 --> 00:03:01,490
ماذا؟

20
00:03:01,490 --> 00:03:02,580
!لماذا؟

21
00:03:02,870 --> 00:03:05,580
.تبدين مكتئبةً مؤخّرًا يا أكيرا-تان

22
00:03:05,580 --> 00:03:06,580
.إنّها محقّة

23
00:03:06,580 --> 00:03:09,040
أيشغل بالكِ شيء؟

24
00:03:09,040 --> 00:03:12,260
.رغم أنّ إصابة ساقها تتماثل للشفاء

25
00:03:12,260 --> 00:03:13,880
.معكِ حقّ

26
00:03:17,300 --> 00:03:18,510
أتودّين أن نعرج عليه في طريق عودتنا؟

27
00:03:18,510 --> 00:03:19,510
.أكيد

28
00:03:31,230 --> 00:03:32,400
.تاتشيبانا-سينباي

29
00:03:32,400 --> 00:03:34,740
.كما توقّعت. لم أركِ منذ وقتٍ طويل

30
00:03:34,740 --> 00:03:36,490
!لقد فاجأتني

31
00:03:36,490 --> 00:03:37,950
هل أنتِ عائدةٌ إلى المنزل؟

32
00:03:37,950 --> 00:03:38,360
.نعم

33
00:03:38,660 --> 00:03:39,450
ما الأمر؟

34
00:03:39,450 --> 00:03:44,330
.في الواقع، يبدو أنّي سأشارك في البطولة القادمة

35
00:03:44,620 --> 00:03:46,210
!هذا رائع

36
00:03:51,000 --> 00:03:54,300
.حسنٌ، أشعر أنّ أدائي قد يكون مخيّبًا

37
00:03:55,210 --> 00:03:56,470
.آسفة

38
00:03:57,010 --> 00:03:58,220
!صحيح

39
00:03:58,220 --> 00:04:00,010
!أيمكنكِ المجيء معي لبعض الوقت؟

40
00:04:00,010 --> 00:04:02,890
!سيسعد الجميع برؤيتكِ، كما أنّنا نحتاج لنُصحكِ

41
00:04:02,890 --> 00:04:03,560
!أرجوكِ

42
00:04:13,070 --> 00:04:15,070
!كيان-سينباي

43
00:04:18,150 --> 00:04:19,240
أكيرا؟

44
00:04:19,240 --> 00:04:21,490
.صادفتها في طريقي فجلبتها معي

45
00:04:21,490 --> 00:04:21,870
ماذا؟

46
00:04:25,870 --> 00:04:26,540
.مرحبًا

47
00:05:16,920 --> 00:05:19,090
!أحسنتِ يا إيشي

48
00:05:19,090 --> 00:05:20,680
!حقًا؟

49
00:05:20,680 --> 00:05:22,090
!مرحى

50
00:05:24,680 --> 00:05:27,770
.كان ذلك مذهلًا

51
00:05:31,560 --> 00:05:32,440
أكيرا؟

52
00:05:35,650 --> 00:05:37,690
ماذا؟ ستغادرين بهذه السّرعة؟

53
00:05:37,690 --> 00:05:38,360
.نعم

54
00:05:38,730 --> 00:05:40,950
.سنذهب جميعًا إلى مطعمٍ عائليّ بعد التّدريب

55
00:05:40,950 --> 00:05:42,200
أتودّين مرافقتنا؟

56
00:05:42,950 --> 00:05:44,320
.لا، أعتذر

57
00:05:44,320 --> 00:05:46,910
!ماذا؟ تعالي معنا يا سينباي

58
00:05:46,910 --> 00:05:48,240
!هذا صحيح

59
00:05:48,240 --> 00:05:49,500
!رافقينا

60
00:05:49,500 --> 00:05:53,790
بالتّفكير في الأمر، أنتِ تعملين بدوامٍ جزئيّ في مطعمٍ عائليّ، صحيح؟

61
00:05:53,790 --> 00:05:55,000
!ماذا؟ أهذا صحيح؟

62
00:05:55,000 --> 00:05:55,710
!أحقًا يا سينباي؟

63
00:05:56,290 --> 00:05:58,420
ما ردّ الفعل هذا؟

64
00:05:59,170 --> 00:06:03,510
!هذا لأنّي لا أتصوّر أنّ فتاةً هادئةً وفظّةً مثلكِ ستعمل كنادلة

65
00:06:03,510 --> 00:06:05,340
.لا أصدّق ذلك أيضًا

66
00:06:05,340 --> 00:06:07,430
...أنا هنا لعلمكنّ

67
00:06:07,430 --> 00:06:09,890
إذًا ما رأيكنّ بالذّهاب إلى هناك اليوم؟

68
00:06:09,890 --> 00:06:11,520
!فكرةٌ رائعة

69
00:06:13,020 --> 00:06:15,810
—أين يقع ذلك المطعم العائليّ يا تاتشيبانا-سينباي

70
00:06:14,730 --> 00:06:15,810
.لا

71
00:06:16,190 --> 00:06:17,230
.لا تأتينّ

72
00:06:20,440 --> 00:06:22,360
.آسفة

73
00:06:22,360 --> 00:06:24,320
...أقصد أنّه بعيد

74
00:06:25,280 --> 00:06:25,700
.بالإذن

75
00:06:53,890 --> 00:06:55,940
.إنّكِ سريعةٌ حقًا يا تاتشيبانا

76
00:06:55,940 --> 00:06:57,690
.لعلّكِ قادرةٌ على منافسة الأولاد

77
00:06:57,690 --> 00:07:00,610
.قال الأستاذ إنّ بإمكاننا استخدام مسدّس الصّوت

78
00:07:00,610 --> 00:07:02,070
.لدينا خمس طلقات

79
00:07:02,070 --> 00:07:04,650
ماذا؟ ما خطب ساقكِ يا أكيرا؟

80
00:07:04,650 --> 00:07:07,910
.قمتُ بتضميدها فقط لأنّها لا تشعرني بالرّاحة

81
00:07:07,910 --> 00:07:09,280
هل أنتِ بخير؟

82
00:07:09,280 --> 00:07:12,290
.أنتِ نجمة فريق المضمار والميدان الصّاعدة

83
00:07:12,290 --> 00:07:13,750
.لِذا لا تتحاملي على نفسكِ

84
00:07:14,370 --> 00:07:15,160
.حسنًا

85
00:07:33,850 --> 00:07:35,520
!استعداد

86
00:07:35,520 --> 00:07:36,770
!تأهّب

87
00:08:42,290 --> 00:08:44,550
.واثقٌ أنّ المطر سينجلي قريبًا

88
00:09:10,450 --> 00:09:12,570
.ماذا؟ إنّها تمطر

89
00:09:28,260 --> 00:09:30,260
ماذا؟ تاتشيبانا-سان؟

90
00:09:32,300 --> 00:09:33,970
ما الخطب؟

91
00:09:33,970 --> 00:09:35,550
هل تعافت ساقكِ الآن؟

92
00:09:37,100 --> 00:09:39,060
.على كلٍّ، يجب أن تدخلي

93
00:09:39,060 --> 00:09:40,770
!إنّكِ مبتلّةٌ بالكامل

94
00:09:43,060 --> 00:09:44,400
!هيّا، أسرعي

95
00:10:00,160 --> 00:10:01,160
تاتشيبانا-سان؟

96
00:10:09,800 --> 00:10:11,590
.إنّي واقعةٌ في حبّك

97
00:10:55,550 --> 00:10:57,550
.إنّها تمطر بغزارة

98
00:11:00,010 --> 00:11:01,930
.إنّي واقعةٌ في حبّك

99
00:11:23,250 --> 00:11:28,330
،كان ضائعًا في التّفكير بكيفية كسب قوت يومه غدًا

100
00:11:29,210 --> 00:11:32,590
.أفكارٌ بائسة وغير مترابطة تعترض على مصيرٍ محتوم

101
00:11:32,920 --> 00:11:38,840
.هائمًا كان ينصت لصوت وقع المطر في شارع سوزاكو

102
00:11:58,410 --> 00:12:00,820
.ستعود تاتشيبانا-سان إلى العمل اليوم

103
00:12:03,660 --> 00:12:05,960
بأيّ وجهٍ سأقابلها؟

104
00:12:06,960 --> 00:12:08,330
.بوركت جهودك

105
00:12:08,330 --> 00:12:10,040
.بوركت جهودكِ

106
00:12:12,630 --> 00:12:13,550
ماذا؟

107
00:12:13,550 --> 00:12:14,880
تاتشيبانا-سان؟

108
00:12:14,880 --> 00:12:17,420
!تهانينا على تعافيكِ يا أكيرا-تشان

109
00:12:17,420 --> 00:12:18,630
.شكرًا

110
00:12:18,630 --> 00:12:20,470
.لا تتحاملي على نفسكِ

111
00:12:20,470 --> 00:12:22,220
.أعتذر على إقلاقكم

112
00:12:22,220 --> 00:12:23,260
!تاتشيبانا

113
00:12:23,260 --> 00:12:25,020
!أعلميني إن كان بوسعي فعل شيءٍ لأجلكِ

114
00:12:25,020 --> 00:12:26,060
.ما من شيءٍ تستطيع فعله

115
00:12:26,060 --> 00:12:27,100
!خسارة

116
00:12:28,310 --> 00:12:29,770
.تبدو على طبيعتها المعتادة

117
00:12:31,310 --> 00:12:33,230
أكان ذلك حلمًا؟

118
00:12:35,360 --> 00:12:37,440
.يا لخيبة الأمل

119
00:12:37,780 --> 00:12:41,620
.أنا محبطٌ لأنّ الأمر يبدو كما لو أنّ شيئًا لم يكن

120
00:12:41,620 --> 00:12:44,740
.لا يعقل أن يكون ذلك حلمًا

121
00:12:45,290 --> 00:12:46,910
!فهمت

122
00:12:46,910 --> 00:12:49,460
أيعقل أن يكون مقلبًا؟

123
00:12:50,000 --> 00:12:53,840
.لعلّ يوشيزاوا-كُن كان يصوّر بينما كانت تعترف لي

124
00:12:55,630 --> 00:12:57,510
.إنّي واقعةٌ في حبّك

125
00:13:00,380 --> 00:13:01,430
!انظروا إلى هذا

126
00:13:01,430 --> 00:13:02,760
.لا أصدّق أنّ الأمر انطلى على ذلك الكهل

127
00:13:02,760 --> 00:13:03,930
!يا له من غريب أطوار

128
00:13:03,930 --> 00:13:04,890
!هذا مضحك

129
00:13:04,890 --> 00:13:06,810
!دعونا ننشره على الإنترنت

130
00:13:11,520 --> 00:13:14,480
.كان ذلك وشيكًا

131
00:13:14,480 --> 00:13:18,110
.لا شكّ أنّ هذا ما في الأمر. من المنطقيّ التّفكير في ذلك

132
00:13:18,110 --> 00:13:20,740
...وإلّا لماذا قد تغرم فتاةٌ في الـ17 من عمرها بكهلٍ مثلي

133
00:13:22,530 --> 00:13:24,120
.هذا صحيح

134
00:13:24,120 --> 00:13:26,540
.يستحيل أن تحبّ كهلًا مثلي

135
00:13:31,580 --> 00:13:35,540
.مع ذلك، يا له من فعلٍ شنيع

136
00:13:35,540 --> 00:13:37,420
...بالله عليكم

137
00:13:45,430 --> 00:13:46,140
.أيّها المدير

138
00:13:46,140 --> 00:13:48,810
.إنّه شنيعٌ بالفعل

139
00:13:49,640 --> 00:13:52,350
.يا إلهي... ربّما سأذهب لتدخين سيجارة

140
00:13:49,980 --> 00:13:50,680
—أيّها المـ

141
00:13:57,150 --> 00:13:57,940
.أيّها المدير

142
00:14:00,900 --> 00:14:04,410
...المعذرة، بشأن حلوى فاصولياء الأزوكي الّتي أهديتها لنا

143
00:14:04,820 --> 00:14:07,830
.أرادت أمّي أن تشكرك عليها

144
00:14:09,620 --> 00:14:12,960
!أتلقّى هذه المعاملة القاسية علاوةً على المقلب المدبّر؟

145
00:14:10,000 --> 00:14:13,830
.كانت لذيذة جدًا

146
00:14:12,960 --> 00:14:15,330
!ماذا فعلت لأستحقّ هذا؟

147
00:14:15,330 --> 00:14:18,340
.رغم أنّي كهل في الـ45، إلّا أنّ الدّموع تغلبني

148
00:14:18,340 --> 00:14:22,470
.أعلم أنّي حثالةٌ بنظر فتاةٍ في الـ17، لكن هذا ليس مسوّغًا لذلك

149
00:14:22,470 --> 00:14:23,430
أيّها المدير؟

150
00:14:23,430 --> 00:14:26,180
!حلوى فاصولياء الأزوكي

151
00:14:26,180 --> 00:14:27,140
أكانت لذيذة؟

152
00:14:26,600 --> 00:14:30,270
.وأيضًا، كنتُ جادّةً فيما قلته حينئذٍ

153
00:14:27,140 --> 00:14:29,310
.يسرّني سماع ذلك

154
00:14:29,310 --> 00:14:32,350
.أخبري أمّكِ أنّ هذا من دواعي سروري

155
00:14:30,270 --> 00:14:32,350
.إنّي واقعةٌ في حبّك

156
00:14:32,350 --> 00:14:34,190
ما شعورك نحوي؟

157
00:14:35,270 --> 00:14:37,060
.أودّ سماع جوابك

158
00:14:41,070 --> 00:14:43,200
!بوركت جهودكما

159
00:14:44,570 --> 00:14:47,830
أخبريني يا أكيرا-تشان! أتودّين الذّهاب معنا إلى الكاريوكي بعد انتهاء العمل؟

160
00:14:47,830 --> 00:14:50,620
فنحن لم نقِم بعد حفلة ترحيبٍ ليوشيزاوا-كُن، أليس كذلك؟

161
00:14:50,950 --> 00:14:54,330
.فكرةٌ رائعة. يجب عليكم الذّهاب جميعًا أنتم اليافعون

162
00:14:54,330 --> 00:14:55,420
.لن أذهب

163
00:14:55,420 --> 00:14:56,830
.كما أنّي لا أحبّ الكاريوكي أساسًا

164
00:14:59,130 --> 00:15:01,670
هل أنتِ غاضبةٌ حيال شيءٍ يا أكيرا-تشان؟

165
00:15:02,550 --> 00:15:04,010
.لا، لست كذلك

166
00:15:04,010 --> 00:15:10,220
.ساقي لم تتعافَ بعد، ويبدو أنّي مصابةٌ بالزّكام والحمى كذلك

167
00:15:10,220 --> 00:15:11,390
.آسفة

168
00:15:11,390 --> 00:15:12,930
.فهمت

169
00:15:12,930 --> 00:15:14,770
.إذًا في المرّة القادمة

170
00:15:14,770 --> 00:15:15,310
.أجل

171
00:15:15,310 --> 00:15:18,810
.هذا مؤسفٌ يا يوشيزاوا-كُن، لا تستطيع أكيرا-تشان مرافقتنا

172
00:15:20,730 --> 00:15:26,320
.يبدو أنّه لم يكن حلمًا ولا مقلبًا

173
00:15:31,910 --> 00:15:34,660
.سأقلّكِ إلى محطّة القطار يا تاتشيبانا-سان

174
00:15:34,660 --> 00:15:35,500
ماذا؟

175
00:15:35,500 --> 00:15:37,670
ساقكِ لم تتعافَ بالكامل، صحيح؟

176
00:15:37,670 --> 00:15:39,460
.ستكون مشكلةً إن عاودكِ الألم

177
00:15:41,170 --> 00:15:44,720
.كما أنّ علينا مواصلة حديثنا السّابق

178
00:15:49,470 --> 00:15:53,020
ستتوجّهين صوب يوكوهاما، صحيح؟

179
00:15:53,020 --> 00:15:56,100
هل نذهب إلى هييوشي بما أنّ القطار السّريع يتوقّف هناك؟

180
00:15:57,770 --> 00:15:58,560
.نعم

181
00:16:00,400 --> 00:16:01,940
.هيّا بنا إذًا

182
00:16:21,880 --> 00:16:25,170
...بشأن حديثنا السّابق

183
00:16:30,470 --> 00:16:32,890
.لا أستطيع منحكِ جوابًا

184
00:16:35,350 --> 00:16:37,100
لِم لا؟

185
00:16:37,100 --> 00:16:38,890
لِم لا"؟"

186
00:16:40,520 --> 00:16:42,060
ألا تستوعبين الأمر؟

187
00:16:43,150 --> 00:16:44,020
.لا

188
00:16:47,070 --> 00:16:49,910
.أنا في الـ45 يا تاتشيبانا-سان

189
00:16:49,910 --> 00:16:51,660
ماذا سيخال الآخرون؟

190
00:16:51,660 --> 00:16:54,450
.لا يهمّ ما يخاله الآخرون

191
00:16:54,450 --> 00:16:56,750
...بلى

192
00:16:57,370 --> 00:16:58,960
.أنا كبيرٌ بما يكفي لأكون أباكِ

193
00:16:58,960 --> 00:17:00,460
!لكنّك لست أبي

194
00:17:00,460 --> 00:17:02,040
.قد يظنّ الآخرون أنّها مواعدة مدفوعة الأجر

195
00:17:02,040 --> 00:17:03,630
!لكنّها ليست كذلك

196
00:17:03,960 --> 00:17:04,840
...لكن

197
00:17:04,840 --> 00:17:07,420
!إنّي واقعةٌ في حبّك أيّها المدير

198
00:17:07,420 --> 00:17:09,880
!يا إلهي

199
00:17:15,430 --> 00:17:17,020
!يا للقرف

200
00:17:17,020 --> 00:17:17,390
ماذا؟

201
00:17:27,360 --> 00:17:30,860
ما رأيكِ أن نذهب لاستنشاق بعض الهواء المنعش؟

202
00:17:50,550 --> 00:17:52,090
.لن نبتلّ هنا

203
00:17:52,680 --> 00:17:54,140
.حسنًا

204
00:17:54,140 --> 00:17:56,600
.يبدو أنّها قادرةٌ على الهرولة

205
00:18:15,660 --> 00:18:18,120
لماذا قد تغرمين بي أساسًا؟

206
00:18:22,710 --> 00:18:26,340
ألا بدّ من وجود سببٍ لحبّ شخصٍ ما؟

207
00:18:27,290 --> 00:18:30,420
،لا أظنّ أنّكِ تحتاجين سببًا لحبّ شخصٍ يقربكِ في العمر

208
00:18:31,670 --> 00:18:35,590
.لكن أظنّ أنّ ثمّة حاجةٌ لسببٍ بيني وبينك

209
00:18:40,220 --> 00:18:41,640
.أحبّك فحسب

210
00:18:43,060 --> 00:18:46,980
.إنّي أحبّك أيّها المدير

211
00:18:55,160 --> 00:18:57,820
.ملمس التّربة تحت حذائي

212
00:19:00,290 --> 00:19:02,750
.رائحة الأوراق المبتلّة

213
00:19:05,210 --> 00:19:07,750
.طوق قميصي الملتصق بي بسبب العرق

214
00:19:08,750 --> 00:19:09,670
...و

215
00:19:11,460 --> 00:19:15,510
.فتاةٌ في الـ17 من عمرها تقول إنّها مغرمةٌ بي

216
00:19:17,640 --> 00:19:20,890
متى كانت آخر مرّةٍ خالجتني هذه الأمور؟

217
00:19:25,730 --> 00:19:27,310
.إنّها قوقعة زيز

218
00:19:31,730 --> 00:19:32,730
.أنتِ محقّة

219
00:19:37,530 --> 00:19:39,830
كيف حال يوتو-كُن؟

220
00:19:49,000 --> 00:19:50,210
.تاتشيبانا-سان

221
00:19:50,880 --> 00:19:53,420
.عليكِ إعادة التّفكير في هذا

222
00:19:55,550 --> 00:19:59,220
.أنا في الـ45 من العمر، بلا أحلامٍ أو طموحات

223
00:20:00,300 --> 00:20:02,560
.أنا صبيّ أجوف في منتصف العمر

224
00:20:12,690 --> 00:20:13,900
ماذا؟

225
00:20:13,900 --> 00:20:15,650
لماذا ترمقينني بهذه النّظرة؟

226
00:20:17,240 --> 00:20:18,700
صبيّ"؟"

227
00:20:21,580 --> 00:20:23,240
.قلت عن نفسك صبيّ

228
00:20:23,240 --> 00:20:27,160
.أنت تتكلّم عادةً برسميّة وليس كصبيّ

229
00:20:32,380 --> 00:20:35,170
.إنّكِ لا تستوعبين شيئًا يا تاتشيبانا-سان

230
00:20:35,170 --> 00:20:36,880
.لا تستوعبين شيئًا

231
00:20:37,510 --> 00:20:40,340
.جرّبي الخروج معي في موعد

232
00:20:40,340 --> 00:20:41,510
.واثقٌ أنّكِ ستفزعين

233
00:20:41,800 --> 00:20:43,310
!ستخرج معي في موعد؟

234
00:20:43,310 --> 00:20:46,770
...نعم، في موعد

235
00:20:46,770 --> 00:20:47,430
ماذا؟

236
00:20:47,430 --> 00:20:50,810
قلت للتّو إنّ عليّ الخروج معك في موعد، صحيح؟

237
00:20:50,810 --> 00:20:54,980
...ماذا؟ حسنٌ، ما قصدته

238
00:20:54,980 --> 00:20:56,440
قلت ذلك، أليس كذلك؟

239
00:21:03,280 --> 00:21:10,080
.أقوالي العرضيّة أسرت قلب أحدهم

240
00:21:11,750 --> 00:21:14,420
متى كانت آخر مرّةٍ خالجني هذا أيضًا؟

241
00:21:16,420 --> 00:21:17,710
.قلتها