1
00:00:33,430 --> 00:00:35,390
!سـ-ساخن

2
00:00:42,110 --> 00:00:43,690
...إذًا فقد حلّ الصّباح

3
00:02:22,580 --> 00:02:24,000
!أكيرا

4
00:02:25,460 --> 00:02:26,710
!صباح الخير

5
00:02:26,710 --> 00:02:27,790
.صباح الخير

6
00:02:27,790 --> 00:02:29,550
!جيوب أكيرا

7
00:02:29,550 --> 00:02:31,090
!إنّها دافئة

8
00:02:31,090 --> 00:02:33,130
!اصحبني معكِ هكذا

9
00:02:33,130 --> 00:02:34,680
!أرجوكِ

10
00:02:35,390 --> 00:02:36,840
تمّ إغلاق كلّ شيء؟

11
00:02:37,140 --> 00:02:38,300
.حسنًا، أراكنّ في تداريب بعد الظّهر

12
00:02:38,300 --> 00:02:39,510
!عن إذنكِ

13
00:02:45,730 --> 00:02:49,520
.تلك الفتاة كانت تعاني من نفس إصابتكِ قبل سنتين

14
00:02:50,820 --> 00:02:53,400
.ليتني ما قلت ذلك

15
00:02:55,610 --> 00:02:57,370
!لا جدوى من التّفكير في ذلك الآن

16
00:03:12,170 --> 00:03:15,300
!لا وجود لشيءٍ آخر أرغب بفعله

17
00:03:17,640 --> 00:03:18,970
هل من خطبٍ ما؟

18
00:03:18,970 --> 00:03:19,720
ماذا؟

19
00:03:19,720 --> 00:03:21,140
.لـ-لا شيء

20
00:03:21,140 --> 00:03:22,680
هل ستذهب إلى المكتب الرّئيسيّ اليوم أيضًا؟

21
00:03:22,680 --> 00:03:23,520
.نعم

22
00:03:23,520 --> 00:03:24,810
.رافقتك السّلامة

23
00:03:26,520 --> 00:03:27,600
.وقوف

24
00:03:28,400 --> 00:03:29,440
.انحناء

25
00:03:29,440 --> 00:03:34,030
.فكّروا في الأمر مليًا، واحرصوا على تسليمه في الوقت المحدّد

26
00:04:04,100 --> 00:04:05,480
استبيان وظيفيّ؟

27
00:04:05,480 --> 00:04:08,560
.طُلب منّا تسليم استبيانٍ عن طموحنا الوظيفيّ

28
00:04:08,560 --> 00:04:11,270
.مجرّد السّماع عن ذلك يصيبني بالفزع

29
00:04:11,270 --> 00:04:13,690
.أنا كذلك

30
00:04:13,690 --> 00:04:15,610
هل مدرستك جيّدة؟

31
00:04:15,610 --> 00:04:16,280
ماذا؟

32
00:04:16,280 --> 00:04:17,240
.أكاديميًا

33
00:04:19,450 --> 00:04:20,450
...عادية

34
00:04:20,450 --> 00:04:21,700
...نوعًا ما

35
00:04:21,700 --> 00:04:22,990
.إنّها متوسّطة المستوى

36
00:04:24,370 --> 00:04:25,660
.كوبو-سان

37
00:04:26,000 --> 00:04:28,660
.سأغادر الآن، لِذا تولّي المسؤولية

38
00:04:28,660 --> 00:04:29,250
.حسنًا

39
00:04:29,250 --> 00:04:30,750
.سأعود قبل حلول اللّيل

40
00:04:31,960 --> 00:04:33,590
...المعذرة

41
00:04:34,050 --> 00:04:35,710
.أنتِ أيضًا يا تاتسوبانا-سان

42
00:04:35,710 --> 00:04:37,090
.بئسًا... أسأت لفظ اسمها

43
00:04:37,090 --> 00:04:38,510
!أنا ذاهب

44
00:04:41,680 --> 00:04:42,180
.أجل

45
00:04:43,010 --> 00:04:45,520
.استلمت استبيان الطّموح الوظيفيّ أيضًا

46
00:04:45,520 --> 00:04:48,810
يجعلكِ تشعرين وكأنّ الوقت قد حان أخيرًا، صحيح؟

47
00:04:49,390 --> 00:04:52,860
هل ستلتحقين بمدرسة تجميلٍ يا يوي-تشان؟

48
00:04:52,860 --> 00:04:54,190
.نعم، هذا صحيح

49
00:04:54,190 --> 00:04:55,940
!نيشيدا-سان

50
00:04:56,400 --> 00:04:59,110
!سيسعدني إن أمكنكِ قصّ خصلات شعري مجدّدًا

51
00:04:59,400 --> 00:05:00,110
ماذا؟

52
00:05:00,110 --> 00:05:01,780
.حسنًا

53
00:05:01,780 --> 00:05:04,450
!سيكون من الرّائع إذا استطعتِ فعلها في استراحتنا المسائية

54
00:05:13,670 --> 00:05:15,210
.بربّك يا يوشيزاوا-كُن

55
00:05:21,090 --> 00:05:22,470
!أنا جدّي

56
00:05:22,470 --> 00:05:22,800
ماذا؟

57
00:05:23,220 --> 00:05:24,720
!إنّها الحقيقة

58
00:05:24,720 --> 00:05:25,760
.هكذا إذًا

59
00:05:26,220 --> 00:05:30,770
!لذلك يذهلني أنّكِ قرّرتِ ما تريدين فعله يا نيشيدا-سان

60
00:05:30,770 --> 00:05:32,850
أ-أتظنّ ذلك؟

61
00:05:32,850 --> 00:05:37,480
أما أنا فسأرتاد حاليًا الجامعة فقط
.وبعدها أفكّر في ما سأفعله

62
00:05:37,780 --> 00:05:39,940
متى اتّخذتِ قراركِ يا نيشيدا-سان؟

63
00:05:39,940 --> 00:05:40,700
ماذا؟

64
00:05:40,700 --> 00:05:43,740
ما الّذي جعلكِ ترغبين بأن تصيري مصفّفة شعر؟

65
00:05:43,740 --> 00:05:46,700
...حسنٌ، هذا

66
00:05:47,450 --> 00:05:53,170
.ظننت أنّه من الرّائع أن أُسعد أحدهم بفعل ما أحبّ

67
00:05:53,170 --> 00:05:54,920
.فهمت

68
00:05:54,920 --> 00:05:57,550
...الشّخص الّذي جعلني أدرك ذلك كان

69
00:06:00,670 --> 00:06:06,350
ذلك الشّخص كان سعيدًا للغاية
.عندما حلقت شعره لأوّل مرّة

70
00:06:06,350 --> 00:06:11,480
!لـ-لكن، لـ-لست واثقةً إن كان بإمكاني حقًا أن أغدو مصفّفة شعر

71
00:06:12,100 --> 00:06:13,480
!واثقٌ أنّكِ ستفعلين

72
00:06:16,230 --> 00:06:19,980
عندما تبدئين مسيرتكِ المهنية
.حتمًا سأكون أوّل زبائنكِ

73
00:06:20,780 --> 00:06:23,400
هل تعدينني بأن تقصّي شعري حينها؟

74
00:06:25,160 --> 00:06:25,870
.نعم

75
00:06:54,770 --> 00:06:56,020
!أهلًا وسهلًا

76
00:06:56,020 --> 00:06:57,440
كم عددكم؟

77
00:06:58,400 --> 00:07:00,610
!تفضّل. شكرًا لانتظارك

78
00:07:02,190 --> 00:07:02,990
ماذا؟

79
00:07:03,570 --> 00:07:05,780
تأخّر المدير في العودة، أليس كذلك؟

80
00:07:05,780 --> 00:07:06,610
ماذا؟

81
00:07:06,610 --> 00:07:09,740
.بالتّفكير في الأمر، أصبح يقصد المكتب الرّئيسيّ كثيرًا مؤخّرًا

82
00:07:09,740 --> 00:07:11,290
حقًا؟

83
00:07:11,290 --> 00:07:14,580
...حسب علمي، قد يكون هذا

84
00:07:14,580 --> 00:07:16,120
...أيعقل

85
00:07:16,120 --> 00:07:17,330
.محال

86
00:07:17,330 --> 00:07:18,540
!ما الأمر؟! ما الأمر؟

87
00:07:20,340 --> 00:07:21,420
!سيحصل على ترقية

88
00:07:21,420 --> 00:07:22,960
!حقًا؟

89
00:07:22,960 --> 00:07:24,470
.محال

90
00:07:24,470 --> 00:07:27,260
ولمَ عساه يذهب إلى المكتب الرّئيسي كلّ يوم؟

91
00:07:27,260 --> 00:07:28,550
!حقًا؟

92
00:07:28,550 --> 00:07:30,970
ماذا سيحدث إذا حصل على ترقية؟

93
00:07:30,970 --> 00:07:32,600
.سيُنقل إلى المكتب الرّئيسيّ

94
00:07:34,140 --> 00:07:37,520
.وسيعيّنون مديرًا جديدًا لهذا المكان

95
00:07:37,520 --> 00:07:41,570
،مديرٌ بدون شعرٍ مشعّث
.ولا يترك سحّاب سرواله مفتوحًا

96
00:07:41,570 --> 00:07:43,110
!حقًا؟

97
00:07:43,110 --> 00:07:44,150
!أنا جادّة

98
00:07:44,150 --> 00:07:45,530
.محال

99
00:07:45,530 --> 00:07:47,320
.يستحيل حدوث ذلك

100
00:08:10,140 --> 00:08:12,100
!سـ-ساخن

101
00:08:15,890 --> 00:08:17,310
،يبدو أنّها قد تمطر

102
00:08:17,310 --> 00:08:18,850
.لكن دعونا نخرج الحواجز

103
00:08:18,850 --> 00:08:19,690
!حسنًا

104
00:08:26,280 --> 00:08:27,950
!إنّه واسع

105
00:08:28,820 --> 00:08:30,610
!الجوّ بارد

106
00:08:32,070 --> 00:08:33,280
!الرياح عاتية

107
00:08:35,580 --> 00:08:38,710
!السّاحة تبدو وكأنّها تطفو في السّماء

108
00:08:41,000 --> 00:08:42,250
.يعجبني اسمها

109
00:08:42,880 --> 00:08:44,960
.ثانوية حيث ترى الرياح

110
00:08:45,250 --> 00:08:46,550
.أريد القدوم إلى هنا

111
00:08:46,550 --> 00:08:48,420
.أنا كذلك قرّرت الالتحاق بهذه المدرسة

112
00:08:49,010 --> 00:08:51,260
!فلنسعَ معًا خلف الرياح هنا

113
00:08:51,260 --> 00:08:52,140
!أجل

114
00:08:57,640 --> 00:08:59,310
...معًا في هذا المكان

115
00:09:14,490 --> 00:09:17,750
ما سبب تلك الضّمادة على وجهك يا يوتو-كُن؟

116
00:09:17,750 --> 00:09:19,910
.سقطت خلال حصة التربية البدنية

117
00:09:19,910 --> 00:09:21,170
ماذا كنت تفعل؟

118
00:09:21,170 --> 00:09:22,210
.العدو

119
00:09:23,040 --> 00:09:24,290
...العدو

120
00:09:28,880 --> 00:09:29,590
هل أنتِ سريعة؟

121
00:09:29,970 --> 00:09:30,550
ماذا؟

122
00:09:30,550 --> 00:09:31,430
.في العدو

123
00:09:32,890 --> 00:09:35,760
.أجل. نوعًا ما

124
00:09:35,760 --> 00:09:40,100
.أتساءل كيف يمكنني أن أصبح أسرع في العدو

125
00:09:44,310 --> 00:09:45,060
!علّميني

126
00:09:45,400 --> 00:09:45,980
ماذا؟

127
00:09:50,650 --> 00:09:51,360
.موافقة

128
00:09:51,360 --> 00:09:52,530
!مرحى

129
00:10:01,410 --> 00:10:02,830
.استمرّ على هذا النّحو

130
00:10:08,460 --> 00:10:09,670
هل أنت بخير؟

131
00:10:09,670 --> 00:10:11,090
.على خير ما يرام

132
00:10:11,760 --> 00:10:13,430
أتريد أن تأخذ استراحةً قصيرة؟

133
00:10:13,430 --> 00:10:14,430
!لا

134
00:10:14,430 --> 00:10:16,350
!لم أعبر خطّ النّهاية بعد

135
00:10:16,350 --> 00:10:17,050
خطّ النهاية؟

136
00:10:17,640 --> 00:10:20,890
حتّى إن سقطت وحللت في المركز الأخير
!سأعدو إلى أن أصل خطّ النهاية

137
00:10:21,810 --> 00:10:23,640
.لا يفترض بي أن أستسلم

138
00:10:25,190 --> 00:10:26,610
.لا تستسلم

139
00:10:26,610 --> 00:10:27,230
!أجل

140
00:10:27,650 --> 00:10:31,190
.لا يهمّ إن سقطت ما دمت أنهض وأركض

141
00:10:31,650 --> 00:10:34,910
.ما دمت لا أستسلم وأواصل العدو

142
00:10:35,570 --> 00:10:38,280
.لا بدّ لي من عبور خطّ النّهاية

143
00:10:38,280 --> 00:10:40,370
.وإلّا عنى ذلك أنّي لم أعدو أساسًا

144
00:10:41,750 --> 00:10:44,210
.هذا ما قاله أبي

145
00:10:44,620 --> 00:10:47,630
.قال أنّه سيعمل بجدٍّ أيضًا

146
00:10:47,630 --> 00:10:49,090
!قال أنّه لن يستسلم

147
00:10:55,130 --> 00:11:00,060
لذلك وعدت أبي أنّي سأعدو إلى خطّ النّهاية
.حتّى لو حللت في المركز الأخير

148
00:11:01,020 --> 00:11:02,600
!لكنّي أريد أن أحلّ في المركز الأوّل

149
00:11:04,060 --> 00:11:05,020
.فهمت

150
00:11:08,520 --> 00:11:10,770
.أرجح ذراعيك بأقصى ما تستطيع

151
00:11:10,770 --> 00:11:13,030
!سيساعدك ذلك على تحريك ساقيك أسرع

152
00:11:13,900 --> 00:11:15,240
هكذا؟

153
00:11:36,930 --> 00:11:38,260
.بوركت جهودكِ

154
00:11:38,840 --> 00:11:39,970
.بوركت جهودك

155
00:11:40,760 --> 00:11:43,310
.إنّها تمطر قليلًا في الخارج

156
00:11:43,310 --> 00:11:44,230
.حسنًا

157
00:11:44,230 --> 00:11:49,100
.سمعت أنّكِ علّمتِ يوتو كيف يعدو اليوم

158
00:11:49,100 --> 00:11:50,150
.نعم

159
00:11:50,480 --> 00:11:51,770
.ممتنٌّ لكِ

160
00:11:51,770 --> 00:11:56,320
كان متحمّسًا جدًا وكان يتحدّث عن ذلك
.طوال الوقت عندما أوصلته إلى المنزل

161
00:11:56,320 --> 00:11:59,070
،قال أنّه سيتدرّب كلّ يوم

162
00:11:59,070 --> 00:12:01,280
.لكن لستُ متأكّدًا من استمراره

163
00:12:01,280 --> 00:12:04,200
.إنّه يتخلّى في الغالب عن كلّ شيءٍ في منتصفه

164
00:12:04,200 --> 00:12:05,870
.أعتقد أنّه سيكون على ما يرام

165
00:12:06,540 --> 00:12:07,000
ماذا؟

166
00:12:07,500 --> 00:12:09,630
،يوتو-كُن سريع التعلّم

167
00:12:09,630 --> 00:12:13,170
،وحالما يتعلّم أساسيات العدو السّليم
.سيتمكّن حتمًا من العدو أسرع بكثير

168
00:12:14,000 --> 00:12:16,550
.سيعدو حتّى يعبر خطّ النّهاية

169
00:12:16,550 --> 00:12:18,630
كان هذا وعده لك، صحيح؟

170
00:12:21,850 --> 00:12:23,140
...الوعد

171
00:12:23,140 --> 00:12:24,350
.نعم

172
00:12:28,270 --> 00:12:31,520
...ربّما لم يجدر بي قول أنّه وعد، لكن

173
00:12:32,610 --> 00:12:35,110
.قطعت وعدًا على نفسي إلى جانب يوتو

174
00:12:36,190 --> 00:12:38,150
.قطعت وعدًا من جديد

175
00:12:38,860 --> 00:12:41,410
.وعدٌ كنت قد أهملته

176
00:12:44,870 --> 00:12:47,410
عن كتابة الرّوايات؟

177
00:12:47,660 --> 00:12:48,410
.نعم

178
00:12:49,040 --> 00:12:50,000
.كنت أكتب

179
00:12:50,670 --> 00:12:54,380
.رغم أنّ الأمر لم يمضِ كما تصّورته بتاتًا

180
00:12:55,250 --> 00:12:58,090
.لكنّني أستمتع بوقتي كثيرًا

181
00:13:01,140 --> 00:13:04,810
.أضفت وعدًا على وعدٍ لا أستطيع الوفاء به

182
00:13:05,470 --> 00:13:10,020
.قاسيت من ذلك الوعد، وتعلّمت منه أيضًا

183
00:13:10,810 --> 00:13:16,780
الوعد الوحيد الّذي قطعته على نفسي
.كان أن أسخّر حياتي للأدب

184
00:13:17,740 --> 00:13:19,950
.أريد أن أفي بذلك على الأقل

185
00:13:26,740 --> 00:13:28,580
!تاتشيبانا-سان

186
00:13:30,040 --> 00:13:30,710
.تفضّلي

187
00:13:31,210 --> 00:13:33,670
.جدول أوقات العمل. أعتذر على تأخّري في إنهائه

188
00:13:35,170 --> 00:13:38,550
...جدولت مواعيد عملكِ كما طلبتِ، لكن

189
00:13:39,170 --> 00:13:40,340
...حسنٌ

190
00:13:44,720 --> 00:13:46,470
.شكرًا جزيلًا لك

191
00:13:47,850 --> 00:13:49,020
.عن إذنك

192
00:13:51,480 --> 00:13:53,310
،ربّما

193
00:13:55,310 --> 00:13:57,820
.تملكين ذلك أيضًا يا تاتشيبانا-سان

194
00:13:57,820 --> 00:14:00,570
.وعدٌ قطعتِه على نفسكِ ونسيته

195
00:14:20,300 --> 00:14:22,220
—ثانوية حيث يمكنكِ رؤية الرياح

196
00:14:23,800 --> 00:14:25,390
.انتظري يا هاروكا

197
00:14:27,810 --> 00:14:28,970
أكيرا؟

198
00:14:30,140 --> 00:14:31,680
.أنتِ جاهزةٌ الآن

199
00:14:31,680 --> 00:14:33,310
!شكرًا

200
00:14:39,270 --> 00:14:41,280
.ربّما تملكين ذلك أيضًا يا تاتشيبانا-سان

201
00:14:41,860 --> 00:14:44,490
.وعدٌ قطعته على نفسكِ ونسيته

202
00:15:11,390 --> 00:15:17,440
.حسنٌ، لديّ إعلانٌ بالغ الأهمية أخبركم به اليوم

203
00:15:18,480 --> 00:15:19,520
.أخيرًا

204
00:15:19,520 --> 00:15:21,820
!حانت لحظة الحقيقة

205
00:15:21,820 --> 00:15:23,490
حقًا؟

206
00:15:23,490 --> 00:15:26,570
أحقًا سيحصل المدير على ترقية؟

207
00:15:26,570 --> 00:15:28,070
.يستحيل ذلك

208
00:15:28,070 --> 00:15:29,030
.أشاطرك الرّأي

209
00:15:29,030 --> 00:15:30,410
،كما يعلم الجميع

210
00:15:30,830 --> 00:15:36,040
كنت أتلقّى مؤخرًا محاضراتٍ صارمة
،في المكتب الرّئيسيّ كلّ يومٍ تقريبًا

211
00:15:36,040 --> 00:15:38,040
.وقد اجتزت اختبارًا

212
00:15:39,210 --> 00:15:40,710
،ونتيجةً لذلك

213
00:15:42,380 --> 00:15:44,300
.يجب أن أعيد الاختبار

214
00:15:44,630 --> 00:15:45,840
ماذا؟

215
00:15:45,840 --> 00:15:48,300
!ألم يكن اختبار ترقية؟

216
00:15:48,300 --> 00:15:49,890
ماذا؟ ما قصدكِ؟

217
00:15:49,890 --> 00:15:51,930
!لا، لم يكن كذلك

218
00:15:51,930 --> 00:15:53,770
.كان عن هذه القائمة الجديدة

219
00:15:54,730 --> 00:15:55,600
.هذا

220
00:15:55,600 --> 00:15:57,730
.ألقوا نظرةً على هذا

221
00:15:57,730 --> 00:15:59,100
...هذه الأعين

222
00:15:59,100 --> 00:16:02,570
.هذا الجزء صعبٌ جدًا. أنا جادّ

223
00:16:03,860 --> 00:16:08,450
.لذلك سنكون الفرع الوحيد الّذي لن يطرح القائمة الجديدة مؤقتًا

224
00:16:08,450 --> 00:16:09,110
.أنا آسف

225
00:16:09,620 --> 00:16:12,080
!اعتذارك يجب أن يوجّه للزّبائن

226
00:16:12,700 --> 00:16:14,160
.معكِ حقّ

227
00:16:15,870 --> 00:16:18,580
.أنا ذاهب اليوم أيضًا

228
00:16:19,830 --> 00:16:22,290
.صِدقًا

229
00:16:22,920 --> 00:16:24,380
...هذا الملف

230
00:16:38,390 --> 00:16:39,690
!أكيرا

231
00:16:39,690 --> 00:16:40,270
!انهضي

232
00:16:43,730 --> 00:16:44,940
!اركضي

233
00:16:44,940 --> 00:16:46,650
!أكيرا

234
00:17:02,000 --> 00:17:03,340
!لا تبكي

235
00:17:10,590 --> 00:17:12,180
.عليكِ أن تعودي

236
00:17:16,930 --> 00:17:18,810
!أنا متوتّرة

237
00:17:27,900 --> 00:17:29,490
!فلنسعَ معًا خلف الرياح هنا

238
00:17:29,490 --> 00:17:30,150
!أجل

239
00:17:31,320 --> 00:17:32,450
!إنّه وعد

240
00:17:40,330 --> 00:17:41,460
.ليس هنا

241
00:17:41,460 --> 00:17:43,580
.نسيته مجدّدًا

242
00:17:43,580 --> 00:17:44,710
!اذهب من فضلك

243
00:17:44,710 --> 00:17:45,590
.آسف

244
00:17:50,380 --> 00:17:51,430
!أيها المدير

245
00:17:53,640 --> 00:17:54,890
تاتشيبانا-سان؟

246
00:18:03,560 --> 00:18:04,900
.تفضّل أيّها المدير

247
00:18:04,900 --> 00:18:05,900
.صحيح

248
00:18:05,900 --> 00:18:07,650
.شكرًا، ممتنٌ لكِ

249
00:18:07,650 --> 00:18:08,610
.العفو

250
00:18:11,570 --> 00:18:12,530
هل أنتِ بخير؟

251
00:18:16,910 --> 00:18:18,490
.سينجلي المطر قريبًا

252
00:18:34,800 --> 00:18:35,800
—تاتشيبا

253
00:18:36,470 --> 00:18:38,390
!مرحبًا؟ نعم

254
00:18:38,390 --> 00:18:40,560
.ماذا؟ أعتذر

255
00:18:40,560 --> 00:18:42,390
.لك خالص اعتذاري

256
00:18:42,390 --> 00:18:43,270
.أجل

257
00:18:43,270 --> 00:18:45,440
...حـ-حسنٌ

258
00:18:45,440 --> 00:18:47,230
.لك خالص اعتذاري

259
00:18:51,150 --> 00:18:52,900
.أجل. فهمت

260
00:18:52,900 --> 00:18:54,490
...سأحرص على ذلك

261
00:18:54,490 --> 00:18:56,320
.أجل. معك حقّ

262
00:18:58,160 --> 00:18:59,910
.إلى اللّقاء

263
00:19:04,460 --> 00:19:05,420
!تاتشيبانا-سان

264
00:19:43,250 --> 00:19:43,870
...يومًا ما

265
00:19:46,540 --> 00:19:50,790
...عندما يفي كلّ منّا بوعوده

266
00:19:55,470 --> 00:19:58,840
.حتمًا سأعلمك فورًا

267
00:20:20,740 --> 00:20:22,370
!هيّا بنا

268
00:20:29,920 --> 00:20:30,960
...أكيرا

269
00:20:33,040 --> 00:20:35,010
!ثانوية كازا

270
00:20:35,590 --> 00:20:38,050
!إلى الأمام

271
00:20:41,550 --> 00:20:44,930
.لن أنسى

272
00:20:47,850 --> 00:20:49,190
،مهما انقضت السّنين

273
00:20:50,190 --> 00:20:51,730
،أينما كنت

274
00:20:54,360 --> 00:20:56,940
سأتذكّر الشّخص الّذي هداني إلى مستقبلي

275
00:21:02,200 --> 00:21:05,490
.كلّما نظرت إلى السّماء بعد المطر