1
00:00:13,320 --> 00:00:14,530
!واصلوا

2
00:00:57,990 --> 00:00:58,910
!تاتشيبانا

3
00:01:02,580 --> 00:01:03,620
!تاتشيبانا

4
00:01:04,580 --> 00:01:06,290
!صباح الخير

5
00:01:06,290 --> 00:01:07,880
.نحن في نهاية الدّوام

6
00:01:07,880 --> 00:01:11,300
...حسنٌ، بما أنّكِ كنتِ نائمةً طوال الوقت، فكّرت

7
00:01:11,300 --> 00:01:14,470
!حسنًا، كما تعلمين، إنّها لمصادفةٌ رائعة أن ألتقي بكِ هنا

8
00:01:14,470 --> 00:01:19,050
،لا أعلم، لعلّه القدر وربّما شيءٌ يدور بيننا

9
00:01:19,050 --> 00:01:21,890
لِذا ما رأيكِ أن ننتهز هذه الفرصة لتبادل
!معلومات وسائل التّواصل الاجتماعيّ؟

10
00:01:24,680 --> 00:01:25,440
ماذا؟

11
00:01:26,060 --> 00:01:27,060
تاتشيبانا؟

12
00:01:27,850 --> 00:01:29,020
!ماذا؟

13
00:01:46,210 --> 00:01:48,580
.يمكننا الآن استخدام الميدان، لِذا أخرجن الحواجز

14
00:01:48,580 --> 00:01:49,330
!حسنًا

15
00:02:03,890 --> 00:02:05,350
!ثانوية كازا

16
00:02:05,810 --> 00:02:07,310
!إلى الأمام

17
00:02:19,610 --> 00:02:21,030
!ثانوية كازا

18
00:02:21,030 --> 00:02:24,240
!إلى الأمام! إلى الأمام! إلى الأمام

19
00:02:24,240 --> 00:02:25,750
!ثانوية كازا

20
00:02:25,750 --> 00:02:29,080
!إلى الأمام! إلى الأمام! إلى الأمام

21
00:02:29,080 --> 00:02:30,080
!ثانوية كازا

22
00:04:28,660 --> 00:04:31,120
!أطباق الطّاولة الثّالثة جاهزة

23
00:04:37,380 --> 00:04:38,460
.سأمرّ

24
00:04:48,140 --> 00:04:50,770
أهلًا وسهلًا. طاولةٌ لشخصين؟

25
00:04:52,060 --> 00:04:54,850
من منكما طلب بارفّيه الفراولة؟

26
00:04:56,600 --> 00:04:57,980
.أنا

27
00:04:57,980 --> 00:04:58,900
.في الواقع، لست أنا

28
00:04:58,900 --> 00:05:00,270
.إنّه طلبي

29
00:05:00,270 --> 00:05:01,900
.شكرًا على انتظارك

30
00:05:04,570 --> 00:05:06,070
.بالهناء والشّفاء

31
00:05:06,610 --> 00:05:07,820
.شكرًا

32
00:05:09,780 --> 00:05:11,410
أتصدّقن ذلك؟

33
00:05:21,130 --> 00:05:23,510
...ليس أمرًا مهمًا، لكن

34
00:05:23,510 --> 00:05:25,550
.لك خالص اعتذاري

35
00:05:26,010 --> 00:05:27,760
.سأحضر لك طبقًا آخر في الحال

36
00:05:30,260 --> 00:05:32,180
.يا له من مثيرٍ للشّفقة

37
00:05:33,560 --> 00:05:36,060
.إنّه مثيرٌ للشّفقة بحقّ

38
00:05:36,060 --> 00:05:36,980
عفوًا؟

39
00:05:36,980 --> 00:05:38,150
!المدير

40
00:05:38,440 --> 00:05:40,690
.إنّه يحني رأسه دائمًا متذلّلًا للزّبائن

41
00:05:42,940 --> 00:05:46,030
لكن ماذا عساه يفعل غير ذلك؟

42
00:05:46,030 --> 00:05:49,320
.هذا ما يجعل حياته مثيرةً للشّفقة

43
00:05:50,490 --> 00:05:51,580
.إنّه قادمٌ صوبنا

44
00:05:55,410 --> 00:05:56,660
!أنت

45
00:05:58,000 --> 00:05:59,040
ماذا؟

46
00:05:59,710 --> 00:06:01,170
.المعذرة

47
00:06:02,840 --> 00:06:03,750
ما الأمر؟

48
00:06:03,750 --> 00:06:08,550
.حسنٌ، احرص ألّا تفرط في طبخ البيبيمباب المحمّر على الحجر

49
00:06:08,550 --> 00:06:11,220
.هذا محروقٌ كثيرًا

50
00:06:11,720 --> 00:06:12,850
.مفهوم

51
00:06:14,430 --> 00:06:15,430
.سحّاب بنطلونك مفتوح

52
00:06:18,690 --> 00:06:19,520
!آسف

53
00:06:19,520 --> 00:06:21,610
.يا إلهي. يا له من أخرق

54
00:06:24,650 --> 00:06:27,400
.وها هو ذا مجدّدًا

55
00:06:28,700 --> 00:06:29,950
.لا أمل منه

56
00:06:30,360 --> 00:06:32,620
.إنّه من النّوع الّذي سيظلّ مديرًا طيلة حياته

57
00:06:40,500 --> 00:06:42,790
.شكرًا جزيلًا

58
00:06:43,460 --> 00:06:45,880
.يمكنكِ أخذ استراحتكِ الآن يا تاتشيبانا-سان

59
00:06:45,880 --> 00:06:47,090
.حسنًا

60
00:06:48,380 --> 00:06:49,090
هل هذا يكفي؟

61
00:06:50,300 --> 00:06:52,010
.هذا لن يشبعكِ

62
00:06:52,300 --> 00:06:56,220
.أنتِ في مقتبل العمر، لذلك عليكِ أن تأكلي جيّدًا

63
00:06:56,220 --> 00:06:58,560
.ستتقلّصين إن لم تفعلي

64
00:06:58,560 --> 00:07:00,980
.أمزح فحسب

65
00:07:14,620 --> 00:07:15,910
صبيّ؟

66
00:07:16,290 --> 00:07:18,330
.إنّه في المكتب بمفرده

67
00:07:18,330 --> 00:07:20,120
.ذلك الصبيّ

68
00:07:20,120 --> 00:07:21,670
.إنّه ابن المدير

69
00:07:20,120 --> 00:07:22,830
—إذًا اسمحا لي أن أتأكّد من طلباتكما

70
00:07:23,460 --> 00:07:25,340
!أعتذر على الإزعاج

71
00:07:26,050 --> 00:07:27,880
.آسفة

72
00:07:27,880 --> 00:07:28,760
أأنتِ بخير؟

73
00:07:30,380 --> 00:07:31,340
.أنا بخير

74
00:07:35,010 --> 00:07:37,310
.يسعدني سماع ذلك

75
00:07:43,150 --> 00:07:45,980
.إذًا فهو متزوّج

76
00:07:47,020 --> 00:07:48,030
!انتهيت

77
00:07:48,030 --> 00:07:49,570
.والآن سأتدرّب على هذا

78
00:07:51,110 --> 00:07:53,110
أهذا كلّ شيء؟

79
00:07:54,030 --> 00:07:55,570
!أعتذر على الإزعاج

80
00:07:56,240 --> 00:07:58,870
!يوتو! إنّ صداه يتردّد في سائر المطعم

81
00:07:58,870 --> 00:08:01,960
!لكن لديّ اختبار تسجيلٍ يوم غد

82
00:08:02,460 --> 00:08:04,420
!لا يمكنك التدرّب هنا

83
00:08:05,330 --> 00:08:07,130
.أعتذر يا تاتشيبانا-سان

84
00:08:08,000 --> 00:08:09,090
.لا مشكلة

85
00:08:19,350 --> 00:08:20,640
.لا

86
00:08:22,020 --> 00:08:23,140
.أهلًا وسهلًا

87
00:08:23,140 --> 00:08:25,230
.طاولةٌ لشخصين؟ تفضّلا من هنا

88
00:08:26,770 --> 00:08:28,770
.بالهناء والشّفاء

89
00:08:28,770 --> 00:08:30,940
.غريبٌ أنّه صمت الآن

90
00:08:34,660 --> 00:08:35,360
ماذا؟

91
00:08:39,540 --> 00:08:42,330
.حاول أن تعزف نوتة "فا" و"تي" دون تحريك أصابعك بسرعة

92
00:08:42,330 --> 00:08:43,040
.حسنًا

93
00:08:49,840 --> 00:08:52,260
.أعتقد أنّه يمتك عيناي أبيه

94
00:08:56,390 --> 00:08:57,680
!نجحت

95
00:08:57,680 --> 00:08:59,850
!هذا أفضل أداءٍ لي حتّى الآن

96
00:09:02,020 --> 00:09:03,020
.طُوبى لك

97
00:09:04,730 --> 00:09:06,100
.إنّها تبتسم

98
00:09:06,600 --> 00:09:08,690
.أستطيع العزف عليه الآن يا أبي

99
00:09:08,690 --> 00:09:10,520
.فهمت. هذا رائع

100
00:09:10,520 --> 00:09:11,480
!أنصت

101
00:09:11,480 --> 00:09:12,570
.سأعود إلى العمل

102
00:09:13,070 --> 00:09:14,400
.المعذرة يا تاتشيبانا-سان

103
00:09:15,610 --> 00:09:18,530
.أتأسّف لجعلكِ تجالسينه

104
00:09:18,530 --> 00:09:19,330
.أعتذر على هذا

105
00:09:22,700 --> 00:09:25,290
.لا داعي للاعتذار

106
00:09:30,630 --> 00:09:31,840
.أنتم

107
00:09:32,130 --> 00:09:33,630
هل رأى أحدكم المدير؟

108
00:09:33,630 --> 00:09:34,470
.إنّه في المكتب

109
00:09:34,550 --> 00:09:36,090
.يا له من مهمل

110
00:09:36,090 --> 00:09:38,010
...سحّاب بنطلونه المفتوح، قميصه المتدلّي

111
00:09:36,510 --> 00:09:38,010
.أنا قادمة

112
00:09:38,010 --> 00:09:39,720
.إنّه مهملٌ في كلّ شيء

113
00:09:39,720 --> 00:09:41,720
.لا عجب أنّ زوجته سئمت منه

114
00:09:41,720 --> 00:09:44,060
،إنّه كهلٌ في الـ45 من عمره، سيقضي بقية حياته كمدير

115
00:09:44,060 --> 00:09:44,890
.وفوق ذلك، تطلّق مرّة

116
00:09:45,890 --> 00:09:47,600
—اسمحا لي أن

117
00:09:48,060 --> 00:09:49,860
!أعتذر على الإزعاج

118
00:09:51,360 --> 00:09:52,940
.آسفة

119
00:09:52,020 --> 00:09:54,030
.من الأفضل استخدام هذه

120
00:09:52,940 --> 00:09:54,030
ما الّذي يجري؟

121
00:10:03,830 --> 00:10:04,870
ماذا؟

122
00:10:04,870 --> 00:10:06,120
أستلكمني؟

123
00:10:10,000 --> 00:10:14,380
.هذا [ن ب ك] نظام بثّ كازاميزاوا

124
00:10:14,380 --> 00:10:16,010
أيمكننا الانضمام إليكِ يا أكيرا؟

125
00:10:14,380 --> 00:10:16,630
.سنبدأ بثّنا لاستراحة الغداء

126
00:10:16,010 --> 00:10:16,630
.أكيد

127
00:10:17,680 --> 00:10:19,180
.هيّا فلنأكل

128
00:10:19,220 --> 00:10:20,850
.إنّي أتضوّر جوعًا

129
00:10:20,850 --> 00:10:22,350
.تكاد معدتي تلتصق بظهري

130
00:10:22,350 --> 00:10:23,600
ما الّذي يعنيه هذا؟

131
00:10:23,600 --> 00:10:24,640
.إنّها كلماتٌ من أغنية

132
00:10:24,640 --> 00:10:27,430
"...معدتي وظهري يريدان الالتصاق ببعضهما"

133
00:10:28,310 --> 00:10:31,020
أهذا كلّ ما ستأكلينه على الغداء يا أكيرا؟

134
00:10:31,020 --> 00:10:35,150
.منذ خروجي من الفريق، وأنا لا أستطيع أكل نفس القدر إلّا وشعرت بالخمول

135
00:10:35,150 --> 00:10:36,780
أهذا صحيح؟

136
00:10:36,780 --> 00:10:37,740
!ياماموتو

137
00:10:37,740 --> 00:10:39,990
.إذًا فأنتما هنا

138
00:10:39,990 --> 00:10:42,870
!إنّه ياماموتو-سينباي

139
00:10:42,870 --> 00:10:43,870
من يكون؟

140
00:10:45,160 --> 00:10:46,080
!إنّه لاعبٌ في فريق كرة القدم

141
00:10:46,080 --> 00:10:47,500
!أوسم شابّ في المدرسة

142
00:10:47,500 --> 00:10:49,000
!القائد ياماموتو

143
00:10:49,000 --> 00:10:51,460
ألم تكوني ترينه عندما كنتِ تتدرّبين؟

144
00:10:54,170 --> 00:10:56,420
أوليس وسيمًا؟

145
00:10:59,840 --> 00:11:00,890
.ليس تمامًا

146
00:11:00,890 --> 00:11:03,720
إذًا ما نوعكِ المحبّب من الفتيان يا أكيرا؟

147
00:11:03,720 --> 00:11:05,640
!أجل! أسمعينا

148
00:11:07,680 --> 00:11:09,600
،على سبيل المثال

149
00:11:10,060 --> 00:11:12,100
شخصٌ بشعرٍ أشعث

150
00:11:12,690 --> 00:11:15,610
.ويترك سحّاب بنطلونه مفتوحًا أحيانًا

151
00:11:15,610 --> 00:11:18,360
.شخصٌ يعطس بصوتٍ مرتفع

152
00:11:19,190 --> 00:11:20,990
!اصمت يا يوشيزاوا

153
00:11:20,990 --> 00:11:22,030
...لا أدري بشأن هذا

154
00:11:22,030 --> 00:11:23,570
أنتِ تمزحين، صحيح؟

155
00:11:23,570 --> 00:11:24,780
مثل كهل؟

156
00:11:24,780 --> 00:11:25,660
رجلٌ مجعّد؟

157
00:11:25,660 --> 00:11:27,120
ما هذا؟

158
00:11:27,120 --> 00:11:28,500
هل أغضبناكِ؟

159
00:11:28,870 --> 00:11:29,910
.ليس تمامًا

160
00:11:29,910 --> 00:11:31,920
!على رسلكِ يا أكيرا

161
00:11:45,050 --> 00:11:46,180
!أخطأتِ الهدف

162
00:11:46,180 --> 00:11:48,350
!تاتشيبانا أكيرا خارج اللّعبة

163
00:11:48,350 --> 00:11:51,350
.كيان هاروكا تحلّ محلّها

164
00:11:53,730 --> 00:11:54,730
!تصوّب

165
00:11:55,690 --> 00:11:58,860
!وتدخل الهدف! رميةٌ موفّقة

166
00:11:59,990 --> 00:12:02,200
.شكرًا يا هاروكا

167
00:12:02,200 --> 00:12:02,910
.العفو

168
00:12:02,910 --> 00:12:03,990
ألديكِ اجتماع؟

169
00:12:03,990 --> 00:12:05,240
.إنّه اجتماعٌ بين القادة

170
00:12:05,240 --> 00:12:07,790
.سيسمح لنا فريق كرة القدم باستغلال الميدان

171
00:12:07,790 --> 00:12:09,830
.الملتقى الرياضيّ سينعقد قريبًا

172
00:12:09,830 --> 00:12:12,000
.سيكون الأمر صعبًا هذه المرّة

173
00:12:15,290 --> 00:12:17,840
.سيكون الأمر أهون لو أنّكِ معنا في الفريق

174
00:12:18,710 --> 00:12:19,550
.آسفة

175
00:12:21,090 --> 00:12:24,890
.من الأفضل أن تنهي تدريب المضمار مبكّرًا هذا اليوم

176
00:12:25,510 --> 00:12:27,720
.ستمطر

177
00:12:28,220 --> 00:12:31,020
.أستطيع التنبّؤ بذلك بسبب أنّ ندبة ساقي تؤلمني قليلًا

178
00:12:32,690 --> 00:12:34,690
.لا تقلقي حيال شيء

179
00:12:36,150 --> 00:12:36,900
.حسنًا

180
00:12:46,490 --> 00:12:48,080
.بوركت جهودك

181
00:12:48,080 --> 00:12:50,580
—مرحبًا، بـ

182
00:12:53,500 --> 00:12:55,540
.اعذريني. يا إلهي

183
00:13:05,760 --> 00:13:07,050
...أخبريني يا يوي-تشان

184
00:13:07,050 --> 00:13:08,470
ما الأمر؟

185
00:13:08,470 --> 00:13:11,600
ما نوعكِ المحبّب من الرّجال؟

186
00:13:11,600 --> 00:13:13,640
ماذا، نوعي المحبّب؟

187
00:13:13,640 --> 00:13:15,310
.دعيني أفكّر

188
00:13:19,230 --> 00:13:21,730
،إن كنتُ سأختار أحدًا هنا

189
00:13:22,480 --> 00:13:26,950
.كاسي المتواجد في المطبخ وسيم، لكنّه يبدو كفتًى لعوب، لِذا لا يروقني

190
00:13:26,950 --> 00:13:29,830
.وأوتسوكا ملامحه جامدةٌ كالحجر، لِذا لا يروقني

191
00:13:29,830 --> 00:13:33,410
.وميانو ليس هنا اليوم، لكنّه خارج الحسابات

192
00:13:34,660 --> 00:13:37,040
.إنّه سؤالٌ صعب

193
00:13:39,590 --> 00:13:40,500
،إذن

194
00:13:41,590 --> 00:13:42,670
ماذا عن المدير؟

195
00:13:44,420 --> 00:13:45,760
ماذا؟ المدير؟

196
00:13:46,970 --> 00:13:49,050
.يا ويلي

197
00:13:49,050 --> 00:13:51,930
.اختبأت لا شعوريًا بعد أن سمعتهما تتحدّثان عنّي

198
00:13:49,970 --> 00:13:51,430
.الطّلب جاهز

199
00:13:52,260 --> 00:13:55,480
.لكن يجب أخرج إلى هناك بشكلٍ طبيعيّ

200
00:13:55,480 --> 00:13:57,770
.يجب أن أتحلّى ببعض الكرامة بصفتي المدير

201
00:13:58,480 --> 00:14:00,690
!المدير؟ مستحيل

202
00:13:58,480 --> 00:14:01,020
!أنتما الاثنتان

203
00:14:00,690 --> 00:14:02,190
!إنّه نتنٌ نوعًا ما

204
00:14:02,190 --> 00:14:04,610
.عليكما تقديم الطّعام إلى الطّاولة ستّة

205
00:14:04,610 --> 00:14:09,660
!حسنٌ، من الجيّد أنّكما في كامل نشاطكما

206
00:14:10,990 --> 00:14:12,660
.إنّك مضحكٌ أيّها المدير

207
00:14:22,840 --> 00:14:26,470
.احذر من رائحة الجسم، التنصّت وقول النّكات السّخيفة

208
00:14:31,260 --> 00:14:32,430
.أنت لها أيّها الكهل

209
00:15:57,930 --> 00:15:58,890
...المعذرة

210
00:15:59,730 --> 00:16:03,350
.لم أطلب هذا

211
00:16:03,980 --> 00:16:05,560
.إنّه على حسابنا

212
00:16:06,230 --> 00:16:09,820
ستملّين إذا بقيتِ تنتظرين توقّف المطر، صحيح؟

213
00:16:16,450 --> 00:16:18,330
.شكرًا جزيلًا لك

214
00:16:19,040 --> 00:16:21,580
أيعقل أنّكِ لا تحبّين القهوة السّوداء؟

215
00:16:21,580 --> 00:16:23,500
.أمهليني لحظة

216
00:16:39,310 --> 00:16:41,930
.واثقٌ أنّ المطر سينجلي قريبًا

217
00:17:48,830 --> 00:17:50,670
...ماذا؟ أليس هذا

218
00:18:15,110 --> 00:18:17,280
.لم أسمع في نشرة الطّقس أنّها ستمطر

219
00:18:17,280 --> 00:18:19,410
.لم أجلب معي مظلّة

220
00:18:20,120 --> 00:18:22,240
.حسنًا، بوركت جهودكم

221
00:18:22,240 --> 00:18:24,160
!بوركت جهودكِ

222
00:18:26,750 --> 00:18:29,250
.تفضّلوا. يمكنكم استخدام مظلّاتي الإضافيّة

223
00:18:29,250 --> 00:18:30,630
!يا لحظّنا

224
00:18:32,040 --> 00:18:33,340
.نقدّر لك هذا

225
00:18:33,340 --> 00:18:34,300
.عمت مساءً

226
00:18:34,300 --> 00:18:36,010
.بوركت جهودكما

227
00:18:36,010 --> 00:18:37,760
—إن أردتِ يا تاتشيبانا-سان

228
00:18:40,050 --> 00:18:42,680
.أعتقد أنّكِ أتيتِ مستعدّة

229
00:18:42,680 --> 00:18:44,390
.أنا منبهر

230
00:18:44,970 --> 00:18:45,770
...المعذرة

231
00:18:49,190 --> 00:18:50,100
.تفضّل

232
00:18:50,980 --> 00:18:52,810
.إنّها الأيّام الّتي أستطيع العمل خلالها الشّهر القادم

233
00:18:52,810 --> 00:18:55,280
!شكرًا لكِ

234
00:18:55,280 --> 00:18:59,820
...لنرَ، تاتشيبانا-سان، تاتشيبانا-سان

235
00:19:00,860 --> 00:19:01,820
!عجبًا

236
00:19:01,820 --> 00:19:04,370
.أنتِ مستعدّةٌ للعمل لساعاتٍ طويلة

237
00:19:04,370 --> 00:19:06,950
أتبتغين شيئًا؟

238
00:19:08,830 --> 00:19:12,420
.بالنّسبة لي، هذا عونٌ كبير، لِذا أنا ممتنٌّ لكِ

239
00:19:14,800 --> 00:19:15,670
.أيّها المدير

240
00:19:17,760 --> 00:19:19,050
...المعذرة

241
00:19:19,510 --> 00:19:21,680
أيمكنكِ التوقّف عن التّحديق إليّ؟

242
00:19:24,350 --> 00:19:26,430
.لـ-لم أكن أحدّق إليك

243
00:19:26,430 --> 00:19:28,270
حـ-حقًا؟

244
00:19:28,270 --> 00:19:30,890
.إنّها بالتّأكيد كذلك

245
00:19:32,270 --> 00:19:34,360
.أيّها المدير

246
00:19:37,110 --> 00:19:38,030
ما الأمر؟

247
00:19:38,400 --> 00:19:44,240
...ألديك أحد تطبيقات التّواصل الاجتماعيّ على هاتفك

248
00:19:44,910 --> 00:19:48,120
ألديك اسم مستخدم لها؟

249
00:19:46,790 --> 00:19:50,870
.إنّها بالفعل تحدّق بي

250
00:19:48,120 --> 00:19:52,540
إن كنت تملك أحدها، فما اسم المستخدم الخاص بك؟

251
00:19:50,870 --> 00:19:52,120
.مخيف

252
00:19:53,460 --> 00:19:56,250
ماذا يكون اسم المستخدم؟

253
00:19:57,920 --> 00:19:59,670
.انسَ ما قلته

254
00:19:59,670 --> 00:20:01,630
.بوركت جهودك

255
00:20:01,680 --> 00:20:03,680
.نـ-نعم، بوركت جهودكِ

256
00:20:19,860 --> 00:20:21,030
أذاك خليلها؟

257
00:20:32,790 --> 00:20:33,540
.يا لسخافتي

258
00:20:34,580 --> 00:20:37,880
!هذا مذهل! يا لها من مصادفة

259
00:20:37,880 --> 00:20:39,920
أهذا مكان عملكِ يا تاتشيبانا؟

260
00:20:39,920 --> 00:20:42,380
!منزل جدّتي بالقرب من هنا

261
00:20:42,420 --> 00:20:46,890
ما رأيكِ بأن نتبادل معلومات وسائل تواصلنا
الاجتماعيّ تخليدًا لهذا اللّقاء المقدّر؟

262
00:20:48,470 --> 00:20:50,350
!لحظة، ماذا؟