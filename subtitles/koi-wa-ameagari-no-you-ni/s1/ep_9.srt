53
00:03:51,000 --> 00:03:52,960
.هذا يعيد إليّ الذكريات

54
00:03:53,880 --> 00:03:54,380
،أكيرا

55
00:03:54,380 --> 00:03:56,170
أيّ واحدة تستهدفين؟

56
00:03:56,170 --> 00:03:57,880
.الحمراء

57
00:03:57,880 --> 00:03:59,390
الحمراء؟

58
00:04:09,900 --> 00:04:11,110
!سأستهدف الحمراء أيضًا

59
00:04:15,530 --> 00:04:18,320
ألا تعتقدين أنّ ذلك الخيط يصبح أكثر هشاشةً كلّ سنة؟

60
00:04:19,780 --> 00:04:20,530
وهل يهمّ ذلك؟

61
00:04:21,030 --> 00:04:23,120
.تحصلين على واحدة على كلّ حال

62
00:04:23,830 --> 00:04:25,240
.فلنسترح هناك

63
00:04:25,950 --> 00:04:26,790
.أكيرا

64
00:04:27,960 --> 00:04:30,330
.شكرًا على دعوتي اليوم

65
00:04:32,250 --> 00:04:35,840
.هذه أوّل مرّةٍ نتنزّه معًا منذ خروجي من الفريق

66
00:04:50,650 --> 00:04:54,520
.في النّهاية، لا أحد منّا تمكّن من تخطّي الدّور الأوّل من البطولة

67
00:04:56,480 --> 00:04:57,940
مثيرٌ للشّفة، أليس كذلك؟

68
00:04:57,940 --> 00:05:00,200
.أُصيبت إيشي بالإحباط أيضًا بسبب ذلك

69
00:05:04,080 --> 00:05:05,870
.على الإطلاق

70
00:05:10,250 --> 00:05:12,210
...أخبريني يا أكيرا

71
00:05:12,790 --> 00:05:14,290
—لماذا لا تمرّين علينا أثناء التّدريبات

72
00:05:23,970 --> 00:05:24,930
.عن إذنكِ للحظة

73
00:05:24,930 --> 00:05:26,470
أ-أكيرا؟

74
00:05:32,230 --> 00:05:33,230
من تراه يكون؟

75
00:05:33,940 --> 00:05:36,070
.إنّه ليس والد أكيرا

76
00:05:46,410 --> 00:05:49,040
.آسفة. إنّه مديري في العمل

77
00:05:49,040 --> 00:05:50,120
مديركِ؟

78
00:05:52,580 --> 00:05:53,500
.أكيرا

79
00:05:54,630 --> 00:05:57,000
هل تحبّين ذلك الشّخص؟

80
00:05:57,300 --> 00:05:57,880
ماذا؟

81
00:06:01,880 --> 00:06:02,930
!أتمزحين؟

82
00:06:02,930 --> 00:06:04,590
!إنّه طاعنٌ في السّن

83
00:06:04,590 --> 00:06:06,640
...كما أنّ ذلك الصبيّ الّذي معه على الأرجح

84
00:06:10,350 --> 00:06:11,600
.دعكِ من ذلك

85
00:06:12,390 --> 00:06:14,060
.فلنذهب للبحث عن شو-تشان والصّغيرتان

86
00:06:14,690 --> 00:06:15,650
.أكيرا

87
00:06:18,770 --> 00:06:22,360
.أكيرا، لم تعودي تحدّثينني عن أيّ شيء

88
00:06:23,610 --> 00:06:25,740
.لا أعرف ماذا يدور في ذهنكِ

89
00:06:28,030 --> 00:06:29,990
!أنتِ لم تسأليني أيضًا

90
00:06:29,990 --> 00:06:31,540
!وكيف لي أن أسأل؟

91
00:06:35,210 --> 00:06:39,500
...تقولين أمورًا مثل "كان عليكِ إلقاء التحية" و"لم تسأليني،" لكن

92
00:06:39,960 --> 00:06:45,130
!أنتِ من يصعّب مأمورية الحديث إليكِ أو سؤالكِ عن أيّ شيء

93
00:06:45,130 --> 00:06:46,680
.أنتما

94
00:06:53,060 --> 00:06:53,980
!لـ-لحظة

95
00:06:54,310 --> 00:06:56,770
!لماذا تبكيان؟

96
00:06:57,480 --> 00:06:58,360
...لأنّنا

97
00:06:59,110 --> 00:07:00,690
.لن نعود لسابق عهدنا

98
00:07:02,570 --> 00:07:05,490
.هوّنا عليكما. لا تبكيا

99
00:07:08,660 --> 00:07:09,950
هاروكا؟

100
00:07:17,580 --> 00:07:18,250
!سأعود إلى المنزل

101
00:07:18,250 --> 00:07:19,250
!انتظري

102
00:07:20,710 --> 00:07:24,470
!سينطلق موكب حمل الضّريح قريبًا

103
00:07:25,380 --> 00:07:26,180
!أعتذر يا أكيرا-تشان

104
00:07:26,180 --> 00:07:27,340
!عن إذنك

105
00:07:56,370 --> 00:07:57,830
.حتّى الرّائحة لم تتغيّر

106
00:08:07,590 --> 00:08:08,930
ماذا؟

107
00:08:09,550 --> 00:08:13,180
.لا يفترض أن يُغلق في هذا الوقت

108
00:08:17,770 --> 00:08:20,900
.على كلّ، ما زال الوقت مبكّرًا، لكن أعتقد أنّي سأتوجّه إلى هناك

109
00:08:38,620 --> 00:08:39,790
.آسفة

110
00:08:40,080 --> 00:08:42,250
.لا داعي، أنا آسفٌ أيضًا

111
00:08:46,260 --> 00:08:46,920
.تفضّلي

112
00:08:46,920 --> 00:08:48,760
.شكرًا جزيلًا

113
00:08:48,760 --> 00:08:49,970
!نسخة موقّعة

114
00:08:49,970 --> 00:08:51,550
!إنّنا محظوظتان

115
00:08:53,260 --> 00:08:54,720
!أهلًا وسهلًا

116
00:08:55,770 --> 00:08:57,890
.المعذرة، يفترض أن ألتقي بصديقٍ هنا

117
00:08:57,890 --> 00:08:59,940
.إنّه ينتظرك في الطّاولة الخلفية

118
00:09:10,400 --> 00:09:11,450
.تشيهيرو

119
00:09:12,910 --> 00:09:13,660
.مرحبًا

120
00:09:14,990 --> 00:09:17,370
لماذا اخترت هذا المكان؟

121
00:09:17,370 --> 00:09:20,710
.كان هذا مكاننا المفضّل

122
00:09:20,710 --> 00:09:23,000
.هذا يعيد الذّكريات إلى الأذهان

123
00:09:23,000 --> 00:09:23,830
!المعذرة

124
00:09:24,170 --> 00:09:25,250
!زجاجة جعّة رجاءً

125
00:09:25,250 --> 00:09:26,800
!في الحال

126
00:09:26,800 --> 00:09:29,010
...و

127
00:09:27,960 --> 00:09:31,340
.لقد طلبت بالفعل شيئًا نقضمه

128
00:09:31,340 --> 00:09:32,050
ماذا؟

129
00:09:32,050 --> 00:09:34,050
!شكرًا على الانتظار

130
00:09:35,550 --> 00:09:36,350
!تفضّلا

131
00:09:40,560 --> 00:09:42,600
!أجل، هذا ما أردته

132
00:09:42,600 --> 00:09:44,270
!دوندين ميسو دينجاكو

133
00:09:44,270 --> 00:09:46,230
.هذا طبقنا المفضّل

134
00:09:53,820 --> 00:09:56,950
.لقد فاجأني اتّصالك بي بعد كلّ هذه المدّة

135
00:09:56,950 --> 00:09:59,750
مضت حوالي عشر سنوات، أليس كذلك؟

136
00:10:00,370 --> 00:10:01,660
كيف هي أحوالك؟

137
00:10:02,830 --> 00:10:04,000
...حسنٌ

138
00:10:04,630 --> 00:10:07,290
.صادفت شيئًا ذكّرني بك

139
00:10:09,210 --> 00:10:11,920
.تبدو على أحسن ما يرام كما عهدتك

140
00:10:11,920 --> 00:10:13,380
.يمكنك قول ذلك

141
00:10:13,380 --> 00:10:17,430
.اصطدمت قبل قليل بفتاةٍ شابّة عند باب المحلّ تحمل كتابك

142
00:10:19,220 --> 00:10:21,350
،قد لا تكون مهتمًا بسماع هذا

143
00:10:21,350 --> 00:10:24,310
.لكنّي أملك بعض المعجبين من اليافعات أيضًا

144
00:10:24,310 --> 00:10:26,690
.على كلٍّ، كان كتابك مشوّقًا نوعًا ما

145
00:10:27,820 --> 00:10:29,280
!قـ-قرأته؟

146
00:10:29,280 --> 00:10:30,360
.نعم

147
00:10:30,360 --> 00:10:31,740
اشتريت نسخةً منه؟

148
00:10:31,740 --> 00:10:32,530
.لا

149
00:10:32,530 --> 00:10:33,400
ماذا؟

150
00:10:33,400 --> 00:10:34,820
.استعرته من المكتبة

151
00:10:41,500 --> 00:10:43,290
هـ-هل كان مشوّقًا؟

152
00:10:43,290 --> 00:10:45,290
.كما أسلفت، لا بأس به

153
00:10:45,710 --> 00:10:48,000
ما-ماذا تقصد بـ"لا بأس به"؟

154
00:10:48,000 --> 00:10:50,000
!لقد كان تحفةً أدبية

155
00:10:50,000 --> 00:10:50,960
.لا بأس به

156
00:10:54,220 --> 00:10:55,470
.ليس أنا

157
00:10:58,050 --> 00:10:59,470
.مهما يكن

158
00:10:59,760 --> 00:11:04,390
.بما أنّه أوّل لقاءٍ لنا بعد سنواتٍ من الفراق، فقد أحضرت معي شيئًا مميّزًا

159
00:11:05,850 --> 00:11:07,020
!مفاجأة

160
00:11:07,020 --> 00:11:09,900
.إنّها المجلّة الّتي ألّفناها معًا في الكلية

161
00:11:11,400 --> 00:11:13,240
!هذا يعيد الكثير من الذّكريات

162
00:11:13,240 --> 00:11:14,650
صحيح؟

163
00:11:14,650 --> 00:11:16,530
.لا أصدّق أنّك ما زلت تملكها

164
00:11:16,530 --> 00:11:17,700
صحيح؟

165
00:11:18,490 --> 00:11:22,490
ما بال هذا العنوان، "أمسكني في حقل الملفوف"؟

166
00:11:22,490 --> 00:11:25,870
.اعتدت على أكل الملفوف كلّ يوم لأنّي لم أملك المال

167
00:11:25,870 --> 00:11:27,580
.إنّها صفحة تاكادا-سينباي

168
00:11:27,580 --> 00:11:31,920
.لطالما أدّى جدالنا حول مراجعات الأفلام إلى مشاحنات كبيرة

169
00:11:36,550 --> 00:11:37,220
ما الخطب؟

170
00:11:38,260 --> 00:11:39,930
وجدت اسم ميدوري-تشان؟

171
00:11:40,470 --> 00:11:42,310
أما زلت تراها هذه الأيام؟

172
00:11:42,310 --> 00:11:44,430
كم سنةً مرّت على طلاقكما؟

173
00:11:44,430 --> 00:11:46,890
.لا أراها

174
00:11:46,890 --> 00:11:49,230
.نتحدّث أحيانًا عن ابننا عبر الهاتف فحسب

175
00:11:49,770 --> 00:11:53,110
.تخلّيت عن رحلتنا إلى الهند لتتزوّجها

176
00:11:53,110 --> 00:11:57,740
.واستهللت مسيرتي ككاتب برواية ألّفتها أثناء سفري وحيدًا

177
00:11:59,240 --> 00:12:01,160
.أعتذر على ما حصل آنذاك

178
00:12:10,380 --> 00:12:12,840
.كنّا في ريعان الشّباب

179
00:12:16,420 --> 00:12:18,590
ما زلت تكتب الرّوايات، أليس كذلك؟

180
00:12:18,590 --> 00:12:19,550
ماذا؟

181
00:12:19,550 --> 00:12:21,470
.لا، لم أعد أفعل

182
00:12:21,470 --> 00:12:25,060
.أنت تكذب. وجهك يقول عكس ذلك

183
00:12:26,730 --> 00:12:31,690
...حسنٌ، أكتب كلمةً أو اثنتان بينة الفينة والأخرى

184
00:12:32,980 --> 00:12:36,150
.لم أكمل روايةً واحدةً منذ ما يقرب خمس سنوات

185
00:12:36,900 --> 00:12:39,610
.ولا أنوي أساسًا أن أريها لأحد

186
00:12:41,410 --> 00:12:43,700
.إنّه محض شيءٍ تافه

187
00:12:46,540 --> 00:12:49,580
.لم أفتح هذا الموضوع مع أحدٍ منذ مدّة

188
00:12:51,580 --> 00:12:58,170
.لا أحد حولي يعلم أنّي أعمل مؤخّرًا على رواية

189
00:13:00,550 --> 00:13:04,640
.ليس وكأنّ عليك إخبار أحدٍ عن ذلك

190
00:13:08,810 --> 00:13:09,890
.معك حقّ

191
00:13:12,230 --> 00:13:15,820
.كما أنّ بإمكانك الحديث معي إذا رغبت بذلك

192
00:13:15,820 --> 00:13:17,990
!هيّا، اشرب

193
00:13:19,070 --> 00:13:20,030
!المعذرة

194
00:13:20,030 --> 00:13:21,740
!زجاجة جعّة أخرى رجاءً

195
00:13:21,740 --> 00:13:23,200
!في الحال

196
00:13:27,410 --> 00:13:30,790
.أعتقد أنّنا أصبحنا في منتصف العمر

197
00:13:36,710 --> 00:13:39,300
!رخيص، لذيذ وصاخب

198
00:13:39,300 --> 00:13:42,220
.ذلك المكان أفضل أنيسٍ لطلّاب الكلية

199
00:13:42,220 --> 00:13:43,840
.لقد أسرفت في الشّرب

200
00:13:45,800 --> 00:13:46,850
.إنّها سيارة أجرة

201
00:13:46,850 --> 00:13:48,680
.سأقلّك حتّى منتصف الطّريق

202
00:13:48,680 --> 00:13:51,390
.لا، سأتمشّى لكي أبدّد مفعول الكحول

203
00:13:51,390 --> 00:13:52,600
ماذا؟

204
00:13:52,600 --> 00:13:53,900
!لنستقلّ سيارة أجرة

205
00:13:53,900 --> 00:13:54,730
.سأتمشّى

206
00:13:54,730 --> 00:13:55,770
.سيارة أجرة

207
00:13:55,770 --> 00:13:56,980
.المشي

208
00:13:57,610 --> 00:13:59,230
.إذًا سأتمشّى أيضًا

209
00:14:09,660 --> 00:14:10,750
.لا أستطيع

210
00:14:10,750 --> 00:14:12,080
!لا أستطيع مواصلة المشي

211
