1
00:00:07,470 --> 00:00:10,470
لم أركم منذ وقتٍ طويل يا أشقياء إينو شيكا تشو

2
00:00:11,260 --> 00:00:13,050
أنت كاكوزو، صحيح؟

3
00:00:14,800 --> 00:00:16,220
"لقد أسقطنا "الذهب

4
00:00:17,220 --> 00:00:18,420
،"أما بالنسبة لك أيها الـ"فيل

5
00:00:18,470 --> 00:00:20,170
فنحن على درايةٍ بخدعك ومدى براعتك

6
00:00:20,800 --> 00:00:23,420
من الآن فصاعدًا، نحن من سنهاجم

7
00:00:23,800 --> 00:00:25,720
الشقي الذي يستعمل الظلال

8
00:00:26,260 --> 00:00:30,470
كونكم هنا يعني أنّكم قد أوقفتم هيدان؟

9
00:00:31,550 --> 00:00:33,720
،لقد فُصل رأسه عن جسمه مجدّدًا

10
00:00:33,760 --> 00:00:35,470
بينما كان يدعو؟

11
00:00:36,630 --> 00:00:41,420
أم أنّ عدم وجوده هنا يعني أنّه ما يزال حيًّا؟

12
00:00:41,760 --> 00:00:44,090
!وكأنّنا نعلم ما يفعله بينما يتعفّن في مكانٍ ما

13
00:00:45,630 --> 00:00:47,470
،لا أملك قلعةً

14
00:00:47,510 --> 00:00:49,840
،وجنرالي الفضي والذهبي قد أسقطا
وقد بتّ في وضعٍ دفاعيّ

15
00:00:53,420 --> 00:00:55,300
هذا الخامس

16
00:00:59,340 --> 00:01:02,470
.صحيح
ذاك الشخص يملك خمسة قلوب

17
00:01:02,510 --> 00:01:04,010
لذا علينا أن نقضي عليه خمس مرات

18
00:01:04,260 --> 00:01:06,130
أجل، معك حق

19
00:01:06,840 --> 00:01:09,420
حان الوقت لإنهاء اللعبة

20
00:01:22,720 --> 00:01:24,090
،بالمناسبة

21
00:01:24,130 --> 00:01:27,380
نحن نملك جنرالان فضيّ وذهبي أيضًا

22
00:01:28,340 --> 00:01:31,590
هل يهمّكم أن تعرفوا من يكونان؟

23
00:01:34,630 --> 00:01:38,130
كاتو دان، حبيب الأميرة تسونادي

24
00:01:39,420 --> 00:01:40,590
...و

25
00:01:49,220 --> 00:01:50,720
ساروتوبي أسوما

26
00:01:51,510 --> 00:01:54,590
نجل الهوكاغي الثالث ومعلّمكما

27
00:01:55,050 --> 00:01:57,050
!أسوما... سينسي

28
00:01:57,840 --> 00:02:02,420
أظنّ أنّكم لستم الوحيدين الذين أخذتم قطعًا

29
00:02:02,720 --> 00:02:04,880
لدينا البعض الأخرى أيضًا

30
00:02:06,170 --> 00:02:07,590
أوليس هذا ساخرًا؟

31
00:02:09,420 --> 00:02:10,760
!—أيها الـ

32
00:02:13,510 --> 00:02:14,260
!تشوزا

33
00:02:14,670 --> 00:02:16,420
لمَ استغرقت تشكيلة اللهب الأربعة طويلًا؟

34
00:02:17,340 --> 00:02:19,420
...أسرعوا واحشروني داخل الحاجز

35
00:02:19,840 --> 00:02:22,130
!قبل أن أستخدم تقنية تحوّل الشبح خاصتي

36
00:02:22,630 --> 00:02:24,420
الأمر ليس بتلك البساطة

37
00:02:24,880 --> 00:02:26,380
!ليس وأنت الهدف

38
00:02:30,380 --> 00:02:32,340
!لقد ظهر شيءٌ أسود غريب

39
00:02:33,170 --> 00:02:33,970
!احترسوا

40
00:02:37,050 --> 00:02:38,760
فلنبدأ هجومنا المضاد

41
00:02:45,800 --> 00:02:47,340
إنّنا مدينونٌ لكَ بشيء

42
00:02:47,380 --> 00:02:49,970
!آمل أنّك لم تنسَ أيّها المسخ الخَيطيّ

43
00:02:50,420 --> 00:02:53,760
آسف، لكن لا أذكر أيّ أحدٍ لا يدرّ عليّ بالمال

44
00:02:54,130 --> 00:02:56,470
يقال أنّ حتّى الجحيم يُسيّر بالمال

45
00:02:57,010 --> 00:03:00,090
أذلك ما حدث معك؟

46
00:03:03,380 --> 00:03:04,340
!سينباي

47
00:03:04,340 --> 00:03:06,090
!أزومو، كوتيتسو

48
00:03:06,550 --> 00:03:08,260
!شيكامارو! تشوجي! إينو

49
00:03:08,590 --> 00:03:10,340
!ساعدونا على ختمه

50
00:03:10,920 --> 00:03:12,340
!حسنًا

51
00:03:14,880 --> 00:03:16,340
...إيزومو، كوتيتسو

52
00:03:16,340 --> 00:03:18,880
أنتما وداروي ستظلّان لتتكفّلا بكاكوزو

53
00:03:19,380 --> 00:03:21,050
كاكوزو يستخدم أسلوب الأرض

54
00:03:21,380 --> 00:03:23,550
ركّزوا هجومكم على أسلوب البرق الخاص بداروي

55
00:03:24,090 --> 00:03:26,010
شيكامارو وتشوجي وإينو سيواجهون أسوما

56
00:03:27,630 --> 00:03:30,260
!لكن... هذا قاسٍ جدًّا عليهم

57
00:03:30,380 --> 00:03:32,550
!فأسوما-سينباي معلّمهم

58
00:03:32,670 --> 00:03:34,010
!لا يمكنك فعل هذا

59
00:03:34,550 --> 00:03:37,470
،لقد كانوا تلاميذ أسوما
الفريق العاشر السابق

60
00:03:37,510 --> 00:03:40,550
إنّهم يعرفون أسوما أفضل من أيّ أحد

61
00:03:40,920 --> 00:03:42,510
وأمامهم أفضل فرصةٍ للتغلّب عليه

62
00:03:43,090 --> 00:03:44,220
...لكن

63
00:03:44,380 --> 00:03:47,840
!لا تشتكوا! هذه الحرب

64
00:03:48,220 --> 00:03:50,010
!ويجب أن نظفر بالفوز بها

65
00:03:50,550 --> 00:03:51,670
...لكن

66
00:03:53,840 --> 00:03:54,920
...أنا

67
00:05:51,670 --> 00:05:52,920
!احترسا

68
00:05:54,170 --> 00:05:55,750
!تشوجي

69
00:05:55,790 --> 00:05:58,090
!هذا يجعل الأمر يبدو وكأنّ شيكامارو هو خصمي الوحيد

70
00:05:58,590 --> 00:06:01,380
لكنّ ذلك سيؤلم

71
00:06:01,670 --> 00:06:06,130
أنا قويّ ولا أريد أن أؤذيكما

72
00:06:06,420 --> 00:06:08,840
وما أدراك أنّك أفضل؟

73
00:06:09,210 --> 00:06:12,460
!تقدّم، جرّب أن تؤذينا

74
00:06:12,500 --> 00:06:14,710
!هيّا! ابكِ! اصرخ

75
00:06:14,750 --> 00:06:16,630
!توقّفي! إنّك تؤذينني

76
00:06:16,670 --> 00:06:20,590
تبًّا... يا له من إزعاج

77
00:06:20,630 --> 00:06:24,420
تشوجي، هل تتصرّف بلطفٍ لأنهما صديقاك؟

78
00:06:25,090 --> 00:06:26,290
...أسوما-سينسي

79
00:06:26,710 --> 00:06:29,170
في تلك الحالة، أنت مخطئ

80
00:06:29,750 --> 00:06:35,630
مبارزة زميلٍ أقوى منك سيساعده
على أن يصبح أقوى أيضًا

81
00:06:38,630 --> 00:06:39,590
ألم تفهم؟

82
00:06:40,420 --> 00:06:42,130
إذًا سأريك

83
00:06:44,170 --> 00:06:46,420
سنتبارز الآن

84
00:06:46,880 --> 00:06:49,790
إن استطعتَ ضربي فستنجح

85
00:06:50,040 --> 00:06:55,290
...لكن إلّم تستطع أن تضربني في غضون ساعة يا تشوجي

86
00:06:55,460 --> 00:06:56,960
،ليس أنت وحسب

87
00:06:56,960 --> 00:07:00,290
لكن حتّى إينو وشيكامارو سيعودان للأكاديمية

88
00:07:00,750 --> 00:07:02,960
!ماذا؟ هذا ليس منصفًا

89
00:07:03,840 --> 00:07:07,710
فكّر بي على أنّي العدوّ وهاجمني لأجلهما أيضًا

90
00:07:08,290 --> 00:07:11,210
حوّل لطفك إلى قوّة

91
00:07:13,710 --> 00:07:14,540
!تشوجي

92
00:07:15,960 --> 00:07:17,090
هل أنت بخير؟

93
00:07:17,290 --> 00:07:18,670
...نعم

94
00:07:19,670 --> 00:07:21,250
ما خطبكم؟

95
00:07:21,290 --> 00:07:22,960
!هاجموا أسوما الآن

96
00:07:27,040 --> 00:07:29,670
،إن كنت تهتمّ لرفاقك حقًّا

97
00:07:30,090 --> 00:07:32,090
،فبدلًا من الهروب

98
00:07:32,340 --> 00:07:36,130
!فعليك أن تعزم على تطوير نفسك

99
00:07:36,840 --> 00:07:40,750
!هؤلاء هم الرفاق بحق أيّها الجبان

100
00:07:42,500 --> 00:07:45,960
أنا أعتمد عليك يا شيكامارو

101
00:07:50,130 --> 00:07:51,040
سأذهب

102
00:07:51,340 --> 00:07:52,630
!شيكامارو

103
00:07:55,170 --> 00:07:56,750
ماذا ستفعلين يا إينو؟

104
00:07:57,340 --> 00:07:58,460
!تشوجي

105
00:07:59,380 --> 00:08:01,290
!انظر جيّدًا من حولك، انظر إلى رفاقك

106
00:08:07,250 --> 00:08:08,170
!انطلق

107
00:08:27,750 --> 00:08:29,790
!هلّموا إليّ

108
00:08:36,000 --> 00:08:36,960
!تشوزا

109
00:08:36,960 --> 00:08:38,420
!أعلم

110
00:08:53,920 --> 00:08:55,000
...تشوجي

111
00:08:55,840 --> 00:08:59,090
هل تذكر وصيّة أسوما-سينسي؟

112
00:09:04,590 --> 00:09:05,630
...تشوجي

113
00:09:06,540 --> 00:09:09,750
...أنت رجلٌ لطيف يهتمّ لرفاقه

114
00:09:10,710 --> 00:09:12,000
...لهذا

115
00:09:12,840 --> 00:09:15,130
ستصبح شينوبي أقوى من أيّ أحد آخر

116
00:09:16,090 --> 00:09:18,960
تحلّ بثقةٍ أكبر في نفسك

117
00:09:33,960 --> 00:09:38,290
أنتِ قويّة العزيمة وأهلٌ للثقة

118
00:09:39,500 --> 00:09:44,040
كلٌّ من تشوجي وشيكامارو أخرقان

119
00:09:45,290 --> 00:09:46,590
لذا اعتني بهما رجاءً

120
00:09:53,130 --> 00:09:54,460
هيّا بنا يا رفاق

121
00:09:54,670 --> 00:09:55,540
!أجل

122
00:09:55,880 --> 00:09:57,000
...نـ-نعم

123
00:10:00,000 --> 00:10:02,170
!إنّنا نعتمد عليكم أنتم الثلاثة

124
00:10:12,880 --> 00:10:14,040
!حسنًا

125
00:10:18,460 --> 00:10:20,710
لقد كانت الكوناي بغرض إلهائنا

126
00:10:20,750 --> 00:10:22,000
هذا ما كانوا يهدفون إليه

127
00:10:31,000 --> 00:10:32,290
!هل نجحوا؟

128
00:10:38,590 --> 00:10:39,710
!ليس بعد

129
00:10:42,630 --> 00:10:45,290
!أسوما، عليّ أن أوقفك

130
00:10:46,210 --> 00:10:49,130
حركة جيّدة مقارنةً بكيفية تشكيلها باستعجال

131
00:10:49,250 --> 00:10:50,960
تابع محاصرتي هكذا

132
00:10:50,960 --> 00:10:52,130
!حاضر

133
00:10:52,340 --> 00:10:53,540
!مرّةً أخرى

134
00:10:53,590 --> 00:10:56,420
!لكن هذه المرة، سيكون هدفنا إحاطته وليس التمويه

135
00:10:56,460 --> 00:10:57,210
مفهوم

136
00:10:57,290 --> 00:11:00,380
!سحقًا! ما الذي أخّر فريق الختم؟

137
00:11:07,750 --> 00:11:08,790
!قويّ جدًّا

138
00:11:08,840 --> 00:11:09,790
!سحقًا

139
00:11:19,170 --> 00:11:21,090
!أسلوب النار! الرماد المحترق

140
00:11:23,710 --> 00:11:24,630
!ما هذا...؟

141
00:11:24,670 --> 00:11:25,750
!ستارٌ دخاني؟

142
00:11:59,420 --> 00:12:00,540
...أنتم

143
00:12:21,460 --> 00:12:24,050
استغرقتُ وقتًا طويلًا لإيجاد ذلك السيف المهم

144
00:12:24,920 --> 00:12:27,210
والآن، أين كاكوزو اللّعين ذاك؟

145
00:12:33,960 --> 00:12:35,550
...لقد التقطتُ هذه سابقًا

146
00:12:42,920 --> 00:12:45,380
!ماذا؟ إنّي بارعةٌ جدًّا في استعمالها

147
00:12:49,010 --> 00:12:50,670
!لن تهرب

148
00:12:58,010 --> 00:13:00,760
!حسنًا! لقد نلتُ من الذي ينتج الرّعد

149
00:13:01,460 --> 00:13:04,760
!هذا الشّيء رائع
لكن أتساءل من أسقطه

150
00:13:07,920 --> 00:13:11,920
أشعر وكأنّه يستنزفُ قدرًا هائلًا من التشاكرا

151
00:13:13,170 --> 00:13:16,090
!لكن لا يمكنني أن أقلق بشأن ذلك الآن

152
00:13:23,090 --> 00:13:25,920
وهل ظننت أنّني سأبقى ساكنًا؟

153
00:13:28,840 --> 00:13:29,960
!القائد داروي

154
00:13:30,260 --> 00:13:32,340
...تلقيتُ الأوامر من المقر

155
00:13:32,960 --> 00:13:34,090
!...لكن

156
00:13:40,760 --> 00:13:43,340
أيها القائد، يجب أن نستخدم أسلوب البرق بضربةٍ واحدة

157
00:13:43,920 --> 00:13:47,960
أعتذر. لقد بالغتُ سابقًا

158
00:13:48,630 --> 00:13:50,050
!النمر الأسود

159
00:13:52,590 --> 00:13:54,210
!دوائر الليزر

160
00:13:55,010 --> 00:13:56,880
!النمر الأسود المزدوج

161
00:13:58,960 --> 00:14:00,960
لا أملك تشاكرا كافية

162
00:14:01,800 --> 00:14:03,460
هلّا أمهلتماني لحظة؟

163
00:14:04,090 --> 00:14:05,170
!سنذهب خلفه، كوتيتسو

164
00:14:05,210 --> 00:14:05,880
!أجل

165
00:14:08,260 --> 00:14:10,340
أنا أعتذر حقًّا

166
00:14:23,920 --> 00:14:25,920
إنّنا مستعدّون لهذا الواجب

167
00:14:28,050 --> 00:14:29,960
لذا يا سينسي، كن مستعدًّا رجاءً أيضًا

168
00:14:31,550 --> 00:14:34,880
...تشوجي... شيكامارو... إينو

169
00:14:35,920 --> 00:14:37,960
لقد أصبحتم شينوبي رائعين

170
00:14:47,550 --> 00:14:48,960
!كلّ ذلك بفضلك

171
00:14:52,090 --> 00:14:54,710
!أروني ما لديكم يا إينو شيكا تشو

172
00:15:00,800 --> 00:15:02,170
!سنسقطه بهجومٍ واحد

173
00:15:05,300 --> 00:15:06,510
!تقنية الاستبدال

174
00:15:06,630 --> 00:15:07,460
!اهربا

175
00:15:12,380 --> 00:15:13,880
!حركاتك بطيئة يا تشوجي

176
00:15:14,130 --> 00:15:15,300
!لملم نفسك

177
00:15:15,590 --> 00:15:16,460
!إنه قادم

178
00:15:19,010 --> 00:15:19,960
!شيكامارو

179
00:15:20,010 --> 00:15:23,170
قم بتأدية تقنية حيازة الظل خاصتك لتقودني إلى تشوجي

180
00:15:23,380 --> 00:15:24,840
!ذلك ما أخطّط لفعله

181
00:15:25,380 --> 00:15:26,880
!تقنية حيازة الظل

182
00:15:27,170 --> 00:15:28,590
!حركة أخرى

183
00:15:29,880 --> 00:15:31,300
،حتّى لو كان ذلك خداعًا

184
00:15:31,340 --> 00:15:33,960
!إن كان يعرف تقنية نقل العقل فسيتفاداها

185
00:15:34,090 --> 00:15:36,050
،وإن تجنّب حيازة الظل وحاول الهرب

186
00:15:36,090 --> 00:15:37,210
فسيكون في النقطة العمياء لإينو

187
00:15:37,760 --> 00:15:39,960
!ما كنتُ آمله تمامًا
...وحينها

188
00:15:40,010 --> 00:15:41,880
!تقنية التوسع الجزئي

189
00:15:43,170 --> 00:15:44,550
!كش ملك يا أسوما

190
00:15:44,800 --> 00:15:46,090
!الآن يا تشوجي

191
00:15:46,590 --> 00:15:47,800
!حسنًا

192
00:15:49,880 --> 00:15:51,420
!ماذا تفعل يا تشوجي؟

193
00:15:51,760 --> 00:15:53,010
!عد إلى رشدك

194
00:15:53,050 --> 00:15:54,460
!لقد جهّزنا أنفسنا لهذا

195
00:15:54,920 --> 00:15:55,920
!...تشوجي

196
00:15:56,510 --> 00:16:00,090
...هذا
!هذا كثيرٌ عليّ

197
00:16:00,130 --> 00:16:03,880
!لا يمكنني القضاء على السينسي

198
00:16:03,920 --> 00:16:04,760
!تشوجي

199
00:16:05,420 --> 00:16:06,380
!تحرّك

200
00:16:06,420 --> 00:16:07,260
!...تلك

201
00:16:08,050 --> 00:16:10,420
!أسلوب الرياح! تقنية عاصفة التراب

202
00:16:12,010 --> 00:16:13,010
!تبًّا

203
00:16:13,050 --> 00:16:14,090
!لقد صدّها

204
00:16:23,090 --> 00:16:24,010
!هل أنت بخير؟

205
00:16:24,010 --> 00:16:25,380
بالكاد

206
00:16:26,260 --> 00:16:30,380
!لماذا؟ لمَ يجب أن يكون الأمر هكذا؟

207
00:16:30,760 --> 00:16:32,340
!فات الأوان على النحيب

208
00:16:32,760 --> 00:16:35,340
!لقد اتّفقنا على إيقاف أسوما بأنفسنا

209
00:16:35,960 --> 00:16:38,090
ما بال تلك النظرة على وجهك يا تشوجي؟

210
00:16:38,170 --> 00:16:40,170
!أنا عدوّك الآن، بكلّ بساطة

211
00:16:40,210 --> 00:16:41,550
!كما أنني ميّتٌ فعلًا

212
00:16:41,760 --> 00:16:43,090
!فلا تتردّد

213
00:16:44,010 --> 00:16:47,510
...أعلم. أعلم ذلك، لكن

214
00:16:48,880 --> 00:16:50,880
...حتّى حينها يا سينسي، أنت

215
00:16:57,960 --> 00:16:59,420
ما الأمر يا تشوجي؟

216
00:16:59,460 --> 00:17:02,260
أتريد أن يعود ثلاثتكم إلى الأكاديمية؟

217
00:17:07,840 --> 00:17:09,010
أتساءل ما إن كان سيفعل ذلك

218
00:17:14,090 --> 00:17:17,170
!قاتل يا تشوجي، أيها الجبان

219
00:17:22,960 --> 00:17:25,420
.هذه ليست الطريقة الصائبة
ستعود بنتيجة سيئة وحسب

220
00:17:26,710 --> 00:17:28,880
ليس لأنّ تشوجي خائف

221
00:17:28,920 --> 00:17:33,920
إنّما لا يريد أن يؤذيَ أسوما-سينسي كما يتأذى هو الآن

222
00:17:35,050 --> 00:17:38,090
إنه لطيفٌ حتّى النخاع

223
00:17:38,590 --> 00:17:40,210
...لكن على هذا الحال

224
00:17:41,380 --> 00:17:43,300
لا خيار أمامنا

225
00:17:44,510 --> 00:17:47,800
!تشوجي! يكفي أيها البدين

226
00:17:50,590 --> 00:17:51,840
...شيكامارو

227
00:17:52,590 --> 00:17:54,880
هل قلت "بدين" للتو؟

228
00:17:55,090 --> 00:17:58,210
أجل... نعتك بالبدين

229
00:17:58,960 --> 00:18:00,590
هذا ما قاله أسوما-سينسي

230
00:18:02,920 --> 00:18:05,510
أحقًّا يا سينسي؟

231
00:18:06,050 --> 00:18:07,760
...أ-أجل

232
00:18:08,340 --> 00:18:13,420
!أجل! قال أنّ بدينًا مثلك ما كان ليستطيع لكمه

233
00:18:13,590 --> 00:18:15,550
إنّك تبالغين يا إينو

234
00:18:17,590 --> 00:18:19,340
لا أهتمّ إن كنتَ معلّمي

235
00:18:19,380 --> 00:18:23,840
!سأنال من أيّ أحدٍ ينعتني بالبدين

236
00:18:33,050 --> 00:18:33,960
...أنا آسف

237
00:18:35,590 --> 00:18:40,090
لا يمكنني أن أضربك في النهاية يا سينسي

238
00:18:43,090 --> 00:18:48,130
لكن... أرجعني فقط إلى الأكاديمية

239
00:18:48,170 --> 00:18:51,340
أرجوك لا تعاقب شيكامارو وإينو

240
00:18:59,550 --> 00:19:02,050
أفهم يا تشوجي

241
00:19:02,170 --> 00:19:03,630
إنها خسارتي

242
00:19:04,590 --> 00:19:06,590
،كيفما كنتَ غاضبًا

243
00:19:06,630 --> 00:19:10,170
فأنت تستطيع أن تقمع غضبك وتفكّر في خصمك

244
00:19:10,210 --> 00:19:12,420
إنّك تحظى بلطفٍ حقيقي

245
00:19:13,380 --> 00:19:16,210
وأريدك أن تستمر في رعاية ذلك اللّطف

246
00:19:16,670 --> 00:19:19,710
يومًا ما، سيصبح قوّتك

247
00:19:21,090 --> 00:19:23,880
...لكن، عندما تتبارز

248
00:19:23,960 --> 00:19:25,170
!أعلم

249
00:19:25,210 --> 00:19:27,920
لا أريد أن أضرب أشخاصًا مثلك أو شيكامارو

250
00:19:27,960 --> 00:19:29,960
أو إينو أو أصدقائي من القرية

251
00:19:30,010 --> 00:19:35,550
لكن إن كنتُ أواجه أيّ من يؤذيهم
فسوف أقاتله

252
00:19:36,050 --> 00:19:43,170
حتّى لو استمرّ شيكامارو وإينو بنعتي بالبدين

253
00:19:48,260 --> 00:19:52,920
بالمناسبة يا شيكامارو وإينو، تشوجي ليس بدينًا

254
00:19:53,920 --> 00:19:55,710
إنّما ممتلئٌ بشكلٍ مُرضٍ

255
00:20:06,590 --> 00:20:10,050
أسوما-سينسي، قلت أنّ لا بأس إن كنتُ هكذا

256
00:20:12,840 --> 00:20:14,670
!الآن يا تشوجي

257
00:20:15,670 --> 00:20:17,300
أعلم أنّك لطيف

258
00:20:18,340 --> 00:20:21,630
!لكن الآن، القضاء عليّ هو لطفٌ أيضًا

259
00:20:22,210 --> 00:20:25,920
!آن الوقت لتحوّل لطفك إلى قوة

260
00:20:26,210 --> 00:20:27,880
!آن الأوان يا تشوجي

261
00:20:28,670 --> 00:20:30,760
!أرجوك! يجب أن توقفني

262
00:20:36,300 --> 00:20:38,050
!يكفي أيها البدين

263
00:20:38,090 --> 00:20:39,420
!فقط حاول وأسقطني

264
00:20:42,130 --> 00:20:43,880
هل نعتّني بالبدين؟

265
00:20:45,210 --> 00:20:48,510
قلت بدين للتو، صحيح؟

266
00:20:52,170 --> 00:20:55,960
...أنا لستُ... أنا لستُ بدينًا

267
00:21:00,880 --> 00:21:04,090
!إنما ممتلئ بشكل مُرضٍ