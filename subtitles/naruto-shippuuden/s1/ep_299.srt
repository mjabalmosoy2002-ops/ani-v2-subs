1
00:00:23,160 --> 00:00:26,030
!ما هذه التقنيّة على أي حال؟

2
00:00:32,280 --> 00:00:35,780
...تقنيّة تجذب... وتقنيّة تدفع

3
00:00:36,700 --> 00:00:38,370
...تقنيّة استدعاء

4
00:00:38,910 --> 00:00:41,030
!تقنيّة تمتصّ النينجيتسو

5
00:00:42,030 --> 00:00:45,370
!لديك كلّ تقنيّات باين

6
00:00:47,570 --> 00:00:49,490
!لكن هذه التقنيّة... غير مألوفة لديّ

7
00:01:04,160 --> 00:01:06,160
!تذكّرت

8
00:01:06,200 --> 00:01:08,740
تأكّدتُ للتو أنّه يستطيع امتصاص النينجيتسو قبل دقيقة

9
00:01:08,780 --> 00:01:10,120
!يا لغبائي

10
00:01:10,120 --> 00:01:12,620
!ناغاتو! ما تلك التقنيّة بالضبط على أي حال؟

11
00:01:12,660 --> 00:01:14,200
!أخبرني

12
00:01:16,450 --> 00:01:17,530
!هذا سيّئ

13
00:01:17,570 --> 00:01:19,120
...إنّه خاضع للسيطرة تماماً

14
00:01:19,410 --> 00:01:21,120
!جيغوكودو

15
00:01:32,120 --> 00:01:33,450
...لحظة... هذه

16
00:01:34,240 --> 00:01:36,410
!إنّها تقنيّة الإحياء الخاصّة بباين

17
00:01:37,320 --> 00:01:39,450
!ما هي غايتك؟

18
00:01:45,570 --> 00:01:49,780
استخدم النينغيندو لانتزاع روحيهما واقتلهما

19
00:01:49,820 --> 00:01:53,030
...أخفِ جسديهما وروحيهما داخل جيغوكودو

20
00:01:53,370 --> 00:01:56,570
واجلبهما إليّ كي أتمكّن من إحيائهما

21
00:01:57,780 --> 00:02:03,280
أستطيع جعل الجينتشوريكي ملكي دون أن يكتشف مادارا

22
00:02:04,990 --> 00:02:08,700
والآن، ماذا يستطيع أن يفعل أيضاً؟

23
00:02:13,450 --> 00:02:17,070
تبّاً! لن تجيبني عن أي سؤال في نهاية
!المطاف إذاً؟

24
00:02:17,740 --> 00:02:21,780
كيف لتقنيّة الإحياء تلك أن تعمل مجدّداً؟

25
00:02:24,240 --> 00:02:27,450
!هذا الشيء... أشعر وكأنّ روحي تُنتزَع

26
00:02:28,120 --> 00:02:29,320
...وأفقد قوّتي

27
00:02:29,370 --> 00:02:31,240
!ينتابني إحساسٌ سيّئ حيال هذا الأمر

28
00:04:02,100 --> 00:04:07,230
المُعترَف به

29
00:04:29,010 --> 00:04:30,170
!شورادو

30
00:04:44,670 --> 00:04:46,720
ماذا استدعى؟ درعاً مُبهرَجاً؟

31
00:04:46,920 --> 00:04:47,970
!رجل الأخطبوط

32
00:04:53,760 --> 00:04:56,840
يستخدم أيادٍ كثيرة، ليغيّر وضعيّته وتكتيكاته الوفيرة

33
00:05:02,380 --> 00:05:05,220
!ناروتو، تذكّر عندما تصارعتَ مع الكيوبي

34
00:05:36,970 --> 00:05:38,130
!سوسانو

35
00:05:44,010 --> 00:05:45,010
!إيتاتشي

36
00:05:45,670 --> 00:05:48,380
!هذا هو سوسانو إذاً! يبدو فذّاً

37
00:06:09,170 --> 00:06:12,010
!أنقذتنا! شكراً يا إيتاتشي

38
00:06:12,260 --> 00:06:13,800
!أي نوع من النينجا هو؟

39
00:06:13,920 --> 00:06:18,470
كم هو قويّ! باكايارو، كونويارو

40
00:06:18,800 --> 00:06:20,720
،يُعرَف باسم باين

41
00:06:20,760 --> 00:06:22,670
ويمتلك قوّة الرّيكودو سينين

42
00:06:22,720 --> 00:06:24,170
!لذا من الطبيعي أن يكون قويّاً

43
00:06:24,510 --> 00:06:27,970
وهذه المرّة نحن نواجهه هو لا دُمى الجثّة خاصّته

44
00:06:28,170 --> 00:06:30,800
لذا مستوى قوّته وحركاته هائل جدّاً

45
00:06:33,630 --> 00:06:34,590
تذكّرت

46
00:06:35,220 --> 00:06:38,470
...ما زال بمقدورنا استخدام تقنيّة الكوكب لأسرهما

47
00:06:42,760 --> 00:06:44,220
الدّمار الكوكبيّ

48
00:06:44,720 --> 00:06:45,630
!ها هو ذا

49
00:07:11,760 --> 00:07:13,630
!ما هذا؟

50
00:07:13,630 --> 00:07:17,050
يبدو وكأنّ تِلك الكُرة السّوداء تمتلك
قوّة جذب خارقة

51
00:07:18,720 --> 00:07:21,260
!سبقَ ونالَ منّي بهذه التقنيّة

52
00:07:21,420 --> 00:07:23,550
!إنّها سيّئة للغاية، للغاية

53
00:07:23,590 --> 00:07:25,470
!إن طالَتْك فسينتهي أمرك

54
00:07:26,800 --> 00:07:27,880
...ناروتو

55
00:07:27,920 --> 00:07:28,760
!ماذا؟

56
00:07:29,510 --> 00:07:32,800
ناروتو، إن كانَتْ مُميتة فعلاً فكيف
ما زلتَ على قيدِ الحياة؟

57
00:07:38,840 --> 00:07:41,220
حسناً إذاً، لا حاجة للقلقِ بشأن انتصارنا

58
00:07:41,260 --> 00:07:43,260
!هذا ليس وقتاً ملائماً للضحك

59
00:07:43,300 --> 00:07:46,050
كيف يمكنك أن تكون مرتاحاً هكذا
!ونحن في ورطةٍ كهذه؟

60
00:07:47,800 --> 00:07:50,720
!إن علِقنا فيها فلن نتمكّن من الخروج

61
00:07:50,760 --> 00:07:52,590
!قوّتها الجاذِبة رهيبة

62
00:07:52,760 --> 00:07:56,340
...خرجتُ بفضلِ هيَجان الكيوبي فقط

63
00:07:56,380 --> 00:07:57,720
المسألة لا علاقة بالارتياح

64
00:07:58,420 --> 00:08:00,340
يتطلّب التّحليل هدوءاً

65
00:08:01,300 --> 00:08:03,760
يمكننا الافتراض بأنّ الكتلة
التي قذفَها ناغاتو قبل قليل

66
00:08:03,800 --> 00:08:05,630
هي مركز الجاذبيّة

67
00:08:06,720 --> 00:08:08,760
علينا تدميرها

68
00:08:09,630 --> 00:08:11,590
،سنُهاجم المركز في وقتٍ واحد

69
00:08:11,630 --> 00:08:14,220
سيستخدم كلّ منّا أقوى نينجيتسو
بعيدة المدى

70
00:08:21,380 --> 00:08:24,800
!لا يمكننا التّصويب بدقّةٍ في ظلّ هذه الظروف

71
00:08:24,840 --> 00:08:27,010
ستصطدم بها تقنيّتنا لا محالة حتّى
لو لم نصوِّب جيّداً

72
00:08:27,800 --> 00:08:32,720
فهذا التكتيك يستفيد من الجذبِ
القويّ للمركز

73
00:08:34,170 --> 00:08:38,170
!لكلّ تقنيّة نقطة ضعف

74
00:08:42,920 --> 00:08:43,800
حسناً

75
00:08:44,300 --> 00:08:45,260
!كان ذلك سريعاً

76
00:08:47,300 --> 00:08:48,880
!حسناً... أنا أيضاً

77
00:08:58,220 --> 00:08:59,590
!خرز ياساكا

78
00:08:59,670 --> 00:09:00,970
!قنبلة البيجو

79
00:09:01,760 --> 00:09:04,720
!أسلوب الرّياح، راسين شوريكين

80
00:10:00,630 --> 00:10:02,920
سامحني... يا إيتاتشي

81
00:10:03,840 --> 00:10:05,130
لقد عُدت

82
00:10:06,130 --> 00:10:07,340
...هذا هو نصلُ توتسوكا

83
00:10:22,720 --> 00:10:27,800
هل تعتقد أنّ هجمة كهذه ستوقفني؟

84
00:10:28,840 --> 00:10:32,720
!هذا السّيف... إنّه نصل توتسوكا

85
00:10:32,760 --> 00:10:36,050
إيتاتشي، كنتَ تخفي كلّ هذا معك

86
00:10:37,800 --> 00:10:39,470
ما ذلك السّيف؟

87
00:10:39,880 --> 00:10:46,130
إنّه نصل توتسوكا والمعروف أيضاً بنصل ساكيغاري

88
00:10:46,380 --> 00:10:53,220
يُنفي كلّ من يغرسُ فيه إلى عالمٍ
من الغينجيتسو الأبديّة

89
00:10:53,260 --> 00:10:56,630
النّصل بحدِّ ذاته مُشبَعٌ بتقنيّة ختم

90
00:10:56,670 --> 00:10:59,630
ويختلف عن نصل كوساناغي

91
00:11:02,130 --> 00:11:04,840
إنّه سيفٌ يمتلكُ تقنيّةَ ختم

92
00:11:05,720 --> 00:11:07,670
ستُنفَى بعيداً

93
00:11:07,720 --> 00:11:09,670
هل لديك كلمات أخيرة؟

94
00:11:15,050 --> 00:11:23,630
ناروتو، سأعود إلى حيثُ يوجد معلّمنا
وأراقب روايتك حتّى النّهاية

95
00:11:25,760 --> 00:11:30,720
إن سألتَني فأقول أنّك المجلّد الأخير من الثلاثيّة

96
00:11:31,920 --> 00:11:35,630
كان جيرايا المُجلّد الأوّل المثالي

97
00:11:37,260 --> 00:11:43,380
لكن كان المُجلّد الثّاني فاشلاً... أي أنا

98
00:11:45,300 --> 00:11:48,130
مُحال أن يعترف به معلّمنا

99
00:11:56,970 --> 00:12:03,420
ستبلغُ السلسلة ذروتها بالمجلّد الثّالث والأخير

100
00:12:05,630 --> 00:12:08,510
...يجب أن تجعله تحفة فنّية

101
00:12:08,550 --> 00:12:12,670
مجلّد يمحو تماماً آثار فشل المجلّد الأوسط يا ناروتو

102
00:12:49,510 --> 00:12:50,590
الوداع

103
00:13:21,620 --> 00:13:26,870
!ناغاتو الوغد... لم يكن مرِناً بما يكفي

104
00:13:27,290 --> 00:13:30,370
تأمّلتُ التّعويض عن قلّةِ مرونته
بالرّينيغان المُستدعاة

105
00:13:30,410 --> 00:13:33,160
التي ستمنحه نفس مجال الرّؤية

106
00:13:33,200 --> 00:13:36,410
لكن استطاعَ إيتاتشي استهدافها
بالكوناي خاصّته حتّى من نقاطه العمياء

107
00:13:36,410 --> 00:13:37,910
هذه هي تقنيّة الشوريكين التي يتمتّع بها

108
00:13:38,990 --> 00:13:41,040
حتّى ناغاتو لم يستطع تجنّبها

109
00:13:49,120 --> 00:13:52,620
لا أملك خياراً آخر سوى استخدام حركتي
الاحتياطيّة الخاصّة

110
00:14:02,790 --> 00:14:05,540
تقنيّة الإحياء هذه أو أيّاً كان اسمها كريهة

111
00:14:06,490 --> 00:14:08,910
يُجبَر النّاس على القتال رُغماً عن إرادتهم

112
00:14:09,660 --> 00:14:12,450
هذا يحدث في ساحاتِ القتال الأخرى أيضاً، صحيح؟

113
00:14:13,830 --> 00:14:15,870
سأضع حدّاً لتقنيّةِ الإحياء

114
00:14:16,450 --> 00:14:18,450
أترك مادارا عليكما

115
00:14:20,910 --> 00:14:24,580
قاتلنا نينجا تمّ إحياؤه في طريقنا إلى هنا

116
00:14:25,620 --> 00:14:28,580
...ختمَ عليه شينوبي الرّمل

117
00:14:28,910 --> 00:14:32,490
لكن يبدو أنّه لا يمكن قتله، مفهوم؟

118
00:14:33,080 --> 00:14:37,490
هذه تقنيّةٌ مثاليّةٌ خالية من أي نقاط ضعف، مفهوم؟

119
00:14:39,160 --> 00:14:40,660
سبقَ وقلتُ لكما

120
00:14:41,290 --> 00:14:44,700
لكلّ تقنيّة نقطة ضعف

121
00:14:45,080 --> 00:14:46,490
...أشكُّ في ذلك

122
00:14:48,490 --> 00:14:50,330
!لا، سأوقفه

123
00:14:50,660 --> 00:14:54,580
!كما قلت... اترك الباقي لي

124
00:14:54,950 --> 00:14:56,450
!تقنيّة النسخة الظلّية

125
00:15:04,040 --> 00:15:06,410
أفرطتَ في استخدام نمط تشاكرا الكيوبي

126
00:15:06,950 --> 00:15:09,160
!لا مزيد من النسخ الآن يا ناروتو

127
00:15:10,790 --> 00:15:12,790
لا تحاول القيام بكلّ شيء بمفردك

128
00:15:13,950 --> 00:15:17,410
أنا الأنسب لأضع حدّاً لتقنيّة الإحياء

129
00:15:18,200 --> 00:15:19,370
لديّ فكرة أيضاً

130
00:15:20,040 --> 00:15:22,870
...سأضع حدّاً لهذه الحرب

131
00:15:22,910 --> 00:15:24,790
!هذه مسؤوليّتي

132
00:15:31,490 --> 00:15:35,200
سأعترف بأنّك أقوى من السّابق

133
00:15:35,950 --> 00:15:37,870
،لكن بسببِ ذلك

134
00:15:37,910 --> 00:15:40,410
يبدو أنّك فقدتَ رؤية ما هو مهمّ حقّاً

135
00:15:42,450 --> 00:15:44,620
اسمعني جيّداً

136
00:15:45,660 --> 00:15:47,950
سكّان القرية الذين كانوا يبغضونك

137
00:15:47,990 --> 00:15:49,410
قد بدأوا يعجبون بك

138
00:15:50,200 --> 00:15:52,910
يعتبرونك زميلاً لهم

139
00:15:54,120 --> 00:15:59,410
هذا لأنّك قاتلتَ ببسالةٍ كي تنال قبولهم

140
00:16:03,410 --> 00:16:05,410
سبقَ وقلتَ أنّ كلّ من يهتمُّ بك

141
00:16:05,410 --> 00:16:07,370
قد ساعدَك في الوصولِ إلى ما أنتَ عليه الآن

142
00:16:09,370 --> 00:16:12,370
،إن نسيتَ الآخرين لحصولِك على القوّةِ الآن

143
00:16:12,410 --> 00:16:15,080
،وأصبحتَ متغطرساً وأنانيّاً

144
00:16:15,120 --> 00:16:18,830
فستغدو في النّهاية مثل مادارا تماماً

145
00:16:32,620 --> 00:16:34,410
،مهما أصبحتَ قويّاً

146
00:16:34,450 --> 00:16:36,450
لا تحاول تحمُّل أعباء كلّ شيء لوحدك

147
00:16:37,200 --> 00:16:39,450
فإن فعلت، ستفشلُ حتماً

148
00:16:41,080 --> 00:16:44,200
كان أبوك، ميناتو، قادراً على أداء
واجبه بصفته الهوكاغي

149
00:16:44,240 --> 00:16:47,870
بفضلِ وقوف أمّك، كوشينا، إلى جانبه
وكذلك رفاقه

150
00:16:52,120 --> 00:16:54,830
أنت تشاطر الحلمَ مع أبيك، أليس كذلك؟

151
00:16:56,120 --> 00:16:57,410
...إيّاك أن تنسى إذاً

152
00:16:59,080 --> 00:17:02,580
أن تصبح الهوكاغي لا يعني أن يعترف النّاس بك

153
00:17:03,200 --> 00:17:04,990
،لكن عندما يعترف النّاس بك

154
00:17:05,040 --> 00:17:06,410
يمكنك أن تصبح الهوكاغي

155
00:17:08,200 --> 00:17:09,540
!لا تنسَ أصدقاءك أبداً

156
00:18:43,540 --> 00:18:44,540
...ناروتو

157
00:18:45,790 --> 00:18:51,040
أقسمتُ لذلك الصّديق إيروكا
أنّني سأحميكَ

158
00:18:51,370 --> 00:18:56,580
!لن أدعك تذهب بمفردك يا صاح
لأنّني ما زلتُ حيّاً ومتلهّفٌ للرّباح

159
00:18:59,200 --> 00:19:00,660
!لا تتصرّف كطفل مُدلَّل

160
00:19:00,790 --> 00:19:05,580
...بالنسبة لي، أنت

161
00:19:06,830 --> 00:19:09,120
تلميذ مهمّ

162
00:19:09,450 --> 00:19:13,160
و... أعتبرك كأخي الصّغير

163
00:19:14,830 --> 00:19:18,240
قائد العدوّ يستهدفك بكل الوسائل المُتاحة

164
00:19:18,410 --> 00:19:22,870
فكيف لنا أن نسمح لك بمواجهة
خطرٍ كهذا؟

165
00:19:23,660 --> 00:19:27,540
وناهيك عن أنّه لا يوجد سببٌ يدفعك
لتحمُّل ذاك العبء وحدك

166
00:19:31,740 --> 00:19:33,700
معك حقّ. نسيت

167
00:19:33,740 --> 00:19:35,910
ظننتُ أنّه عليّ فعل ذلك بمفردي

168
00:19:46,620 --> 00:19:48,080
!لـ-لماذا؟

169
00:19:48,410 --> 00:19:51,490
لن تعمل عينُ شيسي لعقدٍ آخر أو ما قارب

170
00:19:52,490 --> 00:19:55,040
لن تتمكّن من استخدامها ضدّ ساسكي

171
00:19:55,490 --> 00:19:59,450
لكنّك تمتلك شيئاً أعظم بكثير من عينِ شيسي

172
00:20:00,950 --> 00:20:03,700
لديك نفس روح شيسي

173
00:20:04,490 --> 00:20:07,120
تِلك ما أراد شيسي توريثه حقّاً

174
00:20:08,580 --> 00:20:09,790
لم تعُد بحاجةٍ لعينه بعد الآن

175
00:20:10,160 --> 00:20:11,410
،بوضعِك الرّاهن

176
00:20:11,410 --> 00:20:14,490
يمكنُك إيقاف ساسكي من دون شيء كهذا

177
00:20:15,200 --> 00:20:17,910
