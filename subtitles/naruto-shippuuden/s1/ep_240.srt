1
00:00:05,690 --> 00:00:09,770
كالعادة، من يصل إلى هناك أوّلاً
!سيحصل على كلّ الحلوى

2
00:00:10,940 --> 00:00:14,530
.لا تقلق يا أكامارو، سأتقاسم معك حصّتي

3
00:00:14,530 --> 00:00:17,450
.ما الّذي تقوله؟ أنا هو من سيفوز

4
00:00:17,450 --> 00:00:19,950
!مستحيل، أنا من سيحصل على كلّ الحلوى

5
00:00:20,200 --> 00:00:22,500
تشوجي، هل ستشارك بالفعل؟

6
00:00:22,910 --> 00:00:25,000
.كلّنا يعلم أن كيبا سيفوز في النّهاية

7
00:00:25,120 --> 00:00:29,920
دع الأمر لي، فأنا لا أخسر عندما
.يتعلّق الأمر بالطّعام

8
00:00:30,460 --> 00:00:31,420
!شيكامارو

9
00:00:32,420 --> 00:00:34,380
.إذا كنتَ لن تشارك، فراقب لنا الوقت

10
00:00:36,050 --> 00:00:37,890
!يا لهذا الإزعاج

11
00:00:38,220 --> 00:00:40,350
!مهلاً لحظة

12
00:00:41,060 --> 00:00:44,140
!أنا أيضًا أقبل بهذا التّحدّي

13
00:00:46,480 --> 00:00:48,560
.لا فرصة أمامك للفوز

14
00:00:48,900 --> 00:00:50,190
!اذهب! اذهب

15
00:00:50,190 --> 00:00:52,230
.من السّهل هزيمة ناروتو

16
00:00:52,230 --> 00:00:54,900
.لكن في المقابل، سيكون لدينا كميّة حلوى أكبر

17
00:00:59,570 --> 00:01:00,620
.معك حقّ

18
00:01:00,620 --> 00:01:03,240
يستطيع الجميع المشاركة ما داموا
.سيقدّمون بعض الحلوى

19
00:01:03,700 --> 00:01:05,700
!بالطّبع! لدي القليل هنا

20
00:01:08,250 --> 00:01:10,380
!هذا أكثر ممّا أستطيع أكله

21
00:01:10,380 --> 00:01:12,040
!لا تتحدّث وكأنّك قد فزت بالفعل

22
00:01:12,040 --> 00:01:13,960
.النّتيجة معروفة من البداية، فأنت مجرّد خاسر

23
00:01:13,960 --> 00:01:18,130
حسنًا، سأسبقكم أنا لأعطيكم إشارة الانطلاق

24
00:01:18,130 --> 00:01:18,930
.أجل

25
00:01:18,930 --> 00:01:21,550
!أنا من سيصل أوّلاً

26
00:01:33,570 --> 00:01:34,980
.سيرسل الإشارة عمّا قريب

27
00:01:35,610 --> 00:01:37,240
!أروني أفضل ما لديكم

28
00:01:51,040 --> 00:01:52,250
!مرحى

29
00:01:54,710 --> 00:01:55,710
!جيّد

30
00:02:00,970 --> 00:02:02,550
!إنّه رقم قياسيّ جديد

31
00:02:04,600 --> 00:02:07,060
!حـ-حلواي

32
00:02:12,770 --> 00:02:14,980
.سحقًا! فاز كيبا مرّة أخرى

33
00:02:15,320 --> 00:02:18,190
.لكنّنا هزمنا ذلك الغبيّ

34
00:02:23,370 --> 00:02:25,910
!حلواي

35
00:02:25,910 --> 00:02:27,080
!حسنًا! مرّة أخرى

36
00:02:27,330 --> 00:02:29,290
!لنتسابق من جديد

37
00:02:29,830 --> 00:02:33,250
.غبيّ! تحدّاني بعد أن تُحطّم رقمي القياسيّ

38
00:02:37,800 --> 00:02:40,590
...سأكون الأوّل مهما تسابقنا

39
00:02:51,190 --> 00:02:52,310
.كنتُ أحلم

40
00:04:35,160 --> 00:04:37,790
!لا فطور للكسالى أمثالك

41
00:04:38,380 --> 00:04:40,290
!لمعلوماتك، هناك حرب على الأبواب

42
00:04:40,670 --> 00:04:43,170
!حرب؟ تستطيعين الاعتماد عليّ

43
00:04:43,590 --> 00:04:45,800
!سأسحقهم جميعًا بمفردي

44
00:04:45,800 --> 00:04:47,890
!غبيّ! يا لك من غبيّ

45
00:04:48,800 --> 00:04:50,550
.لا تأخذ أمر الحرب بهذا الاستخفاف

46
00:04:50,970 --> 00:04:54,980
زميلك ناروتو قد أصبح بطل
.القرية، لكن انظر لحالك أنت

47
00:04:54,980 --> 00:04:56,020
!أنت في حالة مزرية

48
00:04:56,020 --> 00:04:58,600
!حسنًا! سأذهب لكي أتدرّب

49
00:05:00,110 --> 00:05:02,110
لماذا قامت بفتح موضوع ناروتو ذاك؟

50
00:05:02,110 --> 00:05:03,980
!من المزعج سماع توبيخ كهذا باكرًا

51
00:05:04,240 --> 00:05:06,700
!هذا كلّه بفضل ناروتو، بطل قريتنا

52
00:05:06,700 --> 00:05:09,780
أجل! نحن على قيد الحياة
!والفضل لناروتو على ذلك

53
00:05:09,780 --> 00:05:12,580
لذلك دعونا نبذل ما بوسعنا
.لنعيد القرية لسابق عهدها

54
00:05:12,580 --> 00:05:13,660
!أجل

55
00:05:13,660 --> 00:05:15,500
.ما هذا الصّباح المزعج

56
00:05:16,710 --> 00:05:18,580
هذا ما تظنّه أنت أيضًا، صحيح يا أكامارو؟

57
00:05:21,130 --> 00:05:24,800
!ماذا؟ لا تقل أنّك في صف "البطل العتيد" أنت الآخر؟

58
00:05:25,920 --> 00:05:28,050
.سحقًا! هذا هو حالهم جميعًا

59
00:05:31,390 --> 00:05:33,970
...صحيح أنّه أنقذ القرية، لكن

60
00:05:45,360 --> 00:05:48,400
.عندما كنّا صغارًا، كان هو مجرّد فاشل

61
00:05:48,990 --> 00:05:50,200
هل تتحدّث عن ناروتو؟

62
00:05:51,780 --> 00:05:52,450
!شـ-شينو

63
00:05:54,830 --> 00:05:57,330
.ناروتو هو بطل القرية الآن

64
00:05:59,250 --> 00:06:00,540
.لكنّه كان مجرّد فاشل فيما مضى

65
00:06:01,380 --> 00:06:04,250
"ومن الّذي خسر أمام "الخاسر
في امتحان التشونين؟

66
00:06:04,250 --> 00:06:04,920
.أنت

67
00:06:06,960 --> 00:06:07,590
!فعلتُها

68
00:06:14,310 --> 00:06:17,350
لولا ضراطه ذاك لكنتُ
!أنا الفائز في ذلك النّزال

69
00:06:18,060 --> 00:06:19,850
.لا وجود لكلمة "لولا" في المعارك

70
00:06:20,560 --> 00:06:23,810
.والسّبب أنّك لا تستطيع تغيير الماضي

71
00:06:25,360 --> 00:06:27,860
.ها هو ذا ومنطقه الغبيّ ثانية

72
00:06:29,030 --> 00:06:30,110
...وأيضًا

73
00:06:31,660 --> 00:06:35,450
.تجاوزَنا ناروتو بمراحل كثيرة الآن

74
00:06:36,160 --> 00:06:38,910
!سأصل لمستواه وأكثر بكلّ تأكيد

75
00:06:39,540 --> 00:06:41,460
...بالطّبع، لكن

76
00:06:41,460 --> 00:06:43,880
!لن أسمح لناروتو بأن يتقدّم بينما أنا في الخلف

77
00:06:44,250 --> 00:06:46,710
.من المستحيل أن أبقى في الحضيض

78
00:06:48,010 --> 00:06:48,590
!أراك لاحقًا

79
00:06:52,340 --> 00:06:53,590
!غاتسوغا

80
00:06:57,470 --> 00:06:58,970
.سحقًا! ذلك لم ينفع

81
00:07:01,850 --> 00:07:06,650
ليس عليك إخباري بذلك، أعلم
.أنّي أملك القوّة اللاّزمة لذلك

82
00:07:06,650 --> 00:07:08,610
هل تتدرّب؟

83
00:07:09,360 --> 00:07:10,950
!أحسنت! أحسنت

84
00:07:15,450 --> 00:07:18,910
.ما الأمر؟ لا تبدو كعادتك

85
00:07:20,290 --> 00:07:23,080
.أريد أن أصبح أقوى

86
00:07:24,380 --> 00:07:26,090
.أقوى من ناروتو

87
00:07:26,880 --> 00:07:27,960
ناروتو؟

88
00:07:28,550 --> 00:07:31,800
.أنا أعرفه مذ كنّا أطفالاً

89
00:07:31,800 --> 00:07:33,970
.لا أريده أن يسبقني أبعد من هذا

90
00:07:34,800 --> 00:07:35,430
...كيبا

91
00:07:35,970 --> 00:07:39,390
!صحيح! أرجوك قم بتدريبي يا كاكاشي سينسي

92
00:07:40,430 --> 00:07:43,640
فكوريناي سينسي حُبلى وغاي سينسي
!ليس موجودًا في القرية

93
00:07:44,060 --> 00:07:47,150
!أنت من أستطيع الاعتماد عليه يا كاكاشي سينسي

94
00:07:50,280 --> 00:07:53,610
كما أنّك تعرف قوّة ناروتو أكثر
من أيّ أحد آخر، صحيح؟

95
00:07:54,530 --> 00:07:56,740
.بما أنّ الموضوع هكذا، فلا أرى أنّ لي خيارًا آخر

96
00:07:57,240 --> 00:07:57,910
!سينسي

97
00:07:58,200 --> 00:08:00,660
!سأساعدك

98
00:08:03,290 --> 00:08:04,620
!فنّ النّينجا: الاستدعاء

99
00:08:05,170 --> 00:08:06,880
!أسلوب الأرض: تقنيّة الأنياب المطارِدة

100
00:08:12,470 --> 00:08:17,140
.كنتُ أودّ المساعدة لكنّي مشغول بعض الشّيء

101
00:08:18,300 --> 00:08:21,680
!لذلك سأترك الأمر لهؤلاء الأصدقاء لينوبوا عنّي

102
00:08:21,770 --> 00:08:23,560
!لا تستطيع فعل هذا يا كاكاشي سينسي

103
00:08:24,850 --> 00:08:27,100
...هذا ليس تدريبًا! ليس مع هؤلاء

104
00:08:32,690 --> 00:08:35,070
أتريد أن تصبح أقوى من ناروتو؟

105
00:08:35,280 --> 00:08:36,490
وفي حالتك هذه؟

106
00:08:37,200 --> 00:08:39,780
!كفاك استخفافًا بي! أنا فقط لم أكن مستعدًا لذلك

107
00:08:39,780 --> 00:08:41,910
!سأجعلك تسحب كلماتك تلك

108
00:08:43,040 --> 00:08:45,710
.أنا أقوم بهذا لأن كاكاشي طلب من ذلك

109
00:08:46,540 --> 00:08:48,670
.لكن لا وقت لدينا لنضيّعه

110
00:08:49,000 --> 00:08:50,670
.فابذل جهدك معنا

111
00:08:50,670 --> 00:08:55,880
،لقد غادر كاكاشي سينسي بعذر سخيف
!لكنّي سأعيده إلى هنا في وقت وجيز

112
00:08:56,800 --> 00:09:00,850
أقنع نفسك بما تشاء، لكن افعل
.ذلك بعد أن تأخذ اللّفيفة منّي

113
00:09:01,560 --> 00:09:03,850
!يبدو هذا ممتعًا، سوف أنتهي منك حالاً

114
00:09:07,810 --> 00:09:10,150
!فنّ نينجا محاكاة البشر: نسخة الوحش البشريّة

115
00:09:11,230 --> 00:09:13,110
!تقنيّة القوائم الأربع

116
00:09:13,780 --> 00:09:16,610
.تندفع للهجوم بينما عليك تنسيق هجماتك

117
00:09:17,530 --> 00:09:18,570
!تشكيلة جناح طائر الكُركي

118
00:09:26,910 --> 00:09:29,630
.قلتَ أنّك تريد أن تصبح أقوى من ناروتو

119
00:09:29,630 --> 00:09:30,920
.لذلك أردت رؤية ما في جعبتك

120
00:09:31,500 --> 00:09:32,590
...لكن إن كان هذا كلّ شيء

121
00:09:34,000 --> 00:09:34,840
!سُحقًا لكم

122
00:09:35,460 --> 00:09:37,970
!لن أهتم لأمركم إذا ما تعرّضتم للأذى

123
00:09:37,970 --> 00:09:41,010
!كفاك صراخًا وأرنا ما لديك

124
00:09:43,510 --> 00:09:44,970
.سنهاجم بكامل قوّتنا هذه المرّة

125
00:09:49,520 --> 00:09:52,110
!فنّ نينجا محاكاة البشر: نسخة الوحش البشريّة

126
00:09:53,020 --> 00:09:54,940
!أسلوب التّايجيتسو السّرّيّ للرّجل الوحش

127
00:09:55,070 --> 00:09:56,240
!غاتسوغا

128
00:09:57,360 --> 00:09:57,820
!انتشروا

129
00:09:59,660 --> 00:10:00,780
!وكأني سأسمح لكم بالإفلات منّي

130
00:10:01,370 --> 00:10:02,580
!التّشكيلة الدّائريّة

131
00:10:04,870 --> 00:10:06,870
!أسلوب كلاب النّينجا السّرّيّ: رقصة الغبار

132
00:10:08,410 --> 00:10:12,750
،تستطيعون أن تتواروا عن مجال رؤيتنا
.لكن لا تستطيعون الهروب من حاسّة شمّنا

133
00:10:13,630 --> 00:10:14,710
!هناك

134
00:10:21,140 --> 00:10:24,140
.لقد سقط ضحيّة خدع بسيطة

135
00:10:24,140 --> 00:10:25,510
!سُحقًا

136
00:10:26,060 --> 00:10:29,310
على هذه الحال، لن تستطيع أبدًا
.تجاوز مستوى ناروتو

137
00:10:30,100 --> 00:10:32,560
.لا أمل يرجى منه

138
00:10:32,560 --> 00:10:35,400
.لقد خسر هدوءه حتّى قبل أن نبدأ في القتال

139
00:10:35,690 --> 00:10:38,780
.ولا يحاول أبدًا قياس قوّة خصمه

140
00:10:39,200 --> 00:10:43,030
ويهاجم قبل الأوان ممّا قد يعود
.عليه بعواقب وخيمة

141
00:10:44,700 --> 00:10:46,410
أنت! إلى أين أنت ذاهب؟

142
00:10:46,410 --> 00:10:48,000
!انسوا الأمر! انسوا الأمر

143
00:10:48,000 --> 00:10:50,160
!لا أستطيع القتال بجدّيّة ضدّ الكلاب

144
00:10:50,160 --> 00:10:51,250
إذًا ستهرب في المقابل؟

145
00:10:52,080 --> 00:10:55,460
!لقد طلبت من كاكاشي سينسي أن يدرّبني

146
00:10:55,460 --> 00:10:56,050
...وبدل ذلك

147
00:10:56,050 --> 00:10:58,880
.لقد قلتَ بنفسك أنّك ستنهي هذا بسرعة

148
00:10:58,880 --> 00:11:01,430
.كان على حقّ، فقد انتهى الأمر بسرعة

149
00:11:01,430 --> 00:11:02,840
.فقد خسر

150
00:11:05,720 --> 00:11:08,310
!اخرسا! القتال معكم دون فائدة، هذا كلّ شيء

151
00:11:09,600 --> 00:11:12,350
تدريب من هذا النّوع لا يستحقّ
.التّعرّض للأذى من أجله

152
00:11:12,900 --> 00:11:14,810
.لذلك أنت تهرب

153
00:11:14,810 --> 00:11:16,860
.إذا لم تكن مهتمًّا بالأمر، فارحل

154
00:11:16,860 --> 00:11:18,730
!أجل، هذا ما سأفعله

155
00:11:19,240 --> 00:11:21,530
!لنتدرّب بمفردنا يا أكامارو

156
00:11:26,450 --> 00:11:27,870
!لست أهرب

157
00:11:27,870 --> 00:11:30,290
!حتّى إن استمررت ُفي التّدريب، فلن أستفيد شيئًا

158
00:11:32,080 --> 00:11:34,580
مهلاً يا أكامارو! ماذا هناك...؟

159
00:11:34,580 --> 00:11:35,710
إلى أين تأخذني؟

160
00:11:36,840 --> 00:11:38,130
!مهلاً يا أكامارو

161
00:11:39,960 --> 00:11:42,050
!أكامارو! إلى أين أنت ذاهب؟

162
00:11:42,050 --> 00:11:44,260
!توقّف! قلت لك توقّف

163
00:11:47,680 --> 00:11:49,140
!هذا مؤلم

164
00:11:50,980 --> 00:11:51,770
...هذا

165
00:11:58,730 --> 00:12:02,950
.ناروتو؟ لم يستطع هزيمتي في النّهاية

166
00:12:04,360 --> 00:12:06,280
!مهلاً، انتظر يا أكامارو

167
00:12:08,030 --> 00:12:09,410
.أنا أعلم

168
00:12:09,410 --> 00:12:11,290
.كنتُ دائمًا في المقدّمة

169
00:12:15,830 --> 00:12:17,590
كيف لاسمه أن يكون...؟

170
00:12:20,000 --> 00:12:21,010
!كيبا

171
00:12:21,670 --> 00:12:23,880
هيناتا، ما الّذي...؟

172
00:12:24,250 --> 00:12:27,120
لقد كنت آتي إلى هنا لأتدرّب أحيانًا
.مذ كنّا في الأكاديميّة

173
00:12:28,080 --> 00:12:30,130
ذلك لأنّ ناروتو اعتاد على الرّكض
.إلى هنا طوال الوقت

174
00:12:30,750 --> 00:12:31,540
ناروتو؟

175
00:12:31,920 --> 00:12:32,590
.نعم

176
00:12:33,300 --> 00:12:38,510
وقتها، كان ناروتو مصمّمًا
.على كسر رقمك القياسيّ

177
00:12:48,440 --> 00:12:52,570
!سُحقًا! لن أنجح أبدًا في هذا

178
00:12:57,990 --> 00:12:59,360
ناروتو؟

179
00:13:06,040 --> 00:13:08,040
!لماذا لا أستطيع فعلها؟ سحقًا

180
00:13:09,420 --> 00:13:11,750
!سحقًا! كدت أنجح

181
00:13:16,050 --> 00:13:17,050
!سُحقًا

182
00:13:19,680 --> 00:13:22,050
!سُحقًا

183
00:13:25,890 --> 00:13:27,520
!سُحقًا

184
00:13:41,740 --> 00:13:43,370
!لقد نجحت

185
00:13:51,250 --> 00:13:53,330
!إنّه رقم قياسيّ جديد

186
00:13:56,750 --> 00:14:01,180
لقد ركض ناروتو كلّ يوم إلى أن
.حطّم في النّهاية الرّقم القياسيّ

187
00:14:02,430 --> 00:14:03,890
أليس هذا من شيم ناروتو؟

188
00:14:05,720 --> 00:14:08,310
أكنتَ تعرف هذا يا أكامارو؟

189
00:14:13,940 --> 00:14:16,980
!سُحقًا! لقد كان ذلك الغبيّ عنيدًا

190
00:14:18,820 --> 00:14:21,950
لماذا لا يستسلم ذلك الغبيّ؟

191
00:14:22,400 --> 00:14:25,160
.سحقًا، يا له من غبيّ

192
00:14:26,080 --> 00:14:30,540
!إن ذلك الغبيّ عنيد جدًّا
!غبيّ عنيد

193
00:14:35,710 --> 00:14:37,340
.آسف لجعلكم تنتظرون

194
00:14:39,420 --> 00:14:41,470
.ظننتُ أنّك قد هربت

195
00:14:41,970 --> 00:14:44,640
.أدركتُ أنّه عليّ التّخليّ عن فكرة الاستسلام

196
00:14:45,550 --> 00:14:46,390
!أكامارو

197
00:15:00,150 --> 00:15:02,190
.إذًا بدأت بفرض سيطرتك على ساحة المعركة

198
00:15:02,530 --> 00:15:07,580
لن أهاجم بدون تفكير وأعرّض
.نفسي للخطر بعد الآن

199
00:15:12,790 --> 00:15:16,420
.يبدو أنّك قد غيّرت رأيك

200
00:15:16,790 --> 00:15:19,880
يفترض بي أخذ تلك اللّفيفة
الّتي على ظهرك، صحيح؟

201
00:15:21,050 --> 00:15:23,800
.هذه المرّة، سأجعلك تسحب كلامك

202
00:15:26,840 --> 00:15:28,220
!هيا بنا يا أكامارو

203
00:15:30,720 --> 00:15:33,640
!فنّ نينجا محاكاة البشر: نسخة الوحش البشريّة

204
00:15:41,230 --> 00:15:42,400
!غاتسوغا

205
00:15:45,280 --> 00:15:45,950
!انتشروا

206
00:15:51,790 --> 00:15:53,080
!تشكيلة حاجز الكلاب

207
00:15:57,250 --> 00:15:57,750
!انتشروا

208
00:15:58,130 --> 00:15:59,420
!تفاداهم يا أكامارو

209
00:16:09,050 --> 00:16:09,470
!أكامارو

210
00:16:10,100 --> 00:16:11,140
!اجتمعوا

211
00:16:13,270 --> 00:16:15,020
!هل تأذّيتَ يا أكامارو؟

212
00:16:18,690 --> 00:16:21,570
.إذًا فأنت قادر على تجنّب الهجمات المباشرة

213
00:16:21,940 --> 00:16:24,780
حسنًا، هل تريد الانسحاب الآن؟

214
00:16:26,780 --> 00:16:29,070
...لقد أخبرتك أنّي تخلّيتُ

215
00:16:30,200 --> 00:16:31,740
!عن الاستسلام

216
00:16:32,910 --> 00:16:34,330
إذًا فقد تخلّيتَ عن ذلك؟

217
00:16:34,500 --> 00:16:35,910
.أجل، تخلّيتُ عن ذلك

218
00:16:36,540 --> 00:16:37,920
.فهمت

219
00:16:38,580 --> 00:16:40,500
.مهلاً! لم يكن ذلك قصدي

220
00:16:40,500 --> 00:16:42,170
.ما تخلّيتُ عنه هو الاستسلام

221
00:16:42,380 --> 00:16:44,710
!لذلك لن أتخلّى عن التّدريب معكم يا رفاق

222
00:16:45,010 --> 00:16:46,420
إذًا فأنت لم تستسلم؟

223
00:16:47,010 --> 00:16:48,380
!نعم، لم أستسلم

224
00:16:49,970 --> 00:16:50,850
...حتّى وإن

225
00:16:52,850 --> 00:16:55,310
...اضطررتُ لأكون

226
00:16:56,100 --> 00:16:57,020
تكون ماذا؟

227
00:17:04,190 --> 00:17:05,280
...أنا

228
00:17:08,280 --> 00:17:12,700
!سأصبح غبيًّا

229
00:17:14,030 --> 00:17:16,540
.أنت تبدو غبيًّا بالفعل

230
00:17:16,700 --> 00:17:18,540
...لا! أعني

231
00:17:19,040 --> 00:17:19,920
أنت غبيّ، صحيح؟

232
00:17:20,170 --> 00:17:23,290
.أجل... أعني لا. ذلك نوع مختلف من الغباء

233
00:17:23,290 --> 00:17:24,670
.الغبيّ غبيّ

234
00:17:24,670 --> 00:17:26,420
.لا، لم أعنِ ذلك

235
00:17:27,590 --> 00:17:29,380
ما الّذي تحاول أن تقوله؟

236
00:17:30,970 --> 00:17:33,930
!لهذا السّبب... يا إلهي

237
00:17:42,520 --> 00:17:44,860
.لن أسامحكم أبدًا يا رفاق

238
00:17:45,190 --> 00:17:49,780
!ماذا؟ ليس خطأنا أنّك غبيّ

239
00:17:49,780 --> 00:17:51,200
!اخرس

240
00:17:51,660 --> 00:17:53,030
!أسلوب عشيرة إينوزوكا

241
00:17:53,030 --> 00:17:54,740
أسلوب عشيرة إينوزوكا: تحوّل رجل-وحش المشترك

242
00:17:57,620 --> 00:17:58,160
انتشروا

243
00:17:59,660 --> 00:18:00,410
!هيّا بنا

244
00:18:00,410 --> 00:18:01,830
!غاروغا

245
00:18:07,670 --> 00:18:09,010
.يبدو منفعلاً بعض الشّيء

246
00:18:09,380 --> 00:18:12,720
لقد بدأ يفكّر، فهكذا يتجنّب
.التسبّب بإصابة زملائه

247
00:18:13,590 --> 00:18:16,680
.ومع ذلك، لا أعتقد أنّ هذا التّغيّر سينفع

248
00:18:18,720 --> 00:18:19,930
!رقصة الغبار

249
00:18:25,900 --> 00:18:26,980
.ليس مجدّدًا

250
00:18:27,780 --> 00:18:29,320
!لا بأس يا أكامارو

251
00:18:30,190 --> 00:18:33,110
!"أنا أعرف ساحة القتال جيّدًا بسبب "التّمييز الفعّال

252
00:18:39,330 --> 00:18:41,620
!أسلوب كلاب النّينجا السّرّيّ: نسخ الكلاب

253
00:18:42,080 --> 00:18:43,170
!سنضرب ضربتنا الآن

254
00:18:46,710 --> 00:18:49,000
.لا تستطيع معرفة أين هو الحقيقيّ

255
00:18:49,210 --> 00:18:49,960
!سُحقًا

256
00:18:58,140 --> 00:18:58,970
!وجدتها

257
00:18:59,350 --> 00:19:02,940
!"لقد قال "أين هو" ولم يقل "أيُّنا

258
00:19:03,940 --> 00:19:04,850
...هذا يعني

259
00:19:05,860 --> 00:19:08,190
!أنّ الحقيقيّ ليس هنا

260
00:19:13,070 --> 00:19:14,660
!اهدأ يا أكامارو

261
00:19:14,660 --> 00:19:16,530
!اهدأ! اهدأ

262
00:19:17,240 --> 00:19:19,990
.لا فائدة من ذلك، من الأفضل لك أن تستسلم

263
00:19:20,290 --> 00:19:23,710
!اخرس! لقد قلتُ لك أنّي لن أستسلم

264
00:19:26,170 --> 00:19:27,420
.صحيح

265
00:19:28,000 --> 00:19:29,710
!سأبقى هادئًا، سأبقى هادئًا

266
00:19:30,800 --> 00:19:32,010
.سأبقى هادئًا

267
00:19:32,800 --> 00:19:38,220
بفضل أنفينا، سنستطيع أنا وأكامارو
!أن نشتمّ حتّى أخفّ الرّوائح وسنجده

268
00:19:43,230 --> 00:19:44,100
!إنّه هناك

269
00:19:54,200 --> 00:19:56,530
.لقد نلتَ منّي يا كيبا

270
00:19:57,620 --> 00:20:00,160
.أنا أسحب كلّ كلمة قلتها عنك

271
00:20:03,910 --> 00:20:06,500
!إذًا فقد نال منك يا باكون؟

272
00:20:06,870 --> 00:20:08,170
.لقد هُزمت

273
00:20:09,460 --> 00:20:11,630
!أحسنتَ يا كبيا

274
00:20:15,720 --> 00:20:17,550
!شكرًا لك يا كاكاشي سينسي

275
00:20:19,090 --> 00:20:20,600
.لا داعي للشّكر

276
00:20:21,430 --> 00:20:24,100
.فلم أقم بأيّ شيء لأستحقّه

277
00:20:26,940 --> 00:20:29,860
!لن نستسلم أبدًا! أبدًا

278
00:20:30,690 --> 00:20:32,690
...إن رفضنا الاستسلام، فلربّما يومًا ما

279
00:20:37,610 --> 00:20:39,620
ما الأمر يا غوروكو؟

280
00:20:40,200 --> 00:20:42,870
...لقد قال في وقت سابق

281
00:20:43,290 --> 00:20:46,580
!سأصبح غبيًّا

282
00:20:47,580 --> 00:20:50,750
لعلّه كان يقصد أنّه يريد أن يصبح كناروتو؟

283
00:20:53,920 --> 00:20:55,920
.ما كان ليقول ذلك أبدًا

284
00:20:58,430 --> 00:20:59,680
...أعني حتّى كبيا

285
00:21:00,180 --> 00:21:01,680
.لديه عزّة نفس