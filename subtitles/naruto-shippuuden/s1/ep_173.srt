1
00:00:44,670 --> 00:00:46,070
!لم أنتهِ بعد

2
00:00:46,100 --> 00:00:47,170
!أنا هنا

3
00:01:05,790 --> 00:01:11,620
قادَنا القدرُ إلى سانين قرية الورق مُباشرة

4
00:01:13,760 --> 00:01:15,000
ماذا تريد؟

5
00:01:17,300 --> 00:01:19,530
عثرنا عليه أخيراً

6
00:01:20,330 --> 00:01:22,100
وجدنا جيرايا سينسي

7
00:01:32,910 --> 00:01:34,350
!تبّاً! أعداء؟

8
00:01:34,520 --> 00:01:36,050
!اهربا حالاً

9
00:01:36,220 --> 00:01:37,750
!ناغاتو، اذهب

10
00:01:43,850 --> 00:01:48,700
لكن لم أستطع تقبُّل نينجا من قرية الورق

11
00:01:51,400 --> 00:01:55,040
وأنا متأكّدٌ أنّك تعرف السبب

12
00:03:34,510 --> 00:03:36,670
علّمونا النينجيتسو

13
00:03:36,940 --> 00:03:39,170
كلّكم نينجا من قرية الورق، أليس كذلك؟

14
00:03:40,070 --> 00:03:43,580
شكراً لكم، هذه لكم

15
00:03:44,180 --> 00:03:46,580
هل نقتلُ هؤلاء الأطفال؟

16
00:03:47,650 --> 00:03:48,650
!ماذا؟

17
00:03:48,720 --> 00:03:52,820
رأيتُ الكثير من يتامى الحرب، هذا مثيرٌ للشفقة

18
00:03:53,590 --> 00:03:55,690
سيكون حالهم أفضل

19
00:03:55,730 --> 00:03:57,830
إذا خلّصناهم من مأساتهم الآن

20
00:03:57,860 --> 00:03:59,290
!أوروتشيمارو، يكفي

21
00:04:00,090 --> 00:04:02,690
اسبقني مع تسونادي

22
00:04:02,730 --> 00:04:05,700
سأبقى هنا وأعتني بهم لبعضِ الوقت

23
00:04:06,070 --> 00:04:07,070
!ماذا؟

24
00:04:07,670 --> 00:04:09,970
هذا أقل ما يمكنني فعله

25
00:04:12,200 --> 00:04:15,480
قُتِلَ والدايّ على يدِ نينجا من قرية الورق

26
00:04:17,310 --> 00:04:19,150
!شكراً على الطعام -
!شكراً على الطعام -

27
00:04:19,580 --> 00:04:20,810
سمك مشويّ فوريّ

28
00:04:20,810 --> 00:04:22,610
بتقنيّةِ أسلوب النّار خاصّتي -
لكن بدا جيرايا سينسي -

29
00:04:22,610 --> 00:04:24,820
مختلفاً عنهم قليلاً

30
00:04:25,160 --> 00:04:27,990
!سينسي! بدأتُ أتعلّم صيد السمك

31
00:04:28,060 --> 00:04:30,990
حقّاً؟ تزدادُ تألّقاً شيئاً فشيئاً

32
00:04:35,100 --> 00:04:38,430
بدأنا نحن الأربعة نعيشُ معاً

33
00:04:39,200 --> 00:04:41,830
وبعد فترة ليسَتْ بطويلة، وقعَتْ حادِثة

34
00:04:42,770 --> 00:04:43,840
حادِثة؟

35
00:04:46,540 --> 00:04:47,480
!ياهيكو

36
00:04:47,740 --> 00:04:52,980
هاجمنا نينجا عابر وكاد يقتلُ ياهيكو

37
00:04:53,450 --> 00:04:56,550
حينها رددتُ وقتلتُ ذلك
النينجا بدلاً من أن يفعل هو

38
00:05:06,660 --> 00:05:09,800
وقتلتُه... دون شعور

39
00:05:13,910 --> 00:05:15,740
!هل أنت بخير يا ياهيكو؟

40
00:05:19,440 --> 00:05:22,970
يبدو أنّني أمتلك قوّةً خاصّة

41
00:05:24,220 --> 00:05:26,380
التقنيّة البصريّة التي تُعرَف باسم رنّيغان

42
00:05:29,320 --> 00:05:34,090
نتيجة ذلك، جيرايا سينسي والذي كان متردّداً
،حيال تدريبنا

43
00:05:34,130 --> 00:05:36,890
بدأ بتعليمنا النينجيتسو

44
00:05:37,690 --> 00:05:41,590
قال أنّه سيعلّمنا كي نحمي أنفسنا

45
00:05:41,660 --> 00:05:43,540
،لكن باعتقادي في حالتي أنا

46
00:05:43,600 --> 00:05:47,400
فعلَ ذلك كي أتمكّن من التحكُّم بقوّةِ الرنّيغان

47
00:05:49,570 --> 00:05:53,000
لكنّني كنتُ خائفاً من قوّتي

48
00:05:53,270 --> 00:05:56,380
جعلَني الكرهُ أندفعُ هائجاً

49
00:05:56,410 --> 00:06:01,050
اعتقدتُ أنّ ما فعلتُه كان خاطئاً
وباتَ تأنيبُ الضميرُ يُلازمني

50
00:06:03,050 --> 00:06:07,320
لكن سحبَني سينسي من الأعماق

51
00:06:08,290 --> 00:06:09,820
بشأن الحادثة؟

52
00:06:16,270 --> 00:06:17,600
...في ذلك اليوم

53
00:06:17,930 --> 00:06:22,900
عندما أذى ذلك الرّجلُ ياهيكو، غضبتُ منه كثيراً

54
00:06:24,480 --> 00:06:26,340
لم أعد أرى شيئاً أمامي

55
00:06:27,010 --> 00:06:28,240
لم أشعر بما كنتُ أفعله

56
00:06:30,110 --> 00:06:33,690
ثمّ رأيتُ الرجل ميّتاً دون أن أدرك

57
00:06:39,950 --> 00:06:42,790
بعد ذلك، شعرتُ بالذعر

58
00:06:43,530 --> 00:06:47,500
جعلَتْني هذه الكراهيّة أفقدُ
وعيي... وقتلتُ شخصاً

59
00:06:48,430 --> 00:06:50,560
!ما فعلتُه كان خاطئاً

60
00:06:51,330 --> 00:06:53,640
كانَ لا بُدَّ من وجودِ طريقةٍ أفضل

61
00:06:53,670 --> 00:06:54,810
!ناغاتو

62
00:06:56,640 --> 00:07:00,640
لا أعلم حقّاً فيما إذا كان ما فعلته صواباً أم خطأ

63
00:07:01,370 --> 00:07:05,350
لكن نجا ياهيكو بفضلِك

64
00:07:05,720 --> 00:07:07,480
حميتَ صديقك

65
00:07:08,650 --> 00:07:11,950
لا بدَّ وأنّه كان الفعل الصّواب

66
00:07:13,560 --> 00:07:16,460
ولا أحد يستطيعُ أن يلومك على ذلك

67
00:07:18,830 --> 00:07:22,540
سُرعان ما وجدتُ نفسي أتقبّلُ المُعلّم

68
00:07:25,040 --> 00:07:27,700
عندما تتألّم، تتعلّم أن تكره

69
00:07:28,670 --> 00:07:30,900
من النّاحية الأخرى، عندما
تؤذي شخصاً، تُصبِح مكروهاً

70
00:07:30,940 --> 00:07:33,210
لكنّك تبدأ بالشعورِ بالذنب كذلك

71
00:07:33,910 --> 00:07:41,050
لكن معرِفة مثل هذا الألم يجعلُك
لطيفاً مع الآخرين

72
00:07:41,950 --> 00:07:45,390
معرِفة الألم تُساهمُ في نموّنا ونضوجنا

73
00:07:47,220 --> 00:07:49,820
والنموّ يعني القدرة على التفكير

74
00:07:49,860 --> 00:07:51,990
واتّخاذ قراراتنا بأنفسنا

75
00:07:53,000 --> 00:07:58,100
أن نُبصِر ونتفكّر في الألم، أن نتوصّل لإجابةٍ تخصُّنا

76
00:08:04,680 --> 00:08:08,540
بدا لي وكأنّ جيرايا سينسي
يطرحُ ذات السُّؤال على نفسه

77
00:08:10,040 --> 00:08:13,120
حتّى هو لم يعثر على إجابةٍ أيضاً

78
00:08:14,290 --> 00:08:17,750
مثلما لم تعثر عليها أنت

79
00:08:19,950 --> 00:08:23,530
كنتُ آنذاك قادراً على التوصُّلِ إلى إجابة
بشكلٍ فوريّ

80
00:08:24,930 --> 00:08:27,330
أردتُ حماية ذلكما الاثنين فحسب

81
00:08:29,360 --> 00:08:32,340
أيّاً كانت طبيعة الألم التي عليّ تحمّلها

82
00:08:33,610 --> 00:08:34,570
هكذا إذاً

83
00:08:35,610 --> 00:08:41,110
ما الذي تتأمّله دوماً يا سينسي؟

84
00:08:41,910 --> 00:08:43,980
هذا العالمُ مليءٌ بالحروب

85
00:08:44,720 --> 00:08:50,750
،ليسَ فيه إلّا الكراهيّة
أريدُ أن أفعلَ شيئاً حيال الأمر

86
00:08:52,790 --> 00:08:57,960
وأن أعرف ما هي الإجابة على السُّؤال
عن السَّلامِ الحقيقيّ

87
00:09:03,470 --> 00:09:05,070
مضَتْ ثلاث سنوات

88
00:09:05,870 --> 00:09:09,600
شعرتُ أنّني زدتُ قوّةً من الناحيّة
الجسديّة والعقليّة من خلال التدريب

89
00:09:11,400 --> 00:09:15,050
لكن ظلَّتْ كلمات جيرايا سينسي تراودُني على الدّوام

90
00:09:15,080 --> 00:09:16,780
من أعماقِ كياني

91
00:09:18,950 --> 00:09:25,160
أخبرني سينسي أنّ الإجابة قد تكون
كامِنة في الرنّيغان خاصّتي

92
00:09:28,560 --> 00:09:32,670
النّاس يتحاربون دوماً منذُ زمن بعيد

93
00:09:32,700 --> 00:09:37,630
لم تنتهِ الحروب أبداً، كان
عصراً أسوأ بكثير من عصرنا هذا

94
00:09:39,300 --> 00:09:42,940
في عصرٍ كهذا، ظهرَ راهبٌ وللمرّة الأولى

95
00:09:43,680 --> 00:09:49,040
وعظَ بحقيقةِ التشاكرا وحاول
تحقيق السّلام في العالم

96
00:09:50,480 --> 00:09:53,450
قيلَ أنّه سافرَ إلى كلّ أنحاء
العالم لينشر تعاليمه

97
00:09:53,490 --> 00:09:54,950
التي أطلقَ عليها اسم نينشو

98
00:09:56,350 --> 00:10:00,550
مضى الزمن واشتهرَت النينشو باسم نينجيتسو

99
00:10:01,920 --> 00:10:04,430
لم تكن النينجيتسو أصلاً تعني قوّة السّلاح

100
00:10:04,460 --> 00:10:07,900
إنّها تعاليم تهدي النّاس إلى السّلام

101
00:10:08,660 --> 00:10:11,700
كان يُعرَفُ هذا الرّاهب بالريكودو سينين

102
00:10:11,730 --> 00:10:14,540
واعتُبِرَ مُنقِذ هذا العالم

103
00:10:15,310 --> 00:10:18,610
يمتلك الرنّيغان مثلك

104
00:10:21,210 --> 00:10:24,250
"نحنُ من نصنع السّلام والنظام"

105
00:10:24,750 --> 00:10:27,080
هذه هي كلماتُ الرّاهب

106
00:10:28,020 --> 00:10:30,580
لا بدّ وأنَّه آمن بأنّ

107
00:10:30,620 --> 00:10:34,090
الحقبة التي يفهمُ الناسُ
بعضهم الآخر ستأتي لا محالة

108
00:10:35,560 --> 00:10:40,730
قد تكون أنت... تقمُّص ذلك الرَّاهب

109
00:10:41,930 --> 00:10:44,470
ينتابُني إحساسٌ بأنّ عينيك هاتين

110
00:10:44,500 --> 00:10:46,670
قد اِئتُمِنتا بآمال ذلك الرّاهب

111
00:10:49,740 --> 00:10:52,250
ائتمنَني المعلّم بمهمّةِ البحث عن السّلام

112
00:10:52,280 --> 00:10:56,510
ومن ثمّ تركَنا بمفردنا

113
00:11:00,650 --> 00:11:04,220
بدأنا بالتحرُّك تحت قيادةِ ياهيكو

114
00:11:05,020 --> 00:11:07,660
سُرعان ما اكتسبَتْ منظّمتُنا الشهرة

115
00:11:09,690 --> 00:11:16,170
أيّدَ النّاسُ جهودنا لصنع السّلام دون اللّجوء للقوّة

116
00:11:18,170 --> 00:11:20,300
لكن كان العالمُ في حالةِ حرب

117
00:11:20,330 --> 00:11:24,880
حرب الدُّول العظيمة الثّلاث بين قرى
الحجر والورق والرّمل

118
00:11:25,980 --> 00:11:28,180
سمِعَ هانزو، زعيم قرية المطر

119
00:11:28,210 --> 00:11:31,540
بإشاعاتٍ عن منظّمتِنا فتقرّبَ منّا

120
00:11:33,120 --> 00:11:36,120
لم يعُد بالإمكانِ تجاهلنا بعد الآن

121
00:11:37,320 --> 00:11:40,750
أرادَ استخدامنا كمِحور لمُفاوضات السّلام

122
00:11:40,790 --> 00:11:43,560
مع الدُّول العظيمة الثّلاث

123
00:11:44,030 --> 00:11:46,630
اتّفقنا على استخدامِ قوّتنا لضمانِ مُعاهدة سلام

124
00:11:46,660 --> 00:11:48,860
بين الدُّول الثلاث

125
00:11:51,430 --> 00:11:54,410
اتّفقنا على التعاونِ معه في تطبيقِ اقتراحه

126
00:11:56,940 --> 00:12:00,910
لكن كانَتْ تِلك بِداية لكلّ مآسينا

127
00:12:01,670 --> 00:12:03,680
كنّا أطفالاً سُذّجاً

128
00:12:04,820 --> 00:12:06,080
مآسيكم؟

129
00:12:06,920 --> 00:12:08,780
ماذا حدث؟

130
00:12:11,880 --> 00:12:15,230
بسببِ ذلك، توفِّي ياهيكو

131
00:12:17,090 --> 00:12:18,090
!توفّي؟

132
00:12:21,700 --> 00:12:24,510
كان كلّه فخّاً نصبَه هانزو

133
00:12:25,080 --> 00:12:26,810
اشتبهَ بأنّنا

134
00:12:26,850 --> 00:12:29,450
سننتزعُ منه سلطته على قرية المطر

135
00:12:31,410 --> 00:12:33,860
...لذلك السّبب وحده، ياهيكو قد

136
00:12:38,260 --> 00:12:39,560
،في اليوم التالي

137
00:12:42,490 --> 00:12:46,200
وكان أتباع هانزو وفريق أنبو العمليات
السوداء التابع لقرية الورق هُناك آنِفاً

138
00:12:47,570 --> 00:12:50,830
كان هانزو قد خطّطَ مع رجلٍ
يُدعى دانزو من قرية الورق

139
00:12:50,870 --> 00:12:52,830
للقضاءِ علينا

140
00:12:54,010 --> 00:12:57,410
تحالفَ دانزو مع هانزو
للاستيلاء على منصبِ الهوكاغي

141
00:12:57,440 --> 00:13:01,340
وتحالفَ هانزو مع دانزو لحمايةِ سلطته ونفوذه

142
00:13:03,380 --> 00:13:06,820
منظّمتكم مصدرُ إزعاجٍ لنا

143
00:13:07,690 --> 00:13:09,190
...ياهيكو

144
00:13:09,990 --> 00:13:13,390
أنتَ القائدُ لِذا لا بدَّ أن تموت

145
00:13:13,760 --> 00:13:17,000
وإن قاومتَ فستموتُ هذه المرأة

146
00:13:23,300 --> 00:13:25,310
أنت! يا ذا الشّعر الأحمر

147
00:13:25,610 --> 00:13:28,010
استخدم هذا لقتلِ ياهيكو

148
00:13:28,510 --> 00:13:31,640
حينئذ سأعفو عنك أنتَ والمرأة

149
00:13:31,910 --> 00:13:33,210
!لا تفعلْ يا ناغاتو

150
00:13:33,240 --> 00:13:34,420
!لا تهتمّا لأمري

151
00:13:34,550 --> 00:13:36,280
!اهربا أنتُما

152
00:13:37,280 --> 00:13:38,380
ناغاتو

153
00:13:41,750 --> 00:13:42,820
اقتلْني

154
00:13:45,360 --> 00:13:48,430
كلّ ما أريده هو حِماية ذلكما الاثنين

155
00:13:49,160 --> 00:13:52,190
أيّاً كانت طبيعة الألم التي عليّ تحمّلها

156
00:13:57,000 --> 00:13:58,000
!ناغاتو

157
00:13:58,300 --> 00:13:59,400
!لا

158
00:13:59,670 --> 00:14:00,940
أسرِع

159
00:14:01,000 --> 00:14:03,300
!أم أنّك تريدُ لهذه المرأة أن تُقتَل؟

160
00:14:33,680 --> 00:14:34,610
...كونان

161
00:14:38,040 --> 00:14:39,010
!-ياهي

162
00:14:51,850 --> 00:14:56,030
يجبُ أن تنجو أنت وكونان... مهما كلّفَ الأمر

163
00:14:58,300 --> 00:15:02,330
أنت... مُنقِذ... هذا العالم

164
00:15:03,060 --> 00:15:04,370
...أعلمُ

165
00:15:06,670 --> 00:15:08,340
أنّك تستطيعُ... أن تنجح

166
00:15:11,810 --> 00:15:14,020
!ياهيكو

167
00:15:16,320 --> 00:15:18,720
لديّ حلم كبير

168
00:15:30,690 --> 00:15:31,830
!اقتلوهم

169
00:15:35,400 --> 00:15:37,800
...إذا لم تتوقّف الحرب

170
00:15:38,670 --> 00:15:41,300
!فسأصبح إله هذا العالم

171
00:15:45,750 --> 00:15:46,880
!عكسَها

172
00:15:47,210 --> 00:15:48,350
!كيف؟

173
00:16:12,870 --> 00:16:14,040
هل نلنا منه؟

174
00:16:25,550 --> 00:16:26,790
...ناغاتو

175
00:16:26,920 --> 00:16:29,820
كونان، تمسّكي بياهيكو ولا تتحرّكي

176
00:16:30,550 --> 00:16:31,990
!أحسنتَ يا فتى

177
00:16:32,250 --> 00:16:35,630
أفلتَّ رُغم إصابتك بتقنيّة أسلوب النّار خاصّتي

178
00:16:40,500 --> 00:16:43,810
لستَ فتى عاديّاً

179
00:16:43,840 --> 00:16:44,870
...تلكما العينان

180
00:16:46,340 --> 00:16:47,340
!اقضوا عليه

181
00:16:48,210 --> 00:16:49,370
!تقنيّة الاستدعاء

182
00:16:49,770 --> 00:16:51,270
!تُمثال غيدو

183
00:16:58,320 --> 00:16:59,180
...هذا

184
00:17:10,430 --> 00:17:12,190
!ما... هذا؟

185
00:17:12,630 --> 00:17:14,970
!لا يا ناغاتو... لا تستخدم هذا

186
00:18:02,880 --> 00:18:04,520
!سنموتُ إذا لمسنا هذا

187
00:18:19,230 --> 00:18:22,500
كنتَ القائد وراء الكواليس إذاً

188
00:18:23,360 --> 00:18:27,210
من المُفاجئ حقّاً أن تمتلك الرنّيغان

189
00:18:31,940 --> 00:18:33,040
...ناغاتو

190
00:18:36,580 --> 00:18:38,050
!تقنيّة الانتقال النُّقَطيّ

191
00:19:12,210 --> 00:19:14,220
...مات ياهيكو

192
00:19:14,860 --> 00:19:18,690
ومنذُ ذلك الحين، تولّيتُ منصبَ قائد منظّمتنا

193
00:19:22,460 --> 00:19:24,330
ظننتُ أنّني كنتُ قد نضجت

194
00:19:24,370 --> 00:19:26,000
لكن لم يتغيّر شيء على الإطلاق

195
00:19:27,430 --> 00:19:30,370
حدثَ ما حدثَ تماماً بوفاةِ والديّ

196
00:19:31,870 --> 00:19:33,910
كنتُ مخطئاً

197
00:19:34,340 --> 00:19:36,810
أدركتُ أنّ الإجابة التي كنتُ قد توصّلتُ إليها

198
00:19:36,840 --> 00:19:38,680
لم تكن سوى مجرّد هُراء

199
00:19:42,510 --> 00:19:45,920
أنا مدينٌ له بحياتي، كان حلمي

200
00:19:46,750 --> 00:19:51,050
كان صديقي الذي لا بديل له وكنتُ مستعدّاً
لأن أفديه بروحي بكلّ سرور

201
00:19:51,790 --> 00:19:53,320
...وفاة ياهيكو

202
00:19:55,400 --> 00:19:58,000
ذاك كان ألمي الثّاني