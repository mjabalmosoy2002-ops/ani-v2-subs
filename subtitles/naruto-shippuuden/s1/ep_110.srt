1
00:00:05,210 --> 00:00:08,340
!ما-ما هذا؟! تقنيّة العدوّ؟

2
00:00:08,470 --> 00:00:10,560
!بـ-بزّاقة...؟

3
00:00:11,190 --> 00:00:13,630
!إنّها كاتسويو، مُستدعاة بواسطة تسونادي-ساما

4
00:00:13,930 --> 00:00:15,160
أنا آسفة -
سامحيني -

5
00:00:15,490 --> 00:00:16,560
لماذا أتيتِ إلى هنا؟

6
00:00:17,030 --> 00:00:19,470
هل أتيتِ لمساعدتِنا يا كاتسويو؟

7
00:00:20,810 --> 00:00:24,180
كانت تسونادي-ساما قلِقة بشأن

8
00:00:24,210 --> 00:00:28,280
فعاليّة تقنيّة الختم ضدّ البيجو

9
00:00:29,360 --> 00:00:33,970
أرسلَتْني لمدّكن بالتشاكرا المطلوبة لتقنيّة الختم

10
00:00:34,530 --> 00:00:35,530
هذا سينفعنا كثيراً

11
00:00:36,200 --> 00:00:38,810
سأوزّعها عليكن

12
00:00:39,280 --> 00:00:40,280
امضي من فضلك

13
00:00:40,890 --> 00:00:41,890
...حسناً

14
00:00:56,470 --> 00:00:57,770
!تسونادي تلك

15
00:00:58,170 --> 00:01:00,360
...أرسلَتْ كاتسويو

16
00:01:00,530 --> 00:01:02,030
!تبّاً... المزيد

17
00:01:02,130 --> 00:01:04,190
!المزيد من القوّة يا يوكيمارو

18
00:01:22,700 --> 00:01:23,700
!ناروتو

19
00:01:25,270 --> 00:01:26,430
ما الأمر

20
00:01:29,440 --> 00:01:30,690
هل سيُغفَر لي...؟

21
00:01:31,950 --> 00:01:34,190
أعني! هل سيُسامحني؟

22
00:01:35,890 --> 00:01:42,210
عندما يكتشف يوكيمارو أنّني قاتِلة والدته؟

23
00:01:42,470 --> 00:01:45,910
تبّاً! أما زلتِ تفكّرين بذلك؟

24
00:01:47,010 --> 00:01:50,180
أنا مستعدّةٌ لحمايةِ يوكيمارو

25
00:01:50,730 --> 00:01:52,790
!لو كنتُ مكانكِ لظللتُ أفكّر به

26
00:01:54,890 --> 00:01:59,070
حتّى لو كُرِهت أو رُفِضت... أو مُقِتّ

27
00:01:59,970 --> 00:02:05,080
...سواء أكان يعتقد أنّني المكان الذي يعودُ إليه أو لا

28
00:02:05,110 --> 00:02:08,610
لا علاقة لذلك بالأمر! سأظلُّ أفكِّر فيه

29
00:02:10,700 --> 00:02:11,700
!نعم، معك حقّ

30
00:02:12,070 --> 00:02:16,170
سأصبح حمقاء أيضاً... مثلك تماماً يا ناروتو

31
00:02:16,230 --> 00:02:17,630
!ماذا؟

32
00:02:19,810 --> 00:02:20,820
!لنسرع

33
00:02:27,420 --> 00:02:28,420
!يوكيمارو

34
00:02:35,710 --> 00:02:38,270
أحسُّ بقوّةِ السّانبي تحت سطح الماء

35
00:02:38,610 --> 00:02:42,260
إ-إنّها هائلة... أشعر وكأنَّ التشاكرا ستنفجر في أي لحظة

36
00:02:42,530 --> 00:02:43,830
هـ-هذا القدر؟

37
00:02:44,130 --> 00:02:47,590
...لولا تشاكرا كاتسويو، لما كانت قوّتها وحدها

38
00:02:47,860 --> 00:02:49,740
اسمعن! إذا وقعَ السّانبي

39
00:02:49,770 --> 00:02:53,310
...في قبضةِ أوروتشيمارو أو الأكاتسكي

40
00:02:53,780 --> 00:02:56,380
...فستحلُّ كارثة على قرية الورق المخفيّة

41
00:02:59,160 --> 00:03:02,630
...لكن السّانبي في قبضتِنا الآن

42
00:03:03,430 --> 00:03:09,010
الوحيدون القادرون على حمايةِ زملائنا في قريةِ الورق

43
00:03:09,040 --> 00:03:10,240
!من هذه القوّة هُم نحن

44
00:03:10,920 --> 00:03:11,920
!حاضرة -
!حاضرة -

45
00:03:12,690 --> 00:03:16,820
كاتسويو... أيمكنكِ تعزيز التشاكرا خاصّتكِ أكثر؟

46
00:03:17,220 --> 00:03:19,030
نعم... سأحاول

47
00:03:19,700 --> 00:03:22,670
سننقلها كلّها دفعة واحِدة إلى البُعد الآخر

48
00:03:22,970 --> 00:03:24,010
حـ-حاضرة

49
00:03:41,550 --> 00:03:45,950
ما زلنَ يُحاولن التحكُّم بالسّانبي

50
00:03:50,530 --> 00:03:55,330
!يوكيمارو، استنهض روحَ السّانبي! اجعله يثور

51
00:03:55,670 --> 00:03:59,210
!اسحق الورق المخفيّة

52
00:05:33,290 --> 00:05:37,430
ذكرى الذنب

53
00:05:37,840 --> 00:05:39,850
ساي، هل هاجموك أيضاً

54
00:05:40,260 --> 00:05:41,260
...أجل

55
00:05:41,630 --> 00:05:43,630
!أخذوا يوكيمارو

56
00:05:46,730 --> 00:05:47,730
هذا...؟

57
00:05:48,560 --> 00:05:51,050
!لا شكّ في ذلك! إنّهم هم

58
00:05:51,720 --> 00:05:52,980
!انتظر

59
00:05:54,350 --> 00:05:58,250
!ما-ماذا تفعلين؟! حان وقتُ الانتقام

60
00:05:58,480 --> 00:06:01,770
إن دخلنا الآن فمن المُحتمَل أن نضرب
بعضنا الآخر دون انتباه

61
00:06:02,070 --> 00:06:06,040
نعم، حتّى حاسّة شمّ أكامارو ستكون عقيمة

62
00:06:08,440 --> 00:06:10,890
يجبُ أن ننتظر ونرى

63
00:06:11,390 --> 00:06:14,360
!تبّاً! هذا مُحبِطٌ للغاية

64
00:06:24,310 --> 00:06:28,640
يبدو أنَّ العدوّ يستخدم يوكيمارو للتحكُّم بالسّانبي

65
00:06:32,230 --> 00:06:35,260
على هذه الحال، سيقعُ فريقُ الختم الذي تقوده
شيزوني في خطر

66
00:06:37,600 --> 00:06:39,130
...إنّه وضعٌ حسّاس

67
00:06:40,580 --> 00:06:44,750
!التصدِّي لكلّ هذه النسخ أمر مستحيل

68
00:06:54,500 --> 00:06:55,570
!هذا سيّئ

69
00:06:55,800 --> 00:06:56,800
!لا أستطيع مُراوغتها كلّها

70
00:07:10,610 --> 00:07:12,040
...حان الوقت

71
00:07:13,540 --> 00:07:14,640
!سجن الدُّخان المقيِّد

72
00:07:26,360 --> 00:07:29,160
لا أصدِّق أنّنى أحظى شخصيّاً بفرصة هزيمة

73
00:07:29,200 --> 00:07:32,380
كاكاشي الأسطوري من قريةِ الورق المخفيّة

74
00:07:34,380 --> 00:07:36,920
...يستحقُّ الأمر النجاة

75
00:07:38,450 --> 00:07:39,460
!ماذا؟

76
00:07:41,240 --> 00:07:45,040
أستطيع استخدام نسخ ظلّية أيضاً لكن ليسَ بمُستواك

77
00:07:46,570 --> 00:07:47,570
!نصل البرق

78
00:07:51,390 --> 00:07:52,390
هذا سيّئ

79
00:08:02,610 --> 00:08:06,310
يُقال بأنّ الأغبياء والدُّخان يحبُّون الأماكن العالية

80
00:08:07,810 --> 00:08:09,690
!تنّين الدُّخان

81
00:08:14,130 --> 00:08:15,800
عنصر الخشب ضعيفٌ أمام الدُّخان

82
00:08:15,830 --> 00:08:17,000
الذي يغيِّرُ شكله بنفسه

83
00:08:17,500 --> 00:08:20,680
...إذاً يجبُ أن أكيِّفَ عنصري

84
00:08:21,380 --> 00:08:23,250
!عنصر الماء! يد الأمواج

85
00:08:29,150 --> 00:08:30,170
ماذا؟

86
00:08:33,340 --> 00:08:36,370
...الدُّخان هو بُخار وبتمييعه مع الماء

87
00:08:36,400 --> 00:08:40,260
لا يمكن التحكُّم به بحرّية. خاصّة ضدّي أنا
وعنصر الماء الذي يخصُّني

88
00:08:40,610 --> 00:08:42,540
باتت تقنيّتك عديمة الجدوى الآن

89
00:08:49,930 --> 00:08:51,000
!خذ هذه

90
00:09:00,950 --> 00:09:03,750
لا تنسَ أنّ لديّ ذِراع ثالثة

91
00:09:19,720 --> 00:09:21,390
انتهى وقتُ اللّعب

92
00:09:27,730 --> 00:09:28,800
!لا جدوى

93
00:09:29,840 --> 00:09:31,180
!تشكيل المِغزَل

94
00:09:36,010 --> 00:09:37,920
!لماذا... لماذا؟

95
00:09:38,350 --> 00:09:42,630
كانت تقنيّتك قويّة أمام حشراتي

96
00:09:43,100 --> 00:09:47,270
لكن يكمن سبب هزيمتك في حقيقة
أنّك قاتلتَ

97
00:09:47,310 --> 00:09:50,050
...هيناتا من عشيرةِ هيوغا. لأوضّح لك ذلك

98
00:09:52,620 --> 00:09:54,520
هيناتا، أودُّ أن أتكلّم معكِ

99
00:09:55,920 --> 00:09:57,460
شينو، ما الأمر؟

100
00:09:58,230 --> 00:09:59,870
أريدُ أن أعرف ولو قليلاً

101
00:10:00,400 --> 00:10:04,440
هلّا مددتِني بأي معلومة عن مُستخدمة عنصر البلّور تلك؟

102
00:10:06,040 --> 00:10:09,320
مع الأسف، تقنيّتها لا تشوبها شائبة

103
00:10:10,190 --> 00:10:14,320
لو لم أغطِّ كامل جسدي بالتشاكرا
...في الوقتِ المناسب... لكنتُ الآن

104
00:10:15,920 --> 00:10:17,400
...على ذكرِ التشاكرا التي تغطِّي كامل الجسم

105
00:10:17,630 --> 00:10:20,910
!شينو، احذر من ذلك الرّجل الوحليّ

106
00:10:21,540 --> 00:10:23,610
سيكون خصماً عتيداً ضدّك

107
00:10:24,380 --> 00:10:25,410
لماذا؟

108
00:10:26,210 --> 00:10:28,090
تقنيّته هي كامل جسده

109
00:10:28,590 --> 00:10:32,100
جسده مليء بالتشاكرا

110
00:10:32,130 --> 00:10:34,500
ويستطيع تغيير شكله كيفما يشاء

111
00:10:35,460 --> 00:10:39,980
استخدمتُ قبضتي الرّقيقة ضدّه فالتوى
جسدُه فحسب

112
00:10:40,650 --> 00:10:42,980
...تصدّى لقبضتكِ الرّقيقة

113
00:10:43,520 --> 00:10:48,060
كانت المُشكلة سائل الجسم الذي دخلَ
إلى يدي عندما مسَسْتُه

114
00:10:48,860 --> 00:10:53,400
جسم العدوّ مغطَّى بمادّة رُغاميّة
تُشبه الدّابوق

115
00:10:56,440 --> 00:10:58,510
...كنتُ قد حصلتُ على معلومات، لذا من البداية

116
00:10:58,880 --> 00:11:04,820
ركّزتُ على إزالةِ تلك المادّة الرُّغامية
المُزعجة عن جسدك

117
00:11:05,360 --> 00:11:07,300
!منذُ بدأنا...؟

118
00:11:07,530 --> 00:11:13,180
نعم! ركّزتُ بهجماتي على ذلك
الغشاء الرُّغامي لأجعله

119
00:11:13,210 --> 00:11:18,620
رقيقاً قدر المُستطاع وذلك كي يتمزّق بسهولة

120
00:11:20,400 --> 00:11:21,500
هذا كُل ما في الأمر

121
00:11:36,330 --> 00:11:37,330
انتهى الأمر...؟

122
00:11:37,490 --> 00:11:38,490
أجل

123
00:11:38,930 --> 00:11:40,190
...استغرقنا بعضاً من الوقت لكن

124
00:11:41,640 --> 00:11:42,900
!كاكاشي سينسي

125
00:11:45,250 --> 00:11:46,250
...جميعكم بخير

126
00:11:46,780 --> 00:11:48,510
ماذا عنكم؟

127
00:11:49,080 --> 00:11:53,120
في الواقع... نجونا بأعجوبة. لكن ماذا عن ناروتو؟

128
00:11:53,620 --> 00:11:54,800
لم نجده بعد

129
00:11:55,400 --> 00:11:57,000
...آسف بشأن يوكيمارو

130
00:12:00,510 --> 00:12:04,350
حسناً إذاً، سننطلق لمُساعدةِ فريق الختم

131
00:12:04,820 --> 00:12:06,220
!حاضر -
!حاضر

132
00:12:07,190 --> 00:12:10,700
وأيضاً سنستعيدُ يوكيمارو ونحميه

133
00:12:11,630 --> 00:12:13,730
لكن سنرى أوّلاً مدى تقدُّم فريق الختم

134
00:12:14,740 --> 00:12:16,570
...يبدو أنّهن يخضن معركةً صعبة

135
00:12:43,520 --> 00:12:45,470
...هذه المرّة بالتأكيد... السّانبي

136
00:12:45,630 --> 00:12:47,530
إينو... لا داعي للعجلة

137
00:12:47,970 --> 00:12:51,240
ركّزي ذهنيّاً على تثبيتِ التشاكرا خاصّتكِ

138
00:12:51,510 --> 00:12:52,680
...حـ-حاضرة

139
00:13:01,230 --> 00:13:04,540
هذا سيّئ... هذا لا يكفي

140
00:13:11,250 --> 00:13:13,450
!تبّاً! لن ينجح الأمر هكذا

141
00:13:13,680 --> 00:13:16,230
!أهذه هي قوّة يوكيمارو؟

142
00:13:19,900 --> 00:13:22,050
لن يعطي هذا مفعوله بعد الآن

143
00:13:28,760 --> 00:13:33,830
إذاً أنا مضطرٌّ لاتّخاذ الإجراء الأخير
...والذي لم أرغب باللّجوءِ إليه

144
00:13:37,540 --> 00:13:40,320
ستموتُ لأجلِ أوروتشيمارو-ساما

145
00:13:43,420 --> 00:13:44,490
!خذ

146
00:13:50,270 --> 00:13:51,270
!يوكيمارو

147
00:13:52,170 --> 00:13:53,170
هل أنت بخير؟

148
00:13:53,510 --> 00:13:56,440
...كنتُم على قيدِ الحياة إذاً

149
00:13:56,870 --> 00:13:59,350
استفق! ماذا حدث؟

150
00:14:03,530 --> 00:14:06,830
!يوكيمارو! استيقظ

151
00:14:07,130 --> 00:14:08,240
!يوكيمارو

152
00:14:22,100 --> 00:14:30,110
...عدتِ إذاً... يا غورين، لأنّني كنتُ أفكِّرُ بكِ

153
00:14:31,250 --> 00:14:35,720
...حيثما يُفكِّرُ بك شخص، فذلك هو المكان الذي تعود إليه

154
00:14:35,990 --> 00:14:38,700
نعم... هذا صحيح

155
00:14:40,100 --> 00:14:43,940
كنتَ تفكِّرُ بي، لهذا استطعتُ العودة

156
00:14:44,440 --> 00:14:45,440
...أجل

157
00:14:45,840 --> 00:14:47,750
عندما علِقتُ في ذلك البُعد الآخر

158
00:14:47,780 --> 00:14:52,060
...داخل السّانبي، كان كلّ ما فكّرتُ به هو أنت

159
00:14:52,760 --> 00:14:57,190
...لهذا عليك أن تعود إليّ أيضاً يا يوكيمارو

160
00:14:57,800 --> 00:15:03,010
...تغمرني السّعادة. أنا أعودُ إليكِ يا غورين

161
00:15:04,050 --> 00:15:08,160
أنتِ الوحيدة التي أستطيع العودة إليها

162
00:15:13,370 --> 00:15:18,880
...أشكّ في أنّ هذا هو المكان الوحيد المتبقّي لك

163
00:15:19,410 --> 00:15:23,390
لأنّك لم تعد قادراً على المُسارعة
عائداً إلى صدرِ أمّك بعد الآن

164
00:15:25,650 --> 00:15:28,000
توقّف! اصمت فحسب

165
00:15:28,360 --> 00:15:30,640
...لا، دعني أقول ذلك

166
00:15:31,270 --> 00:15:33,210
!اسمع يا يوكيمارو

167
00:15:36,140 --> 00:15:38,020
!قلتُ لك اصمت

168
00:15:39,480 --> 00:15:41,460
...لا بأس يا ناروتو

169
00:15:42,590 --> 00:15:43,590
...لكن

170
00:15:43,990 --> 00:15:47,570
...لا مُشكلة! فأنتَ من علّمني

171
00:15:48,740 --> 00:15:49,740
...غورين

172
00:15:54,110 --> 00:15:55,450
هل أنت مستعدّ؟

173
00:15:55,770 --> 00:15:59,180
!يا له من موقف مشرّف. اسمع يا يوكيمارو

174
00:16:02,220 --> 00:16:05,160
...من سرقَ المكان الذي ينبغي أن تعود إليه

175
00:16:05,420 --> 00:16:08,370
من حوّلَ الكاميليا البيضاء إلى حمراء

176
00:16:08,400 --> 00:16:10,300
......بدماءِ أمِّك الأحمر

177
00:16:19,190 --> 00:16:22,500
...من قتلَ أمّك هي تلك المرأة

178
00:16:23,600 --> 00:16:24,800
!غورين

179
00:16:26,500 --> 00:16:28,670
!غورين هي شيطانةٌ شرّيرة

180
00:16:29,370 --> 00:16:31,650
،أخفَتْ حقيقة قتلها لوالدتك

181
00:16:31,680 --> 00:16:34,820
وتقرّبَتْ منك لتكسب ثِقتك فقط لاستغلالك

182
00:16:34,850 --> 00:16:36,920
!واستمرَّتْ في استغلالِك

183
00:16:43,370 --> 00:16:47,780
يوكيمارو! ألا تكرهها؟! ألا تريد قتلها؟

184
00:16:48,250 --> 00:16:51,050
لن يُوقفك أحد... ولا حتّى أنا

185
00:16:51,620 --> 00:16:54,790
!والآن صبّ جام غضبك على السّانبي

186
00:16:55,160 --> 00:16:59,730
!ومُره بتدمير كلّ شيء

187
00:17:00,230 --> 00:17:01,740
أيّها الوغد

188
00:17:03,940 --> 00:17:04,940
!اصمت

189
00:17:14,500 --> 00:17:15,500
...غورين

190
00:17:16,060 --> 00:17:20,610
أنا آسفة... يا يوكيمارو، ما يقوله صحيح

191
00:17:21,010 --> 00:17:22,350
اسمعني أرجوك يا يوكيمارو

192
00:17:22,950 --> 00:17:25,220
ارتكبَتْ غورين في الماضي العديد من الخطايا الفظيعة

193
00:17:25,250 --> 00:17:29,430
!كي تخدمَ أوروتشيمارو. لكن تغيّرت غورين الآن

194
00:17:30,030 --> 00:17:32,870
إنّها نادمة على كلّ ما فعلَتْه في الماضي

195
00:17:32,900 --> 00:17:36,240
!وهي ستحميك مهما حدث

196
00:17:36,670 --> 00:17:37,950
،مهما كان حجم كرهك لها

197
00:17:37,980 --> 00:17:41,290
ستظلُّ تفكِّرُ بك. فقد أقسمَتْ لي بذلك

198
00:17:44,820 --> 00:17:47,390
،أدرك تماماً أنّني مهما ندمتُ على ذلك

199
00:17:47,430 --> 00:17:49,730
وأنّني مهما اعتذرتُ وتأسّفت

200
00:17:49,770 --> 00:17:52,210
لا شيء سيمحو ما فعلتُه

201
00:17:54,710 --> 00:17:58,250
إن أردتَني ميّتة فاقتلني، لا يهمّني

202
00:17:59,050 --> 00:18:02,100
...لكن... لكن إذا استطعتَ مُسامحتي

203
00:18:02,860 --> 00:18:05,460
فسأحميك للأبد

204
00:18:12,680 --> 00:18:13,880
...غورين

205
00:18:24,170 --> 00:18:27,370
لن تكرهني؟

206
00:18:28,310 --> 00:18:30,950
...أنت لطيفةٌ جدّاً يا غورين

207
00:18:31,590 --> 00:18:36,090
...أنتِ من ينبغي أن أعود إليها في نهاية المطاف

208
00:18:36,990 --> 00:18:40,900
وأنا من ينبغي أن تعودي إليه يا غورين

209
00:18:43,980 --> 00:18:44,810
...أعدُك

210
00:18:44,840 --> 00:18:49,920
أنّني لن أتركك أبداً وسأظلُّ أفكِّرُ بك

211
00:18:50,420 --> 00:18:55,700
أجل... وأنا سأظلُّ أفكّرُ بكِ يا غورين

212
00:18:56,330 --> 00:18:58,040
...الآن وللأبد

213
00:19:01,720 --> 00:19:04,120
وسأظلُّ... أحبُّك

214
00:19:05,750 --> 00:19:06,750
نعم، وأنا أيضاً

215
00:19:14,340 --> 00:19:15,370
...أنتما

216
00:19:15,770 --> 00:19:18,580
!لا تفترقا مجدّداً

217
00:19:20,810 --> 00:19:25,420
...يا لها من مهزلة
...يمكنكم أنتم الضّعفاء لعق جراح بعضكم البعض

218
00:19:26,260 --> 00:19:29,170
!لكن سينقطع مثل هذا الرّابط بسهولة

219
00:19:32,840 --> 00:19:33,840
!ماذا؟

220
00:19:51,380 --> 00:19:53,650
!كابوتو! أنت

221
00:19:54,050 --> 00:19:55,120
...ناروتو

222
00:19:56,320 --> 00:19:57,350
،إن اعترضتَ طريقي

223
00:19:58,530 --> 00:19:59,830
سأقتلك أيضاً

224
00:20:00,290 --> 00:20:03,940
!كابوتو! هل أنت من يقِف وراء كلّ ما حدث؟

225
00:20:04,500 --> 00:20:05,800
!لن تفلت بفعلتِك