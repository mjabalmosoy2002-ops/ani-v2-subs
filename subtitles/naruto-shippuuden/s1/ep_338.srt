1
00:00:09,640 --> 00:00:11,930
هذا يُسهّل استخدام الغينجيتسو البصريّة
الحقيقيّة خاصّتي عليه

2
00:00:11,980 --> 00:00:14,680
بإبقائه حبيساً في حلقةٍ صغيرةٍ كهذه

3
00:00:15,770 --> 00:00:19,590
علِقَ كابوتو في حلقتِك الآن إذاً؟

4
00:00:20,590 --> 00:00:22,170
وهذه هي الإيزانامي؟

5
00:00:24,260 --> 00:00:25,260
متى استخدمتَها؟

6
00:00:26,880 --> 00:00:30,080
في أوّل مرّة طعنني فيها كابوتو بذاك السّيف

7
00:00:36,210 --> 00:00:37,500
آنذاك؟

8
00:00:38,950 --> 00:00:40,280
لكن كيف؟

9
00:00:41,110 --> 00:00:44,990
ذكرتَ أنّ التقنيّة البصريّة ممكنة بلا بصر

10
00:00:46,240 --> 00:00:48,810
كيف لتقنيّة بصريّة أن تنجح من دون بصر؟

11
00:00:49,230 --> 00:00:52,140
إيزانامي هي تقنيّة بصريّة تعمل بحواسك

12
00:00:52,190 --> 00:00:54,980
وحواس خصمك الجسديّة

13
00:00:56,100 --> 00:00:58,050
الحواس الجسديّة لشخصين؟

14
00:01:00,130 --> 00:01:03,300
بينما تقاتل خصمك، تقوم بتسجيل صورة

15
00:01:03,340 --> 00:01:07,090
للحواس الجسديّة الخاصّة بك وبخصمك

16
00:01:07,130 --> 00:01:09,330
التي تشعران بها أثناء لحظة
التّسجيل، بواسطة تقنيّتك البصريّة

17
00:01:09,960 --> 00:01:11,670
سنطلق عليها أ

18
00:01:13,210 --> 00:01:14,920
،مع مرور الوقت

19
00:01:14,960 --> 00:01:17,120
،تجد أنّ "ب" هي لحظة أكثر أهمّية

20
00:01:17,170 --> 00:01:20,490
ومن ثمّ تسجّل "ج" وهكذا بعين الشارينغان

21
00:01:21,910 --> 00:01:24,200
ثمَّ تُعيد إنشاء هذه الحواس الجسديّة ذاتها

22
00:01:24,240 --> 00:01:28,980
بمعنى أنّك تستخدم قواك لإنشاء
نسخة طبق الأصل عن أ

23
00:01:29,020 --> 00:01:30,770
'لنطلق على هذه أ

24
00:01:31,310 --> 00:01:34,770
مجرى الزمن
،'بمُراكبة وربط أ بـ أ

25
00:01:34,770 --> 00:01:38,140
مجرى الزمن
'تفتح الإيزانامي أيضاً طريقاً لـ ب' و ج

26
00:01:38,140 --> 00:01:40,840
مجرى الزمن
لخلق تقلّبات ضمن زمن ثابت

27
00:01:41,680 --> 00:01:44,340
بعبارة أخرى، إنّها قوّة خلق حلقة لا متناهية

28
00:01:45,220 --> 00:01:48,040
وبالطبع، كلّ ذلك مقابل بصر المرء

29
00:01:48,500 --> 00:01:50,130
تماماً مثل إيزاناغي

30
00:01:51,460 --> 00:01:54,210
إذاً وعي كابوتو عالق في الدّاخل

31
00:01:54,250 --> 00:01:59,320
يقاتل طيفك وطيفي للأبد

32
00:02:00,120 --> 00:02:01,160
لا

33
00:02:01,740 --> 00:02:05,530
هنالك طريق هرب نُصِّب داخل التقنيّة

34
00:02:06,320 --> 00:02:09,400
طُوّرت الإيزانامي لتعاقب

35
00:02:09,440 --> 00:02:12,110
وتنقذ مستخدمَ إيزاناغي

36
00:02:13,190 --> 00:02:14,480
ماذا يعني هذا؟

37
00:02:15,020 --> 00:02:17,810
قلّما تعرف عن الإيزاناغي أساساً

38
00:02:19,180 --> 00:02:21,850
تُدعى بتقنيّة أوتشيها البصريّة التامّة

39
00:02:21,890 --> 00:02:23,390
المخصّصة لتغيير القدر

40
00:02:24,930 --> 00:02:27,470
،إن لم يسرِ شيء كما تريده أن يسري

41
00:02:27,510 --> 00:02:30,170
فيمكنك أن تمحو تلك النتيجة وتبدأ من جديد فحسب

42
00:02:30,750 --> 00:02:33,540
في نهاية المطاف، يمكنك أن تنتقي وتختار

43
00:02:33,590 --> 00:02:34,960
أكثر نهاية مرغوبة لديك

44
00:02:37,750 --> 00:02:40,740
ما أنا على وشك أن أرويه لك هو قصّة

45
00:02:40,780 --> 00:02:43,780
إيزانامي الخاصّة بأوتشيها، وكيف نشأت

46
00:02:44,950 --> 00:02:46,990
أريدك أن تعلم هذا أيضاً

47
00:02:48,690 --> 00:02:51,980
إيزانامي الخاصّة بأوتشيها... قصّة إنشائها؟

48
00:04:22,070 --> 00:04:27,080
إيزاناغي وإيزانامي

49
00:04:27,860 --> 00:04:30,110
منذ زمن بعيد، نشبت معركة عظيمة

50
00:04:30,150 --> 00:04:32,730
لم تكن عشيرة أوتشيها ترغب بخسارتها

51
00:04:32,730 --> 00:04:35,650
تبيّن بأنّ الإيزاناغي ثمينة

52
00:04:37,770 --> 00:04:38,770
!انطلقوا

53
00:04:53,800 --> 00:04:56,420
اللّعنة! لقد نصبوا كميناً

54
00:05:02,700 --> 00:05:03,620
!ماذا؟

55
00:05:04,750 --> 00:05:05,910
!موتوا

56
00:05:11,900 --> 00:05:17,020
!ما دمنا نمتلك الإيزاناغي، لن نخسر

57
00:05:21,520 --> 00:05:22,930
...لكن

58
00:05:23,060 --> 00:05:25,350
هنالك خطورة أكبر من مجرّد عمى

59
00:05:25,390 --> 00:05:28,970
لتقنيّة تسمح للمستخدم أن يختار نهايته

60
00:05:29,630 --> 00:05:32,800
معظم من استخدموا هذه التقنيّة القويّة بإفراط

61
00:05:32,840 --> 00:05:35,630
لم يتعاملوا معها بشكل صحيح وأساؤوا
استخدام قوّتهم

62
00:05:36,540 --> 00:05:37,580
،كانت الأمور على ما يُرام

63
00:05:37,580 --> 00:05:40,040
ما دام هناك مستخدم واحد للإيزاناغي فقط

64
00:05:40,370 --> 00:05:43,410
لكن عندما ازداد عدد مستخدميها
،إلى اثنين أو أكثر

65
00:05:43,460 --> 00:05:45,660
حدث تزاحم في صفوف عشيرة أوتشيها

66
00:05:45,710 --> 00:05:47,320
لرؤية من يحظى بأفضل نتيجة

67
00:05:47,780 --> 00:05:51,700
!لست الشّخص الوحيد القادر على استخدام إيزاناغي

68
00:05:53,360 --> 00:05:56,320
!لا أريدك أن تنصّب نفسك زعيماً علينا

69
00:05:57,690 --> 00:06:00,140
!لكن أنا من أحرزتُها

70
00:06:00,640 --> 00:06:03,140
!في عالم الشينوبي، النتائج تمثل كلّ شيء

71
00:06:03,730 --> 00:06:08,930
...حسنٌ إذاً... سأعدّل تلك النتيجة

72
00:06:09,630 --> 00:06:11,630
!بالإيزاناغي خاصّتي

73
00:06:20,080 --> 00:06:22,170
أنت لا تجيد سوى الكلام

74
00:06:22,210 --> 00:06:27,360
...سأحكم أوتشيها... لا بل عالم الشينوبي بأكمله

75
00:06:28,110 --> 00:06:30,360
!بالإيزاناغي خاصّتي

76
00:06:32,700 --> 00:06:35,990
...سأستحوذ على أمنيتك

77
00:06:36,560 --> 00:06:38,940
!بالإيزاناغي خاصّتي

78
00:07:02,420 --> 00:07:04,330
ما صُنِع

79
00:07:04,380 --> 00:07:08,660
لإيقاف هذا التّنافس الداخلي في صفوف
...العشيرة على الإيزاناغي

80
00:07:08,700 --> 00:07:10,570
هو الإيزانامي

81
00:07:15,070 --> 00:07:17,480
الغينجيتسو العاديّة المستندة على البصر ضعيفة

82
00:07:17,520 --> 00:07:18,690
...أمام القوّة البصريّة

83
00:07:24,940 --> 00:07:27,640
،إن كنتِ تنوين معارضتي أيضاً

84
00:07:27,680 --> 00:07:29,640
فلا أملك خياراً

85
00:07:41,590 --> 00:07:44,590
لا بدّ من وجود طريقة لتسوية هذا الأمر بلا قتال

86
00:07:45,750 --> 00:07:48,410
يدايّ لُطّختا بالدماء وانتهى الأمر

87
00:07:48,870 --> 00:07:52,080
!مُحال أن أتوقّف

88
00:07:52,160 --> 00:07:54,580
!أنت تجهل نفسك

89
00:07:54,830 --> 00:07:57,770
!تجهل قوّتك الحقيقيّة

90
00:07:58,440 --> 00:07:59,690
!اخرسي

91
00:08:15,890 --> 00:08:17,630
!لم يفت الأوان كثيراً على التراجع الآن

92
00:08:18,380 --> 00:08:21,090
!إن كنت تتحلّى بالإرادة فأمسك بيدي

93
00:08:23,630 --> 00:08:24,920
!لن أنخدع

94
00:08:41,530 --> 00:08:45,860
!إن كنتَ ما زلتَ ترفض الإصغاء فأنا مستعدّة كذلك

95
00:08:59,460 --> 00:09:02,260
!تتسلّلين من خلفي، أحسنتِ صنعاً

96
00:09:02,840 --> 00:09:06,910
لكن ما دمتُ أمتلك إيزاناغي فلا يمكنكِ هزيمتي

97
00:09:07,450 --> 00:09:08,790
!انتهى أمركِ

98
00:09:37,010 --> 00:09:38,340
!لا أصدّق هذا

99
00:09:38,550 --> 00:09:40,420
...عيني اليمنى

100
00:09:40,470 --> 00:09:43,380
كان ينبغي أن أصاب بالعمى بالإيزاناغي

101
00:09:43,470 --> 00:09:47,330
الإيزاناغي التي تعتمد عليها كثيراً لن تحميك

102
00:09:47,330 --> 00:09:48,460
!اخرسي

103
00:09:52,210 --> 00:09:55,410
!لـ-ليس... ليس بعد

104
00:09:56,360 --> 00:09:58,150
،في المقام الأوّل

105
00:09:58,200 --> 00:10:00,530
الحقيقة هي نتاجُ فرصة نطلق عليها بالمصير

106
00:10:00,950 --> 00:10:02,740
لا يمكننا توقّعها

107
00:10:03,570 --> 00:10:06,940
لكن تستطيع الإيزاناغي تحوير حقيقة غير ملائمة

108
00:10:06,980 --> 00:10:08,600
لتؤدّي إلى مصيرٍ جديد

109
00:10:10,100 --> 00:10:11,350
حقيقة
،بنزوة

110
00:10:11,350 --> 00:10:13,850
تفعيل الإيزاناغي
يستطيع المُستخدم تغيير الحقيقة الأصليّة
إلى حقيقةٍ جديدة

111
00:10:13,850 --> 00:10:15,270
حقيقة جديدة
تفعيل الإيزاناغي
يستطيع المُستخدم تغيير الحقيقة الأصليّة
إلى حقيقةٍ جديدة

112
00:10:15,270 --> 00:10:15,940
حقيقة جديدة
تفعيل الإيزاناغي
بالنسبة للعدوّ، سيُحيى الخصم الذي سقط

113
00:10:15,940 --> 00:10:18,340
حقيقة أخرى
تفعيل الإيزاناغي
بالنسبة للعدوّ، سيُحيى الخصم الذي سقط

114
00:10:18,340 --> 00:10:19,800
لذا فهي تقنيّة لا تُحتمَل

115
00:10:20,340 --> 00:10:22,930
تفعيل الإيزانامي
أُعِدّت الإيزانامي لمواجهة شخص يستخدم الإيزاناغي

116
00:10:22,930 --> 00:10:25,880
تفعيل الإيزانامي
،لتغيير النتيجة بما يعود للمنفعة عليه

117
00:10:25,880 --> 00:10:28,920
تفعيل الإيزانامي
ودفعه للسّير في حلقةٍ لا متناهية

118
00:10:30,500 --> 00:10:33,750
كنتُ أؤمن أنّ الإيزاناغي هي التقنيّة البصريّة العظمى

119
00:10:34,750 --> 00:10:37,490
لكن هذا يعني أنّ الإيزانامي هي تقنيّة بصريّة
أكثر عظمة

120
00:10:38,530 --> 00:10:41,320
تنشئ الإيزانامي حلقة

121
00:10:41,360 --> 00:10:44,450
حول الإحساس الجسدي بالحقيقة المُعدّلة بواسطة إيزاناغي

122
00:10:45,490 --> 00:10:48,560
الإيزانامي هي تقنيّة مخصّصة لإيقاف الإيزاناغي

123
00:10:49,100 --> 00:10:52,350
هنالك طريق هرب نُصِّب داخل الحلقة

124
00:10:56,970 --> 00:11:00,010
في الأصل، كانت تقنيّة لإنقاذ الزملاء
في عشيرة أوتشيها

125
00:11:00,050 --> 00:11:02,260
من الغفلة والغطرسة

126
00:11:02,800 --> 00:11:06,920
لمنعِك من سلوك الطريق السّهل باستخدام التقنيّة

127
00:11:24,870 --> 00:11:26,070
!لماذا؟

128
00:11:26,400 --> 00:11:29,730
!لا قدر تعجز الإيزاناغي عن تغييره

129
00:11:30,440 --> 00:11:32,440
،اقبل بما فعلتَه

130
00:11:33,150 --> 00:11:36,220
!استحوذ على المستقبل الذي ينتظرك

131
00:11:39,470 --> 00:11:43,180
من المستحيل أن يُغفَر لي
بعدما تلطّخت يدايّ بالدماء

132
00:11:43,720 --> 00:11:44,930
...مع ذلك

133
00:11:44,970 --> 00:11:46,340
!استحوذ عليه

134
00:12:02,870 --> 00:12:05,330
لن أعتمد على إيزاناغي بعد الآن

135
00:12:11,230 --> 00:12:13,980
...سأقبل بالحقيقة وأمضي قدماً

136
00:12:33,130 --> 00:12:36,660
تفعيل إيزانامي
حالما يقبل المرء بالنتيجةِ الأصليّة
،ويكفّ عن محاولة التملّص منها

137
00:12:36,660 --> 00:12:38,870
الحقيقة
تتوقّف الحلقة

138
00:12:40,370 --> 00:12:43,240
،تقودك هذه التقنيّة نحو تقبّل مصيرك

139
00:12:43,290 --> 00:12:45,370
بدلاً من الاعتماد على تقنيّةٍ لتغييره

140
00:12:46,320 --> 00:12:49,400
لكن من الخطير جدّاً استخدام تقنيّة
تحتوي على طريق هرب في معركة فعليّة

141
00:12:50,570 --> 00:12:53,360
لهذا إيزانامي هي تقنيّة محرّمة

142
00:12:54,320 --> 00:12:58,520
،إن توقّف كابوتو عن تحويل نفسه

143
00:12:58,560 --> 00:13:00,390
يستطيع إيقاف الحلقة

144
00:13:04,890 --> 00:13:08,340
...تاريخ أوتشيها المليء بالنزاعات

145
00:13:08,920 --> 00:13:14,170
...غطرسة وتهوّر أولئك الذين استخدموا الإيزاناغي

146
00:13:15,340 --> 00:13:20,160
...وكيف تمّ الاشتباك معهم وإيقافهم بواسطة إيزانامي

147
00:13:21,250 --> 00:13:23,160
فهمتُ الآن

148
00:13:23,200 --> 00:13:25,790
سبب إدراج إيزاناغي وإيزانامي في خانة
التقنيّة المحرّمة

149
00:13:26,280 --> 00:13:28,740
وفهمتُ كيف يجب على المرء التعلّم من الماضي

150
00:13:28,780 --> 00:13:32,110
وتقبّل مصيره والمضيّ قدماً

151
00:13:34,490 --> 00:13:35,530
...لكن

152
00:13:35,570 --> 00:13:39,350
لكن لِمَ تهمّ نفسك باستخدام هذه
التقنيّة على كابوتو؟

153
00:13:40,140 --> 00:13:42,100
...إن كان هناك طريق للهرب

154
00:13:42,180 --> 00:13:44,930
يذكّرني بنفسي قديماً

155
00:13:46,090 --> 00:13:48,090
،يعتقد أنّه إذا اكتسبَ كلّ شيء

156
00:13:48,090 --> 00:13:50,380
فإنّه يستطيع تحقيق ما يشاء

157
00:13:51,260 --> 00:13:57,290
يُقنع نفسه ويكذب على نفسه بأنّه لا يمكن أن يفشل

158
00:13:58,250 --> 00:14:03,830
كففتُ عن الإصغاء لأحد آخر، لم أعد أثق بأحد

159
00:14:04,910 --> 00:14:07,780
في حالة كابوتو، إنّه مضلّل

160
00:14:08,070 --> 00:14:11,860
لدرجة أنّه يعتقد أنّ كلّ هذه القوى
هي ملكه وحده

161
00:14:13,650 --> 00:14:15,360
أتعاطف معه

162
00:14:16,100 --> 00:14:19,020
...كلانا تعرّضنا للاستغلال بواسطة عالم الشينوبي هذا

163
00:14:19,190 --> 00:14:23,230
لا يستطيع مُسامحة نفسه ولا تقبّل نفسه
على حقيقتها

164
00:14:24,390 --> 00:14:27,260
ما يفعله هو خاطئ قطعاً

165
00:14:27,930 --> 00:14:31,800
لكن من الخطأ أيضاً إلقاء اللّوم
عليه لعدم إدراكه ذلك

166
00:14:33,760 --> 00:14:36,040
،فرصتي قد ولّت

167
00:14:36,040 --> 00:14:38,370
أمّا هو فما زال قادراً على مسامحة نفسه قبل أن يموت

168
00:14:39,290 --> 00:14:43,870
ولمَ ترغب في مساعدته على فعل ذلك؟

169
00:14:44,120 --> 00:14:47,910
!إنّه ليس مثلك. كنتَ مثاليّاً

170
00:14:47,990 --> 00:14:49,320
...ساسكي

171
00:14:50,160 --> 00:14:53,860
حاولتُ التحكّم بك بالتقنيّة البصريّة

172
00:14:53,910 --> 00:14:56,770
التي تدعى كوتو أماتسوكامي

173
00:14:58,020 --> 00:15:00,850
عاملتُك كطفل

174
00:15:00,900 --> 00:15:03,310
لأنّني رأيتُ أنّك احتجت لحمايتي

175
00:15:03,350 --> 00:15:05,560
لم أثق بقوّتك

176
00:15:07,140 --> 00:15:11,840
لعلّه لا يوجد كائن مثاليّ في العالم إطلاقاً

177
00:15:13,140 --> 00:15:15,510
أحياناً ترى أنّ شيئين يبدوان متضادّين

178
00:15:15,550 --> 00:15:17,080
هما في الحقيقة وجهان لعملة واحدة

179
00:15:17,750 --> 00:15:22,000
لا ينجحان إلّا عندما يعملان معاً

180
00:15:23,000 --> 00:15:25,710
مثل الإيزاناغي والإيزانامي

181
00:15:26,700 --> 00:15:27,990
،انظر إليّ

182
00:15:28,030 --> 00:15:30,700
وجدت في نفسك ما عجزتُ عن إيجاده في نفسي

183
00:15:32,200 --> 00:15:35,980
لا تقل أنّني كنتُ مثاليّاً

184
00:15:37,020 --> 00:15:38,190
...فقبل كلّ شيء

185
00:15:47,550 --> 00:15:49,050
!مستحيل

186
00:15:49,100 --> 00:15:51,430
!سأكون كائناً مثاليّاً

187
00:15:53,350 --> 00:15:56,340
!هذا... لستُ أنا

188
00:15:57,090 --> 00:15:59,210
إلى متى ستقلّد أوروتشيمارو؟

189
00:16:02,590 --> 00:16:06,030
!إذا أردتَ الخروج من هذه الحلقة، راجع أخطاءك

190
00:16:06,030 --> 00:16:07,280
!اصمت

191
00:16:07,950 --> 00:16:10,330
أعلم أنّه سيهاجمني بتقنيّة أسلوب ناريّ

192
00:16:10,950 --> 00:16:12,450
...أسلوب الماء... تنّين الماء

193
00:16:12,490 --> 00:16:14,030
!أسلوب الماء... صاروخ تنّين الماء

194
00:16:18,600 --> 00:16:20,940
!توقّع تلك التقنيّة بالشارينغان

195
00:16:36,680 --> 00:16:39,080
كيف أخطأتُ في هذا؟

196
00:16:39,250 --> 00:16:42,500
أين... ارتكبتُ خطأ بالضبط؟

197
00:16:44,710 --> 00:16:47,170
...كان كلّ ما أردتُه هو شخص

198
00:16:47,210 --> 00:16:49,200
...يقدّر

199
00:16:49,200 --> 00:16:51,490
!هويّتي

200
00:16:52,610 --> 00:16:55,110
!كان كلّ ما أردتُه هو أن يُعترَف بي

201
00:16:57,070 --> 00:17:00,850
!أين الخطأ في ذلك؟

202
00:17:03,900 --> 00:17:05,020
...قبل كلّ شيء

203
00:17:05,020 --> 00:17:08,890
كان عليك أن تقبل نفسك كما كنت

204
00:17:09,640 --> 00:17:13,180
لما اضطررتَ حينها للكذب على أحد

205
00:17:13,800 --> 00:17:15,970
على نفسك... أو عليّ

206
00:17:16,640 --> 00:17:19,130
إن كذبتَ على نفسك، فكيف ستحصل على أصدقاء؟

207
00:17:19,170 --> 00:17:21,540
كيف ستثق أو يُوثَق بك؟

208
00:17:22,040 --> 00:17:25,170
ستظلّ الأكاذيب تعميك عن رؤية ذاتك الحقيقيّة

209
00:17:28,620 --> 00:17:32,320
...لو لم أعلق هنا

210
00:17:32,370 --> 00:17:34,620
لربحتُ هذه الحرب الآن

211
00:17:35,030 --> 00:17:37,570
ولكنتُ نائماً الآن

212
00:17:40,440 --> 00:17:42,480
!تبّاً لك يا إيتاتشي

213
00:17:57,140 --> 00:17:58,460
أصبحت السّاعة التاسعة؟

214
00:17:58,880 --> 00:17:59,920
هل من مشكلة؟

215
00:18:00,290 --> 00:18:01,290
...لا

216
00:18:02,090 --> 00:18:03,960
آمل فحسب أن ننهي هذا الأمر بسرعة

217
00:18:04,000 --> 00:18:06,170
وذلك كي أحظى بنوم ليليّ هانئ

218
00:18:06,790 --> 00:18:12,950
لا يخبرون أمثالنا الصّغار عمّا يجري أبداً

219
00:18:13,410 --> 00:18:14,530
معك حقّ

220
00:18:15,660 --> 00:18:18,110
حسناً، ماذا ستفعل عندما تنتهي هذه الحرب؟

221
00:18:19,190 --> 00:18:21,440
سأذهب إلى الدّيار أولاً

222
00:18:22,190 --> 00:18:23,900
إذا انتهت الحرب

223
00:18:23,940 --> 00:18:26,610
...وظلّت الدّول العظيمة الخمس حليفة

224
00:18:26,900 --> 00:18:29,850
فقد يستطيع أخي الصّغير الذي خرج
في مهمّة لفترةٍ طويلة

225
00:18:29,890 --> 00:18:31,140
أن يعود أخيراً

226
00:18:32,850 --> 00:18:35,560
...أحسد أولئك الذين لديهم ديار يعودون إليها

227
00:18:38,050 --> 00:18:40,920
أتريد المجيء معنا؟

228
00:18:42,050 --> 00:18:44,670
منزلي هو عبارة عن ميتم

229
00:18:45,250 --> 00:18:47,990
وإن عاد أخي الصّغير، يستطيع
مُداواة جراحك

230
00:18:49,660 --> 00:18:51,830
!أشكرك على ذلك يا أوروشي

231
00:18:53,040 --> 00:18:56,080
...آمل حقّاً أن تعود هذه المرّة

232
00:18:59,230 --> 00:19:00,360
يا كابوتو

233
00:19:08,930 --> 00:19:11,390
سأوقف تقنيّة الإحياء الآن

234
00:19:16,890 --> 00:19:19,880
و... كافّة الموتى الذين تمّ إحياؤهم سيتلاشون

235
00:19:22,380 --> 00:19:24,760
ينبغي لهذا أن ينهي الحرب

236
00:19:25,880 --> 00:19:27,300
...لكن

237
00:19:28,870 --> 00:19:30,410
سترحل أيضاً يا أخي

238
00:19:31,370 --> 00:19:34,750
سأكون قد حميتُ قريتي بصفتي

239
00:19:34,790 --> 00:19:37,370
إيتاتشي أوتشيها من قرية الورق مجدّداً

240
00:19:38,610 --> 00:19:40,690
لم يعد هناك ما أتحسّر عليه

241
00:19:40,860 --> 00:19:42,150
!لماذا؟

242
00:19:42,400 --> 00:19:46,610
لماذا تساعد ذات القرية التي أوصلتك
إلى ما أنت عليه الآن؟

243
00:19:46,990 --> 00:19:49,770
!لعلّك قادر على المسامحة، لكن أنا لا أستطيع

244
00:19:50,140 --> 00:19:51,980
لم يعد هناك ما تتحسّر عليه؟

245
00:19:52,520 --> 00:19:56,060
!ماذا عن الوضع الذي أوصلتني إليه؟

246
00:20:04,010 --> 00:20:06,050
أترك ساسكي لك

247
00:20:07,510 --> 00:20:10,830
بذلتُ قصارى جهدي... وفشلت

248
00:20:11,870 --> 00:20:15,830
هذه المرّة... سأترك الأمر لزملائي

249
00:20:18,400 --> 00:20:21,280
لستُ الشّخص القادر على تغييرك يا ساسكي

250
00:20:23,200 --> 00:20:28,230
لكن أستطيع إيقاف هذه التقنيّة

251
00:20:28,940 --> 00:20:32,520
لأوفي بوعدي لناروتو على الأقلّ

252
00:20:35,770 --> 00:20:37,600
!سأوقف تقنيّة الإحياء الآن

253
00:20:38,510 --> 00:20:39,930
!أخبرني بالإيماءات

254
00:20:41,430 --> 00:20:42,680
!تسوكويومي

255
00:20:54,290 --> 00:20:55,960
وفيتُ بوعدي

256
00:20:56,290 --> 00:20:59,030
أترك الباقي عليك... يا ناروتو