1
00:00:03,240 --> 00:00:04,310
!أموت؟

2
00:00:05,640 --> 00:00:09,240
كيف يمكن أن يكون التوحّد مع الطبيعة موتاً؟

3
00:00:09,770 --> 00:00:12,850
!غاماكيتشي، ماذا تعني بالموت هذا؟

4
00:00:13,120 --> 00:00:14,680
!لا تطرح مُقارنات غريبة كهذه

5
00:00:15,550 --> 00:00:16,620
...لكن

6
00:00:17,880 --> 00:00:22,490
استرخِ، فأنتَ لن تموت فعليّاً أيُّها الفتى ناروتو

7
00:00:22,760 --> 00:00:23,930
ماذا إذاً؟

8
00:00:24,390 --> 00:00:27,090
...انتظر حتّى أنتهي فحسب

9
00:00:27,390 --> 00:00:29,630
سأشرح هذا خطوة بخطوة

10
00:00:31,870 --> 00:00:35,870
...امتصاص طاقة الطبيعة

11
00:00:35,900 --> 00:00:38,100
تعني القدرة على الإحساس بما هو حولك

12
00:00:38,140 --> 00:00:41,450
وجذبها إلى داخلك

13
00:00:42,250 --> 00:00:45,180
بالإضافة إلى ذلك، عندما تتوحّد مع الطبيعة

14
00:00:45,210 --> 00:00:48,480
فإنَّك تكتسِبُ أيضاً سيطرةً
كامِلة على طاقة الطّبيعة

15
00:00:48,510 --> 00:00:50,790
التي تدخل وتُغادر جسدك

16
00:00:52,890 --> 00:00:56,360
...عمليّاً، تدريبك هو

17
00:00:56,390 --> 00:00:57,290
نعم، نعم؟

18
00:00:58,360 --> 00:00:59,390
ابقَ ثابتاً

19
00:00:59,890 --> 00:01:00,360
ماذا؟

20
00:01:00,720 --> 00:01:02,800
يعني أن تبقى ثابتاً

21
00:01:03,570 --> 00:01:06,600
عندما تُوقِف تدفُّق غرائزك الحيوانيّة

22
00:01:06,630 --> 00:01:09,570
،وتتناغم مع تدفُّق الطبيعة

23
00:01:09,600 --> 00:01:11,940
فستتمكّن من الإحساس بطاقةِ الطبيعة للمرّة الأولى

24
00:01:13,140 --> 00:01:15,410
هل أبقى ثابتاً فقط إذاً؟

25
00:01:15,840 --> 00:01:18,080
يبدو هذا سهلاً جدّاً

26
00:01:18,310 --> 00:01:21,750
ناروتو، ما زلتَ لم تفهم، صحيح؟

27
00:01:24,520 --> 00:01:29,020
بالنسبة للحيوانات، عدم التحرُّك
هو أصعب شيء يمكن فعله

28
00:01:30,320 --> 00:01:33,960
...القفز والرّكض وإنشاء التشاكرا بكامل قوّتي

29
00:01:34,330 --> 00:01:36,360
خضعتُ لتدريباتٍ من هذا النّوع

30
00:01:36,530 --> 00:01:40,200
لكن البقاء ثابتاً؟ لستُ أفهم تماماً

31
00:01:41,110 --> 00:01:44,410
لكن هكذا تمتصُّ طاقة الطبيعة، صحيح؟

32
00:01:45,170 --> 00:01:47,110
يستحيلُ فعلها فوراً

33
00:01:47,470 --> 00:01:49,870
،يتطلّبُ هذا التدريب وقتاً

34
00:01:50,410 --> 00:01:52,680
لأنّ مستوى الصّعوبة عالٍ جدّاً

35
00:01:53,250 --> 00:01:55,180
!سيستغرق كلّ هذا الوقت؟

36
00:01:55,380 --> 00:01:57,350
!لا تستخفّ بالأمر كثيراً أيُّها الفتى ناروتو

37
00:01:57,820 --> 00:02:00,480
...عدوّنا هو باين والذي يمتلكُ الرنّيغان

38
00:02:00,520 --> 00:02:02,330
.وهي قوّة الريكودو سينين

39
00:02:02,430 --> 00:02:04,730
.عدوّ قويّ قتلَ الفتى جيرايا

40
00:02:06,460 --> 00:02:09,690
!بموقفٍ كهذا لا يمكنك أن تنتصر إطلاقاً

41
00:02:09,790 --> 00:02:11,400
!أعلم كلّ هذا

42
00:02:12,440 --> 00:02:15,070
باين هو قائدُ الأكاتسكي الذين يستهدفون البيجو

43
00:02:15,270 --> 00:02:17,400
قد يستهدفونني في أي لحظة

44
00:02:17,770 --> 00:02:19,670
لا أملُك وقتاً كثيراً أهدره

45
00:02:24,250 --> 00:02:29,110
...حسناً، هذا لا يعني أنّه لا توجد طريقة أفضل

46
00:02:29,510 --> 00:02:30,550
!توجد؟

47
00:02:30,580 --> 00:02:32,260
!علّمني إيّاها إذاً

48
00:02:34,560 --> 00:02:36,390
...هذا الشلّالُ خلفي

49
00:02:37,060 --> 00:02:39,990
إنّه زيت ضفدع جبل ميوبوكو السرّي

50
00:02:40,220 --> 00:02:41,130
زيت ضفدع؟

51
00:02:44,030 --> 00:02:46,470
تعال إلى هنا ومدّ يدك

52
00:02:54,160 --> 00:02:54,860
ها أنا ذا

53
00:02:58,270 --> 00:03:02,770
لدى زيت الضفدع هذا
خاصّية جذب طاقة الطبيعة

54
00:03:03,470 --> 00:03:05,440
يُساهم في التّدريب

55
00:03:05,970 --> 00:03:08,220
!هذا مفيد

56
00:03:09,020 --> 00:03:15,720
تدخلُ طاقةُ الطبيعة أينما
،تفركُ جسدَك بهذا الزيت

57
00:03:16,620 --> 00:03:21,290
وستكسب القدرة على الإحساس
بطاقةِ الطّبيعة تدريجيّاً

58
00:03:21,930 --> 00:03:23,060
...معك حقّ

59
00:03:23,090 --> 00:03:25,590
أظنُّني أشعر بشيء يدخلُ جلدي

60
00:03:25,830 --> 00:03:29,770
إنّها أداة تُساعدك على فهم الصّورة

61
00:03:30,570 --> 00:03:34,400
مع الوقت، لن تحتاج حتّى لاستعمال الزيت

62
00:03:35,100 --> 00:03:37,000
لكن هنالك مخاطِر

63
00:03:40,450 --> 00:03:44,880
عندما يُستخدَم بواسطة شخص غير خبير
في التحكُّم بطاقة الطبيعة

64
00:03:45,210 --> 00:03:48,120
فإنّه يبدأ بالتحوُّل إلى ضفدع

65
00:03:56,060 --> 00:03:57,830
!ما-ما-ما هذا؟

66
00:03:59,570 --> 00:04:00,530
!النّجدة

67
00:04:00,600 --> 00:04:01,770
!لا أريد أن أكون ضفدعاً

68
00:04:04,500 --> 00:04:06,200
!مؤلم

69
00:04:06,730 --> 00:04:07,940
لماذا فعلت هذا؟

70
00:04:09,440 --> 00:04:10,380
عدتُ إلى طبيعتي

71
00:04:10,810 --> 00:04:12,780
الأمر متعلِّق بالتوازُن

72
00:04:12,940 --> 00:04:15,680
أنت معتادٌ على تحويل طاقتك الذهنيّة والجسديّة

73
00:04:15,710 --> 00:04:18,390
،إلى تشاكرا نينجيتسو

74
00:04:18,420 --> 00:04:20,390
لهذا فأنت مُتوازنٌ هنا

75
00:04:21,620 --> 00:04:25,120
لكنّك الآن يجبُ أن تضيف
طاقةَ الطبيعة إلى الخليط

76
00:04:25,150 --> 00:04:27,490
إنَّ الحصول على التّوازُن المثاليّ صعب للغاية

77
00:04:28,060 --> 00:04:29,260
توازُن؟

78
00:04:29,930 --> 00:04:33,330
طبيعة     ذهنيّ    جسديّ
إذا امتصصتَ القليل فلن تحصل على تشاكرا
تقنيّة الناسك

79
00:04:33,530 --> 00:04:35,400
،ومع ذلك، إذا امتصصتَ الكثير

80
00:04:35,430 --> 00:04:38,910
ستهيمنُ طاقةُ الطبيعة عليك وتحوّلك إلى ضفدع

81
00:04:41,040 --> 00:04:45,240
وبالطبع إذا امتصصتَ كمّية كبيرة بعض الشيء
يمكنُك العودة إلى طبيعتك

82
00:04:46,440 --> 00:04:52,120
لكن إذا امتصصتَ أكثر من
كمّية معيّنة فستبقى ضفدعاً

83
00:04:52,150 --> 00:04:54,650
ولن تعود إلى إنسان مجدّداً

84
00:04:56,580 --> 00:04:58,390
ما قصدتُه عندما قلتُ أنّك يجب أن تموت

85
00:04:58,430 --> 00:05:01,130
هو أنّك قد تتجرّد من بشريّتك

86
00:05:01,330 --> 00:05:03,290
،حالما تتحوّل إلى ضفدع

87
00:05:03,330 --> 00:05:06,260
حينئذ تمضي قُدماً نحو التوحُّد مع الطبيعة للأبد

88
00:05:06,530 --> 00:05:10,640
...والتّلاميذ السّابقون الذين فشِلوا في هذا التّدريب

89
00:05:12,600 --> 00:05:14,570
أصبحوا هذه التّماثيل الحجريّة

90
00:05:16,540 --> 00:05:17,680
كلّهم؟

91
00:05:18,750 --> 00:05:20,780
حسناً، لا تعبس كثيراً

92
00:05:22,580 --> 00:05:24,550
فأنا معك

93
00:05:24,580 --> 00:05:28,920
وهذه العصا تخرجُ طاقة الطبيعة من جسدِ المرء

94
00:05:29,660 --> 00:05:32,660
،إن بدأتَ تتحوّلُ إلى ضفدع

95
00:05:32,890 --> 00:05:36,420
فسأضربك لعكسِ الأمر

96
00:05:38,400 --> 00:05:40,130
،بصريح العبارة

97
00:05:40,500 --> 00:05:44,230
حتّى الفتى جيرايا لم يتمكّن من إتقان هذه كلّياً

98
00:05:45,770 --> 00:05:49,040
كان الفتى جيرايا كلّما أنشأ تقنيّة الناسك

99
00:05:49,080 --> 00:05:51,310
يكتسب دوماً بعضاً من سِمات الضفدع

100
00:05:51,980 --> 00:05:54,610
لكنّه كان من بين الماهرين

101
00:05:54,980 --> 00:05:57,990
،أشكُّ بأنّك ستتردّدُ بعد قطعك كلّ هذه المسافة

102
00:05:58,590 --> 00:06:00,490
...لكن دعني أسألك

103
00:06:01,820 --> 00:06:03,090
ماذا ستفعل؟

104
00:06:05,720 --> 00:06:06,550
!سأفعلُها

105
00:06:07,730 --> 00:06:09,400
...طريقي في النّينجا

106
00:06:10,030 --> 00:06:11,800
!هو نفسه طريق الناسك المنحرف

107
00:07:46,010 --> 00:07:48,110
اصطدنا الرّوكوبي أخيراً

108
00:07:48,970 --> 00:07:51,940
يمكنك المتابعة واصطياد الكيوبي

109
00:07:52,940 --> 00:07:53,710
فكرة سديدة

110
00:07:54,320 --> 00:07:58,380
،بما أنّكما قتلتُما جيرايا
ستركّز عليكما قرية الورق

111
00:07:59,280 --> 00:08:01,380
،كلّما مضى الوقت

112
00:08:01,420 --> 00:08:03,920
أعدّوا خطّة مُحكمة وأكثر ذكاءً

113
00:08:04,760 --> 00:08:06,730
تصرّفا قبل أن يزداد الأمر صعوبة

114
00:08:07,790 --> 00:08:09,290
...باين لا يُقهَر

115
00:08:09,730 --> 00:08:13,230
مهما حدث، سنصطاد الكيوبي

116
00:08:13,860 --> 00:08:15,970
بقي بيجو آخر غيره

117
00:08:16,070 --> 00:08:17,300
ألم يكونا اثنين؟

118
00:08:17,840 --> 00:08:20,170
لقد اصطاد ساسكي الهاتشيبي

119
00:08:20,440 --> 00:08:21,470
هكذا إذاً

120
00:08:24,810 --> 00:08:27,180
كونان، رتِّبي الأمور حالاً

121
00:08:34,320 --> 00:08:36,420
سنتوجّه إلى قرية الورق

122
00:08:45,330 --> 00:08:46,600
!مُؤلم

123
00:08:48,030 --> 00:08:51,200
سأمتلئ بالكدمات والدّماء من الدّاخل إلى يوم غدّ

124
00:08:51,330 --> 00:08:53,900
ماذا؟ هل استسلمت بهذه السّرعة؟

125
00:08:55,180 --> 00:08:59,180
أعرف طريقة تدريب أفضل بكثير

126
00:08:59,480 --> 00:09:00,580
ما هي؟

127
00:09:00,880 --> 00:09:03,280
أستخدم نسخاً ظلّية في التّدريب

128
00:09:03,680 --> 00:09:06,520
!فهي تعزِّز سرعة تطوّري بشكل كبير

129
00:09:07,120 --> 00:09:08,320
معك حقّ

130
00:09:08,690 --> 00:09:12,920
فالخبرة التي تكتسبُها النّسخ الظلّية
تعودُ إلى الأصليّ

131
00:09:13,890 --> 00:09:16,760
...لكن العكس صحيح أيضاً

132
00:09:16,800 --> 00:09:20,160
،إذا تحوّلَتْ نسخة ظلّية إلى ضفدع

133
00:09:20,200 --> 00:09:22,400
يتأثّر الأصليّ كذلك

134
00:09:22,500 --> 00:09:24,570
أعلم هذا

135
00:09:24,810 --> 00:09:27,240
موافق، ولكن الحدّ هو أربع نسخ فقط

136
00:09:27,640 --> 00:09:30,310
!أكثر من ذلك فلن أستطيع أنا والعصا مُتابعتك

137
00:09:30,470 --> 00:09:31,310
!حسناً

138
00:09:42,650 --> 00:09:45,530
!نحن لا نلعب لعبة ضرب الخلد

139
00:09:45,590 --> 00:09:46,890
!هذا تدريب

140
00:09:46,990 --> 00:09:48,690
!لن أصمد وأنا أفعل هذا

141
00:09:48,830 --> 00:09:50,230
!اللّعنة

142
00:09:51,260 --> 00:09:52,860
!مؤلم

143
00:09:54,440 --> 00:09:57,300
!أصبح وجهي هكذا من الضّرب

144
00:09:57,540 --> 00:09:59,400
!هذا ليس تحوّلاً إلى ضفدع

145
00:09:59,470 --> 00:10:01,200
ماذا؟! آسف

146
00:10:06,150 --> 00:10:09,150
لم أتوقّع أبداً أن يكون التّدريب على الشّعور
بطاقة الطّبيعة

147
00:10:09,180 --> 00:10:11,680
صعباً إلى هذه الدّرجة

148
00:10:11,710 --> 00:10:16,320
لا تكتسب القوّة الحقيقيّة إلّا من خلال المُثابرة

149
00:10:16,520 --> 00:10:18,260
!أعلم هذا

150
00:10:18,690 --> 00:10:21,060
إذا كان هذا سيجعلُني قويّاً
،مثل الناسك المُنحرف

151
00:10:21,090 --> 00:10:23,090
فأي شخص سيتحمّله

152
00:10:23,220 --> 00:10:25,270
لا... هذا مستحيل

153
00:10:26,670 --> 00:10:30,400
...هذا التّدريب ليس للجميع

154
00:10:30,900 --> 00:10:35,910
يمكنُك القول أنّه مُمكِن لأنّك أنت
والفتى جيرايا من تخضعان له

155
00:10:36,810 --> 00:10:38,940
وإلّا لما أحضرتُك حتّى إلى هنا

156
00:10:39,880 --> 00:10:41,410
ماذا تعني؟

157
00:10:42,280 --> 00:10:45,990
،ما لم تمتلك تشاكرا هائلة في داخلك سلَفاً

158
00:10:46,150 --> 00:10:50,750
لكانت طاقة الطّبيعة قد هيمنَتْ عليك فوراً

159
00:10:51,650 --> 00:10:55,200
هذا هو مدى حدّة طاقة الطّبيعة

160
00:10:57,060 --> 00:11:01,200
ناهيك أنّهم يجبُ أن يتحلّوا
بشجاعةِ عدم الاستسلام

161
00:11:01,760 --> 00:11:04,610
هذه هي طبيعة الشّخص
الذي يستطيعُ أن يصبح ناسكاً

162
00:11:06,740 --> 00:11:09,310
!حسناً! لنقم بهذا إذاً

163
00:11:09,970 --> 00:11:11,740
!أحمق! أتريد أن تقتل نفسك؟

164
00:11:37,340 --> 00:11:38,540
!شعرتُ بها

165
00:11:39,240 --> 00:11:42,700
!نعم -
يبدو أنّه بدأ -

166
00:11:42,740 --> 00:11:45,010
!شعرتُ بها، شعرتُ بها -
بالشُّعور بطاقة الطبيعة -

167
00:11:45,810 --> 00:11:49,450
فوكاساكو-ساما، بدأتُ أجوع قليلاً -
!شعرتُ بها، شعرتُ بها -

168
00:11:49,550 --> 00:11:50,850
معك حقّ -
!شعرتُ بها -

169
00:11:50,910 --> 00:11:53,780
الفتى ناروتو، حان وقتُ الاستراحة
!أنا رائع، نعم -

170
00:11:53,810 --> 00:11:54,860
لنأكل

171
00:11:56,520 --> 00:11:58,120
كُل حالاً

172
00:11:59,320 --> 00:12:00,790
،بعد الاستراحة

173
00:12:04,670 --> 00:12:06,230
!حـ-حاضر

174
00:12:07,570 --> 00:12:11,470
لذيذة؟ إنّها أطباق كا-تشان الخاصّة

175
00:12:11,600 --> 00:12:14,070
إنّها المفضّلة لديّ

176
00:12:15,280 --> 00:12:17,240
طعمها لذيذ حقّاً

177
00:12:19,580 --> 00:12:21,780
فقد بدأتُ أتجرّد من بشريّتي

178
00:12:26,320 --> 00:12:30,690
لكن أوّلاً، جرّب ذلك باستخدام
تشاكرا النينجيتسو خاصّتك فقط

179
00:12:30,990 --> 00:12:32,020
حـ-حسناً

180
00:12:36,230 --> 00:12:36,900
!سأبدأ

181
00:12:43,160 --> 00:12:44,340
!توقّف إذاً

182
00:12:49,310 --> 00:12:51,940
!والآن أنشئ بعضاً من تشاكرا تقنيّة الناسك

183
00:12:52,110 --> 00:12:52,840
!حاضر

184
00:13:21,400 --> 00:13:22,040
!حسناً

185
00:13:42,790 --> 00:13:44,670
!أحسنت أيّها الفتى ناروتو

186
00:13:51,830 --> 00:13:53,570
!جميل يا ناروتو

187
00:13:54,130 --> 00:13:58,080
هذا الغُلام أسرع في الاستيعاب من الفتى جيرايا

188
00:13:58,740 --> 00:13:59,880
!فعلتُها

189
00:13:59,910 --> 00:14:02,510
أحمق! كيف تجرؤ على مُعاملة سلفك
بقلّة احترام هكذا

190
00:14:08,090 --> 00:14:11,150
...رُغم أنّه أغبى بكثير من الفتى جيرايا أيضاً

191
00:14:11,990 --> 00:14:13,350
!حسناً أيّها الفتى ناروتو

192
00:14:13,390 --> 00:14:16,230
!والآن أعِد كلّ الحجارة المنقلِبة إلى مكانها

193
00:14:16,260 --> 00:14:18,130
!هل أنتَ جادّ؟

194
00:14:29,650 --> 00:14:30,910
الهاتشيبي؟

195
00:14:31,950 --> 00:14:35,080
يبدو أنّ ساسكي قد نجح

196
00:14:36,050 --> 00:14:37,990
سيحضر باين الكيوبي

197
00:14:41,820 --> 00:14:46,120
يبدو أنّك أتقنتَ التحكُّم بمُساعدة زيت الضفدع

198
00:14:46,970 --> 00:14:49,930
والآن عليك أن تُتقِنَ التحكُّم بطاقة الطبيعة

199
00:14:49,970 --> 00:14:52,130
من دون استخدام الزيت

200
00:14:56,430 --> 00:14:58,110
!أشعرُ بالقوّة تتدفّقُ إلى داخلي

201
00:14:59,440 --> 00:15:03,810
تستهلك تشاكرا النينجيتسو طاقتَك الداخليّة

202
00:15:03,840 --> 00:15:06,480
كلّما استخدمتَها أكثر، ازددتَ إنهاكاً

203
00:15:07,590 --> 00:15:11,190
بالمُقابِل، تمتصُّ تشاكرا
تقنيّة الناسك الطاقةَ الخارجيّة

204
00:15:11,220 --> 00:15:13,150
لِهذا فهي لن تُتعبك

205
00:15:13,620 --> 00:15:16,620
بل في الواقع، ستتعافى وتُشفى بشكل أسرع أيضاً

206
00:15:18,030 --> 00:15:18,960
...فهمت

207
00:15:19,260 --> 00:15:22,500
،حسناً... بوجود تشاكرا الكيوبي في الخليط أيضاً

208
00:15:22,530 --> 00:15:24,660
يُظهِر مُعدَّل شِفاء جدير جدّاً بالمُلاحظة

209
00:15:26,300 --> 00:15:29,510
...لعلّي أستطيع فعل ذلك الآن أيضاً

210
00:15:29,970 --> 00:15:30,770
تفعل ماذا؟

211
00:15:30,810 --> 00:15:32,570
...لا شيء

212
00:15:32,610 --> 00:15:33,710
!لا شيء على الإطلاق

213
00:15:34,010 --> 00:15:36,920
انسَ الأمر إذاً... لكن انظر

214
00:15:37,980 --> 00:15:40,980
فكّرتُ اليوم في إعطائك هذا أيُّها الفتى ناروتو

215
00:15:41,650 --> 00:15:42,920
ما هو؟

216
00:15:43,420 --> 00:15:44,280
كتاب

217
00:15:44,650 --> 00:15:45,180
كتاب؟

218
00:15:45,880 --> 00:15:49,460
هذه هي الرّواية الأولى التي ألّفَها الفتى جيرايا

219
00:15:50,390 --> 00:15:53,590
كرّسَ الفتى جيرايا عقله وقلبه في هذا الكتاب

220
00:15:54,260 --> 00:15:55,530
يجدرُ بك أن تقرأه

221
00:16:01,600 --> 00:16:04,170
حكايات نينجا جريء
حكايات... نينجا جريء

222
00:16:08,310 --> 00:16:10,310
لِمَ لا تستسلم؟

223
00:16:15,250 --> 00:16:18,260
لعبة الاختباء والبحث تزدادُ مَللاً

224
00:16:32,370 --> 00:16:33,500
استسلم

225
00:16:33,930 --> 00:16:35,330
هل يمكنني أن أقول كلمة؟

226
00:16:35,370 --> 00:16:36,670
!لستُ مهتمّاً بكلامك

227
00:16:38,040 --> 00:16:39,310
!مُت فحسب

228
00:16:39,740 --> 00:16:41,740
...تنازل

229
00:16:44,310 --> 00:16:45,410
!عن فكرة استسلامي

230
00:16:48,820 --> 00:16:51,020
،حتّى لو هزمتَني

231
00:16:51,050 --> 00:16:54,950
...سيُهاجم قاتلٌ مأجورٌ آخر القرية

232
00:16:57,930 --> 00:17:02,660
،ما دمنا ملعونين بالعيش في عالم النّينجا هذا

233
00:17:02,700 --> 00:17:04,760
فلن يحلّ السّلام

234
00:17:07,610 --> 00:17:09,270
!إذاً... سأكسر تلك اللّعنة

235
00:17:10,210 --> 00:17:14,140
!إن كان هُناك ما يُدعى بسلام فسأستحوذ عليه

236
00:17:14,570 --> 00:17:15,940
!لن أستسلم أبداً

237
00:17:18,480 --> 00:17:21,520
مـ-من أنت...؟

238
00:17:22,320 --> 00:17:23,450
...اسمي هو

239
00:17:24,020 --> 00:17:27,830
حكايات نينجا جريء

240
00:17:33,760 --> 00:17:36,460
جيرايا

241
00:17:44,940 --> 00:17:48,480
قال ساسكي أنّه سيقطع روابطه بي

242
00:17:48,510 --> 00:17:49,880
ويصبح أقوى

243
00:17:50,550 --> 00:17:53,250
قال أنّني لن أفهم مشاعره أبداً

244
00:17:57,490 --> 00:18:01,290
كنتَ صديقاً لأوروتشيمارو منذُ زمن
بعيد، أليس كذلك أيّها الناسك المنحرف؟

245
00:18:01,720 --> 00:18:04,320
لماذا هجرَ أوروتشيمارو القرية

246
00:18:04,360 --> 00:18:06,260
وقرّرَ أن يدمِّر قرية الورق؟

247
00:18:07,970 --> 00:18:12,430
تغيّرَ أوروتشيمارو بعد مقتل والديه

248
00:18:13,030 --> 00:18:16,030
أصبحَ مهووساً بالتقنيّة المحرَّمة

249
00:18:17,540 --> 00:18:20,110
...ربّما اشتاقَ لرؤية والديه

250
00:18:20,510 --> 00:18:22,440
،أو ابتغى الانتقام من قرية الورق

251
00:18:22,480 --> 00:18:24,380
التي كانَتْ مسؤولة عن وفاتهما

252
00:18:25,340 --> 00:18:28,790
والدايّ لم يُقتَلا

253
00:18:29,420 --> 00:18:31,290
،لِذا فأنا مثلك

254
00:18:31,320 --> 00:18:35,090
اتُّهِمتُ بأنّني لن أفهم مشاعره

255
00:18:35,790 --> 00:18:37,200
،لعلَّه كان مُحِقّاً

256
00:18:37,230 --> 00:18:40,400
...ولم أفهم أي شيء عنه

257
00:18:45,430 --> 00:18:46,900
...لكن

258
00:18:47,510 --> 00:18:52,840
حتّى أنا أرى بوضوح كثيراً من الكراهيّة
في عالمنا، عالم النّينجا

259
00:18:53,640 --> 00:18:54,910
كراهيّة؟

260
00:18:55,410 --> 00:18:58,950
،وأردتُ أن أفعل شيئاً حيال هذه الكراهيّة

261
00:18:59,120 --> 00:19:02,320
ومع هذا لا أدري ماذا يجب أن أفعل

262
00:19:02,920 --> 00:19:04,880
...لكنّني مُؤمن

263
00:19:04,920 --> 00:19:07,160
بأنّ الوقت سيحين

264
00:19:07,190 --> 00:19:09,830
عندما يفهم النّاس بعضهم الآخر حقّاً

265
00:19:11,130 --> 00:19:13,460
يبدو الأمر معقّداً برمّته

266
00:19:14,030 --> 00:19:16,390
،وإذا لم أعثر على الإجابة

267
00:19:16,430 --> 00:19:19,700
فقد أأتَمِنُك بالعثور عليها

268
00:19:20,040 --> 00:19:23,870
،حاضر! لا أرفضُ لكَ طلباً
أليس كذلك أيّها الناسك المُنحرِف؟

269
00:19:25,840 --> 00:19:28,780
ماذا؟ لماذا تضحك؟

270
00:19:28,810 --> 00:19:31,750
ابتسامتُك هي خلاصي

271
00:19:34,250 --> 00:19:36,780
أنا مسرورٌ لأنّني جعلتُك تلميذي

272
00:19:36,920 --> 00:19:38,460
حـ-حقّاً؟

273
00:19:39,520 --> 00:19:42,590
لكنّني لم أستسلم بعد

274
00:19:48,500 --> 00:19:50,300
بكتُب لا تحقِّق أي مبيعات؟

275
00:19:50,370 --> 00:19:51,770
!أيّها الأحمق

276
00:19:51,800 --> 00:19:53,470
!سُرعان ما ستُصبح الأفضل مبيعاً

277
00:19:53,500 --> 00:19:55,230
،وعندما يحين ذلك اليوم أخيراً

278
00:19:55,270 --> 00:19:57,280
!فلن أوقِّع على نسختِك مهما توسّلتَ إليّ

279
00:19:57,340 --> 00:19:58,840
!لستُ بحاجة إلى ذلك

280
00:20:02,180 --> 00:20:03,510
...لستُ بحاجة إلى ذلك

281
00:20:07,520 --> 00:20:12,750
...لأنّك أيّها الناسك المنحرف
منحتَني شيئاً ذا قيمة أثمن بكثير

282
00:20:29,340 --> 00:20:32,810
يستغرق هذا وقتاً طويلاً
بوجود عددٍ قليل من النّاس

283
00:20:32,870 --> 00:20:34,040
!اصمت

284
00:20:34,070 --> 00:20:36,110
اهدأ وركِّز

285
00:20:49,060 --> 00:20:50,660
...يبدو

286
00:20:50,690 --> 00:20:53,090
أنَّ ساسكي قد أخطأ

287
00:20:58,540 --> 00:21:00,740
!ساق أخطبوط

288
00:21:00,770 --> 00:21:01,840
!كفّ عن الضّحك