1
00:01:30,900 --> 00:01:35,910
قرارُ هانابي

2
00:01:42,910 --> 00:01:46,370
وُلِدتُ بقوّةٍ تتفوّقُ على قوّةِ أختي الكبيرة

3
00:01:49,460 --> 00:01:51,000
هذا هو قدَري

4
00:01:53,160 --> 00:01:54,250
...لِهذا السّبب

5
00:01:54,330 --> 00:01:56,160
يجبُ أن أصبِحَ أقوى

6
00:02:01,830 --> 00:02:05,330
المزيد، المزيد، المزيد، المزيد

7
00:02:13,500 --> 00:02:15,500
انظري إلى جروحكِ

8
00:02:16,540 --> 00:02:19,040
ألا تُلاحظين أنّكِ تُبالغين قليلاً؟

9
00:02:19,410 --> 00:02:20,710
أبداً

10
00:02:21,540 --> 00:02:24,040
يجبُ أن أحمي عشيرةَ هيوغا

11
00:02:28,500 --> 00:02:29,500
أوه هذا صحيح

12
00:02:29,580 --> 00:02:33,160
يبدو أنّ هيناتا-ساما تبلي بلاءً حسناً كنينجا جينين

13
00:02:33,540 --> 00:02:37,040
سمِعتُ أنَّها تخضعُ لامتحانِ تشونين

14
00:02:37,460 --> 00:02:38,710
امتحان تشونين؟

15
00:02:39,160 --> 00:02:41,660
نعم. امتِحان يجبُ على النِّينجا اجتيازه

16
00:02:41,750 --> 00:02:44,290
كي يترقَّى من رتبةِ جينين إلى تشونين

17
00:02:45,410 --> 00:02:48,540
ولكن أعلمُ أنَّه صارم وفيه مُجازفة كبيرة

18
00:02:49,750 --> 00:02:52,910
لا فائدة من المُشارَكةِ في شيءٍ كهذا

19
00:02:56,290 --> 00:02:57,410
...هانابي-ساما

20
00:03:08,460 --> 00:03:10,080
هانابي-ساما، أنباء سيّئة

21
00:03:15,290 --> 00:03:18,080
مشفى كونوها

22
00:03:20,910 --> 00:03:23,080
سمِعتُ أنَّ أختي الكبيرة هيناتا قد جُرِحَتْ جروحاً بليغة

23
00:03:24,120 --> 00:03:26,500
لقد تمَّتْ مُعالجتها وهي في وعيها الآن

24
00:03:26,710 --> 00:03:28,080
لا داعي للقلق

25
00:03:34,080 --> 00:03:38,160
كانَ ينبغي أن تتوقّعَ هذه النَّتيجة إذا واجهَتْ نيجي

26
00:03:39,210 --> 00:03:40,910
لماذا لم تنسحبي؟

27
00:03:42,000 --> 00:03:44,790
لم أستطِع .. فعل ذلك

28
00:03:46,460 --> 00:03:50,120
أعرفُ جيِّداً ما أكون

29
00:03:50,790 --> 00:03:53,370
أنا فاشِلة متردِّدة

30
00:03:54,080 --> 00:03:57,410
...ولكن لا أريدُ أن أستسلِم، أريدُ أن أصبحَ أقوى

31
00:03:58,540 --> 00:04:00,790
أشعرُ وكأنّني قد أستطيع التغيُّر

32
00:04:01,120 --> 00:04:03,370
مشاهدةُ ناروتو تجعلُني أشعرُ هذا الشُّعور

33
00:04:03,790 --> 00:04:04,910
ناروتو

34
00:04:05,330 --> 00:04:08,750
ماذا تفعلُ هُنا؟ أنتَ لعنةٌ علينا جميعاً

35
00:04:09,250 --> 00:04:11,040
...ماذا؟ كنتُ فقط

36
00:04:11,370 --> 00:04:14,370
كنتُ أشاهدُ الأقنِعة

37
00:04:19,370 --> 00:04:20,540
مهارةُ النّسخ

38
00:04:24,790 --> 00:04:27,710
أنا لا أتراجع عن كلِمَتي أبداً

39
00:04:28,000 --> 00:04:30,830
لأنّ هذا منهجي كنينجا

40
00:04:40,410 --> 00:04:44,830
...لم يرِثْ أحدٌ دماءَ هيوغا أكثر منه

41
00:04:46,330 --> 00:04:48,210
شاهدي بعناية يا هانابي

42
00:04:48,410 --> 00:04:50,210
نعم يا أبي

43
00:04:54,710 --> 00:04:58,460
ما الذي يجعل أختي الكبيرة تؤمِنُ إلى هذا الحدّ بناروتو؟

44
00:05:02,370 --> 00:05:05,830
ولكن لنرَ كيفَ يُهاجِم أخي الكبير نيجي

45
00:05:06,500 --> 00:05:08,540
أخي الكبير نيجي هو عبقريّ هيوغا

46
00:05:09,790 --> 00:05:12,290
مُحال لفاشِل مثله أن يهزمَه

47
00:05:13,160 --> 00:05:14,540
سأربحُ مهما كلّفَ الأمر

48
00:05:20,290 --> 00:05:23,750
تقنية القبضة الرّقيقة: الهاكي ذو الأربعة وستّين كفّاً

49
00:05:24,870 --> 00:05:26,120
...الهاكي

50
00:05:26,540 --> 00:05:28,000
كفَّان

51
00:05:30,080 --> 00:05:31,160
أربعة كفوف

52
00:05:32,040 --> 00:05:34,410
– يُولَدُ الناسُ وهم يحملون
– ثمانية كفوف

53
00:05:34,500 --> 00:05:35,960
قدَراً بالفطرة

54
00:05:36,040 --> 00:05:38,040
– لا يُمكنك الاعتراض عليه
– ستّة عشر كفّاً

55
00:05:38,910 --> 00:05:42,040
لا يمكنُك أن تفهم –
اثنا وثلاثون كفّاً –

56
00:05:42,120 --> 00:05:44,160
قدَرُ العبء

57
00:05:44,410 --> 00:05:46,370
علامة لا يُمكِن مسحها للأبد

58
00:05:46,580 --> 00:05:48,250
...أربعة وستُّون كفّاً

59
00:05:52,460 --> 00:05:54,290
لقد قُهِر

60
00:05:55,040 --> 00:05:57,160
...تمَّ سدّ كافّة نقاط التشاكرا لديه

61
00:05:57,250 --> 00:05:59,330
ولا يستطيعُ حتَّى أن يكوِّنَ التشاكرا

62
00:06:00,160 --> 00:06:01,160
عرفتُ ذلك

63
00:06:02,160 --> 00:06:06,160
قدرُك أن تخسرَ أمامي... مهما حدث

64
00:06:06,410 --> 00:06:09,460
لن أعرِفَ ذلك قبلَ أن أحاول

65
00:06:16,500 --> 00:06:17,330
خاسِر

66
00:06:22,660 --> 00:06:25,080
...لن أهرب

67
00:06:25,540 --> 00:06:29,160
أنا ألتزِم بكلامي

68
00:06:29,790 --> 00:06:33,290
لن أخسرَ أمام شخصٍ يُثرثِرُ عن المَصير

69
00:06:33,370 --> 00:06:37,160
شخص يظلُّ يهرب

70
00:06:49,830 --> 00:06:53,290
لا أعرِف شيئاً عن قدَرِ الكراهيّة لدى عشيرة هيوغا

71
00:06:53,370 --> 00:06:56,620
ولكن عندما تقولُ أنَّ القدَرَ لا يتغيَّر
فهذا يعني أن لا تفعل شيئاً

72
00:06:56,910 --> 00:06:58,710
...بعدما أصبِحُ الهوكاغي

73
00:06:58,790 --> 00:07:01,120
سأغيِّرُ الهيوغا

74
00:07:19,960 --> 00:07:22,540
الرّابِحُ هو ناروتو أوزوماكي

75
00:07:23,210 --> 00:07:26,000
انتصرَ ذلك الصبيّ على هيوغا

76
00:07:26,080 --> 00:07:27,080
حقّاً؟

77
00:07:36,120 --> 00:07:39,830
قدرُك هو أن تخسرَ أمامي... مهما حدث

78
00:07:40,330 --> 00:07:43,410
لا أعرِف ما لم أحاول

79
00:07:45,580 --> 00:07:48,790
لا .. لقد كانَ ذلك مجرَّد حظّ حتماً

80
00:07:59,500 --> 00:08:03,000
ولكن ظننتُ أنَّ أخي الكبير
نيجي يكرهُ العائلةَ الرئيسيّة؟

81
00:08:05,580 --> 00:08:09,410
تبّاً، لم أتوقّع أن تأتي وتُساعدني في التَّدريب

82
00:08:10,540 --> 00:08:12,250
قد تكون على حقّ

83
00:08:12,460 --> 00:08:15,080
لكنّه علّمَني شيئاً

84
00:08:15,460 --> 00:08:18,040
يمكنُ تغيير ذلك القدَر

85
00:08:18,330 --> 00:08:19,540
أخي الكبير نيجي

86
00:08:20,120 --> 00:08:21,710
حسناً، لنُتابع

87
00:08:21,960 --> 00:08:22,750
نعم

88
00:08:31,160 --> 00:08:33,250
لكنَّه علّمَني شيئاً

89
00:08:33,540 --> 00:08:36,160
أنَّ القدَر يمكنُ تغييره

90
00:08:37,460 --> 00:08:39,330
يمكنُ تغيير القدَر؟

91
00:08:40,540 --> 00:08:42,870
...أي أنّ جميعنا

92
00:08:43,460 --> 00:08:45,250
ضعي في الحسبانِ يا هانابي

93
00:08:45,750 --> 00:08:50,870
أنَّ جميعنا نولَدُ في هذا العالم نحملُ قدرَنا الخاصّ

94
00:08:51,500 --> 00:08:54,830
لا يُمكِن لذلك القدَر أن يتغيَّرَ طوالَ العمر

95
00:09:03,000 --> 00:09:04,460
أنا ما أنا عليه

96
00:09:05,040 --> 00:09:07,370
كلّ ما عليّ هو أن أظلَّ أطمحُ للقمّة

97
00:09:16,540 --> 00:09:18,540
المزيد من فضلِك

98
00:09:20,120 --> 00:09:22,960
هذا الدَّورانُ هو مهارةُ نينجا تمّ توارثها شفويّاً فقط

99
00:09:23,040 --> 00:09:24,500
ولا تعرفها إلَّا عشيرة هيوغا

100
00:09:25,040 --> 00:09:27,540
إنّها ليسَتْ تقنيّة بمقدوركِ إتقانها بسهولة

101
00:09:28,500 --> 00:09:32,370
لا، سأُتقِنها خلالَ فترةٍ قصيرة

102
00:09:35,460 --> 00:09:38,000
...لن أقبعَ في مكاني بعدَ الآن

103
00:09:38,370 --> 00:09:41,000
يجبُ أن أصبحَ أقوى بكثير

104
00:09:45,330 --> 00:09:48,370
لم أستطِع إتقانها إذاً

105
00:09:51,410 --> 00:09:52,830
صدّقني

106
00:09:53,160 --> 00:09:55,080
كانَ ناروتو مُذهِلاً

107
00:09:55,370 --> 00:09:57,500
...سحقَ كاكوزو، ذلك الرّجُل ذو القلوب المتعدِّدة

108
00:09:57,580 --> 00:10:00,410
بمهارةِ اقضِ عليه رهيبة جديدة

109
00:10:00,540 --> 00:10:04,000
اقضِ عليه؟ ألا يوجدُ وصفٌ أفضل؟

110
00:10:06,460 --> 00:10:09,000
...كانَتْ ضخمة بعض الشيء

111
00:10:09,080 --> 00:10:11,500
أطلقَ عليها أسلوب الرّياح: راسين شوريكين الهائلة

112
00:10:12,290 --> 00:10:16,540
حاكَ رياحاً مع الراسينغان؟

113
00:10:17,040 --> 00:10:18,540
نعم، ربّما

114
00:10:20,410 --> 00:10:23,410
رائع، يظلُّ ناروتو يتحسَّن

115
00:10:23,960 --> 00:10:25,540
يجبُ أن أفعلَ ما بوسعي أيضاً

116
00:10:26,000 --> 00:10:28,870
قد تكون هذه لمحة لمهارةٍ جديدة

117
00:10:30,580 --> 00:10:33,040
هل تقصدُ الفترة الأخيرة

118
00:10:33,120 --> 00:10:34,870
الّتي سحقَ فيها ناروتو الأكاتسكي؟

119
00:10:35,120 --> 00:10:37,040
لم يكُن مذهلاً هكذا منذُ ثلاث سنوات

120
00:10:37,120 --> 00:10:38,460
لكنّه أصبحَ أقوى فأقوى

121
00:10:38,710 --> 00:10:42,410
نعم، بدأ الجميعُ في جيلِه يحترِمونه

122
00:10:42,500 --> 00:10:44,790
وأخذُ يتطوّرُ بثبات

123
00:10:59,680 --> 00:11:00,890
الدَّوران

124
00:11:06,390 --> 00:11:09,270
!ليسَ مجدّداً! لمَ لا أستطيع إتقانها جيّداً؟

125
00:11:13,270 --> 00:11:15,140
يكفي اليوم

126
00:11:15,390 --> 00:11:17,230
أرجوك اسمحْ لي أن أستمرّ

127
00:11:17,430 --> 00:11:18,430
في المرّةِ المُقبِلة، سأحرصُ على فعلِها

128
00:11:19,180 --> 00:11:22,480
لا يمكنُكِ إتقانها بالعجَلة

129
00:11:23,230 --> 00:11:25,600
أحياناً، من الأفضل إعطائها الوقت للانخراطِ فيها

130
00:11:32,640 --> 00:11:38,100
من غير المُعتاد أن أرى هانابي تواجهُ وقتاً عصيباً هكذا

131
00:11:38,480 --> 00:11:39,230
...نعم

132
00:11:39,930 --> 00:11:42,640
...عملياً، ينبغي ألَّا تواجه مُشكِلة

133
00:11:44,430 --> 00:11:47,980
ربَّما يعترِضُ شيء آخر طريقَها

134
00:11:59,520 --> 00:12:01,100
يجبُ أن أستمرّ

135
00:12:01,680 --> 00:12:03,770
لا أملُك خياراً آخر سِوى الاستمرار

136
00:12:09,100 --> 00:12:10,180
لماذا؟

137
00:12:40,270 --> 00:12:42,560
أنتِ بارعةٌ جدّاً من حيثُ الشَّكل

138
00:12:43,600 --> 00:12:46,640
نعم... لن أدع ناروتو يسبقني

139
00:13:00,680 --> 00:13:02,520
...لماذا أنا

140
00:13:06,140 --> 00:13:08,680
...لا ينبغي أن يتكرّرَ ما حدثَ في تِلك المرّة

141
00:13:20,140 --> 00:13:22,350
لماذا لم تستسلِم؟

142
00:13:22,430 --> 00:13:26,640
...لقد اعتُبِرَتْ فاشِلة وتجاهلَها أبي

143
00:13:27,140 --> 00:13:29,980
ومع ذلك، تبدو سَعيدة للغاية

144
00:13:30,930 --> 00:13:32,230
جميل

145
00:13:32,390 --> 00:13:34,680
هل يمكنُكِ البقاء هكذا وتتحوَّلين لتغيير الشَّكل؟

146
00:13:35,230 --> 00:13:35,980
نعم

147
00:13:39,270 --> 00:13:42,730
!أمن المعقول أنّها على وشك إتقان مهارة جديدة؟

148
00:13:52,980 --> 00:13:54,890
قويّة للغاية... ومع ذلك لطيفة

149
00:13:54,980 --> 00:13:57,180
أريدُ أن أكونَ مثلها

150
00:14:01,480 --> 00:14:02,430
أختي الكبيرة؟

151
00:14:14,100 --> 00:14:17,810
هانابي-ساما، كيفَ كانَتْ جولتكِ الدبلوماسيّة؟

152
00:14:18,180 --> 00:14:21,230
الخروجُ من جدرانِ القرية جعلَني أتوتّر فعلاً

153
00:14:21,730 --> 00:14:23,390
لكنّكِ أبليتِ حسناً

154
00:14:23,850 --> 00:14:27,980
لطالما كانَت عشيرة تاكيتوري حليفاً مهمّاً لهيوغا

155
00:14:28,600 --> 00:14:31,850
من المهمّ الحِفاظ على روابطِن
ا في جيلكِ أيضاً يا هانابي-ساما

156
00:14:32,350 --> 00:14:33,270
نعم

157
00:14:34,350 --> 00:14:35,480
...منذُ لحظة

158
00:14:36,100 --> 00:14:38,560
هياشي هيوغا-ساما وفريقه على ما أظن؟

159
00:14:38,850 --> 00:14:40,020
ما الأمر؟

160
00:14:40,310 --> 00:14:42,270
أنا حارِسٌ على الحدود

161
00:14:42,770 --> 00:14:44,680
تلقّينا نبأ عاجلاً

162
00:14:44,770 --> 00:14:48,060
الأكاتسكي يُهاجِمون قريةَ كونوها

163
00:14:48,270 --> 00:14:49,270
!ماذا؟

164
00:14:49,310 --> 00:14:51,730
أسرِعوا، يجبُ أن نعودَ إلى القريةِ حالاً

165
00:15:05,930 --> 00:15:07,100
هذا فظيع

166
00:15:12,390 --> 00:15:15,230
لقد دُمِّرَتْ قريةُ كونوها إلى حدٍّ يفوقُ الخيال

167
00:15:16,270 --> 00:15:18,100
ماذا حلَّ بالجميع؟

168
00:15:18,270 --> 00:15:20,770
هياشي-ساما، تسرّني سلامتك

169
00:15:21,350 --> 00:15:22,390
...هذا الدَّمار

170
00:15:23,230 --> 00:15:25,350
كم عددُ القتلى؟

171
00:15:25,980 --> 00:15:29,020
المُعجِزة أنَّه لم يمُتْ أحد

172
00:15:30,180 --> 00:15:32,390
...هذا مُستحيل ! رُغمَ كلّ هذا الدَّمار

173
00:15:32,730 --> 00:15:33,770
نعم

174
00:15:34,270 --> 00:15:37,270
ناروتو حمى الجميع

175
00:15:37,730 --> 00:15:40,560
ولكن بفضلِ هيناتا-ساما فقط

176
00:15:40,930 --> 00:15:42,060
ماذا تعني؟

177
00:15:42,350 --> 00:15:45,480
لقد تعرّضَتِ القريةُ لهجومٍ
...بواسطةِ زعيم الأكاتسكي باين

178
00:15:45,560 --> 00:15:47,640
وكانَتْ على شفا حفرةٍ من الانهيار

179
00:15:48,180 --> 00:15:50,930
وفي تِلك اللّحظة، كانَ الوحيد القادر على التّعامل مع باين

180
00:15:51,020 --> 00:15:52,520
ناروتو أوزوماكي

181
00:15:53,890 --> 00:15:55,810
...ولكن حتّى ناروتو -
باين -

182
00:15:55,890 --> 00:15:57,310
قد أرهِقَ تماماً -
حقير -

183
00:15:57,430 --> 00:16:00,230
أظنُّني سآخذُك الآن

184
00:16:06,180 --> 00:16:08,230
...والشّخصُ الّذي تصرَّف فوراً

185
00:16:08,310 --> 00:16:09,640
كان هيناتا-ساما

186
00:16:19,520 --> 00:16:20,850
...يا لقسوتك

187
00:16:21,230 --> 00:16:24,430
تقيِّدُ حركةَ ناروتو بهذه الأعمِدة

188
00:16:25,180 --> 00:16:27,100
لن أدعَك تؤذي ناروتو بعدَ الآن

189
00:16:27,520 --> 00:16:28,640
...أعلمُ

190
00:16:29,430 --> 00:16:32,100
أنَّني أنانيّة

191
00:16:32,140 --> 00:16:33,770
!عمّاذا تتكلّمين؟

192
00:16:34,230 --> 00:16:37,270
لا تعرِّضي نفسكِ للخطرِ هكذا

193
00:16:38,680 --> 00:16:41,730
أنا هُنا بناء على رغبتي

194
00:16:42,680 --> 00:16:43,810
...هذه المرَّة

195
00:16:43,890 --> 00:16:46,020
سأُنقِذُك يا ناروتو

196
00:16:49,520 --> 00:16:52,560
لطالما بكيتُ واستسلمتُ حتّى قبلَ أن أحاول

197
00:16:52,890 --> 00:16:55,430
...ارتكبتُ الأخطاءَ كثيراً

198
00:16:56,430 --> 00:17:00,480
لكنّك ساعدتَني على سلوكِ الطَّريق الصَّحيح يا ناروتو

199
00:17:02,060 --> 00:17:04,020
لطالما تبِعتُك

200
00:17:04,520 --> 00:17:06,680
أردتُ أن أُجاريك

201
00:17:08,180 --> 00:17:11,180
أردتُ أن أمشي بجانبِك طوالَ الوقت

202
00:17:11,520 --> 00:17:13,770
أريدُ أن أكونَ إلى جانبِك دائماً

203
00:17:15,100 --> 00:17:17,060
لقد غيّرتَني يا ناروتو

204
00:17:18,520 --> 00:17:21,230
ابتسامتُك أنقذَتْني

205
00:17:23,140 --> 00:17:26,180
لِهذا لا أخشى الموت

206
00:17:26,310 --> 00:17:28,230
إذا كانتِ الغاية حِمايتك

207
00:17:33,560 --> 00:17:35,180
...هذا لأنَّني

208
00:17:35,270 --> 00:17:37,930
أُحِبُّك يا ناروتو

209
00:17:45,230 --> 00:17:48,520
هيناتا-ساما حمَتْ ناروتو قاتلَتْ حتّى النهاية

210
00:17:56,810 --> 00:17:59,100
الخطوة الرّقيقة... قبضتا الأسد التّوأم

211
00:18:00,100 --> 00:18:04,020
نتيجة ذلك، قلبَتِ الوضعَ غير المُستحبّ الّذي كنَّا فيه

212
00:18:06,230 --> 00:18:08,060
هيناتا فعلَتْ ذلك؟

213
00:18:17,430 --> 00:18:20,980
إذاً أختي الكبيرة قد استخدمَتْ تِلك المهارة

214
00:18:24,600 --> 00:18:26,810
...كم كانَتْ مُفاجأة

215
00:18:27,100 --> 00:18:31,020
لا أصدِّق أنَّ هيناتا كانَتْ قادِرة على كلّ هذا

216
00:18:38,350 --> 00:18:42,640
أراهنُ أنَّ أختي الكبيرة لم تكُن فاشِلة إطلاقاً

217
00:18:43,770 --> 00:18:45,310
أختي الكبيرة هيناتا

218
00:18:58,310 --> 00:19:01,520
ولكن لا أريدُ أن أستسلِم، أريدُ أن أصبحَ قويّة

219
00:19:02,140 --> 00:19:04,180
أشعرُ وكأنَّني قادِرة على التغيُّر

220
00:19:05,060 --> 00:19:07,230
مشاهدةُ ناروتو تجعلُني أشعرُ هذا الشُّعور

221
00:19:07,930 --> 00:19:10,930
أنا لا أتراجعُ أبداً عن كلِمَتي

222
00:19:11,060 --> 00:19:14,140
لأنَّ هذا منهجي كنينجا

223
00:19:15,310 --> 00:19:18,230
نعم... لن أخسرَ أمام ناروتو

224
00:19:18,480 --> 00:19:22,100
اختارَتْ ببساطة الطّريقَ الّذي
ينبغي أن تسلكَه بمحضِ إرادتها

225
00:19:23,180 --> 00:19:25,140
...وأصبحَتْ بهذه القوّة

226
00:19:26,810 --> 00:19:28,730
غيّرَتْ قدرَها

227
00:19:30,980 --> 00:19:34,020
بقيَتْ أختي الكبيرة على طبيعتِها

228
00:19:34,140 --> 00:19:36,060
لطيفة وقويّة

229
00:19:36,350 --> 00:19:38,310
الشّخص الّذي أحبُّه كثيراً

230
00:19:42,100 --> 00:19:44,140
أبي، لديّ طلب

231
00:19:45,310 --> 00:19:48,100
أعلمُ بأنَّك ستكونُ مشغولاً بإعادةِ إعمار القرية

232
00:19:49,230 --> 00:19:50,230
ولكن عندما تنتهي

233
00:19:50,310 --> 00:19:52,180
هلَّا درّبتَني مرّة أخرى؟

234
00:19:54,600 --> 00:19:56,850
ينتابُني إحساسٌ بأنّكِ ستُتقنينها في المرّة المُقبِلة

235
00:19:57,270 --> 00:19:58,310
نعم

236
00:19:59,180 --> 00:20:02,310
أريدُ أن أصبحَ مثل أختي الكبيرة هيناتا يوماً ما

237
00:20:03,230 --> 00:20:08,600
وأختار طريقي بنفسي دون أن يُملي عليّ أحدٌ شيئاً

238
00:20:15,180 --> 00:20:16,140
اسمعوا جميعاً

239
00:20:16,140 --> 00:20:19,270
نحنُ الآن على مشارِف حرب النِّينجا العظيمة الرّابِعة

240
00:20:19,430 --> 00:20:21,560
...سنستفيدُ من مهاراتِ حواسنا

241
00:20:21,640 --> 00:20:23,850
ونوزِّع أنفُسنا لدعمِ كلّ كتيبة

242
00:20:24,230 --> 00:20:27,310
يجبُ أن نقودَهم للنصرِ في هذه الحرب

243
00:20:27,520 --> 00:20:28,850
حاضر

244
00:20:29,600 --> 00:20:31,850
هانابي، تولّي زمامَ الأمور هُنا

245
00:20:32,100 --> 00:20:33,230
اعتمدي عليّ

246
00:20:33,310 --> 00:20:36,560
لقد صنعتُ قراري فيما يتعلّقُ بحمايةِ هيوغا

247
00:20:37,100 --> 00:20:40,060
والأهم، كوني أنتِ الحذِرة يا أختي الكبيرة هيناتا

248
00:20:40,270 --> 00:20:44,230
حسناً. سأستخدمُ عليهم كلّ ما تعلّمتُه

249
00:20:45,140 --> 00:20:47,560
سأحمي ناروتو

250
00:20:49,270 --> 00:20:51,230
افعلي ما بوسعكِ يا أختي الكبيرة هيناتا

251
00:20:51,930 --> 00:20:53,020
نعم

252
00:22:36,580 --> 00:22:38,960
حانَ دوري للهجومِ الآن

253
00:22:39,380 --> 00:22:41,170
كفّ عن ادِّعاءِ القوّة، انتهتِ الحرب

254
00:22:41,830 --> 00:22:44,880
أنا مُمتنٌّ لكَ يا ناروتو

255
00:22:45,290 --> 00:22:48,170
لقد استخرجتَ وحوش الذّيول من أوبيتو

256
00:22:48,250 --> 00:22:51,580
لتوفّر عليّ عناء إضعافه

257
00:22:52,080 --> 00:22:54,420
أستطيعُ أخيراً أن أقاتلَ بجدِّية

258
00:22:54,960 --> 00:22:59,080
الحلقة القادمة من ناروتو شيبّودن: نهوضُ مادارا أوتشيها

259
00:22:59,670 --> 00:23:03,330
إنّها معركةٌ لا تخلو من الدِّماءِ المغليّة والقلب النّابِض