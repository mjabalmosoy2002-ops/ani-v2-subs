1
00:00:11,250 --> 00:00:14,110
لم أتوقّع أن تتحرّك ذراعه من تلقاء نفسها

2
00:00:14,110 --> 00:00:15,720
...بعد أن فُصلت من جسده

3
00:00:16,250 --> 00:00:18,270
لكن متى حدث ذلك؟

4
00:00:19,520 --> 00:00:22,710
!هل حدث ذلك عندما هاجمتُ بالورقة المتفجّرة؟

5
00:00:23,420 --> 00:00:26,250
وضع يده تحت الأرض بينما
.كان داخل الدّخان

6
00:00:27,070 --> 00:00:29,840
.تبًّا، هذا ما توقّعتُه من الأكاتسكي

7
00:00:29,840 --> 00:00:32,340
!يستعمل جميعهم تقنيّات مجنونة

8
00:00:33,850 --> 00:00:39,250
،قلتَ أنّه قد قُضي علينا
.لكنّ قواي ما تزال مجهولة لديك

9
00:00:39,950 --> 00:00:43,720
لذلك حافظتَ على مسافة بيننا
.عندما قمتَ بحركتك التّالية

10
00:00:44,350 --> 00:00:47,070
.أنت ذكيّ على عكس شريكي

11
00:00:50,320 --> 00:00:51,880
!...سُحقًا! إنّ جسدي

12
00:00:53,120 --> 00:00:55,320
!كاكوزو، افعل شيئًا

13
00:00:58,230 --> 00:00:59,200
!سُحقًا

14
00:00:59,450 --> 00:01:00,660
!الآن يا تشوجي

15
00:01:01,370 --> 00:01:03,790
!الطّلقة البشريّة الشائكة

16
00:01:04,040 --> 00:01:06,120
!كاكوزو

17
00:01:22,650 --> 00:01:24,770
...يا-يا لها من قوّة

18
00:01:36,050 --> 00:01:39,110
.يبدو أنّ ناروتو لم يسترح على الإطلاق

19
00:01:39,820 --> 00:01:40,720
.لا يوجد خيار آخر

20
00:01:41,180 --> 00:01:44,290
عليه أن يكمل تقنيّته الجديدة

21
00:01:44,290 --> 00:01:47,070
وعلينا بعدها أن نتّجه إلى دعم
...كاكاشي سينسي والآخرين

22
00:01:48,870 --> 00:01:51,290
المهلة المحدّدة هي أربع وعشرون ساعة؟

23
00:01:51,620 --> 00:01:55,080
سيكون الأمر صعبًا، لكن كلّ ما يمكننا
.فعله هو أن نؤمن بناروتو

24
00:01:55,750 --> 00:01:56,630
،فقبل كلّ شيء

25
00:02:06,310 --> 00:02:11,940
لا يوجد من يمكنه العمل بسلاسة
.مع كاكاشي سينسي والآخرين عدانا

26
00:03:32,900 --> 00:03:37,540
قدرات كاكاوزو

27
00:03:48,850 --> 00:03:51,360
.جيّد. تكاد تكتمل

28
00:03:52,300 --> 00:03:55,830
.والآن... أستطيع اللّحاق بساسكي

29
00:03:58,030 --> 00:03:59,080
...بالطّبع يمكنك

30
00:03:59,830 --> 00:04:03,130
.ولكن، انتبه من عنصر النّار الخاصّ بساسكي

31
00:04:05,040 --> 00:04:10,100
أظنّ أنّ عليّ شرح نقاط ضعف وقوّة
.التّحوّلات الخمس لطبيعة التشاكرا

32
00:04:11,370 --> 00:04:14,230
ما هي نقاط الضّعف والقوّة هذه؟

33
00:04:14,470 --> 00:04:16,670
ببساطة، إنّها تعني أنّ التّحوّلات الخمس

34
00:04:16,700 --> 00:04:20,850
في طبيعة التشاكرا إلى نار وماء
وأرض وبرق وريح

35
00:04:20,850 --> 00:04:24,480
.لها نقاط ضعف وقوّة تربط فيما بينها

36
00:04:25,190 --> 00:04:27,190
لكن ما الّذي يعنيه ذلك؟

37
00:04:27,940 --> 00:04:30,530
.من السّهل شرح الأمر برسم بيانيّ

38
00:04:34,070 --> 00:04:36,160
.هنالك خمس تحوّلات في طبيعة التشاكرا

39
00:04:37,200 --> 00:04:40,830
.سنرسم أوّلاً العناصر الخمس على شكل دائرة

40
00:04:38,370 --> 00:04:41,660
نار
ريح          ماء
برق      أرض

41
00:04:40,830 --> 00:04:41,660
.نعم

42
00:04:42,300 --> 00:04:45,630
.وعلى سبيل المثال، سنأخذ النّار أوّلاً

43
00:04:46,200 --> 00:04:49,100
سأقوم بإضافة مقارنات من ناحية
.القوّة والضّعف إلى الرّسم

44
00:04:50,970 --> 00:05:01,520
نار

45
00:04:50,970 --> 00:05:01,520
ماء

46
00:04:50,970 --> 00:05:01,520
ريح

47
00:04:50,970 --> 00:05:01,520
أقوى                      أضعف

48
00:04:50,970 --> 00:05:01,520
أضعف

49
00:04:50,970 --> 00:05:01,520
أقوى

50
00:04:51,500 --> 00:04:55,000
،إنّ عنصر النّار أقوى من عنصر الرّيح

51
00:04:56,370 --> 00:05:00,970
لكنّه أضعف مقارنة بعنصر الماء
.في الجانب الآخر

52
00:05:02,060 --> 00:05:07,020
تحوّلات طبيعة التشاكرا الخمس لديها
.صلات قوّة وضعف مع بعضها البعض

53
00:05:11,030 --> 00:05:12,780
حسنًا... وبعد؟

54
00:05:15,070 --> 00:05:16,670
...لم يستوعب الأمر

55
00:05:17,900 --> 00:05:19,470
.سأشرح الأمر ببساطة أكثر

56
00:05:20,290 --> 00:05:27,040
يا ناروتو، تقنيّة عنصر الرّيح خاصّتك ضعيفة
.أمام تقنيّات عنصر النّار الخاصّة بساسكي

57
00:05:28,830 --> 00:05:31,050
عنصر الماء هو الوحيد القادر
.على هزيمة عنصر النّار

58
00:05:32,260 --> 00:05:35,220
لماذا لا يستطيع عنصر الرّيح
هزيمة عنصر النّار؟

59
00:05:36,000 --> 00:05:38,130
.قد يكون من السّهل تخيّل الأمر

60
00:05:38,700 --> 00:05:42,770
.يحترق الخشب بسرعة إلى نفخنا عليه

61
00:05:45,520 --> 00:05:49,570
ولكنّ النّار يمكنُ أن تنطفئ عندنا
.نسكب الماء عليها

62
00:05:51,770 --> 00:05:55,570
هذا يعني أنّك إن هاجمتَ إحدى
...تقنيّات عنصر النّار لدى ساسكي

63
00:05:55,570 --> 00:05:58,370
،بتقنيّة عنصر ريح من نفس القوّة

64
00:05:59,030 --> 00:06:02,200
.ستكون النّتائج عكسيّة وستصبح النّار أكبر

65
00:06:07,030 --> 00:06:09,730
.ولكن، انظر إلى النّاحية الأخرى للرّيح

66
00:06:10,430 --> 00:06:13,880
،صحيح أنّ الرّيح ضعيفة أمام النّار
.لكنّها قويّة في مواجهة البرق

67
00:06:14,720 --> 00:06:16,340
بكلمات أخرى، فإنّ تقنيتك الجديدة

68
00:06:16,340 --> 00:06:19,510
ستكون قويّة أمام تشيدوري ساسكي
.الّتي أساسها هو عنصر البرق

69
00:06:24,100 --> 00:06:24,930
...ناروتو

70
00:06:25,560 --> 00:06:28,720
من الجيّد أنّ تحوّل طبيعة التشاكرا
.خاصّتك ليس الأرض

71
00:06:33,830 --> 00:06:37,660
إذًا فأنا نظير جيّد لساسكي، صحيح؟

72
00:06:38,100 --> 00:06:40,910
.نعم، لا يمكن هزيمة البرق إلاّ بالرّيح

73
00:06:41,270 --> 00:06:43,270
.كلاّ، لم يكن ذلك ما قصدتُه

74
00:06:45,230 --> 00:06:48,960
أعني أنّ قوّة الرّيح هي الوحيدة
القادرة على مساعدة النّار

75
00:06:48,960 --> 00:06:51,000
.وذلك بجعل قوّتها أكبر

76
00:06:54,930 --> 00:06:56,800
...نعم، هذا صحيح

77
00:06:58,660 --> 00:07:00,030
!ناروتو

78
00:07:10,570 --> 00:07:12,110
.أنت مذهل

79
00:07:12,110 --> 00:07:12,520
!أجل

80
00:07:13,100 --> 00:07:15,110
.يبدو أنّ تدريبك يسير على ما يرام

81
00:07:15,730 --> 00:07:16,570
.أظنّ ذلك

82
00:07:16,990 --> 00:07:18,570
ستنتهي قريبًا إذًا، صحيح؟

83
00:07:19,860 --> 00:07:21,570
.كلاّ، تمهّل لحظة

84
00:07:24,790 --> 00:07:27,170
هل يمكنكم منحي المزيد من الوقت؟

85
00:07:28,300 --> 00:07:30,170
.ما زال هنالك أمر أودّ تجربته

86
00:07:43,700 --> 00:07:45,000
ما الّذي يحدث؟

87
00:07:46,230 --> 00:07:49,480
.عرفتُ هذا. هذا ما قاله رايدو سينباي تمامًا

88
00:08:10,530 --> 00:08:13,790
.قد تكون تقنيّةً لتصليب جسده

89
00:08:14,000 --> 00:08:16,550
...هذه قدرتُه

90
00:08:16,800 --> 00:08:18,690
.تحليل جيّد

91
00:08:19,830 --> 00:08:24,510
.هذا صحيح. لا تُجدي أيّ هجمات جسديّة ضدّي

92
00:08:25,270 --> 00:08:29,270
لقد توقّعتُ قدراتهما إلى درجة
...معيّنة، لكنّ هذا

93
00:08:30,100 --> 00:08:33,600
إن لم نستطع استعمال هجمات
مباشرة، فماذا يمكننا أن نفعل؟

94
00:08:34,370 --> 00:08:35,570
...شيكامارو

95
00:08:43,730 --> 00:08:46,700
!ارتعدوا خوفًا أيّها الملحدون الأوغاد

96
00:08:47,130 --> 00:08:50,540
!أجل! حان الوقت لنقوم بهجومنا المضادّ

97
00:08:51,130 --> 00:08:54,580
!كاكوزو، أبطل هذه التّقنيّة بسرعة

98
00:08:55,100 --> 00:08:56,030
...حسنًا

99
00:09:01,700 --> 00:09:02,730
...لا يُعقل

100
00:09:03,130 --> 00:09:05,800
.تسلّلتَ خلفي دون حتّى أن أشعر بك

101
00:09:09,130 --> 00:09:10,500
.هذا مؤسف

102
00:09:19,480 --> 00:09:22,450
!ارتعدوا خوفًا أيّها الملحدون الأوغاد

103
00:09:22,860 --> 00:09:26,280
!أجل! حان الوقت لنقوم بهجومنا المضادّ

104
00:09:26,870 --> 00:09:30,330
!كاكوزو، أبطل هذه التّقنيّة بسرعة

105
00:09:30,700 --> 00:09:31,660
...حسنًا

106
00:09:46,080 --> 00:09:47,250
...لا يُعقل

107
00:09:47,620 --> 00:09:50,350
.تسلّلتَ خلفي دون حتّى أن أشعر بك

108
00:09:52,930 --> 00:09:54,350
.هذا مؤسف

109
00:09:56,800 --> 00:09:57,800
.مذهل

110
00:09:58,260 --> 00:10:01,560
!ماذا؟! ما الّذي يجري هنا؟

111
00:10:01,560 --> 00:10:05,280
ظننتُ أنّه لا يُفترض بالهجمات
!الجسديّة أن تُجدي نفعًا ضدّك

112
00:10:05,520 --> 00:10:08,860
أجل! كيف تمكّنت من التّسلّل
!خلفه يا كاكاشي سينسي؟

113
00:10:11,240 --> 00:10:13,160
.رأيتُ كلّ شيء

114
00:10:13,160 --> 00:10:15,320
.رأيتُ التّقنيّة الّتي تستعملها لتصليب جسدك

115
00:10:15,740 --> 00:10:19,250
عرفتُ من خلال تشكليك للأختام اليدويّة
.سابقًا أنّك تستعمل عنصر الأرض

116
00:10:20,210 --> 00:10:25,700
...تمكّنتَ في تلك اللّحظة
من قراءة أختامي اليدويّة السّريعة؟

117
00:10:26,040 --> 00:10:28,590
.واستعملتَ تقنيّة عنصر برق من هذا المستوى

118
00:10:29,050 --> 00:10:33,300
!فهمت! أنت هو كاكاشي ذو الشّارينغان

119
00:10:33,760 --> 00:10:35,960
.عنصر الأرض ضعيف أمام عنصر البرق

120
00:10:36,460 --> 00:10:40,020
.لسنا ندّين جيّدين... قُضي أمرك

121
00:10:41,060 --> 00:10:43,360
!كاكاشي سينسي مذهل بكلّ تأكيد

122
00:10:43,360 --> 00:10:45,970
!بقي واحد فقط الآن

123
00:10:46,390 --> 00:10:50,070
كان ذلك سريعًا! هذا ما هو متوقّع
.من كاكاشي سينسي

124
00:10:50,360 --> 00:10:55,780
نعم. كانت الأمور لتكون أصعب بكثير
.إذا لم نقضِ على الفاني منهما أوّلاً

125
00:10:57,740 --> 00:10:59,460
هل أنت بخير يا شيكامارو؟

126
00:11:00,870 --> 00:11:02,960
.لا يبدو هذا جيّدًا

127
00:11:03,290 --> 00:11:04,460
!كاكاشي سينسي

128
00:11:05,950 --> 00:11:08,120
لقد بلغت تقنيّة محاكاة الظّلّ حدودها؟

129
00:11:25,600 --> 00:11:27,970
لقد نال من قلبك بضربة واحدة؟

130
00:11:27,970 --> 00:11:30,610
كيف سمحتَ لنفسك أن تُهاجم
!من البداية هكذا؟

131
00:11:30,610 --> 00:11:31,320
...سُحقًا

132
00:11:34,450 --> 00:11:36,360
.أنت التّالي

133
00:11:45,450 --> 00:11:46,120
!انتهى الأمر

134
00:12:06,050 --> 00:12:09,940
."حتّى أنّك تصرّفتَ بروعة وقلتَ "قُضي عليك

135
00:12:13,360 --> 00:12:14,910
ما الّذي يحدث؟

136
00:12:17,570 --> 00:12:19,450
.أنا واثق أنّي لم أخطئ النّقطة الحيويّة

137
00:12:19,910 --> 00:12:22,830
.حسنًا، لننهِ هذا الأمر في الحال

138
00:12:25,740 --> 00:12:27,410
!أنوي على ذلك

139
00:13:10,380 --> 00:13:12,090
...بلغت تقنيّة محاكاة الظّلّ حدودها

140
00:13:26,300 --> 00:13:28,860
أخبرني يا شيكامارو. ما الّذي يحدث؟

141
00:13:29,150 --> 00:13:34,320
ولماذا لم يمت رغم أنّه أصيب
بتقنيّة نصل البرق؟

142
00:13:36,790 --> 00:13:38,190
من يدري؟

143
00:13:38,700 --> 00:13:44,000
.لكن لن يفاجئني أيّ شيء مع هذين الرّجلين

144
00:13:49,460 --> 00:13:51,290
.يمكنني أن أتحرّك أخيرًا

145
00:13:52,800 --> 00:13:54,710
ما هذه الأشياء؟

146
00:13:55,370 --> 00:13:58,930
والآن... هلاّ بدأنا يا كاكوزو؟

147
00:13:58,930 --> 00:14:00,220
...أكيد

148
00:14:08,480 --> 00:14:10,480
!ما-ما هذه؟

149
00:14:12,630 --> 00:14:15,100
...ينتابني شعور سيّئ من تلك التشاكرا

150
00:14:17,690 --> 00:14:21,030
!يا مولاي جاشين! شاهدني

151
00:14:21,030 --> 00:14:24,370
!سوف أصبح جادًّا! أعني ما أقوله

152
00:14:24,660 --> 00:14:27,780
!سوف أمزّق أحشاءهم

153
00:14:31,880 --> 00:14:33,840
!انتبه يا تشوجي

154
00:14:33,840 --> 00:14:34,670
.حسنًا

155
00:14:57,770 --> 00:14:58,740
ماذا؟

156
00:15:05,070 --> 00:15:08,250
!كاكوزو! مهلاً! مهلاً! مهلاً

157
00:15:08,250 --> 00:15:12,580
!لقد مات إحداها بعد هجومنا الشّفهيّ تمامًا

158
00:15:12,600 --> 00:15:15,410
!يا إلهي، كم هذا مقيت

159
00:15:17,080 --> 00:15:20,880
بما أنّ إحدى الأقنعة الّتي خرجت
...من جسده قد ماتت

160
00:15:21,430 --> 00:15:26,050
فلا بدّ أنّه القناع الّذي أصبتُه
.بنصل البرق قبل قليل

161
00:15:27,170 --> 00:15:29,520
.يبدو أنّنا اكتشفنا أمرًا ما هنا

162
00:15:29,850 --> 00:15:34,360
.هيدان، تراجع لوهلة. سأهتمّ بهذا

163
00:15:34,360 --> 00:15:36,890
!مهلاً... انتظر لحظة

164
00:15:36,890 --> 00:15:40,570
لقد كنّا عرضة للهجمات طوال
.الوقت وهذا أغضبني

165
00:15:41,950 --> 00:15:43,700
.لنقم بالمعتاد

166
00:16:07,710 --> 00:16:09,680
!عنصر الرّيح: ضرر الضّغط

167
00:16:22,450 --> 00:16:24,070
!تشوحي! انتبه

168
00:16:32,460 --> 00:16:34,170
!كاكاشي سينسي

169
00:16:40,840 --> 00:16:42,590
!كاكاشي سينسي

170
00:16:43,380 --> 00:16:46,040
!مستحيل... لقد هاجم شريكه أيضًا؟

171
00:16:46,920 --> 00:16:49,510
!فهمت! إنّه يستفيد من كونه خالدًا

172
00:17:31,430 --> 00:17:33,730
!ها هو قادم يا تشوجي

173
00:17:38,730 --> 00:17:41,610
...كلاّ... إن أصيبا بذلك مباشرة

174
00:17:41,940 --> 00:17:44,240
!تشوجي، شيكامارو! اهربا

175
00:17:47,770 --> 00:17:49,620
!عنصر البرق: الظّلمة الزّائفة

176
00:17:54,120 --> 00:17:55,570
درع

177
00:17:54,370 --> 00:17:55,570
!لن أنجح في الوقت المناسب

178
00:18:07,620 --> 00:18:08,550
!انتبه

179
00:18:15,760 --> 00:18:17,470
!...كاكاشي سينسي

180
00:18:37,570 --> 00:18:38,710
هل أنت بخير؟

181
00:18:39,040 --> 00:18:40,920
...حسنًا... نوعًا ما

182
00:18:47,870 --> 00:18:50,470
.إنّهما قويّين

183
00:18:51,510 --> 00:18:53,510
.وذلك المقنّع على وجه الخصوص

184
00:18:55,260 --> 00:18:57,840
لا أحد قادر على استعمال هجوم
عنصر ما عالي المستوى كهذا

185
00:18:57,840 --> 00:19:01,520
.إلاّ إذا كان التّحوّل في طبيعة التشاكرا لديه بالفطرة

186
00:19:02,400 --> 00:19:07,020
.كما أنّه استعمل عناصر الأرض والرّيح والبرق

187
00:19:08,740 --> 00:19:10,570
ما الّذي يحدث؟

188
00:19:22,000 --> 00:19:23,630
.أثرتَ إعجابي

189
00:19:24,090 --> 00:19:30,880
أنت أوّل شخص لم نكن قادرين على قتله
.باستعمال تلك التّوليفة يا هاتاكي كاكاشي

190
00:19:31,800 --> 00:19:34,100
إذًا فقد رأيتها بالشّارينغان، صحيح؟

191
00:19:34,100 --> 00:19:35,880
!ولكن... ماذا عن الهجوم التّالي؟

192
00:19:39,890 --> 00:19:40,520
!ماذا؟

193
00:19:44,480 --> 00:19:46,560
!عنصر النّار: الصداع حارق