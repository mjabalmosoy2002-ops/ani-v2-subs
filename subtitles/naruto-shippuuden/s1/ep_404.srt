1
00:00:05,070 --> 00:00:08,320
،انطلاقاً من حامية جبينهن
...فهنّ ينتمين لقرية المطر

2
00:00:08,780 --> 00:00:11,650
أيّ لفيفة يملكن؟
السماء أم الأرض؟

3
00:00:24,880 --> 00:00:26,170
!كلّ ما تفعلنه هو الهروب

4
00:00:26,590 --> 00:00:28,210
!فلتكنّ لطيفات وتسلّمن لنا لفيفتكن

5
00:00:33,450 --> 00:00:34,370
ذلك لن يحدث

6
00:00:35,540 --> 00:00:36,200
...آجيساي

7
00:00:40,700 --> 00:00:41,700
!عنصر النار

8
00:00:42,110 --> 00:00:44,530
!جيتسو فكّ الختم! عاصفة الرقائق الورقيّة

9
00:01:00,770 --> 00:01:01,600
هل هربن؟

10
00:01:02,010 --> 00:01:04,630
!لقد أخافتهن قوتنا

11
00:01:05,340 --> 00:01:07,630
!فقط حينما كدنا نحصل على لفيفتهن

12
00:02:42,050 --> 00:02:47,060
مشاكل تينتِن

13
00:03:07,100 --> 00:03:08,300
...سيدتي الملاك

14
00:03:08,760 --> 00:03:12,590
،سيّدتي الملاك
ما هي مهمتنا الخاصة؟

15
00:03:14,040 --> 00:03:17,790
استغلّوا امتحانات الشونين للعثور على جينشوريكي

16
00:03:19,000 --> 00:03:20,500
جينشوريكي؟

17
00:03:21,700 --> 00:03:23,530
...سويرين، فويو

18
00:03:23,700 --> 00:03:28,990
استخدما مهارات الاستشعار الخاصة بكما
للبحث عن شينوبي يأوي كمّية هائلة من التشاكرا

19
00:03:29,580 --> 00:03:31,450
أذلك ما يعنيه جينشوريكي؟

20
00:03:32,400 --> 00:03:34,440
،حتى لو لم تعثرا على جينشوريكي

21
00:03:34,480 --> 00:03:39,320
أحضرا معلوماتٍ حول أيّ شينوبي استثنائي من قرى أخرى

22
00:03:39,900 --> 00:03:40,520
حاضر -
حاضر -

23
00:03:40,900 --> 00:03:43,100
وأنتِ ستتبعينهما يا آجيساي

24
00:03:44,140 --> 00:03:45,220
مفهوم

25
00:03:45,760 --> 00:03:48,810
إنّ قرية المطر في خضم الإصلاح

26
00:03:49,350 --> 00:03:51,560
لا يجب على القرى الأخرى أن تعرف هذا

27
00:03:52,420 --> 00:03:57,460
يجب أن يستمرّوا في التصديق أنّ
هانزو السمندر هو من يحكم قرية المطر

28
00:03:57,920 --> 00:03:58,800
!حاضر -
!حاضر -

29
00:04:05,620 --> 00:04:06,790
ما الأمر يا آجيساي؟

30
00:04:08,540 --> 00:04:11,490
...نستطيع أن نرى العديد من النجوم في القرى الأخرى

31
00:04:14,030 --> 00:04:15,110
!النجوم

32
00:04:16,030 --> 00:04:17,530
...إذاً هكذا كيف تبدو السماء المرصعة بالنجوم

33
00:04:20,610 --> 00:04:21,680
!أوه... إنّه شهاب

34
00:04:22,390 --> 00:04:23,430
...لم يسبق لي أن رأيته من قبل

35
00:04:23,770 --> 00:04:27,020
سنراهم أيضاً يوماً ما، في قرية المطر

36
00:04:37,590 --> 00:04:38,630
...والآن

37
00:04:39,760 --> 00:04:41,700
لا يوجد أيّ شينوبي آخر في المنطقة

38
00:04:42,160 --> 00:04:44,370
حسناً، يمكننا الاسترخاء وتناول وجبة

39
00:04:46,500 --> 00:04:48,410
!سنتناول فطائر الأوكونومياكي على وجبة العشاء

40
00:04:49,080 --> 00:04:50,200
أوكونومياكي؟

41
00:04:50,370 --> 00:04:52,820
...أوكونومياكي في الصحراء
من كان ليتوقع ذلك؟

42
00:04:55,280 --> 00:04:58,570
جميعنا بحاجة لتناول الطعام جيداً للحفاظ على قوتنا

43
00:04:59,240 --> 00:05:01,110
إنّه لمن المريح أن تكوني بجانبنا يا تينتِن

44
00:05:01,360 --> 00:05:02,350
ما الذي تعنيه بـ"مريح"؟

45
00:05:02,390 --> 00:05:04,390
!إنه لمن الرائع أنّك مريحة جداً

46
00:05:04,560 --> 00:05:06,350
أرجو المعذرة؟

47
00:05:06,520 --> 00:05:08,230
،لربّما أملك أدواتٍ مريحة

48
00:05:08,270 --> 00:05:10,520
لكنّي لستُ أداةً مريحة... مفهوم؟

49
00:05:10,930 --> 00:05:13,840
!لا، لا
!أنت مريحة بالتأكيد

50
00:05:14,010 --> 00:05:15,380
!بربّك

51
00:05:18,090 --> 00:05:20,220
!مريحة لستُ أنا

52
00:05:20,590 --> 00:05:22,620
يمكنك أن تحضّر وجبتكَ الخاصة

53
00:05:23,660 --> 00:05:25,500
...تينتِن

54
00:05:25,870 --> 00:05:27,210
!لا تتبعني

55
00:05:30,370 --> 00:05:31,490
أتساءل ماذا حدث؟

56
00:05:31,900 --> 00:05:32,990
لا أدري أيضاً

57
00:05:33,450 --> 00:05:34,400
ماذا سنفعل؟

58
00:05:34,610 --> 00:05:35,900
لا تنظر إليّ

59
00:05:51,270 --> 00:05:53,760
لقد قمتُ بالنفيس عن غضبي وحسب، أليس كذلك؟

60
00:06:05,960 --> 00:06:07,620
!هاكي: قبضة الهواء

61
00:06:11,290 --> 00:06:13,860
!بوابة الحياة الثالثة... افتحي

62
00:06:50,290 --> 00:06:52,070
لقد تحسّنتِ كثيراً يا تينتِن

63
00:06:53,570 --> 00:06:54,990
أشكرك

64
00:06:55,530 --> 00:06:57,450
لقد أتقنتِ مهاراتكِ

65
00:06:57,530 --> 00:07:00,530
لكنّها ليست جيّدة بما يكفي يا معلم غاي

66
00:07:00,700 --> 00:07:02,080
ما الخطب؟

67
00:07:02,780 --> 00:07:07,400
إتقان الأسلحة في قتال واحد ضد واحد
هو أمرٌ أساسيّ بالنسبة للنينجا، صحيح؟

68
00:07:08,440 --> 00:07:10,150
الأساسيات مهمّة

69
00:07:10,570 --> 00:07:11,610
أعلم ذلك

70
00:07:11,650 --> 00:07:14,720
...لكنّ المشكلة تكمن في تخطّي الأساسيات

71
00:07:15,220 --> 00:07:18,810
لقد شحذ نيجي أسلوب القبضة الناعمة
الخاص به وقام بتطوير جيتسو جديد

72
00:07:18,970 --> 00:07:20,760
أعرف ذلك. إنّه عبقري

73
00:07:20,930 --> 00:07:23,430
،يملك ليي مهارات التايجيتسو الأساسية وحسب

74
00:07:23,470 --> 00:07:25,420
لكنّه يستطيع فتح البوابات الثمانية الداخلية

75
00:07:25,630 --> 00:07:28,090
!إنّها ثمار جُهده

76
00:07:28,380 --> 00:07:31,000
لكن كل ما أملكه هو الأساسيات

77
00:07:32,300 --> 00:07:34,620
أريد تطبيق مهاراتي أيضاً

78
00:07:35,080 --> 00:07:36,450
،على هذا الحال

79
00:07:36,490 --> 00:07:39,410
كلّ ما سأفعله هو أن أقف خلفهما وأشجعهما

80
00:07:39,490 --> 00:07:43,790
تعرفين يا تينتِن أن ذلك الدور مهمٌ في العمل الجماعي

81
00:07:44,200 --> 00:07:49,610
أعلم أن كُلٌّ من نيجي وليي هما مستعملا
تايجتيسو ويختصان في القتال للمدى القريب

82
00:07:50,400 --> 00:07:55,640
نحن نستطيع القتال بجسارة لأنّنا نحظى بدعمك

83
00:07:56,140 --> 00:07:58,970
نحن ممتنون لأنّك هنا لأجلنا

84
00:07:59,220 --> 00:08:00,930
،بدلاً من الامتنان

85
00:08:00,970 --> 00:08:03,640
،أريد أن أحظى بنينجيتسو خاص بي

86
00:08:04,140 --> 00:08:06,510
ألا يمكننا فعل شيء يا معلم غاي؟

87
00:08:14,300 --> 00:08:15,660
ما رأيك بالسانسيتسوكون؟

88
00:08:16,160 --> 00:08:18,080
!إنها لا تختلف عن هذه

89
00:08:18,370 --> 00:08:19,700
!ذلك صحيح يا تينتِن

90
00:08:20,410 --> 00:08:23,830
لديكِ سمة لا يملكها غيركِ في هذا الفريق

91
00:08:24,570 --> 00:08:26,400
عليكِ إتقانها

92
00:08:26,490 --> 00:08:28,320
مهارةٌ لا يملكها أيّ أحد آخر؟

93
00:08:29,400 --> 00:08:31,490
إنّه لمن المريح حقاً أن تكوني بجانبنا

94
00:08:31,530 --> 00:08:35,390
!أرجوك لا تتكلم عنّي وكأنّي أداة ما يا معلمي

95
00:08:35,560 --> 00:08:38,520
أوه لا، لم أقصد ذلك على الإطلاق

96
00:08:40,140 --> 00:08:43,890
إنّي أسألك بعد أن أمعنتُ التفكير بهذا ملياً، كما تعلم

97
00:08:46,010 --> 00:08:47,260
...تينتِن

98
00:08:48,550 --> 00:08:50,470
إنّ فطائر الأوكونومياكي جاهزة

99
00:08:51,420 --> 00:08:52,380
!فلنأكل

100
00:08:54,090 --> 00:08:56,000
كيف هو مذاقها؟

101
00:08:57,620 --> 00:08:59,330
...لستُ مرتاحاً كثيراً حولها، لكن

102
00:09:22,230 --> 00:09:24,470
يبدو أنّه سيكون يوماً حاراً أيضاً

103
00:09:24,510 --> 00:09:26,470
إنّها عكس قرية المطر تماماً

104
00:09:28,630 --> 00:09:30,380
قليلٌ من الرطوبة ستفي بالغرض

105
00:09:34,500 --> 00:09:36,750
أرى بعض الأرض الخضراء هناك

106
00:09:42,420 --> 00:09:43,420
!بياكوغان

107
00:09:46,490 --> 00:09:47,450
ما الذي تراه يا نيجي؟

108
00:09:50,240 --> 00:09:51,740
لا يوجد أيّ أحد بالجوار

109
00:09:54,110 --> 00:09:55,480
فلنواصل التحرك

110
00:09:55,900 --> 00:09:59,270
،بينما نقترب من خط النهاية
فلا بدّ أن يظهر آخرين

111
00:10:00,440 --> 00:10:01,230
معكِ حق

112
00:10:01,270 --> 00:10:02,980
هذا أفضل من الانتظار

113
00:10:03,560 --> 00:10:06,800
أرى بقعة جيدة إذا كنا سننتظر

114
00:10:07,300 --> 00:10:07,930
أين؟

115
00:10:09,390 --> 00:10:10,470
أتريدان أن نذهب لتفقدها؟

116
00:10:21,550 --> 00:10:23,410
هذا المكان غريب

117
00:10:23,870 --> 00:10:26,080
أرى كهوفاً حولنا

118
00:10:26,790 --> 00:10:28,000
يبدو أنّها أنقاض

119
00:10:28,370 --> 00:10:29,160
أنقاض؟

120
00:10:29,750 --> 00:10:31,580
أجل... أنقاض أرض الرياح

121
00:10:35,700 --> 00:10:36,610
كما توقعت تماماً

122
00:10:45,480 --> 00:10:46,850
إنهم شينوبي كونوها

123
00:10:47,310 --> 00:10:49,100
يبدون مختلفين عن مجموعة البارحة

124
00:10:49,480 --> 00:10:52,690
لم يكن ثلاثيّ البارحة مبهراً أبداً

125
00:10:53,470 --> 00:10:55,590
أتساءل كيف هم هؤلاء الأشخاص؟

126
00:10:58,090 --> 00:10:59,680
إنهم يتقدمون نحونا مباشرةً

127
00:11:00,510 --> 00:11:02,720
معهم نوعٌ مستشعر أيضاً

128
00:11:03,370 --> 00:11:04,710
سننصبُ لهم كمّيناً

129
00:11:06,580 --> 00:11:08,040
إنّهنّ ينتظرننا

130
00:11:08,670 --> 00:11:10,290
ماذا بشأن لفيفتهن؟

131
00:11:10,500 --> 00:11:12,460
سنقاتل ونأخذها

132
00:11:12,860 --> 00:11:14,700
يبدو أنهنّ يخطّطن لفعل الشيء عينه

133
00:11:15,200 --> 00:11:16,360
!إنّهن قادمات نحونا مباشرةً

134
00:11:24,650 --> 00:11:27,100
دعونا لا نضيع الوقت في قتالٍ بلا معنى

135
00:11:27,560 --> 00:11:29,020
سأكون صريحاً

136
00:11:30,020 --> 00:11:31,810
لدينا لفيفة السماء

137
00:11:31,940 --> 00:11:36,670
سماء
إذا كنتنّ تسعين لهذه، فلنتقاتل

138
00:11:37,050 --> 00:11:39,050
!جيتسو فكّ الختم: شوريكين

139
00:11:39,890 --> 00:11:40,840
!...ذلك الجيتسو

140
00:11:41,260 --> 00:11:42,470
!دوران

141
00:11:49,670 --> 00:11:51,790
،جيتسو الاستدعاء
!بوابة مياه الأمطار

142
00:12:08,810 --> 00:12:09,650
!...أنت

143
00:12:09,770 --> 00:12:13,260
لستِ الوحيدة التي تستطيع استعمال نينجيتسو النقل

144
00:12:16,260 --> 00:12:18,140
إنهم بارعون حقاً

145
00:12:18,350 --> 00:12:19,890
...أجل، أياً كان

146
00:12:19,930 --> 00:12:23,090
لا أحد منهم يتمتّع بكمّية هائلة من التشاكرا

147
00:12:24,040 --> 00:12:24,630
...آجيساي

148
00:12:25,710 --> 00:12:27,960
!جيتسو فكّ الختم: عاصفة الرقائق الورقية

149
00:12:42,620 --> 00:12:43,690
!لقد هربن

150
00:12:44,520 --> 00:12:45,480
!بياكوغان

151
00:12:49,610 --> 00:12:50,400
!فلنذهب خلفنّ

152
00:12:59,310 --> 00:13:00,140
إنهم يلاحقوننا

153
00:13:00,850 --> 00:13:02,180
لا شكّ أنّ مستشعراً بينهم

154
00:13:05,630 --> 00:13:06,340
!عنصر الماء

155
00:13:07,340 --> 00:13:08,840
!جيتسو الرذاذ المخفي

156
00:13:21,080 --> 00:13:22,120
ماذا حدث؟

157
00:13:23,230 --> 00:13:25,150
ثمّة بعض الرطوبة في الجوار

158
00:13:25,190 --> 00:13:27,320
لا يعمل عنصر الماء الخاص بي بشكلٍ جيّد

159
00:13:31,980 --> 00:13:34,270
أعلم أننا لا نملك ميزة الأرض

160
00:13:34,680 --> 00:13:37,220
إنّه قتالٌ مستحيل، لكن لا خيار لنا سوى القتال

161
00:13:42,140 --> 00:13:44,090
!إعصار كونوها

162
00:13:48,300 --> 00:13:49,210
!من فوقك يا ليي

163
00:13:53,620 --> 00:13:54,910
!عاصفة سينبون المطرية -
!عاصفة سينبون المطرية -

164
00:14:16,060 --> 00:14:16,850
!أنتِ بارعةٌ جداً

165
00:14:19,140 --> 00:14:20,230
!القبضة الناعمة

166
00:14:24,610 --> 00:14:26,690
!سقوط الورقة

167
00:14:58,370 --> 00:14:59,110
!تينتِن

168
00:15:00,400 --> 00:15:01,320
!آجيساي

169
00:15:07,900 --> 00:15:09,640
...أشعر بتشاكراهما تحت الأرض

170
00:15:10,310 --> 00:15:11,350
لكنها في الأسفل العميق

171
00:15:11,600 --> 00:15:12,770
إنّ الرمال والحصى تسدّ الطريق

172
00:15:13,730 --> 00:15:15,730
لا يمكننا إضاعة الوقت في القتال عبثاً

173
00:15:16,480 --> 00:15:20,090
سنذهب لإنقاذ زميلتنا، لذا أقترح ألاّ تتدخّلا

174
00:15:20,470 --> 00:15:21,840
ونحن أيضاً

175
00:15:23,050 --> 00:15:25,800
أجل، دعونا نعقد هدنة في الوقت الراهن

176
00:15:26,340 --> 00:15:27,670
لسنا في الحرب

177
00:15:28,380 --> 00:15:29,660
إنّها مجرد امتحانات الشونين

178
00:15:30,540 --> 00:15:33,870
سلامة زميلتنا أهم من النجاح أو الرسوب

179
00:15:34,500 --> 00:15:35,500
نوافق على خطتك

180
00:15:36,210 --> 00:15:38,620
لكننا سنجري بحثنا الخاص

181
00:15:42,570 --> 00:15:45,150
يبدو أنّ هذه أنقاض أرض الرياح

182
00:15:45,320 --> 00:15:49,020
لقد وقعت آجيساي والشينوبي الأخرى في ممرٍ تحت الأرض

183
00:15:49,350 --> 00:15:52,890
إذا كان ممراً، فلا بدّ أن لديه اتّصال بمكانٍ ما

184
00:15:56,980 --> 00:15:59,300
أينبغي لنا أن نستعمل القوة
الغاشمة وحسب ونحفر من الأعلى؟

185
00:15:59,800 --> 00:16:01,510
هناك خطر الانهيار

186
00:16:02,720 --> 00:16:05,970
يجب أن نبحث عن ممرٍ بين الحطام ونتبعهما تحت الأرض

187
00:16:26,700 --> 00:16:28,200
...يا ويلي

188
00:16:28,490 --> 00:16:29,900
ما الخطب؟

189
00:16:30,440 --> 00:16:32,150
!اشتعلي بعاطفة شبابك

190
00:16:32,480 --> 00:16:34,480
!أطلقي العنان لطاقة شبابك

191
00:16:34,600 --> 00:16:36,600
!امتلئي بالتشاكرا المشتعلة

192
00:16:36,770 --> 00:16:38,650
...لكن يا معلم غاي

193
00:16:38,760 --> 00:16:41,550
!ظننتُ أن هذا تدريب القوة وحسب

194
00:16:42,340 --> 00:16:43,470
أنت هادئة جداً يا تينتِن

195
00:16:43,840 --> 00:16:45,300
،في مكانٍ ما على طول هذا المنحدر

196
00:16:45,340 --> 00:16:47,800
قوتكِ البدنية ستبلغ حدودها

197
00:16:48,300 --> 00:16:50,670
حينها ستسقطين وتموتين

198
00:16:51,080 --> 00:16:51,750
أموت؟

199
00:16:51,790 --> 00:16:53,330
،لأن تمنعي حدوث ذلك

200
00:16:53,380 --> 00:16:55,380
فيجب عليك التغلّب على حدود قوتك البدنية

201
00:16:55,630 --> 00:17:00,070
يتطلب التغلب على حدود القوة البدنية إرادة قوية

202
00:17:00,820 --> 00:17:01,870
!حاضر سيدي

203
00:17:02,240 --> 00:17:05,450
مرحباً، هل تتسلقان المنحدر أيضاً؟

204
00:17:06,200 --> 00:17:07,620
واصلا هكذا

205
00:17:07,910 --> 00:17:08,770
!كاكاشي؟

206
00:17:09,060 --> 00:17:11,230
لمَ ذراعك مقيّدة خلف ظهرك؟

207
00:17:11,400 --> 00:17:14,230
إنها عادة بسيطة

208
00:17:14,650 --> 00:17:16,270
!حسنٌ، أراكما لاحقاً

209
00:17:16,730 --> 00:17:18,310
أراكما لاحقاً"؟"

210
00:17:18,360 --> 00:17:20,050
!انتظر! هذه منافسة

211
00:17:21,350 --> 00:17:23,010
!سأسبقك

212
00:17:24,220 --> 00:17:28,010
لا تنفعل كثيراً، هذا مجرّد تدريب

213
00:17:28,050 --> 00:17:30,290
!وما الضرر في بعض التنافس أثناء التدريب؟

214
00:17:30,540 --> 00:17:33,340
!مهلاً، انتظر رجاءً يا معلم غاي

215
00:17:33,380 --> 00:17:35,340
!تسلّقي برويةٍ

216
00:17:35,790 --> 00:17:36,790
!تباً

217
00:17:58,680 --> 00:18:00,350
...تباً، تباً

218
00:18:00,390 --> 00:18:01,260
...تباً

219
00:18:03,640 --> 00:18:06,180
أحسنتِ عملاً يا تينتِن، لقد نجحتِ

220
00:18:06,390 --> 00:18:08,390
إذاً؟ هل تغلّبتِ على حدودكِ؟

221
00:18:08,560 --> 00:18:10,300
...لستُ واثقة تماماً

222
00:18:10,340 --> 00:18:12,460
لكن أظن أنّني تغلّبتُ على شيءٍ ما

223
00:18:14,010 --> 00:18:14,630
ماء؟

224
00:18:21,120 --> 00:18:21,830
تفضل

225
00:18:22,580 --> 00:18:24,420
أنت مريحة بعد كلّ شيء

226
00:18:25,330 --> 00:18:26,910
أرجوك توقف عن قول ذلك

227
00:18:27,280 --> 00:18:29,410
أقصد أن الجيتسو الخاص بك مريح

228
00:18:33,200 --> 00:18:35,200
،تخزين الأشياء في لفيفة

229
00:18:35,490 --> 00:18:38,480
...أو استخدام لفيفةٍ لسحب الأشياء من مسافة

230
00:18:38,810 --> 00:18:42,270
مهارة النقل والتي هي إحدى أنواع جيتسو الاستدعاء

231
00:18:42,850 --> 00:18:44,600
إمّا أن تكوني بارعةً لأجل فعل ذلك أم لا

232
00:18:45,100 --> 00:18:48,010
أتقول أنّني بارعةٌ بذلك؟

233
00:18:48,430 --> 00:18:49,260
تبدين كذلك

234
00:18:49,640 --> 00:18:54,590
شحذ تلك المهارة هو السبيل لكسب
القوّة والفائدة التي ترغبين

235
00:18:55,220 --> 00:18:56,460
شحذ مهارتي؟

236
00:18:57,290 --> 00:18:59,460
ألن يزيد ذلك من قوتي البدنية وحسب؟

237
00:18:59,710 --> 00:19:01,330
بل وقوتك الروحية أيضاً

238
00:19:01,750 --> 00:19:07,700
تعرفين أنّ التشاكرا هي مزيجٌ من الطاقة
الجسدية والطاقة الروحية، أليس كذلك؟

239
00:19:07,740 --> 00:19:08,660
بالطبع

240
00:19:09,320 --> 00:19:14,120
يمكن لكلّ فردٍ أن يزيد التشاكرا ببساطةٍ عبر التدريب

241
00:19:14,660 --> 00:19:17,560
،ببساطة، إذا قمتِ بزيادة قوتك الجسدية والروحية

242
00:19:17,610 --> 00:19:20,310
فإنّكِ بذلك تزيدين تشاكراكِ أيضاً

243
00:19:20,730 --> 00:19:24,690
أزيادة تشاكراي يفيدني؟

244
00:19:25,520 --> 00:19:27,100
،بالنسبة لجيتسو الاستدعاء

245
00:19:27,140 --> 00:19:32,260
فتشاكرا المستخدم هي متناسبةٌ مباشرةً
مع حجم وكمية الشيء المستدعى

246
00:19:32,600 --> 00:19:35,790
هذه كمية الماء الذي قمتِ باستدعائه

247
00:19:36,170 --> 00:19:37,590
،عبر زيادة تشاكراكِ

248
00:19:37,630 --> 00:19:39,210
فأنتِ بذلك تستطيعين استدعاء ما
،يكفي من الماء لملء حوض استحمام

249
00:19:39,250 --> 00:19:42,290
أو بحيرة، أو حتى محيط

250
00:19:43,590 --> 00:19:44,750
...محيط

251
00:19:56,360 --> 00:20:00,440
ولهذا السبب سنستمّر في التدرب لزيادة تشاكراكِ يا تينتِن

252
00:20:00,480 --> 00:20:01,520
!أجل

253
00:20:04,480 --> 00:20:07,390
!لقد تسلّقنا للتو، إذاً لمَ نهبط؟

254
00:20:07,720 --> 00:20:09,100
!هذا تدريبٌ أيضاً

255
00:20:09,140 --> 00:20:11,180
!اشتعلي بعاطفة الشباب

256
00:20:11,470 --> 00:20:13,640
!أطلقي العنان لطاقة شبابكِ

257
00:20:13,890 --> 00:20:15,310
!امتلئي بالتشاكرا المشتعلة

258
00:20:16,380 --> 00:20:17,340
ماذا؟

259
00:20:33,240 --> 00:20:34,160
أين أنا؟

260
00:20:56,800 --> 00:20:58,920
هل أنتِ بخير؟

261
00:21:00,010 --> 00:21:01,460
!أنتِ... هيا

262
00:22:36,660 --> 00:22:38,540
ليي، هل عثرتَ على شيء؟

263
00:22:38,830 --> 00:22:42,290
كلا، ظننتُ أنّه مدخلٌ إلى الأنقاض، لكنّه مجرد جلمود

264
00:22:42,290 --> 00:22:43,410
...فهمت

265
00:22:43,830 --> 00:22:45,610
ينبغي لنا أن نجد المدخل بسرعة

266
00:22:45,940 --> 00:22:47,690
،لا ندري كم من الوقتِ نملك حتّى ينهار كلّ شيء

267
00:22:47,730 --> 00:22:48,780
...وذلك بسبب الهزّة الأرضية السابقة

268
00:22:48,820 --> 00:22:49,530
!أوه لا

269
00:22:49,730 --> 00:22:52,150
ألا يمكنك أن تعثر عليهما باستخدام
البياكوغان خاصتك يا نيجي؟

270
00:22:52,190 --> 00:22:55,720
...حسنٌ، يبدو أنّهما سقطتا على مسافةٍ كبيرة

271
00:22:55,850 --> 00:22:56,810
...تينتِن

272
00:22:57,140 --> 00:23:00,680
:في الحلقة القادمة
"الزوج المسجون"

273
00:23:01,100 --> 00:23:02,970
!آمل أنّكِ بخير